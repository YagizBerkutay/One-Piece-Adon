0,0,0,0,0,100,100,0,0,1,1.9,1.9,2,180,180,27,1Style: RogerMonologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1Style: Karaoke,Duality,68,&H00292CC7,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,4,0,1,6.8,0,8,23,23,23,1Style: Translation,Duality,68,&H00292CC7,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,4,0,1,6.8,0,2,23,23,34,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:49.92,0:01:59.91,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 50,0:01:51.17,0:01:52.97,Main-207-,,0,0,0,,Hasır Şapkalı Luffy,Dialogue: 50,0:01:52.97,0:01:54.93,Main-207-,,0,0,0,,Hikâyen için ne uygun bir son…Dialogue: 50,0:01:58.01,0:02:01.85,Main-207-,,0,0,0,,Yaklaşık altı dakika içinde bu avlu meydanla birlikte patlayacak.Dialogue: 50,0:02:01.85,0:02:04.40,Main-207-,,0,0,0,,Üzgünüm ama acelem var.Dialogue: 50,0:02:04.40,0:02:07.36,Main-207-,,0,0,0,,Bekle ve Kum Krallığı'nın...Dialogue: 50,0:02:07.36,0:02:10.36,Main-207-,,0,0,0,,yeni hükümdarının doğuşunu kutla.Dialogue: 50,0:02:12.82,0:02:14.20,Main-207-,,0,0,0,,Şimdi...Dialogue: 50,0:02:17.49,0:02:19.49,Main-207-,,0,0,0,,gitme vaktim geldi.Dialogue: 50,0:02:19.49,0:02:21.95,Main-207-,,0,0,0,,Anıtın buranın batısında olduğunu söylemişti.Dialogue: 50,0:02:31.71,0:02:33.22,Flashbacks-207-,,0,0,0,,Iskaladın...Dialogue: 50,0:02:44.06,0:02:46.52,Main-207-,,0,0,0,,Ucuz atlattım! Öleceğimi sandım!Dialogue: 50,0:02:50.94,0:02:53.36,Main-207-,,0,0,0,,Lanet olası, gitmiş.Dialogue: 50,0:02:55.03,0:02:57.32,Main-207-,,0,0,0,,O tarafa uçarken gördüm.Dialogue: 50,0:02:57.74,0:02:59.33,Main-207-,,0,0,0,,O kadar kolay kaçamazsın!Dialogue: 50,0:02:59.33,0:03:00.83,Main-207-,,0,0,0,,Alçak, croc!Dialogue: 50,0:03:11.63,0:03:14.22,Main-207-,,0,0,0,,Demek burası Kraliyet Ailesi'nin anıt mezarı...Dialogue: 50,0:03:14.22,0:03:17.05,Main-207-,,0,0,0,,Eski kralların sonsuza dek uyuduğu yer.Dialogue: 50,0:03:19.68,0:03:21.18,Main-207-,,0,0,0,,Poneglif nerede?Dialogue: 50,0:03:33.74,0:03:34.74,Main-207-,,0,0,0,,Gizli merdiven!Dialogue: 50,0:03:36.32,0:03:39.66,Main-207-,,0,0,0,,Poneglif bu yer altının derinliklerinde yatıyor.Dialogue: 50,0:03:40.95,0:03:44.70,Main-207-,,0,0,0,,Kimsenin poneglif'in varlığını bilmemesi gerekiyordu.Dialogue: 50,0:03:44.70,0:03:46.71,Main-207-,,0,0,0,,Yeraltı suç ağı çok geniş.Dialogue: 50,0:03:46.71,0:03:51.92,Main-207-,,0,0,0,,Dünya Hükûmeti altındaki krallar bile her şeyi bilemez.Dialogue: 50,0:03:52.71,0:03:54.21,Main-207-,,0,0,0,,Kendini suçlama.Dialogue: 50,0:03:55.30,0:04:00.51,Main-207-,,0,0,0,,Bunları okuyabilen birinin olduğunu bilmiyordun herhâlde.Dialogue: 50,0:04:00.51,0:04:02.64,Main-207-,,0,0,0,,Poneglif'i okuyabiliyor musun?Dialogue: 50,0:04:02.64,0:04:03.77,Main-207-,,0,0,0,,Evet...Dialogue: 50,0:04:03.77,0:04:07.27,Main-207-,,0,0,0,,Crocodile'ın benimle işbirliğine razı olmasının sebebi bu.Dialogue: 50,0:04:07.27,0:04:09.73,Main-207-,,0,0,0,,Ayrıca beni öldürememesinin nedeni de bu.Dialogue: 50,0:04:10.35,0:04:15.82,Main-207-,,0,0,0,,Muhtemelen bu ülkedeki poneglif'te Pluton’un yeri yazılıdır.Dialogue: 50,0:04:15.82,0:04:16.65,Main-207-,,0,0,0,,Haksız mıyım?Dialogue: 50,0:04:17.32,0:04:18.53,Main-207-,,0,0,0,,Bilmiyorum.Dialogue: 50,0:04:18.53,0:04:22.74,Main-207-,,0,0,0,,Alabasta’nın kraliyet ailesi nesiller boyu onu korumakla görevlendirildi.Dialogue: 50,0:04:22.74,0:04:25.12,Main-207-,,0,0,0,,Bizim nazarımızda hepsi bu.Dialogue: 50,0:04:25.12,0:04:26.62,Main-207-,,0,0,0,,Korumak mı?Dialogue: 50,0:04:26.62,0:04:27.58,Main-207-,,0,0,0,,Güldürme beni!Dialogue: 50,0:04:34.25,0:04:36.26,Main-207-,,0,0,0,,Oldukça etkileyici...Dialogue: 50,0:04:36.26,0:04:38.84,Main-207-,,0,0,0,,Son kapının ardında.Dialogue: 50,0:04:47.35,0:04:48.94,Main-207-,,0,0,0,,İşte...Dialogue: 50,0:04:59.11,0:05:00.28,Main-207-,,0,0,0,,Değersiz...Dialogue: 50,0:05:01.36,0:05:02.62,Main-207-,,0,0,0,,Ne yapıyorsun sen?!Dialogue: 50,0:05:03.03,0:05:06.20,Main-207-,,0,0,0,,Ne gibi görünüyor?! Crocodile gibi düşünmeye çalışıyorum!Dialogue: 50,0:05:06.20,0:05:08.58,Main-207-,,0,0,0,,Böylece bombanın yerini tespit edebilirim!Dialogue: 50,0:05:08.58,0:05:11.04,Main-207-,,0,0,0,,Kapa çeneni ve ara! Beş dakikamız kaldı!Dialogue: 50,0:05:11.50,0:05:14.92,Thoughts-207-,,0,0,0,,Beş dakika! Beş dakika içinde, bir milyon insan ölecek!Dialogue: 50,0:05:14.92,0:05:18.05,Thoughts-207-,,0,0,0,,Çabuk! Acele edip bombacıyı bulmalıyız!Dialogue: 50,0:05:18.05,0:05:20.51,Main-207-,,0,0,0,,Chopper! Bombacıyı koklayarak bulamaz mısın?!Dialogue: 50,0:05:20.51,0:05:23.72,Main-207-,,0,0,0,,Yapamam! Tüm şehir barut kokusuyla kaplanmış!Dialogue: 50,0:05:23.72,0:05:25.39,Main-207-,,0,0,0,,Öyleyse... şunu dene!Dialogue: 50,0:05:25.39,0:05:28.98,Main-207-,,0,0,0,,"Meydana top doğrultan adamı" koklayıp bulabilir misin?Dialogue: 50,0:05:28.98,0:05:30.27,Main-207-,,0,0,0,,O nasıl koku be?!Dialogue: 50,0:05:30.27,0:05:32.19,Main-207-,,0,0,0,,Ben nereden bileyim?! Sadece dene!Dialogue: 50,0:05:32.19,0:05:33.35,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:05:36.48,0:05:38.73,Thoughts-207-,,0,0,0,,Beş kilometrelik alanı yok edebilir…Dialogue: 50,0:05:40.28,0:05:42.78,Main-207-,,0,0,0,,Bekle. Öyle bir şey epey büyük olmalı.Dialogue: 50,0:05:42.78,0:05:46.28,Main-207-,,0,0,0,,Bombayı fırlatacak top, hedefe yakın olmalı.Dialogue: 50,0:05:46.28,0:05:49.25,Main-207-,,0,0,0,,Yani meydana yakın olmalı!Dialogue: 50,0:05:50.00,0:05:52.12,Main-207-,,0,0,0,,Dolaşacak zamanım yok!Dialogue: 50,0:05:52.62,0:05:53.96,Main-207-,,0,0,0,,Kestirmeden gideceğim!Dialogue: 50,0:05:55.25,0:05:56.46,Main-207-,,0,0,0,,Var mı bir iz, Pell?!Dialogue: 50,0:05:56.46,0:06:01.09,Main-207-,,0,0,0,,Meydan civarındaki her çatıya baktım, topa dair hiçbir iz bulamadım!Dialogue: 50,0:06:01.51,0:06:04.30,Main-207-,,0,0,0,,Öyleyse binalardan birinin içinde olmalı!Dialogue: 50,0:06:04.30,0:06:05.72,Main-207-,,0,0,0,,Bütün binalara bakacağım!Dialogue: 50,0:06:05.72,0:06:06.76,Main-207-,,0,0,0,,Tamam!Dialogue: 50,0:06:19.11,0:06:21.61,Flashbacks-207-,,0,0,0,,Tatmin olana dek daha kaç kez kalkacaksın?!Dialogue: 50,0:06:33.08,0:06:34.96,Main-207-,,0,0,0,,Crocodile...Dialogue: 50,0:06:36.46,0:06:39.21,Main-207-,,0,0,0,,O kadın seni haklamış gibi.Dialogue: 50,0:06:39.21,0:06:42.63,Main-207-,,0,0,0,,Denizcilerin buraya kadar peşimden gelmesini kim beklerdi ki?Dialogue: 50,0:06:43.47,0:06:45.51,Main-207-,,0,0,0,,Patronunuza ne oldu?Dialogue: 50,0:06:45.51,0:06:47.89,Main-207-,,0,0,0,,Dumanlı korkak, kuyruğunu kıstırıp kaçtı mı?Dialogue: 50,0:06:48.47,0:06:51.06,Main-207-,,0,0,0,,Kaybedenler adalet hakkında vaaz vermemeli.Dialogue: 50,0:06:51.06,0:06:53.68,Main-207-,,0,0,0,,Deniz güçlüden yanadır.Dialogue: 50,0:06:53.68,0:06:57.81,Main-207-,,0,0,0,,Şimdi niye Denizci Karargâhına dönüp, adaletinizi biraz daha tartışmıyorsunuz?Dialogue: 50,0:07:08.28,0:07:09.70,Thoughts-207-,,0,0,0,,Crocodile!Dialogue: 50,0:07:21.17,0:07:22.34,Main-207-,,0,0,0,,Hasır Şapka!Dialogue: 50,0:07:23.13,0:07:25.30,Main-207-,,0,0,0,,Şu lanet croc, ne tarafa gitti?!Dialogue: 50,0:07:27.97,0:07:29.01,Main-207-,,0,0,0,,Söyle!Dialogue: 50,0:07:29.01,0:07:30.18,Main-207-,,0,0,0,,Ne tarafa gitti?!Dialogue: 50,0:07:46.07,0:07:48.45,Main-207-,,0,0,0,,Kraliyet anıt mezarına doğru gitti.Dialogue: 50,0:07:48.82,0:07:50.45,Main-207-,,0,0,0,,O tarafa mı? Sağ ol!Dialogue: 50,0:08:04.21,0:08:06.09,Main-207-,,0,0,0,,Ne adaleti...?Dialogue: 50,0:08:13.31,0:08:16.02,Main-207-,,0,0,0,,Ne Denizcileri?!Dialogue: 50,0:08:25.23,0:08:26.49,Main-207-,,0,0,0,,Ne?Dialogue: 50,0:08:26.49,0:08:28.20,Main-207-,,0,0,0,,Hareket edemiyorum.Dialogue: 50,0:08:30.03,0:08:32.95,Main-207-,,0,0,0,,Çok tuhaf. O kadar et yedim.Dialogue: 50,0:08:33.58,0:08:35.66,Main-207-,,0,0,0,,Bu yara hiçbir şey.Dialogue: 50,0:08:36.79,0:08:39.46,Main-207-,,0,0,0,,Belki de biraz yoruldum.Dialogue: 50,0:08:42.08,0:08:45.96,Main-207-,,0,0,0,,Aradığın şey orada yazıyor mu?Dialogue: 50,0:08:53.43,0:08:55.39,Main-207-,,0,0,0,,Ah, anlıyorum.Dialogue: 50,0:08:55.39,0:08:57.60,Main-207-,,0,0,0,,Gizli merdiven.Dialogue: 50,0:09:02.69,0:09:05.19,Thoughts-207-,,0,0,0,,Geriye... Geriye dört dakika kaldı!Dialogue: 50,0:09:27.67,0:09:29.26,Main-207-,,0,0,0,,Başka var mı?Dialogue: 50,0:09:29.26,0:09:31.80,Main-207-,,0,0,0,,Yoksa sadece bu mu?Dialogue: 50,0:09:31.80,0:09:33.80,Main-207-,,0,0,0,,Tatmin olmadın mı?Dialogue: 50,0:09:33.80,0:09:36.01,Main-207-,,0,0,0,,Ben sözümü tuttum.Dialogue: 50,0:09:37.77,0:09:38.93,Main-207-,,0,0,0,,Haklısın.Dialogue: 50,0:09:40.73,0:09:43.44,Main-207-,,0,0,0,,Ülkenin en değerli sırrı için uygun bir yer.Dialogue: 50,0:09:43.44,0:09:48.86,Main-207-,,0,0,0,,Ne kadar çabalarsanız çabalayın, yerini bilmeden asla bulamazsınız.Dialogue: 50,0:09:49.90,0:09:52.74,Main-207-,,0,0,0,,Poneglif bu mu, Nico Robin?Dialogue: 50,0:09:54.41,0:09:55.57,Main-207-,,0,0,0,,Hızlı oldu.Dialogue: 50,0:09:56.37,0:09:58.87,Main-207-,,0,0,0,,Burada epey tuhaf eserimiz varmış.Dialogue: 50,0:09:58.87,0:10:00.87,Main-207-,,0,0,0,,Deşifre edebildin mi?Dialogue: 50,0:10:00.87,0:10:02.12,Main-207-,,0,0,0,,Evet.Dialogue: 50,0:10:02.12,0:10:05.29,Main-207-,,0,0,0,,İyi, şimdi oku bana.Dialogue: 50,0:10:09.38,0:10:14.84,Main-207-,,0,0,0,,Kahire, Alabasta tarafından fethedildi. Bu Cennet Çağı, 239 yılında olmuş.Dialogue: 50,0:10:14.84,0:10:18.97,Main-207-,,0,0,0,,260'da Bytine hanedanı Taymar, tahta geçmiş.Dialogue: 50,0:10:18.97,0:10:23.81,Main-207-,,0,0,0,,Erumalu'daki büyük Taf Tapınağı 306 yılında tamamlanmış.Dialogue: 50,0:10:23.81,0:10:27.27,Main-207-,,0,0,0,,325 yılında Oltair'nın şanlı kahramanı Mamudine–Dialogue: 50,0:10:27.27,0:10:28.69,Main-207-,,0,0,0,,Hey, hey, kes şunu!Dialogue: 50,0:10:28.69,0:10:31.44,Main-207-,,0,0,0,,Bilmek istediğimiz bu mu?!Dialogue: 50,0:10:31.44,0:10:34.03,Main-207-,,0,0,0,,Bu ülkenin tarihi umrumda değil!Dialogue: 50,0:10:34.03,0:10:38.16,Main-207-,,0,0,0,,Dünyanın en yıkıcı askeri gücünü nerede bulabilirim, onu söyle?Dialogue: 50,0:10:38.53,0:10:40.41,Main-207-,,0,0,0,,Pluton nerede?!Dialogue: 50,0:10:41.62,0:10:43.08,Main-207-,,0,0,0,,Yazmıyor.Dialogue: 50,0:10:43.08,0:10:44.25,Main-207-,,0,0,0,,Ha?!Dialogue: 50,0:10:44.25,0:10:46.75,Main-207-,,0,0,0,,Tüm yazan bu ülkenin tarihi.Dialogue: 50,0:10:46.75,0:10:47.84,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:10:47.84,0:10:49.09,Main-207-,,0,0,0,,Plutonla ilgili...Dialogue: 50,0:10:49.09,0:10:52.55,Main-207-,,0,0,0,,tek bir kelime bile yazılmamış.Dialogue: 50,0:10:54.63,0:10:56.05,Main-207-,,0,0,0,,Anlıyorum.Dialogue: 50,0:10:56.05,0:10:57.30,Main-207-,,0,0,0,,Demek öyle.Dialogue: 50,0:10:57.30,0:10:58.97,Main-207-,,0,0,0,,Çok yazık.Dialogue: 50,0:10:59.85,0:11:02.93,Main-207-,,0,0,0,,Faydalı bir ortaktın ama...Dialogue: 50,0:11:03.48,0:11:05.39,Main-207-,,0,0,0,,artık ölme vaktin geldi.Dialogue: 50,0:11:05.90,0:11:06.60,Main-207-,,0,0,0,,Ne...?!Dialogue: 50,0:11:08.15,0:11:12.74,Main-207-,,0,0,0,,Dört yıl önce yaptığımız anlaşmanın süresi şimdi doldu.Dialogue: 50,0:11:12.74,0:11:15.65,Main-207-,,0,0,0,,O gün bana,Dialogue: 50,0:11:15.65,0:11:18.03,Main-207-,,0,0,0,,seni poneglif'e götürürsem...Dialogue: 50,0:11:18.03,0:11:21.04,Main-207-,,0,0,0,,bana silahın yerini vereceğini söylemiştin.Dialogue: 50,0:11:21.62,0:11:25.00,Main-207-,,0,0,0,,Baroque Works'te geçirdiğin dört yıl boyunca,Dialogue: 50,0:11:25.00,0:11:27.83,Main-207-,,0,0,0,,aklın ve hâkimiyetin örnek teşkil etti.Dialogue: 50,0:11:28.67,0:11:30.92,Main-207-,,0,0,0,,Bu benim için yeterliydi.Dialogue: 50,0:11:30.92,0:11:33.80,Main-207-,,0,0,0,,El üstünde tutulacak faydalı bir kadındın.Dialogue: 50,0:11:33.80,0:11:35.30,Main-207-,,0,0,0,,Ancak...Dialogue: 50,0:11:35.30,0:11:38.01,Main-207-,,0,0,0,,sonunda sözünden döndün!Dialogue: 50,0:11:40.89,0:11:44.60,Main-207-,,0,0,0,,Ya bu poneglif, Pluton'un yeriyle alakalı tek bir kelime içermiyor!Dialogue: 50,0:11:45.85,0:11:47.77,Main-207-,,0,0,0,,Ya da...Dialogue: 50,0:11:47.77,0:11:52.82,Main-207-,,0,0,0,,burada yazıyorsa bile, bana söylemek niyetinde değil misin?Dialogue: 50,0:11:57.66,0:11:58.99,Main-207-,,0,0,0,,Ama...Dialogue: 50,0:11:58.99,0:12:01.78,Main-207-,,0,0,0,,sana karşı öfke hissetmiyorum.Dialogue: 50,0:12:01.78,0:12:04.62,Main-207-,,0,0,0,,Niye biliyor musun, Nico Robin?Dialogue: 50,0:12:05.25,0:12:07.75,Main-207-,,0,0,0,,Seni ahmak. Seninle dört yıl boyunca çalıştım!Dialogue: 50,0:12:07.75,0:12:10.92,Main-207-,,0,0,0,,Bunu yapacağını zaten biliyordum!Dialogue: 50,0:12:11.84,0:12:13.21,Main-207-,,0,0,0,,Su?!Dialogue: 50,0:12:13.21,0:12:15.38,Main-207-,,0,0,0,,Islanırsan bıçaklanabilirsin, değil mi?!Dialogue: 50,0:12:17.97,0:12:19.80,Main-207-,,0,0,0,,Atlattı! Nereye git–Dialogue: 50,0:12:24.39,0:12:27.85,Main-207-,,0,0,0,,Her şey için seni affediyorum, Nico Robin.Dialogue: 50,0:12:34.78,0:12:37.03,Main-207-,,0,0,0,,Çünkü ben,Dialogue: 50,0:12:37.65,0:12:40.24,Main-207-,,0,0,0,,başından beri...Dialogue: 50,0:12:40.24,0:12:42.99,Main-207-,,0,0,0,,kimseye güvenmedim!Dialogue: 50,0:12:47.75,0:12:52.25,Main-207-,,0,0,0,,Cobra'nın tepkisini bakarsak, Pluton'un gerçekte var olduğunu biliyorum.Dialogue: 50,0:12:52.25,0:12:55.75,Main-207-,,0,0,0,,Sadece poneglif'in yardımı olmadan bulmalıyım.Dialogue: 50,0:12:55.75,0:12:58.88,Main-207-,,0,0,0,,Bu krallık benim olur olmaz onu bulmak an meselesi olacak.Dialogue: 50,0:13:01.26,0:13:04.35,Main-207-,,0,0,0,,Neler oluyor?! Meydandaki patlama için henüz erken!Dialogue: 50,0:13:05.60,0:13:07.68,Main-207-,,0,0,0,,Sendin. Ne yaptın?Dialogue: 50,0:13:07.68,0:13:12.10,Main-207-,,0,0,0,,Ne mi? Pek bir şey değil. Bu yer altındaki odada...Dialogue: 50,0:13:12.10,0:13:16.07,Main-207-,,0,0,0,,küçük bir payandayı kaldırdığında...Dialogue: 50,0:13:12.10,0:13:16.07,Note-207-,,0,0,0,,Payanda: Bir şeyin yıkılmaması için konulan destekDialogue: 50,0:13:16.07,0:13:18.57,Main-207-,,0,0,0,,tavanı çökerten bir tuzak kurulu.Dialogue: 50,0:13:18.57,0:13:23.45,Main-207-,,0,0,0,,Benimle beraber burada öleceksiniz.Dialogue: 50,0:13:23.45,0:13:27.83,Main-207-,,0,0,0,,Nefertari hanedanının on ikinci kralı olarak,Dialogue: 50,0:13:27.83,0:13:31.54,Main-207-,,0,0,0,,bu kum ülkesini ele geçirmene asla izin vermeyeceğim.Dialogue: 50,0:13:33.79,0:13:37.67,Main-207-,,0,0,0,,Olağanüstü... Mükemmel bir kralsın!Dialogue: 50,0:13:37.67,0:13:42.76,Main-207-,,0,0,0,,Ülkeni korumak için benimle birlikte ölmeye razı mısın?Dialogue: 50,0:13:42.76,0:13:45.22,Main-207-,,0,0,0,,Ne yazık ki... beni öldüremezsin.Dialogue: 50,0:13:46.43,0:13:50.18,Main-207-,,0,0,0,,Buradaki tüm taşları kuma dönüştürüp kaçacağım!Dialogue: 50,0:13:51.35,0:13:53.65,Main-207-,,0,0,0,,Hayatını heba ettin, Cobra!Dialogue: 50,0:13:54.52,0:13:57.15,Main-207-,,0,0,0,,Sadece üç dakika kaldı.Dialogue: 50,0:13:57.15,0:13:59.78,Main-207-,,0,0,0,,Burası yıkılıp meydan infilak ettiğinde,Dialogue: 50,0:13:59.78,0:14:03.61,Main-207-,,0,0,0,,yoluma çıkan herkes bir anda yok olacak!Dialogue: 50,0:14:04.11,0:14:06.74,Main-207-,,0,0,0,,Ve o andan itibaren,Dialogue: 50,0:14:06.74,0:14:09.04,Main-207-,,0,0,0,,bu ülke benim olacak!Dialogue: 50,0:14:30.97,0:14:32.27,Thoughts-207-,,0,0,0,,Nerede?!Dialogue: 50,0:14:32.27,0:14:34.02,Thoughts-207-,,0,0,0,,Sadece üç dakika kaldı!Dialogue: 50,0:14:34.02,0:14:37.15,Thoughts-207-,,0,0,0,,5 km çapındaki bir alanı dümdüz edecek bir bomba!Dialogue: 50,0:14:37.15,0:14:40.61,Thoughts-207-,,0,0,0,,Olabileceği çok fazla yer var!Dialogue: 50,0:14:40.61,0:14:44.11,Thoughts-207-,,0,0,0,,O kadar aradık! Niye bulamadık?!Dialogue: 50,0:14:44.74,0:14:47.24,Thoughts-207-,,0,0,0,,Öyle bir topu barındırabilecek geniş bir alan...Dialogue: 50,0:14:48.33,0:14:49.12,Main-207-,,0,0,0,,Serseri kurşun!Dialogue: 50,0:14:50.70,0:14:52.45,Main-207-,,0,0,0,,Geniş bir yer...Dialogue: 50,0:14:54.12,0:14:57.92,Flashbacks-207-,,0,0,0,,Hiç adil değil, Koza! Burada mı gizleniyordun?!Dialogue: 50,0:14:57.92,0:15:00.00,Flashbacks-207-,,0,0,0,,Lider, hiç adil değil!Dialogue: 50,0:15:00.38,0:15:01.67,Main-207-,,0,0,0,,Doğru...Dialogue: 50,0:15:01.67,0:15:03.26,Main-207-,,0,0,0,,Orada olmalı...Dialogue: 50,0:15:03.26,0:15:05.63,Main-207-,,0,0,0,,Nereye nişan aldığına dikkat et, pislik!Dialogue: 50,0:15:05.63,0:15:06.34,Main-207-,,0,0,0,,Sis Yıldızı!Dialogue: 50,0:15:06.84,0:15:09.51,Main-207-,,0,0,0,,Kimsenin bakmayacağı geniş bir yer.Dialogue: 50,0:15:10.18,0:15:11.85,Main-207-,,0,0,0,,Ben isyancı değilim!Dialogue: 50,0:15:11.85,0:15:13.10,Main-207-,,0,0,0,,Usopp Çekici!Dialogue: 50,0:15:13.10,0:15:15.48,Main-207-,,0,0,0,,Usopp'un Ölüm Lastiği!Dialogue: 50,0:15:15.48,0:15:16.90,Main-207-,,0,0,0,,Benimle uğraşma, uyuz!Dialogue: 50,0:15:16.90,0:15:19.65,Main-207-,,0,0,0,,Cidden, kim olduğumu sanıyor bunlar?!Dialogue: 50,0:15:19.65,0:15:21.94,Main-207-,,0,0,0,,Duyunca şaşırmayın...  Hayır, şaşırın!Dialogue: 50,0:15:21.94,0:15:24.90,Main-207-,,0,0,0,,Ben, büyük kötü şöhretli kaptan–Dialogue: 50,0:15:24.90,0:15:28.32,Main-207-,,0,0,0,,Ne? Ah, Vivi. Bombanın yerini buldun mu?Dialogue: 50,0:15:28.32,0:15:30.20,Main-207-,,0,0,0,,Buldum! Nerede olduğunu çözdüm!Dialogue: 50,0:15:30.20,0:15:31.54,Main-207-,,0,0,0,,Ne?! Gerçekten mi?!Dialogue: 50,0:15:31.54,0:15:34.04,Main-207-,,0,0,0,,Tamam, işte başlıyoruz!Dialogue: 50,0:15:34.04,0:15:36.83,Main-207-,,0,0,0,,Diğerlerini çağıracağım. Bundan emin misin?!Dialogue: 50,0:15:37.96,0:15:39.13,Main-207-,,0,0,0,,Ölümcül...Dialogue: 50,0:15:39.67,0:15:41.59,Main-207-,,0,0,0,,Kızıl Yılan Yıldızı!Dialogue: 50,0:16:17.54,0:16:19.92,Main-207-,,0,0,0,,Oh, iyi kestirdim.Dialogue: 50,0:16:19.92,0:16:22.00,Main-207-,,0,0,0,,Eh...? Doğru ya.Dialogue: 50,0:16:22.00,0:16:24.63,Main-207-,,0,0,0,,Bedenim aniden hareket etmeyi bıraktı.Dialogue: 50,0:16:24.63,0:16:28.43,Main-207-,,0,0,0,,Sonra yoruldum ve uyumak zorunda kaldım.Dialogue: 50,0:16:28.80,0:16:31.89,Main-207-,,0,0,0,,Şimdi kendimi daha iyi hissediyorum, ve...Dialogue: 50,0:16:31.89,0:16:32.64,Main-207-,,0,0,0,,Evet!Dialogue: 50,0:16:33.72,0:16:36.60,Main-207-,,0,0,0,,Croc! Onu mahvedeceğim!Dialogue: 50,0:16:46.19,0:16:47.74,Main-207-,,0,0,0,,O yer,Dialogue: 50,0:16:51.57,0:16:53.16,Main-207-,,0,0,0,,crocumsu kokuyor..!Dialogue: 50,0:16:54.99,0:16:57.08,Main-207-,,0,0,0,,Bu yerin nesi var?Dialogue: 50,0:16:58.41,0:17:00.37,Main-207-,,0,0,0,,Tavan çöküyor!Dialogue: 50,0:17:11.43,0:17:13.30,Main-207-,,0,0,0,,Şüphesiz!Dialogue: 50,0:17:13.30,0:17:17.06,Main-207-,,0,0,0,,Bombacı orada olmalı! Başka bir yerde olamazlar!Dialogue: 50,0:17:17.06,0:17:19.89,Main-207-,,0,0,0,,Orada olduklarından emin misin, Vivi?!Dialogue: 50,0:17:20.44,0:17:23.23,Main-207-,,0,0,0,,Bu kum fırtınası onun planının bir parçasıysa...Dialogue: 50,0:17:24.15,0:17:27.65,Main-207-,,0,0,0,,meydanı görebilecek bir yerde olmalılar!Dialogue: 50,0:17:30.82,0:17:34.03,Main-207-,,0,0,0,,Ayrıca topu saklayacak kadar büyük...Dialogue: 50,0:17:34.03,0:17:36.08,Main-207-,,0,0,0,,ve gökyüzünden görünmemelidir!Dialogue: 50,0:17:36.74,0:17:39.25,Flashbacks-207-,,0,0,0,,Bakın! Düşündüğünüzden büyük, değil mi?Dialogue: 50,0:17:39.79,0:17:42.54,Flashbacks-207-,,0,0,0,,Burayı gizli üssümüz yapmak ister misiniz?Dialogue: 50,0:17:42.54,0:17:43.67,Flashbacks-207-,,0,0,0,,– Evet! – Evet!Dialogue: 50,0:17:43.67,0:17:46.55,Main-207-,,0,0,0,,Düşünebildiğim başka bir yer yok!Dialogue: 50,0:17:46.55,0:17:50.01,Main-207-,,0,0,0,,Bekle! Buraya geliyorlar, diğerlerine mesaj bırakacağım.Dialogue: 50,0:17:50.42,0:17:52.72,Main-207-,,0,0,0,,Ben önden gideceğim, Usopp-san!Dialogue: 50,0:17:52.72,0:17:55.05,Main-207-,,0,0,0,,Ne?! B-Bekle, Vivi! B-Bekle!Dialogue: 50,0:17:55.05,0:17:56.14,Main-207-,,0,0,0,,Çabuk!Dialogue: 50,0:17:55.43,0:17:56.14,Secondary-207-,,0,0,0,,Oh, tamam.Dialogue: 50,0:17:56.72,0:17:59.06,Main-207-,,0,0,0,,Pekâlâ, onu bulduk!Dialogue: 50,0:17:59.06,0:18:01.06,Main-207-,,0,0,0,,Prensesi bulduk!Dialogue: 50,0:18:02.27,0:18:05.19,Main-207-,,0,0,0,,İşaret bıraktığınız için teşekkürler!Dialogue: 50,0:18:05.94,0:18:07.94,Main-207-,,0,0,0,,Daha fazla Baroque Works ajanı mı?!Dialogue: 50,0:18:09.65,0:18:11.40,Main-207-,,0,0,0,,Düşmana yerimizi belli etmişim!Dialogue: 50,0:18:13.07,0:18:15.24,Main-207-,,0,0,0,,Bu Usopp'un işareti.Dialogue: 50,0:18:15.24,0:18:18.29,Main-207-,,0,0,0,,Ne ara saraydan bu kadar uzaklaştım?!Dialogue: 50,0:18:19.87,0:18:21.54,Main-207-,,0,0,0,,İyi, yakınım!Dialogue: 50,0:18:21.96,0:18:24.33,Main-207-,,0,0,0,,Acaba bombacıyı bulabildiler mi?Dialogue: 50,0:18:24.33,0:18:26.59,Main-207-,,0,0,0,,Bulmuş olmalılar! Çabuk!Dialogue: 50,0:18:28.09,0:18:29.76,Main-207-,,0,0,0,,Usopp...Dialogue: 50,0:18:29.76,0:18:32.47,Main-207-,,0,0,0,,Gürültüsü...!Dialogue: 50,0:18:38.18,0:18:40.97,Main-207-,,0,0,0,,Yani bu... bu...Dialogue: 50,0:18:40.97,0:18:42.56,Main-207-,,0,0,0,,İşte fırsat, Vivi!Dialogue: 50,0:18:42.56,0:18:44.06,Main-207-,,0,0,0,,Tamam!Dialogue: 50,0:18:44.06,0:18:46.19,Main-207-,,0,0,0,,Kaçıyorlar!Dialogue: 50,0:18:46.61,0:18:48.32,Main-207-,,0,0,0,,Durun!Dialogue: 50,0:19:08.79,0:19:10.05,Main-207-,,0,0,0,,Sen...!Dialogue: 50,0:19:10.67,0:19:13.01,Main-207-,,0,0,0,,Şimdi seni yakaladım, lanet croc!Dialogue: 50,0:19:14.63,0:19:16.51,Main-207-,,0,0,0,,Niye ölmüyorsun?Dialogue: 50,0:19:16.51,0:19:21.01,Main-207-,,0,0,0,,Niye seni her öldürüşümden sonra karşımda dikiliyorsun?!Dialogue: 50,0:19:21.35,0:19:23.48,Main-207-,,0,0,0,,Söyle?! Hasır Şapka!Dialogue: 50,0:19:23.48,0:19:27.23,Main-207-,,0,0,0,,O neden burada? Yani hayatta mıydı?Dialogue: 50,0:19:27.23,0:19:29.44,Main-207-,,0,0,0,,Kim bu genç adam...?Dialogue: 50,0:19:35.95,0:19:37.41,Main-207-,,0,0,0,,Hasır Şapka...Dialogue: 50,0:19:40.74,0:19:43.25,Main-207-,,0,0,0,,Daha kaç kere seni öldürmeliyim?!Dialogue: 50,0:19:43.58,0:19:46.37,Main-207-,,0,0,0,,Henüz çaldığın şeyi...Dialogue: 50,0:19:46.37,0:19:48.00,Main-207-,,0,0,0,,geri vermedin.Dialogue: 50,0:19:49.04,0:19:50.46,Main-207-,,0,0,0,,Ne çalmışım?Dialogue: 50,0:19:50.96,0:19:52.25,Main-207-,,0,0,0,,Para mı?Dialogue: 50,0:19:52.71,0:19:53.92,Main-207-,,0,0,0,,Şöhret mi?Dialogue: 50,0:19:54.59,0:19:56.05,Main-207-,,0,0,0,,Güven mi?Dialogue: 50,0:19:56.72,0:19:58.14,Main-207-,,0,0,0,,Yaşam mı?Dialogue: 50,0:19:58.47,0:19:59.85,Main-207-,,0,0,0,,Yağmur mu?!Dialogue: 50,0:20:03.97,0:20:05.98,Main-207-,,0,0,0,,Neyi geri vermemi istiyorsun?Dialogue: 50,0:20:05.98,0:20:08.69,Main-207-,,0,0,0,,Sayabildiğimden fazlasını çaldım!Dialogue: 50,0:20:09.60,0:20:10.61,Main-207-,,0,0,0,,Bu ülkeyi!Dialogue: 50,0:20:11.52,0:20:12.90,Main-207-,,0,0,0,,Bu ülkeyi mi?Dialogue: 50,0:20:12.90,0:20:15.40,Main-207-,,0,0,0,,Tuhaf şeyler söylüyorsun.Dialogue: 50,0:20:15.40,0:20:21.91,Main-207-,,0,0,0,,Bu ülkeyi ele geçirmek üzereyim. Yeni hükümdarı ben olacağım!Dialogue: 50,0:20:23.20,0:20:27.87,Main-207-,,0,0,0,,Bu ülkeye ayak bastığımızda onun krallığı...Dialogue: 50,0:20:28.37,0:20:30.00,Main-207-,,0,0,0,,çoktan gitmişti!Dialogue: 50,0:20:34.46,0:20:36.59,Flashbacks-207-,,0,0,0,,İsyan Ordusu'nu vazgeçirmeliyim.Dialogue: 50,0:20:36.59,0:20:39.47,Flashbacks-207-,,0,0,0,,Daha fazla kan dökülmesini istemiyorum.Dialogue: 50,0:20:41.72,0:20:47.89,Flashbacks-207-,,0,0,0,,Geçmişte bu şehir yemyeşil bir cennetmiş.Dialogue: 50,0:20:50.15,0:20:52.02,Flashbacks-207-,,0,0,0,,Lütfen, Vivi-chan!Dialogue: 50,0:20:52.61,0:20:56.36,Flashbacks-207-,,0,0,0,,O aptalları durdurmalısın!Dialogue: 50,0:20:56.44,0:20:59.36,Main-207-,,0,0,0,,Bu gerçekten onun ülkesi olsaydı,Dialogue: 50,0:21:01.07,0:21:02.57,Flashbacks-207-,,0,0,0,,Kimsenin...Dialogue: 50,0:21:02.57,0:21:05.20,Flashbacks-207-,,0,0,0,,ölmemesini istemenin nesi yanlış?!Dialogue: 50,0:21:05.62,0:21:09.71,Flashbacks-207-,,0,0,0,,Bu krallığa tek bir bakış atınca ne yapılması gerektiğini...Dialogue: 50,0:21:11.17,0:21:13.08,Flashbacks-207-,,0,0,0,,ben bile anlayabiliyorum.Dialogue: 50,0:21:15.71,0:21:19.76,Flashbacks-207-,,0,0,0,,Tek başına hayatını riske atmak yeterli mi sanıyorsun?Dialogue: 50,0:21:20.30,0:21:21.43,Flashbacks-207-,,0,0,0,,Benim–Dialogue: 50,0:21:23.76,0:21:27.72,Flashbacks-207-,,0,0,0,,B-Benim verecek başka bir şeyim kalmadı...Dialogue: 50,0:21:30.31,0:21:33.73,Flashbacks-207-,,0,0,0,,Niye hepimizin hayatını seninkiyle birlikte riske atmıyorsun?!Dialogue: 50,0:21:33.73,0:21:35.19,Flashbacks-207-,,0,0,0,,Arkadaş değil miyiz?!Dialogue: 50,0:21:41.66,0:21:44.78,Main-207-,,0,0,0,,Bu gerçekten onun ülkesi olsaydı,Dialogue: 50,0:21:44.78,0:21:46.03,Main-207-,,0,0,0,,daha fazla...Dialogue: 50,0:21:46.03,0:21:47.95,Main-207-,,0,0,0,,gülerdi!Dialogue: 50,0:21:50.66,0:21:55.38,Main-207-,,0,0,0,,Bu etkileyici konuşmandan sonra, suyun olmadan ne yapmayı–Dialogue: 50,0:22:05.93,0:22:07.43,Thoughts-207-,,0,0,0,,İmkânsız...Dialogue: 50,0:22:07.43,0:22:10.64,Thoughts-207-,,0,0,0,,Su kullanmadan beni tekmeledi...Dialogue: 50,0:22:14.60,0:22:16.98,Flashbacks-207-,,0,0,0,,Ülkeme ayak basmamış olsaydın...Dialogue: 50,0:22:16.98,0:22:19.94,Flashbacks-207-,,0,0,0,,Alabasta huzur içinde olurdu!Dialogue: 50,0:22:20.90,0:22:23.15,Flashbacks-207-,,0,0,0,,Yürek parçalayıcı değil mi?Dialogue: 50,0:22:23.15,0:22:27.58,Flashbacks-207-,,0,0,0,,Bu ülkeye duyulan sevgi, onun yok olmasına yol açacaktır.Dialogue: 50,0:22:35.71,0:22:37.09,Main-207-,,0,0,0,,Crocodile!Dialogue: 50,0:22:37.09,0:22:37.63,Main-207-,,0,0,0,,Bek–Dialogue: 50,0:22:51.60,0:22:54.27,Main-207-,,0,0,0,,Pislik... Yoksa o...Dialogue: 50,0:22:57.61,0:22:58.69,Main-207-,,0,0,0,,kanın mıydı?Dialogue: 50,0:23:00.19,0:23:02.86,Main-207-,,0,0,0,,Kan da kumu sertleştirir, değil mi?Dialogue: 50,0:23:13.33,0:23:16.25,Main-207-,,0,0,0,,Rainbase'te, kraliyet sarayında...Dialogue: 50,0:23:16.25,0:23:19.17,Main-207-,,0,0,0,,ve şimdi de bu anıt mezarda.Dialogue: 50,0:23:20.75,0:23:24.67,Main-207-,,0,0,0,,Cehenneme iki kez yaklaştın ve hâlâ bana meydan okuyorsun.Dialogue: 50,0:23:24.67,0:23:27.22,Main-207-,,0,0,0,,Kararlılığının hakkını vereceğim.Dialogue: 50,0:23:27.55,0:23:28.76,Main-207-,,0,0,0,,Seni şerefsiz...!Dialogue: 50,0:23:32.85,0:23:35.19,Main-207-,,0,0,0,,Elbette bir korsan olarak!Dialogue: 50,0:23:36.02,0:23:40.52,Main-207-,,0,0,0,,Görünüşe bakılırsa beni alt etmek için her şeyi yapacaksın.Dialogue: 50,0:23:41.15,0:23:45.49,Main-207-,,0,0,0,,Kabul etmek lazım, benim için ciddi bir sıkıntı oldun.Dialogue: 50,0:23:46.40,0:23:47.53,Main-207-,,0,0,0,,Çıktı...Dialogue: 50,0:23:47.53,0:23:48.53,Main-207-,,0,0,0,,O da ne?Dialogue: 50,0:23:49.87,0:23:51.28,Main-207-,,0,0,0,,Zehirli kanca.Dialogue: 50,0:23:51.66,0:23:52.62,Main-207-,,0,0,0,,Öyle mi?Dialogue: 50,0:23:53.08,0:23:57.58,Main-207-,,0,0,0,,Eğer gerçek bir korsansan, anlıyorsundur…Dialogue: 50,0:23:58.12,0:24:02.13,Main-207-,,0,0,0,,Korsanlar arasındaki düello, ölümüne olur.Dialogue: 50,0:24:02.13,0:24:05.42,Main-207-,,0,0,0,,"Kirli dövüş" diye bir şey yoktur.Dialogue: 50,0:24:13.81,0:24:18.52,Main-207-,,0,0,0,,Meydan infilak edince, bu mezar da yıkılacak.Dialogue: 50,0:24:18.52,0:24:20.69,Main-207-,,0,0,0,,Bu son...Dialogue: 50,0:24:20.69,0:24:22.82,Main-207-,,0,0,0,,Hadi şunu kesin olarak sonuçlandıralım!Dialogue: 50,0:24:26.44,0:24:29.32,Main-207-,,0,0,0,,İşaret o yöndeydi, değil mi?Dialogue: 50,0:24:30.32,0:24:32.37,Main-207-,,0,0,0,,Ya da bu yönde miydi?Dialogue: 50,0:24:34.29,0:24:36.12,Main-207-,,0,0,0,,Ne? Denizciler mi?!Dialogue: 50,0:24:36.12,0:24:38.08,Main-207-,,0,0,0,,Bakın! Bu Roronoa Zoro!Dialogue: 50,0:24:38.08,0:24:41.50,Main-207-,,0,0,0,,Kahretsin. Denizciler bizi bu şehre kadar takip etmiş.Dialogue: 50,0:24:41.50,0:24:43.59,Main-207-,,0,0,0,,Bunun için zamanım yok!Dialogue: 50,0:24:43.59,0:24:45.01,Main-207-,,0,0,0,,Yapacak bir şey yok.Dialogue: 50,0:24:45.01,0:24:47.05,Main-207-,,0,0,0,,Bunu üç saniyede bitireceğim.Dialogue: 50,0:24:47.05,0:24:49.68,Main-207-,,0,0,0,,Lan, buraya nasıl geldin?!Dialogue: 50,0:24:49.68,0:24:51.01,Main-207-,,0,0,0,,Ne yapıyorsun?!Dialogue: 50,0:24:51.43,0:24:53.47,Main-207-,,0,0,0,,Bunu sorması gereken benim!Dialogue: 50,0:24:53.47,0:24:54.60,Main-207-,,0,0,0,,Roronoa Zoro!Dialogue: 50,0:24:54.97,0:24:58.60,Main-207-,,0,0,0,,Geri dön, son köşebaşından kuzeye ilerlersen meydana çıkacaksın!Dialogue: 50,0:24:59.10,0:25:01.10,Main-207-,,0,0,0,,Geri gidip sağa dön. Bu yanlış yol.Dialogue: 50,0:25:01.10,0:25:02.36,Main-207-,,0,0,0,,Aptal mısın sen?!Dialogue: 50,0:25:02.36,0:25:03.61,Main-207-,,0,0,0,,Aptal mı?Dialogue: 50,0:25:03.61,0:25:04.40,Main-207-,,0,0,0,,Çabuk!Dialogue: 50,0:25:04.40,0:25:05.07,Main-207-,,0,0,0,,Git!Dialogue: 50,0:25:05.07,0:25:06.74,Main-207-,,0,0,0,,N-Ne?!Dialogue: 50,0:25:06.74,0:25:08.03,Main-207-,,0,0,0,,Neler oluyor?!Dialogue: 50,0:25:11.99,0:25:14.37,Main-207-,,0,0,0,,Durun! Bekleyin!Dialogue: 50,0:25:30.93,0:25:32.68,Main-207-,,0,0,0,,S-Sa-Sağ ol-Dialogue: 50,0:25:33.51,0:25:35.68,Main-207-,,0,0,0,,Sizi koruyacağız!Dialogue: 50,0:25:35.68,0:25:38.64,Main-207-,,0,0,0,,Lütfen, patlamayı durdurun! Çabuk olun!Dialogue: 50,0:25:39.14,0:25:41.27,Main-207-,,0,0,0,,Teşekkürler. Çabuk, Usopp-san!Dialogue: 50,0:25:41.27,0:25:42.60,Main-207-,,0,0,0,,Ah... Tamam!Dialogue: 50,0:25:56.12,0:25:58.41,Main-207-,,0,0,0,,Hızlı! Hızlı!Dialogue: 50,0:25:58.79,0:26:00.04,Main-207-,,0,0,0,,Çok vakit kaybettik!Dialogue: 50,0:26:00.04,0:26:03.88,Main-207-,,0,0,0,,Neler oluyor anlamıyorum ama Denizciler bize yardım etti!Dialogue: 50,0:26:03.88,0:26:06.09,Main-207-,,0,0,0,,Çok daha kötü olabilirdi!Dialogue: 50,0:26:16.18,0:26:17.26,Main-207-,,0,0,0,,Sersem, odaklan!Dialogue: 50,0:26:18.26,0:26:21.94,Main-207-,,0,0,0,,Bombayı durduramazsak, daha fazla insan ölecek!Dialogue: 50,0:26:22.56,0:26:23.39,Main-207-,,0,0,0,,Evet.Dialogue: 50,0:26:23.39,0:26:27.36,Main-207-,,0,0,0,,Dua etmek işe yaramayacak!Dialogue: 50,0:26:30.82,0:26:34.24,Main-207-,,0,0,0,,İki dakika sonra, ya öleceğiz ya da kazanmış olacağız!Dialogue: 50,0:26:35.03,0:26:36.74,Main-207-,,0,0,0,,90 saniyemiz kaldı!Dialogue: 50,0:26:36.74,0:26:37.16,Main-207-,,0,0,0,,Evet...!Dialogue: 50,0:26:37.16,0:26:38.03,Main-207-,,0,0,0,,Yanındayız!Dialogue: 50,0:26:38.03,0:26:38.70,Main-207-,,0,0,0,,Evet!Dialogue: 50,0:26:43.79,0:26:44.67,Main-207-,,0,0,0,,Oradalar!Dialogue: 50,0:26:44.67,0:26:46.46,Main-207-,,0,0,0,,Vivi! Usopp!Dialogue: 50,0:26:47.38,0:26:49.42,Main-207-,,0,0,0,,Nami-san! Tony-kun!Dialogue: 50,0:26:49.80,0:26:50.92,Main-207-,,0,0,0,,Neler oluyor?!Dialogue: 50,0:26:50.92,0:26:52.67,Main-207-,,0,0,0,,Denizciler bize yardım etti!Dialogue: 50,0:26:52.67,0:26:54.38,Main-207-,,0,0,0,,Bombacıyı buldunuz mu?Dialogue: 50,0:26:55.01,0:26:57.60,Main-207-,,0,0,0,,Henüz değil ama yanılmadığımı biliyorum!Dialogue: 50,0:26:58.39,0:27:01.06,Main-207-,,0,0,0,,Onca zamandır burnumuzun dibindeydi!Dialogue: 50,0:27:01.52,0:27:04.73,Main-207-,,0,0,0,,Bombacı kesinlikle orada olmalı!Dialogue: 50,0:27:07.52,0:27:08.61,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:27:10.11,0:27:11.32,Main-207-,,0,0,0,,Saat kulesi...Dialogue: 50,0:27:11.32,0:27:12.36,Main-207-,,0,0,0,,Anlıyorum!Dialogue: 50,0:27:12.36,0:27:14.78,Main-207-,,0,0,0,,Oradan meydana nişan almak kolay olurdu!Dialogue: 50,0:27:15.20,0:27:18.24,Main-207-,,0,0,0,,Pell burada olsaydı, patlamayı durdurabilirdi.Dialogue: 50,0:27:19.37,0:27:20.29,Main-207-,,0,0,0,,Pell...!Dialogue: 50,0:27:29.75,0:27:31.55,Main-207-,,0,0,0,,Hiç vakit kalmadı!Dialogue: 50,0:27:32.21,0:27:36.38,Main-207-,,0,0,0,,İşaretin buradan bir yerden atıldığını biliyorum ama...Dialogue: 50,0:27:37.55,0:27:39.89,Main-207-,,0,0,0,,Vırak, vırak, vırak, vırak...Dialogue: 50,0:27:39.89,0:27:41.06,Main-207-,,0,0,0,,Hey, dinle!Dialogue: 50,0:27:41.06,0:27:45.31,Main-207-,,0,0,0,,Az önce Vırak Vırak Tabanca'mla kocaman bir kuş düşürdüm!Dialogue: 50,0:27:50.61,0:27:52.23,Main-207-,,0,0,0,,Dikkatsiz davrandım...Dialogue: 50,0:28:39.61,0:28:41.99,Main-207-,,0,0,0,,Lastik-Lastik Taban–Dialogue: 50,0:29:43.76,0:29:46.51,Thoughts-207-,,0,0,0,,Tanrı aşkına kim bu adam?Dialogue: 50,0:29:47.10,0:29:53.06,Thoughts-207-,,0,0,0,,Krallığın en iyi savaşçıları Crocodile karşısında karınca gibiydi, ama o...Dialogue: 50,0:30:00.65,0:30:04.53,Main-207-,,0,0,0,,Kancalanma, canlı canlı gömülme, kurutulma.Dialogue: 50,0:30:06.62,0:30:11.16,Main-207-,,0,0,0,,Tüm bunlardan kurtulmuş olabilirsin,Dialogue: 50,0:30:11.16,0:30:13.00,Main-207-,,0,0,0,,ama bundan kurtulamayacaksın.Dialogue: 50,0:30:13.00,0:30:17.00,Main-207-,,0,0,0,,Dövüş bitti. Zehir çoktan vücudunda yayılıyor.Dialogue: 50,0:30:17.88,0:30:21.26,Main-207-,,0,0,0,,Hâlâ anlamıyorsun!Dialogue: 50,0:30:23.01,0:30:24.47,Main-207-,,0,0,0,,Ona ne oldu?Dialogue: 50,0:30:26.18,0:30:28.72,Main-207-,,0,0,0,,Pell'i hiçbir yerde göremiyorum.Dialogue: 50,0:30:29.31,0:30:30.64,Main-207-,,0,0,0,,Hey, Vivi.Dialogue: 50,0:30:30.64,0:30:34.56,Main-207-,,0,0,0,,Nerede olduğunu bilsek bile, bir dakikada oraya çıkamayız!Dialogue: 50,0:30:34.56,0:30:36.73,Main-207-,,0,0,0,,Pell, neredesin? Çabuk!Dialogue: 50,0:30:37.19,0:30:39.48,Main-207-,,0,0,0,,Kendimiz denemeliyiz!Dialogue: 50,0:30:39.90,0:30:41.78,Main-207-,,0,0,0,,Tek seçenek merdivenler! Giriş–Dialogue: 50,0:30:41.78,0:30:43.61,Main-207-,,0,0,0,,Hey!Dialogue: 50,0:30:43.61,0:30:44.36,Main-207-,,0,0,0,,– Ha?! – Ha?!Dialogue: 50,0:30:44.36,0:30:47.33,Main-207-,,0,0,0,,Nami-swan! Vivi-chwan!Dialogue: 50,0:30:47.33,0:30:49.83,Main-207-,,0,0,0,,Sen niye oradasın?Dialogue: 50,0:30:49.83,0:30:51.00,Main-207-,,0,0,0,,Niye mi?!Dialogue: 50,0:30:51.00,0:30:54.29,Main-207-,,0,0,0,,Duman işaretinin ardında not bırakmadınız mı?!Dialogue: 50,0:30:54.67,0:30:58.29,Main-207-,,0,0,0,,"Saat Kulesi" yazıyordu, ben de buraya kadar çıktım.Dialogue: 50,0:30:59.30,0:31:00.21,Main-207-,,0,0,0,,Ne yapmalıyım?Dialogue: 50,0:31:00.88,0:31:02.72,Main-207-,,0,0,0,,Bombacı nerede?Dialogue: 50,0:31:02.72,0:31:04.88,Main-207-,,0,0,0,,En tepede! Tepede!Dialogue: 50,0:31:04.88,0:31:06.64,Main-207-,,0,0,0,,Tepeye çık ve onları mahvet!Dialogue: 50,0:31:06.64,0:31:07.18,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:31:07.55,0:31:08.81,Main-207-,,0,0,0,,Ha? Ne...?!Dialogue: 50,0:31:08.81,0:31:11.31,Main-207-,,0,0,0,,Hey, sizi arıyordum!Dialogue: 50,0:31:11.31,0:31:13.43,Main-207-,,0,0,0,,Zoro! Sen de mi?!Dialogue: 50,0:31:13.43,0:31:15.02,Main-207-,,0,0,0,,Orada ne yapıyorsun?Dialogue: 50,0:31:15.02,0:31:17.31,Main-207-,,0,0,0,,Bunu ben soracaktım!Dialogue: 50,0:31:17.31,0:31:21.32,Main-207-,,0,0,0,,Şey, Denizciler "Kuzeye git! Kuzeye git!" deyip durdu.Dialogue: 50,0:31:21.32,0:31:22.99,Main-207-,,0,0,0,,ben de yukarı çıktım!Dialogue: 50,0:31:22.99,0:31:25.28,Main-207-,,0,0,0,,"Kuzey" ve "yukarı" tamamen farklı şeyler!Dialogue: 50,0:31:25.28,0:31:27.24,Main-207-,,0,0,0,,Her halükârda iyi işti!Dialogue: 50,0:31:27.24,0:31:30.83,Main-207-,,0,0,0,,Tırmanmaya devam edin ve bombacıyı mahvedin!Dialogue: 50,0:31:30.83,0:31:31.95,Main-207-,,0,0,0,,Olmaz!Dialogue: 50,0:31:31.29,0:31:31.95,Secondary-207-,,0,0,0,,Ne?!Dialogue: 50,0:31:32.41,0:31:35.58,Main-207-,,0,0,0,,Oldukları yerden saat kulesine giremezler.Dialogue: 50,0:31:35.58,0:31:41.09,Main-207-,,0,0,0,,Uçamıyorsanız içeri girmenin tek yolu, birinci katın öbür ucundaki merdivenler.Dialogue: 50,0:31:41.67,0:31:44.30,Main-207-,,0,0,0,,Ama Zoro kule duvarlarını kolaylıkla kırabilir.Dialogue: 50,0:31:44.97,0:31:48.55,Main-207-,,0,0,0,,Bu patlamaya yol açabilir!Dialogue: 50,0:31:48.55,0:31:50.76,Main-207-,,0,0,0,,Başka çaremiz yok. Tek yol merdivenler.Dialogue: 50,0:31:50.76,0:31:52.01,Main-207-,,0,0,0,,Bekle, Vivi.Dialogue: 50,0:31:52.01,0:31:52.60,Main-207-,,0,0,0,,Ne?Dialogue: 50,0:31:53.39,0:31:55.06,Main-207-,,0,0,0,,Aklıma bir fikir geldi!Dialogue: 50,0:32:00.02,0:32:03.23,Main-207-,,0,0,0,,Vırak... vırak, vırak, vırak...Dialogue: 50,0:32:10.66,0:32:12.54,Main-207-,,0,0,0,,Hey, dinle, Bay 7!Dialogue: 50,0:32:12.54,0:32:16.50,Main-207-,,0,0,0,,Bu son görevimiz.Dialogue: 50,0:32:16.50,0:32:19.00,Main-207-,,0,0,0,,Vırak, vırak, vırak...Dialogue: 50,0:32:20.25,0:32:22.17,Main-207-,,0,0,0,,İşte planımız.Dialogue: 50,0:32:24.17,0:32:27.47,Main-207-,,0,0,0,,Plana göre otuz saniyemiz kaldı.Dialogue: 50,0:32:30.14,0:32:31.30,Main-207-,,0,0,0,,Onlar da kim?Dialogue: 50,0:32:31.30,0:32:34.72,Main-207-,,0,0,0,,Bay 7 ve Bayan Father's Day!Dialogue: 0,0:01:54.97,0:01:57.39,Title-207-,,0,0,0,,CrocumsuDialogue: 1,0:01:54.97,0:01:57.39,Title-207-,,0,0,0,,CrocumsuDialogue: 0,0:03:00.83,0:03:05.08,Captions-207-,,0,0,0,,Kraliyet Anıt Mezarı (Kraliyet Ailesi Mezarı) Sarayın BatısıDialogue: 1,0:03:00.83,0:03:05.08,Captions-207-,,0,0,0,,Kraliyet Anıt Mezarı (Kraliyet Ailesi Mezarı) Sarayın BatısıDialogue: 2,0:03:00.83,0:03:05.08,Captions-207-,,0,0,0,,Kraliyet Anıt Mezarı (Kraliyet Ailesi Mezarı) Sarayın BatısıDialogue: 0,0:32:18.08,0:32:24.26,Captions-207-,,0,0,0,,Bay 7 Baroque Works Sınır AjanıDialogue: 1,0:32:18.08,0:32:24.26,Captions-207-,,0,0,0,,Bay 7 Baroque Works Sınır AjanıDialogue: 2,0:32:18.08,0:32:24.26,Captions-207-,,0,0,0,,Bay 7 Baroque Works Sınır AjanıDialogue: 0,0:32:18.08,0:32:24.26,Captions-207-,,0,0,0,,Bayan Father's Day Baroque Works Sınır AjanıDialogue: 1,0:32:18.08,0:32:24.26,Captions-207-,,0,0,0,,Bayan Father's Day Baroque Works Sınır AjanıDialogue: 2,0:32:18.08,0:32:24.26,Captions-207-,,0,0,0,,Bayan Father's Day Baroque Works Sınır AjanıDialogue: 0,0:00:01.73,0:00:03.73,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 1,0:00:01.73,0:00:03.73,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 0,0:00:01.73,0:00:03.73,Credits-207-,,0,0,0,,Gigglebot fedewDialogue: 1,0:00:01.73,0:00:03.73,Credits-207-,,0,0,0,,Gigglebot fedewDialogue: 0,0:00:03.73,0:00:05.73,Credits-207-,,0,0,0,,ZamanlamaDialogue: 1,0:00:03.73,0:00:05.73,Credits-207-,,0,0,0,,ZamanlamaDialogue: 0,0:00:03.73,0:00:05.73,Credits-207-,,0,0,0,,GabDialogue: 1,0:00:03.73,0:00:05.73,Credits-207-,,0,0,0,,GabDialogue: 0,0:00:05.73,0:00:09.73,Credits-207-,,0,0,0,,Kalite KontrolDialogue: 1,0:00:05.73,0:00:09.73,Credits-207-,,0,0,0,,Kalite KontrolDialogue: 0,0:00:05.73,0:00:09.73,Credits-207-,,0,0,0,,Galaxy 9000 Pepperjack PhosCity Scolines ZenefDialogue: 1,0:00:05.73,0:00:09.73,Credits-207-,,0,0,0,,Galaxy 9000 Pepperjack PhosCity Scolines ZenefDialogue: 0,0:00:09.73,