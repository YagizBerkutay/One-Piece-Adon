ogue: 1,0:00:16.79,0:00:19.25,Credits-207-,,0,0,0,,Çevirmenler [TR]Dialogue: 0,0:00:16.79,0:00:19.25,Credits-207-,,0,0,0,,Jack Cohle Kazasker -onepacetr.net-Dialogue: 1,0:00:16.79,0:00:19.25,Credits-207-,,0,0,0,,Jack Cohle Kazasker -onepacetr.net-Dialogue: 0,0:00:01.52,0:00:03.65,Roger-Monologue,,0,0,0,,Zenginlik, şöhret, güç...Dialogue: 0,0:00:03.65,0:00:07.82,Roger-Monologue,,0,0,0,,Dünyanın sunabileceği her şeyi elde eden adam, Korsanlar Kralı, Gold Roger.Dialogue: 0,0:00:07.82,0:00:11.66,Roger-Monologue,,0,0,0,,Son sözleri dünyanın her yerinden maceracıları denize çekti.Dialogue: 0,0:00:11.66,0:00:13.66,Roger-Monologue,,0,0,0,,Hazinem mi?Dialogue: 0,0:00:13.66,0:00:15.45,Roger-Monologue,,0,0,0,,İstiyorsanız, alabilirsiniz.Dialogue: 0,0:00:15.45,0:00:16.66,Roger-Monologue,,0,0,0,,Arayıp bulun!Dialogue: 0,0:00:16.66,0:00:19.25,Roger-Monologue,,0,0,0,,Bu dünyanın sunabileceği her şeyi orada bıraktım!Dialogue: 0,0:00:21.67,0:00:26.38,Roger-Monologue,,0,0,0,,Artık herkes, hayallerinin peşinde Grand Line’a yelken açıyor!Dialogue: 0,0:00:26.38,0:00:29.63,Roger-Monologue,,0,0,0,,Dünya, Büyük Korsan Çağı'na girdi!Dialogue: 2,0:00:29.91,0:00:35.35,Lyrics,,0,0,0,fx,ADialogue: 2,0:00:29.91,0:00:35.35,Lyrics,,0,0,0,fx,tDialogue: 2,0:00:29.91,0:00:35.35,Lyrics,,0,0,0,fx,lDialogue: 2,0:00:29.91,0:00:35.35,Lyrics,,0,0,0,fx,aDialogue: 2,0:00:29.91,0:00:35.35,Lyrics,,0,0,0,fx,yDialogue: 2,0:00:29.91,0:00:35.35,Lyrics,,0,0,0,fx,ıDialogue: 2,0:00:29.91,0:00:35.35,Lyrics,,0,0,0,fx,nDialogue: 2,0:00:29.91,0:00:35.35,Lyrics,,0,0,0,fx,Dialogue: 2,0:00:29.91,0:00:35.35,Lyrics,,0,0,0,fx,gDialogue: 2,0:00:29.91,0:00:35.35,Lyrics,,0,0,0,fx,eDialogue: 2,0:00:29.91,0:00:35.35,Lyrics,,0,0,0,fx,mDialogue: 2,0:00:29.91,0:00:35.35,Lyrics,,0,0,0,fx,iDialogue: 2,0:00:29.91,0:00:35.35,Lyrics,,0,0,0,fx,yDialogue: 2,0:00:29.91,0:00:35.35,Lyrics,,0,0,0,fx,eDialogue: 2,0:00:29.91,0:00:35.35,Lyrics,,0,0,0,fx,,Dialogue: 2,0:00:29.91,0:00:35.35,Lyrics,,0,0,0,fx,Dialogue: 2,0:00:29.91,0:00:35.35,Lyrics,,0,