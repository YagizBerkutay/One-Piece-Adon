Dialogue: 0,0:00:05.30,0:00:09.17,Lyrics,,0,0,0,,♪ Gökyüzüne ulaşana kadar, ♪
Dialogue: 0,0:00:09.27,0:00:15.71,Lyrics,,0,0,0,,♪ İnanıyorum, sonraki yarına kadar, hey ♪
Dialogue: 0,0:00:15.73,0:00:19.13,Lyrics,,0,0,0,,♪ hadi millet gidelim, müziği paylaşıyoruz. ♪
Dialogue: 0,0:00:19.96,0:00:23.36,Lyrics,,0,0,0,,♪ hadi gidelim bebeğim, bebeğim, oh tek bir hayali paylaşıyoruz. ♪
Dialogue: 0,0:00:23.88,0:00:27.28,Lyrics,,0,0,0,,♪ hadi millet gidelim, oh iyi zamanları paylaşıyoruz. ♪
Dialogue: 0,0:00:27.71,0:00:31.11,Lyrics,,0,0,0,,♪ hadi gidelim bebeğim, bebeğim, oh tek bir dünyayı paylaşıyoruz. ♪
Dialogue: 0,0:00:31.81,0:00:35.55,Lyrics,,0,0,0,,♪ Mobius yüzüğünün tepesinde kovalıyor ve kovalanıyor. ♪
Dialogue: 0,0:00:35.58,0:00:39.35,Lyrics,,0,0,0,,♪ Yaklaşıyor ve ileri bakıyorum, hey tarzını paylaşmak istiyorum. ♪
Dialogue: 0,0:00:39.52,0:00:43.45,Lyrics,,0,0,0,,♪ Başlıyor, genişliyor, hayal gücünün üstündeki bu tat. ♪
Dialogue: 0,0:00:43.52,0:00:47.76,Lyrics,,0,0,0,,♪ Vücudumu baştan başa iyi hissediyorum, özgür kalacağım, oh evet ♪
Dialogue: 0,0:00:47.79,0:00:49.79,Lyrics,,0,0,0,,♪ Uzakta olsa da, müziği paylaş. ♪
Dialogue: 0,0:00:49.79,0:00:51.73,Lyrics,,0,0,0,,♪ Birbirine anlatarak o rüyayı paylaş. ♪
Dialogue: 0,0:00:51.76,0:00:53.60,Lyrics,,0,0,0,,♪ İyi zamanları ve kahkahaları paylaş. ♪
Dialogue: 0,0:00:53.72,0:00:55.27,Lyrics,,0,0,0,,♪ şimdi tek bir dünyayı paylaş. ♪
Dialogue: 0,0:00:55.45,0:01:03.74,Lyrics,,0,0,0,,♪ Gökyüzüne ulaşana kadar gitmeye devam edeceğim. ♪
Dialogue: 0,0:01:03.81,0:01:13.05,Lyrics,,0,0,0,,♪ Hadi üstesinden gelelim, sonraki yarınlara inanıyorum, evet evet... ♪
Dialogue: 0,0:01:13.15,0:01:21.56,Lyrics,,0,0,0,,♪ Görünmez duvarın diğer tarafında bekliyordun. ♪
Dialogue: 0,0:01:21.66,0:01:31.62,Lyrics,,0,0,0,,♪ Yakında orada olacağım, tek bir dünyaya inanıyorum, evet evet... ♪
Dialogue: 0,0:01:31.64,0:01:35.04,Lyrics,,0,0,0,,♪ hadi millet gidelim, müziği paylaşıyoruz. ♪
Dialogue: 0,0:01:35.67,0:01:39.87,Lyrics,,0,0,0,,♪ hadi gidelim bebeğim, bebeğim, oh tek bir dünyayı paylaşıyoruz. ♪
Dialogue: 0,0:01:39.95,0:01:45.02,Title,,0,0,150,,{\fad(1000,0)}Dans Eden Kabarcık\N\N\N\N\N\N\N\N\N\N\N\NTakımadası Macerası
Dialogue: 0,0:01:45.64,0:01:47.66,Main,Luffy,0,0,0,,Çok leziz!
Dialogue: 0,0:01:52.76,0:01:53.26,Main,Camie,0,0,0,,Değil mi?
Dialogue: 0,0:01:53.36,0:01:55.42,Main,Camie,0,0,0,,Hacchin'in takoyakisi\Ndünyanın en iyisidir, değil mi?
Dialogue: 0,0:01:55.52,0:01:57.32,Main,Luffy,0,0,0,,Duramıyorum, durdurulmazım!
Dialogue: 0,0:01:57.44,0:01:59.18,Main,Luffy,0,0,0,,Bu takoyaki harika!
Dialogue: 0,0:02:05.36,0:02:06.55,Main,Sanji,0,0,0,,Gerçekten leziz.
Dialogue: 0,0:02:06.68,0:02:09.98,Main,Sanji,0,0,0,,Sosun tadını nasıl bu\Nşekilde ortaya çıkarıyor?
Dialogue: 0,0:02:12.53,0:02:15.08,Main,Usopp,0,0,0,,Denizdeki yiyecek standında\Nmüthiş bir şey var, ha?
Dialogue: 0,0:02:18.36,0:02:21.68,Main,Brook,0,0,0,,İlk kez takoyaki yiyorum.
Dialogue: 0,0:02:21.91,0:02:23.13,Main,Brook,0,0,0,,Tadı harika.
Dialogue: 0,0:02:23.30,0:02:24.97,Main,Brook,0,0,0,,Midem patlayacak gibi.
Dialogue: 0,0:02:24.97,0:02:27.31,Main,Brook,0,0,0,,Gerçi midem yok.
Dialogue: 0,0:02:28.24,0:02:30.44,Main,Hachi,0,0,0,,İstediğiniz kadar yiyin, bugün bedava!
Dialogue: 0,0:02:30.56,0:02:34.00,Main,Hachi,0,0,0,,Bizi kurtarmanıza karşılık\Nteşekkür etme şeklimiz!
Dialogue: 0,0:02:34.10,0:02:36.73,Main,Camie,0,0,0,,Bunların içinde Dashi ve\Nbunlarda da Mochi var.
Dialogue: 0,0:02:36.84,0:02:38.31,Main,Camie,0,0,0,,Henüz sıcaklar, dikkatli olun.
Dialogue: 0,0:02:40.62,0:02:41.28,Main,Hachi,0,0,0,,Peki...
Dialogue: 0,0:02:42.96,0:02:44.15,Main,Hachi,0,0,0,,O ne düşünüyor?
Dialogue: 0,0:02:44.30,0:02:46.02,Main,Hachi,0,0,0,,Şey, Nami?
Dialogue: 0,0:02:49.44,0:02:50.34,Main,Hachi,0,0,0,,O...
Dialogue: 0,0:02:50.50,0:02:51.21,Main,Hachi,0,0,0,,Şey...
Dialogue: 0,0:02:51.44,0:02:53.32,Main,Hachi,0,0,0,,T-Tadı nasıl?
Dialogue: 0,0:02:55.20,0:02:58.66,Main,Nami,0,0,0,,Sırf bu yüzden seni affedecek\Ndeğilim, biliyorsun.
Dialogue: 0,0:02:59.02,0:03:00.90,Main,Hachi,0,0,0,,Elbette hayır!
Dialogue: 0,0:03:01.04,0:03:02.76,Main,Hachi,0,0,0,,Kastettiğim bu değildi!
Dialogue: 0,0:03:02.86,0:03:05.52,Main,Hachi,0,0,0,,Sadece samimi olarak ne\Ndüşündüğünü bilmek istedim!
Dialogue: 0,0:03:06.76,0:03:08.24,Main,Nami,0,0,0,,Çok leziz!
Dialogue: 0,0:03:11.60,0:03:12.37,Main,Hachi,0,0,0,,Gerçekten?
Dialogue: 0,0:03:12.52,0:03:13.84,Main,Hachi,0,0,0,,Öyle mi?
Dialogue: 0,0:03:14.00,0:03:17.93,Main,Hachi,0,0,0,,Harika, şimdi rahatladım!
Dialogue: 0,0:03:18.06,0:03:19.40,Main,Hachi,0,0,0,,Tamam çocuklar!
Dialogue: 0,0:03:19.51,0:03:21.98,Main,Hachi,0,0,0,,İstediğiniz kadar yiyin!
Dialogue: 0,0:03:22.10,0:03:23.52,Main,Luffy,0,0,0,,Tamam! Yapmaya devam et!
Dialogue: 0,0:03:23.64,0:03:25.60,Main,Luffy,0,0,0,,Hepsini yiyeceğim!
Dialogue: 0,0:03:38.20,0:03:41.48,Main,Duval,0,0,0,,Hey, çocuklar!
Dialogue: 0,0:03:42.06,0:03:44.50,Main,Duval,0,0,0,,Genç efendiler!
Dialogue: 0,0:03:45.00,0:03:45.89,Main,Zoro,0,0,0,,O da kim?
Dialogue: 0,0:03:46.24,0:03:47.18,Main,Robin,0,0,0,,Bu ses...
Dialogue: 0,0:03:48.26,0:03:50.33,Main,Duval,0,0,0,,Durun, durun!
Dialogue: 0,0:03:50.88,0:03:53.46,Main,Duval,0,0,0,,Bize teşekkür etme fırsatı\Nvermeden gitmeyin!
Dialogue: 0,0:03:56.28,0:03:57.14,Main,Duval,0,0,0,,Ben Yakışıklı...
Dialogue: 0,0:03:57.31,0:03:58.82,Main,Duval,0,0,0,,Ah, hayır.
Dialogue: 0,0:03:59.48,0:04:01.32,Main,Duval,0,0,0,,Benim, Duval!
Dialogue: 0,0:04:05.00,0:04:08.00,Main,Luffy,0,0,0,,Yüzü şöyle görünmüyor muydu?
Dialogue: 0,0:04:10.22,0:04:11.94,Main,Sanji,0,0,0,,Kemik yapısını değiştirdim.
Dialogue: 0,0:04:12.11,0:04:14.64,Main,Sanji,0,0,0,,Şu anda şikayet edecek bir\Nşeyi olmamalı, değil mi?
Dialogue: 0,0:04:14.82,0:04:16.78,Main,Duval,0,0,0,,Ah, Efendi Kara Bacak...
Dialogue: 0,0:04:16.98,0:04:22.42,Main,Duval,0,0,0,,Sen çenemi dağıttıkta sonra,\Nuyandığımda hepimiz şaşırdık!
Dialogue: 0,0:04:22.60,0:04:24.92,Main,Duval,0,0,0,,Beni gerçekten yakışıklı yapmışsın!
Dialogue: 0,0:04:25.08,0:04:27.54,Main,Duval,0,0,0,,Artık kendimi tanıyamıyorum bile!
Dialogue: 0,0:04:27.74,0:04:29.37,Main,Duval,0,0,0,,Artık kızlar benim için delirecek.
Dialogue: 0,0:04:29.58,0:04:30.43,Main,Duval,0,0,0,,Gerçekten...
Dialogue: 0,0:04:31.30,0:04:33.85,Main,Duval,0,0,0,,...gül gibi bir hayat demeliyim!
Dialogue: 0,0:04:35.86,0:04:39.92,Main,Duval,0,0,0,,En kısa zamanda tembel kasaba\Nhayatıma geri dönmek istiyorum.
Dialogue: 0,0:04:40.19,0:04:44.66,Main,Duval,0,0,0,,Ama size şükranımı sunmadan gitseydim\Neğer kendimi asla affedemezdim!
Dialogue: 0,0:04:44.95,0:04:47.17,Main,Duval,0,0,0,,İlk kez buraları ziyarete\Ngeliyorsunuz, değil mi?
Dialogue: 0,0:04:47.28,0:04:51.84,Main,Duval,0,0,0,,Yardımcı olacağımız bir şey\Nolursa bizi çağırmanız yeterli!
Dialogue: 0,0:04:54.48,0:04:56.42,Main,Sanji,0,0,0,,Alışkın değilsen göz kırpma!
Dialogue: 0,0:04:56.82,0:04:59.60,Main,Sanji,0,0,0,,Tatmin olmuş olman yeterli.
Dialogue: 0,0:05:00.03,0:05:02.66,Main,Sanji,0,0,0,,Bize iyilik yapmak istiyorsan\Nbir daha rahatsız etme yeter.
Dialogue: 0,0:05:02.73,0:05:03.90,Main,Duval,0,0,0,,Güzel...
Dialogue: 0,0:05:04.00,0:05:05.34,Main,Duval,0,0,0,,Çok güzel!
Dialogue: 0,0:05:05.44,0:05:07.04,Main,Sanji,0,0,0,,Dinliyor musun?!
Dialogue: 0,0:05:07.16,0:05:08.84,Main,Duval,0,0,0,,Beyaz bir ata binmek istiyorum.
Dialogue: 0,0:05:09.14,0:05:10.26,Main,Sanji,0,0,0,,Hey, dinle!
Dialogue: 0,0:05:10.37,0:05:10.78,Main,Rider,0,0,0,,Patron...
Dialogue: 0,0:05:10.87,0:05:11.60,Main,Rider,0,0,0,,Patron!
Dialogue: 0,0:05:11.72,0:05:12.92,Main,Rider,0,0,0,,Onun söylediğini dinle!
Dialogue: 0,0:05:13.04,0:05:14.36,Main,Duval,0,0,0,,Ah, doğru.
Dialogue: 0,0:05:14.72,0:05:15.26,Main,Duval,0,0,0,,Ne?
Dialogue: 0,0:05:15.38,0:05:16.16,Main,Duval,0,0,0,,Yakışıklı mıyım?
Dialogue: 0,0:05:16.29,0:05:18.48,Main,Sanji,0,0,0,,Bu konuda tek kelime etmedim!
Dialogue: 0,0:05:30.54,0:05:32.50,Main,Duval,0,0,0,,Biraz utandırıcı ama kabul ediyorum!
Dialogue: 0,0:05:32.84,0:05:35.11,Main,Duval,0,0,0,,Senin ilk öpücüğünü!
Dialogue: 0,0:05:36.26,0:05:37.36,Main,Nami,0,0,0,,Öyle bir şey yapmıyordum!
Dialogue: 0,0:05:37.47,0:05:39.48,Main,Nami,0,0,0,,Sadece dudağımdaki takoyakiyi siliyordum!
Dialogue: 0,0:05:41.48,0:05:43.75,Main,Nami,0,0,0,,Ne tür bir iyimser yanılsama içindesin?
Dialogue: 0,0:05:43.86,0:05:45.78,Main,Duval,0,0,0,,Ah, ayna, ayna...
Dialogue: 0,0:05:45.94,0:05:48.40,Main,Duval,0,0,0,,...bu dünyadaki en yakışıklı\Nadam kim? Ben miyim?
Dialogue: 0,0:05:48.48,0:05:49.82,Main,Riders,0,0,0,,Ona tek seçenek mi bırakıyorsun?!
Dialogue: 0,0:05:52.97,0:05:56.26,Main,Usopp,0,0,0,,Yakışıklı olduğunu anlıyoruz\Nama hala bir aptalsın.
Dialogue: 0,0:05:59.95,0:06:00.66,Main,Duval,0,0,0,,Kıskançlık?
Dialogue: 0,0:06:00.90,0:06:01.92,Main,Usopp,0,0,0,,Hiç de bile!
Dialogue: 0,0:06:02.00,0:06:02.91,Main,Luffy,0,0,0,,Kes şunu, Usopp!
Dialogue: 0,0:06:03.06,0:06:05.13,Main,Luffy,0,0,0,,Onun deliliğine denk değilsin!
Dialogue: 0,0:06:05.49,0:06:07.03,Main,Duval,0,0,0,,Tamam o zaman, genç efendi!
Dialogue: 0,0:06:07.24,0:06:09.15,Main,Duval,0,0,0,,İşte Den Den Mushi numaram.
Dialogue: 0,0:06:09.32,0:06:10.84,Main,Duval,0,0,0,,Ne zaman isterseniz arayın!
Dialogue: 0,0:06:11.04,0:06:13.77,Main,Duval,0,0,0,,Zamanı geldiğinde size\Nkesinlikle yardımcı olacağım!
Dialogue: 0,0:06:14.78,0:06:17.37,Main,Duval,0,0,0,,Size gerçekten çok sıkıntı çıkardım, ha?
Dialogue: 0,0:06:17.69,0:06:21.58,Main,Duval,0,0,0,,Gerçekten üz... günüm!
Dialogue: 0,0:06:22.25,0:06:24.72,Main,Duval,0,0,0,,Gidelim, Gül Gibi Hayat Binicileri!
Dialogue: 0,0:06:24.84,0:06:26.44,Main,Riders,0,0,0,,Peki, Yakışıklı!
Dialogue: 0,0:06:26.97,0:06:28.28,Main,Luffy; Sanji and Usopp,0,0,0,,Gidin artık.
Dialogue: 0,0:06:30.13,0:06:32.96,Main,Luffy,0,0,0,,Ah, doydum!
Dialogue: 0,0:06:33.14,0:06:35.64,Main,Luffy,0,0,0,,Ah, çok yedim!
Dialogue: 0,0:06:35.76,0:06:37.26,Main,Luffy,0,0,0,,Cennet'teyim!
Dialogue: 0,0:06:37.68,0:06:40.73,Main,Brook,0,0,0,,Ah, ne mükemmel bir öğleden sonrası...
Dialogue: 0,0:06:40.82,0:06:42.47,Main,Brook,0,0,0,,İlk kez takoyaki yedim.
Dialogue: 0,0:06:42.56,0:06:44.07,Main,Brook,0,0,0,,Ben de epey tatmin oldum.
Dialogue: 0,0:06:45.65,0:06:47.11,Main,Brook,0,0,0,,Ah, afedersiniz.
Dialogue: 0,0:06:50.95,0:06:53.02,Main,Nami,0,0,0,,Bu çok pisti!
Dialogue: 0,0:06:55.01,0:06:56.26,Main,Hachi,0,0,0,,Yoruldum.
Dialogue: 0,0:06:56.38,0:06:57.98,Main,Hachi,0,0,0,,Gerçekten çok yediler.
Dialogue: 0,0:06:58.18,0:07:00.22,Main,Hachi,0,0,0,,Hasır Şapka Tayfası'ndan da bu beklenir.
Dialogue: 0,0:07:00.33,0:07:02.79,Main,Hachi,0,0,0,,Keşke altı kolum daha olsaydı.
Dialogue: 0,0:07:02.96,0:07:04.32,Main,Camie,0,0,0,,İyi iş, Hacchin!
Dialogue: 0,0:07:05.58,0:07:07.20,Main,Camie,0,0,0,,Hepsi tatmin olmuş görünüyor.
Dialogue: 0,0:07:08.52,0:07:09.30,Main,Hachi,0,0,0,,Öyle mi?
Dialogue: 0,0:07:09.42,0:07:10.92,Main,Hachi,0,0,0,,O zaman ben de tatmin oldum.
Dialogue: 0,0:07:12.07,0:07:13.36,Main,Usopp,0,0,0,,Çok güzeldi!
Dialogue: 0,0:07:13.51,0:07:14.84,Main,Chopper,0,0,0,,Daha fazla yiyemem.
Dialogue: 0,0:07:15.04,0:07:15.75,Main,Sanji,0,0,0,,Hey!
Dialogue: 0,0:07:15.88,0:07:18.32,Main,Sanji,0,0,0,,Ahtapot, denizyıldızı, Caimie-chan!
Dialogue: 0,0:07:18.62,0:07:20.26,Main,Sanji,0,0,0,,Mola vermek istiyorsanız güverteye gelin.
Dialogue: 0,0:07:20.34,0:07:21.64,Main,Sanji,0,0,0,,Size çay ikram edeceğim.
Dialogue: 0,0:07:21.81,0:07:22.44,Main,Camie,0,0,0,,Tamam!
Dialogue: 0,0:07:24.12,0:07:25.66,Main,Hachi,0,0,0,,Güzel çay.
Dialogue: 0,0:07:27.21,0:07:28.76,Main,Camie,0,0,0,,Gideceğimiz rota bu.
Dialogue: 0,0:07:29.02,0:07:31.14,Main,Camie,0,0,0,,Sabaody Takımadaları'na gidiyoruz.
Dialogue: 0,0:07:31.60,0:07:34.32,Main,Usopp,0,0,0,,Oraya gitmeden önce \NBalık Adam Adası'na gidemez miyiz?
Dialogue: 0,0:07:34.46,0:07:38.30,Main,Hachi,0,0,0,,Balık adamlar ve deniz adamları,\Ngeri dönmek için dümdüz dalarlar.
Dialogue: 0,0:07:38.50,0:07:42.63,Main,Hachi,0,0,0,,İnsan olduğunuz için dalmaya\Nçalışsaydınız bile basınç sizi öldürürdü!
Dialogue: 0,0:07:43.60,0:07:44.66,Main,Franky,0,0,0,,Kesinlikle.
Dialogue: 0,0:07:44.82,0:07:46.82,Main,Franky,0,0,0,,Denizaltı da ulaşamadı.
Dialogue: 0,0:07:48.28,0:07:49.94,Main,Pappag,0,0,0,,Pekala, buraya bakın!
Dialogue: 0,0:07:50.20,0:07:52.38,Main,Pappag,0,0,0,,Hiçbir şey bilmiyor gibisiniz,...
Dialogue: 0,0:07:52.47,0:07:55.64,Main,Pappag,0,0,0,,...bu yüzden bu denizler hakkında\Nsize bir iki şey söyleyeceğim!
Dialogue: 0,0:07:55.85,0:07:56.30,Main,Pappag,0,0,0,,Ha?
Dialogue: 0,0:07:56.37,0:07:57.52,Main,Pappag,0,0,0,,Bunu kim yapacak?
Dialogue: 0,0:07:57.75,0:07:58.52,Main,Pappag,0,0,0,,O...
Dialogue: 0,0:07:58.61,0:07:59.10,Main,Pappag,0,0,0,,...ben...
Dialogue: 0,0:07:59.19,0:08:00.00,Main,Pappag,0,0,0,,...ola...
Dialogue: 0,0:08:00.22,0:08:02.10,Main,Pappag,0,0,0,,...cağım!
Dialogue: 0,0:08:05.41,0:08:08.08,Main,Pappag,0,0,0,,Şey, dinler misiniz lütfen?
Dialogue: 0,0:08:08.72,0:08:13.16,Main,Pappag,0,0,0,,Başlangıç olarak, aslında \NYeni Dünya'ya gitmek için iki yol var!
Dialogue: 0,0:08:13.66,0:08:17.70,Main,Pappag,0,0,0,,Ama sizin gibi kanun dışı kimseler\Niçin sadece biri kullanılabilir!
Dialogue: 0,0:08:18.03,0:08:18.96,Main,Luffy,0,0,0,,Niye?
Dialogue: 0,0:08:19.10,0:08:20.48,Main,Pappag,0,0,0,,Çünkü...
Dialogue: 0,0:08:20.78,0:08:23.29,Main,Pappag,0,0,0,,...yolun birinde Kızıl Hat'tın\Ntepesine tırmandıktan sonra...
Dialogue: 0,0:08:23.36,0:08:25.52,Main,Pappag,0,0,0,,...zirvedeki Kutsal Yer Mariejoa'dan\Ngeçebilmeniz için...
Dialogue: 0,0:08:25.70,0:08:29.78,Main,Pappag,0,0,0,,...Dünya Hükümeti'nden izin\Nalmanız gerekir.
Dialogue: 0,0:08:30.78,0:08:34.48,Main,Pappag,0,0,0,,Elbette bir korsanın bu şekilde\Ngeçmesine izin verilmesi mümkün değil.
Dialogue: 0,0:08:35.10,0:08:37.38,Main,Chopper,0,0,0,,Kızıl Hat'tın tepesinden geçmeyi mi kastediyorsun?
Dialogue: 0,0:08:37.60,0:08:39.46,Main,Chopper,0,0,0,,Peki gemiyi ne yapacağız?
Dialogue: 0,0:08:39.64,0:08:44.05,Main,Pappag,0,0,0,,Gemiyi geride bırakmak ve diğer tarafta\Nyenisini almak zorunda kalırdınız.
Dialogue: 0,0:08:45.76,0:08:47.31,Main,Franky,0,0,0,,Gemiyi geride bırakmak mı?!
Dialogue: 0,0:08:47.50,0:08:48.19,Main,Pappag,0,0,0,,Evet.
Dialogue: 0,0:08:48.38,0:08:53.54,Main,Pappag,0,0,0,,İzin almak için zaman ve para gerekir\Nama oraya varmanın en güvenli yoludur.
Dialogue: 0,0:08:54.24,0:08:55.22,Main,Pappag,0,0,0,,Ancak...
Dialogue: 0,0:08:55.27,0:08:55.77,Main,Franky,0,0,0,,Ha?
Dialogue: 0,0:08:56.02,0:08:59.01,Main,Pappag,0,0,0,,...sizin seçeceğiniz yol, geminiz ve her\Nşeyinizle birlikte geçmenize izin verecek!
Dialogue: 0,0:08:59.12,0:09:00.13,Main,Pappag,0,0,0,,O yol...
Dialogue: 0,0:09:00.24,0:09:05.06,Main,Pappag,0,0,0,,...Balık Adam Adası'ndan geçen\Nokyanus dibi yolu olarak bilinir!
Dialogue: 0,0:09:05.24,0:09:08.04,Main,Camie,0,0,0,,Ama okyanus dibi yolu da epey tehlikelidir.
Dialogue: 0,0:09:07.89,0:09:08.58,Secondary,Pappag,0,0,0,,Ha?
Dialogue: 0,0:09:08.67,0:09:10.04,Secondary,Pappag,0,0,0,,Camie, Camie?
Dialogue: 0,0:09:08.67,0:09:10.52,Main,Franky,0,0,0,,Ne demek istiyorsun?
Dialogue: 0,0:09:10.39,0:09:12.41,Secondary,Pappag,0,0,0,,Senin anlatabileceğini söylemedim.
Dialogue: 0,0:09:10.52,0:09:15.19,Main,Camie,0,0,0,,Deniz Kralları ve canavarları tarafından\Ngemileriyle birlikte yutulan çok insan var.
Dialogue: 0,0:09:12.90,0:09:14.00,Secondary,Pappag,0,0,0,,Hey!
Dialogue: 0,0:09:15.76,0:09:16.90,Main,Franky,0,0,0,,Anlıyorum.
Dialogue: 0,0:09:17.06,0:09:18.56,Main,Franky,0,0,0,,Bu epey tehlikeli olurdu.
Dialogue: 0,0:09:18.72,0:09:19.36,Main,Camie,0,0,0,,Değil mi?
Dialogue: 0,0:09:20.80,0:09:24.14,Main,Chopper,0,0,0,,Balık Adam Adası'na\Ngitmeyi hiç istemiyorum.
Dialogue: 0,0:09:25.08,0:09:26.00,Main,Usopp,0,0,0,,Ben de.
Dialogue: 0,0:09:26.50,0:09:27.94,Main,Nami,0,0,0,,Dur biraz, Caimie!
Dialogue: 0,0:09:28.30,0:09:30.04,Main,Nami,0,0,0,,"Gemileriyle birlikte" mi dedin?
Dialogue: 0,0:09:30.04,0:09:30.60,Main,Camie,0,0,0,,Ha?
Dialogue: 0,0:09:30.76,0:09:31.40,Main,Camie,0,0,0,,Evet!
Dialogue: 0,0:09:31.71,0:09:34.00,Main,Nami,0,0,0,,Okyanusun dibinde gidebilmek için\Nne tür bir gemi kullanmalıyız?
Dialogue: 0,0:09:34.26,0:09:35.38,Main,Camie,0,0,0,,Bu gemiyi.
Dialogue: 0,0:09:35.58,0:09:36.48,Main,Crew,0,0,0,,Ha?
Dialogue: 0,0:09:37.08,0:09:40.31,Main,Franky,0,0,0,,Hey, bu gemi su altında gidemez!
Dialogue: 0,0:09:40.44,0:09:42.10,Main,Camie,0,0,0,,Hayır, sorun olmayacak.
Dialogue: 0,0:09:42.21,0:09:42.76,Main,Franky,0,0,0,,Ha?
Dialogue: 0,0:09:43.00,0:09:47.60,Main,Camie,0,0,0,,Dünyayı çepeçevre saran koca\Nduvar, Kızıl Hat'tın içinde...
Dialogue: 0,0:09:47.81,0:09:50.30,Main,Camie,0,0,0,,...bir noktada küçük bir delik var.
Dialogue: 0,0:09:50.67,0:09:53.88,Main,Camie,0,0,0,,Gerçi bizim açımızdan büyük bir delik.
Dialogue: 0,0:09:54.30,0:09:56.12,Main,Camie,0,0,0,,Balıkadam Adası orada!
Dialogue: 0,0:09:57.40,0:10:00.58,Main,Hachi,0,0,0,,Aslında Kutsal Yer Mariejoa'nın\Ntam altında!
Dialogue: 0,0:10:00.80,0:10:03.68,Main,Hachi,0,0,0,,Sadece 10 bin metre aşağı\Ngidiyorsunuz ve işte orada!
Dialogue: 0,0:10:04.00,0:10:04.71,Main,Nami,0,0,0,,O kadar derin mi?
Dialogue: 0,0:10:04.78,0:10:06.12,Main,Hachi,0,0,0,,Gerçekten güzel bir yer!
Dialogue: 0,0:10:07.01,0:10:11.18,Main,Nami,0,0,0,,Gökyüzü Adası da yaklaşık \N10 bin metre yukarıda değil miydi?
Dialogue: 0,0:10:12.66,0:10:15.76,Main,Franky,0,0,0,,Bu gemiyi okyanusun dibine götüreceğimizi\Nsöylerken, ne demek istedin?
Dialogue: 0,0:10:16.04,0:10:18.74,Main,Camie,0,0,0,,Şu anda gittiğimiz adada\Ngemiyi kaplatacağız.
Dialogue: 0,0:10:19.28,0:10:20.62,Main,Franky,0,0,0,,Kaplatmak?
Dialogue: 0,0:10:20.80,0:10:22.24,Main,Pappag,0,0,0,,Varınca anlayacaksınız.
Dialogue: 0,0:10:22.90,0:10:24.73,Main,Pappag,0,0,0,,Arkadaşlar, geldik!
Dialogue: 0,0:10:28.80,0:10:29.80,Main,Nami,0,0,0,,Çok güzel!
Dialogue: 0,0:10:30.72,0:10:32.38,Main,Usopp,0,0,0,,O da ne?
Dialogue: 0,0:10:32.72,0:10:34.36,Main,Sanji,0,0,0,,Uçuşan bir şeyler var.
Dialogue: 0,0:10:36.26,0:10:37.87,Main,Brook,0,0,0,,Ne desem...
Dialogue: 0,0:10:38.68,0:10:40.04,Main,Robin,0,0,0,,Gerçek bir harika.
Dialogue: 0,0:10:42.94,0:10:43.78,Main,Zoro,0,0,0,,Kabarcıklar?
Dialogue: 0,0:10:46.20,0:10:47.08,Main,Pappag,0,0,2,,Burası...
Dialogue: 0,0:10:47.81,0:10:52.59,Captions,,0,0,240,,{\fad(1000,0)}Grand Line\NSabaody Takımadaları
Dialogue: 0,0:10:49.09,0:10:51.36,Main,Pappag,0,0,2,,Sabaody Takımadaları!
Dialogue: 0,0:11:00.24,0:11:02.20,Main,Luffy,0,0,0,,Etrafta uçuşan bir sürü\Nsabun kabarcığı var!
Dialogue: 0,0:11:03.14,0:11:04.08,Main,Nami,0,0,0,,Çok güzel!
Dialogue: 0,0:11:09.31,0:11:11.10,Main,Usopp,0,0,0,,Neler oluyor?
Dialogue: 0,0:11:11.26,0:11:12.90,Main,Usopp,0,0,0,,Birbiri ardına uçup duruyorlar.
Dialogue: 0,0:11:13.00,0:11:14.68,Main,Luffy,0,0,0,,Onları kim üflüyor?
Dialogue: 0,0:11:15.01,0:11:16.48,Main,Camie,0,0,0,,Adadan yükseliyorlar.
Dialogue: 0,0:11:16.96,0:11:18.94,Main,Usopp,0,0,0,,Sadece yükseliyor demek\Npek açıklayıcı olmuyor.
Dialogue: 0,0:11:20.02,0:11:20.84,Main,Luffy,0,0,0,,Neden?
Dialogue: 0,0:11:21.46,0:11:22.54,Main,Robin,0,0,0,,İzninizle.
Dialogue: 0,0:11:23.70,0:11:27.36,Main,Robin,0,0,0,,Böldüğüm için üzgünüm ama\NSeyir Belirleyici ne durumda?
Dialogue: 0,0:11:28.26,0:11:29.38,Main,Nami,0,0,0,,Ah, sahi...
Dialogue: 0,0:11:30.12,0:11:32.52,Main,Nami,0,0,0,,Hâlâ Balık Adam Adası'nı\Nişaret ediyor ama...
Dialogue: 0,0:11:33.70,0:11:36.60,Main,Nami,0,0,0,,...bu ada rotasının değişmesine\Nneden olmayacak mı?
Dialogue: 0,0:11:37.30,0:11:38.98,Main,Hachi,0,0,0,,Bunu dert etmenize gerek yok.
Dialogue: 0,0:11:39.13,0:11:41.50,Main,Hachi,0,0,0,,Sabaody Takımadaları sadece\Nağaç topluluğudur.
Dialogue: 0,0:11:41.64,0:11:43.34,Main,Sanji,0,0,0,,O zaman bunlar aslında ada değil mi?
Dialogue: 0,0:11:43.44,0:11:44.20,Main,Hachi,0,0,0,,Evet.
Dialogue: 0,0:11:44.31,0:11:46.32,Main,Hachi,0,0,0,,Mangrovlar'ı duydun mu hiç?
Dialogue: 0,0:11:47.48,0:11:51.06,Main,Sanji,0,0,0,,Kökleri okyanusta olan ve gelgitle birlikte su\Nyüzüne çıkıp batan ağaçları kastediyorsun, değil mi?
Dialogue: 0,0:11:51.63,0:11:52.82,Main,Hachi,0,0,0,,Evet, onlar.
Dialogue: 0,0:11:53.05,0:11:57.06,Main,Hachi,0,0,0,,Gerçi buradaki mangrovlar hiç batmaz.
Dialogue: 0,0:11:57.70,0:12:00.66,Main,Hachi,0,0,0,,Sabaody Takımadaları, dünyadaki\Nen geniş mangrovlardır.
Dialogue: 0,0:12:00.78,0:12:03.90,Main,Hachi,0,0,0,,Buradaki ağaçlara Yarukiman\NMangrovları derler.
Dialogue: 0,0:12:04.44,0:12:06.34,Note,*Translator's note,0,0,0,,{\fad(200,200)}"Yaru ki manman": Heyecanlanmak.
Dialogue: 0,0:12:04.44,0:12:06.28,Main,Luffy,0,0,0,,Heyecanlanan korular mı?
Dialogue: 0,0:12:07.31,0:12:08.88,Main,Luffy,0,0,0,,Evet, kesinlikle heyecanlanmış\Ngörünüyorlar!
Dialogue: 0,0:12:08.96,0:12:10.76,Main,Luffy,0,0,0,,Ben de heyecanlandım!
Dialogue: 0,0:12:11.07,0:12:16.02,Main,Hachi,0,0,0,,Toplam 79 ağaç var ve her\Nbiri küçük bir ada gibi.
Dialogue: 0,0:12:16.19,0:12:18.24,Main,Hachi,0,0,0,,Her birinde kasaba ve yapılar var.
Dialogue: 0,0:12:18.48,0:12:22.00,Main,Hachi,0,0,0,,Adaların hepsi birden \NSabaody Takımadaları olarak bilinir.
Dialogue: 0,0:12:23.18,0:12:28.92,Main,Hachi,0,0,0,,En yakını olan 44. koru, sivil giriş içindir.\NBu yüzden gemiyi biraz daha yaklaştıralım.
Dialogue: 0,0:12:30.36,0:12:33.30,Main,Luffy,0,0,0,,Yakından bakınca kökler daha\Nbüyük görünüyor, ha?
Dialogue: 0,0:12:35.57,0:12:36.92,Main,Brook,0,0,0,,O köprü mü?
Dialogue: 0,0:12:37.02,0:12:37.56,Main,Hachi,0,0,0,,Evet.
Dialogue: 0,0:12:37.68,0:12:40.56,Main,Hachi,0,0,0,,Adalar birbirine böyle bağlanır.
Dialogue: 0,0:12:41.30,0:12:42.72,Main,Hachi,0,0,0,,Tamam, geldik!
Dialogue: 0,0:12:42.96,0:12:44.72,Main,Hachi,0,0,0,,Burası 41. koru.
Dialogue: 0,0:12:44.84,0:12:46.34,Main,Hachi,0,0,0,,Buraya demir atıyoruz.
Dialogue: 0,0:12:50.05,0:12:51.42,Main,Luffy,0,0,0,,Önce ben ayak basıyorum!
Dialogue: 0,0:12:56.49,0:12:59.51,Main,Hachi,0,0,0,,Tamam, buradaki sayıyı unutmayın!
Dialogue: 0,0:12:59.86,0:13:00.86,Main,Hachi,0,0,0,,Demin de dediğim gibi...
Dialogue: 0,0:13:00.98,0:13:03.88,Main,Hachi,0,0,0,,...adaların hepsi köprüler\Nvasıtasıyla birbirine bağlanır.
Dialogue: 0,0:13:04.02,0:13:06.30,Main,Hachi,0,0,0,,Bu yüzden sayıyı unutmazsanız\Nkaybolmazsınız.
Dialogue: 0,0:13:06.42,0:13:08.28,Main,Usopp,0,0,0,,Yine de kaybolacak biri var, değil mi?
Dialogue: 0,0:13:08.52,0:13:09.26,Main,Chopper,0,0,0,,Var.
Dialogue: 0,0:13:09.82,0:13:11.28,Main,Zoro,0,0,0,,Ha, ne?
Dialogue: 0,0:13:13.15,0:13:14.24,Main,Zoro,0,0,0,,Ne oldu?!
Dialogue: 0,0:13:20.94,0:13:22.90,Main,Luffy,0,0,0,,Yerden bir tane çıktı!
Dialogue: 0,0:13:23.04,0:13:25.05,Main,Luffy,0,0,0,,Gerçekten ilginç!
Dialogue: 0,0:13:25.96,0:13:27.28,Main,Chopper and Usopp,0,0,0,,Müthiş!
Dialogue: 0,0:13:31.42,0:13:32.42,Main,Luffy,0,0,0,,Üstüne çıktım!
Dialogue: 0,0:13:32.61,0:13:34.18,Main,Usopp,0,0,0,,Patlamıyor, ha?
Dialogue: 0,0:13:34.35,0:13:35.54,Main,Chopper,0,0,0,,Çok hoş!
Dialogue: 0,0:13:39.08,0:13:41.06,Main,Robin,0,0,0,,Sabun kabarcıkları gerçekten gizemli.
Dialogue: 0,0:13:41.50,0:13:43.24,Main,Robin,0,0,0,,Bunların mantığı nedir?
Dialogue: 0,0:13:43.64,0:13:49.54,Main,Pappag,0,0,0,,Bu Yarukiman Mangrovlar'ın kökleri\Nözel bir reçine türü salgılar.
Dialogue: 0,0:13:53.41,0:13:53.98,Main,Robin,0,0,0,,Olamaz!
Dialogue: 0,0:13:54.12,0:13:55.18,Main,Robin,0,0,0,,Yapış yapış oldu.
Dialogue: 0,0:13:56.40,0:13:57.94,Main,Usopp,0,0,0,,Üstüme silme!
Dialogue: 0,0:13:58.82,0:14:03.30,Main,Pappag,0,0,0,,Yani ağaç "nefes verdiğinde" bu reçineye hava\Ndolup şişer ve sabun kabarcıklarını oluşturur.
Dialogue: 0,0:14:03.55,0:14:04.62,Main,Chopper,0,0,0,,Anlıyorum.
Dialogue: 0,0:14:05.04,0:14:07.26,Main,Chopper,0,0,0,,Yani bu yüzden mi hepsi gökyüzüne uçuyor?
Dialogue: 0,0:14:07.60,0:14:10.90,Main,Usopp,0,0,0,,Demek tüm bunlar aslında doğal?
Dialogue: 0,0:14:11.02,0:14:11.94,Main,Luffy,0,0,0,,Hey!
Dialogue: 0,0:14:12.06,0:14:12.42,Main,Usopp,0,0,0,,Ha?
Dialogue: 0,0:14:12.52,0:14:13.24,Main,Usopp,0,0,0,,Hey, Luffy!
Dialogue: 0,0:14:13.32,0:14:14.72,Main,Usopp,0,0,0,,Oraya ne zaman çıktın?!
Dialogue: 0,0:14:14.86,0:14:16.70,Main,Luffy,0,0,0,,Orada bir lunapark görüyorum!
Dialogue: 0,0:14:16.78,0:14:17.32,Main,Luffy,0,0,0,,Gidelim!
Dialogue: 0,0:14:17.40,0:14:18.62,Main,Luffy,0,0,0,,Dönme dolaba binelim!
Dialogue: 0,0:14:18.73,0:14:20.00,Main,Chopper,0,0,0,,Lunapark mı?
Dialogue: 0,0:14:20.56,0:14:22.04,Main,Camie,0,0,0,,Sabaody Parkı.
Dialogue: 0,0:14:22.76,0:14:23.52,Main,Camie,0,0,0,,Ne güzel.
Dialogue: 0,0:14:23.60,0:14:24.56,Main,Camie,0,0,0,,Dönme dolap.
Dialogue: 0,0:14:24.73,0:14:27.26,Main,Camie,0,0,0,,Ona binmek benim hayalim.
Dialogue: 0,0:14:27.73,0:14:28.44,Main,Chopper,0,0,0,,Hayalin?
Dialogue: 0,0:14:28.58,0:14:29.60,Main,Chopper,0,0,0,,Niye binemiyorsun?
Dialogue: 0,0:14:29.70,0:14:30.56,Main,Pappag,0,0,0,,Saçmalama!
Dialogue: 0,0:14:30.71,0:14:31.82,Main,Pappag,0,0,0,,Bunu yapamazsın, Caimie!
Dialogue: 0,0:14:32.00,0:14:34.51,Main,Camie,0,0,0,,Evet, biliyorum.
Dialogue: 0,0:14:38.65,0:14:41.46,Main,Chopper,0,0,0,,Ben de binmek istiyorum ama\Nsanırım yapamam.
Dialogue: 0,0:14:49.28,0:14:50.24,Main,Nami,0,0,0,,Sahi, Hachi...
Dialogue: 0,0:14:50.50,0:14:52.34,Main,Nami,0,0,0,,Bu adadaki amacımız ne?
Dialogue: 0,0:14:52.68,0:14:55.46,Main,Nami,0,0,0,,Demin gemiyi kaplamakla\Nilgili bir şey demiştin, değil mi?
Dialogue: 0,0:14:56.32,0:15:01.08,Main,Hachi,0,0,0,,Bir kaplama ustası bulmalıyız ve\Ngeminizi bu reçineyle kaplatmalıyız!
Dialogue: 0,0:15:01.94,0:15:06.44,Main,Hachi,0,0,0,,Kısacası bu, geminizin su altında\Ngitmesini mümkün kılacak!
Dialogue: 0,0:15:06.85,0:15:07.86,Main,Franky,0,0,0,,Cidden mi?
Dialogue: 0,0:15:08.64,0:15:13.52,Main,Hachi,0,0,0,,İnsanların Balık Adam Adası'na\Nulaşabilmesinin tek yolu bu.
Dialogue: 0,0:15:13.88,0:15:16.10,Main,Hachi,0,0,0,,Ancak bu iş için amatör\Nbirini tutarsanız...
Dialogue: 0,0:15:16.20,0:15:19.80,Main,Hachi,0,0,0,,...gemi ve içindeki insanlar\Nsu basıncıyla ezilir.
Dialogue: 0,0:15:20.30,0:15:24.48,Main,Hachi,0,0,0,,Güvenilir bir usta tanıyorum,\Nbu yüzden sizi ona götüreceğim.
Dialogue: 0,0:15:25.16,0:15:28.26,Main,Brook,0,0,0,,Ahtapot-san, bize çok yardımı\Ndokunan iyi bir arkadaşsın.
Dialogue: 0,0:15:28.86,0:15:30.36,Main,Brook,0,0,0,,Ah, o iyi bir ahtapot!
Dialogue: 0,0:15:32.86,0:15:33.98,Main,Hachi,0,0,0,,Buna karşılık...
Dialogue: 0,0:15:34.39,0:15:36.92,Main,Hachi,0,0,0,,...bana tek bir söz vermenizi istiyorum.
Dialogue: 0,0:15:37.30,0:15:38.74,Main,Luffy,0,0,0,,Tabii, nedir?
Dialogue: 0,0:15:39.76,0:15:43.52,Main,Hachi,0,0,0,,Şehre girince etrafta dolaşan\NDünya Soyluları'na rastlayabiliriz.
Dialogue: 0,0:15:44.08,0:15:45.02,Main,Luffy,0,0,0,,Onlar da kim?
Dialogue: 0,0:15:45.25,0:15:47.60,Main,Robin,0,0,0,,Kutsal Yer Mariejoa'nın vatandaşları.
Dialogue: 0,0:15:49.62,0:15:51.22,Main,Luffy,0,0,0,,Peki ne olmuş onlara?
Dialogue: 0,0:15:51.42,0:15:54.94,Main,Hachi,0,0,0,,Şehirde ne olursa olsun...
Dialogue: 0,0:15:55.24,0:15:58.43,Main,Hachi,0,0,0,,...Dünya Soyluları'na el sürmeyeceğinize\Nsöz vermenizi istiyorum!
Dialogue: 0,0:16:01.38,0:16:03.60,Main,Hachi,0,0,0,,Gözünüzün önünde...
Dialogue: 0,0:16:04.12,0:16:05.94,Main,Hachi,0,0,0,,...biri öldürülse bile...
Dialogue: 0,0:16:06.62,0:16:08.78,Main,Hachi,0,0,0,,...bir şey görmemiş gibi davranın!
Dialogue: 0,0:16:12.02,0:16:13.68,Main,Sanji,0,0,0,,Herkes şehre gitti.
Dialogue: 0,0:16:14.32,0:16:15.84,Main,Sanji,0,0,0,,Siz gitmiyor musunuz?
Dialogue: 0,0:16:15.96,0:16:19.48,Main,Franky,0,0,0,,Son savaşta bütün kolamızı kullandık.
Dialogue: 0,0:16:21.02,0:16:23.00,Main,Franky,0,0,0,,Gemiyle ilgilenmek benim işim!
Dialogue: 0,0:16:23.14,0:16:26.14,Main,Usopp,0,0,0,,Tabii ki ben de yardım etmek istiyorum!
Dialogue: 0,0:16:26.50,0:16:28.30,Main,Usopp,0,0,0,,İşimiz bitince üçümüz birden gidelim.
Dialogue: 0,0:16:28.56,0:16:30.06,Main,Usopp,0,0,0,,Ada eğlenceli görünüyor!
Dialogue: 0,0:16:30.18,0:16:30.78,Main,Sanji,0,0,0,,Hayır.
Dialogue: 0,0:16:31.14,0:16:34.54,Main,Sanji,0,0,0,,Biri dönmeden gemiyi terk edemem.
Dialogue: 0,0:16:34.86,0:16:36.00,Main,Usopp,0,0,0,,Ha, niye?
Dialogue: 0,0:16:36.22,0:16:37.60,Main,Sanji,0,0,0,,Çünkü...
Dialogue: 0,0:16:41.10,0:16:43.20,Main,Sanji,0,0,0,,...sevgili Nami-san'ım dedi ki:...
Dialogue: 0,0:16:43.52,0:16:45.84,Flashbacks,Nami,0,0,0,,Hmm, bu bir sorun...
Dialogue: 0,0:16:46.14,0:16:49.34,Flashbacks,Nami,0,0,0,,Şu anda gemimizde bir sürü hazine var.
Dialogue: 0,0:16:49.64,0:16:52.94,Flashbacks,Nami,0,0,0,,Buralarda onu koruyacak bir şövalye yok mu?
Dialogue: 0,0:16:52.68,0:16:53.24,Flashbacks,Sanji,0,0,0,,İşte!
Dialogue: 0,0:16:53.60,0:16:54.88,Main,Sanji,0,0,0,,O benim!
Dialogue: 0,0:16:56.14,0:16:58.24,Main,Usopp,0,0,0,,Gerçekten Nami'nin istediği\Nher şeyi yapıyorsun, ha?
Dialogue: 0,0:16:58.42,0:17:00.16,Main,Sanji,0,0,0,,Ben aşk kölesiyim!
Dialogue: 0,0:17:00.30,0:17:02.32,Main,Usopp,0,0,0,,Kendin kabul ediyorsan bir anlamı yok.
Dialogue: 0,0:17:04.72,0:17:05.42,Main,Usopp,0,0,0,,Ha?
Dialogue: 0,0:17:05.93,0:17:06.64,Main,Usopp,0,0,0,,Hey!
Dialogue: 0,0:17:06.78,0:17:07.66,Main,Usopp,0,0,0,,Zoro!
Dialogue: 0,0:17:07.83,0:17:08.78,Main,Sanji,0,0,0,,Merhaba?!
Dialogue: 0,0:17:08.88,0:17:10.16,Main,Sanji,0,0,0,,Zoro-kun?!
Dialogue: 0,0:17:10.30,0:17:13.28,Main,Usopp and Sanji,0,0,0,,Kendi başına nereye gidiyorsun?
Dialogue: 0,0:17:14.71,0:17:15.80,Main,Zoro,0,0,0,,Yürüyüşe.
Dialogue: 0,0:17:16.50,0:17:16.90,Main,Zoro,0,0,0,,Ne olmuş?
Dialogue: 0,0:17:17.01,0:17:18.40,Main,Usopp,0,0,0,,Kes şunu!
Dialogue: 0,0:17:18.46,0:17:20.44,Main,Sanji,0,0,0,,Gitme, kaybolacaksın, lanet olsun!
Dialogue: 0,0:17:20.58,0:17:21.94,Main,Sanji,0,0,0,,Burası bir takımada!
Dialogue: 0,0:17:21.94,0:17:23.30,Main,Sanji,0,0,0,,Seni bulamayacağız!
Dialogue: 0,0:17:23.46,0:17:25.28,Main,Zoro,0,0,0,,Hiç de kaybolmam!
Dialogue: 0,0:17:25.58,0:17:28.44,Main,Zoro,0,0,0,,Yolunu bulmanın bu kadar kolay\Nolduğu bir adada kim kaybolur?
Dialogue: 0,0:17:28.56,0:17:30.92,Main,Zoro,0,0,0,,Her ağacın üstünde sayı var, değil mi?
Dialogue: 0,0:17:31.02,0:17:33.59,Main,Zoro,0,0,0,,Yön duygusu berbat bir\Nçocuk bile yolunu bulabilirdi!
Dialogue: 0,0:17:35.86,0:17:38.14,Main,Usopp,0,0,0,,Bu kadar ilerisini düşündün mü?
Dialogue: 0,0:17:38.30,0:17:39.46,Main,Sanji,0,0,0,,Bunu düşünmedim.
Dialogue: 0,0:17:39.64,0:17:40.18,Main,Sanji,0,0,0,,Üzgünüm!
Dialogue: 0,0:17:40.26,0:17:41.32,Main,Sanji,0,0,0,,Dikkatli ol!
Dialogue: 0,0:17:41.74,0:17:44.48,Main,Usopp,0,0,0,,Yön sormayı unutma!
Dialogue: 0,0:17:44.78,0:17:46.74,Main,Sanji,0,0,0,,Kendine güvenme!
Dialogue: 0,0:17:48.38,0:17:50.20,Main,Zoro,0,0,0,,Abartıyorlar.
Dialogue: 0,0:17:51.14,0:17:53.54,Main,Zoro,0,0,0,,Bu ağaçtaki sayıyı unutmadığım sürece...
Dialogue: 0,0:17:57.42,0:17:59.50,Main,Zoro,0,0,0,,Bir numara, değil mi?
Dialogue: 0,0:18:07.44,0:18:11.10,Main,Hachi,0,0,0,,Dünya Soyluları, Kutsal Ejderler\Nolarak da bilinir.
Dialogue: 0,0:18:11.32,0:18:16.26,Main,Hachi,0,0,0,,Çok küstahtırlar ve herkesle aynı\Nhavayı solumamak için maske takarlar.
Dialogue: 0,0:18:16.43,0:18:19.06,Main,Hachi,0,0,0,,Ne olursa olsun, onlara karşı\Nçıkmaya çalışmayın.
Dialogue: 0,0:18:19.22,0:18:21.38,Main,Hachi,0,0,0,,Bunun için söz vermelisiniz!
Dialogue: 0,0:18:21.50,0:18:22.06,Main,Luffy,0,0,0,,Tabii!
Dialogue: 0,0:18:22.80,0:18:25.94,Main,Hachi,0,0,0,,Dikkat etmeniz gereken birkaç şey daha var.
Dialogue: 0,0:18:26.40,0:18:32.16,Main,Hachi,0,0,0,,Demin de dediğim gibi, bu ada, Yeni Dünya'ya\Ngitmek isteyen herkesin toplandığı yerdir.
Dialogue: 0,0:18:32.94,0:18:36.32,Main,Hachi,0,0,0,,Sizin gibi bir sürü namlı korsan ve...
Dialogue: 0,0:18:36.42,0:18:39.40,Main,Hachi,0,0,0,,...onları yakalamaya çalışan\Nödül avcıları ile denizciler var.
Dialogue: 0,0:18:39.60,0:18:40.64,Main,Hachi,0,0,0,,Ayrıca...
Dialogue: 0,0:18:40.78,0:18:42.00,Main,Hachi,0,0,0,,Adam kaçıranlar!
Dialogue: 0,0:18:42.52,0:18:46.24,Main,Hachi,0,0,0,,Korsanlar köle tacirleri tarafından\Ngötürülse bile kanun onları korumaz.
Dialogue: 0,0:18:46.64,0:18:52.38,Main,Hachi,0,0,0,,Kendinizi fark ettirecek bir şey yaparsanız\Nhemen peşinizden gelirler. Dikkatli olun!
Dialogue: 0,0:18:52.50,0:18:55.02,Main,Hachi,0,0,0,,Buralardaki denizciler hafife alınmamalı.
Dialogue: 0,0:18:55.22,0:18:58.96,Main,Hachi,0,0,0,,Sonuçta bu sular Denizci Karargâhı'na yakın.
Dialogue: 0,0:18:59.14,0:19:03.20,Main,Hachi,0,0,0,,Buralardaki tüm ödül avcıları\Nda farklı seviyede!
Dialogue: 0,0:19:04.14,0:19:05.56,Main,Hachi,0,0,0,,Bir şey daha var.
Dialogue: 0,0:19:05.75,0:19:06.96,Main,Luffy,0,0,0,,Hadi ama!
Dialogue: 0,0:19:07.08,0:19:08.52,Main,Luffy,0,0,0,,Her şeyi kendine çok dert ediyorsun!
Dialogue: 0,0:19:08.62,0:19:11.58,Main,Hachi,0,0,0,,Caimie ve ben, deniz kızı ve\Nbalık adam değiliz, tamam mı?
Dialogue: 0,0:19:11.74,0:19:14.64,Main,Hachi,0,0,0,,Burada olduğumuz sürece lütfen\Nsıradan insanlarmışız gibi davranın.
Dialogue: 0,0:19:14.76,0:19:15.60,Main,Luffy,0,0,0,,Neden?
Dialogue: 0,0:19:15.72,0:19:17.46,Main,Hachi,0,0,0,,Sadece böylesi daha kolay.
Dialogue: 0,0:19:17.64,0:19:20.26,Main,Robin,0,0,0,,Buradaki kültürün âdetlerine\Nuymalıyız, Luffy.
Dialogue: 0,0:19:20.50,0:19:22.40,Main,Robin,0,0,0,,Ahtapot-san'ın bize söylediği gibi yapalım.
Dialogue: 0,0:19:28.37,0:19:29.64,Main,Person,0,0,0,,Başlıyoruz.
Dialogue: 0,0:19:29.76,0:19:31.32,Main,Person,0,0,0,,Yavaş yavaş...
Dialogue: 0,0:19:37.34,0:19:38.50,Main,Luffy,0,0,0,,Girdim!
Dialogue: 0,0:19:40.21,0:19:41.56,Main,Brook and Chopper,0,0,0,,Ne eğlenceli!
Dialogue: 0,0:19:41.68,0:19:42.76,Main,Robin,0,0,0,,Gerçekten gizemli.
Dialogue: 0,0:19:43.08,0:19:44.24,Main,Luffy,0,0,0,,Giriyorum!
Dialogue: 0,0:19:44.38,0:19:46.14,Main,Luffy,0,0,0,,Dışarı hiç hava da çıkmıyor!
Dialogue: 0,0:19:46.54,0:19:47.86,Main,Person,0,0,0,,Şimdi...
Dialogue: 0,0:19:50.42,0:19:51.98,Main,Person,0,0,0,,Bunu takmaya ne dersiniz?
Dialogue: 0,0:19:55.13,0:19:55.94,Main,Luffy,0,0,0,,Böyle mi?
Dialogue: 0,0:19:56.16,0:19:57.88,Main,Person,0,0,0,,Yüksekliği yeterli mi?
Dialogue: 0,0:19:58.17,0:19:59.68,Main,Person,0,0,0,,Artık bununla etrafta dolaşabilirsin.
Dialogue: 0,0:20:05.27,0:20:06.28,Main,Luffy,0,0,0,,Hareket ediyorum!
Dialogue: 0,0:20:07.54,0:20:08.62,Main,Chopper,0,0,0,,Müthiş!
Dialogue: 0,0:20:11.48,0:20:13.10,Main,Luffy,0,0,0,,Eğlenceli!
Dialogue: 0,0:20:15.30,0:20:17.12,Main,Brook,0,0,0,,Patlamıyor!
Dialogue: 0,0:20:19.52,0:20:22.92,Main,Person,0,0,0,,Sabaody Takımadaları'nın özel\NKabarcık Bisikleti çok rahat, değil mi?
Dialogue: 0,0:20:23.19,0:20:24.13,Main,Person,0,0,0,,Ne dersiniz?
Dialogue: 0,0:20:24.32,0:20:27.04,Main,Person,0,0,0,,Kiralamak istiyorsanız kişi başına 500 beli.
Dialogue: 0,0:20:27.22,0:20:29.24,Main,Person,0,0,0,,Satın almak istiyorsanız, 10000 beli!
Dialogue: 0,0:20:29.40,0:20:30.40,Main,Person,0,0,0,,Ucuz, değil mi?
Dialogue: 0,0:20:30.60,0:20:31.58,Main,Hachi,0,0,0,,O zaman bir tane kiralayacağız.
Dialogue: 0,0:20:31.70,0:20:32.48,Main,Luffy,0,0,0,,Bir tane istiyorum!
Dialogue: 0,0:20:32.60,0:20:34.52,Main,Luffy,0,0,0,,Harçlığımla bir tane satın alacağım!
Dialogue: 0,0:20:34.64,0:20:35.90,Main,Chopper,0,0,0,,Ben de, ben de!
Dialogue: 0,0:20:36.44,0:20:37.60,Main,Hachi,0,0,0,,Almayın.
Dialogue: 0,0:20:37.74,0:20:39.50,Main,Hachi,0,0,0,,Almanın manası yok, sadece kiralayın.
Dialogue: 0,0:20:39.71,0:20:41.26,Main,Luffy,0,0,0,,Buna niye sen karar veriyorsun?
Dialogue: 0,0:20:41.41,0:20:42.10,Main,Chopper,0,0,0,,Evet!
Dialogue: 0,0:20:42.26,0:20:45.40,Main,Hachi,0,0,0,,Ah, sebebini sonra söyleyeceğim.
Dialogue: 0,0:20:45.52,0:20:46.00,Main,Hachi,0,0,0,,Yaşlı adam!
Dialogue: 0,0:20:46.10,0:20:47.44,Main,Hachi,0,0,0,,İki tane daha kiralayacağız.
Dialogue: 0,0:20:47.60,0:20:50.92,Main,Person,0,0,0,,Ah, sen buralı mısın? Çok yazık.
Dialogue: 0,0:20:56.32,0:20:58.76,Main,Nami,0,0,0,,Bu harika bir his!
Dialogue: 0,0:20:58.90,0:21:00.96,Main,Luffy,0,0,0,,Bu kabarcık bisikletlerden\Nbirini mutlaka alacağım!
Dialogue: 0,0:21:01.08,0:21:01.88,Main,Hachi,0,0,0,,Hasır Şapka,...
Dialogue: 0,0:21:02.00,0:21:05.96,Main,Hachi,0,0,0,,...buraya ilk geldiğimizde sabun\Nkabarcıklarıyla gökyüzüne çıktın, değil mi?
Dialogue: 0,0:21:06.20,0:21:07.46,Main,Hachi,0,0,0,,Niye düştün?
Dialogue: 0,0:21:07.56,0:21:13.44,Main,Luffy,0,0,0,,Ah, evet. Ağaçların tepesine ulaşınca\Ndaha yukarı gideceğimi sanmıştım...
Dialogue: 0,0:21:14.22,0:21:16.78,Main,Luffy,0,0,0,,...ama sonra etrafımdaki bütün sabun\Nkabarcıkları aniden patlamaya başladı...
Dialogue: 0,0:21:16.92,0:21:19.78,Main,Luffy,0,0,0,,...ve en son üstüne bindiğim de patladı.
Dialogue: 0,0:21:21.36,0:21:22.78,Main,Luffy,0,0,0,,Bu yüzden düştüm.
Dialogue: 0,0:21:22.94,0:21:26.62,Main,Hachi,0,0,0,,Sabaody Takımadası'nın özel\Natmosferinden çıktığın için.
Dialogue: 0,0:21:26.99,0:21:31.14,Main,Hachi,0,0,0,,Buranın, özellikle Yarukiman Mangrovları'na\Nuygun, özel ve eşsiz bir iklimi vardır.
Dialogue: 0,0:21:31.28,0:21:36.88,Main,Hachi,0,0,0,,Ama bu iklimden ayrılınca sabun kabarcıkları\Nbütün kalamayacak kadar zayıflayacak.
Dialogue: 0,0:21:37.72,0:21:38.68,Main,Robin,0,0,0,,Öyle mi?
Dialogue: 0,0:21:38.92,0:21:41.68,Main,Robin,0,0,0,,O zaman bu adada kaldığın\Nsürece sabun kabarcıklarına...
Dialogue: 0,0:21:41.78,0:21:43.58,Main,Robin,0,0,0,,...binebileceksin demektir, değil mi?
Dialogue: 0,0:21:44.40,0:21:45.58,Main,Hachi,0,0,0,,Aynen öyle.
Dialogue: 0,0:21:45.74,0:21:49.38,Main,Hachi,0,0,0,,Buraya ilk kez gelenler, genelde\Nkabarcık bisikletini satın alır.
Dialogue: 0,0:21:49.71,0:21:51.74,Main,Hachi,0,0,0,,Ama bu tam bir dolandırıcılıktır.
Dialogue: 0,0:21:51.95,0:21:53.70,Main,Hachi,0,0,0,,Kiralamak yeterli.
Dialogue: 0,0:21:53.80,0:21:56.02,Main,Luffy,0,0,0,,Hayır, sanırım ben satın alacağım!
Dialogue: 0,0:21:56.39,0:21:59.14,Main,Luffy,0,0,0,,Bu açıklamayı hiç kabul etmiyorum.
Dialogue: 0,0:21:59.26,0:22:01.20,Main,Nami,0,0,0,,Anlamıyorsun, değil mi?
Dialogue: 0,0:22:01.36,0:22:04.42,Main,Nami,0,0,0,,Kısacası bu adadan ayrılınca\Nsabun kabarcığı patlayacak.
Dialogue: 0,0:22:04.84,0:22:06.10,Main,Nami,0,0,0,,Gizemli, değil mi?
Dialogue: 0,0:22:06.28,0:22:07.36,Main,Luffy,0,0,0,,Ne?!
Dialogue: 0,0:22:07.54,0:22:08.75,Main,Luffy,0,0,0,,Gizemli bir biçimde patlıyorlar mı?
Dialogue: 0,0:22:08.86,0:22:10.14,Main,Luffy,0,0,0,,Niye daha önce demedin?!
Dialogue: 0,0:22:10.30,0:22:13.48,Main,Camie,0,0,0,,Ama Luffy-chin, onları \NBalık Adam Adası'nda kullanabilirsin.
Dialogue: 0,0:22:13.96,0:22:16.24,Main,Camie,0,0,0,,Okyanus tabanında da sabun kabarcıkları var.
Dialogue: 0,0:22:16.46,0:22:18.72,Main,Luffy,0,0,0,,Balık Adam Adası'na hemen gitmek istiyorum.
Dialogue: 0,0:22:18.82,0:22:20.58,Main,Luffy,0,0,0,,Sabırsızlanıyorum.
Dialogue: 0,0:22:20.91,0:22:23.30,Main,Pappag,0,0,0,,O zaman deniz kızı \Nprensesiyle de tanışmalısınız!
Dialogue: 0,0:22:23.48,0:22:25.45,Main,Pappag,0,0,0,,O kadar güzel ki tarif bile edemiyorum!
Dialogue: 0,0:22:25.74,0:22:28.04,Main,Pappag,0,0,0,,Ondan gözlerimi alamıyorum!
Dialogue: 0,0:22:29.14,0:22:30.74,Main,Brook,0,0,0,,Ben de dört gözle bekliyorum.
Dialogue: 0,0:22:30.92,0:22:33.28,Main,Brook,0,0,0,,Gözlerim güzelden anlar.
Dialogue: 0,0:22:33.46,0:22:36.04,Main,Brook,0,0,0,,Gerçi iskelet olduğum için gözlerim yok.
Dialogue: 0,0:22:38.45,0:22:39.52,Main,Brook,0,0,0,,Eh, dinliyor musunuz?
Dialogue: 0,0:22:39.58,0:22:40.90,Main,Luffy,0,0,0,,Vay, leziz görünüyor!
Dialogue: 0,0:22:41.02,0:22:42.64,Main,Chopper,0,0,0,,Graman nedir?
Dialogue: 0,0:22:42.94,0:22:44.67,Note,,0,0,0,,{\fad(150,150)}Manjuu: Buharda pişmiş çörek
Dialogue: 0,0:22:42.94,0:22:44.67,Main,Person,0,0,0,,Grand Line'ın Manjuuları!
Dialogue: 0,0:22:44.84,0:22:46.02,Main,Person,0,0,0,,Ya da kısaca Graman.
Dialogue: 0,0:22:46.17,0:22:47.54,Main,Person,0,0,0,,Denemek ister misiniz?
Dialogue: 0,0:22:51.07,0:22:55.08,Main,Person,0,0,0,,Üzerinde "Grand Line'ın İlk Yarısı"\Nyazıldığını görebiliyorsunuz, değil mi?
Dialogue: 0,0:22:55.20,0:22:57.82,Main,Person,0,0,0,,Buradaki fikir, onları bir tür hatıra\Nolarak Yeni Dünya'ya götürmek.
Dialogue: 0,0:22:57.91,0:23:00.72,Main,Person,0,0,0,,Üç ay dayanırlar, bu yüzden dert etmeyin!
Dialogue: 0,0:23:00.82,0:23:02.52,Main,Brook,0,0,0,,Tadı harika!
Dialogue: 0,0:23:04.75,0:23:07.12,Main,Brook,0,0,0,,Bir paket daha açabilir miyim?
Dialogue: 0,0:23:07.20,0:23:08.46,Main,Person,0,0,0,,Hiç satın almayacak mısınız?!
Dialogue: 0,0:23:13.34,0:23:14.92,Main,Robin,0,0,0,,35. Koru
Dialogue: 0,0:23:15.24,0:23:17.22,Main,Robin,0,0,0,,Burada bir sürü otel var, değil mi?
Dialogue: 0,0:23:18.18,0:23:21.56,Main,Hachi,0,0,0,,Geçmek için Mariejoa'dan izin\Nbekleyenlerin yaşadığı mekanlar.
Dialogue: 0,0:23:21.66,0:23:24.06,Main,Pappag,0,0,0,,Bu otelleri yapmak gerçekten çok kolay.
Dialogue: 0,0:23:24.41,0:23:25.74,Main,Pappag,0,0,0,,Şuradakini gördünüz mü?
Dialogue: 0,0:23:26.22,0:23:29.52,Main,Pappag,0,0,0,,Sadece büyük sabun kabarcıklarını özel bir\Nalaşımla kaplıyorlar ve kurulum tamam.
Dialogue: 0,0:23:29.78,0:23:32.16,Main,Pappag,0,0,0,,O yuvarlak binaları böyle yapıyorlar.
Dialogue: 0,0:23:32.35,0:23:33.48,Main,Robin,0,0,0,,Öyle mi?
Dialogue: 0,0:23:33.81,0:23:34.68,Main,Nami,0,0,0,,Robin!
Dialogue: 0,0:23:34.92,0:23:37.62,Main,Nami,0,0,0,,Orası alışveriş merkezi değil mi?!
Dialogue: 0,0:23:37.82,0:23:39.30,Main,Person,0,0,0,,Yine gelin!
Dialogue: 0,0:23:40.39,0:23:41.42,Main,Luffy,0,0,0,,Grasen...
Dialogue: 0,0:23:41.62,0:23:42.70,Main,Luffy,0,0,0,,Grachoco...
Dialogue: 0,0:23:42.82,0:23:43.94,Main,Chopper,0,0,0,,Anahtarlık!
Dialogue: 0,0:23:44.04,0:23:44.84,Main,Brook,0,0,0,,Flama!
Dialogue: 0,0:23:44.96,0:23:46.79,Main,Pappag,0,0,0,,O anıları saklayın!
Dialogue: 0,0:23:46.92,0:23:48.22,Main,Camie,0,0,0,,Bir sürü almışsınız, ha?
Dialogue: 0,0:23:48.36,0:23:50.74,Main,Hachi,0,0,0,,Onu her yere taşımak sorun olur.
Dialogue: 0,0:23:50.98,0:23:52.60,Main,Hachi,0,0,0,,Kabarcık çantaya koyun.
Dialogue: 0,0:23:52.74,0:23:53.94,Main,Luffy,0,0,0,,Kabarcık çanta?
Dialogue: 0,0:23:56.30,0:23:57.66,Main,Luffy,0,0,0,,Çok hafif!
Dialogue: 0,0:23:57.80,0:24:00.54,Main,Luffy,0,0,0,,Bu adada bagajlarını taşımak için\Nçaba sarf etmene gerek yok, ha?
Dialogue: 0,0:24:02.80,0:24:03.52,Main,Chopper,0,0,0,,Ha?
Dialogue: 0,0:24:04.12,0:24:05.28,Main,Chopper,0,0,0,,Nami ve Robin nereye gitti?
Dialogue: 0,0:24:05.44,0:24:08.24,Main,Camie,0,0,0,,30. Koru'daki alışveriş merkezine gittiler.
Dialogue: 0,0:24:08.55,0:24:10.64,Main,Camie,0,0,0,,Gemiyi kaplama işini bize\Nbırakacaklarını söylediler.
Dialogue: 0,0:24:10.89,0:24:11.98,Main,Luffy,0,0,0,,Ah, öyle mi?
Dialogue: 0,0:24:12.28,0:24:12.96,Main,Luffy,0,0,0,,Tamam!
Dialogue: 0,0:24:13.14,0:24:14.22,Main,Luffy,0,0,0,,Bize bırakın!
Dialogue: 0,0:24:20.58,0:24:23.70,Main,Robin,0,0,0,,Davet etmiş olsaydık bile\NCaimie-chan bizimle gelmezdi.
Dialogue: 0,0:24:24.99,0:24:27.82,Main,Nami,0,0,0,,Bu adaya geldiğimizden\Nberi daha ihtiyatlı görünüyor.
Dialogue: 0,0:24:28.22,0:24:30.14,Main,Nami,0,0,0,,Caimie'yi rahatsız eden ne olabilir?
Dialogue: 0,0:24:33.21,0:24:37.36,Main,Robin,0,0,0,,Belki de bu adanın kötü\Nbir geçmişi vardır...?
Dialogue: 0,0:24:38.23,0:24:40.00,Main,Nami,0,0,0,,Kötü geçmiş?
Dialogue: 0,0:24:48.38,0:24:50.90,Main,Luffy,0,0,0,,Ben öndeyim!
Dialogue: 0,0:24:51.84,0:24:52.88,Main,Hachi,0,0,0,,Ukalâlık etme!
Dialogue: 0,0:24:53.00,0:24:55.20,Main,Hachi,0,0,0,,Daha yolumuz uzun!
Dialogue: 0,0:24:55.34,0:24:57.54,Main,Camie,0,0,0,,Hadi, Hacchin!
Dialogue: 0,0:24:57.66,0:25:01.42,Main,Chopper,0,0,0,,Bu nasıl bir yarışa dönüştü?
Dialogue: 0,0:25:22.86,0:25:23.98,Main,Luffy,0,0,0,,Bu kargaşa da ne?
Dialogue: 0,0:25:26.03,0:25:26.86,Main,Man,0,0,0,,Yalvarırım!
Dialogue: 0,0:25:26.93,0:25:27.76,Main,Man,0,0,0,,Hey!
Dialogue: 0,0:25:27.90,0:25:29.44,Main,Man,0,0,0,,Sizden bir iyilik istiyorum!
Dialogue: 0,0:25:31.13,0:25:32.32,Main,Man,0,0,0,,Kim olsa farketmez!
Dialogue: 0,0:25:32.42,0:25:33.20,Main,Man,0,0,0,,Balta!
Dialogue: 0,0:25:33.30,0:25:34.36,Main,Man,0,0,0,,Testere!
Dialogue: 0,0:25:34.92,0:25:35.98,Main,Man,0,0,0,,Her şey olur!
Dialogue: 0,0:25:36.28,0:25:38.32,Main,Man,0,0,0,,Bir şey verin yeter!
Dialogue: 0,0:25:38.64,0:25:40.54,Main,Man,0,0,0,,Sadece şunu boynumdan çıkarmak istiyorum!
Dialogue: 0,0:25:40.78,0:25:42.38,Main,Man,0,0,0,,Kimseye zarar vermeyeceğim!
Dialogue: 0,0:25:42.64,0:25:44.16,Main,Woman,0,0,0,,Lütfen bırak beni.
Dialogue: 0,0:25:44.38,0:25:45.64,Main,Woman,0,0,0,,Ölmek istemiyorum.
Dialogue: 0,0:25:51.90,0:25:55.36,Main,Man,0,0,0,,Yeni Dünya'ya gitmekten vazgeçtim!
Dialogue: 0,0:25:55.80,0:25:58.00,Main,Man,0,0,0,,Evimde karım ve çocuğum var!
Dialogue: 0,0:25:58.36,0:25:59.52,Main,Man,0,0,0,,Yalvarırım!
Dialogue: 0,0:25:59.83,0:26:01.44,Main,Man,0,0,0,,Lütfen yardım edin!
Dialogue: 0,0:26:02.16,0:26:03.28,Main,Man,0,0,0,,Eve dönmek istiyorum!
Dialogue: 0,0:26:03.40,0:26:05.46,Main,Man,0,0,0,,Çocuğumu son gördüğümde henüz bir bebekti.
Dialogue: 0,0:26:05.58,0:26:07.72,Main,Man,0,0,0,,Hâlâ neye benzediğimi bile bilmiyor!
Dialogue: 0,0:26:07.94,0:26:09.37,Main,Man,0,0,0,,Yalvarıyorum!
Dialogue: 0,0:26:10.94,0:26:11.72,Main,Luffy,0,0,0,,O...
Dialogue: 0,0:26:12.11,0:26:13.22,Main,Man,0,0,0,,Eve gitmek istiyorum!
Dialogue: 0,0:26:13.54,0:26:14.54,Main,Man,0,0,0,,Hey, lütfen!
Dialogue: 0,0:26:14.81,0:26:16.01,Main,Man,0,0,0,,Lütfen yardım edin!
Dialogue: 0,0:26:16.22,0:26:17.56,Main,Hachi,0,0,0,,Karışmayın.
Dialogue: 0,0:26:17.76,0:26:21.90,Main,Hachi,0,0,0,,Muhtemelen adam kaçıranlar tarafından\Nyakalanıp köle olarak satılmış bir korsan.
Dialogue: 0,0:26:22.36,0:26:26.50,Main,Hachi,0,0,0,,Sahibi onu bu adaya getirmiş\Nve o da kaçmış olmalı!
Dialogue: 0,0:26:26.92,0:26:29.50,Main,Hachi,0,0,0,,Kaçamayacağını biliyor olmasına rağmen!
Dialogue: 0,0:26:38.44,0:26:40.56,Main,Chopper,0,0,0,,O ses de ne?
Dialogue: 0,0:26:42.12,0:26:42.78,Main,Man,0,0,0,,Kahretsin!
Dialogue: 0,0:26:42.90,0:26:44.04,Main,Man,0,0,0,,Bu zil sesi!
Dialogue: 0,0:26:44.24,0:26:47.02,Main,Man,0,0,0,,Şunu boynumdan çıkarabilseydim!
Dialogue: 0,0:26:47.20,0:26:47.80,Main,Man,0,0,0,,Kahretsin!
Dialogue: 0,0:26:47.91,0:26:48.62,Main,Man,0,0,0,,Hayır!
Dialogue: 0,0:26:48.92,0:26:49.58,Main,Man,0,0,0,,Dur!
Dialogue: 0,0:26:49.71,0:26:50.74,Main,Man,0,0,0,,Lütfen dur!
Dialogue: 0,0:26:50.92,0:26:51.58,Main,Man,0,0,0,,Hey!
Dialogue: 0,0:26:51.78,0:26:52.64,Main,Man,0,0,0,,Hey!
Dialogue: 0,0:26:53.14,0:26:56.22,Main,Man,0,0,0,,Hepsinin canı cehenneme!
Dialogue: 0,0:27:17.25,0:27:20.58,Main,Hachi,0,0,0,,Kölelerin boynunda her zaman\No tasmalardan olur.
Dialogue: 0,0:27:20.82,0:27:24.11,Main,Hachi,0,0,0,,Onu çıkarmaya veya kaçmaya\Nçalışırlarsa patlar!
Dialogue: 0,0:27:27.31,0:27:29.52,Main,Man,0,0,0,,Birkaç hediyelik eşya alıp\Nevime gitmeme izin verin.
Dialogue: 0,0:27:30.74,0:27:33.98,Main,Man,0,0,0,,Korsanlıktan vazgeçtim.
Dialogue: 0,0:27:39.79,0:27:42.28,Main,People,0,0,0,,Kaçmaya çalışan bir köle!
Dialogue: 0,0:27:42.46,0:27:43.16,Main,People,0,0,0,,Uzaklaşın!
Dialogue: 0,0:27:43.33,0:27:44.67,Main,People,0,0,0,,Ona bulaşmayın!
Dialogue: 0,0:27:44.86,0:27:46.20,Main,Brook,0,0,0,,Ş-Şuna bak...
Dialogue: 0,0:27:46.37,0:27:47.14,Main,Brook,0,0,0,,Yardım etmeliyiz!
Dialogue: 0,0:27:47.27,0:27:47.78,Main,Pappag,0,0,0,,Aptal!
Dialogue: 0,0:27:47.87,0:27:50.30,Main,Pappag,0,0,0,,Ne olursa olsun karışmayacağınıza\Nsöz verdiniz, değil mi?!
Dialogue: 0,0:27:51.42,0:27:52.94,Main,Chopper,0,0,0,,Bu şehrin nesi var?!
Dialogue: 0,0:27:53.22,0:27:54.62,Main,Camie,0,0,0,,Hacchin, ne yapacağız?!
Dialogue: 0,0:27:54.74,0:27:56.68,Main,Camie,0,0,0,,Kutsal Ejderler yakında!
Dialogue: 0,0:27:57.28,0:27:58.56,Main,Hachi,0,0,0,,Sorun yok.
Dialogue: 0,0:27:59.14,0:28:00.82,Main,Hachi,0,0,0,,Sakin ol, Caimie!
Dialogue: 0,0:28:01.12,0:28:01.90,Main,Hachi,0,0,0,,Hasır Şapka!
Dialogue: 0,0:28:02.12,0:28:03.38,Main,Hachi,0,0,0,,Kabarcık bisikletten çık!
Dialogue: 0,0:28:03.46,0:28:03.94,Main,Luffy,0,0,0,,Ha?
Dialogue: 0,0:28:04.08,0:28:04.74,Main,Luffy,0,0,0,,Neden?
Dialogue: 0,0:28:04.86,0:28:06.22,Main,Hachi,0,0,0,,Hemen yap şunu!
Dialogue: 0,0:28:07.02,0:28:08.76,Main,Luffy,0,0,0,,Ah, tabii...
Dialogue: 0,0:28:16.42,0:28:17.12,Main,People,0,0,0,,Geldiler!
Dialogue: 0,0:28:21.28,0:28:23.16,Main,Luffy,0,0,0,,Kutsal Ejderler onlar mı?
Dialogue: 0,0:28:23.26,0:28:24.68,Main,Hachi,0,0,0,,Sen de başını eğmelisin!
Dialogue: 0,0:28:24.76,0:28:25.54,Main,Luffy,0,0,0,,Niye?
Dialogue: 0,0:28:25.74,0:28:27.80,Main,Hachi,0,0,0,,Ne olursa olsun gözlerine bakma!
Dialogue: 0,0:28:29.11,0:28:31.85,Main,Lady,0,0,0,,Ah, ne edepsizsin, Saruu!
Dialogue: 0,0:28:32.84,0:28:33.74,Main,Luffy,0,0,0,,Onlar mı?
Dialogue: 0,0:28:50.65,0:28:56.18,Captions,,0,20,306,,{\fad(700,0)\fs34\}Kutsal Ejder\NAziz Roswald
Dialogue: 0,0:28:50.65,0:28:56.18,Captions,,550,0,160,,{\fad(700,0)\fs34\}Kutsal Ejder\NAziz Shalria
Dialogue: 0,0:28:56.58,0:28:58.10,Main,Lady,0,0,0,,Olamaz, Baba.
Dialogue: 0,0:28:58.27,0:29:00.34,Main,Lady,0,0,0,,Biri daha bozuldu.
Dialogue: 0,0:29:00.50,0:29:03.64,Main,World Noble,0,0,0,,Her gün ona sakinleştirici\Nverdiğinden emin misin?
Dialogue: 0,0:29:03.84,0:29:05.06,Main,Lady,0,0,0,,Evet, verdim.
Dialogue: 0,0:29:05.24,0:29:07.52,Main,Lady,0,0,0,,Ama galiba böyle aptalların\Nüstünde işe yaramıyor.
Dialogue: 0,0:29:09.96,0:29:12.90,Main,Lady,0,0,0,,Bana yenisini alır mısın?
Dialogue: 0,0:29:13.04,0:29:16.20,Main,World Noble,0,0,0,,Terbiye etme yeteneklerin gerçekten berbat.
Dialogue: 0,0:29:16.44,0:29:20.26,Main,World Noble,0,0,0,,Kaptan koleksiyonumu birbiri ardına\Nyok etmeye devam ediyorsun.
Dialogue: 0,0:29:20.40,0:29:21.96,Main,Lady,0,0,0,,Bu kesinlikle işe yaramazın teki.
Dialogue: 0,0:29:22.38,0:29:26.56,Main,Lady,0,0,0,,Ailesi şöyle, ailesi böyle diye\Nsürekli ağlayan yetişkin bir adam...
Dialogue: 0,0:29:26.76,0:29:31.04,Main,Lady,0,0,0,,Sen sadece bir insansın!
Dialogue: 0,0:29:31.46,0:29:33.34,Main,Luffy,0,0,0,,Artık kıpırdayamıyor bile!
Dialogue: 0,0:29:35.84,0:29:37.52,Main,Lady,0,0,0,,Beni tiksindiriyorsun!
Dialogue: 0,0:29:41.58,0:29:42.20,Main,Luffy,0,0,0,,Niye o-
Dialogue: 0,0:29:42.27,0:29:43.48,Main,Hachi,0,0,0,,Lütfen dur!
Dialogue: 0,0:29:43.95,0:29:46.46,Main,Lady,0,0,0,,Bir dahakine dev bir köle istiyorum.
Dialogue: 0,0:29:46.65,0:29:49.42,Main,World Noble,0,0,0,,İnsan bir çocukla başlamalısın.
Dialogue: 0,0:29:49.60,0:29:51.10,Main,Lady,0,0,0,,Ama güçsüzlerden tiksiniyorum.
Dialogue: 0,0:29:52.76,0:29:55.10,Main,Hachi,0,0,0,,Lütfen aceleci davranma!
Dialogue: 0,0:29:55.26,0:29:56.28,Main,Person,0,0,0,,Denizciler!
Dialogue: 0,0:29:56.60,0:29:58.02,Main,Marine,0,0,0,,Çekilin, çekilin!
Dialogue: 0,0:30:00.26,0:30:02.32,Main,Hachi,0,0,0,,Öncelikle buradan uzaklaşmalıyız!
Dialogue: 0,0:30:10.14,0:30:11.48,Main,Brook,0,0,0,,Çay ister misin?
Dialogue: 0,0:30:11.68,0:30:12.94,Main,Brook,0,0,0,,Sakinleşmene yardımcı olur.
Dialogue: 0,0:30:14.46,0:30:15.76,Main,Camie,0,0,0,,Kendimi kötü hissediyorum.
Dialogue: 0,0:30:16.18,0:30:19.06,Main,Luffy,0,0,0,,O adam iyi olacak mı dersiniz?
Dialogue: 0,0:30:19.42,0:30:22.18,Main,Hachi,0,0,0,,O bir korsan, bu yüzden onu kurtarsalar\Nbile hapishaneye gönderilecek.
Dialogue: 0,0:30:22.34,0:30:26.30,Main,Chopper,0,0,0,,O korsan, yaşlı adamı ve kadını\Nyenebiliyor olmalı, değil mi?
Dialogue: 0,0:30:26.54,0:30:27.30,Main,Chopper,0,0,0,,Neden?!
Dialogue: 0,0:30:27.56,0:30:29.60,Main,Pappag,0,0,0,,Kutsal Ejderler'den birine\Nzarar verirsen...
Dialogue: 0,0:30:29.96,0:30:33.30,Main,Pappag,0,0,0,,...Denizci Karargâhı'ndan bir amiral ve\Nbir savaş gemisi filosu buraya gelecek.
Dialogue: 0,0:30:35.14,0:30:36.22,Main,Luffy,0,0,0,,Amiral...
Dialogue: 0,0:30:37.17,0:30:38.06,Main,Luffy,0,0,0,,...Aokiji mi?!
Dialogue: 0,0:30:38.22,0:30:40.04,Main,Pappag,0,0,0,,Akainu veya Kizaru da olabilir.
Dialogue: 0,0:30:40.17,0:30:41.84,Main,Pappag,0,0,0,,Kimin geleceğini bilmek mümkün değil.
Dialogue: 0,0:30:42.22,0:30:43.96,Main,Pappag,0,0,0,,Karargâh hemen dibimizde.
Dialogue: 0,0:30:44.34,0:30:46.42,Main,Chopper,0,0,0,,Onları bu kadar özel yapan ne?!
Dialogue: 0,0:30:46.58,0:30:49.78,Main,Pappag,0,0,0,,Onlar, kurucuların torunlarıdır!
Dialogue: 0,0:30:50.80,0:30:51.90,Main,Chopper,0,0,0,,Kurucular?
Dialogue: 0,0:30:52.38,0:30:58.40,Main,Pappag,0,0,0,,800 yıl önce 20 kraldan oluşan bir grup\NDünya Hükümeti olarak bilinen örgütü kurdu.
Dialogue: 0,0:30:58.94,0:31:01.08,Main,Pappag,0,0,0,,Kutsal Ejderler, onların torunlarıdır.
Dialogue: 0,0:31:01.28,0:31:04.13,Main,Pappag,0,0,0,,Yıllar geçtikçe...
Dialogue: 0,0:31:04.58,0:31:06.48,Main,Pappag,0,0,0,,...inanılmaz nüfuzlarını daha da\Nkötüye kullanır oldular.
Dialogue: 0,0:31:07.77,0:31:08.92,Main,Luffy,0,0,0,,Kutsal Ejderler...
