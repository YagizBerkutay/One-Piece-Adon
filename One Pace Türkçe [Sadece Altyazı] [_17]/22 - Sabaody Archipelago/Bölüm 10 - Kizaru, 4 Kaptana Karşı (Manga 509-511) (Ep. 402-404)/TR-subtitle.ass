Dialogue: 0,0:01:46.60,0:01:51.29,Title,,0,0,240,,{\fad(550,55}Kizaru, 4 Kaptana Karşı
Dialogue: 0,0:02:01.41,0:02:03.07,Main,Franky,0,0,0,,İnanılmaz!
Dialogue: 0,0:02:03.49,0:02:05.63,Main,Usopp,0,0,0,,Ellerinden ve ağzından da mı?
Dialogue: 0,0:02:05.73,0:02:06.29,Main,Brook,0,0,0,,Korkutucu!
Dialogue: 0,0:02:07.85,0:02:09.57,Main,Usopp,0,0,0,,Bir tane daha geliyor!
Dialogue: 0,0:02:21.83,0:02:23.77,Main,Franky,0,0,0,,O neyin nesi öyle?!
Dialogue: 0,0:02:24.01,0:02:26.13,Main,Usopp,0,0,0,,Dedikleri gibi, ışın!
Dialogue: 0,0:02:26.25,0:02:27.79,Main,Franky,0,0,0,,Işın sadece bir ışık hüzmesidir!
Dialogue: 0,0:02:27.89,0:02:30.83,Main,Franky,0,0,0,,Öyle bir şeyin silah olarak\Nçalışması sadece bir fantezi!
Dialogue: 0,0:02:31.51,0:02:33.63,Main,Franky,0,0,0,,Ha, ne yapıyorsun?
Dialogue: 0,0:02:34.35,0:02:35.81,Main,Brook,0,0,0,,Ölü rolü yapıyorum.
Dialogue: 0,0:02:36.27,0:02:38.17,Main,Franky & Usopp,0,0,0,,Ölü olmadığını zaten biliyor!
Dialogue: 0,0:02:47.30,0:02:48.48,Main,Zoro,0,0,0,,{\fad(150,150)}Üç Kılıç Stili...
Dialogue: 0,0:02:48.97,0:02:50.53,Main,Luffy,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:02:51.29,0:02:52.57,Main,Sanji,0,0,0,,{\fad(150,150)}Şeytan...
Dialogue: 0,0:02:53.99,0:02:54.81,Note,Sanji,0,0,0,,{\fad(150,150)}...Koyun Eti...
Dialogue: 0,0:02:54.99,0:02:55.85,Main,Luffy,0,0,0,,{\fad(150,150)}...Jet...
Dialogue: 0,0:02:56.03,0:02:57.11,Main,Zoro,0,0,0,,{\fad(150,150)}...275 Kiloluk...
Dialogue: 0,0:02:58.05,0:02:59.43,Main,All,0,0,0,,{\fad(150,150)}...Top!
Dialogue: 0,0:03:15.17,0:03:16.37,Main,Nami,0,0,0,,Yaşasın!
Dialogue: 0,0:03:16.43,0:03:17.37,Main,Nami,0,0,0,,Onu hakladılar mı?
Dialogue: 0,0:03:17.51,0:03:19.25,Main,Chopper,0,0,0,,Müthişler!
Dialogue: 0,0:03:19.49,0:03:21.15,Main,Robin,0,0,0,,Rakibimiz bir Shichibukai.
Dialogue: 0,0:03:21.57,0:03:23.59,Main,Robin,0,0,0,,O kadar kolay yenilemezler.
Dialogue: 0,0:03:23.87,0:03:25.91,Main,Robin,0,0,0,,Sadece yüz ifadelerinden\Nbunu anlayabilirim.
Dialogue: 0,0:03:29.07,0:03:30.67,Main,Luffy,0,0,0,,Gerçekten o kadar farklı mı?
Dialogue: 0,0:03:30.97,0:03:33.55,Main,Luffy,0,0,0,,O zaman bu, onun ikizi falan mı?
Dialogue: 0,0:03:34.83,0:03:37.27,Main,Sanji,0,0,0,,Evet, bu da bir olasılık.
Dialogue: 0,0:03:38.82,0:03:43.70,Main,Zoro,0,0,0,,Neyse, gerçeği olsaydı\Nsaldırılarımızı anında savuştururdu.
Dialogue: 0,0:03:44.25,0:03:48.11,Main,Zoro,0,0,0,,Asıl önemlisi şok dalgası\Nfırlatmıyor ve patileri yok.
Dialogue: 0,0:03:48.29,0:03:52.44,Main,Sanji,0,0,0,,Ama sahtesiyse bu da bir sorun demektir.
Dialogue: 0,0:03:53.13,0:03:55.98,Main,Sanji,0,0,0,,Onun kadar güçlü iki kişi\Nolduğu anlamına gelir.
Dialogue: 0,0:04:09.27,0:04:12.47,Main,Urouge,0,0,0,,Beni kötü biçimde yaraladın...
Dialogue: 0,0:04:12.56,0:04:14.99,Main,Urouge,0,0,0,,...ama deminki gibi olduğumu sanmıyorum!
Dialogue: 0,0:04:15.60,0:04:17.60,Main,Urouge,0,0,0,,{\fad(150,150)}Karmik Ceza!
Dialogue: 0,0:04:36.17,0:04:37.65,Main,Hawkins,0,0,0,,"Deli Keşiş" Urouge...
Dialogue: 0,0:04:37.89,0:04:41.33,Main,Hawkins,0,0,0,,Şu ana dek fena hâlde\Nyaralanmış olan bir adam...
Dialogue: 0,0:04:41.53,0:04:45.41,Main,Hawkins,0,0,0,,...aniden nasıl bu kadar büyür ve güçlenir?
Dialogue: 0,0:04:58.15,0:05:00.17,Main,Drake,0,0,0,,O Kizaru'nun lazeriydi!
Dialogue: 0,0:05:01.57,0:05:06.63,Thoughts,Drake,0,0,0,,Kizaru'nun yok edici gücünü \NBartholomew Kuma'nın içine koymayı başardın mı,...
Dialogue: 0,0:05:06.99,0:05:08.05,Thoughts,Drake,0,0,0,,...Vegapunk?!
Dialogue: 0,0:05:09.35,0:05:13.09,Thoughts,Drake,0,0,0,,*Pacifistalar şimdiden bu kadar gelişti mi?!
Dialogue: 0,0:05:15.36,0:05:17.83,Main,Pirate 1,0,0,0,,Bu iş çığırından çıkıyor!
Dialogue: 0,0:05:17.95,0:05:20.75,Main,Pirate 2,0,0,0,,Evet, 100 milyonun üstünde\Nödülü olan 3 adamın,...
Dialogue: 0,0:05:20.87,0:05:23.99,Main,Pirate 2,0,0,0,,...bir Shichibukai ve amiral karşısında\Nhayatta kalması mümkün değil!
Dialogue: 0,0:05:28.88,0:05:30.73,Main,Kizaru,0,0,0,,Tuğamiral Drake.
Dialogue: 0,0:05:30.93,0:05:34.03,Main,Kizaru,0,0,0,,Hayır, eski tuğamiral.
Dialogue: 0,0:05:34.33,0:05:37.11,Main,Kizaru,0,0,0,,Bunu görmek için buraya gelmedin mi?
Dialogue: 0,0:05:38.83,0:05:41.78,Main,Kizaru,0,0,0,,Dövüşmeyi denemek istersen, buyur.
Dialogue: 0,0:05:42.47,0:05:44.53,Main,Kizaru,0,0,0,,Koşulları zaten bildiğine düşünürsek...
Dialogue: 0,0:05:44.65,0:05:47.28,Main,Kizaru,0,0,0,,...sanırım deneyemeyecek kadar korktun, değil mi?
Dialogue: 0,0:05:50.11,0:05:54.33,Main,Kizaru,0,0,0,,Ama soğukkanlılığınızı kaybetmemeye çalışın\Nbenim dayanıksız küçük dostlarım.
Dialogue: 0,0:05:58.82,0:06:01.79,Main,Kizaru,0,0,0,,Sonuçta ben buradayım.
Dialogue: 0,0:06:22.51,0:06:26.01,Main,Apoo,0,0,0,,Ah, ilginç bir şey daha görüyorum.
Dialogue: 0,0:06:26.45,0:06:30.67,Main,Apoo,0,0,0,,İlk kez nadir bir antik zoan tipi görüyorum.
Dialogue: 0,0:07:00.65,0:07:04.25,Main,Drake,0,0,0,,Senin bile damarlarında kırmızı kan\Nolduğunu gördüğüme şaşırdım.
Dialogue: 0,0:07:06.97,0:07:10.07,Main,Urouge,0,0,0,,Gerçekten sıradışı bir şey gördüm.
Dialogue: 0,0:07:11.08,0:07:14.11,Main,Kizaru,0,0,0,,Ben de buradayım dedim, değil mi?
Dialogue: 0,0:07:37.47,0:07:43.07,Main,Kizaru,0,0,0,,Sanırım 100 milyonun üstünde olan \Nher biriniz birer canavarsınız.
Dialogue: 0,0:07:43.16,0:07:44.74,Main,Kizaru,0,0,0,,Bu epey korkunç!
Dialogue: 0,0:07:46.11,0:07:48.09,Main,Hawkins,0,0,0,,{\fad(150,150)}Şeytan Zapt Etme Evresi!
Dialogue: 0,0:07:52.95,0:07:53.77,Main,Hawkins,0,0,0,,Yok oldu!
Dialogue: 0,0:07:59.63,0:08:00.99,Main,Hawkins,0,0,0,,G-Gözlerim!
Dialogue: 0,0:08:02.07,0:08:03.25,Main,Pirate,0,0,0,,Kaptan Hawkins!
Dialogue: 0,0:08:04.83,0:08:06.15,Main,Hawkins,0,0,0,,Göremiyorum!
Dialogue: 0,0:08:10.83,0:08:14.71,Main,Kizaru,0,0,0,,Ne tür bir yeteneğin olduğunu\Nbilmiyorum ama fiziksel bir şeklin var.
Dialogue: 0,0:08:15.13,0:08:17.27,Main,Kizaru,0,0,0,,Bu yüzden Logia tipi\Nolmadığını farz ediyorum.
Dialogue: 0,0:08:24.81,0:08:25.75,Main,Pirate 1,0,0,0,,Kaptan!
Dialogue: 0,0:08:25.85,0:08:26.75,Main,Pirate 2,0,0,0,,Durum kötü!
Dialogue: 0,0:08:26.85,0:08:28.37,Main,Pirate 2,0,0,0,,Hasar sınırını aştı!
Dialogue: 0,0:08:28.61,0:08:29.69,Main,Pirate 2,0,0,0,,Gerçekten ölecek!
Dialogue: 0,0:08:30.09,0:08:32.29,Main,Kizaru,0,0,0,,İşte birincisi...
Dialogue: 0,0:08:34.21,0:08:38.75,Main,Kizaru,0,0,0,,Uzun yolculuğunda buraya\Nkadar gelerek iyi iş çıkardın.
Dialogue: 0,0:09:14.43,0:09:16.47,Lyrics,Apoo,0,0,0,,♪ Bu müzik sana ulaşıyor mu? ♪
Dialogue: 0,0:09:16.67,0:09:19.01,Lyrics,Apoo,0,0,0,,♪ Duyuyorsan dalgayı ayarla! ♪
Dialogue: 0,0:09:19.25,0:09:21.79,Lyrics,Apoo,0,0,0,,♪ Donanma amirali Kizaru! ♪
Dialogue: 0,0:09:29.55,0:09:32.35,Main,Drake,0,0,0,,O, "Gürüldeyen Gelgit"...
Dialogue: 0,0:09:33.59,0:09:36.83,Lyrics,Apoo,0,0,0,,♪ Herkes dövüş müziğimi dinlesin! ♪
Dialogue: 0,0:09:49.13,0:09:50.83,Main,Kizaru,0,0,0,,Ne?
Dialogue: 0,0:09:50.95,0:09:52.61,Lyrics,Apoo,0,0,0,,♪ İşte başlıyoruz! ♪
Dialogue: 0,0:10:04.09,0:10:05.55,Lyrics,Apoo,0,0,0,,♪ Şuna bir bakın! ♪
Dialogue: 0,0:10:15.21,0:10:19.19,Main,Apoo,0,0,0,,Gerçi bir donanma amiralinin böyle \Nbir şeyden ötürü öleceğinden şüpheliyim.
Dialogue: 0,0:10:19.67,0:10:22.47,Main,Apoo,0,0,0,,Vay canına, gerçekten \Nbir sürü ilginç şey gördüm.
Dialogue: 0,0:10:22.57,0:10:24.21,Main,Apoo,0,0,0,,Şimdi gidiyorum.
Dialogue: 0,0:10:24.23,0:10:24.81,Main,Apoo,0,0,0,,Görüşürüz!
Dialogue: 0,0:10:33.61,0:10:35.95,Main,Kizaru,0,0,0,,Bu berbat.
Dialogue: 0,0:11:06.37,0:11:09.85,Main,Kizaru,0,0,0,,Ohh, ne şaşırtıcı.
Dialogue: 0,0:11:16.08,0:11:18.08,Main,Kizaru,0,0,0,,{\fad(150,150)}Yata Aynası.
Dialogue: 0,0:11:23.89,0:11:25.09,Main,Apoo,0,0,0,,Ne?
Dialogue: 0,0:12:34.01,0:12:35.83,Main,Kizaru,0,0,0,,Merhaba?
Dialogue: 0,0:12:37.37,0:12:38.37,Main,Kizaru,0,0,0,,Ha?
Dialogue: 0,0:12:38.49,0:12:40.23,Main,Kizaru,0,0,0,,Merhaba?
Dialogue: 0,0:12:40.57,0:12:43.09,Main,Kizaru,0,0,0,,Ah, işte burada.
Dialogue: 0,0:12:43.60,0:12:45.85,Main,Kizaru,0,0,0,,Ben Borsalino.
Dialogue: 0,0:12:45.95,0:12:46.95,Main,Sentoumaru,0,0,0,,Yaşlı adam!
Dialogue: 0,0:12:47.19,0:12:49.63,Main,Sentoumaru,0,0,0,,Bebek Den Den Mushi'n yanında!
Dialogue: 0,0:12:49.85,0:12:51.57,Main,Sentoumaru,0,0,0,,Niye benimle bağlantı kurmadın?!
Dialogue: 0,0:12:52.85,0:12:55.17,Main,Kizaru,0,0,0,,Ah, Sentoumaru-kun!
Dialogue: 0,0:12:55.25,0:12:56.33,Main,Sentoumaru,0,0,0,,"Ah" deyip durma!
Dialogue: 0,0:12:56.43,0:12:57.67,Main,Sentoumaru,0,0,0,,Ne yapıyorsun?!
Dialogue: 0,0:12:57.87,0:12:59.77,Main,Sentoumaru,0,0,0,,Adaya geldin, değil mi?!
Dialogue: 0,0:12:59.97,0:13:03.53,Main,Kizaru,0,0,0,,Şey, seninle bağlantı kuramadım.
Dialogue: 0,0:13:03.77,0:13:07.87,Main,Sentoumaru,0,0,0,,Bahse varım yine siyah Den Den Mushi'den\Nkonuşmaya çalışmışsındır, değil mi?
Dialogue: 0,0:13:09.03,0:13:13.33,Main,Sentoumaru,0,0,0,,Kolundaki siyah Den Den Mushi'nin sadece telefon\Ndinlemek için olduğunu daha önce söylemiştim.
Dialogue: 0,0:13:13.47,0:13:14.41,Main,Kizaru,0,0,0,,Ah...
Dialogue: 0,0:13:14.51,0:13:15.63,Main,Kizaru,0,0,0,,Ah...!
Dialogue: 0,0:13:15.93,0:13:17.37,Main,Sentoumaru,0,0,0,,Neyse!
Dialogue: 0,0:13:17.59,0:13:19.43,Main,Sentoumaru,0,0,0,,Hemen işe koyul!
Dialogue: 0,0:13:19.63,0:13:21.57,Main,Sentoumaru,0,0,0,,Hedeflerimizi çoktan tespit ettik!
Dialogue: 0,0:13:21.89,0:13:27.41,Main,Sentoumaru,0,0,0,,Hasır Şapkalı Luffy, Kaptan Kid ve \NTrafalgar Law, kiminle başlamak istiyorsun?
Dialogue: 0,0:13:27.57,0:13:29.45,Main,Kizaru,0,0,0,,Oh, öyle mi?
Dialogue: 0,0:13:29.52,0:13:30.86,Main,Kizaru,0,0,0,,O zaman...
Dialogue: 0,0:13:30.87,0:13:32.52,Captions,,0,890,16,,{\fad(0,20)}Sabaody Takımadaları\N\N\N\N\N\N\N\N\N\N\N\N\N\N\N\N\N\N\N12. Koru
Dialogue: 0,0:13:40.16,0:13:41.60,Main,Luffy,0,0,0,,Zoro!
Dialogue: 0,0:13:43.72,0:13:45.28,Main,Luffy,0,0,0,,Hey, Zoro!
Dialogue: 0,0:13:45.90,0:13:48.04,Main,Luffy,0,0,0,,Gerçekten kıpırdayamayacak\Nkadar kötü mü yaralandın?
Dialogue: 0,0:13:49.50,0:13:51.40,Main,Sanji,0,0,0,,Onu rahat bırak, Luffy!
Dialogue: 0,0:13:53.16,0:13:54.90,Main,Sanji,0,0,0,,Önce bu şeyi yenmeliyiz!
Dialogue: 0,0:13:55.38,0:13:56.32,Main,Luffy,0,0,0,,Tamam.
Dialogue: 0,0:14:05.04,0:14:09.68,Main,Sanji,0,0,0,,O zamanki yaralarının tamamen\Niyileşmiş olması mümkün değil.
Dialogue: 0,0:14:09.96,0:14:15.17,Main,Sanji,0,0,0,,Görebildiğim kadarıyla sadece düşmanın\Nkarşısında durmak bile onun için acı verici olmalı.
Dialogue: 0,0:14:16.18,0:14:21.40,Main,Sanji,0,0,0,,Bu pislik Bartholomew Kuma\Ndeğilse, kim o zaman?!
Dialogue: 0,0:14:22.12,0:14:24.71,Main,Sanji,0,0,0,,Aynen o Shichibukai'a benziyor...
Dialogue: 0,0:14:25.14,0:14:27.71,Main,Sanji,0,0,0,,Neler oluyor Allah aşkına?!
Dialogue: 0,0:14:35.68,0:14:36.92,Main,Usopp,0,0,0,,Hey, Zoro!
Dialogue: 0,0:14:40.24,0:14:41.52,Main,Chopper,0,0,0,,{\fad(150,150)}Çatal Tırnak...
Dialogue: 0,0:14:41.86,0:14:44.68,Main,Chopper,0,0,0,,{\fad(150,150)}...Gül Fırtınası!
Dialogue: 0,0:14:44.99,0:14:45.74,Main,Luffy and Sanji,0,0,0,,Chopper!
Dialogue: 0,0:14:55.44,0:14:57.98,Main,Franky,0,0,0,,{\fad(150,150)}Güçlü Çekiç!
Dialogue: 0,0:15:00.62,0:15:02.90,Main,Franky,0,0,0,,{\fad(150,150)}Franky Boksu!
Dialogue: 0,0:15:11.74,0:15:12.76,Main,Robin,0,0,0,,{\fad(150,150)}Örümcek Ağı!
Dialogue: 0,0:15:15.66,0:15:18.76,Main,Usopp,0,0,0,,Fiziksel gücünü de hafife alamayız!
Dialogue: 0,0:15:22.18,0:15:24.10,Main,Brook,0,0,0,,Dikkatli ol!
Dialogue: 0,0:15:24.38,0:15:25.78,Main,Brook,0,0,0,,Geliyorum!
Dialogue: 0,0:15:26.42,0:15:29.42,Main,Brook,0,0,0,,{\fad(150,150)}İleri Atılımı Yut!
Dialogue: 0,0:15:31.42,0:15:32.02,Main,Brook,0,0,0,,
Dialogue: 0,0:15:33.96,0:15:37.06,Main,Brook,0,0,0,,Durdum!
Dialogue: 0,0:15:38.18,0:15:41.28,Main,Brook,0,0,0,,D-Dur, bu çok tehlikeli!
Dialogue: 0,0:15:41.48,0:15:44.20,Main,Brook,0,0,0,,Beni öldürmeyi mi planlıyorsun?!
Dialogue: 0,0:15:44.64,0:15:47.22,Main,Brook,0,0,0,,Gerçi ben zaten ölüyüm.
Dialogue: 0,0:15:47.74,0:15:49.56,Main,Brook,0,0,0,,Bunu söyleyecek zaman değil!
Dialogue: 0,0:15:49.76,0:15:52.46,Main,Usopp,0,0,0,,{\fad(150,150)}Kesin Öldürücü Atlas Kuyruklu Yıldızı
Dialogue: 0,0:15:54.36,0:15:56.96,Main,Usopp,0,0,0,,Şimdi fırsatımız var! Kaçın!
Dialogue: 0,0:15:57.06,0:15:59.88,Main,Brook,0,0,0,,Korkunçtu! Çok sağol!
Dialogue: 0,0:16:07.02,0:16:09.82,Main,Chopper,0,0,0,,Ha? Tuhaf davranıyor.
Dialogue: 0,0:16:12.18,0:16:15.28,Main,Usopp,0,0,0,,Ne? Bombalar şimdi işe yarıyor mu?
Dialogue: 0,0:16:17.64,0:16:22.24,Main,Franky,0,0,0,,Atışlardan biri ağzından içeri girdi. Vücudunun\Niçindeki bir şey kısa devre falan yapmış olmalı.
Dialogue: 0,0:16:23.88,0:16:27.04,Main,Franky,0,0,0,,Bedeni sert olabilir ama\Nyine de içinde kan var.
Dialogue: 0,0:16:27.32,0:16:31.04,Main,Franky,0,0,0,,Tüm bedeni benimki gibi silah\Nolması için modifiye edilmiş...
Dialogue: 0,0:16:31.14,0:16:33.66,Main,Franky,0,0,0,,...ama aslında normal bir insan!
Dialogue: 0,0:16:39.04,0:16:41.40,Main,Sanji,0,0,0,,Nami-san, dikkat et! Seni buldu!
Dialogue: 0,0:16:45.10,0:16:45.82,Main,Nami,0,0,0,,Olamaz!
Dialogue: 0,0:16:45.83,0:16:47.34,Main,Robin,0,0,0,,{\fad(150,150)}Seksen Çiçek!
Dialogue: 0,0:16:45.83,0:16:47.34,Note,Robin,0,0,0,,{\fad(150,150)}Ochenta Fleurs
Dialogue: 0,0:16:47.76,0:16:48.90,Main,Robin,0,0,0,,{\fad(150,150)}Dört El!
Dialogue: 0,0:16:47.76,0:16:48.90,Note,Robin,0,0,0,,{\fad(150,150)}Cuatro Manos
Dialogue: 0,0:16:50.18,0:16:50.84,Main,Robin,0,0,0,,{\fad(150,150)}Şok!
Dialogue: 0,0:16:54.06,0:16:57.40,Main,Usopp,0,0,0,,Başardın! Işını kendi ağzı içinde ateşledi!
Dialogue: 0,0:16:57.48,0:16:58.98,Main,Usopp,0,0,0,,Kendini yok etti!
Dialogue: 0,0:17:04.96,0:17:07.48,Main,Nami,0,0,0,,Molanı böldüğüm için kusura bakma kardeş.
Dialogue: 0,0:17:07.88,0:17:10.08,Main,Nami,0,0,0,,Ama oradaki yıldırıma dikkat etmelisin!
Dialogue: 0,0:17:12.12,0:17:14.06,Main,Nami,0,0,0,,Kara bulutlardan iklim aygıtına...
Dialogue: 0,0:17:14.62,0:17:17.40,Main,Nami,0,0,0,,{\fad(150,150)}Yıldırım Mızrağı Temposu!
Dialogue: 0,0:17:27.52,0:17:30.22,Main,Brook,0,0,0,,Bu kesinlikle işe yaradı. Müthiş!
Dialogue: 0,0:17:38.64,0:17:42.72,Main,Usopp,0,0,0,,Hiç de işe yaramadı, değil mi?!\NHala mükemmel biçimde iyi, değil mi?!
Dialogue: 0,0:17:48.34,0:17:51.00,Main,Sanji,0,0,0,,Umutsuzluğa düştüğünde dövüş biter.
Dialogue: 0,0:17:53.52,0:17:56.58,Main,Zoro,0,0,0,,Hey, onu buraya uçur!
Dialogue: 0,0:17:57.08,0:17:58.96,Main,Sanji,0,0,0,,Çok inatçısın.
Dialogue: 0,0:17:59.88,0:18:01.36,Main,Sanji,0,0,0,,{\fad(150,150)}Şeytan Bacak!
Dialogue: 0,0:18:01.98,0:18:04.22,Main,Sanji,0,0,0,,{\fad(150,150)}Alevli Vuruş!
Dialogue: 0,0:18:01.98,0:18:04.22,Note,,0,0,0,,{\fad(150,150)}Flambé Shot
Dialogue: 0,0:18:10.46,0:18:13.14,Main,Franky,0,0,0,,Tamam! Nihayet parçalanmaya başladı!
Dialogue: 0,0:18:13.96,0:18:15.10,Main,Zoro,0,0,0,,{\fad(150,150)}Şeytani Ruh.
Dialogue: 0,0:18:15.68,0:18:17.16,Main,Zoro,0,0,0,,{\fad(150,150)}Dokuz Kılıç Stili!
Dialogue: 0,0:18:17.62,0:18:19.24,Main,Zoro,0,0,0,,{\fad(150,150)}Asura!
Dialogue: 0,0:18:19.66,0:18:21.74,Main,Brook,0,0,0,,O da ne öyle?!
Dialogue: 0,0:18:21.94,0:18:22.96,Main,Chopper,0,0,0,,Zoro çoğaldı?!
Dialogue: 0,0:18:25.76,0:18:27.54,Main,Zoro,0,0,0,,{\fad(150,150)}Dokuz Şeytani Darbe!
Dialogue: 0,0:18:36.84,0:18:38.46,Main,Luffy,0,0,0,,{\fad(150,150)}Üçüncü Düzen!
Dialogue: 0,0:18:39.26,0:18:41.00,Main,Luffy,0,0,0,,Gidelim!
Dialogue: 0,0:18:41.34,0:18:43.36,Main,Nami,0,0,0,,Hadi, Luffy!
Dialogue: 0,0:18:43.68,0:18:45.50,Main,Franky,0,0,0,,Bir vuruşa daha ihtiyacımız var!
Dialogue: 0,0:18:45.65,0:18:48.20,Main,Luffy,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:18:50.68,0:18:53.08,Main,Usopp and Chopper,0,0,0,,Ez onu, Luffy!
Dialogue: 0,0:18:54.78,0:18:58.62,Main,Luffy,0,0,0,,{\fad(150,150)}...Dev Tüfek!
Dialogue: 0,0:19:16.62,0:19:20.16,Main,Luffy,0,0,0,,Küçülüyorum!
Dialogue: 0,0:19:48.38,0:19:50.64,Main,Franky,0,0,0,,O pisliği durdurduk, değil mi?
Dialogue: 0,0:19:51.50,0:19:53.88,Main,Usopp,0,0,0,,Öyle olmalı.
Dialogue: 0,0:19:56.06,0:19:59.02,Main,Nami,0,0,0,,Neredeyse tekrar hareket etmeye\Nbaşlayacakmış gibi görünüyor. Ürkütücü.
Dialogue: 0,0:20:00.76,0:20:03.26,Main,Usopp,0,0,0,,Hareket ederse bittik demektir.
Dialogue: 0,0:20:03.52,0:20:05.76,Main,Usopp,0,0,0,,Tamamen tükendim, kıpırdayamıyorum artık.
Dialogue: 0,0:20:05.98,0:20:09.16,Main,Chopper,0,0,0,,Belki de onunla dövüşmek\Nyerine kaçmalıydık.
Dialogue: 0,0:20:09.56,0:20:13.20,Main,Robin,0,0,0,,Hayır, yenebiliyorsak\Nyapmamız gereken yenmektir.
Dialogue: 0,0:20:13.58,0:20:15.64,Main,Robin,0,0,0,,Nereye gitsek peşimizden gelirdi.
Dialogue: 0,0:20:16.18,0:20:20.32,Main,Zoro,0,0,0,,Ama o adam neydi öyle?
Dialogue: 0,0:20:20.72,0:20:23.86,Main,Franky,0,0,0,,Kesinlikle modifiye bir insan.
Dialogue: 0,0:20:24.20,0:20:29.82,Main,Franky,0,0,0,,Bir zamanlar aynı Bartholomew Kuma'ya\Nbenzeyen bir adam olduğu anlamına gelir.
Dialogue: 0,0:20:30.46,0:20:36.24,Main,Franky,0,0,0,,İkiz olduklarını tahmin ediyorum veya bir yerde\Nonu çok benzeyen birini bulmuş olabilirler.
Dialogue: 0,0:20:36.50,0:20:38.50,Main,Franky,0,0,0,,Sanırım en mantıklı açıklaması bu.
Dialogue: 0,0:20:39.20,0:20:43.86,Main,Franky,0,0,0,,Sonuçta gerçekten bir insan\Nyapmış olmaları mümkün değil.
Dialogue: 0,0:20:46.36,0:20:48.76,Main,Sanji,0,0,0,,PX-4?
Dialogue: 0,0:20:50.74,0:20:52.28,Main,Luffy,0,0,0,,Biraz dinlenelim.
Dialogue: 0,0:20:52.42,0:20:56.72,Main,Luffy,0,0,0,,Bu kadar kısa süre sonra bir dövüşte \Nher şeyimizi kullanacağımızı hiç düşünmemiştim.
Dialogue: 0,0:20:57.06,0:21:01.02,Main,Sanji,0,0,0,,Ben de dinlenmek istiyorum ama\Nönce saklanacak bir yer bulmalıyız.
Dialogue: 0,0:21:01.52,0:21:05.30,Main,Sanji,0,0,0,,Şimdi bizi bulurlarsa\Nbaşımız büyük derde girer.
Dialogue: 0,0:21:06.30,0:21:07.38,Main,Luffy,0,0,0,,Sanırım doğru.
Dialogue: 0,0:21:07.64,0:21:08.32,Main,Luffy,0,0,0,,Ama...
Dialogue: 0,0:21:08.70,0:21:11.26,Main,Luffy,0,0,0,,...sadece biraz durun, tamam mı?
Dialogue: 0,0:21:13.74,0:21:16.88,Main,Sentoumaru,0,0,0,,Şimdi cidden çizgiyi aştınız!
Dialogue: 0,0:21:17.76,0:21:19.56,Main,Usopp,0,0,0,,Ne?! Başka bir düşman mı?!
Dialogue: 0,0:21:19.64,0:21:20.82,Main,Usopp,0,0,0,,O ses nereden geldi?!
Dialogue: 0,0:21:22.62,0:21:23.88,Main,Chopper,0,0,0,,Yukarıda! Yukarıdalar!
Dialogue: 0,0:21:34.60,0:21:35.42,Main,Luffy,0,0,0,,O da kim?!
Dialogue: 0,0:21:36.04,0:21:39.74,Main,Sentoumaru,0,0,0,,Hey, hey! Ne acınası bir durumdasın, PX-4!
Dialogue: 0,0:21:40.62,0:21:46.54,Main,Sentoumaru,0,0,0,,Pacifistalar'ın sadece birini bile yapmak,\Nsavaş gemisi kadar maliyetli oluyor!
Dialogue: 0,0:21:48.04,0:21:52.50,Main,Sentoumaru,0,0,0,,Cidden bunu kahrolası Punk'a\Nnasıl açıklayacağım şimdi?!
Dialogue: 0,0:21:53.27,0:21:56.27,Captions,,0,0,22,,{\fad(700,300)}Donanma Karargâhı\N\N\N\N\N\N\N\N\N\N\N\N\NBilim Devriyesi Kaptanı
Dialogue: 0,0:21:56.34,0:21:59.10,Captions,,0,0,200,,{\fad(450,0)}Sentoumaru
Dialogue: 0,0:22:06.12,0:22:08.16,Main,Chopper,0,0,0,,Bir Shichibukai daha!
Dialogue: 0,0:22:08.26,0:22:10.24,Main,Usopp,0,0,0,,Y-Yoksa o gerçeği mi?!
Dialogue: 0,0:22:10.68,0:22:12.92,Main,Sanji,0,0,0,,Gerçek veya sahte olması önemli değil.
Dialogue: 0,0:22:13.22,0:22:17.74,Main,Sanji,0,0,0,,Tekrardan o şeye karşı koyacak gücümüz yok!
Dialogue: 0,0:22:18.20,0:22:20.36,Main,Robin,0,0,0,,"Pacifista" dedi.
Dialogue: 0,0:22:21.40,0:22:24.56,Main,Nami,0,0,0,,"Pacifista"... \NHuzur sağlayan biri gibi, değil mi?
Dialogue: 0,0:22:26.14,0:22:28.46,Main,Nami,0,0,0,,Yendiğimizin ismi bu mu?
Dialogue: 0,0:22:28.58,0:22:30.68,Main,Franky,0,0,0,,Sen de kimsin, savaş baltası?!
Dialogue: 0,0:22:30.94,0:22:32.88,Main,Sentoumaru,0,0,0,,Bir adama silahının ismiyle seslenemezsin!
Dialogue: 0,0:22:33.26,0:22:35.34,Main,Sentoumaru,0,0,0,,Bana soru sormanın faydası yok.
Dialogue: 0,0:22:35.56,0:22:38.26,Main,Sentoumaru,0,0,0,,Size söyleyecek bir şeyim yok!
Dialogue: 0,0:22:38.64,0:22:41.16,Main,Sentoumaru,0,0,0,,Ben, dünyaki en sert gardı olan kişiyim!
Dialogue: 0,0:22:41.44,0:22:43.76,Main,Sentoumaru,0,0,0,,Elbette ağzım da sımsıkıdır!
Dialogue: 0,0:22:44.68,0:22:46.58,Main,Usopp,0,0,0,,En azından adını söyleyemez misin?!
Dialogue: 0,0:22:46.90,0:22:49.24,Main,Sentoumaru,0,0,0,,Buna cevap verme zorunluluğum yok!
Dialogue: 0,0:22:49.62,0:22:55.42,Main,Sentoumaru,0,0,0,,Demin söylemedim mi? Ben dünyanın\Nen sıkı ağızlı kişisi, Sentoumaru!
Dialogue: 0,0:22:56.08,0:22:58.36,Main,Usopp,0,0,0,,Öyle mi? Sentoumaru, değil mi?
Dialogue: 0,0:22:59.98,0:23:03.58,Main,Sentoumaru,0,0,0,,Sadece içimden söylemek geldi!
Dialogue: 0,0:23:03.76,0:23:06.20,Main,Sentoumaru,0,0,0,,Soruna cevap vermiyordum!
Dialogue: 0,0:23:07.02,0:23:09.30,Main,Sentoumaru,0,0,0,,Başlayalım, PX-1!
Dialogue: 0,0:23:21.88,0:23:24.04,Main,Sanji,0,0,0,,Avuçlarından da ışın atıyor.
Dialogue: 0,0:23:24.34,0:23:25.22,Main,Sanji,0,0,0,,Patileri yok.
Dialogue: 0,0:23:25.56,0:23:28.54,Main,Sanji,0,0,0,,Böyle düşünmek istemiyorum\Nama bu onu üçüncü yapıyor!
Dialogue: 0,0:23:28.72,0:23:29.64,Main,Sanji,0,0,0,,Neler oluyor?!
Dialogue: 0,0:23:29.88,0:23:32.92,Main,Zoro,0,0,0,,Bunu merak etmek yerine şimdi\Nkaçmamız daha güvenli olurdu!
Dialogue: 0,0:23:34.32,0:23:38.24,Main,Zoro,0,0,0,,Şimdi bir dövüşe daha girersek\Nbiri kesinlikle ölecek!
Dialogue: 0,0:23:38.60,0:23:40.70,Main,Zoro,0,0,0,,Amiralle karşılaşmadan önce kaçalım!
Dialogue: 0,0:23:40.82,0:23:41.48,Main,Luffy,0,0,0,,Evet.
Dialogue: 0,0:23:44.12,0:23:46.02,Main,Luffy,0,0,0,,Buradan kaçalım!
Dialogue: 0,0:23:46.56,0:23:49.08,Main,Luffy,0,0,0,,Bir arada kalamayız. Ayrılıp kaçacağız!
Dialogue: 0,0:23:56.46,0:23:58.82,Main,Usopp and Chopper,0,0,0,,Sanırım biz de kaçmalıyız!
Dialogue: 0,0:23:59.20,0:24:01.42,Main,Luffy,0,0,0,,Üçümüz ayrılmalıyız!
Dialogue: 0,0:24:01.76,0:24:04.22,Main,Sanji,0,0,0,,Tamam, iyi olacak mısın?
Dialogue: 0,0:24:04.38,0:24:05.14,Main,Zoro,0,0,0,,Kapa çeneni!
Dialogue: 0,0:24:05.78,0:24:08.72,Main,Sanji,0,0,0,,Nami-swan'ı koruyacağım!
Dialogue: 0,0:24:08.94,0:24:12.34,Main,Sanji,0,0,0,,Hayatım pahasına bile olsa!
Dialogue: 0,0:24:12.48,0:24:15.16,Main,Nami,0,0,0,,Tamam, sağol. Gidelim artık!
Dialogue: 0,0:24:16.02,0:24:20.06,Main,Franky,0,0,0,,Hayatını riske atmaya hazırsan,\Nhepimiz için yem olmalısın!
Dialogue: 0,0:24:20.20,0:24:22.34,Main,Sanji,0,0,0,,Sadece kadınlara, kahrolası pislik!
Dialogue: 0,0:24:22.60,0:24:25.46,Main,Sanji,0,0,0,,Sen kendinle ilgilen, külot adam!
Dialogue: 0,0:24:30.96,0:24:34.86,Main,Usopp,0,0,0,,Zoro-kun olabildiğince beni koruyacak,\Nbu yüzden endişelenme!
Dialogue: 0,0:24:34.92,0:24:37.90,Main,Zoro,0,0,0,,Dur biraz, Usopp! Yaralıyım.
Dialogue: 0,0:24:38.62,0:24:41.32,Main,Brook,0,0,0,,Endişelenmeyin! Sizi koruyacağım!
Dialogue: 0,0:24:41.70,0:24:44.32,Main,Brook,0,0,0,,Yaraların henüz iyileşmedi, değil mi?
Dialogue: 0,0:24:45.62,0:24:51.04,Main,Brook,0,0,0,,Aslında Thriller Bark'taki kendini\Nfeda etme tavrını gördüm!
Dialogue: 0,0:24:51.88,0:24:52.76,Main,Zoro,0,0,0,,Anlıyorum.
Dialogue: 0,0:24:53.26,0:24:54.14,Main,Zoro,0,0,0,,Sağol!
Dialogue: 0,0:24:54.62,0:24:56.60,Main,Luffy,0,0,0,,Oraya koşuyoruz!
Dialogue: 0,0:24:56.68,0:24:57.24,Main,Robin,0,0,0,,Tamam.
Dialogue: 0,0:24:57.36,0:24:59.16,Main,Chopper,0,0,0,,O ışınlar korkunç!
Dialogue: 0,0:24:59.24,0:25:01.96,Main,Luffy,0,0,0,,Arkadaşlar, üç gün sonra\NSunny'de buluşalım!
Dialogue: 0,0:25:02.36,0:25:03.86,Main,Sentoumaru,0,0,0,,Ayrılıp kaçıyorlar!
Dialogue: 0,0:25:03.90,0:25:05.34,Main,Sentoumaru,0,0,0,,Peşlerinden git, PX-1!
Dialogue: 0,0:25:06.00,0:25:09.28,Main,Sentoumaru,0,0,0,,12. Koru'dan çıkmalarına izin verme,\Nyoksa başımız derde girecek.
Dialogue: 0,0:25:09.80,0:25:12.02,Main,Usopp,0,0,0,,{\fad(150,150)}Kesin Öldürücü Süper Duman Yıldızı!
Dialogue: 0,0:25:15.36,0:25:17.24,Main,Usopp,0,0,0,,Şimdi fırsatımız var!
Dialogue: 0,0:25:18.36,0:25:19.76,Main,Brook,0,0,0,,Epey güvenilirsin!
Dialogue: 0,0:25:22.24,0:25:23.66,Main,Sanji,0,0,0,,Kahretsin! Köprü!
Dialogue: 0,0:25:24.90,0:25:25.82,Main,Sanji,0,0,0,,İşte geldi!
Dialogue: 0,0:25:28.24,0:25:29.50,Main,Nami,0,0,0,,Niye buraya geldi?!
Dialogue: 0,0:25:29.56,0:25:31.54,Main,Franky,0,0,0,,Hey, hey... Sen! Hey!
Dialogue: 0,0:25:32.12,0:25:33.04,Main,Franky,0,0,0,,Beni itme!
Dialogue: 0,0:25:34.16,0:25:36.32,Main,Luffy,0,0,0,,O tarafa mı gitti? İyiler mi?!
Dialogue: 0,0:25:38.48,0:25:40.90,Main,Sentoumaru,0,0,0,,Başkaları için endişelenecek zamanın yok!
Dialogue: 0,0:25:41.02,0:25:44.12,Main,Sentoumaru,0,0,0,,Gerçi korsanlarla bir alıp veremediğim yok.
Dialogue: 0,0:25:44.26,0:25:46.18,Main,Luffy,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:25:46.58,0:25:48.72,Main,Luffy,0,0,0,,{\fad(150,150)}...Mitralyöz!
Dialogue: 0,0:25:51.46,0:25:52.16,Main,Luffy,0,0,0,,Ne?!
Dialogue: 0,0:25:53.12,0:25:54.40,Main,Chopper,0,0,0,,Ne yaptı öyle?!
Dialogue: 0,0:25:54.62,0:25:57.00,Main,Sentoumaru,0,0,0,,Epey iyi saldırı gücün var ama...
Dialogue: 0,0:25:57.36,0:25:59.92,Main,Sentoumaru,0,0,0,,...gardım dünyanın en güçlüsüdür!
Dialogue: 0,0:26:00.15,0:26:02.15,Main,Sentoumaru,0,0,0,,{\fad(150,150)}Bacak Kilitlendi, Vira!
Dialogue: 0,0:26:03.22,0:26:03.98,Main,Robin,0,0,0,,Luffy!
Dialogue: 0,0:26:04.16,0:26:06.06,Main,Chopper,0,0,0,,Ne?! Bu da mı güçlü?!
Dialogue: 0,0:26:07.32,0:26:10.68,Main,Sentoumaru,0,0,0,,Söylemem gerektiğini düşündüm, \Nben Şeytan Meyvesi kullanıcısı değilim!
Dialogue: 0,0:26:12.50,0:26:14.52,Main,Luffy,0,0,0,,Tekniklerinde tuhaf bir şey var!
Dialogue: 0,0:26:26.96,0:26:28.56,Main,Usopp,0,0,0,,N-Ne?! Kimsin sen?!
Dialogue: 0,0:26:28.66,0:26:30.42,Main,Usopp,0,0,0,,Hemen uzaklaş!
Dialogue: 0,0:26:30.52,0:26:32.56,Main,Usopp,0,0,0,,Hemen Zoro'dan uzaklaş, seni ucube!
Dialogue: 0,0:26:32.64,0:26:34.10,Main,Brook,0,0,0,,Z-Z-Zoro-san!
Dialogue: 0,0:26:34.40,0:26:36.84,Main,Brook,0,0,0,,Zoro-san ışınla vuruldu!
Dialogue: 0,0:26:37.38,0:26:39.78,Main,Usopp,0,0,0,,Hey, Zoro! Kendine gel!
Dialogue: 0,0:26:40.40,0:26:42.22,Main,Sentoumaru,0,0,0,,Cidden gecikti!
Dialogue: 0,0:26:42.80,0:26:44.96,Main,Sentoumaru,0,0,0,,Demek sonunda geldin, yaşlı adam Kizaru?!
Dialogue: 0,0:26:46.04,0:26:46.88,Main,Robin,0,0,0,,Kizaru?!
Dialogue: 0,0:26:47.24,0:26:50.40,Main,Robin,0,0,0,,Dikkatli olun! O adam bir donanma amirali!
Dialogue: 0,0:26:52.26,0:26:53.50,Main,Brook,0,0,0,,Amiral mi?!
Dialogue: 0,0:26:55.18,0:26:58.14,Main,Kizaru,0,0,0,,Oh, biraz geç kaldın.
Dialogue: 0,0:26:58.76,0:27:04.24,Main,Kizaru,0,0,0,,120 milyon ödüllü, "Korsan Avcısı" Zoro.
Dialogue: 0,0:27:04.94,0:27:08.70,Main,Kizaru,0,0,0,,Oldukça başarılı bir kılıç ustası\Nolduğunu duymuştum...
Dialogue: 0,0:27:09.08,0:27:14.86,Main,Kizaru,0,0,0,,Ama bir vuruşta yenildiğine bakarsak\Nsanırım epey yorgunsun, ha?
Dialogue: 0,0:27:16.24,0:27:17.12,Main,Zoro,0,0,0,,Kahretsin...
Dialogue: 0,0:27:18.80,0:27:20.32,Main,Zoro,0,0,0,,O bir amiral mi...?
Dialogue: 0,0:27:20.82,0:27:24.26,Main,Kizaru,0,0,0,,Kendini iyice dinlendir.
Dialogue: 0,0:27:26.70,0:27:28.76,Main,Luffy,0,0,0,,Zoro!!!
Dialogue: 0,0:27:39.68,0:27:41.92,Main,Franky,0,0,0,,Hey, o da ışın atabiliyor!
Dialogue: 0,0:27:42.04,0:27:43.98,Main,Franky,0,0,0,,Durum kötü! Bir şey yapmalıyız!
Dialogue: 0,0:27:44.32,0:27:46.70,Main,Franky,0,0,0,,O kadar kısa mesafeden vurursa ölecek!
Dialogue: 0,0:27:47.56,0:27:50.00,Main,Luffy,0,0,0,,Olamaz! Zoro'nun başı dertte!
Dialogue: 0,0:27:58.20,0:28:00.44,Main,Luffy,0,0,0,,Usopp!
Dialogue: 0,0:28:02.04,0:28:04.50,Main,Usopp,0,0,0,,Sen! Kes şunu!
Dialogue: 0,0:28:09.86,0:28:11.64,Main,Usopp,0,0,0,,Kahretsin! Niye?!
Dialogue: 0,0:28:11.72,0:28:12.80,Main,Usopp,0,0,0,,Ona vuramıyorum!
Dialogue: 0,0:28:17.34,0:28:19.82,Main,Brook,0,0,0,,Ben de kılıç saplayamıyorum! Ne yapacağız?!
Dialogue: 0,0:28:20.92,0:28:21.46,Main,Usopp,0,0,0,,Kahretsin!
Dialogue: 0,0:28:22.94,0:28:23.46,Main,Usopp,0,0,0,,Pislik herif...
Dialogue: 0,0:28:23.86,0:28:25.58,Main,Usopp,0,0,0,,Çek bacağını!
Dialogue: 0,0:28:27.78,0:28:29.74,Main,Brook,0,0,0,,Lütfen çekil!
Dialogue: 0,0:28:30.02,0:28:31.56,Main,Kizaru,0,0,0,,Faydasız.
Dialogue: 0,0:28:32.18,0:28:35.18,Main,Kizaru,0,0,0,,Pika Pika meyvesi yediğim için ışık adamım.
Dialogue: 0,0:28:32.18,0:28:35.18,Note,Kizaru,0,0,0,,Pika: Işıltı, Parıltı
Dialogue: 0,0:28:35.34,0:28:37.58,Main,Kizaru,0,0,0,,Logia'yım.
Dialogue: 0,0:28:37.70,0:28:38.92,Main,Franky,0,0,0,,Işık adam mı?!
Dialogue: 0,0:28:39.58,0:28:41.86,Main,Nami,0,0,0,,Şaka bu, değil mi?! O ölecek!
Dialogue: 0,0:28:42.20,0:28:44.62,Main,Chopper,0,0,0,,Zoro! Kaç!
Dialogue: 0,0:28:45.14,0:28:47.32,Main,Chopper,0,0,0,,Zoro!
Dialogue: 0,0:28:49.76,0:28:52.82,Main,Zoro,0,0,0,,Bedenim kıpır...
Dialogue: 0,0:28:53.56,0:28:56.46,Main,Sanji,0,0,0,,Yararı yok! O adam zaten sınırına geldi!
Dialogue: 0,0:28:56.62,0:28:58.14,Main,Robin,0,0,0,,{\fad(150,150)}20 Çiçek!
Dialogue: 0,0:28:56.62,0:28:58.14,Note,Robin,0,0,0,,{\fad(150,150)}Veinte Fleur!
Dialogue: 0,0:29:03.16,0:29:05.32,Main,Usopp,0,0,0,,Tamam! Harika, Robin!
Dialogue: 0,0:29:19.28,0:29:21.94,Main,Kizaru,0,0,0,,Kaçmana izin vermeyeceğim.
Dialogue: 0,0:29:22.04,0:29:24.58,Main,Kizaru,0,0,0,,Faydasız.
Dialogue: 0,0:29:27.50,0:29:32.36,Main,Kizaru,0,0,0,,Şimdi öleceksin.
Dialogue: 0,0:29:47.88,0:29:50.50,Main,Kizaru,0,0,0,,Demek şimdi ortaya çıkmaya karar verdin,...
Dialogue: 0,0:29:50.50,0:29:53.44,Main,Kizaru,0,0,0,,..."Kara Kral" Rayleigh?
Dialogue: 0,0:29:53.44,0:29:56.61,Main,Rayleigh,0,0,0,,Bu gençlerin peşinden\Ngitmene izin vermeyeceğim.
Dialogue: 0,0:29:56.61,0:30:00.21,Main,Rayleigh,0,0,0,,Onların devri yeni başlıyor!
Dialogue: 0,0:30:01.30,0:30:03.85,Main,Luffy,0,0,0,,Amca!
