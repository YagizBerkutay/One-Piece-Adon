or,Impress BT,50,&H00FFFFFF,&H00FFFFFF,&H00000000,&H78000000,0,-1,0,0,100,100,0,0,1,1.5,1.5,2,120,120,18,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:31.89,0:00:37.27,Credits,,22,0,0,,Translation YibisDialogue: 0,0:00:31.89,0:00:37.27,Credits,,22,0,0,,Soundtracking HaleeDialogue: 0,0:00:37.38,0:00:42.14,Credits,,22,0,0,,Editing FeesoDialogue: 0,0:00:37.38,0:00:42.14,Credits,,22,0,0,,Infoboxes BernieCraneDialogue: 0,0:00:37.38,0:00:42.14,Credits,,22,0,0,,Formatting Sewil DatenshiDialogue: 0,0:00:37.38,0:00:42.14,Credits,,22,0,0,,Edit-checking Galaxy 9000Dialogue: 0,0:00:05.30,0:00:09.17,Lyrics,,0,0,0,,♪ Gökyüzüne ulaşana kadar, ♪Dialogue: 0,0:00:09.27,0:00:15.71,Lyrics,,0,0,0,,♪ İnanıyorum, sonraki yarına kadar, hey ♪Dialogue: 0,0:00:15.73,0:00:19.13,Lyrics,,0,0,0,,♪ hadi millet gidelim, müziği paylaşıyoruz. ♪Dialogue: 0,0:00:19.96,0:00:23.36,Lyrics,,0,0,0,,♪ hadi gidelim bebeğim, bebeğim, oh tek bir hayali paylaşıyoruz. ♪Dialogue: 0,0:00:23.88,0:00:27.28,Lyrics,,0,0,0,,♪ hadi millet gidelim, oh iyi zamanları paylaşıyoruz. ♪Dialogue: 0,0:00:27.71,0:00:31.11,Lyrics,,0,0,0,,♪ hadi gidelim bebeğim, bebeğim, oh tek bir dünyayı paylaşıyoruz. ♪Dialogue: 0,0:00:31.81,0:00:35.55,Lyrics,,0,0,0,,♪ Mobius yüzüğünün tepesinde kovalıyor ve kovalanıyor. ♪Dialogue: 0,0:00:35.58,0:00:39.35,Lyrics,,0,0,0,,♪ Yaklaşıyor ve ileri bakıyorum, hey tarzını paylaşmak istiyorum. ♪Dialogue: 0,0:00:39.52,0:00:43.45,Lyrics,,0,0,0,,♪ Başlıyor, genişliyor, hayal gücünün üstündeki bu tat. ♪Dialogue: 0,0:00:43.52,0:00:47.76,Lyrics,,0,0,0,,♪ Vücudumu baştan başa iyi hissediyorum, özgür kalacağım, oh evet ♪Dialogue: 0,0:00:47.79,0:00:49.79,Lyrics,,0,0,0,,♪ Uzakta olsa da, müziği paylaş. ♪Dialogue: 0,0:00:49.79,0:00:51.73,Lyrics,,0,0,0,,♪ Birbirine anlatarak o rüyayı paylaş. ♪Dialogue: 0,0:00:51.76,0:00:53.60,Lyrics,,0,0,0,,♪ İyi zamanları ve kahkahaları paylaş. ♪Dialogue: 0,0:00:53.72,0:00:55.27,Lyrics,,0,0,0,,♪ şimdi tek bir dünyayı paylaş. ♪Dialogue: 0,0:00:55.45,0:01:03.74,Lyrics,,0,0,0,,♪ Gökyüzüne ulaşana kadar gitmeye devam edeceğim. ♪Dialogue: 0,0:01:03.81,0:01:13.05,Lyrics,,0,0,0,,♪ Hadi üstesinden gelelim, sonraki yarınlara inanıyorum, evet evet... ♪Dialogue: 0,0:01:13.15,0:01:21.56,Lyrics,,0,0,0,,♪ Görünmez duvarın diğer tarafında bekliyordun. ♪Dialogue: 0,0:01:21.66,0:01:31.62,Lyrics,,0,0,0,,♪ Yakında orada olacağım, tek bir dünyaya inanıyorum, evet evet... ♪Dialogue: 0,0:01:31.64,0:01:35.04,Lyrics,,0,0,0,,♪ hadi millet gidelim, müziği paylaşıyoruz. ♪Dialogue: 0,0:01:35.67,0:01:39.87,Lyrics,,0,0,0,,♪ hadi gidelim bebeğim, bebeğim, oh tek bir dünyayı paylaşıyoruz. ♪Dialogue: 0,0:01:39.95,0:01:44.38,Captions,,0,0,250,,Sabaody Takımadaları 13. KoruDialogue: 0,0:01:45.04,0:01:48.69,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:11:25.00,0:11:35.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:22:26.60,0:22:29.50,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:01:45.04,0:01:48.69,Title,,0,0,240,,Kizaru GelirDialogue: 0,0:01:49.06,0:01:52.35,Main,Rayleigh,0,0,0,,O zamandan beri Monkey D. Luffy,...Dialogue: 0,0:01:52.69,0:01:54.79,Main,Rayleigh,0,0,0,,...bir gün seninle tanışmak istiyordum.Dialogue: 0,0:02:00.33,0:02:01.55,Main,Luffy,0,0,0,,Shanks...!Dialogue: 0,0:02:02.01,0:02:05.05,Main,Rayleigh,0,0,0,,Shanks bana senin hakkında o kadar çok şey anlatmasaydı,...Dialogue: 0,0:02:05.08,0:02:07.51,Main,Rayleigh,0,0,0,,...ben de sana bunların hiçbirini anlatmazdım.Dialogue: 0,0:02:07.91,0:02:10.61,Main,Rayleigh,0,0,0,,Neyse, buraya kadar gelerek iyi iş çıkardın.Dialogue: 0,0:02:11.11,0:02:14.37,Main,Rayleigh,0,0,0,,Senin Yeni Dünya'ya gelişini bekliyor olmalı.Dialogue: 0,0:02:14.96,0:02:16.25,Main,Luffy,0,0,0,,Gerçekten mi?Dialogue: 0,0:02:16.51,0:02:18.15,Main,Luffy,0,0,0,,Evet, öyle olmalı!Dialogue: 0,0:02:18.51,0:02:20.43,Main,Luffy,0,0,0,,Ben de onu görmek istiyorum!Dialogue: 0,0:02:22.35,0:02:24.27,Main,Rayleigh,0,0,0,,Pekâlâ, durum böyle işte.Dialogue: 0,0:02:24.35,0:02:26.79,Main,Rayleigh,0,0,0,,Geminizi kaplamam gerekiyordu, değil mi?Dialogue: 0,0:02:27.91,0:02:31.44,Main,Hachi,0,0,0,,Sahi, gemi kaplatmak için çok para gerekiyor.Dialogue: 0,0:02:31.63,0:02:33.07,Main,Rayleigh,0,0,0,,Hayır, sorun değil, Hachi.Dialogue: 0,0:02:33.27,0:02:35.47,Main,Rayleigh,0,0,0,,Arkadaşlarından para almayacağım.Dialogue: 0,0:02:35.65,0:02:36.65,Main,Hachi,0,0,0,,Memnun oldum.Dialogue: 0,0:02:36.65,0:02:38.09,Main,Hachi,0,0,0,,Sağol, Rayleigh.Dialogue: 0,0:02:39.25,0:02:41.76,Main,Usopp,0,0,0,,Pek anlamıyorum ama bedavaya yapacak olması harika!Dialogue: 0,0:02:41.89,0:02:43.50,Main,Sanji,0,0,0,,Sağol!Dialogue: 0,0:02:43.73,0:02:45.15,Main,Sanji,0,0,0,,Gerçekten cömertsin!Dialogue: 0,0:02:45.72,0:02:46.64,Main,Robin,0,0,0,,Rayleigh-san...Dialogue: 0,0:02:47.87,0:02:48.91,Main,Robin,0,0,0,,Bir sorum var.Dialogue: 0,0:02:52.05,0:02:54.65,Main,Robin,0,0,0,,"D'nin Arzusu" tam olarak nedir?Dialogue: 0,0:02:56.49,0:02:58.37,Main,Robin,0,0,0,,Gökyüzü Adası'nda gördüğüm poneglife...Dialogue: 0,0:02:58.49,0:03:01.57,Main,Robin,0,0,0,,...antik dilde Roger'ın adı kazınmıştı.Dialogue: 0,0:03:02.36,0:03:05.15,Main,Robin,0,0,0,,O harfleri nasıl bilebilir?Dialogue: 0,0:03:05.72,0:03:09.91,Flashbacks,Roger,0,0,0,,Buraya geldim ve bu sözleri sona götüreceğim.Dialogue: 0,0:03:10.37,0:03:12.38,Flashbacks,Roger,0,0,0,,Korsan Gol D. Roger.Dialogue: 0,0:03:13.34,0:03:19.33,Main,Robin,0,0,0,,900 yıl önceki "kayıp yüzyıl"da neler olduğunu biliyor musunuz?Dialogue: 0,0:03:25.15,0:03:26.95,Main,Rayleigh,0,0,0,,Evet, biliyoruz.Dialogue: 0,0:03:29.82,0:03:33.15,Main,Rayleigh,0,0,0,,Tüm tarihi öğrendik.Dialogue: 0,0:03:35.81,0:03:37.23,Main,Rayleigh,0,0,0,,Ama genç bayan,...Dialogue: 0,0:03:37.63,0:03:39.21,Main,Rayleigh,0,0,0,,...acele etme.Dialogue: 0,0:03:40.19,0:03:43.39,Main,Rayleigh,0,0,0,,Lütfen geminizle adım adım ilerleyin.Dialogue: 0,0:03:43.75,0:03:49.37,Main,Rayleigh,0,0,0,,Belki de Ohara kadar biz de çok sabırsızdık.Dialogue: 0,0:03:50.77,0:03:55.13,Main,Rayleigh,0,0,0,,Burada sana tüm tarihi anlatsaydım bile...Dialogue: 0,0:03:55.50,0:03:58.28,Main,Rayleigh,0,0,0,,...şu anki durumunda hiçbir şey yapamazdın.Dialogue: 0,0:03:58.56,0:04:00.92,Main,Rayleigh,0,0,0,,Dünyayı iyice gördükten sonra...Dialogue: 0,0:04:00.92,0:04:05.36,Main,Rayleigh,0,0,0,,...ulaşacağın sonuç bizimkinden farklı olabilir.Dialogue: 0,0:04:05.88,0:04:12.40,Main,Rayleigh,0,0,0,,Yine de duymak istiyorsan dünyayla ilgili her şeyi sana şimdi anlatacağım.Dialogue: 0,0:04:15.75,0:04:17.83,Main,Robin,0,0,0,,Hayır, anlatmayın.Dialogue: 0,0:04:18.61,0:04:20.07,Main,Robin,0,0,0,,Yolculuğa devam edeceğim.Dialogue: 0,0:04:21.03,0:04:23.54,Main,Rayleigh,0,0,0,,Hepsini eninde sonunda göreceksin.Dialogue: 0,0:04:24.11,0:04:27.51,Main,Rayleigh,0,0,0,,Memleketin Ohara'ya olanlar çok kötü.Dialogue: 0,0:04:28.89,0:04:32.35,Main,Rayleigh,0,0,0,,Ama Roger, aslında o harfleri okuyamıyordu.Dialogue: 0,0:04:33.51,0:04:35.51,Main,Rayleigh,0,0,0,,Biz korsandık.Dialogue: 0,0:04:35.51,0:04:40.59,Main,Rayleigh,0,0,0,,Dahi Clover veya diğer Oharalılar'ın zekasıyla kıyaslanmamız mümkün değildi.Dialogue: 0,0:04:40.59,0:04:42.19,Main,Rayleigh,0,0,0,,O,...Dialogue: 0,0:04:42.19,0:04:45.13,Main,Rayleigh,0,0,0,,..."her şeyin sesi"ni duyabiliyordu.Dialogue: 0,0:04:45.13,0:04:47.03,Main,Rayleigh,0,0,0,,Hepsi bu.Dialogue: 0,0:04:49.40,0:04:51.21,Main,Usopp,0,0,0,,Hey, emin misin, Robin?Dialogue: 0,0:04:51.21,0:04:54.17,Main,Usopp,0,0,0,,Büyük bir fırsatı kaçırmadın mı?!Dialogue: 0,0:04:54.17,0:04:55.27,Main,Usopp,0,0,0,,Hey, amca!Dialogue: 0,0:04:55.27,0:04:57.13,Main,Usopp,0,0,0,,Ben de bir şey sormak istiyorum!Dialogue: 0,0:04:57.13,0:04:59.61,Main,Usopp,0,0,0,,Efsanevi hazine One Piece...Dialogue: 0,0:04:59.61,0:05:00.53,Main,Usopp,0,0,0,,...gerçekten...Dialogue: 0,0:05:00.53,0:05:05.17,Main,Luffy,0,0,0,,Usopp!!!Dialogue: 0,0:05:11.69,0:05:14.23,Main,Luffy,0,0,0,,Hazinenin nerede olduğunu duymak istemiyorum!Dialogue: 0,0:05:14.23,0:05:16.56,Main,Luffy,0,0,0,,Hazine var mı, yok mu onu bile bilmek istemiyorum!Dialogue: 0,0:05:16.97,0:05:21.47,Main,Luffy,0,0,0,,Bu konuda hiçbir şey bilmiyorum ama herkes kendi öğrenmek için denize açılıyor!Dialogue: 0,0:05:21.83,0:05:26.17,Main,Luffy,0,0,0,,Amca bize bir şey anlatsaydı, Korsanlar Kralı olmaktan vazgeçerdim!Dialogue: 0,0:05:26.91,0:05:29.71,Main,Luffy,0,0,0,,Öyle sıkıcı bir maceramız olacaksa, ben yokum!Dialogue: 0,0:05:31.71,0:05:33.31,Main,Usopp,0,0,0,,Ah, anladım!Dialogue: 0,0:05:33.31,0:05:34.53,Main,Usopp,0,0,0,,Anladım!Dialogue: 0,0:05:34.65,0:05:36.59,Main,Usopp,0,0,0,,Üzgünüm, ağzımdan kaçtı!Dialogue: 0,0:05:36.67,0:05:38.52,Main,Usopp,0,0,0,,Ben de hiçbir şey duymak istemiyorum!Dialogue: 0,0:05:38.52,0:05:39.73,Main,Usopp,0,0,0,,Oh, sahi!Dialogue: 0,0:05:39.73,0:05:42.07,Main,Usopp,0,0,0,,"One Piece hakkında bir şey duyarsam öleceğim" hastalığına tutuldum!Dialogue: 0,0:05:42.07,0:05:44.87,Main,Usopp,0,0,0,,Amca, bu yüzden bir şey söylemeye kalkma!Dialogue: 0,0:05:46.45,0:05:48.89,Main,Rayleigh,0,0,0,,Yapabilir misin?Dialogue: 0,0:05:49.61,0:05:54.41,Main,Rayleigh,0,0,0,,Grand Line, hayal edebileceğin her şeyin ötesine uzanıyor.Dialogue: 0,0:05:54.41,0:05:56.03,Main,Rayleigh,0,0,0,,Düşmanlar da güçlü olacak.Dialogue: 0,0:05:56.39,0:05:59.90,Main,Rayleigh,0,0,0,,Böyle ürkütücü bir denizi fethedebilir misin?Dialogue: 0,0:06:10.09,0:06:12.49,Main,Luffy,0,0,0,,Hiçbir şeyi fethetmek istediğim falan yok!Dialogue: 0,0:06:12.49,0:06:15.62,Main,Luffy,0,0,0,,Korsanlar Kralı, sadece denizde en özgür olan kişidir!Dialogue: 0,0:06:20.89,0:06:22.06,Main,Rayleigh,0,0,0,,Anlıyorum.Dialogue: 0,0:06:22.57,0:06:26.03,Main,Shakki,0,0,0,,Gerçekten büyük bir hayranınım, Monkey-chan.Dialogue: 0,0:06:26.03,0:06:29.05,Main,Rayleigh,0,0,0,,Gemi 41. Koru'da, değil mi?Dialogue: 0,0:06:29.05,0:06:31.71,Main,Rayleigh,0,0,0,,Oraya gideceğim.Dialogue: 0,0:06:31.71,0:06:33.11,Main,Rayleigh,0,0,0,,Ya siz?Dialogue: 0,0:06:33.11,0:06:35.95,Main,Rayleigh,0,0,0,,Amiral hâlâ adaya geliyor, biliyorsun.Dialogue: 0,0:06:35.95,0:06:38.53,Main,Nami,0,0,0,,Burada kalırsak sıkıntı oluştururuz.Dialogue: 0,0:06:38.53,0:06:40.01,Main,Nami,0,0,0,,Başka bir yere gidelim.Dialogue: 0,0:06:40.01,0:06:40.93,Main,Nami,0,0,0,,Alışveriş yapalım!Dialogue: 0,0:06:40.97,0:06:42.53,Main,Usopp,0,0,0,,Aklını mı kaçırdın sen?!Dialogue: 0,0:06:42.63,0:06:44.79,Main,Usopp,0,0,0,,Kovalandığımız için saklanmalıyız!Dialogue: 0,0:06:44.97,0:06:45.95,Main,Franky,0,0,0,,Haklı.Dialogue: 0,0:06:46.13,0:06:49.29,Main,Franky,0,0,0,,Bir arada kalırsak insanlar muhtemelen peşimizden gelecek.Dialogue: 0,0:06:49.83,0:06:54.55,Main,Franky,0,0,0,,Daha kolay bir şekilde kaçabilmek için şehirden ayrılmamız daha iyi olur.Dialogue: 0,0:06:54.69,0:06:59.09,Main,Zoro,0,0,0,,O zaman rastgele gruplar hâlinde ayrılacağız ve o işini bitirdiğinde orada buluşacağız, değil mi?Dialogue: 0,0:06:59.91,0:07:02.23,Main,Sanji,0,0,0,,Toplanmaktan bir plan gibi bahsetmek...Dialogue: 0,0:07:02.35,0:07:03.71,Main,Sanji,0,0,0,,...kimin ağzından çıktı?Dialogue: 0,0:07:04.23,0:07:06.07,Main,Rayleigh,0,0,0,,Shakki, sende var, değil mi?Dialogue: 0,0:07:06.31,0:07:08.65,Main,Shakki,0,0,0,,Evet, bir tane var.Dialogue: 0,0:07:09.59,0:07:11.49,Main,Nami,0,0,0,,Bu, Yaşam Kartı!Dialogue: 0,0:07:11.67,0:07:14.21,Main,Rayleigh,0,0,0,,Oh, biliyorsanız daha kolay olacak.Dialogue: 0,0:07:14.43,0:07:16.53,Main,Rayleigh,0,0,0,,Ben de aranan bir adamım.Dialogue: 0,0:07:16.89,0:07:21.03,Main,Rayleigh,0,0,0,,Bu yüzden sanırım gemiyi 41. Koru'dan alıp başka bir yerde çalışacağım.Dialogue: 0,0:07:21.65,0:07:23.91,Main,Rayleigh,0,0,0,,Kaplama üç gün kadar sürer.Dialogue: 0,0:07:24.65,0:07:26.07,Main,Luffy,0,0,0,,Üç gün mü sürüyor?Dialogue: 0,0:07:26.23,0:07:29.01,Main,Rayleigh,0,0,0,,Canlarınız benim işçiliğime bağlı, bu yüzden en hızlı olarak bu süre içinde yapabilirim.Dialogue: 0,0:07:29.75,0:07:32.41,Main,Brook,0,0,0,,Demek üç gün boyunca hayatta kalmalıyız.Dialogue: 0,0:07:33.53,0:07:34.03,Main,Brook,0,0,0,,Korkutucu!Dialogue: 0,0:07:34.63,0:07:36.85,Main,Rayleigh,0,0,0,,Üç gün sonra gün batımı diyelim mi?Dialogue: 0,0:07:37.35,0:07:40.51,Main,Rayleigh,0,0,0,,Hangi Koru'da olacağımdan emin değilim...Dialogue: 0,0:07:40.77,0:07:45.37,Main,Rayleigh,0,0,0,,...ama Yaşam Kartı'nı takip edin, gemiyi kaplamış olarak sizi bekliyor olacağım.Dialogue: 0,0:07:46.69,0:07:49.22,Main,Rayleigh,0,0,0,,Balık Adam Adası'na giderken yapacağınız su altı yolculuğu...Dialogue: 0,0:07:49.24,0:07:51.55,Main,Rayleigh,0,0,0,,...sırasında ihtiyaç duyacaklarınızı alsanız iyi olur.Dialogue: 0,0:07:52.15,0:07:54.95,Main,Caimie,0,0,0,,Luffy-chin, hepinize çok teşekkür ederim!Dialogue: 0,0:07:55.05,0:07:56.97,Main,Pappagg,0,0,0,,Gerçekten sağolun!Dialogue: 0,0:07:57.45,0:08:00.87,Main,Hachi,0,0,0,,Hepsi benim yüzümden oldu, üzgünüm!Dialogue: 0,0:08:00.95,0:08:06.11,Main,Hachi,0,0,0,,Minnettarlığımı göstermek için size Balık Adam Adası'na  giden yolu göstereceğiz, endişe etmeyin!Dialogue: 0,0:08:06.21,0:08:08.61,Main,Hachi,0,0,0,,Üç gün boyunca donanmaya dikkat edin!Dialogue: 0,0:08:08.69,0:08:10.89,Main,Chopper,0,0,0,,Hachi, sağlığına dikkat et.Dialogue: 0,0:08:11.05,0:08:12.67,Main,Shakki,0,0,0,,Üç gün sonra tekrar görüşelim.Dialogue: 0,0:08:13.09,0:08:14.73,Main,Shakki,0,0,0,,Sizi uğurlamak için orada olacağım, tamam mı?Dialogue: 0,0:08:14.91,0:08:16.51,Main,Luffy,0,0,0,,Görüşürüz, nine!Dialogue: 0,0:08:18.35,0:08:19.83,Main,Luffy,0,0,0,,Bir amiral ile karşı karşıyayız!Dialogue: 0,0:08:19.95,0:08:21.89,Main,Luffy,0,0,0,,Hiçbirimizin ölmeyeceğinden emin olmalıyız, ha?Dialogue: 0,0:08:21.99,0:08:24.61,Main,Usopp,0,0,0,,Öyle korkutucu şeyler söyleme!Dialogue: 0,0:08:26.41,0:08:27.61,Main,Franky,0,0,0,,Üç gün, ha?Dialogue: 0,0:08:27.95,0:08:29.11,Main,Luffy,0,0,0,,Gidelim o zaman.Dialogue: 0,0:08:29.15,0:08:30.25,Main,Luffy,0,0,0,,Lunaparka!Dialogue: 0,0:08:30.31,0:08:30.93,Main,Crew,0,0,0,,Hey!Dialogue: 0,0:08:34.69,0:08:36.67,Main,Caimie,0,0,0,,Dikkatli olun!Dialogue: 0,0:08:36.99,0:08:39.31,Main,Pappagg,0,0,0,,Fazla pervasızlık yapmayın!Dialogue: 0,0:08:40.93,0:08:43.45,Main,Usopp,0,0,0,,Evet, siz de!Dialogue: 0,0:08:43.53,0:08:45.43,Main,Chopper,0,0,0,,Hachi'yi size emanet ediyorum!Dialogue: 0,0:08:47.47,0:08:49.53,Main,Rayleigh,0,0,0,,Sanırım ben de gitmeliyim.Dialogue: 0,0:08:49.87,0:08:51.53,Main,Luffy,0,0,0,,Evet, sana güveniyorum!Dialogue: 0,0:08:57.53,0:08:58.93,Main,Franky,0,0,0,,Ama böyle bir yerde...Dialogue: 0,0:08:59.23,0:09:02.85,Main,Franky,0,0,0,,...Korsanlar Kralı'nın tayfasından biriyle karşılaşacağımızı kim düşünürdü ki?Dialogue: 0,0:09:03.19,0:09:04.43,Main,Franky,0,0,0,,Şaşırdım.Dialogue: 0,0:09:06.06,0:09:10.85,Main,Franky,0,0,0,,Nasıl desem... Özellikle yaşlı adam gerçekten bir etki bıraktı.Dialogue: 0,0:09:11.02,0:09:15.75,Main,Usopp,0,0,0,,Evet, sonuçta Roger'ın tayfasındaki en meşhur kişi.Dialogue: 0,0:09:17.09,0:09:20.15,Main,Franky,0,0,0,,Demek Oro Jackson'daki bir tayfaydı, ha?Dialogue: 0,0:09:20.61,0:09:23.96,Flashbacks,Tom,0,0,0,,Roger adındaki bir adama yardım ettim...Dialogue: 0,0:09:25.47,0:09:26.99,Main,Franky,0,0,0,,Onunla karşılaştığıma sevindim.Dialogue: 0,0:09:28.77,0:09:31.85,Main,Usopp,0,0,0,,Büyüklerine saygı duyan biri misin?Dialogue: 0,0:09:32.59,0:09:34.75,Main,Franky,0,0,0,,Zaman zaman olur!Dialogue: 0,0:09:36.13,0:09:36.79,Main,Luffy,0,0,0,,Hey...Dialogue: 0,0:09:39.25,0:09:40.77,Main,Luffy,0,0,0,,Niye lunaparka gitmiyoruz?Dialogue: 0,0:09:40.93,0:09:42.47,Main,Franky and Usopp,0,0,0,,Kapar mısın çeneni?!Dialogue: 0,0:09:43.05,0:09:44.29,Main,Chopper and Brook,0,0,0,,Gitmek istiyorum.Dialogue: 0,0:09:44.82,0:09:46.26,Main,Franky and Usopp,0,0,0,,Siz de mi?!Dialogue: 0,0:09:46.26,0:09:49.34,Captions,,0,880,16,,Sabaody Takımadaları                   27. Koru LimanıDialogue: 0,0:09:49.58,0:09:51.28,Main,Pirate,0,0,0,,Bu, Amiral Kizaru!Dialogue: 0,0:09:51.46,0:09:53.36,Main,Pirate,0,0,0,,Kaçmamız lazım!Dialogue: 0,0:09:53.60,0:09:55.56,Main,Marine,0,0,0,,Korsanları yakalayın!Dialogue: 0,0:09:57.24,0:09:58.64,Main,Kizaru,0,0,0,,Merhaba?Dialogue: 0,0:09:58.81,0:10:00.78,Main,Marine,0,0,0,,Etrafta çok fazla aranan korsan var!Dialogue: 0,0:10:00.86,0:10:02.74,Main,Marine,0,0,0,,Ödülü 100 milyonu geçenleri arayın!Dialogue: 0,0:10:02.78,0:10:05.30,Main,Pirates,0,0,0,,Kaçın!Dialogue: 0,0:10:05.94,0:10:10.18,Main,Kizaru,0,0,0,,Merhaba? Ben Kizaru.Dialogue: 0,0:10:10.82,0:10:13.66,Main,Kizaru,0,0,0,,Cidden tuhaf.Dialogue: 0,0:10:14.44,0:10:18.13,Captions,,0,0,20,,Donanma Karargâhı Amirali           "Kizaru" (Gerçek adı: Borsalino)Dialogue: 0,0:10:15.18,0:10:17.72,Main,Kizaru,0,0,0,,Merhaba?Dialogue: 0,0:10:18.54,0:10:21.16,Main,Kizaru,0,0,0,,Ne garip...Dialogue: 0,0:10:21.65,0:10:23.64,Main,Pirate 1,0,0,0,,Bu gerçekten kötü!Dialogue: 0,0:10:23.76,0:10:25.36,Main,Pirate 2,0,0,0,,Eğer...Dialogue: 0,0:10:26.04,0:10:30.64,Main,Pirate 2,0,0,0,,Eğer onu vursaydım bir anda ünlenirdim!Dialogue: 0,0:10:31.48,0:10:35.21,Main,Pirate 1,0,0,0,,Aptallık etme! O, donanmanın en güçlü savaşçılarından biri!Dialogue: 0,0:10:38.90,0:10:40.50,Main,Pirate 2,0,0,0,,Şimdi! Seni...Dialogue: 0,0:10:40.60,0:10:40.90,Main,Pirate 1,0,0,0,,Kes şunu!Dialogue: 0,0:10:46.02,0:10:47.58,Main,Kizaru,0,0,0,,Merhaba?Dialogue: 0,0:10:47.68,0:10:49.66,Main,Pirate 2,0,0,0,,Ne?! Hey, vurduğuma eminim!Dialogue: 0,0:10:49.78,0:10:52.06,Main,Pirate 2,0,0,0,,Kesinlikle kafasından geçip gitti!Dialogue: 0,0:10:52.54,0:10:54.88,Main,Kizaru,0,0,0,,Gerçekten tuhaf...Dialogue: 0,0:10:55.16,0:10:57.40,Main,Pirate 1,0,0,0,,Bir tür yeteneği olduğu belli!Dialogue: 0,0:10:57.62,0:10:59.08,Main,Pirate 1,0,0,0,,Silahın işe yaraması mümkün değil!Dialogue: 0,0:10:59.20,0:11:00.05,Main,Pirate 1,0,0,0,,Kaç!Dialogue: 0,0:11:05.08,0:11:08.50,Main,Kizaru,0,0,0,,Bir soru sormak istiyorum.Dialogue: 0,0:11:11.08,0:11:15.09,Main,Kizaru,0,0,0,,Sentoumaru adında bir adamı arıyorum.Dialogue: 0,0:11:16.16,0:11:19.19,Main,Kizaru,0,0,0,,O adam benim emrimde.Dialogue: 0,0:11:20.44,0:11:23.76,Main,Kizaru,0,0,0,,Cidden sadece soru soruyordum.Dialogue: 0,0:11:59.12,0:12:02.02,Main,Marine 1,0,0,0,,Sence Kizaru-san'ın yaptığı aşırı olmadı mı?Dialogue: 0,0:12:02.16,0:12:05.20,Main,Marine 2,0,0,0,,Yarukiman Mangrovu'nu yok edemezsin!Dialogue: 0,0:12:06.68,0:12:10.88,Main,Kizaru,0,0,0,,Galiba abarttım.Dialogue: 0,0:12:11.42,0:12:13.16,Main,Apoo,0,0,0,,Tamamen mahvetti.Dialogue: 0,0:12:13.24,0:12:14.98,Main,Apoo,0,0,0,,Demek Amiral Kizaru o?Dialogue: 0,0:12:15.22,0:12:18.00,Main,Pirate,0,0,0,,Apoo-san! Bizim de başımız dertte!Dialogue: 0,0:12:18.16,0:12:19.70,Main,Pirate,0,0,0,,Kaçmalıyız!Dialogue: 0,0:12:20.20,0:12:21.54,Main,Apoo,0,0,0,,Tam bir aptalsın.Dialogue: 0,0:12:22.58,0:12:24.58,Main,Apoo,0,0,0,,Sadece kaçmanın eğlencesi nerede?Dialogue: 0,0:12:24.68,0:12:27.46,Main,Apoo,0,0,0,,Gitmeden önce düşmanı kızdırmalıyız.Dialogue: 0,0:12:27.64,0:12:28.92,Main,Pirate,0,0,0,,Ne yapmayı planlıyorsun?!Dialogue: 0,0:12:30.90,0:12:32.91,Main,Marine 4,0,0,0,,Limana destek istiyorum!Dialogue: 0,0:12:33.23,0:12:34.00,Main,Marine 2,0,0,0,,Ne oldu?Dialogue: 0,0:12:34.12,0:12:35.38,Main,Marine 4,0,0,0,,Bilmiyorum!Dialogue: 0,0:12:35.58,0:12:38.90,Main,Marine 4,0,0,0,,Hiçbir fikrim yok ama tüm birliklerimiz...Dialogue: 0,0:12:39.05,0:12:41.52,Main,Marine 4,0,0,0,,...çocuklara veya yaşlı adamlara dönüştü!Dialogue: 0,0:12:41.66,0:12:43.34,Main,Marine-kid,0,0,0,,Neler oluyor?!Dialogue: 0,0:12:44.60,0:12:46.01,Main,Old marine-guy,0,0,0,,Sırtım beni öldürüyor.Dialogue: 0,0:12:49.98,0:12:51.02,Main,Bonney,0,0,0,,Bu klasik!Dialogue: 0,0:12:52.92,0:12:54.80,Main,Marine,0,0,0,,Bu, onun işi!Dialogue: 0,0:12:55.45,0:12:59.76,Main,Marine,0,0,0,,140 milyon ödüllü Jewelry Bonney!Dialogue: 0,0:13:01.10,0:13:03.14,Main,Marine,0,0,0,,Tekrar ediyorum, ödülü 100 milyonun üstündeki çaylaklara dikkat edin!Dialogue: 0,0:13:03.26,0:13:04.08,Main,Marine 2,0,0,0,,Seni köpek!Dialogue: 0,0:13:04.22,0:13:08.18,Main,Marine 2,0,0,0,,Başına 138 milyon konulan Capone "Çete" Bege'sin, değil mi?!Dialogue: 0,0:13:08.34,0:13:10.20,Main,Marine 3,0,0,0,,Asla denize ulaşamayacaksın!Dialogue: 0,0:13:11.84,0:13:14.02,Main,Marine 4,0,0,0,,Adamlarına ne oldu?!  Kendi başlarına mı hareket ediyorlar?!Dialogue: 0,0:13:14.10,0:13:16.58,Main,Marine 5,0,0,0,,Ne şanssız bir adamsın. Teslim ol!Dialogue: 0,0:13:18.92,0:13:20.80,Main,Bege,0,0,0,,Mesele askeri güç olduğunda...Dialogue: 0,0:13:20.92,0:13:22.48,Main,Bege,0,0,0,,...sizi yendim sayın!Dialogue: 0,0:13:22.90,0:13:27.90,Main,Kizaru,0,0,0,,Oh, bir şey sormak istiyordum.Dialogue: 0,0:13:29.14,0:13:30.14,Main,Pirate,0,0,0,,K-Kizaru!Dialogue: 0,0:13:30.28,0:13:31.88,Main,Pirate,0,0,0,,B-Bununla biz ilgileniriz.Dialogue: 0,0:13:32.18,0:13:33.94,Main,Pirate 2,0,0,0,,Kaptan, lütfen kaçın!Dialogue: 0,0:13:35.49,0:13:36.81,Main,Hawkins,0,0,0,,Paniklemeyin.Dialogue: 0,0:13:37.48,0:13:39.79,Main,Hawkins,0,0,0,,Bugün ölmeyeceğim.Dialogue: 0,0:13:45.53,0:13:48.30,Main,Luffy,0,0,0,,Lunaparkta saklanacağız diyorum!Dialogue: 0,0:13:48.40,0:13:49.48,Main,Nami,0,0,0,,Yalanı bırak.Dialogue: 0,0:13:49.58,0:13:51.70,Main,Usopp,0,0,0,,Orada göze batacak şekilde oynardın.Dialogue: 0,0:13:53.24,0:13:54.31,Main,Luffy,0,0,0,,Sen de kimsin?Dialogue: 0,0:13:56.74,0:13:58.10,Main,Soldier,0,0,0,,Saldırı altındayız!Dialogue: 0,0:14:03.22,0:14:04.58,Main,Soldier 2,0,0,0,,Sallanmayın!Dialogue: 0,0:14:04.70,0:14:05.86,Main,Soldier 3,0,0,0,,Saldırı için beklemede kalın!Dialogue: 0,0:14:06.00,0:14:07.22,Main,Soldier 3,0,0,0,,Topları çıkarın!Dialogue: 0,0:14:07.40,0:14:09.02,Main,Soldier 4,0,0,0,,Kapıları açın!Dialogue: 0,0:14:13.98,0:14:15.64,Main,Soldier,0,0,0,,Saldırı başlasın!Dialogue: 0,0:14:15.72,0:14:16.46,Main,Marines,0,0,0,,Ne?!Dialogue: 0,0:14:16.70,0:14:17.74,Main,Soldier,0,0,0,,Ateş!Dialogue: 0,0:14:21.68,0:14:22.62,Main,Marine,0,0,0,,Ne?Dialogue: 0,0:14:22.68,0:14:24.88,Main,Marine 2,0,0,0,,Bu adamın bedeninin içinde bir şey var!Dialogue: 0,0:14:30.08,0:14:31.22,Main,Marine,0,0,0,,Büyüdü!Dialogue: 0,0:14:34.06,0:14:35.42,Main,Marine 2,0,0,0,,Neler oluyor?!Dialogue: 0,0:14:35.58,0:14:37.56,Main,Marine 3,0,0,0,,Bir şey bile yapmadı!Dialogue: 0,0:14:40.30,0:14:43.00,Main,Soldier,0,0,0,,Süvariler! Hücum!Dialogue: 0,0:14:43.10,0:14:45.62,Main,Marine,0,0,0,,Yine midesinden bir şey çıkıyor!Dialogue: 0,0:14:46.78,0:14:48.06,Main,Marine,0,0,0,,Bir ordu çıkıyor!Dialogue: 0,0:14:49.70,0:14:51.62,Main,Marine 2,0,0,0,,Şimdi de atlar mı?!Dialogue: 0,0:14:56.92,0:14:58.62,Main,Marine,0,0,0,,Capone "Çete" Bege...Dialogue: 0,0:14:58.72,0:15:02.10,Main,Marine,0,0,0,,Ne tür bir gücü var o adamın?!Dialogue: 0,0:15:02.50,0:15:04.46,Main,Soldiers,0,0,0,,İdam mangası, nişan al!Dialogue: 0,0:15:04.68,0:15:06.18,Main,Soldier,0,0,0,,Bu duman da ne?Dialogue: 0,0:15:07.60,0:15:09.78,Main,Soldier,0,0,0,,Baba, çok fazla duman var!Dialogue: 0,0:15:10.86,0:15:13.76,Main,Bege,0,0,0,,Dediğim gibi, sayıca sizden üstünüm!Dialogue: 0,0:15:14.06,0:15:16.09,Captions,,0,900,16,,Sabaody Takımadaları                   27. Koru LimanıDialogue: 0,0:15:14.20,0:15:16.26,Main,Man,0,0,0,,Hemen kaçın!Dialogue: 0,0:15:16.38,0:15:18.62,Main,Man,0,0,0,,Görünüşe göre Schichibukai bile harekete geçmiş!Dialogue: 0,0:15:18.92,0:15:20.76,Main,Man 2,0,0,0,,Cidden mi? Kim?Dialogue: 0,0:15:21.96,0:15:22.88,Main,Bonney,0,0,0,,Schichibukai mi?!Dialogue: 0,0:15:23.51,0:15:27.35,Captions,,0,900,335,,24. KoruDialogue: 0,0:15:28.90,0:15:32.82,Main,Urouge,0,0,0,,Sanırım Donanma Karargâhı'nı geçmemize izin vermeyecekler...Dialogue: 0,0:15:33.04,0:15:33.76,Main,Urouge,0,0,0,,Ama!Dialogue: 0,0:15:37.64,0:15:39.48,Main,Urouge,0,0,0,,Biraz inatçı bir yönüm var!Dialogue: 0,0:15:39.58,0:15:44.48,Captions,,0,880,340,,24. Ada KorusuDialogue: 0,0:15:41.38,0:15:44.22,Main,Pirate,0,0,1,,Yalvarırım. Kaçın, Kaptan Hawkins!Dialogue: 0,0:15:44.54,0:15:45.86,Main,Pirate 2,0,0,0,,Kaptan Hawkins!Dialogue: 0,0:15:47.04,0:15:50.73,Main,Hawkins,0,0,0,,Dövüş: Yenilgi olasılığı %100.Dialogue: 0,0:15:51.40,0:15:53.73,Main,Kizaru,0,0,0,,Biraz vaktin var mı?Dialogue: 0,0:15:54.34,0:15:57.92,Main,Hawkins,0,0,0,,Kaçış: Başarma olasılığı %12.Dialogue: 0,0:15:58.12,0:16:02.60,Main,Kizaru,0,0,0,,Sentoumaru adında birini bulmaya çalışıyorum.Dialogue: 0,0:16:03.04,0:16:06.96,Main,Hawkins,0,0,0,,Savunma: Kurtulma olasılığı %76.Dialogue: 0,0:16:07.58,0:16:09.70,Main,Hawkins,0,0,0,,O adamı tanımıyorum.Dialogue: 0,0:16:10.16,0:16:11.88,Main,Hawkins,0,0,0,,Lütfen başkasına sor.Dialogue: 0,0:16:12.48,0:16:15.74,Main,Kizaru,0,0,0,,Madem bulamıyorum...Dialogue: 0,0:16:16.78,0:16:18.62,Main,Kizaru,0,0,0,,...yapacak bir şeyim yok.Dialogue: 0,0:16:19.10,0:16:23.79,Main,Kizaru,0,0,0,,Durum bu olunca, senin gibi ödülü olan birini serbest bırakmam mümkün değil.Dialogue: 0,0:16:24.44,0:16:30.48,Main,Kizaru,0,0,0,,249 milyon ödüllü "Büyücü" Basil Hawkins.Dialogue: 0,0:16:31.88,0:16:34.48,Main,Kizaru,0,0,0,,Hız ağırdır.Dialogue: 0,0:16:34.60,0:16:38.36,Main,Kizaru,0,0,0,,Hiç ışık hızında tekme deneyimi yaşadın mı?Dialogue: 0,0:16:45.92,0:16:46.78,Main,Pirates,0,0,0,,Kaptan!Dialogue: 0,0:16:46.78,0:16:48.48,Captions,,0,890,340,,27. KoruDialogue: 0,0:16:53.26,0:16:54.03,Main,Pirate,0,0,0,,Ne oldu?!Dialogue: 0,0:16:54.64,0:16:56.26,Main,Pirate 3,0,0,0,,Hey, ne oldu?!Dialogue: 0,0:16:56.34,0:16:58.64,Main,Pirate,0,0,0,,Bilmiyorum! Aniden uçtu!Dialogue: 0,0:17:01.30,0:17:03.67,Captions,,0,880,340,,24. KoruDialogue: 0,0:17:04.56,0:17:07.00,Main,Apoo,0,0,0,,Gerçekten güçlü.Dialogue: 0,0:17:08.42,0:17:10.10,Main,Apoo,0,0,0,,Hey, hâlâ dövüşecek mi?!Dialogue: 0,0:17:20.19,0:17:22.19,Captions,,0,890,360,,Takımada LimanıDialogue: 0,0:17:24.52,0:17:26.26,Main,Pirate,0,0,0,,Hey, o da neydi?Dialogue: 0,0:17:26.38,0:17:27.78,Main,Pirate,0,0,0,,Aniden...Dialogue: 0,0:17:27.90,0:17:29.88,Main,Pirate 2,0,0,0,,Bir yerden saldırıya uğramış olmalı.Dialogue: 0,0:17:31.30,0:17:34.90,Captions,,0,880,340,,24. KoruDialogue: 0,0:17:40.26,0:17:41.18,Main,Pirate,0,0,0,,Kaptan!Dialogue: 0,0:17:41.56,0:17:45.00,Main,Hawkins,0,0,0,,Tahmin etmeliydim, düşündüğümden daha güçlüsün.Dialogue: 0,0:17:45.66,0:17:48.02,Main,Kizaru,0,0,0,,Ne garip...Dialogue: 0,0:17:48.14,0:17:50.22,Main,Hawkins,0,0,0,,Şimdiden iki tanesini yendin.Dialogue: 0,0:17:50.74,0:17:54.58,Main,Hawkins,0,0,0,,Bir amirale karşı sadece on vücut sahibi olmak cesaret kırıcı.Dialogue: 0,0:18:01.76,0:18:04.56,Main,Pirate,0,0,0,,O, "Deli Keşiş" Urouge!Dialogue: 0,0:18:04.70,0:18:05.68,Main,Pirate 2,0,0,0,,Sadece o değil!Dialogue: 0,0:18:08.02,0:18:10.38,Main,Pirate 2,0,0,0,,Schichibukai'larden biri, Bartholomew Kuma!Dialogue: 0,0:18:11.94,0:18:14.70,Main,Urouge,0,0,0,,Beni hakladı. Çok güçlü!Dialogue: 0,0:18:15.02,0:18:17.18,Main,Urouge,0,0,0,,Yoksa o Kizaru mu?!Dialogue: 0,0:18:17.64,0:18:19.58,Main,Urouge,0,0,0,,Berbat bir şansım var!Dialogue: 0,0:18:19.80,0:18:21.92,Main,Urouge,0,0,0,,Önümde donanma amirali...Dialogue: 0,0:18:22.12,0:18:23.86,Main,Urouge,0,0,0,,...arkamda Schichibukai.Dialogue: 0,0:18:24.10,0:18:25.48,Main,Urouge,0,0,0,,Sonum geldi mi?!Dialogue: 0,0:18:26.12,0:18:27.44,Main,Hawkins,0,0,0,,Ben öyle demezdim.Dialogue: 0,0:18:27.56,0:18:29.92,Main,Hawkins,0,0,0,,Henüz üzerinde ölüm işaretini görmüyorum.Dialogue: 0,0:18:31.16,0:18:31.88,Main,Urouge,0,0,0,,Gerçekten mi?Dialogue: 0,0:18:32.44,0:18:34.54,Main,Urouge,0,0,0,,Kuzey Mavi'den Hawkins, ha?Dialogue: 0,0:18:35.56,0:18:37.94,Main,Urouge,0,0,0,,Düşmanım olabilirsin ama şakayı beğendim!Dialogue: 0,0:18:45.08,0:18:48.28,Main,Pirate,0,0,0,,Ne? Biri daha ortaya çıktı!Dialogue: 0,0:18:48.38,0:18:51.46,Main,Pirate 2,0,0,0,,O, "Kızıl Bayrak" X-Drake!Dialogue: 0,0:18:51.66,0:18:52.30,Main,Pirate 2,0,0,0,,Neden?!Dialogue: 0,0:18:52.48,0:18:54.26,Main,Kizaru,0,0,0,,Tuğamiral Drake.Dialogue: 0,0:18:54.26,0:18:57.28,Main,Drake,0,0,0,,Kahretsin, Kizaru'yla karşılaşmak niyetinde değildim!Dialogue: 0,0:19:09.68,0:19:15.24,Main,Urouge,0,0,0,,Epey hırpalandım ama gerçekten...Dialogue: 0,0:19:16.55,0:19:18.50,Main,Urouge,0,0,0,,...kazanma umudu var mı yok mu görelim!Dialogue: 0,0:19:21.36,0:19:23.67,Main,Urouge,0,0,0,,Şimdi karşı saldırı zamanım geldi!Dialogue: 0,0:19:24.87,0:19:27.76,Main,Apoo,0,0,0,,Bak! Durum mükemmel oldu.Dialogue: 0,0:19:27.90,0:19:29.52,Main,Apoo,0,0,0,,Gerçekten ilginç!Dialogue: 0,0:19:29.64,0:19:31.06,Main,Pirate,0,0,0,,Başımız dertte!Dialogue: 0,0:19:31.16,0:19:32.96,Main,Pirate,0,0,0,,Onların hepsi ölecek!Dialogue: 0,0:19:33.06,0:19:35.28,Main,Pirate,0,0,0,,Bu bizim kaçma şansımız, değil mi?!Dialogue: 0,0:19:35.46,0:19:36.88,Main,Apoo,0,0,0,,Ne diyorsun?Dialogue: 0,0:19:37.40,0:19:39.97,Main,Apoo,0,0,0,,Eğlence daha yeni başlıyor!Dialogue: 0,0:19:44.47,0:19:49.17,Captions,,0,880,340,,12. KoruDialogue: 0,0:19:45.56,0:19:46.56,Main,Luffy,0,0,0,,Sen de kimsin?Dialogue: 0,0:19:49.70,0:19:50.64,Main,Usopp,0,0,0,,Geri çekil, Luffy!Dialogue: 0,0:19:50.76,0:19:52.82,Main,Nami,0,0,0,,O, Schichibukai'lardan biri!Dialogue: 0,0:19:52.99,0:19:53.98,Main,Luffy,0,0,0,,Schichibukai?Dialogue: 0,0:19:54.30,0:19:55.82,Main,Luffy,0,0,0,,Nereden biliyorsunuz?Dialogue: 0,0:19:57.42,0:19:59.38,Main,Sanji,0,0,0,,Sakın o saldırının sana vurmasına izin verme!Dialogue: 0,0:19:59.56,0:20:00.49,Main,Sanji,0,0,0,,Şok dalgası!Dialogue: 0,0:20:10.34,0:20:11.22,Main,Nami,0,0,0,,Bu da ne?!Dialogue: 0,0:20:11.30,0:20:13.55,Main,Usopp,0,0,0,,Bunu da mı yapabiliyor?!Dialogue: 0,0:20:14.60,0:20:17.32,Main,Luffy,0,0,0,,Hey, o şok dalgası değil!Dialogue: 0,0:20:17.66,0:20:18.43,Main,Chopper,0,0,0,,O bir...Dialogue: 0,0:20:18.86,0:20:20.96,Main,Chopper and Luffy,0,0,0,,...ışın!Dialogue: 0,0:20:21.88,0:20:24.14,Main,Usopp,0,0,0,,Mutlu olacak zaman değil, aptallar!Dialogue: 0,0:20:27.36,0:20:29.82,Main,Robin,0,0,0,,Bartholomew Kuma, niye tekrardan geldi?!Dialogue: 0,0:20:30.39,0:20:31.65,Main,Zoro,0,0,0,,Pislik!Dialogue: 0,0:20:31.98,0:20:35.92,Main,Luffy,0,0,0,,Thriller Bark'ta sonradan ortaya çıkan adam bu mu yoksa?!Dialogue: 0,0:20:36.10,0:20:38.42,Main,Usopp,0,0,0,,Evet, bu o!Dialogue: 0,0:20:38.64,0:20:43.86,Main,Usopp,0,0,0,,O sırada elindeki patilerden şok dalgaları çıkardı ve bizi epey sıkıntıya soktu!Dialogue: 0,0:20:45.20,0:20:48.74,Main,Chopper,0,0,0,,Hepimizi yok etmeyi planlıyordu ama...Dialogue: 0,0:20:54.86,0:20:58.14,Main,Chopper,0,0,0,,...sanırım hayatta kaldığımızı fark etti ve geri geldi!Dialogue: 0,0:20:59.02,0:21:03.28,Main,Franky,0,0,0,,O sırada bizi haklamıştın!Dialogue: 0,0:21:04.11,0:21:06.11,Main,Franky,0,0,0,,Rüzgar Vuruşu!Dialogue: 0,0:21:13.24,0:21:14.24,Main,Nami,0,0,0,,İşe yaradı!Dialogue: 0,0:21:14.70,0:21:15.62,Main,Franky,0,0,0,,Hayır.Dialogue: 0,0:21:19.32,0:21:20.18,Main,Brook,0,0,0,,Luffy-san!Dialogue: 0,0:21:20.96,0:21:22.90,Main,Luffy,0,0,0,,İkinci Düzen!Dialogue: 0,0:21:23.96,0:21:28.30,Main,Luffy,0,0,0,,Güçlü olduğunu zaten biliyorum,  bu yüzden en başından her şeyimi kullanacağım!Dialogue: 0,0:21:28.78,0:21:30.24,Main,Sanji,0,0,0,,Başka çaremiz yok!Dialogue: 0,0:21:34.14,0:21:35.74,Thoughts,Zoro,0,0,0,,Bir tuhaflık var.Dialogue: 0,0:21:36.22,0:21:38.48,Thoughts,Zoro,0,0,0,,O zamankinden farklı bir his veriyor.Dialogue: 0,0:21:38.56,0:21:39.68,Thoughts,Zoro,0,0,0,,Bana mı öyle geliyor acaba?Dialogue: 0,0:21:39.72,0:21:40.62,Main,Luffy,0,0,0,,Gidelim!Dialogue: 0,0:21:44.55,0:21:51.72,Captions,,0,880,340,,36. KoruDialogue: 0,0:21:52.58,0:21:53.52,Main,Sentoumaru,0,0,0,,Gecikti!Dialogue: 0,0:21:53.62,0:21:55.46,Main,Sentoumaru,0,0,0,,Savaş gemisi şimdiye burada olmalıydı.Dialogue: 0,0:21:55.60,0:21:56.66,Main,Sentoumaru,0,0,0,,Tuhaf.Dialogue: 0,0:21:59.28,0:22:02.20,Main,Sentoumaru,0,0,0,,Şu yaşlı adam Kizaru,  niye hala benimle temas kurmadı?Dialogue: 0,0:22:09.52,0:22:10.71,Main,Sentoumaru,0,0,0,,Acele etmezse...Dialogue: 0,0:22:14.38,0:22:16.28,Main,Sentoumaru,0,0,0,,...tüm çaylakların...Dialogue: 0,0:22:24.10,0:22:28.96,Main,Sentoumaru,0,0,0,,...işini bitirmek zorunda kalacağım.