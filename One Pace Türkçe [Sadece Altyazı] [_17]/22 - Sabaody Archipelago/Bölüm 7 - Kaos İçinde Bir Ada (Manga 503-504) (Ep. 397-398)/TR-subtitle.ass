Dialogue: 0,0:01:40.04,0:01:43.46,Title,,0,0,250,,{\fad(500,500)}Kaos İçinde Bir Ada
Dialogue: 0,0:02:18.78,0:02:20.03,Main,,0,0,0,,Üzgünüm çocuklar.
Dialogue: 0,0:02:20.03,0:02:24.79,Main,,0,0,0,,Bu insanlara vurduğum takdirde Karargâh'tan\Nbir amiral ve savaş gemisi çağıracaklar, değil mi?
Dialogue: 0,0:02:25.06,0:02:29.43,Main,,0,0,0,,Sen ona vurmasaydın ben kesecektim.
Dialogue: 0,0:02:29.43,0:02:31.43,Main,,0,0,0,,Hachi! Dayan!
Dialogue: 0,0:02:31.43,0:02:34.10,Main,,0,0,0,,Korkunç bir şey yaptınız.
Dialogue: 0,0:02:34.32,0:02:37.20,Main,,0,0,0,,Evet, bahsettiğimiz kişi Luffy\Nolduğundan yapacak bir şey yok.
Dialogue: 0,0:02:37.20,0:02:37.86,Main,,0,0,0,,Pekâlâ...
Dialogue: 0,0:02:40.04,0:02:43.33,Main,,0,0,0,,O zaman ne yapacağımız belli, değil mi?
Dialogue: 0,0:02:43.33,0:02:47.82,Main,,0,0,0,,Caimie'nin tasmasının anahtarının sahne\Narkasında bir yerde olduğundan eminim.
Dialogue: 0,0:02:47.82,0:02:50.11,Main,,0,0,0,,Hachi'nin yaralarına bakmam gerektiği\Niçin bu işi sana bırakacağım!
Dialogue: 0,0:02:51.09,0:02:53.05,Main,,0,0,0,,Siz...
Dialogue: 0,0:02:55.97,0:02:57.19,Main,,0,0,0,,Charlos...!
Dialogue: 0,0:02:57.76,0:03:02.53,Main,,0,0,0,,Ah! Charlos abi! Babam bile\Nona hiç vurmamıştı!
Dialogue: 0,0:03:02.53,0:03:03.80,Main,,0,0,0,,Lanet olası!
Dialogue: 0,0:03:03.80,0:03:06.95,Main,,0,0,0,,Senin gibi insandan daha aşağılık biri\Noğluma el sürmeye nasıl cüret eder?!
Dialogue: 0,0:03:09.63,0:03:12.11,Main,,0,0,0,,K-Kutsal Ejderler'i kızdırdı!
Dialogue: 0,0:03:12.11,0:03:14.01,Main,,0,0,0,,Kaçın! Dışarı çıkın!
Dialogue: 0,0:03:15.77,0:03:22.11,Main,,0,0,0,,Bu dünyayı yapanların torunlarına el\Nsürünce ne olacağını bilmeni sağlayacağım!
Dialogue: 0,0:03:22.39,0:03:24.77,Main,,0,0,0,,Umrumuzda mı sanki, pislik?!
Dialogue: 0,0:03:25.10,0:03:27.19,Main,,0,0,0,,Aziz Roswald'a nasıl saldırırsın?!
Dialogue: 0,0:03:28.32,0:03:29.53,Main,,0,0,0,,Yanak!
Dialogue: 0,0:03:29.53,0:03:30.53,Main,,0,0,0,,Et Yumuşatıcı!
Dialogue: 0,0:03:32.56,0:03:35.26,Main,,0,0,0,,Git artık, Franky!\NCaimie-chan'ı serbest bırak!
Dialogue: 0,0:03:35.26,0:03:37.37,Main,,0,0,0,,Tamam! Süper bir biçimde halledeceğim!
Dialogue: 0,0:03:37.37,0:03:40.01,Main,,0,0,0,,Muhafızlar! Yakalayın şunları!\NKorsanları yakalayın!
Dialogue: 0,0:03:41.01,0:03:42.67,Main,,0,0,0,,Gelip duruyorlar!
Dialogue: 0,0:03:42.67,0:03:46.15,Main,,0,0,0,,Sadece bir aptal berbat bir balığı korur!
Dialogue: 0,0:03:55.85,0:04:00.75,Main,,0,0,0,,Demek sonuna kadar bize meydan\Nokumak niyetindesiniz?!
Dialogue: 0,0:04:00.75,0:04:04.04,Main,,0,0,0,,Caimie satılık değil!
Dialogue: 0,0:04:05.64,0:04:08.27,Main,,0,0,0,,Buraya bir amiral ve savaş gemisi çağırın!
Dialogue: 0,0:04:09.40,0:04:11.70,Main,,0,0,0,,Kimin patron olduğunu görsünler!
Dialogue: 0,0:04:12.16,0:04:15.03,Main,,0,0,0,,Korsanlar, Kutsal Ejderler'e saldırdı!
Dialogue: 0,0:04:15.03,0:04:17.40,Main,,0,0,0,,Karargâh'tan bir savaş gemisi gelecek!
Dialogue: 0,0:04:17.40,0:04:18.04,Main,,0,0,0,,Eğilin!
Dialogue: 0,0:04:18.58,0:04:20.35,Main,,0,0,0,,16 Kiloluk Top!
Dialogue: 0,0:04:22.77,0:04:24.23,Main,,0,0,0,,Bizi öldürmeye mi çalışıyorsun?!
Dialogue: 0,0:04:30.83,0:04:31.88,Main,,0,0,0,,Camie!
Dialogue: 0,0:04:34.24,0:04:35.10,Main,,0,0,0,,Hatchin!
Dialogue: 0,0:04:35.10,0:04:38.56,Main,,0,0,0,,İyi misin? Seni incitmediler, değil mi?
Dialogue: 0,0:04:38.61,0:04:41.61,Main,,0,0,0,,İyiyim. Ama sen yaralandın!
Dialogue: 0,0:04:41.62,0:04:45.14,Main,,0,0,0,,Endişelenme! Benim kim olduğumu sanıyorsun?
Dialogue: 0,0:04:45.14,0:04:47.21,Main,,0,0,0,,Ben, takoyaki tüccarı Hachi'yim!
Dialogue: 0,0:04:47.21,0:04:50.19,Main,,0,0,0,,Sadece biraz daha dayan! Orada bekle!
Dialogue: 0,0:04:50.75,0:04:53.50,Main,,0,0,0,,Tamam! Hacchin, arkadaşlar...
Dialogue: 0,0:05:00.57,0:05:04.73,Main,,0,0,0,,Aşağıda epey curcuna var gibi görünüyor.\Nİnsanlar dalgalar halinde çıkışa koşuyor.
Dialogue: 0,0:05:04.95,0:05:08.57,Main,,0,0,0,,Oraya dalıp girmeliyiz. Hemen saldıralım!
Dialogue: 0,0:05:08.81,0:05:09.76,Main,,0,0,0,,Anlaşıldı!
Dialogue: 0,0:05:09.76,0:05:12.69,Main,,0,0,0,,Durun, bunun için hazır değilim!
Dialogue: 0,0:05:12.69,0:05:13.29,Main,,0,0,0,,Gidelim.
Dialogue: 0,0:05:17.75,0:05:20.62,Main,,0,0,0,,"Müzayede evine gidemem"\Nhastalığına tutuldum.
Dialogue: 0,0:05:25.21,0:05:27.42,Main,,0,0,0,,Daha çok uçan balık!
Dialogue: 0,0:05:27.79,0:05:28.68,Main,,0,0,0,,Sağol!
Dialogue: 0,0:05:28.68,0:05:29.50,Main,,0,0,0,,Dikkatli ol!
Dialogue: 0,0:05:29.83,0:05:31.46,Main,,0,0,0,,100 Çiçek!
Dialogue: 0,0:05:34.18,0:05:34.93,Main,,0,0,0,,Kanat!
Dialogue: 0,0:05:36.83,0:05:38.17,Main,,0,0,0,,Tamam, iyi şanslar!
Dialogue: 0,0:05:38.17,0:05:39.14,Main,,0,0,0,,Gidiyorum!
Dialogue: 0,0:05:39.40,0:05:40.30,Main,,0,0,0,,Kavra!
Dialogue: 0,0:05:42.95,0:05:44.66,Main,,0,0,0,,Şimdi! Geç geldiğim için kusura bakmayın!
Dialogue: 0,0:05:44.66,0:05:46.98,Main,,0,0,0,,Kahretsin! Deniz kızını koruyun!
Dialogue: 0,0:05:46.98,0:05:49.31,Main,,0,0,0,,O, 500 milyon değerinde!\NOnun için 500 milyon alacağız!
Dialogue: 0,0:05:50.48,0:05:53.77,Main,,0,0,0,,Zaten geldiğime göre, \Nbiraz daha beklesem olur sanırım?
Dialogue: 0,0:05:53.77,0:05:54.86,Main,,0,0,0,,Git artık!
Dialogue: 0,0:05:56.65,0:06:00.08,Main,,0,0,0,,Gitmek istemiyordum!
Dialogue: 0,0:06:00.08,0:06:02.89,Main,,0,0,0,,Bu insanlar... \NKadınları doldurtup astıracağım!
Dialogue: 0,0:06:02.89,0:06:06.29,Main,,0,0,0,,Erkekler ise yiyecek olmadan\Nköleliğe mahkum edilecek!
Dialogue: 0,0:06:10.19,0:06:11.96,Main,,0,0,0,,Baba!
Dialogue: 0,0:06:12.57,0:06:14.31,Main,,0,0,0,,
Dialogue: 0,0:06:14.31,0:06:16.38,Main,,0,0,0,,Ha? O kadar da acımadı.
Dialogue: 0,0:06:18.68,0:06:19.72,Main,,0,0,0,,Üzgünüm, yaşlı adam!
Dialogue: 0,0:06:20.11,0:06:22.21,Main,,0,0,0,,Aziz Rosward bile...
Dialogue: 0,0:06:22.21,0:06:24.14,Main,,0,0,0,,O korsanlar bir günah daha işledi!
Dialogue: 0,0:06:25.79,0:06:27.44,Main,,0,0,0,,Usopp! Robin! Brook!
Dialogue: 0,0:06:29.05,0:06:31.11,Main,,0,0,0,,Şimdi hepimiz buradayız!
Dialogue: 0,0:06:31.35,0:06:32.92,Main,,0,0,0,,Luffy! Caimie nerede?
Dialogue: 0,0:06:32.92,0:06:36.65,Main,,0,0,0,,Orada! Patlayan tasmasını çıkarır\Nçıkarmaz buradan gidiyoruz!
Dialogue: 0,0:06:37.15,0:06:40.24,Main,,0,0,0,,Savaş gemisi ve amiral\Ngelmeden acele etmeliyiz!
Dialogue: 0,0:06:40.24,0:06:41.58,Main,,0,0,0,,
Dialogue: 0,0:06:41.95,0:06:46.00,Main,,0,0,0,,Denizciler zaten burada, Hasır Şapka.
Dialogue: 0,0:06:46.71,0:06:48.17,Main,,0,0,0,,Sen de kimsin?
Dialogue: 0,0:06:48.93,0:06:50.12,Main,,0,0,0,,Ve o ayının nesi var?
Dialogue: 0,0:06:52.09,0:06:58.01,Main,,0,0,0,,Müzayede başlamadan önce\Nbu salonun etrafını sarmışlardı.
Dialogue: 0,0:06:59.24,0:07:03.35,Main,,0,0,0,,Sonuçta bu takımadada bir\NKarargâh karakolu var.
Dialogue: 0,0:07:03.93,0:07:08.44,Main,,0,0,0,,Lütfen düzenli bir şekilde ayrılın.\NSorun yok! Biz buradayız!
Dialogue: 0,0:07:09.26,0:07:10.57,Main,,0,0,0,,İçeride durum nedir?
Dialogue: 0,0:07:10.57,0:07:12.75,Main,,0,0,0,,Tüm misafirler tahliye edildi gibi.
Dialogue: 0,0:07:12.75,0:07:14.89,Main,,0,0,0,,Ama 3 Kutsal Ejder hâlâ içeride!
Dialogue: 0,0:07:14.89,0:07:16.53,Main,,0,0,0,,Hemen çıkarın onları!
Dialogue: 0,0:07:16.53,0:07:20.49,Main,,0,0,0,,Lanet olası korsanlar! Buradan yara\Nalmadan çıkacağınızı düşünmeyin!
Dialogue: 0,0:07:22.06,0:07:25.29,Main,,0,0,0,,Kimi yakalamak istedikleri\Nkonusunda bir fikrim yok.
Dialogue: 0,0:07:25.83,0:07:31.26,Main,,0,0,0,,Gerçi birinin Kutsal Ejderler'e \Nvurabileceğini de bilmiş olamazlar, değil mi?
Dialogue: 0,0:07:33.42,0:07:38.26,Main,,0,0,0,,Bana epey ilginç bir şey gösterdiniz, \NHasır Şapka Tayfası.
Dialogue: 0,0:07:38.49,0:07:40.83,Main,,0,0,0,,Sen Trafalgar Law'sın, değil mi?
Dialogue: 0,0:07:41.34,0:07:43.39,Main,,0,0,0,,Luffy, o bir korsan.
Dialogue: 0,0:07:43.39,0:07:45.65,Main,,0,0,0,,Ha? Ayı da mı?
Dialogue: 0,0:07:52.32,0:07:53.91,Main,,0,0,0,,500 milyon beli!
Dialogue: 0,0:07:53.91,0:07:57.11,Main,,0,0,0,,Lütfen... lütfen durun, Aziz Shalria!
Dialogue: 0,0:07:57.11,0:08:00.49,Main,,0,0,0,,Henüz o malzemenin parasını almadık!
Dialogue: 0,0:08:00.49,0:08:04.74,Main,,0,0,0,,Lütfen! Durun! Aziz Shalria!
Dialogue: 0,0:08:04.74,0:08:06.68,Main,,0,0,0,,Sessiz ol, aşağılık insan!
Dialogue: 0,0:08:09.66,0:08:11.66,Main,,0,0,0,,Kahretsin! Camie-chan'ın başı dertte!
Dialogue: 0,0:08:14.16,0:08:16.02,Main,,0,0,0,,Direnmeyi bırak!
Dialogue: 0,0:08:16.38,0:08:17.21,Main,,0,0,0,,Kahretsin!
Dialogue: 0,0:08:30.66,0:08:32.66,Main,,0,0,0,,A-aziz Shalria!
Dialogue: 0,0:09:01.09,0:09:03.03,Main,,0,0,0,,Şuna bak, Dev-kun!
Dialogue: 0,0:09:03.70,0:09:08.40,Main,,0,0,0,,Salon mahvolmuş.\NMüzayede bitmiş gibi görünüyor.
Dialogue: 0,0:09:08.40,0:09:10.25,Main,,0,0,0,,Biraz para çaldığıma göre...
Dialogue: 0,0:09:10.80,0:09:13.47,Main,,0,0,0,,...sanırım kumarhaneye geri döneceğim.
Dialogue: 0,0:09:13.93,0:09:16.64,Main,,0,0,0,,Ne pis bir yaşlı adamsın sen.
Dialogue: 0,0:09:16.64,0:09:19.10,Main,,0,0,0,,Buraya sadece para çalabilmek\Niçin mi geldin?
Dialogue: 0,0:09:19.32,0:09:23.99,Main,,0,0,0,,Beni satın alan kişiden de çalacaktım.
Dialogue: 0,0:09:24.89,0:09:26.73,Main,,0,0,0,,Gerçi artık bu imkansız.
Dialogue: 0,0:09:27.14,0:09:30.66,Main,,0,0,0,,Sahi, bitmişti. Önce biraz sake almalıyım.
Dialogue: 0,0:09:31.03,0:09:32.53,Main,,0,0,0,,Düşünüyorum da...
Dialogue: 0,0:09:32.53,0:09:36.91,Main,,0,0,0,,Benim gibi yaşlı bir köleyi kim isterdi ki?
Dialogue: 0,0:09:47.57,0:09:50.63,Main,,0,0,0,,Ne? Galiba istenmedik bir\Nşekilde dikkat çektim.
Dialogue: 0,0:09:50.87,0:09:53.25,Main,,0,0,0,,Yaşlı adama ve deve ne olmuş öyle?
Dialogue: 0,0:09:53.25,0:09:58.03,Main,,0,0,0,,Onlar müzayede malzemesi değil miydi?!\NKafeslerinden nasıl çıktılar?!
Dialogue: 0,0:10:01.99,0:10:05.52,Main,,0,0,0,,Tasmaları yok!\NOnları nasıl çıkardılar?!
Dialogue: 0,0:10:06.23,0:10:07.45,Main,,0,0,0,,Ne yapacağız?
Dialogue: 0,0:10:07.45,0:10:11.11,Main,,0,0,0,,Ne mi? Kaçan tutsakları\Nyakalamak için işe alınmadık!
Dialogue: 0,0:10:11.11,0:10:14.24,Main,,0,0,0,,Bir devi dizginlememiz mümkün değil!
Dialogue: 0,0:10:14.50,0:10:16.27,Main,,0,0,0,,R-Rayleigh!
Dialogue: 0,0:10:17.28,0:10:19.46,Main,,0,0,0,,Kaplama ustası Rayleigh mi?!
Dialogue: 0,0:10:20.13,0:10:20.70,Main,,0,0,0,,Hangisi?
Dialogue: 0,0:10:20.92,0:10:23.85,Main,,0,0,0,,Oh, bu Hachi değil mi?! \NSensin, değil mi?
Dialogue: 0,0:10:23.85,0:10:27.19,Main,,0,0,0,,Epey zaman oldu!\NBurada ne yapıyorsun?
Dialogue: 0,0:10:29.16,0:10:30.84,Main,,0,0,0,,O yara nasıl oldu?
Dialogue: 0,0:10:31.47,0:10:34.11,Main,,0,0,0,,Ah, söylemene gerek yok.
Dialogue: 0,0:10:51.84,0:10:56.02,Main,,0,0,0,,Demek öyle. Anlıyorum.\NNeler olduğunu anladım.
Dialogue: 0,0:10:58.33,0:11:01.48,Main,,0,0,0,,Kendini epey belaya\Nbulaştırmışsın, ha, Hachi?
Dialogue: 0,0:11:02.00,0:11:04.37,Main,,0,0,0,,Onu kurtaran siz miydiniz?
Dialogue: 0,0:11:06.21,0:11:07.13,Main,,0,0,0,,O zaman...
Dialogue: 0,0:11:20.52,0:11:22.06,Main,,0,0,0,,Bu adam...
Dialogue: 0,0:11:22.06,0:11:22.98,Main,,0,0,0,,Olamaz!
Dialogue: 0,0:11:24.61,0:11:27.19,Main,,0,0,0,,Ha? Ne? Ne yaptı öyle?!
Dialogue: 0,0:11:27.97,0:11:30.36,Main,,0,0,0,,Bu yaşlı adam da kim?!
Dialogue: 0,0:11:36.89,0:11:42.17,Main,,0,0,0,,Şu hasır şapka senin gibi korkusuz\Nbir adama gerçekten yakışıyor.
Dialogue: 0,0:11:44.30,0:11:45.88,Main,,0,0,0,,Seninle karşılaşmak istiyordum,...
Dialogue: 0,0:11:46.73,0:11:48.62,Main,,0,0,0,,...Monkey D. Luffy.
Dialogue: 0,0:11:53.30,0:11:55.67,Captions,,100,970,470,,{\fad(500,500)}Sabaody Takımadaları Kanunsuz Bölge
Dialogue: 0,0:11:54.73,0:12:00.67,Main,,0,0,0,,Korkunç bir şey oldu! Şehrin başı dertte.\NHayır, tüm takımadaların başı dertte!
Dialogue: 0,0:12:00.67,0:12:04.26,Main,,0,0,0,,Hasır Şapkalı Luffy, bir Kutsal Ejder'i dövdü!
Dialogue: 0,0:12:04.26,0:12:06.64,Main,,0,0,0,,1. Koru'daki müzayede evinde!
Dialogue: 0,0:12:06.64,0:12:07.79,Main,,0,0,0,,Ne?!
Dialogue: 0,0:12:07.79,0:12:09.96,Main,,0,0,0,,Görünüşe göre Kid ve Law da oradaymış!
Dialogue: 0,0:12:10.29,0:12:13.27,Main,,0,0,0,,Hasır Şapka böyle bir şeyi nasıl yapabilir?!
Dialogue: 0,0:12:13.27,0:12:19.16,Main,,0,0,0,,Kutsal Ejderler'e zarar verdiğinde buraya savaş\Ngemisiyle bir amiralin geleceğini bilmiyor mu?!
Dialogue: 0,0:12:19.16,0:12:20.61,Main,,0,0,0,,Geminin kaplanması ne durumda?
Dialogue: 0,0:12:20.61,0:12:21.47,Main,,0,0,0,,Dün bitirildi.
Dialogue: 0,0:12:21.97,0:12:24.57,Main,,0,0,0,,Hemen Balık Adam Adası'na\Ngitmek için yola çıkıyoruz.
Dialogue: 0,0:12:24.57,0:12:27.01,Main,,0,0,0,,Amiral yoldayken burada\Nkalacağımı mı sanıyorsunuz?
Dialogue: 0,0:12:27.01,0:12:27.57,Main,,0,0,0,,Anlaşıldı!
Dialogue: 0,0:12:29.81,0:12:33.69,Main,,0,0,0,,Sanırım o aptalların kaptanı\Ndaha da büyük bir aptal!
Dialogue: 0,0:12:34.73,0:12:39.44,Main,,0,0,0,,Yeni Dünya'da onlarla karşılaşırsam...\NOnları yok edeceğim!
Dialogue: 0,0:12:45.11,0:12:48.78,Main,,0,0,0,,Yeni Dünya'ya ulaşmadan hemen önce\NDenizci Karargâhı'nın bu kadar yakınında...
Dialogue: 0,0:12:48.80,0:12:50.53,Main,,0,0,0,,...kargaşa çıkaracaklarını düşünmek...
Dialogue: 0,0:12:50.53,0:12:53.54,Main,,0,0,0,,Ne baş belası bir tayfa.
Dialogue: 0,0:12:54.27,0:12:56.41,Main,,0,0,0,,Yola çıkmaya hazırlanın.
Dialogue: 0,0:12:56.41,0:12:58.54,Main,,0,0,0,,Evet, hemen Kaptan Drake!
Dialogue: 0,0:12:59.21,0:13:02.19,Main,,0,0,0,,Peki, kim gelecek?
Dialogue: 0,0:13:10.20,0:13:14.15,Main,,0,0,0,,Durum böyleyken hepimizi\Navlamayacaklar, değil mi?
Dialogue: 0,0:13:14.15,0:13:16.48,Main,,0,0,0,,Sadece Hasır Şapkalı Luffy'nin\Npeşindeler, değil mi?
Dialogue: 0,0:13:16.97,0:13:19.79,Main,,0,0,0,,Sanırım şu amirale bakmak istiyorum.
Dialogue: 0,0:13:19.79,0:13:23.40,Main,,0,0,0,,Olamaz, Apoo-san!\NÖyle şeyler demeyin, kaçalım!
Dialogue: 0,0:13:28.79,0:13:32.99,Main,,0,0,0,,Kaptan Hawkins, buralarda durmak tehlikeli!\NHemen yola çıkalım!
Dialogue: 0,0:13:32.99,0:13:34.54,Main,,0,0,0,,Sakin olun.
Dialogue: 0,0:13:35.48,0:13:38.92,Main,,0,0,0,,Ölümümün bugün geldiğini görmüyorum.
Dialogue: 0,0:13:39.36,0:13:43.23,Main,,0,0,0,,"Kutsal Yer, Mariejois"
Dialogue: 0,0:13:44.05,0:13:47.55,Main,,0,0,0,,Yine mi o velet? \NOlaylar birbiri ardına geliyor.
Dialogue: 0,0:13:47.55,0:13:50.05,Main,,0,0,0,,O ailenin nesi var?!
Dialogue: 0,0:13:50.05,0:13:53.05,Main,,0,0,0,,Aldığımız bilgiye göre sadece\NHasır Şapka tayfası değil,...
Dialogue: 0,0:13:53.05,0:13:58.70,Main,,0,0,0,,...tayfasıyla birlikte Eustass "Kaptan" Kid\Nve tayfasıyla birlikte Trafalgar Law da var
Dialogue: 0,0:13:58.70,0:14:01.24,Main,,0,0,0,,Toplamda başına ödül\Nkonulan 13 kişi göründü.
Dialogue: 0,0:14:01.24,0:14:03.85,Main,,0,0,0,,Beş tanesi, ödülü 100 milyonu geçen çaylak.
Dialogue: 0,0:14:03.85,0:14:08.86,Main,,0,0,0,,Elbette bilerek Kutsal Ejder'e zarar veren\NMonkey D. Luffy'nin peşinden gideceğiz.
Dialogue: 0,0:14:08.86,0:14:13.93,Main,,0,0,0,,İnsan Dükkânı... şey, "İstihdam Dengeleme Dairesi"nden \Nkimseyle bağlantı kuramıyoruz.
Dialogue: 0,0:14:13.93,0:14:17.13,Main,,0,0,0,,Muhtemelen hepsi yenilmiş.
Dialogue: 0,0:14:17.34,0:14:20.08,Main,,0,0,0,,Neyse, üç Kutsal Ejder'i rehin almak...
Dialogue: 0,0:14:20.08,0:14:23.22,Main,,0,0,0,,...görülmemiş bir düşmanlık.
Dialogue: 0,0:14:23.22,0:14:25.18,Main,,0,0,0,,Talep ettikleri bir şey var mı?
Dialogue: 0,0:14:25.18,0:14:26.92,Main,,0,0,0,,Hayır, henüz bir şey talep etmediler.
Dialogue: 0,0:14:30.57,0:14:34.60,Main,,0,0,0,,Yine de Dünya Soyluları'ndan\Nbirine zarar verdiler.
Dialogue: 0,0:14:34.60,0:14:38.89,Main,,0,0,0,,Bu yüzden harekete geçmememiz\Nmümkün değil, değil mi, Sengoku-san?
Dialogue: 0,0:14:38.89,0:14:39.98,Main,,0,0,0,,Kizaru...
Dialogue: 0,0:14:40.85,0:14:47.01,Main,,0,0,0,,Gitmeme izin ver. \NGerisi kolay; hemen dönerim.
Dialogue: 0,0:14:47.44,0:14:54.26,Main,,0,0,0,,{\fad(11420)}"Adalet"
Dialogue: 0,0:15:01.60,0:15:07.31,Captions,,0,930,470,,{\fad(1000,500)}Sabaody Takımadaları\N1. Koru\Nİnsan Müzayede Dükkanı\NSahne Arkası
Dialogue: 0,0:15:10.55,0:15:12.62,Main,,0,0,0,,Gülünecek bir şey değil, değil mi?!
Dialogue: 0,0:15:14.68,0:15:17.22,Main,,0,0,0,,Burası sizin dükkanınız, değil mi,...
Dialogue: 0,0:15:17.22,0:15:21.12,Main,,0,0,0,,...Bay Doflamingo?!\NŞu anda neredesiniz?
Dialogue: 0,0:15:21.12,0:15:25.23,Main,,0,0,0,,Rosward ailesine olanlardan sonra\Nartık kimse bu dükkâna güvenmeyecek!
Dialogue: 0,0:15:25.23,0:15:27.84,Main,,0,0,0,,Bizi işimizden edeceğine eminim!
Dialogue: 0,0:15:27.84,0:15:30.75,Main,,0,0,0,,Bize yardım edemez misiniz?!
Dialogue: 0,0:15:33.15,0:15:38.37,Main,,0,0,0,,Cidden... İnsan ticareti artık\Nçok eski moda, seni aptal.
Dialogue: 0,0:15:39.20,0:15:42.54,Main,,0,0,0,,Bu gülücük çağı. Anlıyor musun, gülücük!
Dialogue: 0,0:15:42.54,0:15:46.16,Main,,0,0,0,,Disco, dükkanı sana veriyorum.
Dialogue: 0,0:15:46.16,0:15:49.21,Main,,0,0,0,,Bu yüzden artık beni arama!
Dialogue: 0,0:15:51.07,0:15:55.18,Main,,0,0,0,,Ne?! Bu korkunç durumda\Nbizi terk mi ediyorsunuz?!
Dialogue: 0,0:15:55.46,0:15:58.31,Main,,0,0,0,,Sessiz ol, seni sinir bozucu piç!
Dialogue: 0,0:15:58.59,0:16:01.91,Main,,0,0,0,,Orada oturmuş kendi talihsizliğin\Niçin beni suçlarken...
Dialogue: 0,0:16:01.91,0:16:05.35,Main,,0,0,0,,...Yeni Çağ daha da yaklaşıyor, Disco-kun.
Dialogue: 0,0:16:05.59,0:16:11.68,Main,,0,0,0,,Ben... hayır, şu anda biz, denizciler\Ntarafından zorunlu bir buluşmaya çağırılıyoruz.
Dialogue: 0,0:16:17.31,0:16:21.20,Main,,0,0,0,,Bu gelecek sana nasıl geliyor, Disco-kun?
Dialogue: 0,0:16:22.48,0:16:26.46,Main,,0,0,0,,Beyazsakal Korsanları Shichibukai'ye karşı!
Dialogue: 0,0:16:22.48,0:16:26.46,Note,,0,0,0,,Shichibukai: Yedi Savaş Ağası
Dialogue: 0,0:16:36.06,0:16:40.90,Captions,,0,930,470,,{\fad(1000,500)}1. Koru\NMüzayede Evi Önü
Dialogue: 0,0:16:36.99,0:16:39.98,Main,,0,0,0,,Lütfen binadan mümkün olduğunca uzaklaşın!
Dialogue: 0,0:16:39.98,0:16:42.98,Main,,0,0,0,,Seyirci olmasın, lütfen!\NBu insanlar tehlikeli!
Dialogue: 0,0:16:42.98,0:16:45.72,Main,,0,0,0,,Ama satın aldığım köle hala içeride!
Dialogue: 0,0:16:53.62,0:16:55.56,Main,,0,0,0,,Havan topları henüz gelmedi mi?
Dialogue: 0,0:16:55.56,0:16:58.49,Main,,0,0,0,,Evet, çoğu geldi. Onları hızlıca\Nhazırlamaya çalışıyoruz.
Dialogue: 0,0:16:58.90,0:17:00.43,Main,,0,0,0,,Karargâh'tan haber aldınız mı?
Dialogue: 0,0:17:00.43,0:17:03.95,Main,,0,0,0,,Amiral Kizaru yolda ama\Nönce birlikler geliyor.
Dialogue: 0,0:17:04.63,0:17:07.41,Main,,0,0,0,,Onlar mı? Buraya mı geliyorlar?!
Dialogue: 0,0:17:07.41,0:17:10.67,Main,,0,0,0,,Evet, kesinlikle öyle görünüyor.
Dialogue: 0,0:17:17.64,0:17:21.89,Main,,0,0,0,,Hey, yaşlı adam! Dikkatsizce \Nbir şey yapma! Patlayacak!
Dialogue: 0,0:17:21.89,0:17:25.39,Main,,0,0,0,,Bir kölenin tasmasının patlamasının\Nneye benzediğini zaten gördük!
Dialogue: 0,0:17:25.39,0:17:28.15,Main,,0,0,0,,Korkunçtu! Kesinlikle korkunç!
Dialogue: 0,0:17:28.97,0:17:31.81,Main,,0,0,0,,Sorun yok. Kıpırdama.
Dialogue: 0,0:17:41.67,0:17:44.41,Main,,0,0,0,,Ne tür bir güç kullandığını anlamıyorum...
Dialogue: 0,0:17:44.41,0:17:46.28,Main,,0,0,0,,Franky ne yapıyor?!
Dialogue: 0,0:17:46.28,0:17:50.74,Main,,0,0,0,,Bu çok tehlikeli!\NAnahtar olmadan çıkaramayız!
Dialogue: 0,0:17:55.66,0:17:59.50,Main,,0,0,0,,Tik taklamaya başladı! Ne yapacağız?!
Dialogue: 0,0:17:59.61,0:18:03.09,Main,,0,0,0,,Camie!
Dialogue: 0,0:18:09.72,0:18:13.15,Main,,0,0,0,,Bu da ne? Ödümü kopardınız!
Dialogue: 0,0:18:13.15,0:18:16.19,Main,,0,0,0,,Artık tasması ve zincirleri yok mu?
Dialogue: 0,0:18:17.56,0:18:18.52,Main,,0,0,0,,Onları çıkardı.
Dialogue: 0,0:18:18.52,0:18:21.07,Main,,0,0,0,,C-Camie!
Dialogue: 0,0:18:25.95,0:18:31.07,Main,,0,0,0,,Camie! Şükürler olsun!
Dialogue: 0,0:18:33.21,0:18:37.09,Main,,0,0,0,,Bu da ne? Nihayet onları bulmuştum.
Dialogue: 0,0:18:37.09,0:18:40.95,Main,,0,0,0,,Oh, buldun mu? Epey etkileyici.
Dialogue: 0,0:18:40.95,0:18:44.96,Main,,0,0,0,,Ama artık gerek yok.\NLütfen bu genç kızı buradan çıkar.
Dialogue: 0,0:18:45.29,0:18:48.67,Main,,0,0,0,,Ah, şey... T-Teşekkürler!
Dialogue: 0,0:18:51.32,0:18:56.52,Main,,0,0,0,,Bu da ne? Durum ne şimdi?!\NKimsin sen?
Dialogue: 0,0:18:58.96,0:19:01.33,Main,,0,0,0,,Ne? Ne yaptı o?
Dialogue: 0,0:19:01.33,0:19:04.45,Main,,0,0,0,,O yaşlı adam yine gizemli bir şey yaptı!
Dialogue: 0,0:19:09.53,0:19:12.12,Main,,0,0,0,,Kim bu yaşlı adam?
Dialogue: 0,0:19:15.73,0:19:17.27,Main,,0,0,0,,Hey, neredeyse köleler!
Dialogue: 0,0:19:17.27,0:19:21.54,Main,,0,0,0,,Sizi satın alanlar kaçtı.\NFırsatınız varken siz de kaçmalısınız!
Dialogue: 0,0:19:21.54,0:19:22.26,Main,,0,0,0,,Alın!
Dialogue: 0,0:19:28.18,0:19:31.43,Main,,0,0,0,,Tüm bu askerleri deviren\Nbu yaşlı adamsa...
Dialogue: 0,0:19:31.43,0:19:34.23,Main,,0,0,0,,...o zaman bir tür sihir veya\Nbüyücülük kullanmış olmalı, değil mi?
Dialogue: 0,0:19:34.23,0:19:35.74,Main,,0,0,0,,Şeytan meyvesi gücü olmalı!
Dialogue: 0,0:19:36.41,0:19:39.55,Main,,0,0,0,,Hasır şapkanla ilgili de bir şey söyledi.
Dialogue: 0,0:19:41.57,0:19:46.48,Main,,0,0,0,,O hasır şapka, senin gibi korkusuz\Nbir adama gerçekten yakışıyor.
Dialogue: 0,0:19:47.19,0:19:49.02,Main,,0,0,0,,Seninle tanışmak istiyordum,...
Dialogue: 0,0:19:49.02,0:19:50.94,Main,,0,0,0,,...Monkey D. Luffy.
Dialogue: 0,0:19:52.02,0:19:53.77,Main,,0,0,0,,O adamı nereden tanıyorsun, Luffy?
Dialogue: 0,0:19:53.77,0:19:55.92,Main,,0,0,0,,Tanıdığım falan yok!
Dialogue: 0,0:19:55.92,0:19:59.24,Main,,0,0,0,,Muhtemelen onun Haki'siydi.
Dialogue: 0,0:19:59.24,0:20:01.88,Main,,0,0,0,,Gerçi ben de pek anlamıyorum.
Dialogue: 0,0:20:04.04,0:20:08.33,Main,,0,0,0,,Üzgünüm çocuklar. \NSadece izlemeye gelmiştiniz, değil mi?
Dialogue: 0,0:20:08.33,0:20:13.63,Main,,0,0,0,,Deminki durumla baş edişinize bakarsak,\Nkolay adamlar değilsiniz, değil mi?
Dialogue: 0,0:20:13.63,0:20:17.26,Main,,0,0,0,,Burada böylesine büyük biriyle\Nkarşılaşacağımızı kim düşünürdü?
Dialogue: 0,0:20:17.94,0:20:20.22,Main,,0,0,0,,Kara Kral Silver Rayleigh.
Dialogue: 0,0:20:20.22,0:20:24.09,Main,,0,0,0,,Hiç şüphesiz. O efsanevi adam\Nburada ne yapıyor?
Dialogue: 0,0:20:24.50,0:20:28.22,Main,,0,0,0,,Buralarda yaşlı kaplamacı Ray-san\Ndiye çağırılmayı tercih ederim.
Dialogue: 0,0:20:28.22,0:20:30.55,Main,,0,0,0,,Lütfen beni o isimle çağırma.
Dialogue: 0,0:20:30.55,0:20:34.22,Main,,0,0,0,,Artık yaşlı bir adamım. \NSakince ve barış içinde yaşamak istiyorum.
Dialogue: 0,0:20:34.90,0:20:36.52,Main,,0,0,0,,Ölmeyeceksin, değil mi, Hachi?
Dialogue: 0,0:20:36.95,0:20:41.12,Main,,0,0,0,,Bu adada dolaşmaman gerektiğini\Nsana her zaman söylüyorum.
Dialogue: 0,0:20:41.12,0:20:42.99,Main,,0,0,0,,Üzgünüm.
Dialogue: 0,0:20:43.58,0:20:47.51,Main,,0,0,0,,Arkadaşlarımı kurtardığınız için sağolun çocuklar.
Dialogue: 0,0:20:47.51,0:20:50.33,Main,,0,0,0,,Peki amca, niye benimle tanışmak istedin?
Dialogue: 0,0:20:50.58,0:20:55.17,Main,,0,0,0,,Bunu sonraya saklayalım.\NÖnce buradan çıkmalıyız.
Dialogue: 0,0:20:55.41,0:20:58.21,Main,,0,0,0,,Dışarıda bizi tamamen sarmış gibiler, Patron.
Dialogue: 0,0:21:00.42,0:21:05.05,Main,,0,0,0,,İçerideki suçlular! \NLütfen Rosward ailesini serbest bırakın!
Dialogue: 0,0:21:05.48,0:21:10.72,Main,,0,0,0,,Amiral birazdan burada olacak!\NDerhal teslim olmanızı tavsiye ederim!
Dialogue: 0,0:21:10.72,0:21:13.78,Main,,0,0,0,,Sonra bizi suçlamayın çaylaklar!
Dialogue: 0,0:21:19.52,0:21:24.36,Main,,0,0,0,,Demek bizi sadece bu işe sürüklemekle kalmıyorlar\Ntamamen suç ortaklarıymışız gibi davranıyorlar.
Dialogue: 0,0:21:24.36,0:21:28.35,Main,,0,0,0,,Hasır Şapkalı Luffy'nin söylentilerdeki\Ngibi çılgın biri olduğunu görüyorum.
Dialogue: 0,0:21:28.35,0:21:31.87,Main,,0,0,0,,Şikayetim yok ama amiralle\Nçarpışmak için burada olmayacağım.
Dialogue: 0,0:21:32.16,0:21:37.29,Main,,0,0,0,,Evet, deminki gücümü artık kullanmamayı\Ntercih ediyorum, bu yüzden size bırakıyorum.
Dialogue: 0,0:21:37.78,0:21:40.59,Main,,0,0,0,,Denizciler kim olduğumu öğrenseydi\Nbaşım gerçekten derde girerdi.
Dialogue: 0,0:21:40.94,0:21:43.55,Main,,0,0,0,,Yaşlı bir vatandaşa yardım\Netmeye niyetim yok!
Dialogue: 0,0:21:44.13,0:21:46.06,Main,,0,0,0,,Ama ne kadar uzun kalırsak\No kadar çok asker gelecek.
Dialogue: 0,0:21:46.06,0:21:47.43,Main,,0,0,0,,Önden gideceğim.
Dialogue: 0,0:21:48.11,0:21:51.41,Main,,0,0,0,,Hazır gelmişken, \Nben de size yardım edeceğim!
Dialogue: 0,0:21:51.41,0:21:54.27,Main,,0,0,0,,Dışarısının temizlenmesiyle\Nilgileneceğim, bu yüzden rahat olun!
Dialogue: 0,0:21:55.80,0:21:58.50,Main,,0,0,0,,Sana söyledim, ben yapacağım!
Dialogue: 0,0:21:58.01,0:21:59.57,Main,,0,0,0,,Kapa çeneni!
Dialogue: 0,0:21:59.57,0:22:01.10,Main,,0,0,0,,Kendim yaparım dedim!
Dialogue: 0,0:22:01.10,0:22:02.19,Main,,0,0,0,,Defol git buradan!
Dialogue: 0,0:22:02.19,0:22:04.24,Main,,0,0,0,,Kapayın çenenizi!
Dialogue: 0,0:22:03.37,0:22:04.61,Secondary,,0,0,0,,Ben yapacağım!
Dialogue: 0,0:22:04.61,0:22:05.28,Main,,0,0,0,,Ne dedin?!
Dialogue: 0,0:22:05.28,0:22:07.76,Main,,0,0,0,,Dediğim gibi, bu işi bana bırakın!
Dialogue: 0,0:22:07.76,0:22:09.10,Main,,0,0,0,,Hayır! Ben yapacağım!
Dialogue: 0,0:22:09.10,0:22:10.27,Main,,0,0,0,,Bana emir vermeyin.
Dialogue: 0,0:22:10.27,0:22:11.76,Main,,0,0,0,,Anlamıyorsunuz, değil mi?
Dialogue: 0,0:22:11.76,0:22:13.23,Main,,0,0,0,,Anlamayan sensin!
Dialogue: 0,0:22:13.23,0:22:14.41,Main,,0,0,0,,Tamam!
Dialogue: 0,0:22:16.60,0:22:18.70,Main,,0,0,0,,Siz geride durun!
Dialogue: 0,0:22:18.70,0:22:23.50,Main,,0,0,0,,Hey, beni dinliyor musun?\NSize geride kalmanızı söylemiştim!
Dialogue: 0,0:22:23.50,0:22:27.76,Main,,0,0,0,,Bana bir emir daha vermeyi denersen\Nönce senin işini bitiririm, Eustass!
Dialogue: 0,0:22:27.76,0:22:28.94,Main,,0,0,0,,Nişan al!
Dialogue: 0,0:22:31.47,0:22:34.21,Main,,0,0,0,,Cidden bunlar yarım akıllı!
Dialogue: 0,0:22:34.21,0:22:36.35,Main,,0,0,0,,Hey! Büyük bir kargaşa çıkaracaklar!
Dialogue: 0,0:22:36.35,0:22:40.11,Main,,0,0,0,,Fırsatımız varken kaçalım!\NBurada bekleyemeyiz!
Dialogue: 0,0:22:40.81,0:22:42.03,Main,,0,0,0,,Hatchin...
Dialogue: 0,0:22:42.26,0:22:45.32,Main,,0,0,0,,Sağol... Hepsi benim hatam. Üzgünüm!
Dialogue: 0,0:22:46.35,0:22:49.20,Main,,0,0,0,,Beni boşver. İyi olmana sevindim.
Dialogue: 0,0:22:49.20,0:22:51.54,Main,,0,0,0,,Peşlerinden gidelim! Yarıp geçeceğiz.
Dialogue: 0,0:22:52.30,0:22:53.41,Main,,0,0,0,,Tamam, öyleyse.
Dialogue: 0,0:22:53.92,0:22:57.88,Main,,0,0,0,,Ayrılırsak benimle 13. Koru'da buluşun.
Dialogue: 0,0:22:57.88,0:23:00.31,Main,,0,0,0,,13. koru mu? Tamam, anladım.
Dialogue: 0,0:23:00.31,0:23:02.73,Main,,0,0,0,,Kesinlikle anlamadın!
Dialogue: 0,0:23:02.73,0:23:04.75,Main,,0,0,0,,Dev-kun! Ya sen?
Dialogue: 0,0:23:04.75,0:23:07.34,Main,,0,0,0,,Hepimiz köle olmanın eşiğindeydik.
Dialogue: 0,0:23:07.34,0:23:09.47,Main,,0,0,0,,Bu insanlarla birlikte kaçacağım!
Dialogue: 0,0:23:10.43,0:23:13.13,Main,,0,0,0,,Anlıyorum. Göze batmamak için dikkatli ol!
Dialogue: 0,0:23:14.10,0:23:17.16,Main,,0,0,0,,Yaşlı adam! Hasır Şapka tayfası!
Dialogue: 0,0:23:17.16,0:23:21.02,Main,,0,0,0,,Bir gün tekrar karşılaşırsak kesinlikle\Niyiliğinizin karşılığını ödeyeceğim!
Dialogue: 0,0:23:21.02,0:23:22.04,Main,,0,0,0,,Çok sağolun!
Dialogue: 0,0:23:22.04,0:23:24.54,Main,,0,0,0,,Sağolun!
Dialogue: 0,0:23:25.02,0:23:27.10,Main,,0,0,0,,Tabii, lafı bile olmaz!
Dialogue: 0,0:23:27.52,0:23:28.82,Main,,0,0,0,,Bunu sen mi söylüyorsun?!
Dialogue: 0,0:23:29.06,0:23:30.98,Main,,0,0,0,,Havan toplarını ateşleyin!
Dialogue: 0,0:23:32.36,0:23:34.66,Main,,0,0,0,,Gomu Gomu no...
Dialogue: 0,0:23:34.66,0:23:35.49,Main,,0,0,0,,...Balon!
Dialogue: 0,0:23:39.54,0:23:40.79,Main,,0,0,0,,Püskürt!
Dialogue: 0,0:23:42.42,0:23:43.46,Main,,0,0,0,,Oda!
Dialogue: 0,0:23:44.37,0:23:46.75,Main,,0,0,0,,Bu küre de ne?
Dialogue: 0,0:23:47.66,0:23:49.09,Main,,0,0,0,,Karıştır!
Dialogue: 0,0:23:50.46,0:23:54.38,Main,,0,0,0,,Dikkatli olun! \NÜçü de Şeytan Meyvesi güçlerine sahip!
