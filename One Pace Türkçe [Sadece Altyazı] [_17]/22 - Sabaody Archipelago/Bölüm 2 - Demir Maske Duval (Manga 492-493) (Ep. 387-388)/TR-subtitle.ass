Dialogue: 0,0:01:41.70,0:01:50.87,Title,,0,0,250,,{\fad(1900,450)}Demir Maske Duval
Dialogue: 0,0:01:43.80,0:01:46.00,Main,Chopper,0,0,0,,Uçan Balıklar öylece... gittiler mi?
Dialogue: 0,0:01:46.26,0:01:49.20,Main,Franky,0,0,0,,Hem de gerçekten saldırıyor\Nolmalarına rağmen.
Dialogue: 0,0:01:49.40,0:01:51.59,Main,Robin,0,0,0,,Bir tür mesaj almış gibiydiler.
Dialogue: 0,0:01:52.18,0:01:55.80,Main,Robin,0,0,0,,Geri çekilmeleri emredilmiş olabilir mi?\NGerçi sebebini bilemem ama...
Dialogue: 0,0:01:55.90,0:02:00.18,Main,Luffy,0,0,0,,Onlara binmek istiyorum! \NUçan Balıklar havada beş dakika durabiliyor, ha?
Dialogue: 0,0:02:00.28,0:02:01.06,Main,Luffy,0,0,0,,Müthiş!
Dialogue: 0,0:02:01.06,0:02:04.80,Main,Sanji,0,0,0,,Neyse, şu anda gittiğimiz\Nyer onların üssü, değil mi?
Dialogue: 0,0:02:01.07,0:02:01.78,Secondary,Luffy,0,0,0,,Müthiş!
Dialogue: 0,0:02:04.96,0:02:08.04,Main,Sanji,0,0,0,,Bu durumda onlarla yeniden\Ndövüşmeye hazırlansak iyi olur.
Dialogue: 0,0:02:11.24,0:02:13.56,Main,Sanji,0,0,0,,Ama gökten geleceklerini\Nkim tahmin edebilirdi?
Dialogue: 0,0:02:13.68,0:02:18.04,Main,Usopp,0,0,0,,Topları güverteye çıkarmaya ne dersiniz?\NHepsini vurup düşürürüm!
Dialogue: 0,0:02:18.28,0:02:19.06,Main,Franky,0,0,0,,İyi düşündün!
Dialogue: 0,0:02:20.62,0:02:23.58,Main,Camie,0,0,0,,Acaba Hacchin iyi mi?
Dialogue: 0,0:02:23.88,0:02:26.80,Main,Pappag,0,0,0,,Biliyorsun, Macro aslında senin peşinde!
Dialogue: 0,0:02:27.00,0:02:29.02,Main,Pappag,0,0,0,,Sen de dikkatli olmalısın!
Dialogue: 0,0:02:29.34,0:02:33.80,Captions,,920,0,215,,{\fs40\fad(600,0)}Sabaody Takımadaları'nın\NDoğusu\NUçan Balık Binicileri\NKarargâhı
Dialogue: 0,0:02:34.52,0:02:37.28,Main,Raider 1,0,0,0,,Duval-sama! Üçü döndü!
Dialogue: 0,0:02:41.92,0:02:44.32,Main,Raider 2,0,0,0,,Duval-sama, niye geri çekilmemizi emrettin?
Dialogue: 0,0:02:44.48,0:02:45.74,Main,Raider 3,0,0,0,,Ben de bilmek istiyorum.
Dialogue: 0,0:02:45.94,0:02:49.84,Main,Raider 3,0,0,0,,Deniz kızını ve korsanları\Nyakalama işini bize bırakabilirdin!
Dialogue: 0,0:02:50.12,0:02:51.14,Main,Duval,0,0,0,,Aptallar!
Dialogue: 0,0:02:58.08,0:02:59.72,Main,Duval,0,0,0,,O korsanların...
Dialogue: 0,0:02:59.50,0:03:05.45,Captions,,0,0,235,,{\fad(1600,500)}{\fs34}Adam Kaçırma Çetesi\N"Uçan Balık Binicileri"\NPatronu\N{\r}"Demir Maske Duval"
Dialogue: 0,0:03:00.68,0:03:05.62,Main,Duval,0,0,0,,{\an8}...gelişini ne zamandan\Nberi beklediğim hakkında...
Dialogue: 0,0:03:06.54,0:03:09.42,Main,Duval,0,0,0,,...bir fikriniz...
Dialogue: 0,0:03:10.32,0:03:11.84,Main,Duval,0,0,0,,...var mı?!
Dialogue: 0,0:03:13.16,0:03:15.98,Main,Duval,0,0,0,,O adamı ne zaman düşünsem..
Dialogue: 0,0:03:17.02,0:03:22.46,Main,Duval,0,0,0,,...sırtımdaki bu koca yara,\Ncehennem gibi zonkluyor!
Dialogue: 0,0:03:23.74,0:03:26.60,Main,Man,0,0,0,,Eyvah! Patron kızdı!
Dialogue: 0,0:03:26.72,0:03:36.00,Main,Duval,0,0,0,,Her gün... Her gün o adamın\Nismine lanet okudum!
Dialogue: 0,0:03:38.18,0:03:40.25,Main,Man,0,0,0,,Patron, lütfen sakin ol!
Dialogue: 0,0:03:41.30,0:03:44.36,Main,Duval,0,0,0,,O herifi bugün, burada öldüreceğim!
Dialogue: 0,0:03:44.96,0:03:46.27,Main,Duval,0,0,0,,Anlaşıldı mı?!
Dialogue: 0,0:03:46.94,0:03:51.24,Main,Duval,0,0,0,,Bu, ömür boyu sürecek ölümsüz arzum!
Dialogue: 0,0:03:51.36,0:03:54.22,Main,Duval,0,0,0,,Anlıyor musun?!
Dialogue: 0,0:03:54.36,0:03:57.04,Main,Raider,0,0,0,,Evet! O herifin yaşamasına izin verilemez!
Dialogue: 0,0:03:58.24,0:04:03.84,Main,Duval,0,0,0,,O nedenle bu işi doğru düzgün yaptığınızdan\Nemin olmalısınız! Onu böyle haklayacağız!
Dialogue: 0,0:04:04.04,0:04:06.12,Main,Duval,0,0,0,,Siz serseriler emirlerime aynen uyun!
Dialogue: 0,0:04:06.82,0:04:08.02,Main,Man,0,0,0,,Emredersin, patron!
Dialogue: 0,0:04:08.32,0:04:10.24,Main,Duval,0,0,0,,Hey, Macro tayfası!
Dialogue: 0,0:04:10.38,0:04:12.30,Main,Tansui,0,0,0,,Ha? Bizi mi çağırdın?
Dialogue: 0,0:04:12.62,0:04:14.26,Main,Gyaro,0,0,0,,Ne oldu, Duva?
Dialogue: 0,0:04:14.52,0:04:17.90,Main,Macro,0,0,0,,"Duva"? Ne demek istiyorsun, Gyaro?!\N"Ha?" neyin nesi, Tansui?!
Dialogue: 0,0:04:18.02,0:04:20.10,Main,Macro,0,0,0,,Biraz daha görgü öğrenmelisiniz!
Dialogue: 0,0:04:19.72,0:04:27.00,Captions,,0,700,330,,{\fad(750,680)\fs30}Macro Korsanları\N{\r}Gyaro\N{\fs30}(Patlak Gözlü Süs Balığı Adam)
Dialogue: 0,0:04:19.72,0:04:27.00,Captions,,0,50,180,,{\fad(750,680)\fs30\}Macro Korsanları Kaptanı\N{\r}Macro\N{\fs30}(Pelikan Yılan\NBalığı Adam)
Dialogue: 0,0:04:19.72,0:04:27.00,Captions,,600,0,330,,{\fad(750,680)\fs30}Macro Korsanları\N{\r}Tansui\N{\fs30}(Arowana Balığı Adam)
Dialogue: 0,0:04:19.67,0:04:22.40,Main,Tansui,0,0,0,,{\an8}Heh, "Duva" çok komikmiş!
Dialogue: 0,0:04:22.70,0:04:26.84,Main,Macro,0,0,0,,{\an8}Üfff! Ah, siz mi çağırdınız, Efendi Duval?!
Dialogue: 0,0:04:26.90,0:04:29.72,Main,Gyaro,0,0,0,,Patron, bu herif tamamen çılgına dönmüş.
Dialogue: 0,0:04:30.24,0:04:32.24,Main,Macro,0,0,0,,Hey, kapa çeneni!
Dialogue: 0,0:04:32.24,0:04:34.42,Main,Macro,0,0,0,,Ahhh, çok özür dilerim, Efendi.
Dialogue: 0,0:04:34.48,0:04:38.49,Main,Macro,0,0,0,,Bunlar tam bir aptal,\Nne dediklerini bilmiyorlar!
Dialogue: 0,0:04:40.54,0:04:42.42,Main,Duval,0,0,0,,Ah, sorun değil çocuklar.
Dialogue: 0,0:04:42.84,0:04:46.84,Main,Duval,0,0,0,,Siz, şans meleklerim gibisiniz.
Dialogue: 0,0:04:46.98,0:04:50.68,Main,Duval,0,0,0,,Size ne kadar minnettar\Nolduğumu söyleyemem bile.
Dialogue: 0,0:04:51.02,0:04:51.74,Main,Tansui,0,0,0,,Devam et.
Dialogue: 0,0:04:51.84,0:04:54.36,Main,Macro,0,0,0,,Çeneni kapa demiştim, Tansui!
Dialogue: 0,0:04:55.48,0:04:59.10,Main,Duval,0,0,0,,Sayenizde nihayet... nihayet...
Dialogue: 0,0:04:59.42,0:05:01.08,Main,Duval,0,0,0,,Onlarla karşılaşabileceğim!
Dialogue: 0,0:05:01.34,0:05:04.66,Main,Duval,0,0,0,,Hasır Şapka Korsanları'yla!
Dialogue: 0,0:05:04.78,0:05:08.38,Main,Macro,0,0,0,,Hasır Şapkalar mı? Onlar da kim?
Dialogue: 0,0:05:08.54,0:05:12.83,Thoughts,Hachi,0,0,0,,Hasır Şapkalar? \NO zaman cidden yanılmamışım.
Dialogue: 0,0:05:13.60,0:05:15.08,Main,Duval,0,0,0,,Dinleyin.
Dialogue: 0,0:05:15.88,0:05:17.60,Main,Duval,0,0,0,,O adam...
Dialogue: 0,0:05:18.58,0:05:23.52,Main,Duval,0,0,0,,Hayatım boyunca öldürmek için beklediğim\No adam, o gemide değil mi?
Dialogue: 0,0:05:23.80,0:05:26.56,Main,Duval,0,0,0,,O serseriyi asla affetmeyeceğim!
Dialogue: 0,0:05:26.62,0:05:28.54,Main,Man,0,0,0,,Patron! Lütfen sakin ol!
Dialogue: 0,0:05:29.60,0:05:31.66,Main,Macro,0,0,0,,O adamdan cidden nefret ediyor, ha?
Dialogue: 0,0:05:32.84,0:05:36.12,Thoughts,Hachi,0,0,0,,Hasır Şapka Korsanları'nın adını burada\Nduyacağımı hiç düşünmemiştim.
Dialogue: 0,0:05:37.04,0:05:38.86,Main,Hachi,0,0,0,,Hey, sen. Koca adam!
Dialogue: 0,0:05:39.62,0:05:41.92,Main,Macro,0,0,0,,Duval-sama! Biraz terbiyeli ol,\Nkahrolası ahtapot!
Dialogue: 0,0:05:42.04,0:05:45.32,Main,Hachi,0,0,0,,{\an8}Caimie'nin Hasır Şapka Korsanları\Ntarafından yakalandığını mı söylüyorsun?!
Dialogue: 0,0:05:41.90,0:05:46.44,Captions,,0,0,240,,{\fad(700,0)}Takoyaki Dükkanı Sahibi\NHacchan\N{\fs30}(Ahtapot Balık Adam)\NEski Arlong Korsanları Subayı
Dialogue: 0,0:05:47.16,0:05:51.94,Thoughts,Hachi,0,0,0,,Durum kötü. Onca insan dururken...
Dialogue: 0,0:05:52.44,0:05:54.36,Main,Hachi,0,0,0,,Onlar da mı geliyor?
Dialogue: 0,0:05:54.50,0:05:56.96,Main,Raider,0,0,0,,Evet, şu anda buraya geliyorlar.
Dialogue: 0,0:05:57.24,0:06:01.53,Main,Raider,0,0,0,,Ama yardım için korsanları çeviren,\Ndeniz kızı arkadaşın değil mi?
Dialogue: 0,0:06:01.80,0:06:04.92,Main,Raider 2,0,0,0,,Detayları bilmiyorum ama\Nyakalanmış gibi görünmüyor.
Dialogue: 0,0:06:05.06,0:06:07.26,Main,Raider 2,0,0,0,,Kimi getirirse getirsin,...
Dialogue: 0,0:06:07.36,0:06:12.36,Main,Raider 2,0,0,0,,...burada olduğumuz sürece onları yakalayacağız ve İnsan Dükkanı'na satacağız!
Dialogue: 0,0:06:15.24,0:06:19.24,Thoughts,Hachi,0,0,0,,Sanki yapabilecekmiş gibi konuşuyorlar!\NOnlar korkunç derecede güçlü!
Dialogue: 0,0:06:20.32,0:06:23.02,Thoughts,Hachi,0,0,0,,Bu büyük sorun. Acaba Nami de orada mı?
Dialogue: 0,0:06:23.24,0:06:25.50,Thoughts,Hachi,0,0,0,,Acaba bana hala kızgın mı?
Dialogue: 0,0:06:25.60,0:06:27.30,Thoughts,Hachi,0,0,0,,Elbette kızgındır.
Dialogue: 0,0:06:27.66,0:06:31.04,Thoughts,Hachi,0,0,0,,Arlong'un yanındayken ona\Nkorkunç şeyler yaptım.
Dialogue: 0,0:06:31.66,0:06:38.52,Thoughts,Hachi,0,0,0,,Onlar gelmeden kaçmazsam, \Nkesin benim de canıma okurlar.
Dialogue: 0,0:06:38.92,0:06:41.00,Thoughts,Hachi,0,0,0,,Başım dertte!
Dialogue: 0,0:06:41.58,0:06:44.32,Main,Raider,0,0,0,,Duval-sama! Hasır Şapkalar geldi!
Dialogue: 0,0:06:46.06,0:06:47.22,Main,Duval,0,0,0,,Nihayet geldiler mi?
Dialogue: 0,0:06:47.90,0:06:49.96,Main,Hachi,0,0,0,,Hey, Macro.
Dialogue: 0,0:06:50.04,0:06:51.66,Main,Macro,0,0,0,,Ha? Ne var?
Dialogue: 0,0:06:51.94,0:06:54.94,Main,Hachi,0,0,0,,Sana bir sürü takoyaki vereceğim.\NBeni bırakabilir misin?
Dialogue: 0,0:06:55.12,0:06:58.54,Main,Macro,0,0,0,,Ya, ne demezsin?! Sersem!\NBeni ne tür bir obur sandın?!
Dialogue: 0,0:07:01.52,0:07:04.46,Main,Duval,0,0,0,,O adam gemide mi?
Dialogue: 0,0:07:04.54,0:07:06.24,Main,Raider,0,0,0,,Evet! Kesinlikle orada!
Dialogue: 0,0:07:07.86,0:07:11.70,Main,Macro,0,0,0,,Parayı verenin düdüğü çalma\Nzamanı geldi! Hazır ol!
Dialogue: 0,0:07:12.50,0:07:16.65,Main,Franky,0,0,0,,Galiba orası, Uçan Balık Binicileri'nin üssü.
Dialogue: 0,0:07:17.26,0:07:20.22,Main,Luffy,0,0,0,,Şu Hacchin orada mı tutuluyor?
Dialogue: 0,0:07:21.32,0:07:24.30,Main,Sanji,0,0,0,,Gidip onu bir anda kurtaracağım,\NCaime-chwan!
Dialogue: 0,0:07:24.48,0:07:25.87,Main,Camie,0,0,0,,Sağol, Sanji-chin!
Dialogue: 0,0:07:26.00,0:07:28.89,Main,Camie,0,0,0,,Ah! Ama hepiniz dikkatli olun lütfen!
Dialogue: 0,0:07:29.84,0:07:35.02,Main,Camie,0,0,0,,Sadece Macro Tayfası beni\Nen az 30 kez yakaladı!
Dialogue: 0,0:07:35.14,0:07:37.34,Main,Usopp,0,0,0,,Çok fazla yakalanmışsın!
Dialogue: 0,0:07:37.98,0:07:39.28,Main,Usopp,0,0,0,,Çok fazla da yutulmuşsun.
Dialogue: 0,0:07:40.32,0:07:45.32,Main,Franky,0,0,0,,Burası aslında ada değil. Birisi suyun\Nüstüne bir köy yapmış gibi görünüyor.
Dialogue: 0,0:07:46.66,0:07:49.90,Main,Zoro,0,0,0,,Ama niye üslerini buraya kurmak istesinler?
Dialogue: 0,0:07:50.50,0:07:51.48,Main,Sanji,0,0,0,,Kim bilir?
Dialogue: 0,0:07:55.64,0:07:57.34,Main,Chopper,0,0,0,,Burası epey sessiz.
Dialogue: 0,0:07:57.46,0:07:58.98,Main,Usopp,0,0,0,,Luffy! En azından...
Dialogue: 0,0:08:00.06,0:08:02.22,Main,Luffy,0,0,0,,İleri!
Dialogue: 0,0:08:02.34,0:08:04.42,Main,Usopp,0,0,0,,...bir plan düşünmemiz gerekmez mi?!
Dialogue: 0,0:08:07.48,0:08:13.94,Main,Camie,0,0,0,,Hey! Hacchin, iyi misin?!
Dialogue: 0,0:08:14.32,0:08:18.80,Main,Pappag,0,0,0,,Çık ortaya, Macro! Hachi'yi geri ver!
Dialogue: 0,0:08:20.62,0:08:24.20,Main,Hachi,0,0,0,,Eyvah! Gerçekten Hasır Şapkalar'ın gemisi!
Dialogue: 0,0:08:24.46,0:08:25.40,Main,Hachi,0,0,0,,Kahretsin!
Dialogue: 0,0:08:32.36,0:08:35.47,Main,Hachi,0,0,0,,Gerçekten çıkamıyorum. Madem öyle...
Dialogue: 0,0:08:35.68,0:08:38.42,Main,Hachi,0,0,0,,{\fad(150,150)}Ahtapot Hachi Karası!
Dialogue: 0,0:08:42.96,0:08:45.72,Main,Robin,0,0,0,,Kafeste biri var gibi.
Dialogue: 0,0:08:46.32,0:08:48.86,Main,Camie,0,0,0,,O Hacchin olabilir mi?
Dialogue: 0,0:08:49.22,0:08:52.70,Main,Pappag,0,0,0,,Bu harika, Caimie! Etrafta düşman bile yok!
Dialogue: 0,0:08:52.96,0:08:55.16,Main,Pappag,0,0,0,,Hepsi yemeğe gitmiş olmalı!
Dialogue: 0,0:08:55.36,0:08:57.54,Main,Usopp,0,0,0,,Ciddi misiniz siz?!
Dialogue: 0,0:08:57.70,0:09:00.22,Main,Usopp,0,0,0,,Bunun tuzak olduğunu kim olsa anlar!
Dialogue: 0,0:09:00.38,0:09:04.10,Main,Franky,0,0,0,,Belli ki herkes bize tuzak kurmak\Niçin bir yerlere saklanmış.
Dialogue: 0,0:09:05.38,0:09:06.97,Main,Camie,0,0,0,,Ne inanılmaz bir içgörü!
Dialogue: 0,0:09:07.30,0:09:09.88,Main,Pappag,0,0,0,,Bunu hiç düşünmemiştim!
Dialogue: 0,0:09:10.00,0:09:12.10,Main,Franky,0,0,0,,Bu yüzden sürekli yakalanıyorsunuz!
Dialogue: 0,0:09:13.38,0:09:17.14,Main,Hachi,0,0,0,,Buradayım! Caimie, ben iyiyim. Endişe etme!
Dialogue: 0,0:09:18.54,0:09:20.74,Main,Camie,0,0,0,,Kapkara olmuşsun! Ne oldu?!
Dialogue: 0,0:09:21.02,0:09:24.62,Main,Hachi,0,0,0,,Şey, bu biraz da benim hatam.
Dialogue: 0,0:09:24.72,0:09:27.96,Main,Hachi,0,0,0,,Neyse, bu bir tuzak, hemen geri dönün!
Dialogue: 0,0:09:28.16,0:09:31.94,Main,Hachi,0,0,0,,Güçlü olduğumu biliyorsun, değil mi?\NBu yüzden sorun yok, siz gidin!
Dialogue: 0,0:09:34.70,0:09:38.20,Main,Zoro,0,0,0,,O ses gerçekten tanıdık ve\Nşu tuhaf silüet...
Dialogue: 0,0:09:38.38,0:09:39.90,Main,Zoro,0,0,0,,Hey, Nami, ne düşünüyorsun?
Dialogue: 0,0:09:41.04,0:09:43.54,Main,Nami,0,0,0,,Onunla ilgili çok şüpheli bir şey var.
Dialogue: 0,0:09:43.62,0:09:44.32,Main,Luffy,0,0,0,,Ne?
Dialogue: 0,0:09:44.78,0:09:46.74,Main,Sanji,0,0,0,,Sorarsak öğreniriz, değil mi?
Dialogue: 0,0:09:47.32,0:09:50.00,Main,Sanji,0,0,0,,Hey! Arlong iyi mi?!
Dialogue: 0,0:09:50.94,0:09:52.94,Main,Hachi,0,0,0,,Ha? Arlong-san?
Dialogue: 0,0:09:53.10,0:09:58.32,Main,Hachi,0,0,0,,Hayır. O, Choo, Kuroobi ve diğer\Nherkes Denizciler tarafından yakalandı.
Dialogue: 0,0:09:58.52,0:10:04.66,Main,Hachi,0,0,0,,Kaçabilen tek kişi bendim ve şimdi eski hayalim\Nolan takoyaki standını işleterek yaşıyorum.
Dialogue: 0,0:10:08.06,0:10:09.30,Main,Luffy,0,0,0,,Arlong...?
Dialogue: 0,0:10:11.26,0:10:14.30,Main,Luffy,0,0,0,,Sen miydin, kahrolası kalamar?!
Dialogue: 0,0:10:15.54,0:10:17.06,Main,Hachi,0,0,0,,K-Kahretsin!
Dialogue: 0,0:10:19.56,0:10:25.80,Main,Luffy,0,0,0,,Yani Arlong'un yanındaki kahrolası kalamar\Nsen misin?! Takoyaki satıcısı Hacchin sen misini?!
Dialogue: 0,0:10:26.28,0:10:27.17,Main,Robin,0,0,0,,Ne?
Dialogue: 0,0:10:27.50,0:10:30.00,Main,Usopp,0,0,0,,Epey zaman önceydi...
Dialogue: 0,0:10:30.92,0:10:34.38,Main,Usopp,0,0,0,,Ama bir zamanlar Nami'nin memleketi,\NArlong Korsanları denen kötü bir...
Dialogue: 0,0:10:34.41,0:10:36.54,Main,Usopp,0,0,0,,...balık adam tayfasının kontrolü altındaydı.
Dialogue: 0,0:10:37.24,0:10:40.36,Main,Usopp,0,0,0,,Nami'nin kendisi de\Nkorkunç bir durumdaydı...
Dialogue: 0,0:10:40.90,0:10:44.32,Main,Usopp,0,0,0,,...ve o ahtapot baş üyelerden biriydi.
Dialogue: 0,0:10:44.46,0:10:45.88,Main,Franky,0,0,0,,Ah, demek eski bir düşman, öyle mi?
Dialogue: 0,0:10:46.08,0:10:51.66,Main,Usopp,0,0,0,,Elbette Luffygil'i de yanıma alıp\Ntüm tayfanın canına okudum!
Dialogue: 0,0:10:52.42,0:10:54.48,Main,Chopper,0,0,0,,Usopp, müthişsin!
Dialogue: 0,0:10:54.62,0:10:56.17,Main,Usopp,0,0,0,,E-Evet, sanırım öyle.
Dialogue: 0,0:10:56.78,0:11:00.89,Main,Usopp,0,0,0,,Tüm balık adamların Denizciler\Ntarafından yakalandığını düşünmüştüm ama...
Dialogue: 0,0:11:01.12,0:11:03.68,Main,Usopp,0,0,0,,...görünüşe göre o adam kaçmayı başarmış.
Dialogue: 0,0:11:05.26,0:11:08.10,Main,Brook,0,0,0,,Anlıyorum. Epey deneyim yaşamışsınız.
Dialogue: 0,0:11:08.34,0:11:14.86,Main,Luffy,0,0,0,,Hey, kalamar! Sen olduğunu bildiğimize\Ngöre kurtarmamız mümkün değil!
Dialogue: 0,0:11:17.84,0:11:19.88,Main,Luffy,0,0,0,,A-Ama...
Dialogue: 0,0:11:20.64,0:11:25.92,Main,Luffy,0,0,0,,...takoyakin duyduğum kadar iyi mi?!
Dialogue: 0,0:11:26.14,0:11:28.80,Main,Sanji,0,0,0,,Hadi ama! İştahın ve mantığın\Narasına mı sıkıştın?
Dialogue: 0,0:11:28.96,0:11:30.28,Main,Zoro,0,0,0,,Ne aptalca.
Dialogue: 0,0:11:30.58,0:11:33.62,Main,Camie,0,0,0,,Yoksa Hacchin'i tanıyor musunuz?
Dialogue: 0,0:11:33.98,0:11:36.14,Main,Camie,0,0,0,,Hacchin eski bir arkadaşınız mı?
Dialogue: 0,0:11:36.32,0:11:38.58,Main,Zoro,0,0,0,,Arkadaşımız değil!
Dialogue: 0,0:11:41.28,0:11:42.76,Main,Usopp,0,0,0,,Gemiyi çevirin!
Dialogue: 0,0:11:44.58,0:11:45.48,Main,Camie,0,0,0,,Nami-chin...
Dialogue: 0,0:11:46.46,0:11:48.10,Main,Nami,0,0,0,,Üzgünüm Caimie,...
Dialogue: 0,0:11:48.26,0:11:51.79,Main,Nami,0,0,0,,...arkadaşının o adam\Nolduğunu hiç düşünmemiştik.
Dialogue: 0,0:11:52.18,0:11:53.10,Main,Camie,0,0,0,,Olamaz...
Dialogue: 0,0:11:53.94,0:11:57.00,Main,Camie,0,0,0,,O zaman onu kurtarmama\Nyardım etmeyecek misiniz?
Dialogue: 0,0:11:57.26,0:11:58.54,Main,Camie,0,0,0,,Hacchin!
Dialogue: 0,0:11:58.62,0:12:03.04,Main,Hachi,0,0,0,,Caimie! Sorun değil! Geri dönün!\NBu bir tuzak!
Dialogue: 0,0:12:03.42,0:12:07.34,Main,Camie,0,0,0,,Hayır, seni kurtaracağım.
Dialogue: 0,0:12:08.10,0:12:11.86,Main,Camie,0,0,0,,Hacchin, sonuçta sen\Nbizi hep kurtarıyorsun!
Dialogue: 0,0:12:11.94,0:12:12.84,Main,Camie,0,0,0,,Pappag!
Dialogue: 0,0:12:13.00,0:12:18.54,Main,Pappag,0,0,0,,Doğru! Sizin bu kadar hissiz ahmaklar\Nolabileceğinizi hiç düşünmemiştim!
Dialogue: 0,0:12:18.66,0:12:20.66,Main,Pappag,0,0,0,,Aptallar! Aptallar!
Dialogue: 0,0:12:20.74,0:12:21.48,Main,Zoro,0,0,0,,Kapa çeneni!
Dialogue: 0,0:12:22.20,0:12:23.94,Main,Pappag,0,0,0,,Bekle bizi, Hachi!
Dialogue: 0,0:12:24.06,0:12:26.50,Main,Camie,0,0,0,,Seni kesinlikle terk etmeyeceğiz, Hacchin!
Dialogue: 0,0:12:26.94,0:12:27.60,Main,Pappag and Camie,0,0,0,,Geliyoruz!
Dialogue: 0,0:12:29.52,0:12:30.46,Main,Sanji,0,0,0,,Camie-chan!
Dialogue: 0,0:12:31.64,0:12:34.30,Main,Fishmen,0,0,0,,Şimdi seni yakaladık, Caimie!
Dialogue: 0,0:12:34.58,0:12:37.04,Main,Usopp,0,0,0,,Hadi ama bu çok zavallıca!
Dialogue: 0,0:12:38.02,0:12:39.78,Main,Macro,0,0,0,,Artık zengin olacağız!
Dialogue: 0,0:12:40.00,0:12:42.74,Main,Gyaro,0,0,0,,Seni her zaman kurtaran\NHachi de elimizde!!
Dialogue: 0,0:12:42.88,0:12:45.36,Main,Tansui,0,0,0,,Kaçamayacaksın, Caimie!
Dialogue: 0,0:12:50.26,0:12:53.98,Main,Hachi,0,0,0,,Bu yüzden kaçın demiştim! Caimie! Pappagg!
Dialogue: 0,0:12:54.16,0:12:57.64,Main,Sanji,0,0,0,,Lanet olasıcalar, Caimie hiçbir şey yapmadı!
Dialogue: 0,0:12:57.70,0:12:59.08,Main,Nami,0,0,0,,Dur, Sanji-kun!
Dialogue: 0,0:13:08.00,0:13:10.44,Main,Nami,0,0,0,,Tamam, Hachi'yi de kurtaralım.
Dialogue: 0,0:13:11.88,0:13:15.56,Main,Nami,0,0,0,,Hachi o kadar da kötü değil.\NAslında zararsız!
Dialogue: 0,0:13:15.82,0:13:20.16,Main,Nami,0,0,0,,Ayrıca Caimie'ye de söz verdik.
Dialogue: 0,0:13:20.92,0:13:25.84,Main,Sanji,0,0,0,,N-Nami-swan. O sağlam ve azimli\Ngörünüşün mükemmel!
Dialogue: 0,0:13:25.96,0:13:26.86,Main,Usopp,0,0,0,,Hey, Nami...
Dialogue: 0,0:13:27.22,0:13:28.20,Main,Zoro,0,0,0,,Emin misin?
Dialogue: 0,0:13:28.30,0:13:29.00,Main,Nami,0,0,0,,
Dialogue: 0,0:13:29.96,0:13:30.72,Main,Nami,0,0,0,,Luffy!
Dialogue: 0,0:13:31.26,0:13:33.58,Main,Luffy,0,0,0,,Öyle diyorsan, sanırım başka çare yok.
Dialogue: 0,0:13:34.06,0:13:35.64,Main,Luffy,0,0,0,,Ahtapotu da kurtaralım.
Dialogue: 0,0:13:36.36,0:13:38.60,Main,Usopp,0,0,0,,Gözlerin takoyakiye dönmüş!
Dialogue: 0,0:13:40.82,0:13:43.37,Main,Duval,0,0,0,,Hazırlıklar tamam mı,...
Dialogue: 0,0:13:44.32,0:13:46.27,Main,Duval,0,0,0,,...Uçan Balık Binicileri?
Dialogue: 0,0:13:50.50,0:13:52.04,Main,Riders,0,0,0,,Elbette, her zaman hazırız!
Dialogue: 0,0:13:52.30,0:13:54.28,Main,Luffy,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:13:54.56,0:13:56.21,Main,Luffy,0,0,0,,{\fad(150,150)}...Tabanca!
Dialogue: 0,0:13:57.36,0:13:58.82,Main,Luffy,0,0,0,,Durun biraz!
Dialogue: 0,0:14:01.88,0:14:03.14,Main,Macro,0,0,0,,Şeytan Meyvesi kullanıcısı mı?!
Dialogue: 0,0:14:04.76,0:14:05.72,Main,Hachi,0,0,0,,Hasır Şapka?
Dialogue: 0,0:14:08.84,0:14:10.28,Main,Macro,0,0,0,,Lanet olası!
Dialogue: 0,0:14:10.40,0:14:11.38,Main,Camie,0,0,0,,Luffy-chin!
Dialogue: 0,0:14:11.48,0:14:12.58,Main,Pappag,0,0,0,,Sen!
Dialogue: 0,0:14:12.70,0:14:15.53,Main,Luffy,0,0,0,,Tamam! Onları geri aldım!
Dialogue: 0,0:14:15.94,0:14:21.78,Main,Hachi,0,0,0,,Hasır Şapka! Çok teşekkür ederim!\NSana borçluyum!
Dialogue: 0,0:14:21.92,0:14:25.14,Main,Luffy,0,0,0,,Zoro! Ahtapotun iplerini ve kafesini kes!
Dialogue: 0,0:14:27.10,0:14:27.78,Main,Zoro,0,0,0,,Tamam!
Dialogue: 0,0:14:28.26,0:14:31.20,Main,Hachi,0,0,0,,Hasır Şapka! Dikkatli ol!
Dialogue: 0,0:14:31.54,0:14:33.42,Main,Hachi,0,0,0,,Çoktan tuzağa düştün!
Dialogue: 0,0:14:33.54,0:14:37.14,Main,Hachi,0,0,0,,Uçan Balık Binicileri etrafınızı sardı!
Dialogue: 0,0:14:37.38,0:14:38.58,Main,Duval,0,0,0,,Saldırın!
Dialogue: 0,0:14:38.90,0:14:39.72,Main,Riders,0,0,0,,Emredersiniz!
Dialogue: 0,0:14:40.84,0:14:42.08,Main,Camie,0,0,0,,Luffy-chin...
Dialogue: 0,0:14:42.92,0:14:45.48,Main,Luffy,0,0,0,,Denizden veya gökten fark etmez,\Nonlar için hazırız!
Dialogue: 0,0:14:46.42,0:14:47.80,Main,Luffy,0,0,0,,Canlarına okuyacağız!
Dialogue: 0,0:14:50.10,0:14:52.18,Main,Luffy,0,0,0,,Arkadaşlar!
Dialogue: 0,0:14:54.80,0:14:58.98,Main,Luffy,0,0,0,,Dövüşe hazırlanın!
Dialogue: 0,0:15:00.26,0:15:02.95,Main,Crew,0,0,0,,Tamam!
Dialogue: 0,0:15:05.04,0:15:09.96,Main,Macro,0,0,0,,Kahretsin, fırsatımız varken\NCaimie'yi geri alalım!
Dialogue: 0,0:15:11.16,0:15:14.98,Main,Hachi,0,0,0,,Caimie! Pappag! Bu çok tehlikeli!\NGeride durun!
Dialogue: 0,0:15:15.90,0:15:19.68,Main,Camie,0,0,0,,Hakla onları! Hadi, Luffy-chin!
Dialogue: 0,0:15:19.86,0:15:21.56,Main,Luffy,0,0,0,,Gelin bakalım, Uçan Balıklar!
Dialogue: 0,0:15:21.68,0:15:23.38,Main,Camie and Pappag,0,0,0,,Hakla onları, hakla onları, hadi hadi!
Dialogue: 0,0:15:28.00,0:15:28.86,Main,Usopp,0,0,0,,Geldiler!
Dialogue: 0,0:15:29.60,0:15:30.70,Main,Chopper; Sanji & Zoro,0,0,0,,Tamam!
Dialogue: 0,0:15:56.62,0:15:59.50,Main,Luffy,0,0,0,,Peki, peki... En taze balık kimde?
Dialogue: 0,0:16:01.94,0:16:03.28,Main,Luffy,0,0,0,,Tamam! O!
Dialogue: 0,0:16:09.08,0:16:10.76,Main,Luffy,0,0,0,,Yakaladım!
Dialogue: 0,0:16:11.14,0:16:11.94,Main,Riders,0,0,0,,Ne?
Dialogue: 0,0:16:12.16,0:16:13.02,Main,Luffy,0,0,0,,Sıra bende!
Dialogue: 0,0:16:13.12,0:16:14.12,Main,Rider,0,0,0,,D-Dur!
Dialogue: 0,0:16:18.96,0:16:20.22,Main,Luffy,0,0,0,,Bu müthiş!
Dialogue: 0,0:16:20.70,0:16:25.06,Main,Luffy,0,0,0,,Hey! Uçuyorum!
Dialogue: 0,0:16:25.70,0:16:27.76,Main,Chopper,0,0,0,,Luffy o şeylerden birine mi binmiş?!
Dialogue: 0,0:16:28.28,0:16:29.22,Main,Sanji,0,0,0,,Boş ver onu.
Dialogue: 0,0:16:29.46,0:16:31.02,Main,Rider,0,0,0,,Alın bakalım!
Dialogue: 0,0:16:33.48,0:16:34.20,Main,Usopp,0,0,0,,Bombalar!
Dialogue: 0,0:16:36.56,0:16:37.28,Main,Riders,0,0,0,,Kahretsin!
Dialogue: 0,0:16:37.62,0:16:40.14,Main,Usopp,0,0,0,,Çok yakındı!
Dialogue: 0,0:16:40.46,0:16:44.40,Main,Sanji,0,0,0,,Üfff. Onunla bir hanıma vursalardı,\Nyaşamalarına izin vermezdim.
Dialogue: 0,0:16:44.72,0:16:46.70,Main,Nami,0,0,0,,Yelkenleri toplayın! Bize engel olacaklar!
Dialogue: 0,0:16:48.82,0:16:49.66,Main,Rider,0,0,0,,Herkes dalsın!
Dialogue: 0,0:16:49.84,0:16:50.66,Main,Riders,0,0,0,,Anlaşıldı!
Dialogue: 0,0:16:58.80,0:16:59.58,Main,Chopper,0,0,0,,Luffy!
Dialogue: 0,0:16:59.68,0:17:00.72,Main,Brook,0,0,0,,Luffy-san!
Dialogue: 0,0:17:08.56,0:17:11.84,Main,Franky,0,0,0,,Dövüşün ortasındayız,\Nne yaptığını sanıyorsun?!
Dialogue: 0,0:17:13.10,0:17:14.24,Main,Luffy,0,0,0,,Üzgünüm.
Dialogue: 0,0:17:15.78,0:17:20.58,Main,Franky,0,0,0,,Peki siz niye onu kurtarmaya çalışıyorsunuz?\NSiz de Şeytan Meyvesi kullanıcısısınız, değil mi?!
Dialogue: 0,0:17:23.38,0:17:25.12,Main,Chopper,0,0,0,,Üzgünüm.
Dialogue: 0,0:17:27.32,0:17:30.88,Main,Brook,0,0,0,,Sizin de başınızı derde soktum galiba.
Dialogue: 0,0:17:31.00,0:17:37.44,Main,Nami,0,0,0,,Üç çekici birden kurtarmamız\Ngerekince daha da zor oluyor!
Dialogue: 0,0:17:38.72,0:17:40.74,Main,Nami,0,0,0,,Aptal, vaktimi harcamayın!
Dialogue: 0,0:17:43.46,0:17:44.74,Main,Camie and Pappag,0,0,0,,Macro tayfası!
Dialogue: 0,0:17:44.92,0:17:47.66,Main,Macro,0,0,0,,Fırsatımız varken Caimie'yi geri alalım!
Dialogue: 0,0:17:47.82,0:17:48.54,Main,Crew,0,0,0,,Tamam!
Dialogue: 0,0:17:48.68,0:17:51.82,Main,Pappag,0,0,0,,Hey, Hasır! Bize yardım edebilir misin?
Dialogue: 0,0:17:56.88,0:18:02.44,Main,Hachi,0,0,0,,Beni iplerden ve kafesten kurtardın!\NSağol, Roronoa! İyi birisin!
Dialogue: 0,0:18:02.64,0:18:04.26,Main,Zoro,0,0,0,,Kaptanın emriydi, aptal.
Dialogue: 0,0:18:04.80,0:18:05.54,Main,Fishmen,0,0,0,,Hachi!
Dialogue: 0,0:18:05.66,0:18:07.58,Main,Camie and Pappag,0,0,0,,Hacchin!
Dialogue: 0,0:18:07.94,0:18:14.22,Main,Hachi,0,0,0,,Siz! Kıpırdayamamamdan faydalandınız\Nve beni istediğiniz gibi dövdünüz!
Dialogue: 0,0:18:15.78,0:18:21.70,Main,Tansui,0,0,0,,Seni henüz yumruklamadım, Hachi!\Nİşini Balık Adam Karate'mle bitireceğim!
Dialogue: 0,0:18:22.22,0:18:24.70,Main,Macro,0,0,0,,Cidden korkunç bir şansın var!
Dialogue: 0,0:18:26.04,0:18:29.12,Main,Macro,0,0,0,,Çeneni öyle oynatmayı bırak, lanet olsun!
Dialogue: 0,0:18:29.22,0:18:31.64,Main,Macro,0,0,0,,Senin için daha kötüsünü hazırladık!
Dialogue: 0,0:18:32.78,0:18:36.73,Main,Gyaro,0,0,0,,Gel bakalım! Sırf senin için \NSüs Balığı Eskrimi'nde yeni bir tarz geliştirdim!
Dialogue: 0,0:18:37.02,0:18:39.20,Main,Gyaro,0,0,0,,Sular kana bulanacak!
Dialogue: 0,0:18:39.36,0:18:41.52,Main,Camie,0,0,0,,Hacchin!
Dialogue: 0,0:18:43.42,0:18:45.96,Main,Hachi,0,0,0,,{\fad(150,150)}Takoyaki Yumruğu!
Dialogue: 0,0:18:48.18,0:18:51.48,Main,Fishmen,0,0,0,,Şimdilik seni bırakacağız!
Dialogue: 0,0:18:51.88,0:18:53.02,Main,Camie,0,0,0,,Hacchin!
Dialogue: 0,0:18:53.14,0:18:55.14,Main,Hachi,0,0,0,,Camie! Pappag!
Dialogue: 0,0:18:55.76,0:18:57.88,Main,Camie,0,0,0,,Hele şükür, Hacchin!
Dialogue: 0,0:18:58.44,0:19:02.64,Main,Hachi,0,0,0,,Üzgünüm, Caimie, Pappag!\NSizi kurtaracaktım!
Dialogue: 0,0:19:02.88,0:19:04.99,Main,Pappag,0,0,0,,Dert etme, Hachi!
Dialogue: 0,0:19:06.56,0:19:08.54,Main,Pappag,0,0,0,,Ah! Dikkat et!
Dialogue: 0,0:19:08.70,0:19:13.78,Main,Rider,0,0,0,,Buranın bizim bölgemiz olduğunu unutmayın!\NSonuçta en başta sizi yakalayan...
Dialogue: 0,0:19:14.24,0:19:17.42,Main,Rider,0,0,0,,...Uçan Balık Binicileri'ydi!
Dialogue: 0,0:19:24.08,0:19:24.96,Main,Hachi,0,0,0,,Roronoa!
Dialogue: 0,0:19:25.02,0:19:25.76,Main,Camie,0,0,0,,Zoro-chin!
Dialogue: 0,0:19:31.04,0:19:32.62,Main,Zoro,0,0,0,,Kendinize dikkat etmelisiniz.
Dialogue: 0,0:19:33.92,0:19:38.19,Main,Zoro,0,0,0,,Geri durun. Bunu bize bırakabilirsiniz.
Dialogue: 0,0:19:38.54,0:19:41.62,Main,Hachi,0,0,0,,Her şey için sağol, Roronoa!
Dialogue: 0,0:19:41.72,0:19:44.44,Main,Hachi,0,0,0,,O zaman olanlardan\Nötürü gerçekten üzgünüm!
Dialogue: 0,0:19:45.92,0:19:49.92,Main,Hachi,0,0,0,,Altı Kılıç Stilim'le seni kötü\Nbir şekilde yaralamıştım.
Dialogue: 0,0:19:50.10,0:19:52.60,Main,Zoro,0,0,0,,Hatırladığım kadarıyla tek\Nbir darbe bile vuramadın!
Dialogue: 0,0:19:53.30,0:19:54.71,Main,Hachi,0,0,0,,Ah, doğru.
Dialogue: 0,0:19:54.86,0:19:58.28,Main,Usopp,0,0,0,,Başardık, Chopper! Alın bakalım!
Dialogue: 0,0:19:58.36,0:19:58.96,Main,Chopper,0,0,0,,Ateş!
Dialogue: 0,0:20:03.76,0:20:06.78,Main,Usopp,0,0,0,,Tam isabet! Gördün mü, kahrolası balık?!
Dialogue: 0,0:20:06.92,0:20:08.66,Main,Chopper,0,0,0,,Usopp, müthişsin!
Dialogue: 0,0:20:09.36,0:20:12.84,Main,Duval,0,0,0,,Sıfır Dövüşü için kimse var mı?
Dialogue: 0,0:20:13.12,0:20:14.09,Main,Riders,0,0,0,,Sıfır Dövüşü mü?
Dialogue: 0,0:20:14.54,0:20:17.96,Main,Rider,0,0,0,,İlginç! Ama bu hareket bizim için\Nde hayati tehlike oluşturmuyor mu?
Dialogue: 0,0:20:18.24,0:20:21.64,Main,Rider,0,0,0,,Hastane masraflarından fazlasını\Nödeyeceğinizden emin olabilir miyim?
Dialogue: 0,0:20:21.84,0:20:23.40,Main,Duval,0,0,0,,Size bir milyon vereceğim!
Dialogue: 0,0:20:24.40,0:20:28.90,Main,Rider,0,0,0,,Yapacağım, patron! Gidiyorum!\NÇekilin, çekilin, çekilin!
Dialogue: 0,0:20:31.80,0:20:35.42,Main,Chopper,0,0,0,,Cidden iri bir adam geliyor!\NDevasa bir de sopa sallıyor.
Dialogue: 0,0:20:35.82,0:20:40.76,Main,Sanji,0,0,0,,Direksiyonu hiç tutmuyor.\NYoksa çarpışmaya mı geliyor bu?
Dialogue: 0,0:20:42.22,0:20:44.69,Main,Sanji,0,0,0,,O dev bu hızda bize vurursa gemi dayanmaz.
Dialogue: 0,0:20:45.72,0:20:47.96,Main,Sanji,0,0,0,,Luffy! Sen balıkla ilgilen.
Dialogue: 0,0:20:48.48,0:20:49.88,Main,Luffy,0,0,0,,Tabii.
Dialogue: 0,0:20:50.28,0:20:55.48,Main,Rider,0,0,0,,İlginç. Bu büyüklükte ve hızdaki\Ndarbe küçük bir meteor gibi olacak!
Dialogue: 0,0:20:55.70,0:20:58.70,Main,Chopper,0,0,0,,Sanji'nin dediği gibi\Nyönünü hiç değiştirmiyor!
Dialogue: 0,0:20:58.87,0:21:04.22,Main,Sanji,0,0,0,,Ama havadayken biraz hasarı\Nkarşılayabilecek tek kişi o değil!
Dialogue: 0,0:21:06.78,0:21:09.74,Main,Luffy,0,0,0,,{\fad(150,150)}Gomu Gomu no Balon!
Dialogue: 0,0:21:24.28,0:21:25.74,Main,Luffy,0,0,0,,Bugünkü akşam yemeğimiz olacak!
Dialogue: 0,0:21:25.92,0:21:28.13,Main,Chopper,0,0,0,,İkiniz de süperdiniz!
Dialogue: 0,0:21:28.36,0:21:30.25,Main,Robin,0,0,0,,Yakından bakınca epey büyük.
Dialogue: 0,0:21:30.90,0:21:34.72,Main,Riders,0,0,0,,Kahretsin. Bu tayfa o kadar kolay\Ndevrilecek gibi görünmüyor.
Dialogue: 0,0:21:36.66,0:21:39.64,Main,Usopp,0,0,0,,Şimdi düşünüyorum da, \Nbunlardan etrafta uçup duran bir sürü var.
Dialogue: 0,0:21:39.82,0:21:42.28,Main,Usopp,0,0,0,,Bitmesi için daha kaç tanesini yenmeliyiz?
Dialogue: 0,0:21:43.24,0:21:48.04,Main,Luffy,0,0,0,,Binmek istiyorum, lanet olsun! \NDemin olanlar yüzünden vazgeçtiğimi sanmayın!
Dialogue: 0,0:21:48.18,0:21:51.20,Main,Nami,0,0,0,,Vazgeç! Seni bir daha kurtarmayacağım!
Dialogue: 0,0:21:52.00,0:21:53.32,Main,Brook,0,0,0,,Bu nasıl olabilir?
Dialogue: 0,0:21:54.10,0:21:55.30,Main,Luffy,0,0,0,,Ne oldu, Brook?
Dialogue: 0,0:21:55.74,0:22:01.08,Main,Brook,0,0,0,,Hasır Şapka Tayfası'nın bir üyesi olarak\Nilk gerçek eylemimin boğulmak olması...
Dialogue: 0,0:22:01.98,0:22:04.94,Main,Brook,0,0,0,,Size yardım etmeseydim\Nutanç verici olurdu!
Dialogue: 0,0:22:05.76,0:22:11.60,Main,Brook,0,0,0,,Uçan Balıklar'ın sayısını\Nazaltma vakti geldi.
Dialogue: 0,0:22:12.22,0:22:14.12,Main,Brook,0,0,0,,Lütfen seyredin!
Dialogue: 0,0:22:18.02,0:22:19.30,Main,Chopper,0,0,0,,Ne inanılmaz bir zıplama!
Dialogue: 0,0:22:22.00,0:22:23.66,Main,Rider,0,0,0,,İskelet maskeli adam ne yapıyor?
Dialogue: 0,0:22:24.18,0:22:26.00,Main,Rider,0,0,0,,Seni şişe geçireceğiz!
Dialogue: 0,0:22:26.58,0:22:27.61,Main,Brook,0,0,0,,{\fad(150,150)}Ninni
Dialogue: 0,0:22:28.38,0:22:29.12,Main,Brook,0,0,0,,{\fad(150,150)}Savuşturma!
Dialogue: 0,0:22:35.70,0:22:37.40,Main,Chopper,0,0,0,,Müthiş! Uyuyup kaldılar.
Dialogue: 0,0:22:38.16,0:22:39.64,Main,Nami,0,0,0,,Siz de mi?!
Dialogue: 0,0:22:44.06,0:22:46.76,Main,Brook,0,0,0,,Müzik, güçtür!
Dialogue: 0,0:22:46.98,0:22:47.78,Main,Brook,0,0,0,,Afedersiniz!
Dialogue: 0,0:22:49.74,0:22:51.10,Main,Riders,0,0,0,,Uyuyup kaldık!
Dialogue: 0,0:22:53.62,0:22:55.42,Main,Rider,0,0,0,,Lanet olası, neydi o öyle?!
Dialogue: 0,0:22:55.68,0:22:58.46,Main,Rider,0,0,0,,Pis bir numara kullandı!
Dialogue: 0,0:22:59.58,0:23:01.39,Main,Brook,0,0,0,,Numara değil!
Dialogue: 0,0:23:02.30,0:23:03.56,Main,Brook,0,0,0,,Müzik!
Dialogue: 0,0:23:05.86,0:23:06.90,Main,Riders,0,0,0,,Dur!
Dialogue: 0,0:23:07.96,0:23:09.84,Main,Luffy,0,0,0,,Bu Brook epey iyi!
Dialogue: 0,0:23:10.32,0:23:12.94,Main,Luffy,0,0,0,,Eğlenceli görünüyor. Ben de geliyorum!
Dialogue: 0,0:23:13.80,0:23:16.12,Main,Nami,0,0,0,,Dur, Luffy! Yine mi?!
Dialogue: 0,0:23:18.04,0:23:22.60,Main,Luffy,0,0,0,,Tamam, yakaladım seni! \NTekrar dalarsan affetmeyeceğim!
Dialogue: 0,0:23:24.24,0:23:26.38,Main,Luffy,0,0,0,,Hey, uyuyor musun?!
Dialogue: 0,0:23:26.66,0:23:28.88,Main,Luffy,0,0,0,,Hey, hey! Uyan!
Dialogue: 0,0:23:33.30,0:23:35.44,Main,Rider,0,0,0,,O herif Patron'un odasına daldı!
Dialogue: 0,0:24:00.72,0:24:01.86,Main,Duval,0,0,0,,Gördün mü?
Dialogue: 0,0:24:02.80,0:24:03.52,Main,Luffy,0,0,0,,Sen!
Dialogue: 0,0:24:08.20,0:24:10.68,Main,Duval,0,0,0,,Beni tanıyor gibisin.
