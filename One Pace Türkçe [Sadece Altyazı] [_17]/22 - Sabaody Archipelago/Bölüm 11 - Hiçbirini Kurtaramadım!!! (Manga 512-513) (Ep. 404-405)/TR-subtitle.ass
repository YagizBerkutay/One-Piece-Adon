0000000,&H78000000,0,-1,0,0,100,100,0,0,1,1.5,1.5,2,120,120,18,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:31.89,0:00:37.27,Credits,,22,0,0,,Translation YibisDialogue: 0,0:00:31.89,0:00:37.27,Credits,,22,0,0,,Soundtracking HaleeDialogue: 0,0:00:37.38,0:00:42.14,Credits,,22,0,0,,Editing FeesoDialogue: 0,0:00:37.38,0:00:42.14,Credits,,22,0,0,,Infoboxes BernieCraneDialogue: 0,0:00:37.38,0:00:42.14,Credits,,22,0,0,,Formatting Sewil DatenshiDialogue: 0,0:00:37.38,0:00:42.14,Credits,,22,0,0,,Edit-checking Galaxy 9000Dialogue: 0,0:00:05.30,0:00:09.17,Lyrics,,0,0,0,,♪ Gökyüzüne ulaşana kadar, ♪Dialogue: 0,0:00:09.27,0:00:15.71,Lyrics,,0,0,0,,♪ İnanıyorum, sonraki yarına kadar, hey ♪Dialogue: 0,0:00:15.73,0:00:19.13,Lyrics,,0,0,0,,♪ hadi millet gidelim, müziği paylaşıyoruz. ♪Dialogue: 0,0:00:19.96,0:00:23.36,Lyrics,,0,0,0,,♪ hadi gidelim bebeğim, bebeğim, oh tek bir hayali paylaşıyoruz. ♪Dialogue: 0,0:00:23.88,0:00:27.28,Lyrics,,0,0,0,,♪ hadi millet gidelim, oh iyi zamanları paylaşıyoruz. ♪Dialogue: 0,0:00:27.71,0:00:31.11,Lyrics,,0,0,0,,♪ hadi gidelim bebeğim, bebeğim, oh tek bir dünyayı paylaşıyoruz. ♪Dialogue: 0,0:00:31.81,0:00:35.55,Lyrics,,0,0,0,,♪ Mobius yüzüğünün tepesinde kovalıyor ve kovalanıyor. ♪Dialogue: 0,0:00:35.58,0:00:39.35,Lyrics,,0,0,0,,♪ Yaklaşıyor ve ileri bakıyorum, hey tarzını paylaşmak istiyorum. ♪Dialogue: 0,0:00:39.52,0:00:43.45,Lyrics,,0,0,0,,♪ Başlıyor, genişliyor, hayal gücünün üstündeki bu tat. ♪Dialogue: 0,0:00:43.52,0:00:47.76,Lyrics,,0,0,0,,♪ Vücudumu baştan başa iyi hissediyorum, özgür kalacağım, oh evet ♪Dialogue: 0,0:00:47.79,0:00:49.79,Lyrics,,0,0,0,,♪ Uzakta olsa da, müziği paylaş. ♪Dialogue: 0,0:00:49.79,0:00:51.73,Lyrics,,0,0,0,,♪ Birbirine anlatarak o rüyayı paylaş. ♪Dialogue: 0,0:00:51.76,0:00:53.60,Lyrics,,0,0,0,,♪ İyi zamanları ve kahkahaları paylaş. ♪Dialogue: 0,0:00:53.72,0:00:55.27,Lyrics,,0,0,0,,♪ şimdi tek bir dünyayı paylaş. ♪Dialogue: 0,0:00:55.45,0:01:03.74,Lyrics,,0,0,0,,♪ Gökyüzüne ulaşana kadar gitmeye devam edeceğim. ♪Dialogue: 0,0:01:03.81,0:01:13.05,Lyrics,,0,0,0,,♪ Hadi üstesinden gelelim, sonraki yarınlara inanıyorum, evet evet... ♪Dialogue: 0,0:01:13.15,0:01:21.56,Lyrics,,0,0,0,,♪ Görünmez duvarın diğer tarafında bekliyordun. ♪Dialogue: 0,0:01:21.66,0:01:31.62,Lyrics,,0,0,0,,♪ Yakında orada olacağım, tek bir dünyaya inanıyorum, evet evet... ♪Dialogue: 0,0:01:31.64,0:01:35.04,Lyrics,,0,0,0,,♪ hadi millet gidelim, müziği paylaşıyoruz. ♪Dialogue: 0,0:01:35.67,0:01:39.87,Lyrics,,0,0,0,,♪ hadi gidelim bebeğim, bebeğim, oh tek bir dünyayı paylaşıyoruz. ♪Dialogue: 0,0:01:42.76,0:01:51.27,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:09:30.00,0:09:40.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:23:35.60,0:23:42.80,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:01:42.76,0:01:51.27,Title,,0,0,250,,Hiçbirini Kurtaramadım!!!Dialogue: 0,0:01:42.28,0:01:47.14,Main,Kizaru,0,0,0,,Bu adada olduğuna dair söylentiler duymuştum.Dialogue: 0,0:01:47.44,0:01:50.00,Main,Kizaru,0,0,0,,Demek doğruymuş.Dialogue: 0,0:01:50.26,0:01:52.88,Main,Kizaru,0,0,0,,Bu veletlere nasıl yardım ettiğine bakarsak...Dialogue: 0,0:01:52.98,0:01:55.86,Main,Kizaru,0,0,0,,...şu yaşına rağmen hala korsansın demektir,...Dialogue: 0,0:01:56.00,0:01:57.52,Main,Kizaru,0,0,0,,...Rayleigh-san.Dialogue: 0,0:01:57.84,0:02:01.82,Main,Rayleigh,0,0,0,,Ödülümü geri çekseydiniz...Dialogue: 0,0:02:02.06,0:02:05.60,Main,Rayleigh,0,0,0,,...ben de huzur içinde emekli olabilirdim.Dialogue: 0,0:02:05.86,0:02:08.44,Main,Kizaru,0,0,0,,Korsanların günahları kaybolmayacak, değil mi?Dialogue: 0,0:02:08.72,0:02:10.84,Main,Kizaru,0,0,0,,Özellkle de Roger Korsanları'nın.Dialogue: 0,0:02:11.42,0:02:14.08,Main,Kizaru,0,0,0,,Ama seni yakalamaya çalışsaydık,...Dialogue: 0,0:02:14.20,0:02:18.24,Main,Kizaru,0,0,0,,...şu anda sahip olduğumuzdan  daha fazla özveri gerekirdi.Dialogue: 0,0:02:19.43,0:02:23.44,Main,Usopp,0,0,0,,Hele şükür, Zoro!  Bu yaşlı adam gerçekten müthiş!Dialogue: 0,0:02:23.92,0:02:26.94,Main,Brook,0,0,0,,Tüm uğraşlarıma rağmen delemediğim vücudu...Dialogue: 0,0:02:27.56,0:02:30.18,Main,Brook,0,0,0,,...o durdurdu! Nasıl?!Dialogue: 0,0:02:31.17,0:02:35.24,Main,Rayleigh,0,0,0,,Onları bırakamazsın, değil mi, Kizaru-kun?Dialogue: 0,0:02:35.62,0:02:38.04,Main,Kizaru,0,0,0,,Beni bir rahat bırak!Dialogue: 0,0:02:38.27,0:02:40.80,Main,Kizaru,0,0,0,,Bu çocukları yakalayamazsak...Dialogue: 0,0:02:40.92,0:02:47.62,Main,Kizaru,0,0,0,,...Donanma Karargâhı olarak, Mariejoa'daki Kutsal Ejderler'in yüzüne bakamayız.Dialogue: 0,0:02:47.76,0:02:49.88,Main,Kizaru,0,0,0,,Lütfen yolumdan çekilir misin?Dialogue: 0,0:02:50.14,0:02:52.65,Main,Luffy,0,0,0,,Usopp! Brook!Dialogue: 0,0:02:53.94,0:02:56.21,Main,Luffy,0,0,0,,Zoro'yu alın ve kaçın!Dialogue: 0,0:02:56.50,0:02:57.28,Main,Usopp,0,0,0,,Tamam!Dialogue: 0,0:02:57.54,0:02:59.02,Main,Usopp,0,0,0,,Gidelim, Brook!Dialogue: 0,0:03:00.19,0:03:03.38,Main,Luffy,0,0,0,,Hepiniz sadece nasıl kaçacağınızı düşünün!Dialogue: 0,0:03:04.63,0:03:05.94,Main,Luffy,0,0,0,,Şu anda...Dialogue: 0,0:03:06.76,0:03:07.80,Main,Luffy,0,0,0,,...bu insanları...Dialogue: 0,0:03:08.74,0:03:10.06,Main,Luffy,0,0,0,,...yenemeyiz!Dialogue: 0,0:03:10.74,0:03:14.30,Main,Kizaru,0,0,0,,Oh, harika. Bu gerçekten sinir bozucu.Dialogue: 0,0:03:14.92,0:03:15.72,Main,Nami,0,0,0,,Franky!Dialogue: 0,0:03:15.90,0:03:18.52,Main,Franky,0,0,0,,Tüm kola enerjimi kullanacağım.Dialogue: 0,0:03:18.84,0:03:20.62,Main,Franky,0,0,0,,Bu son saldırım olacak!Dialogue: 0,0:03:21.36,0:03:23.64,Main,Franky,0,0,0,,Rüzgar Vuruşu!Dialogue: 0,0:03:27.78,0:03:30.00,Main,Franky,0,0,0,,Kahrolası aptal bunu hissetmiş olmalı!Dialogue: 0,0:03:30.06,0:03:30.98,Main,Franky,0,0,0,,Koşun!Dialogue: 0,0:03:33.03,0:03:34.94,Main,Luffy,0,0,0,,Amca, sağol!Dialogue: 0,0:03:35.30,0:03:37.12,Main,Rayleigh,0,0,0,,Sorun değil!  Güvenliğiniz için dua edeceğim!Dialogue: 0,0:03:38.34,0:03:40.32,Main,Kizaru,0,0,0,,Yata Aynası.Dialogue: 0,0:03:44.78,0:03:45.60,Main,Usopp,0,0,0,,Çok parlak!Dialogue: 0,0:03:45.92,0:03:48.16,Main,Brook,0,0,0,,Işık! Bir şey yapıyor!Dialogue: 0,0:03:52.52,0:03:54.12,Main,Rayleigh,0,0,0,,Geçmene izin vermeyeceğim!Dialogue: 0,0:03:54.94,0:03:56.84,Main,Rayleigh,0,0,0,,Kılıcımı kullanmayalı uzun zaman oldu.Dialogue: 0,0:03:57.46,0:03:59.46,Main,Kizaru,0,0,0,,Cennetin Bulutlarını Toplayan KılıçDialogue: 0,0:04:05.24,0:04:07.24,Main,Kizaru,0,0,0,,Başım dertte galiba.Dialogue: 0,0:04:07.44,0:04:11.32,Main,Kizaru,0,0,0,,Adaya geldiğimde işlerin kolay olmasını umuyordum.Dialogue: 0,0:04:12.04,0:04:15.14,Main,Rayleigh,0,0,0,,Endişeler de hayatın bir parçasıdır, Kizaru-kun.Dialogue: 0,0:04:15.84,0:04:18.10,Main,Brook,0,0,0,,Önümüzdeki ışık kayboldu.Dialogue: 0,0:04:18.26,0:04:20.14,Main,Usopp,0,0,0,,Yaşlı adam bizi yine kurtarmış gibi.Dialogue: 0,0:04:20.28,0:04:22.34,Main,Brook,0,0,0,,K-K-Korkutucu!Dialogue: 0,0:04:25.68,0:04:28.62,Main,Sentoumaru,0,0,0,,Gerçek Kara Kral gibi görünüyor.Dialogue: 0,0:04:28.90,0:04:32.14,Main,Sentoumaru,0,0,0,,İlk kez yaşlı adamı durduran birini görüyorum.Dialogue: 0,0:04:32.34,0:04:35.78,Main,Sentoumaru,0,0,0,,Ama ödülü 100 milyonun üstünde olan  Roronoa Zoro'yu yakalamanın bir adım ötesindeyiz.Dialogue: 0,0:04:37.22,0:04:39.92,Main,Sentoumaru,0,0,0,,PX-1! Roronoa yarı ölü!Dialogue: 0,0:04:40.04,0:04:41.20,Main,Sentoumaru,0,0,0,,Onun işini bitir!Dialogue: 0,0:04:52.70,0:04:53.82,Main,Sanji,0,0,0,,O...Dialogue: 0,0:04:54.10,0:04:54.84,Main,Sanji,0,0,0,,Franky!Dialogue: 0,0:04:55.32,0:04:58.08,Main,Sanji,0,0,0,,Nami-san'la ilgilen! Lütfen bensiz gidin!Dialogue: 0,0:04:58.22,0:05:00.82,Main,Franky,0,0,0,,Dikkatli ol! Bizde sorun yok!Dialogue: 0,0:05:01.18,0:05:02.16,Main,Nami,0,0,0,,Sanji-kun?!Dialogue: 0,0:05:02.50,0:05:04.52,Main,Sanji,0,0,0,,Usopplar'ın peşinden gidiyor!Dialogue: 0,0:05:08.80,0:05:09.60,Main,Zoro,0,0,0,,Beni yere bırak.Dialogue: 0,0:05:11.98,0:05:14.56,Main,Zoro,0,0,0,,Kaçmanızı sağlayacağım.Dialogue: 0,0:05:15.38,0:05:19.40,Main,Usopp,0,0,0,,Saçmalama! Şu anda benden daha işe yaramazsın!Dialogue: 0,0:05:19.52,0:05:20.88,Main,Usopp,0,0,0,,Birlikte kaçıyoruz!Dialogue: 0,0:05:21.28,0:05:23.10,Main,Usopp,0,0,0,,Luffy'nin yapmamızı istediği bu!Dialogue: 0,0:05:25.36,0:05:26.14,Main,Brook,0,0,0,,Yoksa...Dialogue: 0,0:05:27.38,0:05:30.18,Main,Usopp,0,0,0,,Geldi!Dialogue: 0,0:05:34.86,0:05:36.08,Main,Brook,0,0,0,,Usopp-san!Dialogue: 0,0:05:37.62,0:05:40.20,Main,Brook,0,0,0,,Usopp-san, önden git!Dialogue: 0,0:05:41.08,0:05:42.26,Main,Usopp,0,0,0,,Yapma, Brook!Dialogue: 0,0:05:42.50,0:05:44.58,Main,Usopp,0,0,0,,Onun ne kadar güçlü olduğunu biliyorsun, değil mi?!Dialogue: 0,0:05:44.66,0:05:45.44,Main,Brook,0,0,0,,Çabuk!Dialogue: 0,0:05:46.38,0:05:48.80,Main,Brook,0,0,0,,Hepimiz birimiz, birimiz hepimiz için!Dialogue: 0,0:05:49.32,0:05:52.76,Main,Brook,0,0,0,,Bir erkeğin harekete geçmekten başka çaresinin olmadığı zamanlar vardır!Dialogue: 0,0:05:59.36,0:06:02.04,Main,Brook,0,0,0,,Kemik kıran bir yenilgi.Dialogue: 0,0:06:02.80,0:06:04.40,Main,Usopp,0,0,0,,Brook!Dialogue: 0,0:06:06.94,0:06:10.02,Main,Usopp,0,0,0,,Gelme!Dialogue: 0,0:06:10.14,0:06:12.78,Main,Sanji,0,0,0,,Orada dur, seni kahrolası pislik!Dialogue: 0,0:06:20.62,0:06:21.44,Main,Usopp,0,0,0,,Sanji!Dialogue: 0,0:06:23.02,0:06:23.90,Main,Sanji,0,0,0,,Bacağım!Dialogue: 0,0:06:27.34,0:06:28.66,Main,Usopp,0,0,0,,Kaç, Sanji!Dialogue: 0,0:06:29.10,0:06:30.32,Main,Usopp,0,0,0,,Sana nişan alıyor!Dialogue: 0,0:06:31.98,0:06:33.78,Main,Sanji,0,0,0,,Aptal! Hemen gidin!Dialogue: 0,0:06:44.36,0:06:48.34,Main,Kizaru,0,0,0,,Gördüğün gibi adamlarım yeterince güçlü.Dialogue: 0,0:06:56.88,0:06:59.66,Main,Usopp,0,0,0,,Zoro, üzgünüm! Seni düşürdüm!Dialogue: 0,0:06:59.86,0:07:00.68,Main,Usopp,0,0,0,,İyi misin?Dialogue: 0,0:07:04.39,0:07:06.01,Main,Luffy,0,0,0,,Başları dertte!Dialogue: 0,0:07:06.45,0:07:08.23,Main,Sentoumaru,0,0,0,,Savaş baltama bile ihtiyacım olmayacak, değil mi?Dialogue: 0,0:07:09.73,0:07:13.11,Main,Sentoumaru,0,0,0,,Arkadaşların için endişelencek zamanın yok diye söylediğimi sanmıştım!Dialogue: 0,0:07:13.94,0:07:15.77,Main,Sentoumaru,0,0,0,,Kilitli Bacak, Vira!Dialogue: 0,0:07:18.79,0:07:20.01,Main,Chopper,0,0,0,,Luffy!Dialogue: 0,0:07:20.51,0:07:23.57,Main,Chopper,0,0,0,,O adamın saldırıları Luffy gibi lastik bir adama nasıl zarar verebilir?!Dialogue: 0,0:07:23.89,0:07:24.63,Main,Chopper,0,0,0,,Kahretsin!Dialogue: 0,0:07:24.78,0:07:26.75,Main,Robin,0,0,0,,Chopper! Durma!Dialogue: 0,0:07:26.99,0:07:28.67,Main,Usopp,0,0,0,,Sanji!Dialogue: 0,0:07:34.59,0:07:36.15,Main,Usopp,0,0,0,,Sanji!Dialogue: 0,0:07:48.36,0:07:51.00,Main,Chopper,0,0,0,,Kahretsin! Hepsi öldürülecek!Dialogue: 0,0:07:52.90,0:07:54.19,Main,Robin,0,0,0,,Yapma, Chopper!Dialogue: 0,0:07:55.39,0:07:57.91,Main,Choopper,0,0,0,,Kesin şunu artık!Dialogue: 0,0:07:58.07,0:07:59.61,Main,Chopper,0,0,0,,Gümbürtü!Dialogue: 0,0:08:09.06,0:08:09.97,Main,Nami,0,0,0,,Chopper!Dialogue: 0,0:08:10.69,0:08:12.27,Main,Franky,0,0,0,,O zamanki şey!Dialogue: 0,0:08:13.34,0:08:14.95,Main,Sentoumaru,0,0,0,,Bu da ne?Dialogue: 0,0:08:18.56,0:08:20.73,Main,Robin,0,0,0,,Bunu duymuştum.Dialogue: 0,0:08:28.47,0:08:30.51,Main,Sentoumaru,0,0,0,,İlginç bir güç ama...Dialogue: 0,0:08:30.75,0:08:33.59,Main,Sentoumaru,0,0,0,,...kontrolünü de kaybetmiş gibi görünüyorsun, ha?Dialogue: 0,0:08:36.22,0:08:37.60,Main,Robin,0,0,0,,Luffy, dikkat et!Dialogue: 0,0:08:50.78,0:08:53.79,Main,Usopp,0,0,0,,Chopper onu yine mi yaptı?!Dialogue: 0,0:09:01.33,0:09:04.66,Main,Usopp,0,0,0,,Niye bilmiyorum ama onun dikkatini dağıtmış gibi.Dialogue: 0,0:09:04.91,0:09:05.93,Main,Usopp,0,0,0,,Şimdi fırsatımız var!Dialogue: 0,0:09:06.49,0:09:09.53,Main,Usopp,0,0,0,,Sanji, Brook! Kalkın!Dialogue: 0,0:09:09.69,0:09:12.51,Main,Usopp,0,0,0,,Fırsatımız varken hemen ondan uzaklaşalım!Dialogue: 0,0:09:12.66,0:09:14.17,Main,Usopp,0,0,0,,Bir ışın daha fırlatacak!Dialogue: 0,0:09:18.02,0:09:20.43,Main,Usopp,0,0,0,,Hey, hemen kalk, Brook!Dialogue: 0,0:09:20.68,0:09:21.33,Main,Usopp,0,0,0,,Sanji!Dialogue: 0,0:09:26.00,0:09:28.22,Main,Kuma,0,0,0,,Dur, PX-1.Dialogue: 0,0:09:39.59,0:09:42.65,Main,Usopp,0,0,0,,Bir tane daha ortaya çıktı!Dialogue: 0,0:09:44.89,0:09:46.43,Main,Usopp,0,0,0,,Neler oluyor?!Dialogue: 0,0:09:46.76,0:09:48.27,Main,Usopp,0,0,0,,Olamaz!Dialogue: 0,0:09:48.60,0:09:52.91,Main,Usopp,0,0,0,,Bu adamlardan kaç tane var?!Dialogue: 0,0:10:02.32,0:10:03.33,Thoughts,Zoro,0,0,0,,Bu adam...Dialogue: 0,0:10:05.02,0:10:06.09,Thoughts,Zoro,0,0,0,,...gerçek olanı!Dialogue: 0,0:10:09.68,0:10:12.63,Main,Kuma,0,0,0,,Demek hayatta kaldın, Roronoa?Dialogue: 0,0:10:13.32,0:10:17.51,Main,Zoro,0,0,0,,Merhametin sayesinde.Dialogue: 0,0:10:18.06,0:10:19.29,Main,Usopp,0,0,0,,H... Hey, Zoro...Dialogue: 0,0:10:19.71,0:10:21.55,Main,Usopp,0,0,0,,Konuşacak zaman değil.Dialogue: 0,0:10:21.69,0:10:22.29,Main,Usopp,0,0,0,,Çabuk!Dialogue: 0,0:10:24.55,0:10:27.99,Main,Kuma,0,0,0,,Bir tatile çıkacak olsaydın, nereye gitmek isterdin?Dialogue: 0,0:10:29.35,0:10:31.09,Main,Usopp,0,0,0,,Hey, Zoro!Dialogue: 0,0:10:31.73,0:10:34.13,Main,Usopp,0,0,0,,Hemen kaçmazsan...Dialogue: 0,0:10:39.49,0:10:40.05,Main,Usopp,0,0,0,,Ha?Dialogue: 0,0:10:57.38,0:10:59.31,Main,Usopp,0,0,0,,Z-Zoro...Dialogue: 0,0:11:08.38,0:11:10.04,Main,Usopp,0,0,0,,Lanet olası!Dialogue: 0,0:11:10.32,0:11:11.90,Main,Usopp,0,0,0,,Zoro'ya ne yaptın?!Dialogue: 0,0:11:12.30,0:11:13.58,Main,Usopp,0,0,0,,Demin...Dialogue: 0,0:11:13.76,0:11:15.02,Main,Usopp,0,0,0,,Daha demin...Dialogue: 0,0:11:15.02,0:11:17.44,Main,Usopp,0,0,0,,...buradaydı!Dialogue: 0,0:11:25.94,0:11:26.76,Main,Luffy,0,0,0,,Zoro...?Dialogue: 0,0:11:27.97,0:11:29.50,Main,Luffy,0,0,0,,Z-Zoro?Dialogue: 0,0:11:31.13,0:11:32.21,Main,Luffy,0,0,0,,Zoro?Dialogue: 0,0:11:32.98,0:11:34.10,Main,Luffy,0,0,0,,Zoro!Dialogue: 0,0:11:36.17,0:11:39.32,Main,Luffy,0,0,0,,Zoro!!!Dialogue: 0,0:11:50.80,0:11:52.15,Main,Robin,0,0,0,,Kes şunu, Chopper!Dialogue: 0,0:11:52.40,0:11:54.04,Main,Robin,0,0,0,,Dikkatsizlik etme!Dialogue: 0,0:11:55.18,0:11:59.08,Main,Luffy,0,0,0,,Zoro, nereye gittin?!Dialogue: 0,0:12:10.42,0:12:12.28,Main,Sentoumaru,0,0,0,,Kendini kontrol edemiyor.Dialogue: 0,0:12:13.08,0:12:14.50,Main,Sentoumaru,0,0,0,,Yine de o Kuma...Dialogue: 0,0:12:15.24,0:12:17.46,Main,Sentoumaru,0,0,0,,...burada ne yapıyor?Dialogue: 0,0:12:23.28,0:12:25.46,Main,Kizaru,0,0,0,,Bartholomew Kuma...Dialogue: 0,0:12:26.68,0:12:31.16,Main,Kizaru,0,0,0,,İşte bu yüzden korsanlara güvenemezsin!Dialogue: 0,0:12:32.52,0:12:34.82,Main,Rayleigh,0,0,0,,Orada da mı etrafları sarıldı?Dialogue: 0,0:12:36.80,0:12:39.04,Main,Franky,0,0,0,,Zoro yok oldu!Dialogue: 0,0:12:39.64,0:12:42.32,Main,Franky,0,0,0,,Bu, sonunda gerçeğinin ortaya çıktığı anlamına mı geliyor?Dialogue: 0,0:12:42.44,0:12:43.98,Main,Nami,0,0,0,,Hiç şüphesiz.Dialogue: 0,0:12:44.16,0:12:46.80,Main,Nami,0,0,0,,O yeteneği daha önce gördüm...Dialogue: 0,0:12:47.54,0:12:50.12,Main,Nami,0,0,0,,Thriller Bark'tayken bir kızdan...Dialogue: 0,0:12:50.56,0:12:51.94,Main,Nami,0,0,0,,...kurtulmak için onu kullandı...Dialogue: 0,0:12:52.02,0:12:53.96,Main,Nami,0,0,0,,...ve o kız bir daha geri dönmedi!Dialogue: 0,0:13:02.70,0:13:04.72,Main,Franky,0,0,0,,Bu gerçekten kötü!Dialogue: 0,0:13:05.59,0:13:08.08,Main,Luffy,0,0,0,,Hey! Zoro'ya ne yaptı?!Dialogue: 0,0:13:08.57,0:13:09.64,Main,Luffy,0,0,0,,O nereye kayboldu?!Dialogue: 0,0:13:10.09,0:13:12.03,Main,Sentoumaru,0,0,0,,Cevap verme zorunluluğum yok.Dialogue: 0,0:13:12.61,0:13:15.44,Main,Sentoumaru,0,0,0,,Ben dünyadaki en sıkı ağızlı insanım.Dialogue: 0,0:13:16.46,0:13:19.05,Main,Sentoumaru,0,0,0,,Doğru mu yanlış mı bilmiyorum ama...Dialogue: 0,0:13:19.17,0:13:20.91,Main,Sentoumaru,0,0,0,,...onun patileri tarafından uçurulan kimsenin...Dialogue: 0,0:13:21.03,0:13:23.60,Main,Sentoumaru,0,0,0,,...üç gün üç gece boyunca gökte uçtuğu söylenir.Dialogue: 0,0:13:24.69,0:13:27.75,Main,Sentoumaru,0,0,0,,Uçurulan kişi dışında kimse nereye gideceğini bilmez...Dialogue: 0,0:13:28.37,0:13:30.29,Main,Sentoumaru,0,0,0,,Ama kesinlikle bu adada veya yakın zaman içinde...Dialogue: 0,0:13:30.70,0:13:33.56,Main,Sentoumaru,0,0,0,,...onunla karşılaşabileceğiniz bir yerde olmayacak.Dialogue: 0,0:13:34.46,0:13:36.45,Main,Sentoumaru,0,0,0,,Uzak bir denizin kıyısında da olabilirler.Dialogue: 0,0:13:36.72,0:13:37.38,Main,Luffy,0,0,0,,Ne?!Dialogue: 0,0:13:45.98,0:13:48.54,Main,Usopp,0,0,0,,Bir şey söyle, kahrolası ucube!Dialogue: 0,0:13:48.94,0:13:51.27,Main,Usopp,0,0,0,,Zoro'yu nereye gönderdin?!Dialogue: 0,0:13:52.58,0:13:54.51,Main,Sanji,0,0,0,,Demek sonunda ortaya çıktı.Dialogue: 0,0:13:54.63,0:13:55.89,Main,Sanji,0,0,0,,Gerçek Schichibukai.Dialogue: 0,0:13:56.63,0:13:58.77,Main,Sanji,0,0,0,,Birbirine benzeyen üç kişiler.Dialogue: 0,0:13:59.18,0:14:00.24,Main,Sanji,0,0,0,,Neler oluyor?!Dialogue: 0,0:14:00.73,0:14:02.63,Main,Brook,0,0,0,,G-Gerçek Schichibukai.Dialogue: 0,0:14:08.42,0:14:09.36,Main,Usopp,0,0,0,,Daha fazla yaklaşma!Dialogue: 0,0:14:10.23,0:14:12.11,Main,Usopp,0,0,0,,Kahretsin, dur!Dialogue: 0,0:14:14.58,0:14:16.55,Main,Usopp,0,0,0,,8000 tane adamım var!Dialogue: 0,0:14:16.82,0:14:18.97,Main,Usopp,0,0,0,,Hey! Beni duymuyor musun?! Daha fazla yaklaşma!Dialogue: 0,0:14:19.82,0:14:21.38,Main,Sanji,0,0,0,,Dikkat et, Usopp! Arkanda!Dialogue: 0,0:14:22.10,0:14:22.85,Main,Usopp,0,0,0,,Ark...Dialogue: 0,0:14:31.18,0:14:32.57,Main,Kuma,0,0,0,,Bu işe karışma.Dialogue: 0,0:14:40.42,0:14:42.71,Main,Sanji,0,0,0,,Kendi yoldaşından da mı kurtuldu?!Dialogue: 0,0:14:47.32,0:14:49.67,Main,Sentoumaru,0,0,0,,PX-1 de mi?!Dialogue: 0,0:14:50.21,0:14:52.97,Main,Sentoumaru,0,0,0,,Müttefiklerine ne yapıyorsun, Kuma-kou?!Dialogue: 0,0:14:56.11,0:14:58.45,Main,Luffy,0,0,0,,Üçünüz de kaçın!Dialogue: 0,0:14:59.12,0:14:59.69,Main,Usopp,0,0,0,,Luffy!Dialogue: 0,0:15:00.12,0:15:01.78,Main,Luffy,0,0,0,,Herkes kaçsın!Dialogue: 0,0:15:02.90,0:15:04.63,Main,Luffy,0,0,0,,Güvende olunca durumu düşünürüz!Dialogue: 0,0:15:05.01,0:15:07.47,Main,Luffy,0,0,0,,GİDİN!!Dialogue: 0,0:15:13.37,0:15:14.45,Main,Franky,0,0,0,,Hey, gidelim!Dialogue: 0,0:15:14.67,0:15:16.05,Main,Nami,0,0,0,,Ama Zoro...Dialogue: 0,0:15:16.16,0:15:19.12,Main,Franky,0,0,0,,Dediği gibi, bunu sonra düşünürüz!Dialogue: 0,0:15:19.21,0:15:19.97,Main,Franky,0,0,0,,Gidelim!Dialogue: 0,0:15:22.40,0:15:24.59,Main,Usopp,0,0,0,,Gidelim! Işın beni sadece sıyırdı!Dialogue: 0,0:15:24.67,0:15:26.03,Main,Usopp,0,0,0,,Seni omzumda taşıyacağım, acele edelim!Dialogue: 0,0:15:27.56,0:15:29.47,Main,Brook,0,0,0,,İkiniz dikkatli olun!Dialogue: 0,0:15:29.85,0:15:30.69,Main,Usopp,0,0,0,,Brook!Dialogue: 0,0:15:31.31,0:15:32.37,Main,Usopp,0,0,0,,Brook!!Dialogue: 0,0:15:37.75,0:15:39.21,Main,Brook,0,0,0,,Sizi koruyacağım!Dialogue: 0,0:15:39.59,0:15:41.91,Main,Brook,0,0,0,,Hayatım pahasına bile olsa!Dialogue: 0,0:15:42.02,0:15:43.34,Main,Brook,0,0,0,,Gerçi ben zaten ö...Dialogue: 0,0:15:45.87,0:15:48.19,Main,Usopp,0,0,0,,Brook!!!Dialogue: 0,0:15:54.52,0:15:57.69,Main,Sanji,0,0,0,,Kahretsin. Ne yapıyorum ben?!Dialogue: 0,0:15:58.54,0:16:00.77,Main,Sanji,0,0,0,,Arkadaşlarımın ikisi gözümün önünde yok oldu!Dialogue: 0,0:16:01.92,0:16:02.76,Main,Sanji,0,0,0,,Kahretsin!Dialogue: 0,0:16:03.56,0:16:04.63,Main,Sanji,0,0,0,,Git, Usopp!Dialogue: 0,0:16:05.84,0:16:08.19,Main,Usopp,0,0,0,,Saçmalama! Birlikte gidiyoruz, Sanji!Dialogue: 0,0:16:08.38,0:16:09.33,Main,Sanji,0,0,0,,Seni...Dialogue: 0,0:16:10.88,0:16:12.43,Main,Luffy,0,0,0,,Yapma, Sanji!Dialogue: 0,0:16:12.55,0:16:16.27,Main,Sanji,0,0,0,,Kahrolası pati pisliği!Dialogue: 0,0:16:25.20,0:16:26.53,Main,Luffy,0,0,0,,Sanji!Dialogue: 0,0:16:36.76,0:16:38.15,Main,Usopp,0,0,0,,Yaklaşma!Dialogue: 0,0:16:42.08,0:16:42.62,Main,Usopp,0,0,0,,Gelme!Dialogue: 0,0:16:42.78,0:16:43.47,Main,Usopp,0,0,0,,Yaklaşma!Dialogue: 0,0:16:43.68,0:16:44.24,Main,Usopp,0,0,0,,Barut Yıldızı!Dialogue: 0,0:16:44.36,0:16:45.32,Main,Usopp,0,0,0,,Barut Yıldızı!Dialogue: 0,0:16:47.28,0:16:47.78,Main,Usopp,0,0,0,,Kahretsin!Dialogue: 0,0:16:48.12,0:16:49.06,Main,Usopp,0,0,0,,Barut Yıldızı!Dialogue: 0,0:16:49.32,0:16:50.26,Main,Usopp,0,0,0,,Barut Yıldızı!Dialogue: 0,0:16:51.14,0:16:52.20,Main,Usopp,0,0,0,,Barut Yıldızı!Dialogue: 0,0:16:52.26,0:16:53.46,Main,Usopp,0,0,0,,Barut Yıldızı!Dialogue: 0,0:16:56.18,0:16:57.14,Main,Sanji,0,0,0,,Usopp!Dialogue: 0,0:16:59.38,0:17:00.08,Main,Luffy,0,0,0,,Kaç!Dialogue: 0,0:17:00.16,0:17:01.54,Main,Luffy,0,0,0,,Kaç!!Dialogue: 0,0:17:10.98,0:17:12.50,Main,Luffy,0,0,0,,Usopp!Dialogue: 0,0:17:14.40,0:17:15.06,Main,Luffy,0,0,0,,Sanji?Dialogue: 0,0:17:17.66,0:17:20.48,Main,Sanji,0,0,0,,Kahretsin!Dialogue: 0,0:17:21.22,0:17:24.24,Main,Luffy,0,0,0,,Yapma, Sanji!Dialogue: 0,0:17:32.46,0:17:33.74,Main,Luffy,0,0,0,,Sanji bile...Dialogue: 0,0:17:34.18,0:17:35.14,Main,Luffy,0,0,0,,Neler oluyor?Dialogue: 0,0:17:35.26,0:17:36.36,Main,Luffy,0,0,0,,Ne yapacağız?Dialogue: 0,0:17:37.78,0:17:38.80,Main,Nami,0,0,0,,Olamaz!Dialogue: 0,0:17:39.08,0:17:40.06,Main,Nami,0,0,0,,Herkes...Dialogue: 0,0:17:46.94,0:17:49.82,Main,Rayleigh,0,0,0,,Oradaki durum epey umutsuz görünüyor.Dialogue: 0,0:17:50.40,0:17:54.92,Main,Rayleigh,0,0,0,,Yardım etmek isterdim ama fazla yaşlıyım.Dialogue: 0,0:17:55.50,0:17:59.72,Main,Kizaru,0,0,0,,Kendi başına domanma amiralini tutmana rağmen daha fazlasını mı yapmak istiyorsun?Dialogue: 0,0:17:59.98,0:18:04.92,Main,Kizaru,0,0,0,,Kötü görünmeme neden oluyorsun, bu yüzden kes artık şunu!Dialogue: 0,0:18:13.40,0:18:15.12,Main,Kuma,0,0,0,,Sen, "Kara Kral" Rayleigh'sin, değil mi?Dialogue: 0,0:18:15.20,0:18:15.66,Main,Rayleigh,0,0,0,,Ha?Dialogue: 0,0:18:19.70,0:18:20.96,Main,Kizaru,0,0,0,,Kuma?Dialogue: 0,0:18:29.72,0:18:30.66,Main,Robin,0,0,0,,Luffy?Dialogue: 0,0:18:32.58,0:18:35.96,Main,Rayleigh,0,0,0,,Söylediğine gerçekten inanmamı mı bekliyorsun?Dialogue: 0,0:18:36.68,0:18:38.28,Main,Kuma,0,0,0,,Buna kendin karar ver.Dialogue: 0,0:18:39.00,0:18:41.40,Main,Kuma,0,0,0,,Zaten kendi konumumu tehlikeye sokuyorum.Dialogue: 0,0:18:42.18,0:18:47.06,Main,Kizaru,0,0,0,,Ne yapmayı planlıyorsun, Kuma?Dialogue: 0,0:18:47.92,0:18:50.74,Main,Kum