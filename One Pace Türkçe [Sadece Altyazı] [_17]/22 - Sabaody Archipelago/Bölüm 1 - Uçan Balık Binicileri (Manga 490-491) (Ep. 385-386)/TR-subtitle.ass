Dialogue: 0,0:01:52.12,0:01:58.28,Title,,0,0,250,,{\fad(650,1000)}Uçan Balık Binicileri
Dialogue: 0,0:01:58.74,0:02:01.78,Main,Luffy,0,0,0,,Görüşürüz arkadaşlar!
Dialogue: 0,0:02:02.06,0:02:05.60,Main,Pirate 1,0,0,0,,Bizim için yaptıklarını asla\Nunutmayacağız, Hasır Şapka!
Dialogue: 0,0:02:05.82,0:02:08.40,Main,Pirate 2,0,0,0,,Güneşi bize geri getirdiğin\Niçin teşekkürler!
Dialogue: 0,0:02:12.22,0:02:16.76,Main,Brook,0,0,0,,Lütfen dikkatli olun ve yok olmayın!
Dialogue: 0,0:02:16.94,0:02:19.04,Main,Usopp,0,0,0,,Böyle korkunç şeyler söyleme, pislik!
Dialogue: 0,0:02:19.14,0:02:23.24,Main,Nami,0,0,0,,Lola, Yaşam Kartı için sağol! Dikkatli ol!
Dialogue: 0,0:02:23.36,0:02:25.10,Main,Lola,0,0,0,,Lütfen anneme selam söyle!
Dialogue: 0,0:02:25.24,0:02:28.06,Main,Lola,0,0,0,,Umarım bir gün yine karşılaşırız, Namizou!
Dialogue: 0,0:02:32.10,0:02:34.42,Main,Luffy,0,0,0,,Yola çıkalım!
Dialogue: 0,0:02:42.18,0:02:46.68,Main,Narrator,0,0,0,,{\i1}Bu gizemli denizde, \NFlorian Üçgeni'nde kimse ne olacağını bilmiyor.{\i0}
Dialogue: 0,0:02:52.42,0:02:53.90,Main,Lola,0,0,0,,Demek gittiler.
Dialogue: 0,0:02:54.34,0:02:55.60,Main,Pirate 1,0,0,0,,Evet, gittiler.
Dialogue: 0,0:02:57.56,0:03:01.30,Main,Lola,0,0,0,,Sis yine geliyor, yarın yola çıkıyoruz!!
Dialogue: 0,0:03:01.40,0:03:03.21,Main,Pirates,0,0,0,,Tamam!
Dialogue: 0,0:03:03.36,0:03:07.76,Main,Narrator,0,0,0,,{\i1}Her yıl 100'den fazla gemi bu siste kaybolur.{\i0}
Dialogue: 0,0:03:08.50,0:03:14.34,Main,Narrator,0,0,0,,{\i1}Bu, dev korsan gemisi Thriller Bark'ın kendini on\Nyıl önce sise bürümesinden çok önce başladı.{\i0}
Dialogue: 0,0:03:14.52,0:03:18.56,Main,Narrator,0,0,0,,{\i1}Bu eski ve açıklanamayan bir gizem...{\i0}
Dialogue: 0,0:03:25.84,0:03:28.84,Main,Narrator,0,0,0,,{\i1}Bugün sisin, her zamanki gibi\Nyoğun olması büyük şans.{\i0}
Dialogue: 0,0:03:29.16,0:03:33.62,Main,Narrator,0,0,0,,{\i1}Tuhaf yüzünü yoğunluğunun içinde\Ngizlemesi için beyaz bir peçe.{\i0}
Dialogue: 0,0:03:39.96,0:03:41.05,Main,Nami,0,0,0,,Luffy...
Dialogue: 0,0:03:42.78,0:03:44.12,Main,Nami,0,0,0,,Gerçekten bir sorun yok mu?
Dialogue: 0,0:03:44.26,0:03:44.74,Main,Luffy,0,0,0,,
Dialogue: 0,0:03:45.04,0:03:47.43,Main,Luffy,0,0,0,,Ah, Ace'in kâğıdı, değil mi?
Dialogue: 0,0:03:48.32,0:03:50.00,Main,Luffy,0,0,0,,Sorun değil, dert etme!
Dialogue: 0,0:03:52.08,0:03:55.89,Main,Brook,0,0,0,,Luffy-san, rotamızı değiştirmemiz\Nbeni biraz olsun rahatsız etmezdi.
Dialogue: 0,0:03:56.96,0:04:01.10,Main,Brook,0,0,0,,Zaman, benim ve Laboon için\Nhiçbir engel teşkil etmiyor.
Dialogue: 0,0:04:01.30,0:04:03.69,Main,Brook,0,0,0,,Önemli olan yaşamak ve\Nbir daha buluşmak.
Dialogue: 0,0:04:03.88,0:04:07.66,Main,Usopp,0,0,0,,Luffy, rotayı değiştirmek\Nistiyorsan bize uyar!
Dialogue: 0,0:04:07.90,0:04:09.72,Main,Chopper,0,0,0,,Uyar! Uyar!
Dialogue: 0,0:04:09.84,0:04:13.30,Main,Franky,0,0,0,,Evet! Kardeş balinayla buluşmaya gidelim!
Dialogue: 0,0:04:13.42,0:04:15.20,Main,Luffy,0,0,0,,Hayır, gerçekten sorun değil.
Dialogue: 0,0:04:15.40,0:04:20.14,Main,Luffy,0,0,0,,Başı dertte olsaydı bile, \Nonun için endişelenmemi istemezdi.
Dialogue: 0,0:04:20.22,0:04:23.68,Main,Luffy,0,0,0,,Ace, en çok güçsüz görünmekten nefret eder.
Dialogue: 0,0:04:25.50,0:04:28.02,Main,Luffy,0,0,0,,Yardıma gitseydik, sadece kızardı.
Dialogue: 0,0:04:28.60,0:04:30.76,Main,Luffy,0,0,0,,Karşılaşırsak, düşman korsanlar\Nolarak olacak.
Dialogue: 0,0:04:31.18,0:04:33.78,Main,Luffy,0,0,0,,Ace'in gideceği kendi maceraları var.
Dialogue: 0,0:04:35.26,0:04:39.31,Main,Sanji,0,0,0,,Yaşam Kartı, sadece sen\Ntehlikede olduğunda küçülmüyor.
Dialogue: 0,0:04:39.48,0:04:42.54,Main,Sanji,0,0,0,,İyi olduğunda da büyüyor.
Dialogue: 0,0:04:42.80,0:04:44.86,Main,Luffy,0,0,0,,Evet, gücü tam olduğunda\Nonunla karşılaşmak istiyorum!
Dialogue: 0,0:04:45.26,0:04:48.30,Main,Luffy,0,0,0,,Bu yüzden Ace bana bu\Nkâğıdı verdi, değil mi?
Dialogue: 0,0:04:53.84,0:04:54.84,Main,Luffy,0,0,0,,Sahi, Zoro!
Dialogue: 0,0:04:55.02,0:04:57.72,Main,Luffy,0,0,0,,Bunca zamandır uyuduğun için kaçırdın!
Dialogue: 0,0:04:58.90,0:05:01.30,Main,Usopp,0,0,0,,O zaman yeniden yapalım!
Dialogue: 0,0:05:01.52,0:05:05.48,Main,Usopp,0,0,0,,Yeni arkadaşımız müzisyen Brook'un\Ntayfaya katılışını kutlamak için!
Dialogue: 0,0:05:06.38,0:05:09.36,Main,Strawhats,0,0,0,,Şerefe!
Dialogue: 0,0:05:09.60,0:05:11.58,Main,Brook,0,0,0,,Memnun oldum!
Dialogue: 0,0:05:12.00,0:05:16.48,Main,Luffy,0,0,0,,Tamam, doğruca ileri!\NPatlama Vuruşu'yla buradan gidelim!
Dialogue: 0,0:05:18.98,0:05:21.30,Main,Franky,0,0,0,,{\fad(150,150)}Patlama Vuruşu!
Dialogue: 0,0:05:23.56,0:05:26.32,Main,Brook,0,0,0,,Bu da ne böyle?!
Dialogue: 0,0:05:32.14,0:05:35.76,Captions,Caption,0,0,30,,{\fad(2000,0)}Kutsal Ülke, Mariejoa
Dialogue: 0,0:05:43.76,0:05:45.14,Main,Sengoku,0,0,0,,Şaka yapıyor olmalısın!
Dialogue: 0,0:05:45.98,0:05:50.24,Main,Sengoku,0,0,0,,Bartholomew Kuma, bana senin gücünden\Nkaçmayı başardıklarını mı söylüyorsun??!
Dialogue: 0,0:05:50.46,0:05:54.68,Main,Sengoku,0,0,0,,Bundan daha iyi bir açıklama istiyorum!\NBunu üstlerine rapor etmesi gereken benim!
Dialogue: 0,0:05:58.26,0:06:00.10,Main,Garp,0,0,0,,Torunumdan da bu beklenir!
Dialogue: 0,0:06:00.22,0:06:01.60,Main,Sengoku,0,0,0,,Sessiz ol, Garp!
Dialogue: 0,0:06:01.82,0:06:04.76,Main,Sengoku,0,0,0,,Tüm tayfayı yok etmen için sana\Nözel Hükümet emri verdim,...
Dialogue: 0,0:06:04.88,0:06:09.14,Main,Sengoku,0,0,0,,...ama sen Hasır Şapkalı Luffy'nin başını\Nbile getiremedin mi? Utanç verici!
Dialogue: 0,0:06:10.78,0:06:12.78,Main,Garp,0,0,0,,Endişelenme, Sengoku!
Dialogue: 0,0:06:14.32,0:06:20.28,Main,Garp,0,0,0,,Zaten Luffy sağda solda Moria'yı\Nyendiğini söyleyip övünecek biri değildir!
Dialogue: 0,0:06:21.96,0:06:22.58,Main,Sengoku,0,0,0,,
Dialogue: 0,0:06:23.30,0:06:27.90,Main,Sengoku,0,0,0,,Kuma, umarım sırf yaralı oldukları\Niçin o korsanlara acımamışsındır.
Dialogue: 0,0:06:29.38,0:06:33.46,Main,Sengoku,0,0,0,,Bunu ciddiye almayı başaramadığın\Niçin bu kedi fare oyunu sona ermeyecek.
Dialogue: 0,0:06:33.84,0:06:39.02,Main,Sengoku,0,0,0,,Şu anki gibi körlemesine seyri takip etmeye devam\Nederlerse Denizci Karargâhı'na daha da yaklaşacaklar.
Dialogue: 0,0:06:41.18,0:06:45.30,Main,Garp,0,0,0,,Ah, sahi. Yeni çay getirdim!
Dialogue: 0,0:06:45.58,0:06:46.66,Main,Garp,0,0,0,,Krakerleri çıkar!
Dialogue: 0,0:06:46.72,0:06:48.92,Main,Sengoku,0,0,0,,Çeneni kapar mısın, Garp?!
Dialogue: 0,0:06:48.97,0:06:51.31,Captions,,835,0,330,,Birkaç gün sonra...
Dialogue: 0,0:06:51.31,0:06:54.87,Captions,,835,0,330,,{\fad(400,0)}Grand Line
Dialogue: 0,0:06:56.81,0:06:59.48,Captions,,835,0,310,,{\fad(500,0)}Thousand Sunny
Dialogue: 0,0:07:00.72,0:07:02.20,Main,Nami,0,0,0,,Yılan Akıntıları!
Dialogue: 0,0:07:02.82,0:07:04.54,Main,Chopper,0,0,0,,Yılan Akıntıları mı?
Dialogue: 0,0:07:04.94,0:07:06.34,Main,Nami,0,0,0,,Herkes dikkatli olsun!
Dialogue: 0,0:07:12.14,0:07:13.76,Main,Luffy,0,0,0,,Gidelim çocuklar!
Dialogue: 0,0:07:16.94,0:07:17.88,Main,,0,0,0,,O...
Dialogue: 0,0:07:23.12,0:07:26.17,Main,Franky,0,0,0,,{\fad(150,150)}Patlama Vuruşu!
Dialogue: 0,0:07:53.82,0:07:54.74,Main,Luffy,0,0,0,,Geldik...
Dialogue: 0,0:07:55.88,0:07:58.17,Main,Luffy,0,0,0,,Nihayet buraya kadar geldik!
Dialogue: 0,0:07:59.06,0:08:03.36,Main,Nami,0,0,0,,Nostaljik bir his...
Dialogue: 0,0:08:08.50,0:08:11.78,Main,Chopper,0,0,0,,Tepesini göremiyorum!\NÇok büyük!
Dialogue: 0,0:08:12.56,0:08:14.74,Main,Chopper,0,0,0,,Yani Kızıl Hat bu mu?
Dialogue: 0,0:08:16.12,0:08:20.14,Main,Zoro,0,0,0,,Acaba o zamandan beri olgunlaştık mı?
Dialogue: 0,0:08:20.66,0:08:22.28,Main,Usopp,0,0,0,,İçimden ağlamak geliyor!
Dialogue: 0,0:08:22.80,0:08:24.40,Main,Usopp,0,0,0,,Bir sürü şey oldu, ha?
Dialogue: 0,0:08:25.70,0:08:27.64,Main,Luffy,0,0,0,,Neyse, nihayet yolu yarıladık!
Dialogue: 0,0:08:28.86,0:08:33.66,Main,Luffy,0,0,0,,Dünyanın diğer tarafında Laboon'la karşılaştığımız\Nİkiz Burun, bu noktaya bağlanıyor!
Dialogue: 0,0:08:33.35,0:08:34.28,Captions,Caption,80,0,210,,{\fad(250,0)}Şu anki yer
Dialogue: 0,0:08:34.84,0:08:38.60,Main,Luffy,0,0,0,,Buraya kadar gelmemiz harika, değil mi?
Dialogue: 0,0:08:39.02,0:08:44.56,Main,Franky,0,0,0,,Çocukken bana Güney Mavi'deki\NTornistan Dağı'ndan geldiğim söylendi...
Dialogue: 0,0:08:44.82,0:08:46.84,Main,Franky,0,0,0,,...ama sanırım bu 30 yıllık bir hikaye.
Dialogue: 0,0:08:47.36,0:08:51.72,Main,Robin,0,0,0,,Batı Mavi'den bu denize 5 yıl önce geldim.
Dialogue: 0,0:08:52.34,0:08:57.22,Main,Luffy,0,0,0,,Dünyanın diğer yarısını geçip bu\Nduvarı yeniden gördüğümüzde...
Dialogue: 0,0:08:57.68,0:08:58.56,Main,Luffy,0,0,0,,...işte o zaman...
Dialogue: 0,0:09:00.68,0:09:02.54,Main,Luffy,0,0,0,,...Korsanlar Kralı olacağım!
Dialogue: 0,0:09:07.96,0:09:09.76,Main,Nami,0,0,0,,Ama artık dikkatli olmalıyız.
Dialogue: 0,0:09:10.62,0:09:15.98,Main,Nami,0,0,0,,Burası Dünya Hükümeti'nin "Kutsal Ülke"sine\Nve Denizci Karargâhı Mariejoa'ya yakın.
Dialogue: 0,0:09:24.10,0:09:26.44,Main,Chopper,0,0,0,,"Sürpriz havuz" en iyisi!
Dialogue: 0,0:09:35.58,0:09:37.21,Main,Zoro,0,0,0,,Çok güçsüzüm.
Dialogue: 0,0:09:37.52,0:09:39.08,Main,Zoro,0,0,0,,Daha güçlü olmalıyım!
Dialogue: 0,0:09:41.54,0:09:44.06,Main,Zoro,0,0,0,,Hala çok güçsüzüm!
Dialogue: 0,0:09:46.46,0:09:47.60,Main,Zoro,0,0,0,,Hala!
Dialogue: 0,0:09:49.40,0:09:53.10,Main,Nami,0,0,0,,Durum nedir, Robin, Brook, Luffy?
Dialogue: 0,0:09:54.48,0:09:56.78,Main,Robin,0,0,0,,Faydasız. Tamamen karanlık.
Dialogue: 0,0:09:58.36,0:09:59.78,Main,Luffy,0,0,0,,Burası kapkaranlık!
Dialogue: 0,0:10:00.04,0:10:02.32,Main,Luffy,0,0,0,,Hey, sanırım orada bir şey gördüm!
Dialogue: 0,0:10:04.60,0:10:06.54,Main,Brook,0,0,0,,Bir canavarın gözü müydü?
Dialogue: 0,0:10:07.42,0:10:08.56,Main,Chopper,0,0,0,,C-canavar?
Dialogue: 0,0:10:08.98,0:10:10.72,Main,Brook,0,0,0,,Öleceğiz!
Dialogue: 0,0:10:11.58,0:10:14.09,Main,Brook,0,0,0,,Gerçi ben zaten ölüyüm!
Dialogue: 0,0:10:16.70,0:10:19.40,Main,Brook,0,0,0,,Ah, sahi, Nami-san? Bir sorum var...
Dialogue: 0,0:10:19.98,0:10:21.98,Main,Brook,0,0,0,,Bugün nasıl bir külot giyiyorsun?
Dialogue: 0,0:10:23.56,0:10:26.06,Main,Nami,0,0,0,,Kapa çeneni! Bunu ciddiye al!
Dialogue: 0,0:10:26.74,0:10:27.76,Thoughts,Chopper,0,0,0,,Korkunç!
Dialogue: 0,0:10:29.66,0:10:32.54,Main,Usopp,0,0,0,,Cesur biri, değil mi?
Dialogue: 0,0:10:32.74,0:10:38.90,Main,Franky,0,0,0,,Hey, çocuklar! Köpekbalığı Denizaltı beş bin\Nmetreden daha derine gidemez, dikkatli olun!
Dialogue: 0,0:10:42.80,0:10:45.98,Main,Brook,0,0,0,,Hmm? Denizaltı gıcırdıyor gibi.
Dialogue: 0,0:10:46.64,0:10:48.57,Main,Robin,0,0,0,,Evet. Çünkü...
Dialogue: 0,0:10:49.36,0:10:52.06,Main,Robin,0,0,0,,...şu anda beş bin\Nmetreden daha derindeyiz.
Dialogue: 0,0:10:52.50,0:10:54.30,Main,Brook,0,0,0,,Ah, yani...
Dialogue: 0,0:10:55.14,0:10:59.40,Main,Brook,0,0,0,,Ama bu korkunç! Su basıncıyla ezileceğiz!
Dialogue: 0,0:11:03.20,0:11:05.82,Main,Luffy,0,0,0,,Ah! Deminki canavar! Hala burada!
Dialogue: 0,0:11:06.60,0:11:08.12,Main,Robin,0,0,0,,Ne koca bir ağzı var.
Dialogue: 0,0:11:10.24,0:11:11.50,Main,Luffy,0,0,0,,Dikkat edin!
Dialogue: 0,0:11:12.30,0:11:14.12,Main,Luffy,0,0,0,,Bizi yiyecek!
Dialogue: 0,0:11:14.26,0:11:16.16,Main,Brook,0,0,0,,İşte yine geliyor!
Dialogue: 0,0:11:20.76,0:11:22.56,Main,Franky,0,0,0,,Kulağa epey kötü geliyor.
Dialogue: 0,0:11:23.10,0:11:27.02,Main,Chopper,0,0,0,,Köpekbalığı Denizaltı'na binmek istemiyorum.
Dialogue: 0,0:11:27.10,0:11:27.81,Main,Usopp,0,0,0,,Ben de.
Dialogue: 0,0:11:28.62,0:11:30.68,Main,Sanji,0,0,0,,Nami-swan!
Dialogue: 0,0:11:31.14,0:11:35.78,Main,Sanji,0,0,0,,Thriller Bark'taki korku armutlarıyla\Nyaptığım tart tamamlandı!
Dialogue: 0,0:11:36.98,0:11:38.76,Main,Nami,0,0,0,,Oh, güzel görünüyor!
Dialogue: 0,0:11:39.62,0:11:41.56,Main,Nami,0,0,0,,Ama bu sorun olacak.
Dialogue: 0,0:11:43.16,0:11:44.60,Main,Nami,0,0,0,,Tadı harika!
Dialogue: 0,0:11:45.30,0:11:47.56,Main,Franky; Usopp and Chopper,0,0,0,,Leziz!
Dialogue: 0,0:11:49.10,0:11:52.16,Main,Sanji,0,0,0,,Gökyüzü Adası'nda yaşadığımız\Nsorunun aynısı.
Dialogue: 0,0:11:52.72,0:11:54.02,Main,Nami,0,0,0,,Evet.
Dialogue: 0,0:11:55.12,0:11:57.42,Main,Nami,0,0,0,,Gitmemiz gereken yönü biliyoruz...
Dialogue: 0,0:11:57.54,0:11:59.76,Main,Nami,0,0,0,,...ama nasıl gideceğimize\Ndair hiçbir fikrimiz yok.
Dialogue: 0,0:12:00.06,0:12:03.48,Main,Nami,0,0,0,,Balık Adam Adası'na nasıl ulaşacağız?
Dialogue: 0,0:12:07.80,0:12:09.02,Main,Luffy,0,0,0,,Döndük!
Dialogue: 0,0:12:09.54,0:12:10.94,Main,Brook,0,0,0,,Eğlenceliydi!
Dialogue: 0,0:12:12.74,0:12:14.66,Main,Nami,0,0,0,,Hoş geldiniz! İyi iş!
Dialogue: 0,0:12:15.00,0:12:16.34,Main,Luffy,0,0,0,,Faydasız!
Dialogue: 0,0:12:16.50,0:12:20.54,Main,Luffy,0,0,0,,Denizin dibinde hiçbir şey göremiyoruz!\NBalık Adam Adası gerçekten orada mı?
Dialogue: 0,0:12:21.94,0:12:24.44,Main,Brook,0,0,0,,İlk kez denizaltına bindim.
Dialogue: 0,0:12:24.52,0:12:27.40,Main,Robin,0,0,0,,Daha derine inseydik basınç bizi öldürürdü.
Dialogue: 0,0:12:27.94,0:12:31.60,Main,Nami,0,0,0,,Seyir Belirleyici kesinlikle\Naşağıyı işaret ediyor ama...
Dialogue: 0,0:12:31.82,0:12:35.76,Main,Nami,0,0,0,,...bu hiç iyi değil. Lolagil'den\Nbiraz daha bilgi almalıydım.
Dialogue: 0,0:12:44.00,0:12:46.38,Main,Luffy,0,0,0,,Deminki şey!
Dialogue: 0,0:12:46.54,0:12:48.14,Main,Brook,0,0,0,,Peşimizden gelmiş!
Dialogue: 0,0:12:54.90,0:12:58.00,Main,Luffy,0,0,0,,Su üstündeyken beni yenebileceğini sanma!
Dialogue: 0,0:12:59.68,0:13:01.34,Main,Luffy,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:13:01.58,0:13:02.88,Main,Luffy,0,0,0,,{\fad(150,150)}Tüfek!
Dialogue: 0,0:13:08.02,0:13:10.39,Main,Usopp,0,0,0,,Nedense o kadar da büyük görünmedi.
Dialogue: 0,0:13:10.68,0:13:14.10,Main,Chopper,0,0,0,,Oz'la uğraştığımız için! İyi gibiyiz.
Dialogue: 0,0:13:18.14,0:13:19.30,Main,Sanji,0,0,0,,Bir şey çıktı.
Dialogue: 0,0:13:25.18,0:13:26.14,Main,Luffy,0,0,0,,Balık?
Dialogue: 0,0:13:28.66,0:13:29.72,Main,Usopp,0,0,0,,İnsan?!
Dialogue: 0,0:13:32.94,0:13:34.40,Main,Brook,0,0,0,,Hayır, değil.
Dialogue: 0,0:13:34.74,0:13:35.40,Main,Robin,0,0,0,,O...
Dialogue: 0,0:13:37.54,0:13:40.14,Main,Sanji,0,0,0,,Yoksa?!
Dialogue: 0,0:13:54.68,0:13:58.50,Main,Camie,0,0,0,,Aah! Bir insanı ezdim!
Dialogue: 0,0:13:58.64,0:14:01.38,Main,Camie,0,0,0,,Çok üzgünüm! İyi misin?
Dialogue: 0,0:14:01.68,0:14:03.84,Main,Sanji,0,0,0,,Ah, dert etme!
Dialogue: 0,0:14:04.12,0:14:05.80,Main,Sanji,0,0,0,,Neyse, sen...
Dialogue: 0,0:14:10.12,0:14:12.88,Secondary,Camie,0,0,0,,{\an8}Lütfen kendine gel! İyi misin?
Dialogue: 0,0:14:12.52,0:14:13.84,Main,Nami,0,0,0,,O...
Dialogue: 0,0:14:13.26,0:14:18.68,Secondary,Camie,0,0,0,,{\an8}Böyle bir şey yaptığıma inanamıyorum!\NLütfen kendine gel!
Dialogue: 0,0:14:16.04,0:14:17.14,Main,Usopp,0,0,0,,Yüzg...
Dialogue: 0,0:14:18.00,0:14:21.62,Main,Nami,0,0,0,,Yoksa gerçekten...
Dialogue: 0,0:14:24.98,0:14:26.96,Main,Strawhats,0,0,0,,...deniz kızı mı?!
Dialogue: 0,0:14:30.54,0:14:33.02,Main,Camie,0,0,0,,Ödüm koptu! Burada bir sürü insan var!
Dialogue: 0,0:14:33.32,0:14:34.46,Main,Luffy,0,0,0,,N-ne?
Dialogue: 0,0:14:34.76,0:14:36.14,Main,Chopper,0,0,0,,B-Biz de şaşırdık!
Dialogue: 0,0:14:36.17,0:14:42.31,Captions,,0,20,340,,{\fad(800,0)\fs55}Camie
Dialogue: 0,0:14:36.17,0:14:42.31,Captions,,0,20,266,,{\fad(800,0)\fs32}Öpüşen Gurami\NDeniz Kızı
Dialogue: 0,0:14:36.17,0:14:42.31,Captions,,0,20,57,,{\fad(800,0)\fs32}(Çırak Tasarımcı,
Dialogue: 0,0:14:36.17,0:14:42.31,Captions,,0,20,13,,{\fad(800,0)\fs32}Takoyaki Dükkanı Çalışanı)
Dialogue: 0,0:14:36.92,0:14:40.04,Main,Camie,0,0,0,,{\an8}Sindirileceğimi sanmıştım.\NBeni kurtardığınız için sağolun.
Dialogue: 0,0:14:40.20,0:14:42.66,Main,Camie,0,0,0,,{\an8}Canavarlar tarafından yutulup duruyorum.
Dialogue: 0,0:14:42.82,0:14:44.70,Main,Camie,0,0,0,,Muhtemelen bu 20. falandı.
Dialogue: 0,0:14:45.32,0:14:46.58,Main,Usopp,0,0,0,,Çok fazla yutulmuşsun!
Dialogue: 0,0:14:46.94,0:14:48.88,Main,Camie,0,0,0,,Size karşılığını ödemeliyim.
Dialogue: 0,0:14:49.06,0:14:50.92,Main,Camie,0,0,0,,Ah, biliyorum! \NBiraz takoyaki ister misiniz?
Dialogue: 0,0:14:51.06,0:14:53.26,Main,Luffy,0,0,0,,Takoyaki?! En sevdiğim yemektir!
Dialogue: 0,0:14:53.36,0:14:56.66,Main,Camie,0,0,0,,Öyle mi?! O zaman kişi başına 500 beli!
Dialogue: 0,0:14:58.02,0:14:59.22,Main,Pappag,0,0,0,,Hey, satıyor musun?!
Dialogue: 0,0:15:00.36,0:15:02.10,Main,Camie,0,0,0,,Mahvettim!
Dialogue: 0,0:15:02.26,0:15:04.68,Main,Sanji,0,0,0,,Deniz kızı! Deniz kızı!
Dialogue: 0,0:15:04.82,0:15:08.58,Main,Sanji,0,0,0,,Deniz kızları, tüm insanlığın hayali!\NDeniz kızları, okyanusun mücevherleri!
Dialogue: 0,0:15:08.96,0:15:12.30,Main,Sanji,0,0,0,,Evet, nihayet onlardan biriyle\Ntanıştım!
Dialogue: 0,0:15:12.42,0:15:14.02,Main,Sanji,0,0,0,,Çok sevimli biri!
Dialogue: 0,0:15:14.14,0:15:16.70,Main,Sanji,0,0,0,,İlk kez bir deniz kızıyla tanışıyorum!
Dialogue: 0,0:15:16.88,0:15:18.88,Main,Sanji,0,0,0,,Caimie'ydi, değil mi?
Dialogue: 0,0:15:18.18,0:15:19.54,Secondary,Usopp,0,0,0,,İlk kez değil.
Dialogue: 0,0:15:19.68,0:15:22.40,Main,Usopp,0,0,0,,Yaşlı kadın Kokoro'yla\Nda tanıştın, değil mi?
Dialogue: 0,0:15:24.36,0:15:29.12,Main,Sanji,0,0,0,,Thriller Bark? Hayır, korkunç değildi.\NHiç değildi.
Dialogue: 0,0:15:29.38,0:15:33.22,Main,Sanji,0,0,0,,Şu ana dek karşılaştığımız\Nen korkunç şey...
Dialogue: 0,0:15:34.24,0:15:37.34,Main,Usopp,0,0,0,,Ah, evet, Sanji! \NBu hiç olmamış gibi davranalım!
Dialogue: 0,0:15:37.44,0:15:39.08,Main,Usopp,0,0,0,,Bu, karşılaştığımız ilk deniz kızı!
Dialogue: 0,0:15:39.20,0:15:40.42,Main,Nami,0,0,0,,Çok kabasınız!
Dialogue: 0,0:15:40.64,0:15:43.96,Main,Luffy,0,0,0,,Ha? Yaşlı kadın Kokoro deniz kızı mıydı?
Dialogue: 0,0:15:44.20,0:15:45.88,Main,Luffy,0,0,0,,Ama yürüyebiliyordu, değil mi?
Dialogue: 0,0:15:46.02,0:15:49.00,Main,Franky,0,0,0,,Sahi. Senin haberin yok, değil mi?
Dialogue: 0,0:15:49.22,0:15:52.18,Main,Franky,0,0,0,,Sen Lucci'yle dövüşürken oldu zaten.
Dialogue: 0,0:15:56.34,0:16:00.50,Main,Luffy,0,0,0,,Yaşlı kadın Kokoro'nun deniz kızı olduğunu\Nhayal etmek nedense çok iğrenç.
Dialogue: 0,0:16:00.68,0:16:02.34,Main,Nami,0,0,0,,Siz fazla açık sözlüsünüz!
Dialogue: 0,0:16:04.56,0:16:08.32,Main,Nami,0,0,0,,Üfff, mesele bu heriflerin deniz kızı\Nbeklentilerine gelince...
Dialogue: 0,0:16:08.52,0:16:11.18,Main,Robin,0,0,0,,Ama sevimli bir deniz kızına\Nbenziyor, değil mi?
Dialogue: 0,0:16:12.78,0:16:16.56,Main,Brook,0,0,0,,Ben de ilk kez bir deniz\Nkızıyla karşılaşıyorum.
Dialogue: 0,0:16:17.18,0:16:20.28,Main,Brook,0,0,0,,Afedersin, lütfen bana biraz\Nborç para verebilir misin?
Dialogue: 0,0:16:21.36,0:16:22.40,Main,Sanji,0,0,0,,Niye versin?!
Dialogue: 0,0:16:22.52,0:16:23.54,Main,Camie,0,0,0,,İskelet!
Dialogue: 0,0:16:23.60,0:16:26.50,Main,Sanji,0,0,0,,Gördün mü?! Onu korkutursan, bunu\Nnasıl telafi edeceksin?! Kaybol!
Dialogue: 0,0:16:26.96,0:16:29.24,Main,Brook,0,0,0,,Kafamı da açabilirim. Komik, değil mi?
Dialogue: 0,0:16:30.10,0:16:30.68,Main,Sanji,0,0,0,,Pislik!
Dialogue: 0,0:16:30.78,0:16:31.90,Main,Camie,0,0,0,,Çok komik!
Dialogue: 0,0:16:32.14,0:16:33.76,Main,Usopp,0,0,0,,Gerçekten üstesinden çabuk geldi.
Dialogue: 0,0:16:34.92,0:16:36.80,Main,Luffy,0,0,0,,Sahi, sıçabilir misin?
Dialogue: 0,0:16:37.32,0:16:38.70,Main,Sanji,0,0,0,,Ne sormaya çalışıyorsun, lanet olası?!
Dialogue: 0,0:16:38.32,0:16:39.46,Secondary,Camie,0,0,0,,Ah, evet, ben...
Dialogue: 0,0:16:39.42,0:16:41.52,Main,Sanji,0,0,0,,Cevap verme!
Dialogue: 0,0:16:42.30,0:16:44.20,Secondary,Sanji,0,0,0,,{\an8}Sıçmıyor!
Dialogue: 0,0:16:43.06,0:16:45.50,Main,Pappag,0,0,0,,Caimie? Caimie? Bu çok tuhaf...
Dialogue: 0,0:16:45.74,0:16:47.10,Main,Pappag,0,0,0,,Birini gözden kaçırmıyor musun?
Dialogue: 0,0:16:47.30,0:16:50.90,Main,Pappag,0,0,0,,Bu eğlenceli grubun dışında bırakılan kim?
Dialogue: 0,0:16:51.20,0:16:52.34,Main,Pappag,0,0,0,,Cevap: Ben.
Dialogue: 0,0:16:56.70,0:16:58.70,Main,Luffy,0,0,0,,Sahi, ben de bunu merak ediyordum.
Dialogue: 0,0:16:58.82,0:17:02.10,Main,Luffy,0,0,0,,Hey, Caimie, bu nedir?\NBu konuşan eldiven şey...
Dialogue: 0,0:17:02.28,0:17:05.52,Main,Camie,0,0,0,,Ah, üzgünüm. Tamamen unutmuşum.\NEvcil hayvanım, Pappagu.
Dialogue: 0,0:17:05.66,0:17:07.40,Main,Camie,0,0,0,,Denizyıldızı ve benim efendim.
Dialogue: 0,0:17:07.50,0:17:08.28,Main,Pappag,0,0,0,,Memnun oldum!
Dialogue: 0,0:17:10.20,0:17:12.00,Main,Nami,0,0,0,,Denizyıldızı konuşabilir mi?
Dialogue: 0,0:17:12.30,0:17:14.50,Main,Usopp,0,0,0,,Evcil hayvanının onun efendisi\Nolması tuhaf değil mi?
Dialogue: 0,0:17:16.26,0:17:18.90,Main,Pappag,0,0,0,,Evet, bir sebeple kabul edildim.
Dialogue: 0,0:17:20.98,0:17:26.28,Lyrics,Pappag,0,0,0,,♪ Caimie, beni hep deniz tarağıyla besler. ♪
Dialogue: 0,0:17:26.42,0:17:27.50,Main,Nami,0,0,0,,Yani seni besliyor mu?
Dialogue: 0,0:17:28.06,0:17:35.50,Lyrics,Pappag,0,0,0,,♪ İnsan mıyım?  ♪\N♪ Denizyıldızıyım, yine de insan değilim. ♪
Dialogue: 0,0:17:35.70,0:17:43.20,Lyrics,Pappag,0,0,0,,♪ İnsan değil miyim?  ♪\N♪ İnsan değilim ama denizyıldızıyım. ♪
Dialogue: 0,0:17:43.36,0:17:48.87,Lyrics,Pappag,0,0,0,,♪ Meşgul müsün? Hayır, değil. ♪
Dialogue: 0,0:17:49.66,0:17:56.04,Lyrics,Pappag,0,0,0,,♪ Burada yeterince işçimiz var. ♪
Dialogue: 0,0:17:56.68,0:17:58.62,Main,Pappag,0,0,0,,Evet, sağolun!
Dialogue: 0,0:17:58.76,0:18:00.76,Main,Pappag,0,0,0,,Burada gülmeniz gerekiyordu!
Dialogue: 0,0:18:01.02,0:18:05.36,Main,Camie,0,0,0,,Bu tişört "Criminal" marka ve bugünlerde\NBalık Adam Adası'nda çok meşhur.
Dialogue: 0,0:18:05.52,0:18:06.54,Main,Usopp,0,0,0,,Oh?
Dialogue: 0,0:18:06.66,0:18:07.74,Main,Chopper,0,0,0,,Epey süpermiş.
Dialogue: 0,0:18:07.98,0:18:09.88,Main,Camie,0,0,0,,Pappagu dizayn etti!
Dialogue: 0,0:18:10.06,0:18:12.56,Main,Camie,0,0,0,,Ben de bir gün tasarımcı olmak istiyorum!
Dialogue: 0,0:18:12.64,0:18:15.52,Main,Sanji,0,0,0,,Olacaksın! Kesinlikle başaracaksın, Caimie!
Dialogue: 0,0:18:15.02,0:18:16.33,Secondary,Camie,0,0,0,,Sağol, Sanji-chin!
Dialogue: 0,0:18:16.44,0:18:18.10,Main,Pappag,0,0,0,,Kimse beni dinlemiyor.
Dialogue: 0,0:18:21.26,0:18:23.18,Main,Luffy,0,0,0,,Sahi. Nasıl konuşabiliyorsun?
Dialogue: 0,0:18:23.38,0:18:24.68,Main,Pappag,0,0,0,,Sormana sevindim!
Dialogue: 0,0:18:24.92,0:18:28.58,Main,Pappag,0,0,0,,Çocukken hep insan olduğumu düşünürdüm.
Dialogue: 0,0:18:29.02,0:18:32.58,Main,Pappag,0,0,0,,Aslında denizyıldızı olduğumu öğrendiğimde\Nzaten insan dilini konuşabiliyordum!
Dialogue: 0,0:18:32.78,0:18:34.62,Main,Luffy,0,0,0,,Gerçekten böyle işe yarıyor mu?
Dialogue: 0,0:18:35.16,0:18:39.22,Main,Pappag,0,0,0,,Ah, dünya tuhaf ve korkutucu\Nşekillerde işliyor. Dünya böyle işte!
Dialogue: 0,0:18:39.56,0:18:42.28,Main,Pappag,0,0,0,,Neyse, ben denizyıldızı Pappagu!
Dialogue: 0,0:18:39.45,0:18:44.75,Captions,,0,40,280,,{\fad(1000,1200)\fs42}Pappagu
Dialogue: 0,0:18:39.45,0:18:44.75,Captions,,0,40,326,,{\fad(1000,1200)\fs27}Denizyıldızı
Dialogue: 0,0:18:39.45,0:18:44.75,Captions,,0,35,90,,{\fad(1000,1200)\fs27}(Criminal markası\Ntasarımcısı)
Dialogue: 0,0:18:42.46,0:18:44.26,Main,Pappag,0,0,0,,Aktif ve geleceği parlak bir tasarımcıyım.
Dialogue: 0,0:18:44.50,0:18:46.50,Main,Pappag,0,0,0,,Kurtardığınız için sağolun.
Dialogue: 0,0:18:46.72,0:18:50.82,Main,Nami,0,0,0,,Ama hele şükür! Biz de ne yapacağımızı bilememenin\Nsıkıntısını yaşıyorduk. Bir şey sormak isti-
Dialogue: 0,0:18:51.88,0:18:54.04,Main,Luffy,0,0,0,,Hey, Nami! Önce takoyaki!
Dialogue: 0,0:18:54.18,0:18:56.66,Main,Camie,0,0,0,,Ah, sahi! Minnettarlığımı göstermek için takoyaki!
Dialogue: 0,0:18:57.06,0:18:59.86,Main,Camie,0,0,0,,O zaman, Hachi'yle bir yerde buluşmalıyım.
Dialogue: 0,0:19:00.18,0:19:01.28,Main,Luffy,0,0,0,,Hachi?
Dialogue: 0,0:19:03.58,0:19:06.36,Main,Camie,0,0,0,,Merhaba, Hachi? Ben Caimie!
Dialogue: 0,0:19:06.58,0:19:09.58,Main,Camie,0,0,0,,Afedersin, kayboldum. Şu anda neredesin.
Dialogue: 0,0:19:12.60,0:19:15.02,Main,Macro,0,0,0,,Oh, o ses Caimie'nin olmalı, değil mi?
Dialogue: 0,0:19:16.38,0:19:17.16,Main,Camie,0,0,0,,Hachi?
Dialogue: 0,0:19:17.28,0:19:20.78,Main,Macro,0,0,0,,Kiminle konuştuğunu\Nbiliyor musun? Ben Hachi değilim!
Dialogue: 0,0:19:22.14,0:19:23.82,Main,Camie,0,0,0,,Hachi değil misin?!
Dialogue: 0,0:19:23.96,0:19:30.14,Main,Macro,0,0,0,,Ben Macro! Yarım akıllı Macro Tayfası'ndan!\NDur, bunu kendime söylememeliydim.
Dialogue: 0,0:19:30.48,0:19:33.18,Main,Robin,0,0,0,,Sorun var gibi.
Dialogue: 0,0:19:33.64,0:19:36.04,Main,Camie,0,0,0,,Hachi'nin Den Den Mushi'si niye sizde?
Dialogue: 0,0:19:37.44,0:19:39.84,Main,Macro,0,0,0,,Çünkü Hachi'nin canına okuduk!\NBelli olmuyor mu?!
Dialogue: 0,0:19:41.12,0:19:44.44,Main,Camie,0,0,0,,Yalancı! Hachi'nin size yenilmesi mümkün değil!
Dialogue: 0,0:19:44.62,0:19:48.96,Main,Macro,0,0,0,,Evet, haklısın. Normalde ona\Ndenk olamazdık...
Dialogue: 0,0:19:49.06,0:19:53.06,Main,Macro,0,0,0,,...ama bu sefer yanımızda\NUçan Balık Binicileri var!
Dialogue: 0,0:19:55.46,0:19:57.14,Main,Pappag,0,0,0,,Uçan Balık Binicileri mi?!
Dialogue: 0,0:19:58.30,0:20:01.54,Main,Hachi,0,0,0,,Caimie, iyi misin? Çok şükür.
Dialogue: 0,0:20:01.80,0:20:03.98,Main,Camie,0,0,0,,H-hachi! Gerçekten seni dövdüler mi?
Dialogue: 0,0:20:04.40,0:20:06.28,Main,Hachi,0,0,0,,Tedbiri elden bırakmışım.
Dialogue: 0,0:20:06.62,0:20:13.06,Main,Hachi,0,0,0,,Buraya gelme! Bu heriflerin işini\Nbitirip hemen döneceğim! Sorun yok!
Dialogue: 0,0:20:14.84,0:20:18.08,Main,Macro,0,0,0,,Caimie, bu herifi satmak üzereydik.
Dialogue: 0,0:20:18.24,0:20:21.14,Main,Macro,0,0,0,,Ahtapot balık adamlar epey nadirdir,\Nbu yüzden bize epey kazandırır.
Dialogue: 0,0:20:21.26,0:20:23.42,Main,Macro,0,0,0,,İstersen gelip onu kurtar!
Dialogue: 0,0:20:24.06,0:20:29.84,Main,Macro,0,0,0,,Sabaody Takımadaları'ndayız, \N44. korunun 5 km doğusundaki sularda.
Dialogue: 0,0:20:30.06,0:20:33.38,Main,Macro,0,0,0,,Uçan Balık Binicileri'nin üssü orada!
Dialogue: 0,0:20:34.48,0:20:36.44,Main,Hachi,0,0,0,,Hayır! Caimie, sakın gelme!
Dialogue: 0,0:20:36.56,0:20:38.64,Main,Macro,0,0,0,,Kapa çeneni, seni kahrolası ahtapot!
Dialogue: 0,0:20:39.26,0:20:40.87,Main,Macro,0,0,0,,Görüşürüz!
Dialogue: 0,0:20:42.46,0:20:43.56,Main,Camie,0,0,0,,Hachi...
Dialogue: 0,0:20:44.04,0:20:44.98,Main,Luffy,0,0,0,,Peki takoyaki nerede?
Dialogue: 0,0:20:45.28,0:20:46.98,Main,Franky and Sanji,0,0,0,,Bunun sırası değil!
Dialogue: 0,0:20:47.14,0:20:53.28,Main,Nami,0,0,0,,Durun biraz. Hachi denen adamın \NDen Den Mushi'den duyduğumuz sesi biraz tanıdık geldi.
Dialogue: 0,0:20:53.50,0:20:55.40,Main,Nami,0,0,0,,Bana öyle gelmiş olmalı, değil mi?\NMümkün değil.
Dialogue: 0,0:20:55.88,0:20:59.66,Main,Camie,0,0,0,,Üzgünüm, Luffy-chin. \NTakoyakiyi sonraya bırakabilir miyiz?
Dialogue: 0,0:20:59.96,0:21:02.48,Main,Camie,0,0,0,,Arkadaşımı kurtarmalıyım!
Dialogue: 0,0:21:02.54,0:21:03.52,Main,Luffy,0,0,0,,Ha?
Dialogue: 0,0:21:03.60,0:21:04.34,Main,Franky and Sanji,0,0,0,,Hey!
Dialogue: 0,0:21:04.66,0:21:06.16,Main,Nami,0,0,0,,Dur, Caimie.
Dialogue: 0,0:21:06.42,0:21:12.10,Main,Nami,0,0,0,,Karışmamam gerekir ama arkadaşını\Nkurtarmak istiyorsan sana yardım edeceğiz!
Dialogue: 0,0:21:12.42,0:21:15.48,Main,Nami,0,0,0,,Ah, pardon. Yani onlar yardım edecek!
Dialogue: 0,0:21:15.60,0:21:16.72,Main,Franky & Usopp,0,0,0,,Sen var ya...
Dialogue: 0,0:21:16.82,0:21:22.28,Main,Nami,0,0,0,,Buna karşılık, Balık Adam Adası'na\Nulaşmamıza yardım etmeye ne dersin?
Dialogue: 0,0:21:22.96,0:21:24.10,Main,Camie,0,0,0,,Cidden mi, Nami-chin?
Dialogue: 0,0:21:24.44,0:21:27.56,Main,Camie,0,0,0,,Hachi'yi kurtarmama yardım\Nedecek misin, Luffy-chin?
Dialogue: 0,0:21:27.72,0:21:30.02,Main,Luffy,0,0,0,,Olur tabi. Ama kim bu Hachi?
Dialogue: 0,0:21:30.36,0:21:32.80,Main,Camie,0,0,0,,Çalıştığım takoyaki dükkanını işletiyor.
Dialogue: 0,0:21:32.92,0:21:34.80,Main,Camie,0,0,0,,Takoyakimiz dünyanın en iyisidir!
Dialogue: 0,0:21:35.62,0:21:36.96,Main,Luffy,0,0,0,,Bu çok önemli!
Dialogue: 0,0:21:37.20,0:21:40.64,Main,Luffy,0,0,0,,Beyler! Hayatınız pahasına da\Nolsa, takoyakiyi kurtaracağız!
Dialogue: 0,0:21:40.76,0:21:41.94,Main,Strawhats,0,0,0,,Tamam!
Dialogue: 0,0:21:42.88,0:21:45.04,Main,Nami,0,0,0,,Tamam diyorlar. Peki nerede\Nolduklarını biliyor musun?
Dialogue: 0,0:21:45.12,0:21:46.56,Main,Camie,0,0,0,,Evet, şey...
Dialogue: 0,0:21:49.86,0:21:54.64,Main,Pappag,0,0,0,,44. Koru, takımadaların\Nen doğu kıyısındaki bir ada.
Dialogue: 0,0:21:54.88,0:21:59.66,Main,Pappag,0,0,0,,Oranın 5 km batısı. Sanırım \NUçan Balık Binicileri'nin üssü burada olmalı.
Dialogue: 0,0:22:00.10,0:22:02.50,Main,Pappag,0,0,0,,Şu an burada olduğumuza bakarsak...
Dialogue: 0,0:22:02.62,0:22:06.04,Main,Pappag,0,0,0,,...doğrudan Sabaody Takımadaları'na\Ngidersek yolumuz üzerinde kalır.
Dialogue: 0,0:22:06.18,0:22:07.76,Main,Pappag,0,0,0,,Bu yüzden batıya gidelim!
Dialogue: 0,0:22:07.98,0:22:10.40,Main,Pappag,0,0,0,,Sonrasını balıklara sorup öğrenebiliriz.
Dialogue: 0,0:22:10.70,0:22:13.18,Main,Camie,0,0,0,,Evet, doğru. Acele edelim o zaman!
Dialogue: 0,0:22:14.20,0:22:17.84,Main,Camie,0,0,0,,Hey!
Dialogue: 0,0:22:34.82,0:22:37.70,Main,Luffy,0,0,0,,Ooh! Balıklar kafalarını sudan çıkarıyor!
Dialogue: 0,0:22:37.86,0:22:39.86,Main,Camie,0,0,0,,Yolu göstermenizi istiyoruz!
Dialogue: 0,0:22:47.64,0:22:50.07,Main,Camie,0,0,0,,Uçan Balıklar'dan korktukları\Niçin oraya kadar götürmeyecekler...
Dialogue: 0,0:22:50.10,0:22:51.62,Main,Camie,0,0,0,,...ama nereye gideceğimizi gösterecekler.
Dialogue: 0,0:22:51.86,0:22:54.66,Main,Nami,0,0,0,,İnanılmaz! Balıklarla konuşabiliyor musun?
Dialogue: 0,0:22:54.84,0:22:57.10,Main,Nami,0,0,0,,Deniz kızlarının bunu yapabileceğini bilmiyordum!
Dialogue: 0,0:22:57.26,0:23:00.94,Main,Luffy,0,0,0,,Caimie, sen yanımızda olsaydın\Nistediğimiz kadar balık yiyebilirdik!
Dialogue: 0,0:23:01.16,0:23:03.60,Main,Sanji,0,0,0,,Söylediğine dikkat et.\NBayılıncaya kadar seni döverim.
Dialogue: 0,0:23:03.86,0:23:07.92,Main,Nami,0,0,0,,Ama denizde balıkları nasıl takip edeceğiz?
Dialogue: 0,0:23:08.78,0:23:10.16,Main,Pappag,0,0,0,,Sadece bakın!
Dialogue: 0,0:23:16.40,0:23:17.52,Main,Luffy,0,0,0,,Müthiş!
Dialogue: 0,0:23:18.38,0:23:21.42,Main,Usopp,0,0,0,,Bunu yapabiliyorlar mı? İnanamıyorum!
Dialogue: 0,0:23:21.80,0:23:25.52,Main,Usopp,0,0,0,,Balıklar suda ok çiziyor!
Dialogue: 0,0:23:26.00,0:23:28.78,Main,Nami,0,0,0,,Müthiş! Sadece bunu izlememiz\Ngerekiyor, değil mi?
Dialogue: 0,0:23:29.08,0:23:31.22,Main,Luffy,0,0,0,,Müthişsin, Caimie!
Dialogue: 0,0:23:32.34,0:23:34.66,Main,Camie,0,0,0,,Hayır, daha çok şey öğrenmem lazım.
Dialogue: 0,0:23:34.84,0:23:36.78,Main,Luffy,0,0,0,,Hayır, bu gerçekten etkileyici!
Dialogue: 0,0:23:37.04,0:23:38.80,Main,Usopp,0,0,0,,Tamam! O zaman ben dümene geçeceğim!
Dialogue: 0,0:23:38.98,0:23:40.30,Main,Robin,0,0,0,,Dört yönüne çevir.
Dialogue: 0,0:23:40.90,0:23:41.56,Main,Usopp,0,0,0,,Tamam!
Dialogue: 0,0:23:42.32,0:23:43.15,Main,Luffy,0,0,0,,Zoro!
Dialogue: 0,0:23:43.46,0:23:46.92,Main,Zoro,0,0,0,,Hemen yola çıkıyor muyuz? \NBalık Adam Adası'na gidebilecek gibi miyiz?
Dialogue: 0,0:23:47.08,0:23:51.76,Main,Luffy,0,0,0,,Onu boşver ve buraya bak. \NDeniz kızı Caimie! Gerçek! Müthiş, değil mi?
Dialogue: 0,0:23:51.98,0:23:52.74,Main,Camie,0,0,0,,Merhaba.
Dialogue: 0,0:23:52.94,0:23:53.78,Main,Zoro,0,0,0,,Deniz kızı mı?
Dialogue: 0,0:23:58.08,0:23:59.32,Main,Zoro,0,0,0,,İlk kez görüyorum.
Dialogue: 0,0:23:59.74,0:24:02.80,Main,Chopper,0,0,0,,Sildi! Anısını öylece sildi!
Dialogue: 0,0:24:03.38,0:24:04.76,Main,Camie,0,0,0,,Ama endişeliyim.
Dialogue: 0,0:24:04.96,0:24:09.04,Main,Camie,0,0,0,,Hachi konuşmakta zorlanıyor gibiydi.\NOna kötü bir şey yaptıklarından eminim.
Dialogue: 0,0:24:09.22,0:24:12.40,Main,Pappag,0,0,0,,O zorlu biridir, bu yüzden sorun olmaz.
Dialogue: 0,0:24:12.76,0:24:17.48,Main,Pappag,0,0,0,,Neyse, yardım önermekte epey hızlıydınız ama\Nbununla baş edebileceğinizden emin misiniz?
Dialogue: 0,0:24:17.72,0:24:19.26,Main,Luffy,0,0,0,,Evet! Biz güçlüyüz!
Dialogue: 0,0:24:19.68,0:24:25.80,Main,Pappag,0,0,0,,Buralarda tek bir kaçırma çetesi\Nolmadığı konusunda sizi uyarmalıyım.
Dialogue: 0,0:24:26.30,0:24:31.36,Main,Pappag,0,0,0,,Sabaody Takımadaları'nda insan\Nticareti büyük bir iştir.
Dialogue: 0,0:24:32.90,0:24:36.26,Main,Sanji,0,0,0,,İnsanları satmak mı? Bu korkunç!
Dialogue: 0,0:24:36.56,0:24:39.54,Main,Pappag,0,0,0,,Denizkızlarının özellikle ne kadar\Ndeğerli olduğuna bakarsanız...
Dialogue: 0,0:24:39.70,0:24:44.22,Main,Pappag,0,0,0,,...üç balık adamdan oluşan Macro tayfası,\Nbir süredir Caimie'nin peşindeydi.
Dialogue: 0,0:24:44.92,0:24:49.84,Main,Pappag,0,0,0,,Takoyaki dükkanındaki Hachi, muhtemelen \NMacro Tayfası tarafından kaçırıldığımızı düşündü ve...
Dialogue: 0,0:24:49.96,0:24:54.16,Main,Pappag,0,0,0,,...canavar tarafından yutulduktan sonra bir süredir\Nkayıp olduğumuz için onların peşinden gitti.
Dialogue: 0,0:24:54.38,0:24:56.32,Main,Camie,0,0,0,,Muhtemelen.
Dialogue: 0,0:24:56.96,0:25:00.08,Main,Camie,0,0,0,,Sonuçta Hachi, iyi ve açıksözlü biridir.
Dialogue: 0,0:25:00.56,0:25:01.82,Main,Camie,0,0,0,,Benim hatam.
Dialogue: 0,0:25:05.34,0:25:09.70,Main,Zoro,0,0,0,,Hachi isimli bu ahtapotu duyunca, o aptal\Nbalık adamı düşünmeden edemiyorum.
Dialogue: 0,0:25:10.42,0:25:13.04,Main,Sanji,0,0,0,,Gerçekten oysa yardım etmeyeceğiz.
Dialogue: 0,0:25:13.76,0:25:15.00,Main,Sanji,0,0,0,,Gerçi mümkün değil.
Dialogue: 0,0:25:15.18,0:25:18.64,Main,Pappag,0,0,0,,Normalde Hachi onları kolayca yenerdi...
Dialogue: 0,0:25:18.90,0:25:21.88,Main,Pappag,0,0,0,,...ama Uçan Balık Binicileri'nin onlara\Nyardım edeceğini kim düşünürdü?
Dialogue: 0,0:25:22.08,0:25:23.38,Main,Franky,0,0,0,,Onlar kim?
Dialogue: 0,0:25:24.22,0:25:28.98,Main,Pappag,0,0,0,,Son zamanlarda burada çok sıkıntı\Nçıkaran bir başka adam kaçırma çetesi.
Dialogue: 0,0:25:29.60,0:25:32.62,Main,Pappag,0,0,0,,Birini hedeflerlerse işinin bittiğini söylerler.
Dialogue: 0,0:25:33.60,0:25:36.48,Main,Pappag,0,0,0,,Patronları Duval, demir maskeli bir adamdır.
Dialogue: 0,0:25:37.08,0:25:39.06,Main,Pappag,0,0,0,,Kimse gerçekte neye benzediğini bilmiyor.
Dialogue: 0,0:25:39.70,0:25:42.14,Main,Pappag,0,0,0,,Birini arıyor gibiler.
Dialogue: 0,0:25:42.40,0:25:45.92,Main,Pappag,0,0,0,,Bu bölgeden geçen her\Ngemiyi kontrol ediyorlar.
Dialogue: 0,0:25:46.44,0:25:51.96,Main,Luffy,0,0,0,,Neyse, endişelenmene gerek yok, Caimie.\NTakoyakiyi kesinlikle kurtaracağız!
Dialogue: 0,0:25:52.36,0:25:53.52,Main,Pappag,0,0,0,,Takoyaki satıcısını!
Dialogue: 0,0:25:54.28,0:25:55.84,Main,Camie,0,0,0,,Sağol, Luffy-chin!
Dialogue: 0,0:25:56.00,0:25:59.88,Main,Luffy,0,0,0,,Tamam! Pekâlâ, Brook!\NBizi havaya sokacak bir şeyler çal!
Dialogue: 0,0:26:01.10,0:26:02.60,Main,Brook,0,0,0,,Memnuniyetle!
Dialogue: 0,0:26:11.34,0:26:13.54,Main,Usopp,0,0,0,,Ha? O...
Dialogue: 0,0:26:13.68,0:26:15.62,Main,Usopp,0,0,0,,Hey! Başımız dertte!
Dialogue: 0,0:26:19.14,0:26:20.64,Main,Nami,0,0,0,,Ne oldu, Caimie?
Dialogue: 0,0:26:20.92,0:26:24.76,Main,Camie,0,0,0,,Balıklar, "Üzgünüz ama sizi\Ndaha ileri götüremeyiz" diyor.
Dialogue: 0,0:26:26.24,0:26:28.52,Main,Pappag,0,0,0,,Geldiler! Uçan Balık Binicileri!
Dialogue: 0,0:26:32.88,0:26:35.14,Main,Luffy,0,0,0,,Nerede? Hiçbir şey göremiyorum!
Dialogue: 0,0:26:35.74,0:26:38.02,Main,Camie,0,0,0,,Yanlış! Denizde değiller, havadalar!
Dialogue: 0,0:26:47.88,0:26:49.48,Main,Usopp,0,0,0,,Balıklar uçuyor!
Dialogue: 0,0:26:49.70,0:26:50.86,Main,Luffy,0,0,0,,Süper!
Dialogue: 0,0:26:50.88,0:26:52.36,Main,Zoro,0,0,0,,Etkilenecek zaman mı?!
Dialogue: 0,0:26:52.50,0:26:54.68,Main,Franky,0,0,0,,Kahretsin, bize saldıracaklar!
Dialogue: 0,0:26:54.82,0:26:57.48,Main,Chopper,0,0,0,,Yani 'Uçan Balık', gerçekten\Nuçabiliyor mu?!
Dialogue: 0,0:26:59.92,0:27:01.32,Main,Raider 1,0,0,0,,Hey, bunu gördün mü?!
Dialogue: 0,0:27:01.54,0:27:04.68,Main,Raider 2,0,0,0,,Gördüm! Hiç şüphesiz bunlar\NHasır Şapka Korsanları!
Dialogue: 0,0:27:04.96,0:27:05.92,Main,Raider 1,0,0,0,,Hemen onunla bağlantı kurun!
Dialogue: 0,0:27:06.22,0:27:07.00,Main,Raider 2,0,0,0,,Anlaşıldı.
Dialogue: 0,0:27:07.68,0:27:11.58,Main,Raider 1,0,0,0,,Buraya sadece denizkızını bulmaya geldik\Nama bu bizim şanslı günümüz olmalı!
Dialogue: 0,0:27:11.78,0:27:14.10,Main,Raider 2,0,0,0,,Efendi Duval çok sevinecek!
Dialogue: 0,0:27:16.50,0:27:17.46,Main,Sanji,0,0,0,,Yine geliyorlar!
Dialogue: 0,0:27:17.54,0:27:18.68,Main,Usopp,0,0,0,,Daha fazla yaklaşmayın!
Dialogue: 0,0:27:19.76,0:27:20.84,Main,Zoro,0,0,0,,Bombalar, ha?
Dialogue: 0,0:27:21.14,0:27:21.98,Main,Luffy,0,0,0,,Lanet olasıcalar!
Dialogue: 0,0:27:22.04,0:27:23.54,Main,Luffy,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:27:23.12,0:27:25.10,Secondary,Zoro,0,0,0,,{\fad(150,150)}72 Poundluk Top!
Dialogue: 0,0:27:24.38,0:27:25.70,Main,Luffy,0,0,0,,{\fad(150,150)}Tabanca!
Dialogue: 0,0:27:29.34,0:27:30.82,Main,Usopp,0,0,0,,Çok yakındı.
Dialogue: 0,0:27:30.92,0:27:34.94,Main,Camie,0,0,0,,Dikkatli olun! Uçan balıklar sudan çıktıklarında\Nbeş dakika boyunca havada kalabilirler!
Dialogue: 0,0:27:43.52,0:27:48.53,Captions,,840,0,286,,{\fad(150,1800)}Uçan Balık Binicileri\NSaklanma Yeri
Dialogue: 0,0:27:44.54,0:27:45.76,Main,,0,0,0,,Hey, Macro.
Dialogue: 0,0:27:45.90,0:27:47.64,Main,,0,0,0,,Evet, lordum Duval.
Dialogue: 0,0:27:47.82,0:27:53.34,Main,,0,0,0,,Görünüşe göre üsse çektiğin deniz kızı,\Nşu anda bir korsan gemisinde.
Dialogue: 0,0:27:53.50,0:27:55.74,Main,,0,0,0,,Ha? Caimie korsan gemisinde mi?!
Dialogue: 0,0:27:59.06,0:28:03.04,Main,,0,0,0,,Beklemekten bıktım. Gerçekten bıktım!
Dialogue: 0,0:28:03.70,0:28:08.72,Main,,0,0,0,,O korsan gemisi, beklediğim gemi!
Dialogue: 0,0:28:11.00,0:28:12.88,Main,,0,0,0,,Onu öldüreceğim!
Dialogue: 0,0:28:13.20,0:28:17.02,Main,,0,0,0,,Hayatımı mahveden o adamı!
