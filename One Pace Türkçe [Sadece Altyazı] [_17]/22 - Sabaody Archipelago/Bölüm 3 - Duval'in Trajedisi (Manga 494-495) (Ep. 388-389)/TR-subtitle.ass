Dialogue: 0,0:00:05.30,0:00:09.17,Lyrics,,0,0,0,,♪ Gökyüzüne ulaşana kadar, ♪
Dialogue: 0,0:00:09.27,0:00:15.71,Lyrics,,0,0,0,,♪ İnanıyorum, sonraki yarına kadar, hey ♪
Dialogue: 0,0:00:15.73,0:00:19.13,Lyrics,,0,0,0,,♪ hadi millet gidelim, müziği paylaşıyoruz. ♪
Dialogue: 0,0:00:19.96,0:00:23.36,Lyrics,,0,0,0,,♪ hadi gidelim bebeğim, bebeğim, oh tek bir hayali paylaşıyoruz. ♪
Dialogue: 0,0:00:23.88,0:00:27.28,Lyrics,,0,0,0,,♪ hadi millet gidelim, oh iyi zamanları paylaşıyoruz. ♪
Dialogue: 0,0:00:27.71,0:00:31.11,Lyrics,,0,0,0,,♪ hadi gidelim bebeğim, bebeğim, oh tek bir dünyayı paylaşıyoruz. ♪
Dialogue: 0,0:00:31.81,0:00:35.55,Lyrics,,0,0,0,,♪ Mobius yüzüğünün tepesinde kovalıyor ve kovalanıyor. ♪
Dialogue: 0,0:00:35.58,0:00:39.35,Lyrics,,0,0,0,,♪ Yaklaşıyor ve ileri bakıyorum, hey tarzını paylaşmak istiyorum. ♪
Dialogue: 0,0:00:39.52,0:00:43.45,Lyrics,,0,0,0,,♪ Başlıyor, genişliyor, hayal gücünün üstündeki bu tat. ♪
Dialogue: 0,0:00:43.52,0:00:47.76,Lyrics,,0,0,0,,♪ Vücudumu baştan başa iyi hissediyorum, özgür kalacağım, oh evet ♪
Dialogue: 0,0:00:47.79,0:00:49.79,Lyrics,,0,0,0,,♪ Uzakta olsa da, müziği paylaş. ♪
Dialogue: 0,0:00:49.79,0:00:51.73,Lyrics,,0,0,0,,♪ Birbirine anlatarak o rüyayı paylaş. ♪
Dialogue: 0,0:00:51.76,0:00:53.60,Lyrics,,0,0,0,,♪ İyi zamanları ve kahkahaları paylaş. ♪
Dialogue: 0,0:00:53.72,0:00:55.27,Lyrics,,0,0,0,,♪ şimdi tek bir dünyayı paylaş. ♪
Dialogue: 0,0:00:55.45,0:01:03.74,Lyrics,,0,0,0,,♪ Gökyüzüne ulaşana kadar gitmeye devam edeceğim. ♪
Dialogue: 0,0:01:03.81,0:01:13.05,Lyrics,,0,0,0,,♪ Hadi üstesinden gelelim, sonraki yarınlara inanıyorum, evet evet... ♪
Dialogue: 0,0:01:13.15,0:01:21.56,Lyrics,,0,0,0,,♪ Görünmez duvarın diğer tarafında bekliyordun. ♪
Dialogue: 0,0:01:21.66,0:01:31.62,Lyrics,,0,0,0,,♪ Yakında orada olacağım, tek bir dünyaya inanıyorum, evet evet... ♪
Dialogue: 0,0:01:31.64,0:01:35.04,Lyrics,,0,0,0,,♪ hadi millet gidelim, müziği paylaşıyoruz. ♪
Dialogue: 0,0:01:35.67,0:01:39.87,Lyrics,,0,0,0,,♪ hadi gidelim bebeğim, bebeğim, oh tek bir dünyayı paylaşıyoruz. ♪
Dialogue: 0,0:01:51.46,0:01:55.32,Main,Brook,0,0,0,,Sınırıma ulaştım! Kaslarıma kramp girdi!
Dialogue: 0,0:01:52.24,0:01:58.40,Author,,0,0,0,,{\fad(1800,0)\fs17} Türkçeleştirme & Çevirmen  {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&} - {\c&H01BAFF&}{\b1}kazasker{\b0}{\c&HFFFFFF&}\N{\fs18}thx to onepace.net
Dialogue: 0,0:23:24.10,0:23:27.10,Author,,0,0,0,,{\fad(0,300)\fs17} Türkçeleştirme & Çevirmen  {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&} - {\c&H01BAFF&}{\b1}kazasker{\b0}{\c&HFFFFFF&}\N{\fs18}thx to onepace.net
Dialogue: 0,0:01:52.24,0:01:58.40,Title,,0,0,250,,{\fad(1800,0)}Duval'in Trajedisi
Dialogue: 0,0:01:55.64,0:01:58.40,Main,Brook,0,0,0,,Gerçi kramp girecek kaslarım yok!
Dialogue: 0,0:01:58.74,0:02:00.68,Main,Zoro,0,0,0,,Brook, epey şevklisin, ha?
Dialogue: 0,0:02:01.16,0:02:03.12,Main,Zoro,0,0,0,,Uçan Balıklar'ın çoğunu hallettin.
Dialogue: 0,0:02:04.12,0:02:05.88,Main,Brook,0,0,0,,Yardımcı olduğuma sevindim!
Dialogue: 0,0:02:06.22,0:02:08.32,Main,Brook,0,0,0,,Ama lütfen biraz dinleneyim.
Dialogue: 0,0:02:10.52,0:02:11.42,Main,Brook,0,0,0,,Zoro-san...
Dialogue: 0,0:02:11.76,0:02:14.00,Main,Brook,0,0,0,,Görünüşe göre yaraların halen iyileşmemiş...
Dialogue: 0,0:02:14.48,0:02:18.86,Main,Zoro,0,0,0,,O balıkların beni yenmesine izin\Nvermeyeceğim! Dert etme!
Dialogue: 0,0:02:20.70,0:02:23.34,Thoughts,Hachi,0,0,0,,Tedbiri elden bıraktın, Roronoa!
Dialogue: 0,0:02:23.58,0:02:25.36,Main,Hachi,0,0,0,,{\fad(150,150)}Altı Kılıç Stili...
Dialogue: 0,0:02:26.60,0:02:28.86,Main,Hachi,0,0,0,,{\fad(150,150)}...Ahtapot Kol Tehlikesi!
Dialogue: 0,0:02:41.64,0:02:43.10,Main,Zoro,0,0,0,,Beni kurtardın, ha?
Dialogue: 0,0:02:44.22,0:02:47.85,Main,Hachi,0,0,0,,Evet! Siz dalıp gitmiştiniz.
Dialogue: 0,0:02:49.26,0:02:51.70,Main,Camie,0,0,0,,Hacchin! Gerçekten süperdin!
Dialogue: 0,0:02:51.74,0:02:53.56,Main,Pappag,0,0,0,,Senden de bunu beklerim, Hachi!
Dialogue: 0,0:02:54.34,0:02:55.26,Main,Hachi,0,0,0,,Öyle mi?
Dialogue: 0,0:02:56.80,0:02:58.52,Main,Rider,0,0,0,,Geber, balık adam!
Dialogue: 0,0:02:59.62,0:03:00.94,Main,Brook,0,0,0,,Evet! İzninizle!
Dialogue: 0,0:03:08.00,0:03:10.70,Main,Hachi,0,0,0,,Öleceğimi sanmıştım! Sağol!
Dialogue: 0,0:03:11.02,0:03:12.71,Main,Zoro,0,0,0,,Kendine dikkat et demiştim, değil mi?
Dialogue: 0,0:03:13.90,0:03:16.38,Main,Riders,0,0,0,,Onlarla teker teker uğraşmayın. Düzen oluşturun!
Dialogue: 0,0:03:15.42,0:03:16.38,Hentai,Text-bubble,0,0,0,,{\frz22\pos(778,594)}Düzen (Hentai)
Dialogue: 0,0:03:18.14,0:03:18.88,Main,Franky,0,0,0,,Sapık?
Dialogue: 0,0:03:18.89,0:03:20.31,Hentai,Text-bubble,0,0,0,,{\frz339\pos(790,126)}Sapık\N(Hentai)
Dialogue: 0,0:03:19.52,0:03:20.26,Main,Franky,0,0,0,,Beni mi çağırdınız?
Dialogue: 0,0:03:20.92,0:03:22.88,Main,Riders,0,0,0,,Uçuş düzeninde saldırın!
Dialogue: 0,0:03:22.83,0:03:24.05,Hentai,Text-bubbles,0,0,0,,{\frz25\fs38\pos(958,436)}Düzen (Hentai)
Dialogue: 0,0:03:23.23,0:03:24.05,Hentai,Text-bubbles,0,0,0,,{\frz28\pos(560,662)}Uçuş (Hikou)
Dialogue: 0,0:03:24.64,0:03:25.80,Main,Franky,0,0,0,,Suçlu sapık?
Dialogue: 0,0:03:25.80,0:03:27.55,Hentai,Text-bubbles,0,0,0,,{\frz341\fs36\pos(814,394)}Sapık (Hentai)
Dialogue: 0,0:03:26.17,0:03:27.55,Hentai,Text-bubbles,0,0,0,,{\frz340.9\fs33\pos(582,144)}Suçlu (Hikou)
Dialogue: 0,0:03:26.74,0:03:27.88,Main,Franky,0,0,0,,Beni mi kastediyorsunuz?
Dialogue: 0,0:03:28.00,0:03:28.64,Main,Chopper,0,0,0,,Geldiler!
Dialogue: 0,0:03:33.34,0:03:35.33,Main,Nami,0,0,0,,Buradayım! Burada!
Dialogue: 0,0:03:35.84,0:03:37.35,Main,Nami,0,0,0,,Hoşgeldiniz!
Dialogue: 0,0:03:38.54,0:03:41.98,Main,Rider,0,0,0,,Kadın? Çok yazık ama herkesi\Nöldürmemiz emredildi!
Dialogue: 0,0:03:42.54,0:03:44.14,Main,Nami,0,0,0,,Beni öldürebilir misiniz?
Dialogue: 0,0:03:45.42,0:03:46.44,Main,Riders,0,0,0,,Ne?!
Dialogue: 0,0:03:49.66,0:03:50.30,Main,Nami,0,0,0,,Çok yazık.
Dialogue: 0,0:03:50.44,0:03:51.42,Main,Nami,0,0,0,,{\fad(150,150)}Serap Tempo!
Dialogue: 0,0:03:51.82,0:03:54.18,Main,Nami,0,0,0,,Umutsuzluk fırtına bulutlarından sakının!
Dialogue: 0,0:03:57.96,0:03:58.86,Main,Robin,0,0,0,,{\fad(150,150)}İki El
Dialogue: 0,0:03:59.60,0:04:00.55,Main,Robin,0,0,0,,{\fad(150,150)}Kavra!
Dialogue: 0,0:04:02.98,0:04:03.98,Main,Chopper,0,0,0,,{\fad(150,150)}Çatal Tırnak
Dialogue: 0,0:04:04.56,0:04:05.66,Main,Chopper,0,0,0,,{\fad(150,150)}Elmas!
Dialogue: 0,0:04:08.48,0:04:10.06,Main,Rider,0,0,0,,Düzeni bozmayın!
Dialogue: 0,0:04:10.18,0:04:11.52,Main,Franky,0,0,0,,Biliyordum, bana sesleniyorlar.
Dialogue: 0,0:04:11.80,0:04:12.68,Main,Rider,0,0,0,,Şimdi!
Dialogue: 0,0:04:12.88,0:04:15.40,Main,Franky,0,0,0,,Ha? Beni kastetmediler mi?
Dialogue: 0,0:04:16.18,0:04:18.57,Main,Rider,0,0,0,,Ne?! Mermiler ona işlemiyor mu?!
Dialogue: 0,0:04:20.02,0:04:23.40,Main,Franky,0,0,0,,{\fad(150,150)}Güçlü Çekiç!
Dialogue: 0,0:04:25.60,0:04:29.06,Main,Camie,0,0,0,,Müthiş! Gerçekten hepsi çok güçlü, Pappagg!
Dialogue: 0,0:04:29.18,0:04:31.52,Main,Pappag,0,0,0,,Bu kadar ileri gideceklerini düşünmek...
Dialogue: 0,0:04:32.32,0:04:36.82,Main,Pappag,0,0,0,,Sadece Hachi'yi alıp kaçacaktık.
Dialogue: 0,0:04:36.94,0:04:38.10,Main,Usopp,0,0,0,,Alın bakalım!
Dialogue: 0,0:04:39.66,0:04:43.59,Main,Usopp,0,0,0,,Kahretsin! Franky!\NGemiyi kıyıya çekmeliyiz!
Dialogue: 0,0:04:43.88,0:04:47.18,Main,Usopp,0,0,0,,Okyanusta avantajlılar!
Dialogue: 0,0:04:47.58,0:04:50.61,Main,Franky,0,0,0,,Muhtemelen üslerini bu\Nyüzden buraya yapmışlar.
Dialogue: 0,0:04:50.84,0:04:53.82,Main,Franky,0,0,0,,Gemiyi kullanma şansı vermeyeceklerdir!
Dialogue: 0,0:05:03.88,0:05:04.54,Main,Zoro,0,0,0,,Luffy!
Dialogue: 0,0:05:04.62,0:05:06.46,Main,Luffy,0,0,0,,Kaçın! Koca bir adam geliyor!
Dialogue: 0,0:05:06.54,0:05:07.56,Main,Hachi,0,0,0,,Demir Maske mi?!
Dialogue: 0,0:05:07.72,0:05:09.34,Main,Luffy,0,0,0,,Maskeli adam ve inek!
Dialogue: 0,0:05:09.62,0:05:10.41,Main,Zoro,0,0,0,,İnek?
Dialogue: 0,0:05:16.66,0:05:17.93,Main,Riders,0,0,0,,Bu Motoboro'nun sesi!
Dialogue: 0,0:05:18.22,0:05:19.26,Main,Riders,0,0,0,,Patron geliyor!
Dialogue: 0,0:05:20.58,0:05:23.84,Main,Duval,0,0,0,,Sürüler halinde dökülüyorsunuz...
Dialogue: 0,0:05:24.36,0:05:26.24,Main,Usopp,0,0,0,,O da ne?! Bir şey geldi!
Dialogue: 0,0:05:25.77,0:05:30.40,Captions,,0,0,240,,{\fad(500,0)\fs32}Duval'in\NSevgili Bizonu\N{\r}Motobaro
Dialogue: 0,0:05:26.36,0:05:30.40,Main,Duval,0,0,2,,Sadece böcek değilsiniz, Uçan Balık Binicileri!
Dialogue: 0,0:05:30.84,0:05:33.06,Main,Usopp,0,0,0,,K-Kendi evini ezdi.
Dialogue: 0,0:05:33.44,0:05:38.40,Main,Duval,0,0,0,,Hasır Şapkaları öldürebilirsem\Nartık bu üsse ihtiyacım olmayacak!
Dialogue: 0,0:05:38.54,0:05:43.02,Main,Rider,0,0,0,,Çok üzgünüz, Patron! Onları denize\Nçekip hemen işlerini bitireceğiz.
Dialogue: 0,0:05:43.10,0:05:44.40,Main,Duval,0,0,0,,Çekilin!
Dialogue: 0,0:05:46.00,0:05:52.00,Main,Duval,0,0,0,,Balık adama, deniz kızına veya eldivene ihtiyacım\Nyok! Kaçmak istiyorsanız, hemen kaybolun!
Dialogue: 0,0:05:52.14,0:05:53.88,Main,Pappag,0,0,0,,Ben denizyıldızıyım!
Dialogue: 0,0:05:55.58,0:05:59.60,Main,Duval,0,0,0,,İstediğim için köle ticareti işine girmedim!
Dialogue: 0,0:05:59.90,0:06:02.47,Main,Duval,0,0,0,,Bunu anlıyorsunuz, değil mi?!
Dialogue: 0,0:06:02.78,0:06:05.36,Main,Riders,0,0,0,,Elbette, Patron!
Dialogue: 0,0:06:05.62,0:06:08.23,Main,Duval,0,0,0,,Bu gün ne harika bir gün!
Dialogue: 0,0:06:08.54,0:06:14.78,Main,Duval,0,0,0,,Öldürmeyi çok arzu ettiğim ve hatta\Nrüyalarımda gördüğüm adam tam burada.
Dialogue: 0,0:06:15.10,0:06:16.89,Main,Duval,0,0,0,,Çok minnettarım!
Dialogue: 0,0:06:17.04,0:06:19.50,Main,Duval,0,0,0,,Sanırım Kami-sama var, ha?
Dialogue: 0,0:06:19.84,0:06:25.22,Main,Duval,0,0,0,,Bir gün, o adam yüzünden\NCehennem'in derinliklerine atıldım!
Dialogue: 0,0:06:25.82,0:06:28.84,Main,Usopp,0,0,0,,Hey, konuşurken bize bakmıyor mu?
Dialogue: 0,0:06:29.46,0:06:36.51,Main,Duval,0,0,0,,Kendim ölsem bile seni\Nbugün burada öldüreceğim.
Dialogue: 0,0:06:36.86,0:06:40.71,Main,Duval,0,0,0,,Korsan Kara Bacak Sanji!
Dialogue: 0,0:06:41.88,0:06:44.42,Main,Duval,0,0,0,,Seninle gerçekten karşılaşmak istiyordum!
Dialogue: 0,0:06:44.84,0:06:47.42,Main,Rider,0,0,0,,Eyvah! Patron gerçekten kızmış!
Dialogue: 0,0:06:47.52,0:06:51.32,Main,Sanji,0,0,0,,Beni? O adam beni mi öldürmek istiyor?
Dialogue: 0,0:06:51.90,0:06:53.69,Main,Franky,0,0,0,,Sanji, kim o adam?
Dialogue: 0,0:06:53.86,0:06:56.46,Main,Franky,0,0,0,,Sana karşı bir tür kini var gibi.
Dialogue: 0,0:06:56.86,0:07:00.06,Main,Nami,0,0,0,,Restoranda olan bir şey\Nolabilir mi? Hatırlamaya çalış!
Dialogue: 0,0:07:00.18,0:07:06.78,Main,Sanji,0,0,0,,O zamandansa, insanların bana\Nkızabileceği bir sürü şey yaptım.
Dialogue: 0,0:07:07.62,0:07:09.54,Main,Usopp,0,0,0,,Bırak seni vursun! Bunu hak ettin!
Dialogue: 0,0:07:10.74,0:07:13.52,Main,Duval,0,0,0,,Aptal rolü yapmayı bırak, Kara Bacak!
Dialogue: 0,0:07:13.74,0:07:16.32,Main,Duval,0,0,0,,Burada yakın zamanda olmuş\Nbir şeyden bahsediyoruz!
Dialogue: 0,0:07:16.90,0:07:18.66,Main,Usopp,0,0,0,,Eyvah! Bunlar zıpkın!
Dialogue: 0,0:07:21.58,0:07:24.89,Main,Sanji,0,0,0,,Ama yakın zamandaysa kafam daha da karıştı!
Dialogue: 0,0:07:27.76,0:07:31.02,Main,Usopp,0,0,0,,N-Ne? Bu zıpkınlarda bir tuhaflık var.
Dialogue: 0,0:07:31.34,0:07:34.20,Main,Duval,0,0,0,,Bunlar akrep zehirli zıpkınlarım!
Dialogue: 0,0:07:34.56,0:07:37.62,Main,Duval,0,0,0,,Size denk gelirse üç dakika\Niçinde tahtalı köyü boylarsınız!
Dialogue: 0,0:07:38.20,0:07:40.62,Main,Duval,0,0,0,,Öfkemin derinliğini bilin!
Dialogue: 0,0:07:42.44,0:07:43.74,Main,Sanji,0,0,0,,Nami-san, dikkat et!
Dialogue: 0,0:07:44.86,0:07:48.98,Main,Sanji,0,0,0,,Pislik herif, hiç hatırlamıyorum!\NKimsin sen?!
Dialogue: 0,0:07:49.52,0:07:52.08,Main,Duval,0,0,0,,Seni ve tayfanı öldüreceğim!
Dialogue: 0,0:07:52.20,0:07:54.42,Main,Luffy,0,0,0,,Maskenin altında ne olduğunu gördüm.
Dialogue: 0,0:07:55.00,0:07:56.99,Main,Zoro,0,0,0,,Cidden mi? Kim o?
Dialogue: 0,0:07:57.44,0:07:59.72,Main,Luffy,0,0,0,,Sakın şaşırma! Onun yüzünü sen de gördün!
Dialogue: 0,0:07:59.98,0:08:00.68,Main,Zoro,0,0,0,,Ben de mi?
Dialogue: 0,0:08:06.62,0:08:08.27,Main,Riders,0,0,0,,Pislik herif!
Dialogue: 0,0:08:13.72,0:08:15.94,Main,Riders,0,0,0,,Duval-sama'nın demir maskesini çıkardı!
Dialogue: 0,0:08:21.78,0:08:26.86,Main,Duval,0,0,0,,Pekâlâ, yaralı yüzüme iyi bakın!
Dialogue: 0,0:08:27.08,0:08:28.32,Main,Usopp,0,0,0,,Ne?!
Dialogue: 0,0:08:28.48,0:08:29.42,Main,Nami,0,0,0,,Olamaz!
Dialogue: 0,0:08:43.16,0:08:43.90,Main,Zoro,0,0,0,,O!
Dialogue: 0,0:08:44.24,0:08:45.10,Main,Robin,0,0,0,,Ha?!
Dialogue: 0,0:08:45.62,0:08:46.84,Main,Brook,0,0,0,,Aman...
Dialogue: 0,0:08:49.30,0:08:50.54,Main,Franky,0,0,0,,Ağlamak istiyorum!
Dialogue: 0,0:08:50.94,0:08:54.11,Main,Duval,0,0,0,,Bu günü bekliyordum.
Dialogue: 0,0:08:54.42,0:08:58.93,Main,Duval,0,0,0,,Seni öldürmeye karar verdim\Nve denize açıldım!
Dialogue: 0,0:08:59.28,0:09:02.22,Main,Duval,0,0,0,,Ama seni aramak sorun olacaktı.
Dialogue: 0,0:09:02.50,0:09:05.36,Main,Duval,0,0,0,,Sonuçta aranıyor posterin ve\Ngerçek yüzün uyuşmuyordu!
Dialogue: 0,0:09:05.74,0:09:12.30,Main,Duval,0,0,0,,Denizciler veya ödül avcıları sana\Nrastlasalar da seni fark etmeyebilirler!
Dialogue: 0,0:09:12.54,0:09:15.00,Main,Duval,0,0,0,,Hayır, bunun olması mümkün değildi!
Dialogue: 0,0:09:15.44,0:09:17.76,Main,Duval,0,0,0,,Onlar seni kesinlikle bulurlardı!
Dialogue: 0,0:09:17.80,0:09:18.88,Main,Riders,0,0,0,,Patron!
Dialogue: 0,0:09:19.38,0:09:22.72,Main,Duval,0,0,0,,Seni bulup ve derlerdi ki:...
Dialogue: 0,0:09:25.02,0:09:27.46,Main,Duval,0,0,0,,..."Seni buldum!"
Dialogue: 0,0:09:28.60,0:09:31.15,Main,Duval,0,0,0,,"Kara Bacak Sanji!"
Dialogue: 0,0:09:31.82,0:09:34.05,Main,Duval,0,0,0,,Sonra onlara dedim ki:...
Dialogue: 0,0:09:35.20,0:09:38.68,Main,Duval,0,0,0,,..."Öyle birini tanımıyorum!"
Dialogue: 0,0:09:40.10,0:09:43.62,Main,Duval,0,0,0,,"Korsan bile değilim!"
Dialogue: 0,0:09:50.78,0:09:52.38,Main,Usopp,0,0,0,,Hey, Sanji! Nereye gidiyorsun?!
Dialogue: 0,0:09:56.80,0:09:58.20,Main,Duval,0,0,0,,Aniden ödül avcılarının...
Dialogue: 0,0:09:58.38,0:10:01.98,Main,Duval,0,0,0,,...hedefi haline gelmenin ne kadar\Nkorkunç olduğunu anlıyor musun?!
Dialogue: 0,0:10:02.30,0:10:03.02,Main,Duval,0,0,0,,Niye?
Dialogue: 0,0:10:03.22,0:10:06.98,Main,Duval,0,0,0,,Niye aniden Denizci Karargâhı\Ntarafından kovalanmak zorundayım?!
Dialogue: 0,0:10:07.52,0:10:11.82,Main,Duval,0,0,0,,Niye bütün ünlü ödül avcıları\Nbeni avlamaya başladı?!
Dialogue: 0,0:10:12.26,0:10:13.86,Main,Duval,0,0,0,,Niye?!
Dialogue: 0,0:10:17.40,0:10:17.98,Main,Luffy,0,0,0,,Sanji?
Dialogue: 0,0:10:18.10,0:10:20.08,Main,Duval,0,0,0,,Ne yaptım ben?!
Dialogue: 0,0:10:21.30,0:10:23.52,Main,Duval,0,0,0,,Hayatımı bana geri ver!
Dialogue: 0,0:10:24.82,0:10:27.50,Main,Duval,0,0,0,,Kara Bacak Sanji!
Dialogue: 0,0:10:36.30,0:10:37.88,Main,Sanji,0,0,0,,Umrumda değil!
Dialogue: 0,0:10:41.08,0:10:42.46,Main,Riders,0,0,0,,Patron!
Dialogue: 0,0:10:43.52,0:10:45.00,Main,Duval,0,0,0,,"Umrumda değil" de ne demek?!
Dialogue: 0,0:10:45.24,0:10:48.36,Main,Duval,0,0,0,,Bunun sorumluluğunu sen\Nalmayacaksan da kim alacak?!
Dialogue: 0,0:10:48.48,0:10:49.22,Main,Sanji,0,0,0,,Kapa çeneni!
Dialogue: 0,0:10:49.44,0:10:52.26,Main,Sanji,0,0,0,,Aranıyor posterine herkesten\Ndaha fazla kızdım!
Dialogue: 0,0:10:55.40,0:10:57.74,Main,Chopper,0,0,0,,Demek böyle şeyler\Ngerçekten olabiliyor, ha?
Dialogue: 0,0:10:57.94,0:10:59.26,Main,Nami,0,0,0,,Ne şaşırtıcı...
Dialogue: 0,0:10:59.42,0:11:00.90,Main,Nami,0,0,0,,Dünya gerçekten büyük.
Dialogue: 0,0:11:01.32,0:11:05.34,Main,Usopp,0,0,0,,Sanji bir tür mucize yıldızı\Naltında falan mı doğmuş?
Dialogue: 0,0:11:05.82,0:11:09.25,Main,Robin,0,0,0,,Bir gün epey ilginç bir\Nsonla karşılaşabilir.
Dialogue: 0,0:11:09.44,0:11:12.48,Main,Franky,0,0,0,,Duval için üzülmeden edemiyorum.
Dialogue: 0,0:11:16.76,0:11:18.66,Main,Hachi,0,0,0,,İkisi aynen birbirine benziyor!
Dialogue: 0,0:11:18.80,0:11:19.68,Main,Zoro,0,0,0,,Aynı kabuktaki iki bezelye gibi.
Dialogue: 0,0:11:28.98,0:11:31.50,Main,Sanji,0,0,0,,Brook! Daha sonra senin canına okuyacağım!
Dialogue: 0,0:11:31.70,0:11:32.64,Main,Luffy,0,0,0,,Pekâlâ, Sanji.
Dialogue: 0,0:11:32.76,0:11:34.08,Main,Luffy,0,0,0,,Biz önden gidiyoruz.
Dialogue: 0,0:11:34.14,0:11:35.69,Main,Sanji,0,0,0,,Benim hatam olduğunu mu söylüyorsun?!
Dialogue: 0,0:11:36.98,0:11:40.22,Main,Sanji,0,0,0,,Aranıyor posterindeki gibi görünmek istemiyorsan\Nsaç stilini veya sakalını değiştirmeye ne dersin?!
Dialogue: 0,0:11:40.38,0:11:42.42,Main,Sanji,0,0,0,,Değiştirebileceğin bir sürü\Nşey var, değil mi?!
Dialogue: 0,0:11:49.76,0:11:51.34,Main,Duval,0,0,0,,Yani bunu yapabilir miydim?
Dialogue: 0,0:11:51.42,0:11:53.36,Main,Sanji,0,0,0,,Hepiniz sersem misiniz?!
Dialogue: 0,0:11:53.80,0:11:55.64,Main,Duval,0,0,0,,Değiliz!
Dialogue: 0,0:11:57.92,0:12:00.77,Main,Duval,0,0,0,,Kara Bacak, biz...
Dialogue: 0,0:12:01.52,0:12:02.88,Main,Duval,0,0,0,,...biz...
Dialogue: 0,0:12:04.72,0:12:10.24,Main,Duval,0,0,0,,...bu denizin uzak bir köşesinde\Nbilinmeyen bir mafya çetesiydik.
Dialogue: 0,0:12:16.40,0:12:20.60,Main,Duval,0,0,0,,Her günümüzü para için köylüleri\Ntehdit ederek geçirirdik.
Dialogue: 0,0:12:20.68,0:12:24.04,Main,Duval,0,0,0,,Böyle mutlu bir hayatımız vardı.
Dialogue: 0,0:12:32.84,0:12:33.76,Main,Duval,0,0,0,,Kara Bacak,...
Dialogue: 0,0:12:34.08,0:12:35.70,Main,Duval,0,0,0,,...anlıyor musun?
Dialogue: 0,0:12:36.18,0:12:39.24,Main,Duval,0,0,0,,Asla curcunaya sebep olmamış olan ben,...
Dialogue: 0,0:12:39.50,0:12:44.62,Main,Duval,0,0,0,,...aniden kendimi kafama \N77 milyon ödül konmuş olarak ve...
Dialogue: 0,0:12:45.36,0:12:49.36,Main,Duval,0,0,0,,...güçlü denizciler tarafından\Nkovalanır buldum.
Dialogue: 0,0:12:49.86,0:12:52.24,Main,Duval,0,0,0,,Sırtımda bu kötü yara oluştu...
Dialogue: 0,0:12:52.34,0:12:55.70,Main,Duval,0,0,0,,...ve yüzümü dünyadan gizlemek için bu\Ndemir maskeyi giymek zorunda kaldım!
Dialogue: 0,0:12:56.66,0:13:00.40,Main,Duval,0,0,0,,Hayatımın mahvolması senin hatandı!
Dialogue: 0,0:13:00.62,0:13:03.78,Main,Duval,0,0,0,,Seni Cehennem'in dibine\Nkadar takip etmeye hazırım!
Dialogue: 0,0:13:04.00,0:13:05.16,Main,Duval,0,0,0,,Bu senin için sorun olacaksa...
Dialogue: 0,0:13:05.40,0:13:08.26,Main,Duval,0,0,0,,...beni burada öldürmeye ne dersin?!
Dialogue: 0,0:13:11.88,0:13:13.42,Main,Duval,0,0,0,,Öldürülüyorum!
Dialogue: 0,0:13:14.20,0:13:16.76,Main,Sanji,0,0,0,,Suçlamaların aptalca.
Dialogue: 0,0:13:16.96,0:13:21.38,Main,Sanji,0,0,0,,Niye Nami-san ve Robin-chan'ı da\Ntehlikeye sokmak zorundaydın?!
Dialogue: 0,0:13:22.38,0:13:26.60,Main,Duval,0,0,0,,Seni ünlü bir korsan yapan\No gemi ve o tayfa değil mi?!
Dialogue: 0,0:13:27.26,0:13:31.60,Main,Duval,0,0,0,,Elbette onlardan da intikam almak isterdim!
Dialogue: 0,0:13:31.72,0:13:34.68,Main,Duval,0,0,0,,Hepiniz ölmelisiniz!
Dialogue: 0,0:13:35.08,0:13:36.06,Main,Sanji,0,0,0,,Zehirli zıpkınlar?!
Dialogue: 0,0:13:37.12,0:13:38.58,Main,Duval,0,0,0,,Düzen alın!
Dialogue: 0,0:13:38.64,0:13:38.98,Main,Franky,0,0,0,,Ha?
Dialogue: 0,0:13:40.90,0:13:41.72,Main,Sanji,0,0,0,,Eyvah!
Dialogue: 0,0:13:44.28,0:13:45.18,Main,Nami,0,0,0,,Sanji-kun!
Dialogue: 0,0:13:45.52,0:13:47.34,Main,Usopp,0,0,0,,Onu okyanusa çekmeye çalışıyorlar!
Dialogue: 0,0:13:47.44,0:13:49.28,Main,Usopp,0,0,0,,Sanji! Hemen çık oradan!
Dialogue: 0,0:13:50.86,0:13:52.78,Main,Sanji,0,0,0,,Kahretsin, bu ağ çelikten yapılmış!
Dialogue: 0,0:13:52.98,0:13:55.44,Main,Duval,0,0,0,,Acı çek ve boğul!
Dialogue: 0,0:13:55.60,0:13:56.30,Main,Chopper,0,0,0,,Sanji!
Dialogue: 0,0:14:01.84,0:14:03.52,Main,Luffy,0,0,0,,Kahretsin! Seni şimdi kurtaracağım!
Dialogue: 0,0:14:03.62,0:14:06.20,Main,Zoro,0,0,0,,Kendin gitme, aptal! Ben giderim!
Dialogue: 0,0:14:06.38,0:14:07.20,Main,Hachi,0,0,0,,Durun!
Dialogue: 0,0:14:07.30,0:14:09.24,Main,Hachi,0,0,0,,Siz insanlar çok yavaşsınız,\Nonu yakalayamazsınız!
Dialogue: 0,0:14:09.48,0:14:10.62,Main,Hachi,0,0,0,,Bana bırakın!
Dialogue: 0,0:14:11.96,0:14:12.84,Main,Duval,0,0,0,,Ahmak!
Dialogue: 0,0:14:13.28,0:14:16.18,Main,Duval,0,0,0,,Balık adamların yakalama şansı hiç yok!
Dialogue: 0,0:14:16.84,0:14:20.74,Main,Duval,0,0,0,,Uçan Balık, denizdeki en hızlı hayvandır!
Dialogue: 0,0:14:20.90,0:14:26.40,Main,Duval,0,0,0,,Sürücülerin ise hava tankları var, bu yüzden\Nsu altında istedikleri kadar kalabilirler!
Dialogue: 0,0:14:26.58,0:14:29.70,Main,Duval,0,0,0,,O herifin hiç şansı yok!
Dialogue: 0,0:14:32.70,0:14:36.20,Main,Duval,0,0,0,,Kara Bacak yüzeye tekrar çıktığında...
Dialogue: 0,0:14:36.32,0:14:38.92,Main,Duval,0,0,0,,...çoktan boğulup ölmüş olacak!
Dialogue: 0,0:14:39.30,0:14:40.68,Main,Rider,0,0,0,,Ne?!
Dialogue: 0,0:14:45.12,0:14:47.68,Main,Rider,0,0,0,,Patron'un öfkesini hisset, Kara Bacak!
Dialogue: 0,0:14:49.08,0:14:50.04,Thoughts,Sanji,0,0,0,,Nefes alamıyorum.
Dialogue: 0,0:14:53.80,0:14:54.70,Main,Camie,0,0,0,,Sorun yok!
Dialogue: 0,0:14:58.72,0:14:59.54,Main,Nami,0,0,0,,Camie!
Dialogue: 0,0:15:00.58,0:15:02.14,Main,Pappag,0,0,0,,Hey, kovboy!
Dialogue: 0,0:15:02.28,0:15:05.22,Main,Pappag,0,0,0,,Birini unutmuş gibisin!
Dialogue: 0,0:15:05.34,0:15:05.90,Main,,0,0,0,,Ha?
Dialogue: 0,0:15:06.10,0:15:09.34,Main,Pappag,0,0,0,,Uçan Balıklar'ın balık adamlardan\Nhızlı olduğu doğru.
Dialogue: 0,0:15:09.56,0:15:12.68,Main,Pappag,0,0,0,,Deniz yaratıkları arasında\Nen iyileri. Gerçekten müthişler!
Dialogue: 0,0:15:13.20,0:15:14.04,Main,Pappag,0,0,0,,Ancak...
Dialogue: 0,0:15:14.32,0:15:18.84,Main,Pappag,0,0,0,,...o en iyi yaratıklardan daha da\Niyisi deniz kızlarıdır!
Dialogue: 0,0:15:20.70,0:15:22.76,Main,Pappag,0,0,0,,Bu büyük denizde...
Dialogue: 0,0:15:22.86,0:15:25.82,Main,Pappag,0,0,0,,...suyun altında bir deniz kızını\Ngeçebilecek kimse yoktur!
Dialogue: 0,0:15:30.94,0:15:32.02,Main,Camie,0,0,0,,Sorun yok.
Dialogue: 0,0:15:32.50,0:15:34.60,Main,Camie,0,0,0,,Seni hemen kurtaracağım, Sanji-chin!
Dialogue: 0,0:15:37.54,0:15:39.40,Main,Luffy,0,0,0,,Gerçekten o kadar inanılmaz mı?
Dialogue: 0,0:15:39.60,0:15:44.54,Main,Pappag,0,0,0,,Aslında dalıp gitme huyu olmasaydı\Nbu zamana kadar hiç yakalanmazdı!
Dialogue: 0,0:15:45.02,0:15:45.72,Main,Luffy,0,0,0,,Anlıyorum.
Dialogue: 0,0:15:46.56,0:15:47.46,Main,Luffy,0,0,0,,Camie!
Dialogue: 0,0:15:47.64,0:15:49.72,Main,Luffy,0,0,0,,Sanji'yle ilgilen!
Dialogue: 0,0:15:56.28,0:15:57.48,Main,Nami,0,0,0,,O da ne?!
Dialogue: 0,0:15:57.68,0:15:59.24,Main,Franky,0,0,0,,Koca bir çapa?
Dialogue: 0,0:15:59.38,0:16:00.32,Main,Franky,0,0,0,,Çok büyük!
Dialogue: 0,0:16:02.58,0:16:04.84,Main,Rider,0,0,0,,Hasır Şapka tayfasının gemisini nişan alın.
Dialogue: 0,0:16:05.28,0:16:07.18,Main,Rider,0,0,0,,Tam tepesinden vurun ve batırın!
Dialogue: 0,0:16:07.88,0:16:11.10,Main,Rider,0,0,0,,Bazıları Şeytan Meyvesi kullanıcısı!\NOnları suya atarsak bizimdirler!
Dialogue: 0,0:16:11.32,0:16:13.72,Main,Franky,0,0,0,,Durum kötü! Ondan bir\Ndarbe yersek, batarız!
Dialogue: 0,0:16:13.90,0:16:16.72,Main,Usopp,0,0,0,,Atlat! Patlama veya Çark kullan!\NBaşarabilir miyiz?
Dialogue: 0,0:16:17.54,0:16:18.56,Main,Franky,0,0,0,,Hayır, çok geç!
Dialogue: 0,0:16:18.90,0:16:20.44,Main,Franky,0,0,0,,Hemen benimle gel, Usopp!
Dialogue: 0,0:16:20.52,0:16:20.94,Main,Usopp,0,0,0,,Ha?
Dialogue: 0,0:16:21.04,0:16:22.79,Main,Usopp,0,0,0,,T-Tamam!
Dialogue: 0,0:16:23.32,0:16:25.10,Main,Franky,0,0,0,,Pruvaya çık!
Dialogue: 0,0:16:25.18,0:16:25.68,Main,Usopp,0,0,0,,Ha?
Dialogue: 0,0:16:25.82,0:16:27.26,Main,Usopp,0,0,0,,Ah, tamam!
Dialogue: 0,0:16:27.88,0:16:29.80,Main,Franky,0,0,0,,Gizli silahımızı kullanacağız!
Dialogue: 0,0:16:30.56,0:16:31.64,Main,Usopp,0,0,0,,Gizli silah?
Dialogue: 0,0:16:33.86,0:16:35.64,Main,Rider,0,0,0,,Bırakın!
Dialogue: 0,0:16:36.12,0:16:37.70,Main,Luffy,0,0,0,,Sunny'nin başı dertte!
Dialogue: 0,0:16:37.98,0:16:39.82,Main,Brook,0,0,0,,Bu çok tehlikeli!
Dialogue: 0,0:16:41.62,0:16:44.04,Main,Franky,0,0,0,,Bu gemiye inanın!
Dialogue: 0,0:16:46.58,0:16:48.24,Main,Usopp,0,0,0,,Yele dönmeye başladı!
Dialogue: 0,0:16:48.74,0:16:50.48,Main,Duval,0,0,0,,Batın!
Dialogue: 0,0:16:50.66,0:16:52.68,Main,Usopp,0,0,0,,Tam üstümüze düşüyor!
Dialogue: 0,0:16:53.18,0:16:54.18,Main,Franky,0,0,0,,{\fad(150,150)}Acil Durum Kurtuluşu!
Dialogue: 0,0:16:54.52,0:16:55.50,Main,Franky,0,0,0,,{\fad(150,150)}Gizli Silah!
Dialogue: 0,0:16:55.50,0:16:56.83,Main,Franky,0,0,0,,{\fad(150,150)}Piliç Yolculuğu!
Dialogue: 0,0:17:04.48,0:17:06.46,Main,Riders,0,0,0,,Atlattılar!
Dialogue: 0,0:17:05.28,0:17:06.18,Secondary,Rider,0,0,0,,Olamaz!
Dialogue: 0,0:17:06.54,0:17:09.26,Main,Rider,0,0,0,,Hiç geri giden bir gemi duymamıştım!
Dialogue: 0,0:17:09.34,0:17:10.04,Main,Franky,0,0,0,,Usopp!
Dialogue: 0,0:17:10.14,0:17:11.12,Main,Franky,0,0,0,,Pruvanın içine gir!
Dialogue: 0,0:17:11.90,0:17:12.76,Main,Franky,0,0,0,,Pruvanın mı?
Dialogue: 0,0:17:13.52,0:17:15.08,Main,Franky,0,0,0,,Oh! Girilebiliyor!
Dialogue: 0,0:17:15.44,0:17:17.60,Main,Franky,0,0,0,,Tüm yapabileceğimizin\Natlatmak olduğunu sanmayın!
Dialogue: 0,0:17:17.84,0:17:21.36,Main,Franky,0,0,0,,Bu geminin çok daha fazla gücü var!
Dialogue: 0,0:17:24.14,0:17:26.10,Main,Chopper & Luffy,0,0,0,,Müthiş!
Dialogue: 0,0:17:29.38,0:17:31.36,Main,Duval,0,0,0,,Bu kez ne olacak?!
Dialogue: 0,0:17:34.52,0:17:35.86,Main,Usopp,0,0,0,,Şarj tamamlandı!
Dialogue: 0,0:17:36.16,0:17:36.76,Main,Usopp,0,0,0,,Hey!
Dialogue: 0,0:17:36.88,0:17:38.22,Main,Usopp,0,0,0,,Şimdi ne yapacağım?
Dialogue: 0,0:17:38.50,0:17:40.30,Main,Franky,0,0,0,,Dairenin içine alabildiğin kadarını al!
Dialogue: 0,0:17:40.82,0:17:41.64,Main,Usopp,0,0,0,,Daire?
Dialogue: 0,0:17:43.14,0:17:44.02,Main,Usopp,0,0,0,,Bu şekilde mi?
Dialogue: 0,0:17:47.10,0:17:47.88,Main,Usopp,0,0,0,,Girdiler!
Dialogue: 0,0:17:48.66,0:17:51.66,Main,Franky,0,0,0,,Kabzadaki düğmeyle kilitlen\Nve manivelayı çek!
Dialogue: 0,0:17:52.28,0:17:53.34,Main,Franky,0,0,0,,Bu ve...
Dialogue: 0,0:17:53.46,0:17:54.22,Main,Franky,0,0,0,,...bu!
Dialogue: 0,0:17:59.42,0:18:00.26,Main,Rider,0,0,0,,O da ne?
Dialogue: 0,0:18:01.10,0:18:02.96,Main,Franky,0,0,0,,{\fad(150,150)}Aslan Kükremesi Topu!
Dialogue: 0,0:18:04.10,0:18:05.12,Main,Franky & Usopp,0,0,0,,Ateş!
Dialogue: 0,0:18:17.08,0:18:18.22,Main,Nami,0,0,0,,Müthiş!
Dialogue: 0,0:18:45.44,0:18:46.96,Main,Zoro,0,0,0,,Çok etkilenmişsin!
Dialogue: 0,0:18:54.32,0:18:55.14,Main,Franky,0,0,0,,Bunu gördünüz mü?!
Dialogue: 0,0:18:55.22,0:18:56.74,Main,Franky,0,0,0,,Sunny'nin tam gücünü?
Dialogue: 0,0:18:56.98,0:18:59.54,Main,Chopper,0,0,0,,O saldırı neredeyse tüm\NUçan Balıkları hakladı.
Dialogue: 0,0:18:59.66,0:19:01.36,Main,Franky,0,0,0,,Usopp bu kadar iyi olduğu için!
Dialogue: 0,0:19:01.54,0:19:03.44,Main,Franky,0,0,0,,İlk denemesi olsa da harikaydı!
Dialogue: 0,0:19:03.92,0:19:06.72,Main,Usopp,0,0,0,,Vay!!! Ne müthiş bir yok edici güç!
Dialogue: 0,0:19:07.00,0:19:08.18,Main,Luffy,0,0,0,,Sunny!
Dialogue: 0,0:19:08.48,0:19:12.18,Main,Brook,0,0,0,,Aslan-chan inanılmaz! Neredeyse\Ngözlerim yerinden fırlayacaktı!
Dialogue: 0,0:19:13.74,0:19:15.30,Main,Brook,0,0,0,,Gerçi fırlayacak gözlerim yok.
Dialogue: 0,0:19:18.80,0:19:22.80,Main,Franky,0,0,0,,Geminin fırlayıp gitmesini\Nengellemek için üç fıçı kola kullanıyor...
Dialogue: 0,0:19:23.00,0:19:26.64,Main,Franky,0,0,0,,...ve aynı anda toptan iki fıçılık\NPatlama Vuruşu yapıyor.
Dialogue: 0,0:19:27.00,0:19:30.84,Main,Franky,0,0,0,,Çok fazla kola kullanıyor,\Nbu yüzden aşırı kullanmayın!
Dialogue: 0,0:19:33.36,0:19:34.88,Main,Rider,0,0,0,,Bizi ağla bağladı!
Dialogue: 0,0:19:35.00,0:19:35.58,Main,Rider,0,0,0,,Kahretsin!
Dialogue: 0,0:19:35.80,0:19:37.28,Main,Rider,0,0,0,,Hızlı deniz kızı!
Dialogue: 0,0:19:37.58,0:19:39.26,Main,Camie,0,0,0,,Neredeyse vardık, Sanji-chin.
Dialogue: 0,0:19:39.64,0:19:40.52,Main,Camie,0,0,0,,Dayan!
Dialogue: 0,0:19:45.90,0:19:46.70,Main,Nami,0,0,0,,Camie!
Dialogue: 0,0:19:47.34,0:19:48.24,Main,Chopper,0,0,0,,Hele şükür!
Dialogue: 0,0:19:48.42,0:19:49.62,Main,Chopper,0,0,0,,Sanji iyi mi?
Dialogue: 0,0:19:51.12,0:19:52.56,Main,Camie,0,0,0,,Arkadaşlar, durum vahim!
Dialogue: 0,0:19:52.72,0:19:54.66,Main,Camie,0,0,0,,Sanji-chin çok fazla kan kaybediyor!
Dialogue: 0,0:19:54.74,0:19:55.16,Main,Nami,0,0,0,,He?
Dialogue: 0,0:19:55.40,0:19:56.48,Main,Chopper,0,0,0,,İşi bitti mi yoksa?!
Dialogue: 0,0:19:56.88,0:20:00.28,Main,Camie,0,0,0,,Tam onu kurtardığımı düşünürken aniden\Nburnundan oluk oluk kan akmaya başladı!
Dialogue: 0,0:20:01.54,0:20:02.34,Main,Chopper,0,0,0,,Burun kanaması mı?
Dialogue: 0,0:20:04.62,0:20:06.16,Main,Usopp,0,0,0,,Sorun yok.
Dialogue: 0,0:20:06.44,0:20:08.04,Main,Usopp,0,0,0,,Böyle ölecekse bırakın ölsun.
Dialogue: 0,0:20:08.44,0:20:09.26,Main,Nami,0,0,0,,Evet.
Dialogue: 0,0:20:09.38,0:20:10.62,Main,Nami,0,0,0,,En azından mutlu görünüyor.
Dialogue: 0,0:20:10.80,0:20:12.48,Main,Camie,0,0,0,,Dayan, Sanji-chin!
Dialogue: 0,0:20:12.68,0:20:13.38,Main,Sanji,0,0,0,,Burası...
Dialogue: 0,0:20:13.82,0:20:14.88,Main,Sanji,0,0,0,,...Cennet mi?
Dialogue: 0,0:20:15.04,0:20:16.10,Main,Duval,0,0,0,,Kahretsin!
Dialogue: 0,0:20:16.46,0:20:18.98,Main,Duval,0,0,0,,Hayatta mı bu herif?!
Dialogue: 0,0:20:19.20,0:20:21.68,Main,Luffy,0,0,0,,Artık adamların işe yaramaz\Ndurumda gibi, değil mi?
Dialogue: 0,0:20:22.50,0:20:24.48,Main,Duval,0,0,0,,Pislik!
Dialogue: 0,0:20:25.06,0:20:27.84,Main,Duval,0,0,0,,O zaman sanırım Motobaro'nun\Nne kadar korkunç olduğunu öğrenmelisin!
Dialogue: 0,0:20:28.22,0:20:33.14,Main,Duval,0,0,0,,Bugüne dek onun dev boynuzlarıyla\Ndelik deşik olanların sayısını unuttum!
Dialogue: 0,0:20:33.68,0:20:36.44,Main,Duval,0,0,0,,Boynuzlarının, köylerin su bentlerini\Nbile yıkmayı başardığını söylüyorlar.
Dialogue: 0,0:20:36.56,0:20:38.76,Main,Duval,0,0,0,,Onu kafese koyduğunuzda kırıp çıkar!
Dialogue: 0,0:20:38.90,0:20:42.50,Main,Duval,0,0,0,,Bunca zamandır Denizciler'den\Nkaçabilmemin tek sebebi...
Dialogue: 0,0:20:42.70,0:20:45.26,Main,Duval,0,0,0,,...bunun boynuzlarıdır!
Dialogue: 0,0:20:45.54,0:20:48.66,Main,Duval,0,0,0,,Onlara "Kalp Parçalayıcı Boynuz" derler!
Dialogue: 0,0:20:49.58,0:20:50.48,Main,Luffy,0,0,0,,Tamam!
Dialogue: 0,0:20:50.62,0:20:51.56,Main,Luffy,0,0,0,,Seni durduracağım!
Dialogue: 0,0:20:53.52,0:20:55.46,Main,Duval,0,0,0,,Hadi, Motobaro!
Dialogue: 0,0:20:57.52,0:20:59.02,Main,Chopper,0,0,0,,Luffy, dikkat et!
Dialogue: 0,0:21:04.78,0:21:07.06,Main,Chopper,0,0,0,,Boynuzlar tamamen faydasızmış!
Dialogue: 0,0:21:07.62,0:21:10.00,Main,Luffy,0,0,0,,Dövüşmemizin anlamı yok!
Dialogue: 0,0:21:15.36,0:21:17.32,Main,Duval,0,0,0,,Hey, ne oldu, Motobaro?
Dialogue: 0,0:21:17.58,0:21:19.14,Main,Zoro,0,0,0,,İnek tuhaf davranıyor, değil mi?
Dialogue: 0,0:21:28.42,0:21:29.28,Main,Franky,0,0,0,,Ne?
Dialogue: 0,0:21:29.48,0:21:30.52,Main,Usopp,0,0,0,,Bayıldı mı?
Dialogue: 0,0:21:30.92,0:21:32.22,Main,Nami,0,0,0,,Ne oldu?
Dialogue: 0,0:21:32.92,0:21:33.60,Main,Nami,0,0,0,,Luffy!
Dialogue: 0,0:21:33.88,0:21:34.76,Main,Nami,0,0,0,,Ne yaptın?
Dialogue: 0,0:21:36.48,0:21:38.18,Main,Luffy,0,0,0,,Bir şey yapmadım!
Dialogue: 0,0:21:39.22,0:21:40.66,Main,Duval,0,0,0,,Motobaro!
Dialogue: 0,0:21:40.82,0:21:42.80,Main,Duval,0,0,0,,Kahretsin, bu nasıl olabilir?!
Dialogue: 0,0:21:43.24,0:21:45.22,Main,Robin,0,0,0,,Ona saldırmış gibi görünmüyor.
Dialogue: 0,0:21:45.96,0:21:50.02,Main,Robin,0,0,0,,Galiba Luffy konuşarak ineğe üstünlük sağladı.
Dialogue: 0,0:21:50.56,0:21:51.40,Main,Usopp,0,0,0,,Ne?
Dialogue: 0,0:21:51.66,0:21:53.44,Main,Usopp,0,0,0,,Yani psikolojikmen mi etkiledi?
Dialogue: 0,0:21:53.88,0:21:55.92,Main,Usopp,0,0,0,,Ama o koca şey bayıldı!
Dialogue: 0,0:21:56.14,0:21:57.72,Main,Franky,0,0,0,,Bu mümkün mü ki?
Dialogue: 0,0:21:57.88,0:22:01.42,Main,Duval,0,0,0,,Pislik! Lanet olası Hasır Şapka veledi!
Dialogue: 0,0:22:01.94,0:22:04.24,Main,Sanji,0,0,0,,Hey, dur biraz, Luffy!
Dialogue: 0,0:22:07.66,0:22:08.40,Main,Luffy,0,0,0,,Sanji!
Dialogue: 0,0:22:08.90,0:22:10.04,Main,Luffy,0,0,0,,İyi olmana sevindim!
Dialogue: 0,0:22:10.36,0:22:15.76,Main,Sanji,0,0,0,,Bana karşı anlamsız suçlamalarla dolu\Nbu aptal olaya son vereceğim.
Dialogue: 0,0:22:16.16,0:22:17.26,Main,Duval,0,0,0,,Son mu vereceksin?
Dialogue: 0,0:22:18.04,0:22:19.00,Main,Duval,0,0,0,,Kara Bacak?
Dialogue: 0,0:22:19.26,0:22:24.74,Main,Duval,0,0,0,,Korsan olarak yaşamaya devam ettiğin sürece\Nasla huzur bulmayacağım!
Dialogue: 0,0:22:25.04,0:22:27.92,Main,Duval,0,0,0,,Suçlamalardan bıkan benim!
Dialogue: 0,0:22:28.43,0:22:29.38,Main,Sanji,0,0,0,,Kapa çeneni!
Dialogue: 0,0:22:30.60,0:22:34.20,Main,Sanji,0,0,0,,O aptal poster suratı, senin gördüğünden\Ndaha fazla görmek istemiyorum.
Dialogue: 0,0:22:34.60,0:22:37.42,Main,Sanji,0,0,0,,Gerçek hayatta var olmamalıydı bile!
Dialogue: 0,0:22:38.02,0:22:39.24,Main,,0,0,0,,O zaman...
Dialogue: 0,0:22:39.86,0:22:41.38,Main,,0,0,0,,...ölmelisin!
Dialogue: 0,0:22:43.43,0:22:44.00,Main,,0,0,0,,{\fad(150,150)}Göz!
Dialogue: 0,0:22:45.01,0:22:45.68,Main,,0,0,0,,{\fad(150,150)}Burun!
Dialogue: 0,0:22:46.36,0:22:46.84,Main,,0,0,0,,{\fad(150,150)}Yanak!
Dialogue: 0,0:22:47.17,0:22:47.72,Main,,0,0,0,,{\fad(150,150)}Ağız!
Dialogue: 0,0:22:47.95,0:22:48.49,Main,,0,0,0,,{\fad(150,150)}Diş!
Dialogue: 0,0:22:48.89,0:22:49.65,Main,,0,0,0,,{\fad(150,150)}Çene!
Dialogue: 0,0:22:55.26,0:22:56.44,Main,,0,0,0,,Lütfen kes şunu.
Dialogue: 0,0:22:56.44,0:23:00.32,Main,,0,0,0,,{\fad(150,150)}Şık Vuruş!
Dialogue: 0,0:23:18.60,0:23:23.68,Main,,0,0,0,,Bitirici saldırımın mükemmelliğini\Ntat ve sefaletine son ver.
Dialogue: 0,0:23:24.28,0:23:25.56,Main,,0,0,0,,Kahrolası pislik.
