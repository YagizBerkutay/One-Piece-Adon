000000,0,0,0,0,100,100,0,0,1,1.9,1.9,2,180,180,27,1Style: Kanji-furigana,Duality,36,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,2.95,0,8,23,23,146,1Style: Karaoke-furigana,Duality,36,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,2.95,0,8,23,23,23,1Style: Lyrics-furigana,Duality,36,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,2.95,0,2,23,23,34,1Style: Lyrics,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,2,23,23,34,1Style: Karaoke,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,23,1Style: Kanji,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,146,1Style: Roger-Monologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1Style: Romaji ED,Josefin Sans,82,&H00FFFFFF,&H003592BE,&H00000000,&H64000000,0,0,0,0,100,100,0,0,1,0,4,8,10,10,20,1Style: Translation ED,Josefin Sans,82,&H00FFFFFF,&H000000FF,&H00FFFFFF,&H64000000,0,0,0,0,100,100,0,0,1,0,4,2,10,10,20,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Your media player does not support the subtitle format used in this episode. Subtitles will likely not function properly. Please use one of the recommended video players, preferably mpv: https://mpv.ioDialogue: 0,0:01:59.99,0:02:09.98,Warning,,0,0,0,,Your media player does not support the subtitle format used in this episode. Subtitles will likely not function properly. Please use one of the recommended video players, preferably mpv: https://mpv.ioDialogue: 50,0:01:51.47,0:01:53.59,Main-207-,,0,0,0,,Açlıktan ölüyorum...Dialogue: 50,0:01:53.59,0:01:56.22,Main-207-,,0,0,0,,Karaya ne zaman ulaşacağız?Dialogue: 50,0:01:56.22,0:01:57.10,Main-207-,,0,0,0,,Kim bilir?Dialogue: 50,0:01:57.72,0:02:00.73,Main-207-,,0,0,0,,Rüzgar ve dalgalar bizi nereye götürüyorsa oraya gidiyoruz.Dialogue: 50,0:02:01.77,0:02:06.98,Main-207-,,0,0,0,,Geleceğin Korsanlar Kralı'nın rota bilmemesi garip değil mi?!Dialogue: 50,0:02:06.98,0:02:09.98,Main-207-,,0,0,0,,Garip değil. Öyle sürüklendim sadece.Dialogue: 50,0:02:09.98,0:02:14.11,Main-207-,,0,0,0,,Peki ya sen? Ödül avcıları denizlerde dolaşmıyor mu?Dialogue: 50,0:02:14.11,0:02:17.99,Main-207-,,0,0,0,,Kendime hiç ödül avcısı dediğimi hatırlamıyorum.Dialogue: 50,0:02:19.24,0:02:22.33,Main-207-,,0,0,0,,Bir adamı aramak için denize açıldım...Dialogue: 50,0:02:22.33,0:02:24.54,Main-207-,,0,0,0,,...ama köyümü bir daha bulamadım.Dialogue: 50,0:02:25.17,0:02:28.80,Main-207-,,0,0,0,,Sonunda geçinmek için korsan gemilerini kovalamaya başladım.Dialogue: 50,0:02:28.80,0:02:30.46,Main-207-,,0,0,0,,Ah, demek kayboldun.Dialogue: 50,0:02:30.46,0:02:32.84,Main-207-,,0,0,0,,Öyle söyleme!Dialogue: 50,0:02:40.35,0:02:42.02,Main-207-,,0,0,0,,Yine iyi vurgun yaptık!Dialogue: 50,0:02:42.02,0:02:44.94,Main-207-,,0,0,0,,Kaptan Buggy bunları görünce hiç kızmayacak!Dialogue: 50,0:02:44.94,0:02:46.27,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:02:46.27,0:02:47.81,Main-207-,,0,0,0,,Hey, şuna bakın.Dialogue: 50,0:02:47.81,0:02:49.02,Main-207-,,0,0,0,,– Hm? – Ha?Dialogue: 50,0:02:51.98,0:02:53.82,Main-207-,,0,0,0,,O kayık ne öyle?Dialogue: 50,0:03:07.04,0:03:08.67,Main-207-,,0,0,0,,B-Bu bir kız!Dialogue: 50,0:03:09.67,0:03:11.50,Main-207-,,0,0,0,,Hey! Ne oldu sana?Dialogue: 50,0:03:13.51,0:03:17.14,Main-207-,,0,0,0,,Oh! Rüya mı görüyorum?Dialogue: 50,0:03:17.14,0:03:20.22,Main-207-,,0,0,0,,Bu uçsuz bucaksız denizde birine rastlamak...Dialogue: 50,0:03:20.22,0:03:23.10,Main-207-,,0,0,0,,K-Kimsiniz bilmiyorum ama, su...Dialogue: 50,0:03:23.10,0:03:25.44,Main-207-,,0,0,0,,Bana biraz su verebilir misiniz?Dialogue: 50,0:03:25.69,0:03:27.90,Main-207-,,0,0,0,,Size istediğiniz kadar para verebilirim.Dialogue: 50,0:03:28.35,0:03:30.02,Main-207-,,0,0,0,,Lütfen, kurtarın beni!Dialogue: 50,0:03:30.65,0:03:32.86,Main-207-,,0,0,0,,Pekala! Seni kurtaracağız!Dialogue: 50,0:03:33.19,0:03:36.28,Main-207-,,0,0,0,,Ama ilk önce hazineyi görmemiz lazım.Dialogue: 50,0:03:36.28,0:03:37.74,Main-207-,,0,0,0,,İzninizle.Dialogue: 50,0:03:41.83,0:03:44.70,Main-207-,,0,0,0,,Açamıyorum... Böyle yapsak?Dialogue: 50,0:03:50.17,0:03:53.63,Main-207-,,0,0,0,,İsterseniz bütün kayığı alabilirsiniz!Dialogue: 50,0:03:54.30,0:03:56.01,Main-207-,,0,0,0,,Teknemiz!Dialogue: 50,0:03:56.01,0:03:58.18,Main-207-,,0,0,0,,Bizi kandırdın!Dialogue: 50,0:03:58.93,0:04:02.97,Main-207-,,0,0,0,,Güneyde alçak bulutların eşlik ettiği soğuk hava kütlesi var!Dialogue: 50,0:04:02.97,0:04:06.23,Main-207-,,0,0,0,,Çok yakında şiddetli rüzgar ve fırtına bekleniyor!Dialogue: 50,0:04:06.23,0:04:08.94,Main-207-,,0,0,0,,Küçük tekneler alabora olmamak için dikkat etmeli!Dialogue: 50,0:04:20.99,0:04:22.28,Main-207-,,0,0,0,,Bingo!Dialogue: 50,0:04:23.41,0:04:24.24,Main-207-,,0,0,0,,Görüşürüz!Dialogue: 50,0:04:24.70,0:04:26.70,Main-207-,,0,0,0,,Hazinenizi alıp gidiyorum!Dialogue: 50,0:04:27.29,0:04:29.21,Main-207-,,0,0,0,,Bekle! Seni sürtük!Dialogue: 50,0:04:29.21,0:04:31.63,Main-207-,,0,0,0,,Bunu unutmayacağız...Dialogue: 50,0:04:32.04,0:04:34.88,Main-207-,,0,0,0,,Öff, çok acıktım.Dialogue: 50,0:04:37.80,0:04:39.09,Main-207-,,0,0,0,,Bir kuş, demek...Dialogue: 50,0:04:39.76,0:04:41.39,Main-207-,,0,0,0,,Hadi o kuşu yiyelim!Dialogue: 50,0:04:41.39,0:04:43.30,Main-207-,,0,0,0,,Haa? Nasıl?Dialogue: 50,0:04:43.30,0:04:45.14,Main-207-,,0,0,0,,Bana bırak!Dialogue: 50,0:04:45.14,0:04:47.60,Main-207-,,0,0,0,,Lastik-Lastik...Dialogue: 50,0:04:47.60,0:04:49.06,Main-207-,,0,0,0,,Roket!Dialogue: 50,0:04:50.27,0:04:51.73,Main-207-,,0,0,0,,Anlıyorum...Dialogue: 50,0:04:59.95,0:05:01.36,Main-207-,,0,0,0,,Yardım et!Dialogue: 50,0:05:01.36,0:05:03.95,Main-207-,,0,0,0,,Beyinsiz! Ne yapıyorsun?!Dialogue: 50,0:05:09.08,0:05:11.58,Main-207-,,0,0,0,,Hey! Dur!Dialogue: 50,0:05:11.58,0:05:13.46,Main-207-,,0,0,0,,Kayıktaki! Dur!Dialogue: 50,0:05:13.46,0:05:15.92,Main-207-,,0,0,0,,Böyle bir zamanda, kazazedeler mi?!Dialogue: 50,0:05:16.21,0:05:18.26,Main-207-,,0,0,0,,Duramam! Atlayın!Dialogue: 50,0:05:19.22,0:05:20.68,Main-207-,,0,0,0,,– Ne?! – Ne?!Dialogue: 50,0:05:23.97,0:05:25.39,Main-207-,,0,0,0,,Aferin, başardınız!Dialogue: 50,0:05:25.39,0:05:26.76,Main-207-,,0,0,0,,Bizi öldürmeye mi çalışıyorsun?!Dialogue: 50,0:05:27.27,0:05:29.27,Main-207-,,0,0,0,,Hey! Durdur kayığı!Dialogue: 50,0:05:29.27,0:05:33.02,Main-207-,,0,0,0,,Biz Palyaço Buggy-sama tayfasının üyeleriyiz.Dialogue: 50,0:05:33.02,0:05:34.61,Main-207-,,0,0,0,,Bu kayık artık bizim.Dialogue: 50,0:05:35.15,0:05:36.15,Main-207-,,0,0,0,,Ha?!Dialogue: 50,0:05:38.94,0:05:43.03,Main-207-,,0,0,0,,Sizin ünlü korsan avcısı Zoro-san olduğunuzu hiç bilmiyorduk!Dialogue: 50,0:05:43.03,0:05:45.32,Main-207-,,0,0,0,,– Kabalığımızı mazur görün! – Kabalığımızı mazur görün!Dialogue: 50,0:05:45.32,0:05:48.45,Main-207-,,0,0,0,,Sizin yüzünüzden arkadaşımı gözden kaybettim.Dialogue: 50,0:05:48.45,0:05:50.16,Main-207-,,0,0,0,,Kürek çekmeye devam edin!Dialogue: 50,0:05:50.16,0:05:51.21,Main-207-,,0,0,0,,– Başüstüne! – Başüstüne!Dialogue: 50,0:05:51.21,0:05:55.59,Main-207-,,0,0,0,,Luffy'yi tanıyorsam karayı görünce bir şekilde kurtulur.Dialogue: 50,0:05:56.67,0:05:58.75,Main-207-,,0,0,0,,Bir düşünelim...Dialogue: 50,0:05:58.75,0:06:00.46,Main-207-,,0,0,0,,Şimdi ne yapacağız, kardeşim?Dialogue: 50,0:06:00.46,0:06:01.72,Main-207-,,0,0,0,,Güzel soru...Dialogue: 50,0:06:01.72,0:06:06.89,Main-207-,,0,0,0,,Eğer Kaptan Buggy bir kızın teknemizi ve hazinemizi çaldığını öğrenirse...Dialogue: 50,0:06:06.89,0:06:07.72,Main-207-,,0,0,0,,E-Evet...Dialogue: 50,0:06:07.72,0:06:09.93,Main-207-,,0,0,0,,Hm? Kim bu Buggy?Dialogue: 50,0:06:09.93,0:06:12.98,Main-207-,,0,0,0,,Ha?! Palyaço Buggy'i hiç duymadınız mı?!Dialogue: 50,0:06:12.98,0:06:14.60,Main-207-,,0,0,0,,Hiç duymadım.Dialogue: 50,0:06:14.85,0:06:17.61,Main-207-,,0,0,0,,Bizim korsan gemimizin kaptanıdır!Dialogue: 50,0:06:17.61,0:06:24.36,Main-207-,,0,0,0,,Korkutucu olması yetmezmiş gibi, bir de Şeytan Meyvesi yedi!Dialogue: 50,0:06:41.92,0:06:44.38,Main-207-,,0,0,0,,Evet! Sonunda başardım!Dialogue: 50,0:06:45.89,0:06:47.22,Main-207-,,0,0,0,,Geri dön, orospu!Dialogue: 50,0:06:47.22,0:06:48.64,Main-207-,,0,0,0,,Hey, kız! O bizim haritamız!Dialogue: 50,0:06:49.10,0:06:53.14,Main-207-,,0,0,0,,O Grand Line haritasını daha yeni çaldık!Dialogue: 50,0:06:53.14,0:06:56.48,Main-207-,,0,0,0,,Kahretsin! Onu hemen geri almazsak, biz de ölürüz!Dialogue: 50,0:06:56.48,0:06:59.11,Main-207-,,0,0,0,,Kaptanın top mermisi hedefi olmak istemem!Dialogue: 50,0:07:03.82,0:07:05.24,Main-207-,,0,0,0,,Kaptan Buggy!Dialogue: 50,0:07:05.24,0:07:07.45,Main-207-,,0,0,0,,İskele tarafında, gökyüzünde bir şey görüyorumDialogue: 50,0:07:08.24,0:07:09.62,Main-207-,,0,0,0,,Düşürün!Dialogue: 50,0:07:16.12,0:07:17.25,Main-207-,,0,0,0,,N-Ne olu...?Dialogue: 50,0:07:27.47,0:07:29.05,Main-207-,,0,0,0,,N-Ne?!Dialogue: 50,0:07:29.05,0:07:30.81,Main-207-,,0,0,0,,O neydi?!Dialogue: 50,0:07:30.81,0:07:32.52,Main-207-,,0,0,0,,Gökyüzünden biri düştü!Dialogue: 50,0:07:32.89,0:07:36.73,Main-207-,,0,0,0,,Kahretsin! Neden bana top mermisi attılar?!Dialogue: 50,0:07:41.86,0:07:43.44,Main-207-,,0,0,0,,Neyse ki şimdi özgürüm!Dialogue: 50,0:07:43.44,0:07:46.70,Main-207-,,0,0,0,,Oldukça ilginç bir deneyim yaşadım.Dialogue: 50,0:07:50.41,0:07:52.03,Main-207-,,0,0,0,,Ah... Açlıktan ölüyorum...Dialogue: 50,0:07:52.03,0:07:53.29,Main-207-,,0,0,0,,P-Patron!Dialogue: 50,0:07:53.29,0:07:55.04,Main-207-,,0,0,0,,Beni kurtarmaya geldin!Dialogue: 50,0:07:55.04,0:07:55.62,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:07:57.00,0:07:57.83,Main-207-,,0,0,0,,Sen kimsin?Dialogue: 50,0:08:00.21,0:08:03.05,Main-207-,,0,0,0,,Afedersin, gerisini sana bırakıyorum!Dialogue: 50,0:08:05.55,0:08:06.88,Main-207-,,0,0,0,,Hey, kız topukladı!Dialogue: 50,0:08:06.88,0:08:09.55,Main-207-,,0,0,0,,Sorun değil, patronu hala burada.Dialogue: 50,0:08:09.55,0:08:11.10,Main-207-,,0,0,0,,Anladım!Dialogue: 50,0:08:11.10,0:08:13.47,Main-207-,,0,0,0,,Tayfanı korumaya çalışıyorsun, ha?!Dialogue: 50,0:08:13.47,0:08:16.10,Main-207-,,0,0,0,,Burada yiyebileceğim bir yer var mı?Dialogue: 50,0:08:16.10,0:08:18.10,Main-207-,,0,0,0,,Bizimle dalga geçme, çocuk!Dialogue: 50,0:08:27.86,0:08:30.03,Main-207-,,0,0,0,,Hazineme dokunma!Dialogue: 50,0:08:30.03,0:08:31.78,Main-207-,,0,0,0,,– Seni piç! – Seni piç!Dialogue: 50,0:08:31.78,0:08:33.91,Main-207-,,0,0,0,,Acaba o çocuğu öldürdüler mi?Dialogue: 50,0:08:34.87,0:08:37.25,Main-207-,,0,0,0,,Lastik-Lastik Tabanca!Dialogue: 50,0:08:43.75,0:08:45.71,Main-207-,,0,0,0,,İnanılmaz!Dialogue: 50,0:08:45.71,0:08:47.38,Main-207-,,0,0,0,,Bayağı güçlüsün demek!Dialogue: 50,0:08:50.30,0:08:53.22,Main-207-,,0,0,0,,Kılıçlı adamları çıplak ellerinle yendin!Dialogue: 50,0:08:53.22,0:08:56.27,Main-207-,,0,0,0,,Ha! sen şu... kimsin sen?Dialogue: 50,0:08:56.81,0:08:59.39,Main-207-,,0,0,0,,Ben korsanlardan çalan bir hırsızım!Dialogue: 50,0:08:59.39,0:09:00.52,Main-207-,,0,0,0,,Adım Nami.Dialogue: 50,0:09:00.52,0:09:02.44,Main-207-,,0,0,0,,Hey, bana katılsana?!Dialogue: 50,0:09:02.90,0:09:05.90,Main-207-,,0,0,0,,Hayır. İçimden sana katılmak gelmiyor.Dialogue: 50,0:09:06.28,0:09:08.61,Main-207-,,0,0,0,,B-B-Bekle!Dialogue: 50,0:09:09.74,0:09:11.36,Main-207-,,0,0,0,,Bekle, dedim!Dialogue: 50,0:09:13.78,0:09:16.84,Main-207-,,0,0,0,,Hâlâ hırsızı yakalamadılar mı?!Dialogue: 50,0:09:17.87,0:09:23.17,Main-207-,,0,0,0,,Yeni geldim ama şuan onun peşindeler, Kaptan Buggy! Evet!Dialogue: 50,0:09:23.96,0:09:28.96,Main-207-,,0,0,11,,Harita nasıl bu kadar kolay çalındı?! Ha?!Dialogue: 50,0:09:30.42,0:09:35.47,Main-207-,,0,0,0,,Tam da Grand Line'a girip ortalığı dağıtacakken!Dialogue: 50,0:09:35.47,0:09:40.23,Main-207-,,0,0,0,,Ş-Şey, Kaptan... Biri kulübeyi şaka gibi açık bırakmış...Dialogue: 50,0:09:41.02,0:09:42.02,Main-207-,,0,0,0,,Ne dedin sen?!Dialogue: 50,0:09:42.02,0:09:44.65,Main-207-,,0,0,0,,B-Biri kulübeyi şaka gibi açık bırakmış diyorum!Dialogue: 50,0:09:44.94,0:09:47.21,Main-207-,,0,0,0,,Kimmiş şakacı, ha?!Dialogue: 50,0:09:49.11,0:09:51.86,Main-207-,,0,0,0,,Bu burnu şaka gibi mi buluyorsun?!Dialogue: 50,0:09:51.86,0:09:53.74,Main-207-,,0,0,0,,Sahte burun gibi mi?!Dialogue: 50,0:09:53.74,0:09:55.83,Main-207-,,0,0,0,,Y-Yanlış anladınız!Dialogue: 50,0:09:55.83,0:09:58.29,Main-207-,,0,0,0,,Çok büyük ve kırmızı mı?!Dialogue: 50,0:10:00.16,0:10:02.12,Main-207-,,0,0,0,,Y-Yardım edin!Dialogue: 50,0:10:08.25,0:10:09.63,Main-207-,,0,0,0,,İ-İşte geliyor...Dialogue: 50,0:10:09.63,0:10:11.88,Main-207-,,0,0,0,,Şeytan meyvesinin gücü...Dialogue: 50,0:10:18.26,0:10:19.81,Main-207-,,0,0,0,,Ben kimim?!Dialogue: 50,0:10:20.81,0:10:23.19,Main-207-,,0,0,0,,K-Kaptan Buggy.Dialogue: 50,0:10:28.65,0:10:30.65,Main-207-,,0,0,0,,Karşı gelenlere ne olur?Dialogue: 50,0:10:30.65,0:10:33.61,Main-207-,,0,0,0,,Onu gösterişli bir ölüm bekler.Dialogue: 50,0:10:33.61,0:10:35.57,Main-207-,,0,0,0,,Lütfen, beni affedin!Dialogue: 50,0:10:35.57,0:10:38.49,Main-207-,,0,0,0,,Bir daha asla böyle bir şey söylemeyeceğim.Dialogue: 50,0:10:38.49,0:10:41.08,Main-207-,,0,0,0,,Lütfen, beni affedin!Dialogue: 50,0:10:43.50,0:10:48.04,Main-207-,,0,0,0,,Sözlü hatanı görmezden geleceğim ve seni bu seferlik affedeceğim.Dialogue: 50,0:10:49.25,0:10:50.88,Main-207-,,0,0,0,,Şimdi haritayı geri getirin!Dialogue: 50,0:10:50.88,0:10:53.34,Main-207-,,0,0,0,,Yapamazsanız... ne olacağını biliyorsunuz.Dialogue: 50,0:10:53.34,0:10:55.68,Main-207-,,0,0,0,,– Anlaşıldı, Kaptan Buggy! – Anlaşıldı, Kaptan Buggy!Dialogue: 50,0:11:01.18,0:11:02.27,Main-207-,,0,0,0,,Nefis!Dialogue: 50,0:11:02.27,0:11:04.77,Main-207-,,0,0,0,,Bu evde tek başına mı yaşıyorsun?Dialogue: 50,0:11:05.06,0:11:07.86,Main-207-,,0,0,0,,Ben bu kasabada yaşamıyorum.Dialogue: 50,0:11:08.31,0:11:11.11,Main-207-,,0,0,0,,Buranın halkı Buggy yüzünden kaçmış.Dialogue: 50,0:11:11.82,0:11:12.74,Main-207-,,0,0,0,,Yani bir yağmacısın.Dialogue: 50,0:11:12.74,0:11:14.24,Main-207-,,0,0,0,,Çok kabasın!Dialogue: 50,0:11:14.24,0:11:17.32,Main-207-,,0,0,0,,Ben sadece korsanlardan çalan bir hırsızım!Dialogue: 50,0:11:17.32,0:11:20.12,Main-207-,,0,0,0,,Beni yağmacılarla bir tutma.Dialogue: 50,0:11:21.08,0:11:23.04,Main-207-,,0,0,0,,Ama, hırsız hırsızdır.Dialogue: 50,0:11:24.41,0:11:29.04,Main-207-,,0,0,0,,Benim hedefim 100 milyon beli toplamak, ne olursa olsun.Dialogue: 50,0:11:30.25,0:11:32.50,Main-207-,,0,0,0,,O kadar çok parayı ne yapacaksın?Dialogue: 50,0:11:32.50,0:11:33.76,Main-207-,,0,0,0,,Bu bir sır!Dialogue: 50,0:11:34.51,0:11:39.22,Main-207-,,0,0,0,,Ama Grand Line'a giden haritayla, 100 milyon gerçek olabilir!Dialogue: 50,0:11:40.35,0:11:41.47,Main-207-,,0,0,0,,Harita mı?Dialogue: 50,0:11:41.47,0:11:42.89,Main-207-,,0,0,0,,Sen rotacı mısın?!Dialogue: 50,0:11:43.56,0:11:46.52,Main-207-,,0,0,0,,Diğer rotacılardan çok daha yetenekliyimdir!Dialogue: 50,0:11:47.35,0:11:49.10,Main-207-,,0,0,0,,Anlıyorum, bu harika!Dialogue: 50,0:11:49.10,0:11:52.44,Main-207-,,0,0,0,,Niye rotacı olarak bize katılmıyorsun?!Dialogue: 50,0:11:52.44,0:11:53.44,Main-207-,,0,0,0,,Gerçekten mi?Dialogue: 50,0:11:53.44,0:11:55.90,Main-207-,,0,0,0,,Evet! Yeni korsan tayfamıza!Dialogue: 50,0:11:56.65,0:11:57.40,Main-207-,,0,0,0,,Olmaz!Dialogue: 50,0:11:59.62,0:12:01.53,Main-207-,,0,0,0,,Demek sen korsansın?Dialogue: 50,0:12:01.53,0:12:05.87,Main-207-,,0,0,0,,Evet. Bana bu hasır şapkayı veren kişiye...Dialogue: 50,0:12:05.87,0:12:08.21,Main-207-,,0,0,0,,...bir tayfa kurup korsan olacağıma yemin ettim!Dialogue: 50,0:12:09.25,0:12:12.25,Main-207-,,0,0,0,,Bu dünyada en çok nefret ettiğim kişiler korsanlardır!Dialogue: 50,0:12:12.25,0:12:13.96,Main-207-,,0,0,0,,Sadece parayı ve mandalinaları severim!Dialogue: 50,0:12:13.96,0:12:16.26,Main-207-,,0,0,0,,Hadi ama, rotacımız ol.Dialogue: 50,0:12:16.26,0:12:17.63,Main-207-,,0,0,0,,Hayır, dedim.Dialogue: 50,0:12:18.26,0:12:19.39,Main-207-,,0,0,0,,Hayır, he?Dialogue: 50,0:12:21.47,0:12:22.55,Main-207-,,0,0,0,,Hey! Buldunuz mu?!Dialogue: 50,0:12:22.55,0:12:24.52,Main-207-,,0,0,0,,Hiçbir yerde bulamıyoruz!Dialogue: 50,0:12:25.06,0:12:26.77,Main-207-,,0,0,0,,Nereye gitti, şu hırsız kız?!Dialogue: 50,0:12:26.77,0:12:29.44,Main-207-,,0,0,0,,Haritayı geri alamazsak başımız derde girecek.Dialogue: 50,0:12:30.35,0:12:33.27,Thoughts-207-,,0,0,0,,Bunlarla ilgili bir şey yapmalıyım...Dialogue: 50,0:12:34.23,0:12:38.03,Main-207-,,0,0,0,,Şey, eğer şartlarımı kabul edersen bunu düşünürüm.Dialogue: 50,0:12:38.03,0:12:40.53,Main-207-,,0,0,0,,Gerçekten mi?! Her şeyi yaparım.Dialogue: 50,0:12:40.53,0:12:44.45,Main-207-,,0,0,0,,Benimle, Buggy adlı bir korsanı görmeye gelmeni istiyorum.Dialogue: 50,0:12:44.45,0:12:45.20,Main-207-,,0,0,0,,Ama...Dialogue: 50,0:12:49.29,0:12:50.79,Main-207-,,0,0,0,,Niye beni bağladın?Dialogue: 50,0:12:50.79,0:12:52.67,Main-207-,,0,0,0,,Sadece bir ip. Sorun olur mu?Dialogue: 50,0:12:52.67,0:12:54.55,Main-207-,,0,0,0,,Sanırım olmaz!Dialogue: 50,0:12:54.55,0:12:56.76,Main-207-,,0,0,0,,Hem diğer korsanlarla tanışmayı umuyordum!Dialogue: 50,0:12:56.76,0:12:57.80,Main-207-,,0,0,0,,Gidelim!Dialogue: 50,0:12:57.80,0:13:00.13,Main-207-,,0,0,0,,Hey, beni bekle!Dialogue: 50,0:13:00.13,0:13:02.93,Main-207-,,0,0,0,,Ne dedin sen?!Dialogue: 50,0:13:02.93,0:13:04.97,Main-207-,,0,0,0,,Hırsız kaçtı mı?!Dialogue: 50,0:13:06.72,0:13:08.73,Main-207-,,0,0,0,,– Lütfen bizi bağışla, Kaptan! – Lütfen bizi bağışla, Kaptan!Dialogue: 50,0:13:08.73,0:13:13.11,Main-207-,,0,0,0,,Üçünüz de zavallısınız! Gösterişli ölün!Dialogue: 50,0:13:14.36,0:13:16.61,Main-207-,,0,0,0,,Kaptan Buggy!Dialogue: 50,0:13:16.61,0:13:17.61,Main-207-,,0,0,0,,Ne var?!Dialogue: 50,0:13:17.61,0:13:20.57,Main-207-,,0,0,0,,Şu deminki hırsız geri döndü!Dialogue: 50,0:13:20.57,0:13:21.57,Main-207-,,0,0,0,,Ne dedin?!Dialogue: 50,0:13:23.91,0:13:25.16,Main-207-,,0,0,0,,Bunlar onlar!Dialogue: 50,0:13:25.16,0:13:27.87,Main-207-,,0,0,0,,Haritayı çalan o kız.Dialogue: 50,0:13:32.37,0:13:36.00,Main-207-,,0,0,0,,Hırsızı yakaladım, Kaptan Palyaço Buggy.Dialogue: 50,0:13:36.00,0:13:37.34,Main-207-,,0,0,0,,Haritan burada!Dialogue: 50,0:13:37.34,0:13:39.76,Main-207-,,0,0,0,,Bunun için müteşekkirim,...Dialogue: 50,0:13:39.76,0:13:42.30,Main-207-,,0,0,0,,...ama fikrini değiştiren şey nedir?Dialogue: 50,0:13:44.76,0:13:46.76,Main-207-,,0,0,0,,Patronumla kavga ettim!Dialogue: 50,0:13:46.76,0:13:48.81,Main-207-,,0,0,0,,Artık ona katlanamıyorum.Dialogue: 50,0:13:48.81,0:13:51.14,Main-207-,,0,0,0,,Tayfanıza katılmama izin verin!Dialogue: 50,0:13:58.69,0:14:00.19,Main-207-,,0,0,0,,Katlanamıyorsun, he?Dialogue: 50,0:14:00.19,0:14:01.82,Main-207-,,0,0,0,,Ne gösterişli, eğlenceli bir kız!Dialogue: 50,0:14:01.82,0:14:04.82,Main-207-,,0,0,0,,Seni sevdim! Bize katılabilirsin.Dialogue: 50,0:14:08.91,0:14:10.62,Thoughts-207-,,0,0,0,,Sızma başarılı!Dialogue: 50,0:14:10.62,0:14:13.17,Thoughts-207-,,0,0,0,,Korsanlar çok salak ve manipüle edilebilir!Dialogue: 50,0:14:16.13,0:14:17.96,Main-207-,,0,0,0,,Niye kafesteyim?Dialogue: 50,0:14:20.59,0:14:22.55,Main-207-,,0,0,0,,Bugün harika hissediyorum!Dialogue: 50,0:14:22.88,0:14:24.93,Main-207-,,0,0,0,,Kız, adın ne?Dialogue: 50,0:14:24.93,0:14:25.93,Main-207-,,0,0,0,,Nami!Dialogue: 50,0:14:25.93,0:14:27.30,Main-207-,,0,0,0,,Fantastik!Dialogue: 50,0:14:27.30,0:14:30.06,Main-207-,,0,0,0,,Hadi Nami'ye hoş geldin partisi verelim!Dialogue: 50,0:14:30.06,0:14:31.18,Main-207-,,0,0,0,,Gösterişli kutlayalım!Dialogue: 50,0:14:49.12,0:14:52.04,Main-207-,,0,0,0,,Sorun nedir?! Bu senin partin.Dialogue: 50,0:14:52.04,0:14:53.54,Main-207-,,0,0,0,,Biraz ye!Dialogue: 50,0:14:54.21,0:14:56.04,Main-207-,,0,0,0,,Tabii! Teşekkür ederim!Dialogue: 50,0:14:57.04,0:15:01.05,Thoughts-207-,,0,0,0,,Haritayı geri alma şansı için gözlerimi dört açacağım.Dialogue: 50,0:15:01.05,0:15:04.72,Thoughts-207-,,0,0,0,,Bu arada, belki Buggy'nin geriye kalan hazinesini de çalarım!Dialogue: 50,0:15:07.80,0:15:08.64,Main-207-,,0,0,0,,Kahretsin!Dialogue: 50,0:15:17.48,0:15:20.07,Main-207-,,0,0,0,,Bu gösterişli harika!Dialogue: 50,0:15:20.07,0:15:21.15,Main-207-,,0,0,0,,Beyler!Dialogue: 50,0:15:21.98,0:15:25.24,Main-207-,,0,0,0,,Bir tane Özel Buggy Topu hazırlayın!Dialogue: 50,0:15:42.63,0:15:44.73,Main-207-,,0,0,0,,Her şey hazır, efendim!Dialogue: 50,0:15:45.47,0:15:47.97,Main-207-,,0,0,0,,Ne... ne olacak?Dialogue: 50,0:15:47.97,0:15:51.10,Main-207-,,0,0,0,,Buggy topunun gücünü seyret!Dialogue: 50,0:15:51.10,0:15:51.72,Main-207-,,0,0,0,,Ateşleyin.Dialogue: 50,0:16:13.54,0:16:15.29,Main-207-,,0,0,0,,O patlama da neydi?Dialogue: 50,0:16:15.29,0:16:18.79,Main-207-,,0,0,0,,Bu, kaptanımızın çok sevdiği Buggy Toplarından biri!Dialogue: 50,0:16:19.42,0:16:21.29,Main-207-,,0,0,0,,Buggy Topları mı?!Dialogue: 50,0:16:33.10,0:16:34.22,Main-207-,,0,0,0,,Gerçekten gösterişli!Dialogue: 50,0:16:34.22,0:16:36.85,Main-207-,,0,0,0,,Buggy Topları ve  Şeytan meyvesinin gücüyle,...Dialogue: 50,0:16:36.85,0:16:39.85,Main-207-,,0,0,0,,...Grand Line'ı fethedebilirim!Dialogue: 50,0:16:39.85,0:16:41.06,Main-207-,,0,0,0,,Değil mi, Nami?!Dialogue: 50,0:16:41.06,0:16:42.94,Main-207-,,0,0,0,,E-Evet, tabii.Dialogue: 50,0:16:42.94,0:16:44.53,Main-207-,,0,0,0,,Ne dedin?!Dialogue: 50,0:16:44.53,0:16:45.28,Main-207-,,0,0,0,,Ha?!Dialogue: 50,0:16:45.28,0:16:48.24,Main-207-,,0,0,0,,Grand Line'a hakim olacak kişi benim.Dialogue: 50,0:16:49.03,0:16:50.16,Main-207-,,0,0,0,,Ne?Dialogue: 50,0:16:50.16,0:16:52.57,Main-207-,,0,0,0,,Korsanlar Kralı ben olacağım!Dialogue: 50,0:16:52.99,0:16:54.54,Main-207-,,0,0,0,,Seni aptal!Dialogue: 50,0:16:57.66,0:17:00.00,Main-207-,,0,0,0,,Şimdi ona niye katlanamadığını anlıyorum, Nami.Dialogue: 50,0:17:00.00,0:17:01.67,Main-207-,,0,0,0,,Çok haklısınız!Dialogue: 50,0:17:01.67,0:17:04.92,Main-207-,,0,0,0,,Aşırı saf ve tam bir aptal!Dialogue: 50,0:17:04.92,0:17:07.51,Main-207-,,0,0,0,,Buna daha fazla katlanamazdım.Dialogue: 50,0:17:07.51,0:17:08.59,Main-207-,,0,0,0,,Doğal olarak!Dialogue: 50,0:17:08.59,0:17:13.30,Main-207-,,0,0,0,,O zaman, bir Buggy Topu al ve eski patronunu paramparça et!Dialogue: 50,0:17:13.72,0:17:14.30,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:17:14.76,0:17:19.77,Main-207-,,0,0,0,,Ayrıca bu bana olan sadakatini göstermeni sağlayacak.Dialogue: 50,0:17:19.77,0:17:20.44,Main-207-,,0,0,0,,Yap hadi!Dialogue: 50,0:17:28.44,0:17:30.07,Main-207-,,0,0,0,,Gerek yok, böyle iyi!Dialogue: 50,0:17:30.07,0:17:34.28,Main-207-,,0,0,0,,Hoş geldin partisi veriyoruz, hadi biraz eğlenelim.Dialogue: 50,0:17:35.70,0:17:36.54,Main-207-,,0,0,0,,Yap şunu.Dialogue: 50,0:17:36.54,0:17:38.70,Main-207-,,0,0,0,,Benim parti verme şeklim böyle.Dialogue: 50,0:17:42.00,0:17:45.84,Main-207-,,0,0,0,,– Ateşle! Ateşle! Ateşle! – Ateşle! Ateşle! Ateşle!Dialogue: 50,0:17:46.92,0:17:49.59,Thoughts-207-,,0,0,0,,Eğer ateşlemezsem, beni öldürürler.Dialogue: 50,0:17:50.88,0:17:54.97,Thoughts-207-,,0,0,0,,Ama eğer ateşlersem, korsanlardan bir farkım kalmaz.Dialogue: 50,0:17:56.56,0:17:58.97,Main-207-,,0,0,0,,Hadi gösterişli ateşleyelim!Dialogue: 50,0:17:58.97,0:18:11.07,Main-207-,,0,0,0,,– Ateşle! Ateşle! Ateşle!  – Ateşle! Ateşle! Ateşle!Dialogue: 50,0:18:11.07,0:18:13.95,Main-207-,,0,0,0,,Nami, partiyi mahvetme!Dialogue: 50,0:18:16.78,0:18:17.78,Main-207-,,0,0,0,,Sorun nedir?Dialogue: 50,0:18:18.24,0:18:19.58,Main-207-,,0,0,0,,Ellerin titriyor.Dialogue: 50,0:18:21.20,0:18:25.54,Main-207-,,0,0,0,,Yarım yamalak kararlılıkla korsanlara sataşırsan, işte böyle olur.Dialogue: 50,0:18:26.34,0:18:27.79,Main-207-,,0,0,0,,Ne kararlılığı?Dialogue: 50,0:18:27.79,0:18:30.01,Main-207-,,0,0,0,,İstediği gibi insanları öldürmek mi?Dialogue: 50,0:18:30.01,0:18:31.84,Main-207-,,0,0,0,,Korsanların kararlılığı bu mudur?!Dialogue: 50,0:18:31.84,0:18:32.72,Main-207-,,0,0,0,,Hayır!Dialogue: 50,0:18:35.80,0:18:38.51,Main-207-,,0,0,0,,Hayatını riske atmaya hazır olma kararlılığı!Dialogue: 50,0:18:38.51,0:18:42.68,Main-207-,,0,0,0,,– Ateşle! Ateşle! Ateşle! – Ateşle! Ateşle! Ateşle!Dialogue: 50,0:18:44.19,0:18:46.86,Main-207-,,0,0,0,,Hey, yeni kız! Bizi bekletme.Dialogue: 50,0:18:46.86,0:18:48.69,Main-207-,,0,0,0,,Kibriti böyle ateşlersin.Dialogue: 50,0:18:59.66,0:19:01.37,Main-207-,,0,0,0,,Kahretsin! Bunu kastetmedim...Dialogue: 50,0:19:02.62,0:19:05.67,Main-207-,,0,0,0,,Nami! Bu da ne demek oluyor?Dialogue: 50,0:19:06.12,0:19:07.13,Main-207-,,0,0,0,,Üzgünüm!Dialogue: 50,0:19:07.13,0:19:09.88,Main-207-,,0,0,0,,Ne?! Özür dilemek sorunu çözmez!Dialogue: 50,0:19:10.30,0:19:11.42,Main-207-,,0,0,0,,Ne?Dialogue: 50,0:19:11.42,0:19:13.51,Main-207-,,0,0,0,,Şimdi de beni mi kurtarıyorsun?Dialogue: 50,0:19:13.51,0:19:14.88,Main-207-,,0,0,0,,Saçmalama!Dialogue: 50,0:19:14.88,0:19:17.51,Main-207-,,0,0,0,,Durum gerektirdiği için yaptım!Dialogue: 50,0:19:17.51,0:19:21.01,Main-207-,,0,0,0,,Sefil korsanlarla aynı seviyeye düşmek istemedim!Dialogue: 50,0:19:21.01,0:19:22.85,Main-207-,,0,0,0,,Oh... durum demek!Dialogue: 50,0:19:23.10,0:19:25.44,Main-207-,,0,0,0,,Korsanlar, çok sevdiğim birinin canını aldı!Dialogue: 50,0:19:25.44,0:19:27.31,Main-207-,,0,0,0,,Asla onlardan olmam!Dialogue: 50,0:19:27.31,0:19:29.44,Main-207-,,0,0,0,,Oh, demek bu yüzde-Dialogue: 50,0:19:29.44,0:19:30.19,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:19:31.48,0:19:33.19,Main-207-,,0,0,0,,Tutuşmuş!Dialogue: 50,0:19:34.15,0:19:37.61,Main-207-,,0,0,0,,Dalga geçmeyi minimumda tut, kızım!Dialogue: 50,0:19:37.61,0:19:38.95,Main-207-,,0,0,0,,Onu gösterişli öldürün!Dialogue: 50,0:19:38.95,0:19:41.45,Main-207-,,0,0,0,,– Oley! – Oley!Dialogue: 50,0:19:43.25,0:19:47.17,Main-207-,,0,0,0,,– Iskaladın! – Gösterişli ölüm!Dialogue: 50,0:19:47.17,0:19:48.33,Main-207-,,0,0,0,,– Hadi ama! – Yakala onu!Dialogue: 50,0:19:49.96,0:19:51.38,Main-207-,,0,0,0,,S-Su! Su! Su! Su!Dialogue: 50,0:19:56.59,0:19:57.72,Main-207-,,0,0,0,,Hiç iyi değil!Dialogue: 50,0:20:04.93,0:20:05.98,Main-207-,,0,0,0,,Sen...Dialogue: 50,0:20:11.27,0:20:12.23,Main-207-,,0,0,0,,Arkanda!Dialogue: 50,0:20:12.23,0:20:14.32,Main-207-,,0,0,0,,– Gösterişli ölüm! – Gösterişli ölüm!Dialogue: 50,0:20:20.62,0:20:22.08,Main-207-,,0,0,0,,Hey, hey...Dialogue: 50,0:20:23.16,0:20:26.58,Main-207-,,0,0,0,,Bu kadar kişi aynı anda bir kıza mı saldırıyor?Dialogue: 50,0:20:28.08,0:20:28.79,Main-207-,,0,0,0,,Zoro!Dialogue: 50,0:20:34.84,0:20:35.88,Main-207-,,0,0,0,,İyi misin?Dialogue: 50,0:20:36.67,0:20:37.42,Main-207-,,0,0,0,,Ha...?Dialogue: 50,0:20:37.42,0:20:39.59,Main-207-,,0,0,0,,Yaralandın mı?Dialogue: 50,0:20:39.59,0:20:42.22,Main-207-,,0,0,0,,H-Hayır, iyiyim.Dialogue: 50,0:20:42.22,0:20:44.39,Main-207-,,0,0,0,,Uff, çok rahatladım!Dialogue: 50,0:20:44.39,0:20:46.18,Main-207-,,0,0,0,,Bizi nasıl buldun?Dialogue: 50,0:20:46.18,0:20:47.77,Main-207-,,0,0,0,,Çabuk çıkar beni buradan.Dialogue: 50,0:20:47.77,0:20:50.77,Main-207-,,0,0,0,,Niye salak salak işler yapıyorsun?Dialogue: 50,0:20:50.77,0:20:53.86,Main-207-,,0,0,0,,Önce kuş seni götürdü, şimdi de kafeste misin?Dialogue: 50,0:20:53.86,0:20:55.40,Main-207-,,0,0,0,,Şey, çok ilginç aslında.Dialogue: 50,0:20:56.11,0:20:57.90,Main-207-,,0,0,0,,– Zoro? – Zo...Dialogue: 50,0:20:57.90,0:21:00.57,Main-207-,,0,0,0,,Ona böyle seslendi, değil mi?Dialogue: 50,0:21:00.99,0:21:05.49,Thoughts-207-,,0,0,0,,Bahsettiği yoldaşı... korsan avcısı Zoro muydu?Dialogue: 50,0:21:06.08,0:21:07.75,Thoughts-207-,,0,0,0,,Neler oluyor?!Dialogue: 50,0:21:09.08,0:21:10.83,Main-207-,,0,0,0,,Demek sen Zoro'sun.Dialogue: 50,0:21:11.79,0:21:15.21,Main-207-,,0,0,0,,Ne istiyorsun? Kellemi mi?Dialogue: 50,0:21:15.84,0:21:17.84,Main-207-,,0,0,0,,Hayır, ilgilenmiyorum.Dialogue: 50,0:21:17.84,0:21:20.93,Main-207-,,0,0,0,,Korsan avcılığını bıraktım.Dialogue: 50,0:21:21.72,0:21:25.31,Main-207-,,0,0,0,,Ama ben ilgileniyorum! Seni öldürmek şanımı yükseltir!Dialogue: 50,0:21:26.81,0:21:29.02,Main-207-,,0,0,0,,Ben olsam denemezdim. Ölürsün.Dialogue: 50,0:21:29.02,0:21:31.73,Main-207-,,0,0,0,,Ha? Öyle mi?Dialogue: 50,0:21:33.98,0:21:36.23,Main-207-,,0,0,0,,Sanırım kelimeler kifayetsiz kalıyor.Dialogue: 50,0:21:36.90,0:21:39.11,Main-207-,,0,0,0,,Oy! İndir onu, Kaptan!Dialogue: 50,0:21:39.11,0:21:41.74,Main-207-,,0,0,0,,Kaptan Buggy!Dialogue: 50,0:21:41.74,0:21:55.67,Main-207-,,0,0,0,,– Buggy! Buggy! Buggy! – Buggy! Buggy! Buggy!Dialogue: 50,0:21:56.17,0:21:59.34,Main-207-,,0,0,0,,Gösterişli şekilde öl!Dialogue: 50,0:22:13.56,0:22:15.86,Main-207-,,0,0,0,,Bu çok kolay oldu...Dialogue: 50,0:22:15.86,0:22:17.48,Main-207-,,0,0,0,,Oha!Dialogue: 50,0:22:17.48,0:22:19.28,Main-207-,,0,0,0,,Ne kadar güçsüzmüş!Dialogue: 50,0:22:19.78,0:22:20.86,Main-207-,,0,0,0,,Olamaz...Dialogue: 50,0:22:31.20,0:22:32.54,Main-207-,,0,0,0,,Bunların nesi var?Dialogue: 50,0:22:32.54,0:22:34.17,Main-207-,,0,0,0,,N-Ne oluyor...?Dialogue: 50,0:22:34.17,0:22:37.29,Main-207-,,0,0,0,,Kaptanları öldürüldü, ama gülüyorlar.Dialogue: 50,0:22:37.29,0:22:38.63,Main-207-,,0,0,0,,Hey!Dialogue: 50,0:22:38.63,0:22:40.88,Main-207-,,0,0,0,,Bu kadar komik olan ne?!Dialogue: 50,0:22:49.06,0:22:50.52,Main-207-,,0,0,0,,Zoro!Dialogue: 50,0:22:51.64,0:22:53.06,Main-207-,,0,0,0,,O el de ne?Dialogue: 50,0:22:53.06,0:22:55.85,Main-207-,,0,0,0,,Ne oluyor lan?!Dialogue: 50,0:22:59.11,0:23:01.03,Main-207-,,0,0,0,,Parçalanma Meyvesi...Dialogue: 50,0:23:02.11,0:23:05.36,Main-207-,,0,0,0,,Yediğim şeytan meyvesinin adı bu.Dialogue: 50,0:23:06.87,0:23:10.87,Main-207-,,0,0,0,,Ben kesilemeyen, parça-parça adamım!Dialogue: 50,0:23:13.71,0:23:16.25,Main-207-,,0,0,0,,Vücudu yeniden birleşti!Dialogue: 50,0:23:16.25,0:23:19.71,Main-207-,,0,0,0,,Şeytan meyvelerinin sadece bir efsane olduğunu sanıyordum.Dialogue: 50,0:23:19.71,0:23:21.30,Main-207-,,0,0,0,,Bölünen adam mı?!Dialogue: 50,0:23:21.30,0:23:22.96,Main-207-,,0,0,0,,Bu adam ucube mi?!Dialogue: 50,0:23:25.93,0:23:29.60,Main-207-,,0,0,0,,Hayati bir şeye vurmadım, ama yaran oldukça ciddi!Dialogue: 50,0:23:29.60,0:23:30.64,Main-207-,,0,0,0,,Ben kazandım!Dialogue: 50,0:23:30.64,0:23:36.60,Secondary-207-,,0,0,0,,– Buggy! Buggy! Buggy! – Buggy! Buggy! Buggy!Dialogue: 50,0:23:30.64,0:23:33.02,Main-207-,,0,0,0,,Fazlasıyla iyisin, Kaptan!Dialogue: 50,0:23:33.89,0:23:36.60,Main-207-,,0,0,0,,Buggy! Buggy!Dialogue: 50,0:23:37.44,0:23:41.07,Thoughts-207-,,0,0,0,,Çok kötü! Durum tersine döndü!Dialogue: 50,0:23:41.07,0:23:44.95,Thoughts-207-,,0,0,0,,Hızlıca bir şey yapmazsak, benimle beraber bu ikisi de ölecek!Dialogue: 50,0:23:46.20,0:23:49.16,Main-207-,,0,0,0,,Biraz acıttı...Dialogue: 50,0:23:54.62,0:23:58.08,Main-207-,,0,0,0,,– Buggy! Buggy! Buggy! – Buggy! Buggy! Buggy!Dialogue: 50,0:23:58.08,0:24:00.42,Main-207-,,0,0,0,,Arkasından bıçaklamak alçaklık,...Dialogue: 50,0:24:00.42,0:24:02.05,Main-207-,,0,0,0,,...Koca Burun!Dialogue: 50,0:24:05.76,0:24:07.34,Thoughts-207-,,0,0,0,,S-Seni aptal!Dialogue: 50,0:24:07.34,0:24:09.34,Thoughts-207-,,0,0,0,,Öyle çağırma onu!Dialogue: 50,0:24:12.35,0:24:17.81,Main-207-,,0,0,0,,Kimin... burnu büyükmüş ha?!Dialogue: 50,0:24:19.19,0:24:19.85,Main-207-,,0,0,0,,Luffy!Dialogue: 50,0:24:21.69,0:24:22.82,Main-207-,,0,0,0,,Buggy!Dialogue: 50,0:24:24.23,0:24:27.28,Main-207-,,0,0,0,,Kesinlikle kıçına tekmeyi basacağım!Dialogue: 50,0:24:31.53,0:24:33.12,Main-207-,,0,0,0,,Kıçıma tekme mi basacaksın?Dialogue: 50,0:24:33.12,0:24:34.79,Main-207-,,0,0,0,,Hayal görüyorsun!Dialogue: 50,0:24:34.79,0:24:37.91,Main-207-,,0,0,0,,Üçünüzde burada öleceksiniz!Dialogue: 50,0:24:38.42,0:24:40.75,Main-207-,,0,0,0,,Şu durumda kıçıma tekmeyi nasıl basacaksın?Dialogue: 50,0:24:40.75,0:24:43.04,Main-207-,,0,0,0,,Söyle?! Nasıl?! Söyle?!Dialogue: 50,0:24:47.63,0:24:50.59,Main-207-,,0,0,0,,Faydası yok... Her şey bitti...Dialogue: 50,0:24:53.26,0:24:55.22,Main-207-,,0,0,0,,Ölmeyi reddediyorum!Dialogue: 50,0:24:55.72,0:24:57.31,Main-207-,,0,0,0,,Kaç, Zoro!Dialogue: 50,0:24:57.31,0:24:58.31,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:24:58.31,0:25:01.56,Main-207-,,0,0,0,,Bekle! Buraya seni kurtarmaya geldi!Dialogue: 50,0:25:01.56,0:25:03.06,Main-207-,,0,0,0,,Sen ne yapacaksın?!Dialogue: 50,0:25:08.99,0:25:09.99,Main-207-,,0,0,0,,Anlaşıldı.Dialogue: 50,0:25:10.24,0:25:12.37,Thoughts-207-,,0,0,0,,Artık hiç bir şey anlamıyorum.Dialogue: 50,0:25:12.37,0:25:14.74,Thoughts-207-,,0,0,0,,Bu yüzden korsanlardan nefret ediyorum!Dialogue: 50,0:25:15.08,0:25:16.95,Main-207-,,0,0,0,,Küstah aptal!Dialogue: 50,0:25:16.95,0:25:18.87,Main-207-,,0,0,0,,Hiç bir yere gidemezsin!Dialogue: 50,0:25:25.75,0:25:26.88,Main-207-,,0,0,0,,Aptal!Dialogue: 50,0:25:26.88,0:25:30.22,Main-207-,,0,0,0,,Senin üç kılıç stilin bana etki–Dialogue: 50,0:25:30.93,0:25:33.39,Main-207-,,0,0,0,,Hey, konuşurken beni dinle!Dialogue: 50,0:25:50.45,0:25:53.41,Main-207-,,0,0,0,,Eyvah! Top bize doğru döndü!Dialogue: 50,0:25:53.87,0:25:55.16,Main-207-,,0,0,0,,Hey! Ateşle şunu!Dialogue: 50,0:25:55.16,0:25:55.83,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:25:55.83,0:25:56.79,Main-207-,,0,0,0,,Acele et!Dialogue: 50,0:25:56.79,0:25:57.45,Main-207-,,0,0,0,,T-Tamam!Dialogue: 50,0:25:58.37,0:25:59.83,Main-207-,,0,0,0,,Durun, durun, durun, durun!Dialogue: 50,0:25:59.83,0:26:04.04,Main-207-,,0,0,0,,İçinde hala Özel Buggy Topu var!Dialogue: 50,0:26:06.80,0:26:08.34,Main-207-,,0,0,0,,Ateşledin!Dialogue: 50,0:26:08.34,0:26:12.01,Main-207-,,0,0,0,,Aah! Dur! Hayır! Yapma!Dialogue: 50,0:26:12.01,0:26:13.68,Main-207-,,0,0,0,,Yapma!Dialogue: 50,0:26:29.94,0:26:32.57,Main-207-,,0,0,0,,Hey, Zoro, yaralısın.Dialogue: 50,0:26:32.82,0:26:35.20,Main-207-,,0,0,0,,Çeneni kapa ve orada kal.Dialogue: 50,0:26:35.20,0:26:37.49,Main-207-,,0,0,0,,İşleri bildiğim gibi yapacağım.Dialogue: 50,0:26:43.21,0:26:45.67,Main-207-,,0,0,0,,Bu adam da kim böyle?!Dialogue: 50,0:26:47.67,0:26:50.67,Main-207-,,0,0,0,,Luffy, bu kim?Dialogue: 50,0:26:51.01,0:26:53.22,Main-207-,,0,0,0,,Ha, bu bizim rotacımız!Dialogue: 50,0:26:54.34,0:26:56.30,Main-207-,,0,0,0,,Dalga geçme şimdi!Dialogue: 50,0:26:56.30,0:26:58.47,Main-207-,,0,0,0,,Kimsiniz siz?Dialogue: 50,0:26:58.47,0:27:00.18,Main-207-,,0,0,0,,Çekil...Dialogue: 50,0:27:01.27,0:27:02.60,Main-207-,,0,0,0,,Yolumu tıkıyorsun!Dialogue: 50,0:27:15.20,0:27:17.32,Main-207-,,0,0,0,,Niye bu kadar uğraşıyorsun?Dialogue: 50,0:27:17.32,0:27:18.83,Main-207-,,0,0,0,,Sen sadece bir korsansın.Dialogue: 0,0:01:50.01,0:01:53.89,Title-207-,,0,0,0,,NamiDialogue: 1,0:01:50.01,0:01:53.89,Title-207-,,0,0,0,,NamiDialogue: 0,0:08:56.31,0:09:00.48,Captions-207-,,0,0,0,,Korsan Hırsızı, NamiDialogue: 1,0:08:56.31,0:09:00.48,Captions-207-,,0,0,0,,Korsan Hırsızı, NamiDialogue: 0,0:09:23.21,0:09:28.96,Captions-207-,,0,0,0,,"Palyaço" Buggy Korsan KaptanDialogue: 1,0:09:23.21,0:09:28.96,Captions-207-,,0,0,0,,"Palyaço" Buggy Korsan KaptanDialogue: 0,0:23:22.96,0:23:25.18,Captions-207-,,0,0,0,,m 501.75 837 l 949.5 837 949.5 945 501.75 945Dialogue: 1,0:23:22.96,0:23:25.18,Captions-207-,,0,0,0,,Lastik AdamDialogue: 0,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 1,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 0,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Galaxy 9000Dialogue: 1,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Galaxy 9000Dialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,MüzikDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,MüzikDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,HaleeDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,HaleeDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,GrafikDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,GrafikDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,Datenshi JimmyVictus KaitouYahiko Pepperjack YagDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,Datenshi JimmyVictus KaitouYahiko Pepperjack YagDialogue: 0,0:00:06.78,0:00:10.78,Credits-207-,,0,0,0,,Kalite KontrolDialogue: 1,0:00:06.78,0:00:10.78,Credits-207-,,0,0,0,,Kalite KontrolDialogue: 0,0:00:06.78,0:00:10.78,Credits-207-,,0,0,0,,Galaxy 9000 Pepperjack Westfal ZenefDialogue: 1,0:00:06.78,0:00:10.78,Credits-207-,,0,0,0,,Galaxy 9000 Pepperjack Westfal ZenefDialogue: 0,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,KaraokeDialogue: 1,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,KaraokeDialogue: 0,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,KaitouYahikoDialogue: 1,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,KaitouYahikoDialogue: 0,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,ZamanlamaDialogue: 1,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,ZamanlamaDialogue: 0,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,Bastia Gab VillagerDialogue: 1,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,Bastia Gab VillagerDialogue: 0,0:00:13.28,0:00:16.79,Credits-207-,,0,0,0,,Altyazı Düzenleme - TRDialogue: 1,0:00:13.28,0:00:16.79,Credits-207-,,0,0,0,,Altyazı Düzenleme - TRDialogue: 0,0:00:13.28,0:00:16.79,Credits-207-,,0,0,0,,Jack Cohle onepacetr.netDialogue: 1,0:00:13.28,0:00:16.79,Credits-207-,,0,0,0,,Jack Cohle onepacetr.netDialogue: 0,0:00:16.79,0:00:19.25,Credits-207-,,0,0,0,,RawsDialogue: 1,0:00:16.79,0:00:19.25,Credits-207-,,0,0,0,,RawsDialogue: 0,0:00:16.79,0:00:19.25,Credits-207-,,0,0,0,,Neo-RawsDialogue: 1,0:00:16.79,0:00:19.25,Credits-207-,,0,0,0,,Neo-RawsDialogue: 0,0:00:16.79,0:00:19.25,Credits-207-,,0,0,0,,Çevirmen - TRDialogue: 1,0:00:16.79,0:00:19.25,Credits-207-,,0,0,0,,Çevirmen - TRDialogue: 0,0:00:16.79,0:00:19.25,Credits-207-,,0,0,0,,EFoZM onepacetr.netDialogue: 1,0:00:16.79,0:00:19.25,Credits-207-,,0,0,0,,EFoZM onepacetr.netDialogue: 0,0:00:01.52,0:00:03.65,Roger-Monologue,,0,0,0,,Zenginlik, şöhret, güç...Dialogue: 0,0:00:03.65,0:00:07.82,Roger-Monologue,,0,0,0,,Dünyanın sunabileceği her şeyi elde eden adam, Korsanlar Kralı, Gold Roger.Dialogue: 0,0:00:07.82,0:00:11.66,Roger-Monologue,,0,0,0,,Son sözleri dünyanın her yerinden maceracıları denize çekti.Dialogue: 0,0:00:11.66,0:00:13.66,Roger-Monologue,,0,0,0,,Hazinem mi?Dialogue: 0,0:00:13.66,0:00:15.45,Roger-Monologue,,0,0,0,,İstiyorsanız, alabilirsiniz.Dialogue: 0,0:00:15.45,0:00:16.66,Roger-Monologue,,0,0,0,,Arayıp bulun!Dialogue: 0,0:00:16.66,0:00:19.25,Roger-Monologue,,0,0,0,,Bu dünyanın sunabileceği her şeyi orada bıraktım!Dialogue: 0,0:00:21.67,0:00:26.38,Roger-Monologue,,0,0,0,,Artık herkes, hayallerinin peşinde Grand Line’a yelken açıyor!Dialogue: 0,0:00:26.38,0:00:29.63,Roger-Monologue,,0,0,0,,Dünya, Büyük Korsan Çağı'na girdi!Dialogue: 2,0:00:29.91,0:00:35.35,Lyrics,,0,0,0,fx,ADialogue: 2,0:00:29.91,0:00:35.35,Lyrics,,0,0,0,fx,tDialogue: 2,0:00:29.91,0:00