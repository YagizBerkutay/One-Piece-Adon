Dialogue: 0,0:00:05.30,0:00:09.17,OP11 Lyrics,,0,0,0,,♪ Gökyüzüne ulaşana kadar, ♪
Dialogue: 0,0:00:09.27,0:00:15.71,OP11 Lyrics,,0,0,0,,♪ İnanıyorum, sonraki yarına kadar, hey ♪
Dialogue: 0,0:00:15.73,0:00:19.13,OP11 Lyrics,,0,0,0,,♪ hadi millet gidelim, müziği paylaşıyoruz. ♪
Dialogue: 0,0:00:19.96,0:00:23.36,OP11 Lyrics,,0,0,0,,♪ hadi gidelim bebeğim, bebeğim, oh tek bir hayali paylaşıyoruz. ♪
Dialogue: 0,0:00:23.88,0:00:27.28,OP11 Lyrics,,0,0,0,,♪ hadi millet gidelim, oh iyi zamanları paylaşıyoruz. ♪
Dialogue: 0,0:00:27.71,0:00:31.11,OP11 Lyrics,,0,0,0,,♪ hadi gidelim bebeğim, bebeğim, oh tek bir dünyayı paylaşıyoruz. ♪
Dialogue: 0,0:00:31.81,0:00:35.55,OP11 Lyrics,,0,0,0,,♪ Mobius yüzüğünün tepesinde kovalıyor ve kovalanıyor. ♪
Dialogue: 0,0:00:35.58,0:00:39.35,OP11 Lyrics,,0,0,0,,♪ Yaklaşıyor ve ileri bakıyorum, hey tarzını paylaşmak istiyorum. ♪
Dialogue: 0,0:00:39.52,0:00:43.45,OP11 Lyrics,,0,0,0,,♪ Başlıyor, genişliyor, hayal gücünün üstündeki bu tat. ♪
Dialogue: 0,0:00:43.52,0:00:47.76,OP11 Lyrics,,0,0,0,,♪ Vücudumu baştan başa iyi hissediyorum, özgür kalacağım, oh evet ♪
Dialogue: 0,0:00:47.79,0:00:49.79,OP11 Lyrics,,0,0,0,,♪ Uzakta olsa da, müziği paylaş. ♪
Dialogue: 0,0:00:49.79,0:00:51.73,OP11 Lyrics,,0,0,0,,♪ Birbirine anlatarak o rüyayı paylaş. ♪
Dialogue: 0,0:00:51.76,0:00:53.60,OP11 Lyrics,,0,0,0,,♪ İyi zamanları ve kahkahaları paylaş. ♪
Dialogue: 0,0:00:53.72,0:00:55.27,OP11 Lyrics,,0,0,0,,♪ şimdi tek bir dünyayı paylaş. ♪
Dialogue: 0,0:00:55.45,0:01:03.74,OP11 Lyrics,,0,0,0,,♪ Gökyüzüne ulaşana kadar gitmeye devam edeceğim. ♪
Dialogue: 0,0:01:03.81,0:01:13.05,OP11 Lyrics,,0,0,0,,♪ Hadi üstesinden gelelim, sonraki yarınlara inanıyorum, evet evet... ♪
Dialogue: 0,0:01:13.15,0:01:21.56,OP11 Lyrics,,0,0,0,,♪ Görünmez duvarın diğer tarafında bekliyordun. ♪
Dialogue: 0,0:01:21.66,0:01:31.62,OP11 Lyrics,,0,0,0,,♪ Yakında orada olacağım, tek bir dünyaya inanıyorum, evet evet... ♪
Dialogue: 0,0:01:31.64,0:01:35.04,OP11 Lyrics,,0,0,0,,♪ hadi millet gidelim, müziği paylaşıyoruz. ♪
Dialogue: 0,0:01:35.67,0:01:39.87,OP11 Lyrics,,0,0,0,,♪ hadi gidelim bebeğim, bebeğim, oh tek bir dünyayı paylaşıyoruz. ♪
Dialogue: 0,0:01:44.85,0:01:46.39,Main,,0,0,0,,Tamam...
Dialogue: 0,0:01:52.57,0:01:55.57,Main,,0,0,0,,Artık tam gücümü esirgemeyeceğim.
Dialogue: 0,0:01:56.90,0:01:58.59,Main,,0,0,0,,{\fad(150,150)}İkinci Vites
Dialogue: 0,0:02:00.60,0:02:01.88,Main,,0,0,0,,O da ne?!
Dialogue: 0,0:02:02.30,0:02:04.50,Main,,0,0,0,,Bedeninden duman çıkıyor!
Dialogue: 0,0:02:05.05,0:02:07.47,Main,,0,0,0,,Erkekler bunu yapabilir mi?!
Dialogue: 0,0:02:17.42,0:02:21.25,Main,,0,0,0,,O zaman ben de bütün gücümle\Nseni ısırıp öldüreceğim!
Dialogue: 0,0:02:23.22,0:02:24.47,Main,,0,0,0,,{\fad(150,150)}Medusa Saçı...
Dialogue: 0,0:02:25.87,0:02:28.00,Main,,0,0,0,,{\fad(150,150)}Sekiz Başlı Yılan!
Dialogue: 0,0:02:31.42,0:02:32.43,Main,,0,0,0,,Hadi!
Dialogue: 0,0:02:32.43,0:02:34.40,Main,,0,0,0,,Sandersonia-sama!
Dialogue: 0,0:02:38.69,0:02:40.32,Main,,0,0,0,,Arenanın kenarını kırdı!
Dialogue: 0,0:02:40.32,0:02:42.27,Main,,0,0,0,,Sadece saçından yapılmış\Nbir yılan olsa da...
Dialogue: 0,0:02:42.27,0:02:44.74,Main,,0,0,0,,...dişleri çelikten yapılmış gibi!
Dialogue: 0,0:02:52.26,0:02:53.91,Thoughts,,0,0,0,,Niye ona vurmuyorlar?!
Dialogue: 0,0:02:53.91,0:02:57.19,Thoughts,,0,0,0,,Hareketlerini tahmin edebiliyorum\Nama bir türlü ayak uyduramıyorum!
Dialogue: 0,0:03:26.95,0:03:28.93,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:03:30.81,0:03:31.76,Main,,0,0,0,,Faydasız!
Dialogue: 0,0:03:32.00,0:03:35.63,Main,,0,0,0,,Saldırın deminki gibi üzerimden sekecek.
Dialogue: 0,0:03:37.46,0:03:38.20,Main,,0,0,0,,{\fad(150,150)}...Jet...
Dialogue: 0,0:03:41.32,0:03:43.98,Main,,0,0,0,,{\fad(150,150)}...Bazuka!
Dialogue: 0,0:04:01.06,0:04:02.59,Main,,0,0,0,,Sonia! Mari!
Dialogue: 0,0:04:05.56,0:04:09.46,Main,,0,0,0,,Ne diye oyun oynuyorsunuz?!
Dialogue: 0,0:04:09.99,0:04:12.16,Main,,0,0,0,,Abla...
Dialogue: 0,0:04:17.21,0:04:19.65,Main,,0,0,0,,Lütfen bizi bağışla abla!
Dialogue: 0,0:04:20.11,0:04:22.37,Main,,0,0,0,,İşini hemen bitireceğiz!
Dialogue: 0,0:04:26.37,0:04:27.11,Main,,0,0,0,,Yanıyor!
Dialogue: 0,0:04:28.35,0:04:29.64,Main,,0,0,0,,{\fad(150,150)}Medusa Saçı...
Dialogue: 0,0:04:30.99,0:04:32.29,Main,,0,0,0,,{\fad(150,150)}Salamander!
Dialogue: 0,0:04:33.73,0:04:35.49,Main,,0,0,0,,Kaçamayacaksın!
Dialogue: 0,0:04:35.89,0:04:37.09,Main,,0,0,0,,Etrafı sarıldı!
Dialogue: 0,0:04:37.09,0:04:39.51,Main,,0,0,0,,Ne kadar çevik olursa olsun\Nburadan kaçamaz artık!
Dialogue: 0,0:04:39.51,0:04:41.26,Main,,0,0,0,,Bundan daha güçlü bir saldırı yok!
Dialogue: 0,0:04:48.24,0:04:49.77,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:04:56.32,0:04:57.31,Main,,0,0,0,,{\fad(150,150)}Jet...
Dialogue: 0,0:04:58.03,0:05:00.90,Main,,0,0,0,,{\fad(150,150)}...Makineli!
Dialogue: 0,0:05:20.52,0:05:21.60,Main,,0,0,0,,Eyvah!
Dialogue: 0,0:05:21.60,0:05:23.77,Main,,0,0,0,,Sonia abla! Benden uzaklaş hemen!
Dialogue: 0,0:05:26.00,0:05:28.54,Main,,0,0,0,,Ne? Ben de çekiliyorum!
Dialogue: 0,0:05:29.87,0:05:31.94,Main,,0,0,0,,Kuyruklarımız ne zaman...
Dialogue: 0,0:05:32.28,0:05:34.33,Main,,0,0,0,,Yanıyor! Yanıyor!
Dialogue: 0,0:05:34.33,0:05:36.53,Main,,0,0,0,,Abla, lütfen dur! Beni de çekeceksin!
Dialogue: 0,0:05:40.36,0:05:42.33,Main,,0,0,0,,Dikkat et, Sonia abla!
Dialogue: 0,0:05:42.33,0:05:45.49,Main,,0,0,0,,Orası kazık çukuru!\NParmaklıklara tutun!
Dialogue: 0,0:05:54.71,0:05:57.17,Main,,0,0,0,,Ç-Çok yakındı.
Dialogue: 0,0:05:57.51,0:06:00.04,Main,,0,0,0,,S-Sandersonia-sama?!
Dialogue: 0,0:06:06.22,0:06:07.28,Main,,0,0,0,,Ah! Sıcak!
Dialogue: 0,0:06:07.86,0:06:09.79,Main,,0,0,0,,Adam onun işini biterecek!
Dialogue: 0,0:06:09.79,0:06:10.79,Main,,0,0,0,,Bu korkunç!
Dialogue: 0,0:06:10.79,0:06:13.89,Main,,0,0,0,,Onu çukura düşürüp bir\Nhayvan gibi kazığa geçirecek!
Dialogue: 0,0:06:13.89,0:06:15.17,Main,,0,0,0,,Lanet olası adam!
Dialogue: 0,0:06:15.17,0:06:16.14,Main,,0,0,0,,Kıpırdama!
Dialogue: 0,0:06:17.67,0:06:19.62,Main,,0,0,0,,Beni öldürmek niyetinde olsanız bile...
Dialogue: 0,0:06:19.96,0:06:21.96,Main,,0,0,0,,...seni öldürmeyeceğim!
Dialogue: 0,0:06:21.96,0:06:23.91,Main,,0,0,0,,Ukalalık etme, lanet olası!
Dialogue: 0,0:06:23.91,0:06:26.43,Main,,0,0,0,,Mari! Fırsatın varken hemen işini bitir!
Dialogue: 0,0:06:26.70,0:06:28.90,Main,,0,0,0,,Ne yapıyorsun, Mari?!
Dialogue: 0,0:06:29.49,0:06:31.59,Main,,0,0,0,,Yapamam, Sonia abla.
Dialogue: 0,0:06:32.70,0:06:34.09,Main,,0,0,0,,Şu anda o adam...
Dialogue: 0,0:06:34.69,0:06:38.79,Main,,0,0,0,,...bizi koruyor!
Dialogue: 0,0:06:38.79,0:06:43.19,Main,,0,0,0,,Bakın! Sandersonia-sama'nın\Npelerini yanmış ve sırtı açığa çıkmış!
Dialogue: 0,0:06:43.19,0:06:46.79,Main,,0,0,0,,Adam onu bırakırsa\NGorgon'un Gözü ortaya çıkacak!
Dialogue: 0,0:06:46.79,0:06:47.74,Main,,0,0,0,,Eyvah!
Dialogue: 0,0:06:47.74,0:06:50.12,Main,,0,0,0,,Onları gören herkes taşa dönüşecek!
Dialogue: 0,0:06:50.79,0:06:52.62,Main,,0,0,0,,Sırtımı mı kapatıyorsun?
Dialogue: 0,0:06:52.62,0:06:54.36,Main,,0,0,0,,Daha önce bundan bahsetmiştiniz, değil mi?
Dialogue: 0,0:06:54.72,0:07:00.77,Flashbacks,,0,0,0,,Sırtımda gördüğün ölsek bile ortaya\Nçıkmasını istemediğimiz bir şey!
Dialogue: 0,0:07:01.62,0:07:04.60,Main,,0,0,0,,Birilerinin görmesine izin vermektense\Nölmeyi tercih edersin, değil mi?
Dialogue: 0,0:07:06.97,0:07:08.95,Main,,0,0,0,,Bu yüzden kıpırdama!
Dialogue: 0,0:07:13.41,0:07:15.24,Main,,0,0,0,,Gösteri sona erdi!
Dialogue: 0,0:07:15.24,0:07:19.35,Main,,0,0,0,,Gorgon'un Gözü ortaya çıkmadan evvel\Nherkes arenayı terketsin!
Dialogue: 0,0:07:19.66,0:07:22.00,Main,,0,0,0,,Durum kötü! Hemen arenadan çıkın!
Dialogue: 0,0:07:22.00,0:07:23.65,Main,,0,0,0,,Taşa dönüşeceğiz!
Dialogue: 0,0:07:23.65,0:07:25.68,Main,,0,0,0,,Çabuk! Acele edin!
Dialogue: 0,0:07:25.68,0:07:27.36,Main,,0,0,0,,Gorgon'un laneti!
Dialogue: 0,0:07:38.74,0:07:41.96,Main,,0,0,0,,Demin benimle dövüşüyordun...
Dialogue: 0,0:07:41.96,0:07:43.68,Main,,0,0,0,,Niye bana yardım ediyorsun?
Dialogue: 0,0:07:44.26,0:07:48.95,Main,,0,0,0,,Kimsenin görmesini istemediğiniz şeyin\Ndövüşümüzle ilgisi yok.
Dialogue: 0,0:08:07.45,0:08:13.87,Title,,0,0,240,,{\fad(1000,0)}Hancock'un İtirafı
Dialogue: 0,0:08:14.84,0:08:16.69,Main,,0,0,0,,Çok üzgünüz abla!
Dialogue: 0,0:08:16.69,0:08:19.01,Main,,0,0,0,,Sadece yenilmekle kalmayıp bir de\Ndüşmanımız tarafından kurtarıldık!
Dialogue: 0,0:08:21.14,0:08:23.08,Main,,0,0,0,,Şimdi benimle sen mi dövüşeceksin?
Dialogue: 0,0:08:32.02,0:08:33.53,Main,,0,0,0,,Yeter artık.
Dialogue: 0,0:08:33.89,0:08:35.43,Main,,0,0,0,,Maksadım bu değil.
Dialogue: 0,0:08:36.00,0:08:37.10,Main,,0,0,0,,Öyle mi?
Dialogue: 0,0:08:37.57,0:08:39.60,Main,,0,0,0,,Hiçbir yerinde çatlak yok, değil mi?
Dialogue: 0,0:08:41.88,0:08:45.97,Main,,0,0,0,,Tamam, o zaman bunları eski\Nhaline döndürebilir misin?
Dialogue: 0,0:08:47.28,0:08:49.74,Main,,0,0,0,,Bunu bir şekilde yapabiliyor\Nolmalısın, değil mi?
Dialogue: 0,0:08:50.28,0:08:53.11,Main,,0,0,0,,Sadece beni koruyorlardı!
Dialogue: 0,0:08:53.11,0:08:54.58,Main,,0,0,0,,Yanlış bir şey yapmadılar!
Dialogue: 0,0:08:54.58,0:08:56.02,Main,,0,0,0,,Hey, lütfen!
Dialogue: 0,0:08:58.02,0:08:59.20,Main,,0,0,0,,Evet, tabii ki...
Dialogue: 0,0:08:59.20,0:09:02.08,Main,,0,0,0,,...onları eski hallerine nasıl\Ndöndüreceğimi biliyorum.
Dialogue: 0,0:09:03.52,0:09:04.46,Main,,0,0,0,,Ancak...
Dialogue: 0,0:09:05.98,0:09:09.82,Main,,0,0,0,,...gitmek istediğin bir yer\Nolduğunu söylemiştin, değil mi?
Dialogue: 0,0:09:09.82,0:09:12.16,Main,,0,0,0,,Evet, arkadaşlarım beni bekliyor.
Dialogue: 0,0:09:12.70,0:09:13.70,Main,,0,0,0,,Öyle mi?
Dialogue: 0,0:09:14.43,0:09:16.40,Main,,0,0,0,,İsteklerinden sadece\Nbirini gerçekleştireceğim.
Dialogue: 0,0:09:16.78,0:09:19.02,Main,,0,0,0,,Üç heykelin eski haline dönmesini mi...
Dialogue: 0,0:09:19.02,0:09:21.74,Main,,0,0,0,,...yoksa adadan gitmeyi mi tercih ediyorsun?
Dialogue: 0,0:09:22.07,0:09:25.71,Main,,0,0,0,,İkisinden birini seçmeli ve\Ndiğerinden vazgeçmelisin!
Dialogue: 0,0:09:27.01,0:09:29.28,Flashbacks,,0,0,0,,İçyüzünü ortaya çıkar, erkek!
Dialogue: 0,0:09:29.92,0:09:32.08,Main,,0,0,0,,Öyle mi? Sağol!
Dialogue: 0,0:09:33.24,0:09:35.52,Main,,0,0,0,,O zaman onları kurtaracaksın, değil mi?
Dialogue: 0,0:09:38.82,0:09:41.19,Main,,0,0,0,,Çok sağol!
Dialogue: 0,0:09:42.40,0:09:44.37,Main,,0,0,0,,Bir anlık tereddüt bile yok.
Dialogue: 0,0:09:44.37,0:09:47.04,Main,,0,0,0,,Hakisi bu kadar yüksek olan bir adam...
Dialogue: 0,0:09:47.04,0:09:50.90,Main,,0,0,0,,...nasıl olur da kendisini\Nkurtaranların için başını eğer?
Dialogue: 0,0:09:50.90,0:09:52.57,Captions,,0,0,0,,{\fad(380,0)\pos(1082,82)}Kolezyum Çıkışı
Dialogue: 0,0:09:54.50,0:09:55.51,Main,,0,0,0,,Margaret!
Dialogue: 0,0:09:55.51,0:09:56.86,Main,,0,0,0,,Sweetpea!
Dialogue: 0,0:09:56.86,0:09:57.91,Main,,0,0,0,,Aphelandra!
Dialogue: 0,0:09:58.22,0:10:00.20,Main,,0,0,0,,Burada mıydınız?
Dialogue: 0,0:10:00.20,0:10:02.65,Main,,0,0,0,,Hele şükür! Artık heykel değilsiniz!
Dialogue: 0,0:10:03.60,0:10:07.42,Main,,0,0,0,,Endişelendik! Aniden adamı\Nkorumak da neyin nesi?
Dialogue: 0,0:10:07.82,0:10:09.17,Main,,0,0,0,,Kesinlikle.
Dialogue: 0,0:10:09.17,0:10:10.99,Main,,0,0,0,,Size ne olacağını merak ediyorduk.
Dialogue: 0,0:10:12.02,0:10:13.26,Main,,0,0,0,,Heykel?
Dialogue: 0,0:10:14.76,0:10:16.09,Main,,0,0,0,,Ne oldu acaba?
Dialogue: 0,0:10:16.74,0:10:19.90,Main,,0,0,0,,Ne olmuş olabileceği hakkında\Nhiçbir fikrim yok.
Dialogue: 0,0:10:20.14,0:10:21.20,Main,,0,0,0,,Hatırlamıyor musunuz?
Dialogue: 0,0:10:21.45,0:10:22.51,Main,,0,0,0,,Hayır,...
Dialogue: 0,0:10:22.51,0:10:25.81,Main,,0,0,0,,...kendimize geldiğimizde\Nadam çok mutluydu.
Dialogue: 0,0:10:26.41,0:10:28.27,Main,,0,0,0,,Ah, hele şükür!
Dialogue: 0,0:10:28.60,0:10:31.94,Main,,0,0,0,,Ölebileceğinizden korkmuştum!
Dialogue: 0,0:10:32.85,0:10:34.32,Main,,0,0,0,,Hiç kimse yok.
Dialogue: 0,0:10:34.32,0:10:36.62,Main,,0,0,0,,Çoktan bitti mi?
Dialogue: 0,0:10:38.94,0:10:41.22,Main,,0,0,0,,...böyle oldu işte.
Dialogue: 0,0:10:41.22,0:10:44.13,Main,,0,0,0,,Taşlaşmak hafıza kaybına neden olmuş gibi.
Dialogue: 0,0:10:44.13,0:10:46.96,Main,,0,0,0,,Sonrasında olanları size anlatacağım.
Dialogue: 0,0:10:47.28,0:10:48.38,Main,,0,0,0,,Margaret,...
Dialogue: 0,0:10:48.75,0:10:49.76,Main,,0,0,0,,...adama ne oldu?
Dialogue: 0,0:10:50.04,0:10:53.66,Main,,0,0,0,,Peki ya Yılan Prenses,\Nbu kez onu taşa çevirdi mi?
Dialogue: 0,0:10:55.13,0:10:57.79,Main,,0,0,0,,Tam olarak anlamıyorum...
Dialogue: 0,0:10:57.79,0:10:59.67,Main,,0,0,0,,...ama Kuja Kalesi'ne çağırılmış olabilir.
Dialogue: 0,0:10:59.67,0:11:00.94,Main,,0,0,0,,Ne?!
Dialogue: 0,0:11:01.92,0:11:03.64,Captions,,0,0,0,,{\fad(350,0)\pos(1042,354)}Amazon Lily,\NKuja Kalesi
Dialogue: 0,0:11:04.20,0:11:06.79,Main,,0,0,0,,Hey, neler oluyor?
Dialogue: 0,0:11:06.79,0:11:07.64,Main,,0,0,0,,Oh!
Dialogue: 0,0:11:07.64,0:11:10.95,Main,,0,0,0,,Dövüşten sonraki ziyafet\Ngibi bir şey mi yoksa?
Dialogue: 0,0:11:12.39,0:11:14.45,Main,,0,0,0,,Öyleyse memnuniyetle katılırım!
Dialogue: 0,0:11:14.45,0:11:21.98,Captions,,0,0,0,,{\fad(580,600)\pos(1096,424)}Prenses'in Salonu
Dialogue: 0,0:11:15.03,0:11:17.79,Main,,0,0,0,,Minnettarlığımızı göstermek zorundayız.
Dialogue: 0,0:11:17.79,0:11:18.87,Main,,0,0,0,,Sağol.
Dialogue: 0,0:11:18.87,0:11:20.48,Main,,0,0,0,,Hayır, bunu yapmana gerek yok.
Dialogue: 0,0:11:20.48,0:11:22.13,Main,,0,0,0,,Minnettarlık falan yiyemem.
Dialogue: 0,0:11:22.13,0:11:24.56,Main,,0,0,0,,Sırtımızdaki işareti biri görseydi...
Dialogue: 0,0:11:24.56,0:11:28.23,Main,,0,0,0,,...artık bu ülkede kalamazdık.
Dialogue: 0,0:11:28.88,0:11:29.90,Main,,0,0,0,,Girebilirsin.
Dialogue: 0,0:11:30.72,0:11:32.65,Main,,0,0,0,,İçeri gel, adam.
Dialogue: 0,0:11:32.65,0:11:33.64,Main,,0,0,0,,İçeri mi?
Dialogue: 0,0:11:33.97,0:11:35.52,Main,,0,0,0,,Perdelerin içine.
Dialogue: 0,0:11:35.52,0:11:37.58,Main,,0,0,0,,Yemek mi?
Dialogue: 0,0:11:38.18,0:11:39.66,Main,,0,0,0,,Geliyorum...
Dialogue: 0,0:11:39.66,0:11:41.34,Main,,0,0,0,,Ah, yemek değil mi?
Dialogue: 0,0:11:41.89,0:11:44.55,Main,,0,0,0,,Hey, nasıl olur da çıplak durursun?
Dialogue: 0,0:11:45.03,0:11:47.53,Main,,0,0,0,,Her zamanki gibi küstahsın.
Dialogue: 0,0:11:48.90,0:11:50.59,Main,,0,0,0,,Farketmez.
Dialogue: 0,0:12:01.66,0:12:03.20,Main,,0,0,0,,Bu işareti...
Dialogue: 0,0:12:04.10,0:12:05.44,Main,,0,0,0,,...b-bir yerde...
Dialogue: 0,0:12:06.59,0:12:08.57,Main,,0,0,0,,...gördüğünü söylemiştin, değil mi?
Dialogue: 0,0:12:09.71,0:12:12.11,Main,,0,0,0,,Lütfen emin olmak için bir daha bak.
Dialogue: 0,0:12:14.85,0:12:16.51,Main,,0,0,0,,Bunu nerede gördün?
Dialogue: 0,0:12:16.51,0:12:18.94,Main,,0,0,0,,Bu sembolün anlamını biliyor musun?
Dialogue: 0,0:12:25.48,0:12:27.09,Main,,0,0,0,,Hemen cevap ver!
Dialogue: 0,0:12:28.53,0:12:30.13,Main,,0,0,0,,Uzun süre göstermekten\Nhoşlanacağım bir şey değil.
Dialogue: 0,0:12:32.80,0:12:36.17,Main,,0,0,0,,Aslında düşündüğüm şeyin aynısı değil.
Dialogue: 0,0:12:36.17,0:12:40.40,Main,,0,0,0,,Hachi adında balık adam \Nbir arkadaşım var.
Dialogue: 0,0:12:40.40,0:12:43.48,Main,,0,0,0,,Kafasında buna benzer bir tane\Nolduğu için karıştırmış olmalıyım.
Dialogue: 0,0:12:43.92,0:12:45.44,Main,,0,0,0,,Sendekini daha önce hiç görmedim.
Dialogue: 0,0:12:45.84,0:12:48.21,Main,,0,0,0,,Bilmiyorsa ona söylemeliyiz.
Dialogue: 0,0:12:48.71,0:12:49.45,Main,,0,0,0,,Büyük Nyon!
Dialogue: 0,0:12:49.86,0:12:50.92,Main,,0,0,0,,Yine durduk yerde ortaya çıktın!
Dialogue: 0,0:12:50.92,0:12:53.25,Main,,0,0,0,,Dürüst ol, Yılan Prenses!
Dialogue: 0,0:12:53.25,0:12:57.56,Main,,0,0,0,,Bu adamın ne kadar büyük bir\Nkalbi olduğunu zaten gördün!
Dialogue: 0,0:12:59.92,0:13:01.35,Main,,0,0,0,,Sorun yok.
Dialogue: 0,0:13:01.35,0:13:03.90,Main,,0,0,0,,Rahatla ve ona her şeyi anlat.
Dialogue: 0,0:13:07.22,0:13:08.23,Main,,0,0,0,,Sen!
Dialogue: 0,0:13:08.23,0:13:11.24,Main,,0,0,0,,Korsan Monkey D. Luffy olduğun\Nkonusunda yanılmıyorum, değil mi?
Dialogue: 0,0:13:11.87,0:13:13.32,Main,,0,0,0,,Evet, o benim.
Dialogue: 0,0:13:13.32,0:13:15.31,Main,,0,0,0,,Kim olduğumu nasıl bildin?
Dialogue: 0,0:13:15.58,0:13:20.17,Main,,0,0,0,,Epey curcunaya sebep oldun,\Nkim olsa tanırdı.
Dialogue: 0,0:13:20.52,0:13:22.34,Main,,0,0,0,,Şu gazeteye bak!
Dialogue: 0,0:13:22.34,0:13:24.55,Main,,0,0,0,,Bu adam geçen gün...
Dialogue: 0,0:13:24.55,0:13:28.50,Main,,0,0,0,,...dünyanın Merkezi Gücü'ne yakın\Nolan Sabaody Takımadası'nda...
Dialogue: 0,0:13:28.50,0:13:30.92,Main,,0,0,0,,...bir Kutsal Ejder'e saldırdı!
Dialogue: 0,0:13:30.92,0:13:35.66,Main,,0,0,0,,Bu sadece Kamilerin öfkesinden korkmayan\Nbirinin göstereceği bir davranış!
Dialogue: 0,0:13:38.19,0:13:39.56,Main,,0,0,0,,Kutsal Ejder mi?!
Dialogue: 0,0:13:40.42,0:13:46.16,Main,,0,0,0,,Sonrasında mucizevi bir şekilde Merkez'in\Nen güçlü dövüşçülerinden kaçmayı başardı!
Dialogue: 0,0:13:47.39,0:13:48.84,Main,,0,0,0,,O olaydan sonra...
Dialogue: 0,0:13:48.84,0:13:54.11,Main,,0,0,0,,...sadece iki gün içinde bir\Nşekilde uzaktaki krallığımıza geldi.
Dialogue: 0,0:13:54.11,0:13:56.82,Main,,0,0,0,,Bu konuda anlayamadığım birçok şey var.
Dialogue: 0,0:13:57.56,0:14:00.87,Main,,0,0,0,,Aniden havaya uçuruldum diyorum!
Dialogue: 0,0:14:00.87,0:14:04.12,Main,,0,0,0,,Buranın neresi olduğu\Nhakkında hiçbir fikrim yok!
Dialogue: 0,0:14:04.85,0:14:09.66,Main,,0,0,0,,Ayrıca o Kutsal Ejder'e\Nsaldırdığım için pişman değilim.
Dialogue: 0,0:14:09.66,0:14:13.06,Main,,0,0,0,,O şerefsizin arkadaşlarıma\Nne yaptığını biliyor musunuz?
Dialogue: 0,0:14:13.92,0:14:15.80,Main,,0,0,0,,O zaman...
Dialogue: 0,0:14:16.54,0:14:19.65,Main,,0,0,0,,...Kutsal Ejderler'e gerçekten karşı mı koydun?
Dialogue: 0,0:14:23.65,0:14:24.48,Main,,0,0,0,,Yani...
Dialogue: 0,0:14:25.75,0:14:27.91,Main,,0,0,0,,...öyle bir ahmak...
Dialogue: 0,0:14:30.65,0:14:34.14,Main,,0,0,0,,...bu dünyada hala var mı?
Dialogue: 0,0:14:35.82,0:14:39.52,Main,,0,0,0,,Kendi hayatına aldırmadan\Ngöklere meydan okuyor,...
Dialogue: 0,0:14:41.56,0:14:43.23,Main,,0,0,0,,...aynı onun yaptığı gibi!
Dialogue: 0,0:14:47.42,0:14:48.33,Main,,0,0,0,,"O" mu?
Dialogue: 0,0:14:57.11,0:15:00.28,Main,,0,0,0,,Sana her şeyi anlatacağım.
Dialogue: 0,0:15:00.28,0:15:04.82,Main,,0,0,0,,Arkadaşının alnına dağlanmış olan\Nsembolün ardındaki manayı bile.
Dialogue: 0,0:15:05.65,0:15:06.95,Main,,0,0,0,,Hachi'nin işareti mi?
Dialogue: 0,0:15:09.57,0:15:11.25,Main,,0,0,0,,Bu...
Dialogue: 0,0:15:12.28,0:15:14.16,Main,,0,0,0,,...Göklerin Ötesine Dörtnala\NGiden Ejder'in Toynağı,...
Dialogue: 0,0:15:15.85,0:15:17.86,Main,,0,0,0,,...Kutsal Ejderler'in arması!
Dialogue: 0,0:15:23.88,0:15:27.34,Main,,0,0,0,,Dünya Soyluları tarafından\Nsatın alınanların etine dağlanır.
Dialogue: 0,0:15:28.05,0:15:31.54,Main,,0,0,0,,Taşıyıcısını insandan daha düşük bir varlık olarak\Nişaretleyen, sonsuza dek kaybolmayan bir semboldür!
Dialogue: 0,0:15:32.08,0:15:33.28,Main,,0,0,0,,Kutsal Ejderler?!
Dialogue: 0,0:15:36.39,0:15:38.12,Main,,0,0,0,,Biz üç kız kardeş...
Dialogue: 0,0:15:39.81,0:15:41.05,Main,,0,0,0,,...bir zamanlar...
Dialogue: 0,0:15:41.71,0:15:44.01,Main,,0,0,0,,...Dünya Soyluları'nın kölesiydik!
Dialogue: 0,0:15:48.91,0:15:50.63,Main,,0,0,0,,Köle miydiniz?!
Dialogue: 0,0:15:54.34,0:15:57.20,Main,,0,0,0,,Ben 12 yaşındayken oldu.
Dialogue: 0,0:16:01.09,0:16:03.58,Main,,0,0,0,,Herkes nasıl? Karpuz getirdim!
Dialogue: 0,0:16:05.10,0:16:06.31,Main,,0,0,0,,Hancock?
Dialogue: 0,0:16:06.31,0:16:08.38,Main,,0,0,0,,Sonia! Mari! Neredesiniz?
Dialogue: 0,0:16:08.90,0:16:13.82,Main,,0,0,0,,Üçümüz Kuja Korsanları'ndan kaçırıldık\Nve köle tacirlerinin eline düştük.
Dialogue: 0,0:16:15.93,0:16:17.22,Main,,0,0,0,,Köle olarak satıldık.
Dialogue: 0,0:16:21.88,0:16:23.69,Main,,0,0,0,,Ondan sonraki her şey...
Dialogue: 0,0:16:23.69,0:16:26.10,Main,,0,0,0,,...anımsatılmasını istemediğim\Niğrenç bir geçmiş.
Dialogue: 0,0:16:37.04,0:16:41.41,Main,,0,0,0,,Hayatımda gördüğüm ilk erkekler,\Nkorkutucu bir kalabalıktı.
Dialogue: 0,0:16:44.63,0:16:47.36,Main,,0,0,0,,Sonia abla! Sakin ol!
Dialogue: 0,0:16:47.36,0:16:49.59,Main,,0,0,0,,Anılar geri gelip duruyor...
Dialogue: 0,0:16:49.96,0:16:52.07,Main,,0,0,0,,H-Hey, sorun değil!
Dialogue: 0,0:16:52.07,0:16:54.70,Main,,0,0,0,,Kendinizi zorlamayın!\NAnlatmak zorunda değilsin!
Dialogue: 0,0:16:54.70,0:16:56.31,Main,,0,0,0,,Korkunç bir hayattı.
Dialogue: 0,0:16:56.31,0:16:58.00,Main,,0,0,0,,Küçücük bir umut kırıntısı bile göremedik.
Dialogue: 0,0:16:58.50,0:17:00.96,Main,,0,0,0,,Sadece ölmek istedim!
Dialogue: 0,0:17:00.96,0:17:02.36,Main,,0,0,0,,Hey, sen...
Dialogue: 0,0:17:03.99,0:17:08.35,Main,,0,0,0,,Ancak dört yol sonra bir gün...
Dialogue: 0,0:17:08.35,0:17:11.54,Main,,0,0,0,,...Dünya Hükümeti'ni iliklerine\Nkadar sarsan bir olay oldu.
Dialogue: 0,0:17:13.24,0:17:15.96,Main,,0,0,0,,Kimse Kutsal Ejderler'e karşı\Nkoymaya cüret edemezdi.
Dialogue: 0,0:17:15.96,0:17:18.61,Main,,0,0,0,,Bu tartışılmaz bir kuraldı.
Dialogue: 0,0:17:18.61,0:17:22.74,Main,,0,0,0,,Ama Kızıl Hat'tı çıplak elleriyle\Ntırmanarak bir adam geldi...
Dialogue: 0,0:17:22.74,0:17:27.03,Main,,0,0,0,,...ve Kutsal Ejderler'in evi\NKutsal Ülke Mariejoa'ya sızdı.
Dialogue: 0,0:17:30.77,0:17:35.14,Main,,0,0,0,,Bir gün balık adam korsanlarının tüm\Ntayfasını komuta edecek bir maceracıydı.
Dialogue: 0,0:17:35.14,0:17:37.26,Main,,0,0,0,,Fisher Tiger.
Dialogue: 0,0:17:37.26,0:17:41.76,Main,,0,0,0,,Balık adam dostlarına karşı yapılan birçok\Nacımasızlığın sorumlusu olan şehre girdi...
Dialogue: 0,0:17:41.76,0:17:44.26,Main,,0,0,0,,...ve balık adam köleleri serbest\Nbırakmak için onu yıkıp yerle bir etti.
Dialogue: 0,0:17:45.43,0:17:47.71,Main,,0,0,0,,Özgürüz!
Dialogue: 0,0:17:47.90,0:17:50.82,Main,,0,0,0,,İnsanlardan nefret etmek doğasında vardı.
Dialogue: 0,0:17:51.14,0:17:56.62,Main,,0,0,0,,Yine de türlerine bakmaksızın\Nköleleri gelişigüzel serbest bıraktı.
Dialogue: 0,0:17:58.09,0:18:01.06,Main,,0,0,0,,Biz de olabildiğince hızlı\Nbir şekilde kaçtık.
Dialogue: 0,0:18:08.79,0:18:12.37,Main,,0,0,0,,Ona ne kadar borçlu\Nolduğumuzu ifade edemeyiz.
Dialogue: 0,0:18:15.24,0:18:19.53,Main,,0,0,0,,Tiger, sayısız balık adamın\Ndenize kaçmasını sağladı...
Dialogue: 0,0:18:20.67,0:18:24.28,Main,,0,0,0,,...ama köle işaretleri asla kaybolmadı.
Dialogue: 0,0:18:25.24,0:18:27.96,Main,,0,0,0,,Dünya Hükümeti'ni kendine düşman eden Tiger,...
Dialogue: 0,0:18:28.31,0:18:31.86,Main,,0,0,0,,...o balık adamlarla birlikte\NGüneş Korsanları'nı kurdu...
Dialogue: 0,0:18:31.86,0:18:34.30,Main,,0,0,0,,...ve açık denizlere yelken açtı.
Dialogue: 0,0:18:36.71,0:18:39.31,Main,,0,0,0,,Bir laneti kaldırıyormuşçasına...
Dialogue: 0,0:18:39.31,0:18:43.30,Main,,0,0,0,,...Kutsal Ejderler'in işaretlerini...
Dialogue: 0,0:18:47.05,0:18:49.16,Main,,0,0,0,,...bir güneş sembolüyle değiştirdi!
Dialogue: 0,0:18:50.58,0:18:55.35,Main,,0,0,0,,Benim sembolümle karıştırdığın işaret,...
Dialogue: 0,0:18:55.35,0:18:58.45,Main,,0,0,0,,...büyük ihtimalle \NGüneş Korsanları sembolüydü.
Dialogue: 0,0:18:58.78,0:19:00.47,Main,,0,0,0,,Ah, doğru.
Dialogue: 0,0:19:00.47,0:19:03.72,Main,,0,0,0,,Hachi'nin alnındaki sembol güneşe benziyor.
Dialogue: 0,0:19:04.51,0:19:07.03,Main,,0,0,0,,Yani o da mı bir zamanlar köleydi?
Dialogue: 0,0:19:07.52,0:19:10.42,Main,,0,0,0,,Durum tam olarak bu olmayabilir.
Dialogue: 0,0:19:10.42,0:19:14.12,Main,,0,0,0,,O sembol, bir zamanlar kimin köle olduğu...
Dialogue: 0,0:19:14.12,0:19:17.39,Main,,0,0,0,,...anlaşılmasın diye tayfadaki\Nherkese yapılmıştı.
Dialogue: 0,0:19:17.39,0:19:22.34,Main,,0,0,0,,Ama kesinlikle bir zamanlar \NGüneş Korsanları'nın üyesi olduğu anlamına gelir.
Dialogue: 0,0:19:22.76,0:19:26.34,Main,,0,0,0,, Fisher Tiger uzun zaman önce öldü...
Dialogue: 0,0:19:26.34,0:19:31.68,Main,,0,0,0,,...ve tayfası, bir sürü küçük\Nkorsan tayfasına ayrıldı.
Dialogue: 0,0:19:32.88,0:19:35.49,Main,,0,0,0,,Sanırım Hachi de karmaşık\Nbir hayat yaşamış.
Dialogue: 0,0:19:35.91,0:19:41.39,Main,,0,0,0,,Bu yüzden sırtımızdaki işaret\Nbalık adamın işaretini andırıyor.
Dialogue: 0,0:19:41.39,0:19:43.96,Main,,0,0,0,,Tamam, şimdi anlıyorum.
Dialogue: 0,0:19:44.46,0:19:49.77,Main,,0,0,0,,Ne ironiktir ki, bize verilen \NŞeytan Meyveleri efendilerimizi eğlendirmek içindi.
Dialogue: 0,0:19:49.77,0:19:53.33,Main,,0,0,0,,Aşk Aşk Meyvesi ve\NYılan Yılan Meyveleri,...
Dialogue: 0,0:19:53.33,0:19:57.41,Main,,0,0,0,,...ülkeyi kandırıp sırrımızı\Nkorumamızı mümkün kılan şeylerdi.
Dialogue: 0,0:19:59.04,0:20:04.13,Main,,0,0,0,,Sonia'nın sırtını kapatmamış olsaydın...
Dialogue: 0,0:20:04.13,0:20:08.35,Main,,0,0,0,,...artık bu adada kalamazdık.
Dialogue: 0,0:20:08.35,0:20:12.19,Main,,0,0,0,,Geçmişimizi kimsenin bilmesine\Nizin vermemeliyiz!
Dialogue: 0,0:20:17.84,0:20:21.20,Main,,0,0,0,,Tüm krallığı kandırmak anlamına gelse bile...
Dialogue: 0,0:20:26.74,0:20:30.74,Main,,0,0,0,,...yaşadığımız sürece asla\Ntedbiri elden bırakmamlıyız!
Dialogue: 0,0:20:30.74,0:20:33.21,Main,,0,0,0,,Bir daha asla köle olmayacağız!
Dialogue: 0,0:20:36.76,0:20:39.85,Main,,0,0,0,,Bir başkasının merhametinde olma fikri...
Dialogue: 0,0:20:39.85,0:20:41.99,Main,,0,0,0,,...katlanamayacağım kadar çok korkutucu!
Dialogue: 0,0:20:46.24,0:20:47.52,Main,,0,0,0,,Abla...
Dialogue: 0,0:20:50.55,0:20:51.46,Main,,0,0,0,,
Dialogue: 0,0:20:51.46,0:20:53.77,Main,,0,0,0,,Ama kendi hislerin konusunda...
Dialogue: 0,0:20:53.77,0:20:57.17,Main,,0,0,0,,...bu kadar samimi olmayalı uzun zaman oldu.
Dialogue: 0,0:20:57.17,0:21:02.87,Main,,0,0,0,,Aslında şimdiye dek kalbinin buza\Ndönüşüp dönüşmediğini merak ediyordum.
Dialogue: 0,0:21:05.07,0:21:08.54,Main,,0,0,0,,Sessiz ol, krallığı terkeden hain!
Dialogue: 0,0:21:08.54,0:21:10.81,Main,,0,0,0,,Sessiz olması gereken sensin!
Dialogue: 0,0:21:10.81,0:21:13.84,Main,,0,0,0,,Kutsal Ejderler'in esaretinden\Nkurtulduktan sonra...
Dialogue: 0,0:21:13.84,0:21:15.95,Main,,0,0,0,,...etrafta dolanarak adaya nasıl...
Dialogue: 0,0:21:15.95,0:21:19.92,Main,,0,0,0,,...döneceğini bilmeyen savunmasız\Nküçük bir kızdın.
Dialogue: 0,0:21:20.36,0:21:24.86,Main,,0,0,0,,Seni buraya kadar kim getirdi sanıyorsun?!
Dialogue: 0,0:21:24.86,0:21:29.10,Main,,0,0,0,,Krallığın dışında yaşadığım\Niçin geri dönebildin!
Dialogue: 0,0:21:30.17,0:21:32.24,Main,,0,0,0,,Böyle küçük bir borç yüzünden\Nfikrimi değiştirmeye mi çalışıyorsun?
Dialogue: 0,0:21:32.24,0:21:33.43,Main,,0,0,0,,NE?!
Dialogue: 0,0:21:33.43,0:21:34.44,Main,,0,0,0,,Büyük Nyon...
Dialogue: 0,0:21:34.44,0:21:39.04,Main,,0,0,0,,Kendi çocuklarımmış gibi size\Nhep gözkulak olmadım mı?
Dialogue: 0,0:21:40.41,0:21:41.64,Main,,0,0,0,,Köle olduğumu...
Dialogue: 0,0:21:42.73,0:21:46.32,Main,,0,0,0,,...öğrendiğin için benden nefret ediyor musun?
Dialogue: 0,0:21:46.89,0:21:49.85,Main,,0,0,0,,Kutsal Ejderler'den nefret\Nediyorum dedim ya!
Dialogue: 0,0:21:57.20,0:21:59.18,Main,,0,0,0,,Senden hoşlandım!
Dialogue: 0,0:21:59.18,0:22:02.10,Main,,0,0,0,,Bir isteğin daha vardı, değil mi?
Dialogue: 0,0:22:02.10,0:22:03.08,Main,,0,0,0,,Pekâlâ!
Dialogue: 0,0:22:03.08,0:22:05.53,Main,,0,0,0,,Bana nereye gitmek istediğini\Nsöylersen seni oraya götüreceğim!
Dialogue: 0,0:22:05.66,0:22:07.37,Main,,0,0,0,,Cidden mi?!
Dialogue: 0,0:22:16.81,0:22:19.05,Main,,0,0,0,,Kalkış yarın sabah olacak.
Dialogue: 0,0:22:19.05,0:22:22.44,Main,,0,0,0,,Kuja Korsanları seni \NSabaody Takımadası'na taşıyacak.
Dialogue: 0,0:22:22.44,0:22:25.89,Main,,0,0,0,,--Korsan gemisinde mi?\N--Kusura bakma.
Dialogue: 0,0:22:26.34,0:22:29.85,Main,,0,0,0,,Yolculuğa hazırlanmak için\Nbu gece iyi dinlenmelisin.
Dialogue: 0,0:22:32.60,0:22:35.56,Main,,0,0,0,,Yarın bu adadan gitmek\Niçin sabırsızlanıyorum!
Dialogue: 0,0:22:41.99,0:22:45.07,Main,,0,0,0,,Size gösterdiğim gibi,\Nbu şekilde yapıyorsunuz!
Dialogue: 0,0:22:45.07,0:22:46.84,Main,,0,0,0,,Bu şekilde, bu!
Dialogue: 0,0:22:49.72,0:22:51.18,Main,,0,0,0,,Bu şekilde!
Dialogue: 0,0:22:51.76,0:22:53.15,Main,,0,0,0,,Bu şekilde mi?
Dialogue: 0,0:22:55.25,0:22:57.82,Main,,0,0,0,,Bu çok komik, Luffy-sama!
Dialogue: 0,0:22:57.82,0:23:03.36,Main,,0,0,0,,Demek erkekler burun delikleriyle ağzı\Narasına yemek çubuğu koyup tutabiliyorlar.
Dialogue: 0,0:23:06.04,0:23:08.20,Main,,0,0,0,,Ne onursuz bir dans.
Dialogue: 0,0:23:09.13,0:23:12.27,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no Mide Konuşması
Dialogue: 0,0:23:14.33,0:23:15.94,Main,,0,0,0,,Bu, Kadınlar Adası'nın özel yemeğidir.
Dialogue: 0,0:23:15.94,0:23:18.49,Main,,0,0,0,,Özel yemeği mi?
Dialogue: 0,0:23:18.49,0:23:21.35,Main,,0,0,0,,Deniz Kralı etli Penne Gorgonzola.
Dialogue: 0,0:23:23.85,0:23:28.19,Main,,0,0,0,,Her zaman Deniz Kralı eti yiyorum,\Nama bu gerçekten mükemmel!
Dialogue: 0,0:23:29.19,0:23:31.36,Main,,0,0,0,,Gerçekten uzuyor!
Dialogue: 0,0:23:31.36,0:23:33.26,Main,,0,0,0,,Çok yumuşak, sanki lastikten yapılmış gibi!
Dialogue: 0,0:23:33.26,0:23:34.69,Main,,0,0,0,,Zamanın doldu!
Dialogue: 0,0:23:34.69,0:23:37.76,Main,,0,0,0,,--Bırak bir kez daha yapayım!\N--Olmaz, izin verirsem asla bırakmazsın!
Dialogue: 0,0:23:37.76,0:23:42.06,Main,,0,0,0,,Bu Deniz Kralı eti çok leziz!\NGerçi yemesi biraz zorlaşıyor.
Dialogue: 0,0:23:42.06,0:23:46.43,Main,,0,0,0,,N-Neyiniz var sizin? \NBeni dürtükleyip uzatıyorsunuz!
Dialogue: 0,0:23:46.43,0:23:49.67,Main,,0,0,0,,Ne yapalım! Yarın gidiyorsun, değil mi?
Dialogue: 0,0:23:49.67,0:23:52.81,Main,,0,0,0,,Bir erkeğe dokunma fırsatı\Nisteyen bir sürü kız var.
Dialogue: 0,0:23:52.81,0:23:53.51,Main,,0,0,0,,Bak!
Dialogue: 0,0:23:53.51,0:23:59.75,Note,,0,0,0,,"1 Dokunuş \N20 Gol"
Dialogue: 0,0:23:53.89,0:23:56.65,Main,,0,0,0,,--Çok popülersin!\N--Luffy-chan!
Dialogue: 0,0:23:56.65,0:23:59.75,Main,,0,0,0,,Hey! Ben özel gösteriniz değilim!
Dialogue: 0,0:24:00.77,0:24:05.19,Main,,0,0,0,,Sorun yok, Luffy-chan! Bu geceden sonra\Nsana dokunma fırsatımız olmayacak!
Dialogue: 0,0:24:05.55,0:24:09.70,Main,,0,0,0,,Hey! K-Kesin şunu! Yemek yiyemiyorum!
Dialogue: 0,0:24:16.56,0:24:18.10,Main,,0,0,0,,Margaret...
Dialogue: 0,0:24:18.94,0:24:22.35,Main,,0,0,0,,--Luffy-sama nerede?\N--Olamaz! Kaçmış!
Dialogue: 0,0:24:22.35,0:24:25.81,Main,,0,0,0,,Hâlâ yakın bir yerde olmalı!\NOnu bulup dokunalım!
Dialogue: 0,0:24:28.28,0:24:30.70,Main,,0,0,0,,Onların nesi var?
Dialogue: 0,0:24:30.70,0:24:32.12,Main,,0,0,0,,Saklan!
Dialogue: 0,0:24:33.12,0:24:37.00,Main,,0,0,0,,Tüm getirebildiğim yiyecek bu!
Dialogue: 0,0:24:37.00,0:24:41.17,Main,,0,0,0,,Arkadaşlarının olduğu yere\Ndönebilecek olman harika, değil mi?!
Dialogue: 0,0:24:41.17,0:24:45.81,Main,,0,0,0,,Evet. Başınıza açtığım\Ndertlerden ötürü üzgünüm.
Dialogue: 0,0:24:46.59,0:24:48.97,Main,,0,0,0,,Heykele dönüştüğünüzde cidden korktum!
Dialogue: 0,0:24:49.79,0:24:54.21,Main,,0,0,0,,Ama bizi savundun, değil mi?
Dialogue: 0,0:24:54.21,0:24:55.84,Main,,0,0,0,,Bizim için yaptıklarını duydum.
Dialogue: 0,0:24:56.67,0:24:59.34,Main,,0,0,0,,Sağol, Luffy!
Dialogue: 0,0:25:00.03,0:25:02.15,Main,,0,0,0,,Sorun nedir, Margaret?
Dialogue: 0,0:25:02.15,0:25:06.36,Main,,0,0,0,,Luffy, köyün kadınları arasında\Nçok popüler hale geldi.
Dialogue: 0,0:25:06.36,0:25:09.57,Main,,0,0,0,,Evet, sonuçta erkekler burada\Nsıradışı varlıklar.
Dialogue: 0,0:25:09.57,0:25:11.19,Main,,0,0,0,,Selam, Fasulye Nine!
Dialogue: 0,0:25:11.19,0:25:14.61,Main,,0,0,0,,Burası köyün köşesinde. Rahat olabilirsin.
Dialogue: 0,0:25:14.61,0:25:16.03,Main,,0,0,0,,Sen kime "Fasulye" diyorsun?!
Dialogue: 0,0:25:16.74,0:25:20.70,Main,,0,0,0,,Yemek yiyor. Ona biraz çay falan getir.
Dialogue: 0,0:25:20.70,0:25:22.50,Main,,0,0,0,,Tamam!
Dialogue: 0,0:25:22.50,0:25:25.17,Main,,0,0,0,,Nine, gazete okumayı seviyorsun, ha?
Dialogue: 0,0:25:25.17,0:25:28.47,Main,,0,0,0,,Haber Güvercinleri \NSükûnet Kuşağı'na teslimat yapmıyor,...
Dialogue: 0,0:25:29.04,0:25:31.00,Main,,0,0,0,,...bu yüzden bunları elde etmek zor.
Dialogue: 0,0:25:31.00,0:25:34.08,Main,,0,0,0,,Bu krallığın imparatoriçesi bir Savaş Lordu,...
Dialogue: 0,0:25:34.08,0:25:38.43,Main,,0,0,0,,...bu yüzden en azından dünyada\Nneler olup bittiğinden geri kalmamalıyız.
Dialogue: 0,0:25:39.19,0:25:42.09,Main,,0,0,0,,Kim Savaş Lordu?
Dialogue: 0,0:25:42.09,0:25:43.69,Main,,0,0,0,,Yılan Prenses.
Dialogue: 0,0:25:44.10,0:25:46.19,Main,,0,0,0,,Ne?!
Dialogue: 0,0:25:47.05,0:25:49.19,Main,,0,0,0,,O, Savaş Lordu mu?
Dialogue: 0,0:25:49.19,0:25:52.91,Main,,0,0,0,,Yani gerçekten güçlü bir dövüşçü mü?
Dialogue: 0,0:25:52.91,0:25:56.22,Main,,0,0,0,,Korsan olmana rağmen bunu bilmiyor muydun?
Dialogue: 0,0:25:56.22,0:25:58.64,Main,,0,0,0,,Hayır, bilmiyordum.
Dialogue: 0,0:25:58.64,0:26:01.31,Main,,0,0,0,,Gazete okumuyor musun?
Dialogue: 0,0:26:01.31,0:26:03.61,Main,,0,0,0,,Hayır, okumam.
Dialogue: 0,0:26:05.19,0:26:07.10,Main,,0,0,0,,Çok şaşırdım!
Dialogue: 0,0:26:07.10,0:26:10.01,Main,,0,0,0,,Yılan Prenses, on bir yıl\Nönce bu krallığın...
Dialogue: 0,0:26:10.01,0:26:14.88,Main,,0,0,0,,...imparatoriçesi ve Kuja\NKorsanları'nın kaptanı oldu.
Dialogue: 0,0:26:14.88,0:26:22.56,Main,,0,0,0,,Henüz çok küçüktü ama tek yolculuğun\Nardından başına 80 milyonluk ödül kondu.
Dialogue: 0,0:26:22.56,0:26:23.76,Main,,0,0,0,,Tek yolculukta mı?
Dialogue: 0,0:26:23.76,0:26:28.01,Main,,0,0,0,,Bu, Kuja'nın zaten kazanmış\Nolduğu kötü itibarla birlikte,...
Dialogue: 0,0:26:28.01,0:26:31.90,Main,,0,0,0,,...Dünya Hükümeti'nin hemen Yılan Prenses\Nkonusunda ihtiyatlı davranmasına neden oldu...
Dialogue: 0,0:26:31.90,0:26:35.57,Main,,0,0,0,,...ve ona Savaş Lordu konumu önerdiler.
Dialogue: 0,0:26:35.97,0:26:40.95,Main,,0,0,0,,Ama o unvan, yitirilme\Ntehlikesiyle karşı karşıya...
Dialogue: 0,0:26:43.62,0:26:45.99,Main,,0,0,0,,NE?!
Dialogue: 0,0:26:45.99,0:26:48.20,Main,,0,0,0,,Yedi Savaş Lordu ve Denizci Karargâhı,...
Dialogue: 0,0:26:48.20,0:26:50.02,Main,,0,0,0,,...Beyazsakal Korsanları'yla\Nsavaşa mı girişecek?!
Dialogue: 0,0:26:51.14,0:26:55.57,Main,,0,0,0,,Neler oluyor?! Bu nasıl olabilir?!\ND-D-D-Dur biraz!
Dialogue: 0,0:26:55.57,0:26:58.90,Main,,0,0,0,,Bu kadar şeyi aynı anda kaldıramam!
Dialogue: 0,0:26:58.90,0:27:03.03,Main,,0,0,0,,Ne umutsuz bir adam.\NBilgisizliğin de bir sınırı var!
Dialogue: 0,0:27:03.82,0:27:08.79,Main,,0,0,0,,Söylemeliyim ki bu sadece bir tahmin...
Dialogue: 0,0:27:08.79,0:27:12.58,Main,,0,0,0,,...ama savaş er ya da\Ngeç kesinlikle olacak.
Dialogue: 0,0:27:13.70,0:27:16.55,Main,,0,0,0,,Dünya Hükümeti ilk hamleyi yaptı.
Dialogue: 0,0:27:16.84,0:27:20.79,Main,,0,0,0,,Beyazsakal, arkadaşlarının\Nöldürülmesine asla izin vermez.
Dialogue: 0,0:27:20.79,0:27:24.68,Main,,0,0,0,,Bunu bilmelerine rağmen, halka\Naçık bir şekilde...
Dialogue: 0,0:27:24.68,0:27:28.53,Main,,0,0,0,,...Beyazsakal'ın komutanı Portgas D. Ace'i\Nidam edeceklerini duyurdular.
Dialogue: 0,0:27:30.29,0:27:31.14,Main,,0,0,0,,Kim?
Dialogue: 0,0:27:31.14,0:27:33.73,Main,,0,0,0,,Ace... Ateş Yumruk Ace.
Dialogue: 0,0:27:34.06,0:27:35.20,Main,,0,0,0,,Ne oldu?
Dialogue: 0,0:27:37.26,0:27:39.64,Main,,0,0,0,,Ace, idam mı edilecek?!
Dialogue: 0,0:27:45.18,0:27:47.64,Main,,0,0,0,,Karasakal denilen bir korsanın...
Dialogue: 0,0:27:47.64,0:27:52.32,Main,,0,0,0,,...Ateş Yumruk Ace'i yakalayarak, \NSavaş Lordları'na katılmayı başardığını duydum.
Dialogue: 0,0:27:55.59,0:27:57.15,Main,,0,0,0,,Karasakal...
Dialogue: 0,0:27:57.15,0:28:01.70,Main,,0,0,0,,Dünya Hükümeti yakaladıkları bu büyük\Nbalığın bütün avantajlarından faydalanacak,...
Dialogue: 0,0:28:01.70,0:28:06.03,Main,,0,0,0,,Ace ismindeki korsan...
Dialogue: 0,0:28:03.23,0:28:04.72,Secondary,,0,0,0,,Nine...
Dialogue: 0,0:28:06.03,0:28:06.90,Main,,0,0,0,,Nine!
Dialogue: 0,0:28:09.20,0:28:10.97,Main,,0,0,0,,O benim abim!
Dialogue: 0,0:28:11.73,0:28:15.54,Main,,0,0,0,,Ace benim abim!
Dialogue: 0,0:28:17.04,0:28:18.14,Main,,0,0,0,,Ne?!
Dialogue: 0,0:28:20.34,0:28:22.62,Main,,0,0,0,,Doğru mu? O senin abin mi?!
Dialogue: 0,0:28:22.62,0:28:24.84,Main,,0,0,0,,Yakalandığını bile bilmiyordum!
Dialogue: 0,0:28:24.84,0:28:28.05,Main,,0,0,0,,"İdam"la ne demek istiyorsun?!\NBundan kaçamaz mı demek oluyor?!
Dialogue: 0,0:28:29.76,0:28:34.23,Main,,0,0,0,,O savaşı Beyazsakal kazanırsa\Nbir şansı olabilir.
Dialogue: 0,0:28:34.23,0:28:38.06,Main,,0,0,0,,Ne yapacağım? Nerede idam edilecek?
Dialogue: 0,0:28:39.38,0:28:41.77,Main,,0,0,0,,Denizci Karargâhı'nın bulunduğu...
Dialogue: 0,0:28:41.77,0:28:43.61,Main,,0,0,0,,...Marineford meydanında gerçekleşeceğini yazıyor.
Dialogue: 0,0:28:43.96,0:28:48.24,Main,,0,0,0,,Bir hafta içinde diyor, \Nyani bugünden itibaren 6 gün var.
Dialogue: 0,0:28:48.24,0:28:50.34,Main,,0,0,0,,Ne?! Bu çok erken!
Dialogue: 0,0:28:50.80,0:28:54.08,Main,,0,0,0,,Buradan Sabaody Takımadası'na\Nulaşmak ne kadar sürüyor?
Dialogue: 0,0:28:54.08,0:28:58.02,Main,,0,0,0,,Şey, sanırım bir haftadan fazla sürüyor.
Dialogue: 0,0:28:58.02,0:29:03.02,Main,,0,0,0,,O kadar uzun sürüyorsa, tayfamla buluşmadan\Nönce Ace için her şey sona ermiş olacak!
Dialogue: 0,0:29:04.05,0:29:06.42,Main,,0,0,0,,Peki Ace'in olduğu yere gitmek\Nne kadar sürerdi?!
Dialogue: 0,0:29:06.84,0:29:11.86,Main,,0,0,0,,Tutsak bulunduğu yer Impel Down.\NBir korsan gemisiyle bir hafta sürerdi.
Dialogue: 0,0:29:11.86,0:29:14.03,Main,,0,0,0,,Denizci gemisiyle dört gün sürerdi.
Dialogue: 0,0:29:14.03,0:29:17.00,Main,,0,0,0,,Niye?! Denizci gemileri o kadar hızlı mı?!
Dialogue: 0,0:29:17.28,0:29:21.27,Main,,0,0,0,,Sadece Dünya Hükümeti tarafından\Nkullanılan bir akıntı var.
Dialogue: 0,0:29:21.27,0:29:23.32,Main,,0,0,0,,Enies Lobby...
Dialogue: 0,0:29:23.32,0:29:25.32,Main,,0,0,0,,...Impel Down...
Dialogue: 0,0:29:25.32,0:29:27.74,Main,,0,0,0,,...Denizci Karargâhı.
Dialogue: 0,0:29:27.74,0:29:33.28,Main,,0,0,0,,Bu dev girdap üç\Nyeri birbirine bağlar.
Dialogue: 0,0:29:33.28,0:29:39.32,Main,,0,0,0,,Bu üç yerin dışında bulunan \NAdaletin Kapıları'nı açtıkları zaman
Dialogue: 0,0:29:39.32,0:29:43.63,Main,,0,0,0,,akıntı içeri doğru hareket etmeye başlar.
Dialogue: 0,0:29:43.63,0:29:49.26,Main,,0,0,0,,Yani kapılar açılmazsa akıntı\Nüstünde sürüklenmeye devam edersin.
Dialogue: 0,0:29:49.26,0:29:55.68,Main,,0,0,0,,Korsan gemileri o akıntıdan kaçınmak\Niçin uzatılmış bir yol seçerler.
Dialogue: 0,0:29:55.68,0:29:58.00,Main,,0,0,0,,Ne yapacağım?
Dialogue: 0,0:30:01.39,0:30:03.88,Main,,0,0,0,,Ne yapmak istiyorsun?
Dialogue: 0,0:30:04.21,0:30:07.59,Main,,0,0,0,,Yoksa o, abinin Yaşam Kartı mı?!
Dialogue: 0,0:30:09.32,0:30:12.96,Main,,0,0,0,,O, senin için çok önemli olan\Nhareket eden kâğıt parçası mı?
Dialogue: 0,0:30:12.96,0:30:15.36,Main,,0,0,0,,O başka bir kâğıt.
Dialogue: 0,0:30:15.36,0:30:17.33,Main,,0,0,0,,Bu Ace'in bana verdiği kâğıt.
Dialogue: 0,0:30:18.26,0:30:22.00,Main,,0,0,0,,"Yaşam kâğıdı" olarak da bilinir.
Dialogue: 0,0:30:22.00,0:30:25.73,Main,,0,0,0,,Sahibinin bulunduğu yönü ve\Nyaşamsal enerjisini gösterir.
Dialogue: 0,0:30:25.73,0:30:28.27,Main,,0,0,0,,Öyleyse o kadar küçük olmasının nedeni...
Dialogue: 0,0:30:28.79,0:30:31.94,Main,,0,0,0,,İlk aldığımda bundan on kat daha büyüktü.
Dialogue: 0,0:30:35.07,0:30:37.72,Main,,0,0,0,,Ace'in kendi macerası var.
Dialogue: 0,0:30:38.95,0:30:41.86,Main,,0,0,0,,Bir ağabeyin beceriksiz küçük kardeşi...
Dialogue: 0,0:30:42.91,0:30:45.08,Main,,0,0,0,,...için endişelenmesi doğaldır.
Dialogue: 0,0:30:46.89,0:30:52.26,Main,,0,0,0,,Ace daha güçlü olduğu için onu\Nkurtarmamdan hoşlanmayacak.
Dialogue: 0,0:30:55.47,0:30:56.17,Main,,0,0,0,,Ama...
Dialogue: 0,0:30:57.85,0:31:00.18,Main,,0,0,0,,Üzgünüm arkadaşlar.
Dialogue: 0,0:31:00.18,0:31:02.47,Main,,0,0,0,,Ben kısa yolu seçeceğim.
Dialogue: 0,0:31:07.88,0:31:10.68,Main,,0,0,0,,Ace'i kurtarmaya gitmek istiyorum!
Dialogue: 0,0:31:12.83,0:31:21.59,Main,,0,0,0,,Bunun ne kadar pervasızca olduğunu ve savaşın ne\Nkadar büyük olacağını biliyorsun, değil mi?
Dialogue: 0,0:31:21.59,0:31:25.31,Main,,0,0,0,,Tek bir karıncanın fırtınaya\Natlaması kadar faydasız.
Dialogue: 0,0:31:25.31,0:31:29.42,Main,,0,0,0,,Hiçbir şey yapma fırsatı bile\Nbulamadan bir kenara atılabilirsin.
Dialogue: 0,0:31:29.42,0:31:32.99,Main,,0,0,0,,Ne olabileceği umrumda değil!\NYine de gitmek istiyorum!
Dialogue: 0,0:31:32.99,0:31:36.94,Main,,0,0,0,,Öylece oturup bunun olmasına izin veremem!
Dialogue: 0,0:31:37.57,0:31:39.61,Main,,0,0,0,,Anlıyorum.
Dialogue: 0,0:31:40.75,0:31:45.35,Main,,0,0,0,,Demek dünyadaki en önemli\Ntutsağı kurtaracaksın.
Dialogue: 0,0:31:45.73,0:31:48.82,Main,,0,0,0,,Bunu yapmak için bir fırsat varsa...
Dialogue: 0,0:31:49.22,0:31:53.59,Main,,0,0,0,,...hiç gecikmeden onun tutulduğu\NBüyük Hapishane'ye gitmelisin.
Dialogue: 0,0:31:55.99,0:31:59.17,Main,,0,0,0,,Marineford'daki idam sahasına götürülünce...
Dialogue: 0,0:31:59.17,0:32:03.93,Main,,0,0,0,,...Denizci Amiralleri ve \NYedi Savaş Lordu tarafından korunacak.
Dialogue: 0,0:32:03.93,0:32:09.71,Main,,0,0,0,,Yine de, abin şu anda \Nen önemli tutsak olduğu için...
Dialogue: 0,0:32:09.71,0:32:15.28,Main,,0,0,0,,...hapishanenin kendisi de sıkı bir biçimde\Nordu güçleri tarafından korunuyor olmalı.
Dialogue: 0,0:32:15.28,0:32:18.12,Main,,0,0,0,,İçeri girmek imkansız.
Dialogue: 0,0:32:18.50,0:32:21.85,Main,,0,0,0,,Oraya varınca ne olacağı umrumda değil.
Dialogue: 0,0:32:21.85,0:32:24.28,Main,,0,0,0,,Ace hâlâ oradayken ona ulaşmalıyım!
Dialogue: 0,0:32:24.28,0:32:27.72,Main,,0,0,0,,Yeterince büyük bir küreğim olsaydı\Noraya kadar kürek çekerdim...
Dialogue: 0,0:32:27.72,0:32:32.68,Main,,0,0,0,,Dur! Dur! Oraya tek başına gidemezsin.
Dialogue: 0,0:32:32.68,0:32:35.43,Main,,0,0,0,,Bu da zayıf bir ihtimal, ama...
Dialogue: 0,0:32:35.43,0:32:40.62,Main,,0,0,0,,...Yılan Prenses inatla şu ana dek Savaş Lordları'nın\Ntoplanması için yapılan çağrıyı reddetti.
Dialogue: 0,0:32:40.62,0:32:43.91,Main,,0,0,0,,Eğer çağrıya uyarsa...
Dialogue: 0,0:32:43.91,0:32:47.92,Main,,0,0,0,,...bundan faydalanabilir ve\Nseni gizlice gemiye sokabilirdi.
Dialogue: 0,0:32:47.92,0:32:51.43,Main,,0,0,0,,Onların gemisine mi? \NBurada bir Denizci gemisi var?
Dialogue: 0,0:32:51.43,0:32:54.89,Main,,0,0,0,,O zaman ondan isteyeceğim!
Dialogue: 0,0:32:54.97,0:32:57.32,Captions,,0,0,0,,{\fad(290,0)\pos(1075,340)}Amazon Lily\NKuja Kalesi
Dialogue: 0,0:33:01.05,0:33:02.03,Main,,0,0,0,,Büyük Nyon!
Dialogue: 0,0:33:02.34,0:33:05.14,Main,,0,0,0,,Ne oldu, Enishida? Bu acelen niye?
Dialogue: 0,0:33:05.14,0:33:09.58,Main,,0,0,0,,Hele şükür. Ben de tam sizi\Nalmaya geliyordum, Büyük Nyon.
Dialogue: 0,0:33:09.58,0:33:10.77,Main,,0,0,0,,Ne oldu?
Dialogue: 0,0:33:10.77,0:33:12.00,Main,,0,0,0,,Şey...
Dialogue: 0,0:33:14.23,0:33:15.87,Main,,0,0,0,,Yılan Prenses...
Dialogue: 0,0:33:16.94,0:33:20.34,Main,,0,0,0,,...bilinmeyen bir hastalıktan\Nötürü yığılıp kaldı!
Dialogue: 0,0:33:22.63,0:33:25.05,Main,,0,0,0,,--Yığılıp kaldı mı?\N--Ne dedin sen?!
Dialogue: 0,0:33:30.62,0:33:32.69,Main,,0,0,0,,Abla, kendine gel!
Dialogue: 0,0:33:32.69,0:33:33.82,Main,,0,0,0,,Abla!
Dialogue: 0,0:33:40.00,0:33:42.43,Main,,0,0,0,,Ah, Büyük Nyon!
Dialogue: 0,0:33:46.30,0:33:48.69,Main,,0,0,0,,Sen biraz dışarıda bekle.
Dialogue: 0,0:33:48.69,0:33:51.30,Main,,0,0,0,,Ha? Ama acelem var!
Dialogue: 0,0:33:51.30,0:33:53.17,Main,,0,0,0,,Bunu biliyorum zaten!
Dialogue: 0,0:33:58.15,0:34:00.20,Main,,0,0,0,,Nefes alamıyorum...
Dialogue: 0,0:34:01.20,0:34:03.52,Main,,0,0,0,,Sürekli göğsünü tutuyordu...
Dialogue: 0,0:34:03.52,0:34:05.66,Main,,0,0,0,,...bu yüzden kalbiyle ilgili bir sorun\Nolabileceğini düşündüm...
Dialogue: 0,0:34:10.21,0:34:12.70,Main,,0,0,0,,...ama bir türlü anlayamadım.
Dialogue: 0,0:34:13.59,0:34:18.13,Main,,0,0,0,,Daha önce hiç böyle belirtiler görmemiştim. \NNe tür ilaç kullanacağım konusunda hiçbir fikrim yok.
Dialogue: 0,0:34:18.13,0:34:20.70,Main,,0,0,0,,Yılan Prenses çok acı çekiyormuş\Ngibi görünüyor.
Dialogue: 0,0:34:20.70,0:34:23.41,Main,,0,0,0,,Hiçbir şey de yemedi.
Dialogue: 0,0:34:30.65,0:34:32.12,Main,,0,0,0,,Yarın sabah...
Dialogue: 0,0:34:33.08,0:34:36.62,Main,,0,0,0,,--Yılan Prenses!\N--Büyük Nyon, onunla dalga geçmeyi bırak!
Dialogue: 0,0:34:37.31,0:34:39.50,Main,,0,0,0,,Tabii ki!
Dialogue: 0,0:34:40.25,0:34:43.03,Main,,0,0,0,,Bunun olması-!
Dialogue: 0,0:34:44.21,0:34:46.93,Main,,0,0,0,,Kahrolası virüs, böyle uygunsuz\Nbir zamanda saldırıyor!
Dialogue: 0,0:34:46.93,0:34:50.43,Main,,0,0,0,,--Ha? Virüs mü?\N--Ne olduğunu biliyor musun?
Dialogue: 0,0:34:50.83,0:34:53.44,Main,,0,0,0,,Büyük Nyon! Çok acıyor...
Dialogue: 0,0:34:55.13,0:34:58.73,Main,,0,0,0,,Ölecek miyim?
Dialogue: 0,0:34:58.73,0:35:00.48,Main,,0,0,0,,Evet, öleceksin.
Dialogue: 0,0:35:00.48,0:35:05.22,Main,,0,0,0,,--Ne diyorsun sen?!\N--Aptalca şakalar yapmayı bırak, Büyük Nyon!
Dialogue: 0,0:35:05.22,0:35:10.15,Main,,0,0,0,,Önceki imparatoriçe de bu hastalıktan öldü.
Dialogue: 0,0:35:12.31,0:35:15.49,Main,,0,0,0,,Ondan önceki de öyle.
Dialogue: 0,0:35:15.83,0:35:22.07,Main,,0,0,0,,Aslında ben de bir zamanlar aynı hastalığı kaptığım \Niçin krallıktan ayrıldım ve hayatta kalmayı başardım.
Dialogue: 0,0:35:22.54,0:35:26.56,Main,,0,0,0,,Yanımda Monkey D. Luffy'yi\Ngetirdim, Yılan Prenses.
Dialogue: 0,0:35:26.56,0:35:28.07,Main,,0,0,0,,Dur, Büyük Nyon!
Dialogue: 0,0:35:28.07,0:35:31.68,Main,,0,0,0,,Galiba senden bir şey istemek istiyor.\NOnu dinleyecek misin?
Dialogue: 0,0:35:32.14,0:35:35.71,Main,,0,0,0,,--Ablamız böyle bir durumdayken mi?!\N--Aklından ne geçiyor?!
Dialogue: 0,0:35:37.14,0:35:39.02,Main,,0,0,0,,Ayağa kalktı!
Dialogue: 0,0:35:39.02,0:35:41.67,Main,,0,0,0,,Tamam. İsteğini dinleyeceğim.
Dialogue: 0,0:35:48.76,0:35:52.69,Thoughts,,0,0,0,,Ne inanılmaz bir şans! Monkey D. Luffy...
Dialogue: 0,0:35:52.69,0:35:59.50,Thoughts,,0,0,0,,Daha önce hiç kimsenin kıpırdatamadığı dağı\Nkıpırdatmayı başarmış olabilir misin?
Dialogue: 0,0:36:01.00,0:36:02.54,Main,,0,0,0,,Bir isteğin mi var, Luffy?
Dialogue: 0,0:36:04.24,0:36:06.18,Main,,0,0,0,,Senden bir iyilik isteyeceğim.
Dialogue: 0,0:36:06.18,0:36:08.43,Main,,0,0,0,,Kendini daha iyi hissediyor musun?
Dialogue: 0,0:36:08.43,0:36:11.52,Main,,0,0,0,,Hiçbir hastalık beni yenemez.
Dialogue: 0,0:36:11.95,0:36:17.00,Main,,0,0,0,,Beyazsakal Korsanları'ndan idam edilmek \Nüzere olan Ace adlı korsan benim abim!
Dialogue: 0,0:36:17.00,0:36:18.92,Main,,0,0,0,,Ace'i kurtarmak istiyorum!
Dialogue: 0,0:36:18.92,0:36:21.79,Main,,0,0,0,,Ama bir korsan gemisiyle\Noraya zamanında varamam.
Dialogue: 0,0:36:21.79,0:36:27.60,Main,,0,0,0,,Denizcilerin senin için gönderdiği o gemiye binip\Nbeni Ace'in bulunduğu hapishaneye götürebilir misin?
Dialogue: 0,0:36:28.44,0:36:31.98,Main,,0,0,0,,Bu ne bencillik! Hasır Şapkalı Luffy!
Dialogue: 0,0:36:31.98,0:36:37.24,Main,,0,0,0,,Ablamızın kalbindeki yaraları biliyorsun ve yine de\Nseni o iğrenç yere götürmesini mi istiyorsun?!
Dialogue: 0,0:36:39.08,0:36:40.85,Main,,0,0,0,,Ne korkunç bir adam!
Dialogue: 0,0:36:40.85,0:36:43.04,Main,,0,0,0,,Gösterdiğimiz merhametten\Nfaydalanmaya çalışıyorsun!
Dialogue: 0,0:36:43.04,0:36:47.36,Main,,0,0,0,,Bu yüzden erkeklerden nefret ediyorum.\NAblamızın sabrının da bir sınırı var!
Dialogue: 0,0:36:47.36,0:36:50.07,Main,,0,0,0,,Onu taşlaştır ve aşağı at!
Dialogue: 0,0:36:50.07,0:36:54.76,Main,,0,0,0,,Yani Savaş Lordları için yapılan\Nçağrıya cevap vermemi mi isiyorsun?
Dialogue: 0,0:36:55.87,0:36:58.12,Main,,0,0,0,,--Abla!\N--Yap şunu!
Dialogue: 0,0:36:58.12,0:37:02.13,Main,,0,0,0,,İsteğin buysa...
Dialogue: 0,0:37:02.50,0:37:06.36,Main,,0,0,0,,...peşinden her yere gelirim!
Dialogue: 0,0:37:09.84,0:37:13.78,Main,,0,0,0,,Bu iyi! Sağol! Artık idamdan\Nönce oraya varabileceğim!
Dialogue: 0,0:37:14.14,0:37:19.14,Main,,0,0,0,,Yılan Prenses, Savaş Lordları\Nçağrısını kabul etmeye karar verdi!
Dialogue: 0,0:37:19.14,0:37:20.77,Main,,0,0,0,,Neler oluyor, Büyük Nyon?!
Dialogue: 0,0:37:20.77,0:37:24.10,Main,,0,0,0,,Yılan Prenses "aşk hastası!"
Dialogue: 0,0:37:24.10,0:37:27.87,Main,,0,0,0,,Ondan önceki imparatoriçeler\N"aşk ateşi"nden öldüler!
Dialogue: 0,0:37:30.73,0:37:34.63,Main,,0,0,0,,Doğu denizlerinde bir deyiş vardır:...
Dialogue: 0,0:37:34.99,0:37:37.51,Main,,0,0,0,,..."Aşk, her zaman...
Dialogue: 0,0:37:37.51,0:37:41.40,Main,,0,0,0,,...BİR KASIRGADIR!"
