26,0:01:45.23,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:14:31.00,0:14:37.70,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:27:24.00,0:27:34.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:01:40.26,0:01:45.23,Title,,0,0,230,,Artık Bunu Kimse DurduramazDialogue: 0,0:01:43.47,0:01:45.47,Main,,0,0,0,,Benim neyim var?Dialogue: 0,0:01:46.06,0:01:49.34,Main,,0,0,0,,Luffy'nin isteğini geri çevirmek istemiyorum.Dialogue: 0,0:01:49.70,0:01:52.18,Main,,0,0,0,,Bu yüzden çağrıya cevap vereceğimi söyledim.Dialogue: 0,0:01:52.18,0:01:54.58,Main,,0,0,0,,Yine de bu konuda kötü hissetmiyorum!Dialogue: 0,0:01:54.93,0:01:56.55,Main,,0,0,0,,Bu aşk!Dialogue: 0,0:01:56.55,0:02:03.39,Main,,0,0,0,,Göremediğin kişiyi arzu etmenin acısı seni ölene dek güçsüzleştirir.Dialogue: 0,0:02:03.39,0:02:07.39,Main,,0,0,0,,Önceki imparatoriçelerin hepsi aşık oldu,...Dialogue: 0,0:02:07.39,0:02:12.39,Main,,0,0,0,,...yine de bir imparatoriçe olarak, hislerini bastırıp adada kalmaktan başka çareleri yoktu.Dialogue: 0,0:02:12.39,0:02:15.79,Main,,0,0,0,,Bastırılmış hislerinden doğan acı onlara zarar vermeye başladı...Dialogue: 0,0:02:15.79,0:02:18.94,Main,,0,0,0,,...ve sonunda da canlarına mâl oldu.Dialogue: 0,0:02:20.98,0:02:26.61,Main,,0,0,0,,Ancak o adamla gitme kararın hayatını kurtaracak!Dialogue: 0,0:02:27.04,0:02:31.04,Main,,0,0,0,,Çağrıya cevap vererek ve  Savaş Lordu konumunu muhafaza ederek,...Dialogue: 0,0:02:31.04,0:02:33.59,Main,,0,0,0,,...Monkey D. Luffy'ye yardım etmekle birlikte...Dialogue: 0,0:02:33.59,0:02:36.49,Main,,0,0,0,,...ülkenin güvenliğini de sağlayacaksın.Dialogue: 0,0:02:38.10,0:02:41.29,Main,,0,0,0,,Acaba o adam hangi yıldız altında doğmuş?Dialogue: 0,0:02:41.83,0:02:50.44,Main,,0,0,0,,Genelde hapisaneye gitmek isteyen  her korsan teslim olmak zorunda kalırdı...Dialogue: 0,0:02:55.44,0:02:58.54,Captions,,0,0,0,,Amazon Lily LimanDialogue: 0,0:03:04.63,0:03:07.05,Main,,0,0,0,,Yarın sabah yola çıkmıyor muydu?Dialogue: 0,0:03:07.05,0:03:09.09,Main,,0,0,0,,Galiba gidecekleri yer değişmiş.Dialogue: 0,0:03:09.58,0:03:13.07,Main,,0,0,0,,Galiba Yılan Prenses'le birlikte Merkez'e gidecek!Dialogue: 0,0:03:13.07,0:03:13.88,Main,,0,0,0,,Luffy!Dialogue: 0,0:03:13.88,0:03:16.76,Main,,0,0,0,,Size çok şey borçluyum.Dialogue: 0,0:03:16.76,0:03:19.72,Main,,0,0,0,,Bir dahakine arkadaşlarımı da  buraya getireceğim!Dialogue: 0,0:03:22.74,0:03:24.51,Main,,0,0,0,,Sahi, sorun olmaz, değil mi?Dialogue: 0,0:03:24.60,0:03:27.56,Main,,0,0,0,,Nami ve Robin sorun olmaz ama erkeklere bu ülkede izin yok.Dialogue: 0,0:03:28.73,0:03:31.99,Main,,0,0,0,,Senin arkadaşların olduğu için sanırım sorun olmaz.Dialogue: 0,0:03:31.99,0:03:36.56,Main,,0,0,0,,Görünüşe göre Yılan Prenses senin için özel bir istisna yaptı.Dialogue: 0,0:03:36.56,0:03:38.22,Main,,0,0,0,,Dört gözle bekleyeceğim!Dialogue: 0,0:03:40.51,0:03:42.16,Main,,0,0,0,,Demek geldiniz.Dialogue: 0,0:03:43.35,0:03:45.35,Main,,0,0,0,,Yolumu engelleyecek şekilde...Dialogue: 0,0:03:45.35,0:03:46.89,Main,,0,0,0,,...bir köpek yavrusu ve...Dialogue: 0,0:03:49.16,0:03:50.41,Main,,0,0,0,,...fok yavrusu...Dialogue: 0,0:03:51.08,0:03:52.61,Main,,0,0,0,,...bırakacak kadar küstah olan kim?!Dialogue: 0,0:03:56.01,0:03:58.03,Main,,0,0,0,,YILAN PRENSES!Dialogue: 0,0:03:58.03,0:04:01.05,Main,,0,0,0,,Çekiciliğinin bir sınırı yok!!Dialogue: 0,0:04:01.05,0:04:05.41,Main,,0,0,0,,Nedenini bilmiyorum ama güzelliği her zamankinden daha da çarpıcı!Dialogue: 0,0:04:05.80,0:04:08.74,Main,,0,0,0,,Çok üzgünüm! Hepsi benim hatamdı.Dialogue: 0,0:04:09.87,0:04:10.98,Main,,0,0,0,,Lütfen daha dikkatli ol.Dialogue: 0,0:04:12.28,0:04:14.21,Main,,0,0,0,,Bu kadar ani ayrılmamız gerektiği için üzgünüm.Dialogue: 0,0:04:17.57,0:04:20.17,Main,,0,0,0,,Yılan kadın! En kısa sürede yola koyulmak istiyorum!Dialogue: 0,0:04:20.82,0:04:23.09,Thoughts,,0,0,0,,Olamaz! Gözlerine bakarsam...Dialogue: 0,0:04:23.09,0:04:26.46,Main,,0,0,0,,Hayır, Luffy! Ona böyle seslenmen çok kaba!Dialogue: 0,0:04:26.46,0:04:29.30,Main,,0,0,0,,"Yılan Prenses" şeklinde hitap etmelisin!Dialogue: 0,0:04:30.66,0:04:33.03,Main,,0,0,0,,Lütfen bana Hancock de.Dialogue: 0,0:04:34.47,0:04:35.95,Main,,0,0,0,,YILAN PRENSES!Dialogue: 0,0:04:35.95,0:04:38.37,Main,,0,0,0,,Tabii olur, Hammock!Dialogue: 0,0:04:39.33,0:04:40.25,Main,,0,0,0,,"Hancock".Dialogue: 0,0:04:40.25,0:04:43.14,Main,,0,0,0,,Yılan Prenses gülümsüyor!Dialogue: 0,0:04:43.14,0:04:46.25,Main,,0,0,0,,Kaç karat? O gülümseme kaç karatlıktı?!Dialogue: 0,0:04:46.25,0:04:47.21,Main,,0,0,0,,Çok göz kamaştırıcı...Dialogue: 0,0:04:47.57,0:04:49.44,Main,,0,0,0,,Aşık bir kadın...Dialogue: 0,0:04:49.44,0:04:51.66,Main,,0,0,0,,Ben de bir zamanlar öyleydim...Dialogue: 0,0:04:51.66,0:04:55.66,Main,,0,0,0,,Ha? Büyük Nyon, yüzün çarpık ve çirkin görünüyor.Dialogue: 0,0:04:55.66,0:04:57.13,Main,,0,0,0,,SESSİZLİK!Dialogue: 0,0:04:59.49,0:05:02.23,Main,,0,0,0,,İyi yolculuklar, Yılan Prenses!Dialogue: 0,0:05:02.23,0:05:04.14,Main,,0,0,0,,Lütfen yine gel, Luffy!Dialogue: 0,0:05:04.14,0:05:05.28,Main,,0,0,0,,Luffy-chan!Dialogue: 0,0:05:05.28,0:05:07.10,Main,,0,0,0,,Görüşürüz!Dialogue: 0,0:05:07.10,0:05:08.12,Main,,0,0,0,,KESİN ŞUNU ARTIK!Dialogue: 0,0:05:07.10,0:05:08.12,Secondary,,0,0,0,,Görüşürüz!Dialogue: 0,0:05:23.02,0:05:25.81,Main,,0,0,0,,Den Den Mushi'de sana şartımı söyledim.Dialogue: 0,0:05:27.52,0:05:31.10,Main,,0,0,0,,Mesele Büyük Hapisane  Impel Down'da durma isteğinse...Dialogue: 0,0:05:31.10,0:05:33.43,Main,,0,0,0,,...üstlerimden izin almayı başardım.Dialogue: 0,0:05:33.43,0:05:37.73,Main,,0,0,0,,Bir Savaş Lordu olsan bile korsanların o bölgeye girmesi yasaklanmıştır.Dialogue: 0,0:05:40.34,0:05:43.28,Main,,0,0,0,,Sadece sen ve o yılan gelecek, değil mi?Dialogue: 0,0:05:43.28,0:05:44.89,Main,,0,0,0,,Sizin için bir istisna yaptık...Dialogue: 0,0:05:44.89,0:05:48.04,Main,,0,0,0,,...ama zamanımız çok yok, bu yüzden orada o kadar uzun kalamayız.Dialogue: 0,0:05:48.04,0:05:50.58,Main,,0,0,0,,Abla, lütfen dikkatli ol.Dialogue: 0,0:05:50.58,0:05:52.71,Main,,0,0,0,,Sağ salim dön, abla.Dialogue: 0,0:05:53.33,0:05:56.38,Main,,0,0,0,,Güvenliğin için dua edeceğiz, Yılan Prenses! Dikkatli ol, Yılan Prenses!Dialogue: 0,0:05:56.38,0:05:58.51,Main,,0,0,0,,Luffy, sen de dikkatli-Dialogue: 0,0:05:59.88,0:06:01.22,Main,,0,0,0,,Gidiyorum o zaman.Dialogue: 0,0:06:01.46,0:06:03.32,Main,,0,0,0,,Şimdilik krallığı size bırakıyorum.Dialogue: 0,0:06:03.46,0:06:04.68,Main,,0,0,0,,Tamam!Dialogue: 0,0:06:06.35,0:06:08.50,Main,,0,0,0,,Beklemeye değdi.Dialogue: 0,0:06:08.93,0:06:11.99,Main,,0,0,0,,Artık görevimi tamamlayabilecekmişim gibi görünüyor.Dialogue: 0,0:06:14.43,0:06:17.34,Main,,0,0,0,,Öncelikle, taşlaşmış mürettebatım için bir şeyler yapabilir misiniz?Dialogue: 0,0:06:17.75,0:06:20.38,Main,,0,0,0,,Hepsi öldü mü?Dialogue: 0,0:06:20.38,0:06:21.53,Main,,0,0,0,,Uyanın.Dialogue: 0,0:06:24.66,0:06:26.15,Main,,0,0,0,,...CK-SAMA!Dialogue: 0,0:06:29.03,0:06:30.08,Main,,0,0,0,,Ne?Dialogue: 0,0:06:30.08,0:06:31.92,Main,,0,0,0,,Gemiyi harekete geçirin, ahmaklar!Dialogue: 0,0:06:31.92,0:06:33.86,Main,,0,0,0,,Ah, tamam! Hemen!Dialogue: 0,0:06:36.29,0:06:40.28,Main,,0,0,0,,Marineford'a gitmeden önce Impel Down'a uğruyoruz!Dialogue: 0,0:06:45.60,0:06:50.14,Captions,,0,0,180,,Denizci KarargâhıDialogue: 0,0:06:46.91,0:06:48.42,Main,,0,0,0,,Filo Amirali Sengoku!Dialogue: 0,0:06:48.42,0:06:50.29,Main,,0,0,0,,Koramiral Momonga'dan mesaj aldık!Dialogue: 0,0:06:52.45,0:06:55.04,Main,,0,0,0,,Görünüşe göre Korsan İmparatoriçesi Boa Hancock...Dialogue: 0,0:06:55.04,0:06:58.88,Main,,0,0,0,,...sonunda yanıt verdi ve buraya geliyor!Dialogue: 0,0:06:59.29,0:07:02.37,Main,,0,0,0,,Nihayet. Umarım zamanında gelir.Dialogue: 0,0:07:03.20,0:07:04.85,Main,,0,0,0,,O kadın güçlü.Dialogue: 0,0:07:06.18,0:07:08.86,Main,,0,0,0,,Böylece Yedi Savaş Lordu'ndan altısını topladık.Dialogue: 0,0:07:08.86,0:07:12.19,Main,,0,0,0,,Ya sonuncusu, hala hapishanede mi oturuyor?Dialogue: 0,0:07:12.19,0:07:14.50,Main,,0,0,0,,Aklı başına geldi mi?Dialogue: 0,0:07:14.50,0:07:18.66,Main,,0,0,0,,Hayır, efendim. Hâlâ katı bir şekilde savaşa karşı çıkıyor gibi görünüyor.Dialogue: 0,0:07:19.58,0:07:22.71,Main,,0,0,0,,Görünüşe göre Savaş Lordu unvanını kaybetmeye bile hazır.Dialogue: 0,0:07:23.57,0:07:27.31,Main,,0,0,0,,Bu olayda en güçlü destekçimiz olacağını düşünmüştüm.Dialogue: 0,0:07:28.04,0:07:30.36,Main,,0,0,0,,Bu kadar karşı olacağını düşünmek...Dialogue: 0,0:07:31.23,0:07:33.15,Main,,0,0,0,,Lanet olası Jimbei...Dialogue: 0,0:07:34.38,0:07:35.54,Main,,0,0,0,,Rapor veriyorum!Dialogue: 0,0:07:35.54,0:07:36.94,Main,,0,0,0,,Filo Amirali!Dialogue: 0,0:07:36.94,0:07:41.42,Main,,0,0,0,,Amiral Kizaru'nun Sabaody Takımadası'nda yakaladığı 500 korsan konusunda...Dialogue: 0,0:07:41.97,0:07:45.27,Main,,0,0,0,,...Impel Down, bununla başa çıkacak insan güçlerinin olmadığını söylüyor.Dialogue: 0,0:07:45.27,0:07:47.11,Main,,0,0,0,,Çalışma Bakanlığı'yla konuşun!Dialogue: 0,0:07:47.11,0:07:51.17,Main,,0,0,0,,Beyazsakal olayıyla ilgili olmayan hiçbir şeyi bana sormayın!Dialogue: 0,0:07:51.17,0:07:54.30,Main,,0,0,0,,Oh, ayrıca Dünya Soylusu Aziz Rosward...Dialogue: 0,0:07:55.05,0:07:57.53,Main,,0,0,0,,Onunla amiraller ilgilensin!Dialogue: 0,0:07:57.53,0:07:59.11,Main,,0,0,0,,Garp ne alemde?Dialogue: 0,0:07:59.76,0:08:03.21,Main,,0,0,0,,Koramiral Garp, Impel Down'a gitti.Dialogue: 0,0:08:03.21,0:08:06.03,Main,,0,0,0,,Ne yaptığını sanıyor bu?!Dialogue: 0,0:08:06.03,0:08:08.23,Main,,0,0,0,,Böyle kritik bir anda aklına eseni yapıyor.Dialogue: 0,0:08:08.23,0:08:09.25,Main,,0,0,0,,Filo Amirali Sengoku!Dialogue: 0,0:08:09.92,0:08:11.30,Main,,0,0,0,,Acil durum var!Dialogue: 0,0:08:11.30,0:08:12.49,Main,,0,0,0,,Beyazsakal harekete geçti!Dialogue: 0,0:08:12.49,0:08:15.32,Main,,0,0,0,,Demek geliyor. Devriye gemileri mi bildirdi?Dialogue: 0,0:08:15.32,0:08:17.79,Main,,0,0,0,,Kendileri teyit edebilmeleri için bana bağlayın.Dialogue: 0,0:08:17.79,0:08:18.59,Main,,0,0,0,,Şey...Dialogue: 0,0:08:19.53,0:08:26.05,Main,,0,0,0,,Beyazsakal'ın sancak gemisi Moby Dick'ten gözlerini ayırmasınlar diye gönderdiğimiz 23 gemi...Dialogue: 0,0:08:26.05,0:08:29.85,Main,,0,0,0,,...ortadan kayboldu.  Onlarla bağlantı kuramıyoruz.Dialogue: 0,0:08:30.31,0:08:32.00,Main,,0,0,0,,N-Ne?!Dialogue: 0,0:08:33.61,0:08:37.94,Main,,0,0,0,,Görünüşe göre Yeni Dünya'daki diğer korsanlar arasında da şüpheli hareketlenmeler oluyor!Dialogue: 0,0:08:37.94,0:08:43.57,Main,,0,0,0,,Sayıları veya ne zaman gelecekleri hakkında hiçbir bilgi alamıyoruz!Dialogue: 0,0:08:43.57,0:08:46.69,Main,,0,0,0,,Başka bir devriye gönderdik, ama...Dialogue: 0,0:08:49.30,0:08:50.48,Main,,0,0,0,,Bizi gafil avladı!Dialogue: 0,0:08:51.11,0:08:53.93,Main,,0,0,0,,Çoktan harekete geçti, değil mi?Dialogue: 0,0:08:54.34,0:08:57.03,Main,,0,0,0,,Nereden vuracağını bilmiyoruz.Dialogue: 0,0:08:57.03,0:08:59.02,Main,,0,0,0,,Ace'i tutsak ettiğimiz sürece...Dialogue: 0,0:08:59.02,0:09:03.29,Main,,0,0,0,,...Impel Down'da bir savaşın çıkabileceğini herkese söylemeliyiz!Dialogue: 0,0:09:03.29,0:09:04.80,Main,,0,0,0,,Emredersiniz!Dialogue: 0,0:09:06.88,0:09:09.66,Captions,,0,0,0,,Büyük Hapishane Impel DownDialogue: 0,0:09:07.26,0:09:09.66,Main,,0,0,0,,Bu taraftan, Koramiral Garp.Dialogue: 0,0:09:10.85,0:09:12.08,Main,,0,0,0,,Dikkatli olun!Dialogue: 0,0:09:12.08,0:09:12.88,Main,,0,0,0,,Tabii.Dialogue: 0,0:09:16.40,0:09:20.39,Main,,0,0,0,,Oho, zavallı görünüyorsun.Dialogue: 0,0:09:20.39,0:09:22.52,Main,,0,0,0,,Hala hayat mısın,...Dialogue: 0,0:09:25.07,0:09:26.79,Main,,0,0,0,,Ace?Dialogue: 0,0:09:26.79,0:09:29.13,Main,,0,0,0,,Yaşlı adam...Dialogue: 0,0:09:30.20,0:09:33.54,Main,,0,0,0,,Şimdi zamanda biraz geri gideceğiz.Dialogue: 0,0:09:41.83,0:09:43.20,Main,,0,0,0,,Aman, aman...Dialogue: 0,0:09:55.64,0:10:01.11,Main,,0,0,0,,Hey...hey...hey...Dialogue: 0,0:10:01.11,0:10:02.76,Main,,0,0,0,,...genç bayan?Dialogue: 0,0:10:03.54,0:10:06.56,Main,,0,0,0,,Nereden geldin genç bayan?Dialogue: 0,0:10:08.50,0:10:10.19,Main,,0,0,0,,Tekrarlayıp durmayı kes.Dialogue: 0,0:10:10.19,0:10:11.24,Main,,0,0,0,,Ne var?Dialogue: 0,0:10:14.30,0:10:16.65,Main,,0,0,0,,Sakinleştin mi?Dialogue: 0,0:10:16.65,0:10:19.42,Main,,0,0,0,,Artık bana saldırmayacaksın, değil mi?Dialogue: 0,0:10:26.36,0:10:28.12,Main,,0,0,0,,İşte!Dialogue: 0,0:10:29.72,0:10:31.78,Main,,0,0,0,,Sana bir şey göstereyim.Dialogue: 0,0:10:31.78,0:10:35.06,Main,,0,0,0,,Bunlar sıkıca bağlanmış "rüzgar düğümleri"!Dialogue: 0,0:10:35.06,0:10:37.08,Main,,0,0,0,,Birini çözersen...Dialogue: 0,0:10:37.08,0:10:39.53,Main,,0,0,0,,...nazik bir esinti oluşturur.Dialogue: 0,0:10:39.53,0:10:41.55,Main,,0,0,0,,Bir tane daha çözersen...Dialogue: 0,0:10:41.55,0:10:43.36,Main,,0,0,0,,...güçlü bir rüzgar oluşturur.Dialogue: 0,0:10:43.87,0:10:45.37,Main,,0,0,0,,Üçüncüsünü çözersen...Dialogue: 0,0:10:45.37,0:10:46.88,Main,,0,0,0,,...fırtına oluşturur!Dialogue: 0,0:10:48.90,0:10:50.56,Main,,0,0,0,,Ne yapıyorsun?!Dialogue: 0,0:10:50.56,0:10:52.85,Main,,0,0,0,,Seni neşelendirir sanmıştım.Dialogue: 0,0:10:52.85,0:10:55.11,Main,,0,0,0,,Şimdi kendimi daha iyi hissediyorum, çok sağol!Dialogue: 0,0:11:09.94,0:11:13.01,Main,,0,0,0,,Burası Weatheria, küçük bir Gökyüzü Adası.Dialogue: 0,0:11:13.01,0:11:15.67,Main,,0,0,0,,Hava araştırmasına adanmış bir ülke.Dialogue: 0,0:11:15.67,0:11:18.42,Main,,0,0,0,,G-Gökyüzü Adası?!Dialogue: 0,0:11:29.00,0:11:33.42,Captions,,0,0,180,,Grand Line'da Bir Kış AdasıDialogue: 0,0:11:47.03,0:11:48.01,Main,,0,0,0,,Dur!Dialogue: 0,0:11:48.01,0:11:49.45,Main,,0,0,0,,Kes şunu, Taroimo!Dialogue: 0,0:11:53.52,0:11:54.99,Main,,0,0,0,,Dur!Dialogue: 0,0:11:57.86,0:11:59.12,Main,,0,0,0,,Bu bir insan!Dialogue: 0,0:12:00.06,0:12:02.63,Main,,0,0,0,,Şey, iyi misin?Dialogue: 0,0:12:02.63,0:12:05.55,Main,,0,0,0,,Seni bir canavarla karıştırdı.Dialogue: 0,0:12:06.51,0:12:08.39,Main,,0,0,0,,Evet, iyiyim.Dialogue: 0,0:12:09.13,0:12:10.85,Main,,0,0,0,,Nasıl iyi olabilirsin?!Dialogue: 0,0:12:11.35,0:12:13.24,Main,,0,0,0,,Yine de bu kötü.Dialogue: 0,0:12:13.47,0:12:15.60,Main,,0,0,0,,Ne kadar uzağa uçtum?Dialogue: 0,0:12:16.22,0:12:19.35,Main,,0,0,0,,Ah, soğuk! Burası kar ülkesi mi?!Dialogue: 0,0:12:20.63,0:12:21.48,Main,,0,0,0,,FRANKY!Dialogue: 0,0:12:21.48,0:12:22.69,Main,,0,0,0,,Eyvah!Dialogue: 0,0:12:22.69,0:12:25.19,Main,,0,0,0,,Karda sadece slip don giyerek dolaşıyor!Dialogue: 0,0:12:25.19,0:12:27.22,Main,,0,0,0,,Biri onu soymuş mu?Dialogue: 0,0:12:28.16,0:12:30.15,Main,,0,0,0,,Al, şu peştemali dola.Dialogue: 0,0:12:30.15,0:12:32.86,Main,,0,0,0,,Peştemal mı?! Ciddi ol!Dialogue: 0,0:12:32.86,0:12:34.67,Main,,0,0,0,,Kendi işine bak!Dialogue: 0,0:12:34.67,0:12:36.41,Main,,0,0,0,,Onu...Dialogue: 0,0:12:36.41,0:12:38.85,Main,,0,0,0,,...dolasaydım...Dialogue: 0,0:12:38.85,0:12:40.82,Main,,0,0,0,,...tüm sapıkların...Dialogue: 0,0:12:40.82,0:12:42.62,Main,,0,0,0,,...yüz karası olurdum!Dialogue: 0,0:12:42.62,0:12:45.54,Main,,0,0,0,,Eşlik edin!Dialogue: 0,0:12:47.25,0:12:50.50,Main,,0,0,0,,Kalçanızı sağa hareket ettirin!Dialogue: 0,0:12:51.49,0:12:53.11,Main,,0,0,0,,Sağ el kalçaların üstünde...Dialogue: 0,0:12:53.65,0:12:55.49,Main,,0,0,0,,...ve sol elini dışarı uzat!Dialogue: 0,0:12:56.12,0:12:58.14,Main,,0,0,0,,Sola...Dialogue: 0,0:12:58.14,0:12:59.35,Main,,0,0,0,,...değiştir!Dialogue: 0,0:12:59.89,0:13:04.06,Main,,0,0,0,,Sağ! Sol!Dialogue: 0,0:13:04.06,0:13:05.67,Main,,0,0,0,,Tekrar!Dialogue: 0,0:13:05.67,0:13:06.73,Main,,0,0,0,,Evet!Dialogue: 0,0:13:06.73,0:13:08.92,Main,,0,0,0,,Bir! İki!Dialogue: 0,0:13:13.52,0:13:15.92,Main,,0,0,0,,SÜPER!Dialogue: 0,0:13:15.92,0:13:18.71,Main,,0,0,0,,Vay, bu müthişti!Dialogue: 0,0:13:20.72,0:13:22.69,Main,,0,0,0,,Hala üşüyorum!Dialogue: 0,0:13:22.69,0:13:24.03,Main,,0,0,0,,Neresi burası?!Dialogue: 0,0:13:24.48,0:13:25.40,Main,,0,0,0,,Dialogue: 0,0:13:25.44,0:13:28.62,Main,,0,0,0,,Burası, Karakuri Adası'nın gelecek krallığı Bulgemore.Dialogue: 0,0:13:25.44,0:13:28.62,Note,,0,0,0,,Karakuri: Makine, MekanizmaDialogue: 0,0:13:29.19,0:13:31.09,Main,,0,0,0,,Dahilerin doğduğu ada.Dialogue: 0,0:13:32.88,0:13:36.11,Main,,0,0,0,,Burası Grand Line'daki Hayaller Adası.Dialogue: 0,0:13:36.11,0:13:38.19,Main,,0,0,0,,Momoiro Adası.Dialogue: 0,0:13:36.11,0:13:38.19,Note,,0,0,0,,Momoiro: Pembe RenkliDialogue: 0,0:13:38.49,0:13:41.91,Main,,0,0,0,,Burası ikinci Kadınlar Adası olarak bilinir.Dialogue: 0,0:13:42.73,0:13:45.47,Main,,0,0,0,,Ağaçlardan denize kadar her şey saf pembe.Dialogue: 0,0:13:45.47,0:13:49.14,Main,,0,0,0,,Bu adada toplanan insanların ve hayvanların...Dialogue: 0,0:13:49.14,0:13:52.58,Main,,0,0,0,,...hepsinde genç kız kalbi var.Dialogue: 0,0:13:52.58,0:13:55.21,Main,,0,0,0,,Bu ne tür bir cennet?!Dialogue: 0,0:13:56.98,0:13:58.48,Main,,0,0,0,,Bekle!Dialogue: 0,0:13:58.48,0:13:59.79,Main,,0,0,0,,Sen bizim gibisin!Dialogue: 0,0:13:59.79,0:14:01.64,Main,,0,0,0,,Öylesin, değil mi?!Dialogue: 0,0:14:02.59,0:14:04.44,Main,,0,0,0,,Kapayın çenenizi! Peşimden gelmeyin!Dialogue: 0,0:14:04.44,0:14:05.68,Main,,0,0,0,,Değilim diyorum!Dialogue: 0,0:14:07.15,0:14:10.60,Thoughts,,0,0,0,,Sevgili Nami-san'ıma ve Robin-chan'ıma...Dialogue: 0,0:14:10.60,0:14:12.80,Thoughts,,0,0,0,,İyi misiniz?Dialogue: 0,0:14:14.76,0:14:17.33,Main,,0,0,0,,Bekle! Bekle!Dialogue: 0,0:14:17.33,0:14:19.36,Main,,0,0,0,,Bekle, lanet olası!Dialogue: 0,0:14:19.36,0:14:22.07,Main,,0,0,0,,Beklemem mümkün değil!Dialogue: 0,0:14:22.57,0:14:25.18,Main,,0,0,0,,Kamabakka krallığına hoşgeldin!Dialogue: 0,0:14:22.57,0:14:25.18,Note,,0,0,0,,Kamabakka: TravestiDialogue: 0,0:14:26.21,0:14:27.46,Thoughts,,0,0,0,,Şu anda ben...Dialogue: 0,0:14:28.54,0:14:30.56,Thoughts,,0,0,0,,...Cehennem'deyim.Dialogue: 0,0:14:32.85,0:14:37.72,Main,,0,0,0,,Denizde çiçekler gibi açan bu adalara Bowin Adaları denir.Dialogue: 0,0:14:40.44,0:14:41.54,Main,,0,0,0,,Nasılsın?Dialogue: 0,0:14:43.56,0:14:46.46,Main,,0,0,0,,Gayet iyisin, lanet olsun!Dialogue: 0,0:15:08.39,0:15:09.05,Main,,0,0,0,,Bunu yiyecek misin?Dialogue: 0,0:15:09.05,0:15:10.07,Main,,0,0,0,,Mümkün değil!Dialogue: 0,0:15:10.07,0:15:12.42,Main,,0,0,0,,Ama yine de beni kurtardın. Sağol!Dialogue: 0,0:15:12.42,0:15:13.94,Main,,0,0,0,,Kim olduğunu bilmiyorum ama...Dialogue: 0,0:15:13.94,0:15:15.94,Main,,0,0,0,,Adım Heracles-un!Dialogue: 0,0:15:16.88,0:15:18.45,Main,,0,0,0,,Vay canına, çok havalı bir isim.Dialogue: 0,0:15:18.45,0:15:20.72,Main,,0,0,0,,Öyle mi dersin?Dialogue: 0,0:15:20.72,0:15:22.70,Main,,0,0,0,,Ben Usopp. Tanıştığımıza memnun oldum.Dialogue: 0,0:15:24.19,0:15:26.28,Main,,0,0,0,,Bu yenilebilir mi?Dialogue: 0,0:15:26.28,0:15:28.21,Main,,0,0,0,,Daha önce hiç böyle bir meyve görmedim.Dialogue: 0,0:15:28.21,0:15:30.67,Main,,0,0,0,,Sorun yok, Usopp-un.Dialogue: 0,0:15:30.67,0:15:32.93,Main,,0,0,0,,Adım...Dialogue: 0,0:15:32.93,0:15:34.51,Main,,0,0,0,,...HERACLES-UN!Dialogue: 0,0:15:34.84,0:15:37.48,Main,,0,0,0,,Anladım. Havalısın.Dialogue: 0,0:15:39.09,0:15:41.61,Main,,0,0,0,,Gerçekten iyi kokuyor.Dialogue: 0,0:15:42.43,0:15:44.46,Main,,0,0,0,,Sadece yalayacağım.Dialogue: 0,0:15:48.67,0:15:50.53,Main,,0,0,0,,USOPP-UN!Dialogue: 0,0:15:52.27,0:15:53.68,Main,,0,0,0,,O da neydi?!Dialogue: 0,0:15:53.68,0:15:55.84,Main,,0,0,0,,O şey beni yemeye mi çalışıyordu?!Dialogue: 0,0:15:55.84,0:15:58.20,Main,,0,0,0,,Elbette. İnsan yiyen bir bitki.Dialogue: 0,0:15:58.20,0:16:00.18,Main,,0,0,0,,İnsan yiyen mi?!Dialogue: 0,0:16:07.40,0:16:09.35,Main,,0,0,0,,BURASI NEYİN NESİ BÖYLE?!Dialogue: 0,0:16:09.35,0:16:11.75,Main,,0,0,0,,Burası eşkıyanın ormanı Grinston.Dialogue: 0,0:16:11.75,0:16:15.50,Main,,0,0,0,,YARDIM EDİN!!!Dialogue: 0,0:16:23.31,0:16:26.95,Captions,,930,0,490,,Grand Line Namakura Adası (Namakura: Tembel)Dialogue: 0,0:16:23.31,0:16:26.95,Captions,,0,880,320,,Yoksulluk KrallığıDialogue: 0,0:16:30.77,0:16:33.23,Main,,0,0,0,,B-Bu, Şeytan mı?Dialogue: 0,0:16:33.23,0:16:36.99,Main,,0,0,0,,Kara büyümüzle onu çağırmayı gerçekten başardık!Dialogue: 0,0:16:37.67,0:16:40.37,Main,,0,0,0,,Ne korkutucu bir görünüş!Dialogue: 0,0:16:40.79,0:16:43.16,Main,,0,0,0,,Kesinlikle bu dünyadan değil.Dialogue: 0,0:16:43.76,0:16:47.48,Main,,0,0,0,,Dileğimiz gerçekleşebilir!Dialogue: 0,0:16:47.48,0:16:49.58,Main,,0,0,0,,O insanlardan intikamımızı alabiliriz!Dialogue: 0,0:16:49.58,0:16:52.81,Main,,0,0,0,,Hiçbir şeyimiz kalmadı!Dialogue: 0,0:16:52.81,0:16:55.38,Main,,0,0,0,,Her şeyimizi bizden alan Uzunel kabilesinden intikamımızı alacağız!Dialogue: 0,0:16:55.46,0:16:57.81,Main,,0,0,0,,Şeytanlar Kralı Satan-sama...Dialogue: 0,0:16:57.81,0:17:00.52,Main,,0,0,0,,Dileklerimizi yerine getirirsen...Dialogue: 0,0:17:00.52,0:17:04.53,Main,,0,0,0,,...her birimiz ruhlarımızı sana teslim edeceğiz!Dialogue: 0,0:17:04.53,0:17:06.89,Main,,0,0,0,,Lütfen onların üstüne ölüm yağdır!Dialogue: 0,0:17:08.94,0:17:14.27,Main,,0,0,0,,Ne kadar uzağa uçmuş olabilirim?Dialogue: 0,0:17:17.71,0:17:19.96,Main,,0,0,0,,Herkesin olduğu yere...Dialogue: 0,0:17:20.20,0:17:22.53,Main,,0,0,0,,...geri dönmeliyim!Dialogue: 0,0:17:22.53,0:17:24.11,Main,,0,0,0,,Lütfen durun!Dialogue: 0,0:17:24.11,0:17:26.36,Main,,0,0,0,,Lütfen Cehennem'e dönmeyin, Satan-sama!Dialogue: 0,0:17:26.36,0:17:28.76,Main,,0,0,0,,Ne pahasına olursa olsun onu burada tutmalıyız!Dialogue: 0,0:17:28.76,0:17:30.24,Main,,0,0,0,,Yeterince kurban sunmamış olabilir miyiz?Dialogue: 0,0:17:30.24,0:17:32.96,Main,,0,0,0,,Satan-sama ne istiyor olabilir?Dialogue: 0,0:17:32.96,0:17:34.12,Main,,0,0,0,,Canlı bir kurban mı?Dialogue: 0,0:17:34.12,0:17:35.14,Main,,0,0,0,,Kan mı?Dialogue: 0,0:17:36.04,0:17:39.93,Main,,0,0,0,,Burası neresi?Dialogue: 0,0:17:46.83,0:17:48.44,Main,,0,0,0,,Afedersiniz,...Dialogue: 0,0:17:48.44,0:17:51.04,Main,,0,0,0,,...külotunuzu görebilir miyim?Dialogue: 0,0:17:51.67,0:17:53.13,Main,,0,0,0,,K-Külot!Dialogue: 0,0:17:58.53,0:18:02.34,Captions,,880,0,250,,East Blue Köprüdeki Ülke Tequila WolfDialogue: 0,0:17:53.13,0:17:56.42,Main,,0,0,0,,Hemen ona külotunuzu gösterin!Dialogue: 0,0:18:02.37,0:18:04.80,Main,,0,0,0,,Burası işçiler ülkesi.Dialogue: 0,0:18:05.02,0:18:07.18,Main,,0,0,0,,Çek! Çek!Dialogue: 0,0:18:10.63,0:18:16.09,Main,,0,0,0,,Burada çalışan insanların hepsi diğer ülkelerden gelme suçlular...Dialogue: 0,0:18:16.09,0:18:21.12,Main,,0,0,0,,...ya da Dünya Hükümeti'ne katılmayı reddeden ülkelerin sakinleri.Dialogue: 0,0:18:26.49,0:18:28.44,Main,,0,0,0,,Kalk! Kalk ayağa!Dialogue: 0,0:18:28.93,0:18:30.80,Main,,0,0,0,,Sanırım onlara köle diyebilirsin.Dialogue: 0,0:18:30.98,0:18:32.72,Main,,0,0,0,,Bu köprü ne zaman tamamlanacak?Dialogue: 0,0:18:32.72,0:18:34.64,Main,,0,0,0,,Muhtemelen epey vakit alacak.Dialogue: 0,0:18:34.64,0:18:38.20,Main,,0,0,0,,Ne de olsa yedi yüz yıldır bunun üzerinde çalışıyoruz.Dialogue: 0,0:18:38.56,0:18:40.72,Main,,0,0,0,,Yedi yüz yıl mı? Niçin?Dialogue: 0,0:18:40.72,0:18:43.20,Main,,0,0,0,,Bilmene gerek yok.Dialogue: 0,0:18:43.64,0:18:48.65,Main,,0,0,0,,Artık işçilerimizden birisin, bu yüzden sadece köprüyü inşa etmelisin!Dialogue: 0,0:18:52.78,0:18:55.13,Captions,,980,0,340,,South BlueDialogue: 0,0:18:56.28,0:18:57.90,Main,,0,0,0,,Bu kuşlar da ne böyle?!Dialogue: 0,0:18:58.14,0:18:59.51,Main,,0,0,0,,Çok büyükler!Dialogue: 0,0:19:01.02,0:19:02.98,Main,,0,0,0,,Beni yemek mi istiyorsunuz?!Dialogue: 0,0:19:04.99,0:19:07.94,Main,,0,0,0,,Bedenim beni dinlemiyor!Dialogue: 0,0:19:32.52,0:19:35.39,Main,,0,0,0,,Güvende miyim?Dialogue: 0,0:19:49.02,0:19:51.76,Main,,0,0,0,,Bir rakun köpek. Ne kadar nadir!Dialogue: 0,0:19:51.76,0:19:53.46,Main,,0,0,0,,Rakun güveci yapacağız!Dialogue: 0,0:19:53.50,0:19:57.21,Main,,0,0,0,,Kesin şunu! Ben ren geyiğiyim!Dialogue: 0,0:20:00.94,0:20:03.54,Main,,0,0,0,,O zaman ren geyiği yahnisi yapıyoruz.Dialogue: 0,0:20:03.54,0:20:06.83,Main,,0,0,0,,Ha? Demin konuştu mu bu?Dialogue: 0,0:20:08.03,0:20:11.62,Main,,0,0,0,,Efsaneler buranın, kuşların insanlara hükmettiği...Dialogue: 0,0:20:12.14,0:20:15.76,Main,,0,0,0,,...hazine adası Torino Krallığı olduğunu söyler.Dialogue: 0,0:20:22.65,0:20:27.36,Captions,,0,0,180,,Grand Line Kuraigana Adası (Kuraigana: Kasvet, Keder)Dialogue: 0,0:20:27.56,0:20:31.46,Captions,,0,0,170,,Shikkearu Krallığı Harabeleri (Shikkearu: Boğucu, Bunaltıcı)Dialogue: 0,0:20:31.73,0:20:34.05,Main,,0,0,0,,Ona böyle söylediğim doğru:...Dialogue: 0,0:20:34.62,0:20:39.92,Main,,0,0,0,,..."Bir tatile gitseydim, günlerimi lanetli şarkılar söyleyerek geçirebileceğim...Dialogue: 0,0:20:40.30,0:20:45.02,Main,,0,0,0,,...karanlık, kasvetli, perili eski bir kaleye gitmek isterdim."Dialogue: 0,0:20:47.56,0:20:48.79,Main,,0,0,0,,Lanet olası Kuma!Dialogue: 0,0:20:49.27,0:20:51.63,Main,,0,0,0,,Ama kimse bana burada hizmetçi olmayacağını söylemedi!Dialogue: 0,0:20:52.10,0:20:55.30,Main,,0,0,0,,Kimse bana yumuşak bir yatakta uyanmayacağımı, sıcak kakaoyla birlikte...Dialogue: 0,0:20:55.33,0:20:57.46,Main,,0,0,0,,...bagel sandviç servis edilmeyeceğini söylemedi!Dialogue: 0,0:20:57.46,0:21:02.51,Main,,0,0,0,,Kimse bana burada sevimli peluş hayvanların olmayacağını söylememişti!Dialogue: 0,0:21:04.62,0:21:08.27,Main,,0,0,0,,Neredeyim ben? Moria-sama!Dialogue: 0,0:21:08.48,0:21:10.81,Main,,0,0,0,,Thriller Bark'a dönmek istiyorum!Dialogue: 0,0:21:12.96,0:21:14.19,Main,,0,0,0,,Yoksa o...?Dialogue: 0,0:21:17.55,0:21:20.98,Main,,0,0,0,,Biliyordum! Başka biri daha gönderildi!Dialogue: 0,0:21:21.88,0:21:24.77,Main,,0,0,0,,Umarım sevimli biridir!Dialogue: 0,0:21:30.67,0:21:32.92,Main,,0,0,0,,O...Dialogue: 0,0:21:33.90,0:21:36.04,Main,,0,0,0,,...Hasır Şapka tayfasından biri!Dialogue: 0,0:21:37.96,0:21:41.06,Main,,0,0,0,,Kuma tarafından yenilmiş olmalı.Dialogue: 0,0:21:41.53,0:21:43.48,Main,,0,0,0,,Henüz ölmemiş mi?Dialogue: 0,0:22:05.99,0:22:07.80,Main,,0,0,0,,Hayattayım...Dialogue: 0,0:22:08.03,0:22:10.43,Main,,0,0,0,,Neredeyim ben?Dialogue: 0,0:22:25.16,0:22:27.21,Main,,0,0,0,,Burada ne yapıyorsun?Dialogue: 0,0:22:27.21,0:22:29.02,Main,,0,0,0,,Bunu soran ben olmalıyım!Dialogue: 0,0:22:29.02,0:22:30.97,Main,,0,0,0,,Durduk yerde bağırıyorsun.Dialogue: 0,0:22:33.35,0:22:34.92,Main,,0,0,0,,Kılıçlarım nerede?Dialogue: 0,0:22:37.47,0:22:39.72,Main,,0,0,0,,Ah, silahlarını geri mi istiyorsun?Dialogue: 0,0:22:40.66,0:22:41.81,Main,,0,0,0,,Pislik...Dialogue: 0,0:22:49.08,0:22:50.64,Main,,0,0,0,,Günümüze dönüyoruz...Dialogue: 0,0:22:50.83,0:22:53.67,Main,,0,0,0,,Luffy, abisi Ace'in kaçmasına yardım etmek niyetinde...Dialogue: 0,0:22:53.67,0:22:57.77,Main,,0,0,0,,...ve Impel Down'a gitmek için dalgaları aşıyor.Dialogue: 0,0:22:57.82,0:22:59.66,Main,,0,0,0,,Anlamanız için daha kaç kez tekrarlamalıyım?!Dialogue: 0,0:23:09.06,0:23:12.00,Main,,0,0,0,,İlk seferden sonra hatırlamalısın, seni embesil.Dialogue: 0,0:23:13.38,0:23:15.97,Main,,0,0,0,,Yemeklerim 100 kilodan daha az olmamalı!Dialogue: 0,0:23:16.53,0:23:19.42,Main,,0,0,0,,Daha azı açlığımı yatıştırmaz!Dialogue: 0,0:23:21.25,0:23:23.18,Main,,0,0,0,,Seni tekrardan taşa çevirmemi mi istiyorsun?!Dialogue: 0,0:23:23.18,0:23:25.77,Main,,0,0,0,,H-Hayır! Lütfen bağışlayın!Dialogue: 0,0:23:25.77,0:23:27.71,Main,,0,0,0,,Bu kez tam getireceğim!Dialogue: 0,0:23:27.71,0:23:30.12,Main,,0,0,0,,Hemen biri ona başka bir yemek getirsin!Dialogue: 0,0:23:31.79,0:23:33.50,Main,,0,0,0,,O...Dialogue: 0,0:23:34.06,0:23:35.10,Main,,0,0,0,,Onlar örnek...Dialogue: 0,0:23:35.61,0:23:40.43,Main,,0,0,0,,Hancock'un odasını gözetlemeye çalışanın başına bu gelir!Dialogue: 0,0:23:41.17,0:23:42.16,Main,,0,0,0,,Korkunç!Dialogue: 0,0:23:46.09,0:23:49.06,Main,,0,0,0,,İşte Luffy. Ye bakalım!Dialogue: 0,0:23:52.72,0:23:54.27,Main,,0,0,0,,Çok leziz!Dialogue: 0,0:23:55.34,0:24:00.26,Main,,0,0,0,,Üstelik senin yediriyor olman, yemeği daha da iyi yapıyor!Dialogue: 0,0:24:00.26,0:24:02.11,Main,,0,0,0,,Ah, bunu demek istemiş olamazsın.Dialogue: 0,0:24:04.70,0:24:07.24,Main,,0,0,0,,Bu olsaydı...Dialogue: 0,0:24:11.90,0:24:14.59,Main,,0,0,0,,Hey, köşede durmuş ne yapıyorsun öyle?Dialogue: 0,0:24:17.52,0:24:21.01,Main,,0,0,0,,Bir şey yemiyor musun? Deniz Kralı etinin tadı müthiş.Dialogue: 0,0:24:21.01,0:24:24.08,Main,,0,0,0,,B-Ben iyiyim, iyiyim...Dialogue: 0,0:24:24.08,0:24:27.55,Main,,0,0,0,,Kalbim zaten tok.Dialogue: 0,0:24:31.53,0:24:32.80,Main,,0,0,0,,Çok yedim!Dialogue: 0,0:24:32.80,0:24:35.29,Main,,0,0,0,,Harikaydı!Dialogue: 0,0:24:35.29,0:24:36.78,Main,,0,0,0,,L-Luffy!Dialogue: 0,0:24:36.78,0:24:40.21,Main,,0,0,0,,Kaçak olduğunu unuttun mu?Dialogue: 0,0:24:44.51,0:24:47.42,Main,,0,0,0,,Hancock! Odanda başka biri mi var?Dialogue: 0,0:24:47.42,0:24:48.26,Main,,0,0,0,,Eyvah!Dialogue: 0,0:24:48.82,0:24:51.28,Main,,0,0,0,,Teğmen Stalker, duyduğun şeyden emin misin?Dialogue: 0,0:24:51.28,0:24:55.51,Main,,0,0,0,,Evet efendim! Kesinlikle birinin "Bah! Çok yedim!" dediğini duydum!Dialogue: 0,0:24:56.04,0:24:58.89,Main,,0,0,0,,İmparatoriçe gerçekten böyle bir şey söyler mi dersiniz?Dialogue: 0,0:25:00.97,0:25:02.26,Main,,0,0,0,,Mümkün değil!Dialogue: 0,0:25:02.26,0:25:05.70,Main,,0,0,0,,Eğer oysa, saçlarımı mohikan gibi yapacağım!Dialogue: 0,0:25:13.83,0:25:15.35,Main,,0,0,0,,Çok yedim!Dialogue: 0,0:25:15.84,0:25:17.55,Main,,0,0,0,,SÖYLEDİ!Dialogue: 0,0:25:17.88,0:25:19.04,Main,,0,0,0,,Lütfen tabakları alın.Dialogue: 0,0:25:19.10,0:25:20.20,Main,,0,0,0,,Yemek tatmin ediciydi.Dialogue: 0,0:25:20.40,0:25:23.55,Main,,0,0,0,,Unutmayın, her gün bunun gibi beş öğün istiyorum.Dialogue: 0,0:25:23.55,0:25:25.13,Main,,0,0,0,,O kadar çok mu?!Dialogue: 0,0:25:25.13,0:25:27.10,Main,,0,0,0,,Ama o zaman yiyecek bir şeyimiz kalmayacak!Dialogue: 0,0:25:27.55,0:25:30.02,Main,,0,0,0,,Ölseniz de umrumda değil.Dialogue: 0,0:25:30.02,0:25:31.80,Main,,0,0,0,,KORKUNÇSUN!Dialogue: 0,0:25:31.80,0:25:34.19,Main,,0,0,0,,Ama çok güzelsin!Dialogue: 0,0:25:35.18,0:25:40.70,Main,,0,0,0,,Portgas D. Ace'in idam edilmesine altı gün kaldı.Dialogue: 0,0:25:43.10,0:25:46.42,Main,,0,0,0,,Beyazsakal, kendisini izlemesi için gönderilen gözcüleri yok ederek...Dialogue: 0,0:25:46.42,0:25:49.25,Main,,0,0,0,,...Denizci Karargâhı'ndaki gerilimi iki katına çıkardı.Dialogue: 0,0:25:49.54,0:25:51.24,Main,,0,0,0,,Marineford limanı,...Dialogue: 0,0:25:51.28,0:25:55.72,Main,,0,0,0,,...dünyanın her yerindeki karakollarından dönen güçlü ve tanınmış denizcilerle kaynıyor.Dialogue: 0,0:26:07.75,0:26:10.39,Main,,0,0,0,,"Adalet" adını taşıyan tüm güçler...Dialogue: 0,0:26:10.39,0:26:13.16,Main,,0,0,0,,...Denizci Karargâhı'nda toplandı.Dialogue: 0,0:26:15.56,0:26:19.05,Main,,0,0,0,,Bu arada, Mariejoa'nın Kutsal Toprakları'nda...Dialogue: 0,0:26:22.05,0:26:24.97,Main,,0,0,0,,...toplanmış olan Yedi Savaş Lordu üyelerine...Dialogue: 0,0:26:24.97,0:26:27.60,Main,,0,0,0,,...kendi savaş birimlerini oluşturma talimatı verildi.Dialogue: 0,0:26:28.24,0:26:31.86,Main,,0,0,0,,Zaptedilemez uyumsuzların toplanışı.Dialogue: 0,0:26:34.03,0:26:36.61,Main,,0,0,0,,Kesin olarak söylenebilecek tek bir şey var:...Dialogue: 0,0:26:36.61,0:26:42.49,Main,,0,0,0,,...Bu adamların birlikte dövüşüyor olmaları fikri düşünülemez.Dialogue: 0,0:26:51.36,0:26:52.79,Main,,0,0,0,,Öldür mü dedin?Dialogue: 0,0:26:53.33,0:26:54.84,Main,,0,0,0,,Ahmak!Dialogue: 0,0:26:54.84,0:26:57.83,Main,,0,0,0,,Şu anda yapabileceğimiz her şey manasız olurdu.Dialogue: 0,0:26:58.29,0:27:02.84,Main,,0,0,0,,Şu anda ölseydin bile,  bu Beyazsakal'ı durdurmazdı.Dialogue: 0,0:27:06.63,0:27:08.84,Main,,0,0,0,,Artık bunu kimse durduramaz.Dialogue: 0,0:27:11.14,0:27:13.51,Main,,0,0,0,,Denizlerin kralını...Dialogue: 0,0:27:15.74,0:27:17.92,Main,,0,0,0,,...kızdırdık!Dialogue: 0,0:00:05.30,0:00:09.17,OP11 Lyrics,,0,0,0,,♪ Gökyüzüne ulaşana kadar, ♪Dialogue: 0,0:00:09.27,0:00:15.71,OP11 Lyrics,,0,0,0,,♪ İnanıyorum, sonraki yarına kadar, hey ♪Dialogue: 0,0:00:15.73,0:00:19.13,OP11 Lyrics,,0,0,0,,♪ hadi millet gidelim, müziği paylaşıyoruz. ♪Dialogue: 0,0:00:19.96,0:00:23.36,OP11 Lyrics,,0,0,0,,♪ hadi gidelim bebeğim, bebeğim, oh tek bir hayali paylaşıyoruz. ♪Dialogue: 0,0:00:23.88,0:00:27.28,OP11 Lyrics,,0,0,0,,♪ hadi millet gidelim, oh iyi zamanları paylaşıyoruz. ♪Dialogue: 0,0:00:27.71,0:00:31.11,OP11 Lyrics,,0,0,0,,♪ hadi gidelim bebeğim, bebeğim, oh tek bir dünyayı paylaşıyoruz. ♪Dialogue: 0,0:00:31.81,0:00:35.55,OP11 Lyrics,,0,0,0,,♪ Mobius yüzüğünün tepesinde kovalıyor ve kovalanıyor. ♪Dialogue: 0,0:00:35.58,0:00:39.35,OP11 Lyrics,,0,0,0,,♪ Yaklaşıyor ve ileri bakıyorum, hey tarzını paylaşmak istiyorum. ♪Dialogue: 0,0:00:39.52,0:00:43.45,OP11 Lyrics,,0,0,0,,♪ Başlıyor, genişliyor, hayal gücünün üstündeki bu tat. ♪Dialogue: 0,0:00:43.52,0:00:47.76,OP11 Lyrics,,0,0,0,,♪ Vücudumu baştan başa iyi hissediyorum, özgür kalacağım, oh evet ♪Dialogue: 0,0:00:47.79,0:00:49.79,OP11 Lyrics,,0,0,0,,♪ Uzakta olsa da, müziği paylaş. ♪Dialogue: 0,0:00:49.79,0:00:51.73,OP11 Lyrics,,0,0,0,,♪ Birbirine anlatarak o rüyayı paylaş. ♪Dialogue: 0,0:00:51.76,0:00:53.60,OP11 Lyrics,,0,0,0,,♪ İyi zamanları ve kahkahaları paylaş. ♪Dialogue: 0,0:00:53.72,0:00:55.27,OP11 Lyrics,,0,0,0,,♪ şimdi tek bir dünyayı paylaş. ♪Dialogue: 0,0:00:55.45,0:01:03.74,OP11 Lyrics,,0,0,0,,♪ Gökyüzüne ulaşana kadar gitmeye devam edeceğim. ♪Dialogue: 0,0:01:03.81,0:01:13.05,OP11 Lyrics,,0,0,0,,♪ Hadi üstesinden gelelim, sonraki yarınlara inanıyorum, evet evet... ♪Dialogue: 0,0:01:13.15,0:01:21.56,OP11 Lyrics,,0,0,0,,♪ Görünmez duvarın diğer tarafında bekliyordun. ♪Dialogue: 0,0:01:21.66,0:01:31.62,OP11 Lyrics,,0,0,0,,♪ Yakında orada olacağım, tek bir dünyaya inanıyorum, evet evet... ♪Dialogue: 0,0:01:31.64,0:01:35.04,OP11 Lyrics,,0,0,0,,♪ hadi millet gidelim, müziği paylaşıyoruz. ♪Dialogue: 0,0:01:35.67,0:01:39.87,OP11 Lyrics,,0,0,0,,♪ hadi gidelim bebeğim, bebeğim, oh tek bir dünyayı paylaşıyoruz. ♪Dialogue: 0,0:00:31.86,0:00:37.23,OP11 Credits,,0,0,0,,Translation YibisDialogue: 0,0:00:31.86,0:00:37.23,OP11 Credits,,0,0,0,,Soundtracking HaleeDialogue: 0,0:00:31.86,0:00:37.23,OP11 Credits,,0,0,0,,Editing SewilDialogue: 0,0:00:37.37,0:00:42.10,OP11 Credits,,0,0,0,,Infoboxes/title card BernieCraneDialogue: 0,0:00:37.37,0:00:42.10,OP11 Credits,,0,0,0,,Timing DatenshiDialogue: 0,0:00:37.37,0:00:42.10,OP11 Credits,,0,0,0,,Quality checking Galaxy 9000 alasta Mr. Luffy