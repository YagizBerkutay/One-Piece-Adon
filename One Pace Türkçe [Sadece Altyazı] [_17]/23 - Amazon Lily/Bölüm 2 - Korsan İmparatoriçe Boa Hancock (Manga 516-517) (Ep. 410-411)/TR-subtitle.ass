Dialogue: 0,0:01:42.50,0:01:43.34,Main,,0,0,0,,İşte.
Dialogue: 0,0:01:44.14,0:01:45.38,Main,,0,0,0,,Teşekkürler.
Dialogue: 0,0:01:46.94,0:01:48.59,Main,,0,0,0,,Fırfırlardan nefret etmek...
Dialogue: 0,0:01:48.74,0:01:51.22,Main,,0,0,0,,Erkekler gerçekten tuhaf varlıklar.
Dialogue: 0,0:01:51.72,0:01:53.74,Main,,0,0,0,,Eh, sanırım öyle.
Dialogue: 0,0:01:54.00,0:01:55.43,Main,,0,0,0,,Çıkardığın için teşekkürler!
Dialogue: 0,0:01:55.90,0:01:56.90,Main,,0,0,0,,Görüşürüz o halde!
Dialogue: 0,0:01:56.90,0:02:00.05,Main,,0,0,0,,Arkadaşlarımı bulana dek \Nsakin olmam mümkün değil!
Dialogue: 0,0:02:00.05,0:02:01.27,Main,,0,0,0,,Epey acelecisin...
Dialogue: 0,0:02:05.12,0:02:09.34,Main,,0,0,0,,Benim gibi diğerleri de \Nhayatta olduğu sürece sorun değil.
Dialogue: 0,0:02:09.99,0:02:11.58,Main,,0,0,0,,Hayatta oldukları sürece...
Dialogue: 0,0:02:12.09,0:02:14.00,Main,,0,0,0,,Tekrar tekrar savaşabilirim!
Dialogue: 0,0:02:22.62,0:02:24.98,Main,,0,0,0,,O insanların hepsini yeneceğim!
Dialogue: 0,0:02:28.08,0:02:31.62,Main,,0,0,0,,Tamam! Sabaody Takımadaları'na kadar \Nellerimin üzerinde yürüyeceğim!
Dialogue: 0,0:02:31.76,0:02:34.00,Main,,0,0,0,,Bu beni güçlendirecek!
Dialogue: 0,0:02:39.10,0:02:40.48,Main,,0,0,0,,Bana bir gemi verebilir misin?
Dialogue: 0,0:02:40.86,0:02:42.60,Main,,0,0,0,,Gerçekten acelecisin...
Dialogue: 0,0:02:43.22,0:02:44.70,Main,,0,0,0,,Hiç geminiz yok mu?!
Dialogue: 0,0:02:44.90,0:02:46.48,Main,,0,0,0,,Burası Calm Belt mi?!
Dialogue: 0,0:02:44.90,0:02:46.48,Note,,0,0,0,,Calm Belt: Sükunet Kuşağı
Dialogue: 0,0:02:47.10,0:02:52.27,Title,,0,0,150,,{\fad(1000,700)}Korsan İmparatoriçe\N\N\N\N\N\N\N\N\N\N\N\NBoa Hancock
Dialogue: 0,0:02:46.88,0:02:48.02,Main,,0,0,0,,Bu doğru.
Dialogue: 0,0:02:48.02,0:02:53.55,Main,,0,0,0,,Bu kadınlar adası, Calm Belt olarak bilinen \Ndev Deniz Kralı yatağı tarafından çevrilidir.
Dialogue: 0,0:02:54.16,0:02:57.59,Main,,0,0,0,,Bu yüzden denizciler buraya gelmeye cüret edemez.
Dialogue: 0,0:02:57.59,0:03:02.20,Main,,0,0,0,,Yolunu kaybedenler bazen bir mucize eseri buraya ulaşır. Ancak çoktan ölmüş olurlar.
Dialogue: 0,0:03:02.20,0:03:05.03,Main,,0,0,0,,Ama burada bir korsan grubu olduğunu söylemiştin!
Dialogue: 0,0:03:05.03,0:03:10.62,Main,,0,0,0,,Yılan Prenses'in korsan gemisi Yuda, vahşi ve zehirli yılanlar tarafından çekilir.
Dialogue: 0,0:03:10.62,0:03:12.84,Main,,0,0,0,,Deniz Kralları ona saldıramaz.
Dialogue: 0,0:03:12.84,0:03:15.31,Main,,0,0,0,,Amazon Lily'deki tek gemi odur!
Dialogue: 0,0:03:17.44,0:03:19.04,Main,,0,0,0,,Şimdi ne yapacağım?
Dialogue: 0,0:03:19.04,0:03:20.36,Main,,0,0,0,,Rüzgar yok...
Dialogue: 0,0:03:20.36,0:03:22.58,Main,,0,0,0,,Bir sal yapıp tüm yolu kürek mi çekmeliyim?
Dialogue: 0,0:03:23.54,0:03:24.88,Main,,0,0,0,,Saçmalık...
Dialogue: 0,0:03:25.28,0:03:28.04,Main,,0,0,0,,Tamam! \NBir sal yapıp tüm yolu kürek çekerek gideceğim!
Dialogue: 0,0:03:28.04,0:03:29.54,Main,,0,0,0,,Bunu mu düşünebildin!
Dialogue: 0,0:03:30.74,0:03:32.24,Main,,0,0,0,,Bitti!
Dialogue: 0,0:03:32.24,0:03:34.36,Main,,0,0,0,,Rezil bir sal! Parçalanmaya başladı bile!
Dialogue: 0,0:03:48.15,0:03:49.77,Main,,0,0,0,,Seni kurtarmak zorunda değildim!
Dialogue: 0,0:03:50.66,0:03:53.18,Main,,0,0,0,,Erkek korsanlar yüzemiyor mu?
Dialogue: 0,0:03:54.74,0:03:55.65,Main,,0,0,0,,Ucuz atlattım!
Dialogue: 0,0:03:56.22,0:03:57.43,Main,,0,0,0,,Kahretsin!
Dialogue: 0,0:03:57.66,0:03:59.72,Main,,0,0,0,,Keşke Franky burda olsaydı!
Dialogue: 0,0:04:00.00,0:04:01.40,Main,,0,0,0,,Ne yapacağımı bilmiyorum!
Dialogue: 0,0:04:01.62,0:04:03.46,Main,,0,0,0,,Asıl ben ne yapacağımı bilmiyorum!
Dialogue: 0,0:04:05.42,0:04:08.21,Main,,0,0,0,,Burdan daha uzağa kaçabilirdin...
Dialogue: 0,0:04:15.62,0:04:18.24,Main,,0,0,0,,Bunu sürdürürsek sana daha çok bağlanacağım!
Dialogue: 0,0:04:19.66,0:04:21.22,Main,,0,0,0,,Hey, hey! Kes şunu!
Dialogue: 0,0:04:21.68,0:04:22.88,Main,,0,0,0,,Ne yapıyorsun?!
Dialogue: 0,0:04:33.50,0:04:35.18,Main,,0,0,0,,Ah evet! Şu oklar!
Dialogue: 0,0:04:35.46,0:04:40.78,Main,,0,0,0,,Ben kovalanırken \Ntaş duvarları bile yok edecek kadar güçlülerdi!
Dialogue: 0,0:04:42.44,0:04:44.50,Main,,0,0,0,,Özel oklar gibi de görünmüyorlar...
Dialogue: 0,0:04:45.84,0:04:47.12,Main,,0,0,0,,Neden bahsediyorsun sen?
Dialogue: 0,0:04:47.36,0:04:49.20,Main,,0,0,0,,Bu okların içinde Haki* var!
Dialogue: 0,0:04:49.54,0:04:50.88,Main,,0,0,0,,Elbette çok güçlüler!
Dialogue: 0,0:04:51.08,0:04:52.08,Main,,0,0,0,,Haki mi?
Dialogue: 0,0:04:52.32,0:04:53.48,Main,,0,0,0,,O da nedir?!
Dialogue: 0,0:04:54.50,0:04:55.72,Main,,0,0,0,,İşte orada!
Dialogue: 0,0:04:55.92,0:04:57.52,Main,,0,0,0,,Marguerite iyi!
Dialogue: 0,0:04:59.66,0:05:00.36,Main,,0,0,0,,Arkadaşlar!
Dialogue: 0,0:05:00.60,0:05:02.26,Main,,0,0,0,,Erkek de onunla beraber! Öldürün onu!
Dialogue: 0,0:05:02.64,0:05:03.88,Main,,0,0,0,,Eyvah!
Dialogue: 0,0:05:04.12,0:05:04.93,Main,,0,0,0,,Olduğun yerde kal!
Dialogue: 0,0:05:08.10,0:05:09.05,Main,,0,0,0,,Dur!
Dialogue: 0,0:05:09.56,0:05:11.88,Main,,0,0,0,,Marguerite! İyi misin?!
Dialogue: 0,0:05:12.20,0:05:13.88,Main,,0,0,0,,Acele edip o adamı halletmemiz gerek!
Dialogue: 0,0:05:13.96,0:05:15.86,Main,,0,0,0,,Yılan Prenses döndü!
Dialogue: 0,0:05:16.74,0:05:20.87,Captions,,815,0,250,,{\fad(1100,0)}\N\N\N\N\N\N\N\N\N\N\NCalm Belt\NKadınlar Adası Açıkları
Dialogue: 0,0:05:20.30,0:05:24.76,Main,,0,0,0,,Bu canavar dolu sulara \Ndemir attığınıza göre epey cesursunuz.
Dialogue: 0,0:05:27.68,0:05:31.22,Main,,0,0,0,,Evet. Ayrıca az önce saldırıya uğradık!
Dialogue: 0,0:05:32.40,0:05:35.86,Main,,0,0,0,,Geminin bordasındaki deniz taşı varlığımızı gizliyor,...
Dialogue: 0,0:05:35.98,0:05:40.42,Main,,0,0,0,,...yine de burada uzun süre demirlemek \Ngörsel olarak dikkatleri çekiyor.
Dialogue: 0,0:05:41.42,0:05:45.88,Main,,0,0,0,,Bizim için kolay değil ama \Nhükümet ve Kuja arasındaki anlaşma...
Dialogue: 0,0:05:46.00,0:05:51.44,Main,,0,0,0,,...adanıza üç kilometreden fazla yaklaşmamızı yasaklıyor.
Dialogue: 0,0:05:52.40,0:05:57.42,Main,,0,0,0,,Dolayısıyla bu canavar ininin \Ntam ortasında beklemek zorunda kaldık.
Dialogue: 0,0:05:58.34,0:05:59.19,Main,,0,0,0,,Duydunuz mu?
Dialogue: 0,0:05:59.38,0:06:02.70,Main,,0,0,0,,Kuja'ların insanları taşa dönüştüren yaratıklar olduklarını söylüyorlar!
Dialogue: 0,0:06:03.12,0:06:03.89,Main,,0,0,0,,Saçmalama!
Dialogue: 0,0:06:04.76,0:06:07.48,Main,,0,0,0,,Bu Deniz Kralı'nı sen mi öldürdün?
Dialogue: 0,0:06:09.16,0:06:12.80,Main,,0,0,0,,Grand Line'da Deniz Kralları'na rastlamak \Npek de sıradışı değil...
Dialogue: 0,0:06:19.42,0:06:20.28,Flashbacks,,0,0,0,,Bu imkansız!
Dialogue: 0,0:06:20.42,0:06:22.30,Flashbacks,,0,0,0,,Toplar bile etki etmiyor?!
Dialogue: 0,0:06:36.10,0:06:37.01,Flashbacks,,0,0,0,,Bu...
Dialogue: 0,0:06:37.60,0:06:38.56,Flashbacks,,0,0,0,,Koramiral!
Dialogue: 0,0:06:40.40,0:06:44.10,Flashbacks,,0,0,0,,Deniz Kralı'na bir savaş gemisini yem etseydik...
Dialogue: 0,0:06:45.12,0:06:47.30,Flashbacks,,0,0,0,,...adalet ayaklar altına alınmış olurdu!
Dialogue: 0,0:06:56.20,0:06:59.18,Main,,0,0,0,,Buraya Deniz Kralı avlamaya gelmedim.
Dialogue: 0,0:06:59.62,0:07:02.92,Main,,0,0,0,,Burada işimi bitirip hızlıca bu suları terk etmek istiyorum.
Dialogue: 0,0:07:04.60,0:07:06.85,Main,,0,0,0,,Yetenekli birine benziyorsun.
Dialogue: 0,0:07:08.06,0:07:09.44,Main,,0,0,0,,Beklemekten yorulmuştum!
Dialogue: 0,0:07:09.56,0:07:12.15,Main,,0,0,0,,Sonunda döndünüz Kuja Korsanları!
Dialogue: 0,0:07:13.22,0:07:16.52,Main,,0,0,0,,Ben, Denizci Karargahı'ndan Koramiral Momonga!
Dialogue: 0,0:07:17.48,0:07:20.98,Note,,0,0,0,,Shichibukai = Denizin Yedi Savaş Ağası
Dialogue: 0,0:07:17.48,0:07:20.98,Main,,0,0,0,,Shichibukai Korsan İmparatoriçe Boa Hancock!
Dialogue: 0,0:07:21.28,0:07:24.23,Main,,0,0,0,,Göster kendini! Senin için geldim!
Dialogue: 0,0:07:24.72,0:07:27.60,Main,,0,0,0,,Üzgünüm ama Yılan Prenses sizinle görüşmeyecek.
Dialogue: 0,0:07:27.84,0:07:30.06,Main,,0,0,0,,Bunu birçok kez açıkladık!
Dialogue: 0,0:07:30.26,0:07:33.34,Main,,0,0,0,,Siz erkekler! Çok basit varlıklarsınız!
Dialogue: 0,0:07:33.48,0:07:35.75,Main,,0,0,0,,Canlı bir erkek görmeyeli uzun zaman oldu!
Dialogue: 0,0:07:35.96,0:07:40.56,Main,,0,0,0,,Korsanlar ve tacirler Kuja bayrağını görünce kaçarlar!
Dialogue: 0,0:07:41.84,0:07:43.40,Main,,0,0,0,,Hey. Bu çok kaba bir gülüş.
Dialogue: 0,0:07:43.92,0:07:45.42,Main,,0,0,0,,Cevabınızı almıştık...
Dialogue: 0,0:07:45.62,0:07:47.84,Main,,0,0,0,,"Derhal toplanma emirlerinize uyacağım."
Dialogue: 0,0:07:47.94,0:07:50.50,Main,,0,0,0,,Ancak gelişinize dair hiçbir haber alamadık!
Dialogue: 0,0:07:52.00,0:07:53.30,Main,,0,0,0,,Bugünün gazetesi.
Dialogue: 0,0:07:53.70,0:07:57.60,Main,,0,0,0,,Beyazsakal Korsanları'nın 2. Bölük Komutanı, \NPortgas D. Ace'in....
Dialogue: 0,0:07:57.70,0:08:00.58,Main,,0,0,0,,...halka açık infazı için yer ve zaman belirlendi.
Dialogue: 0,0:08:00.70,0:08:02.06,Main,,0,0,0,,Artık geri dönüş yok!
Dialogue: 0,0:08:03.06,0:08:05.42,Main,,0,0,0,,Dünya hükümeti kesin emirler verdi...
Dialogue: 0,0:08:05.54,0:08:07.62,Main,,0,0,0,,Tüm Shichibukai'nin toplanması için!
Dialogue: 0,0:08:08.12,0:08:10.17,Main,,0,0,0,,Gelmeyi reddederseniz anlaşma düşer!
Dialogue: 0,0:08:10.44,0:08:12.82,Main,,0,0,0,,Shichibukai unvanınız da elinizden alınır!
Dialogue: 0,0:08:13.66,0:08:16.68,Main,,0,0,0,,Bunu duydun mu, Boa Hancock?!
Dialogue: 0,0:08:23.40,0:08:27.84,Main,,0,0,0,,Kim yoluma...
Dialogue: 0,0:08:28.52,0:08:30.54,Main,,0,0,0,,...bir yavru kedi bıraktı?!
Dialogue: 0,0:08:33.28,0:08:35.14,Main,,0,0,0,,En içten özürlerimi sunuyorum!
Dialogue: 0,0:08:35.26,0:08:36.77,Main,,0,0,0,,Sorumlusu benim!
Dialogue: 0,0:08:37.60,0:08:38.82,Main,,0,0,0,,Daha dikkatli ol.
Dialogue: 0,0:08:38.88,0:08:39.79,Main,,0,0,0,,O-olacağım!
Dialogue: 0,0:08:40.34,0:08:41.30,Main,,0,0,0,,Sessiz ol!
Dialogue: 0,0:08:41.54,0:08:43.82,Main,,0,0,0,,Demek ortaya çıktın, Boa Hancock!
Dialogue: 0,0:08:52.00,0:08:53.62,Main,,0,0,0,,Gardınızı indirmeyin beyler!
Dialogue: 0,0:08:54.12,0:08:56.31,Main,,0,0,0,,Bu Korsan İmparatoriçe mi?!
Dialogue: 0,0:08:56.38,0:08:58.58,Main,,0,0,0,,Dünya üzerindeki en güzel kadın!
Dialogue: 0,0:08:58.77,0:09:03.43,Captions,,0,0,0,,{\fad(650,0)}Amazon Lily İmparatoriçesi, Kuja Korsanları'nın Kaptanı\N\N\N\N\N\N\N\N\N\N\N\N\NShichibukai – ‘İmparatoriçe’ Boa Hancock
Dialogue: 0,0:09:00.34,0:09:02.80,Main,,0,0,0,,{\a6}Demek sonunda benim için geldin...
Dialogue: 0,0:09:05.26,0:09:07.18,Main,,0,0,0,,Ne sıkıcı insanlar.
Dialogue: 0,0:09:07.98,0:09:12.11,Captions,,0,0,0,,{\fad(500,0)}Gorgon Kardeşler'in en genci\N\N\N\N\N\N\N\N\N\N\NBoa Marigold
Dialogue: 0,0:09:09.30,0:09:12.10,Main,,0,0,0,,{\a6}Son cevabım yalandı.
Dialogue: 0,0:09:12.30,0:09:16.68,Captions,,0,0,0,,{\fad(500,0)}Gorgon Kardeşler'in ortancası\N\N\N\N\N\N\N\N\N\NBoa Sandersonia
Dialogue: 0,0:09:13.30,0:09:16.08,Main,,0,0,0,,{\a6}Savaşa gitmeyeceğim!
Dialogue: 0,0:09:17.34,0:09:18.20,Main,,0,0,0,,Ama...
Dialogue: 0,0:09:18.68,0:09:22.17,Main,,0,0,0,,Shichibukai unvanımı da \Ntutmama izin vermenizi istiyorum.
Dialogue: 0,0:09:26.10,0:09:27.12,Main,,0,0,0,,Ve...
Dialogue: 0,0:09:27.48,0:09:30.65,Main,,0,0,0,,Bu gemideki tüm mallarınızı da istiyorum.
Dialogue: 0,0:09:32.10,0:09:33.75,Main,,0,0,0,,Bu nasıl bir saçmalık böyle?!
Dialogue: 0,0:09:33.94,0:09:35.85,Main,,0,0,0,,Bencil bir çocuk gibi davranmayı kes!
Dialogue: 0,0:09:36.46,0:09:40.16,Main,,0,0,0,,Gerçekten böyle çirkin talepleri \Nkabul edeceğimize inanıyor musunuz?!
Dialogue: 0,0:09:40.92,0:09:42.50,Main,,0,0,0,,Acele edin ve taşıyın!
Dialogue: 0,0:09:43.26,0:09:45.21,Main,,0,0,0,,Ne kadar güzel bir kadın!
Dialogue: 0,0:09:45.38,0:09:46.88,Main,,0,0,0,,Ona her şeyimi veririm!
Dialogue: 0,0:09:47.00,0:09:48.96,Main,,0,0,0,,Neden mallarımızı götürüyorsunuz?!
Dialogue: 0,0:09:49.10,0:09:50.20,Main,,0,0,0,,Kendinize gelin!
Dialogue: 0,0:09:51.10,0:09:52.90,Main,,0,0,0,,Ah olamaz! Körlemesine onu dinledim!
Dialogue: 0,0:09:56.02,0:09:59.94,Main,,0,0,0,,Portgas D. Ace'in halka açık infazı tam bir hafta sonra!
Dialogue: 0,0:10:00.90,0:10:06.94,Main,,0,0,0,,Ateş Yumruk Ace'in hayatı Denizci Karargahı şehri Marineford'un şehir meydanında sona erecek!
Dialogue: 0,0:10:07.60,0:10:12.04,Main,,0,0,0,,Diğer bir deyişle Beyazsakal \Nbir hafta içinde bir hamle yapmalı.
Dialogue: 0,0:10:12.74,0:10:16.12,Main,,0,0,0,,Donanma Karargahı, \Nüç amiral tarafından yönetilerek,...
Dialogue: 0,0:10:16.28,0:10:20.40,Main,,0,0,0,,...tam askeri güçleriyle \NBeyazsakal'a karşı koymaya hazırlandı!
Dialogue: 0,0:10:21.22,0:10:24.68,Main,,0,0,0,,Unvanını kayıp mı edeceksin yoksa toplanma emrine mi uyacaksın?!
Dialogue: 0,0:10:25.04,0:10:26.32,Main,,0,0,0,,Karar ver!
Dialogue: 0,0:10:26.56,0:10:28.46,Main,,0,0,0,,Zamanın doluyor!
Dialogue: 0,0:10:29.16,0:10:31.74,Main,,0,0,0,,Shichibukai unvanımı seviyorum.
Dialogue: 0,0:10:32.08,0:10:33.84,Main,,0,0,0,,Benden alınmasını istemem.
Dialogue: 0,0:10:34.78,0:10:37.14,Main,,0,0,0,,Ama Dünya Hükümetinden de nefret ederim.
Dialogue: 0,0:10:37.52,0:10:39.80,Main,,0,0,0,,Emirlerine uymak istemiyorum.
Dialogue: 0,0:10:41.44,0:10:43.24,Main,,0,0,0,,Şu kulağa nasıl geliyor?
Dialogue: 0,0:10:43.98,0:10:46.86,Main,,0,0,0,,Denizciler beni almaya geldiler...
Dialogue: 0,0:10:47.08,0:10:49.26,Main,,0,0,0,,...denizde esrarengiz bir kazaya karışıp...
Dialogue: 0,0:10:49.36,0:10:52.38,Main,,0,0,0,,...taşlaşarak silinip gittiler?
Dialogue: 0,0:10:53.26,0:10:54.56,Main,,0,0,0,,Bir şey yapmayı planlıyor!
Dialogue: 0,0:10:54.70,0:10:55.88,Main,,0,0,0,,Gardınızı indirmeyin!
Dialogue: 0,0:10:56.08,0:10:57.96,Main,,0,0,0,,Bunu daha önce duymuştum!
Dialogue: 0,0:10:58.24,0:11:00.28,Main,,0,0,0,,Kuja Korsan Gemisi tarafından \Nsaldırıya uğrayan bir gemi...
Dialogue: 0,0:11:00.46,0:11:05.30,Main,,0,0,0,,Daha sonra bulunduğunda sadece garip heykeller gemide varmış!
Dialogue: 0,0:11:08.88,0:11:10.26,Main,,0,0,0,,H-h-heykeller mi?!
Dialogue: 0,0:11:13.06,0:11:14.61,Main,,0,0,0,,Sana söyledim!
Dialogue: 0,0:11:14.80,0:11:17.64,Main,,0,0,0,,Çocukça ve bencil hamlelerine izin vermeyeceğim!
Dialogue: 0,0:11:19.32,0:11:21.82,Main,,0,0,0,,Büyük kız kardeş korkunç biridir.
Dialogue: 0,0:11:21.98,0:11:24.28,Main,,0,0,0,,İstediği her şeyi alır.
Dialogue: 0,0:11:24.42,0:11:25.34,Main,,0,0,0,,Evet.
Dialogue: 0,0:11:25.64,0:11:27.76,Main,,0,0,0,,Bunun bir nedeni var.
Dialogue: 0,0:11:33.36,0:11:35.00,Main,,0,0,0,,Neden biliyor musun?
Dialogue: 0,0:11:35.22,0:11:37.50,Main,,0,0,0,,Çünkü ne yaparsam yapayım...
Dialogue: 0,0:11:38.80,0:11:40.50,Main,,0,0,0,,Bir yavru kediyi tekmelesem bile...
Dialogue: 0,0:11:40.76,0:11:43.42,Main,,0,0,0,,Kulaklarınızı çekip koparsam bile...
Dialogue: 0,0:11:44.64,0:11:48.44,Main,,0,0,0,,Ya da birini öldürsem bile, \Ndünyadaki herkes beni affeder.
Dialogue: 0,0:11:48.58,0:11:49.76,Main,,0,0,0,,Bunun nedeni...
Dialogue: 0,0:11:49.98,0:11:50.96,Main,,0,0,0,,Evet...
Dialogue: 0,0:11:51.90,0:11:53.90,Main,,0,0,0,,Çünkü güzelim!
Dialogue: 0,0:11:54.25,0:11:56.00,Secondary,,0,0,0,,Çünkü güzelim...!
Dialogue: 0,0:11:56.22,0:11:57.76,Secondary,,0,0,0,,Çünkü güzelim...!
Dialogue: 0,0:11:58.88,0:12:00.62,Main,,0,0,0,,Yılan Prenses!
Dialogue: 0,0:12:01.48,0:12:03.10,Main,,0,0,0,,İstediğin her şeyi yapabilirsin!
Dialogue: 0,0:12:03.18,0:12:05.44,Main,,0,0,0,,Çünkü çok güzelsin!
Dialogue: 0,0:12:05.56,0:12:07.42,Main,,0,0,0,,Hepiniz, kesin şunu!
Dialogue: 0,0:12:08.02,0:12:10.90,Main,,0,0,0,,Benim cazibem yüzünden vicdanınız...
Dialogue: 0,0:12:11.88,0:12:14.38,Main,,0,0,0,,...bedeninizi katılaştıracak!
Dialogue: 0,0:12:18.82,0:12:20.50,Main,,0,0,0,,{\fad(150,150)}Mero Mero Mellow!
Dialogue: 0,0:12:18.82,0:12:20.50,Note,,0,0,0,,Aşk-Aşk Işını
Dialogue: 0,0:12:23.94,0:12:24.60,Main,,0,0,0,,Hanco--!
Dialogue: 0,0:12:34.80,0:12:37.52,Main,,0,0,0,,Bir denizci koramiralinden daha azını beklemezdim...
Dialogue: 0,0:12:38.40,0:12:39.58,Main,,0,0,0,,Anlıyorum.
Dialogue: 0,0:12:40.04,0:12:42.66,Main,,0,0,0,,Kötü düşünceleri engellemek için acıyı kullandın.
Dialogue: 0,0:12:43.64,0:12:45.44,Main,,0,0,0,,Kesinlikle tecrübelisin.
Dialogue: 0,0:12:46.28,0:12:47.10,Main,,0,0,0,,Ancak...
Dialogue: 0,0:12:47.96,0:12:50.24,Main,,0,0,0,,Adamların için aynısını söyleyemem.
Dialogue: 0,0:12:50.98,0:12:52.60,Main,,0,0,0,,Ahmaklar...!
Dialogue: 0,0:12:53.72,0:12:55.48,Main,,0,0,0,,Bir tek sen kaldın gibi görünüyor.
Dialogue: 0,0:12:58.82,0:13:01.70,Main,,0,0,0,,Bir ve sıfır aynı şey değillerdir.
Dialogue: 0,0:13:24.66,0:13:27.82,Main,,0,0,0,,Şimdi barış içindeki Amazon Lily'e dönelim!
Dialogue: 0,0:13:27.92,0:13:29.32,Main,,0,0,0,,Anlaşıldı Yılan Prenses!
Dialogue: 0,0:13:33.08,0:13:34.78,Main,,0,0,0,,Boa Hancock!
Dialogue: 0,0:13:35.10,0:13:36.74,Main,,0,0,0,,Burada sonuna kadar bekleyeceğim!
Dialogue: 0,0:13:36.98,0:13:38.48,Main,,0,0,0,,Elim boş dönmeyeceğim!
Dialogue: 0,0:13:38.78,0:13:41.36,Main,,0,0,0,,Eğer iki gün içinde tekrar kendini göstermezsen...
Dialogue: 0,0:13:42.32,0:13:44.00,Main,,0,0,0,,...anlaşma bozulur!
Dialogue: 0,0:13:50.36,0:13:51.72,Main,,0,0,0,,Dilediğini yap.
Dialogue: 0,0:13:57.64,0:13:59.28,Main,,0,0,0,,Kapıları açın!
Dialogue: 0,0:14:01.36,0:14:04.49,Main,,0,0,0,,Yılan Prenses döndü!
Dialogue: 0,0:14:04.64,0:14:06.30,Main,,0,0,0,,Hoş geldiniz!
Dialogue: 0,0:14:07.28,0:14:09.98,Main,,0,0,0,,Hoş geldiniz Kuja Korsanları!
Dialogue: 0,0:14:12.24,0:14:14.70,Main,,0,0,0,,Yılan Prenses!
Dialogue: 0,0:14:17.60,0:14:18.80,Main,,0,0,0,,Ran-sama!
Dialogue: 0,0:14:18.96,0:14:20.26,Main,,0,0,0,,Daisy-sama!
Dialogue: 0,0:14:20.38,0:14:21.92,Main,,0,0,0,,Büyük vurgun yaptık!
Dialogue: 0,0:14:23.04,0:14:24.46,Main,,0,0,0,,Çok havalılar!
Dialogue: 0,0:14:24.66,0:14:27.26,Main,,0,0,0,,Ben de bir gün korsan olacağım!
Dialogue: 0,0:14:32.20,0:14:33.86,Main,,0,0,0,,Gorgon kardeşler!
Dialogue: 0,0:14:37.96,0:14:41.00,Main,,0,0,0,,Yılan Prenses! Yılan Prenses!
Dialogue: 0,0:14:46.60,0:14:47.86,Main,,0,0,0,,Eve Hoşgeldiniz.
Dialogue: 0,0:14:48.12,0:14:49.84,Main,,0,0,0,,Taşıyıcınız hazır.
Dialogue: 0,0:14:50.86,0:14:52.18,Main,,0,0,0,,Önemli bir şey oldu mu?
Dialogue: 0,0:14:52.42,0:14:54.88,Main,,0,0,0,,Hayır. Hayır olmadı...
Dialogue: 0,0:14:59.12,0:15:02.70,Main,,0,0,0,,Demir cevheri, barut, alkol ve kuzeyden ekin...
Dialogue: 0,0:15:02.90,0:15:04.70,Main,,0,0,0,,Epey etkileyici bir ganimet!
Dialogue: 0,0:15:05.16,0:15:08.36,Main,,0,0,0,,İki ticaret gemisi ve bir korsan gemisi yağmaladık.
Dialogue: 0,0:15:09.40,0:15:12.58,Main,,0,0,0,,Demin de açıkta Denizciler bize mallarından verdi.
Dialogue: 0,0:15:13.48,0:15:15.96,Main,,0,0,0,,Kuja Korsanları gerçekten çok seçkin!
Dialogue: 0,0:15:16.14,0:15:18.33,Main,,0,0,0,,Ran. Hiç kitap var mı?
Dialogue: 0,0:15:18.96,0:15:20.28,Main,,0,0,0,,Nyon nine!
Dialogue: 0,0:15:20.52,0:15:21.42,Main,,0,0,0,,Bir düşüneyim.
Dialogue: 0,0:15:21.54,0:15:25.38,Main,,0,0,0,,Ah! Şu Denizciler bize gazete verdiler.
Dialogue: 0,0:15:25.86,0:15:27.00,Main,,0,0,0,,İşte burada!
Dialogue: 0,0:15:28.39,0:15:31.14,Captions,,800,0,216,,{\fad(640,0)}Amazon Lily\N\N\N\N\N\N\N\N\N\N\N\N\N\N\N\N\N\N\NKuja Kalesi
Dialogue: 0,0:15:31.64,0:15:33.38,Main,,0,0,0,,Hoş geldiniz!
Dialogue: 0,0:15:37.06,0:15:39.45,Main,,0,0,0,,Hoş geldiniz Yılan Prenses.
Dialogue: 0,0:15:39.68,0:15:41.98,Main,,0,0,0,,Kaleye göz kulak olduğunuz için teşekkürler.
Dialogue: 0,0:15:42.24,0:15:44.12,Main,,0,0,0,,Enishida. Bu nedir?
Dialogue: 0,0:15:44.40,0:15:45.00,Main,,0,0,0,,Ah!
Dialogue: 0,0:15:45.16,0:15:51.24,Main,,0,0,0,,Bu kilden heykeli köydeki çocuklar sizin için nice emeklerle yaptı!
Dialogue: 0,0:15:51.74,0:15:54.74,Main,,0,0,0,,Boyamak için de çok emek vermiş olmalılar.
Dialogue: 0,0:16:00.98,0:16:06.14,Main,,0,0,0,,Kırılmasını önlemek için onu dikkatlice kaleye taşıma çabaları gerçekten hassas ve masumaneydi!
Dialogue: 0,0:16:07.34,0:16:08.18,Main,,0,0,0,,Ah, anlıyorum.
Dialogue: 0,0:16:09.78,0:16:10.94,Main,,0,0,0,,Yani beni...
Dialogue: 0,0:16:12.22,0:16:13.56,Main,,0,0,0,,...çamurdan ve kilden yaptılar...
Dialogue: 0,0:16:16.68,0:16:17.70,Main,,0,0,0,,Yılan Prenses!
Dialogue: 0,0:16:18.34,0:16:21.54,Main,,0,0,0,,Böyle pis şeyleri kaleye sokmayın!
Dialogue: 0,0:16:21.90,0:16:24.36,Main,,0,0,0,,Hemen atın onu ve yerleri temizleyin
Dialogue: 0,0:16:24.80,0:16:26.24,Main,,0,0,0,,Her neyse Enishida...
Dialogue: 0,0:16:26.56,0:16:28.08,Main,,0,0,0,,E-evet?
Dialogue: 0,0:16:28.56,0:16:32.72,Main,,0,0,0,,Gelirken savunma savaşçılarımızı \Nbizi karşılarken görmedim...
Dialogue: 0,0:16:35.82,0:16:38.84,Main,,0,0,0,,Ah, açıkçası...
Dialogue: 0,0:16:39.04,0:16:42.45,Main,,0,0,0,,Ormanda şiddet eğilimli bir maymun ortaya çıktı ve...
Dialogue: 0,0:16:42.82,0:16:47.86,Main,,0,0,0,,Çok vahşi ve kaba bir canavardı, \Nherkes onun peşinden gitmek zorunda kaldı...
Dialogue: 0,0:16:49.48,0:16:50.44,Main,,0,0,0,,Bir maymun mu?
Dialogue: 0,0:16:51.08,0:16:53.22,Main,,0,0,0,,Endişelenmeyin. Hemen dönerler.
Dialogue: 0,0:16:53.56,0:16:55.96,Main,,0,0,0,,Sizi karşılamaya gelemedikleri için gerçekten üzgünüm.
Dialogue: 0,0:16:56.32,0:16:57.49,Main,,0,0,0,,Sorun değil.
Dialogue: 0,0:16:57.66,0:16:59.48,Main,,0,0,0,,İçecek bir şey ister misiniz?
Dialogue: 0,0:17:04.04,0:17:05.07,Main,,0,0,0,,Beyaz sake.
Dialogue: 0,0:17:05.28,0:17:07.97,Main,,0,0,0,,Ben de biraz alabilirim.
Dialogue: 0,0:17:08.10,0:17:09.23,Main,,0,0,0,,Nyon nine.
Dialogue: 0,0:17:09.42,0:17:11.64,Main,,0,0,0,,Burası benim odam. Neden buradasın?
Dialogue: 0,0:17:11.88,0:17:13.22,Main,,0,0,0,,N-Nyon Nine!
Dialogue: 0,0:17:13.42,0:17:14.60,Main,,0,0,0,,Buraya nasıl girdin?!
Dialogue: 0,0:17:15.16,0:17:16.96,Main,,0,0,0,,İstediğim gibi girerim.
Dialogue: 0,0:17:18.20,0:17:19.06,Main,,0,0,0,,Onu dışarı atın.
Dialogue: 0,0:17:19.24,0:17:21.64,Main,,0,0,0,,Bekle, Yılan Prenses!
Dialogue: 0,0:17:26.00,0:17:26.88,Main,,0,0,0,,"Lütfen" demeyi unuttun...
Dialogue: 0,0:17:29.02,0:17:29.88,Main,,0,0,0,,"Lütfen."
Dialogue: 0,0:17:33.58,0:17:35.62,Main,,0,0,0,,Beni affet. Lütfen bekleyin Yılan Prenses.
Dialogue: 0,0:17:36.20,0:17:39.90,Main,,0,0,0,,Hükümet adamlarının gemisi açıkta demirlemiş.
Dialogue: 0,0:17:40.98,0:17:44.52,Main,,0,0,0,,Seni almaya geldiler değil mi?
Dialogue: 0,0:17:45.06,0:17:49.56,Main,,0,0,0,,Seni aktif bir göreve çağırmaya geldiler değil mi?
Dialogue: 0,0:17:49.94,0:17:52.32,Main,,0,0,0,,Bu doğru. Bir savaş davetiydi.
Dialogue: 0,0:17:52.56,0:17:54.92,Main,,0,0,0,,Neden gitmiyorsun?! Gitmelisin!
Dialogue: 0,0:17:55.28,0:17:58.10,Main,,0,0,0,,Eğer giderseniz anlaşmaya uyulacak!
Dialogue: 0,0:17:58.66,0:18:00.68,Main,,0,0,0,,Sizin gibi yetenekli biri...
Dialogue: 0,0:18:01.32,0:18:03.86,Main,,0,0,0,,...beklenmedik bir ölümle karşılaşmayacaktır!
Dialogue: 0,0:18:05.00,0:18:05.77,Main,,0,0,0,,Ama...
Dialogue: 0,0:18:06.58,0:18:08.07,Main,,0,0,0,,Korkuyorum!
Dialogue: 0,0:18:09.00,0:18:10.42,Main,,0,0,0,,Aynı yavru köpek gibi!
Dialogue: 0,0:18:10.66,0:18:12.59,Main,,0,0,0,,Bekle, bunun vakti değil!
Dialogue: 0,0:18:13.56,0:18:14.72,Main,,0,0,0,,Nyon nine...
Dialogue: 0,0:18:16.06,0:18:21.76,Main,,0,0,0,,Bu ülke sizin Shichibukai unvanınızın koruması altındadır!
Dialogue: 0,0:18:22.46,0:18:25.82,Main,,0,0,0,,Yakın zamana kadar bu ada \Ndış düşmanlardan korunuyordu.
Dialogue: 0,0:18:25.92,0:18:30.94,Main,,0,0,0,,Güçlü canavarların ini olan \NCalm Belt tarafından korunuyorduk!
Dialogue: 0,0:18:31.64,0:18:37.96,Main,,0,0,0,,Ancak artık normal deniz sakinleri yeni gemi yapım teknikleri keşfettiler
Dialogue: 0,0:18:38.16,0:18:41.48,Main,,0,0,0,,Böylece bu denizlere istedikleri gibi girip çıkabiliyorlar.
Dialogue: 0,0:18:41.84,0:18:47.30,Main,,0,0,0,,Kimsenin bu adaya ayak basmamasının sebebi \Nsenin shichibukai olman.
Dialogue: 0,0:18:47.46,0:18:50.66,Main,,0,0,0,,Kuja Korsanlarının özgürce dolaşmasını sağlayan da bu.
Dialogue: 0,0:18:50.96,0:18:56.02,Main,,0,0,0,,Bu ada küçük çocuklar ve yaşlı kadınların da evi.
Dialogue: 0,0:18:56.26,0:19:00.58,Main,,0,0,0,,Eğer unvanını kaybeder ve bizi sıradan bir \Nkorsan ülkesine döndürürsen...
Dialogue: 0,0:19:00.74,0:19:02.90,Main,,0,0,0,,...bizleri sadece trajedi bekliyor olur!
Dialogue: 0,0:19:05.52,0:19:07.86,Main,,0,0,0,,Sadece korkmadığından emin misin?
Dialogue: 0,0:19:08.10,0:19:10.86,Main,,0,0,0,,Hayatım her an son bulabilir.
Dialogue: 0,0:19:11.74,0:19:14.47,Main,,0,0,0,,Kristal küreye yakından bak!
Dialogue: 0,0:19:16.17,0:19:19.67,Main,,0,0,0,,Geleceğine ışık tutacağım...
Dialogue: 0,0:19:21.26,0:19:24.78,Note,,0,0,0,,"Git!"
Dialogue: 0,0:19:26.51,0:19:27.59,Main,,0,0,0,,Bu ne küstahlık!
Dialogue: 0,0:19:29.71,0:19:30.61,Main,,0,0,0,,Çıkarın onu!
Dialogue: 0,0:19:30.96,0:19:32.35,Main,,0,0,0,,Hem de hemen!
Dialogue: 0,0:19:32.35,0:19:34.18,Main,,0,0,0,,T-tamam! Hemen!
Dialogue: 0,0:19:34.54,0:19:36.01,Main,,0,0,0,,Bekle, Yılan Prenses!
Dialogue: 0,0:19:36.42,0:19:37.72,Main,,0,0,0,,Dur! Ne yapıyorsun?!
Dialogue: 0,0:19:37.72,0:19:40.68,Main,,0,0,0,,Sadece sessiz olmalı ve olacakları seyretmelisin.
Dialogue: 0,0:19:40.68,0:19:43.19,Main,,0,0,0,,Ne yapmaya çalışıyorsun?
Dialogue: 0,0:19:43.43,0:19:46.76,Main,,0,0,0,,Senin çağın uzun zaman önce bitti...
Dialogue: 0,0:19:47.29,0:19:50.43,Main,,0,0,0,,Amazon Lily'nin imparatoriçesi olarak yerini otuz yıl önce kaybettin,...
Dialogue: 0,0:19:52.14,0:19:53.41,Main,,0,0,0,,...Gloriosa!
Dialogue: 0,0:19:54.87,0:19:59.94,Main,,0,0,0,,Eğer kendi bencilliğim krallığımızın sonunu getirecekse, \Nbunun için affedilebilirim...
Dialogue: 0,0:19:59.94,0:20:01.42,Main,,0,0,0,,Bunun nedeniyse...
Dialogue: 0,0:20:02.18,0:20:02.81,Main,,0,0,0,,Evet...
Dialogue: 0,0:20:03.50,0:20:06.41,Main,,0,0,0,,...nedeni güzel olmam!
Dialogue: 0,0:20:06.41,0:20:07.26,Main,,0,0,0,,İşte!
Dialogue: 0,0:20:07.26,0:20:09.75,Main,,0,0,0,,Yılan Prenses'in "En büyük Küçümseme Pozu!"
Dialogue: 0,0:20:10.12,0:20:13.60,Main,,0,0,0,,Bir zamanlar bu krallığın imparatoriçesi olabilirsin,...
Dialogue: 0,0:20:13.60,0:20:16.40,Main,,0,0,0,,...ama yine de krallığı terk edip denize açıldın!
Dialogue: 0,0:20:16.56,0:20:18.31,Main,,0,0,0,,Seni Kuja haini!
Dialogue: 0,0:20:18.99,0:20:22.25,Main,,0,0,0,,Köyün kenarında sessizce yaşamamın sebebi de bu!
Dialogue: 0,0:20:23.22,0:20:25.92,Main,,0,0,0,,Orada sessizce yaşamaya devam etmeliydin.
Dialogue: 0,0:20:25.92,0:20:29.64,Main,,0,0,0,,İmparatoriçeye karşı \Nböylesi bir müdahaleye izin veremem!
Dialogue: 0,0:20:31.60,0:20:32.65,Main,,0,0,0,,Yılan Prenses!
Dialogue: 0,0:20:32.65,0:20:34.46,Main,,0,0,0,,Hey! Bırak beni!
Dialogue: 0,0:20:35.46,0:20:39.35,Main,,0,0,0,,Ancak hevesinden epey etkilendim.
Dialogue: 0,0:20:40.02,0:20:41.65,Main,,0,0,0,,Sen kazandın.
Dialogue: 0,0:20:43.10,0:20:45.35,Main,,0,0,0,,Dediklerimi kabul mu ediyorsun Yılan Prenses?
Dialogue: 0,0:20:45.35,0:20:47.58,Main,,0,0,0,,Konuşarak çözülmeyecek şey yok!
Dialogue: 0,0:20:47.58,0:20:48.57,Main,,0,0,0,,Teşekkür ederim!
Dialogue: 0,0:20:49.94,0:20:52.63,Main,,0,0,0,,Yani gidecek misin?!
Dialogue: 0,0:20:52.91,0:20:54.87,Main,,0,0,0,,Yalan söyledim. Kibirlenme!
Dialogue: 0,0:20:56.42,0:20:58.72,Main,,0,0,0,,Kaybol gözümün önünden!
Dialogue: 0,0:21:00.84,0:21:03.24,Main,,0,0,0,,Lanet olsun sana Yılan Prenses!
Dialogue: 0,0:21:08.11,0:21:09.91,Main,,0,0,0,,Y-Yılan Prenses...
Dialogue: 0,0:21:10.23,0:21:11.58,Main,,0,0,0,,...yaşlı bir kadına nasıl öyle davranabilirsiniz?
Dialogue: 0,0:21:14.09,0:21:15.55,Main,,0,0,0,,Kazaydı...
Dialogue: 0,0:21:15.55,0:21:18.56,Main,,0,0,0,,Evet! Evet! Böyle şeyler hepimize olur!
Dialogue: 0,0:21:27.36,0:21:29.01,Main,,0,0,0,,Nyon Nine!
Dialogue: 0,0:21:29.44,0:21:32.33,Main,,0,0,0,,Yaşlanmış olabilirim ama \Nhala bir Kuja savaşçısıyım.
Dialogue: 0,0:21:32.33,0:21:34.27,Main,,0,0,0,,Henüz ölmedim!
Dialogue: 0,0:21:35.64,0:21:40.21,Main,,0,0,0,,Yılan Prenses banyo yapmak üzere!
Dialogue: 0,0:21:40.21,0:21:42.60,Main,,0,0,0,,Derhal kale binasını terk edin!
Dialogue: 0,0:21:44.65,0:21:46.22,Main,,0,0,0,,Hadi! Acele edelim!
Dialogue: 0,0:21:46.22,0:21:47.97,Main,,0,0,0,,D-daha yeni yemeye başlamıştım!
Dialogue: 0,0:21:47.97,0:21:49.59,Main,,0,0,0,,Çabuk dışarı çıkın!
Dialogue: 0,0:21:53.61,0:21:54.69,Main,,0,0,0,,Banyo vakti!
Dialogue: 0,0:21:56.87,0:21:58.03,Main,,0,0,0,,Hazırlanın!
Dialogue: 0,0:21:58.03,0:22:00.53,Main,,0,0,0,,Kaledeki insanlar geliyor.\NYani burası tıka basa dolmak üzere!
Dialogue: 0,0:22:00.96,0:22:07.71,Note,,0,0,0,,{\pos(388,488)}Banyo
Dialogue: 0,0:22:02.38,0:22:03.85,Main,,0,0,0,,Sonraki birkaç saat için...
Dialogue: 0,0:22:03.85,0:22:07.71,Main,,0,0,0,,...kaleye girişler kesin olarak yasaklanmıştır.
Dialogue: 0,0:22:10.54,0:22:11.72,Main,,0,0,0,,Söylesene...
Dialogue: 0,0:22:11.72,0:22:16.40,Main,,0,0,0,,Yılan Prenses banyo yaptığında \Nneden herkes bunu bu kadar büyütüyor?
Dialogue: 0,0:22:17.14,0:22:19.14,Main,,0,0,0,,Kaç yaşındasın?
Dialogue: 0,0:22:19.14,0:22:20.16,Main,,0,0,0,,Sekiz.
Dialogue: 0,0:22:20.16,0:22:22.75,Main,,0,0,0,,O zaman sana anlatayım.
Dialogue: 0,0:22:23.20,0:22:25.50,Main,,0,0,0,,Gorgon Kardeşler'in sırrını mı?!
Dialogue: 0,0:22:26.82,0:22:28.33,Main,,0,0,0,,Evet.
Dialogue: 0,0:22:28.33,0:22:33.04,Main,,0,0,0,,Ana sularda yaşayan Gorgon adlı bir canavar vardı.
Dialogue: 0,0:22:34.03,0:22:40.20,Main,,0,0,0,,Bu korkunç canavara bakan herkes\Nanında taşa dönüşürdü.
Dialogue: 0,0:22:41.23,0:22:45.21,Main,,0,0,0,,Bir maceranın sonunda Yılan Prenses ve kız kardeşleri...
Dialogue: 0,0:22:45.21,0:22:49.51,Main,,0,0,0,,...Gorgon canavarını öldürmeyi başardı.
Dialogue: 0,0:22:54.96,0:22:57.76,Main,,0,0,0,,Ancak canavar son nefesini vermeden önce...
Dialogue: 0,0:22:57.76,0:23:01.64,Main,,0,0,0,,...üç savaşçıya korkunç bir lanet bıraktı.
Dialogue: 0,0:23:02.57,0:23:07.13,Main,,0,0,0,,Canavarın büyük gözleri sırtlarına yerleşmişti...
Dialogue: 0,0:23:07.73,0:23:14.44,Main,,0,0,0,,...ve çevrelerinde kim onların cazibesine kapılır ve onlara bakarsa...
Dialogue: 0,0:23:14.44,0:23:17.03,Main,,0,0,0,,...taşa dönüşerek can verir.
Dialogue: 0,0:23:18.54,0:23:23.68,Main,,0,0,0,,Gorgon Kardeşler asla \Ninsanların önünde kıyafetlerini çıkarmazlar.
Dialogue: 0,0:23:24.35,0:23:26.03,Main,,0,0,0,,Ve banyo yaptıklarında...
Dialogue: 0,0:23:26.03,0:23:31.26,Main,,0,0,0,,...insanları uzak tutmak için \Nhep böyle nöbetçiler koyarlar.
Dialogue: 0,0:23:34.29,0:23:39.03,Captions,,0,0,0,,{\fad(400,0)\pos(262,508)}Kadınlar Adası, Orman
Dialogue: 0,0:23:36.07,0:23:37.49,Main,,0,0,0,,Nereye kaçtı?!
Dialogue: 0,0:23:37.49,0:23:39.03,Main,,0,0,0,,Şu dik yamaçlı dağa kaçtı!
Dialogue: 0,0:23:39.03,0:23:41.88,Main,,0,0,0,,Sakın bana köye geri döndüğünü söyleme!
Dialogue: 0,0:23:41.88,0:23:43.77,Main,,0,0,0,,Bir gemi istiyordu!
Dialogue: 0,0:23:43.77,0:23:44.65,Main,,0,0,0,,Ne dedin sen?!
Dialogue: 0,0:23:47.09,0:23:49.15,Main,,0,0,0,,Peki, şimdi ne olacak?
Dialogue: 0,0:23:49.15,0:23:52.00,Main,,0,0,0,,Burada oturursam yine fark edileceğim.
Dialogue: 0,0:23:53.12,0:23:58.07,Main,,0,0,0,,Bu adada bir korsan gemisi olduğundan bahsetmişti.
Dialogue: 0,0:23:58.63,0:24:01.45,Main,,0,0,0,,Eğer bir şekilde ödünç alabilirsem...
Dialogue: 0,0:24:05.80,0:24:08.10,Main,,0,0,0,,Hayır, bekle. Nami burada değil.
Dialogue: 0,0:24:08.10,0:24:10.21,Main,,0,0,0,,Tek başıma gidersem denizde sürüklenip duracağım.
Dialogue: 0,0:24:13.07,0:24:13.86,Main,,0,0,0,,Ah, buldum!
Dialogue: 0,0:24:14.47,0:24:16.94,Main,,0,0,0,,Gemileriyle beni götürmelerini istemem \Nen iyisi olacak!
Dialogue: 0,0:24:17.20,0:24:20.34,Main,,0,0,0,,Beni Sabaody Takımadaları'na götürüp götürmeyeceklerini soracağım!
Dialogue: 0,0:24:21.26,0:24:23.55,Main,,0,0,0,,Bu da demek oluyor ki...
Dialogue: 0,0:24:24.88,0:24:27.39,Main,,0,0,0,,Önemli biriyle konuşmam gerekiyor...
Dialogue: 0,0:24:27.39,0:24:30.72,Main,,0,0,0,,...ve önemli insanlar yüksek binalarda yaşadığı için...
Dialogue: 0,0:24:32.64,0:24:35.00,Main,,0,0,0,,Çok fazla düşünüyorum, ateşim çıkabilir!
Dialogue: 0,0:24:35.94,0:24:38.86,Main,,0,0,0,,Tamam! \NÖnce yüksek bir binaya gireceğim!
Dialogue: 0,0:24:44.80,0:24:45.96,Main,,0,0,0,,Çabuk köye dönmeliyiz!
Dialogue: 0,0:24:45.96,0:24:48.75,Main,,0,0,0,,Yılan Prenses çoktan dönmüştür!
Dialogue: 0,0:24:48.75,0:24:50.55,Main,,0,0,0,,Eğer o adamı bulursa işler ciddileşecek!
Dialogue: 0,0:24:55.58,0:24:57.24,Main,,0,0,0,,Kırılganmış!
Dialogue: 0,0:24:57.43,0:24:58.47,Main,,0,0,0,,Bu da neydi?!
Dialogue: 0,0:24:58.47,0:25:00.72,Main,,0,0,0,,Kale kulesinin çatısı çöktü!
Dialogue: 0,0:25:00.97,0:25:02.40,Main,,0,0,0,,Neler oluyor?!
Dialogue: 0,0:25:02.40,0:25:06.18,Main,,0,0,0,,Yılan Prenses orada banyo yapıyor!
Dialogue: 0,0:25:08.93,0:25:10.35,Main,,0,0,0,,Daha fazla su mu?!
Dialogue: 0,0:25:10.35,0:25:13.19,Main,,0,0,0,,Çok sıcak! Bekle, bu banyo suyu!
Dialogue: 0,0:25:13.19,0:25:15.81,Main,,0,0,0,,Öleceğim! Boğulacağım!
Dialogue: 0,0:25:19.15,0:25:21.83,Main,,0,0,0,,Ayaklarım yere basıyor. Güvendeyim!
Dialogue: 0,0:25:23.70,0:25:25.94,Main,,0,0,0,,Bu bir banyo mu?
Dialogue: 0,0:25:35.50,0:25:37.21,Main,,0,0,0,,Bir erkek mi!?
Dialogue: 0,0:25:38.35,0:25:39.35,Main,,0,0,0,,Hey...
Dialogue: 0,0:25:40.61,0:25:42.07,Main,,0,0,0,,Sırtınızdaki şey...
Dialogue: 0,0:25:46.08,0:25:49.59,Main,,0,0,0,,Bir yerden tanıdık geliyor ama...
Dialogue: 0,0:25:52.72,0:25:53.53,Main,,0,0,0,,Gördün mü?!
