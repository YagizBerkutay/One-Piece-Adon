Dialogue: 0,0:01:41.05,0:01:42.04,Main,,0,0,0,,Abla!
Dialogue: 0,0:01:42.24,0:01:44.85,Main,,0,0,0,,Abla, neler oluyor?!
Dialogue: 0,0:01:47.96,0:01:50.45,Main,,0,0,0,,O da kim? Bir erkek?!
Dialogue: 0,0:01:50.89,0:01:52.90,Main,,0,0,0,,Bir erkek bu krallıkta ne yapıyor?
Dialogue: 0,0:01:55.83,0:01:57.27,Main,,0,0,0,,Burada tam olarak ne oldu?
Dialogue: 0,0:01:57.55,0:01:59.03,Main,,0,0,0,,Hayır, şey...
Dialogue: 0,0:01:59.52,0:02:01.70,Main,,0,0,0,,Sırtımı gördü.
Dialogue: 0,0:02:05.84,0:02:07.81,Main,,0,0,0,,O zaman tek çözüm onu öldürmek.
Dialogue: 0,0:02:08.10,0:02:11.12,Main,,0,0,0,,Niye? Sadece sırtını gördüm.
Dialogue: 0,0:02:11.94,0:02:16.11,Main,,0,0,0,,Neden bilmiyorum ama sanki onu\Ndaha bir yerde görmüş gibiyim.
Dialogue: 0,0:02:16.55,0:02:22.52,Main,,0,0,0,,Sırtımda gördüğün ölsek bile ortaya \Nçıkmasını istemediğimiz bir şey!
Dialogue: 0,0:02:22.74,0:02:24.53,Main,,0,0,0,,O mu? Niye?
Dialogue: 0,0:02:24.53,0:02:26.09,Main,,0,0,0,,Kimsin sen? Niye?
Dialogue: 0,0:02:26.34,0:02:28.99,Main,,0,0,0,,Burada gördüğün her şeyi mezarına götür!
Dialogue: 0,0:02:29.15,0:02:30.55,Main,,0,0,0,,{\fad(150,150)}Mero Mero Mellow!
Dialogue: 0,0:02:29.15,0:02:30.55,Note,,0,0,0,,Aşk Aşk Işını!
Dialogue: 0,0:02:31.39,0:02:32.92,Main,,0,0,0,,Ha? Noro Noro?
Dialogue: 0,0:02:31.39,0:02:32.92,Note,,0,0,0,,Noro Noro: Yavaş Yavaş
Dialogue: 0,0:02:33.60,0:02:34.93,Main,,0,0,0,,Yavaş Yavaş Işını mı?!
Dialogue: 0,0:02:38.18,0:02:39.18,Main,,0,0,0,,Eyvah,...
Dialogue: 0,0:02:39.18,0:02:43.96,Main,,0,0,0,,...yavaşlayacağım! Yavaş...lı..yo..rum...
Dialogue: 0,0:02:54.80,0:02:56.22,Main,,0,0,0,,{\fad(150,150)}Aşk Aşk Işını!
Dialogue: 0,0:03:09.14,0:03:11.25,Main,,0,0,0,,Neden taşa dönüşmüyor?
Dialogue: 0,0:03:11.25,0:03:15.64,Main,,0,0,0,,Banyoda beni çıplak gördükten sonra\Nhiç heyecanlanmadın mı?
Dialogue: 0,0:03:15.64,0:03:18.58,Main,,0,0,0,,Bu imkansız, abla!
Dialogue: 0,0:03:18.58,0:03:22.56,Main,,0,0,0,,Çıplak bedeninin güzelliği yaş ve cinsiyete\Nbakmaksızın herkesi etkileyebilecek bir seviyede!
Dialogue: 0,0:03:22.56,0:03:26.62,Main,,0,0,0,,Muhtemelen ölüm korkusu ahlaksız\Narzularına baskın çıkıyor!
Dialogue: 0,0:03:26.62,0:03:28.95,Main,,0,0,0,,Zavallı ama yine de şanslı bir adam.
Dialogue: 0,0:03:28.95,0:03:31.48,Main,,0,0,0,,Neler oluyor bilmiyorum\Nama buradan kaçsam iyi olur!
Dialogue: 0,0:03:31.48,0:03:35.16,Main,,0,0,0,,Sadece önemli birini bulmak\Nistiyorum, hepsi bu!
Dialogue: 0,0:03:35.65,0:03:37.89,Main,,0,0,0,,Bu kadar yüksekten dışarı atladı!
Dialogue: 0,0:03:38.76,0:03:39.83,Main,,0,0,0,,Kaçamayacak!
Dialogue: 0,0:03:40.49,0:03:41.36,Main,,0,0,0,,{\fad(150,150)}Öpücük Tabancası!
Dialogue: 0,0:03:48.04,0:03:50.10,Main,,0,0,0,,Ne? Geri sektiremedim.
Dialogue: 0,0:03:50.10,0:03:51.44,Main,,0,0,0,,Mermi değil miydi?
Dialogue: 0,0:03:54.35,0:03:56.65,Main,,0,0,0,,O adam davetsiz misafir!
Dialogue: 0,0:03:56.65,0:03:58.92,Main,,0,0,0,,Yakalayın onu, Kuja Korsanları!
Dialogue: 0,0:03:58.92,0:04:00.47,Main,,0,0,0,,T-Tamam!
Dialogue: 0,0:04:00.47,0:04:03.21,Main,,0,0,0,,Bir erkek?! Burada neden bir erkek var?!
Dialogue: 0,0:04:03.21,0:04:05.84,Main,,0,0,0,,Neyse, şimdilik onu yakalamamız gerek\Ndeğil mi?
Dialogue: 0,0:04:14.47,0:04:18.57,Title,,0,0,240,,{\fad(317,0)}Arena
Dialogue: 0,0:04:18.86,0:04:20.97,Main,,0,0,0,,Kahretsin, çık hadi!
Dialogue: 0,0:04:22.97,0:04:25.63,Main,,0,0,0,,Bu yılanlar niye çelik kadar sert?
Dialogue: 0,0:04:25.63,0:04:26.86,Main,,0,0,0,,Çok geç kaldık.
Dialogue: 0,0:04:27.42,0:04:30.48,Main,,0,0,0,,Umarım buraya nasıl geldiği bize sorulmaz.
Dialogue: 0,0:04:30.83,0:04:33.62,Main,,0,0,0,,O adam öldürülecek, değil mi?
Dialogue: 0,0:04:34.36,0:04:35.94,Main,,0,0,0,,Bu krallığın nesi var?
Dialogue: 0,0:04:35.94,0:04:38.71,Main,,0,0,0,,Cidden tek bir erkek bile yok.
Dialogue: 0,0:04:44.80,0:04:46.24,Main,,0,0,0,,Yılan Prenses!
Dialogue: 0,0:04:46.24,0:04:47.79,Main,,0,0,0,,Marigold-sama!
Dialogue: 0,0:04:47.79,0:04:49.17,Main,,0,0,0,,Sandersonia-sama!
Dialogue: 0,0:04:54.65,0:04:56.67,Main,,0,0,0,,Sana bir soru sorayım, erkek.
Dialogue: 0,0:04:56.67,0:05:00.58,Main,,0,0,0,,Bu adaya nasıl ve hangi amaçla geldin?
Dialogue: 0,0:05:00.58,0:05:03.34,Main,,0,0,0,,Gerçekten ben de buraya\Nnasıl geldiğimi bilmiyorum!
Dialogue: 0,0:05:03.34,0:05:07.49,Main,,0,0,0,,Sadece gökyüzünde uçuyordum ve\Nfarkına varmadan buraya gelmişim!
Dialogue: 0,0:05:07.49,0:05:12.81,Main,,0,0,0,,Yalancı! Böyle saçma bir hikayeyle\Nbizi kandıramazsın.
Dialogue: 0,0:05:12.81,0:05:14.33,Main,,0,0,0,,Bir amacın olmalı, değil mi?
Dialogue: 0,0:05:14.54,0:05:17.06,Main,,0,0,0,,İstediğin amaçsa, bir gemi istiyorum!
Dialogue: 0,0:05:17.06,0:05:19.63,Main,,0,0,0,,Eşlik de ederseniz çok mutlu olurum ama...
Dialogue: 0,0:05:19.63,0:05:23.99,Main,,0,0,0,,Neyse, en kısa sürede buradan çıkmalıyım.\NGitmem gereken bir yer var!
Dialogue: 0,0:05:23.99,0:05:27.04,Main,,0,0,0,,Buradaki en önemli kişi sen isen,\Nistediğim bu! Denize açılmak istiyorum!
Dialogue: 0,0:05:27.37,0:05:29.69,Main,,0,0,0,,Sahte beyanatlarda bulunuyor!
Dialogue: 0,0:05:29.69,0:05:31.93,Main,,0,0,0,,Kesinlikle bir şey saklıyor!
Dialogue: 0,0:05:31.93,0:05:33.63,Main,,0,0,0,,Bizi kandırabileceğini mi sanıyorsun?
Dialogue: 0,0:05:35.96,0:05:38.15,Flashbacks,,0,0,0,,Tekrar tekrar dövüşebilirim!
Dialogue: 0,0:05:38.63,0:05:43.72,Main,,0,0,0,,Yılan Prenses'e "sen" diye hitap etmek;\Nne saygısızca bir konuşma şekli!
Dialogue: 0,0:05:38.63,0:05:43.72,Note,,0,0,0,,"Omae", "sen" demenin kaba bir şeklidir.
Dialogue: 0,0:05:43.72,0:05:45.26,Main,,0,0,0,,Berbat biri!
Dialogue: 0,0:05:49.83,0:05:52.70,Main,,0,0,0,,Buradan canlı gideceğini sanmıyorum.
Dialogue: 0,0:05:53.04,0:05:55.09,Main,,0,0,0,,Ölümden kaçamayacaksın!
Dialogue: 0,0:05:57.90,0:05:59.87,Main,,0,0,0,,Durun lütfen, Yılan Prenses!
Dialogue: 0,0:06:10.44,0:06:14.99,Main,,0,0,0,,O, yalan söyleyecek türde biri değil!
Dialogue: 0,0:06:15.23,0:06:16.22,Main,,0,0,0,,Margaret!
Dialogue: 0,0:06:17.14,0:06:18.55,Main,,0,0,0,,Yılan Prenses...
Dialogue: 0,0:06:18.55,0:06:22.43,Main,,0,0,0,,...onun söyledikleri doğru...
Dialogue: 0,0:06:22.43,0:06:25.86,Main,,0,0,0,,Bu krallık için kötü niyetlere\Nsahip olduğunu hiç sanmıyorum!
Dialogue: 0,0:06:26.71,0:06:28.55,Main,,0,0,0,,Oh, sen!
Dialogue: 0,0:06:28.55,0:06:30.60,Main,,0,0,0,,Doğru. Lütfen anlat ona!
Dialogue: 0,0:06:30.60,0:06:32.10,Main,,0,0,0,,Bu krallığın muhafızlarından biri misin?
Dialogue: 0,0:06:32.48,0:06:33.84,Main,,0,0,0,,Adım Margaret!
Dialogue: 0,0:06:34.33,0:06:36.05,Main,,0,0,0,,Erkeklere yasak olan bu krallığa...
Dialogue: 0,0:06:36.05,0:06:39.98,Main,,0,0,0,,...izinsiz girmenin cezası ölümdür.
Dialogue: 0,0:06:39.98,0:06:41.05,Main,,0,0,0,,Niye onu savunuyorsun?
Dialogue: 0,0:06:42.46,0:06:44.22,Main,,0,0,0,,Kendimi sorumlu hissediyorum.
Dialogue: 0,0:06:45.66,0:06:47.82,Main,,0,0,0,,O adamı buraya getiren kişi...
Dialogue: 0,0:06:49.71,0:06:50.62,Main,,0,0,0,,...bendim!
Dialogue: 0,0:06:52.14,0:06:54.26,Main,,0,0,0,,Margaret! Niye?
Dialogue: 0,0:06:57.80,0:07:01.33,Main,,0,0,0,,Yılan Prenses! B-bunu açıklayabiliriz!
Dialogue: 0,0:07:01.33,0:07:02.53,Main,,0,0,0,,Evet!
Dialogue: 0,0:07:02.53,0:07:05.69,Main,,0,0,0,,Ormanda mantarlarla kaplı\Nolarak bulduğumuz adamın...
Dialogue: 0,0:07:05.69,0:07:08.31,Main,,0,0,0,,...köylülerden biri olduğunu\Ndüşünmüştük, hepsi bu!
Dialogue: 0,0:07:08.63,0:07:10.69,Main,,0,0,0,,Sweet Pea! Aphelandra!
Dialogue: 0,0:07:10.69,0:07:14.82,Main,,0,0,0,,Onu buraya getirme konusunda\Nbiz de en az onun kadar sorumluyuz!
Dialogue: 0,0:07:14.82,0:07:16.28,Main,,0,0,0,,Bu doğru!
Dialogue: 0,0:07:16.53,0:07:18.13,Main,,0,0,0,,İkiniz de kesin şunu!
Dialogue: 0,0:07:18.13,0:07:20.82,Main,,0,0,0,,Onu köye götürmemiz\Ngerektiğini söyleyen bendim!
Dialogue: 0,0:07:21.24,0:07:22.99,Main,,0,0,0,,Eğer bu şekilde devam ederlerse....
Dialogue: 0,0:07:22.99,0:07:25.70,Main,,0,0,0,,Çok dürüstsün, Margaret.
Dialogue: 0,0:07:28.51,0:07:33.52,Main,,0,0,0,,Ne oldu size böyle? Beni öldürmeye çalışıyordunuz.\NDemek aslında iyi insanlardınız, ha?
Dialogue: 0,0:07:39.14,0:07:41.77,Main,,0,0,0,,Erkeği buraya getirmekten\Nsuçlu olan sadece benim!
Dialogue: 0,0:07:41.77,0:07:42.94,Main,,0,0,0,,Margaret!
Dialogue: 0,0:07:44.64,0:07:46.11,Main,,0,0,0,,Bu kadarı yeter.
Dialogue: 0,0:07:47.27,0:07:50.30,Main,,0,0,0,,Kaldır başını, dürüst Margaret.
Dialogue: 0,0:07:53.63,0:07:54.63,Main,,0,0,0,,{\fad(150,150)}Aşk Aşk Işını!
Dialogue: 0,0:07:58.98,0:07:59.89,Main,,0,0,0,,Bu da ne?
Dialogue: 0,0:08:07.46,0:08:09.07,Main,,0,0,0,,Aptalca bir şey yaptılar.
Dialogue: 0,0:08:09.26,0:08:11.19,Main,,0,0,0,,Hey, size ne oldu?!
Dialogue: 0,0:08:11.58,0:08:12.79,Main,,0,0,0,,Ne oldu?!
Dialogue: 0,0:08:14.05,0:08:15.84,Main,,0,0,0,,Taşa dönmüşler! Neden?!
Dialogue: 0,0:08:17.85,0:08:20.91,Main,,0,0,0,,Hey, onlara ne yaptın?!
Dialogue: 0,0:08:20.91,0:08:22.40,Main,,0,0,0,,Onlar hayatımı kurtardı!
Dialogue: 0,0:08:23.41,0:08:28.05,Main,,0,0,0,,Evet, sana yardım ettikleri\Niçin cezalandırıldılar.
Dialogue: 0,0:08:28.05,0:08:30.02,Main,,0,0,0,,Benim yüzümden mi?!
Dialogue: 0,0:08:30.61,0:08:32.89,Main,,0,0,0,,Dur! Onları normale döndür!
Dialogue: 0,0:08:37.67,0:08:39.17,Main,,0,0,0,,Bacura'yı arenaya getirin!
Dialogue: 0,0:08:39.49,0:08:40.49,Main,,0,0,0,,Bacura mı!?
Dialogue: 0,0:08:40.49,0:08:42.40,Main,,0,0,0,,O erkeğin işi hemen bitti, değil mi?
Dialogue: 0,0:08:43.00,0:08:44.51,Main,,0,0,0,,Sana onları normale döndür dedim!
Dialogue: 0,0:08:44.96,0:08:48.02,Main,,0,0,0,,Burası, güçlünün güzel olduğu...
Dialogue: 0,0:08:48.02,0:08:50.18,Main,,0,0,0,,...savaşçılar krallığı Amazon Lily.
Dialogue: 0,0:08:50.73,0:08:53.25,Main,,0,0,0,,Dövüşerek ölmelisin.
Dialogue: 0,0:08:53.25,0:08:55.47,Main,,0,0,0,,İzleyeceğiz.
Dialogue: 0,0:09:02.01,0:09:04.86,Main,,0,0,0,,O kara panterin adı, Bacura.
Dialogue: 0,0:09:04.86,0:09:09.66,Main,,0,0,0,,Nesillerdir bu krallığın imparatoriçeleri tarafından\Ncellat olarak kullanılan etobur bir hayvan.
Dialogue: 0,0:09:09.97,0:09:13.06,Main,,0,0,0,,İnfazın ardından tek bir kemik\Nbile kalmayacak.
Dialogue: 0,0:09:15.73,0:09:18.70,Main,,0,0,0,,Bu insanlara ne olacak?! Normale dönecekler mi?!
Dialogue: 0,0:09:18.70,0:09:21.97,Main,,0,0,0,,Yılan Prenses'le ne kadar\Nsaygısızca konuşma şekli!
Dialogue: 0,0:09:21.97,0:09:23.64,Main,,0,0,0,,Bitir işini, Bacura!
Dialogue: 0,0:09:27.21,0:09:28.11,Main,,0,0,0,,Bacura!
Dialogue: 0,0:10:00.67,0:10:01.83,Main,,0,0,0,,Güçlü!
Dialogue: 0,0:10:01.83,0:10:04.15,Main,,0,0,0,,Bacura tek vuruşta yenildi mi?!
Dialogue: 0,0:10:06.54,0:10:08.43,Main,,0,0,0,,Haki bile kullanmadı!
Dialogue: 0,0:10:08.43,0:10:10.36,Main,,0,0,0,,O zaman bunu sadece kaba\Nkuvvetle mi yaptı?
Dialogue: 0,0:10:10.85,0:10:12.81,Main,,0,0,0,,Sizlerde bir sorun olmalı...
Dialogue: 0,0:10:14.19,0:10:16.06,Main,,0,0,0,,O kadın...
Dialogue: 0,0:10:18.20,0:10:20.46,Main,,0,0,0,,...sizin arkadaşlarınızı taşa dönüştürdü...
Dialogue: 0,0:10:20.46,0:10:23.37,Main,,0,0,0,,Oturduğunuz yerden bu\Nşekilde nasıl gülebilirsiniz?
Dialogue: 0,0:10:24.78,0:10:27.68,Main,,0,0,0,,Vahşi bir erkek bize bağırıyor!
Dialogue: 0,0:10:27.68,0:10:29.74,Main,,0,0,0,,İnanılmaz! Ne vahşi bir hayvan!
Dialogue: 0,0:10:30.13,0:10:34.99,Main,,0,0,0,,O üçü için üzülüyoruz ama\NYılan Prenses'in yaptığı yanlış değildi!
Dialogue: 0,0:10:34.99,0:10:38.22,Main,,0,0,0,,Hatalı olan onlar!\NBu krallığın kurallarını bozdular!
Dialogue: 0,0:10:40.01,0:10:40.99,Main,,0,0,0,,Ben ne yaparsam...
Dialogue: 0,0:10:42.09,0:10:44.92,Main,,0,0,0,,...yapayım affedileceğim.
Dialogue: 0,0:10:44.92,0:10:45.86,Main,,0,0,0,,Çünkü...
Dialogue: 0,0:10:47.61,0:10:49.05,Main,,0,0,0,,...kesinlikle...
Dialogue: 0,0:10:49.05,0:10:51.22,Main,,0,0,0,,...çok güzelim!
Dialogue: 0,0:10:53.85,0:10:55.37,Main,,0,0,0,,Yılan Prenses!
Dialogue: 0,0:11:00.67,0:11:03.61,Main,,0,0,0,,Sen de öyle düşünüyorsun, değil mi?
Dialogue: 0,0:11:04.06,0:11:06.00,Main,,0,0,0,,Sinirlerimi bozuyorsun.
Dialogue: 0,0:11:08.76,0:11:09.88,Main,,0,0,0,,Abla, kendine gel!
Dialogue: 0,0:11:10.32,0:11:12.27,Main,,0,0,0,,Böyle saçma bir şey olamaz!
Dialogue: 0,0:11:12.73,0:11:17.26,Main,,0,0,0,,Cazibeme kapılmayacak bir erkeğin\Nolması mümkün değil!
Dialogue: 0,0:11:19.71,0:11:23.29,Main,,0,0,0,,O erkeğin varlığına dayanamıyorum!
Dialogue: 0,0:11:23.29,0:11:25.94,Main,,0,0,0,,Yılan Prense'le nasıl öyle konuşursun?!
Dialogue: 0,0:11:25.94,0:11:28.16,Main,,0,0,0,,Hemen öldürün o adamı!
Dialogue: 0,0:11:28.16,0:11:29.20,Main,,0,0,0,,Öldürün!
Dialogue: 0,0:11:29.73,0:11:32.88,Main,,0,0,0,,Öldürün! Öldürün!
Dialogue: 0,0:11:33.48,0:11:36.24,Main,,0,0,0,,Gidin, Marigold ve Sandersonia!
Dialogue: 0,0:11:36.24,0:11:38.18,Main,,0,0,0,,O erkeğin başını alın!
Dialogue: 0,0:11:42.35,0:11:44.85,Main,,0,0,0,,Evet, bize bırak abla.
Dialogue: 0,0:11:53.18,0:11:54.96,Main,,0,0,0,,Onlar da mı şeytan meyvesi\Ngücü kullanıyor?
Dialogue: 0,0:11:57.87,0:11:59.91,Main,,0,0,0,,Öldürün!
Dialogue: 0,0:11:59.91,0:12:01.94,Main,,0,0,0,,Öldürün!
Dialogue: 0,0:12:01.94,0:12:04.50,Main,,0,0,0,,Kız kardeşlerin yılan dansı başlamak üzere!
Dialogue: 0,0:12:05.31,0:12:09.46,Main,,0,0,0,,{\an8}Marigold-sama'nın Salamander'ini\Nkendi gözlerimle görmek istiyorum!
Dialogue: 0,0:12:07.59,0:12:11.31,Captions,,0,800,90,,{\fad(1000,0)}Küçük Kız Kardeş\N"Yılan Yılan Meyvesi" Model: Kral Kobra
Dialogue: 0,0:12:11.76,0:12:15.05,Main,,0,0,0,,{\an8}Sandersonia-sama'nın "Çatal Yılanı"nı da.
Dialogue: 0,0:12:14.26,0:12:17.99,Captions,,0,800,0,,{\fad(1000,0)\pos(317,630)}Ortanca Kız Kardeş\N"Yılan Yılan Meyvesi" Model: Anakonda
Dialogue: 0,0:12:20.65,0:12:22.76,Main,,0,0,0,,Ne kadar muhteşem görünüyor!
Dialogue: 0,0:12:22.76,0:12:26.65,Main,,0,0,0,,Bu, canavar Gorgon'u yenip\Ngüçlerini aldıklarının kanıtı!
Dialogue: 0,0:12:26.65,0:12:29.63,Main,,0,0,0,,Lanetlendikten sonra bile\Nkız kardeşler hala çok güzel!
Dialogue: 0,0:12:29.95,0:12:31.55,Main,,0,0,0,,Lanet mi?
Dialogue: 0,0:12:31.55,0:12:33.40,Main,,0,0,0,,Neden bahsediyor bunlar?
Dialogue: 0,0:12:33.40,0:12:36.34,Main,,0,0,0,,Neresinden bakarsanız bakın,\Nsadece Şeytan Meyvesi yemişsiniz!
Dialogue: 0,0:12:38.84,0:12:42.72,Main,,0,0,0,,Öldürün! Öldürün!
Dialogue: 0,0:12:43.14,0:12:44.90,Main,,0,0,0,,Öldürün...!
Dialogue: 0,0:12:44.90,0:12:46.54,Main,,0,0,0,,Onu yutsam daha mı iyi olur acaba?
Dialogue: 0,0:12:47.17,0:12:49.76,Main,,0,0,0,,Ya da öldürene kadar boğsam mı?
Dialogue: 0,0:12:50.59,0:12:52.76,Main,,0,0,0,,Yoksa korkuyor mu?
Dialogue: 0,0:12:52.76,0:12:54.88,Main,,0,0,0,,Öylece hiçbir şey yapmadan öldürüleceksin!
Dialogue: 0,0:13:08.01,0:13:09.27,Main,,0,0,0,,İşte!
Dialogue: 0,0:13:09.27,0:13:10.60,Main,,0,0,0,,Çatlamadınız, değil mi?
Dialogue: 0,0:13:13.82,0:13:15.97,Main,,0,0,0,,Üçünüz burada bekleyin.
Dialogue: 0,0:13:16.66,0:13:20.18,Main,,0,0,0,,Bunun için üzgünüm. Benim yüzümden\Ntaşa döndünüz.
Dialogue: 0,0:13:20.74,0:13:24.01,Main,,0,0,0,,Chopper burada olsaydı sizi\Nhemen kontrol ettirirdim.
Dialogue: 0,0:13:24.01,0:13:27.23,Main,,0,0,0,,Aynı Robin'le benim, Aokiji tarafından\Nbuza dönüştürüldüğümüz zamanki gibi.
Dialogue: 0,0:13:27.23,0:13:29.72,Main,,0,0,0,,Siz de normale dönebilirsiniz.
Dialogue: 0,0:13:30.57,0:13:35.04,Main,,0,0,0,,Onlarınki yerine kendi güvenliğin için\Nendişe etmen gerekmez mi?
Dialogue: 0,0:13:35.04,0:13:37.11,Main,,0,0,0,,Kapa çeneni! Ne istersem yaparım!
Dialogue: 0,0:13:37.52,0:13:39.12,Main,,0,0,0,,O adam...
Dialogue: 0,0:13:39.12,0:13:41.56,Main,,0,0,0,,...Margaretgil'i kurtarmak niyetinde mi?
Dialogue: 0,0:13:41.56,0:13:42.61,Main,,0,0,0,,Olamaz.
Dialogue: 0,0:13:42.61,0:13:44.07,Main,,0,0,0,,Öldürülmek üzere olmasına rağmen mi?!
Dialogue: 0,0:13:45.20,0:13:46.42,Main,,0,0,0,,Pekâlâ.
Dialogue: 0,0:13:47.05,0:13:50.54,Main,,0,0,0,,Neyse, sadece sizi yenmem gerekiyor, değil mi?
Dialogue: 0,0:13:52.01,0:13:53.51,Main,,0,0,0,,Mümkün değil!
Dialogue: 0,0:13:57.92,0:14:00.51,Main,,0,0,0,,O çocuk ne dedi?
Dialogue: 0,0:14:00.51,0:14:03.28,Main,,0,0,0,,Kız kardeşleri yenebileceğini mi sanıyor?
Dialogue: 0,0:14:03.28,0:14:06.37,Main,,0,0,0,,Komik! Ölümü sırasında\Ninsanları güldürüyor.
Dialogue: 0,0:14:06.37,0:14:08.06,Main,,0,0,0,,Erkekler gerçekten komik!
Dialogue: 0,0:14:12.25,0:14:15.36,Main,,0,0,0,,Bunu yapabilirim, değil mi?\NYani sizi yenmeyi.
Dialogue: 0,0:14:15.36,0:14:17.43,Main,,0,0,0,,Evet, tabii yenebilirsin.
Dialogue: 0,0:14:18.96,0:14:23.04,Main,,0,0,0,,Henüz canından vazgeçmediysen\Nsana bir şey söyleyeyim.
Dialogue: 0,0:14:23.04,0:14:27.07,Main,,0,0,0,,Seyircilerle arena arasındaki\Nboşluğa düşmesen iyi olur.
Dialogue: 0,0:14:28.22,0:14:32.42,Main,,0,0,0,,Düşsen de umrumda değil ama düşersen\Naşağıdaki kazıklara çakılacaksın.
Dialogue: 0,0:14:35.00,0:14:36.55,Main,,0,0,0,,Başlayalım o zaman.
Dialogue: 0,0:14:37.40,0:14:40.75,Main,,0,0,0,,Öldürün onu, Sandersonia, Marigold!
Dialogue: 0,0:14:40.75,0:14:42.92,Main,,0,0,0,,Kadınlar adasına izinsiz girdiği...
Dialogue: 0,0:14:42.92,0:14:45.12,Main,,0,0,0,,ve bana hakaret ederek\Nişlediği günah için...
Dialogue: 0,0:14:45.12,0:14:47.20,Main,,0,0,0,,...ona ölüm cezası sanatımızı gösterin!
Dialogue: 0,0:14:49.75,0:14:51.21,Main,,0,0,0,,Bitirin işini!
Dialogue: 0,0:15:05.65,0:15:06.98,Main,,0,0,0,,Al bakalım, al, al!
Dialogue: 0,0:15:11.47,0:15:13.22,Thoughts,,0,0,0,,Dövüşte fena değil, ha?
Dialogue: 0,0:15:13.22,0:15:16.23,Main,,0,0,0,,Bitir işini, Marigold-sama!
Dialogue: 0,0:15:20.83,0:15:21.30,Main,,0,0,0,,Ne?!
Dialogue: 0,0:15:24.24,0:15:26.57,Main,,0,0,0,,Zehir?! Çok yakındı!
Dialogue: 0,0:15:27.14,0:15:29.22,Main,,0,0,0,,Ölümcül bir zehir! Senin için çok kötü!
Dialogue: 0,0:15:31.21,0:15:32.60,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:15:32.76,0:15:34.89,Main,,0,0,0,,{\fad(150,150)}...Damga!
Dialogue: 0,0:15:36.71,0:15:37.62,Main,,0,0,0,,Geri sektirdi!
Dialogue: 0,0:15:44.09,0:15:45.41,Main,,0,0,0,,Acıyor...
Dialogue: 0,0:15:45.41,0:15:47.63,Main,,0,0,0,,Niye? Ben lastiğim...
Dialogue: 0,0:15:47.63,0:15:49.91,Main,,0,0,0,,Bakın! Sadece blöf yapıyormuş!
Dialogue: 0,0:15:49.91,0:15:53.50,Main,,0,0,0,,Ama erkeklerin uzayabildikleri\Ndoğru! İlginç!
Dialogue: 0,0:15:56.96,0:16:00.57,Main,,0,0,0,,Ne? Lastik güçlerimi mi yitirdim?
Dialogue: 0,0:16:00.57,0:16:01.92,Main,,0,0,0,,Sanırım hayır...
Dialogue: 0,0:16:01.92,0:16:03.91,Main,,0,0,0,,O zaman saldırıları\Nniye bana zarar veriyor?
Dialogue: 0,0:16:04.69,0:16:06.22,Main,,0,0,0,,Hiç adil değil.
Dialogue: 0,0:16:06.22,0:16:08.85,Main,,0,0,0,,Tüm eğlenceyi kendine saklama, Mari!
Dialogue: 0,0:16:09.69,0:16:12.15,Main,,0,0,0,,Ben de biraz eğlenmek istiyorum.
Dialogue: 0,0:16:17.87,0:16:21.53,Main,,0,0,0,,Lastik olmama rağmen niye acıyor?
Dialogue: 0,0:16:21.53,0:16:24.20,Main,,0,0,0,,Sahi, savaş baltalı adam da öyleydi.
Dialogue: 0,0:16:24.20,0:16:27.37,Main,,0,0,0,,Yani bu, Şeytan Meyvesi yeteneği değil mi?
Dialogue: 0,0:16:28.55,0:16:30.98,Main,,0,0,0,,Sen de şeytan meyvesi\Nkullanıcısısın, değil mi?
Dialogue: 0,0:16:31.83,0:16:32.53,Main,,0,0,0,,Kahretsin!
Dialogue: 0,0:16:32.53,0:16:35.11,Main,,0,0,0,,Ama haki kullanamıyorsun, değil mi?
Dialogue: 0,0:16:35.11,0:16:37.60,Main,,0,0,0,,Bu adadan olmayanlar buna aşina değildir.
Dialogue: 0,0:16:37.60,0:16:39.56,Main,,0,0,0,,Bu yüzden güçsüzsün.
Dialogue: 0,0:16:41.28,0:16:42.44,Main,,0,0,0,,Sol ayakla bir tekme.
Dialogue: 0,0:16:46.16,0:16:47.52,Main,,0,0,0,,Buradayım.
Dialogue: 0,0:16:47.96,0:16:49.70,Main,,0,0,0,,Hareketimi tahmin etti!
Dialogue: 0,0:16:52.85,0:16:54.39,Main,,0,0,0,,{\fad(150,150)}Yılan Çarpışı!
Dialogue: 0,0:16:55.49,0:16:56.29,Main,,0,0,0,,Başardı!
Dialogue: 0,0:16:59.37,0:17:01.09,Main,,0,0,0,,Bu acıtmadı.
Dialogue: 0,0:17:01.09,0:17:02.42,Main,,0,0,0,,Her zamanki gibi.
Dialogue: 0,0:17:02.62,0:17:04.33,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:17:04.33,0:17:05.22,Main,,0,0,0,,{\fad(150,150)}...Makineli!
Dialogue: 0,0:17:05.22,0:17:06.97,Main,,0,0,0,,{\fad(150,150)}Yılan Dansı!
Dialogue: 0,0:17:08.77,0:17:10.89,Main,,0,0,0,,Müthiş hareketler!
Dialogue: 0,0:17:10.89,0:17:14.55,Main,,0,0,0,,Sonia-sama'nın hakisini\Nkullanarak atlatamayacağı saldırı yok!
Dialogue: 0,0:17:16.98,0:17:19.56,Main,,0,0,0,,Seni anlamak çok kolay.
Dialogue: 0,0:17:19.56,0:17:21.22,Main,,0,0,0,,Hareketlerini kitap gibi okuyabiliyorum.
Dialogue: 0,0:17:21.22,0:17:22.62,Main,,0,0,0,,Neler oluyor?
Dialogue: 0,0:17:22.62,0:17:24.44,Main,,0,0,0,,Tüm hareketlerimi önceden biliyor!
Dialogue: 0,0:17:25.12,0:17:27.73,Main,,0,0,0,,Ona saldırmaya odaklanman\Nbenim için farketmez ama...
Dialogue: 0,0:17:27.73,0:17:29.15,Main,,0,0,0,,{\fad(150,150)}Yılan Sopası!
Dialogue: 0,0:17:30.85,0:17:31.73,Main,,0,0,0,,Acıyor!
Dialogue: 0,0:17:31.97,0:17:34.37,Main,,0,0,0,,İki kişi olduğumuzu unutma!
Dialogue: 0,0:17:37.54,0:17:38.87,Main,,0,0,0,,Kazıklara düşüyor!
Dialogue: 0,0:17:59.96,0:18:01.56,Main,,0,0,0,,Çok yakındı!
Dialogue: 0,0:18:12.70,0:18:15.92,Main,,0,0,0,,Yılan Prenses, saçını kulağının arkasına attı!
Dialogue: 0,0:18:15.92,0:18:18.71,Main,,0,0,0,,Güzelliği sınır tanımıyor!
Dialogue: 0,0:18:19.93,0:18:23.97,Main,,0,0,0,,Bu adam boş konuşmadan başka bir şey değil.
Dialogue: 0,0:18:23.97,0:18:25.62,Main,,0,0,0,,Ne aptalca.
Dialogue: 0,0:18:28.44,0:18:30.49,Main,,0,0,0,,Kapa çeneni, seni aptal!
Dialogue: 0,0:18:33.41,0:18:35.16,Main,,0,0,0,,Artık dayanamıyorum!
Dialogue: 0,0:18:35.16,0:18:37.98,Main,,0,0,0,,Yine Yılan Prenses'e hakaret etti!
Dialogue: 0,0:18:37.98,0:18:42.17,Main,,0,0,0,,Affedilemez! Hemen o adamı öldürün!
Dialogue: 0,0:18:42.52,0:18:44.50,Main,,0,0,0,,Sonia! Mari!
Dialogue: 0,0:18:45.14,0:18:48.17,Main,,0,0,0,,O adamın hayatına hemen son verin ki...
Dialogue: 0,0:18:49.87,0:18:51.88,Main,,0,0,0,,...pis konuşmasını bir daha asla...
Dialogue: 0,0:18:53.80,0:18:56.05,Main,,0,0,0,,...duymak zorunda kalmayayım!
Dialogue: 0,0:18:56.05,0:18:58.25,Main,,0,0,0,,O zaman oyun vakti sona erdi.
Dialogue: 0,0:18:58.73,0:19:03.35,Main,,0,0,0,,Suçluyu, umutsuzluğuna ve ölümüne teslim edelim!
Dialogue: 0,0:19:05.84,0:19:08.86,Main,,0,0,0,,Hey, ne yapıyorsun?! Onlara dokunma!
Dialogue: 0,0:19:09.86,0:19:11.65,Main,,0,0,0,,Ya kırılırsa?!
Dialogue: 0,0:19:11.65,0:19:13.43,Main,,0,0,0,,Onlar hayatımı kurtardı!
Dialogue: 0,0:19:16.79,0:19:17.87,Main,,0,0,0,,Onları kıracağım.
Dialogue: 0,0:19:19.42,0:19:21.36,Main,,0,0,0,,Hayatını kurtardıklarını\Nsöyledin, değil mi?
Dialogue: 0,0:19:21.36,0:19:22.96,Main,,0,0,0,,O zaman bunu hak ediyorlar.
Dialogue: 0,0:19:22.96,0:19:27.78,Main,,0,0,0,,Bu kıza çok yazık ama senin cezan bu.
Dialogue: 0,0:19:27.78,0:19:29.05,Main,,0,0,0,,Benimle uğraşmayı kesin!
Dialogue: 0,0:19:29.05,0:19:30.95,Main,,0,0,0,,Dövüş benimle sizin aranızda!
Dialogue: 0,0:19:32.62,0:19:34.70,Main,,0,0,0,,Lanet olsun! Bırak beni!
Dialogue: 0,0:19:36.55,0:19:39.73,Main,,0,0,0,,Bunun dövüş olduğunu düşünen sadece sensin.
Dialogue: 0,0:19:39.73,0:19:41.56,Main,,0,0,0,,Bu bir infaz.
Dialogue: 0,0:19:41.56,0:19:43.60,Main,,0,0,0,,Sessizce izle.
Dialogue: 0,0:19:43.60,0:19:47.06,Main,,0,0,0,,Ablamızın kalbindeki yarayla\Nmukayese edildiğinde bu hiçbir şey.
Dialogue: 0,0:19:47.62,0:19:52.13,Flashbacks,,0,0,0,,Yılan Prenses, bu ülkedeki herkesin\Nhayran olduğu bir kadın!
Dialogue: 0,0:19:52.13,0:19:55.89,Flashbacks,,0,0,0,,Güçlü, zarif ve dünyadaki en güzel kadın.
Dialogue: 0,0:19:55.89,0:19:58.80,Flashbacks,,0,0,0,,Korsan İmparatoriçesi Boa Hancock!
Dialogue: 0,0:20:04.52,0:20:06.30,Main,,0,0,0,,Hey, kes şunu!
Dialogue: 0,0:20:06.30,0:20:09.06,Main,,0,0,0,,O, size hayrandı!
Dialogue: 0,0:20:10.52,0:20:12.81,Main,,0,0,0,,Bu krallıktaki herkes öyle.
Dialogue: 0,0:20:12.81,0:20:15.02,Main,,0,0,0,,Bu yüzden onun isteyeceği şeyin\Nbu olduğunu düşünüyorum!
Dialogue: 0,0:20:15.02,0:20:16.61,Main,,0,0,0,,Ne diyorsun sen!
Dialogue: 0,0:20:16.61,0:20:18.23,Main,,0,0,0,,Aptal mısın sen?!
Dialogue: 0,0:20:18.23,0:20:20.83,Main,,0,0,0,,Ne küstah sözler.
Dialogue: 0,0:20:23.18,0:20:24.34,Main,,0,0,0,,Başlıyorum.
Dialogue: 0,0:20:24.61,0:20:25.67,Main,,0,0,0,,Üç...
Dialogue: 0,0:20:26.02,0:20:27.00,Main,,0,0,0,,Hey, kes şunu!
Dialogue: 0,0:20:29.28,0:20:30.37,Main,,0,0,0,,İki...
Dialogue: 0,0:20:32.92,0:20:34.18,Main,,0,0,0,,Faydasız!
Dialogue: 0,0:20:35.38,0:20:35.81,Main,,0,0,0,,Bir...
Dialogue: 0,0:20:36.77,0:20:37.72,Main,,0,0,0,,Margaret!
Dialogue: 0,0:20:45.98,0:20:50.19,Main,,0,0,0,,DUR DEDİM, LANET OLASI!
Dialogue: 0,0:21:16.32,0:21:19.19,Main,,0,0,0,,Savaşçılar bayılıyor!
Dialogue: 0,0:21:20.77,0:21:22.23,Main,,0,0,0,,Yoksa o...
Dialogue: 0,0:21:34.47,0:21:36.19,Main,,0,0,0,,Hele şükür.
Dialogue: 0,0:21:36.19,0:21:38.10,Main,,0,0,0,,Tek bir çizik bile yok!
Dialogue: 0,0:21:39.17,0:21:42.45,Main,,0,0,0,,Ne? Demek sonunda beni dinlediniz.
Dialogue: 0,0:21:48.47,0:21:51.40,Main,,0,0,0,,O kralın hakisiydi.
Dialogue: 0,0:21:51.40,0:21:52.53,Main,,0,0,0,,Şaka bu, değil mi?
Dialogue: 0,0:21:52.53,0:21:56.89,Main,,0,0,0,,Sadece milyonda bir kişi seçilmişlerin\Nhakisini kullanacak kapasitededir.
Dialogue: 0,0:21:58.46,0:22:02.87,Thoughts,,0,0,0,,Ablamızdan başka onu kullanabilen\Nbiri görmedim.
Dialogue: 0,0:22:03.46,0:22:08.57,Thoughts,,0,0,0,,Bu çocuk, diğerlerinden üstün olma\Nkapasitesine, kralın niteliğine sahip.
Dialogue: 0,0:22:12.77,0:22:15.47,Main,,0,0,0,,Benim gibi kralın hakisine sahip.
Dialogue: 0,0:22:16.16,0:22:17.96,Main,,0,0,0,,Bu nasıl olabilir?
Dialogue: 0,0:22:17.96,0:22:21.78,Main,,0,0,0,,Sıradan bir çocuk değil mi?!
Dialogue: 0,0:22:24.20,0:22:27.36,Main,,0,0,0,,Kim bu çocuk Allah aşkına?!
Dialogue: 0,0:22:28.04,0:22:30.12,Main,,0,0,0,,Çok gürültücüsünüz!
Dialogue: 0,0:22:30.12,0:22:31.43,Main,,0,0,0,,Neden bahsediyorsunuz?
Dialogue: 0,0:22:32.14,0:22:35.51,Main,,0,0,0,,Haki kullandığını farketmiyor mu?
Dialogue: 0,0:22:35.51,0:22:37.90,Main,,0,0,0,,Nasıl kontrol edeceğini bilmiyor galiba.
Dialogue: 0,0:22:40.76,0:22:42.47,Main,,0,0,0,,Tamam!
Dialogue: 0,0:22:42.47,0:22:44.79,Main,,0,0,0,,Güçlü olduğunuzu söyleyebilirim!
Dialogue: 0,0:22:50.71,0:22:54.72,Main,,0,0,0,,Dövüşe devam edelim.
Dialogue: 0,0:00:05.30,0:00:09.17,OP11 Lyrics,,0,0,0,,♪ Gökyüzüne ulaşana kadar, ♪
Dialogue: 0,0:00:09.27,0:00:15.71,OP11 Lyrics,,0,0,0,,♪ İnanıyorum, sonraki yarına kadar, hey ♪
Dialogue: 0,0:00:15.73,0:00:19.13,OP11 Lyrics,,0,0,0,,♪ hadi millet gidelim, müziği paylaşıyoruz. ♪
Dialogue: 0,0:00:19.96,0:00:23.36,OP11 Lyrics,,0,0,0,,♪ hadi gidelim bebeğim, bebeğim, oh tek bir hayali paylaşıyoruz. ♪
Dialogue: 0,0:00:23.88,0:00:27.28,OP11 Lyrics,,0,0,0,,♪ hadi millet gidelim, oh iyi zamanları paylaşıyoruz. ♪
Dialogue: 0,0:00:27.71,0:00:31.11,OP11 Lyrics,,0,0,0,,♪ hadi gidelim bebeğim, bebeğim, oh tek bir dünyayı paylaşıyoruz. ♪
Dialogue: 0,0:00:31.81,0:00:35.55,OP11 Lyrics,,0,0,0,,♪ Mobius yüzüğünün tepesinde kovalıyor ve kovalanıyor. ♪
Dialogue: 0,0:00:35.58,0:00:39.35,OP11 Lyrics,,0,0,0,,♪ Yaklaşıyor ve ileri bakıyorum, hey tarzını paylaşmak istiyorum. ♪
Dialogue: 0,0:00:39.52,0:00:43.45,OP11 Lyrics,,0,0,0,,♪ Başlıyor, genişliyor, hayal gücünün üstündeki bu tat. ♪
Dialogue: 0,0:00:43.52,0:00:47.76,OP11 Lyrics,,0,0,0,,♪ Vücudumu baştan başa iyi hissediyorum, özgür kalacağım, oh evet ♪
Dialogue: 0,0:00:47.79,0:00:49.79,OP11 Lyrics,,0,0,0,,♪ Uzakta olsa da, müziği paylaş. ♪
Dialogue: 0,0:00:49.79,0:00:51.73,OP11 Lyrics,,0,0,0,,♪ Birbirine anlatarak o rüyayı paylaş. ♪
Dialogue: 0,0:00:51.76,0:00:53.60,OP11 Lyrics,,0,0,0,,♪ İyi zamanları ve kahkahaları paylaş. ♪
Dialogue: 0,0:00:53.72,0:00:55.27,OP11 Lyrics,,0,0,0,,♪ şimdi tek bir dünyayı paylaş. ♪
Dialogue: 0,0:00:55.45,0:01:03.74,OP11 Lyrics,,0,0,0,,♪ Gökyüzüne ulaşana kadar gitmeye devam edeceğim. ♪
Dialogue: 0,0:01:03.81,0:01:13.05,OP11 Lyrics,,0,0,0,,♪ Hadi üstesinden gelelim, sonraki yarınlara inanıyorum, evet evet... ♪
Dialogue: 0,0:01:13.15,0:01:21.56,OP11 Lyrics,,0,0,0,,♪ Görünmez duvarın diğer tarafında bekliyordun. ♪
Dialogue: 0,0:01:21.66,0:01:31.62,OP11 Lyrics,,0,0,0,,♪ Yakında orada olacağım, tek bir dünyaya inanıyorum, evet evet... ♪
Dialogue: 0,0:01:31.64,0:01:35.04,OP11 Lyrics,,0,0,0,,♪ hadi millet gidelim, müziği paylaşıyoruz. ♪
Dialogue: 0,0:01:35.67,0:01:39.87,OP11 Lyrics,,0,0,0,,♪ hadi gidelim bebeğim, bebeğim, oh tek bir dünyayı paylaşıyoruz. ♪
