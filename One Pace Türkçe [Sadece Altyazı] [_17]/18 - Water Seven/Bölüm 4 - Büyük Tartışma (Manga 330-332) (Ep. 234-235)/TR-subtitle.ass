Dialogue: 5,0:02:12.61,0:02:16.21,Flashbacks-720p,,0,0,0,,Çocukken sanatımı insanların\Nevleri üstünde çalışırdım.
Dialogue: 5,0:02:25.79,0:02:28.46,Flashbacks-720p,,0,0,0,,Paranın hepsini aldılar,...
Dialogue: 5,0:02:28.46,0:02:29.17,Flashbacks-720p,,0,0,0,,...Nami!
Dialogue: 5,0:02:30.50,0:02:35.63,Flashbacks-720p,,0,0,0,,Diğerlerinin yüzüne bakamam!
Dialogue: 5,0:22:44.14,0:22:46.63,Flashbacks-720p,,0,0,0,,Neden bahsediyorsun? Bir an önce bin.
Dialogue: 5,0:22:47.02,0:22:49.34,Flashbacks-720p,,0,0,0,,Artık arkadaşız, değil mi?
Dialogue: 5,0:02:01.18,0:02:04.45,Main-207+,,0,0,0,,Hey, bize biraz daha yiyecek\Ngetirin ve acele edin!
Dialogue: 5,0:02:04.45,0:02:06.30,Main-207+,,0,0,0,,Para içinde yüzüyoruz!
Dialogue: 5,0:02:06.30,0:02:08.14,Main-207+,,0,0,0,,İçki her zamankinden daha iyi!
Dialogue: 5,0:02:37.12,0:02:40.59,Main-207+,,0,0,0,,Canına okunmadık kimse bırakmayın!
Dialogue: 5,0:02:47.11,0:02:48.35,Main-207+,,0,0,0,,Emin misin?
Dialogue: 5,0:02:48.35,0:02:50.40,Main-207+,,0,0,0,,Bak, yenildin!
Dialogue: 5,0:02:50.40,0:02:52.40,Main-207+,,0,0,0,,Tamam, yiyecekleri sen alıyorsun!
Dialogue: 5,0:02:52.40,0:02:56.19,Main-207+,,0,0,0,,Dükkandaki bütün yiyecekleri al! \NÖdeyebiliriz!
Dialogue: 5,0:03:02.60,0:03:06.95,Main-207+,,0,0,0,,Kahretsin! Bunu unutmayın!\NSonra hepinizi yeneceğim!
Dialogue: 5,0:03:27.22,0:03:29.45,Main-207+,,0,0,0,,Ne?! Neler oluyor?!
Dialogue: 5,0:03:34.00,0:03:35.41,Main-207+,,0,0,0,,Kapıda birileri var!
Dialogue: 5,0:03:35.41,0:03:37.40,Main-207+,,0,0,0,,Siz de kimsiniz?!
Dialogue: 5,0:03:44.78,0:03:46.72,Main-207+,,0,0,0,,Bunlar onlar!
Dialogue: 5,0:03:55.54,0:03:58.34,Main-207+,,0,0,0,,Bu o!
Dialogue: 5,0:03:58.34,0:04:00.78,Main-207+,,0,0,0,,Hasır Şapkalı Luffy!
Dialogue: 5,0:04:12.71,0:04:16.15,Main-207+,,0,0,0,,Paranızı geri almaya mı geldiniz, küçük aptallar?
Dialogue: 5,0:04:16.15,0:04:18.18,Main-207+,,0,0,0,,Neyle karşı karşıya\Nolduğunuza bir bakın!
Dialogue: 5,0:04:18.20,0:04:21.86,Main-207+,,0,0,0,,Gerçekten dört kişiyle çetemize\Nkarşı gelebileceğinizi mi sanıyorsunuz?
Dialogue: 5,0:04:24.11,0:04:30.33,Main-207+,,0,0,0,,Yine de ödüllerinizi toplamamıza\Nizin vermeniz iyi olurdu!
Dialogue: 5,0:04:31.70,0:04:34.96,Main-207+,,0,0,0,,Uzun burunlu hanım evladının kaptanı!
Dialogue: 5,0:04:36.10,0:04:39.90,Main-207+,,0,0,0,,Bu, ne kadar güçsüz olduğunuzu gösteriyor!
Dialogue: 5,0:04:43.67,0:04:45.97,Main-207+,,0,0,0,,Vur bana, küçük sinek!
Dialogue: 5,0:04:47.64,0:04:50.55,Main-207+,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 5,0:04:55.10,0:04:56.77,Main-207+,,0,0,0,,Bu da ne?
Dialogue: 5,0:04:57.96,0:05:03.50,Main-207+,,0,0,0,,Onu yumruklayacak mısınız? O çelik zırhı savaş gemisinin topu bile parçalayamaz!
Dialogue: 5,0:05:03.50,0:05:04.70,Main-207+,,0,0,0,,Çok komik!
Dialogue: 5,0:05:06.70,0:05:10.62,Main-207+,,0,0,0,,Oyun oynayacaksan, seni hemen ezeceğim!
Dialogue: 5,0:05:27.80,0:05:29.30,Main-207+,,0,0,0,,{\fad(150,150)}Cannon!
Dialogue: 5,0:05:27.80,0:05:29.30,Attack,,0,0,0,,{\fad(150,150)}Top
Dialogue: 5,0:05:42.60,0:05:46.00,Main-207+,,0,0,0,,Zırhı parçaladı!
Dialogue: 5,0:05:46.95,0:05:48.16,Main-207+,,0,0,0,,Hey!
Dialogue: 5,0:05:49.10,0:05:53.66,Main-207+,,0,0,0,,D-Durun biraz çocuklar! Bunu konuşarak halledelim!
Dialogue: 5,0:05:53.66,0:05:55.23,Main-207+,,0,0,0,,Konuşalım...
Dialogue: 5,0:05:55.23,0:05:57.12,Main-207+,,0,0,0,,Konuşa...
Dialogue: 5,0:05:57.12,0:05:58.82,Main-207+,,0,0,0,,Topları ateşleyin!
Dialogue: 5,0:05:58.82,0:06:00.50,Main-207+,,0,0,0,,Yaşasın!
Dialogue: 5,0:06:03.00,0:06:04.70,Main-207+,,0,0,0,,{\fad(150,150)}Santouryuu:
Dialogue: 5,0:06:03.00,0:06:04.70,Attack,,0,0,0,,{\fad(150,150)}Üç Kılıç Tekniği
Dialogue: 5,0:06:05.35,0:06:06.47,Main-207+,,0,0,0,,{\fad(150,150)}Karasuma...
Dialogue: 5,0:06:05.35,0:06:06.47,Attack,,0,0,0,,{\fad(150,150)}Karga İblis
Dialogue: 5,0:06:12.80,0:06:13.89,Main-207+,,0,0,0,,{\fad(150,150)}Gari!
Dialogue: 5,0:06:12.80,0:06:13.89,Attack,,0,0,0,,{\fad(150,150)}Avı
Dialogue: 5,0:06:27.19,0:06:30.57,Main-207+,,0,0,0,,O gülleler demirden yapılmıştı!
Dialogue: 5,0:06:38.01,0:06:39.67,Main-207+,,0,0,0,,Top da!
Dialogue: 5,0:06:39.67,0:06:43.27,Main-207+,,0,0,0,,Eyvah! Bu adamlar da kim?!\NBaşımız büyük dertte!
Dialogue: 5,0:06:44.13,0:06:48.13,Main-207+,,0,0,0,,Canını seven kaçsın! Buradan çıkmalıyız!
Dialogue: 5,0:06:55.41,0:07:00.35,Main-207+,,0,0,0,,Bitiremeyeceğiniz bir dövüşü başlatmayın.
Dialogue: 5,0:07:00.90,0:07:02.48,Main-207+,,0,0,0,,{\fad(150,150)}Party Table...
Dialogue: 5,0:07:00.90,0:07:02.48,Attack,,0,0,0,,{\fad(150,150)}Parti Masası
Dialogue: 5,0:07:03.23,0:07:05.19,Main-207+,,0,0,0,,{\fad(150,150)}Kick Course!
Dialogue: 5,0:07:03.23,0:07:05.19,Attack,,0,0,0,,{\fad(150,150)}Tekme Servisi
Dialogue: 5,0:07:17.79,0:07:20.09,Main-207+,,0,0,0,,Arka taraftan çıkamayız!
Dialogue: 5,0:07:20.09,0:07:22.50,Main-207+,,0,0,0,,Pencere! Pencereyi kullanın!
Dialogue: 5,0:07:23.25,0:07:24.38,Main-207+,,0,0,0,,{\fad(150,150)}Rumble!
Dialogue: 5,0:07:23.25,0:07:24.38,Attack,,0,0,0,,{\fad(150,150)}Gümbürtü
Dialogue: 5,0:07:25.30,0:07:26.82,Main-207+,,0,0,0,,{\fad(150,150)}Horn Point!
Dialogue: 5,0:07:25.30,0:07:26.82,Attack,,0,0,0,,{\fad(150,150)}Boynuz Noktası
Dialogue: 5,0:07:36.97,0:07:39.89,Main-207+,,0,0,0,,{\fad(150,150)}Roseo Colonnade!
Dialogue: 5,0:07:36.97,0:07:39.89,Attack,,0,0,0,,{\fad(150,150)}Pembe Sıra Sütunlar
Dialogue: 5,0:07:45.87,0:07:48.61,Main-207+,,0,0,0,,D-D-D-Durun biraz çocuklar!
Dialogue: 5,0:07:48.61,0:07:51.71,Main-207+,,0,0,0,,Para! Evet! İstediğiniz bu, değil mi?
Dialogue: 5,0:07:51.71,0:07:55.03,Main-207+,,0,0,0,,Şu pısırıktaki 200 milyon beli!
Dialogue: 5,0:07:55.03,0:07:59.00,Main-207+,,0,0,0,,Artık burada olmadığını söylediğim için üzgünüm!
Dialogue: 5,0:07:59.00,0:08:03.59,Main-207+,,0,0,0,,Patronumuz Franky, parayı aldı ve alışverişe gitti!
Dialogue: 5,0:08:03.59,0:08:07.00,Main-207+,,0,0,0,,Sadece kara çarşıda ticaret yaparız, \Nbu yüzden nerede olduğunu bile bilmiyoruz!
Dialogue: 5,0:08:07.91,0:08:10.20,Main-207+,,0,0,0,,Kısacası bize ne yaparsanız yapın,...
Dialogue: 5,0:08:10.20,0:08:12.51,Main-207+,,0,0,0,,...200 milyonunuzu geri alamazsı-
Dialogue: 5,0:08:14.14,0:08:16.02,Main-207+,,0,0,0,,Ah{h}! Zambai!
Dialogue: 5,0:08:18.01,0:08:23.01,Main-207+,,0,0,0,,Bu kadar konuşma yeter.\NMesele para değil.
Dialogue: 5,0:08:23.60,0:08:26.81,Main-207+,,0,0,0,,Evet. Artık çok geç.
Dialogue: 5,0:08:31.45,0:08:34.01,Main-207+,,0,0,0,,Vücudunuzdaki tüm kemikleri kıracağız.
Dialogue: 5,0:08:34.74,0:08:36.35,Main-207+,,0,0,0,,Her kemiği mi?
Dialogue: 5,0:08:36.35,0:08:38.50,Main-207+,,0,0,0,,Sersem, gözünü korkutmasına izin verme!
Dialogue: 5,0:08:38.50,0:08:40.13,Main-207+,,0,0,0,,Birilerinin kemikleri kırılacaksa,...
Dialogue: 5,0:08:40.13,0:08:44.67,Main-207+,,0,0,0,,...bunu yapanlar hurdalık ödül avcıları Franky Kardeşler olacaktır!
Dialogue: 5,0:08:44.67,0:08:48.21,Main-207+,,0,0,0,,Onlara Franky Evi Özeli'nden tattırın!
Dialogue: 5,0:08:55.00,0:08:57.64,Main-207+,,0,0,0,,{\fad(150,150)}Ne Bulursan Fırlat Topu!
Dialogue: 5,0:09:05.70,0:09:07.99,Main-207+,,0,0,0,,Geliyorlar! Saldırın!
Dialogue: 5,0:09:07.99,0:09:11.79,Main-207+,,0,0,0,,Yerinizden oynamayın! \NMühimmatı sonuna kadar eteşleyin!
Dialogue: 5,0:09:11.79,0:09:13.82,Main-207+,,0,0,0,,Sadece dört kişiler!
Dialogue: 5,0:09:33.14,0:09:35.45,Main-207+,,0,0,0,,O ses de neydi? Havaifişek mi?
Dialogue: 5,0:09:35.45,0:09:38.51,Main-207+,,0,0,0,,Kuzeydoğudan geldi, Franky Evi'nin yakınından.
Dialogue: 5,0:09:38.51,0:09:42.34,Main-207+,,0,0,0,,Yine o insanlar. Şimdi neyin peşindeler acaba?
Dialogue: 5,0:09:42.34,0:09:45.81,Main-207+,,0,0,0,,Cidden-\NŞşş! Seni duyacak!
Dialogue: 5,0:09:48.69,0:09:51.50,Main-207+,,0,0,0,,Ah, ah. Kendilerini fazla kaptırmışlar.
Dialogue: 5,0:09:51.50,0:09:56.49,Main-207+,,0,0,0,,Bu çocuklar kendilerine sınır koymayı bilmiyor.
Dialogue: 5,0:09:56.49,0:10:01.45,Main-207+,,0,0,0,,Bırak eğlensinler. Bugün kutlama günü.
Dialogue: 5,0:10:18.29,0:10:20.30,Main-207+,,0,0,0,,Franky'nin peşinden gielim mi?
Dialogue: 5,0:10:20.30,0:10:21.85,Main-207+,,0,0,0,,Nereye bakacağız?
Dialogue: 5,0:10:23.01,0:10:27.81,Main-207+,,0,0,0,,Kahretsin, paramızın nereye\Ngittiğine dair hiçbir fikrimiz yok.
Dialogue: 5,0:10:28.33,0:10:33.61,Main-207+,,0,0,0,,Franky denen adamı çivilesek bile,\Nalışverişini çoktan bitirmiş olacak.
Dialogue: 5,0:10:33.61,0:10:37.82,Main-207+,,0,0,0,,Ne yapıyoruz?\NOnu beklesek bile bir süre geri dönmeyecektir.
Dialogue: 5,0:10:38.37,0:10:40.94,Main-207+,,0,0,0,,Hey! İlk yardım yapmayı bitirdim!
Dialogue: 5,0:10:40.94,0:10:44.08,Main-207+,,0,0,0,,Onu sedyeye taşımalıyız, hepiniz yardıma gelin!
Dialogue: 5,0:10:44.74,0:10:46.96,Main-207+,,0,0,0,,Sadece konuşarak bir yere varamayacağız.
Dialogue: 5,0:10:46.96,0:10:51.20,Main-207+,,0,0,0,,Şimdilik gemiye dönelim.\NNami-san'ı orada yalnız bıraktık.
Dialogue: 5,0:10:51.20,0:10:53.29,Main-207+,,0,0,0,,Gemi meselesiyle birlikte bir de...
Dialogue: 5,0:10:53.29,0:10:55.89,Main-207+,,0,0,0,,...endişelenilecek Robin-chan var.
Dialogue: 5,0:10:55.89,0:10:56.71,Main-207+,,0,0,0,,Evet.
Dialogue: 5,0:10:57.21,0:10:58.56,Main-207+,,0,0,0,,Hey, Luffy!
Dialogue: 5,0:11:02.30,0:11:04.01,Main-207+,,0,0,0,,Gemi konusunda...
Dialogue: 5,0:11:05.31,0:11:06.76,Main-207+,,0,0,0,,...kararımı verdim.
Dialogue: 5,0:11:16.42,0:11:20.97,Main-207+,,0,0,0,,Going Merry'ye veda ediyoruz.
Dialogue: 5,0:11:26.52,0:11:29.58,Main-207+,,0,0,0,,Pekala, bugünlük gidiyorum.
Dialogue: 5,0:11:31.70,0:11:34.71,Main-207+,,0,0,0,,Kahretsin, ne inatçı bir adam.
Dialogue: 5,0:11:35.23,0:11:38.99,Main-207+,,0,0,0,,Elinde olup olmadığını bile bilmememize rağmen,...
Dialogue: 5,0:11:38.99,0:11:43.55,Main-207+,,0,0,0,,...beni bu harabe şehre gönderip duruyorlar.
Dialogue: 5,0:11:49.20,0:11:50.40,Main-207+,,0,0,0,,Benim, Kalifa.
Dialogue: 5,0:11:50.40,0:11:52.52,Main-207+,,0,0,0,,Evet... içeri gir.
Dialogue: 5,0:11:53.91,0:11:56.50,Main-207+,,0,0,0,,Toplantınızın bittiğini görüyorum, Iceburg-{\i1}san{\i0}.
Dialogue: 5,0:11:56.50,0:11:58.19,Main-207+,,0,0,0,,İçecek bir şey ister misiniz?
Dialogue: 5,0:11:58.19,0:12:00.53,Main-207+,,0,0,0,,Olur.
Dialogue: 5,0:12:01.39,0:12:03.39,Main-207+,,0,0,0,,Bugün siyah çay-
Dialogue: 5,0:12:03.39,0:12:04.87,Main-207+,,0,0,0,,Zaten yaptım.
Dialogue: 5,0:12:06.12,0:12:08.80,Main-207+,,0,0,0,,Evet... ne kadar hızlısın, Kalifa.
Dialogue: 5,0:12:08.80,0:12:10.25,Main-207+,,0,0,0,,İzninizle.
Dialogue: 5,0:12:13.85,0:12:16.99,Main-207+,,0,0,0,,Bay Corgi giderken hep sinirli görünüyor.
Dialogue: 5,0:12:16.99,0:12:19.50,Main-207+,,0,0,0,,Onunla her ne görüşüyorsanız artık?
Dialogue: 5,0:12:19.50,0:12:20.84,Main-207+,,0,0,0,,Evet.
Dialogue: 5,0:12:20.84,0:12:25.18,Main-207+,,0,0,0,,Elimdeki bir şeyi istiyor ve onun\Niçin çeşitli tekliflerde bulunuyor.
Dialogue: 5,0:12:27.40,0:12:29.85,Main-207+,,0,0,0,,Çok önemli olmalı.
Dialogue: 5,0:12:29.85,0:12:35.06,Main-207+,,0,0,0,,Evet... ne demeye çalıştığını bilmediğimi\Nsöyleyerek her zaman reddediyorum.
Dialogue: 5,0:12:35.55,0:12:38.08,Main-207+,,0,0,0,,Tam bir baş belası.
Dialogue: 5,0:12:42.95,0:12:45.82,Main-207+,,0,0,0,,Hey, Usopp uyandı!
Dialogue: 5,0:12:45.82,0:12:48.92,Main-207+,,0,0,0,,Cidden mi?! Hele şükür!
Dialogue: 5,0:12:49.90,0:12:51.70,Main-207+,,0,0,0,,İçim rahatladı.
Dialogue: 5,0:12:55.36,0:12:56.63,Main-207+,,0,0,0,,Hey, Usopp!
Dialogue: 5,0:13:02.60,0:13:05.59,Main-207+,,0,0,0,,Robin-chan hala dönmedi.
Dialogue: 5,0:13:05.59,0:13:09.56,Main-207+,,0,0,0,,Üfff, bizi cidden endişelendirdin!
Dialogue: 5,0:13:10.80,0:13:15.49,Main-207+,,0,0,0,,Doğru. Oraya öyle saldırarak\Nkendini öldürtebilirdin.
Dialogue: 5,0:13:15.49,0:13:18.40,Main-207+,,0,0,0,,Oradan canlı çıkabilmene sevindik.
Dialogue: 5,0:13:18.40,0:13:20.89,Main-207+,,0,0,0,,Harekete geçmeden önce biraz düşün.
Dialogue: 5,0:13:20.89,0:13:23.35,Main-207+,,0,0,0,,Bunu söyleyen sen olmamalısın!
Dialogue: 5,0:13:25.90,0:13:29.74,Main-207+,,0,0,0,,Yükten başka bir şey olmadım. Üzgünüm!
Dialogue: 5,0:13:29.74,0:13:32.66,Main-207+,,0,0,0,,Gerçekten!\NÇok utanıyorum...
Dialogue: 5,0:13:32.66,0:13:34.82,Main-207+,,0,0,0,,...çocuklar!
Dialogue: 5,0:13:37.87,0:13:40.77,Main-207+,,0,0,0,,O paraya ihtiyacımız vardı ve ben... ben...
Dialogue: 5,0:13:40.77,0:13:42.90,Main-207+,,0,0,0,,Kes şunu! Sakin ol!
Dialogue: 5,0:13:42.90,0:13:44.38,Main-207+,,0,0,0,,Tamam, bırak beni!
Dialogue: 5,0:13:44.38,0:13:48.93,Main-207+,,0,0,0,,Ama o parayı elde etmek için çok çaba sarf ettik ve ben...
Dialogue: 5,0:13:48.93,0:13:51.90,Main-207+,,0,0,0,,Usopp, yatakta olmalısın!
Dialogue: 5,0:13:51.90,0:13:56.02,Main-207+,,0,0,0,,Duydun mu? \NChopper'ın dediğini yapmalısın.
Dialogue: 5,0:13:57.30,0:13:59.00,Main-207+,,0,0,0,,O zaman...
Dialogue: 5,0:13:59.66,0:14:02.02,Main-207+,,0,0,0,,...parayı geri almanın bir yolu yok mu?
Dialogue: 5,0:14:02.50,0:14:07.07,Main-207+,,0,0,0,,Franky denen adam geri dönene\Nkadar bunu bilemeyeceğiz.
Dialogue: 5,0:14:07.55,0:14:10.24,Main-207+,,0,0,0,,Anlıyorum. Üzgünüm.
Dialogue: 5,0:14:10.24,0:14:14.20,Main-207+,,0,0,0,,Para gitmiş olsa da hala\N100 milyonumuz var!
Dialogue: 5,0:14:14.20,0:14:15.62,Main-207+,,0,0,0,,Endişelenme!
Dialogue: 5,0:14:19.00,0:14:21.54,Main-207+,,0,0,0,,Para her zaman endişelenilecek bir şeydir!
Dialogue: 5,0:14:21.54,0:14:24.80,Main-207+,,0,0,0,,– Nami. \N– Afedersin.
Dialogue: 5,0:14:24.80,0:14:27.30,Main-207+,,0,0,0,,Hayır, sorun değil.
Dialogue: 5,0:14:27.30,0:14:31.30,Main-207+,,0,0,0,,Ama Luffy, ya gemi? \NMerry'ye ne olacak?
Dialogue: 5,0:14:31.30,0:14:34.56,Main-207+,,0,0,0,,Yüz milyon onu tamir etmeye yetiyor mu?
Dialogue: 5,0:14:35.15,0:14:38.52,Main-207+,,0,0,0,,Birinci sınıf bir tersanede olduğumuza\Ngöre tamir edebilirler, değil mi?
Dialogue: 5,0:14:38.52,0:14:43.61,Main-207+,,0,0,0,,Gemiyi öncekinden daha güçlü yapacaklar\Nve yolculuğumuza devam edeceğiz!
Dialogue: 5,0:14:43.61,0:14:45.53,Main-207+,,0,0,0,,Usopp, gemi konusunda...
Dialogue: 5,0:14:45.53,0:14:47.80,Main-207+,,0,0,0,,...yenisini almaya karar verdim.
Dialogue: 5,0:14:47.80,0:14:51.45,Main-207+,,0,0,0,,Sen yokken karar verdiğim için üzgünüm.
Dialogue: 5,0:14:51.45,0:14:53.60,Main-207+,,0,0,0,,Ama karar verdim!
Dialogue: 5,0:14:53.60,0:14:59.25,Main-207+,,0,0,0,,Going Merry bizim için gerçekten harikaydı\Nama veda etme vakti geldi!
Dialogue: 5,0:15:07.65,0:15:08.76,Main-207+,,0,0,0,,Bak!
Dialogue: 5,0:15:09.28,0:15:12.22,Main-207+,,0,0,0,,Buz amcanın yerinden bu kataloğu aldım.
Dialogue: 5,0:15:12.22,0:15:16.99,Main-207+,,0,0,0,,Alabileceğimiz bir sürü yeni gemi var!
Dialogue: 5,0:15:16.99,0:15:21.27,Main-207+,,0,0,0,,Yüz milyonla kullanılmış koca bir gemi-
Dialogue: 5,0:15:22.65,0:15:28.01,Main-207+,,0,0,0,,Dur, dur. Hadi ama. Bu epey tatsız bir şaka.
Dialogue: 5,0:15:28.01,0:15:29.11,Main-207+,,0,0,0,,Değil mi?
Dialogue: 5,0:15:29.80,0:15:33.89,Main-207+,,0,0,0,,Bakın! Chopper ciddi olduğunu sandı!
Dialogue: 5,0:15:33.89,0:15:37.59,Main-207+,,0,0,0,,Kaptanımız cidden çok şakacı biri!
Dialogue: 5,0:15:37.59,0:15:40.09,Main-207+,,0,0,0,,Söylesene şuna, Nami!
Dialogue: 5,0:15:43.70,0:15:48.42,Main-207+,,0,0,0,,Ne? Tamiratı karşılayamayız mı diyorsun?
Dialogue: 5,0:15:48.42,0:15:53.00,Main-207+,,0,0,0,,İki yüz milyonu almalarına izin verdiğim\Niçin karşılayamıyoruz, değil mi?
Dialogue: 5,0:15:53.00,0:15:55.23,Main-207+,,0,0,0,,Bu yüzden. Değil mi, Luffy?
Dialogue: 5,0:15:55.23,0:15:58.50,Main-207+,,0,0,0,,Birinci sınıf bir tersanenin yüksek fiyatları olmalı!
Dialogue: 5,0:15:58.50,0:16:00.18,Main-207+,,0,0,0,,Hayır! O yüzden değil!
Dialogue: 5,0:16:00.18,0:16:04.73,Main-207+,,0,0,0,,Hey, neden o zaman?! Söylesene!\NBunu kaldırabileceğimi mi sanıyorsun?!
Dialogue: 5,0:16:04.73,0:16:08.82,Main-207+,,0,0,0,,Elbette hayır! \NParayı kaybetmenin bununla ilgisi yok!
Dialogue: 5,0:16:08.82,0:16:11.82,Main-207+,,0,0,0,,O zaman yeni gemiyle ilgili bu saçmalığı\Nnasıl bu kadar kolay söylüyorsun?!
Dialogue: 5,0:16:11.82,0:16:13.24,Main-207+,,0,0,0,,İkiniz de kesin şunu!
Dialogue: 5,0:16:13.24,0:16:16.98,Main-207+,,0,0,0,,Tartışmanın ne faydası olacak?\NSakinleşin ve tekrar konuşun!
Dialogue: 5,0:16:18.41,0:16:21.79,Main-207+,,0,0,0,,Bu konuda nasıl sakin olabilirim?! \NBu, hayatım boyunca duyduğum en aptalca şey!
Dialogue: 5,0:16:21.79,0:16:25.23,Main-207+,,0,0,0,,Hey, bu konu çok önemli!\NHemen hararetlenmeyin!
Dialogue: 5,0:16:25.23,0:16:29.20,Main-207+,,0,0,0,,Doğru Usopp. Dinlenmen lazım. \NBedenin bu kadarını-
Dialogue: 5,0:16:29.20,0:16:30.99,Main-207+,,0,0,0,,Umrumda değil!
Dialogue: 5,0:16:30.99,0:16:34.26,Main-207+,,0,0,0,,Kaptan öylece durmuş gemiyi değiştireceğiz\Ndiyor. Benim de iç çekip kabul etmem lazım?!
Dialogue: 5,0:16:34.61,0:16:38.20,Main-207+,,0,0,0,,O kadar basit değil! Zor bir karardı!
Dialogue: 5,0:16:38.20,0:16:40.89,Main-207+,,0,0,0,,Zor bir karar verdiğinde olan bu mu?!
Dialogue: 5,0:16:41.28,0:16:44.44,Main-207+,,0,0,0,,Bu şeyi suratıma sallayıp öyle\Nkonuşma cüretini gösterme!
Dialogue: 5,0:16:45.15,0:16:46.36,Main-207+,,0,0,0,,Ne yapıyorsun sen?!
Dialogue: 5,0:16:46.85,0:16:48.50,Main-207+,,0,0,0,,Onu görmek istemiyorum!
Dialogue: 5,0:16:48.50,0:16:52.50,Main-207+,,0,0,0,,Hey, Luffy! Çalınan para yüzünden\Ndeğilse ne yüzünden?!
Dialogue: 5,0:16:52.50,0:16:56.49,Main-207+,,0,0,0,,Ha, Luffy?! Söylesene!\NHadi! Niye hiçbir şey söylemiyorsun?!
Dialogue: 5,0:16:56.49,0:16:58.72,Main-207+,,0,0,0,,Kaldıramayacağımı düşünüyorsan çekinme!
Dialogue: 5,0:16:58.72,0:17:02.79,Main-207+,,0,0,0,,Söyle! Bana bir sebep söylemezsen\Ntek kelime daha dinlemeyeceğim!
Dialogue: 5,0:17:02.79,0:17:04.75,Main-207+,,0,0,0,,Merry artık...
Dialogue: 5,0:17:16.80,0:17:20.22,Main-207+,,0,0,0,,Ne dedin sen?
Dialogue: 5,0:17:20.86,0:17:23.02,Main-207+,,0,0,0,,Tekrarlatıp durma!
Dialogue: 5,0:17:23.45,0:17:26.80,Main-207+,,0,0,0,,Merry tamir edilemez!
Dialogue: 5,0:17:26.80,0:17:29.36,Main-207+,,0,0,0,,Onu kimse tamir edemez.
Dialogue: 5,0:17:31.78,0:17:35.15,Main-207+,,0,0,0,,Başka bir yolu olsaydı, bunu yapıyor olmazdım!
Dialogue: 5,0:17:35.15,0:17:39.99,Main-207+,,0,0,0,,Bu bizim gemimiz! \NÜzerinde durduğumuz bu gemi bizim!
Dialogue: 5,0:17:39.99,0:17:43.50,Main-207+,,0,0,0,,Doğru. Gemi batacak.
Dialogue: 5,0:17:46.46,0:17:48.80,Main-207+,,0,0,0,,Neden bahsediyorsun, Luffy?
Dialogue: 5,0:17:48.80,0:17:52.76,Main-207+,,0,0,0,,Bu doğru. Tersanede böyle söylediler.
Dialogue: 5,0:17:53.89,0:17:57.00,Main-207+,,0,0,0,,Bir sonraki adaya ulaşamayacak.
Dialogue: 5,0:17:57.00,0:18:00.28,Main-207+,,0,0,0,,Oh, demek ulaşamayacağız, ha?
Dialogue: 5,0:18:00.28,0:18:04.41,Main-207+,,0,0,0,,Yani yeni tanıştığın birkaç adamın, seni bu\Nlaflarla kandırmasına izin verip mutlu mu oldun?
Dialogue: 5,0:18:04.41,0:18:06.00,Main-207+,,0,0,0,,Ne?
Dialogue: 5,0:18:06.00,0:18:09.90,Main-207+,,0,0,0,,Lafta birinci sınıf gemi marangozları\Nyapılamayacağını söyledi...
Dialogue: 5,0:18:10.90,0:18:13.89,Main-207+,,0,0,0,,...ve sen onlara inandın mı?!
Dialogue: 5,0:18:13.89,0:18:16.54,Main-207+,,0,0,0,,Tüm yolculuğumuz boyunca birlikteyik!
Dialogue: 5,0:18:16.54,0:18:18.64,Main-207+,,0,0,0,,Sert denizler ve dövüşler boyunca!
Dialogue: 5,0:18:18.64,0:18:21.68,Main-207+,,0,0,0,,İyi ve kötü zamanlarda bizimle olmuş bir arkadaş!
Dialogue: 5,0:18:21.68,0:18:25.51,Main-207+,,0,0,0,,Onu burada ölüme mi terkedeceksin?!
Dialogue: 5,0:18:28.90,0:18:34.76,Main-207+,,0,0,0,,Geminin sana ifade ettiği tek şey bu mu, Luffy?!
Dialogue: 5,0:18:36.59,0:18:39.76,Main-207+,,0,0,0,,Bu kadarı yeter, Usopp. \NBöyle bağırmaya devam edersen...
Dialogue: 5,0:18:39.76,0:18:41.76,Main-207+,,0,0,0,,– Sağol, çekil kenara.\N– Ne?
Dialogue: 5,0:18:43.60,0:18:46.02,Main-207+,,0,0,0,,Daha bitirmedim.
Dialogue: 5,0:18:46.02,0:18:47.02,Main-207+,,0,0,0,,Usopp...
Dialogue: 5,0:18:49.95,0:18:52.73,Main-207+,,0,0,0,,O zaman kendin hasar tespiti\Nyapabileceğini mi söylüyorsun?
Dialogue: 5,0:18:53.62,0:18:58.50,Main-207+,,0,0,0,,Gemi marangozumuz yok! \NBu yüzden onlara baktırttık!
Dialogue: 5,0:18:58.50,0:19:02.70,Main-207+,,0,0,0,,Hiç önemli değil! \NOnların yardımına ihtiyacımız yok!
Dialogue: 5,0:19:02.70,0:19:05.88,Main-207+,,0,0,0,,Her zaman yaptığım gibi onu tamir edeceğim!
Dialogue: 5,0:19:05.88,0:19:08.79,Main-207+,,0,0,0,,Sonuçta buraya kadar hep böyle geldik.
Dialogue: 5,0:19:08.79,0:19:12.50,Main-207+,,0,0,0,,Tamam, hemen başlıyorum.\NHey, siz de yardıma gelin.
Dialogue: 5,0:19:12.50,0:19:14.10,Main-207+,,0,0,0,,Hey, dur, Usopp.
Dialogue: 5,0:19:14.10,0:19:19.13,Main-207+,,0,0,0,,Haklısın. Daha fazla tahtaya ihtiyacımız var. \NGidip tersaneden biraz alın.
Dialogue: 5,0:19:19.13,0:19:21.18,Main-207+,,0,0,0,,Yapacak çok işimiz var!
Dialogue: 5,0:19:21.18,0:19:23.60,Main-207+,,0,0,0,,Sen gemi marangozu değilsin, Usopp!
Dialogue: 5,0:19:23.60,0:19:24.72,Main-207+,,0,0,0,,Yapma, Luffy!
Dialogue: 5,0:19:25.80,0:19:28.10,Main-207+,,0,0,0,,Evet, ne olmuş?!
Dialogue: 5,0:19:28.10,0:19:31.39,Main-207+,,0,0,0,,O işçiler bir başkasının gemisini tamir\Netmek için kılını bile kıpırdatmayacak!
Dialogue: 5,0:19:31.39,0:19:37.25,Main-207+,,0,0,0,,Tek bir bakışın ardından vazgeçen sorumsuz\Ngemi marangozlarının söyledikleri umrumda değil!
Dialogue: 5,0:19:37.25,0:19:38.66,Main-207+,,0,0,0,,Usopp...
Dialogue: 5,0:19:38.66,0:19:43.29,Main-207+,,0,0,0,,Bu, kendi gemimizle bizim\Nilgilenmemiz gerektiğini gösteriyor.
Dialogue: 5,0:19:43.29,0:19:48.19,Main-207+,,0,0,0,,Yemin ederim\Nbu gemiyi terketmeyeceğim!
Dialogue: 5,0:19:48.84,0:19:50.60,Main-207+,,0,0,0,,Hepiniz aklınızı mı kaçırdınız?!
Dialogue: 5,0:19:50.60,0:19:54.80,Main-207+,,0,0,0,,Birkaç kodaman gemi marangozu, sizi inandırıcı\Nbir hikayeyle doyurmuş ve siz de inanmışsınız!
Dialogue: 5,0:19:54.80,0:19:58.92,Main-207+,,0,0,0,,Tanıdığım tayfa arkadaşları,\Nşarkılarının ve danslarının mazisini görür...
Dialogue: 5,0:19:58.92,0:20:02.72,Main-207+,,0,0,0,,...ve Merry'nin gücüne inanırdı!
Dialogue: 5,0:20:02.72,0:20:06.81,Main-207+,,0,0,0,,Sen sadece kaptan olmakla hava\Natarken, aşırı basitleştirilmiş,...
Dialogue: 5,0:20:06.81,0:20:09.79,Main-207+,,0,0,0,,...bunakça bir saçmalıktan bahsediyorsun.
Dialogue: 5,0:20:09.79,0:20:12.02,Main-207+,,0,0,0,,Seni yanlış değerlendirmişim, Luffy!
Dialogue: 5,0:20:12.36,0:20:14.80,Main-207+,,0,0,0,,Dur biraz, Usopp. \NLuffy de senin hissettiklerini-
Dialogue: 5,0:20:14.80,0:20:17.90,Main-207+,,0,0,0,,Bu işe karışma, Nami! Kararımı verdim!
Dialogue: 5,0:20:18.35,0:20:22.44,Main-207+,,0,0,0,,Artık değiştirmeyeceğim!\NNe dersen de, yeni bir gemi alıyoruz!
Dialogue: 5,0:20:22.44,0:20:24.32,Main-207+,,0,0,0,,Merry'ye veda ediyoruz!
Dialogue: 5,0:20:24.32,0:20:26.78,Main-207+,,0,0,0,,Bana bu saçmalıktan bahsetme!\NBunu yapmana izin vermeyeceğim!
Dialogue: 5,0:20:26.78,0:20:31.75,Main-207+,,0,0,0,,Beni dinle, Luffy! Sonsuza kadar senin gibi birinin peşinden gitmeye herkes tahammül edemez!
Dialogue: 5,0:20:32.25,0:20:35.92,Main-207+,,0,0,0,,Yaralı bir arkadaşı geride bırakmak anlamına\Ngelecekse, asla yolculuğa devam etmezdim.
Dialogue: 5,0:20:35.92,0:20:39.60,Main-207+,,0,0,0,,Saçmalıyorsun! Arkadaşımız bile olsa, \Nbir gemiye insanmış gibi davranamazsın!
Dialogue: 5,0:20:39.60,0:20:42.99,Main-207+,,0,0,0,,Davranabilirsin!\NMerry'nin devam etmek için hala gücü var!
Dialogue: 5,0:20:42.99,0:20:44.27,Main-207+,,0,0,0,,Ne düşündüğünü biliyorum.
Dialogue: 5,0:20:44.27,0:20:47.17,Main-207+,,0,0,0,,Yeni bir gemi alma hevesine kapıldın!
Dialogue: 5,0:20:47.17,0:20:49.43,Main-207+,,0,0,0,,Merry'yi sevmek konusunda söylediğin her şey laftan ibaretmiş!
Dialogue: 5,0:20:49.43,0:20:50.93,Main-207+,,0,0,0,,Yeter artık!
Dialogue: 5,0:20:50.93,0:20:52.06,Main-207+,,0,0,0,,Luffy!
Dialogue: 5,0:20:52.06,0:20:54.29,Main-207+,,0,0,0,,Acı çeken sadece senmişsin gibi konuşma!
Dialogue: 5,0:20:54.29,0:20:55.94,Main-207+,,0,0,0,,Hepimiz aynı şeyleri hissediyoruz!
Dialogue: 5,0:20:55.94,0:20:58.48,Main-207+,,0,0,0,,Öyleyse gemiyi değiştirmeyi nasıl düşünebilirsiniz!
Dialogue: 5,0:20:58.48,0:21:03.28,Main-207+,,0,0,0,,Sen bilirsin o zaman! İşleri yapma şeklimi\Nbeğenmiyorsan, pılını pırtını toplayıp-
Dialogue: 5,0:21:07.13,0:21:08.73,Main-207+,,0,0,0,,Sanji!
Dialogue: 5,0:21:14.61,0:21:19.21,Main-207+,,0,0,0,,Seni aptal.\NNe söylemek üzereydin?!
Dialogue: 5,0:21:19.21,0:21:23.97,Main-207+,,0,0,0,,Kendine gel! Lafını bil de konuş!\NDuyuyor musun, Luffy?!
Dialogue: 5,0:21:30.89,0:21:33.99,Main-207+,,0,0,0,,Üzgünüm. Ağzımdan kaçtı.
Dialogue: 5,0:21:33.99,0:21:38.06,Main-207+,,0,0,0,,Hayır. Sorun değil, Luffy.\Nİstediğin bu, değil mi?
Dialogue: 5,0:21:38.50,0:21:39.98,Main-207+,,0,0,0,,Ne?!
Dialogue: 5,0:21:42.38,0:21:47.82,Main-207+,,0,0,0,,Kendilerinin ağırlığını çekemeyen bir\Narkadaş tayfadan ayrılır ve geride bırakılır.
Dialogue: 5,0:21:48.36,0:21:50.28,Main-207+,,0,0,0,,Bunu Merry'ye yapacaksan,...
Dialogue: 5,0:21:51.40,0:21:53.29,Main-207+,,0,0,0,,...bana da yap!
Dialogue: 5,0:21:53.29,0:21:56.71,Main-207+,,0,0,0,,Hey, Usopp! Aptalca şeyler söyleme!
Dialogue: 5,0:21:56.71,0:21:58.90,Main-207+,,0,0,0,,Hayır, ciddiyim.
Dialogue: 5,0:21:58.90,0:22:01.17,Main-207+,,0,0,0,,Bu konuda çok düşündüm.
Dialogue: 5,0:22:02.74,0:22:04.10,Main-207+,,0,0,0,,Gerçeği söylemek gerekirse,...
Dialogue: 5,0:22:04.10,0:22:08.50,Main-207+,,0,0,0,,...asla sizin kadar güçlü canavarlar \Nolamayacağımı biliyordum.
Dialogue: 5,0:22:09.13,0:22:12.47,Main-207+,,0,0,0,,Daha bugün, birazcık paraya bile sahip çıkamadım.
Dialogue: 5,0:22:14.47,0:22:19.35,Main-207+,,0,0,0,,Gittiğiniz yerde, yükten başka bir şey olmayacağım!
Dialogue: 5,0:22:23.39,0:22:26.40,Main-207+,,0,0,0,,Güçsüz bir arkadaşa ihtiyacınız yok, değil mi?
Dialogue: 5,0:22:26.40,0:22:31.14,Main-207+,,0,0,0,,Luffy, sen Korsanlar Kralı olacak kişisin, değil mi?
Dialogue: 5,0:22:31.89,0:22:35.95,Main-207+,,0,0,0,,Ama kendi açımdan, \No kadar ileri gitmeme gerek yok.
Dialogue: 5,0:22:36.71,0:22:43.67,Main-207+,,0,0,0,,Sahi, tam denize açılacakken,\Nsana katılmam için beni davet ettin.
Dialogue: 5,0:22:53.19,0:22:54.89,Main-207+,,0,0,0,,Tek ilişkimiz bu.
Dialogue: 5,0:22:57.30,0:23:01.10,Main-207+,,0,0,0,,Farklı amaçlarımız olduğunu bildiğimize göre,\Nbirlikte yolculuk etmemiz için bir sebep yok!
Dialogue: 5,0:23:03.08,0:23:06.11,Main-207+,,0,0,0,,Hey! Nereye gidiyorsun, Usopp?!
Dialogue: 5,0:23:06.78,0:23:08.82,Main-207+,,0,0,0,,Nereye istersem giderim.
Dialogue: 5,0:23:09.20,0:23:12.53,Main-207+,,0,0,0,,Artık sizi ilgilendirmez.
Dialogue: 5,0:23:13.64,0:23:14.58,Main-207+,,0,0,0,,Ben...
Dialogue: 5,0:23:18.08,0:23:21.12,Main-207+,,0,0,0,,...tayfadan ayrılıyorum!
Dialogue: 5,0:23:41.50,0:23:44.06,Main-207+,,0,0,0,,Niye hiçbir şey söylemiyorsun?
Dialogue: 5,0:23:47.15,0:23:48.98,Main-207+,,0,0,0,,Usopp!
Dialogue: 5,0:23:49.86,0:23:52.78,Main-207+,,0,0,0,,Dur! Bunu yapamazsın!
Dialogue: 5,0:23:52.78,0:23:54.57,Main-207+,,0,0,0,,Hey! Geri dön!
Dialogue: 5,0:23:54.57,0:23:56.20,Main-207+,,0,0,0,,Hey, geri gel!
Dialogue: 5,0:23:56.20,0:23:59.41,Main-207+,,0,0,0,,Lütfen gitme, Usopp!
Dialogue: 5,0:24:02.84,0:24:06.09,Main-207+,,0,0,0,,Geri dön!
Dialogue: 5,0:24:06.09,0:24:07.38,Main-207+,,0,0,0,,Luffy.
Dialogue: 5,0:24:16.40,0:24:20.39,Main-207+,,0,0,0,,Luffy! Artık tayfanda olamam.
Dialogue: 5,0:24:21.60,0:24:24.40,Main-207+,,0,0,0,,Son ana dek yük oldum.
Dialogue: 5,0:24:26.69,0:24:30.53,Main-207+,,0,0,0,,Kaptan olduğun için gemi sana ait.
Dialogue: 5,0:24:32.50,0:24:34.24,Main-207+,,0,0,0,,Bana tek bir alternatif kalıyor.
Dialogue: 5,0:24:34.90,0:24:36.87,Main-207+,,0,0,0,,Monkey D. Luffy!
Dialogue: 5,0:24:44.60,0:24:47.01,Main-207+,,0,0,0,,SANA MEYDAN OKUYORUM!
Dialogue: 5,0:24:53.88,0:24:57.04,Main-207+,,0,0,0,,Dur! Ne diyorsun sen?!
Dialogue: 5,0:24:59.50,0:25:04.77,Main-207+,,0,0,0,,Bu gece saat 10'da döneceğim!
Dialogue: 5,0:25:04.77,0:25:07.90,Main-207+,,0,0,0,,Düelloyu kim kazanırsa, Merry'yi o alır!
Dialogue: 5,0:25:07.90,0:25:10.80,Main-207+,,0,0,0,,Seni yeneceğim ve onu yanımda götüreceğim!
Dialogue: 5,0:25:10.80,0:25:11.69,Main-207+,,0,0,0,,Böylece...
Dialogue: 5,0:25:12.38,0:25:15.41,Main-207+,,0,0,0,,...ilişkimiz sona erecek!
Dialogue: 5,0:15:20.69,0:15:21.28,Secondary-207+,,0,0,0,,Dur biraz.
Dialogue: 5,0:20:45.64,0:20:47.05,Secondary-207+,,0,0,0,,Böyle parlayacaksanız...
Dialogue: 5,0:20:47.05,0:20:49.43,Secondary-207+,,0,0,0,,...bunu çözemezsiniz!
