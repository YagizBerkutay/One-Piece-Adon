Dialogue: 50,0:02:07.02,0:02:09.48,Main-207+,,0,0,0,,Arka sokak bölgesine atladı!
Dialogue: 50,0:02:13.53,0:02:15.07,Main-207+,,0,0,0,,– Hey, geri dön!\N– Aşağı inme!
Dialogue: 50,0:02:15.07,0:02:16.74,Main-207+,,0,0,0,,Hey, beyler!
Dialogue: 50,0:02:17.33,0:02:18.58,Main-207+,,0,0,0,,Paulie-san!
Dialogue: 50,0:02:18.58,0:02:21.08,Main-207+,,0,0,0,,Arkasından gitmek hiçbir şeyi çözmez.
Dialogue: 50,0:02:21.08,0:02:22.16,Main-207+,,0,0,0,,Ama...!
Dialogue: 50,0:02:22.16,0:02:24.58,Main-207+,,0,0,0,,Denizin kendisiyle mücadele ediyor olacaksınız.
Dialogue: 50,0:02:24.58,0:02:26.54,Main-207+,,0,0,0,,Bu intihardır.
Dialogue: 50,0:02:26.54,0:02:28.84,Main-207+,,0,0,0,,Bu işi bana bırakın.
Dialogue: 50,0:02:28.84,0:02:31.01,Main-207+,,0,0,0,,Islak çatıda koşabilmesine inanamıyorum.
Dialogue: 50,0:02:31.01,0:02:32.59,Main-207+,,0,0,0,,Ne kadın ama.
Dialogue: 50,0:02:32.59,0:02:34.26,Main-207+,,0,0,0,,Sersem! Etkilenecek zaman değil!
Dialogue: 50,0:02:34.72,0:02:37.05,Main-207+,,0,0,0,,Hey, geri gel!
Dialogue: 50,0:02:37.05,0:02:39.18,Main-207+,,0,0,0,,Deniz seni yutacak!
Dialogue: 50,0:02:39.18,0:02:40.97,Thoughts-207+,,0,0,0,,Deniz şakayığı...
Dialogue: 50,0:02:45.02,0:02:47.27,Thoughts-207+,,0,0,0,,Deniz şakayığı...
Dialogue: 50,0:02:47.27,0:02:50.02,Thoughts-207+,,0,0,0,,Bacada bir deniz şakayığı.
Dialogue: 50,0:02:50.02,0:02:51.78,Thoughts-207+,,0,0,0,,Orada ne yapıyor?
Dialogue: 50,0:02:52.53,0:02:54.53,Thoughts-207+,,0,0,0,,Deniz şakayığı...
Dialogue: 50,0:03:11.59,0:03:14.34,Main-207+,,0,0,0,,Hey! Dur, rengeyiği! Sen de mi?!
Dialogue: 50,0:03:14.34,0:03:15.88,Main-207+,,0,0,0,,Zoro!
Dialogue: 50,0:03:17.97,0:03:20.97,Main-207+,,0,0,0,,Korsan abla, harikasın!
Dialogue: 50,0:03:21.56,0:03:23.73,Main-207+,,0,0,0,,Delilik bu.
Dialogue: 50,0:03:23.73,0:03:26.02,Main-207+,,0,0,0,,Zamanında başaramayacak.
Dialogue: 50,0:03:26.02,0:03:27.19,Main-207+,,0,0,0,,Denize bakın!
Dialogue: 50,0:03:28.06,0:03:31.23,Main-207+,,0,0,0,,Dalgalar neredeyse yetişti!
Dialogue: 50,0:03:33.15,0:03:35.65,Main-207+,,0,0,0,,Kahretsin, hepsi ölecek!
Dialogue: 50,0:03:35.65,0:03:37.16,Main-207+,,0,0,0,,İşleri bitti!
Dialogue: 50,0:03:40.20,0:03:42.66,Main-207+,,0,0,0,,Zoro! Zoro!
Dialogue: 50,0:03:42.66,0:03:44.12,Main-207+,,0,0,0,,Duyabiliyor musun?
Dialogue: 50,0:03:44.12,0:03:45.58,Main-207+,,0,0,0,,Benim!
Dialogue: 50,0:03:46.00,0:03:47.08,Main-207+,,0,0,0,,Chopper?!
Dialogue: 50,0:03:51.96,0:03:53.21,Main-207+,,0,0,0,,Çok uzak.
Dialogue: 50,0:03:53.21,0:03:55.05,Main-207+,,0,0,0,,Daha fazla yaklaşamam.
Dialogue: 50,0:04:02.68,0:04:04.81,Main-207+,,0,0,0,,LUFFY!!!
Dialogue: 50,0:04:11.11,0:04:14.28,Main-207+,,0,0,0,,Orada ne yapıyorsun?!
Dialogue: 50,0:04:16.74,0:04:20.91,Main-207+,,0,0,0,,Nami, oradaki sen misin?
Dialogue: 50,0:04:22.16,0:04:24.95,Main-207+,,0,0,0,,Hey, benim hatam değil!
Dialogue: 50,0:04:24.95,0:04:32.00,Main-207+,,0,0,0,,O güvercin adam beni uçurdu \Nve bu boşlukta sıkışıp kaldım.
Dialogue: 50,0:04:43.39,0:04:47.02,Main-207+,,0,0,0,,Dalga geçmeyi bırak! Hiç sırası değil!
Dialogue: 50,0:04:47.02,0:04:51.10,Main-207+,,0,0,0,,Sen aylaklık ederken, Robin'i götürdüler!
Dialogue: 50,0:04:55.78,0:05:00.82,Main-207+,,0,0,0,,Robin bizim için ölecek!
Dialogue: 50,0:05:11.00,0:05:17.21,Main-207+,,0,0,0,,Bizi Hükümet'ten korumak için kendini feda etti!
Dialogue: 50,0:05:18.01,0:05:21.22,Flashbacks-207+,,0,0,0,,Gidecek veya dönecek bir yerim yok.
Dialogue: 50,0:05:21.59,0:05:23.47,Flashbacks-207+,,0,0,0,,Hayır, bitti artık.
Dialogue: 50,0:05:23.47,0:05:25.35,Flashbacks-207+,,0,0,0,,Birbirimizi bir daha görmeyeceğiz.
Dialogue: 50,0:05:26.93,0:05:30.81,Main-207+,,0,0,0,,Tutuklanmanın ölmek demek olduğunu biliyordu!
Dialogue: 50,0:05:34.06,0:05:37.73,Main-207+,,0,0,0,,O zaman Robin,...
Dialogue: 50,0:05:38.61,0:05:40.74,Main-207+,,0,0,0,,...gerçekten yalan söylüyormuş!
Dialogue: 50,0:05:43.53,0:05:44.45,Main-207+,,0,0,0,,Evet.
Dialogue: 50,0:05:46.28,0:05:48.08,Main-207+,,0,0,0,,Hele şükür!
Dialogue: 50,0:05:52.46,0:05:53.92,Main-207+,,0,0,0,,Endişelenme!
Dialogue: 50,0:05:55.38,0:05:57.71,Main-207+,,0,0,0,,Robin'in ölmesine izin vermeyeceğim!
Dialogue: 50,0:05:58.09,0:05:59.59,Main-207+,,0,0,0,,Dalgaya bakın!
Dialogue: 50,0:05:59.59,0:06:02.68,Main-207+,,0,0,0,,Kahretsin, gerçekten normalin\Nbirkaç katı büyüklüğünde!
Dialogue: 50,0:06:03.05,0:06:05.47,Main-207+,,0,0,0,,Hey, kızın başı dertte!
Dialogue: 50,0:06:05.47,0:06:08.72,Main-207+,,0,0,0,,Korsan kız, vazgeç ve kaç!
Dialogue: 50,0:06:08.72,0:06:10.02,Main-207+,,0,0,0,,Rengeyiği!
Dialogue: 50,0:06:14.27,0:06:15.31,Main-207+,,0,0,0,,Parçalanıyorum!
Dialogue: 50,0:06:15.31,0:06:16.81,Main-207+,,0,0,0,,Seni çıkaramıyorum!
Dialogue: 50,0:06:16.81,0:06:18.98,Main-207+,,0,0,0,,Oraya nasıl girdin, Zoro?
Dialogue: 50,0:06:18.98,0:06:20.32,Main-207+,,0,0,0,,Çekiştirmeyi bırak!
Dialogue: 50,0:06:29.12,0:06:32.54,Main-207+,,0,0,0,,Bir şey yapmamız lazım! \NDalga neredeyse geldi!
Dialogue: 50,0:06:33.33,0:06:35.21,Main-207+,,0,0,0,,Bir şey yapmak mı?
Dialogue: 50,0:06:36.29,0:06:38.21,Main-207+,,0,0,0,,Sen... dur biraz!
Dialogue: 50,0:06:38.21,0:06:41.09,Main-207+,,0,0,0,,Yoksa Kitetsu'm sende mi?
Dialogue: 50,0:06:41.09,0:06:42.97,Main-207+,,0,0,0,,Ha? Kılıcın mı?
Dialogue: 50,0:06:42.97,0:06:44.34,Main-207+,,0,0,0,,Evet, bende.
Dialogue: 50,0:06:44.34,0:06:45.59,Main-207+,,0,0,0,,Nasıl bildin?
Dialogue: 50,0:06:45.59,0:06:49.43,Main-207+,,0,0,0,,Onu hissedebiliyorum.\NLanetli bir kılıç.
Dialogue: 50,0:06:49.97,0:06:51.72,Main-207+,,0,0,0,,Benim için mi sakladın, Chopper?
Dialogue: 50,0:06:51.72,0:06:52.52,Main-207+,,0,0,0,,Sağol.
Dialogue: 50,0:06:52.52,0:06:55.06,Main-207+,,0,0,0,,Kılıcı elime ver! Çabuk!
Dialogue: 50,0:06:55.85,0:06:56.85,Main-207+,,0,0,0,,Çıkın oradan!
Dialogue: 50,0:06:56.85,0:07:00.11,Main-207+,,0,0,0,,Yüksek yere çıkın! \NÇıkabildiğiniz kadar yükseğe!
Dialogue: 50,0:07:00.94,0:07:02.78,Main-207+,,0,0,0,,Çok geç! Başaramayacaklar!
Dialogue: 50,0:07:02.78,0:07:05.74,Main-207+,,0,0,0,,Deniz onları yutacak!
Dialogue: 50,0:07:10.66,0:07:13.70,Main-207+,,0,0,0,,Bu Aqua Laguna!
Dialogue: 50,0:07:26.30,0:07:27.84,Main-207+,,0,0,0,,Bu da ne böyle?!
Dialogue: 50,0:07:34.93,0:07:36.27,Main-207+,,0,0,0,,Çok geç!
Dialogue: 50,0:08:01.50,0:08:05.05,Main-207+,,0,0,0,,O da ne?!\NBinaları yıktı!
Dialogue: 50,0:08:15.81,0:08:17.10,Main-207+,,0,0,0,,Zoro!
Dialogue: 50,0:08:17.10,0:08:19.31,Main-207+,,0,0,0,,Geri çekil, Chopper!
Dialogue: 50,0:08:19.31,0:08:20.81,Main-207+,,0,0,0,,{\fad(150,150)}Ittoryu:
Dialogue: 50,0:08:19.31,0:08:20.81,Attack,,0,0,0,,{\fad(150,150)}Tek Kılıç Stili:
Dialogue: 50,0:08:20.81,0:08:23.98,Main-207+,,0,0,0,,{\fad(150,150)}Sanjuuroku Pondo Hou!
Dialogue: 50,0:08:20.81,0:08:23.98,Attack,,0,0,0,,{\fad(150,150)}36 Pound'luk Top!
Dialogue: 50,0:08:31.78,0:08:33.91,Main-207+,,0,0,0,,Bu adamlar neyin nesi böyle?!
Dialogue: 50,0:08:35.12,0:08:37.33,Main-207+,,0,0,0,,Gidiyoruz, Nami!
Dialogue: 50,0:08:41.38,0:08:43.00,Main-207+,,0,0,0,,O da ne?!
Dialogue: 50,0:08:43.00,0:08:45.34,Main-207+,,0,0,0,,{\fad(150,150)}Rumble! Jumping Point!
Dialogue: 50,0:08:43.00,0:08:45.34,Attack,,0,0,0,,{\fad(150,150)}Gümbürtü: Zıplama Noktası
Dialogue: 50,0:08:46.76,0:08:47.67,Main-207+,,0,0,0,,Tutun, Zoro!
Dialogue: 50,0:08:57.35,0:08:58.64,Main-207+,,0,0,0,,Arka sokak bölgesi...
Dialogue: 50,0:09:02.48,0:09:03.19,Main-207+,,0,0,0,,Kahretsin!
Dialogue: 50,0:09:15.37,0:09:16.33,Main-207+,,0,0,0,,Hey!
Dialogue: 50,0:09:16.33,0:09:17.29,Main-207+,,0,0,0,,Bakın!
Dialogue: 50,0:09:17.29,0:09:18.91,Main-207+,,0,0,0,,Bunlar onlar!
Dialogue: 50,0:09:34.18,0:09:37.22,Main-207+,,0,0,0,,Vay, başardılar!
Dialogue: 50,0:09:38.39,0:09:40.31,Main-207+,,0,0,0,,Köprüde güvende olurlar.
Dialogue: 50,0:09:40.31,0:09:42.77,Main-207+,,0,0,0,,Dalga onlara ulaşamayacak gibi.
Dialogue: 50,0:09:42.77,0:09:44.36,Main-207+,,0,0,0,,İnanılmazdı çocuklar!
Dialogue: 50,0:09:44.36,0:09:45.82,Main-207+,,0,0,0,,İyi iş!
Dialogue: 50,0:10:03.58,0:10:05.04,Main-207+,,0,0,0,,Buraya kadar yetişti!
Dialogue: 50,0:10:05.04,0:10:06.75,Main-207+,,0,0,0,,Hasır Şapkalar nerede?!
Dialogue: 50,0:10:06.75,0:10:08.63,Main-207+,,0,0,0,,Aqua Laguna onları dibe mi sürükledi?!
Dialogue: 50,0:10:14.80,0:10:16.35,Main-207+,,0,0,0,,Hayır, bakın!
Dialogue: 50,0:10:20.14,0:10:21.68,Main-207+,,0,0,0,,Paulie-san!
Dialogue: 50,0:10:28.27,0:10:29.32,Main-207+,,0,0,0,,Kahretsin!
Dialogue: 50,0:10:50.25,0:10:51.84,Main-207+,,0,0,0,,Henüz bitmedi! Koşun!
Dialogue: 50,0:10:51.84,0:10:54.05,Main-207+,,0,0,0,,Tersane Adası'na koşun!
Dialogue: 50,0:10:56.09,0:10:57.60,Main-207+,,0,0,0,,Acele edin!
Dialogue: 50,0:10:57.60,0:10:59.39,Main-207+,,0,0,0,,Köprü çöküyor!
Dialogue: 50,0:11:30.88,0:11:32.76,Main-207+,,0,0,0,,Ne dalga ama...
Dialogue: 50,0:11:33.67,0:11:37.01,Main-207+,,0,0,0,,Anlaşılamaz bir şey. \NTersane Adası'ndayız.
Dialogue: 50,0:11:37.51,0:11:39.60,Main-207+,,0,0,0,,Burada bile kendimi güvende hissetmiyorum.
Dialogue: 50,0:11:39.93,0:11:42.47,Main-207+,,0,0,0,,Bakın, gelgit hala geri çekiliyor.
Dialogue: 50,0:11:43.10,0:11:48.35,Main-207+,,0,0,0,,Elbette. Henüz bitmedi. \Nİkinci ve üçüncü dalgalar hala geliyor.
Dialogue: 50,0:11:48.35,0:11:50.31,Main-207+,,0,0,0,,Birincisi gibiyse,...
Dialogue: 50,0:11:50.31,0:11:53.23,Main-207+,,0,0,0,,...daha yüksek yerlere çıkmalıyız!
Dialogue: 50,0:12:00.45,0:12:02.91,Main-207+,,0,0,0,,Cidden çok gözü karasınız.
Dialogue: 50,0:12:02.91,0:12:06.25,Main-207+,,0,0,0,,Sağolasın. \NHayatımızı kurtardın, halat adam.
Dialogue: 50,0:12:06.75,0:12:08.08,Main-207+,,0,0,0,,İnanamıyorum.
Dialogue: 50,0:12:08.08,0:12:09.67,Main-207+,,0,0,0,,Demek bu Aqua Laguna.
Dialogue: 50,0:12:10.04,0:12:11.92,Main-207+,,0,0,0,,Titrememe engel olamıyorum.
Dialogue: 50,0:12:13.42,0:12:18.13,Main-207+,,0,0,0,,Dalgalar her sene bu kadar büyük olsaydı,\Nbu ada uzun zaman önce mahvolurdu.
Dialogue: 50,0:12:18.51,0:12:20.14,Main-207+,,0,0,0,,Bu yıl istisna bir durum.
Dialogue: 50,0:12:20.14,0:12:22.89,Main-207+,,0,0,0,,Beni gerçekten etkilediniz.
Dialogue: 50,0:12:22.89,0:12:25.31,Main-207+,,0,0,0,,Bundan sağ çıktığınıza inanamıyorum.
Dialogue: 50,0:12:26.23,0:12:27.94,Main-207+,,0,0,0,,Canavar nine!
Dialogue: 50,0:12:27.94,0:12:29.81,Main-207+,,0,0,0,,Sen de mi adadaydın?
Dialogue: 50,0:12:29.81,0:12:31.19,Main-207+,,0,0,0,,Elbette öyleyim.
Dialogue: 50,0:12:31.19,0:12:35.61,Main-207+,,0,0,0,,Denizde olsaydım, \Nşimdiye yüzen ceset olurdum.
Dialogue: 50,0:12:36.94,0:12:38.61,Main-207+,,0,0,0,,Korsan abi!
Dialogue: 50,0:12:38.61,0:12:41.45,Main-207+,,0,0,0,,Harikaydın! \NAdeta bir patlama gibiydin!
Dialogue: 50,0:12:42.95,0:12:43.95,Main-207+,,0,0,0,,Evet, biraz öyleydim.
Dialogue: 50,0:12:46.66,0:12:48.33,Main-207+,,0,0,0,,Neredeyse boğuluyordum!
Dialogue: 50,0:12:49.54,0:12:53.84,Main-207+,,0,0,0,,Seni sersem! Bana sıkıca\Nyapışmışken kendinden geçmiş!
Dialogue: 50,0:12:55.55,0:12:56.34,Main-207+,,0,0,0,,Dur biraz.
Dialogue: 50,0:12:56.34,0:12:59.93,Main-207+,,0,0,0,,Sahi, Zoro. \NNiye dalgadan kaçıyordun?
Dialogue: 50,0:12:59.93,0:13:01.39,Main-207+,,0,0,0,,Sen de mi aşağıdaydın?
Dialogue: 50,0:13:01.39,0:13:04.14,Main-207+,,0,0,0,,Ha? H-Hayır... Hiç de bile.
Dialogue: 50,0:13:04.14,0:13:05.89,Main-207+,,0,0,0,,Bacaya sıkışmıştı.
Dialogue: 50,0:13:09.77,0:13:12.35,Main-207+,,0,0,0,,Bacaya mı sıkıştı?
Dialogue: 50,0:13:14.40,0:13:16.40,Main-207+,,0,0,0,,Zoro tam bir aptal!
Dialogue: 50,0:13:16.40,0:13:18.65,Main-207+,,0,0,0,,Nasıl kendini bacaya-
Dialogue: 50,0:13:18.65,0:13:21.16,Main-207+,,0,0,0,,Bunu söylemesi gereken sen misin?!
Dialogue: 50,0:13:21.16,0:13:22.61,Main-207+,,0,0,0,,İkiniz de sersemsiniz!
Dialogue: 50,0:13:23.53,0:13:25.37,Main-207+,,0,0,0,,Demek Sanji ve Uso-
Dialogue: 50,0:13:25.37,0:13:26.24,Main-207+,,0,0,0,,Sanji nerede?
Dialogue: 50,0:13:28.16,0:13:29.33,Main-207+,,0,0,0,,Ah, sahi.
Dialogue: 50,0:13:29.33,0:13:32.29,Main-207+,,0,0,0,,Size anlatacak çok şeyim var.\NSen de dinle, Zoro.
Dialogue: 50,0:13:40.01,0:13:42.59,Main-207+,,0,0,0,,Elime büyük bir fırsat geçti.
Dialogue: 50,0:13:43.59,0:13:46.35,Main-207+,,0,0,0,,Acil durum Yıkım Çağrısı'nı emredersem,...
Dialogue: 50,0:13:46.35,0:13:50.89,Main-207+,,0,0,0,,...beş koramiral ve on savaş gemisi gelecek.
Dialogue: 50,0:13:50.89,0:13:57.65,Main-207+,,0,0,0,,Hepsi, Aokiji'nin CP9'a verdiği izin sayesinde.
Dialogue: 50,0:13:58.98,0:14:01.95,Main-207+,,0,0,0,,Öyle değil mi, Funkfreed?
Dialogue: 50,0:14:04.53,0:14:07.70,Main-207+,,0,0,0,,Dünya Hükümeti, Nico Robin'i kovalayarak...
Dialogue: 50,0:14:07.70,0:14:12.75,Main-207+,,0,0,0,,...yirmi yılını harcadı ve şimdi \NCP9'un kapısından teslim ediliyor.
Dialogue: 50,0:14:12.75,0:14:19.42,Main-207+,,0,0,0,,Bu arada, Pluton'un planlarının koruyucusu\NTom'un çırağı Cutty Flam da yolda.
Dialogue: 50,0:14:20.01,0:14:26.39,Main-207+,,0,0,0,,{\q2}Dünya büyük olabilir ama antik silahı gün yüzüne \Nçıkarmanın anahtarını elinde tutan iki kişi,...
Dialogue: 50,0:14:26.80,0:14:31.52,Main-207+,,0,0,0,,...deniz treniyle buraya geliyor.
Dialogue: 50,0:14:32.35,0:14:36.56,Main-207+,,0,0,0,,Yakında dünyayı yok etmeye yetecek\Nkadar büyük bir güce sahip olacağım.
Dialogue: 50,0:14:45.28,0:14:47.70,Main-207+,,0,0,0,,Düşünecek bir şey yok.
Dialogue: 50,0:14:48.41,0:14:50.41,Main-207+,,0,0,0,,Yola çıkacağız ve peşlerinden gideceğiz!
Dialogue: 50,0:14:51.50,0:14:53.33,Main-207+,,0,0,0,,Yapmamız gereken bu.
Dialogue: 50,0:14:59.42,0:15:01.88,Main-207+,,0,0,0,,Hey! Halat adam!
Dialogue: 50,0:15:02.46,0:15:03.67,Main-207+,,0,0,0,,Bize bir gemi getir!
Dialogue: 50,0:15:03.67,0:15:07.39,Main-207+,,0,0,0,,Hayır, bir gemi yerine... başka bir\Ndeniz treni kalkışı daha olacak mı?
Dialogue: 50,0:15:07.76,0:15:12.02,Main-207+,,0,0,0,,Bu dünyadaki tek deniz treni, Üfleyen Tom.
Dialogue: 50,0:15:12.02,0:15:14.94,Main-207+,,0,0,0,,Efsanevi gemi marangozu ekibinin,...
Dialogue: 50,0:15:14.94,0:15:18.65,Main-207+,,0,0,0,,...hayatlarını riske atarak tamamladıkları efsanevi bir gemi!
Dialogue: 50,0:15:20.44,0:15:22.32,Main-207+,,0,0,0,,O zaman bize bir gemi ödünç ver!
Dialogue: 50,0:15:22.32,0:15:24.82,Main-207+,,0,0,0,,Bu şehrin en güçlü ve en hızlı gemisini!
Dialogue: 50,0:15:24.82,0:15:27.07,Main-207+,,0,0,0,,Yeter artık, aptallar!
Dialogue: 50,0:15:27.82,0:15:31.12,Main-207+,,0,0,0,,Demin denizin ne yaptığına tanıklık etmediniz mi?!
Dialogue: 50,0:15:31.12,0:15:34.41,Main-207+,,0,0,0,,Neredeyse dalgalar sizi götürüyordu!
Dialogue: 50,0:15:34.41,0:15:37.88,Main-207+,,0,0,0,,Evet! Şimdi denize açılabilmeniz mümkün değil!
Dialogue: 50,0:15:37.88,0:15:38.75,Main-207+,,0,0,0,,Aptal mısınız siz?!
Dialogue: 50,0:15:38.75,0:15:43.42,Main-207+,,0,0,0,,Ortalama bir Aqua Laguna'yı\Nbile geçmiş bir gemi yok!
Dialogue: 50,0:15:43.42,0:15:45.63,Main-207+,,0,0,0,,Arka sokak bölgesinin çöküşünü gördünüz!
Dialogue: 50,0:15:46.05,0:15:49.34,Main-207+,,0,0,0,,Önceki Aqua Laguna'larda bir santim\Nbile yerinden oynamamış olan bu şehir,...
Dialogue: 50,0:15:49.89,0:15:51.51,Main-207+,,0,0,0,,...acınası durumda.
Dialogue: 50,0:15:52.14,0:15:55.77,Main-207+,,0,0,0,,Ama bu seferki farklı bir seviyede.
Dialogue: 50,0:15:55.77,0:15:59.94,Main-207+,,0,0,0,,Şimdi bir gemiyle denize açılırsanız,\Nen büyük kalyon bile olsa,...
Dialogue: 50,0:15:59.94,0:16:02.48,Main-207+,,0,0,0,,...tek bir darbeyle parçalanır.
Dialogue: 50,0:16:03.07,0:16:06.65,Main-207+,,0,0,0,,Öleceğinizi bile bile bir gemi\Nalmanıza izin vermem mümkün değil!
Dialogue: 50,0:16:07.24,0:16:08.66,Main-207+,,0,0,0,,Yarına dek bekleyin.
Dialogue: 50,0:16:10.24,0:16:12.49,Main-207+,,0,0,0,,Fırtına dinince, size gemi vereceğiz.
Dialogue: 50,0:16:13.20,0:16:16.12,Main-207+,,0,0,0,,Hey, siz. Sığınaklara falan gidin.
Dialogue: 50,0:16:16.12,0:16:18.00,Main-207+,,0,0,0,,Arama bitmiştir.
Dialogue: 50,0:16:18.58,0:16:19.67,Main-207+,,0,0,0,,Eğer...
Dialogue: 50,0:16:21.42,0:16:26.47,Main-207+,,0,0,0,,Eğer yarına dek beklersek,\Nisteğimiz gerçekleşecek mi?
Dialogue: 50,0:16:28.97,0:16:32.05,Main-207+,,0,0,0,,Enies Lobby denen yeri biliyorum.
Dialogue: 50,0:16:32.55,0:16:35.56,Main-207+,,0,0,0,,Hükümet adası olduğunu duyunca hatırladım.
Dialogue: 50,0:16:35.56,0:16:36.56,Main-207+,,0,0,0,,Orası...
Dialogue: 50,0:16:36.89,0:16:40.06,Main-207+,,0,0,0,,Orası Adalet Kapısı'nın olduğu yer değil mi?
Dialogue: 50,0:16:41.15,0:16:42.81,Main-207+,,0,0,0,,O da ne?
Dialogue: 50,0:16:43.15,0:16:47.15,Main-207+,,0,0,0,,Hükümet'in sahip olduğu adli bir ada, Enies Lobby.
Dialogue: 50,0:16:47.74,0:16:50.16,Main-207+,,0,0,0,,Bu sadece adalet sarayının ismi.
Dialogue: 50,0:16:50.78,0:16:55.04,Main-207+,,0,0,0,,Sadece Enies Lobby'ye transfer\Nedilmek bile, bir suçlunun mahkûmiyetidir.
Dialogue: 50,0:16:55.04,0:16:59.41,Main-207+,,0,0,0,,Suçlular boş bir adalet sarayından geçer...
Dialogue: 50,0:16:59.41,0:17:03.50,Main-207+,,0,0,0,,...ve nihayet büyük, \Nsoğuk bir çelik kapının önüne gelir.
Dialogue: 50,0:17:05.88,0:17:08.92,Main-207+,,0,0,0,,O kapıya Adalet Kapısı denir.
Dialogue: 50,0:17:09.47,0:17:11.39,Main-207+,,0,0,0,,O kapıdan geçen bir suçlu,
Dialogue: 50,0:17:11.39,0:17:15.39,Main-207+,,0,0,0,,...bir daha asla gün ışığını göremez. \NBir tür umutsuzluk kapısı.
Dialogue: 50,0:17:16.01,0:17:20.35,Main-207+,,0,0,0,,Çünkü limandan ayrılır ve denize açılırsanız,...
Dialogue: 50,0:17:20.35,0:17:22.81,Main-207+,,0,0,0,,...ulaşabileceğiniz iki yer var.
Dialogue: 50,0:17:24.19,0:17:28.86,Main-207+,,0,0,0,,Birincisi, dünyanın en büyük\Notoritesi ve adalet gücü.
Dialogue: 50,0:17:28.86,0:17:30.11,Main-207+,,0,0,0,,Denizci Karargâhı.
Dialogue: 50,0:17:31.57,0:17:35.16,Main-207+,,0,0,0,,İkincisinde ise, \Nişkence odaları ve idam sehpaları var.
Dialogue: 50,0:17:35.16,0:17:39.37,Main-207+,,0,0,0,,Dünyanın her yerini kasıp kavuran\Nazılı tutsaklar burada tutulur.
Dialogue: 50,0:17:39.37,0:17:42.79,Main-207+,,0,0,0,,Denizin derinliklerinde yatan\Nbüyük hapisane, Impel Down.
Dialogue: 50,0:17:43.83,0:17:45.29,Main-207+,,0,0,0,,Kısaca,...
Dialogue: 50,0:17:45.29,0:17:49.42,Main-207+,,0,0,0,,...Enies Lobby suçlulara merhamet etmez.
Dialogue: 50,0:17:49.42,0:17:52.93,Main-207+,,0,0,0,,Suçluların merhamet umudu olmaksızın mahkum edildiği yer.
Dialogue: 50,0:17:52.93,0:17:54.34,Main-207+,,0,0,0,,Değil mi?!
Dialogue: 50,0:17:55.64,0:17:57.76,Main-207+,,0,0,0,,Başında Robin gibi ödül olan biri,...
Dialogue: 50,0:17:57.76,0:18:00.48,Main-207+,,0,0,0,,...nereye götürülürse götürülsün cehennem gibi olacak.
Dialogue: 50,0:18:00.85,0:18:05.36,Main-207+,,0,0,0,,Şimdi bile Robin, \Nher saat Adalet Kapısı'na yaklaşıyor.
Dialogue: 50,0:18:05.73,0:18:08.32,Main-207+,,0,0,0,,Yarına kadar beklememiz mümkün değil!
Dialogue: 50,0:18:11.19,0:18:14.16,Main-207+,,0,0,0,,Çok şey biliyor gibisin ama bırak da ekleme yapayım.
Dialogue: 50,0:18:14.91,0:18:18.29,Main-207+,,0,0,0,,Deniz, gemiyle yola çıkacak\Nkadar sakinleşse bile,...
Dialogue: 50,0:18:18.74,0:18:21.16,Main-207+,,0,0,0,,...orası gidebileceğiniz bir yer değil.
Dialogue: 50,0:18:21.16,0:18:25.08,Main-207+,,0,0,0,,Kendinizin de korsan olduğunu unutmayın!
Dialogue: 50,0:18:25.58,0:18:30.71,Main-207+,,0,0,0,,Dediğin gibi Enies Lobby, Dünya Hükümeti'nin merkezine bağlanan bir giriş.
Dialogue: 50,0:18:30.71,0:18:34.01,Main-207+,,0,0,0,,Elbette orayı koruyan devasa bir düşman hattı var.
Dialogue: 50,0:18:34.59,0:18:40.18,Main-207+,,0,0,0,,Bir kere o adaya götürüldüyse, hiçbir korsan, \Narkadaşını geri almayı hayal edemez.
Dialogue: 50,0:18:40.18,0:18:42.52,Main-207+,,0,0,0,,Çünkü kendilerine ne olacağını bilirler.
Dialogue: 50,0:18:43.06,0:18:48.48,Main-207+,,0,0,0,,Dünya Hükümeti'nin merkezinde\Ndövüşmeyi mi planlıyorsunuz?!
Dialogue: 50,0:18:51.90,0:18:54.78,Main-207+,,0,0,0,,E-Evet, bunu yapmayın!
Dialogue: 50,0:18:54.78,0:18:56.95,Main-207+,,0,0,0,,Aqua Laguna nedeniyle sabah\Nolmadan denize açılamazsınız!
Dialogue: 50,0:18:56.95,0:18:58.91,Main-207+,,0,0,0,,Peşlerine düşerseniz öldürüleceksiniz!
Dialogue: 50,0:18:58.91,0:19:01.95,Main-207+,,0,0,0,,Kurtulma şansınız sıfır!
Dialogue: 50,0:19:01.95,0:19:02.87,Main-207+,,0,0,0,,Luffy...
Dialogue: 50,0:19:04.83,0:19:06.38,Main-207+,,0,0,0,,O zaman...
Dialogue: 50,0:19:06.38,0:19:08.17,Main-207+,,0,0,0,,...bir gemi çalacağız!
Dialogue: 50,0:19:09.59,0:19:12.30,Main-207+,,0,0,0,,Denize şimdi açılıyoruz!
Dialogue: 50,0:19:16.09,0:19:17.89,Main-207+,,0,0,0,,Arkadaşımız bekliyor!
Dialogue: 50,0:19:17.89,0:19:21.14,Main-207+,,0,0,0,,Karışmayın!
Dialogue: 50,0:19:24.69,0:19:27.52,Main-207+,,0,0,0,,D-Dalgalar da kızdı!
Dialogue: 50,0:19:30.65,0:19:32.40,Main-207+,,0,0,0,,– Ne...?\N– Dövüşecek mi?
Dialogue: 50,0:19:32.40,0:19:33.86,Main-207+,,0,0,0,,Ödümü koparttı.
Dialogue: 50,0:19:35.36,0:19:38.20,Main-207+,,0,0,0,,Tamam, rakibin olacağım!
Dialogue: 50,0:19:45.50,0:19:47.87,Main-207+,,0,0,0,,Durun çocuklar!
Dialogue: 50,0:19:50.63,0:19:51.92,Main-207+,,0,0,0,,Kokoro-san!
Dialogue: 50,0:19:51.92,0:19:54.72,Main-207+,,0,0,0,,Hatalı olan sensin, Hasır Şapka.
Dialogue: 50,0:19:55.80,0:19:58.47,Main-207+,,0,0,0,,Paulie haklı, sersem.
Dialogue: 50,0:19:58.47,0:20:00.89,Main-207+,,0,0,0,,Kapa çeneni! Seni ilgilendir-
Dialogue: 50,0:20:00.89,0:20:03.60,Main-207+,,0,0,0,,Beni ilgilendirmez, evet.
Dialogue: 50,0:20:03.60,0:20:05.10,Main-207+,,0,0,0,,İyi, dinle bakalım.
Dialogue: 50,0:20:05.10,0:20:08.40,Main-207+,,0,0,0,,Cidden sizi görmezden gelirsek, öleceksiniz.
Dialogue: 50,0:20:08.77,0:20:10.02,Main-207+,,0,0,0,,Dinleyin.
Dialogue: 50,0:20:10.02,0:20:14.78,Main-207+,,0,0,0,,Eğer Aqua Laguna'yı\Ndelip geçecek bir gemi varsa,...
Dialogue: 50,0:20:14.78,0:20:18.45,Main-207+,,0,0,0,,...o da efsanevi adamın yaptığı deniz trenidir.
Dialogue: 50,0:20:18.78,0:20:21.66,Main-207+,,0,0,0,,Ama burada değil,...
Dialogue: 50,0:20:21.66,0:20:23.74,Main-207+,,0,0,0,,...bu yüzden gemiyle gitmeye çalışıyoruz!
Dialogue: 50,0:20:25.75,0:20:28.50,Main-207+,,0,0,0,,Ölmeye hazırsanız...
Dialogue: 50,0:20:29.00,0:20:30.13,Main-207+,,0,0,0,,...peşimden gelin.
Dialogue: 50,0:20:30.50,0:20:32.09,Main-207+,,0,0,0,,Size...
Dialogue: 50,0:20:32.09,0:20:33.92,Main-207+,,0,0,0,,...deniz treni vereceğim!
Dialogue: 50,0:20:59.61,0:21:01.57,Main-207+,,0,0,0,,Aptallar! Ne yapıyorsunuz?!
Dialogue: 50,0:21:01.57,0:21:04.45,Main-207+,,0,0,0,,Suçlular dışındaki herkes üniformalı!
Dialogue: 50,0:21:09.50,0:21:11.08,Main-207+,,0,0,0,,Saldırın!
Dialogue: 50,0:21:11.50,0:21:14.04,Main-207+,,0,0,0,,İşler yine bu noktaya geldi.
Dialogue: 50,0:21:24.22,0:21:27.22,Main-207+,,0,0,0,,İyi bir plan olduğunu düşünmüştüm.
Dialogue: 50,0:21:27.22,0:21:29.31,Main-207+,,0,0,0,,"Arkana Bakmadan Geç" taktiği.
Dialogue: 50,0:21:32.44,0:21:34.40,Main-207+,,0,0,0,,Ne?! Sanji?!
Dialogue: 50,0:21:34.40,0:21:35.61,Main-207+,,0,0,0,,– Dur!\N– Dur!
Dialogue: 50,0:21:39.49,0:21:41.53,Main-207+,,0,0,0,,Daha ileri gitmene izin vermeyeceğiz.
Dialogue: 50,0:21:42.45,0:21:43.87,Main-207+,,0,0,0,,İkizler mi?
Dialogue: 50,0:21:50.21,0:21:51.67,Main-207+,,0,0,0,,{\fad(150,150)}Collier...
Dialogue: 50,0:21:50.21,0:21:51.67,Attack,,0,0,0,,{\fad(150,150)}Boyun...
Dialogue: 50,0:21:53.63,0:21:55.34,Main-207+,,0,0,0,,{\fad(150,150)}Frite!
Dialogue: 50,0:21:53.63,0:21:55.34,Attack,,0,0,0,,{\fad(150,150)}Patates Kızartması
Dialogue: 50,0:22:02.93,0:22:06.85,Main-207+,,0,0,0,,Sanji, deniz treninde ne yapıyorsun?
Dialogue: 50,0:22:07.39,0:22:09.60,Main-207+,,0,0,0,,Aynı soruyu ben de sana sorabilirim.
Dialogue: 50,0:22:15.86,0:22:17.27,Main-207+,,0,0,0,,Sen, şey...
Dialogue: 50,0:22:17.27,0:22:19.61,Main-207+,,0,0,0,,...adını bilmiyorum. Oradaki.
Dialogue: 50,0:22:19.61,0:22:22.57,Main-207+,,0,0,0,,Saçmalamayı kes, pislik!
Dialogue: 50,0:22:25.95,0:22:28.20,Main-207+,,0,0,0,,İşte! Den Den Mushi!
Dialogue: 50,0:22:28.20,0:22:29.83,Main-207+,,0,0,0,,Harika.
Dialogue: 50,0:22:29.83,0:22:32.16,Main-207+,,0,0,0,,Vay, hem de bir sürü var.
Dialogue: 50,0:22:32.16,0:22:33.96,Main-207+,,0,0,0,,İletişim odaları da mı var?
Dialogue: 50,0:22:35.21,0:22:40.42,Main-207+,,0,0,0,,Deminki vagondaki memurların maskeleri,\Nkostümleri ve diğer değersiz şeyleri vardı.
Dialogue: 50,0:22:40.88,0:22:43.59,Main-207+,,0,0,0,,Nihayet Nami-san'ı arayabileceğim.
Dialogue: 50,0:22:43.59,0:22:47.10,Main-207+,,0,0,0,,Yani kısaca, siz aynı tayfadan mısınız?
Dialogue: 50,0:22:47.10,0:22:48.56,Main-207+,,0,0,0,,– Eskiden!\N– Eskiden!
Dialogue: 50,0:22:48.56,0:22:50.06,Main-207+,,0,0,0,,Sen de kimsin?
Dialogue: 50,0:22:50.06,0:22:55.44,Main-207+,,0,0,0,,Ben Water Seven'ın yeraltı yüzüyüm. Hurdacı Franky.
Dialogue: 50,0:22:56.98,0:22:59.98,Main-207+,,0,0,0,,Yani sen Franky misin, pis herif?!
Dialogue: 50,0:22:59.98,0:23:02.94,Main-207+,,0,0,0,,Uzun Burun'umuzun başına büyük dertler açmışsın!
Dialogue: 50,0:23:02.94,0:23:05.57,Main-207+,,0,0,0,,Kaç parçaya bölünmek istiyorsun, şerefsiz?!
Dialogue: 50,0:23:05.57,0:23:07.20,Main-207+,,0,0,0,,
Dialogue: 50,0:23:07.20,0:23:10.58,Main-207+,,0,0,0,,D-D-Dur Sanji! \NO zamandan beri çok şey oldu!
Dialogue: 50,0:23:10.58,0:23:13.75,Main-207+,,0,0,0,,Lanet olası! Şu iplerden\Nkurtulana dek bekle bakalım!
Dialogue: 50,0:23:13.75,0:23:16.00,Main-207+,,0,0,0,,Böyle şeyler söylemeyi kes artık!
Dialogue: 50,0:23:16.50,0:23:20.46,Main-207+,,0,0,0,,Ah... şey... Merry'yi bir kere kurtardı.
Dialogue: 50,0:23:21.71,0:23:23.21,Main-207+,,0,0,0,,Evet.
Dialogue: 50,0:23:24.09,0:23:26.38,Main-207+,,0,0,0,,Merry...
Dialogue: 50,0:23:27.76,0:23:31.39,Main-207+,,0,0,0,,H-Hey! Üzülecek zaman değil!
Dialogue: 50,0:23:31.39,0:23:35.60,Main-207+,,0,0,0,,Sana yalvarıyorum, kardeşim! \NLütfen çöz beni!
Dialogue: 50,0:23:35.60,0:23:39.40,Main-207+,,0,0,0,,Seni kim çözer ki?! Senin gibi bir haydut sonsuza kadar böyle kalmalı!
Dialogue: 50,0:23:39.40,0:23:43.49,Main-207+,,0,0,0,,Seni pislik! Kibarca sordum ve \Nbu şekilde mi cevap veriyorsun?!
Dialogue: 50,0:23:43.49,0:23:46.11,Main-207+,,0,0,0,,Kesin şunu, lanet olsun! Hey!
Dialogue: 50,0:23:46.11,0:23:49.95,Main-207+,,0,0,0,,Oyalanırsak farkedileceğiz!
Dialogue: 50,0:23:49.95,0:23:51.45,Main-207+,,0,0,0,,Kapa çeneni, lanet olası!
Dialogue: 50,0:23:51.45,0:23:52.58,Main-207+,,0,0,0,,Ne?!
Dialogue: 50,0:23:52.58,0:23:54.08,Main-207+,,0,0,0,,İkiniz de sessiz olun!
Dialogue: 50,0:23:54.08,0:23:55.91,Main-207+,,0,0,0,,O zaman çöz beni artık!
Dialogue: 50,0:24:01.80,0:24:03.00,Main-207+,,0,0,0,,Kaptan T-Bone...
Dialogue: 50,0:24:08.43,0:24:11.64,Main-207+,,0,0,0,,Bu depo sekiz yıldan uzun bir süredir terk edilmiş durumdadır.
Dialogue: 50,0:24:12.22,0:24:16.23,Main-207+,,0,0,0,,{\an8}Deniz treni geldiğinden beri 12 yıldır kullanılmadı.
Dialogue: 50,0:24:16.23,0:24:17.48,Main-207+,,0,0,0,,Gidelim, Chopper!
Dialogue: 50,0:24:17.48,0:24:18.56,Main-207+,,0,0,0,,
Dialogue: 50,0:24:18.56,0:24:20.69,Main-207+,,0,0,0,,Ama artık çalışmayabilir.
Dialogue: 50,0:24:21.82,0:24:23.73,Main-207+,,0,0,0,,Hey! Bu hayal kırıklığı olurdu!
Dialogue: 50,0:24:27.99,0:24:30.37,Main-207+,,0,0,0,,Hey, hey! Durun!
Dialogue: 50,0:24:30.37,0:24:35.08,Main-207+,,0,0,0,,O kadar aceleci olmayın.\NAnahtarınız olmadan giremezsiniz.
Dialogue: 50,0:24:36.25,0:24:38.67,Main-207+,,0,0,0,,Ne? Kapı açık mı?
Dialogue: 50,0:24:43.92,0:24:45.17,Main-207+,,0,0,0,,İşte!
Dialogue: 50,0:24:45.80,0:24:48.17,Main-207+,,0,0,0,,Çok güzel!
Dialogue: 50,0:24:48.17,0:24:50.51,Main-207+,,0,0,0,,Müthiş!
Dialogue: 50,0:24:51.64,0:24:55.60,Main-207+,,0,0,0,,En iyi şey olmadığını söylediğimi unutmayın.
Dialogue: 50,0:24:55.60,0:24:58.31,Main-207+,,0,0,0,,Onun adı "Roket Adam".
Dialogue: 50,0:24:58.31,0:25:01.81,Main-207+,,0,0,0,,Yolcuları taşıyamayan bir araç.
Dialogue: 50,0:25:01.81,0:25:03.19,Main-207+,,0,0,0,,Roket Adam!
Dialogue: 50,0:25:03.19,0:25:04.77,Main-207+,,0,0,0,,Hızlı görünüyor!
Dialogue: 50,0:25:04.77,0:25:06.11,Main-207+,,0,0,0,,Müthiş!
Dialogue: 50,0:25:06.78,0:25:09.15,Main-207+,,0,0,0,,O surat da ne öyle?
Dialogue: 50,0:25:09.15,0:25:12.37,Main-207+,,0,0,0,,Köpekbalığı kafası sadece eğlence amaçlı.
Dialogue: 50,0:25:15.08,0:25:16.66,Main-207+,,0,0,0,,Buz amca.
Dialogue: 50,0:25:17.95,0:25:19.37,Main-207+,,0,0,0,,Hasır Şapka,...
Dialogue: 50,0:25:19.37,0:25:20.83,Main-207+,,0,0,0,,...iyi olmana sevindim.
Dialogue: 50,0:25:21.33,0:25:23.92,Main-207+,,0,0,0,,Korsan kızın dediği gibi.
Dialogue: 50,0:25:23.92,0:25:25.46,Main-207+,,0,0,0,,Sizi buraya Kokoro-san mı getirdi?
Dialogue: 50,0:25:25.46,0:25:28.67,Main-207+,,0,0,0,,Hala yaşıyor gibisin, Iceburg.
Dialogue: 50,0:25:28.67,0:25:30.80,Main-207+,,0,0,0,,Burada ne yapıyorsun?
Dialogue: 50,0:25:31.22,0:25:34.89,Main-207+,,0,0,0,,Seninle aynı sebepten ötürü buradayım.
Dialogue: 50,0:25:36.35,0:25:38.27,Main-207+,,0,0,0,,Aptalları tek başlarına bırakamayız.
Dialogue: 50,0:25:43.69,0:25:44.52,Main-207+,,0,0,0,,Kullanın.
Dialogue: 50,0:25:45.15,0:25:46.94,Main-207+,,0,0,0,,Bakımı yapıldı.
Dialogue: 50,0:25:46.94,0:25:49.94,Main-207+,,0,0,0,,Kömür ve su ekledim. \NŞu anda buhar üretiyor.
Dialogue: 50,0:25:50.95,0:25:53.57,Main-207+,,0,0,0,,Amca, onu bizim için mi hazırladın?
Dialogue: 50,0:25:55.91,0:25:58.37,Main-207+,,0,0,0,,Geri döndükten sonra kutlarsınız.
Dialogue: 50,0:25:58.37,0:26:03.50,Main-207+,,0,0,0,,Çünkü Roket Adam'ın hızı, ne kadar\Nayarlarsanız ayarlayın kontrol edilemez.
Dialogue: 50,0:26:03.50,0:26:06.59,Main-207+,,0,0,0,,Üfleyen Tom'un başarısız versiyonu.
Dialogue: 50,0:26:07.05,0:26:09.21,Main-207+,,0,0,0,,Güvenliğinizi garanti edemem.
Dialogue: 50,0:26:10.42,0:26:13.38,Main-207+,,0,0,0,,Ah! Sağol, buz amca!
Dialogue: 50,0:26:15.80,0:26:17.97,Main-207+,,0,0,0,,Tamam, gidelim!
Dialogue: 50,0:26:18.52,0:26:20.06,Main-207+,,0,0,0,,Binin çocuklar!
Dialogue: 50,0:26:20.89,0:26:23.39,Main-207+,,0,0,0,,Nine! Nami gelir gelmez çalıştır!
Dialogue: 50,0:26:23.39,0:26:24.90,Main-207+,,0,0,0,,
Dialogue: 50,0:26:27.02,0:26:29.23,Main-207+,,0,0,0,,Luffy, iyi misin?
Dialogue: 50,0:26:29.23,0:26:32.03,Main-207+,,0,0,0,,Bir süredir dengen bozuk.
Dialogue: 50,0:26:32.03,0:26:33.66,Main-207+,,0,0,0,,Muhtemelen aşırı kan kaybından.
Dialogue: 50,0:26:34.91,0:26:39.12,Main-207+,,0,0,0,,Gücüm biraz çekildi.\NBiraz et yiyebilseydim.
Dialogue: 50,0:26:39.58,0:26:40.95,Main-207+,,0,0,0,,Çabuk! Bu tarafa!
Dialogue: 50,0:26:43.58,0:26:44.58,Main-207+,,0,0,0,,Bekle!
Dialogue: 50,0:26:44.58,0:26:47.96,Main-207+,,0,0,0,,O kadar yol gitmek zorunda değilsin! \NBurada ye!
Dialogue: 50,0:26:47.96,0:26:50.13,Main-207+,,0,0,0,,Evet! Canın bir şeyler atıştırmak istiyor, değil mi?
Dialogue: 50,0:26:50.13,0:26:51.76,Main-207+,,0,0,0,,Gerçekten bu kadar şeyi\Nyiyeceğimi mi düşünüyorsunuz?!
Dialogue: 50,0:26:51.76,0:26:52.84,Main-207+,,0,0,0,,– Ne?!\N– Ne?!
Dialogue: 50,0:26:53.34,0:26:54.68,Main-207+,,0,0,0,,Üzgünüm, geciktim!
Dialogue: 50,0:26:54.68,0:26:55.51,Main-207+,,0,0,0,,Nami?
Dialogue: 50,0:26:55.51,0:26:57.89,Main-207+,,0,0,0,,Hey! Ne yapıyorsun?!
Dialogue: 50,0:26:57.89,0:26:59.68,Main-207+,,0,0,0,,Hemen bin, aptal!
Dialogue: 50,0:27:00.01,0:27:01.93,Main-207+,,0,0,0,,Vay canına, etkileyici.
Dialogue: 50,0:27:01.93,0:27:03.39,Main-207+,,0,0,0,,Bu da mı deniz treni?
Dialogue: 50,0:27:04.52,0:27:07.31,Main-207+,,0,0,0,,Burada bir tane daha olduğunu hiç düşünmemiştim.
Dialogue: 50,0:27:07.31,0:27:08.57,Main-207+,,0,0,0,,Ne süpriz ama!
Dialogue: 50,0:27:08.90,0:27:10.53,Main-207+,,0,0,0,,Neredeydin, Nami?!
Dialogue: 50,0:27:10.53,0:27:12.36,Main-207+,,0,0,0,,Vaktimiz olduğunu kim söyledi?!
Dialogue: 50,0:27:13.11,0:27:14.45,Main-207+,,0,0,0,,O kadar bagaj da ne öyle?!
Dialogue: 50,0:27:14.45,0:27:15.66,Main-207+,,0,0,0,,Et ve içecek.
Dialogue: 50,0:27:15.66,0:27:17.87,Main-207+,,0,0,0,,Şikayet ettiğim için üzgünüm!
Dialogue: 50,0:27:19.16,0:27:20.91,Main-207+,,0,0,0,,Hadi bakalım.
Dialogue: 50,0:27:20.91,0:27:26.71,Main-207+,,0,0,0,,Su yolundan raylara atlarsanız,\Nbir süreliğine bir şey olmaz.
Dialogue: 50,0:27:26.71,0:27:28.04,Main-207+,,0,0,0,,Sorun yok.
Dialogue: 50,0:27:28.04,0:27:31.17,Main-207+,,0,0,0,,Bunu kullanmada epey deneyimliyim.
Dialogue: 50,0:27:31.17,0:27:33.92,Main-207+,,0,0,0,,Sen sadece rahatına bak ve vücudunu dinlendir.
Dialogue: 50,0:27:34.38,0:27:35.38,Main-207+,,0,0,0,,Çok utanıyorum.
Dialogue: 50,0:27:35.38,0:27:38.47,Main-207+,,0,0,0,,Chimney ve Gonbe de buralarda oynuyor olur,...
Dialogue: 50,0:27:38.47,0:27:40.18,Main-207+,,0,0,0,,...onlara da göz kulak ol.
Dialogue: 50,0:27:43.10,0:27:46.48,Main-207+,,0,0,0,,Hasır Şapka!
Dialogue: 50,0:27:48.15,0:27:49.65,Main-207+,,0,0,0,,O adamlar...
Dialogue: 50,0:27:50.52,0:27:52.03,Main-207+,,0,0,0,,...Franky Ailesi!
Dialogue: 50,0:27:55.95,0:27:57.70,Main-207+,,0,0,0,,Böyle telaşlı bir zamanda.
Dialogue: 50,0:27:58.78,0:28:00.03,Main-207+,,0,0,0,,Lütfen...
Dialogue: 50,0:28:00.03,0:28:02.58,Main-207+,,0,0,0,,...bizi de götürün!
Dialogue: 50,0:28:02.58,0:28:07.00,Main-207+,,0,0,0,,Galley-La'dan, \NEnies Lobby'ye gittiğinizi duyduk!
Dialogue: 50,0:28:07.83,0:28:11.09,Main-207+,,0,0,0,,Franky abi, \NHükümet tarafından oraya götürüldü.
Dialogue: 50,0:28:11.09,0:28:12.38,Main-207+,,0,0,0,,Biz de peşinden gitmek istiyoruz.
Dialogue: 50,0:28:13.17,0:28:16.38,Main-207+,,0,0,0,,Ama Aqua Laguna'yı tek başımıza geçemeyiz!
Dialogue: 50,0:28:16.38,0:28:18.97,Main-207+,,0,0,0,,Düşman, Dünya Hükümeti.
Dialogue: 50,0:28:19.34,0:28:21.51,Main-207+,,0,0,0,,Kim olduğu umrumuzda değil!
Dialogue: 50,0:28:21.51,0:28:23.35,Main-207+,,0,0,0,,Abimizi geri alacağız!
Dialogue: 50,0:28:23.35,0:28:27.06,Main-207+,,0,0,0,,Onun için canımızı bile veririz!
Dialogue: 50,0:28:27.06,0:28:28.44,Main-207+,,0,0,0,,Lütfen!
Dialogue: 50,0:28:28.44,0:28:30.52,Main-207+,,0,0,0,,Bize yardım edin!
Dialogue: 50,0:28:30.52,0:28:32.40,Main-207+,,0,0,0,,Hasır Şapka!
Dialogue: 50,0:28:32.94,0:28:35.86,Main-207+,,0,0,0,,Lütfen! Abimiz tehlikede!
Dialogue: 50,0:28:36.24,0:28:38.11,Main-207+,,0,0,0,,Şaka yapıyor olmalısınız!
Dialogue: 50,0:28:38.11,0:28:41.45,Main-207+,,0,0,0,,Şu ana dek ne yaptığınızı biliyor musunuz?!
Dialogue: 50,0:28:47.83,0:28:49.46,Main-207+,,0,0,0,,Biliyorum!
Dialogue: 50,0:28:50.83,0:28:53.09,Main-207+,,0,0,0,,Üzerimizde bu utanç varken istiyoruz!
Dialogue: 50,0:28:54.00,0:28:56.76,Main-207+,,0,0,0,,Abimizi kurtarmak istiyoruz!
Dialogue: 50,0:29:11.02,0:29:11.98,Main-207+,,0,0,0,,Atlayın.
Dialogue: 50,0:29:12.44,0:29:13.44,Main-207+,,0,0,0,,Çabuk!
Dialogue: 50,0:29:17.99,0:29:19.95,Main-207+,,0,0,0,,Hasır Şapka...
Dialogue: 50,0:29:20.49,0:29:22.37,Main-207+,,0,0,0,,Hey, Luffy!
Dialogue: 50,0:29:23.45,0:29:24.95,Main-207+,,0,0,0,,Evet, sorun değil.
Dialogue: 50,0:29:25.49,0:29:26.91,Main-207+,,0,0,0,,Üzgünüm!
Dialogue: 50,0:29:27.91,0:29:30.12,Main-207+,,0,0,0,,Size borçluyuz!
Dialogue: 50,0:29:30.46,0:29:31.62,Main-207+,,0,0,0,,Çabuk olun!
Dialogue: 50,0:29:32.96,0:29:34.75,Main-207+,,0,0,0,,Ama hepimizin vagonda olmasına gerek yok!
Dialogue: 50,0:29:36.59,0:29:40.97,Main-207+,,0,0,0,,Sizinle buluşacağız ve denize \Nkral boğalarla atlayacağız!
Dialogue: 50,0:29:40.97,0:29:43.55,Main-207+,,0,0,0,,Vagonun arkasına bağlanabilirsek, bu bize yeter!
Dialogue: 50,0:29:44.22,0:29:45.72,Main-207+,,0,0,0,,Kral boğalar mı?
Dialogue: 50,0:29:45.72,0:29:47.27,Main-207+,,0,0,0,,Size güveniyoruz.
Dialogue: 50,0:29:47.27,0:29:48.89,Main-207+,,0,0,0,,Sonra görüşürüz!
Dialogue: 50,0:29:49.77,0:29:51.27,Main-207+,,0,0,0,,Gidelim!
Dialogue: 50,0:29:51.27,0:29:53.73,Main-207+,,0,0,0,,– Tamam!\N– Tamam!
Dialogue: 50,0:30:00.11,0:30:04.45,Main-207+,,0,0,0,,Yaşasın! \NAbimizi kurtarmaya gidebileceğiz!
Dialogue: 50,0:30:04.45,0:30:06.45,Main-207+,,0,0,0,,Çabuk!
Dialogue: 50,0:30:14.54,0:30:15.21,Main-207+,,0,0,0,,Nasıl?
Dialogue: 50,0:30:17.92,0:30:18.50,Main-207+,,0,0,0,,Tamam!
Dialogue: 50,0:30:19.13,0:30:20.51,Main-207+,,0,0,0,,Gidelim o zaman!
Dialogue: 50,0:30:58.17,0:31:00.88,Main-207+,,0,0,0,,Pekâla korsanlar.
Dialogue: 50,0:31:00.88,0:31:03.38,Main-207+,,0,0,0,,Sakın düşmeyin!
Dialogue: 50,0:31:15.35,0:31:18.86,Main-207+,,0,0,0,,Water Seven'dan Enies Lobisi'ye gitmek için...
Dialogue: 50,0:31:18.86,0:31:22.90,Main-207+,,0,0,0,,...deniz treni Roket Adam yola çıkıyor!
Dialogue: 50,0:31:26.03,0:31:29.37,Main-207+,,0,0,0,,Evet! Gidiyoruz!
Dialogue: 50,0:31:32.25,0:31:33.29,Main-207+,,0,0,0,,Her şeyi...
Dialogue: 50,0:31:34.12,0:31:38.38,Main-207+,,0,0,0,,...geri almaya gidelim!
