Dialogue: 0,0:01:50.08,0:01:53.97,Author,,0,0,0,,{\fad(600,600)}TR: onepacetr.net | kazasker
Dialogue: 0,0:15:39.85,0:15:49.85,Author,,0,0,0,,{\fad(500,0)}TR: onepacetr.net | kazasker
Dialogue: 0,0:28:30.39,0:28:33.53,Author,,0,0,0,,{\fad(0,0)}TR: onepacetr.net | kazasker
Dialogue: 0,0:01:50.08,0:01:54.17,Title,,0,0,0,,{\fad(600,600)}Su Şehri, Water Seven
Dialogue: 5,0:01:54.31,0:01:58.20,Narrator,,0,0,0,,"Going Merry, Luffy ve Robin'nin\Niyileşmesine izin vermek için,...
Dialogue: 5,0:01:58.20,0:02:00.89,Narrator,,0,0,0,,...dört gün boyunca ıssız adada demirli bir şekilde bekledi."
Dialogue: 5,0:02:00.89,0:02:02.62,Narrator,,0,0,0,,"Bunun ardından yola çıktık."
Dialogue: 5,0:02:02.62,0:02:05.85,Narrator,,0,0,0,,"Bugün yolculuğumuzun üçüncü gününün sabahı."
Dialogue: 5,0:02:05.85,0:02:08.69,Narrator,,0,0,0,,"Hava açık ve güneşli."
Dialogue: 5,0:02:09.61,0:02:11.31,Narrator,,0,0,0,,"Çoğunlukla bahar, kısmense bir yaz günü."
Dialogue: 5,0:02:16.70,0:02:18.49,Main-207+,,0,0,0,,Ne güzel bir hava!
Dialogue: 5,0:02:19.09,0:02:22.49,Main-207+,,0,0,0,,Nami-swan~!
Dialogue: 5,0:02:25.60,0:02:30.29,Main-207+,,0,0,0,,Bu Patates Paille'ı yapmak için çok uğraştım.\NMatmazel, tatmak ister misiniz?
Dialogue: 5,0:02:25.60,0:02:30.29,Note,,0,0,0,,Pommes Paille: Patatesin ince uzun şekilde kesilmesiyle yapılan yemek.
Dialogue: 5,0:02:32.42,0:02:34.10,Main-207+,,0,0,0,,Mmm, çok lezzetli!
Dialogue: 5,0:02:34.10,0:02:36.68,Main-207+,,0,0,0,,MUTLU OLDUM~!
Dialogue: 5,0:02:36.68,0:02:39.47,Main-207+,,0,0,0,,Yavaş ol, seni salak. Uyumaya çalışıyorum.
Dialogue: 5,0:02:39.47,0:02:43.00,Main-207+,,0,0,0,,Tamam, tamam, afedersin, seni kaktüs.
Dialogue: 5,0:02:43.00,0:02:45.31,Main-207+,,0,0,0,,Bu da neydi, dart tahtası?!
Dialogue: 5,0:02:45.31,0:02:47.95,Main-207+,,0,0,0,,Dar– Ne dedin bana?
Dialogue: 5,0:02:47.95,0:02:50.00,Main-207+,,0,0,0,,Dart tahtası kaşlı.
Dialogue: 5,0:02:53.64,0:02:57.61,Main-207+,,0,0,0,,Luffy! Evet! Luffy! Evet!
Dialogue: 5,0:02:57.61,0:03:02.23,Main-207+,,0,0,0,,Luffy! Evet! Luffy!
Dialogue: 5,0:03:04.43,0:03:06.98,Main-207+,,0,0,0,,Bunu bekliyorduk!
Dialogue: 5,0:03:05.64,0:03:06.98,Secondary-207+,,0,0,0,,Luffy!
Dialogue: 5,0:03:13.79,0:03:16.75,Main-207+,,0,0,0,,Bu donmuş halim!
Dialogue: 5,0:03:23.72,0:03:27.89,Main-207+,,0,0,0,,Neredeyse ölümüne donmuş\Nbiri için bu tuhaf bir davranış.
Dialogue: 5,0:03:29.74,0:03:33.48,Main-207+,,0,0,0,,– Böyle bir şey miydi?\N– Böyleydi! Aynen böyleydi, Luffy!
Dialogue: 5,0:03:33.48,0:03:35.87,Main-207+,,0,0,0,,Orayı temizlediğinizden emin olun, Luffy!
Dialogue: 5,0:03:35.87,0:03:38.86,Main-207+,,0,0,0,,Ha? Nami, ne yiyorsun?
Dialogue: 5,0:03:38.86,0:03:41.14,Main-207+,,0,0,0,,Paille. Patates yemeği.
Dialogue: 5,0:03:41.94,0:03:45.24,Main-207+,,0,0,0,,Patates mi?\NBen de acıktım! Hey, Sanji!
Dialogue: 5,0:03:45.24,0:03:48.96,Main-207+,,0,0,0,,Bir gün içinde ne kadar süre uyumak zorundasın?
Dialogue: 5,0:03:48.96,0:03:52.21,Main-207+,,0,0,0,,İstediğim kadar uyurum!\NBu konuda dövüşmek ister misin?
Dialogue: 5,0:04:03.59,0:04:06.30,Main-207+,,0,0,0,,Paille deniyor. Çok lezzetli!
Dialogue: 5,0:04:06.30,0:04:08.58,Main-207+,,0,0,0,,Paille nedir?
Dialogue: 5,0:04:08.58,0:04:12.65,Main-207+,,0,0,0,,Paille, Büyük Canavar Paille'ın\Nkuyruğundan alınan ete verilen isimdir.
Dialogue: 5,0:04:12.65,0:04:16.19,Main-207+,,0,0,0,,Onu öldüren bendim. 100 metre boyundaydı!
Dialogue: 5,0:04:16.80,0:04:19.46,Main-207+,,0,0,0,,100 metre mi?! Müthişsin Usopp!
Dialogue: 5,0:04:19.46,0:04:21.61,Main-207+,,0,0,0,,Hem de kahvaltıdan hemen önce.
Dialogue: 5,0:04:21.61,0:04:24.26,Main-207+,,0,0,0,,Ne? Onu öldürmek için erken mi kalktın?
Dialogue: 5,0:04:24.26,0:04:27.49,Main-207+,,0,0,0,,Chopper, benim adım ne?
Dialogue: 5,0:04:27.49,0:04:31.08,Main-207+,,0,0,0,,Şey, sen K-Kaptan-
Dialogue: 5,0:04:31.08,0:04:35.58,Main-207+,,0,0,0,,Evet! Adım Kaptan Usopp-
Dialogue: 5,0:04:37.42,0:04:39.34,Main-207+,,0,0,0,,Robin!
Dialogue: 5,0:04:39.34,0:04:42.50,Main-207+,,0,0,0,,{Yoo-hoo}Hey! Robin-{\i1}chwan{\fs10} {\r}!
Dialogue: 5,0:04:42.50,0:04:43.72,Main-207+,,0,0,0,,Robin!
Dialogue: 5,0:04:43.72,0:04:46.51,Main-207+,,0,0,0,,Hala üşüyor musun?
Dialogue: 5,0:04:46.51,0:04:50.97,Main-207+,,0,0,0,,Tedavin iyileşmeme yardımcı oldu.\NTeşekkür ederim. Harika bir doktorsun.
Dialogue: 5,0:04:50.97,0:04:56.60,Main-207+,,0,0,0,,Harika doktor demen beni mutlu etmez, seni pislik!
Dialogue: 5,0:04:56.60,0:04:58.44,Main-207+,,0,0,0,,– Mutlu görünüyor.\N– Evet.
Dialogue: 5,0:04:58.44,0:05:00.27,Main-207+,,0,0,0,,Kendini zorlama, Robin.
Dialogue: 5,0:05:00.27,0:05:05.17,Main-207+,,0,0,0,,Luffy çoktan bağıra çağıra\Ndolaşacak kadar iyileşti...
Dialogue: 5,0:05:05.17,0:05:07.16,Main-207+,,0,0,0,,...ama sen acele etme.
Dialogue: 5,0:05:07.16,0:05:09.16,Main-207+,,0,0,0,,– Oley! \N– Bu iltifat değildi!
Dialogue: 5,0:05:09.73,0:05:13.23,Main-207+,,0,0,0,,Robin-chan, seni ısıtacak bir şeyler yapayım mı?
Dialogue: 5,0:05:13.23,0:05:14.54,Main-207+,,0,0,0,,İştahın yerine geldi mi?
Dialogue: 5,0:05:15.38,0:05:18.30,Main-207+,,0,0,0,,Olur. Biraz kahve alabilir miyim lütfen?
Dialogue: 5,0:05:18.30,0:05:21.03,Main-207+,,0,0,0,,Elbette! Memnuniyetle!
Dialogue: 5,0:05:37.56,0:05:38.65,Main-207+,,0,0,0,,O da ne?
Dialogue: 5,0:05:46.07,0:05:50.26,Main-207+,,0,0,0,,Ah, yemek için paille olmasaydı,\Nkesinlikle işler yolunda gitmezdi.
Dialogue: 5,0:05:50.26,0:05:52.00,Main-207+,,0,0,0,,Evet, harika!
Dialogue: 5,0:05:52.00,0:05:54.04,Main-207+,,0,0,0,,Bunu satsaydık para kazanırdık.
Dialogue: 5,0:05:54.04,0:05:55.37,Main-207+,,0,0,0,,Hey, Luffy!
Dialogue: 5,0:05:55.37,0:05:58.30,Main-207+,,0,0,0,,Kulaç atan bir kurbağa var!
Dialogue: 5,0:05:58.30,0:05:59.46,Main-207+,,0,0,0,,Ne?
Dialogue: 5,0:05:59.46,0:06:01.48,Main-207+,,0,0,0,,O tarafa gelince kendin gör!
Dialogue: 5,0:06:01.48,0:06:04.38,Main-207+,,0,0,0,,– Gerçekten mi?\N– Şu duyduğumuz kurbağayı mı kastediyorsun?
Dialogue: 5,0:06:04.38,0:06:09.47,Main-207+,,0,0,0,,Hey, Luffy. O aptal amiralin sana\Nsöylediği şeye cidden inanıyor musun?
Dialogue: 5,0:06:09.47,0:06:12.41,Main-207+,,0,0,0,,Yani kulaç atan kurbağa... ORADA!
Dialogue: 5,0:06:12.41,0:06:14.31,Main-207+,,0,0,0,,KURBAĞA KULAÇ ATIYOR!
Dialogue: 5,0:06:14.31,0:06:16.99,Main-207+,,0,0,0,,– Peşinden gidelim!\N– Tamam!
Dialogue: 5,0:06:16.99,0:06:20.80,Main-207+,,0,0,0,,Yelkeni toplayın! Küreklere asılın!\NGemiyi 2 yönüne çevirin!
Dialogue: 5,0:06:20.80,0:06:22.89,Main-207+,,0,0,0,,– Tamam!\N– Çabuk!
Dialogue: 5,0:06:22.89,0:06:26.28,Main-207+,,0,0,0,,Neler oluyor bilmiyorum ama içimden bir\Nhis onu takip etmemiz gerektiğini söylüyor!
Dialogue: 5,0:06:27.04,0:06:29.28,Main-207+,,0,0,0,,Beklediğiniz için teşekkürler, matmazeller.
Dialogue: 5,0:06:31.64,0:06:32.83,Main-207+,,0,0,0,,O da neydi?
Dialogue: 5,0:06:32.83,0:06:34.70,Main-207+,,0,0,0,,Ne? Ne oldu?
Dialogue: 5,0:06:37.80,0:06:39.96,Main-207+,,0,0,0,,Gemi yön değiştirmiş gibi.
Dialogue: 5,0:06:39.96,0:06:44.42,Main-207+,,0,0,0,,Hey, siz!\NNiye rotayı değiştiriyorsunuz?!
Dialogue: 5,0:06:44.42,0:06:46.65,Main-207+,,0,0,0,,Sahi! Şunu dinle Nami!
Dialogue: 5,0:06:46.65,0:06:49.38,Main-207+,,0,0,0,,Her yeri yara bere\Niçinde olan şu koca kurbağayı bulduk!
Dialogue: 5,0:06:50.10,0:06:51.68,Main-207+,,0,0,0,,Neden bahsediyorsun?
Dialogue: 5,0:06:51.68,0:06:55.24,Main-207+,,0,0,0,,Onu pişirip öğle yemeğinde yemeliyiz!
Dialogue: 5,0:06:55.24,0:06:56.47,Main-207+,,0,0,0,,Yemek mi?!
Dialogue: 5,0:06:57.89,0:06:59.25,Main-207+,,0,0,0,,Haklısın!
Dialogue: 5,0:07:00.30,0:07:02.48,Main-207+,,0,0,0,,O deniz feneri mi?
Dialogue: 5,0:07:03.60,0:07:08.15,Main-207+,,0,0,0,,Deniz fenerinin orada ne işi var?\NAcaba orada biri mi var?
Dialogue: 5,0:07:08.15,0:07:10.53,Main-207+,,0,0,0,,N-Ne oldu? Ada falan mı gördün?
Dialogue: 5,0:07:10.53,0:07:14.87,Main-207+,,0,0,0,,Hayır, sadece bir deniz feneri. \NSeyir Pusulası'nın göstereceği bir şey yok.
Dialogue: 5,0:07:14.87,0:07:17.79,Main-207+,,0,0,0,,Ama kurbağa! \NBize kurbağanın nereye gittiğini söyle!
Dialogue: 5,0:07:17.79,0:07:18.91,Main-207+,,0,0,0,,Hayır!
Dialogue: 5,0:07:18.91,0:07:21.44,Main-207+,,0,0,0,,Kurbağa deniz fenerine doğru yüzüyor.
Dialogue: 5,0:07:21.44,0:07:22.40,Main-207+,,0,0,0,,Ne?
Dialogue: 5,0:07:22.40,0:07:25.25,Main-207+,,0,0,0,,Kurbağa, yapışkan kısmının ayrılması\Niçin önce beyaz şaraba yatırılmalı...
Dialogue: 5,0:07:25.25,0:07:27.46,Main-207+,,0,0,0,,...ve sonra una bulanıp iyice kızartılmalı.
Dialogue: 5,0:07:27.46,0:07:28.97,Main-207+,,0,0,0,,Dur biraz, Sanji-kun!
Dialogue: 5,0:07:28.97,0:07:33.18,Main-207+,,0,0,0,,Kaptan gidiyoruz diyorsa, elimizden bir şey gelmez.
Dialogue: 5,0:07:33.18,0:07:35.18,Main-207+,,0,0,0,,Robin...
Dialogue: 5,0:07:35.18,0:07:38.24,Main-207+,,0,0,0,,Evet! Tam yol ileri!
Dialogue: 5,0:07:38.24,0:07:39.24,Main-207+,,0,0,0,,TAMAM!
Dialogue: 5,0:07:39.24,0:07:41.14,Main-207+,,0,0,0,,Niye hepiniz buna uyuyorsunuz?!
Dialogue: 5,0:07:41.14,0:07:44.98,Main-207+,,0,0,0,,Çek! Çek! Çek!
Dialogue: 5,0:07:49.90,0:07:51.80,Main-207+,,0,0,0,,Zıpladı!
Dialogue: 5,0:07:51.80,0:07:55.24,Main-207+,,0,0,0,,Kaçmasına izin vermeyin!\NYakalayın ve doğrayın!
Dialogue: 5,0:07:55.24,0:07:59.33,Main-207+,,0,0,0,,Çek! Çek! Çek!
Dialogue: 5,0:08:11.89,0:08:13.88,Main-207+,,0,0,0,,G-Galiba bir şeye çarptık!
Dialogue: 5,0:08:16.18,0:08:19.39,Main-207+,,0,0,0,,Nami-san, Robin-chan, iyi misiniz?
Dialogue: 5,0:08:19.39,0:08:21.99,Main-207+,,0,0,0,,Evet, sanırım.
Dialogue: 5,0:08:21.99,0:08:23.39,Main-207+,,0,0,0,,İyiyim.
Dialogue: 5,0:08:24.42,0:08:27.36,Main-207+,,0,0,0,,Çok şükür.
Dialogue: 5,0:08:27.36,0:08:30.15,Main-207+,,0,0,0,,O ses de ne?
Dialogue: 5,0:08:30.81,0:08:32.86,Main-207+,,0,0,0,,Ne? Neler oluyor?
Dialogue: 5,0:08:48.37,0:08:50.59,Main-207+,,0,0,0,,Bu ses sanki... Yoksa...
Dialogue: 5,0:08:58.35,0:09:00.81,Main-207+,,0,0,0,,O şeyin burada ne işi var?!
Dialogue: 5,0:09:00.81,0:09:03.73,Main-207+,,0,0,0,,Uf, uf, uf{...}!
Dialogue: 5,0:09:05.55,0:09:08.48,Main-207+,,0,0,0,,Geriye! Geriye! \NGemiyi 180° döndürün!
Dialogue: 5,0:09:27.25,0:09:29.21,Main-207+,,0,0,0,,O şey de ne?!
Dialogue: 5,0:09:32.17,0:09:34.80,Main-207+,,0,0,0,,O da ne?! Demir bloğu mu?!
Dialogue: 5,0:09:34.80,0:09:36.26,Main-207+,,0,0,0,,Gemi mi?
Dialogue: 5,0:09:36.26,0:09:39.60,Main-207+,,0,0,0,,Hayır!\NBir geminin öyle yüzmesi mümkün değil!
Dialogue: 5,0:09:43.22,0:09:45.60,Main-207+,,0,0,0,,Hey, Kurbağa! Çekil yoldan! \NNe yapıyorsun?!
Dialogue: 5,0:09:53.90,0:09:56.90,Main-207+,,0,0,0,,Ahhh! Çarptı!
Dialogue: 5,0:10:21.26,0:10:23.56,Main-207+,,0,0,0,,O gemi duman çıkarıyordu!
Dialogue: 5,0:10:34.38,0:10:35.61,Main-207+,,0,0,0,,Korsanlar?
Dialogue: 5,0:10:35.61,0:10:38.36,Main-207+,,0,0,0,,Nine! Nine, korsanlar!
Dialogue: 5,0:10:38.36,0:10:41.74,Main-207+,,0,0,0,,Ne? Gerçekten mi, Chimney?
Dialogue: 5,0:10:41.74,0:10:45.28,Main-207+,,0,0,0,,Evet, tamam! Den Den Mushi'yi getir!
Dialogue: 5,0:10:45.28,0:10:46.00,Main-207+,,0,0,0,,Tamam!
Dialogue: 5,0:10:47.00,0:10:50.12,Main-207+,,0,0,0,,Durum kötü. O binadan iki kişi çıktı.
Dialogue: 5,0:10:50.12,0:10:52.08,Main-207+,,0,0,0,,Yardım çağıracaklar!
Dialogue: 5,0:10:53.25,0:10:54.69,Main-207+,,0,0,0,,Buyur, nine.
Dialogue: 5,0:10:54.69,0:10:56.55,Main-207+,,0,0,0,,Alo?
Dialogue: 5,0:10:56.55,0:11:01.21,Main-207+,,0,0,0,,Şey... Ne diyecektim? Unuttum.
Dialogue: 5,0:11:01.21,0:11:02.51,Main-207+,,0,0,0,,Sarhoş musun?!
Dialogue: 5,0:11:07.47,0:11:13.08,Main-207+,,0,0,0,,Oh, paille! Birayla iyi gider.
Dialogue: 5,0:11:13.08,0:11:15.44,Main-207+,,0,0,0,,Vay canına, tadı harika!
Dialogue: 5,0:11:15.44,0:11:19.20,Main-207+,,0,0,8,,Ben Chimney! Kedimiz Gonbe,...
Dialogue: 5,0:11:19.20,0:11:20.69,Main-207+,,0,0,8,,...ve ninem Kokoro.
Dialogue: 5,0:11:20.69,0:11:24.83,Main-207+,,0,0,8,,Bahse varım deniz trenini soymak için gelmemişsinizdir.
Dialogue: 5,0:11:24.83,0:11:27.70,Main-207+,,0,0,0,,Ben Luffy, Korsanlar Kralı olacak kişiyim.
Dialogue: 5,0:11:27.70,0:11:29.00,Main-207+,,0,0,0,,– Gerçekten mi? \N– Evet!
Dialogue: 5,0:11:30.00,0:11:31.96,Main-207+,,0,0,0,,İlginç bir adamsın.
Dialogue: 5,0:11:31.96,0:11:34.79,Main-207+,,0,0,0,,Hey, Chimney. O buharlı bir gemiye benziyordu.
Dialogue: 5,0:11:34.79,0:11:39.03,Main-207+,,0,0,0,,Ama öyle gövdesi olan bir\Ngemi nasıl hareket edebilir?
Dialogue: 5,0:11:39.03,0:11:41.17,Main-207+,,0,0,0,,Eminim hiç öyle bir şey görmemişsinizdir!
Dialogue: 5,0:11:41.17,0:11:43.72,Main-207+,,0,0,0,,Dünyada başka bir benzeri yok!
Dialogue: 5,0:11:43.72,0:11:47.16,Main-207+,,0,0,0,,O deniz treni, Üfleyen Tom.
Dialogue: 5,0:11:47.16,0:11:48.68,Main-207+,,0,0,0,,Üfleyen Tom mu?
Dialogue: 5,0:11:48.68,0:11:52.19,Main-207+,,0,0,0,,Tokaçlarını çevirmek için buhar makinesi\Nkullanır ve deniz rayları boyunca ilerler.
Dialogue: 5,0:11:55.61,0:11:56.79,Main-207+,,0,0,0,,Raylar mı?
Dialogue: 5,0:11:56.79,0:12:00.19,Main-207+,,0,0,0,,Evet!\NSu yüzeyinin hemen altında bulunurlar...
Dialogue: 5,0:12:00.19,0:12:02.69,Main-207+,,0,0,0,,...ve trenin rotasında giderek her gün...
Dialogue: 5,0:12:02.69,0:12:05.19,Main-207+,,0,0,0,,...bir adadan diğerine yolcu taşımasını sağlarlar!
Dialogue: 5,0:12:05.19,0:12:07.12,Main-207+,,0,0,0,,Postaları ve gemileri bile taşır!
Dialogue: 5,0:12:07.12,0:12:09.66,Main-207+,,0,0,0,,Doğru! Burada gerçekten raylar var!
Dialogue: 5,0:12:09.66,0:12:12.50,Main-207+,,0,0,0,,Evet! Yüzen işaretlerimiz ve \Ngeçiş sinyallerimiz var!
Dialogue: 5,0:12:12.50,0:12:14.33,Main-207+,,0,0,0,,Rayları geçmek tehlikelidir!
Dialogue: 5,0:12:14.33,0:12:18.39,Main-207+,,0,0,0,,Tehlikeli ha? Bunu kurbağaya söylesene.
Dialogue: 5,0:12:18.39,0:12:22.09,Main-207+,,0,0,0,,Ona bu şekilde çarpmak çok kötüydü.\NOnu yakalamaya çalışıyorduk.
Dialogue: 5,0:12:22.09,0:12:24.89,Main-207+,,0,0,0,,Ah, Yokozuna'yı mı kastediyorsun?
Dialogue: 5,0:12:24.89,0:12:26.99,Main-207+,,0,0,0,,Evet, Kulaç Atan Kurbağa.
Dialogue: 5,0:12:26.99,0:12:29.90,Main-207+,,0,0,0,,Onu öldürmek için bundan fazlası gerekir.
Dialogue: 5,0:12:29.90,0:12:33.09,Main-207+,,0,0,0,,İstasyon etrafındaki en büyük baş belasıdır.
Dialogue: 5,0:12:33.09,0:12:36.70,Main-207+,,0,0,0,,Gücünü sınamayı sever. \NHer zaman deniz trenini yenmeye çalışıyor.
Dialogue: 5,0:12:36.70,0:12:38.18,Main-207+,,0,0,0,,Yakında yine gelir.
Dialogue: 5,0:12:38.18,0:12:42.12,Main-207+,,0,0,0,,Gücünü mü sınıyor?\NAh, demek bu yüzden çekilmedi!
Dialogue: 5,0:12:42.12,0:12:43.72,Main-207+,,0,0,0,,Cesur bir kurbağa!
Dialogue: 5,0:12:43.72,0:12:46.37,Main-207+,,0,0,0,,Şaka mı yapıyorsun?!\NBaşımıza bir sürü dert açıyor!
Dialogue: 5,0:12:46.37,0:12:49.45,Main-207+,,0,0,0,,Kaç tane lokomotif mahmuzu\Nkırdığını biliyor musun?!
Dialogue: 5,0:12:49.45,0:12:53.91,Main-207+,,0,0,0,,Her ortaya çıkışında, yolcularımızın\Nyüreklerini ağızlarına getiriyor!
Dialogue: 5,0:12:53.91,0:12:55.80,Main-207+,,0,0,0,,Anlıyorum.
Dialogue: 5,0:12:55.80,0:12:57.71,Main-207+,,0,0,0,,Tamam, onu yemeyeceğim!
Dialogue: 5,0:12:57.71,0:12:59.44,Main-207+,,0,0,0,,O kadar cesur bir şeyi asla yemem!
Dialogue: 5,0:12:59.44,0:13:01.80,Main-207+,,0,0,0,,Zaten kurbağaları yememen gerekir!
Dialogue: 5,0:13:01.80,0:13:05.80,Main-207+,,0,0,0,,Peki, tam olarak nereye gidiyorsunuz?
Dialogue: 5,0:13:05.80,0:13:09.01,Main-207+,,0,0,0,,Deniz treni sizi neredeyse her yere götürebilir.
Dialogue: 5,0:13:10.70,0:13:16.14,Main-207+,,0,0,0,,Bahar Kraliçesi'nin şehri, St. Poplar.\NMükemmel Mutfak şehri, Pucci.
Dialogue: 5,0:13:16.14,0:13:20.90,Main-207+,,0,0,0,,Karnaval şehri, San Faldo!\NHepsi gidilesi yerlerdir.
Dialogue: 5,0:13:20.90,0:13:25.82,Main-207+,,0,0,0,,Hükümet personeline\Ntahsis edilmiş bir tren de var.
Dialogue: 5,0:13:25.82,0:13:27.46,Main-207+,,0,0,0,,Tamam, o zaman mükemmel mutfak şeh-
Dialogue: 5,0:13:27.46,0:13:28.70,Main-207+,,0,0,0,,Hayır, gitmiyoruz!
Dialogue: 5,0:13:29.60,0:13:32.50,Main-207+,,0,0,0,,Kendi gemimiz olduğu için trene ihtiyacımız yok.
Dialogue: 5,0:13:32.50,0:13:33.70,Main-207+,,0,0,0,,Seyrimizi takip edeceğiz.
Dialogue: 5,0:13:33.70,0:13:35.75,Main-207+,,0,0,0,,Şimdi nereyi gösteriyor?
Dialogue: 5,0:13:35.75,0:13:37.54,Main-207+,,0,0,0,,Doğuyu.
Dialogue: 5,0:13:37.54,0:13:41.46,Main-207+,,0,0,0,,Anlıyorum. Demek Water 7'a gidiyorsunuz.
Dialogue: 5,0:13:41.46,0:13:45.47,Main-207+,,0,0,0,,Deminki tren Water 7'ın\NMavi İstasyon'undan ayrıldı.
Dialogue: 5,0:13:46.43,0:13:49.14,Main-207+,,0,0,0,,Su şehri denir ve mükemmel bir yerdir!
Dialogue: 5,0:13:49.14,0:13:53.15,Main-207+,,0,0,0,,Eşsiz bir şehirdir çünkü onu başarılı\Nyapan meşhur tersaneleridir.
Dialogue: 5,0:13:53.15,0:14:00.00,Main-207+,,0,0,0,,Yaptıkları gemiler o kadar iyidir ki Hükümet\Nbile onlardan satın alır! Epey harika, ha?
Dialogue: 5,0:14:00.00,0:14:03.09,Main-207+,,0,0,0,,O zaman çok usta gemi marangozları da vardır!
Dialogue: 5,0:14:03.09,0:14:09.49,Main-207+,,0,0,0,,Heh, sadece iyileri yok! Şehir, dünyanın\Nen iyi gemi marangozlarının yurdudur!
Dialogue: 5,0:14:09.49,0:14:10.54,Main-207+,,0,0,0,,Usopp!
Dialogue: 5,0:14:10.54,0:14:11.80,Main-207+,,0,0,0,,Evet!
Dialogue: 5,0:14:11.80,0:14:13.60,Main-207+,,0,0,0,,Tamam, karar verdim!
Dialogue: 5,0:14:13.60,0:14:16.37,Main-207+,,0,0,0,,Oraya gideceğiz ve arkadaşımız\Nolacak bir gemi marangozu bulacağız!
Dialogue: 5,0:14:16.37,0:14:20.36,Main-207+,,0,0,0,,Ah, anlıyorum. Durun biraz.
Dialogue: 5,0:14:20.36,0:14:22.09,Main-207+,,0,0,0,,Bir bakalım!
Dialogue: 5,0:14:22.90,0:14:25.17,Main-207+,,0,0,0,,– Ne oldu?\N– Bilmem.
Dialogue: 5,0:14:25.17,0:14:30.29,Main-207+,,0,0,0,,Alın bakalım. Adanın basit bir haritası\Nve kendinizi tanıtmanız için bir mesaj.
Dialogue: 5,0:14:30.29,0:14:35.60,Main-207+,,0,0,0,,Bunu Iceburg adındaki adama verin\Nve geminizi tamir etmesini isteyin.
Dialogue: 5,0:14:35.60,0:14:38.94,Main-207+,,0,0,0,,Water 7 büyük bir şehirdir, kaybolmamaya çalışın.
Dialogue: 5,0:14:40.13,0:14:42.90,Main-207+,,0,0,0,,Çok iyi kalplisiniz, Kokoro-san! Çok iyi birisiniz!
Dialogue: 5,0:14:47.39,0:14:50.91,Main-207+,,0,0,0,,Biz de yakında Water 7'a gideceğiz.
Dialogue: 5,0:14:50.91,0:14:56.81,Main-207+,,0,0,0,,Evet, öyle. Yine karşılaşırsak, \Nen sevdiğim barda size bir yarımlık ısmarlarım!
Dialogue: 5,0:14:57.58,0:15:00.17,Main-207+,,0,0,0,,Tamam! Umarım yine karşılaşırız!
Dialogue: 5,0:15:00.17,0:15:05.09,Main-207+,,0,0,0,,Seyir'in Water 7'da ayarlanması bir\Nhafta kadar sürecek! Keyfinize bakın!
Dialogue: 5,0:15:06.26,0:15:08.51,Main-207+,,0,0,0,,Tamam! Sağol!
Dialogue: 5,0:15:09.80,0:15:13.40,Main-207+,,0,0,0,,Tamam çocuklar! \NYola çıkmaya hazırlanın!
Dialogue: 5,0:15:13.40,0:15:15.20,Main-207+,,0,0,0,,– Evet!\N– Gidiyoruz!
Dialogue: 5,0:15:15.20,0:15:18.56,Main-207+,,0,0,0,,Yardımlarınız için sağolun, \NKokoro-san, Chimney!
Dialogue: 5,0:15:24.80,0:15:26.65,Main-207+,,0,0,0,,İyi yolculuklar!
Dialogue: 5,0:15:28.82,0:15:32.03,Main-207+,,0,0,0,,Hükümet memurlarından uzak durun!
Dialogue: 5,0:15:32.03,0:15:34.95,Main-207+,,0,0,0,,Oley! Gidiyoruz!
Dialogue: 5,0:15:34.95,0:15:39.58,Main-207+,,0,0,0,,Et şehrine! Yaşasın!
Dialogue: 5,0:15:37.62,0:15:39.58,Secondary-207+,,0,0,0,,Bunu nereden duydun?
Dialogue: 5,0:15:49.04,0:15:51.69,Main-207+,,0,0,0,,Oh! Ne hoş bir esinti.
Dialogue: 5,0:15:51.69,0:15:54.50,Main-207+,,0,0,0,,Su şehrine planladığımızdan önce varabiliriz.
Dialogue: 5,0:15:54.50,0:15:55.85,Main-207+,,0,0,0,,Umarım öyle olur.
Dialogue: 5,0:15:55.95,0:15:59.13,Main-207+,,0,0,0,,Luffy, gemi marangozu bulma\Nkonusunda bana güvenebilirsin.
Dialogue: 5,0:15:59.16,0:16:01.26,Main-207+,,0,0,0,,Görmüş olduğunuz en\Nateşli pilici bulacağım!
Dialogue: 5,0:16:01.26,0:16:03.21,Main-207+,,0,0,0,,Seni aptal! \NGemi marangozu, marangozdur!
Dialogue: 5,0:16:03.21,0:16:06.90,Main-207+,,0,0,0,,Dağ gibi kocaman biri lazım! \NBeş metre uzunluğunda!
Dialogue: 5,0:16:06.90,0:16:11.49,Main-207+,,0,0,0,,Ama o kadar büyük biri \Nbu gemide nasıl yaşayabilir?
Dialogue: 5,0:16:11.49,0:16:14.09,Main-207+,,0,0,0,,İşinin ehli olduğu sürece herhangi biri olur.
Dialogue: 5,0:16:14.09,0:16:18.49,Main-207+,,0,0,0,,Ama korsan gemisine binecek\Nkadar çılgın birini bulabilmek mesele.
Dialogue: 5,0:16:18.49,0:16:22.33,Main-207+,,0,0,0,,Bekleyemiyorum! Bir arkadaş daha bulabiliriz!
Dialogue: 5,0:16:22.33,0:16:26.34,Main-207+,,0,0,0,,O istasyonu bulduğumuz için şanslıyız.\NArtık haritamız var.
Dialogue: 5,0:16:26.34,0:16:30.17,Main-207+,,0,0,0,,Bunu Iceburg denen adamı bulmak için\Nkullanacağız ve ondan yardım isteyeceğiz.
Dialogue: 5,0:16:31.47,0:16:32.38,Main-207+,,0,0,0,,Anlıyorum.
Dialogue: 5,0:16:32.38,0:16:34.26,Main-207+,,0,0,0,,Bu hiçbir işe yaramaz!
Dialogue: 5,0:16:35.01,0:16:36.51,Main-207+,,0,0,0,,Ah, Luffy çizmiş gibi görünüyor.
Dialogue: 5,0:16:36.51,0:16:39.72,Main-207+,,0,0,0,,İşte. Böyle birini arıyoruz.
Dialogue: 5,0:16:40.35,0:16:42.09,Main-207+,,0,0,0,,Öyle birini görürsem kaçarım.
Dialogue: 5,0:16:42.09,0:16:45.68,Main-207+,,0,0,0,,Evet, ben de. Ayrıca gemi\Nbulursam da hemen denize açılırım.
Dialogue: 5,0:16:45.68,0:16:49.41,Main-207+,,0,0,0,,Ama yarı ahtapota benziyor,\Nyine de peşimden gelebilir.
Dialogue: 5,0:16:49.41,0:16:51.24,Main-207+,,0,0,0,,Neden bahsediyorsunuz?
Dialogue: 5,0:16:51.24,0:16:52.70,Main-207+,,0,0,0,,Herkes buraya gelsin!
Dialogue: 5,0:16:52.70,0:16:55.87,Main-207+,,0,0,0,,Buradayken her birinize bir\Nhaftalık harçlık vereceğim!
Dialogue: 5,0:16:55.87,0:16:57.52,Main-207+,,0,0,0,,Cidden mi?! Yaşasın, ilk bana!
Dialogue: 5,0:16:57.52,0:16:59.24,Main-207+,,0,0,0,,Vay! Zengin olduk!
Dialogue: 5,0:16:59.24,0:17:01.75,Main-207+,,0,0,0,,Hey, sırayı bozma!
Dialogue: 5,0:17:02.56,0:17:05.71,Main-207+,,0,0,0,,Harçlık! Harçlık! Harçlık!
Dialogue: 5,0:17:15.78,0:17:17.60,Main-207+,,0,0,0,,Ne yapıyorsun, Usopp?
Dialogue: 5,0:17:17.60,0:17:22.89,Main-207+,,0,0,0,,Bu çelik levha yaması bile dövüş\Nve macera anılarımı canlandırıyor.
Dialogue: 5,0:17:22.89,0:17:27.81,Main-207+,,0,0,0,,Her şeyin eğreti bir şekilde tamir edildiğini\Nhayal etmek bile gözlerimi dolduruyor!
Dialogue: 5,0:17:27.81,0:17:29.65,Main-207+,,0,0,0,,– Evet, bunu anlıyorum ama...\N– Ha?
Dialogue: 5,0:17:29.65,0:17:34.86,Main-207+,,0,0,0,,...özellikle Grand Line'a girdiğimizden\Nberi Merry çok fazla hasar gördü.
Dialogue: 5,0:17:34.86,0:17:38.41,Main-207+,,0,0,0,,Güverte gıcırdıyor ve ambar su fıçısına döndü.
Dialogue: 5,0:17:38.41,0:17:41.95,Main-207+,,0,0,0,,Bir şey yapmazsak, bizimle birlikte\Ngeminin de başı derde girecek.
Dialogue: 5,0:17:41.95,0:17:44.95,Main-207+,,0,0,0,,Evet ama artık çok paramız var!
Dialogue: 5,0:17:44.95,0:17:48.50,Main-207+,,0,0,0,,Onu yepyeni yapabiliriz!\NOnu güçlendiririz bile!
Dialogue: 5,0:17:49.26,0:17:50.90,Main-207+,,0,0,0,,Tamam, birkaç top daha alalım!
Dialogue: 5,0:17:50.90,0:17:52.58,Main-207+,,0,0,0,,Bir de bronz heykel!
Dialogue: 5,0:17:53.26,0:17:54.90,Main-207+,,0,0,0,,Hey, bu o mu?
Dialogue: 5,0:17:54.90,0:17:55.76,Main-207+,,0,0,0,,Ha?
Dialogue: 5,0:17:57.93,0:18:01.74,Main-207+,,0,0,0,,Bir ada! Kara göründü!
Dialogue: 5,0:18:02.81,0:18:05.09,Main-207+,,0,0,0,,Tamam çocuklar! Kürek çekin!
Dialogue: 5,0:18:05.09,0:18:08.02,Main-207+,,0,0,0,,Rüzgar bizi götürür.\NEnerjimizi boşa harcatma.
Dialogue: 5,0:18:18.28,0:18:19.41,Main-207+,,0,0,0,,Çok güzel!
Dialogue: 5,0:18:21.70,0:18:22.74,Main-207+,,0,0,0,,Harika!
Dialogue: 5,0:18:28.01,0:18:30.37,Main-207+,,0,0,8,,Burası da ne böyle?
Dialogue: 5,0:18:39.59,0:18:41.80,Main-207+,,0,0,0,,Dev bir fıskiye!
Dialogue: 5,0:18:42.90,0:18:45.72,Main-207+,,0,0,0,,Müthiş! Endüstri şehrinin ta kendisi!
Dialogue: 5,0:18:45.72,0:18:47.43,Main-207+,,0,0,0,,Deniz treni bu yüzden burada duruyor!
Dialogue: 5,0:18:47.43,0:18:49.60,Main-207+,,0,0,0,,İlerideki bina tren istasyonu olmalı.
Dialogue: 5,0:18:50.41,0:18:52.60,Main-207+,,0,0,0,,Tabelada Mavi İstasyon yazıyor.
Dialogue: 5,0:18:54.13,0:18:55.61,Main-207+,,0,0,0,,Acaba iskele nerede?
Dialogue: 5,0:18:55.61,0:18:56.94,Main-207+,,0,0,0,,Muhtemelen orada.
Dialogue: 5,0:18:57.69,0:19:00.20,Main-207+,,0,0,0,,– Hey, çocuklar!\N– Ne?
Dialogue: 5,0:19:00.20,0:19:03.60,Main-207+,,0,0,0,,Korsanlar ön kapıdan girerken görülmemeli!
Dialogue: 5,0:19:03.60,0:19:05.79,Main-207+,,0,0,0,,Diğer taraftaki şehre doğru çekin!
Dialogue: 5,0:19:06.81,0:19:09.25,Main-207+,,0,0,0,,Tamam, sağolun!
Dialogue: 5,0:19:14.75,0:19:17.71,Main-207+,,0,0,0,,Vay canına, müthiş! \NŞehir suyun üstüne yapılmış!
Dialogue: 5,0:19:17.71,0:19:21.59,Main-207+,,0,0,0,,Müthiş! Ne harika bir yer! \NÇok güzel bir şehir!
Dialogue: 5,0:19:29.94,0:19:34.94,Main-207+,,0,0,0,,Ama her yerde su var.\NEvlerin bazıları denize batıyor.
Dialogue: 5,0:19:34.94,0:19:39.86,Main-207+,,0,0,0,,Hayır, bu şehir çoktan su altında kalmış\Nolan bir kara parçasına inşaa edilmiş.
Dialogue: 5,0:19:39.86,0:19:42.32,Main-207+,,0,0,0,,O binanın altındaki temele bak.
Dialogue: 5,0:19:43.09,0:19:45.53,Main-207+,,0,0,0,,Haklısın! \NTaş sütunların üstüne yapılmış!
Dialogue: 5,0:19:45.53,0:19:48.16,Main-207+,,0,0,0,,Anlıyorum. \NBu yüzden su şehri deniyor.
Dialogue: 5,0:19:49.20,0:19:51.12,Main-207+,,0,0,0,,Hey, gemiyi hemen iskeleye yanaştırın!
Dialogue: 5,0:19:54.00,0:19:57.92,Main-207+,,0,0,0,,Hey, siz! \NKorsan gemileri buraya giremez!
Dialogue: 5,0:19:57.92,0:20:00.45,Main-207+,,0,0,0,,Ne diye geldiniz? \NYağmalayıp talan etmek için mi?
Dialogue: 5,0:20:00.45,0:20:03.08,Main-207+,,0,0,0,,Hayır, gemimizi tamir ettirmeliyiz!
Dialogue: 5,0:20:03.08,0:20:05.39,Main-207+,,0,0,0,,Kim kendisinin yağmalanıp\Nyağmalanmayacağını sorar ki?
Dialogue: 5,0:20:05.39,0:20:10.38,Main-207+,,0,0,0,,O zaman doğruca burnu deneyin!\NGeminizi oraya demirleyebilirsiniz!
Dialogue: 5,0:20:10.38,0:20:11.98,Main-207+,,0,0,0,,Tamam!
Dialogue: 5,0:20:11.98,0:20:13.50,Main-207+,,0,0,0,,Sağol!
Dialogue: 5,0:20:13.50,0:20:14.81,Main-207+,,0,0,0,,Yine başka tarafa-
Dialogue: 5,0:20:14.81,0:20:17.52,Main-207+,,0,0,0,,Yapacak bir şey yok. Biz korsanız.
Dialogue: 5,0:20:19.54,0:20:21.60,Main-207+,,0,0,0,,Burası iyi bir yere benziyor.
Dialogue: 5,0:20:21.60,0:20:25.21,Main-207+,,0,0,0,,Ne kasvetli bir toprak parçası.
Dialogue: 5,0:20:25.21,0:20:27.77,Main-207+,,0,0,0,,Tamam, yelkeni toplayın!
Dialogue: 5,0:20:35.10,0:20:36.75,Main-207+,,0,0,0,,N'apıyorsun lan?!
Dialogue: 5,0:20:36.75,0:20:39.84,Main-207+,,0,0,0,,Hiçbir şey!\NTüm yaptığım ipi çekmekti!
Dialogue: 5,0:20:42.92,0:20:47.51,Main-207+,,0,0,0,,Dalga geçiyorsun! Going Merry, gerçekten bu kadar kötü durumda mı?
Dialogue: 5,0:20:48.80,0:20:52.35,Main-207+,,0,0,0,,Sahi, buradaki insanlar neden\Nkorsanlardan korkmuyor dersiniz?
Dialogue: 5,0:20:52.35,0:20:55.62,Main-207+,,0,0,0,,Tersaneyle alakalı olduğu sürece,\Nkorsanlar da müşteridir.
Dialogue: 5,0:20:55.62,0:20:58.11,Main-207+,,0,0,0,,Çene çalmayı bırak da tamir et!
Dialogue: 5,0:20:58.11,0:21:03.34,Main-207+,,0,0,0,,Şiddete başvurmaları durumunda, onların\Nüstesinden gelecek kadar güçlü insanlar olmalı.
Dialogue: 5,0:21:03.34,0:21:06.78,Main-207+,,0,0,0,,Eminim vardır. Epey büyük bir şehir.
Dialogue: 5,0:21:06.78,0:21:10.36,Main-207+,,0,0,0,,Cidden öyle mi dersiniz?! Hey, ya biz?!\NEndişelenmemiz gerekmiyor mu?!
Dialogue: 5,0:21:10.36,0:21:12.79,Main-207+,,0,0,0,,Elbette hayır! Biz müşteriyiz.
Dialogue: 5,0:21:12.79,0:21:14.12,Main-207+,,0,0,0,,A-Ah. Doğru ya!
Dialogue: 5,0:21:14.12,0:21:15.68,Main-207+,,0,0,0,,Tamam, gidelim!
Dialogue: 5,0:21:15.68,0:21:17.73,Main-207+,,0,0,0,,Durun! Luffy, Usopp!
Dialogue: 5,0:21:19.04,0:21:21.39,Main-207+,,0,0,0,,Siz benimle geliyorsunuz.
Dialogue: 5,0:21:21.39,0:21:22.38,Main-207+,,0,0,0,,Ne?
Dialogue: 5,0:21:24.01,0:21:25.10,Main-207+,,0,0,0,,Nereye?
Dialogue: 5,0:21:25.10,0:21:29.97,Main-207+,,0,0,0,,Önce Kokoro-san'ın mektubunu\Ngötürüp Iceburg'ı bulacağız.
Dialogue: 5,0:21:29.97,0:21:33.70,Main-207+,,0,0,0,,Sonra da ondan gemimizi\Ntamir etmesini isteyeceğiz.
Dialogue: 5,0:21:33.70,0:21:37.06,Main-207+,,0,0,0,,Ayrıca altınımızı paraya\Nçevirebileceğimiz bir yer bulmamız gerek.
Dialogue: 5,0:21:37.06,0:21:42.57,Main-207+,,0,0,0,,Anlıyorum... Demek öyle.\NGidelim o zaman! Su şehrine!
Dialogue: 5,0:21:42.57,0:21:44.69,Main-207+,,0,0,0,,Altını unuttun.
Dialogue: 5,0:21:44.69,0:21:45.90,Main-207+,,0,0,0,,Ah...
Dialogue: 5,0:21:47.20,0:21:50.36,Main-207+,,0,0,0,,Hey, 1 no'lu iskelede sorun çıkaran korsanlar var!
Dialogue: 5,0:21:50.36,0:21:51.87,Main-207+,,0,0,0,,Ooh, gerçekten mi?
Dialogue: 5,0:21:51.87,0:21:54.58,Main-207+,,0,0,0,,Oraya gitmeliyiz!
Dialogue: 5,0:21:55.54,0:21:58.07,Main-207+,,0,0,0,,Tam anlamıyorum.
Dialogue: 5,0:21:58.07,0:22:00.23,Main-207+,,0,0,0,,Evet, şu konuda...
Dialogue: 5,0:22:03.51,0:22:06.20,Main-207+,,0,0,8,,Epey düşündüm.
Dialogue: 5,0:22:06.20,0:22:09.31,Main-207+,,0,0,8,,Bayağı çok düşündüm.
Dialogue: 5,0:22:09.31,0:22:16.96,Main-207+,,0,0,0,,Evet, gemimizi tamir ettiniz ama bize\Nçıkardığınız borca bir türlü inanamıyorum!
Dialogue: 5,0:22:17.80,0:22:20.36,Main-207+,,0,0,0,,Beni işimden alıkoyuyorsunuz.
Dialogue: 5,0:22:20.36,0:22:25.06,Main-207+,,0,0,0,,Bu yüzden kuruş bile ödememeye karar verdim.
Dialogue: 5,0:22:26.80,0:22:29.50,Main-207+,,0,0,0,,Tamir için sağolun!
Dialogue: 5,0:22:31.24,0:22:33.29,Main-207+,,0,0,0,,Ayrıca fiytlarınızı da beğendik!
Dialogue: 5,0:22:44.71,0:22:47.60,Main-207+,,0,0,0,,Pekala... Kalifa, bana neler olduğunu söyle.
Dialogue: 5,0:22:47.60,0:22:50.68,Main-207+,,0,0,0,,Peki, Iceburg-san. 1 no'lu iskeledeki müşteriler...
Dialogue: 5,0:22:50.68,0:22:54.14,Main-207+,,0,0,0,,...ödeme yapmayacaklarını söylüyorlar.
Dialogue: 5,0:22:54.14,0:22:56.60,Main-207+,,0,0,0,,Açıkça cinsel taciz olayı.
Dialogue: 5,0:22:56.60,0:22:59.56,Main-207+,,0,0,0,,Evet... açıkça.
Dialogue: 5,0:23:09.78,0:23:14.24,Main-207+,,0,0,0,,Efendim, işçileri rahatsız etmemelisiniz.
Dialogue: 5,0:23:25.56,0:23:27.46,Main-207+,,0,0,0,,P-Patron!
Dialogue: 5,0:23:27.46,0:23:29.47,Main-207+,,0,0,0,,Patron!
Dialogue: 5,0:23:30.27,0:23:31.43,Main-207+,,0,0,0,,Ah, afedersiniz.
Dialogue: 5,0:23:31.43,0:23:36.51,Main-207+,,0,0,0,,Sen aptal! \NO şeyle sağa sola dönerken dikkat-
Dialogue: 5,0:23:38.48,0:23:40.44,Main-207+,,0,0,0,,Ah, afedersin.
Dialogue: 5,0:23:40.44,0:23:45.40,Main-207+,,0,0,0,,P-Pislikler, dövüşmek mi istiyorsunuz?!\NKim olduğumuzu sanıyorsunuz?!
Dialogue: 5,0:23:55.16,0:23:58.79,Main-207+,,0,0,0,,Topla test atışı yaptın mı?
Dialogue: 5,0:23:58.79,0:24:00.54,Main-207+,,0,0,0,,Hayır, henüz yapmadım.
Dialogue: 5,0:24:03.46,0:24:07.46,Main-207+,,0,0,0,,Kahretsin! Kimsiniz siz böyle?!
Dialogue: 5,0:24:07.91,0:24:10.92,Main-207+,,0,0,0,,Bu yanınıza kalmayacak!
Dialogue: 5,0:24:23.50,0:24:25.50,Main-207+,,0,0,8,,Korsanların, işçi bölgesinde...
Dialogue: 5,0:24:25.50,0:24:26.96,Main-207+,,0,0,8,,...sağa sola saldırmasına...
Dialogue: 5,0:24:26.98,0:24:28.86,Main-207+,,0,0,8,,...sessiz kalacağımızı mı sandınız?
Dialogue: 5,0:24:30.30,0:24:32.61,Main-207+,,0,0,0,,Önce altını değiştirmeye gidelim.
Dialogue: 5,0:24:32.61,0:24:35.17,Main-207+,,0,0,0,,Niye? Ya tersane?
Dialogue: 5,0:24:35.17,0:24:40.70,Main-207+,,0,0,0,,Bir araba dolusu altınla şehirde gezemeyiz.\NGerilmeme neden oluyor. Terliyorum.
Dialogue: 5,0:24:40.70,0:24:43.16,Main-207+,,0,0,0,,Nakite çevirsek bile aynı değerde olacak.
Dialogue: 5,0:24:43.16,0:24:46.83,Main-207+,,0,0,0,,Evet ama bu koca çuvallar çok göze batıyor.
Dialogue: 5,0:24:46.83,0:24:48.73,Main-207+,,0,0,0,,Hırsız çetesine falan rastlarsak,...
Dialogue: 5,0:24:48.73,0:24:50.38,Main-207+,,0,0,0,,Biz de çeteyiz, unuttun mu?
Dialogue: 5,0:24:50.38,0:24:54.72,Main-207+,,0,0,0,,Evet, haklısın. \NAltını nakite çevirirsek taşıyabiliriz.
Dialogue: 5,0:24:54.72,0:24:57.68,Main-207+,,0,0,0,,Hey, bir şey mi ima ediyorsun?
Dialogue: 5,0:24:57.68,0:25:00.00,Main-207+,,0,0,0,,Benim taşımamam gerektiğini mi söylüyorsun?
Dialogue: 5,0:25:00.00,0:25:02.51,Main-207+,,0,0,0,,Evet! Sen kaybedersin.
Dialogue: 5,0:25:02.51,0:25:04.73,Main-207+,,0,0,0,,Kesinlikle! Sonuçta bahsettiğimiz kişi Luffy.
Dialogue: 5,0:25:04.73,0:25:07.61,Main-207+,,0,0,0,,Hey, durun biraz! \NBana güvenmiyor musunuz?!
Dialogue: 5,0:25:07.61,0:25:11.20,Main-207+,,0,0,0,,– Hayır!\N– Ah, çocuklar. Çok kötüsünüz!
Dialogue: 5,0:25:11.20,0:25:14.20,Main-207+,,0,0,0,,Bunu atlatabilir miyim bilmiyorum!
Dialogue: 5,0:25:14.90,0:25:18.49,Main-207+,,0,0,0,,Şehre tek giriş buradan mı?
Dialogue: 5,0:25:19.49,0:25:21.05,Main-207+,,0,0,0,,Kiralık boğa mı?
Dialogue: 5,0:25:21.05,0:25:22.12,Main-207+,,0,0,0,,O da ne?
Dialogue: 5,0:25:22.12,0:25:24.42,Main-207+,,0,0,0,,Burada ne kiralıyoruz?
Dialogue: 5,0:25:24.42,0:25:25.79,Main-207+,,0,0,0,,Boğa nedir?
Dialogue: 5,0:25:25.79,0:25:28.80,Main-207+,,0,0,0,,Bilmem. Buldog mu acaba?
Dialogue: 5,0:25:28.80,0:25:30.00,Main-207+,,0,0,0,,Mümkün değil.
Dialogue: 5,0:25:30.00,0:25:32.52,Main-207+,,0,0,0,,Afedersiniz! \NBirkaç boğa kiralamak istiyorum!
Dialogue: 5,0:25:32.52,0:25:34.22,Main-207+,,0,0,0,,ÖNCE NE OLDUKLARINI SOR!
Dialogue: 5,0:25:35.42,0:25:38.39,Main-207+,,0,0,0,,Hoş geldiniz. Boğa, öyle mi? Kaç kişilik?
Dialogue: 5,0:25:38.39,0:25:39.51,Main-207+,,0,0,0,,Üç.
Dialogue: 5,0:25:39.51,0:25:41.50,Main-207+,,0,0,0,,Ne tür boğa istiyorsunuz?
Dialogue: 5,0:25:41.50,0:25:44.18,Main-207+,,0,0,0,,Üç tür var. Yagara, rabuka ve king.
Dialogue: 5,0:25:44.18,0:25:47.32,Main-207+,,0,0,0,,Üç kişi için iki yagara iş görür.
Dialogue: 5,0:25:47.32,0:25:49.27,Main-207+,,0,0,0,,Evet, iyi pişmiş olsun!
Dialogue: 5,0:25:49.27,0:25:50.98,Main-207+,,0,0,0,,Hey, bu tuhaf bir konuşmaydı!
Dialogue: 5,0:25:51.70,0:25:54.44,Main-207+,,0,0,0,,Oh, demek seyiri takip edip geldiniz.
Dialogue: 5,0:25:54.44,0:25:57.39,Main-207+,,0,0,0,,– Evet.\N– Harika bir yolculuk olmalı.
Dialogue: 5,0:25:57.39,0:25:59.70,Main-207+,,0,0,0,,Eminim daha önce boğaları hiç duymamışsınızdır.
Dialogue: 5,0:25:59.70,0:26:03.29,Main-207+,,0,0,0,,– Doğru.\N– İzin verin göstereyim. Bunlar boğalar.
Dialogue: 5,0:26:03.29,0:26:05.96,Main-207+,,0,0,0,,Yagara Boğaları. \NŞehrin her yerinde görebilirsiniz.
Dialogue: 5,0:26:05.96,0:26:10.24,Main-207+,,0,0,0,,Yagara, başı suyun üstünde yüzen,\Nbu bölgedeki bir balık türevidir.
Dialogue: 5,0:26:10.24,0:26:13.96,Main-207+,,0,0,0,,Normal yoldan çok su yolu olduğu\Niçin bu şehre su şehri denir.
Dialogue: 5,0:26:13.96,0:26:17.59,Main-207+,,0,0,0,,Boğalar, buradaki halkın ayrılmaz bir parçasıdır.
Dialogue: 5,0:26:18.30,0:26:20.76,Main-207+,,0,0,0,,Aynısı turistik geziler için de geçerlidir.
Dialogue: 5,0:26:20.76,0:26:22.82,Main-207+,,0,0,0,,O balık tekneyi çekebilir mi?
Dialogue: 5,0:26:22.82,0:26:25.43,Main-207+,,0,0,0,,Aslında onları çekmezler. Sırtlarında taşırlar.
Dialogue: 5,0:26:25.43,0:26:29.65,Main-207+,,0,0,0,,Eyere veya at terkisine binmek gibidir.
Dialogue: 5,0:26:31.61,0:26:35.65,Main-207+,,0,0,0,,Önünüzdeki ağıla bir bakın. \NDenemek için bir tanesine binebilirsiniz.
Dialogue: 5,0:26:36.40,0:26:40.26,Main-207+,,0,0,0,,İki kişilik yagaralar 2 bin beli.
Dialogue: 5,0:26:40.26,0:26:41.74,Main-207+,,0,0,0,,Ah, çok sevimli!
Dialogue: 5,0:26:41.74,0:26:44.41,Main-207+,,0,0,0,,Bu balık, ata benziyor!
Dialogue: 5,0:26:45.66,0:26:49.50,Main-207+,,0,0,0,,Seni uyuz! Bunu niye yaptın?!
Dialogue: 5,0:26:49.50,0:26:52.84,Main-207+,,0,0,0,,Ah, sanırım seni sevdi. Onu size vereceğim.
Dialogue: 5,0:26:59.18,0:27:01.39,Main-207+,,0,0,0,,Ağır yük de taşıyabilirler mi?
Dialogue: 5,0:27:01.39,0:27:05.31,Main-207+,,0,0,0,,Epey güçlüdürler! \NOnları taşınırken de kullanırız.
Dialogue: 5,0:27:05.95,0:27:08.25,Main-207+,,0,0,0,,Yükünüz o mu? İçinde ne var?
Dialogue: 5,0:27:08.25,0:27:09.35,Main-207+,,0,0,0,,Altın.
Dialogue: 5,0:27:10.29,0:27:13.23,Main-207+,,0,0,0,,Güldürme beni. \NFarketmez, ne olursa taşırlar.
Dialogue: 5,0:27:13.23,0:27:15.12,Main-207+,,0,0,0,,– Bak!\N– OOHHH, BANA DA VERİN!
Dialogue: 5,0:27:15.12,0:27:16.04,Main-207+,,0,0,0,,NE DİYE VERELİM?!
Dialogue: 5,0:27:16.04,0:27:18.03,Main-207+,,0,0,0,,Bu adamın açıksözlülüğü korkutucu.
Dialogue: 5,0:27:18.03,0:27:20.70,Main-207+,,0,0,0,,Karşılaştığın herkese göstermen gerekmez!
Dialogue: 5,0:27:20.70,0:27:22.69,Main-207+,,0,0,0,,Niye? Eksilmedi ya.
Dialogue: 5,0:27:22.69,0:27:24.74,Main-207+,,0,0,0,,Evet, çok şaşırtıcıydı.
Dialogue: 5,0:27:24.74,0:27:28.72,Main-207+,,0,0,0,,Şimdi, yagara boğaları 1 milyona patlayacak.
Dialogue: 5,0:27:28.72,0:27:30.58,Main-207+,,0,0,0,,Bence fiyatı arttırdın amca.
Dialogue: 5,0:27:30.58,0:27:33.33,Main-207+,,0,0,0,,Sahi, yakınlarda altın değişimi\Nyapabileceğimiz bir yer var mı?
Dialogue: 5,0:27:33.33,0:27:40.40,Main-207+,,0,0,0,,Evet, birkaç tane biliyorum ama çoğunun\Nbu kadar altını karşılayacak parası yoktur.
Dialogue: 5,0:27:40.40,0:27:42.89,Main-207+,,0,0,0,,Tersane adasının şehir\Nmerkezine doğru gitmelisiniz.
Dialogue: 5,0:27:42.89,0:27:46.72,Main-207+,,0,0,0,,Tersane adasının şehir merkezine mi?\NHangi tarafta?
Dialogue: 5,0:27:46.72,0:27:50.00,Main-207+,,0,0,0,,O tarafta. Bunu yanınızda götürün!
Dialogue: 5,0:27:50.00,0:27:51.27,Main-207+,,0,0,0,,Harita!
Dialogue: 5,0:27:52.01,0:27:53.44,Main-207+,,0,0,0,,Bu çok işe yarayacak! Sağolun!
Dialogue: 5,0:27:53.44,0:27:56.38,Main-207+,,0,0,0,,Amca, tersaneler de orada mı?
Dialogue: 5,0:27:56.38,0:27:58.81,Main-207+,,0,0,0,,Evet, hem de dünyadaki en iyi tersaneler!
Dialogue: 5,0:27:58.81,0:28:02.95,Main-207+,,0,0,0,,Bu harika! Altını değiştirdikten sonra\Ndoğruca tersaneye gidebiliriz!
Dialogue: 5,0:28:02.95,0:28:06.74,Main-207+,,0,0,0,,Evet, nihayet Going Merry'yi tamir ettirebileceğiz!
Dialogue: 5,0:28:06.74,0:28:10.54,Main-207+,,0,0,0,,Gemi marangozu da bulacağız!\NHeyecanlandım!
Dialogue: 5,0:28:10.54,0:28:12.46,Main-207+,,0,0,0,,– O zaman...\N– Gidiyoruz...
Dialogue: 5,0:28:12.46,0:28:15.38,Main-207+,,0,0,0,,Evet! Gidelim yagara!
Dialogue: 5,0:28:17.30,0:28:20.63,Main-207+,,0,0,0,,Yine bekleriz! Dikkatli olun!
Dialogue: 5,0:28:20.63,0:28:23.73,Main-207+,,0,0,0,,Tersaneye gidiyoruz!
Dialogue: 5,0:28:23.73,0:28:26.15,Main-207+,,0,0,0,,Yaşasın!
