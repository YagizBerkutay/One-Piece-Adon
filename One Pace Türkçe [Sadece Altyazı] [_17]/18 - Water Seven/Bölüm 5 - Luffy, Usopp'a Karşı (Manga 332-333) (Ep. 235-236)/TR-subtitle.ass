0,1,1.8,0,2,22,22,18,1Style: Attack,Dry Brush,42.0,&H0086ECFF,&H00FFFFFF,&H00000026,&H96000000,0,0,0,0,100,100,0,0,1,1.4,1.4,2,12,12,27,1Style: Author,LeviReBrushed,22.0,&H00FFFFFF,&H0000FFFF,&H37000000,&HFFB07236,0,0,0,0,100.0,100,0.0,0,4,1.0,1.0,9,6,6,6,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 5,0:00:06.90,0:00:10.51,Main-207+,,0,0,0,,Ne yapıyorsun?! Ciddi ciddi bunu yapmayı düşünüyor olamazsın!Dialogue: 5,0:00:11.69,0:00:14.60,Main-207+,,0,0,0,,İki arkadaş niye düello yapsın?!Dialogue: 5,0:00:14.60,0:00:18.16,Main-207+,,0,0,0,,Bir süre sonra ikiniz de sakinleşeceksiniz!Dialogue: 5,0:00:18.57,0:00:22.12,Main-207+,,0,0,0,,Usopp sadece, durum kontrolden çıktığı için aşırı tepki veriyordu!Dialogue: 5,0:00:23.01,0:00:25.38,Main-207+,,0,0,0,,Geri adım atmak için çok geç.Dialogue: 5,0:00:26.30,0:00:27.57,Main-207+,,0,0,0,,Hiç de bile!Dialogue: 5,0:00:27.57,0:00:31.09,Main-207+,,0,0,0,,Özür dileyebilirsin ve  tekrardan bu konuyu konuşabilirsiniz!Dialogue: 5,0:00:32.90,0:00:36.97,Main-207+,,0,0,0,,Dediğim gibi... Artık çok geç.Dialogue: 5,0:00:36.97,0:00:38.72,Main-207+,,0,0,0,,Niye?Dialogue: 5,0:00:38.72,0:00:44.25,Main-207+,,0,0,0,,Usopp, aşırı tepki verdiği için hayatını ortaya koyacak kadar aptal değildir.Dialogue: 5,0:00:44.25,0:00:49.94,Main-207+,,0,0,0,,Konuşmak işe yaramış olsaydı, burada olmazdık.Dialogue: 5,0:00:51.09,0:00:52.94,Main-207+,,0,0,0,,Bittiyse git artık.Dialogue: 5,0:00:54.44,0:00:55.60,Main-207+,,0,0,0,,Luffy...Dialogue: 5,0:00:55.60,0:01:00.66,Main-207+,,0,0,0,,Beni dinle! Franky Kardeşler öğleden sonra buradaydı, değil mi?Dialogue: 5,0:01:00.66,0:01:03.24,Main-207+,,0,0,0,,Ha? Ne olmuş?Dialogue: 5,0:01:03.24,0:01:07.33,Main-207+,,0,0,0,,Fırsatın varken niye işlerini bitirmedin?!Dialogue: 5,0:01:07.33,0:01:11.90,Main-207+,,0,0,0,,Usopp'a saldıramazlardı ve bu durumda olmazdık!Dialogue: 5,0:01:11.90,0:01:16.84,Main-207+,,0,0,0,,Sana ne demeli?! Alışverişe gitmek yerine onları pataklayabilirdin!Dialogue: 5,0:01:16.84,0:01:19.25,Main-207+,,0,0,0,,Ben aşçıyım! Malzemelere ihtiyacım-Dialogue: 5,0:01:19.25,0:01:21.81,Main-207+,,0,0,0,,Kapayın çenenizi! Hiç sırası değil!Dialogue: 5,0:01:21.81,0:01:24.14,Main-207+,,0,0,0,,Daha fazla tartışmayı kaldıramam.Dialogue: 5,0:01:25.69,0:01:28.00,Main-207+,,0,0,0,,Düzeltemeyeceğiniz şeyler için münakaşa etmeyin.Dialogue: 5,0:01:28.00,0:01:31.61,Main-207+,,0,0,0,,Nami-san ! Ama bu aptal...Dialogue: 5,0:01:35.09,0:01:39.07,Main-207+,,0,0,0,,Chopper, yoksa  Usopp'un peşinden mi gittin?Dialogue: 5,0:01:42.00,0:01:46.83,Main-207+,,0,0,0,,Onu tedavi etmeye devam etmek istedim ama beni geri çevirdi.Dialogue: 5,0:01:47.74,0:01:51.07,Main-207+,,0,0,0,,Usopp şehirde bir oda tutmuş.Dialogue: 5,0:01:51.95,0:01:53.76,Main-207+,,0,0,0,,Dedi ki biz...Dialogue: 5,0:01:54.33,0:01:59.76,Main-207+,,0,0,0,,Dedi ki biz artık arkadaş değilmişiz ve gemiye geri dönmeliymişim!Dialogue: 5,0:02:04.21,0:02:07.64,Main-207+,,0,0,0,,Sanki bu sabaha kadar yaşamış olduğumuz eğlenceli zamanlar hiç olmamış gibi.Dialogue: 5,0:02:11.10,0:02:15.07,Main-207+,,0,0,0,,Robin'e ne olduğunu da bilmiyoruz.Dialogue: 5,0:02:15.55,0:02:18.03,Main-207+,,0,0,0,,Neredeyse tayfa...Dialogue: 5,0:02:18.03,0:02:20.69,Main-207+,,0,0,0,,...parçalanıyor gibi.Dialogue: 5,0:02:27.11,0:02:31.08,Main-207+,,0,0,0,,Saat 10. Usopp yoldadır.Dialogue: 5,0:02:40.65,0:02:43.76,Main-207+,,0,0,0,,Siz gemide kalın ve aşağı inmeyin!Dialogue: 5,0:02:43.76,0:02:45.03,Main-207+,,0,0,0,,Anlaşıldı mı?Dialogue: 5,0:02:51.83,0:02:54.60,Main-207+,,0,0,0,,– Geldi! – Usopp!Dialogue: 5,0:03:17.70,0:03:20.02,Main-207+,,0,0,0,,İçinde korkaklığın kırıntısı bile olmadan geldin.Dialogue: 5,0:03:20.02,0:03:22.93,Main-207+,,0,0,0,,Ne olursa olsun, pişman olamazsın!Dialogue: 5,0:03:22.93,0:03:25.39,Main-207+,,0,0,0,,Bu düelloyu sen istedin!Dialogue: 5,0:03:25.39,0:03:28.64,Main-207+,,0,0,0,,Elbette. Kendini tutmasan iyi edersin.Dialogue: 5,0:03:28.64,0:03:30.73,Main-207+,,0,0,0,,Durumu senin aleyhine çevireceğim.Dialogue: 5,0:03:30.73,0:03:34.36,Main-207+,,0,0,0,,Seni nasıl yeneceğimi zaten biliyorum!Dialogue: 5,0:03:34.87,0:03:38.36,Main-207+,,0,0,0,,Onları durdurmanın bir yolu yok mu? Usopp gerçekten kötü yaralanmış!Dialogue: 5,0:03:38.36,0:03:40.45,Main-207+,,0,0,0,,İzlemeye dayanamıyorsan alt güverteye in.Dialogue: 5,0:03:41.21,0:03:44.90,Main-207+,,0,0,0,,Ben yeteneğin hakkında hiçbir şey bilmeyen düşmanlara benzemem.Dialogue: 5,0:03:44.90,0:03:48.85,Main-207+,,0,0,0,,Seni uzun zamandır tanıyorum, Luffy.Dialogue: 5,0:03:49.40,0:03:52.42,Main-207+,,0,0,0,,Bu süre zarfında, yeteneğinle ilgili her şeyi öğrendim.Dialogue: 5,0:05:45.13,0:05:47.49,Main-207+,,0,0,0,,Duyunca şaşırma ama Luffy,...Dialogue: 5,0:05:47.49,0:05:50.37,Main-207+,,0,0,0,,...emrimde 8 bin adamım var!Dialogue: 5,0:05:51.09,0:05:54.79,Main-207+,,0,0,0,,Hayatına değer veriyorsan, hemen teslim ol!Dialogue: 5,0:05:55.12,0:05:57.91,Main-207+,,0,0,0,,NE?! Sekiz bin mi?!Dialogue: 5,0:05:57.91,0:05:59.54,Main-207+,,0,0,0,,Alt güverteye insene sen.Dialogue: 5,0:05:59.54,0:06:02.59,Main-207+,,0,0,0,,O kadar adamın olmadığını biliyorum!Dialogue: 5,0:06:02.59,0:06:05.13,Main-207+,,0,0,0,,Usopp Büyüsü!Dialogue: 5,0:06:05.13,0:06:08.72,Main-207+,,0,0,0,,Dişlerinin arasına gömülmüş jiletler!Dialogue: 5,0:06:09.69,0:06:12.00,Main-207+,,0,0,0,,Ahh! Düşünmesi bile acı veriyor!Dialogue: 5,0:06:12.00,0:06:13.51,Main-207+,,0,0,0,,İn artık alt güverteye.Dialogue: 5,0:06:13.51,0:06:16.64,Main-207+,,0,0,0,,Tırnaklarının altına saplanmış kaktüs iğneleri!Dialogue: 5,0:06:18.06,0:06:21.52,Main-207+,,0,0,0,,Gomu Gomu no Pistol!Dialogue: 5,0:06:18.06,0:06:21.52,Attack,,0,0,0,,Lastik-Lastik TabancaDialogue: 5,0:06:26.90,0:06:28.24,Main-207+,,0,0,0,,Usopp!Dialogue: 5,0:06:29.69,0:06:32.20,Main-207+,,0,0,0,,Bak! Vücudu bunu kaldıramıyor!Dialogue: 5,0:06:33.85,0:06:36.66,Main-207+,,0,0,0,,Hissatsu... Ketchup Boshi!Dialogue: 5,0:06:33.85,0:06:36.66,Attack,,0,0,0,,Kesin Öldürücü Ketçap Yıldızı!Dialogue: 5,0:06:37.20,0:06:41.75,Main-207+,,0,0,0,,Ne oldu? Düşmanına merhamet mi ediyorsun? Bunu ciddiye almamalısın!Dialogue: 5,0:06:41.75,0:06:43.09,Main-207+,,0,0,0,,Flaş Dial!Dialogue: 5,0:06:48.65,0:06:50.72,Main-207+,,0,0,0,,Hissatsu Tamago Boshi!Dialogue: 5,0:06:48.65,0:06:50.72,Attack,,0,0,0,,Kesin Öldürücü Yumurta YıldızıDialogue: 5,0:06:52.89,0:06:55.14,Main-207+,,0,0,0,,Yıldız! Yıldız! Yıldız!Dialogue: 5,0:06:57.98,0:06:59.69,Main-207+,,0,0,0,,Kokuyor! Çürümüşler!Dialogue: 5,0:07:00.05,0:07:03.10,Main-207+,,0,0,0,,Kahretsin, seni pislik! Benimle oynayarak dövüşme!Dialogue: 5,0:07:03.10,0:07:06.03,Main-207+,,0,0,0,,Dalga geçtiğimi mi sanıyorsun? Ölümüne ciddiyim, Luffy!Dialogue: 5,0:07:06.03,0:07:09.24,Main-207+,,0,0,0,,– Ne?  – Ben böyle dövüşürüm!Dialogue: 5,0:07:09.69,0:07:12.24,Main-207+,,0,0,0,,Bak! Ağzın bir karış açıkken seni yakacağım!Dialogue: 5,0:07:16.33,0:07:18.75,Main-207+,,0,0,0,,Hissatsu Tabasco Boshi!Dialogue: 5,0:07:16.33,0:07:18.75,Attack,,0,0,0,,Kesin Öldürücü Tabasco YıldızıDialogue: 5,0:07:18.75,0:07:21.71,Main-207+,,0,0,0,,YANIYOR!Dialogue: 5,0:07:22.02,0:07:24.67,Main-207+,,0,0,0,,Geri çekilirken dikkatli ol!Dialogue: 5,0:07:24.67,0:07:28.01,Main-207+,,0,0,0,,Her tarafına demirdiken yerleştirdim!Dialogue: 5,0:07:29.84,0:07:31.30,Main-207+,,0,0,0,,Aaaaah!Dialogue: 5,0:07:32.22,0:07:33.76,Main-207+,,0,0,0,,Dövüşü Usopp kontrol ediyor!Dialogue: 0,0:07:34.76,0:07:40.02,Author,,0,0,0,,TR: onepacetr.net | kazaskerDialogue: 0,0:19:10.50,0:19:13.50,Author,,0,0,0,,TR: onepacetr.net | kazaskerDialogue: 0,0:07:34.76,0:07:40.02,Title,,0,0,0,,Luffy, Usopp'a KarşıDialogue: 5,0:07:34.64,0:07:36.60,Main-207+,,0,0,0,,Dinle, Luffy!Dialogue: 5,0:07:36.60,0:07:40.02,Main-207+,,0,0,0,,Seni yenip Merry'yi alacağıma yemin ettim!Dialogue: 5,0:07:40.02,0:07:42.02,Main-207+,,0,0,0,,Kazanmak için ne gerekirse yapacağım!Dialogue: 5,0:07:43.27,0:07:45.02,Main-207+,,0,0,0,,Hissatsu Koshou Boshi!Dialogue: 5,0:07:43.27,0:07:45.02,Attack,,0,0,0,,Kesin Öldürücü Karabiber YıldızıDialogue: 5,0:07:47.19,0:07:48.99,Main-207+,,0,0,0,,Ahhh!Dialogue: 5,0:07:56.27,0:07:59.66,Main-207+,,0,0,0,,Dediğimi unutma! Sana karşı işe yaramaz saldırılar kullanmıyorum!Dialogue: 5,0:08:03.69,0:08:08.84,Main-207+,,0,0,0,,Kahretsin! Kokuyor, yanıyor...Dialogue: 5,0:08:08.84,0:08:10.34,Main-207+,,0,0,0,,...ve acıyor!Dialogue: 5,0:08:10.73,0:08:12.50,Main-207+,,0,0,0,,Kendine gelmen için bir an bile vermeyeceğim!Dialogue: 5,0:08:12.50,0:08:14.79,Main-207+,,0,0,0,,Hissatsu Shuriken Ryuuseigun!Dialogue: 5,0:08:12.50,0:08:14.79,Attack,,0,0,0,,Kesin Öldürücü Shuriken Meteor YağmuruDialogue: 5,0:08:58.68,0:08:59.60,Main-207+,,0,0,0,,Duman?Dialogue: 5,0:09:02.70,0:09:04.38,Main-207+,,0,0,0,,Nefes Dial'ı.Dialogue: 5,0:09:06.41,0:09:09.52,Main-207+,,0,0,0,,Çürük yumurta yüzünden kokusunu alamadın...Dialogue: 5,0:09:13.78,0:09:16.74,Main-207+,,0,0,0,,...ama o bölge tamamen gaz dolu!Dialogue: 5,0:09:17.46,0:09:18.41,Main-207+,,0,0,0,,Gaz mı?Dialogue: 5,0:09:18.41,0:09:19.78,Main-207+,,0,0,0,,Yoksa...Dialogue: 5,0:09:20.50,0:09:22.04,Main-207+,,0,0,0,,Üzgünüm. İşte geliyor!Dialogue: 5,0:09:22.60,0:09:24.25,Main-207+,,0,0,0,,Kaen Boshi!Dialogue: 5,0:09:22.60,0:09:24.25,Attack,,0,0,0,,Alev YıldızıDialogue: 5,0:09:37.01,0:09:38.80,Main-207+,,0,0,0,,Çok büyük bir patlama!Dialogue: 5,0:09:45.85,0:09:47.69,Main-207+,,0,0,0,,Luffy! Usopp!Dialogue: 5,0:09:58.71,0:10:03.41,Flashbacks-720p,,0,0,0,,Ben, bu köye hükmeden büyük korsan tayfasının lideri, Usopp'um!Dialogue: 5,0:10:03.41,0:10:09.79,Flashbacks-720p,,0,0,0,,İnsanlar beni övüyorlar ve bana,  "Sevgili Kaptan Usopp" der!Dialogue: 5,0:10:18.76,0:10:20.34,Flashbacks-720p,,0,0,0,,Epey komiksin!Dialogue: 5,0:10:20.88,0:10:23.34,Flashbacks-720p,,0,0,0,,Hey, seni pislik! Bana gülme!Dialogue: 5,0:10:23.34,0:10:24.56,Flashbacks-720p,,0,0,0,,Niye?Dialogue: 5,0:10:24.56,0:10:27.27,Flashbacks-720p,,0,0,0,,Artık arkadaşız, değil mi?Dialogue: 5,0:10:31.11,0:10:33.74,Flashbacks-720p,,0,0,0,,Kara göründü!Dialogue: 5,0:10:33.74,0:10:37.07,Flashbacks-720p,,0,0,0,,Oooo, süper! Bu ne tür bir ada böyle?!Dialogue: 5,0:10:37.07,0:10:39.41,Flashbacks-720p,,0,0,0,,Evet, işte gidiyoruz!Dialogue: 5,0:10:39.41,0:10:42.50,Flashbacks-720p,,0,0,0,,Merry, tam yol ileri!Dialogue: 5,0:10:42.50,0:10:44.95,Flashbacks-720p,,0,0,0,,Tam yol ileri!Dialogue: 5,0:11:15.27,0:11:17.03,Main-207+,,0,0,0,,Bunu izlemek çok zor.Dialogue: 5,0:11:17.03,0:11:20.13,Main-207+,,0,0,0,,Luffy! Usopp!Dialogue: 5,0:11:37.10,0:11:41.76,Main-207+,,0,0,0,,Biliyorum. Bu seni yenmeye yetmez.Dialogue: 5,0:11:41.76,0:11:43.59,Main-207+,,0,0,0,,Biliyorum, Luffy!Dialogue: 5,0:11:44.30,0:11:47.70,Main-207+,,0,0,0,,Dövüşlerinde sonuna kadar dövüşürsün!Dialogue: 5,0:11:49.42,0:11:52.07,Main-207+,,0,0,0,,Ama yeteneğin hakkındaki her şeyi biliyorum!Dialogue: 5,0:11:56.44,0:11:57.73,Main-207+,,0,0,0,,Hissatsu...!Dialogue: 5,0:11:56.44,0:11:57.73,Attack,,0,0,0,,Kesin ÖldürücüDialogue: 5,0:11:57.73,0:12:01.49,Main-207+,,0,0,0,,Gomu Gomu no Gatling!Dialogue: 5,0:11:57.73,0:12:01.49,Attack,,0,0,0,,Lastik Lastik MitralyözDialogue: 5,0:12:01.49,0:12:03.70,Main-207+,,0,0,0,,Sakuretsu Saboten Boshi!Dialogue: 5,0:12:01.49,0:12:03.70,Attack,,0,0,0,,Patlayan Kaktüs YıldızıDialogue: 5,0:12:10.41,0:12:12.12,Main-207+,,0,0,0,,Ahhh!Dialogue: 5,0:12:14.30,0:12:16.09,Main-207+,,0,0,0,,Sanren Kayaku Boshi!Dialogue: 5,0:12:14.30,0:12:16.09,Attack,,0,0,0,,Üçlü Barut YıldızıDialogue: 5,0:12:30.56,0:12:33.69,Main-207+,,0,0,0,,Gomu Gomu no Pistol!Dialogue: 5,0:12:30.56,0:12:33.69,Attack,,0,0,0,,Lastik-Lastik TabancaDialogue: 5,0:12:45.99,0:12:51.08,Main-207+,,0,0,0,,Gomu Gomu no Bazooka!Dialogue: 5,0:12:45.99,0:12:51.08,Attack,,0,0,0,,Lastik-Lastik BazukaDialogue: 5,0:12:56.21,0:12:58.50,Main-207+,,0,0,0,,Başka bir dial.Dialogue: 5,0:12:58.50,0:13:02.09,Main-207+,,0,0,0,,Saldırını emdim!Dialogue: 5,0:13:03.76,0:13:05.09,Main-207+,,0,0,0,,Impact!Dialogue: 5,0:13:03.76,0:13:05.09,Attack,,0,0,0,,DarbeDialogue: 5,0:13:10.68,0:13:12.35,Main-207+,,0,0,0,,Darbe Dial'ı!Dialogue: 5,0:13:20.07,0:13:22.99,Main-207+,,0,0,0,,Bu nasıldı, lanet olası?!Dialogue: 5,0:13:51.79,0:13:58.06,Flashbacks-720p,,0,0,0,,Ben, bu köye hükmeden büyük korsan tayfasının lideri, Usopp'um!Dialogue: 5,0:14:03.29,0:14:05.65,Flashbacks-720p,,0,0,0,,Yeni gemimize ve arkadaşımıza!Dialogue: 5,0:14:05.65,0:14:08.66,Flashbacks-720p,,0,0,0,,Şerefe!Dialogue: 5,0:14:11.01,0:14:12.10,Flashbacks-720p,,0,0,0,,Bu nasıl?Dialogue: 5,0:14:12.10,0:14:14.33,Flashbacks-720p,,0,0,0,,İyi görünüyor!  Aynısından yelkene de yap!Dialogue: 5,0:14:14.74,0:14:16.21,Flashbacks-720p,,0,0,0,,Evet, tamamlandı!Dialogue: 5,0:14:16.21,0:14:20.54,Flashbacks-720p,,0,0,0,,Korsan gemimiz  Going Merry yola çıkmaya hazır!Dialogue: 5,0:14:21.70,0:14:25.55,Main-207+,,0,0,0,,Gomu Gomu no...Dialogue: 5,0:14:25.55,0:14:27.73,Main-207+,,0,0,0,,Bullet!Dialogue: 5,0:14:25.55,0:14:27.73,Attack,,0,0,0,,MermiDialogue: 5,0:14:37.70,0:14:39.77,Main-207+,,0,0,0,,Usopp!Dialogue: 5,0:15:07.60,0:15:09.13,Main-207+,,0,0,0,,Dövüş bitti.Dialogue: 5,0:15:23.61,0:15:25.18,Main-207+,,0,0,0,,Seni sersem!Dialogue: 5,0:15:27.40,0:15:32.21,Main-207+,,0,0,0,,Beni yenemeyeceğini biliyordun!Dialogue: 5,0:15:58.86,0:16:01.21,Main-207+,,0,0,0,,Hayır... Lütfen, hayır...Dialogue: 5,0:16:10.81,0:16:13.78,Main-207+,,0,0,0,,Merry'yle ne istersen yap.Dialogue: 5,0:16:17.30,0:16:22.93,Main-207+,,0,0,0,,Yeni bir gemi alıp yolculuğumuza devam ediyoruz.Dialogue: 5,0:16:24.21,0:16:26.20,Flashbacks-720p,,0,0,0,,Hey, bana da izin ver, Luffy!Dialogue: 5,0:16:26.20,0:16:29.17,Flashbacks-720p,,0,0,0,,Hayır! Bu benim özel koltuğum!Dialogue: 5,0:16:29.17,0:16:31.10,Flashbacks-720p,,0,0,0,,Oh, o da ne?Dialogue: 5,0:16:31.10,0:16:32.67,Flashbacks-720p,,0,0,0,,Ne yapıyorsun, Usopp?Dialogue: 5,0:16:32.67,0:16:37.09,Flashbacks-720p,,0,0,0,,Hey, dur orada!  Usopp Atölyesi'nin sınırları kesindir!Dialogue: 5,0:16:46.80,0:16:50.36,Flashbacks-720p,,0,0,0,,Bir gün Elbaf'ı göreceğiz!Dialogue: 5,0:16:50.36,0:16:52.99,Flashbacks-720p,,0,0,0,,Savaşçıların Köyü'ne gideceğiz!Dialogue: 5,0:16:52.99,0:16:56.99,Flashbacks-720p,,0,0,0,,Evet, Usopp!  Ne olursa olsun oraya gideceğiz!Dialogue: 5,0:16:57.42,0:17:02.47,Flashbacks-720p,,0,0,0,,Haydi binin, haydi binin! Bu, Altın Festivali Arifesi!Dialogue: 5,0:17:12.41,0:17:14.30,Main-207+,,0,0,0,,Görüşürüz, Usopp.Dialogue: 5,0:17:15.16,0:17:18.04,Main-207+,,0,0,0,,Şu ana dek çok eğlendik.Dialogue: 5,0:17:22.85,0:17:24.77,Main-207+,,0,0,0,,Hey! Gitme, Chopper!Dialogue: 5,0:17:26.06,0:17:31.48,Main-207+,,0,0,0,,Niye?! Zaten yaralıydı ve bu son vuruşla...Dialogue: 5,0:17:32.66,0:17:34.41,Main-207+,,0,0,0,,Dövüş oyun değildir!Dialogue: 5,0:17:34.41,0:17:39.03,Main-207+,,0,0,0,,Ne olmuş?! Ben doktorum!  Bırak onu tedavi edeyim!Dialogue: 5,0:17:43.66,0:17:47.39,Main-207+,,0,0,0,,Düelloyu kaybetti. Bir de ona acırsak kendisini...Dialogue: 5,0:17:47.39,0:17:49.67,Main-207+,,0,0,0,,...ne kadar çaresiz  hissedeceğini farketmiyor musun?Dialogue: 5,0:17:52.24,0:17:57.39,Main-207+,,0,0,0,,Yersiz iyiliğin,  yenilgisini daha da kötüleştirirdi!Dialogue: 5,0:17:58.20,0:18:02.81,Main-207+,,0,0,0,,Dövüşmeden önce kendisini bunun için hazırladı.Dialogue: 5,0:18:15.30,0:18:16.90,Main-207+,,0,0,0,,Çok zor.Dialogue: 5,0:18:18.30,0:18:20.45,Main-207+,,0,0,0,,Kaptan olarak omuzlarındaki yük bu.Dialogue: 5,0:18:21.40,0:18:23.41,Main-207+,,0,0,0,,Tereddüte düşme!Dialogue: 5,0:18:26.01,0:18:31.16,Main-207+,,0,0,0,,Tereddüte düşersen, kime inanmamız gerekir?Dialogue: 5,0:18:43.19,0:18:45.02,Main-207+,,0,0,0,,Gemiyi onun için hazırlayalım.Dialogue: 5,0:18:55.57,0:19:01.61,Main-207+,,0,0,0,,Bu onu, son görüşümüz olacak.Dialogue: 0,0:04:20.68,0:04:26.26,Credits,,0,0,0,,Video Editing    Galaxy 9000Dialogue: 1,0:04:20.68,0:04:26.26,Credits,,0,0,0,,Video Editing    Galaxy 9000Dialogue: 0,0:04:26.97,0:04:31.44,Credits,,0,0,0,,Graphics     DatenshiDialogue: 1,0:04:26.97,0:04:31.44,Credits,,0,0,0,,Graphics     DatenshiDialogue: 0,0:04:31.56,0:04:35.44,Credits,,0,0,0,,Karaoke    KaitouYahikoDialogue: 1,0:04:31.56,0:04:35.44,Credits,,0,0,0,,Karaoke    KaitouYahikoDialogue: 0,0:04:36.94,0:04:41.57,Credits,,0,0,0,,Quality Control    Feeso   JT-421   PepperjackDialogue: 1,0:04:36.94,0:04:41.57,Credits,,0,0,0,,Quality Control    Feeso   JT-421   PepperjackDialogue: 0,0:04:49.50,0:04:56.88,Credits,,0,0,0,,Soundtracking                      HaleeDialogue: 1,0:04:49.50,0:04:56.88,Credits,,0,0,0,,Soundtracking                      HaleeDialogue: 0,0:04:56.88,0:05:00.88,Credits,,0,0,0,,Timing    PhosCityDialogue: 1,0:04:56.88,0:05:00.88,Credits,,0,0,0,,Timing    PhosCityDialogue: 0,0:05:29.54,0:05:33.25,Credits,,0,0,0,,Subtitle Editing     ZenefDialogue: 1,0:05:29.54,0:05:33.25,Credits,,0,0,0,,Subtitle Editing     ZenefDialogue: 0,0:05:33.37,0:05:37.54,Credits,,0,0,0,,Translation     Crunchyroll    GaijinDialogue: 1,0:05:33.37,0:05:37.54,Credits,,0,0,0,,Translation     Crunchyroll    GaijinDialogue: 0,0:03:58.43,0:04:02.49,Lyrics-OP5,,0,0,0,,♪ Sorun yok! Yola çıkalım! ♪Dialogue: 0,0:04:02.75,0:04:06.03,Lyrics-OP5,,0,0,0,,♪ Güneşi hep kalbimizde tutacağız! ♪Dialogue: 0,0:04:06.17,0:04:09.45,Lyrics-OP5,,0,0,0,,♪ Birleşmiş ellerimiz bize güç veriyor! ♪Dialogue: 0,0:04:09.54,0:04:13.12,Lyrics-OP5,,0,0,0,,♪ Hayallerimizi yakalayacağız! ♪Dialogue: 0,0:04:20.68,0:04:26.93,Lyrics-OP5,,0,0,0,,♪ Birleşmiş güçlerimizle dev bir dalgaya bineceğiz. ♪Dialogue: 0,0:04:28.19,0:04:34.73,Lyrics-OP5,,0,0,1,,♪ İşte işaret! Başarıya doğru acele edelim! ♪Dialogue: 0,0:04:35.40,0:04:41.57,Lyrics-OP5,,0,0,0,,♪ Bu bizim yola çıkma vaktimiz. Bir kez demir alınca...Dialogue: 0,0:04:42.37,0:04:49.45,Lyrics-OP5,,0,0,0,,...gökkuşağı renkli rüzgarla macera denizine doğru yola çıkacağız! ♪Dialogue: 0,0:04:49.50,0:04:52.99,Lyrics-OP5,,0,0,0,,♪ Bu sıkıntıyla dolu bir yolculuk...Dialogue: 0,0:04:53.00,0:04:56.71,Lyrics-OP5,,0,0,0,,...ama orada önemli bir şey var. ♪Dialogue: 0,0:04:56.84,0:05:00.79,Lyrics-OP5,,0,0,0,,♪ Başın derde girerse,...Dialogue: 0,0:05:00.89,0:05:02.80,Lyrics-OP5,,0,0,0,,...yardım etmek için orada olacağım! ♪Dialogue: 0,0:05:03.89,0:05:07.80,Lyrics-OP5,,0,0,0,,♪ Sorun yok! Yola çıkalım! ♪Dialogue: 0,0:05:08.10,0:05:11.26,Lyrics-OP5,,0,0,0,,♪ Güneşi hep kalbimizde tutacağız! ♪Dialogue: 0,0:05:11.61,0:05:14.77,Lyrics-OP5,,0,0,0,,♪ Bir fırtına gelirse omzunu benimkine yasla. ♪Dialogue: 0,0:05:14.81,0:05:18.64,Lyrics-OP5,,0,0,0,,♪ İlerideki umut ışığına bakacağız! ♪Dialogue: 0,0:05:19.11,0:05:22.36,Lyrics-OP5,,0,0,0,,♪ Hayallerimizin parçalarını toplarken,...Dialogue: 0,0:05:22.83,0:05:25.99,Lyrics-OP5,,0,0,0,,...bize yarının yolunu gösterecekler! ♪Dialogue: 0,0:05:26.12,0:05:29.16,Lyrics-OP5,,0,0,0,,♪ Bu yüzden aynı bayrak altında yolculuk ediyoruz. ♪Dialogue: 0,0:05:29.54,0:05:32.80,Lyrics-OP5,,0,0,0,,♪ Hayallerimizi yakalayacağız! ♪Dialogue: 0,0:05:32.83,0:05:34.89,Lyrics-OP5,,0,0,0,,♪ Biz birleşmişiz...Dialogue: 0,0:19:13.70,0:19:18.30,Captions,,0,0,0,,Bu bölüm, Bastia'ya adanmıştır.Dialogue: 0,0:19:37.90,0:19:47.33,Lyrics-OP5,,0,0,0,karaoke,♪ O gün, hayalperest benliğimizin yanlış olmadığına inandık ♪Dialogue: 0,0:19:47.37,0:19:55.92,Lyrics-OP5,,0,0,0,karaoke,♪ Ve zor denizleri aşabileceğimize inandık ♪Dialogue: 0,0:19:56.43,0:20:05.63,Lyrics-OP5,,0,0,0,karaoke,♪ Sen herkesten daha cesur ve düşünceliydin, ama... ♪Dialogue: 0,0:20:05.94,0:20:16.00,Lyrics-OP5,,0,0,0,karaoke,♪ Eğer bu gemiyi terk edip başka bir dünyaya düşersen bile ♪Dialogue: 0,0:20:16.06,0:20:24.43,Lyrics-OP5,,0,0,0,karaoke,♪ Sonunda hep birlikte gülümseyebileceğimize eminim ♪