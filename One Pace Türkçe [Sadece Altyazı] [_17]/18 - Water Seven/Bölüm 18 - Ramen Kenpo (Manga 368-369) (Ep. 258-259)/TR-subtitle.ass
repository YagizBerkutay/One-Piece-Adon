,15,15,1Style: CaptionsSniper,Futura Md BT,38.0,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1.5,0,2,10,10,20,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 50,0:00:19.37,0:00:22.84,Lyrics-OP5,,0,0,33,,♪ Keskin Nişancı adasında...Dialogue: 50,0:00:22.92,0:00:26.42,Lyrics-OP5,,0,0,33,,...doğdum. ♪Dialogue: 50,0:00:26.63,0:00:30.26,Lyrics-OP5,,0,0,33,,♪ 100 atış, 100 isabet. ♪Dialogue: 50,0:00:30.34,0:00:32.89,Lyrics-OP5,,0,0,33,,♪ Lulu lala lu ~ ♪Dialogue: 50,0:00:33.68,0:00:35.18,Lyrics-OP5,,0,0,33,,♪ Bir farenin göz bebeğine...Dialogue: 50,0:00:35.27,0:00:37.02,Lyrics-OP5,,0,0,33,,...kilitlen! ♪Dialogue: 50,0:00:37.06,0:00:38.89,Lyrics-OP5,,0,0,33,,♪ Kalbine...Dialogue: 50,0:00:39.52,0:00:43.73,Lyrics-OP5,,0,0,33,,...kilitlen!! ♪Dialogue: 50,0:00:43.86,0:00:50.66,Lyrics-OP5,,0,0,33,,♪ Keskin Nişancı adasından gelen adam. ♪Dialogue: 50,0:00:50.70,0:00:54.03,Lyrics-OP5,,0,0,33,,♪ Lululu, lulu lala ♪Dialogue: 50,0:00:54.12,0:00:59.25,Lyrics-OP5,,0,0,33,,♪ Kaçsanız iyi olur... ♪Dialogue: 50,0:01:00.87,0:01:02.25,Lyrics-OP5,,0,0,33,,♪ Sogege, soge, soge ♪Dialogue: 50,0:01:02.38,0:01:08.30,Lyrics-OP5,,0,0,33,,♪ Sogeking! ♪Dialogue: 50,0:01:13.01,0:01:16.93,Lyrics-OP5,,0,0,0,,♪ Keskin Nişancı adasında...Dialogue: 50,0:01:16.93,0:01:21.10,Lyrics-OP5,,0,0,0,,...doğdum. ♪Dialogue: 50,0:01:21.10,0:01:25.23,Lyrics-OP5,,0,0,0,,♪ 100 atış, 100 isabet. ♪Dialogue: 50,0:01:25.23,0:01:28.82,Lyrics-OP5,,0,0,0,,♪ Lulu lala lu ♪Dialogue: 50,0:01:28.82,0:01:32.53,Lyrics-OP5,,0,0,0,,♪ Bir farenin göz bebeğine kilitlen! ♪Dialogue: 50,0:01:32.53,0:01:38.54,Lyrics-OP5,,0,0,0,,♪ Kalbine kilitlen!! ♪Dialogue: 50,0:01:38.54,0:01:46.63,Lyrics-OP5,,0,0,0,,♪ Keskin Nişancı adasından gelen adam. ♪Dialogue: 50,0:01:28.82,0:01:31.15,Main-207+,,0,0,0,,Ne yapıyor bu?Dialogue: 50,0:01:31.15,0:01:33.95,Main-207+,,0,0,0,,Şey, hislerini incitme.Dialogue: 50,0:01:33.95,0:01:39.50,Main-207+,,0,0,0,,Sanırım arkadaşını doğrudan kurtaramayacağını düşünüyor.Dialogue: 50,0:01:42.21,0:01:44.33,Main-207+,,0,0,0,,Ne sinir bozucu bir karar.Dialogue: 50,0:01:45.08,0:01:46.63,Main-207+,,0,0,0,,Hey! Buraya gel!Dialogue: 50,0:01:46.63,0:01:47.80,Main-207+,,0,0,0,,Ah, tamam.Dialogue: 50,0:01:53.38,0:01:57.35,Main-207+,,0,0,0,,Tamam. O zaman "Robin-chan'ı kurtarma" görevini yerine getireceğiz.Dialogue: 50,0:01:57.35,0:02:01.35,Main-207+,,0,0,0,,Beyler, ilk karşılaşmamız olduğuna göre soracağınız soru var mı?Dialogue: 50,0:02:01.73,0:02:06.81,Main-207+,,0,0,0,,Öncelikle siz 6. vagondaydınız. 5 vagon kaldı.Dialogue: 50,0:02:07.44,0:02:09.57,Main-207+,,0,0,0,,Mesela keskin nişancılar adasının  nerede olduğu gibi.Dialogue: 50,0:02:09.57,0:02:11.53,Main-207+,,0,0,0,,Robin-chan, onlardan birinde.Dialogue: 50,0:02:11.53,0:02:14.32,Main-207+,,0,0,0,,Kalbinizde!Dialogue: 50,0:02:15.16,0:02:17.91,Main-207+,,0,0,0,,Ama şimdilik, güçlü müsün?Dialogue: 50,0:02:17.91,0:02:20.29,Main-207+,,0,0,0,,Süper güçlüyüm! Aptal!Dialogue: 50,0:02:20.29,0:02:22.04,Main-207+,,0,0,0,,Bu haftaki ben, özellikle güçlü!Dialogue: 50,0:02:22.04,0:02:26.08,Main-207+,,0,0,0,,Robin-chan'ı kurtarınca her şey sona erecek.Dialogue: 50,0:02:26.08,0:02:27.75,Main-207+,,0,0,0,,Ama çok sayıda düşman var.Dialogue: 50,0:02:27.75,0:02:31.92,Main-207+,,0,0,0,,Dikkatsizce ilerleseydik ve etrafımız sarılsaydı, epey sorun olurdu.Dialogue: 50,0:02:31.92,0:02:37.85,Main-207+,,0,0,0,,Gereksiz dövüşlerden kaçınmak ve ana gücü ezerek ilerlemek iyi bir plan.Dialogue: 50,0:02:37.85,0:02:40.43,Main-207+,,0,0,0,,İyice dinleyin.Dialogue: 50,0:02:43.35,0:02:46.56,Main-207+,,0,0,0,,Tamam. Dövüş için hazırım!Dialogue: 50,0:02:47.86,0:02:48.73,Main-207+,,0,0,0,,Sorun nedir?Dialogue: 50,0:02:48.73,0:02:50.32,Main-207+,,0,0,0,,Ne olduğunu sanıyorsun?!Dialogue: 50,0:02:50.32,0:02:54.70,Main-207+,,0,0,0,,Niye utanmadan burada üstünü değiştiriyorsun, seni şıllık?!Dialogue: 50,0:02:54.70,0:02:57.07,Main-207+,,0,0,0,,– Güzel bir utanmazlık. – Güzel bir utanmazlık.Dialogue: 50,0:02:58.57,0:03:01.58,Main-207+,,0,0,0,,Ne yapayım?  Sadece tek vagonumuz var.Dialogue: 50,0:03:01.58,0:03:04.29,Main-207+,,0,0,0,,Göbeğini ört! Göbeğini ve belini!Dialogue: 50,0:03:04.29,0:03:05.83,Main-207+,,0,0,0,,Siz de, Kareler!Dialogue: 50,0:03:05.83,0:03:09.46,Main-207+,,0,0,0,,Toplumu çökerten sizsiniz!Dialogue: 50,0:03:09.46,0:03:11.46,Main-207+,,0,0,0,,Çok gürültü yapıyorsun, utangaç herif!Dialogue: 50,0:03:11.46,0:03:12.80,Main-207+,,0,0,0,,Utangaç herif.Dialogue: 50,0:03:12.80,0:03:14.01,Main-207+,,0,0,0,,Sizi...Dialogue: 50,0:03:14.59,0:03:15.51,Main-207+,,0,0,0,,Kahretsin.Dialogue: 50,0:03:18.14,0:03:22.52,Main-207+,,0,0,0,,Şu siyah pantolonun cepleri var ama niye daha büyük değil?Dialogue: 50,0:03:22.52,0:03:24.27,Main-207+,,0,0,0,,Ceplerini etle doldurma!Dialogue: 50,0:03:24.77,0:03:27.48,Main-207+,,0,0,0,,Ciddi bir motivasyonunuz var.Dialogue: 50,0:03:27.48,0:03:30.02,Main-207+,,0,0,0,,Çok istekli görünüyorsunuz.Dialogue: 50,0:03:30.02,0:03:31.23,Main-207+,,0,0,0,,Elbette!Dialogue: 50,0:03:31.23,0:03:33.23,Main-207+,,0,0,0,,Sonuçta Robin'i kurtaracağız!Dialogue: 50,0:03:33.23,0:03:36.40,Main-207+,,0,0,0,,Bu kez kesinlikle onların canına okuyacağım!Dialogue: 50,0:03:36.40,0:03:37.99,Main-207+,,0,0,0,,Elbette yapacaksın!Dialogue: 50,0:03:37.99,0:03:41.37,Main-207+,,0,0,0,,Yine sıkışırsan seni affetmeyeceğim!Dialogue: 50,0:03:41.74,0:03:42.66,Main-207+,,0,0,0,,Sorun değil!Dialogue: 50,0:03:42.66,0:03:45.46,Main-207+,,0,0,0,,Bu kez yenilmemek için sebebim var!Dialogue: 50,0:03:45.46,0:03:47.21,Main-207+,,0,0,0,,Sebep mi?Dialogue: 50,0:03:47.21,0:03:49.29,Main-207+,,0,0,0,,Nami, silahını mı değiştirdin?Dialogue: 50,0:03:50.38,0:03:51.46,Main-207+,,0,0,0,,Hayır.Dialogue: 50,0:03:52.00,0:03:54.12,Main-207+,,0,0,0,,Gökyüzü Adası'ndan geldikten sonra,...Dialogue: 50,0:03:54.14,0:03:58.13,Main-207+,,0,0,0,,...Usopp, silahımı daha da güçlendirmek için kadranları kullandı.Dialogue: 50,0:03:58.13,0:04:00.05,Main-207+,,0,0,0,,Bu, Mükemmel İklim Aygıtı.Dialogue: 50,0:04:00.51,0:04:02.43,Main-207+,,0,0,0,,Anlıyorum. Usopp'un...Dialogue: 50,0:04:02.43,0:04:04.64,Main-207+,,0,0,0,,Evet, Usopp'un...Dialogue: 50,0:04:05.85,0:04:08.31,Main-207+,,0,0,0,,...yaptığı son iş.Dialogue: 50,0:04:10.48,0:04:12.32,Main-207+,,0,0,0,,Havayı bozmayın!Dialogue: 50,0:04:22.07,0:04:23.03,Main-207+,,0,0,0,,Hazır mısınız?Dialogue: 50,0:04:23.45,0:04:24.45,Main-207+,,0,0,0,,Gidelim o zaman.Dialogue: 50,0:04:27.08,0:04:28.33,Main-207+,,0,0,0,,Davetsiz misafirler?Dialogue: 50,0:04:28.33,0:04:31.13,Main-207+,,0,0,0,,Evet, durum bu.Dialogue: 50,0:04:31.71,0:04:35.25,Main-207+,,0,0,0,,Hareket halindeyken  Üfleyen Tom'a binmek imkansızdır.Dialogue: 50,0:04:35.25,0:04:37.17,Main-207+,,0,0,0,,Davetsiz misafirler varsa...Dialogue: 50,0:04:37.17,0:04:39.97,Main-207+,,0,0,0,,...kalkış sırasında bindikleri anlamına gelir.Dialogue: 50,0:04:40.34,0:04:41.72,Main-207+,,0,0,0,,Tam bir saçmalık.Dialogue: 50,0:04:43.01,0:04:45.06,Main-207+,,0,0,0,,Haklısınız.  Utanç verici bir durum.Dialogue: 50,0:04:45.56,0:04:49.44,Main-207+,,0,0,0,,Aynı şekilde hareket halindeyken kıyıya çıkmak da imkansızdır.Dialogue: 50,0:04:49.44,0:04:53.44,Main-207+,,0,0,0,,Davetsiz misafirler ve suçlular  hala trende olmalı.Dialogue: 50,0:04:53.77,0:04:55.19,Main-207+,,0,0,0,,Sakin olun ve onları arayın.Dialogue: 50,0:04:55.19,0:04:57.82,Main-207+,,0,0,0,,Emredersiniz!Dialogue: 50,0:05:13.46,0:05:14.42,Main-207+,,0,0,0,,Yüzbaşı T-Bone...Dialogue: 50,0:05:15.00,0:05:17.92,Main-207+,,0,0,0,,Bu dar vagonda kimse saklanamaz.Dialogue: 50,0:05:23.22,0:05:25.01,Main-207+,,0,0,0,,– İyi akşamlar! – İyi akşamlar!Dialogue: 50,0:05:26.26,0:05:27.60,Main-207+,,0,0,0,,– Oradalar! – Oradalar!Dialogue: 50,0:05:27.97,0:05:29.39,Main-207+,,0,0,0,,Kapının diğer tarafındalar!Dialogue: 50,0:05:29.39,0:05:32.02,Main-207+,,0,0,0,,Suçlularla birlikte üç kişi tespit edildi!Dialogue: 50,0:05:32.02,0:05:34.98,Main-207+,,0,0,0,,7. vagondalardı!  Köşeye sıkıştırıp yakalayın!Dialogue: 50,0:05:37.32,0:05:39.94,Main-207+,,0,0,0,,Çekiçle işleme yeteneğin berbat.Dialogue: 50,0:05:39.94,0:05:40.74,Main-207+,,0,0,0,,Kapa çeneni!Dialogue: 50,0:05:41.07,0:05:42.95,Main-207+,,0,0,0,,Aptalca direnişinizden vazgeçin!Dialogue: 50,0:05:42.95,0:05:44.74,Main-207+,,0,0,0,,Kapıyı açın!Dialogue: 50,0:05:46.24,0:05:47.99,Main-207+,,0,0,0,,Bir an önce engelle şunu!Dialogue: 50,0:05:47.99,0:05:48.95,Main-207+,,0,0,0,,T-Tamam.Dialogue: 50,0:05:50.04,0:05:51.08,Main-207+,,0,0,0,,Herkes bu tarafa!Dialogue: 50,0:05:51.08,0:05:53.29,Main-207+,,0,0,0,,7. vagonda şüpheli kimseler tespit edildi!Dialogue: 50,0:05:53.29,0:05:54.21,Main-207+,,0,0,0,,Oradalarmış mı?!Dialogue: 50,0:05:54.21,0:05:56.21,Main-207+,,0,0,0,,3. vagondakilere de söyleyin!Dialogue: 50,0:05:56.21,0:05:58.71,Main-207+,,0,0,0,,Sıkıştırın onları ve  suçlu Franky'yi canlı yakalayın!Dialogue: 50,0:05:58.73,0:06:00.84,Main-207+,,0,0,0,,Kaçacak yer yok! Onları dikkatli yakalayın!Dialogue: 50,0:06:01.42,0:06:03.30,Main-207+,,0,0,0,,Hey! Geri durun!Dialogue: 50,0:06:05.51,0:06:06.93,Main-207+,,0,0,0,,Oha! Ateş etmeye başladılar!Dialogue: 50,0:06:06.93,0:06:08.39,Main-207+,,0,0,0,,Acele et, Soge!Dialogue: 50,0:06:08.39,0:06:10.39,Main-207+,,0,0,0,,Yardım et o zaman!Dialogue: 50,0:06:14.31,0:06:15.81,Main-207+,,0,0,0,,Rasgele ateş etme!Dialogue: 50,0:06:15.81,0:06:16.94,Main-207+,,0,0,0,,Onları öldürürsen kötü olur!Dialogue: 50,0:06:18.52,0:06:19.53,Main-207+,,0,0,0,,Kahretsin.Dialogue: 50,0:06:20.94,0:06:22.49,Main-207+,,0,0,0,,Yüzbaşı T-Bone...Dialogue: 50,0:06:22.49,0:06:24.66,Main-207+,,0,0,0,,Kenara çekilin!Dialogue: 50,0:06:29.91,0:06:32.79,Main-207+,,0,0,0,,Çarpık kılıç oyunlarından nefret ederim.Dialogue: 50,0:06:33.66,0:06:35.88,Main-207+,,0,0,0,,Chokkaku Senkou...Dialogue: 50,0:06:33.66,0:06:35.88,Attack,,0,0,0,,Sağ Açı ParıltısıDialogue: 50,0:06:38.50,0:06:41.01,Main-207+,,0,0,0,,Bone Soir!Dialogue: 50,0:06:38.50,0:06:41.01,Attack,,0,0,0,,Kemik Hava KesimiDialogue: 50,0:06:52.06,0:06:54.06,Main-207+,,0,0,0,,Gi-Gitmişler!Dialogue: 50,0:07:01.44,0:07:02.49,Main-207+,,0,0,0,,Yukarıdalar mı?Dialogue: 50,0:07:10.24,0:07:12.62,Secondary-207+,,0,0,0,,Çabuk, düşman son vagonda!Dialogue: 50,0:07:14.04,0:07:15.87,Main-207+,,0,0,0,,Şimdi! Çabuk!Dialogue: 50,0:07:18.71,0:07:20.17,Main-207+,,0,0,0,,Yoksa...Dialogue: 50,0:07:21.46,0:07:23.92,Main-207+,,0,0,0,,Herkes öndeki vagonlara gitsin!Dialogue: 50,0:07:23.92,0:07:25.63,Main-207+,,0,0,0,,Bu bir tuzak!Dialogue: 50,0:07:25.63,0:07:26.43,Main-207+,,0,0,0,,– Tuzak mı? – Tuzak mı?Dialogue: 50,0:07:27.47,0:07:28.64,Main-207+,,0,0,0,,N-Ne?!Dialogue: 50,0:07:28.64,0:07:30.14,Main-207+,,0,0,0,,Geri dönün! Bu bir tuzak!Dialogue: 50,0:07:30.14,0:07:31.39,Main-207+,,0,0,0,,Ne?!Dialogue: 50,0:07:31.85,0:07:34.35,Main-207+,,0,0,0,,Geri dönelim ama kapı...Dialogue: 50,0:07:34.35,0:07:35.10,Main-207+,,0,0,0,,O da kim?!Dialogue: 50,0:07:37.60,0:07:40.11,Main-207+,,0,0,0,,Vagonu ayırmışlar!Dialogue: 50,0:07:40.82,0:07:42.78,Main-207+,,0,0,0,,– Ne?! – Ne?!Dialogue: 50,0:07:42.78,0:07:45.19,Main-207+,,0,0,0,,Kahretsin! Onlar yapmış!Dialogue: 50,0:07:45.19,0:07:47.11,Main-207+,,0,0,0,,Bunu ödeyeceksiniz!Dialogue: 50,0:07:49.41,0:07:51.20,Main-207+,,0,0,0,,Çok geç.Dialogue: 50,0:07:51.20,0:07:54.29,Main-207+,,0,0,0,,Beyler, Deniz Kralları'ndan sakının ve...Dialogue: 50,0:07:54.29,0:07:55.54,Main-207+,,0,0,0,,...güzel bir yolculuk yapın!Dialogue: 50,0:07:55.54,0:07:58.29,Main-207+,,0,0,0,,Dikkatli olun!Dialogue: 50,0:07:59.92,0:08:04.51,Main-207+,,0,0,0,,O iki vagon ayrılınca,  en az 50 kişi gitmiş oldu.Dialogue: 50,0:08:04.51,0:08:06.13,Main-207+,,0,0,0,,Ama Sanji-kun,...Dialogue: 50,0:08:06.13,0:08:09.76,Main-207+,,0,0,0,,Hasır Şapkalı Luffyler de  bu raylardan gelmeyecek mi?Dialogue: 50,0:08:09.76,0:08:11.93,Main-207+,,0,0,0,,Onlar bir şekilde hallederler.Dialogue: 50,0:08:12.35,0:08:14.68,Main-207+,,0,0,0,,S-Sizi pislikler!Dialogue: 50,0:08:14.68,0:08:17.35,Main-207+,,0,0,0,,Bütün kapıyı uçuracağım!Dialogue: 50,0:08:20.19,0:08:21.69,Main-207+,,0,0,0,,Oh, dışarı mı çıkıyordun?Dialogue: 50,0:08:21.69,0:08:23.65,Main-207+,,0,0,0,,Ne?!Dialogue: 50,0:08:25.86,0:08:28.36,Main-207+,,0,0,0,,Tamam, sonraki 5 vagona geçelim.Dialogue: 50,0:08:29.28,0:08:30.45,Main-207+,,0,0,0,,Ş-şerefsiz!Dialogue: 50,0:08:30.45,0:08:32.37,Main-207+,,0,0,0,,O kadar kolay geçebileceğini sanma!Dialogue: 50,0:08:32.37,0:08:34.08,Main-207+,,0,0,0,,Bunu Yüzbaşı T-Bone'a yapmaya nasıl cüret edersin?!Dialogue: 50,0:08:34.41,0:08:36.58,Main-207+,,0,0,0,,Hey! Bunu CP9'a rapor edin!Dialogue: 50,0:08:36.58,0:08:38.79,Main-207+,,0,0,0,,Daha çok uşak varmış.Dialogue: 50,0:08:43.17,0:08:44.21,Main-207+,,0,0,0,,Frites...Dialogue: 50,0:08:43.17,0:08:44.21,Attack,,0,0,0,,KızarmışDialogue: 50,0:08:44.67,0:08:46.13,Main-207+,,0,0,0,,Assorties!Dialogue: 50,0:08:44.67,0:08:46.13,Attack,,0,0,0,,TasnifDialogue: 50,0:08:49.05,0:08:50.68,Main-207+,,0,0,0,,Sogeking...Dialogue: 50,0:08:50.68,0:08:52.55,Main-207+,,0,0,0,,Gunpowder Star!Dialogue: 50,0:08:50.68,0:08:52.55,Attack,,0,0,0,,Barut YıldızıDialogue: 50,0:08:54.93,0:08:58.52,Main-207+,,0,0,0,,Strong Right!Dialogue: 50,0:08:54.93,0:08:58.52,Attack,,0,0,0,,Güçlü SağDialogue: 50,0:09:03.11,0:09:05.19,Main-207+,,0,0,0,,Ağır silahlar! Ateş!Dialogue: 50,0:09:07.65,0:09:08.49,Main-207+,,0,0,0,,Vuruldu!Dialogue: 50,0:09:15.91,0:09:16.66,Main-207+,,0,0,0,,Acıttı.Dialogue: 50,0:09:18.66,0:09:20.25,Main-207+,,0,0,0,,Ateş, ateş!Dialogue: 50,0:09:26.75,0:09:29.13,Main-207+,,0,0,0,,Silahlar neden işe yaramıyor?!Dialogue: 50,0:09:41.60,0:09:44.23,Main-207+,,0,0,0,,H-Hey! Nesin sen?!Dialogue: 50,0:09:45.73,0:09:48.57,Main-207+,,0,0,0,,Ben sayborgum.Dialogue: 50,0:09:48.57,0:09:49.82,Main-207+,,0,0,0,,Sayborg mu?!Dialogue: 50,0:09:50.19,0:09:51.11,Main-207+,,0,0,0,,Evet.Dialogue: 50,0:09:51.11,0:09:54.28,Main-207+,,0,0,0,,Bedenimde çelik ve silahlar var.Dialogue: 50,0:09:54.28,0:09:57.66,Main-207+,,0,0,0,,Vurulunca acıtabilir ve biraz kanayabilir...Dialogue: 50,0:09:57.66,0:09:59.95,Main-207+,,0,0,0,,...ama evet, bende işe yaramaz.Dialogue: 50,0:09:59.95,0:10:01.79,Main-207+,,0,0,0,,Bu nasıl olabilir?Dialogue: 50,0:10:01.79,0:10:03.17,Main-207+,,0,0,0,,Dünya çok büyük.Dialogue: 50,0:10:03.17,0:10:04.33,Main-207+,,0,0,0,,Müthiş!Dialogue: 50,0:10:06.29,0:10:07.09,Main-207+,,0,0,0,,Dialogue: 50,0:10:07.09,0:10:09.05,Main-207+,,0,0,0,,Acıttı!Dialogue: 50,0:10:09.05,0:10:11.51,Main-207+,,0,0,0,,Ne yapıyorsun sen, aptal?!Dialogue: 50,0:10:11.51,0:10:13.84,Main-207+,,0,0,0,,Eh? Tek bir iğne acıtmamalı, değil mi?Dialogue: 50,0:10:13.84,0:10:15.43,Main-207+,,0,0,0,,Seni aptal!Dialogue: 50,0:10:15.43,0:10:17.81,Main-207+,,0,0,0,,Korkunç deneyler yapıyorsun!Dialogue: 50,0:10:17.81,0:10:20.56,Main-207+,,0,0,0,,Öncelikle arkam farklı!Dialogue: 50,0:10:20.56,0:10:21.31,Main-207+,,0,0,0,,Dinle,...Dialogue: 50,0:10:21.31,0:10:25.90,Main-207+,,0,0,0,,...bunu kendi başıma değiştirerek yaptım. Bu yüzden arka tarafıma ulaşamadım!Dialogue: 50,0:10:25.90,0:10:28.02,Main-207+,,0,0,0,,Sadece ön tarafım sayborg!Dialogue: 50,0:10:28.61,0:10:31.53,Main-207+,,0,0,0,,Hazır bahsetmişken bir şey daha söyliyeyim.Dialogue: 50,0:10:31.53,0:10:34.45,Main-207+,,0,0,0,,Midem soğuğa duyarlıdır. Niye?Dialogue: 50,0:10:34.45,0:10:35.49,Main-207+,,0,0,0,,Nereden bileyim?Dialogue: 50,0:10:36.28,0:10:39.62,Main-207+,,0,0,0,,Çünkü midemdeki kolayı soğutacak bir buzdolabı var!Dialogue: 50,0:10:39.62,0:10:41.20,Main-207+,,0,0,0,,Ooh, bu harika!Dialogue: 50,0:10:41.20,0:10:43.46,Main-207+,,0,0,0,,Müthiş! Sıcak günler için harika!Dialogue: 50,0:10:44.46,0:10:46.46,Main-207+,,0,0,0,,Şimdi bunun zamanı değil!Dialogue: 50,0:10:46.46,0:10:48.38,Main-207+,,0,0,0,,Bu vagonda düşman kalmadı!Dialogue: 50,0:10:48.38,0:10:49.84,Main-207+,,0,0,0,,Temiz! Sıradaki!Dialogue: 50,0:10:51.05,0:10:53.30,Main-207+,,0,0,0,,Sırada 4 no'lu vagon var.Dialogue: 50,0:11:04.69,0:11:05.94,Main-207+,,0,0,0,,Ben Wanze!Dialogue: 50,0:11:05.94,0:11:08.86,Main-207+,,0,0,0,,Deli, deli Wanze!Dialogue: 50,0:11:11.28,0:11:13.11,Main-207+,,0,0,0,,Dialogue: 50,0:11:13.11,0:11:14.99,Main-207+,,0,0,0,,Ben Wanze!Dialogue: 50,0:11:20.78,0:11:22.24,Main-207+,,0,0,0,,Selam, arkadaşlar!Dialogue: 50,0:11:22.24,0:11:23.45,Main-207+,,0,0,0,,Aç mısınız?Dialogue: 50,0:11:23.45,0:11:24.62,Main-207+,,0,0,0,,Ben Wanze.Dialogue: 50,0:11:24.62,0:11:26.83,Main-207+,,0,0,0,,Baş garsonum, yani her şeyi pişirebilirim!Dialogue: 50,0:11:26.83,0:11:29.34,Main-207+,,0,0,0,,Biraz ramen ister misiniz? O zaman ramen!Dialogue: 50,0:11:29.34,0:11:32.59,Main-207+,,0,0,0,,Ama önce bilmenizi istediğim küçük bir şey var.Dialogue: 50,0:11:33.09,0:11:34.84,Main-207+,,0,0,0,,Burun kıllarım aynı böyle.Dialogue: 50,0:11:34.84,0:11:38.68,Main-207+,,0,0,0,,İçeride bir ağ gibi.  Aynı ağ file külotlu çorap gibi.Dialogue: 50,0:11:38.68,0:11:40.39,Main-207+,,0,0,0,,Bunu sakın unutmayın!Dialogue: 50,0:11:40.85,0:11:45.39,Main-207+,,0,0,0,,Evet! Önce ağzıma biraz un koyup  iyice karıştırıyorum.Dialogue: 50,0:11:56.03,0:11:57.91,Main-207+,,0,0,0,,İşte, afiyet olsun!Dialogue: 50,0:11:57.91,0:11:59.24,Main-207+,,0,0,0,,– Hiç sanmıyorum!! – Hiç sanmıyorum!!Dialogue: 50,0:12:00.16,0:12:02.45,Main-207+,,0,0,0,,Çok zaman kaybettik.Dialogue: 50,0:12:02.45,0:12:06.04,Main-207+,,0,0,0,,Wanze, bizi bekleyen biri var.Dialogue: 50,0:12:06.04,0:12:08.08,Main-207+,,0,0,0,,Acelemiz var. Görüşürüz.Dialogue: 50,0:12:08.54,0:12:10.42,Main-207+,,0,0,0,,Bekle!Dialogue: 50,0:12:10.42,0:12:12.80,Main-207+,,0,0,0,,Bu vagondan geçmek istiyorsanız,...Dialogue: 50,0:12:12.80,0:12:15.09,Main-207+,,0,0,0,,...beni yenmeniz gerekir!Dialogue: 50,0:12:20.76,0:12:22.81,Main-207+,,0,0,0,,Bizi durdurmaya mı çalışıyorsun?Dialogue: 50,0:12:22.81,0:12:25.72,Main-207+,,0,0,0,,Durduracağım! Sa-sa-ssa-saaa!Dialogue: 50,0:12:25.72,0:12:32.65,Main-207+,,0,0,0,,Bu deniz treni konvoyu görevinde bir şey olması ihtimaline karşın, ben buradayım!Dialogue: 50,0:12:33.23,0:12:38.74,Main-207+,,0,0,0,,Suçluyu kurtarmak istiyorsanız, ramen kenpo'mu yenmeyi deneyin!Dialogue: 50,0:12:39.66,0:12:41.57,Main-207+,,0,0,0,,R-Ramen kenpo mu?!Dialogue: 50,0:12:41.57,0:12:43.78,Main-207+,,0,0,0,,"R-Ramen kenpo mu?!"Dialogue: 50,0:12:45.16,0:12:47.54,Main-207+,,0,0,0,,Pislik, bizimle alay ediyorsun!Dialogue: 50,0:12:47.54,0:12:50.17,Main-207+,,0,0,0,,Seni kızdırmasına izin verme, sersem!  İstediği de bu zaten!Dialogue: 50,0:12:50.17,0:12:53.04,Main-207+,,0,0,0,,Sa-sa-saaa! Aptal taklidim nasıldı?Dialogue: 50,0:12:54.17,0:12:55.92,Main-207+,,0,0,0,,Seni kızdırmasına izin verme dedim!Dialogue: 50,0:12:55.92,0:12:58.05,Main-207+,,0,0,0,,Sa-sa-ssa-saaa!Dialogue: 50,0:12:58.05,0:13:00.47,Main-207+,,0,0,0,,Ne enerjik bir adam.Dialogue: 50,0:13:07.43,0:13:09.69,Main-207+,,0,0,0,,Ne? Kurşunlar onu sıyırıp geçmesine rağmen...Dialogue: 50,0:13:10.06,0:13:12.60,Main-207+,,0,0,0,,...yüzü seğirmedi bile. Ne soğukkanlılık!Dialogue: 50,0:13:12.60,0:13:15.86,Main-207+,,0,0,0,,K-Kalbimin yerinden fırlayacağını sandım!Dialogue: 50,0:13:15.86,0:13:17.11,Main-207+,,0,0,0,,Korktun mu?!Dialogue: 50,0:13:17.11,0:13:18.94,Main-207+,,0,0,0,,İstifini bozmadan durmayı kes!Dialogue: 50,0:13:19.32,0:13:21.82,Main-207+,,0,0,0,,– Bu sinir bozucu herifi haklayacağım! – Bu sinir bozucu herifi haklayacağım!Dialogue: 50,0:13:21.82,0:13:22.95,Main-207+,,0,0,0,,Durun, durun!Dialogue: 50,0:13:23.49,0:13:28.50,Main-207+,,0,0,0,,Sizinle eğlenmesine izin verirseniz, zamanınızı harcayacak.Dialogue: 50,0:13:28.91,0:13:31.62,Main-207+,,0,0,0,,İşini hızlıca bitireceğim.Dialogue: 50,0:13:32.25,0:13:37.71,Main-207+,,0,0,0,,Kendine aşçı demen sinir bozucu.Dialogue: 50,0:13:40.22,0:13:41.63,Main-207+,,0,0,0,,Seninle konuşuyorum!Dialogue: 50,0:13:43.84,0:13:46.06,Main-207+,,0,0,0,,– Seni kızdırmasına izin veren sensin! – Seni kızdırmasına izin veren sensin!Dialogue: 50,0:13:47.06,0:13:47.77,Main-207+,,0,0,0,,Ama bakın!Dialogue: 50,0:13:48.27,0:13:50.77,Main-207+,,0,0,0,,Sanji'nin tekmesini kolayca savuşturdu!Dialogue: 50,0:13:51.98,0:13:54.48,Main-207+,,0,0,0,,O sakin ifade de neyin nesi?Dialogue: 50,0:13:54.48,0:13:56.11,Main-207+,,0,0,0,,Öleceğimi sandım!Dialogue: 50,0:13:56.11,0:13:57.48,Main-207+,,0,0,0,,Şaşırdın mı?!Dialogue: 50,0:13:57.48,0:13:59.11,Main-207+,,0,0,0,,Şunu yapmayı kes!Dialogue: 50,0:14:06.58,0:14:07.53,Main-207+,,0,0,0,,Neyse,...Dialogue: 50,0:14:11.62,0:14:14.00,Main-207+,,0,0,0,,...onu bana bırakın...Dialogue: 50,0:14:15.17,0:14:17.50,Main-207+,,0,0,0,,...ve bir sonraki vagona gidin.Dialogue: 50,0:14:20.55,0:14:23.30,Main-207+,,0,0,0,,Son iki vagonu ayırmışlar mı?!Dialogue: 50,0:14:23.30,0:14:25.93,Main-207+,,0,0,0,,Bunun olmasına nasıl izin verebildiniz?Dialogue: 50,0:14:26.30,0:14:28.01,Main-207+,,0,0,0,,Gerçekten üzgünüm!Dialogue: 50,0:14:28.01,0:14:32.56,Main-207+,,0,0,0,,Ama önemli dövüşçülerimizden biri olan  Yüzbaşı T-Bone bile ayrılan vagonda tuzağa düştü.Dialogue: 50,0:14:32.56,0:14:35.77,Main-207+,,0,0,0,,Hala bağlı olan vagonların durumu nedir?Dialogue: 50,0:14:35.77,0:14:36.73,Main-207+,,0,0,0,,Evet.Dialogue: 50,0:14:36.73,0:14:40.65,Main-207+,,0,0,0,,Bağlı durumda olan beş vagon var.Dialogue: 50,0:14:40.65,0:14:44.15,Main-207+,,0,0,0,,Bütün askerler yenilmiş durumda.Dialogue: 50,0:14:44.15,0:14:46.82,Main-207+,,0,0,0,,Geriye kalanlar sadece 4. vagondaki Wanze,...Dialogue: 50,0:14:46.82,0:14:49.28,Main-207+,,0,0,0,,...3. vagondaki Nero,...Dialogue: 50,0:14:49.28,0:14:52.25,Main-207+,,0,0,0,,...1. vagondaki Nico Robin...Dialogue: 50,0:14:52.25,0:14:55.37,Main-207+,,0,0,0,,...ve 2. vagondaki buradaki herkes.Dialogue: 50,0:14:55.37,0:14:58.34,Main-207+,,0,0,0,,Saldırganlar epey güçlü gibi.Dialogue: 50,0:14:58.71,0:15:02.63,Main-207+,,0,0,0,,Ancak şu anki durumumuzdaki tek sorun,...Dialogue: 50,0:15:02.63,0:15:05.55,Main-207+,,0,0,0,,...Franky'nin serbest kalmış olması.Dialogue: 50,0:15:06.09,0:15:11.97,Main-207+,,0,0,0,,Görevimiz, Franky ve Nico Robin'i, Enies Lobby'e teslim etmek.Dialogue: 50,0:15:11.97,0:15:15.31,Main-207+,,0,0,0,,Yani, diğer düşmanların nasıl öldüğü veya...Dialogue: 50,0:15:15.31,0:15:17.56,Main-207+,,0,0,0,,...kendi müttefiklerimizin yenilmesi...Dialogue: 50,0:15:17.56,0:15:19.90,Main-207+,,0,0,0,,...görevimizi etkilemeyecek.Dialogue: 50,0:15:20.94,0:15:23.40,Main-207+,,0,0,0,,Davetsiz misafirlerin kimliklerini tespit ettiniz mi?Dialogue: 50,0:15:23.78,0:15:26.95,Main-207+,,0,0,0,,Evet. Tutuklamış olduğumuz ikisi var ama ...Dialogue: 50,0:15:26.95,0:15:29.53,Main-207+,,0,0,0,,...biri tuhaf bir maske takıyordu.Dialogue: 50,0:15:29.95,0:15:33.16,Main-207+,,0,0,0,,Diğeri sarışın, takım elbiseli bir erkek.Dialogue: 50,0:15:33.16,0:15:34.62,Main-207+,,0,0,0,,Toplamda üç kişiler.Dialogue: 50,0:15:35.58,0:15:40.67,Main-207+,,0,0,0,,O da muhtemelen uzun burunlu adam gibi Hasır Şapkalar'ın bir üyesi.Dialogue: 50,0:15:40.67,0:15:43.80,Main-207+,,0,0,0,,Amaçlarının Nico Robin'i kurtarmak olduğu belli.Dialogue: 50,0:15:44.42,0:15:47.51,Main-207+,,0,0,0,,Franky sadece onlara yardım ediyor.Dialogue: 50,0:15:48.84,0:15:52.64,Main-207+,,0,0,0,,Lucci, gidip Nico Robin'i kontrol edeyim mi?Dialogue: 50,0:15:52.64,0:15:54.52,Main-207+,,0,0,0,,Gerek yok.Dialogue: 50,0:15:54.52,0:15:57.52,Main-207+,,0,0,0,,Sadece Franky'yi yakalamaya odaklan.Dialogue: 50,0:15:58.06,0:16:01.69,Main-207+,,0,0,0,,Nico Robin'i kurtarmak için ellerinden geleni yapacaklar.Dialogue: 50,0:16:02.32,0:16:04.23,Main-207+,,0,0,0,,Ama o istek...Dialogue: 50,0:16:04.86,0:16:07.24,Main-207+,,0,0,0,,...asla gerçekleşmeyecek!Dialogue: 50,0:16:07.61,0:16:13.08,Main-207+,,0,0,0,,Gitmenize... izin... vermeyeceğim!Dialogue: 50,0:16:14.16,0:16:16.66,Main-207+,,0,0,0,,Birinci kalite unu karıştır.Dialogue: 50,0:16:16.66,0:16:18.79,Main-207+,,0,0,0,,Yine ramen yapıyor.Dialogue: 50,0:16:19.29,0:16:20.67,Main-207+,,0,0,0,,Ramen...Dialogue: 50,0:16:21.75,0:16:22.71,Main-207+,,0,0,0,,Beam...!Dialogue: 50,0:16:21.75,0:16:22.71,Attack,,0,0,0,,IşınıDialogue: 50,0:16:25.34,0:16:26.30,Main-207+,,0,0,0,,Aşırı keskinler!Dialogue: 50,0:16:26.30,0:16:27.22,Main-207+,,0,0,0,,Beam!Dialogue: 50,0:16:27.22,0:16:27.88,Main-207+,,0,0,0,,Beam!Dialogue: 50,0:16:27.88,0:16:28.68,Main-207+,,0,0,0,,Beam!Dialogue: 50,0:16:31.35,0:16:32.51,Main-207+,,0,0,0,,Aman!Dialogue: 50,0:16:34.93,0:16:36.77,Main-207+,,0,0,0,,Kes şunu!Dialogue: 50,0:16:41.61,0:16:42.77,Main-207+,,0,0,0,,Yukarıdan gidelim.Dialogue: 50,0:16:42.77,0:16:44.02,Main-207+,,0,0,0,,Tamam.Dialogue: 50,0:16:44.90,0:16:47.99,Main-207+,,0,0,0,,Onu sana bırakıyoruz, Sanji-kun.Dialogue: 50,0:16:51.28,0:16:53.58,Main-207+,,0,0,0,,Kaçtılar.Dialogue: 50,0:16:53.58,0:16:55.74,Main-207+,,0,0,0,,Ama bu da işe yaramaz.Dialogue: 50,0:16:55.74,0:17:00.21,Main-207+,,0,0,0,,Bir sonraki vagondaki kişi, Nero!Dialogue: 50,0:17:00.21,0:17:03.85,Main-207+,,0,0,0,,Yeni bir üye olmasına rağmen,  yine de adalet suikastçileri CP9'dan biri.Dialogue: 50,0:17:03.87,0:17:05.34,Main-207+,,0,0,0,,O ikisi öldü sayılır.Dialogue: 50,0:17:05.34,0:17:10.59,Main-207+,,0,0,0,,Nero öldürmeyi sever.Dialogue: 50,0:17:10.59,0:17:12.30,Main-207+,,0,0,0,,Flanchet...Dialogue: 50,0:17:10.59,0:17:12.30,Attack,,0,0,0,,MideDialogue: 50,0:17:14.10,0:17:15.43,Main-207+,,0,0,0,,Shoot!Dialogue: 50,0:17:14.10,0:17:15.43,Attack,,0,0,0,,VuruşuDialogue: 50,0:17:18.06,0:17:20.44,Main-207+,,0,0,0,,Dediğim gibi, zamanımız az.Dialogue: 50,0:17:20.77,0:17:22.40,Main-207+,,0,0,0,,Tamam o zaman, al bakalım.Dialogue: 50,0:17:22.40,0:17:24.90,Main-207+,,0,0,0,,Ramen Kenpo: Men-Kiri!Dialogue: 50,0:17:22.40,0:17:24.90,Attack,,0,0,0,,Ramen Kenpo: Makarna KesimiDialogue: 50,0:17:28.69,0:17:31.28,Main-207+,,0,0,0,,Fire...Dialogue: 50,0:17:28.69,0:17:31.28,Attack,,0,0,0,,AlevliDialogue: 50,0:17:31.28,0:17:32.78,Main-207+,,0,0,0,,Skate!Dialogue: 50,0:17:31.28,0:17:32.78,Attack,,0,0,0,,PatenDialogue: 50,0:17:45.38,0:17:47.13,Main-207+,,0,0,0,,Ah, ah, ah...!Dialogue: 50,0:17:47.13,0:17:51.47,Main-207+,,0,0,0,,Saldırımı savuşturdun ve beni 10 kez tekmeledin.Dialogue: 50,0:17:51.47,0:17:53.30,Main-207+,,0,0,0,,12 kez.Dialogue: 50,0:17:53.93,0:17:57.39,Main-207+,,0,0,0,,Aslında gizliden gizliye süper güçlü müsün?Dialogue: 50,0:17:58.18,0:18:00.81,Main-207+,,0,0,0,,Hayır, sadece sen süper güçsüzsün.Dialogue: 50,0:18:01.14,0:18:02.19,Main-207+,,0,0,0,,Hey, hey!Dialogue: 50,0:18:02.19,0:18:05.31,Main-207+,,0,0,0,,Babam bile böyle demezdi.Dialogue: 50,0:18:05.31,0:18:06.82,Main-207+,,0,0,0,,Bu kadar kaba olmayı bırak!Dialogue: 50,0:18:06.82,0:18:09.82,Main-207+,,0,0,0,,Ben Wanze!Dialogue: 50,0:18:10.36,0:18:14.24,Main-207+,,0,0,0,,Aslında kıvırcık kaşın dikkatimi dağıttı.Dialogue: 50,0:18:14.24,0:18:18.49,Main-207+,,0,0,0,,Bu yüzden saldırına kandım.Dialogue: 50,0:18:18.49,0:18:22.00,Main-207+,,0,0,0,,Görünüşümü eleştirecek konumda değilsin!Dialogue: 50,0:18:25.58,0:18:27.09,Main-207+,,0,0,0,,Pekâla!Dialogue: 50,0:18:27.09,0:18:33.93,Main-207+,,0,0,0,,Niye bu iş için seçildiğimi öğrenmeni sağlayacağım.Dialogue: 50,0:18:45.81,0:18:48.36,Main-207+,,0,0,0,,Ramen Kenpo Ougi...Dialogue: 50,0:18:45.81,0:18:48.36,Attack,,0,0,0,,Ramen Kenpo Gizli TekniğiDialogue: 50,0:18:49.73,0:18:53.65,Main-207+,,0,0,0,,Hamuru çekiyorum, çekiyorum, çekiyorum.Dialogue: 50,0:18:54.32,0:18:55.16,Main-207+,,0,0,0,,Ne...?Dialogue: 50,0:18:55.66,0:18:57.16,Main-207+,,0,0,0,,O da ne?Dialogue: 50,0:18:57.16,0:19:00.08,Main-207+,,0,0,0,,Hayallerinizdeki yenilebilir dövüş kıyafeti!Dialogue: 50,0:19:03.75,0:19:07.21,Main-207+,,0,0,0,,Ra-Men's Formal Suit!Dialogue: 50,0:19:03.75,0:19:07.21,Note,,0,0,0,,Ra-Men(Erkek)'in Resmi Takım Elbisesi!Dialogue: 50,0:19:09.42,0:19:14.93,Main-207+,,0,0,0,,Ramen kenpo'nun gizli tekniği, serbest hareket edebilen ramen.Dialogue: 50,0:19:14.93,0:19:16.68,Main-207+,,0,0,0,,Şerefsiz...Dialogue: 50,0:19:16.68,0:19:19.39,Main-207+,,0,0,0,,Yiyeceği o şekilde rezil etmeye nasıl cüret edersin?!Dialogue: 50,0:19:19.89,0:19:23.60,Main-207+,,0,0,0,,Artık hız, güç ve özel yeteneklerde...Dialogue: 50,0:19:23.60,0:19:26.90,Main-207+,,0,0,0,,...tamamen farklı bir seviyedeyim!Dialogue: 50,0:19:28.44,0:19:32.61,Main-207+,,0,0,0,,Sana eşsiz bir güç göstereceğim!Dialogue: 50,0:19:35.78,0:19:38.24,Main-207+,,0,0,0,,Kapa çeneni ve sadede gel.Dialogue: 50,0:19:38.62,0:19:43.41,Main-207+,,0,0,0,,Lanet olası, o hamurun hepsini sana yedireceğim.Dialogue: 50,0:19:48.33,0:19:49.67,Main-207+,,0,0,0,,Öyle...Dialogue: 50,0:19:51.42,0:19:53.67,Main-207+,,0,0,0,,Orada ne yapıyorsun?Dialogue: 50,0:19:55.55,0:19:58.43,Main-207+,,0,0,20,,3 numaralı vagonda bekleyen,...Dialogue: 50,0:19:58.43,0:20:01.35,Main-207+,,0,0,20,,...CP9'un yeni elemanı ve Dört Güç ustası,...Dialogue: 50,0:20:01.72,0:20:03.60,Main-207+,,0,0,0,,"Deniz Gelinciği" Nero.Dialogue: 50,0:20:05.98,0:20:10.81,Main-207+,,0,0,0,,Ne yazık ki seni öldüremem.Dialogue: 50,0:20:11.19,0:20:14.28,Main-207+,,0,0,0,,Çünkü değerli suçlumuzsun.Dialogue: 50,0:20:14.78,0:20:16.78,Main-207+,,0,0,0,,Hey, birader!Dialogue: 50,0:20:16.78,0:20:19.78,Main-207+,,0,0,0,,Niye trenin üstünde olduğunu sormuştum.Dialogue: 50,0:20:19.78,0:20:22.12,Main-207+,,0,0,0,,Bizi içeride bekleyemedin mi?Dialogue: 50,0:20:22.45,0:20:24.62,Main-207+,,0,0,0,,Gizlice yanımdan...Dialogue: 50,0:20:24.62,0:20:27.62,Main-207+,,0,0,0,,...geçip gitmeyeceğinizi nereden bileyim?Dialogue: 50,0:20:28.96,0:20:31.84,Main-207+,,0,0,0,,Epey kurnazsın.Dialogue: 50,0:20:31.84,0:20:35.05,Main-207+,,0,0,0,,Dikkatli olmak her zaman iyidir.Dialogue: 50,0:20:35.80,0:20:39.05,Main-207+,,0,0,0,,Ama arkandaki kim acaba?Dialogue: 50,0:20:49.31,0:20:51.27,Main-207+,,0,0,0,,Pis oynuyorsun!Dialogue: 50,0:20:54.57,0:20:55.73,Main-207+,,0,0,0,,Elbette.Dialogue: 50,0:20:56.23,0:20:59.74,Main-207+,,0,0,0,,Çünkü şehrimde yer altı patronuyum.Dialogue: 50,0:21:23.43,0:21:24.89,Main-207+,,0,0,0,,Uzun burun-kun!Dialogue: 50,0:21:27.85,0:21:29.56,Main-207+,,0,0,0,,Niye buradasın?Dialogue: 50,0:21:31.85,0:21:34.82,Main-207+,,0,0,0,,♪ Keskin Nişancı–Dialogue: 0,0:00:02.10,0:00:02.14,CaptionsSniper,,0,0,0,,Keskin NişancıDialogue: 1,0:00:02.10,0:00:02.14,CaptionsSniper,,0,0,0,,Keskin NişancıDialogue: 0,0:00:02.14,0:00:02.19,CaptionsSniper,,0,0,0,,Keskin NişancıDialogue: 1,0:00:02.14,0:00:02.19,CaptionsSniper,,0,0,0,,Keskin NişancıDialogue: 0,0:00:02.19,0:00:02.23,CaptionsSniper,,0,0,0,,Keskin Nişancı