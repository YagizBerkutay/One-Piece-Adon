15,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 50,0:01:58.10,0:01:59.77,Main-207+,,0,0,0,,Yıldız Kalkanı.Dialogue: 50,0:02:00.14,0:02:02.48,Thoughts-207+,,0,0,0,,Bedeninin nesi var?Dialogue: 50,0:02:02.48,0:02:05.52,Thoughts-207+,,0,0,0,,Sanki insan değil!Dialogue: 50,0:02:06.11,0:02:06.98,Main-207+,,0,0,0,,Yine mi alevler?!Dialogue: 50,0:02:06.98,0:02:08.69,Main-207+,,0,0,0,,Master Nail!Dialogue: 50,0:02:06.98,0:02:08.69,Attack,,0,0,0,,Ana ÇiviDialogue: 50,0:02:10.03,0:02:10.74,Main-207+,,0,0,0,,Moon Walk!Dialogue: 50,0:02:10.03,0:02:10.74,Attack,,0,0,0,,Ay YürüyüşüDialogue: 50,0:02:13.49,0:02:17.41,Main-207+,,0,0,0,,Bir kez daha zıplıyor. Bu şekilde hiçbir yere varamayız!Dialogue: 50,0:02:18.37,0:02:22.12,Main-207+,,0,0,0,,Dört güçü kullanamazsam işe yaramaz.Dialogue: 50,0:02:22.12,0:02:26.71,Main-207+,,0,0,0,,Henüz zayıflığını bilmiyorum.  Üzgünüm ama bazı gereçler...Dialogue: 50,0:02:26.71,0:02:28.25,Main-207+,,0,0,0,,...kullanmak zorundayım.Dialogue: 50,0:02:28.25,0:02:31.05,Main-207+,,0,0,0,,Tamam, sıradaki vagona gideceğim.Dialogue: 50,0:02:31.05,0:02:33.01,Main-207+,,0,0,0,,Hey, bekle, seni piç!Dialogue: 50,0:02:33.42,0:02:34.80,Main-207+,,0,0,0,,Bir anlığına bile tedbiri elden bırakamam.Dialogue: 50,0:02:38.01,0:02:39.35,Main-207+,,0,0,0,,Yemi yuttu.Dialogue: 50,0:02:39.35,0:02:41.02,Main-207+,,0,0,0,,Beans Left!Dialogue: 50,0:02:39.35,0:02:41.02,Attack,,0,0,0,,Sol YatıştırıcılarDialogue: 50,0:02:45.10,0:02:46.69,Main-207+,,0,0,0,,Çok yazık.Dialogue: 50,0:02:46.69,0:02:48.48,Main-207+,,0,0,0,,Böyle bir şey...Dialogue: 50,0:02:48.48,0:02:50.02,Main-207+,,0,0,0,,...yapmaya çalıştığını biliyordum.Dialogue: 50,0:02:55.53,0:02:58.03,Main-207+,,0,0,0,,Ah...!Dialogue: 50,0:03:00.37,0:03:01.49,Main-207+,,0,0,0,,İşe yaradı.Dialogue: 50,0:03:02.29,0:03:04.16,Main-207+,,0,0,0,,Pislik...Dialogue: 50,0:03:04.16,0:03:05.37,Main-207+,,0,0,0,,Ouchie Finger!Dialogue: 50,0:03:04.16,0:03:05.37,Attack,,0,0,0,,Ahlatan ParmakDialogue: 50,0:03:05.37,0:03:06.29,Main-207+,,0,0,0,,Soru!Dialogue: 50,0:03:05.37,0:03:06.29,Attack,,0,0,0,,KazıDialogue: 50,0:03:07.67,0:03:09.17,Main-207+,,0,0,0,,Kahretsin...Dialogue: 50,0:03:09.17,0:03:11.13,Main-207+,,0,0,0,,Fark etti...Dialogue: 50,0:03:13.34,0:03:14.22,Main-207+,,0,0,0,,Rankyaku!Dialogue: 50,0:03:13.34,0:03:14.22,Attack,,0,0,0,,Fırtına Tekmesi!Dialogue: 50,0:03:15.34,0:03:17.01,Main-207+,,0,0,0,,Beni çizdi!Dialogue: 50,0:03:17.01,0:03:18.76,Main-207+,,0,0,0,,Çok fazla hareket ediyor.Dialogue: 50,0:03:20.81,0:03:22.68,Main-207+,,0,0,0,,Zayıf noktan...Dialogue: 50,0:03:23.68,0:03:25.52,Main-207+,,0,0,0,,...sırtın, ha?Dialogue: 50,0:03:26.52,0:03:29.65,Main-207+,,0,0,0,,Pis oyunlarını zaten biliyorum.Dialogue: 50,0:03:30.15,0:03:33.53,Main-207+,,0,0,0,,Kazanmam an meselesi, değil mi?Dialogue: 50,0:03:33.53,0:03:35.36,Main-207+,,0,0,0,,Kendini bir şey sanma!Dialogue: 50,0:03:35.90,0:03:39.28,Main-207+,,0,0,0,,Bu şekilde olduğum sürece, zayıf noktama vuramazsın.Dialogue: 50,0:03:39.28,0:03:42.16,Main-207+,,0,0,0,,Yenilmez Franky!Dialogue: 50,0:03:42.16,0:03:43.87,Main-207+,,0,0,0,,Tada!Dialogue: 50,0:03:46.88,0:03:49.43,Main-207+,,0,0,0,,Pes etmeye hazır mısın, gelincik?Dialogue: 50,0:03:49.96,0:03:52.25,Thoughts-207+,,0,0,0,,Ona ne diyeceğimi bilemiyorum...Dialogue: 50,0:03:52.25,0:03:57.13,Main-207+,,0,0,0,,Gerçekten kötü şansın var.Dialogue: 50,0:03:58.13,0:04:00.76,Main-207+,,0,0,0,,Beni kızdırdın.Dialogue: 50,0:04:02.01,0:04:04.68,Main-207+,,0,0,0,,Bu hafta süperim.Dialogue: 50,0:04:05.39,0:04:07.52,Main-207+,,0,0,0,,Hey, birader...Dialogue: 50,0:04:07.52,0:04:10.69,Main-207+,,0,0,0,,Sentor nedir, bilir misin?Dialogue: 50,0:04:12.52,0:04:16.90,Main-207+,,0,0,0,,İnsan başlı atı mı diyorsun?Dialogue: 50,0:04:16.90,0:04:18.36,Main-207+,,0,0,0,,Ne olmuş?Dialogue: 50,0:04:21.57,0:04:24.45,Main-207+,,0,0,0,,Hen... tai!Dialogue: 50,0:04:21.57,0:04:24.45,Note,,0,0,0,,"Hentai" hem "sapık kişi"  hem de "dönüşen kişi" anlamına gelebilir.Dialogue: 50,0:04:38.97,0:04:41.22,Main-207+,,0,0,0,,Yoksa bu adam...Dialogue: 50,0:04:46.10,0:04:50.60,Main-207+,,0,0,0,,Franky Centaur!Dialogue: 50,0:04:46.10,0:04:50.60,Attack,,0,0,0,,Sentor FrankyDialogue: 50,0:04:50.60,0:04:54.02,Main-207+,,0,0,0,,Bu da ne?! Geriye doğru olmalı!Dialogue: 50,0:04:55.53,0:05:01.61,Main-207+,,0,0,0,,Belki de yorumlarını, bu şeyin ateş gücünü gördükten sonraya saklamalısın.Dialogue: 50,0:05:01.61,0:05:03.57,Main-207+,,0,0,0,,Kahretsin, küstah suçlu!Dialogue: 50,0:05:04.08,0:05:06.74,Main-207+,,0,0,0,,Erişte yumruklarım gitti artık!Dialogue: 50,0:05:06.74,0:05:07.50,Main-207+,,0,0,0,,Beni...Dialogue: 50,0:05:08.50,0:05:10.54,Main-207+,,0,0,0,,...soğana benzettin?!Dialogue: 50,0:05:11.21,0:05:13.71,Main-207+,,0,0,0,,Artık dövüşmenin manası yok.Dialogue: 50,0:05:13.71,0:05:16.34,Main-207+,,0,0,0,,Bunu kabul etmeyeceğim!Dialogue: 50,0:05:16.34,0:05:20.05,Main-207+,,0,0,0,,Zaten kaybettiğimi kim söyledi?Dialogue: 50,0:05:21.63,0:05:25.10,Main-207+,,0,0,0,,Ben CP7 üyesi, Wanze!Dialogue: 50,0:05:25.43,0:05:29.60,Main-207+,,0,0,0,,Bu görevin ne kadar önemli olduğunu biliyorum.Dialogue: 50,0:05:29.60,0:05:34.31,Main-207+,,0,0,0,,Hükümet, uzun zamandır takip ettiği Nico Robin'i nihayet yakaladı.Dialogue: 50,0:05:34.31,0:05:37.23,Main-207+,,0,0,0,,Onu kolayca almana izin veremem, seni aptal!Dialogue: 50,0:05:37.57,0:05:41.70,Main-207+,,0,0,0,,Ramen Kenpo: Menkui Knocker!Dialogue: 50,0:05:37.57,0:05:41.70,Attack,,0,0,0,,Ramen Kenpo: Erişteli Çivi DarbesiDialogue: 50,0:05:49.00,0:05:54.13,Main-207+,,0,0,0,,Soğanı pişirmeden önce kökünü ve sapını kesmen gerekir.Dialogue: 50,0:05:56.59,0:05:59.46,Main-207+,,0,0,0,,Tek hamlede kesersen,...Dialogue: 50,0:05:59.46,0:06:02.68,Main-207+,,0,0,0,,...kesikler güzel ve aynı şekilli olur.Dialogue: 50,0:06:04.26,0:06:06.18,Main-207+,,0,0,0,,Kes şunu! Yaklaşma!Dialogue: 50,0:06:06.18,0:06:07.85,Main-207+,,0,0,0,,Ramen Beam!Dialogue: 50,0:06:06.18,0:06:07.85,Attack,,0,0,0,,Ramen IşınıDialogue: 50,0:06:11.48,0:06:13.44,Main-207+,,0,0,0,,Épluchage!Dialogue: 50,0:06:11.48,0:06:13.44,Attack,,0,0,0,,Kabuk SoymaDialogue: 50,0:06:27.45,0:06:30.04,Main-207+,,0,0,0,,Beni kestin!Dialogue: 50,0:06:35.79,0:06:37.75,Main-207+,,0,0,0,,Ha? Kesilmemişim.Dialogue: 50,0:06:37.75,0:06:41.63,Main-207+,,0,0,0,,Sadece artık bile olsa,  yüreğini ortaya koyarsan...Dialogue: 50,0:06:41.63,0:06:44.05,Main-207+,,0,0,0,,...her yemeğin tadı kötü olmaz.Dialogue: 50,0:06:45.51,0:06:49.35,Main-207+,,0,0,0,,Bıçak kılıç değildir. İnsan kesmez.Dialogue: 50,0:06:49.85,0:06:52.81,Main-207+,,0,0,0,,Ancak zırhın olmadan tehlikede olduğunu farket.Dialogue: 50,0:06:52.81,0:06:54.48,Main-207+,,0,0,0,,Houchou Nage!Dialogue: 50,0:06:52.81,0:06:54.48,Attack,,0,0,0,,Mutfak Bıçağı FırlatmaDialogue: 50,0:06:56.40,0:06:57.69,Main-207+,,0,0,0,,Pislik...Dialogue: 50,0:06:57.69,0:06:58.90,Main-207+,,0,0,0,,Œil!Dialogue: 50,0:06:57.69,0:06:58.90,Attack,,0,0,0,,GözDialogue: 50,0:07:00.90,0:07:04.03,Main-207+,,0,0,0,,Gözlerim çöktü!Dialogue: 50,0:07:04.03,0:07:05.24,Main-207+,,0,0,0,,Çekil.Dialogue: 50,0:07:05.24,0:07:07.82,Main-207+,,0,0,0,,Kapa çeneni ve pes et!Dialogue: 50,0:07:10.66,0:07:12.54,Main-207+,,0,0,0,,Seni aptal! Vazgeçer miyim sanıyorsun?Dialogue: 50,0:07:13.66,0:07:18.42,Main-207+,,0,0,0,,O kadını niye kurtarmak istediğini anlamıyorum.Dialogue: 50,0:07:18.42,0:07:23.34,Main-207+,,0,0,0,,Nico Robin'le ilgili gerçeği bilmiyorsun!Dialogue: 50,0:07:23.34,0:07:25.13,Main-207+,,0,0,0,,O kadın...Dialogue: 50,0:07:25.13,0:07:26.18,Main-207+,,0,0,0,,Nez!Dialogue: 50,0:07:25.13,0:07:26.18,Attack,,0,0,0,,BurunDialogue: 50,0:07:26.18,0:07:27.18,Main-207+,,0,0,0,,Joue!Dialogue: 50,0:07:26.18,0:07:27.18,Attack,,0,0,0,,YanakDialogue: 50,0:07:27.18,0:07:28.30,Main-207+,,0,0,0,,Bouche!Dialogue: 50,0:07:27.18,0:07:28.30,Attack,,0,0,0,,AğızDialogue: 50,0:07:28.30,0:07:29.39,Main-207+,,0,0,0,,Dents!Dialogue: 50,0:07:28.30,0:07:29.39,Attack,,0,0,0,,DişDialogue: 50,0:07:29.39,0:07:30.35,Main-207+,,0,0,0,,Menton!Dialogue: 50,0:07:29.39,0:07:30.35,Attack,,0,0,0,,ÇeneDialogue: 50,0:07:34.56,0:07:37.40,Main-207+,,0,0,0,,Bir kelime daha edersen, yüzüne yeni şekil veririm.Dialogue: 50,0:07:37.90,0:07:41.11,Main-207+,,0,0,0,,D-D-Dur biraz!Dialogue: 50,0:07:41.11,0:07:43.57,Main-207+,,0,0,0,,Y-Yüzüm büzüldü! Kes şunu!Dialogue: 50,0:07:46.95,0:07:49.78,Main-207+,,0,0,0,,Bilmiyorsan söyleyeyim.Dialogue: 50,0:07:49.78,0:07:51.45,Main-207+,,0,0,0,,Herkes bilir!Dialogue: 50,0:07:51.45,0:07:54.50,Main-207+,,0,0,0,,O ahlaksız bir şeytan!Dialogue: 50,0:07:55.71,0:07:58.42,Main-207+,,0,0,0,,Parage Shot!Dialogue: 50,0:07:55.71,0:07:58.42,Attack,,0,0,0,,Estetik Ameliyat VuruşuDialogue: 50,0:08:14.31,0:08:15.85,Main-207+,,0,0,0,,L-L-Lanet olsun!Dialogue: 50,0:08:15.85,0:08:18.27,Main-207+,,0,0,0,,Yüzüm çöktü! Ayna, ayna!Dialogue: 50,0:08:27.11,0:08:31.24,Main-207+,,0,0,0,,S-S-Seni şerefsiz!Dialogue: 50,0:08:31.24,0:08:35.66,Main-207+,,0,0,0,,Övündüğüm gözlerimin ve burnumun şeklini değiştirmişsin!Dialogue: 50,0:08:37.20,0:08:39.67,Main-207+,,0,0,0,,Şeytansın sen!Dialogue: 50,0:08:40.25,0:08:42.17,Main-207+,,0,0,0,,Oh, normale döndün.Dialogue: 50,0:08:44.09,0:08:45.50,Main-207+,,0,0,0,,Haklısın!Dialogue: 50,0:08:45.50,0:08:47.76,Main-207+,,0,0,0,,Bir dakikalığına normale döndüğümü hissettim.Dialogue: 50,0:08:49.26,0:08:52.26,Main-207+,,0,0,0,,Sanırım sadece hayal ettim.Dialogue: 50,0:08:52.68,0:08:55.26,Main-207+,,0,0,0,,Üç günaha teşebbüs ettin.Dialogue: 50,0:08:56.22,0:09:00.98,Main-207+,,0,0,0,,Bir: Karşımda kendine aşçı dedin.Dialogue: 50,0:09:00.98,0:09:05.11,Main-207+,,0,0,0,,İki: Yiyeceği ziyan ettin.Dialogue: 50,0:09:05.11,0:09:06.15,Main-207+,,0,0,0,,Üç:...Dialogue: 50,0:09:06.69,0:09:09.99,Main-207+,,0,0,0,,...Arkadaşıma hakaret ettin!Dialogue: 50,0:09:20.37,0:09:23.33,Main-207+,,0,0,0,,Laftan ibaretsen böyle olur.Dialogue: 50,0:09:25.09,0:09:30.80,Main-207+,,0,0,0,,Dört bacağın olunca güçlendiğini göremiyorum, sentor.Dialogue: 50,0:09:37.60,0:09:40.35,Main-207+,,0,0,0,,D-D-Düşüyorum!Dialogue: 50,0:09:47.19,0:09:48.98,Main-207+,,0,0,0,,Ne acıklı bir manzara.Dialogue: 50,0:09:48.98,0:09:50.61,Main-207+,,0,0,0,,Kahretsin.Dialogue: 50,0:09:52.32,0:09:53.57,Main-207+,,0,0,0,,Seni kurtarmamı ister misin?Dialogue: 50,0:09:58.83,0:10:00.58,Main-207+,,0,0,0,,Lanet olası!Dialogue: 50,0:10:05.08,0:10:06.96,Main-207+,,0,0,0,,Hayır, hayır.Dialogue: 50,0:10:20.85,0:10:22.60,Main-207+,,0,0,0,,Beni kurtaracak mısın?Dialogue: 50,0:10:22.60,0:10:25.35,Main-207+,,0,0,0,,Kurtarılmaya ihtiyacım yok, aptal.Dialogue: 50,0:10:26.73,0:10:28.57,Main-207+,,0,0,0,,Nihayet seni yakaladım.Dialogue: 50,0:10:28.57,0:10:33.65,Main-207+,,0,0,0,,Şimdi 4 bacak fark yaratıyor mu bakalım?Dialogue: 50,0:10:33.65,0:10:35.78,Main-207+,,0,0,0,,Kapa çeneni, seni pislik!Dialogue: 50,0:10:35.78,0:10:38.28,Main-207+,,0,0,0,,Beni normale döndür!Dialogue: 50,0:10:40.70,0:10:45.00,Main-207+,,0,0,0,,O kapının ardında kurtarılmayı bekleyen bir arkadaş var.Dialogue: 50,0:10:49.75,0:10:52.63,Main-207+,,0,0,0,,Geçmene izin vermeyeceğimi söylediysem, izin vermeyeceğim!Dialogue: 50,0:10:52.63,0:10:56.76,Main-207+,,0,0,0,,Ramen Kenpo Urahiden: Menkiri DokupouchouDialogue: 50,0:10:52.63,0:10:56.76,Attack,,0,0,0,,Ramen Kenpo Gizli Teknik: Zehirli Mutfak BıçağıDialogue: 50,0:10:57.39,0:10:58.97,Main-207+,,0,0,0,,Sana değerse öleceksin.Dialogue: 50,0:10:59.39,0:11:01.18,Main-207+,,0,0,0,,Dialogue: 50,0:11:01.18,0:11:05.19,Main-207+,,0,0,0,,O kadın tarafından kandırılmadınız mı?Dialogue: 50,0:11:05.44,0:11:07.39,Main-207+,,0,0,0,,O kızın tüm bildiği...Dialogue: 50,0:11:07.39,0:11:11.40,Main-207+,,0,0,0,,...nasıl ihanet edileceğidir.  Kadınların en kötüsüdür.Dialogue: 50,0:11:11.40,0:11:13.24,Main-207+,,0,0,0,,Canını alacağım!Dialogue: 50,0:11:13.24,0:11:15.91,Main-207+,,0,0,0,,Dialogue: 50,0:11:17.36,0:11:18.82,Main-207+,,0,0,0,,Santen...Dialogue: 50,0:11:17.36,0:11:18.82,Attack,,0,0,0,,3 NoktaDialogue: 50,0:11:19.33,0:11:20.62,Main-207+,,0,0,0,,Découpage!Dialogue: 50,0:11:19.33,0:11:20.62,Attack,,0,0,0,,DoğramaDialogue: 50,0:12:05.08,0:12:07.50,Main-207+,,0,0,0,,Kollarım ve bacaklarım bağlandı!Dialogue: 50,0:12:08.25,0:12:09.54,Main-207+,,0,0,0,,Dikkatsizlik ettim.Dialogue: 50,0:12:11.42,0:12:12.42,Main-207+,,0,0,0,,Dikkatsizlik mi?Dialogue: 50,0:12:14.30,0:12:15.84,Main-207+,,0,0,0,,Mazeretlerine son ver!Dialogue: 50,0:12:21.55,0:12:27.52,Main-207+,,0,0,0,,Hazır konuşabiliyorken  son sözlerini söylemeye ne dersin, birader?Dialogue: 50,0:12:29.23,0:12:33.52,Main-207+,,0,0,0,,Bu dövüşe devam edeceğimizi sanma.Dialogue: 50,0:12:33.52,0:12:34.57,Main-207+,,0,0,0,,Ne?Dialogue: 50,0:12:35.15,0:12:39.53,Main-207+,,0,0,0,,Tüm saldırılarımdan kaçındığın için...Dialogue: 50,0:12:41.45,0:12:46.50,Main-207+,,0,0,0,,...öldürücü yumruğumun gücünü bilmiyorsun.Dialogue: 50,0:12:48.46,0:12:50.29,Main-207+,,0,0,0,,Ultimate...Dialogue: 50,0:12:48.46,0:12:50.29,Attack,,0,0,0,,NihaiDialogue: 50,0:12:50.29,0:12:52.67,Main-207+,,0,0,0,,Hammer!Dialogue: 50,0:12:50.29,0:12:52.67,Attack,,0,0,0,,ÇekiçDialogue: 50,0:13:32.21,0:13:34.59,Main-207+,,0,0,0,,Sen de nereden çıktın?Dialogue: 50,0:13:35.71,0:13:38.76,Main-207+,,0,0,0,,Hey, ramen herifin icabına baktın mı?Dialogue: 50,0:13:38.76,0:13:40.63,Main-207+,,0,0,0,,Demin hallettim.Dialogue: 50,0:13:45.18,0:13:47.39,Main-207+,,0,0,0,,Aniden çok gürültülü oldu.Dialogue: 50,0:13:47.39,0:13:51.10,Main-207+,,0,0,0,,O zaman bize eşlik eden askerler ortadan kaldırıldı mı?Dialogue: 50,0:13:51.52,0:13:53.98,Main-207+,,0,0,0,,Zaten onlardan fazla bir şey ummuyorduk.Dialogue: 50,0:13:56.52,0:14:00.36,Main-207+,,0,0,0,,Yani Robin-chan'ı kaçıranlar bunlar mı?Dialogue: 50,0:14:00.36,0:14:03.45,Main-207+,,0,0,0,,Dikkatli ol.  Bu adamların tuhaf hamleleri var.Dialogue: 50,0:14:07.83,0:14:09.66,Main-207+,,0,0,0,,Bu kim?Dialogue: 50,0:14:09.66,0:14:13.67,Main-207+,,0,0,0,,Corgi, CP9'un yeni üyesi olduğunu söyledi.Dialogue: 50,0:14:13.67,0:14:17.67,Main-207+,,0,0,0,,Adı Nero.  Dört gücün nasıl kullanılacağını biliyor.Dialogue: 50,0:14:21.97,0:14:23.63,Main-207+,,0,0,0,,Lanet olası!Dialogue: 50,0:14:23.63,0:14:25.64,Main-207+,,0,0,0,,Şimdi anlayacaksın!Dialogue: 50,0:14:25.64,0:14:28.64,Main-207+,,0,0,0,,Ben dövüş dehası olarak bilinirdim.Dialogue: 50,0:14:28.64,0:14:30.27,Main-207+,,0,0,0,,Artık umurumda değil...Dialogue: 50,0:14:30.60,0:14:32.23,Main-207+,,0,0,0,,Seni öldüreceğim!Dialogue: 50,0:14:34.14,0:14:36.36,Main-207+,,0,0,0,,Hey, acemi çaylak.Dialogue: 50,0:14:36.36,0:14:40.36,Main-207+,,0,0,0,,Ah, sen Rob Lucci olmalısın.Dialogue: 50,0:14:40.36,0:14:42.44,Main-207+,,0,0,0,,Birazdan kendimi tanıtmış olurum.Dialogue: 50,0:14:42.44,0:14:44.07,Main-207+,,0,0,0,,Bir saniye bekle.Dialogue: 50,0:14:44.07,0:14:46.45,Main-207+,,0,0,0,,O herifi geberteceğim.Dialogue: 50,0:14:46.45,0:14:48.95,Main-207+,,0,0,0,,Franky'yi canlı yakalaman gerekiyor.Dialogue: 50,0:14:48.95,0:14:52.16,Main-207+,,0,0,0,,Ama hislerinin seni ele geçirmesine izin verdin.Dialogue: 50,0:14:52.16,0:14:54.16,Main-207+,,0,0,0,,Unut gitsin.Dialogue: 50,0:14:54.96,0:14:57.96,Main-207+,,0,0,0,,Canını kurtarmak için üç saniyen var.Dialogue: 50,0:14:59.80,0:15:00.63,Main-207+,,0,0,0,,Üç,...Dialogue: 50,0:15:00.63,0:15:02.88,Main-207+,,0,0,0,,Canımı kurtarmak için mi? Kimden kaçayım?Dialogue: 50,0:15:03.22,0:15:04.47,Main-207+,,0,0,0,,..iki,...Dialogue: 50,0:15:04.47,0:15:06.26,Main-207+,,0,0,0,,Hey?! Dur bi' saniye!Dialogue: 50,0:15:06.26,0:15:07.80,Main-207+,,0,0,0,,Şaka mı yapıyorsun?Dialogue: 50,0:15:08.14,0:15:09.76,Main-207+,,0,0,0,,...bir.Dialogue: 50,0:15:09.76,0:15:12.22,Main-207+,,0,0,0,,Dur! Aptallık etme!Dialogue: 50,0:15:12.22,0:15:13.43,Main-207+,,0,0,0,,Soru!Dialogue: 50,0:15:12.22,0:15:13.43,Attack,,0,0,0,,KazıDialogue: 50,0:15:28.57,0:15:32.91,Main-207+,,0,0,0,,İşe yaramaz pisliğin tekisin...Dialogue: 50,0:15:32.91,0:15:36.67,Main-207+,,0,0,0,,...ve kendine CP9 diyorsun.Dialogue: 50,0:15:41.25,0:15:45.72,Main-207+,,0,0,0,,Süper insan olduğunu iddia etmeden önce 6 güçte usta olmalısın, velet.Dialogue: 50,0:15:45.72,0:15:46.59,Main-207+,,0,0,0,,Kalifa.Dialogue: 50,0:15:46.59,0:15:47.34,Main-207+,,0,0,0,,Evet.Dialogue: 50,0:15:47.76,0:15:49.93,Main-207+,,0,0,0,,Rapora, yeni adamın...Dialogue: 50,0:15:49.93,0:15:54.18,Main-207+,,0,0,0,,...çok güçsüz ve işe yaramaz olduğunu da ekle.Dialogue: 50,0:15:54.18,0:15:55.18,Main-207+,,0,0,0,,Anlaşıldı.Dialogue: 50,0:15:57.64,0:16:00.11,Main-207+,,0,0,0,,Bu adamlar adaleti mi temsil ediyor?Dialogue: 50,0:16:00.11,0:16:02.73,Main-207+,,0,0,0,,Bizden çok daha kötüler, ha?Dialogue: 50,0:16:05.61,0:16:10.07,Main-207+,,0,0,0,,Sanırım neden burada olduğunu sormama gerek yok, davetsiz misafir.Dialogue: 50,0:16:10.78,0:16:16.29,Main-207+,,0,0,0,,Giriş şekline bakılırsa,  pek sabırlı biri gibi görünmüyorsun.Dialogue: 50,0:16:16.29,0:16:19.54,Main-207+,,0,0,0,,Evet, ailem beni iyi yetiştiremedi.Dialogue: 50,0:16:19.54,0:16:21.75,Main-207+,,0,0,0,,Nico Robin için buraya geldiysen...Dialogue: 50,0:16:22.92,0:16:24.38,Main-207+,,0,0,0,,...bundan vazgeç.Dialogue: 50,0:16:24.38,0:16:29.09,Main-207+,,0,0,0,,Onun sorunu, sizin anlayışınızın ötesinde.Dialogue: 50,0:16:29.09,0:16:33.06,Main-207+,,0,0,0,,Dünyaya uğursuzluk getiren insanlar vardır.Dialogue: 50,0:16:33.06,0:16:36.56,Main-207+,,0,0,0,,Onlar olmasa dünya daha güzel bir yer olurdu.Dialogue: 50,0:16:37.89,0:16:39.35,Main-207+,,0,0,0,,Örneğin,...Dialogue: 50,0:16:42.98,0:16:45.82,Main-207+,,0,0,0,,...dünyayı yok etme kapasitesine sahip uyuyan bir şeytan var.Dialogue: 50,0:16:46.69,0:16:53.91,Main-207+,,0,0,0,,Uyuyan şeytanı uyandırma yeteneğine sahip biri varsa, sekiz yaşında bile olsa,...Dialogue: 50,0:16:53.91,0:16:55.74,Main-207+,,0,0,0,,...bütün dünyanın ve...Dialogue: 50,0:16:57.12,0:17:03.17,Main-207+,,0,0,0,,...üzerinde yaşayanların iyiliği için onu yok etmemiz gerekir.Dialogue: 50,0:17:03.71,0:17:06.17,Main-207+,,0,0,0,,Ha? Ne demeye çalışıyorsun?Dialogue: 50,0:17:06.80,0:17:12.22,Main-207+,,0,0,0,,Sana anlattığım şey,  tam olarak Nico Robin'in asıl suçu.Dialogue: 50,0:17:13.14,0:17:16.97,Main-207+,,0,0,0,,Şimdi, daha derin geçmişi olan bir suçlu.Dialogue: 50,0:17:16.97,0:17:20.14,Main-207+,,0,0,0,,Ama her şey böyle başladı.Dialogue: 50,0:17:20.14,0:17:25.40,Main-207+,,0,0,0,,Zaten var olmakla günah işlemişti.Dialogue: 50,0:17:25.40,0:17:29.61,Main-207+,,0,0,0,,İnsanları mutlu etmesinin tek yolu, yok olması.Dialogue: 50,0:17:29.61,0:17:32.28,Main-207+,,0,0,0,,Onun taşıdığı talihsizlik budur.Dialogue: 50,0:17:33.66,0:17:39.33,Main-207+,,0,0,0,,Aslında, 20 yıl önce ölmesi gerekiyordu.Dialogue: 50,0:17:39.33,0:17:42.29,Main-207+,,0,0,0,,Çok geç olmadan önce...Dialogue: 50,0:17:42.29,0:17:44.75,Main-207+,,0,0,0,,...ölecek olmasına seviniyorum.Dialogue: 50,0:17:44.75,0:17:45.67,Main-207+,,0,0,0,,Hey...Dialogue: 50,0:17:48.09,0:17:51.01,Main-207+,,0,0,0,,Bu kadar saçmalık yeter!Dialogue: 50,0:17:51.51,0:17:52.93,Main-207+,,0,0,0,,Lanet olası!Dialogue: 50,0:17:53.47,0:17:55.60,Main-207+,,0,0,0,,Sakın bir kelime daha etme!Dialogue: 50,0:17:56.10,0:17:59.89,Main-207+,,0,0,0,,Muhtemelen Hükümet'in, Nico Robin'in...Dialogue: 50,0:18:04.56,0:18:10.36,Main-207+,,0,0,0,,...bilgilerini ve deneyimlerini ele geçirmesi birkaç yıl sürecek.Dialogue: 50,0:18:11.45,0:18:16.70,Main-207+,,0,0,0,,Sonra hangi kötü yöntemle olursa olsun,  o korkunç kadın ölece–Dialogue: 50,0:18:16.70,0:18:18.66,Main-207+,,0,0,0,,Buna asla izin vermeyeceğim!Dialogue: 50,0:18:18.66,0:18:20.70,Secondary-207+,,0,0,0,,Hey, hey, bekle, Robin!Dialogue: 50,0:18:20.70,0:18:22.71,Secondary-207+,,0,0,0,,O tarafa gitme!Dialogue: 50,0:18:22.71,0:18:24.71,Secondary-207+,,0,0,0,,Hey! Cidden! Cidden! Bekle!Dialogue: 50,0:18:26.34,0:18:28.38,Main-207+,,0,0,0,,Hey, dur dedim.Dialogue: 50,0:18:30.42,0:18:32.01,Main-207+,,0,0,0,,Robin-chan!Dialogue: 50,0:18:32.63,0:18:33.84,Main-207+,,0,0,0,,Başımız dertte.Dialogue: 50,0:18:33.84,0:18:36.72,Main-207+,,0,0,0,,Tanrıya şükür! İyi misin?! Yaralandın mı?!Dialogue: 50,0:18:37.85,0:18:39.68,Main-207+,,0,0,0,,Bu çok kötü oldu!Dialogue: 50,0:18:39.68,0:18:44.90,Main-207+,,0,0,0,,Oraya tırmanmak ve subayın işini bitirmek için o kadar uğraştım.Dialogue: 50,0:18:44.90,0:18:47.40,Main-207+,,0,0,0,,Nico Robin o mu?Dialogue: 50,0:18:47.40,0:18:50.36,Main-207+,,0,0,0,,Aranıyor posterindeki kıza çok benziyor.Dialogue: 50,0:18:54.07,0:18:56.41,Main-207+,,0,0,0,,Hemen bu heriflerin icabına bakacağım...Dialogue: 50,0:18:56.95,0:19:01.58,Main-207+,,0,0,0,,...ve sonra birlikte kaçacağız, olur mu Robin-chan?1Dialogue: 50,0:19:09.71,0:19:10.55,Main-207+,,0,0,0,,Usopp!Dialogue: 50,0:19:10.55,0:19:11.88,Main-207+,,0,0,0,,Ne yapıyorsun, Robin-chan?Dialogue: 50,0:19:19.76,0:19:21.89,Main-207+,,0,0,0,,Ah...Dialogue: 50,0:19:24.10,0:19:25.35,Main-207+,,0,0,0,,Kelimeler size...Dialogue: 50,0:19:25.94,0:19:27.81,Main-207+,,0,0,0,,...fayda etmiyor gibi.Dialogue: 50,0:19:36.91,0:19:37.99,Main-207+,,0,0,0,,Franky-kun!Dialogue: 50,0:19:38.57,0:19:40.33,Main-207+,,0,0,0,,Üçüncü vagonu ayır!Dialogue: 50,0:19:41.45,0:19:42.83,Main-207+,,0,0,0,,Niye?Dialogue: 50,0:19:42.83,0:19:43.95,Main-207+,,0,0,0,,Kaçmak için.Dialogue: 50,0:19:43.95,0:19:45.04,Main-207+,,0,0,0,,Kaçmak mı?Dialogue: 50,0:19:45.04,0:19:46.96,Main-207+,,0,0,0,,Hey, ne yapmaya çalışıyorsun?Dialogue: 50,0:19:47.29,0:19:50.21,Main-207+,,0,0,0,,Sen de hazır olmalısın. Bir anda olacak.Dialogue: 50,0:19:50.59,0:19:52.71,Main-207+,,0,0,0,,Franky'nin kaçmasına izin verme.Dialogue: 50,0:19:52.71,0:19:53.38,Main-207+,,0,0,0,,Anlaşıldı.Dialogue: 50,0:19:54.72,0:19:57.97,Main-207+,,0,0,0,,Sogeking...Dialogue: 50,0:19:57.97,0:20:00.22,Main-207+,,0,0,0,,Smoke Star!Dialogue: 50,0:19:57.97,0:20:00.22,Attack,,0,0,0,,Duman YıldızıDialogue: 50,0:20:05.89,0:20:07.73,Main-207+,,0,0,0,,Ne aptalca bir numara!Dialogue: 50,0:20:10.15,0:20:11.40,Main-207+,,0,0,0,,Hadi ama!Dialogue: 50,0:20:14.23,0:20:16.78,Main-207+,,0,0,0,,Nico Robin bizimle geliyor!Dialogue: 50,0:20:20.66,0:20:23.33,Main-207+,,0,0,0,,Hey! Bırak beni!Dialogue: 50,0:20:25.12,0:20:27.21,Main-207+,,0,0,0,,– Aferin! – Aferin!Dialogue: 50,0:20:27.54,0:20:30.67,Main-207+,,0,0,0,,Kaçın!Dialogue: 50,0:20:33.80,0:20:41.55,Main-207+,,0,0,0,,Geri dönün!!Dialogue: 50,0:20:33.80,0:20:41.55,Note,,0,0,0,,Kaeru: Hem kurbağa, hem de dönmek anlamına geldiği için karışıklık oluyor.Dialogue: 50,0:20:41.55,0:20:43.31,Main-207+,,0,0,0,,Niye?! Buraya kadar geldik!Dialogue: 50,0:20:43.31,0:20:44.81,Main-207+,,0,0,0,,Hasır Şapka-san!Dialogue: 50,0:20:44.81,0:20:48.02,Main-207+,,0,0,0,,– Evet! Evet! Bize sebebini söyle! – Evet! Evet! Bize sebebini söyle!Dialogue: 50,0:20:48.02,0:20:50.90,Main-207+,,0,0,0,,Öyle demek istemedim!!Dialogue: 50,0:20:50.90,0:20:51.98,Main-207+,,0,0,0,,– Ha? – Ha?Dialogue: 50,0:20:51.98,0:20:58.20,Main-207+,,0,0,0,,Raylarda şu koca kurbağa var! Durduk yerde ortaya çıktı!Dialogue: 50,0:20:59.95,0:21:01.41,Main-207+,,0,0,0,,Yokozuna!Dialogue: 50,0:21:01.41,0:21:02.82,Main-207+,,0,0,0,,O mu?Dialogue: 50,0:21:03.20,0:21:06.33,Main-207+,,0,0,0,,– Ne koca bir kurbağa! – Ne koca bir kurbağa!Dialogue: 50,0:21:06.33,0:21:07.79,Main-207+,,0,0,0,,Dikkat et!Dialogue: 50,0:21:07.79,0:21:10.25,Main-207+,,0,0,0,,Yoldan çekil, kurbağa!Dialogue: 50,0:21:11.54,0:21:15.34,Main-207+,,0,0,0,,Sana çarpacağız!Dialogue: 50,0:21:20.59,0:21:22.34,Main-207+,,0,0,0,,Başardık!Dialogue: 50,0:21:22.34,0:21:24.55,Main-207+,,0,0,0,,Robin'i geri aldık!Dialogue: 50,0:21:24.55,0:21:26.52,Main-207+,,0,0,0,,Epey şaşırdım.Dialogue: 50,0:21:26.52,0:21:29.52,Main-207+,,0,0,0,,Acayip bir çekilme yöntemi.Dialogue: 50,0:21:29.52,0:21:33.31,Main-207+,,0,0,0,,Kimse sis bombası kadar aptalca bir şey beklemezdi.Dialogue: 50,0:21:35.82,0:21:41.07,Main-207+,,0,0,0,,Şu korkunç adamlarla dövüşmeden görevimizi tamamlamak iyi fikirdi!Dialogue: 50,0:21:41.57,0:21:42.57,Main-207+,,0,0,0,,Ama...Dialogue: 50,0:21:43.95,0:21:46.54,Main-207+,,0,0,0,,...fazla kolay oldu.Dialogue: 50,0:21:46.54,0:21:51.00,Main-207+,,0,0,0,,Evet, vagonlar gerçekten uzaklaşana kadar, tetikte olmayı bırakmayın.Dialogue: 50,0:21:55.54,0:21:56.67,Main-207+,,0,0,0,,Ne...?!Dialogue: 50,0:22:00.13,0:22:01.76,Main-207+,,0,0,0,,Dikenli kamçı mı?!Dialogue: 50,0:22:05.01,0:22:05.97,Main-207+,,0,0,0,,Onları yakaladım.Dialogue: 50,0:22:06.43,0:22:07.64,Main-207+,,0,0,0,,Blueno.Dialogue: 50,0:22:07.64,0:22:08.72,Main-207+,,0,0,0,,Tamam.Dialogue: 50,0:22:09.60,0:22:11.31,Main-207+,,0,0,0,,Geçmek için kırbaçları mı kullanacak?Dialogue: 50,0:22:18.73,0:22:21.61,Main-207+,,0,0,0,,Onlara doğru çekildik!Dialogue: 50,0:22:21.61,0:22:23.15,Main-207+,,0,0,0,,Ne güç ama.Dialogue: 50,0:22:27.08,0:22:29.91,Main-207+,,0,0,0,,Sis perdesi epey berbat bir fikirdi.Dialogue: 50,0:22:30.95,0:22:33.37,Main-207+,,0,0,0,,Demek gerçekten işe yaramazdı.Dialogue: 50,0:22:38.21,0:22:40.84,Main-207+,,0,0,0,,Hasır Şapka korsanlarını öldürmeyin.Dialogue: 50,0:22:41.21,0:22:43.05,Main-207+,,0,0,0,,Bir söz verdik.Dialogue: 50,0:22:43.55,0:22:45.01,Main-207+,,0,0,0,,Sogeking,...Dialogue: 50,0:22:45.01,0:22:45.93,Main-207+,,0,0,0,,Oh, evet?Dialogue: 50,0:22:45.93,0:22:47.22,Main-207+,,0,0,0,,...Robin-chan'ı hayatın pahasına koru!Dialogue: 50,0:22:47.64,0:22:49.18,Main-207+,,0,0,0,,Ha...? Tamam!Dialogue: 50,0:22:49.18,0:22:51.14,Main-207+,,0,0,0,,Peşimizden gelmenize...Dialogue: 50,0:22:51.56,0:22:53.81,Main-207+,,0,0,0,,...engel olacağım!Dialogue: 50,0:22:57.73,0:23:00.57,Main-207+,,0,0,0,,Bu sertlik de ne böyle?Dialogue: 50,0:23:00.98,0:23:03.32,Main-207+,,0,0,0,,Sana bahsettiğim tuhaf dövüş stilleri bu.Dialogue: 50,0:23:10.54,0:23:12.66,Main-207+,,0,0,0,,Concassé!Dialogue: 50,0:23:10.54,0:23:12.66,Attack,,0,0,0,,EzişDialogue: 50,0:23:22.26,0:23:24.88,Main-207+,,0,0,0,,İnanılmaz güçlü bir tekmeydi.Dialogue: 50,0:23:24.88,0:23:26.76,Main-207+,,0,0,0,,Neredeyse Demir Kütle'sini kırıyordu.Dialogue: 50,0:23:27.22,0:23:29.18,Main-207+,,0,0,0,,Blueno, onu küçümseme!Dialogue: 50,0:23:29.80,0:23:33.35,Main-207+,,0,0,0,,Kafasına konan bir ödül yok ama yüksek ihtimalle ana dövüşçülerden biri.Dialogue: 50,0:23:33.35,0:23:35.81,Main-207+,,0,0,0,,Hey, R-Robin! Bir saniye bekle!Dialogue: 50,0:23:36.27,0:23:38.27,Main-207+,,0,0,0,,Ah... N-ne yapıyorsun?Dialogue: 50,0:23:38.65,0:23:40.11,Main-207+,,0,0,0,,Ocho Fleur:Dialogue: 50,0:23:38.65,0:23:40.11,Attack,,0,0,0,,Sekiz Çiçek:Dialogue: 50,0:23:40.61,0:23:41.65,Main-207+,,0,0,0,,Clutch!Dialogue: 50,0:23:40.61,0:23:41.65,Attack,,0,0,0,,KavramaDialogue: 50,0:23:42.73,0:23:43.99,Main-207+,,0,0,0,,Uzun burun!Dialogue: 50,0:23:47.70,0:23:50.16,Main-207+,,0,0,0,,Bu da ne?! Robin-chan!Dialogue: 50,0:23:52.87,0:23:56.33,Main-207+,,0,0,0,,Daha kaç kez işime karışmayın demek zorundayım?!Dialogue: 50,0:24:01.96,0:24:03.34,Main-207+,,0,0,0,,Usopp...Dialogue: 50,0:24:03.34,0:24:05.88,Main-207+,,0,0,0,,Hey, nereye baktığına dikkat et.Dialogue: 50,0:24:13.60,0:24:15.06,Main-207+,,0,0,0,,Kaş!Dialogue: 50,0:24:18.02,0:24:20.94,Main-207+,,0,0,0,,Üfff, hepiniz aynısınız.Dialogue: 50,0:24:21.52,0:24:24.86,Main-207+,,0,0,0,,Mesele arkadaşınız olunca çok inatçısınız.Dialogue: 50,0:24:25.61,0:24:27.07,Main-207+,,0,0,0,,Bu...Dialogue: 50,0:24:28.07,0:24:33.33,Main-207+,,0,0,0,,...kaçmanız için büyük bir fırsat!Dialogue: 50,0:25:10.41,0:25:11.78,Main-207+,,0,0,0,,Franky!Dialogue: 50,0:25:16.16,0:25:17.79,Main-207+,,0,0,0,,Buna gerek yoktu.Dialogue: 50,0:25:18.91,0:25:21.50,Main-207+,,0,0,0,,Bakın işler ne hale geldi!Dialogue: 50,0:25:22.50,0:25:26.46,Main-207+,,0,0,0,,Söyle bana.  Onlara niye yardım ediyorsun?Dialogue: 50,0:25:26.46,0:25:28.59,Main-207+,,0,0,0,,Onları izlemeye dayanamıyorum.Dialogue: 50,0:25:28.59,0:25:32.97,Main-207+,,0,0,0,,Bazı ekipler isteseler bile asla bir araya gelemezler.Dialogue: 50,0:25:33.30,0:25:36.14,Main-207+,,0,0,0,,Tam olarak kimden bahsediyorsun?Dialogue: 50,0:25:37.14,0:25:39.77,Main-207+,,0,0,0,,Hey, beni dert etmeyin!Dialogue: 50,0:25:39.77,0:25:41.14,Main-207+,,0,0,0,,Bir planım var!Dialogue: 50,0:25:41.14,0:25:44.61,Main-207+,,0,0,0,,Hasır Şapka'yla karşılaşınca şehre dönün!Dialogue: 50,0:25:45.11,0:25:46.02,Main-207+,,0,0,0,,Franky!Dialogue: 50,0:25:46.02,0:25:47.36,Main-207+,,0,0,0,,Dur!Dialogue: 50,0:25:47.36,0:25:49.07,Main-207+,,0,0,0,,Kaçmaya çalışmıyorum.Dialogue: 50,0:25:50.07,0:25:52.07,Main-207+,,0,0,0,,Dur Robin-chan.Dialogue: 50,0:25:52.91,0:25:55.53,Main-207+,,0,0,0,,Buraya kadar gelmişken neler söylüyorsun?Dialogue: 50,0:25:56.24,0:26:00.25,Main-207+,,0,0,0,,Tüm durumu biliyoruz ve seni kurtarmaya geldik.Dialogue: 50,0:26:01.71,0:26:05.42,Main-207+,,0,0,0,,Hükümetin Yıkım Çağrısı tehdidinin icabına bakacak bir yol bulursak,...Dialogue: 50,0:26:05.79,0:26:09.30,Main-207+,,0,0,0,,...onlara boyun eğmen için bir sebep kalmaz, değil mi?Dialogue: 50,0:26:16.26,0:26:19.10,Main-207+,,0,0,0,,Şu Yıkım Çağrısı...Dialogue: 50,0:26:25.11,0:26:27.02,Main-207+,,0,0,0,,...ciddi bir sorun.Dialogue: 50,0:26:32.45,0:26:33.40,Main-207+,,0,0,0,,Rankyaku!Dialogue: 50,0:26:32.45,0:26:33.40,Attack,,0,0,0,,Fırtına TekmesiDialogue: 50,0:26:33.40,0:26:34.74,Main-207+,,0,0,0,,Ne...?!Dialogue: 50,0:26:38.54,0:26:39.49,Main-207+,,0,0,0,,Sanji!Dialogue: 50,0:26:44.29,0:26:46.71,Main-207+,,0,0,0,,O da neydi?Dialogue: 50,0:26:46.71,0:26:49.71,Main-207+,,0,0,0,,Durduk yerde ortaya çıktı!Dialogue: 50,0:26:53.72,0:26:55.76,Main-207+,,0,0,0,,Blueno kayboldu!Dialogue: 50,0:26:56.22,0:26:57.39,Main-207+,,0,0,0,,Kaybolmadı.Dialogue: 50,0:26:57.89,0:27:03.48,Main-207+,,0,0,0,,Bu, onun Şeytan Meyvesi yeteneği.  Gücünün son şekli olan hava kapısıyla...Dialogue: 50,0:27:03.48,0:27:06.19,Main-207+,,0,0,0,,...atmosferde kapı oluşturuyor.Dialogue: 50,0:27:06.60,0:27:09.57,Main-207+,,0,0,0,,Bizden kaçmak gibi bir şeyi...Dialogue: 50,0:27:09.57,0:27:11.19,Main-207+,,0,0,0,,...asla yapamayacaksınız.Dialogue: 50,0:27:25.08,0:27:26.42,Main-207+,,0,0,0,,Robin...Dialogue: 50,0:27:27.79,0:27:28.50,Main-207+,,0,0,0,,Geri-Dialogue: 50,0:27:31.42,0:27:32.55,Main-207+,,0,0,0,,Shigan.Dialogue: 50,0:27:31.42,0:27:32.55,Attack,,0,0,0,,Parmak TabancaDialogue: 50,0:27:40.89,0:27:41.76,Main-207+,,0,0,0,,Usopp!Dialogue: 50,0:27:41.76,0:27:43.02,Main-207+,,0,0,0,,Tekkai.Dialogue: 50,0:27:41.76,0:27:43.02,Attack,,0,0,0,,Demir KütleDialogue: 50,0:27:46.35,0:27:48.86,Main-207+,,0,0,0,,Az önceki saldırımı hissetmedin mi?Dialogue: 50,0:27:48.86,0:27:50.98,Main-207+,,0,0,0,,Bu tekmede hiç güç yok.Dialogue: 50,0:28:04.91,0:28:06.50,Main-207+,,0,0,0,,Epey ısrarcısın.Dialogue: 50,0:28:06.50,0:28:07.50,Main-207+,,0,0,0,,Kes şunu!Dialogue: 50,0:28:10.04,0:28:12.25,Main-207+,,0,0,0,,Kaçmayacağım.Dialogue: 50,0:28:12.92,0:28:14.96,Main-207+,,0,0,0,,Bu sizin için yeterli olmalı.Dialogue: 50,0:28:15.34,0:28:17.93,Main-207+,,0,0,0,,Onlar başlattı.Dialogue: 50,0:28:18.51,0:28:19.84,Main-207+,,0,0,0,,Elimde değil.Dialogue: 50,0:28:20.43,0:28:23.26,Main-207+,,0,0,0,,O zaman bir an önce buradan gidelim.Dialogue: 50,0:28:26.94,0:28:28.39,Main-207+,,0,0,0,,Dur!Dialogue: 50,0:28:33.86,0:28:35.11,Main-207+,,0,0,0,,Her şey yolunda,...Dialogue: 50,0:28:35.11,0:28:36.49,Main-207+,,0,0,0,,...Robin...!Dialogue: 50,0:28:37.61,0:28:40.16,Main-207+,,0,0,0,,İyi olacaksın.Dialogue: 50,0:28:41.12,0:28:45.33,Main-207+,,0,0,0,,Hala... Hala bir şey saklıyorsun, değil mi?Dialogue: 50,0:28:50.00,0:28:52.25,Main-207+,,0,0,0,,Sorun değil.Dialogue: 50,0:28:53.38,0:28:54.38,Main-207+,,0,0,0,,Ama...Dialogue: 50,0:28:54.80,0:28:55.96,Main-207+,,0,0,0,,...korsanlar,...Dialogue: 50,0:28:57.26,0:29:00.01,Main-207+,,0,0,0,,...kaptanlarının izni olmadan...Dialogue: 50,0:29:01.84,0:29:04.14,Main-207+,,0,0,0,,...tayfayı...Dialogue: 50,0:29:04.14,0:29:05.56,Main-207+,,0,0,0,,...terkedemez.Dialogue: 50,0:29:09.06,0:29:10.48,Main-207+,,0,0,0,,Bu yüzden...Dialogue: 50,0:29:11.19,0:29:12.19,Main-207+,,0,0,0,,...Luffy'ye..Dialogue: 50,0:29:14.23,0:29:15.48,Main-207+,,0,0,0,,...inanmalısın!Dialogue: 50,0:29:34.96,0:29:36.50,Main-207+,,0,0,0,,Dur, Robin-chan!Dialogue: 50,0:29:37.13,0:29:40.47,Main-207+,,0,0,0,,Faydasız. Nico Robin, sözünden dönemez.Dialogue: 50,0:29:40.47,0:29:42.05,Main-207+,,0,0,0,,Bunu nasıl söyleyebilirsin?Dialogue: 50,0:29:43.01,0:29:46.26,Main-207+,,0,0,0,,Uzun zaman önce bir ada yok edildi.Dialogue: 50,0:29:47.93,0:29:53.02,Main-207+,,0,0,0,,O ada Hükümet tarafından gönderilen Yıkım Çağrısı'na maruz kaldı...Dialogue: 50,0:29:53.02,0:29:55.73,Main-207+,,0,0,0,,...ve yerle bir oldu.Dialogue: 50,0:29:55.73,0:30:01.07,Main-207+,,0,0,0,,O adadan tek kurtulan henüz çocuk yaştaki Nico Robin'di.Dialogue: 50,0:30:01.45,0:30:02.53,Main-207+,,0,0,0,,Ne dedin?!Dialogue: 50,0:30:03.36,0:30:07.33,Main-207+,,0,0,0,,Yıkım Çağrısı, beş koramiral ve  on savaş gemisinin birleşiminden oluşur.Dialogue: 50,0:30:07.33,0:30:11.91,Main-207+,,0,0,0,,Yenilmez ordu gücü Yıkım Çağrısı,...Dialogue: 50,0:30:11.91,0:30:15.42,Main-207+,,0,0,0,,...o kadının asla unutamayacağı bir travmadır.Dialogue: 50,0:30:15.42,0:30:20.97,Main-207+,,0,0,0,,Küçüklüğünden beri içinde biriken korku anısı, arkadaşları üstüne yöneldi.Dialogue: 50,0:30:21.34,0:30:24.89,Main-207+,,0,0,0,,Bize karşı koyma isteğini yitirdi.Dialogue: 50,0:30:25.22,0:30:26.60,Main-207+,,0,0,0,,Yoksa...Dialogue: 50,0:30:27.22,0:30:29.35,Main-207+,,0,0,0,,...tüm bunları bilmenize rağmen...Dialogue: 50,0:30:30.89,0:30:32.77,Main-207+,,0,0,0,,Elbette.Dialogue: 50,0:30:36.90,0:30:38.40,Main-207+,,0,0,0,,Hepiniz...Dialogue: 50,0:30:39.23,0:30:42.20,Main-207+,,0,0,0,,...ne kadar da kokuşmuşsunuz!!Dialogue: 50,0:30:42.82,0:30:45.16,Main-207+,,0,0,0,,Tüm bunlar adalet adına.Dialogue: 50,0:30:45.47,0:30:48.62,Main-207+,,0,0,0,,O kadına sempati duyuyorum.Dialogue: 50,0:30:49.74,0:30:51.91,Main-207+,,0,0,0,,Benimle alay etme!Dialogue: 50,0:31:09.81,0:31:15.27,Main-207+,,0,0,0,,Lanet olsun!!Dialogue: 50,0:31:16.81,0:31:19.61,Main-207+,,0,0,0,,Burası Enies Lobby Yönetim Bürosu.Dialogue: 50,0:31:19.61,0:31:21.82,Main-207+,,0,0,0,,Her şey planlandığı gibi gidiyor mu?Dialogue: 50,0:31:22.28,0:31:26.53,Main-207+,,0,0,0,,Evet, iki suçluyu tam zamanında getireceğiz.Dialogue: 50,0:31:27.20,0:31:30.54,Main-207+,,0,0,0,,Ada görüş alanımızda, birazdan orada olacağız.Dialogue: 50,0:31:30.54,0:31:31.79,Main-207+,,0,0,0,,Anlaşıldı.Dialogue: 50,0:31:31.79,0:31:34.41,Main-207+,,0,0,0,,Öyleyse, dönüşünüzü bekliyor olacağız.Dialogue: 50,0:31:35.54,0:31:39.17,Main-207+,,0,0,0,,Anılarım canlandı.  Beş yıllık ayrılığın ardından böyle olması doğal.Dialogue: 50,0:31:39.96,0:31:42.84,Main-207+,,0,0,0,,Gecesi olmayan ada, Enies Lobby.Dialogue: 0,0:01:50.13,0:01:53.27,Author,,0,0,0,,TR: onepacetr.net | kazaskerDialogue: 0,0:15:36.80,0:15:46.80,Author,,0,0,0,,TR: onepacetr.net | kazaskerDialogue: 0,0:31:43.42,0:31:45.54,Author,,0,0,0,,TR: onepacetr.net | kazaskerDialogue: 0,0:01:50.13,0:01:53.43,Title-207+,,0,0,0,,Gerekli KötülükDialogue: 1,0:01:50.13,0:01:53.43,Title-207+,,0,0,0,,Gerekli KötülükDialogue: 0,0:03:43.29,0:03:44.75,Captions-207+,,0,0,0,,YenilmezDialogue: 1,0:03:43.29,0:03:44.75,Captions-207+,,0,0,0,,YenilmezDialogue: 0,0:04:23.87,0:04:25.16,Captions-207+,,0,0,0,,DönüsümDialogue: 1,0:04:23.87,0:04:25.16,Captions-207+,,0,0,0,,DönüşümDialogue: 0,0:04:25.20,0:04:27.91,Captions-207+,,0,0,0,,SapıkDialogue: 1,0:04:25.20,0:04:27.91,Captions-207+,,0,0,0,,SapıkDialogue: 0,0:00:26.26,0:00:31.82,Credits-207+,,0,0,0,,Video EditingDialogue: 1,0:00:26.26,0:00:31.82,Credits-207+,,0,0,0,,Video EditingDialogue: 2,0:00:26.26,0:00:31.82,Credits-207+,,0,0,0,,Video EditingDialogue: 0,0:00:26.26,0:00:31.82,Credits-207+,,0,0,0,,Galaxy 9000Dialogue: 1,0:00:26.26,0:00:31.82,Credits-207+,,0,0,0,,Galaxy 9000Dialogue: 0,0:00:32.53,0:00:36.98,Credits-207+,,0,0,0,,GraphicsDialogue: 1,0:00:32.53,0:00:36.98,Credits-207+,,0,0,0,,GraphicsDialogue: 2,0:00:32.53,0:00:36.98,Credits-207+,,0,0,0,,GraphicsDialogue: 0,0:00:32.53,0:00:36.98,Credits-207+,,0,0,0,,DatenshiDialogue: 1,0:00:32.53,0:00:36.98,Credits-207+,,0,0,0,,DatenshiDialogue: 0,0:00:37.10,0:00:40.98,Credits-207+,,0,0,0,,KaraokeDialogue: 1,0:00:37.10,0:00:40.98,Credits-207+,,0,0,0,,KaraokeDialogue: 2,0:00:37.10,0:00:40.98,Credits-207+,,0,0,0,,KaraokeDialogue: 0,0:00:37.10,0:00:40.98,Credits-207+,,0,0,0,,KaitouYahikoDialogue: 1,0:00:37.10,0:00:40.98,Credits-207+,,0,0,0,,KaitouYahikoDialogue: 0,0:00:42.48,0:00:47.11,Credits-207+,,0,0,0,,Quality ControlDialogue: 1,0:00:42.48,0:00:47.11,