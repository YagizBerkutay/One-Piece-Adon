Dialogue: 0,0:00:48.32,0:00:52.38,Lyrics-OP5,,0,0,0,,{\fad(75,75)}♪ Sorun yok! Yola çıkalım! ♪
Dialogue: 0,0:00:52.64,0:00:55.92,Lyrics-OP5,,0,0,0,,♪ Güneşi hep kalbimizde tutacağız! ♪
Dialogue: 0,0:00:56.06,0:00:59.34,Lyrics-OP5,,0,0,0,,♪ Birleşmiş ellerimiz bize güç veriyor! ♪
Dialogue: 0,0:00:59.43,0:01:03.01,Lyrics-OP5,,0,0,0,,♪ Hayallerimizi yakalayacağız! ♪
Dialogue: 0,0:01:10.57,0:01:16.82,Lyrics-OP5,,0,0,0,,♪ Birleşmiş güçlerimizle dev bir dalgaya bineceğiz. ♪
Dialogue: 0,0:01:18.08,0:01:24.62,Lyrics-OP5,,0,0,1,,♪ İşte işaret! Başarıya doğru acele edelim! ♪
Dialogue: 0,0:01:25.29,0:01:31.46,Lyrics-OP5,,0,0,0,,♪ Bu bizim yola çıkma vaktimiz. Bir kez demir alınca...
Dialogue: 0,0:01:32.26,0:01:39.34,Lyrics-OP5,,0,0,0,,...gökkuşağı renkli rüzgarla macera denizine doğru yola çıkacağız! ♪
Dialogue: 0,0:01:39.39,0:01:42.88,Lyrics-OP5,,0,0,0,,♪ Bu sıkıntıyla dolu bir yolculuk...
Dialogue: 0,0:01:42.89,0:01:46.60,Lyrics-OP5,,0,0,0,,...ama orada önemli bir şey var. ♪
Dialogue: 0,0:01:46.73,0:01:50.68,Lyrics-OP5,,0,0,0,,♪ Başın derde girerse,...
Dialogue: 0,0:01:50.78,0:01:52.69,Lyrics-OP5,,0,0,0,,...yardım etmek için orada olacağım! ♪
Dialogue: 0,0:01:53.78,0:01:57.69,Lyrics-OP5,,0,0,0,,♪ Sorun yok! Yola çıkalım! ♪
Dialogue: 0,0:01:57.99,0:02:01.15,Lyrics-OP5,,0,0,0,,♪ Güneşi hep kalbimizde tutacağız! ♪
Dialogue: 0,0:02:01.50,0:02:04.66,Lyrics-OP5,,0,0,0,,♪ Bir fırtına gelirse omzunu benimkine yasla. ♪
Dialogue: 0,0:02:04.70,0:02:08.53,Lyrics-OP5,,0,0,0,,{\fad(75,0)}♪ İlerideki umut ışığına bakacağız! ♪
Dialogue: 0,0:02:09.00,0:02:12.25,Lyrics-OP5,,0,0,0,,♪ Hayallerimizin parçalarını toplarken,...
Dialogue: 0,0:02:12.72,0:02:15.88,Lyrics-OP5,,0,0,0,,...bize yarının yolunu gösterecekler! ♪
Dialogue: 0,0:02:16.01,0:02:19.05,Lyrics-OP5,,0,0,0,,♪ Bu yüzden aynı bayrak altında yolculuk ediyoruz. ♪
Dialogue: 0,0:02:19.43,0:02:22.69,Lyrics-OP5,,0,0,0,,{\fad(0,75)}♪ Hayallerimizi yakalayacağız! ♪
Dialogue: 0,0:02:22.72,0:02:24.78,Lyrics-OP5,,0,0,0,,{\fad(0,75)}♪ Biz birleşmişiz...
