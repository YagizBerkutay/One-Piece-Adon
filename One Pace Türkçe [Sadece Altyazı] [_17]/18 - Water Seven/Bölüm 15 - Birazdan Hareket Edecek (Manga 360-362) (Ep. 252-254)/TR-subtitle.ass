&H00040407,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0,0,2,15,15,15,1Style: FlashbacksSecondary-207+,Impress BT,82,&H00D6D6D6,&H00FFFFFF,&H00525252,&H78000000,0,-1,0,0,100,100,0,0,1,4.2,3.8,2,300,300,27,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 50,0:02:12.82,0:02:16.16,Main-207+,,0,0,0,,Evet, CP9 her an burada olabilir.Dialogue: 50,0:02:16.16,0:02:19.99,Main-207+,,0,0,0,,Nico Robin, önce sen bineceksin.Dialogue: 50,0:02:19.99,0:02:21.58,Main-207+,,0,0,0,,Kıpırda!Dialogue: 50,0:02:21.58,0:02:24.04,Main-207+,,0,0,0,,Siz ikiniz de! Onu trene götürün!Dialogue: 50,0:02:24.04,0:02:24.92,Main-207+,,0,0,0,,– Emredersiniz! – Emredersiniz!Dialogue: 50,0:02:27.54,0:02:32.47,Main-207+,,0,0,0,,Hükümet memurları, Denizciler ve Robin-chan.Dialogue: 50,0:02:34.68,0:02:37.89,Main-207+,,0,0,0,,Bununla nasıl başa çıksam?Dialogue: 50,0:02:37.85,0:02:42.31,Flashbacks-207+,,0,0,0,,İçimde hiçbirinizin farkında olmadığı bir karanlık var.Dialogue: 50,0:02:44.02,0:02:47.86,Main-207+,,0,0,0,,Kesinlikle kendisine bir tutsak olarak eşlik ediliyor.Dialogue: 50,0:02:48.44,0:02:53.32,Main-207+,,0,0,0,,Ama kaçabilmeli. O adamları kolayca kendi başına halledebilir.Dialogue: 50,0:02:56.07,0:02:59.08,Main-207+,,0,0,0,,Acaba bir şey peşinde mi?Dialogue: 50,0:02:59.08,0:03:01.70,Main-207+,,0,0,0,,Hikayesi beni tatmin etmedi.Dialogue: 50,0:03:03.66,0:03:06.42,Thoughts-207+,,0,0,0,,Geldim, Robin-chan!Dialogue: 50,0:03:08.38,0:03:11.59,Thoughts-207+,,0,0,0,,Seni bekliyordum, biricik prensim!Dialogue: 50,0:03:17.43,0:03:20.26,Main-207+,,0,0,0,,Gelip onu kurtarabileyim diye  bilerek yapmış olmalı!Dialogue: 50,0:03:33.32,0:03:34.44,Main-207+,,0,0,0,,Corgi-san!Dialogue: 50,0:03:34.90,0:03:36.49,Main-207+,,0,0,0,,CP9 geldi.Dialogue: 50,0:03:38.32,0:03:40.41,Secondary-207+,,0,0,0,,– Çözün beni, pislikler!Dialogue: 50,0:03:38.32,0:03:40.41,Secondary-207+,,0,0,0,,– Bırakın beni!Dialogue: 50,0:03:40.41,0:03:44.04,Secondary-207+,,0,0,0,,Korkuyorum!Dialogue: 50,0:03:42.24,0:03:44.04,Main-207+,,0,0,0,,Bu Rob Lucci-san!Dialogue: 50,0:03:44.04,0:03:45.50,Main-207+,,0,0,0,,Ne asalet ama!Dialogue: 50,0:03:46.46,0:03:49.33,Main-207+,,0,0,0,,Demek bu CP9.Dialogue: 50,0:03:51.34,0:03:53.17,Main-207+,,0,0,0,,Dinliyor musun?Dialogue: 50,0:03:52.63,0:03:54.55,Secondary-207+,,0,0,0,,Cidden, korkuyorum!Dialogue: 50,0:03:53.17,0:03:54.55,Main-207+,,0,0,0,,Bırakın beni, lanet olsun!Dialogue: 50,0:03:54.55,0:03:55.67,Main-207+,,0,0,0,,Bıra-Dialogue: 50,0:03:56.13,0:03:57.63,Main-207+,,0,0,0,,Beni nereye götürüyorsunuz?!Dialogue: 50,0:03:57.63,0:04:02.56,Main-207+,,0,0,0,,Buna pişman olacaksınız, sizi pislikler!Dialogue: 50,0:04:02.56,0:04:06.93,Main-207+,,0,0,0,,Görürüsünüz siz! Hey! Emrimde 8 bin adam-Dialogue: 50,0:04:08.19,0:04:09.90,Main-207+,,0,0,0,,Usopp...?Dialogue: 50,0:04:10.90,0:04:13.27,Main-207+,,0,0,0,,Başarılı göreviniz için tebrikler!Dialogue: 50,0:04:16.24,0:04:18.11,Main-207+,,0,0,0,,Lucci-san, paltonuz.Dialogue: 50,0:04:18.11,0:04:20.24,Main-207+,,0,0,0,,Yeterince şey yaptın.Dialogue: 50,0:04:20.95,0:04:22.33,Main-207+,,0,0,0,,Sabrımı zorlama!Dialogue: 50,0:04:22.33,0:04:24.24,Main-207+,,0,0,0,,E-Emredersiniz!Dialogue: 50,0:04:27.58,0:04:29.33,Main-207+,,0,0,0,,Bu oyun değil!Dialogue: 50,0:04:29.33,0:04:31.08,Main-207+,,0,0,0,,Dikkatli olun!Dialogue: 50,0:04:31.08,0:04:32.92,Main-207+,,0,0,0,,Tüm personel trene!Dialogue: 50,0:04:33.67,0:04:35.51,Main-207+,,0,0,0,,Herkes trene!Dialogue: 50,0:04:35.51,0:04:38.22,Main-207+,,0,0,0,,Enies Lobby'ye gitmek için hazırlanın!Dialogue: 50,0:04:38.22,0:04:40.18,Main-207+,,0,0,0,,Beni çözün dedi-Dialogue: 50,0:04:43.14,0:04:45.89,Thoughts-207+,,0,0,0,,Neler oluyor?Dialogue: 50,0:04:47.48,0:04:48.68,Main-207+,,0,0,0,,Can sıkıcı...Dialogue: 50,0:04:49.19,0:04:52.19,Main-207+,,0,0,0,,"Son ana kadar yük" gerçekten.Dialogue: 50,0:04:52.19,0:04:54.69,Main-207+,,0,0,0,,Tayfayı bıraktıktan sonra bile bela çıkarıyorsun!Dialogue: 50,0:04:55.57,0:04:57.19,Main-207+,,0,0,0,,Biraz daha!Dialogue: 50,0:04:57.19,0:04:58.57,Main-207+,,0,0,0,,Sulamaya devam edin!Dialogue: 50,0:04:58.57,0:05:00.57,Main-207+,,0,0,0,,Daha fazla su kullanın!Dialogue: 50,0:05:01.16,0:05:05.12,Main-207+,,0,0,0,,Yani Robin, aslında bizden nefret etmiyor mu?Dialogue: 50,0:05:05.12,0:05:06.41,Main-207+,,0,0,0,,Evet!Dialogue: 50,0:05:06.41,0:05:08.37,Main-207+,,0,0,0,,Hele şükür!Dialogue: 50,0:05:08.37,0:05:10.12,Main-207+,,0,0,0,,Tanukiye dönüştü!Dialogue: 50,0:05:10.12,0:05:11.75,Main-207+,,0,0,0,,Tanukiye dönüştü!Dialogue: 50,0:05:11.75,0:05:13.96,Main-207+,,0,0,0,,Hey, o bir tanuki!Dialogue: 50,0:05:13.96,0:05:18.55,Main-207+,,0,0,0,,Gidelim Chopper. Luffyler'i bulduğumuzda, Robin'i kurtarmaya gidebiliriz!Dialogue: 50,0:05:18.55,0:05:20.76,Main-207+,,0,0,0,,Tamam. Onları arayalım.Dialogue: 50,0:05:21.26,0:05:22.34,Main-207+,,0,0,0,,Neredeler?Dialogue: 50,0:05:22.34,0:05:24.60,Main-207+,,0,0,0,,Dediğim gibi, onları bulmak zorundayız.Dialogue: 50,0:05:24.60,0:05:26.26,Main-207+,,0,0,0,,Tamam!Dialogue: 50,0:05:26.26,0:05:28.35,Main-207+,,0,0,0,,Elimden geleni yapacağım!Dialogue: 50,0:05:28.35,0:05:31.35,Main-207+,,0,0,0,,Vay! Gorile dönüştü!Dialogue: 50,0:05:32.44,0:05:33.56,Main-207+,,0,0,0,,İkiniz de durun.Dialogue: 50,0:05:36.94,0:05:39.44,Main-207+,,0,0,0,,Nico Robin'le ilgili bir şey daha.Dialogue: 50,0:05:39.44,0:05:44.45,Main-207+,,0,0,0,,Bu gece, Hükümet için özel bir deniz treni seferi var. Saat 11'de kalkıyor.Dialogue: 50,0:05:44.45,0:05:45.83,Main-207+,,0,0,0,,Evet...Dialogue: 50,0:05:45.83,0:05:49.95,Main-207+,,0,0,0,,...demek istediğim onların trende olmaları muhtemel.Dialogue: 50,0:05:50.29,0:05:51.79,Main-207+,,0,0,0,,Tabii...Dialogue: 50,0:05:51.79,0:05:53.62,Main-207+,,0,0,0,,...Nico Robin'le birlikte.Dialogue: 50,0:05:53.62,0:05:54.50,Main-207+,,0,0,0,,Ne?Dialogue: 50,0:05:54.50,0:05:58.88,Main-207+,,0,0,0,,Bu tek şansınız. Bunun ardından deniz treni,  geçici olarak hizmet dışı kalacak.Dialogue: 50,0:05:58.88,0:06:02.34,Main-207+,,0,0,0,,Aqua Laguna sırasında çalıştırılamaz.Dialogue: 50,0:06:02.34,0:06:04.51,Main-207+,,0,0,0,,O zaman...Dialogue: 50,0:06:06.01,0:06:11.52,Main-207+,,0,0,0,,O treni kaçırırsanız, adada tıkılı kalacaksınız. Gemiyle yola çıkmak söz konusu bile olamaz.Dialogue: 50,0:06:11.52,0:06:14.27,Main-207+,,0,0,0,,Olamaz! Şaka yapıyor olmalısın!  Şu anda saat kaç?!Dialogue: 50,0:06:14.27,0:06:15.35,Main-207+,,0,0,0,,10:30.Dialogue: 50,0:06:15.35,0:06:18.23,Main-207+,,0,0,0,,Ne?! Sadece 30 dakikamız var!Dialogue: 50,0:06:18.23,0:06:20.28,Main-207+,,0,0,0,,Bize yardım edemez misin?Dialogue: 50,0:06:20.28,0:06:22.36,Main-207+,,0,0,0,,Deniz trenini biraz geciktir!Dialogue: 50,0:06:22.78,0:06:28.24,Main-207+,,0,0,0,,Gideceği yer Enies Lobby. Sadece Hükümet personelinin girişine izin verilmiştir.Dialogue: 50,0:06:28.24,0:06:32.33,Main-207+,,0,0,0,,Makinist bile Hükümet'in adamı. Beni dinlemezler.Dialogue: 50,0:06:32.33,0:06:33.41,Main-207+,,0,0,0,,Olamaz!Dialogue: 50,0:06:33.41,0:06:38.79,Main-207+,,0,0,0,,O zaman istasyona gitmeliyim. Belki Robin'le konuşursam fikrini değiştirebilirim.Dialogue: 50,0:06:38.79,0:06:40.21,Main-207+,,0,0,0,,Chopper!Dialogue: 50,0:06:40.71,0:06:44.68,Main-207+,,0,0,0,,Zoro ve Luffy'nin ne tarafa uçtuklarını gördüm.  Nereyi arayacağını söyleyeceğim!Dialogue: 50,0:06:45.18,0:06:48.14,Main-207+,,0,0,0,,Onları bulursan,  istasyona gel ve bana haber ver!Dialogue: 50,0:06:48.14,0:06:49.76,Main-207+,,0,0,0,,Tamam! Anlaşıldı!Dialogue: 50,0:06:50.22,0:06:52.73,Main-207+,,0,0,0,,Hey... Siz!Dialogue: 50,0:06:53.48,0:06:55.23,Main-207+,,0,0,0,,Paulie-san kendine geldi!Dialogue: 50,0:06:55.77,0:06:59.40,Main-207+,,0,0,0,,Bu kıza yardım etmenizi istiyorum.Dialogue: 50,0:06:59.40,0:07:00.73,Main-207+,,0,0,0,,– Ne?! – Ne?!Dialogue: 50,0:07:00.73,0:07:03.28,Main-207+,,0,0,0,,O-Onlara yardım etmek mi, Paulie-san?Dialogue: 50,0:07:03.28,0:07:07.66,Main-207+,,0,0,0,,Onlar suçlu!  Iceburg-san'ı öldürmeye çalıştılar!Dialogue: 50,0:07:07.66,0:07:10.28,Main-207+,,0,0,0,,Onları tutuklamanız lazım!Dialogue: 50,0:07:10.28,0:07:12.58,Main-207+,,0,0,0,,Lucci-san ve Kaku-san hala olayda kay-Dialogue: 50,0:07:10.03,0:07:11.04,Secondary-207+,,0,0,0,,Doğru!Dialogue: 50,0:07:12.58,0:07:15.33,Main-207+,,0,0,0,,Hasır Şapka Korsanları sorumlu değil!Dialogue: 50,0:07:15.33,0:07:16.67,Main-207+,,0,0,0,,Onlar masum!Dialogue: 50,0:07:17.17,0:07:21.63,Main-207+,,0,0,0,,Kandırıldık. Suçu onlara atma konusunda acele ettik!Dialogue: 50,0:07:22.21,0:07:24.12,Main-207+,,0,0,0,,O maskeli adamlar kimdi bilmiyorum ama...Dialogue: 50,0:07:24.14,0:07:27.79,Main-207+,,0,0,0,,...Hasır Şapkalar'ın onları engellemeye çalıştığını biliyorum!Dialogue: 50,0:07:28.09,0:07:34.10,Main-207+,,0,0,0,,Iceburg-san'ın hala hayatta olmasının nedeni, onlardır.Dialogue: 50,0:07:36.56,0:07:40.06,Main-207+,,0,0,0,,Lucci ve Kaku'yu aramanın anlamı yok.Dialogue: 50,0:07:40.61,0:07:44.36,Main-207+,,0,0,0,,Artık gittiler.Dialogue: 50,0:07:44.36,0:07:48.45,Main-207+,,0,0,0,,Nasıl? Onlara ne olduğunu biliyor musunuz?Dialogue: 50,0:07:49.07,0:07:50.41,Main-207+,,0,0,0,,Memleketlerine döndüler.Dialogue: 50,0:07:50.41,0:07:52.91,Main-207+,,0,0,0,,Saçmalık! Böyle bir zamanda mı?!Dialogue: 50,0:07:52.91,0:07:55.29,Main-207+,,0,0,0,,Kesin saçmalamayı ve  Hasır Şapka'yı bulmaya yardım edin!Dialogue: 50,0:07:55.29,0:07:57.04,Main-207+,,0,0,0,,Hey, şıllık.Dialogue: 50,0:07:57.04,0:07:59.92,Main-207+,,0,0,0,,Hey! Bana böyle demeyi kes!Dialogue: 50,0:07:59.92,0:08:02.29,Main-207+,,0,0,0,,İstasyona gideceksen, seni götüreceğim.Dialogue: 50,0:08:02.29,0:08:03.21,Main-207+,,0,0,0,,Ah...Dialogue: 50,0:08:03.21,0:08:04.80,Main-207+,,0,0,0,,Sağol.Dialogue: 50,0:08:04.80,0:08:06.63,Main-207+,,0,0,0,,Durun biraz, Paulie-san!Dialogue: 50,0:08:06.63,0:08:08.26,Main-207+,,0,0,0,,Bu doğru mu?!Dialogue: 50,0:08:09.05,0:08:11.30,Main-207+,,0,0,0,,Tembelliği bırakın da size söyleneni yapın!Dialogue: 50,0:08:11.30,0:08:13.06,Main-207+,,0,0,0,,Galley-La adının yüzkarasısınız!Dialogue: 50,0:08:13.47,0:08:15.31,Main-207+,,0,0,0,,– Emredersiniz, ustabaşı! – Emredersiniz, ustabaşı!Dialogue: 50,0:08:15.31,0:08:16.23,Main-207+,,0,0,0,,Üzgünüz!Dialogue: 50,0:08:16.23,0:08:17.89,Main-207+,,0,0,0,,– Bizi affedin! – Bizi affedin!Dialogue: 50,0:08:17.89,0:08:19.48,Main-207+,,0,0,0,,Hizmetinizdeyiz!Dialogue: 50,0:08:19.48,0:08:21.86,Main-207+,,0,0,0,,Yagaralara ihtiyacımız var!Dialogue: 50,0:08:21.86,0:08:23.69,Main-207+,,0,0,0,,– Evet! – Evet!Dialogue: 50,0:08:25.23,0:08:27.11,Main-207+,,0,0,0,,Memleketlerine döndüler, ha?Dialogue: 50,0:08:29.45,0:08:32.45,Main-207+,,0,0,0,,Onlara gerçeği söyleyemedim.Dialogue: 50,0:08:32.83,0:08:37.83,Main-207+,,0,0,0,,İkimiz de ne olduğunu biliyoruz. Başkasının bilmesine gerek yok.Dialogue: 50,0:08:46.09,0:08:48.38,Main-207+,,0,0,0,,Hey!!Dialogue: 50,0:08:48.84,0:08:51.09,Main-207+,,0,0,0,,Çocuklar!!Dialogue: 50,0:08:51.84,0:08:53.93,Main-207+,,0,0,0,,Hey!!Dialogue: 50,0:08:55.18,0:08:56.89,Main-207+,,0,0,0,,Hey!!Dialogue: 50,0:08:56.89,0:08:58.77,Main-207+,,0,0,0,,Luffy!!Dialogue: 50,0:08:58.77,0:09:00.27,Main-207+,,0,0,0,,Zoro!!Dialogue: 50,0:09:00.27,0:09:02.65,Main-207+,,0,0,0,,Sanji!!Dialogue: 50,0:09:02.65,0:09:04.90,Main-207+,,0,0,0,,Usopp, lütfen geri dön.Dialogue: 50,0:09:05.52,0:09:07.40,Main-207+,,0,0,0,,Siz de yardım edin!Dialogue: 50,0:09:07.40,0:09:09.78,Main-207+,,0,0,0,,Tamam! Hazır mısınız beyler?Dialogue: 50,0:09:09.78,0:09:11.36,Main-207+,,0,0,0,,– Evet! – Evet!Dialogue: 50,0:09:11.36,0:09:14.12,Main-207+,,0,0,0,,Hey, Luffy!Dialogue: 50,0:09:14.12,0:09:15.87,Main-207+,,0,0,0,,Zoro!!Dialogue: 50,0:09:15.87,0:09:18.37,Main-207+,,0,0,0,,Sanji!!Dialogue: 50,0:09:18.37,0:09:20.33,Main-207+,,0,0,0,,Usopp, lütfen geri gel.Dialogue: 50,0:09:27.17,0:09:28.88,Main-207+,,0,0,0,,O su yoluna dön!Dialogue: 50,0:09:28.88,0:09:30.97,Main-207+,,0,0,0,,İstasyona giden bir kestirmedir!Dialogue: 50,0:09:40.98,0:09:43.44,Thoughts-207+,,0,0,0,,Daha 20 dakikamız var.Dialogue: 50,0:09:44.27,0:09:45.94,Thoughts-207+,,0,0,0,,Gitme Robin!Dialogue: 50,0:09:45.94,0:09:47.78,Thoughts-207+,,0,0,0,,Kendini feda etmek zorunda değilsin!Dialogue: 50,0:09:47.78,0:09:50.03,Thoughts-207+,,0,0,0,,Buna izin vermeyeceğiz!Dialogue: 50,0:09:50.44,0:09:54.20,Main-207+,,0,0,0,,Yagara-chan! Lütfen daha hızlı git!Dialogue: 50,0:10:05.17,0:10:07.80,Main-207+,,0,0,0,,Son tren saat 11'de hareket edecek.Dialogue: 50,0:10:09.46,0:10:14.43,Main-207+,,0,0,0,,Water Seven'ın Mavi İstasyon'undan kalkıyor. Ennies Lobby'ye gidiyor.Dialogue: 50,0:10:17.97,0:10:20.02,Main-207+,,0,0,0,,Sessizce burada bekleyin.Dialogue: 50,0:10:20.02,0:10:23.27,Main-207+,,0,0,0,,Hey! Biraz kibarlık öğrenin, aptallar!Dialogue: 50,0:10:23.27,0:10:24.65,Main-207+,,0,0,0,,Evet, aptallar!Dialogue: 50,0:10:24.65,0:10:26.40,Main-207+,,0,0,0,,Hükümet köpekleri!Dialogue: 50,0:10:26.40,0:10:28.19,Main-207+,,0,0,0,,Bu biraz aşırı oldu.Dialogue: 50,0:10:28.52,0:10:34.53,Main-207+,,0,0,0,,Fırtınanın yaklaştığı konusunda bilgilendirildik. Acil kalkış için hazırlanın.Dialogue: 50,0:10:34.53,0:10:37.45,Main-207+,,0,0,0,,Kahretsin. Hemen kalkıyor mu?Dialogue: 50,0:10:41.79,0:10:44.87,Main-207+,,0,0,0,,Görünüşe göre nihayet görevimiz bitti.Dialogue: 50,0:10:45.25,0:10:49.30,Main-207+,,0,0,0,,Varana kadar böyle saçma şeyler duymayayım.Dialogue: 50,0:10:49.30,0:10:50.46,Main-207+,,0,0,0,,Aptal.Dialogue: 50,0:10:51.13,0:10:52.67,Main-207+,,0,0,0,,Afedersin.Dialogue: 50,0:10:55.59,0:11:00.85,Flashbacks-207+,,0,0,0,,O treni kaçırırsanız,  adada tıkılı kalacaksınız.Dialogue: 50,0:11:00.85,0:11:03.35,Main-207+,,0,0,0,,Lütfen bizi zamanında eriştir!Dialogue: 50,0:11:14.11,0:11:15.49,Thoughts-207+,,0,0,0,,Franky...Dialogue: 50,0:11:16.45,0:11:19.24,Thoughts-207+,,0,0,0,,...umarım iyisindir.Dialogue: 50,0:11:28.25,0:11:30.00,Main-207+,,0,0,0,,Hasır Şapka!Dialogue: 50,0:11:30.00,0:11:32.00,Main-207+,,0,0,0,,Roronoa!Dialogue: 50,0:11:32.00,0:11:33.63,Main-207+,,0,0,0,,Luffy!Dialogue: 50,0:11:33.63,0:11:35.26,Main-207+,,0,0,0,,Neredesiniz?!Dialogue: 50,0:11:35.26,0:11:37.55,Main-207+,,0,0,0,,Hey, nereye kayboldunuz?Dialogue: 50,0:11:37.55,0:11:39.68,Main-207+,,0,0,0,,Lütfen cevap verin!Dialogue: 50,0:11:39.68,0:11:41.39,Main-207+,,0,0,0,,Zoro!Dialogue: 50,0:11:41.39,0:11:44.02,Main-207+,,0,0,0,,Sanji!Dialogue: 50,0:11:44.02,0:11:46.39,Main-207+,,0,0,0,,Usopp, lütfen geri dön.Dialogue: 50,0:11:46.77,0:11:51.07,Main-207+,,0,0,0,,Luffy!! Robin'i götürüyorlar!!Dialogue: 50,0:11:51.48,0:11:53.15,Main-207+,,0,0,0,,Lütfen cevap ver!Dialogue: 50,0:11:53.15,0:11:55.69,Main-207+,,0,0,0,,Neredesin?!!Dialogue: 50,0:12:05.37,0:12:08.50,Main-207+,,0,0,0,,Acaba Luffyler ne alemde.Dialogue: 50,0:12:08.50,0:12:11.13,Main-207+,,0,0,0,,Sanırım başka kimse gelmiyor.Dialogue: 50,0:12:12.17,0:12:17.30,Main-207+,,0,0,0,,Tekrar ediyorum. Son tren birazdan kalkacak.Dialogue: 50,0:12:23.18,0:12:24.81,Main-207+,,0,0,0,,Kahretsin!Dialogue: 50,0:12:24.81,0:12:27.52,Main-207+,,0,0,0,,O herifleri...Dialogue: 50,0:12:27.81,0:12:31.48,Main-207+,,0,0,0,,...asla affetmeyeceğim!Dialogue: 50,0:12:35.23,0:12:36.78,Main-207+,,0,0,0,,Sıkıştım.Dialogue: 50,0:12:38.15,0:12:40.82,Main-207+,,0,0,0,,Ayağımın kaydığına inanamıyorum!Dialogue: 50,0:12:44.91,0:12:46.29,Main-207+,,0,0,0,,Kahretsin!Dialogue: 50,0:12:48.75,0:12:50.17,Main-207+,,0,0,0,,Sıkıştım.Dialogue: 50,0:12:54.17,0:12:55.75,Main-207+,,0,0,0,,Luffy!!Dialogue: 50,0:12:55.75,0:12:57.05,Main-207+,,0,0,0,,Zoro!!Dialogue: 50,0:12:57.42,0:12:59.80,Main-207+,,0,0,0,,Sanji!!Dialogue: 50,0:12:59.80,0:13:02.05,Main-207+,,0,0,0,,Çıkın ortaya!!Dialogue: 50,0:13:02.05,0:13:04.60,Main-207+,,0,0,0,,Robin'i kurtarmaya gidelim!!Dialogue: 50,0:13:04.60,0:13:07.02,Main-207+,,0,0,0,,– Hasır Şapka! – Hasır Şapka!Dialogue: 50,0:13:07.47,0:13:10.06,Main-207+,,0,0,0,,– Roronoa! – Roronoa!Dialogue: 50,0:13:14.36,0:13:16.73,Main-207+,,0,0,0,,Herkes nerede?!Dialogue: 50,0:13:17.07,0:13:18.44,Main-207+,,0,0,0,,Oraya da bakın!Dialogue: 50,0:13:18.44,0:13:19.82,Main-207+,,0,0,0,,Hey!Dialogue: 50,0:13:19.82,0:13:21.24,Main-207+,,0,0,0,,Hasır Şapka!Dialogue: 50,0:13:21.24,0:13:22.45,Main-207+,,0,0,0,,Zoro!Dialogue: 50,0:13:22.45,0:13:24.58,Main-207+,,0,0,0,,Burada değiller.Dialogue: 50,0:13:24.58,0:13:26.70,Main-207+,,0,0,0,,Ya arka sokaklar?!Dialogue: 50,0:13:26.70,0:13:30.71,Main-207+,,0,0,0,,Orada olabilirler ama orası zaten su altında!Dialogue: 50,0:13:30.71,0:13:32.71,Main-207+,,0,0,0,,Orayı aramaya gitmek çok tehlikeli!Dialogue: 50,0:13:32.71,0:13:34.46,Main-207+,,0,0,0,,Kahretsin!Dialogue: 50,0:13:34.46,0:13:37.13,Main-207+,,0,0,0,,Hasır Şapka! Roronoa!Dialogue: 50,0:13:44.85,0:13:46.01,Main-207+,,0,0,0,,Lucci-san!Dialogue: 50,0:13:46.01,0:13:50.23,Main-207+,,0,0,0,,Dalga boylarının yükselmesi nedeniyle programdan erken hareket etmeliyiz.Dialogue: 50,0:13:50.77,0:13:52.35,Main-207+,,0,0,0,,Sizi rahatsız ediy-Dialogue: 50,0:13:51.35,0:13:52.35,Secondary-207+,,0,0,0,,Etmiyor.Dialogue: 50,0:13:52.35,0:13:53.27,Main-207+,,0,0,0,,Gidelim.Dialogue: 50,0:13:54.23,0:13:55.90,Main-207+,,0,0,0,,Hemen.Dialogue: 50,0:13:57.36,0:13:59.61,Main-207+,,0,0,0,,Beş yıl oldu...Dialogue: 50,0:14:00.36,0:14:04.82,Main-207+,,0,0,0,,...ama bu şehri biraz bile özlemeyeceğim.Dialogue: 50,0:14:18.92,0:14:21.59,Main-207+,,0,0,0,,Hey! Şimdi bir düdük sesi duymadınız mı?Dialogue: 50,0:14:21.59,0:14:25.30,Main-207+,,0,0,0,,Evet ama tuhaf. Henüz kalkış vakti gelmedi.Dialogue: 50,0:14:30.27,0:14:33.02,Main-207+,,0,0,0,,Ama onlar sıradan yolcular değil.Dialogue: 50,0:14:34.02,0:14:37.65,Main-207+,,0,0,0,,Havaya bak!  Erken gidiyor olabilirler!Dialogue: 50,0:14:38.27,0:14:40.78,Main-207+,,0,0,0,,Çabuk! İstasyonu ileride görebiliyorum!Dialogue: 50,0:14:40.78,0:14:43.24,Main-207+,,0,0,0,,Bizi bekle, deniz treni!Dialogue: 50,0:14:47.91,0:14:54.54,Main-207+,,0,0,0,,Bu, günün son kalkışı. Water Seven'dan kalkıyor. Ennies Lobby'ye gidiyor.Dialogue: 50,0:14:57.17,0:14:59.63,Main-207+,,0,0,0,,Gidiyoruz. Oturun.Dialogue: 50,0:14:59.63,0:15:01.00,Main-207+,,0,0,0,,Şimdi kalkıyor.Dialogue: 50,0:15:05.93,0:15:09.43,Flashbacks-207+,,0,0,0,,O sırada, ölmek istediğim halde beni yaşamaya zorladın.Dialogue: 50,0:15:09.97,0:15:12.85,Flashbacks-207+,,0,0,0,,Bu senin suçun.Dialogue: 50,0:15:16.90,0:15:21.19,Flashbacks-207+,,0,0,0,,Gidecek veya dönecek bir yerim yok.Dialogue: 50,0:15:21.19,0:15:23.07,Flashbacks-207+,,0,0,0,,Bu yüzden geminizde kalmama izin verecek misin?Dialogue: 50,0:15:23.07,0:15:28.53,FlashbacksSecondary-207+,,0,0,0,,Mellorine! Mellorine! Mellorine!Dialogue: 50,0:15:23.44,0:15:27.07,Flashbacks-207+,,0,0,0,,Ne, öyle mi?  Yapacak bir şey yok o zaman. Kalabilirsin.Dialogue: 50,0:15:27.07,0:15:28.53,Flashbacks-207+,,0,0,0,,– Luffy!! – Luffy!!Dialogue: 50,0:15:28.99,0:15:31.37,Flashbacks-207+,,0,0,0,,Endişelenmeyin!Dialogue: 50,0:15:31.37,0:15:34.04,Flashbacks-207+,,0,0,0,,O kötü biri değil!Dialogue: 50,0:15:44.76,0:15:47.13,Main-207+,,0,0,0,,Hareket ediyoruz.Dialogue: 50,0:15:47.13,0:15:49.76,Main-207+,,0,0,0,,Lanet olası Hükümet pislikleri.Dialogue: 50,0:15:58.06,0:15:59.86,Main-207+,,0,0,0,,Geldik! Sağol, Yagara-chan!Dialogue: 50,0:16:00.73,0:16:02.73,Main-207+,,0,0,0,,İçerideki merdivenlerden aşağı in!Dialogue: 50,0:16:02.73,0:16:03.69,Main-207+,,0,0,0,,Tamam!Dialogue: 50,0:16:04.07,0:16:06.15,Main-207+,,0,0,0,,Robin, gitme!Dialogue: 50,0:16:16.87,0:16:18.25,Main-207+,,0,0,0,,Hey, sen de kimsin?Dialogue: 50,0:16:18.25,0:16:19.96,Main-207+,,0,0,0,,Bu çok tehlikeli! Geride dur!Dialogue: 50,0:16:25.21,0:16:26.97,Main-207+,,0,0,0,,Robin, trenden in!Dialogue: 50,0:16:26.97,0:16:29.93,Main-207+,,0,0,0,,Herkesle dövüşürüz, yeter ki sen geri dön!Dialogue: 50,0:16:29.93,0:16:32.26,Main-207+,,0,0,0,,Luffy!!Dialogue: 50,0:16:32.26,0:16:33.64,Main-207+,,0,0,0,,Zoro!!Dialogue: 50,0:16:33.97,0:16:37.18,Main-207+,,0,0,0,,Neredesiniz?!Dialogue: 50,0:16:41.69,0:16:43.57,Main-207+,,0,0,0,,Hareket edemiyorum!Dialogue: 50,0:16:45.78,0:16:47.15,Main-207+,,0,0,0,,Durun!!Dialogue: 50,0:16:49.86,0:16:51.49,Main-207+,,0,0,0,,Tren bu!Dialogue: 50,0:16:53.66,0:16:55.70,Main-207+,,0,0,0,,Dur!!Dialogue: 50,0:17:01.00,0:17:05.00,Main-207+,,0,0,0,,Robin!!Dialogue: 50,0:17:08.59,0:17:15.89,Main-207+,,0,0,0,,Robin!!Dialogue: 50,0:17:31.91,0:17:34.07,Main-207+,,0,0,0,,Sanırım başaramadık.Dialogue: 50,0:17:39.91,0:17:42.50,Main-207+,,0,0,0,,A-Ah! O adam ne yapmaya çalışıyordu?Dialogue: 50,0:17:42.50,0:17:47.51,Main-207+,,0,0,0,,Ne yaparsa yapsın, o Hükümet treniydi.Dialogue: 50,0:17:47.51,0:17:49.60,Main-207+,,0,0,0,,Yakalanacak ve her şey bitecek.Dialogue: 50,0:17:51.30,0:17:52.30,Main-207+,,0,0,0,,Ha?Dialogue: 50,0:17:52.30,0:17:54.51,Main-207+,,0,0,0,,O, Galley-La ustabaşı değil mi?! Pau-Dialogue: 50,0:17:57.18,0:17:59.43,Main-207+,,0,0,0,,Profesyonel gibi davran!Dialogue: 50,0:18:00.73,0:18:03.23,Main-207+,,0,0,0,,Bak, bir şeyler oluyor.Dialogue: 50,0:18:04.65,0:18:07.48,Main-207+,,0,0,0,,Burası tren istasyonu. Merhabaların ve elvedaların yeri!Dialogue: 50,0:18:07.48,0:18:12.36,Main-207+,,0,0,0,,İstasyon çalışanları olarak,  olup bitenleri sessizce izlemek görevimizdir!Dialogue: 50,0:18:13.49,0:18:14.99,Main-207+,,0,0,0,,Ah, anlıyorum.Dialogue: 50,0:18:17.08,0:18:18.66,Main-207+,,0,0,0,,Şimdi sessiz ol.Dialogue: 50,0:18:20.75,0:18:22.75,Main-207+,,0,0,0,,Görüyorum ki tren vaktinden önce kalkmış.Dialogue: 50,0:18:22.75,0:18:24.29,Main-207+,,0,0,0,,– Ne?! – Ne?!Dialogue: 50,0:18:24.29,0:18:26.21,Main-207+,,0,0,0,,Ah, evet!Dialogue: 50,0:18:26.59,0:18:28.71,Main-207+,,0,0,0,,Yolcuların hepsi binmişti ve-Dialogue: 50,0:18:29.21,0:18:33.51,Main-207+,,0,0,0,,Ve hava aşırı derecede sert.Dialogue: 50,0:18:33.51,0:18:38.01,Main-207+,,0,0,0,,Aqua Laguna çok hızlı yaklaşıyor,...Dialogue: 50,0:18:38.01,0:18:40.10,Main-207+,,0,0,0,,...bu yüzden kalkış saati öne alındı.Dialogue: 50,0:18:40.47,0:18:42.73,Main-207+,,0,0,0,,Burası da tehlikeli.Dialogue: 50,0:18:42.73,0:18:45.19,Main-207+,,0,0,0,,Bir an önce Tersane Adası'na gitmelisiniz.Dialogue: 50,0:18:45.19,0:18:46.98,Main-207+,,0,0,0,,Haklısınız.Dialogue: 50,0:18:48.94,0:18:52.74,Main-207+,,0,0,0,,Hey, sen. Artık gittiğine göre treni durduramayız.Dialogue: 50,0:18:52.74,0:18:54.28,Main-207+,,0,0,0,,Bunu söylemek hoşuma gitmiyor...Dialogue: 50,0:18:54.86,0:18:57.03,Main-207+,,0,0,0,,...ama Enies Lobby,...Dialogue: 50,0:18:59.20,0:19:00.54,Main-207+,,0,0,0,,Ağlıyor musun?Dialogue: 50,0:19:01.24,0:19:03.96,Main-207+,,0,0,0,,Şey, neler hissettiğini anlıyorum ama...Dialogue: 50,0:19:03.96,0:19:05.46,Main-207+,,0,0,0,,PEŞLERİNDEN!!Dialogue: 50,0:19:06.96,0:19:08.46,Main-207+,,0,0,0,,Öfkeymiş!Dialogue: 50,0:19:09.00,0:19:12.13,Main-207+,,0,0,0,,O Hükümet aptallarını asla affetmeyeceğim!Dialogue: 50,0:19:12.55,0:19:14.05,Main-207+,,0,0,0,,Hey, bana bir gemi ver!Dialogue: 50,0:19:14.05,0:19:15.63,Main-207+,,0,0,0,,Aniden ne oldu sana?Dialogue: 50,0:19:15.63,0:19:17.14,Main-207+,,0,0,0,,Büyük, hızlı bir gemi!Dialogue: 50,0:19:17.55,0:19:20.39,Main-207+,,0,0,0,,Bu havada gemiyle yola mı çıkmak istiyorsun?!Dialogue: 50,0:19:20.39,0:19:21.14,Main-207+,,0,0,0,,Aptal!Dialogue: 50,0:19:21.56,0:19:24.69,Main-207+,,0,0,0,,Aqua Laguna'nın ne kadar kötü olduğunu bilmiyorsun! Aceleci olma!Dialogue: 50,0:19:24.69,0:19:26.27,Main-207+,,0,0,0,,Bununla baş edebilirim!Dialogue: 50,0:19:26.27,0:19:29.27,Main-207+,,0,0,0,,Bu, senin sıradan fırtınalarından farklı bir ölçüde!Dialogue: 50,0:19:29.94,0:19:32.19,Main-207+,,0,0,0,,Deniz korkunç derecede sertleşmek üzere.Dialogue: 50,0:19:32.19,0:19:34.53,Main-207+,,0,0,0,,Artık denize açılmak mümkün değil.Dialogue: 50,0:19:34.53,0:19:36.36,Main-207+,,0,0,0,,Ölmeyi istemekten başka bir şey değil!Dialogue: 50,0:19:36.36,0:19:40.33,Main-207+,,0,0,0,,Ama Robin, bizim için kendi hayatını feda ediyor!Dialogue: 50,0:20:10.36,0:20:12.19,Main-207+,,0,0,0,,Çok yakındı.Dialogue: 50,0:20:12.86,0:20:14.57,Main-207+,,0,0,0,,S-Sağol.Dialogue: 50,0:20:14.57,0:20:17.70,Main-207+,,0,0,0,,Paulie-san, çok teşekkür ederim!Dialogue: 50,0:20:17.70,0:20:21.16,Main-207+,,0,0,0,,Denize sürükleneceğimden emindim.Dialogue: 50,0:20:21.74,0:20:22.70,Main-207+,,0,0,0,,Bakın.Dialogue: 50,0:20:22.70,0:20:26.87,Main-207+,,0,0,0,,Koca tren tarifesini, deniz parçalayıp götürdü.Dialogue: 50,0:20:27.75,0:20:31.42,Main-207+,,0,0,0,,Daha önce hiç böyle bir şey olmamıştı.Dialogue: 50,0:20:33.88,0:20:36.59,Main-207+,,0,0,0,,Ne olağanüstü bir güç.Dialogue: 50,0:20:37.26,0:20:39.43,Main-207+,,0,0,0,,Üstelik daha fırtına gelmedi bile.Dialogue: 50,0:20:40.34,0:20:46.06,Main-207+,,0,0,0,,Bu yılki Aqua Laguna dalgaları inanılmaz derecede hızlı.Dialogue: 50,0:20:46.06,0:20:47.31,Main-207+,,0,0,0,,Hey,...Dialogue: 50,0:20:47.31,0:20:50.27,Main-207+,,0,0,0,,...Robin'in olduğu deniz trenine bir şey olmaz, değil mi?Dialogue: 50,0:20:51.15,0:20:56.36,Main-207+,,0,0,0,,Deniz treni suların yükseldiği bölgeden tam zamanında çıkmalı.Dialogue: 50,0:20:56.36,0:21:00.07,Main-207+,,0,0,0,,Doğrudan bir darbe alana dek,  sert dalgaların içinden geçip gitmesi gerekir.Dialogue: 50,0:21:02.12,0:21:05.24,Main-207+,,0,0,0,,Hey, sen Nami misin?Dialogue: 50,0:21:06.75,0:21:09.62,Main-207+,,0,0,0,,Bu notu istasyonun önünde buldum.Dialogue: 50,0:21:09.62,0:21:10.87,Main-207+,,0,0,0,,Arkadaşlarından biri yazmış olmalı.Dialogue: 50,0:21:11.58,0:21:13.71,Main-207+,,0,0,0,,Not mu? Kimden?Dialogue: 50,0:21:13.71,0:21:16.59,Main-207+,,0,0,0,,O kadar küçük bir şeyi farkettiğine inanamıyorum.Dialogue: 50,0:21:17.05,0:21:20.13,Main-207+,,0,0,0,,Buradaydı. Notun olduğu yer burası.Dialogue: 50,0:21:25.26,0:21:26.77,Main-207+,,0,0,0,,Geri zekalı.Dialogue: 50,0:21:29.14,0:21:30.89,Main-207+,,0,0,0,,Ne yazıyor?Dialogue: 50,0:21:30.89,0:21:32.27,Main-207+,,0,0,0,,Hmm... biraz bekle.Dialogue: 50,0:21:32.27,0:21:34.98,Main-207+,,0,0,0,,İlk yarısı tamamen umutsuz bir aşk mektubu.Dialogue: 50,0:21:35.65,0:21:39.24,Main-207+,,0,0,0,,Aşk mektubu? Diğer adam epey ısrarcı olmalı.Dialogue: 50,0:21:39.24,0:21:40.24,Main-207+,,0,0,0,,Hayır...Dialogue: 50,0:21:40.24,0:21:43.87,Main-207+,,0,0,0,,Duruma bakılırsa diğer adam muhtemelen...Dialogue: 50,0:21:47.74,0:21:49.50,Main-207+,,0,0,0,,Ne diye bakıyorsunuz?Dialogue: 50,0:21:49.91,0:21:52.04,Main-207+,,0,0,0,,Asıl başladığı yer burası.Dialogue: 50,0:21:54.08,0:21:55.46,Thoughts-207+,,0,0,0,,Dipnot:...Dialogue: 50,0:21:55.46,0:21:58.96,Thoughts-207+,,0,0,0,,...Robin-chan'ın 23:00'daki trene bindiğini gördüm...Dialogue: 50,0:21:58.96,0:22:01.01,Thoughts-207+,,0,0,0,,...ve peşinden gitmeye karar verdim.Dialogue: 50,0:22:00.34,0:22:01.01,Secondary-207+,,0,0,0,,Ne?Dialogue: 50,0:22:01.76,0:22:03.80,Main-207+,,0,0,0,,Sanji-kun trende mi?!Dialogue: 50,0:22:04.22,0:22:06.18,Main-207+,,0,0,0,,Usopp'la birlikte mi?Dialogue: 50,0:22:06.60,0:22:10.64,Main-207+,,0,0,0,,Ve ördek kuyruklu, küstah bir haydutla.Dialogue: 50,0:22:10.64,0:22:12.19,Main-207+,,0,0,0,,O Franky olmalı.Dialogue: 50,0:22:12.19,0:22:13.48,Main-207+,,0,0,0,,Evet, öyle olmalı.Dialogue: 50,0:22:13.81,0:22:15.56,Main-207+,,0,0,0,,Bir adam daha!Dialogue: 50,0:22:15.56,0:22:19.32,Main-207+,,0,0,0,,Üstelik de Franky.Dialogue: 50,0:22:19.32,0:22:22.03,Main-207+,,0,0,0,,Paulie'nin hiç şansı yok!Dialogue: 50,0:22:22.03,0:22:24.41,Main-207+,,0,0,0,,Açıkça pes etme zamanı gelmiş.Dialogue: 50,0:22:24.91,0:22:26.41,Main-207+,,0,0,0,,Neyiniz var sizin?!Dialogue: 50,0:22:26.74,0:22:30.62,Main-207+,,0,0,0,,Ah, bir şey daha var.  Bunu notun yanında buldum.Dialogue: 50,0:22:34.50,0:22:38.67,Thoughts-207+,,0,0,0,,Deniz treninde bir yerde, en azından bir tane Den Den Mushi olmalı.Dialogue: 50,0:22:38.67,0:22:40.38,Thoughts-207+,,0,0,0,,Bulur bulmaz sizinle bağlantı kuracağım.Dialogue: 50,0:22:42.13,0:22:46.55,Thoughts-207+,,0,0,0,,Bebek Den Den Mushi'yi her zaman kendine yakın tut.Dialogue: 50,0:22:46.55,0:22:50.56,Thoughts-207+,,0,0,0,,Evet. Bebek Den Den Mushi'ye benmişim gibi davran. Sevgili-Dialogue: 50,0:22:50.56,0:22:53.52,Main-207+,,0,0,0,,Anlıyorum. Demek beni bundan arayacak.Dialogue: 50,0:22:54.06,0:22:57.90,Main-207+,,0,0,0,,Nico Robin'in ne yapacağını tahmin etmiş olmalı.Dialogue: 50,0:22:57.90,0:22:59.19,Main-207+,,0,0,0,,Etkileyici.Dialogue: 50,0:22:59.19,0:22:59.90,Main-207+,,0,0,0,,Evet!Dialogue: 50,0:23:03.19,0:23:06.41,Main-207+,,0,0,0,,Şimdilik en azından Sanji-kun, Robin'in peşinden gidiyor.Dialogue: 50,0:23:06.41,0:23:09.91,Main-207+,,0,0,0,,Kalanımız Enies Lobby'de onlara erişiriz!Dialogue: 50,0:23:20.67,0:23:22.42,Main-207+,,0,0,0,,Öf...Dialogue: 50,0:23:22.42,0:23:24.59,Main-207+,,0,0,0,,Burada tek bir fırt bile çekemiyorum.Dialogue: 50,0:23:26.05,0:23:27.64,Main-207+,,0,0,0,,Öyle mi?Dialogue: 50,0:23:27.64,0:23:30.01,Main-207+,,0,0,0,,Yani ondan sonra Sanji istasyona mı gitmiş?Dialogue: 50,0:23:30.01,0:23:30.76,Main-207+,,0,0,0,,Evet!Dialogue: 50,0:23:33.02,0:23:35.39,Thoughts-207+,,0,0,0,,Usopp'la aynı trende.Dialogue: 50,0:23:35.39,0:23:36.52,Thoughts-207+,,0,0,0,,Hele şükür!Dialogue: 50,0:23:36.52,0:23:39.98,Main-207+,,0,0,0,,Bu yüzden peşlerinden nasıl gidersek gidelim,...Dialogue: 50,0:23:39.98,0:23:43.23,Main-207+,,0,0,0,,...önce Luffy'yi ve Zoro'yu bulmalıyız!Dialogue: 50,0:23:43.23,0:23:44.49,Main-207+,,0,0,0,,Tamam, anladım!Dialogue: 50,0:23:44.74,0:23:47.45,Main-207+,,0,0,0,,Ne tarafa uçtuklarını biliyorum.Dialogue: 50,0:23:47.45,0:23:48.78,Main-207+,,0,0,0,,O yöne gidip arayacağız.Dialogue: 50,0:23:49.45,0:23:51.12,Main-207+,,0,0,0,,Siz de yardım edin!Dialogue: 50,0:23:51.12,0:23:52.45,Main-207+,,0,0,0,,Beyler!Dialogue: 50,0:23:52.79,0:23:54.04,Main-207+,,0,0,0,,Size güveniyoruz!Dialogue: 50,0:23:54.04,0:23:55.29,Main-207+,,0,0,0,,– Evet! – Evet!Dialogue: 50,0:23:55.66,0:23:57.42,Main-207+,,0,0,0,,Bize bırakın!Dialogue: 50,0:24:08.43,0:24:13.06,Main-207+,,0,0,0,,Pekâla, içeri sızmanın en iyi yolu ne olurdu?Dialogue: 50,0:24:14.47,0:24:16.73,Main-207+,,0,0,0,,Aaah, ne fırtına ama!Dialogue: 50,0:24:21.90,0:24:23.57,Main-207+,,0,0,0,,Collier Shoot!Dialogue: 50,0:24:21.90,0:24:23.57,Attack,,0,0,0,,Boyun VuruşuDialogue: 50,0:24:26.86,0:24:28.28,Main-207+,,0,0,0,,Sen de kimsin?!Dialogue: 50,0:24:35.79,0:24:36.96,Main-207+,,0,0,0,,Hey!Dialogue: 50,0:24:37.83,0:24:39.71,Main-207+,,0,0,0,,Nereye gittiğini sanıyorsun?Dialogue: 50,0:24:40.54,0:24:42.09,Main-207+,,0,0,0,,Kıpırdama!Dialogue: 50,0:24:42.50,0:24:44.25,Main-207+,,0,0,0,,O tekmeyi gördün.Dialogue: 50,0:24:44.63,0:24:47.22,Main-207+,,0,0,0,,O sıradan bir sivil değil!Dialogue: 50,0:24:50.01,0:24:51.55,Main-207+,,0,0,0,,Evet...Dialogue: 50,0:24:52.60,0:24:55.14,Main-207+,,0,0,0,,...o kadar açık söyleyince...Dialogue: 50,0:24:58.27,0:24:59.56,Main-207+,,0,0,0,,...utandım.Dialogue: 50,0:24:59.56,0:25:01.15,Main-207+,,0,0,0,,Bu iltifat değildi!Dialogue: 50,0:25:01.15,0:25:02.94,Main-207+,,0,0,0,,Bizimle alay ediyor.Dialogue: 50,0:25:02.94,0:25:07.07,Main-207+,,0,0,0,,Hey! Lucci-san'a haber verin! Trende şüpheli bir kaçak yolcu olduğunu söyleyin!Dialogue: 50,0:25:07.07,0:25:08.74,Main-207+,,0,0,0,,Durun!Dialogue: 50,0:25:11.41,0:25:16.16,Main-207+,,0,0,0,,Bu kadar önemsiz bir konuyla CP9'u neden rahatsız edelim?Dialogue: 50,0:25:16.87,0:25:21.92,Main-207+,,0,0,0,,Bu adam ne kadar kavgacı olursa olsun, ona bir yararı olmaz.Dialogue: 50,0:25:22.42,0:25:24.00,Main-207+,,0,0,0,,Öyle olmasının nedeni...Dialogue: 50,0:25:24.63,0:25:26.59,Main-207+,,0,0,0,,Kahrolası duman...Dialogue: 50,0:25:27.34,0:25:29.42,Main-207+,,0,0,0,,...benim burada olmam!Dialogue: 50,0:25:29.42,0:25:30.97,Main-207+,,0,0,0,,Jerry-san!Dialogue: 50,0:25:35.76,0:25:42.31,Main-207+,,0,0,0,,Güney Mavi'nin, karatesiyle meşhur bir adasının şampiyonuyum!Dialogue: 50,0:25:42.77,0:25:43.69,Main-207+,,0,0,0,,Evet.Dialogue: 50,0:25:43.69,0:25:45.57,Main-207+,,0,0,0,,Ben boks şampiyonuyum!Dialogue: 50,0:25:45.57,0:25:47.07,Main-207+,,0,0,0,,Biraz karate görmek isterim.Dialogue: 50,0:25:49.86,0:25:54.32,Main-207+,,0,0,0,,Önce yumruklarımla başa çıkabiliyor musun bir bakalım!Dialogue: 50,0:25:54.99,0:25:56.62,Main-207+,,0,0,0,,Abartma!Dialogue: 50,0:25:57.08,0:25:58.37,Main-207+,,0,0,0,,Jerry...Dialogue: 50,0:25:58.37,0:26:00.21,Main-207+,,0,0,0,,Aurora Flicker...Dialogue: 50,0:26:00.21,0:26:01.71,Main-207+,,0,0,0,,Jab!Dialogue: 50,0:26:02.58,0:26:05.29,Main-207+,,0,0,0,,J-Jerry-san! Arkanızda!Dialogue: 50,0:26:06.80,0:26:07.92,Main-207+,,0,0,0,,Kaçtı mı?Dialogue: 50,0:26:08.92,0:26:10.05,Main-207+,,0,0,0,,Velet!Dialogue: 50,0:26:10.05,0:26:16.35,Main-207+,,0,0,0,,Ben çok büyüğüm ve vagon da küçük diye kendini avantajlı sanma!Dialogue: 50,0:26:16.35,0:26:19.68,Main-207+,,0,0,0,,Kasıklarının olması gerektiği yerde kafası olan birinden hiç nasihat dinlememiştim.Dialogue: 50,0:26:19.68,0:26:23.19,Main-207+,,0,0,0,,Boksum küçük yerlerde daha da etkilidir!Dialogue: 50,0:26:23.77,0:26:25.23,Main-207+,,0,0,0,,Yoga stili!Dialogue: 50,0:26:26.23,0:26:27.61,Main-207+,,0,0,0,,Yoga bir, iki!Dialogue: 50,0:26:27.61,0:26:28.82,Main-207+,,0,0,0,,Bir, iki!Dialogue: 50,0:26:28.82,0:26:30.32,Main-207+,,0,0,0,,Erimin kısaldı!Dialogue: 50,0:26:30.65,0:26:33.07,Main-207+,,0,0,0,,Sana erimi göstereceğim.Dialogue: 50,0:26:33.07,0:26:34.74,Main-207+,,0,0,0,,Screw...Dialogue: 50,0:26:33.07,0:26:34.74,Attack,,0,0,0,,Vidalama...Dialogue: 50,0:26:35.82,0:26:38.16,Main-207+,,0,0,0,,Drop Kick!Dialogue: 50,0:26:35.82,0:26:38.16,Attack,,0,0,0,,Düşüş TekmesiDialogue: 50,0:26:38.16,0:26:40.50,Main-207+,,0,0,0,,Bu boks kurallarına aykırı!Dialogue: 50,0:26:41.54,0:26:43.33,Main-207+,,0,0,0,,Zaman kaybediyorum.Dialogue: 50,0:26:46.50,0:26:48.50,Main-207+,,0,0,0,,Brochette!Dialogue: 50,0:26:46.50,0:26:48.50,Attack,,0,0,0,,Kebap Şişi!Dialogue: 50,0:26:58.22,0:27:04.14,Main-207+,,0,0,0,,Yedinci ve son vagondan başlayacağım. Bütün Hükümet memurları orada.Dialogue: 50,0:27:06.31,0:27:12.40,Main-207+,,0,0,0,,Gücü arttırmak için sırada 5. vagon var.  İçinde 40 Denizci bulunuyor.Dialogue: 50,0:27:12.40,0:27:16.41,Main-207+,,0,0,0,,Onlara Karargâh'tan, Antik Krallık'ın Şövalye Kaptanı T-Bone liderlik ediyor.Dialogue: 50,0:27:16.41,0:27:24.91,Main-207+,,0,0,0,,Dördüncü vagonda ise baş aşçımız var. Cipher Pol No. 7'nin dövüş sanatçısı, Wanze.Dialogue: 50,0:27:24.91,0:27:30.34,Main-207+,,0,0,0,,Üçüncü vagonda,  CP9'un yeni üyesi Nero bey var.Dialogue: 50,0:27:43.93,0:27:49.94,Main-207+,,0,0,0,,Her ne kadar suçlulara eşlik etsek de  baskın olasılığı yok.Dialogue: 50,0:27:49.94,0:27:54.36,Main-207+,,0,0,0,,Her ihtimale karşı, her bir vagon  askeri güçle donatılmış durumda.Dialogue: 50,0:27:59.74,0:28:01.24,Main-207+,,0,0,0,,Hasır Şapka!Dialogue: 50,0:28:01.24,0:28:02.74,Main-207+,,0,0,0,,Roronoa!Dialogue: 50,0:28:02.74,0:28:04.58,Main-207+,,0,0,0,,Sizin tarafınızdayız!Dialogue: 50,0:28:05.04,0:28:06.46,Main-207+,,0,0,0,,Saklanmayın!Dialogue: 50,0:28:06.46,0:28:08.29,Main-207+,,0,0,0,,Neredesin, Hasır Şapka?!Dialogue: 50,0:28:09.50,0:28:12.50,Main-207+,,0,0,0,,Ustabaşı, epey hırpalanmış görünüyorsun.Dialogue: 50,0:28:12.50,0:28:13.76,Main-207+,,0,0,0,,Biraz dinlenmelisin.Dialogue: 50,0:28:13.76,0:28:15.38,Main-207+,,0,0,0,,Aptal.  Önemli bir şey değil.Dialogue: 50,0:28:15.38,0:28:16.88,Main-207+,,0,0,0,,Şu ikisini bir an önce bulun!Dialogue: 50,0:28:16.88,0:28:17.72,Main-207+,,0,0,0,,Emredersin!Dialogue: 50,0:28:19.05,0:28:21.68,Main-207+,,0,0,0,,Iceburg-san size son gelişmelerden bahsetti mi?Dialogue: 50,0:28:21.68,0:28:23.68,Main-207+,,0,0,0,,Evet, bilgilendirildik.Dialogue: 50,0:28:31.40,0:28:33.02,Main-207+,,0,0,0,,Nereye gidiyorsunuz?Dialogue: 50,0:28:33.86,0:28:35.36,Main-207+,,0,0,0,,Iceburg-san?Dialogue: 50,0:28:37.24,0:28:38.74,Main-207+,,0,0,0,,Roronoa!Dialogue: 50,0:28:38.74,0:28:40.24,Main-207+,,0,0,0,,Hasır Şapka!Dialogue: 50,0:28:40.24,0:28:42.20,Main-207+,,0,0,0,,Beni duyabiliyorsanız, bir şey söyleyin!Dialogue: 50,0:28:42.58,0:28:44.16,Main-207+,,0,0,0,,Luffy!Dialogue: 50,0:28:44.16,0:28:45.83,Main-207+,,0,0,0,,Zoro!Dialogue: 50,0:28:45.83,0:28:47.96,Main-207+,,0,0,0,,Neredesin?!Dialogue: 50,0:28:51.00,0:28:53.00,Flashbacks-207+,,0,0,0,,Yiyecek mi dedin?Dialogue: 50,0:28:53.00,0:28:54.96,Flashbacks-207+,,0,0,0,,Evet! Ete ihtiyacımız var. Ete!Dialogue: 50,0:28:54.96,0:28:58.63,Flashbacks-207+,,0,0,0,,Toplayabildiğiniz kadar et toplayın! Çabuk!Dialogue: 50,0:28:59.38,0:29:02.97,Main-207+,,0,0,0,,Üfff, nasıl oldu da ayak işlerini yapar hale geldik?Dialogue: 50,0:29:02.97,0:29:05.14,Main-207+,,0,0,0,,Bunu o kız için yapmıyoruz.Dialogue: 50,0:29:05.14,0:29:09.48,Main-207+,,0,0,0,,Aldattığı Paulie-san için yapıyoruz! Elimizden geleni yapalım!Dialogue: 50,0:29:09.48,0:29:10.65,Main-207+,,0,0,0,,Evet!Dialogue: 50,0:29:11.02,0:29:14.57,Main-207+,,0,0,0,,Genç kızın çok aç olabileceğini söyledi!Dialogue: 50,0:29:14.57,0:29:17.65,Main-207+,,0,0,0,,Sonuçta hala büyüyen bir kız!Dialogue: 50,0:29:29.54,0:29:30.83,Main-207+,,0,0,0,,Yağmur...Dialogue: 50,0:29:31.37,0:29:32.96,Main-207+,,0,0,0,,Durum kötü.Dialogue: 50,0:29:32.96,0:29:36.00,Main-207+,,0,0,0,,Daha da kötüsü, bu kadar rüzgar varken kokularını takip edemem!Dialogue: 50,0:29:48.89,0:29:53.81,Main-207+,,0,0,0,,Hey, bağırmalarımıza tek bir karşılık bile gelmedi.Dialogue: 50,0:29:53.81,0:29:54.90,Main-207+,,0,0,0,,O zaman gerçekten...Dialogue: 50,0:29:54.90,0:29:57.73,Main-207+,,0,0,0,,Aptallaşma!  Denemeye devam etmeliyiz!Dialogue: 50,0:29:59.82,0:30:03.11,Thoughts-207+,,0,0,0,,Neredesiniz? Luffy... Zoro...Dialogue: 50,0:30:03.11,0:30:06.41,Thoughts-207+,,0,0,0,,O leopar adamın ikinizden birini öldürmesi mümkün değil.Dialogue: 50,0:30:07.33,0:30:12.33,Thoughts-207+,,0,0,0,,Nihayet Robin'in bizi neden terkettiğini biliyoruz!Dialogue: 50,0:30:12.33,0:30:14.54,Main-207+,,0,0,0,,Neredesin, Hasır Şapka?!Dialogue: 50,0:30:14.54,0:30:16.88,Main-207+,,0,0,0,,Bir şey söyle!Dialogue: 50,0:30:20.88,0:30:22.34,Thoughts-207+,,0,0,0,,Dayan Robin.Dialogue: 50,0:30:22.34,0:30:25.51,Thoughts-207+,,0,0,0,,Luffyler'le beraber, kesinlikle seni kurtarmaya geleceğiz!Dialogue: 50,0:30:36.73,0:30:37.86,Main-207+,,0,0,0,,Hey, neler oluyor?Dialogue: 50,0:30:37.86,0:30:40.15,Main-207+,,0,0,0,,Ah, Paulie-san! Gelip bakın!Dialogue: 50,0:30:45.07,0:30:48.08,Main-207+,,0,0,0,,Gelgit ne kadar geri çekilirse,...Dialogue: 50,0:30:48.08,0:30:51.20,Main-207+,,0,0,0,,...dalgalar o kadar büyük olacak.Dialogue: 50,0:30:51.20,0:30:55.63,Main-207+,,0,0,0,,Gelgite bakarak,  fırtınanın büyüklüğünü kestirebilirsin.Dialogue: 50,0:30:55.63,0:30:58.09,Main-207+,,0,0,0,,Uçuyorum!Dialogue: 50,0:30:58.59,0:31:03.59,Main-207+,,0,0,0,,Evet, bu yılki su seviyesindeki düşüşü göze alırsak,...Dialogue: 50,0:31:04.59,0:31:06.55,Main-207+,,0,0,0,,Bak şuna, Chimney.Dialogue: 50,0:31:08.68,0:31:10.81,Main-207+,,0,0,0,,Vay! Müthiş!Dialogue: 50,0:31:21.57,0:31:25.45,Main-207+,,0,0,0,,Neredeyse deniz kurumuş gibi.Dialogue: 50,0:31:25.91,0:31:32.08,Main-207+,,0,0,0,,Bunca yıldır,  hiç böyle bir manzara görmemiştim.Dialogue: 50,0:31:34.83,0:31:38.46,Main-207+,,0,0,0,,Gelgit nasıl bu kadar çekilebilir?Dialogue: 50,0:31:38.46,0:31:41.05,Main-207+,,0,0,0,,Hiç böyle bir şey görmemiştim!Dialogue: 50,0:31:42.92,0:31:46.01,Main-207+,,0,0,0,,Ne tür canavarımsı dalgalarla karşı karşıyayız?!Dialogue: 50,0:31:46.34,0:31:49.68,Main-207+,,0,0,0,,Arka sokak bölgesi tamamiyle sular altında kalmış olacak!Dialogue: 50,0:31:50.43,0:31:52.68,Main-207+,,0,0,0,,Umarım hala aşağıda olan kimse yoktur.Dialogue: 50,0:31:52.68,0:31:54.27,Main-207+,,0,0,0,,Eğer varsa, anında ölürler.Dialogue: 50,0:32:02.48,0:32:05.65,Main-207+,,0,0,0,,Artık okyanusu duyamıyorum.Dialogue: 50,0:32:06.24,0:32:08.36,Main-207+,,0,0,0,,Ha?Dialogue: 50,0:32:10.07,0:32:11.99,Main-207+,,0,0,0,,Nine! Bak! Bak!Dialogue: 50,0:32:11.99,0:32:13.74,Main-207+,,0,0,0,,Orada bir şey var!Dialogue: 50,0:32:14.50,0:32:15.50,Main-207+,,0,0,0,,Öyle mi?Dialogue: 50,0:32:15.83,0:32:18.42,Main-207+,,0,0,0,,O iki binanın arasında bir şey var!Dialogue: 50,0:32:19.58,0:32:22.88,Main-207+,,0,0,0,,Gel hadi! Bak, bak!Dialogue: 50,0:32:24.30,0:32:25.63,Main-207+,,0,0,0,,Kokoro-san!Dialogue: 50,0:32:26.13,0:32:28.89,Main-207+,,0,0,0,,Ah! Bu korsan kız değil mi?Dialogue: 50,0:32:29.72,0:32:31.22,Main-207+,,0,0,0,,Korsan abla!Dialogue: 50,0:32:31.22,0:32:32.81,Main-207+,,0,0,0,,Hey, baksana!Dialogue: 50,0:32:32.81,0:32:34.43,Main-207+,,0,0,0,,Orada bir şey var!Dialogue: 50,0:32:35.18,0:32:36.81,Main-207+,,0,0,0,,Bir şey mi?Dialogue: 50,0:32:37.52,0:32:40.77,Main-207+,,0,0,0,,Neden bahsediyorsun, Chimney?Dialogue: 50,0:32:40.77,0:32:41.77,Main-207+,,0,0,0,,Dur biraz...!Dialogue: 50,0:32:42.52,0:32:44.82,Main-207+,,0,0,0,,Deniz tabanı nasıl ortaya çıkabilir?!Dialogue: 50,0:32:54.29,0:32:56.08,Main-207+,,0,0,0,,Luffy...!Dialogue: 50,0:32:57.33,0:32:59.46,Main-207+,,0,0,0,,O hasır şapka...Dialogue: 50,0:32:59.96,0:33:02.96,Main-207+,,0,0,0,,...sizin Korsanlar Kralı'nız değil mi?Dialogue: 50,0:33:02.96,0:33:03.92,Main-207+,,0,0,0,,Değil mi?Dialogue: 50,0:33:06.26,0:33:08.51,Thoughts-207+,,0,0,0,,Aptal!Dialogue: 50,0:33:10.59,0:33:12.85,Main-207+,,0,0,0,,H-Hey! Nereye gidiyorsun?Dialogue: 50,0:33:12.85,0:33:15.31,Main-207+,,0,0,0,,Arka sokak bölgesine inme!Dialogue: 50,0:33:15.31,0:33:17.52,Main-207+,,0,0,0,,Kendini öldürtmeye mi çalışıyorsun?!Dialogue: 50,0:33:17.52,0:33:20.19,Main-207+,,0,0,0,,Aqua Laguna neredeyse geldi!Dialogue: 50,0:33:20.19,0:33:21.69,Main-207+,,0,0,0,,Geri gel!Dialogue: 50,0:33:24.77,0:33:25.86,Main-207+,,0,0,0,,Bir sorunumuz var!Dialogue: 50,0:33:25.86,0:33:28.24,Main-207+,,0,0,0,,Korsan kız merdivenlerden aşağı indi!Dialogue: 50,0:33:28.24,0:33:29.90,Main-207+,,0,0,0,,Hey, geri dön!Dialogue: 50,0:33:29.90,0:33:32.20,Main-207+,,0,0,0,,Aşağı inme!Dialogue: 0,0:01:50.13,0:01:55.89,Author,,0,0,0,,TR: onepacetr.net | kazaskerDialogue: 0,0:17:15.00,0:17:25.00,Author,,0,0,0,,TR: onepacetr.net | kazaskerDialogue: 0,0:33:32.20,0:33:37.14,Author,,0,0,0,,TR: onepacetr.net | kazaskerDialogue: 0,0:01:50.13,0:01:55.89,Title-207+,,0,0,0,,Birazdan Hareket EdecekDialogue: 1,0:01:50.13,0:01:55.89,Title-207+,,0,0,0,,Birazdan Hareket EdecekDialogue: 0,0:01:57.56,0:02:02.52,Captions-207+,,0,0,0,,Tersane Adası Mavi İstasyon GirişiDialogue: 1,0:01:57.56,0:02:02.52,Captions-207+,,0,0,0,,Tersane Adası Mavi İstasyon GirişiDialogue: 1,0:01:57.56,0:02:02.52,Captions-207+,,0,0,0,,Tersane Adası Mavi İstasyon GirişiDialogue: 0,0:04:54.73,0:05:01.16,Captions-207+,,0,0,0,,Galley-La Şirketi Genel Merkezi EnkazıDialogue: 1,0:04:54.73,0:05:01.16,Captions-207+,,0,0,0,,Galley-La Şirketi Genel Merkezi EnkazıDialogue: 1,0:04:54.73,0:0