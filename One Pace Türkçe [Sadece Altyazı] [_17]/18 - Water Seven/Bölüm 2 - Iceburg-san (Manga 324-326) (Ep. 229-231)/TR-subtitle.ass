Dialogue: 0,0:01:50.17,0:01:52.46,Author,,0,0,0,,{\fad(600,0)}TR: onepacetr.net | kazasker
Dialogue: 0,0:13:46.00,0:13:56.00,Author,,0,0,0,,{\fad(500,0)}TR: onepacetr.net | kazasker
Dialogue: 0,0:30:42.69,0:30:48.19,Author,,0,0,0,,{\fad(0,0)}TR: onepacetr.net | kazasker
Dialogue: 5,0:01:50.17,0:01:52.46,Title,,0,0,0,,{\fs75\fad(600,0)}Iceburg-san
Dialogue: 5,0:01:52.90,0:01:55.97,Main-207+,,0,0,0,,Bu harika!
Dialogue: 5,0:01:55.97,0:01:58.54,Main-207+,,0,0,0,,Hey, hakimiyeti sana bırakıyorum!
Dialogue: 5,0:01:59.64,0:02:03.64,Main-207+,,0,0,0,,Bu dünyada epey rahat yaratıklar var.
Dialogue: 5,0:02:03.64,0:02:05.93,Main-207+,,0,0,0,,Kayığın sallandığını hissetmiyorum bile. \NBu harika!
Dialogue: 5,0:02:06.80,0:02:08.27,Main-207+,,0,0,0,,Sağa! Sağa git!
Dialogue: 5,0:02:08.27,0:02:10.19,Main-207+,,0,0,0,,Top sana doğru geliyor!
Dialogue: 5,0:02:09.10,0:02:10.19,Secondary-207+,,0,0,0,,İşte başlıyoruz!
Dialogue: 5,0:02:11.90,0:02:14.36,Main-207+,,0,0,0,,Ah! Topu durdur!
Dialogue: 5,0:02:19.66,0:02:22.25,Main-207+,,0,0,0,,Pas ver! Pas ver!
Dialogue: 5,0:02:20.16,0:02:22.25,Secondary-207+,,0,0,0,,Süper!
Dialogue: 5,0:02:26.90,0:02:30.21,Main-207+,,0,0,0,,Burası mahalleye benziyor.
Dialogue: 5,0:02:31.69,0:02:35.62,Main-207+,,0,0,0,,Şehir su yollarına aşırı derecede bağlı.
Dialogue: 5,0:02:45.10,0:02:48.70,Main-207+,,0,0,0,,Hey, yol yukarı meylediyor ama su aşağı doğru akıyor.
Dialogue: 5,0:02:48.70,0:02:50.44,Main-207+,,0,0,0,,Yukarı çıkabilir miyiz?
Dialogue: 5,0:02:56.39,0:02:58.49,Main-207+,,0,0,0,,Bu yanlış yol! Sağa git! Sağa!
Dialogue: 5,0:02:58.49,0:03:02.23,Main-207+,,0,0,0,,Bunların suyun nereye aktığını umursamıyor!
Dialogue: 5,0:03:02.23,0:03:03.95,Main-207+,,0,0,0,,Harikasınız!
Dialogue: 5,0:03:07.58,0:03:09.79,Main-207+,,0,0,0,,Çatıların üstünde de su kanalları var!
Dialogue: 5,0:03:09.79,0:03:14.88,Main-207+,,0,0,0,,Evet ama burası gitmek istediğimiz yön değil! \NÖnce çarşı bölgesine gitmeliyiz!
Dialogue: 5,0:03:14.88,0:03:17.15,Main-207+,,0,0,0,,O kadar aceleci olma.
Dialogue: 5,0:03:17.15,0:03:20.34,Main-207+,,0,0,0,,Madem buradayız, \Nsu kanallarında birkaç tur atabiliriz.
Dialogue: 5,0:03:21.84,0:03:25.30,Main-207+,,0,0,0,,Hey, hey! Bakın, bakın! İleride!
Dialogue: 5,0:03:26.13,0:03:29.60,Main-207+,,0,0,0,,Anlıyorum! Bir rampanın tepesindeyiz!
Dialogue: 5,0:03:29.60,0:03:31.81,Main-207+,,0,0,0,,Bu da şu demek...
Dialogue: 5,0:03:49.29,0:03:51.04,Main-207+,,0,0,0,,Uçuyoruz!
Dialogue: 5,0:03:51.04,0:03:52.78,Main-207+,,0,0,0,,Düşüyoruz!
Dialogue: 5,0:03:52.78,0:03:53.79,Main-207+,,0,0,0,,Düşüyoruz!
Dialogue: 5,0:03:53.79,0:03:58.76,Main-207+,,0,0,0,,DÜŞÜYORUZ!
Dialogue: 5,0:04:07.00,0:04:09.18,Main-207+,,0,0,0,,Bu kadar gözü kara olmayın!
Dialogue: 5,0:04:15.40,0:04:17.49,Main-207+,,0,0,0,,Bayan, bu çok iyi fiyata!
Dialogue: 5,0:04:17.49,0:04:20.65,Main-207+,,0,0,0,,Hey, alıcı var mı? Gelin hadi!
Dialogue: 5,0:04:24.61,0:04:27.58,Main-207+,,0,0,0,,Görebildiğiniz en iyi ve en nadide şeyler!
Dialogue: 5,0:04:27.58,0:04:30.61,Main-207+,,0,0,0,,%50 indirimle başlıyor!
Dialogue: 5,0:04:31.54,0:04:34.80,Main-207+,,0,0,0,,Burası epey hareketli bir yer!
Dialogue: 5,0:04:34.80,0:04:37.29,Main-207+,,0,0,0,,Ha? Çarşı bölgesindeyiz.
Dialogue: 5,0:04:37.29,0:04:39.92,Main-207+,,0,0,0,,Dur biraz, yoksa o kestirme yol muydu?
Dialogue: 5,0:04:41.88,0:04:45.42,Main-207+,,0,0,0,,Üzgünüm. Gerçekten akıllısınız.
Dialogue: 5,0:04:45.42,0:04:49.29,Main-207+,,0,0,0,,Hiç bu kadar canlı bir pazar görmemiştim!
Dialogue: 5,0:04:49.29,0:04:52.70,Main-207+,,0,0,0,,Hey, bakın! \NÇok büyük bir boğa!
Dialogue: 5,0:04:52.70,0:04:55.35,Main-207+,,0,0,0,,Bu tarafa geliyor.
Dialogue: 5,0:05:01.28,0:05:03.00,Main-207+,,0,0,0,,Çok korkunç!
Dialogue: 5,0:05:03.00,0:05:04.20,Main-207+,,0,0,0,,Bizi yemeye hazır görünüyor!
Dialogue: 5,0:05:04.20,0:05:06.32,Main-207+,,0,0,0,,Acaba bu bir king mi?
Dialogue: 5,0:05:07.28,0:05:09.24,Main-207+,,0,0,0,,Ha? Onlar da kim?
Dialogue: 5,0:05:10.20,0:05:12.12,Main-207+,,0,0,0,,Maskeler...
Dialogue: 5,0:05:12.12,0:05:14.70,Main-207+,,0,0,0,,Vay canına, çok güzeller.\NEpey pahalı görünüyorlar.
Dialogue: 5,0:05:14.70,0:05:16.58,Main-207+,,0,0,0,,Parti mi veriyorlar?
Dialogue: 5,0:05:18.70,0:05:20.04,Main-207+,,0,0,0,,Ne? Sorun nedir?
Dialogue: 5,0:05:21.09,0:05:24.55,Main-207+,,0,0,0,,Tamam! Taze Su Takoyaki'si hemen geliyor!
Dialogue: 5,0:05:25.55,0:05:28.01,Main-207+,,0,0,0,,Size hemen Su Kroketi hazırlayacağız!
Dialogue: 5,0:05:28.01,0:05:32.06,Main-207+,,0,0,0,,Kulağa lezzetli geliyor! Yagara, oraya git!
Dialogue: 5,0:05:32.47,0:05:34.89,Main-207+,,0,0,0,,Nereye gidiyorsun?!
Dialogue: 5,0:05:34.89,0:05:37.00,Main-207+,,0,0,0,,Hey, Luffy! Nereye gidiyorsun?
Dialogue: 5,0:05:37.00,0:05:39.27,Main-207+,,0,0,0,,Yagara'ya sor!
Dialogue: 5,0:05:45.74,0:05:48.28,Main-207+,,0,0,0,,Hoş geldiniz. Ne istersiniz?
Dialogue: 5,0:05:48.28,0:05:51.49,Main-207+,,0,0,0,,Ah, demek acıktın.
Dialogue: 5,0:05:51.49,0:05:56.10,Main-207+,,0,0,0,,Yagaralar Su Eti'ni sever. \NGerçi insanlar için olması gerekiyor.
Dialogue: 5,0:05:56.10,0:05:58.21,Main-207+,,0,0,0,,Su Eti mi? On tane alayım!
Dialogue: 5,0:05:59.30,0:06:02.99,Main-207+,,0,0,0,,Mükemmel Yiyecek Şehri'ndeki aşçılar\Nbunlardan almak için gizlice hep buraya gelir.
Dialogue: 5,0:06:02.99,0:06:05.39,Main-207+,,0,0,0,,Bedenini ve ruhunu eritiyor, değil mi?
Dialogue: 5,0:06:08.30,0:06:13.10,Main-207+,,0,0,0,,Çok~ yu~ mu~ şak~!
Dialogue: 5,0:06:13.10,0:06:15.20,Main-207+,,0,0,0,,Ve lezzetli!
Dialogue: 5,0:06:13.99,0:06:15.20,Secondary-207+,,0,0,0,,O kadar iyi mi?!
Dialogue: 5,0:06:15.20,0:06:17.29,Main-207+,,0,0,0,,Hey, Luffy, bana da bir tane ver!
Dialogue: 5,0:06:17.29,0:06:19.90,Main-207+,,0,0,0,,Olmaz! Git kendine al!
Dialogue: 5,0:06:20.99,0:06:23.86,Main-207+,,0,0,0,,Hey, Nami! Tekneyi o dükkana götür!
Dialogue: 5,0:06:24.60,0:06:28.15,Main-207+,,0,0,0,,Bir tane daha. Dikkat ettim de...
Dialogue: 5,0:06:29.00,0:06:30.95,Main-207+,,0,0,0,,...şehrin her yerinde varlar.
Dialogue: 5,0:06:32.90,0:06:35.39,Main-207+,,0,0,0,,Hey, Nami!
Dialogue: 5,0:06:37.39,0:06:40.89,Main-207+,,0,0,0,,Pekala! Su geçidi asansörüne bindikten sonra...
Dialogue: 5,0:06:40.89,0:06:42.85,Main-207+,,0,0,0,,...Tersane Adası'na varacağız.
Dialogue: 5,0:06:45.00,0:06:46.84,Main-207+,,0,0,0,,Su geçidi asansörü mü?
Dialogue: 5,0:06:46.84,0:06:49.24,Main-207+,,0,0,0,,Şu büyük, kule benzeri yapı.
Dialogue: 5,0:06:55.89,0:06:58.05,Main-207+,,0,0,0,,Lütfen içeri girin!
Dialogue: 5,0:06:58.77,0:07:10.70,Main-207+,,0,0,0,,Bu, Tersane Adası asansörüdür. \NTersanelere ve Water 7 şehir merkezine gider!
Dialogue: 5,0:07:11.41,0:07:14.09,Main-207+,,0,0,0,,Lütfen kulenin içine ilerleyin!
Dialogue: 5,0:07:14.09,0:07:17.15,Main-207+,,0,0,0,,Kapı bir dakika içinde kapanacak!
Dialogue: 5,0:07:18.66,0:07:21.62,Main-207+,,0,0,0,,İçeride ne olacak?
Dialogue: 5,0:07:27.55,0:07:30.05,Main-207+,,0,0,0,,Oh, kapıyı arkamızdan kapattılar!
Dialogue: 5,0:07:31.21,0:07:33.46,Main-207+,,0,0,0,,Yükseliyoruz! Yükseliyoruz! Yukarı çıkıyoruz!
Dialogue: 5,0:07:37.56,0:07:41.40,Main-207+,,0,0,0,,Anlıyorum! Bu şekilde başlıyor,\Nbu oluyor...
Dialogue: 5,0:07:41.40,0:07:44.52,Main-207+,,0,0,0,,...sonra o ve sonra da o! \NSu geçidi asansörü böyle çalışıyor!
Dialogue: 5,0:07:44.52,0:07:48.48,Main-207+,,0,0,0,,Ooh, Water 7 gerçekten harika bir yer!
Dialogue: 5,0:07:49.89,0:07:52.96,Main-207+,,0,0,0,,Suyla her şeyi yapıyorlar!
Dialogue: 5,0:07:59.00,0:08:00.58,Main-207+,,0,0,0,,Hey!
Dialogue: 5,0:08:00.58,0:08:03.54,Main-207+,,0,0,0,,Sen kime marimo diyorsun...
Dialogue: 5,0:08:04.60,0:08:05.54,Main-207+,,0,0,0,,Hey, Zoro.
Dialogue: 5,0:08:07.46,0:08:10.53,Main-207+,,0,0,0,,Robin-chan nerede? Gemide göremedim.
Dialogue: 5,0:08:12.51,0:08:16.97,Main-207+,,0,0,0,,Evet, gitmiş. Chopper'la birlikte şehre gitti.
Dialogue: 5,0:08:16.97,0:08:20.54,Main-207+,,0,0,0,,– Ne?!\N– Alışveriş yapacaklarını söylediler.
Dialogue: 5,0:08:20.54,0:08:24.40,Main-207+,,0,0,0,,Bu nasıl olabilir?! Öyleyse gemide\Nkalan diğer tek kişi sen misin?!
Dialogue: 5,0:08:24.40,0:08:27.59,Main-207+,,0,0,0,,Ne sıkıcı bir atmosfer!
Dialogue: 5,0:08:27.59,0:08:30.36,Main-207+,,0,0,0,,Katılıyorum.
Dialogue: 5,0:08:30.99,0:08:34.07,Main-207+,,0,0,0,,Tamam, ben de alışverişe gidiyorum.
Dialogue: 5,0:08:34.72,0:08:36.64,Main-207+,,0,0,0,,Ben yokken gemiye göz kulak ol.
Dialogue: 5,0:08:39.54,0:08:42.30,Main-207+,,0,0,0,,Yok artık! Hemen uyudu mu?
Dialogue: 5,0:08:42.30,0:08:44.91,Main-207+,,0,0,0,,Tamam! Sana güveniyorum.
Dialogue: 5,0:09:13.82,0:09:16.74,Main-207+,,0,0,0,,Geldik!
Dialogue: 5,0:09:20.20,0:09:25.46,Main-207+,,0,0,0,,Burası Water 7'ın şehir merkezi,\Ndünyanın en büyük tersanesi!
Dialogue: 5,0:09:31.61,0:09:34.80,Main-207+,,0,0,0,,Doğal olarak burada daha fazla kara parçası var.
Dialogue: 5,0:09:38.68,0:09:41.43,Main-207+,,0,0,0,,Her şey çok büyük!
Dialogue: 5,0:09:43.18,0:09:46.14,Main-207+,,0,0,0,,Hiç bu kadar büyük bir şehir görmemiştim!
Dialogue: 5,0:09:55.51,0:09:57.60,Main-207+,,0,0,0,,O insanlar ne yapıyor?
Dialogue: 5,0:09:57.60,0:09:59.60,Main-207+,,0,0,0,,Tersaneye mi bakıyorlar?
Dialogue: 5,0:09:59.60,0:10:03.04,Main-207+,,0,0,0,,Gidip bakalım! Hadi, Yagara!
Dialogue: 5,0:10:10.00,0:10:14.00,Main-207+,,0,0,0,,Hey, şuraya bakın!\NBu Lucci-san! Çok ateşli biri!
Dialogue: 5,0:10:14.80,0:10:16.49,Main-207+,,0,0,0,,Paulie buralarda mı?
Dialogue: 5,0:10:16.49,0:10:22.14,Main-207+,,0,0,0,,Lulu orada! Ne adam ama!\N Erkek gibi erkek!
Dialogue: 5,0:10:22.14,0:10:25.60,Main-207+,,0,0,0,,Hiç kimse Tileston'dan daha erkek değildir!
Dialogue: 5,0:10:26.78,0:10:28.56,Main-207+,,0,0,0,,Hey, amca.
Dialogue: 5,0:10:28.56,0:10:30.15,Main-207+,,0,0,0,,Bir şey mi oldu?
Dialogue: 5,0:10:30.15,0:10:35.70,Main-207+,,0,0,0,,Evet, 1 no'lu iskelede bazı\Nkorsanlar sıkıntı çıkarıyordu.
Dialogue: 5,0:10:35.70,0:10:40.18,Main-207+,,0,0,0,,Elbette en sonunda işçilerden\Ntemiz bir dayak yediler.
Dialogue: 5,0:10:40.18,0:10:42.07,Main-207+,,0,0,0,,Dünya ahmaklardan geçilmiyor.
Dialogue: 5,0:10:42.07,0:10:45.79,Main-207+,,0,0,0,,Gemi marangozları, korsanları mı dövdü?
Dialogue: 5,0:10:45.79,0:10:48.01,Main-207+,,0,0,0,,Oh, sen de deniz adamısın, ha?
Dialogue: 5,0:10:48.01,0:10:51.58,Main-207+,,0,0,0,,Bu kalabalık... Evet, biz sadece seyirciyiz.
Dialogue: 5,0:10:52.38,0:10:57.05,Main-207+,,0,0,0,,Galley-La Şirketi'nin gemi marangozları,\Nbütün şehir halkının hayranlığını kazanmıştır.
Dialogue: 5,0:10:57.05,0:11:00.97,Main-207+,,0,0,0,,Güçlü ve yetenekliler!
Dialogue: 5,0:11:01.68,0:11:04.93,Main-207+,,0,0,0,,Onlar Water 7'ın gururu!
Dialogue: 5,0:11:08.43,0:11:10.85,Main-207+,,0,0,0,,Vaay, kulağa eğlenceli geliyor!
Dialogue: 5,0:11:11.77,0:11:13.81,Main-207+,,0,0,0,,Hey, Luffy!
Dialogue: 5,0:11:15.19,0:11:17.60,Main-207+,,0,0,0,,Altını değiştirmeye gidelim.
Dialogue: 5,0:11:17.60,0:11:19.89,Main-207+,,0,0,0,,Buraya sonra gelebiliriz.
Dialogue: 5,0:11:19.89,0:11:21.78,Main-207+,,0,0,0,,Tamam.
Dialogue: 5,0:11:33.69,0:11:35.89,Main-207+,,0,0,0,,Burası arka sokak çarşısı.
Dialogue: 5,0:11:35.89,0:11:40.22,Main-207+,,0,0,0,,Bu kadar hareketli bir yer\Nnasıl arka sokak olabilir?
Dialogue: 5,0:11:40.90,0:11:43.49,Main-207+,,0,0,0,,Kaldırımları bile var.
Dialogue: 5,0:11:43.49,0:11:45.90,Main-207+,,0,0,0,,Suyun akışı, şehri tam bir\Nresim tablosu haline getiriyor.
Dialogue: 5,0:11:45.90,0:11:47.18,Main-207+,,0,0,0,,Evet.
Dialogue: 5,0:11:50.14,0:11:52.69,Main-207+,,0,0,0,,Vay! O da ne?
Dialogue: 5,0:11:52.69,0:11:54.34,Main-207+,,0,0,0,,Maske dükkanı.
Dialogue: 5,0:11:55.86,0:12:00.30,Main-207+,,0,0,0,,Şehirde onları takan insanlar gördük.
Dialogue: 5,0:12:00.30,0:12:04.32,Main-207+,,0,0,0,,Yani onlardan mı takıyorlardı? \NSadece tuhaf yüzleri olduğunu düşünmüştüm.
Dialogue: 5,0:12:07.85,0:12:10.49,Main-207+,,0,0,0,,Deniz treninin durduğu\Nadalardan biri olan San Faldo,...
Dialogue: 5,0:12:10.49,0:12:13.25,Main-207+,,0,0,0,,...birkaç günlük maskeli balo karnavalı düzenliyor.
Dialogue: 5,0:12:13.25,0:12:16.15,Main-207+,,0,0,0,,Ne? Nereden biliyorsun?
Dialogue: 5,0:12:16.15,0:12:18.65,Main-207+,,0,0,0,,İnsanlar bundan bahsederek dolaşıyor.
Dialogue: 5,0:12:19.80,0:12:22.26,Main-207+,,0,0,0,,Onları nasıl duyabilirsin?
Dialogue: 5,0:12:22.26,0:12:23.61,Main-207+,,0,0,0,,Alışkanlık.
Dialogue: 5,0:12:24.90,0:12:29.88,Main-207+,,0,0,0,,Çok küçükken, bir kimsenin yüzünü\Ngördüğümde dikkatli dinlemeyi öğrendim.
Dialogue: 5,0:12:31.79,0:12:33.98,Main-207+,,0,0,0,,İnanılmazsın Robin.
Dialogue: 5,0:12:40.70,0:12:42.95,Main-207+,,0,0,0,,– Doktor bey.\N– Ha?
Dialogue: 5,0:12:42.95,0:12:45.50,Main-207+,,0,0,0,,Orada bir kitapçı görüyorum.
Dialogue: 5,0:12:45.50,0:12:47.12,Main-207+,,0,0,0,,Cidden mi?!
Dialogue: 5,0:12:47.12,0:12:49.03,Main-207+,,0,0,0,,Burada durabilir miyiz?!
Dialogue: 5,0:12:50.10,0:12:52.12,Main-207+,,0,0,0,,Elbette! İçeri girelim!
Dialogue: 5,0:12:52.76,0:12:54.08,Main-207+,,0,0,0,,Yaşasın!
Dialogue: 5,0:13:06.55,0:13:08.68,Main-207+,,0,0,0,,CP9'danım.
Dialogue: 5,0:13:24.36,0:13:27.32,Main-207+,,0,0,0,,Robin! Ben giriyorum!
Dialogue: 5,0:13:55.14,0:13:59.15,Thoughts-207+,,0,0,0,,İnsan şeklindeyken sorun olmaz.
Dialogue: 5,0:14:00.65,0:14:05.39,Main-207+,,0,0,0,,Ah, ne güzel bir maske! \NNe olarak giyindin?
Dialogue: 5,0:14:05.39,0:14:08.61,Main-207+,,0,0,0,,Şey... İnsan rengeyiği.
Dialogue: 5,0:14:11.21,0:14:12.53,Main-207+,,0,0,0,,Hoşuna giden buysa ne âlâ!
Dialogue: 5,0:14:15.59,0:14:16.54,Thoughts-207+,,0,0,0,,Ha?
Dialogue: 5,0:14:22.70,0:14:24.38,Main-207+,,0,0,0,,Robin?
Dialogue: 5,0:14:25.28,0:14:26.69,Main-207+,,0,0,0,,Hey!
Dialogue: 5,0:14:28.08,0:14:29.86,Main-207+,,0,0,0,,Robin?!
Dialogue: 5,0:15:05.51,0:15:08.63,Main-207+,,0,0,0,,Seni hazırlıksız yakaladığımızı düşünmüştüm.
Dialogue: 5,0:15:12.59,0:15:14.48,Main-207+,,0,0,0,,Siz de kimsiniz?
Dialogue: 5,0:15:15.50,0:15:16.93,Main-207+,,0,0,0,,Kendinizi tanıtın!
Dialogue: 5,0:15:16.93,0:15:20.08,Main-207+,,0,0,0,,100 milyon beli mi?!
Dialogue: 5,0:15:20.08,0:15:23.90,Main-207+,,0,0,0,,S-S-Seni aptal! O kadar yüksek sesle bağırma! Herkes duyacak!
Dialogue: 5,0:15:23.90,0:15:26.37,Main-207+,,0,0,0,,G-G-Gerçekten bize o kadar\N para verecek misiniz?
Dialogue: 5,0:15:26.37,0:15:29.86,Main-207+,,0,0,0,,H-Hadi ama Luffy! Çok fazla bağırıyorsun!
Dialogue: 5,0:15:30.69,0:15:32.91,Main-207+,,0,0,0,,Kesinlikle o kadar eder.
Dialogue: 5,0:15:32.91,0:15:36.87,Main-207+,,0,0,0,,Bu fantastik eserler saf altından\Nve tarihi değeri de var.
Dialogue: 5,0:15:36.87,0:15:39.99,Main-207+,,0,0,0,,Bu kadar parayla Merry'yi yeni gibi yaptırırız!
Dialogue: 5,0:15:39.99,0:15:42.09,Main-207+,,0,0,0,,Evet! Artar bile!
Dialogue: 5,0:15:42.09,0:15:45.33,Main-207+,,0,0,0,,Kalanını bronz heykel almak için kullanalım!
Dialogue: 5,0:15:45.33,0:15:46.78,Main-207+,,0,0,0,,Hayır, onu almıyoruz.
Dialogue: 5,0:15:46.78,0:15:51.14,Main-207+,,0,0,0,,Fiyatı kabul ettiyseniz\Nlütfen imzalayın ve parmak basın.
Dialogue: 5,0:15:51.14,0:15:54.22,Main-207+,,0,0,0,,Böylece anlaşmamız tamamlanmış olacak.
Dialogue: 5,0:15:54.22,0:15:57.18,Main-207+,,0,0,0,,Tamam! İstediğiniz her şeyi imzalarım!
Dialogue: 5,0:15:57.18,0:16:00.02,Main-207+,,0,0,0,,Yardım lazımsa ben de ederim!
Dialogue: 5,0:16:09.65,0:16:12.31,Main-207+,,0,0,0,,Ne? Sorun nedir, Nami?
Dialogue: 5,0:16:12.31,0:16:17.92,Main-207+,,0,0,0,,Söylemek istediğim üç şey var. \NSayın değer biçici...
Dialogue: 5,0:16:17.92,0:16:23.79,Main-207+,,0,0,0,,Bir, daha önce bahsetmiş olmalıyım ama bu\Nadamın kafasına 100 milyonluk bir ödül var.
Dialogue: 5,0:16:25.00,0:16:26.75,Main-207+,,0,0,0,,İki,...
Dialogue: 5,0:16:26.75,0:16:30.09,Main-207+,,0,0,0,,...biçtiğiniz değeri kabul etmiyorum.
Dialogue: 5,0:16:30.09,0:16:36.01,Main-207+,,0,0,0,,Üç, bir daha bana yalan söylerseniz\N boynunuzu kırarım.
Dialogue: 5,0:16:36.01,0:16:37.22,Main-207+,,0,0,0,,Hepsi bu.
Dialogue: 5,0:16:37.22,0:16:41.39,Main-207+,,0,0,0,,Ö- ÖZÜR DİLERİM!
Dialogue: 5,0:16:41.39,0:16:46.40,Main-207+,,0,0,0,,300 milyon beli!\NBu bir rüya olmalı!
Dialogue: 5,0:16:46.40,0:16:50.32,Main-207+,,0,0,0,,Gökyüzü Adası macerasının\Nkarşılığını nihayet aldık!
Dialogue: 5,0:16:50.32,0:16:52.53,Main-207+,,0,0,0,,ZENGİNİM!
Dialogue: 5,0:16:52.53,0:16:53.65,Main-207+,,0,0,0,,BİZ DE ÖYLE!
Dialogue: 5,0:16:54.54,0:16:56.80,Main-207+,,0,0,0,,Lütfen yine gelin!
Dialogue: 5,0:16:56.80,0:17:01.35,Main-207+,,0,0,0,,300 milyonumuz var! Korkuyorum!
Dialogue: 5,0:17:01.35,0:17:03.66,Main-207+,,0,0,0,,Gerçekten 100 milyon mu tutuyorum?!
Dialogue: 5,0:17:03.66,0:17:07.44,Main-207+,,0,0,0,,Aaah, Nami. Kızınca korkunç oluyorsun!
Dialogue: 5,0:17:07.44,0:17:11.70,Main-207+,,0,0,0,,İçeri girmeden önce aklımda bir tahmin vardı.\NSadece 100 milyon verip bizi kandırmaya çalıştı.
Dialogue: 5,0:17:11.70,0:17:14.80,Main-207+,,0,0,0,,O kadar safsınız ki\Nsizi kandırmasına izin verdiniz!
Dialogue: 5,0:17:14.80,0:17:18.51,Main-207+,,0,0,0,,Hey, Luffy! Çantayı sallamayı kes!
Dialogue: 5,0:17:18.51,0:17:22.47,Main-207+,,0,0,0,,Evet, her şey iyi sonuçlandı.
Dialogue: 5,0:17:23.48,0:17:26.44,Main-207+,,0,0,0,,AHH! NEHİR!!
Dialogue: 5,0:17:26.44,0:17:29.98,Main-207+,,0,0,0,,100 milyon belimiz nehire gidiyor!
Dialogue: 5,0:17:32.60,0:17:35.03,Main-207+,,0,0,0,,Üff, çok yakındı!
Dialogue: 5,0:17:37.32,0:17:41.09,Main-207+,,0,0,0,,Canına okuyacağım senin!
Dialogue: 5,0:17:38.01,0:17:41.09,Secondary-207+,,0,0,0,,Dişlerini dökeceğim!
Dialogue: 5,0:17:42.19,0:17:46.62,Main-207+,,0,0,0,,Ö-Ö-Özür dilerim.
Dialogue: 5,0:18:00.00,0:18:02.81,Main-207+,,0,0,0,,"Kendinizi tanıtın" öyle mi?
Dialogue: 5,0:18:02.81,0:18:05.06,Main-207+,,0,0,0,,Korsan Avcısı Zoro!
Dialogue: 5,0:18:09.06,0:18:15.94,Main-207+,,0,0,0,,Biz, adı ağlayan çocukların korkuyla susmasına neden olan bir grup ödül avcısı, Franky Kardeşler'iz!
Dialogue: 5,0:18:16.64,0:18:20.98,Main-207+,,0,0,0,,Kafan 60 milyon beli değerinde\Nve onu alacağız, sağolasın.
Dialogue: 5,0:18:20.98,0:18:23.91,Main-207+,,0,0,0,,Kendi geminde sana tuzak kurduğumuza göre,...
Dialogue: 5,0:18:23.91,0:18:26.71,Main-207+,,0,0,0,,...tayfanın geri kalanını da yakalayabiliriz!
Dialogue: 5,0:18:28.49,0:18:30.63,Main-207+,,0,0,0,,Kolay para! Ne şans!
Dialogue: 5,0:18:32.78,0:18:33.96,Main-207+,,0,0,0,,Biri gitti!
Dialogue: 5,0:18:36.81,0:18:38.08,Main-207+,,0,0,0,,Şans mı?
Dialogue: 5,0:18:41.01,0:18:42.97,Main-207+,,0,0,0,,Şanssız demek istedin, herhalde!
Dialogue: 5,0:18:50.10,0:18:52.06,Main-207+,,0,0,0,,Tereddüt etmeyin!
Dialogue: 5,0:18:52.77,0:18:54.02,Main-207+,,0,0,0,,{\fad(150,150)}Nitoryu...
Dialogue: 5,0:18:52.77,0:18:54.02,Attack,,0,0,0,,{\fad(150,150)}İki Kılıç Stili
Dialogue: 5,0:18:55.72,0:18:58.12,Main-207+,,0,0,0,,{\fad(150,150)}Sai Kuru!
Dialogue: 5,0:18:55.72,0:18:58.12,Attack,,0,0,0,,{\fad(150,150)}...Gergedan Dönüşü
Dialogue: 5,0:19:09.51,0:19:11.04,Main-207+,,0,0,0,,Ahmak sürüsü.
Dialogue: 5,0:19:13.50,0:19:14.96,Main-207+,,0,0,0,,K-Kahretsin!
Dialogue: 5,0:19:17.92,0:19:21.93,Main-207+,,0,0,0,,N-Nami, bunu indirmemiz için geminin\Nyanından dönmemiz gerekmiyor mu?
Dialogue: 5,0:19:21.93,0:19:25.89,Main-207+,,0,0,0,,Bu çok uzun sürerdi. \NAyrıca tersane bu rampanın aşağısında.
Dialogue: 5,0:19:25.89,0:19:29.85,Main-207+,,0,0,0,,Hey, paraya yaklaşmama izin\Nvermemeniz beni biraz şok etti.
Dialogue: 5,0:19:29.85,0:19:37.32,Main-207+,,0,0,0,,Tamirat tahmini yapabilecek bir gemi marangozu bulunca, zaten doğruca Going Merry'ye dönebileceğiz.
Dialogue: 5,0:19:37.78,0:19:39.32,Main-207+,,0,0,0,,Doğru.
Dialogue: 5,0:19:39.32,0:19:40.78,Main-207+,,0,0,0,,Sanırım haklısın.
Dialogue: 5,0:19:40.78,0:19:44.90,Main-207+,,0,0,0,,Hiç bu kadar çok para taşımamıştım,\Nbu yüzden ne yapacağımı bilmiyorum.
Dialogue: 5,0:19:44.90,0:19:47.30,Main-207+,,0,0,0,,Evet, bu normal bir his.
Dialogue: 5,0:19:47.30,0:19:49.86,Main-207+,,0,0,0,,Sallayıp durmak aptalca olurdu, değil mi?
Dialogue: 5,0:19:49.86,0:19:52.54,Main-207+,,0,0,0,,Ah, hey, bakın! Su Çöreği!
Dialogue: 5,0:19:52.54,0:19:54.06,Main-207+,,0,0,0,,100 tane alalım.
Dialogue: 5,0:19:53.21,0:19:54.06,Secondary-207+,,0,0,0,,Kapa çeneni.
Dialogue: 5,0:19:54.06,0:19:55.70,Main-207+,,0,0,0,,O zaman 1,000 tane alalım!
Dialogue: 5,0:19:54.80,0:19:55.70,Secondary-207+,,0,0,0,,Kapa çeneni!
Dialogue: 5,0:19:55.70,0:19:57.12,Main-207+,,0,0,0,,O zaman...
Dialogue: 5,0:19:56.01,0:19:57.12,Secondary-207+,,0,0,0,,KAPA ÇENENİ!
Dialogue: 5,0:19:57.12,0:19:58.69,Main-207+,,0,0,0,,Tamam.
Dialogue: 5,0:20:11.69,0:20:15.78,Main-207+,,0,0,0,,Tersane girişine geri döndük!
Dialogue: 5,0:20:17.60,0:20:22.61,Main-207+,,0,0,0,,İyi. Deminki kalabalık gitmiş.
Dialogue: 5,0:20:22.61,0:20:27.62,Main-207+,,0,0,0,,Neyse, onu arayalım.\NO... adamı... adı neydi?
Dialogue: 5,0:20:27.62,0:20:29.19,Main-207+,,0,0,0,,Iceburg.
Dialogue: 5,0:20:29.19,0:20:31.70,Main-207+,,0,0,0,,Doğru! Buz amca!
Dialogue: 5,0:20:31.70,0:20:33.64,Main-207+,,0,0,0,,Kim acaba?
Dialogue: 5,0:20:33.64,0:20:37.56,Main-207+,,0,0,0,,İstasyondaki yaşlı kadın onunla\Nkonuşmamızı söylemişti ama...
Dialogue: 5,0:20:37.56,0:20:38.59,Main-207+,,0,0,0,,Evet.
Dialogue: 5,0:20:38.59,0:20:42.59,Main-207+,,0,0,0,,Belki de içeri girebiliriz.
Dialogue: 5,0:20:42.59,0:20:44.41,Main-207+,,0,0,0,,İçeri giriyorum!
Dialogue: 5,0:20:44.41,0:20:45.43,Main-207+,,0,0,0,,Yine mi?!
Dialogue: 5,0:20:46.80,0:20:49.06,Main-207+,,0,0,0,,Dur bakalım!
Dialogue: 5,0:20:48.04,0:20:49.06,Secondary-207+,,0,0,0,,Ne?
Dialogue: 5,0:20:49.06,0:20:50.60,Main-207+,,0,0,0,,Kendine hakim ol.
Dialogue: 5,0:20:50.60,0:20:52.10,Main-207+,,0,0,0,,Burada çalıştığını sanmıyorum.
Dialogue: 5,0:20:52.10,0:20:56.10,Main-207+,,0,0,0,,Dışarıda konuşalım.
Dialogue: 5,0:20:57.37,0:21:01.32,Main-207+,,0,0,0,,Tersane içinde sadece yetkili personele izin vardır.
Dialogue: 5,0:21:09.29,0:21:11.83,Main-207+,,0,0,5,,İskeleden bir şeye mi ihtiyacınız var?
Dialogue: 5,0:21:11.83,0:21:13.60,Main-207+,,0,0,0,,Hey, sen Usopp musun?
Dialogue: 5,0:21:13.60,0:21:16.50,Main-207+,,0,0,0,,Hey! Ben buradayım, Luffy!
Dialogue: 5,0:21:16.50,0:21:18.79,Main-207+,,0,0,0,,Doğru. Bu adamın burnu kare!
Dialogue: 5,0:21:18.79,0:21:23.69,Main-207+,,0,0,0,,Ah, evet! Iceburg-san'ı görmek istiyorduk.
Dialogue: 5,0:21:23.69,0:21:26.13,Main-207+,,0,0,0,,Iceburg-san mı?\NMüşteri misiniz?
Dialogue: 5,0:21:26.96,0:21:28.70,Main-207+,,0,0,0,,Ah, anlıyorum.
Dialogue: 5,0:21:28.70,0:21:32.06,Main-207+,,0,0,0,,Vardiya İstasyonu'ndaki Kokoro'dan\Ntakdim mektubunuz var.
Dialogue: 5,0:21:32.06,0:21:35.09,Main-207+,,0,0,0,,Ha? Sen yaşlı bir adam mısın?
Dialogue: 5,0:21:35.09,0:21:36.80,Main-207+,,0,0,0,,23 yaşındayım.
Dialogue: 5,0:21:36.80,0:21:40.95,Main-207+,,0,0,0,,23 mü? \NYaşlı bir adam gibi konuşuyorsun!
Dialogue: 5,0:21:41.96,0:21:43.29,Main-207+,,0,0,0,,İnsanlar hep böyle der.
Dialogue: 5,0:21:43.29,0:21:45.90,Main-207+,,0,0,0,,Iceburg denen kişiyi tanıyor musunuz?
Dialogue: 5,0:21:45.90,0:21:51.87,Main-207+,,0,0,0,,Nasıl tanımam? \NIceburg-san, Water 7'ın başkanıdır!
Dialogue: 5,0:21:51.87,0:21:55.71,Main-207+,,0,0,0,,Demek öyle, epey önemli biri gibi.
Dialogue: 5,0:21:55.71,0:21:57.90,Main-207+,,0,0,0,,Sadece bu değil.
Dialogue: 5,0:21:57.90,0:22:00.69,Main-207+,,0,0,0,,Ayrıca Galley-La Şirketi'nin de başkanıdır...
Dialogue: 5,0:22:00.69,0:22:02.50,Main-207+,,0,0,0,,...ve deniz treninin şefidir.
Dialogue: 5,0:22:02.50,0:22:04.10,Main-207+,,0,0,0,,Müthiş biri!
Dialogue: 5,0:22:04.10,0:22:07.84,Main-207+,,0,0,0,,Evet. Water 7'da onu tanımayan erkek, \Nkadın veya çocuk yoktur.
Dialogue: 5,0:22:07.84,0:22:09.80,Main-207+,,0,0,0,,Onu nerede bulabiliriz?
Dialogue: 5,0:22:09.80,0:22:12.72,Main-207+,,0,0,0,,Şu anda nerede olduğundan emin değilim.
Dialogue: 5,0:22:12.72,0:22:17.19,Main-207+,,0,0,0,,Sağı solu belli olmayan biridir.\NHer yerde sorumlulukları vardır.
Dialogue: 5,0:22:17.19,0:22:20.67,Main-207+,,0,0,0,,Eh? Onunla bağlantı kurmanın bir yolu yok mu?
Dialogue: 5,0:22:20.67,0:22:23.74,Main-207+,,0,0,0,,İmkansız değil ama acil mi?
Dialogue: 5,0:22:23.74,0:22:25.90,Main-207+,,0,0,0,,Acil diyemem ama...
Dialogue: 5,0:22:27.11,0:22:31.87,Main-207+,,0,0,0,,Bunu geminizin tamir edilmesi\Ngerektiği şeklinde mi algılamalıyım?
Dialogue: 5,0:22:31.87,0:22:33.92,Main-207+,,0,0,0,,Geminiz nerede demirli?
Dialogue: 5,0:22:33.92,0:22:35.70,Main-207+,,0,0,0,,Kayalık burunda.
Dialogue: 5,0:22:35.70,0:22:40.95,Main-207+,,0,0,0,,Tamam. Bir koşu gidip bakacağım.
Dialogue: 5,0:22:40.95,0:22:44.25,Main-207+,,0,0,0,,Böylece Iceburg-san'la\Nkarşılaştığınızda işler daha hızlı yürür.
Dialogue: 5,0:22:44.25,0:22:46.88,Main-207+,,0,0,0,,Fiyatı da görüşebiliriz.
Dialogue: 5,0:22:46.88,0:22:50.47,Main-207+,,0,0,0,,Koşmak mı? \NYagara Boğası mı kullanacaksın?
Dialogue: 5,0:22:52.39,0:22:58.44,Main-207+,,0,0,0,,Öyle olsaydı, ben dönene dek sıkıntıdan patlardınız!\NSadece 10 dakika bekleyin.
Dialogue: 5,0:22:58.44,0:23:00.44,Main-207+,,0,0,0,,On dakika mı?
Dialogue: 5,0:23:00.44,0:23:03.11,Main-207+,,0,0,0,,Evet, on dakika.
Dialogue: 5,0:23:06.51,0:23:07.82,Main-207+,,0,0,0,,Oooh!
Dialogue: 5,0:23:09.78,0:23:11.74,Main-207+,,0,0,0,,– Çok hızlı!\N– Vaay!
Dialogue: 5,0:23:14.83,0:23:17.79,Main-207+,,0,0,0,,Aaah! Atladı!
Dialogue: 5,0:23:19.79,0:23:23.25,Main-207+,,0,0,0,,Ama dur biraz, o duvarın üstünden giderse...
Dialogue: 5,0:23:23.25,0:23:24.67,Main-207+,,0,0,0,,...DÜŞECEK!
Dialogue: 5,0:23:24.67,0:23:26.63,Main-207+,,0,0,0,,AHH! DÜŞTÜ!!
Dialogue: 5,0:23:35.60,0:23:37.31,Main-207+,,0,0,0,,Müthiş!
Dialogue: 5,0:23:37.31,0:23:39.10,Main-207+,,0,0,0,,İyi olacak mı?!
Dialogue: 5,0:23:39.79,0:23:43.14,Main-207+,,0,0,0,,Bütün şehirde özgürce koşar.
Dialogue: 5,0:23:44.98,0:23:46.98,Main-207+,,0,0,0,,Ona dağ rüzgarı denir.
Dialogue: 5,0:23:47.61,0:23:52.91,Main-207+,,0,0,0,,Galley-La Şirketi'nin 1 no'lu iskelesinde çalışır. \NGemi marangozu usta başlarından biridir.
Dialogue: 5,0:23:54.87,0:23:55.83,Main-207+,,0,0,0,,Kaku.
Dialogue: 5,0:24:00.00,0:24:03.79,Main-207+,,0,0,0,,Ah, anlıyorum.
Dialogue: 5,0:24:03.79,0:24:08.04,Main-207+,,0,0,0,,Su şehri, ha? Etkileyici!
Dialogue: 5,0:24:08.04,0:24:12.70,Main-207+,,0,0,0,,İnsanlarla dolu temiz ve hareketli sokaklarıyla,\Nnehirlerine uygun büyük bir fıskiyesi var.
Dialogue: 5,0:24:12.70,0:24:15.19,Main-207+,,0,0,0,,Bir sürü de güzel kadın!
Dialogue: 5,0:24:15.19,0:24:20.77,Main-207+,,0,0,0,,Bu şehirde Nami-san veya\NRobin-chan'la çıkmak isterdim!
Dialogue: 5,0:24:20.77,0:24:23.98,Main-207+,,0,0,0,,Vaya ikisiyle birden çıkmak daha iyi olurdu!
Dialogue: 5,0:24:26.29,0:24:29.60,Main-207+,,0,0,0,,Solumda Nami-san ve sağımda Robin-chan!
Dialogue: 5,0:24:29.60,0:24:32.90,Main-207+,,0,0,0,,Hey, bayım.\NTuhaf yüz ifadelerini bırak.
Dialogue: 5,0:24:32.90,0:24:35.62,Main-207+,,0,0,0,,Hangi su lahanasını alacaksın?
Dialogue: 5,0:24:35.62,0:24:39.16,Main-207+,,0,0,0,,Ha? Ah, ikisini de. \NBir şey daha var, ablacım.
Dialogue: 5,0:24:39.80,0:24:43.12,Main-207+,,0,0,0,,Yılın bu zamanında en taze ne\Nvarsa ondan arıyorum. Neyin var?
Dialogue: 5,0:24:43.83,0:24:47.09,Main-207+,,0,0,0,,Ah... üfff.
Dialogue: 5,0:24:47.09,0:24:49.59,Main-207+,,0,0,0,,Bu şehirde yürümek çok can sıkıcı.
Dialogue: 5,0:24:52.78,0:24:55.94,Main-207+,,0,0,0,,Çıkmaz bir yol daha! Kahretsin!
Dialogue: 5,0:24:55.94,0:24:58.93,Main-207+,,0,0,0,,Yolumu mu kaybettim?
Dialogue: 5,0:24:58.93,0:25:02.49,Main-207+,,0,0,0,,Kahrolası kılıç ustası gibi\Netrafta dolanıp duruyorum!
Dialogue: 5,0:25:09.32,0:25:12.28,Main-207+,,0,0,0,,OH! ROBIN-CHAAAAN!!
Dialogue: 5,0:25:13.00,0:25:15.24,Main-207+,,0,0,0,,HEY, BENİM!
Dialogue: 5,0:25:15.24,0:25:18.61,Main-207+,,0,0,0,,ROBIN-CHWA... Ha?
Dialogue: 5,0:25:18.61,0:25:20.10,Main-207+,,0,0,0,,Ha?
Dialogue: 5,0:25:21.81,0:25:23.50,Main-207+,,0,0,0,,Yok oldu?
Dialogue: 5,0:25:23.50,0:25:25.59,Main-207+,,0,0,0,,Başka bir yol veya kapı da görmüyorum.
Dialogue: 5,0:25:26.88,0:25:29.29,Main-207+,,0,0,0,,Uçtu mu yoksa?
Dialogue: 5,0:25:33.08,0:25:34.38,Main-207+,,0,0,0,,Usopp?
Dialogue: 5,0:25:35.40,0:25:40.14,Main-207+,,0,0,0,,Bu şehrin nesi var? Deliriyor muyum?
Dialogue: 5,0:25:52.69,0:25:56.23,Main-207+,,0,0,0,,Oh, gemileri bu olmalı.
Dialogue: 5,0:25:59.71,0:26:00.91,Main-207+,,0,0,0,,Afedersiniz!
Dialogue: 5,0:26:04.34,0:26:06.87,Thoughts-207+,,0,0,0,,Ah, Usopp'muş.
Dialogue: 5,0:26:06.87,0:26:10.47,Main-207+,,0,0,0,,Anlıyorum. Çok fazla hasar var.
Dialogue: 5,0:26:15.11,0:26:17.34,Main-207+,,0,0,0,,Ana direk değiştirilmeli.
Dialogue: 5,0:26:19.30,0:26:21.08,Main-207+,,0,0,0,,Uso... pp?
Dialogue: 5,0:26:22.56,0:26:25.71,Main-207+,,0,0,0,,Dur biraz!!! Sen de kimsin?!
Dialogue: 5,0:26:25.71,0:26:28.52,Main-207+,,0,0,0,,Oh, afedersin. Seni uyandırdım mı?
Dialogue: 5,0:26:29.24,0:26:31.68,Main-207+,,0,0,0,,Vay! Bu beni çok şaşırttı!
Dialogue: 5,0:26:31.68,0:26:33.94,Main-207+,,0,0,0,,Öylece atladı!
Dialogue: 5,0:26:33.94,0:26:37.53,Main-207+,,0,0,0,,Evet... gemi marangozlarımız hafife alınmamalı.
Dialogue: 5,0:26:37.53,0:26:39.01,Main-207+,,0,0,0,,Sahi, bu adam kim?
Dialogue: 5,0:26:39.01,0:26:39.89,Main-207+,,0,0,0,,Bilmem.
Dialogue: 5,0:26:39.89,0:26:43.69,Main-207+,,0,0,0,,Hız istiyorsanız, sağlam gemiler konusunda...
Dialogue: 5,0:26:43.69,0:26:46.80,Main-207+,,0,0,0,,...sıradan yetenekli kimseye güvenemezsiniz.
Dialogue: 5,0:26:46.80,0:26:48.09,Main-207+,,0,0,0,,Evet, Kalifa?
Dialogue: 5,0:26:48.09,0:26:49.50,Main-207+,,0,0,0,,Evet, onları araştırdım.
Dialogue: 5,0:26:50.81,0:26:55.46,Main-207+,,0,0,0,,Hasır Şapkalı Luffy,\N Korsan Avcısı Zoro, Nico Robin.
Dialogue: 5,0:26:56.42,0:26:59.09,Main-207+,,0,0,0,,Tayfalarındaki üç kişi aranıyor...
Dialogue: 5,0:26:59.09,0:27:01.99,Main-207+,,0,0,0,,...ve toplam ödülleri 239 milyon beli.
Dialogue: 5,0:27:01.99,0:27:03.43,Main-207+,,0,0,0,,Aslen Doğu Mavi'liler.
Dialogue: 5,0:27:03.43,0:27:07.09,Main-207+,,0,0,0,,Tayfaları Hasır Şapka Korsanları olarak\Nbilinen yedi kişiden oluşuyor.
Dialogue: 5,0:27:07.09,0:27:09.39,Thoughts-207+,,0,0,0,,Hakkımızdaki her şeyi biliyorlar!
Dialogue: 5,0:27:09.39,0:27:11.45,Main-207+,,0,0,0,,Anlıyorum. Uzun yoldan geliyorsunuz.
Dialogue: 5,0:27:11.45,0:27:14.40,Main-207+,,0,0,0,,Ben Iceburg, şehrin başkanıyım.
Dialogue: 5,0:27:14.40,0:27:17.40,Main-207+,,0,0,0,,Bu da daha önce bulduğum bir fare.
Dialogue: 5,0:27:17.40,0:27:19.50,Main-207+,,0,0,0,,Adı...
Dialogue: 5,0:27:19.50,0:27:21.32,Main-207+,,0,0,0,,Tyrannosaurus.
Dialogue: 5,0:27:21.32,0:27:23.30,Main-207+,,0,0,0,,Ona hala yiyecek ve kafes almam gerekiyor.
Dialogue: 5,0:27:23.30,0:27:25.70,Main-207+,,0,0,0,,Onlar halledildi, Iceburg-san.
Dialogue: 5,0:27:25.70,0:27:27.33,Main-207+,,0,0,0,,Her zamanki gibi hızlısın, Kalifa.
Dialogue: 5,0:27:27.33,0:27:29.60,Main-207+,,0,0,0,,Teşekkür ederim, efendim.
Dialogue: 5,0:27:29.60,0:27:32.64,Main-207+,,0,0,0,,Daha da önemlisi, \Non dakika sonra Chiza Oteli'nde...
Dialogue: 5,0:27:32.64,0:27:34.95,Main-207+,,0,0,0,,...züccaciye fabrikasının yönetim kuruluyla yemekli bir toplantınız var.
Dialogue: 5,0:27:34.95,0:27:37.59,Main-207+,,0,0,0,,Daha sonra Liguria Plaza'da\Nbir konferans vereceksiniz.
Dialogue: 5,0:27:37.59,0:27:41.95,Main-207+,,0,0,0,,Hemen peşinden Mükemmel Mutfak Şehri\NPucci'den Başkan Bimine'le bir toplantınız var.
Dialogue: 5,0:27:41.95,0:27:44.76,Main-207+,,0,0,0,,Basınla röportaj yapacaksınız...
Dialogue: 5,0:27:44.76,0:27:49.48,Main-207+,,0,0,0,,...ve ofise döndüğünüzde ilgilenmeniz\Ngereken birkaç evrak işi var.
Dialogue: 5,0:27:50.12,0:27:51.50,Main-207+,,0,0,0,,İstemiyorum!
Dialogue: 5,0:27:52.44,0:27:54.73,Main-207+,,0,0,0,,Pekala. Hepsini iptal ediyorum.
Dialogue: 5,0:27:54.73,0:27:56.65,Main-207+,,0,0,0,,Hey! Bu doğru mu ki?!
Dialogue: 5,0:27:56.65,0:28:00.23,Main-207+,,0,0,0,,İstediğimi yapacak kadar güçlüyüm.
Dialogue: 5,0:28:00.23,0:28:03.30,Main-207+,,0,0,0,,Epey sorumsuz bir başkansın!
Dialogue: 5,0:28:03.30,0:28:05.51,Main-207+,,0,0,0,,Bu adam bencilin teki!
Dialogue: 5,0:28:05.51,0:28:08.80,Main-207+,,0,0,0,,Ama yaşlı kadının bahsettiği adam bu, değil mi?
Dialogue: 5,0:28:08.80,0:28:10.62,Main-207+,,0,0,0,,Evet, o adam!
Dialogue: 5,0:28:10.62,0:28:12.29,Main-207+,,0,0,0,,Kaba insanlar!
Dialogue: 5,0:28:19.40,0:28:21.00,Main-207+,,0,0,0,,N'apıyorsun lan sen?!
Dialogue: 5,0:28:21.00,0:28:22.01,Main-207+,,0,0,0,,Ödümü kopardı!
Dialogue: 5,0:28:28.23,0:28:31.24,Main-207+,,0,0,8,,{\q2}Gemi yapımında dünyanın en önde gelen kişisine,...
Dialogue: 5,0:28:31.24,0:28:33.48,Main-207+,,0,0,8,,...nasıl "o adam" diye hitap edersiniz?!
Dialogue: 5,0:28:33.48,0:28:34.98,Main-207+,,0,0,0,,Ne oldu?
Dialogue: 5,0:28:34.98,0:28:37.55,Main-207+,,0,0,0,,Başkanın sekreteri öfkeden patladı!
Dialogue: 5,0:28:37.55,0:28:38.98,Main-207+,,0,0,0,,Umarım beni de tekmeler!
Dialogue: 5,0:28:38.98,0:28:42.49,Main-207+,,0,0,0,,Pardon. Bir anlığına kendimi kaybettim.
Dialogue: 5,0:28:42.49,0:28:46.91,Main-207+,,0,0,0,,Ancak Iceburg-san, \Nvatandaşlar tarafından çok sevilir!
Dialogue: 5,0:28:46.91,0:28:51.16,Main-207+,,0,0,0,,Kalifa'yı kızdırmayın. Kızdığı zaman...
Dialogue: 5,0:28:51.16,0:28:53.92,Main-207+,,0,0,0,,...ayırt etmez!
Dialogue: 5,0:28:54.91,0:28:57.31,Main-207+,,0,0,0,,Onun suratını tekmeledin!
Dialogue: 5,0:28:57.31,0:28:58.38,Main-207+,,0,0,0,,Asıl kaba olan sensin!
Dialogue: 5,0:28:58.38,0:29:02.47,Main-207+,,0,0,0,,Neyse, siz Iceburg-san'sınız, değil mi?
Dialogue: 5,0:29:03.26,0:29:05.34,Main-207+,,0,0,0,,Şuna bakın. Bir takdim mektubu.
Dialogue: 5,0:29:05.34,0:29:07.90,Main-207+,,0,0,0,,Yaşlı Kadın Kokoro?
Dialogue: 5,0:29:07.90,0:29:10.31,Main-207+,,0,0,0,,"Gemileriyle ilgilen." demek?
Dialogue: 5,0:29:12.31,0:29:16.49,Main-207+,,0,0,0,,Eh?! Yani ilgilenmeyecek misiniz?\NLütfen gemimizi tamir edin!
Dialogue: 5,0:29:16.49,0:29:18.20,Main-207+,,0,0,0,,Masrafını ödeyebiliriz!
Dialogue: 5,0:29:18.20,0:29:22.69,Main-207+,,0,0,0,,Merry çok fazla yolculuk ettiği için\Nkötü durumda. Yardımınız lazım amca!
Dialogue: 5,0:29:22.69,0:29:25.70,Main-207+,,0,0,0,,Öylece! O kadar kolay mıydı?!
Dialogue: 5,0:29:22.69,0:29:23.89,Secondary-207+,,0,0,0,,Tamam.
Dialogue: 5,0:29:25.70,0:29:27.70,Main-207+,,0,0,0,,O zaman mektubu neden yırttın?!
Dialogue: 5,0:29:24.79,0:29:25.70,Secondary-207+,,0,0,0,,Tabii.
Dialogue: 5,0:29:27.70,0:29:29.71,Main-207+,,0,0,0,,Öpücük işareti iğrençti.
Dialogue: 5,0:29:29.71,0:29:32.45,Main-207+,,0,0,0,,Kokoro, eski kadeh arkadaşım.
Dialogue: 5,0:29:32.45,0:29:35.90,Main-207+,,0,0,0,,Evet... bu bir yana, Kaku zaten\Nbir değerlendirme yapmaya gitti.
Dialogue: 5,0:29:35.90,0:29:38.42,Main-207+,,0,0,0,,Her şey düzenli bir şekilde ilerliyor. \NEndişelenmeyin.
Dialogue: 5,0:29:40.48,0:29:43.01,Main-207+,,0,0,0,,Ahh, çok sıkıcı bir gün.
Dialogue: 5,0:29:43.01,0:29:44.69,Main-207+,,0,0,0,,Size tersaneyi gezdireyim.
Dialogue: 5,0:29:44.69,0:29:46.28,Main-207+,,0,0,0,,Süper! Gerçekten mi?
Dialogue: 5,0:29:46.28,0:29:47.39,Main-207+,,0,0,0,,Bu taraftan lütfen.
Dialogue: 5,0:29:47.39,0:29:50.35,Main-207+,,0,0,0,,Tüm işini iptal etti, şimdiyse sıkılıyor mu?
Dialogue: 5,0:29:50.35,0:29:52.60,Main-207+,,0,0,0,,Evet! Tersaneyi görmeye gidelim!
Dialogue: 5,0:29:53.79,0:29:55.56,Main-207+,,0,0,0,,Sahi, para...
Dialogue: 5,0:29:56.40,0:29:58.50,Main-207+,,0,0,0,,Para...? Ne?
Dialogue: 5,0:29:58.50,0:30:00.57,Main-207+,,0,0,0,,Ne?
Dialogue: 5,0:30:03.45,0:30:06.45,Main-207+,,0,0,0,,Ne oldu Usopp?
Dialogue: 5,0:30:07.20,0:30:10.45,Main-207+,,0,0,0,,P-P-Para... Para gitmiş!
Dialogue: 5,0:30:11.91,0:30:13.36,Main-207+,,0,0,0,,Etrafa iyice bak!
Dialogue: 5,0:30:13.36,0:30:16.91,Main-207+,,0,0,0,,Aradım! Gitmiş!
Dialogue: 5,0:30:18.83,0:30:21.15,Main-207+,,0,0,0,,Ahhh! Onlar almış!
Dialogue: 5,0:30:27.80,0:30:31.31,Main-207+,,0,0,0,,Hey! Sizi pislikler! Ne yapıyorsunuz?!
Dialogue: 5,0:30:31.31,0:30:33.90,Main-207+,,0,0,0,,Başkalarının parasını çalmayın!!
Dialogue: 5,0:30:33.90,0:30:36.77,Main-207+,,0,0,0,,Hey, durun!
Dialogue: 5,0:30:38.33,0:30:39.73,Main-207+,,0,0,0,,Bizim için zevkti!
Dialogue: 5,0:30:40.51,0:30:45.19,Main-207+,,0,0,0,,PARAYI GERİ VERİN!!!
