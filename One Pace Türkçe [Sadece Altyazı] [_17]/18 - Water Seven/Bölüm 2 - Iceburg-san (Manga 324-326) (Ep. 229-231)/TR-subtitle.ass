Dialogue: 0,0:00:03.99,0:00:08.05,Lyrics-OP5,,0,0,0,,{\fad(75,75)}♪ Sorun yok! Yola çıkalım! ♪
Dialogue: 0,0:00:08.31,0:00:11.59,Lyrics-OP5,,0,0,0,,♪ Güneşi hep kalbimizde tutacağız! ♪
Dialogue: 0,0:00:11.73,0:00:15.01,Lyrics-OP5,,0,0,0,,♪ Birleşmiş ellerimiz bize güç veriyor! ♪
Dialogue: 0,0:00:15.10,0:00:18.68,Lyrics-OP5,,0,0,0,,♪ Hayallerimizi yakalayacağız! ♪
Dialogue: 0,0:00:26.24,0:00:32.49,Lyrics-OP5,,0,0,0,,♪ Birleşmiş güçlerimizle dev bir dalgaya bineceğiz. ♪
Dialogue: 0,0:00:33.75,0:00:40.29,Lyrics-OP5,,0,0,1,,♪ İşte işaret! Başarıya doğru acele edelim! ♪
Dialogue: 0,0:00:40.96,0:00:47.13,Lyrics-OP5,,0,0,0,,♪ Bu bizim yola çıkma vaktimiz. Bir kez demir alınca...
Dialogue: 0,0:00:47.93,0:00:55.01,Lyrics-OP5,,0,0,0,,...gökkuşağı renkli rüzgarla macera denizine doğru yola çıkacağız! ♪
Dialogue: 0,0:00:55.06,0:00:58.55,Lyrics-OP5,,0,0,0,,♪ Bu sıkıntıyla dolu bir yolculuk...
Dialogue: 0,0:00:58.56,0:01:02.27,Lyrics-OP5,,0,0,0,,...ama orada önemli bir şey var. ♪
Dialogue: 0,0:01:02.40,0:01:06.35,Lyrics-OP5,,0,0,0,,♪ Başın derde girerse,...
Dialogue: 0,0:01:06.45,0:01:08.36,Lyrics-OP5,,0,0,0,,...yardım etmek için orada olacağım! ♪
Dialogue: 0,0:01:09.45,0:01:13.36,Lyrics-OP5,,0,0,0,,♪ Sorun yok! Yola çıkalım! ♪
Dialogue: 0,0:01:13.66,0:01:16.82,Lyrics-OP5,,0,0,0,,♪ Güneşi hep kalbimizde tutacağız! ♪
Dialogue: 0,0:01:17.17,0:01:20.33,Lyrics-OP5,,0,0,0,,♪ Bir fırtına gelirse omzunu benimkine yasla. ♪
Dialogue: 0,0:01:20.37,0:01:24.20,Lyrics-OP5,,0,0,0,,{\fad(75,0)}♪ İlerideki umut ışığına bakacağız! ♪
Dialogue: 0,0:01:24.67,0:01:27.92,Lyrics-OP5,,0,0,0,,♪ Hayallerimizin parçalarını toplarken,...
