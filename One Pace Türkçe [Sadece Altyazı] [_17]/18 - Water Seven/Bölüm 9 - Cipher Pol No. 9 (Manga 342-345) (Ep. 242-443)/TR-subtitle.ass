Dialogue: 0,0:01:35.66,0:01:39.72,Lyrics-OP5,,0,0,0,,{\fad(75,75)}♪ Sorun yok! Yola çıkalım! ♪
Dialogue: 0,0:01:39.98,0:01:43.26,Lyrics-OP5,,0,0,0,,♪ Güneşi hep kalbimizde tutacağız! ♪
Dialogue: 0,0:01:43.40,0:01:46.68,Lyrics-OP5,,0,0,0,,♪ Birleşmiş ellerimiz bize güç veriyor! ♪
Dialogue: 0,0:01:46.77,0:01:50.35,Lyrics-OP5,,0,0,0,,♪ Hayallerimizi yakalayacağız! ♪
Dialogue: 0,0:01:57.91,0:02:04.16,Lyrics-OP5,,0,0,0,,♪ Birleşmiş güçlerimizle dev bir dalgaya bineceğiz. ♪
Dialogue: 0,0:02:05.42,0:02:11.96,Lyrics-OP5,,0,0,1,,♪ İşte işaret! Başarıya doğru acele edelim! ♪
Dialogue: 0,0:02:12.63,0:02:18.80,Lyrics-OP5,,0,0,0,,♪ Bu bizim yola çıkma vaktimiz. Bir kez demir alınca...
Dialogue: 0,0:02:19.60,0:02:26.68,Lyrics-OP5,,0,0,0,,...gökkuşağı renkli rüzgarla macera denizine doğru yola çıkacağız! ♪
Dialogue: 0,0:02:26.73,0:02:30.22,Lyrics-OP5,,0,0,0,,♪ Bu sıkıntıyla dolu bir yolculuk...
Dialogue: 0,0:02:30.23,0:02:33.94,Lyrics-OP5,,0,0,0,,...ama orada önemli bir şey var. ♪
Dialogue: 0,0:02:34.07,0:02:38.02,Lyrics-OP5,,0,0,0,,♪ Başın derde girerse,...
Dialogue: 0,0:02:38.12,0:02:40.03,Lyrics-OP5,,0,0,0,,...yardım etmek için orada olacağım! ♪
Dialogue: 0,0:02:41.12,0:02:45.03,Lyrics-OP5,,0,0,0,,♪ Sorun yok! Yola çıkalım! ♪
Dialogue: 0,0:02:45.33,0:02:48.49,Lyrics-OP5,,0,0,0,,♪ Güneşi hep kalbimizde tutacağız! ♪
Dialogue: 0,0:02:48.84,0:02:52.00,Lyrics-OP5,,0,0,0,,♪ Bir fırtına gelirse omzunu benimkine yasla. ♪
Dialogue: 0,0:02:52.04,0:02:55.87,Lyrics-OP5,,0,0,0,,{\fad(75,0)}♪ İlerideki umut ışığına bakacağız! ♪
Dialogue: 0,0:02:56.34,0:02:59.59,Lyrics-OP5,,0,0,0,,♪ Hayallerimizin parçalarını toplarken,...
Dialogue: 0,0:03:00.06,0:03:03.22,Lyrics-OP5,,0,0,0,,...bize yarının yolunu gösterecekler! ♪
Dialogue: 0,0:03:03.35,0:03:06.39,Lyrics-OP5,,0,0,0,,♪ Bu yüzden aynı bayrak altında yolculuk ediyoruz. ♪
Dialogue: 0,0:03:06.77,0:03:10.03,Lyrics-OP5,,0,0,0,,{\fad(0,75)}♪ Hayallerimizi yakalayacağız! ♪
Dialogue: 0,0:03:10.06,0:03:12.12,Lyrics-OP5,,0,0,0,,{\fad(0,75)}♪ Biz birleşmişiz...
