Dialogue: 1,0:02:47.52,0:02:52.27,Title,,0,0,0,,{\fad(550,0)}Korsan Kaçırma Olayı
Dialogue: 5,0:01:50.00,0:01:52.71,Main-207+,,0,0,0,,DUR, PAULIE!
Dialogue: 5,0:01:52.71,0:01:55.21,Main-207+,,0,0,0,,Bu kez kaçamayacaksın!
Dialogue: 5,0:01:55.21,0:01:57.80,Main-207+,,0,0,0,,Size sabırlı olun demiştim!
Dialogue: 5,0:01:57.80,0:01:59.29,Main-207+,,0,0,0,,O da ne?
Dialogue: 5,0:01:59.29,0:02:00.47,Main-207+,,0,0,0,,Paulie.
Dialogue: 5,0:02:00.47,0:02:02.51,Main-207+,,0,0,0,,Tahsilatçılar yine peşinde.
Dialogue: 5,0:02:02.51,0:02:04.01,Main-207+,,0,0,0,,Borcunu öde!
Dialogue: 5,0:02:04.01,0:02:07.39,Main-207+,,0,0,0,,Bugün hiç param yok!
Dialogue: 5,0:02:07.39,0:02:10.52,Main-207+,,0,0,0,,Bu seni kurtarmayacak!
Dialogue: 5,0:02:10.52,0:02:13.11,Main-207+,,0,0,0,,Üfff, vazgeçmiyorlar!
Dialogue: 5,0:02:13.11,0:02:15.03,Main-207+,,0,0,0,,Harika! Yagara boğaları.
Dialogue: 5,0:02:17.36,0:02:20.57,Main-207+,,0,0,0,,{\fad(150,150)}Rope Action!
Dialogue: 5,0:02:17.36,0:02:20.57,Attack,,0,0,0,,{\fad(150,150)}Halat Hareketi
Dialogue: 5,0:02:22.41,0:02:25.87,Main-207+,,0,0,0,,– Ahhh! \N– Galley-La gemi marangozlarından biri!
Dialogue: 5,0:02:25.87,0:02:29.12,Main-207+,,0,0,0,,Üzgünüm ama bir süreliğine\Nyagara'nızı ödünç almalıyım!
Dialogue: 5,0:02:29.12,0:02:31.61,Main-207+,,0,0,0,,{\fad(150,150)}Round Turn!
Dialogue: 5,0:02:29.12,0:02:31.61,Attack,,0,0,0,,{\fad(150,150)}Volta
Dialogue: 5,0:02:55.79,0:02:57.99,Main-207+,,0,0,0,,Kahretsin! Yine kaçtı!
Dialogue: 5,0:02:57.99,0:03:00.79,Main-207+,,0,0,0,,Pekala çocuklar, size iyi günler!
Dialogue: 5,0:03:00.79,0:03:03.95,Main-207+,,0,0,0,,Sizinle tekrar koşmayı dört gözle bekliyorum!
Dialogue: 5,0:03:03.95,0:03:05.45,Main-207+,,0,0,0,,Kahretsin!
Dialogue: 5,0:03:05.45,0:03:10.23,Main-207+,,0,0,0,,Mükemmel zamanlamaydı. \NBu harika!
Dialogue: 5,0:03:14.40,0:03:17.88,Main-207+,,0,0,0,,Şükürler olsun!\NO gemi marangozlarınızdan biri, değil mi?
Dialogue: 5,0:03:17.88,0:03:19.48,Main-207+,,0,0,0,,Evet.
Dialogue: 5,0:03:19.48,0:03:21.30,Main-207+,,0,0,0,,Hey! Sağol!
Dialogue: 5,0:03:21.93,0:03:24.26,Main-207+,,0,0,0,,O para bizim!
Dialogue: 5,0:03:24.26,0:03:25.35,Main-207+,,0,0,0,,Eh? Para mı?
Dialogue: 5,0:03:25.35,0:03:27.80,Main-207+,,0,0,0,,Ah, bu mu?
Dialogue: 5,0:03:29.81,0:03:35.31,Main-207+,,0,0,0,,Hey... Hey!
Dialogue: 5,0:03:35.31,0:03:36.98,Main-207+,,0,0,0,,Buraya dön!
Dialogue: 5,0:03:36.98,0:03:40.17,Main-207+,,0,0,0,,Lanet olası! Onu yakalaya-
Dialogue: 5,0:03:42.49,0:03:43.66,Main-207+,,0,0,0,,Ben giderim.
Dialogue: 5,0:03:43.66,0:03:47.62,Main-207+,,0,0,0,,Ha? G-Güvercin?
Dialogue: 5,0:03:47.62,0:03:50.94,Main-207+,,0,0,0,,Ah, ah, ah! Hey, hey! Bırakın beni!
Dialogue: 5,0:03:50.94,0:03:53.08,Main-207+,,0,0,0,,Ne yapıyorsun lan?!
Dialogue: 5,0:03:53.08,0:03:57.04,Main-207+,,0,0,0,,Kaçmayacağım!\NBeni rahat bırak dedim!
Dialogue: 5,0:03:57.04,0:03:58.55,Main-207+,,0,0,0,,Kulağımı bırak!
Dialogue: 5,0:03:59.78,0:04:03.00,Main-207+,,0,0,0,,{\an8}Tam da turnayı gözünden vurmuştum!
Dialogue: 5,0:04:03.00,0:04:04.93,Main-207+,,0,0,0,,{\an8}Bunu unutmasan iyi olur, Lucci!
Dialogue: 5,0:04:04.93,0:04:09.30,Main-207+,,0,0,0,,Borcunu başkalarının parasıyla ödeme, aptal!
Dialogue: 5,0:04:09.30,0:04:11.18,Main-207+,,0,0,0,,Kimseye ait gibi görünmüyordu!
Dialogue: 5,0:04:11.18,0:04:14.10,Main-207+,,0,0,0,,Yine mi bu mazeret?
Dialogue: 5,0:04:14.10,0:04:17.79,Main-207+,,0,0,0,,Kiralık yagara'nın içindeydi!
Dialogue: 5,0:04:17.79,0:04:19.69,Main-207+,,0,0,0,,Döndüler.
Dialogue: 5,0:04:20.29,0:04:22.87,Main-207+,,0,0,0,,Aaah, hele şükür Usopp.
Dialogue: 5,0:04:22.87,0:04:27.71,Main-207+,,0,0,0,,Umursamıyormuş gibi konuşma!\NO bizim 200 milyonumuzdu!
Dialogue: 5,0:04:27.71,0:04:32.19,Main-207+,,0,0,0,,Evet! Niye ondan önce geri almadın?!
Dialogue: 5,0:04:32.19,0:04:34.87,Main-207+,,0,0,0,,Güvercin geri alacağını söyledi.
Dialogue: 5,0:04:34.87,0:04:37.60,Main-207+,,0,0,0,,Evet... özür dilerim.
Dialogue: 5,0:04:37.60,0:04:40.51,Main-207+,,0,0,0,,Lütfen şirketimizin kendi\Naptalıyla ilgilenmesine izin verin.
Dialogue: 5,0:04:40.51,0:04:43.90,Main-207+,,0,0,0,,Siz yakalamış olsaydınız,\Naşırı güç kullanabilirdiniz.
Dialogue: 5,0:04:43.90,0:04:48.51,Main-207+,,0,0,0,,Neyse, Franky Kardeşler'in parayı alıp kaçamadığına\Nminnettar olup, olayı kapanmış sayabilir miyiz?
Dialogue: 5,0:04:48.51,0:04:50.43,Main-207+,,0,0,0,,Hmm. Öyle ama...
Dialogue: 5,0:04:50.43,0:04:52.93,Main-207+,,0,0,0,,Evet, olur, olur.
Dialogue: 5,0:04:54.23,0:04:59.07,Main-207+,,0,0,0,,Peki, tuhaf kostümlü o adamlar da kimdi?
Dialogue: 5,0:04:59.07,0:05:02.40,Main-207+,,0,0,0,,Franky Kardeşler, bir gemi hurdalığı işletir.
Dialogue: 5,0:05:02.40,0:05:07.37,Main-207+,,0,0,0,,Hurdalık mı?\N Yasal işçilere pek benzemiyorlar.
Dialogue: 5,0:05:07.37,0:05:11.60,Main-207+,,0,0,0,,Evet, amatör olarak ödül avcılığıyla da uğraşırlar.
Dialogue: 5,0:05:11.60,0:05:16.00,Main-207+,,0,0,0,,Sık sık şehre gelen korsanlarla çatışırlar.
Dialogue: 5,0:05:16.00,0:05:17.83,Main-207+,,0,0,0,,Epey can sıkıcı oldular.
Dialogue: 5,0:05:17.83,0:05:23.38,Main-207+,,0,0,0,,Bu şehre gelen korsanları haklayarak\Ngemilerini alabiliyor ve onları parçalıyorlar.
Dialogue: 5,0:05:23.38,0:05:26.93,Main-207+,,0,0,0,,Sonra da kullanılabilir kereste olarak satıyorlar.
Dialogue: 5,0:05:26.93,0:05:29.89,Main-207+,,0,0,0,,Franky Kardeşler işlerini böyle yapar.
Dialogue: 5,0:05:29.89,0:05:34.06,Main-207+,,0,0,0,,Ne çürümüş bir dalavereci grubu! \NBütün korsan tayfasını hurdaya ayırıyor gibiler.
Dialogue: 5,0:05:34.06,0:05:37.02,Main-207+,,0,0,0,,Neyse... öldürdükleri zaman,\Nkemiklerini bile bırakmazlar.
Dialogue: 5,0:05:37.02,0:05:39.77,Main-207+,,0,0,0,,Ama pek güçlü görünmüyorlardı.
Dialogue: 5,0:05:40.35,0:05:42.11,Main-207+,,0,0,0,,Onlar sadece ayak takımı.
Dialogue: 5,0:05:42.84,0:05:48.53,Main-207+,,0,0,0,,Ama Liderleri Franky, o kadar hafife alınmamalı.
Dialogue: 5,0:05:51.45,0:05:54.01,Main-207+,,0,0,0,,Getirdim onu, Iceburg-san.
Dialogue: 5,0:05:54.01,0:05:56.00,Main-207+,,0,0,0,,Acıtıyor, lanet olası!
Dialogue: 5,0:05:56.00,0:05:57.71,Main-207+,,0,0,0,,Yardımın için sağol, Lucci.
Dialogue: 5,0:05:57.71,0:05:59.18,Main-207+,,0,0,0,,Lütfen bu sersemin...
Dialogue: 5,0:05:59.21,0:06:01.42,Main-207+,,0,0,0,,...utanmaz davranışı için özürlerimizi kabul edin.
Dialogue: 5,0:06:01.42,0:06:03.00,Main-207+,,0,0,0,,Ah! Hala konuşuyor!
Dialogue: 5,0:06:04.30,0:06:05.55,Main-207+,,0,0,0,,Ah!
Dialogue: 5,0:06:05.55,0:06:08.51,Main-207+,,0,0,0,,Özür dile, Paulie!
Dialogue: 5,0:06:09.90,0:06:12.50,Main-207+,,0,0,0,,Tüm konuşmayı güvercin yapıyor!
Dialogue: 5,0:06:12.50,0:06:14.72,Main-207+,,0,0,0,,Silindir şapkalı adamın sözcüsü gibi.
Dialogue: 5,0:06:14.72,0:06:17.69,Main-207+,,0,0,0,,Neyse, en azından paramızı geri aldık!
Dialogue: 5,0:06:17.69,0:06:20.48,Main-207+,,0,0,0,,Oh, demek sizin.
Dialogue: 5,0:06:20.48,0:06:22.24,Main-207+,,0,0,0,,Sizin için alıp getirdim.
Dialogue: 5,0:06:22.24,0:06:23.69,Main-207+,,0,0,0,,Evet, sağol.
Dialogue: 5,0:06:23.69,0:06:26.11,Main-207+,,0,0,0,,Teşekkür etmek istiyorsan, %10'unu bana ver.
Dialogue: 5,0:06:28.69,0:06:30.62,Main-207+,,0,0,0,,Özür dileriz efendim.
Dialogue: 5,0:06:32.10,0:06:35.18,Main-207+,,0,0,0,,Bu serseri, büyük bir kumar\Nborcundan ötürü mahvoldu.
Dialogue: 5,0:06:35.18,0:06:38.08,Main-207+,,0,0,0,,Para konusunda hiç saygısı yok.
Dialogue: 5,0:06:38.08,0:06:40.63,Main-207+,,0,0,0,,Nasıl konuşuyorsun?!
Dialogue: 5,0:06:40.63,0:06:43.92,Main-207+,,0,0,0,,Seni pislik! Şimdi kızdım işte, Lucci!
Dialogue: 5,0:06:43.92,0:06:45.55,Main-207+,,0,0,0,,Bunu affedemem!
Dialogue: 5,0:06:46.21,0:06:48.55,Main-207+,,0,0,0,,{\fad(150,150)}Rope Action{!}:
Dialogue: 5,0:06:46.21,0:06:48.55,Attack,,0,0,0,,{\fad(150,150)}Halat Hareketi
Dialogue: 5,0:06:51.30,0:06:54.10,Main-207+,,0,0,0,,{\fad(150,150)}Bowline Knot!
Dialogue: 5,0:06:51.30,0:06:54.10,Attack,,0,0,0,,{\fad(150,150)}İzbarço Bağı*
Dialogue: 5,0:06:57.43,0:06:59.39,Main-207+,,0,0,0,,{\fad(150,150)}Oshioki...
Dialogue: 5,0:06:57.43,0:06:59.39,Attack,,0,0,0,,{\fad(150,150)}Balığa...
Dialogue: 5,0:07:03.36,0:07:05.11,Main-207+,,0,0,0,,Durun! Bunu fazla ileri götürmüyor musunuz?!
Dialogue: 5,0:07:07.89,0:07:10.57,Main-207+,,0,0,0,,{\fad(150,150)}...Ippon Dzuri!
Dialogue: 5,0:07:07.89,0:07:10.57,Attack,,0,0,0,,{\fad(150,150)}...Çıkma Cezası
Dialogue: 5,0:07:13.50,0:07:16.01,Main-207+,,0,0,0,,O iyi mi?
Dialogue: 5,0:07:16.01,0:07:18.29,Main-207+,,0,0,0,,Evet... bu hep olur.
Dialogue: 5,0:07:20.80,0:07:23.67,Main-207+,,0,0,0,,Hey, bakın!
Dialogue: 5,0:07:23.67,0:07:27.76,Main-207+,,0,0,0,,Tüm momenti tek koluyla durdurmuş!
Dialogue: 5,0:07:30.20,0:07:33.28,Main-207+,,0,0,0,,Parmakları yere geçmiş!
Dialogue: 5,0:07:33.28,0:07:36.35,Main-207+,,0,0,0,,İnanılmaz derecede güçlü olmalılar!
Dialogue: 5,0:07:36.35,0:07:40.60,Main-207+,,0,0,0,,Buradaki gemi marangozlarının nesi var?
Dialogue: 5,0:07:42.29,0:07:44.15,Main-207+,,0,0,0,,Hey, gözlüklü!
Dialogue: 5,0:07:44.15,0:07:46.11,Main-207+,,0,0,0,,Ha?
Dialogue: 5,0:07:46.11,0:07:48.61,Main-207+,,0,0,0,,Dinle, bunu mantıklı olarak düşünmelisin.
Dialogue: 5,0:07:48.61,0:07:52.06,Main-207+,,0,0,0,,Seninle alay eden ve seni kışkırtan,...
Dialogue: 5,0:07:52.06,0:07:53.42,Main-207+,,0,0,0,,...güvercin!
Dialogue: 5,0:07:59.19,0:08:04.25,Main-207+,,0,0,0,,Umrumda değil! Bana vuran Lucci'ydi!
Dialogue: 5,0:08:04.25,0:08:08.63,Main-207+,,0,0,0,,Güvercin kendisi yapamadığı için ona yaptırttı!
Dialogue: 5,0:08:08.63,0:08:10.46,Main-207+,,0,0,0,,Hey, güvercin!
Dialogue: 5,0:08:11.38,0:08:14.59,Main-207+,,0,0,0,,Kendi dövüşünü kendin yap!
Dialogue: 5,0:08:14.59,0:08:16.18,Main-207+,,0,0,0,,Bir şey söyle!
Dialogue: 5,0:08:22.77,0:08:25.89,Main-207+,,0,0,0,,Oh, devam etmek ister misin?\NGel bakalım, lanet olası!
Dialogue: 5,0:08:25.89,0:08:27.90,Main-207+,,0,0,0,,Bu kadarı yeter, Paulie.
Dialogue: 5,0:08:27.90,0:08:31.82,Main-207+,,0,0,0,,Lütfen karışıklığın kusuruna bakmayın.
Dialogue: 5,0:08:31.82,0:08:35.18,Main-207+,,0,0,0,,Ben Rob- Ah, yani... Güvercin Hattori!
Dialogue: 5,0:08:35.18,0:08:40.24,Main-207+,,0,0,0,,Bu adam Rob Lucci. Burada çalışıyor.\NSizinle tanışmak bir zevkti.
Dialogue: 5,0:08:40.24,0:08:44.67,Main-207+,,0,0,0,,Ha? Kendisini insan olarak tanıtmak üzereydi.
Dialogue: 5,0:08:44.67,0:08:48.13,Main-207+,,0,0,0,,Neler olduğunu anladım!\NBu vantrilokluk*, değil mi?!
Dialogue: 5,0:08:48.13,0:08:51.31,Main-207+,,0,0,0,,Vaaa, cidden mi?! Demek biraz\Nönce de şikâyet eden sendin!
Dialogue: 5,0:08:51.31,0:08:54.49,Main-207+,,0,0,0,,Müthişsin! Farketmedim bile!
Dialogue: 5,0:08:54.49,0:08:57.60,Main-207+,,0,0,0,,Hayır, lütfen. O kadar etkileyici bir şey değil.
Dialogue: 5,0:08:59.00,0:09:02.54,Main-207+,,0,0,0,,Bu hilkat garibesinin ağzı hiç çalışmıyor gibi!
Dialogue: 5,0:09:04.81,0:09:08.02,Main-207+,,0,0,0,,Dur bakalım! \NO kadın kim olduğunu sanıyor?!
Dialogue: 5,0:09:08.02,0:09:09.48,Main-207+,,0,0,0,,N-Ne?!
Dialogue: 5,0:09:09.48,0:09:12.01,Main-207+,,0,0,0,,Utanmazın tekisin!
Dialogue: 5,0:09:12.01,0:09:13.38,Main-207+,,0,0,0,,Ha?
Dialogue: 5,0:09:13.38,0:09:18.20,Main-207+,,0,0,0,,Bacaklarını açığa vurmuşsun!
Dialogue: 5,0:09:18.20,0:09:20.92,Main-207+,,0,0,0,,Burası erkeklerin çalıştığı bir yer!
Dialogue: 5,0:09:20.95,0:09:22.50,Main-207+,,0,0,0,,Böyle giyinerek buraya\Ngelmeye nasıl cüret edersin?!
Dialogue: 5,0:09:22.70,0:09:25.55,Main-207+,,0,0,0,,Hadi ama Paulie. Sakin ol.
Dialogue: 5,0:09:30.75,0:09:33.00,Main-207+,,0,0,0,,Bu senin için de geçerli, Kalifa!
Dialogue: 5,0:09:33.00,0:09:36.41,Main-207+,,0,0,0,,Bu aşağılayıcı giysi içinde, inatla\Nkasılarak yürüme cüretini gösteriyorsun!
Dialogue: 5,0:09:36.41,0:09:39.80,Main-207+,,0,0,0,,Buralardayken uzun pantolon giymeni\Ndaha kaç defa söyleyeceğim?!
Dialogue: 5,0:09:39.80,0:09:42.21,Main-207+,,0,0,0,,– Neler oluyor?\N– Uzun pantolon mu?!
Dialogue: 5,0:09:42.21,0:09:44.10,Main-207+,,0,0,0,,O da ucubenin teki!
Dialogue: 5,0:09:44.81,0:09:48.81,Main-207+,,0,0,0,,Evet... bu kadarı yeter.\NKapıyı aç da içeri girelim.
Dialogue: 5,0:09:59.70,0:10:05.89,Main-207+,,0,0,0,,Çok büyük bir kapı! \NAma elle açmak zorunda mısın?!
Dialogue: 5,0:10:05.89,0:10:08.17,Main-207+,,0,0,0,,Bu iki ucube kendi başlarına açabilir mi?
Dialogue: 5,0:10:11.09,0:10:13.29,Main-207+,,0,0,0,,Vay! Açılıyor!
Dialogue: 5,0:10:13.29,0:10:16.28,Main-207+,,0,0,0,,Evet... görünüşlerine rağmen,\Ngemiler konusundaki bilgileri...
Dialogue: 5,0:10:16.28,0:10:20.43,Main-207+,,0,0,0,,...onları bu iskelede usta başı olmaya yetecek\Nkadar yetenekli beş işçi arasına sokmaya yetiyor.
Dialogue: 5,0:10:21.51,0:10:23.81,Main-207+,,0,0,0,,Kaku da onlardan biri.
Dialogue: 5,0:10:23.81,0:10:26.64,Main-207+,,0,0,0,,Bu, işçiler tarafından yapılmış bir dünya.
Dialogue: 5,0:10:27.25,0:10:29.50,Main-207+,,0,0,0,,Biraz tuhaf görünürlerse endişelenmeyin.
Dialogue: 5,0:10:29.50,0:10:30.75,Main-207+,,0,0,0,,Gerçekten tuhaflar!
Dialogue: 5,0:10:30.75,0:10:32.57,Main-207+,,0,0,0,,Ah, neredeyse açıldı.
Dialogue: 5,0:10:32.57,0:10:36.99,Main-207+,,0,0,0,,Paranızı etrafta bırakmamayı hatırlayın.\Nİçeride hırsız olmamalı ama yine de belli olmaz.
Dialogue: 5,0:10:37.90,0:10:42.10,Main-207+,,0,0,0,,Evet, demin olanlar kısmen de\Nbenim hatamdı ve elimden çıkıverdi.
Dialogue: 5,0:10:42.10,0:10:43.66,Main-207+,,0,0,0,,– Hey, Luffy! \N– Ne?
Dialogue: 5,0:10:43.66,0:10:46.48,Main-207+,,0,0,0,,Beni düzgünce korusan iyi olur!
Dialogue: 5,0:10:46.48,0:10:48.49,Main-207+,,0,0,0,,Tamam, bana güvenebilirsin!
Dialogue: 5,0:10:48.49,0:10:49.96,Main-207+,,0,0,0,,Hiç rahatlatıcı değil.
Dialogue: 5,0:10:49.29,0:10:49.96,Secondary-207+,,0,0,0,,Ben halledebilirim!
Dialogue: 5,0:10:49.96,0:10:54.58,Main-207+,,0,0,0,,1 no'lu iskele, Galley-La Şirketi'nin\Nana gücünün konuçlandığı yerdir.
Dialogue: 5,0:10:54.58,0:10:56.96,Main-207+,,0,0,0,,İşlerimizin en zoru burada yapılır.
Dialogue: 5,0:10:56.96,0:10:59.15,Main-207+,,0,0,0,,İçeri girelim.
Dialogue: 5,0:10:59.15,0:11:01.99,Main-207+,,0,0,0,,Vay!
Dialogue: 5,0:11:13.40,0:11:17.78,Main-207+,,0,0,0,,Vay canına! Kocaman!
Dialogue: 5,0:11:18.49,0:11:22.04,Main-207+,,0,0,0,,Tersaneyi yakından görmek daha etkileyici!
Dialogue: 5,0:11:22.04,0:11:23.41,Main-207+,,0,0,0,,– Evet!\N– Kesinlikle!
Dialogue: 5,0:11:24.10,0:11:28.70,Main-207+,,0,0,0,,Oooh, dev bir kalyon yapıyorlar!\NOnlar da kim?
Dialogue: 5,0:11:28.70,0:11:30.25,Main-207+,,0,0,0,,Her yerde işçi var.
Dialogue: 5,0:11:30.25,0:11:32.77,Main-207+,,0,0,0,,Lütfen beni izleyin.
Dialogue: 5,0:11:35.74,0:11:37.80,Main-207+,,0,0,0,,Oh, bu Iceburg-san!
Dialogue: 5,0:11:37.80,0:11:40.67,Main-207+,,0,0,0,,Hey, başkan geldi!
Dialogue: 5,0:11:40.67,0:11:43.32,Main-207+,,0,0,0,,Iceburg-san, günaydın!\NGelebilmenize sevindik!
Dialogue: 5,0:11:43.32,0:11:44.68,Main-207+,,0,0,0,,Günaydın!\Nİyi günler!
Dialogue: 5,0:11:44.68,0:11:48.20,Main-207+,,0,0,0,,Başkan, bu parça konusunda yardımcı olabilir misiniz?
Dialogue: 5,0:11:48.20,0:11:49.64,Main-207+,,0,0,0,,Tabii, sonra uğrarım.
Dialogue: 5,0:11:49.64,0:11:52.68,Main-207+,,0,0,0,,Çalışmalarınızdan ötürü teşekkürler, Iceburg-san!
Dialogue: 5,0:11:52.68,0:11:55.14,Main-207+,,0,0,0,,Evet... size de teşekkürler. \NHer şey yolunda mı?
Dialogue: 5,0:11:55.14,0:11:57.36,Main-207+,,0,0,0,,Evet efendim! Keresteler bile harika!
Dialogue: 5,0:11:57.36,0:12:01.46,Main-207+,,0,0,0,,Bu da ne? Buz amca çok popüler!
Dialogue: 5,0:12:01.46,0:12:04.66,Main-207+,,0,0,0,,Elbete. Bu şehirde, yetenek her şeydir.
Dialogue: 5,0:12:05.23,0:12:09.70,Main-207+,,0,0,0,,Yıllar önce ada, yedi farklı\Nşirketin birbiriyle yarıştığı...
Dialogue: 5,0:12:09.70,0:12:12.59,Main-207+,,0,0,0,,...gemi yapım endüstrisinin merkeziydi.
Dialogue: 5,0:12:13.22,0:12:17.54,Main-207+,,0,0,0,,Bu şirketlerdeki işçiler, onun\Nusta yeteneğinden etkilendiler...
Dialogue: 5,0:12:17.54,0:12:22.51,Main-207+,,0,0,0,,...ve beş yıl önce o şirketleri, kendi\Nkurmuş olduğu şirketin çatısı altında,...
Dialogue: 5,0:12:22.51,0:12:24.72,Main-207+,,0,0,0,,...Galley-La Şirketi'nde birleştirdi.
Dialogue: 5,0:12:25.40,0:12:28.60,Main-207+,,0,0,0,,Gemi yapımı konusundaki tutkusu ve\Nyeteneği her zamanki kadar güçlü...
Dialogue: 5,0:12:28.60,0:12:31.85,Main-207+,,0,0,0,,...ve işçiler ona olan saygılarını hiç yitirmediler.
Dialogue: 5,0:12:31.85,0:12:38.44,Main-207+,,0,0,0,,Korsanlara veya otoriteye karşı asla\Nboyun eğmemelerinin nedeni, onurlarıdır.
Dialogue: 5,0:12:39.40,0:12:42.00,Main-207+,,0,0,0,,Bu şirket böyle yürür.
Dialogue: 5,0:12:42.86,0:12:46.30,Main-207+,,0,0,0,,Hey, amca! Gerçekten iyi bir gemi marangozu olduğunu söylüyorlar!
Dialogue: 5,0:12:46.30,0:12:48.12,Main-207+,,0,0,0,,Korsan tayfama katılmak ister misin?
Dialogue: 5,0:12:48.12,0:12:50.44,Main-207+,,0,0,0,,Ne diyorsun sen lan?!
Dialogue: 5,0:12:50.44,0:12:51.60,Main-207+,,0,0,0,,Seni kaba adam!
Dialogue: 5,0:12:51.60,0:12:53.93,Main-207+,,0,0,0,,Lütfen anlayın, o böyle biri!
Dialogue: 5,0:12:53.93,0:12:55.00,Main-207+,,0,0,0,,Afedersiniz!
Dialogue: 5,0:12:55.00,0:12:59.09,Main-207+,,0,0,0,,Evet... yani geminizde tek bir gemi marangozunun\Nbile olmadığını mı söylemeye çalışıyorsunuz?
Dialogue: 5,0:12:59.09,0:12:59.90,Main-207+,,0,0,0,,Doğru.
Dialogue: 5,0:12:59.90,0:13:04.68,Main-207+,,0,0,0,,Bu adaya gemimizi tamir ettirmek\Nve yeni bir arkadaş bulmak için geldik!
Dialogue: 5,0:13:04.68,0:13:10.47,Main-207+,,0,0,0,,Gemi marangozumuz çok ama bir korsan gemisinde\Nyolculuk etmek isteyeceklerinden emin değilim.
Dialogue: 5,0:13:10.47,0:13:14.23,Main-207+,,0,0,0,,Gitmek istediğini söyleyen olursa, \Ngötürmekte özgürsünüz.
Dialogue: 5,0:13:14.23,0:13:19.19,Main-207+,,0,0,0,,Cidden mi?! Yaaa, nasıl konuşulacağını biliyorsun! Amca, sen gelemez misin?
Dialogue: 5,0:13:19.19,0:13:22.06,Main-207+,,0,0,0,,Evet... elbette gelemem. Ben başkanım.
Dialogue: 5,0:13:22.06,0:13:23.99,Main-207+,,0,0,0,,Ne olmuş?
Dialogue: 5,0:13:25.67,0:13:30.49,Main-207+,,0,0,0,,Bu arada, tayfanda Nico Robin\Nadında bir kadın olduğu doğru mu?
Dialogue: 5,0:13:30.49,0:13:34.29,Main-207+,,0,0,0,,Evet, doğru. Epey de akıllıdır!
Dialogue: 5,0:13:36.79,0:13:39.34,Main-207+,,0,0,0,,Ne oldu?\NRobin'le ilgili bir şey mi var?
Dialogue: 5,0:13:40.26,0:13:40.96,Main-207+,,0,0,0,,Hayır.
Dialogue: 5,0:13:44.72,0:13:48.05,Main-207+,,0,0,0,,Kahretsin, bu harika bir şey!
Dialogue: 5,0:13:48.05,0:13:51.72,Main-207+,,0,0,0,,Evet, bu kadar! Yavaşça bu tarafa getirin!
Dialogue: 5,0:13:52.35,0:13:56.19,Main-207+,,0,0,0,,O kadar büyük bir topumuz olsaydı, Merry...
Dialogue: 5,0:13:56.19,0:13:58.44,Main-207+,,0,0,0,,Oooh, yarı ortaçağ topu!
Dialogue: 5,0:13:58.44,0:14:04.40,Main-207+,,0,0,0,,Çok güzel!\NÇok uzun ve parlak!
Dialogue: 5,0:14:04.40,0:14:07.36,Main-207+,,0,0,0,,O bebeği bir kez olsun ateşlemek isterdim!
Dialogue: 5,0:14:07.36,0:14:08.57,Main-207+,,0,0,0,,İşte fırsat!
Dialogue: 5,0:14:09.61,0:14:13.60,Main-207+,,0,0,0,,Bronzdan mı yapılmış?\NEpey pahalı olmalı!
Dialogue: 5,0:14:13.60,0:14:16.08,Main-207+,,0,0,0,,Belki de test atışı yapmama izin verirler!
Dialogue: 5,0:14:16.08,0:14:20.45,Main-207+,,0,0,0,,Ama dur biraz! \N300 milyon belimiz var!
Dialogue: 5,0:14:20.45,0:14:23.59,Main-207+,,0,0,0,,Hiç düşünmeden onlardan bir tane alabiliriz!
Dialogue: 5,0:14:32.78,0:14:35.18,Main-207+,,0,0,0,,Demin orada biri yok muydu?
Dialogue: 5,0:14:46.78,0:14:47.82,Main-207+,,0,0,0,,Oh, Kaku.
Dialogue: 5,0:14:49.20,0:14:51.39,Main-207+,,0,0,0,,– Nerelerdeydin?\N– Değerlendirme yapıyordum.
Dialogue: 5,0:14:51.39,0:14:54.49,Main-207+,,0,0,0,,Ah, bu sensin!\NGemimize baktın mı?
Dialogue: 5,0:14:54.49,0:14:56.50,Main-207+,,0,0,0,,Evet, demin oradaydım.
Dialogue: 5,0:14:56.50,0:14:59.08,Main-207+,,0,0,0,,Iceburg-san, sen de buradasın.
Dialogue: 5,0:14:59.08,0:15:02.25,Main-207+,,0,0,0,,Durumun farkındayım. Ne düşünüyorsun?
Dialogue: 5,0:15:02.25,0:15:04.71,Main-207+,,0,0,0,,Şey...
Dialogue: 5,0:15:05.42,0:15:08.84,Main-207+,,0,0,0,,Luffy, aşağı gel!
Dialogue: 5,0:15:24.19,0:15:26.28,Flashbacks-720p,,0,0,0,,Ne? Ciddi misin?
Dialogue: 5,0:15:26.28,0:15:28.90,Flashbacks-720p,,0,0,0,,Yalan söylüyorsan, bunu sana ödetirim!
Dialogue: 5,0:15:30.00,0:15:33.57,Flashbacks-720p,,0,0,0,,Ben profesyonelim. Yalan söylemem.
Dialogue: 5,0:15:47.21,0:15:50.05,Main-207+,,0,0,0,,Usopp nerede?
Dialogue: 5,0:15:50.61,0:15:54.54,Main-207+,,0,0,0,,Bir dakika önce oradaki malzemeye göz gezdiriyordu.
Dialogue: 5,0:15:56.51,0:16:01.08,Main-207+,,0,0,0,,Hey, çocuklar!\NBu çantalar sizin, değil mi?
Dialogue: 5,0:16:03.10,0:16:06.30,Main-207+,,0,0,0,,Bunlar Usopp'taki çantalar.
Dialogue: 5,0:16:06.30,0:16:07.32,Main-207+,,0,0,0,,Evet bizim.
Dialogue: 5,0:16:07.32,0:16:09.29,Main-207+,,0,0,0,,Sağol!
Dialogue: 5,0:16:09.29,0:16:14.74,Main-207+,,0,0,0,,Üfff, Usopp nereye gitti?\NParamızı ortalık yerde bırakmış!
Dialogue: 5,0:16:14.74,0:16:15.20,Main-207+,,0,0,0,,Para mı?
Dialogue: 5,0:16:15.20,0:16:18.72,Main-207+,,0,0,0,,Evet, bu çantalarda 200 milyon beli var!
Dialogue: 5,0:16:19.62,0:16:21.66,Main-207+,,0,0,0,,200 milyon beli mi?
Dialogue: 5,0:16:21.66,0:16:23.58,Main-207+,,0,0,0,,İyi şakaydı! Görüşürüz!
Dialogue: 5,0:16:23.58,0:16:26.00,Main-207+,,0,0,0,,Şakacı çocuk.
Dialogue: 5,0:16:26.70,0:16:29.00,Main-207+,,0,0,0,,Peki, ne kadara patlayacak dersin?
Dialogue: 5,0:16:29.55,0:16:33.09,Main-207+,,0,0,0,,Fiyatınızı belirleyebilirsiniz! \NSonuçta zenginiz!
Dialogue: 5,0:16:35.47,0:16:41.93,Main-207+,,0,0,0,,Mümkünse onu daha güçlü, daha hızlı yapmak\Nistiyorum ve daha fazla top ekleyeceğim!
Dialogue: 5,0:16:41.93,0:16:45.89,Main-207+,,0,0,0,,Tekne kısmına dekorasyon da ekleyebilir misiniz?
Dialogue: 5,0:16:45.89,0:16:48.27,Main-207+,,0,0,0,,Odaların biçimini değiştirebilir misiniz?
Dialogue: 5,0:16:48.27,0:16:49.95,Main-207+,,0,0,0,,Dur bakalım.
Dialogue: 5,0:16:50.82,0:16:55.28,Main-207+,,0,0,0,,Epey görkemli bir yolculuk yapmışsınız, değil mi?
Dialogue: 5,0:16:56.80,0:16:59.60,Main-207+,,0,0,0,,Evet! Gökyüzüne uçtu ve düştü,...
Dialogue: 5,0:16:59.60,0:17:01.90,Main-207+,,0,0,0,,...dağa tırmandı ve kazıklara çakıldı!
Dialogue: 5,0:17:01.90,0:17:03.80,Main-207+,,0,0,0,,Bir sürü şey atlattık!
Dialogue: 5,0:17:03.80,0:17:06.46,Main-207+,,0,0,0,,Bu yüzden onu tamir etmek istiyoruz!
Dialogue: 5,0:17:07.39,0:17:09.63,Main-207+,,0,0,0,,Hasar çok büyük.
Dialogue: 5,0:17:10.81,0:17:13.47,Main-207+,,0,0,0,,Tamir etmenin uzun zaman\Nalacağını mı söylemeye çalışıyorsunuz?
Dialogue: 5,0:17:14.26,0:17:15.28,Main-207+,,0,0,0,,Hayır.
Dialogue: 5,0:17:16.05,0:17:19.54,Main-207+,,0,0,0,,Sizinle açık konuşacağım. Geminiz...
Dialogue: 5,0:17:20.90,0:17:23.89,Main-207+,,0,0,0,,...bizim yeteneklerimizle bile tamir edilemez.
Dialogue: 5,0:17:38.79,0:17:40.78,Main-207+,,0,0,0,,Karinası mı hasar görmüş?
Dialogue: 5,0:17:40.78,0:17:44.66,Main-207+,,0,0,0,,Evet. Tamir edilemeyecek kadar çok.
Dialogue: 5,0:17:44.66,0:17:46.69,Main-207+,,0,0,0,,Olamaz.
Dialogue: 5,0:17:46.69,0:17:49.92,Main-207+,,0,0,0,,Ama bugüne kadar \Nsorun olmadan yolculuk ediyorduk!
Dialogue: 5,0:17:49.92,0:17:58.34,Main-207+,,0,0,0,,Tamir etmeye çalışsak bile \Nyamaların bir sonraki adaya kadar dayanma olasılığı...
Dialogue: 5,0:18:01.40,0:18:02.65,Main-207+,,0,0,0,,...sıfır.
Dialogue: 5,0:18:14.21,0:18:18.03,Main-207+,,0,0,0,,Merry, bu doğru mu?
Dialogue: 5,0:18:18.78,0:18:20.28,Main-207+,,0,0,0,,Buraya kadar mı?
Dialogue: 5,0:18:24.10,0:18:25.66,Main-207+,,0,0,0,,Kahretsin.
Dialogue: 5,0:18:26.99,0:18:31.75,Main-207+,,0,0,0,,Üzgünüm, Sanji. \NOkuduğum kitaba dalıp gitmişim.
Dialogue: 5,0:18:31.75,0:18:34.50,Main-207+,,0,0,0,,Özür dilemeni gerektiren bir durum değil.
Dialogue: 5,0:18:34.50,0:18:39.64,Main-207+,,0,0,0,,Yanındaki adamın sen olduğunu sanmıştım.
Dialogue: 5,0:18:40.49,0:18:44.18,Main-207+,,0,0,0,,Maskeli adam kimdi?
Dialogue: 5,0:18:44.18,0:18:46.80,Main-207+,,0,0,0,,Sırra kadem basmaları çok tuhaf.
Dialogue: 5,0:18:46.80,0:18:51.10,Main-207+,,0,0,0,,Evet. Robin'in kokusu da orada yok oldu.
Dialogue: 5,0:18:52.19,0:18:55.82,Main-207+,,0,0,0,,Umarım ona bir şey olmaz ama bu kötü\Nhissi üzerimden bir türlü atamıyorum.
Dialogue: 5,0:18:55.82,0:18:56.90,Main-207+,,0,0,0,,He?
Dialogue: 5,0:18:56.90,0:18:58.80,Main-207+,,0,0,0,,Seni bir kontrol edeyim mi?
Dialogue: 5,0:18:58.80,0:19:00.36,Main-207+,,0,0,0,,Hasta değilim!
Dialogue: 5,0:19:01.05,0:19:04.41,Main-207+,,0,0,0,,Aokiji'nin söylediği bir şey.\NBunu düşünmeden edemiyorum.
Dialogue: 5,0:19:05.20,0:19:07.00,Main-207+,,0,0,0,,Bir şey mi söyledi?
Dialogue: 5,0:19:07.00,0:19:10.20,Main-207+,,0,0,0,,Robin-chan'ın geçmişiyle ilgili ipuçları verip durdu.
Dialogue: 5,0:19:10.20,0:19:13.54,Main-207+,,0,0,0,,Onunla birlikte olduğumuza\Npişman olacağımızı da söyledi.
Dialogue: 5,0:19:13.54,0:19:15.49,Main-207+,,0,0,0,,Ah, evet.
Dialogue: 5,0:19:15.49,0:19:18.76,Main-207+,,0,0,0,,Ama bu kayboluşuyla bağlantılı mı?
Dialogue: 5,0:19:19.33,0:19:21.00,Main-207+,,0,0,0,,Bilmiyorum.
Dialogue: 5,0:19:21.00,0:19:25.01,Main-207+,,0,0,0,,Neyse, burada zaman kaybediyoruz.\NŞimdilik Merry'ye dönelim.
Dialogue: 5,0:19:26.11,0:19:28.79,Main-207+,,0,0,0,,Bir terslik olmazsa oraya gelecektir.
Dialogue: 5,0:19:28.79,0:19:30.31,Main-207+,,0,0,0,,Evet, haklısın.
Dialogue: 5,0:19:49.04,0:19:52.21,Main-207+,,0,0,0,,Merry'yi tamir edemez misiniz?! Niye olmasın?!
Dialogue: 5,0:19:52.21,0:19:55.34,Main-207+,,0,0,0,,Siz en iyi gemi marangozlarısınız, değil mi?
Dialogue: 5,0:19:57.38,0:20:00.29,Main-207+,,0,0,0,,İstediğiniz paraysa, bakın!\Nİstediğiniz kadar ödeyebiliriz!
Dialogue: 5,0:20:00.29,0:20:02.59,Main-207+,,0,0,0,,Parayla alakası yok.
Dialogue: 5,0:20:02.59,0:20:07.10,Main-207+,,0,0,0,,Ne kadar paranız olursa olsun,\No gemi asla eskisi gibi olmayacak.
Dialogue: 5,0:20:08.31,0:20:15.27,Main-207+,,0,0,0,,Dahası, geminizin o haliyle buraya kadar\Nnasıl geldiği de ayrı bir merak konusu.
Dialogue: 5,0:20:15.27,0:20:18.69,Main-207+,,0,0,0,,Ne demek istiyorsun? Merry'nin nesi var?
Dialogue: 5,0:20:18.69,0:20:21.82,Main-207+,,0,0,0,,Karinanın ne olduğunu biliyor musun, \Nutanmaz kız?
Dialogue: 5,0:20:21.82,0:20:23.49,Main-207+,,0,0,0,,Geminin altındaki şey mi?
Dialogue: 5,0:20:23.49,0:20:27.79,Main-207+,,0,0,0,,Evet. Geminin bir ucundan diğerine kadar uzanan destektir.
Dialogue: 5,0:20:27.79,0:20:31.04,Main-207+,,0,0,0,,Gemideki en önemli kalas parçasıdır.
Dialogue: 5,0:20:31.04,0:20:35.00,Main-207+,,0,0,0,,Gemi yapımı karinayı düzgün\Nbir şekilde hizalamakla başlar.
Dialogue: 5,0:20:35.00,0:20:40.80,Main-207+,,0,0,0,,Sonra kıç tarafı, kıç desteği, iskelet kısmı, kaburgalar, destekler ve güverte kopçaları eklenir.
Dialogue: 5,0:20:40.80,0:20:45.30,Main-207+,,0,0,0,,Karina olmadan hiçbir kalas parçası yerinde durmaz.
Dialogue: 5,0:20:45.30,0:20:47.49,Main-207+,,0,0,0,,Bir gemi böyle yapılır.
Dialogue: 5,0:20:47.49,0:20:51.15,Main-207+,,0,0,0,,Karina, tüm gemi kasasının temeli, onun hayatıdır.
Dialogue: 5,0:20:51.15,0:20:56.81,Main-207+,,0,0,0,,Kötü bir şekilde hasar gördüğü\Nzaman bile değiştirilemez.
Dialogue: 5,0:20:56.81,0:21:01.03,Main-207+,,0,0,0,,Gemiyi sıfırdan yapmak gibi olur.
Dialogue: 5,0:21:01.03,0:21:04.09,Main-207+,,0,0,0,,Bu yüzden size, kimse tamir edemez diyoruz.
Dialogue: 5,0:21:04.09,0:21:08.03,Main-207+,,0,0,0,,Geminiz, sadece parçalanmaya\Nmahkum bir ağaç yığını.
Dialogue: 5,0:21:08.03,0:21:10.45,Main-207+,,0,0,0,,Hey! Öyle söylemen gerekmiyor!
Dialogue: 5,0:21:11.87,0:21:14.00,Main-207+,,0,0,0,,Niye umrumda olsun ki? Bu doğru.
Dialogue: 5,0:21:16.35,0:21:20.30,Main-207+,,0,0,0,,Tamam o zaman! Gemiyi yeniden yapın!
Dialogue: 5,0:21:20.30,0:21:22.89,Main-207+,,0,0,0,,Going Merry'yi tekrar yapın!
Dialogue: 5,0:21:22.89,0:21:25.19,Main-207+,,0,0,0,,Bunu da yapamayız!
Dialogue: 5,0:21:25.19,0:21:26.22,Main-207+,,0,0,0,,Niye?
Dialogue: 5,0:21:26.22,0:21:28.80,Main-207+,,0,0,0,,Aynı görünen bir gemi yapabiliriz...
Dialogue: 5,0:21:28.80,0:21:32.29,Main-207+,,0,0,0,,...ama kimse geminin aynısını yapamaz.
Dialogue: 5,0:21:32.29,0:21:36.23,Main-207+,,0,0,0,,İki gemi asla birbirine benzeyemez.
Dialogue: 5,0:21:36.23,0:21:37.40,Main-207+,,0,0,0,,Ne demek istiyorsun?
Dialogue: 5,0:21:37.40,0:21:41.36,Main-207+,,0,0,0,,Sence hiç aynı şekilde büyüyen \Niki ağaç var mıdır?
Dialogue: 5,0:21:42.69,0:21:45.49,Main-207+,,0,0,0,,Yolculuk gemileri neredeyse\Ntamamen ağaçtan yapılır.
Dialogue: 5,0:21:45.49,0:21:49.24,Main-207+,,0,0,0,,Geminin büyüklüğü, kavisi ve her detayı\Nkullanmış olduğumuz ağaca bağlı olarak değişecek!
Dialogue: 5,0:21:50.04,0:21:55.29,Main-207+,,0,0,0,,Aynı planları kullansak bile, \Nasla geminin tıpa tıp aynısını yapamayız!
Dialogue: 5,0:21:55.29,0:21:58.50,Main-207+,,0,0,0,,Aynı görünen bir gemi yaptık diyelim.
Dialogue: 5,0:21:58.50,0:22:03.39,Main-207+,,0,0,0,,Onun tamamen farklı bir gemi\Nolduğunu en fazla hissedecek kişiler...
Dialogue: 5,0:22:03.39,0:22:05.92,Main-207+,,0,0,0,,...SİZ OLURDUNUZ!
Dialogue: 5,0:22:06.59,0:22:08.47,Main-207+,,0,0,0,,Olamaz...
Dialogue: 5,0:22:08.47,0:22:13.18,Main-207+,,0,0,0,,Going Merry bir daha yola\Nçıkamaz mı demek istiyorsunuz?
Dialogue: 5,0:22:13.18,0:22:15.21,Main-207+,,0,0,0,,Uzun lafın kısası öyle.
Dialogue: 5,0:22:15.21,0:22:17.39,Main-207+,,0,0,0,,Ya batmasını beklersiniz...
Dialogue: 5,0:22:18.07,0:22:20.85,Main-207+,,0,0,0,,...ya da kendiniz parçalayabilirsiniz.
Dialogue: 5,0:22:23.20,0:22:24.27,Flashbacks-720p,,0,0,0,,Bir karavel!
Dialogue: 5,0:22:24.27,0:22:27.36,Flashbacks-720p,,0,0,0,,Oooh, güzel bir gemi!
Dialogue: 5,0:22:28.70,0:22:34.17,Flashbacks-720p,,0,0,0,,Tamam, bitti! Korsan gemimiz\NGoing Merry, artık tamamlandı!
Dialogue: 5,0:22:37.40,0:22:40.29,Main-207+,,0,0,0,,Evet... bu bir geminin yaşam halkası.
Dialogue: 5,0:22:40.29,0:22:42.18,Main-207+,,0,0,0,,İyi bir fırsatınız var.
Dialogue: 5,0:22:42.18,0:22:44.49,Main-207+,,0,0,0,,Ondan vazgeçip yenisini alın.
Dialogue: 5,0:22:44.49,0:22:48.80,Main-207+,,0,0,0,,Paranız var, değil mi?\NSanırım geminiz bir karavel.
Dialogue: 5,0:22:49.37,0:22:54.34,Main-207+,,0,0,0,,Öyle eski bir modelle, ilerideki denizlerde\Nyolculuk etmekte sıkıntı çekerdiniz.
Dialogue: 5,0:22:54.34,0:22:56.80,Main-207+,,0,0,0,,Hayır, yenisini istemiyorum.
Dialogue: 5,0:22:56.80,0:22:58.30,Main-207+,,0,0,0,,Luffy.
Dialogue: 5,0:22:58.30,0:23:00.27,Main-207+,,0,0,0,,Bizim...
Dialogue: 5,0:23:00.27,0:23:03.24,Main-207+,,0,0,0,,Bizim gemimiz, Going Merry!
Dialogue: 5,0:23:03.24,0:23:05.69,Main-207+,,0,0,0,,Tamir edersek yola çıkabilir!
Dialogue: 5,0:23:05.69,0:23:09.32,Main-207+,,0,0,0,,İyi olacak! Bugün hiç sıkıntı\Nçekmeden buraya geldik!
Dialogue: 5,0:23:09.32,0:23:14.39,Main-207+,,0,0,0,,Aniden bir daha yolculuk yapamayacağına\Ninanmamı mı bekliyorsunuz?
Dialogue: 5,0:23:14.39,0:23:17.34,Main-207+,,0,0,0,,Gemimizin ne kadar dayanıklı\Nolduğu konusunda hiçbir fikriniz yok!
Dialogue: 5,0:23:17.36,0:23:19.60,Main-207+,,0,0,0,,Böyle demenizin tek nedeni bu!
Dialogue: 5,0:23:21.28,0:23:23.50,Main-207+,,0,0,0,,Yani batana dek tatmin olmayacak mısın?
Dialogue: 5,0:23:23.50,0:23:25.84,Main-207+,,0,0,0,,Beklediğim bu değildi.
Dialogue: 5,0:23:26.50,0:23:30.01,Main-207+,,0,0,0,,Bir gemi kaptanı böyle mi davranır?
Dialogue: 5,0:23:32.48,0:23:34.38,Main-207+,,0,0,0,,Konuşma burada bitmiştir.
Dialogue: 5,0:23:34.38,0:23:38.02,Main-207+,,0,0,0,,Tekrar düşünün. \NBaşka bir gemi istiyorsanız tekrar gelebilirsiniz.
Dialogue: 5,0:23:38.02,0:23:39.50,Main-207+,,0,0,0,,O zaman konuşacağız.
Dialogue: 5,0:23:39.50,0:23:43.28,Main-207+,,0,0,0,,300 milyon beliyle size en son\Nmodellerden birini yapabiliriz.
Dialogue: 5,0:23:43.28,0:23:45.07,Main-207+,,0,0,0,,Kalifa!
Dialogue: 5,0:23:45.07,0:23:47.80,Main-207+,,0,0,0,,Buyrun, lütfen tekrar düşünün!
Dialogue: 5,0:23:47.80,0:23:50.00,Main-207+,,0,0,0,,Bu yeni ve kullanılmış gemilerin bir listesi.
Dialogue: 5,0:23:50.00,0:23:51.24,Main-207+,,0,0,0,,Fiyatları karşılaştırabilirsiniz.
Dialogue: 5,0:23:51.84,0:23:53.31,Main-207+,,0,0,0,,Iceburg-{\i1}san{\fs10} {\r}!
Dialogue: 5,0:23:54.32,0:23:57.08,Main-207+,,0,0,0,,Kapıda bir ziyaretçiniz var.
Dialogue: 5,0:23:57.08,0:24:00.40,Main-207+,,0,0,0,,{\pos(683,702)}Görünüşe göre yine o Dünya\NHükümeti'nden gelen memur.
Dialogue: 5,0:24:00.40,0:24:01.79,Main-207+,,0,0,0,,Göndereyim mi?
Dialogue: 5,0:24:02.26,0:24:05.49,Main-207+,,0,0,0,,Şey... evet.\NBurada olmadığımı söyle.
Dialogue: 5,0:24:05.49,0:24:09.30,Main-207+,,0,0,0,,Ama üfff...\NSaçın yine dikelmiş, Lulu.
Dialogue: 5,0:24:09.30,0:24:11.51,Main-207+,,0,0,0,,Ah, olamaz. Afedersiniz.
Dialogue: 5,0:24:12.13,0:24:14.00,Main-207+,,0,0,0,,Ben gidiyorum o zaman.
Dialogue: 5,0:24:14.00,0:24:15.61,Main-207+,,0,0,0,,L-Lütfen git!
Dialogue: 5,0:24:15.61,0:24:18.43,Main-207+,,0,0,0,,Dur bakalım, Iceburg-kun.
Dialogue: 5,0:24:20.90,0:24:22.85,Main-207+,,0,0,0,,İşte buradasınız.
Dialogue: 5,0:24:22.85,0:24:26.00,Main-207+,,0,0,0,,Hey, saklanmanız gerek! \NBu adamlar Hükümet'ten!
Dialogue: 5,0:24:26.00,0:24:26.94,Main-207+,,0,0,0,,Ah, tamam!
Dialogue: 5,0:24:32.83,0:24:36.80,Main-207+,,0,0,0,,Evet... Bu ne şeref, Corgi.\NBugün burada değilim.
Dialogue: 5,0:24:36.80,0:24:38.28,Main-207+,,0,0,0,,Hayır, sen olduğunu görüyorum.
Dialogue: 5,0:24:38.28,0:24:41.85,Main-207+,,0,0,0,,{\an8}Cidden, deniz treniyle onca yoldan geldim.
Dialogue: 5,0:24:41.85,0:24:43.99,Main-207+,,0,0,0,,{\an8}Daha samimi olsaydın minnettar olurdum.
Dialogue: 5,0:24:51.80,0:24:55.39,Main-207+,,0,0,0,,Sanırım yakınlardan korsan kokusu alıyorum.
Dialogue: 5,0:24:55.39,0:24:58.43,Main-207+,,0,0,0,,Ama boşver. \NSeninle konuşmak için buradayım.
Dialogue: 5,0:24:58.43,0:25:01.10,Main-207+,,0,0,0,,Senden nefret ediyorum! Defol!
Dialogue: 5,0:25:01.10,0:25:02.27,Main-207+,,0,0,0,,Çocuk gibisin.
Dialogue: 5,0:25:02.27,0:25:04.27,Main-207+,,0,0,0,,Ben yetişkinim, sağol.
Dialogue: 5,0:25:06.90,0:25:13.99,Main-207+,,0,0,0,,Bu kadar inatçı olmak yerine \Nönerimizi dinleseydin, memnun olurdum.
Dialogue: 5,0:25:15.53,0:25:18.45,Main-207+,,0,0,0,,Daha özel bir yere gidelim mi?
Dialogue: 5,0:25:20.29,0:25:23.89,Main-207+,,0,0,0,,Hiç vazgeçmezler mi?
Dialogue: 5,0:25:23.89,0:25:26.19,Main-207+,,0,0,0,,Iceburg-san'dan ne istiyorlar?
Dialogue: 5,0:25:26.19,0:25:30.26,Main-207+,,0,0,0,,Bizimle alakası yok. \NOrada dönen şey politika.
Dialogue: 5,0:25:30.26,0:25:31.90,Main-207+,,0,0,0,,Gidip canına okuyayım mı?
Dialogue: 5,0:25:31.90,0:25:34.97,Main-207+,,0,0,0,,Düşünme bile. \NO Dünya Hükümeti'nden.
Dialogue: 5,0:25:39.01,0:25:41.60,Main-207+,,0,0,0,,Ne? Sorun nedir?
Dialogue: 5,0:25:42.60,0:25:46.60,Main-207+,,0,0,0,,Saklanmak için çantaları elime\Naldığımda bir şey farkettim.
Dialogue: 5,0:25:48.40,0:25:50.10,Main-207+,,0,0,0,,Çok hafifler.
Dialogue: 5,0:25:50.10,0:25:52.32,Main-207+,,0,0,0,,Eh? Nasıl?
Dialogue: 5,0:25:52.85,0:25:58.03,Main-207+,,0,0,0,,Ah, böyle şaka yapma.\Nİçlerinde o kadar para varken hafif olamazlar.
Dialogue: 5,0:26:03.66,0:26:05.87,Main-207+,,0,0,0,,Bu bağıran da kim?
Dialogue: 5,0:26:08.00,0:26:10.29,Main-207+,,0,0,0,,Aptallar! Ne diye bağırıyorsunuz?!
Dialogue: 5,0:26:11.05,0:26:14.71,Main-207+,,0,0,0,,Hey, kadın! \NÖyle oturmaya nasıl cüret edersin!
Dialogue: 5,0:26:15.28,0:26:18.55,Main-207+,,0,0,0,,Hayır. Olamaz...
Dialogue: 5,0:26:20.20,0:26:22.85,Main-207+,,0,0,0,,Bu mümkün değil...
Dialogue: 5,0:26:24.85,0:26:26.85,Main-207+,,0,0,0,,200 milyon belimiz!
Dialogue: 5,0:26:26.85,0:26:28.81,Main-207+,,0,0,0,,Gitmiş! Gerçekten gitmiş!
Dialogue: 5,0:26:28.81,0:26:32.34,Main-207+,,0,0,0,,Dikkatli baktım da bu çantalar bizim değil!
Dialogue: 5,0:26:33.23,0:26:34.37,Main-207+,,0,0,0,,N-N-N-N-Ne yapacağız?!
Dialogue: 5,0:26:34.37,0:26:37.32,Main-207+,,0,0,0,,Hey, çocuklar. \NNe diye bağırıyorsunuz?
Dialogue: 5,0:26:37.32,0:26:40.40,Main-207+,,0,0,0,,Paramız gitmiş!
Dialogue: 5,0:26:40.40,0:26:43.29,Main-207+,,0,0,0,,Kaybolmuş!
Dialogue: 5,0:26:43.29,0:26:45.64,Main-207+,,0,0,0,,– Ne?!\N– Paulie, sen-
Dialogue: 5,0:26:45.64,0:26:46.50,Main-207+,,0,0,0,,Ben değildim!
Dialogue: 5,0:26:46.50,0:26:49.10,Main-207+,,0,0,0,,– Emin misin?\N– Niye yalan söyliyeyim?!
Dialogue: 5,0:26:49.10,0:26:52.71,Main-207+,,0,0,0,,– Gerçekten emin misin?\N– Çok gürültülü, sahi Kaku,...
Dialogue: 5,0:26:52.71,0:26:55.79,Main-207+,,0,0,0,,...Franky Kardeşler'le\Nberaber ne yapıyordun?
Dialogue: 5,0:26:55.79,0:26:57.70,Main-207+,,0,0,0,,Ne? Ne demek istiyorsun?
Dialogue: 5,0:26:57.70,0:27:00.51,Main-207+,,0,0,0,,Franky Kardeşleri bugün görmedim bile.
Dialogue: 5,0:27:00.51,0:27:05.80,Main-207+,,0,0,0,,Tuhaf. Kesinlikle uzun burnunu\Ngördüğümü hatırlıyorum.
Dialogue: 5,0:27:05.80,0:27:07.48,Main-207+,,0,0,0,,Durun biraz!
Dialogue: 5,0:27:07.48,0:27:09.39,Main-207+,,0,0,0,,O Usopp'tu!
Dialogue: 5,0:27:09.39,0:27:11.48,Main-207+,,0,0,0,,Franky Kardeşlerle birlikte mi gitmiş?!
Dialogue: 5,0:27:11.48,0:27:15.85,Main-207+,,0,0,0,,Onlarla gitti, tabii ellerini ağzını\Nbağlamalarının ardından.
Dialogue: 5,0:27:15.85,0:27:17.57,Main-207+,,0,0,0,,Onu kaçırmışlar!
Dialogue: 5,0:27:17.57,0:27:19.40,Main-207+,,0,0,0,,Luffy, gidip onu bulmalıyız!
Dialogue: 5,0:27:19.40,0:27:20.53,Main-207+,,0,0,0,,Tamam!
Dialogue: 5,0:27:20.53,0:27:24.16,Main-207+,,0,0,0,,Hey, dur biraz! \NNereyi arayacaksın, Luffy?!
Dialogue: 5,0:27:26.62,0:27:29.58,Main-207+,,0,0,0,,Geliyorum, Usopp ve para!
Dialogue: 5,0:27:34.41,0:27:37.01,Main-207+,,0,0,0,,Hey, Franky Kardeşler'in gizlenme yeri nerede?
Dialogue: 5,0:27:37.01,0:27:41.18,Main-207+,,0,0,0,,Gizlenme yerleri yok ama hurdalıkları...
Dialogue: 5,0:27:41.18,0:27:47.10,Main-207+,,0,0,0,,...demirlediğiniz kayalık burnun\Ndoğruca kuzeydoğusundaki kıyıda.
Dialogue: 5,0:27:47.10,0:27:49.35,Main-207+,,0,0,0,,Oraya Franky Evi denir.
Dialogue: 5,0:27:52.71,0:27:54.61,Main-207+,,0,0,0,,Luffy!
Dialogue: 5,0:27:55.59,0:27:57.76,Main-207+,,0,0,0,,Luffy!
Dialogue: 5,0:27:58.47,0:28:03.16,Main-207+,,0,0,0,,Üfff! Kendi başına birini bulması mümkün değil!
Dialogue: 5,0:28:03.84,0:28:06.01,Main-207+,,0,0,0,,Ama onu arayarak vakit kaybedemem.
Dialogue: 5,0:28:06.01,0:28:08.79,Main-207+,,0,0,0,,Bu parayı gemiye götürmeliyim.
Dialogue: 5,0:28:09.36,0:28:12.13,Main-207+,,0,0,0,,100 milyon taşırken \N200 milyonu geri almaya çalışmak...
Dialogue: 5,0:28:12.13,0:28:14.67,Main-207+,,0,0,0,,...Dimyat'a pirince giderken eldeki\Nbulgurdan olmak gibi olurdu.
Dialogue: 5,0:28:15.35,0:28:19.23,Main-207+,,0,0,0,,Neyse, sana güveniyorum, yagara-chan!\NKiralık boğa dükkanına giden en kısa yolu seç!
Dialogue: 5,0:28:25.60,0:28:28.56,Main-207+,,0,0,0,,Zorolar'ı alıp onlara bizimle uğraşmak\Nkonusunda bir ders vereceğim!
Dialogue: 5,0:28:28.56,0:28:33.21,Main-207+,,0,0,0,,Korsanlardan çalmak aşağılıkça, \NFranky Kardeşler!
Dialogue: 5,0:28:39.52,0:28:43.81,Main-207+,,0,0,0,,Birinci kat, Arka Sokak Çarşısı.
Dialogue: 5,0:28:43.81,0:28:46.13,Main-207+,,0,0,0,,Güvenli bir yolculuk yapıp gelin!
Dialogue: 5,0:28:50.04,0:28:51.70,Main-207+,,0,0,0,,Sana güveniyorum, yagara-chan!
Dialogue: 5,0:28:54.60,0:28:56.13,Main-207+,,0,0,0,,O da ne?
Dialogue: 5,0:28:56.58,0:28:58.75,Main-207+,,0,0,0,,Dikkat et, ablacım!
Dialogue: 5,0:28:58.75,0:29:00.64,Main-207+,,0,0,0,,Üzgünüm!
Dialogue: 5,0:29:01.71,0:29:05.97,Thoughts-207+,,0,0,0,,Umarım Usopp kaçmayı başarmıştır.
Dialogue: 5,0:29:19.11,0:29:20.49,Main-207+,,0,0,0,,Çok merhametsizce.
Dialogue: 5,0:29:20.49,0:29:21.79,Main-207+,,0,0,0,,Kim bu adam?
Dialogue: 5,0:29:21.79,0:29:24.07,Main-207+,,0,0,0,,Hey, dinleyin! \NBu adamı tanıyan var mı?
Dialogue: 5,0:29:24.07,0:29:25.80,Main-207+,,0,0,0,,Bir kalabalık var.
Dialogue: 5,0:29:25.80,0:29:28.03,Main-207+,,0,0,0,,Hey, yagara-chan! Dur, dur!
Dialogue: 5,0:29:34.70,0:29:36.12,Main-207+,,0,0,0,,Usopp!
Dialogue: 5,0:29:39.00,0:29:40.38,Main-207+,,0,0,0,,Usopp, kendine gel!
Dialogue: 5,0:29:40.38,0:29:42.84,Main-207+,,0,0,0,,Hey, iyi misin?
Dialogue: 5,0:29:42.84,0:29:43.92,Main-207+,,0,0,0,,Hey!
Dialogue: 5,0:29:43.92,0:29:47.00,Main-207+,,0,0,0,,Hey, Usopp! Usopp!
Dialogue: 5,0:29:47.00,0:29:49.83,Main-207+,,0,0,0,,Hey! Siz korsan mısınız?
Dialogue: 5,0:29:49.83,0:29:52.63,Main-207+,,0,0,0,,Kapa çeneni! \NAptal gibi orada durup durma!
Dialogue: 5,0:29:54.30,0:29:58.23,Main-207+,,0,0,0,,Usopp, bunu Franky Kardeşler mi yaptı? \NOnlar mıydı?!
Dialogue: 5,0:30:01.49,0:30:05.75,Main-207+,,0,0,0,,Evet. Çok güçsüzüm.
Dialogue: 5,0:30:06.61,0:30:08.30,Main-207+,,0,0,0,,Parayı...
Dialogue: 5,0:30:08.30,0:30:10.16,Main-207+,,0,0,0,,...aldılar!
Dialogue: 5,0:30:12.50,0:30:14.01,Main-207+,,0,0,0,,Nami...
Dialogue: 5,0:30:16.41,0:30:20.79,Main-207+,,0,0,0,,...diğerlerinin yüzüne bakamam!
Dialogue: 5,0:30:24.60,0:30:29.27,Main-207+,,0,0,0,,Nihayet Merry'yi tamir ettirecektik!
Dialogue: 5,0:30:31.99,0:30:35.51,Main-207+,,0,0,0,,Yüz karasıyım!
Dialogue: 5,0:30:37.71,0:30:40.36,Main-207+,,0,0,0,,Lanet olsun!
Dialogue: 5,0:30:41.05,0:30:43.90,Main-207+,,0,0,0,,Usopp, sorun değil.
Dialogue: 5,0:30:43.90,0:30:48.32,Main-207+,,0,0,0,,Parayı dert etme.\NGeri alacağız.
Dialogue: 5,0:30:48.32,0:30:53.08,Thoughts-207+,,0,0,0,,Onu çok fena dövmüşler. Hareket ettirmemeliyim.
Dialogue: 5,0:30:53.70,0:30:56.50,Main-207+,,0,0,0,,Usopp, burada bekle.
Dialogue: 5,0:30:56.50,0:31:00.30,Main-207+,,0,0,0,,Gemiye gidip yardım getireceğim!
Dialogue: 5,0:31:00.30,0:31:02.88,Main-207+,,0,0,0,,Sana bakması için Chopper'ı getireceğim!
Dialogue: 5,0:31:02.88,0:31:05.39,Main-207+,,0,0,0,,Parayı kaybetme konusunu dert etme!
Dialogue: 5,0:31:05.39,0:31:08.37,Main-207+,,0,0,0,,Gizlenme yerleri ileride!
Dialogue: 5,0:31:08.37,0:31:10.56,Main-207+,,0,0,0,,Canlarına okuyup bu işi bitireceğiz!
Dialogue: 5,0:31:12.05,0:31:16.06,Main-207+,,0,0,0,,Hey! Burada ayı oynatmıyoruz!
Dialogue: 5,0:31:16.90,0:31:19.52,Main-207+,,0,0,0,,Pekala, Usopp.\NSakın buradan ayrılma, tamam mı?
Dialogue: 5,0:31:20.40,0:31:22.14,Main-207+,,0,0,0,,Hemen döneceğim!
Dialogue: 5,0:31:26.94,0:31:30.24,Main-207+,,0,0,0,,Gidebildiğin kadar hızlı git, yagara-chan!
Dialogue: 5,0:31:32.99,0:31:35.58,Main-207+,,0,0,0,,Oooh, delirmiş bir boğa!
Dialogue: 5,0:31:34.89,0:31:35.58,Secondary-207+,,0,0,0,,Hey!
Dialogue: 5,0:31:37.62,0:31:42.29,Flashbacks-720p,,0,0,0,,Nihayet Merry'yi tamir ettirecektik!
Dialogue: 5,0:31:44.04,0:31:48.71,Flashbacks-720p,,0,0,0,,Ne kadar paranız olursa olsun,\No gemi asla eskisi gibi olmayacak.
Dialogue: 5,0:31:49.80,0:31:53.47,Thoughts-207+,,0,0,0,,Ya yeni bir gemi almaya karar vereceğiz...
Dialogue: 5,0:31:53.47,0:31:57.39,Thoughts-207+,,0,0,0,,...veya bir başkası gemimizi tamir\Netmek için elinden ne gelirse yapacak.
Dialogue: 5,0:31:57.39,0:32:04.23,Thoughts-207+,,0,0,0,,Tüm paramızı onu güçlendirmeye ayırmalıyız\Nyoksa onunla yolculuk yapamayacağız!
Dialogue: 5,0:32:05.34,0:32:07.99,Thoughts-207+,,0,0,0,,O paraya ihtiyacımız var!
Dialogue: 5,0:32:07.99,0:32:09.69,Thoughts-207+,,0,0,0,,Geri almak zorundayız!
Dialogue: 5,0:32:12.70,0:32:14.28,Main-207+,,0,0,0,,Emin misin?
Dialogue: 5,0:32:14.28,0:32:17.24,Main-207+,,0,0,0,,Gemi marangozu böyle dedi.
Dialogue: 5,0:32:19.29,0:32:20.58,Main-207+,,0,0,0,,Gemimiz...
Dialogue: 5,0:32:20.58,0:32:23.50,Main-207+,,0,0,0,,...tamir edilemez mi? \NOnca paraya rağmen mi?
Dialogue: 5,0:32:23.50,0:32:26.46,Main-207+,,0,0,0,,Peki ya Merry? Ona ne olacak?
Dialogue: 5,0:32:26.46,0:32:27.91,Main-207+,,0,0,0,,Bilmem.
Dialogue: 5,0:32:27.91,0:32:32.72,Main-207+,,0,0,0,,Bu, Luffyler'in vereceği karara bağlı olacak.
Dialogue: 5,0:32:33.60,0:32:37.60,Main-207+,,0,0,0,,Üçü de tersanede, yani gemi marangozlarına\Nne yapılacağını söyleyecekler.
Dialogue: 5,0:32:37.60,0:32:40.89,Main-207+,,0,0,0,,Yine de bu biraz aşırıya kaçmıyor mu?
Dialogue: 5,0:32:40.89,0:32:44.10,Main-207+,,0,0,0,,Yani gemiye bir baksana! Her zamanki gibi!
Dialogue: 5,0:32:44.10,0:32:48.65,Main-207+,,0,0,0,,Doğu Mavi'den beri bizimle yolculuk yaptı!
Dialogue: 5,0:32:48.65,0:32:51.49,Main-207+,,0,0,0,,O kadar yoldan geldiği için böyle oldu zaten.
Dialogue: 5,0:32:51.49,0:32:54.28,Main-207+,,0,0,0,,Bir insan engelleri aşıp güçlü olabilir...
Dialogue: 5,0:32:55.05,0:32:56.70,Main-207+,,0,0,0,,...ama gemi öyle değildir.
Dialogue: 5,0:32:56.70,0:32:59.41,Main-207+,,0,0,0,,Yaraları sürekli çoğalır ve asla iyileşmez.
Dialogue: 5,0:33:03.85,0:33:05.54,Main-207+,,0,0,0,,Hala buna aklım yatmıyor.
Dialogue: 5,0:33:05.54,0:33:09.10,Main-207+,,0,0,0,,Bunu duyunca Usopp'un ne\Nsöyleyeceğini hayal edebiliyor musun?
Dialogue: 5,0:33:09.10,0:33:11.61,Main-207+,,0,0,0,,Ben Merry'yi seviyorum!
Dialogue: 5,0:33:11.61,0:33:16.47,Main-207+,,0,0,0,,Hepimiz seviyoruz. Ama hasar çok fazla. \NYapabileceğimiz bir şey yok.
Dialogue: 5,0:33:18.75,0:33:21.44,Main-207+,,0,0,0,,Merry ve Robin-chan için endişeleniyorum.
Dialogue: 5,0:33:22.43,0:33:24.14,Main-207+,,0,0,0,,Şu tedirginliği üzerimden atamıyorum.
Dialogue: 5,0:33:26.11,0:33:27.79,Main-207+,,0,0,0,,Çocuklar!
Dialogue: 5,0:33:30.25,0:33:32.36,Main-207+,,0,0,0,,O? Nami döndü!
Dialogue: 5,0:33:32.36,0:33:35.10,Main-207+,,0,0,0,,Ha? Tek başına ama.
Dialogue: 5,0:33:35.10,0:33:37.03,Main-207+,,0,0,0,,Luffy ve Usopp nerede?
Dialogue: 5,0:33:37.81,0:33:41.54,Main-207+,,0,0,0,,Nami-san~! Bir şey mi oldu?
Dialogue: 5,0:33:45.75,0:33:49.69,Main-207+,,0,0,0,,Oh! Oh, oh!\N200 milyon mu?!
Dialogue: 5,0:33:49.69,0:33:51.59,Main-207+,,0,0,0,,Evet, 200 milyon!
Dialogue: 5,0:33:51.59,0:33:54.51,Main-207+,,0,0,0,,Nasıl, abi?
Dialogue: 5,0:33:54.51,0:33:57.89,Main-207+,,0,0,0,,Müthiş! Siz en iyisisiniz!
Dialogue: 5,0:33:57.89,0:34:03.39,Main-207+,,0,0,0,,Bu kadar parayla canım ne isterse alabilirim!
Dialogue: 5,0:34:03.39,0:34:05.49,Main-207+,,0,0,0,,Nihayet başardık, abi!
Dialogue: 5,0:34:05.49,0:34:09.13,Main-207+,,0,0,0,,Üç yıllık sebatın ardından!
Dialogue: 5,0:34:09.13,0:34:11.02,Main-207+,,0,0,0,,– Çok uzun sürdü!\N– Evet.
Dialogue: 5,0:34:11.02,0:34:15.39,Main-207+,,0,0,0,,Yetersiz kazançlarımızı yagara\Nyarışlarına yatırmak bize ne kazandırdı?
Dialogue: 5,0:34:15.39,0:34:16.90,Main-207+,,0,0,0,,Hiçbir şey!
Dialogue: 5,0:34:16.90,0:34:20.60,Main-207+,,0,0,0,,Kanun kaçaklarını yakalamak, içmek ve\Nher gün parti vermek bize ne kazandırdı?
Dialogue: 5,0:34:20.60,0:34:22.16,Main-207+,,0,0,0,,Hiçbir şey!
Dialogue: 5,0:34:22.16,0:34:27.21,Main-207+,,0,0,0,,Hiç para biriktiremedik ama şimdi\Nharcayacak 200 milyon belimiz var!
Dialogue: 5,0:34:27.21,0:34:29.13,Main-207+,,0,0,0,,Her şey yoluna girmiş gibi!
Dialogue: 5,0:34:29.13,0:34:33.15,Main-207+,,0,0,0,,Doğru diyorsunuz çocuklar! İyi iş!
Dialogue: 5,0:34:33.84,0:34:38.51,Main-207+,,0,0,0,,Pek fazla bir şey değil ama işte 5 milyon beli!
Dialogue: 5,0:34:38.51,0:34:42.14,Main-207+,,0,0,0,,Bu, minnettarlığımı göstermek için.\NYiyin, için ve neşelendirici her şeyi yapın!
Dialogue: 5,0:34:46.30,0:34:48.01,Main-207+,,0,0,0,,İşte abimiz!
Dialogue: 5,0:34:48.01,0:34:49.73,Main-207+,,0,0,0,,Parti zamanı!
Dialogue: 5,0:34:57.01,0:34:58.90,Main-207+,,0,0,0,,N-Ne?!
Dialogue: 5,0:34:59.80,0:35:00.66,Main-207+,,0,0,0,,Ha?
Dialogue: 5,0:35:01.20,0:35:02.70,Main-207+,,0,0,0,,Kahretsin!
Dialogue: 5,0:35:02.70,0:35:07.83,Main-207+,,0,0,0,,Hangi çılgın Franky Kardeşler'e\Nsaldırmaya cüret ediyor?!
Dialogue: 5,0:35:13.09,0:35:16.61,Main-207+,,0,0,0,,Deminki zavallı herif!
Dialogue: 5,0:35:16.61,0:35:18.55,Main-207+,,0,0,0,,Hala ayakta mı bu?
Dialogue: 5,0:35:22.30,0:35:24.01,Main-207+,,0,0,0,,Parayı geri verin!
Dialogue: 5,0:35:24.01,0:35:30.06,Main-207+,,0,0,0,,Parayı geri verin mi? Yani Hasır Şapka'nın\Nadamlarından biri misin, kardeş?
Dialogue: 5,0:35:31.31,0:35:33.56,Main-207+,,0,0,0,,Evet, abi!
Dialogue: 5,0:35:33.56,0:35:39.01,Main-207+,,0,0,0,,Hasır Şapkalı Luffy'yle birlikteydi. \NBu yüzden epey güçlü olabileceğini düşünmüştük!
Dialogue: 5,0:35:39.01,0:35:41.28,Main-207+,,0,0,0,,Ama gördüğüm en güçsüz adammış!
Dialogue: 5,0:35:41.92,0:35:44.24,Main-207+,,0,0,0,,Kendi işinize bakın!
Dialogue: 5,0:35:45.62,0:35:46.74,Main-207+,,0,0,0,,Dur bakalım.
Dialogue: 5,0:35:51.61,0:35:53.04,Main-207+,,0,0,0,,Ne yapıyor bu?
Dialogue: 5,0:35:53.04,0:35:56.81,Main-207+,,0,0,0,,Buraya tek başına gelme cesaretin\Nolduğunu kabul ediyorum...
Dialogue: 5,0:35:56.81,0:35:59.63,Main-207+,,0,0,0,,...ama geri vermeyeceğim.
Dialogue: 5,0:36:02.91,0:36:04.89,Main-207+,,0,0,0,,Geri ver!
Dialogue: 5,0:36:04.89,0:36:11.20,Main-207+,,0,0,0,,Gemimizi tamir ettirmek zorundayız!
Dialogue: 5,0:36:14.48,0:36:17.02,Main-207+,,0,0,0,,O paraya ihtiyacımız var!
Dialogue: 5,0:36:21.49,0:36:25.08,Main-207+,,0,0,0,,O para... nihayet....
Dialogue: 5,0:36:25.08,0:36:30.62,Main-207+,,0,0,0,,...Merry'yi tamir ettirme şansımız!
Dialogue: 5,0:36:30.62,0:36:35.87,Main-207+,,0,0,0,,ALMANIZA İZİN VERMİYORUM!
Dialogue: 5,0:36:41.68,0:36:43.63,Main-207+,,0,0,0,,Sen kiminle konuştuğunu sanıyorsun?
Dialogue: 5,0:36:44.50,0:36:48.19,Main-207+,,0,0,0,,Şu küçük geminizi gerçekten seviyor gibisin.
Dialogue: 5,0:36:48.19,0:36:52.64,Main-207+,,0,0,0,,Geminize ne olursa olsun,...
Dialogue: 5,0:36:52.64,0:36:56.56,Main-207+,,0,0,0,,...bu para artık bizim.
Dialogue: 5,0:36:58.52,0:37:04.09,Main-207+,,0,0,0,,Toplumun korsanlardan çalmayı\Nbir suç olarak görmemesi çok kötü.
Dialogue: 5,0:37:04.09,0:37:07.78,Main-207+,,0,0,0,,Bu, muhtemelen siz aşağılık heriflerin\Nbaşka insanlardan çalmış olduğu para.
Dialogue: 5,0:37:09.00,0:37:11.20,Main-207+,,0,0,0,,Almama izin verin gitsin.
Dialogue: 5,0:37:13.21,0:37:16.67,Main-207+,,0,0,0,,Bu yeterince iyi değilse, \Nderdini Denizciler'e anlatmayı dene.
Dialogue: 5,0:37:16.67,0:37:19.39,Main-207+,,0,0,0,,Yakalayacakları sadece sen olacaksın.
Dialogue: 5,0:37:20.81,0:37:23.61,Main-207+,,0,0,0,,Hasır Şapkalı Luffy, kesinlikle talihsiz biri.
Dialogue: 5,0:37:23.61,0:37:29.64,Main-207+,,0,0,0,,İşe yaramaz adamı, \Nbirazcık parayı elinde tutmayı bile beceremiyor!
Dialogue: 5,0:37:37.10,0:37:41.24,Main-207+,,0,0,0,,Onunla istediğiniz gibi oynayabilirsiniz!
Dialogue: 5,0:37:42.57,0:37:47.28,Main-207+,,0,0,0,,Çılgınca alışveriş yapmaya gitmek için hazırım.
Dialogue: 5,0:37:48.06,0:37:49.53,Main-207+,,0,0,0,,Sabırsızlanıyorum!
Dialogue: 5,0:37:49.53,0:37:50.49,Main-207+,,0,0,0,,Dur!
Dialogue: 5,0:37:50.49,0:37:53.20,Main-207+,,0,0,0,,{\fad(150,150)}Hissatsu Kayaku Boshi!
Dialogue: 5,0:37:50.49,0:37:53.20,Attack,,0,0,0,,{\fad(150,150)}Ölümcül Barut Yıldızı
Dialogue: 5,0:38:00.75,0:38:05.72,Main-207+,,0,0,0,,Sana bir şey diyeyim, uzun burunlu çocuk. \NBenim adım Franky.
Dialogue: 5,0:38:05.72,0:38:11.95,Main-207+,,0,0,0,,Bu şehirde hayatta kalmak istiyorsan, \Nkarşıma çıkma.
Dialogue: 5,0:38:14.60,0:38:18.94,Main-207+,,0,0,0,,N-Ne yapıyorsunuz?! Bırakın!
Dialogue: 5,0:38:22.51,0:38:26.32,Main-207+,,0,0,0,,Bu berbat silah hiçbir işe yaramaz!
Dialogue: 5,0:38:26.95,0:38:29.28,Main-207+,,0,0,0,,Görüşürüz, Uzun Burun.
Dialogue: 5,0:38:29.28,0:38:32.79,Main-207+,,0,0,0,,İki yüz milyon beli için sağol.
Dialogue: 5,0:38:32.79,0:38:36.10,Main-207+,,0,0,0,,Dur! Geri ver onu!\NO Merry için!
Dialogue: 5,0:38:36.10,0:38:37.25,Main-207+,,0,0,0,,Geri ver!
Dialogue: 5,0:38:38.10,0:38:39.46,Main-207+,,0,0,0,,Geri ver!
Dialogue: 5,0:38:49.29,0:38:50.97,Main-207+,,0,0,0,,Geri ver...
Dialogue: 5,0:38:50.97,0:38:53.26,Main-207+,,0,0,0,,Ge-Geri ver!
Dialogue: 5,0:39:05.44,0:39:08.90,Main-207+,,0,0,0,,Geri ver!
Dialogue: 5,0:39:10.87,0:39:15.07,Main-207+,,0,0,0,,GERİ VER ONU!
Dialogue: 5,0:39:24.73,0:39:27.09,Main-207+,,0,0,0,,Robin dönene kadar sabırlı olmalıyım.
Dialogue: 5,0:39:30.43,0:39:33.64,Main-207+,,0,0,0,,Onlarla gitseydim bile, ayakbağı olurdum.
Dialogue: 5,0:39:34.51,0:39:35.60,Main-207+,,0,0,0,,Ayrıca çok korkuyorum.
Dialogue: 5,0:39:37.59,0:39:42.10,Main-207+,,0,0,0,,Gemimizi ve 100 milyon belimizi koruyacağım!
Dialogue: 5,0:39:42.10,0:39:45.93,Main-207+,,0,0,0,,Hepinize güveniyorum!
Dialogue: 5,0:39:47.04,0:39:49.10,Main-207+,,0,0,0,,Du-Dur!
Dialogue: 5,0:39:52.71,0:39:57.51,Main-207+,,0,0,0,,Nami-san'a göre yer burası olmalı.
Dialogue: 5,0:39:59.69,0:40:02.38,Flashbacks-720p,,0,0,0,,Bakın, burası arka sokak çarşısı.
Dialogue: 5,0:40:02.38,0:40:06.20,Flashbacks-720p,,0,0,0,,Oraya varınca, buraya ulaşmak\Niçin o kanaldan yukarı çıkın.
Dialogue: 5,0:40:06.22,0:40:07.60,Flashbacks-720p,,0,0,0,,İşte. Usopp burada.
Dialogue: 5,0:40:07.60,0:40:08.93,Flashbacks-720p,,0,0,0,,Anladım.
Dialogue: 5,0:40:08.93,0:40:13.20,Flashbacks-720p,,0,0,0,,Nami-san, Franky Kardeşler'in hurdalığı nerede?
Dialogue: 5,0:40:14.60,0:40:16.00,Main-207+,,0,0,0,,Usopp!
Dialogue: 5,0:40:16.00,0:40:17.21,Main-207+,,0,0,0,,Burada değil.
Dialogue: 5,0:40:17.21,0:40:19.80,Main-207+,,0,0,0,,Emin misin? \NBelki de yanlış yere geldik.
Dialogue: 5,0:40:19.80,0:40:21.77,Main-207+,,0,0,0,,Ben sen değilim! Kapa çeneni!
Dialogue: 5,0:40:21.77,0:40:23.40,Main-207+,,0,0,0,,Usopp!
Dialogue: 5,0:40:23.40,0:40:26.11,Main-207+,,0,0,0,,– O da neydi?!\N– Bakın!
Dialogue: 5,0:40:29.50,0:40:31.28,Main-207+,,0,0,0,,Bakın, bu kan.
Dialogue: 5,0:40:31.28,0:40:34.82,Main-207+,,0,0,0,,Aptal, harekete geçmiş.
Dialogue: 5,0:40:34.82,0:40:37.16,Main-207+,,0,0,0,,Yoksa o...
Dialogue: 5,0:40:37.63,0:40:39.62,Main-207+,,0,0,0,,Usopp...
Dialogue: 5,0:40:42.08,0:40:43.25,Main-207+,,0,0,0,,Ha?
Dialogue: 5,0:40:54.30,0:40:55.56,Main-207+,,0,0,0,,Kurtarın beni!
Dialogue: 5,0:40:55.56,0:40:57.01,Main-207+,,0,0,0,,Luffy?!
Dialogue: 5,0:41:03.82,0:41:07.72,Main-207+,,0,0,0,,Ne yapıyordun? Nereden düştün?
Dialogue: 5,0:41:08.85,0:41:10.20,Main-207+,,0,0,0,,Tersanedeki...
Dialogue: 5,0:41:10.20,0:41:14.28,Main-207+,,0,0,0,,...adam gibi çatılardan atlamaya çalıştım.\NUsopp'u arıyordum.
Dialogue: 5,0:41:14.28,0:41:15.45,Main-207+,,0,0,0,,İyi misin?
Dialogue: 5,0:41:15.45,0:41:16.82,Main-207+,,0,0,0,,Evet.
Dialogue: 5,0:41:16.82,0:41:19.56,Main-207+,,0,0,0,,Hey, çocuklar! Acele etmeliyiz!
Dialogue: 5,0:41:19.56,0:41:21.75,Main-207+,,0,0,0,,Usopp, paramızın çoğuyla birlikte kaçırıldı!
Dialogue: 5,0:41:22.31,0:41:23.93,Main-207+,,0,0,0,,Evet, biliyoruz.
Dialogue: 5,0:41:23.93,0:41:27.96,Main-207+,,0,0,0,,Hey, şunların evine gidelim.
Dialogue: 5,0:41:27.96,0:41:30.70,Main-207+,,0,0,0,,Usopp'u yaralayıp paramızı almışlar.
Dialogue: 5,0:41:33.60,0:41:40.17,Main-207+,,0,0,0,,Kendini sorumlu hissettiği için\NFranky Kardeşler'e meydan okuyor olabilir.
Dialogue: 5,0:42:02.41,0:42:04.89,Main-207+,,0,0,0,,Nefes alıyor mu, Chopper?
Dialogue: 5,0:42:04.89,0:42:09.09,Main-207+,,0,0,0,,Baygın durumda ama ölmemiş.
Dialogue: 5,0:42:09.09,0:42:11.46,Main-207+,,0,0,0,,İyi olacak. Onu tedavi edebilirim.
Dialogue: 5,0:42:16.49,0:42:20.55,Main-207+,,0,0,0,,Biraz daha bekle, Usopp.
Dialogue: 5,0:42:44.31,0:42:48.39,Main-207+,,0,0,0,,O berbat evi alaşağı edeceğiz.
