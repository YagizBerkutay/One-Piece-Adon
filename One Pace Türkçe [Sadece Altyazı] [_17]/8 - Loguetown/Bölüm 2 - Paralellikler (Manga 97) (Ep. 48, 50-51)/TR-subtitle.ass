0,10,65,1Style: Kanji-furigana-OPı,Duality,18,&H00D8933F,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2,0,8,10,10,80,1Style: Author,Impress BT,20.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1,1,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:01.73,0:00:03.73,Credits-480p,,90,0,60,,Editing FeesoDialogue: 0,0:00:03.73,0:00:05.73,Credits-480p,,90,0,60,,Timing KaitouYahikoDialogue: 0,0:00:05.73,0:00:09.73,Credits-480p,,90,0,60,,Quality Control Feeso Galaxy 9000 Pepperjack SewilDialogue: 0,0:00:09.73,0:00:11.73,Credits-480p,,90,0,60,,Soundtracking HaleeDialogue: 0,0:00:11.73,0:00:13.73,Credits-480p,,90,0,60,,Graphics DatenshiDialogue: 0,0:00:13.73,0:00:15.73,Credits-480p,,90,0,60,,Karaoke KaitouYahikoDialogue: 0,0:00:15.73,0:00:17.73,Credits-480p,,90,0,60,,Translation Gaijin FUNimationDialogue: 0,0:02:59.53,0:03:03.57,Captions-480p,,0,0,5,,"Beyaz Avcı" Smoker Donanma Karargahı AlbayıDialogue: 0,0:01:56.97,0:01:59.43,Main-480p,,0,0,0,,Kaptan Smoker! Bir uyarı var!Dialogue: 0,0:01:59.43,0:02:01.09,Main-480p,,0,0,0,,Denizci Karargahından bir bildiri aldık.Dialogue: 0,0:02:01.09,0:02:06.23,Main-480p,,0,0,0,,Monkey D. Luffy ve korsan tayfasının Loguetown'a geldiklerine dair!Dialogue: 0,0:02:06.23,0:02:10.65,Main-480p,,0,0,0,,O, başında 30 milyon berry ödül bulunan, bir East Blue Korsanı!Dialogue: 0,0:02:10.65,0:02:14.11,Main-480p,,0,0,0,,30 milyon, ha? Onu tebrik etmemi falan mı istiyorsun?Dialogue: 0,0:02:14.11,0:02:18.13,Main-480p,,0,0,0,,Don Krieg'i ve Deniz adamı Arlong'u yenen o!Dialogue: 0,0:02:18.13,0:02:19.07,Main-480p,,0,0,0,,Kapa çeneni!Dialogue: 0,0:02:24.79,0:02:28.73,Main-480p,,0,0,0,,Bağırmana lanet olsun... yıktın onları.Dialogue: 0,0:02:28.73,0:02:29.58,Main-480p,,0,0,0,,Afedersiniz.Dialogue: 0,0:02:32.54,0:02:35.17,Main-480p,,0,0,0,,Neyse, unut gitsin. İşleri yapmak için, kendi yöntemim var.Dialogue: 0,0:02:29.58,0:02:32.54,Main-480p,,0,0,0,,Kendi tempomda çalışırım.Dialogue: 0,0:02:35.17,0:02:36.65,Main-480p,,0,0,0,,Biliyor musun?Dialogue: 0,0:02:36.65,0:02:37.89,Main-480p,,0,0,0,,E-Evet, efendim.Dialogue: 0,0:02:42.65,0:02:44.13,Main-480p,,0,0,0,,Pekala, ne diyordun?Dialogue: 0,0:02:44.13,0:02:45.37,Main-480p,,0,0,0,,Efendim.Dialogue: 0,0:02:45.37,0:02:50.23,Main-480p,,0,0,0,,Görünüşe göre, bugün şehre gelen bir grup korsan var... efendim.Dialogue: 0,0:02:50.23,0:02:52.07,Main-480p,,0,0,0,,Ne diye heyecanlanıyorsun?Dialogue: 0,0:02:52.07,0:02:54.82,Main-480p,,0,0,0,,Bu göreve geldiğimden beri,...Dialogue: 0,0:02:54.82,0:02:58.11,Main-480p,,0,0,0,,...bir kez bu şehire girdikten sonra, çıkabilen bir korsan oldu mu?Dialogue: 0,0:02:58.11,0:02:59.49,Main-480p,,0,0,0,,Şey, hayır.Dialogue: 0,0:02:59.49,0:03:03.57,Main-480p,,0,0,1,, Öyleyse o kadar gerilme. Kendi tempomda, bu işle ilgileneceğim.Dialogue: 0,0:03:03.57,0:03:04.93,Main-480p,,0,0,0,,Evet...Dialogue: 0,0:03:05.69,0:03:09.53,Main-480p,,0,0,0,,Rapor veriyorum!  Limanda korsanlar gözlendi!Dialogue: 0,0:03:09.53,0:03:11.29,Main-480p,,0,0,0,,Lütfen durumu doğrulamak için gelin!Dialogue: 0,0:03:11.73,0:03:15.51,Main-480p,,0,0,0,,Luffy Korsanları olmalı, efendim! Bildiride başkalarından bahsedilmiyordu!Dialogue: 0,0:03:15.51,0:03:19.47,Main-480p,,0,0,0,,30 milyon, ha?  Bu görmek isteyeceğim bir şey.Dialogue: 0,0:03:19.47,0:03:20.43,Main-480p,,0,0,0,,Ha?Dialogue: 0,0:03:20.43,0:03:22.41,Main-480p,,0,0,0,,Sadece sesli düşünüyordum. Unut gitsin.Dialogue: 0,0:03:25.65,0:03:26.81,Main-480p,,0,0,0,,Buna ihtiyacınız yok mu?Dialogue: 0,0:03:28.31,0:03:31.27,Main-480p,,0,0,0,,"Adalet"Dialogue: 0,0:03:31.27,0:03:33.89,Main-480p,,0,0,0,,Kaptan, lütfen destek isteyin.Dialogue: 0,0:03:33.89,0:03:34.95,Main-480p,,0,0,0,,Gerek yok.Dialogue: 0,0:03:34.95,0:03:37.78,Main-480p,,0,0,0,,Ama! Düşmanın farzedilen gücü...Dialogue: 0,0:03:38.87,0:03:40.99,Main-480p,,0,0,0,,Her neyse, Tashigi nerede?Dialogue: 0,0:03:40.99,0:03:44.23,Main-480p,,0,0,0,,Oh... aslında, bu sabahtan beri yok.Dialogue: 0,0:03:44.23,0:03:47.19,Main-480p,,0,0,0,,Sabah talimini kaçırdı.Dialogue: 0,0:03:47.19,0:03:50.20,Main-480p,,0,0,0,,Şaşkın kız... Şimdi nereye gitti?Dialogue: 0,0:03:50.20,0:03:52.22,Main-480p,,0,0,0,,Yaşasın! Üç kepçe dondurma!Dialogue: 0,0:03:52.22,0:03:54.79,Main-480p,,0,0,0,,Hey, hey! Dikkatli ol, koşarken düşme!Dialogue: 0,0:04:02.51,0:04:05.13,Main-480p,,0,0,0,,K-Kaptan Smoker!Dialogue: 0,0:04:05.79,0:04:07.11,Main-480p,,0,0,0,,Dondurmam...Dialogue: 0,0:04:07.11,0:04:09.56,Main-480p,,0,0,0,,Çok üzgünüm! Çocuğum...Dialogue: 0,0:04:09.97,0:04:13.19,Main-480p,,0,0,0,,Çok üzgünüm! Üzgünüm! Üzgünüm! Üzgünüm!! ÜZGÜNÜM!!Dialogue: 0,0:04:14.43,0:04:18.70,Main-480p,,0,0,0,,Olanlar için üzgünüm. Görünüşe göre pantolonum dondurmanı yedi.Dialogue: 0,0:04:18.70,0:04:20.93,Main-480p,,0,0,0,,İşte, git kendine beş kepçe al.Dialogue: 0,0:04:21.87,0:04:22.38,Main-480p,,0,0,0,,Gidelim.Dialogue: 0,0:04:22.38,0:04:23.19,Main-480p,,0,0,0,,Tabii.Dialogue: 0,0:04:24.99,0:04:27.47,Main-480p,,0,0,0,,Ç-Çok teşekkür ederim!Dialogue: 0,0:04:27.47,0:04:28.85,Main-480p,,0,0,0,,Teşekkür ederim.Dialogue: 0,0:04:33.29,0:04:36.79,Main-480p,,0,0,0,,Burayı tertemiz edin yoldaşlarım! Tek bir metelik bile bırakmayın!Dialogue: 0,0:04:37.23,0:04:40.34,Main-480p,,0,0,0,,Bildiğiniz gibi, bu erzakların tamamı,...Dialogue: 0,0:04:40.34,0:04:43.30,Main-480p,,0,0,0,,...Hilal Gary-sama'nın Korsanlar Kralı olması için gerekli.Dialogue: 0,0:04:43.30,0:04:46.37,Main-480p,,0,0,0,,Bu yüzden hepsini aldığınıza emin olun!Dialogue: 0,0:04:46.37,0:04:47.68,Main-480p,,0,0,0,,Hey...Dialogue: 0,0:04:47.68,0:04:49.18,Main-480p,,0,0,0,,Patron kim?Dialogue: 0,0:04:50.25,0:04:51.57,Main-480p,,0,0,0,,Sen de kimsin?Dialogue: 0,0:04:51.57,0:04:54.81,Main-480p,,0,0,0,,Monkey D. Luffy olarak bilinen pislik sen misin?Dialogue: 0,0:04:55.12,0:04:57.85,Main-480p,,0,0,0,,O çirkin yüzünü şehrimde gösterecek kadar aptal...Dialogue: 0,0:04:57.87,0:05:00.61,Main-480p,,0,0,0,,...olduğuna göre, ne kadar sert olduğunu görelim.Dialogue: 0,0:05:00.61,0:05:02.11,Main-480p,,0,0,0,,Ne? Şaka yapıyor olmalısın!Dialogue: 0,0:05:02.95,0:05:04.15,Main-480p,,0,0,0,,Haklayın onu!Dialogue: 0,0:05:13.59,0:05:15.00,Main-480p,,0,0,0,,Kaptan Smoker?Dialogue: 0,0:05:15.00,0:05:18.95,Main-480p,,0,0,0,,Evet! Denizci Karargahının en üstün askerlerinden biridir.Dialogue: 0,0:05:18.95,0:05:23.49,Main-480p,,0,0,0,,Bu şehir Grand Line'a giden korsanlarla doluydu.Dialogue: 0,0:05:23.49,0:05:28.47,Main-480p,,0,0,0,,Ama Kaptan buraya yerleştiğinden beri,  şehre gelen her korsan,...Dialogue: 0,0:05:28.47,0:05:31.06,Main-480p,,0,0,0,,...sonunda kendisini kafeste buluyor.Dialogue: 0,0:05:31.45,0:05:34.49,Main-480p,,0,0,0,,Normal biri değil. Canavar olduğunu söylüyorlar.Dialogue: 0,0:05:34.49,0:05:38.10,Main-480p,,0,0,0,,Şeytan Meyvesi'nin gücüne sahip olduğunu bile söylüyorlar.Dialogue: 0,0:05:38.99,0:05:40.53,Main-480p,,0,0,0,,Şeytan Meyvesi mi?Dialogue: 0,0:05:46.74,0:05:50.87,Main-480p,,0,0,0,,İyi iş, Kaptan! Luffy Korsanlarının işini rekor zamanda bitirdiniz!Dialogue: 0,0:05:50.87,0:05:54.63,Main-480p,,0,0,0,,Kör müsün, yoksa sadece aptal mı? Bu ezikler nasıl Luffy'nin olabilir?Dialogue: 0,0:05:55.52,0:05:59.25,Main-480p,,0,0,0,,Eğer bu serseriler 30 milyon değerindeyse,  dünyanın sonu gelmiş demektir.Dialogue: 0,0:05:59.25,0:06:01.26,Main-480p,,0,0,0,,Ö-Öyleyse ya Luffy?Dialogue: 0,0:06:01.26,0:06:05.72,Main-480p,,0,0,0,,Er ya da geç kendini gösterecek. Sonra da eğlence başlayacak.Dialogue: 0,0:06:05.72,0:06:07.09,Main-480p,,0,0,0,,Ha?Dialogue: 0,0:06:07.88,0:06:12.15,Main-480p,,0,0,0,,Nasıl oldu da limanın arkasına geldim? Nasıl?Dialogue: 0,0:06:12.15,0:06:13.85,Main-480p,,0,0,0,,HEY!Dialogue: 0,0:06:14.22,0:06:16.25,Main-480p,,0,0,0,,Şu aptallardan biri daha mı?Dialogue: 0,0:06:16.25,0:06:18.44,Main-480p,,0,0,0,,Sanmıyorum...Dialogue: 0,0:06:18.44,0:06:22.62,Main-480p,,0,0,0,,Ne şansa ama! İnfaz platformuna nasıl gidebileceğimi söyleyebilir misiniz?Dialogue: 0,0:06:22.62,0:06:23.67,Main-480p,,0,0,0,,İnfaz platformu mu?Dialogue: 0,0:06:23.67,0:06:25.75,Main-480p,,0,0,0,,Evet, sanırım kayboldum.Dialogue: 0,0:06:25.75,0:06:27.91,Main-480p,,0,0,0,,Daha önce seni hiç buralarda görmedim.Dialogue: 0,0:06:27.91,0:06:30.53,Main-480p,,0,0,0,,Evet! Bugün geldim.Dialogue: 0,0:06:30.55,0:06:34.86,Main-480p,,0,0,0,,Ne büyük bir şehir ama!  Foosha Köyü'nden tamamen farklı.Dialogue: 0,0:06:34.86,0:06:36.66,Main-480p,,0,0,0,,Niye darağaçlarını arıyorsun?Dialogue: 0,0:06:36.66,0:06:40.37,Main-480p,,0,0,0,,Görmek istiyorum. Korsanlar Kralı'nın öldüğü yeri!Dialogue: 0,0:06:44.13,0:06:46.42,Main-480p,,0,0,0,,Bilmiyor musun? Her neyse....Dialogue: 0,0:06:46.43,0:06:49.29,Main-480p,,0,0,0,,Bekle. Dumanın işaret ettiği yere bak.Dialogue: 0,0:06:50.97,0:06:53.68,Main-480p,,0,0,0,,Ooh! O taraftan mı? Teşekkürler!Dialogue: 0,0:07:10.57,0:07:12.47,Main-480p,,0,0,0,,Aaah, bittim...Dialogue: 0,0:07:12.47,0:07:14.54,Main-480p,,0,0,0,,İnfaz platformuna ulaşmaya çalışıyordum,...Dialogue: 0,0:07:14.54,0:07:17.61,Main-480p,,0,0,0,,...ama bu hiç de doğru yol gibi görünmüyor.Dialogue: 0,0:07:17.61,0:07:20.04,Main-480p,,0,0,0,,Her neyse, er ya da geç ona kesin rastlayacağım.Dialogue: 0,0:07:22.83,0:07:24.45,Main-480p,,0,0,0,,Bir bakalım.Dialogue: 0,0:07:24.45,0:07:25.58,Main-480p,,0,0,0,,Hangi taraftan...Dialogue: 0,0:07:27.55,0:07:29.79,Main-480p,,0,0,0,,Gold... Roger?Dialogue: 0,0:07:49.97,0:07:51.95,Main-480p,,0,0,0,,Yaşlı adam, sahibi sen misin?Dialogue: 0,0:07:51.95,0:07:55.12,Main-480p,,0,0,0,,Dışarıdaki tabela "Gold Roger" diyor.Dialogue: 0,0:07:55.12,0:07:56.83,Main-480p,,0,0,0,,O, bu yerin ismi mi?Dialogue: 0,0:07:57.33,0:07:59.04,Main-480p,,0,0,0,,Defol.Dialogue: 0,0:07:59.04,0:08:02.63,Main-480p,,0,0,0,,Burası çocuklar için değil.Dialogue: 0,0:08:02.63,0:08:06.08,Main-480p,,0,0,0,,Üstelik şu anda kapalıyız.Dialogue: 0,0:08:06.08,0:08:08.08,Main-480p,,0,0,0,,İş mi yok?Dialogue: 0,0:08:08.08,0:08:11.51,Main-480p,,0,0,0,,İş var! Sadece saatler sonra!Dialogue: 0,0:08:11.51,0:08:13.05,Main-480p,,0,0,0,,Şimdi defol!Dialogue: 0,0:08:13.05,0:08:16.18,Main-480p,,0,0,0,,Sadece isim konusunda meraklandım.Dialogue: 0,0:08:16.18,0:08:21.28,Main-480p,,0,0,0,,Kayboldum. İnfaz platformunu görmeye gitmek istiyordum.Dialogue: 0,0:08:21.28,0:08:23.31,Main-480p,,0,0,0,,Oraya nasıl gidebileceğimi söyleyebilir misin?Dialogue: 0,0:08:24.35,0:08:26.27,Main-480p,,0,0,0,,Masadaki o şey de ne?Dialogue: 0,0:08:26.27,0:08:29.98,Main-480p,,0,0,0,,Bir kafatası! Çok büyük!Dialogue: 0,0:08:29.98,0:08:34.99,Main-480p,,0,0,0,,"Katil Dev" olarak bilinen bir adamın kafatası.Dialogue: 0,0:08:34.99,0:08:39.45,Main-480p,,0,0,0,,Yüzlerce korsanı öldüren bir adam. Tam bir şeytandı.Dialogue: 0,0:08:41.15,0:08:45.21,Main-480p,,0,0,0,,Ama Gold Roger onu buldu ve öldürdü.Dialogue: 0,0:08:45.21,0:08:47.03,Main-480p,,0,0,0,,Gold Roger mı öldürdü?Dialogue: 0,0:08:47.03,0:08:48.88,Main-480p,,0,0,0,,Ünlü bir hikaye!Dialogue: 0,0:08:49.24,0:08:51.55,Main-480p,,0,0,0,,Onu öldüren, bu derin yara.Dialogue: 0,0:08:52.69,0:08:55.86,Main-480p,,0,0,0,,Ama gerçekten bir şeydi.Dialogue: 0,0:08:55.86,0:08:58.05,Main-480p,,0,0,0,,Son sözleri:...Dialogue: 0,0:08:58.05,0:09:01.62,Main-480p,,0,0,0,,''Roger. Kimse sana dokunamaz."Dialogue: 0,0:09:01.62,0:09:04.27,Main-480p,,0,0,0,,''Seni sonsuz bir korsan olarak övüyorum."Dialogue: 0,0:09:05.35,0:09:07.81,Main-480p,,0,0,0,,Müthiş! Harika!Dialogue: 0,0:09:08.18,0:09:12.21,Main-480p,,0,0,0,,Daha sonra, Grand Line'ı fethettiğini duyduğumda,...Dialogue: 0,0:09:12.21,0:09:16.91,Main-480p,,0,0,0,,...çok şaşırdım, birazcık yaşımı bile unuttum!Dialogue: 0,0:09:18.55,0:09:24.62,Main-480p,,0,0,0,,Ama şimdi, herkes göçüp gitti. Roger  yirmi yıl önce burada, darağacında infaz edildi.Dialogue: 0,0:09:25.11,0:09:28.24,Main-480p,,0,0,0,,O günden sonra, herkes kendisine korsan...Dialogue: 0,0:09:28.24,0:09:30.57,Main-480p,,0,0,0,,...deme cüretini göstererek, etrafta geziyor.Dialogue: 0,0:09:30.57,0:09:33.65,Main-480p,,0,0,0,,Buna "Büyük Korsan Çağı" bile diyorlar.Dialogue: 0,0:09:34.39,0:09:36.70,Main-480p,,0,0,0,,Ama hepsi sadece bir grup...Dialogue: 0,0:09:36.68,0:09:40.43,Main-480p,,0,0,0,,...korkak süprüntü.Dialogue: 0,0:09:40.95,0:09:45.70,Main-480p,,0,0,0,,Gittikçe daha da az insan Grand Line'a yelken açmaya cesaret ediyor.Dialogue: 0,0:09:45.70,0:09:49.65,Main-480p,,0,0,0,,Bu yüzden, bu yerin kapanma sebebi de bu.Dialogue: 0,0:09:49.65,0:09:52.02,Main-480p,,0,0,0,,Ben... Grand Line'a gideceğim.Dialogue: 0,0:09:52.02,0:09:53.03,Main-480p,,0,0,0,,Ha?!Dialogue: 0,0:09:53.03,0:09:55.80,Main-480p,,0,0,0,,Harikaydı, ha? Gold Roger.Dialogue: 0,0:09:55.80,0:09:57.99,Main-480p,,0,0,0,,Korsanlar onun gibi olmaya çalışmalı.Dialogue: 0,0:09:57.99,0:10:00.03,Main-480p,,0,0,0,,Bu yüzden Grand Line'a gitmek...Dialogue: 0,0:10:00.03,0:10:03.62,Main-480p,,0,0,0,,...ve One Piece'i bulmak için denize açıldım.Dialogue: 0,0:10:03.62,0:10:05.83,Main-480p,,0,0,0,,Korsanlar Kralı olacağım!Dialogue: 0,0:10:11.42,0:10:16.85,Main-480p,,0,0,0,,Bu söylenecek delice bir şey! Onu bu yerde nasıl söyleyebilirsin?Dialogue: 0,0:10:16.85,0:10:19.05,Main-480p,,0,0,0,,Ne? Ben sadece doğruyu söylüyorum.Dialogue: 0,0:10:20.97,0:10:23.98,Main-480p,,0,0,0,,Çocuk, senin gibi bir müşterim olduktan sonra,...Dialogue: 0,0:10:23.98,0:10:26.11,Main-480p,,0,0,0,,...dükkanı biraz daha geç kapatacağımı hissediyorum.Dialogue: 0,0:10:26.11,0:10:28.06,Main-480p,,0,0,0,,Bunu benim için yapma.Dialogue: 0,0:10:28.06,0:10:31.61,Main-480p,,0,0,0,,Karar verildi. Kararımı değiştirmen için, yapabileceğin bir şey yok.Dialogue: 0,0:10:31.61,0:10:34.35,Main-480p,,0,0,0,,Müşterim olmayalı uzun zaman oldu.Dialogue: 0,0:10:34.35,0:10:36.74,Main-480p,,0,0,0,,İçecekler benden.Dialogue: 0,0:10:37.16,0:10:38.82,Main-480p,,0,0,0,,Ben içmem.Dialogue: 0,0:10:40.01,0:10:42.12,Main-480p,,0,0,0,,Öyle mi? Buna ne dersin?Dialogue: 0,0:10:43.63,0:10:47.95,Main-480p,,0,0,0,,Sonsuz Korsanlar Kralı şerefine.Dialogue: 0,0:10:51.57,0:10:53.59,Main-480p,,0,0,0,,Sonsuz Korsanlar Kralı şerefine!Dialogue: 0,0:11:05.89,0:11:09.57,Main-480p,,0,0,0,,Müthiş! Bu mavi yüzgeçli fil tonbalığı değil mi?Dialogue: 0,0:11:09.57,0:11:13.12,Main-480p,,0,0,0,,Haklısın! Güney denizlerinden gelmiş olmalı.Dialogue: 0,0:11:13.12,0:11:15.34,Main-480p,,0,0,0,,Onu tek bir kamışla yakaladık!Dialogue: 0,0:11:15.34,0:11:16.78,Main-480p,,0,0,0,,Sadece bir tane mi?Dialogue: 0,0:11:17.61,0:11:19.74,Main-480p,,0,0,0,,Mavi yüzgeçli fil tonbalığı...Dialogue: 0,0:11:20.10,0:11:22.23,Main-480p,,0,0,0,,Pekala, onu buradan götürelim.Dialogue: 0,0:11:22.23,0:11:23.01,Main-480p,,0,0,0,,Tamam!Dialogue: 0,0:11:23.01,0:11:24.80,Main-480p,,0,0,0,,L-Lütfen durun!Dialogue: 0,0:11:24.80,0:11:25.33,Main-480p,,0,0,0,,Ne?Dialogue: 0,0:11:25.33,0:11:28.20,Main-480p,,0,0,0,,Param var. Lütfen almama izin verin!Dialogue: 0,0:11:29.73,0:11:32.58,Main-480p,,0,0,0,,Aldım! Aldım! Hepsini aldım!Dialogue: 0,0:11:33.05,0:11:36.88,Main-480p,,0,0,0,,Denizin Cesur Savaşçısı olma hazırlıklarım tamam!Dialogue: 0,0:11:36.88,0:11:39.49,Main-480p,,0,0,0,,Bir şey unuttum mu?Dialogue: 0,0:11:39.49,0:11:42.61,Main-480p,,0,0,0,,Sahi, en önemli şeyi unuttum.Dialogue: 0,0:11:42.61,0:11:43.14,Main-480p,,0,0,0,,Gözlük.Dialogue: 0,0:11:43.59,0:11:46.56,Main-480p,,0,0,0,,Birinci sınıf bir keskin nişancının, birinci sınıf bir gözlüğü olmaması hiç iyi değil.Dialogue: 0,0:11:46.56,0:11:47.87,Main-480p,,0,0,0,,Bu temelin temeli!Dialogue: 0,0:11:47.87,0:11:50.59,Main-480p,,0,0,0,,Onu almak için, kalan tüm paramı kullanmam gerekse bile,...Dialogue: 0,0:11:50.59,0:11:54.10,Main-480p,,0,0,0,,...bu, keskin nişancı kalbimin pişman olmayacağı bir şey!Dialogue: 0,0:11:54.10,0:11:56.03,Main-480p,,0,0,0,,Gözlük! Gözlük!Dialogue: 0,0:12:06.07,0:12:09.87,Main-480p,,0,0,0,,Bunlar mükemmel! Evet! Bu harika! Onları almalıyım!Dialogue: 0,0:12:09.87,0:12:10.79,Main-480p,,0,0,0,,Yaşlı kadın!Dialogue: 0,0:12:10.79,0:12:14.79,Main-480p,,0,0,0,,Kaliteden anlayan gözlerin var!  O North Blue'nun son modeli.Dialogue: 0,0:12:14.79,0:12:18.80,Main-480p,,0,0,0,,Onları acil bir görev için ayrılmadan önce, bir grup Denizci'den aldım.Dialogue: 0,0:12:18.80,0:12:20.87,Main-480p,,0,0,0,,Sorun nedir? Paran yok mu?Dialogue: 0,0:12:20.87,0:12:22.88,Main-480p,,0,0,0,,Meteliksiz serseriler için vaktim yok!Dialogue: 0,0:12:22.88,0:12:23.97,Main-480p,,0,0,0,,Ne yapacaksın?!Dialogue: 0,0:12:23.97,0:12:24.82,Main-480p,,0,0,0,,Hayır... O...Dialogue: 0,0:12:24.82,0:12:26.09,Main-480p,,0,0,0,,Ah evet, işte!Dialogue: 0,0:12:26.09,0:12:28.10,Main-480p,,0,0,0,,Bu gözlükleri istiyorum, lütfen.Dialogue: 0,0:12:28.10,0:12:30.13,Main-480p,,0,0,0,,Ah! Ne sevimli küçük bir kız!Dialogue: 0,0:12:30.13,0:12:31.96,Main-480p,,0,0,0,,Evet-evet-evet-evet! Şanslı olan sensin, değil mi?Dialogue: 0,0:12:31.96,0:12:35.15,Main-480p,,0,0,0,,Bu gözlükler şehirde türünün tek örneği!Dialogue: 0,0:12:36.19,0:12:38.02,Main-480p,,0,0,0,,DUR BİR DAKİKA!!Dialogue: 0,0:12:38.02,0:12:39.87,Main-480p,,0,0,0,,İLK BEN GELDİM!Dialogue: 0,0:12:42.59,0:12:44.24,Main-480p,,0,0,0,,Kötü şans, OSSAN.Dialogue: 0,0:12:48.39,0:12:49.49,Main-480p,,0,0,0,,Bana ossan dedi.Dialogue: 0,0:12:51.54,0:12:54.01,Main-480p,,0,0,0,,Hey! Dur bir dakika!Dialogue: 0,0:12:54.01,0:12:57.06,Main-480p,,0,0,0,,Burada bir şeyi açıklığa kavuşturalım. Ben ossan değilim.Dialogue: 0,0:12:57.06,0:12:59.29,Main-480p,,0,0,0,,Bana "onii-sama" de, tamam mı?Dialogue: 0,0:12:59.29,0:13:01.32,Main-480p,,0,0,0,,Ne demek istiyorsun, ossan?Dialogue: 0,0:13:01.32,0:13:03.29,Main-480p,,0,0,0,,Aah! Yine bana öyle diyorsun?!Dialogue: 0,0:13:03.29,0:13:05.09,Main-480p,,0,0,0,,O gözlükleri geri ver! İlk ben gelmiştim!Dialogue: 0,0:13:05.09,0:13:06.82,Main-480p,,0,0,0,,Nee?!Dialogue: 0,0:13:06.82,0:13:09.05,Main-480p,,0,0,0,,Benimle bir sorunun mu var? Ha?Dialogue: 0,0:13:09.05,0:13:11.84,Main-480p,,0,0,0,,Onu istemeye devam edersen, Denizcileri çağıracağım!Dialogue: 0,0:13:11.84,0:13:12.77,Main-480p,,0,0,0,,Denizciler!Dialogue: 0,0:13:12.77,0:13:16.91,Main-480p,,0,0,0,,Evet. Bu şehrin Denizci Kaptanı'nın bir arkadaşıyım,...Dialogue: 0,0:13:16.91,0:13:18.90,Main-480p,,0,0,0,,...Dumanlı Amca.Dialogue: 0,0:13:18.90,0:13:20.75,Main-480p,,0,0,0,,Bu kız kimin nesi?!Dialogue: 0,0:13:22.17,0:13:23.94,Main-480p,,0,0,0,,Beni tanımadığın belli!Dialogue: 0,0:13:23.94,0:13:27.45,Main-480p,,0,0,0,,Ben Arlong'un deniz adamı korsanlarını yok eden, büyük Kaptan Usopp'um!Dialogue: 0,0:13:27.82,0:13:31.13,Main-480p,,0,0,0,,Peşimden 200... hayır, 300 deniz adamı gönderdiler.Dialogue: 0,0:13:31.13,0:13:35.41,Main-480p,,0,0,0,,Ama hepsini kendi başıma bir bam, gümle yendim!Dialogue: 0,0:13:35.41,0:13:40.38,Main-480p,,0,0,0,,Sonuç olarak, başıma 30 milyon berry ödül kondu!Dialogue: 0,0:13:41.27,0:13:43.20,Main-480p,,0,0,0,,Oh, gerçekten? 30 milyon mu?Dialogue: 0,0:13:43.20,0:13:45.05,Main-480p,,0,0,0,,Evet, doğru.Dialogue: 0,0:13:45.05,0:13:46.26,Main-480p,,0,0,0,,Baba!Dialogue: 0,0:13:46.26,0:13:49.36,Main-480p,,0,0,0,,Baba?? Niye bana baba diyo-Dialogue: 0,0:13:49.36,0:13:51.72,Main-480p,,0,0,0,,Bu senin için bir hediye baba!Dialogue: 0,0:13:51.72,0:13:53.97,Main-480p,,0,0,0,,Doğum günün kutlu olsun!Dialogue: 0,0:13:53.97,0:13:56.33,Main-480p,,0,0,0,,Oh, Carol...Dialogue: 0,0:13:59.27,0:14:04.12,Main-480p,,0,0,0,,Ne iyi, meleksi bir çocuk!  Seni seviyorum, Carol-chan~!Dialogue: 0,0:14:04.12,0:14:06.11,Main-480p,,0,0,0,,Baba! Seni seviyorum, baba~!Dialogue: 0,0:14:11.53,0:14:15.34,Main-480p,,0,0,0,,Ama varya, o yaşlı adam bunu kapmaya çalışıyordu!Dialogue: 0,0:14:15.34,0:14:19.04,Main-480p,,0,0,0,,Hadi ama, kapmak iyi bir şey değildir. Hiç iyi değil.Dialogue: 0,0:14:19.04,0:14:22.00,Main-480p,,0,0,0,,Gözdağı vermek yanlıştır, değil mi?Dialogue: 0,0:14:23.45,0:14:27.59,Main-480p,,0,0,0,,Tatlı Carol'ıma eziyet eden sen miydin?Dialogue: 0,0:14:30.68,0:14:31.72,Main-480p,,0,0,0,,Bir şey daha var.Dialogue: 0,0:14:31.74,0:14:33.13,Main-480p,,0,0,0,,Evet~?Dialogue: 0,0:14:35.09,0:14:38.39,Main-480p,,0,0,0,,Oh, demek 30 milyon berry değerindesin?Dialogue: 0,0:14:38.93,0:14:40.57,Main-480p,,0,0,0,,Bir bakalım...Dialogue: 0,0:14:40.57,0:14:42.69,Main-480p,,0,0,0,,Onlar yeni arananlar listesi, değil mi?Dialogue: 0,0:14:42.69,0:14:45.39,Main-480p,,0,0,0,,Evet, onları biraz önce Denizci ofisinden aldım.Dialogue: 0,0:14:45.39,0:14:51.16,Main-480p,,0,0,0,,600,000... 1,300,000... 700,000...Dialogue: 0,0:14:51.99,0:14:53.95,Main-480p,,0,0,0,,30 milyon, Hasır Şapka Luffy.Dialogue: 0,0:14:54.34,0:14:57.45,Main-480p,,0,0,0,,Kısa zamanda bu kadar değer kazanmış.Dialogue: 0,0:14:57.95,0:14:59.25,Main-480p,,0,0,0,,Dur bakalım, çocuk.Dialogue: 0,0:15:00.25,0:15:02.06,Main-480p,,0,0,0,,Ne demek istediniz?Dialogue: 0,0:15:02.06,0:15:03.40,Main-480p,,0,0,0,,Uh bilirsiniz...Dialogue: 0,0:15:03.40,0:15:07.35,Main-480p,,0,0,0,,O ödül kağıtları arasında olmam mümkün değil. Yalandı. Yalan!Dialogue: 0,0:15:07.35,0:15:10.72,Main-480p,,0,0,0,,Onu korkutma planım tam bir başarıydı  veya öyle görünüyor. Bu yüzden elveda...Dialogue: 0,0:15:11.68,0:15:13.09,Main-480p,,0,0,0,,Bu sensin, değil mi?Dialogue: 0,0:15:13.85,0:15:17.36,Main-480p,,0,0,0,,Evet, doğru. Onun ben olduğuma şüphe yok.Dialogue: 0,0:15:17.36,0:15:20.65,Main-480p,,0,0,0,,Ama şunu söylememe izin verin: Bana elinizi sürerseniz,...Dialogue: 0,0:15:20.65,0:15:22.69,Main-480p,,0,0,0,,...Kaptanım Luffy geri durmayacak!Dialogue: 0,0:15:22.69,0:15:26.61,Main-480p,,0,0,0,,O korkunç, kana susamış, şeytansı bir adamdır!Dialogue: 0,0:15:26.61,0:15:29.28,Main-480p,,0,0,0,,Onunla yüzleştikten sonra, kimse sağ kalmadı!Dialogue: 0,0:15:29.66,0:15:33.45,Main-480p,,0,0,0,,Bir çocuğun var, değil mi?  Hayatına değer ver.Dialogue: 0,0:15:33.45,0:15:35.58,Main-480p,,0,0,0,,Anlıyorum, öyleyse bu kesinlikle bir sorun.Dialogue: 0,0:15:36.55,0:15:39.52,Main-480p,,0,0,0,,Otuz milyon berry değerindeki bu Luffy'nin,...Dialogue: 0,0:15:39.52,0:15:42.35,Main-480p,,0,0,0,,...sıradan bir adam olmaması gerektiği doğru.Dialogue: 0,0:15:42.35,0:15:45.53,Main-480p,,0,0,0,,Baba! Hiç şüphesiz, babam daha güçlü olmalı.Dialogue: 0,0:15:45.53,0:15:47.55,Main-480p,,0,0,0,,Çünkü babam dünyanın en iyisi!Dialogue: 0,0:15:47.55,0:15:49.25,Main-480p,,0,0,0,,Carol! Sorun değil!Dialogue: 0,0:15:49.25,0:15:53.77,Main-480p,,0,0,0,,Baban seninle mutlu bir şekilde yaşamaya yetecek  kadar para kazanırsa, bu yeter de artar bile!Dialogue: 0,0:15:53.77,0:15:56.97,Main-480p,,0,0,0,,Sen benim için, dünyanın en iyisi olmaktan daha önemlisin.Dialogue: 0,0:15:56.97,0:15:58.06,Main-480p,,0,0,0,,Baba.Dialogue: 0,0:16:04.52,0:16:07.23,Main-480p,,0,0,0,,Evet, doğru! Yani şimdi ne kadar tehlikeli olduğumu anlıyorsun!Dialogue: 0,0:16:07.23,0:16:10.24,Main-480p,,0,0,0,,Bir şey söylemeyeceğim, sadece o gözlükleri bana ver.Dialogue: 0,0:16:10.24,0:16:11.28,Main-480p,,0,0,0,,Nee?!Dialogue: 0,0:16:11.28,0:16:16.11,Main-480p,,0,0,0,,Endişelenme. Onun için sana para vereceğim. Bu yüzden... Hadi, hadi, hadi!Dialogue: 0,0:16:16.11,0:16:20.53,Main-480p,,0,0,0,,Seen! Biraz önce onları babama verdim ve şimdi de sen istiyorsun.Dialogue: 0,0:16:20.53,0:16:21.45,Main-480p,,0,0,0,,Baba.Dialogue: 0,0:16:21.45,0:16:22.75,Main-480p,,0,0,0,,Öyleyse bunu yapalım.Dialogue: 0,0:16:23.20,0:16:26.75,Main-480p,,0,0,0,,Bunu bir düello ile halletmeye itirazın var mı?Dialogue: 0,0:16:26.75,0:16:27.70,Main-480p,,0,0,0,,Düello mu?Dialogue: 0,0:16:27.70,0:16:28.96,Main-480p,,0,0,0,,İşte.Dialogue: 0,0:16:28.96,0:16:32.76,Main-480p,,0,0,0,,Düello derken... Ölüm kalım düellosu demek istemiş olamazsın, değil mi?Dialogue: 0,0:16:32.76,0:16:35.72,Main-480p,,0,0,0,,Kazanırsan, gözlükleri vereceğim.Dialogue: 0,0:16:37.45,0:16:40.15,Main-480p,,0,0,0,,1, 2, 3, 4, 5, 6... 30 silah?!Dialogue: 0,0:16:40.15,0:16:42.18,Main-480p,,0,0,0,,Yoksa sen...Dialogue: 0,0:16:42.51,0:16:44.69,Main-480p,,0,0,0,,...Baba Daddy misin?Dialogue: 0,0:16:44.69,0:16:45.90,Main-480p,,0,0,0,,Evet, öyleyim.Dialogue: 0,0:16:45.90,0:16:47.11,Main-480p,,0,0,0,,Hey, düello var! Düello olduğunu duydum!Dialogue: 0,0:16:47.11,0:16:49.23,Main-480p,,0,0,0,,Baba Daddy birine meydan okuyacak!Dialogue: 0,0:16:49.23,0:16:51.69,Main-480p,,0,0,0,,Baba Daddy mi dedin?Dialogue: 0,0:16:52.55,0:16:56.05,Main-480p,,0,0,0,,En iyi silah çeken ödül avcısı, Baba Daddy!Dialogue: 0,0:16:56.05,0:16:58.21,Main-480p,,0,0,0,,East Blue'da hiç sağduyu yok mu?Dialogue: 0,0:16:58.21,0:17:03.04,Main-480p,,0,0,0,,Acaba ne tür bir aptal onun gibi biriyle dövüşmek ister?!Dialogue: 0,0:17:06.63,0:17:07.88,Main-480p,,0,0,0,,Oh, bu tür bir aptal...Dialogue: 0,0:17:07.88,0:17:09.80,Main-480p,,0,0,0,,Elinden geleni yap, uzun burun!Dialogue: 0,0:17:09.80,0:17:13.85,Main-480p,,0,0,0,,Kaybetme konusunda endişelenme, güzel bir cenaze yapacağız!Dialogue: 0,0:17:19.39,0:17:22.45,Main-480p,,0,0,0,,Kurallar basit. 10 adımdan sonra dön ve ateş et.Dialogue: 0,0:17:22.45,0:17:23.32,Main-480p,,0,0,0,,E-evet...Dialogue: 0,0:17:23.32,0:17:25.03,Main-480p,,0,0,0,,Ne yapıyorsun sen?!Dialogue: 0,0:17:25.03,0:17:25.97,Main-480p,,0,0,0,,Nami!Dialogue: 0,0:17:25.97,0:17:29.06,Main-480p,,0,0,0,,Baba Daddy'e meydan mı okuyorsun? Aptal falan mısın sen?!Dialogue: 0,0:17:29.06,0:17:32.28,Main-480p,,0,0,0,,Kapa çeneni!  Nasılsa iş buraya kadar geldi!Dialogue: 0,0:17:32.28,0:17:35.28,Main-480p,,0,0,0,,Bir setlik düello. Hazır mısınız?Dialogue: 0,0:17:35.28,0:17:36.25,Main-480p,,0,0,0,,Evet.Dialogue: 0,0:17:36.25,0:17:37.24,Main-480p,,0,0,0,,Ahhhh...Dialogue: 0,0:17:45.47,0:17:46.47,Main-480p,,0,0,0,,1!Dialogue: 0,0:17:48.03,0:17:49.42,Main-480p,,0,0,0,,2!Dialogue: 0,0:17:49.97,0:17:51.03,Main-480p,,0,0,0,,3!Dialogue: 0,0:17:52.19,0:17:53.23,Main-480p,,0,0,0,,4!Dialogue: 0,0:17:54.01,0:17:55.01,Main-480p,,0,0,0,,5!Dialogue: 0,0:18:01.68,0:18:02.68,Main-480p,,0,0,0,,6!Dialogue: 0,0:18:08.04,0:18:08.65,Main-480p,,0,0,0,,7!Dialogue: 0,0:18:18.03,0:18:18.74,Main-480p,,0,0,0,,8!Dialogue: 0,0:18:20.87,0:18:21.95,Main-480p,,0,0,0,,Teşekkürler ve elveda!!Dialogue: 0,0:18:38.19,0:18:41.22,Main-480p,,0,0,0,,Baba! Müthişsin baba! Harikasın!Dialogue: 0,0:18:41.22,0:18:42.94,Main-480p,,0,0,0,,Ne? Zavallıca.Dialogue: 0,0:18:42.94,0:18:44.39,Main-480p,,0,0,0,,Buna düello mu diyorsun?Dialogue: 0,0:18:44.39,0:18:48.60,Main-480p,,0,0,0,,Daha heyecan verici olacağını düşünmüştüm. Ne hayal kırıklığı ama.Dialogue: 0,0:18:48.91,0:18:51.27,Main-480p,,0,0,0,,Neden kaçıyorsun? Seni korkak!Dialogue: 0,0:18:51.27,0:18:55.05,Main-480p,,0,0,0,,Zayıf böcek! En başından dövüşmemeliydin!Dialogue: 0,0:18:55.05,0:18:59.15,Main-480p,,0,0,0,,Üzgünüm! Lütfen beni affedin! Aslında, ben bu tür bir adamım.Dialogue: 0,0:18:59.15,0:19:02.91,Main-480p,,0,0,0,,Hayatımı alsanız bile, bundan hiçbir şey kazanmayacaksınız.Dialogue: 0,0:19:02.91,0:19:03.62,Main-480p,,0,0,0,,T-Tamam mı? Tamam mı?Dialogue: 0,0:19:04.17,0:19:05.83,Main-480p,,0,0,0,,B-Bu tek dileği-Dialogue: 0,0:19:07.23,0:19:08.53,Main-480p,,0,0,0,,D-Durun!Dialogue: 0,0:19:08.53,0:19:09.66,Main-480p,,0,0,0,,Nami!Dialogue: 0,0:19:09.66,0:19:13.37,Main-480p,,0,0,0,,Ah evet! Konu paraysa, size istediğiniz kadar verecek!Dialogue: 0,0:19:13.37,0:19:16.33,Main-480p,,0,0,0,,Bu yüzden lütfen ateş etmeyin! Hayatımı bağışlayın, lütfen!Dialogue: 0,0:19:16.33,0:19:17.34,Main-480p,,0,0,0,,Seeen...Dialogue: 0,0:19:17.70,0:19:20.43,Main-480p,,0,0,0,,Bir kadının arkasına saklanıyorsun, ha?Dialogue: 0,0:19:21.29,0:19:22.93,Main-480p,,0,0,0,,Her neyse...Dialogue: 0,0:19:23.43,0:19:25.49,Main-480p,,0,0,0,,Hayır, yanılıyorsunuz. Söylediğimi unutun.Dialogue: 0,0:19:25.49,0:19:27.97,Main-480p,,0,0,0,,Onun bununla bir ilgisi yok.Dialogue: 0,0:19:27.97,0:19:31.41,Main-480p,,0,0,0,,Beni vuracaksanız, onu karıştırmayın.Dialogue: 0,0:19:31.41,0:19:32.34,Main-480p,,0,0,0,,Usopp...Dialogue: 0,0:19:32.34,0:19:34.15,Main-480p,,0,0,0,,Lütfen, yalvarıyorum.Dialogue: 0,0:19:34.15,0:19:35.66,Main-480p,,0,0,0,,"Usopp?"Dialogue: 0,0:19:35.66,0:19:37.61,Main-480p,,0,0,0,,Çocuk, adın Usopp mu?Dialogue: 0,0:19:37.94,0:19:38.61,Main-480p,,0,0,0,,E-Evet.Dialogue: 0,0:19:39.49,0:19:41.22,Main-480p,,0,0,0,,Yoksa...Dialogue: 0,0:19:41.22,0:19:46.12,Main-480p,,0,0,0,,Kızıl Saç Korsanlarından Yasopp diye birini tanıyor musun?Dialogue: 0,0:19:46.12,0:19:49.82,Main-480p,,0,0,0,,Yasopp? O babamın adı...Dialogue: 0,0:19:49.82,0:19:52.62,Main-480p,,0,0,0,,Onunla karşılaştın mı?Dialogue: 0,0:19:53.05,0:19:55.50,Main-480p,,0,0,0,,Anlıyorum... onun oğlu...Dialogue: 0,0:19:56.51,0:19:57.34,Main-480p,,0,0,0,,Baba?Dialogue: 0,0:19:58.35,0:20:03.77,Main-480p,,0,0,0,,Tek bir kelime... o gün hakkında kimseye tek bir kelime bile söylemedim.Dialogue: 0,0:20:03.77,0:20:06.14,Main-480p,,0,0,0,,Ama senin için farklı olacak.Dialogue: 0,0:20:06.14,0:20:11.95,Main-480p,,0,0,0,,Her şey, bunun gibi sıcak, terletici bir liman şehrinde oldu.Dialogue: 0,0:20:11.95,0:20:15.48,Main-480p,,0,0,0,,Başlayalım, Teğmen Masterson! Bir setlik düello!Dialogue: 0,0:20:15.48,0:20:19.07,Main-480p,,0,0,0,,1! 2! 3!Dialogue: 0,0:20:32.53,0:20:37.42,Main-480p,,0,0,0,,Öldür beni. Düelloyu kaybettim. Bedeli hayatım.Dialogue: 0,0:20:41.39,0:20:43.09,Main-480p,,0,0,0,,Sen ne-Dialogue: 0,0:20:43.09,0:20:44.51,Main-480p,,0,0,0,,Kızın mı?Dialogue: 0,0:20:44.51,0:20:45.90,Main-480p,,0,0,0,,Geri ver.Dialogue: 0,0:20:45.90,0:20:50.18,Main-480p,,0,0,0,,Yetenekli bir Denizci Teğmenisin, ama böyle bir şeyi gösteriyorsun.Dialogue: 0,0:20:50.18,0:20:51.54,Main-480p,,0,0,0,,Çok yumuşaksın.Dialogue: 0,0:20:51.54,0:20:54.57,Main-480p,,0,0,0,,Korsan tavrınla bana vaaz verme.Dialogue: 0,0:20:54.57,0:20:56.07,Main-480p,,0,0,0,,Elbette.Dialogue: 0,0:20:57.48,0:20:59.81,Main-480p,,0,0,0,,Ah, gerçekten iyi iş Yasopp!Dialogue: 0,0:20:59.81,0:21:01.23,Main-480p,,0,0,0,,Önemli değildi.Dialogue: 0,0:21:01.23,0:21:03.95,Main-480p,,0,0,0,,Aldığım bu yara, henüz yeterince iyi olmadığımı gösteriyor.Dialogue: 0,0:21:03.95,0:21:06.41,Main-480p,,0,0,0,,Ama rakibin Daddy Masterson'du!Dialogue: 0,0:21:06.41,0:21:08.95,Main-480p,,0,0,0,,Kazanma sebebin, sen olduğun içindi!Dialogue: 0,0:21:08.95,0:21:11.74,Main-480p,,0,0,0,,Hiçbirimiz yapamazdık!Dialogue: 0,0:21:12.50,0:21:14.09,Main-480p,,0,0,0,,Afedersin Patron.Dialogue: 0,0:21:14.09,0:21:18.71,Main-480p,,0,0,0,,Hiçbir şey söylemeyip, düelloyu izlediğin için teşekkürler.Dialogue: 0,0:21:23.75,0:21:26.30,Main-480p,,0,0,0,,Bu harika. Teğmen, biraz ister misin?Dialogue: 0,0:21:29.85,0:21:31.52,Main-480p,,0,0,0,,Aile, ha?Dialogue: 0,0:21:31.52,0:21:34.81,Main-480p,,0,0,0,,Üzgünüm. Ama ben bunda iyi değilim.Dialogue: 0,0:21:35.87,0:21:39.03,Main-480p,,0,0,0,,Usopp adında bir oğlum var.Dialogue: 0,0:21:39.03,0:21:40.68,Main-480p,,0,0,0,,Onu yıllardır görmedim.Dialogue: 0,0:21:40.68,0:21:44.37,Main-480p,,0,0,0,,Henüz bir bebekken, deniz için onu terkettim.Dialogue: 0,0:21:44.37,0:21:48.11,Main-480p,,0,0,0,,Niye? Oğlunu sevmiyor musun?Dialogue: 0,0:21:48.75,0:21:50.87,Main-480p,,0,0,0,,Sorun bu değil.Dialogue: 0,0:21:52.08,0:21:54.29,Main-480p,,0,0,0,,Korsan bayrağı...Dialogue: 0,0:21:54.29,0:21:56.97,Main-480p,,0,0,0,,Jolly Roger beni çağırıyordu!Dialogue: 0,0:21:56.97,0:21:59.15,Main-480p,,0,0,0,,Daha iyisi için değil miydi, Yasopp?Dialogue: 0,0:22:04.38,0:22:05.80,Main-480p,,0,0,0,,Neyse...Dialogue: 0,0:22:08.39,0:22:11.89,Main-480p,,0,0,0,,Ben... oğlum için bir şey yapamadım.Dialogue: 0,0:22:11.89,0:22:15.98,Main-480p,,0,0,0,,Benim gibi işe yaramaz bir babadan bir tane olması yeter de artar bile.Dialogue: 0,0:22:16.87,0:22:21.23,Main-480p,,0,0,0,,Kızına yakın olmalısın.  Onu yalnız bırakmamalısın.Dialogue: 0,0:22:21.25,0:22:24.27,Main-480p,,0,0,0,,Evet, elbette bunu söyleyecek konumda değilim!Dialogue: 0,0:22:29.27,0:22:32.79,Main-480p,,0,0,0,,Düelloyu kaybettim! Yasopp, bitir işimi!Dialogue: 0,0:22:32.79,0:22:35.18,Main-480p,,0,0,0,,Merhametini istemiyorum!Dialogue: 0,0:22:35.18,0:22:36.69,Main-480p,,0,0,0,,Hayır, sağol.Dialogue: 0,0:22:36.69,0:22:40.75,Main-480p,,0,0,0,,Siz Denizciler bir korsan yakalarsanız, infaz etmeniz gerekir.Dialogue: 0,0:22:40.75,0:22:44.63,Main-480p,,0,0,0,,Ama bir korsan için öldürmek ya da öldürmemek onun keyfine bağlıdır.Dialogue: 0,0:22:44.63,0:22:45.80,Main-480p,,0,0,0,,Görüşürüz!Dialogue: 0,0:22:59.10,0:23:03.77,Main-480p,,0,0,0,,Baba... bir korsana karşı kaybedip, yaşamak zorunda mı kaldın?Dialogue: 0,0:23:03.77,0:23:08.67,Main-480p,,0,0,0,,Ama, bu müthiş değil mi? Baban müthiş bir adam, ha?Dialogue: 0,0:23:08.67,0:23:09.32,Main-480p,,0,0,0,,Usopp?Dialogue: 0,0:23:09.65,0:23:11.28,Main-480p,,0,0,0,,Bu normal mi?Dialogue: 0,0:23:11.28,0:23:14.15,Main-480p,,0,0,0,,Neredeyse ölmek üzere olduğun bir hikayeyi anlatmak?Dialogue: 0,0:23:14.15,0:23:16.91,Main-480p,,0,0,0,,Benim gibi bir korkağa böyle bir hikayeyi anlatmak?Dialogue: 0,0:23:18.69,0:23:22.35,Main-480p,,0,0,0,,Beni cesaretlendirmek için bunu anlattın!Dialogue: 0,0:23:22.35,0:23:25.57,Main-480p,,0,0,0,,Normal insanların saklayacağı bir hikaye!Dialogue: 0,0:23:25.57,0:23:28.76,Main-480p,,0,0,0,,Bu kadar korkak olmama rağmen, onu bana anlattın.Dialogue: 0,0:23:29.22,0:23:33.94,Main-480p,,0,0,0,,Babamın hayatına nasıl yön verdiğini... Doğru değil mi?Dialogue: 0,0:23:33.94,0:23:36.89,Main-480p,,0,0,0,,Güçsüz veya korkak olmaya dayanamıyorum!Dialogue: 0,0:23:38.47,0:23:41.43,Main-480p,,0,0,0,,Carol... Baban büyük bir savaşçı.Dialogue: 0,0:23:41.43,0:23:43.95,Main-480p,,0,0,0,,Güçlü bir adam her yerde bulunabilir!Dialogue: 0,0:23:43.95,0:23:48.05,Main-480p,,0,0,0,,Ama, baban gibi güçlü ve iyi bir adam daha önce hiç görmedim.Dialogue: 0,0:23:50.13,0:23:57.45,Main-480p,,0,0,0,,Bu şekilde kaybedemem. Cesaretimi toplamazsam, babamı utandıracağım.Dialogue: 0,0:23:57.45,0:24:02.31,Main-480p,,0,0,0,,Daddy, yaşamımı ortaya koymam için, bana bir düello şansı daha ver!Dialogue: 0,0:24:02.31,0:24:03.96,Main-480p,,0,0,0,,Bu kez kaçmaya çalışmayacağım!Dialogue: 0,0:24:09.69,0:24:12.53,Main-480p,,0,0,0,,Pekala. Bu kez gerçek bir düello olacak.Dialogue: 0,0:24:12.53,0:24:15.09,Main-480p,,0,0,0,,En çok güvendiğin silahını seç.Dialogue: 0,0:24:18.26,0:24:21.68,Main-480p,,0,0,0,,Tamam. Onunla... Bir bakalım...Dialogue: 0,0:24:25.15,0:24:27.74,Main-480p,,0,0,0,,Bana o rüzgar gülünü vurabileceğini göster.Dialogue: 0,0:24:27.74,0:24:29.91,Main-480p,,0,0,0,,Rüzgar gülü... O mu?Dialogue: 0,0:24:32.19,0:24:34.20,Main-480p,,0,0,0,,Kaçırırsan,...Dialogue: 0,0:24:34.20,0:24:37.04,Main-480p,,0,0,0,,Evet, kafamı uçuracaksın, sorun değil.Dialogue: 0,0:24:37.04,0:24:37.70,Main-480p,,0,0,0,,Usopp!Dialogue: 0,0:24:39.07,0:24:42.37,Main-480p,,0,0,0,,Bu bir adamın, hayatını riske ettiği bir düello.Dialogue: 0,0:24:46.79,0:24:48.19,Main-480p,,0,0,0,,Olamaz!Dialogue: 0,0:24:48.19,0:24:51.51,Main-480p,,0,0,0,,O şeyle o kadar uzağı vurman mümkün değil!Dialogue: 0,0:25:12.23,0:25:13.64,Main-480p,,0,0,0,,Kaçırdı!Dialogue: 0,0:25:13.64,0:25:16.36,Main-480p,,0,0,0,,Dur baba! Ateş etme baba!Dialogue: 0,0:25:18.75,0:25:22.11,Main-480p,,0,0,0,,Nasıl edebilirim? Usopp hedefini vurdu!Dialogue: 0,0:25:23.89,0:25:26.33,Main-480p,,0,0,0,,Haklı! Mücevherli tacı vurdu!Dialogue: 0,0:25:27.41,0:25:28.83,Main-480p,,0,0,0,,Usopp!Dialogue: 0,0:25:28.83,0:25:32.30,Main-480p,,0,0,0,,Yasopp'un oğlundan beklendiği gibi, müthiş bir yetenek.Dialogue: 0,0:25:32.30,0:25:35.76,Main-480p,,0,0,0,,O cesareti unutmazsan, eminim bir gün...Dialogue: 0,0:25:35.76,0:25:38.26,Main-480p,,0,0,0,,...baban gibi olabilirsin.Dialogue: 0,0:25:40.37,0:25:43.87,Main-480p,,0,0,0,,Grand Line'a git. Yasopp kesinlikle orada olacak.Dialogue: 0,0:25:43.87,0:25:44.85,Main-480p,,0,0,0,,Daddy...Dialogue: 0,0:25:47.31,0:25:49.51,Main-480p,,0,0,0,,Epey iyi, ossan!Dialogue: 0,0:25:49.51,0:25:50.81,Main-480p,,0,0,0,,Bu...?Dialogue: 0,0:25:51.41,0:25:53.50,Main-480p,,0,0,0,,Sorun değil, elveda!Dialogue: 0,0:25:53.50,0:25:54.57,Main-480p,,0,0,0,,Baba!Dialogue: 0,0:25:54.57,0:25:56.68,Main-480p,,0,0,0,,Carol, kötü olmak iyi değil.Dialogue: 0,0:25:56.68,0:25:58.91,Main-480p,,0,0,0,,Gözdağı vermek kötüdür, değil mi?Dialogue: 0,0:25:58.91,0:26:00.95,Main-480p,,0,0,0,,Üzgünüm, baba!Dialogue: 0,0:26:00.95,0:26:04.70,Main-480p,,0,0,0,,Baba'sının kızı olarak, güzel bir kadın olmak istiyorum.Dialogue: 0,0:26:04.70,0:26:05.94,Main-480p,,0,0,0,,Bu yüzden lütfen beni affet!Dialogue: 0,0:26:05.94,0:26:09.17,Main-480p,,0,0,0,,Şimdiki halinle de güzelsin.Dialogue: 0,0:26:09.17,0:26:10.54,Main-480p,,0,0,0,,Daha da güzel olmak istiyorum!Dialogue: 0,0:26:10.54,0:26:13.15,Main-480p,,0,0,0,,Zerafetten düştükten sonra bile,...Dialogue: 0,0:26:13.15,0:26:17.13,Main-480p,,0,0,0,,...sevdiklerini korumak için dövüşüyor, ha?Dialogue: 0,0:26:17.13,0:26:21.17,Main-480p,,0,0,0,,Ben de Daddy gibi cesaretli bir adam olacağım.Dialogue: 0,0:26:21.17,0:26:25.81,Main-480p,,0,0,0,,Bir gün gerçek bir savaşçı olacağım ve babamla yüzyüze geleceğim!Dialogue: 0,0:26:27.67,0:26:29.15,Main-480p,,0,0,0,,Bir gün!Dialogue: 0,0:26:37.97,0:26:38.86,Main-480p,,0,0,0,,Demek sensin, ha?Dialogue: 0,0:26:39.20,0:26:41.23,Main-480p,,0,0,0,,Her zamanki selamlama, ha?Dialogue: 0,0:26:42.23,0:26:43.95,Main-480p,,0,0,0,,Eski bir müşteriye iyi bir davranış şekli değil.Dialogue: 0,0:26:44.83,0:26:47.77,Main-480p,,0,0,0,,Beni sana ihanet eden biri olarak düşünmemelisin.Dialogue: 0,0:26:47.77,0:26:50.50,Main-480p,,0,0,0,,İçinde olduğun bu iş, benim hatam değil.Dialogue: 0,0:26:50.50,0:26:54.34,Main-480p,,0,0,0,,Günümüzdeki korsanların hepsi güçsüz. Asıl sorun bu.Dialogue: 0,0:26:57.03,0:26:59.43,Main-480p,,0,0,0,,Bir müşteri, ha? Epey nadir bir durum.Dialogue: 0,0:27:01.09,0:27:03.85,Main-480p,,0,0,0,,Biraz rom istiyorum.Dialogue: 0,0:27:03.85,0:27:06.05,Main-480p,,0,0,0,,Burada senin türüne hizmet vermiyoruz.Dialogue: 0,0:27:06.05,0:27:10.73,Main-480p,,0,0,0,,Biliyorsun, bu ayrımcılık demek. Bugün özel bir gün.Dialogue: 0,0:27:12.39,0:27:13.63,Main-480p,,0,0,0,,Değil mi?Dialogue: 0,0:27:18.45,0:27:19.99,Main-480p,,0,0,0,,Harika.Dialogue: 0,0:27:22.01,0:27:25.43,Main-480p,,0,0,0,,O gün olan şey, şimdi bile, hafızamda tazeliğini koruyor.Dialogue: 0,0:27:26.73,0:27:29.12,Main-480p,,0,0,0,,Roger, son anlarında.Dialogue: 0,0:27:29.12,0:27:32.45,Main-480p,,0,0,0,,Bugünkü gibi, sıcak ve rutubetli bir gündü.Dialogue: 0,0:27:35.23,0:27:38.25,Main-480p,,0,0,0,,İnfaz platformuna giden yolda,...Dialogue: 0,0:27:38.25,0:27:40.23,Main-480p,,0,0,0,,...elleri bağlı olmasına rağmen,...Dialogue: 0,0:27:40.23,0:27:43.71,Main-480p,,0,0,0,,...kendisini gururla taşıdı.Dialogue: 0,0:28:12.75,0:28:15.93,Main-480p,,0,0,0,,Zenginlik, Şöhret, Güç.Dialogue: 0,0:28:15.93,0:28:20.08,Main-480p,,0,0,0,,Bu dünyadaki her şeyi elde eden adam, Gold Roger.Dialogue: 0,0:28:20.08,0:28:22.55,Main-480p,,0,0,0,,Ölümüne doğru yürüyor.Dialogue: 0,0:28:22.55,0:28:25.85,Main-480p,,0,0,0,,Mağrur bir savaşçı gibi, kendisini dimdik tuttu.Dialogue: 0,0:28:26.65,0:28:29.31,Main-480p,,0,0,0,,Miras kalan istek.Dialogue: 0,0:28:29.31,0:28:32.83,Main-480p,,0,0,0,,Çağın Kaderi. İnsanların Hayalleri.Dialogue: 0,0:28:32.83,0:28:36.13,Main-480p,,0,0,0,,İnsanlar özgürlüğün manasını takip etmeye devam ettiği sürece,...Dialogue: 0,0:28:36.13,0:28:39.57,Main-480p,,0,0,0,,...bu şeyler asla sona ermeyecek!Dialogue: 0,0:28:48.01,0:28:50.03,Main-480p,,0,0,0,,Son bir arzun var mı?Dialogue: 0,0:28:52.07,0:28:56.16,Main-480p,,0,0,0,,Bunu çıkarabilir misin? Bileklerimi sıkıyor.Dialogue: 0,0:28:56.16,0:28:57.43,Main-480p,,0,0,0,,Bunu yapamam!Dialogue: 0,0:28:57.43,0:28:59.09,Main-480p,,0,0,0,,Niye şimdi kaçayım?Dialogue: 0,0:29:00.49,0:29:03.05,Main-480p,,0,0,0,,Hmm. Bu biraz üzücü.Dialogue: 0,0:29:07.51,0:29:10.33,Main-480p,,0,0,0,,Pekala, işinizi bitirin.Dialogue: 0,0:29:26.73,0:29:28.20,Main-480p,,0,0,0,,HEY! KORSANLAR KRALI!Dialogue: 0,0:29:29.49,0:29:31.87,Main-480p,,0,0,0,,Hazinenle ne yaptın?Dialogue: 0,0:29:31.87,0:29:34.12,Main-480p,,0,0,0,,Grand Line'da bir yerde, değil mi?Dialogue: 0,0:29:34.53,0:29:38.58,Main-480p,,0,0,0,,Ona sahipsin, değil mi? Dünyadaki en büyük hazineye?!Dialogue: 0,0:29:38.58,0:29:40.04,Main-480p,,0,0,0,,Küstah! Çeneni kapat!Dialogue: 0,0:29:40.04,0:29:42.55,Main-480p,,0,0,0,,Tek özel hazinen?Dialogue: 0,0:29:43.63,0:29:47.49,Main-480p,,0,0,0,,ONE PIECE!Dialogue: 0,0:29:57.10,0:29:58.69,Main-480p,,0,0,0,,Hazinem mi?Dialogue: 0,0:29:58.69,0:30:00.01,Main-480p,,0,0,0,,Tamam! Bu kadarı yeter!Dialogue: 0,0:30:00.01,0:30:02.15,Main-480p,,0,0,0,,Eğer istiyorsanız, almanıza izin vereceğim.Dialogue: 0,0:30:02.15,0:30:07.15,Main-480p,,0,0,0,,Arayın. Hepsini o yerde bıraktım!Dialogue: 0,0:30:41.65,0:30:44.69,Main-480p,,0,0,0,,O her şeyin başlangıcıydı.Dialogue: 0,0:30:46.63,0:30:48.11,Main-480p,,0,0,0,,Hey!Dialogue: 0,0:30:48.11,0:30:51.39,Main-480p,,0,0,0,,Bu yeni arananlar listesi. Görünebilir bir yere as.Dialogue: 0,0:30:52.65,0:30:55.29,Main-480p,,0,0,0,,Kaptan Smoker, efendim! Afedersiniz!Dialogue: 0,0:30:59.41,0:31:00.46,Main-480p,,0,0,0,,Şey...Dialogue: 0,0:31:01.15,0:31:02.67,Main-480p,,0,0,0,,Hasır Şapka,...Dialogue: 0,0:31:03.07,0:31:05.55,Main-480p,,0,0,0,,...o Monkey D. Luffy!Dialogue: 0,0:31:11.61,0:31:12.51,Main-480p,,0,0,0,,İşte...Dialogue: 0,0:31:15.17,0:31:19.79,Main-480p,,0,0,0,,Gelmiş geçmiş en büyük korsanın... öldüğü yer.Dialogue: 0,0:31:21.27,0:31:22.58,Main-480p,,0,0,0,,Başlangıcın yeri.Dialogue: 0,0:30:05.61,0:30:07.15,Secondary-480p,,0,0,0,,İNFAZ EDİN!!Dialogue: 0,0:14:06.48,0:14:09.13,Thoughts-480p,,0,0,0,,Bu baba kız ilişkisi de ne?Dialogue: 0,0:15:59.45,0:16:02.81,Thoughts-480p,,0,0,0,,Onun içine ne girdiyse, bu adam korkutulmuş gibi görünüyor.Dialogue: 0,0:16:02.81,0:16:04.52,Thoughts-480p,,0,0,0,,Durum buysa...Dialogue: 0,0:17:15.38,0:17:19.39,Thoughts-480p,,0,0,0,,Kendimi neye bulaştırdım?Dialogue: 0,0:17:56.37,0:17:58.59,Thoughts-480p,,0,0,0,,Kahretsin... Bu çok kötü...Dialogue: 0,0:17:58.59,0:18:01.68,Thoughts-480p,,0,0,0,,Baba Daddy'i yenebilmem mümkün değil!Dialogue: 0,0:18:04.53,0:18:07.69,Thoughts-480p,,0,0,0,,Bu son mu? Olamaz...Dialogue: 0,0:18:10.11,0:18:12.71,Thoughts-480p,,0,0,0,,Maceralarım daha yeni başladı!Dialogue: 0,0:18:12.71,0:18:16.99,Thoughts-480p,,0,0,0,,Daha yeni bir erkeğin tavrını ve cesaretini kazandım!Dialogue: 0,0:01:50.33,0:01:53.46,Title-480p,,0,0,0,,ParalelliklerDialogue: 0,0:00:01.56,0:00:03.69,Main-480p,,0,0,0,,Zenginlik, Şöhret, Güç.Dialogue: 0,0:00:03.69,0:00:07.86,Main-480p,,0,0,0,,Bu dünyadaki her şeyi elde eden adam, Korsanlar Kralı, Gold Roger.Dialogue: 0,0:00:07.86,0:00:11.74,Main-480p,,0,0,0,,İdamı sırasında söylediği son sözler insanları denize gönderdi.Dialogue: 0,0:00:11.74,0:00:15.53,Main-480p,,0,0,0,,"Hazinem mi?" "Eğer istiyorsanız, almanıza izin vereceğim."Dialogue: 0,0:00:15.53,0:00:19.24,Main-480p,,0,0,0,,"Arayın, hepsini o yerde bıraktım!"Dialogue: 0,0:00:21.54,0:00:26.33,Main-480p,,0,0,0,,Şimdilerde erkekler, Grand Line'a doğru hayallerinin peşinden gidiyorlar.Dialogue: 0,0:00:26.33,0:00:27.84,Main-480p,,0,0,0,,Artık dünya...Dialogue: 0,0:00:27.84,0:00:29.59,Main-480p,,0,0,0,,...Büyük Korsanlar Çağı'na giriyor!Dialogue: 0,0:31:09.00,0:31:19.00,Author,,0,0,0,, Türkçeleştirme  onepacetr.netDialogue: 0,0:15:34.00,0:15:44.00,Author,,0,0,0,, Türkçeleştirme  onepacetr.netDialogue: 0,0:01:50.33,0:02:00.33,Author,,0,0,0,, Türkçeleştirme  onepacetr.net