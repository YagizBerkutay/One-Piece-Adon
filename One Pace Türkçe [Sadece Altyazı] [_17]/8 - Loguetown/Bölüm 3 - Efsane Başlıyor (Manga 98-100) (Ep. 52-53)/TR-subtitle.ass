Dialogue: 0,0:24:10.87,0:24:12.88,Flashbacks-480p,,0,0,0,,Bu katanayı da alacak mısın?
Dialogue: 0,0:25:40.03,0:25:42.67,Flashbacks-480p,,0,0,0,,Zoro, şanslısın? Erkek olduğun için.
Dialogue: 0,0:27:00.93,0:27:02.77,Flashbacks-480p,,0,0,0,,{\i1}Miras kalan istek.{\i0}
Dialogue: 0,0:27:02.77,0:27:05.51,Flashbacks-480p,,0,0,0,,{\i1}Çağın Kaderi ve İnsanlarının Hayalleri.{\i0}
Dialogue: 0,0:27:05.51,0:27:08.68,Flashbacks-480p,,0,0,0,,{\i1}Bunlar durdurulmayacak şeyler.{\i0}
Dialogue: 0,0:27:08.68,0:27:11.73,Flashbacks-480p,,0,0,0,,{\i1}İnsanlar özgürlüğün manasını takip\Netmeye devam ettiği sürece,...{\i0}
Dialogue: 0,0:27:11.73,0:27:14.48,Flashbacks-480p,,0,0,0,,{\i1}...hiçbir şey onları alıp götüremez!{\i0}
Dialogue: 0,0:00:01.56,0:00:03.35,Main-480p,,0,0,0,,Ah, bu çok eğlenceliydi!
Dialogue: 0,0:00:14.23,0:00:15.77,Main-480p,,0,0,0,,Ne oldu, Nami?
Dialogue: 0,0:00:15.77,0:00:17.42,Main-480p,,0,0,0,,Hava değişti.
Dialogue: 0,0:00:17.42,0:00:18.28,Main-480p,,0,0,0,,Hava mı?
Dialogue: 0,0:00:18.28,0:00:19.75,Main-480p,,0,0,0,,Yağmur yağacak.
Dialogue: 0,0:00:19.75,0:00:21.75,Main-480p,,0,0,0,,Ah? Bu kadar güzel bir havada mı?
Dialogue: 0,0:00:21.75,0:00:23.21,Main-480p,,0,0,0,,Eminim.
Dialogue: 0,0:00:24.33,0:00:26.35,Main-480p,,0,0,0,,Hey, platformun tepesine bakın.
Dialogue: 0,0:00:26.35,0:00:27.75,Main-480p,,0,0,0,,O da kim Allah aşkına?
Dialogue: 0,0:00:29.33,0:00:34.88,Main-480p,,0,0,0,,Demek 22 sene önceydi, ha? \NKorsanlar Kralı burada öldü!
Dialogue: 0,0:00:34.88,0:00:35.84,Main-480p,,0,0,0,,Ortaya çıktı mı?
Dialogue: 0,0:00:35.84,0:00:38.62,Main-480p,,0,0,0,,Efendim, aynen tahmin ettiğiniz gibi.
Dialogue: 0,0:00:38.62,0:00:40.31,Main-480p,,0,0,0,,Tarife uyan biri meydanda göründü.
Dialogue: 0,0:00:40.31,0:00:41.60,Main-480p,,0,0,0,,İyi.
Dialogue: 0,0:00:41.60,0:00:43.55,Main-480p,,0,0,0,,Hemen gidiyoruz.
Dialogue: 0,0:00:56.57,0:01:00.95,Main-480p,,0,0,0,,Vohooo! Demek Korsanlar\NKralının gördüğü manzara bu!
Dialogue: 0,0:01:02.08,0:01:03.80,Main-480p,,0,0,0,,Sonra... öldü!
Dialogue: 0,0:01:04.39,0:01:07.94,Main-480p,,0,0,0,,Lütfen bekleyin!\NKaptan Smoker.
Dialogue: 0,0:01:07.94,0:01:09.92,Main-480p,,0,0,0,,Benimle geliyorsun, Tashigi.
Dialogue: 0,0:03:01.35,0:03:06.16,Main-480p,,0,0,0,,HEY, ORADAKİ!
Dialogue: 0,0:03:06.16,0:03:09.59,Main-480p,,0,0,0,,Hemen oradan in!
Dialogue: 0,0:03:09.59,0:03:11.29,Main-480p,,0,0,0,,Niye~?
Dialogue: 0,0:03:11.29,0:03:15.69,Main-480p,,0,0,0,,O, Dünya Hükümeti'nin koruması\Naltında olan tarihi bir işarettir!
Dialogue: 0,0:03:15.69,0:03:17.92,Main-480p,,0,0,0,,Bu yüzden hemen oradan in!
Dialogue: 0,0:03:21.47,0:03:24.69,Main-480p,,0,0,0,,Sıranı beklemen gerekiyor, küçük adam.
Dialogue: 0,0:03:25.68,0:03:29.61,Main-480p,,0,0,0,,Seni özledim, Luffy. Epey zaman oldu.
Dialogue: 0,0:03:32.98,0:03:38.61,Main-480p,,0,0,0,,Bu yüzü unutmuş olmanın mümkün olduğunu söyleme.
Dialogue: 0,0:03:39.07,0:03:40.98,Main-480p,,0,0,0,,Ne güzellik ama!
Dialogue: 0,0:03:40.98,0:03:42.01,Main-480p,,0,0,0,,Çok güzel!
Dialogue: 0,0:03:42.01,0:03:43.85,Main-480p,,0,0,0,,Mükemmelliğin emsalsiz örneği.
Dialogue: 0,0:03:43.85,0:03:46.49,Main-480p,,0,0,0,,İpeksi bir çiçek gibi!
Dialogue: 0,0:03:46.49,0:03:51.29,Main-480p,,0,0,0,,Hiç sana benzeyen biriyle karşılaşmadım. Kimsin sen?
Dialogue: 0,0:03:51.29,0:03:57.01,Main-480p,,0,0,0,,Asla unutmayacağım.\NBana vuran ilk erkek sendin.
Dialogue: 0,0:03:57.01,0:03:59.49,Main-480p,,0,0,0,,Ha? Sana vurdum mu?
Dialogue: 0,0:04:01.88,0:04:05.83,Main-480p,,0,0,0,,O zamanlar, güçlü yumruğun...
Dialogue: 0,0:04:08.85,0:04:10.89,Main-480p,,0,0,0,,Beni etkiledi.
Dialogue: 0,0:04:15.07,0:04:20.53,Main-480p,,0,0,0,,Bir tanelerim, tüm denizlerdeki en güzel kişi kim?
Dialogue: 0,0:04:20.53,0:04:23.53,Main-480p,,0,0,0,,SENSİN BAYAN!!!
Dialogue: 0,0:04:23.53,0:04:25.43,Main-480p,,0,0,0,,Evet, benim.
Dialogue: 0,0:04:25.43,0:04:30.04,Main-480p,,0,0,0,,Bu dünyada, güzelliğim önünde diz\Nçökmeyecek tek bir erkek bile yok.
Dialogue: 0,0:04:30.04,0:04:33.04,Main-480p,,0,0,0,,Ve güçlü erkekleri severim.
Dialogue: 0,0:04:33.93,0:04:37.50,Main-480p,,0,0,0,,Benim olmalısın, Luffy.
Dialogue: 0,0:04:38.05,0:04:40.97,Main-480p,,0,0,0,,Kapa çeneni! Olmaz! Kimsin sen?!
Dialogue: 0,0:04:40.97,0:04:42.42,Main-480p,,0,0,0,,Hala anlamadın mı?!
Dialogue: 0,0:04:43.57,0:04:46.84,Main-480p,,0,0,0,,Polis!\NBayan, sessizce bizimle gelin!
Dialogue: 0,0:04:47.30,0:04:50.73,Main-480p,,0,0,0,,Bir memura açık olarak\Nsaldırmaktan tutuklusunuz!
Dialogue: 0,0:04:51.27,0:04:53.77,Main-480p,,0,0,0,,VE SEN! LANET OLASI PLATFORMDAN İN!
Dialogue: 0,0:04:54.31,0:04:57.02,Main-480p,,0,0,0,,Ah, kimi tutuklayacaksınız?
Dialogue: 0,0:04:57.02,0:05:00.39,Main-480p,,0,0,0,,Müfettiş, yapamam. Çok güzel!
Dialogue: 0,0:05:00.39,0:05:02.69,Main-480p,,0,0,0,,Güzelse ne olmuş?! Tutuklayın onu!
Dialogue: 0,0:05:02.69,0:05:05.91,Main-480p,,0,0,0,,Güzel bir rüya gibi!
Dialogue: 0,0:05:05.91,0:05:07.57,Main-480p,,0,0,0,,ÖYLE HİSSETMENİZE SEVİNDİM!
Dialogue: 0,0:05:09.17,0:05:10.95,Main-480p,,0,0,0,,Özel Buggy Bombası!
Dialogue: 0,0:05:10.95,0:05:11.49,Main-480p,,0,0,0,,Doğruca ona gidiyor!
Dialogue: 0,0:05:15.37,0:05:16.75,Main-480p,,0,0,0,,Ne?
Dialogue: 0,0:05:16.75,0:05:18.33,Main-480p,,0,0,0,,Çeşmenin tepesi üzerinden kayıp geçti!
Dialogue: 0,0:05:18.72,0:05:20.71,Main-480p,,0,0,0,,O da neydi?!
Dialogue: 0,0:05:23.03,0:05:26.17,Main-480p,,0,0,0,,Bu biraz tehlikeli değil miydi, tatlım?
Dialogue: 0,0:05:26.17,0:05:31.32,Main-480p,,0,0,0,,Çok özür dilerim. Ama sube-sube tenin sayesinde hiç yaralanmamışsın.
Dialogue: 0,0:05:31.31,0:05:35.27,Main-480p,,0,0,0,,Endişelenme, güzel Leydi Alvida'm!
Dialogue: 0,0:05:35.85,0:05:37.81,Main-480p,,0,0,0,,Alvida?
Dialogue: 0,0:05:41.19,0:05:42.90,Main-480p,,0,0,0,,Alvida'yı hiçbir yerde görmüyorum.
Dialogue: 0,0:05:42.90,0:05:45.07,Main-480p,,0,0,0,,Elbette o benim, seni sersem!
Dialogue: 0,0:05:45.46,0:05:48.49,Main-480p,,0,0,0,,Şaka yapıyorsun, ona hiç benzemiyorsun.
Dialogue: 0,0:05:50.09,0:05:53.17,Main-480p,,0,0,0,,Şeytan Meyvesi yedikten sonra değiştim.
Dialogue: 0,0:05:53.17,0:05:54.40,Main-480p,,0,0,0,,Adı...
Dialogue: 0,0:05:54.40,0:05:56.66,Main-480p,,0,0,0,,...Sube Sube meyvesiydi.
Dialogue: 0,0:05:54.40,0:05:56.66,Main-480p,,0,0,0,,{\c&H7DE1FF&}{\an8}- Pürüssüz Meyvesi -
Dialogue: 0,0:05:57.77,0:06:02.63,Main-480p,,0,0,0,,{\q2}Nasıl bir saldırıyla karşı karşıya olduğuma \Nbakmaksızın, bedenim bir çizik bile almayacak.
Dialogue: 0,0:06:02.99,0:06:07.42,Main-480p,,0,0,0,,Ancak, sonuç olarak daha da güzel\Nolmadığımı söylediğim için üzgünüm.
Dialogue: 0,0:06:07.90,0:06:12.08,Main-480p,,0,0,0,,Tek farkedilebilir değişiklik, evet çillerim yok oldu.
Dialogue: 0,0:06:12.08,0:06:14.39,Main-480p,,0,0,0,,Uh, düşündüğüm değişiklik bu değildi.
Dialogue: 0,0:06:14.39,0:06:16.15,Main-480p,,0,0,0,,Yeniden doğdum.
Dialogue: 0,0:06:16.15,0:06:20.99,Main-480p,,0,0,0,,Ve seni tekrardan bulmak için, bu beyefendiyle gücümü birleştirdim.
Dialogue: 0,0:06:29.21,0:06:33.74,Main-480p,,0,0,0,,Son gösteri! Süper Gösterişli geri dönüşüm!
Dialogue: 0,0:06:33.74,0:06:35.65,Main-480p,,0,0,0,,Monkey D. Luffy!
Dialogue: 0,0:06:35.65,0:06:38.21,Main-480p,,0,0,0,,Beni havaya\Nuçurduğun günden başlayarak...
Dialogue: 0,0:06:38.21,0:06:40.77,Main-480p,,0,0,0,,...intikam için seni aramaya başladım!
Dialogue: 0,0:06:40.77,0:06:44.39,Main-480p,,0,0,0,,Ama bunu yapmak için, yoldaşlarım\Nve ben birlikte acı çektik.
Dialogue: 0,0:06:44.39,0:06:48.71,Main-480p,,0,0,0,,Gerçekten büyük bir maceraydı!\NKalbi hala zayıf olan benim için,...
Dialogue: 0,0:06:48.71,0:06:51.40,Main-480p,,0,0,0,,...gülünç, berbat, ayrıntılı...
Dialogue: 0,0:06:51.39,0:06:53.81,Main-480p,,0,0,0,,...Küçük Buggy-kun'un Büyük Macerası'ydı!
Dialogue: 0,0:06:53.81,0:06:55.39,Main-480p,,0,0,0,,Ama şimdi Buggy-kun...
Dialogue: 0,0:06:55.39,0:06:57.35,Main-480p,,0,0,0,,LANET OLASI NİYE HİÇBİR ŞEY SÖYLEMİYORSUN?!
Dialogue: 0,0:06:57.77,0:07:00.21,Main-480p,,0,0,0,,Ne? Um, neydi...
Dialogue: 0,0:07:00.21,0:07:03.77,Main-480p,,0,0,0,,...Boggy? Hayır, Buggie?\N Buhii de değil.
Dialogue: 0,0:07:03.77,0:07:06.21,Main-480p,,0,0,0,,Ah, evet! Buffoon.
Dialogue: 0,0:07:09.15,0:07:12.13,Main-480p,,0,0,0,,BUFFOON?! \NDİLİNE DİKKAT ET!
Dialogue: 0,0:07:12.13,0:07:15.33,Main-480p,,0,0,0,,HER ZAMANKİ GİBİ KÜSTAHSIN, SENİ KÜÇÜK PİSLİK!
Dialogue: 0,0:07:15.95,0:07:17.58,Main-480p,,0,0,0,,Bu Palyaço Buggy!
Dialogue: 0,0:07:17.58,0:07:18.95,Main-480p,,0,0,0,,K-Korsan!
Dialogue: 0,0:07:19.29,0:07:23.88,Main-480p,,0,0,0,,BUGGY KORSAN TAYFASI!!
Dialogue: 0,0:07:24.29,0:07:28.21,Main-480p,,0,0,0,,Şehrin iyi insanları!\NAni hareket yapmayın!
Dialogue: 0,0:07:28.21,0:07:34.01,Main-480p,,0,0,0,,Şimdi tüm şiddetimi göstereceğim ve hepiniz seyredeceksiniz.
Dialogue: 0,0:07:35.47,0:07:37.18,Main-480p,,0,0,0,,Anladım! Buggy!
Dialogue: 0,0:07:37.18,0:07:39.73,Main-480p,,0,0,0,,HATIRLAMASI O KADAR UZUN MU SÜRDÜ?!
Dialogue: 0,0:07:41.73,0:07:43.52,Main-480p,,0,0,0,,N-Ne?
Dialogue: 0,0:07:44.05,0:07:49.48,Main-480p,,0,0,0,,Görüşmeyeli epey oldu, Lastik adam.\N Roronoa Zoro da iyi mi?
Dialogue: 0,0:07:49.48,0:07:52.36,Main-480p,,0,0,0,,Tamam. İyi iş, Cabaji.
Dialogue: 0,0:07:55.91,0:08:00.31,Main-480p,,0,0,0,,Seyredin! Dünyanın milyarlarca insanı!
Dialogue: 0,0:08:00.31,0:08:03.83,Main-480p,,0,0,0,,En iyi halka açık infaz başlamak üzere!
Dialogue: 0,0:08:03.83,0:08:09.63,Main-480p,,0,0,0,,Monkey D. Luffy, oradan çıkamayacaksın.
Dialogue: 0,0:08:09.63,0:08:11.01,Main-480p,,0,0,0,,Onur duymalısın, Hasır Şapka!
Dialogue: 0,0:08:11.48,0:08:15.05,Main-480p,,0,0,0,,Korsanlar Kralı ile aynı yerde öleceksin!
Dialogue: 0,0:08:27.23,0:08:30.23,Main-480p,,0,0,0,,Basınç düşüyor.
Dialogue: 0,0:08:30.23,0:08:32.69,Main-480p,,0,0,0,,Ama bu kadar hızlı düştüğünü hiç görmemiştim.
Dialogue: 0,0:08:32.69,0:08:35.45,Main-480p,,0,0,0,,Evet, bu sıradışı bir rüzgar.
Dialogue: 0,0:08:36.33,0:08:38.61,Main-480p,,0,0,0,,Fırtına geliyor. Bu adaya!
Dialogue: 0,0:08:38.61,0:08:40.20,Main-480p,,0,0,0,,Fırtına?
Dialogue: 0,0:08:40.20,0:08:43.11,Main-480p,,0,0,0,,En kısa sürede gemiye dönmeliyiz.
Dialogue: 0,0:08:43.11,0:08:44.64,Main-480p,,0,0,0,,Ne kadar büyük olacak?
Dialogue: 0,0:08:44.64,0:08:45.29,Main-480p,,0,0,0,,Hey!
Dialogue: 0,0:08:45.67,0:08:47.01,Main-480p,,0,0,0,,Zoro!
Dialogue: 0,0:08:47.01,0:08:48.96,Main-480p,,0,0,0,,Onu gördünüz mü?
Dialogue: 0,0:08:48.96,0:08:50.21,Main-480p,,0,0,0,,Luffy'yi mi kastediyorsun?
Dialogue: 0,0:08:51.91,0:08:54.88,Main-480p,,0,0,0,,Korsanlar!
Dialogue: 0,0:08:55.33,0:08:56.52,Main-480p,,0,0,0,,Korsanlar burada!
Dialogue: 0,0:08:56.52,0:08:57.16,Main-480p,,0,0,0,,KAÇIN!!
Dialogue: 0,0:08:57.16,0:08:59.01,Main-480p,,0,0,0,,Palyaço Buggy!!
Dialogue: 0,0:08:59.01,0:09:00.41,Main-480p,,0,0,0,,Ne dediler?!
Dialogue: 0,0:09:00.41,0:09:01.97,Main-480p,,0,0,0,,Palyaço Buggy!
Dialogue: 0,0:09:07.27,0:09:09.05,Main-480p,,0,0,0,,Ne? Demek istediğin...
Dialogue: 0,0:09:09.06,0:09:10.19,Main-480p,,0,0,0,,D-Doğru.
Dialogue: 0,0:09:10.19,0:09:15.01,Main-480p,,0,0,0,,Hasır Şapkalı Luffy'e ek olarak, Palyaço\NBuggy ve Demir Sopalı Alvida da burada.
Dialogue: 0,0:09:15.01,0:09:20.39,Main-480p,,0,0,0,,Onlar East Blue'nun, Şeytan Meyvesi\Ngüçlerine sahip korsan kaptanları.
Dialogue: 0,0:09:21.45,0:09:23.61,Main-480p,,0,0,0,,Burada, burnumun dibinde...
Dialogue: 0,0:09:24.81,0:09:26.54,Main-480p,,0,0,0,,Yüzsüz ahmaklar.
Dialogue: 0,0:09:27.08,0:09:29.42,Main-480p,,0,0,0,,Emriniz nedir, Kaptan Smoker?
Dialogue: 0,0:09:30.69,0:09:32.91,Main-480p,,0,0,0,,Birinci birime limana gitmesini emredin.
Dialogue: 0,0:09:32.91,0:09:35.75,Main-480p,,0,0,0,,İkinci birim meydanı sokaklardan sarsın.
Dialogue: 0,0:09:35.75,0:09:38.59,Main-480p,,0,0,0,,Kalanlar meydana belirli bir\Nuzaklıkta beklemede kalsın.
Dialogue: 0,0:09:39.23,0:09:39.97,Main-480p,,0,0,0,,Hepsi bu!
Dialogue: 0,0:09:39.97,0:09:40.85,Main-480p,,0,0,0,,Evet, efendim!
Dialogue: 0,0:09:41.87,0:09:43.62,Main-480p,,0,0,0,,Birinci birime emir ver.
Dialogue: 0,0:09:44.57,0:09:47.80,Main-480p,,0,0,0,,Korsan gemilerini bulup yok etsinler!
Dialogue: 0,0:09:47.80,0:09:53.40,Main-480p,,0,0,0,,O hayvanlardan birinin bile adayı\Nterketmesine izin vermeyin.
Dialogue: 0,0:09:59.43,0:10:00.26,Main-480p,,0,0,0,,İnfaz!
Dialogue: 0,0:10:00.26,0:10:01.52,Main-480p,,0,0,0,,Birini infaz ediyorlar!
Dialogue: 0,0:10:01.52,0:10:04.87,Main-480p,,0,0,0,,Palyaço Buggy, Hasır Şapka Luffy'i infaz edecek!
Dialogue: 0,0:10:04.87,0:10:06.99,Main-480p,,0,0,0,,LUFFY'Yİ İNFAZ MI EDECEK?!
Dialogue: 0,0:10:06.99,0:10:08.47,Main-480p,,0,0,0,,Aptal!
Dialogue: 0,0:10:08.47,0:10:09.43,Main-480p,,0,0,0,,Gidelim!
Dialogue: 0,0:10:09.43,0:10:10.81,Main-480p,,0,0,0,,Bunu benim için tut!
Dialogue: 0,0:10:13.67,0:10:14.92,Main-480p,,0,0,0,,H-H-H-Hey, S-S-S-Sanji!!
Dialogue: 0,0:10:14.92,0:10:17.01,Main-480p,,0,0,0,,Ona bir hanım gibi davran! Anladın mı?
Dialogue: 0,0:10:18.03,0:10:19.74,Main-480p,,0,0,0,,Biz de acele etmeliyiz!
Dialogue: 0,0:10:19.74,0:10:21.97,Main-480p,,0,0,0,,H-Hey N-N-Nami, nereye gidiyoruz?
Dialogue: 0,0:10:21.97,0:10:23.84,Main-480p,,0,0,0,,Elbette limana!
Dialogue: 0,0:10:23.84,0:10:26.37,Main-480p,,0,0,0,,Liman? A-Ah, evet!
Dialogue: 0,0:10:28.81,0:10:30.35,Main-480p,,0,0,0,,Kaptan Smoker, lütfen gelip şuna bakın.
Dialogue: 0,0:10:30.35,0:10:32.37,Main-480p,,0,0,0,,Tuhaf bir şey oluyor.
Dialogue: 0,0:10:33.98,0:10:35.94,Main-480p,,0,0,0,,Çocuk?
Dialogue: 0,0:10:36.89,0:10:38.15,Main-480p,,0,0,0,,Neler oluyor?
Dialogue: 0,0:10:38.60,0:10:44.07,Main-480p,,0,0,0,,Monkey D. Luffy. \NAma, öldürülecek gibi görünüyor!
Dialogue: 0,0:10:44.07,0:10:46.11,Main-480p,,0,0,0,,Kaptan, saldırıyı başlatalım mı?
Dialogue: 0,0:10:46.11,0:10:47.54,Main-480p,,0,0,0,,Hayır, karmaşa oluşturur.
Dialogue: 0,0:10:48.03,0:10:51.23,Main-480p,,0,0,0,,Korsanlar korsanları temizliyor,\Nbu tam da bizim istediğimiz gibi.
Dialogue: 0,0:10:51.23,0:10:53.79,Main-480p,,0,0,0,,Bir şey yapmamıza gerek yok.
Dialogue: 0,0:10:55.05,0:10:57.88,Main-480p,,0,0,0,,Dinleyin! Hasır Şapka'nın başı kesildiği zaman...
Dialogue: 0,0:10:57.88,0:11:01.26,Main-480p,,0,0,0,,...Buggy'i, Alvida'yı ve tayfasının kalanını sarın!
Dialogue: 0,0:11:01.26,0:11:02.34,Main-480p,,0,0,0,,Sorusu olan?
Dialogue: 0,0:11:06.63,0:11:10.81,Main-480p,,0,0,0,,Korsan Monkey D. Luffy,...
Dialogue: 0,0:11:10.81,0:11:13.68,Main-480p,,0,0,0,,...talihsizliğime güldüğün\Nve beni kızdırdığın için, seni...
Dialogue: 0,0:11:13.70,0:11:15.19,Main-480p,,0,0,0,,ÖLÜME MAHKUM EDİYORUM!!
Dialogue: 0,0:11:18.41,0:11:20.24,Main-480p,,0,0,0,,Sevinin adamlarım!
Dialogue: 0,0:11:23.65,0:11:25.87,Main-480p,,0,0,0,,Ah, ilk kez bir infaz göreceğim!
Dialogue: 0,0:11:25.87,0:11:28.25,Main-480p,,0,0,0,,Bu infaz senin.
Dialogue: 0,0:11:29.81,0:11:31.74,Main-480p,,0,0,0,,NE?! ŞAKA YAPIYORSUN!
Dialogue: 0,0:11:31.74,0:11:33.38,Main-480p,,0,0,0,,ŞAKA YAPAN SENSİN!
Dialogue: 0,0:11:34.17,0:11:36.09,Main-480p,,0,0,0,,Ve şimdi, asıl gösterimiz...
Dialogue: 0,0:11:36.09,0:11:40.35,Main-480p,,0,0,0,,Gösterişli infaz başlayacak.
Dialogue: 0,0:11:40.35,0:11:45.35,Main-480p,,0,0,0,,Ahhh!! Dur yapma!\N HAAAYIIIIIIIR!!
Dialogue: 0,0:11:46.11,0:11:48.81,Main-480p,,0,0,0,,Doğuda gökyüzünde, bazı\Nbüyük nimbus bulutları gördüm!
Dialogue: 0,0:11:48.81,0:11:53.69,Main-480p,,0,0,0,,Fırtına geliyor!\NÖncekilerden çok daha büyük bir fırtına!
Dialogue: 0,0:11:54.47,0:11:58.61,Main-480p,,0,0,0,,Buggy ve Luffy kargaşa çıkarırsa,\NDenizciler ortaya çıkacak!
Dialogue: 0,0:11:58.61,0:12:02.26,Main-480p,,0,0,0,,Kaçmamız gerektiğinde gemi\Nsürüklenip gitmiş olursa ne yapacağız?!
Dialogue: 0,0:12:02.26,0:12:03.53,Main-480p,,0,0,0,,Şimdi anladım. Bu çok önemli!
Dialogue: 0,0:12:04.11,0:12:07.53,Main-480p,,0,0,0,,Dahası, Denizciler çoktan harekete geçmiş olabilir.
Dialogue: 0,0:12:08.08,0:12:10.73,Main-480p,,0,0,0,,Going Merry tehlikede!
Dialogue: 0,0:12:11.63,0:12:14.92,Main-480p,,0,0,0,,Denizciler Going Merry'e el koyarsa,...
Dialogue: 0,0:12:16.23,0:12:18.75,Main-480p,,0,0,0,,Hey Nami, acele et!
Dialogue: 0,0:12:18.75,0:12:20.47,Main-480p,,0,0,0,,Hey, bekle!
Dialogue: 0,0:12:21.59,0:12:23.63,Main-480p,,0,0,0,,Çabuk limana!
Dialogue: 0,0:12:24.02,0:12:28.04,Main-480p,,0,0,0,,Richie Motor'u sürüyor~
Dialogue: 0,0:12:28.04,0:12:33.44,Main-480p,,0,0,0,,Bu kim olabilir~?\NKim? Kim? Kim~?
Dialogue: 0,0:12:34.18,0:12:36.23,Main-480p,,0,0,0,,Ben~!
Dialogue: 0,0:12:36.63,0:12:39.53,Main-480p,,0,0,0,,Demek bu lastik adamın gemisi, ha?
Dialogue: 0,0:12:42.55,0:12:45.11,Main-480p,,0,0,0,,Geçen seferkinden daha büyük.
Dialogue: 0,0:12:45.11,0:12:49.77,Main-480p,,0,0,0,,Büyük ihtimalle şimdi, Kaptan Buggy'nin\N{\q2}"Gösterişli Ölüm Mahkumiyeti" deneyimini yaşıyor.
Dialogue: 0,0:12:51.11,0:12:54.70,Main-480p,,0,0,0,,Ancak! On binde bir kaçma\Nşansı olan lastik adam...
Dialogue: 0,0:12:54.70,0:12:57.18,Main-480p,,0,0,0,,...bir şekilde o şansı \Nelde eder ve kaçar diye,...
Dialogue: 0,0:12:57.21,0:12:58.70,Main-480p,,0,0,0,,...birisi onun gemisini yakmalı!
Dialogue: 0,0:12:58.73,0:13:01.25,Main-480p,,0,0,0,,~Ve bu bizim görevimiz~!
Dialogue: 0,0:13:06.05,0:13:10.40,Main-480p,,0,0,0,,Üzgünüm. Bir daha yapmayacağım.\NLütfen beni bağışlayın.
Dialogue: 0,0:13:10.40,0:13:11.77,Main-480p,,0,0,0,,SENİ KURTARMIYORUM, AHMAK!!
Dialogue: 0,0:13:13.07,0:13:15.62,Main-480p,,0,0,0,,Bizi düşman edindiğin için, ödeyeceğin bedel bu.
Dialogue: 0,0:13:15.62,0:13:19.19,Main-480p,,0,0,0,,Demek bu, uzun süredir aradığım adamın sonu.
Dialogue: 0,0:13:19.53,0:13:22.19,Main-480p,,0,0,0,,Son bir sözün var mı?
Dialogue: 0,0:13:22.19,0:13:25.65,Main-480p,,0,0,0,,Burada epey bir kalabalık var.
Dialogue: 0,0:13:27.43,0:13:31.62,Main-480p,,0,0,0,,Evet, evet, görünüşe göre dilin tutuldu.
Dialogue: 0,0:13:31.64,0:13:34.33,Main-480p,,0,0,0,,Sonuçta ölmek üzeresin!
Dialogue: 0,0:13:36.46,0:13:40.39,Main-480p,,0,0,0,,BEN, KORSANLAR KRALI OLACAK ADAMIM!
Dialogue: 0,0:13:47.73,0:13:49.05,Main-480p,,0,0,0,,Ne...
Dialogue: 0,0:13:49.05,0:13:52.01,Main-480p,,0,0,0,,K-Korsanlar Kralı mı dedi?
Dialogue: 0,0:13:52.39,0:13:54.65,Main-480p,,0,0,0,,Onca yer içerisinde bu şehirde...
Dialogue: 0,0:13:54.65,0:13:57.02,Main-480p,,0,0,0,,Ne cesur bir beyanat.
Dialogue: 0,0:13:57.02,0:14:00.90,Main-480p,,0,0,0,,Buna bir son verme vakti, öyle değil mi?\NKahrolası lastik çocuk.
Dialogue: 0,0:14:04.71,0:14:06.24,Main-480p,,0,0,0,,BU İNFAZ...
Dialogue: 0,0:14:06.82,0:14:08.41,Main-480p,,0,0,0,,...İPTAL EDİLDİ!
Dialogue: 0,0:14:12.33,0:14:14.16,Main-480p,,0,0,0,,Zoro! Sanji!
Dialogue: 0,0:14:15.39,0:14:19.05,Main-480p,,0,0,0,,K-Korsan Avcısı... Z-Zoro!
Dialogue: 0,0:14:19.96,0:14:20.96,Main-480p,,0,0,0,,Zoro?!
Dialogue: 0,0:14:22.38,0:14:26.88,Main-480p,,0,0,0,,Sonunda geldin, Zoro?\NÇok yazık, biraz fazla geç kaldın!
Dialogue: 0,0:14:27.63,0:14:28.76,Main-480p,,0,0,0,,İnfaz platformu!
Dialogue: 0,0:14:28.76,0:14:29.69,Main-480p,,0,0,0,,Yok et!
Dialogue: 0,0:14:30.75,0:14:32.35,Main-480p,,0,0,0,,Roronoa Zoro...
Dialogue: 0,0:14:34.95,0:14:36.89,Main-480p,,0,0,0,,Lütfen yapın, canlarım!
Dialogue: 0,0:14:36.89,0:14:38.85,Main-480p,,0,0,0,,Yapacağız,...
Dialogue: 0,0:14:38.85,0:14:40.81,Main-480p,,0,0,0,,...Alvida-neesan!
Dialogue: 0,0:14:45.03,0:14:45.86,Main-480p,,0,0,0,,Çekilin!
Dialogue: 0,0:14:54.15,0:14:57.04,Main-480p,,0,0,0,,İstediğinizi deneyin, şimdi beni durduramazsınız!
Dialogue: 0,0:14:57.04,0:15:01.37,Main-480p,,0,0,0,,Kaptanınızın sonu geldi!
Dialogue: 0,0:15:01.37,0:15:03.05,Main-480p,,0,0,0,,Lanet olası pislik...!
Dialogue: 0,0:15:10.09,0:15:11.01,Main-480p,,0,0,0,,Unutmayın,...
Dialogue: 0,0:15:11.01,0:15:14.73,Main-480p,,0,0,0,,...Monkey D. Luffy'nin kafası\Nuçtuğu zaman, tam güç saldıracağız.
Dialogue: 0,0:15:17.35,0:15:19.14,Main-480p,,0,0,0,,Tüm birimler, beklemede kalın.
Dialogue: 0,0:15:19.14,0:15:20.41,Main-480p,,0,0,0,,Tamam, efendim!
Dialogue: 0,0:15:22.61,0:15:24.11,Main-480p,,0,0,0,,Zoro! Sanji!
Dialogue: 0,0:15:24.11,0:15:26.52,Main-480p,,0,0,0,,Usopp! Nami!
Dialogue: 0,0:15:27.61,0:15:31.78,Main-480p,,0,0,0,,Üzgünüm. Ben ÖLÜYORUM.
Dialogue: 0,0:15:33.51,0:15:34.29,Main-480p,,0,0,0,,Apt...
Dialogue: 0,0:15:35.41,0:15:37.30,Main-480p,,0,0,0,,Bunu söyleme, pislik!
Dialogue: 0,0:15:37.30,0:15:38.59,Main-480p,,0,0,0,,Gülüyor!
Dialogue: 0,0:16:27.21,0:16:29.05,Main-480p,,0,0,0,,Hey, yaşıyorum!
Dialogue: 0,0:16:29.63,0:16:31.05,Main-480p,,0,0,0,,İyiyim!
Dialogue: 0,0:16:36.51,0:16:37.35,Main-480p,,0,0,0,,H-Hey!
Dialogue: 0,0:16:37.35,0:16:39.43,Main-480p,,0,0,0,,Tanrı'ya inanır mısın?
Dialogue: 0,0:16:39.43,0:16:40.64,Main-480p,,0,0,0,,Bunu soracak zaman değil.
Dialogue: 0,0:16:40.64,0:16:42.49,Main-480p,,0,0,0,,Bu şehri terkediyoruz.
Dialogue: 0,0:16:43.05,0:16:45.11,Main-480p,,0,0,0,,Görünüşe göre tehlike henüz bitmedi.
Dialogue: 0,0:16:50.13,0:16:52.74,Main-480p,,0,0,0,,Şimdi! Korsanları sarın!
Dialogue: 0,0:16:56.65,0:16:57.78,Main-480p,,0,0,0,,Denizciler?!
Dialogue: 0,0:17:03.91,0:17:08.29,Main-480p,,0,0,0,,Müthiş! Ne büyük bir dövüş!
Dialogue: 0,0:17:08.29,0:17:10.75,Main-480p,,0,0,0,,Harika! Çok harika!
Dialogue: 0,0:17:10.75,0:17:11.54,Main-480p,,0,0,0,,Hey, Luffy!
Dialogue: 0,0:17:11.54,0:17:13.39,Main-480p,,0,0,0,,Oh, Zoro!
Dialogue: 0,0:17:13.39,0:17:15.84,Main-480p,,0,0,0,,Seyredecek zaman değil! Gidiyoruz!
Dialogue: 0,0:17:16.19,0:17:20.06,Main-480p,,0,0,0,,Gemiye zamanında dönmezsek,\Nbu adayı terkedemeyeceğiz!
Dialogue: 0,0:17:20.45,0:17:22.35,Main-480p,,0,0,0,,O zaman da Grand Line'a gidemeyiz!
Dialogue: 0,0:17:22.35,0:17:24.35,Main-480p,,0,0,0,,Ne?! Öyleyse gitsek iyi olur!
Dialogue: 0,0:17:26.10,0:17:27.94,Main-480p,,0,0,0,,Hasır Şapka Tayfası geri çekiliyor!
Dialogue: 0,0:17:28.29,0:17:29.52,Main-480p,,0,0,0,,Durdurun onları!
Dialogue: 0,0:17:29.52,0:17:30.86,Main-480p,,0,0,0,,Peşlerinden gidin!
Dialogue: 0,0:17:52.13,0:17:54.27,Main-480p,,0,0,0,,Kaptan. O korsanları yakalamakla ilgili olarak...
Dialogue: 0,0:17:54.27,0:18:00.35,Main-480p,,0,0,0,,Hey, sen. Hiç infaz platformunda\Ngülen bir korsan gördün mü?
Dialogue: 0,0:18:02.71,0:18:05.71,Main-480p,,0,0,0,,H-Hiç görmedim. En büyük blöfçüler bile...
Dialogue: 0,0:18:05.71,0:18:09.10,Main-480p,,0,0,0,,...ölmeden önce korkuyla solarlar.
Dialogue: 0,0:18:09.10,0:18:12.86,Main-480p,,0,0,0,,Hasır Şapkalı adam gülüyordu.
Dialogue: 0,0:18:13.65,0:18:20.32,Main-480p,,0,0,0,,22 yıl önce bu şehirde. Kendi infazı sırasında, Korsanlar Kralı...
Dialogue: 0,0:18:20.32,0:18:23.66,Main-480p,,0,0,0,,...Gold Roger da aynı şekilde gülüyordu.
Dialogue: 0,0:18:32.71,0:18:33.73,Main-480p,,0,0,0,,Kaptan.
Dialogue: 0,0:18:34.95,0:18:36.63,Main-480p,,0,0,0,,Hasır Şapka nerede?
Dialogue: 0,0:18:36.63,0:18:40.45,Main-480p,,0,0,0,,Şu anda limana doğru çekiliyorlar.
Dialogue: 0,0:18:40.45,0:18:45.05,Main-480p,,0,0,0,,Ya birinci birim? Şimdiye dek gemileri yok etmiş olmalılar.
Dialogue: 0,0:18:45.87,0:18:49.73,Main-480p,,0,0,0,,Verdikleri rapora göre: ani yağmur yüzünden...
Dialogue: 0,0:18:49.73,0:18:52.35,Main-480p,,0,0,0,,...barutları mahvolmuş. Yeni\Nmalzeme için geri dönüyorlar.
Dialogue: 0,0:18:52.35,0:18:53.94,Main-480p,,0,0,0,,Ne dedin?
Dialogue: 0,0:18:53.94,0:18:58.27,Main-480p,,0,0,0,,{\q2}Destek olarak, imha emrinizi gerçekleştirmek \Niçin, kıyı şeridi güvenlik birimimiz var.
Dialogue: 0,0:18:58.27,0:19:03.62,Main-480p,,0,0,0,,Kaptan Smoker, denize açılırlarsa Grand Line'a ulaşabilecekler!
Dialogue: 0,0:19:04.85,0:19:09.65,Main-480p,,0,0,0,,Rüzgar batıdan esiyor. Arkalarından esecek mükemmel bir rüzgara sahipler.
Dialogue: 0,0:19:11.37,0:19:13.91,Main-480p,,0,0,0,,Hepsi bir tesadüf olabilir mi?
Dialogue: 0,0:19:15.73,0:19:19.63,Main-480p,,0,0,0,,Gökyüzünün kendisi o adamı hayatta tutuyor gibi.
Dialogue: 0,0:19:20.95,0:19:22.28,Main-480p,,0,0,0,,Acele edelim!
Dialogue: 0,0:19:22.26,0:19:23.97,Main-480p,,0,0,0,,Buradan çıkmalıyız!
Dialogue: 0,0:19:24.39,0:19:26.43,Main-480p,,0,0,0,,Ben, Beyaz Avcı Smoker...
Dialogue: 0,0:19:26.51,0:19:29.35,Main-480p,,0,0,0,,...Denizci Karargahının kaptanı\Nolarak yemin ederim ki,..
Dialogue: 0,0:19:29.35,0:19:31.19,Main-480p,,0,0,0,,...o adam bu adayı terkedemeyecek!
Dialogue: 0,0:19:37.39,0:19:39.61,Main-480p,,0,0,0,,Bu ne tür bir fırtına?
Dialogue: 0,0:19:39.63,0:19:42.53,Main-480p,,0,0,0,,Acele etmezsek, adadan ayrılamayacağız.
Dialogue: 0,0:19:42.53,0:19:45.20,Main-480p,,0,0,0,,Nami-san en kısa sürede gemiye\Ndönün dediğinde, şaka yapmıyordu!
Dialogue: 0,0:19:47.85,0:19:50.54,Main-480p,,0,0,0,,Bana saldırmaya çalışmak faydasız.
Dialogue: 0,0:19:50.54,0:19:55.04,Main-480p,,0,0,0,,Bu dünyada, Sube Sube tenime\Ndokunabilecek tek bir erkek bile yok.
Dialogue: 0,0:19:58.91,0:20:01.46,Main-480p,,0,0,0,,Çiçek tarlası gördüğümü sandım.
Dialogue: 0,0:20:01.46,0:20:03.87,Main-480p,,0,0,0,,Kaptan Buggy, hayattasınız!
Dialogue: 0,0:20:03.87,0:20:04.80,Main-480p,,0,0,0,,Nasıl ölebilirim?!
Dialogue: 0,0:20:05.12,0:20:06.53,Main-480p,,0,0,0,,Buggy, bu çok kötü.
Dialogue: 0,0:20:06.53,0:20:08.60,Main-480p,,0,0,0,,Bunlar Karargahtan gelen Denizciler,\Nsürekli yenileri gelecek!
Dialogue: 0,0:20:08.60,0:20:11.49,Main-480p,,0,0,0,,Bu Denizciler başından beri bizim dengimiz değildi.
Dialogue: 0,0:20:11.49,0:20:13.56,Main-480p,,0,0,0,,KİMİN BURNU YÜKSEK YAKA?!
Dialogue: 0,0:20:13.56,0:20:15.53,Main-480p,,0,0,0,,Ama ben bir şey demedim!
Dialogue: 0,0:20:18.32,0:20:20.00,Main-480p,,0,0,0,,Ne yapacağız?
Dialogue: 0,0:20:20.00,0:20:22.39,Main-480p,,0,0,0,,Gomu Gomu! Gomu Gomu'yu izleyin!
Dialogue: 0,0:20:22.39,0:20:25.27,Main-480p,,0,0,0,,Mohji ve Richie onların gemisini\Nşimdiye dek küle dönüştürmüş olmalı.
Dialogue: 0,0:20:25.27,0:20:27.23,Main-480p,,0,0,0,,Bu adadan ayrılamazlar!
Dialogue: 0,0:20:27.23,0:20:30.06,Main-480p,,0,0,0,,MAHVEDİN ONLARI! GİDİYORUZ BEYLER!
Dialogue: 0,0:20:30.06,0:20:31.31,Main-480p,,0,0,0,,EVET!!
Dialogue: 0,0:20:31.31,0:20:32.54,Main-480p,,0,0,0,,Motor!!
Dialogue: 0,0:20:32.54,0:20:34.42,Main-480p,,0,0,0,,Tamam, Kaptan!
Dialogue: 0,0:20:34.74,0:20:36.68,Main-480p,,0,0,0,,{\fad(150,150)}BARA BARA ARABA!
Dialogue: 0,0:20:36.67,0:20:37.38,Main-480p,,0,0,0,,Gidelim!
Dialogue: 0,0:20:37.75,0:20:39.67,Main-480p,,0,0,0,,Patlayıcı Motor, Ateş!
Dialogue: 0,0:20:42.30,0:20:44.26,Main-480p,,0,0,0,,Gelaende'yi hazırlayın!
Dialogue: 0,0:20:44.26,0:20:46.37,Main-480p,,0,0,0,,Tamam, Alvida-neesan!
Dialogue: 0,0:20:46.37,0:20:47.80,Main-480p,,0,0,0,,{\fad(150,150)}Sıfır sürtünme!
Dialogue: 0,0:20:50.41,0:20:52.64,Main-480p,,0,0,0,,{\fad(150,150)}Sube sube spur!
Dialogue: 0,0:20:58.52,0:21:00.90,Main-480p,,0,0,0,,Korsanların kaçmasına izin vermeyin!
Dialogue: 0,0:21:06.83,0:21:08.78,Main-480p,,0,0,0,,B-Bu duman da ne?!
Dialogue: 0,0:21:10.85,0:21:13.37,Main-480p,,0,0,0,,Neler oluyor?
Dialogue: 0,0:21:13.37,0:21:15.17,Main-480p,,0,0,0,,{\fad(150,150)}BEYAZ ÇIKIŞ!
Dialogue: 0,0:21:19.47,0:21:21.79,Main-480p,,0,0,0,,S-Smoker!
Dialogue: 0,0:21:21.79,0:21:25.63,Main-480p,,0,0,0,,Sizi zavallı pısırıklar!
Dialogue: 0,0:21:26.02,0:21:27.28,Main-480p,,0,0,0,,İnanılmaz!
Dialogue: 0,0:21:27.28,0:21:29.19,Main-480p,,0,0,0,,Bu Moku Moku Meyvesi'nin gücü.
Dialogue: 0,0:21:29.19,0:21:31.69,Main-480p,,0,0,0,,O şekilde bütün Buggy tayfasını sardı.
Dialogue: 0,0:21:33.37,0:21:34.39,Main-480p,,0,0,0,,Ateş!
Dialogue: 0,0:21:40.73,0:21:43.10,Main-480p,,0,0,0,,Kaptan, hepimiz yakalandık!
Dialogue: 0,0:21:43.10,0:21:45.10,Main-480p,,0,0,0,,Lanet olası, Smoker!
Dialogue: 0,0:21:45.10,0:21:49.24,Main-480p,,0,0,0,,Bu metal ağ neyden yapılmış?\NO tuhaf silahlardan ateşlediler.
Dialogue: 0,0:21:49.24,0:21:51.38,Main-480p,,0,0,0,,Bu, Denizciler tarafından özel olarak geliştirilen...
Dialogue: 0,0:21:51.40,0:21:53.77,Main-480p,,0,0,0,,...ve Şeytan Meyvesi güçlerini engelleyen bir hapishane.
Dialogue: 0,0:21:53.77,0:21:54.70,Main-480p,,0,0,0,,Kahretsin.
Dialogue: 0,0:21:55.85,0:21:59.21,Main-480p,,0,0,0,,Duman Motorumu getirin.\NHasır Şapka'nın peşinden gidiyorum.
Dialogue: 0,0:21:59.21,0:22:00.21,Main-480p,,0,0,0,,Tabii!
Dialogue: 0,0:22:02.61,0:22:06.46,Main-480p,,0,0,0,,Kahretsin! Bu yağmur da nereden çıktı aniden?
Dialogue: 0,0:22:06.46,0:22:10.11,Main-480p,,0,0,0,,Gemiyi bu şekilde nasıl yakabilirim?!
Dialogue: 0,0:22:12.18,0:22:16.03,Main-480p,,0,0,0,,Kahretsin! Bu çok kötü Richie, gemiyi ateşe veremeyeceğiz!
Dialogue: 0,0:22:16.03,0:22:17.21,Main-480p,,0,0,0,,Bir deneme daha!
Dialogue: 0,0:22:20.17,0:22:23.48,Main-480p,,0,0,0,,Kes şunu, Richie! Seni sonra besleyeceğim.
Dialogue: 0,0:22:25.25,0:22:27.09,Main-480p,,0,0,0,,Ne yapıyorsunuz?!
Dialogue: 0,0:22:27.70,0:22:29.28,Main-480p,,0,0,0,,Mohji!
Dialogue: 0,0:22:30.69,0:22:32.99,Main-480p,,0,0,0,,Görünüşe göre lezzetli bir şey geldi.
Dialogue: 0,0:22:33.71,0:22:36.29,Main-480p,,0,0,0,,Yakala onları, Richie!
Dialogue: 0,0:22:42.25,0:22:44.67,Main-480p,,0,0,0,,{\fad(150,150)}Kesin öldürücü, taze yumurta yıldızı!
Dialogue: 0,0:22:51.35,0:22:52.71,Main-480p,,0,0,0,,Bu da neydi!
Dialogue: 0,0:22:52.71,0:22:54.60,Main-480p,,0,0,0,,Kahretsin, yağmur yüzünden elim kaydı!
Dialogue: 0,0:22:57.09,0:23:01.23,Main-480p,,0,0,0,,Richie!! Seni aptal aslan!
Dialogue: 0,0:23:01.86,0:23:03.40,Main-480p,,0,0,0,,Şimdi! Gemiye gidelim!
Dialogue: 0,0:23:04.15,0:23:07.11,Main-480p,,0,0,0,,Durun! Hala ben varım!
Dialogue: 0,0:23:08.07,0:23:10.86,Main-480p,,0,0,0,,Buggy Korsan Tayfası'nın yardımcı kaptanı olarak ben, Mohji-sama,...
Dialogue: 0,0:23:10.86,0:23:13.97,Main-480p,,0,0,0,,...gemiye bir adım bile atmanıza izin vermeyeceğim!
Dialogue: 0,0:23:15.74,0:23:17.66,Main-480p,,0,0,0,,Atış birimi, pozisyon al!
Dialogue: 0,0:23:18.36,0:23:19.37,Main-480p,,0,0,0,,Denizciler!
Dialogue: 0,0:23:19.37,0:23:20.42,Main-480p,,0,0,0,,Kahretsin!
Dialogue: 0,0:23:20.77,0:23:21.89,Main-480p,,0,0,0,,Nişan al!
Dialogue: 0,0:23:23.91,0:23:25.41,Main-480p,,0,0,0,,Ateş!
Dialogue: 0,0:23:29.89,0:23:33.17,Main-480p,,0,0,0,,Topçu tugayına bir mesaj iletin.\NKorsan gemisine el koysun!
Dialogue: 0,0:23:33.72,0:23:35.03,Main-480p,,0,0,0,,N-N-N-Nami!
Dialogue: 0,0:23:47.91,0:23:49.65,Main-480p,,0,0,0,,Hangi taraf lanet limana gidiyor?!
Dialogue: 0,0:23:49.65,0:23:53.11,Main-480p,,0,0,0,,Çok yağmur yağdığı için, hangi\Nyön olduğunu söyleyemem!
Dialogue: 0,0:23:53.11,0:23:54.63,Main-480p,,0,0,0,,İşte oradalar!
Dialogue: 0,0:23:56.33,0:23:59.25,Main-480p,,0,0,0,,Kahretsin, çok inatçılar.\NDurup onlarla dövüşmek ister misin?
Dialogue: 0,0:23:59.25,0:24:00.25,Main-480p,,0,0,0,,Hayır, hiç vakit yok.
Dialogue: 0,0:24:02.50,0:24:04.92,Main-480p,,0,0,0,,O BAYAN DA KİM?
Dialogue: 0,0:24:06.89,0:24:10.26,Main-480p,,0,0,0,,Demek sen Roronoa Zoro'sun, bir korsan.
Dialogue: 0,0:24:14.55,0:24:18.51,Main-480p,,0,0,0,,Bana... Bana yalan söyledin!
Dialogue: 0,0:24:18.51,0:24:22.02,Main-480p,,0,0,0,,NE?! ONA NE YAPTIN?!
Dialogue: 0,0:24:22.02,0:24:24.73,Main-480p,,0,0,0,,Adımı hiç sormadın, hepsi bu.
Dialogue: 0,0:24:25.04,0:24:26.75,Main-480p,,0,0,0,,Sana yalan söylemedim.
Dialogue: 0,0:24:27.79,0:24:32.65,Main-480p,,0,0,0,,Senin gibi bir hergelenin öyle harikulade katanalar kullanması affedilemez!
Dialogue: 0,0:24:32.65,0:24:35.49,Main-480p,,0,0,0,,Meitou'n, Wadou Ichimonji'ye el konulacak!
Dialogue: 0,0:24:44.73,0:24:47.75,Main-480p,,0,0,0,,Lanet olası! Bir kadına nasıl saldırırsın?!
Dialogue: 0,0:24:47.75,0:24:49.09,Main-480p,,0,0,0,,Lütfen buna karışmayın!
Dialogue: 0,0:24:50.39,0:24:51.23,Main-480p,,0,0,0,,Gidelim.
Dialogue: 0,0:24:53.31,0:24:57.51,Main-480p,,0,0,0,,Zoro! Onu incitirsen, öldün sen!
Dialogue: 0,0:24:57.51,0:24:58.80,Main-480p,,0,0,0,,Başçavuş Tashigi!
Dialogue: 0,0:25:16.37,0:25:19.83,Main-480p,,0,0,0,,Bu katanayı asla kaybedemem. Ne olursa olsun.
Dialogue: 0,0:25:20.45,0:25:22.39,Main-480p,,0,0,0,,Başçavuş Tashigi kaybetti.
Dialogue: 0,0:25:22.39,0:25:24.63,Main-480p,,0,0,0,,Başçavuş Tashigi bile...
Dialogue: 0,0:25:25.87,0:25:28.05,Main-480p,,0,0,0,,Görüşürüz, gitmeliyim.
Dialogue: 0,0:25:32.75,0:25:34.19,Main-480p,,0,0,0,,NİYE BENİ ÖLDÜRMEDİN?!
Dialogue: 0,0:25:35.23,0:25:37.68,Main-480p,,0,0,0,,Kadın olduğum için mi?!
Dialogue: 0,0:25:44.01,0:25:46.33,Main-480p,,0,0,0,,"Bir kadının kolu, \Nerkeğinkinden güçsüz" olsa da...
Dialogue: 0,0:25:46.33,0:25:49.15,Main-480p,,0,0,0,,...bir düelloda birine karşı yumuşak davranmak, onu küçük düşürmektir!
Dialogue: 0,0:25:49.62,0:25:52.26,Main-480p,,0,0,0,,Erkek olarak doğmuş olmayı istemenin,...
Dialogue: 0,0:25:52.28,0:25:54.67,Main-480p,,0,0,0,,...ne demek olduğunu anlayacağından şüpheliyim.
Dialogue: 0,0:25:54.67,0:25:57.49,Main-480p,,0,0,0,,Bu kılıcı oyuncak olsun diye taşımıyorum!
Dialogue: 0,0:25:59.11,0:26:01.28,Main-480p,,0,0,0,,SENİN VAR OLDUĞUN GERÇEĞİNE DAYANAMIYORUM!
Dialogue: 0,0:26:02.91,0:26:08.77,Main-480p,,0,0,0,,Dinle! Şu yüzün! Aynı uzun zaman önce ölen bir arkadaşımın yüzüne benziyor!
Dialogue: 0,0:26:08.77,0:26:12.07,Main-480p,,0,0,0,,Üstelik şu anda, aynı onun\Nsöylediği şeyleri söylüyorsun!
Dialogue: 0,0:26:12.07,0:26:14.38,Main-480p,,0,0,0,,Onu taklit etmeyi bırak, seni kopya kedi kadın!
Dialogue: 0,0:26:14.38,0:26:17.05,Main-480p,,0,0,0,,Ne? Ne çocuksu, kaba şeyler söylüyorsun!
Dialogue: 0,0:26:17.05,0:26:18.95,Main-480p,,0,0,0,,Ben kendi amaçlarım\Niçin hayatımı yaşıyorum!
Dialogue: 0,0:26:18.97,0:26:21.37,Main-480p,,0,0,0,,Arkadaşının ne tür bir\Ninsan olduğunu bilmiyorum,...
Dialogue: 0,0:26:21.37,0:26:23.12,Main-480p,,0,0,0,,...ama bundan pişmanlık duyan benim!
Dialogue: 0,0:26:23.10,0:26:24.85,Main-480p,,0,0,0,,Beni taklit eden o değil mi?!
Dialogue: 0,0:26:26.05,0:26:28.34,Main-480p,,0,0,0,,N-NE DEDİN SEN?!
Dialogue: 0,0:26:28.34,0:26:31.65,Main-480p,,0,0,0,,Sokağın sonunda! Liman orada!
Dialogue: 0,0:26:36.86,0:26:39.07,Main-480p,,0,0,0,,Hey, o önümüzdeki de kim?
Dialogue: 0,0:26:42.21,0:26:43.31,Main-480p,,0,0,0,,Sonunda geldin mi?
Dialogue: 0,0:26:44.69,0:26:46.58,Main-480p,,0,0,0,,Hasır Şapkalı Luffy.
Dialogue: 0,0:27:15.53,0:27:18.49,Main-480p,,0,0,0,,Korsan, ha? İyi.
Dialogue: 0,0:27:25.91,0:27:30.61,Main-480p,,0,0,0,,Ben Loguetown'daki Denizci Üssü'nün Kaptanı Smoker.
Dialogue: 0,0:27:30.61,0:27:32.50,Main-480p,,0,0,0,,Seni tutuklamak için buradayım.
Dialogue: 0,0:27:32.50,0:27:35.92,Main-480p,,0,0,0,,Tutuklamak? Kabul etmiyorum.
Dialogue: 0,0:27:35.92,0:27:39.61,Main-480p,,0,0,0,,Korsanlar Kralı olabilmek için,\NGrand Line'a doğru yola çıkıyorum!
Dialogue: 0,0:27:39.61,0:27:40.68,Main-480p,,0,0,0,,Korsanlar Kralı mı?
Dialogue: 0,0:27:41.05,0:27:43.43,Main-480p,,0,0,0,,Bu yüzden, nasıl tutuklanabilirim?
Dialogue: 0,0:27:43.82,0:27:46.18,Main-480p,,0,0,0,,Öyleyse beni yen.
Dialogue: 0,0:27:46.59,0:27:48.13,Main-480p,,0,0,0,,Hey, Luffy...
Dialogue: 0,0:27:48.87,0:27:52.02,Main-480p,,0,0,0,,Sanji. Sen devam et. Ben de geleceğim.
Dialogue: 0,0:27:59.65,0:28:00.79,Main-480p,,0,0,0,,Ateş!
Dialogue: 0,0:28:06.12,0:28:07.99,Main-480p,,0,0,0,,Topçu tugayı, ateş!
Dialogue: 0,0:28:22.77,0:28:26.47,Main-480p,,0,0,0,,Bu devam ederse, \NGoing Merry'i batıracaklar!
Dialogue: 0,0:28:31.64,0:28:35.10,Main-480p,,0,0,0,,Demir mi alıyorsun?!\NAma Luffy ve diğerleri henüz dönmedi!
Dialogue: 0,0:28:35.55,0:28:38.57,Main-480p,,0,0,0,,Gitmeliyiz! Geminin batmasına izin veremeyiz!
Dialogue: 0,0:28:39.75,0:28:41.73,Main-480p,,0,0,0,,Yelkenler fora!
Dialogue: 0,0:28:44.86,0:28:46.62,Main-480p,,0,0,0,,Ama ya Luffy ve diğerleri?
Dialogue: 0,0:28:46.62,0:28:48.41,Main-480p,,0,0,0,,Bir şekilde onları da alacağız!
Dialogue: 0,0:28:48.41,0:28:50.79,Main-480p,,0,0,0,,Kaçmalarına izin vermeyin! Peşlerinden gidin!
Dialogue: 0,0:28:50.79,0:28:51.95,Main-480p,,0,0,0,,NAMI-SAN!
Dialogue: 0,0:28:52.64,0:28:53.91,Main-480p,,0,0,0,,Sanji-{\i1}kun!{\i0}
Dialogue: 0,0:28:53.91,0:28:54.80,Main-480p,,0,0,0,,Sanji!
Dialogue: 0,0:28:54.80,0:28:57.38,Main-480p,,0,0,0,,Nami-san, ben döndüm~!
Dialogue: 0,0:28:57.38,0:28:59.25,Main-480p,,0,0,0,,Ya Luffy ve Zoro?
Dialogue: 0,0:28:59.60,0:29:02.26,Main-480p,,0,0,0,,O iki hödük kendilerine bakabilirler!
Dialogue: 0,0:29:04.51,0:29:05.45,Main-480p,,0,0,0,,Sanji-{\i1}kun{\i0}!
Dialogue: 0,0:29:05.45,0:29:06.59,Main-480p,,0,0,0,,Arkanda!
Dialogue: 0,0:29:12.71,0:29:14.64,Main-480p,,0,0,0,,Kahretsin! Gelmeye devam ediyorlar!
Dialogue: 0,0:29:14.64,0:29:16.43,Main-480p,,0,0,0,,Onu koruyacağım, gemiyi yanaştır.
Dialogue: 0,0:29:16.43,0:29:20.09,Main-480p,,0,0,0,,Yapamam! Gelgit akıntısı zaten çok güçlü. Kıyıya yanaşamayız!
Dialogue: 0,0:29:20.09,0:29:21.69,Main-480p,,0,0,0,,Kahretsin!
Dialogue: 0,0:29:22.10,0:29:22.94,Main-480p,,0,0,0,,Usopp!
Dialogue: 0,0:29:22.94,0:29:24.07,Main-480p,,0,0,0,,Bunu yapacağım!
Dialogue: 0,0:29:33.79,0:29:35.79,Main-480p,,0,0,0,,Usopp! Sanji-{\i1}kun!{\i0}
Dialogue: 0,0:29:46.33,0:29:47.97,Main-480p,,0,0,0,,Ne, ne, ne?
Dialogue: 0,0:29:51.22,0:29:56.49,Main-480p,,0,0,0,,Ben Moku Moku Meyvesi yedim. \NTüm bedenim bir anda duman olabilir!
Dialogue: 0,0:30:14.59,0:30:17.53,Main-480p,,0,0,0,,Ne oldu? Tüm sahip olduğun bu mu?
Dialogue: 0,0:30:25.76,0:30:29.22,Main-480p,,0,0,0,,{\fad(150,150)}GOMU GOMU NO MAKİNELİ TÜFEK!
Dialogue: 0,0:30:39.59,0:30:42.93,Main-480p,,0,0,0,,Ne? Bu iğrenç!
Dialogue: 0,0:30:47.01,0:30:48.70,Main-480p,,0,0,0,,{\fad(150,150)}BEYAZ ESİNTİ!
Dialogue: 0,0:30:50.16,0:30:51.94,Main-480p,,0,0,0,,Lanet olası!
Dialogue: 0,0:30:51.94,0:30:55.11,Main-480p,,0,0,0,,{\fad(150,150)}GOMU GOMU NO TABANCA!
Dialogue: 0,0:30:56.15,0:31:00.46,Main-480p,,0,0,0,,Şimdi anlıyor musun? \NAsla Grand Line'a gidemezsin.
Dialogue: 0,0:31:01.25,0:31:03.03,Main-480p,,0,0,0,,Dediğim gibi!
Dialogue: 0,0:31:08.17,0:31:11.39,Main-480p,,0,0,0,,Bu baş 30 milyon beli değerinde, ha?
Dialogue: 0,0:31:11.39,0:31:14.15,Main-480p,,0,0,0,,Görünüşe göre kötü şansımın işleyişi sona erdi.
Dialogue: 0,0:31:16.69,0:31:19.80,Main-480p,,0,0,0,,Evet, ben tam olarak bunu söylemezdim.
Dialogue: 0,0:31:19.80,0:31:21.27,Main-480p,,0,0,0,,Sen...?
Dialogue: 0,0:31:33.81,0:31:36.25,Main-480p,,0,0,0,,Neler oluyor? O da kim?
Dialogue: 0,0:31:37.29,0:31:40.53,Main-480p,,0,0,0,,Hükümet başını istiyor.
Dialogue: 0,0:31:42.11,0:31:45.96,Main-480p,,0,0,0,,Dünya cevabımızı bekliyor.
Dialogue: 0,0:32:20.59,0:32:22.39,Main-480p,,0,0,0,,B-Bu...
Dialogue: 0,0:32:24.89,0:32:27.07,Main-480p,,0,0,0,,Ne oldu?
Dialogue: 0,0:32:29.97,0:32:32.05,Main-480p,,0,0,0,,LUFFY!
Dialogue: 0,0:32:32.05,0:32:34.34,Main-480p,,0,0,0,,LUFFY!!
Dialogue: 0,0:32:34.34,0:32:35.83,Main-480p,,0,0,0,,Nami!
Dialogue: 0,0:32:35.83,0:32:38.43,Main-480p,,0,0,0,,Hemen bir şeyler yapmalıyız,\Nyoksa çok uzağa sürüklenecek.
Dialogue: 0,0:32:38.43,0:32:39.52,Main-480p,,0,0,0,,Tamam...!
Dialogue: 0,0:32:40.85,0:32:42.85,Main-480p,,0,0,0,,{\fad(150,150)}GOMU GOMU NO...
Dialogue: 0,0:32:45.73,0:32:46.38,Main-480p,,0,0,0,,Oh, hayır.
Dialogue: 0,0:32:46.38,0:32:47.63,Main-480p,,0,0,0,,Yapamaz.
Dialogue: 0,0:32:47.63,0:32:49.19,Main-480p,,0,0,0,,Ah kahretsin.
Dialogue: 0,0:32:49.19,0:32:52.53,Main-480p,,0,0,0,,{\fad(150,150)}...ROKET!
Dialogue: 0,0:33:02.71,0:33:03.79,Main-480p,,0,0,0,,Millet!
Dialogue: 0,0:33:08.17,0:33:12.00,Main-480p,,0,0,0,,Vay, cidden rastgele şanslı bir rüzgardı.
Dialogue: 0,0:33:12.00,0:33:15.38,Main-480p,,0,0,0,,Gösterdiğimiz tüm iyi işlerin karşılığı olmalı.
Dialogue: 0,0:33:15.97,0:33:17.50,Main-480p,,0,0,0,,Peki buradan nereye gideceğiz?
Dialogue: 0,0:33:17.50,0:33:24.60,Main-480p,,0,0,0,,{\q2}Kahrolası lastik oraya doğru gitti, değil mi?\NGrand Line'ı nasıl kaçırabilirim?!
Dialogue: 0,0:33:35.15,0:33:41.16,Main-480p,,0,0,0,,Bunu yapma şeklin buysa...
Dialogue: 0,0:33:41.49,0:33:46.91,Main-480p,,0,0,0,,Niye? Niye o adama yardım ettin, Dragon?!
Dialogue: 0,0:33:50.43,0:33:54.79,Main-480p,,0,0,0,,Bir adamı denize açılmaktan\Nalıkoymak için, ne tür bir sebep olabilir?
Dialogue: 0,0:34:05.37,0:34:08.27,Main-480p,,0,0,0,,Bana bir gemi bulun.\NHasır Şapka'nın peşinden gidiyorum.
Dialogue: 0,0:34:10.37,0:34:12.73,Main-480p,,0,0,0,,Grand Line'a.
Dialogue: 0,0:34:12.73,0:34:18.32,Main-480p,,0,0,0,,A-Ama Kaptan! Sizin yetki alanınız bu ada!
Dialogue: 0,0:34:19.35,0:34:22.53,Main-480p,,0,0,0,,Bana emir vermemeni söylemiştim!
Dialogue: 0,0:34:23.35,0:34:24.75,Main-480p,,0,0,0,,Ben de gidiyorum!
Dialogue: 0,0:34:24.75,0:34:26.65,Main-480p,,0,0,0,,Başçavuş Tashigi!
Dialogue: 0,0:34:26.65,0:34:29.54,Main-480p,,0,0,0,,Roronoa'nın bana yaptığı affedilemez!
Dialogue: 0,0:34:29.54,0:34:32.54,Main-480p,,0,0,0,,Onu kendi ellerimle yakalayacağım!
Dialogue: 0,0:34:33.83,0:34:35.55,Main-480p,,0,0,0,,Gemi ters dönecekmiş gibi hissettiriyor!
Dialogue: 0,0:34:39.33,0:34:40.89,Main-480p,,0,0,0,,O ışığa bakın!
Dialogue: 0,0:34:40.89,0:34:42.37,Main-480p,,0,0,0,,Adanın feneri?
Dialogue: 0,0:34:42.37,0:34:46.85,Main-480p,,0,0,0,,O bizim rehber ışığımız.\NO ışık, Grand Line'ın girişini gösteriyor!
Dialogue: 0,0:34:46.85,0:34:49.59,Main-480p,,0,0,0,,Grand Line orada mı?
Dialogue: 0,0:34:49.59,0:34:50.81,Main-480p,,0,0,0,,Ya şimdi?
Dialogue: 0,0:34:50.81,0:34:54.44,Main-480p,,0,0,0,,Ama gerçekten böyle bir fırtınada gidecek misiniz?
Dialogue: 0,0:35:06.62,0:35:07.97,Main-480p,,0,0,0,,Pekala!
Dialogue: 0,0:35:07.97,0:35:11.01,Main-480p,,0,0,0,,Yolculuğumuzun önemini belirtmek için,\Nküçük bir başlama töreni yapalım!
Dialogue: 0,0:35:11.01,0:35:11.96,Main-480p,,0,0,0,,Hey!
Dialogue: 0,0:35:11.96,0:35:14.63,Main-480p,,0,0,0,,Evet, harika! Yapalım!
Dialogue: 0,0:35:15.19,0:35:18.34,Main-480p,,0,0,0,,All Blue'yu bulmak için!
Dialogue: 0,0:35:19.03,0:35:21.51,Main-480p,,0,0,0,,Korsanlar Kralı olmak için!
Dialogue: 0,0:35:22.45,0:35:24.85,Main-480p,,0,0,0,,En iyi kılıç ustası olmak için!
Dialogue: 0,0:35:25.99,0:35:29.06,Main-480p,,0,0,0,,Dünyanın haritasını çizmek için!
Dialogue: 0,0:35:29.06,0:35:35.45,Main-480p,,0,0,0,,B-Ben... denizin cesur savaşçısı olmak için!!
Dialogue: 0,0:35:49.45,0:35:51.85,Main-480p,,0,0,0,,GRAND LINE'A GİDELİM!
Dialogue: 0,0:35:53.00,0:35:54.22,Main-480p,,0,0,0,,TAMAM!
Dialogue: 0,0:11:33.38,0:11:36.09,Secondary-480p,,0,0,53,,Bırak beni! Bırak çıkayım!
Dialogue: 0,0:11:36.09,0:11:39.16,Secondary-480p,,0,0,53,,Birisi yardım etsin!
Dialogue: 0,0:11:39.17,0:11:40.35,Secondary-480p,,0,0,53,,Yardım ediiiin!!
Dialogue: 0,0:15:24.11,0:15:25.31,Secondary-480p,,0,0,53,,Çabuk, zamanımız tükeniyor!
Dialogue: 0,0:15:25.31,0:15:26.52,Secondary-480p,,0,0,53,,Bu çok ağır!
Dialogue: 0,0:16:37.35,0:16:39.38,Secondary-480p,,0,0,53,,{\i1}Peh, ne rahatladım ama.{\i0}
Dialogue: 0,0:16:39.38,0:16:41.89,Secondary-480p,,0,0,53,,{\i1}Gidici olduğumu sanmıştım.{\i0}
Dialogue: 0,0:19:22.17,0:19:23.97,Secondary-480p,,0,0,0,,Grand Line'a gidelim!
Dialogue: 0,0:00:03.35,0:00:06.77,Thoughts-480p,,0,0,0,,{\i1}Mavi yüzgeçli fil tonbalığı, ha...?{\i0}
Dialogue: 0,0:00:06.77,0:00:09.90,Thoughts-480p,,0,0,0,,{\i1}Ah! Hazırlamak için bekleyemeyeceğim!{\i0}
Dialogue: 0,0:00:45.64,0:00:50.25,Thoughts-480p,,0,0,0,,{\i1}Demek kendisini gösterdi.\NBekle bakalım, çocuk.{\i0}
Dialogue: 0,0:15:06.67,0:15:09.51,Thoughts-480p,,0,0,0,,{\i1}Platformun desteklerini kesebilirsem...!{\i0}
Dialogue: 0,0:17:35.15,0:17:36.99,Thoughts-480p,,0,0,0,,{\i1}Niye?{\i0}
Dialogue: 0,0:17:38.15,0:17:40.47,Thoughts-480p,,0,0,0,,{\i1}Kurtarılacağını biliyor muydu?{\i0}
Dialogue: 0,0:17:41.39,0:17:47.37,Thoughts-480p,,0,0,0,,{\i1}Hayır. O anda, hayatının sona ereceğini anlamış olmalı.{\i0}
Dialogue: 0,0:17:47.73,0:17:52.13,Thoughts-480p,,0,0,0,,{\i1}Ölüm. Bunu kabullendi. Bunun için\Ntamamen hazırlandı ve güldü.{\i0}
