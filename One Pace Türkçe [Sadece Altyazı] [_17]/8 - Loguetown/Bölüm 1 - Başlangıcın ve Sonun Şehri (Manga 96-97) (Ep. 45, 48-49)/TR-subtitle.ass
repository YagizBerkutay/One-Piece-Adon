8,10,10,65,1Style: Kanji-furigana-OPı,Duality,18,&H00D8933F,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2,0,8,10,10,80,1Style: Author,Impress BT,20.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1,1,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:01.73,0:00:03.73,Credits-480p,,90,0,60,,Editing FeesoDialogue: 0,0:00:03.73,0:00:05.73,Credits-480p,,90,0,60,,Timing KaitouYahikoDialogue: 0,0:00:05.73,0:00:09.73,Credits-480p,,90,0,60,,Quality Control Feeso Galaxy 9000 Pepperjack Sewil TheFVguyDialogue: 0,0:00:09.73,0:00:11.73,Credits-480p,,90,0,60,,Soundtracking HaleeDialogue: 0,0:00:11.73,0:00:13.73,Credits-480p,,90,0,60,,Graphics DatenshiDialogue: 0,0:00:13.73,0:00:15.73,Credits-480p,,90,0,60,,Karaoke KaitouYahikoDialogue: 0,0:00:01.56,0:00:03.69,Main-480p,,0,0,0,,Zenginlik, Şöhret, Güç.Dialogue: 0,0:00:03.69,0:00:07.86,Main-480p,,0,0,0,,Bu dünyadaki her şeyi elde eden adam, Korsanlar Kralı, Gold Roger.Dialogue: 0,0:00:07.86,0:00:11.74,Main-480p,,0,0,0,,İdamı sırasında söylediği son sözler insanları denize gönderdi.Dialogue: 0,0:00:11.74,0:00:15.53,Main-480p,,0,0,0,,"Eğer istiyorsanız, almanıza izin vereceğim."Dialogue: 0,0:00:15.53,0:00:19.24,Main-480p,,0,0,0,,"Arayın, hepsini o yerde bıraktım!"Dialogue: 0,0:00:21.54,0:00:26.33,Main-480p,,0,0,0,,Şimdilerde erkekler, Grand Line'a doğru hayallerinin peşinden gidiyorlar.Dialogue: 0,0:00:26.33,0:00:27.84,Main-480p,,0,0,0,,Artık dünya...Dialogue: 0,0:00:27.84,0:00:29.59,Main-480p,,0,0,0,,...Büyük Korsanlar Çağı'na giriyor!Dialogue: 0,0:01:50.33,0:01:57.26,Title-480p,,0,0,160,,Başlangıcın ve Sonun ŞehriDialogue: 0,0:01:57.09,0:01:58.97,Main-480p,,0,0,0,,Yine mi fiyat yükselttiler?Dialogue: 0,0:02:00.64,0:02:03.93,Main-480p,,0,0,0,,Bunun biraz fazla olduğunu düşünmüyor musun? Niye sen...Dialogue: 0,0:02:05.73,0:02:08.64,Main-480p,,0,0,0,,Bir dahaki sefere fiyatı yükseldiğinde almayacağım, duydun mu?Dialogue: 0,0:02:13.77,0:02:16.31,Main-480p,,0,0,0,,Üfff, sadece bir gazete!Dialogue: 0,0:02:16.31,0:02:18.90,Main-480p,,0,0,0,,Ama sürekli alıyorsan, yükün artıyor!Dialogue: 0,0:02:19.34,0:02:25.05,Main-480p,,0,0,0,,Evet, artık Arlong'dan köyünü satın almak için biriktirmene gerek yok.Dialogue: 0,0:02:25.05,0:02:27.35,Main-480p,,0,0,0,,Bu yüzden niye hala para konusunda endişeleniyorsun?Dialogue: 0,0:02:27.35,0:02:28.59,Main-480p,,0,0,0,,Aptal! İşte bu yüzden!Dialogue: 0,0:02:28.59,0:02:33.61,Main-480p,,0,0,0,,Artık öyle bir mecburiyetim yok,  bu yüzden şu andan itibaren, hepsi kendim için!Dialogue: 0,0:02:34.17,0:02:38.05,Main-480p,,0,0,0,,Etrafta cimri bir korsan olarak dolaşamam, değil mi?Dialogue: 0,0:02:38.05,0:02:40.23,Main-480p,,0,0,0,,Hey, yavaş ol!Dialogue: 0,0:02:40.23,0:02:43.35,Main-480p,,0,0,0,,Burada "Kesin öldürücü Tabasco Yıldızı"mı formülize ediyorum!Dialogue: 0,0:02:46.65,0:02:49.52,Main-480p,,0,0,0,,Bununla düşmanı gözlerinden vurursam...Dialogue: 0,0:02:54.21,0:02:56.87,Main-480p,,0,0,0,,Ne? Hadi ama, sadece bir tane?Dialogue: 0,0:02:56.87,0:02:58.11,Main-480p,,0,0,0,,Olmaz!Dialogue: 0,0:02:58.11,0:03:00.80,Main-480p,,0,0,0,,Bu Nami-san'ın portakal bahçesi.Dialogue: 0,0:03:00.80,0:03:03.87,Main-480p,,0,0,0,,Ona elini sürmene izin vermeyeceğim!Dialogue: 0,0:03:03.87,0:03:06.91,Main-480p,,0,0,0,,NAMI-SAN! AŞKIN KORUMA GÖREVLİSİ GÖREV BAŞINDA!Dialogue: 0,0:03:06.91,0:03:09.08,Main-480p,,0,0,0,,Teşekkür ederim, Sanji-kun.Dialogue: 0,0:03:09.52,0:03:13.17,Main-480p,,0,0,0,,O uyuz Sanji'yi bir araç gibi kullanıyor.Dialogue: 0,0:03:15.29,0:03:19.30,Main-480p,,0,0,0,,Ne? Sadece küçük bir portakal!Dialogue: 0,0:03:19.30,0:03:20.71,Main-480p,,0,0,0,,Cimri Sanji.Dialogue: 0,0:03:20.71,0:03:22.19,Main-480p,,0,0,0,,OLMAZ DEDİM!Dialogue: 0,0:03:23.31,0:03:26.26,Main-480p,,0,0,0,,Ah, neyse. Keyfim yerinde.Dialogue: 0,0:03:28.75,0:03:33.21,Main-480p,,0,0,0,,Şu anda dünya tam bir kaousun içinde.Dialogue: 0,0:03:35.73,0:03:37.15,Main-480p,,0,0,0,,Hm? İlan mı?Dialogue: 0,0:03:54.42,0:03:58.46,Captions-480p,,50,0,350,,Ödül!  Hasır Şapkalı Luffy  Dünyaca Ünlü Oluyor!Dialogue: 0,0:04:09.33,0:04:12.43,Main-480p,,0,0,0,,Yani bana öyle görünüyor ki, sadece ordu güçlerinin,...Dialogue: 0,0:04:12.45,0:04:15.56,Main-480p,,0,0,0,,...sevkedilerek, onların yenilemeyeceğini söylüyorsun.Dialogue: 0,0:04:16.06,0:04:19.25,Main-480p,,0,0,0,,Doğru. Oluşumlarıyla...Dialogue: 0,0:04:19.25,0:04:23.46,Main-480p,,0,0,0,,...ve sonra Balta Elli Kaptan Morgan'ı yenmeleriyle,...Dialogue: 0,0:04:23.46,0:04:26.70,Main-480p,,0,0,0,,...epey aktif olduklarını gösterdiler.Dialogue: 0,0:04:27.37,0:04:29.87,Main-480p,,0,0,0,,Palyaço Buggy, 15 milyon.Dialogue: 0,0:04:29.87,0:04:33.30,Main-480p,,0,0,0,,Korsan Filosu Lideri Don Krieg, 17 milyon.Dialogue: 0,0:04:33.30,0:04:37.04,Main-480p,,0,0,0,,Ve Deniz Adamları Korsan Lideri "Testere Burun Arlong" 20 milyon.Dialogue: 0,0:04:37.13,0:04:46.01,Captions-480p,,0,0,5,,Binbaşı Brannew Donanma KarargahıDialogue: 0,0:04:37.45,0:04:41.69,Main-480p,,0,0,0,,East Blue'daki ödül ortalamasının 3 milyon olduğunu aklımızda tutarsak,...Dialogue: 0,0:04:41.69,0:04:44.33,Main-480p,,0,0,0,,...bunlar 10 milyondan fazla ödül değerindeki...Dialogue: 0,0:04:44.36,0:04:47.01,Main-480p,,0,0,0,,...birinci lig korsanları. Onların hepsini yendi.Dialogue: 0,0:04:48.29,0:04:52.68,Main-480p,,0,0,0,,Başına konan başlangıç ödülü 30 milyon beli olacak.Dialogue: 0,0:04:52.68,0:04:55.35,Main-480p,,0,0,0,,Rekor bir rakam, ama makul.Dialogue: 0,0:04:55.35,0:04:57.97,Main-480p,,0,0,0,,Kısa sürede işlerini bitirmek, en akıllısı olacak.Dialogue: 0,0:04:57.97,0:05:00.82,Main-480p,,0,0,0,,Kök salmadan, bu kötülük tohumunu koparmalıyız.Dialogue: 0,0:05:03.17,0:05:05.03,Main-480p,,0,0,0,,Kesinlikle.Dialogue: 0,0:05:07.47,0:05:09.66,Main-480p,,0,0,0,,Şuna bakın, ARANIYOR'uz!Dialogue: 0,0:05:10.15,0:05:12.45,Main-480p,,0,0,0,,30,000,000 beli, EVET!Dialogue: 0,0:05:13.99,0:05:18.38,Main-480p,,0,0,0,,Şuna bakın! Artık sırtım bile ünlü! Kahretsin, başardım...Dialogue: 0,0:05:18.38,0:05:21.71,Main-480p,,0,0,0,,Ne?! Uzun Burun'unki olmasına rağmen, benim resmim yok mu?Dialogue: 0,0:05:23.13,0:05:26.09,Main-480p,,0,0,0,,Hey nerede, nerede? Seni görmüyorum.Dialogue: 0,0:05:26.09,0:05:28.87,Main-480p,,0,0,0,,Baaaak!Dialogue: 0,0:05:28.87,0:05:32.13,Main-480p,,0,0,0,,Sadece kafanın arkası. Sayılmaz.Dialogue: 0,0:05:32.13,0:05:34.96,Main-480p,,0,0,0,,Hey, kıskanma! Bir gün senin de olabilir...Dialogue: 0,0:05:34.98,0:05:37.31,Main-480p,,0,0,0,,...ve kaptan olmasan bile, benim gibi ünlü olabilirsin.Dialogue: 0,0:05:37.31,0:05:38.33,Main-480p,,0,0,0,,Cidden?Dialogue: 0,0:05:38.33,0:05:40.52,Main-480p,,0,0,0,,Evet, sıkı çalışırsan...Dialogue: 0,0:05:42.77,0:05:46.28,Main-480p,,0,0,0,,Pekala tayfa! GRAND LINE'a gidiyoruz!Dialogue: 0,0:05:46.28,0:05:51.40,Main-480p,,0,0,0,,Siz... Birkez daha gerçekten bu durumun ciddiyetini anlamıyorsunuz!Dialogue: 0,0:05:51.40,0:05:54.75,Main-480p,,0,0,0,,Bunun bizim için bir tehlike anlamına geldiğini anlamıyor musunuz?Dialogue: 0,0:05:55.51,0:06:00.42,Main-480p,,0,0,0,,Bundan sonra, artık East Blue'da rahatça dolaşabileceğimizi sanmıyorum.Dialogue: 0,0:06:03.93,0:06:06.14,Thoughts-480p,,0,0,0,,30 milyon beli.Dialogue: 0,0:06:06.14,0:06:08.79,Thoughts-480p,,0,0,0,,Böyle büyük bir ödülle üst sınıf Denizciler bile bizi arıyor olacak.Dialogue: 0,0:06:08.79,0:06:11.68,Thoughts-480p,,0,0,0,,Para peşindeki zorlu ödül avcıları da öyle.Dialogue: 0,0:06:12.65,0:06:15.69,Thoughts-480p,,0,0,0,,Şu andan itibaren, tamamen yeni bir ligde olacağız.Dialogue: 0,0:06:19.77,0:06:21.61,Main-480p,,0,0,0,,Hanımefendi!Dialogue: 0,0:06:24.13,0:06:25.86,Main-480p,,0,0,0,,Kaya-hanımefendi!Dialogue: 0,0:06:26.83,0:06:27.95,Main-480p,,0,0,0,,Hanımefendi!Dialogue: 0,0:06:27.95,0:06:29.86,Main-480p,,0,0,0,,Sorun nedir, Merry?Dialogue: 0,0:06:29.86,0:06:31.74,Main-480p,,0,0,0,,Lütfen bakın!Dialogue: 0,0:06:33.19,0:06:34.54,Main-480p,,0,0,0,,Usopp-san!Dialogue: 0,0:06:35.70,0:06:39.81,Main-480p,,0,0,0,,Arka profildeki kesinlikle Usopp-san!Dialogue: 0,0:06:39.81,0:06:42.46,Main-480p,,0,0,0,,Öyle görünüyor, evet...Dialogue: 0,0:06:47.81,0:06:48.88,Main-480p,,0,0,0,,Sonunda!Dialogue: 0,0:06:48.88,0:06:52.93,Main-480p,,0,0,0,,Luffy-san hayaliyle ilerliyor!Dialogue: 0,0:06:53.91,0:06:57.89,Flashbacks-480p,,0,0,0,,Ben Luffy! Korsanlar Kralı olacak adam!Dialogue: 0,0:07:01.27,0:07:04.23,Flashbacks-480p,,0,0,0,,Görüşürüz!Dialogue: 0,0:07:04.23,0:07:09.70,Main-480p,,0,0,0,,Ama bir dahaki karşılaşmamızda, düşman olabiliriz!Dialogue: 0,0:07:43.29,0:07:47.43,Main-480p,,0,0,0,,Grand Line'a çok yaklaşıyoruz.Dialogue: 0,0:07:47.43,0:07:51.24,Main-480p,,0,0,0,,Oraya ulaşmanın tek yolu Loguetown'ı geçmek.Dialogue: 0,0:07:51.24,0:07:53.20,Main-480p,,0,0,0,,Loguetown?Dialogue: 0,0:07:53.20,0:07:56.19,Main-480p,,0,0,0,,"Başlangıcın ve Sonun Şehri" olarak da adlandırılır.Dialogue: 0,0:07:56.77,0:07:58.83,Main-480p,,0,0,0,,Ya da ben öyle duydum.Dialogue: 0,0:08:00.27,0:08:05.79,Main-480p,,0,0,0,,Korsanlar Kralı Gold Roger'ın doğduğu şehir.Dialogue: 0,0:08:09.57,0:08:11.83,Main-480p,,0,0,0,,Korsanlar Kralı'nın öldüğü şehir...Dialogue: 0,0:08:13.67,0:08:14.76,Main-480p,,0,0,0,,Gitmek ister misin?Dialogue: 0,0:08:14.76,0:08:17.29,Main-480p,,0,0,0,,Evet. Görmek istiyorum.Dialogue: 0,0:08:17.29,0:08:19.68,Main-480p,,0,0,0,,One Piece'e sahip olan adam.Dialogue: 0,0:08:19.68,0:08:22.48,Main-480p,,0,0,0,,Dünyadaki her şeye sahip olan adam.Dialogue: 0,0:08:22.48,0:08:25.45,Main-480p,,0,0,0,,Doğduğu ve öldüğü yer...Dialogue: 0,0:08:37.37,0:08:40.78,Main-480p,,0,0,0,,Kaçmak isteyen, şimdi yapsın!Dialogue: 0,0:08:40.78,0:08:42.72,Main-480p,,0,0,0,,Bu Korsan Çağı'ndaki huzur kalesinde,...Dialogue: 0,0:08:42.70,0:08:45.50,Main-480p,,0,0,0,,...güçsüzlüğe yer yok!Dialogue: 0,0:08:46.31,0:08:50.78,Main-480p,,0,0,0,,Sivillerin güçsüz olması suç değil. Biz Adalet'in kalbiyiz!Dialogue: 0,0:08:50.78,0:08:53.05,Main-480p,,0,0,0,,Denizlerde ölümcül bir kötülük varsa,...Dialogue: 0,0:08:53.05,0:08:58.19,Main-480p,,0,0,0,,...biz Denizciler onu yok edeceğiz!Dialogue: 0,0:08:58.97,0:09:01.52,Main-480p,,0,0,0,,MUTLAK ADALET adına!Dialogue: 0,0:09:01.52,0:09:07.27,Note-480p,,0,0,0,,Kanji: ADALETDialogue: 0,0:09:07.29,0:09:11.36,Main-480p,,0,0,0,,Yihuuuu! Ne büyük bir şehir!Dialogue: 0,0:09:11.98,0:09:16.43,Main-480p,,0,0,0,,Birçok korsan Grand Line'a gitmeden önce, bu şehirde depolarını doldurur.Dialogue: 0,0:09:16.43,0:09:18.74,Main-480p,,0,0,0,,Burada ne isterseniz, bolca bulabilirsiniz!Dialogue: 0,0:09:18.74,0:09:19.84,Main-480p,,0,0,0,,Tamam!Dialogue: 0,0:09:19.84,0:09:24.29,Main-480p,,0,0,0,,Sıradaki büyük maceram için, gidip bazı harika şeyler almalıyım.Dialogue: 0,0:09:24.63,0:09:27.28,Main-480p,,0,0,0,,Bahse varım, burada kontrol edebileceğim bir sürü yiyecek vardır.Dialogue: 0,0:09:27.28,0:09:28.92,Main-480p,,0,0,0,,Bir sürü de iyi kadın!Dialogue: 0,0:09:28.92,0:09:31.03,Main-480p,,0,0,0,,Benim de almak istediğim bir şey var.Dialogue: 0,0:09:31.03,0:09:35.51,Main-480p,,0,0,0,,Oh? Bunu nasıl yapacaksın? Tamamen meteliksizsin, değil mi?Dialogue: 0,0:09:35.51,0:09:38.29,Main-480p,,0,0,0,,Tamam! Ben de infaz platformunu kontrol edeceğim!Dialogue: 0,0:09:38.29,0:09:38.89,Main-480p,,0,0,0,,Huh?Dialogue: 0,0:09:39.37,0:09:43.01,Main-480p,,0,0,0,,Korsanlar Kralı'nın öldüğü yeri görmek istiyorum!!Dialogue: 0,0:09:43.01,0:09:46.41,Main-480p,,0,0,0,,Hey, hey! Henüz buluşacağımız bir yer kararlaştırmadık!Dialogue: 0,0:09:47.07,0:09:49.65,Main-480p,,0,0,0,,Aah... umutsuz vaka.Dialogue: 0,0:09:51.97,0:09:55.49,Thoughts-480p,,0,0,0,,Korsanlar Kralı burada doğdu ve burada öldü!Dialogue: 0,0:09:55.49,0:09:58.45,Thoughts-480p,,0,0,0,,Belki bu caddeden bile yürüdü!Dialogue: 0,0:09:58.77,0:10:00.49,Main-480p,,0,0,0,,Yihuuu!Dialogue: 0,0:10:00.49,0:10:04.45,Thoughts-480p,,0,0,0,,Kahretsin! Çok fazla!Dialogue: 0,0:10:04.45,0:10:06.37,Flashbacks-480p,,0,0,0,,Ödünç paraya mı ihtiyacın var?Dialogue: 0,0:10:06.37,0:10:07.73,Flashbacks-480p,,0,0,0,,Sorun değil!Dialogue: 0,0:10:07.73,0:10:11.79,Flashbacks-480p,,0,0,0,,Ama bana 3 kat faiziyle birlikte ödemelisin, tamam mı?Dialogue: 0,0:10:11.79,0:10:15.01,Thoughts-480p,,0,0,0,,O kadından ödünç para alamam.Dialogue: 0,0:10:15.01,0:10:18.20,Thoughts-480p,,0,0,0,,Ama sadece bir kılıç, Grand Line için yetmez.Dialogue: 0,0:10:18.20,0:10:20.47,Thoughts-480p,,0,0,0,,Ne yapacağım?Dialogue: 0,0:10:18.91,0:10:20.47,Secondary-480p,,0,0,0,,"Canavar mı"?! Bu oldukça kaba!Dialogue: 0,0:10:21.51,0:10:27.24,Main-480p,,0,0,0,,Kapa çeneni! Onun sayesinde, patronumuz hapse girdi!Dialogue: 0,0:10:27.24,0:10:28.53,Main-480p,,0,0,0,,Hala vazgeçmediniz mi?Dialogue: 0,0:10:28.53,0:10:32.29,Main-480p,,0,0,0,,Mümkün değil! Korktun mu yoksa?Dialogue: 0,0:10:32.29,0:10:36.40,Main-480p,,0,0,0,,Seni ona parça parça göndereceğiz!Dialogue: 0,0:10:36.40,0:10:38.95,Main-480p,,0,0,0,,Anlıyorum. Sizinle dövüşmek zorundayım.Dialogue: 0,0:10:38.95,0:10:39.94,Main-480p,,0,0,0,,Öyle mi bebek?Dialogue: 0,0:10:39.94,0:10:41.74,Main-480p,,0,0,0,,Beni güldürme!Dialogue: 0,0:10:41.74,0:10:44.20,Main-480p,,0,0,0,,Senin gibi küçük bir kadın ne yapabilir?Dialogue: 0,0:10:44.20,0:10:44.78,Main-480p,,0,0,0,,Al bunu!Dialogue: 0,0:11:04.83,0:11:06.06,Main-480p,,0,0,0,,Vay, kazandı!Dialogue: 0,0:11:06.06,0:11:08.37,Main-480p,,0,0,0,,Bu harikaydı!Dialogue: 0,0:11:13.40,0:11:16.03,Main-480p,,0,0,0,,Sanırım kendi gücüyle başa çıkamıyor!Dialogue: 0,0:11:14.05,0:11:18.36,Secondary-480p,,0,0,0,,Gözlüklerim...Dialogue: 0,0:11:18.36,0:11:19.67,Main-480p,,0,0,0,,Gözlükler...Dialogue: 0,0:11:19.67,0:11:21.23,Main-480p,,0,0,0,,Hey. Bunları mı arıyorsun?Dialogue: 0,0:11:24.13,0:11:25.45,Main-480p,,0,0,0,,Ü-Üzgünüm!Dialogue: 0,0:11:27.41,0:11:28.93,Main-480p,,0,0,0,,Çok teşekkür ederim.Dialogue: 0,0:11:30.73,0:11:31.27,Main-480p,,0,0,0,,Bu nasıl?Dialogue: 0,0:11:31.27,0:11:33.63,Main-480p,,0,0,0,,Oh! Üzerinizde harika görünüyor hanımefendi!Dialogue: 0,0:11:33.63,0:11:34.64,Main-480p,,0,0,0,,Bu?Dialogue: 0,0:11:34.64,0:11:36.88,Main-480p,,0,0,0,,OH! Çok zarif, hanımefendi!Dialogue: 0,0:11:36.88,0:11:37.40,Main-480p,,0,0,0,,Bu?Dialogue: 0,0:11:37.40,0:11:39.00,Main-480p,,0,0,0,,Çok doğal, hanımefendi!Dialogue: 0,0:11:39.00,0:11:39.50,Main-480p,,0,0,0,,Ya bu?Dialogue: 0,0:11:39.50,0:11:40.76,Main-480p,,0,0,0,,Elektrikli!Dialogue: 0,0:11:40.76,0:11:41.16,Main-480p,,0,0,0,,Bu?Dialogue: 0,0:11:41.16,0:11:42.34,Main-480p,,0,0,0,,Çok melankolik!Dialogue: 0,0:11:42.85,0:11:45.47,Main-480p,,0,0,0,,Bugün hepsini satın alacak mısınız?Dialogue: 0,0:11:45.47,0:11:46.43,Main-480p,,0,0,0,,Hayır, hiç birini.Dialogue: 0,0:11:46.43,0:11:48.45,Main-480p,,0,0,0,,Daha rahat bir şey bakıyorum.Dialogue: 0,0:11:48.45,0:11:50.81,Main-480p,,0,0,0,,Lütfen yine gelin!Dialogue: 0,0:11:51.14,0:11:54.10,Thoughts-480p,,0,0,0,,Oh...! Lezzetli bir çerez...Dialogue: 0,0:11:54.10,0:11:57.61,Thoughts-480p,,0,0,0,,OH!! Güzel, iki parçalı bir yemek!Dialogue: 0,0:11:57.95,0:12:01.73,Thoughts-480p,,0,0,0,,Bu şehir lezzetli yemek örnekleriyle dolu!Dialogue: 0,0:12:01.73,0:12:05.66,Thoughts-480p,,0,0,0,,Üstelik ilk önce hangisini deneyeceğini bile bilmiyorsun, seni aptal köpek!Dialogue: 0,0:12:07.77,0:12:10.29,Thoughts-480p,,0,0,0,,Sanırım ANA YEMEĞİ buldum!Dialogue: 0,0:12:12.85,0:12:17.71,Main-480p,,0,0,0,,Harika! Bu müthiş! Bu yer harika şeylerle dolu!Dialogue: 0,0:12:17.71,0:12:19.13,Main-480p,,0,0,0,,Hoşgeldiniz efendim!Dialogue: 0,0:12:19.58,0:12:21.28,Main-480p,,0,0,0,,Gördüğünüz tüm nesneler,...Dialogue: 0,0:12:21.28,0:12:25.09,Main-480p,,0,0,0,,...Grand Line'a yelken açan korsanlar tarafından kullanılmıştır!Dialogue: 0,0:12:25.09,0:12:28.10,Main-480p,,0,0,0,,Elbette bunlar, değerli, özel nesnelerdir.Dialogue: 0,0:12:28.41,0:12:32.56,Main-480p,,0,0,0,,Yani... tüm bu şeyler, Grand Line'daki  maceraları sırasında kullandıkları şeyler mi?Dialogue: 0,0:12:32.56,0:12:34.69,Main-480p,,0,0,0,,Aynen öyle efendim.Dialogue: 0,0:12:34.69,0:12:38.75,Main-480p,,0,0,0,,Denizin gerçek savaşçılarının ihtiyaçlarını temin ediyoruz.Dialogue: 0,0:12:38.75,0:12:42.61,Main-480p,,0,0,0,,Sizinle iş yapmaktan çok memnunuz!Dialogue: 0,0:12:43.10,0:12:47.91,Main-480p,,0,0,0,,Buna ne dersiniz? Gold Roger tarafından kullanılmış bir silah!Dialogue: 0,0:12:47.91,0:12:50.61,Main-480p,,0,0,0,,NE!? Gold Roger'ın mıydı?Dialogue: 0,0:12:50.61,0:12:51.61,Main-480p,,0,0,0,,Evet!Dialogue: 0,0:12:52.20,0:12:55.03,Main-480p,,0,0,0,,Efendim! Ne düşünüyorsunuz?Dialogue: 0,0:12:55.03,0:12:56.29,Main-480p,,0,0,0,,Bana daha fazla şey göster lütfen!Dialogue: 0,0:12:56.29,0:12:58.42,Main-480p,,0,0,0,,Memnuniyetle!Dialogue: 0,0:13:01.61,0:13:04.05,Main-480p,,0,0,0,,Nereye gidiyoruz?Dialogue: 0,0:13:04.49,0:13:07.55,Main-480p,,0,0,0,,Gözlüklerimi kırdın, değil mi?Dialogue: 0,0:13:08.27,0:13:11.47,Main-480p,,0,0,0,,Ama söyledim, geri ödeyeceğim.Dialogue: 0,0:13:12.26,0:13:14.90,Main-480p,,0,0,0,,Parası olan birine benzemiyorsun.Dialogue: 0,0:13:14.90,0:13:16.77,Main-480p,,0,0,0,,Bir şey saklıyor gibisin.Dialogue: 0,0:13:16.77,0:13:19.80,Main-480p,,0,0,0,,E-Evet, hiç param yok, ama...Dialogue: 0,0:13:19.80,0:13:21.54,Main-480p,,0,0,0,,Gözlerinin etrafındaki durumu açığa vuran çizgiler,...Dialogue: 0,0:13:21.54,0:13:23.99,Main-480p,,0,0,0,,...bir şey yemeden günlerce dayanmış birinin bakışı olduğunu söylüyor.Dialogue: 0,0:13:24.55,0:13:27.20,Main-480p,,0,0,0,,Fakir ve hasta bir annen var, değil mi?Dialogue: 0,0:13:27.20,0:13:31.66,Main-480p,,0,0,0,,Belki de, karından kaçıyorsun ve onu beş çocukla yalnız başına bıraktın?Dialogue: 0,0:13:31.66,0:13:33.33,Main-480p,,0,0,0,,Hey...Dialogue: 0,0:13:33.33,0:13:36.12,Main-480p,,0,0,0,,Cevap verdirmeyeceğim. Sadece benimle gel.Dialogue: 0,0:13:41.05,0:13:43.46,Main-480p,,0,0,0,,D-Denizci?Dialogue: 0,0:13:45.49,0:13:46.26,Main-480p,,0,0,0,,İşte.Dialogue: 0,0:13:47.07,0:13:51.14,Main-480p,,0,0,0,,Denizciler için çalıştığın sürece, para için endişelenmene gerek yok.Dialogue: 0,0:13:51.14,0:13:54.22,Main-480p,,0,0,0,,Bu hiç de komik değil!  Niye Denizciler için çalışayım?!Dialogue: 0,0:13:54.61,0:13:58.41,Main-480p,,0,0,0,,Kaçmak mı istiyorsun? Başkalarının iyiliğine rıza gösteriyorsun, değil mi?Dialogue: 0,0:13:59.07,0:14:00.31,Main-480p,,0,0,0,,Hey...Dialogue: 0,0:14:00.89,0:14:03.13,Main-480p,,0,0,0,,Başçavuş! Talim vakti!Dialogue: 0,0:14:03.13,0:14:05.44,Main-480p,,0,0,0,,Pekala, elinden geleni yap, tamam mı?Dialogue: 0,0:14:05.44,0:14:07.20,Main-480p,,0,0,0,,Başçavuş mu?Dialogue: 0,0:14:08.89,0:14:11.49,Main-480p,,0,0,0,,Kahretsin! Bu şekilde nasıl bir şey elde edebilirsin?Dialogue: 0,0:14:16.99,0:14:18.96,Main-480p,,0,0,0,,Sonuçta üç fırça en iyisi.Dialogue: 0,0:14:22.92,0:14:24.13,Main-480p,,0,0,0,,Tekrar!Dialogue: 0,0:14:31.35,0:14:32.89,Main-480p,,0,0,0,,Sen! Burada ne yapıyorsun?Dialogue: 0,0:14:33.85,0:14:36.67,Main-480p,,0,0,0,,Biliyordum! Bu o, Korsan Avcısı Zoro!Dialogue: 0,0:14:36.67,0:14:38.85,Main-480p,,0,0,0,,O ifrit yerlerimizi temizliyor!Dialogue: 0,0:14:38.85,0:14:43.27,Main-480p,,0,0,0,,Monkey D. Luffy'nin tayfasına katıldı!Dialogue: 0,0:14:43.27,0:14:44.69,Main-480p,,0,0,0,,Tutuklusun!Dialogue: 0,0:14:50.95,0:14:54.45,Main-480p,,0,0,0,,Pekala... şimdi ne yapıyorum?Dialogue: 0,0:14:57.21,0:14:58.75,Main-480p,,0,0,0,,Ne oldu?!Dialogue: 0,0:15:00.39,0:15:03.71,Main-480p,,0,0,0,,Görünüşe göre saldırıya uğramışlar! Suçlu kaçmış!Dialogue: 0,0:15:08.27,0:15:09.55,Main-480p,,0,0,0,,"Gözlük parası"...?Dialogue: 0,0:15:14.39,0:15:16.92,Thoughts-480p,,0,0,0,,Şoktan bahsediyorum... Kahretsin.Dialogue: 0,0:15:16.92,0:15:19.61,Thoughts-480p,,0,0,0,,Kuina'ya fazlasıyla benziyor.Dialogue: 0,0:15:19.61,0:15:22.55,Thoughts-480p,,0,0,0,,Her şey bir yana, kılıç ustası olmak zorunda mı?Dialogue: 0,0:15:22.55,0:15:26.15,Thoughts-480p,,0,0,0,,İyi olansa, büyük ihtimalle bir daha onu görmeyeceğim.Dialogue: 0,0:15:34.23,0:15:35.49,Main-480p,,0,0,0,,Bir katana almak istiyorum.Dialogue: 0,0:15:36.53,0:15:40.86,Main-480p,,0,0,0,,Evet, evet, eve- Hoşgeldiniz!Dialogue: 0,0:15:36.87,0:15:43.50,Captions-480p,,0,0,5,,Ippon-matsu Silah Dükkanı SahibiDialogue: 0,0:15:40.86,0:15:43.50,Main-480p,,0,0,0,, İki yüz yıldır bu işi yapıyoruz!Dialogue: 0,0:15:44.99,0:15:48.59,Main-480p,,0,0,0,,Yüz bin belim var. Bana iki katana satın.Dialogue: 0,0:15:48.61,0:15:51.41,Main-480p,,0,0,0,,Ne? Yüz bine iki katana mı?Dialogue: 0,0:15:51.41,0:15:54.47,Thoughts-480p,,0,0,0,,Ne, parasız falan mısın yoksa?Dialogue: 0,0:15:56.09,0:15:58.93,Main-480p,,0,0,0,,Elli bin seni sadece berbat bir kılıç sahibi yapacak.Dialogue: 0,0:15:59.34,0:16:02.44,Main-480p,,0,0,0,,Neyin varsa olur. Gerçekten şu anda pek param yok.Dialogue: 0,0:16:02.87,0:16:06.83,Thoughts-480p,,0,0,0,,"Herhangi bir şey olur" diyor. Bir tür kılıç gösterişçisi falan olmalı.Dialogue: 0,0:16:08.13,0:16:11.19,Thoughts-480p,,0,0,0,,Belindeki kılıç...o...Dialogue: 0,0:16:11.19,0:16:17.93,Main-480p,,0,0,0,,Hey, hey... o-o-o- katanaya, b-b-bir saniye b-b-b-bakabilir miyim?Dialogue: 0,0:16:17.93,0:16:19.95,Main-480p,,0,0,0,,Niye bu kadar gerginsin?Dialogue: 0,0:16:19.95,0:16:21.33,Main-480p,,0,0,0,,Ah, hadi ama!Dialogue: 0,0:16:21.33,0:16:23.16,Main-480p,,0,0,0,,Tuhaf yaşlı adam.Dialogue: 0,0:16:24.87,0:16:27.04,Thoughts-480p,,0,0,0,,Bu mümkün mü....?!!Dialogue: 0,0:16:28.83,0:16:31.79,Thoughts-480p,,0,0,0,,Oh... Ohh... Tamam, sakin ol.Dialogue: 0,0:16:31.79,0:16:35.43,Thoughts-480p,,0,0,0,,Bir aceminin bu dükkana "Meitou" getirmesi, her gün olan bir şey değil.Dialogue: 0,0:16:31.79,0:16:35.43,Thoughts-480p,,0,0,0,,Meitou - "İsmi Olan Kılıç"Dialogue: 0,0:16:35.43,0:16:37.72,Thoughts-480p,,0,0,0,,Sakince konuşmalıyım!Dialogue: 0,0:16:38.39,0:16:41.39,Main-480p,,0,0,0,,Vaay, bu ne eski bir katana.Dialogue: 0,0:16:41.39,0:16:45.03,Main-480p,,0,0,0,,Ama bunun için sana bir şeyler veririm. İyi yüz bin vereceğim.Dialogue: 0,0:16:45.03,0:16:48.33,Main-480p,,0,0,0,,Bu durumda üç yüz bin belin olur...Dialogue: 0,0:16:48.33,0:16:51.74,Main-480p,,0,0,0,,...ve üç yüz bine üç iyi katana alabilirsin!Dialogue: 0,0:16:52.09,0:16:54.15,Main-480p,,0,0,0,,Huh? Neden bahsediyorsun?Dialogue: 0,0:16:54.15,0:16:59.16,Main-480p,,0,0,0,,Tamam! 250 bin hayır 300 bin beli?Dialogue: 0,0:17:00.53,0:17:02.04,Main-480p,,0,0,0,,500,000?Dialogue: 0,0:17:02.04,0:17:05.00,Main-480p,,0,0,0,,O katana için ne kadar verdiğin önemli değil.Dialogue: 0,0:17:05.00,0:17:08.84,Main-480p,,0,0,0,,Tamam, beni mahvettin! 650 bin beli!Dialogue: 0,0:17:09.83,0:17:14.22,Main-480p,,0,0,0,,Anladım, seni iş adamı! Bunu 800 bine alacağım!Dialogue: 0,0:17:14.22,0:17:15.90,Main-480p,,0,0,0,,İyi günler!Dialogue: 0,0:17:15.90,0:17:18.30,Main-480p,,0,0,0,,Shigure'mi almaya geldim. Hazır mı?Dialogue: 0,0:17:15.90,0:17:18.30,Main-480p,,0,0,0,,Shigure - "Güz Yağmuru Erkek", samuray benzeri karakterler için kullanılan isimDialogue: 0,0:17:20.31,0:17:22.47,Main-480p,,0,0,0,,Oh! Çok sevindim! İyisin!Dialogue: 0,0:17:22.47,0:17:27.01,Main-480p,,0,0,0,,Demin, birisi Denizci Üssü'ne girdi!Dialogue: 0,0:17:27.01,0:17:29.77,Main-480p,,0,0,0,,Bu yüzden senin için endişelendim.Dialogue: 0,0:17:29.77,0:17:33.03,Thoughts-480p,,0,0,0,,Bu kadının nesi var?Dialogue: 0,0:17:30.79,0:17:33.03,Secondary-480p,,0,0,0,,Ama iyi olduğuna çok sevindim!Dialogue: 0,0:17:33.03,0:17:35.95,Main-480p,,0,0,0,,Başka birinin yardımseverliğini kabul etmediğin...Dialogue: 0,0:17:35.95,0:17:39.99,Main-480p,,0,0,0,,...ve dürüst bir iş için kaçtığın anlamına gelir.Dialogue: 0,0:17:40.53,0:17:42.53,Main-480p,,0,0,0,,Paranı geri al.Dialogue: 0,0:17:42.53,0:17:45.54,Main-480p,,0,0,0,,Böyle bir şey yapabilecek bir adamdan para almayı kabul etmiyorum.Dialogue: 0,0:17:45.54,0:17:48.45,Main-480p,,0,0,0,,Bak, çoktan yeni bir gözlük aldım.Dialogue: 0,0:17:51.17,0:17:53.76,Main-480p,,0,0,0,,Aaah! Bu katana, yoksa?Dialogue: 0,0:17:54.95,0:17:56.72,Main-480p,,0,0,0,, Wadou IchimonjiDialogue: 0,0:17:54.95,0:17:56.72,Main-480p,,0,0,0,,"Uyumun Şaşmaz Yolu"Dialogue: 0,0:17:57.10,0:17:58.30,Thoughts-480p,,0,0,0,,Wadou?Dialogue: 0,0:17:59.23,0:18:01.05,Thoughts-480p,,0,0,0,,Söyleme! Söyleme!Dialogue: 0,0:18:02.97,0:18:05.05,Main-480p,,0,0,0,,Ne güzel bir shuga!Dialogue: 0,0:18:02.97,0:18:05.05,Main-480p,,0,0,0,,Shuga - "Keskinleştirilmiş Kılıç Ucu"Dialogue: 0,0:18:05.05,0:18:07.73,Main-480p,,0,0,0,,Bu kesinlikle, efsanevi Oowaza-mono 21'den biri.Dialogue: 0,0:18:05.05,0:18:07.73,Main-480p,,0,0,0,,"21 Çok İyi Dereceli Kılıç"Dialogue: 0,0:18:09.57,0:18:14.96,Main-480p,,0,0,0,,Bu, yirmi milyon beliden daha fazla eden bir kılıç!Dialogue: 0,0:18:14.96,0:18:17.49,Main-480p,,0,0,0,,Ama... niye senin gibi biri böyle ünlü bir Meitou'ya sahip?Dialogue: 0,0:18:17.49,0:18:20.68,Main-480p,,0,0,0,,SEEEN! Ona her şeyi anlattın!Dialogue: 0,0:18:20.68,0:18:23.17,Main-480p,,0,0,0,,İşimi mahvediyorsun!Dialogue: 0,0:18:23.17,0:18:24.99,Main-480p,,0,0,0,,İşini mi mahvediyorum?Dialogue: 0,0:18:24.99,0:18:27.96,Main-480p,,0,0,0,,Üzgünüm. Kötü bir şey mi söyledim?Dialogue: 0,0:18:28.95,0:18:32.68,Main-480p,,0,0,0,,Shigerun için geldin, değil mi? İşte! Bileylendi.Dialogue: 0,0:18:32.68,0:18:33.88,Main-480p,,0,0,0,,Şimdi al onu ve defol!Dialogue: 0,0:18:37.34,0:18:40.25,Main-480p,,0,0,0,,Niye o tarafa gittin? Neyin var senin?Dialogue: 0,0:18:40.25,0:18:41.30,Main-480p,,0,0,0,,Üzgünüm.Dialogue: 0,0:18:42.17,0:18:44.55,Main-480p,,0,0,0,,O şaşkın kız seni kurtardı.Dialogue: 0,0:18:44.55,0:18:47.96,Main-480p,,0,0,0,,Bu kılıç gerçekten ünlü Meitou'lardan biri.Dialogue: 0,0:18:47.96,0:18:50.56,Main-480p,,0,0,0,,Senin gibi bir amatör, onu taşımayı hak etmiyor.Dialogue: 0,0:18:50.56,0:18:53.93,Main-480p,,0,0,0,,Elli binlik katanalar, oradaki fıçıların içinde.Dialogue: 0,0:18:53.93,0:18:55.95,Main-480p,,0,0,0,,Git iki tanesini al ve dükkanımdan çık!Dialogue: 0,0:18:56.57,0:18:58.44,Main-480p,,0,0,0,,Bu kadar kızacak ne var?Dialogue: 0,0:18:58.77,0:19:02.95,Main-480p,,0,0,0,,Sen üç tane taşıdığına göre gerçekten kılıçları seviyorsun, değil mi?Dialogue: 0,0:19:02.95,0:19:05.16,Main-480p,,0,0,0,,Kulağa şu ödül avcısı gibi geliyor.Dialogue: 0,0:19:05.16,0:19:06.97,Main-480p,,0,0,0,,Ödül avcısı, ha?Dialogue: 0,0:19:06.97,0:19:09.57,Main-480p,,0,0,0,,Çok ünlü. Adı Roronoa.Dialogue: 0,0:19:09.57,0:19:10.87,Main-480p,,0,0,0,,O adı çok duydum.Dialogue: 0,0:19:11.22,0:19:15.15,Main-480p,,0,0,0,,Büyük bir kılıç ustası olarak, tüm East Blue'da saygınlığı var.Dialogue: 0,0:19:15.15,0:19:16.45,Main-480p,,0,0,0,,Ama kötü bir adam!Dialogue: 0,0:19:16.45,0:19:20.63,Main-480p,,0,0,0,,Bir kılıcı para kazanacak araç olarak kullanmak... affedilemez!Dialogue: 0,0:19:20.63,0:19:23.41,Main-480p,,0,0,0,,Niye bu, kötünün çok güçlü olduğu bir devir?Dialogue: 0,0:19:23.95,0:19:27.85,Main-480p,,0,0,0,,Dünyanın en iyi kılıç ustaları korsan veya ödül avcısı.Dialogue: 0,0:19:28.51,0:19:31.69,Main-480p,,0,0,0,,Dünyadaki tüm büyük Meitou'lar onların elinde.Dialogue: 0,0:19:31.69,0:19:33.48,Main-480p,,0,0,0,,Kılıçlar ağlıyor.Dialogue: 0,0:19:35.87,0:19:39.00,Main-480p,,0,0,0,,Evet, farklı insanların farklı şartları var, değil mi?Dialogue: 0,0:19:39.00,0:19:42.16,Main-480p,,0,0,0,,İnsanların uğraşları, çağın gereksinimlerine göre belirlenir.Dialogue: 0,0:19:42.16,0:19:45.07,Main-480p,,0,0,0,,Yemin ederim, bu Shigeru'yla...Dialogue: 0,0:19:45.07,0:19:47.83,Main-480p,,0,0,0,,...bir kılıç ustası olacağım ve yeteneklerimi geliştireceğim!Dialogue: 0,0:19:47.83,0:19:50.60,Main-480p,,0,0,0,,Sonra dünyayı dolaşacağım ve...Dialogue: 0,0:19:50.60,0:19:52.05,Main-480p,,0,0,0,,...Meitouları serserilerden alıp, özgürlüklerine kavuşturacağım!Dialogue: 0,0:19:52.77,0:19:54.81,Main-480p,,0,0,0,,Efsanevi Saijou Oowaza-mono 12.Dialogue: 0,0:19:52.77,0:19:54.81,Main-480p,,0,0,0,,"12 En İyi Dereceli Kılıç"Dialogue: 0,0:19:54.83,0:19:57.02,Main-480p,,0,0,0,,Oowaza-mono 21Dialogue: 0,0:19:54.83,0:19:57.02,Main-480p,,0,0,0,,"21 Çok İyi Dereceli Kılıç"Dialogue: 0,0:19:57.02,0:19:58.99,Main-480p,,0,0,0,,Ryou-Waza-mono 50.Dialogue: 0,0:19:57.02,0:19:58.99,Main-480p,,0,0,0,,"50 İyi Dereceli Kılıç"Dialogue: 0,0:19:58.99,0:20:00.13,Main-480p,,0,0,0,,Bunun için hayatımı riske atacağım!Dialogue: 0,0:20:00.99,0:20:04.84,Main-480p,,0,0,0,,Bu katanayı da alacak mısın? Wadou Ichimonji mi demiştin?Dialogue: 0,0:20:07.57,0:20:10.81,Main-480p,,0,0,0,,Oh! Meitou'ya sahip olmak istediğimi kastetmemiştim!Dialogue: 0,0:20:11.69,0:20:14.77,Main-480p,,0,0,0,,Sadece, onları kötü insanların elinde olmasını istemiyorum, demek istedim.Dialogue: 0,0:20:19.47,0:20:20.65,Thoughts-480p,,0,0,0,,Huh... Bu katana...Dialogue: 0,0:20:21.75,0:20:23.11,Main-480p,,0,0,0,,O katana... yoksa...Dialogue: 0,0:20:25.61,0:20:28.17,Main-480p,,0,0,0,,Evet, bu o. Sandai Kitetsu.Dialogue: 0,0:20:25.61,0:20:28.17,Main-480p,,0,0,0,,"3. Şeytan Biçici"Dialogue: 0,0:20:28.17,0:20:29.54,Main-480p,,0,0,0,,Sandai Kitetsu.Dialogue: 0,0:20:29.54,0:20:33.00,Main-480p,,0,0,0,,Oowaza-mono'dan biri olan Nidai Kitetsu'nun selefi.Dialogue: 0,0:20:29.54,0:20:33.00,Main-480p,,0,0,0,,"2. Şeytan Biçici"Dialogue: 0,0:20:33.00,0:20:36.45,Main-480p,,0,0,0,,Ve Shodai Kitetsu da, Saijou Oowaza-mono'dan biri!Dialogue: 0,0:20:33.00,0:20:36.45,Main-480p,,0,0,0,,"1. Şeytan Biçici"Dialogue: 0,0:20:37.81,0:20:41.24,Main-480p,,0,0,0,,Ojisan, bu katanayı gerçekten sadece 50 bine mi satmak istiyorsun?Dialogue: 0,0:20:41.24,0:20:42.42,Main-480p,,0,0,0,,E-Evet...Dialogue: 0,0:20:42.89,0:20:46.14,Main-480p,,0,0,0,,Müthiş! Bu kılıç zanaatının efsanevi işlerinden biri!Dialogue: 0,0:20:46.14,0:20:48.30,Main-480p,,0,0,0,,Onu, onu almalısın!Dialogue: 0,0:20:49.69,0:20:51.81,Main-480p,,0,0,0,,Değeri bir milyon beli olmalı!Dialogue: 0,0:20:51.81,0:20:54.34,Main-480p,,0,0,0,,Bu harika bir anlaşma!Dialogue: 0,0:20:54.34,0:20:56.15,Main-480p,,0,0,0,,Olmaz! Onu satmayacağım!Dialogue: 0,0:20:56.58,0:21:01.04,Main-480p,,0,0,0,,Ben de öyle düşünmüştüm! O kılıcın 50 bine olmasını tuhaf bulmuştum!Dialogue: 0,0:21:01.04,0:21:02.07,Main-480p,,0,0,0,,Hayır, öyle değil.Dialogue: 0,0:21:12.07,0:21:13.45,Main-480p,,0,0,0,,Lanetli.Dialogue: 0,0:21:15.07,0:21:16.17,Main-480p,,0,0,0,,Biliyor muydun?Dialogue: 0,0:21:17.67,0:21:19.92,Main-480p,,0,0,0,,Hayır, hissediyorum.Dialogue: 0,0:21:19.92,0:21:21.93,Main-480p,,0,0,0,,Shodai Kitetsu'dan başlayarak,...Dialogue: 0,0:21:21.93,0:21:26.95,Main-480p,,0,0,0,,...hepsi mükemmel katanalardır. Ama hepsi lanetlidir!Dialogue: 0,0:21:28.25,0:21:31.20,Main-480p,,0,0,0,,Yıllarca Kitetsu kullanan kılıç ustalarının hepsi...Dialogue: 0,0:21:31.18,0:21:33.31,Main-480p,,0,0,0,,...trajik kaderlerle ve gizemli ölümlerle karşılaştı.Dialogue: 0,0:21:33.31,0:21:37.49,Main-480p,,0,0,0,,Günümüzde, bu dünyada Kitetsu  kullanacak tek bir kılıç ustası bile bulamazsın.Dialogue: 0,0:21:37.49,0:21:41.71,Main-480p,,0,0,0,,Çünkü kılıcı kullanan herkes, öldü!Dialogue: 0,0:21:41.71,0:21:46.78,Main-480p,,0,0,0,,Laneti yüzünden, o lanet olası şeyden kurtulmak istemiştim.Dialogue: 0,0:21:46.78,0:21:50.02,Main-480p,,0,0,0,,Ü-Üzgünüm! Öyle korkunç bir şey olduğu hakkında bir fikrim yoktu!Dialogue: 0,0:21:50.02,0:21:51.97,Main-480p,,0,0,0,,K-Karışmamalıydım!Dialogue: 0,0:21:54.53,0:21:56.75,Main-480p,,0,0,0,,Bunu sevdim. Alacağım!Dialogue: 0,0:21:57.77,0:21:59.91,Main-480p,,0,0,0,,Aptal mısın? Sana satarsam...Dialogue: 0,0:21:59.91,0:22:03.71,Main-480p,,0,0,0,,...ve ölürsen, seni öldürmüş gibi olmayacak mıyım?Dialogue: 0,0:22:03.71,0:22:07.03,Main-480p,,0,0,0,,Aptal olan sensin! Sat gitsin!Dialogue: 0,0:22:07.03,0:22:08.58,Main-480p,,0,0,0,,T-Tatlım!Dialogue: 0,0:22:08.58,0:22:10.01,Main-480p,,0,0,0,,Buna ne dersin?Dialogue: 0,0:22:10.71,0:22:13.47,Main-480p,,0,0,0,,Şansım... ve bu şeyin laneti...Dialogue: 0,0:22:14.09,0:22:16.51,Main-480p,,0,0,0,,Hangisinin daha güçlü olduğunu görelim!Dialogue: 0,0:22:20.61,0:22:21.52,Main-480p,,0,0,0,,Olamaz!Dialogue: 0,0:22:23.52,0:22:27.20,Main-480p,,0,0,0,,Dur!! Keskinliği çok fazladır!! Kolunu kaybedeceksin!Dialogue: 0,0:22:45.67,0:22:46.88,Main-480p,,0,0,0,,Alacağım.Dialogue: 0,0:22:52.33,0:22:54.35,Main-480p,,0,0,0,,Hey. Benim için bir tane daha seç, olur mu?Dialogue: 0,0:22:56.29,0:22:56.93,Main-480p,,0,0,0,,Ah... ah, evet.Dialogue: 0,0:22:56.93,0:22:58.48,Main-480p,,0,0,0,,B-Bekle!Dialogue: 0,0:23:06.81,0:23:09.03,Main-480p,,0,0,0,,Kını, siyah vernikli uzun inlay.Dialogue: 0,0:23:09.95,0:23:11.91,Main-480p,,0,0,0,,Kılıç, küçük 'T' li çözülmüş kenar.Dialogue: 0,0:23:14.25,0:23:16.62,Main-480p,,0,0,0,,Ryou-Waza-mono 50'den biri. Yubashiri!Dialogue: 0,0:23:14.25,0:23:16.62,Main-480p,,0,0,0,,Yubashiri - "Kar Takipçisi"Dialogue: 0,0:23:16.62,0:23:21.37,Main-480p,,0,0,0,,Burası büyük bir dükkan olmayabilir, ama sahip olduğum en iyi katana bu.Dialogue: 0,0:23:21.77,0:23:24.84,Main-480p,,0,0,0,,Onu alamam. Söyledim, değil mi? Param yok.Dialogue: 0,0:23:24.84,0:23:28.92,Main-480p,,0,0,0,,Hayır, parayı unut. O Kitetsu'dan da hiç para istemiyorum.Dialogue: 0,0:23:28.92,0:23:31.45,Main-480p,,0,0,0,,Seni kandırmaya çalıştığım için de üzgünüm.Dialogue: 0,0:23:32.03,0:23:34.23,Main-480p,,0,0,0,,Gerçek bir kılıç ustası görmeyeli uzun bir zaman oldu.Dialogue: 0,0:23:34.23,0:23:36.22,Main-480p,,0,0,0,,"Katana efendisini seçer." derler.Dialogue: 0,0:23:36.22,0:23:38.80,Main-480p,,0,0,0,,İyi talihin için duacı olacağım.Dialogue: 0,0:23:47.43,0:23:50.19,Thoughts-480p,,0,0,0,,Gerçekten, üç kılıç harika hissettiriyor.Dialogue: 0,0:23:50.56,0:23:51.90,Main-480p,,0,0,0,,Hey, hey,...Dialogue: 0,0:23:51.90,0:23:55.51,Main-480p,,0,0,0,,Senin gibi bir pintinin, aile yadigarını verebildiğine inanamıyorum.Dialogue: 0,0:23:55.51,0:23:58.41,Main-480p,,0,0,0,,Bir erkeğin, hayalini başka bir erkeğe geçirmesinin nesi yanlış?!Dialogue: 0,0:23:59.70,0:24:01.77,Main-480p,,0,0,0,,Pekala, çöpü çıkar!Dialogue: 0,0:24:01.77,0:24:02.92,Main-480p,,0,0,0,,T-Tabi, tatlım!Dialogue: 0,0:24:02.92,0:24:06.38,Main-480p,,0,0,0,,Sanırım orada kaybettim. Ayağa bile kalkamadım.Dialogue: 0,0:24:14.26,0:24:15.71,Main-480p,,0,0,0,,O da neyin nesi?Dialogue: 0,0:24:18.01,0:24:19.17,Main-480p,,0,0,0,,Bir bakayım.Dialogue: 0,0:24:27.45,0:24:29.78,Main-480p,,0,0,0,,Şahin Göz! Burada ne yapıyorsun?Dialogue: 0,0:24:30.31,0:24:33.71,Main-480p,,0,0,0,,Kesin sesinizi. Sizinle bir işim yok.Dialogue: 0,0:24:33.71,0:24:35.78,Main-480p,,0,0,0,,Üstleriniz nerede?Dialogue: 0,0:24:37.77,0:24:42.08,Main-480p,,0,0,0,,Böyle bir adada kamp kurarak çok lakayt davranıyor.Dialogue: 0,0:24:44.51,0:24:48.38,Main-480p,,0,0,0,,Patroooon!!Dialogue: 0,0:24:58.01,0:25:01.06,Main-480p,,0,0,0,,Şahin Göz!Dialogue: 0,0:25:05.56,0:25:09.45,Main-480p,,0,0,0,,Selam, Şahin Göz. Görüşmeyeli epey oldu.Dialogue: 0,0:25:10.23,0:25:14.53,Main-480p,,0,0,0,,Şu anda kendimi pek iyi hissetmiyorum. Dövüş için mi geldin?Dialogue: 0,0:25:15.73,0:25:18.23,Main-480p,,0,0,0,,Senin gibi tek kollu bir adama...Dialogue: 0,0:25:18.23,0:25:20.49,Main-480p,,0,0,0,,...meydan okumakla ilgilenmiyorum.Dialogue: 0,0:25:22.21,0:25:24.86,Main-480p,,0,0,0,,Ancak, bazı ilginç korsanlarla karşılaştım.Dialogue: 0,0:25:24.86,0:25:27.88,Main-480p,,0,0,0,,Ve bana uzun zaman önce söylediğin bir şeyi anımsattı.Dialogue: 0,0:25:29.07,0:25:33.30,Main-480p,,0,0,0,,Küçük bir köy ve eğlenceli küçük çocuk hakkındaki hikaye.Dialogue: 0,0:25:34.26,0:25:35.05,Main-480p,,0,0,0,,Olamaz.Dialogue: 0,0:25:42.41,0:25:44.73,Main-480p,,0,0,0,,Demek geliyorsun, Luffy!Dialogue: 0,0:25:46.56,0:25:49.44,Captions-480p,,0,0,160,, Kaptan "Kızıl Saçlı" Shanks Kızıl Saç KorsanlarıDialogue: 0,0:25:47.43,0:25:49.44,Main-480p,,0,0,0,,İyi öyleyse, Şahin Göz.Dialogue: 0,0:25:52.21,0:25:55.55,Main-480p,,0,0,0,,Öylece gitmene izin veremem.Dialogue: 0,0:26:01.33,0:26:03.19,Main-480p,,0,0,0,,Pekala, Şahin Göz!Dialogue: 0,0:26:03.19,0:26:07.25,Main-480p,,0,0,0,,Hadi ama, iç! İç, iç! Bugün parti veriyoruz!Dialogue: 0,0:26:07.89,0:26:09.38,Main-480p,,0,0,0,,Çoktan vermişsin gibi görünüyor.Dialogue: 0,0:26:09.38,0:26:11.87,Main-480p,,0,0,0,,Beni boşver. Kutlama zamanı!Dialogue: 0,0:26:11.87,0:26:13.36,Main-480p,,0,0,0,,Hadi, hadi, hadi, hadi!Dialogue: 0,0:26:13.36,0:26:16.93,Main-480p,,0,0,0,,Fondip! Fondip! Fondip!Dialogue: 0,0:26:18.57,0:26:21.05,Main-480p,,0,0,0,,Bunu sevdim! PARTİ! PARTİ!Dialogue: 0,0:26:22.10,0:26:23.36,Main-480p,,0,0,0,,Ama, patron!Dialogue: 0,0:26:23.35,0:26:26.90,Main-480p,,0,0,0,,Biraz önce çok içmekten içki sersemi olduğunu söylemiştin!Dialogue: 0,0:26:26.90,0:26:30.46,Main-480p,,0,0,0,,Aptal, eğlencemi mahvetme!Dialogue: 0,0:26:30.46,0:26:31.84,Main-480p,,0,0,0,,Epey erken olduğunu düşünmüyor musun?Dialogue: 0,0:26:31.84,0:26:33.57,Main-480p,,0,0,0,,Endişelenme!Dialogue: 0,0:26:34.29,0:26:35.99,Main-480p,,0,0,0,,Hadi İÇELİM!Dialogue: 0,0:26:40.99,0:26:44.02,Main-480p,,0,0,0,,Hey, duydunuz mu? Luffy'nin başına ödül var!Dialogue: 0,0:26:44.02,0:26:45.87,Main-480p,,0,0,0,,Vay! Devam et!Dialogue: 0,0:26:45.87,0:26:48.95,Main-480p,,0,0,0,,Hah, bu köy ünlü bir korsan çıkarttığı için tanınabilir.Dialogue: 0,0:26:48.95,0:26:50.42,Main-480p,,0,0,0,,Fena değil!!Dialogue: 0,0:26:50.42,0:26:53.27,Main-480p,,0,0,0,,AHMAKLAR!Dialogue: 0,0:26:53.27,0:26:54.09,Main-480p,,0,0,0,,S-Sonchou!Dialogue: 0,0:26:54.59,0:26:58.05,Main-480p,,0,0,0,,Köyümüzden kötü birinin çıkmasının nesi mutlu olacak bir şey?Dialogue: 0,0:26:58.05,0:27:00.01,Main-480p,,0,0,0,,Şerefe!Dialogue: 0,0:27:01.97,0:27:05.01,Main-480p,,0,0,0,,Üff! Herkes kendini kaptırmış.Dialogue: 0,0:27:07.03,0:27:10.14,Main-480p,,0,0,0,,Luffy çok mutlu görünüyor.Dialogue: 0,0:27:10.48,0:27:12.77,Main-480p,,0,0,0,,Korsan korsandır.Dialogue: 0,0:27:14.69,0:27:17.32,Flashbacks-480p,,0,0,0,,Ben korsan olacağım!Dialogue: 0,0:27:17.73,0:27:22.95,Main-480p,,0,0,0,,Ama bu onun hayali. Endişelendin mi?Dialogue: 0,0:27:24.53,0:27:27.78,Main-480p,,0,0,0,,Hayal? Ya da kader?Dialogue: 0,0:01:50.33,0:02:00.33,Author,,0,0,0,, Türkçeleştirme  onepacetr.netDialogue: 0,0:14:20.00,0:14:30.00,Author,,0,0,0,, Türkçeleştirme  onepacetr.netDialogue: 0,0:27:15.00,0:27:25.00,Author,,0,0,0,, Türkçeleştirme  onepacetr.net