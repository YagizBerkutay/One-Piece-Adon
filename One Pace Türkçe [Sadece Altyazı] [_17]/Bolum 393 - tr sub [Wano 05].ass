15,15,1Style: Translation,Duality,82,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,4.5,0,2,15,15,15,1Style: Sign-OP,Captain Redemption,375,&H0015181B,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0,0,2,15,15,15,1Style: Sign-Wano,KG Ten Thousand Reasons Alt,60,&H005B57D2,&H000000FF,&H00000000,&H00000000,-1,0,0,0,100,100,0,0,1,0,0,2,15,15,15,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:41.87,0:01:51.86,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 50,0:01:51.75,0:01:54.26,Main-207+,,0,0,0,,Gözlerini açtın demek?Dialogue: 50,0:01:56.97,0:01:59.71,Main-207+,,0,0,0,,Ağabey! Hanımefendi!Dialogue: 50,0:01:59.71,0:02:01.34,Main-207+,,0,0,0,,Neredeyim böyle?Dialogue: 50,0:02:02.26,0:02:03.89,Main-207+,,0,0,0,,Çay evimdesin.Dialogue: 50,0:02:05.60,0:02:07.07,Main-207+,,0,0,0,,Otama-chan!Dialogue: 50,0:02:09.36,0:02:10.91,Main-207+,,0,0,0,,Miden ne durumda?Dialogue: 50,0:02:13.06,0:02:14.94,Main-207+,,0,0,0,,Ağrı sızı var mı?Dialogue: 50,0:02:22.39,0:02:25.70,Main-207+,,0,0,0,,Kendimi harika hissediyorum!Dialogue: 50,0:02:27.50,0:02:29.33,Main-207+,,0,0,0,,Amma da çabuk tesir etti!Dialogue: 50,0:02:30.48,0:02:33.67,Main-207+,,0,0,0,,Beşparmak otu, şaşırtıcı biçimde etkili bir ilaçtır.Dialogue: 50,0:02:33.67,0:02:36.58,Main-207+,,0,0,0,,Hepinize minnettarım!Dialogue: 50,0:02:37.47,0:02:40.32,Main-207+,,0,0,0,,Nin-nin!Dialogue: 50,0:02:40.32,0:02:41.01,Main-207+,,0,0,0,,Fakat...Dialogue: 50,0:02:43.24,0:02:46.47,Main-207+,,0,0,0,,vücudundaki zehir tamamen atılmış değil.Dialogue: 50,0:02:46.47,0:02:51.73,Main-207+,,0,0,0,,O yüzden bir daha nehir suyundan içmek yok, Otama-chan.Dialogue: 50,0:02:51.73,0:02:53.98,Main-207+,,0,0,0,,Tamam, anlaşıldı!Dialogue: 50,0:02:58.15,0:03:01.57,Main-207+,,0,0,0,,Guruldamasana midem! Bir savaşçıya hiç yakışmıyor!Dialogue: 50,0:03:01.57,0:03:03.45,Main-207+,,0,0,0,,Su içmeliyim!Dialogue: 50,0:03:03.45,0:03:05.95,Main-207+,,0,0,0,,Nehir!Dialogue: 50,0:03:05.95,0:03:09.29,Main-207+,,0,0,0,,Otama-chan! Dur bakalım!Dialogue: 50,0:03:15.71,0:03:17.55,Main-207+,,0,0,0,,Nehir suyu...Dialogue: 50,0:03:17.55,0:03:18.92,Main-207+,,0,0,0,,Ha?Dialogue: 50,0:03:18.92,0:03:20.05,Main-207+,,0,0,0,,Ne?!Dialogue: 50,0:03:20.05,0:03:22.09,Main-207+,,0,0,0,,Nehir suyundan...Dialogue: 50,0:03:22.09,0:03:24.97,Main-207+,,0,0,0,,içmek yok!Dialogue: 50,0:03:27.14,0:03:31.69,Main-207+,,0,0,0,,Tamamdır, bitirdim. Alt tarafı ilk yardım oldu gerçi.Dialogue: 50,0:03:31.69,0:03:33.98,Main-207+,,0,0,0,,Tamamdır, teşekkürler.Dialogue: 50,0:03:36.46,0:03:38.78,Main-207+,,0,0,0,,Epey uzunmuşsun ha.Dialogue: 50,0:03:40.70,0:03:44.20,Main-207+,,0,0,0,,Big Mom çok daha büyük bir kadındı ama.Dialogue: 50,0:03:45.52,0:03:51.08,Main-207+,,0,0,0,,Sumo güreşçisi bana asılırken müdahale ettiğin için de teşekkürler.Dialogue: 50,0:03:53.59,0:03:55.67,Main-207+,,0,0,0,,Bir şey yapmadım ki.Dialogue: 50,0:03:57.63,0:04:00.40,Main-207+,,0,0,0,,Kendimi tanıtmadığım için affedin.Dialogue: 50,0:04:00.40,0:04:04.68,Main-207+,,0,0,0,,Ben (sessha) Okiku.Dialogue: 50,0:04:05.23,0:04:06.26,Main-207+,,0,0,0,,Sessha mı?Dialogue: 50,0:04:09.50,0:04:10.64,Main-207+,,0,0,0,,Ne?Dialogue: 50,0:04:12.56,0:04:14.98,Main-207+,,0,0,0,,Olmaz, yiyemem! Olmaz olmaz!Dialogue: 50,0:04:21.53,0:04:24.95,Main-207+,,0,0,0,,Lütfen önümden alın, hanımefendi!Dialogue: 50,0:04:28.79,0:04:32.25,Main-207+,,0,0,0,,Daha hazırladığınız ilaca verecek param yokken...Dialogue: 50,0:04:32.25,0:04:35.37,Main-207+,,0,0,0,,kırmızı fasulye çorbasını nasıl öderim?Dialogue: 50,0:04:41.71,0:04:44.01,Main-207+,,0,0,0,,Para isteyen yok canım.Dialogue: 50,0:04:45.10,0:04:45.76,Main-207+,,0,0,0,,Hayır!Dialogue: 50,0:04:46.49,0:04:47.68,Main-207+,,0,0,0,,Kabul edemem!Dialogue: 50,0:04:50.81,0:04:55.52,Main-207+,,0,0,0,,Okiku-san'la sizin de kıt kanaat geçindiğinizi biliyorum!Dialogue: 50,0:04:55.52,0:04:57.90,Main-207+,,0,0,0,,Sorun yok, çekinme.Dialogue: 50,0:04:58.64,0:05:02.94,Main-207+,,0,0,0,,Zaten hayatımı kurtarmışken bir de yemek ikram ediyorsunuz!Dialogue: 50,0:05:02.94,0:05:05.74,Main-207+,,0,0,0,,Nasıl kabul edebilirim ki?Dialogue: 50,0:05:05.74,0:05:06.99,Main-207+,,0,0,0,,Sorun yok!Dialogue: 50,0:05:06.99,0:05:08.16,Main-207+,,0,0,0,,Var!Dialogue: 50,0:05:08.16,0:05:09.33,Main-207+,,0,0,0,,Yok dedim!Dialogue: 50,0:05:09.33,0:05:12.62,Main-207+,,0,0,0,,İlacın parasını da mutlaka ödeyeceğim!Dialogue: 50,0:05:19.57,0:05:22.55,Main-207+,,0,0,0,,Yeter be!Dialogue: 50,0:05:22.55,0:05:23.51,Main-207+,,0,0,0,,Ne?Dialogue: 50,0:05:23.51,0:05:26.22,Main-207+,,0,0,0,,Bir kadın yemek hazırlamışken...Dialogue: 50,0:05:26.76,0:05:27.84,Main-207+,,0,0,0,,"İstemiyorum."Dialogue: 50,0:05:27.84,0:05:28.97,Main-207+,,0,0,0,,"Peki o zaman."Dialogue: 50,0:05:29.43,0:05:33.14,Main-207+,,0,0,0,,diye kestirip atacağını mı sanıyorsun?Dialogue: 50,0:05:35.25,0:05:37.35,Main-207+,,0,0,0,,Yemezsen bak...Dialogue: 50,0:05:38.60,0:05:41.57,Main-207+,,0,0,0,,sokağın ortasına döküveririm!Dialogue: 50,0:05:43.07,0:05:45.10,Main-207+,,0,0,0,,Olamaz!Dialogue: 50,0:05:45.59,0:05:47.24,Main-207+,,0,0,0,,Otama-chan, ye gitsin!Dialogue: 50,0:05:47.24,0:05:50.70,Main-207+,,0,0,0,,Otsuru-san geri çevrilmeye gelemez.Dialogue: 50,0:06:01.80,0:06:03.80,Main-207+,,0,0,0,,Daha ne kadar öyle bakacaksın?Dialogue: 50,0:06:03.80,0:06:08.89,Main-207+,,0,0,0,,Hadi yine iyisin! Bugün de doğum günün zaten!Dialogue: 50,0:06:08.89,0:06:10.68,Main-207+,,0,0,0,,Öyle mi?Dialogue: 50,0:06:11.23,0:06:12.64,Main-207+,,0,0,0,,Duyduğum kadarıyla.Dialogue: 50,0:06:12.64,0:06:16.57,Main-207+,,0,0,0,,Öyleyse bir hediye olarak görüp...Dialogue: 50,0:06:17.03,0:06:18.35,Main-207+,,0,0,0,,ye hadi.Dialogue: 50,0:07:08.82,0:07:12.07,Main-207+,,0,0,0,,Çok güzel ya!Dialogue: 50,0:07:13.82,0:07:17.54,Main-207+,,0,0,0,,Çorba enfes olmuş!Dialogue: 50,0:07:18.83,0:07:19.69,Main-207+,,0,0,0,,Ne?Dialogue: 50,0:07:20.45,0:07:23.54,Main-207+,,0,0,0,,İlk kez mi yiyorsun yoksa?Dialogue: 50,0:07:23.54,0:07:24.59,Main-207+,,0,0,0,,Evet!Dialogue: 50,0:07:27.34,0:07:32.09,Flashbacks-207+,,0,0,0,,Sence en son kaç gün önce bir şey yemiştir, ha?!Dialogue: 50,0:07:32.09,0:07:37.38,Flashbacks-207+,,0,0,0,,Gece gündüz canla başla şapka örüp hepsini satmayı becerse de...Dialogue: 50,0:07:37.38,0:07:41.48,Flashbacks-207+,,0,0,0,,güç bela bir boğaza yetecek kadar kazanabiliyor!Dialogue: 50,0:07:50.95,0:07:53.67,Main-207+,,0,0,0,,İçinde mochi de var!Dialogue: 50,0:07:54.38,0:07:56.95,Main-207+,,0,0,0,,Ne kadar pahalı bir yiyecek!Dialogue: 50,0:08:00.09,0:08:02.21,Main-207+,,0,0,0,,Onları yanağından da çıkarabilirsin ya.Dialogue: 50,0:08:04.51,0:08:07.29,Main-207+,,0,0,0,,Tokluk hissi vermiyorlar.Dialogue: 50,0:08:07.29,0:08:10.26,Main-207+,,0,0,0,,Enfes!Dialogue: 50,0:08:13.00,0:08:16.43,Main-207+,,0,0,0,,Hanımefendi! Ne kadar teşekkür etsem azdır!Dialogue: 50,0:08:18.85,0:08:23.31,Main-207+,,0,0,0,,Bir daha bu kadar güzel bir doğum günüm olacağını sanmam!Dialogue: 50,0:08:24.18,0:08:26.87,Main-207+,,0,0,0,,Muhterem üstadım için biraz üzülsem de!Dialogue: 50,0:08:33.80,0:08:34.99,Main-207+,,0,0,0,,Otsuru-san...Dialogue: 50,0:08:43.58,0:08:47.70,Main-207+,,0,0,0,,Bugün hayatımın en mutlu günü!Dialogue: 50,0:09:06.81,0:09:09.61,Main-207+,,0,0,0,,O durumdaki çocukları her yerde görürsün.Dialogue: 50,0:09:10.67,0:09:12.88,Main-207+,,0,0,0,,Günümüz Wano'sunda.Dialogue: 50,0:09:12.88,0:09:17.45,Main-207+,,0,0,0,,Böyle küçük bir çocuğun karnını tıka basa doyuramaması akıl alır değil!Dialogue: 50,0:09:17.45,0:09:21.60,Main-207+,,0,0,0,,Tabii, yetişkin olunca zehri sindirebilir.Dialogue: 50,0:09:21.60,0:09:22.58,Main-207+,,0,0,0,,Yok, sindiremez!Dialogue: 50,0:09:23.16,0:09:28.96,Main-207+,,0,0,0,,Deniz, dağlar ve ormanlar varken yemek bulmak sorun olmamalı.Dialogue: 50,0:09:29.93,0:09:31.09,Main-207+,,0,0,0,,Kesinlikle.Dialogue: 50,0:09:31.71,0:09:34.88,Main-207+,,0,0,0,,Kendi ellerimizle onları kirletmemişsek tabii.Dialogue: 50,0:09:38.97,0:09:40.64,Main-207+,,0,0,0,,Aşağılık Kaido!Dialogue: 50,0:09:41.68,0:09:42.97,Main-207+,,0,0,0,,Aynen.Dialogue: 50,0:09:46.19,0:09:48.48,Main-207+,,0,0,0,,Pek de anlayışlı delikanlılarsınız.Dialogue: 50,0:09:49.35,0:09:52.07,Main-207+,,0,0,0,,Sahi! İsimleriniz nedir?Dialogue: 50,0:09:53.56,0:09:56.17,Main-207+,,0,0,0,,Ben Zorojuro.Dialogue: 50,0:09:56.17,0:09:57.49,Main-207+,,0,0,0,,Bir roninim.Dialogue: 50,0:09:58.40,0:09:59.87,Main-207+,,0,0,0,,Ben de Money D.–Dialogue: 50,0:10:12.78,0:10:14.43,Main-207+,,0,0,0,,Arkadaşın adı...Dialogue: 50,0:10:17.33,0:10:18.43,Main-207+,,0,0,0,,Luffytaro.Dialogue: 50,0:10:18.43,0:10:19.61,Main-207+,,0,0,0,,Ne?Dialogue: 50,0:10:20.30,0:10:22.43,Main-207+,,0,0,0,,E-Evet.Dialogue: 50,0:10:24.55,0:10:25.98,Main-207+,,0,0,0,,Adım Luffytaro!Dialogue: 50,0:10:26.77,0:10:27.90,Main-207+,,0,0,0,,Şey...Dialogue: 50,0:10:27.90,0:10:29.10,Main-207+,,0,0,0,,...-gozaru.Dialogue: 50,0:10:33.61,0:10:35.11,Main-207+,,0,0,0,,Buralı değilsiniz galiba?Dialogue: 50,0:10:36.19,0:10:38.49,Main-207+,,0,0,0,,Ülkeye girebilmenize şaşırdım.Dialogue: 50,0:10:38.49,0:10:40.20,Main-207+,,0,0,0,,Nereden anladın?Dialogue: 50,0:10:40.20,0:10:42.02,Main-207+,,0,0,0,,Bir tuhaf konuşuyorsunuz.Dialogue: 50,0:10:42.02,0:10:42.99,Main-207+,,0,0,0,,– Ne?! – Ne?!Dialogue: 50,0:10:42.99,0:10:46.80,Main-207+,,0,0,0,,Merak etmeyin, kimseye söylemem.Dialogue: 50,0:10:48.79,0:10:51.81,Main-207+,,0,0,0,,Ben de kasabaya yeni geldim.Dialogue: 50,0:10:51.81,0:10:56.34,Main-207+,,0,0,0,,Okiku-chan ise bir aydır yanımda çalışıyor.Dialogue: 50,0:10:57.34,0:11:00.05,Main-207+,,0,0,0,,Kasabanın adının Okobore olduğunu işittim.Dialogue: 50,0:11:00.05,0:11:02.44,Main-207+,,0,0,0,,Ne biçim bir isim konmuş?Dialogue: 50,0:11:02.44,0:11:03.97,Main-207+,,0,0,0,,Adından anlaşılacağı üzere...Dialogue: 50,0:11:05.01,0:11:10.70,Main-207+,,0,0,0,,ülkeyi yönetenlerin kaldığı kasabadan artıklara bel bağlamış insanlar buraya geliyor.Dialogue: 50,0:11:11.25,0:11:14.90,Main-207+,,0,0,0,,Tama falanca yerde sağlıklı yemek olduğunu söylemişti.Dialogue: 50,0:11:14.90,0:11:17.03,Main-207+,,0,0,0,,Bakın, şurası işte.Dialogue: 50,0:11:19.02,0:11:21.60,Main-207+,,0,0,0,,Zirvesinde sis olmayan dağı görüyor musunuz?Dialogue: 50,0:11:22.18,0:11:26.70,Main-207+,,0,0,0,,Bir zamanlar orada Oden isminde bir kale vardı.Dialogue: 50,0:11:27.80,0:11:30.92,Main-207+,,0,0,0,,20 yıl önceydi gerçi.Dialogue: 50,0:11:30.92,0:11:36.13,Main-207+,,0,0,0,,Oden adını... İşitmiştim, neydi ki?Dialogue: 50,0:11:37.13,0:11:39.45,Main-207+,,0,0,0,,20 yıl evveline kadar...Dialogue: 50,0:11:40.12,0:11:45.06,Main-207+,,0,0,0,,Wano'yu yıllar boyunca Kozuki isimli bir hane yönetiyordu.Dialogue: 50,0:11:48.11,0:11:52.93,Main-207+,,0,0,0,,Dağın eteklerine kadar inen koca tarlayı...Dialogue: 50,0:11:52.93,0:11:56.21,Main-207+,,0,0,0,,merhum Oden-sama...Dialogue: 50,0:11:56.21,0:12:00.46,Main-207+,,0,0,0,,tüm Kuri halkını enfes yiyeceklerle beslemek adına yapmıştı.Dialogue: 50,0:12:19.46,0:12:26.39,Main-207+,,0,0,0,,Orochiler'in ülkenin gıda stoğunu tekeline alması için değil.Dialogue: 50,0:12:29.49,0:12:31.60,Main-207+,,0,0,0,,Cennet Tarlası'nı o amaçla yapmadı.Dialogue: 50,0:12:34.09,0:12:35.52,Main-207+,,0,0,0,,Duydum!Dialogue: 50,0:12:35.52,0:12:39.57,Main-207+,,0,0,0,,Tarlada zehirli olmayan gıdalar var mı peki?Dialogue: 50,0:12:40.68,0:12:41.82,Main-207+,,0,0,0,,Var.Dialogue: 50,0:12:42.62,0:12:47.03,Main-207+,,0,0,0,,Sağlıklı, enfes yemeklerle temiz su ve kıyafetlerin...Dialogue: 50,0:12:47.03,0:12:53.28,Main-207+,,0,0,0,,hepsi de şogun Orochi'nin malıdır!Dialogue: 50,0:12:57.07,0:13:01.05,Main-207+,,0,0,0,,Tapınak kapısının ardında ülkeyi yönetenlerin kasabası bulunuyor.Dialogue: 50,0:13:01.69,0:13:08.26,Main-207+,,0,0,0,,Yaşamak için, çürümüş yemeklerini ve çöplerini bize satsınlar diye ayaklarına kapanıyoruz.Dialogue: 50,0:13:10.29,0:13:12.27,Main-207+,,0,0,0,,Okobore ismi buradan geliyor yani.Dialogue: 50,0:13:10.29,0:13:12.27,Note-207+,,0,0,0,,Okobore: ArtıkDialogue: 50,0:13:12.27,0:13:16.77,Main-207+,,0,0,0,,Ama idare ediyoruz. En azından hayatta kalabiliyoruz.Dialogue: 50,0:14:04.31,0:14:08.36,Main-207+,,0,0,0,,Ne yaptığını sanıyorsun lan? İşime karışma!Dialogue: 50,0:14:09.66,0:14:12.77,Main-207+,,0,0,0,,Ağzından çıkanları duydum kadın!Dialogue: 50,0:14:12.77,0:14:15.62,Main-207+,,0,0,0,,Şogunu kötülüyordun!Dialogue: 50,0:14:17.75,0:14:21.50,Main-207+,,0,0,0,,İşitme duyum normal insanlara göre altı kat daha hassastır!Dialogue: 50,0:14:21.50,0:14:24.59,Main-207+,,0,0,0,,Şoguna atılan hiçbir laf kulaklarımdan kaçmaz!Dialogue: 50,0:14:28.27,0:14:30.43,Main-207+,,0,0,0,,Duyduğunu anladık da...Dialogue: 50,0:14:30.43,0:14:33.26,Main-207+,,0,0,0,,can almak için yeterli bir sebep mi?Dialogue: 50,0:14:34.04,0:14:36.06,Main-207+,,0,0,0,,İsabet etse ölürdü.Dialogue: 50,0:14:38.28,0:14:42.19,Main-207+,,0,0,0,,Etliye sütlüye karışmadan yaşarsanız genelde musallat olmam!Dialogue: 50,0:14:43.22,0:14:44.86,Main-207+,,0,0,0,,Lakin Orochi-sama...Dialogue: 50,0:14:44.86,0:14:50.32,Main-207+,,0,0,0,,baş kaldıran bir konuşmaya hayatta göz yummaz!Dialogue: 50,0:15:24.98,0:15:26.32,Main-207+,,0,0,0,,Oklarım!Dialogue: 50,0:15:27.23,0:15:29.74,Main-207+,,0,0,0,,Hepsini durdurdu!Dialogue: 50,0:15:29.74,0:15:32.01,Main-207+,,0,0,0,,Sen de kimin nesisin?Dialogue: 50,0:15:32.01,0:15:36.03,Main-207+,,0,0,0,,Birkaç haftadır tarlada hırsızlık vakaları oluyor.Dialogue: 50,0:15:36.03,0:15:40.25,Main-207+,,0,0,0,,Şu an hırsızı aramak için buradayız hatta!Dialogue: 50,0:15:40.25,0:15:43.42,Main-207+,,0,0,0,,Yoksa siz misiniz lan?Dialogue: 50,0:15:49.59,0:15:51.84,Main-207+,,0,0,0,,Tek gözü olan ronin mi?Dialogue: 50,0:15:55.23,0:15:58.02,Main-207+,,0,0,0,,Aranıyor posterlerinde adını görmüştüm!Dialogue: 50,0:16:14.16,0:16:16.70,Main-207+,,0,0,0,,Bırak beni!Dialogue: 50,0:16:17.58,0:16:19.45,Main-207+,,0,0,0,,Sen de kimsin?Dialogue: 50,0:16:20.22,0:16:21.37,Main-207+,,0,0,0,,Otama-chan!Dialogue: 50,0:16:22.96,0:16:25.46,Main-207+,,0,0,0,,Yardım et!Dialogue: 50,0:16:25.46,0:16:28.42,Main-207+,,0,0,0,,Ağabey!Dialogue: 50,0:16:29.70,0:16:30.59,Main-207+,,0,0,0,,Tama...Dialogue: 50,0:16:32.09,0:16:34.47,Main-207+,,0,0,0,,Tama!Dialogue: 50,0:16:36.86,0:16:39.06,Main-207+,,0,0,0,,Görev tamamlandı!Dialogue: 50,0:16:42.35,0:16:45.02,Main-207+,,0,0,0,,Tama'yı bırak lan!Dialogue: 50,0:16:58.74,0:17:00.29,Main-207+,,0,0,0,,Okiku-chan!Dialogue: 50,0:17:08.38,0:17:09.88,Main-207+,,0,0,0,,Kılıç mı?Dialogue: 50,0:17:11.97,0:17:13.38,Main-207+,,0,0,0,,Çok hızlı!Dialogue: 50,0:17:13.80,0:17:15.88,Main-207+,,0,0,0,,Bırak ya!Dialogue: 50,0:17:16.26,0:17:18.64,Main-207+,,0,0,0,,Uslu dur, boklu velet!Dialogue: 50,0:17:18.97,0:17:21.35,Main-207+,,0,0,0,,Beni sırtına al, aslan köpek-kun!Dialogue: 50,0:17:26.95,0:17:27.84,Main-207+,,0,0,0,,Köpek!Dialogue: 50,0:17:35.15,0:17:37.95,Main-207+,,0,0,0,,Kadın kılıç taşıyor!Dialogue: 50,0:17:37.95,0:17:39.91,Main-207+,,0,0,0,,Kullanmayı bildiğini söylemişti.Dialogue: 50,0:17:41.56,0:17:43.75,Main-207+,,0,0,0,,Kullanırken hiç görmedim gerçi.Dialogue: 50,0:17:46.71,0:17:48.58,Main-207+,,0,0,0,,Köpek!Dialogue: 50,0:17:48.58,0:17:50.84,Main-207+,,0,0,0,,Beni de al!Dialogue: 50,0:17:54.50,0:17:55.42,Main-207+,,0,0,0,,Kolu...Dialogue: 50,0:17:57.63,0:17:59.47,Main-207+,,0,0,0,,Bekle!Dialogue: 50,0:17:59.47,0:18:01.52,Main-207+,,0,0,0,,Ben de geliyorum!Dialogue: 50,0:18:01.52,0:18:02.31,Main-207+,,0,0,0,,Tamam!Dialogue: 50,0:18:05.73,0:18:07.93,Main-207+,,0,0,0,,Ağzına sıçtıklarım!Dialogue: 50,0:18:11.49,0:18:14.11,Main-207+,,0,0,0,,Luffytaro-san! Zorojuro-san!Dialogue: 50,0:18:17.04,0:18:19.49,Main-207+,,0,0,0,,Veletten ne istiyorlar ki?Dialogue: 50,0:18:19.49,0:18:23.12,Main-207+,,0,0,0,,Bilmiyorum ama derhâl kurtarmalıyız!Dialogue: 50,0:18:25.37,0:18:27.78,Main-207+,,0,0,0,,Tama!Dialogue: 50,0:18:27.78,0:18:30.83,Main-207+,,0,0,0,,Seni hemen kurtaracağım!Dialogue: 50,0:18:31.39,0:18:33.75,Main-207+,,0,0,0,,Ağabey!Dialogue: 50,0:18:38.18,0:18:41.01,Main-207+,,0,0,0,,Ceylan Adam! Bas git artık!Dialogue: 50,0:18:41.01,0:18:43.31,Main-207+,,0,0,0,,Tamamdır!Dialogue: 50,0:18:47.93,0:18:50.40,Main-207+,,0,0,0,,Çok yazık!Dialogue: 50,0:18:53.52,0:18:55.13,Main-207+,,0,0,0,,Hay içine!Dialogue: 50,0:18:55.13,0:18:58.04,Main-207+,,0,0,0,,Planlı bir kaçırma olduğuna kalıbımı basarım.Dialogue: 50,0:18:58.04,0:19:02.23,Main-207+,,0,0,0,,Bir öncünün emri olmalı!Dialogue: 50,0:19:02.23,0:19:05.66,Main-207+,,0,0,0,,Ayrıca o yön tek bir yere çıkıyor.Dialogue: 50,0:19:07.67,0:19:09.50,Main-207+,,0,0,0,,Yetkililer kasabasına.Dialogue: 50,0:19:11.79,0:19:12.75,Main-207+,,0,0,0,,Defter mi?Dialogue: 50,0:19:13.47,0:19:16.26,Main-207+,,0,0,0,,Kasabada üç öncü var.Dialogue: 50,0:19:17.15,0:19:18.36,Main-207+,,0,0,0,,Hawkins.Dialogue: 50,0:19:19.34,0:19:20.39,Main-207+,,0,0,0,,Holdem.Dialogue: 50,0:19:21.57,0:19:23.30,Main-207+,,0,0,0,,Speed.Dialogue: 50,0:19:23.30,0:19:24.79,Main-207+,,0,0,0,,Ayrıca...Dialogue: 50,0:19:25.14,0:19:30.51,Main-207+,,0,0,0,,esrarengiz suni meyvelerden özel yetenekler kazanan 30 kadar da savaşçı var.Dialogue: 50,0:19:32.73,0:19:36.58,Main-207+,,0,0,0,,Sıradan bir kadın değilsin.Dialogue: 50,0:19:38.77,0:19:40.21,Main-207+,,0,0,0,,Kimsin?Dialogue: 50,0:19:47.20,0:19:48.66,Main-207+,,0,0,0,,Ben(sessha)...Dialogue: 50,0:19:50.25,0:19:51.53,Main-207+,,0,0,0,,samurayım!Dialogue: 50,0:19:58.82,0:20:02.09,Main-207+,,0,0,0,,Holdem-sama! Ceylan Adam konuşuyor!Dialogue: 50,0:20:02.66,0:20:08.44,Main-207+,,0,0,0,,Raporlarda babunu evcilleştirdiği yazan veledi yakaladım!Dialogue: 50,0:20:09.56,0:20:12.85,Main-207+,,0,0,0,,Bıraksana ya!Dialogue: 50,0:20:13.87,0:20:16.28,Main-207+,,0,0,0,,Aferin.Dialogue: 50,0:20:16.28,0:20:18.82,Main-207+,,0,0,0,,Bize faydası dokunacaktır.Dialogue: 50,0:20:19.38,0:20:20.77,Main-207+,,0,0,0,,Getir hele.Dialogue: 50,0:20:20.77,0:20:21.60,Main-207+,,0,0,0,,Başüstüne!Dialogue: 50,0:20:36.89,0:20:40.67,Main-207+,,0,0,0,,Luffy ağabey!Dialogue: 50,0:20:44.03,0:20:49.12,Narrator-207+,,0,0,0,,Wano'nun Kuri bölgesindeki güllük gülistanlık Bakura Kasabası.Dialogue: 50,0:20:59.36,0:21:00.48,Main-207+,,0,0,0,,Ulan!Dialogue: 50,0:21:02.94,0:21:05.32,Main-207+,,0,0,0,,Tipini siktiğimin ronini!Dialogue: 50,0:21:05.32,0:21:08.86,Main-207+,,0,0,0,,Tuhaf ve güçlü aurası yüzünden geri vites yapmış olsam da...Dialogue: 50,0:21:08.86,0:21:13.81,Main-207+,,0,0,0,,ne pahasına olursa olsun Okiku'yu karım yapmak istiyorum-pe!Dialogue: 50,0:21:15.08,0:21:20.06,Main-207+,,0,0,0,,Nüfuz desen var, şanım da sağlıklı gıda desteğim de var.Dialogue: 50,0:21:21.70,0:21:24.63,Main-207+,,0,0,0,,Teklifimi geri çevirmesi mümkün değil-pe!Dialogue: 50,0:21:29.43,0:21:33.31,Main-207+,,0,0,0,,Siktiriboktan işleri kafana takmasana dangalak!Dialogue: 50,0:21:34.83,0:21:37.32,Main-207+,,0,0,0,,Okobore Kasabası'ndan bir kız, değil mi?Dialogue: 50,0:21:37.32,0:21:42.43,Main-207+,,0,0,0,,Orochi-sama'nın hükmetmeye tenezzül dahi etmediği lümpenler.Dialogue: 50,0:21:45.74,0:21:49.12,Main-207+,,0,0,0,,Seni sevip sevmediğini kim takar?Dialogue: 50,0:21:49.12,0:21:52.61,Main-207+,,0,0,0,,Zorla karın yap olsun bitsin!Dialogue: 50,0:21:52.61,0:21:55.08,Main-207+,,0,0,0,,İster evini yakıp küle çevir...Dialogue: 50,0:21:55.90,0:22:00.60,Main-207+,,0,0,0,,ister gidecek kimsesi kalmaması için tüm soyunun kökünü kazı.Dialogue: 50,0:22:01.15,0:22:06.17,Main-207+,,0,0,0,,Elindeki her şeyi alarak sana muhtaç duruma düşür!Dialogue: 50,0:22:09.30,0:22:12.06,Main-207+,,0,0,2,,Samuray sınıfındansın!Dialogue: 50,0:22:12.06,0:22:16.77,Main-207+,,0,0,2,,Wano'da gayet net bir hiyerarşi vardır.Dialogue: 50,0:22:21.77,0:22:26.90,Main-207+,,0,0,0,,Milli sporumuzun senin gibi bir yıldızı, lümpenin tekini sikine takarsa...Dialogue: 50,0:22:27.61,0:22:30.76,Main-207+,,0,0,0,,yoldaşlarımıza hiç iyi örnek olmaz!Dialogue: 50,0:22:33.74,0:22:35.45,Main-207+,,0,0,0,,İyi dedin!Dialogue: 50,0:22:36.91,0:22:41.25,Main-207+,,0,0,0,,Harbi lan! Okiku'ya istediğimi yapabilirim!Dialogue: 50,0:22:45.03,0:22:48.63,Main-207+,,0,0,0,,Yokozuna... Yemeği mi beğenmediniz efendim?Dialogue: 50,0:22:52.97,0:22:55.43,Main-207+,,0,0,0,,Elindeki tanuki, değil mi?Dialogue: 50,0:22:55.43,0:22:59.64,Main-207+,,0,0,0,,Evet, uzun zamandır ailemizin parçası olan bir hayvan.Dialogue: 50,0:22:59.94,0:23:02.05,Main-207+,,0,0,0,,Pişir bakalım!Dialogue: 50,0:23:02.05,0:23:02.98,Main-207+,,0,0,0,,Ne?Dialogue: 50,0:23:04.77,0:23:07.44,Main-207+,,0,0,0,,Tanuki etine bayılırım!Dialogue: 50,0:23:34.45,0:23:36.28,Main-207+,,0,0,0,,Nihayet kavuşabildik.Dialogue: 50,0:23:51.24,0:23:53.04,Main-207+,,0,0,0,,Girişi gördüm!Dialogue: 50,0:23:57.54,0:23:58.79,Main-207+,,0,0,0,,Zor kullanarak gireceğiz!Dialogue: 50,0:23:58.79,0:24:00.96,Main-207+,,0,0,0,,Luffytaro-sanlar!Dialogue: 50,0:24:01.83,0:24:05.92,Main-207+,,0,0,0,,Buradan ötesi Bakura Kasabası! Yetkililerin ve korsanların ini!Dialogue: 50,0:24:06.54,0:24:08.63,Main-207+,,0,0,0,,Sağ döneceğimizin bir garantisi yok!Dialogue: 50,0:24:13.67,0:24:15.89,Main-207+,,0,0,0,,Buna hazır mısınız?Dialogue: 50,0:24:17.23,0:24:18.22,Main-207+,,0,0,0,,- Evet! - Ayıpsın!Dialogue: 50,0:24:23.70,0:24:25.29,Main-207+,,0,0,0,,Bu o mu?Dialogue: 50,0:24:28.04,0:24:29.94,Main-207+,,0,0,0,,Zavallıcık.Dialogue: 50,0:24:30.69,0:24:33.41,Main-207+,,0,0,0,,Dokunsan ağlayacak.Dialogue: 50,0:24:37.08,0:24:39.51,Main-207+,,0,0,0,,Ağlamayacağım!Dialogue: 50,0:24:44.33,0:24:46.49,Main-207+,,0,0,0,,Sert kız ayaklarını geç lan!Dialogue: 50,0:24:59.10,0:24:59.60,Main-207+,,0,0,0,,Ah...Dialogue: 50,0:25:09.79,0:25:12.03,Main-207+,,0,0,0,,Dalağım fena şişti!Dialogue: 50,0:25:15.29,0:25:18.07,Main-207+,,0,0,0,,Kes sesini, Ceylan Adam!Dialogue: 50,0:25:26.88,0:25:31.52,Main-207+,,0,0,0,,Yıkıl karşımdan! Derinden soluman sinirime dokunuyor!Dialogue: 50,0:25:38.68,0:25:42.32,Main-207+,,0,0,0,,Kondisyon kassana, seni sersem!Dialogue: 50,0:25:50.10,0:25:52.73,Main-207+,,0,0,0,,Sana demedik lan!Dialogue: 50,0:25:53.56,0:25:58.24,Main-207+,,0,0,0,,Zırt pırt yan gözle bakma!Dialogue: 50,0:26:16.13,0:26:19.03,Main-207+,,0,0,0,,Korkunç!Dialogue: 50,0:26:19.54,0:26:22.56,Main-207+,,0,0,0,,Karnında bir aslan var!Dialogue: 50,0:26:28.39,0:26:32.11,Main-207+,,0,0,0,,Ne ters ters bakıyo'n lan?Dialogue: 50,0:26:47.11,0:26:48.58,Main-207+,,0,0,0,,Ne oldu öyle?Dialogue: 50,0:26:48.58,0:26:52.17,Main-207+,,0,0,0,,Aha! Aslanın taşak saldırısı!Dialogue: 50,0:26:57.16,0:26:58.13,Main-207+,,0,0,0,,Fakat...Dialogue: 50,0:26:58.13,0:27:05.56,Main-207+,,0,0,0,,aynı bedeni paylaştıklarından taşak da bir aslında!Dialogue: 50,0:27:10.40,0:27:12.27,Main-207+,,0,0,0,,Neden akıllanmıyor ki?Dialogue: 50,0:27:12.27,0:27:14.11,Main-207+,,0,0,0,,Holdem-sama.Dialogue: 50,0:27:14.11,0:27:16.65,Main-207+,,0,0,0,,Çocuğu ne yapalım?Dialogue: 50,0:27:17.66,0:27:18.95,Main-207+,,0,0,0,,Holdem-sama!Dialogue: 50,0:27:19.58,0:27:21.45,Main-207+,,0,0,0,,Adın Otama'ydı, değil mi?Dialogue: 50,0:27:26.77,0:27:32.33,Main-207+,,0,0,0,,Senin gibi aciz bir götten bacaklı...Dialogue: 50,0:27:34.12,0:27:38.38,Main-207+,,0,0,0,,nasıl olur da vahşi babunu evcilleştirebilir?Dialogue: 50,0:27:38.38,0:27:41.50,Main-207+,,0,0,0,,Adamlarım şahit!Dialogue: 50,0:28:00.32,0:28:03.24,Main-207+,,0,0,0,,Bilmezden gelmen nafile!Dialogue: 50,0:28:03.24,0:28:07.84,Main-207+,,0,0,0,,Gerçek bir şeytan meyvesi gücünden başka izahı yok.Dialogue: 50,0:28:11.19,0:28:12.43,Main-207+,,0,0,0,,Haydi...Dialogue: 50,0:28:13.17,0:28:15.04,Main-207+,,0,0,0,,Öt bakalım!Dialogue: 50,0:28:18.06,0:28:19.34,Flashbacks-207+,,0,0,0,,Otama!Dialogue: 50,0:28:19.34,0:28:23.86,Flashbacks-207+,,0,0,0,,Hasımlarının dahi ele geçirmek isteyeceği bir yeteneğin var.Dialogue: 50,0:28:23.86,0:28:27.56,Flashbacks-207+,,0,0,0,,O yüzden başkalarının önünde sakın ola kullanma!Dialogue: 50,0:28:39.44,0:28:41.65,Main-207+,,0,0,0,,G-Galiba...Dialogue: 50,0:28:43.45,0:28:45.45,Main-207+,,0,0,0,,hayvanlar...Dialogue: 50,0:28:47.18,0:28:50.54,Main-207+,,0,0,0,,beni seviyor da ondan.Dialogue: 50,0:28:52.30,0:28:54.45,Main-207+,,0,0,0,,Hadi ya!Dialogue: 50,0:28:54.45,0:28:56.08,Main-207+,,0,0,0,,Şimdi oldu!Dialogue: 50,0:28:56.08,0:28:59.07,Main-207+,,0,0,0,,Bu yüzdenmiş canım!Dialogue: 50,0:29:01.52,0:29:03.84,Main-207+,,0,0,0,,Evet ya.Dialogue: 50,0:29:05.47,0:29:07.10,Main-207+,,0,0,0,,Beni salak mı sanıyorsun?Dialogue: 50,0:29:09.68,0:29:12.90,Main-207+,,0,0,0,,Sıçtığımın veledi!Dialogue: 50,0:29:16.50,0:29:22.33,Main-207+,,0,0,0,,Yanılmıyorsam yanağından bir parça kopardığını söylemişlerdi.Dialogue: 50,0:29:35.91,0:29:38.84,Main-207+,,0,0,0,,Kendin ötmeyeceksen...Dialogue: 50,0:29:41.36,0:29:43.72,Main-207+,,0,0,0,,bir deneyelim bakalım.Dialogue: 50,0:29:43.72,0:29:45.97,Main-207+,,0,0,0,,Lan, kerpeten getirin!Dialogue: 50,0:29:45.97,0:29:47.22,Main-207+,,0,0,0,,Başüstüne!Dialogue: 50,0:29:51.43,0:29:54.94,Main-207+,,0,0,0,,O olmaz lan! Büyüğünü getir!Dialogue: 50,0:29:59.32,0:30:02.57,Main-207+,,0,0,0,,Luffy ağabey...Dialogue: 50,0:30:15.04,0:30:20.63,Main-207+,,0,0,0,,Yardım et, Luffy ağabey!Dialogue: 50,0:30:22.75,0:30:25.30,Main-207+,,0,0,0,,Tama!Dialogue: 50,0:30:30.45,0:30:34.06,Main-207+,,0,0,0,,Olduğunuz yerde kalın! Ecelinize mi susadınız lan...Dialogue: 50,0:30:34.06,0:30:35.85,Main-207+,,0,0,0,,işgalciler?Dialogue: 50,0:30:36.47,0:30:38.69,Main-207+,,0,0,0,,Bakura Kasabası hemen arkalarında kalıyor!Dialogue: 50,0:30:38.69,0:30:42.44,Main-207+,,0,0,0,,Luffy! Yaverleriyle kapışacak vaktimiz yok!Dialogue: 50,0:30:43.81,0:30:45.11,Main-207+,,0,0,0,,Farkındayım!Dialogue: 50,0:30:45.11,0:30:47.57,Main-207+,,0,0,0,,Durma köpek!Dialogue: 50,0:30:52.70,0:30:54.83,Main-207+,,0,0,0,,Ne?Dialogue: 50,0:30:55.43,0:30:57.25,Main-207+,,0,0,0,,Kaptan!Dialogue: 50,0:30:58.44,0:31:00.15,Main-207+,,0,0,0,,Eyvahlar olsun!Dialogue: 50,0:31:04.27,0:31:06.01,Main-207+,,0,0,0,,Kaptan!Dialogue: 50,0:31:06.01,0:31:08.67,Main-207+,,0,0,0,,Ne oldu. Bu ne telaş?Dialogue: 50,0:31:10.07,0:31:12.43,Main-207+,,0,0,0,,Hasır Şapka ile Roronoa!Dialogue: 50,0:31:13.86,0:31:18.71,Main-207+,,0,0,0,,Hasır Şapka-ya Wano'da mı? Nihayet gelebildi demek.Dialogue: 50,0:31:18.71,0:31:23.11,Main-207+,,0,0,0,,Hasır Şapka'yla Roronoa bodoslama Bakura Kasabası'na dalıyor!Dialogue: 50,0:31:24.36,0:31:28.60,Main-207+,,0,0,0,,Dur biraz! Giderlerse anca mevzu çıkarırlar!Dialogue: 50,0:31:28.60,0:31:30.49,Main-207+,,0,0,0,,Maalesef.Dialogue: 50,0:31:32.20,0:31:33.28,Main-207+,,0,0,0,,Kaptan?Dialogue: 50,0:31:35.97,0:31:37.58,Main-207+,,0,0,0,,Kaptan?!Dialogue: 50,0:31:39.78,0:31:42.13,Main-207+,,0,0,0,,Gidip şu dangalaklara engel olalım!Dialogue: 50,0:31:42.87,0:31:44.71,Main-207+,,0,0,0,,Hay hay, Kaptan!Dialogue: 50,0:31:53.26,0:31:55.89,Main-207+,,0,0,0,,Yapma...Dialogue: 50,0:31:57.91,0:32:01.97,Main-207+,,0,0,0,,Öyleyse yeteneğini göster haydi!Dialogue: 50,0:32:22.03,0:32:25.29,Main-207+,,0,0,0,,Tama!Dialogue: 50,0:32:41.33,0:32:42.14,Main-207+,,0,0,0,,Ne?Dialogue: 50,0:32:42.14,0:32:43.98,Main-207+,,0,0,0,,Bir şey mi yaptın?!Dialogue: 50,0:32:46.37,0:32:47.52,Main-207+,,0,0,0,,Haki!Dialogue: 50,0:32:47.52,0:32:48.59,Main-207+,,0,0,0,,Haki mi?Dialogue: 50,0:32:49.48,0:32:51.24,Main-207+,,0,0,0,,Kralın hakisi.Dialogue: 0,0:01:41.87,0:01:46.46,Title-207+,,0,0,0,,Okobore KasabasıDialogue: 0,0:14:17.75,0:14:23.25,Captions-207+,,0,0,0,,Yetenek Bahşedilenler Yarasa Adam Yarasa Gülücük MeyvesiDialogue: 50,0:15:54.22,0:15:58.02,Note-207+,,0,0,0,,Kesici ZorojuroDialogue: 0,0:16:34.84,0:16:38.76,Captions-207+,,0,0,0,,Yetenek Bahşedilenler Ceylan Adam Ceylan Gülücük MeyvesiDialogue: 50,0:20:57.11,0:21:00.48,Note-207+,,0,0,0,,RestoranDialogue: 0,0:22:09.85,0:22:16.77,Captions-207+,,0,0,0,,Yetenek Bahşedilenler Fare Adam Fare Gülücük MeyvesiDialogue: 50,0:23:25.17,0:23:30.01,Note-207+,,0,0,0,,Japon Dövüş SanatlarıDialogue: 0,0:24:44.87,0:24:50.30,Captions-207+,,0,0,0,,Özel Mülk Bakura KasabasıDialogue: 0,0