Dialogue: 50,0:01:41.71,0:01:45.63,Main-207+,,0,0,0,,Dünyayı keşfetmek en büyük hayalim!
Dialogue: 50,0:01:46.42,0:01:48.09,Main-207+,,0,0,0,,Birlikte yelken açalım!
Dialogue: 50,0:01:48.67,0:01:50.92,Main-207+,,0,0,0,,Hemen gidelim!
Dialogue: 50,0:01:50.92,0:01:53.80,Main-207+,,0,0,0,,– Kesinlikle olmaz!\N– Kesinlikle olmaz!
Dialogue: 50,0:01:54.26,0:01:55.39,Main-207+,,0,0,0,,Kesin sesinizi!
Dialogue: 50,0:01:56.01,0:01:58.22,Main-207+,,0,0,0,,Bu kapalı diyardan kurtulmak istiyorum!
Dialogue: 50,0:01:58.93,0:02:01.68,Main-207+,,0,0,0,,Dış dünyanın özgürlüğünü tatmak istiyorum!
Dialogue: 50,0:02:03.19,0:02:05.56,Main-207+,,0,0,0,,Lütfen! Size eşlik etmeme izin verin!
Dialogue: 50,0:02:05.56,0:02:08.36,Main-207+,,0,0,0,,Oden-{\i1}sama{\i0}! Başınızı kaldırın!
Dialogue: 50,0:02:08.36,0:02:11.53,Main-207+,,0,0,0,,Ulan...! Az önce kaptanımızı\Nöldürmeye çalışmıyor muydun?
Dialogue: 50,0:02:11.53,0:02:12.74,Main-207+,,0,0,0,,Size yalvarıyorum!
Dialogue: 50,0:02:12.74,0:02:15.57,Main-207+,,0,0,0,,Bu kadarı yeter! Adam bir korsan!
Dialogue: 50,0:02:16.41,0:02:17.53,Main-207+,,0,0,0,,Pisliğin teki!
Dialogue: 50,0:02:17.53,0:02:19.49,Main-207+,,0,0,0,,Bu ülkeyi derhal terk edin!
Dialogue: 50,0:02:20.87,0:02:23.54,Main-207+,,0,0,0,,İstesem de yapamam.
Dialogue: 50,0:02:24.67,0:02:29.46,Main-207+,,0,0,0,,Burada mahsur kaldık.\NYolculuk gemimizi mahvetti.
Dialogue: 50,0:02:29.84,0:02:31.34,Main-207+,,0,0,0,,Çok yazık!
Dialogue: 50,0:02:31.34,0:02:32.84,Main-207+,,0,0,0,,Hemen tamir ede–
Dialogue: 50,0:02:34.34,0:02:35.34,Main-207+,,0,0,0,,Hay lanet!
Dialogue: 50,0:02:35.34,0:02:37.68,Main-207+,,0,0,0,,Varlığınız Oden-{\i1}sama{\i0}'yı etkiliyor!
Dialogue: 50,0:02:38.22,0:02:40.56,Main-207+,,0,0,0,,Sorununuzu çözüp yolunuza devam edin!
Dialogue: 50,0:02:41.97,0:02:44.56,Main-207+,,0,0,0,,Evet, tek yapmak istediğim de bu.
Dialogue: 50,0:02:49.69,0:02:50.44,Main-207+,,0,0,0,,Pekâlâ!
Dialogue: 50,0:02:50.44,0:02:52.78,Main-207+,,0,0,0,,Hey! Onu şuraya taşı!
Dialogue: 50,0:02:53.57,0:02:54.45,Main-207+,,0,0,0,,Hey!
Dialogue: 50,0:02:54.45,0:02:56.61,Main-207+,,0,0,0,,Siz-{\i1}gara{\i0} beyler!
Dialogue: 50,0:02:57.03,0:02:59.03,Main-207+,,0,0,0,,Yemek vakti!
Dialogue: 50,0:02:59.78,0:03:02.62,Main-207+,,0,0,0,,Hadi bakalım, yumulun!
Dialogue: 50,0:03:04.33,0:03:05.79,Main-207+,,0,0,0,,Çok lezzetli görünüyor!
Dialogue: 50,0:03:08.63,0:03:11.00,Main-207+,,0,0,0,,Daha önce hiç böyle bir şey tatmamıştım!
Dialogue: 50,0:03:11.00,0:03:13.05,Main-207+,,0,0,0,,Uzak bir diyarın tadı olsa gerek!
Dialogue: 50,0:03:13.05,0:03:15.01,Main-207+,,0,0,0,,Üzümden yapılan bir alkol.
Dialogue: 50,0:03:15.01,0:03:18.72,Main-207+,,0,0,0,,Şu engin dünyada görülecek daha bir sürü şey var, değil mi?!
Dialogue: 50,0:03:20.01,0:03:21.76,Main-207+,,0,0,0,,Beni de yanınıza alın!
Dialogue: 50,0:03:21.76,0:03:24.77,Main-207+,,0,0,0,,Bana bu dünyanın bilinmeyen\Nharikalarını gösterin!
Dialogue: 50,0:03:24.77,0:03:25.39,Main-207+,,0,0,0,,He?
Dialogue: 50,0:03:25.39,0:03:29.61,Main-207+,,0,0,0,,Kimsenin emri altında çalışacak birine benzemiyorsun!
Dialogue: 50,0:03:29.61,0:03:31.82,Main-207+,,0,0,0,,Senin gibileri gemime almam.
Dialogue: 50,0:03:33.57,0:03:36.99,Main-207+,,0,0,0,,Senin gibi başına buyruklar bir araya gelirse,
Dialogue: 50,0:03:37.49,0:03:39.66,Main-207+,,0,0,0,,o tayfanın akıbeti ne olur sanıyorsun?
Dialogue: 50,0:03:42.66,0:03:45.41,Main-207+,,0,0,0,,Çok sıcak!
Dialogue: 50,0:03:47.17,0:03:51.67,Main-207+,,0,0,0,,Önceki tayfamda neyin ne olduğunu acı bir şekilde tecrübe ettim.
Dialogue: 50,0:03:54.67,0:03:56.59,Main-207+,,0,0,0,,Kendi gemini yapabilirsin.
Dialogue: 50,0:03:58.34,0:04:01.10,Main-207+,,0,0,0,,Yapabilseydim çoktan defolup gitmiştim!
Dialogue: 50,0:04:01.10,0:04:03.85,Main-207+,,0,0,0,,Onlarca denize açılma çabam\Nhüsranla sonuçlandı!
Dialogue: 50,0:04:03.85,0:04:07.10,Main-207+,,0,0,0,,Denizcilikten zerre kadar anlamam!
Dialogue: 50,0:04:07.52,0:04:10.52,Main-207+,,0,0,0,,O hâlde pes et ve\Ndaimyo olarak işine devam et!
Dialogue: 50,0:04:10.52,0:04:13.07,Main-207+,,0,0,0,,Bu diyarda nefes alamıyorum!
Dialogue: 50,0:04:13.07,0:04:15.44,Main-207+,,0,0,0,,Artık dayanamıyorum! Beni de yanınıza alın!
Dialogue: 50,0:04:15.44,0:04:17.11,Main-207+,,0,0,0,,Beyazsakal!
Dialogue: 50,0:04:17.11,0:04:20.78,Main-207+,,0,0,0,,Wano'da insanların ülkeyi\Nterk etmesini yasaklayan bir yasa var!
Dialogue: 50,0:04:21.45,0:04:23.58,Main-207+,,0,0,0,,Kuri'nin başındaki isim olarak,
Dialogue: 50,0:04:23.58,0:04:26.95,Main-207+,,0,0,0,,Oden-{\i1}sama{\i0}'nın bu yasağı çiğnemesinin hiçbir mazereti olamaz!
Dialogue: 50,0:04:26.95,0:04:28.66,Main-207+,,0,0,0,,Bunu ona söylemesene!
Dialogue: 50,0:04:30.17,0:04:31.79,Main-207+,,0,0,0,,Bildiğim iyi oldu!
Dialogue: 50,0:04:31.79,0:04:34.05,Main-207+,,0,0,0,,Aynı fikirdeyiz o zaman!
Dialogue: 50,0:04:34.05,0:04:37.09,Main-207+,,0,0,0,,Onu almak gibi bir niyetim yok!
Dialogue: 50,0:04:37.09,0:04:40.76,Main-207+,,0,0,0,,Bu ülkenin kanunları umurumda değil.
Dialogue: 50,0:04:40.76,0:04:46.27,Main-207+,,0,0,0,,Sadece Kuri de değil, tüm Wano'nun selameti onun burada kalmasına bağlı!
Dialogue: 50,0:04:48.06,0:04:50.44,Main-207+,,0,0,0,,Diline hâkim ol, Kin'emon!
Dialogue: 50,0:04:50.73,0:04:53.90,Main-207+,,0,0,0,,Beni gemine al, Beyazsakal!
Dialogue: 50,0:04:53.90,0:04:56.11,Main-207+,,0,0,0,,Hayır!
Dialogue: 50,0:04:56.11,0:04:59.53,Main-207+,,0,0,0,,O denize açılacağım!
Dialogue: 50,0:04:59.53,0:05:03.70,Main-207+,,0,0,0,,Bu ülke ruhumu daraltıyor!\NGeri dönmek istemiyorum!
Dialogue: 50,0:05:04.24,0:05:06.29,Main-207+,,0,0,0,,Çözün beni!
Dialogue: 50,0:05:06.29,0:05:07.62,Main-207+,,0,0,0,,Durun!
Dialogue: 50,0:05:11.75,0:05:13.21,Main-207+,,0,0,0,,Açın kapıyı!
Dialogue: 50,0:05:15.09,0:05:16.75,Main-207+,,0,0,0,,Pes etmeyeceğim!
Dialogue: 50,0:05:20.22,0:05:21.84,Main-207+,,0,0,0,,Bekle beni,
Dialogue: 50,0:05:22.22,0:05:24.39,Main-207+,,0,0,0,,Beyazsakal!
Dialogue: 50,0:05:27.60,0:05:30.02,Main-207+,,0,0,0,,Tüm dünyada sadece beş ada mı var?!
Dialogue: 50,0:05:32.69,0:05:34.48,Main-207+,,0,0,0,,Bu tamamen yanlış!
Dialogue: 50,0:05:34.48,0:05:35.48,Main-207+,,0,0,0,,– Ne?!\N– Ne?!
Dialogue: 50,0:05:35.48,0:05:39.90,Main-207+,,0,0,0,,En az 10 bilemediniz 20 milyon ada vardır!
Dialogue: 50,0:05:39.90,0:05:40.61,Main-207+,,0,0,0,,– Ne?!\N– Ne?!
Dialogue: 50,0:05:41.03,0:05:43.66,Main-207+,,0,0,0,,Cidden hiçbir şey bilmiyor musunuz?
Dialogue: 50,0:05:43.66,0:05:46.95,Main-207+,,0,0,0,,Bu yüzden maceralar eğlencelidir!\NHayal gücünüzü ateşliyorlar!
Dialogue: 50,0:05:47.87,0:05:50.00,Main-207+,,0,0,0,,Dünya kocaman!
Dialogue: 50,0:05:50.58,0:05:54.54,Main-207+,,0,0,0,,Keşfedilecek sayısız ada var!
Dialogue: 50,0:06:05.34,0:06:06.30,Main-207+,,0,0,0,,Nereye?
Dialogue: 50,0:06:07.56,0:06:08.43,Main-207+,,0,0,0,,Izo!
Dialogue: 50,0:06:08.43,0:06:10.43,Main-207+,,0,0,0,,Nereye böyle, Oden-{\i1}sama{\i0}?
Dialogue: 50,0:06:10.43,0:06:12.31,Main-207+,,0,0,0,,Ödümü patlattın!
Dialogue: 50,0:06:12.31,0:06:14.19,Main-207+,,0,0,0,,Hâlâ cevabınızı bekliyorum.
Dialogue: 50,0:06:15.81,0:06:18.02,Main-207+,,0,0,0,,Helaya gideceğim diye izin mi alacağım?!
Dialogue: 50,0:06:18.02,0:06:20.57,Main-207+,,0,0,0,,Ben daimyoyum!
Dialogue: 50,0:06:20.57,0:06:22.19,Main-207+,,0,0,0,,Kusuruma bakmayın.
Dialogue: 50,0:06:22.19,0:06:23.82,Main-207+,,0,0,0,,Soğuğa dikkat edin.
Dialogue: 50,0:06:25.70,0:06:27.70,Main-207+,,0,0,0,,İşemek de yasak!
Dialogue: 50,0:06:31.66,0:06:34.67,Main-207+,,0,0,0,,Gecenin köründe Oden'den\Ngizlice kaçmak hiç içime sinmiyor.
Dialogue: 50,0:06:37.00,0:06:41.63,Main-207+,,0,0,0,,Gücüne bakarsak tayfa için iyi olurdu.
Dialogue: 50,0:06:42.30,0:06:46.84,Main-207+,,0,0,0,,Babalık da ondan oldukça hoşlandı gibi...
Dialogue: 50,0:06:46.84,0:06:48.89,Main-207+,,0,0,0,,Ha?! Siz neden bahsediyorsunuz?!
Dialogue: 50,0:06:49.22,0:06:51.22,Main-207+,,0,0,0,,Rol yapma!
Dialogue: 50,0:06:56.10,0:06:59.86,Main-207+,,0,0,0,,Ondan hoşlanmışsam bile...
Dialogue: 50,0:07:00.36,0:07:03.78,Main-207+,,0,0,0,,onu yanımıza almak\Nkraliyet ailesini kaçırmaya girer.
Dialogue: 50,0:07:04.24,0:07:06.24,Main-207+,,0,0,0,,Ondan sonra al başına belayı.
Dialogue: 50,0:07:06.70,0:07:09.16,Main-207+,,0,0,0,,Teşekkür olarak hazine sandığını bıraktınız mı?
Dialogue: 50,0:07:09.16,0:07:12.87,Main-207+,,0,0,0,,Sağ olsunlar, hem karnımızı doyurdular hem de kereste sağladılar.
Dialogue: 50,0:07:18.75,0:07:19.84,Main-207+,,0,0,0,,Hey, n'oluyor?!
Dialogue: 50,0:07:19.84,0:07:23.26,Main-207+,,0,0,0,,Bir şeyler planladığınızı biliyordum!
Dialogue: 50,0:07:23.26,0:07:25.42,Main-207+,,0,0,0,,Beyazsakal!
Dialogue: 50,0:07:26.18,0:07:27.01,Main-207+,,0,0,0,,Oden?!
Dialogue: 50,0:07:27.01,0:07:29.72,Main-207+,,0,0,0,,{\fad(0,188)}Bırakın sizinle geleyim!
Dialogue: 50,0:07:29.72,0:07:34.81,Main-207+,,0,0,0,,Oden-{\i1}sama{\i0}, ben de sizin\Nbir şeyler planladığınızı biliyordum!
Dialogue: 50,0:07:34.81,0:07:35.89,Main-207+,,0,0,0,,Gidemezsiniz!
Dialogue: 50,0:07:38.85,0:07:40.02,Main-207+,,0,0,0,,Ahmak!
Dialogue: 50,0:07:40.82,0:07:42.02,Main-207+,,0,0,0,,Gelmeme izin verin!
Dialogue: 50,0:07:42.02,0:07:44.32,Main-207+,,0,0,0,,Bana dünyayı gösterin!
Dialogue: 50,0:07:44.32,0:07:46.15,Main-207+,,0,0,0,,Geri dönün!
Dialogue: 50,0:07:46.15,0:07:48.57,Main-207+,,0,0,0,,Sonraki şogun siz olacaksınız!
Dialogue: 50,0:07:48.57,0:07:50.62,Main-207+,,0,0,0,,Amma da pervasız!
Dialogue: 50,0:07:50.62,0:07:52.41,Main-207+,,0,0,0,,Seni tanımak harikaydı, Oden!
Dialogue: 50,0:07:52.41,0:07:53.95,Main-207+,,0,0,0,,Pes et ve evine dön.
Dialogue: 50,0:07:53.95,0:07:55.33,Main-207+,,0,0,0,,Bekle, Marco!
Dialogue: 50,0:07:55.33,0:07:56.08,Main-207+,,0,0,0,,Ne?!
Dialogue: 50,0:07:56.08,0:08:00.50,Main-207+,,0,0,0,,Git de ona tutunanı buraya getir.
Dialogue: 50,0:08:02.80,0:08:04.34,Main-207+,,0,0,0,,Öf be.
Dialogue: 50,0:08:04.76,0:08:07.59,Main-207+,,0,0,0,,Geri kalanınız sıkı tutunun!
Dialogue: 50,0:08:07.59,0:08:09.80,Main-207+,,0,0,0,,Başkaları için endişelenecek zaman değil!
Dialogue: 50,0:08:10.76,0:08:14.14,Main-207+,,0,0,0,,Şelaleden düşmek üzereyiz!
Dialogue: 50,0:08:17.14,0:08:19.35,Main-207+,,0,0,0,,Hayır, hayır!
Dialogue: 50,0:08:24.61,0:08:26.53,Main-207+,,0,0,0,,Olamaz!
Dialogue: 50,0:08:26.86,0:08:29.07,Main-207+,,0,0,0,,Oden-{\i1}sama{\i0} kayıp!
Dialogue: 50,0:08:29.07,0:08:31.87,Main-207+,,0,0,0,,Beyazsakal'ın gemisi de ortalıkta yok!
Dialogue: 50,0:08:31.87,0:08:34.20,Main-207+,,0,0,0,,Bundan korkuyordum!
Dialogue: 50,0:08:34.83,0:08:38.58,Main-207+,,0,0,0,,Abim gitmiş! Köpek-{\i1}chan{\i0}'la Kedi-{\i1}chan{\i0} da yok!
Dialogue: 50,0:08:38.58,0:08:40.58,Main-207+,,0,0,0,,Ağlama, Okiku!
Dialogue: 50,0:08:40.58,0:08:43.88,Main-207+,,0,0,0,,Hemen kötüye yormayalım,\Nönce bir etrafa bakalım.
Dialogue: 50,0:08:44.21,0:08:45.21,Main-207+,,0,0,0,,Tamam mı?
Dialogue: 50,0:08:45.21,0:08:46.05,Main-207+,,0,0,0,,Tamam...
Dialogue: 50,0:08:46.42,0:08:48.05,Main-207+,,0,0,0,,Her yere bakın!
Dialogue: 50,0:08:48.05,0:08:50.13,Main-207+,,0,0,0,,Tüm ülkenin altını üstüne getirin!
Dialogue: 50,0:08:58.89,0:09:00.48,Main-207+,,0,0,0,,Hey, Beyazsakal!
Dialogue: 50,0:09:00.48,0:09:03.36,Main-207+,,0,0,0,,Oden-{\i1}sama{\i0} ölmeden onu gemiye çekin!
Dialogue: 50,0:09:03.36,0:09:07.32,Main-207+,,0,0,0,,Wano'nun geleceği onun omuzlarında!
Dialogue: 50,0:09:07.74,0:09:11.53,Main-207+,,0,0,0,,Onu kaç kez geri çevirdiğimi görmedin mi evlat?
Dialogue: 50,0:09:11.86,0:09:15.33,Main-207+,,0,0,0,,Yine de ülkeyi terk etmeyi seçti!
Dialogue: 50,0:09:15.33,0:09:19.29,Main-207+,,0,0,0,,Artık işleri kendi yöntemlerimizle halledeceğiz.
Dialogue: 50,0:09:22.79,0:09:24.59,Main-207+,,0,0,0,,Kahretsin!
Dialogue: 50,0:09:25.04,0:09:26.17,Main-207+,,0,0,0,,Lütfen!
Dialogue: 50,0:09:26.80,0:09:32.72,Main-207+,,0,0,0,,Onun gibi ne yapacağı belli olmayan bir tip yüzünden ailemi riske atamam.
Dialogue: 50,0:09:33.80,0:09:36.43,Main-207+,,0,0,0,,Bu işe son vermek istiyorsan, gidip onu ikna etmelisin.
Dialogue: 50,0:09:38.68,0:09:40.64,Main-207+,,0,0,0,,Dinle, Oden!
Dialogue: 50,0:09:41.56,0:09:43.19,Main-207+,,0,0,0,,Üç gün!
Dialogue: 50,0:09:43.19,0:09:48.23,Main-207+,,0,0,0,,Üç gün o zincire tutunmayı başarırsan\Nseni gemiye alırım!
Dialogue: 50,0:09:51.57,0:09:54.37,Main-207+,,0,0,0,,Söz mü, Beyazsakal?!
Dialogue: 50,0:09:54.95,0:09:57.54,Main-207+,,0,0,0,,Sözüm, söz!
Dialogue: 50,0:10:35.36,0:10:37.70,Main-207+,,0,0,0,,Oden hâlâ tutunuyor mu?
Dialogue: 50,0:10:39.37,0:10:41.12,Main-207+,,0,0,0,,Evet...
Dialogue: 50,0:10:41.12,0:10:42.96,Main-207+,,0,0,0,,Ama iyi görünmüyor.
Dialogue: 50,0:10:43.54,0:10:48.21,Main-207+,,0,0,0,,Dalgalar yüzünü tanınmayacak kadar şişirdi!
Dialogue: 50,0:10:48.21,0:10:49.75,Main-207+,,0,0,0,,Neredeyse patlayacak gibi!
Dialogue: 50,0:10:49.75,0:10:52.59,Main-207+,,0,0,0,,Sadece bir saat kaldı!
Dialogue: 50,0:10:52.59,0:10:55.59,Main-207+,,0,0,0,,Dayan, Oden!
Dialogue: 50,0:10:55.59,0:10:57.22,Main-207+,,0,0,0,,Hey, ne diye onu gazlıyorsun?!
Dialogue: 50,0:10:58.01,0:11:01.60,Main-207+,,0,0,0,,Başarırsa bizden biri olacağı için olabilir mi?
Dialogue: 50,0:11:02.18,0:11:04.64,Main-207+,,0,0,0,,Oden yoldaşımız olacak!
Dialogue: 50,0:11:07.90,0:11:09.06,Main-207+,,0,0,0,,Oden...
Dialogue: 50,0:11:09.57,0:11:11.82,Main-207+,,0,0,0,,yoldaşımız mı olacak?
Dialogue: 50,0:11:17.03,0:11:19.70,Main-207+,,0,0,0,,Güçlü ol, Oden!
Dialogue: 50,0:11:19.70,0:11:23.37,Main-207+,,0,0,0,,Ha gayret, Oden!
Dialogue: 50,0:11:21.30,0:11:23.37,Secondary-207+,,0,0,0,,{\an8}– Yapabilirsin!\N– Yapabilirsin!
Dialogue: 50,0:11:27.58,0:11:30.25,Main-207+,,0,0,0,,Pes etme, Oden!
Dialogue: 50,0:11:30.25,0:11:32.09,Main-207+,,0,0,0,,Dayan!
Dialogue: 50,0:11:33.92,0:11:35.38,Main-207+,,0,0,0,,Sizi şebekler...
Dialogue: 50,0:11:37.84,0:11:43.52,Main-207+,,0,0,0,,Efendimizi buna maruz bıraktığın için\Nseni asla affetmeyeceğim, Beyazsakal!
Dialogue: 50,0:11:47.69,0:11:51.19,Main-207+,,0,0,0,,Oden, dayan!
Dialogue: 50,0:11:51.19,0:11:53.48,Main-207+,,0,0,0,,Az kaldı!
Dialogue: 50,0:11:51.19,0:11:52.40,Secondary-207+,,0,0,0,,Oden!
Dialogue: 50,0:11:53.48,0:11:55.32,Main-207+,,0,0,0,,Oden!
Dialogue: 50,0:11:56.28,0:11:57.82,Main-207+,,0,0,0,,Oden-{\i1}sama{\i0}!
Dialogue: 50,0:12:00.37,0:12:01.41,Main-207+,,0,0,0,,{\i1}Bırak beni!
Dialogue: 50,0:12:01.41,0:12:02.95,Main-207+,,0,0,0,,{\i1}Dokunma bana!
Dialogue: 50,0:12:13.67,0:12:16.01,Main-207+,,0,0,0,,Muhteşem!
Dialogue: 50,0:12:16.01,0:12:17.42,Main-207+,,0,0,0,,Tam bir afet!
Dialogue: 50,0:12:18.38,0:12:20.55,Main-207+,,0,0,0,,{\an8}Neden kaçıyorsun, bebeğim?!
Dialogue: 50,0:12:20.55,0:12:24.93,Main-207+,,0,0,0,,{\an8}Seni Wano'ya götürmemizi istediğini sanıyordum!
Dialogue: 50,0:12:25.27,0:12:27.23,Main-207+,,0,0,0,,Bizimle gel, hadi!
Dialogue: 50,0:12:27.23,0:12:29.14,Main-207+,,0,0,0,,Sana zarar vermeyeceğiz.
Dialogue: 50,0:12:29.14,0:12:30.10,Main-207+,,0,0,0,,Vermezsiniz tabii.
Dialogue: 50,0:12:30.98,0:12:33.32,Main-207+,,0,0,0,,O gemi köle tacirlerine ait!
Dialogue: 50,0:12:33.65,0:12:36.11,Main-207+,,0,0,0,,Bana zarar verirseniz,\Nalacağınız para da azalır.
Dialogue: 50,0:12:36.61,0:12:40.20,Main-207+,,0,0,0,,Sizin gibi kötü görünüşlü alçaklara kandığıma inanamıyorum!
Dialogue: 50,0:12:40.20,0:12:41.66,Main-207+,,0,0,0,,Ne kadar da safım!
Dialogue: 50,0:12:44.66,0:12:46.50,Main-207+,,0,0,0,,Arkan sırf deniz!
Dialogue: 50,0:12:46.50,0:12:48.16,Main-207+,,0,0,0,,Kaçacak bir yerin kalmadı!
Dialogue: 50,0:12:48.50,0:12:50.08,Main-207+,,0,0,0,,Artık pes et!
Dialogue: 50,0:12:50.08,0:12:52.46,Main-207+,,0,0,0,,Hayır, hâlâ bir kaçış yolum var!
Dialogue: 50,0:12:52.46,0:12:57.09,Main-207+,,0,0,0,,Paşa paşa bizim gemiye dönüyorsun, başka yolun yok!
Dialogue: 50,0:12:57.09,0:12:59.59,Main-207+,,0,0,0,,Seninle çok iyi vakit geçireceğiz!
Dialogue: 50,0:13:01.09,0:13:02.47,Thoughts-207+,,0,0,0,,Buraya kadar.
Dialogue: 50,0:13:02.47,0:13:04.72,Thoughts-207+,,0,0,0,,Tekrardan geleceğe kaçmak zorundayım.
Dialogue: 50,0:13:15.11,0:13:16.23,Main-207+,,0,0,0,,Ne?!
Dialogue: 50,0:13:16.65,0:13:19.03,Main-207+,,0,0,0,,B-B-Bu da ne böyle?
Dialogue: 50,0:13:28.54,0:13:31.71,Main-207+,,0,0,0,,Bu bir deniz canavarı!
Dialogue: 50,0:13:33.83,0:13:38.34,Main-207+,,0,0,0,,Bir kadının yardım çığlığını duydum.
Dialogue: 50,0:13:38.34,0:13:39.17,Main-207+,,0,0,0,,Canavar mı?!
Dialogue: 50,0:13:43.22,0:13:45.01,Main-207+,,0,0,0,,İyi misin sen?!
Dialogue: 50,0:13:45.01,0:13:46.56,Main-207+,,0,0,0,,Ne?!
Dialogue: 50,0:13:46.56,0:13:49.27,Main-207+,,0,0,0,,Canını yakmadılar, değil mi?
Dialogue: 50,0:14:09.66,0:14:12.29,Main-207+,,0,0,0,,İyi misin?!
Dialogue: 50,0:14:12.29,0:14:15.33,Main-207+,,0,0,0,,Ne? Şey, iyiyim ben.
Dialogue: 50,0:14:15.33,0:14:16.42,Main-207+,,0,0,0,,Yoksa...
Dialogue: 50,0:14:16.79,0:14:19.51,Main-207+,,0,0,0,,beni kurtarmaya mı geldin?!
Dialogue: 50,0:14:20.92,0:14:22.67,Main-207+,,0,0,0,,Evet...!
Dialogue: 50,0:14:25.30,0:14:28.47,Main-207+,,0,0,0,,İyi olmana... sevindim...
Dialogue: 50,0:14:34.52,0:14:36.56,Main-207+,,0,0,0,,İyi misin?!
Dialogue: 50,0:14:37.23,0:14:39.11,Main-207+,,0,0,0,,Kendine gel!
Dialogue: 50,0:14:39.11,0:14:41.07,Main-207+,,0,0,0,,Lütfen kendine gel!
Dialogue: 50,0:14:45.16,0:14:46.82,Main-207+,,0,0,0,,Oden gitti!
Dialogue: 50,0:14:47.20,0:14:48.83,Main-207+,,0,0,0,,Nereye gitti ki?
Dialogue: 50,0:14:48.83,0:14:50.08,Main-207+,,0,0,0,,Kahretsin!
Dialogue: 50,0:14:50.08,0:14:52.45,Main-207+,,0,0,0,,Sadece bir kaç dakika kalmıştı!
Dialogue: 50,0:14:52.45,0:14:55.29,Main-207+,,0,0,0,,Çok yazık, daha fazla dayanamadı!
Dialogue: 50,0:14:55.62,0:14:59.38,Main-207+,,0,0,0,,Babalık, ona gerçekten cehennemi yaşattın!
Dialogue: 50,0:14:59.38,0:15:01.09,Main-207+,,0,0,0,,Elinden gelenin en iyisini yaptı!
Dialogue: 50,0:15:01.51,0:15:03.30,Main-207+,,0,0,0,,Neden onu biraz rahat bırakamadın?
Dialogue: 50,0:15:03.30,0:15:07.59,Main-207+,,0,0,0,,Oden-{\i1}sama{\i0}! Oden-{\i1}sama{\i0}!
Dialogue: 50,0:15:07.59,0:15:08.85,Main-207+,,0,0,0,,Hey, dur!
Dialogue: 50,0:15:08.85,0:15:09.97,Main-207+,,0,0,0,,Sakin ol!
Dialogue: 50,0:15:08.18,0:15:09.51,Secondary-207+,,0,0,0,,Bırakın beni!
Dialogue: 50,0:15:09.97,0:15:16.15,Main-207+,,0,0,0,,{\t(4193,0,1,\c&H000000&\3c&H000000&\4c&H000000&)}Oden-{\i1}sama{\i0}! Oden-{\i1}sama{\i0}!
Dialogue: 50,0:15:27.36,0:15:29.12,Main-207+,,0,0,0,,Çok hızlı iyileşiyor.
Dialogue: 50,0:15:29.78,0:15:32.49,Main-207+,,0,0,0,,İnsan olduğunu bile anlayamamıştım.
Dialogue: 50,0:15:50.76,0:15:55.02,Main-207+,,0,0,0,,Vay be! Sanırım Beyazsakal'ın\Ntayfasına katılmayı başaramadım!
Dialogue: 50,0:15:55.02,0:15:59.06,Main-207+,,0,0,0,,Onlarla bir sürü farklı yere gidebileceğimi düşünmüştüm...
Dialogue: 50,0:15:59.06,0:16:00.44,Main-207+,,0,0,0,,ama hiç fark etmez!
Dialogue: 50,0:16:06.70,0:16:11.33,Main-207+,,0,0,0,,İlk kez yabancı topraklara ayak bastım!
Dialogue: 50,0:16:11.33,0:16:13.87,Main-207+,,0,0,0,,Başardım!
Dialogue: 50,0:16:13.87,0:16:14.95,Main-207+,,0,0,0,,Bak sen.
Dialogue: 50,0:16:15.45,0:16:16.91,Main-207+,,0,0,0,,Ne kadar da mutlu!
Dialogue: 50,0:16:16.91,0:16:20.04,Main-207+,,0,0,0,,Sonunda Wano'dan dışarı çıktım!
Dialogue: 50,0:16:20.04,0:16:22.67,Main-207+,,0,0,0,,Maceram başladı!
Dialogue: 50,0:16:22.67,0:16:23.80,Main-207+,,0,0,0,,Tamamdır!
Dialogue: 50,0:16:25.21,0:16:27.01,Main-207+,,0,0,0,,Etrafta şöyle zıplamayı bırak!
Dialogue: 50,0:16:27.01,0:16:30.39,Main-207+,,0,0,0,,Hâlâ iyileşme sürecindesin!
Dialogue: 50,0:16:32.01,0:16:35.31,Main-207+,,0,0,0,,Kadın, benimle sen mi ilgilendin?!
Dialogue: 50,0:16:35.31,0:16:37.02,Main-207+,,0,0,0,,Ah, evet!
Dialogue: 50,0:16:37.64,0:16:38.89,Main-207+,,0,0,0,,Çok teşekkür ederim!
Dialogue: 50,0:16:40.40,0:16:41.40,Main-207+,,0,0,0,,Hiç olur mu?!
Dialogue: 50,0:16:41.40,0:16:43.65,Main-207+,,0,0,0,,Asıl teşekkür etmesi gereken kişi benim!
Dialogue: 50,0:16:43.65,0:16:45.94,Main-207+,,0,0,0,,Çok teşekkürler!
Dialogue: 50,0:16:45.94,0:16:49.74,Main-207+,,0,0,0,,Öyle mi? İyiysen mesele yok.
Dialogue: 50,0:16:49.74,0:16:53.20,Main-207+,,0,0,0,,Bu arada, az önce Wano'dan\Ngeldiğini mi söyledin?
Dialogue: 50,0:16:54.24,0:16:55.99,Main-207+,,0,0,0,,Evet, söyledim.
Dialogue: 50,0:16:56.62,0:16:57.91,Main-207+,,0,0,0,,Sahi ya, lafı açılmışken...
Dialogue: 50,0:16:57.91,0:17:02.17,Main-207+,,0,0,0,,Onca yolu geldikten sonra\Nhâlâ tanıdık kıyafet görmek şaşırtıcı.
Dialogue: 50,0:17:02.17,0:17:05.25,Main-207+,,0,0,0,,Buralarda farklı kıyafetler görmeyi hayal etmiştim!
Dialogue: 50,0:17:06.63,0:17:11.76,Main-207+,,0,0,0,,Aslında çocukluğumdan beri Wano'ya gitmek istiyordum!
Dialogue: 50,0:17:12.72,0:17:17.31,Main-207+,,0,0,0,,Beni de yanında oraya götürür müsün?
Dialogue: 50,0:17:17.31,0:17:19.69,Main-207+,,0,0,0,,Ah... hmm...
Dialogue: 50,0:17:20.48,0:17:22.10,Main-207+,,0,0,0,,Eh, şey...
Dialogue: 50,0:17:22.10,0:17:23.94,Main-207+,,0,0,0,,Rahatsız oldu...
Dialogue: 50,0:17:28.90,0:17:31.03,Main-207+,,0,0,0,,İşte orada!
Dialogue: 50,0:17:34.28,0:17:37.12,Main-207+,,0,0,0,,Size güveniyoruz, Kaptan Karma!
Dialogue: 50,0:17:43.17,0:17:44.67,Main-207+,,0,0,0,,Altı kol mu?!
Dialogue: 50,0:17:44.67,0:17:45.92,Main-207+,,0,0,0,,Çok ilginç!
Dialogue: 50,0:17:45.92,0:17:48.67,Main-207+,,0,0,0,,Wano'da böyle insanları göremezsin!
Dialogue: 50,0:17:49.84,0:17:53.72,Main-207+,,0,0,0,,Hey, bahsettiğiniz canavar nerede?!
Dialogue: 50,0:17:53.72,0:17:56.05,Main-207+,,0,0,0,,Ne? B-Buralarda olmalı.
Dialogue: 50,0:17:56.05,0:17:58.02,Main-207+,,0,0,0,,Buhar olup uçtu mu yani?!
Dialogue: 50,0:17:58.02,0:18:01.73,Main-207+,,0,0,0,,O koca deniz canavarı yerin dibine mi girdi?!
Dialogue: 50,0:18:03.10,0:18:06.40,Main-207+,,0,0,0,,Demek hepiniz döndünüz ha?!
Dialogue: 50,0:18:06.40,0:18:08.11,Main-207+,,0,0,0,,Sen de kimsin lan?!
Dialogue: 50,0:18:08.11,0:18:10.40,Main-207+,,0,0,0,,N-Neden tanışıyormuşuz gibi konuşuyorsun?
Dialogue: 50,0:18:12.07,0:18:14.28,Main-207+,,0,0,0,,Ne diyorsunuz be?!
Dialogue: 50,0:18:14.82,0:18:18.04,Main-207+,,0,0,0,,Şimdi anladım!\NKendine bir koruma tutmuşsun!
Dialogue: 50,0:18:18.04,0:18:21.29,Main-207+,,0,0,0,,Senin gibi afetler her zaman iyi para eder!
Dialogue: 50,0:18:21.29,0:18:23.96,Main-207+,,0,0,0,,İkinizi de satacağız!
Dialogue: 50,0:18:25.83,0:18:26.84,Main-207+,,0,0,0,,Kaçalım!
Dialogue: 50,0:18:27.34,0:18:29.17,Main-207+,,0,0,0,,Çok fazlalar!
Dialogue: 50,0:18:30.63,0:18:33.34,Main-207+,,0,0,0,,Bu benim gurbetteki ilk dövüşüm olacak.
Dialogue: 50,0:18:47.02,0:18:50.48,Main-207+,,0,0,0,,Beyazsakal Korsanları gelmiş!
Dialogue: 50,0:18:50.48,0:18:55.16,Narrator-207+,,0,0,0,,Karma adındaki bu adam, en nihayetinde Beyazsakal safına geçecek...
Dialogue: 50,0:18:55.24,0:18:59.24,Narrator-207+,,0,0,0,,{\c&HFFFFFF&\3c&HFFFFFF&\4c&HFFFFFF&\t(20,561,1,\c&HFFFFFF&\3c&H000000&\4c&H000000&)}{\t(3231,0,1,\c&HFFFFFF&\3c&HFFFFFF&\4c&HFFFFFF&)}ve Zirve Savaşı'nda onlarla beraber ter dökecekti.
Dialogue: 50,0:18:59.91,0:19:02.04,Main-207+,,0,0,0,,Hadi gidelim, Oden!
Dialogue: 50,0:19:02.04,0:19:03.08,Main-207+,,0,0,0,,Ne?
Dialogue: 50,0:19:03.08,0:19:06.12,Main-207+,,0,0,0,,Ama zinciri bıraktım.
Dialogue: 50,0:19:07.42,0:19:10.30,Main-207+,,0,0,0,,Yardım isteyen bir kadın için\Nhayalinden vazgeçmek....
Dialogue: 50,0:19:11.67,0:19:13.47,Main-207+,,0,0,0,,Pek bir yufka yürekli çıktın.
Dialogue: 50,0:19:14.34,0:19:16.93,Main-207+,,0,0,0,,Pekâlâ, hadi gidelim!
Dialogue: 50,0:19:21.14,0:19:25.56,Main-207+,,0,0,0,,Hayalinin bile ötesinde büyük bir maceraya hazır ol,
Dialogue: 50,0:19:25.56,0:19:27.73,Main-207+,,0,0,0,,kardeşim!
Dialogue: 50,0:19:28.69,0:19:31.19,Main-207+,,0,0,0,,Ciddi misin sen, Beyazcık-{\i1}chan{\i0}?!
Dialogue: 50,0:19:32.61,0:19:34.24,Main-207+,,0,0,0,,Beyazcık-{\i1}chan{\i0} mı?!
Dialogue: 50,0:19:38.70,0:19:41.87,Main-207+,,0,0,0,,Gidelim!
Dialogue: 50,0:19:50.50,0:19:51.75,Main-207+,,0,0,0,,Oden!
Dialogue: 50,0:19:51.75,0:19:53.21,Main-207+,,0,0,0,,İyi olmana çok sevindim!
Dialogue: 50,0:19:53.55,0:19:56.43,Main-207+,,0,0,0,,Seni tekrar görmek harika!
Dialogue: 50,0:19:56.43,0:19:57.76,Main-207+,,0,0,0,,İyi ki geldin!
Dialogue: 50,0:20:00.89,0:20:02.76,Main-207+,,0,0,0,,Hepiniz çok sağ olun!
Dialogue: 50,0:20:04.31,0:20:06.69,Main-207+,,0,0,0,,Babalık sana oldukça zor zamanlar yaşattı!
Dialogue: 50,0:20:06.69,0:20:08.19,Main-207+,,0,0,0,,Kesinlikle yaşattı!
Dialogue: 50,0:20:08.19,0:20:09.94,Main-207+,,0,0,0,,Kesinlikle!
Dialogue: 50,0:20:12.82,0:20:14.78,Main-207+,,0,0,0,,S-Sizi ahmaklar!
Dialogue: 50,0:20:15.32,0:20:16.86,Main-207+,,0,0,0,,Oden-{\i1}sama{\i0}!
Dialogue: 50,0:20:17.57,0:20:19.82,Main-207+,,0,0,0,,İyi olduğunuzu görmek harika!
Dialogue: 50,0:20:19.82,0:20:22.66,Main-207+,,0,0,0,,Evet, gördüğün gibi gayet iyiyim.
Dialogue: 50,0:20:23.70,0:20:25.50,Main-207+,,0,0,0,,– Oden-{\i1}sama{\i0}!\N– Oden-{\i1}sama{\i0}!
Dialogue: 50,0:20:28.33,0:20:30.67,Main-207+,,0,0,0,,Inuarashi?! Nekomamushi?!
Dialogue: 50,0:20:31.88,0:20:33.88,Main-207+,,0,0,0,,Burada ne arıyorsunuz?!
Dialogue: 50,0:20:33.88,0:20:39.38,Main-207+,,0,0,0,,Siz-{\i1}gara{\i0}'nın bir yolunu bulup kaçacağınızı tahmin etmiştik, biz de gizlice gemiye sızdık!
Dialogue: 50,0:20:39.38,0:20:41.85,Main-207+,,0,0,0,,Siz-{\i1}gara{\i0}'yı her daim takip edeceğiz!
Dialogue: 50,0:20:42.26,0:20:43.26,Main-207+,,0,0,0,,Kaçak yolcular!
Dialogue: 50,0:20:43.72,0:20:48.10,Main-207+,,0,0,0,,Beni asla affetmeyeceğini söylememiş miydin?
Dialogue: 50,0:20:49.39,0:20:51.86,Main-207+,,0,0,0,,Beni bunun için denize mi atacaksın?
Dialogue: 50,0:21:01.53,0:21:03.20,Main-207+,,0,0,0,,Keyfime bağlı.
Dialogue: 50,0:21:04.12,0:21:05.24,Main-207+,,0,0,0,,Kız!
Dialogue: 50,0:21:05.24,0:21:06.37,Main-207+,,0,0,0,,Adın ne?
Dialogue: 50,0:21:06.37,0:21:08.41,Main-207+,,0,0,0,,Ah, evet!
Dialogue: 50,0:21:09.16,0:21:10.83,Main-207+,,0,0,0,,Adım Toki!
Dialogue: 50,0:21:11.42,0:21:12.83,Main-207+,,0,0,0,,Şey...
Dialogue: 50,0:21:12.83,0:21:15.63,Main-207+,,0,0,0,,Wano'ya gitmek istiyorum da!
Dialogue: 50,0:21:18.51,0:21:20.51,Main-207+,,0,0,0,,Rahatsız oldu!
Dialogue: 50,0:21:20.51,0:21:25.43,Main-207+,,0,0,0,,N-Ne derseniz yaparım! Lütfen!\NBırakın gemide kalayım!
Dialogue: 50,0:21:25.43,0:21:26.68,Main-207+,,0,0,0,,İstediğini yap!
Dialogue: 50,0:21:33.02,0:21:39.74,Thoughts-207+,,0,0,0,,Bu seyahatte ne duyup ne görürsem hepsini günü gününe not etmeye niyetliyim.
Dialogue: 50,0:21:44.37,0:21:45.70,Main-207+,,0,0,0,,Düşman gemisi!
Dialogue: 50,0:21:45.70,0:21:48.20,Main-207+,,0,0,0,,Savaşa hazırlanın!
Dialogue: 50,0:21:50.16,0:21:52.08,Main-207+,,0,0,0,,Başlıyoruz! Başlıyoruz!
Dialogue: 50,0:21:54.08,0:21:55.13,Main-207+,,0,0,0,,Hey, bekle!
Dialogue: 50,0:21:55.13,0:21:56.17,Main-207+,,0,0,0,,Dur!
Dialogue: 50,0:21:56.17,0:21:57.55,Main-207+,,0,0,0,,– Oden!\N– Oden!
Dialogue: 50,0:22:10.06,0:22:12.06,Main-207+,,0,0,0,,Nasıldı ama?!
Dialogue: 50,0:22:12.69,0:22:13.81,Main-207+,,0,0,0,,Onları batırdım!
Dialogue: 50,0:22:13.81,0:22:16.11,Main-207+,,0,0,0,,Salak! Ne diye yaptın bunu?!
Dialogue: 50,0:22:16.11,0:22:18.32,Main-207+,,0,0,0,,Kendine nasıl korsan diyorsun?!
Dialogue: 50,0:22:19.07,0:22:21.82,Main-207+,,0,0,0,,Hiçbir şey araklamamıza izin vermedin!
Dialogue: 50,0:22:22.53,0:22:26.32,Thoughts-207+,,0,0,0,,Buradaki pek çok şey benim için yeni.
Dialogue: 50,0:22:28.33,0:22:30.54,Main-207+,,0,0,0,,Bu yer de ne böyle?!
Dialogue: 50,0:22:31.20,0:22:33.42,Thoughts-207+,,0,0,0,,Gördüğüm hiçbir şeye\Nbenzemeyen binalar...
Dialogue: 50,0:22:33.42,0:22:36.46,Thoughts-207+,,0,0,0,,ve jöle gibi dalgalanan ağaçlar!
Dialogue: 50,0:22:38.96,0:22:40.38,Main-207+,,0,0,0,,Oden, bekle!
Dialogue: 50,0:22:40.38,0:22:41.84,Main-207+,,0,0,0,,Etrafı daha gözlemlemedik!
Dialogue: 50,0:22:45.80,0:22:47.80,Thoughts-207+,,0,0,0,,Yepyeni bir dünya sanki!
Dialogue: 50,0:22:52.89,0:22:54.10,Main-207+,,0,0,0,,Ş-Şu şey..?!
Dialogue: 50,0:22:56.98,0:22:59.40,Main-207+,,0,0,0,,– Oden!\N– Oden!
Dialogue: 50,0:23:00.86,0:23:03.53,Thoughts-207+,,0,0,0,,Hiç bu kadar üşümemiştim!
Dialogue: 50,0:23:14.96,0:23:17.88,Thoughts-207+,,0,0,0,,Hiç bu kadar pişmemiştim!
Dialogue: 50,0:23:17.88,0:23:19.63,Main-207+,,0,0,0,,– Oden!\N– Oden!
Dialogue: 50,0:23:19.63,0:23:20.80,Main-207+,,0,0,0,,İyi misin?!
Dialogue: 50,0:23:20.80,0:23:22.26,Main-207+,,0,0,0,,Yanıyorum!
Dialogue: 50,0:23:34.89,0:23:36.85,Main-207+,,0,0,0,,Macera çağırıyor! Macera!
Dialogue: 50,0:23:38.40,0:23:40.69,Thoughts-207+,,0,0,0,,Tuhaf bitkiler...
Dialogue: 50,0:23:46.53,0:23:48.53,Thoughts-207+,,0,0,0,,Tuhaf hayvanlar...
Dialogue: 50,0:23:51.28,0:23:52.83,Thoughts-207+,,0,0,0,,Dev insanlar!
Dialogue: 50,0:23:53.20,0:23:54.70,Main-207+,,0,0,0,,Kocaman!
Dialogue: 50,0:23:57.75,0:23:58.96,Main-207+,,0,0,0,,Geri çekil!
Dialogue: 50,0:24:07.68,0:24:09.93,Main-207+,,0,0,0,,Pekâlâ!
Dialogue: 50,0:24:17.14,0:24:20.11,Thoughts-207+,,0,0,0,,Muazzam güçler...
Dialogue: 50,0:24:23.23,0:24:26.15,Thoughts-207+,,0,0,0,,İdeolojiler...
Dialogue: 50,0:24:26.15,0:24:30.66,Thoughts-207+,,0,0,0,,Her geçen gün gözlerim daha da açıldı!
Dialogue: 50,0:24:30.66,0:24:33.20,Thoughts-207+,,0,0,0,,{\fad(0,1021)}Karşılaştığım her şey hayallerimi aştı!
Dialogue: 50,0:24:33.45,0:24:37.54,Thoughts-207+,,0,0,0,,Şu koca dünyada zerreden ibaretmişim!
Dialogue: 50,0:24:40.79,0:24:41.96,Main-207+,,0,0,0,,Yaşım mı?
Dialogue: 50,0:24:42.34,0:24:47.47,Main-207+,,0,0,0,,26 yaşındayım ama 800 yıl önce doğdum.
Dialogue: 50,0:24:47.47,0:24:51.93,Main-207+,,0,0,0,,800 yıl önce mi?\NBayağı bildiğin kocakarıymışsın!
Dialogue: 50,0:24:55.27,0:24:57.43,Thoughts-207+,,0,0,0,,{\c&H000000&\3c&H000000&\4c&H000000&\t(18,558,1,\c&HFFFFFF&\3c&H525252&\4c&H000000&)}Her şeyin mümkün olduğunu öğrendim!
Dialogue: 50,0:24:57.43,0:25:01.35,Thoughts-207+,,0,0,0,,Dünya devasa ve olmayacak şey yok!
Dialogue: 50,0:25:03.27,0:25:08.53,Thoughts-207+,,0,0,0,,Uzun bir deniz şeriti tarafından ayrılan dört okyanus varmış.
Dialogue: 50,0:25:08.53,0:25:13.07,Thoughts-207+,,0,0,0,,{\fad(0,1018)}Bir de dünya, pirinç topu gibi yuvarlakmış!
Dialogue: 50,0:25:13.20,0:25:16.04,Thoughts-207+,,0,0,0,,{\fad(0,1026)}Büyüleyici!
Dialogue: 50,0:25:17.91,0:25:20.92,Main-207+,,0,0,0,,Yolculuktan keyif alıyor musun, Toki?
Dialogue: 50,0:25:20.92,0:25:22.17,Main-207+,,0,0,0,,Harika geçiyor.
Dialogue: 50,0:25:22.17,0:25:24.92,Main-207+,,0,0,0,,Dünyayı daha fazla görmek istiyorum.
Dialogue: 50,0:25:24.92,0:25:27.42,Main-207+,,0,0,0,,Gerçekten mi? Bunu duyduğuma sevindim!
Dialogue: 50,0:25:27.42,0:25:28.92,Main-207+,,0,0,0,,O bir harita mı?
Dialogue: 50,0:25:28.92,0:25:29.76,Main-207+,,0,0,0,,Evet!
Dialogue: 70,0:25:30.30,0:25:34.22,Main-207+,,0,0,0,,Wano dünyaya kıyasla küçücük kalıyor.
Dialogue: 50,0:25:34.22,0:25:37.14,Main-207+,,0,0,0,,Sen nerede doğdun, Toki?
Dialogue: 50,0:25:38.89,0:25:40.23,Main-207+,,0,0,0,,Bilmiyorum.
Dialogue: 50,0:25:41.23,0:25:44.44,Main-207+,,0,0,0,,Tek bildiğim ailemin Wano'lu olduğu.
Dialogue: 50,0:25:46.15,0:25:50.95,Main-207+,,0,0,0,,Oraya gitmeyi her şeyden çok istiyorum.
Dialogue: 50,0:25:51.49,0:25:55.03,Main-207+,,0,0,0,,Ama bu gemi muhtemelen bir süre\Ndaha oraya dönmeyecek.
Dialogue: 50,0:25:58.37,0:25:59.91,Main-207+,,0,0,0,,Üzgünüm.
Dialogue: 50,0:26:01.41,0:26:05.04,Main-207+,,0,0,0,,Sorun değil. Seninle çok eğleniyorum!
Dialogue: 50,0:26:06.34,0:26:10.51,Main-207+,,0,0,0,,Seninle olduğum her an,\Ndünyadaki yerimi bulmuş gibi hissediyorum.
Dialogue: 50,0:26:11.38,0:26:12.93,Main-207+,,0,0,0,,Neden acaba...
Dialogue: 50,0:26:12.93,0:26:14.43,Main-207+,,0,0,0,,Ben de bilmiyorum...
Dialogue: 50,0:26:15.05,0:26:16.39,Main-207+,,0,0,0,,Çok tuhaf...
Dialogue: 50,0:26:16.39,0:26:17.76,Main-207+,,0,0,0,,Evet, öyle!
Dialogue: 50,0:26:22.77,0:26:24.02,Main-207+,,0,0,0,,Hey!
Dialogue: 50,0:26:24.02,0:26:26.44,Main-207+,,0,0,0,,Oden-{\i1}sama{\i0}'yı gördünüz mü?
Dialogue: 50,0:26:26.44,0:26:27.44,Main-207+,,0,0,0,,Şurada mı?
Dialogue: 50,0:26:28.32,0:26:30.07,Main-207+,,0,0,0,,Merak kediyi öldürür!
Dialogue: 50,0:26:43.41,0:26:45.58,Thoughts-207+,,0,0,0,,Beyazsakal'ın bile düşmanı varmış...
Dialogue: 50,0:26:46.42,0:26:47.54,Main-207+,,0,0,0,,Denizciler!
Dialogue: 50,0:26:47.54,0:26:49.13,Main-207+,,0,0,0,,Geri çekilin!
Dialogue: 50,0:26:50.63,0:26:51.84,Main-207+,,0,0,0,,Neden kaçtık?!
Dialogue: 50,0:26:52.22,0:26:54.34,Main-207+,,0,0,0,,Güçlü görünüyorlardı!
Dialogue: 50,0:26:54.34,0:26:55.59,Main-207+,,0,0,0,,Onlarla savaşmalıydık!
Dialogue: 50,0:26:55.59,0:26:57.60,Main-207+,,0,0,0,,Onlar Denizciler'di!
Dialogue: 50,0:26:58.56,0:27:00.31,Main-207+,,0,0,0,,Büyük bir organizasyondur.
Dialogue: 50,0:27:00.31,0:27:04.81,Main-207+,,0,0,0,,Bugün onları indirsek bile,\Nyarın peşimize daha fazlası takılır.
Dialogue: 50,0:27:05.69,0:27:09.07,Main-207+,,0,0,0,,Yani tüm dünyanın düzeni\Nbu organizasyonun elinde mi?!
Dialogue: 50,0:27:09.90,0:27:12.15,Main-207+,,0,0,0,,Buradaki düşmanlar olağanüstü!
Dialogue: 50,0:27:12.69,0:27:17.03,Main-207+,,0,0,0,,Güçlerini tartmadan önce dünyayı biraz daha gör.
Dialogue: 50,0:27:17.49,0:27:20.49,Main-207+,,0,0,0,,Ülkenin özgür olmasına şaşıracaksın da!
Dialogue: 50,0:27:29.17,0:27:31.30,Main-207+,,0,0,0,,Bugünkü gazete de boş çıktı.
Dialogue: 50,0:27:32.05,0:27:33.92,Main-207+,,0,0,0,,Yine mi Beyazsakal haberi?!
Dialogue: 50,0:27:33.92,0:27:36.05,Main-207+,,0,0,0,,Biz de millete bela oluyoruz be!
Dialogue: 50,0:27:36.05,0:27:38.30,Main-207+,,0,0,0,,Hey! Okumayı daha bitirmedim!
Dialogue: 50,0:27:38.30,0:27:44.56,Main-207+,,0,0,0,,Beyazsakal'ın Wano'dan aldığı o deli samuray yine ortalığı dağıtıp duruyor.
Dialogue: 50,0:27:46.31,0:27:47.90,Main-207+,,0,0,0,,– Kaptan!\N– Kaptan!
Dialogue: 50,0:27:51.19,0:27:54.69,Main-207+,,0,0,0,,İzole bir ülkeden kaçmış samuray demek!
Dialogue: 50,0:27:55.82,0:27:57.99,Main-207+,,0,0,0,,Umarım yollarımız kesişir!
Dialogue: 0,0:01:31.90,0:01:35.70,Title-207+,,0,0,0,,{\c&HF9F8F9&\1a&HFF&\blur0.8\fad(734,0)\fscx110\fscy110\bord2.8\t(693,734,\1a&H00&)}Oden'in Macerası
