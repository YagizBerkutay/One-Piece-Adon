FF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,2.4,2.4,8,180,180,27,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:02:33.19,0:02:41.49,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Mantisentil thx to onepace.netDialogue: 0,0:15:44.00,0:15:54.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Mantisentil thx to onepace.netDialogue: 0,0:36:47.85,0:36:50.85,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Mantisentil thx to onepace.netDialogue: 0,0:02:33.19,0:02:41.49,Title,,0,0,0,,HABERDialogue: 5,0:02:43.51,0:02:45.58,Narrator-207+,,0,0,0,,Burası Doğu Mavi.Dialogue: 5,0:02:45.58,0:02:49.72,Narrator-207+,,0,0,0,,Devrim Ordusu Robin'i kölelikten kurtardı.Dialogue: 5,0:02:54.69,0:02:57.06,Thoughts-207+,,0,0,0,,Devrim IşığıDialogue: 5,0:02:57.56,0:03:03.43,Main-207+,,0,0,0,,On seneyi aşan seni arama sürecimizde sana bu ismi takmıştık.Dialogue: 5,0:03:04.10,0:03:08.97,Main-207+,,0,0,0,,Ohara'dan, dünyaya kafa tutan ülkeden hayatta kalan bir tek sen varsın.Dialogue: 5,0:03:10.34,0:03:15.07,Main-207+,,0,0,0,,Seni bulsaydık, hükümeti senden uzak tutmak için her şeyi yapardık.Dialogue: 5,0:03:15.07,0:03:16.61,Main-207+,,0,0,0,,Patronumuzun emriyle.Dialogue: 5,0:03:18.08,0:03:18.88,Main-207+,,0,0,0,,Patronunuz mu?Dialogue: 5,0:03:20.88,0:03:24.52,Main-207+,,0,0,0,,Devrim Ordusu başkumandanı, Dragon.Dialogue: 5,0:03:25.48,0:03:27.22,Thoughts-207+,,0,0,0,,Luffy'nin babası...Dialogue: 5,0:03:29.12,0:03:30.72,Main-207+,,0,0,0,,Kaderin oyununa bak.Dialogue: 5,0:03:32.96,0:03:35.09,Main-207+,,0,0,0,,Size bir kez daha soruyorum.Dialogue: 5,0:03:35.09,0:03:38.56,Main-207+,,0,0,0,,Lütfen patronumuzla görüşmeyi kabul edin.Dialogue: 5,0:03:38.56,0:03:40.03,Main-207+,,0,0,0,,Sizi ona bizzat götüreceğiz.Dialogue: 5,0:03:40.03,0:03:44.50,Main-207+,,0,0,0,,Yapamam... Gitmem gereken başka bir yer var.Dialogue: 5,0:03:44.50,0:03:47.87,Main-207+,,0,0,0,,Ayrıca korumanız olmadan da idare edebilirim.Dialogue: 5,0:03:49.37,0:03:52.01,Main-207+,,0,0,0,,Çünkü arkadaşlarım var.Dialogue: 5,0:03:52.01,0:03:55.35,Main-207+,,0,0,0,,Hasır Şapkalar'ı kastediyorsunuz değil mi?Dialogue: 5,0:03:55.35,0:03:56.72,Main-207+,,0,0,0,,Duydunuz mu?Dialogue: 5,0:03:56.72,0:04:00.85,Main-207+,,0,0,0,,Dragon-san'ın oğlu olduğu söylenen Hasır Şapka Luffy bugün gazetelerdeydi.Dialogue: 5,0:04:00.85,0:04:07.24,Main-207+,,0,0,0,,Evet. Savaştan sonra kaybolmuştu, ama bir anda bu oldu.Dialogue: 5,0:04:07.24,0:04:10.70,Main-207+,,0,0,0,,Bu haberi bir an önce Nico Robin'e göstermeliyiz.Dialogue: 5,0:04:10.70,0:04:12.76,Main-207+,,0,0,0,,Muhtemelen onun için endişeleniyordur.Dialogue: 5,0:04:12.76,0:04:16.24,Main-207+,,0,0,0,,Hala köprüde olmalılar.Dialogue: 5,0:04:16.74,0:04:20.64,Main-207+,,0,0,0,,Köprüye kadar birçok harabeden geçeceğiz.Dialogue: 5,0:04:20.64,0:04:25.88,Main-207+,,0,0,0,,Ülkedeki insanlar köprünün inşaatı ile taşındıktan sonra öyle kaldılar.Dialogue: 5,0:04:25.88,0:04:29.52,Main-207+,,0,0,0,,Laf arasında 300 yıl önce inşaatın başladığı yer burası.Dialogue: 5,0:04:30.15,0:04:32.32,Main-207+,,0,0,0,,Bu köprüyü neden yaptılar?Dialogue: 5,0:04:32.32,0:04:35.85,Main-207+,,0,0,0,,Dünya Soyluları, Kutsal Ejderler'in emirleriyle.Dialogue: 5,0:04:35.85,0:04:37.22,Main-207+,,0,0,0,,Kutsal Ejderler mi?Dialogue: 5,0:04:37.22,0:04:44.00,Main-207+,,0,0,0,,İnşaatın sebebi ne olursa olsun burada ölen kölelerin ahı onlarda!Dialogue: 5,0:04:45.63,0:04:46.97,Main-207+,,0,0,0,,Aferin.Dialogue: 5,0:04:47.60,0:04:49.07,Main-207+,,0,0,0,,Bu sana, Robin-san.Dialogue: 5,0:04:50.94,0:04:52.30,Main-207+,,0,0,0,,Luffy!Dialogue: 5,0:04:53.04,0:04:55.17,Main-207+,,0,0,0,,Güvendesin, içim rahatladı.Dialogue: 5,0:04:58.91,0:05:00.38,Main-207+,,0,0,0,,Ne oldu?Dialogue: 5,0:05:00.38,0:05:02.81,Main-207+,,0,0,0,,İlginç bir haber mi var?Dialogue: 5,0:05:04.72,0:05:05.65,Main-207+,,0,0,0,,Evet.Dialogue: 5,0:05:26.97,0:05:29.74,Main-207+,,0,0,0,,Bu Hasır Şapkalı Oğlan'ın aranıyor posteri değil mi?Dialogue: 5,0:05:29.74,0:05:31.08,Main-207+,,0,0,0,,Evet o.Dialogue: 5,0:05:31.61,0:05:33.91,Main-207+,,0,0,0,,Bu da Korsan Avcısı Zoro.Dialogue: 5,0:05:33.91,0:05:34.78,Main-207+,,0,0,0,,Bana ne?!Dialogue: 5,0:05:34.78,0:05:37.52,Main-207+,,0,0,0,,Bu Hırsız Kedi, Nami.Dialogue: 5,0:05:39.15,0:05:42.82,Main-207+,,0,0,0,,Bu Keskin Nişancıların Kralı, Sogeking.Dialogue: 5,0:05:42.82,0:05:44.22,Main-207+,,0,0,0,,Evet.Dialogue: 5,0:05:44.22,0:05:46.36,Main-207+,,0,0,0,,Bu... sensin?Dialogue: 5,0:05:46.36,0:05:46.93,Main-207+,,0,0,0,,HAYIR!Dialogue: 5,0:05:46.93,0:05:48.33,Main-207+,,0,0,0,,Bak buraya!Dialogue: 5,0:05:48.33,0:05:50.46,Main-207+,,0,0,0,,Hangisi sensin söyle!Dialogue: 5,0:05:50.46,0:05:54.17,Main-207+,,0,0,0,,Hasır Şapkalı Oğlan'ın tayfasındanım diyorsun ama hani kanıt nerede?!Dialogue: 5,0:05:54.17,0:05:56.57,Main-207+,,0,0,0,,Evet ben onun tayfasındanım!Dialogue: 5,0:05:56.57,0:06:00.31,Main-207+,,0,0,0,,Söyle bana Luffy ne yapıyor, 'Kama Kralı!Dialogue: 5,0:06:00.67,0:06:04.48,Main-207+,,0,0,0,,Gazetede diyor ki Luffy ile birlikte çalışıyormuşsun!Dialogue: 5,0:06:04.48,0:06:06.18,Main-207+,,0,0,0,,O zaman sen bu musun?Dialogue: 5,0:06:06.18,0:06:08.18,Main-207+,,0,0,0,,Hayır!Dialogue: 5,0:06:08.61,0:06:11.95,Main-207+,,0,0,0,,O ben değilim ama o benim posterim...Dialogue: 5,0:06:13.19,0:06:15.79,Main-207+,,0,0,0,,İsim... bana ait.Dialogue: 5,0:06:19.56,0:06:22.26,Main-207+,,0,0,0,,Nedir bu? Bir iç hesaplaşma mı?Dialogue: 5,0:06:25.93,0:06:29.20,Main-207+,,0,0,0,,Pekala... o benim!Dialogue: 5,0:06:29.50,0:06:32.34,Main-207+,,0,0,0,,O posterdeki ağzı yüzü kayık adam benim!Dialogue: 5,0:06:32.34,0:06:33.27,Main-207+,,0,0,0,,Şimdi lütfen...Dialogue: 5,0:06:37.08,0:06:39.58,Main-207+,,0,0,0,,Hayır. Sana hiç benzemiyor.Dialogue: 5,0:06:39.88,0:06:41.71,Main-207+,,0,0,0,,O zaman niye zorla söyletiyorsun!Dialogue: 5,0:06:41.71,0:06:43.52,Main-207+,,0,0,0,,Kan kusturdun bana, aptal!Dialogue: 5,0:06:43.85,0:06:45.35,Main-207+,,0,0,0,,Yapamayız.Dialogue: 5,0:06:45.35,0:06:50.92,Main-207+,,0,0,0,,Hükümetin ve Donanma'nın ajanı olma şansın %0.1 olsa bile yapamayız.Dialogue: 5,0:06:50.92,0:06:57.30,Main-207+,,0,0,0,,Sana Hasır Şapkalı Oğlan ile ilgili tek bir bilgi vermeyeceğiz!Dialogue: 5,0:06:57.30,0:06:58.93,Main-207+,,0,0,0,,Anlıyorum.Dialogue: 5,0:06:58.93,0:07:00.57,Main-207+,,0,0,0,,O halde bana ödünç bir gemi verin.Dialogue: 5,0:07:00.57,0:07:03.37,Main-207+,,0,0,0,,Buluşma noktasına gideceğim, Luffy orada olacaktır.Dialogue: 5,0:07:03.37,0:07:04.94,Main-207+,,0,0,0,,Sana gemi de veremeyiz.Dialogue: 5,0:07:05.54,0:07:07.84,Main-207+,,0,0,0,,İyi, öyleyse oraya kadar yüzerim!Dialogue: 5,0:07:08.14,0:07:09.71,Main-207+,,0,0,0,,N-ne?!Dialogue: 5,0:07:09.71,0:07:13.05,Main-207+,,0,0,0,,Bu irade Hasır Şapkalı Oğlan'ın arkadaşlarında olacak cinsten!Dialogue: 5,0:07:14.95,0:07:16.68,Main-207+,,0,0,0,,Başka seçeneğimiz yok.Dialogue: 5,0:07:16.68,0:07:18.08,Main-207+,,0,0,0,,Kalbimi çaldın bir kere.Dialogue: 5,0:07:18.08,0:07:22.15,Main-207+,,0,0,0,,Hasır Şapkalı Oğlan hakkındaki inadından dolayı sana...Dialogue: 5,0:07:24.82,0:07:27.19,Main-207+,,0,0,0,,Hiçbir şey söylemeyeceğim!Dialogue: 5,0:07:28.93,0:07:32.23,Main-207+,,0,0,0,,Bir şey söylemeyecek misin?!  Fena kandırdın bizi!Dialogue: 5,0:07:33.33,0:07:34.40,Main-207+,,0,0,0,,Kesin sesinizi!Dialogue: 5,0:07:37.32,0:07:38.87,Main-207+,,0,0,0,,Lanet olsun...Dialogue: 5,0:07:38.87,0:07:41.24,Main-207+,,0,0,0,,Pes etmiş gibi duruyor değil mi?Dialogue: 5,0:07:41.24,0:07:45.34,Main-207+,,0,0,0,,Şimdi tam zamanı!  Giydirelim giydirelim... tatlı elbiseyi!Dialogue: 5,0:07:45.34,0:07:47.31,Main-207+,,0,0,0,,Onu bir daha hayatta giymem!Dialogue: 5,0:07:47.31,0:07:48.41,Main-207+,,0,0,0,,Geri durun!Dialogue: 5,0:07:49.18,0:07:53.49,Main-207+,,0,0,0,,Adam oğlu adamım ben,  kadınlardan hoşlanıyorum!Dialogue: 5,0:07:53.49,0:07:55.92,Main-207+,,0,0,0,,Benden uzak durun!Dialogue: 5,0:07:59.32,0:08:02.13,Main-207+,,0,0,0,,Hey, senin adın Iva, değil mi?Dialogue: 5,0:08:02.13,0:08:05.16,Main-207+,,0,0,0,,Bir korsan gibi davranıp gemilerinden birini çalmaya karar verdim.Dialogue: 5,0:08:06.13,0:08:07.77,Main-207+,,0,0,0,,Dövüş benimle!Dialogue: 5,0:08:08.53,0:08:09.67,Main-207+,,0,0,0,,Pekala.Dialogue: 5,0:08:22.41,0:08:26.62,Main-207+,,0,0,0,,Sana Hasır Şapkalı Oğlan'ın ne yaptığını söyleyeceğim, Kıvırcık Oğlan.Dialogue: 5,0:08:27.65,0:08:29.76,Main-207+,,0,0,0,,Neden lafından döndün?Dialogue: 5,0:08:30.32,0:08:34.46,Main-207+,,0,0,0,,Çünkü zaten bütün dünya biliyor.Dialogue: 5,0:08:34.46,0:08:37.33,Main-207+,,0,0,0,,Acaba ne planlıyor.Dialogue: 5,0:08:37.83,0:08:39.60,Main-207+,,0,0,0,,Bu bugünün gazetesi mi?Dialogue: 5,0:08:39.60,0:08:41.23,Main-207+,,0,0,0,,Ha, Luffy?!Dialogue: 5,0:08:41.53,0:08:44.04,Main-207+,,0,0,0,,Iva-san, Baltigo'dan bir telefon var.Dialogue: 5,0:08:44.04,0:08:45.04,Main-207+,,0,0,0,,Gerçekten mi?Dialogue: 5,0:08:45.04,0:08:47.27,Main-207+,,0,0,0,,Lütfen iletişim odasına gelin.Dialogue: 5,0:08:48.17,0:08:50.28,Main-207+,,0,0,7,,Savaşta olanlar yüzünden,Dialogue: 5,0:08:50.28,0:08:54.61,Main-207+,,0,0,7,,oğlun kim bütün dünya öğrendi, Dragon.Dialogue: 5,0:08:54.65,0:08:57.45,Main-207+,,0,0,0,,Bu Devrim Ordusu askerleri için problem teşkil ediyor mu?Dialogue: 5,0:08:58.82,0:09:04.26,Main-207+,,0,0,0,,Hiç değilse herkes esrarengiz liderlerinin etten kemikten bir insan evladı olduğunu öğrenerek rahatladı.Dialogue: 5,0:09:04.26,0:09:06.16,Main-207+,,0,0,0,,Gerçi bir önemi yok ya.Dialogue: 5,0:09:06.16,0:09:07.89,Main-207+,,0,0,0,,Luffy artık çocuk değil.Dialogue: 5,0:09:07.89,0:09:12.43,Main-207+,,0,0,0,,İkinizin işbirliği yapacağınızı asla tahmin edemezdim.Dialogue: 5,0:09:12.43,0:09:15.97,Main-207+,,0,0,0,,Kaderin ilginç bir cilvesiydi cidden.Dialogue: 5,0:09:16.94,0:09:22.90,Main-207+,,0,0,0,,O değil de, Inazuma ile sana soracak dünya kadar şeyimiz var.Dialogue: 5,0:09:22.90,0:09:25.94,Main-207+,,0,0,0,,Ve hapisten kaçışımız ile ilgili anlatacaklarımız var.Dialogue: 5,0:09:25.94,0:09:32.98,Main-207+,,0,0,0,,Eminim öyledir. Çok geçmeden dünyanın dört bir yanındaki liderler toplanmalı.Dialogue: 5,0:09:32.98,0:09:38.66,Main-207+,,0,0,0,,Beyazsakal'ın ölümü hükümetin yapısını ve dünyanın gideceği yönü değiştirecektir.Dialogue: 5,0:09:38.66,0:09:39.96,Main-207+,,0,0,0,,Ayrıca,Dialogue: 5,0:09:39.96,0:09:43.56,Main-207+,,0,0,0,,Kuma'ya olanları sana anlatmam lazım.Dialogue: 5,0:09:43.56,0:09:46.73,Main-207+,,0,0,0,,Evet, bana her şeyi anlat.Dialogue: 5,0:09:46.73,0:09:50.74,Main-207+,,0,0,0,,Neden Dünya Hükümeti'nin uşağı oldu?Dialogue: 5,0:09:51.14,0:09:54.07,Main-207+,,0,0,0,,Bizim bildiğimiz Kuma gitmiş.Dialogue: 5,0:09:54.47,0:09:57.94,Main-207+,,0,0,0,,Beni öldürmeye çalıştı.Dialogue: 5,0:09:58.41,0:10:01.65,Main-207+,,0,0,0,,Bu arada Dragon,  bugünün gazetesine baktın mı?Dialogue: 5,0:10:01.65,0:10:05.05,Main-207+,,0,0,0,,Hasır Şapkalı Oğlan bizi yine şaşırtıyor!Dialogue: 5,0:10:05.05,0:10:07.72,Main-207+,,0,0,0,,Babası gibi sağı solu belli değil.Dialogue: 5,0:10:07.72,0:10:11.66,Main-207+,,0,0,0,,Marineford'da böyle bir şey yapacağı kimin aklına gelirdi?Dialogue: 5,0:10:15.86,0:10:19.56,Narrator-207+,,0,0,0,,Bu arada... Thousand Sunny'nin demir attığı yer burası.Dialogue: 5,0:10:19.56,0:10:22.73,Narrator-207+,,0,0,0,,Grand Line'da Sabaody Takımadaları.Dialogue: 5,0:10:22.73,0:10:25.67,Narrator-207+,,0,0,0,,Koru 44.Dialogue: 5,0:10:25.67,0:10:29.14,Main-207+,,0,0,0,,O gemiyi bize verin!Dialogue: 5,0:10:29.71,0:10:35.08,Main-207+,,0,0,0,,Devrim Ordusu'ndan Dragon'un oğlu Hasır Şapka Luffy'e ait değil mi?!Dialogue: 5,0:10:35.08,0:10:39.28,Main-207+,,0,0,0,,Eğer gemiyi Donanma'ya verirsek eminim karşılığı olacaktır!Dialogue: 5,0:10:41.99,0:10:43.96,Main-207+,,0,0,0,,İkimiz de aynı taraftayız,Dialogue: 5,0:10:44.56,0:10:48.49,Main-207+,,0,0,0,,Zorluk çıkarmadan teslim ederseniz, ödülün yarısını size veririm.Dialogue: 5,0:10:48.86,0:10:50.76,Main-207+,,0,0,0,,Ne diyorsunuz, Uçan Balık Binicileri?Dialogue: 5,0:10:50.76,0:10:52.26,Main-207+,,0,0,0,,Ne dedin? Çok mu yakışıklıyım?Dialogue: 5,0:10:53.20,0:10:55.73,Main-207+,,0,0,0,,Sağır mısın?! Gemiyi bize ver diyorum, aptal!Dialogue: 5,0:10:57.07,0:10:59.97,Main-207+,,0,0,0,,Hayatta olmaz!Dialogue: 5,0:11:06.01,0:11:09.85,Main-207+,,0,0,0,,Dinleyin!  Bu gördüğünüz yakışıklının ismi Duval.Dialogue: 5,0:11:09.85,0:11:12.65,Main-207+,,0,0,0,,Sizin gibi bir avuç malın bütün hatunları kapmasına izin vermeyeceğim...Dialogue: 5,0:11:13.39,0:11:15.62,Main-207+,,0,0,0,,Yani bu kadar seksi olduğum sürece kurtarıcılarımın gemisini çalmanıza müsade etmeyeceğim...Dialogue: 5,0:11:15.99,0:11:17.39,Main-207+,,0,0,0,,Burada olduğum sürece!Dialogue: 5,0:11:17.86,0:11:20.29,Main-207+,,0,0,0,,Konuşmanın içine ettin!Dialogue: 5,0:11:20.79,0:11:25.10,Main-207+,,0,0,0,,Kara gözlerim görmeye devam ettiği sürece Genç Efendi'nin gemisine dokunmanıza izin vermeyeceğim!Dialogue: 5,0:11:25.10,0:11:27.60,Main-207+,,0,0,0,,Eğer dokunmaya kalkarsanız ben de güzel bir hanımefendiye dokunmak isterim...Dialogue: 5,0:11:27.60,0:11:29.10,Main-207+,,0,0,0,,Aman yanlış söyledim!Dialogue: 5,0:11:29.63,0:11:32.47,Main-207+,,0,0,0,,Demek istediğim sanmayın ki dokunmanıza müsade edeceğim!Dialogue: 5,0:11:32.47,0:11:34.14,Main-207+,,0,0,0,,Öyle değil mi çocuklar?!Dialogue: 5,0:11:34.14,0:11:35.41,Main-207+,,0,0,0,,Evet, Rose-some!Dialogue: 5,0:11:36.84,0:11:38.21,Main-207+,,0,0,0,,Geri çekilin!Dialogue: 5,0:11:39.91,0:11:42.05,Main-207+,,0,0,0,,Duval-chin, ne kadar havalısın!Dialogue: 5,0:11:43.92,0:11:46.42,Main-207+,,0,0,0,,Bir hanımefendi yakışıklılığım karşısında aşkını ilan mı ediyor?Dialogue: 5,0:11:48.82,0:11:52.09,Main-207+,,0,0,0,,Ben de seni seviyorum!Dialogue: 5,0:11:52.09,0:11:55.13,Main-207+,,0,0,0,,Onları Denizkızı Kafé'ye götürmeliyiz değil mi?Dialogue: 5,0:11:55.13,0:11:56.66,Main-207+,,0,0,0,,Çok havalı!Dialogue: 5,0:11:57.46,0:12:01.87,Main-207+,,0,0,0,,Balık Adam Adası'nın en turistik yeri Balık Adam Karate Dojosu'dur Caimie.Dialogue: 5,0:12:01.87,0:12:05.70,Main-207+,,0,0,0,,İskelet adama onu Denizkızı Prensesi ile tanıştıracağıma söz verdim!Dialogue: 5,0:12:05.70,0:12:08.61,Main-207+,,0,0,0,,Duval-sama, seni takmıyor bile!Dialogue: 5,0:12:08.61,0:12:10.91,Main-207+,,0,0,0,,Bu doğru. Boşverin!Dialogue: 5,0:12:11.51,0:12:15.51,Main-207+,,0,0,0,,Hey, Shakki-chin ? Vivre Kartı takip ederek buraya gelecekler değil mi?Dialogue: 5,0:12:16.08,0:12:19.62,Main-207+,,0,0,0,,Haberleri gördükten sonra biliyorum ki  Luffy-chin iyi durumda.Dialogue: 5,0:12:20.22,0:12:21.69,Main-207+,,0,0,0,,Evet,Dialogue: 5,0:12:22.09,0:12:24.46,Main-207+,,0,0,0,,ama biraz vakit alabilir.Dialogue: 5,0:12:24.46,0:12:27.39,Main-207+,,0,0,0,,En azından biliyoruz ki Ray-san  Monkey-chan ile güvenli bir şekilde buluştu.Dialogue: 5,0:12:30.80,0:12:34.50,Main-207+,,0,0,0,,Onlar dönene kadar bu gemiyi korumak için elimizden ne geliyorsa yapmalıyız.Dialogue: 5,0:12:34.50,0:12:37.64,Main-207+,,0,0,0,,Biz burada olduğumuz sürece o işi oldu bil ablacım!Dialogue: 5,0:12:37.80,0:12:40.31,Main-207+,,0,0,0,,Donanma ya da başkası olsun farketmez...Dialogue: 5,0:12:40.31,0:12:44.08,Main-207+,,0,0,0,,Kimsenin gemiyi çalmasına izin vermem!Dialogue: 5,0:12:44.88,0:12:46.48,Main-207+,,0,0,0,,Sana güveniyorum.Dialogue: 5,0:12:49.11,0:12:52.78,Main-207+,,0,0,0,,Duval-sama, bu korkunç! Kuma! Kuma burada!Dialogue: 5,0:12:53.22,0:12:56.39,Main-207+,,0,0,0,,Kuma: AyıDialogue: 5,0:12:53.22,0:12:56.39,Main-207+,,0,0,0,,Ayı mı?! Bu adada ayı yok ki.Dialogue: 5,0:12:57.06,0:12:57.69,Main-207+,,0,0,0,,Bu...Dialogue: 5,0:13:05.13,0:13:08.40,Main-207+,,0,0,0,,Shichibukai Bartholomew Kuma!Dialogue: 5,0:13:24.05,0:13:25.75,Main-207+,,0,0,0,,Panik yapmayın.Dialogue: 5,0:13:25.75,0:13:29.45,Main-207+,,0,0,0,,Bu adam Ray-san ile konuşmaya gelmişti.Dialogue: 5,0:13:30.89,0:13:32.76,Main-207+,,0,0,0,,O müttefikimiz.Dialogue: 5,0:13:33.06,0:13:34.26,Main-207+,,0,0,0,,Öyle mi?Dialogue: 5,0:13:40.87,0:13:44.87,Narrator-207+,,0,0,0,,Burası Grand Line'da kumu bol bir ada.Dialogue: 5,0:13:44.87,0:13:47.44,Narrator-207+,,0,0,0,,Kum Diyarı, Arabasta Krallığı.Dialogue: 5,0:13:48.51,0:13:51.18,Narrator-207+,,0,0,0,,Başkent Alubarna.Dialogue: 5,0:13:54.28,0:13:56.58,Main-207+,,0,0,0,,Korsanlarla ilgili son durum nedir?Dialogue: 5,0:13:56.58,0:13:59.52,Main-207+,,0,0,0,,Tamamını başarıyla defettik.  Şehir minimum seviyede zayiat verdi.Dialogue: 5,0:13:59.52,0:14:03.15,Main-207+,,0,0,0,,Ülkenin tüm limanlarında güvenlik önlemlerini arttırıyoruz.Dialogue: 5,0:14:03.15,0:14:04.99,Main-207+,,0,0,0,,Tedbiri elden bırakamayız.Dialogue: 5,0:14:04.99,0:14:09.73,Main-207+,,0,0,0,,Keşke tüm korsanlar Luffy-kun gibi olsa...Dialogue: 5,0:14:09.73,0:14:11.66,Main-207+,,0,0,0,,ne yazık ki bu mümkün değil.Dialogue: 5,0:14:12.23,0:14:14.13,Main-207+,,0,0,0,,Lafı geçmişken, Ekselansları.Dialogue: 5,0:14:14.13,0:14:16.27,Main-207+,,0,0,0,,Bugünün gazetesine baktınız mı?Dialogue: 5,0:14:16.27,0:14:18.00,Main-207+,,0,0,0,,Ah tabii ki.Dialogue: 5,0:14:20.41,0:14:23.98,Main-207+,,0,0,0,,Luffy-san'ın kolundaki bu şeyler... Sayılar mı?Dialogue: 5,0:14:23.98,0:14:25.38,Main-207+,,0,0,0,,Bir tür iz mi?Dialogue: 5,0:14:25.38,0:14:27.71,Main-207+,,0,0,0,,Yoksa sadece havalı görünsün diye yaptığı bir şey mi?Dialogue: 5,0:14:27.71,0:14:30.18,Main-207+,,0,0,0,,Yok öyle olamaz değil mi?  Luffy-san sonuçta.Dialogue: 5,0:14:38.26,0:14:43.83,Narrator-207+,,0,0,0,,Grand Line'da bir adanın bir kasabasında.Dialogue: 5,0:14:47.53,0:14:51.34,Main-207+,,0,0,0,,H-Hey! Bu adada ne arıyor?!Dialogue: 5,0:14:51.34,0:14:52.60,Main-207+,,0,0,0,,Ssssh! Bizi duyacak!Dialogue: 5,0:14:53.51,0:14:56.71,Main-207+,,0,0,0,,Savaş biteli daha üç hafta oldu.Dialogue: 5,0:14:57.94,0:15:00.65,Main-207+,,0,0,0,,Ölümden döndükten sonra hala istirahat ediyor olması gerekirdi.Dialogue: 5,0:15:03.92,0:15:07.25,Main-207+,,0,0,0,,Burada ne işi var acaba?Dialogue: 5,0:15:07.25,0:15:09.91,Main-207+,,0,0,0,,Bir planı olmalı.Dialogue: 5,0:15:09.91,0:15:11.72,Main-207+,,0,0,0,,Yoksa da aklını kaçırmış olmalı.Dialogue: 5,0:15:12.89,0:15:14.83,Main-207+,,0,0,0,,Öyle mi düşünüyorsun, Daz?Dialogue: 5,0:15:15.96,0:15:21.97,Main-207+,,0,0,0,,Hasır Şapka yaralı.  Yaralar bu kadar kolay mı sarılır sence?Dialogue: 5,0:15:23.33,0:15:26.97,Main-207+,,0,0,0,,Seni arsız piç.  Kinaye mi yapıyorsun?Dialogue: 5,0:15:29.44,0:15:31.71,Main-207+,,0,0,0,,Benim yaralarım iyileşeli çok oldu.Dialogue: 5,0:15:32.41,0:15:37.35,Main-207+,,0,0,0,,Bunu kanıtlamak için yakında  Yeni Dünya'ya gideceğim. Anısı bol oraların.Dialogue: 5,0:15:38.85,0:15:40.22,Main-207+,,0,0,0,,Benimle geliyor musun?Dialogue: 5,0:15:42.59,0:15:43.89,Main-207+,,0,0,0,,Tabii ki.Dialogue: 5,0:15:45.06,0:15:48.46,Narrator-207+,,0,0,0,,Grand Line'da terkedilmiş bir ada.Dialogue: 5,0:15:53.33,0:15:55.77,Main-207+,,0,0,0,,Sen tutuklandığından beri,Dialogue: 5,0:15:55.77,0:15:59.70,Main-207+,,0,0,0,,O kadar endişeliydim ki geceleri gözüme uyku girmiyordu. Seni hapisten kaçırma planları yapıyordum!Dialogue: 5,0:15:59.70,0:16:04.58,Main-207+,,0,0,0,,Bütün denizleri dolaştık, başımızda gelmeyen kalmadı.Dialogue: 5,0:16:04.58,0:16:09.05,Main-207+,,0,0,0,,Üstüne bir de hapiste olman gerekirken gazeteler seni bir anda kahraman olarak yazdı!Dialogue: 5,0:16:13.89,0:16:15.65,Main-207+,,0,0,0,,Kaptan Buggy!Dialogue: 5,0:16:15.65,0:16:17.42,Main-207+,,0,0,0,,Her yerde seni arıyorduk!Dialogue: 5,0:16:19.09,0:16:23.39,Main-207+,,0,0,0,,Sana olan güvenimiz ve sadakatimiz tamdı o yüzden düşündük ki:Dialogue: 5,0:16:23.39,0:16:27.07,Main-207+,,0,0,0,,"Görüyor musun, Yeni Dünya?!  İşte bizim kaptanımız!"Dialogue: 5,0:16:28.27,0:16:31.70,Main-207+,,0,0,0,,Çocuklar! Bana gerçekten bu kadar inanıyor muydunuz?!Dialogue: 5,0:16:31.70,0:16:33.94,Main-207+,,0,0,0,,Sizi o kadar özledim ki!Dialogue: 5,0:16:33.94,0:16:36.27,Main-207+,,0,0,0,,Kaptan Buggy!Dialogue: 5,0:16:42.75,0:16:44.45,Main-207+,,0,0,0,,Siz yok mu siz...Dialogue: 5,0:16:44.98,0:16:47.39,Main-207+,,0,0,0,,Buggy'i terkedip gitmemiş miydiniz?Dialogue: 5,0:16:58.50,0:17:01.13,Main-207+,,0,0,0,,Şimdi millet!Dialogue: 5,0:17:02.43,0:17:06.07,Main-207+,,0,0,0,,Ben Buggy Korsanları'nın ikinci kaptanı, Mohji!Dialogue: 5,0:17:06.07,0:17:08.64,Main-207+,,0,0,0,,Büyük Abi Mohji!Dialogue: 5,0:17:09.64,0:17:11.91,Main-207+,,0,0,0,,Ben personal şefi, Cabaji!Dialogue: 5,0:17:11.91,0:17:14.65,Main-207+,,0,0,0,,Büyük Abi Cabaji!Dialogue: 5,0:17:14.65,0:17:19.25,Main-207+,,0,0,0,,Bu da partnerim, Richie!Dialogue: 5,0:17:20.15,0:17:22.89,Main-207+,,0,0,0,,Richie!Dialogue: 5,0:17:25.96,0:17:30.56,Main-207+,,0,0,0,,Hala haberlerde yazanların gerçek olduğuna inanmıyorum!Dialogue: 5,0:17:30.56,0:17:35.43,Main-207+,,0,0,0,,Bütün o adamlar yüksek ödüllü azılı suçlular, posterlerini görmüştüm.Dialogue: 5,0:17:36.60,0:17:41.31,Main-207+,,0,0,0,,Aslına bakarsan onlar benim Impel Down'dan suç ortaklarım!Dialogue: 5,0:17:41.31,0:17:47.11,Main-207+,,0,0,0,,Oh, evet... Hey Alvida,  ilginç bir şey görmek ister misin?Dialogue: 5,0:17:47.11,0:17:48.95,Main-207+,,0,0,0,,Ta-daa!Dialogue: 5,0:17:49.91,0:17:51.52,Main-207+,,0,0,0,,Bu...Dialogue: 5,0:17:51.52,0:17:55.32,Main-207+,,0,0,0,,İnanamıyorum!  Kaptan John'un hazinesi için değil mi?!Dialogue: 5,0:17:55.32,0:17:56.55,Main-207+,,0,0,0,,Aynen öyle!Dialogue: 5,0:17:56.55,0:17:59.89,Main-207+,,0,0,0,,Harika! Nereden eline geçti?Dialogue: 5,0:18:00.96,0:18:04.73,Main-207+,,0,0,0,,Hasır Şapkalı çocuktaydı!Dialogue: 5,0:18:06.26,0:18:09.80,Main-207+,,0,0,0,,Bu dünyanın rüzgarları batıya veya doğuya doğru değil,Dialogue: 5,0:18:09.80,0:18:13.14,Main-207+,,0,0,0,,benim gittiğim yönde esiyor!Dialogue: 5,0:18:15.14,0:18:16.24,Main-207+,,0,0,0,,Hey, Buggy!Dialogue: 5,0:18:18.14,0:18:21.55,Main-207+,,0,0,0,,Sana Dünya Hükümeti'nden bir mektup var!Dialogue: 5,0:18:21.55,0:18:23.41,Main-207+,,0,0,0,,Ha?! Burada olduğumu nasıl bildiler?!Dialogue: 5,0:18:25.22,0:18:26.48,Main-207+,,0,0,0,,Bu...Dialogue: 5,0:18:28.39,0:18:30.22,Main-207+,,0,0,0,,Bu dudak uçuklatacak bir haber!Dialogue: 5,0:18:30.22,0:18:32.42,Main-207+,,0,0,0,,Benden önce okumasana lan!Dialogue: 5,0:18:34.59,0:18:38.23,Main-207+,,0,0,0,,Valla bu adam her seferinde bir şekilde tartışmalarımızın konusu oluyor.Dialogue: 5,0:18:38.23,0:18:39.77,Main-207+,,0,0,0,,Hasır Şapka Luffy'nin...Dialogue: 5,0:18:39.89,0:18:43.23,Main-207+,,0,0,0,,...Garp'ın torunu olduğunu öğrendiğimizde  her şey yerli yerine oturmuş gibiydi. Ama şimdi...Dialogue: 5,0:18:43.23,0:18:47.21,Main-207+,,0,0,0,,Rayleigh ile olan bağlantısı nedir?Dialogue: 5,0:18:47.24,0:18:50.48,Main-207+,,0,0,0,,Bu kadar zaman sonra sahneye çıkıp dikkatleri üzerine almak istemesi şüpheli.Dialogue: 5,0:18:51.14,0:18:53.85,Main-207+,,0,0,0,,Jinbe de sonunda bize karşı çıktı.Dialogue: 5,0:18:53.85,0:18:59.08,Main-207+,,0,0,0,,Shichibukai pozisyonu  türü ile olan barışımızı temsil ediyordu.Dialogue: 5,0:18:59.08,0:19:00.62,Main-207+,,0,0,0,,Ne yazık.Dialogue: 5,0:19:00.62,0:19:04.86,Main-207+,,0,0,0,,Dünyayı dengeleyen üç taraf arasındaki denge bozuldu.Dialogue: 5,0:19:04.86,0:19:08.49,Main-207+,,0,0,0,,Shichibukai içinde boşalan üç yeri nasıl doldurmalıyız?Dialogue: 5,0:19:08.49,0:19:11.96,Main-207+,,0,0,0,,Sabırlı olmalı Yeni Dünya'daki gelişmeleri takip etmeliyiz.Dialogue: 5,0:19:11.96,0:19:15.67,Main-207+,,0,0,0,,Yüksek ihtimalle korsanlar arasındaki güç dengeleri de değişecektir.Dialogue: 5,0:19:15.67,0:19:19.14,Main-207+,,0,0,0,,En güçlü olanları odak noktamız haline getirmeliyiz.Dialogue: 5,0:19:19.14,0:19:23.44,Main-207+,,0,0,0,,Karasakal Yeni Dünya'da hamlesini yaptı.Dialogue: 5,0:19:23.44,0:19:29.00,Main-207+,,0,0,0,,Ödülü yüz milyonu aşkın bir çaylağı halletti.Dialogue: 5,0:19:29.00,0:19:33.82,Main-207+,,0,0,0,,Sonuçta Beyazsakal'ın bölgesine aşina.Dialogue: 5,0:19:35.19,0:19:40.66,Main-207+,,0,0,0,,Yonko arasına girmek için bir avantajı var diyebiliriz.Dialogue: 5,0:19:40.93,0:19:47.20,Main-207+,,0,0,0,,İnsanlık tarihinde hiç kimse iki Şeytan Meyvesi yememişti.Dialogue: 5,0:19:47.20,0:19:52.34,Main-207+,,0,0,0,,Onu baskılaması için en büyük umudumuz Yonko,Dialogue: 5,0:19:53.04,0:19:57.48,Main-207+,,0,0,0,,veya Anka Kuşu Marco Beyazsakal'ın tayfasından kalanlar diyebiliriz.Dialogue: 5,0:19:58.88,0:20:01.75,Main-207+,,0,0,0,,D'ler her zaman baş belası oldu.Dialogue: 5,0:20:01.75,0:20:03.92,Main-207+,,0,0,0,,Portgas da onlardan biriydi.Dialogue: 5,0:20:03.92,0:20:09.05,Main-207+,,0,0,0,,Bugünlerde o isim karşımıza çok sık çıkıyor.Dialogue: 5,0:20:12.62,0:20:17.96,Main-207+,,0,0,0,,Onu kararından vazgeçirmeye çalıştım ama Garp yine de istifa etti.Dialogue: 5,0:20:18.80,0:20:23.56,Main-207+,,0,0,0,,Ancak genç erleri eğitmek için,Dialogue: 5,0:20:23.56,0:20:27.49,Main-207+,,0,0,0,,ünvanını ve Donanma'daki yerini koruyor.Dialogue: 5,0:20:27.49,0:20:33.24,Main-207+,,0,0,0,,Eğer Filo Amirali görevinden istifa edeceksen en azından sen de onun gibi yap.Dialogue: 5,0:20:33.24,0:20:35.01,Main-207+,,0,0,0,,Sengoku.Dialogue: 5,0:20:35.01,0:20:35.90,Main-207+,,0,0,0,,Pekala.Dialogue: 5,0:20:36.61,0:20:39.05,Main-207+,,0,0,0,,Kabul ediyorum.Dialogue: 5,0:20:39.05,0:20:41.92,Main-207+,,0,0,0,,Emekliliğimi öyle geçirmek güzel olabilir.Dialogue: 5,0:20:45.02,0:20:52.23,Main-207+,,0,0,0,,Donanma'ya Roger'ın zamanından beri ön saflardan önderlik eden iki büyük figür sahadan çekiliyor.Dialogue: 5,0:20:52.23,0:20:54.60,Main-207+,,0,0,0,,Bu oldukça önemli bir olay.Dialogue: 5,0:20:54.60,0:20:59.87,Main-207+,,0,0,0,,Impel Down'ın 6. Kat'ından kaçanları da göze aldığımızda,Dialogue: 5,0:20:59.87,0:21:03.78,Main-207+,,0,0,0,,hala dışarıda serbest gezen birçok azılı korsan var.Dialogue: 5,0:21:05.11,0:21:08.68,Main-207+,,0,0,0,,Newgate en büyükleriydi.Dialogue: 5,0:21:10.62,0:21:14.19,Main-207+,,0,0,0,,Şimdi Korsan Çağı yeni bir döneme giriyor.Dialogue: 5,0:21:14.19,0:21:18.12,Main-207+,,0,0,0,,Donanma'ya bizim gibi eski topraklar öncülük etmemeli.Dialogue: 5,0:21:18.12,0:21:21.89,Main-207+,,0,0,0,,Adalet nesilleri aşamayan değerlerde yatar.Dialogue: 5,0:21:24.06,0:21:26.13,Main-207+,,0,0,0,,Senden bunu duymak ne acı.Dialogue: 5,0:21:26.13,0:21:28.13,Main-207+,,0,0,0,,Her neyse, Kong-san.Dialogue: 5,0:21:28.13,0:21:31.27,Main-207+,,0,0,0,,Bir sonraki Filo Amirali konusu...Dialogue: 5,0:21:31.27,0:21:34.31,Main-207+,,0,0,0,,Bu pozisyon için Aokiji'yi öneriyorum.Dialogue: 5,0:21:35.87,0:21:37.81,Main-207+,,0,0,0,,Demek hayatta kaldı.Dialogue: 5,0:21:37.81,0:21:39.48,Main-207+,,0,0,0,,Oldukça etkileyici.Dialogue: 5,0:21:40.38,0:21:44.32,Main-207+,,0,0,0,,Duydun mu?  Hasır Şapka yine olay çıkarmış.Dialogue: 5,0:21:44.32,0:21:45.28,Main-207+,,0,0,0,,Duydum.Dialogue: 5,0:21:45.28,0:21:50.99,Main-207+,,0,0,0,,Savaş daha yeni bitti,  çanı şimdi mi 16 kez çalıyor?Dialogue: 5,0:21:50.99,0:21:53.32,Main-207+,,0,0,0,,Bu bir mesaj olabilir mi?Dialogue: 5,0:21:54.96,0:21:56.83,Main-207+,,0,0,0,,Kim bilir?Dialogue: 5,0:21:56.83,0:21:59.50,Main-207+,,0,0,0,,Her neyse, transferim konusu ne oldu?Dialogue: 5,0:22:00.03,0:22:03.84,Main-207+,,0,0,0,,Sengoku-san ile görüşeceğim.Dialogue: 5,0:22:03.84,0:22:05.90,Main-207+,,0,0,0,,Kararından emin misin?Dialogue: 5,0:22:05.90,0:22:09.17,Main-207+,,0,0,0,,Böyle bir konuda şaka yapmam.Dialogue: 5,0:22:09.17,0:22:15.51,Main-207+,,0,0,0,,Evet doğru, ama G-5 insanların gönüllü olarak gittiği bir yer değil.Dialogue: 5,0:22:15.51,0:22:18.28,Main-207+,,0,0,0,,Oranın kendi problemleri var.Dialogue: 5,0:22:19.65,0:22:23.25,Main-207+,,0,0,0,,Donanma'nın Grand Line biriminin 5. Bölüğü.Dialogue: 5,0:22:23.86,0:22:26.72,Main-207+,,0,0,0,,Özetle Yeni Dünya'ya mı gitmek istiyorsun?Dialogue: 5,0:22:26.72,0:22:30.76,Main-207+,,0,0,0,,Hedeflerimi kendime yakın tutmak isterim.Dialogue: 5,0:22:32.61,0:22:35.73,Main-207+,,0,0,5,,Haki olarak bilinen güç...Dialogue: 5,0:22:35.73,0:22:38.34,Main-207+,,0,0,0,,Şüphe yok ki bu da onun formlarından biri.Dialogue: 5,0:22:39.64,0:22:43.44,Main-207+,,0,0,0,,Savaşta geçirilen bir travma sonrası uyanmış olmalı.Dialogue: 5,0:22:43.44,0:22:48.28,Main-207+,,0,0,0,,Normal şartlar altında yıllar süren ağır antrenmanlar sonucu ortaya çıkar.Dialogue: 5,0:22:48.28,0:22:51.55,Main-207+,,0,0,0,,Haki... Bunun sebebi o mu?!Dialogue: 5,0:22:51.55,0:22:55.95,Main-207+,,0,0,0,,Koramiral ve üstü olan her Donanma üyesi Haki kullanabilir.Dialogue: 5,0:22:55.95,0:22:56.79,Main-207+,,0,0,0,,Gerçekten mi?Dialogue: 5,0:22:56.79,0:22:59.82,Main-207+,,0,0,0,,İnsanların varlığını çok yoğun bir biçimde hissedebiliyorum.Dialogue: 5,0:22:59.82,0:23:01.16,Main-207+,,0,0,0,,Bu çok yoğun!Dialogue: 5,0:23:01.66,0:23:04.10,Main-207+,,0,0,0,,Sizler Garp'ın öğrencilerisiniz değil mi?Dialogue: 5,0:23:04.40,0:23:06.13,Main-207+,,0,0,0,,Söyleyin size nasıl kullanılır öğretsin.Dialogue: 5,0:23:06.13,0:23:07.90,Main-207+,,0,0,0,,Hey, doktor!Dialogue: 5,0:23:07.90,0:23:10.00,Main-207+,,0,0,0,,Ben de öğrenebilecek miyim?Dialogue: 5,0:23:10.00,0:23:11.44,Main-207+,,0,0,0,,Ben nereden bileyim?Dialogue: 5,0:23:13.20,0:23:18.51,Main-207+,,0,0,0,,Lanet olsun! Benden bir adım öndesin gibi hissediyorum!Dialogue: 5,0:23:18.51,0:23:21.31,Main-207+,,0,0,0,,Nasıl oldu ben de bilmiyorum.Dialogue: 5,0:23:22.75,0:23:24.62,Main-207+,,0,0,5,,Bu akıl almaz bir şey!Dialogue: 5,0:23:25.22,0:23:30.12,Main-207+,,0,0,0,,Savaşta öğrendik ki ölen Portgas D. Ace'in  üvey kardeşiymiş.Dialogue: 5,0:23:30.12,0:23:32.59,Main-207+,,0,0,0,,Devrimci Dragon'un oğlu,Dialogue: 5,0:23:32.59,0:23:38.26,Main-207+,,0,0,0,,ve son olarak da Koramiral Garp'ın torunu!Dialogue: 5,0:23:38.26,0:23:41.07,Main-207+,,0,0,0,,Korsan Monkey D. Luffy!Dialogue: 5,0:23:41.73,0:23:45.00,Main-207+,,0,0,0,,Savaştan sonra nerede olduğu bilinmiyordu...Dialogue: 5,0:23:45.00,0:23:48.04,Main-207+,,0,0,0,,ancak hayatta olduğu ortaya çıktı!Dialogue: 5,0:23:48.97,0:23:51.61,Main-207+,,0,0,0,,Burada Donanma Karargâhı'nde ortaya çıktı!Dialogue: 0,0:23:53.08,0:23:54.81,Main-207+,,0,0,0,,Batırın o savaş gemisini!Dialogue: 5,0:24:03.32,0:24:06.12,Main-207+,,0,0,0,,İmkanı yok... Bu yaşayan efsane,Dialogue: 5,0:24:06.72,0:24:09.13,Main-207+,,0,0,0,,Roger Korsanları'nın ikinci kaptanı,Dialogue: 5,0:24:09.13,0:24:11.53,Main-207+,,0,0,0,,Kara Kral, Silvers Rayleigh mi?!Dialogue: 5,0:24:25.94,0:24:28.15,Main-207+,,0,0,0,,Adanın etrafında tam tur atıyorlar.Dialogue: 5,0:24:28.15,0:24:30.88,Main-207+,,0,0,0,,Sanki denizde bir cenaze töreni gibi!Dialogue: 5,0:24:42.63,0:24:45.10,Main-207+,,0,0,0,,Tüm yönlerden tam güçle saldırın!Dialogue: 5,0:25:05.35,0:25:06.92,Main-207+,,0,0,0,,Hadi fırla!Dialogue: 5,0:25:08.09,0:25:08.75,Main-207+,,0,0,0,,Pekala!Dialogue: 5,0:25:10.22,0:25:12.39,Main-207+,,0,0,0,,Hasır Şapka'yı yakalayın!Dialogue: 5,0:25:12.86,0:25:16.26,Main-207+,,0,0,0,,Gomu gomu no Muchi!Dialogue: 5,0:25:12.86,0:25:16.26,Attack,,0,0,0,,Lastik Lastik KırbaçDialogue: 5,0:25:24.97,0:25:27.51,Main-207+,,0,0,0,,Öküz Çanı ile ne yapacak?!Dialogue: 5,0:26:04.64,0:26:06.31,Main-207+,,0,0,0,,Bundan harika bi poz yakalanır!Dialogue: 5,0:26:28.93,0:26:30.50,Main-207+,,0,0,0,,Peşinden gidin! Kaçmasına izin vermeyin!Dialogue: 5,0:26:30.50,0:26:32.70,Main-207+,,0,0,0,,İşte gidiyor.Dialogue: 5,0:26:33.24,0:26:34.87,Main-207+,,0,0,0,,Bu ne içindi şimdi?Dialogue: 5,0:26:34.87,0:26:38.71,Main-207+,,0,0,0,,Kara Kral Rayleigh ve Shichibukai Jinbe...Dialogue: 5,0:26:38.71,0:26:40.38,Main-207+,,0,0,0,,İkisi de Hasır Şapka ile birlikte mi?Dialogue: 5,0:26:40.38,0:26:43.61,Main-207+,,0,0,0,,Rayleigh, Korsanlar Kralı'nın tayfasındaydı.Dialogue: 5,0:26:43.61,0:26:46.12,Main-207+,,0,0,0,,Yoksa Hasır Şapka, Roger'ın halefi mi?Dialogue: 5,0:26:46.12,0:26:50.62,Main-207+,,0,0,0,,Hey, hey! Hasır Şapka Dragon'un oğlu!  Bu gerçek olamaz.Dialogue: 5,0:26:51.39,0:26:52.86,Main-207+,,0,0,0,,Her ne olursa olsun, bu...Dialogue: 5,0:26:53.49,0:26:55.06,Main-207+,,0,0,0,,büyük haber!Dialogue: 5,0:27:14.38,0:27:17.52,Main-207+,,0,0,0,,Dünyanın dört bir yanındaki insanlar bu haberi gördü!Dialogue: 5,0:27:17.52,0:27:22.19,Main-207+,,0,0,0,,Hepsi Hasır Şapka'yı nasıl elimizden kaçırdığımızı konuşuyor!Dialogue: 5,0:27:22.19,0:27:23.59,Main-207+,,0,0,0,,Bu büyük rezillik!Dialogue: 5,0:27:23.59,0:27:26.66,Main-207+,,0,0,0,,Hasır Şapka'nın yaptıklarına bakacak olursak,Dialogue: 5,0:27:26.66,0:27:32.66,Main-207+,,0,0,0,,Beyazsakal'a, kardeşine ve savaşta hayatını kaybedenlere bir saygı duruşu gibiydi.Dialogue: 5,0:27:32.66,0:27:35.73,Main-207+,,0,0,0,,Ada çevresinde tam tur dolaşması ve sessiz duruşu da bunu gösteriyor.Dialogue: 5,0:27:36.07,0:27:40.10,Main-207+,,0,0,0,,Ancak bildiğiniz üzere bu tür durumlarda çan iki kez çalınır.Dialogue: 5,0:27:40.10,0:27:41.91,Main-207+,,0,0,0,,Ancak çanı 16 kez çaldı!Dialogue: 5,0:27:41.91,0:27:46.74,Main-207+,,0,0,0,,Bu bize bir meydan okumadır!Dialogue: 5,0:27:47.31,0:27:51.08,Narrator-207+,,0,0,0,,Burası Grand Line suları.Dialogue: 5,0:27:52.38,0:27:55.32,Main-207+,,0,0,0,,Kusura bakmayın millet.  Sizi de bu uzun yolculuğa ortak ettim.Dialogue: 5,0:27:55.32,0:27:57.89,Main-207+,,0,0,0,,Önemli değil. Keşiflere çıkmaya alışkınız.Dialogue: 5,0:27:57.89,0:27:59.79,Main-207+,,0,0,0,,Ne yapıyorsunuz öyle?Dialogue: 5,0:27:59.79,0:28:02.39,Main-207+,,0,0,0,,İyi olduğundan emin olmak için sana göz kulak oluyoruz.Dialogue: 5,0:28:02.39,0:28:04.66,Main-207+,,0,0,0,,Yılan Prenses'in emirleri.Dialogue: 5,0:28:04.66,0:28:09.00,Main-207+,,0,0,0,,Yılan Prenses çok heyecanlandı o yüzden bayıldı.Dialogue: 5,0:28:10.23,0:28:13.27,Main-207+,,0,0,0,,Bu nedenle seni yakından takip ediyoruz.Dialogue: 5,0:28:15.77,0:28:19.61,Main-207+,,0,0,0,,Acaba mesajımı anlayacaklar mı?Dialogue: 5,0:28:20.61,0:28:23.05,Main-207+,,0,0,0,,Haberi okurlarsa anlayacaklardır.Dialogue: 5,0:28:23.05,0:28:26.22,Main-207+,,0,0,0,,Buradaki gizli ipucu senin normalde böyle bir şey yapmayacak olman.Dialogue: 5,0:28:26.22,0:28:27.45,Main-207+,,0,0,0,,Hey, şunu yapmasanıza?Dialogue: 5,0:28:27.45,0:28:31.16,Main-207+,,0,0,0,,Çok sıkı duran bir adam vardı.Dialogue: 5,0:28:31.19,0:28:33.39,Main-207+,,0,0,0,,Eminim bir yolunu bulacaktır.Dialogue: 5,0:28:34.02,0:28:36.63,Main-207+,,0,0,0,,Hepsi mesajı alacaktır.Dialogue: 5,0:28:36.63,0:28:38.53,Main-207+,,0,0,0,,Buna inanıyorum.Dialogue: 5,0:28:39.53,0:28:41.73,Narrator-207+,,0,0,0,,Grand Line üzerindeki gökyüzü.Dialogue: 5,0:28:47.07,0:28:50.17,Main-207+,,0,0,0,,Öyle mi? Anladım, Luffy!Dialogue: 5,0:28:51.31,0:28:55.21,Main-207+,,0,0,0,,Anlıyorum! Gerçekten mi? Demek öyle ha?Dialogue: 5,0:28:55.95,0:28:59.62,Narrator-207+,,0,0,0,,Doğu Mavi, devasa köprünün üstü.Dialogue: 5,0:29:05.16,0:29:07.29,Main-207+,,0,0,0,,Anlıyorum, demek öyle.Dialogue: 5,0:29:07.29,0:29:10.63,Main-207+,,0,0,0,,Ne oldu, Robin-san ?Dialogue: 5,0:29:13.10,0:29:15.93,Main-207+,,0,0,0,,Başüstüne, Luffy.Dialogue: 5,0:29:19.40,0:29:21.87,Narrator-207+,,0,0,0,,Kamabakka Drag Kraliçeliği.Dialogue: 5,0:29:29.05,0:29:32.12,Main-207+,,0,0,0,,Öyle diyorsun ha, Luffy?Dialogue: 5,0:29:32.12,0:29:33.42,Main-207+,,0,0,0,,Ne oldu?Dialogue: 5,0:29:37.52,0:29:40.42,Main-207+,,0,0,0,,Shikkearu Krallığı harabeleri.Dialogue: 5,0:29:41.13,0:29:42.89,Main-207+,,0,0,0,,Hey, okuyabildin mi?Dialogue: 5,0:29:42.89,0:29:44.36,Main-207+,,0,0,0,,Kollarım yoruluyor.Dialogue: 5,0:29:44.90,0:29:46.73,Main-207+,,0,0,0,,Biraz daha bekle!Dialogue: 5,0:29:46.73,0:29:48.33,Main-207+,,0,0,0,,Burada bir mesaj olmalı.Dialogue: 5,0:29:48.33,0:29:51.64,Main-207+,,0,0,0,,Luffy normalde böyle bir şey yapmaz!Dialogue: 5,0:29:51.64,0:29:55.07,Main-207+,,0,0,0,,Rayleigh'nin onunla birlikte olması bunun onun fikri olduğunu gösteriyor!Dialogue: 5,0:29:55.07,0:29:56.97,Main-207+,,0,0,0,,Burada kesin gizli bir şey var!Dialogue: 5,0:29:57.91,0:30:01.18,Narrator-207+,,0,0,0,,Bulgemore Gelecek Krallığı.Dialogue: 5,0:30:05.05,0:30:07.08,Main-207+,,0,0,0,,Peki öyle olsun.Dialogue: 5,0:30:07.08,0:30:10.45,Main-207+,,0,0,0,,Dostum, pestilim çıktı!Dialogue: 5,0:30:11.36,0:30:12.82,Main-207+,,0,0,0,,Amca!Dialogue: 5,0:30:28.61,0:30:29.71,Main-207+,,0,0,0,,Anlıyorum!Dialogue: 0,0:30:34.88,0:30:36.58,Narrator-207+,,0,0,0,,Bowin TakımadalarıDialogue: 5,0:30:36.58,0:30:39.36,Main-207+,,0,0,0,,Ne oldu, Usopp-un?Dialogue: 5,0:30:39.36,0:30:41.05,Main-207+,,0,0,0,,Anlaşıldı, Luffy!Dialogue: 5,0:30:44.66,0:30:47.49,Narrator-207+,,0,0,0,,Weatheria Gökyüzü Adası.Dialogue: 5,0:30:49.86,0:30:51.90,Main-207+,,0,0,0,,Anladım.Dialogue: 5,0:30:51.90,0:30:56.77,Main-207+,,0,0,0,,Cidden ya, buna duygularımızı hesaba katmadan kendi başına karar verdi!Dialogue: 5,0:30:56.77,0:30:59.80,Main-207+,,0,0,0,,Kızım yakalanacaksın!Dialogue: 5,0:31:01.21,0:31:03.41,Main-207+,,0,0,0,,Teena Gaina Krallığı.Dialogue: 5,0:31:01.21,0:31:03.41,Captions,,0,0,0,,"Te, nagai na": "Kolların gerçekten uzun."Dialogue: 5,0:31:13.58,0:31:17.12,Main-207+,,0,0,0,,Gösteri zamanı geldi.  Canlı gözükmeye çalış.Dialogue: 5,0:31:17.12,0:31:18.29,Main-207+,,0,0,0,,Al bakalım.Dialogue: 5,0:31:20.46,0:31:21.69,Main-207+,,0,0,0,,Luffy-san !Dialogue: 5,0:31:21.69,0:31:23.09,Main-207+,,0,0,0,,Sabrınız için teşekkürler!Dialogue: 5,0:31:23.09,0:31:27.60,Main-207+,,0,0,0,,Burada dünyanın en nadir türlerinden biri bizimle birlikte, hareket eden bir iskelet!Dialogue: 5,0:31:34.30,0:31:36.94,Main-207+,,0,0,0,,Oh, demek öyle?Dialogue: 5,0:31:38.84,0:31:41.61,Main-207+,,0,0,0,,Anladım, Luffy-san.Dialogue: 5,0:31:46.08,0:31:50.45,Narrator-207+,,0,0,0,,Hasır Şapka'nın çıkardığı olay dünyanın her yerinde konuşuluyordu.Dialogue: 5,0:31:51.42,0:31:54.66,Narrator-207+,,0,0,0,,Yeni Dünya'da bile.Dialogue: 5,0:31:54.66,0:31:58.13,Main-207+,,0,0,0,,Demek hala hayatta ha? Hasır Şapka Luffy!Dialogue: 5,0:31:58.96,0:32:02.70,Main-207+,,0,0,0,,Marineford'da 16 kez çalınan çan,  yeni bir dönemin habercisi.Dialogue: 5,0:32:03.73,0:32:05.14,Main-207+,,0,0,0,,Öküz Çanı ne ki?Dialogue: 5,0:32:07.07,0:32:08.87,Main-207+,,0,0,0,,Öküz Çanı...Dialogue: 5,0:32:09.87,0:32:13.50,Main-207+,,0,0,0,,Öküz Lloyds isimli bir savaş gemisi tarafından taşınan kutsal bir çandır.Dialogue: 5,0:32:13.52,0:32:15.78,Main-207+,,0,0,0,,Gemi çok eskiden Donanma'ya hizmet etmişti.Dialogue: 5,0:32:16.75,0:32:21.59,Main-207+,,0,0,0,,Her senenin sonunda biten yıla şükranları sunmak için 8 kez çalınır.Dialogue: 5,0:32:21.59,0:32:24.25,Main-207+,,0,0,0,,Ve yeni yıl için şans getirmesi için bir 8 kez daha.Dialogue: 5,0:32:25.02,0:32:29.09,Main-207+,,0,0,0,,Yani çanı 16 kez çalmak bir Donanma geleneğidir.Dialogue: 5,0:32:29.09,0:32:31.26,Main-207+,,0,0,0,,Çanı 16 kez çalmanın manası bu.Dialogue: 5,0:32:33.23,0:32:35.57,Main-207+,,0,0,0,,Ancak bunun zamanlaması garipti.Dialogue: 5,0:32:35.57,0:32:40.04,Main-207+,,0,0,0,,Yani aslında çanı bir çağın kapanıp yeni bir çağın başladığını duyurmak istedi.Dialogue: 5,0:32:40.04,0:32:46.84,Main-207+,,0,0,0,,Yani "Beyazsakal'ın devri bitti,  benim devrim başlıyor diyor" ha?Dialogue: 5,0:32:46.84,0:32:49.11,Main-207+,,0,0,0,,Böyle bir amacı olmasa,Dialogue: 5,0:32:49.11,0:32:54.75,Main-207+,,0,0,0,,abisini kaybetmenin acısını tekrar yaşayacağı yere neden dönsün ki?Dialogue: 5,0:32:56.45,0:32:58.79,Main-207+,,0,0,0,,Bu çocuk sinirlerimi bozuyor!Dialogue: 5,0:32:58.79,0:33:06.26,Main-207+,,0,0,0,,Evet, savaşta yer alması onu biz ve diğer çaylaklardan farklı kıldı,Dialogue: 5,0:33:06.26,0:33:11.27,Main-207+,,0,0,0,,ama ben onun bu avantajı elinde tutmasına müsade edecek iradesi zayıf biri değilim!Dialogue: 5,0:33:13.97,0:33:18.98,Main-207+,,0,0,0,,Bu Yeni Dünya'dan daha fazlasını bekliyordum.Dialogue: 5,0:33:18.98,0:33:21.38,Main-207+,,0,0,0,,Bu omurgasız çöpler de neyin nesi?!Dialogue: 5,0:33:21.38,0:33:23.15,Main-207+,,0,0,0,,Lütfen merhamet et!Dialogue: 5,0:33:23.15,0:33:25.95,Main-207+,,0,0,0,,Buradaki kimse sana zarar verecek bir şey yapmadı!Dialogue: 5,0:33:25.95,0:33:29.12,Main-207+,,0,0,0,,Sadece bu denizleri terkediyorduk!Dialogue: 5,0:33:29.12,0:33:31.32,Main-207+,,0,0,0,,Lütfen yaşamamıza ve Cennet'e dönmemize izin ver!Dialogue: 5,0:33:31.89,0:33:35.43,Main-207+,,0,0,0,,Cennet mi? Sıcak evlerinizi mi kastediyorsun?Dialogue: 5,0:33:35.76,0:33:41.13,Main-207+,,0,0,0,,Bu denize daha yeni geldiniz,  ne kadar korkutucu en ufak bir fikriniz yok!Dialogue: 5,0:33:48.71,0:33:49.94,Main-207+,,0,0,0,,Hasır Şapka?Dialogue: 5,0:33:49.94,0:33:52.54,Main-207+,,0,0,0,,Evet, görünüşe göre bir başka kargaşaya sebep olmuş.Dialogue: 5,0:33:52.54,0:33:55.01,Main-207+,,0,0,5,,Panik yapmaya gerek yok.Dialogue: 5,0:33:55.01,0:33:58.75,Main-207+,,0,0,5,,Son doğru hamleyi yapan kazanan olur.Dialogue: 5,0:34:00.08,0:34:01.08,Main-207+,,0,0,0,,O ne?!Dialogue: 5,0:34:01.08,0:34:03.39,Main-207+,,0,0,0,,Baba! Gemi...Dialogue: 5,0:34:03.39,0:34:06.26,Main-207+,,0,0,0,,Denizden gökyüzüne doğru yükseliyor!Dialogue: 5,0:34:06.26,0:34:08.03,Main-207+,,0,0,0,,Ne?!Dialogue: 5,0:34:08.03,0:34:11.26,Main-207+,,0,0,0,,Neler oluyor? Nedir bu?!Dialogue: 5,0:34:11.26,0:34:12.76,Main-207+,,0,0,0,,Rotamıza geri dönün!Dialogue: 5,0:34:12.76,0:34:15.20,Main-207+,,0,0,0,,Baba! Gökyüzünden bir şey iniyor!Dialogue: 5,0:34:18.70,0:34:22.07,Main-207+,,0,0,0,,Hayır bekleyin! Biz ona doğru çekiliyoruz!Dialogue: 5,0:34:27.91,0:34:29.81,Main-207+,,0,0,5,,Gerçekten çok özür dilerim.Dialogue: 5,0:34:31.92,0:34:34.28,Main-207+,,0,0,5,,Tekrarlar mısınız?Dialogue: 5,0:34:34.28,0:34:36.49,Main-207+,,0,0,5,,Sizi tam olarak duyamadım.Dialogue: 5,0:34:36.49,0:34:38.29,Main-207+,,0,0,0,,Ben Kahverengisakal!Dialogue: 5,0:34:38.29,0:34:42.93,Main-207+,,0,0,0,,80 milyonun üzerinde ödülü olan,  Kahverengisakal-sama !Dialogue: 5,0:34:43.59,0:34:47.66,Main-207+,,0,0,0,,Benim adımı aklına kazısan iyi olur.  Buralar benim mekanım!Dialogue: 5,0:34:47.66,0:34:50.93,Main-207+,,0,0,0,,Benim sevimli astlarıma korkunç bir şey yaptın.Dialogue: 5,0:34:50.93,0:34:53.20,Main-207+,,0,0,0,,Senin derini yüzeceğim!Dialogue: 5,0:34:53.20,0:34:58.48,Main-207+,,0,0,0,,Demek öyle? O kadar salakça bir ismin var ki yanlış duydum sandım.Dialogue: 5,0:34:58.91,0:35:03.18,Main-207+,,0,0,0,,İki şeyi netleştirelim.  Bir, şakalardan nefret ederim.Dialogue: 5,0:35:03.18,0:35:04.35,Main-207+,,0,0,0,,Şaka mı?!Dialogue: 5,0:35:04.72,0:35:06.68,Main-207+,,0,0,0,,İki...Dialogue: 5,0:35:08.42,0:35:12.39,Main-207+,,0,0,0,,Ölümün gölgesi bugün üzerinde dolaşıyor.Dialogue: 5,0:35:20.56,0:35:25.14,Main-207+,,0,0,0,,O Seyir Pusulası gerçekten o adayı mı gösteriyor?Dialogue: 5,0:35:25.14,0:35:28.98,Main-207+,,0,0,5,,Yıldırımlar birbiri ardına iniyor!Dialogue: 5,0:35:28.98,0:35:30.97,Main-207+,,0,0,5,,Bu saçmalık!Dialogue: 5,0:35:36.68,0:35:39.32,Main-207+,,0,0,0,,Bu adaya nasıl ayak basacağız?!Dialogue: 5,0:35:40.72,0:35:44.92,Narrator-207+,,0,0,0,,Yeni Dünya'ya ilk kez ayak basan cesur insanlar...Dialogue: 5,0:35:45.96,0:35:48.39,Main-207+,,0,0,0,,Peder! Biri bize doğru geliyor!Dialogue: 5,0:35:49.53,0:35:50.53,Main-207+,,0,0,0,,O da kim?Dialogue: 5,0:35:50.53,0:35:55.47,Narrator-207+,,0,0,0,,Grand Line'ın ilk yarısı ile ilgili aynı şeyi söylüyor...Dialogue: 5,0:35:55.47,0:35:57.93,Main-207+,,0,0,0,,Bakın hele delikanlılar.Dialogue: 5,0:35:58.44,0:36:01.14,Main-207+,,0,0,0,,Bu yaşlı nine de kim?Dialogue: 5,0:36:01.14,0:36:05.24,Narrator-207+,,0,0,0,,"O deniz cennetmiş!"Dialogue: 5,0:36:07.18,0:36:10.18,Main-207+,,0,0,0,,Şemsiye lazım mı?Dialogue: 5,0:36:10.88,0:36:14.82,Main-207+,,0,0,0,,Kaç tane canımız olursa olsun,  bu denizde kalırsak hepsini vereceğiz!Dialogue: 5,0:36:14.82,0:36:19.06,Main-207+,,0,0,0,,Cennet'e geri dönmek istiyoruz! Lütfen!Dialogue: 5,0:36:19.92,0:36:22.06,Main-207+,,0,0,0,,Midemi bulandırıyorsunuz.Dialogue: 5,0:36:23.73,0:36:28.83,Main-207+,,0,0,0,,Hayatını riske atacak iradesi olmayan kimsenin...Dialogue: 5,0:36:28.83,0:36:33.57,Main-207+,,0,0,0,,bu denizde yeri yok!Dialogue: 5,0:36:38.48,0:36:41.65,Main-207+,,0,0,0,,En kısa zamanda liderliği ele alacağım!Dialogue: 5,0:36:41.65,0:36:46.48,Main-207+,,0,0,0,,Arkana yaslan ve izle, Hasır Şapka!Dialogue: 1,0:02:44.74,0:02:49.72,Captions,,0,0,0,,Doğu Mavi: Devasa köprünün üstüDialogue: 1,0:05:22.90,0:05:26.61,Captions,,0,0,0,,Grand Line Momoiro Adası, Kamabakka KrallığıDialogue: 1,0:08:47.54,0:08:54.25,Captions,,0,0,0,,Grand Line Beyaz Toprak Adası, BaltigoDialogue: 1,0:09:12.73,0:09:22.11,Captions,,0,0,0,,Beyaz Den Den Mushi (dinlenmeyi önleyen sinyal yayar)Dialogue: 1,0:20:12.99,0:20:17.96,Captions,,0,0,0,,Kutsal Topraklar Mariejois, Red LineDialogue: 1,0:20:18.76,0:20:29.54,Captions,,0,0,0,,Dünya Hükümeti Genelkurmay Başkanı KongDialogue: 1,0:22:31.06,0:22:35.73,Captions,,0,0,0,,Donanma Karargâhı - Revir BölümüDialog