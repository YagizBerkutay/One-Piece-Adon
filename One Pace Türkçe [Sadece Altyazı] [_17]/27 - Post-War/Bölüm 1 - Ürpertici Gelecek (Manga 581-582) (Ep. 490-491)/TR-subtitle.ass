Dialogue: 0,0:02:45.16,0:02:52.83,Title,,0,0,250,,{\fad(1000,1000)}Ürpertici Gelecek
Dialogue: 0,0:02:48.26,0:02:52.82,Main,,0,0,0,,– Beyazsakal Korsanları kayıp mı etti?\N– Donanma gerçekten kazandı mı?
Dialogue: 0,0:02:53.53,0:02:56.02,Main,,0,0,0,,Marineford'da gerçekleşen...
Dialogue: 0,0:02:56.02,0:02:59.43,Main,,0,0,0,,Beyazsakal Korsanları ve Donanma Genel Merkezi arasındaki savaş...
Dialogue: 0,0:02:59.43,0:03:04.69,Main,,0,0,0,,düşmanın kararlılığı yüzünden tahmin edilenden daha uzun sürmüştür.
Dialogue: 0,0:03:04.69,0:03:08.33,Main,,0,0,0,,Buna rağmen adalet uğruna savaşan Donanma ordusu...
Dialogue: 0,0:03:08.33,0:03:13.46,Main,,0,0,0,,Beyazsakal Korsanları ve müttefiklerine üstün gelmiştir.
Dialogue: 0,0:03:13.46,0:03:18.90,Main,,0,0,0,,Bildirmekten kıvanç duyarız ki Donanma mutlak galibiyet elde etmiştir.
Dialogue: 0,0:03:20.95,0:03:22.38,Main,,0,0,0,,Başardılar!
Dialogue: 0,0:03:25.65,0:03:30.02,Main,,0,0,0,,Donanma yenilmez!\NTüm kahramanlarımız için!
Dialogue: 0,0:03:35.43,0:03:40.10,Main,,0,0,0,,Donanma Genel Merkezi'ne tayin olmak istiyorum!
Dialogue: 0,0:03:43.94,0:03:46.15,Main,,0,0,0,,Savaş bitti!
Dialogue: 0,0:03:46.15,0:03:47.73,Main,,0,0,0,,Yaşasın!
Dialogue: 0,0:03:47.73,0:03:49.37,Main,,0,0,0,,Şükürler olsun!
Dialogue: 0,0:03:49.37,0:03:53.51,Main,,0,0,0,,Efsanevi korsan Beyazsakal mağlup edildi!
Dialogue: 0,0:03:57.32,0:04:01.85,Main,,0,0,0,,– Savaş bitti değil mi?\N– Evet! Artık güvendeyiz!
Dialogue: 0,0:04:01.85,0:04:04.58,Main,,0,0,0,,– Harika haber bu!\N– Başardılar!
Dialogue: 0,0:04:04.58,0:04:05.99,Main,,0,0,0,,Güvendeyiz!
Dialogue: 0,0:04:05.99,0:04:09.23,Main,,0,0,0,,Yaşasın Donanma!\NYaşasın Dünya Hükümeti!
Dialogue: 0,0:04:09.23,0:04:14.33,Main,,0,0,0,,Zafer için, adalet ve barış için! Yaşasın!
Dialogue: 0,0:04:24.49,0:04:31.08,Narrator,,0,0,0,,Marineford'da, muharebe alanı yakınlarındaki sularda bazı gemiler gizlice dolaşıyor.
Dialogue: 0,0:04:31.65,0:04:34.25,Narrator,,0,0,0,,Bir sonraki devrin bayrağını taşıyacak isimler...{\an8}
Dialogue: 0,0:04:34.25,0:04:38.63,Narrator,,0,0,0,,tarihin bu dönüm noktasına tanıklık ettiler.{\an8}
Dialogue: 0,0:04:39.32,0:04:42.29,Narrator,,0,0,0,,Büyük Korsan Çağı'nda hüküm süren düzenin kanıtı olan,{\an8}
Dialogue: 0,0:04:42.29,0:04:45.87,Narrator,,0,0,0,,Marineford üzerine çöken tozu görüyorlar...{\an8}
Dialogue: 0,0:04:45.87,0:04:50.24,Narrator,,0,0,0,,ve değişen dengelerin farkındalar.{\an8}
Dialogue: 0,0:04:50.57,0:04:51.90,Main,,0,0,0,,Kaptan Drake.
Dialogue: 0,0:04:52.40,0:04:55.34,Main,,0,0,0,,Sonunda bitti.
Dialogue: 0,0:04:55.34,0:04:59.17,Main,,0,0,0,,Donanma da değişmek zorunda.
Dialogue: 0,0:04:59.61,0:05:01.75,Main,,0,0,0,,Tez zamanda...
Dialogue: 0,0:05:01.75,0:05:07.69,Main,,0,0,0,,Beyazsakal'ın bölgelerinde kan gövdeyi götürecek.
Dialogue: 0,0:05:09.06,0:05:10.98,Main,,0,0,0,,Karasakal anahtar isim.
Dialogue: 0,0:05:10.98,0:05:15.53,Main,,0,0,0,,Yeni müttefikleri var ve Beyazsakal'ın gücü onda.
Dialogue: 0,0:05:15.53,0:05:19.80,Main,,0,0,0,,Eminim fırtınayı koparan onlar olacak!
Dialogue: 0,0:05:23.66,0:05:27.57,Main,,0,0,0,,Hepsi onun suçu!
Dialogue: 0,0:05:27.57,0:05:30.04,Main,,0,0,0,,Bir an önce onun peşine düşmeliyim!
Dialogue: 0,0:05:30.46,0:05:33.10,Main,,0,0,0,,Hadi gidelim! Yeni Dünya'ya!
Dialogue: 0,0:05:34.88,0:05:37.14,Main,,0,0,0,,Ne oluyor lan böyle?
Dialogue: 0,0:05:37.14,0:05:39.82,Main,,0,0,0,,Neden bahsediyorsun, Apoo-{\i1}san?{\i0}
Dialogue: 0,0:05:39.82,0:05:44.73,Main,,0,0,0,,O eleman dişli bir rakip olacak. Onu gerçekten kurtaracak mı?
Dialogue: 0,0:05:44.73,0:05:45.65,Main,,0,0,0,,Ha?
Dialogue: 0,0:05:45.65,0:05:50.60,Main,,0,0,0,,Trafalgar Law'dan bahsediyorum.\NGaddarlığıyla bilinir.
Dialogue: 0,0:05:51.27,0:05:56.74,Main,,0,0,0,,Hasır Şapka Luffy'i kurtardığına göre bir planı olması lazım.
Dialogue: 0,0:05:59.53,0:06:01.34,Main,,0,0,0,,Garip.
Dialogue: 0,0:06:01.34,0:06:04.62,Main,,0,0,0,,Ne oldu, Kaptan Hawkins?
Dialogue: 0,0:06:04.62,0:06:09.21,Main,,0,0,0,,Hasır Şapka Luffy'nin hayatta kalma olasılığına bakıyordum...
Dialogue: 0,0:06:09.21,0:06:11.73,Main,,0,0,0,,ama hiç sıfıra inmedi.
Dialogue: 0,0:06:14.75,0:06:17.87,Main,,0,0,0,,Dürüst olmak gerekirse savaş başladığında endişeliydim.
Dialogue: 0,0:06:17.87,0:06:20.36,Main,,0,0,0,,Ama şimdi büyük korsan Beyazsakal öldü.
Dialogue: 0,0:06:20.96,0:06:23.51,Main,,0,0,0,,O zaman nihayet bitti değil mi?
Dialogue: 0,0:06:23.51,0:06:25.69,Main,,0,0,0,,Evet.
Dialogue: 0,0:06:31.65,0:06:34.25,Main,,0,0,0,,Ne demek "bitti"?!
Dialogue: 0,0:06:35.05,0:06:43.18,Main,,0,0,0,,Karasakal yaman adam çıktı! Savaşı fırsat bilip büyük bir güce kavuştu!
Dialogue: 0,0:06:44.85,0:06:48.15,Main,,0,0,0,,Yeni Dünya'ya Yonkou hükmeder.
Dialogue: 0,0:06:44.85,0:06:48.15,Note,,0,0,0,,Yonkou: Dört İmparator
Dialogue: 0,0:06:49.25,0:06:53.79,Main,,0,0,0,,Beyazsakal, Kızıl Saç, Kaido, Big Mom.
Dialogue: 0,0:06:53.79,0:06:55.67,Main,,0,0,0,,Ama şimdi biri öldü,
Dialogue: 0,0:06:55.67,0:06:59.73,Main,,0,0,0,,dünyanın tüm dengeleri değişti ve kimse ne olacağını kestiremez artık!
Dialogue: 0,0:06:59.73,0:07:06.18,Main,,0,0,0,,Bu daha önce kimsenin tahmin edemediği yeni bir dönemin başlangıcı!
Dialogue: 0,0:07:16.02,0:07:19.44,Narrator,,0,0,0,,Donanma'nın Marineford galibiyeti haberleri,{\an8}
Dialogue: 0,0:07:19.44,0:07:22.72,Narrator,,0,0,0,,Büyük Korsan Çağı'nın görmüş olduğu en büyük muharebenin haberleri...{\an8}
Dialogue: 0,0:07:23.28,0:07:25.77,Narrator,,0,0,0,,göz açıp kapayıncaya dek tüm dünyaya yayıldı.{\an8}
Dialogue: 0,0:07:25.77,0:07:28.63,Narrator,,0,0,0,,Ve herkes sevinçten bayram etti.{\an8}
Dialogue: 0,0:07:28.63,0:07:31.63,Captions,,0,0,0,,Doğu Mavi{\fad(200,0)}
Dialogue: 0,0:07:28.63,0:07:30.25,Narrator,,0,0,0,,{\an8}East Blue.
Dialogue: 0,0:07:30.25,0:07:31.63,Main,,0,0,0,,{\an8}Yaşasın!
Dialogue: 0,0:07:31.63,0:07:35.63,Main,,0,0,0,,– Beyazsakal ölmüş!\N– Yaşasın!
Dialogue: 0,0:07:35.63,0:07:39.24,Main,,0,0,0,,– Artık güvendeyiz!\N– O kadar mutluyum ki!
Dialogue: 0,0:07:39.24,0:07:41.02,Narrator,,0,0,0,,{\an8}Batı Mavi.
Dialogue: 0,0:07:39.24,0:07:41.91,Captions,,0,0,0,,Batı Mavi{\fad(200,0)}
Dialogue: 0,0:07:41.91,0:07:44.93,Main,,0,0,0,,Denizler artık huzur içinde!
Dialogue: 0,0:07:44.93,0:07:46.61,Main,,0,0,0,,Yaşasın!
Dialogue: 0,0:07:46.61,0:07:49.25,Captions,,0,0,0,,Güney Mavi{\fad(200,0)}
Dialogue: 0,0:07:47.05,0:07:48.09,Narrator,,0,0,0,,{\an8}Güney Mavi.
Dialogue: 0,0:07:48.09,0:07:49.85,Main,,0,0,0,,{\an8}Bugün indirim yapıyoruz
Dialogue: 0,0:07:49.85,0:07:51.64,Main,,0,0,0,,{\an8}Biz de!
Dialogue: 0,0:07:51.64,0:07:55.09,Main,,0,0,0,,{\an8}– Donanma kazanmış!\N– İçim o kadar ferahladı ki!
Dialogue: 0,0:07:55.09,0:07:58.36,Narrator,,0,0,0,,{\an8}Kuzey Mavi.
Dialogue: 0,0:07:55.09,0:07:57.96,Captions,,0,0,0,,{\fad(200,400)}Kuzey Mavi
Dialogue: 0,0:07:58.36,0:08:00.96,Main,,0,0,0,,{\an8}Evet! O kadar mutluyum ki!
Dialogue: 0,0:08:00.96,0:08:04.99,Main,,0,0,0,,– Hadi içelim millet!\N– Tonlarca içkimiz var!
Dialogue: 0,0:08:04.99,0:08:07.90,Captions,,0,0,0,,Grand Line{\fad(200,0)}
Dialogue: 0,0:08:05.12,0:08:06.78,Narrator,,0,0,0,,{\an8}Grand Line.
Dialogue: 0,0:08:06.78,0:08:08.71,Main,,0,0,0,,{\an8}Yarın ne yapsak ki?
Dialogue: 0,0:08:08.71,0:08:10.08,Main,,0,0,0,,Ben ebelemece oynamak istiyorum!
Dialogue: 0,0:08:10.08,0:08:11.58,Main,,0,0,0,,Saklambaç!
Dialogue: 0,0:08:11.58,0:08:13.27,Main,,0,0,0,,Pekala!
Dialogue: 0,0:08:14.50,0:08:18.74,Main,,0,0,0,,Tanrım, sana şükürler olsun! {.}
Dialogue: 0,0:08:19.07,0:08:25.43,Narrator,,0,0,0,,Tarihin büyük bir kısmında olduğu gibi haberler yayıldıkça bazı gerçekler göz ardı ediliyordu...{\an8}
Dialogue: 0,0:08:25.43,0:08:30.14,Narrator,,0,0,0,,ve sadece iki kelime öne çıkıyordu. "Donanma galibiyeti".{\an8}
Dialogue: 0,0:08:30.14,0:08:35.39,Narrator,,0,0,0,,Haberlerin heyecanına kapılan insanlar bir şeyi farketmemişti.{\an8}
Dialogue: 0,0:08:36.63,0:08:38.40,Main,,0,0,0,,N-ne oluyor?!
Dialogue: 0,0:08:41.69,0:08:44.10,Main,,0,0,0,,Baksanıza şunlara! Haliniz çok komik!
Dialogue: 0,0:08:44.10,0:08:49.74,Main,,0,0,0,,Beyazsakal büyük hazine \NOne Piece'in gerçek olduğunu söyledi!
Dialogue: 0,0:08:50.00,0:08:52.88,Main,,0,0,0,,Onu ben bulacağım!
Dialogue: 0,0:08:55.98,0:09:00.97,Main,,0,0,0,,Bir yerlerde buradakinden \Nçok daha fazlası var! Hadi yola çıkalım!
Dialogue: 0,0:09:05.24,0:09:07.26,Narrator,,0,0,0,,{\an8}Donanma'nın galibiyeti{ victory.}...
Dialogue: 0,0:09:07.26,0:09:13.13,Narrator,,0,0,0,,{\an8}artık barış sağlanacak demek değildi.
Dialogue: 0,0:09:07.71,0:09:10.60,Captions,,0,0,0,,Yeni Dünya - Foodvalten {\fad(500,0)}
Dialogue: 0,0:09:17.98,0:09:21.77,Main,,0,0,0,,Y-yaklaşma!\NKasabamızdan uzak dur!
Dialogue: 0,0:09:23.58,0:09:27.56,Narrator,,0,0,0,,Beyazsakal'ın caydırıcı gücü olmayınca...{\an8}
Dialogue: 0,0:09:27.56,0:09:32.33,Narrator,,0,0,0,,denizler daha istikrarsız hale gelmişti.{\an8}
Dialogue: 0,0:09:35.36,0:09:40.46,Main,,0,0,0,,Endişelenmeyin. Tüm Donanma askerlerini taşa çevirdim.
Dialogue: 0,0:09:40.46,0:09:43.60,Main,,0,0,0,,Luffy'nin durumu nasıl?
Dialogue: 0,0:09:43.60,0:09:47.07,Main,,0,0,0,,Kötü durumda mı? Toparlayacak değil mi?
Dialogue: 0,0:09:47.07,0:09:50.21,Main,,0,0,0,,Burada yüzeye çıkacağımızı nereden bildiniz?
Dialogue: 0,0:09:50.21,0:09:54.34,Main,,0,0,0,,Donanma'nın hala bizi \Ntakip ediyor olmasından korkuyordum.
Dialogue: 0,0:09:54.34,0:09:57.34,Main,,0,0,0,,Salome'yi sizi su altında takip etmesi için görevlendirdim.
Dialogue: 0,0:09:57.81,0:10:02.07,Main,,0,0,0,,– Anladım!\N– Konuyu değiştirme seni tüylü yaratık!
Dialogue: 0,0:10:02.07,0:10:04.12,Main,,0,0,0,,– Özür dilerim!\N– Amma pısırıksın!
Dialogue: 0,0:10:04.98,0:10:06.72,Main,,0,0,0,,Ah, Kaptan!
Dialogue: 0,0:10:06.72,0:10:10.72,Captions,,0,0,0,,Kalp Korsanları Kaptanı\NTrafalgar Law{\fad(500,0)}
Dialogue: 0,0:10:08.65,0:10:10.72,Main,,0,0,0,,{\an8}Elimden geleni yaptım.
Dialogue: 0,0:10:10.72,0:10:13.42,Main,,0,0,0,,Yani o iyi mi?
Dialogue: 0,0:10:13.42,0:10:19.26,Main,,0,0,0,,Durumu stabil. Ancak...
Dialogue: 0,0:10:19.26,0:10:22.52,Main,,0,0,0,,tahmin ettiğinizden daha çok yara almış.
Dialogue: 0,0:10:22.89,0:10:25.07,Main,,0,0,0,,Hayatta kalacağının garantisini veremem.
Dialogue: 0,0:10:29.04,0:10:31.05,Main,,0,0,0,,Bunda şaşırılacak bir şey yok!
Dialogue: 0,0:10:31.05,0:10:32.54,Main,,0,0,0,,Kim konuşuyor?
Dialogue: 0,0:10:32.54,0:10:37.65,Main,,0,0,0,,Hasır Şapka-çocuk Impel Down'da ayağa bile zor kalkıyordu!
Dialogue: 0,0:10:37.65,0:10:42.62,Main,,0,0,0,,– Hasır Şapka hayatını riske attı!\N– Onun sayesinde hapisten kaçtık!
Dialogue: 0,0:10:42.62,0:10:45.62,Main,,0,0,0,,Onun sayesinde hayallerimize kavuşacağız...
Dialogue: 0,0:10:45.62,0:10:47.26,Main,,0,0,0,,Kamabakka Hükümdarlığı'na gideceğiz!
Dialogue: 0,0:10:47.26,0:10:48.43,Main,,0,0,0,,Hadi gidelim!
Dialogue: 0,0:10:48.43,0:10:52.07,Main,,0,0,0,,Newkama'ların evine doğru!
Dialogue: 0,0:10:55.61,0:10:57.14,Main,,0,0,0,,Bunlar kim yahu?
Dialogue: 0,0:10:57.43,0:11:01.94,Main,,0,0,0,,Impel Down mahkumlarından onlar, anlaşılan Luffy onlarla arkadaş olmuş.
Dialogue: 0,0:11:01.94,0:11:03.98,Main,,0,0,0,,Gemiye tıkışmışlar.
Dialogue: 0,0:11:05.68,0:11:09.26,Main,,0,0,0,,Kendini bu kadar zorlamış olması hayret verici!
Dialogue: 0,0:11:09.26,0:11:13.08,Main,,0,0,0,,Ace'i kurtarmayı o kadar çok istedi ki!
Dialogue: 0,0:11:13.08,0:11:17.72,Main,,0,0,0,,Evet, doğru! Hepimiz gördük canını dişine taktığını!
Dialogue: 0,0:11:18.27,0:11:22.65,Main,,0,0,0,,Ancak abisi onu korurken...
Dialogue: 0,0:11:22.92,0:11:25.43,Main,,0,0,0,,gözleri önünde can verdi.
Dialogue: 0,0:11:27.67,0:11:32.57,Main,,0,0,0,,Hayat çok adaletsiz be!\NBütün bu olanlardan sonra yıkılmasına şaşmamalı!
Dialogue: 0,0:11:32.57,0:11:36.07,Main,,0,0,0,,Lanet olsun hepsine! Dayan Hasır Şapka!
Dialogue: 0,0:11:36.07,0:11:39.24,Main,,0,0,0,,Hayatta kalmalısın! Yaşamalısın Hasır Şapka!
Dialogue: 0,0:11:45.77,0:11:51.89,Main,,0,0,0,,Ne büyük trajedi!\NKeşke onun yerine ben ölseydim!
Dialogue: 0,0:11:51.89,0:11:54.89,Main,,0,0,0,,Zavallı Luffy!
Dialogue: 0,0:11:57.55,0:11:58.78,Main,,0,0,0,,Kıskandım ya!
Dialogue: 0,0:11:58.78,0:12:01.73,Main,,0,0,0,,Korsanlar İmparatoriçesi'nin seni bu kadar önemsemesi güzel bir his olsa gerek.
Dialogue: 0,0:12:01.73,0:12:02.87,Main,,0,0,0,,Evet, öyle olmalı.
Dialogue: 0,0:12:02.87,0:12:06.26,Main,,0,0,0,,Bu arada siz Hasır Şapka-çocuk'un arkadaşları mısınız?
Dialogue: 0,0:12:06.26,0:12:08.81,Main,,0,0,0,,Hayır, onu kurtarma gibi bir mecburiyetim yoktu.
Dialogue: 0,0:12:08.81,0:12:12.51,Main,,0,0,0,,Eğer bunu basit bir iyilik olarak görmek senin için sorun teşkil ediyorsa, bir sebep uydurabilirim.
Dialogue: 0,0:12:12.51,0:12:16.62,Main,,0,0,0,,Hayır, sorun değil. Bazen içgüdüleri dinlemek iyidir.
Dialogue: 0,0:12:16.62,0:12:19.33,Main,,0,0,0,,– Hey, dur!\N– Yürümen henüz senin için iyi değil!
Dialogue: 0,0:12:19.33,0:12:23.51,Main,,0,0,0,,– Kendini böyle zorlama!\N– Sana dinlenmeni söylemişti!
Dialogue: 0,0:12:23.51,0:12:27.07,Main,,0,0,0,,– Dikişlerin atabilir!\N– Nereye gidiyorsun?
Dialogue: 0,0:12:32.05,0:12:33.87,Main,,0,0,0,,Jinbe!
Dialogue: 0,0:12:35.43,0:12:39.20,Main,,0,0,0,,Sen Kuzey Mavi'den Trafalgar Law'sın değil mi?
Dialogue: 0,0:12:42.01,0:12:46.25,Main,,0,0,0,,Hey, bu haldeyken yatıyor olman gerekmiyor mu?
Dialogue: 0,0:12:46.91,0:12:48.93,Main,,0,0,0,,Teşekkürler!
Dialogue: 0,0:12:49.94,0:12:51.62,Main,,0,0,0,,Hayatımı kurtardın!
Dialogue: 0,0:12:51.62,0:12:53.89,Main,,0,0,0,,Yatıp dinlenmen gerekiyor, hareket etmen ölmene sebep olabilir.
Dialogue: 0,0:12:55.15,0:12:58.03,Main,,0,0,0,,Yatsam bile içim hiç rahat değil. Dinlenmek ne çare!
Dialogue: 0,0:12:58.03,0:13:02.52,Main,,0,0,0,,Kaybettiklerim benim için çok önemliydi!
Dialogue: 0,0:13:02.52,0:13:07.43,Main,,0,0,0,,Bu yüzden biliyorum ki\N Luffy-{\i1}kun{\i0}'un durumu katbekat daha kötü!
Dialogue: 0,0:13:07.43,0:13:10.38,Main,,0,0,0,,En azından hayatta kalma içgüdüsü ile...
Dialogue: 0,0:13:10.38,0:13:13.70,Main,,0,0,0,,bilincini kaybetti!
Dialogue: 0,0:13:13.70,0:13:16.46,Main,,0,0,0,,Hayatta kalmayı başarsa bile,
Dialogue: 0,0:13:16.46,0:13:20.68,Main,,0,0,0,,gözünü açtığı anda hissedecekleri için çok endişeliyim.
Dialogue: 0,0:13:27.51,0:13:31.00,Main,,0,0,0,,Sen, tüylü yaratık! Den Den Mushi'n var mı?
Dialogue: 0,0:13:31.69,0:13:34.85,Main,,0,0,0,,Evet... Yani... Evet hanımefendi!
Dialogue: 0,0:13:34.85,0:13:36.03,Main,,0,0,0,,Kusura bakmayın!
Dialogue: 0,0:13:36.03,0:13:40.63,Main,,0,0,0,,– Çok kıskanıyorum, sanki uşağı gibi.\N– Evet... aynen.
Dialogue: 0,0:13:40.89,0:13:45.97,Main,,0,0,0,,Kuja Korsanları gemisi bu denizaltını Calm Belt'den geçirebilir.
Dialogue: 0,0:13:45.97,0:13:50.47,Main,,0,0,0,,Hükümet Luffy'nin hayatta olduğunu öğrenirse peşine düşeceklerdir!
Dialogue: 0,0:13:50.47,0:13:52.84,Main,,0,0,0,,Bizimle gelip, Kadınlar Adası'na sığınabilirsiniz.
Dialogue: 0,0:13:53.70,0:13:54.58,Main,,0,0,0,,Ne?!
Dialogue: 0,0:13:55.81,0:14:00.76,Main,,0,0,0,,Eğer hala Shichibukai isem, Luffy orada güvende olacaktır!
Dialogue: 0,0:13:55.81,0:14:00.76,Note,,0,0,0,,Shichibukai: Denizin Yedi Savaş Ağası
Dialogue: 0,0:14:20.68,0:14:23.35,Main,,0,0,0,,Filo amirali Sengoku!
Dialogue: 0,0:14:24.72,0:14:26.87,Main,,0,0,0,,İşte buradasınız!
Dialogue: 0,0:14:27.54,0:14:29.98,Main,,0,0,0,,Impel Down'dan haberler var!
Dialogue: 0,0:14:30.31,0:14:32.40,Main,,0,0,0,,Magellan iyi mi?
Dialogue: 0,0:14:32.40,0:14:34.95,Main,,0,0,0,,Fena hırpalanmış ve güçbela hayatta.
Dialogue: 0,0:14:35.33,0:14:38.70,Main,,0,0,0,,Şu anda sıhhiye ekibi özel olarak ilgileniyor.
Dialogue: 0,0:14:38.70,0:14:43.16,Main,,0,0,0,,Görevine çok bağlı, \Nolanların tüm sorumluluğunu üzerine alıyor.
Dialogue: 0,0:14:43.16,0:14:47.29,Main,,0,0,0,,Dediler ki; durumu o kadar kritik ki hareket etmesi ölümüne sebep olabilir.
Dialogue: 0,0:14:47.29,0:14:50.71,Main,,0,0,0,,Ayağa kalkmasına sakın müsade etmeyin!
Dialogue: 0,0:14:50.71,0:14:52.91,Main,,0,0,0,,E-emredersiniz!
Dialogue: 0,0:14:53.88,0:14:56.64,Main,,0,0,0,,Hapishanenin durumu nedir?
Dialogue: 0,0:14:56.64,0:14:58.97,Main,,0,0,0,,Hemen raporu veriyorum.
Dialogue: 0,0:14:58.97,0:15:03.48,Main,,0,0,0,,Özellikle 6. Seviye çok kötü, felaket durumda.
Dialogue: 0,0:15:05.18,0:15:07.15,Main,,0,0,0,,Felaket mi?
Dialogue: 0,0:15:07.69,0:15:12.01,Captions,,0,0,0,,{\fad(500,600)}Impel Down, Deniz Altı Hapishanesi
Dialogue: 0,0:15:13.15,0:15:15.18,Main,,0,0,0,,{\an8}Ne var ne yok millet?
Dialogue: 0,0:15:15.18,0:15:20.01,Main,,0,0,0,,{\an8}Sizler sonsuze kadar \Nparmaklıklar ardında kalmaya mahkumsunuz!
Dialogue: 0,0:15:20.53,0:15:23.16,Main,,0,0,0,,Yapabileceğiniz tek şey ölümü beklemek!
Dialogue: 0,0:15:23.16,0:15:28.34,Main,,0,0,0,,Peki şuna ne dersiniz?! Neden hücrelerinizde ölümüne dövüşmüyorsunuz?!
Dialogue: 0,0:15:29.73,0:15:35.48,Main,,0,0,0,,Hayatta kalanları serbest bırakıp tayfama alacağım!
Dialogue: 0,0:15:35.48,0:15:38.22,Main,,0,0,0,,– Cidden mi?!\N– Çıkar beni buradan!
Dialogue: 0,0:15:38.22,0:15:40.53,Main,,0,0,0,,Tayfana katılmaya hak kazanacağım!
Dialogue: 0,0:15:49.27,0:15:55.47,Main,,0,0,0,,Demek dünyanın en kötü şöhretli mahkumlarını böyle serbest bıraktı?!
Dialogue: 0,0:15:55.47,0:15:58.71,Main,,0,0,0,,Evet. Ama sadece dört mahkumu yanına almış.
Dialogue: 0,0:15:58.71,0:16:03.97,Main,,0,0,0,,Sanjuan Wolf, Avalo Pizarro,\NVasco Shot ve Catarina Devon.
Dialogue: 0,0:16:03.97,0:16:09.92,Main,,0,0,0,,Ancak görünen o ki 6. Seviyede ortalıktan kaybolan başka mahkumlar da var!
Dialogue: 0,0:16:09.92,0:16:11.48,Main,,0,0,0,,Yani...
Dialogue: 0,0:16:19.49,0:16:25.30,Main,,0,0,0,,Anladım. O halde başka firariler de var!
Dialogue: 0,0:16:25.30,0:16:30.94,Main,,0,0,0,,Eğer 6. Seviye firarilerinden bir tanesi bile insanların olduğu bir yere ulaşırsa,
Dialogue: 0,0:16:30.94,0:16:34.27,Main,,0,0,0,,insanlar büyük tehlikede olacaktır!
Dialogue: 0,0:16:34.27,0:16:37.69,Main,,0,0,0,,Kaç tane var kontrol edin.
Dialogue: 0,0:16:37.69,0:16:41.98,Main,,0,0,0,,İsimlerini toplayın ve hemen arananlar listesi oluşturun!
Dialogue: 0,0:16:43.12,0:16:44.62,Main,,0,0,0,,Ne oldu?
Dialogue: 0,0:16:44.62,0:16:47.35,Main,,0,0,0,,Aslında...
Dialogue: 0,0:16:47.35,0:16:51.56,Main,,0,0,0,,Dünya Hükümeti bu olayın....
Dialogue: 0,0:16:51.56,0:16:53.62,Main,,0,0,0,,üzerini kapatmak istiyor!
Dialogue: 0,0:16:53.62,0:16:58.43,Main,,0,0,0,,Yapacağımız bir başka hata hükümete olan güvenin azalmasına yol açabilir.
Dialogue: 0,0:17:03.07,0:17:05.41,Main,,0,0,0,,Saçmalık bu!
Dialogue: 0,0:17:32.18,0:17:34.72,Main,,0,0,0,,Şerefsiz!
Dialogue: 0,0:17:34.72,0:17:36.77,Main,,0,0,0,,Doflamingo!
Dialogue: 0,0:17:37.98,0:17:43.41,Main,,0,0,0,,Moria, Shichibukai olmak için fazla zayıfsın.
Dialogue: 0,0:17:44.71,0:17:48.90,Main,,0,0,0,,"Hükümet tarafından işi bitirildi" yerine...
Dialogue: 0,0:17:48.90,0:17:51.72,Main,,0,0,0,,"Marineford Savaşı'nda öldü" kulağa daha hoş geliyor.
Dialogue: 0,0:17:52.38,0:17:56.09,Main,,0,0,0,,Kimin fikriydi bu?! Sengoku mu?!
Dialogue: 0,0:17:56.34,0:18:00.12,Main,,0,0,0,,Hayır, daha yukarılardan birinin!
Dialogue: 0,0:18:03.06,0:18:06.99,Captions,,0,0,0,,Batı Mavi{\fad(500,500)}
Dialogue: 0,0:18:22.48,0:18:24.47,Main,,0,0,0,,Batı Mavi'de bir korsan gemisi\NLascamp'a yaklaşıyor!
Dialogue: 0,0:18:24.47,0:18:28.06,Main,,0,0,0,,Ancak civardaki Donanma üslerinde yardıma gidecek savaş gemisi bulunmuyor.
Dialogue: 0,0:18:28.06,0:18:29.59,Main,,0,0,0,,Yakınlardaki donanma üslerinin kodları nedir?
Dialogue: 0,0:18:30.26,0:18:32.99,Main,,0,0,0,,80. Bölük yardım gönderecek!
Dialogue: 0,0:18:35.46,0:18:38.50,Main,,0,0,0,,Güney Mavi alan kontrolü sağlanıyor!
Dialogue: 0,0:18:38.50,0:18:39.53,Main,,0,0,0,,Kahretsin!
Dialogue: 0,0:18:39.53,0:18:41.60,Main,,0,0,0,,Beyazsakal öldürülüp zafer kazanıldıktan sonra...
Dialogue: 0,0:18:41.60,0:18:46.10,Main,,0,0,0,,korsanlar bizden korkmaya başlar sanmıştım.
Dialogue: 0,0:18:46.10,0:18:50.23,Main,,0,0,0,,Sineye çekilmek yerine kuduz köpek gibi her yere saldırıyorlar!
Dialogue: 0,0:18:50.23,0:18:52.40,Main,,0,0,0,,Ne oldu bunlara böyle?
Dialogue: 0,0:18:52.40,0:18:55.24,Main,,0,0,0,,Korsanlar Lascamp'a ayak bastı!
Dialogue: 0,0:18:55.24,0:18:57.94,Main,,0,0,0,,İrtibatı kaybettik! Destek yollayın!
Dialogue: 0,0:18:57.94,0:19:00.32,Main,,0,0,0,,Tekrar ediyorum, Lascamp'a destek yollayın!
Dialogue: 0,0:19:02.45,0:19:07.25,Main,,0,0,0,,Malları yükleyin! Grand Line'a doğru yola çıkıyoruz! {.}
Dialogue: 0,0:19:10.66,0:19:16.65,Captions,,0,0,0,,Yeni Dünya - Foodvalten{\fad(500,500)}
Dialogue: 0,0:19:12.20,0:19:15.23,Narrator,,0,0,0,,{\an8}Marineford savaşından iki hafta sonra,
Dialogue: 0,0:19:15.23,0:19:19.39,Narrator,,0,0,0,,{\an8}savaşın etkileri dünyanın dört bir yanında hissediliyordu.
Dialogue: 0,0:19:23.56,0:19:27.55,Main,,0,0,0,,D-daha fazla yaklaşma!\NKasabamızdan uzak durun!
Dialogue: 0,0:19:31.11,0:19:33.88,Main,,0,0,0,,Haberleri duydunuz değil mi?
Dialogue: 0,0:19:37.79,0:19:42.98,Main,,0,0,0,,O zaman biliyorsunuz artık burası Beyazsakal'ın bölgesi değil.
Dialogue: 0,0:19:42.98,0:19:46.30,Main,,0,0,0,,Bu sembolün hiçbir anlamı yok artık!
Dialogue: 0,0:19:46.30,0:19:50.20,Main,,0,0,0,,Doğru duydunuz! Beyazsakal öldü!
Dialogue: 0,0:20:07.10,0:20:11.06,Main,,0,0,0,,Kulaklarını aç dinle ve dediklerimi kafana kazı!
Dialogue: 0,0:20:11.06,0:20:15.11,Main,,0,0,0,,Artık bu ada bana ait,
Dialogue: 0,0:20:15.11,0:20:17.86,Main,,0,0,0,,Kahverengisakal'a!
Dialogue: 0,0:20:20.89,0:20:25.39,Narrator,,0,0,0,,Savaş Beyazsakal'ın ölümü ve Donanma'nın galibiyeti ile sonuçlandı.{\an8}
Dialogue: 0,0:20:25.39,0:20:28.12,Narrator,,0,0,0,,Ancak Donanma'nın beklediğinin aksine,{\an8}
Dialogue: 0,0:20:28.12,0:20:32.53,Narrator,,0,0,0,,denizlere bir kargaşa hakim olmuştu.{\an8}
Dialogue: 0,0:20:34.57,0:20:36.49,Narrator,,0,0,0,,Kısa bir süre önce,{\an8}
Dialogue: 0,0:20:36.49,0:20:39.25,Narrator,,0,0,0,,Hancock, Jinbe, ve diğerleri...{\an8}
Dialogue: 0,0:20:39.25,0:20:42.37,Narrator,,0,0,0,,baygın Luffy'i Kadınlar Adası'na götürme kararı aldılar.{\an8}
Dialogue: 0,0:20:42.37,0:20:45.99,Narrator,,0,0,0,,Kuja Korsanları'nın gemisi ile buluştular.{\an8}
Dialogue: 0,0:20:47.98,0:20:53.78,Main,,0,0,0,,Pekala, Hasır Şapka-çocuk'a yardımlarım burada bitiyor.
Dialogue: 0,0:20:55.78,0:20:59.30,Main,,0,0,0,,Kalanı sana bıraksak olur mu Jinbe?
Dialogue: 0,0:20:59.30,0:21:02.37,Main,,0,0,0,,Evet. En azından Luffy-{\i1}kun{\i0}\N iyileşene kadar burada kalacağım.
Dialogue: 0,0:21:02.37,0:21:06.44,Main,,0,0,0,,Henüz yüzemiyorum zaten.
Dialogue: 0,0:21:06.92,0:21:10.82,Main,,0,0,0,,O nasıl yardım edebilirim bilmiyorum gerçi...
Dialogue: 0,0:21:11.78,0:21:14.69,Main,,0,0,0,,Seninle karşılaşmamız kaderin cilvesi Jinbe.
Dialogue: 0,0:21:14.69,0:21:16.00,Main,,0,0,0,,Öyle.
Dialogue: 0,0:21:16.00,0:21:18.20,Main,,0,0,0,,İkimiz de...
Dialogue: 0,0:21:18.20,0:21:21.26,Main,,0,0,0,,dünyanın en büyük hapishanesi Impel Down'daydık.
Dialogue: 0,0:21:21.26,0:21:23.81,Main,,0,0,0,,Ama Luffy-{\i1}kun{\i0} olmasaydı,
Dialogue: 0,0:21:23.81,0:21:28.73,Main,,0,0,0,,belki de hiç karşılaşmayacaktık.
Dialogue: 0,0:21:29.00,0:21:35.44,Main,,0,0,0,,İkimiz de Marineford'da Hasır Şapka-çocuk'a ayak uydurmak için çok çabaladık değil mi?
Dialogue: 0,0:21:35.44,0:21:37.87,Main,,0,0,0,,Sana elveda demek çok zor ama,
Dialogue: 0,0:21:37.87,0:21:43.12,Main,,0,0,0,,hükümdarlığımda beni bekleyen tatlışlarım var.
Dialogue: 0,0:21:43.12,0:21:46.93,Main,,0,0,0,,Lütfen Hasır Şapka-çocuk'a göz kulak ol!
Dialogue: 0,0:21:51.30,0:21:54.59,Main,,0,0,0,,Hoşçakal, Hasır Şapka! Bizi kurtardığın için teşekkürler!
Dialogue: 0,0:21:54.59,0:21:58.43,Main,,0,0,0,,Sayende hayallerimi gerçekleştirebileceğim!
Dialogue: 0,0:21:58.43,0:22:00.83,Main,,0,0,0,,Uyandığında bizden ona selam söyle!
Dialogue: 0,0:22:00.83,0:22:05.50,Main,,0,0,0,,– Fırsat bulursak tekrar görüşelim!\N– Sakın pes etmeyin!
Dialogue: 0,0:22:05.50,0:22:08.47,Main,,0,0,0,,Yaşamalısın, Hasır Şapka!
Dialogue: 0,0:22:08.47,0:22:11.03,Main,,0,0,0,,Tamam, hadi gidelim!
Dialogue: 0,0:22:11.03,0:22:15.53,Main,,0,0,0,,Uzun zamandır hasret kaldığımız newkamaların evine!
Dialogue: 0,0:22:15.53,0:22:18.57,Main,,0,0,0,,Kamabakka Hükümdarlığı'na!
Dialogue: 0,0:22:19.53,0:22:23.67,Main,,0,0,0,,Bizim de Kadınlar Adası'na yola çıkmamız lazım.
Dialogue: 0,0:22:25.28,0:22:26.69,Narrator,,0,0,0,,İki hafta sonra,{\an8}
Dialogue: 0,0:22:27.46,0:22:30.35,Narrator,,0,0,0,,Law ve diğerleri Luffy'i tedavi etmek için...{\an8}
Dialogue: 0,0:22:30.35,0:22:33.60,Narrator,,0,0,0,,kıyıda kalıyordu.{\an8}
Dialogue: 0,0:22:43.89,0:22:45.08,Main,,0,0,0,,Bekleyin!
Dialogue: 0,0:22:46.69,0:22:49.88,Main,,0,0,0,,Bu çok tehlikeli! Sakin ol, Hasır Şapka!
Dialogue: 0,0:22:49.88,0:22:52.55,Main,,0,0,0,,Başıboş bıraksak ne yapacak kim bilir?
Dialogue: 0,0:22:52.92,0:22:58.30,Main,,0,0,0,,Evet, buraya geldiğimizde dediğim gibi...
Dialogue: 0,0:22:58.30,0:23:01.93,Main,,0,0,0,,yaraları açılırsa ölür.
Dialogue: 0,0:23:05.01,0:23:07.45,Main,,0,0,0,,Aha, fırsat bu fırsat!
Dialogue: 0,0:23:07.45,0:23:10.73,Main,,0,0,0,,– Bıraksanıza laan!\N– Sakin dur, Hasır Şapka!
Dialogue: 0,0:23:10.73,0:23:13.47,Main,,0,0,0,,"Bırakın" dedim!
Dialogue: 0,0:23:14.97,0:23:17.55,Main,,0,0,0,,Ace nerede?!
Dialogue: 0,0:23:17.55,0:23:22.17,Main,,0,0,0,,– Ace!!\N– Lanet olsun! Kontrolden çıktı!
Dialogue: 0,0:23:22.17,0:23:25.75,Main,,0,0,0,,– Luffy!\N– Yılan Prenses-{\i1}sama{\i0}'ya haber vermeliyiz!
Dialogue: 0,0:23:25.75,0:23:30.42,Main,,0,0,0,,Yılan Prenses-{\i1}sama{\i0}! Yılan Prenses-{\i1}sama{\i0}!
Dialogue: 0,0:23:30.42,0:23:32.79,Main,,0,0,0,,Luffy uyandı!
Dialogue: 0,0:23:32.79,0:23:35.93,Main,,0,0,0,,– Luffy-{\i1}sama?!{\i0}\N– Gerçekten mi?!
Dialogue: 0,0:23:35.93,0:23:38.40,Main,,0,0,0,,Şükürler olsun. Onu hemen görmek istiyorum!
Dialogue: 0,0:23:38.40,0:23:40.23,Main,,0,0,0,,Olmaz, Yılan Prenses!
Dialogue: 0,0:23:40.23,0:23:43.19,Main,,0,0,0,,Herkes onu görmek istiyor.
Dialogue: 0,0:23:43.19,0:23:47.78,Main,,0,0,0,,Eğer gidip onu görürseniz otoriteniz sarsılır.
Dialogue: 0,0:23:47.78,0:23:50.59,Main,,0,0,0,,Erkeklerin bu adaya girişi yasaktır.
Dialogue: 0,0:23:50.59,0:23:58.88,Main,,0,0,0,,Bu garip adamların kıyıda kalmalarına izin veriyoruz, daha fazla taviz veremeyiz!
Dialogue: 0,0:23:58.88,0:24:00.89,Main,,0,0,0,,Biliyorum ama...
Dialogue: 0,0:24:00.89,0:24:03.36,Main,,0,0,0,,Ondan önce ablacım, bir şeyler yemen gerekiyor.
Dialogue: 0,0:24:03.36,0:24:08.55,Main,,0,0,0,,Doğru diyor ablacım!\NDöndüğünden beri doğru düzgün bir şey yemedin!
Dialogue: 0,0:24:08.55,0:24:11.95,Main,,0,0,0,,Haklısınız! Luffy de çok acıkmış olmalı!
Dialogue: 0,0:24:11.95,0:24:15.13,Main,,0,0,0,,Ona en güzel yemeklerimizden bolca hazırlayın da enerjisi yerine gelsin!
Dialogue: 0,0:24:15.13,0:24:16.96,Main,,0,0,0,,Emredersiniz, memnuniyetle!
Dialogue: 0,0:24:16.96,0:24:21.22,Main,,0,0,0,,Ben de size yardım edeceğim! Hadi kızlar işe koyulalım!
Dialogue: 0,0:24:21.22,0:24:23.47,Main,,0,0,0,,Emredersiniz, Yılan Prenses-{\i1}sama{\i0}!
Dialogue: 0,0:24:23.47,0:24:28.21,Main,,0,0,0,,Bu kadarına da müsade etmem lazım, alt tarafı yemek hazırlamak istiyor.
Dialogue: 0,0:24:28.21,0:24:31.43,Main,,0,0,0,,Sonra da yemekleri bizzat ben götüreceğim!
Dialogue: 0,0:24:31.43,0:24:33.08,Main,,0,0,0,,Gidiyorsun yani?!
Dialogue: 0,0:24:33.08,0:24:38.90,Main,,0,0,0,,İyileştiğinde onu burada \Ntek başına ağırlayacağız diye anlaşmıştık.
Dialogue: 0,0:24:38.90,0:24:40.46,Main,,0,0,0,,Sabırlı ol da gelmesini bekle!
Dialogue: 0,0:24:40.46,0:24:44.28,Main,,0,0,0,,Olmaz! Ben bir imparatoriçeyim!\NBana ne yapacağımı söyleyemezsin!
Dialogue: 0,0:24:44.28,0:24:45.44,Main,,0,0,0,,Gidemezsin dedim!
Dialogue: 0,0:24:45.44,0:24:48.77,Main,,0,0,0,,Bu ülkenin gelenekleri bir hükümdarın geçici heveslerinden daha önemli!
Dialogue: 0,0:24:49.48,0:24:54.00,Main,,0,0,0,,Olacak iş değil! Zehri almışsın bir kere!
Dialogue: 0,0:24:54.00,0:24:58.14,Main,,0,0,0,,Koskaca Korsan İmparatoriçe'nin kör kütük aşık olduğuna inanamıyorum!
Dialogue: 0,0:24:59.09,0:25:03.13,Thoughts,,0,0,0,,Gelgelelim, Impel Down ve Donanma Genel Merkezi'ndeki curcunaya dahil olup,
Dialogue: 0,0:25:03.13,0:25:06.70,Thoughts,,0,0,0,,canlı çıktığına göre anasının gözü biri olmalı...
Dialogue: 0,0:25:06.70,0:25:11.66,Thoughts,,0,0,0,,Hayatta kalıp buraya gelmesi tanrıların işi olmalı.
Dialogue: 0,0:25:11.66,0:25:17.22,Thoughts,,0,0,0,,Acaba tanrıların onun için yazdığı kader ne merak ediyorum.
Dialogue: 0,0:25:18.06,0:25:21.60,Main,,0,0,0,,– Hey, cıvata anahtarını versene.\N– Peki, al bakalım.
Dialogue: 0,0:25:21.60,0:25:24.53,Main,,0,0,0,,Hey, gemiyi onarabilecek misin?
Dialogue: 0,0:25:24.53,0:25:28.78,Main,,0,0,0,,Evet hallederim. Onu bırak da Hasır Şapka nereye gitti?
Dialogue: 0,0:25:28.78,0:25:30.72,Main,,0,0,0,,Jinbe de gitmiş.
Dialogue: 0,0:25:30.72,0:25:33.24,Main,,0,0,0,,Bilmiyorum.
Dialogue: 0,0:25:34.05,0:25:37.24,Main,,0,0,0,,Duyduğuma göre eğer bir erkek Kadınlar Adası'na girerse....
Dialogue: 0,0:25:37.24,0:25:39.66,Main,,0,0,0,,taşa dönüşürmüş.
Dialogue: 0,0:25:39.66,0:25:41.73,Main,,0,0,0,,Belki de bu ölmeye değerdir.
Dialogue: 0,0:25:41.73,0:25:47.16,Main,,0,0,0,,Aphelandra-{\i1}chan{\i0}'ın dediğine göre \Ntüm kadınlar limana gelmemiş.
Dialogue: 0,0:25:47.16,0:25:52.10,Main,,0,0,0,,Hep hayalini kurduğum bir ada dolusu kadın!\NKeşke girip bakabilsek!
Dialogue: 0,0:25:52.10,0:25:54.22,Main,,0,0,0,,Aptal, öldürteceksin kendini.
Dialogue: 0,0:25:54.22,0:25:56.31,Main,,0,0,0,,Acaba dişi ayılar da var mıdır?
Dialogue: 0,0:25:56.31,0:25:58.11,Main,,0,0,0,,Burası Kadınlar Adası!
Dialogue: 0,0:25:58.11,0:25:59.37,Main,,0,0,0,,Özür dilerim.
Dialogue: 0,0:25:59.37,0:26:02.12,Main,,0,0,0,,Sadece insanlar! Sadece insanlar var!
Dialogue: 0,0:26:02.12,0:26:04.81,Main,,0,0,0,,Çok özür dilerim!
Dialogue: 0,0:26:40.49,0:26:43.35,Main,,0,0,0,,Neredeyim ben?
Dialogue: 0,0:26:44.58,0:26:48.12,Main,,0,0,0,,Belki de hepsi rüyaydı.
Dialogue: 0,0:27:03.18,0:27:06.50,Flashbacks,,0,0,0,,Üzgünüm, Luffy.
Dialogue: 0,0:27:10.51,0:27:13.82,Flashbacks,,0,0,0,,Başaramadım.
Dialogue: 0,0:27:23.98,0:27:27.39,Main,,0,0,0,,Git! Kaybol!
Dialogue: 0,0:27:27.39,0:27:28.76,Flashbacks,,0,0,0,,Luffy!
Dialogue: 0,0:27:29.99,0:27:32.73,Main,,0,0,0,,Dur!
Dialogue: 0,0:27:39.14,0:27:43.84,Main,,0,0,0,,Git! Yok ol!
Dialogue: 0,0:28:21.70,0:28:24.53,Flashbacks,,0,0,0,,Eğer ölümüm kaçınılmazsa,
Dialogue: 0,0:28:25.22,0:28:30.35,Flashbacks,,0,0,0,,kusura bakma ama kardeşime göz kulak olur musun?
Dialogue: 0,0:28:32.45,0:28:35.34,Main,,0,0,0,,Savaş bitti!
Dialogue: 0,0:28:35.34,0:28:36.76,Main,,0,0,0,,Ace-{\i1}san{\i0}...
Dialogue: 0,0:28:36.76,0:28:39.83,Main,,0,0,0,,Söyleme! Sakın bir şey söyleme!
Dialogue: 0,0:28:41.09,0:28:45.40,Main,,0,0,0,,Kendimi hırpalaya hırpalaya perişan ettim!
Dialogue: 0,0:28:48.39,0:28:50.81,Main,,0,0,0,,Eğer bir rüya olsaydı çoktan uyanırdım!
Dialogue: 0,0:28:53.22,0:28:55.92,Main,,0,0,0,,Bu bir rüya değil, değil mi?
Dialogue: 0,0:29:04.45,0:29:08.63,Main,,0,0,0,,Ace gerçekten öldü, değil mi?!
Dialogue: 0,0:29:15.29,0:29:18.75,Main,,0,0,0,,Evet, öldü!
Dialogue: 0,0:29:26.04,0:29:29.38,Flashbacks,,0,0,0,,Hey dede, Ace kim?
Dialogue: 0,0:29:29.38,0:29:32.85,Flashbacks,,0,0,0,,Ah, o...
Dialogue: 0,0:29:32.85,0:29:36.96,Flashbacks,,0,0,0,,abin olacak kişi!
Dialogue: 0,0:29:37.99,0:29:42.86,Flashbacks,,0,0,0,,Luffy! Korsanlar dünyasının zirvesine ulaştığında görüşeceğiz!
Dialogue: 0,0:29:42.86,0:29:45.66,Flashbacks,,0,0,0,,Gel zirvede beni bul!
Dialogue: 0,0:30:01.02,0:30:05.46,Main,,0,0,0,,Ace!!
