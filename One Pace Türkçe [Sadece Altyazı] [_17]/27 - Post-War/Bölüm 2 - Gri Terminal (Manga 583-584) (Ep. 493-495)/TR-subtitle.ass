000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.5,1.5,7,12,12,12,1Style: Note,Impress BT,63.0,&H00FFFFFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,3,3,8,180,180,27,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:03.96,0:00:06.81,Credits,,0,0,0,,Editing SewilDialogue: 0,0:00:06.81,0:00:09.56,Credits,,0,0,0,,Timing Sewil PhosCityDialogue: 0,0:00:09.56,0:00:12.11,Credits,,0,0,0,,Karaoke KaitouYahikoDialogue: 0,0:00:12.11,0:00:15.01,Credits,,0,0,0,,QC Feeso, Galaxy 9000, PepperjackDialogue: 0,0:00:15.01,0:00:17.11,Credits,,0,0,0,,Translation Crunchyroll Funimation GaijinDialogue: 0,0:00:17.11,0:00:18.50,Credits,,0,0,0,,Raws df68Dialogue: 0,0:00:18.59,0:00:22.17,OP14 Translation,,0,0,0,,♪ Keşfedilmemiş yarınlarda buluşmaya,Dialogue: 0,0:00:22.26,0:00:26.69,OP14 Translation,,0,0,0,,yola çıkalım şafak sökmeden. ♪Dialogue: 0,0:00:26.97,0:00:30.33,OP14 Translation,,0,0,0,,♪ Kararımı verdim ve pişman değilim. ♪Dialogue: 0,0:00:30.55,0:00:33.35,OP14 Translation,,0,0,0,,♪ Ne yapmam gerektiğini çok iyi biliyorum. ♪Dialogue: 0,0:00:33.51,0:00:37.07,OP14 Translation,,0,0,0,,♪ Yolumuzda bizi her ne sınav bekliyor olursa olsun,Dialogue: 0,0:00:37.21,0:00:41.70,OP14 Translation,,0,0,0,,kalplerimizin atışını hiçbir şey durduramaz. ♪Dialogue: 0,0:00:41.81,0:00:46.35,OP14 Translation,,0,0,0,,♪ Hepimizin hedefinde tek bir yer var. ♪Dialogue: 0,0:00:46.57,0:00:48.30,OP14 Translation,,0,0,0,,♪ Işığa doğru atıl! ♪Dialogue: 0,0:00:48.32,0:00:52.09,OP14 Translation,,0,0,0,,♪ Savaşlarımız esnasında kurduğumuz bağlara,Dialogue: 0,0:00:52.16,0:00:55.67,OP14 Translation,,0,0,0,,hiç kimsenin zarar vermesine izin vermeyeceğim. ♪Dialogue: 0,0:00:55.80,0:00:58.47,OP14 Translation,,0,0,0,,♪ Yumruklarımızı sıkmayı bırakırsak,Dialogue: 0,0:00:58.60,0:01:01.71,OP14 Translation,,0,0,0,,içlerindeki asıl gücü bulacağız. ♪Dialogue: 0,0:01:01.87,0:01:04.13,OP14 Translation,,0,0,0,,♪ O halde hadi başlayalım! ♪Dialogue: 0,0:01:04.27,0:01:09.28,OP14 Translation,,0,0,0,,♪ Yepyeni bir dünya bizi çağırıyor. ♪Dialogue: 0,0:01:09.38,0:01:11.67,OP14 Translation,,0,0,0,,♪ İleriye bak! ♪Dialogue: 0,0:01:11.78,0:01:18.02,OP14 Translation,,0,0,0,,♪ Birbirimize destek olmayı asla bırakmayacağız,Dialogue: 0,0:01:18.08,0:01:21.79,OP14 Translation,,0,0,0,,aramızda sayısız deniz olsa bile. ♪Dialogue: 0,0:01:21.82,0:01:25.46,OP14 Translation,,0,0,0,,♪ Hadi korkularımızı bir kenara bırakıp, harekete geçelim. ♪Dialogue: 0,0:01:25.96,0:01:27.85,OP14 Translation,,0,0,0,,♪ Lütfen unutma,Dialogue: 0,0:01:27.97,0:01:29.14,OP14 Translation,,0,0,0,,beraber savaşıyoruz. ♪Dialogue: 0,0:01:29.86,0:01:37.12,OP14 Translation,,0,0,0,,♪ O gün baktığımız,Dialogue: 0,0:01:37.54,0:01:39.90,OP14 Translation,,0,0,0,,ufuktaki geniş, görkemli gökyüzü,Dialogue: 0,0:01:40.01,0:01:45.02,OP14 Translation,,0,0,0,,hala tertemiz. ♪Dialogue: 0,0:01:45.04,0:01:48.45,OP14 Translation,,0,0,0,,♪ Kalbimizin derinliklerinde ettiğimiz yeminler ileDialogue: 0,0:01:48.65,0:01:52.41,OP14 Translation,,0,0,0,,çok uzun bir yol geldik. ♪Dialogue: 0,0:01:52.45,0:01:54.99,OP14 Translation,,0,0,0,,♪ Korkacak hiçbir şey yok. ♪Dialogue: 0,0:01:55.05,0:01:59.42,OP14 Translation,,0,0,0,,♪ Hepimizin taşıması gereken yükler var. ♪Dialogue: 0,0:01:59.56,0:02:01.88,OP14 Translation,,0,0,0,,♪ Güneş doğuyorDialogue: 0,0:02:02.03,0:02:06.84,OP14 Translation,,0,0,0,,ve her şeyi aydınlatıyor, hüznümü bile... ♪Dialogue: 0,0:02:06.87,0:02:09.24,OP14 Translation,,0,0,0,,♪ İnanıyorum,Dialogue: 0,0:02:09.34,0:02:15.58,OP14 Translation,,0,0,0,,hepimizin bir olduğu bir geleceğe. ♪Dialogue: 0,0:02:15.71,0:02:19.30,OP14 Translation,,0,0,0,,♪ Hadi gidip onu beraber bulalım. ♪Dialogue: 0,0:02:19.38,0:02:23.11,OP14 Translation,,0,0,0,,♪ Senin yerini kimse dolduramaz. ♪Dialogue: 0,0:02:23.58,0:02:25.24,OP14 Translation,,0,0,0,,♪ Lütfen unutma! ♪Dialogue: 0,0:02:25.56,0:02:27.66,OP14 Translation,,0,0,0,,♪ Beraber savaşıyoruz. ♪Dialogue: 0,0:02:31.45,0:02:36.42,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Mantisentil thx to onepace.netDialogue: 0,0:24:05.50,0:24:15.50,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Mantisentil thx to onepace.netDialogue: 0,0:39:59.00,0:40:03.40,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Mantisentil thx to onepace.netDialogue: 0,0:02:31.45,0:02:36.42,Title,,0,0,230,,Gri TerminalDialogue: 0,0:02:37.49,0:02:40.96,Narrator,,0,0,0,,10 yıl önce Doğu Mavi'de...Dialogue: 0,0:02:42.86,0:02:48.68,Narrator,,0,0,0,,İnsanların barış içinde yaşadığı Foosha Köyü adında bir yer vardı.Dialogue: 0,0:02:49.36,0:02:52.70,Narrator,,0,0,0,,Hemen yakınlarında Coluba isminde bir dağ yükselirdi, insanların gitmeye nadiren teşebbüs ettiği.Dialogue: 0,0:02:53.72,0:03:00.76,Narrator,,0,0,0,,Sadece güçlülerin hayatta kalabildiği,  zayıfları ölümün beklediği.Dialogue: 0,0:03:02.46,0:03:05.48,Main,,0,0,0,,Ya dede diyorum ki...Dialogue: 0,0:03:06.20,0:03:08.47,Main,,0,0,0,,Korsanlar Kralı olacağım.Dialogue: 0,0:03:08.47,0:03:10.74,Main,,0,0,0,,Kes saçmalamayı!  Korsanlar Kralı'nı nereden biliyorsun sen?!Dialogue: 0,0:03:10.74,0:03:12.91,Main,,0,0,0,,Bırak... Bırak beni!Dialogue: 0,0:03:12.91,0:03:16.78,Main,,0,0,0,,Şeytan Meyvesi'ni yediğin yetmedi  hala boş boş konuşuyorsun!Dialogue: 0,0:03:16.78,0:03:22.05,Captions,,0,0,0,,Monkey D. Garp         (10 Yıl Önce)Dialogue: 1,0:03:16.78,0:03:22.05,Captions,,0,0,0,,Monkey D. Garp         (10 Yıl Önce)Dialogue: 0,0:03:16.78,0:03:22.05,Main,,0,0,0,,Luffy, sen ve Ace ikiniz de dalyan gibi birer Donanma subayı olacaksınız!Dialogue: 0,0:03:22.05,0:03:24.10,Main,,0,0,0,,Ah, ah, ah lanet olsun!Dialogue: 0,0:03:22.05,0:03:26.83,Captions,,0,0,0,,Monkey D. Luffy         (10 Yıl Önce)Dialogue: 1,0:03:22.05,0:03:26.83,Captions,,0,0,0,,Monkey D. Luffy         (10 Yıl Önce)Dialogue: 0,0:03:24.10,0:03:26.47,Main,,0,0,0,,Bedenim lastik olmasına rağmen niye canım acıyor?!Dialogue: 0,0:03:26.47,0:03:28.83,Main,,0,0,0,,Bırak beni dede!Dialogue: 0,0:03:28.83,0:03:32.12,Main,,0,0,0,,Seni Foosha Köyü'nde bırakmak bir hataydı!Dialogue: 0,0:03:32.12,0:03:34.59,Main,,0,0,0,,Gittin buldun korsanları!Dialogue: 0,0:03:37.76,0:03:39.43,Main,,0,0,0,,Burası neresi?Dialogue: 0,0:03:41.07,0:03:46.00,Main,,0,0,0,,Dur artık! Canına mı susadın da  kapımı yumrukluyorsun?!Dialogue: 0,0:03:46.00,0:03:47.07,Main,,0,0,0,,Benim.Dialogue: 0,0:03:50.22,0:03:52.35,Main,,0,0,0,,G-Garp-san!Dialogue: 0,0:03:54.81,0:03:58.28,Captions,,0,0,0,,Kıvırcık DadanDialogue: 1,0:03:54.81,0:03:58.28,Captions,,0,0,0,,Kıvırcık DadanDialogue: 0,0:03:58.28,0:04:01.72,Captions,,0,0,0,,Dogra, dağ eşkıyasıDialogue: 1,0:03:58.28,0:04:01.72,Captions,,0,0,0,,Dogra, dağ eşkıyasıDialogue: 0,0:04:01.72,0:04:05.19,Captions,,0,0,0,,Magra, dağ eşkıyasıDialogue: 1,0:04:01.72,0:04:05.19,Captions,,0,0,0,,Magra, dağ eşkıyasıDialogue: 0,0:04:05.19,0:04:06.72,Main,,0,0,0,,İyi gördüm seni.Dialogue: 0,0:04:06.72,0:04:11.60,Main,,0,0,0,,Bir huzur ver yahu! Biraz acıman olsun!Dialogue: 0,0:04:11.60,0:04:14.14,Main,,0,0,0,,Ace 10 yaşına girdi!Dialogue: 0,0:04:14.14,0:04:17.77,Main,,0,0,0,,Hadi ya oldu mu o kadar? Nasıl, iyi mi?Dialogue: 0,0:04:17.77,0:04:19.92,Main,,0,0,0,,Komik değil!Dialogue: 0,0:04:19.92,0:04:23.73,Main,,0,0,0,,Artık onu idare edemiyoruz!  Geri alman lazım!Dialogue: 0,0:04:23.73,0:04:26.78,Main,,0,0,0,,-Onu boş ver de... -Boş vermeyelim!Dialogue: 0,0:04:26.78,0:04:28.68,Main,,0,0,0,,Koşturup durmasana, velet!Dialogue: 0,0:04:29.16,0:04:30.88,Main,,0,0,0,,Ona da göz kulak olmanızı istiyorum.Dialogue: 0,0:04:32.38,0:04:34.49,Main,,0,0,0,,Hey, Luffy, selam ver.Dialogue: 0,0:04:34.49,0:04:35.32,Main,,0,0,0,,Yo!Dialogue: 0,0:04:35.32,0:04:38.02,Main,,0,0,0,,Kim bu çocuk?Dialogue: 0,0:04:38.02,0:04:40.66,Main,,0,0,0,,Bu benim torunum.Dialogue: 0,0:04:40.66,0:04:41.39,Main,,0,0,0,,Ne?Dialogue: 0,0:04:41.39,0:04:43.66,Main,,0,0,0,,Neeee?!Dialogue: 0,0:04:43.66,0:04:45.28,Main,,0,0,0,,Bir tane daha mı?!Dialogue: 0,0:04:45.28,0:04:49.74,Main,,0,0,0,,Garp'ın... Yani Garp-san'ın torunu mu?!Dialogue: 0,0:04:49.74,0:04:51.04,Main,,0,0,0,,Olmaz!Dialogue: 0,0:04:51.04,0:04:53.40,Main,,0,0,0,,Tamam o zaman, seçenekleriniz şunlar:Dialogue: 0,0:04:53.40,0:04:56.51,Main,,0,0,0,,Ya hayatınızın kalanını hapiste geçirirsiniz ya da ona bakmayı kabul edersiniz.Dialogue: 0,0:04:56.51,0:05:00.38,Main,,0,0,0,,Siciliniz kabarık biliyorsunuz.Dialogue: 0,0:05:02.00,0:05:03.85,Main,,0,0,0,,Yapma!Dialogue: 0,0:05:03.85,0:05:06.82,Main,,0,0,0,,Tutuklanmak istemiyorum ama...Dialogue: 0,0:05:06.82,0:05:12.41,Main,,0,0,0,,Bazen düşünüyorum acaba hapis yatmak Ace'e bakmaktan daha mı iyi olurdu.Dialogue: 0,0:05:12.41,0:05:17.70,Main,,0,0,0,,Bir de torununa mı bakmamızı istiyorsun? Kesin o da haylazın önde gidenidir.Dialogue: 0,0:05:17.70,0:05:19.21,Main,,0,0,0,,Ne boktan bir gecekondu!Dialogue: 0,0:05:19.21,0:05:21.38,Main,,0,0,0,,Seni bir döverim!Dialogue: 0,0:05:21.38,0:05:22.47,Main,,0,0,0,,Dinlemiyor bile!Dialogue: 0,0:05:22.47,0:05:24.68,Main,,0,0,0,,Patron! İyi misin?!Dialogue: 0,0:05:24.68,0:05:28.07,Main,,0,0,0,,Bu ne?! Öğk tükürük! İğrenç!Dialogue: 0,0:05:28.72,0:05:29.83,Main,,0,0,0,,Kim tükürdü?!Dialogue: 0,0:05:31.14,0:05:32.44,Main,,0,0,0,,Hey, sen!Dialogue: 0,0:05:33.21,0:05:35.77,Main,,0,0,0,,Özür dile! İğrenç!Dialogue: 0,0:05:35.77,0:05:37.35,Main,,0,0,0,,Ace!Dialogue: 0,0:05:37.35,0:05:39.51,Main,,0,0,0,,Döndün mü, Ace?Dialogue: 0,0:05:41.08,0:05:45.32,Captions,,0,0,0,,Portgas D. Ace         (10 Yıl Önce)Dialogue: 1,0:05:41.08,0:05:45.32,Captions,,0,0,0,,Portgas D. Ace         (10 Yıl Önce)Dialogue: 0,0:05:45.32,0:05:46.56,Main,,0,0,0,,Hey, özür dile!Dialogue: 0,0:05:48.76,0:05:53.62,Main,,0,0,0,,Luffy, bu Ace. Senden 3 yaş büyük.Dialogue: 0,0:05:53.62,0:05:56.43,Main,,0,0,0,,Bundan sonra onlarla burada yaşayacaksın.Dialogue: 0,0:05:56.95,0:05:58.90,Main,,0,0,0,,Ne?! Buna sen karar veremezsin!Dialogue: 0,0:06:04.55,0:06:05.71,Main,,0,0,0,,Düzgün dur!Dialogue: 0,0:06:05.71,0:06:06.81,Main,,0,0,0,,Ne yani burada mı kalacak?!Dialogue: 0,0:06:06.81,0:06:08.85,Main,,0,0,0,,Bir sakıncası mı var?Dialogue: 0,0:06:11.33,0:06:12.98,Main,,0,0,0,,Kabul ediyoruz!Dialogue: 0,0:06:13.82,0:06:15.74,Main,,0,0,0,,Bulaşık sırası sende!Dialogue: 0,0:06:16.14,0:06:18.43,Main,,0,0,0,,Biraz daha alabilir miyim babalık!Dialogue: 0,0:06:18.43,0:06:20.59,Main,,0,0,0,,Kadınım ben!Dialogue: 0,0:06:20.59,0:06:23.87,Main,,0,0,0,,Nerede olduğun hakkında en ufak bir fikrin var mı?!Dialogue: 0,0:06:23.87,0:06:24.50,Main,,0,0,0,,Hayır.Dialogue: 0,0:06:24.50,0:06:25.98,Main,,0,0,0,,Söyleyeyim sana.Dialogue: 0,0:06:25.98,0:06:29.84,Main,,0,0,0,,Burası Colubo Dağı'na hükmeden eşkıyaların, Dadan Ailesi'nin sığınağı!Dialogue: 0,0:06:29.84,0:06:33.57,Main,,0,0,0,,Dağ eşkıyaları mı? Dağ eşkıyalarından nefret ederim!Dialogue: 0,0:06:35.24,0:06:40.21,Main,,0,0,0,,Kes lan velet! Zaten başımıza kaldın!Dialogue: 0,0:06:40.21,0:06:42.32,Main,,0,0,0,,Burada kalmak istemiyorsan benim için hava hoş!Dialogue: 0,0:06:42.32,0:06:44.87,Main,,0,0,0,,Defol git sokaklarda it gibi perişan ol!Dialogue: 0,0:06:44.87,0:06:46.58,Main,,0,0,0,,Biraz sakin ol patron.Dialogue: 0,0:06:46.58,0:06:48.45,Main,,0,0,0,,Karnım hala aç.Dialogue: 0,0:06:50.12,0:06:52.42,Main,,0,0,0,,Ben de et yemek istiyorum.Dialogue: 0,0:06:59.72,0:07:03.90,Main,,0,0,0,,Bunlar hep Ace'in getirdiği bizonun eti.Dialogue: 0,0:07:03.90,0:07:07.14,Main,,0,0,0,,Tadına bakalım diye bize de bir pay verdi.Dialogue: 0,0:07:07.14,0:07:09.09,Main,,0,0,0,,Dağ eşkıyalarının hayatı zordur.Dialogue: 0,0:07:09.09,0:07:12.05,Main,,0,0,0,,Yarından itibaren yoğun çalışacaksın!Dialogue: 0,0:07:12.05,0:07:16.44,Main,,0,0,0,,Temizlik, çamaşır, ayakkabı ve silahların cilalanması,Dialogue: 0,0:07:16.44,0:07:19.19,Main,,0,0,0,,hırsızlık, yağma, dolandırıcılık, ve cinayet!Dialogue: 0,0:07:19.81,0:07:24.76,Main,,0,0,0,,Unutma sana yaptırdığımız  hiçbir şeyi Garp'a söyleyemezsin!Dialogue: 0,0:07:24.76,0:07:29.46,Main,,0,0,0,,Günde bir tas pilav ve bir bardak su!Dialogue: 0,0:07:29.46,0:07:31.66,Main,,0,0,0,,Sana bu kadarını verebilirim.Dialogue: 0,0:07:31.66,0:07:36.00,Main,,0,0,0,,Diğer her şey için kendi başının çaresine bakacaksın!Dialogue: 0,0:07:36.00,0:07:36.92,Main,,0,0,0,,Tamam!Dialogue: 0,0:07:36.92,0:07:40.24,Main,,0,0,0,,"Tamam" mı?! Niye ağlayıp itiraz etmiyorsun?Dialogue: 0,0:07:40.24,0:07:44.05,Main,,0,0,0,,İtiraz etmiyorum çünkü  dedem beni bir kere ormana atmıştı,Dialogue: 0,0:07:44.05,0:07:49.51,Main,,0,0,0,,ormanda içecek su ve yiyecek kurbağalar, yılanlar ve mantarlar vardı!Dialogue: 0,0:07:49.51,0:07:52.95,Main,,0,0,0,,Ayrıca bir gün korsan olacağım,Dialogue: 0,0:07:52.95,0:07:55.00,Main,,0,0,0,,o yüzden güçlenmem lazım!Dialogue: 0,0:07:55.62,0:07:57.23,Main,,0,0,0,,-Patron! -İyi misin?!Dialogue: 0,0:07:57.23,0:07:58.62,Main,,0,0,0,,Ne yapıyorsun?!Dialogue: 0,0:07:58.62,0:08:01.20,Main,,0,0,0,,Üç deyince!Dialogue: 0,0:08:02.16,0:08:04.16,Main,,0,0,0,,Nereye gidiyor acaba?!Dialogue: 0,0:08:04.16,0:08:05.50,Main,,0,0,0,,Üç deyince!Dialogue: 0,0:08:06.91,0:08:08.69,Main,,0,0,0,,Nereye gidiyorsun?!Dialogue: 0,0:08:08.69,0:08:10.64,Main,,0,0,0,,Az önce "korsan" mı dedin?Dialogue: 0,0:08:10.64,0:08:12.50,Main,,0,0,0,,Dinlemiyor bile!Dialogue: 0,0:08:12.50,0:08:13.77,Main,,0,0,0,,Hey!Dialogue: 0,0:08:17.88,0:08:20.41,Main,,0,0,0,,Gördünüz mü? Bela bu çocuk!Dialogue: 0,0:08:20.41,0:08:23.01,Main,,0,0,0,,Bu yüzden Garp'ın torununu yanıma almak istemedim!Dialogue: 0,0:08:23.01,0:08:24.78,Main,,0,0,0,,Biraz sakin ol patron.Dialogue: 0,0:08:25.39,0:08:26.82,Main,,0,0,0,,Hey!Dialogue: 0,0:08:27.55,0:08:29.09,Main,,0,0,0,,Beklesene!Dialogue: 0,0:08:30.26,0:08:32.04,Main,,0,0,0,,Hey!Dialogue: 0,0:08:34.86,0:08:39.96,Main,,0,0,0,,Benim adım Luffy!  Tükürük olayını da unuttum gitti!Dialogue: 0,0:08:44.74,0:08:46.51,Flashbacks,,0,0,0,,Niye gülüyorsun?!Dialogue: 0,0:08:47.27,0:08:51.41,Flashbacks,,0,0,0,,Alt tarafı üzerime biraz içki döküldü. O kadar da sinirlenecek bir şey yok.Dialogue: 0,0:08:51.41,0:08:54.89,Main,,0,0,0,,Sinirlenecek bir şey yok. Gel arkadaş olalım!Dialogue: 0,0:08:55.51,0:08:56.88,Main,,0,0,0,,Bir yere mi gidiyorsun?!Dialogue: 0,0:09:04.39,0:09:06.66,Main,,0,0,0,,Çıkmaz yol!Dialogue: 0,0:10:00.45,0:10:04.00,Main,,0,0,0,,Hey! Ace geri döndü!Dialogue: 0,0:10:04.00,0:10:05.92,Main,,0,0,0,,Yemek getirmiş!Dialogue: 0,0:10:07.54,0:10:10.23,Main,,0,0,0,,Ace, yalnız mı döndün?Dialogue: 0,0:10:10.23,0:10:13.97,Main,,0,0,0,,Luffy nerede? Senin yanında sanıyordum.Dialogue: 0,0:10:13.96,0:10:15.01,Main,,0,0,0,,Bilmiyorum.Dialogue: 0,0:10:16.90,0:10:20.70,Main,,0,0,0,,-Biraz kendine gel patron! -Ne dedin?!Dialogue: 0,0:10:20.70,0:10:24.46,Main,,0,0,0,,Diyorum ki  onu ilk günden kaybetmemiz olacak iş değil!Dialogue: 0,0:10:24.46,0:10:27.97,Main,,0,0,0,,Kimin umrunda! Ölürse ölsün!Dialogue: 0,0:10:28.52,0:10:33.19,Main,,0,0,0,,Ace'den de umudu çoktan kestim!Dialogue: 0,0:10:33.96,0:10:39.30,Main,,0,0,0,,Yaşayıp yaşamaması umrumda bile değil.  Garp'a kaza olduğunu söylerim.Dialogue: 0,0:10:39.30,0:10:43.36,Main,,0,0,0,,Dedikleri doğruymuş, Şeytan'ın çocuğu Şeytan'ın şansını da miras alıyor!Dialogue: 0,0:10:43.36,0:10:45.67,Main,,0,0,0,,O Şeytan'ın çocuğu!Dialogue: 0,0:10:46.28,0:10:52.71,Main,,0,0,0,,Hükümet bunu öğrenirse bize ne yaparlar sence?!Dialogue: 0,0:10:52.71,0:10:54.50,Main,,0,0,0,,Sakin ol, patron.Dialogue: 0,0:10:54.50,0:10:58.48,Main,,0,0,0,,Çok fazla içiyorsun!Dialogue: 0,0:11:00.69,0:11:02.45,Narrator,,0,0,0,,1 hafta sonra...Dialogue: 0,0:11:02.99,0:11:05.29,Main,,0,0,0,,Patron! Patron Dadan!Dialogue: 0,0:11:05.29,0:11:08.09,Main,,0,0,0,,Kim o?Dialogue: 0,0:11:08.83,0:11:13.03,Main,,0,0,0,,-Sen! -Luffy geri döndü!Dialogue: 0,0:11:18.04,0:11:22.97,Main,,0,0,0,,Ölmedin mi sen! Ulan seni bastıbacak...!Dialogue: 0,0:11:22.97,0:11:24.53,Main,,0,0,0,,Sakin ol, patron.Dialogue: 0,0:11:24.53,0:11:26.82,Main,,0,0,0,,Neredeydin?!Dialogue: 0,0:11:26.82,0:11:30.18,Main,,0,0,0,,Sakin. Neredeydin ve ne yapıyordun?Dialogue: 0,0:11:30.59,0:11:34.05,Main,,0,0,0,,Kurtlar vadide beni kovalıyordu.Dialogue: 0,0:11:34.05,0:11:37.32,Main,,0,0,0,,Vadide ne yapıyordun?Dialogue: 0,0:11:39.59,0:11:43.88,Main,,0,0,0,,-Her neyse, başına bir şey gelmemiş ya. -Evet.Dialogue: 0,0:11:43.88,0:11:48.06,Main,,0,0,0,,Dönmesi iyi falan değil! Haşare geri geldi!Dialogue: 0,0:11:48.93,0:11:53.89,Main,,0,0,0,,Yat zıbar hadi! Yarın it gibi çalıştıracağım seni!Dialogue: 0,0:11:53.89,0:11:54.84,Main,,0,0,0,,Hemen mi?Dialogue: 0,0:12:03.84,0:12:04.90,Main,,0,0,0,,Günaydın!Dialogue: 0,0:12:04.90,0:12:07.78,Main,,0,0,0,,Bugün bir yere mi gidiyorsun Ace?Dialogue: 0,0:12:07.78,0:12:11.57,Main,,0,0,0,,Ben de senle geleyim! Arkadaş olalım!Dialogue: 0,0:12:12.36,0:12:13.62,Main,,0,0,0,,Bekle beni!Dialogue: 0,0:12:13.62,0:12:16.16,Main,,0,0,0,,Patron! Yine Ace'in peşinden gidiyor!Dialogue: 0,0:12:16.71,0:12:21.01,Main,,0,0,0,,Hey! Yapacak tonla işin var!Dialogue: 0,0:12:21.88,0:12:25.06,Main,,0,0,0,,Nah yaparım!Dialogue: 0,0:12:25.07,0:12:27.53,Main,,0,0,0,,Piç kurusuna bak! Dinlemiyor bile!Dialogue: 0,0:12:27.53,0:12:28.88,Main,,0,0,0,,Sakin ol, patron.Dialogue: 0,0:12:28.88,0:12:31.51,Main,,0,0,0,,-Hemen onu geri getir! -Peki efendim.Dialogue: 0,0:12:31.51,0:12:33.60,Main,,0,0,0,,Hey!Dialogue: 0,0:12:51.15,0:12:53.73,Narrator,,0,0,0,,Ace'i her seferinde kaybetmesine rağmen,Dialogue: 0,0:12:57.26,0:12:59.32,Narrator,,0,0,0,,peşinden gitmeyi hiç bırakmadı.Dialogue: 0,0:12:59.32,0:13:01.43,Main,,0,0,0,,Ace!Dialogue: 0,0:13:09.24,0:13:10.87,Narrator,,0,0,0,,1 ay geçti...Dialogue: 0,0:13:12.21,0:13:13.61,Narrator,,0,0,0,,2 ay geçti...Dialogue: 0,0:13:13.61,0:13:15.46,Main,,0,0,0,,Ace!Dialogue: 0,0:13:15.46,0:13:19.20,Narrator,,0,0,0,,Yağmur rüzgar demeden...Dialogue: 0,0:13:21.46,0:13:23.35,Main,,0,0,0,,Ace!Dialogue: 0,0:13:23.35,0:13:27.06,Narrator,,0,0,0,,Ace'in peşinden gitmekte kararlıydı.Dialogue: 0,0:13:33.16,0:13:35.44,Main,,0,0,0,,Ace!Dialogue: 0,0:13:43.38,0:13:47.08,Main,,0,0,0,,Ace! Hey!Dialogue: 0,0:13:47.08,0:13:50.85,Main,,0,0,0,,Buraya kadar geldiğine inanamıyorum. Keçi gibi inatçı.Dialogue: 0,0:13:52.79,0:13:54.00,Main,,0,0,0,,Lanet olsun!Dialogue: 0,0:13:54.89,0:13:58.97,Main,,0,0,0,,Kahretsin! Çok hızlı gidiyor, onu yine kaybettim!Dialogue: 0,0:14:00.66,0:14:01.39,Main,,0,0,0,,Ace sen misin?!Dialogue: 0,0:14:10.17,0:14:15.01,Thoughts,,0,0,0,,Bu Colubo Dağı'nın en yaman yaratığı! Hiç şansı yok!Dialogue: 0,0:14:17.58,0:14:20.15,Thoughts,,0,0,0,,Neden kaçmıyor?! Yem olacak!Dialogue: 0,0:14:21.36,0:14:24.29,Main,,0,0,0,,Dizlerimin bağı çözüldü!Dialogue: 0,0:14:24.84,0:14:26.17,Main,,0,0,0,,Ahmak!Dialogue: 0,0:15:29.72,0:15:34.54,Narrator,,0,0,0,,3 aydır süregelen kesikler, morluklar ve sonu gelmez takiplerin sonucu...Dialogue: 0,0:15:41.63,0:15:43.78,Main,,0,0,0,,Ormanın sonu.Dialogue: 0,0:15:49.39,0:15:52.24,Main,,0,0,0,,Leş gibi kokuyor! Burası ne böyle?Dialogue: 0,0:15:53.49,0:15:58.97,Narrator,,0,0,0,,Colubo Dağı'nın kuzeyinde herkesin unuttuğu, Dadan Ailesi'nin yaşadığı bir yer vardı.Dialogue: 0,0:15:59.76,0:16:05.15,Narrator,,0,0,0,,Bırakılmış çöp yığınlarından duman yükseliyordu.Dialogue: 0,0:16:05.15,0:16:08.62,Narrator,,0,0,0,,İşe yaramaz,  unutulup gitmiş şeyler burada toplanmıştı.Dialogue: 0,0:16:09.34,0:16:15.10,Narrator,,0,0,0,,Burada yaşayanlar krallıklarından sürgün edilmiş kanunsuz tiplerdi.Dialogue: 0,0:16:15.10,0:16:18.00,Narrator,,0,0,0,,Kanunların işlemediği bir yerdi.Dialogue: 0,0:16:18.71,0:16:22.72,Narrator,,0,0,0,,Suçun ve hastalıkların kol gezdiği bir bölgeydi.Dialogue: 0,0:16:22.72,0:16:26.30,Narrator,,0,0,0,,Burası Gri Terminal.Dialogue: 0,0:16:26.83,0:16:28.85,Main,,0,0,0,,Hazine... Hazine...Dialogue: 0,0:16:28.85,0:16:31.65,Main,,0,0,0,,Burada para edecek hiçbir şey yok.Dialogue: 0,0:16:33.94,0:16:35.83,Main,,0,0,0,,İnci buldum!Dialogue: 0,0:16:35.83,0:16:37.48,Main,,0,0,0,,Ver onu bana!Dialogue: 0,0:16:37.48,0:16:38.84,Main,,0,0,0,,Hayır, o benim!Dialogue: 0,0:16:38.84,0:16:40.71,Main,,0,0,0,,Dalga mı geçiyorsun! Ben buldum!Dialogue: 0,0:16:40.71,0:16:43.00,Main,,0,0,0,,Dokunmayın lan şerefsizler!Dialogue: 0,0:16:43.00,0:16:45.73,Main,,0,0,0,,Alayım da çarşıda okutayım!Dialogue: 0,0:16:45.73,0:16:46.98,Main,,0,0,0,,Benim bu!Dialogue: 0,0:16:46.98,0:16:48.39,Main,,0,0,0,,Bekle!Dialogue: 0,0:16:57.35,0:16:58.33,Main,,0,0,0,,Kahretsin!Dialogue: 0,0:16:58.33,0:16:59.01,Main,,0,0,0,,Onu bana ver!Dialogue: 0,0:17:01.55,0:17:05.86,Main,,0,0,0,,Onu bana verseydin canın yanmayacaktı.Dialogue: 0,0:17:06.65,0:17:08.67,Main,,0,0,0,,Eline sağlık!Dialogue: 0,0:17:08.67,0:17:09.87,Main,,0,0,0,,Dur lan...Dialogue: 0,0:17:09.87,0:17:10.89,Main,,0,0,0,,Dalga mı geçiyorsun?!Dialogue: 0,0:17:13.46,0:17:15.29,Main,,0,0,0,,Hırsız!Dialogue: 0,0:17:21.31,0:17:22.25,Main,,0,0,0,,Çekil yolumdan velet!Dialogue: 0,0:17:23.96,0:17:27.52,Main,,0,0,0,,Çekil dedim! Çekil yoksa...Dialogue: 0,0:17:27.52,0:17:29.87,Main,,0,0,0,,Bu tarafa doğru gitti!Dialogue: 0,0:17:35.49,0:17:37.55,Main,,0,0,0,,Sabo! Sabo, orada mısın?Dialogue: 0,0:17:40.28,0:17:42.02,Main,,0,0,0,,Oh, Ace!Dialogue: 0,0:17:42.59,0:17:44.57,Main,,0,0,0,,Kusura bakma gectiktim.Dialogue: 0,0:17:44.57,0:17:46.16,Main,,0,0,0,,Evet geciktin!Dialogue: 0,0:17:46.49,0:17:49.48,Main,,0,0,0,,Sen gelene kadar şehirde birkaç işi hallettim bile.Dialogue: 0,0:17:46.75,0:17:51.29,Captions,,0,0,0,,Sabo   (10 yaşında)         (Gri Terminal'de yaşayan bir çocuk)Dialogue: 1,0:17:46.75,0:17:51.29,Captions,,0,0,0,,Sabo   (10 yaşında)         (Gri Terminal'de yaşayan bir çocuk)Dialogue: 0,0:17:52.15,0:17:55.20,Main,,0,0,0,,Gerçekten mi? Aslına bakarsan ben de.Dialogue: 0,0:17:55.20,0:17:57.00,Main,,0,0,0,,Hadi bakalım!Dialogue: 0,0:17:57.00,0:18:00.63,Main,,0,0,0,,Harika! Benden bile fazla toplamışsın!Dialogue: 0,0:18:00.63,0:18:03.35,Main,,0,0,0,,Bu çok fazla! Nereden buldun bu kadarını?Dialogue: 0,0:18:03.81,0:18:07.41,Main,,0,0,0,,Ana kapının oradaki birkaç serseriden çaldım.Dialogue: 0,0:18:07.85,0:18:10.67,Main,,0,0,0,,Kahretsin! Yine sen kazandın.Dialogue: 0,0:18:11.23,0:18:13.19,Main,,0,0,0,,Kimin kazandığının bir önemi yok öyle değil mi?Dialogue: 0,0:18:14.01,0:18:16.62,Main,,0,0,0,,Korsan sermayesini bir gün beraber harcayacağız.Dialogue: 0,0:18:16.62,0:18:19.66,Main,,0,0,0,,5 yılı geçti biriktirmeye başlayalı değil mi?Dialogue: 0,0:18:22.71,0:18:23.73,Main,,0,0,0,,Bunun için çok çalıştık.Dialogue: 0,0:18:25.29,0:18:26.70,Main,,0,0,0,,Aynen öyle!Dialogue: 0,0:18:27.74,0:18:32.49,Main,,0,0,0,,Doğu Mavi'yi terkedip buradaki hödüklerin tahmin bile edemeyeceği bir dünyayı görmek...Dialogue: 0,0:18:32.50,0:18:35.24,Main,,0,0,0,,Düşüncesi bile tüylerimi diken diken ediyor!Dialogue: 0,0:18:42.32,0:18:45.51,Main,,0,0,0,,Acele et de kapağı kapat. Kimin izlediğini bilemeyiz.Dialogue: 0,0:18:45.51,0:18:49.88,Main,,0,0,0,,Acaba bir korsan gemisi için  ne kadar biriktirmemiz gerekiyor?Dialogue: 0,0:18:49.87,0:18:53.71,Main,,0,0,0,,Kim bilir... Yüzbinler, belki de milyonlar...Dialogue: 0,0:18:53.71,0:18:55.31,Main,,0,0,0,,Ne olursa olsun daha yolumuz uzun.Dialogue: 0,0:18:55.31,0:18:56.79,Main,,0,0,0,,Korsan gemisi mi?!Dialogue: 0,0:18:57.39,0:19:01.36,Main,,0,0,0,,Siz korsan mı olacaksınız?!Dialogue: 0,0:19:01.36,0:19:03.80,Main,,0,0,0,,Ben de!Dialogue: 0,0:19:03.80,0:19:05.03,Main,,0,0,0,,Hey!Dialogue: 0,0:19:14.87,0:19:16.46,Main,,0,0,0,,Sessiz ol!Dialogue: 0,0:19:19.52,0:19:23.64,Main,,0,0,0,,Ace! her gün buraya mı geliyordun?Dialogue: 0,0:19:23.64,0:19:24.85,Main,,0,0,0,,Kes sesini.Dialogue: 0,0:19:25.26,0:19:28.69,Main,,0,0,0,,Luffy diye bahsettiğin karın ağrısı bu mu?Dialogue: 0,0:19:29.62,0:19:31.32,Main,,0,0,0,,Ona benden mi bahsettin?Dialogue: 0,0:19:31.32,0:19:33.85,Main,,0,0,0,,Evet ne kadar yapışkan olduğundan yakınıyordum!Dialogue: 0,0:19:33.85,0:19:37.70,Main,,0,0,0,,Ve ne kadar düşünmeden hareket ettiğinden!Dialogue: 0,0:19:38.42,0:19:39.42,Main,,0,0,0,,Anladım!Dialogue: 0,0:19:39.42,0:19:42.67,Main,,0,0,0,,Onu aşağıladığımızı anlamıyor mu?Dialogue: 0,0:19:42.67,0:19:45.64,Main,,0,0,0,,Sonunda buraya kadar geldi.Dialogue: 0,0:19:45.64,0:19:48.54,Main,,0,0,0,,Normal insanların geçebileceği  yolları kullanmama rağmen...Dialogue: 0,0:19:48.54,0:19:51.29,Main,,0,0,0,,Hey sen! Ace'in arkadaşı mısın?Dialogue: 0,0:19:51.29,0:19:52.88,Main,,0,0,0,,Benim de arkadaşım ol?Dialogue: 0,0:19:52.88,0:19:56.55,Main,,0,0,0,,Kes sesini ve bana sen diye hitap etmeyi bırak! Birbirimizi tanımıyoruz bile!Dialogue: 0,0:19:56.55,0:19:58.40,Main,,0,0,0,,O zaman ismin ne?Dialogue: 0,0:19:58.40,0:19:59.20,Main,,0,0,0,,Sa-Dialogue: 0,0:19:59.20,0:20:00.04,Main,,0,0,0,,Sö-Söylemeyeceğim!Dialogue: 0,0:20:00.82,0:20:04.18,Main,,0,0,0,,Bu yüzden burada yaşamalısın diyorum sana!Dialogue: 0,0:20:04.18,0:20:08.10,Main,,0,0,0,,Her gün gidip gelmen ve ormanda eğitim yapman başımıza bela oldu!Dialogue: 0,0:20:08.76,0:20:10.01,Main,,0,0,0,,Ne yapacağız?Dialogue: 0,0:20:11.40,0:20:13.64,Main,,0,0,0,,Artık sırrımızı biliyor.Dialogue: 0,0:20:13.64,0:20:16.66,Main,,0,0,0,,Eğer bırakırsak herkese söyler.Dialogue: 0,0:20:23.26,0:20:24.30,Main,,0,0,0,,Öldürelim.Dialogue: 0,0:20:24.30,0:20:26.20,Main,,0,0,0,,Evet. İyi fikir.Dialogue: 0,0:20:31.09,0:20:33.48,Main,,0,0,0,,Öldürmeyin beni!Dialogue: 0,0:20:33.48,0:20:35.45,Main,,0,0,0,,Yardım edin!Dialogue: 0,0:20:35.45,0:20:36.88,Main,,0,0,0,,Ölmek istemiyorum!Dialogue: 0,0:20:36.88,0:20:38.82,Main,,0,0,0,,Aptal! Sessiz ol!Dialogue: 0,0:20:38.82,0:20:41.29,Main,,0,0,0,,Sabo! Acele et de bitir işiini!Dialogue: 0,0:20:41.29,0:20:43.22,Main,,0,0,0,,Niye ben yapıyormuşum?! Sen öldür!Dialogue: 0,0:20:43.22,0:20:45.54,Main,,0,0,0,,Daha önce kimseyi öldürmedim!Dialogue: 0,0:20:45.54,0:20:48.47,Main,,0,0,0,,Ben de öldürmedim! Nasıl yapılacağını bilmiyorum!Dialogue: 0,0:20:48.47,0:20:51.41,Main,,0,0,0,,Lütfen beni suya atmayın!Dialogue: 0,0:20:51.41,0:20:52.85,Main,,0,0,0,,Evet! Irmak!Dialogue: 0,0:20:52.85,0:20:55.30,Main,,0,0,0,,Niye bize söyledi ki?Dialogue: 0,0:20:55.30,0:20:56.33,Main,,0,0,0,,Malın teki çünkü!Dialogue: 0,0:20:56.33,0:20:58.87,Main,,0,0,0,,Yardım edin!Dialogue: 0,0:20:58.87,0:21:00.52,Main,,0,0,0,,Kes sesini!Dialogue: 0,0:21:02.71,0:21:04.92,Main,,0,0,0,,Ölmek istemiyorum!Dialogue: 0,0:21:05.46,0:21:08.81,Main,,0,0,0,,Ormandan bir ses geldi. Çocuk sesi!Dialogue: 0,0:21:08.81,0:21:11.18,Main,,0,0,0,,Olamaz! Biri geliyor!Dialogue: 0,0:21:11.18,0:21:13.40,Main,,0,0,0,,Hadi çözelim onu!Dialogue: 0,0:21:13.40,0:21:16.19,Main,,0,0,0,,Eğer buradan gitmezsek hazinemizi bulurlar!Dialogue: 0,0:21:18.91,0:21:22.56,Main,,0,0,0,,Ace ve Sabo denen veletlerin buralarda adı bilinir.Dialogue: 0,0:21:23.68,0:21:28.34,Captions,,0,0,0,,Porchemy        Bluejam KorsanlarıDialogue: 1,0:21:23.68,0:21:28.34,Captions,,0,0,0,,Porchemy        Bluejam KorsanlarıDialogue: 0,0:21:23.60,0:21:25.89,Main,,0,0,0,,Paramızı çalanın...Dialogue: 0,0:21:25.89,0:21:28.35,Main,,0,0,0,,Ace olduğuna emin misin?Dialogue: 0,0:21:28.35,0:21:32.99,Main,,0,0,0,,Evet, bu çok utanç verici. Tedbiri elden bıraktık.Dialogue: 0,0:21:32.99,0:21:35.08,Main,,0,0,0,,Bu çocuk gerçekten inanılmaz!Dialogue: 0,0:21:35.08,0:21:38.02,Main,,0,0,0,,Bizim paramızı çalması olacak iş değil!Dialogue: 0,0:21:38.58,0:21:43.66,Main,,0,0,0,,Kaptan Bluejam bunu duyarsa boku yedik demektir!Dialogue: 0,0:21:45.32,0:21:50.09,Main,,0,0,0,,Kahretsin! Bu haydutlar Bluejam'in adamları mıymış?Dialogue: 0,0:21:50.09,0:21:53.10,Main,,0,0,0,,Haydutlar mı? Parayı bunlardan mı çaldın yani?Dialogue: 0,0:21:53.81,0:21:56.63,Main,,0,0,0,,Bu paranın peşini bırakmayacaklar gibi duruyor.Dialogue: 0,0:21:56.64,0:22:00.64,Main,,0,0,0,,Kılıçlı olan Bluejam'in adamı, Porchemy.Dialogue: 0,0:22:01.38,0:22:04.41,Main,,0,0,0,,Kafayı kırmış derler. Duymuş muydun?Dialogue: 0,0:22:05.48,0:22:09.65,Main,,0,0,0,,Dövdüğü adamların  diri diri kafa derilerini yüzüyormuş!Dialogue: 0,0:22:13.54,0:22:16.32,Main,,0,0,0,,Gizlenmemiz lazım.Dialogue: 0,0:22:17.82,0:22:19.36,Main,,0,0,0,,Ha? Nereye gitti?Dialogue: 0,0:22:22.13,0:22:23.97,Main,,0,0,0,,Bırak beni! Napıyorsun?Dialogue: 0,0:22:23.97,0:22:26.14,Thoughts,,0,0,0,,Nasıl yakalandı?!Dialogue: 0,0:22:26.80,0:22:28.45,Main,,0,0,0,,Kim bu velet?Dialogue: 0,0:22:28.45,0:22:29.64,Main,,0,0,0,,Yardım edin!Dialogue: 0,0:22:29.64,0:22:31.26,Main,,0,0,0,,Ace!Dialogue: 0,0:22:32.82,0:22:35.25,Main,,0,0,0,,Lütfen kurtar beni, Ace!Dialogue: 0,0:22:35.25,0:22:38.39,Main,,0,0,0,,Aptal! İsmimi verdi!Dialogue: 0,0:22:40.21,0:22:42.12,Main,,0,0,0,,Ace mi dedin sen?Dialogue: 0,0:22:43.42,0:22:44.19,Main,,0,0,0,,Evet, ne var?Dialogue: 0,0:22:44.19,0:22:47.39,Main,,0,0,0,,Ace'i tanıyor musun?Dialogue: 0,0:22:48.86,0:22:50.20,Main,,0,0,0,,Arkadaşım o benim!Dialogue: 0,0:22:51.11,0:22:53.70,Main,,0,0,0,,Ah, ama az önce beni öldürecekti.Dialogue: 0,0:22:55.36,0:22:58.27,Main,,0,0,0,,Susmak bilmiyor!Dialogue: 0,0:22:58.82,0:23:00.69,Main,,0,0,0,,Sana bir sorum var.Dialogue: 0,0:23:00.69,0:23:05.97,Main,,0,0,0,,Bugün erken saatlerde Ace paramı çaldı ve kaçtı.Dialogue: 0,0:23:05.97,0:23:09.21,Main,,0,0,0,,Paranın nerede olduğunu biliyor musun?Dialogue: 0,0:23:13.59,0:23:16.84,Main,,0,0,0,,Lanet olsun! Bütün hazinemize çökecekler!Dialogue: 0,0:23:16.84,0:23:19.18,Main,,0,0,0,,Umarım bu salak onlara bir şey söylemez!Dialogue: 0,0:23:28.65,0:23:31.60,Main,,0,0,0,,Bilmiyorum.Dialogue: 0,0:23:32.44,0:23:34.17,Thoughts,,0,0,0,,Ne berbat bir yalancı!Dialogue: 0,0:23:38.36,0:23:42.47,Main,,0,0,0,,Peki o zaman. Öyle diyorsan öyledir.Dialogue: 0,0:23:45.60,0:23:49.25,Main,,0,0,0,,Hiç endişelenme, hatırlamana yardımcı olacağım!Dialogue: 0,0:23:50.52,0:23:53.54,Main,,0,0,0,,Napıyorsunuz lan?! Bırakın beni!  Nereye götürüyorsunuz beni?!Dialogue: 0,0:23:53.54,0:23:56.39,Main,,0,0,0,,Lanet olsun! Aptal! Bırak beni!Dialogue: 0,0:23:56.39,0:23:57.70,Main,,0,0,0,,Aptal!Dialogue: 0,0:23:58.28,0:23:59.67,Main,,0,0,0,,Ne yapacağız?Dialogue: 0,0:23:59.67,0:24:02.40,Main,,0,0,0,,Ne mi yapacağız? Şöyle ki...Dialogue: 0,0:24:10.74,0:24:12.41,Main,,0,0,0,,Bırakın beni!Dialogue: 0,0:24:12.41,0:24:14.41,Main,,0,0,0,,Size hiçbir şey söylemeyeceğim!Dialogue: 0,0:24:22.72,0:24:24.75,Main,,0,0,0,,Bacaksız velet!Dialogue: 0,0:24:38.84,0:24:42.44,Main,,0,0,0,,Dedim sana, Lastik gibiyim çünkü  Gomu Gomu no Mi'yi yedim!Dialogue: 0,0:24:42.96,0:24:44.33,Main,,0,0,0,,Sessiz olun!Dialogue: 0,0:24:45.51,0:24:47.65,Main,,0,0,0,,Şeytan meyvesi ha?Dialogue: 0,0:24:49.08,0:24:51.52,Main,,0,0,0,,Çetin ceviz çıktın.Dialogue: 0,0:24:53.62,0:24:55.50,Main,,0,0,0,,Eldivenlerimi getirin.Dialogue: 0,0:24:56.17,0:24:57.15,Main,,0,0,0,,E-Emredersiniz!Dialogue: 0,0:24:57.15,0:25:01.35,Main,,0,0,0,,Çabuk! Acele et! Eğer Porchemy ve diğerleri geri gelirse işimiz bitti demektir!Dialogue: 0,0:25:01.35,0:25:04.28,Main,,0,0,0,,Hazineyi hemen başka bir yere taşımamız lazım!Dialogue: 0,0:25:04.88,0:25:08.32,Main,,0,0,0,,Luffy'nin ağzından baklayı çıkarması an meselesi!Dialogue: 0,0:25:08.32,0:25:11.69,Main,,0,0,0,,Eğer bunu bulurlarsa sadece onlardan çaldığımız parayı almazlar,Dialogue: 0,0:25:11.69,0:25:15.89,Main,,0,0,0,,5 yılda biriktirdiğimiz her kuruşu alırlar!Dialogue: 0,0:25:21.35,0:25:26.09,Main,,0,0,0,,Dinle velet! Ace'in çaldığı para...Dialogue: 0,0:25:26.09,0:25:29.07,Main,,0,0,0,,tayfamız için önemli bir paraydı!Dialogue: 0,0:25:29.88,0:25:32.38,Main,,0,0,0,,Ve sen nereye sakladıklarnı biliyorsun!Dialogue: 0,0:25:32.38,0:25:34.88,Main,,0,0,0,,Seni konuşturmasını bilirim!Dialogue: 0,0:25:36.26,0:25:37.05,Main,,0,0,0,,Asla!Dialogue: 0,0:25:45.79,0:25:46.77,Main,,0,0,0,,Ne acımıştır be!Dialogue: 0,0:25:50.93,0:25:53.91,Main,,0,0,0,,Bir korsanı kızdırmamalısın!Dialogue: 0,0:25:54.33,0:25:59.04,Main,,0,0,0,,Kaptanımız Bluejam  insanlıktan çıkmış merhametsiz biridir!Dialogue: 0,0:26:06.56,0:26:10.75,Main,,0,0,0,,Çok acıdı! Korkuyorum! Yardım edin!Dialogue: 0,0:26:13.05,0:26:15.92,Main,,0,0,0,,Gidin Ace'i ve Sabo'yu arayın!Dialogue: 0,0:26:15.92,0:26:18.52,Main,,0,0,0,,Öyle dikilmeye vaktimiz yok!Dialogue: 0,0:26:18.52,0:26:19.33,Main,,0,0,0,,Emredersiniz!Dialogue: 0,0:26:27.95,0:26:31.01,Main,,0,0,0,,Ace ve Sabo nerede bilmek mi istiyorsun?Dialogue: 0,0:26:31.01,0:26:34.15,Main,,0,0,0,,Siz mahallenin çocuk suçlularını mı arıyorsunuz?Dialogue: 0,0:26:34.80,0:26:37.75,Main,,0,0,0,,O ikisine bulaşmasanız iyi olur.Dialogue: 0,0:26:38.62,0:26:41.31,Main,,0,0,0,,Çocuklar diye onları hafife almayın!Dialogue: 0,0:26:41.31,0:26:44.28,Main,,0,0,0,,Onlar kuduz köpek gibidirler, kaplan bile avlarlar!Dialogue: 0,0:26:44.28,0:26:47.57,Main,,0,0,0,,Ace and Sabo, ha? Onları görmedim.Dialogue: 0,0:26:48.24,0:26:50.84,Main,,0,0,0,,Onu bırak da kanka,Dialogue: 0,0:26:50.84,0:26:53.79,Main,,0,0,0,,üstündeki değerleri şeyleri ver bakalım.Dialogue: 0,0:26:53.79,0:26:55.49,Main,,0,0,0,,Y-yapma!Dialogue: 0,0:26:55.49,0:26:57.47,Main,,0,0,0,,Gidip başka yerde arayalım!Dialogue: 0,0:27:00.63,0:27:02.64,Main,,0,0,0,,Güneş batıyor.Dialogue: 0,0:27:03.30,0:27:05.31,Main,,0,0,0,,Tamamdır, hallettim!Dialogue: 0,0:27:05.31,0:27:07.65,Main,,0,0,0,,Bütün hazineyi taşıdık!Dialogue: 0,0:27:11.46,0:27:13.10,Main,,0,0,0,,Ace!Dialogue: 0,0:27:13.10,0:27:15.00,Main,,0,0,0,,Sabo, sorun nedir?Dialogue: 0,0:27:15.00,0:27:17.05,Main,,0,0,0,,Parayı aramaya eski mekana mı gitmişler?Dialogue: 0,0:27:19.60,0:27:21.75,Main,,0,0,0,,Hayır.Dialogue: 0,0:27:22.24,0:27:24.12,Main,,0,0,0,,Nereye gideceklerini bilmelerine imkan yok!Dialogue: 0,0:27:25.01,0:27:25.92,Main,,0,0,0,,Ne demek istiyorsun?Dialogue: 0,0:27:25.92,0:27:28.33,Main,,0,0,0,,Luffy denen eleman...Dialogue: 0,0:27:29.36,0:27:31.66,Main,,0,0,0,,hala onlara bir şey söylememiş!Dialogue: 0,0:27:33.26,0:27:36.16,Main,,0,0,0,,Ona işkence ediyor olmalılar.Dialogue: 0,0:27:36.16,0:27:40.34,Main,,0,0,0,,Aptal bebenin teki olduğu için hemen dökülür diye düşünmüştüm.Dialogue: 0,0:27:40.34,0:27:41.67,Main,,0,0,0,,Bu hiç aklıma yatmıyor!Dialogue: 0,0:27:43.77,0:27:45.38,Main,,0,0,0,,Bu gidişle...Dialogue: 0,0:27:52.95,0:27:57.23,Captions,,0,0,0,,Gri Terminal         Korsan KoyuDialogue: 1,0:27:52.95,0:27:57.23,Captions,,0,0,0,,Gri Terminal         Korsan KoyuDialogue: 0,0:27:54.39,0:27:57.22,Main,,0,0,0,,Geciktiler...Dialogue: 0,0:27:57.22,0:27:59.99,Main,,0,0,0,,Hazineden kim sorumluydu?Dialogue: 0,0:28:00.59,0:28:03.89,Main,,0,0,0,,Porchemy, Kaptan Bluejam.Dialogue: 0,0:28:04.61,0:28:06.86,Main,,0,0,0,,Akşam oldu bile.Dialogue: 0,0:28:10.57,0:28:14.27,Main,,0,0,0,,Çoktan nakite çevirip dönmüş olmaları gerekiyordu.Dialogue: 0,0:28:14.86,0:28:18.97,Main,,0,0,0,,Sence o piç parayı alıp kaçtı mı?Dialogue: 0,0:28:15.00,0:28:18.97,Captions,,0,0,0,,Kaptan Bluejam         Bluejam KorsanlarıDialogue: 1,0:28:15.00,0:28:18.97,Captions,,0,0,0,,Kaptan Bluejam         Bluejam KorsanlarıDialogue: 0,0:28:18.97,0:28:21.05,Main,,0,0,0,,Hayır, imkanı yok!Dialogue: 0,0:28:21.05,0:28:24.52,Main,,0,0,0,,Eminim canına susamamıştır!Dialogue: 0,0:28:26.14,0:28:27.99,Main,,0,0,0,,Haklısın.Dialogue: 0,0:28:32.69,0:28:35.76,Main,,0,0,0,,Öt artık!Dialogue: 0,0:28:40.07,0:28:41.13,Main,,0,0,0,,Porchemy-san!Dialogue: 0,0:28:41.71,0:28:44.00,Main,,0,0,0,,Yeter artık!Dialogue: 0,0:28:46.78,0:28:50.04,Main,,0,0,0,,Bağıracak gücü bile kalmadı artık!Dialogue: 0,0:28:54.68,0:29:00.44,Main,,0,0,0,,Bir şey söyleyeceği yok ve  artık bu yaptığımız çok acımasızca!Dialogue: 0,0:29:00.44,0:29:03.25,Main,,0,0,0,,Bırakalım gitsin artık!Dialogue: 0,0:29:05.70,0:29:09.77,Main,,0,0,0,,Eğer bu velet için endişelenecek vaktin varsa git Ace ve Sabo'yu ara!Dialogue: 0,0:29:10.25,0:29:14.10,Main,,0,0,0,,Bizim hayatlarımız tehlikede! Anlamıyor musun?!Dialogue: 0,0:29:14.10,0:29:19.74,Main,,0,0,0,,Kaptan Bluejam'e parayı teslim etmemiz gereken zaman çoktan geçti!Dialogue: 0,0:29:24.50,0:29:28.84,Main,,0,0,0,,Zavallı çocuk. Şehirin şerifini çağırsak mı?Dialogue: 0,0:29:28.84,0:29:32.78,Main,,0,0,0,,Faydası yok. Burada kanunlar geçmez.Dialogue: 0,0:29:32.78,0:29:36.72,Main,,0,0,0,,Ayrıca o adam Bluejam'in tayfasında.Dialogue: 0,0:29:36.72,0:29:39.36,Main,,0,0,0,,Soylulara rüşvet veriyorlar!Dialogue: 0,0:29:39.36,0:29:44.37,Main,,0,0,0,,Ne suç işlerlerse işlesinler, birini öldürseler bile kimse onlara dokunmaz!Dialogue: 0,0:29:45.00,0:29:49.81,Main,,0,0,0,,Öldürdüklerinin cesetlerini buraya  yığsalar bile kimse aldırmaz!Dialogue: 0,0:29:51.00,0:29:53.00,Main,,0,0,0,,Cevap ver!Dialogue: 0,0:29:54.07,0:29:55.68,Main,,0,0,0,,Hayır!Dialogue: 0,0:29:56.31,0:30:01.38,Main,,0,0,0,,Lanet olası velet! Konuş artık!Dialogue: 0,0:30:05.16,0:30:07.77,Main,,0,0,0,,Konuş!Dialogue: 0,0:30:10.05,0:30:11.79,Main,,0,0,0,,Hayır.Dialogue: 0,0:30:12.64,0:30:13.99,Main,,0,0,0,,Konuşmayacağım!Dialogue: 0,0:30:14.65,0:30:16.27,Main,,0,0,0,,Söylemeyeceğim!Dialogue: 0,0:30:19.81,0:30:21.62,Main,,0,0,0,,Söylemeyeceğim!Dialogue: 0,0:30:24.12,0:30:26.07,Main,,0,0,0,,Pekala. Artık benden günah gitti!Dialogue: 0,0:30:44.72,0:30:46.15,Main,,0,0,0,,Geber.Dialogue: 0,0:30:49.16,0:30:52.55,Main,,0,0,0,,Dur!Dialogue: 0,0:30:57.80,0:30:58.70,Main,,0,0,0,,Çekil yolumdan!Dialogue: 0,0:31:01.81,0:31:06.98,Main,,0,0,0,,-Bu o, Porchemy-san! -Paramızı çalan bu! Lanet olası!Dialogue: 0,0:31:06.98,0:31:08.05,Main,,0,0,0,,Ne?Dialogue: 0,0:31:08.05,0:31:10.31,Main,,0,0,0,,A-Ace!Dialogue: 0,0:31:15.76,0:31:19.50,Main,,0,0,0,,Buraya gelerek işimizi kolaylaştırdınız!Dialogue: 0,0:31:19.50,0:31:23.51,Main,,0,0,0,,Arkadaşınızı konuşturmakta zorlanıyorduk.Dialogue: 0,0:31:23.51,0:31:24.54,Main,,0,0,0,,Ace!Dialogue: 0,0:31:24.54,0:31:26.82,Main,,0,0,0,,B-bırak beni!Dialogue: 0,0:31:26.82,0:31:28.44,Main,,0,0,0,,Sabo!Dialogue: 0,0:31:32.20,0:31:33.50,Main,,0,0,0,,Porchemy-san!Dialogue: 0,0:31:36.11,0:31:38.51,Main,,0,0,0,,Ace! Sabo!Dialogue: 0,0:31:38.51,0:31:42.05,Main,,0,0,0,,Acıttı. Hey!Dialogue: 0,0:31:43.97,0:31:47.96,Main,,0,0,0,,Yetişkinlere bulaşırsan ne olur biliyor musun?!Dialogue: 0,0:31:48.65,0:31:52.26,Main,,0,0,0,,Seninle ben dövüşeceğim! Sabo, ona yardım et!Dialogue: 0,0:31:52.26,0:31:53.36,Main,,0,0,0,,Ace!Dialogue: 0,0:31:54.52,0:31:57.53,Main,,0,0,0,,Kılıcı var! Dikkatli ol!Dialogue: 0,0:32:10.04,0:32:11.34,Main,,0,0,0,,Oh, bıçağı var!Dialogue: 0,0:32:11.80,0:32:13.48,Main,,0,0,0,,Porchemy-san, bu çocuk...Dialogue: 0,0:32:16.95,0:32:18.95,Main,,0,0,0,,Gidelim, Ace!Dialogue: 0,0:32:18.95,0:32:20.28,Main,,0,0,0,,Siz gidin!Dialogue: 0,0:32:20.81,0:32:23.35,Main,,0,0,0,,Aptal! Gelsene!Dialogue: 0,0:32:23.92,0:32:28.13,Main,,0,0,0,,Biriyle yüzleştiğim zaman, asla kaçmam!Dialogue: 0,0:32:28.13,0:32:30.74,Main,,0,0,0,,Ne dedin sen?! Seni bacaksız velet!Dialogue: 0,0:32:30.74,0:32:34.34,Main,,0,0,0,,Yapma! O bu şehirdeki haydutlar gibi değil!Dialogue: 0,0:32:34.81,0:32:36.70,Main,,0,0,0,,Doğru dedin!Dialogue: 0,0:32:36.70,0:32:41.76,Main,,0,0,0,,Pekala! Bu kadar oyun oynadığımız yeter!  O bizim paramız.Dialogue: 0,0:32:41.76,0:32:44.55,Main,,0,0,0,,Kesin de paramızı efendi gibi geri verin veletler!Dialogue: 0,0:32:44.55,0:32:47.05,Main,,0,0,0,,Size kim emir veriyor da bizden çaldınız?Dialogue: 0,0:32:47.05,0:32:50.11,Main,,0,0,0,,Parayı geri ver yoksa pişman olursun.Dialogue: 0,0:32:52.47,0:32:55.39,Main,,0,0,0,,O para için daha başka planlarımız var!Dialogue: 0,0:32:56.45,0:32:57.17,Main,,0,0,0,,Ne...Dialogue: 0,0:32:58.51,0:33:00.26,Main,,0,0,0,,Ne dedin?!Dialogue: 0,0:33:00.26,0:33:02.99,Main,,0,0,0,,Bir dakika bekle burada!Dialogue: 0,0:33:03.89,0:33:05.83,Main,,0,0,0,,Dalavereyi kesin!Dialogue: 0,0:33:10.63,0:33:14.94,Main,,0,0,0,,Çocuklara da yenileceksem korsanlığı bırakayım!Dialogue: 0,0:33:14.94,0:33:17.77,Main,,0,0,0,,-Sana korsanlığı bıraktıracağız! -Sana korsanlığı bıraktıracağız!Dialogue: 0,0:33:17.88,0:33:20.08,Main,,0,0,0,,Hepinizi öldüreceğim!Dialogue: 0,0:33:28.82,0:33:34.03,Main,,0,0,0,,Tüm hikayeyi duydum, Porchemy.  Ne kadar acınası.Dialogue: 0,0:33:34.03,0:33:37.29,Main,,0,0,0,,Gerçekten çocuklardan dayak mı yedin?Dialogue: 0,0:33:38.24,0:33:42.92,Main,,0,0,0,,Üzgünüm, Kaptan Bluejam. Para...Dialogue: 0,0:33:42.92,0:33:45.71,Main,,0,0,0,,Bakma bana! Yüzünü bile görmek istemiyorum!Dialogue: 0,0:33:57.43,0:34:00.09,Main,,0,0,0,,Bu çok kötü bir alışkanlık, Ace!Dialogue: 0,0:34:00.09,0:34:03.98,Main,,0,0,0,,Gerçek bir korsanla karşılaşınca tüymek en iyisi!Dialogue: 0,0:34:03.98,0:34:06.12,Main,,0,0,0,,Canına mı susadın sen?Dialogue: 0,0:34:06.12,0:34:09.76,Main,,0,0,0,,Bu bir garip hissettiriyor. Öncekini daha çok seviyordum.Dialogue: 0,0:34:12.03,0:34:17.90,Main,,0,0,0,,Aptalca bir hata yaptık. Bluejam tayfası bizi asla affetmeyecek.Dialogue: 0,0:34:17.90,0:34:19.34,Main,,0,0,0,,Peşimize düşecekler!Dialogue: 0,0:34:19.34,0:34:23.27,Main,,0,0,0,,Çok korkunçtu! Öleceğim sandım!Dialogue: 0,0:34:27.14,0:34:31.06,Main,,0,0,0,,Amma kafa ütüledin be! Kes sesini! Ağlamayı bırak artık!Dialogue: 0,0:34:31.06,0:34:35.49,Main,,0,0,0,,Korkakları ve ağlak bebeleri hiç sevmem!Dialogue: 0,0:34:37.63,0:34:39.23,Main,,0,0,0,,Te-teşekkürler!Dialogue: 0,0:34:42.83,0:34:43.88,Main,,0,0,0,,Sen...Dialogue: 0,0:34:45.13,0:34:47.13,Main,,0,0,0,,Sen beni kurtardın!Dialogue: 0,0:34:47.13,0:34:50.93,Main,,0,0,0,,-Sen...! -Dur, dur, sadece teşekkür ediyor.Dialogue: 0,0:34:54.39,0:34:58.40,Main,,0,0,0,,Niye en başından ötmedin ki?Dialogue: 0,0:34:58.40,0:35:02.22,Main,,0,0,0,,Onlar kadınları ve çocukları  kılları kıpırdaman öldürecek tipler!Dialogue: 0,0:35:03.19,0:35:07.83,Main,,0,0,0,,Eğer bir şey söylersem,  arkadaşım olmazsın diye düşündüm.Dialogue: 0,0:35:08.53,0:35:10.86,Main,,0,0,0,,Ölmekten iyidir, değil mi?Dialogue: 0,0:35:10.86,0:35:13.36,Main,,0,0,0,,Arkadaşım olmayı niye bu kadar çok istiyorsun?Dialogue: 0,0:35:15.62,0:35:16.70,Main,,0,0,0,,Çünkü...Dialogue: 0,0:35:17.22,0:35:21.66,Main,,0,0,0,,Sana bugüne kadar çektirmediğim çile kalmadı!Dialogue: 0,0:35:21.66,0:35:24.19,Main,,0,0,0,,Niye beni hala takip ediyorsun?Dialogue: 0,0:35:29.86,0:35:31.17,Main,,0,0,0,,Çünkü...Dialogue: 0,0:35:32.21,0:35:35.32,Main,,0,0,0,,Çünkü başka kimsem yok!Dialogue: 0,0:35:36.04,0:35:40.00,Main,,0,0,0,,Foosha Köyü'ne geri dönemem ve dağ eşkıyalarını sevmiyorum!Dialogue: 0,0:35:40.00,0:35:43.48,Main,,0,0,0,,Eğer seni takip etmeseydim yapayalnız kalırdım!Dialogue: 0,0:35:43.48,0:35:46.73,Main,,0,0,0,,Yalnız olmak canımın yanmasından daha acı verici!Dialogue: 0,0:35:48.46,0:35:50.59,Main,,0,0,0,,Ailen nerede?Dialogue: 0,0:35:50.59,0:35:52.33,Main,,0,0,0,,Bir tek dedem var.Dialogue: 0,0:35:54.46,0:35:56.32,Main,,0,0,0,,Yani ben yanındayken daha iyi mi hissediyorsun?Dialogue: 0,0:35:56.32,0:35:57.81,Main,,0,0,0,,Hı-hı.Dialogue: 0,0:35:57.81,0:36:00.57,Main,,0,0,0,,-Ben olmadan çok mu zor? -Hı-hı.Dialogue: 0,0:36:03.52,0:36:06.40,Flashbacks,,0,0,0,,Gold Roger'ın çocuğu varsa ne olmuş?Dialogue: 0,0:36:07.41,0:36:10.11,Flashbacks,,0,0,0,,Umarım öyle bir çocuk yoktur!Dialogue: 0,0:36:10.11,0:36:15.75,Flashbacks,,0,0,0,,Varsa da ölmesi gereken şeytan gibi bir şeydir!Dialogue: 0,0:36:21.28,0:36:24.83,Main,,0,0,0,,Yaşamamı mı istiyorsun?Dialogue: 0,0:36:28.20,0:36:29.66,Main,,0,0,0,,Tabii ki istiyorum!Dialogue: 0,0:36:31.01,0:36:32.30,Main,,0,0,0,,Anladım.Dialogue: 0,0:36:34.72,0:36:39.08,Main,,0,0,0,,Ama senin gibi şımarık çocukları sevmem.Dialogue: 0,0:36:40.99,0:36:44.12,Main,,0,0,0,,Ben şımarık değilim! Güçlüyüm!Dialogue: 0,0:36:44.12,0:36:48.65,Main,,0,0,0,,Güçlü mü?! Sen güçlü falan değilsin!  Kız gibi ağlıyorsun!Dialogue: 0,0:36:48.65,0:36:53.30,Main,,0,0,0,,Hiç dikenlerle vurdular mı sana?  Ben sadece 7 yaşındayım!Dialogue: 0,0:36:53.30,0:36:58.32,Main,,0,0,0,,Senin gibi 10 yaşıma geldiğimde, ağlamayı bırakıp daha da güçlü olacağım!Dialogue: 0,0:36:58.32,0:37:02.27,Main,,0,0,0,,7 yaşımda ben hiç ağlamıyordum ki aptal!  Ben senin gibi değilim!Dialogue: 0,0:37:02.27,0:37:05.44,Main,,0,0,0,,Ben herkesten güçlü olacağım!Dialogue: 0,0:37:05.44,0:37:09.49,Main,,0,0,0,,Shanks'a büyük bir korsan olacağıma söz verdim!Dialogue: 0,0:37:09.49,0:37:11.61,Main,,0,0,0,,-Sen? Korsan mı? -Evet!Dialogue: 0,0:37:11.61,0:37:12.78,Main,,0,0,0,,-İmkanı yok! -Var!Dialogue: 0,0:37:14.56,0:37:17.01,Main,,0,0,0,,Tamam, bu kadarı yeter!Dialogue: 0,0:37:17.66,0:37:21.99,Main,,0,0,0,,Hey, bu arada, bir sorunum var.Dialogue: 0,0:37:21.99,0:37:23.30,Main,,0,0,0,,-Ne? Sorun mu? -Hı-hı.Dialogue: 0,0:37:24.50,0:37:29.73,Main,,0,0,0,,Benim yaşadığım orman saklandıkları yere, Korsanlar Koyu'na çok yakın.Dialogue: 0,0:37:29.73,0:37:34.66,Main,,0,0,0,,Ya bitkin düşüp uyuduğumda bana saldırırlarsa?Dialogue: 0,0:37:35.91,0:37:38.04,Main,,0,0,0,,Bu yüzden yardımınıza ihtiyacım var.Dialogue: 0,0:37:53.68,0:37:58.19,Main,,0,0,0,,Ne oldu bunlara? Her yerleri bandajlı!Dialogue: 0,0:38:00.41,0:38:02.17,Main,,0,0,0,,Hey, bu...Dialogue: 0,0:38:06.63,0:38:10.20,Main,,0,0,0,,Patron! Patron! Bir sorunumuz var!Dialogue: 0,0:38:10.20,0:38:12.78,Main,,0,0,0,,Hmm? Daha çok erken. Ne oldu...Dialogue: 0,0:38:12.78,0:38:16.75,Main,,0,0,0,,Lan! Ne oluyor burada?!Dialogue: 0,0:38:16.75,0:38:18.78,Main,,0,0,0,,1, 2...Dialogue: 0,0:38:21.38,0:38:24.79,Main,,0,0,0,,Ace! Luffy! Bu kim?!Dialogue: 0,0:38:26.13,0:38:27.83,Main,,0,0,0,,Kim kim?Dialogue: 0,0:38:30.69,0:38:33.99,Main,,0,0,0,,Niye fazladan bir çocuk var?!Dialogue: 0,0:38:33.99,0:38:35.26,Main,,0,0,0,,Sen kimsin be?!Dialogue: 0,0:38:35.99,0:38:37.67,Main,,0,0,0,,Benim hakkımda mı konuşuyorsunuz?Dialogue: 0,0:38:39.11,0:38:42.43,Main,,0,0,0,,Ben Sabo! Hey, sen Dadan olmalısın!Dialogue: 0,0:38:42.43,0:38:45.71,Main,,0,0,0,,Sabo? Bu ismi daha önce duydum!Dialogue: 0,0:38:45.71,0:38:50.27,Main,,0,0,0,,Öyle mi? O zaman daha iyi! Beni buraya kabul ettiğiniz için teşekkür ederim!Dialogue: 0,0:38:51.27,0:38:54.95,Main,,0,0,0,,Duyduğuma göre sen de baş belası veledin tekiymişsin!Dialogue: 0,0:38:54.95,0:38:58.58,Main,,0,0,0,,Benim de duyduğuma göre sen beş para etmez bunağın tekiymişsin!Dialogue: 0,0:39:09.08,0:39:11.39,Main,,0,0,0,,Ace! Luffy! Sabo!Dialogue: 0,0:39:11.39,0:39:15.43,Main,,0,0,0,,Size kalacak bir yer veriyorum! Hemen çalışmaya başlamanız lazım!Dialogue: 0,0:39:16.93,0:39:19.11,Main,,0,0,0,,Teşekkürler, Dadan!Dialogue: 0,0:39:29.00,0:39:33.09,Narrator,,0,0,0,,Gri Terminal'den ayrılmak zorunda kaldıktan sonra,Dialogue: 0,0:39:33.09,0:39:35.85,Narrator,,0,0,0,,Ace'in en iyi arkadaşı Sabo da onlarla beraber yaşamaya başladı.Dialogue: 0,0:39:37.24,0:39:40.08,Narrator,,0,0,0,,Ace, Sabo ve Luffy.Dialogue: 0,0:39:41.09,0:39:43.74,Narrator,,0,0,0,,Bu üçlü beraber vakit geçirmeye başladı...Dialogue: 0,0:39:43.74,0:39:46.33,Narrator,,0,0,0,,Ormanda ve dağda yabani hayvanlarla savaştılarDialogue: 0,0:39:46.88,0:39:51.40,Narrator,,0,0,0,,Koydaki korsanlarla ve  şehirdeki holiganlarla da kapıştılar.Dialogue: 0,0:39:51.84,0:39:56.33,Narrator,,0,0,0,,Önünde sonunda  şehrin göbeğinde yaşayan insanlar bile...Dialogue: 0,0:39:56.33,0:39:58.94,Narrator,,0,0,0,,onların yaramazlıklarından haberdar hale geldi!