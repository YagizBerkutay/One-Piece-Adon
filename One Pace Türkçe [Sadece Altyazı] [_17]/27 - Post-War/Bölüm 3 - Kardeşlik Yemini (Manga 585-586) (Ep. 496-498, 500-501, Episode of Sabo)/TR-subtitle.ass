Dialogue: 0,0:12:42.01,0:12:44.78,Flashbacks,,0,0,0,,Çalışmaktan çok yoruldum, Sabo.
Dialogue: 0,0:12:45.08,0:12:48.38,Flashbacks,,0,0,0,,Eğer bunu çizecek vaktin varsa \Nders çalışacak vaktin de olmalı.
Dialogue: 0,0:12:49.71,0:12:52.65,Sign-Dad,,0,0,0,,{\fad(0,940)\fs60\blur1.2\fax0.6\frz357.5\pos(1209,261)}BABA
Dialogue: 0,0:12:58.99,0:13:00.59,Flashbacks,,0,0,0,,Hey, sen!
Dialogue: 0,0:13:01.86,0:13:06.56,Flashbacks,,0,0,0,,Ben kraliyet ailesinden geliyorum!\NBu da kral ile akrabayım demek! {I know this is stupid and redundant, but this kid's an idiot, so it suits him.}
Dialogue: 0,0:13:06.56,0:13:08.60,Flashbacks,,0,0,0,,Beni evime kadar sırtında taşı!
Dialogue: 0,0:13:14.64,0:13:16.37,Flashbacks,,0,0,0,,Bekle, seni küstah domuz!
Dialogue: 0,0:13:16.37,0:13:19.88,Flashbacks,,0,0,0,,Hey, kraliyet ailesinden gelen bir emre \Nitaatsizlik mi edeceksin?!
Dialogue: 0,0:13:20.28,0:13:22.38,Flashbacks,,0,0,0,,Bırak beni!
Dialogue: 0,0:13:28.85,0:13:31.52,Flashbacks,,0,0,0,,Sen alt tarafı soylu bir ailenin oğlusun!
Dialogue: 0,0:13:31.92,0:13:33.49,Flashbacks,,0,0,0,,Sana dersini vereceğim!
Dialogue: 0,0:13:35.06,0:13:37.46,Flashbacks,,0,0,0,,Yapma!
Dialogue: 0,0:13:43.10,0:13:47.87,Flashbacks,,0,0,0,,Kraliyet ailesinden bir çocuğa\N zarar vermek affedilir gibi değil!
Dialogue: 0,0:13:47.87,0:13:51.98,Flashbacks,,0,0,0,,Sabo! Gerçekten bu asil çocuk ile kavga mı ettin?!
Dialogue: 0,0:13:51.98,0:13:54.65,Flashbacks,,0,0,0,,Evet. Benim de canım yandı.
Dialogue: 0,0:13:54.65,0:13:57.95,Flashbacks,,0,0,0,,Bir anda bana bıçakla saldırdı...
Dialogue: 0,0:14:03.46,0:14:08.96,Flashbacks,,0,0,0,,Özür dileriz! Canı yandı mı? \NYaralanmadı değil mi?!
Dialogue: 0,0:14:08.96,0:14:11.20,Flashbacks,,0,0,0,,Çok özür dilerim!
Dialogue: 0,0:14:11.53,0:14:15.23,Flashbacks,,0,0,0,,Gidip bir doktora baktıralım!
Dialogue: 0,0:14:15.23,0:14:19.50,Flashbacks,,0,0,0,,Bu meseleyi olaysız bir şekilde halledebilir miyiz lütfen?!
Dialogue: 0,0:14:20.57,0:14:26.11,Main,,0,0,0,,Onlar statülerini ve varlıklarını \Nkoruyacak insanları seviyorlardı.
Dialogue: 0,0:14:29.55,0:14:30.55,Main,,0,0,0,,Ben onlar gibi değildim!
Dialogue: 0,0:14:33.85,0:14:37.72,Main,,0,0,0,,Kraliyet ailesinden biri ile evlenemeyeceksem hiçbir değerim yoktu!
Dialogue: 0,0:14:37.72,0:14:40.89,Main,,0,0,0,,Bana bütün o dersleri bunun için aldırdılar.
Dialogue: 0,0:14:41.46,0:14:45.33,Main,,0,0,0,,Ve başarısız olduğum için her gün kavga ediyorlardı.
Dialogue: 0,0:14:46.16,0:14:48.57,Main,,0,0,0,,Benim o ailede bir yerim yoktu!
Dialogue: 0,0:14:49.40,0:14:53.74,Main,,0,0,0,,Siz aileniz olmadan büyüdünüz biliyorum ama ben ailemle bile bir başıma hissediyordum!
Dialogue: 0,0:14:55.64,0:15:00.15,Flashbacks,,0,0,0,,Duydum ki kaçıp kaçıp bir yerlere gidiyormuşsun.
Dialogue: 0,0:15:00.91,0:15:06.22,Flashbacks,,0,0,0,,Oraya gideceğini sanmam ama yine de Gri Terminal'den uzak dur!
Dialogue: 0,0:15:06.72,0:15:11.42,Flashbacks,,0,0,0,,Biz soylular Yüksek Şehir'de Kral ve ailesi ile birlikte yaşayacak kadar imtiyaz sahibiyiz.
Dialogue: 0,0:15:11.42,0:15:17.06,Flashbacks,,0,0,0,,Orada yaşayanlar ve \Nbiz soylular başka dünyalara aidiz!
Dialogue: 0,0:15:19.70,0:15:23.80,Main,,0,0,0,,Soylular Gri Terminal'i hakir görürler ama
Dialogue: 0,0:15:23.80,0:15:26.70,Main,,0,0,0,,burayı, Yüksek Şehir'in boğuculuğuna tercih ederim.
Dialogue: 0,0:15:26.70,0:15:30.24,Main,,0,0,0,,Orada insanın geleceğine \Non yıllar öncesinden karar veriyorlar.
Dialogue: 0,0:15:32.38,0:15:33.65,Main,,0,0,0,,Anladım.
Dialogue: 0,0:15:34.58,0:15:36.25,Main,,0,0,0,,Ace! Luffy!
Dialogue: 0,0:15:37.45,0:15:40.32,Main,,0,0,0,,Bir gün denize açılmak zorundayız!
Dialogue: 0,0:15:40.75,0:15:43.82,Main,,0,0,0,,Bu ülkeden kendimizi kurtarıp özgürce yaşayalım!
Dialogue: 0,0:15:43.82,0:15:48.46,Main,,0,0,0,,Dünya'yı keşfetmek ve onunla ilgili bir kitap yazmak istiyorum!
Dialogue: 0,0:15:48.46,0:15:51.23,Main,,0,0,0,,Konu gemicilik ise seve seve ders çalışırım!
Dialogue: 0,0:15:51.23,0:15:54.53,Main,,0,0,0,,Güçlenelim ve bir gün korsan olalım!
Dialogue: 0,0:16:00.91,0:16:04.24,Main,,0,0,0,,Benim planım zaten buydu!\NSöylemene gerek yoktu!
Dialogue: 0,0:16:04.24,0:16:10.08,Main,,0,0,0,,Korsan olup en kötü şöhretli korsan olana kadar herkesin canına okuyacağım!
Dialogue: 0,0:16:10.65,0:16:13.65,Main,,0,0,0,,Ve bu yaşadığımın tek kanıtı olacak!
Dialogue: 0,0:16:14.55,0:16:20.16,Main,,0,0,0,,Tüm dünya benden nefret etse bile,
Dialogue: 0,0:16:20.89,0:16:23.49,Main,,0,0,0,,büyük bir korsan olacağım ve onlara neler yapabileceğimi göstereceğim!
Dialogue: 0,0:16:24.33,0:16:27.33,Main,,0,0,0,,Kimseden kaçmayacağım ve kimseye yenilmeyeceğim!
Dialogue: 0,0:16:27.33,0:16:30.27,Main,,0,0,0,,Benden korksalar da nefret etseler de fartketmez;
Dialogue: 0,0:16:30.27,0:16:32.37,Main,,0,0,0,,Namımı bütün dünya duyacak!
Dialogue: 0,0:16:34.37,0:16:37.36,Main,,0,0,0,,Anladım! Pekala!
Dialogue: 0,0:16:39.38,0:16:42.88,Main,,0,0,0,,Ben...
Dialogue: 0,0:16:49.92,0:16:53.26,Main,,0,0,0,,{You fool...}Aaah, ne diyeceğini merak ediyordum.
Dialogue: 0,0:16:56.06,0:16:58.20,Main,,0,0,0,,Çok komiksin, Luffy!
Dialogue: 0,0:16:58.20,0:17:01.40,Main,,0,0,0,,Gelecekte neler yapacaksın merak ediyorum!
Dialogue: 0,0:17:02.50,0:17:05.64,Main,,0,0,0,,Korsan olabiliriz ama...
Dialogue: 0,0:17:05.64,0:17:09.24,Main,,0,0,0,,hepimiz kaptan olmak istiyoruz, \Nbu problem değil mi?
Dialogue: 0,0:17:10.17,0:17:12.01,Main,,0,0,0,,Bunu düşünmemiştim.
Dialogue: 0,0:17:12.01,0:17:15.75,Main,,0,0,0,,Sabo, benim gemimde \Nrotacı olmak istersin sanıyordum.
Dialogue: 0,0:17:15.75,0:17:18.02,Main,,0,0,0,,Benim gemime gelebilirsiniz çocuklar!
Dialogue: 0,0:17:18.02,0:17:19.25,Main,,0,0,0,,– Hayatta olmaz!\N– Hayatta olmaz!
Dialogue: 0,0:17:21.55,0:17:24.19,Main,,0,0,0,,Zamanı geldiğinde düşünürüz artık.
Dialogue: 0,0:17:24.72,0:17:28.03,Main,,0,0,0,,Belki de ayrı ayrı denize açılırız.
Dialogue: 0,0:17:29.13,0:17:31.76,Main,,0,0,0,,Oh, bunu Dadan'dan mı çaldın?!
Dialogue: 0,0:17:32.66,0:17:34.20,Main,,0,0,0,,Duymuş muydunuz?
Dialogue: 0,0:17:35.90,0:17:39.00,Main,,0,0,0,,Beraber sake içersek kardeş oluruz.
Dialogue: 0,0:17:40.17,0:17:42.61,Main,,0,0,0,,Kardeş mi? Gerçekten mi?!
Dialogue: 0,0:17:43.01,0:17:47.61,Main,,0,0,0,,Korsan olduğumuzda aynı gemide olmayabiliriz ama
Dialogue: 0,0:17:47.61,0:17:50.72,Main,,0,0,0,,kardeşlik bağımız kalıcı olacak!
Dialogue: 0,0:17:51.05,0:17:54.49,Main,,0,0,0,,Nerede olursak olalım, ne yapıyorsak yapalım bu bağ hiç bozulmayacak.
Dialogue: 0,0:17:57.82,0:17:59.99,Main,,0,0,0,,Bu günden itibaren,
Dialogue: 0,0:18:00.79,0:18:02.06,Main,,0,0,0,,kardeşiz!
Dialogue: 0,0:18:08.87,0:18:10.80,Main,,0,0,0,,Evet!
Dialogue: 0,0:19:16.20,0:19:18.07,Sign-Independent,,0,0,0,,{\blur0.9\bord0\c&H020314&\pos(955.5,664.5)\fs58.5}Kendi yolumuza gidiyoruz.
Dialogue: 0,0:19:54.21,0:19:55.44,Main,,0,0,0,,Onu geri ver!
Dialogue: 0,0:19:55.44,0:19:59.51,Main,,0,0,0,,Ne demek onu geri ver? \NSabo benim oğlum.
Dialogue: 0,0:19:59.51,0:20:01.98,Main,,0,0,0,,Çocuklar ebeveynlerinin uygun gördüğü şekilde yaşamalı...
Dialogue: 0,0:20:01.98,0:20:03.78,Main,,0,0,0,,en nihayetinde onları dünyaya getiren ebeveynleri.
Dialogue: 0,0:20:03.78,0:20:07.89,Main,,0,0,0,,Ne cüretle Sabo'yu kaçmaya özendirirsiniz!?
Dialogue: 0,0:20:07.89,0:20:10.35,Main,,0,0,0,,Sizi haydut özentisi veletler!
Dialogue: 0,0:20:10.35,0:20:12.66,Main,,0,0,0,,Paramın mı peşindesiniz?!
Dialogue: 0,0:20:12.66,0:20:14.16,Main,,0,0,0,,Ne dedin sen?!
Dialogue: 0,0:20:16.66,0:20:20.97,Main,,0,0,0,,Hey, korsan! Çocuklara nasıl vurduğuna dikkat et!
Dialogue: 0,0:20:20.97,0:20:23.77,Main,,0,0,0,,Pislik veledin kanı yüzüme bulaştı!
Dialogue: 0,0:20:25.10,0:20:26.20,Main,,0,0,0,,Ace!
Dialogue: 0,0:20:26.94,0:20:27.91,Main,,0,0,0,,Hey!
Dialogue: 0,0:20:28.54,0:20:32.01,Main,,0,0,0,,Dur! Kimse beni kaçmaya özendirmedi!
Dialogue: 0,0:20:32.48,0:20:34.31,Main,,0,0,0,,Kendi hür irademle kaçtım!
Dialogue: 0,0:20:34.61,0:20:36.71,Main,,0,0,0,,Sen bu işe karışma! Hey.
Dialogue: 0,0:20:38.72,0:20:41.09,Main,,0,0,0,,Gerisini siz korsanlara bırakıyorum.
Dialogue: 0,0:20:41.09,0:20:44.99,Main,,0,0,0,,Tabii, emredersiniz. \NÖdemeyi yaptınız zaten.
Dialogue: 0,0:20:45.46,0:20:50.90,Main,,0,0,0,,Bu ikisinin bir daha sizi rahatsız etmemesini sağlayacağım.
Dialogue: 0,0:20:52.13,0:20:57.24,Main,,0,0,0,,Dur bir dakika, Bluejam!\NBaba, bu kadarı yeter! Dersimi aldım!
Dialogue: 0,0:20:58.04,0:21:00.17,Main,,0,0,0,,Ne dersi aldın?
Dialogue: 0,0:21:01.67,0:21:02.74,Main,,0,0,0,,Yapma, Sabo!
Dialogue: 0,0:21:04.38,0:21:10.11,Main,,0,0,0,,Sözünden çıkmayacağım. \NSenin istediğin gibi yaşayacağım, o yüzden...
Dialogue: 0,0:21:10.11,0:21:14.82,Main,,0,0,0,,lütfen onlara zarar verme!
Dialogue: 0,0:21:15.12,0:21:16.55,Main,,0,0,0,,Sana yalvarıyorum.
Dialogue: 0,0:21:17.12,0:21:19.82,Main,,0,0,0,,Benim için çok önemliler; \Nkardeşim gibiler.
Dialogue: 0,0:21:20.96,0:21:22.16,Main,,0,0,0,,Sabo!
Dialogue: 0,0:21:23.23,0:21:26.96,Main,,0,0,0,,O halde doğru eve.
Dialogue: 0,0:21:26.96,0:21:30.67,Main,,0,0,0,,Korsancılık oynamayı bırak.\NBu tamamen zaman kaybı.
Dialogue: 0,0:21:32.64,0:21:34.67,Main,,0,0,0,,Hey! Gitme!
Dialogue: 0,0:21:34.81,0:21:36.31,Main,,0,0,0,,Kes sesini!
Dialogue: 0,0:21:36.31,0:21:40.44,Main,,0,0,0,,Sabo, kaç kurtar kendini! Bizim için endişelenme!
Dialogue: 0,0:21:40.85,0:21:43.31,Main,,0,0,0,,Özgürce yaşamak istiyorum demiştim!
Dialogue: 0,0:21:43.31,0:21:45.82,Main,,0,0,0,,Sabo, gitme!
Dialogue: 0,0:21:46.18,0:21:48.72,Main,,0,0,0,,Hayallerinden böyle vaz mı geçeceksin?!
Dialogue: 0,0:21:49.15,0:21:50.32,Main,,0,0,0,,Sabo!
Dialogue: 0,0:21:53.49,0:21:54.86,Main,,0,0,0,,Sabo!
Dialogue: 0,0:21:59.73,0:22:01.97,Main,,0,0,0,,Sabo!
Dialogue: 0,0:22:08.11,0:22:10.68,Main,,0,0,0,,Kaptan! Bu çocuklara ne yapacağız?
Dialogue: 0,0:22:11.78,0:22:14.45,Main,,0,0,0,,– Karargaha götürün.\N– Emredersiniz.
Dialogue: 0,0:22:15.41,0:22:17.68,Main,,0,0,0,,Şerefsiz! Çöz beni!
Dialogue: 0,0:22:17.68,0:22:20.69,Main,,0,0,0,,Benle tekrar dövüş! Bu sefer kaybetmeyeceğim!
Dialogue: 0,0:22:21.04,0:22:26.02,Main,,0,0,0,,Soylu biri olmak güzel bir şey olsa gerek, öyle değil mi veletler?
Dialogue: 0,0:22:26.49,0:22:29.76,Main,,0,0,0,,Herkese böcek gibi muamele edip patronluk taslıyorlar.
Dialogue: 0,0:22:29.76,0:22:32.66,Main,,0,0,0,,Ne kadar kolay bir hayat.
Dialogue: 0,0:22:32.66,0:22:35.23,Main,,0,0,0,,Bu güzel bir şey olsa gerek.
Dialogue: 0,0:22:35.70,0:22:37.74,Main,,0,0,0,,Ne demek istiyorsun?!
Dialogue: 0,0:22:37.74,0:22:41.81,Main,,0,0,0,,Korsan olmak çok daha iyi!\NSabo öyle demişti!
Dialogue: 0,0:22:41.81,0:22:46.98,Main,,0,0,0,,Sizin için üzülüyorum. \NHey, çöz şunları.
Dialogue: 0,0:22:46.98,0:22:47.91,Main,,0,0,0,,Emredersiniz.
Dialogue: 0,0:22:47.91,0:22:51.58,Main,,0,0,0,,Sizce neden soylu bir ailenin oğlu...
Dialogue: 0,0:22:51.58,0:22:53.92,Main,,0,0,0,,Gri Terminal gibi bir yere kaçar?
Dialogue: 0,0:22:55.12,0:23:01.09,Main,,0,0,0,,Hiç şüphe yok ki oradaki insanlarla dalga geçmek için, bütün soyluların yaptığı gibi.
Dialogue: 0,0:23:01.09,0:23:04.66,Main,,0,0,0,,Bahse girerim size de üstten bakmıştır.
Dialogue: 0,0:23:04.66,0:23:07.87,Main,,0,0,0,,Bu doğru değil! Sabo öyle biri değil!
Dialogue: 0,0:23:07.87,0:23:10.37,Main,,0,0,0,,Evet! Biz kardeşiz!
Dialogue: 0,0:23:10.37,0:23:13.40,Main,,0,0,0,,Öyle mi? Pekala, özür dilerim.
Dialogue: 0,0:23:14.21,0:23:18.91,Main,,0,0,0,,Ama o veledi gidip rahatsız etmeyeceksiniz değil mi?
Dialogue: 0,0:23:18.91,0:23:20.71,Main,,0,0,0,,Eğer bunu planlıyorsanız,
Dialogue: 0,0:23:20.71,0:23:23.75,Main,,0,0,0,,ikinizi de öldürmem gerekir.
Dialogue: 0,0:23:23.75,0:23:27.59,Main,,0,0,0,,Eğer onu gerçekten kardeşiniz olarak görüyorsanız,\Npeşini bırakmanız daha iyi olur.
Dialogue: 0,0:23:29.09,0:23:31.92,Thoughts,,0,0,0,,Sabo'nun iyiliği için mi?
Dialogue: 0,0:23:31.92,0:23:34.33,Main,,0,0,0,,Ama Sabo Yüksek Şehir'den nefret eder!
Dialogue: 0,0:23:34.63,0:23:39.43,Main,,0,0,0,,Eğer onu önemsiyorsanız kendi haline bırakın.
Dialogue: 0,0:23:39.43,0:23:42.27,Main,,0,0,0,,Büyüyünce dediğimi daha iyi anlarsınız.
Dialogue: 0,0:23:42.63,0:23:47.20,Main,,0,0,0,,Bu arada Porchemy'e yaptıklarınızdan dolayı görülecek bir hesabımız vardı.
Dialogue: 0,0:23:47.51,0:23:52.08,Main,,0,0,0,,Ama unutalım gitsin. \NGücünüzü göstermeniz hoşuma gitti aslında.
Dialogue: 0,0:23:52.08,0:23:56.65,Main,,0,0,0,,Bu yüzden size sormak istediğim bir şey var.\Nİlginizi çekebileceğini düşünüyorum.
Dialogue: 0,0:23:56.65,0:24:03.15,Main,,0,0,0,,Bu aralar adama ihtiyacım var.\NBenim için çalışmak ister misiniz?
Dialogue: 0,0:24:03.15,0:24:08.16,Main,,0,0,0,,Kolay bir iş aslında.\NHerhangi bir tehlikesi yok.
Dialogue: 0,0:24:08.46,0:24:11.16,Main,,0,0,0,,Burada Gri Terminal'in bir haritası var.
Dialogue: 0,0:24:11.16,0:24:15.37,Main,,0,0,0,,Tek yapmaınz gereken paketleri haritada işraretli yerlere taşımak.
Dialogue: 0,0:24:15.37,0:24:16.63,Main,,0,0,0,,Ne diyorsunuz? Kabul mü?
Dialogue: 0,0:24:16.63,0:24:17.97,Main,,0,0,0,,Tamam.
Dialogue: 0,0:24:19.27,0:24:20.44,Main,,0,0,0,,Ne kadar ödeyeceksin?
Dialogue: 0,0:24:25.21,0:24:29.28,Main,,0,0,0,,Ace, Sabo'nun gitmiş olması hoşuma gitmiyor.
Dialogue: 0,0:24:29.28,0:24:33.32,Main,,0,0,0,,Yapacak bir şey yok. Benim de hoşuma gitmiyor. \NOnu kurtarmak istiyorum.
Dialogue: 0,0:24:34.25,0:24:38.62,Main,,0,0,0,,Ama onu için gerçekten neyin iyi olduğunu bilmiyorum.
Dialogue: 0,0:24:39.36,0:24:42.43,Main,,0,0,0,,Bakalım bu işin sonu nereye varacak. Sabo güçlüdür, dayanır.
Dialogue: 0,0:24:42.43,0:24:45.76,Main,,0,0,0,,Eğer orada yapamazsa, buraya dönebilir.
Dialogue: 0,0:24:46.43,0:24:50.30,Main,,0,0,0,,Korsan zulamız için biraz para kazanalım, ne olur ne olmaz.
Dialogue: 0,0:24:52.07,0:24:54.87,Main,,0,0,0,,Söyleyemem. \NBu Ace ve Luffy'nin suçu değil.
Dialogue: 0,0:24:54.87,0:24:58.04,Main,,0,0,0,,Neden gerçeği söyleyemezsin?!
Dialogue: 0,0:24:58.04,0:25:03.45,Main,,0,0,0,,Seni bir şey söylememen konusunda uyardıkları için mi?
Dialogue: 0,0:25:03.45,0:25:06.02,Main,,0,0,0,,Onlar öyle insanlar değil!
Dialogue: 0,0:25:06.02,0:25:11.06,Main,,0,0,0,,Eğer sicilin temiz olmazsa, \Nbu ailenin itibarına leke sürecektir.
Dialogue: 0,0:25:11.06,0:25:12.96,Main,,0,0,0,,Yüksek Şehir'e de giremezsin.
Dialogue: 0,0:25:12.96,0:25:15.73,Main,,0,0,0,,Onlar seni azmettirdi,
Dialogue: 0,0:25:15.73,0:25:19.20,Main,,0,0,0,,sana o suçları işlemekten başka çare bırakmadılar,
Dialogue: 0,0:25:19.70,0:25:21.10,Main,,0,0,0,,değil mi, Sabo?
Dialogue: 0,0:25:23.77,0:25:25.10,Main,,0,0,0,,Sabo.
Dialogue: 0,0:25:25.10,0:25:28.61,Main,,0,0,0,,Gri Terminal'deki arkadaşlarının kaderi...
Dialogue: 0,0:25:28.61,0:25:30.41,Main,,0,0,0,,o korsanların elinde.
Dialogue: 0,0:25:30.41,0:25:32.94,Main,,0,0,0,,Ve ben onlara bir emir verebilirim.
Dialogue: 0,0:25:32.94,0:25:35.48,Main,,0,0,0,,Eğer senin için o kadar önemlilerse
Dialogue: 0,0:25:35.48,0:25:37.98,Main,,0,0,0,,yapacaklarına dikkat et.
Dialogue: 0,0:25:40.82,0:25:45.22,Main,,0,0,0,,Sen akıllı bir çocuksun.\NNe yapman gerektiğini bilirsin.
Dialogue: 0,0:25:46.09,0:25:49.66,Main,,0,0,0,,Onlara zarar gelmeyeceğine yemin etmiştin!
Dialogue: 0,0:25:49.66,0:25:52.30,Main,,0,0,0,,O yüzden buraya geldim!
Dialogue: 0,0:25:52.30,0:25:56.80,Main,,0,0,0,,Suç suçtur! \NO suçları kendi hür irademizle işledik.
Dialogue: 0,0:25:59.74,0:26:01.57,Main,,0,0,0,,Bak şu işe!
Dialogue: 0,0:26:02.41,0:26:06.14,Main,,0,0,0,,Bu kadar aptal bir çocuğumun olması ne kadar da acı!
Dialogue: 0,0:26:07.11,0:26:09.28,Main,,0,0,0,,İçinde olduğum ikilemi anlıyorsun değil mi?
Dialogue: 0,0:26:09.28,0:26:12.62,Main,,0,0,0,,Ah, çok zor olmalı.
Dialogue: 0,0:26:13.35,0:26:15.82,Main,,0,0,0,,Evrakları ben hallederim.
Dialogue: 0,0:26:19.06,0:26:21.46,Main,,0,0,0,,Hoş geldiniz efendim.
Dialogue: 0,0:26:21.96,0:26:26.36,Main,,0,0,0,,Hadi gidelim Sabo. \NSen gideli o kadar uzun zaman oldu ki.
Dialogue: 0,0:26:26.36,0:26:30.10,Main,,0,0,0,,Ah daha içeri giremezsin; pislik içindesin.
Dialogue: 0,0:26:30.10,0:26:32.74,Main,,0,0,0,,Avluda temizlen ve kendini güzelce dezenfekte et.
Dialogue: 0,0:26:32.74,0:26:34.24,Main,,0,0,0,,Sonra da bir banyo yap.
Dialogue: 0,0:26:34.87,0:26:37.74,Main,,0,0,0,,Güvende olduğunuza sevindim, genç efendi.
Dialogue: 0,0:26:38.21,0:26:42.54,Main,,0,0,0,,Oh, Sabo! Geri dönmüşsün. Ne kadar büyümüşsün.
Dialogue: 0,0:26:44.01,0:26:44.92,Main,,0,0,0,,Anne.
Dialogue: 0,0:26:44.92,0:26:47.75,Main,,0,0,0,,Hadi Sterry, abine merhaba de.
Dialogue: 0,0:26:48.12,0:26:52.82,Main,,0,0,0,,Tanıştığımıza memnun oldum abi!\NBenim adım Sterry. 8 yaşındayım.
Dialogue: 0,0:26:53.56,0:26:54.79,Thoughts,,0,0,0,,Bu da kim?
Dialogue: 0,0:26:56.29,0:27:00.06,Main,,0,0,0,,Onu evlat edindik. Asil bir ailenin akıllı bir çocuğu.
Dialogue: 0,0:27:00.06,0:27:04.40,Main,,0,0,0,,Ama nedense ailesi onu ihmal etmiş.
Dialogue: 0,0:27:04.77,0:27:07.91,Main,,0,0,0,,Gelecek vaadeden biri olduğu için biz de onu yanımıza aldık.
Dialogue: 0,0:27:08.44,0:27:12.58,Main,,0,0,0,,Eğer varisim olmazsan...
Dialogue: 0,0:27:13.81,0:27:16.38,Main,,0,0,0,,Fazla konuştum.
Dialogue: 0,0:27:16.88,0:27:18.28,Main,,0,0,0,,Odana git artık.
Dialogue: 0,0:27:18.28,0:27:20.52,Main,,0,0,0,,{\fad(0,250)}Yarın çalışmaya başlayacaksın.
Dialogue: 0,0:27:29.83,0:27:32.35,Flashbacks,,0,0,0,,Hayallerinin peşini böyle bırakacak mısın?!
Dialogue: 0,0:27:35.53,0:27:39.84,Main,,0,0,0,,Hey, Abi! Duydum ki sen epey aptalmışsın.
Dialogue: 0,0:27:40.87,0:27:44.41,Main,,0,0,0,,Annem ve babam sürekli bunu ima ediyorlar.
Dialogue: 0,0:27:44.74,0:27:47.18,Main,,0,0,0,,Ama sende şeytan tüyü var belli.
Dialogue: 0,0:27:47.18,0:27:49.78,Main,,0,0,0,,Yarın akşam yakacakları halledecekler.
Dialogue: 0,0:27:50.78,0:27:53.62,Main,,0,0,0,,Gri Terminal'de kalmış olsaydın,
Dialogue: 0,0:27:54.79,0:27:57.42,Main,,0,0,0,,sen de ölecektin.
Dialogue: 0,0:27:58.52,0:28:01.96,Main,,0,0,0,,Tabii öz oğlu eve dönmemiş olsa...
Dialogue: 0,0:28:01.96,0:28:04.40,Main,,0,0,0,,benim için daha iyi olurdu.
Dialogue: 0,0:28:05.00,0:28:08.90,Main,,0,0,0,,N-n-ne yapıyorsun?! Babama söyleyeceğim!
Dialogue: 0,0:28:08.90,0:28:11.64,Main,,0,0,0,,Neden bahsediyorsun sen?!
Dialogue: 0,0:28:11.64,0:28:13.94,Main,,0,0,0,,Neler oluyor? Bana her şeyi anlat!
Dialogue: 0,0:28:13.94,0:28:19.01,Main,,0,0,0,,Y-yarın Gri Terminal'de bir yangın olacak.
Dialogue: 0,0:28:19.41,0:28:21.48,Main,,0,0,0,,– Yangın mı?!\N– Evet.
Dialogue: 0,0:28:21.48,0:28:24.75,Main,,0,0,0,,Haberin yok çünkü burada değildin.
Dialogue: 0,0:28:24.75,0:28:27.38,Main,,0,0,0,,Bunu aylar öncesinden planladılar.
Dialogue: 0,0:28:27.99,0:28:29.85,Main,,0,0,0,,Biliyor muydun Dünya Hükümeti...
Dialogue: 0,0:28:29.85,0:28:32.42,Main,,0,0,0,,Doğu Mavi'yi dolaşması için gözlemciler gönderdiler.
Dialogue: 0,0:28:33.19,0:28:36.66,Main,,0,0,0,,3 gün sonra Goa'ya nihayet varmış olacaklar!
Dialogue: 0,0:28:37.26,0:28:40.23,Main,,0,0,0,,Bu sefer bir dünya soylusu, bir Kutsal Ejder de,
Dialogue: 0,0:28:40.23,0:28:43.37,Main,,0,0,0,,onlarla beraber geliyor. Bu yüzden herkes panik içinde!
Dialogue: 0,0:28:43.37,0:28:48.34,Main,,0,0,0,,Kraliyet ailesi Kutsal Ejder'in ülkemizdeki o lekeyi görmesini istemiyor,
Dialogue: 0,0:28:48.34,0:28:52.18,Main,,0,0,0,,o yüzden Gri Terminal'i yakma kararı aldılar.
Dialogue: 0,0:28:52.61,0:28:55.75,Main,,0,0,0,,Böylece ülkeyi temizlemiş olacaklar!
Dialogue: 0,0:28:55.75,0:29:00.88,Main,,0,0,0,,Ne diyorsun sen? \NBunu yapamazlar!
Dialogue: 0,0:29:00.88,0:29:04.46,Main,,0,0,0,,Orada yaşayan bir sürü insan var!
Dialogue: 0,0:29:04.46,0:29:06.99,Main,,0,0,0,,Evlerini ellerinden alamazlar!
Dialogue: 0,0:29:06.99,0:29:07.73,Main,,0,0,0,,Bırak beni!
Dialogue: 0,0:29:08.46,0:29:11.23,Main,,0,0,0,,Beni dinlemiyor musun?
Dialogue: 0,0:29:13.10,0:29:17.10,Main,,0,0,0,,Bu ülkenin pisliğini temizleyecekler.
Dialogue: 0,0:29:17.74,0:29:19.94,Main,,0,0,0,,Yani insanları da mı?
Dialogue: 0,0:29:26.71,0:29:27.71,Main,,0,0,0,,H-Hey!
Dialogue: 0,0:29:29.91,0:29:31.35,Main,,0,0,0,,Nereye gidiyorsun?
Dialogue: 0,0:29:35.85,0:29:37.52,Main,,0,0,0,,Öylece atlayamazsın...{What floor do you think we're on?}
Dialogue: 0,0:29:41.83,0:29:44.09,Main,,0,0,0,,Bana neyse.
Dialogue: 0,0:29:44.50,0:29:46.93,Thoughts,,0,0,0,,Yalan! Yalan söylüyor olmalı!
Dialogue: 0,0:29:46.93,0:29:51.00,Thoughts,,0,0,0,,O kadar büyük bir alanı yakamazlar!
Dialogue: 0,0:29:55.47,0:29:57.54,Thoughts,,0,0,0,,Bunlar bu öğlen oradaydılar.
Dialogue: 0,0:29:59.01,0:30:02.85,Main,,0,0,0,,Yarın için hazır mıyız?\NHesap hatası yapma lüksümüz yok.
Dialogue: 0,0:30:02.85,0:30:06.68,Main,,0,0,0,,Hazırız ancak korsanlar problem.
Dialogue: 0,0:30:06.68,0:30:09.32,Main,,0,0,0,,Plana göre yangını çıkarmaları gerekiyor.
Dialogue: 0,0:30:10.22,0:30:13.76,Main,,0,0,0,,Bluejam'in tayfası kutuları ve patlayıcıları ayarlıyorlar...
Dialogue: 0,0:30:13.76,0:30:17.80,Main,,0,0,0,,Yarın anlaşılan vakte kadar\NGri Terminal'in her yerine kurmuş olacaklar.
Dialogue: 0,0:30:18.76,0:30:22.43,Thoughts,,0,0,0,,Bluejam'in bu işte bir parmağı var ha?\NO zaman doğru olmalı!
Dialogue: 0,0:30:22.43,0:30:24.33,Thoughts,,0,0,0,,Ama bu saçmalık!
Dialogue: 0,0:30:35.15,0:30:37.51,Main,,0,0,0,,Acaba Sabo ne yapıyor.
Dialogue: 0,0:30:37.88,0:30:40.02,Main,,0,0,0,,Kes sesini de zıbar.
Dialogue: 0,0:30:41.02,0:30:44.12,Main,,0,0,0,,Sabo'yu kendi haline bırakacağız dedik ya.
Dialogue: 0,0:30:44.69,0:30:45.42,Main,,0,0,0,,Tamam.
Dialogue: 0,0:30:46.49,0:30:49.46,Main,,0,0,0,,Bu onun için daha iyi olacak.
Dialogue: 0,0:30:54.60,0:30:56.63,Thoughts,,0,0,0,,İnsanların hal ve hareketlerinden...
Dialogue: 0,0:30:56.63,0:30:59.37,Thoughts,,0,0,0,,yangın olacak mı olmayacak mı anlayabilirim.
Dialogue: 0,0:31:03.37,0:31:06.48,Main,,0,0,0,,– Merhaba, günaydın!\N– Günaydın!
Dialogue: 0,0:31:06.48,0:31:09.91,Main,,0,0,0,,– Ne güzel bir gün değil mi.\N– Evet, öyle.
Dialogue: 0,0:31:09.91,0:31:13.75,Main,,0,0,0,,Ah güzel! Problem yok!
Dialogue: 0,0:31:14.15,0:31:15.99,Main,,0,0,0,,Şehri biraz dolaşıp kolaçan edeyim.
Dialogue: 0,0:31:18.52,0:31:20.69,Main,,0,0,0,,Rüzgarlı bir gün.
Dialogue: 0,0:31:20.69,0:31:24.03,Main,,0,0,0,,Evet öyle Ekselansları.
Dialogue: 0,0:31:24.03,0:31:29.33,Main,,0,0,0,,Böyle bir günde pekala kazalar olabilir, \Nözellikle yangınlar.
Dialogue: 0,0:31:29.33,0:31:33.04,Main,,0,0,0,,Haklısınız Ekselansları.
Dialogue: 0,0:31:33.34,0:31:36.17,Main,,0,0,0,,Sabo evden gitmiş mi?!
Dialogue: 0,0:31:36.17,0:31:38.28,Main,,0,0,0,,Şımarık velet!
Dialogue: 0,0:31:38.28,0:31:42.58,Main,,0,0,0,,Çalışmayıp korsancılık mı oynamak istiyor hala?!
Dialogue: 0,0:31:43.11,0:31:44.98,Main,,0,0,0,,Bütün Yüksek Şehir'i arayın!
Dialogue: 0,0:31:45.32,0:31:47.99,Main,,0,0,0,,Yüksek Şehir'i o kadar kolay terketmiş olamaz!
Dialogue: 0,0:31:49.25,0:31:52.12,Main,,0,0,0,,– Afedersiniz bayım.\N– Ne istiyorsun?
Dialogue: 0,0:31:52.46,0:31:56.36,Main,,0,0,0,,Gri Terminal'de bu gece bir yangın olacağını biliyor musunuz?
Dialogue: 0,0:31:56.36,0:32:00.30,Main,,0,0,0,,Tabii ki biliyorum. Ne olmuş ki?
Dialogue: 0,0:32:01.00,0:32:02.07,Thoughts,,0,0,0,,Biliyor mu?
Dialogue: 0,0:32:02.07,0:32:04.67,Main,,0,0,0,,Sen kimlerdensin?
Dialogue: 0,0:32:05.07,0:32:07.54,Thoughts,,0,0,0,,Demek ki doğru!
Dialogue: 0,0:32:09.11,0:32:10.24,Main,,0,0,0,,Hey, çocuk!
Dialogue: 0,0:32:10.41,0:32:13.31,Thoughts,,0,0,0,,Ne oluyor burada?\NHerkes yangın çıkacağını biliyor mu?
Dialogue: 0,0:32:13.64,0:32:16.51,Thoughts,,0,0,0,,Hepsi biliyor ve normal hayatlarına devam mı ediyorlar?!
Dialogue: 0,0:32:16.51,0:32:20.54,Thoughts,,0,0,0,,Gri Terminal'de çıkacak yangın kimsenin umrunda değil mi?!
Dialogue: 0,0:32:24.42,0:32:27.29,Main,,0,0,0,,Oh, işte buradasınız, ufaklıklar.
Dialogue: 0,0:32:27.29,0:32:29.56,Main,,0,0,0,,Taşınacak başka kutu var mı?
Dialogue: 0,0:32:29.56,0:32:32.86,Main,,0,0,0,,Evet ve bu gece için size özel bir görev vereceğim.
Dialogue: 0,0:32:32.86,0:32:34.60,Main,,0,0,0,,Daha sonra detayları anlatırım.
Dialogue: 0,0:32:34.60,0:32:36.77,Main,,0,0,0,,Evet, biliyorum.
Dialogue: 0,0:32:36.77,0:32:41.91,Main,,0,0,0,,Neden bu şehirdeki sen dahil kimse endişelenmiyor?
Dialogue: 0,0:32:41.91,0:32:44.04,Main,,0,0,0,,Neden kimse engel olmaya çalışmıyor?
Dialogue: 0,0:32:46.38,0:32:50.61,Main,,0,0,0,,Sen iyi niyetli bir çocuğa benziyorsun.
Dialogue: 0,0:32:50.61,0:32:53.28,Main,,0,0,0,,Ama iyi dinle.
Dialogue: 0,0:32:53.28,0:32:56.62,Main,,0,0,0,,Hepimiz plan konusunda sessiz kalmalıyız!
Dialogue: 0,0:32:56.62,0:33:01.46,Main,,0,0,0,,Eğer Yüksek Şehir'den olmayan biri bunu duysa ne olur?
Dialogue: 0,0:33:01.93,0:33:05.93,Main,,0,0,0,,Biz özeliz! Eğer soylu bir ailedensen...
Dialogue: 0,0:33:07.50,0:33:08.53,Main,,0,0,0,,Hey, dur!
Dialogue: 0,0:33:09.93,0:33:12.00,Thoughts,,0,0,0,,Ace! Luffy!
Dialogue: 0,0:33:12.00,0:33:15.34,Thoughts,,0,0,0,,Bu şehirde yanlış giden bir şeyler var! \NHepsi delirmiş!
Dialogue: 0,0:33:15.74,0:33:17.67,Thoughts,,0,0,0,,İnsanların öleceğini biliyorlar
Dialogue: 0,0:33:17.67,0:33:20.51,Thoughts,,0,0,0,,ama normal yaşamlarına devam ediyorlar, hem de gülerek!
Dialogue: 0,0:33:21.21,0:33:25.55,Thoughts,,0,0,0,,Burada kalmak istemiyorum!\NOnlara hemen haber vermem lazım!
Dialogue: 0,0:33:27.55,0:33:31.05,Thoughts,,0,0,0,,Tam da rüzgarlı olacak günü buldu?!
Dialogue: 0,0:33:31.05,0:33:33.22,Main,,0,0,0,,İşte orada! Bu o değil mi?!
Dialogue: 0,0:33:33.66,0:33:36.09,Main,,0,0,0,,Evet bu o! Kaçak çocuk bu!
Dialogue: 0,0:33:36.73,0:33:38.83,Main,,0,0,0,,Hey sen, bekle!
Dialogue: 0,0:33:38.83,0:33:41.93,Thoughts,,0,0,0,,Bu gece bu şehrin insanları...
Dialogue: 0,0:33:41.93,0:33:44.10,Thoughts,,0,0,0,,ülkelerinin lekesini temizleyecekler!
Dialogue: 0,0:33:44.84,0:33:48.41,Thoughts,,0,0,0,,Gri Terminal'den kaçmalısınız! Ace! Luffy!
Dialogue: 0,0:33:48.87,0:33:52.44,Main,,0,0,0,,Kaçın! Ace! Luffy!
Dialogue: 0,0:33:54.31,0:33:55.71,Main,,0,0,0,,Bunu neden yapıyorsun?!
Dialogue: 0,0:33:55.71,0:34:01.45,Main,,0,0,0,,Aptal! Sessiz ol!\NBunu kimsenin öğrenmesine izin veremeyiz!
Dialogue: 0,0:34:01.45,0:34:04.19,Main,,0,0,0,,Bu çok ciddi! Herkese söylemeliyim!
Dialogue: 0,0:34:04.19,0:34:06.16,Main,,0,0,0,,O kötü biri, tam da düşündüğüm gibi!
Dialogue: 0,0:34:06.16,0:34:09.89,Main,,0,0,0,,Sana bağırma dedim.\NHey, onları sıkı tutun.
Dialogue: 0,0:34:11.30,0:34:13.66,Main,,0,0,0,,Bu işin arkasındaki ben değilim.
Dialogue: 0,0:34:16.00,0:34:18.60,Main,,0,0,0,,Dün ve bugün taşıdığınız kutularda...
Dialogue: 0,0:34:18.94,0:34:21.17,Main,,0,0,0,,yağ ve patlayıcılar vardı.
Dialogue: 0,0:34:21.17,0:34:26.34,Main,,0,0,0,,Çıkacak büyük yangından kimse kurtulamayacak.
Dialogue: 0,0:34:26.34,0:34:28.71,Main,,0,0,0,,– Nasıl yaparsın?\N– Sen aklını mı yitirdin?
Dialogue: 0,0:34:30.15,0:34:33.52,Main,,0,0,0,,Sizin gibi serseri veletlerin bile ödü kopuyor ha?
Dialogue: 0,0:34:34.08,0:34:37.59,Main,,0,0,0,,Ama artık planı biliyorsunuz.
Dialogue: 0,0:34:37.99,0:34:41.86,Main,,0,0,0,,Gitmenize izin veremeyiz.
Dialogue: 0,0:34:41.86,0:34:45.80,Main,,0,0,0,,Yangından önce size bir şey sormak istiyorum.
Dialogue: 0,0:34:46.63,0:34:52.20,Main,,0,0,0,,Bir yerlerde sakladığınız bir hazineniz var mı?
Dialogue: 1,0:35:16.49,0:35:20.16,Captions,,0,0,0,,{\fad(500,0)\pos(960,793.5)}Kenar Şehir
Dialogue: 0,0:35:21.26,0:35:22.53,Main,,0,0,0,,Kes sesini!
Dialogue: 0,0:35:23.53,0:35:25.70,Main,,0,0,0,,H-Hey! Baksanıza!
Dialogue: 0,0:35:30.07,0:35:32.81,Main,,0,0,0,,Gri Terminal'de bir şey oluyor.
Dialogue: 0,0:35:32.81,0:35:34.38,Main,,0,0,0,,Yangın mı çıkmış?
Dialogue: 0,0:35:39.55,0:35:42.12,Main,,0,0,0,,Bu oynadığım en iyi oyun!
Dialogue: 0,0:35:42.12,0:35:45.92,Main,,0,0,0,,P-p-patron Bunu görmelisin!
Dialogue: 0,0:35:46.22,0:35:47.82,Main,,0,0,0,,Neden bağırıyorsun?
Dialogue: 0,0:35:47.82,0:35:50.59,Main,,0,0,0,,– Kuzey tarafında gökyüzüne bak!\N– Bu şehir mı?!
Dialogue: 0,0:35:50.93,0:35:55.74,Main,,0,0,0,,Hayır daha yakın! \NGri Terminal olmalı! Yanıyor!
Dialogue: 1,0:35:57.13,0:35:59.90,Captions,,0,0,0,,{\fad(600,0)\pos(960,795)}{\fs43}Orta Şehir
Dialogue: 0,0:35:57.53,0:35:59.90,Main,,0,0,0,,Neler oluyor? Çok hızlı yayılan bir yangın bu!
Dialogue: 0,0:35:59.90,0:36:03.47,Main,,0,0,0,,Gri Terminal'de daha önce hiç yangın çıkmamıştı!
Dialogue: 0,0:36:05.01,0:36:07.74,Main,,0,0,0,,Çok tehlikeli; Kenar Şehir'i boşaltın!
Dialogue: 1,0:36:07.74,0:36:10.38,Captions,,0,0,0,,{\fad(500,0)\pos(960,796.5)}Kenar Şehir - Büyük Kapı
Dialogue: 0,0:36:07.74,0:36:10.38,Main,,0,0,0,,Herkes Orta Şehir'e!
Dialogue: 0,0:36:10.81,0:36:15.12,Main,,0,0,0,,İnsanları kurtarmayı ve yangını söndürmeyi biz askerlere bırakın!
Dialogue: 0,0:36:18.69,0:36:21.83,Main,,0,0,0,,– Uyanın!\N– Kaçmamız gerek!
Dialogue: 0,0:36:24.39,0:36:28.60,Main,,0,0,0,,– Yangın her yere yayılıyor!\N– Burada kalamayız!
Dialogue: 0,0:36:28.60,0:36:31.87,Main,,0,0,0,,İşe yaramıyor, vazgeç artık!\NEvini bırakman gerekiyor!
Dialogue: 0,0:36:34.94,0:36:37.81,Main,,0,0,0,,Olamaz! Yangın kıyıya ulaşmış bile!
Dialogue: 0,0:36:37.81,0:36:40.54,Main,,0,0,0,,Orman girişi de yanıyor!
Dialogue: 0,0:36:40.54,0:36:43.48,Main,,0,0,0,,Lanet olsun! Nereye gideceğiz?! Kapana kısıldık!
Dialogue: 0,0:36:47.22,0:36:50.92,Main,,0,0,0,,Yakın her yeri çocuklar!
Dialogue: 0,0:36:52.99,0:36:55.29,Main,,0,0,0,,Bu işi tamamladığımızda,
Dialogue: 0,0:36:55.29,0:36:58.50,Main,,0,0,0,,uzun süredir hayalini kurduğum şey gerçek olacak!
Dialogue: 0,0:36:59.90,0:37:01.03,Flashbacks,,0,0,0,,Haklısın.
Dialogue: 0,0:37:01.03,0:37:04.94,Flashbacks,,0,0,0,,Burada yaşayan insanlar umurumuzda bile değil.
Dialogue: 0,0:37:04.94,0:37:07.30,Flashbacks,,0,0,0,,Ama burası ne kadar boktan olursa olsun,
Dialogue: 0,0:37:07.30,0:37:11.11,Flashbacks,,0,0,0,,Karargah olarak iş görüyor Ekselansları.
Dialogue: 0,0:37:11.11,0:37:14.24,Flashbacks,,0,0,0,,Biliyorum, Bluejam.
Dialogue: 0,0:37:14.24,0:37:18.52,Flashbacks,,0,0,0,,Ama bu iş bittikten sonra saklanmanıza gerek kalmayacak.
Dialogue: 0,0:37:18.52,0:37:22.99,Flashbacks,,0,0,0,,Hepinizi soylu ilan edeceğim.
Dialogue: 0,0:37:24.82,0:37:27.06,Flashbacks,,0,0,0,,Gerçekten mi?!
Dialogue: 0,0:37:27.89,0:37:31.39,Main,,0,0,0,,Kral bize ünvanlar verecek
Dialogue: 0,0:37:31.39,0:37:35.40,Main,,0,0,0,,ve hepimiz Yüksek Şehir'de ayrıcalıklı soylular olarak yaşayacağız!
Dialogue: 0,0:37:42.34,0:37:45.98,Main,,0,0,0,,Artık gitsek iyi olur.
Dialogue: 0,0:37:46.31,0:37:49.55,Main,,0,0,0,,Hadi Büyük Kapı'ya gidelim!\NAskerler bekliyor.
Dialogue: 0,0:37:49.55,0:37:52.25,Main,,0,0,0,,Kaptan, veletleri karargahta bıraktık.
Dialogue: 0,0:37:52.25,0:37:57.12,Main,,0,0,0,,Unut onları. Hazinelerinin yerini söyleseler tayfama katılabilirlerdi.
Dialogue: 0,0:37:59.59,0:38:02.56,Main,,0,0,0,,Aptallar uzun süre yaşamaz zaten.
Dialogue: 0,0:38:05.36,0:38:08.10,Main,,0,0,0,,Hey Kaptan, kapı kapalı!
Dialogue: 0,0:38:08.10,0:38:12.74,Main,,0,0,0,,Panikleme. Sadece insanların kaçmasını istemiyorlar.
Dialogue: 0,0:38:12.74,0:38:16.14,Main,,0,0,0,,Onlara bir işaret vereceğim ve kapıyı açacaklar, böyle anlaştık.
Dialogue: 0,0:38:17.11,0:38:19.61,Main,,0,0,0,,Benim, Bluejam. Açın kapıyı.
Dialogue: 0,0:38:23.21,0:38:25.15,Main,,0,0,0,,Hey! Duymuyor musunuz?!
Dialogue: 0,0:38:28.59,0:38:29.69,Main,,0,0,0,,Bu...
Dialogue: 0,0:38:30.89,0:38:33.26,Main,,0,0,0,,Kaptan, acaba..
Dialogue: 0,0:38:34.62,0:38:40.06,Main,,0,0,0,,Hey, ne yapıyorsunuz?! \NKapıyı açsanıza!
Dialogue: 0,0:38:40.06,0:38:44.07,Main,,0,0,0,,Plan bizim buradan kaçmamızı sağlamaktı değil mi?
Dialogue: 0,0:38:44.07,0:38:47.70,Main,,0,0,0,,Böyle anlaşmamıştık! Şerefsizler!
Dialogue: 0,0:38:47.70,0:38:50.27,Main,,0,0,0,,Verdiğin söze ne oldu Ekselansları?!
Dialogue: 0,0:38:50.27,0:38:53.58,Main,,0,0,0,,Bizi soylu ilan edeceğini söylemiştin...
Dialogue: 0,0:38:54.88,0:38:58.08,Main,,0,0,0,,Bizi kandırdın mı? Şerefsiz!
Dialogue: 0,0:38:58.08,0:39:00.62,Main,,0,0,0,,Lanet olsun!
Dialogue: 0,0:39:01.32,0:39:02.42,Main,,0,0,0,,Duydun mu?
Dialogue: 0,0:39:02.42,0:39:07.29,Main,,0,0,0,,Yangını Bluejam, Gri Terminal'deki bir korsan başlatmış.
Dialogue: 0,0:39:07.29,0:39:11.03,Main,,0,0,0,,Ben de öyle düşünmüştüm!\NBunu başka kim yapabilir ki.
Dialogue: 0,0:39:11.03,0:39:15.77,Main,,0,0,0,,Dünya Hükümeti'nin gözlemcilerini uzak tutmak için yapmış.
Dialogue: 0,0:39:15.77,0:39:17.63,Main,,0,0,0,,Ne korkunç!
Dialogue: 0,0:39:21.54,0:39:24.74,Main,,0,0,0,,Sıcak! Çok sıcak!
Dialogue: 0,0:39:24.74,0:39:25.98,Main,,0,0,0,,Evet!
Dialogue: 0,0:39:25.98,0:39:28.45,Main,,0,0,0,,Lanet olsun! Bu pis işe nasıl oldu bulaştık!
Dialogue: 0,0:39:30.01,0:39:32.68,Main,,0,0,0,,Kaçamayacağız! Ölmek istemiyorum!
Dialogue: 0,0:39:32.68,0:39:34.68,Main,,0,0,0,,Eğer sızlanmayı kesmezsen seni burada bırakırım!
Dialogue: 0,0:39:35.39,0:39:36.62,Main,,0,0,0,,Sıcak değil.
Dialogue: 0,0:39:38.22,0:39:40.49,Main,,0,0,0,,Üf, sıcak! Hayır değil.
Dialogue: 0,0:39:40.49,0:39:41.76,Main,,0,0,0,,Yangın her yere yayılmış!
Dialogue: 0,0:39:42.63,0:39:44.09,Main,,0,0,0,,Nefes alamıyorum.
Dialogue: 0,0:39:44.09,0:39:45.73,Main,,0,0,0,,Hayır alabiliyorum!
Dialogue: 0,0:39:45.73,0:39:47.63,Main,,0,0,0,,Hava çok sıcak!
Dialogue: 0,0:39:47.63,0:39:49.10,Main,,0,0,0,,Hayır değil.
Dialogue: 0,0:39:49.10,0:39:53.30,Main,,0,0,0,,Her şey yoluna girecek! Ben yanındayım!
Dialogue: 0,0:39:53.30,0:39:56.34,Main,,0,0,0,,Ne yapıyorsun?! Kaçman gerekiyor!
Dialogue: 0,0:39:56.81,0:39:58.38,Main,,0,0,0,,Kapıyı açın!
Dialogue: 0,0:39:58.38,0:39:59.91,Main,,0,0,0,,Ne diyorsun sen?!
Dialogue: 0,0:40:00.84,0:40:02.08,Main,,0,0,0,,Velet!
Dialogue: 0,0:40:02.08,0:40:03.28,Main,,0,0,0,,Götürün şunu!
Dialogue: 0,0:40:05.15,0:40:07.12,Main,,0,0,0,,Ace! Luffy!
Dialogue: 0,0:40:07.12,0:40:08.15,Main,,0,0,0,,Kaçın!
Dialogue: 0,0:40:12.79,0:40:15.59,Main,,0,0,0,,Uzak dur! Kilitten uzak dur!
Dialogue: 0,0:40:15.99,0:40:17.66,Main,,0,0,0,,Hayır!
Dialogue: 0,0:40:19.00,0:40:20.13,Main,,0,0,0,,Ace!
Dialogue: 0,0:40:20.43,0:40:22.13,Main,,0,0,0,,Luffy!
Dialogue: 0,0:40:30.34,0:40:33.51,Main,,0,0,0,,– İyi bir çocuk ol ve kaç kurtar kendini!\N– Bize de iş çıkarma!
Dialogue: 0,0:40:37.41,0:40:40.25,Main,,0,0,0,,A-Ace. Luffy.
Dialogue: 0,0:41:02.67,0:41:04.64,Main,,0,0,0,,Ne oldu sana, çocuk?
Dialogue: 0,0:41:10.75,0:41:12.32,Main,,0,0,0,,Y-yaşlı adam...
Dialogue: 0,0:41:15.39,0:41:20.59,Main,,0,0,0,,Kraliyet ailesi ve soylular...\N yangının arkasında onlar var...
Dialogue: 0,0:41:23.49,0:41:25.23,Main,,0,0,0,,Bana inanmalısın!
Dialogue: 0,0:41:26.76,0:41:32.07,Main,,0,0,0,,Bu kasaba Gri Terminal'den bile kötü kokuyor.
Dialogue: 0,0:41:32.64,0:41:36.44,Main,,0,0,0,,Çürümüş insan kokuyor!
Dialogue: 0,0:41:38.64,0:41:43.58,Main,,0,0,0,,Eğer burada kalırsam asla özgür olamayacağım!
Dialogue: 0,0:41:45.65,0:41:46.95,Main,,0,0,0,,Ben...
Dialogue: 0,0:41:46.95,0:41:49.89,Main,,0,0,0,,soylu olarak doğduğum için utanç duyuyorum!
Dialogue: 0,0:41:50.45,0:41:55.69,Thoughts,,0,0,0,,El kadar çocuğa söylettiğin laflara bak Goa!
Dialogue: 0,0:41:57.39,0:42:01.90,Main,,0,0,0,,Ne hissettiğini biliyorum. \NBen de burada doğdum.
Dialogue: 0,0:42:02.87,0:42:08.54,Main,,0,0,0,,Ancak hala burayı değiştirecek gücüm yok.
Dialogue: 0,0:42:08.54,0:42:12.34,Main,,0,0,0,,Yaşlı adam, beni gerçekten dinliyorsun değil mi?
Dialogue: 0,0:42:12.81,0:42:15.15,Main,,0,0,0,,Evet ve duyduklarımı asla unutmayacağım.

