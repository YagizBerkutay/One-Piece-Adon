Dialogue: 0,0:02:33.40,0:02:34.70,Main,,0,0,0,,Geliyorum!
Dialogue: 0,0:02:34.70,0:02:37.07,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu No...
Dialogue: 0,0:02:37.07,0:02:39.37,Main,,0,0,0,,{\fad(150,150)}Pistol!
Dialogue: 0,0:02:37.07,0:02:39.37,Attack,,0,0,0,,{\fad(150,150)}Tabanca
Dialogue: 0,0:02:43.68,0:02:45.48,Main,,0,0,0,,{Now tell me...}Bu ne lan...
Dialogue: 0,0:02:46.05,0:02:48.25,Main,,0,0,0,,Ne yaptığını sanıyorsun sen?!
Dialogue: 0,0:02:48.78,0:02:50.15,Main,,0,0,0,,1 puan!
Dialogue: 0,0:02:56.12,0:02:58.26,Main,,0,0,0,,Dediğim gibi,
Dialogue: 0,0:02:58.26,0:03:01.72,Main,,0,0,0,,senin bu lastik gücün ne işe yarar?
Dialogue: 0,0:02:58.66,0:03:06.03,Title,,30,0,250,,{\fad(1500,1500)}{Brotherly Pact}Kardeşlik Yemini
Dialogue: 0,0:03:01.72,0:03:07.23,Main,,0,0,0,,Kahretsin! Olmuyor! Çok yakındı!
Dialogue: 0,0:03:07.23,0:03:08.80,Main,,0,0,0,,Bir kez daha!
Dialogue: 0,0:03:08.80,0:03:12.50,Main,,0,0,0,,Olmaz! Kuralımız kişi başına 100 deneme.
Dialogue: 0,0:03:12.50,0:03:13.54,Main,,0,0,0,,Yarına kadar bekle.
Dialogue: 0,0:03:13.91,0:03:17.71,Main,,0,0,0,,Luffy bana ve Ace'e karşı ellişer kere kaybetti.
Dialogue: 0,0:03:17.71,0:03:21.28,Main,,0,0,0,,Ben vs. Ace ise 24-26.
Dialogue: 0,0:03:21.28,0:03:24.12,Main,,0,0,0,,2 farkla kaybettim. Kahretsin!
Dialogue: 0,0:03:24.12,0:03:28.39,Main,,0,0,0,,10 yaşıma geldiğimde ikinizi de döveceğim!
Dialogue: 0,0:03:28.39,0:03:32.62,Main,,0,0,0,,O zaman 13 yaşında olacağız. \NHadi akşam yemeği için bir şeyler alalım.
Dialogue: 0,0:03:41.37,0:03:42.97,Main,,0,0,0,,Pekala, Timsah kulağa geliyor!
Dialogue: 0,0:03:42.97,0:03:45.30,Main,,0,0,0,,Timsah etine bayılırım!
Dialogue: 0,0:03:45.30,0:03:48.34,Main,,0,0,0,,Luffy, bu sefer dikkat et de yem olma.
Dialogue: 0,0:03:48.84,0:03:51.54,Main,,0,0,0,,Geçen sefer hayatta kaldın çünkü seni tek parça halinde yutmuştu.
Dialogue: 0,0:03:52.85,0:03:56.52,Main,,0,0,0,,Burada bekle, Luffy. \NYüzemiyorsun o yüzden anca bizi yavaşlatırsın...
Dialogue: 0,0:03:56.78,0:03:58.82,Main,,0,0,0,,Timsah eti!
Dialogue: 0,0:03:58.82,0:04:01.75,Main,,0,0,0,,– Ne?!\N– "Bekle" dedim!!
Dialogue: 0,0:04:09.88,0:04:15.40,Narrator,,0,0,0,,Colubo Dağı'nın çetin koşulları \Ngünler geçtikçe onları güçlendirdi.
Dialogue: 0,0:04:17.44,0:04:19.22,Narrator,,0,0,0,,Dağın kuzey kısımlarında...
Dialogue: 0,0:04:20.31,0:04:24.31,Narrator,,0,0,0,,Toplumdan soyutlanmış her şeyin son durağı olan bir yer vardı, Gri Terminal adında.
Dialogue: 0,0:04:25.41,0:04:27.41,Narrator,,0,0,0,,Onun da kuzeyinde...
Dialogue: 0,0:04:28.41,0:04:33.12,Narrator,,0,0,0,,aşılması imkansız taştan duvarlar ile çevrelenmiş bir şehir.
Dialogue: 0,0:04:37.32,0:04:41.23,Narrator,,0,0,0,,Şehrin tek girişi,
Dialogue: 0,0:04:41.69,0:04:48.03,Narrator,,0,0,0,,şehrin bütün çöpünün günde iki sefer geçtiği dev bir geçit.
Dialogue: 0,0:04:49.57,0:04:54.04,Main,,0,0,0,,– Ah işte geliyorlar!\N– Define arama zamanı!
Dialogue: 0,0:04:54.41,0:05:00.71,Narrator,,0,0,0,,Gri Terminal'in yerlileri şehri zaman zaman bulduklarını satmak için ziyaret ederlerdi.
Dialogue: 0,0:05:06.48,0:05:08.49,Main,,0,0,0,,Hey, bekle! O taşıdığın ne?
Dialogue: 0,0:05:10.80,0:05:13.76,Main,,0,0,0,,Timsah derisi. Onu satmak için buradayım.
Dialogue: 0,0:05:13.76,0:05:14.39,Main,,0,0,0,,Timsah mı?
Dialogue: 0,0:05:17.53,0:05:18.83,Main,,0,0,0,,G-geçebilirsin!
Dialogue: 0,0:05:21.50,0:05:25.90,Narrator,,0,0,0,,Büyük kapının ardında, herkesin rahatça dolaşabildiği alabildiğine geniş bir bulvar vardı.
Dialogue: 0,0:05:25.90,0:05:27.61,Narrator,,0,0,0,,Kenar Şehir'e kadar uzanan.
Dialogue: 0,0:05:33.81,0:05:38.72,Narrator,,0,0,0,,Kenar Şehir sokak serserileri ve \Ngangsterlerin uğrak alanıydı.
Dialogue: 0,0:05:44.89,0:05:48.63,Main,,0,0,0,,Hey, babalık! Bohçanı bırak bakalım!
Dialogue: 0,0:05:52.00,0:05:54.87,Main,,0,0,0,,Hey, bir şey desene?!
Dialogue: 0,0:05:54.87,0:05:56.27,Main,,0,0,0,,Kes sesini.
Dialogue: 0,0:05:56.27,0:05:57.20,Main,,0,0,0,,Ne?!
Dialogue: 0,0:06:00.94,0:06:02.34,Main,,0,0,0,,S-seni küçük...
Dialogue: 0,0:06:02.34,0:06:04.18,Main,,0,0,0,,Birini gasp edeceksen,
Dialogue: 0,0:06:06.78,0:06:08.55,Main,,0,0,0,,kimi seçtiğine dikkat et!
Dialogue: 0,0:06:10.68,0:06:12.48,Main,,0,0,0,,Bunlar...
Dialogue: 0,0:06:13.39,0:06:14.55,Main,,0,0,0,,Hadi çocuklar!
Dialogue: 0,0:06:14.55,0:06:15.89,Main,,0,0,0,,{\i1}– Evet!\N– Hadi!
Dialogue: 0,0:06:33.24,0:06:38.21,Narrator,,0,0,0,,Şehrin içlerine doğru bir başka taştan duvar yükseliyordu.
Dialogue: 0,0:06:38.21,0:06:44.15,Narrator,,0,0,0,,Kraliyet ailesinin ve soyluların yaşadığı \NYüksek Şehri çevreliyordu.
Dialogue: 0,0:06:47.32,0:06:50.19,Narrator,,0,0,0,,Bu ülkenin adı Goa'ydı.
Dialogue: 0,0:06:50.19,0:06:51.62,Narrator,,0,0,0,,Sokakları tertemizdi
Dialogue: 0,0:06:51.62,0:06:55.43,Narrator,,0,0,0,,ve Doğu Mavi'nin en güzel ülkesi olduğu söylenirdi.
Dialogue: 3,0:06:58.56,0:07:00.87,Narrator,,0,0,0,,Luffy'nin doğduğu Foosha Köyü,
