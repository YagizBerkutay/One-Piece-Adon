Dialogue: 0,0:07:12.31,0:07:13.88,Note,,0,0,0,,Kaliteli Yemek - Eiichiro
Dialogue: 0,0:07:15.51,0:07:18.22,Main,,0,0,0,,3 porsiyon ramen hazır!\NBeklettiğimiz için özür dileriz!
Dialogue: 0,0:07:18.52,0:07:20.09,Main,,0,0,0,,Afiyet olsun!
Dialogue: 0,0:07:21.99,0:07:23.82,Main,,0,0,0,,Bu ramen mi?!
Dialogue: 0,0:07:23.82,0:07:25.99,Main,,0,0,0,,Çok güzel görünüyor!
Dialogue: 0,0:07:27.43,0:07:28.89,Main,,0,0,0,,Hadi deneyelim.
Dialogue: 0,0:07:30.70,0:07:32.26,Main,,0,0,0,,Leziz!
Dialogue: 0,0:07:34.20,0:07:35.93,Main,,0,0,0,,Evet çok güzel!
Dialogue: 0,0:07:39.87,0:07:40.94,Main,,0,0,0,,Daha fazla istiyorum!
Dialogue: 0,0:07:42.87,0:07:46.91,Main,,0,0,0,,3 kase daha lütfen!
Dialogue: 0,0:07:46.91,0:07:48.78,Main,,0,0,0,,Tabii ki! Buyrun!
Dialogue: 0,0:07:48.78,0:07:49.88,Main,,0,0,0,,Girebilir miyim?
Dialogue: 0,0:07:58.36,0:08:00.09,Main,,0,0,0,,Ş-şef!
Dialogue: 0,0:08:00.09,0:08:01.70,Main,,0,0,0,,Emin misin?!
Dialogue: 0,0:08:03.13,0:08:05.26,Main,,0,0,0,,Beyefendi, konuşmamız gerekiyor!
Dialogue: 0,0:08:05.60,0:08:07.99,Main,,0,0,0,,– Kahretsin, farkettiler!\N– Hadi tüyelim!
Dialogue: 0,0:08:08.90,0:08:10.67,Main,,0,0,0,,Ödeme yapmadılar!
Dialogue: 0,0:08:10.67,0:08:12.84,Main,,0,0,0,,Biri şunları yakalasın!
Dialogue: 0,0:08:14.04,0:08:17.34,Main,,0,0,0,,– Ramen harikaydı!\N– Demiştim ben!
Dialogue: 0,0:08:17.94,0:08:20.91,Main,,0,0,0,,– Yakalayalım mı?!\N– Daha çocuk bunlar!
Dialogue: 0,0:08:23.92,0:08:29.19,Main,,0,0,0,,Y-yine onlar! Tam bela bunlar! \NNeden onları içeri almışlar ki?!
Dialogue: 0,0:08:29.19,0:08:34.56,Main,,0,0,0,,Kaçmalarına izin vermeyin!\NBiri şu çocukları yakalasın!
Dialogue: 0,0:08:35.76,0:08:39.03,Main,,0,0,0,,Camdan atladıklarına inanamıyorum!
Dialogue: 0,0:08:39.03,0:08:41.83,Main,,0,0,0,,Burası 4. kat!
Dialogue: 0,0:08:41.83,0:08:46.04,Main,,0,0,0,,26 porsiyon ramen ve bir cam zarardayız!
Dialogue: 0,0:08:46.47,0:08:50.04,Main,,0,0,0,,Ş-şef! Bir not bırakmışlar!
