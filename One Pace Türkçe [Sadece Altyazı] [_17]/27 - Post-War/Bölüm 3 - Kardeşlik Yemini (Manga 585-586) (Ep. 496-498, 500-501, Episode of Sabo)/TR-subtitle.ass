00000000,&H96000000,0,-1,0,0,100,100,0,0,1,2.4,2.4,8,180,180,27,1Style: Sign-Map,VAG Rounded Std Light,30.0,&H004E4B4B,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0,0,2,10,10,10,1Style: Sign-Dad,Akbar,90.0,&H002E2E30,&H000000FF,&H00000000,&H00000000,-1,0,0,0,100,100,0,0,1,0,0,2,10,10,10,1Style: Sign-Independent,123Marker,225.0,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0,0,2,10,10,10,1Style: Sign-FineDining,FOT-Greco Std B,90.0,&H001E5179,&H000000FF,&H000B284C,&H00000000,0,0,0,0,100,100,0,0,1,3,0,2,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:03.62,0:00:06.49,Credits,,0,0,0,,Editing SewilDialogue: 0,0:00:06.49,0:00:09.22,Credits,,0,0,0,,Timing PhosCityDialogue: 0,0:00:09.22,0:00:11.76,Credits,,0,0,0,,Karaoke KaitouYahikoDialogue: 0,0:00:11.76,0:00:14.66,Credits,,0,0,0,,QC Galaxy 9000 Pepperjack Danpmss DolphinWeabuDialogue: 0,0:00:14.66,0:00:16.76,Credits,,0,0,0,,Translation Crunchyroll Funimation GaijinDialogue: 0,0:00:16.76,0:00:18.50,Credits,,0,0,0,,Raws df68Dialogue: 0,0:00:18.59,0:00:22.17,OP14 Translation,,0,0,0,,♪ Keşfedilmemiş yarınlarda buluşmaya,Dialogue: 0,0:00:22.26,0:00:26.69,OP14 Translation,,0,0,0,,yola çıkalım şafak sökmeden. ♪Dialogue: 0,0:00:26.97,0:00:30.33,OP14 Translation,,0,0,0,,♪ Kararımı verdim ve pişman değilim. ♪Dialogue: 0,0:00:30.55,0:00:33.35,OP14 Translation,,0,0,0,,♪ Ne yapmam gerektiğini çok iyi biliyorum. ♪Dialogue: 0,0:00:33.51,0:00:37.07,OP14 Translation,,0,0,0,,♪ Yolumuzda bizi her ne sınav bekliyor olursa olsun,Dialogue: 0,0:00:37.21,0:00:41.70,OP14 Translation,,0,0,0,,kalplerimizin atışını hiçbir şey durduramaz. ♪Dialogue: 0,0:00:41.81,0:00:46.35,OP14 Translation,,0,0,0,,♪ Hepimizin hedefinde tek bir yer var. ♪Dialogue: 0,0:00:46.57,0:00:48.30,OP14 Translation,,0,0,0,,♪ Işığa doğru atıl! ♪Dialogue: 0,0:00:48.32,0:00:52.09,OP14 Translation,,0,0,0,,♪ Savaşlarımız esnasında kurduğumuz bağlara,Dialogue: 0,0:00:52.16,0:00:55.67,OP14 Translation,,0,0,0,,hiç kimsenin zarar vermesine izin vermeyeceğim. ♪Dialogue: 0,0:00:55.80,0:00:58.47,OP14 Translation,,0,0,0,,♪ Yumruklarımızı sıkmayı bırakırsak,Dialogue: 0,0:00:58.60,0:01:01.71,OP14 Translation,,0,0,0,,içlerindeki asıl gücü bulacağız. ♪Dialogue: 0,0:01:01.87,0:01:04.13,OP14 Translation,,0,0,0,,♪ O halde hadi başlayalım! ♪Dialogue: 0,0:01:04.27,0:01:09.28,OP14 Translation,,0,0,0,,♪ Yepyeni bir dünya bizi çağırıyor. ♪Dialogue: 0,0:01:09.38,0:01:11.67,OP14 Translation,,0,0,0,,♪ İleriye bak! ♪Dialogue: 0,0:01:11.78,0:01:18.02,OP14 Translation,,0,0,0,,♪ Birbirimize destek olmayı asla bırakmayacağız,Dialogue: 0,0:01:18.08,0:01:21.79,OP14 Translation,,0,0,0,,aramızda sayısız deniz olsa bile. ♪Dialogue: 0,0:01:21.82,0:01:25.46,OP14 Translation,,0,0,0,,♪ Hadi korkularımızı bir kenara bırakıp, harekete geçelim. ♪Dialogue: 0,0:01:25.96,0:01:27.85,OP14 Translation,,0,0,0,,♪ Lütfen unutma,Dialogue: 0,0:01:27.97,0:01:29.14,OP14 Translation,,0,0,0,,beraber savaşıyoruz. ♪Dialogue: 0,0:01:29.86,0:01:37.12,OP14 Translation,,0,0,0,,♪ O gün baktığımız,Dialogue: 0,0:01:37.54,0:01:39.90,OP14 Translation,,0,0,0,,ufuktaki geniş, görkemli gökyüzü,Dialogue: 0,0:01:40.01,0:01:45.02,OP14 Translation,,0,0,0,,hala tertemiz. ♪Dialogue: 0,0:01:45.04,0:01:48.45,OP14 Translation,,0,0,0,,♪ Kalbimizin derinliklerinde ettiğimiz yeminler ileDialogue: 0,0:01:48.65,0:01:52.41,OP14 Translation,,0,0,0,,çok uzun bir yol geldik. ♪Dialogue: 0,0:01:52.45,0:01:54.99,OP14 Translation,,0,0,0,,♪ Korkacak hiçbir şey yok. ♪Dialogue: 0,0:01:55.05,0:01:59.42,OP14 Translation,,0,0,0,,♪ Hepimizin taşıması gereken yükler var. ♪Dialogue: 0,0:01:59.56,0:02:01.88,OP14 Translation,,0,0,0,,♪ Güneş doğuyorDialogue: 0,0:02:02.03,0:02:06.84,OP14 Translation,,0,0,0,,ve her şeyi aydınlatıyor, hüznümü bile... ♪Dialogue: 0,0:02:06.87,0:02:09.24,OP14 Translation,,0,0,0,,♪ İnanıyorum,Dialogue: 0,0:02:09.34,0:02:15.58,OP14 Translation,,0,0,0,,hepimizin bir olduğu bir geleceğe. ♪Dialogue: 0,0:02:15.71,0:02:19.30,OP14 Translation,,0,0,0,,♪ Hadi gidip onu beraber bulalım. ♪Dialogue: 0,0:02:19.38,0:02:23.11,OP14 Translation,,0,0,0,,♪ Senin yerini kimse dolduramaz. ♪Dialogue: 0,0:02:23.58,0:02:25.24,OP14 Translation,,0,0,0,,♪ Lütfen unutma! ♪Dialogue: 0,0:02:25.56,0:02:27.66,OP14 Translation,,0,0,0,,♪ Beraber savaşıyoruz. ♪Dialogue: 0,0:02:58.66,0:03:06.03,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Mantisentil thx to onepace.netDialogue: 0,0:21:59.10,0:22:09.10,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Mantisentil thx to onepace.netDialogue: 0,0:42:18.70,0:42:27.70,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Mantisentil thx to onepace.netDialogue: 0,0:02:33.40,0:02:34.70,Main,,0,0,0,,Geliyorum!Dialogue: 0,0:02:34.70,0:02:37.07,Main,,0,0,0,,Gomu Gomu No...Dialogue: 0,0:02:37.07,0:02:39.37,Main,,0,0,0,,Pistol!Dialogue: 0,0:02:37.07,0:02:39.37,Attack,,0,0,0,,TabancaDialogue: 0,0:02:43.68,0:02:45.48,Main,,0,0,0,,Bu ne lan...Dialogue: 0,0:02:46.05,0:02:48.25,Main,,0,0,0,,Ne yaptığını sanıyorsun sen?!Dialogue: 0,0:02:48.78,0:02:50.15,Main,,0,0,0,,1 puan!Dialogue: 0,0:02:56.12,0:02:58.26,Main,,0,0,0,,Dediğim gibi,Dialogue: 0,0:02:58.26,0:03:01.72,Main,,0,0,0,,senin bu lastik gücün ne işe yarar?Dialogue: 0,0:02:58.66,0:03:06.03,Title,,30,0,250,,Kardeşlik YeminiDialogue: 0,0:03:01.72,0:03:07.23,Main,,0,0,0,,Kahretsin! Olmuyor! Çok yakındı!Dialogue: 0,0:03:07.23,0:03:08.80,Main,,0,0,0,,Bir kez daha!Dialogue: 0,0:03:08.80,0:03:12.50,Main,,0,0,0,,Olmaz! Kuralımız kişi başına 100 deneme.Dialogue: 0,0:03:12.50,0:03:13.54,Main,,0,0,0,,Yarına kadar bekle.Dialogue: 0,0:03:13.91,0:03:17.71,Main,,0,0,0,,Luffy bana ve Ace'e karşı ellişer kere kaybetti.Dialogue: 0,0:03:17.71,0:03:21.28,Main,,0,0,0,,Ben vs. Ace ise 24-26.Dialogue: 0,0:03:21.28,0:03:24.12,Main,,0,0,0,,2 farkla kaybettim. Kahretsin!Dialogue: 0,0:03:24.12,0:03:28.39,Main,,0,0,0,,10 yaşıma geldiğimde ikinizi de döveceğim!Dialogue: 0,0:03:28.39,0:03:32.62,Main,,0,0,0,,O zaman 13 yaşında olacağız.  Hadi akşam yemeği için bir şeyler alalım.Dialogue: 0,0:03:41.37,0:03:42.97,Main,,0,0,0,,Pekala, Timsah kulağa geliyor!Dialogue: 0,0:03:42.97,0:03:45.30,Main,,0,0,0,,Timsah etine bayılırım!Dialogue: 0,0:03:45.30,0:03:48.34,Main,,0,0,0,,Luffy, bu sefer dikkat et de yem olma.Dialogue: 0,0:03:48.84,0:03:51.54,Main,,0,0,0,,Geçen sefer hayatta kaldın çünkü seni tek parça halinde yutmuştu.Dialogue: 0,0:03:52.85,0:03:56.52,Main,,0,0,0,,Burada bekle, Luffy.  Yüzemiyorsun o yüzden anca bizi yavaşlatırsın...Dialogue: 0,0:03:56.78,0:03:58.82,Main,,0,0,0,,Timsah eti!Dialogue: 0,0:03:58.82,0:04:01.75,Main,,0,0,0,,– Ne?! – "Bekle" dedim!!Dialogue: 0,0:04:09.88,0:04:15.40,Narrator,,0,0,0,,Colubo Dağı'nın çetin koşulları  günler geçtikçe onları güçlendirdi.Dialogue: 0,0:04:17.44,0:04:19.22,Narrator,,0,0,0,,Dağın kuzey kısımlarında...Dialogue: 0,0:04:20.31,0:04:24.31,Narrator,,0,0,0,,Toplumdan soyutlanmış her şeyin son durağı olan bir yer vardı, Gri Terminal adında.Dialogue: 0,0:04:25.41,0:04:27.41,Narrator,,0,0,0,,Onun da kuzeyinde...Dialogue: 0,0:04:28.41,0:04:33.12,Narrator,,0,0,0,,aşılması imkansız taştan duvarlar ile çevrelenmiş bir şehir.Dialogue: 0,0:04:37.32,0:04:41.23,Narrator,,0,0,0,,Şehrin tek girişi,Dialogue: 0,0:04:41.69,0:04:48.03,Narrator,,0,0,0,,şehrin bütün çöpünün günde iki sefer geçtiği dev bir geçit.Dialogue: 0,0:04:49.57,0:04:54.04,Main,,0,0,0,,– Ah işte geliyorlar! – Define arama zamanı!Dialogue: 0,0:04:54.41,0:05:00.71,Narrator,,0,0,0,,Gri Terminal'in yerlileri şehri zaman zaman bulduklarını satmak için ziyaret ederlerdi.Dialogue: 0,0:05:06.48,0:05:08.49,Main,,0,0,0,,Hey, bekle! O taşıdığın ne?Dialogue: 0,0:05:10.80,0:05:13.76,Main,,0,0,0,,Timsah derisi. Onu satmak için buradayım.Dialogue: 0,0:05:13.76,0:05:14.39,Main,,0,0,0,,Timsah mı?Dialogue: 0,0:05:17.53,0:05:18.83,Main,,0,0,0,,G-geçebilirsin!Dialogue: 0,0:05:21.50,0:05:25.90,Narrator,,0,0,0,,Büyük kapının ardında, herkesin rahatça dolaşabildiği alabildiğine geniş bir bulvar vardı.Dialogue: 0,0:05:25.90,0:05:27.61,Narrator,,0,0,0,,Kenar Şehir'e kadar uzanan.Dialogue: 0,0:05:33.81,0:05:38.72,Narrator,,0,0,0,,Kenar Şehir sokak serserileri ve  gangsterlerin uğrak alanıydı.Dialogue: 0,0:05:44.89,0:05:48.63,Main,,0,0,0,,Hey, babalık! Bohçanı bırak bakalım!Dialogue: 0,0:05:52.00,0:05:54.87,Main,,0,0,0,,Hey, bir şey desene?!Dialogue: 0,0:05:54.87,0:05:56.27,Main,,0,0,0,,Kes sesini.Dialogue: 0,0:05:56.27,0:05:57.20,Main,,0,0,0,,Ne?!Dialogue: 0,0:06:00.94,0:06:02.34,Main,,0,0,0,,S-seni küçük...Dialogue: 0,0:06:02.34,0:06:04.18,Main,,0,0,0,,Birini gasp edeceksen,Dialogue: 0,0:06:06.78,0:06:08.55,Main,,0,0,0,,kimi seçtiğine dikkat et!Dialogue: 0,0:06:10.68,0:06:12.48,Main,,0,0,0,,Bunlar...Dialogue: 0,0:06:13.39,0:06:14.55,Main,,0,0,0,,Hadi çocuklar!Dialogue: 0,0:06:14.55,0:06:15.89,Main,,0,0,0,,– Evet! – Hadi!Dialogue: 0,0:06:33.24,0:06:38.21,Narrator,,0,0,0,,Şehrin içlerine doğru bir başka taştan duvar yükseliyordu.Dialogue: 0,0:06:38.21,0:06:44.15,Narrator,,0,0,0,,Kraliyet ailesinin ve soyluların yaşadığı  Yüksek Şehri çevreliyordu.Dialogue: 0,0:06:47.32,0:06:50.19,Narrator,,0,0,0,,Bu ülkenin adı Goa'ydı.Dialogue: 0,0:06:50.19,0:06:51.62,Narrator,,0,0,0,,Sokakları tertemizdiDialogue: 0,0:06:51.62,0:06:55.43,Narrator,,0,0,0,,ve Doğu Mavi'nin en güzel ülkesi olduğu söylenirdi.Dialogue: 3,0:06:58.56,0:07:00.87,Narrator,,0,0,0,,Luffy'nin doğduğu Foosha Köyü,Dialogue: 0,0:07:00.33,0:07:00.53,Sign-Map,,0,0,0,,m -87 -85.5 l 96 -85.5 96 13.5 -87 13.5Dialogue: 1,0:07:00.33,0:07:00.53,Sign-Map,,0,0,0,,SarayDialogue: 0,0:07:00.33,0:07:00.53,Sign-Map,,0,0,0,,m -93 -112.5 l 96 -112.5 96 3 -93 3Dialogue: 1,0:07:00.33,0:07:00.53,Sign-Map,,0,0,0,,m -100.5 -87 l 106.5 -87 106.5 30 -100.5 30Dialogue: 1,0:07:00.33,0:07:00.80,Sign-Map,,0,0,0,,Yüksek ŞehirDialogue: 0,0:07:00.33,0:07:00.80,Sign-Map,,0,0,0,,m -97.5 -118.5 l 111 -118.5 111 3 -97.5 3Dialogue: 1,0:07:00.33,0:07:00.80,Sign-Map,,0,0,0,,Orta ŞehirDialogue: 0,0:07:00.33,0:07:00.80,Sign-Map,,0,0,0,,m -88.5 -114 l 79.5 -114 79.5 -6 -