Dialogue: 0,0:02:36.45,0:02:38.78,Main,,0,0,0,,Kaç, Luffy!
Dialogue: 0,0:02:44.90,0:02:46.93,Main,,0,0,0,,Hayır... Olamaz!
Dialogue: 0,0:02:47.53,0:02:49.60,Main,,0,0,0,,İnanamıyorum!
Dialogue: 0,0:02:49.92,0:02:51.79,Main,,0,0,0,,Kaptan, hiç şansımız yok!
Dialogue: 0,0:02:50.00,0:02:55.20,Title,,0,0,240,,{\pos(960,700)\fad(700,1000)}Sabo'nun Denizi
Dialogue: 0,0:02:51.79,0:02:53.54,Main,,0,0,0,,Yangını söndürme ihtimalimiz yok!
Dialogue: 0,0:02:53.54,0:02:57.12,Main,,0,0,0,,Gemiyi bırakmalıyız!\NDenize kaçamayız!
Dialogue: 0,0:02:57.12,0:03:00.93,Main,,0,0,0,,Kral'a lanet olsun! Bunu bize nasıl yapar?!
Dialogue: 0,0:03:00.93,0:03:03.16,Main,,0,0,0,,O piçe gününü göstereceğim!
Dialogue: 0,0:03:06.40,0:03:07.91,Main,,0,0,0,,Bakın şu işe!
Dialogue: 0,0:03:07.91,0:03:13.64,Main,,0,0,0,,Güneyde gökyüzünün gece bile parlaması ne kadar sinir bozucu.
Dialogue: 0,0:03:13.64,0:03:17.38,Main,,0,0,0,,Özür dileriz Ekselansları.\NPerdeleri kapatalım.
Dialogue: 0,0:03:22.53,0:03:27.62,Main,,0,0,0,,Söylesene baba, Gri Terminal'dekiler neden insan değil?
Dialogue: 0,0:03:27.62,0:03:29.79,Main,,0,0,0,,Neden yanmaları gerekiyor?
Dialogue: 0,0:03:29.79,0:03:34.42,Main,,0,0,0,,Hep dendiği gibi, "Herkes ektiğini biçer."
Dialogue: 0,0:03:34.42,0:03:35.66,Main,,0,0,0,,Düşünsene.
Dialogue: 0,0:03:35.66,0:03:40.97,Main,,0,0,0,,Soylu olarak doğarak kaderlerini değiştirebilirlerdi.
Dialogue: 0,0:03:41.40,0:03:43.18,Main,,0,0,0,,Soylu doğarak mı?
Dialogue: 0,0:03:44.05,0:03:48.48,Main,,0,0,0,,Evet! Soylu olarak doğmayı seçmelilerdi!
Dialogue: 0,0:03:49.17,0:03:50.44,Main,,0,0,0,,Ne kadar aptallar!
Dialogue: 0,0:03:50.44,0:03:55.02,Main,,0,0,0,,Hadi yeter bunlar hakkında konuştuğumuz,\Nyarın derslerin var.
Dialogue: 0,0:03:55.02,0:03:56.55,Main,,0,0,0,,Artık yatsan iyi olur.
Dialogue: 0,0:03:56.55,0:03:58.15,Main,,0,0,0,,Tamam!
Dialogue: 0,0:03:58.15,0:03:59.99,Main,,0,0,0,,İyi geceler.
Dialogue: 0,0:04:17.08,0:04:21.05,Main,,0,0,0,,--Bu tarafta çıkış yok!\N--Gittikçe kapana kısılıyoruz.
Dialogue: 0,0:04:21.05,0:04:22.84,Main,,0,0,0,,Burada böyle ölmek istemiyorum!
Dialogue: 0,0:04:25.31,0:04:27.91,Main,,0,0,0,,Acaba o yaşlı adamlar kaçabildi mi?
Dialogue: 0,0:04:27.91,0:04:30.48,Main,,0,0,0,,Başkaları hakkında endişelenecek vaktimiz yok!
Dialogue: 0,0:04:31.44,0:04:34.19,Main,,0,0,0,,Lanet olsun! Nerede olduğumuzu bile bilmiyorum!
Dialogue: 0,0:04:34.19,0:04:37.12,Main,,0,0,0,,Kaçabileceğinizi kim söyledi, veletler?!
Dialogue: 0,0:04:39.27,0:04:40.49,Main,,0,0,0,,Bluejam!
Dialogue: 0,0:04:42.95,0:04:46.07,Main,,0,0,0,,Neden hala buradasın?!
Dialogue: 0,0:04:46.07,0:04:48.17,Main,,0,0,0,,Şimdiye çoktan kaçmış olman gerekirdi!
Dialogue: 0,0:04:48.67,0:04:50.56,Main,,0,0,0,,Kes sesini seni küçük pislik!
Dialogue: 0,0:04:51.37,0:04:54.11,Main,,0,0,0,,Ümitsiz bir durumdayız.
Dialogue: 0,0:04:55.17,0:04:57.58,Main,,0,0,0,,Beklenmedik bir ikilem içindeyiz.
Dialogue: 0,0:04:58.52,0:05:01.75,Main,,0,0,0,,İnsanlar garip yaratıklar değil mi?
Dialogue: 0,0:05:03.14,0:05:06.82,Main,,0,0,0,,Dibe vurduğunda bir gülme alıyor insanı.
Dialogue: 0,0:05:14.31,0:05:16.76,Main,,0,0,0,,Garip davranıyorlar.
Dialogue: 0,0:05:17.65,0:05:18.66,Main,,0,0,0,,Luffy, hadi gidelim!
Dialogue: 0,0:05:18.66,0:05:20.23,Main,,0,0,0,,Kaçmalarına müsae etmeyin!
Dialogue: 0,0:05:28.54,0:05:32.35,Main,,0,0,0,,O kadar birlikte çalıştık, biz arkadaşız!
Dialogue: 0,0:05:32.35,0:05:34.54,Main,,0,0,0,,Beraber ölmeliyiz!
Dialogue: 0,0:05:34.54,0:05:38.49,Main,,0,0,0,,Sizle birlikte ölmek istemiyoruz!\NHayatta olmaz!
Dialogue: 0,0:05:38.49,0:05:40.15,Main,,0,0,0,,Ne kadar donuksun.
Dialogue: 0,0:05:40.15,0:05:45.69,Main,,0,0,0,,Düşününce, hazinenizi nerede sakladığınızı bana söylemediniz.
Dialogue: 0,0:05:46.37,0:05:51.53,Main,,0,0,0,,Yangın ona ulaşmadan onu kurtaracağım. Söyleyin nerede.
Dialogue: 0,0:05:51.53,0:05:54.73,Main,,0,0,0,,Hayatın tehlikede ve hala hazineyi mi düşünüyorsun?
Dialogue: 0,0:05:54.73,0:05:58.18,Main,,0,0,0,,Umursamıyorsanız söyleyin nerede.
Dialogue: 0,0:06:00.66,0:06:02.84,Main,,0,0,0,,Sen aklını kaybetmişsin.
Dialogue: 0,0:06:03.07,0:06:06.88,Main,,0,0,0,,Gidip almayacaksanız ziyan olacak.
Dialogue: 0,0:06:06.88,0:06:12.05,Main,,0,0,0,,Bir şey yapılmazsa gemim gibi yangında kömür olacak.
Dialogue: 0,0:06:12.05,0:06:14.22,Main,,0,0,0,,Ne büyük kayıp.
Dialogue: 0,0:06:14.71,0:06:17.25,Main,,0,0,0,,Saçmalama! O hazine...
Dialogue: 0,0:06:17.25,0:06:19.38,Main,,0,0,0,,Tamam sana söyleyeceğim!
Dialogue: 0,0:06:19.89,0:06:24.14,Main,,0,0,0,,Ace! Sabo ve sen o hazine için çok...
Dialogue: 0,0:06:24.14,0:06:26.34,Main,,0,0,0,,Sabo anlayacaktır!
Dialogue: 0,0:06:27.37,0:06:29.09,Main,,0,0,0,,Şu an tek önemli olan senin...
Dialogue: 0,0:06:30.00,0:06:33.04,Main,,0,0,0,,Şu an tek önemli olan bizim hayatta kalmamız!
Dialogue: 0,0:06:39.70,0:06:41.53,Main,,0,0,0,,Ace...
Dialogue: 0,0:06:49.49,0:06:53.83,Main,,0,0,0,,Son 6 yıldır topladığımız hazineyi bu ağaçta saklıyoruz.
Dialogue: 0,0:06:53.83,0:06:55.37,Main,,0,0,0,,Anladım.
Dialogue: 0,0:06:56.78,0:06:58.29,Main,,0,0,0,,Ağlama!
Dialogue: 0,0:06:58.29,0:07:01.71,Main,,0,0,0,,Sorun değil. Bu her şeyin sonu değil.
Dialogue: 0,0:07:07.35,0:07:10.18,Main,,0,0,0,,Napıyorsunuz?! Size nerede olduğunu söyledim!
Dialogue: 0,0:07:10.18,0:07:13.03,Main,,0,0,0,,Haklısın. Bu her şeyin sonu değil.
Dialogue: 0,0:07:13.89,0:07:17.88,Main,,0,0,0,,Yani yalan söylüyor olabilirsin.\NBizimle geleceksiniz.
Dialogue: 0,0:07:17.88,0:07:22.50,Main,,0,0,0,,Olmaz! Kaçmak için çok geç olacak!
Dialogue: 0,0:07:22.50,0:07:23.89,Main,,0,0,0,,Neden kendi başınıza gitmiyorsunuz?!
Dialogue: 0,0:07:27.75,0:07:31.86,Main,,0,0,0,,Şu an benle zıtlaşmak istemezsin.
Dialogue: 0,0:07:31.86,0:07:35.40,Main,,0,0,0,,Soylulardan intikam almaya yemin ettim,
Dialogue: 0,0:07:35.40,0:07:37.63,Main,,0,0,0,,çocuklardan çalmam gerekse bile
Dialogue: 0,0:07:37.63,0:07:40.88,Main,,0,0,0,,onlardan intikamımı alacağım.
Dialogue: 0,0:07:40.88,0:07:43.74,Main,,0,0,0,,Kardeşiniz de onlardan biri.
Dialogue: 0,0:07:43.74,0:07:47.58,Main,,0,0,0,,Kendilerini çok özel sanıyorlar
Dialogue: 0,0:07:48.05,0:07:51.85,Main,,0,0,0,,ve diğer herkese çöp muamelesi yapıyorlar!
Dialogue: 0,0:07:51.85,0:07:54.52,Main,,0,0,0,,Sabo öyle biri değil!
Dialogue: 0,0:07:54.52,0:07:57.16,Main,,0,0,0,,O da aynı onlar gibi aptal!
Dialogue: 0,0:07:57.83,0:08:02.09,Main,,0,0,0,,Sadece kendini üstün hissedebilmek için size takılıyordu!
Dialogue: 0,0:08:02.09,0:08:03.76,Main,,0,0,0,,Bu doğru değil!
Dialogue: 0,0:08:04.41,0:08:06.74,Main,,0,0,0,,Ailesi çok varlıklı.
Dialogue: 0,0:08:06.74,0:08:09.20,Main,,0,0,0,,Hiçbir şeyi dert etmesine gerek yok!
Dialogue: 0,0:08:09.52,0:08:12.47,Main,,0,0,0,,Sizle sadece vakit öldürüyordu.
Dialogue: 0,0:08:12.47,0:08:15.63,Main,,0,0,0,,Size üstten bakıp...
Dialogue: 0,0:08:15.63,0:08:17.28,Main,,0,0,0,,içten içe gülüyordu!
Dialogue: 0,0:08:17.28,0:08:19.91,Main,,0,0,0,,Sabo hakkında böyle konuşmayı kes!
Dialogue: 0,0:08:19.91,0:08:22.92,Main,,0,0,0,,Evet, Sabo sadece özgür olmak istiyor!
Dialogue: 0,0:08:24.22,0:08:26.02,Main,,0,0,0,,Seni küçük pislik!
Dialogue: 0,0:08:26.02,0:08:26.89,Main,,0,0,0,,Luffy!
Dialogue: 0,0:08:31.22,0:08:32.66,Main,,0,0,0,,Seni öldüreceğim!
Dialogue: 0,0:08:36.88,0:08:38.09,Main,,0,0,0,,Bırak beni!
Dialogue: 0,0:08:41.90,0:08:44.50,Main,,0,0,0,,Luffy'e dokunma!!
Dialogue: 0,0:09:14.47,0:09:15.90,Main,,0,0,0,,Luffy! İyi misin?!
Dialogue: 0,0:09:18.03,0:09:19.70,Main,,0,0,0,,Ne yaptın sen?!
Dialogue: 0,0:09:22.24,0:09:24.14,Main,,0,0,0,,Lanet olsun...
Dialogue: 0,0:09:24.14,0:09:26.47,Main,,0,0,0,,Seni ucube velet!
Dialogue: 0,0:09:26.95,0:09:30.01,Main,,0,0,0,,Beni de mi aptal yerine koyacaksın ha?!
Dialogue: 0,0:09:30.01,0:09:32.31,Main,,0,0,0,,Kes sesini, seni pislik!
Dialogue: 0,0:09:33.22,0:09:35.39,Main,,0,0,0,,Seni şerefsiz!
Dialogue: 0,0:09:36.27,0:09:38.40,Main,,0,0,0,,Ace!
Dialogue: 0,0:09:38.40,0:09:40.66,Main,,0,0,0,,Yapma!
Dialogue: 0,0:09:52.50,0:09:53.34,Main,,0,0,0,,Dadan!
Dialogue: 0,0:09:55.31,0:09:58.31,Main,,0,0,0,,Dur, seni pis gerzek!
Dialogue: 0,0:10:00.81,0:10:03.71,Main,,0,0,0,,Ace'i bırak!
Dialogue: 0,0:10:14.94,0:10:16.46,Main,,0,0,0,,Burada ne arıyorsunuz?
Dialogue: 0,0:10:17.12,0:10:18.50,Main,,0,0,0,,Sonunda sizi bulduk!
Dialogue: 0,0:10:18.50,0:10:22.87,Main,,0,0,0,,Yaraların çok ciddi Luffy! İyi misin?
Dialogue: 0,0:10:23.56,0:10:25.39,Main,,0,0,0,,Dogra...
Dialogue: 0,0:10:26.71,0:10:29.61,Main,,0,0,0,,Sabo'yu hiçbir yerde göremiyorum!
Dialogue: 0,0:10:29.61,0:10:33.21,Main,,0,0,0,,Sabo evine gitti. Burada değil.
Dialogue: 0,0:10:37.94,0:10:39.43,Main,,0,0,0,,Ace!
Dialogue: 0,0:10:39.43,0:10:42.97,Main,,0,0,0,,Sen Corvo Dağı'ndaki patron maymun değil misin!
Dialogue: 0,0:10:42.97,0:10:45.10,Main,,0,0,0,,Ben dağ eşkiyası, Dadan!
Dialogue: 0,0:10:45.10,0:10:49.93,Main,,0,0,0,,Neden bilmiyorum ama onların koruyucu ebeveyniyim.
Dialogue: 0,0:10:55.30,0:10:56.84,Main,,0,0,0,,Pekala...
Dialogue: 0,0:11:01.96,0:11:03.48,Main,,0,0,0,,Kaçın!
Dialogue: 0,0:11:03.48,0:11:05.41,Main,,0,0,0,,Emredersin patron!
Dialogue: 0,0:11:06.86,0:11:08.91,Main,,0,0,0,,Hey, napıyorsun?!
Dialogue: 0,0:11:08.91,0:11:11.08,Main,,0,0,0,,Ace, acele et!
Dialogue: 0,0:11:11.53,0:11:12.68,Main,,0,0,0,,Ace!
Dialogue: 0,0:11:13.29,0:11:14.32,Main,,0,0,0,,Ben...
Dialogue: 0,0:11:16.94,0:11:18.56,Main,,0,0,0,,...kaçmayacağım!
Dialogue: 0,0:11:20.19,0:11:24.43,Main,,0,0,0,,Ne diyorsun, Ace?!\NOnunla dövüşme!
Dialogue: 0,0:11:24.63,0:11:27.57,Main,,0,0,0,,Bluejam acımasız bir suçlu!
Dialogue: 0,0:11:27.57,0:11:31.24,Main,,0,0,0,,Senin gibi bir çocuğun yenebileceği biri değil!
Dialogue: 0,0:11:31.24,0:11:34.82,Main,,0,0,0,,--B-bırak ben de dövüşeyim!\N--Hayır, Luffy!
Dialogue: 0,0:11:38.04,0:11:41.98,Main,,0,0,0,,Siz Luffy'i alıp gidin!
Dialogue: 0,0:11:41.98,0:11:43.32,Main,,0,0,0,,P-patron!
Dialogue: 0,0:11:43.72,0:11:47.84,Main,,0,0,0,,Ace'i sağ salim eve getirmek benim sorumluluğum!
Dialogue: 0,0:11:49.19,0:11:50.96,Main,,0,0,0,,Patron!
Dialogue: 0,0:11:52.36,0:11:53.73,Main,,0,0,0,,Gidin!
Dialogue: 0,0:11:53.73,0:11:56.48,Main,,0,0,0,,--E-emredersiniz!\N--Ace!
Dialogue: 0,0:11:56.48,0:12:00.07,Main,,0,0,0,,Patron! Eve güvende dön!
Dialogue: 0,0:12:04.12,0:12:06.57,Main,,0,0,0,,Bir kadın ve bir çocuk.
Dialogue: 0,0:12:07.83,0:12:13.14,Main,,0,0,0,,Kendinizi böyle üstün görürseniz anca kendinize zarar verirsiniz!
Dialogue: 0,0:12:13.82,0:12:18.02,Main,,0,0,0,,Sadece güçlüler ve korkaklar savaşta hayatta kalır!
Dialogue: 0,0:12:18.66,0:12:22.21,Main,,0,0,0,,Cesurlar her zaman ölür.
Dialogue: 0,0:12:22.89,0:12:24.90,Main,,0,0,0,,Öyle mi?
Dialogue: 0,0:12:25.58,0:12:26.66,Main,,0,0,0,,Aptal!
Dialogue: 0,0:12:36.74,0:12:40.24,Main,,0,0,0,,Lanet olsun!
Dialogue: 0,0:12:40.24,0:12:44.40,Main,,0,0,0,,Öleceğim! Yangın her yere yayılmış!
Dialogue: 0,0:12:44.40,0:12:46.95,Main,,0,0,0,,Bir anda böyle bir şey nasıl oldu?!
Dialogue: 0,0:12:46.95,0:12:51.28,Main,,0,0,0,,--Sıcak! Çok sıcak!\N--Dışarı çıkış yok!
Dialogue: 0,0:12:55.65,0:12:57.72,Main,,0,0,0,,Yapacak hiçbir şeyimiz yok!
Dialogue: 0,0:13:22.64,0:13:24.62,Main,,0,0,0,,Ne oldu böyle?
Dialogue: 0,0:13:25.51,0:13:27.19,Main,,0,0,0,,Bir yol var!
Dialogue: 0,0:13:27.37,0:13:29.85,Main,,0,0,0,,Patlama yolu açtı!
Dialogue: 0,0:13:29.85,0:13:31.99,Main,,0,0,0,,Nasıl oldu bilmiyorum ama işte şansımız bu!
Dialogue: 0,0:13:31.99,0:13:36.10,Main,,0,0,0,,Bakın bir gemi var!
Dialogue: 0,0:13:36.10,0:13:37.86,Main,,0,0,0,,Bir gemi görüyorum!
Dialogue: 0,0:13:37.86,0:13:40.43,Main,,0,0,0,,Bu yol sahile çıkıyor!
Dialogue: 0,0:13:40.43,0:13:42.99,Main,,0,0,0,,Buradan kaçabiliriz!
Dialogue: 0,0:13:43.39,0:13:47.04,Main,,0,0,0,,Yangın yayılmadan gidelim!
Dialogue: 0,0:13:49.94,0:13:55.21,Main,,0,0,0,,Burayı insanlarla birlikte yakmak ne berbat!
Dialogue: 0,0:13:55.45,0:13:57.49,Main,,0,0,0,,Bu arada,
Dialogue: 0,0:13:57.49,0:14:02.26,Main,,0,0,0,,Doğu Mavi'nin ücra bir ülkesinde durumun bu halde olduğunu nereden biliyordun?
Dialogue: 0,0:14:02.74,0:14:06.32,Main,,0,0,0,,Bu ülkeyi özel kılan bir şey mi var?
Dialogue: 0,0:14:06.32,0:14:10.33,Main,,0,0,0,,Bu ülke gelecekte dünyanın nasıl bir yer olacağının örneği.
Dialogue: 0,0:14:10.57,0:14:16.63,Main,,0,0,0,,Gereksiz gördüğü insanları harcamaktan çekinmeyen bir ülkede mutluluktan söz edilemez.
Dialogue: 0,0:14:16.63,0:14:21.67,Main,,0,0,0,,Bir gün dünyayı değiştireceğim, yemin ederim!
Dialogue: 0,0:14:21.89,0:14:27.35,Flashbacks,,0,0,0,,Burada kalırsam asla özgür olamayacağım!
Dialogue: 0,0:14:28.47,0:14:33.05,Main,,0,0,0,,Her çocuk masum doğar, böyle bir ülkede doğsalar bile.
Dialogue: 0,0:14:44.66,0:14:49.16,Main,,0,0,0,,Özgürlüğü için yanımda savaşmak isteyenler...
Dialogue: 0,0:14:49.16,0:14:51.60,Main,,0,0,0,,Gemime gelin!
Dialogue: 0,0:14:54.17,0:14:57.08,Main,,0,0,0,,{\i1}Evet!{\i0}
Dialogue: 0,0:14:57.08,0:14:59.86,Captions,,0,0,0,,{\fad(500,500)\pos(780,1035)}Goa Krallığı
Dialogue: 0,0:14:57.08,0:14:59.86,Captions,,0,0,0,,{\fad(500,500)\pos(1208,1037)}"Kraliyet Sarayı"
Dialogue: 0,0:15:04.86,0:15:10.22,Main,,0,0,0,,Kenar Şehir güvende mi? Alevler her an bizi sarabilir!
Dialogue: 0,0:15:12.96,0:15:17.30,Main,,0,0,0,,Yüksek Şehir'e sığınma şansımız var mı?
Dialogue: 0,0:15:17.30,0:15:18.65,Main,,0,0,0,,Hayır yok.
Dialogue: 0,0:15:19.23,0:15:22.90,Main,,0,0,0,,Soylular hariç bir böceğin bile girmesine müsade etmezler!
Dialogue: 0,0:15:22.90,0:15:27.61,Main,,0,0,0,,--Patron!\N--Patron!
Dialogue: 0,0:15:28.08,0:15:29.81,Main,,0,0,0,,Ace!
Dialogue: 0,0:15:29.81,0:15:31.90,Main,,0,0,0,,Patron!
Dialogue: 0,0:15:31.90,0:15:34.20,Main,,0,0,0,,Ace!
Dialogue: 0,0:15:34.20,0:15:36.97,Main,,0,0,0,,Patron!
Dialogue: 0,0:15:38.22,0:15:40.72,Narrator,,0,0,0,,{\an2}Ace ve Dadan...
Dialogue: 0,0:15:40.72,0:15:46.58,Narrator,,0,0,0,,{\an2}Gri Terminal'in alevleri içinde kaldılar ve geri dönmediler.
Dialogue: 0,0:15:51.36,0:15:53.42,Main,,0,0,0,,Dur, dur... Bekle, Luffy.
Dialogue: 0,0:15:53.42,0:15:55.67,Main,,0,0,0,,Bu haldeyken kıpırdamamalısın.
Dialogue: 0,0:15:55.67,0:15:58.69,Main,,0,0,0,,Ace ve Dadan'ı bulmaya gideceğim!
Dialogue: 0,0:15:58.69,0:16:00.22,Main,,0,0,0,,Aptallık etme!
Dialogue: 0,0:16:01.94,0:16:06.68,Main,,0,0,0,,Yaraların çok derin. Sakin ol ve dinlen.
Dialogue: 0,0:16:06.68,0:16:09.27,Main,,0,0,0,,Şu anda Gri Terminal yangın sonrası temizlik için askerlerle dolu.
Dialogue: 0,0:16:13.74,0:16:21.23,Main,,0,0,0,,Ve sadece yangın kalıntılarını değil hayatta kalanları da temizliyorlar.
Dialogue: 0,0:16:21.23,0:16:23.99,Main,,0,0,0,,Oraya gidersen seni öldürürler.
Dialogue: 0,0:16:23.99,0:16:25.53,Main,,0,0,0,,Ama...!
Dialogue: 0,0:16:35.84,0:16:38.54,Main,,0,0,0,,Ace'i görmek istiyorum!
Dialogue: 0,0:16:38.54,0:16:42.64,Main,,0,0,0,,Sabo da bizim için endişelidir eminim!
Dialogue: 0,0:16:45.48,0:16:47.65,Captions,,0,0,25,,{\fad(500,0)}Gri Terminal'den geriye kalanlar
Dialogue: 0,0:16:51.36,0:16:55.31,Main,,0,0,0,,Emirler kesin, hayatta kalanları vurun...
Dialogue: 0,0:16:55.31,0:16:56.69,Main,,0,0,0,,Sanki bundan sağ kalan olabilirmiş gibi!
Dialogue: 0,0:16:57.03,0:17:00.05,Main,,0,0,0,,Ama tahmin ettiğimden daha az ceset var...
Dialogue: 0,0:17:00.05,0:17:03.40,Main,,0,0,0,,Yangın ne kadar büyüktü gördün. Kemiklerine kadar yanmış olmalılar.
Dialogue: 0,0:17:05.40,0:17:11.64,Main,,0,0,0,,Dün yangının duvarı aşıp şehre ulaşmasından endişeliydim...
Dialogue: 0,0:17:11.64,0:17:14.38,Main,,0,0,0,,Duydum ki Bluejam'in gemisi de yanmış.
Dialogue: 0,0:17:14.38,0:17:18.82,Main,,0,0,0,,En azından o haydutların yanması iyi olmuş.
Dialogue: 0,0:17:24.32,0:17:27.39,Main,,0,0,0,,Ne kadar denersen dene kaçamazsın Sabo!
Dialogue: 0,0:17:27.97,0:17:33.03,Main,,0,0,0,,Bütün polis ve askerlerin elinde resmin var!
Dialogue: 0,0:17:33.03,0:17:36.46,Main,,0,0,0,,Yüksek Şehir'den asla kaçamazsın...
Dialogue: 0,0:17:36.46,0:17:38.07,Main,,0,0,0,,bu evden de!
Dialogue: 0,0:17:39.50,0:17:44.90,Main,,0,0,0,,Siz ikiniz üniformalarınızı değiştirin ve burada nöbetçi olarak çalışmaya başlayın.
Dialogue: 0,0:17:44.90,0:17:46.98,Main,,0,0,0,,Ama bizim başka görevlerimiz var...
Dialogue: 0,0:17:46.98,0:17:50.77,Main,,0,0,0,,Bir soylunun emriyle olmayacak şey yok.
Dialogue: 0,0:17:50.77,0:17:53.34,Main,,0,0,0,,Üstlerinizin onayını alırım.
Dialogue: 0,0:17:57.02,0:18:00.15,Main,,0,0,0,,Sabo, odana kapanıp...
Dialogue: 0,0:18:00.15,0:18:03.73,Main,,0,0,0,,bir soylu olarak kendini yetiştirmelisin!
Dialogue: 0,0:18:03.73,0:18:04.71,Main,,0,0,0,,Hayır!
Dialogue: 0,0:18:04.71,0:18:10.54,Main,,0,0,0,,Bildiğin gibi sadece emrimle bir çok şeyi yapabilirim.
Dialogue: 0,0:18:10.54,0:18:14.73,Main,,0,0,0,,O yüzden istersem senin ve o ikisinin icabına bakarım.
Dialogue: 0,0:18:15.39,0:18:17.11,Main,,0,0,0,,Anlatabildim mi?
Dialogue: 0,0:18:18.27,0:18:19.77,Main,,0,0,0,,Baba...
Dialogue: 0,0:18:22.16,0:18:25.78,Main,,0,0,0,,Ace... Luffy...
Dialogue: 0,0:18:30.05,0:18:36.33,Main,,0,0,0,,Eğer anlıyorsan istediğim gibi davranmaya başla.\NStelly gibi ders çalışmaya başla.
Dialogue: 0,0:18:36.33,0:18:43.87,Main,,0,0,0,,Ve diğer pek çok konuda kendini eğiterek seni dünyaya getiren anne ve babanı mutlu et.
Dialogue: 0,0:18:44.65,0:18:48.07,Main,,0,0,0,,Senin mutluluğun bu.
Dialogue: 0,0:18:48.07,0:18:50.07,Main,,0,0,0,,Öyle değil mi?
Dialogue: 0,0:18:52.34,0:18:54.37,Main,,0,0,0,,Baba!
Dialogue: 0,0:18:55.92,0:18:58.18,Main,,0,0,0,,Endişelenme! Ben senin için buradayım!
Dialogue: 0,0:19:00.33,0:19:02.74,Main,,0,0,0,,Ne kadar güvenilirsin, Stelly!
Dialogue: 0,0:19:02.74,0:19:05.62,Main,,0,0,0,,Pekala! Sana yepyeni harika kıyafetler alacağım!
Dialogue: 0,0:19:05.62,0:19:07.95,Main,,0,0,0,,Seremoni 2 gün sonra.
Dialogue: 0,0:19:07.95,0:19:10.84,Main,,0,0,0,,Kutsal Ejder ile bizzat tanışacağız!
Dialogue: 0,0:19:19.72,0:19:22.97,Main,,0,0,0,,Yarına kadar ödevlerini bitir.
Dialogue: 0,0:19:23.34,0:19:25.60,Main,,0,0,0,,Pekala, iyi günler.
Dialogue: 0,0:19:34.66,0:19:37.59,Main,,0,0,0,,Ace... Luffy...
Dialogue: 0,0:19:38.09,0:19:42.06,Main,,0,0,0,,O yangında ölmüş olamazsınız değil mi?
Dialogue: 0,0:19:42.75,0:19:45.96,Main,,0,0,0,,Güvendesiniz değil mi?
Dialogue: 0,0:19:55.87,0:19:59.88,Main,,0,0,0,,Sizi görmeyi çok istiyorum...
Dialogue: 0,0:20:02.01,0:20:07.79,Main,,0,0,0,,Ama yanınıza gelirsem sadece hayatınızı tehlikeye atmış olurum...
Dialogue: 0,0:20:08.49,0:20:10.49,Main,,0,0,0,,Burası bir kafes gibi...
Dialogue: 0,0:20:11.04,0:20:16.75,Main,,0,0,0,,Bu krallıkta yaşamaya, bu bozuk havayı solumaya dayanabileceğimden emin değilim.
Dialogue: 0,0:20:23.21,0:20:25.95,Main,,0,0,0,,Özgürlük... nedir ki?
Dialogue: 0,0:20:26.64,0:20:28.49,Main,,0,0,0,,Onu nerede bulabilirim?
Dialogue: 0,0:20:32.04,0:20:34.28,Main,,0,0,0,,Pekala artık gidiyoruz.
Dialogue: 0,0:20:34.70,0:20:37.64,Main,,0,0,0,,Sabo'ya göz kulak olun.
Dialogue: 0,0:20:37.64,0:20:39.65,Main,,0,0,0,,Anlaşıldı Efendim.
Dialogue: 0,0:20:59.14,0:21:06.28,Main,,0,0,0,,Bugün Grand Line'dan Goa Krallığı'na Dünya Soyluları'ndan biri geliyor.
Dialogue: 0,0:21:06.56,0:21:12.11,Main,,0,0,0,,Gemiyi karşılamak için büyük bir seremoni hazırlandı.
Dialogue: 0,0:21:17.34,0:21:20.97,Main,,0,0,0,,Hey, hey! Orada biri var!
Dialogue: 0,0:21:21.73,0:21:23.33,Main,,0,0,0,,--Ne?\N--Balıkçı teknesi mi o?
Dialogue: 0,0:21:25.55,0:21:30.62,Main,,0,0,0,,Hey! Buraya gel! Seremoniyi bölme!
Dialogue: 0,0:21:31.30,0:21:35.81,Main,,0,0,0,,Bu bir çocuk! Gemide bir çocuk var!
Dialogue: 0,0:21:35.81,0:21:39.88,Main,,0,0,0,,Çocuk mu? Acaba hangi aileden.
Dialogue: 0,0:21:39.88,0:21:41.25,Main,,0,0,0,,Çocuk mu?
Dialogue: 0,0:21:43.04,0:21:45.14,Main,,0,0,0,,Hava ne kadar güzel!
Dialogue: 0,0:21:45.14,0:21:46.95,Main,,0,0,0,,Deniz açılmak için harika bir gün!
Dialogue: 0,0:21:52.45,0:21:55.72,Main,,0,0,0,,Hey, hey! O benim gemim!
Dialogue: 0,0:21:55.72,0:21:58.37,Main,,0,0,0,,Balıkçı teknemi çalmış!
Dialogue: 0,0:21:58.37,0:22:01.18,Main,,0,0,0,,Bakın! Kara bir bayrak çekmiş!
Dialogue: 0,0:22:01.18,0:22:03.77,Main,,0,0,0,,Korsan olduğunu mu sanıyor?!
Dialogue: 0,0:22:03.77,0:22:06.47,Main,,0,0,0,,İmkanı yok! Çocuğun biri korsan olacak değil ya!
Dialogue: 0,0:22:06.85,0:22:11.18,Main,,0,0,0,,--Nereye gidiyor?\N--Seremoniyi bozacak.
Dialogue: 0,0:22:11.18,0:22:14.38,Main,,0,0,0,,Dünya Hükümeti'nin gemisi birazdan burada olacak!
Dialogue: 0,0:22:14.38,0:22:16.00,Main,,0,0,0,,Acele edin, bir şey yapın!
Dialogue: 0,0:22:16.00,0:22:17.55,Main,,0,0,0,,E-emredersiniz!
Dialogue: 0,0:22:17.55,0:22:19.22,Main,,0,0,0,,Hey!
Dialogue: 0,0:22:19.46,0:22:23.19,Main,,0,0,0,,Çocuk, hemen buraya gel!
Dialogue: 0,0:22:25.14,0:22:29.99,Main,,0,0,0,,En çok korktuğum şey... bu ülke tarafından sindirilip tüketilmek,
Dialogue: 0,0:22:30.60,0:22:33.26,Main,,0,0,0,,ve sonunda bambaşka biri olmak!
Dialogue: 0,0:22:36.75,0:22:38.98,Main,,0,0,0,,Asla geri dönmeyeceğim!
Dialogue: 0,0:22:42.02,0:22:45.38,Main,,0,0,0,,O Sabo olamaz değil mi?!
Dialogue: 0,0:22:47.20,0:22:51.34,Main,,0,0,0,,Hükümet'in gemisi burada!
Dialogue: 0,0:23:09.30,0:23:12.24,Main,,0,0,0,,Kocaman bir gemi!
Dialogue: 0,0:23:12.24,0:23:14.78,Main,,0,0,0,,Gemiye çarparsam öleceğim.
Dialogue: 0,0:23:15.45,0:23:16.93,Main,,0,0,0,,Kenarından geçeyim.
Dialogue: 0,0:23:21.82,0:23:26.33,Main,,0,0,0,,O kadar kutsallar ki onları görme şansına erişmek bile olağanüstü!
Dialogue: 0,0:23:26.33,0:23:30.38,Main,,0,0,0,,Gerçek bir Kutsal Ejder'in o gemide olduğuna inanamıyorum!
Dialogue: 0,0:23:31.52,0:23:34.13,Main,,0,0,0,,O nedir?
Dialogue: 0,0:23:34.86,0:23:37.66,Main,,0,0,0,,Bir balıkçı teknesine benziyor.
Dialogue: 0,0:23:41.58,0:23:45.43,Main,,0,0,0,,Bir gün böyle bir geminin kaptanı olmak güzel olurdu!
Dialogue: 0,0:24:02.06,0:24:04.16,Main,,0,0,0,,Ace ölmedi!
Dialogue: 0,0:24:04.16,0:24:08.21,Main,,0,0,0,,Biliyorum sakinleş biraz. Nasıl hissettiğini anlayabiliyorum.
Dialogue: 0,0:24:08.21,0:24:10.86,Main,,0,0,0,,Ama şu an Gri Terminal'e gitmek çok riskli.
Dialogue: 0,0:24:10.86,0:24:13.13,Main,,0,0,0,,yaralısın ve her yer asker kaynıyor!
Dialogue: 0,0:24:13.13,0:24:17.71,Main,,0,0,0,,--Ama...!\N--Devasa bir yangındı! Kurtulma ihtimalleri...
Dialogue: 0,0:24:18.14,0:24:23.94,Main,,0,0,0,,...çok az ama yine de Patron ve Ace'in hayatta olduğuna inanmak istiyoruz.
Dialogue: 0,0:24:23.94,0:24:27.35,Main,,0,0,0,,Dogra onları aramak için oraya gitti, ona güven ve bekle.
Dialogue: 0,0:24:28.14,0:24:32.08,Main,,0,0,0,,Sadece senin için değil, bu herkes için zor bir durum Luffy.
Dialogue: 0,0:24:35.91,0:24:39.26,Main,,0,0,0,,--Balıkçı teknesi vuruldu!\N--Çocuğun durumu nasıl?
Dialogue: 0,0:24:39.26,0:24:41.89,Main,,0,0,0,,Kutsal Ejder'in tepesini attırdı!
Dialogue: 0,0:24:42.24,0:24:43.46,Main,,0,0,0,,Sabo!
Dialogue: 0,0:24:44.27,0:24:47.50,Main,,0,0,0,,Lanet olsun! Alevler gemiye yayılıyor!
Dialogue: 0,0:24:47.50,0:24:48.97,Main,,0,0,0,,Niye bana ateş açtılar ki?
Dialogue: 0,0:24:49.73,0:24:52.74,Main,,0,0,0,,Aziz Jalmack! Gemide bir çocuk var!
Dialogue: 0,0:24:52.74,0:24:57.24,Main,,0,0,0,,Biri kara bayrak çekmişse korsandır, çocuk olması farketmez.
Dialogue: 0,0:24:57.42,0:24:59.81,Main,,0,0,0,,Ama her şeyden önce...
Dialogue: 0,0:25:04.17,0:25:05.25,Main,,0,0,0,,Lanet olsun!
Dialogue: 0,0:25:05.25,0:25:09.75,Main,,0,0,0,,Halk tabakasından biri asla gemimin önüne çıkamaz!
Dialogue: 0,0:25:23.37,0:25:26.23,Main,,0,0,0,,Hey! O gemi ne yapıyor öyle?
Dialogue: 0,0:25:26.23,0:25:28.17,Main,,0,0,0,,Bu önemli bir seremoni!
Dialogue: 0,0:25:28.17,0:25:31.68,Main,,0,0,0,,Kutsal Ejder'in keyfini kaçırmak istemeyiz!
Dialogue: 0,0:25:31.68,0:25:34.37,Main,,0,0,0,,Enkazı kaldırın hemen!
Dialogue: 0,0:25:56.78,0:25:58.07,Main,,0,0,0,,Hey!
Dialogue: 0,0:25:58.07,0:26:00.57,Main,,0,0,0,,Hey, millet, onlar...
Dialogue: 0,0:26:00.57,0:26:01.74,Main,,0,0,0,,Ne oldu?
Dialogue: 0,0:26:02.90,0:26:05.11,Main,,0,0,0,,Geri döndüler!
Dialogue: 0,0:26:26.00,0:26:27.97,Main,,0,0,0,,İçim öyle rahatladı ki!
Dialogue: 0,0:26:28.45,0:26:31.27,Main,,0,0,0,,Ace... Patron...
Dialogue: 0,0:26:31.27,0:26:35.24,Main,,0,0,0,,Ağır yaralı!\NAcele edin ve tedaviye başlayın!
Dialogue: 0,0:26:35.63,0:26:37.37,Main,,0,0,0,,Bir şeyin yok ya?
Dialogue: 0,0:26:39.18,0:26:41.05,Main,,0,0,0,,Ace!
Dialogue: 0,0:26:41.58,0:26:42.68,Main,,0,0,0,,Luffy!
Dialogue: 0,0:26:45.08,0:26:48.15,Main,,0,0,0,,Öldüm mü sandın?
Dialogue: 0,0:26:48.15,0:26:50.45,Main,,0,0,0,,--Ama...!\N--Neden ağlıyorsun?!
Dialogue: 0,0:26:51.90,0:26:54.44,Main,,0,0,0,,Hayattayım işte, ölmüşüm gibi davranma, aptal!
Dialogue: 0,0:26:54.44,0:26:57.33,Main,,0,0,0,,Sakin ol.
Dialogue: 0,0:26:57.82,0:26:59.96,Main,,0,0,0,,Luffy sadece hayatta olduğun için mutlu.
Dialogue: 0,0:27:05.78,0:27:08.18,Main,,0,0,0,,Yangının olduğu gece ile ilgili soru sorabilir miyim?
Dialogue: 0,0:27:08.18,0:27:10.54,Main,,0,0,0,,Luffy ile ayrıldıktan sonra,
Dialogue: 0,0:27:10.54,0:27:13.66,Main,,0,0,0,,sana ve Patron'a ne oldu?
Dialogue: 0,0:27:15.30,0:27:18.15,Main,,0,0,0,,Siz gittikten sonra Bluejam ile dövüştük...
Dialogue: 0,0:27:20.23,0:27:22.20,Main,,0,0,0,,Bir şekilde kazandık...
Dialogue: 0,0:27:25.71,0:27:28.92,Main,,0,0,0,,Ve size yetişmeye çalıştık...
Dialogue: 0,0:27:29.72,0:27:32.08,Main,,0,0,0,,Ama yol çoktan kapanmıştı.
Dialogue: 0,0:27:32.70,0:27:35.02,Main,,0,0,0,,Dadan ciddi şekilde yandı.
Dialogue: 0,0:27:35.35,0:27:39.47,Main,,0,0,0,,Ormanın ortalarına doğru nehrin kenarında yangının ulaşamayacağı bir yerde saklandık.
Dialogue: 0,0:27:45.22,0:27:49.40,Main,,0,0,0,,Yiyecek ve ilaç çalabilmek için şehire gittim.
Dialogue: 0,0:27:50.17,0:27:53.30,Main,,0,0,0,,Ve çaresizce Dadan'ı hayatta tutmaya çalıştım.
Dialogue: 0,0:27:59.89,0:28:01.91,Main,,0,0,0,,Pekala bütün olanlar bunlar mı?
Dialogue: 0,0:28:01.91,0:28:05.29,Main,,0,0,0,,İkiniz de kurtulduğunuz için çok mutluyum.
Dialogue: 0,0:28:05.29,0:28:07.06,Main,,0,0,0,,Endişelendirdiğim için üzgünüm..
Dialogue: 0,0:28:07.96,0:28:11.86,Main,,0,0,0,,Gri Terminal'de böyle bir şeyin olabileceğine ihtimal bile vermezdim...
Dialogue: 0,0:28:11.86,0:28:13.81,Main,,0,0,0,,Eminim Sabo çok endişelidir.
Dialogue: 0,0:28:17.38,0:28:21.61,Main,,0,0,0,,Başka küstah alelade tipler ortaya çıkabilir.
Dialogue: 0,0:28:21.61,0:28:24.08,Main,,0,0,0,,Gözünüzü dört açın.
Dialogue: 0,0:28:24.08,0:28:24.75,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:28:29.95,0:28:32.67,Main,,0,0,0,,Acaba Sabo ne yapıyor...
Dialogue: 0,0:28:32.67,0:28:37.51,Main,,0,0,0,,En azından Ace geri döndü ve Dadan iyileşiyor.
Dialogue: 0,0:28:38.60,0:28:41.25,Main,,0,0,0,,Ace, o anda...
Dialogue: 0,0:28:41.90,0:28:43.21,Flashbacks,,0,0,0,,Ben...
Dialogue: 0,0:28:43.21,0:28:44.46,Flashbacks,,0,0,0,,kaçmayacağım!
Dialogue: 0,0:28:45.81,0:28:47.67,Main,,0,0,0,,Neden kaçmadın?
Dialogue: 0,0:28:48.08,0:28:51.52,Main,,0,0,0,,Bazen kan beynime sıçrıyor...
Dialogue: 0,0:28:51.52,0:28:56.22,Main,,0,0,0,,Sanki kaçarsam önemli bir şeyi kaybedecekmişim gibi hissediyorum.
Dialogue: 0,0:28:56.22,0:28:57.14,Main,,0,0,0,,Orada...
Dialogue: 0,0:28:59.60,0:29:02.94,Main,,0,0,0,,Luffy tam arkamdaydı.
Dialogue: 0,0:29:03.71,0:29:05.97,Main,,0,0,0,,Emin değilim ama galiba bu yüzden.
Dialogue: 0,0:29:09.79,0:29:12.95,Flashbacks,,0,0,0,,Roger, karşısında kaybedeceği koca bir ordudan bile...
Dialogue: 0,0:29:14.23,0:29:16.91,Main,,0,0,0,,asla kaçmadı, savaştı.
Dialogue: 0,0:29:16.91,0:29:19.97,Main,,0,0,0,,Canına mı susamıştı?\NKaçmak da savaşın bir parçasıdır.
Dialogue: 0,0:29:19.97,0:29:21.92,Main,,0,0,0,,Evet ama o hiç kaçmadı.
Dialogue: 0,0:29:21.92,0:29:25.81,Main,,0,0,0,,Çünkü yakınları da onunla beraberdi.
Dialogue: 0,0:29:25.81,0:29:29.69,Main,,0,0,0,,Beraber kaçsalar onların da hayatlarını tehlikeye atacaktı.
Dialogue: 0,0:29:29.69,0:29:33.66,Main,,0,0,0,,Aslına bakarsan savaştan hiç kaçmadı değil de...
Dialogue: 0,0:29:33.66,0:29:38.18,Main,,0,0,0,,düşmanlarının kaçmasına asla izin vermedi, tayfasına bir zarar vermelerinden çekindiği için.
Dialogue: 0,0:29:38.18,0:29:41.69,Main,,0,0,0,,Roger o haldeyken gerçekten bir şeytan gibiydi.
Dialogue: 0,0:29:41.69,0:29:46.19,Main,,0,0,0,,Devasa orduları yok ettiği oldu, sadece tayfası hakkında kötü konuştukları için.
Dialogue: 0,0:29:46.80,0:29:51.02,Main,,0,0,0,,Tepesini attırdıklarında sert, bencil ve acımasız olurdu...
Dialogue: 0,0:29:51.02,0:29:56.67,Main,,0,0,0,,Ama bir yandan da yaptıkları bir çocuğun hareketleri kadar içten ve yalındı.
Dialogue: 0,0:29:56.67,0:29:59.78,Main,,0,0,0,,Eminim Ace gibi bir hayat yaşadı o da.
Dialogue: 0,0:29:59.78,0:30:04.13,Main,,0,0,0,,Sevdiği insanları kaybetmenin düşüncesinden bile nefret ederdi.
Dialogue: 0,0:30:07.41,0:30:13.34,Main,,0,0,0,,Pervasız hayat tarzı ve şansı onu Korsanlar Kralı yaptı.
Dialogue: 0,0:30:14.31,0:30:19.71,Main,,0,0,0,,Dünyada berbat bir şöhreti vardı ama tayfasının ona duyduğu güven sınırsızdı.
Dialogue: 0,0:30:19.71,0:30:24.53,Main,,0,0,0,,Bir Denizci olmama rağmen asla ondan nefret edemedim.
Dialogue: 0,0:30:25.33,0:30:28.31,Main,,0,0,0,,Bu yüzden Ace'e göz kulak olmaya karar verdim.
Dialogue: 0,0:30:28.31,0:30:30.36,Main,,0,0,0,,Ona beraber göz kulak oluyoruz!
Dialogue: 0,0:30:30.36,0:30:33.15,Main,,0,0,0,,Ha?! Bununla bir sorunun mu var.
Dialogue: 0,0:30:33.15,0:30:34.70,Main,,0,0,0,,Ah hayır, hem de hiç yok.
Dialogue: 0,0:30:35.96,0:30:39.75,Thoughts,,0,0,0,,Hala tüm dünya Roger'dan nefret ediyor...
Dialogue: 0,0:30:39.75,0:30:45.00,Thoughts,,0,0,0,,Sanırım Ace de babasından nefret ediyor ama yine de onun kanını taşıyor.
Dialogue: 0,0:30:45.00,0:30:48.84,Main,,0,0,0,,Pekala... Kim kazanacak?
Dialogue: 0,0:30:48.84,0:30:50.09,Main,,0,0,0,,Dogra!
Dialogue: 0,0:30:51.56,0:30:54.70,Main,,0,0,0,,Ace ve Dadan'a bakmaya gittin değil mi?
Dialogue: 0,0:30:54.70,0:30:56.26,Main,,0,0,0,,Eve geri döndüler!
Dialogue: 0,0:30:57.06,0:31:01.10,Main,,0,0,0,,Gerçekten mi? Bu harika...
Dialogue: 0,0:31:01.63,0:31:03.53,Main,,0,0,0,,N-ne?!
Dialogue: 0,0:31:03.53,0:31:04.69,Main,,0,0,0,,Sabo...
Dialogue: 0,0:31:05.86,0:31:07.44,Main,,0,0,0,,Yalancı!
Dialogue: 0,0:31:07.81,0:31:09.78,Main,,0,0,0,,Bunun şakasını bile yapma!
Dialogue: 0,0:31:09.78,0:31:10.94,Main,,0,0,0,,Yapma, Ace!
Dialogue: 0,0:31:10.94,0:31:13.73,Main,,0,0,0,,Yalan söylemiyorum, şaka da yapmıyorum!
Dialogue: 0,0:31:13.73,0:31:17.74,Main,,0,0,0,,Aniden oldu, ben de anlayamadım. Gözlerime inanamadım!
Dialogue: 0,0:31:17.74,0:31:20.87,Main,,0,0,0,,Hayal görüyorum sandım!
Dialogue: 0,0:31:20.87,0:31:24.47,Main,,0,0,0,,Kes sesini! Sabo soylu ailesinin yanına döndü!
Dialogue: 0,0:31:24.47,0:31:26.79,Main,,0,0,0,,Denize açılmış olmasının imkanı yok!
Dialogue: 0,0:31:26.79,0:31:28.85,Main,,0,0,0,,Evet! Sabo eve gitti...
Dialogue: 0,0:31:28.85,0:31:32.07,Main,,0,0,0,,Bizim gibi suçlular onu anlayabilir...
Dialogue: 0,0:31:32.07,0:31:34.57,Main,,0,0,0,,Hepimizin dönmek istemediğimiz yerler var!
Dialogue: 0,0:31:35.71,0:31:41.18,Main,,0,0,0,,Sence gerçekten mutlu olsaydı, denize açılır mıydı?
Dialogue: 0,0:31:41.18,0:31:46.83,Main,,0,0,0,,Korsan bayrağını çekip tek başına denize açılır mıydı ha?
Dialogue: 0,0:31:56.41,0:31:57.66,Main,,0,0,0,,Sabo...
Dialogue: 0,0:31:58.53,0:32:01.28,Main,,0,0,0,,O mutlu değildi!
Dialogue: 0,0:32:03.10,0:32:06.49,Flashbacks,,0,0,0,,Ailem olsa bile yapayalnızdım!
Dialogue: 0,0:32:06.49,0:32:11.17,Main,,0,0,0,,N-neden onu orada kurtarmaya çalışmadık?!
Dialogue: 0,0:32:12.02,0:32:16.60,Main,,0,0,0,,Sabo'yu kim öldürdü?! Onu öldüreceğim!
Dialogue: 0,0:32:16.60,0:32:19.39,Main,,0,0,0,,K-Kutsal Ejder'i mi?! Bunu asla yapamaz-
Dialogue: 0,0:32:19.39,0:32:21.05,Main,,0,0,0,,İntikamını alacağım!
Dialogue: 0,0:32:21.05,0:32:22.55,Main,,0,0,0,,Bekle, Ace!
Dialogue: 0,0:32:23.59,0:32:25.39,Main,,0,0,0,,Vazgeç bundan velet!
Dialogue: 0,0:32:25.83,0:32:27.35,Main,,0,0,0,,Bırak beni...
Dialogue: 0,0:32:27.35,0:32:28.56,Main,,0,0,0,,Yolumdan çekil!
Dialogue: 0,0:32:28.89,0:32:32.88,Main,,0,0,0,,Sert adam rolleri kesiyorsun ama yapabileceğin hiçbir şey yok!
Dialogue: 0,0:32:33.36,0:32:36.69,Main,,0,0,0,,Ne yapacağını sanıyorsun?! Gidip kendini öldürteceksin!
Dialogue: 0,0:32:36.69,0:32:41.85,Main,,0,0,0,,Öleceksin ve yarın herkes seni unutacak! Etin budun bu kadar senin!
Dialogue: 0,0:32:42.67,0:32:47.41,Main,,0,0,0,,Sabo'yu bu krallık öldürdü!\NDünya'nın kendisi öldürdü!
Dialogue: 0,0:32:47.41,0:32:49.84,Main,,0,0,0,,Ne yapabilirsin ki?!
Dialogue: 0,0:32:50.99,0:32:53.88,Main,,0,0,0,,Babanın ölümü dünyada yeni bir deviri başlattı!
Dialogue: 0,0:32:53.88,0:32:59.05,Main,,0,0,0,,Onun kalibresine çıktığında istediğin gibi yaşar istediğin gibi ölürsün!
Dialogue: 0,0:33:02.51,0:33:04.89,Main,,0,0,0,,Bağlayın şu aptalı!
Dialogue: 0,0:33:04.89,0:33:04.91,Main,,0,0,0,,Ah evet...\NBağlayın şu aptalı!
Dialogue: 0,0:33:04.91,0:33:06.06,Main,,0,0,0,,Ah evet...
Dialogue: 0,0:33:06.58,0:33:10.70,Main,,0,0,0,,Sabo!
Dialogue: 0,0:33:10.70,0:33:11.69,Main,,0,0,0,,Lanet olsun!
Dialogue: 0,0:33:13.87,0:33:18.81,Main,,0,0,0,,Ağlamayı kes! Erkek adam öyle ağlamaz, Luffy!
Dialogue: 0,0:33:34.46,0:33:37.42,Main,,0,0,0,,Biraz sekinleştin mi, Ace?
Dialogue: 0,0:33:41.28,0:33:42.78,Main,,0,0,0,,Çözün onu.
Dialogue: 0,0:33:42.78,0:33:43.42,Main,,0,0,0,,Anlaşıldı.
Dialogue: 0,0:33:44.97,0:33:46.90,Main,,0,0,0,,Gevşeteyim şunları.
Dialogue: 0,0:33:46.90,0:33:48.01,Main,,0,0,0,,Luffy nerede?
Dialogue: 0,0:33:48.01,0:33:50.58,Main,,0,0,0,,Bütün gece ağladı. Şimdi uyuyor.
Dialogue: 0,0:33:51.91,0:33:54.93,Main,,0,0,0,,Patron! bunu görmelisin!
Dialogue: 0,0:33:54.93,0:33:57.77,Main,,0,0,0,,B-bir mektup! Sabo'dan!
Dialogue: 0,0:33:56.06,0:34:00.65,Main,,0,0,0,,{\an8\fs51}"Corvo Dağı'ndaki kardeşlerime - Sabo"
Dialogue: 0,0:33:57.77,0:34:00.65,Main,,0,0,0,,Denize açılmadan bir mektup bırakmış!
Dialogue: 0,0:34:01.98,0:34:03.17,Main,,0,0,0,,Ver onu bana.
Dialogue: 0,0:34:03.17,0:34:07.28,Main,,0,0,0,,Şehire gitmeyeceğim söz veriyorum.\NMektup bize yazılmış değil mi?
Dialogue: 0,0:34:13.59,0:34:18.09,Main,,0,0,0,,{\i1}Ace, Luffy. Umarım yangında yaralanmadınız.{\i0}
Dialogue: 0,0:34:18.09,0:34:20.93,Main,,0,0,0,,{\i1}Endişeliyim ama inanıyorum ki iyisiniz.{\i0}
Dialogue: 0,0:34:21.52,0:34:27.20,Main,,0,0,0,,{\i1}Üzgünüm ama siz bu mektubu okuduğunuzda ben...{\i0}
Dialogue: 0,0:34:28.24,0:34:30.09,Main,,0,0,0,,{\i1}çoktan denize açılmış olacağım.{\i0}
Dialogue: 0,0:34:31.27,0:34:35.05,Main,,0,0,0,,{\i1}Çok şey oldu ve ben denize sizden önce açılmaya karar verdim.{\i0}
Dialogue: 0,0:34:40.59,0:34:44.55,Main,,0,0,0,,{\i1}Hedefim bu ülkede değil, başka bir yerde.{\i0}
Dialogue: 0,0:34:45.64,0:34:47.98,Main,,0,0,0,,{\i1}Orada güçleneceğim...{\i0}
Dialogue: 0,0:34:48.62,0:34:50.66,Main,,0,0,0,,{\i1}Bir korsan olacağım!{\i0}
Dialogue: 0,0:34:51.81,0:34:57.30,Main,,0,0,0,,{\i1}Herkesten daha özgür korsanlar olalım ve bir gün tekrar görüşelim, üçümüz.{\i0}
Dialogue: 0,0:34:58.22,0:35:03.90,Main,,0,0,0,,{\i1}Engin özgür okyanuslarda bir yerde... Bir gün görüşeceğiz, eminim!{\i0}
Dialogue: 0,0:35:06.06,0:35:07.65,Main,,0,0,0,,{\i1}Ah ve Ace...{\i0}
Dialogue: 0,0:35:08.25,0:35:11.64,Main,,0,0,0,,{\i1}Merak ediyorum ikimizden hangisi büyük kardeş?{\i0}
Dialogue: 0,0:35:12.28,0:35:15.90,Main,,0,0,0,,{\i1}İki ağabey ve bir küçük kardeş...{\i0}
Dialogue: 0,0:35:16.76,0:35:20.73,Main,,0,0,0,,{\i1}Kulağa garip gelebilir ama aramızdaki bu bağ benim en büyük hazinem...{\i0}
Dialogue: 0,0:35:26.06,0:35:30.61,Main,,0,0,0,,{\i1}Luffy hala ağlak ve güçsüz ama...{\i0}
Dialogue: 0,0:35:36.34,0:35:40.44,Main,,0,0,0,,{\i1}o bizim kardeşimiz! Ona iyi bak!{\i0}
Dialogue: 0,0:00:03.62,0:00:06.49,Credits,,0,0,0,,{\fad(800,400)\fs60\pos(108,978)}Editing\N{\fs75}Sewil
Dialogue: 0,0:00:06.49,0:00:09.22,Credits,,0,0,0,,{\fad(600,400)\fs60\pos(108,978)}Timing\N{\fs75}Sewil
Dialogue: 0,0:00:09.22,0:00:11.76,Credits,,0,0,0,,{\fad(600,400)\fs60\pos(108,978)}Karaoke\N{\fs75}KaitouYahiko
Dialogue: 0,0:00:11.76,0:00:14.66,Credits,,0,0,0,,{\an1\fad(600,400)\fs60\pos(108,978)}QC\N{\fs75}Galaxy 9000\NPepperjack\NDanpmss\NDolphinWeabu
Dialogue: 0,0:00:14.66,0:00:16.76,Credits,,0,0,0,,{\fad(600,400)\fs60\pos(108,978)}Translation\N{\fs75}Crunchyroll\NFunimation\NYibis
Dialogue: 0,0:00:16.76,0:00:18.50,Credits,,0,0,0,,{\fad(600,600)\fs60\pos(108,978)}Raws\N{\fs75}df68
Dialogue: 0,0:00:18.59,0:00:22.17,OP14 Translation,,0,0,0,,♪ Keşfedilmemiş yarınlarda buluşmaya,
Dialogue: 0,0:00:22.26,0:00:26.69,OP14 Translation,,0,0,0,,yola çıkalım şafak sökmeden. ♪
Dialogue: 0,0:00:26.97,0:00:30.33,OP14 Translation,,0,0,0,,♪ Kararımı verdim ve pişman değilim. ♪
Dialogue: 0,0:00:30.55,0:00:33.35,OP14 Translation,,0,0,0,,♪ Ne yapmam gerektiğini çok iyi biliyorum. ♪
Dialogue: 0,0:00:33.51,0:00:37.07,OP14 Translation,,0,0,0,,♪ Yolumuzda bizi her ne sınav bekliyor olursa olsun,
Dialogue: 0,0:00:37.21,0:00:41.70,OP14 Translation,,0,0,0,,kalplerimizin atışını hiçbir şey durduramaz. ♪
Dialogue: 0,0:00:41.81,0:00:46.35,OP14 Translation,,0,0,0,,♪ Hepimizin hedefinde tek bir yer var. ♪
Dialogue: 0,0:00:46.57,0:00:48.30,OP14 Translation,,0,0,0,,♪ Işığa doğru atıl! ♪
Dialogue: 0,0:00:48.32,0:00:52.09,OP14 Translation,,0,0,0,,♪ Savaşlarımız esnasında kurduğumuz bağlara,
Dialogue: 0,0:00:52.16,0:00:55.67,OP14 Translation,,0,0,0,,hiç kimsenin zarar vermesine izin vermeyeceğim. ♪
Dialogue: 0,0:00:55.80,0:00:58.47,OP14 Translation,,0,0,0,,♪ Yumruklarımızı sıkmayı bırakırsak,
Dialogue: 0,0:00:58.60,0:01:01.71,OP14 Translation,,0,0,0,,içlerindeki asıl gücü bulacağız. ♪
Dialogue: 0,0:01:01.87,0:01:04.13,OP14 Translation,,0,0,0,,♪ O halde hadi başlayalım! ♪
Dialogue: 0,0:01:04.27,0:01:09.28,OP14 Translation,,0,0,0,,♪ Yepyeni bir dünya bizi çağırıyor. ♪
Dialogue: 0,0:01:09.38,0:01:11.67,OP14 Translation,,0,0,0,,♪ İleriye bak! ♪
Dialogue: 0,0:01:11.78,0:01:18.02,OP14 Translation,,0,0,0,,♪ Birbirimize destek olmayı asla bırakmayacağız,
Dialogue: 0,0:01:18.08,0:01:21.79,OP14 Translation,,0,0,0,,aramızda sayısız deniz olsa bile. ♪
Dialogue: 0,0:01:21.82,0:01:25.46,OP14 Translation,,0,0,0,,♪ Hadi korkularımızı bir kenara bırakıp, harekete geçelim. ♪
Dialogue: 0,0:01:25.96,0:01:27.85,OP14 Translation,,0,0,0,,♪ Lütfen unutma,
Dialogue: 0,0:01:27.97,0:01:29.14,OP14 Translation,,0,0,0,,beraber savaşıyoruz. ♪
Dialogue: 0,0:01:29.86,0:01:37.12,OP14 Translation,,0,0,0,,♪ O gün baktığımız,
Dialogue: 0,0:01:37.54,0:01:39.90,OP14 Translation,,0,0,0,,ufuktaki geniş, görkemli gökyüzü,
Dialogue: 0,0:01:40.01,0:01:45.02,OP14 Translation,,0,0,0,,hala tertemiz. ♪
Dialogue: 0,0:01:45.04,0:01:48.45,OP14 Translation,,0,0,0,,♪ Kalbimizin derinliklerinde ettiğimiz yeminler ile
Dialogue: 0,0:01:48.65,0:01:52.41,OP14 Translation,,0,0,0,,çok uzun bir yol geldik. ♪
Dialogue: 0,0:01:52.45,0:01:54.99,OP14 Translation,,0,0,0,,♪ Korkacak hiçbir şey yok. ♪
Dialogue: 0,0:01:55.05,0:01:59.42,OP14 Translation,,0,0,0,,♪ Hepimizin taşıması gereken yükler var. ♪
Dialogue: 0,0:01:59.56,0:02:01.88,OP14 Translation,,0,0,0,,♪ Güneş doğuyor
Dialogue: 0,0:02:02.03,0:02:06.84,OP14 Translation,,0,0,0,,ve her şeyi aydınlatıyor, hüznümü bile... ♪
Dialogue: 0,0:02:06.87,0:02:09.24,OP14 Translation,,0,0,0,,♪ İnanıyorum,
Dialogue: 0,0:02:09.34,0:02:15.58,OP14 Translation,,0,0,0,,hepimizin bir olduğu bir geleceğe. ♪
Dialogue: 0,0:02:15.71,0:02:19.30,OP14 Translation,,0,0,0,,♪ Hadi gidip onu beraber bulalım. ♪
Dialogue: 0,0:02:19.38,0:02:23.11,OP14 Translation,,0,0,0,,♪ Senin yerini kimse dolduramaz. ♪
Dialogue: 0,0:02:23.58,0:02:25.24,OP14 Translation,,0,0,0,,♪ Lütfen unutma! ♪
Dialogue: 0,0:02:25.56,0:02:27.66,OP14 Translation,,0,0,0,,♪ Beraber savaşıyoruz. ♪
