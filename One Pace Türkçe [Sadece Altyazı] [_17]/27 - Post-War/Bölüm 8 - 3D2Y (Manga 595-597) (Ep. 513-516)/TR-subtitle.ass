00,100,0,0,1,2.4,2.4,8,180,180,27,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:02:31.39,0:02:40.06,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Mantisentil thx to onepace.netDialogue: 0,0:30:10.50,0:30:20.50,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Mantisentil thx to onepace.netDialogue: 0,0:59:57.60,1:00:00.50,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Mantisentil thx to onepace.netDialogue: 0,0:02:34.18,0:02:36.70,Narrator,,0,0,0,,Beyazsakal'ın devri bitti.Dialogue: 1,0:02:35.37,0:02:41.11,Captions,,0,0,0,,Grand Line, Sabaody Takımadaları yakınlarıDialogue: 0,0:02:36.70,0:02:41.11,Narrator,,0,0,0,,Dünyanın dört bir yanındaki korsanlar hırsından yerinde duramıyor.Dialogue: 0,0:02:41.11,0:02:45.01,Narrator,,0,0,0,,Öte yandan , Trafalgar Law...Dialogue: 0,0:02:45.01,0:02:47.63,Main,,0,0,0,,Ne? Hala gitmiyor muyuz?Dialogue: 0,0:02:47.63,0:02:49.92,Main,,0,0,0,,Hadi artık Yeni Dünya'ya gidelim!Dialogue: 0,0:02:49.92,0:02:53.97,Main,,0,0,0,,Size söylediğim gibi, doğru zamanı bekliyoruz.Dialogue: 0,0:02:53.32,0:02:58.89,Captions,,0,0,0,,Trafalgar LawDialogue: 0,0:02:53.97,0:02:55.25,Main,,0,0,0,,Acele etmeyin.Dialogue: 0,0:02:55.25,0:02:58.89,Main,,0,0,0,,Büyük hazine, One Piece, bir yere kaçmıyor ya.Dialogue: 0,0:02:58.89,0:03:03.25,Main,,0,0,0,,Ama Karasakal ve tayfası Yeni Dünya'da ortalığı karıştırmaya başlamış bile!Dialogue: 0,0:03:03.25,0:03:07.83,Main,,0,0,0,,Dedikodulara göre bir korsan tayfasının icabına bakmışlar bile!Dialogue: 0,0:03:07.83,0:03:13.04,Main,,0,0,0,,Öte yandan ödülleri 100 milyonu geçkin çaylaklar da Yeni Dünya'ya giriyor!Dialogue: 0,0:03:13.04,0:03:17.91,Main,,0,0,0,[Linebreaker Removed],Eğer böyle oyalanırsak onların gerisinde kalacağız Kaptan!Dialogue: 0,0:03:17.91,0:03:21.96,Main,,0,0,0,,Onlar birbiriyle didişedursun.Dialogue: 0,0:03:21.96,0:03:24.44,Main,,0,0,0,,Anlamsız savaşlara girme gibi bir niyetim yok.Dialogue: 0,0:03:25.68,0:03:29.69,Main,,0,0,0,,Sızlanmayı kesin de lafımı dinleyin.Dialogue: 0,0:03:29.69,0:03:32.86,Main,,0,0,0,,Şüphesiz bizi bekleyen bir taht var.Dialogue: 0,0:03:32.86,0:03:34.39,Main,,0,0,0,,Kaptan!Dialogue: 0,0:03:34.39,0:03:36.29,Main,,0,0,0,,Senle mezara kadar gideriz!Dialogue: 0,0:03:36.29,0:03:38.73,Main,,0,0,0,,Emredersin, Kaptan!Dialogue: 1,0:03:38.96,0:03:42.57,Captions,,0,0,0,,Bir kış adası, Yeni DünyaDialogue: 0,0:03:42.57,0:03:48.01,Main,,0,0,0,[Linebreaker Removed],Burası Yonko Kaido'nun en sevdiği üslerden biridir.Dialogue: 0,0:03:48.01,0:03:50.48,Main,,0,0,0,,Benim görevim ise burayı korumak.Dialogue: 0,0:03:50.48,0:03:53.08,Main,,0,0,0,,Ee? Benden ne istiyorsun yani?Dialogue: 1,0:03:50.54,0:03:53.08,Captions,,0,0,0,,X DrakeDialogue: 0,0:03:53.08,0:03:57.46,Main,,0,0,0,,Bir şey istediğim yok. Sadece uyarıda bulundum.Dialogue: 0,0:03:57.46,0:04:01.77,Main,,0,0,0,,Kaido'yu sinirlendirmek istemezsin, çaylak.Dialogue: 0,0:04:01.77,0:04:06.48,Main,,0,0,0,,Yani kelleni alırsam Kaido karşılık verir mi diyorsun?Dialogue: 0,0:04:06.48,0:04:09.76,Main,,0,0,0,,Aynen öyle. Anladıysan oyalanmayı kes de -Dialogue: 0,0:04:09.76,0:04:11.83,Main,,0,0,0,,O halde bu işimi kolaylaştırır!Dialogue: 0,0:04:13.93,0:04:18.17,Main,,0,0,0,,Antik Zoan, ha? Pek nadir görülür!Dialogue: 0,0:04:26.36,0:04:28.10,Main,,0,0,0,,Scratch!Dialogue: 1,0:04:27.28,0:04:31.48,Captions,,0,0,0,,Bir bahar adası, Yeni DünyaDialogue: 0,0:04:38.51,0:04:40.49,Main,,0,0,0,,Bunların sonu gelmeyecek mi?!Dialogue: 1,0:04:38.26,0:04:42.33,Captions,,0,0,0,,Scratchmen ApooDialogue: 0,0:04:40.49,0:04:42.39,Main,,0,0,0,,Mesele ciddi.Dialogue: 0,0:04:44.30,0:04:48.90,Main,,0,0,0,[Linebreaker Removed],Endişelenmeyin çocuklar! Kaptan Apoo bizim tarafımızda!Dialogue: 0,0:04:49.54,0:04:50.96,Main,,0,0,0,,Dinleyin millet!Dialogue: 0,0:04:50.96,0:04:52.11,Main,,0,0,0,,Hayhay!Dialogue: 0,0:04:52.11,0:04:53.14,Main,,0,0,0,,Tüyelim buradan!Dialogue: 0,0:04:53.14,0:04:54.61,Main,,0,0,0,,Ne?!Dialogue: 0,0:04:56.07,0:05:00.03,Main,,0,0,0,[Linebreaker Removed],Bu vahşi domuz ordusunu yenmemize imkan yok!Dialogue: 0,0:05:02.09,0:05:05.43,Main,,0,0,0,,Kaptan! Uçuruma doğru gidiyoruz!Dialogue: 0,0:05:05.43,0:05:07.35,Main,,0,0,0,,Bir şekilde kaçmamız lazım!Dialogue: 0,0:05:09.84,0:05:10.91,Main,,0,0,0,,İşimiz bitti!Dialogue: 0,0:05:10.91,0:05:11.99,Main,,0,0,0,,Pes etmeyin!Dialogue: 0,0:05:11.99,0:05:14.59,Main,,0,0,0,,Ama o uçurumun hemen altında okyanus var!Dialogue: 0,0:05:14.59,0:05:16.79,Main,,0,0,0,,Umrumda değil! Atlayın!Dialogue: 0,0:05:16.79,0:05:17.96,Main,,0,0,0,,Neeeeee?!Dialogue: 0,0:05:19.03,0:05:19.80,Main,,0,0,0,,Ne oluyor?!Dialogue: 0,0:05:19.80,0:05:23.70,Main,,0,0,0,,Kaptan! Farkettin mi bilmiyorum ama havada koşuyoruz!Dialogue: 0,0:05:23.70,0:05:26.34,Main,,0,0,0,,Domuzlar da hala peşimizde!Dialogue: 0,0:05:26.34,0:05:28.34,Main,,0,0,0,,Görebiliyorum!Dialogue: 0,0:05:28.34,0:05:32.48,Main,,0,0,0,,Bu adanın olayın ne?!Dialogue: 0,0:05:34.18,0:05:36.65,Main,,0,0,0,,O kadar sıcak ki...Dialogue: 0,0:05:37.13,0:05:39.95,Main,,0,0,0,,Bacaklarım çok yoruldu...Dialogue: 1,0:05:36.78,0:05:41.52,Captions,,0,0,0,,San Juan WolfDialogue: 0,0:05:39.95,0:05:42.93,Main,,0,0,0,,Kımıldayacak halim yok...Dialogue: 0,0:05:42.93,0:05:45.92,Main,,0,0,0,,Ah. Balık ısırdı.Dialogue: 1,0:05:46.02,0:05:52.23,Captions,,0,0,0,,Yeni dünyada alevler içinde bir adaDialogue: 0,0:05:46.26,0:05:48.89,Main,,0,0,0,,Sızlanmayı bırak, Wolf.Dialogue: 0,0:05:48.89,0:05:52.26,Main,,0,0,0,,Senin yüzünden salımız neredeyse paramparça oluyordu.Dialogue: 0,0:05:52.26,0:05:54.48,Main,,0,0,0,,Sal kırıldığı için buradayız.Dialogue: 0,0:05:54.48,0:06:00.71,Main,,0,0,0,[Linebreaker Removed],Yeni Dünya'nın denizlerinde o sal ile dolaşmak saçma bir fikirdi zaten.Dialogue: 0,0:06:00.71,0:06:05.98,Main,,0,0,0,[Linebreaker Removed],Böyle olacağını bilseydim Marineford'dan bir savaş gemisi çalardık.Dialogue: 1,0:06:00.81,0:06:05.98,Captions,,0,0,0,,Marshall D. TeachDialogue: 0,0:06:05.98,0:06:09.65,Main,,0,0,0,,O eski sal ile bir bağımız var ama...Dialogue: 1,0:06:06.11,0:06:09.65,Captions,,0,0,0,,Jesus BurgessDialogue: 0,0:06:09.65,0:06:14.15,Main,,0,0,0,,Her yaptığın işte çok savsaksın.Dialogue: 1,0:06:09.78,0:06:14.15,Captions,,0,0,0,,ShiryuDialogue: 0,0:06:14.15,0:06:18.99,Main,,0,0,0,[Linebreaker Removed],Komutayı bana ver!  Kaptanlık görevini senden alayım, Teach.Dialogue: 1,0:06:14.29,0:06:18.99,Captions,,0,0,0,,Avalo PizarroDialogue: 0,0:06:20.26,0:06:24.26,Main,,0,0,0,,Sizi öldüreceğim. Biz Karasakal Korsanları'yız.Dialogue: 1,0:06:19.12,0:06:24.26,Captions,,0,0,0,,LafitteDialogue: 0,0:06:24.26,0:06:28.94,Main,,0,0,0,,Cennet zaten herkesin kaderini biliyor.Dialogue: 1,0:06:24.40,0:06:29.60,Captions,,0,0,0,,Doc QDialogue: 0,0:06:32.04,0:06:36.67,Main,,0,0,0,[Linebreaker Removed],İçkimiz neredeyse bitti.  Stok yapacağımız bir adaya neden gitmiyoruz?Dialogue: 1,0:06:30.07,0:06:36.67,Captions,,0,0,0,,Vasco ShotDialogue: 0,0:06:38.53,0:06:42.48,Main,,0,0,0,,Katılıyorum. Aslında yeni bir gemiden çok,  güzel kıyafetler istiyorum!Dialogue: 1,0:06:36.81,0:06:42.91,Captions,,0,0,0,,Catarina DevonDialogue: 0,0:06:42.48,0:06:44.68,Main,,0,0,0,,Bu hapishane kıyafetlerinden bıktım!Dialogue: 0,0:06:44.68,0:06:46.55,Main,,0,0,0,,Gidip bir bakayım.Dialogue: 1,0:06:44.72,0:06:48.25,Captions,,0,0,0,,Van OgreDialogue: 0,0:06:46.55,0:06:48.75,Main,,0,0,0,,Çok oyalanıyorlar.Dialogue: 0,0:06:48.75,0:06:53.53,Main,,0,0,0,[Linebreaker Removed],Doğru dedin. Bayılacak gibi duruyorlar.Dialogue: 0,0:06:56.89,0:06:57.83,Main,,0,0,0,,Öyle değil mi,Dialogue: 0,0:06:57.83,0:07:00.57,Main,,0,0,0,,Jewelry Bonney? Dialogue: 1,0:06:58.13,0:07:03.13,Captions,,0,0,0,,Jewelry BonneyDialogue: 0,0:07:00.57,0:07:03.02,Main,,0,0,0,,Kaptan Bonney...Dialogue: 0,0:07:06.70,0:07:12.08,Main,,0,0,0,[Linebreaker Removed],Senin gibi bir kızın 100 milyon'dan fazla ödüle sahip olması çok etkileyici!Dialogue: 0,0:07:12.08,0:07:16.01,Main,,0,0,0,[Linebreaker Removed],Yeni Dünya seçilmiş güçlü kişiler içindir!Dialogue: 0,0:07:16.01,0:07:19.30,Main,,0,0,0,,Güney Mavi'den buraya kadar iyi geldin,Dialogue: 0,0:07:19.30,0:07:22.00,Main,,0,0,0,,ancak burası senin için son durak.Dialogue: 0,0:07:26.62,0:07:30.19,Main,,0,0,0,,Çok güçsüz olduğun için seni tayfama katmayacağım,Dialogue: 0,0:07:30.19,0:07:34.63,Main,,0,0,0,[Linebreaker Removed],ama şuna ne dersin? Kadınım olursan seni memnuniyetle yanıma alırım.Dialogue: 0,0:07:35.93,0:07:38.14,Main,,0,0,0,,Önümüzdeki denizleri görmüş olursun.Dialogue: 0,0:07:39.30,0:07:41.67,Main,,0,0,0,,Kes ulan, seni sakallı domuz!Dialogue: 0,0:07:44.66,0:07:46.14,Main,,0,0,0,,Görünüşe bakılırsa reddedildin.Dialogue: 0,0:07:46.14,0:07:49.54,Main,,0,0,0,,Boş versene! Çok görgüsüzsün!Dialogue: 0,0:07:49.54,0:07:51.85,Main,,0,0,0,,Kadınlar vakur olmalı, değil mi?Dialogue: 0,0:07:51.85,0:07:55.15,Main,,0,0,0,,Tayfamda yeterince kaba ve görgüsüz var!Dialogue: 0,0:07:55.15,0:07:57.72,Main,,0,0,0,,Aynen öyle!Dialogue: 0,0:07:59.49,0:08:02.90,Main,,0,0,0,,Planladığımız gibi onu Donanma'ya teslim edeceğiz,Dialogue: 0,0:08:02.90,0:08:05.73,Main,,0,0,0,,düzgün bir savaş gemisi karşılığında!Dialogue: 0,0:08:05.73,0:08:07.05,Main,,0,0,0,,Kaptan.Dialogue: 0,0:08:07.05,0:08:08.83,Main,,0,0,0,,Donanma'yı görüyorum.Dialogue: 0,0:08:08.83,0:08:11.89,Main,,0,0,0,,Bize söz verdikleri gibi savaş gemisini getirmişler mi?!Dialogue: 0,0:08:11.89,0:08:14.84,Main,,0,0,0,[Linebreaker Removed],Bir gemileri var ama bize vereceklerinden emin değilim.Dialogue: 0,0:08:14.84,0:08:17.31,Main,,0,0,0,,Ha? Nereden anladın?Dialogue: 0,0:08:18.78,0:08:20.95,Main,,0,0,0,,Akainu da gemide.Dialogue: 0,0:08:20.95,0:08:24.55,Main,,0,0,0,,Lanet olsun! Ondan şimdilik sakınsam iyi olur.Dialogue: 0,0:08:24.55,0:08:26.62,Main,,0,0,0,,Hadi buradan tüyelim!Dialogue: 0,0:08:28.51,0:08:30.46,Main,,0,0,0,,Ne büyük başarısızlık!Dialogue: 0,0:08:33.69,0:08:35.57,Main,,0,0,0,,Karasakal nerede?Dialogue: 0,0:08:35.57,0:08:37.10,Main,,0,0,0,,Gitmiş!Dialogue: 0,0:08:37.10,0:08:40.62,Main,,0,0,0,,Hükümet'den kaçtığını duyunca,Dialogue: 0,0:08:40.62,0:08:42.50,Main,,0,0,0,,çok korktum.Dialogue: 0,0:08:44.04,0:08:46.91,Main,,0,0,0,,Ancak senin için yolun sonuna geldik.Dialogue: 0,0:08:48.51,0:08:51.81,Main,,0,0,0,,Seni bunun için asla affetmeyeceğim!Dialogue: 1,0:08:55.75,0:08:58.45,Captions,,0,0,0,,Kutsal Topraklar Mariejois, Red LineDialogue: 0,0:08:58.45,0:08:59.65,Main,,0,0,0,,Kayboldu ha?!Dialogue: 0,0:08:59.65,0:09:02.85,Main,,0,0,0,,Evet aynen böyle oldu.Dialogue: 0,0:09:03.45,0:09:07.23,Main,,0,0,0,,Sana bu işi kim verdi? Sengoku mu?!Dialogue: 0,0:09:07.23,0:09:09.34,Main,,0,0,0,,Hayır...Dialogue: 0,0:09:09.34,0:09:11.26,Main,,0,0,0,,Daha da yukarılardan birisi.Dialogue: 0,0:09:14.10,0:09:18.57,Main,,0,0,0,[Linebreaker Removed],Kinaye de yapmıyorum.  Cidden bir anda yok oldu.Dialogue: 0,0:09:19.48,0:09:23.74,Main,,0,0,0,,Beni de şaşırttı. Gölge gölge meyvesinin bunu yapabileceğini bilmiyordum.Dialogue: 0,0:09:23.74,0:09:25.34,Main,,0,0,0,,Bu gülünecek bir şey değil!Dialogue: 0,0:09:25.34,0:09:29.71,Main,,0,0,0,,Önemi yok. Ölümün kıyısındaydı.Dialogue: 0,0:09:29.71,0:09:32.15,Main,,0,0,0,,Ne yaparsa yapsın çok geçti.Dialogue: 0,0:09:32.15,0:09:36.89,Main,,0,0,0,,Tabii kendini zombiye çevirmediyse!Dialogue: 0,0:09:36.89,0:09:39.03,Main,,0,0,0,,Ona da bu yakışır gerçi.Dialogue: 0,0:09:39.03,0:09:41.59,Main,,0,0,0,,Neden bu konu hakkında bu kadar umursamazsın?!Dialogue: 0,0:09:42.86,0:09:45.73,Main,,0,0,0,,Ukalalığı kes.Dialogue: 0,0:09:45.73,0:09:48.90,Main,,0,0,0,,Tam olarak ne zaman benim patronum oldun sen?!Dialogue: 0,0:09:48.90,0:09:54.06,Main,,0,0,0,,Hükümet içinde ne kadar otoriteniz olursa olsun ben bir korsanım!Dialogue: 0,0:09:54.06,0:09:55.37,Main,,0,0,0,,Yani otoriteniz umrumda değil!Dialogue: 0,0:09:56.81,0:10:03.18,Main,,0,0,0,[Linebreaker Removed],Eğer sizinle olan bu anlaşmamız eğlencesini yitirirse, Shichibukai'liği anında bırakırım.Dialogue: 0,0:10:03.18,0:10:06.04,Main,,0,0,0,,Aklının bir köşesine yaz.Dialogue: 1,0:10:10.22,0:10:14.43,Captions,,0,0,0,,Kuş Krallığı, Güney MaviDialogue: 0,0:10:10.56,0:10:15.05,Main,,0,0,0,[Linebreaker Removed],B-bay Rakun Köpeği. En kısa zamanda geleceğim demiştin ama...Dialogue: 0,0:10:15.06,0:10:17.16,Main,,0,0,0,,biraz erken olmadı mı?Dialogue: 0,0:10:17.16,0:10:19.61,Main,,0,0,0,,Hayır, bizi karıştırıyorsunuz karıştırıyorsunuz!Dialogue: 0,0:10:19.61,0:10:23.94,Main,,0,0,0,[Linebreaker Removed],Ona benziyor olabilirim ama arkadaşıyım aslında, adım Chopper Maske!Dialogue: 0,0:10:23.94,0:10:26.02,Main,,0,0,0,,Fazla zorluyorsunuz, Bay Rakun Köpeği.Dialogue: 0,0:10:26.02,0:10:30.02,Main,,0,0,0,,Bu kadar erken geri gelmekten utandığın için mi kılık değiştirdin?Dialogue: 0,0:10:30.02,0:10:32.24,Main,,0,0,0,,Hayır, yanılıyorsunuz ben o değilim!Dialogue: 0,0:10:36.73,0:10:38.22,Main,,0,0,0,,Her şey yolunda mı, Bay Rakun Köpeği?Dialogue: 0,0:10:38.22,0:10:42.12,Main,,0,0,0,,Ona kaba davranmayı bırakın.Dialogue: 0,0:10:42.32,0:10:45.02,Main,,0,0,0,,Böyle durumlarda suyuna gitmek lazım.Dialogue: 0,0:10:45.59,0:10:47.89,Main,,0,0,0,,Ah pekala! İyi niyetiniz çok yorucu!Dialogue: 0,0:10:47.89,0:10:49.53,Main,,0,0,0,,Oh,  Bay Rakun Köpeği!Dialogue: 0,0:10:58.30,0:11:01.27,Main,,0,0,0,,Gıdıklanıyorum, dur yapma şerefsiz!Dialogue: 0,0:11:06.16,0:11:11.59,Main,,0,0,0,[Linebreaker Removed],Aslına bakarsanız burada yapmam gerekenler var. Biraz daha kalabilir miyim?Dialogue: 0,0:11:11.59,0:11:15.22,Main,,0,0,0,,Tabii ki! Başımızın üzerinde yerin var.Dialogue: 0,0:11:15.79,0:11:21.50,Main,,0,0,0,[Linebreaker Removed],O ağaçta yetişen daha önce görmediğim o kadar çok bitki var ki.Dialogue: 0,0:11:21.50,0:11:23.83,Main,,0,0,0,,Lütfen onlar üzerinde çalışmama izin verin.Dialogue: 0,0:11:23.83,0:11:27.33,Main,,0,0,0,,Öyleyse burası senin için ideal bir yer.Dialogue: 0,0:11:27.33,0:11:30.90,Main,,0,0,0,,Daha fazla güçlenmeli ve daha dayanıklı olmalıyım.Dialogue: 0,0:11:30.90,0:11:32.37,Main,,0,0,0,,Acele etmeliyim.Dialogue: 0,0:11:32.88,0:11:34.62,Main,,0,0,0,,Oh, Bay Rakun Köpeği?Dialogue: 0,0:11:34.62,0:11:36.05,Main,,0,0,0,,Ne çabuk döndün.Dialogue: 0,0:11:36.05,0:11:37.68,Main,,0,0,0,,Buna sevindim.Dialogue: 0,0:11:37.68,0:11:42.38,Main,,0,0,0,[Linebreaker Removed],Millet, bir süre bu adada kalacağım o yüzden kaynaşalım!Dialogue: 0,0:11:42.38,0:11:44.95,Main,,0,0,0,,Evet, geldik.Dialogue: 0,0:11:45.80,0:11:47.66,Main,,0,0,0,,Bu nedir?Dialogue: 0,0:11:47.66,0:11:49.15,Main,,0,0,0,,Burası...Dialogue: 0,0:11:58.89,0:12:01.20,Main,,0,0,0,,köyün kütüphanesi.Dialogue: 0,0:12:01.20,0:12:03.24,Main,,0,0,0,,Araştırmaların için burayı kullanabilirsin.Dialogue: 0,0:12:03.24,0:12:04.90,Main,,0,0,0,,Ne kadar çok kitap var!Dialogue: 0,0:12:06.62,0:12:09.51,Main,,0,0,0,[Linebreaker Removed],Görünenden fazlası var! Arkaya kadar kitapla dolu!Dialogue: 0,0:12:11.31,0:12:17.38,Main,,0,0,0,,Harika! İncelemek istediğim bitkiler ve araştırmak istediğim ilaçlar ile ilgili bir sürü kitap var!Dialogue: 0,0:12:17.38,0:12:19.94,Main,,0,0,0,,Ne kadar çok var!Dialogue: 0,0:12:19.94,0:12:23.65,Main,,0,0,0,[Linebreaker Removed],Bu adada kuvvetli ilaçlar yapmak için birçok bitki var.Dialogue: 0,0:12:24.25,0:12:32.63,Main,,0,0,0,[Linebreaker Removed],İlaç yapacak teknolojimiz var ama kuşlar bitkileri toplamamıza izin vermiyordu.Dialogue: 0,0:12:32.63,0:12:36.50,Main,,0,0,0,[Linebreaker Removed],Bu adanın yerlilerini görünüşlerinden ötürü yargıladım ama...Dialogue: 0,0:12:36.50,0:12:40.44,Main,,0,0,0,[Linebreaker Removed],düşününce silahları oldukça ileri teknoloji.Dialogue: 0,0:12:40.44,0:12:47.40,Main,,0,0,0,,İlkel gözüküyorlar ama bu ülkenin insanları bilimde oldukça ileri.Dialogue: 0,0:12:47.40,0:12:49.01,Main,,0,0,0,,Burada öğrenecek çok şey var!Dialogue: 0,0:12:49.01,0:12:54.81,Main,,0,0,0,[Linebreaker Removed],Bay Rakun Köpeği! Sesli düşünüyorsun!Dialogue: 0,0:12:54.81,0:12:56.79,Main,,0,0,0,,Çok da kabasın!Dialogue: 0,0:12:56.79,0:13:01.19,Main,,0,0,0,,Burada kendimi ciddi manada geliştirebilirim.Dialogue: 0,0:13:03.31,0:13:04.66,Flashbacks,,0,0,0,,Bu Menfur Kardan Adam!Dialogue: 0,0:13:04.66,0:13:05.81,Flashbacks,,0,0,0,,Öldürün onu!Dialogue: 0,0:13:05.81,0:13:06.96,Flashbacks,,0,0,0,,Kaçmasına izin vermeyin!Dialogue: 0,0:13:06.96,0:13:08.47,Flashbacks,,0,0,0,,Gebertin!Dialogue: 0,0:13:08.88,0:13:14.29,Flashbacks,,0,0,0,,Korsanlar harika!  Denizlerde sayısız muhteşem insan var!Dialogue: 0,0:13:14.29,0:13:17.10,Flashbacks,,0,0,0,,Chopper, bir gün sen de denize açılmalısın!Dialogue: 0,0:13:17.10,0:13:21.46,Flashbacks,,0,0,0,,Eğer denize açılırsan, kendi şahsi meselelerin ne kadar önemsiz onu farkedeceksin!Dialogue: 0,0:13:21.46,0:13:26.53,Flashbacks,,0,0,0,,Dünyaya kıyasla doğduğun ada şu kadarcık!Dialogue: 0,0:13:26.53,0:13:27.57,Flashbacks,,0,0,0,,Gerçekten mi?!Dialogue: 0,0:13:27.57,0:13:30.36,Flashbacks,,0,0,0,,Hayır daha da küçük! Bu ülke şu kadar!Dialogue: 0,0:13:30.36,0:13:31.39,Flashbacks,,0,0,0,,Ciddiyim!Dialogue: 0,0:13:36.55,0:13:38.96,Flashbacks,,0,0,0,,İnsanlardan oluşan bir tayfaya katılamam!Dialogue: 0,0:13:38.96,0:13:40.60,Flashbacks,,0,0,0,,Ben bir canavarım!Dialogue: 0,0:13:40.60,0:13:43.52,Flashbacks,,0,0,0,,Tayfana katılamam!Dialogue: 0,0:13:43.52,0:13:44.55,Flashbacks,,0,0,0,,O yüzden...Dialogue: 0,0:13:45.47,0:13:47.08,Flashbacks,,0,0,0,,Size teşekkür etmeye geldim...Dialogue: 0,0:13:50.48,0:13:52.68,Flashbacks,,0,0,0,,Size... ve yaptıklarınıza minnettarım.Dialogue: 0,0:13:53.27,0:13:55.79,Flashbacks,,0,0,0,,Beni davet ettiğiniz için... teşekkür ederim...Dialogue: 0,0:13:56.87,0:13:58.98,Flashbacks,,0,0,0,,Burada kalacağım ama...Dialogue: 0,0:14:00.15,0:14:01.75,Flashbacks,,0,0,0,,Eğer isterseniz...Dialogue: 0,0:14:01.75,0:14:03.09,Flashbacks,,0,0,0,,gelip ziyaret edebilirsiniz-Dialogue: 0,0:14:03.09,0:14:04.19,Flashbacks,,0,0,0,,Kes!Dialogue: 0,0:14:04.19,0:14:06.82,Flashbacks,,0,0,0,,Hadi gidelim!!!Dialogue: 0,0:14:19.69,0:14:22.74,Thoughts,,0,0,0,,Dünyaya açılmamı Luffy sağladı.Dialogue: 0,0:14:22.96,0:14:25.11,Thoughts,,0,0,0,,Ona ayak uydurmak için elimden geleni yapıyorum,Dialogue: 0,0:14:26.04,0:14:28.11,Thoughts,,0,0,0,,ama düşününce Luffy için bu güne kadar ne yaptım?Dialogue: 0,0:14:34.15,0:14:38.42,Main,,0,0,0,,Öylesini bir daha yaşamak istemiyorum.Dialogue: 0,0:14:39.59,0:14:40.49,Main,,0,0,0,,Ama...Dialogue: 0,0:14:41.06,0:14:42.15,Main,,0,0,0,,orada...Dialogue: 0,0:14:51.56,0:14:56.21,Main,,0,0,0,[Linebreaker Removed],Luffy hepimizden daha çok acı çekiyordu!Dialogue: 0,0:14:58.98,0:15:01.44,Main,,0,0,0,,Beni mürettebatına kattın.Dialogue: 0,0:15:01.96,0:15:05.58,Main,,0,0,0,,İyi olacağım. Kim ne derse desin!Dialogue: 0,0:15:11.76,0:15:14.25,Main,,0,0,0,,Eğer sana yardımı dokunacaksa...Dialogue: 0,0:15:15.82,0:15:19.40,Main,,0,0,0,,gerçekten bir canavara dönüşürüm!Dialogue: 0,0:15:19.80,0:15:21.43,Flashbacks,,0,0,0,,Chopper!Dialogue: 0,0:15:21.73,0:15:23.33,Flashbacks,,0,0,0,,Chopper!Dialogue: 0,0:15:23.83,0:15:25.70,Flashbacks,,0,0,0,,Chopper!Dialogue: 0,0:15:33.18,0:15:36.31,Main,,0,0,0,,Luffy!Dialogue: 0,0:15:36.31,0:15:37.72,Main,,0,0,0,,Ben...Dialogue: 0,0:15:37.72,0:15:39.17,Main,,0,0,0,,kesinlikle...Dialogue: 0,0:15:39.17,0:15:42.47,Main,,0,0,0,,daha güçlü olacağım!Dialogue: 0,0:15:45.00,0:15:48.36,Main,,0,0,0,,Grand Line'da Kamabakka Drag Krallığı.Dialogue: 0,0:15:48.36,0:15:52.16,Main,,0,0,0,,Söylesene gazetenin olayı neydi?Dialogue: 0,0:15:52.33,0:15:53.70,Flashbacks,,0,0,0,,Demek öyle diyorsun ha?Dialogue: 0,0:15:53.80,0:15:56.37,Main,,0,0,0,,Okuduktan sonra sakinleştin.Dialogue: 0,0:15:56.37,0:16:01.88,Main,,0,0,0,,Sadece Hasır Şapka Korsanları'nın anlayacağı bir mesaj vardı.Dialogue: 0,0:16:01.88,0:16:03.84,Main,,0,0,0,,Mesaj o haberde gizliydi.Dialogue: 0,0:16:03.84,0:16:08.08,Main,,0,0,0,,Benim onun tayfasından olduğuma inanmıyorsan sana ne olduğunu söylemeyeceğim, salak.Dialogue: 0,0:16:08.08,0:16:09.55,Main,,0,0,0,,Sinirimi bozuyorsun!Dialogue: 0,0:16:12.07,0:16:14.69,Main,,0,0,0,,Hey, bu yemeği kim yaptı?Dialogue: 0,0:16:14.69,0:16:18.39,Main,,0,0,0,,Oh? Bakıyorum da yemeğin iyisinden anlıyorsun.Dialogue: 0,0:16:18.39,0:16:24.00,Main,,0,0,0,,Yemek çok lezzetli ama ondan öte kendimi çok canlı hissediyorum.Dialogue: 0,0:16:25.56,0:16:28.43,Main,,0,0,0,,Aynen öyle. Bu yemek girişkenlik yemeği!Dialogue: 0,0:16:29.23,0:16:32.34,Main,,0,0,0,[Linebreaker Removed],Bu adadaki çoğu şef bunu pişirebilecek yetkinlikte!Dialogue: 0,0:16:32.34,0:16:32.86,Main,,0,0,0,,Evet!.. Dialogue: 0,0:16:32.86,0:16:33.32,Main,,0,0,0,,.Evet!Dialogue: 0,0:16:33.32,0:16:33.70,Main,,0,0,0,,Evet!.Dialogue: 0,0:16:33.70,0:16:34.31,Main,,0,0,0,,..Evet!Dialogue: 0,0:16:34.32,0:16:35.87,Main,,0,0,0,,Evet!Dialogue: 0,0:16:36.57,0:16:40.66,Main,,0,0,0,,Bu adanın tatlışlarının alımlı güçlü fiziklerine bir bak!Dialogue: 0,0:16:41.78,0:16:43.11,Main,,0,0,0,,Ve kibar kalplerine!Dialogue: 0,0:16:44.52,0:16:48.69,Main,,0,0,0,,Tatlışlar girişkenlik yemeklerini yiyerek böyle oluyorlar!Dialogue: 0,0:16:49.36,0:16:51.82,Main,,0,0,0,,Yeme alışkanlıkların kondisyonunu belirler!Dialogue: 0,0:16:51.82,0:16:52.96,Main,,0,0,0,,Ve fiziğini!Dialogue: 0,0:16:52.96,0:16:54.03,Main,,0,0,0,,Ve karakterini!Dialogue: 0,0:16:54.03,0:16:56.93,Main,,0,0,0,,Hepsi beraber bir bütün olarak insan vücudunu oluşturur!Dialogue: 0,0:16:56.93,0:17:01.07,Main,,0,0,0,,Eğer dünyadaki herkes her gün süt içseydi...Dialogue: 0,0:17:04.93,0:17:07.65,Main,,0,0,0,[Linebreaker Removed],tüm suçlar dünyadan silinirdi! İnanabiliyor musun?Dialogue: 0,0:17:07.65,0:17:08.24,Main,,0,0,0,,Ha?Dialogue: 0,0:17:08.24,0:17:09.21,Main,,0,0,0,,Diyorum ki...Dialogue: 0,0:17:09.21,0:17:12.31,Main,,0,0,0,,girişken olmazsan, kaybedersin!Dialogue: 0,0:17:12.88,0:17:15.51,Main,,0,0,0,,Fiziği geliştirmek için yemekleri kullanmak...Dialogue: 0,0:17:15.51,0:17:18.48,Main,,0,0,0,,Bunu daha önce hiç düşünmemiştim.Dialogue: 0,0:17:18.95,0:17:23.85,Main,,0,0,0,,Yani her gün pişirdiğim yemekler onların gelişimini etkileyebilir mi?Dialogue: 0,0:17:27.29,0:17:28.50,Main,,0,0,0,,Ve böylece...Dialogue: 0,0:17:28.50,0:17:33.56,Main,,0,0,0,,Nami-san ve Robin-chan'ın vücutlarını daha da seksi yapabilir miyim?!Dialogue: 0,0:17:33.56,0:17:35.23,Main,,0,0,0,,Bu adamla ne yapacağız?Dialogue: 0,0:17:35.23,0:17:37.10,Main,,0,0,0,,Neler neler yapardım!Dialogue: 0,0:17:37.50,0:17:39.07,Main,,0,0,0,,Acayip gaza geldim!Dialogue: 0,0:17:39.07,0:17:41.77,Main,,0,0,0,,Lütfen bana o yemekleri yapmayı öğretin!Dialogue: 0,0:17:41.77,0:17:44.64,Main,,0,0,0,,Hayır olmaz!Dialogue: 0,0:17:46.33,0:17:47.47,Main,,0,0,0,,Ah!Dialogue: 0,0:17:47.47,0:17:52.38,Main,,0,0,0,,Bu 99 hayati yemek tarifi,  Kamabakka Drag Krallığı'nda nesilden nesile aktarılır,Dialogue: 0,0:17:52.38,0:17:56.19,Main,,0,0,0,,ve Newkama Kenpo'nun gizli tekniklerinden, Gelin Eğitimi'nin bir tekniğidir.Dialogue: 0,0:17:56.19,0:18:01.20,Main,,0,0,0,,Asla senin gibi rastgele bir yabancının öğrenmesine müsaade etmeyiz!Dialogue: 0,0:18:01.20,0:18:04.42,Main,,0,0,0,,Eğer öğrenmek istiyorsan, kız oğlan kız olma yoluna baş koy!Dialogue: 0,0:18:05.19,0:18:07.73,Main,,0,0,0,,Newkama Kenpo'ya kendini ada!Dialogue: 0,0:18:08.37,0:18:10.17,Main,,0,0,0,,Kabul etmiyorum!Dialogue: 0,0:18:11.34,0:18:15.78,Main,,0,0,0,,Bu dünyaya kadınlarla arkadaş olmak için gelmedim ben!Dialogue: 0,0:18:15.78,0:18:17.84,Main,,0,0,0,,Ben dünyaya...Dialogue: 0,0:18:18.11,0:18:20.81,Main,,0,0,0,,kadınlarla aşk yapmak için gelmiş bir adamım!Dialogue: 0,0:18:28.12,0:18:31.56,Main,,0,0,0,,Çok iddialısın.Dialogue: 0,0:18:31.56,0:18:33.42,Main,,0,0,0,,Bu hoşumuza gitti! Sana bir şans vereceğiz.Dialogue: 0,0:18:33.42,0:18:34.26,Main,,0,0,0,,Bir şans mı?Dialogue: 0,0:18:37.26,0:18:44.74,Main,,0,0,0,,Tarifleri bu adada yaşayan  99 Newkama Kenpo üstadına vereceğiz.Dialogue: 0,0:18:45.21,0:18:50.94,Main,,0,0,0,[Linebreaker Removed],Eğer bir korsansan, o tariflerin hepsini çalarsın!Dialogue: 0,0:18:50.94,0:18:58.75,Main,,0,0,0,,Ancak sana karşı hazırlıklı olacağız ve bütün newkamalar sana tatlı elbiseler giydirmeye çalışacaklar!Dialogue: 0,0:18:58.75,0:19:02.25,Main,,0,0,0,,Erkekliğine tutunabilecek misin göreceğiz.Dialogue: 0,0:19:04.89,0:19:06.95,Main,,0,0,0,[Honorifics],Sanji-kyun !Dialogue: 0,0:19:06.95,0:19:08.79,Main,,0,0,0,,Sana rahat vermeyeceğiz!Dialogue: 0,0:19:08.79,0:19:09.86,Main,,0,0,0,,Tatlı elbiseler.Dialogue: 0,0:19:10.66,0:19:14.70,Main,,0,0,0,,Sana etek giymenin verdiği mutluluğu hatırlatacağım!Dialogue: 0,0:19:14.70,0:19:15.73,Main,,0,0,0,,Sanji!Dialogue: 0,0:19:16.30,0:19:17.64,Main,,0,0,0,,El değmemiş bir kız olmak harika bir bilsen!Dialogue: 0,0:19:19.96,0:19:21.47,Main,,0,0,0,,Sen...Dialogue: 0,0:19:21.47,0:19:25.58,Main,,0,0,0,,Newkama Baş Tapınağı'na karşı!Dialogue: 0,0:19:26.38,0:19:29.40,Main,,0,0,0,[Linebreaker Removed],Eğer bu savaşı kazanırsan sana bir gemi de vereceğiz.Dialogue: 0,0:19:29.40,0:19:31.77,Main,,0,0,0,,Her istediğini yapacağız.Dialogue: 0,0:19:31.77,0:19:33.52,Main,,0,0,0,,Şimdi, ne yapacaksın?!Dialogue: 0,0:19:36.22,0:19:37.49,Flashbacks,,0,0,0,,Hey, aşçı!Dialogue: 0,0:19:38.46,0:19:41.06,Flashbacks,,0,0,0,,Tayfama katılsana.Dialogue: 0,0:19:41.93,0:19:44.50,Flashbacks,,0,0,0,,Gemimde aşçı ol!Dialogue: 0,0:19:44.73,0:19:49.96,Main,,0,0,0,,Cevap vermemenden vazgeçtiğini mi anlamalıyız?Dialogue: 0,0:19:49.96,0:19:51.18,Main,,0,0,0,,Anlaşılır bir durum. Eğer kaybedersen-Dialogue: 0,0:19:51.18,0:19:52.84,Main,,0,0,0,,Kazandığımda...Dialogue: 0,0:19:53.93,0:19:56.39,Main,,0,0,0,,Hepinizi yendiğimde...Dialogue: 0,0:19:57.11,0:20:00.58,Main,,0,0,0,,Tahmin ediyorum ki şu ankinden katbekat güçlü olacağım.Dialogue: 0,0:20:01.41,0:20:04.98,Flashbacks,,0,0,0,,Onun vücudunu yüzlerce silahla delip geçsen bile...Dialogue: 0,0:20:04.98,0:20:10.25,Flashbacks,,0,0,0,, kuvvetli yüreğine hiçbiri işlemez.Dialogue: 0,0:20:10.49,0:20:12.03,Thoughts,,0,0,0,,Hey, Luffy.Dialogue: 0,0:20:12.80,0:20:15.43,Thoughts,,0,0,0,,Sakın kaybetme.Dialogue: 0,0:20:16.87,0:20:19.55,Flashbacks,,0,0,0,,Bir gün oraya ben de gitmek istiyorum.Dialogue: 0,0:20:19.55,0:20:21.04,Flashbacks,,0,0,0,,Grand Line'a.Dialogue: 0,0:20:21.57,0:20:23.33,Flashbacks,,0,0,0,,E hadi gidelim o zaman!Dialogue: 0,0:20:23.33,0:20:25.34,Flashbacks,,0,0,0,,Daha vakti gelmedi.Dialogue: 0,0:20:27.22,0:20:30.75,Flashbacks,,0,0,0,,Hey, All Blue'yu duymuş muydun?Dialogue: 0,0:20:30.75,0:20:31.30,Flashbacks,,0,0,0,,Hayır!Dialogue: 0,0:20:31.30,0:20:33.32,Flashbacks,,0,0,0,,Ne, onu bilmiyor musun?Dialogue: 0,0:20:33.32,0:20:35.12,Flashbacks,,0,0,0,,Efsanelerde geçen bir deniz!Dialogue: 0,0:20:37.65,0:20:40.81,Flashbacks,,0,0,0,,İkimizin de aptalca hayalleri var.Dialogue: 0,0:20:42.85,0:20:47.38,Flashbacks,,0,0,0,,Hayalimi gerçekleştirmek, All Blue'yu bulmak için...Dialogue: 0,0:20:47.41,0:20:48.39,Flashbacks,,0,0,0,,Sanji?Dialogue: 0,0:20:48.39,0:20:52.81,Flashbacks,,0,0,0,,Evet, öyleyse Korsanlar Kralı olma yolunda sana katılacağım.Dialogue: 0,0:20:55.00,0:20:57.85,Flashbacks,,0,0,0,,Geminin aşçısı olacağım.Dialogue: 0,0:21:00.02,0:21:04.11,Thoughts,,0,0,0,,Luffy, bir sonraki karşılaşmamızda...Dialogue: 0,0:21:04.78,0:21:05.64,Thoughts,,0,0,0,,Ben...Dialogue: 0,0:21:07.11,0:21:13.16,Thoughts,,0,0,0,,Korsanlar Kralı olma yolunda dünyanın en iyi aşçısı olarak yanında yer alacağım.Dialogue: 0,0:21:15.34,0:21:16.39,Thoughts,,0,0,0,,Ben...Dialogue: 0,0:21:17.99,0:21:19.31,Thoughts,,0,0,0,,bu cehenneme...Dialogue: 0,0:21:21.04,0:21:22.38,Thoughts,,0,0,0,,dayanacağım.Dialogue: 0,0:21:27.00,0:21:28.53,Main,,0,0,0,,Teklifini...Dialogue: 0,0:21:30.00,0:21:31.50,Main,,0,0,0,,kabul ediyorum!Dialogue: 0,0:21:33.46,0:21:35.01,Main,,0,0,0,,Pekala.Dialogue: 0,0:21:35.01,0:21:37.01,Main,,0,0,0,,Elimizden geleni ardımıza koymayacağız!Dialogue: 0,0:21:37.42,0:21:38.38,Main,,0,0,0,,Başlayalım!Dialogue: 0,0:21:40.46,0:21:42.43,Main,,0,0,0,,Mutlaka...Dialogue: 0,0:21:42.43,0:21:43.82,Main,,0,0,0,,kazanacağım!Dialogue: 0,0:21:48.60,0:21:52.62,Narrator,,0,0,0,,Burası ufak bir gökyüzü adası, Weatheria.Dialogue: 0,0:21:53.21,0:21:54.76,Main,,0,0,0,,Çaldığın araştırma dökümanları!Dialogue: 0,0:21:54.76,0:21:56.05,Main,,0,0,0,,Ve gökyüzü topu!Dialogue: 0,0:21:56.05,0:21:58.20,Main,,0,0,0,,Ve Bay Haredas!Dialogue: 0,0:21:58.20,0:22:01.30,Main,,0,0,0,[Linebreaker Removed],Onları geri getirdin diye seni affedeceğimizi sanma!Dialogue: 0,0:22:01.30,0:22:03.77,Main,,0,0,0,,Özür dilerim.  Yaptıklarımdan dolayı çok pişmanım.Dialogue: 0,0:22:03.77,0:22:05.72,Main,,0,0,0,,Sana güveneceğimizi mi sanıyorsun?!Dialogue: 0,0:22:05.72,0:22:08.51,Main,,0,0,0,,Onu soyup soğana çevirip adadan şutlayalım!Dialogue: 0,0:22:08.51,0:22:10.14,Main,,0,0,0,,Olamaz!Dialogue: 0,0:22:10.14,0:22:12.08,Main,,0,0,0,,O halde pişmanlığımı kanıtlamak için,Dialogue: 0,0:22:12.08,0:22:14.71,Main,,0,0,0,,Kendimi okyanusa atacağım.Dialogue: 0,0:22:14.71,0:22:15.37,Main,,0,0,0,,Ne?!Dialogue: 0,0:22:15.37,0:22:17.66,Main,,0,0,0,,Umarım beni öbür dünyada affedersiniz!Dialogue: 0,0:22:17.66,0:22:18.28,Main,,0,0,0,,Ne?!Dialogue: 0,0:22:18.80,0:22:20.32,Main,,0,0,0,,Elveda!Dialogue: 0,0:22:20.32,0:22:21.92,Main,,0,0,0,,Onu ağlattık!Dialogue: 0,0:22:21.92,0:22:23.54,Main,,0,0,0,,Bu kadar sert olmamalıyız!Dialogue: 0,0:22:23.54,0:22:27.12,Main,,0,0,0,,Hayatını böyle sona erdiremezsin, daha çok gençsin!Dialogue: 0,0:22:27.63,0:22:28.63,Main,,0,0,0,,Elveda...Dialogue: 0,0:22:28.63,0:22:30.29,Main,,0,0,0,,Özür dileriz!Dialogue: 0,0:22:31.75,0:22:33.90,Main,,0,0,0,,Pekala. Sizi affediyorum.Dialogue: 0,0:22:35.51,0:22:39.91,Main,,0,0,0,,Pekala, bir süre burada kalıp hava durumlarıyla ilgili bilimsel araştırmalar yapacağım.Dialogue: 0,0:22:39.91,0:22:42.30,Main,,0,0,0,[Honorifics],Ah adım Nami.  İsterseniz Nami-san diyebilirsiniz.Dialogue: 0,0:22:42.30,0:22:46.44,Main,,0,0,0,,Ha bir de kendime ait bir ev istiyorum. Kişisel alan önemli biliyorsunuz.Dialogue: 0,0:22:46.44,0:22:51.08,Main,,0,0,0,[Linebreaker Removed],Şöyle yumuşak bir yatağı,  köpüklü bir küveti, büyük bir giysi dolabı olsun.Dialogue: 0,0:22:51.08,0:22:53.96,Main,,0,0,0,,Siz halledersiniz, gökyüzünün eski toprakları.Dialogue: 0,0:22:53.96,0:22:55.59,Main,,0,0,0,,Pekala, elimizden geleni yapalım!Dialogue: 0,0:22:57.45,0:23:00.15,Main,,0,0,0,,Bay Haredas, bir şey söylesene!Dialogue: 0,0:23:00.60,0:23:02.00,Main,,0,0,0,,Bak şu işe.Dialogue: 0,0:23:04.87,0:23:10.81,Main,,0,0,0,[Linebreaker Removed],Weatheria rüzgarların hangi yönde estiğine göre dünya üzerinde hareket eder.Dialogue: 0,0:23:10.81,0:23:17.10,Main,,0,0,0,,Ara sıra yüzeye malzeme ve bilgi toplamak için ineriz, onun dışında buradayız.Dialogue: 0,0:23:17.10,0:23:17.98,Main,,0,0,0,,Bilgi mi?Dialogue: 0,0:23:18.28,0:23:21.01,Main,,0,0,0,,Evet genelde kayıtları toplarız.Dialogue: 0,0:23:21.01,0:23:27.66,Main,,0,0,0,,Grand Line'da görülen sıradışı hava olaylarının kayıtları. Hala o kadar çok var ki-Dialogue: 0,0:23:27.66,0:23:28.54,Main,,0,0,0,,Bu nedir?!Dialogue: 0,0:23:28.54,0:23:29.96,Main,,0,0,0,,Beni dinliyor musun?Dialogue: 0,0:23:31.14,0:23:34.26,Main,,0,0,0,,Bu şaka herhalde? Yıldırım yağmuru mu?!Dialogue: 0,0:23:34.26,0:23:38.03,Main,,0,0,0,,Sahiden öyle. Kelimenin tam anlamıyla yıldırım yağmuru.Dialogue: 0,0:23:38.03,0:23:40.90,Main,,0,0,0,,Yağmur damlaları gibi gökten düşen yıldırımlar.Dialogue: 0,0:23:40.90,0:23:43.87,Main,,0,0,0,,Yeni Dünya'da bir adada oluyor.Dialogue: 0,0:23:43.87,0:23:50.17,Main,,0,0,0,,O denize açılmak istiyorsan orada hiçbir şeyin sağduyuna göre gerçekleşmediğini göze alman gerekir.Dialogue: 0,0:23:51.60,0:23:54.45,Main,,0,0,0,,Lütfen... Öğret bana, Haredas-san,Dialogue: 0,0:23:54.79,0:23:56.41,Main,,0,0,0,,Yeni Dünya'nın iklimini öğret bana.Dialogue: 0,0:23:58.58,0:24:00.22,Main,,0,0,0,,Bana bildiğin her şeyi anlat!Dialogue: 0,0:24:01.22,0:24:02.99,Main,,0,0,0,,Bu ne acele.Dialogue: 0,0:24:02.99,0:24:07.36,Main,,0,0,0,[Linebreaker Removed],Tabii ki acelem var!  Mürettebat arkadaşlarımın hayatları benim ellerimde!Dialogue: 0,0:24:07.36,0:24:09.26,Main,,0,0,0,,Ben onları rotacısıyım!Dialogue: 0,0:24:09.26,0:24:12.40,Main,,0,0,0,[Linebreaker Removed],Denize açıldığımızda en büyük sorumluluk bende!Dialogue: 0,0:24:12.40,0:24:17.33,Main,,0,0,0,[Linebreaker Removed],Kaptanımız bir yere gitmek isterse neresi olursa olsun hazırlıklı olmalıyım!Dialogue: 0,0:24:22.81,0:24:26.84,Main,,0,0,0,,Luffy Korsanlar Kralı olacağını söylüyor,Dialogue: 0,0:24:26.84,0:24:30.71,Main,,0,0,0,,o yüzden rotacı olarak işimi savsaklayamam!Dialogue: 0,0:24:31.58,0:24:36.74,Main,,0,0,0,[Linebreaker Removed],Tayfasının ona ne kadar bağlı olduğunu görüyorum da kaptanınız şanslı bir adammış.Dialogue: 0,0:24:37.95,0:24:39.30,Main,,0,0,0,,Başka yolu yok.Dialogue: 0,0:24:39.30,0:24:40.52,Main,,0,0,0,,Yok mu?Dialogue: 0,0:24:40.52,0:24:46.56,Main,,0,0,0,,Yok. Demek istediğim o öyle büyük konuşur ama denizde yolunu bulma konusunda bir şey bildiği yok.Dialogue: 0,0:24:56.00,0:24:59.55,Main,,0,0,0,,Her zaman çılgınca şeyler yapar ayrıca.Dialogue: 0,0:24:59.55,0:25:00.64,Main,,0,0,0,,Onu yalnız bırakırsam...Dialogue: 0,0:25:03.34,0:25:04.28,Flashbacks,,0,0,0,,Luffy...Dialogue: 0,0:25:06.12,0:25:07.82,Flashbacks,,0,0,0,,Yardım et.Dialogue: 0,0:25:14.19,0:25:16.83,Flashbacks,,0,0,0,,Tabii ki edeceğim!Dialogue: 0,0:25:21.18,0:25:24.30,Main,,0,0,0,,Onu bir başına bırakırsam ölür gider.Dialogue: 0,0:25:26.73,0:25:29.31,Main,,0,0,0,,Salağın teki, hep başını derde sokar.Dialogue: 0,0:25:31.78,0:25:34.08,Main,,0,0,0,,Pek baş belası bir kaptanınız varmış!Dialogue: 0,0:25:36.15,0:25:38.42,Main,,0,0,0,,O yüzden ona yardım etmeliyim.Dialogue: 0,0:25:39.72,0:25:41.85,Thoughts,,0,0,0,,Bu sefer yardım eden ben olacağım!Dialogue: 0,0:25:41.85,0:25:44.67,Main,,0,0,0,,Hey, bana hava durumu toplarından bahsetsene.Dialogue: 0,0:25:44.67,0:25:49.24,Main,,0,0,0,[Linebreaker Removed],Öyle ayaküstü anlatılmaz,  Weatheria'nın en büyük icatlarından bahsediyoruz!Dialogue: 0,0:25:49.24,0:25:53.56,Main,,0,0,0,[Linebreaker Removed],Eğer yanlış ellerin eline geçerse bütün dünyanın düzenini bozabilirler!Dialogue: 0,0:25:53.56,0:25:55.60,Main,,0,0,0,,Silah olarak kullanılabilirler mi?Dialogue: 0,0:25:55.60,0:25:58.75,Main,,0,0,0,,Ağzını hayra aç hele!Dialogue: 0,0:25:58.75,0:25:59.77,Main,,0,0,0,,Sırıtma öyle!Dialogue: 0,0:26:12.98,0:26:14.71,Flashbacks,,0,0,0,,Nami!Dialogue: 0,0:26:15.22,0:26:18.19,Flashbacks,,0,0,0,,Sen bizden birisin!Dialogue: 0,0:26:42.66,0:26:47.52,Narrator,,0,0,0,[Linebreaker Removed],Burası Grand Line'da Kenzan Adası,  Tehna Gehna Krallığı.Dialogue: 1,0:26:42.55,0:26:47.48,Captions,,0,0,0,,Kılıç Dağı Adası, Grand LineDialogue: 1,0:26:42.55,0:26:47.48,Captions,,0,0,0,,Uzun Kol Krallığı Dialogue: 0,0:26:47.52,0:26:50.30,Main,,0,0,0,,Gelin de bir bakın!Dialogue: 0,0:26:53.52,0:26:57.49,Main,,0,0,0,,Bu mahlukat gerçek bir iskelet gibi görünüyorDialogue: 0,0:26:57.49,0:27:04.50,Main,,0,0,0,[Linebreaker Removed],Dahası, kollarında tek eklem var!  Dünya üzerinde bundan daha ilginç bir yaratık var mı?!Dialogue: 0,0:27:04.50,0:27:07.84,Main,,0,0,0,[Linebreaker Removed],Hey! Ucuz numaralarla bizi kandırmaya çalışmayın şarlatanlar!Dialogue: 0,0:27:08.83,0:27:11.02,Main,,0,0,0,,Ne? Tatmin olmadınız mı?Dialogue: 0,0:27:11.02,0:27:14.68,Main,,0,0,0,,O şey kıpırdamıyor bile!Dialogue: 0,0:27:14.68,0:27:17.01,Main,,0,0,0,,Cansız manken o, değil mi?!Dialogue: 0,0:27:20.34,0:27:22.84,Thoughts,,0,0,0,,Luffy-san kararını verdi.Dialogue: 0,0:27:22.84,0:27:25.45,Thoughts,,0,0,0,,Ben de gerekeni yapmalıyım.Dialogue: 0,0:27:25.45,0:27:28.56,Main,,0,0,0,,Hey, iskelet! Dalavereyi bırak!Dialogue: 0,0:27:28.56,0:27:30.96,Main,,0,0,0,,Burada hiçbir şey olmamış gibi oturamam!Dialogue: 0,0:27:31.66,0:27:35.10,Main,,0,0,0,,Ah demek anlıyorsun? Hadi kıpırda bakalım!Dialogue: 0,0:27:35.10,0:27:37.07,Main,,0,0,0,,Şovu başlat hadi!Dialogue: 0,0:27:37.07,0:27:39.86,Main,,0,0,0,,Nasıl yardımcı olabilirim?Dialogue: 0,0:27:39.86,0:27:42.80,Main,,0,0,0,,Kalk biraz kıpırda o yeter!Dialogue: 0,0:27:42.80,0:27:44.54,Main,,0,0,0,,Kalk hadi!Dialogue: 0,0:27:44.98,0:27:46.11,Main,,0,0,0,,Ne oluyor burada?!Dialogue: 0,0:27:55.12,0:27:58.06,Thoughts,,0,0,0,,Beni gördüğünde gram korkmadı,Dialogue: 0,0:27:58.06,0:28:03.44,Thoughts,,0,0,0,,dahası beni tayfasına davet etti.Dialogue: 0,0:28:04.33,0:28:06.50,Flashbacks,,0,0,0,,Her neyse baksana!Dialogue: 0,0:28:07.10,0:28:08.97,Flashbacks,,0,0,0,,Tayfama katıl!Dialogue: 0,0:28:09.43,0:28:11.10,Flashbacks,,0,0,0,,Oh? Pekala.Dialogue: 0,0:28:15.00,0:28:17.01,Thoughts,,0,0,0,,50 yıl olmuştu.Dialogue: 0,0:28:17.21,0:28:19.99,Thoughts,,0,0,0,,Karanlık denizlerde o kadar uzun süre amaçsızca dolandıktan sonra...Dialogue: 0,0:28:20.01,0:28:22.60,Thoughts,,0,0,0,,...hissettiğim mutluluğu tahmin edebiliyor musun?Dialogue: 0,0:28:25.40,0:28:28.99,Flashbacks,,0,0,0,,Biri benim gölgemi çaldı.Dialogue: 0,0:28:29.39,0:28:34.39,Flashbacks,,0,0,0,[Linebreaker Removed],Ne anlatıyorsun sen?!  Sana gölge lazımsa gider geri alırım!Dialogue: 0,0:28:34.39,0:28:38.53,Thoughts,,0,0,0,,Dünyama nasıl güneş gibi doğduğunu biliyor musun?Dialogue: 0,0:28:39.73,0:28:45.67,Thoughts,,0,0,0,,50 yıldır süren dualarım sonunda karşılık buldu.Dialogue: 0,0:28:45.67,0:28:47.01,Main,,0,0,0,,Paramı iade et!Dialogue: 0,0:28:47.01,0:28:48.14,Main,,0,0,0,,Evet!Dialogue: 0,0:28:48.14,0:28:53.14,Main,,0,0,0,[Linebreaker Removed],Lanet olsun! Bu işten iyi para kazanırız diyordum ama çuvalladık.Dialogue: 0,0:28:53.14,0:28:55.45,Main,,0,0,0,,Eğer tatlı dil sökmüyorsa biz de-Dialogue: 0,0:28:55.45,0:28:56.51,Main,,0,0,0,,Ne?!Dialogue: 0,0:28:59.92,0:29:00.98,Main,,0,0,0,,40 derece!Dialogue: 0,0:29:03.80,0:29:05.06,Main,,0,0,0,,Ne?!Dialogue: 0,0:29:05.06,0:29:07.32,Main,,0,0,0,,Ahh, çok zor!Dialogue: 0,0:29:07.32,0:29:09.92,Main,,0,0,0,,Gerçekten konuşuyor ve hareket ediyor!Dialogue: 0,0:29:09.92,0:29:11.13,Main,,0,0,0,,Ne kadar korkunç!Dialogue: 0,0:29:11.13,0:29:12.73,Main,,0,0,0,,Bu yaratığın olayı ne böyle?!Dialogue: 0,0:29:12.73,0:29:17.73,Main,,0,0,0,[Linebreaker Removed],45 derecenin altına inmeye kalkarsam kayıyorum.Dialogue: 0,0:29:17.73,0:29:20.64,Main,,0,0,0,,Ama bunda bir ustalaştım mı...Dialogue: 0,0:29:21.68,0:29:25.72,Thoughts,,0,0,0,,Luffy-san için daha faydalı olabilirim.Dialogue: 0,0:29:26.78,0:29:29.61,Thoughts,,0,0,0,[Linebreaker Removed],Bir daha düşününce acaba başka bir konuda faydalı olmayı mı denesem?Dialogue: 0,0:29:35.09,0:29:36.52,Main,,0,0,0,,Gitarı var!Dialogue: 0,0:29:36.52,0:29:37.75,Main,,0,0,0,,Ne yapacak?Dialogue: 0,0:29:37.75,0:29:39.90,Main,,0,0,0,,Ne planlıyorsun?!Dialogue: 0,0:29:39.90,0:29:43.59,Main,,0,0,0,[Linebreaker Removed],Şov yapmaya çalışma! Bu sadece bir sergi!Dialogue: 0,0:29:43.59,0:29:47.85,Main,,0,0,0,,Sergi demek istiyorsanız deyin benim için farketmez.Dialogue: 0,0:29:47.85,0:29:52.04,Main,,0,0,0,,"Yalnızlık" benim kitabımda yoktur!Dialogue: 0,0:29:54.60,0:29:56.54,Main,,0,0,0,,Beyler bayanlar!Dialogue: 0,0:29:56.54,0:29:58.69,Main,,0,0,0,,Bana öylece bakmak sıkıcı değil mi?Dialogue: 0,0:29:58.69,0:30:00.58,Main,,0,0,0,,Bu ritim de ne böyle?Dialogue: 0,0:30:00.58,0:30:02.32,Main,,0,0,0,,Kalbim hop hop atıyor!Dialogue: 0,0:30:03.95,0:30:07.18,Main,,0,0,0,,Lütfen yeni single'ımı dinleyin,Dialogue: 0,0:30:07.18,0:30:09.75,Main,,0,0,0,,"Bone to be Wild!"Dialogue: 0,0:30:16.40,0:30:21.16,Narrator,,0,0,0,,Burası Doğu Mavi'deki dev köprünün yanı.Dialogue: 1,0:30:16.96,0:30:21.90,Captions,,0,0,0,,Dev bir köprü, Doğu MaviDialogue: 0,0:30:22.14,0:30:25.02,Main,,0,0,0,,Ne oldu da fikrini değiştirdin?Dialogue: 0,0:30:25.02,0:30:30.05,Main,,0,0,0,,Baltigo'ya bizimle birlikte geleceğin için minnettarız.Dialogue: 0,0:30:30.05,0:30:33.86,Main,,0,0,0,[Honorifics],Dragon-san ne zamandır sizle tanışmak istiyordu.Dialogue: 0,0:30:34.35,0:30:39.81,Main,,0,0,0,[Linebreaker Removed],Bu kadar cömert insanlar olduğunuzu bilseydim, beni daha önce bulmanızı isterdim.Dialogue: 0,0:30:39.81,0:30:45.38,Main,,0,0,0,,Ö-özür dileriz! Crocodile ile birlikte çalıştığınızdan haberimiz yoktu.Dialogue: 0,0:30:46.16,0:30:49.82,Main,,0,0,0,[Linebreaker Removed],Şaka yapıyorum.  Takılıyordum sadece, özür dilerim.Dialogue: 0,0:30:49.82,0:30:53.03,Main,,0,0,0,,Halimden memnunum.Dialogue: 0,0:30:53.93,0:30:58.35,Main,,0,0,0,,Yelkenler fora! Baltigo'ya doğru yelkenler fora!Dialogue: 0,0:31:12.11,0:31:14.06,Flashbacks,,0,0,0,,79 milyon beli?Dialogue: 0,0:31:14.06,0:31:16.99,Flashbacks,,0,0,0,,8 yaşında bir kızın ödülü mü bu?!Dialogue: 0,0:31:16.99,0:31:22.20,Flashbacks,,0,0,0,[Linebreaker Removed],Görünüşe göre dünyayı yok etme planı yapan Ohara iblislerinden geriye kalanlardan biri.Dialogue: 0,0:31:22.20,0:31:24.04,Flashbacks,,0,0,0,,Ohara'dan mı?!Dialogue: 0,0:31:24.04,0:31:28.94,Flashbacks,,0,0,0,,Nasıl olmuş bilmiyorum ama  bir de 6 Donanma gemisini batırmış.Dialogue: 0,0:31:28.94,0:31:30.83,Flashbacks,,0,0,0,,O yüzden mi ödülü bu kadar yüksek?Dialogue: 0,0:31:32.74,0:31:36.74,Flashbacks,,0,0,0,[Linebreaker Removed],İblislerin dölü o,  hayatta kalmasına izin verilmemeli!Dialogue: 0,0:31:39.17,0:31:41.36,Flashbacks,,0,0,0,,Pekala, burada bekle bakalım!Dialogue: 0,0:31:42.47,0:31:44.51,Flashbacks,,0,0,0,[Linebreaker Removed],Neden beni kurtarmaya çalışıyorsun?!Dialogue: 0,0:31:44.51,0:31:48.44,Flashbacks,,0,0,0,[Linebreaker Removed],Senden bunu isteyen mi oldu?! Dialogue: 0,0:31:53.91,0:31:57.19,Flashbacks,,0,0,0,,Sadece ölüp gitmek istiyorum!Dialogue: 0,0:32:03.83,0:32:04.83,Flashbacks,,0,0,0,,Olamaz!Dialogue: 0,0:32:04.83,0:32:06.54,Flashbacks,,0,0,0,,Siz kafayı mı yediniz?!Dialogue: 0,0:32:06.54,0:32:10.14,Flashbacks,,0,0,0,,Bütün dünyayı düşman olarak karşınıza alıp hayatta kalmayı mı planlıyorsunuz!?Dialogue: 0,0:32:10.14,0:32:15.25,Flashbacks,,0,0,0,,Bana koymaz!Dialogue: 0,0:32:20.95,0:32:23.26,Main,,0,0,0,[Honorifics],Robin-san, lütfen içeri gel.Dialogue: 0,0:32:23.26,0:32:25.03,Main,,0,0,0,,Dışarısı çok soğuk.Dialogue: 0,0:32:25.03,0:32:26.97,Main,,0,0,0,,Burada iyiyim.Dialogue: 0,0:32:26.97,0:32:30.59,Main,,0,0,0,,Ben bir korsanım. Siz ise devrimciler.Dialogue: 0,0:32:30.59,0:32:32.75,Main,,0,0,0,,Size o kadar kolay güvenemem.Dialogue: 0,0:32:33.60,0:32:37.17,Main,,0,0,0,,Kaçış yolu olmayan bir kabine kolay kolay girmem.Dialogue: 0,0:32:37.17,0:32:41.00,Main,,0,0,0,,Ne?! Sana zarar verme gibi bir niyetimiz yok!Dialogue: 0,0:32:41.00,0:32:45.70,Main,,0,0,0,[Linebreaker Removed],Böyle iyiyim.  Kendi başıma yaşarken de böyleydim.Dialogue: 0,0:32:46.63,0:32:48.65,Main,,0,0,0,,Özür dilerim... Pekala.Dialogue: 0,0:32:48.65,0:32:51.35,Main,,0,0,0,,Hey! Ne kadar battaniye varsa getirin!Dialogue: 0,0:32:51.35,0:32:54.10,Main,,0,0,0,,Sıcak yiyecek ve içecekler de!Dialogue: 0,0:32:54.10,0:32:56.41,Main,,0,0,0,,A-ama hepsini içeride hazırlamıştık...Dialogue: 0,0:32:56.41,0:32:59.35,Main,,0,0,0,,Acele edin! Bir rüzgarlık ve bir de koltuk!Dialogue: 0,0:32:59.35,0:32:59.92,Main,,0,0,0,,Anlaşıldı!Dialogue: 0,0:33:02.32,0:33:03.72,Thoughts,,0,0,0,,Luffy.Dialogue: 0,0:33:03.72,0:33:08.49,Thoughts,,0,0,0,[Linebreaker Removed],Babanın yanına gidip kendimi hayatın akışına bırakırsam,Dialogue: 0,0:33:08.49,0:33:11.67,Thoughts,,0,0,0,,acaba daha güçlü olabilir miyim merak ediyorum.Dialogue: 0,0:33:13.52,0:33:16.66,Thoughts,,0,0,0,,Bir başkası için güçlenmeyi istemek.Dialogue: 0,0:33:17.70,0:33:19.75,Thoughts,,0,0,0,,Bunu daha önce iç düşünmemiştim.Dialogue: 0,0:33:24.32,0:33:27.85,Narrator,,0,0,0,,Grand Line'daki Karakuri Adası'na gidiyoruz.Dialogue: 0,0:33:27.85,0:33:31.02,Narrator,,0,0,0,,Geleceğin Ülkesi, BaldimoreDialogue: 0,0:33:31.50,0:33:35.56,Main,,0,0,0,[Linebreaker Removed],Doktor Vegapunk'ın labaratuvarındaki ani patlamayı araştırıyoruz.Dialogue: 0,0:33:36.20,0:33:39.06,Main,,0,0,0,,Kimin yaptığını hala bulamadık.Dialogue: 0,0:33:39.30,0:33:40.83,Main,,0,0,0,,Hey! Acele edin!Dialogue: 0,0:33:44.16,0:33:48.41,Main,,0,0,0,[Linebreaker Removed],Buna yüzyılın en büyük kayıbı desek  abartmış olmayız.Dialogue: 0,0:33:48.69,0:33:50.80,Main,,0,0,0,,Patlamaya kim sebep olmuş olabilir  bir fikriniz var mı?Dialogue: 0,0:33:50.80,0:33:54.94,Main,,0,0,0,,Duyduğuma göre gorile benzeyen biri labaratuvara girmiş.Dialogue: 0,0:33:54.94,0:33:57.51,Main,,0,0,0,,Olanlar çok kafa karıştırıcı.Dialogue: 0,0:33:57.51,0:34:03.52,Main,,0,0,0,,Bu adaya buzkıran gemisi olmadan erişmek imkansız.Dialogue: 0,0:34:03.91,0:34:06.29,Main,,0,0,0,,ama öyle bir gemi gören yok.Dialogue: 0,0:34:06.72,0:34:11.59,Main,,0,0,0,[Linebreaker Removed],Diyorlar ki olaya sebep olan  Hasır Şapka Korsanları'ndan Cyborg Franky'ymiş.Dialogue: 0,0:34:12.10,0:34:17.17,Main,,0,0,0,[Linebreaker Removed],Ama bir aydan kısa bir süre önce Sabaody Takımadaları'nda görüldü.Dialogue: 0,0:34:17.17,0:34:20.36,Main,,0,0,0,[Linebreaker Removed],Bu kadar kısa sürede Baldimore'a nasıl gelmiş hiçbir fikrimiz yok.Dialogue: 0,0:34:20.36,0:34:24.00,Main,,0,0,0,[Linebreaker Removed],Kaptan Gorilla!  Arama ekibi dağlara doğru yöneliyor!Dialogue: 0,0:34:24.00,0:34:26.34,Main,,0,0,0,,Pekala. Ben de onlara katılacağım!Dialogue: 0,0:34:27.08,0:34:28.13,Main,,0,0,0,,B-bu nedir?!Dialogue: 0,0:34:28.13,0:34:31.61,Main,,0,0,0,,Patlamanın ortaya çıkardığı gizli bir geçit.Dialogue: 0,0:34:31.61,0:34:35.02,Main,,0,0,0,,İnanmıyorum. Hiç bilmiyorduk...Dialogue: 0,0:34:36.59,0:34:42.33,Main,,0,0,0,,burada ikinci bir labaratuvar varmış.Dialogue: 0,0:34:42.89,0:34:47.78,Main,,0,0,0,[Linebreaker Removed],Görünüşe göre cyborg hayvanları burada yapmış.Dialogue: 0,0:34:49.65,0:34:50.97,Main,,0,0,0,,Hey, sakın bir şeyi kırayım deme!Dialogue: 0,0:34:50.97,0:34:53.17,Main,,0,0,0,,Diyene bak!Dialogue: 0,0:34:53.50,0:35:00.74,Main,,0,0,0,,Patlayan labaratuvarda insanların hayatını kolaylaştıran bir çok icat bulunuyordu. Hepsi yok oldu gitti.Dialogue: 0,0:35:00.74,0:35:07.50,Main,,0,0,0,,Ama benim asıl ilgilendiğim silah planları. Onlar da burada.Dialogue: 0,0:35:09.92,0:35:11.62,Main,,0,0,0,,Bu harika!Dialogue: 0,0:35:11.62,0:35:14.99,Main,,0,0,0,[Linebreaker Removed],Burada savaş gemilerinden insan geni manipülasyonuna kadar her şey var!Dialogue: 0,0:35:14.99,0:35:17.96,Main,,0,0,0,,Nasıl bi beyini var bu adamın?Dialogue: 0,0:35:20.10,0:35:22.71,Main,,0,0,0,,Pekala, kararımı verdim!Dialogue: 0,0:35:23.40,0:35:24.70,Main,,0,0,0,,Burada yaşayacağım!Dialogue: 0,0:35:24.70,0:35:25.67,Main,,0,0,0,,Burada mı yaşayacaksın?!Dialogue: 0,0:35:25.87,0:35:26.54,Main,,0,0,0,,Evet!Dialogue: 0,0:35:28.95,0:35:31.74,Main,,0,0,0,[Linebreaker Removed],Ara sıra dağdan inip kola stoklarım,Dialogue: 0,0:35:31.74,0:35:34.80,Main,,0,0,0,,o yüzden evde bana kola ayırın olur mu?Dialogue: 0,0:35:35.95,0:35:41.28,Main,,0,0,0,[Linebreaker Removed],Endişelenmeyin. Benim hakkımda kimseye laf etmezseniz buradan hiç çıkmam.Dialogue: 0,0:35:41.28,0:35:43.52,Main,,0,0,0,,Başınızı belaya sokmam.Dialogue: 0,0:35:43.92,0:35:46.52,Main,,0,0,0,,Suratım için amma yaygara kopardınız be!Dialogue: 0,0:35:46.52,0:35:47.92,Main,,0,0,0,,Bize doğru bakma!Dialogue: 0,0:35:47.92,0:35:49.16,Main,,0,0,0,,Korkunç! Yüzün çok korkunç!Dialogue: 0,0:35:49.16,0:35:52.16,Main,,0,0,0,,Ya şimdi? Kaplan postu giydim!Dialogue: 0,0:35:53.44,0:35:54.58,Main,,0,0,0,,Biraz daha iyi.Dialogue: 0,0:35:54.58,0:35:56.53,Main,,0,0,0,,F-F-Franky!Dialogue: 0,0:35:57.74,0:35:59.85,Main,,0,0,0,,Donuyorum. Özellikle bacaklarım.Dialogue: 0,0:35:59.85,0:36:01.20,Main,,0,0,0,,Neden pantolon giymiyorsun?Dialogue: 0,0:36:09.93,0:36:15.89,Flashbacks,,0,0,0,,Lütfen benim yaptığım gemide seyahat edin!Dialogue: 0,0:36:16.48,0:36:23.03,Thoughts,,0,0,0,,Luffy... Hayalimi gerçekleştirmemi sağladın.Dialogue: 0,0:36:24.89,0:36:26.38,Flashbacks,,0,0,0,,Franky!Dialogue: 0,0:36:27.33,0:36:31.82,Flashbacks,,0,0,0,,Gemi için teşekkürler! Acayip iyi!Dialogue: 0,0:36:31.82,0:36:33.47,Flashbacks,,0,0,0,,Ona gözümüz gibi bakacağız!Dialogue: 0,0:36:33.89,0:36:36.84,Flashbacks,,0,0,0,,Donunu geri istiyorsan,Dialogue: 0,0:36:37.11,0:36:39.28,Flashbacks,,0,0,0,,tayfama katıl!Dialogue: 0,0:36:40.30,0:36:46.78,Thoughts,,0,0,0,,Beni yanında bu koca dünyaya getirdin.Dialogue: 0,0:36:48.18,0:36:54.76,Thoughts,,0,0,0,[Linebreaker Removed],Sayısız deniz aştık, haddi hesabı olmayan savaşlar ve dertler atlattık.Dialogue: 0,0:36:55.32,0:36:58.46,Thoughts,,0,0,0,,Ve eğer denizlerin sonuna ulaşabilirsek...Dialogue: 0,0:36:58.46,0:37:02.35,Thoughts,,0,0,0,,işte o zaman gemim hayallerimdeki gemi olur.Dialogue: 0,0:37:04.72,0:37:06.14,Thoughts,,0,0,0,,Hey, Luffy.Dialogue: 0,0:37:07.17,0:37:10.24,Thoughts,,0,0,0,,Sunny henüz tam potansiyelini göstermedi!Dialogue: 0,0:37:11.58,0:37:14.51,Thoughts,,0,0,0,[Linebreaker Removed],Sunny'i hayallerimdeki gemi yapabilecek tek kişi..Dialogue: 0,0:37:15.49,0:37:16.80,Thoughts,,0,0,0,,sensin.Dialogue: 0,0:37:18.85,0:37:24.58,Thoughts,,0,0,0,,Yaşadığımız maceralardan kat be kat daha zorlarının üstesinden gelmemizi sağlayacak...Dialogue: 0,0:37:25.60,0:37:27.02,Thoughts,,0,0,0,,...teknolojiler öğreneceğim.Dialogue: 0,0:37:27.02,0:37:28.69,Thoughts,,0,0,0,,O halde Luffy...Dialogue: 0,0:37:30.65,0:37:32.36,Main,,0,0,0,,Hey. Kaplan postu alev aldı.Dialogue: 0,0:37:40.84,0:37:41.54,Main,,0,0,0,,O ne?!Dialogue: 0,0:37:42.64,0:37:44.41,Main,,0,0,0,,Bir yaratık?! Dikkatli olun!Dialogue: 0,0:37:57.10,0:38:00.74,Thoughts,,0,0,0,,O halde Luffy, zorlukları beraber aşalım!Dialogue: 0,0:38:00.74,0:38:02.89,Thoughts,,0,0,0,,Yeni Dünya'nın çetin denizlerine doğru!Dialogue: 0,0:38:06.47,0:38:09.69,Narrator,,0,0,0,,Bu olay Grand Line tarihine...Dialogue: 0,0:38:09.69,0:38:13.93,Narrator,,0,0,0,,Baldimore'un Alevli Yaratık Ruhu'nun Efsanesi olarak geçti.Dialogue: 0,0:38:16.50,0:38:21.08,Narrator,,0,0,0,,Bu arada, Grand Line'da Bowin Takımadaları.Dialogue: 1,0:38:19.61,0:38:23.58,Captions,,0,0,0,,Bowin Takımadaları, Grand LineDialogue: 0,0:38:24.30,0:38:26.97,Main,,0,0,0,,Sorun nedir, Usopp-un?Dialogue: 0,0:38:26.97,0:38:29.89,Main,,0,0,0,,Biraz yağ yakacağım! Egzersiz yapmam lazım!Dialogue: 0,0:38:29.89,0:38:32.23,Main,,0,0,0,,Oh! Bu harika bir fikir!Dialogue: 0,0:38:32.23,0:38:33.76,Main,,0,0,0,,Ve daha güçlü olacağım!Dialogue: 0,0:38:33.76,0:38:37.31,Main,,0,0,0,,Çok iyi! Bu adadan başka türlü çıkamazsın zaten!Dialogue: 0,0:38:37.31,0:38:39.91,Main,,0,0,0,,Sonra daha da güçlü olacağım!Dialogue: 0,0:38:39.91,0:38:41.78,Main,,0,0,0,,Evet! Kulağa güzel geliyor!Dialogue: 0,0:38:41.78,0:38:45.26,Main,,0,0,0,,Sonra çok çok daha güçlü olacağım!Dialogue: 0,0:38:45.26,0:38:46.60,Main,,0,0,0,,Vay be!Dialogue: 0,0:38:46.60,0:38:49.98,Main,,0,0,0,,Çok çok çok çok çok daha güçlü!Dialogue: 0,0:38:49.98,0:38:51.97,Main,,0,0,0,,Ne kadar da motivesin!Dialogue: 0,0:38:53.45,0:38:55.78,Main,,0,0,0,,Bir anda böyle egzersizlere başlamak falan.Dialogue: 0,0:38:56.93,0:38:59.88,Main,,0,0,0,,Gazetede ne yazıyordu?Dialogue: 0,0:39:05.02,0:39:08.36,Main,,0,0,0,,Kaptanımızdan bir mesaj aldım.Dialogue: 0,0:39:08.86,0:39:09.83,Main,,0,0,0,,Mesaj mı?Dialogue: 0,0:39:10.60,0:39:13.66,Flashbacks,,0,0,0,,Ne anlatıyorsun? Hadi gel gemiye.Dialogue: 0,0:39:16.47,0:39:19.06,Flashbacks,,0,0,0,,Arkadaşız değil mi?Dialogue: 0,0:39:29.55,0:39:32.26,Flashbacks,,0,0,0,,Luffy!Dialogue: 0,0:39:33.80,0:39:36.16,Flashbacks,,0,0,0,,U-Usopp...Dialogue: 0,0:39:36.16,0:39:38.65,Flashbacks,,0,0,0,,S-sen...Dialogue: 0,0:39:38.65,0:39:40.50,Flashbacks,,0,0,0,,burada mıydın?Dialogue: 0,0:39:40.92,0:39:45.43,Flashbacks,,0,0,0,,Kazan! Ve hep beraber geri dönelim, Luffy!Dialogue: 0,0:39:45.43,0:39:47.46,Flashbacks,,0,0,0,,Tabii ki beraber döneceğiz!Dialogue: 0,0:39:50.76,0:39:52.22,Main,,0,0,0,,Ben...Dialogue: 0,0:39:52.22,0:39:59.38,Main,,0,0,0,,Luffy kendi başına Korsanlar Kralı olur, ben de kenardan izlerim sanıyordum.Dialogue: 0,0:40:00.81,0:40:03.08,Flashbacks,,0,0,0,,Sonunda geldik!Dialogue: 0,0:40:04.28,0:40:09.50,Flashbacks,,0,0,0,,Dünyanın öbür yarısına geçip bu duvarı gördüğümüzde...Dialogue: 0,0:40:09.50,0:40:10.53,Flashbacks,,0,0,0,,Ve o zaman ben...Dialogue: 0,0:40:10.82,0:40:13.07,Flashbacks,,0,0,0,,Korsanlar Kralı olacağım!Dialogue: 0,0:40:13.68,0:40:16.20,Main,,0,0,0,,Ama yanılmışım.Dialogue: 0,0:40:16.20,0:40:19.26,Main,,0,0,0,,Onun bile yenemeyeceği tonla düşmanı var.Dialogue: 0,0:40:19.83,0:40:22.00,Main,,0,0,0,,Luffy bile yenilebilir!Dialogue: 0,0:40:22.00,0:40:25.60,Main,,0,0,0,,Kendini çok zorluyor! Kendini paralıyor!Dialogue: 0,0:40:25.60,0:40:26.84,Main,,0,0,0,,Bu yüzden...Dialogue: 0,0:40:27.10,0:40:30.47,Main,,0,0,0,,benim desteğime ihtiyacı var!Dialogue: 0,0:40:35.01,0:40:36.72,Main,,0,0,0,,Heracles-un!Dialogue: 0,0:40:36.72,0:40:38.63,Main,,0,0,0,,Daha güçlü olmak istiyorum!Dialogue: 0,0:40:38.63,0:40:42.12,Main,,0,0,0,,Çok çok daha güçlü!Dialogue: 0,0:40:44.45,0:40:47.26,Main,,0,0,0,[Honorifics],Lütfen, Heracles-un-sensei...Dialogue: 0,0:40:47.67,0:40:49.90,Main,,0,0,0,,Ha? Sensei?Dialogue: 0,0:40:49.90,0:40:53.61,Main,,0,0,0,,Kullandığın silah ilgimi çekti.Dialogue: 0,0:40:53.61,0:40:58.94,Main,,0,0,0,,Senden öğrenmek istediğim çok şey var, bu adada hayatta kaldığına göre çok yetenekli olmalısın!Dialogue: 0,0:40:58.94,0:41:01.94,Main,,0,0,0,[Linebreaker Removed],Yetenekli mi? Gerçekten öyle olduğumu mu düşünüyorsun?Dialogue: 0,0:41:01.94,0:41:04.81,Main,,0,0,0,,Evet! Çok yetenekli bir ustasın!Dialogue: 0,0:41:04.81,0:41:05.89,Main,,0,0,0,,Ve,Dialogue: 0,0:41:05.89,0:41:06.98,Main,,0,0,0,,benim adım...Dialogue: 0,0:41:08.14,0:41:09.45,Main,,0,0,0,,Heracles-un!Dialogue: 0,0:41:09.45,0:41:11.59,Main,,0,0,0,,Ne kadar havalı bir isim!Dialogue: 0,0:41:12.30,0:41:15.63,Main,,0,0,0,,E-evet! Yerini al, Usopp-un.Dialogue: 0,0:41:15.63,0:41:17.28,Main,,0,0,0,,Hay hay, sensei!Dialogue: 0,0:41:18.00,0:41:19.93,Main,,0,0,0,,Dinle öğrencim Usopp-un!Dialogue: 0,0:41:20.70,0:41:28.52,Main,,0,0,0,,Bu adada pop green denen bitkiler vardır. Anında filizlenirler ve çok düşmancıldırlar.Dialogue: 0,0:41:29.73,0:41:32.03,Main,,0,0,0,,Tohumları buna benzer.Dialogue: 0,0:41:32.60,0:41:34.97,Main,,0,0,0,,Pop green mi?Dialogue: 0,0:41:34.97,0:41:39.62,Main,,0,0,0,,Her birinin farklı bir işlevi vardır.Dialogue: 0,0:41:39.62,0:41:41.21,Main,,0,0,0,,Anlıyorum.Dialogue: 0,0:41:41.21,0:41:43.45,Thoughts,,0,0,0,,Bekle, Luffy!Dialogue: 0,0:41:45.60,0:41:49.96,Main,,0,0,0,,Koş, Usopp-un! Orman seni çok daha güçlü bir hale getirecek!Dialogue: 0,0:41:50.82,0:41:53.23,Thoughts,,0,0,0,,Senin Korsanlar Kralı olmana yardımcı olmak için,Dialogue: 0,0:41:53.23,0:41:57.01,Thoughts,,0,0,0,,Ben de Keskin Nişancılar Kralı olacağım!Dialogue: 0,0:42:03.70,0:42:10.05,Narrator,,0,0,0,[Linebreaker Removed],Grand Line'da Gloom Adası Muggy Krallığı harabeleri.Dialogue: 1,0:42:05.03,0:42:10.74,Captions,,0,0,0,,Muggy Krallığı HarabeleriDialogue: 1,0:42:05.03,0:42:10.74,Captions,,0,0,0,,Gloom Adası, Grand LineDialogue: 0,0:42:10.96,0:42:11.94,Main,,0,0,0,,Sana yalvarıyorum!Dialogue: 0,0:42:19.58,0:42:21.98,Main,,0,0,0,,Lütfen beni kılıç sanatında eğit!Dialogue: 0,0:42:22.70,0:42:25.11,Main,,0,0,0,,Senin hakkında yanılmışım, Roronoa.Dialogue: 0,0:42:26.96,0:42:30.13,Main,,0,0,0,,Ezeli düşmanından seni eğitmesini mi istiyorsun?Dialogue: 0,0:42:30.71,0:42:31.90,Main,,0,0,0,,Kendinden utanmalısın!Dialogue: 0,0:42:33.86,0:42:37.07,Main,,0,0,0,[Linebreaker Removed],Gözüme gözükme. Senin gibi beş para etmez bir adamla işim olmaz.Dialogue: 0,0:42:37.07,0:42:40.88,Main,,0,0,0,,Görünen o ki seni gözümde fazla büyütmüşüm.Dialogue: 0,0:42:43.51,0:42:46.68,Main,,0,0,0,[Linebreaker Removed],Ne yapıyorsun? Kendini rezil ediyorsun.Dialogue: 0,0:42:47.44,0:42:49.60,Main,,0,0,0,,Güçlenmek istiyorum!Dialogue: 0,0:42:49.60,0:42:52.86,Main,,0,0,0,,Babunları yenemedin, adayı terk edemedin.Dialogue: 0,0:42:52.86,0:42:57.79,Main,,0,0,0,[Linebreaker Removed],Sonra da tıpış tıpış buraya döndün.  Senin gibi birine öğretecek hiçbir şeyim yok.Dialogue: 0,0:42:57.79,0:42:59.42,Main,,0,0,0,,Babunları yendim.Dialogue: 0,0:43:00.82,0:43:02.19,Thoughts,,0,0,0,,Onları yenmiş mi?Dialogue: 0,0:43:03.48,0:43:06.16,Main,,0,0,0,,Geriye senin kelleni almak kaldı!Dialogue: 0,0:43:06.16,0:43:12.57,Main,,0,0,0,,Ama şu anda seni yenebileceğimi düşünecek kadar aptal değilim.Dialogue: 0,0:43:12.57,0:43:17.30,Main,,0,0,0,[Linebreaker Removed],Anlamıyorum. Beni hala düşmanın olarak görüyorsan,Dialogue: 0,0:43:17.30,0:43:20.58,Main,,0,0,0,[Linebreaker Removed],neden önümde diz çöküp seni eğitmemi istiyorsun?Dialogue: 0,0:43:21.36,0:43:22.67,Main,,0,0,0,,Amacın ne?!Dialogue: 0,0:43:24.39,0:43:26.46,Main,,0,0,0,,Seni geçebilmek için!Dialogue: 0,0:43:34.30,0:43:39.10,Main,,0,0,0,,Yani benden bir gün gelip kellemi alacak kılıç ustasını eğitmemi mi bekliyorsun?Dialogue: 0,0:43:39.10,0:43:42.92,Main,,0,0,0,,Ne garip adamsın. Saçmalık bu!Dialogue: 0,0:43:42.92,0:43:46.07,Main,,0,0,0,,Ve hala kendini küçük düşürüyorsun.Dialogue: 0,0:43:46.07,0:43:50.61,Main,,0,0,0,[Linebreaker Removed],Görünen o ki hırsla yanıp kavrulan birini buldum.Dialogue: 0,0:43:52.24,0:43:56.18,Main,,0,0,0,,Hey, hayalet kız. Yaralarını iyileştir.Dialogue: 0,0:43:57.04,0:43:59.52,Main,,0,0,0,,Hey! Bana emir verme!Dialogue: 0,0:44:00.42,0:44:02.53,Main,,0,0,0,,Eğitimin yaraların iyileştikten sonra başlayacak.Dialogue: 0,0:44:03.50,0:44:07.81,Main,,0,0,0,,Lanet olsun! Herkes bana emir verip duruyor!Dialogue: 0,0:44:07.81,0:44:10.20,Main,,0,0,0,,Hadi odana geri dön!Dialogue: 0,0:44:12.32,0:44:13.93,Thoughts,,0,0,0,,Ne garip bir adam.Dialogue: 0,0:44:14.62,0:44:20.93,Thoughts,,0,0,0,,Onun gibi biri gururunu kenara atıyorsa bir başkasının hatırı için olmalı.Dialogue: 0,0:44:22.06,0:44:25.57,Main,,0,0,0,,Üzerinde çarpı olan "3D" ve "2Y" mi?Dialogue: 0,0:44:25.57,0:44:28.74,Main,,0,0,0,,Haklısın! Hasır Şapka'nın sağ kolunda dövme olarak var!Dialogue: 0,0:44:28.74,0:44:33.90,Main,,0,0,0,[Linebreaker Removed],Üç gün içinde bir yerde buluşmak için sözleşmiştik,Dialogue: 0,0:44:34.86,0:44:36.85,Main,,0,0,0,,ama planlar değişti!Dialogue: 0,0:44:37.15,0:44:40.88,Main,,0,0,0,,Yani "3D" üç gün anlamına mı geliyor?Dialogue: 0,0:44:40.88,0:44:44.56,Main,,0,0,0,,Ama "3D" nin üzeri çizilmiş ve "2Y" de...Dialogue: 0,0:44:45.14,0:44:46.00,Main,,0,0,0,,İki yıl.Dialogue: 0,0:44:46.00,0:44:47.26,Main,,0,0,0,,İki yıl mı?!Dialogue: 0,0:44:47.26,0:44:51.35,Main,,0,0,0,[Linebreaker Removed],Üç gün değil iki yıl sonra buluşacağız.Dialogue: 0,0:44:47.26,0:44:51.35,Note,,0,0,0,[Linebreaker Removed],3D: 3 Day (Gün), üstü çizildiği için "3 gün değil" anlamında...  2Y: 2 Year (Yıl)Dialogue: 0,0:44:51.35,0:44:55.70,Main,,0,0,0,[Linebreaker Removed],Diğer her şey dikkat dağıtıp asıl mesajı gizlemek içindi.Dialogue: 0,0:44:55.70,0:45:02.05,Main,,0,0,0,,Bu mesaj sadece bizim içindi.  Luffy'nin aldığı karar bu.Dialogue: 0,0:45:02.70,0:45:06.77,Main,,0,0,0,[Linebreaker Removed],Acele etmenin manası yok.  Bu halimizle Yeni Dünya'da harcarlar bizi.Dialogue: 0,0:45:06.77,0:45:09.05,Main,,0,0,0,,İlerlemeyi bir süre bırakıp güçleneceğiz!Dialogue: 0,0:45:10.15,0:45:13.22,Main,,0,0,0,,Ve bir kez daha denize açılacağız!Dialogue: 0,0:45:13.69,0:45:17.15,Main,,0,0,0,,İki yıl sonra Sabaody Takımadaları'nda!Dialogue: 1,0:45:19.63,0:45:22.97,Captions,,0,0,0,,Birkaç gün sonraDialogue: 1,0:45:19.63,0:45:22.97,Captions,,0,0,0,,Calm Belt'deDialogue: 0,0:45:27.90,0:45:29.37,Main,,0,0,0,,İşte geliyor.Dialogue: 0,0:45:34.14,0:45:36.85,Main,,0,0,0,,Jinbe! Her şey için teşekkürler!Dialogue: 0,0:45:36.85,0:45:40.58,Main,,0,0,0,,Asıl ben sana teşekkür etmeliyim!Dialogue: 0,0:45:46.72,0:45:51.66,Main,,0,0,0,,Savunmamı dinleyip Impel Down'dan kaçmama yardım ettiğin için,Dialogue: 0,0:45:51.66,0:45:55.63,Main,,0,0,0,,utanç içinde de olsa hayatıma devam etmemi sağladığın için.Dialogue: 0,0:45:55.63,0:45:57.73,Main,,0,0,0,,Sana ne kadar teşekkür etsem azdır.Dialogue: 0,0:45:59.03,0:46:02.20,Main,,0,0,0,,Sana bunu kesmeni söylemiştim.Dialogue: 0,0:46:02.20,0:46:08.31,Main,,0,0,0,[Linebreaker Removed],Sen orada olmasaydın,  Donanma Karargâhı'na kadar gidemezdim.Dialogue: 0,0:46:08.78,0:46:10.27,Main,,0,0,0,,Başını dik tut.Dialogue: 0,0:46:21.60,0:46:23.59,Main,,0,0,0,,Galiba haklısın.Dialogue: 0,0:46:23.59,0:46:28.33,Main,,0,0,0,,Belki bir gün sana tekrar yardım etme şansım olur.Dialogue: 0,0:46:29.34,0:46:32.97,Main,,0,0,0,[Linebreaker Removed],İki yıl içinde Balık Adam Adası'nda tekrar buluşalım!Dialogue: 0,0:46:32.97,0:46:37.77,Main,,0,0,0,,Senin ve tayfanın geleceği günü dört gözle bekliyorum!Dialogue: 0,0:46:37.77,0:46:38.85,Main,,0,0,0,,Tabii!Dialogue: 0,0:46:41.78,0:46:43.55,Main,,0,0,0,,Kendine iyi bak!Dialogue: 1,0:46:47.62,0:46:52.42,Captions,,0,0,0,,Ruskaina, bir çöl adasıDialogue: 1,0:46:47.62,0:46:52.42,Captions,,0,0,0,,Kadınlar Adası'nın kuzeybatısı, Calm BeltDialogue: 0,0:46:53.32,0:46:55.49,Main,,0,0,0,,Bu ada ideal.Dialogue: 0,0:46:55.49,0:47:00.33,Main,,0,0,0,,48 mevsim adası derler buraya.  Mevsimin haftada bir değiştiği acımasız bir adadır.Dialogue: 0,0:47:00.33,0:47:02.20,Main,,0,0,0,,Luffy.Dialogue: 0,0:47:02.20,0:47:09.00,Main,,0,0,0,[Linebreaker Removed],Sana Kadınlar Adası'ndan her gün yemek getireceğim!Dialogue: 0,0:47:09.00,0:47:11.64,Main,,0,0,0,,Gerçekten mi Hancock?Dialogue: 0,0:47:11.64,0:47:15.16,Main,,0,0,0,[Linebreaker Removed],O halde sizin o özel yemeğinizden istiyorum, gorgon bi'şeyiydi adı!Dialogue: 0,0:47:15.16,0:47:17.21,Main,,0,0,0,,Çok lezzetliydi!Dialogue: 0,0:47:17.21,0:47:19.07,Main,,0,0,0,,T-Tabii...Dialogue: 0,0:47:19.88,0:47:21.75,Main,,0,0,0,,Yılan Prenses!Dialogue: 0,0:47:21.75,0:47:25.49,Main,,0,0,0,,Sana en sevdiğin yemeklerden istediğin kadar getireceğim.Dialogue: 0,0:47:26.32,0:47:30.69,Main,,0,0,0,,Ve bu ismimi onuncu kez söyleyişindi!Dialogue: 0,0:47:32.54,0:47:35.50,Main,,0,0,0,,Nişanlanmak böyle bir şey mi?Dialogue: 0,0:47:35.50,0:47:39.70,Main,,0,0,0,,Hayır değil! Ayrıca niye geri geri kaçıyorsun?Dialogue: 0,0:47:39.70,0:47:43.91,Main,,0,0,0,,Hancock, onu böyle şımartamazsın.Dialogue: 0,0:47:43.91,0:47:48.30,Main,,0,0,0,,Luffy-kun eğitim sürecindeyken hiçbir kadının buraya ayak basmasına müsade etmeyeceğim!Dialogue: 0,0:47:50.38,0:47:55.08,Main,,0,0,0,,Sen kimsin de buna karar veriyorsun, Rayleigh?!Dialogue: 0,0:47:55.08,0:47:58.45,Main,,0,0,0,,Akıllıca cevap ver,  seni taşa çevirmek zorunda kalmayayım!Dialogue: 0,0:47:58.45,0:48:03.93,Main,,0,0,0,[Linebreaker Removed],Dağlarda, ormanda, nehirlerde ve okyanusta istediği kadar yiyecek bulabilir!Dialogue: 0,0:48:03.93,0:48:06.78,Main,,0,0,0,,Lütfen burnunu bırakın Yılan Prenses!Dialogue: 0,0:48:06.78,0:48:11.37,Main,,0,0,0,,Eğer temel ihityaçlarını karşılamayı öğrenemezse nasıl korsan olacak!Dialogue: 0,0:48:11.37,0:48:13.34,Main,,0,0,0,,Bunlar hep Luffy-kun'un iyiliği için!Dialogue: 0,0:48:15.34,0:48:18.45,Main,,0,0,0,,Luffy'nin iyiliği için... mi dedin?Dialogue: 0,0:48:19.35,0:48:20.51,Main,,0,0,0,,Evet.Dialogue: 0,0:48:20.51,0:48:22.44,Main,,0,0,0,,Luffy'nin iyiliği için..Dialogue: 0,0:48:24.96,0:48:26.38,Main,,0,0,0,,O zaman tamam!Dialogue: 0,0:48:27.88,0:48:31.62,Main,,0,0,0,,Ama Rayleigh, bu ada gerçekten tehlikeli.Dialogue: 0,0:48:31.62,0:48:33.19,Main,,0,0,0,,Ona bir şey olursa...Dialogue: 0,0:48:33.19,0:48:36.00,Main,,0,0,0,,Eğer güvende olacaksa eğitimin bir manası yok.Dialogue: 0,0:48:36.00,0:48:37.94,Main,,0,0,0,,Eğer onun için endişeleniyorsan  iyi olması için dua et.Dialogue: 0,0:48:40.43,0:48:46.07,Main,,0,0,0,,Pekala... Şimdi bu adada  bizden başka insan kalmadı.Dialogue: 0,0:48:46.83,0:48:51.96,Main,,0,0,0,[Linebreaker Removed],Bu uçsuz bucaksız doğaya iyi bak. Derler ki burada eskiden bir ülke varmış.Dialogue: 0,0:48:51.96,0:48:55.41,Main,,0,0,0,,Ama doğa şartları insanların yaşaması için fazla sertmiş.Dialogue: 0,0:48:55.41,0:48:58.55,Main,,0,0,0,[Linebreaker Removed],Sadece güçlünün hayatta kalabildiği vahşi bir doğa.Dialogue: 0,0:49:08.93,0:49:10.73,Main,,0,0,0,,Buranın havası macera kokuyor!Dialogue: 0,0:49:16.77,0:49:19.97,Main,,0,0,0,,Ada yaratıklarla dolu.Dialogue: 0,0:49:20.38,0:49:22.40,Main,,0,0,0,,Ben bile hepsini sayamadım.Dialogue: 0,0:49:23.21,0:49:28.18,Main,,0,0,0,[Linebreaker Removed],Şu anki halinle en az 500 tanesi seni paket eder.Dialogue: 0,0:49:28.86,0:49:32.38,Main,,0,0,0,[Linebreaker Removed],Güçlenmelisin yoksa geceleri uyuyamazsın.Dialogue: 0,0:49:32.38,0:49:36.25,Main,,0,0,0,,Burada kaç tane var veya adada toplam ne kadar var nasıl sayıyorsun?Dialogue: 0,0:49:36.25,0:49:40.52,Main,,0,0,0,[Linebreaker Removed],Yakında anlayacaksın.  Bu gücü kullanmayı sen de öğreneceksin.Dialogue: 0,0:49:41.38,0:49:43.23,Main,,0,0,0,,Haki denen gücü!Dialogue: 0,0:49:49.03,0:49:51.93,Main,,0,0,0,,Bak! Baksana! Bir şey geldi, Rayleigh amca! Dialogue: 0,0:49:51.93,0:49:54.38,Main,,0,0,0,,Amca, baksana arkanda!Dialogue: 0,0:49:54.38,0:50:00.44,Main,,0,0,0,,Dinle, Luffy.  Haki herkesin içinde yatan bir güçtür.Dialogue: 0,0:50:00.44,0:50:03.23,Main,,0,0,0,,Bu bi fil mi?! Normal bir filden en az beş kat daha büyük!Dialogue: 0,0:50:03.23,0:50:04.88,Main,,0,0,0,,Devasa bir fil!Dialogue: 0,0:50:05.80,0:50:09.25,Main,,0,0,0,,Varlık, mücadele ruhu, kontrol.Dialogue: 0,0:50:09.25,0:50:13.88,Main,,0,0,0,,Diğer duyulardan bir farkı yok aslında.Dialogue: 0,0:50:15.33,0:50:18.92,Main,,0,0,0,,Ama ortalama insanlar  bu gücün farkında bile değiller,Dialogue: 0,0:50:18.92,0:50:22.54,Main,,0,0,0,[Linebreaker Removed],veya uğruna bir ömür harcayıp geliştiremedikleri bir güç.Dialogue: 0,0:50:25.40,0:50:29.57,Main,,0,0,0,,Tüm kuşkuları elimine etmek.  Gerçek güç bu.Dialogue: 0,0:50:31.88,0:50:32.74,Main,,0,0,0,,D-dikkat et!Dialogue: 0,0:50:35.25,0:50:36.98,Main,,0,0,0,,Gear Second.Dialogue: 0,0:50:35.25,0:50:36.98,Note,,0,0,0,,2. VitesDialogue: 0,0:50:36.98,0:50:39.08,Main,,0,0,0,[Attack],Jet Pistol.Dialogue: 0,0:50:36.98,0:50:39.08,Attack,,0,0,0,[Attack],Jet TabancaDialogue: 0,0:50:46.82,0:50:51.93,Main,,0,0,0,[Linebreaker Removed],Lanet olsun, file bak hele!  Hem güçlü hem de çok hızlı!Dialogue: 0,0:50:55.56,0:50:57.47,Main,,0,0,0,,Dikkatli izle.Dialogue: 0,0:50:57.47,0:51:00.14,Main,,0,0,0,,Haki genelde iki ayrı formdadır.Dialogue: 0,0:51:01.86,0:51:03.10,Main,,0,0,0,,Dikkat et!Dialogue: 0,0:51:03.10,0:51:04.17,Main,,0,0,0,,Her şey yolunda.Dialogue: 0,0:51:04.17,0:51:08.14,Main,,0,0,0,,Fil hortumunu bana sağ taraftan savuracak.Dialogue: 0,0:51:13.52,0:51:16.60,Main,,0,0,0,,Rakibinin varlığına karşı duyarlı olma hali.Dialogue: 0,0:51:16.60,0:51:19.15,Main,,0,0,0,,Buna gözlem hakisi denir.Dialogue: 0,0:51:23.34,0:51:24.29,Main,,0,0,0,,İnanılmaz.Dialogue: 0,0:51:24.29,0:51:25.88,Main,,0,0,0,,Bu güçte ustalaşırsan,Dialogue: 0,0:51:25.88,0:51:29.47,Main,,0,0,0,,görüş mesafenin dışındaki düşmanlarının yerlerini ve sayılarını sezebilirsin.Dialogue: 0,0:51:29.63,0:51:34.02,Main,,0,0,0,,Hatta rakibinin bir sonraki hamlesini bile sezebilirsin.Dialogue: 0,0:51:34.74,0:51:36.21,Flashbacks,,0,0,0,,Sol ayakla bir tekme.Dialogue: 0,0:51:37.14,0:51:38.31,Flashbacks,,0,0,0,,Mantra.Dialogue: 0,0:51:42.95,0:51:46.85,Main,,0,0,0,,Gökyüzü adası Skypiea'da bu güce "mantra" derler.Dialogue: 0,0:51:49.45,0:51:50.97,Main,,0,0,0,,Çok yakındı!Dialogue: 0,0:51:51.60,0:51:53.96,Main,,0,0,0,,Bir diğeri, silahlanma hakisi.Dialogue: 0,0:51:53.96,0:51:57.53,Main,,0,0,0,,Bu görünmez bir zırh giymek gibidir.Dialogue: 0,0:52:00.96,0:52:01.86,Main,,0,0,0,,Amca!Dialogue: 0,0:52:13.80,0:52:16.04,Main,,0,0,0,,Bunu... biliyorum!Dialogue: 0,0:52:16.04,0:52:17.65,Flashbacks,,0,0,0,[Attack],Ashigara Dokkoi!Dialogue: 0,0:52:16.04,0:52:17.65,Attack,,0,0,0,[Attack],Bacak Kilidi İvmeli İtişDialogue: 0,0:52:22.28,0:52:25.85,Main,,0,0,0,,Daha güçlü bir zırh elbet  saldırını da daha güçlü kılacaktır.Dialogue: 0,0:52:28.59,0:52:32.29,Main,,0,0,0,,Çok acıdı!  Lastiktenim ama o fiske amma acıttı!Dialogue: 0,0:52:32.29,0:52:36.00,Main,,0,0,0,,Bu bu gücün en faydalı kısmı.Dialogue: 0,0:52:36.70,0:52:43.12,Main,,0,0,0,[Linebreaker Removed],Şeytan meyvesi kullanıcıları ile dövüşürken silahlanma hakisi en büyük silahın olacak.Dialogue: 0,0:52:43.12,0:52:46.52,Main,,0,0,0,,Aksi taktirde onların bireysel güçlerinde bir zayıflık bulmalısın.Dialogue: 0,0:52:49.28,0:52:55.14,Main,,0,0,0,,Logia kullanıcılarının istedikleri şekle giren zarar verilemez vücutları bile,Dialogue: 0,0:52:55.14,0:52:57.99,Main,,0,0,0,,bu şekilde zarar verilebilir.Dialogue: 0,0:52:58.65,0:53:01.62,Main,,0,0,0,,Kizaru'ya bu yüzden mi dokunabiliyordun?Dialogue: 0,0:53:01.62,0:53:06.93,Main,,0,0,0,[Linebreaker Removed],Yani bu şekilde Donanma'dan Smoker ve Aokiji'ye de vurabilir miyim?Dialogue: 0,0:53:11.30,0:53:14.95,Main,,0,0,0,,Bu güç silahlara da uygulanabilir.Dialogue: 0,0:53:14.95,0:53:17.14,Main,,0,0,0,,Kuja Kabilesi'nin okçularını gördün mü?Dialogue: 0,0:53:17.14,0:53:18.47,Main,,0,0,0,,Evet...Dialogue: 0,0:53:22.24,0:53:24.08,Main,,0,0,0,,Çelik oklar diye düşünmüştüm.Dialogue: 0,0:53:24.45,0:53:27.45,Main,,0,0,0,,Gözlem ve silahlanma hakisi.Dialogue: 0,0:53:27.45,0:53:29.65,Main,,0,0,0,,Bunlar haki tipleridir.Dialogue: 0,0:53:30.03,0:53:35.62,Main,,0,0,0,,Ayrıca çok nadir olarak bazı insanlar bir başka tür haki de kullanabilirler.Dialogue: 0,0:53:40.48,0:53:41.56,Main,,0,0,0,,Dikkatli dinle.Dialogue: 0,0:54:05.93,0:54:08.46,Main,,0,0,0,,Bu rakiplerini kontrol etmek için,Dialogue: 0,0:54:08.96,0:54:10.84,Main,,0,0,0,,adı fatih'in hakisi.Dialogue: 0,0:54:12.90,0:54:16.37,Main,,0,0,0,,Bu dünyada kendine isim yapmış çoğu insan...Dialogue: 0,0:54:16.37,0:54:20.36,Main,,0,0,0,,içinde bu gücü taşır.Dialogue: 0,0:54:20.36,0:54:27.04,Main,,0,0,0,,Ancak fatih'in hakisi kontrol edilebilse bile eğitilebilen bir şey değildir.Dialogue: 0,0:54:27.75,0:54:30.20,Main,,0,0,0,,Kullanıcısının ruhuna bağlıdır...Dialogue: 0,0:54:31.13,0:54:33.78,Main,,0,0,0,[Linebreaker Removed],Onu güçlendirmenin tek yolu kendi iradeni güçlendirmektir.Dialogue: 0,0:54:34.75,0:54:38.25,Main,,0,0,0,,Müzayede'de onu kullanmıştın!Dialogue: 0,0:54:39.86,0:54:42.08,Main,,0,0,0,,Eminim sen de onu tecrübe ettin.Dialogue: 0,0:54:42.62,0:54:46.60,Main,,0,0,0,,Fatih potansiyelin uyanıyor bile.Dialogue: 0,0:54:46.60,0:54:51.94,Main,,0,0,0,,Ancak tamamen kontrol edebilene kadar onu kullanmaktan sakınmalısın.Dialogue: 0,0:54:51.94,0:54:56.46,Main,,0,0,0,,Aksi takdirde etrafındaki zararsız kişileri de etkilersin.Dialogue: 0,0:54:59.74,0:55:00.98,Main,,0,0,0,,Ne oldu?Dialogue: 0,0:55:04.68,0:55:06.68,Main,,0,0,0,,İnanılmaz!Dialogue: 0,0:55:06.68,0:55:12.12,Main,,0,0,0,[Linebreaker Removed],Korsanlar Kralı'nın tayfası bu yaratıkları dokunmadan bile yenebiliyor ha!Dialogue: 0,0:55:14.52,0:55:16.29,Main,,0,0,0,,Ne oldu bana saygı duymaya mı başladın?Dialogue: 0,0:55:17.73,0:55:18.74,Main,,0,0,0,,Evet!Dialogue: 0,0:55:19.20,0:55:24.08,Main,,0,0,0,,Ama bu haki denen şeyi daha önce görmüştüm.Dialogue: 0,0:55:24.72,0:55:27.56,Main,,0,0,0,,Shanks... Dedem...Dialogue: 0,0:55:27.56,0:55:29.03,Main,,0,0,0,,Enel ve Aisa...Dialogue: 0,0:55:29.03,0:55:32.37,Main,,0,0,0,,ek olarak Hancock'da ve Kuja savaşçılarında.Dialogue: 0,0:55:32.37,0:55:37.85,Main,,0,0,0,[Linebreaker Removed],Eminim görmüşsündür.  Ancak haki kullanmayı öğrenmek kolay olmayacak.Dialogue: 0,0:55:38.82,0:55:40.10,Main,,0,0,0,,Pekala.Dialogue: 0,0:55:46.96,0:55:50.16,Main,,0,0,0,,Normalde bu iş için ayırdığımız süre yetmezdi amaDialogue: 0,0:55:50.16,0:55:51.89,Main,,0,0,0,,sende potansiyel var.Dialogue: 0,0:55:52.75,0:55:54.56,Main,,0,0,0,,Önümüzdeki iki yıl boyunca,Dialogue: 0,0:55:54.56,0:56:00.50,Main,,0,0,0,[Linebreaker Removed],Sana gözlem, silahlanma ve fatih'in hakisinin temellerini öğreteceğim.Dialogue: 0,0:56:02.40,0:56:07.18,Main,,0,0,0,[Linebreaker Removed],Gelgelelim çoğu insan kendi yetenekleri ve zayıflıklarına göre,Dialogue: 0,0:56:07.18,0:56:09.81,Main,,0,0,0,,spesifik bir haki üzerine eğilir.Dialogue: 0,0:56:09.81,0:56:14.35,Main,,0,0,0,[Linebreaker Removed],En iyi olduklarını seçip ona odaklanırlar.Dialogue: 0,0:56:14.35,0:56:18.49,Main,,0,0,0,[Linebreaker Removed],Eğer üçünde birden kendini eğitirsen, çok başka bir seviyeye gelebilirsin.Dialogue: 0,0:56:18.49,0:56:20.28,Main,,0,0,0,,Evet, anladım.Dialogue: 0,0:56:21.68,0:56:22.74,Main,,0,0,0,,Pekala,Dialogue: 0,0:56:23.69,0:56:27.98,Main,,0,0,0,,Sana müsamaha göstermeyeceğim, Luffy.Dialogue: 0,0:56:28.99,0:56:31.17,Main,,0,0,0,,Evet! Öyle yapmanı istemiyorum zaten!Dialogue: 0,0:56:32.67,0:56:34.44,Main,,0,0,0,,Ah, bekle bir dakika!Dialogue: 0,0:56:39.90,0:56:44.58,Main,,0,0,0,,Amca burası tek güvenli yer demişti değil mi?Dialogue: 0,0:56:46.85,0:56:51.60,Main,,0,0,0,,Hasır Şapkalı Korsan Luffy kısa bir ara veriyor.Dialogue: 0,0:57:18.78,0:57:20.53,Main,,0,0,0,,Ah evet.Dialogue: 0,0:57:22.48,0:57:23.75,Main,,0,0,0,,Bir de bu var.Dialogue: 0,0:57:29.40,0:57:30.32,Main,,0,0,0,,Çocuklar...Dialogue: 0,0:57:33.70,0:57:35.26,Thoughts,,0,0,0,,Luffy!Dialogue: 0,0:57:39.90,0:57:41.66,Main,,0,0,0,,Hey, acele et!Dialogue: 0,0:57:41.66,0:57:43.26,Main,,0,0,0,,Başlıyoruz!Dialogue: 0,0:57:44.02,0:57:45.35,Main,,0,0,0,,Tamamdır!Dialogue: 0,0:57:54.85,0:57:56.89,Main,,0,0,0,,Sana güveniyorum amca!Dialogue: 0,0:57:58.60,0:57:59.80,Main,,0,0,0,,Öyle olmaz.Dialogue: 0,0:57:59.80,0:58:02.40,Main,,0,0,0,[Honorifics],"Lüfen eğit beni, Rayleigh-san" demelisin!Dialogue: 0,0:58:02.40,0:58:04.67,Main,,0,0,0,[Honorifics],Hayır, "Rayleigh-sensei"!Dialogue: 0,0:58:04.67,0:58:05.94,Main,,0,0,0,,Yoksa "Rayleigh Usta" mı desen?Dialogue: 0,0:58:05.94,0:58:08.32,Main,,0,0,0,,Lüfen eğit beni, Rayleigh!Dialogue: 0,0:58:08.32,0:58:10.85,Main,,0,0,0,,Aslında bir önemi yok.Dialogue: 0,0:58:19.03,0:58:24.27,OP14 Translation,,0,0,0,karaoke,♪ Tüm hayallerimizi yığalım...Dialogue: 0,0:58:24.49,0:58:30.10,OP14 Translation,,0,0,0,karaoke,...ve aradığımız şeyi bulmaya gidelim,... ♪Dialogue: 0,0:58:30.42,0:58:31.32,OP14 Translation,,0,0,0,karaoke,♪ ONE PIECE ♪Dialogue: 0,0:58:36.54,0:58:41.35,OP14 Translation,,0,0,0,karaoke,♪ Pusula gibi şeyler sadece bizi yavaşlatır. ♪Dialogue: 0,0:58:42.23,0:58:47.14,OP14 Translation,,0,0,0,karaoke,♪ Ateşten çılgına dönmüşçesine, dümene geçelim. ♪Dialogue: 0,0:58:47.97,0:58:53.17,OP14 Translation,,0,0,0,karaoke,♪ Toza bulanmış eski bir hazine haritası bile,...Dialogue: 0,0:58:53.17,0:58:58.42,OP14 Translation,,0,0,0,karaoke,...gerçek olduğu kanıtlanmışsa efsane değildir! ♪Dialogue: 0,0:59:00.04,0:59:05.51,OP14 Translation,,0,0,0,karaoke,♪ Kendi fırtınalarımız için tüm yapmamız gereken,...Dialogue: 0,0:59:05.83,0:59:10.84,OP14 Translation,,0,0,0,karaoke,...bir başkasının bioritmine tutunmak...Dialogue: 0,0:59:11.02,0:59:12.86,OP14 Translation,,0,0,0,karaoke,...ve orada değilmiş gibi davranmak! ♪Dialogue: 0,0:59:14.74,0:59:20.06,OP14 Translation,,0,0,0,karaoke,♪ Tüm hayallerimizi yığalım...Dialogue: 0,0:59:20.26,0:59:25.62,OP14 Translation,,0,0,0,karaoke,...ve aradığımız şeyi bulmaya gidelim. ♪Dialogue: 0,0:59:25.97,0:59:28.60,OP14 Translation,,0,0,0,karaoke,♪ Bir cep dolusu bozuk para ve...Dialogue: 0,0:59:28.69,0:59:31.88,OP14 Translation,,0,0,0,karaoke,...arkadaşım mı olmak istiyorsun? ♪Dialogue: 0,0:59:32.20,0:59:36.77,OP14 Translation,,0,0,0,karaoke,♪ Biz, biz yolculuktayız! ♪Dialogue: 0,0:59:37.55,0:59:38.40,OP14 Translation,,0,0,0,karaoke,♪ Biz! ♪Dialogue: 0,0:59:43.22,0:59:45.85,Main,,0,0,0,,Zoro, Usopp, Sanji...Dialogue: 0,0:59:45.85,0:59:47.50,Main,,0,0,0,,Nami, Chopper...Dialogue: 0,0:59:47.50,0:59:49.56,Main,,0,0,0,,Robin, Franky, Brook...Dialogue: 0,0:59:50.05,0:59:52.53,Main,,0,0,0,,son olarak Ace ve Sabo!Dialogue: 0,0:59:52.53,0:59:55.10,Main,,0,0,0,,Sözümü tutmak için...Dialogue: 0,0:59:55.10,0:59:57.57,Main,,0,0,0,,...daha da güçleneceğim!Dialogue: 0,0:59:57.60,0:59:58.80,OP14 Translation,,0,0,0,,♪ Biz! ♪Dialogue: 0,0:00:03.62,0:00:06.32,Credits,,0,0,0,,Editing SewilDialogue: 0,0:00:06.32,0:00:09.02,Credits,,0,0,0,,Timing BastiaDialogue: 0,0:00:09.02,0:00:11.46,Credits,,0,0,0,,Karaoke KaitouYahikoDialogue: 0,0:00:11.46,0:00:14.36,Credits,,0,0,0,,QC Galaxy 9000 PepperjackDialogue: 0,0:00:14.36,0:00:16.76,Credits,,0,0,0,,Translation YibisDialogue: 0,0:00:16.76,0:00:18.50,Credits,,0,0,0,,Opening Raw GavynDialogue: 0,0:00:18.59,0:00:22.17,OP14 Translation,,0,0,0,,♪ Keşfedilmemiş yarınlarda buluşmaya,Dialogue: 0,0:00:22.26,0:00:26.69,OP14 Translation,,0,0,0,,yola çıkalım şafak sökmeden. ♪Dialogue: 0,0:00:26.97,0:00:30.33,OP14 Translation,,0,0,0,,♪ Kararımı verdim ve pişman değilim. ♪Dialogue: 0,0:00:30.55,0:00:33.35,OP14 Translation,,0,0,0,,♪ Ne yapmam gerektiğini çok iyi biliyorum. ♪Dialogue: 0,0:00:33.51,0:00:37.07,OP14 Translation,,0,0,0,,♪ Yolumuzda bizi her ne sınav bekliyor olursa olsun,Dialogue: 0,0:00:37.21,0:00:41.70,OP14 Translation,,0,0,0,,kalplerimizin atışını hiçbir şey durduramaz. ♪Dialogue: 0,0:00:41.81,0:00:46.35,OP14 Translation,,0,0,0,,♪ Hepimizin hedefinde tek bir yer var. ♪Dialogue: 0,0:00:46.57,0:00:48.30,OP14 Translation,,0,0,0,,♪ Işığa doğru atıl! ♪Dialogue: 0,0:00:48.32,0:00:52.09,OP14 Translation,,0,0,0,,♪ Savaşlarımız esnasında kurduğumuz bağlara,Dialogue: 0,0:00:52.16,0:00:55.67,OP14 Translation,,0,0,0,,hiç kimsenin zarar vermesine izin vermeyeceğim. ♪Dialogue: 0,0:00:55.80,0:00:58.47,OP14 Translation,,0,0,0,,♪ Yumruklarımızı sıkmayı bırakırsak,Dialogue: 0,0:00:58.60,0:01:01.71,OP14 Translation,,0,0,0,,içlerindeki asıl gücü bulacağız. ♪Dialogue: 0,0:01:01.87,0:01:04.13,OP14 Translation,,0,0,0,,♪ O halde hadi başlayalım! ♪Dialogue: 0,0:01:04.27,0:01:09.28,OP14 Translation,,0,0,0,,♪ Yepyeni bir dünya bizi çağırıyor. ♪Dialogue: 0,0:01:09.38,0:01:11.67,OP14 Translation,,0,0,0,,♪ İleriye bak! ♪Dialogue: 0,0:01:11.78,0:01:18.02,OP14 Translation,,0,0,0,,♪ Birbirimize destek olmayı asla bırakmayacağız,Dialogue: 0,0:01:18.08,0:01:21.79,OP14 Translation,,0,0,0,,aramızda sayısız deniz olsa bile. ♪Dialogue: 0,0:01:21.82,0:01:25.46,OP14 Translation,,0,0,0,,♪ Hadi korkularımızı bir kenara bırakıp, harekete geçelim. ♪Dialogue: 0,0:01:25.96,0:01:27.85,OP14 Translation,,0,0,0,,♪ Lütfen unutma,Dialogue: 0,0:01:27.97,0:01:29.14,OP14 Translation,,0,0,0,,beraber savaşıyoruz. ♪Dialogue: 0,0:01:29.86,0:01:37.12,OP14 Translation,,0,0,0,,♪ O gün baktığımız,Dialogue: 0,0:01:37.54,0:01:39.90,OP14 Translation,,0,0,0,,ufuktaki geniş, görkemli gökyüzü,Dialogue: 0,0:01:40.01,0:01:45.02,OP14 Translation,,0,0,0,,hala tertemiz. ♪Dialogue: 0,0:01:45.04,0:01:48.45,OP14 Translation,,0,0,0,,♪ Kalbimizin derinliklerinde ettiğimiz yeminler ileDialogue: 0,0:01:48.65,0:01:52.41,OP14 Translation,,0,0,0,,çok uzun bir yol geldik. ♪Dialogue: 0,0:01:52.45,0:01:54.99,OP14 Translation,,0,0,0,,♪ Korkacak hiçbir şey yok. ♪Dialogue: 0,0:01:55.05,0:01:59.42,OP14 Translation,,0,0,0,,♪ Hepimizin taşıması gereken yükler var. ♪Dialogue: 0,0:01:59.56,0:02:01.88,OP14 Translation,,0,0,0,,♪ Güneş doğuyorDialogue: 0,0:02:02.03,0:02:06.84,OP14 Translation,,0,0,0,,ve her şeyi aydınlatıyor, hüznümü bile... ♪Dialogue: 0,0:02:06.87,0:02:09.24,OP14 Translation,,0,0,0,,♪ İnanıyorum,Dialogue: 0,0:02:09.34,0:02:15.58,OP14 Translation,,0,0,0,,hepimizin bir olduğu bir geleceğe. ♪Dialogue: 0,0:02:15.71,0:02:19.30,OP14 Translation,,0,0,0,,♪ Hadi gidip onu beraber bulalım. ♪Dialogue: 0,0:02:19.38,0:02:23.11,OP14 Translation,,0,0,0,,♪ Senin yerini kimse dolduramaz. ♪Dialogue: 0,0:02:23.58,0:02:25.24,OP14 Translation,,0,0,0,,♪ Lütfen unutma! ♪Dialogue: 0,0:02:25.56,0:02:27.66,OP14 Translation,,0,0,0,,♪ Beraber savaşıyoruz. ♪