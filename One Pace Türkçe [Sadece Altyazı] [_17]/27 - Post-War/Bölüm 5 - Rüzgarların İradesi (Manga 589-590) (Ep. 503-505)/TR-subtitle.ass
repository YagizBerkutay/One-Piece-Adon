00,0,0,1,2.4,2.4,8,180,180,27,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:16.32,0:00:18.58,Flashbacks,,0,0,0,,Ace! Luffy!Dialogue: 0,0:00:18.58,0:00:21.98,Flashbacks,,0,0,0,,Bir gün üçümüz de denize açılacağız!Dialogue: 0,0:00:21.98,0:00:24.50,Flashbacks,,0,0,0,,Bu ülkeden kurtulup özgürce yaşayacağız!Dialogue: 0,0:00:26.77,0:00:28.94,Flashbacks,,0,0,0,,Bugünden itibaren üçümüz...Dialogue: 0,0:00:29.51,0:00:31.31,Flashbacks,,0,0,0,,Kardeşiz!Dialogue: 0,0:00:31.84,0:00:34.31,Flashbacks,,0,0,0,,Evet!Dialogue: 0,0:00:53.04,0:00:55.13,Main,,0,0,0,,Üzülmeyi ne zaman bırakacaksın?Dialogue: 0,0:00:58.10,0:01:02.57,Main,,0,0,0,,Ormana sakladığımız bütün hazine gitti.Dialogue: 0,0:01:02.57,0:01:06.41,Main,,0,0,0,,Artık o topladığımız paranın bir önemi yok.Dialogue: 0,0:01:06.41,0:01:11.73,Main,,0,0,0,,Sabo ile o parayı kullanacaktık. O bizim Korsan Fonu'muzdu.Dialogue: 0,0:01:11.73,0:01:15.30,Main,,0,0,0,,Ama Sabo o parayı hiç harcamadı.Dialogue: 0,0:01:15.30,0:01:19.38,Main,,0,0,0,,Ben de artık uğraşmayacağım.Dialogue: 0,0:01:19.38,0:01:23.29,Main,,0,0,0,,Sahip çıkamayacaksak hazine toplamanın bir manası yok.Dialogue: 0,0:01:23.29,0:01:25.45,Main,,0,0,0,,A-Ace...Dialogue: 0,0:01:25.45,0:01:26.27,Main,,0,0,0,,Ben...Dialogue: 0,0:01:29.14,0:01:31.44,Main,,0,0,0,,Daha güçlü olmak istiyorum!Dialogue: 0,0:01:32.51,0:01:33.76,Main,,0,0,0,,Daha güçlü!Dialogue: 0,0:01:33.76,0:01:35.28,Main,,0,0,0,,Daha güçlü!Dialogue: 0,0:01:35.28,0:01:36.13,Main,,0,0,0,,Daha güçlü!Dialogue: 0,0:01:36.13,0:01:37.31,Main,,0,0,0,,Daha güçlü!Dialogue: 0,0:01:37.31,0:01:37.91,Main,,0,0,0,,Daha güçlü!Dialogue: 0,0:01:37.91,0:01:38.99,Main,,0,0,0,,Daha güçlü!Dialogue: 0,0:01:38.99,0:01:40.13,Main,,0,0,0,,Daha güçlü!Dialogue: 0,0:01:40.13,0:01:41.01,Main,,0,0,0,,Daha güçlü!Dialogue: 0,0:01:41.01,0:01:42.08,Main,,0,0,0,,Daha güçlü!Dialogue: 0,0:01:42.08,0:01:42.71,Main,,0,0,0,,Daha güçlü!Dialogue: 0,0:01:42.71,0:01:43.88,Main,,0,0,0,,Daha güçlü!Dialogue: 0,0:01:43.88,0:01:44.48,Main,,0,0,0,,Daha güçlü!Dialogue: 0,0:01:44.48,0:01:45.66,Main,,0,0,0,,Daha güçlü!Dialogue: 0,0:01:45.66,0:01:46.28,Main,,0,0,0,,Daha güçlü!Dialogue: 0,0:01:46.28,0:01:47.62,Main,,0,0,0,,Daha güçlü!Dialogue: 0,0:01:47.62,0:01:50.02,Main,,0,0,0,,ve daha da güçlü olmak istiyorum!Dialogue: 0,0:01:50.02,0:01:53.39,Main,,0,0,0,,Ve böylece herkesi koruyabileceğim...Dialogue: 0,0:01:53.39,0:01:55.59,Main,,0,0,0,,Bir daha kimseye karşı kaybetmeyeceğim!Dialogue: 0,0:01:57.27,0:01:59.74,Main,,0,0,0,,Lütfen...Dialogue: 0,0:01:59.74,0:02:04.08,Main,,0,0,0,,Ace... ölme!Dialogue: 0,0:02:04.08,0:02:06.11,Main,,0,0,0,,Saçmalama!Dialogue: 0,0:02:06.11,0:02:08.89,Main,,0,0,0,,Git kendin için endişelen!Dialogue: 0,0:02:08.89,0:02:10.98,Main,,0,0,0,,Benden çok daha güçsüzsün!Dialogue: 0,0:02:11.26,0:02:14.22,Main,,0,0,0,,Aç kulağını dediklerime aklına kazı Luffy!Dialogue: 0,0:02:14.87,0:02:16.62,Main,,0,0,0,,Ölmeyeceğim!Dialogue: 0,0:02:21.38,0:02:24.86,Main,,0,0,0,,Sabo da bunu istemişti.Dialogue: 0,0:02:24.86,0:02:28.36,Main,,0,0,0,,Söz veriyorum. Ölmeyeceğim!Dialogue: 0,0:02:29.21,0:02:32.98,Main,,0,0,0,,Ölüp geride senin gibi güçsüz bir kardeş bırakacak halim yok!Dialogue: 0,0:02:35.57,0:02:42.04,Main,,0,0,0,,Ben o kadar zeki değilim o yüzden Sabo'yu ne öldürdü bilmiyorum.Dialogue: 0,0:02:42.36,0:02:46.46,Main,,0,0,0,,Ama her neyse özgürlüğün karşısında duran şeydi!Dialogue: 0,0:02:46.90,0:02:50.61,Main,,0,0,0,,Sabo özgürlüğünü kazanamadan öldü...Dialogue: 0,0:02:50.61,0:02:54.13,Main,,0,0,0,,Ama Sabo'yla kadeh tokuşturmuş olan bizler hala hayattayız!Dialogue: 0,0:02:57.96,0:03:00.87,Main,,0,0,0,,O yüzden, Luffy.Dialogue: 0,0:03:00.87,0:03:05.70,Main,,0,0,0,,Hayatlarımızı pişmanlıklar olmadan yaşamalıyız!Dialogue: 0,0:03:20.24,0:03:26.15,Main,,0,0,0,,Asiller 18 yaşlarına bastıklarında gerçek anlamda asil olurlar.Dialogue: 0,0:03:27.19,0:03:31.22,Main,,0,0,0,,Bu yüzden bu ülkeyi 17 yaşıma bastığımda terkedeceğim!Dialogue: 0,0:03:33.88,0:03:38.78,Main,,0,0,0,,Bir gün denize açılacağız,Dialogue: 0,0:03:39.13,0:03:41.38,Main,,0,0,0,,ve canımızın istediğini yapabileceğiz!Dialogue: 0,0:03:41.38,0:03:43.42,Main,,0,0,0,,Kimse bizden daha özgür olmayacak!Dialogue: 0,0:03:46.14,0:03:51.05,Main,,0,0,0,,Bu pek çok düşmanımız olacağı anlamına geliyor biliyorum...Dialogue: 0,0:03:51.05,0:03:55.08,Main,,0,0,0,,Dedemiz de düşmanımız olacak. Hayatımızı riske atıyor olacağız.Dialogue: 0,0:03:55.91,0:03:58.39,Main,,0,0,0,,17 yaşına girdiğimizde basıp gideceğiz!Dialogue: 0,0:03:58.39,0:04:02.35,Main,,0,0,0,,Korsan olacağız!Dialogue: 0,0:06:58.00,0:07:00.58,Narrator,,0,0,0,,Biraz geriye gidiyoruz...Dialogue: 0,0:07:00.58,0:07:04.50,Narrator,,0,0,0,, Kutsal Ejder'in gemisinin  Goa Krallığı'na demir attığı geceye.Dialogue: 0,0:07:04.95,0:07:11.69,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Mantisentil thx to onepace.netDialogue: 0,0:20:05.40,0:20:15.40,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Mantisentil thx to onepace.netDialogue: 0,0:41:07.00,0:41:10.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Mantisentil thx to onepace.netDialogue: 0,0:07:04.95,0:07:11.69,Title,,0,0,240,,Rüzgarların İradesiDialogue: 0,0:07:05.81,0:07:12.10,Narrator,,0,0,0,,Doğu Mavi'de ufak bir köy...Dialogue: 0,0:07:22.65,0:07:26.09,Main,,0,0,0,,O koca suratlı adamı gördün mü? Bugün buradaydı.Dialogue: 0,0:07:26.09,0:07:28.09,Main,,0,0,0,,Evet! Hiç öyle bir şey görmemiştim!Dialogue: 0,0:07:28.09,0:07:31.39,Main,,0,0,0,,Bakın! Gemisi de kocaman!Dialogue: 0,0:07:31.39,0:07:33.83,Main,,0,0,0,,Beş yüz seksen...Dialogue: 0,0:07:33.83,0:07:35.83,Main,,0,0,0,,Beş yüz seksen bir...Dialogue: 0,0:07:35.83,0:07:38.60,Main,,0,0,0,,Beş yüz seksen iki...Dialogue: 0,0:07:38.60,0:07:40.94,Main,,0,0,0,,Beş yüz seksen üç...Dialogue: 0,0:07:40.94,0:07:42.98,Main,,0,0,0,,Beş yüz seksen dört...Dialogue: 0,0:07:46.75,0:07:49.00,Main,,0,0,0,,Geciktin, Dragon!Dialogue: 0,0:07:49.00,0:07:52.05,Main,,0,0,0,,Bizi daha ne kadar bekletmeyi düşünüyorsun?!Dialogue: 0,0:07:53.92,0:07:54.55,Main,,0,0,0,,Özür dilerim.Dialogue: 0,0:07:55.79,0:07:57.39,Main,,0,0,0,,O... O ne?Dialogue: 0,0:07:58.00,0:07:59.25,Main,,0,0,0,,Bu felaket!Dialogue: 0,0:07:59.25,0:08:01.40,Main,,0,0,0,,Sen! Çabuk doktor bul! Bu acil bir durum!Dialogue: 0,0:08:01.40,0:08:02.94,Main,,0,0,0,,Derhal!Dialogue: 0,0:08:05.00,0:08:09.46,Main,,0,0,0,,Cidden... neredeydin?!Dialogue: 0,0:08:09.46,0:08:12.84,Main,,0,0,0,,Dünya Soyluları'nın seremonisi izliyordum.Dialogue: 0,0:08:14.66,0:08:18.21,Main,,0,0,0,,Bana haber vermeden oraya nasıl gidersin!Dialogue: 0,0:08:19.34,0:08:22.68,Main,,0,0,0,,Eğer sen de orada olsaydın çok dikkat çekerdik,Dialogue: 0,0:08:24.47,0:08:25.82,Main,,0,0,0,,Bu...Dialogue: 0,0:08:28.05,0:08:32.22,Main,,0,0,0,,En kısa zaman güçlenmeliyiz.Dialogue: 0,0:08:33.44,0:08:34.73,Main,,0,0,0,,Erzak durumumuz nedir?Dialogue: 0,0:08:35.39,0:08:37.90,Main,,0,0,0,,Köydeki bir dojo biraz yiyecek verdi.Dialogue: 0,0:08:41.55,0:08:43.26,Main,,0,0,0,,Yelken açıyoruz!Dialogue: 0,0:08:43.26,0:08:46.14,Main,,0,0,0,,Baltigo'ya geri dönüyoruz!Dialogue: 0,0:08:51.74,0:08:57.48,Narrator,,0,0,0,,Dünya Hükümeti'nin Goa Krallığı'nın izlemesinden bir kaç ay sonra...Dialogue: 0,0:09:01.87,0:09:04.19,Main,,0,0,0,,Daha fazla çöp getirdiler!Dialogue: 0,0:09:05.59,0:09:09.43,Narrator,,0,0,0,,Herkes eski rutinlerine geri dönmüştü...Dialogue: 0,0:09:10.37,0:09:14.40,Narrator,,0,0,0,,Dağ gibi çöp yığını geri dönmüştü.Dialogue: 0,0:09:18.76,0:09:22.17,Main,,0,0,0,,Geliyorum, Ace!Dialogue: 0,0:09:22.68,0:09:24.66,Main,,0,0,0,,Gomu Gomu no...Dialogue: 0,0:09:25.34,0:09:27.42,Main,,0,0,0,,Pistol!Dialogue: 0,0:09:25.34,0:09:27.42,Attack,,0,0,0,,TabancaDialogue: 0,0:09:41.24,0:09:43.66,Main,,0,0,0,,Bu neydi be? Sen buna dövüşmek mi diyorsun?Dialogue: 0,0:09:46.83,0:09:51.00,Main,,0,0,0,,İsabet ettiremiyorsan ne kadar güçlü vurduğunun bir anlamı yok.Dialogue: 0,0:09:51.00,0:09:54.20,Main,,0,0,0,,Demiştim sana, lastik dövüşmek için pek uygun değil.Dialogue: 0,0:09:54.20,0:09:55.84,Main,,0,0,0,,Kes sesini! Öyle deme!Dialogue: 0,0:09:56.16,0:09:59.02,Main,,0,0,0,,Ne?! Yanlış mı düşünüyorum?!Dialogue: 0,0:09:59.02,0:10:02.82,Main,,0,0,0,,Sen sadece kurşunlara dayanıklı bir kalkansın!Dialogue: 0,0:10:02.82,0:10:06.80,Main,,0,0,0,,"Gomu Gomu" meyvesi ile alay etme! Bir gün sana gününü göstereceğim!Dialogue: 0,0:10:06.80,0:10:09.52,Main,,0,0,0,,Bir tabancadan bile güçlü bir teknik buldum!Dialogue: 0,0:10:10.32,0:10:12.39,Main,,0,0,0,,Luffy aferin!Dialogue: 0,0:10:12.77,0:10:16.46,Main,,0,0,0,,Kolun dünden çok daha fazla esnedi!Dialogue: 0,0:10:16.76,0:10:19.84,Main,,0,0,0,,Sabo! Luffy'e karşı çok yumuşaksın!Dialogue: 0,0:10:19.84,0:10:23.13,Main,,0,0,0,,Gerçekten güçlendim! Düne göre!Dialogue: 0,0:10:23.13,0:10:25.31,Main,,0,0,0,,Hey, Sabo!Dialogue: 0,0:10:42.17,0:10:45.08,Main,,0,0,0,,Sabo ne kadar iyi bir abiydi...Dialogue: 0,0:10:45.08,0:10:47.99,Main,,0,0,0,,O ne demek?!  Onun yerine ben mi ölseydim yani?!Dialogue: 0,0:10:56.02,0:10:57.14,Main,,0,0,0,,Ah...Dialogue: 0,0:11:07.83,0:11:09.61,Main,,0,0,0,,Kendi ülkemi kurdum.Dialogue: 0,0:11:10.39,0:11:12.52,Main,,0,0,0,,Ülke mi?Dialogue: 0,0:11:14.00,0:11:15.72,Main,,0,0,0,,Bu ne?Dialogue: 0,0:11:17.68,0:11:18.86,Main,,0,0,0,,Ben de.Dialogue: 0,0:11:18.86,0:11:19.72,Main,,0,0,0,,Ace'in ÜlkesiDialogue: 0,0:11:19.72,0:11:20.56,Main,,0,0,0,,Luffy'nin ÜlkesiDialogue: 0,0:11:25.15,0:11:27.76,Main,,0,0,0,,Bu ne şimdi?Dialogue: 0,0:11:27.76,0:11:32.00,Main,,0,0,0,,Ben kendi başıma hayatta kalmasını öğreneceğim. Siz Dadan ülkesi olabilirsiniz.Dialogue: 0,0:11:32.97,0:11:34.61,Main,,0,0,0,,Arada banyonuzu kullanacağım.Dialogue: 0,0:11:59.70,0:12:02.94,Main,,0,0,0,,Ace! Yardım et! Ayı geliyor!Dialogue: 0,0:12:03.90,0:12:06.40,Main,,0,0,0,,Kendi başına hayatta kalacaktın değil mi?Dialogue: 0,0:12:09.01,0:12:10.30,Main,,0,0,0,,Lanet olsun...Dialogue: 0,0:12:20.36,0:12:21.59,Main,,0,0,0,,Luffy!Dialogue: 0,0:12:33.73,0:12:36.12,Main,,0,0,0,,Hey! Dadan'ın ülkesi, kimse var mı?!Dialogue: 0,0:12:36.12,0:12:39.42,Main,,0,0,0,,Luffy yaralandı! Lütfen ona yardım edin!Dialogue: 0,0:12:41.01,0:12:43.92,Main,,0,0,0,,Magra! Lütfen Luffy'e yardım edin!Dialogue: 0,0:12:43.92,0:12:46.51,Main,,0,0,0,,İçeri girin, çabuk!Dialogue: 0,0:12:59.34,0:13:02.72,Main,,0,0,0,,Cidden... Bu çok ciddi.Dialogue: 0,0:13:02.72,0:13:07.13,Main,,0,0,0,,Yaraları çok derin neredeyse ölecekmiş!Dialogue: 0,0:13:09.32,0:13:12.40,Main,,0,0,0,,Üçünüz bu vahşi yaratıklara karşı beraber savaşırdınız değil mi?Dialogue: 0,0:13:14.76,0:13:16.12,Main,,0,0,0,,Benim suçum...Dialogue: 0,0:13:17.40,0:13:23.62,Main,,0,0,0,,Kendi başına savaşabilmenin güç göstergesi olmadığını öğrendim sanıyordum...Dialogue: 0,0:13:24.60,0:13:27.09,Main,,0,0,0,,İşe yaramazın tekiyim!Dialogue: 0,0:13:27.09,0:13:29.26,Main,,0,0,0,,Hiçbir işe yaramazın tekiyim!Dialogue: 0,0:13:32.77,0:13:34.19,Main,,0,0,0,,Ace...Dialogue: 0,0:13:34.19,0:13:36.89,Main,,0,0,0,,Özür dilerim, Luffy!Dialogue: 0,0:13:37.82,0:13:38.66,Main,,0,0,0,,Çok özür dilerim!Dialogue: 0,0:13:48.61,0:13:50.48,Main,,0,0,0,,Hey, çocuklar!Dialogue: 0,0:13:50.98,0:13:54.65,Main,,0,0,0,,Makino-chan bize içki getirmek için ta buraya kadar gelmiş!Dialogue: 0,0:13:55.43,0:13:58.38,Main,,0,0,0,,Gerçekten insanlara nasıl doğru selam verilir onu mu soruyorsun?Dialogue: 0,0:13:58.77,0:14:00.10,Main,,0,0,0,,Evet.Dialogue: 0,0:14:00.10,0:14:02.12,Main,,0,0,0,,Bu değişikliğin sebebi nedir?Dialogue: 0,0:14:02.12,0:14:04.66,Main,,0,0,0,,Luffy'nin abisiyim en nihayetinde.Dialogue: 0,0:14:04.66,0:14:11.86,Main,,0,0,0,,Bir gün Kızıl Saç Korsanları'nın kaptanı ile tanışıp, kardeşim için yaptıkları adına ona teşekkür etmek istiyorum.Dialogue: 0,0:14:20.58,0:14:22.34,Main,,0,0,0,,Niye bana öyle bakıyorsun?!Dialogue: 0,0:14:23.72,0:14:28.14,Main,,0,0,0,,Özür dilerim. Tamam sana yardım edeceğim.Dialogue: 0,0:14:28.14,0:14:30.55,Main,,0,0,0,,Şimdi, öncelikle...Dialogue: 0,0:14:30.55,0:14:32.75,Main,,0,0,0,,Yemiş ve kaçmışlar!Dialogue: 0,0:14:32.75,0:14:34.98,Main,,0,0,0,,Durun!Dialogue: 0,0:14:36.98,0:14:41.10,Main,,0,0,0,,Oh, kabalık yapıyoruz!Dialogue: 0,0:14:41.10,0:14:41.93,Main,,0,0,0,,Evet...Dialogue: 0,0:14:46.06,0:14:48.47,Main,,0,0,0,,Yemek için teşekkürler!Dialogue: 0,0:14:48.47,0:14:51.14,Main,,0,0,0,,Kesin lanet olası veletler! Hesabı ödeyin!Dialogue: 0,0:14:54.44,0:14:56.59,Main,,0,0,0,,Bugün ben kazanacağım!Dialogue: 0,0:15:32.09,0:15:33.72,Main,,0,0,0,,Pekala!Dialogue: 0,0:15:33.72,0:15:35.99,Main,,0,0,0,,Bugün akşam yemeğinde ayı yahnisi var!Dialogue: 0,0:16:35.26,0:16:39.93,Captions,,0,0,25,,Yedi yıl sonraDialogue: 0,0:16:41.26,0:16:45.70,Captions,,0,0,20,,Ace, 17 yaşındaDialogue: 0,0:16:47.00,0:16:51.84,Captions,,0,0,20,,Luffy, 14 yaşındaDialogue: 0,0:17:04.19,0:17:06.20,Main,,0,0,0,,Kendine iyi bak, Ace!Dialogue: 0,0:17:06.20,0:17:10.14,Main,,0,0,0,,Tabii! Görüşürüz, Luffy!  Ben yoluma bakıyor olacağım!Dialogue: 0,0:17:10.14,0:17:15.55,Main,,0,0,0,,Evet! Üç yıl sonra denize açıldığımda çok daha güçlü olacağım!Dialogue: 0,0:17:21.99,0:17:25.13,Main,,0,0,0,,Elinden gelenin en iyisini yap, Ace!Dialogue: 0,0:17:25.13,0:17:26.88,Main,,0,0,0,,Kendine iyi bak!Dialogue: 0,0:17:26.88,0:17:28.79,Main,,0,0,0,,Hasta olmamaya çalış!Dialogue: 0,0:17:28.79,0:17:32.61,Main,,0,0,0,,Bekleyin ve görün!  Yakında ismimi her yerde duyacaksınız!Dialogue: 0,0:17:34.09,0:17:38.39,Narrator,,0,0,0,,Korsanlar Kralı'nın gizli çocuğu Ace...Dialogue: 0,0:17:38.39,0:17:43.01,Narrator,,0,0,0,,Colubo Dağı'nın yakınlarından sessiz sedasız denize açıldı.Dialogue: 0,0:17:59.30,0:18:01.21,Main,,0,0,0,,İşte gidiyor.Dialogue: 0,0:18:01.91,0:18:05.40,Main,,0,0,0,,Garp buna ne diyecek acaba?Dialogue: 0,0:18:23.78,0:18:26.46,Flashbacks,,0,0,0,,Ona sen bakacaksın Dadan.Dialogue: 0,0:18:26.46,0:18:28.84,Flashbacks,,0,0,0,,Dalga mı geçiyorsun benle! Kimin çocuğu bu?!Dialogue: 0,0:18:29.92,0:18:32.20,Main,,0,0,0,,Patron...Dialogue: 0,0:18:32.20,0:18:34.73,Main,,0,0,0,,Ace gitti.Dialogue: 0,0:18:35.71,0:18:41.46,Main,,0,0,0,,Öyle mi?  Bunun azarını Garp'tan yiyecek olan benim...Dialogue: 0,0:18:41.46,0:18:43.91,Main,,0,0,0,,O velet umutsuz vakaydı.Dialogue: 0,0:18:43.91,0:18:48.01,Main,,0,0,0,,Ah evet, Ace'den sana bir mesaj var.Dialogue: 0,0:18:48.01,0:18:53.10,Main,,0,0,0,,Ne?! Gittikten sonra bile bana mı söyleniyor?Dialogue: 0,0:18:53.10,0:18:55.75,Main,,0,0,0,,Dedi ki, "Yaramazlıklarım için özür dilerim ve  her şey için teşekkürler"Dialogue: 0,0:19:01.22,0:19:04.79,Main,,0,0,0,,Şapşal benle dalga geçiyor!Dialogue: 0,0:19:05.75,0:19:08.54,Main,,0,0,0,,Ne? Patron ağlıyor musun?Dialogue: 0,0:19:08.54,0:19:10.96,Main,,0,0,0,,Ağlamıyorum aptallar!Dialogue: 0,0:19:23.27,0:19:25.72,Main,,0,0,0,,Üç yıl daha!Dialogue: 0,0:19:26.30,0:19:27.86,Main,,0,0,0,,Gomu Gomu no...Dialogue: 0,0:19:28.14,0:19:29.44,Main,,0,0,0,,Pistol!Dialogue: 0,0:19:28.14,0:19:29.44,Attack,,0,0,0,,TabancaDialogue: 0,0:19:32.79,0:19:36.14,Main,,0,0,0,,Kahretsin... İyi nişan alamadım.Dialogue: 0,0:19:37.90,0:19:42.06,Main,,0,0,0,,Yakındı Luffy.  Neden biraz daha aşağıya nişan almıyorsun?Dialogue: 0,0:19:46.70,0:19:48.56,Main,,0,0,0,,Gomu Gomu no...Dialogue: 0,0:19:48.80,0:19:49.98,Main,,0,0,0,,Pistol!Dialogue: 0,0:19:48.80,0:19:49.98,Attack,,0,0,0,,TabancaDialogue: 0,0:20:03.65,0:20:05.12,Main,,0,0,0,,Daha güçlü olacağım!Dialogue: 0,0:20:05.75,0:20:09.02,Main,,0,0,0,,Çok daha güçlü!Dialogue: 0,0:20:09.27,0:20:11.52,Captions,,0,0,170,,Aylar sonra...Dialogue: 0,0:20:16.88,0:20:18.40,Main,,0,0,0,,Luffy!Dialogue: 0,0:20:18.40,0:20:20.33,Main,,0,0,0,,Gazetelere bak!Dialogue: 0,0:20:20.33,0:20:21.75,Main,,0,0,0,,Ne oldu?Dialogue: 0,0:20:21.75,0:20:23.74,Main,,0,0,0,,Baksana!Dialogue: 0,0:20:23.74,0:20:26.70,Main,,0,0,0,,İnanamıyorum! Ace ünlenmiş!Dialogue: 0,0:20:26.70,0:20:29.09,Main,,0,0,0,,Fotoğraflar korsan gemisini ve tayfasını gösteriyor!Dialogue: 0,0:20:29.09,0:20:33.02,Main,,0,0,0,,İnanılmaz! Ace harika!Dialogue: 0,0:20:34.45,0:20:36.77,Main,,0,0,0,,Ondan geri kalmayacağım!Dialogue: 0,0:20:40.74,0:20:44.72,Captions,,0,0,350,,Üç yıl sonra...Dialogue: 0,0:20:40.74,0:20:44.72,Captions,,0,0,50,,Luffy,17 yaşındaDialogue: 0,0:20:44.72,0:20:46.59,Main,,0,0,0,,Hey, hadi ama!Dialogue: 0,0:20:46.59,0:20:49.54,Main,,0,0,0,,Gidiyorum. Beni yolcu etmeyecek misiniz?Dialogue: 0,0:20:49.54,0:20:51.10,Main,,0,0,0,,Hey!Dialogue: 0,0:20:51.10,0:20:52.90,Main,,0,0,0,,Ah kes sesini...Dialogue: 0,0:20:53.12,0:21:00.24,Main,,0,0,0,,Makino ve muhtar bizi biliyor ama gelirsek diğer köylüleri korkuturuz.Dialogue: 0,0:21:00.24,0:21:01.44,Main,,0,0,0,,Ama...Dialogue: 0,0:21:01.96,0:21:03.97,Main,,0,0,0,,Hadi git artık!Dialogue: 0,0:21:04.42,0:21:07.52,Main,,0,0,0,,Ah.. Pekala!Dialogue: 0,0:21:07.52,0:21:09.78,Main,,0,0,0,,Her şey için teşekkürler!Dialogue: 0,0:21:09.78,0:21:12.90,Main,,0,0,0,,Ah, bizi utandırma... Teşekküre gerek yok.Dialogue: 0,0:21:12.90,0:21:15.46,Main,,0,0,0,,Kendine iyi bak.Dialogue: 0,0:21:15.46,0:21:17.46,Main,,0,0,0,,Tabii!Dialogue: 0,0:21:19.22,0:21:20.66,Main,,0,0,0,,Ah bir şey daha vardı!Dialogue: 0,0:21:21.25,0:21:24.27,Main,,0,0,0,,Dadan! Dağ eşkıyalarından nefret ediyorum...Dialogue: 0,0:21:24.27,0:21:25.90,Main,,0,0,0,,Kes sesini seni küçük velet!Dialogue: 0,0:21:27.05,0:21:29.80,Main,,0,0,0,,...ama sizi seviyorum!Dialogue: 0,0:21:33.14,0:21:36.91,Main,,0,0,0,,Böyle aptalca şeyler söyleme, bir an önce kaybol lanet olası!Dialogue: 0,0:21:36.91,0:21:41.31,Main,,0,0,0,,Sizler sadece...Dialogue: 0,0:21:42.13,0:21:43.84,Main,,0,0,0,,Ne, ağlıyor musun?Dialogue: 0,0:21:43.84,0:21:46.45,Main,,0,0,0,,Hayır ağlamıyorum!Dialogue: 0,0:21:47.95,0:21:52.45,Main,,0,0,0,,Yeldeğirmeni köyü, Goa Krallığı ve Şafak Adası'nın dış kesimleri...Dialogue: 0,0:21:52.89,0:21:57.20,Main,,0,0,0,,Hey, eğer denize açılıyorsan benim eski balıkçı teknesini almalısın, Luffy!Dialogue: 0,0:21:57.20,0:21:59.43,Main,,0,0,0,,Onunla gidersen denize açılmanla batman bir olur!Dialogue: 0,0:21:59.43,0:22:01.80,Main,,0,0,0,,Kayık mı? Hadi ama!Dialogue: 0,0:22:02.28,0:22:05.90,Main,,0,0,0,,Bu bana yeter. Yolculuğum başlıyor!Dialogue: 0,0:22:09.81,0:22:12.31,Main,,0,0,0,,Sabo!Dialogue: 0,0:22:12.71,0:22:18.05,Main,,0,0,0,,Baksana! Ben de denize açılıyorum!Dialogue: 0,0:22:20.11,0:22:23.22,Main,,0,0,0,,Sabo ilkti. Ace ikinci.Dialogue: 0,0:22:24.28,0:22:27.23,Main,,0,0,0,,Ben üçüncü olarak gidiyorum ama onlardan geri kalmayacağım!Dialogue: 0,0:22:27.23,0:22:31.46,Main,,0,0,0,,Bekle beni Ace, sana yetişeceğim!Dialogue: 0,0:22:31.46,0:22:34.48,Main,,0,0,0,,Ne yapıyorsun, Luffy?  Kendini kendine bağrınıp bir şeyler söylüyorsun...Dialogue: 0,0:22:34.48,0:22:36.64,Main,,0,0,0,,Totem mi yapıyorsun?Dialogue: 0,0:22:36.64,0:22:38.80,Main,,0,0,0,,Hayır. Bu bir iddia!Dialogue: 0,0:22:39.14,0:22:41.02,Main,,0,0,0,,Ace kim?Dialogue: 0,0:22:41.02,0:22:41.77,Main,,0,0,0,,Hiçbir fikrim yok.Dialogue: 0,0:22:41.77,0:22:44.21,Main,,0,0,0,,Pekala artık gidiyorum.Dialogue: 0,0:22:53.31,0:22:56.35,Main,,0,0,0,,İşte gidiyor muhtar...Dialogue: 0,0:22:56.35,0:22:58.26,Main,,0,0,0,,Onu özleyeceğim.Dialogue: 0,0:22:58.26,0:23:01.14,Main,,0,0,0,,Köyün yüz karası! Korsan oldu gitti...Dialogue: 0,0:23:04.13,0:23:09.10,Main,,0,0,0,,Ah... Denize açılmak için harika bir gün!Dialogue: 0,0:23:21.64,0:23:22.65,Main,,0,0,0,,Bu...Dialogue: 0,0:23:27.14,0:23:29.55,Main,,0,0,0,,İşte buradasın, suların efendisi.Dialogue: 0,0:23:34.96,0:23:37.31,Main,,0,0,0,,Yanlış kişiyi rakip seçtin.Dialogue: 0,0:23:37.73,0:23:40.67,Main,,0,0,0,,Saldırıma bir bak,  geçtiğimiz 10 yıldır pratik yapıyorum!Dialogue: 0,0:23:41.94,0:23:44.40,Main,,0,0,0,,Gomu Gomu no...Dialogue: 0,0:23:50.11,0:23:52.00,Main,,0,0,0,,Pistol!Dialogue: 0,0:23:50.11,0:23:52.00,Attack,,0,0,0,,TabancaDialogue: 0,0:24:08.89,0:24:10.96,Main,,0,0,0,,Dersini aldın mı seni lanet olası balık!Dialogue: 0,0:24:18.59,0:24:22.47,Main,,0,0,0,,İnanılmaz...  Suların efendisini bir yumrukta yendi!Dialogue: 0,0:24:23.94,0:24:26.48,Main,,0,0,0,,Güçlendi.Dialogue: 0,0:24:28.19,0:24:30.28,Main,,0,0,0,,Öncelikle bir tayfa toplamalıyım.Dialogue: 0,0:24:30.28,0:24:32.89,Main,,0,0,0,,On kişi yeter herhalde...Dialogue: 0,0:24:33.53,0:24:36.16,Main,,0,0,0,,sonrasında bir de korsan bayrağına ihtiyacım olacak!Dialogue: 0,0:24:36.96,0:24:41.96,Main,,0,0,0,,Pekala... İşte geliyorum!Dialogue: 0,0:24:41.96,0:24:43.83,Main,,0,0,0,,Bir gün...Dialogue: 0,0:24:45.66,0:24:48.16,Main,,0,0,0,,Korsanlar Kralı olacağım!Dialogue: 0,0:24:58.22,0:24:59.88,Narrator,,0,0,0,,ve günümüze dönüyoruz...Dialogue: 0,0:25:01.79,0:25:04.84,Narrator,,0,0,0,,Abisi Ace öldü ve Luffy...Dialogue: 0,0:25:05.62,0:25:07.26,Narrator,,0,0,0,,ağlıyordu.Dialogue: 0,0:25:20.81,0:25:22.67,Main,,0,0,0,,Luffy-kun...Dialogue: 0,0:25:22.67,0:25:25.90,Main,,0,0,0,,Korsanlar Kralı? Evet, doğru!Dialogue: 0,0:25:25.90,0:25:27.26,Main,,0,0,0,,Ben...Dialogue: 0,0:25:28.44,0:25:31.21,Main,,0,0,0,,çok zayıfım!Dialogue: 0,0:25:31.29,0:25:35.88,Captions,,0,0,30,,Doğu Mavi- Goa Krallığı - Yeldeğirmeni KöyüDialogue: 0,0:25:31.21,0:25:32.48,Main,,0,0,0,,Bu Garp-san!Dialogue: 0,0:25:32.48,0:25:34.82,Main,,0,0,0,,Garp-san bir savaş gemisinde geri geldi!Dialogue: 0,0:25:34.82,0:25:35.88,Main,,0,0,0,,Görev icabı mı burada?Dialogue: 0,0:25:36.22,0:25:39.04,Main,,0,0,0,,Garp-san! Savaş ile ilgili yazıları okudum!Dialogue: 0,0:25:39.04,0:25:41.03,Main,,0,0,0,,Donanma için mutlak bir galibiyet olmuş diye duydum?Dialogue: 0,0:25:41.03,0:25:43.28,Main,,0,0,0,,Evet hepinizi sağ salim gördüğüme memnunum.Dialogue: 0,0:25:43.28,0:25:44.82,Main,,0,0,0,,Luffy ne yapıyor?Dialogue: 0,0:25:44.82,0:25:48.30,Main,,0,0,0,,Beyazsakal öldüğüne göre neler olacak?Dialogue: 0,0:25:48.30,0:25:49.40,Main,,0,0,0,,Hey, Garp-san!Dialogue: 0,0:25:49.40,0:25:54.50,Main,,0,0,0,,Birkaç gündür, açık denizlerde çokça korsan gemisi görüyoruz.Dialogue: 0,0:25:54.50,0:25:58.77,Main,,0,0,0,,Bize her an saldırabilirler, geceleri gözümüze uyku girmiyor!Dialogue: 0,0:25:58.77,0:26:03.97,Main,,0,0,0,,Endişelenmeyin. Yolda üç geminin icabına baktım bile.Dialogue: 0,0:26:03.97,0:26:06.29,Main,,0,0,0,,Gerçekten mi? İçime su serpildi!Dialogue: 0,0:26:06.29,0:26:10.75,Main,,0,0,0,,Dövüşmek kelimesinin anlamını bile bilmeyen birkaç amatör korsanlardı.Dialogue: 0,0:26:10.75,0:26:13.45,Main,,0,0,0,,Ama yine de Beyazsakal caydırıcı bir unsurdu.Dialogue: 0,0:26:13.45,0:26:18.39,Main,,0,0,0,,Artık aramızda olmadığı için, denizler bir süre tekinsiz olacaktır.Dialogue: 0,0:26:18.39,0:26:23.02,Main,,0,0,0,,Doğu Mavi'nin ücra bir tarafında yaşıyorunuz diye gardınızı bırakmayın.Dialogue: 0,0:26:23.02,0:26:23.66,Main,,0,0,0,,Asker.Dialogue: 0,0:26:23.66,0:26:24.60,Main,,0,0,0,,Emredersiniz!Dialogue: 0,0:26:25.76,0:26:29.01,Main,,0,0,0,,"Güvenlik - Donanma Karargâhı Koramiral Garp", ha?Dialogue: 0,0:26:29.01,0:26:30.83,Main,,0,0,0,,Ne kadar güven verici!Dialogue: 0,0:26:30.83,0:26:33.74,Main,,0,0,0,,Artık korkacak bir şey yok!Dialogue: 0,0:26:33.74,0:26:36.74,Main,,0,0,0,,Garp-san, bir problemimiz daha var...Dialogue: 0,0:26:36.74,0:26:41.95,Main,,0,0,0,,Dağdan eşkıyalar inmiş ve Makino'nun barını ele geçirmişler.Dialogue: 0,0:26:41.95,0:26:43.15,Main,,0,0,0,,Eşkıyalar mı?Dialogue: 0,0:26:43.15,0:26:45.48,Main,,0,0,0,,Durun! Yapmayın!Dialogue: 0,0:26:49.90,0:26:51.20,Main,,0,0,0,,Hey, Garp!Dialogue: 0,0:26:51.20,0:26:52.59,Main,,0,0,0,,Ah bu o!Dialogue: 0,0:26:54.69,0:26:58.06,Main,,0,0,0,,Ne yüzle geliyorsun hala buraya!Dialogue: 0,0:26:59.29,0:27:01.14,Main,,0,0,0,,Garp-san!Dialogue: 0,0:27:01.14,0:27:02.39,Main,,0,0,0,,Patron!Dialogue: 0,0:27:02.39,0:27:03.60,Main,,0,0,0,,Koramiral Garp!Dialogue: 0,0:27:10.55,0:27:13.78,Main,,0,0,0,,Siz karışmayın! Bu kadını tanıyorum.Dialogue: 0,0:27:16.17,0:27:17.99,Main,,0,0,0,,Sen...Dialogue: 0,0:27:18.62,0:27:21.30,Main,,0,0,0,,Savaşın tam ortasındaydın...Dialogue: 0,0:27:22.23,0:27:24.14,Main,,0,0,0,,Tam önündelerdi...Dialogue: 0,0:27:24.14,0:27:26.32,Main,,0,0,0,,Sen ne halt yiyordun peki?!Dialogue: 0,0:27:26.32,0:27:28.30,Main,,0,0,0,,Ne yapıyordun ulan?!Dialogue: 0,0:27:28.30,0:27:30.84,Main,,0,0,0,,Neden?! Neden?! Neden?!Dialogue: 0,0:27:30.84,0:27:33.10,Main,,0,0,0,,Neden?! Neden, lanet olası?!Dialogue: 0,0:27:41.01,0:27:44.51,Main,,0,0,0,,Ace'in böyle ölmesine nasıl izin verirsin?!Dialogue: 0,0:27:45.15,0:27:48.48,Main,,0,0,0,,Görev ailenden daha mı önemli ha?!Dialogue: 0,0:27:48.48,0:27:51.94,Main,,0,0,0,,Ha Garp?!   Sen ne biçim bir Donanma kahramanısın?!Dialogue: 0,0:27:51.94,0:27:53.83,Main,,0,0,0,,Geber git, lanet olası bunak!Dialogue: 0,0:27:53.83,0:27:56.20,Main,,0,0,0,,Sakin ol patron! Lütfen dur!Dialogue: 0,0:27:56.20,0:27:57.09,Main,,0,0,0,,Patron...Dialogue: 0,0:27:57.09,0:28:00.52,Main,,0,0,0,,Garp, Bir şey söylesene!  Neden ona yardım etmedin?!Dialogue: 0,0:28:00.52,0:28:02.36,Main,,0,0,0,,Neden engel olmadın?!Dialogue: 0,0:28:02.59,0:28:05.03,Main,,0,0,0,,Ayağa kalk. Kalk lan!Dialogue: 0,0:28:05.03,0:28:08.53,Main,,0,0,0,,Seni insan müsvettesi!Dialogue: 0,0:28:09.27,0:28:11.10,Main,,0,0,0,,Dur artık, Dadan-san!Dialogue: 0,0:28:17.38,0:28:18.88,Main,,0,0,0,,Makino...Dialogue: 0,0:28:36.86,0:28:41.40,Main,,0,0,0,,Dibindelerdi ve onlara yardım edemedi...Dialogue: 0,0:28:41.40,0:28:43.63,Main,,0,0,0,,Asıl bu yüzden  Garp-san herkesten daha çok acı çekiyor!Dialogue: 0,0:28:54.16,0:28:55.71,Main,,0,0,0,,Y-yanılıyorsun...Dialogue: 0,0:28:58.02,0:28:59.35,Main,,0,0,0,,Y-yanılıyorsun...Dialogue: 0,0:29:00.82,0:29:02.79,Main,,0,0,0,,Yanılıyorsun!Dialogue: 0,0:29:03.56,0:29:07.52,Main,,0,0,0,,En çok acı çeken... Luffy!Dialogue: 0,0:29:17.24,0:29:21.88,Main,,0,0,0,,Şimdi burada önünde olduğunu hayal et.Dialogue: 0,0:29:21.88,0:29:25.19,Main,,0,0,0,,Ben Ace! Sen kimsin lan?Dialogue: 0,0:29:25.19,0:29:29.01,Main,,0,0,0,,Boo. Öyle denmez. "Lan" çok kaba.Dialogue: 0,0:29:29.77,0:29:32.04,Main,,0,0,0,,"Kimsin sen?!" denir değil mi?Dialogue: 0,0:29:33.01,0:29:34.59,Main,,0,0,0,,Sen kim olasın ki?Dialogue: 0,0:29:34.59,0:29:35.99,Main,,0,0,0,,Boo.Dialogue: 0,0:29:35.99,0:29:37.72,Main,,0,0,0,,Bu kimdir?Dialogue: 0,0:29:37.72,0:29:39.85,Main,,0,0,0,,Boo.Dialogue: 0,0:29:39.85,0:29:41.99,Main,,0,0,0,,"O kim?" mi?Dialogue: 0,0:29:41.99,0:29:43.03,Main,,0,0,0,,Boo!Dialogue: 0,0:29:44.37,0:29:47.33,Main,,0,0,0,,Hepsi yanlış. Biraz çaba göstersenize.Dialogue: 0,0:29:47.55,0:29:50.44,Main,,0,0,0,,Saçma saçma şeyler söylüyorsun sürekli!Dialogue: 0,0:29:50.44,0:29:51.72,Main,,0,0,0,,Dikkatimi dağıtma!Dialogue: 0,0:29:51.72,0:29:58.43,Main,,0,0,0,,Hey, Ace! Dün dev bi yılanın yuvasını buldum, kocaman yumurtalar ile doluydu!Dialogue: 0,0:29:58.43,0:30:00.08,Main,,0,0,0,,Hadi gidip toplayalım!Dialogue: 0,0:30:00.08,0:30:02.34,Main,,0,0,0,,Ha? Koca yumurtalar mı?Dialogue: 0,0:30:02.34,0:30:04.49,Main,,0,0,0,,Hayır olmaz!Dialogue: 0,0:30:04.49,0:30:07.28,Main,,0,0,0,,İnsanlar nasıl selamlanır öğrenmem lazım!Dialogue: 0,0:30:07.28,0:30:11.18,Flashbacks,,0,0,0,,Eğer o yılan beni tek yalarsa başım belaya girer!Dialogue: 0,0:30:11.18,0:30:14.54,Flashbacks,,0,0,0,,Eğer yanımda olursan güvende olurum.  Hadi benle gel!Dialogue: 0,0:30:14.54,0:30:15.76,Flashbacks,,0,0,0,,Kes sesini!Dialogue: 0,0:30:18.34,0:30:22.57,Main,,0,0,0,,Abisi onun için ne ifade ediyordu biliyorsun?!Dialogue: 0,0:30:32.00,0:30:32.51,Main,,0,0,0,,Makino!Dialogue: 0,0:30:35.80,0:30:37.08,Main,,0,0,0,,Garp...Dialogue: 0,0:30:37.64,0:30:42.62,Main,,0,0,0,,Luffy nasıl?  Gazeteler nerede olduğunu söylemiyor...Dialogue: 0,0:30:42.62,0:30:43.59,Main,,0,0,0,,Muhtar...Dialogue: 0,0:30:50.10,0:30:52.21,Main,,0,0,0,,Bir denizaltıyla kaçtı.Dialogue: 0,0:30:53.70,0:30:56.66,Main,,0,0,0,,Donanma onu tüm güçleriyle kovaladı...Dialogue: 0,0:30:56.66,0:30:59.49,Main,,0,0,0,,ve alanı detaylıca taradılar.Dialogue: 0,0:30:59.49,0:31:02.11,Main,,0,0,0,,Ama onu bulamadılar.Dialogue: 0,0:31:03.14,0:31:06.18,Main,,0,0,0,,En azından şimdilik hayatta!Dialogue: 0,0:31:07.46,0:31:08.51,Main,,0,0,0,,Tanrıya şükür!Dialogue: 0,0:31:08.51,0:31:14.90,Main,,0,0,0,,Donanma Karargahı'nden Koramiral Garp ve bu haydut birbirlerini nereden tanıyorlar?Dialogue: 0,0:31:14.90,0:31:15.70,Main,,0,0,0,,Kim bilir?Dialogue: 0,0:31:21.33,0:31:23.91,Main,,0,0,0,,Luffy aptalın teki!Dialogue: 0,0:31:23.91,0:31:28.27,Main,,0,0,0,,O nasıl bir korsan olursa olsun farketmez.  Ben onun tarafındayım.Dialogue: 0,0:31:30.70,0:31:33.50,Main,,0,0,0,,Nasıl hissettiğini düşününce...Dialogue: 0,0:31:33.50,0:31:35.67,Main,,0,0,0,,Kalbim paramparça oluyor.Dialogue: 0,0:31:44.01,0:31:47.28,Main,,0,0,0,,Luffy!Dialogue: 0,0:31:47.28,0:31:53.06,Main,,0,0,0,,Acıya yenik düşme!Dialogue: 0,0:31:57.60,0:32:00.35,Narrator,,0,0,0,,Şimdi uzaklara gidiyoruz...Dialogue: 0,0:32:00.35,0:32:04.70,Narrator,,0,0,0,,Grand Line'ın ikinci kısmına, Yeni Dünya'ya.Dialogue: 0,0:32:29.52,0:32:31.11,Main,,0,0,0,,Kızıl Saç...Dialogue: 0,0:32:33.12,0:32:35.77,Main,,0,0,0,,Sana bunun için nasıl teşekkür edebilirim?Dialogue: 0,0:32:37.07,0:32:39.82,Main,,0,0,0,,Saçmalama.Dialogue: 0,0:32:39.82,0:32:43.67,Main,,0,0,0,,Rakibimdi ama Beyazsakal saygıdeğer bir korsandı.Dialogue: 0,0:32:44.75,0:32:47.41,Main,,0,0,0,,Sengoku bile böyle düşünüyordu.Dialogue: 0,0:32:49.21,0:32:52.48,Main,,0,0,0,,Bizim gitme zamanımız geldi.Dialogue: 0,0:32:52.48,0:32:54.35,Main,,0,0,0,,Pekala... Teşekkürler.Dialogue: 0,0:32:55.30,0:32:59.32,Thoughts,,0,0,0,,Luffy... Bu senin için zor olmalı.Dialogue: 0,0:33:00.21,0:33:04.07,Thoughts,,0,0,0,,Ace'in ölmeden önce yaptıklarını duymak şaşırtıcıydı.Dialogue: 0,0:33:04.79,0:33:07.80,Flashbacks,,0,0,0,,Söylediklerini geri al!Dialogue: 0,0:33:07.80,0:33:11.10,Flashbacks,,0,0,0,,Hayatımı kurtaran adamla dalga geçme!Dialogue: 0,0:33:11.10,0:33:15.01,Flashbacks,,0,0,0,,Bu çağın adı "Beyazsakal"!Dialogue: 0,0:33:19.69,0:33:24.85,Thoughts,,0,0,0,,Aynı Kaptan Roger gibi davrandı.Dialogue: 0,0:33:27.22,0:33:32.56,Thoughts,,0,0,0,,Kaptanın kaçmasını istediğim anlar olmuştu...Dialogue: 0,0:33:33.31,0:33:35.38,Thoughts,,0,0,0,,Ağlamasını bile istemiştim.Dialogue: 0,0:33:40.47,0:33:42.77,Thoughts,,0,0,0,,Dinle beni, Luffy.Dialogue: 0,0:33:43.11,0:33:49.00,Thoughts,,0,0,0,,Galibiyeti ve mağlubiyeti,  dövüşmekten kaçmayı ve gözyaşı dökmeyi öğrenmek...Dialogue: 0,0:33:49.39,0:33:52.17,Thoughts,,0,0,0,,İnsanı büyüten bunlar oluyor.Dialogue: 0,0:34:03.10,0:34:05.59,Thoughts,,0,0,0,,Ağlaman kadar normal bir şey yok.Dialogue: 0,0:34:07.76,0:34:09.62,Thoughts,,0,0,0,,Bunun üstüsinden geleceksin!Dialogue: 0,0:34:16.38,0:34:20.42,Captions,,0,0,30,,"Calm Belt" - Kadınlar AdasıDialogue: 0,0:34:25.38,0:34:30.11,Main,,0,0,0,,Lanet olsun bu hayata! Çok zayıfım! Hiç kimseyi koruyamıyorum!Dialogue: 0,0:34:30.11,0:34:32.42,Main,,0,0,0,,Luffy-kun.Dialogue: 0,0:34:32.42,0:34:37.19,Main,,0,0,0,,Git buradan! Beni yalnız bırak!Dialogue: 0,0:34:37.19,0:34:42.89,Main,,0,0,0,,Bunu yapamam! Kendine daha fazla zarar vermene müsade edemem!Dialogue: 0,0:34:44.42,0:34:47.10,Main,,0,0,0,,Bu benim kendi bileceğim iş! Ne istersem yaparım!Dialogue: 0,0:34:47.54,0:34:53.87,Main,,0,0,0,,Eğer öyleyse Ace-san'ın da kendi kararıydı. Ne istediğinden bağımsız, ölmek onun seçimiydi!Dialogue: 0,0:34:53.87,0:34:56.14,Main,,0,0,0,,Sessiz ol!Dialogue: 0,0:34:56.14,0:34:58.68,Main,,0,0,0,,Tek kelime daha edersen ağzını yüzünü dağıtırım!Dialogue: 0,0:34:58.68,0:35:01.91,Main,,0,0,0,,Eğer bu daha iyi hissetmeni sağlayacaksa durma dene!Dialogue: 0,0:35:02.36,0:35:07.85,Main,,0,0,0,,Ben de oldukça zayıfım ama sana kaybedecek değilim. Şu haline hem de!Dialogue: 0,0:35:08.10,0:35:09.58,Main,,0,0,0,,Gomu gomu no...Dialogue: 0,0:35:09.98,0:35:11.96,Main,,0,0,0,,Pistol!Dialogue: 0,0:35:09.98,0:35:11.96,Attack,,0,0,0,,TabancaDialogue: 0,0:35:36.17,0:35:38.02,Flashbacks,,0,0,0,,Jinbe...Dialogue: 0,0:35:38.99,0:35:41.97,Flashbacks,,0,0,0,,Teach'i ararken...Dialogue: 0,0:35:43.36,0:35:48.61,Flashbacks,,0,0,0,,Arabasta Karallığı'nda üç yıldır görmediğim kardeşim ile karşılaştım..Dialogue: 0,0:35:49.33,0:35:53.33,Flashbacks,,0,0,0,,Onu görür görmez, içim rahatladı.Dialogue: 0,0:35:55.22,0:35:57.10,Flashbacks,,0,0,0,,Neden peki?Dialogue: 0,0:36:02.73,0:36:05.48,Main,,0,0,0,,Ah! Çok acıdı!Dialogue: 0,0:36:07.18,0:36:10.78,Main,,0,0,0,,Çok acıdı seni küçük velet!Dialogue: 0,0:36:15.85,0:36:19.52,Main,,0,0,0,,Gözün kör mü oldu senin?!Dialogue: 0,0:36:19.52,0:36:26.63,Main,,0,0,0,,Her engeli aşmanı sağlayacak kendine güvenin... Daha önce hiç kuşku duymadığın kuvvetin...Dialogue: 0,0:36:26.63,0:36:32.11,Main,,0,0,0,,Düşmanların elini kolunu bağladı ve inandığın her şeyi gaddarca yerle bir etti!Dialogue: 0,0:36:32.11,0:36:35.10,Main,,0,0,0,,Ve bir de ağabeyin, yol gösterici ışığın...Dialogue: 0,0:36:35.10,0:36:37.61,Main,,0,0,0,,Pek çok şey kaybettin.Dialogue: 0,0:36:37.61,0:36:43.36,Main,,0,0,0,,Dünyanın vizyonunu köreltmesine izin verme!Dialogue: 0,0:36:45.00,0:36:47.84,Main,,0,0,0,,Bu halinle hiçbir şey göremez haldesin!Dialogue: 0,0:36:47.84,0:36:50.79,Main,,0,0,0,,Pişmanlık ve kendini suçlama hissi kara bulutlar gibi üzerine çökmüş!Dialogue: 0,0:36:51.48,0:36:54.34,Main,,0,0,0,,Senin için zor olacak ama Luffy...Dialogue: 0,0:36:54.34,0:36:56.26,Main,,0,0,0,,Bu hisleri yenmelisin!Dialogue: 0,0:36:56.74,0:36:59.56,Main,,0,0,0,,Yalnızca kaybettiklerini düşünme!Dialogue: 0,0:37:00.12,0:37:06.15,Main,,0,0,0,,Giden gitti, ölen öldü! "Kalanlar neler?" kendine bunu sor!Dialogue: 0,0:37:54.12,0:37:57.56,Main,,0,0,0,,Luffy, buralarda oynama!Dialogue: 0,0:37:57.56,0:37:59.19,Main,,0,0,0,,Antrenmanımı bozuyorsun!Dialogue: 0,0:38:04.16,0:38:07.66,Main,,0,0,0,,Luffy, acele et de herkesi mevkisine gönder!Dialogue: 0,0:38:07.66,0:38:09.50,Main,,0,0,0,,Fırtına yaklaşıyor!Dialogue: 0,0:38:11.09,0:38:16.04,Main,,0,0,0,,Luffy, bana bak! Kocaman bir balık yakalamak üzereyim!Dialogue: 0,0:38:19.35,0:38:23.11,Main,,0,0,0,,Luffy, neredeyse bitirdim. Sabırlı ol da bekle!Dialogue: 0,0:38:24.28,0:38:28.28,Main,,0,0,0,,Luffy, ne kadar ağır yaralanırsan yaralan sorun değil.Dialogue: 0,0:38:28.28,0:38:30.92,Main,,0,0,0,,Ben seni iyileştiririm!Dialogue: 0,0:38:35.10,0:38:36.46,Main,,0,0,0,,Ah, Luffy.Dialogue: 0,0:38:37.02,0:38:40.76,Main,,0,0,0,,Arkeoloji ile ilgiliysen sana öğretmemi ister misin?Dialogue: 0,0:38:43.59,0:38:48.52,Main,,0,0,0,,Hey, Luffy!  Kola Motoru bugün şahane çalışıyor.Dialogue: 0,0:38:49.58,0:38:52.54,Main,,0,0,0,,Sunny'nin işlerini bana bırak!Dialogue: 0,0:38:53.30,0:38:57.77,Main,,0,0,0,,Luffy-san, günaydın! Sabah oldu!Dialogue: 0,0:38:57.77,0:39:00.58,Main,,0,0,0,,Öyleyse, şöyle sabaha uygun bir şeyler çalayım!Dialogue: 0,0:39:08.02,0:39:09.66,Main,,0,0,0,,Luffy!Dialogue: 0,0:39:09.66,0:39:11.36,Main,,0,0,0,,Luffy!Dialogue: 0,0:39:11.36,0:39:19.87,Main,,0,0,0,,Luffy!Dialogue: 0,0:39:19.87,0:39:21.81,Main,,0,0,0,,Luffy-san!Dialogue: 0,0:39:22.05,0:39:23.77,Main,,0,0,0,,Luffy!Dialogue: 0,0:39:35.81,0:39:37.79,Main,,0,0,0,,Tayfam...Dialogue: 0,0:39:37.98,0:39:40.38,Main,,0,0,0,,Hala tayfam var!Dialogue: 0,0:39:40.38,0:39:42.67,Main,,0,0,0,,Zoro! Nami! Usopp!Dialogue: 0,0:39:42.67,0:39:45.26,Main,,0,0,0,,Sanji! Chopper! Robin!Dialogue: 0,0:39:45.26,0:39:47.70,Main,,0,0,0,,Franky! Brook!Dialogue: 0,0:39:47.70,0:39:49.73,Main,,0,0,0,,Arkadaşlarım hala burada!Dialogue: 0,0:39:52.28,0:39:53.37,Main,,0,0,0,,Evet.Dialogue: 0,0:39:54.90,0:39:58.14,Main,,0,0,0,,Buluşacak bir yer belirledik...Dialogue: 0,0:39:58.78,0:40:01.78,Flashbacks,,0,0,0,,Üç gün sonra Sunny'nin önünde buluşalım!Dialogue: 0,0:40:01.78,0:40:03.38,Flashbacks,,0,0,0,,Pekala!Dialogue: 0,0:40:04.62,0:40:08.98,Main,,0,0,0,,Gitmeliyim... Çok geç kaldım ama...Dialogue: 0,0:40:08.98,0:40:12.51,Main,,0,0,0,,Eminim beni bekliyorlardır!Dialogue: 0,0:40:13.51,0:40:17.13,Flashbacks,,0,0,0,,Orada gördüğüm...Dialogue: 0,0:40:17.13,0:40:18.46,Flashbacks,,0,0,0,,Jinbe...Dialogue: 0,0:40:20.60,0:40:23.86,Flashbacks,,0,0,0,,Sakar bir kardeşim olduğu için,Dialogue: 0,0:40:24.85,0:40:26.94,Flashbacks,,0,0,0,,abisi olarak onun için endişeleniyorum.Dialogue: 0,0:40:27.47,0:40:30.91,Flashbacks,,0,0,0,,Eminim sizin de başınızı çok ağrıtmıştır.Dialogue: 0,0:40:31.15,0:40:33.31,Flashbacks,,0,0,0,,Benim için ona göz kulak olun.Dialogue: 0,0:40:34.38,0:40:40.58,Flashbacks,,0,0,0,,Görüyorum ki artık peşimde dolanan minik Luffy değil.Dialogue: 0,0:40:40.85,0:40:42.86,Flashbacks,,0,0,0,,Onun...Dialogue: 0,0:40:45.34,0:40:48.35,Flashbacks,,0,0,0,,güvenebileceği bir tayfası var.Dialogue: 0,0:40:49.86,0:40:53.06,Flashbacks,,0,0,0,,Ne olursa olsun iyi olacaktır.Dialogue: 0,0:40:53.61,0:40:56.10,Flashbacks,,0,0,0,,İçim rahatladı.Dialogue: 0,0:41:00.20,0:41:02.71,Main,,0,0,0,,Onları hemen görmek istiyorum...Dialogue: 0,0:41:02.89,0:41:06.98,Main,,0,0,0,,Onları tekrar görmek istiyorum!Dialogue: 0,0:04:28.59,0:04:31.46,Credits,,0,0,0,,Editing SewilDialogue: 0,0:04:31.46,0:04:34.19,Credits,,0,0,0,,Timing SewilDialogue: 0,0:04:34.19,0:04:36.73,Credits,,0,0,0,,Karaoke KaitouYahikoDialogue: 0,0:04:36.73,0:04:39.63,Credits,,0,0,0,,QC Galaxy 9000 PepperjackDialogue: 0,0:04:39.63,0:04:41.73,Credits,,0,0,0,,Translation YibisDialogue: 0,0:04:41.73,0:04:43.47,Credits,,0,0,0,,Raws df68Dialogue: 0,0:04:43.56,0:04:47.14,OP14 Translation,,0,0,0,,♪ Keşfedilmemiş yarınlarda buluşmaya,Dialogue: 0,0:04:47.14,0:04:51.57,OP14 Translation,,0,0,0,,yola çıkalım şafak sökmeden. ♪Dialogue: 0,0:04:51.85,0:04:55.21,OP14 Translation,,0,0,0,,♪ Kararımı verdim ve pişman değilim. ♪Dialogue: 0,0:04:55.43,0:04:58.23,OP14 Translation,,0,0,0,,♪ Ne yapmam gerektiğini çok iyi biliyorum. ♪Dialogue: 0,0:04:58.39,0:05:01.95,OP14 Translation,,0,0,0,,♪ Yolumuzda bizi her ne sınav bekliyor olursa olsun,Dialogue: 0,0:05:02.09,0:05:06.58,OP14 Translation,,0,0,0,,kalplerimizin atışını hiçbir şey durduramaz. ♪Dialogue: 0,0:05:06.69,0:05:11.23,OP14 Translation,,0,0,0,,♪ Hepimizin hedefinde tek bir yer var. ♪Dialogue: 0,0:05:11.45,0:05:13.18,OP14 Translation,,0,0,0,,♪ Işığa doğru atıl! ♪Dialogue: 0,0:05:13.20,0:05:16.97,OP14 Translation,,0,0,0,,♪ Savaşlarımız esnasında kurduğumuz bağlara,Dialogue: 0,0:05:17.04,0:05:20.55,OP14 Translation,,0,0,0,,hiç kimsenin zarar vermesine izin vermeyeceğim. ♪Dialogue: 0,0:05:20.68,0:05:23.35,OP14 Translation,,0,0,0,,♪ Yumruklarımızı sıkmayı bırakırsak,Dialogue: 0,0:05:23.48,0:05:26.59,OP14 Translation,,0,0,0,,içlerindeki asıl gücü bulacağız. ♪Dialogue: 0,0:05:26.75,0:05:29.01,OP14 Translation,,0,0,0,,♪ O halde hadi başlayalım! ♪Dialogue: 0,0:05:29.15,0:05:34.16,OP14 Translation,,0,0,0,,♪ Yepyeni bir dünya bizi çağırıyor. ♪Dialogue: 0,0:05:34.26,0:05:36.55,OP14 Translation,,0,0,0,,♪ İleriye bak! ♪Dialogue: 0,0:05:36.66,0:05:42.90,OP14 Translation,,0,0,0,,♪ Birbirimize destek olmayı asla bırakmayacağız,Dialogue: 0,0:05:42.96,0:05:46.67,OP14 Translation,,0,0,0,,aramızda sayısız deniz olsa bile. ♪Dialogue: 0,0:05:46.70,0:05:50.34,OP14 Translation,,0,0,0,,♪ Hadi korkularımızı bir kenara bırakıp, harekete geçelim. ♪Dialogue: 0,0:05:50.84,0:05:52.73,OP14 Translation,,0,0,0,,♪ Lütfen unutma,Dialogue: 0,0:05:52.85,0:05:54.02,OP14 Translation,,0,0,0,,beraber savaşıyoruz. ♪Dialogue: 0,0:05:54.74,0:06:02.00,OP14 Translation,,0,0,0,,♪ O gün baktığımız,Dialogue: 0,0:06:02.42,0:06:04.78,OP14 Translation,,0,0,0,,ufuktaki geniş, görkemli gökyüzü,Dialogue: 0,0:06:04.89,0:06:09.90,OP14 Translation,,0,0,0,,hala tertemiz. ♪Dialogue: 0,0:06:09.92,0:06:13.33,OP14 Translation,,0,0,0,,♪ Kalbimizin derinliklerinde ettiğimiz yeminler ileDialogue: 0,0:06:13.53,0:06:17.29,OP14 Translation,,0,0,0,,çok uzun bir yol geldik. ♪Dialogue: 0,0:06:17.33,0:06:19.87,OP14 Translation,,0,0,0,,♪ Korkacak hiçbir şey yok. ♪Dialogue: 0,0:06:19.93,0:06:24.30,OP14 Translation,,0,0,0,,♪ Hepimizin taşıması gereken yükler var. ♪Dialogue: 0,0:06:24.44,0:06:26.76,OP14 Translation,,0,0,0,,♪ Güneş doğuyorDialogue: 0,0:06:26.91,0:06:31.72,OP14 Translation,,0,0,0,,ve her şeyi aydınlatıyor, hüznümü bile... ♪Dialogue: 0,0:06:31.75,0:06:34.12,OP14 Translation,,0,0,0,,♪ İnanıyorum,Dialogue: 0,0:06:34.22,0:06:40.46,OP14 Translation,,0,0,0,,hepimizin bir olduğu bir geleceğe. ♪Dialogue: 0,0:06:40.59,0:06:44.18,OP14 Translation,,0,0,0,,♪ Hadi gidip onu beraber bulalım. ♪Dialogue: 0,0:06:44.26,0:06:47.99,OP14 Translation,,0,0,0,,♪ Senin yerini kimse dolduramaz. ♪Dialogue: 0,0:06:48.46,0:06:50.12,OP14 Translation,,0,0,0,,♪ Lütfen unutma! ♪Dialogue: 0,0:06:50.44,0:06:52.54,OP14 Translation,,0,0,0,,♪ Beraber savaşıyoruz. ♪