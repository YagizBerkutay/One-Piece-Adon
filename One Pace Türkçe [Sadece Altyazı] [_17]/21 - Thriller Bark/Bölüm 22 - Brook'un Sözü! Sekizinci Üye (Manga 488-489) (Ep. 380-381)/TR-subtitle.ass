Dialogue: 0,0:10:20.74,0:10:25.14,Binks' Sake lyrics,,0,0,0,,{\fad(600,600)\i1}♪ Bink'in sakesini teslim edecek! ♪{\i0}
Dialogue: 0,0:10:25.14,0:10:29.47,Binks' Sake lyrics,,0,0,0,,{\fad(600,600)\i1}♪ Dalgaların şarkısını hepimiz Don'la söyleyelim! ♪{\i0}
Dialogue: 0,0:10:29.47,0:10:33.70,Binks' Sake lyrics,,0,0,0,,{\fad(600,600)\i1}♪ Kim olduğun önemli değil, bir gün sadece kemik olacaksın. ♪{\i0}
Dialogue: 0,0:10:33.70,0:10:37.85,Binks' Sake lyrics,,0,0,0,,{\fad(600,600)\i1}♪ Hiç bitmeyen, hep süren eğlenceli yolculuk hikayemiz! ♪{\i0}
Dialogue: 0,0:11:05.64,0:11:09.75,Main,,0,0,0,,Ne oldu. Sadece dörtlüyüz.
Dialogue: 0,0:11:12.22,0:11:13.55,Main,,0,0,0,,Üçlü.
Dialogue: 0,0:11:17.90,0:11:18.72,Main,,0,0,0,,Düet.
Dialogue: 0,0:11:24.46,0:11:26.25,Main,,0,0,0,,Solo.
Dialogue: 0,0:11:28.37,0:11:32.27,Main,,0,0,0,,Niye eşlik etmeyi bırakıyorsunuz?
Dialogue: 0,0:11:33.56,0:11:37.48,Flashbacks,,0,0,0,,Tayfama katılmak istiyorsanız,\Ntüm istediğim müziği sevmeniz!
Dialogue: 0,0:11:38.08,0:11:41.64,Flashbacks,,0,0,0,,Bu, ağlayan çocukları güldüren\NRumbar Korsanları'nın gemisi!
Dialogue: 0,0:11:44.55,0:11:48.17,Flashbacks,,0,0,0,,Laboon! Kesinlikle senin için döneceğiz!
Dialogue: 0,0:11:49.56,0:11:51.03,Flashbacks,,0,0,0,,Bekle bizi!
Dialogue: 0,0:12:17.40,0:12:25.51,Thoughts,,0,0,0,,{\i1}Laboon. Bizi 50 yıl bekledin.{\i0}
Dialogue: 0,0:12:26.33,0:12:30.57,Thoughts,,0,0,0,,{\i1}Birkaç yıl daha bekleyebilir misin?{\i0}
Dialogue: 0,0:12:35.12,0:12:38.54,Thoughts,,0,0,0,,{\i1}Gerçekten bir korsanın kalbine sahip olmam için!{\i0}
Dialogue: 0,0:12:38.54,0:12:45.06,Thoughts,,0,0,0,,{\i1}O duvarın arkasındasın ve söz verdiğimiz gibi yolculuğum sırasında yine karşılaşacağız.{\i0}
Dialogue: 0,0:12:47.37,0:12:50.37,Main,,0,0,0,,Hey, iskelet!
Dialogue: 0,0:12:50.37,0:12:52.18,Main,,0,0,0,,Artık şarkı söylemiyor musun?!
Dialogue: 0,0:12:52.18,0:12:55.29,Main,,0,0,0,,Yine yapalım! Yine!
Dialogue: 0,0:12:59.36,0:13:05.19,Main,,0,0,0,,Geçmişte bu şarkıyı arkadaşlarımla birlikte,\Nhayat dolu olarak birçok kez söyledim.
Dialogue: 0,0:13:05.19,0:13:08.88,Main,,0,0,0,,Rumbar Korsanları'nın son, büyük şarkısı.
Dialogue: 0,0:13:08.88,0:13:13.65,Main,,0,0,0,,Bu karanlıkta, sisle kaplı karanlık\Ndenizde geçirdiğim 50 yıl boyunca,...
Dialogue: 0,0:13:13.98,0:13:16.31,Main,,0,0,0,,...bunu kaç kez dinledim?
Dialogue: 0,0:13:23.61,0:13:28.46,Main,,0,0,0,,Koca bir gemide yalnız başımayken,...
Dialogue: 0,0:13:28.46,0:13:33.62,Main,,0,0,0,,...nasılsa hayatta olduğumu hissettiren tek şey bu şarkıydı.
Dialogue: 0,0:13:35.15,0:13:45.10,Main,,0,0,0,,Ancak bugünden itibaren, bu Ton Kadranı'nı mühürlemek için yürekten bir karar verdim.
Dialogue: 0,0:13:45.10,0:13:47.04,Main,,0,0,0,,{\fad(250,250)}Mühürle!
Dialogue: 0,0:13:47.30,0:13:51.32,Main,,0,0,0,,NEEEEE?! BUNU GERÇEKTEN YAPABİLİYOR MUSUN?!
Dialogue: 0,0:13:54.92,0:13:58.62,Main,,0,0,0,,Laboon'un iyi olduğunu ve hala beni\Nbeklediğini duyduğuma minnettarım.
Dialogue: 0,0:13:58.62,0:14:02.47,Main,,0,0,0,,Gölgemi geri aldım ve Şeytan Denizi'nden kaçtım.
Dialogue: 0,0:14:03.84,0:14:11.70,Main,,0,0,0,,Artık geçmişin hatırasından başka bir şey olmayan\Ntayfamın seslerini, bu kadranda tutmayacağım.
Dialogue: 0,0:14:11.70,0:14:14.85,Main,,0,0,0,,Bu şarkı Laboon için!
Dialogue: 0,0:14:15.67,0:14:17.34,Main,,0,0,0,,O günler gerçekten korkunçtu.
Dialogue: 0,0:14:18.77,0:14:23.09,Main,,0,0,0,,Gerçekten tüm umudumu yitirmiştim.
Dialogue: 0,0:14:23.89,0:14:26.28,Main,,0,0,0,,Ama Luffy-sama,...
Dialogue: 0,0:14:27.98,0:14:32.18,Main,,0,0,0,,B-Ben hayatta olduğuma çok memnunum!
Dialogue: 0,0:14:34.12,0:14:38.82,Main,,0,0,0,,Gerçekten hayatta olduğuma çok memnunum!
Dialogue: 0,0:14:39.61,0:14:41.36,Main,,0,0,0,,Elbette öylesin!
Dialogue: 0,0:14:42.47,0:14:45.43,Main,,0,0,0,,Çünkü bu gün nihayet geldi!
Dialogue: 0,0:14:50.84,0:14:51.52,Main,,0,0,0,,Ah.
Dialogue: 0,0:14:51.86,0:14:54.40,Main,,0,0,0,,Tayfana katılabilir miyim?
Dialogue: 0,0:14:54.40,0:14:55.69,Main,,0,0,0,,Tabii, olur.
Dialogue: 0,0:14:55.69,0:14:58.14,Main,,0,0,0,,ÖYLESİNE Mİ...
Dialogue: 0,0:14:58.14,0:14:59.98,Main,,0,0,0,,...KATILDI?!
Dialogue: 0,0:15:03.23,0:15:07.56,Main,,0,0,0,,Ama hoşgeldin! Müzisyenimizi sağlığına! Yaşasın!
Dialogue: 0,0:15:07.56,0:15:11.24,Main,,0,0,0,,Müzisyen! Ölü kemik müzisyenimiz!
Dialogue: 0,0:15:11.24,0:15:13.66,Main,,0,0,0,,Uzun zamandır beklediğimiz müzisyenimiz!
Dialogue: 0,0:15:14.46,0:15:17.19,Main,,0,0,0,,Tüyden bile hafif bir müzisyen!
Dialogue: 0,0:15:17.78,0:15:20.92,Main,,0,0,0,,Hafif olması iyi bir şey!
Dialogue: 0,0:15:20.92,0:15:22.03,Main,,0,0,0,,İyi bir şey!
Dialogue: 0,0:15:22.03,0:15:24.60,Main,,0,0,0,,Evet! Çünkü sadece kemiğim~!
Dialogue: 0,0:15:24.60,0:15:27.18,Main,,0,0,0,,Çok komik biri!
Dialogue: 0,0:15:24.60,0:15:28.64,Secondary,,0,0,0,,Sadece kemiğim! Sadece kemiğim!\NSadece kemiğim! Sadece kemiğim!
Dialogue: 0,0:15:27.18,0:15:28.64,Main,,0,0,0,,Anlıyorum.
Dialogue: 0,0:15:29.19,0:15:31.35,Main,,0,0,0,,Yine epey gürültülü oldu.
Dialogue: 0,0:15:32.43,0:15:36.00,Main,,0,0,0,,Niye tayfamız bu tür insanları topluyor?
Dialogue: 0,0:15:36.00,0:15:39.44,Main,,0,0,0,,Hiç anlamıyorum ama hepiniz iyi durumdasınız, Namizou.
Dialogue: 0,0:15:39.44,0:15:41.09,Main,,0,0,0,,Sanırım. Sağol.
Dialogue: 0,0:15:41.09,0:15:44.22,Main,,0,0,0,,Anlamıyoruz ama şerefe!
Dialogue: 0,0:15:44.22,0:15:47.16,Main,,0,0,0,,Hiçbir fikrimiz yok ama şerefe!
Dialogue: 0,0:15:49.16,0:15:50.36,Main,,0,0,0,,45 derece!
Dialogue: 0,0:15:57.38,0:15:58.96,Thoughts,,0,0,0,,{\i1}Laboon.{\i0}
Dialogue: 0,0:16:04.72,0:16:08.76,Thoughts,,0,0,0,,{\i1}Geri dönmeyeceğim.{\i0}
Dialogue: 0,0:16:08.76,0:16:17.38,Thoughts,,0,0,0,,{\i1}Sana geri dönmek için gidebileceğimiz tek yol bu yoldu.{\i0}
Dialogue: 0,0:16:17.38,0:16:21.33,Thoughts,,0,0,0,,{\i1}Dünyayı dolaşırken hedefimizdeki sendin!{\i0}
Dialogue: 0,0:16:21.76,0:16:27.70,Thoughts,,0,0,0,,{\i1}Doğru değil mi? Bu yüzden geri dönmeyeceğim. Seninle bir kez daha karşılaşacağım.{\i0}
Dialogue: 0,0:16:28.35,0:16:29.68,Thoughts,,0,0,0,,{\i1}Bu yüzden bekle.{\i0}
Dialogue: 0,0:16:32.77,0:16:35.16,Thoughts,,0,0,0,,{\i1}Sadece biraz daha.{\i0}
Dialogue: 0,0:16:41.93,0:16:44.77,Main,,0,0,0,,Ne oldu, Laboon?
Dialogue: 0,0:16:56.77,0:17:00.06,Main,,0,0,0,,Bugün keyfin gerçekten yerinde.
Dialogue: 0,0:17:06.93,0:17:08.37,Main,,0,0,0,,Kendimi tanıtayım!
Dialogue: 0,0:17:09.26,0:17:12.34,Main,,0,0,0,,Aranıyor posteri? Ödülün mü var?
Dialogue: 0,0:17:12.80,0:17:18.85,Main,,0,0,0,,Kendimi doğru düzgün ilk kez tanıttığım için kusura bakmayın! Ben, "Ölü Kemik Brook"!
Dialogue: 0,0:17:18.85,0:17:24.12,Main,,0,0,0,,Oldukça ünlüyümdür. "Şarkı Mırıldanan Brook" olarak bilinirim!
Dialogue: 0,0:17:24.12,0:17:26.81,Main,,0,0,0,,Ödülüm 33 milyon beli!
Dialogue: 0,0:17:26.81,0:17:31.39,Main,,0,0,0,,Uzun zaman önce, yaşadığım krallığın savaş konvoyunun lideriydim.
Dialogue: 0,0:17:31.39,0:17:39.27,Main,,0,0,0,,Sonra Rumbar Korsanları'nın vekil kaptanı oldum! \NTanınmış bir müzisyen ve kılıç ustası!
Dialogue: 0,0:17:39.27,0:17:45.68,Main,,0,0,0,,Bu vesileyle hizmetlerimi ve hayatımı Kaptan\NHasır Şapkalı Luffy'nin emrine adıyorum!
Dialogue: 0,0:17:45.68,0:17:48.91,Main,,0,0,0,,Hepinize yük olmamayı umut ediyorum!
Dialogue: 0,0:17:48.91,0:17:52.28,Main,,0,0,0,,Kemiklerime varıncaya kadar\Nher şeyimi ortaya koyacağım!
Dialogue: 0,0:17:56.84,0:18:01.42,Main,,0,0,0,,Tamam! Bir kez daha şerefe!
Dialogue: 0,0:18:04.76,0:18:07.23,Captions,,0,0,220,,{\fad(500,0)}2 Gün Sonra
Dialogue: 0,0:18:13.00,0:18:17.96,Main,,0,0,0,,Ne mükemmel! Sağol Franky-san! Usopp-san!
Dialogue: 0,0:18:18.32,0:18:21.86,Main,,0,0,0,,Önemli değil! Benim için hiç de zor değil!
Dialogue: 0,0:18:21.86,0:18:24.00,Main,,0,0,0,,Dizaynım başarılıydı!
Dialogue: 0,0:18:24.00,0:18:25.78,Main,,0,0,0,,Çiçekleri ben topladım!
Dialogue: 0,0:18:27.26,0:18:30.07,Main,,0,0,0,,Nefes kesici bir mezar.
Dialogue: 0,0:18:30.07,0:18:34.82,Main,,0,0,0,,O kadar büyük miktarda kalıntının\NAslan-chan'a taşınması mümkün değildi.
Dialogue: 0,0:18:34.82,0:18:38.03,Main,,0,0,0,,Bir dahakine Thousand Sunny de!
Dialogue: 0,0:18:38.73,0:18:45.07,Main,,0,0,0,,Tesadüfen bu Thriller Bark gemisi de,\Nyerel denizimiz Batı Mavi'den geliyor.
Dialogue: 0,0:18:46.28,0:18:51.52,Main,,0,0,0,,Belki doğdukları yerin toprağında\Nhuzur içinde dinlenebilirler.
Dialogue: 0,0:18:51.52,0:18:55.66,Main,,0,0,0,,Biz dönüyoruz, Brook.
Dialogue: 0,0:18:53.68,0:18:54.58,Secondary,,0,0,0,,Dikkatli olun.
Dialogue: 0,0:18:54.58,0:18:55.66,Secondary,,0,0,0,,Görüşürüz.
Dialogue: 0,0:18:55.66,0:18:57.44,Main,,0,0,0,,Tamam.
Dialogue: 0,0:19:19.47,0:19:24.06,Main,,0,0,0,,Ah, beni şaşırttın! Şimdi daha iyi misin?
Dialogue: 0,0:19:24.06,0:19:25.94,Main,,0,0,0,,Evet. Sadece fazla uyumuşum.
Dialogue: 0,0:19:26.89,0:19:28.00,Main,,0,0,0,,O...
Dialogue: 0,0:19:28.00,0:19:32.85,Main,,0,0,0,,Ölü bir kılıç. Yubashiri.\NLütfen onu da anmama izin ver.
Dialogue: 0,0:19:37.49,0:19:39.77,Flashbacks,,0,0,0,,Luffy, Korsanlar Kralı olacak adam!
Dialogue: 0,0:19:41.52,0:19:42.78,Main,,0,0,0,,Şey...
Dialogue: 0,0:19:45.56,0:19:47.50,Main,,0,0,0,,Ah, yok bir şey.
Dialogue: 0,0:19:49.24,0:19:52.14,Main,,0,0,0,,Sahi. Resmen bu tayfaya katıldım.
Dialogue: 0,0:19:53.18,0:19:56.71,Main,,0,0,0,,He, anlıyorum. Kötü şansını duyduğuma üzüldüm.
Dialogue: 0,0:19:58.50,0:20:00.31,Main,,0,0,0,,Bu manyak bir tayfadır.
Dialogue: 0,0:20:01.43,0:20:04.56,Main,,0,0,0,,Öyle görünüyor ve bu yüzden ölüm işimi\Nbitirene dek elimden geleni yapacağım!
Dialogue: 0,0:20:04.56,0:20:06.55,Main,,0,0,0,,Ah, ben zaten ölüyüm.
Dialogue: 0,0:20:11.77,0:20:14.78,Main,,0,0,0,,TAMAM! Zoro da uyandığına göre denize açılalım!
Dialogue: 0,0:20:15.00,0:20:17.70,Main,,0,0,0,,Bir sonraki maceramıza!
Dialogue: 0,0:20:17.70,0:20:19.01,Main,,0,0,0,,TAMAM!!!
Dialogue: 0,0:20:21.40,0:20:23.52,Main,,0,0,0,,Zoro, yine bandajlarını çıkardın, değil mi?!
Dialogue: 0,0:20:23.52,0:20:26.18,Main,,0,0,0,,Evet, onlar olunca hareket etmesi zor.
Dialogue: 0,0:20:26.18,0:20:28.58,Main,,0,0,0,,Zaten hareket etmediğinden emin olmak için oradalar!
Dialogue: 0,0:20:28.58,0:20:29.31,Main,,0,0,0,,Kıpırdama!
Dialogue: 0,0:20:29.31,0:20:32.44,Main,,0,0,0,,Gerçekten çok gayretlisiniz. Hemen yola mı çıkıyorsunuz?
Dialogue: 0,0:20:32.44,0:20:35.31,Main,,0,0,0,,Brook'un gemisini kullanabilirsiniz.
Dialogue: 0,0:20:35.78,0:20:37.52,Main,,0,0,0,,Dümeni ve yelkenleri tamir ettim.
Dialogue: 0,0:20:37.52,0:20:38.74,Main,,0,0,0,,Sağol.
Dialogue: 0,0:20:38.74,0:20:40.88,Main,,0,0,0,,Gerçekten sonuna dek bize yardım ediyorsunuz.
Dialogue: 0,0:20:41.42,0:20:45.42,Main,,0,0,0,,Ne kadar teşekkür edersem edeyim, yeterli olmayacak!
Dialogue: 0,0:20:45.42,0:20:47.30,Main,,0,0,0,,Benimle evlenir misin?
Dialogue: 0,0:20:47.30,0:20:49.40,Main,,0,0,0,,Eşi bulunmaz birisin ama çok yazık.
Dialogue: 0,0:20:49.40,0:20:51.96,Main,,0,0,0,,Çok süper olduğum için işe yaramaz.
Dialogue: 0,0:20:51.96,0:20:56.20,Main,,0,0,0,,Kalıp birkaç gün daha parti vermek ister misiniz?
Dialogue: 0,0:20:56.20,0:20:58.68,Main,,0,0,0,,Olmaz! Balıkadam Adası'na gidiyoruz!
Dialogue: 0,0:20:58.68,0:21:00.62,Main,,0,0,0,,Sabırsızlanıyorum!
Dialogue: 0,0:21:00.62,0:21:03.39,Main,,0,0,0,,Orada ilginç kimseler olacak!
Dialogue: 0,0:21:03.39,0:21:08.74,Main,,0,0,0,,Güzel denizkızları da! \NOnlarla oynamak için sabırsızlanıyorum!
Dialogue: 0,0:21:09.28,0:21:13.77,Main,,0,0,0,,Acaba denizkızları, külotlarını görmeme\Nizin verecek kadar iyi olurlar mıydı?
Dialogue: 0,0:21:13.77,0:21:16.30,Main,,0,0,0,,Hey, hey! Aptalca şeyler söyleme!
Dialogue: 0,0:21:17.41,0:21:20.57,Main,,0,0,0,,Denizkızları külot giymez.
Dialogue: 0,0:21:22.34,0:21:24.38,Main,,0,0,0,,Bir denizkızının güzelliğinden bahsediyorsan,...
Dialogue: 0,0:21:24.38,0:21:28.80,Main,,0,0,0,,...Korsan İmparatoriçesi Hancock'a bile rakiptir!
Dialogue: 0,0:21:28.80,0:21:33.05,Main,,0,0,0,,Denizkızı~! Denizkızı~!
Dialogue: 0,0:21:33.05,0:21:34.81,Main,,0,0,0,,Alt bölümü balığınki gibi değil mi?
Dialogue: 0,0:21:35.13,0:21:37.32,Main,,0,0,0,,Nasıl bu kadar çok şey biliyorsunuz?
Dialogue: 0,0:21:37.32,0:21:42.98,Main,,0,0,0,,Ah, üç yıl önce buraya gelmeden evvel Balıkadam Adası'na gittik!
Dialogue: 0,0:21:43.46,0:21:46.86,Main,,0,0,0,,Lola, siz Yeni Dünya'ya gittiniz mi?
Dialogue: 0,0:21:46.86,0:21:50.51,Main,,0,0,0,,Gitmedik! Yeni Dünya'da doğduk!
Dialogue: 0,0:21:50.51,0:21:52.99,Main,,0,0,0,,Annem de korsandır!
Dialogue: 0,0:21:52.99,0:21:54.73,Main,,0,0,0,,Sahi.
Dialogue: 0,0:21:55.56,0:21:58.82,Main,,0,0,0,,Bu, annemin Yaşam Kartı. Alabilirsin.
Dialogue: 0,0:21:59.50,0:22:00.66,Main,,0,0,0,,Kâğıt?
Dialogue: 0,0:22:00.66,0:22:03.20,Main,,0,0,0,,Bu harika!
Dialogue: 0,0:22:03.20,0:22:06.63,Main,,0,0,0,,Kaptan Lola'nın annesi müthiş bir korsandır!
Dialogue: 0,0:22:06.97,0:22:10.67,Main,,0,0,0,,Onu iyi saklayın! \NSonra kesinlikle işinize yarayacaktır!
Dialogue: 0,0:22:11.09,0:22:13.09,Main,,0,0,0,,Yaşam Kartı nedir?
Dialogue: 0,0:22:13.09,0:22:14.51,Main,,0,0,0,,Bilmiyor musun?
Dialogue: 0,0:22:14.51,0:22:18.72,Main,,0,0,0,,Kaptan Lola, sadece Yeni Dünya'da Yaşam Kartı yapıyorlar!
Dialogue: 0,0:22:18.72,0:22:19.93,Main,,0,0,0,,Ah, doğru!
Dialogue: 0,0:22:20.38,0:22:22.62,Main,,0,0,0,,Bu sıradan bir kâğıt değil.
Dialogue: 0,0:22:22.62,0:22:25.34,Main,,0,0,0,,Islatsanız da, yaksanız da hiç zarar görmeden kalır.
Dialogue: 0,0:22:25.34,0:22:28.38,Main,,0,0,0,,Tırnağınızın bir parçasını belli bir dükkana götürürseniz,...
Dialogue: 0,0:22:28.38,0:22:32.21,Main,,0,0,0,,...bir karışıma eklerler ve sizin için özel bir kâğıt yaparlar.
Dialogue: 0,0:22:32.21,0:22:35.73,Main,,0,0,0,,İşte bu kâğıda Vivre Kart, Yaşam Kartı denir!
Dialogue: 0,0:22:36.11,0:22:40.07,Main,,0,0,0,,Bir parçasını yırtarsınız ve yolculuğa çıkacak\Nolan arkadaşınıza veya aile üyesine verirsiniz.
Dialogue: 0,0:22:40.32,0:22:41.18,Main,,0,0,0,,Şuna bir bak.
Dialogue: 0,0:22:41.18,0:22:44.22,Main,,0,0,0,,Bu, annemden aldığım Yaşam Kartı.
Dialogue: 0,0:22:46.75,0:22:48.00,Main,,0,0,0,,Kıpırdadı!
Dialogue: 0,0:22:48.00,0:22:51.66,Main,,0,0,0,,Bu kart, aynısından olan kişiyle dünyanın\Nneresinde olursa olsun buluşmanı sağlıyor.
Dialogue: 0,0:22:51.66,0:22:55.45,Main,,0,0,0,,Bu yüzden annemin ne yöne gittiğini her zaman bileceğim.
Dialogue: 0,0:22:55.45,0:22:57.20,Main,,0,0,0,,Gerçi mesafeyi söylemiyor.
Dialogue: 0,0:22:57.20,0:22:59.54,Main,,0,0,0,,Ne tuhaf!
Dialogue: 0,0:22:59.54,0:23:02.69,Main,,0,0,0,,Yani Yeni Dünya'da bir sürü öyle şey mi var?
Dialogue: 0,0:23:02.69,0:23:04.18,Main,,0,0,0,,Kullanışlı, değil mi?
Dialogue: 0,0:23:04.18,0:23:07.44,Main,,0,0,0,,Annemin verdiği Yaşam Kartı'nı imzaladığım için,...
Dialogue: 0,0:23:07.44,0:23:11.57,Main,,0,0,0,,...bir sorununuz olursa, bunu annemi bulmak için kullanabilirsiniz.
Dialogue: 0,0:23:11.57,0:23:14.67,Main,,0,0,0,,Böyle bir şey olursa, ona iyi olduğumu söyleyebilir misiniz?
Dialogue: 0,0:23:14.67,0:23:17.34,Main,,0,0,0,,Sanırım onlardan bende de bir tane var.
Dialogue: 0,0:23:17.98,0:23:20.29,Main,,0,0,0,,Ben de aynı şeyi düşünüyordum.
Dialogue: 0,0:23:20.29,0:23:24.16,Main,,0,0,0,,Ace'in sana verdiği beyaz kâğıt aynı şey değil miydi?
Dialogue: 0,0:23:24.77,0:23:28.24,Flashbacks,,0,0,0,,Bu kâğıt parçası, bir gün yine buluşmamızı sağlayacak.
Dialogue: 0,0:23:29.08,0:23:31.46,Main,,0,0,0,,Demek bu oydu.
Dialogue: 0,0:23:32.08,0:23:33.06,Main,,0,0,0,,Bu işte.
Dialogue: 0,0:23:34.48,0:23:36.94,Main,,0,0,0,,Biraz yanıyor ve küçülüyor.
Dialogue: 0,0:23:37.77,0:23:39.40,Main,,0,0,0,,Dur! Onu göster bana!
Dialogue: 0,0:23:44.82,0:23:47.67,Main,,0,0,0,,Bu kesinlikle Yaşam Kartı.
Dialogue: 0,0:23:47.67,0:23:53.72,Main,,0,0,0,,Ama bu kartın, sahibinin yaşam gücünü\Ntemsil ettiğini size söylemedim!
Dialogue: 0,0:23:53.72,0:23:56.35,Main,,0,0,0,,Bu, senin için önemli olan birine ait, değil mi?
Dialogue: 0,0:23:56.81,0:23:59.05,Main,,0,0,0,,Evet! Abimin!
Dialogue: 0,0:24:03.46,0:24:04.86,Main,,0,0,0,,Lola?
Dialogue: 0,0:24:08.73,0:24:12.26,Main,,0,0,0,,Bunu söylediğim için üzgünüm. Ama bu kişinin hayatı...
Dialogue: 0,0:24:13.06,0:24:14.90,Main,,0,0,0,,...tükeniyor!
