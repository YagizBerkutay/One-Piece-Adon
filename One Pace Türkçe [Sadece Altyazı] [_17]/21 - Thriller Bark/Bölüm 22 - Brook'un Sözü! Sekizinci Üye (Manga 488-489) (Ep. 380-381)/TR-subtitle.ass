Dialogue: 0,0:02:29.86,0:02:38.49,Title,,0,0,0,,{\fad(2000,2000)}Brook'un Sözü!\NSekizinci Üye
Dialogue: 0,0:02:39.00,0:02:45.46,Captions,,0,0,300,,{\fad(1000,1000)}İkiz Burun'dan ayrılmalarından 10 yıl sonra\N- Florian Üçgeni -
Dialogue: 0,0:02:51.94,0:02:53.88,Main,,0,0,0,,Külotunu çıkarışını gördüm!
Dialogue: 0,0:02:53.88,0:02:55.85,Main,,0,0,0,,Sadece şakaydı! Ne utanç verici!
Dialogue: 0,0:02:58.38,0:03:02.00,Main,,0,0,0,,Çok eğlenceli~! Yalnızım ama çok eğleniyorum~!
Dialogue: 0,0:03:02.00,0:03:03.36,Main,,0,0,0,,Merhaba~!
Dialogue: 0,0:03:03.36,0:03:04.31,Main,,0,0,0,,45 derece!
Dialogue: 0,0:03:04.31,0:03:07.60,Main,,0,0,0,,Aha! Bakın, bakın! Orada biri var! \NAh, sadece benmişim.
Dialogue: 0,0:03:19.81,0:03:23.20,Main,,0,0,0,,Hey, Brook! Orada daha ne kadar uyuyacaksın?!
Dialogue: 0,0:03:23.20,0:03:25.20,Main,,0,0,0,,Uyan! Bir ada bulduk!
Dialogue: 0,0:03:25.20,0:03:27.30,Main,,0,0,0,,Yaz adası! Kumsal!
Dialogue: 0,0:03:28.99,0:03:31.90,Main,,0,0,0,,Ha? Ah, şey, şey...
Dialogue: 0,0:03:31.90,0:03:35.22,Main,,0,0,0,,Ne? Ne? Durun, bu da ne?!
Dialogue: 0,0:03:35.22,0:03:36.62,Main,,0,0,0,,Ne oldu, Brook?
Dialogue: 0,0:03:36.62,0:03:38.53,Main,,0,0,0,,Sen olmadan başlayamayız, değil mi?!
Dialogue: 0,0:03:39.56,0:03:42.64,Main,,0,0,0,,Ah, herkes burada!
Dialogue: 0,0:03:42.64,0:03:46.84,Main,,0,0,0,,Ha? Çok mutluyum! Ne?
Dialogue: 0,0:03:46.84,0:03:49.85,Main,,0,0,0,,Nasıl hayatta olursunuz? Nasıl?!
Dialogue: 0,0:03:49.85,0:03:53.18,Main,,0,0,0,,Ne diyorsun sen? Daha ne kadar\Nhayal görmeye devam edeceksin?
Dialogue: 0,0:03:59.34,0:04:03.20,Main,,0,0,0,,Acıyorsa, bu hayal değil demektir!
Dialogue: 0,0:04:03.20,0:04:06.63,Main,,0,0,0,,Gerçek! Diğer parçası hayal olmalı! Hele şü-
Dialogue: 0,0:04:23.99,0:04:28.11,Main,,0,0,0,,Acaba Kaptan Yorki, Sükunet Kuşağı'nı geçti mi?
Dialogue: 0,0:04:28.11,0:04:30.50,Main,,0,0,0,,Sanırım bunu sadece okyanus bilirdi.
Dialogue: 0,0:04:30.50,0:04:35.62,Main,,0,0,0,,Onun hatrına devam etmeliyiz! \NBu yeni gemiyi Laboon'un beklediği yere götürelim!
Dialogue: 0,0:04:35.62,0:04:37.98,Main,,0,0,0,,Sabah oldu!
Dialogue: 0,0:04:37.98,0:04:39.84,Main,,0,0,0,,Uyandık! Uyandık!
Dialogue: 0,0:04:39.84,0:04:42.64,Main,,0,0,0,,Çok büyük bir fırtına! Yelkenimiz parçalanacak!
Dialogue: 0,0:04:42.64,0:04:45.71,Main,,0,0,0,,Ha! Şarkı söylemeli ve geçip gitmeliyiz!
Dialogue: 0,0:04:45.71,0:04:50.58,Main,,0,0,0,,Vay, Brook'a bakın! Ödülün olmuş!
Dialogue: 0,0:05:05.42,0:05:09.58,Main,,0,0,0,,Ha? Neler oluyor? Çalmaya devam et, Brook!
Dialogue: 0,0:05:09.58,0:05:12.57,Main,,0,0,0,,Evet! Burnumdaki yemek çubuklarıyla dans ediyordum!
Dialogue: 0,0:05:13.45,0:05:14.89,Main,,0,0,0,,Biraz müsaade edin!
Dialogue: 0,0:05:17.26,0:05:18.30,Main,,0,0,0,,Bir bakalım!
Dialogue: 0,0:05:18.83,0:05:19.48,Main,,0,0,0,,Müthiş~!
Dialogue: 0,0:05:19.48,0:05:20.97,Main,,0,0,0,,BUNU YAPABİLİYOR MUSUN?!
Dialogue: 0,0:05:21.71,0:05:27.94,Main,,0,0,0,,Epey zaman önce sahip olduğum bir şey. Ton Kadranı denir.
Dialogue: 0,0:05:27.94,0:05:31.89,Main,,0,0,0,,Kaydettiğin her şeyi çalan nadir bir kabuktur.
Dialogue: 0,0:05:31.89,0:05:34.27,Main,,0,0,0,,Oh! O şey Gökyüzü Adası'ndan!
Dialogue: 0,0:05:34.27,0:05:35.68,Main,,0,0,0,,Biliyor musun?
Dialogue: 0,0:05:36.25,0:05:42.05,Main,,0,0,0,,Laboon'u gördüğümde onun için bunu çalmak istiyorum, bu yüzden hep bedenimde taşıyorum.
Dialogue: 0,0:05:42.05,0:05:44.42,Main,,0,0,0,,Ona bir şey mi kaydettin?
Dialogue: 0,0:05:44.42,0:05:45.59,Main,,0,0,0,,Bir şarkı.
Dialogue: 0,0:05:46.72,0:05:49.74,Main,,0,0,0,,Ölü arkadaşlarım, bunu hayattayken söylediler.
Dialogue: 0,0:05:49.74,0:05:55.50,Main,,0,0,0,,Laboon'a, sonuna kadar neşeli olduğumuzu söyleyen bir mesaj.
Dialogue: 0,0:05:56.02,0:05:57.91,Main,,0,0,0,,Şimdi çalabilir miyim?
Dialogue: 0,0:05:57.91,0:06:01.67,Main,,0,0,0,,Oh! Duymak istiyorum! Eminim Laboon da isterdi!
Dialogue: 0,0:06:02.27,0:06:03.14,Main,,0,0,0,,O zaman...
Dialogue: 0,0:06:10.02,0:06:14.89,Main,,0,0,0,,Kaçımız hala nefes alıyor?
Dialogue: 0,0:06:16.48,0:06:20.87,Main,,0,0,0,,Hala nefes alıyoruz ama bizim için fazla umut yok gibi görünüyor.
Dialogue: 0,0:06:21.82,0:06:24.09,Main,,0,0,0,,Galiba yok edildik.
Dialogue: 0,0:06:25.28,0:06:28.46,Main,,0,0,0,,Silahları zehirliydi.
Dialogue: 0,0:06:28.46,0:06:30.14,Main,,0,0,0,,Görünüşe göre hepimiz öleceğiz.
Dialogue: 0,0:06:30.56,0:06:35.88,Main,,0,0,0,,Korsanlar olarak her zaman ölmeye hazırdık ama...
Dialogue: 0,0:06:37.00,0:06:38.98,Main,,0,0,0,,...kimsenin hayatta kalmayacağını düşünmek...
Dialogue: 0,0:06:39.90,0:06:41.10,Main,,0,0,0,,Laboon.
Dialogue: 0,0:06:43.10,0:06:47.42,Main,,0,0,0,,Brook, Yomi Yomi meyven...
Dialogue: 0,0:06:47.42,0:06:53.32,Main,,0,0,0,,Kim bilir? Daha önce hiç ölmedim ama bir fikrim var!
Dialogue: 0,0:06:53.32,0:06:56.53,Main,,0,0,0,,Zaten öleceğiz. Biraz eğlenelim.
Dialogue: 0,0:06:58.72,0:07:00.67,Main,,0,0,0,,Şarkı söylemek istiyor musunuz?
Dialogue: 0,0:07:01.46,0:07:07.14,Main,,0,0,0,,Yomi Yomi meyvesi beni gerçekten hayata döndürecekse,...
Dialogue: 0,0:07:07.94,0:07:10.52,Main,,0,0,0,,...başarısız olmadan bunu ona götüreceğim!
Dialogue: 0,0:07:10.52,0:07:12.12,Main,,0,0,0,,Ton Kadranı.
Dialogue: 0,0:07:12.12,0:07:18.45,Main,,0,0,0,,Laboon'un, kaptanın ve hepimizin sevdiği şarkı.
Dialogue: 0,0:07:18.45,0:07:25.86,Main,,0,0,0,,Arkadaşımız Laboon, ne zaman döneceğimizi asla bilmeden burunda bizi bekliyor!
Dialogue: 0,0:07:26.36,0:07:28.05,Main,,0,0,0,,Harika fikir!
Dialogue: 0,0:07:29.02,0:07:33.38,Main,,0,0,0,,Evet. Arkadaşlar, bitene kadar düşmediğinizden emin olun!
Dialogue: 0,0:07:34.18,0:07:35.40,Main,,0,0,0,,Duymasını sağlayalım!
Dialogue: 0,0:07:35.79,0:07:43.98,Main,,0,0,0,,Laboon'a, Rumbar Korsanları'nın hayatta bir kez olacak gösterisini sunalım!
Dialogue: 0,0:07:53.18,0:07:57.69,Main,,0,0,0,,Ah? Bu şarkıysa eşlik edebiliriz!
