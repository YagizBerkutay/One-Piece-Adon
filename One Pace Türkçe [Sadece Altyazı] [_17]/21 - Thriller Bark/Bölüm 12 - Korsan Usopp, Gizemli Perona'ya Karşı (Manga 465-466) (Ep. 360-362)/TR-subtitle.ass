,0,1,1.5,1.5,8,120,120,18,1Style: Title,impress bt,63,&H00FEFEFE,&H000000FF,&H00000000,&H00000000,-1,0,0,0,120,100,1,0,1,2,0,5,10,10,10,1Style: TS paper,impress bt,50,&H001D221E,&H000000FF,&H001D221E,&H00000000,0,0,0,0,100,100,0,0,1,0.5,0,2,10,10,10,1Style: Jungle P lyrics,impress bt,43,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,2,0,2,10,10,15,1Style: Author,Impress BT,25,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1,1,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextComment: 0,0:17:22.67,0:17:25.85,Main,Usopp,0,0,0,,Saldıramazsın!Dialogue: 0,0:00:01.35,0:00:05.47,Jungle P lyrics,,0,0,0,,Dünyanın her yerindeki denizlerde yolculuk edelim.Dialogue: 0,0:00:05.68,0:00:07.85,Jungle P lyrics,,0,0,0,,Savaş naramızı yükselterek.Dialogue: 0,0:00:08.00,0:00:12.19,Jungle P lyrics,,0,0,0,,Kararını verdiysen, bırak kalkış sinyali...Dialogue: 0,0:00:12.32,0:00:14.63,Jungle P lyrics,,0,0,0,,...çalınsın!Dialogue: 0,0:00:21.87,0:00:25.34,Jungle P lyrics,,0,0,0,,Sabit rotadan kaçabildik,...Dialogue: 0,0:00:23.48,0:00:29.00,Credits,,0,0,0,,Translation & initial syncing Vegapunk FansubsDialogue: 0,0:00:25.47,0:00:28.89,Jungle P lyrics,,0,0,0,,...denizle gök arasındaki sınır boyunca.Dialogue: 0,0:00:29.01,0:00:34.15,Jungle P lyrics,,0,0,0,,Şimdi kürek ççekerek yolumuzu açıyoruz...Dialogue: 0,0:00:29.40,0:00:34.55,Credits,,0,0,0,,Syncing Galaxy 9000  Sync-checking SewilDialogue: 0,0:00:34.51,0:00:40.67,Jungle P lyrics,,0,0,0,,...denizin karanlık dibindeki gizli bir maceraya doğru.Dialogue: 0,0:00:35.61,0:00:40.79,Credits,,0,0,0,,Quality-checking Sewil Galaxy 9000 FeesoDialogue: 0,0:00:40.72,0:00:47.49,Jungle P lyrics,,0,0,0,,Sırf bunu düşünmek bile kulağa eğlenceli gelmiyor mu?Dialogue: 0,0:00:40.95,0:00:44.12,Credits,,0,0,0,,Soundtracking HaleeDialogue: 0,0:00:44.29,0:00:47.50,Credits,,0,0,0,,Video editing SewilDialogue: 0,0:00:47.79,0:00:51.88,Jungle P lyrics,,0,0,0,,Dünyanın her yerindeki denizlerde yolculuk edelim.Dialogue: 0,0:00:51.98,0:00:54.22,Jungle P lyrics,,0,0,0,,Savaş naramızı yükselterek.Dialogue: 0,0:00:53.05,0:00:56.89,Credits,,0,0,0,,Raw provider SOFCJ-RawsDialogue: 0,0:00:54.35,0:00:58.55,Jungle P lyrics,,0,0,0,,Kararını verdiysen, bırak kalkış sinyali...Dialogue: 0,0:00:57.26,0:01:01.56,Credits,,0,0,0,,Title card artist thegamejc.deviantart.comDialogue: 0,0:00:58.72,0:01:00.99,Jungle P lyrics,,0,0,0,,...çalınsın!Dialogue: 0,0:01:08.40,0:01:11.57,Jungle P lyrics,,0,0,0,,Yelken açarken hissettiğimiz o his...Dialogue: 0,0:01:11.68,0:01:15.05,Jungle P lyrics,,0,0,0,,...asla unutmayacağım bir şey.Dialogue: 0,0:01:15.22,0:01:16.86,Jungle P lyrics,,0,0,0,,O his sayesinde...Dialogue: 0,0:01:17.04,0:01:20.54,Jungle P lyrics,,0,0,0,,...hiçbir şey beni korkutamayacak.Dialogue: 0,0:01:20.83,0:01:26.77,Jungle P lyrics,,0,0,0,,Şimdi yolculuk yaklaşırken, yarışan kalp atışlarımız...Dialogue: 0,0:01:27.00,0:01:33.72,Jungle P lyrics,,0,0,0,,...utangaç kalplerimize bir macera ritmi kazıyor.Dialogue: 0,0:01:33.92,0:01:38.09,Jungle P lyrics,,0,0,0,,Yüksek sesle gülerken...Dialogue: 0,0:01:38.21,0:01:40.40,Jungle P lyrics,,0,0,0,,...tüm hazineleri al.Dialogue: 0,0:01:40.53,0:01:44.80,Jungle P lyrics,,0,0,0,,Dikkatleri üzerine ççekerek...Dialogue: 0,0:01:44.90,0:01:47.44,Jungle P lyrics,,0,0,0,,...hepsini büyük bir partide harca.Dialogue: 0,0:01:47.90,0:01:49.54,Jungle P lyrics,,0,0,0,,Hayat maceralıdır.Dialogue: 0,0:01:49.54,0:01:51.12,Jungle P lyrics,,0,0,0,,Tehlikesinin farkında ol.Dialogue: 0,0:01:51.12,0:01:52.82,Jungle P lyrics,,0,0,0,,Kim bizden biri olacak?Dialogue: 0,0:01:52.82,0:01:54.41,Jungle P lyrics,,0,0,0,,Ve yolculuk devam ediyor çünkü...Dialogue: 0,0:01:54.41,0:01:56.13,Jungle P lyrics,,0,0,0,,...biz bir grup korsanız!Dialogue: 0,0:01:56.13,0:01:57.91,Jungle P lyrics,,0,0,0,,Batıya, Doğuya.Dialogue: 0,0:01:57.91,0:01:59.38,Jungle P lyrics,,0,0,0,,Yolumu bulmalı, uzaklara yelken açmalıyım.Dialogue: 0,0:01:59.38,0:02:00.38,Jungle P lyrics,,0,0,0,,One Piece'e doğru!Dialogue: 0,0:02:00.57,0:02:04.65,Jungle P lyrics,,0,0,0,,Boş kalbini hayallerle doldur.Dialogue: 0,0:02:04.79,0:02:06.99,Jungle P lyrics,,0,0,0,,Kanatlarını aç.Dialogue: 0,0:02:07.24,0:02:11.31,Jungle P lyrics,,0,0,0,,Kalbini esen rüzgarla boyarsan,...Dialogue: 0,0:02:11.41,0:02:13.65,Jungle P lyrics,,0,0,0,,...ilerlersin.Dialogue: 0,0:02:13.71,0:02:17.83,Jungle P lyrics,,0,0,0,,Yüksek sesle gülerken...Dialogue: 0,0:02:18.00,0:02:20.17,Jungle P lyrics,,0,0,0,,...tüm hazineleri al.Dialogue: 0,0:02:20.30,0:02:24.57,Jungle P lyrics,,0,0,0,,Dikkatleri üzerine ççekerek...Dialogue: 0,0:02:24.74,0:02:27.31,Jungle P lyrics,,0,0,0,,...hepsini büyük bir partide harca.Dialogue: 0,0:02:29.89,0:02:39.89,Author,,0,0,0,, Türkçeleştirme  onepacetr.netDialogue: 0,0:11:25.00,0:11:35.00,Author,,0,0,0,, Türkçeleştirme  onepacetr.netDialogue: 0,0:20:40.00,0:20:50.00,Author,,0,0,0,, Türkçeleştirme  onepacetr.netDialogue: 0,0:02:29.89,0:02:38.56,Title,,0,0,0,,Korsan Usopp, Gizemli Perona'ya KarşıDialogue: 0,0:02:41.22,0:02:42.35,Main,Usopp,0,0,0,,Sen...Dialogue: 0,0:02:42.35,0:02:46.81,Main,Usopp,0,0,0,,...nasıl uçabilirsin?Dialogue: 0,0:02:47.25,0:02:48.94,Main,Usopp,0,0,0,,Bu ne güven.Dialogue: 0,0:02:48.94,0:02:51.42,Main,Usopp,0,0,0,,Biraz önce kaçıyordun.Dialogue: 0,0:02:51.42,0:02:54.02,Main,Usopp,0,0,0,,Niye bu ani değişiklik?!Dialogue: 0,0:02:58.59,0:03:01.20,Main,Perona,0,0,0,,Demin dikkatim biraz dağılmıştı.Dialogue: 0,0:03:01.73,0:03:07.03,Main,Perona,0,0,0,,Negatif hayaletlere karşı bağışıklığı olan birinin var olabileceğini hiç düşünmemiştim.Dialogue: 0,0:03:08.18,0:03:10.58,Main,Perona,0,0,0,,Sana söyleyecek tek bir şeyim var.Dialogue: 0,0:03:11.73,0:03:13.19,Main,Perona,0,0,0,,Keyfine bak!Dialogue: 0,0:03:13.19,0:03:14.27,Main,Usopp,0,0,0,,Kapa çeneni!Dialogue: 0,0:03:15.97,0:03:18.51,Main,Usopp,0,0,0,,Uçabiliyorsan ne olmuş?!Dialogue: 0,0:03:18.90,0:03:20.37,Main,Usopp,0,0,0,,Ben keskin nişancıyım!Dialogue: 0,0:03:20.37,0:03:22.24,Main,Usopp,0,0,0,,Uç veya dans et, umrumda değil!Dialogue: 0,0:03:22.98,0:03:24.42,Main,Usopp,0,0,0,,Açıklamama izin ver!Dialogue: 0,0:03:24.42,0:03:29.33,Main,Usopp,0,0,0,,Yeni silahım Kabuto, beş destek noktası sayesinde mesafe ve denge kazanıyor!Dialogue: 0,0:03:29.33,0:03:34.41,Main,Usopp,0,0,0,,Gökyüzü Adası'ndan aldığım Nefes Kadranları ateş sırasında aktif olunca,...Dialogue: 0,0:03:34.41,0:03:40.42,Main,Usopp,0,0,0,,...mermiye, her türlü hız değişikliklerini mümkün kılan dönüşü ekleyen Süper Pachinko!Dialogue: 0,0:03:41.10,0:03:43.33,Main,Usopp,0,0,0,,Alev, Flaş, Darbe.Dialogue: 0,0:03:43.33,0:03:47.37,Main,Usopp,0,0,0,,Kadranları değiştirerek mermileri daha güçlü yapabilirim!Dialogue: 0,0:03:47.37,0:03:50.08,Main,Usopp,0,0,0,,Yeteneklerinden kimse kaçamaz!Dialogue: 0,0:03:53.17,0:03:55.17,Main,Usopp,0,0,0,,Şimdi hazırla ken-Dialogue: 0,0:03:55.17,0:03:57.75,Main,Usopp,0,0,0,,Gitmiş!Dialogue: 0,0:03:57.75,0:03:59.18,Main,Usopp,0,0,0,,Nereye gitti bu?!Dialogue: 0,0:04:00.78,0:04:01.92,Main,Perona,0,0,0,,Arkandayım.Dialogue: 0,0:04:08.94,0:04:11.10,Main,Perona,0,0,0,,Hadi vurmaya çalış beni.Dialogue: 0,0:04:13.14,0:04:16.44,Main,Usopp,0,0,0,,N-Nesin sen böyle?!Dialogue: 0,0:04:20.22,0:04:21.28,Main,Usopp,0,0,0,,Lanet olası...Dialogue: 0,0:04:21.28,0:04:22.19,Main,Usopp,0,0,0,,Kesin Öldürücü...Dialogue: 0,0:04:22.51,0:04:23.88,Main,Usopp,0,0,0,,...Çatal Kuyruk Meteoru!Dialogue: 0,0:04:26.20,0:04:27.78,Main,Usopp,0,0,0,,Normale döndü!Dialogue: 0,0:04:31.16,0:04:32.70,Main,Usopp,0,0,0,,Sen!Dialogue: 0,0:04:32.70,0:04:34.04,Main,Usopp,0,0,0,,Şimdi seni düşüreceğim!Dialogue: 0,0:04:34.04,0:04:35.04,Main,Usopp,0,0,0,,Peygamberdevesi Meteoru!Dialogue: 0,0:04:47.71,0:04:50.54,Main,Usopp,0,0,0,,Elleri vücuduma giriyor!Dialogue: 0,0:04:50.54,0:04:51.81,Main,Usopp,0,0,0,,N-Nasıl olur?!Dialogue: 0,0:04:51.81,0:04:54.55,Main,Usopp,0,0,0,,Acı bile hissetmiyorum!Dialogue: 0,0:04:54.55,0:04:55.55,Main,Usopp,0,0,0,,İşim...Dialogue: 0,0:04:56.32,0:04:59.15,Main,Usopp,0,0,0,,...çoktan bitti!Dialogue: 0,0:04:59.42,0:05:00.82,Main,Perona,0,0,0,,Ahmak, iyi bak.Dialogue: 0,0:05:01.66,0:05:02.96,Main,Perona,0,0,0,,Harici bir yara yok.Dialogue: 0,0:05:02.96,0:05:06.49,Main,Perona,0,0,0,,Ellerim sadece bedeninde.Dialogue: 0,0:05:07.03,0:05:10.87,Main,Perona,0,0,0,,Ölümün ellerimde demek oluyor.Dialogue: 0,0:05:13.06,0:05:16.71,Main,Perona,0,0,0,,Çünkü, şu anda kendi ellerimle...Dialogue: 0,0:05:16.71,0:05:18.94,Main,Perona,0,0,0,,...kalbini ezeceğim!Dialogue: 0,0:05:20.16,0:05:20.95,Main,Usopp,0,0,0,,Dur!Dialogue: 0,0:05:20.95,0:05:23.16,Main,Usopp,0,0,0,,Lütfen kes şunu!Dialogue: 0,0:05:23.16,0:05:25.42,Main,Usopp,0,0,0,,Bu beni gerçekten öldürürdü!Dialogue: 0,0:05:25.42,0:05:28.18,Main,Pelona,0,0,0,,Seni öldüreceğim.Dialogue: 0,0:05:29.01,0:05:30.15,Main,Perona,0,0,0,,Şimdi...Dialogue: 0,0:05:30.15,0:05:33.27,Main,Pelona,0,0,0,,...ıstırap içinde öl!Dialogue: 0,0:05:35.12,0:05:36.20,Main,Usopp,0,0,0,,Hayır!Dialogue: 0,0:05:36.20,0:05:38.45,Main,Usopp,0,0,0,,Lütfen dur!Dialogue: 0,0:05:38.45,0:05:39.77,Main,Usopp,0,0,0,,İstemiyorum!Dialogue: 0,0:05:42.82,0:05:44.28,Main,Pelona,0,0,0,,Elbette öyle bir şey yapamam.Dialogue: 0,0:05:44.96,0:05:46.36,Main,Usopp,0,0,0,,Blöf mü?!Dialogue: 0,0:05:46.90,0:05:48.08,Main,Usopp,0,0,0,,Başımı vurdum!Dialogue: 0,0:05:48.08,0:05:51.00,Main,Pelona,0,0,0,,Ezmek gibi fiziksel zarar verme yeteneğim olsaydı,...Dialogue: 0,0:05:48.08,0:05:49.36,Secondary,Usopp,0,0,0,,Başımı vurdum!Dialogue: 0,0:05:51.00,0:05:54.50,Main,Pelona,0,0,0,,...ellerim bedenine girdiği anda ölürdün.Dialogue: 0,0:05:56.75,0:05:59.21,Main,Usopp,0,0,0,,Yine de bu kalp için kötü.Dialogue: 0,0:05:59.21,0:06:01.71,Main,Pelona,0,0,0,,Demin bedeninden...Dialogue: 0,0:06:02.20,0:06:03.69,Main,Pelona,0,0,0,,...geçtim.Dialogue: 0,0:06:07.88,0:06:11.39,Main,Pelona,0,0,0,,Beni açıkça görebilsen de,...Dialogue: 0,0:06:11.87,0:06:15.16,Main,Pelona,0,0,0,,...bedenim her şeyden geçebilir.Dialogue: 0,0:06:16.06,0:06:16.86,Main,Usopp,0,0,0,,Kesin Öldürücü...Dialogue: 0,0:06:16.86,0:06:18.81,Main,Usopp,0,0,0,,...Altı Odalı Engerek Yıldızı!Dialogue: 0,0:06:25.28,0:06:27.63,Main,Pelona,0,0,0,,Her şeyin içinden geçebileceğimi söylemedim mi?Dialogue: 0,0:06:31.12,0:06:32.16,Main,Usopp,0,0,0,,Dur!Dialogue: 0,0:06:32.16,0:06:33.87,Main,Usopp,0,0,0,,Bu ürpertici!Dialogue: 0,0:06:33.87,0:06:37.73,Main,Pelona,0,0,0,,Diğer deyişle, saldırıların bana vuramaz.Dialogue: 0,0:06:41.08,0:06:41.80,Main,Usopp,0,0,0,,Pislik!Dialogue: 0,0:06:41.80,0:06:43.11,Main,Usopp,0,0,0,,Defol!Dialogue: 0,0:06:43.11,0:06:44.87,Main,Usopp,0,0,0,,Kahretsin!Dialogue: 0,0:06:44.87,0:06:45.64,Main,Usopp,0,0,0,,Uzak dur!Dialogue: 0,0:06:45.64,0:06:47.11,Main,Usopp,0,0,0,,Defol, lanet olsun!Dialogue: 0,0:06:51.44,0:06:53.02,Main,Pelona,0,0,0,,Şimdi ne yapacaksın?Dialogue: 0,0:06:53.02,0:06:55.26,Main,Pelona,0,0,0,,Saldırılarının etkisi yok.Dialogue: 0,0:06:56.46,0:06:58.16,Main,Usopp,0,0,0,,Kapa çeneni!Dialogue: 0,0:06:58.16,0:07:02.02,Main,Usopp,0,0,0,,Demin kalbimi ezme konusunda blöf yaptın!Dialogue: 0,0:07:02.46,0:07:06.96,Main,Usopp,0,0,0,,Bu durumda sen de bana dokunamazsın!Dialogue: 0,0:07:06.96,0:07:09.69,Main,Usopp,0,0,0,,Bana saldıramazsın da!Dialogue: 0,0:07:09.69,0:07:11.68,Main,Usopp,0,0,0,,Saldıramazsın!Dialogue: 0,0:07:11.68,0:07:12.51,Main,Usopp,0,0,0,,Değil mi?!Dialogue: 0,0:07:13.16,0:07:14.42,Main,Pelona,0,0,0,,Mini Hayalet.Dialogue: 0,0:07:15.16,0:07:17.29,Main,Usopp,0,0,0,,O da ne?Dialogue: 0,0:07:19.46,0:07:21.05,Main,Pelona,0,0,0,,Hayalet Vuruşu!Dialogue: 0,0:07:25.88,0:07:28.55,Main,Usopp,0,0,0,,D-Duvar! Duvar...Dialogue: 0,0:07:28.55,0:07:30.66,Main,Usopp,0,0,0,,...p-patladı mı?!Dialogue: 0,0:07:33.52,0:07:34.39,Main,Usopp,0,0,0,,Defol!Dialogue: 0,0:07:35.53,0:07:36.47,Main,Pelona,0,0,0,,Vur!Dialogue: 0,0:07:38.62,0:07:40.10,Main,Usopp,0,0,0,,Lanet olası...Dialogue: 0,0:07:40.10,0:07:41.10,Main,Usopp,0,0,0,,Kesin Öldürücü...Dialogue: 0,0:07:41.10,0:07:42.43,Main,Usopp,0,0,0,,Ateş Kuşu Yıldızı!Dialogue: 0,0:07:48.57,0:07:50.15,Main,Usopp,0,0,0,,Kahretsin!Dialogue: 0,0:07:51.34,0:07:52.59,Main,Usopp,0,0,0,,Bu hiç adil değil!Dialogue: 0,0:07:53.68,0:07:55.49,Main,Usopp,0,0,0,,Ona saldıramıyorum!Dialogue: 0,0:07:55.49,0:07:57.42,Main,Usopp,0,0,0,,Ama bana saldırabiliyor!Dialogue: 0,0:07:57.42,0:07:58.72,Main,Usopp,0,0,0,,Bu nasıl bir eşleşme?!Dialogue: 0,0:08:01.19,0:08:03.00,Main,Usopp,0,0,0,,Ç-Çekil!Dialogue: 0,0:08:03.62,0:08:04.81,Main,Usopp,0,0,0,,Önümde ne olduğunu göremiyorum.Dialogue: 0,0:08:04.81,0:08:05.81,Main,Usopp,0,0,0,,Çekil!Dialogue: 0,0:08:05.81,0:08:07.09,Main,Usopp,0,0,0,,Çekil!Dialogue: 0,0:08:14.85,0:08:16.23,Main,Pelona,0,0,0,,Hayalet Vuruşu!Dialogue: 0,0:08:25.59,0:08:27.49,Thoughts,Usopp,0,0,0,,Bu da ne?Dialogue: 0,0:08:27.49,0:08:29.57,Thoughts,Usopp,0,0,0,,Utanç verici.Dialogue: 0,0:08:30.42,0:08:35.74,Thoughts,Usopp,0,0,0,,O kadının benden güçsüz olduğunu sanmıştım!Dialogue: 0,0:08:39.87,0:08:41.33,Main,Usopp,0,0,0,,Ayı!Dialogue: 0,0:08:41.61,0:08:42.82,Main,Pelona,0,0,0,,Dikkatli ol.Dialogue: 0,0:08:42.82,0:08:46.17,Main,Pelona,0,0,0,,Ayıcık'ın gücü sıradan bir ayıdan fazladır.Dialogue: 0,0:08:51.17,0:08:53.06,Thoughts,Usopp,0,0,0,,Bu da ne?!Dialogue: 0,0:08:53.06,0:08:57.57,Thoughts,Usopp,0,0,0,,Tayfadaki hiç kimse o kadının yeteneğine karşı duramıyordu!Dialogue: 0,0:08:58.11,0:09:01.31,Thoughts,Usopp,0,0,0,,Sadece benim yenebileceğim biri olmalıydı!Dialogue: 0,0:09:02.58,0:09:04.00,Flashbacks,Usopp,0,0,0,,Değersiz...Dialogue: 0,0:09:04.00,0:09:07.31,Flashbacks,Usopp,0,0,0,,...güçlerinizle onu yenmeyi umamazsınız.Dialogue: 0,0:09:10.29,0:09:16.45,Thoughts,Usopp,0,0,0,,Bunun benim fırsatım olması gerekiyordu ama şu halime bak!Dialogue: 0,0:09:17.32,0:09:18.29,Thoughts,Usopp,0,0,0,,Faydasız.Dialogue: 0,0:09:19.05,0:09:20.96,Thoughts,Usopp,0,0,0,,Faydası yok!Dialogue: 0,0:09:20.96,0:09:23.54,Thoughts,Usopp,0,0,0,,Kazanma şansım yok!Dialogue: 0,0:09:23.54,0:09:29.61,Thoughts,Usopp,0,0,0,,Burada yenilirsem, Luffy-gil'i yakalamaya gidecek ve tayfanın işi bitecek.Dialogue: 0,0:09:31.15,0:09:35.22,Thoughts,Usopp,0,0,0,,Onları kurtarmak, düşündüğümden daha ağır bir yüktü!Dialogue: 0,0:09:35.95,0:09:37.34,Thoughts,Usopp,0,0,0,,Kurtar beni!Dialogue: 0,0:09:42.58,0:09:44.65,Thoughts,Usopp,0,0,0,,Kurtar beni,...Dialogue: 0,0:09:44.65,0:09:46.19,Thoughts,Usopp,0,0,0,,...Sogeking!Dialogue: 0,0:09:49.16,0:09:50.52,Thoughts,Usopp,0,0,0,,Lütfen göster bana!Dialogue: 0,0:09:50.52,0:09:52.29,Thoughts,Usopp,0,0,0,,Sen ne yapardın?!Dialogue: 0,0:10:02.14,0:10:03.60,Main,Pelona,0,0,0,,Ayıcık!Dialogue: 0,0:10:03.60,0:10:04.73,Main,Usopp,0,0,0,,Dur!Dialogue: 0,0:10:06.00,0:10:09.55,Main,Perona,0,0,0,,Pislik! Ayıcık'ı incitmeye nasıl cüret edersin!Dialogue: 0,0:10:11.00,0:10:13.42,Main,Perona,0,0,0,,O aptal maske de ne?!Dialogue: 0,0:10:16.08,0:10:18.05,Main,Sogeking,0,0,0,,Aptal bir tarafı yok!Dialogue: 0,0:10:18.05,0:10:19.95,Main,Sogeking,0,0,0,,Memnun oldum!Dialogue: 0,0:10:19.95,0:10:22.24,Main,Sogeking,0,0,0,,Adım Sogeking!Dialogue: 0,0:10:22.24,0:10:23.90,Main,Pelona,0,0,0,,Beni ahmak yerine koyma!Dialogue: 0,0:10:23.90,0:10:25.68,Main,Pelona,0,0,0,,Başka biri olduğuna inanmamı mı bekliyorsun?!Dialogue: 0,0:10:26.85,0:10:28.04,Main,Sogeking,0,0,0,,Kaçma vakti!Dialogue: 0,0:10:28.04,0:10:29.69,Main,Pelona,0,0,0,,Şimdi de kaçıyor musun?!Dialogue: 0,0:10:30.75,0:10:31.90,Thoughts,Sogeking,0,0,0,,Sakin ol!Dialogue: 0,0:10:31.90,0:10:33.59,Thoughts,Sogeking,0,0,0,,Dövüş, Usopp-kun!Dialogue: 0,0:10:33.59,0:10:34.67,Thoughts,Usopp,0,0,0,,Kapa çeneni!Dialogue: 0,0:10:34.67,0:10:35.97,Thoughts,Usopp,0,0,0,,Faydasız!Dialogue: 0,0:10:35.97,0:10:38.03,Thoughts,Usopp,0,0,0,,Kesinlikle kazanamam!Dialogue: 0,0:10:38.03,0:10:39.44,Thoughts,Sogeking,0,0,0,,Doğru değil!Dialogue: 0,0:10:39.44,0:10:41.30,Thoughts,Sogeking,0,0,0,,Bunu yapabilecek tek kişi sensin!Dialogue: 0,0:10:41.79,0:10:43.95,Thoughts,Usopp,0,0,0,,Bunu destekleyecek temelin var mı?!Dialogue: 0,0:10:44.77,0:10:45.43,Thoughts,Sogeking,0,0,0,,Hayır.Dialogue: 0,0:10:45.43,0:10:47.93,Thoughts,Usopp,0,0,0,,Demek yok!Dialogue: 0,0:10:48.59,0:10:49.63,Main,Pelona,0,0,0,,Mini Hayalet!Dialogue: 0,0:10:51.06,0:10:53.51,Thoughts,Sogeking,0,0,0,,Sadece bir anlığına düşün.Dialogue: 0,0:10:53.51,0:10:55.75,Thoughts,Sogeking,0,0,0,,Kesinlikle o kadında şüphe çekici bir şey var.Dialogue: 0,0:10:55.75,0:10:57.74,Thoughts,Usopp,0,0,0,,Kesinlikle.Dialogue: 0,0:10:57.74,0:11:00.61,Thoughts,Usopp,0,0,0,,Aniden kendine çok fazla güvenmeye başladı.Dialogue: 0,0:11:00.61,0:11:05.03,Thoughts,Usopp,0,0,0,,Önce benden korktu ve kaçtı.Dialogue: 0,0:11:07.66,0:11:12.23,Thoughts,Usopp,0,0,0,,Saldırım ona etki etmiyorduysa, kaçmasına gerek yoktu.Dialogue: 0,0:11:12.67,0:11:16.09,Thoughts,Usopp,0,0,0,,Uçabilir veya duvarlardan geçebilirdi.Dialogue: 0,0:11:16.09,0:11:19.76,Thoughts,Usopp,0,0,0,,Ama bunun yerine kaçarken bağırıyordu.Dialogue: 0,0:11:19.76,0:11:20.59,Main,Perona,0,0,0,,Vur!Dialogue: 0,0:11:20.59,0:11:21.47,Main,Perona,0,0,0,,Vur!Dialogue: 0,0:11:25.02,0:11:27.99,Thoughts,Usopp,0,0,0,,O kadını gözden kaybettiğimde...Dialogue: 0,0:11:29.36,0:11:31.44,Thoughts,Usopp,0,0,0,,...bir şey oldu.Dialogue: 0,0:11:32.92,0:11:35.42,Thoughts,Usopp,0,0,0,,Ayıyla uğraşırken,...Dialogue: 0,0:11:37.04,0:11:41.22,Thoughts,Usopp,0,0,0,,...bir an onu gözden kaybettim.Dialogue: 0,0:11:42.96,0:11:46.36,Main,Perona,0,0,0,,Pekâlâ, seni Moria-sama'ya götürme vaktim geldi.Dialogue: 0,0:11:46.36,0:11:47.67,Thoughts,Usopp,0,0,0,,İşte bu!Dialogue: 0,0:11:47.67,0:11:49.35,Thoughts,Usopp,0,0,0,,Çözdüm!Dialogue: 0,0:11:49.35,0:11:54.31,Thoughts,Usopp,0,0,0,,Yakınlarda şüpheli bir yer var mı?Dialogue: 0,0:11:54.31,0:11:57.68,Thoughts,Usopp,0,0,0,,Gizli bir oda gibi.Dialogue: 0,0:11:57.68,0:12:01.07,Main,Usopp,0,0,0,,Numaran!Dialogue: 0,0:12:02.34,0:12:04.44,Main,Perona,0,0,0,,O da ne? Son sözlerin mi?Dialogue: 0,0:12:07.58,0:12:08.76,Main,Perona,0,0,0,,Dur!Dialogue: 0,0:12:08.76,0:12:09.91,Main,Perona,0,0,0,,Nereye nişan alıyorsun?!Dialogue: 0,0:12:12.76,0:12:13.89,Main,Usopp,0,0,0,,İşte bu!Dialogue: 0,0:12:13.89,0:12:14.88,Main,Perona,0,0,0,,Hey, dur!Dialogue: 0,0:12:14.88,0:12:17.49,Main,Usopp,0,0,0,,Kesin Öldürücü Atlas Meteoru!Dialogue: 0,0:12:26.62,0:12:28.60,Main,Usopp,0,0,0,,Buldum!Dialogue: 0,0:12:31.91,0:12:35.48,Main,Usopp,0,0,0,,O senin gerçek bedenin!Dialogue: 0,0:12:39.71,0:12:42.33,Main,Usopp,0,0,0,,Uçabiliyorsan,...Dialogue: 0,0:12:42.33,0:12:44.56,Main,Usopp,0,0,0,,...insanların ve duvarların içinden geçebiliyorsan,...Dialogue: 0,0:12:44.56,0:12:47.28,Main,Usopp,0,0,0,,...istediğin gibi büyüyüp küçülebiliyorsan,...Dialogue: 0,0:12:47.61,0:12:51.58,Main,Usopp,0,0,0,,...bu, bedeninin hayalet olduğu anlamına gelir!Dialogue: 0,0:12:51.58,0:12:56.94,Main,Usopp,0,0,0,,Ama benden kaçış şekline bakarak konuşursak,...Dialogue: 0,0:12:57.68,0:13:00.17,Flashbacks,Pelona,0,0,0,,Uzak dur!Dialogue: 0,0:13:00.17,0:13:04.63,Main,Usopp,0,0,0,,...o sırada fiziksel bedenindeydin!Dialogue: 0,0:13:04.63,0:13:05.76,Main,Pelona,0,0,0,,Sen ne-Dialogue: 0,0:13:05.76,0:13:06.84,Main,Usopp,0,0,0,,Yani!Dialogue: 0,0:13:07.41,0:13:09.08,Main,Usopp,0,0,0,,Ama karşımdaki kişi...Dialogue: 0,0:13:09.08,0:13:12.79,Main,Usopp,0,0,0,,...sadece gözlerimi senden ayırdığımda oluşturduğun bir hayalet.Dialogue: 0,0:13:12.79,0:13:15.47,Main,Usopp,0,0,0,,Bedenini orada gizledin!Dialogue: 0,0:13:15.47,0:13:16.81,Main,Usopp,0,0,0,,Artık bu gerçeği gizleyemezsin!Dialogue: 0,0:13:18.21,0:13:21.51,Main,Pelona,0,0,0,,Sadece negatif bir aptal olduğunu sanmıştım.Dialogue: 0,0:13:21.51,0:13:23.99,Main,Pelona,0,0,0,,O aptal maskeden güç mü aldın?Dialogue: 0,0:13:24.49,0:13:27.66,Main,Pelona,0,0,0,,Farketmene şaşırdım.Dialogue: 0,0:13:27.66,0:13:30.00,Main,Pelona,0,0,0,,Ama sadece %90 haklısın.Dialogue: 0,0:13:30.00,0:13:33.52,Main,Pelona,0,0,0,,Bedenimin kontrol edebildiği bir hayalet değilim.Dialogue: 0,0:13:35.14,0:13:38.02,Main,Pelona,0,0,0,,Bedenimden ruhsal formumda ayrıldım.Dialogue: 0,0:13:38.02,0:13:41.63,Main,Pelona,0,0,0,,Kendi başına düşünen ve davranan bir hayalet.Dialogue: 0,0:13:41.99,0:13:43.44,Main,Usopp,0,0,0,,Anlıyorum!Dialogue: 0,0:13:43.44,0:13:46.13,Main,Usopp,0,0,0,,O zaman dönecek bir vücudun olmadan,...Dialogue: 0,0:13:46.13,0:13:48.26,Main,Usopp,0,0,0,,...sana ne olur merak ediyorum.Dialogue: 0,0:13:48.26,0:13:52.66,Main,Usopp,0,0,0,,Eminim saldırmamamı söylerdin, değil mi?Dialogue: 0,0:13:52.66,0:13:54.77,Main,Pelona,0,0,0,,Pislik! Dur!Dialogue: 0,0:13:55.02,0:13:56.12,Main,Usopp,0,0,0,,Kesin Öldürücü...Dialogue: 0,0:13:56.12,0:13:57.58,Main,Usopp,0,0,0,,...Büyük Patlama Yıldızı!Dialogue: 0,0:14:02.60,0:14:04.38,Main,Pelona,0,0,0,,Çok yakındı.Dialogue: 0,0:14:04.38,0:14:07.13,Main,Pelona,0,0,0,,Kaçırdın, hem de patlamadı.Dialogue: 0,0:14:07.13,0:14:08.59,Main,Usopp,0,0,0,,Bir atış daha!Dialogue: 0,0:14:09.11,0:14:10.87,Main,Pelona,0,0,0,,İzin verir miyim sanki?!Dialogue: 0,0:14:11.03,0:14:12.16,Main,Pelona,0,0,0,,Özel Hayalet!Dialogue: 0,0:14:13.16,0:14:14.93,Main,Usopp,0,0,0,,Yoksa bu?!Dialogue: 0,0:14:15.54,0:14:16.58,Main,Pelona,0,0,0,,Mini Hayalet.Dialogue: 0,0:14:18.71,0:14:21.21,Main,Usopp,0,0,0,,O şeylerin fazla büyük versiyonu mu?!Dialogue: 0,0:14:23.02,0:14:24.27,Main,Usopp,0,0,0,,Durum kötü!Dialogue: 0,0:14:24.27,0:14:25.88,Main,Usopp,0,0,0,,Bırak beni, pislik!Dialogue: 0,0:14:25.88,0:14:27.41,Main,Pelona,0,0,0,,Bir süre çabala bakalım.Dialogue: 0,0:14:27.41,0:14:29.80,Main,Pelona,0,0,0,,Gerçek bedenime dokunmana izin vermeyeceğim.Dialogue: 0,0:14:29.80,0:14:31.28,Main,Usopp,0,0,0,,Hey, dur biraz!Dialogue: 0,0:14:31.28,0:14:33.62,Main,Usopp,0,0,0,,Hamur tatlısı büyüklüğündeki hayaletler zaten yeterince zarar verdi!Dialogue: 0,0:14:33.62,0:14:37.68,Main,Usopp,0,0,0,,Bu fazlasıyla büyük şey patlarsa, bedenim parçalara ayrılır!Dialogue: 0,0:14:37.68,0:14:40.20,Main,Pelona,0,0,0,,İstediğin kadar çabala, ona dokunamazsın.Dialogue: 0,0:14:40.20,0:14:41.23,Main,Pelona,0,0,0,,O bir hayalet.Dialogue: 0,0:14:52.09,0:14:52.83,Main,Usopp,0,0,0,,Bırak!Dialogue: 0,0:14:52.83,0:14:55.08,Main,Usopp,0,0,0,,Bırak beni, lanet olsun!Dialogue: 0,0:14:57.54,0:15:00.22,Main,Pelona,0,0,0,,Çok yazık, Uzun Burun.Dialogue: 0,0:15:00.22,0:15:04.25,Main,Pelona,0,0,0,,Parmaklarımı şıklattığımda bedenin parçalara ayrılacak.Dialogue: 0,0:15:04.25,0:15:05.59,Main,Pelona,0,0,0,,Kamikaze Vuruşu!Dialogue: 0,0:15:11.09,0:15:11.72,Main,Pelona,0,0,0,,Yok mu oldu?!Dialogue: 0,0:15:13.73,0:15:15.26,Main,Usopp,0,0,0,,Çok yakındı.Dialogue: 0,0:15:15.26,0:15:17.91,Main,Usopp,0,0,0,,Saldırın şimdi bu kadranın içinde!Dialogue: 0,0:15:18.35,0:15:19.41,Main,Pelona,0,0,0,,Sen ne-Dialogue: 0,0:15:20.80,0:15:21.81,Main,Pelona,0,0,0,,Kıpırdayamıyorum!Dialogue: 0,0:15:21.81,0:15:23.02,Main,Pelona,0,0,0,,Bu da ne?!Dialogue: 0,0:15:23.02,0:15:27.26,Main,Usopp,0,0,0,,Sana attığım Büyük Patlama Yıldızı yalandı!Dialogue: 0,0:15:27.26,0:15:28.93,Main,Usopp,0,0,0,,Iskalamamıştım.Dialogue: 0,0:15:28.93,0:15:30.99,Main,Usopp,0,0,0,,O, Yapışkan Madde Yıldızı'mdı.Dialogue: 0,0:15:31.44,0:15:34.41,Main,Usopp,0,0,0,,Böylece gerçek bedenine dönseydin bile kıpırdayamazdın.Dialogue: 0,0:15:34.80,0:15:36.19,Main,Pelona,0,0,0,,Ne dedin?!Dialogue: 0,0:15:36.19,0:15:39.56,Main,Usopp,0,0,0,,Şimdi bedenini ve hayaletini birlikte halledebilirim!Dialogue: 0,0:15:39.56,0:15:41.04,Main,Pelona,0,0,0,,Kahretsin!Dialogue: 0,0:15:41.49,0:15:45.15,Main,Pelona,0,0,0,,Komutan Ayıcık'ı arındıran fare sen misin?!Dialogue: 0,0:15:45.15,0:15:46.56,Main,Pelona,0,0,0,,Tam zamanında!Dialogue: 0,0:15:46.56,0:15:49.28,Main,Pelona,0,0,0,,Hakla onu, yardımcı kaptan Soylu Gergedan!Dialogue: 0,0:15:48.65,0:15:50.05,Main,Usopp,0,0,0,,Darbe!Dialogue: 0,0:15:54.34,0:15:57.16,Thoughts,Pelona,0,0,0,,Bu adam gerçekten o kadar güçlü mü?!Dialogue: 0,0:15:57.63,0:15:59.71,Thoughts,Usopp,0,0,0,,Acıyor!Dialogue: 0,0:15:59.71,0:16:02.87,Thoughts,Usopp,0,0,0,,Kolumu kaybedeceğim!Dialogue: 0,0:16:03.92,0:16:06.25,Main,Pelona,0,0,0,,Soylu Gergedan!Dialogue: 0,0:16:07.27,0:16:09.03,Main,Usopp,0,0,0,,Kesin Öldürücü...Dialogue: 0,0:16:09.03,0:16:10.99,Main,Usopp,0,0,0,,...Siyah Parıltılı Yıldız!Dialogue: 0,0:16:19.90,0:16:22.17,Main,Pelona,0,0,0,,Hamamböcekleri!Dialogue: 0,0:16:22.17,0:16:23.64,Main,Usopp,0,0,0,,Hamamböceği Yıldızı da denir.Dialogue: 0,0:16:23.64,0:16:25.29,Main,Pelona,0,0,0,,İğrenç!Dialogue: 0,0:16:27.00,0:16:28.38,Main,Pelona,0,0,0,,Biri çeksin şunları!Dialogue: 0,0:16:28.85,0:16:29.86,Main,Pelona,0,0,0,,Yardım edin!Dialogue: 0,0:16:29.86,0:16:33.17,Main,Pelona,0,0,0,,Kaçamıyorum!Dialogue: 0,0:16:34.95,0:16:36.34,Main,Pelona,0,0,0,,Elbiselerimin içine girdi!Dialogue: 0,0:16:36.34,0:16:37.94,Main,Pelona,0,0,0,,Hamamböceklerinden nefret ediyorum!Dialogue: 0,0:16:37.94,0:16:39.29,Main,Pelona,0,0,0,,Korkuyorum, çok korkuyorum!Dialogue: 0,0:16:39.29,0:16:40.40,Main,Pelona,0,0,0,,Ayıcık!Dialogue: 0,0:16:43.79,0:16:46.31,Main,Usopp,0,0,0,,Basit hamamböceklerinden korkma.Dialogue: 0,0:16:46.85,0:16:49.61,Main,Usopp,0,0,0,,Asıl kabusun...Dialogue: 0,0:16:49.61,0:16:51.80,Main,Usopp,0,0,0,,...benim!Dialogue: 0,0:16:52.98,0:16:56.24,Main,Usopp,0,0,0,,Beni çok fazla hafife aldın.Dialogue: 0,0:16:56.69,0:17:01.38,Main,Usopp,0,0,0,,Doğu Mavi'de, Süper Gücüm'le çok iyi tanınan biriyim!Dialogue: 0,0:17:01.38,0:17:02.70,Main,Pelona,0,0,0,,10 Ton?!Dialogue: 0,0:17:02.70,0:17:05.79,Main,Pelona,0,0,0,,H-Hey, o kadar gücü nereden buluyorsun?Dialogue: 0,0:17:05.79,0:17:07.57,Main,Pelona,0,0,0,,D-Dur!Dialogue: 0,0:17:07.57,0:17:09.34,Main,Pelona,0,0,0,,Ondan sağ çıkabilmem mümkün değil!Dialogue: 0,0:17:12.80,0:17:15.53,Main,Pelona,0,0,0,,Bu beni öldürürdü, hey!Dialogue: 0,0:17:15.53,0:17:17.38,Main,Pelona,0,0,0,,Hamamböceklerini çek!Dialogue: 0,0:17:17.38,0:17:18.48,Main,Pelona,0,0,0,,Balyozu da çek!Dialogue: 0,0:17:18.48,0:17:20.14,Main,Pelona,0,0,0,,Hamamböceklerini ve balyozu çek lütfen!Dialogue: 0,0:17:22.67,0:17:25.85,Main,Usopp,0,0,0,,UsDialogue: 0,0:17:23.17,0:17:25.85,Main,Usopp,0,0,0,,oDialogue: 0,0:17:24.97,0:17:25.85,Main,Usopp,0,0,0,,pp...Dialogue: 0,0:17:26.71,0:17:28.25,Main,Pelona,0,0,0,,Dur!Dialogue: 0,0:17:28.25,0:17:31.63,Main,Pelona,0,0,0,,Arkadaşlarına bir daha asla el sürmeyeceğim!Dialogue: 0,0:17:31.63,0:17:32.45,Main,Pelona,0,0,0,,Cidden! Cidden!Dialogue: 0,0:17:32.45,0:17:34.44,Main,Pelona,0,0,0,,Lütfen! Lütfen! Usopp-sama!Dialogue: 0,0:17:34.44,0:17:36.91,Main,Usopp,0,0,0,,Altın...Dialogue: 0,0:17:38.28,0:17:40.30,Main,Usopp,0,0,0,,...Pound!Dialogue: 0,0:17:56.30,0:17:58.32,Main,Usopp,0,0,0,,Demek Perili Köşk'ün Prensesi,...Dialogue: 0,0:18:00.97,0:18:05.52,Main,Usopp,0,0,0,,...birkaç oyuncak hamamböceği ve bir balon karşısında dayanamayıp bayılıyor.Dialogue: 0,0:18:09.13,0:18:10.90,Main,Usopp,0,0,0,,Negatiflik ve...Dialogue: 0,0:18:11.21,0:18:15.07,Main,Usopp,0,0,0,,...yalan düellosunda beni yenebileceğini düşündüysen yanıldın!Dialogue: 0,0:18:17.10,0:18:19.55,Main,Usopp,0,0,0,,Şafak vaktine kadar tatlı rüyalar!Dialogue: 0,0:18:41.43,0:18:46.13,Main,Franky,0,0,0,,O samuray bir şey demedi mi?Dialogue: 0,0:18:48.86,0:18:50.50,Main,Franky,0,0,0,,Yani...Dialogue: 0,0:18:50.50,0:18:53.26,Main,Franky,0,0,0,,...bu ne anlama geliyor?Dialogue: 0,0:18:53.26,0:18:55.32,Main,Brook,0,0,0,,Dövüşün...Dialogue: 0,0:18:55.32,0:18:58.34,Main,Brook,0,0,0,,...bittiği anlamına geliyor!Dialogue: 0,0:18:58.34,0:19:02.34,Main,Brook,0,0,0,,Hiç böyle bir dövüş görmedim!Dialogue: 0,0:19:03.46,0:19:05.12,Main,Brook,0,0,0,,O samuray...Dialogue: 0,0:19:05.12,0:19:08.75,Main,Brook,0,0,0,,...bana karşı hiç ciddi olarak dövüşmemiş!Dialogue: 0,0:19:16.44,0:19:18.30,Captions,Note,0,0,0,,5 Dakika Önce,  Hogback'in LaboratuvarıDialogue: 0,0:19:20.04,0:19:24.22,Main,Ryuuma,0,0,0,,Yani ünlü kılıcım Shuusui'yu alacak mısın?Dialogue: 0,0:19:20.04,0:19:24.21,Note,Ryuuma,0,0,0,,Shuusui: Hazan SuyuDialogue: 0,0:19:24.21,0:19:26.00,Main,Zoro,0,0,0,,Tam olarak...Dialogue: 0,0:19:26.00,0:19:30.77,Main,Zoro,0,0,0,,...cesedinin yanında uzanan kılıcı alacağım.Dialogue: 0,0:19:30.77,0:19:32.21,Main,Ryuuma,0,0,0,,Anlıyorum.Dialogue: 0,0:19:32.21,0:19:34.09,Main,Ryuuma,0,0,0,,Bu konuda kendine epey güveniyor gibisin.Dialogue: 0,0:19:35.32,0:19:38.48,Main,Brook,0,0,0,,O-Onu kışkırtma.Dialogue: 0,0:19:38.48,0:19:42.41,Main,Ryuuma,0,0,0,,Üç kılıç taşıyor gibisin.Dialogue: 0,0:19:42.41,0:19:46.09,Main,Zoro,0,0,0,,Evet ama biri kırıldı.Dialogue: 0,0:19:46.09,0:19:48.83,Main,Zoro,0,0,0,,Atmak doğru gibi gelmediğinden yanımda taşıyorum.Dialogue: 0,0:19:49.24,0:19:52.12,Main,Zoro,0,0,0,,Ben Üç Kılıç stili kullanıcısıyım.Dialogue: 0,0:19:52.12,0:19:53.79,Main,Ryuuma,0,0,0,,Üç Kılıç Stili?Dialogue: 0,0:19:53.79,0:19:55.65,Main,Ryuuma,0,0,0,,Hiç duymadım.Dialogue: 0,0:19:55.65,0:19:56.93,Main,Ryuuma,0,0,0,,Bir tür akrobasi olabilir mi?Dialogue: 0,0:19:58.73,0:20:01.86,Main,Zoro,0,0,0,,Ne yazık ki sana gösteremem.Dialogue: 0,0:20:01.86,0:20:05.60,Main,Zoro,0,0,0,,Şu burnun zaten kırılırdı.Dialogue: 0,0:20:05.60,0:20:08.94,Main,Ryuuma,0,0,0,,Muhtemelen. Epey güçlü görünüyorsun.Dialogue: 0,0:20:08.94,0:20:12.76,Main,Ryuuma,0,0,0,,Alışılmadık bir his bedenimde kaynıyor.Dialogue: 0,0:20:12.76,0:20:16.61,Main,Ryuuma,0,0,0,,Sanki koca bir hayvanla karşılaşacakmışım gibi.Dialogue: 0,0:20:17.08,0:20:20.07,Main,Ryuuma,0,0,0,,Ne tuhaf bir his.Dialogue: 0,0:20:20.45,0:20:22.78,Main,Ryuuma,0,0,0,,Çok heyecanlıyım.Dialogue: 0,0:20:25.28,0:20:26.87,Main,Brook,0,0,0,,Ödümü kopardı!Dialogue: 0,0:20:32.50,0:20:33.74,Main,Ryuuma,0,0,0,,Aubade...Dialogue: 0,0:20:32.50,0:20:33.74,Note,Note,0,0,0,,Şafak Serenatı!Dialogue: 0,0:20:33.74,0:20:35.28,Main,Ryuuma,0,0,0,,Coup Droit!Dialogue: 0,0:20:33.74,0:20:35.28,Note,Ryuma,0,0,0,,Düz Saplayış!Dialogue: 0,0:20:38.59,0:20:40.26,Main,Franky,0,0,0,,T-Tabanca?!Dialogue: 0,0:20:40.26,0:20:42.45,Main,Brook,0,0,0,,S-Saplayış!Dialogue: 0,0:20:42.45,0:20:45.47,Main,Brook,0,0,0,,Ben o tekniği kullandığımda hiç böyle bir şey olmadı!