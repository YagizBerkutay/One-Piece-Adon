Dialogue: 0,0:02:29.94,0:02:33.04,Title,,0,0,0,,{\fad(2000,0)}Zoro, Samuray Ryuma'ya Karşı \Nve Chopper'ın Öfkesi
Dialogue: 0,0:02:33.81,0:02:36.26,Main,Franky,0,0,0,,Delik açmış!
Dialogue: 0,0:02:36.26,0:02:39.93,Main,Brook,0,0,0,,Saplayışı uçurabilmek için çok güç gerekir.
Dialogue: 0,0:02:42.52,0:02:44.51,Main,Brook,0,0,0,,Berabere sanırım.
Dialogue: 0,0:02:50.85,0:02:53.65,Main,Ryuuma,0,0,0,,Beni neredeyse haklıyordun.
Dialogue: 0,0:02:53.65,0:02:57.44,Main,Franky,0,0,0,,Ne? Bu kuşaklı adam ne zaman karşı saldırı yaptı?!
Dialogue: 0,0:02:57.44,0:03:00.07,Main,Brook,0,0,0,,Neredeyse aynı anda.
Dialogue: 0,0:03:00.63,0:03:03.12,Main,Brook,0,0,0,,Onun da kesişi uçtu.
Dialogue: 0,0:03:03.12,0:03:08.36,Main,Brook,0,0,0,,O samuray zombinin hareketleri gölgem sayesinde ama...
Dialogue: 0,0:03:08.36,0:03:10.75,Main,Brook,0,0,0,,...hayattayken gerçekten sıradışı bir samuray olmalı.
Dialogue: 0,0:03:11.28,0:03:18.13,Main,Brook,0,0,0,,O ikisinin kılıç ustası olarak\Naynı tür gücü olması muhtemel.
Dialogue: 0,0:03:18.92,0:03:23.43,Main,Brook,0,0,0,,Aynı yıkıcı güce sahip oldukları anlamına geliyor.
Dialogue: 0,0:03:23.43,0:03:27.10,Main,Brook,0,0,0,,Bu dövüş fazla sürmeyecek.
Dialogue: 0,0:03:30.83,0:03:32.19,Main,Ryuuma,0,0,0,,{\fad(150,150)}Prelude...
Dialogue: 0,0:03:32.19,0:03:33.01,Main,Ryuuma,0,0,0,,{\fad(150,150)}Au Fer!
Dialogue: 0,0:03:30.83,0:03:33.01,Note,Ryuuma,0,0,0,,{\fad(150,150)}Demir Başlangıç
Dialogue: 0,0:03:33.69,0:03:34.96,Main,Zoro,0,0,0,,{\i1}Tekniği bozan silah mı?!{\i0}
Dialogue: 0,0:03:35.86,0:03:36.77,Main,Zoro,0,0,0,,{\fad(150,150)}Çift Kılıç Stili...
Dialogue: 0,0:03:37.16,0:03:37.97,Main,Zoro,0,0,0,,{\fad(150,150)}...Işık Patlaması!
Dialogue: 0,0:03:39.14,0:03:40.38,Main,Zoro,0,0,0,,{\fad(150,150)}Şeytan Ayı!
Dialogue: 0,0:03:48.79,0:03:49.53,Main,Ryuuma,0,0,0,,{\fad(150,150)}*Gavotte...
Dialogue: 0,0:03:49.90,0:03:50.76,Main,Ryuuma,0,0,0,,{\fad(150,150)}Bond Avant!
Dialogue: 0,0:03:49.90,0:03:50.76,Note,Ryuuma,0,0,0,,{\fad(150,150)}...İleri Sıçrayış!
Dialogue: 0,0:03:52.20,0:03:53.06,Main,Zoro,0,0,0,,{\fad(150,150)}Çift Kılıç Stili...
Dialogue: 0,0:03:53.67,0:03:54.28,Main,Zoro,0,0,0,,{\fad(150,150)}...Kes ve Kınına Sok!
Dialogue: 0,0:03:54.90,0:03:55.80,Main,Zoro,0,0,0,,{\fad(150,150)}Rashoumon
Dialogue: 0,0:03:54.90,0:03:55.80,Note,,0,0,0,,Sonsuz Yaşam Kapısı!
Dialogue: 0,0:03:59.03,0:04:01.34,Thoughts,Zoro,0,0,0,,Beni hakladı!
Dialogue: 0,0:04:06.58,0:04:08.56,Main,Franky,0,0,0,,Sütunlar kırılmış!
Dialogue: 0,0:04:08.56,0:04:10.63,Main,Franky,0,0,0,,D-Dur biraz! Hey!
Dialogue: 0,0:04:10.63,0:04:12.43,Main,Franky,0,0,0,,Bütün kat çökecek!
Dialogue: 0,0:04:12.43,0:04:13.52,Main,Franky,0,0,0,,Dikkat et!
Dialogue: 0,0:04:15.15,0:04:18.41,Main,Franky,0,0,0,,Sıkı tutun, buradan çıkıyoruz!
Dialogue: 0,0:04:18.41,0:04:20.17,Main,Franky,0,0,0,,Tavan çöküyor!
Dialogue: 0,0:04:20.54,0:04:22.90,Main,Zoro,0,0,0,,{\fad(150,150)}72 Poundluk Top!
Dialogue: 0,0:04:26.41,0:04:28.10,Main,Ryuuma,0,0,0,,{\fad(150,150)}*Polka Remise!
Dialogue: 0,0:04:26.41,0:04:28.10,Note,,0,0,0,,Remise: Eskrimde saldırı yenileme\NPolka: Bir dans türü.
Dialogue: 0,0:04:35.02,0:04:37.25,Main,Franky,0,0,0,,{\fad(150,150)}Sol Silahlar!
Dialogue: 0,0:04:46.64,0:04:48.34,Main,Franky,0,0,0,,Çok yakındı!
Dialogue: 0,0:04:57.92,0:04:59.86,Main,Brook,0,0,0,,Dikkat et! Düşeceksin!
Dialogue: 0,0:05:06.24,0:05:07.14,Main,Zoro,0,0,0,,Kayıyorum!
Dialogue: 0,0:05:15.25,0:05:17.92,Main,Brook,0,0,0,,Basacak yeri nasıl buluyorlar ki?
Dialogue: 0,0:05:20.25,0:05:23.60,Main,Zoro,0,0,0,,{\i1}Böyle devam ederse kılıçlarım kırılacak.{\i0}
Dialogue: 0,0:05:23.60,0:05:28.99,Main,Zoro,0,0,0,,{\i1}Bu cesedin bedeni ve yeteneği neredeyse\Nefsanevi samurayın kendisiyle aynı.{\i0}
Dialogue: 0,0:05:47.69,0:05:49.32,Main,Zoro,0,0,0,,{\fad(150,150)}Tek Kılıç Stili...
Dialogue: 0,0:05:49.32,0:05:50.46,Main,Zoro,0,0,0,,{\fad(150,150)}...Uçan Ejder!
Dialogue: 0,0:05:52.35,0:05:53.90,Main,Ryuuma,0,0,0,,{\fad(150,150)}Üç Blokluk Şarkı Mırıldanışı...
Dialogue: 0,0:05:59.90,0:06:01.05,Main,Ryuuma,0,0,0,,{\fad(150,150)}...Çentik Ok Vuruşu!
Dialogue: 0,0:06:01.75,0:06:02.90,Main,Zoro,0,0,0,,{\fad(150,150)}Alev!
Dialogue: 0,0:06:12.17,0:06:14.22,Main,Ryuuma,0,0,0,,Yara tutuştu?!
Dialogue: 0,0:06:22.00,0:06:24.11,Main,Ryuuma,0,0,0,,Yenildim.
Dialogue: 0,0:06:27.86,0:06:33.52,Main,Ryuuma,0,0,0,,Bir zamanlar efsanevi samuraya\Nhizmet eden kılıç, Shuusui.
Dialogue: 0,0:06:27.86,0:06:33.52,Note,Ryuuma,0,0,0,,Shuusui: Hazan Suyu
Dialogue: 0,0:06:33.52,0:06:39.21,Main,Ryuuma,0,0,0,,Bu kılıç emrin altında kesinlikle tatmin olacak.
Dialogue: 0,0:06:39.81,0:06:43.71,Main,Franky,0,0,0,,O samuray bir şey demedi mi?
Dialogue: 0,0:06:44.00,0:06:45.01,Main,Franky,0,0,0,,Yani...
Dialogue: 0,0:06:45.01,0:06:47.18,Main,Franky,0,0,0,,...bu ne demek oluyor?
Dialogue: 0,0:06:47.18,0:06:48.99,Main,Brook,0,0,0,,Dövüş...
Dialogue: 0,0:06:48.99,0:06:51.68,Main,Brook,0,0,0,,...bitmiş demek oluyor!
Dialogue: 0,0:06:51.68,0:06:54.62,Main,Brook,0,0,0,,Hiç böyle bir dövüş görmedim!
Dialogue: 0,0:06:55.26,0:06:57.40,Main,Brook,0,0,0,,O samuray...
Dialogue: 0,0:06:57.40,0:07:02.27,Main,Brook,0,0,0,,...bana karşı hiç ciddi olarak dövüşmemiş!
Dialogue: 0,0:07:02.27,0:07:05.75,Main,Brook,0,0,0,,Mükemmel bir maçtı.
Dialogue: 0,0:07:13.62,0:07:17.03,Main,Ryuuma,0,0,0,,Bu samuray bedenine...
Dialogue: 0,0:07:17.03,0:07:21.50,Main,Ryuuma,0,0,0,,...tam bir yenilgi verdiğim için üzgünüm.
Dialogue: 0,0:07:21.50,0:07:24.24,Main,Zoro,0,0,0,,Utanç hissetmen yeterli.
Dialogue: 0,0:07:24.24,0:07:27.56,Main,Zoro,0,0,0,,Bedeni ve ruhu gerçek bir\Nkılıç ustası yapan şey budur.
Dialogue: 0,0:07:27.56,0:07:30.26,Main,Zoro,0,0,0,,Seninle hayattayken karşılaşabilmeyi isterdim.
Dialogue: 0,0:07:37.85,0:07:38.68,Main,Franky,0,0,0,,B-Bu...
Dialogue: 0,0:07:38.68,0:07:39.87,Main,Brook,0,0,0,,Döndü!
Dialogue: 0,0:07:39.87,0:07:44.02,Main,Brook,0,0,0,,Beş yılın ardından gölgem nihayet döndü!
Dialogue: 0,0:07:44.02,0:07:46.43,Main,Zoro,0,0,0,,Kılıcı alacağım ama...
Dialogue: 0,0:07:46.43,0:07:49.34,Main,Zoro,0,0,0,,...bu dövüş hiç olmamış gibi davranalım.
Dialogue: 0,0:07:49.34,0:07:51.70,Main,Zoro,0,0,0,,Wano Ülkesi'nin samurayı.
Dialogue: 0,0:07:56.90,0:08:01.66,Main,Hogback,0,0,0,,Kendi arkadaşlarınız tarafından\Nyakalanmak nasıl bir duygu?
Dialogue: 0,0:08:02.40,0:08:06.13,Main,Jigoro,0,0,0,,Şu tuhaf yeteneğinle bana tuz yedirmeyi başaramadın!
Dialogue: 0,0:08:06.82,0:08:07.84,Thoughts,Robin,0,0,0,,{\i1}Güçlü!{\i0}
Dialogue: 0,0:08:08.49,0:08:12.46,Main,Chopper,0,0,0,,Kahretsin! Sanji'nin Robin'i\Ntekmeleyeceğini hiç düşünmemiştim!
Dialogue: 0,0:08:12.46,0:08:14.82,Main,Chopper,0,0,0,,Bu yaratık artık Sanji değil!
Dialogue: 0,0:08:14.82,0:08:17.42,Main,Dog-Penguin,0,0,0,,Şu Sanji kim?
Dialogue: 0,0:08:17.42,0:08:19.26,Main,Dog-Penguin,0,0,0,,Seni öldüreceğim, kahrolası pislik.
Dialogue: 0,0:08:21.76,0:08:26.52,Main,Hogback,0,0,0,,Ne yazık ki artık arkadaşlarınızın\Nanılarına sahip değiller!
Dialogue: 0,0:08:26.52,0:08:30.95,Main,Hogback,0,0,0,,Yeni zombilerin eski\Nbenliklerinden kırıntıları olabilir...
Dialogue: 0,0:08:30.95,0:08:34.70,Main,Hogback,0,0,0,,...ama beden ve gölge tamamiyle birleştiği için,...
Dialogue: 0,0:08:34.70,0:08:37.03,Main,Hogback,0,0,0,,...insanlıkları kendi yararlarına gitti.
Dialogue: 0,0:08:37.03,0:08:40.51,Main,Hogback,0,0,0,,Onlar artık benim sadık zombilerim!
Dialogue: 0,0:08:40.51,0:08:44.22,Main,Hogback,0,0,0,,Bir zombi için emirler kesindir!
Dialogue: 0,0:08:46.72,0:08:51.02,Main,Chopper,0,0,0,,Bu kadar alçalmış olmana\Nneredeyse sevindim, Hogback!
Dialogue: 0,0:08:52.67,0:08:58.87,Main,Chopper,0,0,0,,Bir zamanlar sayısız insanın hayatını kurtardın, bu yüzden bir doktor olarak sana derin hayranlık duydum.
Dialogue: 0,0:08:58.87,0:09:01.52,Main,Chopper,0,0,0,,Zombi araştırmana bile.
Dialogue: 0,0:09:01.52,0:09:02.72,Main,Chopper,0,0,0,,Ölüm...
Dialogue: 0,0:09:02.72,0:09:04.69,Main,Chopper,0,0,0,,...uyarmadan gelir.
Dialogue: 0,0:09:05.13,0:09:11.89,Main,Chopper,0,0,0,,Bu yüzden yollarını ayırmadan önce, ölüyle geride\Nkalanlar arasında söylenmedik bir sürü söz kalır.
Dialogue: 0,0:09:11.89,0:09:13.60,Main,Chopper,0,0,0,,Yıllar değil,...
Dialogue: 0,0:09:13.60,0:09:15.49,Main,Chopper,0,0,0,,...sadece birkaç dakika yeterli olurdu!
Dialogue: 0,0:09:15.49,0:09:19.55,Main,Chopper,0,0,0,,Ölüyü kısa bir an için olsun geri getirme yolu olsaydı,...
Dialogue: 0,0:09:19.55,0:09:23.49,Main,Chopper,0,0,0,,...kötü ve doktrinlere aykırı bir çalışma olsa bile,...
Dialogue: 0,0:09:24.20,0:09:27.04,Main,Chopper,0,0,0,,...geri getirilenler tarafından fazlasıyla takdir edilirdi!
Dialogue: 0,0:09:30.49,0:09:35.34,Main,Chopper,0,0,0,,Bu yüzden ölüleri canlandırmaktan\Nbahsettiğinde, sözlerinin gerçek bir doktora...
Dialogue: 0,0:09:35.99,0:09:38.14,Main,Chopper,0,0,0,,...layık olduğunu düşünmüştüm!
Dialogue: 0,0:09:41.87,0:09:44.68,Main,Hogback,0,0,0,,Ahmak! Yabancılar için niye bunu yapayım?!
Dialogue: 0,0:09:45.77,0:09:49.69,Main,Hogback,0,0,0,,Bana hayran olduğun aynı nedenden\Nötürü yardımımı istediler.
Dialogue: 0,0:09:51.00,0:09:53.00,Main,Hogback,0,0,0,,Çünkü ben dahiydim!
Dialogue: 0,0:09:53.70,0:09:56.19,Main,Hogback,0,0,0,,Her şey para içindi!
Dialogue: 0,0:09:56.19,0:10:01.43,Main,Hogback,0,0,0,,Sürekli olarak dünyanın her yerinden\Ngelen hastalara yardım etmek istemedim!
Dialogue: 0,0:10:02.16,0:10:03.45,Main,Hogback,0,0,0,,"Lütfen babama yardım edin!"
Dialogue: 0,0:10:03.45,0:10:04.77,Main,Hogback,0,0,0,,"Çocuğumu kurtarın!"
Dialogue: 0,0:10:04.77,0:10:06.32,Main,Hogback,0,0,0,,"Erkek arkadaşıma yardım edin!"
Dialogue: 0,0:10:06.32,0:10:09.37,Main,Hogback,0,0,0,,Ne büyük bir baş belası!
Dialogue: 0,0:10:09.90,0:10:11.34,Main,Hogback,0,0,0,,Can sıkıcı.
Dialogue: 0,0:10:12.27,0:10:16.38,Main,Hogback,0,0,0,,Tek bir canı bile kurtaramayan zavallı doktorların\Nbeceriksizliğinin bedelini ödemek zorunda kaldım.
Dialogue: 0,0:10:17.22,0:10:19.93,Main,Hogback,0,0,0,,Böyle bir deha olmanın sıkıntısını anlayabiliyor musun?!
Dialogue: 0,0:10:20.70,0:10:23.78,Main,Hogback,0,0,0,,Bana saygı duyup duymaman sana kalmış.
Dialogue: 0,0:10:23.78,0:10:26.15,Main,Hogback,0,0,0,,Ama seni hayalkırıklığına uğratmış olmam saçma.
Dialogue: 0,0:10:26.15,0:10:30.17,Main,Hogback,0,0,0,,Saçma ideallerin yüzünden bir doktor\Nolarak bana dayanamıyorsan,...
Dialogue: 0,0:10:30.42,0:10:33.47,Main,Hogback,0,0,0,,...kendini kandırıyorsun demektir, aptal rengeyiği!
Dialogue: 0,0:10:33.47,0:10:36.71,Main,Hogback,0,0,0,,Bir doktorun nasıl olacağını bana söylemek mi istiyorsun?!
Dialogue: 0,0:10:36.71,0:10:38.97,Main,Chopper,0,0,0,,Sana hiçbir şey söylemek niyetinde değilim!
Dialogue: 0,0:10:38.97,0:10:41.95,Main,Chopper,0,0,0,,Artık seni doktor olarak görmüyorum!
Dialogue: 0,0:10:43.44,0:10:45.62,Main,Chopper,0,0,0,,Aynısı zombiler için de geçerli!
Dialogue: 0,0:10:46.15,0:10:48.91,Main,Chopper,0,0,0,,Sadece senin isteğine göre hareket\Neden boş kabuklardan ibaretler!
Dialogue: 0,0:10:48.91,0:10:50.62,Main,Chopper,0,0,0,,Onlar canlı değil!
Dialogue: 0,0:10:51.15,0:10:53.00,Main,Chopper,0,0,0,,Hayatla oynama!
Dialogue: 0,0:10:54.56,0:10:56.72,Main,Hogback,0,0,0,,Ne acımasız bir ifade.
Dialogue: 0,0:10:56.72,0:11:00.45,Main,Hogback,0,0,0,,Gözlerinin önünde hareket ettiklerini görmene\Nrağmen, canlılıklarını ret mi ediyorsun?!
Dialogue: 0,0:11:00.59,0:11:05.06,Main,Hogback,0,0,0,,Ölüye yeni yaşam bahşetmek bir mucizedir!
Dialogue: 0,0:11:06.18,0:11:08.93,Main,Hogback,0,0,0,,Bunun varlığını reddetmen nasıl mümkün olabilir?!
Dialogue: 0,0:11:09.22,0:11:10.09,Main,Hogback,0,0,0,,Bak!
Dialogue: 0,0:11:17.40,0:11:20.40,Main,Hogback,0,0,0,,Şimdi yeri yala, Cindry.
Dialogue: 0,0:11:21.40,0:11:23.70,Main,Hogback,0,0,0,,Peki, Hogback-sama.
Dialogue: 0,0:11:28.63,0:11:32.10,Main,Hogback,0,0,0,,O odayı gördün, değil mi, Dr. Chopper?
Dialogue: 0,0:11:34.44,0:11:35.94,Main,Hogback,0,0,0,,Orası benim odam.
Dialogue: 0,0:11:36.75,0:11:41.55,Main,Hogback,0,0,0,,O resimler, sahne aktrisi Victoria\NCindry'nin hayattaykenki resimleriydi.
Dialogue: 0,0:11:41.55,0:11:45.26,Main,Hogback,0,0,0,,Ona tamamen aşık oldum.
Dialogue: 0,0:11:45.26,0:11:50.67,Main,Hogback,0,0,0,,Sadece ben değil, ülkedeki bütün\Nerkekler öyle bir güzelliğe aşıktı.
Dialogue: 0,0:11:54.02,0:11:55.77,Flashbacks,Cindry,0,0,0,,Diktim, Doctor.
Dialogue: 0,0:11:55.77,0:12:00.09,Flashbacks,Hogback,0,0,0,,Ü-Üzgünüm, sadece düğmemi diktirmek\Niçin hastamı rahatsız etmek istememiştim!
Dialogue: 0,0:12:02.00,0:12:03.17,Flashbacks,Cindry,0,0,0,,Sorun değil!
Dialogue: 0,0:12:07.83,0:12:10.13,Main,Hogback,0,0,0,,Çok popüler ama alçakgönüllü.
Dialogue: 0,0:12:10.13,0:12:11.62,Main,Hogback,0,0,0,,Kendisini ailesine adamış,...
Dialogue: 0,0:12:16.33,0:12:20.21,Main,Hogback,0,0,0,,...herkese karşı iyi, gerçekten mükemmel bir kadın.
Dialogue: 0,0:12:20.21,0:12:22.22,Main,Hogback,0,0,0,,Ama o...
Dialogue: 0,0:12:32.18,0:12:37.00,Main,Hogback,0,0,0,,...evlenme teklifimi reddetti,\Nher şeyi olan doktorun teklifini.
Dialogue: 0,0:12:37.00,0:12:39.19,Main,Hogback,0,0,0,,Hepsi lanet olası nişanlısı yüzünden!
Dialogue: 0,0:12:39.19,0:12:40.48,Main,Hogback,0,0,0,,Sonra...
Dialogue: 0,0:12:40.48,0:12:44.61,Main,Hogback,0,0,0,,...kulaklarıma inanılmaz haberler ulaştı.
Dialogue: 0,0:12:45.04,0:12:47.63,Main,Hogback,0,0,0,,Cindry, bir kazada ölmüştü.
Dialogue: 0,0:12:49.51,0:12:52.54,Main,Hogback,0,0,0,,Acım anlatılamazdı.
Dialogue: 0,0:12:52.54,0:12:55.36,Main,Hogback,0,0,0,,İşimi terkettim.
Dialogue: 0,0:12:55.36,0:12:59.63,Main,Hogback,0,0,0,,O sırada karşıma şu koca adam çıktı.
Dialogue: 0,0:13:00.04,0:13:03.21,Main,Hogback,0,0,0,,Efendim, Gecko Moria!
Dialogue: 0,0:13:04.03,0:13:07.41,Flashbacks,Hogback,0,0,0,,"Dr. Hogback, bana gücünü ödünç ver!"
Dialogue: 0,0:13:08.55,0:13:18.06,Main,Hogback,0,0,0,,Mucizevi yeteneğiyle Cindry'yi yeniden\Ndiriltmesi karşılığında bu gemide kalacaktım.
Dialogue: 0,0:13:18.80,0:13:20.94,Main,Hogback,0,0,0,,Bedenini çaldım.
Dialogue: 0,0:13:21.24,0:13:25.40,Main,Hogback,0,0,0,,Böyle yaparak aktris Cindry\Nüzerinde kolaylıkla kontrol sağladım!
Dialogue: 0,0:13:27.80,0:13:29.22,Main,Hogback,0,0,0,,Cindry-chan!
Dialogue: 0,0:13:32.08,0:13:34.44,Main,Cindry,0,0,0,,Tüm tabaklar yok olsaydı iyi olurdu.
Dialogue: 0,0:13:35.90,0:13:40.25,Main,Hogback,0,0,0,,Bedenindeki kadının kim olduğunu umursamadım.
Dialogue: 0,0:13:40.25,0:13:42.61,Main,Hogback,0,0,0,,Güzelliği olduğu sürece.
Dialogue: 0,0:13:43.80,0:13:46.17,Main,Hogback,0,0,0,,O, Cindry-chan'ın zombisi!
Dialogue: 0,0:13:46.96,0:13:50.01,Main,Hogback,0,0,0,,Neşe doluyum, o da öyle.
Dialogue: 0,0:13:50.42,0:13:54.60,Main,Hogback,0,0,0,,Bu dünyada insan olarak yaşaması\Niçin ikinci bir fırsat bahşettim!
Dialogue: 0,0:14:02.41,0:14:04.82,Main,Chopper,0,0,0,,Buna nasıl insan diyebilirsin?!
Dialogue: 0,0:14:05.42,0:14:07.65,Main,Chopper,0,0,0,,Durdur onu!
Dialogue: 0,0:14:09.10,0:14:13.54,Main,Chopper,0,0,0,,Kalbiyle bedeni arasında bağlantı\Nolmayan kişiye insan denemez!
Dialogue: 0,0:14:13.54,0:14:16.08,Main,Chopper,0,0,0,,Ruhsuz bedenler kullanıyorsan,...
Dialogue: 0,0:14:16.08,0:14:19.10,Main,Chopper,0,0,0,,...sadece canavar yapıyorsun demektir!
Dialogue: 0,0:14:19.10,0:14:21.42,Main,Chopper,0,0,0,,O zombileri yaparak insanları üzüyorsun!
Dialogue: 0,0:14:22.08,0:14:25.80,Main,Chopper,0,0,0,,Artık farkında olduğuma göre,\Nbunu yanına bırakmayacağım!
Dialogue: 0,0:14:25.80,0:14:30.60,Main,Hogback,0,0,0,,Sınırlı tıbbi yeteneklerinle bana\N"hayat" tan bahsetme, korsan geyik!
Dialogue: 0,0:14:30.60,0:14:33.31,Main,Hogback,0,0,0,,Cindry-chan, kurtul onlardan!
Dialogue: 0,0:14:36.93,0:14:38.89,Main,Hogback,0,0,0,,İkinizi de kuklaya çevireceğim!
Dialogue: 0,0:14:39.47,0:14:41.60,Main,Hogback,0,0,0,,Minnettar olmalısın, Dr. Chopper.
Dialogue: 0,0:14:41.60,0:14:47.57,Main,Hogback,0,0,0,,Öldüğün zaman, hayranı olduğun\Ndoktorun asistanı olacaksın!
Dialogue: 0,0:14:47.80,0:14:49.45,Main,Cindry,0,0,0,,{\fad(150,150)}Köşeli Tabak.
Dialogue: 0,0:14:52.85,0:14:53.51,Main,Cindry,0,0,0,,{\fad(150,150)}Bir!
Dialogue: 0,0:14:53.95,0:14:54.45,Main,Cindry,0,0,0,,{\fad(150,150)}İki!
Dialogue: 0,0:14:54.53,0:14:55.07,Main,Cindry,0,0,0,,{\fad(150,150)}Üç!
Dialogue: 0,0:14:57.83,0:14:59.37,Main,Chopper,0,0,0,,Dur.
Dialogue: 0,0:15:00.03,0:15:00.62,Main,Cindry,0,0,0,,Sen!
Dialogue: 0,0:15:03.40,0:15:05.13,Main,Robin,0,0,0,,Chopper!
Dialogue: 0,0:15:10.96,0:15:13.38,Main,Hogback,0,0,0,,Sırf kadın olduğu için onu küçük görme!
Dialogue: 0,0:15:13.38,0:15:16.60,Main,Hogback,0,0,0,,Dövüş için gücünü arttırdım!
Dialogue: 0,0:15:16.60,0:15:19.75,Main,Chopper,0,0,0,,Onu dinlemek zorunda değilsin!
Dialogue: 0,0:15:21.14,0:15:22.90,Main,Cindry,0,0,0,,Seni öldüreceğim!
Dialogue: 0,0:15:26.99,0:15:30.52,Main,Chopper,0,0,0,,Senin için üzülüyorum, zaten ölmüşsün.
Dialogue: 0,0:15:30.52,0:15:33.43,Main,Chopper,0,0,0,,Bunu bilseydi, ailenin kalanı neler hissederdi?!
Dialogue: 0,0:15:33.89,0:15:35.87,Main,Cindry,0,0,0,,Bırak beni!
Dialogue: 0,0:15:35.87,0:15:40.34,Main,Chopper,0,0,0,,Yamalarla kaplı, sadece akılsız bir asker olmuşsun.
Dialogue: 0,0:15:40.34,0:15:41.62,Main,Chopper,0,0,0,,Akrabaların seni böyle görmeye dayanamazdı.
Dialogue: 0,0:15:41.62,0:15:43.38,Main,Cindry,0,0,0,,Bırak beni!
Dialogue: 0,0:15:44.02,0:15:48.55,Main,Chopper,0,0,0,,Doğarkenki kalbin şu anda ölü.
Dialogue: 0,0:15:48.55,0:15:51.77,Main,Chopper,0,0,0,,Bedenin başkalarının isteği\Ndoğrultusunda hareket ediyor.
Dialogue: 0,0:15:51.77,0:15:53.18,Main,Chopper,0,0,0,,Bu nasıl bir yaşam?!
Dialogue: 0,0:15:53.63,0:15:55.44,Main,Hogback,0,0,0,,Gözlerine inanamıyor musun?!
Dialogue: 0,0:15:55.44,0:16:00.06,Main,Hogback,0,0,0,,Kabullen! Bu, insanların\Nölümsüz hayali, ölülerin dirilişi!
Dialogue: 0,0:16:00.06,0:16:01.90,Main,Hogback,0,0,0,,Ölüler diriltildi!
Dialogue: 0,0:16:01.90,0:16:04.06,Main,Chopper,0,0,0,,Yani hareket edebilmeleri yeterli mi?!
Dialogue: 0,0:16:05.06,0:16:07.84,Main,Chopper,0,0,0,,İnsanların bundan daha fazla özgürlüğü var!
Dialogue: 0,0:16:07.84,0:16:12.08,Main,Chopper,0,0,0,,Onlara insan olarak bile davranmıyorsun!
Dialogue: 0,0:16:14.95,0:16:16.87,Main,Chopper,0,0,0,,Robin! Hemen ona tuz ver!
Dialogue: 0,0:16:20.81,0:16:21.45,Main,Hogback,0,0,0,,Köpek penguen!
Dialogue: 0,0:16:21.45,0:16:22.24,Main,Hogback,0,0,0,,Jigoro!
Dialogue: 0,0:16:22.24,0:16:23.81,Main,Hogback,0,0,0,,Cindry'ye yardım edin!
Dialogue: 0,0:16:23.81,0:16:25.81,Main,Hogback,0,0,0,,Baş belasından kurtulun!
Dialogue: 0,0:16:29.88,0:16:30.96,Main,Robin,0,0,0,,Başaramadım!
Dialogue: 0,0:16:30.96,0:16:31.90,Main,Robin,0,0,0,,Chopper!
Dialogue: 0,0:16:32.39,0:16:33.82,Main,Jigoro,0,0,0,,{\fad(150,150)}Üç Kılıç Stili...
Dialogue: 0,0:16:34.83,0:16:36.42,Main,Jigoro,0,0,0,,{\fad(150,150)}...108...
Dialogue: 0,0:16:38.44,0:16:40.65,Main,Jigoro,0,0,0,,{\fad(150,150)}...Poundluk Top!
Dialogue: 0,0:16:43.13,0:16:44.35,Main,Chopper,0,0,0,,Kes şunu, Zoro!
Dialogue: 0,0:16:45.04,0:16:46.35,Main,Robin,0,0,0,,{\fad(150,150)}Doce Fleur!
Dialogue: 0,0:16:45.04,0:16:46.35,Note,Robin,0,0,0,,{\fad(150,150)}Bir Düzine Çiçek!
Dialogue: 0,0:16:50.98,0:16:52.40,Main,Jigoro,0,0,0,,Baş belası...
Dialogue: 0,0:16:52.40,0:16:53.35,Main,Jigoro,0,0,0,,Yok ol!
Dialogue: 0,0:16:58.43,0:17:00.87,Main,Dog-Penguin,0,0,0,,Niye bana da saldırdın?!
Dialogue: 0,0:17:01.54,0:17:04.62,Main,Dog-Penguin,0,0,0,,Yoluma çıkma!
Dialogue: 0,0:17:07.65,0:17:09.46,Main,Jigoro,0,0,0,,Şimdi beni kızdırdın işte!
Dialogue: 0,0:17:09.46,0:17:10.59,Main,Dog-Penguin,0,0,0,,Bunu benim demem lazım!
Dialogue: 0,0:17:10.59,0:17:12.21,Main,Dog-Penguin,0,0,0,,Emir bana verildi!
Dialogue: 0,0:17:13.88,0:17:15.38,Main,Jigoro,0,0,0,,Bana!
Dialogue: 0,0:17:17.17,0:17:19.60,Main,Hogback,0,0,0,,Ne yapıyorsunuz?!
Dialogue: 0,0:17:20.42,0:17:22.18,Main,Hogback,0,0,0,,Kesin şunu artık!
Dialogue: 0,0:17:22.18,0:17:23.27,Main,Hogback,0,0,0,,İşbirliği yapıyor olma-
Dialogue: 0,0:17:23.27,0:17:24.17,Main,Chopper,0,0,0,,Robin!
Dialogue: 0,0:17:25.57,0:17:27.40,Main,Robin,0,0,0,,Eğlendirici bir olay, sence de öyle değil mi?
Dialogue: 0,0:17:27.40,0:17:31.40,Main,Robin,0,0,0,,Hepsi baş belalarından kurtulmak\Niçin verdiğin emir yüzünden.
Dialogue: 0,0:17:32.20,0:17:33.89,Main,Chopper,0,0,0,,Anıları silinmiş olsa bile,...
Dialogue: 0,0:17:33.89,0:17:37.70,Main,Chopper,0,0,0,,...o ikisinin doğası her zaman çatışma\Niçinde olacakmış gibi görünüyor.
Dialogue: 0,0:17:37.70,0:17:38.97,Main,Robin,0,0,0,,Şok oldum.
Dialogue: 0,0:17:41.77,0:17:43.74,Main,Robin,0,0,0,,Burası uzun bir kuleye benziyor.
Dialogue: 0,0:17:44.78,0:17:49.00,Main,Robin,0,0,0,,Niye kuleden atlamamızı söylemeyi denemiyorsun?
Dialogue: 0,0:17:49.00,0:17:51.34,Main,Hogback,0,0,0,,Ne ima ediyorsun?!
Dialogue: 0,0:17:51.81,0:17:54.42,Main,Hogback,0,0,0,,Tam olarak söyleyeceğim bu!
Dialogue: 0,0:17:55.59,0:17:56.59,Main,Hogback,0,0,0,,Atlayın! Atlayın!
Dialogue: 0,0:17:56.59,0:17:59.97,Main,Hogback,0,0,0,,İkiniz kuleden atlayın!
Dialogue: 0,0:18:02.00,0:18:03.01,Main,Both,0,0,0,,Tamam.
Dialogue: 0,0:18:04.30,0:18:06.06,Main,Hogback,0,0,0,,H-Hayır, durun!
Dialogue: 0,0:18:17.06,0:18:18.76,Main,Robin,0,0,0,,Atlamamayı tercih ederiz.
Dialogue: 0,0:18:21.51,0:18:23.79,Main,Hogback,0,0,0,,Bu affedilemez!
Dialogue: 0,0:18:23.79,0:18:24.93,Main,Hogback,0,0,0,,Beni kandırdınız!
Dialogue: 0,0:18:24.93,0:18:25.90,Main,Hogback,0,0,0,,Çok kötüsünüz!
Dialogue: 0,0:18:25.90,0:18:28.41,Main,Hogback,0,0,0,,İnsan değilsiniz!
Dialogue: 0,0:18:28.41,0:18:33.09,Main,Chopper,0,0,0,,Luffy, Moria'yı devirdiğinde\Ntüm zombiler arındırılmış olacak.
Dialogue: 0,0:18:33.09,0:18:36.45,Main,Chopper,0,0,0,,Seni yumruklamak istiyorum, Hogback!
Dialogue: 0,0:18:36.45,0:18:37.26,Main,Hogback,0,0,0,,C-Cindry!
Dialogue: 0,0:18:37.26,0:18:38.75,Main,Hogback,0,0,0,,Bana biraz zaman kazandır!
Dialogue: 0,0:18:38.75,0:18:40.43,Main,Hogback,0,0,0,,Buradan çıkıyorum!
Dialogue: 0,0:18:41.05,0:18:42.32,Main,Hogback,0,0,0,,Niye cevap vermiyorsun?!
Dialogue: 0,0:18:42.32,0:18:44.26,Main,Hogback,0,0,0,,Yenilirsen sana başka bir gölge vereceğim!
Dialogue: 0,0:18:44.26,0:18:45.90,Main,Hogback,0,0,0,,Ölmeyi dert etme!
Dialogue: 0,0:18:49.67,0:18:50.88,Main,Cindry,0,0,0,,Bedenim...
Dialogue: 0,0:18:52.17,0:18:53.40,Main,Cindry,0,0,0,,...kıpırdamıyor.
Dialogue: 0,0:18:54.13,0:18:55.78,Main,Hogback,0,0,0,,C-Cindry!
