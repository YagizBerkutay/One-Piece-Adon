Dialogue: 0,0:02:29.83,0:02:38.59,Title,,0,0,0,,{\fad(2000,2000)}Çalınan Hayal! Sanji, Absalom'a Karşı
Dialogue: 0,0:02:42.03,0:02:43.79,Main,Luffy,0,0,0,,N-Neler oluyor?
Dialogue: 0,0:02:43.79,0:02:45.72,Main,Luffy,0,0,0,,Müthiş bir sarsıntı!
Dialogue: 0,0:02:46.77,0:02:51.78,Main,Moriah,0,0,0,,Gemi tuhaf bir akıntıya yakalanmış olabilir.
Dialogue: 0,0:02:51.78,0:02:55.37,Main,Moriah,0,0,0,,Muhtemelen senin hatan.
Dialogue: 0,0:02:59.22,0:03:02.84,Main,Moria,0,0,0,,Peki burada ne işin var?
Dialogue: 0,0:03:02.84,0:03:04.70,Main,Moria,0,0,0,,Niye geldin?
Dialogue: 0,0:03:04.70,0:03:09.66,Main,Luffy,0,0,0,,Evet, bir süre önce gölgemi kopardın.
Dialogue: 0,0:03:11.02,0:03:13.09,Main,Luffy,0,0,0,,Onu geri istiyorum.
Dialogue: 0,0:03:13.09,0:03:14.02,Main,Luffy,0,0,0,,Zoro'nun,...
Dialogue: 0,0:03:14.02,0:03:15.10,Main,Luffy,0,0,0,,...Sanji'nin,...
Dialogue: 0,0:03:15.10,0:03:15.86,Main,Luffy,0,0,0,,...Brook'un,...
Dialogue: 0,0:03:15.86,0:03:17.32,Main,Luffy,0,0,0,,...ve zombi amcanınkini!
Dialogue: 0,0:03:17.32,0:03:18.42,Main,Luffy,0,0,0,,Hepsini!
Dialogue: 0,0:03:19.44,0:03:21.95,Main,Moriah,0,0,0,,Epey açgözlü bir adam.
Dialogue: 0,0:03:21.95,0:03:24.12,Main,Moriah,0,0,0,,Ne yapmayı planlıyorsun?
Dialogue: 0,0:03:27.16,0:03:29.10,Main,Luffy,0,0,0,,Canına okuyacağım!
Dialogue: 0,0:03:33.50,0:03:35.73,Main,Moriah,0,0,0,,Canıma mı okuyacaksın?
Dialogue: 0,0:03:35.73,0:03:37.69,Main,Luffy,0,0,0,,Evet, öyle.
Dialogue: 0,0:03:37.69,0:03:44.32,Main,Moriah,0,0,0,,Beni yensen veya öldürsen bile bu,\Nsadece zombileri efendisiz bırakırdı.
Dialogue: 0,0:03:44.32,0:03:46.43,Main,Moriah,0,0,0,,Gölgeler geri gelmez.
Dialogue: 0,0:03:47.68,0:03:51.31,Main,Moria,0,0,0,,Şeytan Meyvesi yeteneğim gölgelere hükmetmektir.
Dialogue: 0,0:03:51.31,0:03:55.67,Main,Moria,0,0,0,,İsteğinin yerine gelmesi için yapacağın şey şu:...
Dialogue: 0,0:03:56.09,0:04:04.54,Main,Moria,0,0,0,,...gölgelerin şu anki sahipleri, \N"Efendinize Dönün" emrini verdiğimi duymalı.
Dialogue: 0,0:04:04.54,0:04:07.01,Main,Luffy,0,0,0,,Böyle yapınca her gölge geri dönecek mi?
Dialogue: 0,0:04:08.54,0:04:10.52,Main,Moriah,0,0,0,,Evet! Basit, değil mi?
Dialogue: 0,0:04:10.52,0:04:14.61,Main,Moriah,0,0,0,,Beni bunu yapacak noktaya kadar zayıflatabilirsin ama...
Dialogue: 0,0:04:14.61,0:04:20.37,Main,Moriah,0,0,0,,...şu anki gücünle bana dokunabileceğinden bile şüpheliyim.
Dialogue: 0,0:04:24.64,0:04:26.01,Main,Luffy,0,0,0,,Tamam.
Dialogue: 0,0:04:26.18,0:04:28.08,Main,Luffy,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:04:29.29,0:04:30.18,Main,Luffy,0,0,0,,{\fad(150,150)}...Tabanca!
Dialogue: 0,0:04:35.02,0:04:36.50,Main,Luffy,0,0,0,,Gölge?
Dialogue: 0,0:04:40.59,0:04:42.21,Main,Moriah,0,0,0,,Klonum karşısında...
Dialogue: 0,0:04:42.88,0:04:44.50,Main,Moriah,0,0,0,,...kazanabilecek misin görelim!
Dialogue: 0,0:04:44.50,0:04:46.22,Main,Moriah,0,0,0,,Kopya Adam!
Dialogue: 0,0:04:51.27,0:04:56.99,Main,Moriah,0,0,0,,Uzun zaman önce, ben de yeteneklerime\Nve amacıma fazla güveniyordum.
Dialogue: 0,0:04:56.99,0:05:01.50,Main,Moriah,0,0,0,,Ta ki emrimde daha fazla adam\Nolması gerektiğini farkedene dek.
Dialogue: 0,0:05:01.50,0:05:03.39,Main,Luffy,0,0,0,,Bu herifin nesi var?
Dialogue: 0,0:05:03.39,0:05:04.61,Main,Luffy,0,0,0,,Hey! Çekil!
Dialogue: 0,0:05:06.57,0:05:09.60,Main,Moriah,0,0,0,,Parmağımı bile kaldırmama gerek yok.
Dialogue: 0,0:05:09.60,0:05:13.20,Main,Moria,0,0,0,,Başkalarının emekleri beni Korsanlar Kralı yapacak.
Dialogue: 0,0:05:15.81,0:05:17.46,Main,Luffy,0,0,0,,Korsanlar Kralı ben olacağım!
Dialogue: 0,0:05:17.90,0:05:20.48,Main,Moriah,0,0,0,,Zombin de aynını söyledi.
Dialogue: 0,0:05:21.44,0:05:27.05,Flashbacks,Oars,0,0,0,,Korsanlar Kralı olacağım!
Dialogue: 0,0:05:28.80,0:05:33.34,Main,Moriah,0,0,0,,Gölge ve bedenden beklendiği gibi.\NCüssedeki farklılığa rağmen,...
Dialogue: 0,0:05:33.34,0:05:36.58,Main,Moriah,0,0,0,,...yine de eski efendisinin\Ngüçlü iradesini yansıtıyor.
Dialogue: 0,0:05:38.44,0:05:41.45,Main,Moriah,0,0,0,,Ama uzun sürmeyecek.
Dialogue: 0,0:05:42.36,0:05:49.49,Main,Moriah,0,0,0,,Sen olmakla ilgili bütün anılarını yitirdiğinde\Ntamamen itaatkâr zombim olacak.
Dialogue: 0,0:05:49.49,0:05:55.95,Main,Moriah,0,0,0,,İradesi ne kadar güçlü olursa olsun, \Nher zombi sonunda mutlak sadakat gösterecek!
Dialogue: 0,0:05:57.33,0:05:58.85,Main,Luffy,0,0,0,,Onu şimdi geri alıyorum!
Dialogue: 0,0:05:59.79,0:06:01.71,Main,Luffy,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:06:01.71,0:06:03.19,Main,Moria,0,0,0,,{\fad(150,150)}Briket Yarasa.
Dialogue: 0,0:06:03.19,0:06:04.78,Main,Luffy,0,0,0,,{\fad(150,150)}...Makineli!
Dialogue: 0,0:06:07.26,0:06:09.59,Main,Luffy,0,0,0,,Kahretsin! Onu koruyorlar!
Dialogue: 0,0:06:09.59,0:06:10.76,Main,Luffy,0,0,0,,Ona vuramıyorum!
Dialogue: 0,0:06:20.40,0:06:23.61,Main,Moriah,0,0,0,,Endişelenme, kanını emmeyecekler.
Dialogue: 0,0:06:23.88,0:06:25.96,Main,Moriah,0,0,0,,Canıma okumak mı?
Dialogue: 0,0:06:25.96,0:06:27.15,Main,Moriah,0,0,0,,Güldürme beni.
Dialogue: 0,0:06:27.60,0:06:29.07,Main,Luffy,0,0,0,,Defolun!
Dialogue: 0,0:06:36.66,0:06:42.58,Main,Moriah,0,0,0,,Deneyimsiz bir genç, her zaman başkalarını\Nhafife alır ve sonunda gülünç duruma düşer.
Dialogue: 0,0:06:45.61,0:06:48.47,Main,Luffy,0,0,0,,Pislik! Numaranı anladım!
Dialogue: 0,0:06:49.46,0:06:51.14,Main,Luffy,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:06:52.16,0:06:54.45,Main,Moria,0,0,0,,Ne? Aşağı atladı.
Dialogue: 0,0:06:54.45,0:06:55.64,Main,Moria,0,0,0,,Kaçıyor mu?
Dialogue: 0,0:06:56.01,0:06:58.10,Main,Luffy,0,0,0,,{\fad(150,150)}...Damga!
Dialogue: 0,0:07:06.25,0:07:08.78,Main,Moriah,0,0,0,,Acıttı, aptal velet!
Dialogue: 0,0:07:08.78,0:07:09.88,Main,Luffy,0,0,0,,Bak!
Dialogue: 0,0:07:09.88,0:07:12.70,Main,Luffy,0,0,0,,Sonuçta sana dokundum, dev pırasa!
Dialogue: 0,0:07:30.52,0:07:34.05,Main,Sanji,0,0,0,,Zıpla, zıpla, zıpla.
Dialogue: 0,0:07:34.05,0:07:35.80,Main,Sanji,0,0,0,,Ellerini...
Dialogue: 0,0:07:36.16,0:07:38.10,Main,Sanji,0,0,0,,...Nami-san'dan çek!
Dialogue: 0,0:07:48.28,0:07:50.14,Main,Sanji,0,0,0,,Gecikme için üzgünüm, Nami-san.
Dialogue: 0,0:07:51.06,0:07:52.36,Main,Sanji,0,0,0,,Şövalyen geldi.
Dialogue: 0,0:07:56.64,0:07:57.33,Main,Sanji,0,0,0,,Bu...
Dialogue: 0,0:07:58.79,0:08:00.25,Main,Sanji,0,0,0,,...bir Tanrıça mı?
Dialogue: 0,0:08:02.56,0:08:04.56,Main,Sanji,0,0,0,,Ah, hayır, Nami-san.
Dialogue: 0,0:08:04.56,0:08:06.00,Main,Sanji,0,0,0,,Kesinlikle Nami-san.
Dialogue: 0,0:08:06.00,0:08:07.77,Main,Sanji,0,0,0,,Hiç şüphesiz.
Dialogue: 0,0:08:07.77,0:08:09.71,Main,Sanji,0,0,0,,Ah, bu beni şaşırttı.
Dialogue: 0,0:08:09.71,0:08:11.86,Main,Sanji,0,0,0,,Böyle bir güzellik aldatıcı olabilir.
Dialogue: 0,0:08:11.86,0:08:15.19,Main,Sanji,0,0,0,,Bir anlığına kazara bir\NTanrıçayı kurtardığımı sandım.
Dialogue: 0,0:08:12.95,0:08:14.10,Secondary,Absalom,0,0,0,,Üff...
Dialogue: 0,0:08:14.10,0:08:16.67,Secondary,Absalom,0,0,0,,Orada ne mırıldanıyorsun öyle?
Dialogue: 0,0:08:16.67,0:08:20.46,Main,Absalom,0,0,0,,Gemideki tayfa üyelerinden birisin, değil mi?
Dialogue: 0,0:08:23.97,0:08:25.68,Main,Absalom,0,0,0,,M-Melek?!
Dialogue: 0,0:08:28.31,0:08:31.37,Main,Absalom,0,0,0,,Ah, hayır, hayır. Bir insan.
Dialogue: 0,0:08:31.37,0:08:32.47,Main,Absalom,0,0,0,,Hiç şüphesiz.
Dialogue: 0,0:08:32.47,0:08:34.65,Main,Absalom,0,0,0,,Yanılmışım.
Dialogue: 0,0:08:35.60,0:08:36.81,Main,Sanji,0,0,0,,Seni suçlamıyorum.
Dialogue: 0,0:08:36.81,0:08:38.70,Main,Sanji,0,0,0,,Biraz olsun suçlamıyorum.
Dialogue: 0,0:08:38.70,0:08:42.09,Main,Sanji,0,0,0,,Nami-san'ı kar beyazı renge\Nbürünmüş görmek kafa karıştırıcı.
Dialogue: 0,0:08:42.09,0:08:43.65,Main,Absalom,0,0,0,,Kesinlikle doğru.
Dialogue: 0,0:08:43.65,0:08:45.69,Main,Zombie,0,0,0,,Bunlar ne yapıyor?
Dialogue: 0,0:08:44.70,0:08:45.69,Secondary,Absalom,0,0,0,,Benzer düşünüyoruz.
Dialogue: 0,0:08:46.56,0:08:47.86,Main,Absalom,0,0,0,,Lanet olası korsan!
Dialogue: 0,0:08:47.86,0:08:49.88,Main,Absalom,0,0,0,,Seninle anlaşmak için nedenim yok!
Dialogue: 0,0:08:56.06,0:08:56.95,Main,Sanji,0,0,0,,Hey!
Dialogue: 0,0:08:58.60,0:09:01.12,Main,Sanji,0,0,0,,Bu, Nami-san'a vurabilirdi.
Dialogue: 0,0:09:01.12,0:09:05.21,Main,Sanji,0,0,0,,Bir bayanın varlığında dikkatsizce saldırmaktan kaçınmalısın.
Dialogue: 0,0:09:05.70,0:09:07.90,Main,Absalom,0,0,0,,Kaçınmakla iyi iş çıkardın.
Dialogue: 0,0:09:07.90,0:09:09.86,Main,Absalom,0,0,0,,Artık gölgen yok gibi görünüyor.
Dialogue: 0,0:09:09.86,0:09:14.82,Main,Absalom,0,0,0,,Sahi, kadınlara tuhaf bir bağlılığı\Nolan yeni bir zombi vardı.
Dialogue: 0,0:09:15.54,0:09:19.87,Main,Absalom,0,0,0,,İçinde hala biraz benliği olan asi bir zombi.
Dialogue: 0,0:09:20.21,0:09:23.16,Main,Absalom,0,0,0,,Muhtemelen senin zombindi.
Dialogue: 0,0:09:23.16,0:09:30.21,Main,Absalom,0,0,0,,Zombi Generaller'in içine dahil edilmemiş olması, gerçek bedeninin gücünün fazla önemli olmadığı anlamına gelir.
Dialogue: 0,0:09:30.66,0:09:34.09,Main,Absalom,0,0,0,,Kendine fazla güvenen penguen aslında epey güçsüzdü.
Dialogue: 0,0:09:34.61,0:09:36.05,Main,Absalom,0,0,0,,Çok saçma.
Dialogue: 0,0:09:36.05,0:09:41.01,Main,Absalom,0,0,0,,Zavallı bir ayakçının canavar ve Zombi Generaller'in\Nkomutanı denilen benimle dövüşmesi çok saçma!
Dialogue: 0,0:09:41.55,0:09:42.88,Main,Sanji,0,0,0,,S-Su perisi?!
Dialogue: 0,0:09:45.56,0:09:47.66,Main,Sanji,0,0,0,,Beni şaşırttı.
Dialogue: 0,0:09:47.66,0:09:49.74,Main,Sanji,0,0,0,,Bir anlığına su perisi olduğunu sandım.
Dialogue: 0,0:09:49.74,0:09:52.27,Main,Absalom,0,0,0,,Şimdi sertleşmek istemiyorum.
Dialogue: 0,0:09:52.27,0:09:54.68,Main,Absalom,0,0,0,,O kadını benimle bırak ve\Ngölgelerdeki yaşamına dön.
Dialogue: 0,0:09:54.68,0:09:57.49,Main,Absalom,0,0,0,,Şu anda meşgulüm.
Dialogue: 0,0:09:57.49,0:10:04.81,Main,Absalom,0,0,0,,En güçlü adamlarım, aptal kaptanınızın\Nzombisi tarafından yok edildi.
Dialogue: 0,0:10:04.81,0:10:09.58,Main,Absalom,0,0,0,,Ondan önce karıma yemin öpücüğünü veremedim.
Dialogue: 0,0:10:09.93,0:10:11.34,Main,Absalom,0,0,0,,Anlamıyor musun?
Dialogue: 0,0:10:11.34,0:10:13.53,Main,Absalom,0,0,0,,Şu anda korkunç derecede kızgınım.
Dialogue: 0,0:10:14.61,0:10:16.97,Main,Absalom,0,0,0,,Senin gibi amatörlerle uğraşacak zaman-
Dialogue: 0,0:10:18.09,0:10:21.37,Main,Sanji,0,0,0,,Kapa çeneni, karnaval hayvanı suratlı adam!
Dialogue: 0,0:10:21.37,0:10:22.72,Main,Zombie,0,0,0,,Absalom-sama!
Dialogue: 0,0:10:22.72,0:10:23.49,Main,Zombie,0,0,0,,Olamaz!
Dialogue: 0,0:10:23.49,0:10:26.93,Main,Zombie,0,0,0,,Üç yüz kiloluk bedenini bir anda uçurdu!
Dialogue: 0,0:10:30.21,0:10:33.86,Main,Sanji,0,0,0,,Usopp'un bahsettiği görünmez adam sen olmalısın.
Dialogue: 0,0:10:33.86,0:10:35.99,Thoughts,Absalom,0,0,0,,{\i1}O tekme de ne öyle?!{\i0}
Dialogue: 0,0:10:35.99,0:10:38.70,Thoughts,Absalom,0,0,0,,{\i1}Hogback'in vahşi hayvanların gücüyle bedenimi güçlendirmiş...{\i0}
Dialogue: 0,0:10:38.72,0:10:41.11,Thoughts,Absalom,0,0,0,,{\i1}...olması gerekiyordu ama yine de havaya uçuruldum.{\i0}
Dialogue: 0,0:10:42.74,0:10:43.81,Main,Absalom,0,0,0,,{\fad(150,150)}Ölünün Elleri!
Dialogue: 0,0:10:46.96,0:10:48.32,Thoughts,Absalom,0,0,0,,{\i1}Bu ne demek oluyor?!{\i0}
Dialogue: 0,0:10:48.32,0:10:50.83,Thoughts,Absalom,0,0,0,,{\i1}Ne yapacağımı biliyor muydu?!{\i0}
Dialogue: 0,0:10:52.17,0:10:53.53,Main,Sanji,0,0,0,,{\fad(150,150)}Basse Côte!
Dialogue: 0,0:10:52.17,0:10:53.53,Note,Sanji,0,0,0,,{\fad(150,150)}Alt Kaburga!
Dialogue: 0,0:10:54.83,0:10:56.28,Main,Sanji,0,0,0,,{\fad(150,150)}Longe!
Dialogue: 0,0:10:54.83,0:10:56.28,Note,Sanji,0,0,0,,{\fad(150,150)}Fileto!
Dialogue: 0,0:10:56.28,0:11:00.40,Main,Sanji,0,0,0,,Sunny'de Robin-chan'ı yalayan\Nvahşi hayvan sendin, değil mi?!
Dialogue: 0,0:11:01.01,0:11:02.65,Flashbacks,Robin,0,0,0,,Bir şey beni yakaladı!
Dialogue: 0,0:11:03.68,0:11:06.95,Main,Sanji,0,0,0,,BANYODA NAMI-SAN'I TAMAMEN\NÇIPLAK GÖREN SENDİN, DEĞİL Mİ?!
Dialogue: 0,0:11:07.78,0:11:10.25,Flashbacks,Absalom,0,0,0,,Karım olacaksın.
Dialogue: 0,0:11:10.50,0:11:11.62,Main,Sanji,0,0,0,,{\fad(150,150)}Tendron!
Dialogue: 0,0:11:10.50,0:11:11.62,Note,Sanji,0,0,0,,{\fad(150,150)}Gerdan!
Dialogue: 0,0:11:11.62,0:11:12.45,Main,Sanji,0,0,0,,{\fad(150,150)}Flanchet!
Dialogue: 0,0:11:11.62,0:11:12.45,Note,,0,0,0,,{\fad(150,150)}Mide!
Dialogue: 0,0:11:12.58,0:11:13.36,Main,Sanji,0,0,0,,{\fad(150,150)}Quasi!
Dialogue: 0,0:11:12.58,0:11:13.36,Note,Sanji,0,0,0,,{\fad(150,150)}But!
Dialogue: 0,0:11:14.20,0:11:15.69,Thoughts,Absalom,0,0,0,,{\i1}Ne biçim bir gücü var öyle?!{\i0}
Dialogue: 0,0:11:15.69,0:11:16.96,Thoughts,Absalom,0,0,0,,{\i1}Gerçekten ayakçı mı bu?!{\i0}
Dialogue: 0,0:11:17.18,0:11:18.09,Main,Sanji,0,0,0,,{\fad(150,150)}Queue!
Dialogue: 0,0:11:17.18,0:11:18.09,Note,Sanji,0,0,0,,{\fad(150,150)}Kuyruk!
Dialogue: 0,0:11:18.09,0:11:18.98,Main,Sanji,0,0,0,,{\fad(150,150)}Cuisseau!
Dialogue: 0,0:11:18.09,0:11:18.98,Note,Sanji,0,0,0,,{\fad(150,150)}Uyluk!
Dialogue: 0,0:11:18.98,0:11:19.63,Main,Sanji,0,0,0,,{\fad(150,150)}Jarret!
Dialogue: 0,0:11:18.98,0:11:19.63,Note,Sanji,0,0,0,,{\fad(150,150)}Baldır!
Dialogue: 0,0:11:19.63,0:11:21.84,Main,Sanji,0,0,0,,Niye hala kendinde değil?!
Dialogue: 0,0:11:21.84,0:11:24.38,Main,Sanji,0,0,0,,Ona sert davranmamış olsan iyi olur!
Dialogue: 0,0:11:28.08,0:11:29.57,Main,Sanji,0,0,0,,Ne evliliği?!
Dialogue: 0,0:11:29.57,0:11:33.33,Main,Sanji,0,0,0,,Gözlerime bak! Seni buradan def edeceğim\Nve kalıntılarından da kroket yapacağım!
Dialogue: 0,0:11:34.02,0:11:35.72,Main,Absalom,0,0,0,,Kahretsin! Ondan kaçınmalıyım!
Dialogue: 0,0:11:35.72,0:11:36.87,Main,Absalom,0,0,0,,{\fad(150,150)}Patinaj.
Dialogue: 0,0:11:37.92,0:11:40.18,Main,Sanji,0,0,0,,{\fad(150,150)}Usopp'un özel tuz topu.
Dialogue: 0,0:11:43.72,0:11:45.03,Thoughts,Sanji,0,0,0,,Orada!
Dialogue: 0,0:11:45.74,0:11:47.06,Main,Absalom,0,0,0,,N-Ne?! Tuz!
Dialogue: 0,0:11:48.52,0:11:51.05,Note,Sanji,0,0,0,,{\fad(150,150)}Dana Eti Vuruşu!
Dialogue: 0,0:11:48.52,0:11:51.05,Main,Sanji,0,0,0,,{\fad(150,150)}Veau Shot!
Dialogue: 0,0:11:57.31,0:11:58.55,Thoughts,Absalom,0,0,0,,{\i1}İmkansız.{\i0}
Dialogue: 0,0:11:58.55,0:12:02.53,Thoughts,Absalom,0,0,0,,{\i1}Bu herifin ödülü bile yok.{\i0}
Dialogue: 0,0:12:03.28,0:12:05.63,Main,Sanji,0,0,0,,Kızgın olduğunu mu söyledin?
Dialogue: 0,0:12:06.39,0:12:08.70,Main,Sanji,0,0,0,,Benimkiyle karşılaştırılamaz bile.
Dialogue: 0,0:12:09.19,0:12:11.95,Main,Sanji,0,0,0,,Bedenim öfkeden patlıyor!
Dialogue: 0,0:12:13.60,0:12:15.06,Main,Zombie,0,0,0,,Patladı!
Dialogue: 0,0:12:17.35,0:12:21.94,Main,Sanji,0,0,0,,Talihsiz bir şey daha var.
Dialogue: 0,0:12:21.94,0:12:24.51,Main,Sanji,0,0,0,,Seninle benim...
Dialogue: 0,0:12:24.51,0:12:26.43,Main,Sanji,0,0,0,,...bir bağlantımız var!
Dialogue: 0,0:12:35.67,0:12:37.77,Main,Zombie,0,0,0,,A-Absalom-sama...
Dialogue: 0,0:12:39.04,0:12:43.03,Main,Absalom,0,0,0,,Seninle benim bağlantımız mı var?
Dialogue: 0,0:12:44.87,0:12:50.91,Main,Sanji,0,0,0,,Evet, sen hayalimi çalan adamsın.
Dialogue: 0,0:12:55.48,0:12:56.88,Main,Absalom,0,0,0,,Seni hatırlamıyorum.
Dialogue: 0,0:12:56.88,0:12:58.74,Main,Absalom,0,0,0,,Bir tür yanlış anlaşılma olmalı.
Dialogue: 0,0:12:58.74,0:13:00.34,Main,Absalom,0,0,0,,Seninle ilk kez...
Dialogue: 0,0:13:02.18,0:13:04.59,Main,Absalom,0,0,0,,...bugün karşılaştım.
Dialogue: 0,0:13:06.91,0:13:08.37,Main,Absalom,0,0,0,,İşini bitireceğim!
Dialogue: 0,0:13:09.86,0:13:12.18,Main,Absalom,0,0,0,,Bu Ölünün Elleri'yle!
Dialogue: 0,0:13:14.46,0:13:16.48,Main,Sanji,0,0,0,,Çıkar onları.
Dialogue: 0,0:13:18.18,0:13:21.90,Main,Sanji,0,0,0,,Kollarına taktığın bazukaları çıkar dedim.
Dialogue: 0,0:13:24.26,0:13:25.96,Main,Sanji,0,0,0,,Anlamıyor musun?
Dialogue: 0,0:13:27.22,0:13:35.00,Main,Sanji,0,0,0,,Akılsız saldırıların yüzünden Nami-san yaralanırsa,\Nseninle işim bittiğinde pek "canlı" gözükmeyeceksin.
Dialogue: 0,0:13:36.02,0:13:37.67,Main,Absalom,0,0,0,,Hiçbir şey bilmiyor.
Dialogue: 0,0:13:40.57,0:13:41.94,Main,Sanji,0,0,0,,Onları...
Dialogue: 0,0:13:43.23,0:13:45.17,Main,Sanji,0,0,0,,...çıkar dedim!
Dialogue: 0,0:13:53.06,0:13:56.06,Main,Zombie,0,0,0,,Ne?! Aniden ortaya bir bazuka çıktı!
Dialogue: 0,0:13:56.40,0:13:58.26,Main,Sanji,0,0,0,,İşte böyle, değil mi?
Dialogue: 0,0:13:58.26,0:14:00.94,Main,Sanji,0,0,0,,Epey akıllıca bir saldırı.
Dialogue: 0,0:14:01.40,0:14:07.33,Main,Sanji,0,0,0,,Bedenini ve seninle temas eden\Nher şeyi görünmez yapıyorsun.
Dialogue: 0,0:14:07.33,0:14:09.86,Main,Sanji,0,0,0,,Yeteneğin bu.
Dialogue: 0,0:14:09.86,0:14:11.95,Main,Sanji,0,0,0,,Suke Suke meyvesinin görünmez adamı.
Dialogue: 0,0:14:09.86,0:14:11.95,Note,,0,0,0,,Suke: Saydam
Dialogue: 0,0:14:12.49,0:14:15.83,Main,Sanji,0,0,0,,Yapabileceğin her şeyi biliyorum!
Dialogue: 0,0:14:16.40,0:14:17.73,Main,Absalom,0,0,0,,Bu nasıl mümkün olabilir?!
Dialogue: 0,0:14:17.73,0:14:19.29,Main,Absalom,0,0,0,,Kimsin sen?!
Dialogue: 0,0:14:19.61,0:14:23.22,Main,Zombie,0,0,0,,O adam Absalom-sama'yla daha önce karşılaşmış mı?
Dialogue: 0,0:14:23.22,0:14:25.30,Main,Zombie,0,0,0,,Niye yetenekleri hakkındaki her şeyi biliyor?
Dialogue: 0,0:14:26.84,0:14:30.47,Main,Sanji,0,0,0,,Çocukken, bir keresinde Şeytan Meyveleri'yle\Nilgili resimli büyük bir kitap açtım.
Dialogue: 0,0:14:30.93,0:14:36.10,Main,Sanji,0,0,0,,Önceleri deniz lanetleri hakkındaki\No söylentilerle hiç ilgilenmemiştim ama...
Dialogue: 0,0:14:36.59,0:14:41.14,Main,Sanji,0,0,0,,...sayfaları çevirirken, ilgimi\Nçeken bir tanesine rasladım.
Dialogue: 0,0:14:41.14,0:14:44.64,Main,Sanji,0,0,0,,O yeteneği bulsaydım,...
Dialogue: 0,0:14:44.64,0:14:47.57,Main,Sanji,0,0,0,,...lanetlenme pahasına da olsa, memnuniyetle yerdim.
Dialogue: 0,0:14:48.74,0:14:53.12,Main,Sanji,0,0,0,,Ama aynı meyveden dünyada iki tane yok.
Dialogue: 0,0:14:55.21,0:15:00.48,Main,Sanji,0,0,0,,Bir ihtimal o meyvenin kullanıcısıyla\Nkarşılaşsaydım, hayalim mahvolurdu!
Dialogue: 0,0:15:00.48,0:15:02.19,Main,Sanji,0,0,0,,Şimdi anlıyor musun?!
Dialogue: 0,0:15:02.19,0:15:05.73,Main,Sanji,0,0,0,,Görünmez adam olmayı istiyordum!
Dialogue: 0,0:15:06.32,0:15:12.20,Main,Sanji,0,0,0,,Bu yüzden suke suke meyvesini yediğin anda, hayalimi mahvettin!
Dialogue: 0,0:15:12.20,0:15:14.53,Main,Zombie,0,0,0,,Haklı!
Dialogue: 0,0:15:14.78,0:15:17.11,Main,Sanji,0,0,0,,Hayalimin gerçeğe dönüşmesini istedim!
Dialogue: 0,0:15:17.11,0:15:19.41,Main,Sanji,0,0,0,,Gerçekleşseydi, o yeteneğimle gireceğim yer,...
Dialogue: 0,0:15:19.41,0:15:20.29,Main,Sanji,0,0,0,,...KADINLAR BANYOSU!
Dialogue: 0,0:15:20.29,0:15:23.04,Main,Sanji,0,0,0,,Hayır, yapacağım onurlu şey,...
Dialogue: 0,0:15:23.04,0:15:24.02,Main,Sanji,0,0,0,,...KADINLAR BANYOSU!
Dialogue: 0,0:15:24.02,0:15:27.17,Main,Sanji,0,0,0,,Hayır, kesinlikle yardım edeceğim insanlar,...
Dialogue: 0,0:15:27.17,0:15:28.23,Main,Sanji,0,0,0,,...KADINLAR BANYOSU!
Dialogue: 0,0:15:28.23,0:15:32.72,Main,Zombie,0,0,0,,Kadınlar banyosunu gözetlemekten\Nbaşka bir şey istemiyor!
Dialogue: 0,0:15:32.72,0:15:34.30,Main,Sanji,0,0,0,,Kapayın çenenizi!
Dialogue: 0,0:15:34.30,0:15:38.78,Main,Sanji,0,0,0,,Ama yıllar süren simülasyon sayesinde,\No yetenekle görebileceğin her şeyi bili-
Dialogue: 0,0:15:38.78,0:15:42.77,Main,Sanji,0,0,0,,Hayır, o yetenekle yapabileceğin her şeyi biliyorum!
Dialogue: 0,0:15:45.70,0:15:51.65,Main,Sanji,0,0,0,,Nami-san'ı tehlikeye soktuğunu da sayarsak, bu,\Nseni kesinlikle affedemeyeceğim anlamına gelir!
Dialogue: 0,0:15:51.65,0:15:52.40,Main,Sanji,0,0,0,,KADINLAR BAN-
Dialogue: 0,0:15:52.40,0:15:55.39,Main,Sanji,0,0,0,,Hayır! Ölmeye hazır olsan iyi olur!
Dialogue: 0,0:15:56.91,0:15:58.73,Main,Absalom,0,0,0,,Ne düşünüyorsun?!
Dialogue: 0,0:15:58.73,0:16:01.60,Main,Absalom,0,0,0,,Ne saçma bir bağlantı!
Dialogue: 0,0:16:02.41,0:16:05.33,Main,Absalom,0,0,0,,Bu duyduğum en aptalca şey!
Dialogue: 0,0:16:05.33,0:16:06.25,Main,Absalom,0,0,0,,Sen...
Dialogue: 0,0:16:06.25,0:16:08.15,Main,Absalom,0,0,0,,...kahrolası bir sapıksın!
Dialogue: 0,0:16:08.78,0:16:09.73,Main,Sanji,0,0,0,,Bunu senden...
Dialogue: 0,0:16:10.55,0:16:12.51,Main,Sanji,0,0,0,,...duymak istemiyorum!
Dialogue: 0,0:16:12.51,0:16:14.39,Main,Zombie,0,0,0,,Haklı!
Dialogue: 0,0:16:15.76,0:16:18.66,Main,Zombie,0,0,0,,Ama onlar aynılar!
Dialogue: 0,0:16:18.66,0:16:21.83,Main,Absalom,0,0,0,,Pekâlâ!
Dialogue: 0,0:16:25.82,0:16:30.51,Main,Absalom,0,0,0,,Bağlantını, öfkeni, her şeyini sana geri vereceğim!
Dialogue: 0,0:16:32.70,0:16:34.76,Main,Absalom,0,0,0,,Sadece aslan çenem yok!
Dialogue: 0,0:16:35.31,0:16:36.57,Main,Absalom,0,0,0,,Fil derisi!
Dialogue: 0,0:16:38.57,0:16:42.23,Main,Absalom,0,0,0,,300 kiloluk yoğunlaştırılmış ayı ve goril kasları!
Dialogue: 0,0:16:42.99,0:16:50.66,Main,Absalom,0,0,0,,Dikiş üstüne dikiş. Dr. Hogback, en üstün bedenimi\Nelde edene dek üstümde çalışmaya devam etti!
Dialogue: 0,0:16:50.66,0:16:54.68,Main,Absalom,0,0,0,,Suke Suke meyvesi ekstradan başka bir şey değil.
Dialogue: 0,0:16:54.68,0:16:58.58,Main,Absalom,0,0,0,,Sahip olduğum korkunç güçle mukayese bile edilemez!
Dialogue: 0,0:16:58.58,0:17:00.04,Main,Absalom,0,0,0,,Şimdi anlıyor musun?
Dialogue: 0,0:17:02.04,0:17:03.14,Main,Sanji,0,0,0,,Ama...
Dialogue: 0,0:17:03.14,0:17:05.05,Main,Sanji,0,0,0,,...onu dikizledin zaten!
Dialogue: 0,0:17:07.96,0:17:09.71,Main,Zombie,0,0,0,,Doğru!
Dialogue: 0,0:17:13.05,0:17:18.09,Thoughts,Absalom,0,0,0,,{\i1}Sıradan bir tekme olsaydı, bacağı kırılırdı.{\i0}
Dialogue: 0,0:17:18.42,0:17:22.18,Thoughts,Absalom,0,0,0,,{\i1}Ona göre bedenim sanki normal bir insanınmış gibi.{\i0}
Dialogue: 0,0:17:22.51,0:17:26.69,Main,Absalom,0,0,0,,Ama son gülen ben olacağım!
Dialogue: 0,0:17:29.92,0:17:36.49,Main,Absalom,0,0,0,,Arzuladığın yeteneği yitirdin ve hatta\Nkorumaya çalıştığın kadın benim karım olacak!
Dialogue: 0,0:17:36.49,0:17:38.93,Main,Absalom,0,0,0,,Bu durumda beni yenme şansın yok!
Dialogue: 0,0:17:41.24,0:17:46.41,Flashbacks,Usopp,0,0,0,,O sırada Nami de onunla birlikte\Nyok oldu ve peşinden gidemedik!
Dialogue: 0,0:17:47.61,0:17:49.21,Main,Sanji,0,0,0,,Nami-san'ı saklamak istiyorsun, değil mi?
Dialogue: 0,0:17:49.21,0:17:50.41,Main,Sanji,0,0,0,,Bedenimi çiğnemen lazım!
Dialogue: 0,0:17:55.56,0:17:56.77,Main,Absalom,0,0,0,,Faydasız!
Dialogue: 0,0:17:56.77,0:18:00.72,Main,Absalom,0,0,0,,Sana hayvan adamın gücünü göstereceğim!
Dialogue: 0,0:18:06.32,0:18:09.65,Main,Absalom,0,0,0,,Yani o kadın için kendini feda etmek niyetinde misin?
Dialogue: 0,0:18:11.24,0:18:12.55,Main,Absalom,0,0,0,,Koru o zaman!
Dialogue: 0,0:18:12.55,0:18:14.40,Main,Absalom,0,0,0,,Tabii yapabilirsen!
Dialogue: 0,0:18:14.40,0:18:15.51,Main,Absalom,0,0,0,,{\fad(150,150)}Hayvan Adamın Elleri!
Dialogue: 0,0:18:15.51,0:18:17.07,Main,Absalom,0,0,0,,{\fad(150,150)}Hayvan Adamın Bacakları!
Dialogue: 0,0:18:27.79,0:18:30.65,Main,Absalom,0,0,0,,Bırakma onu!
Dialogue: 0,0:18:35.97,0:18:38.83,Main,Sanji,0,0,0,,Üzgünüm, Nami-san.
Dialogue: 0,0:18:44.89,0:18:46.04,Main,Absalom,0,0,0,,Bıraktın mı?
Dialogue: 0,0:18:46.04,0:18:48.18,Main,Absalom,0,0,0,,Demek hayatına onunkinden\Ndaha fazla değer veriyorsun!
Dialogue: 0,0:18:49.77,0:18:51.19,Main,Sanji,0,0,0,,Üzgünüm.
Dialogue: 0,0:18:51.19,0:18:55.19,Main,Sanji,0,0,0,,O kar beyazı elbiseyi lekelemek istemiyorum.
Dialogue: 0,0:18:57.44,0:19:02.16,Main,Sanji,0,0,0,,Kahretsin, sadece saklanıp sessizce\Nilerliyorsun, görünmez adam.
Dialogue: 0,0:19:02.16,0:19:05.66,Main,Sanji,0,0,0,,Artık o hayal umrumda değil.
Dialogue: 0,0:19:06.16,0:19:10.54,Main,Sanji,0,0,0,,Artık görünmez adam olmak umrumda değil!
Dialogue: 0,0:19:11.23,0:19:12.86,Main,Sanji,0,0,0,,Kendi başıma dikizleyeceğim!
Dialogue: 0,0:19:12.86,0:19:14.46,Main,Zombie,0,0,0,,Hala dikizlemek mi istiyorsun?!
Dialogue: 0,0:19:20.76,0:19:22.04,Main,Absalom,0,0,0,,Bırak beni, pislik!
Dialogue: 0,0:19:22.94,0:19:23.90,Main,Absalom,0,0,0,,Bırak!
Dialogue: 0,0:19:26.08,0:19:27.97,Main,Sanji,0,0,0,,Bırakır mıyım sanki, pis herif?!
Dialogue: 0,0:19:29.83,0:19:32.67,Main,Sanji,0,0,0,,Bir sürü hayvandan yapıldıysan,...
Dialogue: 0,0:19:32.67,0:19:35.19,Main,Sanji,0,0,0,,...senden güzel kıyma olur!
Dialogue: 0,0:19:36.21,0:19:39.82,Main,Absalom,0,0,0,,Kapa çeneni! Bırak beni!
Dialogue: 0,0:19:47.03,0:19:49.70,Main,Sanji,0,0,0,,{\fad(150,150)}Extra Haché!
Dialogue: 0,0:19:47.03,0:19:49.70,Note,Sanji,0,0,0,,{\fad(150,150)}Haché: Kıyılmış/Doğranmış
Dialogue: 0,0:19:49.70,0:19:51.87,Main,Zombie,0,0,0,,Absalom-sama!
Dialogue: 0,0:19:58.18,0:19:59.46,Main,Sanji,0,0,0,,Kadınların banyosu...
Dialogue: 0,0:19:59.46,0:20:00.69,Main,Sanji,0,0,0,,Hayır.
Dialogue: 0,0:20:00.69,0:20:02.93,Main,Sanji,0,0,0,,Bir hayvanın karısı...
Dialogue: 0,0:20:03.62,0:20:05.69,Main,Sanji,0,0,0,,...başka bir hayvan olmalı.
Dialogue: 0,0:20:14.00,0:20:16.12,Main,Perona,0,0,0,,Hala peşimden geliyor!
Dialogue: 0,0:20:16.12,0:20:19.92,Main,Pelona,0,0,0,,O olmasaydı, diğer korsanları çoktan yenmiştim!
Dialogue: 0,0:20:19.92,0:20:21.65,Main,Pelona,0,0,0,,Lanet olası Uzun Burun!
Dialogue: 0,0:20:24.50,0:20:26.46,Main,Usopp,0,0,0,,Hala peşimden geliyor!
Dialogue: 0,0:20:26.46,0:20:30.93,Main,Usopp,0,0,0,,O olmasaydı, Horo Horo kadını çoktan yenmiştim!
Dialogue: 0,0:20:30.93,0:20:32.39,Main,Usopp,0,0,0,,Lanet olası ayı zombi!
Dialogue: 0,0:20:32.39,0:20:34.56,Main,Kumashi,0,0,0,,Dur!
Dialogue: 0,0:20:35.43,0:20:36.48,Main,Usopp,0,0,0,,Uzak dur!
Dialogue: 0,0:20:36.48,0:20:38.00,Main,Usopp,0,0,0,,Dur, Horo Horo kadın!
Dialogue: 0,0:20:38.65,0:20:39.98,Main,Perona,0,0,0,,Uzak dur!
Dialogue: 0,0:20:39.98,0:20:42.22,Main,Perona,0,0,0,,Ayıcık, hemen durdur onu!
Dialogue: 0,0:20:43.02,0:20:44.01,Main,Kumashi,0,0,0,,Dur!
Dialogue: 0,0:20:45.01,0:20:49.25,Main,Kumashi,0,0,0,,Perona-sama'ya el sürme!
Dialogue: 0,0:20:50.01,0:20:52.75,Main,Usopp,0,0,0,,Çok yakın! Çok yakın!
Dialogue: 0,0:20:52.75,0:20:55.91,Main,Kumashi,0,0,0,,Perona-sama!
Dialogue: 0,0:21:02.55,0:21:05.53,Main,Usopp,0,0,0,,Peluş hayvan için ne korkunç bir güç!
Dialogue: 0,0:21:06.55,0:21:07.56,Main,Usopp,0,0,0,,Al bakalım!
Dialogue: 0,0:21:07.56,0:21:08.88,Main,Usopp,0,0,0,,{\fad(0,150)}Kesin Öldürücü...
Dialogue: 0,0:21:08.88,0:21:10.08,Main,Usopp,0,0,0,,{\fad(150,150)}...Alev Topu!
Dialogue: 0,0:21:13.90,0:21:14.83,Main,Usopp,0,0,0,,İşe yaradı!
Dialogue: 0,0:21:15.77,0:21:17.99,Main,Usopp,0,0,0,,Sonuçta zombi zombidir!
Dialogue: 0,0:21:17.99,0:21:25.10,Main,Usopp,0,0,0,,Şimdi bu yağla, \N"Buraya-Gelmeyeceksin-Tekniği" mi sergileyeceğim!
Dialogue: 0,0:21:25.96,0:21:26.97,Main,Bearsy,0,0,0,,Ne?
Dialogue: 0,0:21:28.16,0:21:29.26,Main,Usopp,0,0,0,,Aptal ayı!
Dialogue: 0,0:21:29.26,0:21:30.16,Main,Usopp,0,0,0,,Artık beni yakalayamazsın!
Dialogue: 0,0:21:31.79,0:21:33.79,Main,Usopp,0,0,0,,Şimdi yolumda hiçbir şey yok.
Dialogue: 0,0:21:33.79,0:21:35.54,Main,Usopp,0,0,0,,Şimdi gücümü anlıyor musun?
Dialogue: 0,0:21:38.94,0:21:45.60,Main,Usopp,0,0,0,,Bir bakalım, cezalandırmam gereken\Nbenden güçsüz bir horo horo kadın var.
Dialogue: 0,0:21:46.47,0:21:48.21,Main,Usopp,0,0,0,,Nereye gitti bu?
Dialogue: 0,0:21:48.21,0:21:50.74,Main,Perona,0,0,0,,Buradayım, Uzun Burun.
Dialogue: 0,0:21:51.15,0:21:53.41,Main,Usopp,0,0,0,,Yoksa pencerinin dışında mı?
Dialogue: 0,0:21:53.41,0:21:56.05,Main,Usopp,0,0,0,,Gerçi bu mümkün değil.
Dialogue: 0,0:21:56.05,0:21:58.17,Main,Usopp,0,0,0,,Epey yüksek bir yerde-
Dialogue: 0,0:22:02.50,0:22:04.10,Main,Usopp,0,0,0,,S-Sen!
Dialogue: 0,0:22:04.10,0:22:06.18,Main,Usopp,0,0,0,,Nasıl uçabilirsin?!
Dialogue: 0,0:22:06.18,0:22:08.25,Main,Usopp,0,0,0,,Sadece hayaletleri kontrol edebilmen gerekiyordu!
Dialogue: 0,0:22:08.25,0:22:11.60,Main,Usopp,0,0,0,,G-Gerçek yeteneğin ne?!
Dialogue: 0,0:22:12.83,0:22:17.86,Main,Perona,0,0,0,,Hayalet Prenses'i hafife almasan iyi olur.
Dialogue: 0,0:22:17.86,0:22:20.95,Main,Perona,0,0,0,,Senden kurtulmanın bir yolunu düşündüm.
Dialogue: 0,0:22:20.95,0:22:24.73,Main,Perona,0,0,0,,Seninle işim bittiğinde, diğer korsanlarla\Nilgilenmek sorun olmayacak.
Dialogue: 0,0:22:27.90,0:22:29.57,Main,Usopp,0,0,0,,Dur biraz!
Dialogue: 0,0:22:29.57,0:22:34.51,Main,Usopp,0,0,0,,Bu ifade konusunda içimde kötü bir his var!
