FFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,2,0,2,10,10,15,1Style: Author,Impress BT,25,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1,1,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:01.35,0:00:05.47,Jungle P lyrics,,0,0,0,,Dünyanın her yerindeki denizlerde yolculuk edelim.Dialogue: 0,0:00:05.68,0:00:07.85,Jungle P lyrics,,0,0,0,,Savaş naramızı yükselterek.Dialogue: 0,0:00:08.00,0:00:12.19,Jungle P lyrics,,0,0,0,,Kararını verdiysen, bırak kalkış sinyali...Dialogue: 0,0:00:12.32,0:00:14.63,Jungle P lyrics,,0,0,0,,...çalınsın!Dialogue: 0,0:00:21.87,0:00:25.34,Jungle P lyrics,,0,0,0,,Sabit rotadan kaçabildik,...Dialogue: 0,0:00:23.42,0:00:28.94,Credits,,0,0,0,,Translation & initial syncing Vegapunk FansubsDialogue: 0,0:00:25.47,0:00:28.89,Jungle P lyrics,,0,0,0,,...denizle gök arasındaki sınır boyunca.Dialogue: 0,0:00:29.01,0:00:34.15,Jungle P lyrics,,0,0,0,,Şimdi kürek ççekerek yolumuzu açıyoruz...Dialogue: 0,0:00:29.36,0:00:34.48,Credits,,0,0,0,,Syncing Galaxy 9000  Sync-checking SewilDialogue: 0,0:00:34.51,0:00:40.67,Jungle P lyrics,,0,0,0,,...denizin karanlık dibindeki gizli bir maceraya doğru.Dialogue: 0,0:00:35.56,0:00:40.69,Credits,,0,0,0,,Quality-checking Sewil Galaxy 9000 FeesoDialogue: 0,0:00:40.72,0:00:47.49,Jungle P lyrics,,0,0,0,,Sırf bunu düşünmek bile kulağa eğlenceli gelmiyor mu?Dialogue: 0,0:00:40.90,0:00:44.07,Credits,,0,0,0,,Video editing SewilDialogue: 0,0:00:44.24,0:00:47.44,Credits,,0,0,0,,Soundtracking HaleeDialogue: 0,0:00:47.79,0:00:51.88,Jungle P lyrics,,0,0,0,,Dünyanın her yerindeki denizlerde yolculuk edelim.Dialogue: 0,0:00:51.98,0:00:54.22,Jungle P lyrics,,0,0,0,,Savaş naramızı yükselterek.Dialogue: 0,0:00:52.98,0:00:56.82,Credits,,0,0,0,,Raw provider SOFCJ-RawsDialogue: 0,0:00:54.35,0:00:58.55,Jungle P lyrics,,0,0,0,,Kararını verdiysen, bırak kalkış sinyali...Dialogue: 0,0:00:58.72,0:01:00.99,Jungle P lyrics,,0,0,0,,...çalınsın!Dialogue: 0,0:01:08.40,0:01:11.57,Jungle P lyrics,,0,0,0,,Yelken açarken hissettiğimiz o his...Dialogue: 0,0:01:11.68,0:01:15.05,Jungle P lyrics,,0,0,0,,...asla unutmayacağım bir şey.Dialogue: 0,0:01:15.22,0:01:16.86,Jungle P lyrics,,0,0,0,,O his sayesinde...Dialogue: 0,0:01:17.04,0:01:20.54,Jungle P lyrics,,0,0,0,,...hiçbir şey beni korkutamayacak.Dialogue: 0,0:01:20.83,0:01:26.77,Jungle P lyrics,,0,0,0,,Şimdi yolculuk yaklaşırken, yarışan kalp atışlarımız...Dialogue: 0,0:01:27.00,0:01:33.72,Jungle P lyrics,,0,0,0,,...utangaç kalplerimize bir macera ritmi kazıyor.Dialogue: 0,0:01:33.92,0:01:38.09,Jungle P lyrics,,0,0,0,,Yüksek sesle gülerken...Dialogue: 0,0:01:38.21,0:01:40.40,Jungle P lyrics,,0,0,0,,...tüm hazineleri al.Dialogue: 0,0:01:40.53,0:01:44.80,Jungle P lyrics,,0,0,0,,Dikkatleri üzerine ççekerek...Dialogue: 0,0:01:44.90,0:01:47.44,Jungle P lyrics,,0,0,0,,...hepsini büyük bir partide harca.Dialogue: 0,0:01:47.90,0:01:49.54,Jungle P lyrics,,0,0,0,,Hayat maceralıdır.Dialogue: 0,0:01:49.54,0:01:51.12,Jungle P lyrics,,0,0,0,,Tehlikesinin farkında ol.Dialogue: 0,0:01:51.12,0:01:52.82,Jungle P lyrics,,0,0,0,,Kim bizden biri olacak?Dialogue: 0,0:01:52.82,0:01:54.41,Jungle P lyrics,,0,0,0,,Ve yolculuk devam ediyor çünkü...Dialogue: 0,0:01:54.41,0:01:56.13,Jungle P lyrics,,0,0,0,,...biz bir grup korsanız!Dialogue: 0,0:01:56.13,0:01:57.91,Jungle P lyrics,,0,0,0,,Batıya, Doğuya.Dialogue: 0,0:01:57.91,0:01:59.38,Jungle P lyrics,,0,0,0,,Yolumu bulmalı, uzaklara yelken açmalıyım.Dialogue: 0,0:01:59.38,0:02:00.38,Jungle P lyrics,,0,0,0,,One Piece'e doğru!Dialogue: 0,0:02:00.57,0:02:04.65,Jungle P lyrics,,0,0,0,,Boş kalbini hayallerle doldur.Dialogue: 0,0:02:04.79,0:02:06.99,Jungle P lyrics,,0,0,0,,Kanatlarını aç.Dialogue: 0,0:02:07.24,0:02:11.31,Jungle P lyrics,,0,0,0,,Kalbini esen rüzgarla boyarsan,...Dialogue: 0,0:02:11.41,0:02:13.65,Jungle P lyrics,,0,0,0,,...ilerlersin.Dialogue: 0,0:02:13.71,0:02:17.83,Jungle P lyrics,,0,0,0,,Yüksek sesle gülerken...Dialogue: 0,0:02:18.00,0:02:20.17,Jungle P lyrics,,0,0,0,,...tüm hazineleri al.Dialogue: 0,0:02:20.30,0:02:24.57,Jungle P lyrics,,0,0,0,,Dikkatleri üzerine ççekerek...Dialogue: 0,0:02:24.74,0:02:27.31,Jungle P lyrics,,0,0,0,,...hepsini büyük bir partide harca.Dialogue: 0,0:02:29.88,0:02:39.88,Author,,0,0,0,, Türkçeleştirme  onepacetr.netDialogue: 0,0:10:59.72,0:11:09.72,Author,,0,0,0,, Türkçeleştirme  onepacetr.netDialogue: 0,0:20:20.00,0:20:30.00,Author,,0,0,0,, Türkçeleştirme  onepacetr.netDialogue: 0,0:02:29.88,0:02:32.93,Title,,0,0,0,,Çarpışma!  Zombie 900'e Karşı Büyük Savaş!Dialogue: 0,0:02:35.03,0:02:38.30,Main,Oz,0,0,0,,Bu ikisinin alakası yok.Dialogue: 0,0:02:38.30,0:02:40.77,Main,Oz,0,0,0,,Yani...Dialogue: 0,0:02:40.77,0:02:43.74,Main,Oz,0,0,0,,...deminki hasır şapkalı adam,...Dialogue: 0,0:02:44.28,0:02:45.98,Main,Oz,0,0,0,,...turuncu saçlı kadın,...Dialogue: 0,0:02:46.58,0:02:48.45,Main,Oz,0,0,0,,...ve şık kahraman.Dialogue: 0,0:02:49.01,0:02:51.88,Main,Oz,0,0,0,,Üçü kayıp.Dialogue: 0,0:02:52.20,0:02:55.60,Main,Oz,0,0,0,,Neredeler?Dialogue: 0,0:03:00.04,0:03:00.86,Main,Zombie,0,0,0,,Kendinden geçmiş!Dialogue: 0,0:03:01.18,0:03:02.05,Main,Pelona,0,0,0,,Kesin şunu!Dialogue: 0,0:03:02.05,0:03:05.09,Main,Pelona,0,0,0,,Hamamböceklerinden nefret ediyorum! Hemen çekin şunları!Dialogue: 0,0:03:05.09,0:03:06.85,Main,Pelona,0,0,0,,Hamamböcekleri olmaz!Dialogue: 0,0:03:01.83,0:03:02.94,Secondary,Zombie,0,0,0,,Perona-sama!Dialogue: 0,0:03:02.94,0:03:03.95,Secondary,Zombie,0,0,0,,Perona-sama!Dialogue: 0,0:03:03.95,0:03:06.85,Secondary,Zombie,0,0,0,,Görebildiğiniz gibi hamamböcekleri yok!Dialogue: 0,0:03:08.85,0:03:10.28,Main,Pelona,0,0,0,,Burası?Dialogue: 0,0:03:12.72,0:03:14.30,Main,Zombie,0,0,0,,Düşman artık burada değil!Dialogue: 0,0:03:14.30,0:03:17.07,Main,Zombie,0,0,0,,Yerde hiçbir şeyden habersiz yatıyordunuz!Dialogue: 0,0:03:17.53,0:03:19.63,Main,Zombie,0,0,0,,Bunu size kim yaptı?!Dialogue: 0,0:03:19.63,0:03:21.55,Main,Zombie,0,0,0,,Daha önceki adam mıydı?!Dialogue: 0,0:03:21.55,0:03:24.02,Main,Pelona,0,0,0,,Bu malikânenin hali ne?!Dialogue: 0,0:03:24.02,0:03:26.34,Main,Pelona,0,0,0,,Korsanların işi miydi?!Dialogue: 0,0:03:26.34,0:03:29.22,Main,Zombie,0,0,0,,Korsanlar da taşkınlık yapıyor ama...Dialogue: 0,0:03:29.22,0:03:32.11,Main,Zombie,0,0,0,,...tüm bunlar Oz'un işi!Dialogue: 0,0:03:32.11,0:03:33.02,Main,Pelona,0,0,0,,Oz?Dialogue: 0,0:03:33.35,0:03:38.85,Main,Zombie,0,0,0,,Duyduğumuza göre Oz, bütün General Zombiler'i temizlemiş.Dialogue: 0,0:03:39.36,0:03:41.20,Main,Pelona,0,0,0,,Şu elit dövüşçüleri mi?!Dialogue: 0,0:03:41.54,0:03:44.43,Main,Pelona,0,0,0,,Oz tamamen kontrolden çıktı mı?!Dialogue: 0,0:03:44.43,0:03:46.22,Main,Zombie,0,0,0,,Şey, tam değil ama...Dialogue: 0,0:03:51.01,0:03:51.90,Main,Pelona,0,0,0,,Çocuklar!Dialogue: 0,0:03:51.90,0:03:52.84,Main,Zombie,0,0,0,,Kardeş!Dialogue: 0,0:03:53.10,0:03:55.29,Main,Oz,0,0,0,,Kadın!Dialogue: 0,0:03:56.65,0:03:58.75,Main,Pelona,0,0,0,,O-Oz?Dialogue: 0,0:03:59.61,0:04:03.57,Main,Zombie,0,0,0,,S-Sahi, Hogback-sama'yı da çiğnediğini duydum.Dialogue: 0,0:04:03.57,0:04:04.49,Main,Pelona,0,0,0,,Ne?!Dialogue: 0,0:04:04.49,0:04:07.10,Main,Oz,0,0,0,,Kadın burada değil mi?Dialogue: 0,0:04:07.10,0:04:08.76,Main,Oz,0,0,0,,Kadın!Dialogue: 0,0:04:08.76,0:04:10.29,Main,Pelona,0,0,0,,Kadın?!Dialogue: 0,0:04:10.29,0:04:13.63,Main,Pelona,0,0,0,,Eyvah! Buradan çıkmalıyım!Dialogue: 0,0:04:13.63,0:04:17.50,Main,Pelona,0,0,0,,Thriller Bark, korsanlar ve Oz tarafından yok edilecek!Dialogue: 0,0:04:18.21,0:04:21.13,Main,Pelona,0,0,0,,Hemen biraz yiyecek malzemesi ve hazine toplayın!Dialogue: 0,0:04:21.13,0:04:23.80,Main,Pelona,0,0,0,,Onların gemisini alıp kaçacağım!Dialogue: 0,0:04:23.80,0:04:24.58,Main,Zombie,0,0,0,,Onların?Dialogue: 0,0:04:24.78,0:04:26.36,Main,Pelona,0,0,0,,HASIR ŞAPKALAR'IN!Dialogue: 0,0:04:26.36,0:04:27.90,Main,Pelona,0,0,0,,Onların gemisiyle kaçacağız!Dialogue: 0,0:04:27.90,0:04:28.56,Main,Pelona,0,0,0,,Çabuk!Dialogue: 0,0:04:28.87,0:04:30.62,Main,Zombie,0,0,0,,Evet! Derhal!Dialogue: 0,0:04:31.35,0:04:32.85,Captions,Sign,0,0,210,,Bu arada, boş bir odada.Dialogue: 0,0:04:32.85,0:04:36.72,Main,Zombie,0,0,0,,Devam edelim. Gelini öpebilirsin.Dialogue: 0,0:04:44.02,0:04:44.63,Main,Nami,0,0,0,,Ne?!Dialogue: 0,0:04:44.63,0:04:45.23,Main,Nami,0,0,0,,H-Hey, hey, hey!Dialogue: 0,0:04:45.23,0:04:46.03,Main,Nami,0,0,0,,Ne, ne?!Dialogue: 0,0:04:46.03,0:04:47.33,Main,Nami,0,0,0,,Kes şunu!Dialogue: 0,0:04:48.42,0:04:50.05,Main,Absalom,0,0,0,,Gözlerini açtı mı?!Dialogue: 0,0:04:50.05,0:04:51.25,Main,Absalom,0,0,0,,Sorun değil!Dialogue: 0,0:04:52.17,0:04:56.70,Main,Absalom,0,0,0,,Kapanış öpücüğüyle, sen ve ben evlilikle birbirimize bağlanmış olacağız!Dialogue: 0,0:04:56.70,0:04:59.54,Main,Nami,0,0,0,,Hayır dedim! Seni sapık hayvan adam!Dialogue: 0,0:04:59.54,0:05:02.30,Main,Nami,0,0,0,,Maceralarıma devam etmek istiyorum!Dialogue: 0,0:05:02.30,0:05:03.27,Main,Absalom,0,0,0,,Kapa çeneni ve mutlu ol!Dialogue: 0,0:05:03.27,0:05:06.35,Main,Absalom,0,0,0,,Mezarlık  Kralı'nın karısısın! Mezarlık Kraliçesi olacaksın!Dialogue: 0,0:05:06.35,0:05:07.84,Main,Nami,0,0,0,,Hayır! O da ne öyle?!Dialogue: 0,0:05:11.62,0:05:14.44,Main,Lola,0,0,0,,Kahrolası Namizou!Dialogue: 0,0:05:19.13,0:05:19.98,Main,Nami,0,0,0,,Lo-Dialogue: 0,0:05:19.98,0:05:21.10,Main,Absalom,0,0,0,,Lola!Dialogue: 0,0:05:22.01,0:05:23.45,Main,Lola,0,0,0,,Namizou...Dialogue: 0,0:05:24.13,0:05:26.37,Main,Lola,0,0,0,,Sen!Dialogue: 0,0:05:26.37,0:05:29.91,Main,Lola,0,0,0,,Bunu bana yapmaya nasıl cüret edersin?!Dialogue: 0,0:05:29.91,0:05:35.21,Main,Lola,0,0,0,,"Ona olan aşkını onaylıyorum."  O sözler yalan mıydı?!Dialogue: 0,0:05:35.80,0:05:39.29,Main,Lola,0,0,0,,Bunca zamandır Ab-sama'yı benden çalmaya çalışıyordun!Dialogue: 0,0:05:39.29,0:05:41.15,Main,Lola,0,0,0,,Ne korkunç birisin!Dialogue: 0,0:05:41.59,0:05:44.34,Main,Nami,0,0,0,,D-Dur, Lola!Dialogue: 0,0:05:44.34,0:05:46.35,Main,Nami,0,0,0,,Bunca zamandır kendimde değildim.Dialogue: 0,0:05:46.35,0:05:47.92,Main,Nami,0,0,0,,Neler olduğunu bilmi-Dialogue: 0,0:05:47.92,0:05:49.44,Main,Nami,0,0,0,,Gelinlik.Dialogue: 0,0:05:49.44,0:05:50.50,Main,Nami,0,0,0,,Niye bunu giyiyorum?Dialogue: 0,0:05:50.50,0:05:51.28,Main,Nami,0,0,0,,Çok güzel!Dialogue: 0,0:05:51.90,0:05:54.55,Main,Lola,0,0,0,,Nesi "güzel", seni hain?!Dialogue: 0,0:05:54.55,0:05:56.90,Main,Nami,0,0,0,,Bunu yanlış anladığını söyledim!Dialogue: 0,0:05:57.22,0:05:58.79,Main,Absalom,0,0,0,,Lola, seni sürtük!Dialogue: 0,0:05:58.79,0:06:02.64,Main,Absalom,0,0,0,,Aniden düğünümü mahvederek ve karıma saldırarak ne yapıyorsun?!Dialogue: 0,0:06:03.75,0:06:05.06,Main,Lola,0,0,0,,Kapa çeneni ve evlen benimle!Dialogue: 0,0:06:05.06,0:06:05.93,Main,Absalom,0,0,0,,Reddediyorum!Dialogue: 0,0:06:07.46,0:06:10.16,Main,Lola,0,0,0,,Ab-sama, bilmiyorsun, değil mi?Dialogue: 0,0:06:11.08,0:06:13.66,Main,Lola,0,0,0,,Bu kadının asıl adı Namizou!Dialogue: 0,0:06:13.66,0:06:16.84,Main,Lola,0,0,0,,Aslında bir erkek!Dialogue: 0,0:06:16.95,0:06:19.39,Main,Absalom,0,0,0,,NE?!Dialogue: 0,0:06:19.67,0:06:21.80,Main,Absalom,0,0,0,,Hayır, bu imkansız!Dialogue: 0,0:06:23.25,0:06:24.63,Thoughts,Nami,0,0,0,,Böyle bir şey demiştim...Dialogue: 0,0:06:26.57,0:06:29.47,Main,Absalom,0,0,0,,Ama onu kesinlikle banyoda gördüm.Dialogue: 0,0:06:35.70,0:06:38.82,Main,Lola,0,0,0,,Defol buradan, Namizou!Dialogue: 0,0:06:38.82,0:06:40.44,Main,Nami,0,0,0,,Kes şunu, Lola!Dialogue: 0,0:06:41.09,0:06:43.36,Main,Absalom,0,0,0,,Hey, sürtük! Kes şunu, Lola!Dialogue: 0,0:06:43.36,0:06:44.48,Thoughts,Nami,0,0,0,,Bana vurmuyor mu?Dialogue: 0,0:06:45.34,0:06:46.30,Main,Lola,0,0,0,,Namizou,...Dialogue: 0,0:06:47.15,0:06:47.93,Main,Nami,0,0,0,,Lola?Dialogue: 0,0:06:48.46,0:06:49.66,Main,Lola,0,0,0,,Kaç, Namizou!Dialogue: 0,0:06:50.23,0:06:52.47,Main,Lola,0,0,0,,Senin için onu tutacağım!Dialogue: 0,0:06:53.23,0:06:55.71,Main,Lola,0,0,0,,Seni kurtarmaya geldim, arkadaşım!Dialogue: 0,0:06:57.60,0:06:58.56,Main,Nami,0,0,0,,Lola!Dialogue: 0,0:06:58.98,0:07:00.23,Main,Lola,0,0,0,,Ab-sama!Dialogue: 0,0:07:01.39,0:07:06.54,Main,Lola,0,0,0,,Şimdi, Absalom! Onunla yer değiştireceğim! Kapanış öpücüğünü bana ver!Dialogue: 0,0:07:07.06,0:07:08.03,Main,Nami,0,0,0,,Lola...Dialogue: 0,0:07:10.61,0:07:11.64,Main,Absalom,0,0,0,,Karım kaçıyor!Dialogue: 0,0:07:12.07,0:07:14.15,Main,Lola,0,0,0,,Karın burada!Dialogue: 0,0:07:14.15,0:07:16.96,Main,Absalom,0,0,0,,Onun kadın olduğu şüphesiz, Lola!Dialogue: 0,0:07:17.47,0:07:20.29,Main,Absalom,0,0,0,,Şimdi yoldan çekil!Dialogue: 0,0:07:24.56,0:07:25.61,Main,Nami,0,0,0,,Lola!Dialogue: 0,0:07:34.35,0:07:36.54,Main,Absalom,0,0,0,,Sadece bir zombi...Dialogue: 0,0:07:37.70,0:07:42.14,Main,Absalom,0,0,0,,...bana manasız güç kullandırıyor!Dialogue: 0,0:07:50.64,0:07:53.22,Main,Absalom,0,0,0,,Aklın başına geldi.Dialogue: 0,0:07:53.22,0:07:55.75,Main,Absalom,0,0,0,,Kaçmayı bıraktın mı?Dialogue: 0,0:07:55.75,0:07:58.07,Main,Absalom,0,0,0,,Evet. Mümkün değil.Dialogue: 0,0:07:59.02,0:08:01.57,Main,Absalom,0,0,0,,Benden kaçamazsın.Dialogue: 0,0:08:02.98,0:08:05.45,Main,Absalom,0,0,0,,Ben Görünmez Adam'ım!Dialogue: 0,0:08:05.79,0:08:07.05,Main,Nami,0,0,0,,Gökgürültüsü Saldırısı!Dialogue: 0,0:08:09.58,0:08:10.77,Main,Nami,0,0,0,,Bu ne cüret?Dialogue: 0,0:08:11.81,0:08:14.44,Flashbacks,Lola,0,0,0,,Seni kurtarmaya geldim, arkadaşım!Dialogue: 0,0:08:15.85,0:08:17.34,Main,Nami,0,0,0,,Lola'ya bunu yapmaya nasıl cüret edersin?!Dialogue: 0,0:08:26.35,0:08:30.12,Main,Absalom,0,0,0,,Evet! Kendini kollarıma at!Dialogue: 0,0:08:30.71,0:08:32.82,Main,Nami,0,0,0,,Sallanan Kol!Dialogue: 0,0:08:35.69,0:08:37.60,Main,Nami,0,0,0,,Sanırım bu işe yaramadı.Dialogue: 0,0:08:38.06,0:08:39.62,Main,Nami,0,0,0,,Zaten biliyordum!Dialogue: 0,0:08:54.02,0:08:55.47,Main,Nami,0,0,0,,Niye?Dialogue: 0,0:08:55.47,0:08:58.05,Main,Nami,0,0,0,,Köprüdeyken onu yaralamamıştı bile.Dialogue: 0,0:08:59.20,0:09:04.61,Thoughts,Zombie,0,0,0,,Demek gerçekten o adamla olan dövüşünde sınırını aşmış.Dialogue: 0,0:09:04.61,0:09:06.12,Thoughts,Zombie,0,0,0,,Bu mantıklı.Dialogue: 0,0:09:06.45,0:09:08.04,Main,Nami,0,0,0,,Neyse.Dialogue: 0,0:09:08.04,0:09:09.32,Main,Nami,0,0,0,,Kazandım!Dialogue: 0,0:09:11.20,0:09:14.20,Main,Nami,0,0,0,,Sanırım zayıf noktasına falan vurdum!Dialogue: 0,0:09:16.17,0:09:16.96,Main,Nami,0,0,0,,Lola!Dialogue: 0,0:09:18.28,0:09:19.22,Main,Nami,0,0,0,,İyi misin?Dialogue: 0,0:09:19.22,0:09:20.19,Main,Nami,0,0,0,,Kendine gel!Dialogue: 0,0:09:22.17,0:09:25.11,Main,Nami,0,0,0,,Bana yardıma geldiğin için sağol.Dialogue: 0,0:09:25.89,0:09:27.94,Main,Lola,0,0,0,,Neden bahsediyorsun, Namizou?Dialogue: 0,0:09:29.79,0:09:31.36,Main,Lola,0,0,0,,Biz arkadaşız, değil mi?Dialogue: 0,0:09:33.30,0:09:37.78,Main,Nami,0,0,0,,Ama senden korktuğumda, sana yalan söyledim.Dialogue: 0,0:09:38.56,0:09:39.42,Main,Nami,0,0,0,,Üzgünüm.Dialogue: 0,0:09:40.29,0:09:42.29,Main,Nami,0,0,0,,Ben aslında kadınım.Dialogue: 0,0:09:44.73,0:09:45.89,Main,Lola,0,0,0,,Aptal.Dialogue: 0,0:09:46.60,0:09:47.89,Main,Lola,0,0,0,,Bunu biliyorum.Dialogue: 0,0:09:48.55,0:09:49.75,Main,Nami,0,0,0,,Lola.Dialogue: 0,0:09:52.15,0:09:54.97,Main,Lola,0,0,0,,Asıl önemlisi, Ab-sama'nın muhafızı yok mu?!Dialogue: 0,0:09:56.12,0:09:59.20,Main,Lola,0,0,0,,Evlen benimle, Absalom!Dialogue: 0,0:10:07.09,0:10:08.89,Main,Oz,0,0,0,,Burada mı?Dialogue: 0,0:10:08.89,0:10:12.02,Main,Oz,0,0,0,,Çık ortaya, Hasır Şapka!Dialogue: 0,0:10:12.02,0:10:13.67,Main,Oz,0,0,0,,Kadın!Dialogue: 0,0:10:13.67,0:10:15.59,Main,Oz,0,0,0,,Şık kahraman!Dialogue: 0,0:10:16.12,0:10:18.30,Main,Sanji,0,0,0,,Adı neydi bunun?Dialogue: 0,0:10:18.30,0:10:19.74,Main,Chopper,0,0,0,,Bir bakalım,...Dialogue: 0,0:10:19.74,0:10:21.74,Main,Zoro,0,0,0,,Ross olduğundan eminim.Dialogue: 0,0:10:21.74,0:10:23.57,Main,Usopp,0,0,0,,Yanlış.Dialogue: 0,0:10:23.57,0:10:26.09,Main,Usopp,0,0,0,,Sonunda "z" vardı.Dialogue: 0,0:10:27.03,0:10:27.95,Main,Chopper,0,0,0,,Hughes?Dialogue: 0,0:10:27.95,0:10:30.66,Main,Usopp,0,0,0,,Yakınlaşmadın bile.Dialogue: 0,0:10:30.66,0:10:31.70,Main,Sanji,0,0,0,,Oss?Dialogue: 0,0:10:32.65,0:10:35.40,Main,Usopp,0,0,0,,Hayır, hala burada doğru olmayan bir şey var.Dialogue: 0,0:10:35.40,0:10:36.39,Main,Robin,0,0,0,,Oz.Dialogue: 0,0:10:36.39,0:10:37.74,Main,All,0,0,0,,Evet!Dialogue: 0,0:10:38.23,0:10:42.19,Main,Brook,0,0,0,,Şey, üzgünüm. Bedenim...Dialogue: 0,0:10:42.19,0:10:44.51,Main,Franky,0,0,0,,Evet, yapacak bir şeyin yok.Dialogue: 0,0:10:44.51,0:10:46.16,Main,Franky,0,0,0,,Biraz çekilebilir misin?Dialogue: 0,0:10:46.16,0:10:46.95,Main,Brook,0,0,0,,Tabii.Dialogue: 0,0:10:46.95,0:10:48.33,Main,Franky,0,0,0,,Sadece yoldan çekil.Dialogue: 0,0:10:49.62,0:10:51.02,Main,Sanji,0,0,0,,Hey, Oz!Dialogue: 0,0:10:56.38,0:10:59.34,Main,Sanji,0,0,0,,Luffy'nin gölgesi gerçekten içindeyse,...Dialogue: 0,0:11:00.34,0:11:06.36,Main,Sanji,0,0,0,,...o zaman arkadaşlarının gücünü hafife almamalısın.Dialogue: 0,0:11:15.87,0:11:19.51,Main,Oz,0,0,0,,Epey sertsiniz, minik korsanlar!Dialogue: 0,0:11:31.03,0:11:33.45,Main,Zoro,0,0,0,,Sizin için bir fikrim var.Dialogue: 0,0:11:34.19,0:11:37.34,Main,Zoro,0,0,0,,Bu herifi uçurmaya ne dersiniz?Dialogue: 0,0:11:38.22,0:11:39.84,Main,Sanji,0,0,0,,Anlıyorum.Dialogue: 0,0:11:40.32,0:11:42.79,Main,Sanji,0,0,0,,Muhtemelen epey harika bir his olurdu.Dialogue: 0,0:11:42.79,0:11:44.16,Main,Usopp,0,0,0,,D-D-Durun biraz!Dialogue: 0,0:11:44.16,0:11:46.32,Main,Usopp,0,0,0,,U-Uçurmak mı?!Dialogue: 0,0:11:46.62,0:11:48.91,Main,Usopp,0,0,0,,Böyle koca bir herifi mi?Dialogue: 0,0:11:50.08,0:11:54.59,Main,Zoro,0,0,0,,Ama dev vücudunun içinde Luffy'nin hareketleri olsa da, epey iyi.Dialogue: 0,0:11:54.59,0:11:57.83,Main,Robin,0,0,0,,Ama "Korsanlar Kralı" ona uymazdı.Dialogue: 0,0:11:58.35,0:12:00.54,Main,Franky,0,0,0,,Onu nasıl deviririz?Dialogue: 0,0:12:00.54,0:12:03.30,Main,Franky,0,0,0,,Deneyeceğim bir sürü plan var.Dialogue: 0,0:12:03.62,0:12:06.04,Main,Chopper,0,0,0,,Bir tür zayıf noktası olmalı.Dialogue: 0,0:12:06.36,0:12:11.11,Main,Sanji,0,0,0,,Koca bir balık olduğu için onu yavaş yavaş yumuşatmalıyım.Dialogue: 0,0:12:11.66,0:12:13.29,Main,Usopp,0,0,0,,Bu bir yana...Dialogue: 0,0:12:14.48,0:12:16.45,Main,Usopp,0,0,0,,...gerçekten korkuyorum.Dialogue: 0,0:12:16.45,0:12:17.45,Main,Oz,0,0,0,,Hepinizi ezeceğim!Dialogue: 0,0:12:17.45,0:12:18.30,Main,Zoro,0,0,0,,Geliyor!Dialogue: 0,0:12:21.26,0:12:23.52,Main,Oz,0,0,0,,Gomu Gomu no...Dialogue: 0,0:12:23.52,0:12:25.10,Main,Oz,0,0,0,,...Dolunay Toslayışı!Dialogue: 0,0:12:26.44,0:12:28.39,Main,Usopp,0,0,0,,Öyle bir şey yok!Dialogue: 0,0:12:28.39,0:12:30.22,Main,Franky,0,0,0,,KAÇIN!Dialogue: 0,0:12:35.50,0:12:36.80,Main,Oz,0,0,0,,Çekiç!Dialogue: 0,0:12:42.02,0:12:43.16,Main,Franky,0,0,0,,Lanet olası!Dialogue: 0,0:12:43.16,0:12:45.41,Main,Franky,0,0,0,,Böyleyse, sana göstereceğiz!Dialogue: 0,0:12:45.41,0:12:48.26,Main,Franky,0,0,0,,En iyi birleşik gücümüzü!Dialogue: 0,0:12:49.15,0:12:50.21,Main,Franky,0,0,0,,Çocuklar!Dialogue: 0,0:12:50.21,0:12:51.50,Main,Franky,0,0,0,,Yapalım!Dialogue: 0,0:12:51.76,0:12:54.27,Main,Franky,0,0,0,,Taktik 15!Dialogue: 0,0:12:55.17,0:12:56.27,Main,Usopp,0,0,0,,Ne?!Dialogue: 0,0:12:57.12,0:12:58.22,Main,Chopper,0,0,0,,Olamaz!Dialogue: 0,0:12:58.22,0:13:00.16,Main,Chopper,0,0,0,,Onu şimdi, burada mı kullanacağız?!Dialogue: 0,0:13:00.54,0:13:01.20,Main,Franky,0,0,0,,Zoro!Dialogue: 0,0:13:01.20,0:13:01.80,Main,Franky,0,0,0,,Kıvırcık!Dialogue: 0,0:13:01.80,0:13:02.66,Main,Franky,0,0,0,,Beklemede kalın!Dialogue: 0,0:13:03.80,0:13:05.65,Main,Franky,0,0,0,,Sadece bacaklarıma tutunun!Dialogue: 0,0:13:06.24,0:13:08.53,Main,Sanji,0,0,0,,Ne yapmaya çalışıyor bu?Dialogue: 0,0:13:08.53,0:13:10.06,Main,Franky,0,0,0,,İşte geliyorum!Dialogue: 0,0:13:21.24,0:13:23.66,Main,Chopper,0,0,0,,Korsan Kenetlenişi Altı!Dialogue: 0,0:13:23.95,0:13:25.40,Main,Usopp,0,0,0,,Dev Robot Savaşçı!Dialogue: 0,0:13:25.96,0:13:29.84,Main,Franky,0,0,0,,Büyük İmparator!Dialogue: 0,0:13:33.49,0:13:35.09,Main,Chopper,0,0,0,,Dur biraz, Franky!Dialogue: 0,0:13:35.09,0:13:38.23,Main,Chopper,0,0,0,,Sol kolumuz hala kenetlenmemiş!Dialogue: 0,0:13:38.23,0:13:41.40,Main,Franky,0,0,0,,NE?!Dialogue: 0,0:13:41.66,0:13:43.50,Main,Franky,0,0,0,,Hey, ne yapıyorsun, Nico Robin?!Dialogue: 0,0:13:43.50,0:13:45.86,Main,Franky,0,0,0,,Hemen sol koluma kenetlen!Dialogue: 0,0:13:45.86,0:13:47.34,Main,Chopper,0,0,0,,Robin! Acele et!Dialogue: 0,0:13:47.34,0:13:48.42,Main,Usopp,0,0,0,,Gel, Robin!Dialogue: 0,0:13:48.42,0:13:49.67,Main,Usopp,0,0,0,,Aynı benim gibi yap!Dialogue: 0,0:13:50.14,0:13:52.09,Main,Robin,0,0,0,,Çok utanç verici olurdu.Dialogue: 0,0:13:56.84,0:13:58.48,Main,Oz,0,0,0,,Yapmayacak mısınız?!Dialogue: 0,0:13:58.48,0:14:00.64,Main,Sanji,0,0,0,,Hey, niye sen de şok oldun?Dialogue: 0,0:14:00.64,0:14:02.29,Main,Oz,0,0,0,,O kadar da heyecanlanmıştım!Dialogue: 0,0:14:03.00,0:14:05.10,Main,Oz,0,0,0,,Yapın!Dialogue: 0,0:14:05.10,0:14:07.68,Main,Oz,0,0,0,,Kenetlenişi!Dialogue: 0,0:14:10.99,0:14:14.77,Main,Zoro,0,0,0,,Cidden! Demin bana ne yaptırttı öyle?!Dialogue: 0,0:14:15.06,0:14:16.93,Main,Zoro,0,0,0,,Hayır, unutmak en iyisi!Dialogue: 0,0:14:18.24,0:14:22.93,Main,Franky,0,0,0,,Robin, sen de katılsaydın, Robot Savaşçı Büyük İmparator olabilirdik!Dialogue: 0,0:14:22.93,0:14:25.53,Main,Chopper,0,0,0,,Bize ihanet ettiğine inanamıyorum! İnanamıyorum!Dialogue: 0,0:14:25.53,0:14:28.25,Main,Usopp,0,0,0,,Luffy olsaydı, kesinlikle katılırdı!Dialogue: 0,0:14:28.81,0:14:32.42,Main,Robin,0,0,0,,Şu "Kenetleniş" i bir daha asla denemeyin.Dialogue: 0,0:14:35.99,0:14:38.66,Main,Franky,0,0,0,,Bir kez daha deneyelim, pislik!Dialogue: 0,0:14:39.15,0:14:40.02,Main,Zoro,0,0,0,,Franky!Dialogue: 0,0:14:41.20,0:14:43.53,Main,Zoro,0,0,0,,Bu koca şeyleri ödünç alıyorum!Dialogue: 0,0:14:46.47,0:14:48.37,Main,Franky,0,0,0,,Pislik! Ağır Mınçıkalarım!Dialogue: 0,0:14:48.67,0:14:49.80,Main,Franky,0,0,0,,Yapacak bir şey yok!Dialogue: 0,0:14:49.80,0:14:50.72,Main,Franky,0,0,0,,Veriyorum o zaman!Dialogue: 0,0:14:51.84,0:14:53.31,Main,Sanji,0,0,0,,Pislik!Dialogue: 0,0:14:53.85,0:14:58.11,Main,Sanji,0,0,0,,Bir an önce Nami-san'ı tekrardan kurtarmaya gitmeliyim!Dialogue: 0,0:15:04.52,0:15:06.06,Main,Oz,0,0,0,,Sen miydin?!Dialogue: 0,0:15:06.92,0:15:07.95,Main,Zoro,0,0,0,,Robin!Dialogue: 0,0:15:09.32,0:15:13.31,Main,Zoro,0,0,0,,Sol kolunu halledeceğim! Sen işi bitir!Dialogue: 0,0:15:14.87,0:15:15.86,Main,Robin,0,0,0,,Anlaşıldı.Dialogue: 0,0:15:26.27,0:15:27.51,Main,Zombie,0,0,0,,Perona-sama!Dialogue: 0,0:15:27.84,0:15:31.88,Main,Zombie,0,0,0,,Buzdolabı ağzına kadar doldu!Dialogue: 0,0:15:31.88,0:15:34.05,Main,Pelona,0,0,0,,Daha kiler var!Dialogue: 0,0:15:34.05,0:15:34.84,Main,Zombie,0,0,0,,Peki!Dialogue: 0,0:15:35.53,0:15:37.27,Main,Pelona,0,0,0,,Hazineyi de bir an önce getirin!Dialogue: 0,0:15:37.27,0:15:39.58,Main,Pelona,0,0,0,,Hepsini getirdiğinizden emin olun!Dialogue: 0,0:15:39.58,0:15:41.64,Main,Zombies,0,0,0,,Tamam!Dialogue: 0,0:15:42.12,0:15:43.19,Main,Usopp,0,0,0,,Al bakalım!Dialogue: 0,0:15:43.42,0:15:45.62,Main,Usopp,0,0,0,,Kesin Öldürücü Özel Yağ Yıldızı!Dialogue: 0,0:15:46.02,0:15:47.60,Main,Usopp,0,0,0,,ÜçDialogue: 0,0:15:46.54,0:15:47.60,Main,Usopp,0,0,0,,TurlukDialogue: 0,0:15:46.98,0:15:47.60,Main,Usopp,0,0,0,,Ceza!Dialogue: 0,0:15:53.55,0:15:54.87,Main,Zoro,0,0,0,,Hey, Kıvırcık!Dialogue: 0,0:15:55.26,0:15:56.66,Main,Zoro,0,0,0,,Beni yukarı fırlat!Dialogue: 0,0:15:56.66,0:15:59.70,Main,Sanji,0,0,0,,Sen! O koca şeyle mi?Dialogue: 0,0:15:59.70,0:16:01.51,Main,Zoro,0,0,0,,Yapamıyorsan önemli değil!Dialogue: 0,0:16:02.72,0:16:03.93,Main,Sanji,0,0,0,,Pislik!Dialogue: 0,0:16:03.93,0:16:05.31,Main,Sanji,0,0,0,,Elbette yapabilirim, sersem!Dialogue: 0,0:16:06.11,0:16:07.98,Main,Sanji,0,0,0,,Armée de l'Air...Dialogue: 0,0:16:06.11,0:16:07.98,Note,Note,0,0,0,,Hava KuvvetleriDialogue: 0,0:16:09.26,0:16:11.82,Main,Sanji,0,0,0,,...Güç Vuruşu!Dialogue: 0,0:16:14.44,0:16:16.70,Main,Zoro,0,0,0,,Büyük Kendo!Dialogue: 0,0:16:21.99,0:16:23.56,Main,Robin,0,0,0,,Cien Fleur...Dialogue: 0,0:16:21.99,0:16:23.56,Note,Note,0,0,0,,100 Çiçek!Dialogue: 0,0:16:27.84,0:16:29.07,Main,Robin,0,0,0,,Büyük Ağaç!Dialogue: 0,0:16:30.72,0:16:32.10,Main,Oz,0,0,0,,N-Ne?Dialogue: 0,0:16:38.91,0:16:41.73,Main,Oz,0,0,0,,T-Tehlikeli... Düşeceğim! Düşeceğim!Dialogue: 0,0:16:41.73,0:16:43.38,Main,Franky,0,0,0,,Şuna bir bakın!Dialogue: 0,0:16:43.38,0:16:48.02,Main,Franky,0,0,0,,Havadaki Süper Merdiven Bina'ya!Dialogue: 0,0:16:48.43,0:16:53.82,Main,Franky,0,0,0,,Franky Gök Yürüyüşü!Dialogue: 0,0:16:54.75,0:16:57.96,Main,Franky,0,0,0,,Ama fazla sürmeyecek!Dialogue: 0,0:16:58.20,0:17:00.14,Main,Franky,0,0,0,,Harekete geçelim, Chopper!Dialogue: 0,0:17:00.85,0:17:02.07,Main,Chopper,0,0,0,,Tamam!Dialogue: 0,0:17:04.98,0:17:08.19,Main,Both,0,0,0,,Süper...Dialogue: 0,0:17:08.56,0:17:10.66,Main,Both,0,0,0,,...Fra-pper...Dialogue: 0,0:17:10.66,0:17:11.57,Main,Both,0,0,0,,...Gonk!Dialogue: 0,0:17:18.16,0:17:21.12,Main,Chopper,0,0,0,,Ne kadar büyük olursa olsun, bir insanın zayıf noktaları asla değişmez!Dialogue: 0,0:17:21.61,0:17:24.59,Main,Chopper,0,0,0,,Çenene vurursak, başın dönecek!Dialogue: 0,0:17:30.92,0:17:34.43,Main,Sanji,0,0,0,,Seni ayakta tutan tek şey, şu tek bacağın.Dialogue: 0,0:17:35.82,0:17:37.55,Main,Sanji,0,0,0,,Canavar Luffy!Dialogue: 0,0:17:39.50,0:17:41.32,Main,Sanji,0,0,0,,Görgüsüz...Dialogue: 0,0:17:42.62,0:17:43.84,Main,Sanji,0,0,0,,Tekme...Dialogue: 0,0:17:45.51,0:17:47.45,Main,Sanji,0,0,0,,...Servisi!Dialogue: 0,0:17:51.35,0:17:53.65,Main,Zoro,0,0,0,,Yere düş, canavar!Dialogue: 0,0:17:53.65,0:17:55.55,Main,Franky,0,0,0,,Tamam! Hadi!Dialogue: 0,0:18:02.34,0:18:04.26,Main,Sanji,0,0,0,,Biri gitti.Dialogue: 0,0:18:07.30,0:18:11.34,Main,Zombie,0,0,0,,Hey, hey! Malikâne parçalara ayrılıyor!Dialogue: 0,0:18:11.77,0:18:13.96,Main,Zombie,0,0,0,,Ne yaptığını sanıyor bu?Dialogue: 0,0:18:13.96,0:18:15.04,Main,Zombie,0,0,0,,Akrobasi mi?!Dialogue: 0,0:18:15.33,0:18:17.98,Main,Zombie,0,0,0,,H-Ha? Yoksa...Dialogue: 0,0:18:17.98,0:18:20.44,Main,Zombie,0,0,0,,...biri tarafından mı uçuruldu?Dialogue: 0,0:18:20.44,0:18:23.78,Main,Zombie,0,0,0,,Hadi ama! Konuşmadan önce düşün biraz!Dialogue: 0,0:18:23.78,0:18:26.47,Main,Zombie,0,0,0,,Bin kişilik orduyla bile imkansız!Dialogue: 0,0:18:34.43,0:18:37.29,Main,Lola,0,0,0,,İyiyim, Namizou!Dialogue: 0,0:18:37.29,0:18:39.62,Main,Lola,0,0,0,,Hemen buradan kaç!Dialogue: 0,0:18:39.62,0:18:42.37,Main,Lola,0,0,0,,Adadaki şu anki durumu sana anlatacağım.Dialogue: 0,0:18:42.78,0:18:43.83,Main,Nami,0,0,0,,Lola...Dialogue: 0,0:18:43.83,0:18:46.88,Main,Lola,0,0,0,,Arkadaşın Hasır Şapkalı Luffy'nin gölgesi...Dialogue: 0,0:18:46.88,0:18:52.09,Main,Lola,0,0,0,,...şu an adanın altını üstüne getirmekte olan Özel Zombi'nin içine yerleştirildi!Dialogue: 0,0:18:55.25,0:18:57.37,Main,Nami,0,0,0,,Demek Dondurucu Odası'nda gördüğüm o dev zombi!Dialogue: 0,0:18:57.37,0:18:58.75,Main,Nami,0,0,0,,Bu tam bir sorun!Dialogue: 0,0:18:58.75,0:19:01.36,Main,Nami,0,0,0,,Öyle bir şeyden Luffy'nin gölgesini geri alabilir miyiz?!Dialogue: 0,0:19:01.89,0:19:02.64,Main,Nami,0,0,0,,Ama...Dialogue: 0,0:19:02.95,0:19:07.06,Main,Nami,0,0,0,,...bakmam gereken başka şeyler var!Dialogue: 0,0:19:07.39,0:19:08.52,Main,Nami,0,0,0,,Burada!Dialogue: 0,0:19:08.52,0:19:09.56,Main,Nami,0,0,0,,Hazine içeride!Dialogue: 0,0:19:26.13,0:19:29.81,Main,Oz,0,0,0,,Sizi pislikler!Dialogue: 0,0:19:29.81,0:19:32.18,Main,Oz,0,0,0,,Şimdi kızdım işte!Dialogue: 0,0:19:32.18,0:19:38.42,Main,Oz,0,0,0,,Hepinizin canına okuyacağım!Dialogue: 0,0:19:42.89,0:19:47.07,Thoughts,Pelona,0,0,0,,En azından yolun yarısında Moria-sama'nın yanında kaldım.Dialogue: 0,0:19:47.07,0:19:50.90,Thoughts,Pelona,0,0,0,,Hayatım gerçekten tehlikeye girene kadar burada kaldım.Dialogue: 0,0:19:52.90,0:19:54.85,Main,Pelona,0,0,0,,Kıpırdayın biraz çocuklar!Dialogue: 0,0:19:54.85,0:19:57.24,Main,Pelona,0,0,0,,En hızlı şekilde buradan çıkıyoruz!Dialogue: 0,0:19:57.24,0:19:58.98,Main,Zombie,0,0,0,,Emredersiniz!Dialogue: 0,0:19:59.49,0:20:03.18,Main,Zombie,0,0,0,,Tamam! Hemen her şeyi buraya getirin!Dialogue: 0,0:20:09.13,0:20:10.77,Main,Bunny,0,0,0,,Sen de kimsin?Dialogue: 0,0:20:10.77,0:20:12.22,Main,Bunny,0,0,0,,Zombi değilsin, değil mi?Dialogue: 0,0:20:12.22,0:20:13.82,Main,Bunny,0,0,0,,Burada ne yapıyorsun?Dialogue: 0,0:20:14.20,0:20:16.54,Main,Bunny,0,0,0,,Dev gibi orada durmuş.Dialogue: 0,0:20:16.54,0:20:18.43,Main,Bunny,0,0,0,,Bu pislik neredeyse ayıya benziyor!Dialogue: 0,0:20:20.13,0:20:21.76,Main,Kuma,0,0,0,,Ayı, ha?Dialogue: 0,0:20:22.36,0:20:25.17,Main,Kuma,0,0,0,,Kesinlikle doğru tahmin ettiniz.Dialogue: 0,0:20:25.97,0:20:27.23,Main,Kuma,0,0,0,,Moria...Dialogue: 0,0:20:28.11,0:20:30.64,Main,Kuma,0,0,0,,...burada mı?