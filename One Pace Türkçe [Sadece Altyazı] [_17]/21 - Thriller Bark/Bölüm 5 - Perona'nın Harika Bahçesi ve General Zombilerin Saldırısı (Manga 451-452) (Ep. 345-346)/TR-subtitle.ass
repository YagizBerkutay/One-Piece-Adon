Dialogue: 0,0:02:29.87,0:02:38.62,Title,,0,0,0,,{\fad(1800,2000)}Perona'nın Harika Bahçesi ve\NGeneral Zombilerin Saldırısı
Dialogue: 0,0:02:39.13,0:02:43.60,Main,Absalom,0,0,0,,Nereye kaçmaya çalışırlarsa çalışsınlar,\Nizlerini sürün ve buraya sürükleyin!
Dialogue: 0,0:02:43.60,0:02:46.14,Main,Absalom,0,0,0,,Kimse Zombi Generaller'e denk olamaz!
Dialogue: 0,0:02:48.77,0:02:51.65,Main,Absalom,0,0,0,,Hey, zaman kaybetmeyi bırak, Kaptan John.
Dialogue: 0,0:02:51.65,0:02:54.66,Main,Absalom,0,0,0,,Yaşarkenki kötü şöhretinin hakkını vermiyorsun.
Dialogue: 0,0:02:54.66,0:02:56.51,Main,John,0,0,0,,Tamam, tamam. Gidiyorum.
Dialogue: 0,0:02:57.86,0:03:00.57,Main,Absalom,0,0,0,,Cidden hiç değişmiyor.
Dialogue: 0,0:03:00.57,0:03:02.03,Main,Lola,0,0,0,,Ab-sama.
Dialogue: 0,0:03:02.03,0:03:03.56,Main,Lola,0,0,0,,Evlen benimle!
Dialogue: 0,0:03:04.72,0:03:05.56,Main,Absalom,0,0,0,,Lola!
Dialogue: 0,0:03:05.56,0:03:08.17,Main,Absalom,0,0,0,,Sen! Hemen git ve dövüş!
Dialogue: 0,0:03:08.17,0:03:09.62,Main,Absalom,0,0,0,,Ben komutanınım!
Dialogue: 0,0:03:09.62,0:03:10.84,Main,Lola,0,0,0,,O zaman evlen benimle.
Dialogue: 0,0:03:10.84,0:03:11.62,Main,Absalom,0,0,0,,Niye evleneyim?!
Dialogue: 0,0:03:17.23,0:03:19.98,Main,Absalom,0,0,0,,Lola, sen ne...
Dialogue: 0,0:03:19.98,0:03:23.16,Main,Absalom,0,0,0,,Büyük Ab-sama'nın emirlerini dinlemeyecek misin?!
Dialogue: 0,0:03:23.16,0:03:24.69,Main,Lola,0,0,0,,O zaman evlen benimle!
Dialogue: 0,0:03:24.69,0:03:25.78,Main,Absalom,0,0,0,,Bırak şakayı!
Dialogue: 0,0:03:25.78,0:03:27.36,Main,Absalom,0,0,0,,Ben insanım!
Dialogue: 0,0:03:27.36,0:03:29.90,Main,Absalom,0,0,0,,İnsan karım olmalı!
Dialogue: 0,0:03:30.48,0:03:32.69,Main,Absalom,0,0,0,,Hey, Lola. Bunu bir düşün.
Dialogue: 0,0:03:32.69,0:03:35.33,Main,Absalom,0,0,0,,Sen dişi bir yaban domuzu zombisin.
Dialogue: 0,0:03:35.33,0:03:37.37,Main,Absalom,0,0,0,,Ölüsün ve çürüyorsun!
Dialogue: 0,0:03:41.13,0:03:42.78,Main,Absalom,0,0,0,,Kes şunu!
Dialogue: 0,0:03:43.56,0:03:46.41,Main,Absalom,0,0,0,,Hey, ne korkutucu bir yöntem!
Dialogue: 0,0:03:46.41,0:03:48.82,Main,Absalom,0,0,0,,O evlilik akdi değil mi?!
Dialogue: 0,0:03:48.82,0:03:52.04,Main,Absalom,0,0,0,,Beni seninle evlenmeye zorladığını düşünmek...
Dialogue: 0,0:03:52.04,0:03:56.04,Main,Lola,0,0,0,,Vahşi hayvan burnuna karşı koyamıyorum.
Dialogue: 0,0:03:56.04,0:03:59.14,Main,Lola,0,0,0,,Absalom, bana parmağını ver.
Dialogue: 0,0:03:59.14,0:03:59.88,Main,Lola,0,0,0,,Seni seviyorum!
Dialogue: 0,0:04:01.08,0:04:02.35,Main,Absalom,0,0,0,,Benimle uğraşma!
Dialogue: 0,0:04:02.35,0:04:05.76,Main,Absalom,0,0,0,,Günlerimi ölü bir hayvan tarafından\Nrahatsız edilerek geçirmek istemiyorum!
Dialogue: 0,0:04:05.76,0:04:07.10,Main,Lola,0,0,0,,{\fad(150,150)}Gelin Dövüş Sanatları!
Dialogue: 0,0:04:07.10,0:04:08.64,Main,Lola,0,0,0,,{\fad(150,150)}Sonsuz Yemin Öpücüğü!
Dialogue: 0,0:04:17.54,0:04:18.41,Main,Absalom,0,0,0,,Dur, Lola!
Dialogue: 0,0:04:18.41,0:04:19.57,Main,Absalom,0,0,0,,İyi dinle.
Dialogue: 0,0:04:20.18,0:04:21.58,Main,Absalom,0,0,0,,Ben zaten...
Dialogue: 0,0:04:21.58,0:04:24.96,Main,Absalom,0,0,0,,Ben zaten karım olacak kadını seçtim!
Dialogue: 0,0:04:24.96,0:04:29.31,Main,Absalom,0,0,0,,Kesinlikle sert bir mizacı var ama sonuçta\Net ve kandan oluşan güçsüz bir kadın!
Dialogue: 0,0:04:30.30,0:04:32.13,Main,Lola,0,0,0,,Sonuçta yine başarısız olacaksın.
Dialogue: 0,0:04:32.13,0:04:33.16,Main,Absalom,0,0,0,,Aptal, bak!
Dialogue: 0,0:04:33.80,0:04:38.71,Main,Absalom,0,0,0,,Bu adaya çıkan korsanlardan biri, benim gibi\Nyakışıklı bir adamın karısı olmaya çok uygun.
Dialogue: 0,0:04:38.71,0:04:40.41,Main,Lola,0,0,0,,Bunun olmasına izin vermeyeceğim!
Dialogue: 0,0:04:40.41,0:04:42.42,Main,Lola,0,0,0,,O kadından...
Dialogue: 0,0:04:42.42,0:04:43.74,Main,Lola,0,0,0,,...kurtulacağım!
Dialogue: 0,0:04:45.01,0:04:46.12,Main,Absalom,0,0,0,,Dur!
Dialogue: 0,0:04:46.12,0:04:48.80,Main,Absalom,0,0,0,,Lola!
Dialogue: 0,0:04:50.80,0:04:52.21,Main,Perona,0,0,0,,Hey, Ayıcık!
Dialogue: 0,0:04:52.21,0:04:54.60,Main,Perona,0,0,0,,Ayıcık!
Dialogue: 0,0:04:55.04,0:04:58.00,Main,Perona,0,0,0,,Tehlikeli Kardeşler buraya bir tabut getiriyor.
Dialogue: 0,0:04:58.00,0:05:01.59,Main,Perona,0,0,0,,Onu alınca efendinin Dans Salonu'na götür!
Dialogue: 0,0:05:01.59,0:05:02.32,Main,Perona,0,0,0,,Anladın mı?
Dialogue: 0,0:05:04.08,0:05:06.40,Main,Perona,0,0,0,,Anladın mı, anlamadın mı?!
Dialogue: 0,0:05:06.40,0:05:07.09,Main,Kumashi,0,0,0,,Evet.
Dialogue: 0,0:05:07.09,0:05:10.24,Main,Perona,0,0,0,,Cevap verme, bu hiç hoş değil!
Dialogue: 0,0:05:10.24,0:05:14.12,Main,Perona,0,0,0,,Şu andan itibaren hazine toplama grubuna\Ngemiye doğru ben önderlik edeceğim.
Dialogue: 0,0:05:14.67,0:05:17.29,Main,Perona,0,0,0,,Bir şey olursa gelip bana söyle, tamam mı?
Dialogue: 0,0:05:19.79,0:05:22.96,Main,Perona,0,0,0,,İşte bu, bir şey söylemediğinde çok sevimlisin!
Dialogue: 0,0:05:23.55,0:05:25.33,Main,Kumashi,0,0,0,,İyi yolculuklar.
Dialogue: 0,0:05:25.33,0:05:28.04,Main,Perona,0,0,0,,Sen! Şimdi konuştun!
Dialogue: 0,0:05:33.16,0:05:36.62,Main,Squirrel,0,0,0,,Oraya götür! Oraya götür! Efendi'nin İni'ne!
Dialogue: 0,0:05:41.46,0:05:43.56,Main,Squirrel,0,0,0,,Olamaz! Düşürdük!
Dialogue: 0,0:05:43.56,0:05:44.94,Main,Squirrel,0,0,0,,Olamaz! Kırdık!
Dialogue: 0,0:05:44.94,0:05:47.25,Main,Squirrel,0,0,0,,Efendimizin teslimatını!
Dialogue: 0,0:05:48.98,0:05:51.24,Main,Squirrel,0,0,0,,Tabut açıldı!
Dialogue: 0,0:05:51.24,0:05:52.54,Main,Chopper,0,0,0,,Ha? Neredeyim ben?
Dialogue: 0,0:05:52.54,0:05:53.25,Main,Squirrel,0,0,0,,Uyandı!
Dialogue: 0,0:05:53.25,0:05:53.87,Main,Squirrel,0,0,0,,Kahretsin!
Dialogue: 0,0:05:53.87,0:05:55.92,Main,Squirrel,0,0,0,,Hemen vur ona! Ölümüne vur!
Dialogue: 0,0:05:55.92,0:05:57.09,Main,Squirrel,0,0,0,,Öldürmek kötüdür!
Dialogue: 0,0:05:57.09,0:05:58.08,Main,Squirrel,0,0,0,,O zaman yarı öldür!
Dialogue: 0,0:05:58.08,0:05:59.21,Main,Squirrel,0,0,0,,Yarı öldür!
Dialogue: 0,0:06:03.81,0:06:04.48,Main,Chopper,0,0,0,,Usopp!
Dialogue: 0,0:06:04.48,0:06:05.48,Main,Chopper,0,0,0,,Nami!
Dialogue: 0,0:06:05.48,0:06:06.80,Main,Chopper,0,0,0,,Hey, dayanın!
Dialogue: 0,0:06:07.07,0:06:08.51,Main,Chopper,0,0,0,,Uyanın!
Dialogue: 0,0:06:11.87,0:06:14.85,Main,Usopp,0,0,0,,Samuray kesinlikle...
Dialogue: 0,0:06:14.85,0:06:17.06,Main,Usopp,0,0,0,,Bize kılıcının tersiyle mi vurdu?
Dialogue: 0,0:06:17.53,0:06:20.27,Main,Nami,0,0,0,,Görünüşe göre burada yağmur yağıyormuş.
Dialogue: 0,0:06:20.27,0:06:21.98,Main,Nami,0,0,0,,Yer biraz ıslak.
Dialogue: 0,0:06:21.98,0:06:23.24,Main,Nami,0,0,0,,Neredeyiz?
Dialogue: 0,0:06:23.24,0:06:24.60,Main,Chopper,0,0,0,,Bilmiyorum ama...
Dialogue: 0,0:06:24.60,0:06:28.17,Main,Chopper,0,0,0,,...teslim edilmemiz için şu sincaplar bizi tabutta taşıyordu.
Dialogue: 0,0:06:29.35,0:06:30.80,Main,Usopp,0,0,0,,Bu demir bir tabut mu?!
Dialogue: 0,0:06:31.07,0:06:33.49,Main,Squirrel,0,0,0,,Olamaz, üçü de uyanmış!
Dialogue: 0,0:06:33.49,0:06:35.45,Main,Squirrel,0,0,0,,Durum kötü. Arkadaşlarımızı çağıralım!
Dialogue: 0,0:06:35.69,0:06:38.72,Main,Nami,0,0,0,,Şu anda malikânenin arkasında gibiyiz.
Dialogue: 0,0:06:38.72,0:06:41.96,Main,Nami,0,0,0,,Hogback'in Araştırma Odası en üst kattaydı.
Dialogue: 0,0:06:41.96,0:06:44.96,Main,Nami,0,0,0,,Şimdiden bizi epey uzağa taşımış gibiler.
Dialogue: 0,0:06:44.96,0:06:45.88,Main,Chopper,0,0,0,,Hey, arkanıza bakın!
Dialogue: 0,0:06:46.91,0:06:50.97,Main,Chopper,0,0,0,,Diğer tarafta sağlam bir bina var!
Dialogue: 0,0:06:50.97,0:06:52.80,Main,Usopp,0,0,0,,O da ne?
Dialogue: 0,0:06:53.36,0:06:57.50,Main,Usopp,0,0,0,,Bunca zamandır malikânenin arkasında koca bir bina mı vardı?
Dialogue: 0,0:06:58.70,0:07:01.26,Main,Nami,0,0,0,,Nerede olduğumuzu anladım!
Dialogue: 0,0:07:02.00,0:07:02.65,Main,Usopp,0,0,0,,Neresi?
Dialogue: 0,0:07:03.31,0:07:05.06,Main,Usopp,0,0,0,,Ne demek istiyorsun?
Dialogue: 0,0:07:05.67,0:07:10.24,Main,Nami,0,0,0,,Malikâneyi büyük binaya bağlayan geçitteyiz.
Dialogue: 0,0:07:10.24,0:07:11.85,Main,Usopp,0,0,0,,Geçit?
Dialogue: 0,0:07:11.85,0:07:15.35,Main,Usopp,0,0,0,,Çok geniş, neredeyse orman gibi.
Dialogue: 0,0:07:15.35,0:07:22.46,Main,Usopp,0,0,0,,Orman yapılmış olsa bile, biz baygınken\Ntabutumuzu buraya taşıyorlardı.
Dialogue: 0,0:07:23.07,0:07:27.64,Main,Usopp,0,0,0,,Yani bizi o binaya taşımaları gerekiyordu.
Dialogue: 0,0:07:27.64,0:07:31.65,Main,Nami,0,0,0,,Orası muhtemelen zombilerin yapıldığı yer.
Dialogue: 0,0:07:33.12,0:07:34.70,Main,Chopper,0,0,0,,Uyandığımıza sevindim!
Dialogue: 0,0:07:34.70,0:07:35.34,Main,Chopper,0,0,0,,Kaçalım!
Dialogue: 0,0:07:35.34,0:07:37.36,Main,Usopp,0,0,0,,Evet, hemen kaçalım!
Dialogue: 0,0:07:37.36,0:07:38.27,Main,Nami,0,0,0,,Durun biraz!
Dialogue: 0,0:07:39.71,0:07:45.73,Main,Nami,0,0,0,,Korktuğumuz için hiç hazine almadık\Nve bağırarak koşmaya başladık.
Dialogue: 0,0:07:45.73,0:07:46.43,Main,Nami,0,0,0,,Doğru değil mi?
Dialogue: 0,0:07:46.43,0:07:48.26,Main,Usopp,0,0,0,,Ne düşünüyorsun, aptal?!
Dialogue: 0,0:07:48.26,0:07:51.65,Main,Chopper,0,0,0,,"Bir sorun var" sensörüm büyük bir tepki alıyor!
Dialogue: 0,0:07:51.65,0:07:53.83,Main,Usopp,0,0,0,,Kaçalım, Nami!
Dialogue: 0,0:07:53.83,0:07:55.60,Main,Chopper,0,0,0,,Evet! Evet!
Dialogue: 0,0:07:55.60,0:07:57.42,Main,,0,0,0,,Kaçalım! Kaçalım!
Dialogue: 0,0:07:54.79,0:07:58.43,Thoughts,Nami,0,0,0,,{\i1}O sırada zombilerin ne dediğini açıkça hatırlıyorum.{\i0}
Dialogue: 0,0:08:00.52,0:08:01.75,Flashbacks,Zombie,0,0,0,,Çok yazık!
Dialogue: 0,0:08:01.75,0:08:03.93,Flashbacks,Zombie,0,0,0,,Hazine deposu burada değil!
Dialogue: 0,0:08:05.24,0:08:07.71,Main,Usopp,0,0,0,,Faydasız şeyler düşünmeyi bırak, kaçalım!
Dialogue: 0,0:08:07.71,0:08:09.63,Main,Chopper,0,0,0,,Kaçalım, Nami!
Dialogue: 0,0:08:09.63,0:08:10.63,Main,Nami,0,0,0,,Ne kadar aptalca!
Dialogue: 0,0:08:10.63,0:08:13.51,Main,Nami,0,0,0,,Nihayet anlıyorum! O sırada çok korkmuştum!
Dialogue: 0,0:08:13.51,0:08:15.16,Main,Both,0,0,0,,Tuhaf bakan gözler!
Dialogue: 0,0:08:15.87,0:08:17.63,Main,Nami,0,0,0,,O zaman nereye kaçıyoruz?
Dialogue: 0,0:08:17.63,0:08:18.29,Main,Nami,0,0,0,,İeriye?
Dialogue: 0,0:08:18.29,0:08:19.10,Main,Nami,0,0,0,,Geriye?
Dialogue: 0,0:08:19.91,0:08:21.53,Main,Usopp,0,0,0,,Zor bir karar.
Dialogue: 0,0:08:21.53,0:08:25.62,Main,Usopp,0,0,0,,Malikâneye dönersek, büyük ihtimalle o samurayla yine karşılaşacağız.
Dialogue: 0,0:08:25.62,0:08:29.84,Main,Chopper,0,0,0,,Ama ileri gidersek daha da korkunç kimselere rastlayabiliriz.
Dialogue: 0,0:08:33.55,0:08:36.69,Main,Nami,0,0,0,,Bu küçük hayvanlar da ne?
Dialogue: 0,0:08:36.69,0:08:37.24,Main,Nami,0,0,0,,Penguenler?
Dialogue: 0,0:08:37.68,0:08:38.93,Main,Penguin 1,0,0,0,,Numaralar!
Dialogue: 0,0:08:38.93,0:08:39.54,Main,Penguin 1,0,0,0,,Bir!
Dialogue: 0,0:08:39.89,0:08:40.47,Main,Penguin 2,0,0,0,,İki!
Dialogue: 0,0:08:40.81,0:08:41.66,Main,Sanji-pen,0,0,0,,Üç!
Dialogue: 0,0:08:42.21,0:08:44.67,Thoughts,NUC,0,0,0,,Hayır...
Dialogue: 0,0:08:44.92,0:08:47.09,Main,Penguin 1,0,0,0,,Merhaba, biz...
Dialogue: 0,0:08:47.09,0:08:48.72,Main,Penguin 2,0,0,0,,...Zombi Penguen Bir-
Dialogue: 0,0:08:48.72,0:08:50.16,Main,Penguin 2,0,0,0,,Ah, yanlış dedim.
Dialogue: 0,0:08:50.16,0:08:51.56,Main,Sanji-pen,0,0,0,,Üçlü! Biz üçlüyüz!
Dialogue: 0,0:08:51.56,0:08:52.63,Main,Sanji-pen,0,0,0,,Ben yeniyim!
Dialogue: 0,0:08:52.63,0:08:55.17,Main,Usopp,0,0,0,,Böyle üye bilgisi umrumuzda mı sanki?!
Dialogue: 0,0:08:55.17,0:08:57.97,Main,Penguin 1,0,0,0,,Arkanızdakiler...
Dialogue: 0,0:08:57.97,0:08:58.62,Main,All,0,0,0,,Olamaz.
Dialogue: 0,0:08:58.62,0:09:01.02,Main,Penguin 1,0,0,0,,...arkadaşlarımız Vahşi Zombiler!
Dialogue: 0,0:09:01.02,0:09:04.31,Main,Zombies,0,0,0,,Perona-sama'nın Harika Bahçesi'ne hoşgeldiniz!
Dialogue: 0,0:09:04.66,0:09:07.94,Main,All,0,0,0,,Daha fazla tuhaf yaratık ortaya çıktı!
Dialogue: 0,0:09:16.88,0:09:19.28,Main,Koala,0,0,0,,Tamam o zaman, haklayalım onları!
Dialogue: 0,0:09:22.88,0:09:23.63,Main,Chopper,0,0,0,,Usopp!
Dialogue: 0,0:09:23.63,0:09:24.48,Main,Chopper,0,0,0,,Ateş!
Dialogue: 0,0:09:24.48,0:09:25.58,Main,Chopper,0,0,0,,Ateş?
Dialogue: 0,0:09:25.58,0:09:27.54,Main,Chopper,0,0,0,,Ateş kullan! Bunlar zombi!
Dialogue: 0,0:09:29.61,0:09:30.40,Main,Usopp,0,0,0,,{\fad(150,0)}Kesin Öldürücü...
Dialogue: 0,0:09:33.34,0:09:34.67,Main,Chopper,0,0,0,,Usopp!
Dialogue: 0,0:09:36.30,0:09:37.15,Main,Nami,0,0,0,,Chopper!
Dialogue: 0,0:09:37.15,0:09:38.66,Main,Nami,0,0,0,,Dikkat et, arkanda!
Dialogue: 0,0:09:40.91,0:09:41.66,Main,Nami,0,0,0,,Usopp...
Dialogue: 0,0:09:41.66,0:09:42.33,Main,Nami,0,0,0,,Chopper...
Dialogue: 0,0:09:42.58,0:09:46.19,Main,Hippo,0,0,0,,Sen de aynı durumdasın!
Dialogue: 0,0:09:56.76,0:09:58.20,Main,Sanji-pen,0,0,0,,Dur!
Dialogue: 0,0:10:01.53,0:10:04.54,Main,Zombie,0,0,0,,Pislik! Arkadaşına ne yapıyorsun?!
Dialogue: 0,0:10:06.29,0:10:08.44,Main,Zombie,0,0,0,,Düşmanın o kadın!
Dialogue: 0,0:10:08.44,0:10:10.42,Main,Zombie,0,0,0,,Dövmen gereken o!
Dialogue: 0,0:10:10.42,0:10:14.12,Main,Sanji-pen,0,0,0,,Bu bayanın kim olduğu veya nereden\Ngeldiği hakkında hiçbir fikrim yok...
Dialogue: 0,0:10:14.12,0:10:17.26,Main,Sanji-pen,0,0,0,,...ama efendinin emirlerine aykırı olsa bile,...
Dialogue: 0,0:10:17.26,0:10:19.24,Main,Sanji-pen,0,0,0,,...ölsem de...
Dialogue: 0,0:10:19.24,0:10:21.18,Main,Sanji-pen,0,0,0,,...bir kadını incitmem!
Dialogue: 0,0:10:23.69,0:10:26.43,Main,Sanji-pen,0,0,0,,Bununla bir sorununuz varsa gelin bakalım!
Dialogue: 0,0:10:27.54,0:10:29.81,Main,Sanji-pen,0,0,0,,Lanet olası zombiler!
Dialogue: 0,0:10:30.23,0:10:33.12,Main,Luffy,0,0,0,,Hey! Sorun nedir?!
Dialogue: 0,0:10:33.82,0:10:35.25,Main,Luffy,0,0,0,,Hey, domuz!
Dialogue: 0,0:10:35.25,0:10:37.18,Main,Luffy,0,0,0,,Yine bir şey yaptın, değil mi?!
Dialogue: 0,0:10:37.18,0:10:38.28,Main,Luffy,0,0,0,,Söyle bakalım!
Dialogue: 0,0:10:38.28,0:10:42.09,Main,Pig,0,0,0,,Başından beri bir şey bilmediğimi söyledim.
Dialogue: 0,0:10:42.09,0:10:43.83,Main,Franky,0,0,0,,Şimdiyse gülüyorsun.
Dialogue: 0,0:10:43.83,0:10:45.24,Main,Franky,0,0,0,,Ne anlaşılır bir arkadaş.
Dialogue: 0,0:10:45.24,0:10:46.61,Main,Robin,0,0,0,,Çok tuhaf.
Dialogue: 0,0:10:46.61,0:10:47.70,Main,Robin,0,0,0,,Çığlık bile yok.
Dialogue: 0,0:10:47.70,0:10:49.77,Main,Robin,0,0,0,,Acaba ölümüne boğuldular mı?
Dialogue: 0,0:10:49.77,0:10:52.71,Main,Franky,0,0,0,,Düşünce zincirin niye bu kadar karanlık?!
Dialogue: 0,0:10:53.19,0:10:54.86,Main,Luffy,0,0,0,,Tuhaf.
Dialogue: 0,0:10:54.86,0:10:56.76,Main,Luffy,0,0,0,,Zoro da kayboldu.
Dialogue: 0,0:10:57.88,0:11:00.40,Main,Luffy,0,0,0,,Nereye gittiler?
Dialogue: 0,0:11:00.40,0:11:01.95,Main,Luffy,0,0,0,,Zoro ve Sanji için yapacak bir şey yok!
Dialogue: 0,0:11:03.57,0:11:05.93,Main,Franky,0,0,0,,Böyle bir zamanda ne yapıyorsun?!
Dialogue: 0,0:11:06.24,0:11:08.78,Main,Luffy,0,0,0,,Hey! Zırhı orada durur halde buldum!
Dialogue: 0,0:11:08.78,0:11:11.26,Main,Luffy,0,0,0,,Onu giymek bir erkeğin hayali değil midir?!
Dialogue: 0,0:11:11.26,0:11:12.19,Main,Franky,0,0,0,,Olamaz!
Dialogue: 0,0:11:12.19,0:11:13.48,Main,Franky,0,0,0,,Hayal?!
Dialogue: 0,0:11:13.48,0:11:14.68,Main,Franky,0,0,0,,Elbette!
Dialogue: 0,0:11:14.68,0:11:19.18,Main,Luffy,0,0,0,,O demir bedeni elde ettiğinde, kalbini de mi demirle değiştirdin?
Dialogue: 0,0:11:19.18,0:11:20.86,Main,Franky,0,0,0,,Lütfen beni bağışla!
Dialogue: 0,0:11:20.86,0:11:24.45,Main,Franky,0,0,0,,Asla kalbimi demirle değiştirecek kadar ileri gitmedim!
Dialogue: 0,0:11:26.64,0:11:31.67,Main,Franky,0,0,0,,Önemli bir şeyi kaybettiğinde, \Nbir önsezi rüzgarı kalbinden gelip geçer.
Dialogue: 0,0:11:31.67,0:11:33.04,Main,Franky,0,0,0,,Lütfen dinle.
Dialogue: 0,0:11:33.04,0:11:35.06,Main,Franky,0,0,0,,"Çelik Gibi Gezgin Sayborgun Kalbi"
Dialogue: 0,0:11:35.06,0:11:37.33,Main,Pig,0,0,0,,Bunlar durumun farkında mı?
Dialogue: 0,0:11:37.33,0:11:37.96,Main,Robin,0,0,0,,Hey.
Dialogue: 0,0:11:39.27,0:11:40.38,Main,Robin,0,0,0,,Geniş bir salona geldik.
Dialogue: 0,0:11:40.38,0:11:41.09,Main,Luffy,0,0,0,,Cidden mi?
Dialogue: 0,0:11:46.24,0:11:48.47,Main,Luffy,0,0,0,,Robin, Usopp-gil orada mı?!
Dialogue: 0,0:11:48.75,0:11:51.17,Main,Robin,0,0,0,,Sanmıyorum.
Dialogue: 0,0:11:53.04,0:11:55.99,Main,Robin,0,0,0,,Bu salonun içi, dışarısı gibi görünüyor.
Dialogue: 0,0:11:55.99,0:11:57.60,Main,Luffy,0,0,0,,Burası da ne böyle?!
Dialogue: 0,0:11:57.60,0:11:59.57,Main,Franky,0,0,0,,Sanki bir arena gibi.
Dialogue: 0,0:12:00.51,0:12:03.53,Main,Pig,0,0,0,,O kadar basit değil.
Dialogue: 0,0:12:04.00,0:12:06.00,Main,Pig,0,0,0,,Teslim olsanız iyi olur.
Dialogue: 0,0:12:06.00,0:12:09.62,Main,Pig,0,0,0,,Buradan kaçmanız imkansız!
Dialogue: 0,0:12:17.78,0:12:18.63,Main,Luffy,0,0,0,,Franky!
Dialogue: 0,0:12:19.56,0:12:20.23,Main,Robin,0,0,0,,O da kim?!
Dialogue: 0,0:12:24.62,0:12:26.14,Main,Luffy,0,0,0,,Hareket eden bir zırh!
Dialogue: 0,0:12:27.28,0:12:28.81,Main,Robin,0,0,0,,Zombi olduğu şüphesiz.
Dialogue: 0,0:12:29.75,0:12:32.52,Main,Robin,0,0,0,,Bedenindeki o mızraklarla bile hareket ediyor.
Dialogue: 0,0:12:33.49,0:12:35.95,Main,Franky,0,0,0,,Sırf zombiler daha donanımlı diye...
Dialogue: 0,0:12:35.95,0:12:38.36,Main,Franky,0,0,0,,...beni korkutmayacak mı?!
Dialogue: 0,0:12:40.52,0:12:42.51,Main,Franky,0,0,0,,{\fad(150,150)}Güçlü Sağ!
Dialogue: 0,0:12:56.40,0:12:57.25,Main,Franky,0,0,0,,Duvar...
Dialogue: 0,0:12:58.92,0:13:01.05,Main,Franky,0,0,0,,Eskrim kullandığına göre...
Dialogue: 0,0:13:01.88,0:13:04.31,Main,Franky,0,0,0,,{\fad(150,150)}Sol Silahlar!
Dialogue: 0,0:13:20.41,0:13:21.32,Main,Luffy,0,0,0,,Franky...
Dialogue: 0,0:13:26.13,0:13:28.11,Main,Franky,0,0,0,,Beni öldürmek için ondan fazlası gerekecek!
Dialogue: 0,0:13:28.59,0:13:31.60,Main,Franky,0,0,0,,Özellikle de senin gibi bir ceset için!
Dialogue: 0,0:13:37.08,0:13:38.73,Main,Luffy,0,0,0,,Hala ayağa kalkıyor.
Dialogue: 0,0:13:38.73,0:13:40.48,Main,Franky,0,0,0,,Mandal açılmayacak.
Dialogue: 0,0:13:40.48,0:13:43.80,Main,Franky,0,0,0,,Şu ana dek gördüğümüz zombilerden tamamen farklı.
Dialogue: 0,0:13:46.77,0:13:48.18,Main,Pig,0,0,0,,Yakında anlayacaksınız!
Dialogue: 0,0:13:48.18,0:13:50.47,Main,Pig,0,0,0,,Onları gerçekten korkutucu yapan bu!
Dialogue: 0,0:13:50.47,0:13:52.72,Main,Luffy,0,0,0,,Ta oradan konuşuyor!
Dialogue: 0,0:13:52.99,0:13:55.90,Main,Pig,0,0,0,,Acı hissetmezler!
Dialogue: 0,0:13:55.90,0:14:00.87,Main,Pig,0,0,0,,O silahlı Zombi Generaller'in her biri,\Nsavaşta kendilerine isim yapmıştır!
Dialogue: 0,0:14:00.87,0:14:02.15,Main,Pig,0,0,0,,Boyun eğmeyen savaşçılardır!
Dialogue: 0,0:14:03.65,0:14:07.13,Main,Pig,0,0,0,,Bir ülkenin şövalyelerinin, \Nacımasız bir suçluya dönüşen lideri.
Dialogue: 0,0:14:07.13,0:14:09.79,Main,Pig,0,0,0,,Efsanevi bir samuray, bir korsan, bir silahşör!
Dialogue: 0,0:14:09.79,0:14:12.59,Main,Pig,0,0,0,,O adamları zarar görmez hale geldikten sonra hayal edin!
Dialogue: 0,0:14:12.59,0:14:14.94,Main,Pig,0,0,0,,Sizin gibilerin onları yenmesi mümkün değil!
Dialogue: 0,0:14:15.87,0:14:19.59,Main,Pig,0,0,0,,Şimdi bile arkadaşlarınız tehlike içinde!
Dialogue: 0,0:14:19.59,0:14:20.35,Main,Pig,0,0,0,,Hak ettiğinizi buldunuz!
Dialogue: 0,0:14:20.35,0:14:22.25,Main,Luffy,0,0,0,,Seni pislik!
Dialogue: 0,0:14:22.82,0:14:23.71,Main,Pig,0,0,0,,Duvar zombi!
Dialogue: 0,0:14:23.71,0:14:24.69,Main,Wall-zombie,0,0,0,,Tamam!
Dialogue: 0,0:14:27.36,0:14:28.72,Main,Luffy,0,0,0,,Yolu kapattı!
Dialogue: 0,0:14:29.94,0:14:32.43,Main,Robin,0,0,0,,Kapanan tek yol o değil.
Dialogue: 0,0:14:35.88,0:14:38.35,Main,Franky,0,0,0,,Deneyimimden bahsetmişken,...
Dialogue: 0,0:14:38.97,0:14:41.47,Main,Franky,0,0,0,,...zordan daha fazlası olacak.
Dialogue: 0,0:14:41.47,0:14:44.09,Main,Luffy,0,0,0,,Zırh dolu!
Dialogue: 0,0:14:45.13,0:14:48.57,Main,Franky,0,0,0,,Saldırılarımız onlara zarar vermiyorken,\Nonlarla bire bir dövüşmenin manası yok.
Dialogue: 0,0:14:48.57,0:14:53.91,Main,Franky,0,0,0,,Hepsiyle doğrudan yüzleşmeyi denersek mahvoluruz.
Dialogue: 0,0:14:53.91,0:14:54.71,Main,Luffy,0,0,0,,Anlıyorum.
Dialogue: 0,0:14:54.71,0:14:57.79,Main,Luffy,0,0,0,,Haklısın, bu son savaşımız olacak değil ya.
Dialogue: 0,0:14:57.79,0:15:02.75,Main,Robin,0,0,0,,Bu salondan dümdüz koşup geçersek,\Nmuhtemelen avluya ulaşacağız.
Dialogue: 0,0:15:02.75,0:15:05.93,Main,Luffy,0,0,0,,Tamam! O zaman üçümüz orada buluşacağız.
Dialogue: 0,0:15:05.93,0:15:09.62,Main,Luffy,0,0,0,,Başka kimsenin yok olmasına\Nizin vermemek için dikkatli olun.
Dialogue: 0,0:15:09.62,0:15:10.57,Main,Robin,0,0,0,,Elbette.
Dialogue: 0,0:15:11.24,0:15:11.95,Main,Zombie,0,0,0,,Haklayın onları!
Dialogue: 0,0:15:14.68,0:15:15.99,Main,Luffy,0,0,0,,Gidelim!
Dialogue: 0,0:15:18.62,0:15:19.87,Main,Luffy,0,0,0,,Çekilin!
Dialogue: 0,0:15:23.52,0:15:26.22,Main,Jigorou,0,0,0,,{\fad(150,150)}36 Pound'luk Top!
Dialogue: 0,0:15:30.34,0:15:31.34,Main,Luffy,0,0,0,,Bu teknik!
Dialogue: 0,0:15:31.34,0:15:31.95,Main,Luffy,0,0,0,,Zoro!
Dialogue: 0,0:15:32.26,0:15:34.91,Main,Jigorou,0,0,0,,Sırttaki bir yara savaşçının utancıdır!
Dialogue: 0,0:15:36.81,0:15:38.95,Main,Jigorou,0,0,0,,Yine de yaralarla kaplıyım!
Dialogue: 0,0:15:38.95,0:15:40.28,Main,Luffy,0,0,0,,Kimsin sen?
Dialogue: 0,0:15:40.28,0:15:41.27,Main,Luffy,0,0,0,,Zoro olduğunu sanmıştım.
Dialogue: 0,0:15:41.27,0:15:42.92,Main,Jigorou,0,0,0,,Adım Jigorou!
Dialogue: 0,0:15:42.92,0:15:44.46,Main,Luffy,0,0,0,,Aynı onun gibisin!
Dialogue: 0,0:15:52.18,0:15:54.01,Main,Franky,0,0,0,,Zombilere karşı bu kullanılır!
Dialogue: 0,0:15:54.01,0:15:57.04,Main,Franky,0,0,0,,{\fad(150,150)}Taze Ateş!
Dialogue: 0,0:15:59.69,0:16:01.34,Main,Zombie,0,0,0,,Kovaları hazırlayın!
Dialogue: 0,0:16:03.75,0:16:04.71,Main,Franky,0,0,0,,Ne?!
Dialogue: 0,0:16:06.88,0:16:08.19,Main,Robin,0,0,0,,{\fad(150,150)}Once Fleur!
Dialogue: 0,0:16:06.88,0:16:08.19,Note,Robin,0,0,0,,{\fad(150,150)}11 Çiçek!
Dialogue: 0,0:16:10.09,0:16:10.71,Main,Robin,0,0,0,,{\fad(150,150)}Çarp!
Dialogue: 0,0:16:16.76,0:16:18.18,Main,Robin,0,0,0,,Luffy nerede?!
Dialogue: 0,0:16:18.18,0:16:20.23,Main,Franky,0,0,0,,Henüz çıkmamış gibi görünüyor.
Dialogue: 0,0:16:20.23,0:16:24.62,Main,Franky,0,0,0,,Geri dönsek bile zırh giydiği için o aptalı bulmak zor olurdu!
Dialogue: 0,0:16:27.08,0:16:31.01,Main,Franky,0,0,0,,O da yok olmuş olabilir mi?!
Dialogue: 0,0:16:31.40,0:16:33.42,Main,Robin,0,0,0,,Ama sabırla onu bekleyemeyiz.
Dialogue: 0,0:16:33.42,0:16:35.97,Main,Robin,0,0,0,,Zombiler her an burada olabilir!
Dialogue: 0,0:16:36.27,0:16:39.93,Main,Franky,0,0,0,,Hey! Hasır Şapka!
Dialogue: 0,0:16:42.18,0:16:44.46,Main,Luffy,0,0,0,,Acıttı, pislik! Çıkarın beni!
Dialogue: 0,0:16:44.46,0:16:45.82,Main,Franky,0,0,0,,Ne?
Dialogue: 0,0:16:44.78,0:16:46.52,Secondary,Luffy,0,0,0,,Pislikler, çıkarın, lanet olsun!
Dialogue: 0,0:16:46.52,0:16:48.80,Main,Luffy,0,0,0,,Hiç komik değil, lanet olsun!
Dialogue: 0,0:16:48.80,0:16:50.00,Main,Luffy,0,0,0,,Kapağı açın!
Dialogue: 0,0:16:50.00,0:16:51.53,Main,Franky,0,0,0,,Tabut?!
Dialogue: 0,0:16:51.53,0:16:53.67,Main,Luffy,0,0,0,,Hemen çıkarın beni!
Dialogue: 0,0:16:53.67,0:16:54.44,Main,Luffy,0,0,0,,Çıkarın beni, canınıza okuyacağım!
Dialogue: 0,0:16:54.44,0:16:55.53,Main,Robin,0,0,0,,O ses...
Dialogue: 0,0:16:55.53,0:16:56.10,Main,Luffy,0,0,0,,Çıkarın beni!
Dialogue: 0,0:16:56.10,0:16:57.43,Main,Luffy,0,0,0,,Hey, çıkarın beni diyorum!
Dialogue: 0,0:16:57.43,0:16:58.83,Main,Robin,0,0,0,,Luffy!
Dialogue: 0,0:16:58.83,0:16:59.62,Main,Franky,0,0,0,,Olamaz!
Dialogue: 0,0:16:59.62,0:17:01.44,Main,Franky,0,0,0,,Hasır Şapka o şeyin içinde mi?!
Dialogue: 0,0:17:01.44,0:17:03.52,Main,Franky,0,0,0,,Peşinden gidelim, Nico Robin!
Dialogue: 0,0:17:03.52,0:17:05.28,Main,Franky,0,0,0,,Ne yapıyor bu?!
Dialogue: 0,0:17:05.28,0:17:07.58,Main,Franky,0,0,0,,Kendini yakalatmış!
Dialogue: 0,0:17:07.58,0:17:09.22,Main,Franky,0,0,0,,Hasır Şapka!
Dialogue: 0,0:17:10.42,0:17:11.56,Main,Spider,0,0,0,,Peşinden gidemezsiniz!
Dialogue: 0,0:17:18.68,0:17:23.37,Main,Spider,0,0,0,,Hey, hey! Maymun! Maymun! Maymun!
Dialogue: 0,0:17:26.45,0:17:30.86,Main,Spider,0,0,0,,Ben her yerde anlatılan Örümcek Maymun'um!
Dialogue: 0,0:17:31.26,0:17:32.48,Main,Robin,0,0,0,,Devasa bir örümcek!
Dialogue: 0,0:17:32.48,0:17:35.53,Main,Franky,0,0,0,,Bu şeyin büyüklüğü normal böceklerinkini aşıyor! Bu bir canavar örümcek!
Dialogue: 0,0:17:35.53,0:17:37.83,Main,Luffy,0,0,0,,Çıkarın beni diyorum, aptal!
Dialogue: 0,0:17:37.83,0:17:38.42,Main,Luffy,0,0,0,,Kapağı açı-
Dialogue: 0,0:17:39.75,0:17:41.71,Main,Spider,0,0,0,,Ah! Bir tane daha.
Dialogue: 0,0:17:41.93,0:17:44.31,Main,Franky,0,0,0,,Kahretsin, tabut!
Dialogue: 0,0:17:44.31,0:17:48.06,Main,Franky,0,0,0,,Pislik, onunla ne yapacaksın?!
Dialogue: 0,0:17:48.06,0:17:49.83,Main,Spider,0,0,0,,Endişelenme.
Dialogue: 0,0:17:49.83,0:17:54.35,Main,Spider,0,0,0,,Ona ne olursa olsun, siz de ilk elden öğreneceksiniz.
Dialogue: 0,0:17:54.35,0:17:57.09,Main,Spider,0,0,0,,Kendiniz için endişelenmelisiniz.
Dialogue: 0,0:17:58.68,0:18:03.14,Main,Spider,0,0,0,,Karşınızda ben, arkanızda zırhlı askerler!
Dialogue: 0,0:18:03.90,0:18:05.81,Main,Spider,0,0,0,,Böylece tayfanız...
Dialogue: 0,0:18:05.81,0:18:08.80,Main,Spider,0,0,0,,...yok olacak!
