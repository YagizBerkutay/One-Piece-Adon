Dialogue: 0,0:02:30.35,0:02:35.59,Title,,0,0,0,,{\fad(1500,2000)}Gölge Meyvesinin Korkunç Yeteneği!\NEn Büyük, Numara 900!
Dialogue: 0,0:02:37.17,0:02:38.18,Main,Franky,0,0,0,,Daha bitmedi!
Dialogue: 0,0:02:38.18,0:02:40.07,Main,Franky,0,0,0,,Kesmiş olsan da o yine de zombi.
Dialogue: 0,0:02:40.07,0:02:41.43,Main,Franky,0,0,0,,Ayağa kalkmaya devam edecek!
Dialogue: 0,0:02:41.43,0:02:44.58,Main,Spider,0,0,0,,Sen!
Dialogue: 0,0:02:44.58,0:02:49.08,Main,Spider,0,0,0,,Dur biraz, seni daha önce gördüm.
Dialogue: 0,0:02:50.87,0:02:52.50,Main,Brook,0,0,0,,Endişelenme.
Dialogue: 0,0:02:52.50,0:02:54.30,Main,Brook,0,0,0,,İşini çoktan bitirdim.
Dialogue: 0,0:02:54.30,0:02:55.67,Main,Franky,0,0,0,,Bitirdin mi?
Dialogue: 0,0:02:56.42,0:02:58.90,Main,Brook,0,0,0,,Zombilerin zayıf bir noktası vardır.
Dialogue: 0,0:03:06.51,0:03:08.12,Main,Franky,0,0,0,,O da ne?!
Dialogue: 0,0:03:08.60,0:03:11.04,Main,Brook,0,0,0,,Zombinin ruhu.
Dialogue: 0,0:03:11.53,0:03:13.16,Main,Franky,0,0,0,,Ruh?
Dialogue: 0,0:03:13.16,0:03:14.71,Main,Franky,0,0,0,,Gözlerimizin önünde çıkıyor!
Dialogue: 0,0:03:15.05,0:03:19.07,Main,Brook,0,0,0,,Şimdi efendine dön!
Dialogue: 0,0:03:29.79,0:03:32.00,Main,Mouse,0,0,0,,Kaptan Tararan!
Dialogue: 0,0:03:32.00,0:03:35.23,Main,Mouse,0,0,0,,Kaptan yenildi!
Dialogue: 0,0:03:35.57,0:03:37.48,Main,Franky,0,0,0,,Tamamen hareketsiz kaldı.
Dialogue: 0,0:03:37.48,0:03:38.78,Main,Franky,0,0,0,,Ne yaptın?!
Dialogue: 0,0:03:38.78,0:03:40.04,Main,Brook,0,0,0,,Arındırma.
Dialogue: 0,0:03:40.04,0:03:40.92,Main,Mouse,0,0,0,,Bakın!
Dialogue: 0,0:03:40.92,0:03:43.80,Main,Mouse,0,0,0,,Hiç şüphesiz, bu "Şarkı Mırıldanan Kişi".
Dialogue: 0,0:03:43.80,0:03:48.10,Main,Mouse,0,0,0,,Beş yıl önce Thriller Bark'ta kargaşa çıkaran kişi.
Dialogue: 0,0:03:48.10,0:03:50.35,Main,Mouse,0,0,0,,Efendiye haber verin!
Dialogue: 0,0:03:53.08,0:03:57.84,Main,Brook,0,0,0,,Bu örümceğin ağı fiziksel kuvvet karşısında\Ngerçekten sağlam ama ateşe karşı zayıf.
Dialogue: 0,0:04:02.03,0:04:03.02,Main,Franky,0,0,0,,Haklısın!
Dialogue: 0,0:04:03.02,0:04:03.93,Main,Franky,0,0,0,,Eridi!
Dialogue: 0,0:04:04.37,0:04:06.64,Main,Franky,0,0,0,,Hasır Şapka-gil kaçırıldı.
Dialogue: 0,0:04:06.64,0:04:09.75,Main,Franky,0,0,0,,Bu ada hakkında çok şey biliyor gibisin.
Dialogue: 0,0:04:09.75,0:04:10.50,Main,Brook,0,0,0,,Evet.
Dialogue: 0,0:04:10.50,0:04:13.84,Main,Brook,0,0,0,,Ama nasıl anlatacağımdan tam emin değilim.
Dialogue: 0,0:04:13.84,0:04:18.90,Main,Brook,0,0,0,,Yakalanmış olmaları, kuvvetli olasılıkla\Nartık çok geç olduğu anlamına gelebilir.
Dialogue: 0,0:04:19.66,0:04:20.97,Main,Franky,0,0,0,,Ne?!
Dialogue: 0,0:04:20.97,0:04:22.36,Main,Franky,0,0,0,,Çok mu geç?!
Dialogue: 0,0:04:22.36,0:04:25.26,Main,Brook,0,0,0,,L-Lütfen bana kızma.
Dialogue: 0,0:04:25.26,0:04:27.03,Main,Brook,0,0,0,,Ciddiyetimizi koruyalım!
Dialogue: 0,0:04:27.43,0:04:30.10,Main,Brook,0,0,0,,Gerçi iskelet olduğumdan ifade edecek yüzüm yok!
Dialogue: 0,0:04:31.37,0:04:34.13,Main,Brook,0,0,0,,Kurukafa şakası!
Dialogue: 0,0:04:35.74,0:04:38.13,Main,Robin,0,0,0,,Yapma, o zaten ölü.
Dialogue: 0,0:04:38.13,0:04:40.00,Main,Brook,0,0,0,,Neyse,...
Dialogue: 0,0:04:40.28,0:04:43.13,Main,Brook,0,0,0,,...şakayı bırakın ve beni dinleyin.
Dialogue: 0,0:04:43.13,0:04:45.68,Main,Robin,0,0,0,,Yapma, o zaten ölü.
Dialogue: 0,0:04:45.68,0:04:49.88,Main,Brook,0,0,0,,Gemide de anlattığım gibi, gemimin dümeni bozulunca...
Dialogue: 0,0:04:49.88,0:04:53.93,Main,Brook,0,0,0,,...yıllar önce tek başıma bu denizde dolaşmaya başladım.
Dialogue: 0,0:04:54.47,0:05:01.61,Main,Brook,0,0,0,,Bu kötü denizden kaçmayı düşündüm ama kırık bir dümenle dalgaların oyuncağı durumundaydım.
Dialogue: 0,0:05:01.61,0:05:05.23,Main,Brook,0,0,0,,Bu, beş yılı aşkın bir süre önceydi.
Dialogue: 0,0:05:05.23,0:05:10.83,Main,Brook,0,0,0,,Aynı sizin gibi yolum Thriller Bark'a düştü.
Dialogue: 0,0:05:11.38,0:05:15.46,Main,Brook,0,0,0,,Ne olursa olsun Florian Üçgeni'ni terketmek istiyordum.
Dialogue: 0,0:05:15.46,0:05:21.19,Main,Brook,0,0,0,,Dümeni tamir edecek malzemeler bulmayı umarak, adada araştırma yaptım.
Dialogue: 0,0:05:26.29,0:05:30.05,Main,Brook,0,0,0,,Adaya girince yoluma zombilerden ve canavarlardan başka bir şey çıkmadı.
Dialogue: 0,0:05:30.72,0:05:34.02,Main,Brook,0,0,0,,Çok geçmeden yakalandım ve bu binaya getirildim.
Dialogue: 0,0:05:35.03,0:05:45.44,Main,Brook,0,0,0,,İçeride daha önce yakalanmış bir dövüş dansçısı ve kukla dedikleri yamalı bir ceset gördüm.
Dialogue: 0,0:05:45.92,0:05:49.43,Main,Brook,0,0,0,,Sonra korkutucu ve devasa bir adam ortaya çıktı.
Dialogue: 0,0:05:50.38,0:05:53.49,Main,Brook,0,0,0,,Adamın gölgesini yerden kaldırdı...
Dialogue: 0,0:05:53.49,0:05:55.29,Main,Brook,0,0,0,,...ve onu kesti!
Dialogue: 0,0:05:55.29,0:05:56.91,Main,Franky,0,0,0,,Gölgesi kesildi mi?
Dialogue: 0,0:05:57.30,0:06:00.38,Main,Brook,0,0,0,,Gözlerimin beni yanılttığını düşündüm. Gerçi...
Dialogue: 0,0:06:01.02,0:06:02.23,Main,Brook,0,0,0,,...gözlerim yok.
Dialogue: 0,0:06:05.10,0:06:07.73,Main,Franky,0,0,0,,Şakayı bırak yoksa canına okuyacağım!
Dialogue: 0,0:06:07.73,0:06:09.18,Main,Robin,0,0,0,,Artık öldürsen de umrumda olmaz.
Dialogue: 0,0:06:14.90,0:06:19.48,Main,Brook,0,0,0,,Çok geçmeden ben de aynı kaderi paylaştım.
Dialogue: 0,0:06:19.78,0:06:22.61,Main,Brook,0,0,0,,Gölgesi alınan adam olduğu yere yığıldı.
Dialogue: 0,0:06:23.41,0:06:27.31,Main,Brook,0,0,0,,Diğer taraftan, ayrılan gölgesi\Nkıpırdamayan kukla vücuda bastırıldı.
Dialogue: 0,0:06:27.31,0:06:29.21,Main,Brook,0,0,0,,Mümkün olduğunu düşünmemiştim.
Dialogue: 0,0:06:29.21,0:06:31.62,Main,Brook,0,0,0,,Nasıl yaptığından emin değilim.
Dialogue: 0,0:06:32.15,0:06:34.06,Main,Brook,0,0,0,,Ama kukla ceset...
Dialogue: 0,0:06:34.31,0:06:37.25,Main,Brook,0,0,0,,...kıpırdamaya başladı!
Dialogue: 0,0:06:37.77,0:06:39.42,Main,Robin,0,0,0,,Ne demek istiyorsun?
Dialogue: 0,0:06:39.85,0:06:45.80,Main,Brook,0,0,0,,Gölge, seninle birlikte hareket eden\Nve her yere gelen başka bir ruhtur.
Dialogue: 0,0:06:46.44,0:06:48.76,Main,Brook,0,0,0,,Doğumdan ölüme peşinden gelir.
Dialogue: 0,0:06:48.76,0:06:55.20,Main,Brook,0,0,0,,Her zaman sana itaat edecek, peşinden\Ngelecek ve seni asla terketmeyecek bir ruh.
Dialogue: 0,0:06:55.20,0:07:00.23,Main,Brook,0,0,0,,Onlara el koyan ve istediği gibi itaat ettiren adam,...
Dialogue: 0,0:07:00.23,0:07:03.55,Main,Brook,0,0,0,,...Kral Shichibukai, Gecko Moria'dır!
Dialogue: 0,0:07:04.95,0:07:07.65,Main,Brook,0,0,0,,Kage Kage meyvesinin kullanıcısı.
Dialogue: 0,0:07:04.95,0:07:07.65,Main,,0,0,0,,{\c&H7DE1FF&}{\an8}Kage: Gölge
Dialogue: 0,0:07:07.65,0:07:09.36,Main,Franky,0,0,0,,Şeytan Meyvesi, ha?
Dialogue: 0,0:07:09.36,0:07:15.64,Main,Brook,0,0,0,,Ortada bir ceset olduğu sürece,\Nzombi oluşturmak için gölge kullanabilir.
Dialogue: 0,0:07:15.64,0:07:24.54,Main,Brook,0,0,0,,Asıl sorun, bu zorlu yaratıkları oluşturan dahi\Ncerrah Dr. Hogback'in arkadaşlarının olması.
Dialogue: 0,0:07:25.68,0:07:29.19,Main,Brook,0,0,0,,Bazı durumlarda efsanevi savaşçıların cesetlerini kullanarak,...
Dialogue: 0,0:07:29.19,0:07:32.26,Main,Brook,0,0,0,,...onları uyandırmak için farklı mezarlıklardan parçalar alır.
Dialogue: 0,0:07:32.53,0:07:39.18,Main,Brook,0,0,0,,Dahası, laboratuvarındaki dondurucuda hala\Nçok sayıda numaralanmış kuklası var.
Dialogue: 0,0:07:39.91,0:07:41.79,Main,Robin,0,0,0,,Dr. Hogback...
Dialogue: 0,0:07:41.79,0:07:48.80,Main,Robin,0,0,0,,Demek ortadan kaybolduğu olayın ardından o meşhur doktor, bir korsana yardım için buraya gelmiş.
Dialogue: 0,0:07:48.80,0:07:55.49,Main,Franky,0,0,0,,O zaman zombiler, yeniden dirildikleri için hareket etmiyorlar mı?
Dialogue: 0,0:07:55.49,0:07:58.13,Main,Brook,0,0,0,,Doğru.
Dialogue: 0,0:07:58.13,0:08:02.64,Main,Brook,0,0,0,,Gölge, sahibinin kişiliğini ve dövüş yeteneklerini barındırır.
Dialogue: 0,0:08:02.64,0:08:06.90,Main,Brook,0,0,0,,Kuklanın fiziksel gücü, bedeninin gücüyle sınırlıdır.
Dialogue: 0,0:08:06.90,0:08:12.27,Main,Brook,0,0,0,,Güçlü bir gölge ve vücut birleştiğinde,\Ndaha da güçlü bir zombi ortaya çıkar.
Dialogue: 0,0:08:13.38,0:08:18.59,Main,Brook,0,0,0,,Bu yüzden Moria, başına ödül konmuş kişilerin\Ngölgelerini elde etme konusunda bu kadar hevesli.
Dialogue: 0,0:08:18.59,0:08:19.93,Main,Franky,0,0,0,,Anlıyorum.
Dialogue: 0,0:08:19.93,0:08:22.43,Main,Franky,0,0,0,,Başından beri bizim peşimizdelerdi.
Dialogue: 0,0:08:22.43,0:08:24.69,Main,Robin,0,0,0,,Demek Thriller Bark'ın tüm hikayesi bu.
Dialogue: 0,0:08:24.69,0:08:29.82,Main,Robin,0,0,0,,Moria için zombinin en önemli özelliği, itaatkârlığı olmalı.
Dialogue: 0,0:08:29.82,0:08:33.57,Main,Robin,0,0,0,,Savaşçı ne kadar güçlüyse, söz dinletmesi de o kadar zor olmalı.
Dialogue: 0,0:08:33.57,0:08:37.53,Main,Brook,0,0,0,,Doğru, sahiplerinin dövüş ruhunu ve yeteneğini alıyorlar.
Dialogue: 0,0:08:37.53,0:08:42.25,Main,Brook,0,0,0,,Ona itaat etmiyorsa ana bedene ihtiyacı yok.
Dialogue: 0,0:08:42.25,0:08:44.21,Main,Franky,0,0,0,,O zaman onlar...
Dialogue: 0,0:08:44.64,0:08:46.17,Main,Franky,0,0,0,,Durum kötü.
Dialogue: 0,0:08:46.17,0:08:47.47,Main,Brook,0,0,0,,Henüz güvendeler.
Dialogue: 0,0:08:47.47,0:08:48.68,Main,Brook,0,0,0,,Vaktimiz var.
Dialogue: 0,0:08:48.68,0:08:51.96,Main,Brook,0,0,0,,Şimdi size elimizdeki en iyi planı anlatacağım.
Dialogue: 0,0:08:51.96,0:08:55.11,Main,Brook,0,0,0,,Bana güvenin ve dediğim gibi yapın.
Dialogue: 0,0:08:55.74,0:08:57.76,Main,Franky,0,0,0,,Sana güvenmek mi?!
Dialogue: 0,0:08:59.78,0:09:02.47,Main,Brook,0,0,0,,Kurukafa Şoku!
Dialogue: 0,0:09:02.98,0:09:08.56,Main,Brook,0,0,0,,Yıllardır böyle konuşma yapmamıştım! Çok eğlenceli!
Dialogue: 0,0:09:08.92,0:09:10.98,Main,Robin,0,0,0,,Dinliyoruz, hemen anlat.
Dialogue: 0,0:09:10.98,0:09:11.92,Main,Brook,0,0,0,,Tamam.
Dialogue: 0,0:09:12.86,0:09:15.30,Main,Zombies,0,0,0,,Efendi!
Dialogue: 0,0:09:15.30,0:09:17.61,Main,Zombies,0,0,0,,Üç Gizemli İnsan geldi!
Dialogue: 0,0:09:18.39,0:09:20.58,Main,Moria,0,0,0,,Çabuk geldiler. Girin.
Dialogue: 0,0:09:20.58,0:09:22.83,Main,Zombies,0,0,0,,Lütfen içeri girin.
Dialogue: 0,0:09:29.86,0:09:31.92,Main,Moria,0,0,0,,Nihayet geldiniz.
Dialogue: 0,0:09:34.43,0:09:37.43,Main,Moria,0,0,0,,Beni Kosanlar Kralı yapın.
Dialogue: 0,0:09:37.43,0:09:39.02,Main,All,0,0,0,,Çok yakında.
Dialogue: 0,0:09:39.02,0:09:41.12,Main,Luffy,0,0,0,,Ne Korsanlar Kralı!
Dialogue: 0,0:09:43.66,0:09:45.60,Main,Luffy,0,0,0,,Korsanlar Kralı olacak kişi...
Dialogue: 0,0:09:46.37,0:09:47.64,Main,Luffy,0,0,0,,...benim!
Dialogue: 0,0:09:47.64,0:09:50.77,Main,Luffy,0,0,0,,Hey! Çöz şu ipleri, seni koca pırasa!
Dialogue: 0,0:09:50.77,0:09:54.68,Main,Luffy,0,0,0,,Usopp, Nami, Chopper, Sanji, Zoro. Onları geri ver!
Dialogue: 0,0:09:54.68,0:09:57.01,Main,Luffy,0,0,0,,Onları nereye götürdün, pırasa?!
Dialogue: 0,0:09:57.01,0:09:59.66,Main,Hogback,0,0,0,,Ne kadar güçlü bir adam.
Dialogue: 0,0:09:59.66,0:10:01.89,Main,Hogback,0,0,0,,Demek Hasır Şapkalı Luffy bu.
Dialogue: 0,0:10:01.89,0:10:04.33,Main,Moria,0,0,0,,Hey, Hasır Şapkalı Luffy.
Dialogue: 0,0:10:04.33,0:10:06.29,Main,Moria,0,0,0,,Bir sürü isimden bahsettin.
Dialogue: 0,0:10:06.29,0:10:09.21,Main,Moria,0,0,0,,Şu ana dek sadece üçünüzü yakaladık.
Dialogue: 0,0:10:09.85,0:10:16.21,Main,Moria,0,0,0,,Korsan Avcısı Zoro ve aranıyor posteri olmayan sarışın bir adam.
Dialogue: 0,0:10:16.46,0:10:19.76,Main,Luffy,0,0,0,,O sarışın adam Sanji olabilir mi?
Dialogue: 0,0:10:21.30,0:10:23.30,Main,Usopp,0,0,0,,Ne?!
Dialogue: 0,0:10:23.30,0:10:26.08,Main,Usopp,0,0,0,,Hey, görünüşe göre Zoro ve Sanji de yakalanmış.
Dialogue: 0,0:10:26.08,0:10:29.33,Main,Chopper,0,0,0,,Olamaz ve Luffy de yakalanmış!
Dialogue: 0,0:10:29.33,0:10:34.12,Main,Nami,0,0,0,,O canavar üçlü nasıl bu kadar kolay yakalanabilir?!
Dialogue: 0,0:10:36.04,0:10:40.03,Main,Usopp,0,0,0,,Bu insanların kim olduklarını bilmiyorum\Nama baş belası olduklarını biliyorum!
Dialogue: 0,0:10:40.03,0:10:45.24,Main,Hogback,0,0,0,,Sahi, o üçüne ne oldu, Perona?
Dialogue: 0,0:10:45.24,0:10:48.29,Main,Hogback,0,0,0,,Tehlikeli Kardeşler'in onları teslim etmesi gerekiyordu.
Dialogue: 0,0:10:48.29,0:10:51.31,Main,Perona,0,0,0,,Ayıcık'a getirmediler.
Dialogue: 0,0:10:51.31,0:10:53.92,Main,Perona,0,0,0,,Teslim edilirken kaçmadılar mı?
Dialogue: 0,0:10:56.10,0:10:57.74,Main,Usopp,0,0,0,,Bizden bahsediyorlar.
Dialogue: 0,0:10:59.26,0:11:01.51,Main,Usopp,0,0,0,,Söyleme. Sen... Söyleme!
Dialogue: 0,0:11:01.51,0:11:03.95,Main,Perona,0,0,0,,Ağzını açma demiştim!
Dialogue: 0,0:11:03.95,0:11:06.37,Main,Absalom,0,0,0,,Ayıcık'a karşı çok sertsin.
Dialogue: 0,0:11:06.37,0:11:07.56,Main,Absalom,0,0,0,,Fazla sert.
Dialogue: 0,0:11:08.18,0:11:11.63,Main,Absalom,0,0,0,,Neyse, o üçü bahçene girip kargaşa çıkardığında...
Dialogue: 0,0:11:11.63,0:11:15.11,Main,Absalom,0,0,0,,...ben de karımı ele geçirmeye çalışıyordum.
Dialogue: 0,0:11:15.89,0:11:17.69,Main,Absalom,0,0,0,,Hey, dur biraz.
Dialogue: 0,0:11:18.23,0:11:20.20,Main,Absalom,0,0,0,,Bunun anlamı... Hogback!
Dialogue: 0,0:11:20.20,0:11:24.51,Main,Absalom,0,0,0,,Pislik, birinizin karıma el sürdüğünü mü kastediyorsun?!
Dialogue: 0,0:11:25.80,0:11:27.28,Main,Absalom,0,0,0,,Demek daha önce olan buydu!
Dialogue: 0,0:11:28.10,0:11:29.76,Main,Cindry,0,0,0,,Karın gelmiyor.
Dialogue: 0,0:11:29.76,0:11:31.84,Main,Absalom,0,0,0,,Bu da neydi, Cindry?!
Dialogue: 0,0:11:32.75,0:11:36.28,Main,Hogback,0,0,0,,Hey! Hey! Cindry-chan, daha da kötüleştiriyorsun!
Dialogue: 0,0:11:36.28,0:11:39.38,Main,Hogback,0,0,0,,Ayrıca niye önüme geçtin?
Dialogue: 0,0:11:40.12,0:11:41.45,Main,Cindry,0,0,0,,Seninki de gelmeyecek.
Dialogue: 0,0:11:42.48,0:11:44.85,Main,Hogback,0,0,0,,Belden aşağı vuruyorsun! Bu nereden çıktı şimdi?!
Dialogue: 0,0:11:44.85,0:11:46.81,Main,Moria,0,0,0,,Durun! Durun!
Dialogue: 0,0:11:46.81,0:11:48.93,Main,Moria,0,0,0,,Bu manasız tartışmayı kesin.
Dialogue: 0,0:11:48.93,0:11:52.73,Main,Moria,0,0,0,,Korsanların bazıları kaçtıysa, bu konuda\Ndaha sonra bir şeyler yapabilirsiniz.
Dialogue: 0,0:11:53.77,0:12:01.07,Main,Moria,0,0,0,,Büyük dövüş yeteneğinin ortaya çıkışını\Nkutlamak için sizi buraya çağırdım.
Dialogue: 0,0:12:06.18,0:12:08.17,Main,Zombies,0,0,0,,Ne adam ama!
Dialogue: 0,0:12:08.17,0:12:11.39,Main,Zombies,0,0,0,,Efendi, korsan kafesi ısırıp parçalayarak kaçtı!
Dialogue: 0,0:12:12.03,0:12:12.85,Main,Moria,0,0,0,,O...
Dialogue: 0,0:12:14.28,0:12:15.51,Main,Moria,0,0,0,,...kafesi ısırmış!
Dialogue: 0,0:12:15.51,0:12:18.84,Main,Luffy,0,0,0,,Şimdi beni yakalamak için ne yapacaksınız?!
Dialogue: 0,0:12:21.42,0:12:23.18,Main,Hogback,0,0,0,,Ne umut vadeden bir adam!
Dialogue: 0,0:12:24.65,0:12:27.22,Main,Perona,0,0,0,,Dur, Absalom! Odanın içindeyiz.
Dialogue: 0,0:12:27.22,0:12:28.50,Main,Perona,0,0,0,,Onu ben durdururum.
Dialogue: 0,0:12:29.67,0:12:31.58,Main,Luffy,0,0,0,,Sanki beni yakalayabilirmiş gibi, aptal!
Dialogue: 0,0:12:31.79,0:12:33.71,Main,Perona,0,0,0,,{\fad(150,150)}Negatif Ruh!
Dialogue: 0,0:12:43.28,0:12:47.57,Main,Luffy,0,0,0,,Yeniden doğsaydım, deniz salyangozu olmak isterdim.
Dialogue: 0,0:12:47.57,0:12:52.43,Main,Absalom,0,0,0,,Demin Korsanlar Kralı olmak istediğini söyleyen\Nadam, şimdi deniz salyangozu olmak istiyor.
Dialogue: 0,0:12:52.43,0:12:53.58,Main,Absalom,0,0,0,,Berbat.
Dialogue: 0,0:12:53.58,0:12:55.79,Main,Moria,0,0,0,,Işığı açın!
Dialogue: 0,0:12:56.35,0:12:58.53,Main,Luffy,0,0,0,,Ne yapıyorsun, lanet olsun!
Dialogue: 0,0:12:58.53,0:13:00.73,Main,Luffy,0,0,0,,Buna pişman olacaksın!
Dialogue: 0,0:13:11.24,0:13:12.22,Main,Luffy,0,0,0,,O da ne?!
Dialogue: 0,0:13:12.22,0:13:13.55,Main,Luffy,0,0,0,,Gölgem...
Dialogue: 0,0:13:26.17,0:13:27.77,Main,Moria,0,0,0,,Nihayet aldım!
Dialogue: 0,0:13:27.77,0:13:29.83,Main,Moria,0,0,0,,300 milyonluk dövüş gücü!
Dialogue: 0,0:13:29.83,0:13:34.60,Main,Moria,0,0,0,,Bununla En Büyük Özel Zombi yapılacak!
Dialogue: 0,0:13:41.26,0:13:42.59,Main,Franky,0,0,0,,Gemiye mi dönüyorsun?
Dialogue: 0,0:13:43.12,0:13:44.87,Main,Franky,0,0,0,,Sunny'ye mi?
Dialogue: 0,0:13:44.87,0:13:46.47,Main,Brook,0,0,0,,Evet.
Dialogue: 0,0:13:46.47,0:13:53.49,Main,Brook,0,0,0,,En kötü ihtimalle arkadaşlarınız\Nyakalanmış ve gölgeleri çoktan alınmıştır.
Dialogue: 0,0:13:53.49,0:13:57.64,Main,Brook,0,0,0,,Ancak gölgelerinin alınması onları öldürmez.
Dialogue: 0,0:13:57.64,0:14:00.63,Main,Brook,0,0,0,,Bana ne olduğuna bakın!
Dialogue: 0,0:14:00.63,0:14:02.46,Main,Brook,0,0,0,,Ah, öldüm!
Dialogue: 0,0:14:02.46,0:14:04.05,Main,Franky,0,0,0,,Bu farklı bir hikaye!
Dialogue: 0,0:14:04.53,0:14:06.07,Main,Franky,0,0,0,,Neyse.
Dialogue: 0,0:14:06.07,0:14:10.26,Main,Franky,0,0,0,,Özetle gölgeleri alınsa bile ölmeyecekler.
Dialogue: 0,0:14:10.26,0:14:11.71,Main,Brook,0,0,0,,Doğru.
Dialogue: 0,0:14:11.71,0:14:15.56,Main,Brook,0,0,0,,Ancak gölgeleri alındığı an, bilinçlerini\Nyitirirken saldırıya açık haldedirler.
Dialogue: 0,0:14:15.56,0:14:17.58,Main,Brook,0,0,0,,İki gün süreyle uyanmazlar.
Dialogue: 0,0:14:17.58,0:14:23.46,Main,Brook,0,0,0,,Bu süre zarfında, güçlü olanları kayıklara\Nbindirip Thriller Bark'tan uzaklaştırırlar.
Dialogue: 0,0:14:23.46,0:14:27.05,Main,Brook,0,0,0,,Bunu daha önce söyledim ama niye\Nböyle yaptıklarını biliyor musunuz?
Dialogue: 0,0:14:27.05,0:14:31.61,Main,Robin,0,0,0,,Kurbanların adaya geri dönmesini ve gölgelerinin\Ngeri verilmesini istemesini engellemek için, değil mi?
Dialogue: 0,0:14:31.61,0:14:32.71,Main,Brook,0,0,0,,Aynen öyle.
Dialogue: 0,0:14:32.71,0:14:35.71,Main,Franky,0,0,0,,O zaman niye kendilerinde değilken onları öldürmüyorlar?
Dialogue: 0,0:14:35.71,0:14:37.66,Main,Brook,0,0,0,,Bunu yapamazlar.
Dialogue: 0,0:14:38.38,0:14:41.21,Main,Brook,0,0,0,,Bu çok önemli, bu yüzden dikkatli dinleyin.
Dialogue: 0,0:14:43.07,0:14:44.55,Main,Brook,0,0,0,,Öncelikle...
Dialogue: 0,0:14:44.55,0:14:48.48,Main,Brook,0,0,0,,...beden ve gölge ayrı olsa bile, \Naynı varlığın parçasıdırlar.
Dialogue: 0,0:14:48.48,0:14:51.68,Main,Brook,0,0,0,,Beden ölürse, gölgenin de işi biter.
Dialogue: 0,0:14:51.68,0:14:56.01,Main,Brook,0,0,0,,Yani bu olduğu anda, zombi de mahvolur.
Dialogue: 0,0:14:56.01,0:15:00.48,Main,Brook,0,0,0,,Bu, düşman için sıkıntı anlamına gelir,\Nbu yüzden bedeni canlı tutmak zorundalar.
Dialogue: 0,0:15:00.48,0:15:05.71,Main,Brook,0,0,0,,Yani arkadaşlarınızın gölgeleri alınmış olsa bile...
Dialogue: 0,0:15:05.71,0:15:09.64,Main,Brook,0,0,0,,...kesinlikle hayattalar ve gemiye götürülüyorlar.
Dialogue: 0,0:15:11.86,0:15:13.30,Main,Brook,0,0,0,,Bu yüzden...
Dialogue: 0,0:15:13.30,0:15:18.77,Main,Brook,0,0,0,,...siz de kurban olursanız, \Nen kötü senaryoyu yaşayacaksınız!
Dialogue: 0,0:15:18.77,0:15:23.65,Main,Brook,0,0,0,,Herkes gölgelerini kaybeder ve\Ndenizde sürüklenmeye bırakılırdı.
Dialogue: 0,0:15:24.22,0:15:28.92,Main,Brook,0,0,0,,Ama hala bir şey yapılabilir.\NArkadaşlarınızı uyandırırsak,...
Dialogue: 0,0:15:28.92,0:15:33.42,Main,Brook,0,0,0,,...çalınan gölgeleri nasıl geri alacağımızı bulmak için bir şansımız olacak.
Dialogue: 0,0:15:34.67,0:15:37.37,Main,Brook,0,0,0,,Anladınız mı?
Dialogue: 0,0:15:38.42,0:15:40.18,Main,Franky,0,0,0,,Anlıyorum.
Dialogue: 0,0:15:40.18,0:15:42.84,Main,Franky,0,0,0,,Bu mantıklı.
Dialogue: 0,0:15:42.84,0:15:44.13,Main,Brook,0,0,0,,Alın bunu.
Dialogue: 0,0:15:44.13,0:15:45.16,Main,Robin,0,0,0,,Nedir bu?
Dialogue: 0,0:15:46.20,0:15:48.55,Main,Brook,0,0,0,,Zombilerin zayıflığı.
Dialogue: 0,0:15:48.55,0:15:53.01,Main,Brook,0,0,0,,Örümcek Maymun'a karşı etkililiği kanıttır!
Dialogue: 0,0:15:53.01,0:15:54.38,Main,Franky,0,0,0,,Zayıflık?
Dialogue: 0,0:15:54.38,0:15:55.82,Main,Franky,0,0,0,,Nedir bu?
Dialogue: 0,0:15:56.83,0:15:58.81,Main,Brook,0,0,0,,Tuz.
Dialogue: 0,0:15:58.81,0:16:00.58,Main,Franky,0,0,0,,Tuz?
Dialogue: 0,0:16:00.58,0:16:04.92,Main,Franky,0,0,0,,Yani bir tür kötülüğü arıtarak yeniyor gibi miyiz?
Dialogue: 0,0:16:04.92,0:16:07.45,Main,Brook,0,0,0,,Evet, öyle de diyebilirsin.
Dialogue: 0,0:16:07.45,0:16:11.51,Main,Brook,0,0,0,,Aslında zombiler, \NŞeytan Meyvesi'nin gücüyle hayat bulur.
Dialogue: 0,0:16:11.51,0:16:14.94,Main,Brook,0,0,0,,Denizin Şeytan Meyvesi kullanıcısının güçlerini etkisizleştirmesi gibi,...
Dialogue: 0,0:16:14.94,0:16:21.87,Main,Brook,0,0,0,,...denizin gücüne sahip tuz da, \Nsahte ruhla ceset arasındaki bağı koparıyor.
Dialogue: 0,0:16:21.87,0:16:23.51,Main,Franky,0,0,0,,Anlıyorum.
Dialogue: 0,0:16:23.51,0:16:29.94,Main,Franky,0,0,0,,O zaman demin maymunun ağzından\Nçıkan şey, bedenindeki gölgeydi.
Dialogue: 0,0:16:29.94,0:16:32.11,Main,Robin,0,0,0,,Böyle bir zayıflıklarının olması...
Dialogue: 0,0:16:32.11,0:16:37.00,Main,Brook,0,0,0,,Artık zombileri yenmek için sadece ağızlarına tuz atın.
Dialogue: 0,0:16:37.00,0:16:38.31,Main,Brook,0,0,0,,Numara bu!
Dialogue: 0,0:16:38.31,0:16:39.77,Main,Brook,0,0,0,,Tek numara!
Dialogue: 0,0:16:39.77,0:16:40.86,Main,Brook,0,0,0,,Numara!
Dialogue: 0,0:16:40.86,0:16:42.74,Main,Brook,0,0,0,,Numara, numara, numara!
Dialogue: 0,0:16:41.07,0:16:42.25,Secondary,Robin,0,0,0,,Ama Brook,...
Dialogue: 0,0:16:42.74,0:16:47.12,Main,Robin,0,0,0,,...niye bu ada ve zombiler hakkında bu kadar çok şey biliyorsun?
Dialogue: 0,0:16:47.12,0:16:50.32,Main,Brook,0,0,0,,5 yıl önce gölgem çalındığında,...
Dialogue: 0,0:16:50.80,0:16:57.95,Main,Brook,0,0,0,,...haliyle gemimle denize bırakıldım ama şanslıyım ki\Ndönüş yolunu bulmak için zamanında uyandım.
Dialogue: 0,0:16:59.64,0:17:02.64,Main,Brook,0,0,0,,Sonra adaya döndüm.
Dialogue: 0,0:17:02.64,0:17:03.91,Main,Brook,0,0,0,,Gölgemi alan...
Dialogue: 0,0:17:06.64,0:17:10.92,Main,Brook,0,0,0,,...zombiyle dövüşmek için!
Dialogue: 0,0:17:14.03,0:17:17.11,Main,Brook,0,0,0,,Ama tamamen yenildim.
Dialogue: 0,0:17:20.30,0:17:23.37,Main,Brook,0,0,0,,Utanç verici ama canımı kurtarmak için kaçtım.
Dialogue: 0,0:17:23.37,0:17:25.37,Main,Brook,0,0,0,,Ne olursa olsun...
Dialogue: 0,0:17:25.37,0:17:28.50,Main,Brook,0,0,0,,Ne olursa olsun ölmek istemedim.
Dialogue: 0,0:17:28.50,0:17:33.44,Main,Brook,0,0,0,,Çünkü gemimden hayatta kalan tek kişi bendim.
Dialogue: 0,0:17:34.47,0:17:41.41,Main,Brook,0,0,0,,Çünkü arkadaşlarıma, bir gün bu Şeytani Deniz'den kaçacağıma dair söz verdim.
Dialogue: 0,0:17:41.41,0:17:43.87,Main,Brook,0,0,0,,Ne utanç verici ki canımı kurtarmak için kaçtım!
Dialogue: 0,0:17:45.98,0:17:51.96,Main,Brook,0,0,0,,Böylece bir süre daha yaşamayı başardım. \NHiçbir karara varamadım.
Dialogue: 0,0:17:51.96,0:17:55.47,Main,Brook,0,0,0,,Bu yüzden bu kez kaçmayacağım!
Dialogue: 0,0:17:55.47,0:17:58.05,Main,Brook,0,0,0,,O adamı yenip gölgemi alana kadar-
Dialogue: 0,0:18:04.40,0:18:05.03,Main,Brook,0,0,0,,Pekâlâ,...
Dialogue: 0,0:18:05.03,0:18:09.32,Main,Brook,0,0,0,,...izninizle lütfen, ben önden gideceğim.
Dialogue: 0,0:18:09.32,0:18:10.05,Main,Brook,0,0,0,,İyi günler.
Dialogue: 0,0:18:10.05,0:18:11.77,Main,Franky,0,0,0,,Dur biraz!
Dialogue: 0,0:18:14.17,0:18:19.03,Main,Franky,0,0,0,,Hazır başlamışken, sadece bir soruma daha cevap ver.
Dialogue: 0,0:18:25.58,0:18:28.13,Main,Usopp,0,0,0,,L-Luffy!
Dialogue: 0,0:18:28.13,0:18:32.36,Main,Nami,0,0,0,,O da neydi öyle?
Dialogue: 0,0:18:32.36,0:18:34.29,Main,Chopper,0,0,0,,Gölgesi...
Dialogue: 0,0:18:34.29,0:18:35.94,Main,Chopper,0,0,0,,Gölgesi koparıldı!
Dialogue: 0,0:18:36.87,0:18:41.26,Main,Usopp,0,0,0,,Aynı iskelet Brook'un bize anlattığı hikaye gibi.
Dialogue: 0,0:18:41.26,0:18:46.02,Main,Nami,0,0,0,,Gölgesi alındıysa, o zaman bu adam Brook'unkini de almış demektir!
Dialogue: 0,0:18:46.02,0:18:47.49,Main,Chopper,0,0,0,,Buna inanamıyorum.
Dialogue: 0,0:18:47.49,0:18:50.12,Main,Chopper,0,0,0,,Böyle bir şeyi nasıl yapabilir?
Dialogue: 0,0:18:51.67,0:18:54.83,Main,Perona,0,0,0,,Ayıcık! Yine gevezelik ediyordun, değil mi?!
Dialogue: 0,0:18:54.83,0:18:57.67,Main,Absalom,0,0,0,,Ayıcık'a karşı çok katısın.
Dialogue: 0,0:18:57.67,0:18:58.86,Main,Absalom,0,0,0,,Fazla katı.
Dialogue: 0,0:19:01.14,0:19:07.08,Main,Moria,0,0,0,,Bu adam beni Korsanlar Kralı olmaya bir\Nadım daha yaklaştıracak, değil mi Hogback?
Dialogue: 0,0:19:09.28,0:19:16.27,Main,Hogback,0,0,0,,On yıl önce sizinle tanıştığımdan beri,\NNo: 900'ün yapılacağı gün için hizmet ettim!
Dialogue: 0,0:19:16.27,0:19:19.94,Main,Hogback,0,0,0,,O gölgeyle, bu zamana kadar ki en iyi zombiyi yapabiliriz.
Dialogue: 0,0:19:19.94,0:19:23.45,Main,Hogback,0,0,0,,Hiç şüphesiz bu, bizim için büyük bir güç kaynağı olacak!
Dialogue: 0,0:19:24.79,0:19:29.85,Main,Absalom,0,0,0,,Dünya çapında Mezarlık Kralı olarak bilineceğim gün yaklaşıyor!
Dialogue: 0,0:19:31.52,0:19:34.97,Main,Perona,0,0,0,,Dünyanın tüm küçük sevimli şeylerinin zombi olacağı ve...
Dialogue: 0,0:19:35.00,0:19:38.40,Main,Perona,0,0,0,,...bana hizmet edeceği rüya krallığım gözlerimin önüne geliyor.
Dialogue: 0,0:19:38.89,0:19:44.10,Main,Moria,0,0,0,,En küstah pislik bile gölgesini aldığımda\Nitaatkâr bir zombiye dönüşecek!
Dialogue: 0,0:19:44.10,0:19:48.41,Main,Moria,0,0,0,,Bu dünyayı itaatkâr zombilerle dolduracağım!
Dialogue: 0,0:19:48.41,0:19:50.64,Main,Moria,0,0,0,,O zamanlar böyle bir hizmetkârım olsaydı,...
Dialogue: 0,0:19:50.64,0:19:56.04,Main,Moria,0,0,0,,...Yeni Dünya'da aptal Kaidou'ya yenilmezdim!
Dialogue: 0,0:19:56.82,0:19:59.21,Main,Moria,0,0,0,,Uyandıralım onu artık!
Dialogue: 0,0:19:59.62,0:20:00.23,Main,Moria,0,0,0,,Gyoro!
Dialogue: 0,0:20:00.23,0:20:00.86,Main,Moria,0,0,0,,Nin!
Dialogue: 0,0:20:00.86,0:20:01.57,Main,Moria,0,0,0,,Bao!
Dialogue: 0,0:20:01.57,0:20:03.32,Main,Zombies,0,0,0,,Buyrun, Efendi!
Dialogue: 0,0:20:03.32,0:20:06.38,Main,Moria,0,0,0,,Özel dondurucunun kapısını açın!
Dialogue: 0,0:20:06.38,0:20:08.24,Main,Zombies,0,0,0,,Hemen, Efendi!
Dialogue: 0,0:20:12.13,0:20:14.35,Main,Moria,0,0,0,,Bekle bakalım, 900.
Dialogue: 0,0:20:15.92,0:20:17.28,Main,Absalom,0,0,0,,Örümcek Fare.
Dialogue: 0,0:20:17.94,0:20:21.72,Main,Absalom,0,0,0,,Hasır Şapkalı Luffy'nin bedenini gemisine at.
Dialogue: 0,0:20:21.72,0:20:25.41,Main,Absalom,0,0,0,,İplerini çıkarmayı unutma, ölmesi can sıkıcı olur.
Dialogue: 0,0:20:25.72,0:20:26.53,Main,Mouse,0,0,0,,Evet!
Dialogue: 0,0:20:26.53,0:20:28.37,Main,Mouse,0,0,0,,Lütfen durun! Rapor vereceğim!
Dialogue: 0,0:20:28.85,0:20:29.86,Main,Absalom,0,0,0,,Ne oldu?
Dialogue: 0,0:20:29.86,0:20:34.83,Main,Mouse,0,0,0,,Biraz önce Kaptan Örümcek Tararan yenildi!
Dialogue: 0,0:20:34.83,0:20:37.43,Main,Absalom,0,0,0,,Yenildi mi?
Dialogue: 0,0:20:37.43,0:20:40.26,Main,Absalom,0,0,0,,Gölgesi çıkarılana kadar bu imkansız.
Dialogue: 0,0:20:40.26,0:20:42.33,Main,Mouse,0,0,0,,Gölgesi çıkarıldı!
Dialogue: 0,0:20:45.98,0:20:47.20,Main,Hogback,0,0,0,,Absalom...
Dialogue: 0,0:20:47.20,0:20:50.61,Main,Hogback,0,0,0,,Bunu yapabilecek tek kişi, o!
Dialogue: 0,0:20:50.61,0:20:53.52,Main,Absalom,0,0,0,,Şövalye Ruhlu, Şarkı Mırıldanan Kılıç Ustası!
Dialogue: 0,0:20:53.52,0:20:56.97,Main,Absalom,0,0,0,,Görünüşe bakılırsa Hildon'un verdiği rapor yanlış değilmiş.
Dialogue: 0,0:20:56.97,0:20:58.02,Main,Hogback,0,0,0,,Bu korkunç!
Dialogue: 0,0:20:58.02,0:21:00.90,Main,Mouse,0,0,0,,Şarkı Mırıldanan, bir sürü gölgeyi serbest bırakıyordu!
Dialogue: 0,0:21:00.90,0:21:04.05,Main,Mouse,0,0,0,,Ben bilmeden evvel sayısız kurban olmuş!
Dialogue: 0,0:21:04.05,0:21:08.87,Main,Mouse,0,0,0,,Bu durumda beş yıl önceki kabus tekrarlanacak!
Dialogue: 0,0:21:09.69,0:21:14.85,Main,Hogback,0,0,0,,Kahretsin, zombilerin zayıflığını anlayabilecek tek kişi-
Dialogue: 0,0:21:14.85,0:21:16.02,Main,Hogback,0,0,0,,Ha?
Dialogue: 0,0:21:16.02,0:21:17.63,Main,Hogback,0,0,0,,Bunu nasıl öğren-
Dialogue: 0,0:21:18.14,0:21:21.00,Main,Hogback,0,0,0,,Cindry-chan, niye önümde duruyorsun?!
Dialogue: 0,0:21:22.19,0:21:25.76,Main,Perona,0,0,0,,Onu duydum ama neye benziyor?
Dialogue: 0,0:21:26.34,0:21:30.73,Main,Absalom,0,0,0,,Perona, onun neye benzediğini bilmiyor musun?
Dialogue: 0,0:21:30.73,0:21:34.18,Main,Absalom,0,0,0,,Demek bu yüzden tespit edilmedi.
Dialogue: 0,0:21:34.18,0:21:35.52,Main,Absalom,0,0,0,,Efendi!
Dialogue: 0,0:21:35.52,0:21:37.66,Main,Absalom,0,0,0,,Şu baş belası yine geldi.
Dialogue: 0,0:21:37.66,0:21:41.12,Main,Moria,0,0,0,,Öyle bir şey umrumda mı sanki, aptal!
Dialogue: 0,0:21:41.12,0:21:43.65,Main,Moria,0,0,0,,Sen ilgilen!
Dialogue: 0,0:21:43.65,0:21:47.70,Main,Moria,0,0,0,,Şimdi dondurucuya.
Dialogue: 0,0:21:52.74,0:21:55.28,Main,Mouse,0,0,0,,Yine de şu anki durum...
Dialogue: 0,0:21:57.22,0:22:00.03,Main,Absalom,0,0,0,,Aptal! Bunu en baştan söylesene!
Dialogue: 0,0:22:00.03,0:22:02.52,Main,Absalom,0,0,0,,Bu durumda onu kontrol altına alabiliriz.
Dialogue: 0,0:22:02.52,0:22:03.17,Main,Mouse,0,0,0,,Evet.
Dialogue: 0,0:22:03.80,0:22:06.20,Main,Absalom,0,0,0,,Uyandığında bir sorun olursa haber verin.
Dialogue: 0,0:22:06.20,0:22:07.88,Main,Absalom,0,0,0,,Şimdi gidin ve Hasır Şapka'yı atın.
Dialogue: 0,0:22:07.88,0:22:08.97,Main,Mouse,0,0,0,,Tamam!
Dialogue: 0,0:22:12.35,0:22:14.02,Main,Usopp,0,0,0,,Aptal, dışarı çıkma!
Dialogue: 0,0:22:15.00,0:22:17.44,Main,Usopp,0,0,0,,Görünüşe göre gölgenin koparılması seni öldürmüyor!
Dialogue: 0,0:22:17.44,0:22:19.31,Main,Usopp,0,0,0,,Brook'u öldürmedi.
Dialogue: 0,0:22:19.31,0:22:21.36,Main,Usopp,0,0,0,,Henüz çıkamayız.
Dialogue: 0,0:22:21.36,0:22:22.32,Main,Usopp,0,0,0,,Fırsat kollayacağız!
Dialogue: 0,0:22:22.77,0:22:24.69,Main,Usopp,0,0,0,,Luffy'nin gölgesiyle bir şey yapacak gibiler.
Dialogue: 0,0:22:24.69,0:22:29.49,Main,Usopp,0,0,0,,Daha sonra geri alabilmemiz için ne olduğunu görmeliyiz.
Dialogue: 0,0:22:29.49,0:22:32.20,Main,Zombie General,0,0,0,,O ikisi gitmiş.
Dialogue: 0,0:22:32.20,0:22:33.53,Main,Zombie General,0,0,0,,Nereye?
Dialogue: 0,0:22:34.51,0:22:37.36,Main,Zombie General,0,0,0,,Tararan'ı hakladıklarına inanamıyorum.
Dialogue: 0,0:22:37.36,0:22:38.90,Main,Gigoro,0,0,0,,Düşman nerede?!
Dialogue: 0,0:22:38.90,0:22:40.54,Main,Gigoro,0,0,0,,Onları hemen keseceğim!
Dialogue: 0,0:22:45.49,0:22:47.21,Main,Robin,0,0,0,,Franky.
Dialogue: 0,0:22:47.21,0:22:50.55,Main,Franky,0,0,0,,Ne istiyorsun?! Ağlamıyorum!
Dialogue: 0,0:22:50.55,0:22:54.06,Main,Franky,0,0,0,,Aptal, bu tarafa bakma!
Dialogue: 0,0:22:54.06,0:22:57.52,Main,Robin,0,0,0,,Niye ona öyle bir soru sordun?
Dialogue: 0,0:22:57.52,0:23:00.91,Main,Franky,0,0,0,,Kapa çeneni! Beni boşver!
Dialogue: 0,0:23:02.70,0:23:06.44,Main,Franky,0,0,0,,Kahretsin! Artık o iskeleti seviyorum!
Dialogue: 0,0:23:06.44,0:23:08.74,Main,Franky,0,0,0,,Hiçbir yerde o kadar iyi bir adam yok!
Dialogue: 0,0:23:08.74,0:23:10.58,Main,Franky,0,0,0,,Kahretsin!
Dialogue: 0,0:23:13.14,0:23:14.01,Main,Robin,0,0,0,,Haklısın.
Dialogue: 0,0:23:22.87,0:23:26.25,Main,Ryuuma,0,0,0,,Düşündüğüm gibi seni sadece dışarı atmakla pes etmeyeceksin.
Dialogue: 0,0:23:26.25,0:23:27.63,Main,Brooke,0,0,0,,Elbette!
Dialogue: 0,0:23:28.28,0:23:31.05,Main,Ryuuma,0,0,0,,Adımı bilmiyor musun?
Dialogue: 0,0:23:31.05,0:23:34.45,Main,Ryuuma,0,0,0,,Kılıç Ustası Ryuuma'nın adını duyan herkes korkudan titreyecek.
Dialogue: 0,0:23:34.45,0:23:35.44,Main,Brooke,0,0,0,,Sessiz ol!
Dialogue: 0,0:23:35.44,0:23:36.72,Main,Brooke,0,0,0,,Sen benim gölgemsin!
Dialogue: 0,0:23:38.50,0:23:40.18,Main,Ryuuma,0,0,0,,Bedenlerimiz arasında büyük fark var.
Dialogue: 0,0:23:40.46,0:23:42.46,Main,Brooke,0,0,0,,Ayağıma...
Dialogue: 0,0:23:42.46,0:23:44.52,Main,Brooke,0,0,0,,...geri dönmelisin!
Dialogue: 0,0:23:45.08,0:23:47.19,Main,Hogback,0,0,0,,Sabırsızlanıyorum!
Dialogue: 0,0:23:47.19,0:23:52.70,Main,Hogback,0,0,0,,Cesedini Buz Ülkesi'nde gördüğümde,\Ntitrememe engel olamadım.
Dialogue: 0,0:23:52.70,0:23:59.48,Main,Hogback,0,0,0,,Bu iğrenç şeyin 500 yıl önce denizlerde\Nterör estirdiğini düşünmek nefesimi kesiyor!
Dialogue: 0,0:23:59.48,0:24:03.08,Main,Hogback,0,0,0,,Kendi bölgesini genişletmek için fethettiği her ülkenin tüm adasını aldı.
Dialogue: 0,0:24:00.32,0:24:01.77,Secondary,Hogback,0,0,0,,Çok soğuk!
Dialogue: 0,0:24:03.08,0:24:06.63,Main,Hogback,0,0,0,,Böylece bahsi geçen Şer Ülkesi'ni kurdu.
Dialogue: 0,0:24:06.63,0:24:11.07,Main,Hogback,0,0,0,,Ülke Koparan efsanesinin bizzat kurucusu işte burada!
Dialogue: 0,0:24:11.07,0:24:13.01,Main,Hogback,0,0,0,,Bu, yapılmış en iyi zombi ola-
Dialogue: 0,0:24:13.01,0:24:16.78,Main,Moria,0,0,0,,Efsane bir kez daha yeniden doğacak!
Dialogue: 0,0:24:22.25,0:24:25.05,Main,Moria,0,0,0,,Şimdi, yeniden dirilme zamanı!
Dialogue: 0,0:24:25.05,0:24:27.44,Main,Moria,0,0,0,,Tarihteki tek adam!
Dialogue: 0,0:24:28.40,0:24:31.99,Main,Moria,0,0,0,,Şeytan denen vahşi savaşçı!
Dialogue: 0,0:24:33.91,0:24:36.41,Main,Moria,0,0,0,,Oz!
