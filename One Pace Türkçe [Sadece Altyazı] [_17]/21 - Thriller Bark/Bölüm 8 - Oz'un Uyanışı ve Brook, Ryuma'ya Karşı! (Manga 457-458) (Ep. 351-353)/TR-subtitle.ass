Dialogue: 0,0:02:29.87,0:02:38.48,Title,Title,0,0,0,,{\fad(1700,2000)}Oz'un Uyanışı ve\NBrook, Ryuma'ya Karşı!
Dialogue: 0,0:02:39.93,0:02:42.03,Main,Moria,0,0,0,,Başlayalım!
Dialogue: 0,0:02:43.47,0:02:44.93,Thoughts,Usopp,0,0,0,,{\i1}Bu da ne?{\i0}
Dialogue: 0,0:02:44.93,0:02:48.26,Thoughts,Usopp,0,0,0,,{\i1}D-Dev cesedi mi?{\i0}
Dialogue: 0,0:02:48.26,0:02:50.31,Thoughts,Usopp,0,0,0,,{\i1}Dev için bile fazla büyük!{\i0}
Dialogue: 0,0:02:53.27,0:02:56.03,Main,Nami,0,0,0,,Ses çıkarma, Chopper.
Dialogue: 0,0:02:57.15,0:03:00.99,Main,Moria,0,0,0,,Sakin ol, Hasır Şapkalı Luffy'nin Gölgesi.
Dialogue: 0,0:03:01.47,0:03:04.45,Main,Moria,0,0,0,,Ben yeni efendinim.
Dialogue: 0,0:03:06.16,0:03:11.67,Main,Moria,0,0,0,,Şu andan itibaren zombi olarak yaşamak\Niçin yeni bir beden ve ses alacaksın.
Dialogue: 0,0:03:11.67,0:03:14.84,Main,Moria,0,0,0,,Önceki insan bedeninle olan tüm bağlantılarını unut.
Dialogue: 0,0:03:14.84,0:03:18.36,Main,Moria,0,0,0,,Bana teslim ol ve sadık bir askerim ol!
Dialogue: 0,0:03:20.35,0:03:22.30,Main,Moria,0,0,0,,Anlaştık o zaman.
Dialogue: 0,0:03:23.97,0:03:30.00,Main,Hogback,0,0,0,,Cindry-chan, sen de geçmişini unutmak için anlaşma yaptın.
Dialogue: 0,0:03:30.00,0:03:32.89,Main,Hogback,0,0,0,,Bu yüzden yemeklerimizi tabakta yiyebiliriz.
Dialogue: 0,0:03:33.75,0:03:36.95,Main,Cindry,0,0,0,,Dizlerin de kırılsaydı iyi olurdu.
Dialogue: 0,0:03:37.70,0:03:38.50,Main,Hogback,0,0,0,,Korkunç!
Dialogue: 0,0:03:38.50,0:03:40.69,Main,Hogback,0,0,0,,Cindry-chan, bu tehdit çok korkunçtu!
Dialogue: 0,0:03:41.01,0:03:44.41,Main,Absalom,0,0,0,,Cindry, Hogback'e karşı çok katı.
Dialogue: 0,0:03:44.41,0:03:47.76,Main,Moria,0,0,0,,Şimdi, uyan!
Dialogue: 0,0:03:49.70,0:03:51.54,Thoughts,Chopper,0,0,0,,Gölge!
Dialogue: 0,0:03:51.54,0:03:55.38,Main,Moria,0,0,0,,500 yıllık uykundan!
Dialogue: 0,0:04:09.45,0:04:11.98,Main,Nami,0,0,0,,Luffy'nin gölgesi...
Dialogue: 0,0:04:17.15,0:04:18.60,Main,Absalom,0,0,0,,Girdi.
Dialogue: 0,0:04:57.42,0:04:58.94,Main,Nami,0,0,0,,Hayır! Bağırma!
Dialogue: 0,0:05:11.08,0:05:13.91,Main,All,0,0,0,,Ceset kıpırdadı!
Dialogue: 0,0:05:14.55,0:05:15.83,Main,Moria,0,0,0,,Ne?
Dialogue: 0,0:05:16.68,0:05:19.09,Main,Usopp,0,0,0,,Kahretsin! Bulunduk!
Dialogue: 0,0:05:19.09,0:05:20.73,Main,Nami,0,0,0,,Bağırdık!
Dialogue: 0,0:05:20.73,0:05:22.92,Main,Chopper,0,0,0,,Şeytan uyandı!
Dialogue: 0,0:05:22.92,0:05:24.35,Main,Perona,0,0,0,,Hey, Ayıcık!
Dialogue: 0,0:05:24.35,0:05:27.51,Main,Perona,0,0,0,,Sakın o korsanları sakladığını söyleme!
Dialogue: 0,0:05:28.61,0:05:30.12,Main,Absalom,0,0,0,,Karım!
Dialogue: 0,0:05:30.12,0:05:31.81,Main,Absalom,0,0,0,,Niye burada?!
Dialogue: 0,0:05:50.53,0:05:51.30,Main,Hogback,0,0,0,,Mükem-
Dialogue: 0,0:05:52.93,0:05:54.48,Main,Hogback,0,0,0,,Bu ne şiddet!
Dialogue: 0,0:05:54.48,0:05:55.81,Main,Hogback,0,0,0,,Bir şaheser!
Dialogue: 0,0:05:55.81,0:05:56.96,Main,Hogback,0,0,0,,Tam bir şeytan!
Dialogue: 0,0:05:58.34,0:06:01.21,Main,Oars,0,0,0,,ET!
Dialogue: 0,0:06:04.05,0:06:09.47,Main,Oars,0,0,0,,ACIKTIM!
Dialogue: 0,0:06:13.16,0:06:16.75,Main,Absalom,0,0,0,,Hey! Korsanlar nereye... Karım nereye gitti?!
Dialogue: 0,0:06:16.75,0:06:19.16,Main,Zombie,0,0,0,,Hızla kaçtılar!
Dialogue: 0,0:06:19.16,0:06:20.69,Main,Zombie,0,0,0,,Gerçekten hızlılar!
Dialogue: 0,0:06:20.69,0:06:21.73,Main,Absalom,0,0,0,,Kaçamazsınız!
Dialogue: 0,0:06:21.73,0:06:24.77,Main,Oars,0,0,0,,Sanji, yemek!
Dialogue: 0,0:06:26.17,0:06:28.01,Main,Oars,0,0,0,,Sanji kim?
Dialogue: 0,0:06:30.74,0:06:31.46,Main,Usopp,0,0,0,,Ne oldu?
Dialogue: 0,0:06:31.46,0:06:32.92,Main,Usopp,0,0,0,,Demin ne oldu?
Dialogue: 0,0:06:33.75,0:06:36.47,Main,Chopper,0,0,0,,Luffy'nin gölgesi içine konulur konulmaz hareket etmeye başladı!
Dialogue: 0,0:06:36.47,0:06:38.85,Main,Nami,0,0,0,,Demek zombiler böyle oluşuyor!
Dialogue: 0,0:06:39.76,0:06:43.65,Main,Chopper,0,0,0,,Dr. Hogback'ın "Hayatı Geri Vermek" le \Nkastettiği buydu!
Dialogue: 0,0:06:43.65,0:06:46.65,Main,Usopp,0,0,0,,O koca adamın yeteneği...
Dialogue: 0,0:06:48.00,0:06:49.86,Main,Usopp,0,0,0,,...muhtemelen Şeytan Meyvesi yüzünden!
Dialogue: 0,0:06:50.70,0:06:53.53,Main,Nami,0,0,0,,İlk sözünün "et" olması...
Dialogue: 0,0:06:54.89,0:06:58.87,Main,Nami,0,0,0,,...hiç şüphesiz o devasa canavarın, \NLuffy'nin kişiliğine sahip olduğu anlamına gelir.
Dialogue: 0,0:07:00.61,0:07:02.66,Main,Nami,0,0,0,,O zaman yanlış hatırlamıyorsam,...
Dialogue: 0,0:07:02.66,0:07:06.38,Main,Nami,0,0,0,,...köprüde karşılaştığımız Sanji benzeri penguen,...
Dialogue: 0,0:07:08.11,0:07:09.63,Flashbacks,Inuppe,0,0,0,,Ölsem bile,...
Dialogue: 0,0:07:09.63,0:07:11.47,Flashbacks,Inuppe,0,0,0,,...bir bayanı incitmem!
Dialogue: 0,0:07:11.47,0:07:12.61,Main,Usopp,0,0,0,,Anlıyorum!
Dialogue: 0,0:07:13.43,0:07:17.01,Main,Usopp,0,0,0,,O zaman Sanji'nin gölgesi ona yerleştirilmiş.
Dialogue: 0,0:07:17.01,0:07:18.80,Main,Nami,0,0,0,,Muhtemelen.
Dialogue: 0,0:07:18.80,0:07:21.23,Main,Usopp,0,0,0,,Bize kılıcının tersiyle vuran samuray...
Dialogue: 0,0:07:23.21,0:07:24.54,Main,Usopp,0,0,0,,O Brook!
Dialogue: 0,0:07:24.54,0:07:26.35,Main,Usopp,0,0,0,,İnanılmaz!
Dialogue: 0,0:07:26.35,0:07:30.19,Main,Chopper,0,0,0,,Demek tüm bu tuhaf olaylar birbiriyle bağlantılı.
Dialogue: 0,0:07:31.40,0:07:33.88,Main,Chopper,0,0,0,,Bu korkunç zombiler onun için sadece bir oyun!
Dialogue: 0,0:07:33.88,0:07:36.31,Main,Chopper,0,0,0,,İnsanların hayatlarıyla oynuyor!
Dialogue: 0,0:07:36.31,0:07:38.10,Main,Chopper,0,0,0,,Ne "insanlığın hayali"!
Dialogue: 0,0:07:38.10,0:07:39.83,Main,Chopper,0,0,0,,Ne "ölüyü geri getirmesi"!
Dialogue: 0,0:07:42.34,0:07:45.58,Flashbacks,Chopper,0,0,0,,Dr. Hogback harika biri!
Dialogue: 0,0:07:45.58,0:07:46.79,Flashbacks,Chopper,0,0,0,,Ona büyük saygı duyuyorum!
Dialogue: 0,0:07:46.79,0:07:50.80,Main,Chopper,0,0,0,,Biraz olsun kimseye yardım etmek istemiyor!
Dialogue: 0,0:07:50.80,0:07:53.22,Main,Chopper,0,0,0,,Sadece başka bir kötü adam!
Dialogue: 0,0:07:53.85,0:07:55.89,Main,Nami,0,0,0,,Chopper...
Dialogue: 0,0:07:55.89,0:07:58.65,Main,Usopp,0,0,0,,Bu konuda yakınacak zaman değil.
Dialogue: 0,0:07:58.65,0:08:02.14,Main,Usopp,0,0,0,,Arkadaşlarımız bu zombi oyununun kurbanı oluyor!
Dialogue: 0,0:08:02.14,0:08:03.28,Main,Usopp,0,0,0,,Anlıyor musunuz?
Dialogue: 0,0:08:03.28,0:08:05.84,Main,Usopp,0,0,0,,Onları kurtarmalıyız!
Dialogue: 0,0:08:05.84,0:08:06.77,Main,Usopp,0,0,0,,Acele edin!
Dialogue: 0,0:08:06.77,0:08:09.26,Main,Usopp,0,0,0,,Luffy'nin taşındığı yere gideceğiz!
Dialogue: 0,0:08:09.26,0:08:11.80,Main,Nami,0,0,0,,"Onları gemiye geri götürün" demişlerdi!
Dialogue: 0,0:08:11.80,0:08:13.20,Main,Nami,0,0,0,,Acaba Sunny'yi mi kastettiler?
Dialogue: 0,0:08:14.28,0:08:17.56,Main,Chopper,0,0,0,,Aynı şey Zoro ve Sanji'ye de olduysa,...
Dialogue: 0,0:08:17.56,0:08:18.78,Main,Chopper,0,0,0,,...onlar da orada olmalı!
Dialogue: 0,0:08:18.78,0:08:20.61,Main,Nami,0,0,0,,Haklısın!
Dialogue: 0,0:08:20.61,0:08:22.23,Main,Usopp,0,0,0,,Onlara yardıma gidelim!
Dialogue: 0,0:08:33.36,0:08:34.42,Main,Nami,0,0,0,,Usopp!
Dialogue: 0,0:08:34.42,0:08:35.36,Main,Nami,0,0,0,,Chopper!
Dialogue: 0,0:08:36.31,0:08:37.22,Main,Nami,0,0,0,,İyi misiniz?!
Dialogue: 0,0:08:38.91,0:08:39.53,Main,Nami,0,0,0,,Ne?
Dialogue: 0,0:08:39.53,0:08:40.68,Main,Nami,0,0,0,,Acıyor, sen ne-
Dialogue: 0,0:08:40.68,0:08:41.88,Main,Nami,0,0,0,,Bırak beni!
Dialogue: 0,0:08:46.02,0:08:46.76,Main,Nami,0,0,0,,Bu adam!
Dialogue: 0,0:08:46.76,0:08:47.79,Main,Nami,0,0,0,,Ne güç ama!
Dialogue: 0,0:08:47.79,0:08:50.05,Main,Absalom,0,0,0,,Veda etmeyi bitirdiniz mi?
Dialogue: 0,0:08:52.59,0:08:55.40,Main,Absalom,0,0,0,,Bugün bu kadınla evleneceğim.
Dialogue: 0,0:08:58.01,0:08:59.28,Main,Usopp,0,0,0,,Aptal.
Dialogue: 0,0:08:59.28,0:09:02.10,Main,Usopp,0,0,0,,Tek bir kadını bile koruyamıyorsa,...
Dialogue: 0,0:09:03.00,0:09:05.60,Main,Usopp,0,0,0,,...yiğit Usopp'un yaşamasının bir anlamı kalmaz!
Dialogue: 0,0:09:06.71,0:09:08.58,Main,Chopper,0,0,0,,Usopp, o silah!
Dialogue: 0,0:09:09.38,0:09:11.46,Main,Usopp,0,0,0,,Al bakalım!
Dialogue: 0,0:09:11.75,0:09:15.51,Main,Usopp,0,0,0,,{\fad(100,100)}Altı Odalı Engerek Yıldızı!
Dialogue: 0,0:09:18.95,0:09:20.37,Main,Chopper,0,0,0,,Yine yok oluyor!
Dialogue: 0,0:09:20.94,0:09:22.49,Main,Nami,0,0,0,,Ne? Ben de mi?
Dialogue: 0,0:09:24.60,0:09:25.91,Main,Usopp,0,0,0,,Nami de yok oldu!
Dialogue: 0,0:09:26.29,0:09:28.58,Main,Chopper,0,0,0,,Nami!
Dialogue: 0,0:09:29.60,0:09:30.52,Main,Chopper,0,0,0,,Neredesin?!
Dialogue: 0,0:09:30.52,0:09:31.17,Main,Chopper,0,0,0,,Ne?
Dialogue: 0,0:09:32.31,0:09:35.15,Main,Chopper,0,0,0,,Kokusu başka bir kokuyla silinmiş!
Dialogue: 0,0:09:35.15,0:09:36.25,Main,Nami,0,0,0,,Yardım edin!
Dialogue: 0,0:09:36.25,0:09:37.96,Main,Nami,0,0,0,,Usopp, Cho-!
Dialogue: 0,0:09:37.96,0:09:39.82,Main,Usopp,0,0,0,,Hey! Nami, sorun nedir?!
Dialogue: 0,0:09:39.82,0:09:40.89,Main,Usopp,0,0,0,,Neredesin?!
Dialogue: 0,0:09:41.38,0:09:43.94,Main,Usopp,0,0,0,,Cevap ver, Nami!
Dialogue: 0,0:09:43.94,0:09:45.01,Main,Absalom,0,0,0,,Zombiler!
Dialogue: 0,0:09:45.01,0:09:47.21,Main,Absalom,0,0,0,,Onları size bırakıyorum.
Dialogue: 0,0:09:47.21,0:09:50.77,Main,Absalom,0,0,0,,Onları Moria-sama'ya götürün!
Dialogue: 0,0:09:51.73,0:09:53.34,Main,Usopp,0,0,0,,Nereden konuşuyor?!
Dialogue: 0,0:09:55.53,0:09:58.16,Main,Usopp,0,0,0,,Ne?! Zırhlı bir zombi?!
Dialogue: 0,0:10:00.62,0:10:02.96,Main,Usopp,0,0,0,,Aşağıdan daha fazlası geliyor!
Dialogue: 0,0:10:03.68,0:10:06.04,Main,Chopper,0,0,0,,Yukarıdan da zombiler geliyor!
Dialogue: 0,0:10:06.04,0:10:08.50,Main,Zombies,0,0,0,,Hey, korsanlar!
Dialogue: 0,0:10:08.50,0:10:10.71,Main,Zombies,0,0,0,,Gölgelerinizi verin!
Dialogue: 0,0:10:10.71,0:10:14.03,Main,Usopp,0,0,0,,Yakalanma sakın, gölgelerimizi çalacaklar!
Dialogue: 0,0:10:20.91,0:10:23.01,Main,Chopper,0,0,0,,Portre zombiler de var!
Dialogue: 0,0:10:24.35,0:10:25.38,Main,Usopp,0,0,0,,Kahretsin!
Dialogue: 0,0:10:25.38,0:10:29.91,Main,Usopp,0,0,0,,Ölümsüzlerin üst üste yığılması adil değil!
Dialogue: 0,0:10:29.91,0:10:32.44,Main,Usopp,0,0,0,,Hiç adil değil!
Dialogue: 0,0:10:32.44,0:10:35.98,Main,Zombies,0,0,0,,Sadece gölgeni alacağız kardeş.
Dialogue: 0,0:10:39.20,0:10:41.13,Main,Chopper,0,0,0,,Kahretsin, bırakın beni!
Dialogue: 0,0:10:41.13,0:10:41.95,Main,Chopper,0,0,0,,Kahretsin!
Dialogue: 0,0:10:44.49,0:10:47.04,Main,Zombies,0,0,0,,Hey, orada biri var!
Dialogue: 0,0:10:47.04,0:10:50.62,Main,Zombies,0,0,0,,Diğerlerini arındırıyorlar!
Dialogue: 0,0:10:53.25,0:10:55.92,Main,Franky,0,0,0,,Küçük kardeşlerimden...
Dialogue: 0,0:10:57.90,0:11:00.78,Main,Franky,0,0,0,,...pis ellerinizi çekin!
Dialogue: 0,0:11:04.39,0:11:06.55,Main,Zombies,0,0,0,,Kim bunlar?!
Dialogue: 0,0:11:06.55,0:11:08.00,Main,Zombies,0,0,0,,Fazlasıyla tehlikeliler!
Dialogue: 0,0:11:08.00,0:11:09.10,Main,Chopper,0,0,0,,A...
Dialogue: 0,0:11:09.10,0:11:10.86,Main,Chopper,0,0,0,,Abi!
Dialogue: 0,0:11:10.86,0:11:12.56,Main,Usopp,0,0,0,,Robin!
Dialogue: 0,0:11:13.83,0:11:15.82,Main,Franky,0,0,0,,Zamanında gelmedik mi?
Dialogue: 0,0:11:15.82,0:11:17.23,Main,Franky,0,0,0,,Kayıp biri var.
Dialogue: 0,0:11:19.17,0:11:19.91,Main,Robin,0,0,0,,Usopp.
Dialogue: 0,0:11:19.91,0:11:21.22,Main,Robin,0,0,0,,Chopper.
Dialogue: 0,0:11:21.22,0:11:22.34,Main,Robin,0,0,0,,Yaralı mısınız?
Dialogue: 0,0:11:26.93,0:11:28.96,Main,Zombie,0,0,0,,İmkansız!
Dialogue: 0,0:11:28.96,0:11:33.44,Main,Zombie,0,0,0,,Şarkı Mırıldanan bir yana, \Nzayıflığımızı bilen başkaları da ortaya çıktı!
Dialogue: 0,0:11:33.44,0:11:34.87,Main,Zombie,0,0,0,,Bu korkunç!
Dialogue: 0,0:11:34.87,0:11:39.86,Main,Zombie,0,0,0,,"Ölemeyiz" bizim sloganımızdı, \Ngünlerimi yok edilme korkusuyla geçirmek istemiyorum!
Dialogue: 0,0:11:39.86,0:11:45.11,Main,Robin,0,0,0,,Gölgesi alınanların bu uzun merdivenlerden taşındığını duymuştum.
Dialogue: 0,0:11:45.11,0:11:48.08,Main,Usopp,0,0,0,,Evet, Luffy buradan taşındı!
Dialogue: 0,0:11:48.08,0:11:50.47,Main,Usopp,0,0,0,,Onun peşinden gidiyorduk ama Nami...
Dialogue: 0,0:11:50.47,0:11:53.47,Main,Chopper,0,0,0,,Acaba Nami iyi mi?
Dialogue: 0,0:11:53.47,0:11:57.36,Main,Usopp,0,0,0,,Onu yok etmek istiyor gibi değildi.\NKesinlikle onu kurtarmak için döneceğiz!
Dialogue: 0,0:11:57.36,0:11:58.48,Main,Robin,0,0,0,,Bu arada,...
Dialogue: 0,0:11:58.48,0:12:01.53,Main,Robin,0,0,0,,...merdivenlerin yukarısından gelen canavar benzeri hırlama...
Dialogue: 0,0:12:01.53,0:12:03.01,Main,Robin,0,0,0,,...neyin nesiydi?
Dialogue: 0,0:12:03.01,0:12:06.01,Main,Franky,0,0,0,,Evet, duyduktan sonra oraya gittik.
Dialogue: 0,0:12:06.89,0:12:08.03,Main,Usopp,0,0,0,,O, Luffy'nin sesiydi.
Dialogue: 0,0:12:08.03,0:12:10.50,Main,Usopp,0,0,0,,Gördüğümüz her şeyi anlatacağız.
Dialogue: 0,0:12:10.50,0:12:13.21,Main,Usopp,0,0,0,,Neyse, korkunç bir şey oldu!
Dialogue: 0,0:12:15.06,0:12:16.72,Main,Zombie,0,0,0,,Daha fazlasını götürmeye devam edin!
Dialogue: 0,0:12:16.72,0:12:18.06,Main,Zombie,0,0,0,,Henüz yeterince yemedi!
Dialogue: 0,0:12:18.06,0:12:20.57,Main,Zombie,0,0,0,,Özel Zombi ne kadar yiyebilir ki?!
Dialogue: 0,0:12:20.57,0:12:23.78,Main,Zombie,0,0,0,,Tüm adanın erzağını yiyecek!
Dialogue: 0,0:12:27.97,0:12:30.85,Main,Moria,0,0,0,,Ne müthiş bir iştah.
Dialogue: 0,0:12:30.85,0:12:34.97,Main,Perona,0,0,0,,Ayıcık, o korsanları niye saklıyordun?!
Dialogue: 0,0:12:34.97,0:12:36.85,Main,Bearsy,0,0,0,,Ama... bu...
Dialogue: 0,0:12:36.85,0:12:38.52,Main,Perona,0,0,0,,Konuşmayı kes, hiç sevimli değil!
Dialogue: 0,0:12:38.52,0:12:41.13,Main,Oars,0,0,0,,Üzgünüm, küçük pırasa.
Dialogue: 0,0:12:41.13,0:12:45.15,Main,Oars,0,0,0,,Seni tanımıyorum ama yine de beni besliyorsun.
Dialogue: 0,0:12:45.15,0:12:47.51,Main,Oars,0,0,0,,Yetersiz ve tadının kötü olmasına rağmen.
Dialogue: 0,0:12:50.16,0:12:51.88,Main,Zombie,0,0,0,,Lanet olası Özel Zombi!
Dialogue: 0,0:12:51.88,0:12:53.86,Main,Zombie,0,0,0,,Bu kadar arsız olma!
Dialogue: 0,0:12:53.86,0:12:57.89,Main,Zombie,0,0,0,,Biz zombileri kimin hareket ettirdiğini sanıyorsun?!
Dialogue: 0,0:12:57.89,0:13:02.30,Main,Zombie,0,0,0,,Thriller Bark'ın hükümdarına nasıl şikayette bulunabilirsin?!
Dialogue: 0,0:13:02.30,0:13:06.08,Main,Zombie,0,0,0,,Efendi bir gün bu denizin hükümdarı-
Dialogue: 0,0:13:06.76,0:13:08.24,Main,Zombie,0,0,0,,Gerçekten üzgünüz!
Dialogue: 0,0:13:08.24,0:13:09.94,Main,Zombie,0,0,0,,Hepsini bu adam söyledi!
Dialogue: 0,0:13:09.94,0:13:12.18,Main,Zombie,0,0,0,,Hey, arkadaşlarını ispiyonlama!
Dialogue: 0,0:13:12.18,0:13:13.90,Main,Moria,0,0,0,,Dinle, Oz.
Dialogue: 0,0:13:13.90,0:13:19.65,Main,Moria,0,0,0,,500 yıl önce, ardında sayısız efsaneler bırakan kötü biriydin.
Dialogue: 0,0:13:19.65,0:13:24.56,Main,Moria,0,0,0,,Şimdiyse hizmetçim olmak için yeniden diriltildin.
Dialogue: 0,0:13:24.56,0:13:25.87,Main,Oars,0,0,0,,Hizmetçi?
Dialogue: 0,0:13:25.87,0:13:27.18,Main,Oars,0,0,0,,İstemiyorum.
Dialogue: 0,0:13:27.18,0:13:28.91,Main,Oars,0,0,0,,Bir hayalim var.
Dialogue: 0,0:13:28.91,0:13:31.97,Main,Zombie,0,0,0,,Hiç bu kadar küstah bir zombi görmedim!
Dialogue: 0,0:13:31.97,0:13:34.66,Main,Oars,0,0,0,,Burası dar ve sıkıcı.
Dialogue: 0,0:13:35.76,0:13:38.69,Main,Oz,0,0,0,,Biraz dışarı çıkacağım.
Dialogue: 0,0:13:38.69,0:13:41.83,Main,Oz,0,0,0,,Belki de denize açılıp dünyayı dolaşırım.
Dialogue: 0,0:13:41.83,0:13:43.24,Main,Zombie,0,0,0,,Yolculuğa mı çıkacaksın?!
Dialogue: 0,0:13:43.24,0:13:45.01,Main,Zombie,0,0,0,,Mankafa, bu imkansız.
Dialogue: 0,0:13:45.01,0:13:49.86,Main,Zombie,0,0,0,,Özel dondurucu, süper yoğun çelikten yapılmıştır\Nve hava geçirmeyecek şekilde mühürlenmiştir.
Dialogue: 0,0:13:49.86,0:13:51.94,Main,Zombie,0,0,0,,Biraz bile olsun çize-
Dialogue: 0,0:13:51.94,0:13:53.94,Main,Oz,0,0,0,,{\fad(100,100)}Gomu Gomu no...
Dialogue: 0,0:13:53.94,0:13:56.24,Main,Oz,0,0,0,,{\fad(100,100)}...Tabanca!
Dialogue: 0,0:13:57.24,0:13:59.48,Main,Zombie,0,0,0,,H-hey! Dur!
Dialogue: 0,0:13:59.48,0:14:03.65,Main,Zombie,0,0,0,,Bu korkunç, Oz kaçtı!
Dialogue: 0,0:14:04.54,0:14:06.09,Main,Oars,0,0,0,,Tuhaf.
Dialogue: 0,0:14:06.09,0:14:10.03,Main,Oars,0,0,0,,Kolumun uzayacağına dair içimde bir his vardı ama... her neyse.
Dialogue: 0,0:14:10.95,0:14:17.21,Main,Oz,0,0,0,,Korsanlar Kralı olacağım!
Dialogue: 0,0:14:18.96,0:14:20.97,Main,Ryuma,0,0,0,,Aynı o zamanki gibi...
Dialogue: 0,0:14:20.97,0:14:26.90,Main,Ryuuma,0,0,0,,"Afro olmaz", "afro olmaz" diye yalvararak,\Nutanmadan yine canını bağışlamam için yalvaracaksın.
Dialogue: 0,0:14:26.90,0:14:27.80,Main,Brookb,0,0,0,,Hayır!
Dialogue: 0,0:14:27.80,0:14:29.92,Main,Brook,0,0,0,,Öyle olmayacak!
Dialogue: 0,0:14:33.93,0:14:35.20,Thoughts,Brook,0,0,0,,{\i1}Anlamsız.{\i0}
Dialogue: 0,0:14:35.20,0:14:40.65,Thoughts,Brook,0,0,0,,{\i1}Cesaretimi toplayıp onları kessem bile,\No korkunç zombiler ayağa kalkıp duruyor!{\i0}
Dialogue: 0,0:14:41.35,0:14:43.86,Flashbacks,Brook,0,0,0,,{\i1}Kesinlikle zayıf bir yanları olmalı.{\i0}
Dialogue: 0,0:14:43.86,0:14:48.88,Flashbacks,Brook,0,0,0,,Bu durumda kendi zombimi bulsam bile, \Nyapabileceğim bir şey olmayacak.
Dialogue: 0,0:14:48.88,0:14:52.24,Flashbacks,Brook,0,0,0,,Dahası zombilerin yüzleri çok korkunç!
Dialogue: 0,0:14:55.84,0:14:57.49,Flashbacks,Zombie,0,0,0,,Birisi arındı!
Dialogue: 0,0:14:57.49,0:14:58.75,Flashbacks,Zombie,0,0,0,,Ne oldu?!
Dialogue: 0,0:14:59.17,0:15:03.21,Flashbacks,Zombie,0,0,0,,Acıkmıştı ve tuzlu ızgara balık yedi.
Dialogue: 0,0:15:03.98,0:15:05.57,Flashbacks,Zombie,0,0,0,,Aptal, o yeni gelen biriydi.
Dialogue: 0,0:15:05.57,0:15:08.22,Thoughts,Brook,0,0,0,,{\i1}Bu zombilerin zayıflığı olmalı!{\i0}
Dialogue: 0,0:15:08.22,0:15:11.27,Flashbacks,Hogback,0,0,0,,Sen! Gölgesini birkaç gün önce çaldığımız iskeletsin.
Dialogue: 0,0:15:11.27,0:15:12.71,Flashbacks,Hogback,0,0,0,,Buraya nasıl döndün?
Dialogue: 0,0:15:12.71,0:15:14.33,Flashbacks,Brook,0,0,0,,Soruma cevap ver!
Dialogue: 0,0:15:14.33,0:15:16.82,Flashbacks,Brook,0,0,0,,Gölgem hangi zombide?
Dialogue: 0,0:15:16.82,0:15:19.94,Flashbacks,Brook,0,0,0,,Cevap vermezsen, adanın her yerine balık bırakacağım!
Dialogue: 0,0:15:20.56,0:15:22.10,Flashbacks,Hogback,0,0,0,,Balık?
Dialogue: 0,0:15:23.45,0:15:25.36,Flashbacks,Hogback,0,0,0,,Peki bu beni nasıl etkileyecek?
Dialogue: 0,0:15:26.52,0:15:27.36,Flashbacks,Brook,0,0,0,,O...
Dialogue: 0,0:15:27.36,0:15:28.44,Flashbacks,Brook,0,0,0,,Yoksa...
Dialogue: 0,0:15:28.44,0:15:31.16,Flashbacks,Brook,0,0,0,,Ama tuz olabileceğini sanmıyorum.
Dialogue: 0,0:15:31.16,0:15:31.95,Flashbacks,Brook,0,0,0,,Tuz?
Dialogue: 0,0:15:34.78,0:15:39.31,Flashbacks,Hogback,0,0,0,,P-Peki t-tuzun ne faydası olacak?!
Dialogue: 0,0:15:39.31,0:15:41.40,Flashbacks,Brook,0,0,0,,Tuz!
Dialogue: 0,0:15:44.80,0:15:47.69,Thoughts,Brook,0,0,0,,{\i1}Zombiler gerçekten çok korkunç.{\i0}
Dialogue: 0,0:15:47.69,0:15:49.73,Thoughts,Brook,0,0,0,,{\i1}Geceleyin daha da kötü.{\i0}
Dialogue: 0,0:15:51.35,0:15:54.16,Flashbacks,Brooke,0,0,0,,Ah, sadece çekirgeymiş.
Dialogue: 0,0:15:54.16,0:15:55.56,Flashbacks,Brook,0,0,0,,Ödümü kopardı.
Dialogue: 0,0:15:55.56,0:16:00.61,Flashbacks,Brook,0,0,0,,Yine de güneş parlarken daha tehlikeli\Nve düşman tarafından bulunmak kolay.
Dialogue: 0,0:16:00.61,0:16:01.48,Flashbacks,Brooke,0,0,0,,Tabii ya!
Dialogue: 0,0:16:01.48,0:16:02.84,Flashbacks,Brook,0,0,0,,Şarkı!
Dialogue: 0,0:16:02.84,0:16:06.43,Flashbacks,Brook,0,0,0,,Korktuğun zaman kafandaki şeyleri atmak için şarkı söylemelisin!
Dialogue: 0,0:16:06.43,0:16:10.60,Flashbacks,Brook,0,0,0,,İskelet hızımı kullanarak yüzlerine\Nbakmazsam, onları arındırabileceğim.
Dialogue: 0,0:16:10.60,0:16:13.24,Flashbacks,Brook,0,0,0,,O zaman kesinlikle gölgemi bulacağım!
Dialogue: 0,0:16:15.61,0:16:17.91,Flashbacks,Zombie,0,0,0,,Bu şarkı da ne?
Dialogue: 0,0:16:17.91,0:16:19.52,Flashbacks,Zombie,0,0,0,,Biri şarkı mırıldanıyor.
Dialogue: 0,0:16:23.29,0:16:25.19,Flashbacks,Zombie,0,0,0,,O da kim?!
Dialogue: 0,0:16:33.02,0:16:33.93,Flashbacks,Absalom,0,0,0,,Sorun nedir?!
Dialogue: 0,0:16:33.93,0:16:35.39,Flashbacks,Absalom,0,0,0,,Adadaki bu karmaşa da ne?!
Dialogue: 0,0:16:35.39,0:16:38.25,Flashbacks,Zombie,0,0,0,,Karanlıkta bir şarkı mırıldanması duyduğunda\Nortaya çıkan korkunç yüzlü bir savaşçı var!
Dialogue: 0,0:16:38.25,0:16:43.07,Flashbacks,Zombie,0,0,0,,Kendi gölgesini bulmaya çalışarak etrafta dolanıyor!
Dialogue: 0,0:16:43.07,0:16:47.08,Flashbacks,Zombie,0,0,0,,Asker Zombiler'in çoğunu yok etti!
Dialogue: 0,0:16:47.08,0:16:49.37,Flashbacks,Zombie,0,0,0,,Lütfen bir şey yapın!
Dialogue: 0,0:16:49.37,0:16:51.94,Flashbacks,Bearsy,0,0,0,,Perona-sama, bir sorun var.
Dialogue: 0,0:16:51.94,0:16:53.00,Flashbacks,Perona,0,0,0,,Kapa çeneni!
Dialogue: 0,0:16:53.00,0:16:54.74,Flashbacks,Perona,0,0,0,,Beni uyandırma, Ayıcık.
Dialogue: 0,0:16:54.74,0:16:55.78,Flashbacks,Bearsy,0,0,0,,Lütfen kalkın.
Dialogue: 0,0:17:01.79,0:17:03.36,Flashbacks,Brook,0,0,0,,Nihayet karşılaştık.
Dialogue: 0,0:17:14.84,0:17:16.91,Thoughts,Brook,0,0,0,,{\i1}Bu güç de ne?{\i0}
Dialogue: 0,0:17:16.91,0:17:19.60,Thoughts,Brook,0,0,0,,{\i1}Bu benim zombim değil mi?{\i0}
Dialogue: 0,0:17:25.31,0:17:27.18,Thoughts,Brooke,0,0,0,,{\i1}Ona bir türlü ayak uyduramıyorum!{\i0}
Dialogue: 0,0:17:27.18,0:17:29.00,Thoughts,Brooke,0,0,0,,{\i1}Aynı kılıç tarzını paylaşmamıza rağmen!{\i0}
Dialogue: 0,0:17:32.33,0:17:34.25,Flashbacks,Ryuuma,0,0,0,,Pes et.
Dialogue: 0,0:17:34.25,0:17:37.20,Flashbacks,Ryuuma,0,0,0,,Kaç kez denersen dene, sonuç aynı olacak.
Dialogue: 0,0:17:37.20,0:17:43.33,Flashbacks,Ryuuma,0,0,0,,Daha hızlı hareket etmeye çalışırsan,\Nşu gülünç afronu keseceğim.
Dialogue: 0,0:17:43.33,0:17:44.89,Flashbacks,Brooke,0,0,0,,L-Lütfen dur!
Dialogue: 0,0:17:44.89,0:17:47.69,Flashbacks,Brooke,0,0,0,,Lütfen afroya dokunma!
Dialogue: 0,0:17:47.69,0:17:48.92,Flashbacks,Brooke,0,0,0,,Lütfen!
Dialogue: 0,0:17:48.92,0:17:50.40,Flashbacks,Brooke,0,0,0,,Niye bilmiyorsun?!
Dialogue: 0,0:17:50.40,0:17:54.33,Flashbacks,Brooke,0,0,0,,Benim gölgemsen, niye bu afronun\Nne kadar önemli olduğunu bilmiyorsun?!
Dialogue: 0,0:17:54.33,0:17:59.73,Flashbacks,Brooke,0,0,0,,Bedenim artık yaşlanmadığı için,\Nbir daha asla büyümeyecek!
Dialogue: 0,0:18:02.00,0:18:03.87,Flashbacks,Ryuuma,0,0,0,,Niye diye mi soruyorsun?
Dialogue: 0,0:18:03.87,0:18:08.39,Flashbacks,Ryuuma,0,0,0,,Seninle olan günlerimle ilgili her şeyi unuttum.
Dialogue: 0,0:18:08.39,0:18:13.73,Flashbacks,Ryuuma,0,0,0,,Şu anda sadece Moria-sama'ya ve\NAbsolom-sama'ya itaat ediyorum!
Dialogue: 0,0:18:16.53,0:18:21.38,Flashbacks,Ryuuma,0,0,0,,Afrosuna değer veren bir iskelet,\Nbenim için şakadan başka bir şey değil!
Dialogue: 0,0:18:22.80,0:18:24.01,Flashbacks,Brook,0,0,0,,Dur!
Dialogue: 0,0:18:24.01,0:18:25.07,Flashbacks,Brooke,0,0,0,,Afro olmaz!
Dialogue: 0,0:18:25.07,0:18:25.86,Flashbacks,Brooke,0,0,0,,Afro olmaz!
Dialogue: 0,0:18:25.86,0:18:26.21,Flashbacks,Brooke,0,0,0,,Afro olmaz!
Dialogue: 0,0:18:26.21,0:18:28.01,Flashbacks,Brooke,0,0,0,,Afro olmaz!
Dialogue: 0,0:18:34.76,0:18:37.67,Flashbacks,Ryuuma,0,0,0,,Ne kötü bir manzara, eski efendim.
Dialogue: 0,0:18:37.67,0:18:41.64,Flashbacks,Brooke,0,0,0,,Üzgünüm, yenildim.
Dialogue: 0,0:18:42.55,0:18:44.31,Flashbacks,Brooke,0,0,0,,Lütfen gitmeme izin ver.
Dialogue: 0,0:18:44.99,0:18:47.83,Flashbacks,Brooke,0,0,0,,Hemen bu adayı terkedeceğim.
Dialogue: 0,0:18:47.83,0:18:49.60,Flashbacks,Ryuuma,0,0,0,,O zaman gözümün önünden kaybol.
Dialogue: 0,0:18:51.22,0:18:54.18,Flashbacks,Ryuuma,0,0,0,,Ölürsen benim için de sıkıntı olur.
Dialogue: 0,0:18:58.60,0:19:00.86,Main,Ryuuma,0,0,0,,Acınası bir manzaraydı.
Dialogue: 0,0:19:02.09,0:19:04.49,Main,Brooke,0,0,0,,Ne istersen söyle.
Dialogue: 0,0:19:07.77,0:19:09.81,Main,Brooke,0,0,0,,Geçen beş yıl boyunca,...
Dialogue: 0,0:19:09.81,0:19:12.85,Main,Brooke,0,0,0,,...sadece bu an için...
Dialogue: 0,0:19:13.72,0:19:15.89,Main,Brooke,0,0,0,,...güçlendim!
Dialogue: 0,0:19:26.44,0:19:28.86,Main,Zombie,0,0,0,,Absalom-sama.
Dialogue: 0,0:19:28.86,0:19:31.23,Main,Absalom,0,0,0,,Tören için her şey hazır mı?
Dialogue: 0,0:19:33.04,0:19:36.15,Main,Zombie,0,0,0,,Ne zaman isterseniz.
Dialogue: 0,0:19:37.22,0:19:38.94,Main,Zombie,0,0,0,,Ne güzel bir gelin.
Dialogue: 0,0:19:38.94,0:19:40.74,Main,Absalom,0,0,0,,Törene hemen başlayacağız.
Dialogue: 0,0:19:41.41,0:19:44.58,Main,Absalom,0,0,0,,Ona bir elbise giydir ve düğün salonuna getir.
Dialogue: 0,0:19:44.58,0:19:47.52,Main,Zombie,0,0,0,,Evet, hemen.
Dialogue: 0,0:19:54.48,0:19:57.65,Main,Franky,0,0,0,,Devlerden büyük bir canavar mı?!
Dialogue: 0,0:19:57.65,0:19:58.77,Main,Usopp,0,0,0,,Evet.
Dialogue: 0,0:19:58.77,0:20:02.22,Main,Usopp,0,0,0,,Deminki inanılmaz gürültüyü ve \Nkükremeyi o çıkarıyordu.
Dialogue: 0,0:20:02.80,0:20:06.85,Main,Usopp,0,0,0,,Luffy'nin zombisinin kükreyişini ve \Nsağı solu yıkışını sadece hayal edebilirim.
Dialogue: 0,0:20:08.20,0:20:08.72,Main,Usopp,0,0,0,,Acele edelim!
Dialogue: 0,0:20:10.49,0:20:12.30,Main,Usopp,0,0,0,,Hey, bakın!
Dialogue: 0,0:20:12.30,0:20:14.01,Main,Usopp,0,0,0,,İşte Sunny!
Dialogue: 0,0:20:14.01,0:20:16.27,Main,Franky,0,0,0,,Anlıyorum.
Dialogue: 0,0:20:17.00,0:20:21.57,Main,Franky,0,0,0,,Eğer dümdüz yukarı çıkarsan, patronun odasına ulaşırsın.
Dialogue: 0,0:20:21.57,0:20:25.28,Main,Usopp,0,0,0,,O merdivenler boşaltım için mi kullanılmış?
Dialogue: 0,0:20:25.28,0:20:27.49,Main,Usopp,0,0,0,,Hey!
Dialogue: 0,0:20:27.49,0:20:29.77,Main,Usopp,0,0,0,,Her yer mahvolmuş!
Dialogue: 0,0:20:29.77,0:20:31.48,Main,Robin,0,0,0,,Zombilerin işi olduğuna şüphe yok.
Dialogue: 0,0:20:31.48,0:20:33.46,Main,Robin,0,0,0,,Her yerde çamurlu ayak izleri var.
Dialogue: 0,0:20:33.46,0:20:35.46,Main,Chopper,0,0,0,,O zaman hala orada olabilirler.
Dialogue: 0,0:20:35.46,0:20:38.54,Main,Franky,0,0,0,,Gerçekten curcuna olmuş.
Dialogue: 0,0:20:38.54,0:20:41.26,Main,Franky,0,0,0,,Neredeyse hiçbir şey kalmamış.
Dialogue: 0,0:20:41.80,0:20:44.22,Main,Chopper,0,0,0,,Etrafta hiç zombi var mı?
Dialogue: 0,0:20:44.22,0:20:47.01,Main,Usopp,0,0,0,,Öncelikle nerede olabilirler?
Dialogue: 0,0:20:47.01,0:20:48.72,Main,Franky,0,0,0,,Onları görmüyorum.
Dialogue: 0,0:20:49.32,0:20:50.33,Main,Chopper,0,0,0,,Hey!
Dialogue: 0,0:20:50.33,0:20:51.66,Main,Chopper,0,0,0,,Luffy!
Dialogue: 0,0:20:51.66,0:20:52.83,Main,Chopper,0,0,0,,Zoro!
Dialogue: 0,0:20:52.83,0:20:53.85,Main,Chopper,0,0,0,,Sanji!
Dialogue: 0,0:20:55.00,0:20:58.06,Main,Usopp,0,0,0,,Hey, yemek odasındalar!
Dialogue: 0,0:20:58.06,0:20:59.50,Main,Usopp,0,0,0,,Üçü de!
Dialogue: 0,0:21:00.65,0:21:05.07,Main,Usopp,0,0,0,,Zombiler onları yeniden dekore etmiş.
Dialogue: 0,0:21:06.86,0:21:07.80,Main,Robin,0,0,0,,Acıklı.
Dialogue: 0,0:21:09.21,0:21:10.57,Main,Franky,0,0,0,,Uyanın!
Dialogue: 0,0:21:10.57,0:21:12.05,Main,Franky,0,0,0,,Uyuyacak zaman değil!
Dialogue: 0,0:21:12.05,0:21:14.95,Main,Franky,0,0,0,,Ciddi sorunlarımız var!
Dialogue: 0,0:21:15.51,0:21:17.44,Main,Usopp,0,0,0,,Hala uyuyorlar.
Dialogue: 0,0:21:17.44,0:21:19.66,Main,Franky,0,0,0,,Hiçbir şey hissetmediler mi?
Dialogue: 0,0:21:19.66,0:21:21.15,Main,Franky,0,0,0,,Yapacak bir şey yok.
Dialogue: 0,0:21:21.80,0:21:24.25,Main,Franky,0,0,0,,Hey, geri durun. Bazuka kullanacağım.
Dialogue: 0,0:21:24.25,0:21:26.13,Main,Usopp,0,0,0,,Hayır, gerek yok.
Dialogue: 0,0:21:27.84,0:21:31.20,Main,Usopp,0,0,0,,Güzel bir dişi kılıç ustası bir sürü et getirdi!
Dialogue: 0,0:21:31.20,0:21:31.93,Main,Sanji,0,0,0,,Güzel?
Dialogue: 0,0:21:31.93,0:21:32.61,Main,Luffy,0,0,0,,Et?
Dialogue: 0,0:21:32.61,0:21:33.36,Main,Zoro,0,0,0,,Kılıç Ustası?
Dialogue: 0,0:21:33.36,0:21:35.10,Main,Chopper,0,0,0,,Bunlar umutsuz vaka!
