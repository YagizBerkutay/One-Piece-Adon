Dialogue: 0,0:02:30.46,0:02:39.23,Title,,0,0,0,,{\fad(2000,2000)}Hasır Şapka Korsanları! Ortaya Çıkın!\NTayfanın Umutsuz Karşı Saldırısı!
Dialogue: 0,0:02:44.31,0:02:46.91,Main,Hogback,0,0,0,,Hey! Sorun nedir, Cindry-chan?!
Dialogue: 0,0:02:46.91,0:02:48.18,Main,Cindry,0,0,0,,Bedenim...
Dialogue: 0,0:02:49.76,0:02:50.92,Main,Cindry,0,0,0,,...kıpırdamıyor.
Dialogue: 0,0:02:52.42,0:02:56.76,Main,Cindry,0,0,0,,Gözyaşları kendiliğinden akmaya başladı.
Dialogue: 0,0:02:56.76,0:02:58.61,Main,Hogback,0,0,0,,Bedenin kıpırdamıyor mu?
Dialogue: 0,0:02:58.61,0:03:00.35,Main,Hogback,0,0,0,,Ne dediğini sanıyorsun sen?!
Dialogue: 0,0:03:00.35,0:03:02.19,Main,Hogback,0,0,0,,Şu saçma, sahte gözyaşlarını durdurabilirsin artık!
Dialogue: 0,0:03:02.83,0:03:08.95,Main,Hogback,0,0,0,,Kendi ruhun olmadığı halde seni\Nhareket ettiren kimdi sanıyorsun?!
Dialogue: 0,0:03:09.10,0:03:15.12,Main,Hogback,0,0,0,,Sadece efendinin emirlerine uyarak yaşamak!
Dialogue: 0,0:03:15.12,0:03:19.18,Main,Robin,0,0,0,,Sanki bedenin asıl sahibi direniyormuş gibi görünüyor.
Dialogue: 0,0:03:19.84,0:03:22.86,Main,Chopper,0,0,0,,Yani ölümünden 10 yıl sonra bile,...
Dialogue: 0,0:03:22.86,0:03:26.32,Main,Chopper,0,0,0,,...ruhun bedeni terketmiş olmasına\Nrağmen iradesi hala mevcut mu?
Dialogue: 0,0:03:26.72,0:03:31.81,Main,Robin,0,0,0,,Dünyadaki tüm kütüphanelerle bile\Nsana nasıl cevap vereceğimi bilemezdim.
Dialogue: 0,0:03:34.03,0:03:36.66,Main,Cindry,0,0,0,,Onları öldüreceğim.
Dialogue: 0,0:03:36.95,0:03:38.24,Main,Hogback,0,0,0,,Ah, evet.
Dialogue: 0,0:03:38.24,0:03:41.47,Main,Hogback,0,0,0,,Demek nihayet kendine geldin, Cindry-chan?!
Dialogue: 0,0:03:41.47,0:03:44.64,Main,Hogback,0,0,0,,Şimdi kaçana kadar bana biraz vakit kazandır!
Dialogue: 0,0:03:44.64,0:03:46.46,Main,Robin,0,0,0,,Çok yazık.
Dialogue: 0,0:03:46.46,0:03:49.86,Main,Robin,0,0,0,,Bir mucizeye tanıklık ediyor olabileceğimi düşünmüştüm.
Dialogue: 0,0:03:49.86,0:03:51.14,Main,Robin,0,0,0,,{\fad(150,150)}Doce Fleur!
Dialogue: 0,0:03:49.86,0:03:51.14,Note,Note,0,0,0,,{\fad(150,150)}Bir Düzine Çiçek!
Dialogue: 0,0:03:56.00,0:03:57.15,Main,Chopper,0,0,0,,Dur!
Dialogue: 0,0:04:00.27,0:04:02.00,Main,Hogback,0,0,0,,Bu sarsıntı da ne?!
Dialogue: 0,0:04:06.69,0:04:07.28,Main,Hogback,0,0,0,,Kahretsin!
Dialogue: 0,0:04:07.28,0:04:11.85,Main,Hogback,0,0,0,,Korsan geyik! Ceset haklarından bahseden zavallı insan!
Dialogue: 0,0:04:12.44,0:04:14.79,Main,Hogback,0,0,0,,Sen de insan değilsin!
Dialogue: 0,0:04:14.79,0:04:16.03,Main,Hogback,0,0,0,,Canavar herif!
Dialogue: 0,0:04:16.49,0:04:18.09,Main,Chopper,0,0,0,,Tayfamızın kaptanına göre...
Dialogue: 0,0:04:18.09,0:04:22.80,Main,Chopper,0,0,0,,...canavar, sayborg, sapık, uzun burun, marimo,...
Dialogue: 0,0:04:22.80,0:04:24.88,Main,Chopper,0,0,0,,...çok çeşitli insan var!
Dialogue: 0,0:04:25.64,0:04:29.66,Main,Chopper,0,0,0,,Senin yaptığın gibi cesetleri emrine\Nuyması için zorlamasına gerek yok!
Dialogue: 0,0:04:30.89,0:04:32.35,Main,Hogback,0,0,0,,Bırak beni!
Dialogue: 0,0:04:32.35,0:04:33.51,Main,Chopper,0,0,0,,Robin!
Dialogue: 0,0:04:33.90,0:04:35.49,Main,Robin,0,0,0,,Tamam, bana bırak.
Dialogue: 0,0:04:36.34,0:04:37.72,Note,Robin,0,0,0,,{\fad(150,150)}Bacak Çiçeği!
Dialogue: 0,0:04:36.34,0:04:37.72,Main,Robin,0,0,0,,{\fad(150,150)}Pierna Fleur!
Dialogue: 0,0:04:39.24,0:04:40.97,Main,Hogback,0,0,0,,Ne?!
Dialogue: 0,0:04:46.75,0:04:50.08,Main,Hogback,0,0,0,,D-D-Dur biraz, Dr. Chopper!
Dialogue: 0,0:04:50.08,0:04:52.33,Main,Hogback,0,0,0,,Bu yükseklikten düşüp kafamı çarparsam,...
Dialogue: 0,0:04:52.33,0:04:55.38,Main,Hogback,0,0,0,,...tüm dünyanın değer verdiği\Nbu dahi beyin ezilecek!
Dialogue: 0,0:04:55.38,0:04:56.92,Main,Hogback,0,0,0,,Buna razı mısın?!
Dialogue: 0,0:04:56.92,0:04:58.06,Main,Hogback,0,0,0,,Umrumda değil!
Dialogue: 0,0:04:58.41,0:05:02.96,Main,Chopper,0,0,0,,Kafanın içindeki şey zombilerinkinden\Ndaha fazla kokuşmuş!
Dialogue: 0,0:05:02.96,0:05:04.33,Main,Chopper,0,0,0,,Al bakalım!
Dialogue: 0,0:05:04.33,0:05:06.55,Main,Chopper,0,0,0,,{\fad(150,150)}Robicho Bankı!
Dialogue: 0,0:05:11.37,0:05:14.91,Captions,Sign,0,0,200,,{\fad(600,600)}Yakınlarda, Özel Dondurucu Odasında
Dialogue: 0,0:05:12.57,0:05:14.67,Main,Luffy,0,0,0,,{\an8}Devden daha büyük.
Dialogue: 0,0:05:16.03,0:05:17.68,Main,Luffy,0,0,0,,Bu gerçekten benim zombim mi?
Dialogue: 0,0:05:20.75,0:05:23.02,Main,Moria,0,0,0,,Seni bekliyordum, Oz.
Dialogue: 0,0:05:23.02,0:05:27.11,Main,Moria,0,0,0,,Bedenin ve gölgen nihayet senkronize olmuş görünüyor!
Dialogue: 0,0:05:27.11,0:05:30.19,Main,Moria,0,0,0,,İtaatkâr bir zombi oldun mu?!
Dialogue: 0,0:05:30.19,0:05:33.11,Main,Moria,0,0,0,,Cevap ver! Efendin kim?!
Dialogue: 0,0:05:33.99,0:05:37.27,Main,Oz,0,0,0,,Efendim, Moria-sama!
Dialogue: 0,0:05:37.60,0:05:39.25,Main,Luffy,0,0,0,,Ne?!
Dialogue: 0,0:05:41.19,0:05:42.99,Main,Luffy,0,0,0,,Hey! Neden bahsediyorsun sen?!
Dialogue: 0,0:05:42.99,0:05:44.99,Main,Luffy,0,0,0,,Gerçekten benim gölgem misin?!
Dialogue: 0,0:05:44.99,0:05:46.46,Main,Luffy,0,0,0,,Bu adamın sana söylediğini dinleme!
Dialogue: 0,0:05:47.47,0:05:50.80,Main,Oz,0,0,0,,Sen de kimsin, hasır şapkalı?
Dialogue: 0,0:05:52.70,0:05:56.20,Main,Moria,0,0,0,,Sana ilk önemli görevini vereceğim!
Dialogue: 0,0:05:56.20,0:06:00.80,Main,Moria,0,0,0,,Şu anda Thriller Bark'a zarar verenler bunlar!
Dialogue: 0,0:06:00.80,0:06:03.74,Main,Moria,0,0,0,,Hasır Şapka tayfası!
Dialogue: 0,0:06:03.74,0:06:08.03,Main,Moria,0,0,0,,Gemilerine dönene dek onları döveceksin!
Dialogue: 0,0:06:08.03,0:06:10.48,Main,Moria,0,0,0,,Bu sırada ölseler de umrumda değil!
Dialogue: 0,0:06:10.48,0:06:16.12,Main,Moria,0,0,0,,Gerçekten ödüllerine layıksalar, sadece\Ndövmek onları öldürmeye yetmez!
Dialogue: 0,0:06:16.12,0:06:17.88,Main,Moria,0,0,0,,Elinden geleni yap!
Dialogue: 0,0:06:17.88,0:06:20.67,Main,Moria,0,0,0,,Gücünü görmek istiyorum!
Dialogue: 0,0:06:20.67,0:06:23.40,Main,Oz,0,0,0,,Peki, Moria-sama.
Dialogue: 0,0:06:25.63,0:06:28.59,Main,Oz,0,0,0,,Hasır Şapka'yı buldum!
Dialogue: 0,0:06:30.47,0:06:32.27,Main,Moria,0,0,0,,Elveda, Hasır Şapka!
Dialogue: 0,0:06:33.47,0:06:34.74,Main,Luffy,0,0,0,,Kaçıyor musun?!
Dialogue: 0,0:06:34.74,0:06:38.21,Main,Oz,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:06:38.68,0:06:40.17,Main,Luffy,0,0,0,,D-D-Dur bir dakika!
Dialogue: 0,0:06:40.17,0:06:41.21,Main,Luffy,0,0,0,,Bu çok tehlikeli!
Dialogue: 0,0:06:41.41,0:06:43.73,Main,Oz,0,0,0,,{\fad(150,150)}...Çan!
Dialogue: 0,0:06:48.09,0:06:48.95,Main,Robin,0,0,0,,Ne?!
Dialogue: 0,0:06:48.95,0:06:50.11,Main,Chopper,0,0,0,,L-Luffy'nin zombisi!
Dialogue: 0,0:06:50.11,0:06:51.72,Main,Hogback,0,0,0,,Oz!
Dialogue: 0,0:06:52.41,0:06:53.66,Main,Robin,0,0,0,,Taban çöküyor!
Dialogue: 0,0:06:53.66,0:06:55.29,Main,Robin,0,0,0,,Chopper, bu tarafa!
Dialogue: 0,0:07:01.80,0:07:03.37,Main,Chopper,0,0,0,,Çok yakındı.
Dialogue: 0,0:07:06.70,0:07:08.59,Main,Robin,0,0,0,,Bu...
Dialogue: 0,0:07:08.59,0:07:10.04,Main,Robin,0,0,0,,...Luffy mi?
Dialogue: 0,0:07:10.04,0:07:13.41,Main,Chopper,0,0,0,,Hogback ve Cindry alt kata düştü.
Dialogue: 0,0:07:13.41,0:07:14.65,Main,Hogback,0,0,0,,Kahretsin.
Dialogue: 0,0:07:14.65,0:07:16.21,Main,Hogback,0,0,0,,Ağır.
Dialogue: 0,0:07:16.21,0:07:20.18,Main,Hogback,0,0,0,,Cindry-chan, şu taşı üstümden çek!
Dialogue: 0,0:07:21.43,0:07:23.60,Main,Hogback,0,0,0,,C-Cindry-chan, acele et!
Dialogue: 0,0:07:23.60,0:07:24.56,Main,Hogback,0,0,0,,Hemen kurtar beni!
Dialogue: 0,0:07:25.32,0:07:27.89,Main,Hogback,0,0,0,,Bak! Oz geliyor!
Dialogue: 0,0:07:28.48,0:07:29.99,Main,Hogback,0,0,0,,Ben...
Dialogue: 0,0:07:29.99,0:07:32.20,Main,Hogback,0,0,0,,Dahi ben,...
Dialogue: 0,0:07:32.20,0:07:34.31,Main,Hogback,0,0,0,,...onun ayağı altında ezileceğim!
Dialogue: 0,0:07:34.31,0:07:36.69,Main,Hogback,0,0,0,,Hey, ne yapıyorsun sen?!
Dialogue: 0,0:07:36.69,0:07:39.50,Main,Hogback,0,0,0,,Ben efendinim!
Dialogue: 0,0:07:47.35,0:07:49.05,Main,Cindry,0,0,0,,Bedenim...
Dialogue: 0,0:07:49.05,0:07:50.20,Main,Cindry,0,0,0,,...kıpırdamıyor.
Dialogue: 0,0:07:50.36,0:07:51.82,Main,Hogback,0,0,0,,Ne?!
Dialogue: 0,0:07:54.15,0:07:57.33,Main,Hogback,0,0,0,,Yine şu işe yaramaz saçmalığa başlama!
Dialogue: 0,0:07:57.33,0:08:01.04,Main,Hogback,0,0,0,,Zombilerin efendilerine hizmet\Netmekten başka iradesi yok!
Dialogue: 0,0:08:01.04,0:08:03.22,Main,Hogback,0,0,0,,Hemen kurtar beni!
Dialogue: 0,0:08:03.22,0:08:07.00,Main,Hogback,0,0,0,,Güzel yüzlü bir cesetten başka bir şey değilsin!
Dialogue: 0,0:08:17.54,0:08:20.41,Main,Hogback,0,0,0,,Hey, acele et Cindry!
Dialogue: 0,0:08:20.41,0:08:22.80,Main,Hogback,0,0,0,,Oz bu tarafa geliyor!
Dialogue: 0,0:08:25.42,0:08:28.81,Main,Hogback,0,0,0,,Oz! Aşağı bak!
Dialogue: 0,0:08:28.81,0:08:30.69,Main,Hogback,0,0,0,,Seni aptal! Benim!
Dialogue: 0,0:08:30.69,0:08:34.84,Main,Hogback,0,0,0,,Sana hareket edebilen bir beden veren kişi benim!
Dialogue: 0,0:08:41.95,0:08:44.30,Captions,Sign,0,0,200,,{\fad(550,0)}Yakınlarda, Perona'nın odasının dışındaki koridorda
Dialogue: 0,0:08:42.54,0:08:44.30,Main,Usopp,0,0,0,,{\an8}B-B-Bu da ne?!
Dialogue: 0,0:08:45.06,0:08:48.14,Main,Usopp,0,0,0,,Bu sarsıntı deminkinden çok farklı!
Dialogue: 0,0:08:50.75,0:08:53.09,Main,Usopp,0,0,0,,Lu-Lu-Lu...!
Dialogue: 0,0:08:53.09,0:08:55.05,Main,Usopp,0,0,0,,Luffy'nin zombisi!
Dialogue: 0,0:08:55.09,0:08:57.45,Captions,Sign,0,0,200,,{\fad(550,0)}Yakınlarda, kilisede
Dialogue: 0,0:08:58.59,0:09:01.62,Main,Sanji,0,0,0,,Hey, hey, hey, hey, bu sarsıntı da ne?!
Dialogue: 0,0:09:06.69,0:09:07.93,Main,Sanji,0,0,0,,Bu da ne?!
Dialogue: 0,0:09:07.93,0:09:09.29,Main,Sanji,0,0,0,,Bu, Luffy'nin zombisi mi?!
Dialogue: 0,0:09:12.00,0:09:12.93,Main,Sanji,0,0,0,,Kahretsin!
Dialogue: 0,0:09:13.30,0:09:16.13,Main,Sanji,0,0,0,,Nami-san, uyuyacak zaman değil!
Dialogue: 0,0:09:16.13,0:09:17.81,Main,Sanji,0,0,0,,Başka çare yok!
Dialogue: 0,0:09:17.81,0:09:19.07,Main,Sanji,0,0,0,,Şimdilik kaçmalıyız!
Dialogue: 0,0:09:22.38,0:09:23.27,Main,Sanji,0,0,0,,Nami-san?
Dialogue: 0,0:09:26.22,0:09:27.95,Main,Sanji,0,0,0,,Nami-san yok oldu.
Dialogue: 0,0:09:32.38,0:09:33.28,Main,Sanji,0,0,0,,Yoksa...
Dialogue: 0,0:09:36.31,0:09:38.64,Main,Absalom,0,0,0,,İşler iyice kötüleşti!
Dialogue: 0,0:09:40.29,0:09:41.28,Main,Sanji,0,0,0,,Pislik!
Dialogue: 0,0:09:41.28,0:09:42.77,Main,Sanji,0,0,0,,Hala hayatta mısın?!
Dialogue: 0,0:09:42.77,0:09:45.03,Main,Sanji,0,0,0,,Hayvan adam, göster kendini!
Dialogue: 0,0:09:47.60,0:09:51.47,Main,Absalom,0,0,0,,Bu şeytan nihayet kontrolümüze girmiş gibi!
Dialogue: 0,0:09:51.47,0:09:53.55,Main,Absalom,0,0,0,,Dövüş bitti!
Dialogue: 0,0:09:53.55,0:09:56.07,Main,Absalom,0,0,0,,Bu kez karımı alacağım!
Dialogue: 0,0:09:56.91,0:09:58.08,Main,Sanji,0,0,0,,Kahretsin!
Dialogue: 0,0:09:58.08,0:09:59.46,Main,Sanji,0,0,0,,Nami-san'ı geri ver!
Dialogue: 0,0:09:59.46,0:10:01.38,Main,Sanji,0,0,0,,Pislik, neredesin?!
Dialogue: 0,0:10:01.95,0:10:06.28,Main,Absalom,0,0,0,,En üstün zombiyle biraz eğlen!
Dialogue: 0,0:10:27.30,0:10:29.12,Main,Franky,0,0,0,,Bir şey çıktı!
Dialogue: 0,0:10:30.50,0:10:32.78,Main,Franky,0,0,0,,B-Bu...
Dialogue: 0,0:10:33.55,0:10:35.02,Main,Franky,0,0,0,,...bir zombi!
Dialogue: 0,0:10:35.02,0:10:36.81,Main,Franky,0,0,0,,Luffy'nin zombisi!
Dialogue: 0,0:10:36.81,0:10:38.38,Main,Franky,0,0,0,,Oraya bak!
Dialogue: 0,0:10:38.38,0:10:41.65,Main,Franky,0,0,0,,Onunla birlikte çıkan kıvırcık aşçı değil mi?!
Dialogue: 0,0:10:43.05,0:10:44.29,Main,Sanji,0,0,0,,Kahretsin!
Dialogue: 0,0:10:44.29,0:10:45.73,Main,Sanji,0,0,0,,Nami-san!
Dialogue: 0,0:10:45.73,0:10:49.06,Main,Zoro,0,0,0,,Ne yapıyor bu?! Aptal aşçı!
Dialogue: 0,0:10:50.19,0:10:53.25,Main,Luffy,0,0,0,,DUR!
Dialogue: 0,0:10:53.78,0:10:55.38,Main,Luffy,0,0,0,,MORIA!
Dialogue: 0,0:10:56.60,0:10:59.66,Main,Moria,0,0,0,,Sonsuza kadar beni takip mi edeceksin?!
Dialogue: 0,0:10:59.66,0:11:01.76,Main,Luffy,0,0,0,,O koca adam ilgimi çekti ama...
Dialogue: 0,0:11:01.76,0:11:06.83,Main,Luffy,0,0,0,,...herkesin gölgesini geri almak istiyorsam, yenmem gereken kişi sensin!
Dialogue: 0,0:11:06.83,0:11:09.31,Main,Luffy,0,0,0,,Kaçamayacaksın!
Dialogue: 0,0:11:10.93,0:11:13.89,Captions,Sign,0,0,200,,{\fad(600,0)}Kilise
Dialogue: 0,0:11:14.85,0:11:15.64,Main,Absalom,0,0,0,,Bak!
Dialogue: 0,0:11:15.64,0:11:17.89,Main,Absalom,0,0,0,,Sonunda gülen benim!
Dialogue: 0,0:11:18.90,0:11:20.86,Main,Absalom,0,0,0,,Hala derin uykuda gibisin...
Dialogue: 0,0:11:21.40,0:11:22.96,Main,Absalom,0,0,0,,Başka bir yer bulalım.
Dialogue: 0,0:11:22.96,0:11:27.15,Main,Absalom,0,0,0,,Ve bir kez daha düğünümüzü yapacağız.
Dialogue: 0,0:11:27.15,0:11:29.57,Main,Absalom,0,0,0,,Sessiz karım!
Dialogue: 0,0:11:31.15,0:11:32.83,Main,Zombie,0,0,0,,Perona-sama güvende mi?!
Dialogue: 0,0:11:32.83,0:11:34.37,Main,Zombie,0,0,0,,Kendinden geçmiş!
Dialogue: 0,0:11:34.37,0:11:36.17,Main,Zombie,0,0,0,,Ama yaralı gibi görünmüyor!
Dialogue: 0,0:11:36.17,0:11:39.05,Main,Zombie,0,0,0,,Kaptan Ayıcık ve hatta Yardımcı Kaptan...
Dialogue: 0,0:11:39.05,0:11:41.10,Main,Zombie,0,0,0,,Lanet olası Uzun Burun!
Dialogue: 0,0:11:41.10,0:11:42.20,Main,Zombie,0,0,0,,Onu buradan çıkarın!
Dialogue: 0,0:11:42.20,0:11:44.11,Main,Zombie,0,0,0,,Malikâne çöküyor!
Dialogue: 0,0:11:44.11,0:11:46.59,Main,Zombie,0,0,0,,Biz Özel Zombiler, onun intikamını alacağız!
Dialogue: 0,0:11:48.12,0:11:49.94,Main,Zombie,0,0,0,,Herkes çöken malikâneden çıksın!
Dialogue: 0,0:11:51.11,0:11:52.59,Main,Zombie,0,0,0,,Özel Zombiler dövüşecek!
Dialogue: 0,0:11:53.86,0:11:55.23,Main,Zombie,0,0,0,,Ne yer ama!
Dialogue: 0,0:11:55.23,0:11:58.56,Main,Zombie,0,0,0,,Çatının üstünden dev kafayı görebiliyorum!
Dialogue: 0,0:11:58.81,0:12:00.03,Captions,Sign,0,0,200,,{\fad(600,0)}Perona'nın Harika Bahçesi
Dialogue: 0,0:12:02.50,0:12:03.50,Main,Chopper,0,0,0,,Usopp!
Dialogue: 0,0:12:04.86,0:12:05.20,Main,Usopp,0,0,0,,Chopper!
Dialogue: 0,0:12:05.20,0:12:06.00,Main,Usopp,0,0,0,,Robin!
Dialogue: 0,0:12:06.00,0:12:07.97,Main,Usopp,0,0,0,,K-K-K-Korkunç!
Dialogue: 0,0:12:07.97,0:12:09.92,Main,Usopp,0,0,0,,L-L-L-Luffy'nin zombisinin kolunda,...
Dialogue: 0,0:12:09.92,0:12:11.81,Main,Usopp,0,0,0,,...b-b-bizim...
Dialogue: 0,0:12:11.81,0:12:14.41,Main,Usopp,0,0,0,,...aranıyor posterlerimiz var!
Dialogue: 0,0:12:15.52,0:12:18.25,Main,Usopp,0,0,0,,H-Hedefi...
Dialogue: 0,0:12:21.42,0:12:24.04,Main,Usopp,0,0,0,,...bizi tamamen yok etmek!
Dialogue: 0,0:12:25.32,0:12:29.49,Main,Oz,0,0,0,,ÇIKIN ORTAYA!!
Dialogue: 0,0:12:29.49,0:12:35.43,Main,Oz,0,0,0,,HASIR ŞAPKA TAYFASI!!!
Dialogue: 0,0:12:37.49,0:12:39.31,Main,Sanji,0,0,0,,Pislik,...
Dialogue: 0,0:12:39.31,0:12:42.09,Main,Sanji,0,0,0,,...bize engel olmaya mı çalışıyor?!
Dialogue: 0,0:12:42.93,0:12:44.10,Main,Usopp,0,0,0,,O Luffy...
Dialogue: 0,0:12:44.10,0:12:46.91,Main,Usopp,0,0,0,,...kendi tayfasını mı yok edecek?!
Dialogue: 0,0:12:47.67,0:12:49.32,Main,Robin,0,0,0,,Kendisine emir verilmiş gibi.
Dialogue: 0,0:12:50.21,0:12:52.47,Main,Chopper,0,0,0,,Asıl Luffy güvende mi?
Dialogue: 0,0:12:52.68,0:12:54.92,Main,Brook,0,0,0,,O şey de ne?!
Dialogue: 0,0:12:55.62,0:12:58.37,Main,Franky,0,0,0,,O şeyi yenmenin bir yolu var mı?
Dialogue: 0,0:12:59.40,0:13:00.96,Main,Zoro,0,0,0,,İlginç.
Dialogue: 0,0:13:08.96,0:13:11.67,Main,Luffy,0,0,0,,Bekle, Moria!
Dialogue: 0,0:13:15.80,0:13:17.32,Main,Moria,0,0,0,,Burası çıkmaz yol değil mi?
Dialogue: 0,0:13:19.24,0:13:27.52,Main,Moria,0,0,0,,Sen böyle koşarken, tüm tayfan senin dövüş yeteneklerine kurban oluyor, Hasır Şapka!
Dialogue: 0,0:13:39.21,0:13:41.28,Main,Brook,0,0,0,,O-O da ne?
Dialogue: 0,0:13:41.28,0:13:43.11,Main,Brook,0,0,0,,Yüzü korkunç!
Dialogue: 0,0:13:43.61,0:13:44.14,Main,Zoro,0,0,0,,O...
Dialogue: 0,0:13:45.94,0:13:49.87,Main,Zoro,0,0,0,,Hey! Usopp! Oradaki sen misin?!
Dialogue: 0,0:13:49.87,0:13:50.91,Main,Usopp,0,0,0,,Z-Zoro!
Dialogue: 0,0:13:50.91,0:13:52.64,Main,Usopp,0,0,0,,Niye çatıdasınız?!
Dialogue: 0,0:13:53.04,0:13:56.71,Main,Chopper,0,0,0,,Franky, Brook, hepsi güvende!
Dialogue: 0,0:13:57.56,0:13:59.84,Main,Sanji,0,0,0,,Hey, çekil oradan!
Dialogue: 0,0:13:59.84,0:14:03.44,Main,Sanji,0,0,0,,Karışarak ne yaptığını sanıyorsun, Luffy?
Dialogue: 0,0:14:07.86,0:14:09.79,Main,Oz,0,0,0,,Luffy...?
Dialogue: 0,0:14:11.01,0:14:15.50,Main,Oz,0,0,0,,O benim düşmanım.
Dialogue: 0,0:14:16.34,0:14:20.30,Main,Oz,0,0,0,,Adım Oz.
Dialogue: 0,0:14:20.30,0:14:22.52,Main,Oz,0,0,0,,Memnun oldum!
Dialogue: 0,0:14:28.78,0:14:31.48,Main,Franky,0,0,0,,Canavarla kavga çıkaracak.
Dialogue: 0,0:14:31.48,0:14:33.40,Main,Zoro,0,0,0,,Aptal aşçı.
Dialogue: 0,0:14:33.40,0:14:35.45,Main,Zoro,0,0,0,,Nami'yi kurtarması gerekiyordu, değil mi?
Dialogue: 0,0:14:35.96,0:14:39.19,Main,Franky,0,0,0,,Şu anda başın kızdan daha fazla dertte değil mi?
Dialogue: 0,0:14:39.19,0:14:40.99,Main,Chopper,0,0,0,,Durum kötü!
Dialogue: 0,0:14:40.99,0:14:42.41,Main,Chopper,0,0,0,,Sanji'nin başı dertte!
Dialogue: 0,0:14:42.41,0:14:43.99,Main,Robin,0,0,0,,Beklenmedik bir durum.
Dialogue: 0,0:14:43.99,0:14:47.76,Main,Robin,0,0,0,,Sadece gölgelerimizi hedeflediklerini düşünmüştüm.
Dialogue: 0,0:14:47.76,0:14:49.73,Main,Robin,0,0,0,,Bunun için biraz fazla sert davranıyor.
Dialogue: 0,0:14:49.73,0:14:53.47,Main,Usopp,0,0,0,,Sanırım artık Luffy'den başkasının gölgesine\Nihtiyaçları olmadığına karar verdiler!
Dialogue: 0,0:14:53.47,0:14:54.62,Main,Chopper,0,0,0,,Korkunç.
Dialogue: 0,0:14:54.62,0:14:55.62,Main,Chopper,0,0,0,,Korkunç!
Dialogue: 0,0:14:55.62,0:14:57.48,Main,Chopper,0,0,0,,Onunla yüzleşemeyiz!
Dialogue: 0,0:15:02.78,0:15:05.65,Main,Oz,0,0,0,,Aranıyor posterinin tıpkısı!
Dialogue: 0,0:15:07.35,0:15:09.92,Main,Oz,0,0,0,,Sen de korsanlardan birisin.
Dialogue: 0,0:15:11.68,0:15:15.76,Main,Oz,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:15:15.76,0:15:17.08,Main,Chopper,0,0,0,,Luffy'nin hareketi!
Dialogue: 0,0:15:17.08,0:15:18.56,Main,Usopp,0,0,0,,Uzayacak mı yoksa?!
Dialogue: 0,0:15:18.96,0:15:21.00,Main,Zoro,0,0,0,,O da mı lastik adam oldu?!
Dialogue: 0,0:15:21.27,0:15:22.86,Main,Oz,0,0,0,,{\fad(150,150)}...Orak!
Dialogue: 0,0:15:24.28,0:15:26.52,Main,Chopper,0,0,0,,Uzamadı ama...
Dialogue: 0,0:15:26.52,0:15:30.44,Main,Usopp,0,0,0,,...o erim ve saf güçle bir farkı kalmıyor!
Dialogue: 0,0:15:30.83,0:15:32.24,Main,Robin,0,0,0,,Oz...
Dialogue: 0,0:15:32.24,0:15:34.08,Main,Robin,0,0,0,,O ismi nerede duydum?
Dialogue: 0,0:15:34.08,0:15:38.13,Main,Robin,0,0,0,,Kunihiki Efsaneleri'ndeki Oz olamaz.
Dialogue: 0,0:15:42.75,0:15:45.24,Main,Sanji,0,0,0,,{\fad(150,150)}Collier Frit!
Dialogue: 0,0:15:42.75,0:15:45.24,Note,Sign,0,0,0,,{\fad(150,150)}Boyun Kızartması!
Dialogue: 0,0:15:52.06,0:15:53.36,Main,Chopper,0,0,0,,Sanji!
Dialogue: 0,0:15:53.36,0:15:55.37,Main,Franky,0,0,0,,O koca şey nasıl bu kadar hızlı olabilir!
Dialogue: 0,0:15:59.75,0:16:00.68,Main,Zoro,0,0,0,,Eyvah!
Dialogue: 0,0:16:00.68,0:16:01.77,Main,Zoro,0,0,0,,Ölecek!
Dialogue: 0,0:16:04.11,0:16:05.38,Main,Zoro,0,0,0,,Hey! Kes şunu!
Dialogue: 0,0:16:05.38,0:16:06.98,Main,Chopper,0,0,0,,SANJI!
Dialogue: 0,0:16:06.98,0:16:09.71,Main,Oz,0,0,0,,Al bakalım, önemsiz korsan!
Dialogue: 0,0:16:10.39,0:16:11.82,Main,Usopp,0,0,0,,{\fad(150,150)}Ateş Kuşu Yıldızı!
Dialogue: 0,0:16:20.50,0:16:22.46,Main,Chopper,0,0,0,,SANJI!
Dialogue: 0,0:16:34.64,0:16:37.07,Main,Usopp and Chopper,0,0,0,,BU TARAFA GELİYOR!
Dialogue: 0,0:16:37.90,0:16:38.97,Main,Zoro,0,0,0,,Durum kötü!
Dialogue: 0,0:16:38.97,0:16:41.31,Main,Zoro,0,0,0,,Franky, onu buraya çek!
Dialogue: 0,0:16:41.68,0:16:43.10,Main,Franky,0,0,0,,Tamam!
Dialogue: 0,0:16:43.10,0:16:44.40,Main,Franky,0,0,0,,Al bakalım, canavar!
Dialogue: 0,0:16:52.12,0:16:54.26,Main,Franky,0,0,0,,D-Dikkat edin!
Dialogue: 0,0:16:55.93,0:16:58.56,Main,Zoro,0,0,0,,Siz alt kata inin!
Dialogue: 0,0:16:58.56,0:16:59.99,Main,Zoro,0,0,0,,{\fad(150,150)}Bir Goril!
Dialogue: 0,0:16:59.99,0:17:01.19,Main,Zoro,0,0,0,,{\fad(150,150)}İki Goril!
Dialogue: 0,0:17:02.62,0:17:03.88,Main,Zoro,0,0,0,,{\fad(150,150)}Üç Kılıç Stili....
Dialogue: 0,0:17:04.86,0:17:06.30,Main,Zoro,0,0,0,,{\fad(150,150)}Çift Goril Doğrayışı!
Dialogue: 0,0:17:11.54,0:17:13.51,Main,Oz,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:17:14.01,0:17:15.81,Main,Oz,0,0,0,,{\fad(150,150)}...Volkan!
Dialogue: 0,0:17:17.08,0:17:19.54,Main,Usopp,0,0,0,,Zoro! Hayatta mısın?!
Dialogue: 0,0:17:19.54,0:17:23.70,Main,Usopp,0,0,0,,Hayır! O yükseklikten düşerse ölür!
Dialogue: 0,0:17:23.70,0:17:25.42,Main,Franky,0,0,0,,Al bakalım, canavar!
Dialogue: 0,0:17:26.63,0:17:28.26,Main,Franky,0,0,0,,{\fad(150,150)}Sol Silahlar!
Dialogue: 0,0:17:30.89,0:17:32.40,Main,Franky,0,0,0,,Ne çeviklik ama!
Dialogue: 0,0:17:32.40,0:17:33.28,Main,Franky,0,0,0,,Yine savuşturdu!
Dialogue: 0,0:17:43.95,0:17:44.96,Main,Usopp,0,0,0,,Franky!
Dialogue: 0,0:17:44.96,0:17:46.34,Main,Usopp,0,0,0,,Brook!
Dialogue: 0,0:17:49.50,0:17:50.88,Main,Chopper,0,0,0,,Zoro bu tarafa düşüyor!
Dialogue: 0,0:17:50.88,0:17:52.18,Main,Robin,0,0,0,,{\fad(150,150)}Cien Fleur!
Dialogue: 0,0:17:50.88,0:17:52.18,Note,Robin,0,0,0,,{\fad(150,150)}100 Çiçek!
Dialogue: 0,0:17:52.18,0:17:52.98,Main,Robin,0,0,0,,{\fad(150,150)}Örümcek Ağı!
Dialogue: 0,0:17:58.89,0:18:00.29,Main,Zoro,0,0,0,,Kahretsin.
