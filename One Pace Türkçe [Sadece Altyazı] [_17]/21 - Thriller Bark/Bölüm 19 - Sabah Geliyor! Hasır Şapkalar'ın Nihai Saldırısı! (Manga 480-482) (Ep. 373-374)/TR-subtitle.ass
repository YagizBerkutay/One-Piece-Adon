Dialogue: 0,0:02:29.86,0:02:34.28,Title,,0,0,0,,{\fad(2000,0)}Sabah Geliyor!\NHasır Şapkalar'ın Nihai Saldırısı!
Dialogue: 0,0:02:34.76,0:02:36.81,Main,Pirate,0,0,0,,Müthişti, Hasır Şapka!
Dialogue: 0,0:02:36.81,0:02:39.02,Main,Pirate,0,0,0,,Oz'u yendin!
Dialogue: 0,0:02:49.05,0:02:50.92,Main,Usopp,0,0,0,,Hey, Luffy! Kendine gel!
Dialogue: 0,0:02:50.92,0:02:51.77,Main,Nami,0,0,0,,Luffy!
Dialogue: 0,0:02:51.77,0:02:54.99,Main,Pirate,0,0,0,,Sanırım onu biraz fazla zorladık. İyi mi?!
Dialogue: 0,0:02:54.99,0:02:58.06,Main,Lola,0,0,0,,Kahramanımız bile yenilmez değil.
Dialogue: 0,0:02:58.68,0:03:02.56,Main,Lola,0,0,0,,Yüz kişinin enerjisini bedenine aldı!
Dialogue: 0,0:03:02.56,0:03:06.45,Main,Pirate,0,0,0,,Neyse, çalınan gölgeleri geri almalıyız!
Dialogue: 0,0:03:06.45,0:03:07.14,Main,Pirate,0,0,0,,Evet!
Dialogue: 0,0:03:07.14,0:03:08.20,Main,Pirate,0,0,0,,Acele edelim!
Dialogue: 0,0:03:08.20,0:03:10.34,Main,Pirate,0,0,0,,Doğu tarafı da pek umut verici değil!
Dialogue: 0,0:03:10.72,0:03:12.61,Main,Pirate,0,0,0,,Neredeyse sabah oldu!
Dialogue: 0,0:03:13.81,0:03:17.11,Main,Usopp,0,0,0,,Peki gölgeleri nasıl geri alacağız?
Dialogue: 0,0:03:18.67,0:03:21.23,Main,Usopp,0,0,0,,Tayfamızdan dördü gölgelerini yitirdi!
Dialogue: 0,0:03:24.82,0:03:27.05,Main,Lola,0,0,0,,Şey, sorun da bu zaten.
Dialogue: 0,0:03:27.88,0:03:31.16,Main,Lola,0,0,0,,Hasır Şapkalı Luffy, bunu başından yapacaktı.
Dialogue: 0,0:03:31.16,0:03:35.12,Main,Pirate,0,0,0,,Artık olmaz. Bu durumda hareket edebileceğinden bile şüpheliyim.
Dialogue: 0,0:03:35.12,0:03:38.43,Main,Lola,0,0,0,,Gölgelerin hepsi, Gölge Lordu Moria\Ntarafından alındı ve zombilere yerleştirildi.
Dialogue: 0,0:03:38.92,0:03:44.80,Main,Lola,0,0,0,,Efendilerine dönmelerini emretmesi için onu zorlamalıyız.
Dialogue: 0,0:03:45.43,0:03:47.02,Main,Pirate,0,0,0,,Az konuşma, çok iş!
Dialogue: 0,0:03:47.02,0:03:47.90,Main,Pirate,0,0,0,,Evet!
Dialogue: 0,0:03:47.90,0:03:51.24,Main,Pirate,0,0,0,,Moria'ya bunu söyletmek için güç kullanmalıyız!
Dialogue: 0,0:03:51.53,0:03:54.65,Main,Pirate,0,0,0,,Gölgeleri geri almazsak, onu yenmenin bir anlamı kalmaz!
Dialogue: 0,0:04:09.36,0:04:11.87,Main,Pirate,0,0,0,,Oz ayağa kalktı!
Dialogue: 0,0:04:11.87,0:04:16.47,Main,Pirate,0,0,0,,Bunca şeyden sonra nasıl hareket edebilir?!
Dialogue: 0,0:04:18.44,0:04:19.94,Main,Pirate,0,0,0,,Durum kötü.
Dialogue: 0,0:04:19.94,0:04:21.50,Main,Pirate,0,0,0,,Her şey umutsuz!
Dialogue: 0,0:04:21.50,0:04:24.71,Main,Pirate,0,0,0,,Hasır Şapkalar'ın sayısı azaldı.
Dialogue: 0,0:04:25.08,0:04:28.56,Main,Pirate,0,0,0,,Kozumuz olan gölgeleri çoktan kullandık!
Dialogue: 0,0:04:28.56,0:04:32.38,Main,Pirate,0,0,0,,Bu herifi yenmek için tek bir şeyimiz bile kalmadı!
Dialogue: 0,0:04:34.60,0:04:36.64,Main,Oz,0,0,0,,Biraz bile acıtmadı!
Dialogue: 0,0:04:37.78,0:04:39.12,Main,Lola,0,0,0,,Kahretsin!
Dialogue: 0,0:04:39.70,0:04:43.12,Main,Pirate,0,0,0,,Gerçekten bir zombiyi yenmek mümkün değil!
Dialogue: 0,0:04:43.12,0:04:44.81,Main,Pirate,0,0,0,,Seçeneklerimiz tükeniyor.
Dialogue: 0,0:04:44.81,0:04:46.41,Main,Pirate,0,0,0,,Yenildik!
Dialogue: 0,0:04:46.41,0:04:50.08,Main,Pirate,0,0,0,,Karanlıkta yaşamaktan kaçamayız!
Dialogue: 0,0:04:50.08,0:04:51.58,Main,Pirate,0,0,0,,Geri çekilmeliyiz.
Dialogue: 0,0:04:51.58,0:04:53.80,Main,Pirate,0,0,0,,Burada kalırsak, öleceğiz!
Dialogue: 0,0:04:53.80,0:04:55.67,Main,Pirate,0,0,0,,Hemen ormana dönelim!
Dialogue: 0,0:04:56.51,0:05:00.65,Main,Pirate,0,0,0,,Güneş ışığının olmadığı karanlık ormana. Yine geri dönmek zorundayız.
Dialogue: 0,0:05:03.64,0:05:04.57,Main,Pirate,0,0,0,,Sen!
Dialogue: 0,0:05:05.82,0:05:10.02,Main,Zoro,0,0,0,,Luffy'yi bilmem ama Oz'un büyük darbe aldığı kesin.
Dialogue: 0,0:05:10.02,0:05:11.62,Main,Pirate,0,0,0,,He, dur bakalım!
Dialogue: 0,0:05:11.62,0:05:13.43,Main,Pirate,0,0,0,,Bedenini zorlarsan, öleceksin!
Dialogue: 0,0:05:13.43,0:05:17.14,Main,Lola,0,0,0,,Tüm o devasa darbeleri aldıktan\Nsonra hala ayakta durabiliyor mu?
Dialogue: 0,0:05:17.14,0:05:19.73,Main,Lola,0,0,0,,Bu da mı zombi?!
Dialogue: 0,0:05:25.10,0:05:29.62,Main,Pirate,0,0,0,,Hey! Hasır Şapka tayfasının bedenleri nereye gitti?!
Dialogue: 0,0:05:30.82,0:05:32.02,Main,Pirate,0,0,0,,B-Bilmem!
Dialogue: 0,0:05:32.02,0:05:34.71,Main,Pirate,0,0,0,,Baygın insanlar nasıl kendi başına hareket edebilir?!
Dialogue: 0,0:05:34.71,0:05:36.94,Main,Pirate,0,0,0,,Ha? Peki buradaki ikisi?
Dialogue: 0,0:05:36.94,0:05:38.03,Main,Pirate,0,0,0,,Haklısın!
Dialogue: 0,0:05:38.03,0:05:40.32,Main,Pirate,0,0,0,,Uzun burunlu adam ve kadın yok olmuş!
Dialogue: 0,0:05:40.68,0:05:43.23,Main,Pirate,0,0,0,,Kaçmış olamazlar, değil mi?!
Dialogue: 0,0:05:43.23,0:05:46.06,Main,Pirate,0,0,0,,Hepsi birden ne zaman...
Dialogue: 0,0:05:52.46,0:05:55.16,Main,Luffy,0,0,0,,Bir vuruş daha yapmak isterdim.
Dialogue: 0,0:05:55.16,0:05:56.47,Main,Pirate,0,0,0,,Hasır Şapka!
Dialogue: 0,0:05:56.85,0:05:59.58,Main,Pirate,0,0,0,,Hey, hey! Sen de mi, Hasır Şapka?!
Dialogue: 0,0:05:59.58,0:06:02.50,Main,Luffy,0,0,0,,Ama kıpırdayamıyorum, lanet olsun.
Dialogue: 0,0:06:02.50,0:06:04.81,Main,Luffy,0,0,0,,Bedenim bundan fazlasıyla yoruldu.
Dialogue: 0,0:06:05.52,0:06:06.31,Main,Luffy,0,0,0,,Robin!
Dialogue: 0,0:06:06.31,0:06:08.25,Main,Robin,0,0,0,,Evet, burada.
Dialogue: 0,0:06:09.15,0:06:10.75,Main,Pirate,0,0,0,,Kaçmamışlar!
Dialogue: 0,0:06:11.20,0:06:13.20,Main,Luffy,0,0,0,,Oraya çıkmak istiyorum!
Dialogue: 0,0:06:13.20,0:06:14.21,Main,Robin,0,0,0,,Anlaşıldı.
Dialogue: 0,0:06:15.42,0:06:17.84,Main,Robin,0,0,0,,Biraz basamak sağlayacağım.
Dialogue: 0,0:06:18.28,0:06:21.57,Main,Brook,0,0,0,,Benim de hala yardım etme arzum var.
Dialogue: 0,0:06:22.55,0:06:24.86,Main,Pirate,0,0,0,,Canlı bir iskelet var!
Dialogue: 0,0:06:25.89,0:06:26.95,Main,Pirate,0,0,0,,Bu da ne?!
Dialogue: 0,0:06:26.95,0:06:29.07,Main,Luffy,0,0,0,,Tamam, Brook! Bir iyilik isteyeceğim!
Dialogue: 0,0:06:29.07,0:06:31.40,Main,Nami,0,0,0,,Biliyordum!
Dialogue: 0,0:06:32.98,0:06:36.37,Main,Nami,0,0,0,,Herkes çoktan oyuna dönmüş!
Dialogue: 0,0:06:36.37,0:06:39.54,Main,Pirate,0,0,0,,Niye deminki kız orada?!
Dialogue: 0,0:06:41.71,0:06:44.06,Main,Pirate,0,0,0,,Yoksa bunlar,...
Dialogue: 0,0:06:44.06,0:06:46.40,Main,Pirate,0,0,0,,...bir kez olsun kaçmayı düşünmemişler mi?
Dialogue: 0,0:06:46.40,0:06:49.67,Main,Pirate,0,0,0,,Oz ayağa kalktığı anda,...
Dialogue: 0,0:06:49.67,0:06:52.96,Main,Pirate,0,0,0,,...tekrardan dövüşe hazırlanıyorlar!
Dialogue: 0,0:06:54.19,0:06:55.43,Main,Luffy,0,0,0,,Bekleyin bakalım.
Dialogue: 0,0:06:58.29,0:06:59.64,Main,Sanji,0,0,0,,Chopper, çabuk ol!
Dialogue: 0,0:06:59.64,0:07:00.68,Main,Sanji,0,0,0,,Güneş doğuyor!
Dialogue: 0,0:07:00.68,0:07:01.42,Main,Chopper,0,0,0,,Tamam!
Dialogue: 0,0:07:02.70,0:07:04.19,Main,Usopp,0,0,0,,Bunu hala kullanabilir miyiz, Franky?!
Dialogue: 0,0:07:04.19,0:07:05.77,Main,Franky,0,0,0,,Olur! Yardım et!
Dialogue: 0,0:07:07.04,0:07:08.74,Main,Pirates,0,0,0,,B-B-Buna inanamıyorum!
Dialogue: 0,0:07:08.74,0:07:11.77,Main,Pirates,0,0,0,,Bir kez olsun pes etmeyi düşünmemişler!
Dialogue: 0,0:07:11.77,0:07:13.83,Main,Zoro,0,0,0,,Hey! Bize engel oluyorsunuz!
Dialogue: 0,0:07:13.83,0:07:14.56,Main,Zoro,0,0,0,,Çekilin!
Dialogue: 0,0:07:14.56,0:07:17.60,Main,Pirates,0,0,0,,O zaman size bırakıyoruz!
Dialogue: 0,0:07:18.28,0:07:19.80,Main,Robin,0,0,0,,{\fad(150,150)}Pierna Fleur...
Dialogue: 0,0:07:18.28,0:07:19.80,Note,Robin,0,0,0,,{\fad(150,150)}Bacak Çiçeği!
Dialogue: 0,0:07:25.30,0:07:26.90,Main,Brook,0,0,0,,İşte gidiyoruz-hohoho!
Dialogue: 0,0:07:26.90,0:07:27.73,Main,Luffy,0,0,0,,Lütfen!
Dialogue: 0,0:07:34.60,0:07:35.88,Main,Oz,0,0,0,,Durun!
Dialogue: 0,0:07:35.88,0:07:36.97,Main,Oz,0,0,0,,Nereye gidiyorsunuz?!
Dialogue: 0,0:07:40.08,0:07:41.55,Main,Oz,0,0,0,,Bu da ne?
Dialogue: 0,0:07:41.55,0:07:43.91,Main,Oz,0,0,0,,Duman? Bulut?
Dialogue: 0,0:07:43.91,0:07:46.38,Main,Nami,0,0,0,,Hava durumu, yağmurlu!
Dialogue: 0,0:07:46.38,0:07:47.61,Main,Nami,0,0,0,,{\fad(150,150)}Soğuk Topu!
Dialogue: 0,0:07:51.88,0:07:53.10,Main,Nami,0,0,0,,{\fad(150,150)}Yağmur Tempo!
Dialogue: 0,0:07:57.96,0:07:59.44,Main,Pirate,0,0,0,,Yağmur yağıyor! Nasıl?!
Dialogue: 0,0:07:59.44,0:08:01.74,Main,Pirate,0,0,0,,O kız büyücü falan mı?!
Dialogue: 0,0:08:02.43,0:08:03.54,Main,Franky,0,0,0,,Tamam!
Dialogue: 0,0:08:03.54,0:08:06.08,Main,Franky,0,0,0,,"Acil Durum Hortumu" yapımı tamamlandı!
Dialogue: 0,0:08:06.37,0:08:08.17,Main,Oz,0,0,0,,Kahretsin.
Dialogue: 0,0:08:08.17,0:08:09.90,Main,Franky,0,0,0,,{\fad(150,150)}Rüzgar Vuruşu!
Dialogue: 0,0:08:12.17,0:08:13.24,Main,Oz,0,0,0,,Ne?!
Dialogue: 0,0:08:13.24,0:08:15.57,Main,Franky,0,0,0,,Elinden geleni yap!
Dialogue: 0,0:08:15.57,0:08:17.94,Main,Usopp,0,0,0,,Yapıyorum!
Dialogue: 0,0:08:24.74,0:08:25.83,Main,Franky,0,0,0,,Başlayalım!
Dialogue: 0,0:08:25.83,0:08:29.09,Main,Franky,0,0,0,,{\fad(150,150)}Aşırı Büyük, Ultra, \NSıfırın Altında Dondurucu Rüzgar Topu!
Dialogue: 0,0:08:31.26,0:08:33.16,Main,Franky,0,0,0,,{\fad(150,150)}Ateş!
Dialogue: 0,0:08:42.52,0:08:43.82,Main,Oz,0,0,0,,Dondum!
Dialogue: 0,0:08:44.91,0:08:46.32,Main,Oz,0,0,0,,Kıpırdayamıyorum!
Dialogue: 0,0:08:47.82,0:08:49.36,Main,Pirate,0,0,0,,Müthiş!
Dialogue: 0,0:08:49.36,0:08:51.22,Main,Pirate,0,0,0,,Onu yağmur suyuyla dondurdular!
Dialogue: 0,0:08:53.98,0:08:55.65,Main,Sanji,0,0,0,,Şimdi sıra bende!
Dialogue: 0,0:08:55.65,0:08:56.95,Main,Sanji,0,0,0,,Hadi!
Dialogue: 0,0:09:02.27,0:09:03.70,Main,Oz,0,0,0,,Zincir?!
Dialogue: 0,0:09:03.70,0:09:05.01,Main,Chopper,0,0,0,,Başardın!
Dialogue: 0,0:09:06.46,0:09:09.66,Main,Oz,0,0,0,,Gemi zinciri?!
Dialogue: 0,0:09:09.66,0:09:11.43,Main,Chopper,0,0,0,,Müthişti, Sanji!
Dialogue: 0,0:09:12.06,0:09:12.78,Main,Sanji,0,0,0,,Sağol!
Dialogue: 0,0:09:12.78,0:09:14.60,Main,Luffy,0,0,0,,At beni!
Dialogue: 0,0:09:14.60,0:09:16.25,Main,Brook,0,0,0,,Bundan gerçekten emin misin?
Dialogue: 0,0:09:16.25,0:09:19.42,Main,Luffy,0,0,0,,Sorun yok! Ben lastik insanım!
Dialogue: 0,0:09:20.17,0:09:21.39,Main,Brook,0,0,0,,Dikkatli ol o zaman!
Dialogue: 0,0:09:22.90,0:09:23.98,Main,Luffy,0,0,0,,{\fad(150,150)}Üçüncü Düzen!
Dialogue: 0,0:09:25.84,0:09:27.22,Main,Luffy,0,0,0,,{\fad(150,150)}Kemik Balon!
Dialogue: 0,0:09:33.75,0:09:34.62,Main,Chopper,0,0,0,,Zoro!
Dialogue: 0,0:09:34.62,0:09:36.22,Main,Chopper,0,0,0,,Oz'un midesini ger!
Dialogue: 0,0:09:37.55,0:09:38.52,Main,Zoro,0,0,0,,Bana bırak!
Dialogue: 0,0:09:39.11,0:09:40.22,Main,Zoro,0,0,0,,{\fad(150,150)}Üç Kılıç Stili...
Dialogue: 0,0:09:42.86,0:09:44.00,Main,Zoro,0,0,0,,{\fad(150,150)}...Gizli Teknik!
Dialogue: 0,0:09:47.31,0:09:49.12,Main,Zoro,0,0,0,,{\fad(150,150)}Üç Bin Dünya!
Dialogue: 0,0:09:53.91,0:09:57.04,Main,Sanji,0,0,0,,Şimdi yapacağım.
Dialogue: 0,0:10:01.40,0:10:02.66,Main,Chopper,0,0,0,,İyi iş, Sanji!
Dialogue: 0,0:10:02.66,0:10:04.77,Main,Chopper,0,0,0,,Oz'un sırtı şu anda gerildi!
Dialogue: 0,0:10:04.77,0:10:06.62,Main,Pirate,0,0,0,,Ne yapıyorlar?!
Dialogue: 0,0:10:08.35,0:10:15.31,Main,Chopper,0,0,0,,İnsan omurgası, vücuda gelen büyük şokları\Nemmek üzere "S" şeklinde dizayn edilmiştir.
Dialogue: 0,0:10:15.31,0:10:22.60,Main,Chopper,0,0,0,,Ama omurga düzleştiğinde, hiçbir şeyi ememeyecek ve bunun yerine darbenin tüm yüküne katlanacak!
Dialogue: 0,0:10:24.12,0:10:25.39,Main,Nami,0,0,0,,Hadi, Luffy!
Dialogue: 0,0:10:27.45,0:10:28.44,Main,Brook,0,0,0,,İyi şanslar!
Dialogue: 0,0:10:28.44,0:10:30.91,Main,Luffy,0,0,0,,Bu "Özel Bazuka" yı al!
Dialogue: 0,0:10:31.42,0:10:36.12,Main,Oz,0,0,0,,Zahmet etme! Kendi bazukamla seni geri göndereceğim!
Dialogue: 0,0:10:36.12,0:10:37.87,Main,Oz,0,0,0,,{\fad(150,0)}Gomu Gomu no...
Dialogue: 0,0:10:37.87,0:10:39.45,Main,Oz,0,0,0,,Ha? Kıpırdamıyor!
Dialogue: 0,0:10:39.94,0:10:42.07,Main,Oz,0,0,0,,Sağ kolumu kıpırdatamıyorum!
Dialogue: 0,0:10:42.07,0:10:43.55,Main,Oz,0,0,0,,Uzayamıyorum da!
Dialogue: 0,0:10:43.97,0:10:47.24,Main,Robin,0,0,0,,Zararı hissedememek, zombinin zayıflığıdır.
Dialogue: 0,0:10:47.24,0:10:48.62,Main,Zoro,0,0,0,,Bu senin gölgen.
Dialogue: 0,0:10:48.62,0:10:49.93,Main,Zoro,0,0,0,,Bitir işini, Luffy!
Dialogue: 0,0:10:49.93,0:10:52.13,Main,Luffy,0,0,0,,{\fad(150,150)}Gomu Gomu no....
Dialogue: 0,0:10:53.22,0:10:55.16,Main,Pirate,0,0,0,,Hadi!
Dialogue: 0,0:10:55.16,0:10:57.77,Main,Lola,0,0,0,,Hakla onu, Hasır Şapka!
Dialogue: 0,0:10:57.77,0:10:59.33,Main,Both,0,0,0,,Bu nasıl?!
Dialogue: 0,0:10:59.87,0:11:01.01,Main,Luffy,0,0,0,,{\fad(150,150)}...Dev...
Dialogue: 0,0:11:02.57,0:11:05.14,Main,Luffy,0,0,0,,{\fad(150,150)}...Bazuka!
Dialogue: 0,0:11:20.30,0:11:24.58,Main,All,0,0,0,,BAŞARDI!
Dialogue: 0,0:11:31.85,0:11:35.84,Main,Zombie,0,0,0,,Ne derseniz deyin ama bunun ardından\Nbir zombi bile ayağa kalkamaz!
Dialogue: 0,0:11:35.84,0:11:38.00,Main,Zombie,0,0,0,,Oz gerçekten yenildi!
Dialogue: 0,0:11:38.00,0:11:39.80,Main,Zombie,0,0,0,,Tamamiyle.
Dialogue: 0,0:11:39.80,0:11:42.58,Main,Zombie,0,0,0,,Thriller Bark'a ne olacak?
Dialogue: 0,0:11:51.17,0:11:53.77,Main,Lola,0,0,0,,Başardılar.
Dialogue: 0,0:11:54.48,0:11:56.73,Main,Lola,0,0,0,,Gerçekten müthişler.
Dialogue: 0,0:11:58.80,0:12:02.30,Main,Hildon,0,0,0,,Gerçekten müthiş insanlara tosladık.
Dialogue: 0,0:12:04.61,0:12:07.61,Main,Zombie,0,0,0,,Efendi'ye ne oldu?!
Dialogue: 0,0:12:07.61,0:12:09.88,Main,Lola,0,0,0,,Kazandılar!
Dialogue: 0,0:12:09.88,0:12:13.16,Main,Lola,0,0,0,,Bu kez gerçekten başardılar!
Dialogue: 0,0:12:13.16,0:12:14.45,Main,Pirate,0,0,0,,Kazandık!
Dialogue: 0,0:12:14.75,0:12:15.90,Main,Pirate,0,0,0,,Sağolun!
Dialogue: 0,0:12:15.90,0:12:17.71,Main,Pirate,0,0,0,,Siz en iyisisiniz!
Dialogue: 0,0:12:17.71,0:12:19.99,Main,Pirate,0,0,0,,Gerçekten parlayan umut yıldızımızdınız!
Dialogue: 0,0:12:19.99,0:12:22.92,Main,Lola,0,0,0,,Bu adam gerçekten kurtarıcımız!
Dialogue: 0,0:12:22.92,0:12:24.27,Main,Lola,0,0,0,,Hasır Şapka...
Dialogue: 0,0:12:28.11,0:12:29.25,Main,Lola,0,0,0,,Ufacık!
Dialogue: 0,0:12:29.25,0:12:30.96,Main,Lola,0,0,0,,Sen kimsin?!
Dialogue: 0,0:12:30.96,0:12:33.46,Main,Lola,0,0,0,,Niye küçüldü?!
Dialogue: 0,0:12:35.47,0:12:38.57,Main,Oz,0,0,0,,Acımıyor. Ama hareket edemiyorum!
Dialogue: 0,0:12:40.12,0:12:44.04,Main,Chopper,0,0,0,,Kemikleri parçalanmış olmasına rağmen hala kendinde.
Dialogue: 0,0:12:44.41,0:12:47.43,Main,Chopper,0,0,0,,Bu yeteneğin hayata ne kadar hakaret ettiğine inanmak zor!
Dialogue: 0,0:12:50.29,0:12:51.88,Main,Chopper,0,0,0,,Sabah güneşi!
Dialogue: 0,0:13:04.35,0:13:09.17,Main,Brook,0,0,0,,Bedenime ürpertiler gönderen bu his de ne?
Dialogue: 0,0:13:11.30,0:13:12.64,Main,Usopp,0,0,0,,Hey, Luffy!
Dialogue: 0,0:13:12.64,0:13:15.07,Main,Usopp,0,0,0,,Hemen gölgeleri geri al!
Dialogue: 0,0:13:15.43,0:13:17.24,Main,Usopp,0,0,0,,Tezahürat yapacak zaman değil!
Dialogue: 0,0:13:17.24,0:13:19.50,Main,Usopp,0,0,0,,Hepiniz yok olacaksınız!
Dialogue: 0,0:13:19.50,0:13:20.53,Main,Pirate,0,0,0,,Gölgelerimiz!
Dialogue: 0,0:13:20.53,0:13:21.95,Main,Pirate,0,0,0,,Evet, acele etmeliyiz!
Dialogue: 0,0:13:22.40,0:13:26.35,Main,Lola,0,0,0,,Evet, gidip Moria'yı uyandıralım\Nve gölgelerimizi geri alalım!
Dialogue: 0,0:13:26.60,0:13:29.05,Main,Lola,0,0,0,,Neredeyse sabah oldu!
Dialogue: 0,0:13:30.66,0:13:33.86,Main,Moria,0,0,0,,Beni uyandırmanıza gerek yok.
Dialogue: 0,0:13:36.31,0:13:38.21,Main,Zombie,0,0,0,,Moria!
Dialogue: 0,0:13:39.64,0:13:41.52,Main,Zombie,0,0,0,,Efendi!
Dialogue: 0,0:13:41.52,0:13:43.85,Main,Zombie,0,0,0,,Hele şükür güvende!
Dialogue: 0,0:13:43.85,0:13:47.21,Main,Zombie,0,0,0,,Moria-sama'nın yenilmesi mümkün değil!
Dialogue: 0,0:13:51.24,0:13:54.53,Main,Lola,0,0,0,,U-Uyandıysan, sorun yok demektir.
Dialogue: 0,0:13:54.53,0:14:01.66,Main,Lola,0,0,0,,H-Hasır Şapkalar'dan bir dayak daha yemek istemiyorsan, hemen gölgelerimizi geri ver!
Dialogue: 0,0:14:01.66,0:14:03.82,Main,Pirate,0,0,0,,Evet! Geri ver onları, pislik!
Dialogue: 0,0:14:08.07,0:14:10.49,Main,Moria,0,0,0,,Bu, çocuk parkı itişmesi değil!
Dialogue: 0,0:14:10.49,0:14:13.90,Main,Moria,0,0,0,,Gerçek korsan ölümden korkmaz!
Dialogue: 0,0:14:16.15,0:14:19.78,Main,Moria,0,0,0,,Siz orman ezikleriyle işbirliği yapmışlar.
Dialogue: 0,0:14:19.78,0:14:22.94,Main,Moria,0,0,0,,Hasır Şapka'nın o tuhaf gücü nasıl elde ettiğini şimdi anlıyorum!
Dialogue: 0,0:14:23.56,0:14:28.18,Main,Moria,0,0,0,,Kendi Gölge Yetenekleri'mi bana karşı\Nkullanmanız, umutsuzluğunuzu gösteriyor!
Dialogue: 0,0:14:28.85,0:14:29.98,Main,Lola,0,0,0,,Kapa çeneni!
Dialogue: 0,0:14:29.98,0:14:31.45,Main,Lola,0,0,0,,Gölgelerimizi geri ver!
Dialogue: 0,0:14:31.95,0:14:37.69,Main,Moria,0,0,0,,Hasır Şapka, her yeri mahvetme cüreti gösterdin.
Dialogue: 0,0:14:37.69,0:14:41.18,Main,Luffy,0,0,0,,Çünkü önce siz yolculuğumuza engel oldunuz!
Dialogue: 0,0:14:41.18,0:14:43.59,Main,Luffy,0,0,0,,Şimdi güneş doğmadan gölgeleri geri ver!
Dialogue: 0,0:14:43.59,0:14:47.94,Main,Moria,0,0,0,,Size dokunmasaydım bile, şu anki halinizle\Nsizi bekleyen tek şey ölüm olurdu!
Dialogue: 0,0:14:47.94,0:14:50.70,Main,Moria,0,0,0,,Yeni Dünya için hazır bile değilsiniz!
Dialogue: 0,0:14:51.18,0:14:54.77,Main,Moria,0,0,0,,Kendine iyi adamlar toplamışsın gibi görünse de,...
Dialogue: 0,0:14:55.16,0:14:57.39,Main,Moria,0,0,0,,...hepsi kaybedilecek.
Dialogue: 0,0:14:57.39,0:14:59.80,Main,Moria,0,0,0,,Niye biliyor musun?!
Dialogue: 0,0:14:59.80,0:15:03.11,Main,Pirate,0,0,0,,Hey, Hasır Şapka! \NKonuşarak kaybedecek vaktimiz yok!
Dialogue: 0,0:15:03.11,0:15:04.53,Main,Pirate,0,0,0,,Gökyüzüne bak!
Dialogue: 0,0:15:04.53,0:15:06.04,Main,Pirate,0,0,0,,Şimdiden parlamaya başlamış!
Dialogue: 0,0:15:06.04,0:15:08.10,Main,Pirate,0,0,0,,Hemen gölgelerimizi geri al!
Dialogue: 0,0:15:08.77,0:15:11.39,Main,Pirate,0,0,0,,Hiç vakit yok!
Dialogue: 0,0:15:11.39,0:15:14.88,Main,Moria,0,0,0,,Deneyimden bahsediyorum!
Dialogue: 0,0:15:14.88,0:15:19.73,Main,Moria,0,0,0,,Tüm dünyada meşhur olmalarına\Nrağmen niye adamlarımı yitirdim?!
Dialogue: 0,0:15:19.73,0:15:23.63,Main,Moria,0,0,0,,Canlı oldukları için arkadaşlarımı yitirdim!
Dialogue: 0,0:15:23.63,0:15:27.68,Main,Moria,0,0,0,,Başından beri ölü zombiler olsalardı,\Nkaybedecek bir şeyim olmazdı!
Dialogue: 0,0:15:27.68,0:15:29.34,Main,Moria,0,0,0,,Zombiler ölümsüzdür!
Dialogue: 0,0:15:29.34,0:15:32.98,Main,Moria,0,0,0,,Düşseler de yerlerine yenisi\Nkonulabilecek ölümsüz savaşçılar!
Dialogue: 0,0:15:32.98,0:15:37.84,Main,Moria,0,0,0,,Ölüler ordumla, bir kez daha\NKorsanlar Kralı olmayı hedefliyorum!
Dialogue: 0,0:15:37.84,0:15:43.72,Main,Moria,0,0,0,,Kölelerim olarak hizmet edeceğiniz\Niçin minnettar olmalısınız!
Dialogue: 0,0:15:55.87,0:15:56.58,Main,Zombie,0,0,0,,Kendini bağlıyor!
Dialogue: 0,0:16:05.55,0:16:10.41,Thoughts,Moria,0,0,0,,{\i1}Şimdi, Thriller Bark'ın tüm gölgeleri!{\i0}
Dialogue: 0,0:16:10.41,0:16:12.87,Thoughts,Moria,0,0,0,,{\i1}Gücüm olun!{\i0}
Dialogue: 0,0:16:12.87,0:16:16.65,Note,Moria,0,0,0,,{\fad(150,150)}Asgard: Norse Mitolojisi'nde Tanrılar ülkesi
Dialogue: 0,0:16:12.87,0:16:16.65,Thoughts,Moria,0,0,0,,{\fad(150,150)}Gölge *Asgard'ı!
Dialogue: 0,0:16:18.51,0:16:19.97,Main,Zombie,0,0,0,,Kardeş!
Dialogue: 0,0:16:22.68,0:16:24.40,Main,Zombie,0,0,0,,Gölgesi çıktı!
Dialogue: 0,0:16:30.48,0:16:31.61,Main,Nami,0,0,0,,Gölgeler?!
Dialogue: 0,0:16:31.61,0:16:32.74,Main,Nami,0,0,0,,Yoksa...
Dialogue: 0,0:16:33.32,0:16:37.21,Main,Nami,0,0,0,,...adadaki tüm gölgeleri toplayıp\Nkendi bedenine mi yerleştiriyor?!
Dialogue: 0,0:16:38.28,0:16:40.78,Main,Moria,0,0,0,,Hasır Şapka!
Dialogue: 0,0:16:40.78,0:16:45.48,Main,Moria,0,0,0,,100 kadar gölge emmiştin, değil mi?!
Dialogue: 0,0:16:45.48,0:16:46.62,Main,Moria,0,0,0,,O zaman ben de...
Dialogue: 0,0:16:46.62,0:16:47.95,Main,Moria,0,0,0,,200!
Dialogue: 0,0:16:50.97,0:16:53.29,Main,Moria,0,0,0,,300!
Dialogue: 0,0:16:53.29,0:16:55.18,Main,Moria,0,0,0,,600!
Dialogue: 0,0:16:59.98,0:17:02.37,Main,Moria,0,0,0,,700!
Dialogue: 0,0:17:06.65,0:17:09.51,Main,Moria,0,0,0,,1000 gölge!
Dialogue: 0,0:17:14.98,0:17:16.63,Main,Pirate,0,0,0,,Bitti.
Dialogue: 0,0:17:16.63,0:17:18.68,Main,Pirate,0,0,0,,O da ne öyle?
Dialogue: 0,0:17:18.68,0:17:19.95,Main,Luffy,0,0,0,,Normale döndüm.
Dialogue: 0,0:17:19.95,0:17:23.40,Main,Pirate,0,0,0,,Neredeyse sabah oldu!
Dialogue: 0,0:17:23.40,0:17:29.02,Main,Pirate,0,0,0,,Vücuduna gölge yerleştirilen Hasır Şapka'nın\Nve Oz'un birleşiminden daha güçlü!
Dialogue: 0,0:17:29.02,0:17:33.51,Main,Pirate,0,0,0,,Yani yanımızda Yetenek Kullanıcıları\Nolmasına rağmen onu yenemiyor muyuz?!
Dialogue: 0,0:17:33.51,0:17:35.77,Main,Pirate,0,0,0,,Her şey bitti!
Dialogue: 0,0:17:38.52,0:17:40.40,Main,Pirate,0,0,0,,O da ne öyle?!
Dialogue: 0,0:17:40.40,0:17:43.19,Main,Pirate,0,0,0,,Moria falan değil!
Dialogue: 0,0:17:45.05,0:17:47.48,Main,Franky,0,0,0,,Hasır Şapka'nın gölgesi de orada.
Dialogue: 0,0:17:52.65,0:17:53.89,Main,Pirate,0,0,0,,Evet.
Dialogue: 0,0:17:53.89,0:17:55.95,Main,Pirate,0,0,0,,Muhtemelen bizim gölgelerimiz de.
Dialogue: 0,0:17:57.55,0:17:59.32,Main,Usopp,0,0,0,,Hey, hey, hey, hey!
Dialogue: 0,0:18:08.59,0:18:10.32,Main,Pirate,0,0,0,,Adayı parçaladı!
Dialogue: 0,0:18:10.32,0:18:13.51,Main,Pirate,0,0,0,,Artık burada kalamayız!
Dialogue: 0,0:18:18.15,0:18:19.16,Main,Pirate,0,0,0,,Kaçın!
Dialogue: 0,0:18:19.16,0:18:21.47,Main,Pirate,0,0,0,,Moria'dan uzaklaşın!
Dialogue: 0,0:18:21.47,0:18:23.74,Main,Pirate,0,0,0,,Bu kez gerçekten bitti!
Dialogue: 0,0:18:29.42,0:18:30.01,Main,Pirate,0,0,0,,Bedenim!
Dialogue: 0,0:18:30.01,0:18:31.06,Main,Pirate,0,0,0,,Bedenim yok olacak!
Dialogue: 0,0:18:31.06,0:18:32.93,Main,Pirate,0,0,0,,Ah, kurtarın beni!
Dialogue: 0,0:18:32.93,0:18:35.23,Main,Pirate,0,0,0,,Aptal! Hemen gölgeye git!
Dialogue: 0,0:18:35.23,0:18:36.39,Main,Pirate,0,0,0,,Sabah geliyor!
Dialogue: 0,0:18:36.39,0:18:39.70,Main,Pirate,0,0,0,,Gölgesi alınanlar artık dövüşemez!
Dialogue: 0,0:18:40.97,0:18:42.24,Main,Pirate,0,0,0,,Kaptan Lola!
Dialogue: 0,0:18:42.24,0:18:43.34,Main,Pirate,0,0,0,,Ne yapıyorsunuz?!
Dialogue: 0,0:18:43.34,0:18:44.89,Main,Pirate,0,0,0,,Acele edin!
Dialogue: 0,0:18:44.89,0:18:47.30,Main,Lola,0,0,0,,İsterseniz kaçabilirsiniz.
Dialogue: 0,0:18:48.16,0:18:50.09,Main,Pirate,0,0,0,,Ne diyorsun?!
Dialogue: 0,0:18:50.09,0:18:52.04,Main,Pirate,0,0,0,,Sen de aynı durumdasın, kaptan!
Dialogue: 0,0:18:52.63,0:18:55.23,Main,Lola,0,0,0,,Sorumluluğu almalıyım.
Dialogue: 0,0:18:55.23,0:18:58.18,Main,Lola,0,0,0,,Kararlılığım için.
Dialogue: 0,0:18:58.82,0:19:01.92,Main,Lola,0,0,0,,Onlara bakın.
Dialogue: 0,0:19:03.61,0:19:05.01,Main,Pirate,0,0,0,,Onlar...
Dialogue: 0,0:19:05.89,0:19:08.10,Main,Lola,0,0,0,,...hiç korkmuyorlar.
Dialogue: 0,0:19:10.08,0:19:13.46,Main,Lola,0,0,0,,Bazılarının gölgesi alınmış olmasına rağmen.
Dialogue: 0,0:19:13.46,0:19:16.38,Main,Pirate,0,0,0,,Yani hala ona karşı mı duruyorlar?!
Dialogue: 0,0:19:16.38,0:19:19.15,Main,Pirate,0,0,0,,Ama güneş onlara denk gelirse her şey biter.
Dialogue: 0,0:19:19.15,0:19:21.87,Main,Pirate,0,0,0,,Şu anda Moria'nın gücü, Oz'unkinden çok fazla!
Dialogue: 0,0:19:24.78,0:19:27.56,Main,Lola,0,0,0,,Dövüşü bıraktıkları ana dek,...
Dialogue: 0,0:19:27.56,0:19:29.55,Main,Lola,0,0,0,,...buradan kıpırdamayacağım.
Dialogue: 0,0:19:29.55,0:19:34.86,Main,Lola,0,0,0,,Umudumu onlara bağladığım anda böyle\Nbir şey olacağının gayet farkındaydım.
Dialogue: 0,0:19:34.86,0:19:37.83,Main,Lola,0,0,0,,Kararımdan pişman değilim!
Dialogue: 0,0:19:37.83,0:19:39.52,Main,Pirate,0,0,0,,Ama işler böyleyken...
Dialogue: 0,0:19:40.17,0:19:42.17,Main,Lola,0,0,0,,Siz gidin!
Dialogue: 0,0:19:42.17,0:19:45.50,Main,Lola,0,0,0,,Kaptanınız olarak bu işin sonunu görmek, benim görevim!
Dialogue: 0,0:19:46.23,0:19:50.09,Main,Lola,0,0,0,,Hayatlarınıza değer vermelisiniz.
Dialogue: 0,0:19:51.83,0:19:53.42,Main,Pirate,0,0,0,,Kaptan Lola!
Dialogue: 0,0:19:53.42,0:19:55.13,Main,Pirate,0,0,0,,Eyvah! Işık ona vurdu!
Dialogue: 0,0:19:55.13,0:19:56.24,Main,Pirate,0,0,0,,Hemen gölgeye gel!
Dialogue: 0,0:19:56.98,0:19:58.40,Main,Lola,0,0,0,,Sorun yok!
Dialogue: 0,0:19:59.63,0:20:04.38,Main,Lola,0,0,0,,İnançlı olmak dedikleri bu!
Dialogue: 0,0:20:04.38,0:20:05.80,Main,Pirate,0,0,0,,Kaptan Lola!
Dialogue: 0,0:20:05.80,0:20:06.87,Main,Pirate,0,0,0,,Olamaz!
Dialogue: 0,0:20:06.87,0:20:08.29,Main,Pirate,0,0,0,,Ölmeye mi çalışıyorsun?!
Dialogue: 0,0:20:08.96,0:20:11.66,Main,Lola,0,0,0,,Kaderime çoktan karar verdim!
Dialogue: 0,0:20:11.66,0:20:14.26,Main,Lola,0,0,0,,Nasıl düşeceğim önemli değil!
Dialogue: 0,0:20:15.33,0:20:18.33,Main,Lola,0,0,0,,Bir daha ışığı asla terketmeyeceğim!
Dialogue: 0,0:20:19.26,0:20:21.60,Main,Pirate,0,0,0,,Kaptan!
Dialogue: 0,0:20:23.60,0:20:26.02,Main,Zoro,0,0,0,,Demek sonunda patrona ulaştık.
Dialogue: 0,0:20:26.02,0:20:27.81,Main,Zoro,0,0,0,,Hem de büyük bir patron.
Dialogue: 0,0:20:27.81,0:20:32.75,Main,Robin,0,0,0,,Gururunu görmezden gelip, öfkesi\Ndoğrultusunda davranmaya karar verdi.
Dialogue: 0,0:20:33.46,0:20:36.46,Main,Luffy,0,0,0,,Hey, çocuklar. Vakit kalmadı.
Dialogue: 0,0:20:36.46,0:20:38.45,Main,Luffy,0,0,0,,Biraz dikkatsizlik edeceğim.
Dialogue: 0,0:20:38.45,0:20:40.38,Main,Franky,0,0,0,,Tamam! Bana bırak!
Dialogue: 0,0:20:40.38,0:20:41.92,Main,Usopp,0,0,0,,Yen onu!
Dialogue: 0,0:20:41.92,0:20:45.23,Main,Pirate,0,0,0,,Hey, çocuklar, aklınız başınızda mı?!
Dialogue: 0,0:20:45.23,0:20:46.96,Main,Pirate,0,0,0,,Kazanabilmeniz mümkün değil!
Dialogue: 0,0:20:46.96,0:20:49.66,Main,Pirate,0,0,0,,O canavar 1000'den fazla kişinin gücüne sahip!
Dialogue: 0,0:20:49.66,0:20:51.58,Main,Pirate,0,0,0,,Evet! Harekete geçmeden önce düşünün!
Dialogue: 0,0:20:51.58,0:20:53.87,Main,Pirate,0,0,0,,Senin gölgen de orada.
Dialogue: 0,0:20:53.87,0:20:56.14,Main,Pirate,0,0,0,,O canavarı güçlendirdiğini biliyor musun?!
Dialogue: 0,0:20:56.14,0:20:57.60,Main,Pirate,0,0,0,,Hiç vaktimiz kalmadı!
Dialogue: 0,0:20:57.60,0:21:00.55,Main,Zoro,0,0,0,,Yardım etmiyorsanız çenenizi kapatın!
Dialogue: 0,0:21:01.31,0:21:04.37,Main,Zoro,0,0,0,,Zaten Moria'ya karşı bu dövüşü kazandık.
Dialogue: 0,0:21:06.31,0:21:10.91,Main,Zoro,0,0,0,,Şimdi sadece zamana karşı dövüşmek kaldı.
Dialogue: 0,0:21:11.29,0:21:15.18,Main,Zoro,0,0,0,,Moria, gücüyle sadece vakit kazanmaya çalışıyor.
Dialogue: 0,0:21:21.42,0:21:22.78,Main,Luffy,0,0,0,,{\fad(150,150)}İkinci Düzen!
Dialogue: 0,0:21:27.38,0:21:29.89,Main,Zoro,0,0,0,,Yok mu edileceğiz?
Dialogue: 0,0:21:29.89,0:21:33.09,Main,Zoro,0,0,0,,Yoksa önce Moria mı düşecek?
Dialogue: 0,0:21:40.28,0:21:41.99,Main,Luffy,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:21:42.34,0:21:44.03,Main,Luffy,0,0,0,,{\fad(150,150)}...Jet Roket!
Dialogue: 0,0:21:49.50,0:21:50.26,Main,Pirate,0,0,0,,Bakın!
Dialogue: 0,0:21:50.26,0:21:51.46,Main,Pirate,0,0,0,,Gölgeler çıkıyor!
Dialogue: 0,0:21:56.54,0:21:58.49,Main,Luffy,0,0,0,,{\fad(150,150)}...Jet Bazuka!
Dialogue: 0,0:22:00.32,0:22:02.46,Main,Luffy,0,0,0,,{\fad(150,150)}...Jet Bazuka!
Dialogue: 0,0:22:05.54,0:22:08.32,Main,Pirate,0,0,0,,Bir sürü gölge serbest kaldı!
Dialogue: 0,0:22:08.32,0:22:11.01,Main,Pirate,0,0,0,,Niye kontrol ettiği gölgeler kaçıyor?!
Dialogue: 0,0:22:11.01,0:22:14.86,Main,Usopp,0,0,0,,Moria bilincini yitirdikçe, gölgeler kontrolü ele geçiriyor!
Dialogue: 0,0:22:14.86,0:22:19.22,Main,Usopp,0,0,0,,Çünkü 1000 gölge, Moria'nın bile\Nkontrol edemeyeceği kadar fazla!
Dialogue: 0,0:22:23.57,0:22:24.63,Main,Luffy,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:22:24.63,0:22:27.81,Main,Moria,0,0,0,,{\fad(150,150)}Briket Yarasa!
Dialogue: 0,0:22:33.79,0:22:35.44,Main,Moria,0,0,0,,{\fad(150,150)}Kara Kutu!
Dialogue: 0,0:22:37.97,0:22:38.99,Main,Luffy,0,0,0,,Beni tuzağa düşürdü!
Dialogue: 0,0:22:38.99,0:22:41.92,Main,Moria,0,0,0,,Seni ezeceğim!
Dialogue: 0,0:22:46.58,0:22:47.73,Main,Pirate,0,0,0,,Tam isabet!
Dialogue: 0,0:22:47.73,0:22:49.96,Main,Pirate,0,0,0,,Tüm adayı ikiye bölen yumruktan!
Dialogue: 0,0:22:49.96,0:22:51.45,Main,Pirate,0,0,0,,Hasır Şapka!
Dialogue: 0,0:22:57.15,0:22:58.24,Main,Pirate,0,0,0,,Kes şunu!
Dialogue: 0,0:22:59.59,0:23:03.33,Main,Moria,0,0,0,,Bu vaftiz!
Dialogue: 0,0:23:05.82,0:23:12.67,Main,Moria,0,0,0,,Bu koca dünyada siz amatörler, önemli\Nbiri gibi davranırsanız, olacağı budur!
Dialogue: 0,0:23:14.37,0:23:19.84,Main,Moria,0,0,0,,Bir Shichibukai'ye karşı çıkmak istediğinde böyle olur işte!
Dialogue: 0,0:23:19.84,0:23:23.71,Main,Moria,0,0,0,,İnsanlar sınırlarını bilmeli!
Dialogue: 0,0:23:24.40,0:23:28.52,Main,Moria,0,0,0,,Yoksa boş yere ölürler!
Dialogue: 0,0:23:33.26,0:23:34.48,Main,Brook,0,0,0,,Luffy-san!
Dialogue: 0,0:23:34.48,0:23:35.59,Main,Chopper,0,0,0,,Luffy!
Dialogue: 0,0:23:39.93,0:23:41.67,Main,All,0,0,0,,Ayağa kalktı!
Dialogue: 0,0:23:44.58,0:23:46.51,Main,Luffy,0,0,0,,Amatör olsak da,...
Dialogue: 0,0:23:48.48,0:23:50.58,Main,Luffy,0,0,0,,...boş yere ölsek de,...
Dialogue: 0,0:23:50.99,0:23:52.48,Main,Luffy,0,0,0,,...hiç kimse...
Dialogue: 0,0:23:52.48,0:23:54.41,Main,Luffy,0,0,0,,...beni...
Dialogue: 0,0:23:54.41,0:23:56.05,Main,Luffy,0,0,0,,...deviremeyecek!
Dialogue: 0,0:23:56.99,0:23:59.13,Main,Moria,0,0,0,,Kimse seni deviremeyecek mi?
Dialogue: 0,0:24:02.12,0:24:06.06,Main,Moria,0,0,0,,Bu kadar temelsiz bir iddiayı neye dayandırıyorsun?
Dialogue: 0,0:24:06.06,0:24:08.76,Main,Moria,0,0,0,,Sadece kendini daha deneyimsiz gösteriyorsun!
Dialogue: 0,0:24:08.76,0:24:12.06,Main,Luffy,0,0,0,,Çünkü ben lastiğim!
Dialogue: 0,0:24:18.26,0:24:21.74,Main,Luffy,0,0,0,,Sadece izle. Sana hepsini kusturacağım!
Dialogue: 0,0:24:22.25,0:24:23.68,Main,Pirate,0,0,0,,Bu adamın nesi var?!
Dialogue: 0,0:24:23.68,0:24:24.54,Main,Pirate,0,0,0,,Ölümsüz mü?!
Dialogue: 0,0:24:24.54,0:24:25.88,Main,Pirate,0,0,0,,Müthiş!
Dialogue: 0,0:24:28.62,0:24:30.06,Main,Pirate,0,0,0,,Sabah güneşi!
Dialogue: 0,0:24:30.06,0:24:31.25,Main,Pirate,0,0,0,,Kahretsin!
Dialogue: 0,0:24:31.25,0:24:33.28,Main,Pirate,0,0,0,,Aptallar! Gölgeye girin!
Dialogue: 0,0:24:33.28,0:24:34.20,Main,Pirate,0,0,0,,Yanacaksınız!
Dialogue: 0,0:24:34.50,0:24:35.34,Main,Pirate,0,0,0,,Kurtarın!
Dialogue: 0,0:24:35.34,0:24:36.85,Main,Pirate,0,0,0,,İmkansız! Yok olacağız!
Dialogue: 0,0:24:36.85,0:24:37.79,Main,Pirate,0,0,0,,Hemen gölgeye girin!
Dialogue: 0,0:24:37.79,0:24:40.26,Main,Pirate,0,0,0,,Burası fazla dayanmayacak!
Dialogue: 0,0:24:45.35,0:24:46.57,Main,Luffy,0,0,0,,{\fad(150,150)}Kemik Balon!
Dialogue: 0,0:24:50.03,0:24:52.41,Main,Franky,0,0,0,,Hey! İkisini aynı anda mı kullanacak?!
Dialogue: 0,0:24:52.41,0:24:53.72,Main,Usopp,0,0,0,,Mümkün değil!
Dialogue: 0,0:24:54.08,0:24:59.01,Main,Usopp,0,0,0,,Son dövüşte sana ne olduğunu hatırlamıyor musun?!
Dialogue: 0,0:24:59.01,0:25:01.11,Main,Chopper,0,0,0,,Dikkatsizlik etme, Luffy!
Dialogue: 0,0:25:02.24,0:25:06.00,Main,Chopper,0,0,0,,Bedenin parçalanacak!
Dialogue: 0,0:25:10.03,0:25:11.57,Main,Luffy,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:25:12.80,0:25:13.86,Main,Luffy,0,0,0,,{\fad(150,150)}...Dev...
Dialogue: 0,0:25:14.80,0:25:17.71,Main,Luffy,0,0,0,,{\fad(150,150)}...Jet Mermi!
Dialogue: 0,0:25:22.15,0:25:22.77,Main,Pirate,0,0,0,,Ne güç ama!
Dialogue: 0,0:25:23.27,0:25:24.50,Main,Pirate,0,0,0,,Gölgeler çıkıyor!
Dialogue: 0,0:25:26.91,0:25:30.47,Main,Moria,0,0,0,,Kaçamazsınız! Gücümün kaynağı!
Dialogue: 0,0:25:35.04,0:25:36.83,Main,Moria,0,0,0,,Gölgeler!
Dialogue: 0,0:25:36.83,0:25:41.23,Main,Moria,0,0,0,,Ben sizin efendinizim!
Dialogue: 0,0:25:42.25,0:25:43.72,Main,Pirate,0,0,0,,Pislik!
Dialogue: 0,0:25:43.72,0:25:45.62,Main,Pirate,0,0,0,,Gölgelerimizi bizden uzak tutmaya mı çalışıyor?!
Dialogue: 0,0:25:45.89,0:25:47.39,Main,Lola,0,0,0,,Gölgem!
Dialogue: 0,0:25:48.63,0:25:50.39,Main,Lola,0,0,0,,Bana geri dön!
Dialogue: 0,0:25:50.39,0:25:51.33,Main,Pirate,0,0,0,,Kaptan Lola!
Dialogue: 0,0:25:51.33,0:25:53.63,Main,Pirate,0,0,0,,Kaptan Lola!
Dialogue: 0,0:25:54.63,0:25:57.94,Main,Lola,0,0,0,,Beni duyabiliyor musun, gölgem?!
Dialogue: 0,0:25:58.87,0:26:01.84,Main,Lola,0,0,0,,Doğumumuzdan beri birlikte çok badireler atlatmadık mı?!
Dialogue: 0,0:26:03.21,0:26:06.08,Main,Lola,0,0,0,,Sen ve ben birlikte doğduk!
Dialogue: 0,0:26:06.59,0:26:08.61,Main,Lola,0,0,0,,Bana geri dön!
Dialogue: 0,0:26:08.61,0:26:13.09,Main,Lola,0,0,0,,Zombini arayarak 3 yıl harcadım!
Dialogue: 0,0:26:13.09,0:26:15.52,Main,Lola,0,0,0,,Şimdiyse buradasın, değil mi?!
Dialogue: 0,0:26:15.52,0:26:18.22,Main,Lola,0,0,0,,Duyabiliyorsan, buraya geri dön!
Dialogue: 0,0:26:18.22,0:26:19.36,Main,Lola,0,0,0,,Bana geri dön!
Dialogue: 0,0:26:19.36,0:26:20.70,Main,Pirate,0,0,0,,Kaptan Lola!
Dialogue: 0,0:26:21.57,0:26:23.66,Main,Pirate,0,0,0,,Gölgeye gir!
Dialogue: 0,0:26:23.66,0:26:25.86,Main,Pirate,0,0,0,,Bedenin yok olacak!
Dialogue: 0,0:26:25.86,0:26:28.82,Main,Lola,0,0,0,,Ama! Hiçbir şey hissetmiyor musunuz?!
Dialogue: 0,0:26:28.82,0:26:30.37,Main,Lola,0,0,0,,Tam oradalar!
Dialogue: 0,0:26:32.34,0:26:33.57,Main,Pirate,0,0,0,,Doğru.
Dialogue: 0,0:26:33.57,0:26:37.31,Main,Pirate,0,0,0,,Gölgelerimizin hepsi Moria'nın bedeninde toplanmış.
Dialogue: 0,0:26:37.31,0:26:42.35,Main,Pirate,0,0,0,,Bir daha asla böyle bir şansımız olmayacak!
Dialogue: 0,0:26:42.35,0:26:44.65,Main,Pirate,0,0,0,,Ama rakip bir Shichibukai.
Dialogue: 0,0:26:45.31,0:26:47.39,Main,Pirate,0,0,0,,Evet, geri gelin!
Dialogue: 0,0:26:47.39,0:26:50.09,Main,Pirate,0,0,0,,Geri gelin, gölgelerimiz!
Dialogue: 0,0:26:50.31,0:26:51.66,Main,Pirate,0,0,0,,Geri gelin!
Dialogue: 0,0:26:51.66,0:26:53.36,Main,Pirate,0,0,0,,Geri gelin!
Dialogue: 0,0:26:53.36,0:26:55.29,Main,Pirate,0,0,0,,Geri gelin!
Dialogue: 0,0:26:55.29,0:26:58.32,Main,Pirate,0,0,0,,Geri gelin!
Dialogue: 0,0:26:58.32,0:27:02.07,Main,Luffy,0,0,0,,Benim de gölgeme söyleyecek bir şeyim var.
Dialogue: 0,0:27:06.16,0:27:09.51,Main,Luffy,0,0,0,,Gerçekten Korsanlar Kralı olmak istiyorsan,...
Dialogue: 0,0:27:11.56,0:27:13.18,Main,Luffy,0,0,0,,...bana...
Dialogue: 0,0:27:14.36,0:27:16.18,Main,Luffy,0,0,0,,...geri dönmelisin!
Dialogue: 0,0:27:49.81,0:27:52.45,Main,Moria,0,0,0,,Hasır Şapka! Seni...
Dialogue: 0,0:27:52.45,0:27:54.08,Main,Moria,0,0,0,,...pislik!
Dialogue: 0,0:27:56.63,0:27:58.62,Main,Moria,0,0,0,,O zaman gidip kendin gör!
Dialogue: 0,0:27:58.62,0:28:03.46,Main,Moria,0,0,0,,Yeni Dünya'da. Orada nasıl gerçek bir kâbus olduğunu.
Dialogue: 0,0:28:03.46,0:28:06.14,Main,Moria,0,0,0,,Yeni Dünya'da!
Dialogue: 0,0:28:11.42,0:28:15.07,Main,Pirate,0,0,0,,Gölgeler geri dönüyor!
Dialogue: 0,0:28:28.91,0:28:30.76,Main,Usopp,0,0,0,,H-Hey, çocuklar!
Dialogue: 0,0:28:33.26,0:28:34.29,Main,Franky,0,0,0,,Hey!
Dialogue: 0,0:28:37.36,0:28:39.31,Main,Lola,0,0,0,,Gölge, acele et ve...
Dialogue: 0,0:28:39.80,0:28:42.16,Main,Pirate,0,0,0,,Ne?! Bu da-
