Dialogue: 0,0:17:40.00,0:17:50.00,Author,,0,0,0,,{\fad(500,500)\fs20} Türkçeleştirme {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&}
Dialogue: 0,0:02:29.93,0:02:39.93,Author,,0,0,0,,{\fad(500,500)\fs20} Türkçeleştirme {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&}
Dialogue: 0,0:02:29.93,0:02:36.95,Title,,0,0,0,,{\fad(2000,2000)}Görünmez Adam ve\NMalikânenin Sırrı!
Dialogue: 0,0:02:38.19,0:02:40.07,Main,Nami,0,0,0,,Biz yolculuk eden kor-
Dialogue: 0,0:02:40.07,0:02:42.67,Main,Nami,0,0,0,,Denizciler demek istedim!
Dialogue: 0,0:02:42.67,0:02:45.16,Main,Nami,0,0,0,,Yolculuk ediyorduk ve yolumuzu kaybettik!
Dialogue: 0,0:02:45.16,0:02:47.46,Main,Nami,0,0,0,,Lütfen girmemize izin verin!
Dialogue: 0,0:02:48.41,0:02:51.63,Main,Nami,0,0,0,,Evde kimse var mı?
Dialogue: 0,0:02:52.41,0:02:56.39,Main,Usopp,0,0,0,,Tuhaf, içi tünele benziyor.
Dialogue: 0,0:02:56.39,0:02:58.55,Main,Chopper,0,0,0,,Diğer tarafta bir avlu görebiliyorum.
Dialogue: 0,0:02:58.55,0:03:00.63,Main,Nami,0,0,0,,Afedersiniz!
Dialogue: 0,0:03:04.01,0:03:05.75,Main,Usopp,0,0,0,,Dışarıda mı dersiniz?
Dialogue: 0,0:03:05.75,0:03:07.34,Main,Nami,0,0,0,,Bu iyi olmazdı.
Dialogue: 0,0:03:07.34,0:03:08.93,Main,Nami,0,0,0,,Geri dönersek, zombiler bizi yakalayacak.
Dialogue: 0,0:03:10.70,0:03:13.60,Main,Chopper,0,0,0,,Bakın, bir ışık açıldı!
Dialogue: 0,0:03:14.11,0:03:17.25,Main,Usopp,0,0,0,,Aslında daha çok bir spot ışığı.
Dialogue: 0,0:03:17.25,0:03:18.50,Main,Usopp,0,0,0,,Bu kuyuyu aydınlatıyor.
Dialogue: 0,0:03:20.17,0:03:21.09,Main,Cindry,0,0,0,,Hoşgeldiniz.
Dialogue: 0,0:03:24.95,0:03:26.57,Main,Cindry,0,0,0,,Bir, iki, üç.
Dialogue: 0,0:03:27.01,0:03:28.24,Main,Usopp,0,0,0,,N-Ne?
Dialogue: 0,0:03:28.24,0:03:29.39,Main,Cindry,0,0,0,,Dört, beş.
Dialogue: 0,0:03:29.66,0:03:30.69,Main,Usopp,0,0,0,,A-Ah!
Dialogue: 0,0:03:30.69,0:03:32.25,Main,Usopp,0,0,0,,Bize tabaklarla saldırıyor!
Dialogue: 0,0:03:32.25,0:03:33.35,Main,Usopp,0,0,0,,Altı, yedi.
Dialogue: 0,0:03:33.35,0:03:36.17,Main,Usopp,0,0,0,,Ah, sadece bana mı nişan alıyorsun?!
Dialogue: 0,0:03:36.17,0:03:38.05,Main,Cindry,0,0,0,,Evet, öyle.
Dialogue: 0,0:03:38.05,0:03:40.51,Main,Cindry,0,0,0,,Malikânede sana izin yok.
Dialogue: 0,0:03:41.18,0:03:43.44,Main,Cindry,0,0,0,,Siz ikiniz gelebilirsiniz.
Dialogue: 0,0:03:43.44,0:03:45.51,Main,both,0,0,0,,Eh? Niye?
Dialogue: 0,0:03:45.51,0:03:47.43,Main,Cindry,0,0,0,,Sen hiçbir yere gitmiyorsun!
Dialogue: 0,0:03:47.43,0:03:48.47,Main,Cindry,0,0,0,,Sekiz, dokuz!
Dialogue: 0,0:03:48.47,0:03:49.83,Main,,0,0,0,,Neden?
Dialogue: 0,0:03:51.52,0:03:53.79,Main,Hogback,0,0,0,,Dur, bu kadarı yeter!
Dialogue: 0,0:03:53.79,0:03:54.69,Main,Nami,0,0,0,,Ne?!
Dialogue: 0,0:03:54.69,0:03:57.19,Main,Chopper,0,0,0,,Başka korkunç bir şey olmasın, lütfen!
Dialogue: 0,0:04:02.40,0:04:03.66,Main,Usopp,0,0,0,,Orada başka biri mi var?
Dialogue: 0,0:04:03.66,0:04:07.28,Main,Hogback,0,0,0,,Bir istisna yapamaz mısın, Cindry-chan?
Dialogue: 0,0:04:07.28,0:04:09.87,Main,Hogback,0,0,0,,Sizi öyle korkuttuğum için üzgünüm.
Dialogue: 0,0:04:09.87,0:04:15.49,Main,Hogback,0,0,0,,Uzun zaman önce zengin nişanlısının aşkını sınamak için...
Dialogue: 0,0:04:15.49,0:04:19.06,Main,Hogback,0,0,0,,...bu kadın, tüm pahalı porselen tabaklarını kırdı...
Dialogue: 0,0:04:19.06,0:04:21.86,Main,Hogback,0,0,0,,...ve kovalanarak korkunç bir hayat sürdü.
Dialogue: 0,0:04:21.86,0:04:24.76,Main,Hogback,0,0,0,,Tabak sevmeyen hizmetçim, Cindry-chan.
Dialogue: 0,0:04:24.76,0:04:26.72,Main,Usopp,0,0,0,,Ah, neyse.
Dialogue: 0,0:04:27.00,0:04:29.00,Main,Hogback,0,0,4,,Kendimi henüz tanıtmadım.
Dialogue: 0,0:04:27.71,0:04:34.69,Captions,Sign,0,0,210,,{\fad(1000,0)}Malikânenin Sahibi (Dahi Cerrah)\NDoctor Hogback
Dialogue: 0,0:04:29.00,0:04:32.78,Main,Hogback,0,0,4,,Ben, dünya çapında meşhur doktor Hogback'im!
Dialogue: 0,0:04:32.78,0:04:34.68,Main,Hogback,0,0,4,,Dahiyim.
Dialogue: 0,0:04:35.15,0:04:35.62,Main,Cindry,0,0,0,,On!
Dialogue: 0,0:04:35.62,0:04:36.54,Main,Nami,0,0,0,,Usopp!
Dialogue: 0,0:04:36.54,0:04:39.20,Main,Hogback,0,0,0,,D-Dur, Cindry-chan!
Dialogue: 0,0:04:39.20,0:04:40.85,Main,Hogback,0,0,0,,Şunu kesmeni söylemiştim!
Dialogue: 0,0:04:40.85,0:04:44.01,Main,Hogback,0,0,0,,Söylediğim şeyi dinlemen gerekir!
Dialogue: 0,0:04:44.40,0:04:47.54,Main,Cindry,0,0,0,,Tabakların bu dünyadan yok olmasını isterdim.
Dialogue: 0,0:04:47.54,0:04:48.51,Main,Hogback,0,0,0,,Anlıyorum!
Dialogue: 0,0:04:48.51,0:04:52.35,Main,Hogback,0,0,0,,Gerçekten anlıyorum ama \Nşu anda konuşmaya çalışıyorum!
Dialogue: 0,0:04:52.35,0:04:53.17,Main,Usopp,0,0,0,,Chopper.
Dialogue: 0,0:04:53.17,0:04:54.63,Main,Usopp,0,0,0,,O adam tanışmak istediğin...
Dialogue: 0,0:04:54.63,0:04:57.86,Main,Chopper,0,0,0,,D-Doktor Hogback, gerçekten o!
Dialogue: 0,0:04:57.86,0:04:59.66,Main,Nami,0,0,0,,Biraz aptalca görünüyor.
Dialogue: 0,0:04:59.66,0:05:01.32,Main,Chopper,0,0,0,,Kes şunu, Nami!
Dialogue: 0,0:05:04.99,0:05:06.59,Main,Cindry,0,0,0,,Neyse, buna içeride devam edebiliriz.
Dialogue: 0,0:05:06.59,0:05:09.89,Main,Cindry,0,0,0,,Bir istisna yapabilir ve üçünüzün de\Ngirmesine izin verebiliriz.
Dialogue: 0,0:05:09.89,0:05:11.32,Main,Cindry,0,0,0,,Hoşgeldiniz.
Dialogue: 0,0:05:11.32,0:05:14.02,Main,Hogback,0,0,0,,A-Ah, evet. İçeri girin.
Dialogue: 0,0:05:14.02,0:05:16.94,Main,Usopp,0,0,0,,Niye giremeyeceğimi anlamıyorum...
Dialogue: 0,0:05:16.94,0:05:18.65,Main,Usopp,0,0,0,,...ama neyse, gidelim.
Dialogue: 0,0:05:18.65,0:05:21.49,Main,Nami,0,0,0,,Evet, en azından zombilerden iyidir.
Dialogue: 0,0:05:24.58,0:05:27.12,Main,Hogback,0,0,0,,Hey, ben hala...
Dialogue: 0,0:05:27.12,0:05:30.11,Thoughts,Hogback,0,0,0,,Ben hala buradayım.
Dialogue: 0,0:05:33.80,0:05:36.23,Main,Hogback,0,0,0,,Malikâneme hoşgeldiniz demek istiyorum!
Dialogue: 0,0:05:36.23,0:05:38.82,Main,Hogback,0,0,0,,Çok pissiniz!
Dialogue: 0,0:05:38.82,0:05:40.49,Main,Hogback,0,0,0,,Niye geldiniz?
Dialogue: 0,0:05:40.49,0:05:42.59,Main,Nami,0,0,0,,Şey, bir sürü sebebi var.
Dialogue: 0,0:05:42.59,0:05:43.45,Main,Nami,0,0,0,,Öncelikle...
Dialogue: 0,0:05:43.45,0:05:46.56,Main,Chopper,0,0,0,,Sizinle sonra konuşmak istiyorum!
Dialogue: 0,0:05:47.19,0:05:51.36,Main,Nami,0,0,0,,Mezarlıktaki zombilerin saldırısına uğradık ve buraya koştuk!
Dialogue: 0,0:05:51.36,0:05:52.77,Main,Hogback,0,0,0,,Zombiler?
Dialogue: 0,0:05:52.77,0:05:56.71,Main,Usopp,0,0,0,,Burada, inanılmaz bir sürü yaratık da gördük!
Dialogue: 0,0:05:56.71,0:05:59.02,Main,Usopp,0,0,0,,Buranın nesi var böyle?
Dialogue: 0,0:05:59.02,0:06:01.28,Main,Usopp,0,0,0,,Burada yaşadığınıza göre bilmelisiniz!
Dialogue: 0,0:06:01.28,0:06:03.72,Main,Hogback,0,0,0,,Oh, saldırıya mı uğradınız?
Dialogue: 0,0:06:03.72,0:06:05.89,Main,Hogback,0,0,0,,Buraya kadar güvenle gelmenize sevindim.
Dialogue: 0,0:06:05.89,0:06:07.21,Main,Hogback,0,0,0,,Bu harika.
Dialogue: 0,0:06:08.02,0:06:09.93,Main,Hogback,0,0,0,,İşte sorunuzun cevabı.
Dialogue: 0,0:06:09.93,0:06:13.42,Main,Hogback,0,0,0,,O şeylerin ne olduğunu bilmediğim için burada yaşıyorum.
Dialogue: 0,0:06:13.42,0:06:17.84,Main,Chopper,0,0,0,,Yani zombileri araştırmak için mi buradasınız, Doktor?!
Dialogue: 0,0:06:17.84,0:06:19.30,Main,Hogback,0,0,0,,Elbette!
Dialogue: 0,0:06:19.30,0:06:22.35,Main,Hogback,0,0,0,,İnsanlar zombilerden çok korkar.
Dialogue: 0,0:06:22.35,0:06:25.48,Main,Hogback,0,0,0,,Ama bu olaya insanların ölümden\Ngeri dönmesi olarak bakarsak,...
Dialogue: 0,0:06:25.48,0:06:29.44,Main,Hogback,0,0,0,,...bu, tüm insanların elde etmeye\Nçalıştığı ölümsüzlük değil mi?
Dialogue: 0,0:06:29.44,0:06:35.16,Main,Hogback,0,0,0,,Her insanın yeniden görmek\Nistediği, ölen birkaç yakını vardır.
Dialogue: 0,0:06:35.16,0:06:37.77,Main,Hogback,0,0,0,,Tıp bilimi sayesinde...
Dialogue: 0,0:06:37.79,0:06:40.81,Main,Hogback,0,0,0,,...Kamilerden korkmadan insanların yaşamasını veya ölmesini kontrol edebilecek kapasitedeyiz.
Dialogue: 0,0:06:40.81,0:06:47.54,Main,Hogback,0,0,0,,Bu sebepten ötürü dünyadan kayboldum ve bu gizemli adada araştırmama başladım.
Dialogue: 0,0:06:47.54,0:06:50.44,Main,Chopper,0,0,0,,Ö-Öyle mi?
Dialogue: 0,0:06:50.44,0:06:56.20,Main,Chopper,0,0,0,,Ama başarırsanız, bir sürü insan mutlu olacak!
Dialogue: 0,0:06:56.59,0:06:59.85,Main,Chopper,0,0,0,,Sana tezahürat yapacağım, Doktor Hogback!
Dialogue: 0,0:06:59.85,0:07:03.60,Main,Hogback,0,0,0,,Oh, sağol, Doktor Chopper.
Dialogue: 0,0:07:04.72,0:07:09.57,Main,Chopper,0,0,0,,Bana doktor desen de mutlu değilim, pislik!
Dialogue: 0,0:07:12.22,0:07:14.18,Main,Chopper,0,0,0,,İmzanızı alabilir miyim?
Dialogue: 0,0:07:14.18,0:07:15.73,Main,Hogback,0,0,0,,Ah, tabi.
Dialogue: 0,0:07:16.53,0:07:18.99,Main,Hogback,0,0,0,,Doktor Chopper-kun'a,...
Dialogue: 0,0:07:19.90,0:07:22.93,Main,Chopper,0,0,0,,Daha sonra laboratuvarınızı görebilir miyim?
Dialogue: 0,0:07:22.93,0:07:27.40,Main,Hogback,0,0,0,,Sakın ola laboratuvarıma bakma.
Dialogue: 0,0:07:32.07,0:07:36.49,Main,Hogback,0,0,0,,Oh, Cindry-chan, en azından pudingi tabağa koyamaz mısın?
Dialogue: 0,0:07:36.49,0:07:38.10,Main,Hogback,0,0,0,,Veya bunu istemek anlamsız mı?!
Dialogue: 0,0:07:39.09,0:07:42.60,Main,Cindry,0,0,0,,Tüm tabakların yok olmasını istiyorum.
Dialogue: 0,0:07:44.49,0:07:49.82,Main,Hogback,0,0,0,,Neyse, endişelenmeyin. Böyle olaylar için masa örtüsünü temiz tutuyoruz!
Dialogue: 0,0:07:50.12,0:07:51.82,Main,Chopper,0,0,0,,Yiyelim o zaman!
Dialogue: 0,0:07:52.26,0:07:54.24,Main,Nami,0,0,0,,En azından kaşık kullanın!
Dialogue: 0,0:07:55.22,0:07:57.66,Main,Chopper,0,0,0,,Oh! Gerçekten güzel ve leziz!
Dialogue: 0,0:07:57.66,0:07:59.43,Main,Usopp,0,0,0,,Banyoyu hazırladım.
Dialogue: 0,0:07:59.43,0:08:02.02,Main,Usopp,0,0,0,,Çok pissiniz, bu yüzden kullanabilirsiniz.
Dialogue: 0,0:08:03.27,0:08:04.91,Main,Usopp,0,0,0,,Sahi, amca!
Dialogue: 0,0:08:04.91,0:08:07.03,Main,Usopp,0,0,0,,Her şey tamam da...
Dialogue: 0,0:08:07.03,0:08:10.42,Main,Usopp,0,0,0,,...buradan geçen tuhaf bir iskelet görmedin, değil mi?
Dialogue: 0,0:08:12.36,0:08:13.93,Main,Hogback,0,0,0,,İskelet?
Dialogue: 0,0:08:13.93,0:08:15.03,Main,Usopp,0,0,0,,Evet.
Dialogue: 0,0:08:15.03,0:08:16.98,Main,Usopp,0,0,0,,Afrosu var ve boyu çok uzun.
Dialogue: 0,0:08:16.98,0:08:17.91,Main,Usopp,0,0,0,,Çok hafif.
Dialogue: 0,0:08:22.27,0:08:27.19,Main,Usopp,0,0,0,,Şey, sanırım sadece yürüyen ve\Nkonuşan bir iskelet olması da tuhaf.
Dialogue: 0,0:08:27.84,0:08:30.36,Main,Usopp,0,0,0,,Bu konuda bir şey biliyor musun?
Dialogue: 0,0:08:32.41,0:08:34.16,Main,Hogback,0,0,0,,H-Hayır, bilmiyorum.
Dialogue: 0,0:08:35.55,0:08:36.91,Main,Usopp,0,0,0,,Gerçekten mi?
Dialogue: 0,0:08:36.91,0:08:38.20,Main,Usopp,0,0,0,,İyi o zaman.
Dialogue: 0,0:08:38.54,0:08:40.65,Thoughts,Hogback,0,0,0,,{\i1}O adamı mı kastediyorlar?{\i0}
Dialogue: 0,0:08:40.65,0:08:43.82,Thoughts,Hogback,0,0,0,,{\i1}Hayır, olamaz.{\i0}
Dialogue: 0,0:08:45.46,0:08:47.42,Captions,Sign,0,0,210,,Malikâne Banyosu
Dialogue: 0,0:08:49.42,0:08:52.50,Main,Chopper,0,0,0,,İnsan kadınları çıplak görmek ilgimi çekmiyor...
Dialogue: 0,0:08:52.50,0:08:56.68,Main,Chopper,0,0,0,,...ama Doktor Hogback'in laboratuvarına gizlice bakmak istiyorum.
Dialogue: 0,0:08:56.68,0:08:58.43,Main,Usopp,0,0,0,,Ama Nami...
Dialogue: 0,0:08:58.43,0:09:01.22,Main,Usopp,0,0,0,,...niye sana böyle gözcülük etmek zorundayız?
Dialogue: 0,0:09:01.22,0:09:03.31,Main,Usopp,0,0,0,,O kadar korktuysan banyoyu es geçebilirdin!
Dialogue: 0,0:09:03.31,0:09:06.67,Main,Nami,0,0,0,,Zombiler tarafından öyle tutulmayı pek umursamıyor gibisiniz.
Dialogue: 0,0:09:06.67,0:09:07.62,Main,Nami,0,0,0,,Pissiniz!
Dialogue: 0,0:09:07.62,0:09:09.78,Main,Usopp,0,0,0,,Nasılsa yine kirleneceğiz!
Dialogue: 0,0:09:09.78,0:09:10.81,Main,Chopper,0,0,0,,Evet!
Dialogue: 0,0:09:10.81,0:09:12.61,Main,Nami,0,0,0,,Bu akşam gidiyoruz.
Dialogue: 0,0:09:13.70,0:09:16.26,Main,Usopp,0,0,0,,Ne diyorsun sen, ap-
Dialogue: 0,0:09:18.12,0:09:20.88,Main,Usopp,0,0,0,,Geceyi geçirebileceğimizi söylediler.
Dialogue: 0,0:09:21.13,0:09:24.88,Main,Usopp,0,0,0,,Bu gece dışarı çıksaydık ne olurdu biliyor musun?!
Dialogue: 0,0:09:24.88,0:09:28.52,Main,Usopp,0,0,0,,Neyse, başka bir yere gitmeyeceğiz.
Dialogue: 0,0:09:28.52,0:09:30.77,Main,Usopp,0,0,0,,Luffy-gil gelip bizi kurtaracak.
Dialogue: 0,0:09:30.77,0:09:31.41,Main,Usopp,0,0,0,,Tamam mı?
Dialogue: 0,0:09:31.41,0:09:32.77,Main,Chopper,0,0,0,,Katılıyorum!
Dialogue: 0,0:09:32.77,0:09:34.85,Main,Chopper,0,0,0,,Oraya dönmek istemiyorum!
Dialogue: 0,0:09:34.85,0:09:36.39,Main,Chopper,0,0,0,,Ormanı veya mezarları sevmiyorum!
Dialogue: 0,0:09:36.70,0:09:38.94,Main,Nami,0,0,0,,İçerisi de dışarısıyla aynı.
Dialogue: 0,0:09:38.94,0:09:41.31,Main,Nami,0,0,0,,Etrafınıza iyice baktınız mı?
Dialogue: 0,0:09:41.74,0:09:43.90,Main,Nami,0,0,0,,Yanılmıyorsam,...
Dialogue: 0,0:09:43.90,0:09:46.36,Main,Nami,0,0,0,,...koridorlar ve odalar dolu.
Dialogue: 0,0:09:46.94,0:09:49.59,Main,Nami,0,0,0,,Bu malikâne zombilerle dolu.
Dialogue: 0,0:09:50.94,0:09:53.47,Main,both,0,0,0,,N-Neredeler?!
Dialogue: 0,0:09:53.47,0:09:57.60,Main,Nami,0,0,0,,Ama en şüphe çekici olan ise Hogback'in kendisi.
Dialogue: 0,0:09:57.60,0:09:59.63,Main,Nami,0,0,0,,Kesinlikle yalan söylüyor.
Dialogue: 0,0:09:59.63,0:10:02.46,Main,Nami,0,0,0,,İddia ettiği gibi zombilerle bağlantısı yoksa,...
Dialogue: 0,0:10:02.46,0:10:05.97,Main,Nami,0,0,0,,...niye onlarla dolu bir malikânede yaşıyor?
Dialogue: 0,0:10:08.70,0:10:10.90,Main,Usopp,0,0,0,,Y-Ya sen, Chopper?
Dialogue: 0,0:10:10.90,0:10:12.51,Main,Usopp,0,0,0,,Bu gerçekten doğruysa...
Dialogue: 0,0:10:12.51,0:10:13.77,Thoughts,Chopper,0,0,0,,{\i1}Hayır.{\i0}
Dialogue: 0,0:10:13.77,0:10:16.75,Main,Nami,0,0,0,,Şimdilik bilmiyormuş gibi davranacağız...
Dialogue: 0,0:10:16.75,0:10:18.98,Main,Nami,0,0,0,,...ve bu akşam gideceğiz.
Dialogue: 0,0:10:21.66,0:10:24.27,Main,Absalom,0,0,0,,Epey becerikli bir kız.
Dialogue: 0,0:10:24.27,0:10:24.82,Main,Nami,0,0,0,,Ne?
Dialogue: 0,0:10:25.36,0:10:27.70,Main,Nami,0,0,0,,Usopp, Chopper, biriniz bir şey mi dedi?
Dialogue: 0,0:10:28.34,0:10:29.48,Main,Usopp,0,0,0,,Bir şey demedim.
Dialogue: 0,0:10:30.22,0:10:32.28,Main,Usopp,0,0,0,,Hey, osurdum!
Dialogue: 0,0:10:32.28,0:10:33.65,Main,Chopper,0,0,0,,Üf, iğrenç, Usopp!
Dialogue: 0,0:10:35.83,0:10:37.54,Main,Usopp,0,0,0,,Ben Uso-buu.
Dialogue: 0,0:10:35.83,0:10:37.54,Captions,,0,0,0,,{\an8}- Buu: osuruk sesi -
Dialogue: 0,0:10:48.10,0:10:49.95,Main,Nami,0,0,0,,Neler oluyor?
Dialogue: 0,0:10:49.95,0:10:51.14,Main,Nami,0,0,0,,Burada kimse yok!
Dialogue: 0,0:10:52.74,0:10:55.50,Main,Absalom,0,0,0,,Gemideki kadınla karşılaştırıldığında...
Dialogue: 0,0:10:55.50,0:10:57.63,Main,Absalom,0,0,0,,...daha güçsüzsün, bana daha uygunsun.
Dialogue: 0,0:10:57.63,0:10:59.02,Thoughts,Nami,0,0,0,,{\i1}Burada biri var!{\i0}
Dialogue: 0,0:10:59.37,0:11:00.26,Main,Nami,0,0,0,,Usopp, Cho-
Dialogue: 0,0:11:02.29,0:11:06.20,Main,Absalom,0,0,0,,Karım olacaksın.
Dialogue: 0,0:11:07.21,0:11:09.06,Main,Usopp,0,0,0,,Hey, Nami! Ne oldu?
Dialogue: 0,0:11:09.06,0:11:11.63,Main,Chopper,0,0,0,,Usopp'un osuruğunun kokusunu\Nburada da duyabiliyor musun?
Dialogue: 0,0:11:12.45,0:11:13.90,Main,Usopp,0,0,0,,Çok sağol!
Dialogue: 0,0:11:13.90,0:11:14.92,Main,Chopper,0,0,0,,Ona teşekkür mü ediyorsun?
Dialogue: 0,0:11:17.47,0:11:18.84,Main,Absalom,0,0,0,,Defolun.
Dialogue: 0,0:11:18.84,0:11:20.71,Thoughts,Nami,0,0,0,,{\i1}Aptallar, yardım edin!{\i0}
Dialogue: 0,0:11:20.71,0:11:21.92,Main,,0,0,0,,Seni...
Dialogue: 0,0:11:23.60,0:11:25.55,Main,Nami,0,0,0,,Usopp, Chopper, yardım edin!
Dialogue: 0,0:11:25.99,0:11:27.60,Main,Nami,0,0,0,,Burada biri var!
Dialogue: 0,0:11:31.89,0:11:32.94,Main,Chopper,0,0,0,,Haklı, kokusunu alabiliyorum!
Dialogue: 0,0:11:33.45,0:11:33.96,Main,Usopp,0,0,0,,Hala mı?
Dialogue: 0,0:11:33.96,0:11:34.50,Main,Usopp,0,0,0,,Üzgünüm!
Dialogue: 0,0:11:34.50,0:11:36.96,Main,Chopper,0,0,0,,Osuruk değil, insan!
Dialogue: 0,0:11:37.44,0:11:38.69,Main,Nami,0,0,0,,Pencereden çıkıyor!
Dialogue: 0,0:11:38.69,0:11:40.33,Main,Usopp,0,0,0,,Pencere bunu kendi başına nasıl yapıyor?
Dialogue: 0,0:11:40.33,0:11:41.99,Main,Usopp,0,0,0,,Kaçan ne?
Dialogue: 0,0:11:41.99,0:11:43.96,Main,Usopp,0,0,0,,{\fad(150,150)}Kesin Öldürücü Barut Yıldızı!
Dialogue: 0,0:11:50.21,0:11:52.07,Main,Nami,0,0,0,,Kaçtı mı acaba?
Dialogue: 0,0:11:52.07,0:11:54.33,Main,Nami,0,0,0,,Tüm konuşmamızı duymuş.
Dialogue: 0,0:11:54.33,0:11:58.12,Main,Usopp,0,0,0,,Hey, Nami! Ne oldu öyle?
Dialogue: 0,0:11:58.12,0:11:59.42,Main,Usopp,0,0,0,,Anlamıyorum!
Dialogue: 0,0:11:59.66,0:12:01.63,Main,Nami,0,0,0,,Onca zamandır buradaydı.
Dialogue: 0,0:12:01.63,0:12:03.64,Main,Nami,0,0,0,,Görünmez bir adam.
Dialogue: 0,0:12:04.02,0:12:07.87,Captions,,0,0,220,,{\fad(380,600)}Bu arada... Thousand Sunny'de\NLuffy ve Diğerleri
Dialogue: 0,0:12:03.95,0:12:05.17,Main,Franky,0,0,2,,Faydasız.
Dialogue: 0,0:12:05.17,0:12:08.33,Main,Franky,0,0,2,,Ne yaparsak yapalım, çıkamıyoruz.
Dialogue: 0,0:12:08.33,0:12:10.10,Main,Franky,0,0,0,,Şu koca örümcek ağından.
Dialogue: 0,0:12:10.10,0:12:14.56,Main,Zoro,0,0,0,,Sunny gibi, iskeletin gemisi de takıldı.
Dialogue: 0,0:12:15.04,0:12:20.57,Main,Zoro,0,0,0,,Usopp-gil'in bindiği Mini Merry de buraya takılmış.
Dialogue: 0,0:12:20.97,0:12:27.93,Main,Zoro,0,0,0,,O şekildeki ön kapıyla neredeyse seni çağırıyormuş gibi.
Dialogue: 0,0:12:27.93,0:12:28.62,Main,Zoro,0,0,0,,Kahretsin.
Dialogue: 0,0:12:28.62,0:12:32.35,Main,Zoro,0,0,0,,Neredeyse el işaretleriyle bizi içeri\Nçağıran küçük hayaletleri görebiliyorum.
Dialogue: 0,0:12:32.35,0:12:34.94,Main,Luffy,0,0,0,,Orada ne mırıldanıyorsun, Zoro?!
Dialogue: 0,0:12:34.94,0:12:36.09,Main,Luffy,0,0,0,,Senin de gelmen gerek!
Dialogue: 0,0:12:36.37,0:12:38.31,Main,Luffy,0,0,0,,Burada kalırsan sıkılırsın.
Dialogue: 0,0:12:38.31,0:12:39.74,Main,Luffy,0,0,0,,Gidelim!
Dialogue: 0,0:12:39.74,0:12:41.81,Main,Luffy,0,0,0,,Hatta yolluğumun birazını paylaşabilirsin bile!
Dialogue: 0,0:12:48.42,0:12:50.77,Main,Sanji,0,0,0,,Niye durduk yerde merdivenler çıktı?
Dialogue: 0,0:12:50.77,0:12:53.73,Main,Luffy,0,0,0,,Çünkü burası giriş!
Dialogue: 0,0:12:56.07,0:12:58.69,Main,Luffy,0,0,0,,Hey, iskeletlerle dolu.
Dialogue: 0,0:13:04.49,0:13:06.76,Main,Sanji,0,0,0,,Eh, Kerberus?
Dialogue: 0,0:13:06.76,0:13:09.02,Main,Sanji,0,0,0,,Muhtemelen Cehennem buradan daha güvenli olurdu.
Dialogue: 0,0:13:09.02,0:13:10.73,Main,Robin,0,0,0,,Ah, çok sevimli.
Dialogue: 0,0:13:10.73,0:13:13.73,Main,Franky,0,0,0,,Sizce dövüşebilir mi?
Dialogue: 0,0:13:13.73,0:13:15.23,Main,Zoro,0,0,0,,Bilmem.
Dialogue: 0,0:13:15.23,0:13:16.65,Main,Luffy,0,0,0,,Sizce tadı güzel midir?
Dialogue: 0,0:13:23.77,0:13:25.72,Main,Zoro,0,0,0,,Şimdi dövüşmek istiyor.
Dialogue: 0,0:13:25.93,0:13:27.18,Main,Zoro,0,0,0,,O zaman ben...
Dialogue: 0,0:13:27.18,0:13:28.55,Main,Luffy,0,0,0,,Hayır, dur.
Dialogue: 0,0:13:30.28,0:13:31.88,Main,Luffy,0,0,0,,Onu eğitmeye çalışacağım.
Dialogue: 0,0:13:33.84,0:13:36.30,Main,Zoro,0,0,0,,Aptal, köpek olduğunu biliyorum, hadi ama.
Dialogue: 0,0:13:36.30,0:13:38.56,Main,Zoro,0,0,0,,Bir tür patrona falan benziyor.
Dialogue: 0,0:13:38.56,0:13:39.91,Main,Luffy,0,0,0,,Köpek, köpektir.
Dialogue: 0,0:13:40.32,0:13:42.12,Main,Luffy,0,0,0,,Tamam, tamam, tamam.
Dialogue: 0,0:13:42.12,0:13:43.12,Main,Luffy,0,0,0,,Elini ver.
Dialogue: 0,0:13:45.69,0:13:47.83,Main,Franky,0,0,0,,Tam da onu uyardıktan sonra.
Dialogue: 0,0:13:47.83,0:13:50.29,Main,Luffy,0,0,0,,Evet, iyi çocuk.
Dialogue: 0,0:13:50.62,0:13:52.12,Main,Luffy,0,0,0,,Tamam, tamam.
Dialogue: 0,0:13:52.12,0:13:55.39,Main,Luffy,0,0,0,,İşte bu, yavaşça bırak.
Dialogue: 0,0:13:55.39,0:13:56.78,Main,Luffy,0,0,0,,İşte iyi çocuk.
Dialogue: 0,0:13:56.78,0:13:59.14,Main,Luffy,0,0,0,,Pislik!
Dialogue: 0,0:14:01.34,0:14:02.41,Main,Luffy,0,0,0,,Yat.
Dialogue: 0,0:14:02.41,0:14:04.08,Main,both,0,0,0,,Bu doğru değil.
Dialogue: 0,0:14:06.75,0:14:09.25,Main,Robin,0,0,0,,Ama bu bir yana, üzerinde korkunç bir yara var.
Dialogue: 0,0:14:09.25,0:14:10.98,Main,Robin,0,0,0,,Sadece hayatta olması bile bir gizem.
Dialogue: 0,0:14:11.38,0:14:17.41,Main,Sanji,0,0,0,,İçine bir tilki karıştırılmış gibi, bu yüzden\Nnormal bir hayvan olduğundan şüpheliyim.
Dialogue: 0,0:14:18.73,0:14:23.41,Main,Luffy,0,0,0,,Gelir gelmez eğlenceli şeyler ortaya çıkıyor, bu harika!
Dialogue: 0,0:14:25.33,0:14:27.92,Main,Robin,0,0,0,,Kerberus-san pek mutlu görünmüyor.
Dialogue: 0,0:14:27.92,0:14:32.09,Main,Zoro,0,0,0,,Yenildikten sonra böyle bir şey yapması\Ngerçekten gururunu zedeliyor.
Dialogue: 0,0:14:32.09,0:14:34.76,Main,Sanji,0,0,0,,Nami-san!
Dialogue: 0,0:14:35.89,0:14:37.18,Main,Sanji,0,0,0,,Hey!
Dialogue: 0,0:14:37.18,0:14:39.18,Main,Sanji,0,0,0,,Neredesin, Nami-swan!
Dialogue: 0,0:14:40.64,0:14:41.08,Secondary,Sanji,0,0,0,,Nami-san!
Dialogue: 0,0:14:41.08,0:14:44.06,Main,Franky,0,0,0,,Tünelden çıktık ve şimdi de ormanda mıyız?
Dialogue: 0,0:14:41.08,0:14:43.25,Secondary,Sanji,0,0,0,,Nami-san!
Dialogue: 0,0:14:44.06,0:14:45.27,Main,Franky,0,0,0,,Çok tuhaf.
Dialogue: 0,0:14:46.04,0:14:46.69,Main,Luffy,0,0,0,,Ne?
Dialogue: 0,0:14:53.62,0:14:55.02,Main,Luffy,0,0,0,,Ağaç amca...
Dialogue: 0,0:14:55.02,0:14:56.42,Main,Luffy,0,0,0,,...ve tek boynuzlu bir at...
Dialogue: 0,0:14:56.42,0:14:57.91,Main,Luffy,0,0,0,,...birlikte içiyorlar mı?!
Dialogue: 0,0:15:00.87,0:15:02.14,Main,Both,0,0,0,,Yardım edin!
Dialogue: 0,0:15:03.13,0:15:04.85,Main,Both,0,0,0,,Yakaladım!
Dialogue: 0,0:15:04.85,0:15:06.67,Main,MocDonald,0,0,0,,Lütfen bırak beni!
Dialogue: 0,0:15:06.67,0:15:08.85,Main,Luffy,0,0,0,,Siz, benimle birlikte korsan o-
Dialogue: 0,0:15:08.85,0:15:10.42,Main,Zoro and Sanji,0,0,0,,Kes şunu!
Dialogue: 0,0:15:10.84,0:15:13.42,Captions,Sign,0,0,220,,{\fad(400,400)}Doctor Hogback'in Malikânesi
Dialogue: 0,0:15:17.94,0:15:19.60,Main,Absalom,0,0,0,,Çok yakındı.
Dialogue: 0,0:15:19.60,0:15:21.16,Main,Hogback,0,0,0,,Hey, Absalom.
Dialogue: 0,0:15:21.16,0:15:22.50,Main,Hogback,0,0,0,,Burada olduğunu biliyorum.
Dialogue: 0,0:15:22.50,0:15:24.23,Main,Hogback,0,0,0,,Deminki karmaşa neydi?
Dialogue: 0,0:15:24.23,0:15:26.83,Main,Hogback,0,0,0,,Yine mi banyodaydın?
Dialogue: 0,0:15:29.02,0:15:30.94,Main,Absalom,0,0,0,,Bir eş arıyordum, Hogback.
Dialogue: 0,0:15:31.47,0:15:34.62,Main,Absalom,0,0,0,,O kadından hoşlanıyorum.
Dialogue: 0,0:15:34.62,0:15:36.96,Main,Absalom,0,0,0,,Onu kendimin yapacağım.
Dialogue: 0,0:15:38.83,0:15:43.04,Main,Hogback,0,0,0,,Ödül parasından hiç almayacaksın.
Dialogue: 0,0:15:43.04,0:15:45.38,Main,Absalom,0,0,0,,Ne?
Dialogue: 0,0:15:45.82,0:15:48.43,Main,Perona,0,0,0,,Bu kez altısının da ödülü var.
Dialogue: 0,0:15:48.43,0:15:50.38,Main,Perona,0,0,0,,İçlerinden birinin 100 milyondan fazla.
Dialogue: 0,0:15:50.38,0:15:52.51,Main,Perona,0,0,0,,Kaptanın kendisi 300 milyon değerinde!
Dialogue: 0,0:15:52.51,0:15:54.06,Main,Absalom,0,0,0,,300 milyon?
Dialogue: 0,0:15:55.92,0:15:57.94,Main,Absalom,0,0,0,,Emin misin, Perona?
Dialogue: 0,0:15:57.94,0:16:01.94,Main,Absalom,0,0,0,,Hükümet sıradan bir korsanın başına o kadar ödül koymaz.
Dialogue: 0,0:16:02.12,0:16:08.11,Main,Hogback,0,0,0,,Artık tüm gücümüzü onları yakalamak\Niçin kullanacağımızı biliyoruz, Absalom.
Dialogue: 0,0:16:08.11,0:16:11.57,Main,Hogback,0,0,0,,Bu akşam bizim için tahsis edilmiş işi yapacağız!
Dialogue: 0,0:16:12.39,0:16:16.66,Captions,Sign,0,0,220,,{\fad(200,0)}Malikâne\N2. Kattaki Koridor
Dialogue: 0,0:16:12.22,0:16:14.71,Main,Usopp,0,0,2,,Görünmez adam diye bir şey yoktur!
Dialogue: 0,0:16:14.71,0:16:16.66,Main,Nami,0,0,2,,Vardı!
Dialogue: 0,0:16:16.66,0:16:20.00,Main,Nami,0,0,0,,Bana saldırdığını görmedin mi?!
Dialogue: 0,0:16:20.00,0:16:22.25,Main,Usopp,0,0,0,,Ah, şey...
Dialogue: 0,0:16:22.25,0:16:23.95,Main,Usopp,0,0,0,,Hayır, görmedim!
Dialogue: 0,0:16:23.95,0:16:24.81,Main,Nami,0,0,0,,Gördün!
Dialogue: 0,0:16:24.81,0:16:26.83,Main,Usopp,0,0,0,,Beni kandırıyorsun!
Dialogue: 0,0:16:26.83,0:16:31.13,Main,Usopp,0,0,0,,Sadece bana saldırabilmek için seni\Nçıplak gördüğümü söylememi istiyorsun!
Dialogue: 0,0:16:31.13,0:16:32.80,Main,Nami,0,0,0,,Ölecektim!
Dialogue: 0,0:16:32.80,0:16:34.39,Main,Nami,0,0,0,,Gerçi yine de sana saldıracağım.
Dialogue: 0,0:16:34.39,0:16:38.17,Main,Usopp,0,0,0,,Neyse, bu adada gördüğümüz hiçbir şeye inanmıyorum!
Dialogue: 0,0:16:38.17,0:16:38.95,Main,Usopp,0,0,0,,Dinle!
Dialogue: 0,0:16:38.95,0:16:41.14,Main,Usopp,0,0,0,,Görünmez adam? Senin hayal gücün.
Dialogue: 0,0:16:41.14,0:16:42.92,Main,Usopp,0,0,0,,Hayaletler? Tuhaf kuşlar.
Dialogue: 0,0:16:42.92,0:16:45.60,Main,Usopp,0,0,0,,Zombiler, gizemli yeraltı sakinlerinin bir türü!
Dialogue: 0,0:16:45.60,0:16:46.53,Main,Nami,0,0,0,,Neden bahsediyorsun?
Dialogue: 0,0:16:46.53,0:16:51.61,Main,Usopp,0,0,0,,Gerçekten Şeytan Meyvesi'yle hayata dönmüş bir iskelet gördük!
Dialogue: 0,0:16:51.61,0:16:53.28,Main,Usopp,0,0,0,,Ama...
Dialogue: 0,0:16:53.28,0:16:55.70,Main,Usopp,0,0,0,,...bu sadece bir istisnaydı!
Dialogue: 0,0:16:55.70,0:16:58.52,Main,Usopp,0,0,0,,İki kişide aynı Şeytan Meyvesi yeteneği olamaz.
Dialogue: 0,0:16:58.52,0:17:01.98,Main,Usopp,0,0,0,,İnsanların hayata dönmesinin başka yolu da yok!
Dialogue: 0,0:17:01.98,0:17:03.34,Main,Usopp,0,0,0,,Değil mi, Chopper?
Dialogue: 0,0:17:03.34,0:17:09.05,Main,Usopp,0,0,0,,Öyle bir şey olabilmesinin başka yolu yok!
Dialogue: 0,0:17:09.05,0:17:16.75,Main,Chopper,0,0,0,,İlaçla bile öyle bir şeyin olması mümkün değil.
Dialogue: 0,0:17:16.75,0:17:17.77,Main,Chopper,0,0,0,,Ama...
Dialogue: 0,0:17:18.35,0:17:23.23,Main,Chopper,0,0,0,,...Doctor Hogback gerçekten müthiş ve bunu araştırıyor.
Dialogue: 0,0:17:23.53,0:17:28.04,Main,Chopper,0,0,0,,O kadar mucizevi bir şeyin bile burada oluyor olması muhtemel.
Dialogue: 0,0:17:28.04,0:17:30.33,Main,Nami,0,0,0,,Ona biraz fazla güvenmiyor musun?
Dialogue: 0,0:17:30.33,0:17:33.50,Main,Chopper,0,0,0,,Doctor Hogback harika bir adam!
Dialogue: 0,0:17:33.50,0:17:34.95,Main,Chopper,0,0,0,,Ona çok saygı duyuyorum!
Dialogue: 0,0:17:35.33,0:17:37.00,Main,Chopper,0,0,0,,Yanılan sensin!
Dialogue: 0,0:17:37.00,0:17:40.83,Main,Chopper,0,0,0,,Hiç kanıt olmadan doktorun ve\Nzombilerin birlikte olduğunu söylüyorsun!
Dialogue: 0,0:17:47.64,0:17:50.33,Main,Nami,0,0,0,,İzlendiğimiz hissini bir türlü üstümden atamıyorum.
Dialogue: 0,0:17:50.33,0:17:52.08,Main,Nami,0,0,0,,Tuhaf.
Dialogue: 0,0:17:52.08,0:17:53.26,Main,Nami,0,0,0,,Neyse.
Dialogue: 0,0:17:56.08,0:17:58.55,Main,Nami,0,0,0,,Orası daha önceki oda değil mi?
Dialogue: 0,0:17:58.55,0:17:59.54,Main,Usopp,0,0,0,,Evet.
Dialogue: 0,0:18:00.41,0:18:01.85,Main,Usopp,0,0,0,,Niye o kadar karanlık?
Dialogue: 0,0:18:01.85,0:18:03.44,Main,Chopper,0,0,0,,Ne?
Dialogue: 0,0:18:07.00,0:18:10.21,Main,Usopp,0,0,0,,C-Cindry-chan?
Dialogue: 0,0:18:10.21,0:18:11.16,Main,Chopper,0,0,0,,Doktor!
Dialogue: 0,0:18:11.16,0:18:12.68,Main,Chopper,0,0,0,,Neredesin?
Dialogue: 0,0:18:12.68,0:18:15.14,Main,Nami,0,0,0,,Banyo için sağolun.
Dialogue: 0,0:18:19.42,0:18:22.27,Main,Hildon,0,0,0,,Gece için dinlenmeye çekildiler.
Dialogue: 0,0:18:24.39,0:18:25.86,Main,Usopp,0,0,0,,Hildon?!
Dialogue: 0,0:18:26.09,0:18:27.17,Main,Usopp,0,0,0,,Lanet olası!
Dialogue: 0,0:18:27.17,0:18:30.10,Main,Usopp,0,0,0,,Bizi mezarlıkta bırakıp gittin!
Dialogue: 0,0:18:30.35,0:18:32.19,Main,Hildon,0,0,0,,Başka çarem yoktu.
Dialogue: 0,0:18:32.19,0:18:35.47,Main,Hildon,0,0,0,,Atları bir iş için almıştım ve ben bakmıyorken kaçmışlar.
Dialogue: 0,0:18:35.47,0:18:36.65,Main,Nami,0,0,0,,Yalan söylüyorsun!
Dialogue: 0,0:18:36.65,0:18:39.31,Main,Nami,0,0,0,,Bu adadakilerin hepsi gulyabani!
Dialogue: 0,0:18:39.31,0:18:42.54,Main,Hildon,0,0,0,,Bu hakaret.
Dialogue: 0,0:18:48.12,0:18:52.08,Main,Hildon,0,0,0,,Peşimden gelirseniz, odalarınızı göstereceğim.
Dialogue: 0,0:18:52.08,0:18:55.59,Main,Usopp,0,0,0,,Her şeyi görmezden gelip\Nbize etrafı mı gösteriyorsun?!
Dialogue: 0,0:18:55.59,0:18:58.04,Main,Nami,0,0,0,,Acaba orası gerçekten Cehennem'e giden kapı mı?
Dialogue: 0,0:18:58.80,0:19:02.59,Main,Nami,0,0,0,,Üzgünüm ama biz gidiyoruz.
Dialogue: 0,0:19:03.19,0:19:06.69,Main,Chopper,0,0,0,,Lütfen önce doktorla tekrar konuşmama izin verin!
Dialogue: 0,0:19:08.40,0:19:10.81,Main,zombie,0,0,0,,Bizi buldular, Hildon.
Dialogue: 0,0:19:12.02,0:19:15.85,Main,Hildon,0,0,0,,Lütfen bunu boşverin ve size odalarınızı göstereceğim.
Dialogue: 0,0:19:16.92,0:19:18.77,Main,zombie,0,0,0,,Sorun değil.
Dialogue: 0,0:19:19.67,0:19:22.49,Main,zombie,0,0,0,,Zaten her şeyi anlamaya başladılar.
Dialogue: 0,0:19:23.11,0:19:25.32,Main,zombie,0,0,0,,Bu yüzden onlar kaçmadan evvel...
Dialogue: 0,0:19:26.53,0:19:28.53,Main,Chopper,0,0,0,,Niye...
Dialogue: 0,0:19:30.05,0:19:31.20,Main,Nami,0,0,0,,...o resim...
Dialogue: 0,0:19:31.47,0:19:33.62,Main,Usopp,0,0,0,,...konuş- konuş- konuş-
Dialogue: 0,0:19:34.64,0:19:38.05,Main,zombie,0,0,0,,Korkudan titrerken çok sevimlisiniz.
Dialogue: 0,0:19:38.05,0:19:39.49,Main,Nami,0,0,0,,Chopper!
Dialogue: 0,0:19:39.49,0:19:41.03,Main,Usopp,0,0,0,,Resimden zombi mi çıktı?!
Dialogue: 0,0:19:41.03,0:19:42.72,Main,Chopper,0,0,0,,Yardım edin!
Dialogue: 0,0:19:42.72,0:19:43.89,Main,Nami,0,0,0,,Chopper!
Dialogue: 0,0:19:49.91,0:19:53.72,Main,Buhichuck,0,0,0,,Bu odadaki zombilerin lideri benim, Buhichuck-sama!
Dialogue: 0,0:19:53.72,0:19:57.98,Main,Buhichuck,0,0,0,,Bu odanın dışına bir adım bile atabileceğinizi sanmayın, buhi!
Dialogue: 0,0:19:58.29,0:20:02.15,Main,Usopp,0,0,0,,Duvardaki kafa konuştu mu?
Dialogue: 0,0:20:04.24,0:20:06.28,Main,zombie,0,0,0,,Ah, ah, ah...
Dialogue: 0,0:20:06.65,0:20:10.57,Main,zombie,0,0,0,,O kılıcı sırtıma kim sapladı?
Dialogue: 0,0:20:14.77,0:20:16.51,Main,Usopp,0,0,0,,Aynı Nami'nin dediği gibi!
Dialogue: 0,0:20:16.51,0:20:19.51,Main,Usopp,0,0,0,,Bu malikâne gerçekten zombilerle dolu!
Dialogue: 0,0:20:21.81,0:20:22.68,Main,Nami,0,0,0,,Usopp!
Dialogue: 0,0:20:26.91,0:20:27.91,Main,Usopp,0,0,0,,Lanet olası!
Dialogue: 0,0:20:29.46,0:20:31.46,Main,Usopp,0,0,0,,Al bakalım, seni aptal halı ayı!
Dialogue: 0,0:20:34.01,0:20:36.74,Main,zombie,0,0,0,,Hayır, bu bir mum!
Dialogue: 0,0:20:36.74,0:20:37.53,Main,zombie,0,0,0,,Sıcak, sıcak!
Dialogue: 0,0:20:37.53,0:20:39.57,Main,zombie,0,0,0,,Uzaklaştırın şunu, yanacağım!
Dialogue: 0,0:20:39.57,0:20:40.69,Main,zombie,0,0,0,,Ateş, korkuyorum!
Dialogue: 0,0:20:40.69,0:20:42.07,Main,zombie,0,0,0,,Söndürün!
Dialogue: 0,0:20:42.07,0:20:43.91,Main,zombie,0,0,0,,Avizenin üstünde!
Dialogue: 0,0:20:43.91,0:20:45.91,Main,zombie,0,0,0,,Düşürün onu, çabuk!
Dialogue: 0,0:20:47.84,0:20:50.56,Main,Usopp,0,0,0,,Zayıflığınızı biliyorum!
Dialogue: 0,0:20:50.56,0:20:52.96,Main,Usopp,0,0,0,,Alın bakalım!
Dialogue: 0,0:20:52.96,0:20:54.64,Main,Usopp,0,0,0,,Alın!
Dialogue: 0,0:20:54.64,0:20:55.66,Main,Usopp,0,0,0,,Bunu da!
Dialogue: 0,0:20:55.66,0:20:56.14,Main,Usopp,0,0,0,,Bunu da!
Dialogue: 0,0:21:03.13,0:21:05.29,Main,Usopp,0,0,0,,Chopper, Nami, kapıya gidin!
Dialogue: 0,0:21:05.29,0:21:06.83,Main,Usopp,0,0,0,,Buradan çıkıyoruz!
Dialogue: 0,0:21:06.83,0:21:07.77,Main,Nami,0,0,0,,Tamam!
Dialogue: 0,0:21:07.77,0:21:08.70,Main,Chopper,0,0,0,,Çıkalım!
Dialogue: 0,0:21:08.70,0:21:09.71,Main,Chopper,0,0,0,,Burada işim bitti!
Dialogue: 0,0:21:11.03,0:21:11.95,Main,Usopp,0,0,0,,Hemen aç kapıyı!
Dialogue: 0,0:21:11.95,0:21:13.32,Main,Usopp,0,0,0,,Burada da çok fazlası var!
Dialogue: 0,0:21:15.57,0:21:17.07,Main,Chopper,0,0,0,,Ne yapıyorsun, Nami?!
Dialogue: 0,0:21:17.07,0:21:19.20,Main,Nami,0,0,0,,Hayır...
Dialogue: 0,0:21:20.18,0:21:21.35,Main,Usopp,0,0,0,,Yoksa...
Dialogue: 0,0:21:21.35,0:21:22.62,Main,Nami,0,0,0,,Açılmıyor!
Dialogue: 0,0:21:22.62,0:21:24.04,Main,Nami,0,0,0,,Tuzağa düştük!
Dialogue: 0,0:21:26.18,0:21:29.67,Main,zombie,0,0,0,,Şimdi çizgiyi aştınız!
Dialogue: 0,0:21:29.67,0:21:33.71,Main,zombie,0,0,0,,Bizden kaçamayacaksınız!
Dialogue: 0,0:21:31.09,0:21:33.71,Secondary,zombie,0,0,0,,Lanet olası korsanlar!
Dialogue: 0,0:21:40.14,0:21:41.39,Main,Usopp,0,0,0,,Eğilin!
Dialogue: 0,0:21:47.12,0:21:48.23,Main,Usopp,0,0,0,,Çok yakındı!
Dialogue: 0,0:21:48.23,0:21:49.95,Main,Usopp,0,0,0,,Neyse, buradan çıkalım!
Dialogue: 0,0:21:49.95,0:21:51.04,Main,Usopp,0,0,0,,Başka bir odaya gideceğiz!
Dialogue: 0,0:21:51.32,0:21:53.40,Main,bikkuri zombie,0,0,0,,Kaçmanıza izin vermeyeceğiz!
Dialogue: 0,0:21:56.34,0:21:57.95,Main,Usopp,0,0,0,,Hayır, hayır, hayır!
Dialogue: 0,0:22:01.47,0:22:02.66,Main,bikkuri zombie,0,0,0,,Durun!
Dialogue: 0,0:22:04.26,0:22:06.19,Main,Chopper,0,0,0,,Şöminedeyiz!
Dialogue: 0,0:22:08.88,0:22:11.35,Main,Usopp,0,0,0,,Kaçacak yer yok!
Dialogue: 0,0:22:18.48,0:22:19.89,Main,Usopp,0,0,0,,Neredeyiz?
Dialogue: 0,0:22:20.29,0:22:22.13,Main,bikkuri zombie,0,0,0,,Hey, yok oldular!
Dialogue: 0,0:22:22.13,0:22:23.68,Main,bikkuri zombie,0,0,0,,Şöminede yok oldular!
Dialogue: 0,0:22:23.68,0:22:27.11,Main,bikkuri zombie,0,0,0,,Kahretsin, gizli geçidi açtılar!
Dialogue: 0,0:22:27.11,0:22:30.02,Main,bikkuri zombie,0,0,0,,Hogback-sama'nın laboratuvarında olacaklar!
Dialogue: 0,0:22:30.02,0:22:31.65,Main,bikkuri zombie,0,0,0,,Peşlerinden!
Dialogue: 0,0:22:31.65,0:22:34.86,Main,bikkuri zombie,0,0,0,,Faydasız, diğer taraftan engellenmiş!
Dialogue: 0,0:22:38.16,0:22:44.71,Main,Buhichuck,0,0,0,,Bu malikânede nereye giderlerse gitsinler,\Ndiğer Sürpriz Zombiler orada olacak, buhi!
Dialogue: 0,0:22:50.11,0:22:53.82,Main,Nami,0,0,0,,Bu tünelden çıkmalı ve resimli odalardan uzak durmalıyız!
Dialogue: 0,0:22:54.40,0:22:55.63,Main,Nami,0,0,0,,Oda nerede?
Dialogue: 0,0:22:56.44,0:22:57.53,Main,Nami,0,0,0,,Orada!
Dialogue: 0,0:23:11.77,0:23:12.34,Main,Usopp,0,0,0,,Daha fazla resim!
Dialogue: 0,0:23:14.00,0:23:16.31,Main,Usopp,0,0,0,,Hayır, fotoğraflar?
Dialogue: 0,0:23:16.31,0:23:17.67,Main,Usopp,0,0,0,,İyi.
Dialogue: 0,0:23:17.67,0:23:18.91,Main,Usopp,0,0,0,,Zombi değiller.
Dialogue: 0,0:23:19.33,0:23:21.75,Main,Nami,0,0,0,,Bu... o kız değil mi?
Dialogue: 0,0:23:22.12,0:23:25.33,Main,Nami,0,0,0,,Tabak sevmeyen kız, Cindry-chan?
Dialogue: 0,0:23:25.71,0:23:27.42,Main,Nami,0,0,0,,Burası ne böyle?
Dialogue: 0,0:23:30.46,0:23:33.38,Main,Nami,0,0,0,,Şimdi tekrar bakıyorum da gerçekten güzel bir kız.
Dialogue: 0,0:23:33.38,0:23:35.30,Main,Nami,0,0,0,,Hizmetçi Cindry-chan.
Dialogue: 0,0:23:35.30,0:23:39.97,Main,Usopp,0,0,0,,Yani burası onun odası mı?
Dialogue: 0,0:23:39.97,0:23:45.14,Main,Nami,0,0,0,,Hadi ama kendi odana bu kadar resmini koyar mıydın?
Dialogue: 0,0:23:45.14,0:23:49.26,Main,Chopper,0,0,0,,Ama yüzünde ve bedeninin her yerinde dikişler vardı!
Dialogue: 0,0:23:52.99,0:23:58.04,Main,Usopp,0,0,0,,Evet, bu resimlerin hiçbirinde yok.
Dialogue: 0,0:23:58.04,0:24:01.03,Main,Usopp,0,0,0,,Kesinlikle farklı bir insan olamaz.
Dialogue: 0,0:24:01.03,0:24:02.25,Main,Usopp,0,0,0,,Belki gerçekten eskidirler.
Dialogue: 0,0:24:02.73,0:24:05.34,Main,Nami,0,0,0,,Victoria Cindry.
Dialogue: 0,0:24:06.04,0:24:09.34,Main,Nami,0,0,0,,Gerçekten ünlü bir aktrismiş gibi görünüyor.
Dialogue: 0,0:24:10.27,0:24:13.19,Main,Nami,0,0,0,,Bakın, tüm bu yazılar onun hakkında.
Dialogue: 0,0:24:14.60,0:24:16.04,Main,Usopp,0,0,0,,Aktris mi?
Dialogue: 0,0:24:16.04,0:24:19.51,Main,Usopp,0,0,0,,Daha önce onun hizmetçi olmadığıyla ilgili bir şey demediler mi?
Dialogue: 0,0:24:19.51,0:24:22.40,Main,Usopp,0,0,0,,Tabakları kırmakla ve kocası tarafından atılmakla ilgili bir şey.
Dialogue: 0,0:24:22.40,0:24:27.20,Main,Nami,0,0,0,,Buna bakınca öyle bir şeyin olduğunu sanmıyorum.
Dialogue: 0,0:24:27.20,0:24:30.26,Main,Nami,0,0,0,,Zengin bir ailede doğmuş.
Dialogue: 0,0:24:30.26,0:24:32.81,Main,Nami,0,0,0,,Çocukluğundan beri çok popülermiş.
Dialogue: 0,0:24:33.66,0:24:34.70,Main,Usopp,0,0,0,,Ne oldu?
Dialogue: 0,0:24:34.70,0:24:36.58,Main,Nami,0,0,0,,On yıl önce...
Dialogue: 0,0:24:37.01,0:24:39.42,Main,Nami,0,0,0,,...sahneden düşmüş...
Dialogue: 0,0:24:39.42,0:24:41.29,Main,Nami,0,0,0,,...ve ölmüş!
Dialogue: 0,0:24:44.80,0:24:46.82,Main,Usopp,0,0,0,,N-N-N-Neden bahsediyorsun sen?!
Dialogue: 0,0:24:46.82,0:24:48.14,Main,Usopp,0,0,0,,O hayatta, değil mi?!
Dialogue: 0,0:24:48.14,0:24:49.97,Main,Usopp,0,0,0,,Ölmedi, değil mi?!
Dialogue: 0,0:24:49.97,0:24:53.97,Main,Chopper,0,0,0,,Ama gerçekten doğruysa,...
Dialogue: 0,0:24:53.97,0:24:58.29,Main,Chopper,0,0,0,,...bu bir kez öldüğü ve yeniden\Nhayata döndüğü anlamına gelir!
Dialogue: 0,0:25:00.71,0:25:04.49,Main,Chopper,0,0,0,,Bu adadakilerin hepsi gerçek zombi.
Dialogue: 0,0:25:04.49,0:25:08.76,Main,Chopper,0,0,0,,Gördüklerimiz, yaşayan ölülerdi!
Dialogue: 0,0:25:19.92,0:25:21.92,Main,Usopp,0,0,0,,Olamaz.
Dialogue: 0,0:25:21.92,0:25:24.09,Main,Usopp,0,0,0,,Gittikçe daha da ürkütücü oluyor.
Dialogue: 0,0:25:25.02,0:25:27.62,Main,Usopp,0,0,0,,Bunu bilmemeyi ister-
Dialogue: 0,0:25:29.29,0:25:30.09,Main,Nami,0,0,0,,Ne?!
Dialogue: 0,0:25:35.66,0:25:37.48,Main,Nami,0,0,0,,Dur, Usopp!
Dialogue: 0,0:25:37.48,0:25:40.25,Main,Nami,0,0,0,,O hazine sandığı değil mi~?
Dialogue: 0,0:25:40.25,0:25:41.69,Main,Chopper,0,0,0,,Hızlı bir değişim oldu!
Dialogue: 0,0:25:41.94,0:25:43.37,Main,Nami,0,0,0,,Hey, Usopp, açacak mısın?
Dialogue: 0,0:25:43.37,0:25:45.32,Main,Nami,0,0,0,,Lütfen benim için aç!
Dialogue: 0,0:25:47.47,0:25:51.12,Main,bikkuri zombie,0,0,0,,Üzgünüm, hazineyi tuttuğumuz yer burası değil!
Dialogue: 0,0:25:52.43,0:25:54.10,Main,all,0,0,0,,Yaylı kukla!
Dialogue: 0,0:25:59.26,0:26:01.00,Main,bikkuri zombie,0,0,0,,Uzak durun!
Dialogue: 0,0:26:01.74,0:26:03.59,Main,Usopp,0,0,0,,Resim zombiler!
Dialogue: 0,0:26:05.49,0:26:08.15,Thoughts,Nami,0,0,0,,{\i1}"Hazineyi tuttuğumuz yer burası değil."{\i0}
Dialogue: 0,0:26:08.15,0:26:10.97,Thoughts,Nami,0,0,0,,{\i1}Yaylı kukla zombi öyle dedi.{\i0}
Dialogue: 0,0:26:15.35,0:26:16.73,Main,bikkuri zombie,0,0,0,,Ah, bu muhafız.
Dialogue: 0,0:26:17.70,0:26:21.02,Main,Ryuuma,0,0,0,,Bu malikânede kaybolmuş kimseler var gibi görünüyor.
Dialogue: 0,0:26:21.02,0:26:22.69,Main,bikkuri zombie,0,0,0,,Oh, sen misin?
Dialogue: 0,0:26:23.14,0:26:25.11,Main,Ryuuma,0,0,0,,Sorun değil.
Dialogue: 0,0:26:25.11,0:26:26.82,Main,Ryuuma,0,0,0,,Onları hizaya sokacağım.
Dialogue: 0,0:26:36.25,0:26:41.55,Main,Sanji,0,0,0,,Her şeyi arkadaşın yapmak için uğraşmaya son vermelisin!
Dialogue: 0,0:26:42.10,0:26:45.34,Main,Sanji,0,0,0,,Tayfamızda zaten tanuki ve robot gibi tuhaflıklar var!
Dialogue: 0,0:26:45.65,0:26:47.36,Main,Franky,0,0,0,,Hey, ben robot değilim!
Dialogue: 0,0:26:47.36,0:26:49.30,Main,Franky,0,0,0,,Sayborgum, pislik!
Dialogue: 0,0:26:49.30,0:26:51.31,Main,Sanji,0,0,0,,Asıl mesele insan olmamanız!
Dialogue: 0,0:26:51.54,0:26:53.85,Main,Franky,0,0,0,,Ama benim temelim insan!
Dialogue: 0,0:26:53.85,0:26:55.90,Main,Sanji,0,0,0,,Hayır, temelin sapığın tekiydi!
Dialogue: 0,0:26:55.90,0:26:58.59,Main,Franky,0,0,0,,Ah, şey. O şekilde söylüyorsan,...
Dialogue: 0,0:26:58.59,0:27:00.03,Main,Sanji,0,0,0,,İltifat değildi.
Dialogue: 0,0:27:00.03,0:27:04.75,Main,Luffy singing,0,0,0,,{\i1}♪ Acaba şimdi ne bulacağız?{\i0} ♪
Dialogue: 0,0:27:04.75,0:27:07.62,Main,Luffy singing,0,0,0,,{\i1}♪ Bu çok eğlenceli!{\i0} ♪
Dialogue: 0,0:27:11.33,0:27:14.58,Main,Robin,0,0,0,,İnsan ağacı ve tek boynuzlu atı düşünüyorum da...
Dialogue: 0,0:27:15.10,0:27:16.29,Main,Zoro,0,0,0,,Ne oldu?
Dialogue: 0,0:27:16.29,0:27:19.50,Main,Robin,0,0,0,,Ormanda gördüğümüz tüm tuhaf\Nhayvanların benzer karakteristiği var.
Dialogue: 0,0:27:19.50,0:27:20.54,Main,Robin,0,0,0,,Bandajlar.
Dialogue: 0,0:27:20.54,0:27:21.41,Main,Robin,0,0,0,,Dikişler...
Dialogue: 0,0:27:21.41,0:27:23.44,Main,Robin,0,0,0,,...ve üzerine dövme yapılmış numaralar.
Dialogue: 0,0:27:23.44,0:27:25.18,Main,Zoro,0,0,0,,Numara.
Dialogue: 0,0:27:25.18,0:27:27.19,Main,Zoro,0,0,0,,Sanırım bir tane var.
Dialogue: 0,0:27:27.19,0:27:29.72,Main,Zoro,0,0,0,,Yani bunu onlara birinin yaptığını mı kastediyorsun?
Dialogue: 0,0:27:29.72,0:27:32.23,Main,Robin,0,0,0,,Evet, muhtemelen.
Dialogue: 0,0:27:33.09,0:27:34.65,Main,Luffy,0,0,0,,Ha? O ses de ne?
Dialogue: 0,0:27:37.33,0:27:40.03,Main,Luffy,0,0,0,,İşte, bir hayalet!
Dialogue: 0,0:27:44.57,0:27:46.28,Main,Luffy,0,0,0,,Hepsi dans edip kıpırdıyorlar!
Dialogue: 0,0:27:46.57,0:27:48.52,Main,Luffy,0,0,0,,Süper!
Dialogue: 0,0:27:50.25,0:27:53.42,Main,Sanji,0,0,0,,Sesleri ürkütücü çıkıyor.
Dialogue: 0,0:27:53.42,0:27:54.99,Main,Luffy,0,0,0,,Birini yakalayıp evcilleştireceğim!
Dialogue: 0,0:27:55.67,0:27:57.54,Main,Franky,0,0,0,,Demek nesnelerin içinden geçebiliyorlar.
Dialogue: 0,0:27:57.54,0:27:58.72,Main,Franky,0,0,0,,Tamam!
Dialogue: 0,0:28:00.88,0:28:03.62,Main,Franky,0,0,0,,{\fad(150,150)}Taze Ateş!
Dialogue: 0,0:28:07.26,0:28:10.08,Main,Franky,0,0,0,,Hayır, bu da işe yaramadı.
Dialogue: 0,0:28:12.36,0:28:13.75,Main,Franky,0,0,0,,Değersizim.
Dialogue: 0,0:28:13.75,0:28:16.09,Main,Franky,0,0,0,,Bu haftaki ben tamamen değersizim.
Dialogue: 0,0:28:16.09,0:28:18.12,Main,Franky,0,0,0,,Ne yaparsam yapayım başarısız olacağım.
Dialogue: 0,0:28:18.12,0:28:20.36,Main,Franky,0,0,0,,Yaşama arzum yok.
Dialogue: 0,0:28:21.91,0:28:25.20,Main,Franky,0,0,0,,Tüm dünyanın beni yuhaladığını duyabiliyorum.
Dialogue: 0,0:28:25.20,0:28:27.95,Main,Sanji,0,0,0,,Niye bu kadar depresifsin?!
Dialogue: 0,0:28:28.35,0:28:29.94,Main,Luffy,0,0,0,,Tamam!
Dialogue: 0,0:28:30.21,0:28:32.29,Main,Luffy,0,0,0,,Pislik!
Dialogue: 0,0:28:34.36,0:28:36.61,Main,Luffy,0,0,0,,Yeniden doğsaydım...
Dialogue: 0,0:28:36.61,0:28:38.69,Main,Luffy,0,0,0,,...kabuklu bir deniz canlısı olmak isterdim.
Dialogue: 0,0:28:38.69,0:28:40.01,Main,Luffy,0,0,0,,Çok kötü biriyim.
Dialogue: 0,0:28:40.01,0:28:42.24,Main,Luffy,0,0,0,,Gömülebileceğim bir delik olmasını isterdim.
Dialogue: 0,0:28:42.24,0:28:45.26,Main,Sanji,0,0,0,,Cidden ne yapıyorsunuz siz?!
Dialogue: 0,0:28:50.87,0:28:54.59,Main,Robin,0,0,0,,Hayaletler size dokunduğunda\Ndeğersizlik hissi mi oluşuyor acaba?
Dialogue: 0,0:28:54.59,0:28:56.07,Main,Sanji,0,0,0,,Hiç mantıklı değil!
Dialogue: 0,0:28:57.06,0:28:59.38,Main,Zoro,0,0,0,,Çok zavallılar.
Dialogue: 0,0:28:59.38,0:29:02.08,Main,Zoro,0,0,0,,Zaten asla ellerinden geleni yapmıyorlar.
Dialogue: 0,0:29:02.08,0:29:05.50,Main,Zoro,0,0,0,,Yani bu hayaletler, insanların kalpleriyle oynayabiliyor.
Dialogue: 0,0:29:08.45,0:29:10.60,Main,Zoro,0,0,0,,Doğduğum için bile üzgünüm.
Dialogue: 0,0:29:10.60,0:29:11.92,Main,Sanji,0,0,0,,Bu kadarı yeter!
Dialogue: 0,0:29:12.38,0:29:14.90,Main,Sanji,0,0,0,,Aynı Robin-chan'ın dediği gibi.
Dialogue: 0,0:29:14.90,0:29:20.09,Main,Robin,0,0,0,,Ama fiziksel bedenleri olmamasına rağmen, basit bir\Ndokunuşla duygusal üzüntüye sebep olabiliyorlar.
Dialogue: 0,0:29:20.69,0:29:23.57,Main,Robin,0,0,0,,Bunlar düşmanımızsa, çok güçlüler.
Dialogue: 0,0:29:23.57,0:29:24.64,Main,Sanji,0,0,0,,Kesinlikle.
Dialogue: 0,0:29:24.64,0:29:26.27,Main,Robin,0,0,0,,Burası gerçekten gizemli bir ada.
Dialogue: 0,0:29:32.40,0:29:37.26,Main,Luffy,0,0,0,,Oh, o hayaletleri bir dahaki görüşümde kendimi tutmayacağım!
Dialogue: 0,0:29:37.26,0:29:39.71,Main,Luffy,0,0,0,,Ayrıca evcilleştirmeyeceğim, istemiyorum!
Dialogue: 0,0:29:39.71,0:29:41.83,Main,Franky,0,0,0,,Zayıf bir yanları olmalı!
Dialogue: 0,0:29:41.83,0:29:43.37,Main,Franky,0,0,0,,Bu kez gerçekten onlardan kurtulacağım!
Dialogue: 0,0:29:45.29,0:29:46.86,Main,Sanji,0,0,0,,Kahretsin, bu çok komikti!
Dialogue: 0,0:29:46.86,0:29:47.67,Main,Zoro,0,0,0,,KAPA ÇENENİ!
Dialogue: 0,0:29:48.04,0:29:52.55,Main,Robin,0,0,0,,Numarası olan yamalı hayvanlar çok iyi yapılmış olabilir...
Dialogue: 0,0:29:52.55,0:29:55.55,Main,Robin,0,0,0,,...ama o hayaletler tamamiyle farklı görünüyor.
Dialogue: 0,0:29:55.88,0:29:58.03,Main,Sanji,0,0,0,,Onlardan gemide de vardı.
Dialogue: 0,0:29:58.94,0:30:02.14,Main,Sanji,0,0,0,,Bizi gözetlemek için arada bir ortaya\Nçıktıklarına dair içimde bir his var.
Dialogue: 0,0:30:03.57,0:30:07.06,Main,Sanji,0,0,0,,Soru şu ki; tüm bunların ardında kim var?
Dialogue: 0,0:30:21.24,0:30:23.45,Main,Luffy,0,0,0,,Vay, ne büyük bir mezarlık!
Dialogue: 0,0:30:23.45,0:30:25.50,Main,Luffy,0,0,0,,Burası gerçekten süper!
Dialogue: 0,0:30:25.50,0:30:27.85,Main,Luffy,0,0,0,,Hey, yolluğumuzu burada yiyelim!
Dialogue: 0,0:30:27.85,0:30:30.59,Main,Sanji,0,0,0,,Aptal, burada yersen tadı berbat olacak!
Dialogue: 0,0:30:44.65,0:30:47.56,Main,zombie,0,0,0,,Ne diye geri dönmek isteyeyim?!
Dialogue: 0,0:30:50.53,0:30:52.94,Main,Luffy,0,0,0,,Gerçekten yaralı yaşlı bir adam?
Dialogue: 0,0:30:52.94,0:30:55.20,Main,all,0,0,0,,Besbelli ki zombi!
Dialogue: 0,0:30:55.81,0:30:58.16,Main,zombie,0,0,0,,Zombileri hafife alıyorsun.
Dialogue: 0,0:30:58.16,0:30:59.90,Main,zombie,0,0,0,,Bunu yapmasan iyi olur!
Dialogue: 0,0:31:11.15,0:31:13.97,Main,Sanji,0,0,0,,Zombiler gerçekten bu kadar canlı mı?
Dialogue: 0,0:31:13.97,0:31:17.24,Main,zombie,0,0,0,,Zombilerin gerçekte ne kadar\Ntehlikeli olduğunu size göstereceğiz!
Dialogue: 0,0:31:20.14,0:31:21.84,Main,Luffy,0,0,0,,Oh, dövüşmek mi istiyorsunuz?
Dialogue: 0,0:31:21.84,0:31:24.56,Main,Luffy,0,0,0,,O zaman size ne kadar tehlikeli olduğumuzu göstereceğiz.
Dialogue: 0,0:31:30.61,0:31:33.60,Main,all,0,0,0,,{\fad(150,150)}600 Milyon Belilik *Pot!
Dialogue: 0,0:31:34.36,0:31:36.24,Main,Luffy,0,0,0,,Peki burada ne yapıyorsunuz?
Dialogue: 0,0:31:36.24,0:31:40.25,Main,Zombie,0,0,0,,Şey, zombi şeyleri, gömülmek.
Dialogue: 0,0:31:40.25,0:31:42.16,Main,Zombie,0,0,0,,Çürümek.
Dialogue: 0,0:31:42.16,0:31:43.81,Main,Zombie,0,0,0,,Evet, çürümek.
Dialogue: 0,0:31:43.81,0:31:45.34,Main,Zombie,0,0,0,,Ben de öyle.
Dialogue: 0,0:31:47.42,0:31:48.84,Main,Luffy,0,0,0,,Benimle dalga mı geçiyorsunuz?
Dialogue: 0,0:31:48.84,0:31:52.80,Main,Zombies,0,0,0,,Hayır, hayır! Geçmiyoruz! Üzgünüz!
Dialogue: 0,0:31:53.16,0:31:55.16,Main,Luffy,0,0,0,,Uzun burunlu bir adam,...
Dialogue: 0,0:31:55.16,0:31:57.21,Main,Luffy,0,0,0,,...turuncu saçlı bir kadın...
Dialogue: 0,0:31:57.21,0:32:00.06,Main,Luffy,0,0,0,,...ve rengeyiğine benzeyen bir tanuki buradan geçti mi?
Dialogue: 0,0:32:01.34,0:32:03.44,Main,Zombie,0,0,0,,Ah, evet, evet, evet.
Dialogue: 0,0:32:03.44,0:32:04.94,Main,Zombie,0,0,0,,Ama sana söylemeyeceğiz!
Dialogue: 0,0:32:04.94,0:32:10.94,Main,Zombie,0,0,0,,Hiç kimseye öyle bilgiler vermemek konusunda emir aldık.
Dialogue: 0,0:32:10.94,0:32:11.94,Secondary,Zombies,0,0,0,,Emir! Emir! Emir! Emir!
Dialogue: 0,0:32:11.94,0:32:15.12,Main,Luffy,0,0,0,,Oh? Yani kesinlikle bize söylemeyecek misiniz?
Dialogue: 0,0:32:11.94,0:32:15.12,Secondary,Zombies,0,0,0,,Emir! Emir! Emir! Emir!
Dialogue: 0,0:32:15.12,0:32:17.20,Main,Zombie,0,0,0,,Onlar buradan geçti.
Dialogue: 0,0:32:17.20,0:32:19.64,Main,Luffy,0,0,0,,Onlar benim arkadaşlarım.
Dialogue: 0,0:32:19.64,0:32:22.75,Main,Luffy,0,0,0,,Onlara dokunmadınız, değil mi?
Dialogue: 0,0:32:22.75,0:32:23.88,Main,Zombie,0,0,0,,Eh...?!
Dialogue: 0,0:32:23.88,0:32:25.84,Main,,0,0,0,,A-Arkadaşın mıydılar?
Dialogue: 0,0:32:25.84,0:32:27.36,Main,Zombie,0,0,0,,Dokunmadık!
Dialogue: 0,0:32:27.36,0:32:29.51,Main,Zombie,0,0,0,,Evet, ben de dokunmadım!
Dialogue: 0,0:32:30.26,0:32:32.18,Main,Luffy,0,0,0,,Doğruyu söyleyin!
Dialogue: 0,0:32:32.61,0:32:34.26,Main,Zombie,0,0,0,,O dokundu!
Dialogue: 0,0:32:34.26,0:32:37.51,Main,Zombie,0,0,0,,Eh?! Arkadaşını satma!
Dialogue: 0,0:32:37.51,0:32:40.22,Main,Zombie,0,0,0,,Onları ısırmaya çalışan sendin!
Dialogue: 0,0:32:41.20,0:32:42.58,Main,Zombie,0,0,0,,Hep birlikte saldırdık.
Dialogue: 0,0:32:42.58,0:32:44.40,Main,Zombie,0,0,0,,Aptal! Öyle deme!
Dialogue: 0,0:32:49.65,0:32:52.39,Main,Luffy,0,0,0,,Malikâneye doğru gitmiş gibiler.
Dialogue: 0,0:32:52.39,0:32:54.06,Main,Luffy,0,0,0,,İyi olmalarına sevindim.
Dialogue: 0,0:32:54.06,0:32:55.75,Main,Luffy,0,0,0,,Gerçi Brook'tan hala haberimiz yok.
Dialogue: 0,0:32:55.75,0:32:58.21,Main,Sanji,0,0,0,,Ama sorun değil, değil mi?
Dialogue: 0,0:32:58.21,0:33:01.33,Main,Spoil,0,0,0,,Durun biraz!
Dialogue: 0,0:33:03.43,0:33:05.52,Main,Old Man,0,0,0,,Sizi demin gördüm.
Dialogue: 0,0:33:06.40,0:33:09.64,Main,Old Man,0,0,0,,Çok güçlüsünüz, değil mi?
Dialogue: 0,0:33:09.64,0:33:12.74,Main,Old Man,0,0,0,,Biraz hikayemi dinleyebilir misiniz?
Dialogue: 0,0:33:12.74,0:33:14.63,Main,Luffy,0,0,0,,Kötü yaralanmışsın. Ne oldu?
Dialogue: 0,0:33:14.63,0:33:17.06,Main,All,0,0,0,,Zombi olduğunu söyledik ya!
Dialogue: 0,0:33:17.06,0:33:19.81,Main,Old Man,0,0,0,,Hayır, ben kötü yaralanmış yaşlı bir adamım.
Dialogue: 0,0:33:19.81,0:33:23.07,Main,All,0,0,0,,Karıştırmak çok kolay! \NSana sadece zombi diyeceğiz!
Dialogue: 0,0:33:23.86,0:33:27.45,Main,Old Man,0,0,0,,Yenmenizi istediğim bir adam var!
Dialogue: 0,0:33:27.45,0:33:30.10,Main,Old Man,0,0,0,,Bunu yapabileceğinizi biliyorum!
Dialogue: 0,0:33:30.10,0:33:35.23,Main,Old Man,0,0,0,,Çok fazla kurban var. \NO yenilseydi, bunların hepsi kurtulurdu.
Dialogue: 0,0:33:35.23,0:33:37.77,Main,Old Man,0,0,0,,Gölgemi geri alabilseydim, çok minnettar olurdum.
Dialogue: 0,0:33:38.10,0:33:40.71,Main,Luffy,0,0,0,,Doğru! Senin de gölgen yok amca!
Dialogue: 0,0:33:40.71,0:33:42.98,Main,Luffy,0,0,0,,Aynı Brook gibi!
Dialogue: 0,0:33:42.98,0:33:46.13,Main,Zoro,0,0,0,,Bunu kim yaptı?
Dialogue: 0,0:33:46.13,0:33:48.43,Main,Zoro,0,0,0,,Bu adadaki biri mi?
Dialogue: 0,0:33:48.43,0:33:49.89,Main,Old Man,0,0,0,,Moria...
Dialogue: 0,0:33:50.93,0:33:53.04,Main,Old Man,0,0,0,,Moria olarak bilinen bir adam.
Dialogue: 0,0:33:53.04,0:33:55.14,Main,Old Man,0,0,0,,Gerçekten korkunç biri!
Dialogue: 0,0:33:55.14,0:33:57.05,Main,Robin,0,0,0,,Moria?
Dialogue: 0,0:33:57.05,0:33:58.48,Main,Robin,0,0,0,,Yoksa kastettiğin...
Dialogue: 0,0:33:59.85,0:34:01.89,Main,Robin,0,0,0,,...Gecko Moria mı?!
Dialogue: 0,0:34:01.89,0:34:06.00,Main,Old Man,0,0,0,,O işte, o Moria!
Dialogue: 0,0:34:06.00,0:34:08.16,Main,Luffy,0,0,0,,Robin, onu tanıyor musun?
Dialogue: 0,0:34:08.16,0:34:10.57,Main,Robin,0,0,0,,Adını çok iyi biliyorum.
