Dialogue: 0,0:00:58.72,0:01:00.99,Lyrics,,0,0,0,,{\i1}...çalınsın!{\i0}
Dialogue: 0,0:01:08.40,0:01:11.57,Lyrics,,0,0,0,,{\i1}Yelken açarken hissettiğimiz o his...{\i0}
Dialogue: 0,0:01:11.68,0:01:15.05,Lyrics,,0,0,0,,{\i1}...asla unutmayacağım bir şey.{\i0}
Dialogue: 0,0:01:15.22,0:01:16.86,Lyrics,,0,0,0,,{\i1}O his sayesinde...{\i0}
Dialogue: 0,0:01:17.04,0:01:20.54,Lyrics,,0,0,0,,{\i1}...hiçbir şey beni korkutamayacak.{\i0}
Dialogue: 0,0:01:20.83,0:01:26.77,Lyrics,,0,0,0,,{\i1}Şimdi yolculuk yaklaşırken, yarışan kalp atışlarımız...{\i0}
Dialogue: 0,0:01:27.00,0:01:33.72,Lyrics,,0,0,0,,{\i1}...utangaç kalplerimize bir macera ritmi kazıyor.{\i0}
Dialogue: 0,0:01:33.92,0:01:38.09,Lyrics,,0,0,0,,{\i1}Yüksek sesle gülerken...{\i0}
Dialogue: 0,0:01:38.21,0:01:40.40,Lyrics,,0,0,0,,{\i1}...tüm hazineleri al.{\i0}
Dialogue: 0,0:01:40.53,0:01:44.80,Lyrics,,0,0,0,,{\fad(0,50)\i1}Dikkatleri üzerine çekerek...{\i0}
Dialogue: 0,0:01:44.90,0:01:47.44,Lyrics,,0,0,0,,{\i1}...hepsini büyük bir partide harca.{\i0}
Dialogue: 0,0:01:47.90,0:01:49.54,Lyrics,,0,0,0,,{\i1}Hayat maceralıdır.{\i0}
Dialogue: 0,0:01:49.54,0:01:51.12,Lyrics,,0,0,0,,{\i1}Tehlikesinin farkında ol.{\i0}
Dialogue: 0,0:01:51.12,0:01:52.82,Lyrics,,0,0,0,,{\i1}Kim bizden biri olacak?{\i0}
Dialogue: 0,0:01:52.82,0:01:54.41,Lyrics,,0,0,0,,{\i1}Ve yolculuk devam ediyor çünkü...{\i0}
Dialogue: 0,0:01:54.41,0:01:56.13,Lyrics,,0,0,0,,{\i1}...biz bir grup korsanız!{\i0}
Dialogue: 0,0:01:56.13,0:01:57.91,Lyrics,,0,0,0,,{\i1}Batıya, Doğuya.{\i0}
Dialogue: 0,0:01:57.91,0:01:59.38,Lyrics,,0,0,0,,{\i1}Yolumu bulmalı, uzaklara yelken açmalıyım.{\i0}
Dialogue: 0,0:01:59.38,0:02:00.38,Lyrics,,0,0,0,,{\i1}One Piece'e doğru!{\i0}
Dialogue: 0,0:02:00.57,0:02:04.65,Lyrics,,0,0,0,,{\i1}Boş kalbini hayallerle doldur.{\i0}
Dialogue: 0,0:02:04.79,0:02:06.99,Lyrics,,0,0,0,,{\i1}Kanatlarını aç.{\i0}
Dialogue: 0,0:02:07.24,0:02:11.31,Lyrics,,0,0,0,,{\i1}Kalbini esen rüzgarla boyarsan,...{\i0}
Dialogue: 0,0:02:11.41,0:02:13.65,Lyrics,,0,0,0,,{\i1}...ilerlersin.{\i0}
Dialogue: 0,0:02:13.71,0:02:17.83,Lyrics,,0,0,0,,{\i1}Yüksek sesle gülerken...{\i0}
Dialogue: 0,0:02:18.00,0:02:20.17,Lyrics,,0,0,0,,{\fad(60,0)\i1}...tüm hazineleri al.{\i0}
Dialogue: 0,0:02:20.30,0:02:24.57,Lyrics,,0,0,0,,{\i1}Dikkatleri üzerine çekerek...{\i0}
Dialogue: 0,0:02:24.74,0:02:27.31,Lyrics,,0,0,0,,{\i1}...hepsini büyük bir partide harca.{\i0}
