Dialogue: 0,0:02:29.86,0:02:38.52,Title,,0,0,0,,{\fad(2000,2000)}Mürettebatın Yok Oluşu! \NOz, Kabus Luffy'ye Karşı
Dialogue: 0,0:02:41.20,0:02:42.21,Main,Robin,0,0,0,,{\fad(150,150)}Tut!
Dialogue: 0,0:02:42.98,0:02:45.58,Main,Moria,0,0,0,,Ah, acı{\fscx250}-{\r}
Dialogue: 0,0:02:46.99,0:02:48.55,Main,Usopp,0,0,0,,Ooh, iyi iş Robin!
Dialogue: 0,0:02:52.41,0:02:56.10,Main,Moria,0,0,0,,Bunu yaparak beni engellediğinizi mi sanıyorsunuz?!
Dialogue: 0,0:02:56.10,0:02:59.72,Main,Moria,0,0,0,,Ne işgüzar küçük insanlarsınız.
Dialogue: 0,0:03:03.22,0:03:04.74,Main,Moria,0,0,0,,{\fad(150,150)}Briket Yarasa!
Dialogue: 0,0:03:09.65,0:03:10.99,Main,Sanji,0,0,0,,Robin-chan!
Dialogue: 0,0:03:12.13,0:03:13.69,Main,Robin,0,0,0,,{\fad(150,150)}Veinte Fleur!
Dialogue: 0,0:03:12.13,0:03:13.69,Note,Note,0,0,0,,{\fad(150,150)}20 Çiçek
Dialogue: 0,0:03:14.73,0:03:15.66,Main,Robin,0,0,0,,{\fad(150,150)}Calendula!
Dialogue: 0,0:03:14.73,0:03:15.66,Note,Note,0,0,0,,{\fad(150,150)}Kadife Çiçeği!
Dialogue: 0,0:03:20.08,0:03:21.45,Main,Nami,0,0,0,,Robin!
Dialogue: 0,0:03:26.30,0:03:30.59,Main,Sanji,0,0,0,,Robin-chan'a ne yaptığınızı sanıyorsunuz?!
Dialogue: 0,0:03:46.21,0:03:47.94,Main,Robin,0,0,0,,Moria'nın gölgesi?!
Dialogue: 0,0:03:50.09,0:03:53.41,Main,Moria,0,0,0,,O zaman bunu uzun menzilli bir dövüş yapalım.
Dialogue: 0,0:03:53.41,0:03:56.48,Main,Moria,0,0,0,,Madem beni etkili bir boğma konumunda tutuyorsun!
Dialogue: 0,0:03:57.45,0:03:59.77,Thoughts,Robin,0,0,0,,{\i1}Gölgesinin, dikkatimi dağıtmasına izin vermemeliyim.{\i0}
Dialogue: 0,0:03:59.77,0:04:03.40,Thoughts,Robin,0,0,0,,{\i1}Ana bedeni halledebilirsem, gölge de onunla birlikte ölecek.{\i0}
Dialogue: 0,0:04:06.73,0:04:07.96,Main,Robin,0,0,0,,{\fad(150,150)}Cuatro Manos!
Dialogue: 0,0:04:06.73,0:04:07.96,Note,Robin,0,0,0,,{\fad(150,150)}Dört El!
Dialogue: 0,0:04:10.33,0:04:13.44,Main,Moria,0,0,0,,Hey, seni sürtük.
Dialogue: 0,0:04:13.44,0:04:14.61,Main,Moria,0,0,0,,Ne yapıyor{\fscx250}-{\r}
Dialogue: 0,0:04:14.61,0:04:15.98,Main,Moria,0,0,0,,Kes şunu.
Dialogue: 0,0:04:16.29,0:04:16.99,Main,Robin,0,0,0,,{\fad(150,150)}Kavra!
Dialogue: 0,0:04:24.58,0:04:25.50,Main,Usopp,0,0,0,,Tamam!
Dialogue: 0,0:04:25.50,0:04:27.76,Main,Nami,0,0,0,,Müthişsin! Robin!
Dialogue: 0,0:04:28.75,0:04:31.48,Main,Zoro,0,0,0,,Hey, Robin! Arkandaki gölgeye dikkat et!
Dialogue: 0,0:04:42.72,0:04:44.76,Main,Nami,0,0,0,,Eh?! Moria niye burada?!
Dialogue: 0,0:04:44.76,0:04:47.85,Main,Moria,0,0,0,,Neredeyse beni haklıyordun ama tam değil!
Dialogue: 0,0:04:47.85,0:04:52.04,Main,Moria,0,0,0,,Kopya adamla istediğim gibi yer değiştirebilirim.
Dialogue: 0,0:04:52.04,0:04:54.24,Main,Sanji,0,0,0,,Yer değiştirmek mi?!
Dialogue: 0,0:04:54.70,0:04:56.78,Main,Usopp,0,0,0,,O zaman oradaki...
Dialogue: 0,0:04:59.36,0:05:02.75,Main,Moria,0,0,0,,Benim için orada oturan, Gölge Savaşçı'm.
Dialogue: 0,0:05:02.75,0:05:06.53,Main,Moria,0,0,0,,Birkaç dakika önce burada olan da oydu!
Dialogue: 0,0:05:15.03,0:05:16.43,Main,Sanji,0,0,0,,Robin-cha{\fscx250}-{\r}
Dialogue: 0,0:05:28.33,0:05:31.46,Main,Moria,0,0,0,,Üçüncüsü de gitti!
Dialogue: 0,0:05:33.22,0:05:35.60,Main,Usopp,0,0,0,,Robin'in gölgesi alındı!
Dialogue: 0,0:05:35.98,0:05:40.02,Main,Moria,0,0,0,,Şimdi seni koyacak bir şeyim yok\Nama galiba yanımda tutacağım.
Dialogue: 0,0:05:46.11,0:05:47.71,Main,Sanji,0,0,0,,{\fad(150,150)}Diable Jambe...
Dialogue: 0,0:05:46.11,0:05:47.71,Note,Note,0,0,0,,{\fad(150,150)}Şeytan Bacak!
Dialogue: 0,0:05:48.75,0:05:51.11,Main,Sanji,0,0,0,,Seni kahrolası pislik!
Dialogue: 0,0:05:53.18,0:05:56.22,Main,Sanji,0,0,0,,Robin-chan'ın gölgesini geri ver!
Dialogue: 0,0:05:56.82,0:05:58.32,Main,Sanji,0,0,0,,{\fad(150,150)}Extra Hachis!
Dialogue: 0,0:05:56.82,0:05:58.32,Note,Note,0,0,0,,{\fad(150,150)}Fazladan Kıyma/Doğrama!
Dialogue: 0,0:05:58.32,0:05:59.71,Main,Moria,0,0,0,,{\fad(150,150)}Briket Yarasa!
Dialogue: 0,0:06:04.28,0:06:06.61,Main,Sanji,0,0,0,,Yine mi gölgesiyle değişiyor?
Dialogue: 0,0:06:10.62,0:06:13.29,Main,Nami,0,0,0,,Ama değiştiyse bunun anlamı...
Dialogue: 0,0:06:13.29,0:06:17.52,Main,Nami,0,0,0,,Moria, Oz'un midesine geri döndü!
Dialogue: 0,0:06:19.54,0:06:22.30,Main,Moria,0,0,0,,Her şey başladığımız yere dönmüş gibi!
Dialogue: 0,0:06:22.30,0:06:25.40,Main,Oz,0,0,0,,Lanet olası Efendi!
Dialogue: 0,0:06:25.40,0:06:28.30,Main,Oz,0,0,0,,Bunun benim dövüşüm olduğunu söyledim!
Dialogue: 0,0:06:28.30,0:06:30.02,Main,Moria,0,0,0,,Üzgünüm, Oz.
Dialogue: 0,0:06:30.02,0:06:32.24,Main,Moria,0,0,0,,Aksiyonun birazını çaldım.
Dialogue: 0,0:06:32.24,0:06:36.34,Main,Oz,0,0,0,,Şimdi o kadının işini bitireceğim!
Dialogue: 0,0:06:37.57,0:06:40.46,Main,Oz,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:06:42.22,0:06:43.97,Main,Usopp,0,0,0,,Kahretsin, şimdi tekrar uzayabilir!
Dialogue: 0,0:06:43.97,0:06:45.13,Main,Nami,0,0,0,,Olamaz!
Dialogue: 0,0:06:45.13,0:06:46.75,Main,Nami,0,0,0,,Robin kendinde değilken mi saldıracak?!
Dialogue: 0,0:06:49.89,0:06:52.96,Main,Usopp,0,0,0,,Sanji! Robin! Kaçın!
Dialogue: 0,0:06:53.15,0:06:55.28,Main,Oz,0,0,0,,{\fad(150,150)}...Bazuka!
Dialogue: 0,0:06:55.55,0:06:57.13,Main,Sanji,0,0,0,,{\fad(150,150)}Şeytan Bacak!
Dialogue: 0,0:06:58.08,0:06:59.92,Main,Sanji,0,0,0,,{\fad(150,150)}Frit Assorti!
Dialogue: 0,0:06:58.08,0:06:59.92,Note,Note,0,0,0,,{\fad(150,150)}Kızarmış Tasnif!
Dialogue: 0,0:07:08.80,0:07:10.24,Main,Usopp,0,0,0,,Oooh! Yönünü değiştirdi!
Dialogue: 0,0:07:16.14,0:07:17.70,Main,Sanji,0,0,0,,Şu anda fırsatımız var.
Dialogue: 0,0:07:17.70,0:07:19.52,Main,Sanji,0,0,0,,Robin-chan'ı buradan çıkarın!
Dialogue: 0,0:07:19.52,0:07:20.65,Main,Usopp,0,0,0,,Bana bırak!
Dialogue: 0,0:07:22.09,0:07:23.47,Main,Chopper,0,0,0,,Hey!
Dialogue: 0,0:07:23.47,0:07:24.71,Main,Chopper,0,0,0,,Sanji!
Dialogue: 0,0:07:24.71,0:07:25.66,Main,Chopper,0,0,0,,Zoro!
Dialogue: 0,0:07:28.86,0:07:31.56,Main,Sanji,0,0,0,,Chopper?! Orada ne yapıyorsun?!
Dialogue: 0,0:07:31.56,0:07:35.40,Main,Chopper,0,0,0,,Oz'un 500 yıl önce ölmesinin sebebini araştırıyordum!
Dialogue: 0,0:07:36.82,0:07:37.87,Main,Zoro,0,0,0,,Ölüm sebebi?
Dialogue: 0,0:07:37.87,0:07:39.65,Main,Chopper,0,0,0,,Sağ koluna nişan alın!
Dialogue: 0,0:07:39.65,0:07:42.24,Main,Chopper,0,0,0,,Bu, Oz'un asıl kolu değil!
Dialogue: 0,0:07:42.73,0:07:48.01,Main,Chopper,0,0,0,,Hogback tarafından iyice düzeltilmiş ama\Neklemler, sert soğuk yanığı işaretleri gösteriyor!
Dialogue: 0,0:07:48.01,0:07:50.06,Main,Chopper,0,0,0,,Emin olamıyorum ama...
Dialogue: 0,0:07:50.06,0:07:53.72,Main,Chopper,0,0,0,,...tahminim 500 yıl önce aşırı soğuktan ölmüş!
Dialogue: 0,0:07:54.53,0:07:58.05,Main,Chopper,0,0,0,,Böyle bir canavar bile doğanın güçlerine denk değildir.
Dialogue: 0,0:07:58.05,0:08:01.03,Main,Chopper,0,0,0,,Buz ülkesinde gezinirken ölmüş!
Dialogue: 0,0:08:01.03,0:08:05.06,Main,Chopper,0,0,0,,Sebebiyse, aynı şimdi olduğu gibi 500 yıl önce de...
Dialogue: 0,0:08:05.06,0:08:07.22,Main,Chopper,0,0,0,,...tamamen çıplaktı!
Dialogue: 0,0:08:07.92,0:08:10.27,Main,Both,0,0,0,,Öyle bir aptala yenilmek istemiyorum!
Dialogue: 0,0:08:10.83,0:08:14.85,Main,Chopper,0,0,0,,Zombilerin acı hissetmediği doğru ama yine de zarar görebilirler.
Dialogue: 0,0:08:14.85,0:08:17.84,Main,Chopper,0,0,0,,Tüm eski yaraları orjinal haliyle korunmuş!
Dialogue: 0,0:08:18.24,0:08:22.81,Main,Chopper,0,0,0,,Bu kolunu kullanmasını engelleyebilirsek,\Nsaldırı gücü ikiye bölünecek!
Dialogue: 0,0:08:22.81,0:08:24.62,Main,Chopper,0,0,0,,Yani bu noktaya nişan alın.
Dialogue: 0,0:08:24.62,0:08:30.15,Main,Oz,0,0,0,,Omzumda durmuş neler saçmalıyorsun?!
Dialogue: 0,0:08:32.81,0:08:33.99,Main,Zoro,0,0,0,,Chopper!
Dialogue: 0,0:08:39.38,0:08:45.54,Main,Chopper,0,0,0,,Attığın yumruk bedenini yaraladı. Ama zombi olduğun için farketmedin!
Dialogue: 0,0:08:47.82,0:08:49.41,Main,Oz,0,0,0,,Elimde mi?
Dialogue: 0,0:08:49.41,0:08:54.67,Main,Chopper,0,0,0,,Epey küçük olduğum için, yumruğunun\Niçi gezinebileceğim mağaralarla dolu!
Dialogue: 0,0:08:54.67,0:08:55.53,Main,Chopper,0,0,0,,{\fad(150,150)}Gümbürtü!
Dialogue: 0,0:08:56.15,0:08:57.17,Main,Chopper,0,0,0,,{\fad(150,150)}Zıplama Noktası!
Dialogue: 0,0:08:57.77,0:08:59.47,Main,Chopper,0,0,0,,{\fad(150,150)}Kol Noktası!
Dialogue: 0,0:09:00.25,0:09:01.40,Main,Sanji,0,0,0,,Chopper!
Dialogue: 0,0:09:02.03,0:09:04.42,Main,Sanji,0,0,0,,İyi atlatıştı, sana yardım edeceğim!
Dialogue: 0,0:09:04.42,0:09:06.21,Main,Chopper,0,0,0,,Sanji, sana güveniyorum!
Dialogue: 0,0:09:09.79,0:09:11.60,Main,Sanji,0,0,0,,{\fad(150,150)}Armée de l'Air...
Dialogue: 0,0:09:09.79,0:09:11.60,Note,Note,0,0,0,,{\fad(150,150)}Hava Kuvvetleri!
Dialogue: 0,0:09:12.98,0:09:14.52,Main,Chopper,0,0,0,,{\fad(150,150)}Kokutei...
Dialogue: 0,0:09:15.09,0:09:16.87,Main,Both,0,0,0,,{\fad(150,150)}Roseo Shoot!
Dialogue: 0,0:09:12.98,0:09:16.87,Note,,0,0,0,,{\fad(150,150)}Gül Renkli Yarık Toynak Vuruşu!
Dialogue: 0,0:09:23.86,0:09:26.41,Main,Oz,0,0,0,,Pislik!
Dialogue: 0,0:09:26.86,0:09:31.32,Main,Oz,0,0,0,,Tekrar tekrar aynı noktaya saldırıyorsun!
Dialogue: 0,0:09:31.32,0:09:34.39,Main,Oz,0,0,0,,Bir kez işe yaramıyorsa, asla yaramayacak!
Dialogue: 0,0:09:34.39,0:09:35.77,Main,Chopper,0,0,0,,Çok da iyi işe yarayacak!
Dialogue: 0,0:09:35.77,0:09:38.54,Main,Chopper,0,0,0,,Acı, vücudu korumak için gönderilen sinyaldir.
Dialogue: 0,0:09:38.54,0:09:41.59,Main,Chopper,0,0,0,,Bunu hissetmemek seni daha güçlü yapan bir şey değil!
Dialogue: 0,0:09:41.59,0:09:44.83,Main,Oz,0,0,0,,Ah, kapa çeneni!
Dialogue: 0,0:09:44.83,0:09:46.57,Main,Zoro,0,0,0,,Hey! Dikkat edin!
Dialogue: 0,0:09:46.57,0:09:47.47,Main,Zoro,0,0,0,,Oradan uzaklaşmalısınız!
Dialogue: 0,0:09:47.63,0:09:51.04,Main,Oz,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:09:51.82,0:09:53.24,Main,Sanji,0,0,0,,Eyvah!
Dialogue: 0,0:09:53.24,0:09:54.89,Main,Chopper,0,0,0,,Olamaz!
Dialogue: 0,0:09:55.76,0:09:58.42,Main,Oz,0,0,0,,{\fad(150,150)}...Makineli!
Dialogue: 0,0:10:01.90,0:10:02.57,Main,Usopp,0,0,0,,Sanji!
Dialogue: 0,0:10:02.57,0:10:03.98,Main,Usopp,0,0,0,,Chopper!
Dialogue: 0,0:10:19.15,0:10:21.60,Main,Nami,0,0,0,,İkisi daha gitti.
Dialogue: 0,0:10:22.25,0:10:25.80,Main,Nami,0,0,0,,Birer birer düşüyoruz.
Dialogue: 0,0:10:25.80,0:10:27.36,Main,Usopp,0,0,0,,Lanet olsun!
Dialogue: 0,0:10:31.44,0:10:34.45,Main,Moria,0,0,0,,Dört ve beş numara!
Dialogue: 0,0:10:35.08,0:10:38.12,Main,Moria,0,0,0,,Sadece üçü kaldı!
Dialogue: 0,0:10:42.02,0:10:45.02,Main,Oz,0,0,0,,Demek sadece üçü kaldı!
Dialogue: 0,0:10:49.83,0:10:54.20,Main,Moria,0,0,0,,Şimdi, git ve onları dümdüz et, Oz!
Dialogue: 0,0:10:55.41,0:10:57.27,Main,Usopp,0,0,0,,Geliyor!
Dialogue: 0,0:11:01.69,0:11:02.78,Main,Nami,0,0,0,,İmkansız!
Dialogue: 0,0:11:02.78,0:11:05.38,Main,Nami,0,0,0,,Bu canavarı yenebilmemiz mümkün değil!
Dialogue: 0,0:11:05.38,0:11:07.58,Main,Usopp,0,0,0,,Hiç şansımız yok!
Dialogue: 0,0:11:07.58,0:11:08.65,Main,Usopp,0,0,0,,Ne yapacağız?!
Dialogue: 0,0:11:09.78,0:11:10.58,Main,Zoro,0,0,0,,Usopp!
Dialogue: 0,0:11:11.37,0:11:13.12,Main,Zoro,0,0,0,,Sana bir açık vereceğim.
Dialogue: 0,0:11:14.21,0:11:15.07,Main,Usopp,0,0,0,,Ah, anlıyorum!
Dialogue: 0,0:11:15.07,0:11:16.79,Main,Usopp,0,0,0,,Demek kastettiği bu!
Dialogue: 0,0:11:16.79,0:11:18.40,Main,Usopp,0,0,0,,Yapacağım!
Dialogue: 0,0:11:18.40,0:11:20.66,Main,Nami,0,0,0,,Eh? Ne yapacaksın, Usopp?!
Dialogue: 0,0:11:21.01,0:11:23.66,Main,Oz,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:11:24.38,0:11:26.82,Main,Oz,0,0,0,,{\fad(150,150)}...Tabanca!
Dialogue: 0,0:11:29.66,0:11:31.14,Main,Oars,0,0,0,,Lanet olsun!
Dialogue: 0,0:11:30.66,0:11:31.87,Secondary,Zoro,0,0,0,,{\fad(150,150)}Üç Kılıç Stili...
Dialogue: 0,0:11:34.21,0:11:35.33,Main,Zoro,0,0,0,,{\fad(150,150)}Gece Kargası!
Dialogue: 0,0:11:44.88,0:11:46.68,Main,Nami,0,0,0,,İşe yaradı!
Dialogue: 0,0:11:46.68,0:11:47.82,Main,Zoro,0,0,0,,Usopp! Şimdi!
Dialogue: 0,0:11:47.82,0:11:49.58,Main,Oz,0,0,0,,Yine mi sağ kolum?!
Dialogue: 0,0:11:49.58,0:11:53.36,Main,Oz,0,0,0,,İşe yaramayacağını kaç kez söylemem gerek?!
Dialogue: 0,0:11:56.96,0:11:59.25,Main,Oz,0,0,0,,Kahrolası aptal!
Dialogue: 0,0:11:59.60,0:12:00.80,Thoughts,Zoro,0,0,0,,Kayboldu!
Dialogue: 0,0:12:05.84,0:12:06.72,Main,Nami,0,0,0,,Zoro!
Dialogue: 0,0:12:10.14,0:12:11.38,Main,Usopp,0,0,0,,Hey, Oz!
Dialogue: 0,0:12:12.26,0:12:14.25,Main,Usopp,0,0,0,,Buraya!
Dialogue: 0,0:12:19.22,0:12:21.06,Main,Oz,0,0,0,,Ne?
Dialogue: 0,0:12:21.06,0:12:24.09,Main,Oz,0,0,0,,Ağzıma bir şey girdi.
Dialogue: 0,0:12:24.57,0:12:27.14,Main,Nami,0,0,0,,Usopp, attığın neydi?
Dialogue: 0,0:12:28.85,0:12:29.63,Main,Usopp,0,0,0,,Başardım.
Dialogue: 0,0:12:29.63,0:12:31.53,Main,Usopp,0,0,0,,Başardım!
Dialogue: 0,0:12:31.53,0:12:35.46,Main,Usopp,0,0,0,,Oz'a tuz yutturdum!
Dialogue: 0,0:12:35.46,0:12:36.66,Main,Nami,0,0,0,,Tuz?
Dialogue: 0,0:12:36.66,0:12:38.29,Main,Nami,0,0,0,,Tuza ne olmuş?
Dialogue: 0,0:12:38.29,0:12:40.85,Main,Usopp,0,0,0,,Bilmiyorsun, değil mi?
Dialogue: 0,0:12:40.85,0:12:43.34,Main,Usopp,0,0,0,,Tuz, zombilerin zayıflığıdır!
Dialogue: 0,0:12:43.34,0:12:46.81,Main,Usopp,0,0,0,,Bak! Oz'un işi bitti!
Dialogue: 0,0:12:51.62,0:12:53.42,Main,Usopp,0,0,0,,Luffy'nin gölgesi çıkıyor!
Dialogue: 0,0:12:53.42,0:12:56.25,Main,Usopp,0,0,0,,Arın artık, seni canavar zombi!
Dialogue: 0,0:12:56.25,0:12:59.11,Main,Usopp,0,0,0,,Biz kazandık!
Dialogue: 0,0:12:59.11,0:13:02.09,Main,Usopp,0,0,0,,Hadi!
Dialogue: 0,0:13:18.36,0:13:21.86,Main,Usopp,0,0,0,,Niye Moria'nın gölgesi?
Dialogue: 0,0:13:21.86,0:13:25.15,Main,Moria,0,0,0,,Başından beri bedenini koruyordum!
Dialogue: 0,0:13:26.64,0:13:30.71,Main,Moria,0,0,0,,Ne sersemsin, bu kadar erken seviniyorsun.
Dialogue: 0,0:13:30.71,0:13:36.00,Main,Moria,0,0,0,,Tamamen farkındayken böyle zayıf bir noktayı\Nsaldırıya açık bırakacağımı mı sandın?!
Dialogue: 0,0:13:36.00,0:13:37.56,Main,Moria,0,0,0,,Aptal!
Dialogue: 0,0:13:42.78,0:13:44.34,Main,Usopp,0,0,0,,Kahretsin!
Dialogue: 0,0:13:44.34,0:13:47.57,Main,Moria,0,0,0,,Pisliğini geri al, Uzun Burun!
Dialogue: 0,0:13:47.57,0:13:48.39,Main,Nami,0,0,0,,Usopp!
Dialogue: 0,0:13:56.30,0:13:57.98,Main,Usopp,0,0,0,,Olamaz! Tuz!
Dialogue: 0,0:13:57.98,0:13:59.62,Main,Usopp,0,0,0,,Brook'un topladığı tuz!
Dialogue: 0,0:14:00.12,0:14:01.94,Main,Usopp,0,0,0,,Kahretsin! Kahretsin!
Dialogue: 0,0:14:01.94,0:14:04.22,Main,Usopp,0,0,0,,Bu sonuncusuydu, lanet olsun!
Dialogue: 0,0:14:05.22,0:14:08.23,Main,Oz,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:14:08.40,0:14:10.90,Main,Oz,0,0,0,,{\fad(150,150)}...Damga!
Dialogue: 0,0:14:18.20,0:14:19.07,Main,Nami,0,0,0,,Usopp!
Dialogue: 0,0:14:21.10,0:14:21.97,Main,Nami,0,0,0,,USOPP!
Dialogue: 0,0:14:24.20,0:14:24.81,Main,Nami,0,0,0,,Kes şunu!
Dialogue: 0,0:14:24.81,0:14:25.73,Main,Nami,0,0,0,,Kes şunu!!
Dialogue: 0,0:14:25.73,0:14:26.72,Main,Nami,0,0,0,,Usopp!
Dialogue: 0,0:14:26.72,0:14:28.37,Main,Nami,0,0,0,,USOPP!
Dialogue: 0,0:14:29.10,0:14:30.60,Main,Nami,0,0,0,,Kes şunu!
Dialogue: 0,0:14:33.23,0:14:34.47,Main,Moria,0,0,0,,Daha değil!
Dialogue: 0,0:14:34.47,0:14:36.05,Main,Moria,0,0,0,,Onu lapaya çevir!
Dialogue: 0,0:14:36.05,0:14:38.07,Main,Moria,0,0,0,,O kadını da!
Dialogue: 0,0:14:46.51,0:14:48.63,Main,Moria,0,0,0,,Ez onları! Ez onları!
Dialogue: 0,0:14:49.13,0:14:52.17,Main,Moria,0,0,0,,Her birini ez!
Dialogue: 0,0:14:52.17,0:14:55.87,Main,Moria,0,0,0,,Düşenleri de ez!
Dialogue: 0,0:14:55.87,0:14:59.13,Main,Moria,0,0,0,,Hala nefes alıyorlar!
Dialogue: 0,0:14:59.13,0:15:03.68,Main,Moria,0,0,0,,Sıvılaşana dek ez onları!
Dialogue: 0,0:15:12.46,0:15:14.06,Main,Luffy,0,0,0,,Hey, koca adam.
Dialogue: 0,0:15:15.49,0:15:20.46,Main,Luffy,0,0,0,,Tam olarak ne eziyorsun sen?
Dialogue: 0,0:15:24.74,0:15:29.50,Main,Luffy,0,0,0,,Ayağının altında bir şey yok.
Dialogue: 0,0:15:29.50,0:15:31.81,Main,Oz,0,0,0,,Sen de kimsin?
Dialogue: 0,0:15:34.21,0:15:35.73,Main,Usopp,0,0,0,,Ha? Ha?
Dialogue: 0,0:15:36.91,0:15:39.02,Main,Usopp,0,0,0,,Kurtulduk.
Dialogue: 0,0:15:41.25,0:15:44.57,Main,Usopp,0,0,0,,Bu koca adam kim bilmiyorum\Nama neredeyse işimiz bitmişti.
Dialogue: 0,0:15:45.11,0:15:46.09,Main,Nami,0,0,0,,Olamaz!
Dialogue: 0,0:15:48.43,0:15:51.23,Main,Luffy,0,0,0,,Monkey D. Luffy!
Dialogue: 0,0:15:54.63,0:15:55.48,Main,Usopp,0,0,0,,L-Lu{\fscx250}-{\r}
Dialogue: 0,0:15:55.48,0:15:56.58,Main,Nami,0,0,0,,Lu{\fscx250}-{\r}
Dialogue: 0,0:15:57.25,0:15:59.50,Main,Both,0,0,0,,Luffy!?
Dialogue: 0,0:15:59.50,0:16:02.28,Main,Usopp,0,0,0,,Nasıl olur?!
Dialogue: 0,0:16:02.87,0:16:05.58,Main,Usopp,0,0,0,,G-Gerçi biraz ona benziyor!
Dialogue: 0,0:16:05.58,0:16:07.01,Main,Usopp,0,0,0,,Doğru mu?
Dialogue: 0,0:16:07.01,0:16:08.58,Main,Usopp,0,0,0,,Gerçekten o musun?
Dialogue: 0,0:16:08.58,0:16:11.28,Main,Luffy,0,0,0,,Gerçekten benim.
Dialogue: 0,0:16:11.28,0:16:13.32,Main,Usopp,0,0,0,,Hayır, dur. Sadece sözün yetmez.
Dialogue: 0,0:16:13.32,0:16:15.79,Main,Usopp,0,0,0,,S-Sana ne oldu?
Dialogue: 0,0:16:15.79,0:16:21.37,Main,Moria,0,0,0,,Tuhaf bir dönüşüm yeteneği falan mı var?
Dialogue: 0,0:16:21.37,0:16:22.79,Main,Moria,0,0,0,,Yoksa...
Dialogue: 0,0:16:24.92,0:16:28.46,Main,Luffy,0,0,0,,Yani herkes yenildi mi?
Dialogue: 0,0:16:28.46,0:16:29.47,Main,Usopp,0,0,0,,E-Evet.
Dialogue: 0,0:16:30.15,0:16:34.18,Main,Usopp,0,0,0,,O canavar tarafından ağır şekilde yaralandılar.
Dialogue: 0,0:16:34.18,0:16:35.25,Main,Luffy,0,0,0,,Anlıyorum.
Dialogue: 0,0:16:35.91,0:16:37.17,Main,Luffy,0,0,0,,Geri durun.
Dialogue: 0,0:16:37.17,0:16:38.84,Main,Usopp,0,0,0,,Geri mi duralım?!
Dialogue: 0,0:16:38.84,0:16:40.62,Main,Usopp,0,0,0,,Anlamıyor musun, Luffy?!
Dialogue: 0,0:16:40.62,0:16:43.50,Main,Usopp,0,0,0,,O zombide senin gölgen var!
Dialogue: 0,0:16:43.50,0:16:47.50,Main,Usopp,0,0,0,,Bedeni seninkinden daha güçlü!
Dialogue: 0,0:16:48.32,0:16:49.46,Main,Moria,0,0,0,,Önemli değil!
Dialogue: 0,0:16:49.46,0:16:51.22,Main,Moria,0,0,0,,Ez onları, Oz!
Dialogue: 0,0:16:51.22,0:16:53.35,Main,Oz,0,0,0,,Elbette!
Dialogue: 0,0:16:53.35,0:16:56.93,Main,Oz,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:17:01.65,0:17:02.42,Main,Usopp,0,0,0,,Geliyor!
Dialogue: 0,0:17:02.40,0:17:04.17,Main,Oz,0,0,0,,{\fad(150,150)}...Tüfek!
Dialogue: 0,0:17:15.60,0:17:17.68,Main,Luffy,0,0,0,,Luffy...
Dialogue: 0,0:17:17.68,0:17:20.02,Main,Luffy,0,0,0,,...sadece benim!
Dialogue: 0,0:17:26.02,0:17:27.62,Main,Zombie,0,0,0,,Bu tarafa bir şey uçuyor!
Dialogue: 0,0:17:27.62,0:17:28.36,Main,Zombie,0,0,0,,O da ne?!
Dialogue: 0,0:17:28.36,0:17:29.26,Main,Zombie,0,0,0,,Kuş mu?!
Dialogue: 0,0:17:30.04,0:17:32.26,Main,Zombie,0,0,0,,Şaka olmalı!
Dialogue: 0,0:17:32.26,0:17:34.73,Main,Zombie,0,0,0,,Bu, Oz!
Dialogue: 0,0:17:58.37,0:17:59.69,Main,Oz,0,0,0,,Ne?
Dialogue: 0,0:18:10.40,0:18:12.52,Main,Pirate,0,0,0,,Başardı!
Dialogue: 0,0:18:12.52,0:18:14.41,Main,Pirate,0,0,0,,Oz'u devirdi!
Dialogue: 0,0:18:14.83,0:18:16.81,Main,Pirate,0,0,0,,Şimdi fırsat bizde! Bulalım onları!
Dialogue: 0,0:18:17.39,0:18:18.58,Main,Pirate,0,0,0,,H-Hey!
Dialogue: 0,0:18:18.58,0:18:21.55,Main,Pirate,0,0,0,,İşte oradalar! Mucize tayfamız!
Dialogue: 0,0:18:21.95,0:18:23.51,Main,Pirate,0,0,0,,Burada da!
Dialogue: 0,0:18:23.51,0:18:25.62,Main,Pirate,0,0,0,,Ah, ne korkunç yaralar.
Dialogue: 0,0:18:26.34,0:18:28.32,Main,Pirate,0,0,0,,Herkes kötü biçimde yaralanmış!
Dialogue: 0,0:18:28.70,0:18:30.74,Main,Pirate,0,0,0,,Bunun sadece kemikleri kalmış!
Dialogue: 0,0:18:31.79,0:18:33.92,Main,Lola,0,0,0,,Onları burada bırakmak çok tehlikeli.
Dialogue: 0,0:18:33.92,0:18:35.76,Main,Lola,0,0,0,,Hemen güvenli bir yere götürün onları!
Dialogue: 0,0:18:36.47,0:18:38.01,Main,Usopp,0,0,0,,Neler oluyor?
Dialogue: 0,0:18:38.01,0:18:40.00,Main,Usopp,0,0,0,,O insanlar...
Dialogue: 0,0:18:40.00,0:18:41.62,Main,Nami,0,0,0,,Zombiler mi?
Dialogue: 0,0:18:41.62,0:18:44.09,Main,Usopp,0,0,0,,Zoro-gil'i götürüyorlar mı?
Dialogue: 0,0:18:44.09,0:18:45.69,Main,Nami,0,0,0,,Hemen durduralım onları!
Dialogue: 0,0:18:46.90,0:18:48.21,Main,Zombie,0,0,0,,Hey, hey!
Dialogue: 0,0:18:48.21,0:18:49.82,Main,Zombie,0,0,0,,Burada neler oluyor?!
Dialogue: 0,0:18:50.74,0:18:52.75,Main,Zombie,0,0,0,,Oz dövülüyor!
Dialogue: 0,0:18:52.75,0:18:54.98,Main,Zombie,0,0,0,,Onu böylesine uçurmak...
Dialogue: 0,0:19:00.69,0:19:04.67,Main,Moria,0,0,0,,Neyin var senin?! Hey, Oz!
Dialogue: 0,0:19:06.71,0:19:09.41,Main,Zombie,0,0,0,,Hey, duydunuz mu?!
Dialogue: 0,0:19:09.41,0:19:14.43,Main,Zombie,0,0,0,,Moria-sama, şu anda Oz'un midesinde!
Dialogue: 0,0:19:14.43,0:19:22.81,Main,Zombie,0,0,0,,Yani Thriller Bark'ın büyük Gölgeler Hükümdarı, Özel Zombi'nin yardımıyla bile dövülüyor mu?!
Dialogue: 0,0:19:23.59,0:19:26.28,Main,Zombie,0,0,0,,Bu ne biçim bir şaka böyle?!
Dialogue: 0,0:19:27.38,0:19:32.20,Main,Zombie,0,0,0,,Oz, 500 yıl önceki efsanevi bir şeytan!
Dialogue: 0,0:19:32.20,0:19:36.92,Main,Zombie,0,0,0,,Efendimiz, Kral Shichibukailer'den biri, Lord Gecko Moria!
Dialogue: 0,0:19:47.16,0:19:48.97,Main,Usopp,0,0,0,,Ne dediniz?!
Dialogue: 0,0:19:48.97,0:19:55.64,Main,Usopp,0,0,0,,Yani Luffy'nin bedenine 100 gölge mi soktunuz?!
Dialogue: 0,0:19:55.64,0:19:58.67,Main,Lola,0,0,0,,Aynen öyle! Mucize tayfamızın değerli üyeleri!
Dialogue: 0,0:19:58.67,0:20:02.23,Main,Pirate,0,0,0,,Açıkçası onun güç artışından biz bile korktuk!
Dialogue: 0,0:20:02.23,0:20:06.20,Main,Pirate,0,0,0,,Ama güç, 2 veya 3 dakika daha sürecek!
Dialogue: 0,0:20:06.20,0:20:09.87,Main,Pirate,0,0,0,,Daha sonra gölgeler onun bedenini terkedecek!
Dialogue: 0,0:20:09.87,0:20:12.86,Main,Pirate,0,0,0,,Kaptanınızın rızası olmadan bunu yaptığımız için üzgünüz.
Dialogue: 0,0:20:13.38,0:20:18.83,Main,Pirate,0,0,0,,Sadece güneş ışığı altında yaşayabilen normal insanlar olmak istiyoruz!
Dialogue: 0,0:20:18.83,0:20:21.15,Main,Pirate,0,0,0,,O bizim tek umudumuz!
Dialogue: 0,0:20:22.38,0:20:24.22,Main,Lola,0,0,0,,Neredeyse sabah olacak.
Dialogue: 0,0:20:24.22,0:20:28.21,Main,Lola,0,0,0,,Bu adanın kurbanlarının kaderini\Nşu birkaç dakika belirleyecek!
Dialogue: 0,0:20:28.80,0:20:32.58,Main,Lola,0,0,0,,Sana güveniyoruz, Kâbus Luffy!
Dialogue: 0,0:20:48.39,0:20:50.49,Main,Pirate,0,0,0,,Tüm binayı ezdi!
Dialogue: 0,0:20:50.49,0:20:52.90,Main,Pirate,0,0,0,,Hemen buradan çıkın yoksa biz de ezileceğiz!
Dialogue: 0,0:20:56.15,0:20:57.65,Main,Nami,0,0,0,,Bu gerçekten inanılmaz!
Dialogue: 0,0:20:57.65,0:20:59.09,Main,Usopp,0,0,0,,Tamam!
Dialogue: 0,0:20:59.09,0:21:01.24,Main,Usopp,0,0,0,,İşte böyle yapılır, Luffy!
Dialogue: 0,0:21:11.91,0:21:13.83,Main,Oz,0,0,0,,Pislik!
Dialogue: 0,0:21:13.83,0:21:16.62,Main,Oz,0,0,0,,Hem de bücür olmana rağmen!
Dialogue: 0,0:21:16.62,0:21:19.30,Main,Oz,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:21:19.64,0:21:23.06,Main,Oz,0,0,0,,{\fad(150,150)}...Mermi!
Dialogue: 0,0:21:31.67,0:21:34.33,Main,Moria,0,0,0,,Oz, şaka yapıyor olmalısın!
Dialogue: 0,0:21:34.33,0:21:37.52,Main,Moria,0,0,0,,Hasır Şapka bu gücü nereden aldı?!
Dialogue: 0,0:21:37.52,0:21:38.73,Main,Moria,0,0,0,,Kahretsin!
Dialogue: 0,0:21:38.73,0:21:41.15,Main,Moria,0,0,0,,Bu korkunç!
Dialogue: 0,0:21:41.15,0:21:43.75,Main,Moria,0,0,0,,Bir süreliğine kokpitten çıkmalıyım.
Dialogue: 0,0:21:43.83,0:21:45.75,Main,Luffy,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:21:47.32,0:21:49.26,Main,Luffy,0,0,0,,{\fad(150,150)}...Tabanca!
Dialogue: 0,0:22:00.70,0:22:03.27,Main,Oz,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:22:08.81,0:22:10.07,Main,Oz,0,0,0,,{\fad(150,150)}...Balta!
Dialogue: 0,0:22:14.55,0:22:16.65,Main,Luffy,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:22:18.44,0:22:20.79,Main,Luffy,0,0,0,,{\fad(150,150)}...Fırtına!
Dialogue: 0,0:22:33.38,0:22:34.60,Main,Zombie,0,0,0,,Oz...
Dialogue: 0,0:22:34.60,0:22:36.82,Main,Zombie,0,0,0,,Moria-sama!
Dialogue: 0,0:22:47.44,0:22:50.28,Main,Pirate,0,0,0,,Düşüyor! Dikkat edin!
Dialogue: 0,0:23:18.77,0:23:21.46,Main,Nami,0,0,0,,Gölgeler onu terkediyor.
Dialogue: 0,0:23:21.46,0:23:23.88,Main,Usopp,0,0,0,,Hey, Luffy iyi olacak mı?
Dialogue: 0,0:23:31.79,0:23:32.94,Main,Nami,0,0,0,,Luffy!
Dialogue: 0,0:23:32.94,0:23:34.09,Main,Usopp,0,0,0,,Hey, iyi misin?!
Dialogue: 0,0:23:35.18,0:23:37.36,Main,Pirate,0,0,0,,Bu rüya değil, değil mi?!
Dialogue: 0,0:23:37.36,0:23:39.56,Main,Pirate,0,0,0,,Kazandı!
Dialogue: 0,0:23:39.56,0:23:43.32,Main,Lola,0,0,0,,O, bizim umut ışığımızdı!
Dialogue: 0,0:23:44.65,0:23:47.48,Main,Pirate,0,0,0,,Oz ve Moria yenildi!
Dialogue: 0,0:23:47.48,0:23:50.29,Main,Pirate,0,0,0,,Herkesin gölgesi geri dönecek!
Dialogue: 0,0:23:50.82,0:23:52.58,Main,Pirate,0,0,0,,Thriller Bark...
Dialogue: 0,0:23:53.34,0:23:57.18,Main,Pirate,0,0,0,,...düştü!
