Dialogue: 0,0:13:25.00,0:13:35.00,Author,,0,0,0,,{\fad(500,500)\fs20} Türkçeleştirme {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&}
Dialogue: 0,0:02:29.93,0:02:39.93,Author,,0,0,0,,{\fad(500,500)\fs20} Türkçeleştirme {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&}
Dialogue: 0,0:02:29.93,0:02:38.50,Title,,0,0,0,,{\fad(2000,2000)}General Zombilerin Gecesi ve\NThriller Bark'ın Gizemli Dörtlüsü
Dialogue: 0,0:02:39.31,0:02:40.44,Main,All,0,0,0,,Shichibukai?
Dialogue: 0,0:02:40.75,0:02:42.15,Main,Luffy,0,0,0,,Bu doğru mu, Robin?!
Dialogue: 0,0:02:42.15,0:02:46.45,Main,Robin,0,0,0,,Evet. Gecko Moria, gizemlerle dolu bir adam.
Dialogue: 0,0:02:47.01,0:02:51.01,Main,Franky,0,0,0,,Öyle bir adam burada ne yapıyor?
Dialogue: 0,0:02:51.01,0:02:53.01,Main,Old Man,0,0,0,,Emin değilim.
Dialogue: 0,0:02:53.01,0:02:59.30,Main,Old Man,0,0,0,,Ama benim gibi ormanda kaybolmuş başka kurbanlar da var.
Dialogue: 0,0:02:59.30,0:03:00.54,Main,Sanji,0,0,0,,Başkaları da mı var?
Dialogue: 0,0:03:00.54,0:03:01.83,Main,Old man,0,0,0,,Evet.
Dialogue: 0,0:03:01.83,0:03:07.22,Main,Old Man,0,0,0,,Hepiniz buraya davet edilmiş olduğunuza\Ngöre, Moria'nın sizde gözü var.
Dialogue: 0,0:03:11.35,0:03:16.51,Main,Old Man,0,0,0,,Bu karanlık ormanda zombiler tarafından\Nyakalanmamak için sessizce dolanıyoruz.
Dialogue: 0,0:03:17.77,0:03:21.77,Main,Old Man,0,0,0,,Denize koşup, kendimizi güneş ışığına\Nmaruz bırakamayacak kadar korkuyoruz!
Dialogue: 0,0:03:21.77,0:03:27.40,Main,Old Man,0,0,0,,Bu yaşlı bedenin artık yaşamak isteyecek gücü bile yok.
Dialogue: 0,0:03:27.40,0:03:30.45,Main,Old Man,0,0,0,,Ölmeden önce bir kez olsun...
Dialogue: 0,0:03:30.45,0:03:32.38,Main,Old Man,0,0,0,,Sadece bir kez olsun...
Dialogue: 0,0:03:32.38,0:03:35.50,Main,Old Man,0,0,0,,...güneş altında yürümek istiyorum!
Dialogue: 0,0:03:43.22,0:03:47.02,Main,Franky,0,0,0,,Bu doğru mu?! Çok korkunç!
Dialogue: 0,0:03:47.02,0:03:51.31,Main,Franky,0,0,0,,Tamam! Size yardım edeceğim! Hiç endişelenmeyin!
Dialogue: 0,0:03:51.31,0:03:54.26,Main,Franky,0,0,0,,Aptal, ağlamıyorum!
Dialogue: 0,0:03:54.26,0:03:58.70,Main,Zoro,0,0,0,,Çok merhametlisin! Bu yükün altında ezilme.
Dialogue: 0,0:03:58.70,0:03:59.69,Main,Sanji,0,0,0,,Cidden.
Dialogue: 0,0:04:01.03,0:04:02.95,Main,Sanji,0,0,0,,Hey, bunak herif!
Dialogue: 0,0:04:02.95,0:04:06.16,Main,Sanji,0,0,0,,Sempati için ağlamak, bir bayanın ayrıcalığıdır!
Dialogue: 0,0:04:06.16,0:04:07.83,Main,Sanji,0,0,0,,Kendini fazla kaptırma!
Dialogue: 0,0:04:09.48,0:04:11.14,Main,Luffy,0,0,0,,Neyse, yine de...
Dialogue: 0,0:04:11.14,0:04:15.96,Main,Luffy,0,0,0,,...zaten gölge çalan adamı arıyorduk, bu yüzden...
Dialogue: 0,0:04:15.96,0:04:23.18,Main,Luffy,0,0,0,,...peşimizdeyse canına okuruz. \NNiye bu arada seni de kurtarmayalım amca?
Dialogue: 0,0:04:23.52,0:04:25.05,Main,Luffy,0,0,0,,Değil mi?
Dialogue: 0,0:04:25.88,0:04:30.73,Main,Old Man,0,0,0,,Öyle dediğin için sağol! Sadece biraz ama nasılsa yine umut hissedebiliyorum!
Dialogue: 0,0:04:31.14,0:04:32.75,Main,Others,0,0,0,,Size güveniyoruz!
Dialogue: 0,0:04:32.75,0:04:33.56,Main,Others,0,0,0,,Elinizden geleni yapın!
Dialogue: 0,0:04:33.56,0:04:36.00,Main,Others,0,0,0,,Moria'yı yenin!
Dialogue: 0,0:04:36.00,0:04:39.90,Main,Sanji,0,0,0,,Dinliyor muydunuz? Diğer kurbanlar!
Dialogue: 0,0:04:39.90,0:04:40.86,Main,Others,0,0,0,,Evet.
Dialogue: 0,0:04:40.86,0:04:43.91,Main,Others,0,0,0,,Üzgünüm, ağlarken kendimi kaptırdım!
Dialogue: 0,0:04:44.25,0:04:48.20,Captions,Sign,0,0,220,,{\fad(400,0)}Hogback'in Malikânesi\NUsopp-giller
Dialogue: 0,0:04:51.22,0:04:53.25,Main,Chopper,0,0,0,,Hogback'in gülüşü!
Dialogue: 0,0:04:55.92,0:04:58.20,Main,Nami,0,0,0,,Bu oda da ne böyle?
Dialogue: 0,0:04:58.20,0:05:00.26,Main,Chopper,0,0,0,,Laboratuvar!
Dialogue: 0,0:05:04.53,0:05:07.09,Main,Hogback,0,0,0,,Neredeyse tamamlandı!
Dialogue: 0,0:05:08.23,0:05:10.38,Main,Hogback,0,0,0,,Harikulade kuklam!
Dialogue: 0,0:05:13.87,0:05:16.34,Main,Hogback,0,0,0,,Bak, Cindry-chan!
Dialogue: 0,0:05:16.34,0:05:19.15,Main,Hogback,0,0,0,,Bu bir sanat, bir dahinin işi!
Dialogue: 0,0:05:19.15,0:05:22.09,Main,Cindry,0,0,0,,Umarım neredeyse tamamlandığında başarısız olur.
Dialogue: 0,0:05:22.65,0:05:26.34,Main,Hogback,0,0,0,,Ne diyorsun, Cindry-chan?!
Dialogue: 0,0:05:26.34,0:05:30.57,Main,Hogback,0,0,0,,Hissettiklerini çekinmeden söylüyorsun!
Dialogue: 0,0:05:30.57,0:05:32.58,Main,Cindry,0,0,0,,Yemek hazırladım.
Dialogue: 0,0:05:32.58,0:05:34.94,Main,Hogback,0,0,0,,Sahi, bu akşam ne var?
Dialogue: 0,0:05:34.94,0:05:37.29,Main,Cindry,0,0,0,,Spagetti çorbası.
Dialogue: 0,0:05:39.12,0:05:42.37,Main,Hogback,0,0,0,,Dikkat et, çorba dökülüyor, Cindry-chan!
Dialogue: 0,0:05:42.37,0:05:44.39,Main,Cindry,0,0,0,,Tabakların neslinin tükenmesini isterdim.
Dialogue: 0,0:05:44.39,0:05:46.28,Main,Hogback,0,0,0,,Biliyorum!
Dialogue: 0,0:05:46.28,0:05:49.85,Main,Hogback,0,0,0,,Ama niye tabak gerektiren yiyecekleri seçiyorsun?!
Dialogue: 0,0:05:49.85,0:05:52.48,Main,Hogback,0,0,0,,Yapabileceğin başka bir sürü şey var!
Dialogue: 0,0:05:52.48,0:05:55.51,Main,Hogback,0,0,0,,Örneğin *yakisoba veya *yakiudon.
Dialogue: 0,0:05:52.48,0:05:55.51,Note,translation note,0,0,0,,- İki çeşit kızarmış makarna -
Dialogue: 0,0:05:51.75,0:05:53.84,Secondary,Nami,0,0,0,,Cindry-chan da orada.
Dialogue: 0,0:05:55.48,0:05:56.03,Main,Hogback,0,0,0,,Tamam mı?
Dialogue: 0,0:05:56.03,0:05:57.22,Main,Hogback,0,0,0,,Belki de *katsudon veya...
Dialogue: 0,0:05:56.03,0:05:57.22,Note,translation note,0,0,0,,- Pirinç üstü ekmekli domuz eti -
Dialogue: 0,0:05:57.22,0:06:00.45,Main,Nami,0,0,0,,Gerçekten o olayda ölen kızın aynısı mı?
Dialogue: 0,0:06:00.70,0:06:01.82,Main,Nami,0,0,0,,Buna inanamıyorum.
Dialogue: 0,0:06:01.82,0:06:03.91,Main,Hogback,0,0,0,,Artık çorba falan yok!
Dialogue: 0,0:06:03.91,0:06:05.70,Main,Cindry,0,0,0,,Bu spagetti çorbasını mı?
Dialogue: 0,0:06:07.63,0:06:09.76,Main,Usopp,0,0,0,,Masanın üstündeki ne?
Dialogue: 0,0:06:09.76,0:06:11.54,Main,Chopper,0,0,0,,Ceset gibi görünüyor.
Dialogue: 0,0:06:12.18,0:06:15.01,Main,Chopper,0,0,0,,Rengi öyleyse hayatta olması mümkün değil.
Dialogue: 0,0:06:16.23,0:06:19.66,Main,Chopper,0,0,0,,Mezarlıktaki zombiler gibi üstünde numara var!
Dialogue: 0,0:06:19.66,0:06:22.98,Main,Nami,0,0,0,,Neredeyse tamamlandığını söyledi.
Dialogue: 0,0:06:22.98,0:06:25.02,Main,Nami,0,0,0,,Yani bu, onu doğruluyor.
Dialogue: 0,0:06:25.48,0:06:29.39,Main,Nami,0,0,0,,Yeniden canlandırma sürecindeki bir zombi!
Dialogue: 0,0:06:29.39,0:06:34.14,Main,Nami,0,0,0,,Bu adadaki tüm zombiler, \NHogback tarafından hayata döndürülmüş.
Dialogue: 0,0:06:34.14,0:06:36.64,Main,Nami,0,0,0,,Şu anda düşünülebilecek tek şey bu!
Dialogue: 0,0:06:36.64,0:06:40.98,Main,Chopper,0,0,0,,Ama ilaçla insanları sadece ölmeden önce kurtarabilirsin!
Dialogue: 0,0:06:40.98,0:06:44.18,Main,Chopper,0,0,0,,Ölü birinin vücudunu ne kadar dikkatli tedavi etmiş olursan ol,...
Dialogue: 0,0:06:44.18,0:06:46.51,Main,Chopper,0,0,0,,...tekrar yaşamasını sağlayamazsın!
Dialogue: 0,0:06:46.74,0:06:49.33,Main,Usopp,0,0,0,,Ben de anlamıyorum.
Dialogue: 0,0:06:49.33,0:06:54.22,Main,Usopp,0,0,0,,Ama burada kalıp izlersek, belki sırrını çözebiliriz.
Dialogue: 0,0:07:00.64,0:07:02.94,Main,Ryuuma,0,0,0,,Nasılsınız?
Dialogue: 0,0:07:02.94,0:07:06.90,Main,Ryuuma,0,0,0,,İçeriyi görmek istiyorsanız, girmeniz sizin için daha iyi olurdu!
Dialogue: 0,0:07:08.04,0:07:09.36,Main,Usopp,0,0,0,,"Yohoho"?!
Dialogue: 0,0:07:09.36,0:07:11.44,Main,Chopper,0,0,0,,B-Brook?
Dialogue: 0,0:07:17.24,0:07:18.78,Main,Hogback,0,0,0,,O da kim?!
Dialogue: 0,0:07:23.69,0:07:26.21,Main,Hogback,0,0,0,,Siz! Niye buradasınız?!
Dialogue: 0,0:07:26.21,0:07:30.06,Main,Nami,0,0,0,,Nee?! "Yohoho"?\NDeminki Brook değil miydi?!
Dialogue: 0,0:07:30.06,0:07:32.58,Main,Chopper,0,0,0,,Ama iskelet değildi!
Dialogue: 0,0:07:32.58,0:07:34.97,Main,Chopper,0,0,0,,Cildi ve eti vardı!
Dialogue: 0,0:07:37.58,0:07:39.85,Main,Hogback,0,0,0,,SİZ!
Dialogue: 0,0:07:41.01,0:07:43.27,Main,All,0,0,0,,Bizi buldular!
Dialogue: 0,0:07:43.59,0:07:45.15,Main,Hogback,0,0,0,,Ne gördünüz?
Dialogue: 0,0:07:45.72,0:07:49.73,Main,Hogback,0,0,0,,Laboratuvarı asla gözetlemeyin demiştim.
Dialogue: 0,0:07:49.73,0:07:51.65,Main,Usopp,0,0,0,,Hiçbir şey görmedik!
Dialogue: 0,0:07:52.41,0:07:54.66,Main,Chopper,0,0,0,,Ben de görmedim.
Dialogue: 0,0:07:54.66,0:07:56.07,Main,Nami,0,0,0,,Ben de!
Dialogue: 0,0:07:56.84,0:07:57.95,Main,Hogback,0,0,0,,Cidden mi?
Dialogue: 0,0:07:57.95,0:08:00.04,Main,Usopp,0,0,0,,Cidden! Cidden!
Dialogue: 0,0:08:00.04,0:08:03.56,Main,Usopp,0,0,0,,Kesinlikle yaptığın zombiyi görmedik!
Dialogue: 0,0:08:03.56,0:08:04.50,Main,,0,0,0,,ÖYLE DEME!
Dialogue: 0,0:08:06.54,0:08:09.34,Main,Hogback,0,0,0,,Peki, iyi o zaman.
Dialogue: 0,0:08:09.34,0:08:14.26,Main,Hogback,0,0,0,,Şu ana kadar hangi sırları öğrenmiş olursanız olun, çok geç.
Dialogue: 0,0:08:15.12,0:08:16.68,Main,Hogback,0,0,0,,Sadece birkaç dakika içinde...
Dialogue: 0,0:08:18.34,0:08:20.77,Main,Hogback,0,0,0,,...Gece Saldırısı başlayacak.
Dialogue: 0,0:08:23.73,0:08:25.50,Main,Nami,0,0,0,,Gece Saldırısı?
Dialogue: 0,0:08:26.81,0:08:33.24,Main,Hogback,0,0,0,,Bu adada kaybolan diğer misafirler tedbiri elden bırakacak. Gece Saldırısı başlıyor.
Dialogue: 0,0:08:38.00,0:08:40.83,Main,Absalom,0,0,0,,Tam Gece Saldırısı'ndan önce yeniden gömülmek...
Dialogue: 0,0:08:42.31,0:08:46.38,Main,Absalom,0,0,0,,Kaşıntı, yanma, acı. Bunların hepsi kafanızda!
Dialogue: 0,0:08:46.38,0:08:48.28,Main,Absalom,0,0,0,,Zaten hepiniz ölüsünüz
Dialogue: 0,0:08:48.28,0:08:51.20,Main,Absalom,0,0,0,,Şimdi, uyanın! Asker zombiler!
Dialogue: 0,0:08:59.77,0:09:02.79,Main,Absalom,0,0,0,,Yenildikçe tekrar tekrar ayağa kalkacaksınız!
Dialogue: 0,0:09:02.79,0:09:07.44,Main,Absalom,0,0,0,,Bu, zombilerin gerçek dehşeti!
Dialogue: 0,0:09:08.25,0:09:10.38,Main,Zombies,0,0,0,,Ne sıkıcı ama.
Dialogue: 0,0:09:10.38,0:09:13.28,Main,Absalom,0,0,0,,Hey! Bu kadar tembel olmayı bırakın!
Dialogue: 0,0:09:13.28,0:09:15.77,Main,Absalom,0,0,0,,Haylazlığı kesin zombiler!
Dialogue: 0,0:09:15.77,0:09:17.81,Main,Absalom,0,0,0,,Bana kim olduğumu söyleyin.
Dialogue: 0,0:09:18.36,0:09:19.79,Main,Zombie,0,0,0,,Liderimizsiniz!
Dialogue: 0,0:09:20.09,0:09:25.17,Main,Zombie,0,0,0,,Liderimiz Absalom!
Dialogue: 0,0:09:25.17,0:09:28.13,Main,Zombie,0,0,0,,{\i1}Lider! Lider!
Dialogue: 0,0:09:28.53,0:09:30.43,Main,Zombie,0,0,0,,Röntgencilik kimin hobisi!
Dialogue: 0,0:09:31.20,0:09:32.65,Main,Zombie,0,0,0,,{\i1}Sapık Lider!
Dialogue: 0,0:09:32.65,0:09:35.06,Main,Zombie,0,0,0,,{\i1}Sapıksalom! Sapıksalom!
Dialogue: 0,0:09:35.06,0:09:36.28,Main,Zombie,0,0,0,,{\i1}Sapık!
Dialogue: 0,0:09:36.28,0:09:37.14,Main,Zombie,0,0,0,,{\i1}Sapık!
Dialogue: 0,0:09:37.14,0:09:39.35,Main,Absolom,0,0,0,,Kapayın çenenizi!
Dialogue: 0,0:09:52.79,0:09:56.85,Main,Kumashi,0,0,0,,Hoşgeldiniz! Leydi Perona. Leydiler!
Dialogue: 0,0:09:57.85,0:09:59.75,Main,Perona,0,0,0,,Kapa çeneni, Ayıcık!
Dialogue: 0,0:09:59.75,0:10:05.21,Main,Perona,0,0,0,,O bakış da ne öyle?! \NBunu yapmandan nefret ediyorum!
Dialogue: 0,0:10:05.21,0:10:07.30,Main,Kumashi,0,0,0,,Ü-Üzgünüm.
Dialogue: 0,0:10:15.28,0:10:20.67,Main,Perona,0,0,0,,Güzel değilsen, bana hizmet etmeye uygun değilsin demektir!
Dialogue: 0,0:10:24.82,0:10:26.25,Main,Guys,0,0,0,,Çabuk! Çabuk!
Dialogue: 0,0:10:26.25,0:10:27.95,Main,Guys,0,0,0,,Başlıyor! Başlıyor!
Dialogue: 0,0:10:27.95,0:10:29.16,Main,Guys,0,0,0,,Gece Saldırısı vakti geldi!
Dialogue: 0,0:10:29.16,0:10:31.50,Main,Guys,0,0,0,,Gece yarısı!
Dialogue: 0,0:10:31.50,0:10:32.51,Main,Guys,0,0,0,,Efendim!
Dialogue: 0,0:10:32.51,0:10:34.13,Main,Guys,0,0,0,,Moria-sama!
Dialogue: 0,0:10:34.13,0:10:36.60,Main,Guys,0,0,0,,Kalkma vakti!
Dialogue: 0,0:10:36.60,0:10:38.15,Main,Guys,0,0,0,,Nin! Yap şunu!
Dialogue: 0,0:10:38.15,0:10:39.23,Main,Nin,0,0,0,,Tamam! Uyan!
Dialogue: 0,0:10:44.82,0:10:47.64,Main,Guys,0,0,0,,Efendim!
Dialogue: 0,0:10:48.73,0:10:50.47,Main,Moria,0,0,0,,Kabus görüyordum!
Dialogue: 0,0:10:50.84,0:10:54.02,Main,Guys,0,0,0,,En iyisi bu değil mi, efendim?
Dialogue: 0,0:10:54.28,0:10:58.67,Main,Guys,0,0,0,,Moria-sama dört gün önceki gece saldırısından beri uyuduğu için,...
Dialogue: 0,0:10:58.67,0:11:05.74,Main,Guy,0,0,0,,...size dört günlük yiyecek hazırladık!
Dialogue: 0,0:11:05.74,0:11:08.92,Main,Guy,0,0,0,,Bu seferki av epey güçlü!
Dialogue: 0,0:11:08.92,0:11:12.70,Main,Guy,0,0,0,,Geçen ay Enies Lobby'yi dize getiren grup...
Dialogue: 0,0:11:12.70,0:11:14.75,Main,Guy,0,0,0,,...Hasır Şapkalı Luffy tayfası!
Dialogue: 0,0:11:15.11,0:11:18.54,Main,Guy,0,0,0,,Kesinlikle Moria-sama'nın işine yarayacaklar!
Dialogue: 0,0:11:23.06,0:11:25.27,Main,Zoro,0,0,0,,Bardaktan boşanırcasına yağmaya başladı.
Dialogue: 0,0:11:25.27,0:11:28.13,Main,Franky,0,0,0,,Tamam, malikâneye koşalım mı o zaman?
Dialogue: 0,0:11:28.13,0:11:29.26,Main,Luffy,0,0,0,,Durun biraz!
Dialogue: 0,0:11:30.31,0:11:35.01,Main,Luffy,0,0,0,,Malikânenin arkasında koca bir şey görüyorum.
Dialogue: 0,0:11:35.01,0:11:36.77,Main,Luffy,0,0,0,,İşaret gibi görünüyor.
Dialogue: 0,0:11:37.49,0:11:39.53,Main,Zoro,0,0,0,,Sis biraz açılıyor.
Dialogue: 0,0:11:40.15,0:11:42.32,Main,Zoro,0,0,0,,Ha? Bayrak?
Dialogue: 0,0:11:42.32,0:11:43.63,Main,Franky,0,0,0,,Hayır.
Dialogue: 0,0:11:43.63,0:11:46.35,Main,Franky,0,0,0,,O yelken değil mi?
Dialogue: 0,0:11:47.70,0:11:48.99,Main,All,0,0,0,,Yelken?
Dialogue: 0,0:11:49.65,0:11:50.95,Main,Old Man,0,0,0,,Aynen öyle!
Dialogue: 0,0:11:50.95,0:11:52.66,Main,All,0,0,0,,Hala peşimizde miydin?!
Dialogue: 0,0:11:53.16,0:11:57.30,Main,Old Man,0,0,0,,Aynen dediği gibi, o bir yelken.
Dialogue: 0,0:11:57.30,0:11:59.56,Main,Old Man,0,0,0,,Thriller Bark...
Dialogue: 0,0:11:59.56,0:12:05.24,Main,Old Man,0,0,0,,Bir ada değil, dünyanın en büyük korsan gemisi!
Dialogue: 0,0:12:05.24,0:12:07.63,Main,Old Man,0,0,0,,Ortasında köy olan bir korsan gemisi mi?
Dialogue: 0,0:12:07.63,0:12:10.43,Main,Old Man,0,0,0,,Gecko Moria orada!
Dialogue: 0,0:12:24.99,0:12:28.77,Captions,Sign,0,0,220,,{\fad(600,200)}Asker ve General Zombilerin\NKomutanı
Dialogue: 0,0:12:28.79,0:12:31.75,Captions,,0,0,220,,{\fad(200,0)}Mezarlık Absalom
Dialogue: 0,0:12:15.08,0:12:18.09,Main,Absalom,0,0,2,,Şimdi Asker Zombi Birimi,...
Dialogue: 0,0:12:18.09,0:12:22.26,Main,Absalom,0,0,0,,...General Zombiler korsanların işini bitirecek!
Dialogue: 0,0:12:25.86,0:12:35.38,Main,Absalom,0,0,0,,{\an8}Kaç kez devrilirseniz devrilin, hemen ayağa\Nkalkın ve onları ölümsüzlerin korkusuyla ezin!
Dialogue: 0,0:12:43.74,0:12:46.74,Captions,Sign,0,0,220,,{\fad(600,200)}Vahşi ve Süpriz Zombilerin\NKomutanı
Dialogue: 0,0:12:46.77,0:12:51.04,Captions,,0,0,220,,{\fad(200,875)}Hayalet Prenses\NPerona
Dialogue: 0,0:12:44.17,0:12:47.43,Main,Perona,0,0,2,,{\an8}Çan çaldı.
Dialogue: 0,0:12:47.43,0:12:50.80,Main,Perona,0,0,2,,{\an8}Şimdi gerçekten harekete geçme vaktimiz geldi.
Dialogue: 0,0:12:50.80,0:12:54.94,Main,Perona,0,0,2,,Buradan kaçabileceğinizi sanmayın, sersem korsanlar!
Dialogue: 0,0:12:56.12,0:12:58.24,Main,Perona,0,0,0,,Her şey hazır mı, zombiler?!
Dialogue: 0,0:13:07.15,0:13:11.60,Main,Moria,0,0,0,,Burası ölümsüzlerin krallığı,...
Dialogue: 0,0:13:11.60,0:13:13.94,Main,Moria,0,0,0,,...Thriller Bark!
Dialogue: 0,0:13:13.94,0:13:18.89,Main,Moria,0,0,0,,Kabusa tanıklık etmeye hazır olun!
Dialogue: 0,0:13:22.62,0:13:24.14,Main,Luffy,0,0,0,,Pekâla, gidelim!
Dialogue: 0,0:13:25.65,0:13:27.18,Main,Luffy,0,0,0,,Perili köşke!
Dialogue: 0,0:13:36.67,0:13:40.34,Main,Nami,0,0,0,,Bu zombi araştırması ne, Hogback?!
Dialogue: 0,0:13:40.34,0:13:44.85,Main,Nami,0,0,0,,Burada deney yapıyordun! \NÖlüleri hayata döndürüyordun, değil mi?!
Dialogue: 0,0:13:44.85,0:13:47.56,Main,Usopp,0,0,0,,Hey, Nami! Çok açık konuştun!
Dialogue: 0,0:13:52.13,0:13:55.65,Main,Hogback,0,0,0,,Şu andan itibaren istediğinizi düşünmekte özgürsünüz!
Dialogue: 0,0:13:55.65,0:13:57.76,Main,Hogback,0,0,0,,Ama sizi böyle düşünmeye iten nedir?
Dialogue: 0,0:13:59.59,0:14:02.10,Main,Nami,0,0,0,,O kadının ölüm ilanını gördüm.
Dialogue: 0,0:14:02.64,0:14:04.12,Main,Nami,0,0,0,,Victoria Cindry,...
Dialogue: 0,0:14:04.12,0:14:06.64,Main,Nami,0,0,0,,...on yıl önce öldün!
Dialogue: 0,0:14:07.98,0:14:10.48,Main,Hogback,0,0,0,,Siz! O odaya mı girdiniz?
Dialogue: 0,0:14:14.61,0:14:16.02,Main,Hogback,0,0,0,,Cindry-chan!
Dialogue: 0,0:14:16.02,0:14:17.47,Main,Hogback,0,0,0,,Samuray Ryuuma.
Dialogue: 0,0:14:17.47,0:14:20.30,Main,Hogback,0,0,0,,Bu ahmakları gölgeler dünyasına atın, hemen!
Dialogue: 0,0:14:22.37,0:14:24.16,Main,Chopper,0,0,0,,D-Durun!
Dialogue: 0,0:14:24.60,0:14:27.25,Main,Hogback,0,0,0,,Bir daha ışığı asla göremeyeceğiniz o gölge ülkesine!
Dialogue: 0,0:14:27.25,0:14:29.88,Main,Hogback,0,0,0,,Gece Saldırısı çoktan başladı!
Dialogue: 0,0:14:43.02,0:14:48.94,Main,Ryuuma,0,0,0,,Ah, ah! Şimdi seni açıkça görebiliyorum, epey güzel bir kadınsın.
Dialogue: 0,0:14:48.94,0:14:50.50,Main,Ryuuma,0,0,0,,Güzel!
Dialogue: 0,0:14:50.50,0:14:53.14,Main,Ryuuma,0,0,0,,Külotunuzu görmeme izin verir misiniz?
Dialogue: 0,0:14:53.14,0:14:54.47,Main,Nami,0,0,0,,Gösterir miyim sanki?!
Dialogue: 0,0:14:55.44,0:14:57.06,Main,Nami,0,0,0,,Bu konuşma...
Dialogue: 0,0:14:57.06,0:14:59.24,Main,Nami,0,0,0,,Aynı onunla olduğu gibi!
Dialogue: 0,0:15:01.75,0:15:06.46,Main,Hogback,0,0,0,,Şu ana dek gördüğünüz zombiler farklı bir seviyedeydi.
Dialogue: 0,0:15:06.46,0:15:10.60,Main,Hogback,0,0,0,,O general zombi ve bedeni özel.
Dialogue: 0,0:15:10.60,0:15:14.34,Main,Hogback,0,0,0,,Bu adam, Yeni Dünya'daki Wano ülkesinden geldi.
Dialogue: 0,0:15:14.76,0:15:20.24,Main,Hogback,0,0,0,,Abarttığımı düşünüyor olabilirsiniz ama bir ejderhayı uçarken nasıl kestiğine dair hikaye hala anlatılır.
Dialogue: 0,0:15:20.24,0:15:22.45,Main,Hogback,0,0,0,,Efsanevi bir samuray.
Dialogue: 0,0:15:23.29,0:15:24.56,Main,Usopp,0,0,0,,Durum kötü!
Dialogue: 0,0:15:24.56,0:15:26.02,Main,Chopper,0,0,0,,Gelme!
Dialogue: 0,0:15:29.58,0:15:31.57,Main,Hogback,0,0,0,,Kaçmak imkansız!
Dialogue: 0,0:15:46.31,0:15:47.49,Main,Ryuuma,0,0,0,,Cindry-san?
Dialogue: 0,0:15:47.49,0:15:50.74,Main,Ryuuma,0,0,0,,Oradaki geçide giden kapıyı açabilir misin lütfen?
Dialogue: 0,0:15:50.74,0:15:53.43,Main,Ryuuma,0,0,0,,Ayrıca daha sonra akşam yemeği yemek isterim.
Dialogue: 0,0:15:53.43,0:15:57.00,Main,Nami,0,0,0,,N-Ne? Bizi keseceğini sanmıştım.
Dialogue: 0,0:15:57.00,0:15:59.77,Main,Chopper,0,0,0,,Ödüm koptu! Ne yapmaya çalışıyordu?
Dialogue: 0,0:15:59.77,0:16:04.73,Main,Usopp,0,0,0,,Her neydiyse şu an önemi yok!\NKapı açıkken kaçma şansımız var!
Dialogue: 0,0:16:06.52,0:16:07.65,Main,Usopp,0,0,0,,Çabuk!
Dialogue: 0,0:16:14.97,0:16:15.89,Main,Hogback,0,0,0,,İyi iş.
Dialogue: 0,0:16:17.95,0:16:22.34,Main,Hogback,0,0,0,,Bu kesinlikle bir ustanın kılıç oyunu.\NMırıldandıktan ve üç blok yürüdükten sonra...
Dialogue: 0,0:16:22.34,0:16:25.52,Main,Hogback,0,0,0,,...ancak kesildiklerini farkediyorlar.
Dialogue: 0,0:16:26.90,0:16:29.62,Main,Move Name,0,0,0,,{\fad(150,150)}Üç Blokluk Şarkı Mırıldanışı.
Dialogue: 0,0:16:30.25,0:16:31.63,Main,Ryuuma,0,0,0,,{\fad(150,150)}Çentik Ok Vuruşu!
Dialogue: 0,0:16:44.92,0:16:46.91,Main,Luffy,0,0,0,,Evde kimse var mı?
Dialogue: 0,0:16:46.91,0:16:48.42,Main,Luffy,0,0,0,,İzninizle!
Dialogue: 0,0:16:48.42,0:16:49.53,Main,Sanji,0,0,0,,Gir işte!
Dialogue: 0,0:16:51.65,0:16:53.62,Main,Luffy,0,0,0,,Kapı arkadan...
Dialogue: 0,0:16:56.70,0:16:58.68,Main,Luffy,0,0,0,,Ah, açık!
Dialogue: 0,0:16:58.68,0:17:01.17,Main,Zoro,0,0,0,,Ne diye "açık" diyorsun, aptal.
Dialogue: 0,0:17:03.51,0:17:07.28,Main,Luffy,0,0,0,,Hey! Evde kimse var mı?
Dialogue: 0,0:17:07.28,0:17:09.22,Main,Luffy,0,0,0,,Gekko Moria!
Dialogue: 0,0:17:12.14,0:17:16.56,Main,Zoro,0,0,0,,Bu malikânenin olanı biteni bu mu?\NTek bir hizmetçi bile yok mu?
Dialogue: 0,0:17:17.64,0:17:21.31,Main,Sanji,0,0,0,,Bu da ne böyle? Kavga olmuş gibi görünüyor.
Dialogue: 0,0:17:22.02,0:17:23.86,Main,Sanji,0,0,0,,Nami-san karışmış olamaz herhalde?!
Dialogue: 0,0:17:26.24,0:17:31.87,Main,Oinkchuck,0,0,0,,Efendimizin adını bildiğiniz halde buraya\Ngelecek kadar çok cesaretiniz var.
Dialogue: 0,0:17:32.14,0:17:34.85,Main,Luffy,0,0,0,,Eh?! Duvardan çıkan bir domuz var.
Dialogue: 0,0:17:34.85,0:17:37.48,Main,Oinkchuck,0,0,0,,Şaşırmak için henüz biraz erken.
Dialogue: 0,0:17:39.61,0:17:42.42,Main,Sanji,0,0,0,,Hey, hey. Onlar da mı zombi?
Dialogue: 0,0:17:42.92,0:17:47.90,Main,Robin,0,0,0,,Bu adada ne olursa olsun, \Nsıradışı olmak zorundaymış gibi görünüyor.
Dialogue: 0,0:17:51.36,0:17:53.25,Main,Sanji,0,0,0,,Nami-san'ı...
Dialogue: 0,0:17:53.25,0:17:54.79,Main,Sanji,0,0,0,,...nerede saklıyorsunuz!
Dialogue: 0,0:17:58.93,0:18:01.14,Main,Robin,0,0,0,,Ağzını o kadar açmak bir kadına yakışmıyor.
Dialogue: 0,0:18:01.14,0:18:02.64,Main,Robin,0,0,0,,Epey güzel olsan bile.
Dialogue: 0,0:18:02.64,0:18:04.44,Main,ZombieWoman,0,0,0,,Eh? Gerçekten mi?
Dialogue: 0,0:18:04.44,0:18:07.24,Main,Robin,0,0,0,,Ama resim çerçevesinden çıktığında bunu çoktan mahvettin.
Dialogue: 0,0:18:07.62,0:18:08.45,Main,Robin,0,0,0,,{\fad(150,150)}Bük!
Dialogue: 0,0:18:10.89,0:18:12.43,Main,ZombieRound,0,0,0,,Mızrak kırıldı!
Dialogue: 0,0:18:12.43,0:18:14.53,Main,ZombieRound,0,0,0,,Bedeninin nesi var?! Demir mi?!
Dialogue: 0,0:18:15.68,0:18:18.99,Main,ZombieRound,0,0,0,,K-K-K-Kes şunu! Nesin sen?!
Dialogue: 0,0:18:18.99,0:18:21.67,Main,ZombieRound,0,0,0,,Diğer güçsüz arkadaşlardan biri değil misin?
Dialogue: 0,0:18:25.80,0:18:27.41,Main,Zoro,0,0,0,,{\fad(150,150)}Çift Kılıç Stili!
Dialogue: 0,0:18:27.41,0:18:28.34,Main,Zoro,0,0,0,,{\fad(150,0)}Çift Dilim.
Dialogue: 0,0:18:28.34,0:18:31.37,Main,ZombieHungry,0,0,0,,*Çift Dilim? Kulağa leziz geliyor!
Dialogue: 0,0:18:31.37,0:18:32.37,Main,Zoro,0,0,0,,{\fad(150,0)}Işık Patlaması!
Dialogue: 0,0:18:33.35,0:18:36.67,Main,ZombieHungry,0,0,0,,Berbattı!
Dialogue: 0,0:18:38.73,0:18:41.34,Main,Luffy,0,0,0,,Ada gerçekten eğlenceli!
Dialogue: 0,0:18:42.78,0:18:45.77,Main,Rugbear,0,0,0,,Seni çevik küçük pislik!
Dialogue: 0,0:18:55.73,0:18:59.20,Main,Luffy,0,0,0,,Yolumuza çıkmamış olsaydın, muhtelen iyi geçinirdik!
Dialogue: 0,0:19:00.45,0:19:02.21,Main,Luffy,0,0,0,,{\fad(150,0)}Gomu Gomu no...
Dialogue: 0,0:19:04.20,0:19:05.92,Main,Luffy,0,0,0,,{\fad(150,150)}...Bazuka!
Dialogue: 0,0:19:09.37,0:19:12.02,Main,Oinkchuck,0,0,0,,Ha-Halıayı!
Dialogue: 0,0:19:15.91,0:19:18.46,Main,Luffy,0,0,0,,Evet, bitti.
Dialogue: 0,0:19:21.86,0:19:24.64,Main,Oinkchuck,0,0,0,,Ah, o üçünden bahsediyorsunuz!
Dialogue: 0,0:19:24.64,0:19:27.53,Main,Oinkchuck,0,0,0,,Şu anda yatak odasında derin derin uyuyorlar.
Dialogue: 0,0:19:27.53,0:19:28.78,Main,Oinkchuck,0,0,0,,Memnun olmadınız mı?
Dialogue: 0,0:19:28.78,0:19:29.78,Main,Oinkchuck,0,0,0,,Güvendeler!
Dialogue: 0,0:19:29.78,0:19:31.24,Main,Franky,0,0,0,,Bu saçmalığa inanır mıyız sanki?
Dialogue: 0,0:19:31.24,0:19:38.92,Main,Oinkchuck,0,0,0,,Gerçekten doğru! Kendiniz görün!\NMerdivenlerin yukarısındaki geçit!
Dialogue: 0,0:19:40.25,0:19:42.43,Main,Franky,0,0,0,,Hey, durun biraz.
Dialogue: 0,0:19:42.76,0:19:45.93,Main,Franky,0,0,0,,Kıvırcık kaşlı aşçı gitmiş.
Dialogue: 0,0:19:45.93,0:19:49.21,Main,Luffy,0,0,0,,Ha? Biraz önce buradaydı.
Dialogue: 0,0:19:49.21,0:19:51.43,Main,Luffy,0,0,0,,Sanji nereye gitti?
Dialogue: 0,0:19:54.40,0:19:56.52,Main,Zombies,0,0,0,,Hey, gülmeyi kesin! Seni duyacaklar.
Dialogue: 0,0:19:59.44,0:20:03.28,Main,Zoro,0,0,0,,Bir noktada bir şey yapmış olmalılar.
Dialogue: 0,0:20:03.28,0:20:05.24,Main,Zoro,0,0,0,,Önemli bir adamı kaybettik.
Dialogue: 0,0:20:05.24,0:20:06.72,Main,Franky,0,0,0,,Hey, sen...
Dialogue: 0,0:20:06.72,0:20:10.33,Main,Luffy,0,0,0,,Ama yine de o haklı. Sanji iyi olmalı.
Dialogue: 0,0:20:10.33,0:20:17.50,Main,Robin,0,0,0,,Ama bu zombi malikânesinde diğer üçünü\Nkurtarmaya odaklanmalıyız, değil mi?
Dialogue: 0,0:20:19.10,0:20:23.68,Main,Oinkchuck,0,0,0,,Sırf biraz güçlüsünüz diye ukalalık etmeyin.
Dialogue: 0,0:20:25.10,0:20:29.60,Main,Oinkchuck,0,0,0,,Şimdi bir arkadaşınızı yitirdiğinize göre,\Ngerçek renginizi göstereceksiniz! Bakın!
Dialogue: 0,0:20:29.95,0:20:33.48,Main,Robin,0,0,0,,Neyse, dikkatlice gitmekten başka\Nçaremiz yokmuş gibi görünüyor.
Dialogue: 0,0:20:33.48,0:20:36.05,Main,Oinkchuck,0,0,0,,Hey, siz! Gerçekten-
Dialogue: 0,0:20:36.05,0:20:40.13,Main,Robin,0,0,0,,Bu çocukların hikayelerinin doğru olduğunu sanmıyorum.
Dialogue: 0,0:20:40.39,0:20:43.57,Main,Zoro,0,0,0,,O zaman bu domuzu rehber olarak yanımızda götürelim.
Dialogue: 0,0:20:49.87,0:20:51.25,Main,Zombie1,0,0,0,,Gidin, gidin!
Dialogue: 0,0:20:51.90,0:20:53.71,Main,Oinkchuck,0,0,0,,Durun, siz...
Dialogue: 0,0:20:54.03,0:20:59.18,Main,Zombie2,0,0,0,,Efendimizin ne kadar korkutucu\Nolduğunu öğrenmek sizin için iyi olacak.
Dialogue: 0,0:20:59.18,0:21:04.47,Main,Zombie3,0,0,0,,Asıl patronumuz Kraliyet Shichibukai'si Gecko Mori-
Dialogue: 0,0:21:04.47,0:21:07.26,Main,Zombie3,0,0,0,,Söyleyemem! Ruhumu donduruyor!
Dialogue: 0,0:21:07.26,0:21:11.86,Main,Zombie4,0,0,0,,Ooh, o ismi söylemek bile kanımı donduruyor!
Dialogue: 0,0:21:11.86,0:21:15.61,Main,Zombie5,0,0,0,,Kayıp arkadaşınızın başı dertte.
Dialogue: 0,0:21:15.61,0:21:20.15,Main,Zombie5,0,0,0,,Önce biri, sonra diğeri.\NArkadaşların yavaşça yok olacak.
Dialogue: 0,0:21:20.15,0:21:21.57,Main,Zombie5,0,0,0,,Geri dönmelisiniz.
Dialogue: 0,0:21:21.95,0:21:24.24,Main,Zombie5,0,0,0,,Ama Shichibukai Gecko-,...
Dialogue: 0,0:21:24.24,0:21:31.33,Main,Zombie5,0,0,0,,...hayır, efendimizin gerçek gücü karşısında, dehşet, sizi birini kurtarmaktan alıkoyacak!
Dialogue: 0,0:21:31.81,0:21:34.30,Main,Luffy,0,0,0,,Kapa çeneni.
Dialogue: 0,0:21:34.74,0:21:37.72,Main,Luffy,0,0,0,,O zaman aptal Moria'ya şunu söyle!
Dialogue: 0,0:21:40.68,0:21:44.08,Main,Luffy,0,0,0,,Arkadaşıma bir şey olursa,...
Dialogue: 0,0:21:44.08,0:21:47.83,Main,Luffy,0,0,0,,...onu bu adanın yüzünden sileceğim!
Dialogue: 0,0:21:51.17,0:21:55.43,Main,Luffy,0,0,0,,Neyse, Sanji'yi yalnız bırakacağız. Ölmeyecektir.
Dialogue: 0,0:21:55.43,0:21:56.57,Main,Luffy,0,0,0,,Gidelim.
Dialogue: 0,0:21:56.81,0:21:59.64,Thoughts,Zombie6,0,0,0,,Sevgili Efendim,...
Dialogue: 0,0:21:59.64,0:22:04.37,Thoughts,Zombie6,0,0,0,,...nasılsa bazı zorlu kimseler malikâneye girdi.
Dialogue: 0,0:22:04.37,0:22:07.96,Thoughts,Zombie6,0,0,0,,Sürpriz Zombiler'den (Şaşıranlar!)
Dialogue: 0,0:22:17.76,0:22:20.22,Lyrics,Zombies,0,0,0,,{\i1}♪ Herkes malikâneyi sarsın! ♪
Dialogue: 0,0:22:17.76,0:22:20.22,Lyrics,Zombies,0,0,0,,{\an8}屋敷を囲めェ～
Dialogue: 0,0:22:20.22,0:22:22.97,Lyrics,Zombies,0,0,0,,{\i1}♪ Festival gecesi yapalım! ♪
Dialogue: 0,0:22:20.22,0:22:22.97,Lyrics,Zombies,0,0,0,,{\an8}レッツフィエスタナイッッ
Dialogue: 0,0:22:22.97,0:22:28.46,Lyrics,Zombies,0,0,0,,{\i1}♪ Tek bir korsan bile kaçamayacak! ♪
Dialogue: 0,0:22:22.97,0:22:28.46,Lyrics,Zombies,0,0,0,,{\an8}海賊達は一人たりとも逃がさない
Dialogue: 0,0:22:28.46,0:22:30.86,Lyrics,Zombies,0,0,0,,{\i1}♪ Hep birlikte! Zombi Gecesi! ♪
Dialogue: 0,0:22:28.46,0:22:30.86,Lyrics,Zombies,0,0,0,,{\an8}エッビッバァリィ～ゾンビナイッ
Dialogue: 0,0:22:30.86,0:22:33.53,Lyrics,Zombies,0,0,0,,{\i1}♪ Dönün, dönün, dönün ve ölün! ♪
Dialogue: 0,0:22:30.86,0:22:33.53,Lyrics,Zombies,0,0,0,,{\an8}ラウンド andラウンandターンandダーイ
Dialogue: 0,0:22:33.53,0:22:37.65,Lyrics,Zombies,0,0,0,,{\i1}♪ Zombi Gecesi! ♪
Dialogue: 0,0:22:33.53,0:22:37.65,Lyrics,Zombies,0,0,0,,{\an8}ゾンビナーイッ！！！
Dialogue: 0,0:22:52.05,0:22:59.05,Main,Absalom,0,0,0,,Şimdi avlarımız bölgemize girdi!
Dialogue: 0,0:22:59.05,0:23:03.10,Main,Absalom,0,0,0,,Bu gece istediğiniz kadar yakıp yıkabilirsiniz!
Dialogue: 0,0:23:03.57,0:23:06.66,Main,Absalom,0,0,0,,Uyanın! General Zombiler!
Dialogue: 0,0:23:11.38,0:23:16.91,Main,Absalom,0,0,0,,Dirilin! Antik Savaşçılar!
Dialogue: 0,0:23:31.46,0:23:37.22,Main,Absalom,0,0,0,,Hasır Şapka Korsanları sekiz kişiden oluşuyor.
Dialogue: 0,0:23:37.22,0:23:41.23,Main,Absalom,0,0,0,,Onları sesli bir şekilde yakalayıp efendimize getirin!
Dialogue: 0,0:23:47.00,0:23:48.34,Main,Absalom,0,0,0,,Harekete geçelim!
Dialogue: 0,0:23:48.34,0:23:51.45,Main,Absalom,0,0,0,,Korkutucu General Zombiler!
