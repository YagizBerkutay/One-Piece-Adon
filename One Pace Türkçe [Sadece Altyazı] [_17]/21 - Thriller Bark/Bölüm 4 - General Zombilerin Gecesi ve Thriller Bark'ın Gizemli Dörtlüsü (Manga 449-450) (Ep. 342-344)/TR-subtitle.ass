Dialogue: 0,0:00:25.48,0:00:28.90,Lyrics,,0,0,0,,{\i1}...denizle gök arasındaki sınır boyunca.{\i0}
Dialogue: 0,0:00:29.02,0:00:34.13,Lyrics,,0,0,0,,{\i1}Şimdi kürek çekerek yolumuzu açıyoruz...{\i0}
Dialogue: 0,0:00:29.40,0:00:34.53,Credits,,0,0,0,,{\pos(524,540)}Timing\N{\fs40}Galaxy 9000
