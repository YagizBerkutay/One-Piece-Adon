Dialogue: 0,0:02:29.83,0:02:38.61,Title,,0,0,0,,{\fad(2000,2000}900 Numara?\NLola'nın Peşinden ve Mırıldanan Kılıç Ustası
Dialogue: 0,0:02:38.84,0:02:41.76,Main,Zombie,0,0,0,,Hey, ne yapıyorsun, yeni gelen?!
Dialogue: 0,0:02:41.76,0:02:46.74,Main,Zombie,0,0,0,,Biz zombilerin efendimizin emirlerine ihanet etmesi imkansız.
Dialogue: 0,0:02:47.15,0:02:50.35,Main,Zombie,0,0,0,,O nasıl itaatsizlik edebilir?!
Dialogue: 0,0:02:50.35,0:02:53.60,Main,Zombie,0,0,0,,Dahası bir general kadar güçl!
Dialogue: 0,0:02:53.60,0:02:56.29,Main,Dog-Penguin,0,0,0,,Açıkçası o durdurulamayan güç,...
Dialogue: 0,0:02:56.29,0:02:58.53,Main,Dog-Penguin,0,0,0,,...imkansızı mümkün kılan güç,...
Dialogue: 0,0:02:58.53,0:03:01.95,Main,Dog-Penguin,0,0,0,,...tüm engelleri deviren kasırganın adı,...
Dialogue: 0,0:03:01.95,0:03:03.12,Main,Dog-Penguin,0,0,0,,...aşk!
Dialogue: 0,0:03:03.12,0:03:06.93,Main,Nami,0,0,0,,Düşündüğüm gibi, Köpek Penguen'in söylediği tüm bu saçmalıklar...
Dialogue: 0,0:03:06.93,0:03:08.12,Main,Nami,0,0,0,,...neredeyse Sanji'ninki gibi.
Dialogue: 0,0:03:08.12,0:03:09.81,Main,Usopp,0,0,0,,Hey, Köpek Penguen!
Dialogue: 0,0:03:09.81,0:03:11.61,Main,Usopp,0,0,0,,Sanji hakkında bir şey biliyor musun?!
Dialogue: 0,0:03:11.61,0:03:13.48,Main,Usopp,0,0,0,,Biz Sanji'nin arkadaşlarıyız, bu yüzden...
Dialogue: 0,0:03:13.48,0:03:15.52,Main,Dog-Penguin,0,0,0,,Kapayın çenenizi korsanlar!
Dialogue: 0,0:03:17.92,0:03:20.61,Main,Usopp,0,0,0,,Gerçekten düşmanımız!
Dialogue: 0,0:03:23.48,0:03:24.46,Main,Usopp,0,0,0,,Ne?
Dialogue: 0,0:03:26.30,0:03:28.07,Main,Usopp,0,0,0,,Şimdi ne var?
Dialogue: 0,0:03:28.07,0:03:30.23,Main,Absalom,0,0,0,,Dur, Lola!
Dialogue: 0,0:03:33.27,0:03:34.34,Main,Both,0,0,0,,Yaban domuzu?
Dialogue: 0,0:03:34.34,0:03:36.09,Main,Absalom,0,0,0,,Hey!
Dialogue: 0,0:03:36.09,0:03:38.55,Main,Absalom,0,0,0,,Dur, Lola!
Dialogue: 0,0:03:40.10,0:03:42.36,Main,Lola,0,0,0,,Gel ve beni yakala!
Dialogue: 0,0:03:45.65,0:03:46.77,Main,Nami,0,0,0,,Ne?!
Dialogue: 0,0:03:46.77,0:03:48.57,Main,Lola,0,0,0,,Nihayet seni buldum.
Dialogue: 0,0:03:49.39,0:03:53.31,Main,Lola,0,0,0,,Hırsız Kedi!
Dialogue: 0,0:03:53.98,0:03:55.29,Main,Nami,0,0,0,,Ben mi?!
Dialogue: 0,0:03:55.29,0:03:56.86,Main,Nami,0,0,0,,D-Dur biraz!
Dialogue: 0,0:03:56.86,0:03:58.69,Main,Nami,0,0,0,,Henüz bir şey çalmadım!
Dialogue: 0,0:03:58.69,0:04:00.80,Main,Lola,0,0,0,,Faydasız!
Dialogue: 0,0:04:00.80,0:04:03.91,Main,Lola,0,0,0,,Ab-sama'yı almana izin vermeyeceğim!
Dialogue: 0,0:04:06.18,0:04:08.64,Main,Dog-Penguin,0,0,0,,Bu kadına el sürme.
Dialogue: 0,0:04:08.64,0:04:11.66,Main,Lola,0,0,0,,Karışma!
Dialogue: 0,0:04:16.38,0:04:17.29,Main,Usopp,0,0,0,,Köpek Penguen.
Dialogue: 0,0:04:17.29,0:04:19.61,Main,Usopp,0,0,0,,Niye saldırmadı?!
Dialogue: 0,0:04:20.49,0:04:23.36,Main,Dog-Penguin,0,0,0,,Ölsem bile...
Dialogue: 0,0:04:23.92,0:04:26.14,Main,Dog-Penguin,0,0,0,,...bir kadını asla incitmem!
Dialogue: 0,0:04:26.81,0:04:27.92,Main,Chopper,0,0,0,,Müthiş!
Dialogue: 0,0:04:27.92,0:04:31.16,Main,Usopp,0,0,0,,O şeyin kadın olduğunu anladığına göre müthişsin!
Dialogue: 0,0:04:31.96,0:04:33.40,Main,Nami,0,0,0,,Usopp! Chopper!
Dialogue: 0,0:04:35.72,0:04:37.82,Main,Absalom,0,0,0,,Karımı aldım!
Dialogue: 0,0:04:37.82,0:04:40.23,Main,Both,0,0,0,,Müthiş, Nami uçuyor!
Dialogue: 0,0:04:40.23,0:04:43.47,Main,Nami,0,0,0,,Aptallar, kaçırılıyorum!
Dialogue: 0,0:04:43.95,0:04:45.08,Main,Chopper,0,0,0,,Kim tarafından?!
Dialogue: 0,0:04:46.16,0:04:46.97,Main,Usopp,0,0,0,,Dur!
Dialogue: 0,0:04:47.44,0:04:50.13,Main,Absalom,0,0,0,,Pekâlâ, törene hemen başlayacağız!
Dialogue: 0,0:04:50.13,0:04:52.54,Main,Absalom,0,0,0,,Hazırlıkları çoktan yaptım!
Dialogue: 0,0:04:52.54,0:04:53.40,Main,Nami,0,0,0,,Bırak beni!
Dialogue: 0,0:04:53.40,0:04:55.96,Main,Nami,0,0,0,,Sen banyodaki görünmez adamsın, değil mi?!
Dialogue: 0,0:04:56.54,0:04:58.40,Main,Usopp,0,0,0,,Bu gerçek olabilir mi?!
Dialogue: 0,0:04:58.40,0:05:00.02,Main,Chopper,0,0,0,,Nami!
Dialogue: 0,0:05:01.26,0:05:03.07,Main,Absalom,0,0,0,,Seni değerlendirdim.
Dialogue: 0,0:05:04.09,0:05:07.89,Main,Absalom,0,0,0,,Karım olmaya en uygun kişisin!
Dialogue: 0,0:05:08.34,0:05:11.26,Main,Absalom,0,0,0,,Adım Absalom!
Dialogue: 0,0:05:11.83,0:05:14.01,Main,Absalom,0,0,0,,Gelecekteki kocanın ismi.
Dialogue: 0,0:05:14.01,0:05:15.91,Main,Absalom,0,0,0,,Sakın unutma!
Dialogue: 0,0:05:18.63,0:05:22.36,Main,Nami,0,0,0,,Çıplak insanları gözetleyecek küstahlığın var!
Dialogue: 0,0:05:22.36,0:05:26.07,Main,Nami,0,0,0,,Bedenimi, sapık bir hayvan gözetlesin diye her gün formda tutmuyorum!
Dialogue: 0,0:05:26.54,0:05:27.91,Main,Nami,0,0,0,,{\fad(150,150)}Gökgürültüsü Saldırısı!
Dialogue: 0,0:05:35.64,0:05:37.14,Main,Usopp,0,0,0,,Nami!
Dialogue: 0,0:05:39.36,0:05:40.43,Main,Usopp,0,0,0,,İyi iş!
Dialogue: 0,0:05:40.43,0:05:42.12,Main,Usopp,0,0,0,,Koşmaya devam edelim!
Dialogue: 0,0:05:43.08,0:05:44.86,Main,Usopp,0,0,0,,Bu ormandan çıkıyoruz!
Dialogue: 0,0:05:45.80,0:05:46.71,Main,Nami,0,0,0,,Ne?!
Dialogue: 0,0:05:46.71,0:05:48.34,Main,Nami,0,0,0,,Yere düşmedi!
Dialogue: 0,0:05:48.34,0:05:50.82,Main,Usopp,0,0,0,,Sıradan biri değil, sadece bakarak bile anlayabilirsin!
Dialogue: 0,0:05:51.96,0:05:57.73,Thoughts,Absalom,0,0,0,,{\i1}Bedenimde dolaşan bu şok neyin nesi?{\i0}
Dialogue: 0,0:05:57.73,0:06:03.60,Thoughts,Absalom,0,0,0,,{\i1}Sanki yıldırım çarpmış gibiyim!{\i0}
Dialogue: 0,0:06:03.60,0:06:08.29,Thoughts,Absalom,0,0,0,,{\i1}Yoksa bu...{\i0}
Dialogue: 0,0:06:08.29,0:06:10.03,Thoughts,Absalom,0,0,0,,{\i1}...aşk mı?{\i0}
Dialogue: 0,0:06:11.20,0:06:13.26,Main,Lola,0,0,0,,Benden kaçamayacaksın!
Dialogue: 0,0:06:13.72,0:06:16.32,Main,Zombies,0,0,0,,Hey! Öylece duracak zaman değil!
Dialogue: 0,0:06:16.32,0:06:19.08,Main,Zombies,0,0,0,,Onları yakalamak bizim işimiz!
Dialogue: 0,0:06:19.08,0:06:20.09,Main,Zombies,0,0,0,,Haklısın!
Dialogue: 0,0:06:20.09,0:06:22.79,Main,Zombies,0,0,0,,Başarısız olursak Perona-sama'nın cezası bizi bekliyor!
Dialogue: 0,0:06:22.79,0:06:26.59,Main,Dog-Penguin,0,0,0,,Olamaz! O kadının peşinden gidiyorlar!
Dialogue: 0,0:06:26.59,0:06:30.70,Main,Dog-Penguin,0,0,0,,Ama o kızı niye koruyorum?!
Dialogue: 0,0:06:30.70,0:06:33.67,Main,Dog-Penguin,0,0,0,,Dahası kıpırdayamıyorum!
Dialogue: 0,0:06:33.67,0:06:35.62,Main,Dog-Penguin,0,0,0,,Bu beden çok güçsüz!
Dialogue: 0,0:06:36.18,0:06:38.30,Main,Zombies,0,0,0,,Hemen onları yakalayın!
Dialogue: 0,0:06:38.30,0:06:40.75,Main,Absalom,0,0,0,,Durun, Vahşi Zombiler!
Dialogue: 0,0:06:40.75,0:06:42.96,Main,Absalom,0,0,0,,O kadına el sürmeyin!
Dialogue: 0,0:06:42.96,0:06:45.00,Main,Zombies,0,0,0,,Kapa çeneni, Sapıksalom!
Dialogue: 0,0:06:45.38,0:06:49.54,Main,Zombies,0,0,0,,Efendiden emir alırız ama Perona-sama'nın adamlarıyız!
Dialogue: 0,0:06:49.54,0:06:51.22,Main,Absalom,0,0,0,,Durun dedim!
Dialogue: 0,0:06:53.80,0:06:58.44,Main,Absalom,0,0,0,,Perona'nın emrinde olduğunuzun farkındayım.
Dialogue: 0,0:06:58.44,0:06:59.37,Main,Absalom,0,0,0,,Ama...
Dialogue: 0,0:06:59.37,0:07:04.06,Main,Absalom,0,0,0,,...yine de beni kızdırmamanız gerektiğini bilmelisiniz.
Dialogue: 0,0:07:04.06,0:07:08.03,Main,Absalom,0,0,0,,Şansınızı zorlamayın.
Dialogue: 0,0:07:10.64,0:07:11.99,Main,Absalom,0,0,0,,Ne istiyorsun?!
Dialogue: 0,0:07:11.99,0:07:14.91,Main,Dog-Penguin,0,0,0,,O kadının peşinden gitmene izin vermeyeceğim.
Dialogue: 0,0:07:14.91,0:07:17.14,Main,Zombies,0,0,0,,H-Hey, yeni gelen, dur!
Dialogue: 0,0:07:17.14,0:07:19.58,Main,Zombies,0,0,0,,Absalom'u kızdırma!
Dialogue: 0,0:07:29.51,0:07:33.11,Main,Lola,0,0,0,,Dur, Hırsız Kedi!
Dialogue: 0,0:07:33.11,0:07:36.20,Main,Usopp,0,0,0,,Hey, Nami! Sadece senin peşindeymiş gibi!
Dialogue: 0,0:07:36.20,0:07:38.95,Main,Nami,0,0,0,,Haklısın! Ne yaptım ben?!
Dialogue: 0,0:07:39.29,0:07:41.66,Main,Usopp,0,0,0,,Niye iki gruba ayrılıp kaçmıyoruz?
Dialogue: 0,0:07:43.46,0:07:45.86,Main,Nami,0,0,0,,Beni bırakmak mı istiyorsun, taş kalpli canavar?!
Dialogue: 0,0:07:47.39,0:07:49.21,Main,Lola,0,0,0,,Buraya gel, lanet olsun!
Dialogue: 0,0:07:49.21,0:07:51.03,Main,Chopper,0,0,0,,Vahşi domuz çok korkunç!
Dialogue: 0,0:07:55.99,0:07:58.62,Main,Franky,0,0,0,,Yoksa onlar...
Dialogue: 0,0:07:58.62,0:08:01.52,Flashbacks,Luffy,0,0,0,,Ne yapıyorsunuz pislikler?!
Dialogue: 0,0:08:01.52,0:08:02.88,Flashbacks,Luffy,0,0,0,,Çıkarın beni!
Dialogue: 0,0:08:03.77,0:08:08.80,Main,Franky,0,0,0,,...aynı Hasır Şapka gibi duvarın diğer tarafına mı götürüldü?
Dialogue: 0,0:08:08.80,0:08:11.32,Main,Spider,0,0,0,,Maymun! Maymun!
Dialogue: 0,0:08:14.25,0:08:17.89,Main,Spider,0,0,0,,Yakında siz de aynı kaderi paylaşacaksınız!
Dialogue: 0,0:08:18.33,0:08:21.77,Main,Spider,0,0,0,,İki taraftan da zarar görmeyen zombiler geliyor.
Dialogue: 0,0:08:21.77,0:08:24.73,Main,Spider,0,0,0,,Pes edin!
Dialogue: 0,0:08:25.08,0:08:27.75,Main,Franky,0,0,0,,Sersem bir örümcek misin yoksa maymun musun anlayamıyorum ama...
Dialogue: 0,0:08:27.75,0:08:33.28,Main,Franky,0,0,0,,...karaya çıktığımızda Sunny'yi yakalayan koca örümcek ağı senin işindi, değil mi?
Dialogue: 0,0:08:35.47,0:08:36.57,Main,Spider,0,0,0,,Evet!
Dialogue: 0,0:08:37.05,0:08:44.48,Main,Spider,0,0,0,,Tüm hareketleriniz doğruca Perona-sama'nın Hayalet Ağı'na gidiyor.
Dialogue: 0,0:08:44.48,0:08:48.00,Main,Robin,0,0,0,,Acaba o koca kulaklar da bilgi toplamaya katkıda bulunuyor mu?
Dialogue: 0,0:08:49.09,0:08:50.92,Main,Robin,0,0,0,,Çok iyi duyabiliyormuş gibi görünüyorlar.
Dialogue: 0,0:08:51.40,0:08:53.74,Main,Spider,0,0,0,,Ne dedin?
Dialogue: 0,0:08:53.74,0:08:55.29,Main,Franky,0,0,0,,Rol yapmayı bırak!
Dialogue: 0,0:08:57.71,0:09:00.04,Main,Franky,0,0,0,,En kötü durum senaryosu.
Dialogue: 0,0:09:00.04,0:09:02.64,Main,Franky,0,0,0,,Tamamen sarıldık.
Dialogue: 0,0:09:03.12,0:09:06.14,Main,Franky,0,0,0,,Acilen karşı tedbir almak zorunda gibiyiz.
Dialogue: 0,0:09:07.17,0:09:08.61,Main,Franky,0,0,0,,Bununla ilgileneyim mi?!
Dialogue: 0,0:09:09.17,0:09:10.71,Main,Robin,0,0,0,,İstediğini yap.
Dialogue: 0,0:09:10.71,0:09:12.32,Main,Robin,0,0,0,,İlgilenmeye çalışacağım.
Dialogue: 0,0:09:13.30,0:09:14.99,Main,Franky,0,0,0,,Aslında epey güvenilirimdir.
Dialogue: 0,0:09:14.99,0:09:17.34,Main,Franky,0,0,0,,Başlayalım o zaman!
Dialogue: 0,0:09:17.34,0:09:19.53,Main,Spider,0,0,0,,Hey, dur! Ne yapacaksın?!
Dialogue: 0,0:09:18.18,0:09:19.53,Secondary,Franky,0,0,0,,{\fad(150,150)}Rüzgar...
Dialogue: 0,0:09:19.53,0:09:20.47,Main,Franky,0,0,0,,{\fad(150,150)}...Vuruşu!
Dialogue: 0,0:09:22.40,0:09:25.04,Main,Spider,0,0,0,,Ne?!
Dialogue: 0,0:09:26.06,0:09:28.71,Main,Spider,0,0,0,,Köprüyü mü yıktın?!
Dialogue: 0,0:09:32.61,0:09:35.08,Main,Franky,0,0,0,,Evet, öyle işte.
Dialogue: 0,0:09:35.08,0:09:36.39,Main,Robin,0,0,0,,Her zamanki gibi sert.
Dialogue: 0,0:09:43.30,0:09:45.23,Main,Robin,0,0,0,,{\fad(150,150)}Cien Fleur...
Dialogue: 0,0:09:43.30,0:09:45.23,Note,Robin,0,0,0,,{\fad(150,150)}100 Çiçek!
Dialogue: 0,0:09:49.23,0:09:50.34,Main,Robin,0,0,0,,{\fad(150,150)}Kanat!
Dialogue: 0,0:09:51.84,0:09:54.42,Main,Franky,0,0,0,,Sen! Uçabiliyor musun?!
Dialogue: 0,0:09:54.42,0:09:57.48,Main,Robin,0,0,0,,Evet, beş saniyeliğine.
Dialogue: 0,0:09:57.48,0:09:58.41,Main,Franky,0,0,0,,Çok kısa!
Dialogue: 0,0:09:59.10,0:10:00.89,Main,Franky,0,0,0,,Ama yeterince uzun.
Dialogue: 0,0:10:01.40,0:10:03.92,Main,Franky,0,0,0,,{\fad(150,150)}Güçlü Sağ!
Dialogue: 0,0:10:06.23,0:10:07.96,Main,Franky,0,0,0,,Tamam! Yakaladım!
Dialogue: 0,0:10:08.46,0:10:11.81,Main,Franky,0,0,0,,Girişe varabilirsek, Hasır Şapka'nın peşinden gidebiliriz!
Dialogue: 0,0:10:12.61,0:10:13.61,Main,Robin,0,0,0,,Üzgünüm.
Dialogue: 0,0:10:13.61,0:10:15.05,Main,Robin,0,0,0,,Sınırıma ulaştım.
Dialogue: 0,0:10:15.95,0:10:17.01,Main,Franky,0,0,0,,Kolu çekiyorum!
Dialogue: 0,0:10:32.31,0:10:34.58,Main,Robin,0,0,0,,Herkes avluya düşmüş gibi.
Dialogue: 0,0:10:34.58,0:10:36.32,Main,Robin,0,0,0,,Bittiği anlamına gelmez ama...
Dialogue: 0,0:10:36.32,0:10:38.64,Main,Robin,0,0,0,,...şimdilik peşimizden gelemeyecekler.
Dialogue: 0,0:10:38.64,0:10:40.07,Main,Robin,0,0,0,,Oldukça iyi gitti.
Dialogue: 0,0:10:40.07,0:10:42.12,Main,Franky,0,0,0,,Pislik!
Dialogue: 0,0:10:42.12,0:10:44.95,Main,Franky,0,0,0,,Beni basamak olarak kullanmaya nasıl cüret edersin?!
Dialogue: 0,0:10:45.57,0:10:47.07,Main,Spider,0,0,0,,Lanet olasıcalar!
Dialogue: 0,0:10:47.07,0:10:50.05,Main,Spider,0,0,0,,Yaptığınızın affı yok!
Dialogue: 0,0:10:50.05,0:10:51.81,Main,Spider,0,0,0,,Ben örümceğim!
Dialogue: 0,0:10:51.81,0:10:54.25,Main,Spider,0,0,0,,Hemen oraya geleceğim!
Dialogue: 0,0:10:58.51,0:10:59.59,Main,Franky,0,0,0,,Ne?
Dialogue: 0,0:10:59.59,0:11:01.93,Main,Franky,0,0,0,,Bir şey düşüyor?
Dialogue: 0,0:11:01.93,0:11:02.74,Main,Franky,0,0,0,,Hayır!
Dialogue: 0,0:11:02.74,0:11:04.12,Main,Franky,0,0,0,,Biri geliyor!
Dialogue: 0,0:11:05.25,0:11:08.40,Main,Brook,0,0,0,,Sadece kemikler!
Dialogue: 0,0:11:09.78,0:11:11.79,Main,Brook,0,0,0,,Kemik!
Dialogue: 0,0:11:11.79,0:11:14.01,Main,Usopp,0,0,0,,Hey, dur! Kes şunu!
Dialogue: 0,0:11:14.01,0:11:15.54,Main,Usopp,0,0,0,,Onu öldürme! O bizim arkadaşımız!
Dialogue: 0,0:11:15.54,0:11:16.65,Main,Chopper,0,0,0,,Pislik!
Dialogue: 0,0:11:16.65,0:11:18.84,Main,Chopper,0,0,0,,Pislik, dur!
Dialogue: 0,0:11:19.47,0:11:21.59,Main,Usopp,0,0,0,,Hemen kaç, Nami!
Dialogue: 0,0:11:22.31,0:11:25.89,Main,Lola,0,0,0,,Absalom benim kocam olacak!
Dialogue: 0,0:11:26.29,0:11:28.33,Main,Lola,0,0,0,,Defolun!
Dialogue: 0,0:11:30.85,0:11:34.65,Main,Lola,0,0,0,,Ölmeye hazır ol!
Dialogue: 0,0:11:36.54,0:11:37.88,Main,Nami,0,0,0,,Du-
Dialogue: 0,0:11:38.52,0:11:39.84,Main,Nami,0,0,0,,Dur biraz!
Dialogue: 0,0:11:40.16,0:11:40.97,Main,Nami,0,0,0,,Ben...
Dialogue: 0,0:11:40.97,0:11:42.22,Main,Nami,0,0,0,,Ben...
Dialogue: 0,0:11:43.16,0:11:44.49,Main,Nami,0,0,0,,Ben aslında erkeğim!
Dialogue: 0,0:11:50.09,0:11:51.06,Main,Usopp,0,0,0,,Hey, hey.
Dialogue: 0,0:11:52.25,0:11:53.26,Main,Lola,0,0,0,,Doğru mu?!
Dialogue: 0,0:11:53.26,0:11:54.36,Main,Nami,0,0,0,,Evet!
Dialogue: 0,0:11:54.36,0:11:55.75,Main,Nami,0,0,0,,Bu benim hobim!
Dialogue: 0,0:11:55.75,0:11:57.73,Main,Nami,0,0,0,,Şaka değil!
Dialogue: 0,0:11:57.99,0:11:59.19,Main,Nami,0,0,0,,Ayrıca...
Dialogue: 0,0:11:59.19,0:12:02.41,Main,Nami,0,0,0,,...sen ve o hayvan adam birbiriniz için yaratılmışsınız!
Dialogue: 0,0:12:02.41,0:12:04.51,Main,Nami,0,0,0,,Size tam destek verebileceğimi düşündüm!
Dialogue: 0,0:12:05.01,0:12:05.64,Main,Lola,0,0,0,,Cidden mi?!
Dialogue: 0,0:12:05.64,0:12:06.45,Main,Nami,0,0,0,,Gerçekten!
Dialogue: 0,0:12:06.45,0:12:08.51,Main,Nami,0,0,0,,Şaka değil!
Dialogue: 0,0:12:10.32,0:12:14.39,Main,Lola,0,0,0,,Daha önce hiç kimse bana böyle\Ndestekleyici düşünceler vermedi.
Dialogue: 0,0:12:14.39,0:12:21.61,Main,Lola,0,0,0,,Bana güzel söyler söyleyen ilk kişi sensin.
Dialogue: 0,0:12:21.61,0:12:22.47,Main,Lola,0,0,0,,Ben...
Dialogue: 0,0:12:22.47,0:12:24.44,Main,Lola,0,0,0,,Ben...
Dialogue: 0,0:12:24.44,0:12:26.93,Main,Nami,0,0,0,,Kaldır başını arkadaşım.
Dialogue: 0,0:12:28.10,0:12:31.08,Main,Nami,0,0,0,,Buna arkadaşlık denir.
Dialogue: 0,0:12:31.08,0:12:32.71,Main,Nami,0,0,0,,Adım Namizou.
Dialogue: 0,0:12:32.71,0:12:34.14,Main,Nami,0,0,0,,Nami diyebilirsin.
Dialogue: 0,0:12:34.70,0:12:36.06,Main,Lola,0,0,0,,Arkadaşlık!
Dialogue: 0,0:12:36.06,0:12:37.84,Main,Lola,0,0,0,,Nami!
Dialogue: 0,0:12:39.59,0:12:41.65,Main,Usopp,0,0,0,,Numarayı yedi!
Dialogue: 0,0:12:41.65,0:12:46.26,Main,Nami,0,0,0,,Elbette kendinde değilken onun mührünü basamazsın.
Dialogue: 0,0:12:46.26,0:12:48.51,Main,Nami,0,0,0,,O uyurken yaparsan-
Dialogue: 0,0:12:48.51,0:12:49.89,Main,Lola,0,0,0,,Uyurken saldırayım mı?!
Dialogue: 0,0:12:49.89,0:12:51.85,Main,Lola,0,0,0,,Olur mu?! Bir insan olarak?!
Dialogue: 0,0:12:51.85,0:12:54.30,Main,Nami,0,0,0,,Ama Lola, sen zombi değil misin?
Dialogue: 0,0:12:54.30,0:12:57.53,Main,Lola,0,0,0,,Bu çok kötü! Rezilce bir şey!
Dialogue: 0,0:12:57.53,0:13:00.36,Main,Nami,0,0,0,,Uyuduğu ve farketmediği sürece sorun değil.
Dialogue: 0,0:13:00.36,0:13:02.23,Main,Usopp,0,0,0,,Hey, Namizou.
Dialogue: 0,0:13:02.23,0:13:03.80,Main,Usopp,0,0,0,,Şimdi buradan çıkabilir miyiz?
Dialogue: 0,0:13:04.31,0:13:05.99,Main,Nami,0,0,0,,Sahi, Lola.
Dialogue: 0,0:13:05.99,0:13:08.93,Main,Nami,0,0,0,,Demin hazine deposunda bir şey düşürdüm.
Dialogue: 0,0:13:09.65,0:13:13.54,Main,Nami,0,0,0,,Geri almak istiyorum ama yolu hatırlayamıyorum. \NBana söyleyebilir misin?
Dialogue: 0,0:13:13.54,0:13:15.04,Main,Lola,0,0,0,,Ne aptalsın.
Dialogue: 0,0:13:15.04,0:13:16.20,Main,Lola,0,0,0,,Ama sorun değil.
Dialogue: 0,0:13:16.20,0:13:19.38,Main,Lola,0,0,0,,Oradaki Leydi Perona'nın odasının en yakınından geçen yol.
Dialogue: 0,0:13:19.58,0:13:20.19,Main,Lola,0,0,0,,Görüyor musun?
Dialogue: 0,0:13:20.19,0:13:24.66,Main,Usopp,0,0,0,,Kendini tamamen kaptırmış. Bundan kurtulamayacak.
Dialogue: 0,0:13:20.19,0:13:23.14,Secondary,Lola,0,0,0,,Oradaki çok yüksek kuleyi görüyor musun?
Dialogue: 0,0:13:23.14,0:13:26.70,Secondary,Lola,0,0,0,,O yoldan dümdüz gidersen, \Nkuleye çıkan merdivenlere varacaksın.
Dialogue: 0,0:13:24.66,0:13:26.70,Thoughts,Chopper,0,0,0,,Demek bunca zamandır Nami erkekti.
Dialogue: 0,0:13:27.52,0:13:30.76,Thoughts,Chopper,0,0,0,,Hep biraz erkeksi davrandığını düşünmüştüm.
Dialogue: 0,0:13:31.79,0:13:33.97,Main,Usopp,0,0,0,,Hey, Nami! O adam bize erişti.
Dialogue: 0,0:13:33.97,0:13:35.18,Main,Nami,0,0,0,,Cidden?!
Dialogue: 0,0:13:35.18,0:13:37.50,Main,Nami,0,0,0,,Lola! Saldırı Fırsatı!
Dialogue: 0,0:13:37.90,0:13:40.57,Main,Nami,0,0,0,,Bir daha onunla asla karşılaşmayacağım,\Nbu yüzden iyi olacaksın!
Dialogue: 0,0:13:40.57,0:13:43.26,Main,Nami,0,0,0,,Elinden geleni yap! İkiniz en iyi çift olacaksınız!
Dialogue: 0,0:13:43.26,0:13:45.05,Main,Lola,0,0,0,,Sağol, Nami!
Dialogue: 0,0:13:45.45,0:13:48.55,Main,Lola,0,0,0,,Kendime güvenim yerine geldi!
Dialogue: 0,0:13:48.55,0:13:52.83,Main,Lola,0,0,0,,Absalom!
Dialogue: 0,0:13:52.83,0:13:54.02,Main,Absalom,0,0,0,,Lola!
Dialogue: 0,0:13:55.04,0:13:57.28,Main,Nami,0,0,0,,Siz, fırsat ayağımıza geldi!
Dialogue: 0,0:13:57.28,0:14:00.21,Main,Chopper,0,0,0,,Vahşi domuz Nami'yi incitmedi.
Dialogue: 0,0:14:00.21,0:14:01.90,Main,Chopper,0,0,0,,Nami, inanılmazsın!
Dialogue: 0,0:14:02.38,0:14:05.63,Main,Nami,0,0,0,,Onunla konuşursan, o kadar da kötü olmadığını farkedeceksin.
Dialogue: 0,0:14:05.63,0:14:08.07,Main,Usopp,0,0,0,,Yine şu tuhaf bakışın var!
Dialogue: 0,0:14:11.78,0:14:14.54,Main,Perona,0,0,0,,Koca gemide tek bir hazine sandığı bile yok mu?!
Dialogue: 0,0:14:14.54,0:14:18.00,Main,Zombie,0,0,0,,Evet, birkaç tane var ama neredeyse boşlar.
Dialogue: 0,0:14:18.00,0:14:21.01,Main,Zombie,0,0,0,,Geriye kalan tek şey, sadece biraz para.
Dialogue: 0,0:14:21.01,0:14:25.86,Main,Perona,0,0,0,,Bu iki geminin bize neredeyse hiç ganimet vermemesine şaşırdım.
Dialogue: 0,0:14:25.86,0:14:29.43,Main,Perona,0,0,0,,Bu gerçekten Crocodile'i yenen adamın gemisi mi?
Dialogue: 0,0:14:30.36,0:14:31.79,Main,Perona,0,0,0,,Neyse, önemli değil.
Dialogue: 0,0:14:31.79,0:14:34.82,Main,Perona,0,0,0,,Varsa biraz erzak taşıyın.
Dialogue: 0,0:14:34.82,0:14:35.70,Main,Zombie,0,0,0,,Peki.
Dialogue: 0,0:14:35.70,0:14:37.41,Main,Hildon,0,0,0,,Perona-sama!
Dialogue: 0,0:14:38.24,0:14:39.48,Main,Perona,0,0,0,,Hildon.
Dialogue: 0,0:14:40.30,0:14:43.38,Main,Hildon,0,0,0,,Moria-sama, Üç Gizemli İnsan'ı çağırdı.
Dialogue: 0,0:14:43.38,0:14:44.82,Main,Perona,0,0,0,,Efendi mi?
Dialogue: 0,0:14:44.82,0:14:45.82,Main,Perona,0,0,0,,Niçin?
Dialogue: 0,0:14:45.82,0:14:48.96,Main,Hildon,0,0,0,,Görünüşe göre Hasır Şapkalı Luffy yakalanmış.
Dialogue: 0,0:14:48.96,0:14:51.72,Main,Hildon,0,0,0,,No: 900'ü uyandırma vakti geldi.
Dialogue: 0,0:14:51.72,0:14:53.14,Main,Perona,0,0,0,,No: 900?!
Dialogue: 0,0:14:53.14,0:14:54.28,Main,Perona,0,0,0,,Ciddi misin?!
Dialogue: 0,0:14:54.28,0:14:56.05,Main,Lola,0,0,0,,Ab-sama!
Dialogue: 0,0:14:56.05,0:14:59.28,Main,Lola,0,0,0,,Absalom, seni pislik! Gel ve benimle evlen!
Dialogue: 0,0:14:59.28,0:15:01.75,Main,Lola,0,0,0,,Yine ortadan kayboldun ve kaçtın, değil mi?!
Dialogue: 0,0:15:02.11,0:15:03.83,Main,Absalom,0,0,0,,Tuhaf.
Dialogue: 0,0:15:03.83,0:15:06.17,Main,Absalom,0,0,0,,Kaçabilecekleri başka bir yer yok.
Dialogue: 0,0:15:09.06,0:15:10.97,Main,Absalom,0,0,0,,Hey, Ayıcık!
Dialogue: 0,0:15:10.97,0:15:13.51,Main,Bearsy,0,0,0,,Absalom-sama, bir sorunum var.
Dialogue: 0,0:15:13.51,0:15:14.86,Main,Bearsy,0,0,0,,Bir şey beni rahatsız ediyor.
Dialogue: 0,0:15:14.86,0:15:18.17,Main,Absalom,0,0,0,,Dur, benim meselem öncelikli.
Dialogue: 0,0:15:18.17,0:15:21.02,Main,Absalom,0,0,0,,Buraya üç korsan geldi mi?
Dialogue: 0,0:15:21.83,0:15:23.37,Main,Bearsy,0,0,0,,O...
Dialogue: 0,0:15:23.37,0:15:24.94,Main,Perona,0,0,0,,Absalom!
Dialogue: 0,0:15:25.46,0:15:27.33,Main,Perona,0,0,0,,Burada ne yapıyorsun?
Dialogue: 0,0:15:27.33,0:15:28.59,Main,Perona,0,0,0,,Burası benim odam.
Dialogue: 0,0:15:28.59,0:15:29.69,Main,Absalom,0,0,0,,Perona.
Dialogue: 0,0:15:30.11,0:15:33.17,Main,Bearsy,0,0,0,,Hoşgeldin, Perona-sama.
Dialogue: 0,0:15:33.17,0:15:34.56,Main,Perona,0,0,0,,Konuşma, Ayıcık!
Dialogue: 0,0:15:34.56,0:15:36.66,Main,Perona,0,0,0,,Kaç kez söylemek zorundayım?!
Dialogue: 0,0:15:37.02,0:15:38.71,Main,Bearsy,0,0,0,,Ama önemli bir şey-
Dialogue: 0,0:15:38.71,0:15:39.63,Main,Perona,0,0,0,,Sessiz ol!
Dialogue: 0,0:15:39.63,0:15:40.62,Main,Perona,0,0,0,,Konuşma.
Dialogue: 0,0:15:40.89,0:15:44.52,Main,Absalom,0,0,0,,Ayıcığa karşı her zamanki gibi sertsin.
Dialogue: 0,0:15:44.52,0:15:45.29,Main,Absalom,0,0,0,,Sertıcık.
Dialogue: 0,0:15:45.29,0:15:47.30,Main,Perona,0,0,0,,Sessiz ol, o benim emrimde.
Dialogue: 0,0:15:48.66,0:15:49.98,Main,Perona,0,0,0,,Asıl önemlisi duydun mu?
Dialogue: 0,0:15:49.98,0:15:52.94,Main,Perona,0,0,0,,Efendi bizi çağırıyor.
Dialogue: 0,0:15:52.94,0:15:54.15,Main,Absalom,0,0,0,,Bir şey mi oldu?
Dialogue: 0,0:15:54.15,0:15:56.23,Main,Perona,0,0,0,,Evet, oldu. Ne olduğunu söyleyeceğim!
Dialogue: 0,0:15:56.23,0:15:58.56,Main,Perona,0,0,0,,No: 900 uyandırılacak.
Dialogue: 0,0:15:58.56,0:16:00.10,Main,Absalom,0,0,0,,900?!
Dialogue: 0,0:16:00.97,0:16:02.82,Main,Absalom,0,0,0,,300 milyonluk adamı yakaladı mı?!
Dialogue: 0,0:16:02.82,0:16:05.81,Main,Nami,0,0,0,,Nasılsa onlardan güç bela saklanabiliyoruz.
Dialogue: 0,0:16:02.82,0:16:03.52,Secondary,Absalom,0,0,0,,300 milyonluk adamı yakaladı mı?!
Dialogue: 0,0:16:05.81,0:16:07.11,Main,Nami,0,0,0,,Bu bir mucize.
Dialogue: 0,0:16:07.11,0:16:11.35,Main,Chopper,0,0,0,,Niye böyle bir yerde saklanıyoruz?!
Dialogue: 0,0:16:11.35,0:16:13.25,Main,Usopp,0,0,0,,Başka çaremiz yok!
Dialogue: 0,0:16:13.25,0:16:16.61,Main,Usopp,0,0,0,,O hayvan adamın bize bu kadar\Nçabuk erişeceğini düşünmemiştim!
Dialogue: 0,0:16:16.61,0:16:19.65,Main,Usopp,0,0,0,,Dahası o adamın zombi olduğunu sanmıyorum.
Dialogue: 0,0:16:19.65,0:16:21.96,Main,Usopp,0,0,0,,Fırsatımız olunca buradan çıkacağız, tamam mı?
Dialogue: 0,0:16:21.96,0:16:24.00,Main,Hildon,0,0,0,,Absalom-sama!
Dialogue: 0,0:16:24.00,0:16:25.87,Main,Hildon,0,0,0,,Demek buradaydın.
Dialogue: 0,0:16:25.87,0:16:27.76,Main,Hildon,0,0,0,,İlginç bir bilgi getirdim.
Dialogue: 0,0:16:27.76,0:16:28.59,Main,Absalom,0,0,0,,Nedir?
Dialogue: 0,0:16:28.98,0:16:32.70,Main,Hildon,0,0,0,,Korsanlarla birlikte başka bir davetsiz misafir daha var.
Dialogue: 0,0:16:32.70,0:16:34.47,Main,Absalom,0,0,0,,Davetsiz misafir?
Dialogue: 0,0:16:34.47,0:16:36.93,Main,Hildon,0,0,0,,"Şarkı Mırıldanan" Şövalye Ruhlu Kılıç Ustası.
Dialogue: 0,0:16:36.93,0:16:38.60,Main,Absalom,0,0,0,,Ne?!
Dialogue: 0,0:16:44.96,0:16:47.65,Main,Zombie,0,0,0,,Gökyüzünden biri düştü.
Dialogue: 0,0:16:47.88,0:16:50.15,Main,Franky,0,0,0,,Hey, o düşen neydi?
Dialogue: 0,0:16:51.21,0:16:52.40,Main,Robin,0,0,0,,Yoksa...
Dialogue: 0,0:16:53.94,0:16:54.78,Main,Franky,0,0,0,,Şey...
Dialogue: 0,0:16:54.78,0:16:57.87,Main,Franky,0,0,0,,...işarete bakarak anlayabilirim.
Dialogue: 0,0:17:13.61,0:17:17.24,Main,Spider,0,0,0,,Tuhaf bir kesintiydi ama benden kaçamazsınız.
Dialogue: 0,0:17:17.76,0:17:21.18,Main,Spider,0,0,0,,İhtiyacım kadar basamak yapabilirim.
Dialogue: 0,0:17:21.18,0:17:23.68,Main,Spider,0,0,0,,Maymun! Maymun!
Dialogue: 0,0:17:24.04,0:17:26.58,Main,Franky,0,0,0,,Hey, bana biraz zaman kazandır.
Dialogue: 0,0:17:26.58,0:17:28.35,Main,Robin,0,0,0,,Ne yapacaksın?
Dialogue: 0,0:17:28.35,0:17:30.77,Main,Franky,0,0,0,,Burada güzel taş sütunlar var.
Dialogue: 0,0:17:30.77,0:17:33.30,Main,Franky,0,0,0,,Küçük bir silah yapacağım.
Dialogue: 0,0:17:34.69,0:17:36.87,Main,Spider,0,0,0,,{\fad(150,0)}Yapışkan...
Dialogue: 0,0:17:36.87,0:17:38.49,Main,Spider,0,0,0,,{\fad(0,150)}...Örümcek Ağı!
Dialogue: 0,0:17:40.21,0:17:41.66,Thoughts,Robin,0,0,0,,Ellerindeki bezeden çıkıyor.
Dialogue: 0,0:17:42.06,0:17:43.22,Main,Robin,0,0,0,,{\fad(150,150)}Seis Fleur...
Dialogue: 0,0:17:42.06,0:17:43.22,Note,Robin,0,0,0,,{\fad(150,150)}6 Çiçek!
Dialogue: 0,0:17:47.62,0:17:48.29,Main,Robin,0,0,0,,{\fad(150,0)}Tokatla.
Dialogue: 0,0:17:51.15,0:17:53.37,Main,Spider,0,0,0,,Gözüme bir şey dokundu!
Dialogue: 0,0:17:53.37,0:17:55.09,Main,Spider,0,0,0,,Yapıştı!
Dialogue: 0,0:17:55.09,0:17:59.07,Main,Spider,0,0,0,,Yapışkan ağla kendimi yapıştırdım!
Dialogue: 0,0:17:59.07,0:18:01.64,Main,Franky,0,0,0,,Tamam, Nico Robin. Hazırım.
Dialogue: 0,0:18:01.64,0:18:03.13,Main,Franky,0,0,0,,Geri çekil.
Dialogue: 0,0:18:03.13,0:18:04.39,Main,Robin,0,0,0,,O da ne?
Dialogue: 0,0:18:04.39,0:18:09.54,Main,Franky,0,0,0,,Ne, sadece taşımakta olduğum\Nmınçıkaları aldım ve bu sütunlara taktım.
Dialogue: 0,0:18:10.67,0:18:15.34,Main,Franky,0,0,0,,Bu kadar büyük bir canavara,\Naynı büyüklükte bir silah gerekir.
Dialogue: 0,0:18:16.79,0:18:18.51,Main,Franky,0,0,0,,{\fad(150,150)}Ağır Mınçıka!
Dialogue: 0,0:18:24.39,0:18:26.38,Thoughts,Spider,0,0,0,,{\i1}Onun gücü ne öyle?{\i0}
Dialogue: 0,0:18:26.38,0:18:28.83,Thoughts,Spider,0,0,0,,{\i1}Gerçekten insan mı bu adam?{\i0}
Dialogue: 0,0:18:39.45,0:18:41.78,Main,Spider,0,0,0,,Kes şunu, pislik!
Dialogue: 0,0:18:42.97,0:18:44.61,Main,Spider,0,0,0,,{\fad(150,150)}Yapışkan Örümcek Ağı!
Dialogue: 0,0:18:52.79,0:18:54.27,Main,Franky,0,0,0,,{\fad(150,0)}Sol...
Dialogue: 0,0:18:54.27,0:18:55.27,Main,Franky,0,0,0,,{\fad(0,150)}...Silahlar!
Dialogue: 0,0:19:04.99,0:19:05.83,Main,Franky,0,0,0,,Nico Robin!
Dialogue: 0,0:19:06.31,0:19:08.00,Main,Franky,0,0,0,,O şeyler de ne?!
Dialogue: 0,0:19:08.00,0:19:12.50,Main,Mouse,0,0,0,,Fare! Fare!
Dialogue: 0,0:19:13.02,0:19:14.27,Main,Robin,0,0,0,,Üzgünüm.
Dialogue: 0,0:19:14.27,0:19:15.36,Main,Robin,0,0,0,,Tedbiri elden bıraktım.
Dialogue: 0,0:19:15.36,0:19:17.46,Main,Robin,0,0,0,,Başka örümcekler olduğunu düşünmemiştim.
Dialogue: 0,0:19:25.14,0:19:27.68,Main,Franky,0,0,0,,K-Kahretsin!
Dialogue: 0,0:19:31.41,0:19:32.92,Main,Spider,0,0,0,,Aptallar.
Dialogue: 0,0:19:32.92,0:19:35.26,Main,Spider,0,0,0,,Maymun, maymun...
Dialogue: 0,0:19:37.30,0:19:40.17,Main,Spider,0,0,0,,Mesele tedbiri elden bırakmanız değil.
Dialogue: 0,0:19:40.17,0:19:43.79,Main,Spider,0,0,0,,Bunlar, emrimdeki Örümcek Fareler.
Dialogue: 0,0:19:43.79,0:19:48.13,Main,Spider,0,0,0,,Thriller Bark'da onlardan 500 kadar var.
Dialogue: 0,0:19:48.13,0:19:53.42,Main,Spider,0,0,0,,Yakaladığımız tek bir avın bile kaçmasına izin vermedik!
Dialogue: 0,0:19:53.93,0:19:59.13,Main,Spider,0,0,0,,Pusuya düşürmek için her yerde bekleriz. \NKaranlıktan ve kör noktalardan düşmanımızı yakalarız.
Dialogue: 0,0:19:59.13,0:20:04.80,Main,Spider,0,0,0,,Hiçbir insan gücünün parçalayamaması için,\Nağımız Hogback-sama tarafından güçlendirildi.
Dialogue: 0,0:20:05.11,0:20:11.58,Main,Mouse,0,0,0,,Malikânedeyken tavanın üstünden arkadaşlarınızı taşıdık.
Dialogue: 0,0:20:11.58,0:20:15.98,Main,Mouse,0,0,0,,Şimdi sizi de arkadaşlarınızın olduğu yere götüreceğiz.
Dialogue: 0,0:20:15.98,0:20:18.36,Main,Mouse,0,0,0,,Vazgeçin artık!
Dialogue: 0,0:20:20.79,0:20:22.98,Jungle P lyrics,,0,0,0,,ヨホホホー \N♪ Yohohohoo ♪
Dialogue: 0,0:20:22.98,0:20:26.60,Jungle P lyrics,,0,0,0,,ヨーホホーホー \N♪ Yoohoohohoo ♪
Dialogue: 0,0:20:26.60,0:20:29.04,Jungle P lyrics,,0,0,0,,ヨホホホー \N♪ Yohohohoo ♪
Dialogue: 0,0:20:29.04,0:20:30.45,Jungle P lyrics,,0,0,0,,ヨーホホーホー\N♪ Yoohoohohoo ♪
Dialogue: 0,0:20:26.93,0:20:27.92,Main,Spider,0,0,0,,Kim o?
Dialogue: 0,0:20:27.92,0:20:29.89,Main,Spider,0,0,0,,Kim şarkı söylüyor?!
Dialogue: 0,0:20:32.25,0:20:35.64,Jungle P lyrics,Brook,0,0,0,,ビンクスの酒を\N♪ Bink'in sakesini teslim edecek. ♪
Dialogue: 0,0:20:35.64,0:20:44.22,Jungle P lyrics,Brook,0,0,0,,届けにゆくよ海風気まかせ波まかせ\N♪ Dalgalar arasındaki deniz rüzgarını takip ederek istediğini yapıyor. ♪
Dialogue: 0,0:20:45.05,0:20:51.17,Jungle P lyrics,Brook,0,0,0,,潮の向こうで夕日も騒ぐ\N♪ Gelgitin diğer tarafında, batan güneşten dehşete kapıldı. ♪
Dialogue: 0,0:20:51.17,0:20:56.49,Jungle P lyrics,Brook,0,0,0,,空にゃ輪をかく鳥の唄\N♪ Gökte daire çiziyor, bir kuşun şarkısı. ♪
Dialogue: 0,0:20:59.74,0:21:03.28,Main,Brook,0,0,0,,Ah, ah. Herkes bu adaya gelmiş gibi görünüyor.
Dialogue: 0,0:21:04.45,0:21:06.43,Main,Robin,0,0,0,,Aşağıdan nasıl çıktın?
Dialogue: 0,0:21:06.43,0:21:09.60,Main,Brook,0,0,0,,Zıpladım. Sonuçta çok hafifim.
Dialogue: 0,0:21:09.60,0:21:12.25,Main,Brook,0,0,0,,Geldiğinize göre sanırım başka çare yok.
Dialogue: 0,0:21:13.10,0:21:15.75,Main,Brook,0,0,0,,Size bu adayla ilgili her şeyi anlatacağım.
Dialogue: 0,0:21:16.02,0:21:18.02,Main,Spider,0,0,0,,Hey, pislik! Kimsin sen?!
Dialogue: 0,0:21:18.02,0:21:19.21,Main,Spider,0,0,0,,Zombi değilsin!
Dialogue: 0,0:21:20.10,0:21:22.13,Main,Spider,0,0,0,,Korsanların arkadaşlarından birisin, değil mi?!
Dialogue: 0,0:21:22.44,0:21:23.67,Main,Franky,0,0,0,,Hey, İskelet!
Dialogue: 0,0:21:24.52,0:21:26.40,Main,Brook,0,0,0,,Evet, evet.
Dialogue: 0,0:21:26.40,0:21:27.64,Main,Brook,0,0,0,,Sorun yok.
Dialogue: 0,0:21:28.48,0:21:30.98,Main,Brook,0,0,0,,Dövüşe son verdim.
Dialogue: 0,0:21:33.91,0:21:36.52,Main,Brook,0,0,0,,{\fad(150,0)}Üç Blokluk Şarkı Mırıldanışı.
Dialogue: 0,0:21:36.52,0:21:37.92,Main,Brook,0,0,0,,{\fad(0,150)}Çentik Ok Vuruşu!
