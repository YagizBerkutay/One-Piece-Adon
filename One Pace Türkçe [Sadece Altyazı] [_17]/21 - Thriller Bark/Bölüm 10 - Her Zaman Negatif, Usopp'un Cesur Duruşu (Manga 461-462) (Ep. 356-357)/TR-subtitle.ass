F,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,2,0,2,10,10,15,1Style: Author,Impress BT,25,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1,1,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:01.35,0:00:05.47,Jungle P lyrics,,0,0,0,,Dünyanın her yerindeki denizlerde yolculuk edelim.Dialogue: 0,0:00:05.68,0:00:07.85,Jungle P lyrics,,0,0,0,,Savaş naramızı yükselterek.Dialogue: 0,0:00:08.00,0:00:12.19,Jungle P lyrics,,0,0,0,,Kararını verdiysen, bırak kalkış sinyali...Dialogue: 0,0:00:12.32,0:00:14.63,Jungle P lyrics,,0,0,0,,...çalınsın!Dialogue: 0,0:00:21.87,0:00:25.34,Jungle P lyrics,,0,0,0,,Sabit rotadan kaçabildik,...Dialogue: 0,0:00:23.44,0:00:28.96,Credits,,0,0,0,,Translation & initial syncing Vegapunk FansubsDialogue: 0,0:00:25.47,0:00:28.89,Jungle P lyrics,,0,0,0,,...denizle gök arasındaki sınır boyunca.Dialogue: 0,0:00:29.01,0:00:34.15,Jungle P lyrics,,0,0,0,,Şimdi kürek ççekerek yolumuzu açıyoruz...Dialogue: 0,0:00:29.36,0:00:34.53,Credits,,0,0,0,,Syncing Galaxy 9000  Sync-checking SewilDialogue: 0,0:00:34.51,0:00:40.67,Jungle P lyrics,,0,0,0,,...denizin karanlık dibindeki gizli bir maceraya doğru.Dialogue: 0,0:00:35.57,0:00:40.68,Credits,,0,0,0,,Quality checking SewilDialogue: 0,0:00:40.72,0:00:47.49,Jungle P lyrics,,0,0,0,,Sırf bunu düşünmek bile kulağa eğlenceli gelmiyor mu?Dialogue: 0,0:00:40.91,0:00:44.08,Credits,,0,0,0,,Video editing SewilDialogue: 0,0:00:44.25,0:00:47.46,Credits,,0,0,0,,Soundtracking HaleeDialogue: 0,0:00:47.79,0:00:51.88,Jungle P lyrics,,0,0,0,,Dünyanın her yerindeki denizlerde yolculuk edelim.Dialogue: 0,0:00:51.98,0:00:54.22,Jungle P lyrics,,0,0,0,,Savaş naramızı yükselterek.Dialogue: 0,0:00:54.35,0:00:58.55,Jungle P lyrics,,0,0,0,,Kararını verdiysen, bırak kalkış sinyali...Dialogue: 0,0:00:58.72,0:01:00.99,Jungle P lyrics,,0,0,0,,...çalınsın!Dialogue: 0,0:01:08.40,0:01:11.57,Jungle P lyrics,,0,0,0,,Yelken açarken hissettiğimiz o his...Dialogue: 0,0:01:11.68,0:01:15.05,Jungle P lyrics,,0,0,0,,...asla unutmayacağım bir şey.Dialogue: 0,0:01:15.22,0:01:16.86,Jungle P lyrics,,0,0,0,,O his sayesinde...Dialogue: 0,0:01:17.04,0:01:20.54,Jungle P lyrics,,0,0,0,,...hiçbir şey beni korkutamayacak.Dialogue: 0,0:01:20.83,0:01:26.77,Jungle P lyrics,,0,0,0,,Şimdi yolculuk yaklaşırken, yarışan kalp atışlarımız...Dialogue: 0,0:01:27.00,0:01:33.72,Jungle P lyrics,,0,0,0,,...utangaç kalplerimize bir macera ritmi kazıyor.Dialogue: 0,0:01:33.92,0:01:38.09,Jungle P lyrics,,0,0,0,,Yüksek sesle gülerken...Dialogue: 0,0:01:38.21,0:01:40.40,Jungle P lyrics,,0,0,0,,...tüm hazineleri al.Dialogue: 0,0:01:40.53,0:01:44.80,Jungle P lyrics,,0,0,0,,Dikkatleri üzerine ççekerek...Dialogue: 0,0:01:44.90,0:01:47.44,Jungle P lyrics,,0,0,0,,...hepsini büyük bir partide harca.Dialogue: 0,0:01:47.90,0:01:49.54,Jungle P lyrics,,0,0,0,,Hayat maceralıdır.Dialogue: 0,0:01:49.54,0:01:51.12,Jungle P lyrics,,0,0,0,,Tehlikesinin farkında ol.Dialogue: 0,0:01:51.12,0:01:52.82,Jungle P lyrics,,0,0,0,,Kim bizden biri olacak?Dialogue: 0,0:01:52.82,0:01:54.41,Jungle P lyrics,,0,0,0,,Ve yolculuk devam ediyor çünkü...Dialogue: 0,0:01:54.41,0:01:56.13,Jungle P lyrics,,0,0,0,,...biz bir grup korsanız!Dialogue: 0,0:01:56.13,0:01:57.91,Jungle P lyrics,,0,0,0,,Batıya, Doğuya.Dialogue: 0,0:01:57.91,0:01:59.38,Jungle P lyrics,,0,0,0,,Yolumu bulmalı, uzaklara yelken açmalıyım.Dialogue: 0,0:01:59.38,0:02:00.38,Jungle P lyrics,,0,0,0,,One Piece'e doğru!Dialogue: 0,0:02:00.57,0:02:04.65,Jungle P lyrics,,0,0,0,,Boş kalbini hayallerle doldur.Dialogue: 0,0:02:04.79,0:02:06.99,Jungle P lyrics,,0,0,0,,Kanatlarını aç.Dialogue: 0,0:02:07.24,0:02:11.31,Jungle P lyrics,,0,0,0,,Kalbini esen rüzgarla boyarsan,...Dialogue: 0,0:02:11.41,0:02:13.65,Jungle P lyrics,,0,0,0,,...ilerlersin.Dialogue: 0,0:02:13.71,0:02:17.83,Jungle P lyrics,,0,0,0,,Yüksek sesle gülerken...Dialogue: 0,0:02:18.00,0:02:20.17,Jungle P lyrics,,0,0,0,,...tüm hazineleri al.Dialogue: 0,0:02:20.30,0:02:24.57,Jungle P lyrics,,0,0,0,,Dikkatleri üzerine ççekerek...Dialogue: 0,0:02:24.74,0:02:27.31,Jungle P lyrics,,0,0,0,,...hepsini büyük bir partide harca.Dialogue: 0,0:02:29.94,0:02:39.94,Author,,0,0,0,, Türkçeleştirme  onepacetr.netDialogue: 0,0:11:47.04,0:11:57.04,Author,,0,0,0,, Türkçeleştirme  onepacetr.netDialogue: 0,0:22:20.00,0:22:30.00,Author,,0,0,0,, Türkçeleştirme  onepacetr.netDialogue: 0,0:02:29.94,0:02:36.92,Title,,0,0,0,,Her Zaman Negatif! Usopp'un Cesur Duruşu!Dialogue: 0,0:02:37.02,0:02:39.70,Captions,,0,0,180,,Thriller Bark İçinde: Gemi Direği MalikânesiDialogue: 0,0:02:36.92,0:02:39.70,Captions small,Sign,0,0,0,,Moria'nın  Dans SalonuDialogue: 0,0:02:36.92,0:02:39.70,Captions small,Sign,0,0,0,,Perona'nın  OdasıDialogue: 0,0:02:39.70,0:02:41.33,Main,Chopper,0,0,0,,Usopp ve Sanji aşağı düştü.Dialogue: 0,0:02:41.33,0:02:43.41,Main,Chopper,0,0,0,,Onları öylece bırakacak mıyız?Dialogue: 0,0:02:43.41,0:02:44.30,Main,Luffy,0,0,0,,Evet!Dialogue: 0,0:02:44.30,0:02:45.70,Main,Luffy,0,0,0,,İyi olacaklar.Dialogue: 0,0:02:45.99,0:02:49.02,Main,Luffy,0,0,0,,Neyse, harekete geçmeden önce Moria'yı bulmalıyız.Dialogue: 0,0:02:49.47,0:02:52.13,Main,Luffy,0,0,0,,O dev pırasayı bulur bulmaz canına okuyacağım!Dialogue: 0,0:02:52.13,0:02:53.40,Main,Chopper,0,0,0,,Tamam!Dialogue: 0,0:02:53.40,0:02:55.82,Main,Chopper,0,0,0,,Tüm sorunları çözmenin en hızlı yolu bu.Dialogue: 0,0:02:56.63,0:03:00.15,Main,Chopper,0,0,0,,O, Luffy'nin gölgesinin götürüldüğü Dans Salonu'na giden giriş!Dialogue: 0,0:03:00.15,0:03:04.85,Main,Chopper,0,0,0,,Moria'yı son olarak, o odanın da ötesindeki dondurucuda gördük.Dialogue: 0,0:03:05.17,0:03:06.43,Main,Luffy,0,0,0,,Tamam!Dialogue: 0,0:03:14.20,0:03:14.91,Main,Hogback,0,0,0,,Siz!Dialogue: 0,0:03:14.91,0:03:16.80,Main,Hogback,0,0,0,,Perona'yı yendiniz mi?!Dialogue: 0,0:03:18.28,0:03:20.09,Main,Chopper,0,0,0,,Hogback!Dialogue: 0,0:03:21.24,0:03:23.47,Main,Hogback,0,0,0,,Bu rengeyiğinin nesi var?Dialogue: 0,0:03:24.37,0:03:26.18,Main,Robin,0,0,0,,O, Dr. Hogback mı?Dialogue: 0,0:03:27.59,0:03:29.68,Main,Luffy,0,0,0,,Moria'nın yanındaki adam.Dialogue: 0,0:03:29.68,0:03:31.85,Main,Luffy,0,0,0,,Bu herifin de canına okuyayım mı?!Dialogue: 0,0:03:31.85,0:03:33.21,Main,Hogback,0,0,0,,D-Durun biraz!Dialogue: 0,0:03:33.68,0:03:34.69,Main,Chopper,0,0,0,,Dur, Luffy!Dialogue: 0,0:03:35.72,0:03:38.54,Main,Chopper,0,0,0,,Niye bu adamı bana bırakmıyorsun?Dialogue: 0,0:03:38.54,0:03:41.07,Main,Chopper,0,0,0,,Oradaki kapı giriş, değil mi?Dialogue: 0,0:03:41.07,0:03:43.18,Main,Chopper,0,0,0,,Orası dondurucu odası.Dialogue: 0,0:03:43.18,0:03:44.37,Main,Chopper,0,0,0,,Önden git!Dialogue: 0,0:03:45.07,0:03:46.62,Main,Luffy,0,0,0,,Tamam! Anladım!Dialogue: 0,0:03:47.41,0:03:50.31,Main,Hogback,0,0,0,,Bu ne terbiyesizlik! Bildiri olmadan Moria-sama'yı görmeye gidecek!Dialogue: 0,0:03:50.81,0:03:52.88,Main,Hogback,0,0,0,,Cindry-chan! Yakala onu!Dialogue: 0,0:03:52.88,0:03:53.54,Main,Cindry,0,0,0,,Tamam!Dialogue: 0,0:03:53.54,0:03:55.24,Main,Cindry,0,0,0,,Bir!Dialogue: 0,0:03:55.24,0:03:56.56,Main,Cindry,0,0,0,,İki!Dialogue: 0,0:03:56.56,0:03:58.07,Main,Luffy,0,0,0,,Ne?! Tabaklar?Dialogue: 0,0:03:59.61,0:04:01.09,Main,Cindry,0,0,0,,Üç!Dialogue: 0,0:04:03.72,0:04:05.14,Main,Hogback,0,0,0,,Ne oldu, Cindry-chan?!Dialogue: 0,0:04:05.53,0:04:07.60,Main,Robin,0,0,0,,Devam et, Luffy.Dialogue: 0,0:04:07.60,0:04:09.64,Main,Luffy,0,0,0,,Sağol, Robin!Dialogue: 0,0:04:09.64,0:04:11.14,Main,Hogback,0,0,0,,Dur, Hasır Şapka!Dialogue: 0,0:04:11.45,0:04:12.39,Main,Chopper,0,0,0,,Hogback!Dialogue: 0,0:04:16.10,0:04:17.98,Main,Chopper,0,0,0,,Beni hayalkırıklığına uğrattın!Dialogue: 0,0:04:17.98,0:04:19.98,Main,Chopper,0,0,0,,Seni doktor olarak kabul etmeyeceğim!Dialogue: 0,0:04:23.47,0:04:25.90,Main,Hogback,0,0,0,,Seni tanıyamadım, Dr. Chopper!Dialogue: 0,0:04:26.58,0:04:29.46,Main,Hogback,0,0,0,,Demek Zoan tipi kullanıcıydın.Dialogue: 0,0:04:29.46,0:04:31.70,Main,Hogback,0,0,0,,Tuhaf bir yaratık olduğunu düşünmeme şaşmamalı.Dialogue: 0,0:04:31.70,0:04:36.96,Main,Hogback,0,0,0,,Perona'nın Bahçesi'nde taşınmaktan nasıl kaçtığınızı bilmiyorum ama...Dialogue: 0,0:04:37.58,0:04:40.97,Main,Hogback,0,0,0,,...bu kez kaçamayacaksın.Dialogue: 0,0:04:40.97,0:04:42.46,Main,Hogback,0,0,0,,Gölgeni alacağım!Dialogue: 0,0:04:45.11,0:04:46.24,Main,Hogback,0,0,0,,Hayır.Dialogue: 0,0:04:46.78,0:04:47.59,Main,Hogback,0,0,0,,Daha iyisi...Dialogue: 0,0:04:48.24,0:04:51.56,Main,Hogback,0,0,0,,...sizi burada öldürüp kuklaya çevirmeme ne dersiniz?Dialogue: 0,0:04:53.33,0:04:55.45,Main,Hogback,0,0,0,,Onlar yapacak.Dialogue: 0,0:04:57.30,0:05:00.34,Main,Luffy,0,0,0,,Bu geçit çok uzun!Dialogue: 0,0:05:02.54,0:05:04.09,Main,Luffy,0,0,0,,Evet! Çıktım!Dialogue: 0,0:05:04.84,0:05:05.82,Main,Luffy,0,0,0,,Burası da ne?Dialogue: 0,0:05:10.95,0:05:12.04,Main,Luffy,0,0,0,,Buldum seni!Dialogue: 0,0:05:12.39,0:05:13.97,Main,Moriah,0,0,0,,Selam!Dialogue: 0,0:05:13.97,0:05:15.33,Main,Moriah,0,0,0,,Sen misin?Dialogue: 0,0:05:27.13,0:05:29.85,Main,Franky,0,0,0,,Bu büyüklük de ne böyle?!Dialogue: 0,0:05:30.28,0:05:32.88,Main,Franky,0,0,0,,Arkaik bir şeytan falan mı bu?!Dialogue: 0,0:05:32.88,0:05:35.02,Main,Franky,0,0,0,,Hiç böyle bir dev görmedim!Dialogue: 0,0:05:35.35,0:05:37.39,Main,Franky,0,0,0,,Bu bir zombi mi?!Dialogue: 0,0:05:38.58,0:05:39.56,Main,Sanji,0,0,0,,Bu...Dialogue: 0,0:05:39.56,0:05:40.81,Main,Sanji,0,0,0,,...Luffy'ninki mi?Dialogue: 0,0:05:40.81,0:05:41.98,Main,Usopp,0,0,0,,Faydasız!Dialogue: 0,0:05:41.98,0:05:43.32,Main,Usopp,0,0,0,,Her şey bitti!Dialogue: 0,0:05:43.32,0:05:46.07,Main,Usopp,0,0,0,,Bizi öldürmeye geldi!Dialogue: 0,0:06:09.10,0:06:10.80,Main,Usopp,0,0,0,,Ne yapmayı planlıyor?!Dialogue: 0,0:06:15.96,0:06:17.87,Main,Oars,0,0,0,,Bu iyi görünüyor.Dialogue: 0,0:06:18.30,0:06:21.81,Main,Oars,0,0,0,,Evet! Şimdi tamamen hazırım!Dialogue: 0,0:06:22.29,0:06:26.40,Main,Oars,0,0,0,,Kesinlikle Korsanlar Kralı olacağım!Dialogue: 0,0:06:27.47,0:06:30.39,Main,Oars,0,0,0,,O bina çökünce biraz şaşırdım.Dialogue: 0,0:06:31.27,0:06:32.74,Main,Usopp,0,0,0,,N-Ne?Dialogue: 0,0:06:33.53,0:06:35.99,Main,Usopp,0,0,0,,Bizi farketmedi bile!Dialogue: 0,0:06:37.06,0:06:40.25,Main,Zoro,0,0,0,,O şeyin konuşması gerçekten Luffy'yi andırıyor.Dialogue: 0,0:06:40.68,0:06:45.05,Main,Zoro,0,0,0,,Öyle bir bedene koyulduğunda Luffy'nin gücü kesinlikle tehlikeli.Dialogue: 0,0:06:45.82,0:06:47.98,Main,Usopp,0,0,0,,Gölgelerinizi...Dialogue: 0,0:06:47.98,0:06:50.36,Main,Usopp,0,0,0,,...unutalım gitsin.Dialogue: 0,0:06:50.36,0:06:52.05,Main,Both,0,0,0,,Tabii ki hayır!Dialogue: 0,0:06:52.05,0:06:56.28,Main,Sanji,0,0,0,,Gölgelerimizden vazgeçsek bile henüz Nami-san'ı kurtarmadık!Dialogue: 0,0:06:56.28,0:06:57.80,Main,Sanji,0,0,0,,Topla kendini!Dialogue: 0,0:06:59.70,0:07:02.90,Main,Sanji,0,0,0,,Ama burayı geçmek sorun olacak.Dialogue: 0,0:07:02.90,0:07:06.82,Main,Sanji,0,0,0,,Görünüşe göre ben ve Usopp, merdivenlerle birlikte düştük ama...Dialogue: 0,0:07:06.82,0:07:09.57,Main,Sanji,0,0,0,,...yolumuzu değiştirmeyi denesek bile,...Dialogue: 0,0:07:10.18,0:07:15.06,Main,Sanji,0,0,0,,...köprü çöktü ve artık gemi direği benzeri o malikâneye gidemeyiz.Dialogue: 0,0:07:15.06,0:07:17.74,Main,Zoro,0,0,0,,Zıplamak da bir seçenek değil.Dialogue: 0,0:07:17.74,0:07:22.85,Main,Usopp,0,0,0,,Kestirme yolumuz zombilerin istila ettiği bir yola dönüştü.Dialogue: 0,0:07:22.85,0:07:25.40,Main,Franky,0,0,0,,Otuz saniye daha dayanın!Dialogue: 0,0:07:26.38,0:07:29.38,Main,Franky,0,0,0,,Bu süsten pek emin değilim.Dialogue: 0,0:07:29.38,0:07:31.63,Main,All,0,0,0,,Köprü yapmış!Dialogue: 0,0:07:32.38,0:07:36.97,Main,Franky,0,0,0,,Tüm bu moloz ve ağaç bir veya iki köprü yapmaya yeter.Dialogue: 0,0:07:36.97,0:07:41.81,Main,Usopp,0,0,0,,Ama bunun acil durum olması bir yana, çok fazla detay vermişsin.Dialogue: 0,0:07:41.81,0:07:44.65,Main,Franky,0,0,0,,Kalitesiz bir iş mi yapmamı bekliyorsunuz?!Dialogue: 0,0:07:44.65,0:07:46.82,Main,Sanji,0,0,0,,Hayır, bu daha iyi.Dialogue: 0,0:07:47.45,0:07:49.31,Main,Sanji,0,0,0,,Neyse, bizi kurtardın. Gidelim!Dialogue: 0,0:08:00.95,0:08:03.25,Main,Sanji,0,0,0,,Bu odanın nesi var böyle?Dialogue: 0,0:08:03.25,0:08:06.25,Main,Zoro,0,0,0,,Epey gözalıcı bir oda.Dialogue: 0,0:08:10.76,0:08:16.80,Main,Perona,0,0,0,,Merdivenlerdeki ve köprüdeki zombilerin sizi avları yapmalarını planlamıştım.Dialogue: 0,0:08:17.29,0:08:19.97,Main,Perona,0,0,0,,Oz'un düşeceğini düşünmedim.Dialogue: 0,0:08:20.75,0:08:22.81,Main,Perona,0,0,0,,Ne meraklı bir baş belası.Dialogue: 0,0:08:25.50,0:08:27.48,Main,Zoro,0,0,0,,O hayaletler...Dialogue: 0,0:08:27.85,0:08:30.94,Main,Zoro,0,0,0,,Yoksa onları kotrol eden o mu?Dialogue: 0,0:08:31.42,0:08:33.57,Main,Zoro,0,0,0,,Neyin nesi bu kız?!Dialogue: 0,0:08:36.11,0:08:41.12,Main,Perona,0,0,0,,Şimdiye dek bu hayaletlerin ne kadar korkunç olduğunu farketmiş olmalısınız!Dialogue: 0,0:08:42.37,0:08:46.46,Main,Perona,0,0,0,,Horo Horo meyvesi sayesinde, istediğim gibi hayaletler oluşturabilecek bir hayalet kadınım!Dialogue: 0,0:08:42.37,0:08:46.46,Main,,0,0,0,,- Horo: Hayalet -Dialogue: 0,0:08:46.46,0:08:49.79,Main,Perona,0,0,0,,Bu hayaletler benim kollarım.Dialogue: 0,0:08:49.79,0:08:52.42,Main,Perona,0,0,0,,İnsanların kalplerini boşaltırlar.Dialogue: 0,0:08:54.31,0:08:57.16,Main,Perona,0,0,0,,Hepinizin işi bitti!Dialogue: 0,0:08:57.53,0:09:02.14,Main,Sanji,0,0,0,,O hayaletlerin bu sevimli-chan tarafından kontrol edildiğine inanamıyorum!Dialogue: 0,0:09:02.14,0:09:04.00,Main,Usopp,0,0,0,,Bunun sırası değil!Dialogue: 0,0:09:04.00,0:09:07.15,Main,Usopp,0,0,0,,O şeyler tarafından vurulursak, işimiz biter!Dialogue: 0,0:09:07.15,0:09:08.86,Main,Franky,0,0,0,,Kaçmaktan başka çare yok!Dialogue: 0,0:09:09.35,0:09:11.34,Main,Zoro,0,0,0,,Kesinlikle tehlikeliler!Dialogue: 0,0:09:11.81,0:09:13.49,Main,Perona,0,0,0,,Negatif Hayalet!Dialogue: 0,0:09:23.65,0:09:28.13,Main,Sanji,0,0,0,,Varlığım bir kurtçuğunkinden bile değersiz.Dialogue: 0,0:09:28.13,0:09:29.40,Main,Franky,0,0,0,,Haklısın.Dialogue: 0,0:09:30.46,0:09:33.42,Main,Franky,0,0,0,,Başıboş köpek olmak istiyorum.Dialogue: 0,0:09:34.38,0:09:39.39,Main,Zoro,0,0,0,,Hepinizle aynı zeminde yürümeyi hak etmiyorum.Dialogue: 0,0:09:39.71,0:09:43.02,Main,Usopp,0,0,0,,Her şey bitti.Dialogue: 0,0:09:45.37,0:09:46.72,Main,Perona,0,0,0,,Yakalayın onları.Dialogue: 0,0:09:49.99,0:09:51.78,Main,Perona,0,0,0,,Ne kadar basit.Dialogue: 0,0:09:51.78,0:09:54.53,Main,Perona,0,0,0,,Sadece yukarıdakiler kaldı.Dialogue: 0,0:09:54.53,0:09:56.96,Main,Usopp,0,0,0,,Rasgele Atışlı Tuz Yıldızı!Dialogue: 0,0:10:00.71,0:10:01.53,Main,Perona,0,0,0,,Kim o?!Dialogue: 0,0:10:07.42,0:10:08.71,Main,Usopp,0,0,0,,Tayfama...Dialogue: 0,0:10:09.40,0:10:11.59,Main,Usopp,0,0,0,,...el sürmene izin vermeyeceğim!Dialogue: 0,0:10:12.32,0:10:13.36,Main,Perona,0,0,0,,Kahretsin!Dialogue: 0,0:10:13.36,0:10:15.67,Main,Perona,0,0,0,,Sadece vurulmuş gibi mi davrandı?Dialogue: 0,0:10:15.83,0:10:17.27,Main,Perona,0,0,0,,Negatif Hayalet!Dialogue: 0,0:10:27.64,0:10:29.14,Main,Perona,0,0,0,,Ne?!Dialogue: 0,0:10:31.01,0:10:32.61,Main,Usopp,0,0,0,,Benim adım,...Dialogue: 0,0:10:33.21,0:10:35.11,Main,Usopp,0,0,0,,...Kaptan Usopp.Dialogue: 0,0:10:35.11,0:10:36.36,Main,Perona,0,0,0,,Niye?!Dialogue: 0,0:10:36.36,0:10:38.40,Main,Perona,0,0,0,,Niye seni etkilemiyor?!Dialogue: 0,0:10:38.40,0:10:40.86,Main,Perona,0,0,0,,Hayalet sana vurdu!Dialogue: 0,0:10:41.26,0:10:43.62,Main,Perona,0,0,0,,Ne tür bir numara kullandın?!Dialogue: 0,0:10:44.39,0:10:46.58,Main,Usopp,0,0,0,,Numara yok.Dialogue: 0,0:10:46.58,0:10:48.45,Main,Usopp,0,0,0,,Ben her zaman...Dialogue: 0,0:10:48.45,0:10:51.47,Main,Usopp,0,0,0,,...NEGATİFTİM!Dialogue: 0,0:10:56.96,0:10:59.99,Main,Zombie,0,0,0,,Hayaletin negatif gücüne karşı bağışıklığı var!Dialogue: 0,0:10:59.99,0:11:01.72,Main,Zombie,0,0,0,,Ne inanılmaz bir adam!Dialogue: 0,0:11:08.39,0:11:10.73,Thoughts,Perona,0,0,0,,Bu mümkün değil.Dialogue: 0,0:11:10.73,0:11:15.19,Thoughts,Perona,0,0,0,,Negatif hayalete karşı bağışıklığı olan bir adamın olması imkansız!Dialogue: 0,0:11:16.59,0:11:18.46,Thoughts,Perona,0,0,0,,İnsanlar hayata sıkıca tutunuyor.Dialogue: 0,0:11:18.46,0:11:22.74,Thoughts,Perona,0,0,0,,Sırf bu gerçek bile onların ilerlemesine izin veriyor ama yine de...Dialogue: 0,0:11:22.74,0:11:25.91,Thoughts,Perona,0,0,0,,Yine de bu adam...Dialogue: 0,0:11:25.91,0:11:29.27,Main,All,0,0,0,,Elinden geleni yap.Dialogue: 0,0:11:27.72,0:11:31.25,Main,Note,0,0,0,,Elinden geleni yap.Dialogue: 0,0:11:27.18,0:11:31.25,Main,Note,0,0,0,,Dövüş!!Dialogue: 0,0:11:27.97,0:11:29.18,Main,Note,0,0,0,,Yaşa!!!Dialogue: 0,0:11:29.24,0:11:31.25,Main,Usopp,0,0,0,,Bana tezahürat yapmayın!Dialogue: 0,0:11:29.24,0:11:31.25,Secondary,All,0,0,0,,Elinden geleni yap!Dialogue: 0,0:11:32.65,0:11:35.35,Main,Usopp,0,0,0,,Kurtulun şu durumdan artık!Dialogue: 0,0:11:35.35,0:11:37.92,Main,Usopp,0,0,0,,Acele edelim ve Nami'yle Brook'u kurtaralım!Dialogue: 0,0:11:38.35,0:11:39.82,Main,Usopp,0,0,0,,Siz...Dialogue: 0,0:11:39.82,0:11:43.51,Main,Usopp,0,0,0,,...değersiz yeteneklerinizle onu yenmeyi umamazsınız.Dialogue: 0,0:11:43.51,0:11:46.14,Main,Usopp,0,0,0,,Onunla ben ilgileneceğim!Dialogue: 0,0:11:47.17,0:11:49.81,Main,Sanji,0,0,0,,Bu güvenilir his de ne?Dialogue: 0,0:11:49.81,0:11:52.14,Main,Zoro,0,0,0,,Etkilenmedi mi?Dialogue: 0,0:11:52.14,0:11:53.52,Main,Perona,0,0,0,,Lanet olası!Dialogue: 0,0:11:53.52,0:11:57.17,Main,Usopp,0,0,0,,Ama etrafındaki zombilerle ilgilenin!Dialogue: 0,0:11:57.17,0:11:59.82,Main,Usopp,0,0,0,,Onları yenemeyeceğimi biliyorsunuz! Kesinlikle ö-Dialogue: 0,0:11:59.82,0:12:01.43,Main,Sanji,0,0,0,,Hepsini sana bırakıyoruz!Dialogue: 0,0:12:01.43,0:12:02.15,Main,Usopp,0,0,0,,Ne? Ah!Dialogue: 0,0:12:02.15,0:12:02.40,Main,Usopp,0,0,0,,Hayır!Dialogue: 0,0:12:02.40,0:12:02.70,Main,Usopp,0,0,0,,Şey!Dialogue: 0,0:12:02.70,0:12:03.63,Main,Usopp,0,0,0,,Durun!Dialogue: 0,0:12:03.63,0:12:04.50,Main,Usopp,0,0,0,,Hayır, ben!Dialogue: 0,0:12:04.50,0:12:05.21,Main,Usopp,0,0,0,,Durun biraz!Dialogue: 0,0:12:05.85,0:12:08.21,Main,Usopp,0,0,0,,Durun!Dialogue: 0,0:12:14.09,0:12:16.33,Main,Zombie,0,0,0,,Damat Absalom,...Dialogue: 0,0:12:16.62,0:12:20.28,Main,Zombie,0,0,0,,...hastalıkta ve sağlıkta, ölüm sizi ayırana dek onu sevmek ve...Dialogue: 0,0:12:20.30,0:12:23.97,Main,Zombie,0,0,0,,...üstüne titremek için Nami'yi karın olarak kabul ediyor musun?Dialogue: 0,0:12:25.80,0:12:26.99,Main,Absalom,0,0,0,,Ediyorum!Dialogue: 0,0:12:30.69,0:12:32.68,Main,Zombie,0,0,0,,Peki, Gelin Nami,...Dialogue: 0,0:12:32.68,0:12:38.44,Main,Zombie,0,0,0,,...sonsuza dek Absalom'u sevmeye yemin ediyor musun?Dialogue: 0,0:12:38.44,0:12:41.11,Main,Zombie,0,0,0,,Evet! Ediyorum!Dialogue: 0,0:12:41.74,0:12:43.36,Main,Zombie,0,0,0,,Ab-sama'yı gerçekten seviyorum!Dialogue: 0,0:12:48.56,0:12:50.58,Main,Zombie,0,0,0,,Gelini öpebilirsiniz.Dialogue: 0,0:13:02.21,0:13:04.05,Main,Perona,0,0,0,,Neresinden bakarsan bak, yine de imkansız!Dialogue: 0,0:13:04.98,0:13:09.93,Main,Perona,0,0,0,,Bu eş zamanlı saldırıyla, iyilik için yaşama arzunu yitireceksin!Dialogue: 0,0:13:11.37,0:13:14.16,Main,Perona,0,0,0,,Dörtlü Negatif Saldırı!Dialogue: 0,0:13:14.16,0:13:16.52,Main,Perona,0,0,0,,Negative Hayaletler!Dialogue: 0,0:13:20.86,0:13:22.32,Main,Wild Zombie,0,0,0,,Onu hakladılar!Dialogue: 0,0:13:22.32,0:13:24.28,Main,Wild Zombie,0,0,0,,Dördü de tamamen içinden geçti!Dialogue: 0,0:13:27.20,0:13:29.55,Main,Wild Zombie,0,0,0,,Thriller Bark kurulduğundan beri,...Dialogue: 0,0:13:29.55,0:13:33.27,Main,Wild Zombie,0,0,0,,...hayaletlerin depresif gücüne bağışıklığı olan kimse ol-Dialogue: 0,0:13:35.30,0:13:37.22,Main,Wild Zombie,0,0,0,,Negatif hayaletler...Dialogue: 0,0:13:37.22,0:13:39.71,Main,Wild Zombie,0,0,0,,...negatif olmuşlar!Dialogue: 0,0:13:39.71,0:13:42.79,Main,Perona,0,0,0,,Ayıcık, her şey için üzgünüm.Dialogue: 0,0:13:42.79,0:13:45.09,Main,Wild Zombie,0,0,0,,Perona-sama bile etkilenmiş!Dialogue: 0,0:13:45.09,0:13:48.16,Main,Wild Zombie,0,0,0,,O adam kutsal biri mi?!Dialogue: 0,0:13:48.16,0:13:49.64,Main,Wild Zombie,0,0,0,,Kutsal bir adam, değil mi?!Dialogue: 0,0:13:50.39,0:13:52.74,Main,Usopp,0,0,0,,Hepiniz iyi dinleyin.Dialogue: 0,0:13:52.74,0:13:56.14,Main,Usopp,0,0,0,,İş negatif düşünmeye geldiğinde,...Dialogue: 0,0:13:56.76,0:13:59.40,Main,Usopp,0,0,0,,...beni geçebilecek kimse yoktur!Dialogue: 0,0:14:00.63,0:14:03.07,Main,Wild Zombie,0,0,0,,Bu kadar faydasız bir şeye o kadar güven duyuyor!Dialogue: 0,0:14:03.17,0:14:06.84,Captions,Sign,0,0,180,,Perona'nın Harika BahçesiDialogue: 0,0:14:03.07,0:14:06.84,Main,Zoro,0,0,600,,Usopp'un negatifliğinin öyle bir yerde faydalı olacağını kim düşünürdü.Dialogue: 0,0:14:06.84,0:14:11.43,Main,Franky,0,0,0,,O olmasaydı, şimdiye ölmüştük.Dialogue: 0,0:14:12.14,0:14:14.77,Main,Zoro,0,0,0,,Ne korkunç bir yeteneği var.Dialogue: 0,0:14:14.77,0:14:18.48,Main,Sanji,0,0,0,,Burada sizden ayrılacağım ve Nami-san'ın olduğu yere gideceğim.Dialogue: 0,0:14:18.48,0:14:19.64,Main,Franky,0,0,0,,Tamam!Dialogue: 0,0:14:19.64,0:14:20.84,Main,Franky,0,0,0,,Elinden geleni yap!Dialogue: 0,0:14:20.84,0:14:22.19,Main,Sanji,0,0,0,,Elbette!Dialogue: 0,0:14:22.19,0:14:24.14,Main,Sanji,0,0,0,,Ben aşkın hayaliyim!Dialogue: 0,0:14:25.12,0:14:27.47,Main,Sanji,0,0,0,,Nami-swan!Dialogue: 0,0:14:28.72,0:14:31.45,Main,Sanji,0,0,0,,Başkasının karısı olmayacaksın!Dialogue: 0,0:14:31.45,0:14:33.12,Main,Zoro,0,0,0,,Atladı.Dialogue: 0,0:14:33.12,0:14:35.65,Main,Zoro,0,0,0,,Ne kadar yüksekte olduğumuzun farkında mı?Dialogue: 0,0:14:35.65,0:14:36.32,Main,Franky,0,0,0,,Neyse.Dialogue: 0,0:14:36.32,0:14:39.81,Main,Franky,0,0,0,,Ne kadar gerilirsen, o kadar az acı hissedersin.Dialogue: 0,0:14:39.81,0:14:42.33,Main,Franky,0,0,0,,Boşver, o malikânenin en üst katına gidiyoruz!Dialogue: 0,0:14:42.33,0:14:43.00,Main,Zoro,0,0,0,,Tamam!Dialogue: 0,0:14:43.00,0:14:45.05,Main,Franky,0,0,0,,İskelet orada olmalı!Dialogue: 0,0:15:03.88,0:15:06.63,Main,Ryuma,0,0,0,,Aynı anka gibi.Dialogue: 0,0:15:06.63,0:15:08.76,Main,Ryuma,0,0,0,,Belki de bir zombi gibi.Dialogue: 0,0:15:09.92,0:15:13.12,Main,Ryuma,0,0,0,,Artık ayağa kalkamaman gerekir.Dialogue: 0,0:15:15.06,0:15:19.09,Main,Ryuma,0,0,0,,Kendi iyiliğin için hareketlerini durdurma zamanım geldi.Dialogue: 0,0:15:19.09,0:15:23.60,Main,Ryuma,0,0,0,,Böylece bir daha gölgeni geri almak için ortaya çıkmayasın.Dialogue: 0,0:15:23.60,0:15:28.99,Main,Ryuma,0,0,0,,İşini özel "Çentik Ok Vuruşu" mla bitirmemi ister misin?Dialogue: 0,0:15:29.84,0:15:32.80,Main,Brook,0,0,0,,Hiçbir şey bilmiyorsun.Dialogue: 0,0:15:33.72,0:15:35.53,Main,Brook,0,0,0,,O adı kullanma!Dialogue: 0,0:15:37.88,0:15:44.39,Main,Brook,0,0,0,,Geldiğim krallığın Sürpriz Saldırı Timi'ne ait çabuk kesim tekniğinin adı,...Dialogue: 0,0:15:44.39,0:15:47.48,Note,Brook,0,0,0,,- Banderole Ağıtı -Dialogue: 0,0:15:44.39,0:15:47.48,Main,Brook,0,0,0,,...Requiem la Banderole*.Dialogue: 0,0:15:47.48,0:15:54.30,Main,Brook,0,0,0,,Arkadaşlarımın çok övdükleri bu kılıç tekniğine verdikleri takma isim,...Dialogue: 0,0:15:54.30,0:15:57.49,Main,Brook,0,0,0,,...Üç Blokluk Şarkı Mırıldanışı Çentik Ok Vuruşu'dur.Dialogue: 0,0:15:57.49,0:16:03.85,Main,Brook,0,0,0,,Kişiliğime ve yeteneklerime sahip olsan da, anılarımı ve insanlığımı yitirmişsin.Dialogue: 0,0:16:03.85,0:16:05.98,Main,Brook,0,0,0,,Bu yüzden o ismi kullanmaya hakkın yok!Dialogue: 0,0:16:07.62,0:16:10.65,Main,Ryuma,0,0,0,,İma ettiğin gibi gerçek olan sen isen,...Dialogue: 0,0:16:10.65,0:16:13.91,Main,Ryuma,0,0,0,,...sahte kılıç yeteneklerimin üstesinden gelmeyi dene!Dialogue: 0,0:16:16.08,0:16:18.44,Main,Ryuma,0,0,0,,Bu son şansın.Dialogue: 0,0:16:49.02,0:16:50.73,Main,Both,0,0,0,,Üç Blokluk Şarkı Mırıldanışı,...Dialogue: 0,0:16:52.32,0:16:53.92,Main,Ryuma,0,0,0,,...Çentik Ok Vuruşu!Dialogue: 0,0:17:01.35,0:17:02.70,Thoughts,Brook,0,0,0,,Laboon!Dialogue: 0,0:17:05.39,0:17:08.46,Thoughts,Brook,0,0,0,,Her şeyden çok, senden özür dilemek isterdim.Dialogue: 0,0:17:10.19,0:17:13.24,Thoughts,Brook,0,0,0,,Bu karanlık denizde 50 uzun yıl geçti...Dialogue: 0,0:17:14.15,0:17:17.05,Thoughts,Brook,0,0,0,,...ama yine de...Dialogue: 0,0:17:17.56,0:17:20.26,Thoughts,Brook,0,0,0,,...hayatta kalmanın bir anlamı yoktu.Dialogue: 0,0:17:20.64,0:17:23.39,Thoughts,Brook,0,0,0,,Çok yalnızım.Dialogue: 0,0:17:24.09,0:17:25.39,Thoughts,Brook,0,0,0,,Hayatım...Dialogue: 0,0:17:28.20,0:17:30.96,Thoughts,Brook,0,0,0,,...yalnızlık içinde geçti.Dialogue: 0,0:17:36.99,0:17:38.68,Main,Ryuma,0,0,0,,Öncelikle...Dialogue: 0,0:17:38.68,0:17:41.62,Main,Ryuma,0,0,0,,...tabii ki şu afrodan kurtulacağım.Dialogue: 0,0:17:51.08,0:17:52.38,Main,Ryuma,0,0,0,,Ne?!Dialogue: 0,0:17:52.38,0:17:54.03,Main,Ryuma,0,0,0,,Malikâne sarsılıyor!Dialogue: 0,0:17:54.03,0:17:56.68,Main,Franky,0,0,0,,Hey! Bu sarsıntı da ne?!Dialogue: 0,0:17:56.68,0:17:58.06,Main,Zoro,0,0,0,,Kim bilir.Dialogue: 0,0:17:58.06,0:17:59.03,Main,Zoro,0,0,0,,Deprem olabilir mi?Dialogue: 0,0:18:01.68,0:18:04.47,Main,Franky,0,0,0,,Laboratuvar burası mı?!Dialogue: 0,0:18:05.89,0:18:06.81,Main,Franky,0,0,0,,Buldum onu!Dialogue: 0,0:18:06.81,0:18:08.52,Main,Franky,0,0,0,,Hey! İskelet!Dialogue: 0,0:18:09.69,0:18:12.11,Main,Franky,0,0,0,,Fena halde hırpalanmışsın.Dialogue: 0,0:18:12.11,0:18:13.48,Main,Franky,0,0,0,,Hala hayatta mısın?!Dialogue: 0,0:18:14.06,0:18:15.59,Main,Franky,0,0,0,,Yaşıyor musun?!Dialogue: 0,0:18:15.59,0:18:17.34,Main,Brooke,0,0,0,,S-Sen...Dialogue: 0,0:18:17.34,0:18:18.45,Main,Brooke,0,0,0,,...niye buradasın?Dialogue: 0,0:18:22.23,0:18:23.76,Main,Ryuuma,0,0,0,,Dokunaklı.Dialogue: 0,0:18:23.76,0:18:26.70,Main,Ryuuma,0,0,0,,Yenilgisinin ardından yenilene acımak!Dialogue: 0,0:18:28.22,0:18:29.46,Main,Zoro,0,0,0,,Dur biraz!Dialogue: 0,0:18:30.88,0:18:32.49,Main,Zoro,0,0,0,,Sen...Dialogue: 0,0:18:32.49,0:18:35.67,Main,Zoro,0,0,0,,...uzun zaman önce bir ejderhayı kestiği söylenen efsanevi samuray mısın?Dialogue: 0,0:18:37.96,0:18:39.67,Main,Zoro,0,0,0,,Seninle tanışmak istiyordum.Dialogue: 0,0:18:43.28,0:18:45.49,Main,,0,0,0,,Öpücük! Öpücük! Öpücük! Öpücük!Dialogue: 0,0:18:45.49,0:18:47.33,Main,Absalom,0,0,0,,Hey! Dur biraz!Dialogue: 0,0:18:47.33,0:18:48.89,Main,Absalom,0,0,0,,Bu sarsıntı da ne?!Dialogue: 0,0:18:48.89,0:18:50.21,Main,Absalom,0,0,0,,Karımı öpemiyorum!Dialogue: 0,0:18:51.03,0:18:52.11,Main,Zombie General,0,0,0,,Absalom-sama!Dialogue: 0,0:18:52.11,0:18:53.25,Main,Absalom,0,0,0,,Ne?!Dialogue: 0,0:18:53.25,0:18:54.63,Main,Absalom,0,0,0,,Bir şey mi buldun?!Dialogue: 0,0:18:54.63,0:18:59.28,Main,Zombie general,0,0,0,,Bu dev gemi Thriller Bark, tuhaf bir akıntıya yakalandı!Dialogue: 0,0:18:59.28,0:19:01.72,Main,Zombie general,0,0,0,,Tüm ada sarsılıyor!Dialogue: 0,0:19:03.26,0:19:04.79,Main,Absalom,0,0,0,,Bu nasıl oldu?!Dialogue: 0,0:19:04.79,0:19:09.47,Main,Zombie general,0,0,0,,Özel Zombi dümenle oynuyor gibi.Dialogue: 0,0:19:09.47,0:19:10.58,Main,Absalom,0,0,0,,Ne?!Dialogue: 0,0:19:10.58,0:19:13.00,Main,Oars,0,0,0,,Kıpırdıyor! Kıpırdıyor!Dialogue: 0,0:19:13.00,0:19:14.14,Main,Absalom,0,0,0,,Zombi Generaller!Dialogue: 0,0:19:14.14,0:19:16.41,Main,Absalom,0,0,0,,Hemen gidin!Dialogue: 0,0:19:16.41,0:19:18.09,Main,Absalom,0,0,0,,Oz'u durdurun!Dialogue: 0,0:19:20.28,0:19:21.39,Main,Zombie general,0,0,0,,Oz!Dialogue: 0,0:19:28.49,0:19:31.57,Main,Zombie general,0,0,0,,Buraya kadar, Özel Zombi Oz.Dialogue: 0,0:19:32.52,0:19:35.00,Main,Zombie general,0,0,0,,Bacaklarını kesmeye başlayın!Dialogue: 0,0:19:37.54,0:19:38.82,Main,Zombie general,0,0,0,,Oz nerede?Dialogue: 0,0:19:39.22,0:19:40.61,Main,Zombie general,0,0,0,,Gitmiş.Dialogue: 0,0:19:40.94,0:19:43.12,Main,Zombie general,0,0,0,,O koca vücutla...Dialogue: 0,0:19:43.12,0:19:45.28,Main,Zombie general,0,0,0,,...nasıl bu kadar hızlı hareket edebilir?Dialogue: 0,0:19:48.83,0:19:49.89,Main,Zombie general,0,0,0,,Buldum onu!Dialogue: 0,0:19:49.89,0:19:50.46,Main,Zombie general,0,0,0,,Yukarıda!Dialogue: 0,0:19:52.50,0:19:54.39,Main,Oars,0,0,0,,Gomu Gomu no...Dialogue: 0,0:19:54.39,0:19:56.71,Main,Oars,0,0,0,,(Aslında lastik değil ama...)Dialogue: 0,0:19:56.71,0:19:58.37,Main,Oars,0,0,0,,...Makineli!Dialogue: 0,0:20:09.53,0:20:14.15,Main,Oars,0,0,0,,Macerama karışmayın!Dialogue: 0,0:20:19.78,0:20:21.20,Main,Absalom,0,0,0,,Yok mu edildiler?!Dialogue: 0,0:20:21.20,0:20:23.66,Main,Absalom,0,0,0,,Buradan gidenler mi?!Dialogue: 0,0:20:23.66,0:20:25.26,Main,Zombie,0,0,0,,E-Evet.Dialogue: 0,0:20:25.26,0:20:27.16,Main,Zombie,0,0,0,,Herkes ezildi.Dialogue: 0,0:20:27.16,0:20:30.77,Main,Absalom,0,0,0,,Onlar bu adanın en üstün Zombi Ordusu!Dialogue: 0,0:20:30.77,0:20:32.52,Main,Absalom,0,0,0,,Zombi Generaller!Dialogue: 0,0:20:32.52,0:20:34.35,Main,Zombie,0,0,0,,Evet, göz açıp kapayıncaya dek...Dialogue: 0,0:20:34.91,0:20:36.94,Main,Absalom,0,0,0,,İmkansız.Dialogue: 0,0:20:36.94,0:20:39.33,Main,Absalom,0,0,0,,Oz'un müttefiğimiz olması gerekmiyor mu?Dialogue: 0,0:20:39.33,0:20:41.55,Main,Absalom,0,0,0,,Niye dikkatsizce sağa sola saldırıyor?Dialogue: 0,0:20:42.20,0:20:45.01,Main,Absalom,0,0,0,,Zombilerin itaat etmekten başka bir şey yapmaması gerekir.Dialogue: 0,0:20:45.01,0:20:47.70,Main,Absalom,0,0,0,,Öyle birine güvenirsek,...Dialogue: 0,0:20:47.70,0:20:50.89,Main,Absalom,0,0,0,,...Thriller Bark'a ne olacağını söylemek mümkün değil!Dialogue: 0,0:20:54.71,0:20:57.73,Main,Sanji,0,0,0,,Nami-swan!Dialogue: 0,0:20:58.82,0:21:01.73,Main,Sanji,0,0,0,,Seni kurtarmaya geldim!Dialogue: 0,0:21:03.28,0:21:05.95,Main,Sanji,0,0,0,,İşte orada!Dialogue: 0,0:21:06.16,0:21:08.57,Main,Absalom,0,0,0,,Hasır Şapkalar'dan biri mi?!Dialogue: 0,0:21:21.67,0:21:23.84,Main,Brook,0,0,0,,Müthiş.Dialogue: 0,0:21:23.84,0:21:26.73,Main,Brook,0,0,0,,Ryuuma'yı geri püskürttü.Dialogue: 0,0:21:26.73,0:21:28.14,Main,Brook,0,0,0,,Kim bu?Dialogue: 0,0:21:28.85,0:21:32.52,Main,Franky,0,0,0,,Sadece üç kılıç tekniği kullanan çılgın bir korsan kılıç ustası.Dialogue: 0,0:21:32.52,0:21:34.14,Main,Franky,0,0,0,,Oldukça güçlü.Dialogue: 0,0:21:34.81,0:21:40.68,Main,Franky,0,0,0,,Gururun izin verirse, senin için gölgeni alabilir.Dialogue: 0,0:21:40.68,0:21:41.76,Main,Franky,0,0,0,,Ne dersin?Dialogue: 0,0:21:41.76,0:21:42.90,Main,Brook,0,0,0,,Gölgemi mi?!Dialogue: 0,0:21:42.90,0:21:44.13,Main,Brook,0,0,0,,Cidden mi?!Dialogue: 0,0:21:44.13,0:21:48.70,Main,Brook,0,0,0,,Yalvarırım. Lütfen, gölgemi-Dialogue: 0,0:21:48.70,0:21:50.60,Main,Zoro,0,0,0,,Kapa çeneni! Sadece sessiz ol!Dialogue: 0,0:21:53.64,0:21:55.25,Main,Franky,0,0,0,,Hey, iskelet!Dialogue: 0,0:21:55.74,0:21:57.35,Main,Zoro,0,0,0,,Senin...Dialogue: 0,0:21:57.35,0:21:59.79,Main,Zoro,0,0,0,,...epey güzel bir kılıcın var.Dialogue: 0,0:22:01.83,0:22:03.75,Main,Ryuma,0,0,0,,İyi gözlerin var.Dialogue: 0,0:22:03.75,0:22:07.63,Main,Ryuma,0,0,0,,Bu kesinlikle 21 Büyük Keskin Kılıç'tan biri.Dialogue: 0,0:22:08.36,0:22:11.10,Main,Ryuma,0,0,0,,İsyan kenarlı siyah bir kılıç,...Dialogue: 0,0:22:11.10,0:22:14.01,Note,Note,0,0,0,,Shusui: Hazan SuyuDialogue: 0,0:22:11.10,0:22:14.01,Main,Ryuma,0,0,0,,...Kötü Ruhlu Karanfil. Ünlü Kılıç, Shusui.Dialogue: 0,0:22:14.01,0:22:17.60,Main,Ryuma,0,0,0,,Her yerde tanınabilecek bir kılıç.Dialogue: 0,0:22:17.98,0:22:20.23,Main,Zoro,0,0,0,,Büyük Keskin Kılıç'tan biri, ha?Dialogue: 0,0:22:20.23,0:22:23.25,Main,Zoro,0,0,0,,Karşıma çıkabilecek şahane bir şey.Dialogue: 0,0:22:23.25,0:22:27.61,Main,Zoro,0,0,0,,Kendine samuray diyen birinden daha azını beklemem.Dialogue: 0,0:22:29.05,0:22:30.00,Main,Zoro,0,0,0,,Tamam o zaman.Dialogue: 0,0:22:30.82,0:22:34.60,Main,Zoro,0,0,0,,Sanırım o kılıcı kullanabilirim.Dialogue: 0,0:22:34.60,0:22:36.68,Main,Brook,0,0,0,,Çok süper birisin!