Dialogue: 0,0:02:29.90,0:02:33.83,Title,,0,0,0,,{\fad(2000,0)}Beyin ve Kas kombinasyonu!\NOz ve Moria, Hasır Şapka'lara Karşı!
Dialogue: 0,0:02:33.83,0:02:36.20,Main,Franky,0,0,0,,Brook, hareket edebiliyor musun?!
Dialogue: 0,0:02:36.20,0:02:38.74,Main,Usopp,0,0,0,,Beni kurtardın. Sağol!
Dialogue: 0,0:02:38.74,0:02:41.63,Main,Brook,0,0,0,,Ağır bir şekilde yaralandığım doğru!
Dialogue: 0,0:02:41.63,0:02:45.57,Main,Brook,0,0,0,,Ama bu tuzu ele geçirmek için,\Nbedenimi mutfağa kadar sürükledim.
Dialogue: 0,0:02:45.57,0:02:51.28,Main,Brook,0,0,0,,Biraz süt buldum ve o kadar lezizdi ki yeniden canlandım!
Dialogue: 0,0:02:51.28,0:02:53.84,Main,Usopp,0,0,0,,Bu ne tür çılgınca kalsiyum etkisi böyle?!
Dialogue: 0,0:02:54.80,0:02:58.27,Main,Brook,0,0,0,,Sütün kemik kırıklarını iyileştirdiğini herkes bilir!
Dialogue: 0,0:02:58.27,0:02:59.26,Main,Usopp,0,0,0,,Yalancı!
Dialogue: 0,0:03:00.95,0:03:06.00,Main,Sanji,0,0,0,,Her ne olduysa gerçek şu ki,\Nihtiyacımız olan tuza şu anda sahibiz.
Dialogue: 0,0:03:06.50,0:03:09.08,Main,Sanji,0,0,0,,Artık mutfağa dönmek mümkün olmadığı için,...
Dialogue: 0,0:03:09.08,0:03:11.96,Main,Sanji,0,0,0,,...Brook'un tuzu son umudumuz.
Dialogue: 0,0:03:11.96,0:03:13.21,Main,Zoro,0,0,0,,Zamanımız tükeniyor.
Dialogue: 0,0:03:13.21,0:03:14.07,Main,Zoro,0,0,0,,Yapalım şunu!
Dialogue: 0,0:03:14.98,0:03:18.91,Main,Zoro,0,0,0,,Şafak sökmeden, bu tuzu\Ncanavarın boğazından geçirmeliyiz.
Dialogue: 0,0:03:18.91,0:03:21.95,Main,Zoro,0,0,0,,Sonra da bu işi bitirmeden Moria'nın canına okumalıyız!
Dialogue: 0,0:03:31.00,0:03:36.04,Main,Moria,0,0,0,,Buraya kadar gelme zahmetine\Ngirdiğim için bana minnettar olmalısınız!
Dialogue: 0,0:03:36.04,0:03:38.88,Main,Moria,0,0,0,,Şu andan itibaren tedbirli olsanız iyi olur.
Dialogue: 0,0:03:39.34,0:03:42.33,Main,Moria,0,0,0,,Ben sadece buradaki yolcu değilim!
Dialogue: 0,0:03:42.33,0:03:46.00,Main,Moria,0,0,0,,En berbat kâbusunuzu göstermeme izin verin!
Dialogue: 0,0:03:46.00,0:03:51.04,Main,Brook,0,0,0,,Lütfen yanınızda dövüşmeme izin\Nverin! Elimden geleni yapacağım!
Dialogue: 0,0:03:51.50,0:03:54.06,Main,Brook,0,0,0,,Gerçi gölgemin geri alınmasının kolayca\Nödenebilecek bir borç olduğuna inanmıyorum.
Dialogue: 0,0:03:54.06,0:03:58.12,Main,Brook,0,0,0,,Olabildiğince yardım etmek için elimden geleni yapacağım!
Dialogue: 0,0:04:01.05,0:04:02.56,Main,Zoro,0,0,0,,Fazla zorlama!
Dialogue: 0,0:04:02.56,0:04:04.89,Main,Zoro,0,0,0,,Sadece tuza göz kulak ol!
Dialogue: 0,0:04:06.49,0:04:08.51,Main,Franky,0,0,0,,Bir deneyelim.
Dialogue: 0,0:04:08.51,0:04:11.02,Main,Franky,0,0,0,,"Anti-Canavar" mermilerimi atacağım!
Dialogue: 0,0:04:12.44,0:04:14.28,Main,Usopp,0,0,0,,Hız, zafere giden yoldur!
Dialogue: 0,0:04:14.28,0:04:16.55,Main,Usopp,0,0,0,,Görünüşe bakılırsa son defasında yeterince hızlı değildik.
Dialogue: 0,0:04:16.55,0:04:17.91,Main,Usopp,0,0,0,,Franky, sana güveniyorum!
Dialogue: 0,0:04:17.91,0:04:20.56,Main,Usopp,0,0,0,,{\fad(150,150)}Kesin Öldürücü Özel Yağ Yıldızı!
Dialogue: 0,0:04:22.14,0:04:23.90,Main,Franky,0,0,0,,Tamam, sıra bende!
Dialogue: 0,0:04:28.41,0:04:29.36,Main,Usopp,0,0,0,,Hayalet!
Dialogue: 0,0:04:29.87,0:04:33.30,Main,Usopp,0,0,0,,{\fad(150,150)}Çok Büyük Ateşkuşu Yıldızı!
Dialogue: 0,0:04:35.69,0:04:37.59,Main,Oz,0,0,0,,Sıcak! Sıcak! Sıcak!
Dialogue: 0,0:04:37.59,0:04:39.07,Main,Moria,0,0,0,,Ne yüzsüzce bir şey.
Dialogue: 0,0:04:39.07,0:04:40.99,Main,Moria,0,0,0,,Hiç zahmet etme, Oz!
Dialogue: 0,0:04:40.99,0:04:45.81,Main,Moria,0,0,0,,Geçmiş hayatının kırıntıları ısı\Nveya acı ilüzyonuna sebep oluyor!
Dialogue: 0,0:04:46.60,0:04:49.73,Main,Moria,0,0,0,,Öyle şeylerin zombiler üstünde etkisi yok!
Dialogue: 0,0:04:49.73,0:04:51.70,Main,Moria,0,0,0,,Sakin ol ve ateşi söndür!
Dialogue: 0,0:04:52.84,0:04:54.99,Main,Chopper,0,0,0,,Fırsat çıktı, Zoro!
Dialogue: 0,0:04:54.99,0:04:55.97,Main,Zoro,0,0,0,,Tamam!
Dialogue: 0,0:05:06.29,0:05:07.75,Main,Zoro,0,0,0,,{\fad(150,150)}Üç Kılıç Stili...
Dialogue: 0,0:05:09.09,0:05:11.00,Main,Zoro,0,0,0,,{\fad(150,150)}...Heykel Kesici!
Dialogue: 0,0:05:15.38,0:05:16.56,Main,Sanji,0,0,0,,Bakalım bunu nasıl bulacaksın!
Dialogue: 0,0:05:17.42,0:05:19.25,Main,Sanji,0,0,0,,{\fad(150,150)}Jenga Topu!
Dialogue: 0,0:05:30.61,0:05:34.48,Main,Oz,0,0,0,,Pislik!
Dialogue: 0,0:05:37.95,0:05:39.76,Main,Franky,0,0,0,,Hey, bu tarafa geliyor!
Dialogue: 0,0:05:41.54,0:05:42.84,Main,Robin,0,0,0,,{\fad(150,150)}Veinte Fleur!
Dialogue: 0,0:05:41.54,0:05:42.84,Note,,0,0,0,,{\fad(150,150)}20 Çiçek!
Dialogue: 0,0:05:46.97,0:05:48.71,Main,Franky,0,0,0,,Kes şunu, sersem!
Dialogue: 0,0:05:56.84,0:05:57.76,Main,Chopper,0,0,0,,Kahretsin!
Dialogue: 0,0:05:57.76,0:05:58.96,Main,Chopper,0,0,0,,Kendi saldırımızı bize çevirdi!
Dialogue: 0,0:05:58.96,0:06:00.87,Main,Sanji,0,0,0,,Hey, iyi misiniz?
Dialogue: 0,0:06:02.01,0:06:05.04,Main,Usopp,0,0,0,,{\fad(150,150)}Yeni silahım Kuwagata'yı seyredin!
Dialogue: 0,0:06:02.01,0:06:05.04,Note,Note,0,0,0,,{\fad(150,150)}Kuwagata: Geyik Böceği
Dialogue: 0,0:06:08.16,0:06:09.75,Main,Franky,0,0,0,,Hey, hazır mısın, Usopp?!
Dialogue: 0,0:06:09.75,0:06:13.66,Main,Usopp,0,0,0,,Evet ama bu şeyi epey güçlü yapmışsın!
Dialogue: 0,0:06:13.66,0:06:15.72,Main,Usopp,0,0,0,,Sonrasında sana ne olacağını bilmiyoruz!
Dialogue: 0,0:06:15.72,0:06:17.79,Main,Franky,0,0,0,,Endişelenme, aptal!
Dialogue: 0,0:06:17.79,0:06:21.29,Main,Franky,0,0,0,,Bu hafta kendimi özellikle süper hissediyorum!
Dialogue: 0,0:06:21.29,0:06:22.72,Main,Usopp,0,0,0,,Geç yerine o zaman!
Dialogue: 0,0:06:22.72,0:06:23.57,Main,Franky,0,0,0,,Tamam!
Dialogue: 0,0:06:23.57,0:06:26.16,Main,Franky,0,0,0,,Elinden geleni yap!
Dialogue: 0,0:06:29.24,0:06:32.06,Main,Usopp,0,0,0,,{\fad(150,150)}Kesin Öldürücü Demir Adam Kuyrukluyıldızı!
Dialogue: 0,0:06:35.44,0:06:37.32,Main,Franky,0,0,0,,Oooh, işte süper diye buna derim!
Dialogue: 0,0:06:37.32,0:06:39.37,Main,Franky,0,0,0,,Umarım bunun için hazırsındır!
Dialogue: 0,0:06:39.37,0:06:43.34,Main,Franky,0,0,0,,Bu silah Deniz Kralları'na karşı kullanılmak\Niçin tasarlanmıştır. Boş Nokta Topu!
Dialogue: 0,0:06:43.34,0:06:45.75,Main,Franky,0,0,0,,Sana yeni bir yırtık oluşturacak!
Dialogue: 0,0:06:45.75,0:06:47.45,Main,Franky,0,0,0,,Al bakalım, Moria!
Dialogue: 0,0:06:51.79,0:06:53.57,Main,Chopper,0,0,0,,Ne inanılmaz bir hareket!
Dialogue: 0,0:06:53.57,0:06:56.53,Main,Zoro,0,0,0,,Bazen o şeyi hareket ettirenin\NLuffy'nin gölgesi olduğunu unutuyorum.
Dialogue: 0,0:07:05.50,0:07:07.34,Main,Usopp,0,0,0,,FRANKY!
Dialogue: 0,0:07:13.24,0:07:14.65,Main,Usopp,0,0,0,,Franky!
Dialogue: 0,0:07:18.12,0:07:20.02,Main,Moria,0,0,0,,Henüz değil, Oz.
Dialogue: 0,0:07:20.02,0:07:22.80,Main,Moria,0,0,0,,Hala biraz nefesi kalmış!
Dialogue: 0,0:07:22.80,0:07:24.22,Main,Moria,0,0,0,,Bitir işini!
Dialogue: 0,0:07:24.69,0:07:25.88,Main,Oz,0,0,0,,Emredersiniz.
Dialogue: 0,0:07:40.92,0:07:42.51,Main,Zoro,0,0,0,,Ona saldırmaya devam mı edeceksin?!
Dialogue: 0,0:07:42.51,0:07:44.29,Main,Chopper,0,0,0,,Kes şunu! Kıpırdayamıyor bile!
Dialogue: 0,0:07:44.95,0:07:46.18,Main,Nami,0,0,0,,{\fad(150,150)}Yıldırım...
Dialogue: 0,0:07:47.16,0:07:48.93,Main,Chopper,0,0,0,,Eh, o bulut...
Dialogue: 0,0:07:48.93,0:07:49.99,Main,Nami,0,0,0,,{\fad(150,150)}...Tempo!
Dialogue: 0,0:07:50.85,0:07:51.90,Main,Chopper,0,0,0,,Yıldırım!
Dialogue: 0,0:07:51.90,0:07:53.32,Main,Chopper,0,0,0,,Bu saldırı...
Dialogue: 0,0:07:56.90,0:07:57.80,Main,Zoro,0,0,0,,Gerçekten işe yaradı mı?
Dialogue: 0,0:07:57.80,0:07:59.09,Main,Zoro,0,0,0,,Ne mükemmel bir atış!
Dialogue: 0,0:07:59.09,0:08:00.83,Main,Sanji,0,0,0,,İklim Aygıtı!
Dialogue: 0,0:08:00.83,0:08:02.76,Main,Sanji,0,0,0,,Yani Nami-san iyi mi?!
Dialogue: 0,0:08:02.76,0:08:04.32,Main,Zombie,0,0,0,,Bir tür ışık var!
Dialogue: 0,0:08:04.32,0:08:05.39,Main,Zombie,0,0,0,,Yıldırım?!
Dialogue: 0,0:08:05.39,0:08:06.63,Main,Zombie,0,0,0,,Durduk yerde mi?!
Dialogue: 0,0:08:06.63,0:08:09.09,Main,Zombie,0,0,0,,Oz onlara yıldırımla saldırmış olmalı!
Dialogue: 0,0:08:09.09,0:08:10.24,Main,Zombie,0,0,0,,Öyle olmalı!
Dialogue: 0,0:08:10.24,0:08:12.70,Main,Sanji,0,0,0,,İşte orada!
Dialogue: 0,0:08:13.14,0:08:14.55,Main,Sanji,0,0,0,,Bu, Nami-san!
Dialogue: 0,0:08:16.63,0:08:18.32,Main,Sanji,0,0,0,,Nami-san!
Dialogue: 0,0:08:18.32,0:08:21.16,Main,Nami,0,0,0,,Hey! Bana bağırma! Farkedecekler!
Dialogue: 0,0:08:21.16,0:08:24.70,Main,Sanji,0,0,0,,Hele şükür! Hele şükür!
Dialogue: 0,0:08:24.70,0:08:27.68,Main,Sanji,0,0,0,,Hele şükür, Nami-san! İyisin!
Dialogue: 0,0:08:27.68,0:08:29.39,Main,Sanji,0,0,0,,İyi olmana çok sevindim!
Dialogue: 0,0:08:29.39,0:08:31.98,Main,Sanji,0,0,0,,Lütfen beceriksizliğim için beni affet!
Dialogue: 0,0:08:31.98,0:08:33.93,Main,Sanji,0,0,0,,Nami-san!
Dialogue: 0,0:08:32.73,0:08:33.93,Secondary,Zoro,0,0,0,,Kahrolası sinir bozucu pislik.
Dialogue: 0,0:08:36.38,0:08:37.91,Main,Oars,0,0,0,,Sen.
Dialogue: 0,0:08:37.91,0:08:39.80,Main,Nami,0,0,0,,Gördün mü?!
Dialogue: 0,0:08:39.86,0:08:42.97,Main,Oz,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:08:43.13,0:08:44.90,Main,Nami,0,0,0,,Ne?! Ha?!
Dialogue: 0,0:08:44.90,0:08:46.61,Main,Nami,0,0,0,,Uzamayacak, değil mi?!
Dialogue: 0,0:08:46.61,0:08:48.47,Main,Chopper,0,0,0,,Ulaşmayacak, değil mi? O saldırı?
Dialogue: 0,0:08:48.85,0:08:49.73,Main,Zoro,0,0,0,,En kısa sürede!
Dialogue: 0,0:08:49.73,0:08:51.21,Main,Zoro,0,0,0,,Franky'yi oradan çıkar!
Dialogue: 0,0:08:52.54,0:08:55.63,Main,Oz,0,0,0,,{\fad(150,150)}...Tabanca!
Dialogue: 0,0:09:01.35,0:09:03.16,Main,Chopper,0,0,0,,Uzadı!
Dialogue: 0,0:09:03.16,0:09:04.34,Main,Chopper,0,0,0,,Ama nasıl?!
Dialogue: 0,0:09:09.98,0:09:11.70,Main,Oz,0,0,0,,Uzadım?
Dialogue: 0,0:09:11.70,0:09:14.30,Main,Oz,0,0,0,,Bu tanıdık geliyor.
Dialogue: 0,0:09:14.30,0:09:15.73,Main,Zoro,0,0,0,,Bu olmuş olamaz!
Dialogue: 0,0:09:15.73,0:09:17.25,Main,Chopper,0,0,0,,Nami!
Dialogue: 0,0:09:16.21,0:09:17.25,Secondary,Sanji,0,0,0,,Nami-san!
Dialogue: 0,0:09:21.52,0:09:22.24,Main,Chopper,0,0,0,,İşte!
Dialogue: 0,0:09:22.24,0:09:23.48,Main,Chopper,0,0,0,,Bu Nami! İyi!
Dialogue: 0,0:09:25.78,0:09:26.77,Main,Chopper,0,0,0,,Hele şükür!
Dialogue: 0,0:09:26.77,0:09:28.50,Main,Chopper,0,0,0,,Robin onu kurtardı!
Dialogue: 0,0:09:33.86,0:09:35.61,Main,Robin,0,0,0,,Şaşırtıcıydı.
Dialogue: 0,0:09:35.61,0:09:37.08,Main,Robin,0,0,0,,İyi misin, Nami?
Dialogue: 0,0:09:37.59,0:09:40.19,Main,Nami,0,0,0,,Kurtardığın için sağol.
Dialogue: 0,0:09:42.34,0:09:44.54,Main,Zoro,0,0,0,,Bu gittikçe daha da kötü görünüyor.
Dialogue: 0,0:09:44.54,0:09:46.96,Main,Sanji,0,0,0,,Kolu niye öyle uzadı?
Dialogue: 0,0:09:46.96,0:09:48.97,Main,Sanji,0,0,0,,Bu dünyada sadece bir tane lastik adam var, değil mi?!
Dialogue: 0,0:09:57.51,0:10:00.71,Main,Zoro,0,0,0,,Bu Moria. Bir şey yapmış olmalı.
Dialogue: 0,0:10:00.89,0:10:02.84,Main,Oz,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:10:03.42,0:10:05.80,Main,Oz,0,0,0,,{\fad(150,150)}...Kırbaç!
Dialogue: 0,0:10:06.42,0:10:09.65,Main,Sanji,0,0,0,,Şimdi aynı Luffy'nin canavar versiyonu gibi!
Dialogue: 0,0:10:14.98,0:10:16.41,Main,Luffy,0,0,0,,Neyiniz var sizin?!
Dialogue: 0,0:10:16.41,0:10:19.56,Main,Luffy,0,0,0,,Acelem var, ne istiyorsunuz?!
Dialogue: 0,0:10:19.56,0:10:21.56,Main,Pirate,0,0,0,,Ah, biliyoruz!
Dialogue: 0,0:10:21.56,0:10:23.69,Main,Pirate,0,0,0,,Acelen olduğu belli!
Dialogue: 0,0:10:23.69,0:10:25.33,Main,Pirate,0,0,0,,Açıklamak için biraz zaman ver.
Dialogue: 0,0:10:25.33,0:10:27.11,Main,Pirate,0,0,0,,Bizi kurtaracak olan sensin!
Dialogue: 0,0:10:27.11,0:10:28.44,Main,Pirate,0,0,0,,Seni arıyorduk!
Dialogue: 0,0:10:29.14,0:10:34.90,Main,Pirate,0,0,0,,Biz, "Yuvarlanan Korsanlar" ın bir parçası, Tehlikeli Kardeşler'iz. Kaptanımız "Teklifçi Lola" nın adamlarıyız.
Dialogue: 0,0:10:34.90,0:10:38.41,Main,Pirate,0,0,0,,Malikânedeki Gecko Moria'yı yenmek istiyorsun, değil mi?!
Dialogue: 0,0:10:38.41,0:10:39.30,Main,Pirate,0,0,0,,Ha?
Dialogue: 0,0:10:39.57,0:10:43.34,Main,Pirate,0,0,0,,Moria'nın gücünün sırlarını biliyoruz!
Dialogue: 0,0:10:43.34,0:10:45.57,Main,Pirate,0,0,0,,Sana inanılmaz bir güç verebiliriz!
Dialogue: 0,0:10:45.57,0:10:48.26,Main,Pirate,0,0,0,,Onu bizim için yenmelisin!
Dialogue: 0,0:10:48.26,0:10:50.92,Main,Luffy,0,0,0,,Sır? Güç?
Dialogue: 0,0:10:52.58,0:10:55.17,Main,Luffy,0,0,0,,Ama kimsiniz dedim ya?!
Dialogue: 0,0:10:56.08,0:10:57.65,Main,Pirate,0,0,0,,Tanıştırmamıza izin ver.
Dialogue: 0,0:10:57.65,0:11:00.96,Main,Pirate,0,0,0,,Yuvarlanan Korsanlar'ın kaptanı, Teklifçi Lola!
Dialogue: 0,0:11:00.96,0:11:04.64,Main,Pirate,0,0,0,,Şu anki evlilik teklifi sayısı: 4443!
Dialogue: 0,0:11:05.23,0:11:06.94,Main,Lola,0,0,0,,Ah! Seni seviyorum!
Dialogue: 0,0:11:06.94,0:11:08.11,Main,Lola,0,0,0,,Evlen benimle!
Dialogue: 0,0:11:08.11,0:11:09.26,Main,Luffy,0,0,0,,Hayır.
Dialogue: 0,0:11:09.26,0:11:10.64,Main,Both,0,0,0,,Ret!
Dialogue: 0,0:11:10.64,0:11:13.85,Main,Both,0,0,0,,4444. ret!
Dialogue: 0,0:11:14.78,0:11:19.28,Main,Pirate,0,0,0,,Kısacası, gölgeleri çalınmış bir grup insanız.
Dialogue: 0,0:11:19.28,0:11:20.85,Main,Pirate,0,0,0,,Bu ormanda dolanmaya bırakılmış bir grup kurban!
Dialogue: 0,0:11:20.85,0:11:24.05,Main,Luffy,0,0,0,,Evet, benim gölgem de gitti. Bu yüzden acelem var!
Dialogue: 0,0:11:24.05,0:11:26.83,Main,Lola,0,0,0,,Sen Hasır Şapkalı Luffy'sin, değil mi?
Dialogue: 0,0:11:26.83,0:11:32.04,Main,Lola,0,0,0,,Neyse! Tüm varlığı boyunca Thriller Bark hiç bu kadar sarsılmamıştı!
Dialogue: 0,0:11:34.24,0:11:39.44,Main,Pirate,0,0,0,,Moria'ya hizmet eden Üç Muamma\Nyenildi ve malikâne çökmenin eşiğinde!
Dialogue: 0,0:11:39.44,0:11:43.51,Main,Pirate,0,0,0,,Buraya ilk geldiğimizden beri, ilk\Nkez bu kadar heyecanlanıyoruz!
Dialogue: 0,0:11:43.51,0:11:48.72,Main,Pirate,0,0,0,,Ama aynı zamanda düşman, sonunda\Nbahsi geçen "Özel Zombi" yi uyandırdı!
Dialogue: 0,0:11:48.72,0:11:51.96,Main,Pirate,0,0,0,,Özel Kurban Ağı'mız sayesinde olup biten her şeyi biliyoruz!
Dialogue: 0,0:11:51.96,0:11:54.83,Main,Pirate,0,0,0,,Gölgelerimizi kaybedeli üç yıl oldu.
Dialogue: 0,0:11:54.83,0:11:57.45,Main,Pirate,0,0,0,,Tüm hayatımızı bu şekilde sürdüreceğimizden endişe ediyoruz!
Dialogue: 0,0:11:57.45,0:12:01.77,Main,Pirate,0,0,0,,Ama bizim için Moria'yı yenerseniz,\Ntüm gölgelerimiz geri dönecek!
Dialogue: 0,0:12:01.77,0:12:04.15,Main,Pirate,0,0,0,,Ama bu sadece bir bölümü!
Dialogue: 0,0:12:04.15,0:12:06.42,Main,Pirate,0,0,0,,Şu anda Moria'nın nerede olduğunu biliyor musun?!
Dialogue: 0,0:12:06.42,0:12:07.92,Main,Pirate,0,0,0,,Midede!
Dialogue: 0,0:12:07.92,0:12:09.91,Main,Pirate,0,0,0,,O dev canavarın midesinde!
Dialogue: 0,0:12:09.91,0:12:12.44,Main,Luffy,0,0,0,,Ehhh?! Yenildi mi?!
Dialogue: 0,0:12:12.93,0:12:14.12,Main,Pirate,0,0,0,,Hayır, öyle değil!
Dialogue: 0,0:12:14.12,0:12:16.12,Main,Pirate,0,0,0,,Orada bir tür odası var!
Dialogue: 0,0:12:16.12,0:12:22.15,Main,Pirate,0,0,0,,Yani gölgeni alan o Özel Zombi'yi yenmelisin. \NYoksa Moria'ya elimizi süremeyiz!
Dialogue: 0,0:12:22.15,0:12:26.67,Main,Pirate,0,0,0,,Şu anda kalenin avlusunda arkadaşlarınla dövüşüyor!
Dialogue: 0,0:12:26.67,0:12:28.08,Main,Luffy,0,0,0,,Ne dedin?!
Dialogue: 0,0:12:28.08,0:12:29.34,Main,Luffy,0,0,0,,Kahretsin!
Dialogue: 0,0:12:29.34,0:12:30.54,Main,Luffy,0,0,0,,O zaman gerçekten acele etmeliyim!
Dialogue: 0,0:12:30.54,0:12:32.06,Main,Lola,0,0,0,,Dur biraz!
Dialogue: 0,0:12:33.30,0:12:36.25,Main,Lola,0,0,0,,Fazla uzun sürmeyecek, tamam mı?!
Dialogue: 0,0:12:36.25,0:12:37.80,Main,Lola,0,0,0,,Bu yüzden bırak da gösterelim!
Dialogue: 0,0:12:37.80,0:12:40.70,Main,Lola,0,0,0,,Gölgelerle ilgili keşfettiğimiz sırrı!
Dialogue: 0,0:12:41.44,0:12:44.14,Main,Pirate,0,0,0,,Çekilin çocuklar, biz geliyoruz!
Dialogue: 0,0:12:45.46,0:12:46.31,Main,Luffy,0,0,0,,Ha? Gölge?!
Dialogue: 0,0:12:46.31,0:12:48.33,Main,Pirate,0,0,0,,Evet, bir gölge!
Dialogue: 0,0:12:48.33,0:12:53.62,Main,Pirate,0,0,0,,Zombileri tuzla beslediğimizde çıkıyorlar. Böyle olunca onları yakalaması kolay!
Dialogue: 0,0:12:57.03,0:12:58.18,Main,Luffy,0,0,0,,Ahh! Ne yapıyorsunuz?!
Dialogue: 0,0:12:58.18,0:12:59.81,Main,Luffy,0,0,0,,İçime giriyor!
Dialogue: 0,0:12:58.87,0:12:59.81,Secondary,Pirate,0,0,0,,Kıpırdama!
Dialogue: 0,0:13:02.93,0:13:04.05,Main,Luffy,0,0,0,,Kesin şunu!
Dialogue: 0,0:13:04.05,0:13:05.73,Main,Luffy,0,0,0,,Gözlerim kararıyor!
Dialogue: 0,0:13:07.57,0:13:09.00,Main,Pirate,0,0,0,,Tamam, girdi!
Dialogue: 0,0:13:10.18,0:13:10.97,Main,Lola,0,0,0,,Nasıl?
Dialogue: 0,0:13:11.80,0:13:13.70,Main,Lola,0,0,0,,İyi misin?
Dialogue: 0,0:13:14.12,0:13:14.78,Main,Luffy,0,0,0,,Evet.
Dialogue: 0,0:13:15.97,0:13:18.50,Main,Lola,0,0,0,,Peki, kılıç kullanabilir misin?
Dialogue: 0,0:13:19.43,0:13:21.51,Main,Luffy,0,0,0,,Hayır, kullanamam.
Dialogue: 0,0:13:32.22,0:13:33.42,Main,Luffy,0,0,0,,Bunu nasıl yaptım?!
Dialogue: 0,0:13:35.12,0:13:40.13,Main,Lola,0,0,0,,Bedenine yerleştirdiğimiz gölge,\Nbüyük bir Denizci kılıç ustasına aitti!
Dialogue: 0,0:13:40.13,0:13:44.29,Main,Pirate,0,0,0,,Gölgenin dövüş yeteneği kendininkine eklenir!
Dialogue: 0,0:13:44.29,0:13:47.91,Main,Pirate,0,0,0,,Alabildiğin sürece, sana istediğin kadar gölge verebiliriz!
Dialogue: 0,0:13:48.29,0:13:49.92,Main,Lola,0,0,0,,Ne düşünüyorsun? İnanılmaz, değil mi?!
Dialogue: 0,0:13:49.92,0:13:55.17,Main,Lola,0,0,0,,Moria'nın kendi yeteneği sayesinde,\Ngücünü şu ankinin çok üstüne çıkarabiliriz!
Dialogue: 0,0:13:56.36,0:13:58.65,Main,Pirate,0,0,0,,O gölgelerden bir sürü yakaladık!
Dialogue: 0,0:13:58.65,0:14:03.96,Main,Pirate,0,0,0,,Ama yeterli iraden yoksa, kendinden geçersin\Nve o gücün tamamı işe yaramaz hale gelir!
Dialogue: 0,0:14:04.59,0:14:07.92,Main,Luffy,0,0,0,,Nasıl bu kadar çok gölgeniz olabilir?
Dialogue: 0,0:14:07.92,0:14:12.28,Main,Pirate,0,0,0,,Zombileri bularak ve onları arındırarak, kendi\Ngölgelerimizi geri almak için yıllarca uğraştık.
Dialogue: 0,0:14:12.28,0:14:16.88,Main,Pirate,0,0,0,,Ama rasgele gölgeler buluyorduk ve kime\Nait olduklarına dair hiçbir fikrimiz yoktu.
Dialogue: 0,0:14:16.88,0:14:20.34,Main,Pirate,0,0,0,,Bu yüzden onları yakalamayı denedik!
Dialogue: 0,0:14:20.34,0:14:23.69,Main,Pirate,0,0,0,,Anladın mı? Ama bunu unutmadığından emin ol!
Dialogue: 0,0:14:23.69,0:14:26.46,Main,Pirate,0,0,0,,Bir cesede gölge koyarsan zombi olur.
Dialogue: 0,0:14:26.46,0:14:29.15,Main,Pirate,0,0,0,,Ama kendi ruhu olan gerçek bir\Ninsana koyarsan, yerinde durmaz!
Dialogue: 0,0:14:29.77,0:14:32.30,Main,Pirate,0,0,0,,Bu yüzden sadece on dakikalığına gücün artacak!
Dialogue: 0,0:14:32.30,0:14:36.14,Main,Pirate,0,0,0,,Bu noktada hepsi uçarak kaçacak!
Dialogue: 0,0:14:36.14,0:14:37.58,Main,Pirate,0,0,0,,Anlıyor musun?
Dialogue: 0,0:14:37.58,0:14:38.92,Main,Pirate,0,0,0,,Bunu on dakika içinde yapmalısın!
Dialogue: 0,0:14:38.92,0:14:43.47,Main,Pirate,0,0,0,,Toplamak için çok uğraştığımız\Ntüm gölgeleri sana vereceğiz!
Dialogue: 0,0:14:43.47,0:14:44.56,Main,Luffy,0,0,0,,O kadar çok mu?!
Dialogue: 0,0:14:45.32,0:14:51.18,Main,Lola,0,0,0,,Göğü kapatan sis dağılıyor, bu yüzden\Nburada 20 dakikadan fazla kalamayız!
Dialogue: 0,0:14:51.18,0:14:52.87,Main,Lola,0,0,0,,Neyse, acele etmeliyiz!
Dialogue: 0,0:14:52.87,0:14:54.78,Main,Lola,0,0,0,,Kendini sağlamlaştırdığından emin ol!
Dialogue: 0,0:14:54.78,0:14:58.28,Main,Lola,0,0,0,,Muhtemelen 20 veya 30 tanesiyle baş edebilmelisin!
Dialogue: 0,0:14:58.28,0:15:01.45,Main,Lola,0,0,0,,Biz sadece iki veya üç tane alabiliyoruz.
Dialogue: 0,0:15:03.36,0:15:04.35,Main,Lola,0,0,0,,Başlayın!
Dialogue: 0,0:15:06.44,0:15:07.52,Main,Luffy,0,0,0,,D-D-Durun biraz!
Dialogue: 0,0:15:07.52,0:15:09.27,Main,Luffy,0,0,0,,Bunu yine mi yapacaksınız?!{\fscx250}-{\r}
Dialogue: 0,0:15:15.81,0:15:18.62,Main,Lola,0,0,0,,Bu adamın...
Dialogue: 0,0:15:18.62,0:15:21.45,Main,Lola,0,0,0,,...ne kadar iradesi var böyle?!
Dialogue: 0,0:15:21.45,0:15:24.65,Main,Lola,0,0,0,,İnanılmaz! Hiç böyle bir şey görmedim!
Dialogue: 0,0:15:26.04,0:15:28.94,Main,Pirate,0,0,0,,100 gölgenin hepsini almayı başardı!
Dialogue: 0,0:15:28.94,0:15:30.45,Main,Pirate,0,0,0,,İnanılmaz!
Dialogue: 0,0:15:30.45,0:15:32.44,Main,Pirate,0,0,0,,Bu adam gerçekten bizim parlayan umudumuz!
Dialogue: 0,0:15:33.78,0:15:35.21,Main,Pirate,0,0,0,,H-Hey!
Dialogue: 0,0:15:35.21,0:15:37.12,Main,Pirate,0,0,0,,İyi misin?
Dialogue: 0,0:15:37.12,0:15:38.70,Main,Pirate,0,0,0,,Kendinde misin?!
Dialogue: 0,0:15:38.70,0:15:40.80,Main,Pirate,0,0,0,,Hasır Şapkalı Luffy!
Dialogue: 0,0:15:40.80,0:15:42.40,Main,Luffy,0,0,0,,Evet.
Dialogue: 0,0:15:42.40,0:15:44.12,Main,Luffy,0,0,0,,Hala kendimdeyim.
Dialogue: 0,0:15:46.18,0:15:50.86,Main,Luffy,0,0,0,,Güçle dolup taşıyorum. Durduramıyorum!
Dialogue: 0,0:15:51.68,0:15:56.48,Main,Pirate,0,0,0,,Biraz değişik görünüyorsun, biliyor musun?
Dialogue: 0,0:15:56.48,0:15:58.99,Main,Pirate,0,0,0,,Biraz daha küçük değil miydin?
Dialogue: 0,0:15:58.99,0:16:02.67,Main,Lola,0,0,0,,Şu anda ne kadar güçlü olabilir?!
Dialogue: 0,0:16:02.67,0:16:07.39,Main,Luffy,0,0,0,,Dövüş hissi her yerimi kaplıyor. Sabırsızlanıyorum!
Dialogue: 0,0:16:07.39,0:16:11.13,Main,Lola,0,0,0,,Bu mükemmel bir şekilde işe yaramalı! \NŞimdi, fazla sürmeyecek!
Dialogue: 0,0:16:11.13,0:16:13.90,Main,Lola,0,0,0,,O Moria'ya asla unutamayacağı bir kâbus yaşat!
Dialogue: 0,0:16:13.90,0:16:15.64,Main,Lola,0,0,0,,Bu bizim umut ışığımız,...
Dialogue: 0,0:16:15.64,0:16:17.07,Main,Lola,0,0,0,,..."Kâbus Luffy"!
Dialogue: 0,0:16:22.15,0:16:26.92,Main,Luffy,0,0,0,,Bekle bakalım, Moria!
Dialogue: 0,0:16:26.92,0:16:28.61,Main,Pirates,0,0,0,,Dur biraz!
Dialogue: 0,0:16:28.61,0:16:31.62,Main,Pirates,0,0,0,,Malikâne diğer tarafta!
Dialogue: 0,0:16:31.62,0:16:34.07,Main,Oz,0,0,0,,{\fad(150,0)}Gomu Gomu no...
Dialogue: 0,0:16:34.07,0:16:34.82,Main,Zoro,0,0,0,,Geliyor!
Dialogue: 0,0:16:35.16,0:16:37.14,Main,Oz,0,0,0,,{\fad(150,150)}...Çan!
Dialogue: 0,0:16:41.91,0:16:45.18,Main,Oz,0,0,0,,Bu uzama şeysi cidden harika bir his!
Dialogue: 0,0:16:45.42,0:16:47.02,Main,Oz,0,0,0,,{\fad(150,150)}...Mızrak!
Dialogue: 0,0:16:56.80,0:16:58.78,Main,Sanji,0,0,0,,Kahretsin, bu da ne böyle?
Dialogue: 0,0:16:58.78,0:17:01.07,Main,Sanji,0,0,0,,Gücü fazlasıyla artmış!
Dialogue: 0,0:17:01.07,0:17:04.59,Main,Zoro,0,0,0,,Şeytan Meyvesi'nin yardımı\Nolmadan bedeni nasıl uzayabilir?!
Dialogue: 0,0:17:04.59,0:17:06.67,Main,Zoro,0,0,0,,Ne yaptın, Moria?
Dialogue: 0,0:17:09.92,0:17:12.99,Main,Moria,0,0,0,,Gördüğünüz gibi, size sunduğum kâbus bu!
Dialogue: 0,0:17:12.99,0:17:15.31,Main,Moria,0,0,0,,Kage Kage'nin gücü,...
Dialogue: 0,0:17:15.41,0:17:17.02,Main,Moria,0,0,0,,{\fad(150,150)}...Gölge Devrimi!
Dialogue: 0,0:17:21.27,0:17:23.69,Main,Brook,0,0,0,,Devrim?
Dialogue: 0,0:17:23.97,0:17:27.21,Main,Moria,0,0,0,,Gölge konulduğu bedene uymalı.
Dialogue: 0,0:17:27.21,0:17:28.89,Main,Moria,0,0,0,,Bu kadarı bilindik bir şey.
Dialogue: 0,0:17:29.37,0:17:33.40,Main,Moria,0,0,0,,Vücut ve gölge her zaman aynı şekle sahip olmalı.
Dialogue: 0,0:17:33.40,0:17:35.29,Main,Moria,0,0,0,,Bu doğanın kanunu!
Dialogue: 0,0:17:35.29,0:17:36.44,Main,Moria,0,0,0,,Ama şimdi,...
Dialogue: 0,0:17:36.44,0:17:42.53,Main,Moria,0,0,0,,Oz'un hareketlerine bağlı olması gereken Oz'un gölgesi, kendi gölgem tarafından istila edildi ve kontrol ediliyor!
Dialogue: 0,0:17:42.53,0:17:45.78,Main,Moria,0,0,0,,Bunu anlıyor musunuz?
Dialogue: 0,0:17:45.78,0:17:50.30,Main,Moria,0,0,0,,Oz'un bedenini istediğim gibi değiştirebilirim!
Dialogue: 0,0:17:50.30,0:17:55.34,Main,Moria,0,0,0,,Vücudun ve gölgenin her zaman aynı\Nşekle sahip olması gerektiğini biliyorsunuz.
Dialogue: 0,0:17:55.34,0:18:03.04,Main,Moria,0,0,0,,Ama şimdi gölge bedene itaat etmiyor. Bunun yerine beden gölgeye uyum sağlıyor!
Dialogue: 0,0:18:03.04,0:18:05.46,Main,Moria,0,0,0,,Gölge Devrimi bu!
Dialogue: 0,0:18:05.76,0:18:08.26,Main,Chopper,0,0,0,,Yani doğa kanunlarını tesine çevirdi.
Dialogue: 0,0:18:08.26,0:18:14.25,Main,Chopper,0,0,0,,Moria, Oz'un gölgesinin eklemlerini uzatınca, dengelemek için gerçek vücudu da uzuyor!
Dialogue: 0,0:18:14.25,0:18:17.84,Main,Sanji,0,0,0,,Demek Oz gerçekten lastik adama dönüşmedi.
Dialogue: 0,0:18:17.84,0:18:20.18,Main,Sanji,0,0,0,,Yani o adam Oz'un bedenini istediği gibi kontrol edebiliyor.
Dialogue: 0,0:18:20.18,0:18:23.52,Main,Sanji,0,0,0,,Şu koca bedeniyle bile çılgınca bir şey.
Dialogue: 0,0:18:23.52,0:18:26.35,Main,Zoro,0,0,0,,Evet, bu durumda ona yaklaşamayacağız bile.
Dialogue: 0,0:18:28.60,0:18:31.36,Main,Moria,0,0,0,,Bu beden lastikten çok daha esnek!
Dialogue: 0,0:18:32.22,0:18:35.16,Main,Moria,0,0,0,,Gölgesine daire şekli verirsem,...
Dialogue: 0,0:18:37.51,0:18:39.20,Main,Moria,0,0,0,,...Oz da dairesel olur!
Dialogue: 0,0:18:41.92,0:18:44.07,Main,Moria,0,0,0,,{\fad(150,150)}Oz Topu.
Dialogue: 0,0:18:44.54,0:18:47.47,Main,Moria,0,0,0,,Alın bakalım!
Dialogue: 0,0:18:50.61,0:18:54.12,Main,Usopp,0,0,0,,Kaçın!
Dialogue: 0,0:18:57.97,0:19:01.47,Main,Oz,0,0,0,,Hey, hey! Dur bir dakika, Efendi!
Dialogue: 0,0:19:01.47,0:19:04.30,Main,Oz,0,0,0,,Bu benim dövüşüm, karışmayı bırak!
Dialogue: 0,0:19:05.55,0:19:06.92,Main,Moria,0,0,0,,Ah, özür dilerim.
Dialogue: 0,0:19:06.92,0:19:08.59,Main,Moria,0,0,0,,Yoluna çıkmak niyetinde değildim!
Dialogue: 0,0:19:08.59,0:19:11.16,Main,Moria,0,0,0,,Bu dövüş bitene dek, dikkatimi seni desteklemeye vereceğim!
Dialogue: 0,0:19:11.16,0:19:15.37,Main,Moria,0,0,0,,Şimdi, Oz! Onları teker teker ez!
Dialogue: 0,0:19:21.47,0:19:23.41,Main,Chopper,0,0,0,,Ona yaklaşmak çok tehlikeli! Zoro!
Dialogue: 0,0:19:24.11,0:19:26.96,Main,Nami,0,0,0,,Hey, Luffy nereye gitti ki?
Dialogue: 0,0:19:26.96,0:19:29.48,Main,Usopp,0,0,0,,Moria onu kandırdı ve bir yere kaçtı.
Dialogue: 0,0:19:29.48,0:19:31.12,Main,Usopp,0,0,0,,Yakında döner.
Dialogue: 0,0:19:31.12,0:19:32.39,Main,Nami,0,0,0,,Bu da ne?!
Dialogue: 0,0:19:32.39,0:19:35.08,Main,Nami,0,0,0,,Tam bir aptal!
Dialogue: 0,0:19:35.08,0:19:36.33,Thoughts,Nami,0,0,0,,{\i1}Ne yapacağım?{\i0}
Dialogue: 0,0:19:36.33,0:19:43.06,Thoughts,Nami,0,0,0,,{\i1}Böyle bir zamanda adada başka bir Shichibukai\Nolduğunu bilmelerine izin vermek iyi bir fikir mi?!{\i0}
Dialogue: 0,0:19:43.71,0:19:53.65,Main,Nami,0,0,0,,O zaman Luffy'nin zombisini haklamalıyız ve sonra da gölgelerimizi almak için Moria'yı da mı yenmeliyiz?
Dialogue: 0,0:19:53.65,0:19:55.39,Main,Usopp,0,0,0,,Evet, doğru.
Dialogue: 0,0:19:55.39,0:19:56.15,Main,Nami,0,0,0,,Şaka mı yapıyorsun?!
Dialogue: 0,0:19:56.15,0:19:57.72,Main,Nami,0,0,0,,Birazdan şafak sökecek!
Dialogue: 0,0:19:57.72,0:20:00.95,Main,Usopp,0,0,0,,Düşman bizi zorluyor, başka\Nyapabileceğimiz bir şey yok!
Dialogue: 0,0:20:00.95,0:20:02.35,Main,Brook,0,0,0,,Üzgünüm...
Dialogue: 0,0:20:02.97,0:20:05.84,Main,Nami,0,0,0,,Ah, İskelet. Sen de mi onlarlaydın?!
Dialogue: 0,0:20:05.84,0:20:07.32,Main,Brook,0,0,0,,Yalvarırım.
Dialogue: 0,0:20:07.32,0:20:10.80,Main,Brook,0,0,0,,Lütfen söyleyeceğimi dinleyin.
Dialogue: 0,0:20:13.20,0:20:16.46,Main,Brook,0,0,0,,Tüm kalbimle size teşekkür ederim!
Dialogue: 0,0:20:16.46,0:20:18.46,Main,Robin,0,0,0,,Sorun değil.
Dialogue: 0,0:20:18.46,0:20:20.71,Main,Usopp,0,0,0,,Ciddi misin, Brook?
Dialogue: 0,0:20:20.71,0:20:23.83,Main,Usopp,0,0,0,,Franky'ye ne olduğunu gördün, değil mi?!
Dialogue: 0,0:20:23.83,0:20:26.72,Main,Nami,0,0,0,,Ters giden bir şey olursa beni suçlama, tamam mı?
Dialogue: 0,0:20:26.72,0:20:29.20,Main,Nami,0,0,0,,Bu son atışımız, hazırla kendini!
Dialogue: 0,0:20:30.30,0:20:31.48,Main,Nami,0,0,0,,{\fad(150,150)}Kara Bulut Tempo!
Dialogue: 0,0:20:35.82,0:20:38.18,Main,Brook,0,0,0,,Buyur lütfen!
Dialogue: 0,0:20:38.18,0:20:41.65,Main,Usopp,0,0,0,,Yine Kuwagata'yı kullandığımıza inanamıyorum!
Dialogue: 0,0:20:41.65,0:20:45.87,Main,Brook,0,0,0,,Borcumu ödeyememek daha acı verici olurdu!
Dialogue: 0,0:20:47.37,0:20:49.83,Main,Brook,0,0,0,,Bunu acı sona kadar göreceğim!
Dialogue: 0,0:20:49.83,0:20:52.31,Main,Usopp,0,0,0,,Tamam, iyi şanslar!
Dialogue: 0,0:20:52.31,0:20:53.45,Main,Brook,0,0,0,,Gidiyorum!
Dialogue: 0,0:20:53.63,0:20:54.88,Main,Robin,0,0,0,,{\fad(150,150)}Slalom Asma!
Dialogue: 0,0:21:03.52,0:21:05.52,Main,Brook,0,0,0,,Kemiklerimi görebileceğiniz bir şok alıyorum!
Dialogue: 0,0:21:05.52,0:21:08.30,Main,Brook,0,0,0,,Gerçi başından beri sadece kemiğim!
Dialogue: 0,0:21:08.30,0:21:09.90,Main,Brook,0,0,0,,İşte geliyorum!
Dialogue: 0,0:21:09.90,0:21:11.43,Main,Brook,0,0,0,,Aynı yıldırım oku gibi!
Dialogue: 0,0:21:14.12,0:21:14.87,Main,Brook,0,0,0,,{\fad(150,0)}Kemik Yıldırım Kılıcı!
Dialogue: 0,0:21:16.32,0:21:18.00,Main,Brook,0,0,0,,{\fad(150,150)}Gavotte Bon Avant!
Dialogue: 0,0:21:16.32,0:21:18.00,Note,Brook,0,0,0,,{\fad(150,150)}İleri Atılım Dansı!
Dialogue: 0,0:21:19.19,0:21:20.17,Main,Usopp,0,0,0,,Müthiş!
Dialogue: 0,0:21:20.17,0:21:21.33,Main,Usopp,0,0,0,,Doğruca içinden geçti!
Dialogue: 0,0:21:22.29,0:21:24.14,Main,Oz,0,0,0,,Ah, omzumu patlattı!
Dialogue: 0,0:21:24.14,0:21:25.17,Main,Usopp,0,0,0,,Delip geçtin!
Dialogue: 0,0:21:25.17,0:21:26.21,Main,Usopp,0,0,0,,Tamamlayalım!
Dialogue: 0,0:21:28.00,0:21:32.15,Main,Brook,0,0,0,,Görev tamamlandı.
Dialogue: 0,0:21:32.15,0:21:33.50,Main,Zoro,0,0,0,,İyi iş, Kemik!
Dialogue: 0,0:21:34.70,0:21:35.82,Main,Zoro,0,0,0,,{\fad(150,150)}Çift Kılıç Stili...
Dialogue: 0,0:21:35.82,0:21:36.37,Main,Zoro,0,0,0,,{\fad(150,0)}...Çift Kesimli...
Dialogue: 0,0:21:37.29,0:21:38.27,Main,Zoro,0,0,0,,{\fad(150,150)}...Kule Tırmanışı!
Dialogue: 0,0:21:43.99,0:21:45.49,Main,Oz,0,0,0,,Pislik.
Dialogue: 0,0:21:45.49,0:21:50.39,Main,Oz,0,0,0,,Hayır, önce şu iskeletin işini bitirmeliyim!
Dialogue: 0,0:21:50.63,0:21:52.32,Main,Oz,0,0,0,,{\fad(150,0)}Gomu Gomu no...
Dialogue: 0,0:21:52.32,0:21:54.06,Main,Usopp,0,0,0,,Olamaz, o...
Dialogue: 0,0:21:52.32,0:21:53.43,Secondary,Oz,0,0,0,,{\fad(0,150)}Gomu Gomu no...
Dialogue: 0,0:21:54.34,0:21:56.18,Main,Oz,0,0,0,,{\fad(150,150)}...Balta!
Dialogue: 0,0:21:56.96,0:21:58.06,Main,Sanji,0,0,0,,Brook!
Dialogue: 0,0:22:05.61,0:22:07.17,Main,Usopp,0,0,0,,{\fad(150,150)}Kesin Öldürücü...
Dialogue: 0,0:22:07.17,0:22:09.81,Main,Usopp,0,0,0,,{\fad(150,150)}...Atlas Meteoru!
Dialogue: 0,0:22:15.10,0:22:19.41,Main,Oz,0,0,0,,Hiç şansınız yok!
Dialogue: 0,0:22:20.14,0:22:21.15,Main,Usopp,0,0,0,,Eyvah!
Dialogue: 0,0:22:21.15,0:22:22.30,Main,Nami,0,0,0,,Usopp, dövüş!
Dialogue: 0,0:22:23.04,0:22:24.32,Main,Usopp,0,0,0,,Hey, dur! Hey, hey!
Dialogue: 0,0:22:24.32,0:22:31.26,Main,Oz,0,0,0,,Sıradaki sensin, kahrolası uzun burun!
Dialogue: 0,0:22:33.44,0:22:36.32,Main,Oz,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:22:36.70,0:22:39.15,Main,Oz,0,0,0,,{\fad(150,0)}...Bazuka!
Dialogue: 0,0:22:39.15,0:22:41.04,Main,Usopp,0,0,0,,Öldüm!
Dialogue: 0,0:22:39.15,0:22:41.04,Secondary,Oz,0,0,0,,{\fad(0,150)}...Bazuka!
Dialogue: 0,0:22:52.04,0:22:53.20,Main,Oz,0,0,0,,Ha? Eh? Uzayamıyorum.
Dialogue: 0,0:22:53.20,0:22:54.39,Main,Oz,0,0,0,,Niye?!
Dialogue: 0,0:22:55.58,0:22:57.07,Main,Robin,0,0,0,,{\fad(150,150)}Ochenta Fleur...
Dialogue: 0,0:22:55.58,0:22:57.07,Note,Note,0,0,0,,{\fad(150,150)}Seksen Çiçek
Dialogue: 0,0:22:57.65,0:22:58.92,Main,Robin,0,0,0,,{\fad(150,150)}Cuatro Manos!
Dialogue: 0,0:22:57.65,0:22:58.92,Note,Note,0,0,0,,{\fad(150,150)}Dört El!
Dialogue: 0,0:23:05.03,0:23:07.31,Main,Moria,0,0,0,,Bu eller de ne?!
Dialogue: 0,0:23:07.31,0:23:08.50,Main,Moria,0,0,0,,Ne sinir bozucu!
Dialogue: 0,0:23:08.88,0:23:14.17,Main,Robin,0,0,0,,Sadece biraz dur. Belki o gölgeyi kontrol\Netmeyi bir süreliğine bırakabilirsin.
