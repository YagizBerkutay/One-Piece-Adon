Dialogue: 0,0:02:30.12,0:02:38.68,Title,,0,0,0,,{\fad(2000,2000)}İskeletin Umut ve Çaresizliği, \NHasır Şapkaların Karşı Saldırısı!
Dialogue: 0,0:02:39.65,0:02:41.59,Main,Luffy,0,0,0,,Pislik!
Dialogue: 0,0:02:42.53,0:02:43.69,Main,Luffy,0,0,0,,Gölgemi ver!
Dialogue: 0,0:02:43.69,0:02:44.86,Main,Franky,0,0,0,,Sakin ol!
Dialogue: 0,0:02:44.86,0:02:46.22,Main,Franky,0,0,0,,Moria burada değil!
Dialogue: 0,0:02:51.88,0:02:52.90,Main,Luffy,0,0,0,,Burası?
Dialogue: 0,0:02:52.90,0:02:53.97,Main,Franky,0,0,0,,Sunny.
Dialogue: 0,0:02:53.97,0:02:55.77,Main,Zoro,0,0,0,,Sunny?!
Dialogue: 0,0:02:55.77,0:02:58.15,Main,Zoro,0,0,0,,Niye geri döndük?
Dialogue: 0,0:02:58.15,0:03:00.05,Main,Zoro,0,0,0,,Hayır, ama...
Dialogue: 0,0:03:00.05,0:03:01.45,Main,Zoro,0,0,0,,...hayal görmüyorum.
Dialogue: 0,0:03:01.45,0:03:03.34,Main,Zoro,0,0,0,,Gölgemi yitirdim!
Dialogue: 0,0:03:03.34,0:03:04.70,Main,Zoro,0,0,0,,Ne tuhaf bir his.
Dialogue: 0,0:03:05.68,0:03:06.90,Main,Luffy,0,0,0,,Hey, başımız dertte!
Dialogue: 0,0:03:06.90,0:03:08.18,Main,Luffy,0,0,0,,Ölüm kalım meselesi!
Dialogue: 0,0:03:08.18,0:03:10.85,Main,Luffy,0,0,0,,Hiç yiyecek kalmamış!
Dialogue: 0,0:03:13.04,0:03:16.75,Main,Sanji,0,0,0,,Sahip olduğumuz erzaklar gitmiş.
Dialogue: 0,0:03:16.75,0:03:19.38,Main,Sanji,0,0,0,,Stokladığımız yiyecekleri almışlar.
Dialogue: 0,0:03:19.38,0:03:22.39,Main,Luffy,0,0,0,,Peynir ve krakerler bana yetmez!
Dialogue: 0,0:03:22.39,0:03:23.30,Main,Luffy,0,0,0,,Et!
Dialogue: 0,0:03:25.78,0:03:27.95,Main,Zoro,0,0,0,,Ne utanç verici.
Dialogue: 0,0:03:27.95,0:03:29.72,Main,Zoro,0,0,0,,Tedbiri elden bıraktım.
Dialogue: 0,0:03:29.73,0:03:32.94,Main,Luffy,0,0,0,,Korsan yemeğimi bile kaybettim.
Dialogue: 0,0:03:32.94,0:03:35.65,Main,Luffy,0,0,0,,Peynir yetmez... yetmez...
Dialogue: 0,0:03:36.59,0:03:38.11,Main,Sanji,0,0,0,,Sahi,...
Dialogue: 0,0:03:38.11,0:03:40.19,Main,Sanji,0,0,0,,...Nami-san'ı hiçbir yerde görmüyorum.
Dialogue: 0,0:03:42.55,0:03:45.60,Main,Sanji,0,0,0,,Kaçırıldı mı?!
Dialogue: 0,0:03:45.60,0:03:47.79,Main,Sanji,0,0,0,,Niye dünyanın sonuna kadar peşinden gitmediniz?!
Dialogue: 0,0:03:47.79,0:03:49.43,Main,Usopp,0,0,0,,Ü-Üzgünüm.
Dialogue: 0,0:03:49.43,0:03:52.41,Main,Usopp,0,0,0,,Ama kritik bir durumdaydık ve peşinden gidemedik.
Dialogue: 0,0:03:52.80,0:03:55.37,Main,Sanji,0,0,0,,Kim ve nerede bu adam?!
Dialogue: 0,0:03:55.37,0:03:57.54,Main,Sanji,0,0,0,,Hemen onu kurtarmaya gideceğim!
Dialogue: 0,0:03:57.54,0:03:58.96,Main,Usopp,0,0,0,,D-Dur!
Dialogue: 0,0:03:58.96,0:04:01.76,Main,Usopp,0,0,0,,Önce her şeyi açıklamama izin ver.
Dialogue: 0,0:04:02.53,0:04:04.90,Main,Usopp,0,0,0,,Dinle, kısaca anlatacağım.
Dialogue: 0,0:04:04.90,0:04:08.40,Main,Usopp,0,0,0,,Şu anda ne olursa olsun geri\Nalmamız gereken iki şey var!
Dialogue: 0,0:04:08.84,0:04:09.47,Main,Luffy,0,0,0,,Yemek.
Dialogue: 0,0:04:09.47,0:04:10.09,Main,Luffy,0,0,0,,Nami.
Dialogue: 0,0:04:10.09,0:04:11.11,Main,Luffy,0,0,0,,Sonra da gölgelerimiz, değil mi?
Dialogue: 0,0:04:11.11,0:04:11.97,Main,Luffy,0,0,0,,Üç eder.
Dialogue: 0,0:04:12.96,0:04:15.35,Main,Usopp,0,0,0,,Onları böyle sıralandırmaman gerekirdi.
Dialogue: 0,0:04:15.35,0:04:19.19,Main,Usopp,0,0,0,,Önce Nami'den ve gölgelerden bahsetmeme izin verin.
Dialogue: 0,0:04:20.68,0:04:23.13,Main,Sanji,0,0,0,,E-
Dialogue: 0,0:04:23.13,0:04:25.26,Main,Sanji,0,0,0,,EVLENMEK Mİ?!
Dialogue: 0,0:04:25.26,0:04:26.84,Main,Sanji,0,0,0,,Dalga geçme!
Dialogue: 0,0:04:26.84,0:04:28.74,Main,Sanji,0,0,0,,Kesinlikle affedilemez!
Dialogue: 0,0:04:28.74,0:04:32.27,Main,Luffy,0,0,0,,Nami'yle evleneceğine göre epey cesur olmalı.
Dialogue: 0,0:04:32.27,0:04:34.77,Main,Luffy,0,0,0,,Ve ben dev miyim?!
Dialogue: 0,0:04:34.77,0:04:36.71,Main,Luffy,0,0,0,,Öyle bir zombi mi yaptılar?!
Dialogue: 0,0:04:37.02,0:04:41.43,Main,Zoro,0,0,0,,Yani Luffy'nin ve aşçının\Nzombileri doğrulandı mı, Usopp?
Dialogue: 0,0:04:42.58,0:04:45.74,Main,Usopp,0,0,0,,Shichibukailer'den biri olduğunu hiç düşünmemiştim.
Dialogue: 0,0:04:45.74,0:04:48.39,Main,Chopper,0,0,0,,Aniden korkmaya başladım.
Dialogue: 0,0:04:48.76,0:04:50.72,Main,Franky,0,0,0,,Bilmiyor muydunuz?
Dialogue: 0,0:04:51.45,0:04:52.46,Main,Luffy,0,0,0,,Anlıyorum.
Dialogue: 0,0:04:52.46,0:04:55.40,Main,Luffy,0,0,0,,Zombiler asıl sahibini andırıyorsa,...
Dialogue: 0,0:04:55.40,0:04:57.67,Main,Luffy,0,0,0,,...Zoro'nun zombisini de gördüm.
Dialogue: 0,0:04:57.67,0:04:59.33,Main,Zoro,0,0,0,,Neye benziyordu?
Dialogue: 0,0:05:01.17,0:05:03.04,Main,Luffy,0,0,0,,Aynı senin gibiydi.
Dialogue: 0,0:05:03.04,0:05:05.65,Main,Luffy,0,0,0,,Ayağında nalın olduğu için sen olmadığını anladım.
Dialogue: 0,0:05:06.30,0:05:08.01,Main,Zoro,0,0,0,,Neyse, sorun değil.
Dialogue: 0,0:05:08.01,0:05:11.67,Main,Zoro,0,0,0,,O üç zombiyi bulur ve ağızlarına tuz atarsak,\Ngölgelerimizi geri alacağız, değil mi?
Dialogue: 0,0:05:14.65,0:05:18.12,Main,Zoro,0,0,0,,Neyse, böyle bir zayıflık bulmanız iyi oldu.
Dialogue: 0,0:05:18.12,0:05:24.05,Main,Franky,0,0,0,,Bize onların zayıflığından bahseden ve sizi kurtarmamız için buraya gelmemizi söyleyen o iskeletti.
Dialogue: 0,0:05:25.15,0:05:26.76,Main,Luffy,0,0,0,,Brook'la karşılaştınız mı?!
Dialogue: 0,0:05:27.30,0:05:29.28,Main,Franky,0,0,0,,Evet, karşılaştık.
Dialogue: 0,0:05:29.28,0:05:31.84,Main,Franky,0,0,0,,Karşılaştıktan hemen sonra ona aptalca bir soru sordum.
Dialogue: 0,0:05:31.84,0:05:39.73,Main,Franky,0,0,0,,Dürüst olmak gerekirse, ilk kez onun tayfamıza\Nkatılacağını söylediğinde, buna tamamen karşıydım.
Dialogue: 0,0:05:39.73,0:05:46.11,Main,Franky,0,0,0,,O takırdayan iskeletle daha fazla konuştukça, \Nkemikli biri olduğunu farkettim.
Dialogue: 0,0:05:46.11,0:05:48.41,Main,Franky,0,0,0,,Gerçi zaten bir iskelet.
Dialogue: 0,0:05:48.87,0:05:50.87,Main,Franky,0,0,0,,O gerçek bir erkek!
Dialogue: 0,0:05:51.21,0:05:52.24,Flashbacks,Franky,0,0,0,,Dur biraz!
Dialogue: 0,0:05:53.09,0:05:57.29,Flashbacks,Franky,0,0,0,,Hazır başlamışken, sadece bir soruma daha cevap ver.
Dialogue: 0,0:05:58.26,0:06:04.15,Flashbacks,Franky,0,0,0,,Şu görünüşünle insan içine çıkarsan, insanların nasıl tepki vereceğini biliyorsun, değil mi?
Dialogue: 0,0:06:05.09,0:06:07.40,Flashbacks,Franky,0,0,0,,Konuşan bir iskeletsin.
Dialogue: 0,0:06:07.40,0:06:11.08,Flashbacks,Franky,0,0,0,,Öyle kötü bakışları olan biriyle hiç kimsenin arkadaş olması mümkün değil.
Dialogue: 0,0:06:11.08,0:06:13.29,Flashbacks,Franky,0,0,0,,Korkunç şeyler her zaman küçümsenir.
Dialogue: 0,0:06:13.29,0:06:14.93,Flashbacks,Robin,0,0,0,,Frank, neler söylüyorsun?
Dialogue: 0,0:06:15.89,0:06:21.53,Flashbacks,Franky,0,0,0,,Bu lanetli denizden kaçmayı başarsan bile,...
Dialogue: 0,0:06:22.86,0:06:24.24,Flashbacks,Franky,0,0,0,,...kaderinin farkındasın.
Dialogue: 0,0:06:24.24,0:06:27.46,Flashbacks,Franky,0,0,0,,Kaçamadan onlarca yıl süren umutsuzluk.
Dialogue: 0,0:06:28.54,0:06:32.07,Flashbacks,Franky,0,0,0,,Çok yalnız olduğun için ölmek istediğini söylemiştin, değil mi?
Dialogue: 0,0:06:33.13,0:06:36.41,Flashbacks,Franky,0,0,0,,Yerinde olsaydım, artık hayata tutunmazdım.
Dialogue: 0,0:06:37.20,0:06:42.84,Flashbacks,Franky,0,0,0,,Önemsiz bir varlığın var ve her zaman şövalye ruhlu davranıyorsun. Ne sakladığını söyle artık.
Dialogue: 0,0:06:44.48,0:06:47.80,Flashbacks,Franky,0,0,0,,Bu kadar ileri giderek ne elde etmeye çalışıyorsun?
Dialogue: 0,0:06:47.80,0:06:52.18,Flashbacks,Franky,0,0,0,,Sürekli bahsettiğin arkadaşına verdiğin söz nedir?
Dialogue: 0,0:06:55.58,0:06:57.10,Flashbacks,Brook,0,0,0,,Meraklı birisin.
Dialogue: 0,0:06:57.59,0:06:59.44,Flashbacks,Brook,0,0,0,,Çok basit.
Dialogue: 0,0:06:59.44,0:07:04.74,Flashbacks,Brook,0,0,0,,Uzun zaman önce korsan tayfamız,\Nbir arkadaşımızı belli bir yerde bıraktı.
Dialogue: 0,0:07:04.74,0:07:07.15,Flashbacks,Brook,0,0,0,,Acı verici bir vedaydı ama...
Dialogue: 0,0:07:07.68,0:07:13.15,Flashbacks,Brook,0,0,0,,...gemimiz ayrılırken, ne olursa olsun geri döneceğimize söz verdik.
Dialogue: 0,0:07:13.15,0:07:15.87,Flashbacks,Brook,0,0,0,,Sonra bu denizde yok edildik.
Dialogue: 0,0:07:15.87,0:07:18.78,Flashbacks,Brook,0,0,0,,Sözümüzden dönmemek için,...
Dialogue: 0,0:07:18.78,0:07:24.73,Flashbacks,Brook,0,0,0,,...tayfanın yeterince uzun yaşamış tek üyesi olarak,\Nonu bu olaylardan haberdar etme görevim var.
Dialogue: 0,0:07:25.29,0:07:28.73,Flashbacks,Brook,0,0,0,,Ölümlerimizden beri...
Dialogue: 0,0:07:28.73,0:07:31.76,Flashbacks,Brook,0,0,0,,...sanırım 50 yıl geçti.
Dialogue: 0,0:07:32.86,0:07:34.32,Flashbacks,Franky,0,0,0,,50 yıl mı?!
Dialogue: 0,0:07:34.32,0:07:38.10,Flashbacks,Franky,0,0,0,,Hey! Bu çok uzun zaman önce!\NBen daha doğmamıştım bile!
Dialogue: 0,0:07:38.10,0:07:42.35,Flashbacks,Franky,0,0,0,,Üzgünüm ama onun bunca zamandır beklemiş olması mümkün değil!
Dialogue: 0,0:07:42.35,0:07:44.32,Flashbacks,Brook,0,0,0,,Beni niye mi beklesin?
Dialogue: 0,0:07:44.32,0:07:48.61,Flashbacks,Brook,0,0,0,,Beklemeyi bırakıp gitmeye hakkı var.
Dialogue: 0,0:07:48.88,0:07:55.09,Flashbacks,Brook,0,0,0,,Bir ihtimal sözümüze inandıysa ve\Nbunca zamandır bizi bekliyorduysa,...
Dialogue: 0,0:07:55.09,0:07:59.02,Flashbacks,Brook,0,0,0,,...kendini ne kadar yalnız hissetmiş\Nolabileceğini hayal bile edemiyorum.
Dialogue: 0,0:08:00.14,0:08:05.37,Flashbacks,Brook,0,0,0,,Ona ihanet ettiğimizi düşünerek\Nbunca zamandır bekliyorduysa,...
Dialogue: 0,0:08:05.37,0:08:08.27,Flashbacks,Brook,0,0,0,,...kendini ne kadar mutsuz hissetmiş\Nolabileceğini hayal bile edemiyorum!
Dialogue: 0,0:08:08.27,0:08:09.21,Flashbacks,Franky,0,0,0,,Sen...
Dialogue: 0,0:08:09.92,0:08:14.01,Flashbacks,Brook,0,0,0,,O burunda tekrar buluşmak için\Nsöz verdiğimiz arkadaşımızın adı,...
Dialogue: 0,0:08:14.72,0:08:16.39,Flashbacks,Brook,0,0,0,,...Laboon.
Dialogue: 0,0:08:16.94,0:08:22.30,Flashbacks,Brook,0,0,0,,Küçük bir balinayı tehlikeli yolculuğumuza götüremezdik.
Dialogue: 0,0:08:24.56,0:08:26.22,Flashbacks,Pirates,0,0,0,,Kendine iyi bak, Laboon!
Dialogue: 0,0:08:26.22,0:08:31.15,Flashbacks,Pirates,0,0,0,,Kesinlikle senin için döneceğiz!
Dialogue: 0,0:08:35.72,0:08:39.76,Flashbacks,Brook,0,0,0,,Şimdiye kadar çok büyümüş olmalı.
Dialogue: 0,0:08:40.77,0:08:42.33,Flashbacks,Franky,0,0,0,,Arkadaşın...
Dialogue: 0,0:08:42.33,0:08:43.50,Flashbacks,Franky,0,0,0,,...bir balina mı?
Dialogue: 0,0:08:44.08,0:08:45.42,Flashbacks,Brook,0,0,0,,Evet.
Dialogue: 0,0:08:46.01,0:08:51.54,Flashbacks,Brook,0,0,0,,O zamandan beri bize inandığını düşünmeden edemiyorum.
Dialogue: 0,0:08:53.50,0:08:57.42,Flashbacks,Brook,0,0,0,,Her zamanki gibi neşeli müziğimizi çalacağımızı ve kollarımızı açıp...
Dialogue: 0,0:08:57.42,0:09:01.50,Flashbacks,Brook,0,0,0,,...onun için döneceğimizi düşünüyor olabilir.
Dialogue: 0,0:09:03.08,0:09:08.48,Flashbacks,Brook,0,0,0,,Bu kadar sorumsuzca öldükten sonra beni bağışlamasını isteyemem.
Dialogue: 0,0:09:08.96,0:09:13.99,Flashbacks,Brook,0,0,0,,Dikkatsizce verdiğimiz sözden sonra onu öbür dünyadan çağıramam.
Dialogue: 0,0:09:16.19,0:09:19.29,Flashbacks,Brook,0,0,0,,Ölmek mazeret değildir!
Dialogue: 0,0:09:21.47,0:09:26.54,Flashbacks,Brook,0,0,0,,Çünkü bir zamanlar bir adam,\Nne olursa olsun döneceğini söyledi!
Dialogue: 0,0:09:28.60,0:09:30.59,Main,Franky,0,0,0,,İşte böyle.
Dialogue: 0,0:09:31.61,0:09:32.80,Main,Luffy,0,0,0,,Laboon...
Dialogue: 0,0:09:35.24,0:09:37.51,Main,Usopp,0,0,0,,Ciddi misin?!
Dialogue: 0,0:09:38.07,0:09:40.18,Main,Sanji,0,0,0,,Bu o.
Dialogue: 0,0:09:48.65,0:09:51.11,Main,Luffy,0,0,0,,O balinayla...
Dialogue: 0,0:09:54.21,0:09:56.90,Main,Luffy,0,0,0,,...karşılaştık.
Dialogue: 0,0:10:05.06,0:10:06.58,Main,Franky,0,0,0,,Onu tanıyor musunuz?!
Dialogue: 0,0:10:06.58,0:10:08.39,Main,Franky,0,0,0,,Nasıl?
Dialogue: 0,0:10:08.39,0:10:10.04,Main,Franky,0,0,0,,Ne demek istiyorsun?
Dialogue: 0,0:10:10.04,0:10:14.51,Main,Sanji,0,0,0,,Grand Line'ın girişindeki iki burnun yanındaydı.
Dialogue: 0,0:10:14.51,0:10:16.61,Main,Sanji,0,0,0,,O koca balina oradaydı.
Dialogue: 0,0:10:19.80,0:10:25.70,Main,Sanji,0,0,0,,Dünyayı ikiye ayıran duvarda,\Nkafasını Kızıl Hat'ta vuruyordu.
Dialogue: 0,0:10:25.70,0:10:32.78,Main,Sanji,0,0,0,,Dünyayı dolaşmayı bitirdiklerinde yeniden buluşacaklarına inandığı tayfayı 50 yıldır bekliyordu.
Dialogue: 0,0:10:42.26,0:10:48.09,Main,Sanji,0,0,0,,Nasılsa Luffy, intihar edecekmiş gibi davranmaması ve\Nduvarı kırıp geçmeye çalışmaması için onu ikna etti.
Dialogue: 0,0:10:48.09,0:10:50.60,Main,Sanji,0,0,0,,Hala hayatta.
Dialogue: 0,0:10:50.60,0:10:53.54,Main,Sanji,0,0,0,,O burunda arkadaşlarını bekliyor.
Dialogue: 0,0:10:54.00,0:10:55.61,Main,Usopp,0,0,0,,İnanılmaz bir hikaye.
Dialogue: 0,0:10:55.61,0:11:00.05,Main,Usopp,0,0,0,,Elli yıldan fazladır sözlerini tuttular!
Dialogue: 0,0:11:00.05,0:11:05.10,Main,Zoro,0,0,0,,Laboon'un onca zamandır beklediği arkadaşı...
Dialogue: 0,0:11:06.87,0:11:09.87,Main,Zoro,0,0,0,,...şu iskeletmiş.
Dialogue: 0,0:11:18.11,0:11:21.93,Main,Ryuma,0,0,0,,Beş yıldır güçlenmişsin ama ben de güçlendim!
Dialogue: 0,0:11:24.96,0:11:27.99,Main,Ryuma,0,0,0,,İkimiz de aynı şekilde düşündüğümüz için!
Dialogue: 0,0:11:40.59,0:11:43.80,Main,Ryuma,0,0,0,,Her zamanki gibi afro çok değerli.
Dialogue: 0,0:11:43.80,0:11:47.60,Main,Ryuuma,0,0,0,,O koca zayıf noktanı kesilmekten koruman mümkün değil.
Dialogue: 0,0:11:47.60,0:11:49.31,Main,Brook,0,0,0,,Sessiz ol!
Dialogue: 0,0:11:52.44,0:11:53.52,Thoughts,Brook,0,0,0,,{\i1}Laboon...{\i0}
Dialogue: 0,0:11:53.52,0:11:58.23,Thoughts,Brook,0,0,0,,{\i1}...hala bizi hatırlıyor musun?{\i0}
Dialogue: 0,0:12:00.21,0:12:04.82,Thoughts,Brook,0,0,0,,{\i1}Kendini nasıl hissettiğini düşününce kalbim buruluyor.{\i0}
Dialogue: 0,0:12:05.87,0:12:08.83,Thoughts,Brook,0,0,0,,{\i1}Gerçi şu anda kalbim yok!{\i0}
Dialogue: 0,0:12:10.40,0:12:14.81,Thoughts,Brook,0,0,0,,{\i1}Olanca gücüme rağmen, \NGrand Line zaptedilemez bir yer.{\i0}
Dialogue: 0,0:12:16.74,0:12:20.67,Thoughts,Brook,0,0,0,,{\i1}Arkadaşlarımızın hepsi göçtü.{\i0}
Dialogue: 0,0:12:26.89,0:12:33.88,Thoughts,Brook,0,0,0,,{\i1}Arkadaşlarımı, yüzümü, bedenimi, her şeyimi yitirdim.{\i0}
Dialogue: 0,0:12:33.88,0:12:35.29,Thoughts,Brook,0,0,0,,{\i1}Yeniden buluşsaydık...{\i0}
Dialogue: 0,0:12:35.29,0:12:39.77,Thoughts,Brook,0,0,0,,{\i1}...bu durumda kim olduğumu bile bilemezdin, değil mi?{\i0}
Dialogue: 0,0:12:50.80,0:12:51.62,Main,Brook,0,0,0,,Yapma!
Dialogue: 0,0:12:52.04,0:12:53.68,Main,Brook,0,0,0,,Afroyu rahat bırak!
Dialogue: 0,0:13:00.08,0:13:04.42,Thoughts,Brook,0,0,0,,{\i1}Artık hiçbir şeyim kalmadı.{\i0}
Dialogue: 0,0:13:06.52,0:13:12.58,Thoughts,Brook,0,0,0,,{\i1}Hepsi kafamın seni güldürdüğünü söyledi!{\i0}
Dialogue: 0,0:13:15.29,0:13:17.08,Flashbacks,Pirate,0,0,0,,Doğru değil mi, kardeşim?
Dialogue: 0,0:13:18.07,0:13:20.28,Thoughts,Brook,0,0,0,,{\i1}Sonuna kadar bu görünüşümü koruyacağım!{\i0}
Dialogue: 0,0:13:24.17,0:13:27.07,Thoughts,Brook,0,0,0,,{\i1}Çünkü kesinlikle seninle buluşmaya geleceğim!{\i0}
Dialogue: 0,0:13:28.46,0:13:29.85,Thoughts,Brook,0,0,0,,{\i1}Umarım bekliyorsundur.{\i0}
Dialogue: 0,0:13:30.95,0:13:32.10,Thoughts,Brook,0,0,0,,{\i1}Söz verdiğimiz...{\i0}
Dialogue: 0,0:13:32.76,0:13:34.54,Thoughts,Brook,0,0,0,,{\i1}...burunda.{\i0}
Dialogue: 0,0:13:39.29,0:13:42.67,Main,Franky,0,0,0,,İskeleti ve balinayı seviyorum!
Dialogue: 0,0:13:42.67,0:13:43.90,Main,All,0,0,0,,Kapa çeneni!
Dialogue: 0,0:13:45.68,0:13:47.31,Main,Luffy,0,0,0,,Heyecanlandım!
Dialogue: 0,0:13:47.31,0:13:49.07,Main,Luffy,0,0,0,,O bir müzisyen!
Dialogue: 0,0:13:49.07,0:13:50.86,Main,Luffy,0,0,0,,Konuşan bir iskelet!
Dialogue: 0,0:13:50.86,0:13:52.45,Main,Luffy,0,0,0,,Afrosu var!
Dialogue: 0,0:13:52.45,0:13:54.31,Main,Luffy,0,0,0,,"Yohoho" diyor ve...
Dialogue: 0,0:13:54.31,0:13:57.19,Main,Luffy,0,0,0,,...Laboon'un arkadaşı!
Dialogue: 0,0:13:58.10,0:14:01.90,Main,Luffy,0,0,0,,Onu sürüklemem gerekse bile bu gemide bize katılacak.
Dialogue: 0,0:14:01.90,0:14:03.66,Main,Luffy,0,0,0,,Arkadaşımız olacak!
Dialogue: 0,0:14:03.66,0:14:05.74,Main,Luffy,0,0,0,,Şikayeti olan var mı?
Dialogue: 0,0:14:06.96,0:14:09.45,Main,Robin,0,0,0,,Olsaydı bile fikrini değiştirir miydin?
Dialogue: 0,0:14:09.45,0:14:13.10,Main,Usopp,0,0,0,,Katılmasını istiyorum! Laboon'la birlikte!
Dialogue: 0,0:14:13.29,0:14:15.50,Main,Franky,0,0,0,,Tamamen onaylıyorum!
Dialogue: 0,0:14:15.50,0:14:17.37,Main,Chopper,0,0,0,,Ben de, seni pislik!
Dialogue: 0,0:14:17.37,0:14:19.75,Main,Chopper,0,0,0,,İskeletlerden de korkmuyorum!
Dialogue: 0,0:14:19.75,0:14:22.98,Main,Sanji,0,0,0,,O kadar kolay bir şeyden önce...
Dialogue: 0,0:14:22.98,0:14:26.76,Main,Sanji,0,0,0,,...Nami-san'ın düğününü durdurmak zorundayım!
Dialogue: 0,0:14:27.61,0:14:28.87,Main,Luffy,0,0,0,,Hey, Zoro!
Dialogue: 0,0:14:28.87,0:14:30.76,Main,Luffy,0,0,0,,Nereye gidiyorsun?
Dialogue: 0,0:14:32.12,0:14:33.97,Main,Zoro,0,0,0,,Bir an önce karaya çıkmak istiyorum.
Dialogue: 0,0:14:33.97,0:14:36.68,Main,Zoro,0,0,0,,Geri almamız gereken gölge sayısı arttı, değil mi?
Dialogue: 0,0:14:39.33,0:14:40.63,Main,Luffy,0,0,0,,Tamam!
Dialogue: 0,0:14:40.63,0:14:43.96,Main,Luffy,0,0,0,,Beyler, karşı saldırıya hazırlanın!
Dialogue: 0,0:14:43.96,0:14:46.99,Main,Luffy,0,0,0,,Thriller Bark'ı havaya uçuracağız!
Dialogue: 0,0:14:51.37,0:14:52.03,Main,Usopp,0,0,0,,Gidin!
Dialogue: 0,0:14:52.03,0:14:53.61,Main,Sanji,0,0,0,,Sen de, aptal!
Dialogue: 0,0:14:53.61,0:14:59.50,Main,Zoro,0,0,0,,Ama gölgelerimizi alan zombileri bulmak kolay olmayacak.
Dialogue: 0,0:14:59.50,0:15:00.42,Main,Chopper,0,0,0,,Ayrıca,...
Dialogue: 0,0:15:00.42,0:15:03.28,Main,Chopper,0,0,0,,...Luffy'nin zombisi aşırı büyük!
Dialogue: 0,0:15:03.28,0:15:05.44,Main,Chopper,0,0,0,,İki devden daha büyük!
Dialogue: 0,0:15:05.44,0:15:06.96,Main,Chopper,0,0,0,,O şeyi yenmeyi umamazsınız!
Dialogue: 0,0:15:07.44,0:15:09.90,Main,Luffy,0,0,0,,Zombileri aramamıza gerek yok.
Dialogue: 0,0:15:10.99,0:15:13.26,Main,Luffy,0,0,0,,Gerçi benimkini görmek istiyorum.
Dialogue: 0,0:15:13.26,0:15:14.88,Main,Zoro,0,0,0,,Neden bahsediyorsun?!
Dialogue: 0,0:15:14.88,0:15:19.73,Main,Zoro,0,0,0,,Bu şekilde kalırsak, bir daha asla güneş ışığına yaklaşamayacağız.
Dialogue: 0,0:15:19.73,0:15:20.89,Main,Luffy,0,0,0,,Ama zombi amcanın...
Dialogue: 0,0:15:20.89,0:15:23.46,Main,Luffy,0,0,0,,...ne dediğini unutmadın, değil mi?
Dialogue: 0,0:15:24.06,0:15:26.88,Flashbacks,Old man,0,0,0,,Sizi demin gördüm.
Dialogue: 0,0:15:26.88,0:15:29.80,Flashbacks,Old man,0,0,0,,Çok güçlüsünüz!
Dialogue: 0,0:15:30.43,0:15:31.39,Flashbacks,Luffy,0,0,0,,Yani?
Dialogue: 0,0:15:31.39,0:15:32.66,Flashbacks,Luffy,0,0,0,,İsteğin nedir?
Dialogue: 0,0:15:33.48,0:15:36.79,Flashbacks,Old man,0,0,0,,Bir adamı yenmenizi istiyorum.
Dialogue: 0,0:15:37.16,0:15:39.58,Flashbacks,Old man,0,0,0,,Yapabileceğinizden eminim!
Dialogue: 0,0:15:39.58,0:15:44.50,Flashbacks,Old man,0,0,0,,Kurbanların sayısına rağmen, \Nonu yenerseniz herkes kurtulacak!
Dialogue: 0,0:15:44.50,0:15:48.55,Main,Luffy,0,0,0,,Gecko Moria'yı devirirsek, herkesin gölgesi geri dönecek!
Dialogue: 0,0:15:49.78,0:15:52.97,Main,Sanji,0,0,0,,B-Bunu gerçekten söyledi.
Dialogue: 0,0:15:52.97,0:15:55.22,Main,Sanji,0,0,0,,İşte yine başlıyor, tam da yerinden.
Dialogue: 0,0:15:56.10,0:15:56.99,Main,Luffy,0,0,0,,O zaman...
Dialogue: 0,0:15:57.80,0:16:00.91,Main,Luffy,0,0,0,,...şu merdivenleri çıkarsak, Moria'yı bulacağız, değil mi?
Dialogue: 0,0:16:01.79,0:16:02.98,Main,Usopp,0,0,0,,Kesinlikle!
Dialogue: 0,0:16:02.98,0:16:04.66,Main,Luffy,0,0,0,,Neyse...
Dialogue: 0,0:16:04.66,0:16:07.15,Main,Luffy,0,0,0,,...gidip Gecko Moria'nın canına okuyacağım!
Dialogue: 0,0:16:07.82,0:16:10.08,Main,Luffy,0,0,0,,Bu herkesin gölgesini geri getireceğine göre...
Dialogue: 0,0:16:10.08,0:16:13.01,Main,Luffy,0,0,0,,Sanji, Nami'yi sana bırakıyorum.
Dialogue: 0,0:16:13.01,0:16:14.76,Main,Sanji,0,0,0,,ELBETTE!
Dialogue: 0,0:16:16.56,0:16:19.42,Main,Sanji,0,0,0,,Görünmez adam veya seramik adam olması umrumda değil!
Dialogue: 0,0:16:19.42,0:16:22.39,Main,Sanji,0,0,0,,Onu bu sisin ötesine fırlatacağım!
Dialogue: 0,0:16:22.93,0:16:26.08,Main,Sanji,0,0,0,,O düğünün gerçekleşmesine izin verir miyim sanki?!
Dialogue: 0,0:16:26.08,0:16:31.40,Main,Usopp,0,0,0,,Ah, bahsetmeyi unuttum ama o görünmez adam,\NNami'yi banyodayken tamamen çıplak gördü.
Dialogue: 0,0:16:31.40,0:16:34.63,Main,Sanji,0,0,0,,NE?!
Dialogue: 0,0:16:34.63,0:16:37.30,Main,Sanji,0,0,0,,Pislik!
Dialogue: 0,0:16:37.30,0:16:39.95,Main,Zoro,0,0,0,,Onu sinirlendirip durma.
Dialogue: 0,0:16:39.95,0:16:42.02,Main,Zoro,0,0,0,,Bir şeye dönüşebilir.
Dialogue: 0,0:16:42.95,0:16:46.98,Main,Usopp,0,0,0,,Gözlerimin önünde Nami'nin kaçırılmasına\Nizin verdiğim için kendimi suçlu hissediyorum.
Dialogue: 0,0:16:47.35,0:16:50.05,Main,Usopp,0,0,0,,Ben de Sanji'yle gideceğim!
Dialogue: 0,0:16:50.05,0:16:52.82,Main,Usopp,0,0,0,,Ama muhtemelen tekrar o Shichibukai'yle\Nkarşılaşmak istemediğim için!
Dialogue: 0,0:16:52.82,0:16:55.08,Main,Franky,0,0,0,,Şu iskeletin dövüşü beni endişelendiriyor.
Dialogue: 0,0:16:55.08,0:16:56.51,Main,Franky,0,0,0,,Oraya gideceğim.
Dialogue: 0,0:16:56.51,0:17:00.54,Main,Franky,0,0,0,,Hasır Şapka önce Moria'yı yenerse,\Nbu bir sorunu çözerdi ama...
Dialogue: 0,0:17:00.54,0:17:04.50,Main,Franky,0,0,0,,...bu olana dek kendi gölgesi tarafından öldürülmesi ciddi bir mesele.
Dialogue: 0,0:17:04.50,0:17:08.06,Main,Zoro,0,0,0,,Oraya kadar sana eşlik edeceğim, Franky.
Dialogue: 0,0:17:08.06,0:17:12.67,Main,Zoro,0,0,0,,Şu bahsi geçen "Efsanevi Samuay" ın\Nne kadar güçlü olduğunu merak ediyorum.
Dialogue: 0,0:17:13.20,0:17:15.86,Main,Robin,0,0,0,,Nami-chan ve İskelet-san.
Dialogue: 0,0:17:15.86,0:17:18.01,Main,Robin,0,0,0,,Şimdilik önceliğimiz onlar.
Dialogue: 0,0:17:18.71,0:17:22.18,Main,Robin,0,0,0,,Ondan sonra Moria'yı yenmek, kesinlikle zaferin anahtarı.
Dialogue: 0,0:17:22.67,0:17:25.45,Main,Chopper,0,0,0,,Dediğin kadar basit değil.
Dialogue: 0,0:17:25.45,0:17:27.31,Main,Chopper,0,0,0,,Düşmanımız Shichibukailer'den biri!
Dialogue: 0,0:17:27.58,0:17:28.70,Main,Luffy,0,0,0,,Sorun değil.
Dialogue: 0,0:17:28.70,0:17:30.29,Main,Luffy,0,0,0,,Crocodile da öyleydi.
Dialogue: 0,0:17:31.88,0:17:33.19,Main,Chopper,0,0,0,,Sorun değil mi?!
Dialogue: 0,0:17:33.19,0:17:35.45,Main,Chopper,0,0,0,,Neredeyse öldürülüyordun!
Dialogue: 0,0:17:35.45,0:17:37.93,Main,Chopper,0,0,0,,Yalvarırım dikkatli ol!
Dialogue: 0,0:17:37.93,0:17:42.65,Main,Chopper,0,0,0,,Özellikle de... biliyorum daha önce söyledim ama\Nzombin korkunç derecede büyük olduğu için!
Dialogue: 0,0:17:42.65,0:17:44.37,Main,Luffy,0,0,0,,Tamam, tamam.
Dialogue: 0,0:17:44.37,0:17:45.96,Main,Usopp,0,0,0,,O zaman bunları alın.
Dialogue: 0,0:17:45.96,0:17:48.21,Main,Usopp,0,0,0,,En azından bir kese taşıyın.
Dialogue: 0,0:17:49.35,0:17:52.40,Main,Usopp,0,0,0,,Özel Zombi Arındırma Tuzu Topu'm.
Dialogue: 0,0:17:52.40,0:17:55.71,Main,Zoro,0,0,0,,Ah, demek demin bunları yapıyordun.
Dialogue: 0,0:17:55.71,0:17:56.95,Main,Zoro,0,0,0,,Epey akıllıca.
Dialogue: 0,0:17:56.95,0:17:58.69,Main,Usopp,0,0,0,,Neyse...
Dialogue: 0,0:17:58.69,0:18:01.39,Main,Usopp,0,0,0,,...size bir parça tavsiyede bulunayım.
Dialogue: 0,0:18:02.14,0:18:04.85,Main,Usopp,0,0,0,,Bu denizdeki sis ne kadar yoğun olursa olsun,...
Dialogue: 0,0:18:05.34,0:18:08.52,Main,Usopp,0,0,0,,...güneş ışığının içinden geçmeyeceğinin garantisi yok!
Dialogue: 0,0:18:08.52,0:18:11.40,Main,Usopp,0,0,0,,Şu anda gece yarısı olduğu için güvendeyiz!
Dialogue: 0,0:18:11.90,0:18:16.63,Main,Usopp,0,0,0,,Yani zaman sınırımız, tan vaktinde güneşin yükselmesine kadar!
Dialogue: 0,0:18:17.48,0:18:19.12,Main,Luffy,0,0,0,,Söylemeye bile gerek yok!
Dialogue: 0,0:18:19.12,0:18:22.22,Main,Luffy,0,0,0,,Bir şey yemeden tan vaktine ulaşmak en kötüsü!
Dialogue: 0,0:18:24.84,0:18:28.21,Main,Luffy,0,0,0,,Bizimle uğraştığına seni pişman edeceğiz!
Dialogue: 0,0:18:28.86,0:18:30.75,Main,Luffy,0,0,0,,Gecko Moria!
Dialogue: 0,0:18:31.21,0:18:33.76,Main,Luffy,0,0,0,,Bizden çalınan yiyeceğin iki katını alacağız!
Dialogue: 0,0:18:33.76,0:18:35.18,Main,Luffy,0,0,0,,Tan vaktinden önce!
Dialogue: 0,0:18:36.77,0:18:38.95,Main,Usopp,0,0,0,,Hayır. Şey, öyle değil.
Dialogue: 0,0:18:38.95,0:18:41.01,Main,Usopp,0,0,0,,Gölgelerimizi geri almak için gereken za-
Dialogue: 0,0:18:40.40,0:18:41.01,Secondary,Zoro,0,0,0,,Gidelim!
Dialogue: 0,0:18:41.01,0:18:41.64,Main,All,0,0,0,,Tamam!
Dialogue: 0,0:18:41.64,0:18:43.79,Main,Sanji,0,0,0,,Nami-swan!
Dialogue: 0,0:18:43.79,0:18:48.06,Main,Sanji,0,0,0,,Seni kurtarmaya geliyorum!
Dialogue: 0,0:18:42.14,0:18:43.64,Secondary,Usopp,0,0,0,,Durun bi-
Dialogue: 0,0:18:43.63,0:18:45.32,Secondary,Usopp,0,0,0,,İstediğinizi yapın o zaman!
Dialogue: 0,0:18:50.60,0:18:52.38,Main,Oars,0,0,0,,Müthiş!
Dialogue: 0,0:18:52.38,0:18:55.42,Main,Oars,0,0,0,,Demek bu bir gemi!
Dialogue: 0,0:18:55.42,0:18:58.16,Main,Oars,0,0,0,,Deniz berbat görünüyor.
Dialogue: 0,0:18:58.16,0:19:01.03,Main,Oars,0,0,0,,Ama geleceğim parlak görünüyor!
Dialogue: 0,0:19:01.03,0:19:05.51,Main,Oars,0,0,0,,Tamam, bu gemiyle Korsanlar Kralı olacağım!
Dialogue: 0,0:19:06.29,0:19:08.08,Main,Moriah,0,0,0,,Oz şu anda nerede?
Dialogue: 0,0:19:08.08,0:19:11.21,Main,Perona,0,0,0,,Ana direğin tepesine tırmanmış, Efendi.
Dialogue: 0,0:19:11.21,0:19:13.41,Main,Zombie,0,0,0,,Ama... Ama Efendi!
Dialogue: 0,0:19:13.93,0:19:21.13,Main,Zombie,0,0,0,,Böyle muazzam büyüklükteki bir zombi amaçsızca\Nadada dolanırken bir şey yapmadan duramayız!
Dialogue: 0,0:19:21.13,0:19:23.55,Main,Zombie,0,0,0,,O adam korkunç derecede tehlikeli!
Dialogue: 0,0:19:23.55,0:19:24.84,Main,Moriah,0,0,0,,Endişelenmeyin.
Dialogue: 0,0:19:24.84,0:19:26.85,Main,Moriah,0,0,0,,Sadece an meselesi.
Dialogue: 0,0:19:26.85,0:19:34.31,Main,Moriah,0,0,0,,Şimdi Oz'a sahip olduğumuza göre, \Ndaha güçlü savaşçıların gölgelerini çalabileceğiz.
Dialogue: 0,0:19:34.31,0:19:40.57,Main,Moriah,0,0,0,,Şu andan itibaren birbiri ardına özel zombilerimiz olacak!
Dialogue: 0,0:19:41.40,0:19:46.33,Main,Moriah,0,0,0,,Daha güçlü kuklalara ihtiyacımız var gibi görünüyor, Hogback.
Dialogue: 0,0:19:46.33,0:19:48.72,Main,Hogback,0,0,0,,Bana bırakın!
Dialogue: 0,0:19:53.63,0:19:56.59,Main,Hildon,0,0,0,,H-Hogback-sama!
Dialogue: 0,0:19:57.52,0:19:58.57,Main,Hildon,0,0,0,,Başımız dertte!
Dialogue: 0,0:19:58.57,0:20:00.06,Main,Hildon,0,0,0,,Korsanlar...
Dialogue: 0,0:20:00.79,0:20:02.05,Main,Hogback,0,0,0,,Sorun nedir, Hildon?
Dialogue: 0,0:20:02.05,0:20:08.37,Main,Hildon,0,0,0,,Gölgesi çalınan üçü gemide uyandı ve\Narkadaşlarıyla birlikte buraya geliyor!
Dialogue: 0,0:20:08.62,0:20:10.14,Main,Hogback,0,0,0,,Ne?!
Dialogue: 0,0:20:10.14,0:20:13.56,Main,Hogback,0,0,0,,Gölgesi çalınanlar o kadar çabuk uyanamaz!
Dialogue: 0,0:20:13.56,0:20:17.47,Main,Hildon,0,0,0,,A-Arkadaşları onları uyandırmak için bir yol buldu!
Dialogue: 0,0:20:17.47,0:20:20.28,Main,Hildon,0,0,0,,Şarkı Mırıldanan'la bir tür bağlantıları var gibi görünüyor!
Dialogue: 0,0:20:20.28,0:20:23.70,Main,Hildon,0,0,0,,O adam bildiklerini onlara anlatmış olabilir!
Dialogue: 0,0:20:23.70,0:20:29.39,Main,Hildon,0,0,0,,Korsanların, zombileri nasıl arındıracaklarını biliyor olması bunun kanıtı!
Dialogue: 0,0:20:29.39,0:20:31.12,Main,Hogback,0,0,0,,Ne dedin?!
Dialogue: 0,0:20:33.58,0:20:36.08,Main,Hildon,0,0,0,,Zombiler korsanlardan korkuyor.
Dialogue: 0,0:20:36.08,0:20:38.41,Main,Hildon,0,0,0,,Şu anda köşe bucak kaçıyorlar.
Dialogue: 0,0:20:40.34,0:20:43.95,Main,Hogback,0,0,0,,Korsanların tuzdan haberi yokken bile\NVahşi Zombiler, Sürpriz Zombiler ve...
Dialogue: 0,0:20:43.95,0:20:47.30,Main,Hogback,0,0,0,,...Asker Zombiler onlara bir şey yapamadı!
Dialogue: 0,0:20:48.28,0:20:50.64,Main,Hogback,0,0,0,,Zombi Generalleri'ni gönderin!
Dialogue: 0,0:20:52.18,0:20:55.65,Main,Hogback,0,0,0,,Tuz yutmadıkları sürece korsanların icabına bakacaklardır!
Dialogue: 0,0:20:55.65,0:20:58.94,Main,Hogback,0,0,0,,Sahi, Absalom ne haltlar karıştırıyor?!
Dialogue: 0,0:20:58.94,0:21:01.84,Main,Hildon,0,0,0,,Şey, o...
Dialogue: 0,0:21:01.84,0:21:05.50,Main,Hildon,0,0,0,,Şu anda düğünü başlamak üzere.
Dialogue: 0,0:21:05.50,0:21:09.28,Main,Hildon,0,0,0,,Zombi generallerin çoğu iştirak ediyor.
Dialogue: 0,0:21:12.23,0:21:14.66,Main,Hogback,0,0,0,,O ahmaklar ne yapıyor?!
Dialogue: 0,0:21:16.96,0:21:23.68,Main,Hildon,0,0,0,,Sahi, törende Hogback-sama'nın bir saatliğine göbek\Ndanslarından birini yapıp yapamayacağını sordu.
Dialogue: 0,0:21:24.76,0:21:26.17,Main,Hogback,0,0,0,,Haklısın.
Dialogue: 0,0:21:26.17,0:21:28.41,Main,Hogback,0,0,0,,Düğün töreni, hayatta bir kez gerçekleşen anısal bir olaydır.
Dialogue: 0,0:21:28.41,0:21:30.72,Main,Hogback,0,0,0,,Eğlenceli bir dans ol-
Dialogue: 0,0:21:30.72,0:21:32.60,Main,Hogback,0,0,0,,Bunu yapar mıyım sanki?!
Dialogue: 0,0:21:33.62,0:21:37.58,Main,Hogback,0,0,0,,Düğünü hemen iptal edin!
Dialogue: 0,0:21:37.58,0:21:39.61,Main,Hildon,0,0,0,,Ben basit bir zombiyim.
Dialogue: 0,0:21:39.61,0:21:41.98,Main,Hildon,0,0,0,,Absalom-sama'ya karşı gelemem.
Dialogue: 0,0:21:44.97,0:21:47.30,Main,Perona,0,0,0,,O hayvana güvenmeye gerek yok.
Dialogue: 0,0:21:48.98,0:21:53.91,Main,Perona,0,0,0,,Hayaletlerim onları zayıflatırsa, Asker Zombiler onları yakalamak için yeter de artar bile.
Dialogue: 0,0:21:54.47,0:21:57.33,Main,Perona,0,0,0,,Zombilerin zayıflıklarını biliyorlar diye panikleme.
Dialogue: 0,0:21:59.33,0:22:02.60,Main,Perona,0,0,0,,Her birini yakalayacağım, bu yüzden...
Dialogue: 0,0:22:02.60,0:22:06.13,Main,Perona,0,0,0,,...kalan korsanların gölgeleri için birkaç kukla hazırla.
Dialogue: 0,0:22:06.13,0:22:08.60,Main,Perona,0,0,0,,Odama dönüyorum.
Dialogue: 0,0:22:08.60,0:22:10.44,Main,Perona,0,0,0,,Gidelim, Ayıcık.
Dialogue: 0,0:22:10.44,0:22:12.10,Main,Bearsy,0,0,0,,Hemen.
Dialogue: 0,0:22:12.10,0:22:13.63,Main,Hogback,0,0,0,,Doğru.
Dialogue: 0,0:22:13.63,0:22:15.04,Main,Hogback,0,0,0,,Ne kadar güvenilir.
Dialogue: 0,0:22:15.04,0:22:17.05,Main,Hogback,0,0,0,,Hayalet Prensesi'nden daha azını beklemezdim.
Dialogue: 0,0:22:18.57,0:22:19.51,Main,Hogback,0,0,0,,Ne?
Dialogue: 0,0:22:19.51,0:22:22.76,Main,Cindy,0,0,0,,Ayıcık örneğinden ders alsaydın...
Dialogue: 0,0:22:22.76,0:22:23.82,Main,Cindy,0,0,0,,...iyi olurdu.
Dialogue: 0,0:22:25.85,0:22:26.96,Main,Hogback,0,0,0,,Neyse...
Dialogue: 0,0:22:26.96,0:22:29.28,Main,Hogback,0,0,0,,...her şey yoluna girecek, Moria-sama!
Dialogue: 0,0:22:29.28,0:22:31.44,Main,Moriah,0,0,0,,Öyle mi?
Dialogue: 0,0:22:31.44,0:22:33.22,Main,Moriah,0,0,0,,Ne sıkıcı.
Dialogue: 0,0:22:33.22,0:22:35.05,Main,Hogback,0,0,0,,Yine mi?
Dialogue: 0,0:22:35.05,0:22:37.33,Main,Hogback,0,0,0,,Neyse, bir şey yapmak zorunda değilsiniz.
Dialogue: 0,0:22:37.33,0:22:39.98,Main,Moria,0,0,0,,Biraz daha burada kalacağım.
Dialogue: 0,0:22:39.98,0:22:42.75,Main,Moria,0,0,0,,Oz şu anda beni daha çok eğlendiriyor.
Dialogue: 0,0:22:42.75,0:22:45.51,Main,Hogback,0,0,0,,O zaman bir ricam olacak.
Dialogue: 0,0:22:45.51,0:22:51.05,Main,Hogback,0,0,0,,Absalom hiçbir şey yapmadığı için, mümkünse\Nsadece iki zombinin komutasını üstlenmek istiyorum.
Dialogue: 0,0:22:52.57,0:22:54.24,Main,Zombie,0,0,0,,İstediğini yap.
Dialogue: 0,0:22:56.91,0:23:00.06,Main,Luffy,0,0,0,,Moria nerede?!
Dialogue: 0,0:22:58.06,0:23:00.06,Secondary,Zombie,0,0,0,,İşte geliyorlar!
Dialogue: 0,0:23:01.19,0:23:03.04,Main,Luffy,0,0,0,,Çekilin yolumdan!
Dialogue: 0,0:23:03.48,0:23:05.80,Main,Luffy,0,0,0,,Yiyeceği geri verin!
Dialogue: 0,0:23:05.80,0:23:09.80,Main,Sanji,0,0,0,,Nami-san duş alırken onu gözetleyen kahrolası pislik kim?!
Dialogue: 0,0:23:10.63,0:23:12.22,Main,Sanji,0,0,0,,Göster kendini!
Dialogue: 0,0:23:14.26,0:23:16.95,Main,Usopp,0,0,0,,Şimdilik tuza ihtiyacımız olmayacak gibi.
Dialogue: 0,0:23:16.95,0:23:18.73,Main,Usopp,0,0,0,,Mutlak bir öfkeyle her yeri dağıtıyorlar.
Dialogue: 0,0:23:18.73,0:23:21.67,Main,Chopper,0,0,0,,Gölgelerini umursuyorlar mı merak ediyorum.
Dialogue: 0,0:23:22.11,0:23:25.86,Main,Zombie,0,0,0,,K-Kaptan! Dans Salonu'na giden beş kişi var!
Dialogue: 0,0:23:25.86,0:23:29.30,Main,Zombie,0,0,0,,Aşağı köprüdeki ikisiyle baş edemiyoruz!
Dialogue: 0,0:23:25.86,0:23:29.30,Main,,0,0,0,,{\pos(384,122)}{\fs35}Moria'nın Dans Salonu
Dialogue: 0,0:23:25.86,0:23:29.30,Main,,0,0,0,,{\pos(388,374)}{\fs35}Perona'nın Odası
Dialogue: 0,0:23:25.86,0:23:29.30,Main,,0,0,0,,{\pos(436,624)}{\fs35}Harika Bahçe
Dialogue: 0,0:23:25.86,0:23:29.30,Main,,0,0,0,,{\pos(1080,198)}{\fs35}{\a4}Moria'nın \NDans Salonu'na \NGidiyor
Dialogue: 0,0:23:25.86,0:23:29.30,Main,,0,0,0,,{\pos(1075,532)}{\fs35}{\a4}Perona'nın \NOdasına \NGidiyor
Dialogue: 0,0:23:31.24,0:23:36.58,Main,Zoro,0,0,0,,Bu güçsüz herifler tarafından yakalanmış\Nolduğumu düşünmek beni öfkelendiriyor!
Dialogue: 0,0:23:36.58,0:23:42.42,Main,Franky,0,0,0,,Seni serbest bıraktığıma o kadar minnettarsan,\Nistersen bana "abi" demeye başlayabilirsin.
Dialogue: 0,0:23:41.64,0:23:42.42,Secondary,Zoro,0,0,0,,Der miyim sanki?!
Dialogue: 0,0:23:43.27,0:23:44.78,Main,Robin,0,0,0,,Olamaz! Bu çok kötü!
Dialogue: 0,0:23:44.78,0:23:46.40,Main,Usopp,0,0,0,,Ne? Sorun nedir?
Dialogue: 0,0:23:46.40,0:23:48.24,Main,Luffy,0,0,0,,Her şey bitti.
Dialogue: 0,0:23:48.24,0:23:51.75,Main,Luffy,0,0,0,,Yeniden doğsaydım, kurtçuk olmak isterdim.
Dialogue: 0,0:23:51.75,0:23:55.91,Main,Sanji,0,0,0,,Çok büyük kaşlarım var! Ölsem daha iyi.
Dialogue: 0,0:23:55.91,0:23:57.95,Main,Usopp,0,0,0,,Hey! Luffy, Sanji!
Dialogue: 0,0:23:57.95,0:23:59.50,Main,Usopp,0,0,0,,Neyiniz var sizin?!
Dialogue: 0,0:23:59.99,0:24:02.08,Main,Usopp,0,0,0,,Robin, neler oluyor?
Dialogue: 0,0:24:02.08,0:24:04.02,Main,Robin,0,0,0,,Bu hayaletlerin işi!
Dialogue: 0,0:24:04.02,0:24:06.46,Main,Robin,0,0,0,,Onlara dokununca yaşama arzunu yitiriyorsun.
Dialogue: 0,0:24:06.46,0:24:09.34,Main,Robin,0,0,0,,Buna karşı bir önlem bulamadık.
Dialogue: 0,0:24:09.34,0:24:12.97,Main,Zombie,0,0,0,,Evet! Şimdi seni yakaladım!
Dialogue: 0,0:24:13.22,0:24:14.34,Main,Usopp,0,0,0,,{\fad(150,50)}Kurşun Yıldızı!
Dialogue: 0,0:24:19.04,0:24:21.50,Main,Usopp,0,0,0,,Acele edin!
Dialogue: 0,0:24:23.24,0:24:25.58,Main,Usopp,0,0,0,,Bizi de yakalarlarsa her şey biter!
Dialogue: 0,0:24:26.63,0:24:28.73,Main,Robin,0,0,0,,Hayaletler neredeyse bize erişti!
Dialogue: 0,0:24:28.73,0:24:32.20,Main,Chopper,0,0,0,,Hayır! Hepimiz yakalanırsak, işimiz biter!
Dialogue: 0,0:24:32.20,0:24:34.61,Main,Oars,0,0,0,,Ayrıl! Ayrıl!
Dialogue: 0,0:24:44.14,0:24:47.29,Main,Usopp,0,0,0,,Düşüyoruz!
Dialogue: 0,0:24:47.29,0:24:48.67,Main,Chopper,0,0,0,,Usopp!
Dialogue: 0,0:24:48.67,0:24:49.71,Main,Chopper,0,0,0,,Sanji!
Dialogue: 0,0:25:01.56,0:25:02.93,Main,Chopper,0,0,0,,O şey...
Dialogue: 0,0:25:02.93,0:25:06.49,Main,Chopper,0,0,0,,Olamaz, imkansız.
Dialogue: 0,0:25:06.49,0:25:08.34,Main,Chopper,0,0,0,,Ödümü kopardı.
Dialogue: 0,0:25:08.34,0:25:09.30,Main,Chopper,0,0,0,,Merdivenler gitmiş!
Dialogue: 0,0:25:09.30,0:25:10.48,Main,Luffy,0,0,0,,S-S-Sorun nedir?!
Dialogue: 0,0:25:10.48,0:25:12.26,Main,Luffy,0,0,0,,Ne oldu?
Dialogue: 0,0:25:12.26,0:25:16.08,Main,Chopper,0,0,0,,Zombiler, Usopp, Sanji.
Dialogue: 0,0:25:16.08,0:25:19.20,Main,Chopper,0,0,0,,Herkes düştü.
Dialogue: 0,0:25:19.20,0:25:23.80,Main,Zoro,0,0,0,,Şu ikisinin düşmüş olması bir yana...
Dialogue: 0,0:25:23.80,0:25:25.69,Main,Zoro,0,0,0,,...bu ne demek oluyor?
Dialogue: 0,0:25:25.69,0:25:29.27,Main,Franky,0,0,0,,Yolumuz aniden tıkandı.
Dialogue: 0,0:25:29.27,0:25:31.71,Main,Franky,0,0,0,,O duvar da ne öyle?
Dialogue: 0,0:25:31.71,0:25:33.36,Main,Sanji,0,0,0,,Kahretsin!
Dialogue: 0,0:25:33.36,0:25:34.80,Main,Sanji,0,0,0,,Ne oldu böyle?
Dialogue: 0,0:25:37.55,0:25:39.35,Main,Usopp,0,0,0,,Demin...
Dialogue: 0,0:25:43.08,0:25:44.73,Main,Zoro,0,0,0,,Taş değil.
Dialogue: 0,0:25:45.22,0:25:46.85,Main,Franky,0,0,0,,{\fad(150,150)}Sol Silahlar!
Dialogue: 0,0:25:49.14,0:25:49.69,Main,Franky,0,0,0,,Ne?!
Dialogue: 0,0:25:50.29,0:25:52.11,Main,Usopp,0,0,0,,Ne yapıyorsunuz siz?!
