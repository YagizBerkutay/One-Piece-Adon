Dialogue: 0,0:02:29.90,0:02:36.33,Title,,0,0,0,,{\fad(200,3500)}Her Şeyi Saptırabilecek Güç?!\NZoro'nun Fedakarlığı.
Dialogue: 0,0:02:40.17,0:02:41.71,Main,Usopp,0,0,0,,Hey, Zoro!
Dialogue: 0,0:02:41.71,0:02:43.14,Main,Nami,0,0,0,,Robin!
Dialogue: 0,0:02:43.14,0:02:44.91,Main,Chopper,0,0,0,,Sanji!
Dialogue: 0,0:02:45.82,0:02:50.78,Main,Both,0,0,0,,Bedenleri parçalanıyor!
Dialogue: 0,0:02:53.75,0:02:55.64,Main,Franky,0,0,0,,Niye?!
Dialogue: 0,0:02:55.64,0:02:57.22,Main,Franky,0,0,0,,Kazanmadık mı?!
Dialogue: 0,0:02:57.22,0:03:00.36,Main,Franky,0,0,0,,Hey! Zamanında başaramadık mı?!
Dialogue: 0,0:03:01.97,0:03:03.20,Main,Pirate,0,0,0,,Yok oluyorlar!
Dialogue: 0,0:03:05.28,0:03:08.10,Main,Pirate,0,0,0,,Kaptan Lola!
Dialogue: 0,0:03:08.63,0:03:10.77,Main,Pirate,0,0,0,,Çocuklar!
Dialogue: 0,0:03:12.07,0:03:14.71,Main,Pirate,0,0,0,,Kazanmalıydık!
Dialogue: 0,0:03:14.71,0:03:17.98,Main,Pirate,0,0,0,,Kahretsin!
Dialogue: 0,0:03:17.98,0:03:20.08,Captions,MSG,0,0,140,,[Grand Line'daki bir korsan gemisinde]
Dialogue: 0,0:03:18.35,0:03:20.08,Main,Pirate,0,0,0,,{\an8}Kaptan!
Dialogue: 0,0:03:21.21,0:03:23.45,Main,Pirate,0,0,0,,Güverteye gelin, kaptan!
Dialogue: 0,0:03:23.80,0:03:25.77,Main,Captain,0,0,0,,Aptallık etmeyi bırak ve uyu!
Dialogue: 0,0:03:25.77,0:03:28.13,Main,Captain,0,0,0,,Güneş ışığında yok olursun.
Dialogue: 0,0:03:28.13,0:03:30.97,Main,Captain,0,0,0,,Gölgelerimiz Moria tarafından çalınalı beri 2 yıl geçti.
Dialogue: 0,0:03:30.97,0:03:32.49,Main,Pirate,0,0,0,,Bunu görmelisin, kaptan!
Dialogue: 0,0:03:32.49,0:03:34.66,Main,Pirate,0,0,0,,Ayağıma doğru bak!
Dialogue: 0,0:03:37.68,0:03:40.20,Main,Captain,0,0,0,,Gölgen var!
Dialogue: 0,0:03:41.18,0:03:43.14,Main,Captain,0,0,0,,Gölgelerimizi geri aldık!
Dialogue: 0,0:03:44.64,0:03:46.40,Main,Pirate,0,0,0,,Herkesinki geldi, kaptan!
Dialogue: 0,0:03:46.40,0:03:49.37,Main,Pirate,0,0,0,,Gölgelerimizin her biri döndü!
Dialogue: 0,0:03:49.37,0:03:53.11,Main,Pirate,0,0,0,,Kaptan, biri Moria'yı yenmiş olabilir mi?
Dialogue: 0,0:03:53.34,0:03:54.76,Main,Captain,0,0,0,,Saçmalık!
Dialogue: 0,0:03:54.76,0:03:56.82,Main,Captain,0,0,0,,Bu mümkün değil.
Dialogue: 0,0:03:57.22,0:04:02.29,Main,Captain,0,0,0,,Moria, bir zamanlar Yonkou'dan\NKaidou'ya denk dövüşen bir korsandı.
Dialogue: 0,0:04:02.65,0:04:06.98,Main,Captain,0,0,0,,Moria'yı yenebilecek birini nereden bulacaksın?
Dialogue: 0,0:04:09.19,0:04:12.70,Captions,MSG,0,0,140,,[Grand Line'da ve Batı Mavi'de rasgele yerler]
Dialogue: 0,0:04:12.70,0:04:16.50,Main,Castaway,0,0,0,,Geri döndü! Gölgem!
Dialogue: 0,0:04:17.61,0:04:20.95,Main,Castaway,0,0,0,,Güneş ışığını görmeyeli kaç yıl oldu?!
Dialogue: 0,0:04:20.95,0:04:25.11,Main,Castaway,0,0,0,,Thriller Bark'taki zombilerimiz ölmüş olmalı!
Dialogue: 0,0:04:28.08,0:04:30.63,Main,Is he mexican?,0,0,0,,Moria'nın laneti kalktı!
Dialogue: 0,0:04:30.63,0:04:32.28,Main,Pirate,0,0,0,,Patron!
Dialogue: 0,0:04:34.59,0:04:36.43,Main,Guy,0,0,0,,Güneş ışığını görebiliyoruz!
Dialogue: 0,0:04:36.43,0:04:37.46,Main,Guy,0,0,0,,Gölgelerimize bakın!
Dialogue: 0,0:04:37.46,0:04:39.56,Main,Guy,0,0,0,,Peşimizden geliyorlar!
Dialogue: 0,0:04:45.64,0:04:48.70,Main,Margarita,0,0,0,,Görüntüm orada!
Dialogue: 0,0:04:48.70,0:04:51.77,Main,Master,0,0,0,,Bu karmaşa da ne, Margarita?!
Dialogue: 0,0:04:51.77,0:04:53.09,Main,Margarita,0,0,0,,Gölgem!
Dialogue: 0,0:04:53.09,0:04:55.07,Main,Margarita,0,0,0,,Gölgem geri geldi!
Dialogue: 0,0:04:55.07,0:04:55.95,Main,Master,0,0,0,,Ne?
Dialogue: 0,0:04:55.95,0:04:58.26,Main,Master,0,0,0,,Gölgen mi?
Dialogue: 0,0:04:58.26,0:05:01.55,Main,Master,0,0,0,,10 yıl önce korsanlar tarafından\Nçalındığını söylediğin gölgen mi?
Dialogue: 0,0:05:02.45,0:05:04.48,Main,Master,0,0,0,,Doğru.
Dialogue: 0,0:05:06.53,0:05:08.48,Main,Margarita,0,0,0,,Efendi, çok üzgünüm!
Dialogue: 0,0:05:08.48,0:05:12.26,Main,Margarita,0,0,0,,O kadar şaşırdım ki çok sevdiğiniz tabaklarınızı kırdım!
Dialogue: 0,0:05:12.26,0:05:19.00,Main,Margarita,0,0,0,,Tabaklardan nefret ederdim ama artık bunun üstesinden geldiğim için...
Dialogue: 0,0:05:21.68,0:05:23.80,Main,Margarita,0,0,0,,Sizi sıkıntıya soktuğum için üzgünüm.
Dialogue: 0,0:05:23.80,0:05:25.98,Main,Margarita,0,0,0,,Malikâneyi hemen terkedeceğim.
Dialogue: 0,0:05:29.31,0:05:30.99,Main,Master,0,0,0,,Neden bahsediyorsun?
Dialogue: 0,0:05:30.99,0:05:33.13,Main,Master,0,0,0,,Tabaklar kimin umrunda?
Dialogue: 0,0:05:34.28,0:05:38.44,Main,Master,0,0,0,,Önemli olan yaralanmamış olman.
Dialogue: 0,0:05:38.44,0:05:41.93,Main,Master,0,0,0,,Senin adına çok sevindim, Margarita.
Dialogue: 0,0:05:41.93,0:05:43.56,Main,Master,0,0,0,,Bu harika, değil mi?!
Dialogue: 0,0:05:44.53,0:05:46.89,Main,Margarita,0,0,0,,Evet!
Dialogue: 0,0:05:47.11,0:05:50.76,Captions,,0,0,220,,{\fad(500,0)}Thriller Bark
Dialogue: 0,0:05:57.73,0:06:00.24,Main,Zoro,0,0,0,,Yaşıyor gibiyim!
Dialogue: 0,0:06:00.24,0:06:03.38,Main,Robin,0,0,0,,Bir an Cennet'e gideceğimi sanmıştım!
Dialogue: 0,0:06:03.38,0:06:05.45,Main,Sanji,0,0,0,,Bana uyar!
Dialogue: 0,0:06:05.45,0:06:08.28,Main,Sanji,0,0,0,,Robin-chan'la birlikte olduğum sürece\Nmemnuniyetle Cennet'e giderim!
Dialogue: 0,0:06:08.28,0:06:09.73,Main,Usopp,0,0,0,,Manyak gibi gülmeyin, aptallar!
Dialogue: 0,0:06:09.73,0:06:13.39,Main,Usopp,0,0,0,,Kesinlikle öldüğünüzü sanmıştık! Beni duyuyor musunuz?!
Dialogue: 0,0:06:13.82,0:06:16.19,Main,Both,0,0,0,,Çok korkunçtu!
Dialogue: 0,0:06:16.19,0:06:18.12,Main,Pirate,0,0,0,,Güneş ışığı!
Dialogue: 0,0:06:18.47,0:06:20.39,Main,Pirate,0,0,0,,Artık güneş ışığından korkmuyoruz!
Dialogue: 0,0:06:20.83,0:06:22.53,Main,Lola,0,0,0,,Gölgelerimizi aldık!
Dialogue: 0,0:06:22.87,0:06:25.54,Main,Pirate,0,0,0,,Karanlık günlerimiz nihayet sona erdi!
Dialogue: 0,0:06:25.54,0:06:27.09,Main,Pirate,0,0,0,,Yaşasın!
Dialogue: 0,0:06:27.09,0:06:28.10,Main,Pirate,0,0,0,,Yaşasın!
Dialogue: 0,0:06:29.10,0:06:31.47,Main,Chopper,0,0,0,,Oradakiler de iyi görünüyor.
Dialogue: 0,0:06:32.08,0:06:35.69,Main,Robin,0,0,0,,Güneş ışığı varlığımızı sildi...
Dialogue: 0,0:06:35.69,0:06:40.25,Main,Robin,0,0,0,,...ama gölgelerimiz zamanında dönerek bizi iyileştirdi.
Dialogue: 0,0:06:40.73,0:06:46.75,Main,Sanji,0,0,0,,Muhtemelen Moria'nın, nesnelerin şeklini değiştirirken gölgelerini kullanmasındaki teorinin aynısı.
Dialogue: 0,0:06:46.75,0:06:51.96,Main,Sanji,0,0,0,,Tek anladığım, bir nesnenin gölgesiyle aynı şekle sahip olduğu ama...
Dialogue: 0,0:06:52.36,0:06:53.77,Main,Zoro,0,0,0,,Rahatla.
Dialogue: 0,0:06:53.77,0:06:59.43,Main,Zoro,0,0,0,,Gölgelerimizin bedenlerimizden ayrılması gibi\Nheyecan verici bir olay, bir daha asla olmayacak.
Dialogue: 0,0:06:59.77,0:07:03.60,Main,Usopp,0,0,0,,Neyse, kimsenin yok olmamasına sevindim.
Dialogue: 0,0:07:05.28,0:07:08.37,Main,Franky,0,0,0,,Nihayet kendimi yorgun ve uykulu hissediyorum.
Dialogue: 0,0:07:08.37,0:07:10.31,Main,Franky,0,0,0,,Kolası olan var mı?
Dialogue: 0,0:07:10.68,0:07:17.28,Main,Sanji,0,0,0,,Bu adaya geldiğimizden beri olan her şey,\NMoria'nın bize gösterdiği bir ilüzyondu.
Dialogue: 0,0:07:17.98,0:07:21.82,Main,Sanji,0,0,0,,Şimdi yenildiği için, adada hiçbir şey kalmadı.
Dialogue: 0,0:07:22.47,0:07:26.22,Main,Sanji,0,0,0,,Neredeyse hepimiz kötü bir kâbustan uyanmış gibiyiz.
Dialogue: 0,0:07:26.55,0:07:30.20,Main,Sanji,0,0,0,,Cidden kötü bir hayalet sürüşü yaşadık.
Dialogue: 0,0:07:31.10,0:07:33.20,Main,Hogback,0,0,0,,Uyan, Absalom!
Dialogue: 0,0:07:33.20,0:07:35.04,Main,Hogback,0,0,0,,Hey, uyan!
Dialogue: 0,0:07:41.48,0:07:42.61,Main,Absalom,0,0,0,,Lola!
Dialogue: 0,0:07:42.61,0:07:44.24,Main,Hogback,0,0,0,,Panikleme.
Dialogue: 0,0:07:44.24,0:07:46.58,Main,Hogback,0,0,0,,Gölgesi gitti artık.
Dialogue: 0,0:07:46.58,0:07:48.58,Main,Absalom,0,0,0,,Hogback?
Dialogue: 0,0:07:48.58,0:07:51.32,Main,Absalom,0,0,0,,Bana ne oldu?
Dialogue: 0,0:07:51.72,0:07:54.24,Main,Hogback,0,0,0,,Sana ne olduğunu nereden bileyim?!
Dialogue: 0,0:07:54.24,0:07:56.70,Main,Hogback,0,0,0,,Muhtemelen utanç verici bir biçimde birine yenildin!
Dialogue: 0,0:07:56.70,0:07:59.32,Main,Hogback,0,0,0,,Neyse, Moria-sama'ya kötü bir şey oldu.
Dialogue: 0,0:08:01.23,0:08:02.83,Main,Absalom,0,0,0,,NE?!
Dialogue: 0,0:08:03.43,0:08:05.73,Main,Absalom,0,0,0,,Moria-sama, Hasır Şapka tarafından yenildi mi?!
Dialogue: 0,0:08:06.70,0:08:08.08,Main,Hogback,0,0,0,,Sesin çok yüksek!
Dialogue: 0,0:08:08.08,0:08:09.47,Main,Hogback,0,0,0,,Sessiz ol!
Dialogue: 0,0:08:09.47,0:08:10.80,Main,Hogback,0,0,0,,Sesin aşırı yüksek!
Dialogue: 0,0:08:12.53,0:08:15.43,Main,Hogback,0,0,0,,Thriller Bark artık işime yaramaz.
Dialogue: 0,0:08:15.43,0:08:18.94,Main,Hogback,0,0,0,,Ama hayatımı ezik biri olarak sürdürmek niyetinde değilim!
Dialogue: 0,0:08:19.31,0:08:20.78,Main,Hogback,0,0,0,,Ya sen?
Dialogue: 0,0:08:21.45,0:08:24.05,Main,Absalom,0,0,0,,Ben mi?
Dialogue: 0,0:08:26.02,0:08:29.49,Main,Zoro,0,0,0,,Luffy daha önce küçülmedi mi?
Dialogue: 0,0:08:29.49,0:08:34.16,Main,Chopper,0,0,0,,"Dev Düzen" i kullanırken yan etki olarak küçüldüğünü daha önce bana söylemişti.
Dialogue: 0,0:08:34.84,0:08:40.03,Main,Usopp,0,0,0,,Siz de Luffy'nin yeni dövüş tarzının, bedenine biraz fazla zararlı olduğunu düşünmüyor musunuz?
Dialogue: 0,0:08:40.48,0:08:46.47,Main,Usopp,0,0,0,,Şu andan itibaren daha güçlü düşmanlar olacaksa, bunları kullanmaya devam etmek zorunda.
Dialogue: 0,0:08:47.15,0:08:49.77,Main,Usopp,0,0,0,,En kısa sürede kendimizi toparlamazsak,...
Dialogue: 0,0:08:55.85,0:08:57.41,Main,Usopp,0,0,0,,Zombi!
Dialogue: 0,0:08:57.41,0:08:59.35,Main,Usopp,0,0,0,,Gölgesi alınmayan bir tane kalmış mı?!
Dialogue: 0,0:08:59.80,0:09:01.93,Main,Old man,0,0,0,,Hayır, ben sadece koca bir yarası olan yaşlı bir adamım!
Dialogue: 0,0:09:01.93,0:09:04.72,Main,Usopp,0,0,0,,Çok kafa karıştırıcı! Sadece zombi olsaydın daha kolay olmaz mıydı?
Dialogue: 0,0:09:05.27,0:09:07.93,Main,Sanji,0,0,0,,Mezarlıkta karşılaştığımız yaşlı adam değil misin sen?
Dialogue: 0,0:09:08.36,0:09:10.01,Main,Old man,0,0,0,,İnanılmaz.
Dialogue: 0,0:09:10.01,0:09:14.17,Main,Old man,0,0,0,,Tekrar güneş altında yürüyebileceğimiz\Nbir günü göreceğimizi düşünmek...
Dialogue: 0,0:09:14.69,0:09:16.14,Main,Old man,0,0,0,,Sağolun!
Dialogue: 0,0:09:16.14,0:09:18.39,Main,Old man,0,0,0,,Size borcumuzu nasıl öderiz, bilmiyorum.
Dialogue: 0,0:09:18.39,0:09:21.57,Main,Pirate,0,0,0,,Hey, yaşlı adam Spoil!
Dialogue: 0,0:09:21.97,0:09:23.41,Main,Pirate,0,0,0,,Yaşlı adam!
Dialogue: 0,0:09:23.41,0:09:26.54,Main,Pirate,0,0,0,,Kurbanlar derneğinin başkanı!
Dialogue: 0,0:09:27.45,0:09:31.47,Main,Old man,0,0,0,,Oh, siz! Hepiniz iyi misiniz?!
Dialogue: 0,0:09:31.47,0:09:33.05,Main,Lola,0,0,0,,İyi misin, yaşlı adam?
Dialogue: 0,0:09:33.05,0:09:34.43,Main,Old man,0,0,0,,Evet!
Dialogue: 0,0:09:34.43,0:09:37.16,Main,Usopp,0,0,0,,Birbirinizi tanıyor musunuz yoksa?
Dialogue: 0,0:09:37.16,0:09:40.63,Main,Lola,0,0,0,,Ah, evet. Sanırım size büyük teşekkür borçluyuz.
Dialogue: 0,0:09:41.00,0:09:43.59,Main,Pirate,0,0,0,,Size gerçekten çok minnettarız!
Dialogue: 0,0:09:43.59,0:09:45.60,Main,Pirate,0,0,0,,Sıkıntılarımıza sizi de bulaştırdığımız için üzgünüz!
Dialogue: 0,0:09:45.92,0:09:50.80,Main,Pirate,0,0,0,,Onlara karşı gerçekten tek umudumuzdunuz!
Dialogue: 0,0:09:51.08,0:09:53.09,Main,Lola,0,0,0,,Sağolun çocuklar.
Dialogue: 0,0:09:53.09,0:09:55.77,Main,Lola,0,0,0,,Thriller Bark kurbanlarının her üyesi...
Dialogue: 0,0:10:00.86,0:10:04.07,Main,Lola,0,0,0,,...bunu asla unutmayacak!
Dialogue: 0,0:10:04.07,0:10:06.08,Main,All,0,0,0,,Çok sağolun!
Dialogue: 0,0:10:07.10,0:10:09.81,Main,Old man,0,0,0,,Ne zaman bir şeye ihtiyacınız olursa beni çağırın!
Dialogue: 0,0:10:09.81,0:10:12.74,Main,Old man,0,0,0,,Pek bir şeyimiz yok ama lütfen istediğinizi alın!
Dialogue: 0,0:10:13.54,0:10:16.74,Main,Lola,0,0,0,,Asıl önemlisi, biriniz benimle evlenin!
Dialogue: 0,0:10:18.81,0:10:19.73,Main,Men,0,0,0,,Olmaz!
Dialogue: 0,0:10:20.22,0:10:22.42,Main,Zoro,0,0,0,,Bize teşekkür etseniz bile,...
Dialogue: 0,0:10:22.42,0:10:23.63,Main,Lola,0,0,0,,Neyse!
Dialogue: 0,0:10:23.63,0:10:25.82,Main,Zoro,0,0,0,,...Luffy sana zaten söylemişti, yaşlı adam.
Dialogue: 0,0:10:25.82,0:10:26.61,Main,Lola,0,0,0,,Hey, sen!
Dialogue: 0,0:10:26.61,0:10:29.59,Main,Zoro,0,0,0,,Biz sadece kendi koşullarımız için dövüşürüz.
Dialogue: 0,0:10:29.59,0:10:30.63,Main,Lola,0,0,0,,Benimle evlenmek istemiyor musun?!
Dialogue: 0,0:10:30.63,0:10:32.66,Main,Zoro,0,0,0,,Siz sadece ekstradan kurtarıldınız.
Dialogue: 0,0:10:34.35,0:10:35.80,Main,Nami,0,0,0,,Ne diyorsun sen?!
Dialogue: 0,0:10:35.80,0:10:37.95,Main,Nami,0,0,0,,Hem de sonunda biri bize teşekkür etmişken!
Dialogue: 0,0:10:40.05,0:10:41.73,Main,Pirate,0,0,0,,Evet, kardeş!
Dialogue: 0,0:10:41.73,0:10:43.50,Main,Pirate,0,0,0,,Bırakın da teşekkür edelim!
Dialogue: 0,0:10:43.50,0:10:47.33,Main,Pirate,0,0,0,,Ekstra olsun veya olmasın, yine de\NMoria'yı yendiğiniz için minnettarız!
Dialogue: 0,0:10:48.81,0:10:51.10,Main,Nami,0,0,0,,Gördünüz mü?! Değil mi?
Dialogue: 0,0:10:51.89,0:10:53.36,Main,Usopp,0,0,0,,Hey, gözlerin...
Dialogue: 0,0:10:57.87,0:11:01.20,Main,Nami,0,0,0,,Sahi! Gerçekten önemli bir şeyi unuttum!
Dialogue: 0,0:11:01.20,0:11:02.64,Main,Usopp,0,0,0,,Neyi?
Dialogue: 0,0:11:03.67,0:11:07.51,Main,Nami,0,0,0,,Onun varlığını tamamen unuttum.
Dialogue: 0,0:11:07.93,0:11:09.14,Main,Robin,0,0,0,,Ne oldu?
Dialogue: 0,0:11:09.14,0:11:11.23,Main,Nami,0,0,0,,Bu gerçekten ciddi!
Dialogue: 0,0:11:11.23,0:11:12.50,Main,Den-Den Mushi,0,0,0,,{\i1}Anlıyorum.{\i0}
Dialogue: 0,0:11:15.11,0:11:18.87,Main,Den-Den Mushi,0,0,0,,{\i1}Yani en büyük korkum gerçeğe mi dönüştü?{\i0}
Dialogue: 0,0:11:18.87,0:11:20.43,Main,Kuma,0,0,0,,Öyle görünüyor.
Dialogue: 0,0:11:21.80,0:11:23.94,Main,Usopp,0,0,0,,O da kim?
Dialogue: 0,0:11:23.94,0:11:26.33,Main,Nami,0,0,0,,Geldi!
Dialogue: 0,0:11:27.45,0:11:29.80,Main,Nami,0,0,0,,Sakin olun ve beni dinleyin.
Dialogue: 0,0:11:30.94,0:11:33.94,Main,Nami,0,0,0,,Moriagil'le yaptığımız dövüş sırasında...
Dialogue: 0,0:11:34.79,0:11:37.81,Main,Nami,0,0,0,,Size söylemeyi unuttum ama...
Dialogue: 0,0:11:37.81,0:11:43.41,Main,Nami,0,0,0,,...bu adada bir tane daha...
Dialogue: 0,0:11:45.56,0:11:47.52,Main,Nami,0,0,0,,...Shichibukai var!
Dialogue: 0,0:11:50.89,0:11:53.53,Main,Usopp,0,0,0,,Ne dedin sen?
Dialogue: 0,0:11:54.82,0:11:56.43,Main,Usopp,0,0,0,,O!
Dialogue: 0,0:11:56.43,0:11:59.03,Main,All,0,0,0,,Shichibukai mi?!
Dialogue: 0,0:11:59.46,0:12:04.48,Main,Den-Den Mushi,0,0,0,,Tam da Crocodile'ın yerine birini bulmuşken.
Dialogue: 0,0:12:04.48,0:12:07.91,Main,Den-Den Mushi,0,0,0,,Bir Shichibukai daha kaybetmek hiç iyi değil.
Dialogue: 0,0:12:09.21,0:12:11.81,Main,Den-Den Mushi,0,0,0,,Çok zayıf da olsa hala nefes alıyor mu?
Dialogue: 0,0:12:11.81,0:12:12.98,Main,Kuma,0,0,0,,Kim bilir.
Dialogue: 0,0:12:14.06,0:12:16.09,Main,Den-Den Mushi,0,0,0,,Hala hayatta olduğu sürece,...
Dialogue: 0,0:12:16.09,0:12:22.20,Main,Den-Den Mushi,0,0,0,,...iyileşmesini bekleyeceğiz ve Shichibukai\Npozisyonunda kalmasını umut edeceğiz.
Dialogue: 0,0:12:22.20,0:12:24.59,Main,Den-Den Mushi,0,0,0,,O zamanı sonra kapatırız.
Dialogue: 0,0:12:25.13,0:12:31.10,Main,Den-Den Mushi,0,0,0,,Onları bu kadar kolay kaybetseydik,\NShichibukailer'in saygınlığı kaybolurdu.
Dialogue: 0,0:12:31.54,0:12:35.08,Main,Den-Den Mushi,0,0,0,,Bu haberler başkasına ulaşmamalı.
Dialogue: 0,0:12:35.08,0:12:37.47,Main,Den-Den Mushi,0,0,0,,Bu insanlar büyük sorun.
Dialogue: 0,0:12:37.79,0:12:42.34,Main,Lola,0,0,0,,Evet. Moria'nınkinden aşağı kalmayan dev bedeniyle...
Dialogue: 0,0:12:42.34,0:12:45.34,Main,Lola,0,0,0,,..."Zalim" denilen korsan,...
Dialogue: 0,0:12:45.70,0:12:47.25,Main,Lola,0,0,0,,...Bartholomew Kuma!
Dialogue: 0,0:12:47.46,0:12:50.01,Main,Pirate,0,0,0,,O mu?! "Zalim" Kuma?'
Dialogue: 0,0:12:50.39,0:12:53.22,Main,Den-Den Mushi,0,0,0,,Ne dediğimi anlıyor musun?
Dialogue: 0,0:12:55.44,0:12:59.02,Main,Den-Den Mushi,0,0,0,,Başka kimsenin Moria'nın yenilgisini bilmesine izin veremeyiz.
Dialogue: 0,0:12:59.29,0:13:02.25,Main,Den-Den Mushi,0,0,0,,Bu, Dünya Hükümeti'nin doğrudan emridir.
Dialogue: 0,0:13:02.25,0:13:06.85,Main,Den-Den Mushi,0,0,0,,Hasır Şapka tayfası da dahil, adadaki herkesi...
Dialogue: 0,0:13:06.85,0:13:08.40,Main,Den-Den Mushi,0,0,0,,...YOK ET!
Dialogue: 0,0:13:09.20,0:13:11.07,Main,Kuma,0,0,0,,Çok kolay.
Dialogue: 0,0:13:12.16,0:13:13.54,Main,Pirate,0,0,0,,O ne dedi öyle?
Dialogue: 0,0:13:14.46,0:13:16.37,Main,Pirate,0,0,0,,Y-Yok etmek mi?!
Dialogue: 0,0:13:24.20,0:13:26.32,Main,Pirate,0,0,0,,Hey, hey! Yok etmek derken...
Dialogue: 0,0:13:26.32,0:13:28.20,Main,Pirate,0,0,0,,...bizi mi kastediyor?!
Dialogue: 0,0:13:28.20,0:13:28.92,Main,Pirate,0,0,0,,Niye?!
Dialogue: 0,0:13:29.36,0:13:31.20,Main,Pirate,0,0,0,,Bu olamaz!
Dialogue: 0,0:13:31.20,0:13:34.39,Main,Pirate,0,0,0,,Moria'nın etkisinden yeni kurtulduk!
Dialogue: 0,0:13:42.47,0:13:44.26,Main,Usopp,0,0,0,,Olamaz!
Dialogue: 0,0:13:44.26,0:13:45.94,Main,Usopp,0,0,0,,Shichibukailer'le hiç bitmeyen bir dövüş!
Dialogue: 0,0:13:50.18,0:13:52.42,Main,Zoro,0,0,0,,Siz geri durun.
Dialogue: 0,0:13:52.42,0:13:53.88,Main,Zoro,0,0,0,,Ben hallederim!
Dialogue: 0,0:14:01.49,0:14:03.16,Main,Nami,0,0,0,,Dikkatli ol!
Dialogue: 0,0:14:03.16,0:14:05.30,Main,Nami,0,0,0,,Bir tür yeteneği var.
Dialogue: 0,0:14:05.30,0:14:09.55,Main,Nami,0,0,0,,Sadece elinin dokunuşuyla bir insanı yok ettiğini gördüm!
Dialogue: 0,0:14:10.43,0:14:13.06,Main,Usopp,0,0,0,,İnsanları yok edebiliyor mu?!
Dialogue: 0,0:14:13.06,0:14:15.67,Main,Chopper,0,0,0,,K-Korkunç!
Dialogue: 0,0:14:16.14,0:14:19.10,Main,Nami,0,0,0,,Bir anda yer değiştirebiliyor.
Dialogue: 0,0:14:24.18,0:14:27.11,Main,Nami,0,0,0,,O el tehlikeli.
Dialogue: 0,0:14:37.52,0:14:38.04,Main,Pirate,0,0,0,,Ne?!
Dialogue: 0,0:14:42.75,0:14:44.17,Main,Pirate,0,0,0,,Geldi!
Dialogue: 0,0:14:44.17,0:14:46.10,Main,Pirate,0,0,0,,Çok büyük!
Dialogue: 0,0:14:46.10,0:14:47.37,Main,Pirate,0,0,0,,Ne zaman...
Dialogue: 0,0:14:47.70,0:14:51.10,Main,Pirate,0,0,0,,Kahretsin! Tam da özgürlüğümüzü kazanmışken!
Dialogue: 0,0:14:51.10,0:14:53.37,Main,Pirate,0,0,0,,Şimdi ölür müyüm sanki?!
Dialogue: 0,0:14:53.37,0:14:57.74,Main,Pirate,0,0,0,,Evet! Artık bizimle kimsenin uğraşmasına izin vermeyeceğiz!
Dialogue: 0,0:14:58.29,0:15:00.22,Main,Pirate,0,0,0,,Haklayın onu, çocuklar!
Dialogue: 0,0:15:00.22,0:15:02.68,Main,Pirate,0,0,0,,Evet! Evet! Haklayın!
Dialogue: 0,0:15:02.68,0:15:04.21,Main,Lola,0,0,0,,Kesin şunu çocuklar!
Dialogue: 0,0:15:04.21,0:15:05.42,Main,Lola,0,0,0,,Rakip çok güçlü!
Dialogue: 0,0:15:16.63,0:15:20.93,Main,Pirate,0,0,0,,Dokunmadıklarının bile içinden bir şey geçmiş gibi!
Dialogue: 0,0:15:34.52,0:15:36.18,Main,Kuma,0,0,0,,Korsan Avcısı Zoro.
Dialogue: 0,0:15:37.13,0:15:40.25,Main,Kuma,0,0,0,,Seninle mi başlayayım?
Dialogue: 0,0:15:53.13,0:15:55.54,Main,Pirate,0,0,0,,Hey! Kendine gel!
Dialogue: 0,0:15:55.54,0:15:56.17,Main,Pirate,0,0,0,,İyi misin?!
Dialogue: 0,0:15:56.83,0:15:59.20,Main,Pirate,0,0,0,,O pislik ne yaptı?!
Dialogue: 0,0:15:59.20,0:16:01.45,Main,Pirate,0,0,0,,Ona dokunmadı bile, içlerinden bir şey geçip gitti!
Dialogue: 0,0:16:01.45,0:16:03.81,Main,Pirate,0,0,0,,O adamın yeteneği bu mu?
Dialogue: 0,0:16:04.18,0:16:06.32,Main,Lola,0,0,0,,Durum fazlasıyla kötü.
Dialogue: 0,0:16:06.32,0:16:10.61,Main,Lola,0,0,0,,Sayısız yıllardır, Moria'nın hükmü altındaki karanlık ormanda yaşıyorduk.
Dialogue: 0,0:16:11.07,0:16:18.02,Main,Lola,0,0,0,,Sevinmemize bile fırsat kalmadan bir Shichibukai\Ndaha ortaya çıkıyor ve bizi katletmek mi istiyor?!
Dialogue: 0,0:16:27.83,0:16:30.30,Main,Pirate,0,0,0,,Kahretsin, bu haince!
Dialogue: 0,0:16:30.30,0:16:35.57,Main,Pirate,0,0,0,,Demin Hasır Şapkalar'ın nasıl bir dövüşten geçtiğini bilmiyor musun?
Dialogue: 0,0:16:36.32,0:16:41.61,Main,Pirate,0,0,0,,Tuhaflıkları boşverin! Yaralanmadan kalanlar biz olduğumuz için, seninle biz uğraşacağız!
Dialogue: 0,0:16:42.12,0:16:46.98,Main,Pirate,0,0,0,,Shichibukai veya her neyse! Oz ve Moria'yla\Nkarşılaştırıldığında o kadar büyük değilsin!
Dialogue: 0,0:16:47.29,0:16:49.27,Main,Zoro,0,0,0,,Geride durun.
Dialogue: 0,0:16:50.71,0:16:54.09,Main,Zoro,0,0,0,,İstediği benim. Duymadınız mı?
Dialogue: 0,0:16:55.10,0:16:57.38,Main,Zoro,0,0,0,,İstediği dövüşse,...
Dialogue: 0,0:16:57.38,0:16:59.32,Main,Zoro,0,0,0,,...o zaman geri durmayacağım.
Dialogue: 0,0:16:59.32,0:17:01.10,Main,Zoro,0,0,0,,Bu onursuzluk olurdu!
Dialogue: 0,0:17:23.48,0:17:27.09,Main,Kuma,0,0,0,,Epey ünlüsünüz.
Dialogue: 0,0:17:29.25,0:17:36.03,Main,Kuma,0,0,0,,Hasır Şapka tayfasının gemisinde\Nepey yetenekli kimseler var gibi.
Dialogue: 0,0:17:41.18,0:17:43.41,Main,Lola,0,0,0,,Hepinizi kastetmedi!
Dialogue: 0,0:17:44.04,0:17:47.44,Main,Kuma,0,0,0,,Hepiniz epey soruna neden oldunuz.
Dialogue: 0,0:17:47.44,0:17:52.38,Main,Kuma,0,0,0,,Şöhretinizden sadece kaptanınız sorumlu değilmiş gibi görünüyor.
Dialogue: 0,0:17:52.63,0:17:53.68,Main,Usopp,0,0,0,,Hey, Zoro, dur!
Dialogue: 0,0:17:53.68,0:17:56.02,Main,Usopp,0,0,0,,O kadar dikkatsizlik etme!
Dialogue: 0,0:17:56.02,0:17:58.32,Main,Usopp,0,0,0,,Kemiklerin parçalanacak gibi değil mi?!
Dialogue: 0,0:17:59.42,0:18:04.89,Main,Zoro,0,0,0,,Dünya seni itip kaktığında, ayağa kalkmalı ve sen de itmelisin.
Dialogue: 0,0:18:04.89,0:18:08.30,Main,Zoro,0,0,0,,Sadece mazeretler uydurarak bir şey yapamazsın.
Dialogue: 0,0:18:10.23,0:18:14.57,Main,Zoro,0,0,0,,Ölürsem, sadece buraya kadar dayanabilecek bir adamım demektir.
Dialogue: 0,0:18:15.34,0:18:16.79,Main,Zoro,0,0,0,,{\fad(250,250)}Çift Kılıç Stili...
Dialogue: 0,0:18:18.14,0:18:19.20,Main,Zoro,0,0,0,,{\fad(250,250)}...Kes ve Kınına Sok!
Dialogue: 0,0:18:20.18,0:18:21.53,Main,Zoro,0,0,0,,{\fad(250,250)}Sonsuz Yaşam Kapısı!
Dialogue: 0,0:18:34.61,0:18:35.56,Main,Zoro,0,0,0,,Bu da ne?!
Dialogue: 0,0:18:56.85,0:19:00.64,Main,Usopp,0,0,0,,Bakın! Hiçbir şey yapmadı ama şimdiden nefesi kesildi!
Dialogue: 0,0:19:00.64,0:19:03.41,Main,Nami,0,0,0,,Bu adamın yeteneği ne böyle?!
Dialogue: 0,0:19:03.41,0:19:05.31,Main,Nami,0,0,0,,Molozlar üzerinde bıraktığı o işaret de ne?!
Dialogue: 0,0:19:08.76,0:19:11.32,Main,Pirate,0,0,0,,Bakın! Avcunda!
Dialogue: 0,0:19:11.32,0:19:14.02,Main,Pirate,0,0,0,,P-Pati kabartıları?!
Dialogue: 0,0:19:14.02,0:19:16.37,Main,Pirate,0,0,0,,Niye bir insanın elindeler?
Dialogue: 0,0:19:17.36,0:19:20.28,Main,Zoro,0,0,0,,{\fad(250,250)}36 Poundluk Top!
Dialogue: 0,0:19:23.02,0:19:23.66,Main,Pirate,0,0,0,,Dikkat edin!
Dialogue: 0,0:19:25.74,0:19:28.41,Main,Chopper,0,0,0,,Zoro'nun saldırısının yönünü eliyle değiştirdi!
Dialogue: 0,0:19:28.41,0:19:30.05,Main,Chopper,0,0,0,,Bu mümkün mü ki?!
Dialogue: 0,0:19:32.64,0:19:34.99,Main,Zoro,0,0,0,,Demek yeteneğin bu, ha?
Dialogue: 0,0:19:35.45,0:19:38.56,Main,Kuma,0,0,0,,Her şeyin yönünü değiştirme gücü.
Dialogue: 0,0:19:39.32,0:19:43.56,Main,Kuma,0,0,0,,Nikyu Nikyu meyvesi yedim. Ben, pati adamım.
Dialogue: 0,0:19:43.56,0:19:46.73,Main,Sanji,0,0,0,,P-Pati adam?!
Dialogue: 0,0:19:46.73,0:19:49.04,Main,Usopp,0,0,0,,O nezaket de ne?!
Dialogue: 0,0:19:49.04,0:19:51.44,Main,Usopp,0,0,0,,Sakinleştiri Şeytan Meyvesi gibi bir şey falan mı var?!
Dialogue: 0,0:19:54.27,0:19:57.77,Main,Franky,0,0,0,,Shichibukai misin, yoksa Weeniebukai misin bilmiyorum.
Dialogue: 0,0:19:57.77,0:20:00.63,Main,Franky,0,0,0,,Belki de o kadar sert değildir.
Dialogue: 0,0:20:11.92,0:20:13.56,Main,Chopper,0,0,0,,Franky!
Dialogue: 0,0:20:13.90,0:20:15.19,Main,Chopper,0,0,0,,Franky!
Dialogue: 0,0:20:15.65,0:20:17.66,Main,Kuma,0,0,0,,Sayborg Franky.
Dialogue: 0,0:20:18.58,0:20:21.40,Main,Kuma,0,0,0,,Tüm gücün bu mu?
Dialogue: 0,0:20:21.40,0:20:25.70,Main,Robin,0,0,0,,Belki havanın bile yönünü değiştirme olasılığı var.
Dialogue: 0,0:20:25.70,0:20:29.21,Main,Robin,0,0,0,,Normal bir top Franky'yi hiç etkilemezdi.
Dialogue: 0,0:20:29.70,0:20:32.14,Main,Kuma,0,0,0,,Buna Pati Topu diyorum.
Dialogue: 0,0:20:32.14,0:20:38.05,Main,Kuma,0,0,0,,Işık hızında havayı iterek, her şeyi delip\Ngeçebilecek bir şok dalgası yapıyorum.
Dialogue: 0,0:20:48.27,0:20:49.73,Main,Kuma,0,0,0,,Her şey bitti.
Dialogue: 0,0:20:52.99,0:20:54.84,Main,Kuma,0,0,0,,{\fad(250,250)}*Tsuppari Pati Topu!
Dialogue: 0,0:20:59.48,0:21:01.34,Main,Zoro,0,0,0,,{\fad(250,250)}*Tourou Nagashi!
Dialogue: 0,0:21:13.40,0:21:14.12,Main,Usopp,0,0,0,,Zoro!
Dialogue: 0,0:21:14.12,0:21:15.69,Main,Chopper,0,0,0,,O da geri itildi!
Dialogue: 0,0:21:21.54,0:21:23.13,Main,Zoro,0,0,0,,Lanet olası.
Dialogue: 0,0:21:28.10,0:21:29.18,Main,Pirate,0,0,0,,Faydasız!
Dialogue: 0,0:21:29.18,0:21:31.06,Main,Pirate,0,0,0,,Devam edemez!
Dialogue: 0,0:21:31.06,0:21:33.60,Main,Pirate,0,0,0,,Şu ana dek dövüşebilmesi bile bir mucize!
Dialogue: 0,0:21:33.60,0:21:37.89,Main,Pirate,0,0,0,,Zaten canavar Oz'dan ölümcül bir darbe almıştı!
Dialogue: 0,0:21:37.89,0:21:40.58,Main,Usopp,0,0,0,,Zoro! Arkanda! Kaç!
Dialogue: 0,0:21:43.48,0:21:45.20,Main,Both,0,0,0,,Zoro!
Dialogue: 0,0:21:45.97,0:21:47.30,Main,Sanji,0,0,0,,Buraya kadar!
Dialogue: 0,0:21:50.99,0:21:52.81,Note,Sanji,0,0,0,,{\fad(250,250)}Et Yumuşatıcı!
Dialogue: 0,0:21:50.99,0:21:52.81,Main,Sanji,0,0,0,,{\fad(250,250)}Concasse!
Dialogue: 0,0:21:54.83,0:21:56.59,Main,Chopper,0,0,0,,Sanji!
Dialogue: 0,0:21:56.59,0:21:58.90,Main,Usopp,0,0,0,,Bunu patileriyle çeviremedi!
Dialogue: 0,0:21:58.90,0:22:02.03,Main,Usopp,0,0,0,,O herifin kafatası ezilecek!
Dialogue: 0,0:22:04.27,0:22:05.90,Main,Zoro,0,0,0,,Pislik, karışma!
Dialogue: 0,0:22:20.68,0:22:24.79,Main,Kuma,0,0,0,,Kara Bacak Sanji olmalısın.
Dialogue: 0,0:22:25.42,0:22:28.49,Main,Usopp,0,0,0,,Sanji'nin tekmesi ona etki bile etmedi.
Dialogue: 0,0:22:28.49,0:22:29.59,Main,Usopp,0,0,0,,Ne bu böyle?!
Dialogue: 0,0:22:30.37,0:22:33.47,Main,Sanji,0,0,0,,Niye bu kadar sert?!
Dialogue: 0,0:22:33.47,0:22:35.57,Main,Sanji,0,0,0,,Suratı çelikten mi yapılmış?
Dialogue: 0,0:22:40.33,0:22:43.03,Main,Usopp,0,0,0,,{\fad(250,250)}Ateşkuşu Yıldızı!
Dialogue: 0,0:22:44.64,0:22:46.31,Main,Kuma,0,0,0,,Keskin Nişancılar Kralı?
Dialogue: 0,0:22:46.82,0:22:48.55,Main,Kuma,0,0,0,,Ne tuhaf bir isim.
Dialogue: 0,0:22:59.79,0:23:07.20,Main,Kuma,0,0,0,,Düşündüğüm gibi yaralı halinizle hepinizden kurtulmak hiç adil değil.
Dialogue: 0,0:23:08.08,0:23:12.28,Main,Kuma,0,0,0,,Hükümet sizi tamamiyle yok etmemi emretti ama...
Dialogue: 0,0:23:18.40,0:23:20.77,Main,Franky,0,0,0,,O da ne öyle?
Dialogue: 0,0:23:20.77,0:23:22.36,Main,Nami,0,0,0,,Hava?
Dialogue: 0,0:23:22.36,0:23:25.52,Main,Nami,0,0,0,,Patileriyle dev bir hava baloncuğu mu yapıyor?
Dialogue: 0,0:23:25.52,0:23:27.79,Main,Chopper,0,0,0,,Gittikçe küçülüyor.
Dialogue: 0,0:23:28.74,0:23:36.21,Main,Nami,0,0,0,,Dev bir hava topu yapmak için geri tepki yeteneğini kullanıyor. Ama onu çok sıkıştırıyor!
Dialogue: 0,0:23:37.44,0:23:41.63,Main,Robin,0,0,0,,Tüm hava basıncı aniden genişleseydi,...
Dialogue: 0,0:23:41.63,0:23:44.62,Main,Robin,0,0,0,,...devasa bir şok dalgası oluştururdu.
Dialogue: 0,0:23:44.62,0:23:45.80,Main,Robin,0,0,0,,Bir bombaya dönüşürdü!
Dialogue: 0,0:23:45.80,0:23:48.04,Main,Chopper,0,0,0,,N-Ne dedin?
Dialogue: 0,0:23:52.88,0:23:54.96,Main,Usopp,0,0,0,,Bomba?!
Dialogue: 0,0:23:54.96,0:23:57.25,Main,Usopp,0,0,0,,Bomba yaptığını mı söylüyorsun?!
Dialogue: 0,0:24:07.87,0:24:12.23,Main,Kuma,0,0,0,,Canınızı bağışlayacağım.
Dialogue: 0,0:24:13.83,0:24:15.17,Main,Kuma,0,0,0,,Buna karşılık,...
Dialogue: 0,0:24:15.84,0:24:20.84,Main,Kuma,0,0,0,,...bana Hasır Şapkalı Luffy'nin başını vereceksiniz.
Dialogue: 0,0:24:21.50,0:24:27.04,Main,Kuma,0,0,0,,Onun başıyla dönersem, hükümet şikayetçi olmayacak.
Dialogue: 0,0:24:28.36,0:24:30.75,Main,Usopp,0,0,0,,Arkadaşımıza ihanet etmemizi mi istiyorsun?
Dialogue: 0,0:24:32.28,0:24:36.60,Main,Kuma,0,0,0,,Şimdi, Hasır Şapka'yı bana getirin.
Dialogue: 0,0:24:37.30,0:24:43.53,Main,All,0,0,0,,{\fad(0,5000)}OLMAZ!
Dialogue: 0,0:24:48.25,0:24:49.83,Main,Kuma,0,0,0,,Çok yazık.
Dialogue: 0,0:24:58.48,0:25:00.29,Main,Kuma,0,0,0,,{\fad(250,250)}Ayı Şoku!
Dialogue: 0,0:26:05.91,0:26:07.58,Main,Zoro,0,0,0,,{\fad(250,250)}Aslan Şarkısı!
Dialogue: 0,0:26:16.67,0:26:19.10,Main,Zoro,0,0,0,,Pislik, nesin sen?
Dialogue: 0,0:26:20.93,0:26:23.34,Main,Zoro,0,0,0,,Aynı Franky gibi Sayborg musun?!
Dialogue: 0,0:26:24.95,0:26:27.53,Main,Zoro,0,0,0,,Hayır, normal çelikten çok daha sertsin.
Dialogue: 0,0:26:54.71,0:26:57.86,Main,Zoro,0,0,0,,Çelik eridi!
Dialogue: 0,0:27:02.64,0:27:04.98,Main,Kuma,0,0,0,,Sayborg...
Dialogue: 0,0:27:04.98,0:27:06.67,Main,Kuma,0,0,0,,Kesinlikle öyleyim ama...
Dialogue: 0,0:27:08.14,0:27:11.61,Main,Kuma,0,0,0,,...Sayborg Franky'den çok farklıyım.
Dialogue: 0,0:27:13.68,0:27:17.04,Main,Kuma,0,0,0,,Ben, Pacifista dedikleriyim.
Dialogue: 0,0:27:17.04,0:27:20.45,Main,Kuma,0,0,0,,Dünya Hükümeti'nin henüz tamamlanmamış insan silahlar projesi.
Dialogue: 0,0:27:21.75,0:27:23.79,Main,Zoro,0,0,0,,Pacifista?
Dialogue: 0,0:27:21.75,0:27:23.79,Note,,0,0,0,,[Barışsever]
Dialogue: 0,0:27:23.79,0:27:29.19,Main,Kuma,0,0,0,,Dünyadaki en yüksek zekaya sahip,\NHükümet'in dahi bilim adamı...
Dialogue: 0,0:27:29.19,0:27:32.51,Main,Kuma,0,0,0,,...Dr. Vegapunk tarafından yapıldı.
Dialogue: 0,0:27:32.51,0:27:40.27,Main,Kuma,0,0,0,,Bilimsel bilgisinin insanlığın ulaşması için 500 yıl geçmesi gereken seviyeye çoktan ulaştığını söylüyorlar.
Dialogue: 0,0:27:41.02,0:27:48.41,Main,Zoro,0,0,0,,Şu anki halinle bir de yetenek kullanıcısısın. Umudumuz çoktan kaybolmuş gibi.
Dialogue: 0,0:27:49.99,0:27:55.92,Main,Zoro,0,0,0,,Doğal olarak bedenim artık tepki vermiyor.
Dialogue: 0,0:27:56.93,0:28:01.79,Main,Zoro,0,0,0,,Niye Luffy'nin başını almak zorundasın?!
Dialogue: 0,0:28:02.54,0:28:05.00,Main,Kuma,0,0,0,,Olabildiğince uzlaşmaya çalışıyorum.
Dialogue: 0,0:28:06.87,0:28:09.87,Main,Zoro,0,0,0,,Tamam, bir baş almana izin vereceğim!
Dialogue: 0,0:28:11.30,0:28:14.81,Main,Zoro,0,0,0,,Ancak buna karşılık,...
Dialogue: 0,0:28:14.81,0:28:18.98,Main,Zoro,0,0,0,,...lütfen benim canımı al! \NSenden bunu istiyorum!
Dialogue: 0,0:28:21.01,0:28:24.99,Main,Zoro,0,0,0,,Şu anda başımın pek bir değeri olmayabilir...
Dialogue: 0,0:28:24.99,0:28:29.74,Main,Zoro,0,0,0,,...ama bu, er geç dünyanın bir numaralı\Nkılıç ustası olacak kişinin kafası!
Dialogue: 0,0:28:29.74,0:28:32.66,Main,Zoro,0,0,0,,Kesinlikle yeterli olmalı!
Dialogue: 0,0:28:33.60,0:28:41.44,Main,Kuma,0,0,0,,Büyük hayaline rağmen o adamın yerini almak ve ölüme yaklaşmak mı istiyorsun?
Dialogue: 0,0:28:41.44,0:28:46.98,Main,Zoro,0,0,0,,Tayfayı kurtarmak için bundan başka bir yol görmüyorum.
Dialogue: 0,0:28:46.98,0:28:50.59,Main,Zoro,0,0,0,,Kaptanını bile koruyamıyorsan, amacının bir değeri yoktur!
Dialogue: 0,0:28:52.02,0:28:55.05,Main,Zoro,0,0,0,,Luffy, Korsanlar Kralı olacak kişi!
Dialogue: 0,0:28:56.58,0:28:58.96,Main,Sanji,0,0,0,,Dur bakalım, seni kahrolası pislik!
Dialogue: 0,0:29:01.07,0:29:04.02,Main,Sanji,0,0,0,,Ölürsen nasıl başarılı olabilirsin?
Dialogue: 0,0:29:05.29,0:29:08.66,Main,Sanji,0,0,0,,Amacın ne olacak, aptal?
Dialogue: 0,0:29:09.83,0:29:11.86,Main,Sanji,0,0,0,,Hey, koca adam!
Dialogue: 0,0:29:11.86,0:29:12.75,Main,Zoro,0,0,0,,Hey!
Dialogue: 0,0:29:13.35,0:29:15.49,Main,Sanji,0,0,0,,Bu yosun kafalı kılıç ustası yerine...
Dialogue: 0,0:29:15.49,0:29:16.78,Main,Sanji,0,0,0,,...benim canımı al!
Dialogue: 0,0:29:18.52,0:29:21.78,Main,Sanji,0,0,0,,Denizciler şu anda beni tehdit olarak görmüyor olabilir...
Dialogue: 0,0:29:21.78,0:29:26.26,Main,Sanji,0,0,0,,...ama yakında bu tayfadan en fazla sorun çıkartacak kişi...
Dialogue: 0,0:29:26.26,0:29:29.05,Main,Sanji,0,0,0,,...Kara Bacak Sanji olacak!
Dialogue: 0,0:29:37.91,0:29:40.66,Main,Sanji,0,0,0,,Hadi, yap şunu!
Dialogue: 0,0:29:45.03,0:29:48.49,Main,Sanji,0,0,0,,İkimiz de yapmamız gereken fedakârlıklara razı olduk!
Dialogue: 0,0:29:48.49,0:29:51.45,Main,Sanji,0,0,0,,Bırak bu ölüm çiçeği ilk ve son kez açsın!
Dialogue: 0,0:29:53.27,0:29:57.47,Main,Sanji,0,0,0,,Hey, herkese söyle.
Dialogue: 0,0:29:58.61,0:30:02.61,Main,Sanji,0,0,0,,Dikkatli olsunlar.
Dialogue: 0,0:30:03.10,0:30:08.50,Main,Sanji,0,0,0,,Üzgünüm ama kendinize başka bir\Naşçı bulmak zorunda gibisiniz!
Dialogue: 0,0:30:15.17,0:30:17.63,Main,Sanji,0,0,0,,P-Pislik!
Dialogue: 0,0:30:23.84,0:30:26.17,Main,Zoro,0,0,0,,Bu benim son arzum.
Dialogue: 0,0:30:43.34,0:30:47.96,Main,Kuma,0,0,0,,Bunun ardından Hasır Şapka'ya elimi\Nsürseydim, onurumu riske atmış olurdum.
Dialogue: 0,0:30:47.96,0:30:49.69,Main,Zoro,0,0,0,,Sana borçluyum.
Dialogue: 0,0:30:51.59,0:30:54.13,Main,Kuma,0,0,0,,Bana güvenebilirsin.
Dialogue: 0,0:30:54.13,0:30:55.82,Main,Kuma,0,0,0,,Sözümü tutacağım.
Dialogue: 0,0:30:58.71,0:31:01.44,Main,Kuma,0,0,0,,Ama kendini feda etmeni istemeden önce,...
Dialogue: 0,0:31:03.47,0:31:05.84,Main,Kuma,0,0,0,,...sana Cehennem deneyimi yaşatacağım.
Dialogue: 0,0:31:16.33,0:31:22.96,Main,Kuma,0,0,0,,Vücudundan çıkardığım şey, onun acısı, stresiydi.
Dialogue: 0,0:31:23.61,0:31:28.79,Main,Kuma,0,0,0,,Moria ve Oz'la yaptığı dövüş sırasında vücudunda biriken tüm zarar bu.
Dialogue: 0,0:31:28.79,0:31:34.87,Main,Kuma,0,0,0,,Onun yerini almak istiyorsan, doğal olarak tüm acısını da almalısın.
Dialogue: 0,0:31:35.74,0:31:40.09,Main,Kuma,0,0,0,,Ancak zaten ölümün eşiğinde olduğun için, bunun\Nhepsini alsaydın hayatta kalman imkansız olurdu.
Dialogue: 0,0:31:40.09,0:31:42.16,Main,Kuma,0,0,0,,Öleceksin.
Dialogue: 0,0:31:43.16,0:31:44.38,Main,Kuma,0,0,0,,Lütfen biraz dene.
Dialogue: 0,0:32:04.67,0:32:06.20,Main,Kuma,0,0,0,,Nasıldı?
Dialogue: 0,0:32:09.39,0:32:13.08,Main,Zoro,0,0,0,,Sadece yeri seçmeme izin ver.
Dialogue: 0,0:32:25.63,0:32:28.43,Main,Kuma,0,0,0,,Böylesine sadık arkadaşlar bulmuş.
Dialogue: 0,0:32:28.43,0:32:31.68,Main,Kuma,0,0,0,,Oğlundan da bu beklenir,...
Dialogue: 0,0:32:31.68,0:32:34.38,Main,Kuma,0,0,0,,...Dragon.
Dialogue: 0,0:32:36.89,0:32:40.85,Main,Pirate,0,0,0,,Hey, millet! Hayatta mısınız?!
Dialogue: 0,0:32:42.20,0:32:46.44,Main,Lola,0,0,0,,O saldırıda hepimizin öldüğünü düşünüp gitmiş olmalı!
Dialogue: 0,0:32:46.44,0:32:49.51,Main,Lola,0,0,0,,Gösterdik ona! Ayı adam!
Dialogue: 0,0:32:49.88,0:32:51.59,Main,Nami,0,0,0,,Acıyor.
Dialogue: 0,0:32:51.59,0:32:53.70,Main,Franky,0,0,0,,Hey, hey! Şaka yapıyorsun, değil mi?!
Dialogue: 0,0:32:53.70,0:32:55.75,Main,Franky,0,0,0,,Neyin var senin?!
Dialogue: 0,0:32:57.32,0:32:59.96,Main,Luffy,0,0,0,,Hey, bakın! Kendimi harika hissediyorum!
Dialogue: 0,0:32:59.96,0:33:00.69,Main,Luffy,0,0,0,,Ne oldu?!
Dialogue: 0,0:33:01.93,0:33:04.84,Main,Usopp,0,0,0,,Yalancı! Bu mümkün değil!
Dialogue: 0,0:33:04.84,0:33:07.83,Main,Robin,0,0,0,,Acıyı etkisiz hale getirip, onu yüceltecek kadar fazla mı zarar gördü?
Dialogue: 0,0:33:19.35,0:33:21.39,Main,Sanji,0,0,0,,Olamaz! Bu mümkün değil!
Dialogue: 0,0:33:21.39,0:33:23.54,Main,Sanji,0,0,0,,Bu pislik nereye gitti?!
Dialogue: 0,0:33:25.38,0:33:26.41,Main,Sanji,0,0,0,,Buldum!
Dialogue: 0,0:33:28.58,0:33:30.39,Main,Sanji,0,0,0,,Ne yaptığını sanıyorsun sen?
Dialogue: 0,0:33:30.39,0:33:33.46,Main,Sanji,0,0,0,,Hey, Shichibukai nereye git-?
Dialogue: 0,0:33:39.37,0:33:41.20,Main,Sanji,0,0,0,,Bu kan da ne böyle?!
Dialogue: 0,0:33:41.48,0:33:42.37,Main,Sanji,0,0,0,,Hey!
Dialogue: 0,0:33:42.37,0:33:43.89,Main,Sanji,0,0,0,,Hey, hala hayatta mısın?!
Dialogue: 0,0:33:43.89,0:33:45.86,Main,Sanji,0,0,0,,O adam nerede?
Dialogue: 0,0:33:45.86,0:33:48.34,Main,Sanji,0,0,0,,Burada ne oldu?!
Dialogue: 0,0:33:48.34,0:33:49.44,Main,Zoro,0,0,0,,H-...
Dialogue: 0,0:33:50.74,0:33:52.83,Main,Zoro,0,0,0,,...HİÇBİR ŞEY...
Dialogue: 0,0:33:52.83,0:33:54.83,Main,Zoro,0,0,0,,...OLMADI!
