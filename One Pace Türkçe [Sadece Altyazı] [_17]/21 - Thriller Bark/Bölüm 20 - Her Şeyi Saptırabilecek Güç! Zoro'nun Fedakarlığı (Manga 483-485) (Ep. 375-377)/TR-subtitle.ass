Dialogue: 0,0:00:12.64,0:00:17.88,Lyrics,,0,0,0,,{\i1}Tüm umutlarımızı, hayallerimizi topluyoruz...{\i0}
Dialogue: 0,0:00:18.21,0:00:25.39,Lyrics,,0,0,0,,{\i1}...ve kalbimizin dilediğince yola çıkıyoruz... One Piece!{\i0}
Dialogue: 0,0:00:27.49,0:00:32.69,Lyrics,,0,0,0,,{\i1}Pusula gibi şeyler bizi sadece yavaşlatır.{\i0}
Dialogue: 0,0:00:32.98,0:00:38.57,Lyrics,,0,0,0,,{\i1}Yine de yola çıkmanın heyecanıyla dümeni alıyorum.{\i0}
Dialogue: 0,0:00:38.83,0:00:43.74,Lyrics,,0,0,0,,{\i1}Bu tozlu hazine haritasındakini kanıtlayabilirsek,...{\i0}
Dialogue: 0,0:00:44.07,0:00:48.87,Lyrics,,0,0,0,,{\i1}...artık efsane olmaktan çıkacak!{\i0}
Dialogue: 0,0:00:50.81,0:00:56.42,Lyrics,,0,0,0,,{\i1}Hayatında fırtınalar olursa,...{\i0}
Dialogue: 0,0:00:56.49,0:01:01.59,Lyrics,,0,0,0,,{\i1}...başkalarıyla olan bağlarına güvenebilirsin.{\i0}
Dialogue: 0,0:01:01.69,0:01:04.26,Lyrics,,0,0,0,,{\i1}Böyle düşünmek yanlış değil!{\i0}
Dialogue: 0,0:01:05.76,0:01:10.39,Lyrics,,0,0,0,,{\i1}Tüm umutlarımızı, hayallerimizi topluyoruz...{\i0}
Dialogue: 0,0:01:11.02,0:01:16.69,Lyrics,,0,0,0,,{\i1}...ve kalbimizin dilediğince yola çıkıyoruz!{\i0}
Dialogue: 0,0:01:16.77,0:01:19.94,Lyrics,,0,0,0,,{\i1}Cebimde bir metelik var, bu yüzden mi...{\i0}
Dialogue: 0,0:01:19.96,0:01:22.80,Lyrics,,0,0,0,,{\i1}...arkadaşım olmak istiyorsun?{\i0}
Dialogue: 0,0:01:22.82,0:01:27.85,Lyrics,,0,0,0,,{\i1}Biz, biz dalgalar üstündeyiz!{\i0}
Dialogue: 0,0:01:28.18,0:01:31.05,Lyrics,,0,0,0,,{\i1}Hepimiz!{\i0}
Dialogue: 0,0:01:34.12,0:01:39.63,Lyrics,,0,0,0,,{\i1}Geceye tam istimle saldıralım!{\i0}
Dialogue: 0,0:01:39.79,0:01:45.17,Lyrics,,0,0,0,,{\i1}Zaten hazinenin bir önemi yok!{\i0}
Dialogue: 0,0:01:45.43,0:01:48.64,Lyrics,,0,0,0,,{\i1}Cebimde bir hayal var, bu yüzden mi...{\i0}
Dialogue: 0,0:01:48.66,0:01:51.25,Lyrics,,0,0,0,,{\i1}...arkadaşım olmak istiyorsun?{\i0}
