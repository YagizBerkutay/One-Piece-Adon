Dialogue: 0,0:02:29.90,0:02:38.57,Title,,0,0,0,,{\fad(2000,2000)}Gizemli Deniz ve İskelet Brook
Dialogue: 0,0:02:39.32,0:02:41.92,Captions,,0,0,220,,{\fad(250,250)}Luffy ve Tayfası\Nyeni korsan gemileri...
Dialogue: 0,0:02:41.99,0:02:43.88,Captions,,0,0,220,,{\fad(250,0)}...Thousand Sunny \Nile denizde ilerliyorlar.
Dialogue: 0,0:02:48.52,0:02:50.97,Main,Nami,0,0,0,,Burası cennet, cennet.
Dialogue: 0,0:02:50.97,0:02:54.25,Main,Nami,0,0,0,,Dalgalar tarafından sarsılırken güzel bir banyo yapmak...
Dialogue: 0,0:02:54.25,0:02:56.10,Main,Nami,0,0,0,,...en iyisi.
Dialogue: 0,0:02:57.71,0:02:59.57,Main,Chopper,0,0,0,,{\an8}Burası benim odam.
Dialogue: 0,0:02:57.73,0:03:00.39,Captions,,0,0,220,,{\fad(140,0)}REVİR
Dialogue: 0,0:03:01.31,0:03:02.31,Main,Luffy,0,0,0,,Yakaladım!
Dialogue: 0,0:03:02.31,0:03:04.66,Main,Luffy,0,0,0,,Süper bir köpekbalığı yakaladık!
Dialogue: 0,0:03:04.66,0:03:06.16,Main,Usopp,0,0,0,,İçine koy! İçine koy!
Dialogue: 0,0:03:06.16,0:03:08.00,Main,Luffy,0,0,0,,Balık deposuna koy!
Dialogue: 0,0:03:08.00,0:03:09.36,Main,Usopp,0,0,0,,Koy içine!
Dialogue: 0,0:03:09.36,0:03:10.52,Main,Luffy,0,0,0,,Gir bakalım!
Dialogue: 0,0:03:16.02,0:03:17.48,Main,Robin,0,0,0,,Bir tane daha geldi.
Dialogue: 0,0:03:17.48,0:03:18.28,Main,Robin,0,0,0,,Bir köpekbalığı.
Dialogue: 0,0:03:18.55,0:03:20.38,Main,Franky,0,0,0,,Evet, bu oda mükemmel değil mi?
Dialogue: 0,0:03:20.99,0:03:24.05,Main,Sanji,0,0,0,,Oda güzel ama köpekbalığı?!\NAptallar!
Dialogue: 0,0:03:24.46,0:03:26.01,Main,Usopp,0,0,0,,Evet, gidip bakalım!
Dialogue: 0,0:03:26.01,0:03:27.59,Main,Luffy,0,0,0,,Akvaryuma bakalım!
Dialogue: 0,0:03:27.59,0:03:30.50,Main,Luffy,0,0,0,,Hey! Köpekbalığı içeri girdi mi?
Dialogue: 0,0:03:30.50,0:03:32.39,Main,Luffy,0,0,0,,Koca boynuzlu olan!
Dialogue: 0,0:03:33.07,0:03:34.97,Main,Robin,0,0,0,,Evet, girdi ama...
Dialogue: 0,0:03:34.97,0:03:38.24,Main,Robin,0,0,0,,...şu ana dek yakaladığınız tüm balıklar gitti.
Dialogue: 0,0:03:39.97,0:03:43.40,Main,Sanji,0,0,0,,Ortak yaşamı biraz düşünürseniz \Nbunun olacağı belliydi!
Dialogue: 0,0:03:43.44,0:03:47.59,Captions,,0,0,220,,{\fad(150,350)}Gemi güzel bir şekilde yol alıyor.
Dialogue: 0,0:03:43.74,0:03:44.91,Main,Luffy,0,0,0,,{\an8}Lanet olsun!
Dialogue: 0,0:03:44.91,0:03:47.01,Main,Luffy,0,0,0,,{\an8}Bu pisliği akşam yemeği yap!
Dialogue: 0,0:03:47.01,0:03:50.08,Main,Luffy,0,0,0,,{\an8}Sanji! Bu aptal köpekbalığından barbekü yap!
Dialogue: 0,0:03:50.08,0:03:51.24,Main,Sanji,0,0,0,,{\an8}Dur, seni acemi!
Dialogue: 0,0:03:51.88,0:03:54.05,Main,Sanji,0,0,0,,Bu taze balık.
Dialogue: 0,0:03:54.05,0:03:57.66,Main,Sanji,0,0,0,,Belki biraz sushi. Biraz baharatlı\Nsirke misosu ekleyerek kaynatmak...
Dialogue: 0,0:03:57.66,0:03:59.12,Main,Sanji,0,0,0,,*Tempura da iyi olabilir.
Dialogue: 0,0:04:00.49,0:04:02.10,Main,Luffy,0,0,0,,Acıkıyorum!
Dialogue: 0,0:04:04.61,0:04:07.29,Main,Nami,0,0,0,,Harika bir banyoydu.
Dialogue: 0,0:04:08.79,0:04:11.60,Main,Zoro,0,0,0,,Hey! Suda yüzen bir şey var!
Dialogue: 0,0:04:11.87,0:04:13.62,Main,Luffy,0,0,0,,Nedir o?
Dialogue: 0,0:04:14.64,0:04:15.77,Main,Chopper,0,0,0,,Fıçı?!
Dialogue: 0,0:04:16.89,0:04:18.76,Main,Usopp,0,0,0,,Bak, üstünde hazine yazıyor!
Dialogue: 0,0:04:20.11,0:04:24.12,Captions,Sign,0,0,0,,{\pos(372,506)\frz305.5\org(362,462)}Deniz Kamisi'ne Hediye
Dialogue: 0,0:04:20.11,0:04:21.32,Main,Luffy,0,0,0,,Haklısın!
Dialogue: 0,0:04:21.32,0:04:22.01,Main,Luffy,0,0,0,,Yoksa...
Dialogue: 0,0:04:22.01,0:04:24.11,Main,Luffy,0,0,0,,...hazine gemisinden düşen bir hazine mi?
Dialogue: 0,0:04:24.35,0:04:25.42,Main,Usopp & Chopper,0,0,0,,Hazine?!
Dialogue: 0,0:04:27.19,0:04:33.13,Main,All,0,0,0,,{\i1}Hazine, hazine, bir hazine keşfettik!{\i0}
Dialogue: 0,0:04:33.13,0:04:34.67,Main,Nami,0,0,0,,Üzgünüm...
Dialogue: 0,0:04:35.06,0:04:37.19,Main,Nami,0,0,0,,...ama sadece alkol ve biraz yiyecek.
Dialogue: 0,0:04:37.50,0:04:39.69,Main,Luffy,0,0,0,,Bakmadan nasıl biliyorsun?!
Dialogue: 0,0:04:40.50,0:04:43.19,Main,Nami,0,0,0,,"Deniz Tanrısı'na Hediye" yazısını görmediniz mi?
Dialogue: 0,0:04:43.80,0:04:47.84,Main,Nami,0,0,0,,İnsanlar yolculuğa çıkarken, güvenli bir yolculuk geçirebilmek için...
Dialogue: 0,0:04:47.84,0:04:51.10,Main,Nami,0,0,0,,...dua etmek amacıyla o fıçıları denize bırakır.
Dialogue: 0,0:04:51.10,0:04:53.68,Main,Nami,0,0,0,,"Hediye" kısmı "Kami-sama için" anlamına gelir.
Dialogue: 0,0:04:53.68,0:04:57.38,Main,Usopp,0,0,0,,Ne, yani fıçıyı boşuna mı aldık?
Dialogue: 0,0:04:57.98,0:05:00.09,Main,Zoro,0,0,0,,İçinde içecek var.
Dialogue: 0,0:05:00.09,0:05:00.81,Main,Zoro,0,0,0,,Biraz içelim.
Dialogue: 0,0:05:00.81,0:05:03.05,Main,Usopp,0,0,0,,Aptal, çarpılmak mı istiyorsun?!
Dialogue: 0,0:05:03.49,0:05:05.52,Main,Nami,0,0,0,,Dua edersek, onu içmemiz sorun olmaz.
Dialogue: 0,0:05:05.90,0:05:07.82,Main,Zoro,0,0,0,,Ben Kami'ye dua etmem.
Dialogue: 0,0:05:07.82,0:05:12.86,Main,Nami,0,0,0,,Dalgalar tarafından savrulup\Nduran alkol, özellikle leziz olmalı.
Dialogue: 0,0:05:13.65,0:05:15.46,Main,Franky,0,0,0,,O zaman denemeliyiz!
Dialogue: 0,0:05:15.94,0:05:18.16,Main,Franky,0,0,0,,Yapalım! Kadeh kaldıralım!
Dialogue: 0,0:05:18.51,0:05:23.67,Main,Robin,0,0,0,,Bitirdikten sonra fıçıyı yeniden\Ndoldurup denize bırakmamız gerekiyor.
Dialogue: 0,0:05:24.64,0:05:25.88,Main,Franky,0,0,0,,Açın!
Dialogue: 0,0:05:25.88,0:05:26.81,Main,Franky,0,0,0,,Hadi!
Dialogue: 0,0:05:26.81,0:05:30.28,Main,Luffy,0,0,0,,Hey, Kami-sama! Bundan biraz içeceğiz!
Dialogue: 0,0:05:32.05,0:05:33.85,Main,Zoro,0,0,0,,Ne "Kami-sama" sı?!
Dialogue: 0,0:05:33.85,0:05:38.25,Main,Zoro,0,0,0,,Gökyüzü Adası'nda Kami'nin\Ncanına okuyan sen değil miydin?
Dialogue: 0,0:05:38.69,0:05:40.16,Main,Luffy,0,0,0,,Evet! Açıldı!
Dialogue: 0,0:05:41.43,0:05:42.50,Main,Usopp,0,0,0,,Uçarak bir şey çıktı?!
Dialogue: 0,0:05:47.09,0:05:48.26,Main,Luffy,0,0,0,,Ne?
Dialogue: 0,0:05:49.57,0:05:51.23,Main,Usopp,0,0,0,,Kırmızı bir ışık?
Dialogue: 0,0:05:52.60,0:05:53.74,Main,Nami,0,0,0,,Ne?
Dialogue: 0,0:05:53.74,0:05:54.83,Main,Nami,0,0,0,,Ne oldu?
Dialogue: 0,0:05:56.24,0:05:59.87,Main,Chopper,0,0,0,,İçki havaya uçtu, yandı ve yok oldu!
Dialogue: 0,0:06:00.25,0:06:01.75,Main,Robin,0,0,0,,Bir parıltıydı.
Dialogue: 0,0:06:01.75,0:06:02.77,Main,Nami,0,0,0,,Parıltı?
Dialogue: 0,0:06:04.35,0:06:06.64,Main,Zoro,0,0,0,,Belki de şu Deniz Kamisi'nin bir lanetiydi!
Dialogue: 0,0:06:07.16,0:06:10.19,Main,Robin,0,0,0,,Sadece bir oyunsa mesele yok.
Dialogue: 0,0:06:10.19,0:06:11.71,Main,Robin,0,0,0,,Ancak...
Dialogue: 0,0:06:11.71,0:06:15.78,Main,Robin,0,0,0,,Şu anda bu geminin biri tarafından\Nhedef alınmış olması muhtemel.
Dialogue: 0,0:06:15.78,0:06:17.82,Main,Usopp,0,0,0,,Yani...
Dialogue: 0,0:06:17.82,0:06:20.15,Main,Usopp,0,0,0,,...bir tür tuzak mıydı?!
Dialogue: 0,0:06:20.15,0:06:25.10,Main,Usopp,0,0,0,,Fıçıyı açarak, birine burada olduğumuzu mu söyledik?!
Dialogue: 0,0:06:25.10,0:06:26.79,Main,Nami,0,0,0,,Gerçekten kimseyi göremiyoruz ama...
Dialogue: 0,0:06:27.39,0:06:28.49,Thoughts,Nami,0,0,0,,{\i1}...bu hava basıncı...{\i0}
Dialogue: 0,0:06:28.49,0:06:30.13,Thoughts,Nami,0,0,0,,{\i1}Bulut akıntıları gerçekten hızlı hareket ediyor.{\i0}
Dialogue: 0,0:06:31.23,0:06:33.77,Main,Chopper,0,0,0,,Kimseyi görmüyorum!
Dialogue: 0,0:06:34.37,0:06:35.74,Main,Usopp,0,0,0,,Burada da yok!
Dialogue: 0,0:06:35.74,0:06:37.20,Main,Nami,0,0,0,,Herkes yerini alsın!
Dialogue: 0,0:06:37.20,0:06:38.98,Main,Nami,0,0,0,,Güney - güneydoğuya gidiyoruz!
Dialogue: 0,0:06:38.98,0:06:41.41,Main,Nami,0,0,0,,Büyük bir fırtına yaklaşıyor, beş dakikamız var!
Dialogue: 0,0:06:41.41,0:06:42.77,Main,Luffy,0,0,0,,Göremiyorum ama...
Dialogue: 0,0:06:42.77,0:06:46.14,Main,Luffy,0,0,0,,...öyle diyorsa doğru olmalı.
Dialogue: 0,0:06:46.14,0:06:47.72,Main,Luffy,0,0,0,,Nami, ne tarafa?!
Dialogue: 0,0:06:47.72,0:06:49.42,Main,Nami,0,0,0,,İki yönüne!
Dialogue: 0,0:06:58.06,0:06:59.11,Main,Nami,0,0,0,,Faydasız!
Dialogue: 0,0:06:59.11,0:07:00.71,Main,Nami,0,0,0,,Güçlü bir pruva rüzgârı var!
Dialogue: 0,0:07:00.71,0:07:02.12,Main,Nami,0,0,0,,Geri itiliyoruz!
Dialogue: 0,0:07:03.45,0:07:04.29,Main,Franky,0,0,0,,Hey!
Dialogue: 0,0:07:04.29,0:07:06.57,Main,Franky,0,0,0,,Bu geminin tüm yapabileceğinin bu olduğunu mu sanıyorsunuz?
Dialogue: 0,0:07:06.79,0:07:08.26,Main,Nami,0,0,0,,Tabii ya!
Dialogue: 0,0:07:08.26,0:07:10.42,Main,Nami,0,0,0,,Yelkenleri toplayın!
Dialogue: 0,0:07:10.42,0:07:11.96,Main,Nami,0,0,0,,Çarkları kullanacağız!
Dialogue: 0,0:07:13.03,0:07:14.31,Main,Usopp,0,0,0,,Onu mu?!
Dialogue: 0,0:07:15.40,0:07:17.58,Main,Luffy,0,0,0,,O şeyi seviyorum, çok süper!
Dialogue: 0,0:07:17.58,0:07:19.70,Main,Franky,0,0,0,,Askeri Havuz Sistemi!
Dialogue: 0,0:07:19.70,0:07:21.00,Main,Franky,0,0,0,,Kanal Sıfır!
Dialogue: 0,0:07:23.74,0:07:25.04,Main,Nami,0,0,0,,Kola Motoru!
Dialogue: 0,0:07:25.04,0:07:27.23,Main,Nami,0,0,0,,Çarklı Gemi Sunny Go!
Dialogue: 0,0:07:29.51,0:07:31.40,Main,Usopp,0,0,0,,Hadi!
Dialogue: 0,0:07:33.82,0:07:35.97,Main,Luffy,0,0,0,,İlerle!
Dialogue: 0,0:07:44.54,0:07:45.64,Main,Nami,0,0,0,,Başardık.
Dialogue: 0,0:07:45.64,0:07:47.85,Main,Zoro,0,0,0,,Başardık ama...
Dialogue: 0,0:07:47.85,0:07:49.85,Main,Zoro,0,0,0,,...burası neresi böyle?
Dialogue: 0,0:07:50.22,0:07:52.58,Main,Zoro,0,0,0,,Daha gece bile olmadı ve yine de...
Dialogue: 0,0:07:52.58,0:07:56.05,Main,Zoro,0,0,0,,Gece değil ama sis çok karanlık görünmesine neden oluyor.
Dialogue: 0,0:07:56.05,0:07:57.35,Main,Nami,0,0,0,,Yoksa...
Dialogue: 0,0:07:57.35,0:08:00.66,Main,Nami,0,0,0,,...okyanusun o bölümünde miyiz?
Dialogue: 0,0:08:00.66,0:08:02.59,Main,Nami,0,0,0,,Bunun için hazır değiliz!
Dialogue: 0,0:08:03.66,0:08:05.86,Main,Usopp,0,0,0,,Oh, Denizadamı Adası'na geldik mi?
Dialogue: 0,0:08:06.16,0:08:10.17,Main,Luffy,0,0,0,,Hayır, ondan önce hayalet deniz var!
Dialogue: 0,0:08:10.17,0:08:11.17,Main,Franky,0,0,0,,Evet.
Dialogue: 0,0:08:11.17,0:08:12.84,Main,Franky,0,0,0,,Tedbiri elden bırakmayın.
Dialogue: 0,0:08:12.84,0:08:17.56,Main,Franky,0,0,0,,Bu okyanus kesinlikle meşhur...
Dialogue: 0,0:08:17.56,0:08:20.18,Main,Franky,0,0,0,,...Florian Üçgeni.
Dialogue: 0,0:08:21.18,0:08:24.75,Main,Franky,0,0,0,,Her şeyin gizemli bir biçimde yok olduğu korkunç deniz!
Dialogue: 0,0:08:25.78,0:08:28.72,Main,Usopp,0,0,0,,Eh?! H-H-Hayaletler?!
Dialogue: 0,0:08:30.32,0:08:32.82,Main,Luffy,0,0,0,,Evet, bu okyanusta hayaletler var!
Dialogue: 0,0:08:33.06,0:08:34.46,Main,Usopp,0,0,0,,Yalan söylüyorsun!
Dialogue: 0,0:08:34.46,0:08:39.13,Main,Usopp,0,0,0,,Diğer herkes ne olduğunu biliyor, \Nben niye bilmiyorum?!
Dialogue: 0,0:08:41.46,0:08:43.39,Main,Luffy,0,0,0,,Kokoro nine anlattı.
Dialogue: 0,0:08:43.39,0:08:45.29,Main,Luffy,0,0,0,,Canlı iskeletler bile var!
Dialogue: 0,0:08:45.29,0:08:48.54,Main,Usopp,0,0,0,,C-Canlı iskeletler?!
Dialogue: 0,0:08:51.16,0:08:53.97,Main,Sanji,0,0,0,,Bu sadece senin hayal gücün.
Dialogue: 0,0:08:53.97,0:08:55.98,Main,Sanji,0,0,0,,Onu böyle korkutmayı kes.
Dialogue: 0,0:08:56.80,0:08:58.32,Main,Sanji,0,0,0,,Tamam, Usopp.
Dialogue: 0,0:08:58.57,0:09:04.91,Main,Sanji,0,0,0,,Her yıl bu okyanusta, \Nbir sürü gemi iz bırakmadan kaybolur.
Dialogue: 0,0:09:04.91,0:09:11.28,Main,Sanji,0,0,0,,Dolaşıp duran ölülerle dolu \Nhayalet gemilerin olduğunu söylüyorlar.
Dialogue: 0,0:09:12.46,0:09:13.17,Main,Usopp,0,0,0,,Olamaz!
Dialogue: 0,0:09:13.17,0:09:14.97,Main,Usopp,0,0,0,,Bana böyle şeyleri önceden söyleyin!
Dialogue: 0,0:09:14.97,0:09:17.62,Main,Sanji,0,0,0,,Bunun ne faydası olurdu?
Dialogue: 0,0:09:18.16,0:09:19.39,Main,Usopp,0,0,0,,Hazırlanırdım!
Dialogue: 0,0:09:19.39,0:09:21.63,Main,Usopp,0,0,0,,Bazı şeytan çıkarıcı şeyler lazım!
Dialogue: 0,0:09:21.63,0:09:25.31,Main,Chopper,0,0,0,,Usopp, bana da lazım!
Dialogue: 0,0:09:27.47,0:09:29.30,Main,Usopp,0,0,0,,Bu ses de ne?!
Dialogue: 0,0:09:35.98,0:09:38.68,Main,Usopp,0,0,0,,İşte!
Dialogue: 0,0:09:39.58,0:09:42.83,Main,All,0,0,0,,{\i1}HAYALET GEMİ!
Dialogue: 0,0:09:51.64,0:09:54.34,Main,Nami,0,0,0,,Bu şarkı ne böyle?
Dialogue: 0,0:09:54.34,0:09:56.46,Main,Usopp,0,0,0,,Kötü ruhun şarkısı!
Dialogue: 0,0:09:56.46,0:09:57.16,Main,Usopp,0,0,0,,Dinlemeyin!
Dialogue: 0,0:09:57.16,0:09:59.61,Main,Usopp,0,0,0,,Yoksa lanetlenirsiniz!
Dialogue: 0,0:10:00.93,0:10:04.12,Main,Usopp,0,0,0,,Hayalet sizinle konuşmaya çalışırsa, \Nsakın izin vermeyin!
Dialogue: 0,0:10:04.47,0:10:07.32,Main,Usopp,0,0,0,,Yoksa sizi denize sürükler!
Dialogue: 0,0:10:07.32,0:10:10.12,Main,Usopp,0,0,0,,Kötü ruhlar, her zaman insanları\Nkendilerine doğru getirmeye çalışır!
Dialogue: 0,0:10:15.99,0:10:19.73,Main,Robin,0,0,0,,Bu gemide biri mi var?
Dialogue: 0,0:10:21.99,0:10:24.04,Main,Zoro,0,0,0,,Düşmansa, canına okurum.
Dialogue: 0,0:10:24.83,0:10:26.56,Main,Sanji,0,0,0,,Orada bir şey var.
Dialogue: 0,0:10:26.56,0:10:30.07,Jungle P lyrics,Brook,0,0,0,,{\i1}♪ Tezgâha içkisini...
Dialogue: 0,0:10:32.04,0:10:35.25,Jungle P lyrics,Brook,0,0,0,,{\i1}...getirecek... ♪
Dialogue: 0,0:10:53.23,0:10:56.01,Main,Nami,0,0,0,,Niye biz gidiyoruz?!
Dialogue: 0,0:10:56.52,0:10:58.20,Main,Nami,0,0,0,,Geri dönüyorum!
Dialogue: 0,0:10:58.51,0:11:01.26,Main,Luffy,0,0,0,,Yalnız başıma idare ederim demiştim.
Dialogue: 0,0:11:01.26,0:11:02.46,Main,Sanji,0,0,0,,Olmaz!
Dialogue: 0,0:11:02.46,0:11:05.88,Main,Sanji,0,0,0,,Bunu yapmana izin verseydik, aptalca\Nbir şey yapardın ve hepimizi lanetletirdin!
Dialogue: 0,0:11:07.42,0:11:09.19,Main,Nami,0,0,0,,Berbat bir şansım var!
Dialogue: 0,0:11:11.22,0:11:13.86,Main,Sanji,0,0,0,,Nami-san, sorun yok!
Dialogue: 0,0:11:13.86,0:11:16.12,Main,Sanji,0,0,0,,Seni koruyacağım!
Dialogue: 0,0:11:16.12,0:11:20.05,Main,Luffy,0,0,0,,Nami, hazine gemisi istemiyor muydun?
Dialogue: 0,0:11:20.05,0:11:22.11,Main,Nami,0,0,0,,Bu hazine gemisi değil!
Dialogue: 0,0:11:22.11,0:11:23.28,Main,Nami,0,0,0,,Onu gördün, değil mi?!
Dialogue: 0,0:11:23.28,0:11:24.73,Main,Nami,0,0,0,,Hareket eden iskeleti!
Dialogue: 0,0:11:25.00,0:11:27.80,Main,Luffy,0,0,0,,Hazinenin bekçisi olmalı!
Dialogue: 0,0:11:27.80,0:11:29.75,Main,Luffy,0,0,0,,Gidip onu bulalım!
Dialogue: 0,0:11:52.44,0:11:54.51,Main,Usopp,0,0,0,,Kötü ruhlar uzak durun, kötü ruhlar uzak durun.
Dialogue: 0,0:11:54.51,0:11:56.29,Main,Usopp,0,0,0,,Luffy, huzur içinde yat!
Dialogue: 0,0:12:00.02,0:12:06.22,Captions,,0,0,220,,{\fad(600,600)}Centilmen İskelet\NBrook
Dialogue: 0,0:11:59.63,0:12:03.05,Main,Brook,0,0,0,,{\an8}Nasılsınız? Yohohoho!
Dialogue: 0,0:12:03.05,0:12:08.14,Main,Brook,0,0,0,,{\an8}Demin için özür dilerim, sizi doğru düzgün selamlayamadım!
Dialogue: 0,0:12:08.14,0:12:09.87,Main,Brook,0,0,0,,{\an8}Çok şaşırdım!
Dialogue: 0,0:12:09.87,0:12:13.66,Main,Brook,0,0,0,,{\an8}İnsan görmeyeli uzun yıllar oldu.
Dialogue: 0,0:12:13.66,0:12:16.66,Main,Brook,0,0,0,,{\an8}Tüm gördüğüm birbiri ardına hayalet gemiler.
Dialogue: 0,0:12:16.66,0:12:18.57,Main,Brook,0,0,0,,{\an8}Korkutucu!
Dialogue: 0,0:12:18.57,0:12:21.62,Main,Brook,0,0,0,,{\an8}Pekâlâ, kendinizi evinizde hissedin ve içeri buyrun.
Dialogue: 0,0:12:21.62,0:12:23.05,Main,Brook,0,0,0,,{\an8}Daha rahat konuşuruz.
Dialogue: 0,0:12:23.05,0:12:25.15,Main,Luffy,0,0,0,,Bakın, konuşuyor!
Dialogue: 0,0:12:25.15,0:12:27.71,Main,Luffy,0,0,0,,İskeletin afrosu var ve konuşuyor!
Dialogue: 0,0:12:27.71,0:12:29.06,Main,Sanji,0,0,0,,İnanılmaz!
Dialogue: 0,0:12:30.29,0:12:31.90,Main,Brook,0,0,0,,Oh!
Dialogue: 0,0:12:34.37,0:12:37.17,Main,Brook,0,0,0,,Leydim, görülmeye değer birisiniz!
Dialogue: 0,0:12:37.17,0:12:38.30,Main,Brook,0,0,0,,Güzel!
Dialogue: 0,0:12:38.57,0:12:41.11,Main,Nami,0,0,0,,Oh, h-hayır, değilim.
Dialogue: 0,0:12:42.06,0:12:45.38,Main,Brook,0,0,0,,Sadece güzel bayanları görürüm.
Dialogue: 0,0:12:45.38,0:12:48.36,Main,Brook,0,0,0,,Gerçi bir iskelet olarak gözlerim yok.
Dialogue: 0,0:12:54.67,0:12:57.50,Main,Brook,0,0,0,,Acaba külotunuzu gösterebilir misiniz?
Dialogue: 0,0:12:57.50,0:12:58.50,Main,Nami,0,0,0,,Niye göstereyim?!
Dialogue: 0,0:12:59.57,0:13:02.17,Main,Brook,0,0,0,,Oh, ne kadar sert!
Dialogue: 0,0:13:03.68,0:13:05.48,Main,Brook,0,0,0,,Korkarım cildimin bozulmasına neden oldunuz!
Dialogue: 0,0:13:05.48,0:13:07.05,Main,Brook,0,0,0,,Gerçi zaten iskeletim.
Dialogue: 0,0:13:07.05,0:13:08.15,Main,Nami,0,0,0,,Kapa çeneni!
Dialogue: 0,0:13:10.09,0:13:12.59,Main,Luffy,0,0,0,,Hey, sıçabiliyor musun?
Dialogue: 0,0:13:12.59,0:13:15.01,Main,Sanji,0,0,0,,Ondan çok daha önemli sorular var!
Dialogue: 0,0:13:15.32,0:13:16.75,Main,Brook,0,0,0,,Evet, sıçabilirim.
Dialogue: 0,0:13:16.75,0:13:18.98,Main,Sanji,0,0,0,,Ona cevap verme!
Dialogue: 0,0:13:18.98,0:13:19.90,Main,Sanji,0,0,0,,Boşver gitsin!
Dialogue: 0,0:13:20.90,0:13:25.55,Main,Sanji,0,0,0,,Öncelikle iskeletsen, nasıl hayatta olabilir ve konuşabilirsin?
Dialogue: 0,0:13:25.55,0:13:27.92,Main,Sanji,0,0,0,,Kimsin sen?
Dialogue: 0,0:13:27.92,0:13:29.63,Main,Sanji,0,0,0,,Niye buradasın?
Dialogue: 0,0:13:29.63,0:13:31.79,Main,Sanji,0,0,0,,Bu gemiye ne oldu?
Dialogue: 0,0:13:31.79,0:13:34.50,Main,Sanji,0,0,0,,Bu denizde ne tür şeyler olur?
Dialogue: 0,0:13:34.50,0:13:35.54,Main,Sanji,0,0,0,,Hemen bunlara cevap ver!
Dialogue: 0,0:13:35.54,0:13:37.08,Main,Luffy,0,0,0,,Asıl önemlisi...
Dialogue: 0,0:13:37.08,0:13:37.86,Main,Luffy,0,0,0,,Sen!
Dialogue: 0,0:13:39.03,0:13:40.70,Main,Luffy,0,0,0,,Tayfamıza katıl!
Dialogue: 0,0:13:42.64,0:13:44.59,Main,Brook,0,0,0,,İyi o zaman.
Dialogue: 0,0:14:03.55,0:14:06.59,Main,Brook,0,0,0,,Nasılsınız?
Dialogue: 0,0:14:06.59,0:14:10.43,Main,Brook,0,0,0,,Korkarım yolculuk esnasında,\Ngemim epey sıkıntıyla karşılaştı!
Dialogue: 0,0:14:10.43,0:14:12.90,Main,Brook,0,0,0,,Ben "Sadece Ölü Kemikler" Brook'um!
Dialogue: 0,0:14:12.90,0:14:14.05,Main,Brook,0,0,0,,Sizinle tanışmak büyük zevk!
Dialogue: 0,0:14:14.32,0:14:15.38,Main,all,0,0,0,,Bu da ne?!
Dialogue: 0,0:14:15.38,0:14:16.52,Main,all,0,0,0,,Bu herifin nesi var?!
Dialogue: 0,0:14:18.43,0:14:19.39,Main,Brook,0,0,0,,Ah, ah!
Dialogue: 0,0:14:19.39,0:14:20.50,Main,Brook,0,0,0,,Çok sert!
Dialogue: 0,0:14:21.00,0:14:22.47,Main,Chopper,0,0,0,,Bir iskelet!
Dialogue: 0,0:14:26.80,0:14:28.97,Main,Brook,0,0,0,,Ah, ne güzel bir kadın!
Dialogue: 0,0:14:28.97,0:14:31.32,Main,Brook,0,0,0,,Külotunuzu görmeme izin verir misiniz?
Dialogue: 0,0:14:31.32,0:14:32.92,Main,Nami,0,0,0,,Kes şunu, sapık iskelet!
Dialogue: 0,0:14:33.26,0:14:37.16,Main,Usopp,0,0,0,,Kahretsin. İskeletler konuşamaz, yürüyemez veya afroları olamaz!
Dialogue: 0,0:14:37.16,0:14:38.19,Main,Usopp,0,0,0,,Bu bir rüya!
Dialogue: 0,0:14:38.19,0:14:39.59,Main,Usopp,0,0,0,,Rüya olmalı!
Dialogue: 0,0:14:39.59,0:14:41.13,Main,Chopper,0,0,0,,Cidden mi?!
Dialogue: 0,0:14:41.13,0:14:43.66,Main,Chopper,0,0,0,,Hele şükür, rüyaymış.
Dialogue: 0,0:14:45.84,0:14:46.77,Main,Zoro,0,0,0,,Hey, Luffy!
Dialogue: 0,0:14:46.77,0:14:48.11,Main,Zoro,0,0,0,,Bu adamın nesi var?
Dialogue: 0,0:14:48.11,0:14:49.31,Main,Luffy,0,0,0,,Komik, değil mi?
Dialogue: 0,0:14:49.31,0:14:50.58,Main,Luffy,0,0,0,,Artık tayfamızdan biri.
Dialogue: 0,0:14:50.58,0:14:52.40,Main,Zoro,0,0,0,,Umrumda değil, katılmasına izin vermeyeceğim!
Dialogue: 0,0:14:53.25,0:14:56.38,Main,Zoro,0,0,0,,Siz niye onunla gittiniz?
Dialogue: 0,0:14:56.38,0:14:59.35,Main,Zoro,0,0,0,,Böyle bir şey yapmasını engellemek için değil miydi?!
Dialogue: 0,0:14:59.35,0:15:00.62,Main,both,0,0,0,,Üzgünüm.
Dialogue: 0,0:15:02.36,0:15:05.16,Main,Brook,0,0,0,,O kadar kızacak bir şey yok.
Dialogue: 0,0:15:05.16,0:15:06.49,Main,Brook,0,0,0,,İçeri girelim.
Dialogue: 0,0:15:06.49,0:15:07.83,Main,Brook,0,0,0,,Yemek yiyebiliriz!
Dialogue: 0,0:15:08.16,0:15:09.80,Main,all,0,0,0,,{\i1}Buna sen karar veremezsin!
Dialogue: 0,0:15:13.22,0:15:16.01,Main,Brook,0,0,0,,Ah, ne mükemmel bir yemek odası...
Dialogue: 0,0:15:16.01,0:15:17.61,Main,Brook,0,0,0,,...ve de mutfak!
Dialogue: 0,0:15:18.24,0:15:20.28,Main,Brook,0,0,0,,Harikulade bir gemi!
Dialogue: 0,0:15:22.15,0:15:25.46,Main,Franky,0,0,0,,Evet, çünkü onu bu süper adam yaptı!
Dialogue: 0,0:15:25.46,0:15:27.97,Main,Franky,0,0,0,,Gerçekten kaliteden anlıyorsun.
Dialogue: 0,0:15:28.13,0:15:30.68,Main,Sanji,0,0,0,,Hey, ona fazla bağlanma Franky.
Dialogue: 0,0:15:30.94,0:15:34.24,Main,Brook,0,0,0,,Ama asıl merakla beklediğim şey yemek.
Dialogue: 0,0:15:34.24,0:15:38.03,Main,Brook,0,0,0,,Yıllardır iyi bir şey yemedim.
Dialogue: 0,0:15:38.61,0:15:46.04,Main,Brook,0,0,0,,Sadece bir deri bir kemik olduğumdan korkarak, \Nuzun yıllar bu açlık acılarıyla yaşadım.
Dialogue: 0,0:15:46.33,0:15:51.28,Main,Brook,0,0,0,,Gerçi iskeletim ve hiç derim yok!
Dialogue: 0,0:15:52.62,0:15:54.70,Main,Brook,0,0,0,,Kurukafa şakası!
Dialogue: 0,0:15:56.53,0:16:03.17,Main,Brook,0,0,0,,Bir centilmen olarak, yemeğimi beklerken\Ngeçen zamanın tadını çıkarırım.
Dialogue: 0,0:16:03.47,0:16:05.54,Main,Brook,0,0,0,,Akşam Yemeği! Evet!
Dialogue: 0,0:16:03.47,0:16:05.54,Secondary,Luffy,0,0,0,,Yemek! Yemek!
Dialogue: 0,0:16:05.54,0:16:08.61,Main,Brook,0,0,0,,Şef, lütfen bana biraz süt getir!
Dialogue: 0,0:16:08.61,0:16:10.45,Main,Sanji,0,0,0,,Kapa çeneni ve bekle!
Dialogue: 0,0:16:10.71,0:16:12.35,Main,Luffy,0,0,0,,Sahi, Korobokle...
Dialogue: 0,0:16:12.61,0:16:14.78,Main,Brook,0,0,0,,Hayır, Brook.
Dialogue: 0,0:16:14.78,0:16:19.92,Main,Brook,0,0,0,,Ah, üzgünüm ama korkarım henüz ismini duymadım.
Dialogue: 0,0:16:19.92,0:16:21.05,Main,Luffy,0,0,0,,Benim mi?
Dialogue: 0,0:16:21.05,0:16:22.45,Main,Luffy,0,0,0,,Ben Luffy.
Dialogue: 0,0:16:22.45,0:16:24.22,Main,Luffy,0,0,0,,Sahi, nesin sen?
Dialogue: 0,0:16:24.52,0:16:27.20,Main,Zoro,0,0,0,,O tür bir şeyi bile sormadınız mı?!
Dialogue: 0,0:16:27.45,0:16:30.87,Main,Sanji,0,0,0,,Tamamdır! İskeletten sonra kurtulabiliriz.
Dialogue: 0,0:16:30.87,0:16:32.19,Main,Sanji,0,0,0,,Şu anda yemek zamanı!
Dialogue: 0,0:16:32.19,0:16:33.66,Main,Sanji,0,0,0,,Tam bir ahtapot yemeği.
Dialogue: 0,0:16:33.66,0:16:35.44,Main,Luffy,0,0,0,,Leziz görünüyor!
Dialogue: 0,0:16:35.44,0:16:38.03,Main,Luffy,0,0,0,,Hey, Brook. Bol bol ye!
Dialogue: 0,0:16:38.03,0:16:40.28,Main,Luffy,0,0,0,,Sanji'nin yemeği en iyisidir!
Dialogue: 0,0:16:40.73,0:16:43.07,Main,Brook,0,0,0,,Ama...
Dialogue: 0,0:16:43.73,0:16:46.57,Main,Brook,0,0,0,,...korkarım kalbim midemden daha boş.
Dialogue: 0,0:16:47.97,0:16:50.29,Main,Brook,0,0,0,,Güzel leydim, porsiyonunuz biraz büyük görünüyor.
Dialogue: 0,0:16:50.29,0:16:51.61,Main,Brook,0,0,0,,Değişmek ister misiniz?
Dialogue: 0,0:16:51.96,0:16:54.06,Main,Sanji,0,0,0,,Geride çok var, bu yüzden kendininkini ye!
Dialogue: 0,0:16:57.23,0:16:58.47,Main,Nami,0,0,0,,*Yomi Yomi Meyvesi?
Dialogue: 0,0:16:57.23,0:16:58.47,Main,,0,0,0,,{\c&H42EBFF&}{\an8}Yomi: Diriliş veya Yeraltı
Dialogue: 0,0:16:58.47,0:17:00.70,Main,Franky,0,0,0,,Demek Şeytan Meyvesi yedin.
Dialogue: 0,0:17:01.52,0:17:03.33,Main,Brook,0,0,0,,Evet.
Dialogue: 0,0:17:03.92,0:17:07.86,Main,Brook,0,0,0,,Aslında yıllar önce bir kez öldüm.
Dialogue: 0,0:17:07.86,0:17:09.59,Main,Sanji,0,0,0,,Önce yüzünü temizle.
Dialogue: 0,0:17:09.59,0:17:11.10,Main,Sanji,0,0,0,,Kendini nasıl bu kadar kirletebildin?
Dialogue: 0,0:17:11.61,0:17:13.43,Main,Brook,0,0,0,,Yomi Yomi Meyvesi...
Dialogue: 0,0:17:14.90,0:17:18.74,Main,Brook,0,0,0,,...yeniden dirilme yeteneği bahşeder,\Nbu yüzden yeniden dirilmiş biri olarak...
Dialogue: 0,0:17:20.40,0:17:22.84,Main,Brook,0,0,0,,...ikinci bir yaşam sözü alırsın.
Dialogue: 0,0:17:22.84,0:17:24.72,Main,Brook,0,0,0,,Epey gizemli bir yetenek.
Dialogue: 0,0:17:24.72,0:17:31.25,Main,Brook,0,0,0,,Evet, o sırada aynı sizin gibi korsandım.
Dialogue: 0,0:17:31.25,0:17:31.98,Main,Brook,0,0,0,,Afedersiniz.
Dialogue: 0,0:17:33.09,0:17:34.55,Main,Brook,0,0,0,,Ah, pardon.
Dialogue: 0,0:17:35.76,0:17:39.89,Main,Sanji,0,0,0,,Sana biraz terbiye vermek istiyorum.
Dialogue: 0,0:17:42.37,0:17:44.96,Main,Brook,0,0,0,,Uzun zaman önce,...
Dialogue: 0,0:17:44.96,0:17:47.08,Main,Brook,0,0,0,,...demin içinde bulunduğum gemiyle,...
Dialogue: 0,0:17:47.63,0:17:52.25,Main,Brook,0,0,0,,...dahil olduğum korsan tayfası bu şeytanlar denizine geldi.
Dialogue: 0,0:17:52.25,0:17:53.54,Main,Brook,0,0,0,,Ancak...
Dialogue: 0,0:17:53.54,0:17:57.51,Main,Brook,0,0,0,,...ne şanssızlık ki bizim için fazlasıyla\Ngüçlü düşmanlar ortaya çıktı.
Dialogue: 0,0:17:59.71,0:18:01.85,Main,Brook,0,0,0,,Tüm tayfamız bir savaşta öldürüldü.
Dialogue: 0,0:18:06.72,0:18:09.70,Main,Brook,0,0,0,,Elbette ben de öldüm.
Dialogue: 0,0:18:11.19,0:18:16.57,Main,Brook,0,0,0,,Hayattayken Yomi Yomi Meyvesi,\Nbeni sadece yüzemez hale getirdi.
Dialogue: 0,0:18:17.17,0:18:21.68,Main,Brook,0,0,0,,Ancak o gün, o meyve bundan fazlası haline geldi!
Dialogue: 0,0:18:23.50,0:18:25.42,Main,Brook,0,0,0,,Ruhum...
Dialogue: 0,0:18:25.42,0:18:29.22,Main,Brook,0,0,0,,...yeraltından bu dünyaya döndü!
Dialogue: 0,0:18:36.03,0:18:40.20,Main,Brook,0,0,0,,Bedenimi hemen bulabilseydim, dirilebilirdim.
Dialogue: 0,0:18:40.20,0:18:46.93,Main,Brook,0,0,0,,Ancak gördüğünüz gibi sis,\Nbu denizde yön bulmayı zorlaştırıyor.
Dialogue: 0,0:18:46.93,0:18:49.47,Main,Brook,0,0,0,,Kaybolmuştum!
Dialogue: 0,0:18:50.29,0:18:55.57,Main,Brook,0,0,0,,Bir yıl boyunca kayıp bir ruh olarak bedenimi aradım.
Dialogue: 0,0:18:57.44,0:19:02.49,Main,Brook,0,0,0,,Nihayet onu bulmuştum!
Dialogue: 0,0:19:03.24,0:19:08.46,Main,Brook,0,0,0,,Ancak bedenimden geriye\Nkemikten başka bir şey kalmamıştı!
Dialogue: 0,0:19:12.13,0:19:15.13,Main,Brook,0,0,0,,Onu görünce gözlerim\Nşaşkınlıktan fal taşı gibi açıldı.
Dialogue: 0,0:19:15.32,0:19:17.40,Main,Brook,0,0,0,,Gerçi gözlerim yok!
Dialogue: 0,0:19:18.64,0:19:20.59,Main,Luffy,0,0,0,,Çok aptalsın!
Dialogue: 0,0:19:20.59,0:19:22.37,Main,Luffy,0,0,0,,Aynı Zoro gibi kaybolmuşsun!
Dialogue: 0,0:19:22.76,0:19:23.94,Main,Zoro,0,0,0,,Hey.
Dialogue: 0,0:19:23.94,0:19:27.13,Main,Franky,0,0,0,,Yani o zaman mı konuşan bir iskelet oldun?
Dialogue: 0,0:19:27.13,0:19:32.64,Main,Franky,0,0,0,,Şeytan Meyvesi'nin bir kimseyi \Nhayata bile döndürebileceğini bilmiyordum.
Dialogue: 0,0:19:32.64,0:19:37.24,Main,Sanji,0,0,0,,Ama hayata döndükten sonra bile yüzemiyorsun.
Dialogue: 0,0:19:37.24,0:19:39.45,Main,Sanji,0,0,0,,Yani sadece lanetlenmişsin.
Dialogue: 0,0:19:39.45,0:19:43.18,Main,Zoro,0,0,0,,Ama normalde kemik üstünde saç uzamaz.
Dialogue: 0,0:19:43.18,0:19:45.29,Main,Zoro,0,0,0,,Daha önce hiç afrolu bir iskelet görmemiştim.
Dialogue: 0,0:19:45.29,0:19:47.52,Main,Brook,0,0,0,,Oh, saç köklerim çok güçlüydü.
Dialogue: 0,0:19:47.52,0:19:49.27,Main,Zoro,0,0,0,,Neyse.
Dialogue: 0,0:19:49.27,0:19:51.72,Main,Usopp,0,0,0,,Yani sen hayalet değil misin?
Dialogue: 0,0:19:51.72,0:19:53.46,Main,Usopp,0,0,0,,İnsan mısın?
Dialogue: 0,0:19:53.46,0:19:55.16,Main,Usopp,0,0,0,,Ama hayalet değilsin, değil mi?!
Dialogue: 0,0:19:55.16,0:19:57.76,Main,Brook,0,0,0,,Evet, hayaletleri ben de sevmem!
Dialogue: 0,0:19:57.76,0:20:00.03,Main,Brook,0,0,0,,Görürsem korkudan bağırırım!
Dialogue: 0,0:20:00.03,0:20:01.35,Main,Nami,0,0,0,,Hiç aynaya baktın mı?
Dialogue: 0,0:20:01.35,0:20:04.62,Main,Brook,0,0,0,,Hayır, ayna olmaz!
Dialogue: 0,0:20:04.62,0:20:06.95,Main,Usopp,0,0,0,,Hey, dur biraz!
Dialogue: 0,0:20:06.95,0:20:08.72,Main,Chopper,0,0,0,,Sen...
Dialogue: 0,0:20:09.01,0:20:10.69,Main,both,0,0,0,,Senin niye...
Dialogue: 0,0:20:10.69,0:20:13.67,Main,both,0,0,0,,...aynada görüntün yok?!
Dialogue: 0,0:20:16.13,0:20:18.38,Main,all,0,0,0,,Vampir?!
Dialogue: 0,0:20:19.22,0:20:20.42,Main,Luffy,0,0,0,,Cidden mi?!
Dialogue: 0,0:20:20.42,0:20:21.90,Main,Luffy,0,0,0,,Müthiş!
Dialogue: 0,0:20:22.65,0:20:24.13,Main,Usopp,0,0,0,,Sahi...
Dialogue: 0,0:20:24.59,0:20:26.14,Main,Usopp,0,0,0,,...gölgen de yok!
Dialogue: 0,0:20:26.14,0:20:27.42,Main,Chopper,0,0,0,,Doğru!
Dialogue: 0,0:20:27.42,0:20:29.87,Main,Chopper,0,0,0,,Nesin sen böyle?!
Dialogue: 0,0:20:35.77,0:20:37.20,Main,Sanji,0,0,0,,Niye bu kadar sakinsin?
Dialogue: 0,0:20:37.20,0:20:39.55,Main,Usopp,0,0,0,,Şu anda senden gerçekten korkuyoruz!
Dialogue: 0,0:20:40.60,0:20:43.14,Main,Brook,0,0,0,,Size anlatacağım.
Dialogue: 0,0:20:43.14,0:20:48.49,Main,Brook,0,0,0,,Yıllardır bu denizde dolanıyorum.
Dialogue: 0,0:20:48.91,0:20:55.37,Main,Brook,0,0,0,,Ancak iskelet olmamla gölgemin olmaması, \Niki alakasız konu.
Dialogue: 0,0:20:58.17,0:20:59.39,Main,Brook,0,0,0,,Devam edecek.
Dialogue: 0,0:20:59.39,0:21:00.87,Main,Sanji,0,0,0,,Hayır, şimdi anlat!
Dialogue: 0,0:21:02.24,0:21:06.44,Main,Brook,0,0,0,,Gölgem, yıllar önce benden çalındı.
Dialogue: 0,0:21:06.44,0:21:07.58,Main,Usopp,0,0,0,,Çalındı mı?
Dialogue: 0,0:21:08.27,0:21:08.95,Main,Robin,0,0,0,,Gölgen mi?
Dialogue: 0,0:21:09.56,0:21:14.58,Main,Zoro,0,0,0,,Seni burada canlı ve konuşuyor gördükten sonra, \Nsöylediklerin hiç de şaşırtıcı değil.
Dialogue: 0,0:21:14.58,0:21:16.79,Main,Zoro,0,0,0,,Ama bu gerçekten olabilir mi?
Dialogue: 0,0:21:16.79,0:21:18.95,Main,Brook,0,0,0,,Evet, olabilir.
Dialogue: 0,0:21:18.95,0:21:25.06,Main,Brook,0,0,0,,Gölgemin benden çalınmış olması, artık dünyanın ışığında var olamayacağım anlamına gelir.
Dialogue: 0,0:21:25.06,0:21:28.18,Main,Brook,0,0,0,,Güneş ışığında kalsaydım,...
Dialogue: 0,0:21:28.18,0:21:30.03,Main,Brook,0,0,0,,...bedenim...
Dialogue: 0,0:21:30.87,0:21:34.92,Main,Brook,0,0,0,,{\fad(0,1500)}...parçalanırdı!
Dialogue: 0,0:21:44.58,0:21:45.45,Main,Brook,0,0,0,,Bir keresinde...
Dialogue: 0,0:21:45.45,0:21:51.16,Main,Brook,0,0,0,,...aynı lanete uğramış bir kişinin\Ngüneş ışığına maruz kalması...
Dialogue: 0,0:21:51.16,0:21:55.30,Main,Brook,0,0,0,,...tüylerimi diken diken etmeye yetti!
Dialogue: 0,0:21:55.30,0:21:57.49,Main,Brook,0,0,0,,Hem de iskelet olmama rağmen.
Dialogue: 0,0:21:58.36,0:22:02.57,Main,Brook,0,0,0,,Gölge, güneş ışığı tarafından yere aksettirilir.
Dialogue: 0,0:22:02.57,0:22:11.48,Main,Brook,0,0,0,,Bu yüzden ayna veya fotoğraf gibi şeylerde yansıtılamam.
Dialogue: 0,0:22:11.48,0:22:16.95,Main,Brook,0,0,0,,Kısacası tüm arkadaşlarım öldü ve ışığa\Nçıkamaz bir halde burada yaşıyorum!
Dialogue: 0,0:22:17.48,0:22:20.20,Main,Sanji,0,0,0,,Hayatın çok kötü geçmiş.
Dialogue: 0,0:22:20.20,0:22:22.86,Main,Brook,0,0,0,,Ama tüm bunlardan sağ çıktım!
Dialogue: 0,0:22:22.86,0:22:24.60,Main,Brook,0,0,0,,Sadece kemik olmama rağmen.
Dialogue: 0,0:22:24.60,0:22:26.84,Main,Brook,0,0,0,,Ben "Sadece Ölü Kemikler" Brook'um!
Dialogue: 0,0:22:26.84,0:22:28.06,Main,Brook,0,0,0,,Tanıştığıma memnun oldum!
Dialogue: 0,0:22:28.06,0:22:29.79,Main,Sanji,0,0,0,,Niye bu kadar mutlusun?
Dialogue: 0,0:22:33.99,0:22:35.84,Main,Usopp,0,0,0,,Hey, hey, sorun nedir?
Dialogue: 0,0:22:35.84,0:22:36.47,Main,Usopp,0,0,0,,İyi misin?
Dialogue: 0,0:22:39.45,0:22:41.85,Main,Brook,0,0,0,,Bugün harikulade bir gün!
Dialogue: 0,0:22:41.85,0:22:43.80,Main,Brook,0,0,0,,{\fad(0,465)}Bir kez daha insanları gördüm!
Dialogue: 0,0:22:45.13,0:22:48.98,Main,Brook,0,0,0,,Yıllarca bu okyanusta dolaştım.
Dialogue: 0,0:22:48.98,0:22:50.68,Main,Brook,0,0,0,,Sis her yeri o kadar karartıyor ki\Ngünlerin geçtiğini bile anlayamadım.
Dialogue: 0,0:22:55.23,0:22:58.06,Main,Brook,0,0,0,,Tüm arkadaşlarım ölmüştü.
Dialogue: 0,0:22:58.59,0:23:02.19,Main,Brook,0,0,0,,Dümen tutulamayan bir gemide yapayalnızdım.
Dialogue: 0,0:23:03.08,0:23:07.06,Main,Brook,0,0,0,,Amaçsızca yıllar boyu yol alıyordum.
Dialogue: 0,0:23:07.99,0:23:12.07,Main,Brook,0,0,0,,Çok yalnızdım!
Dialogue: 0,0:23:12.74,0:23:13.87,Main,Brook,0,0,0,,Çok yalnız...
Dialogue: 0,0:23:14.21,0:23:15.61,Main,Brook,0,0,0,,...ve çok korkmuş.
Dialogue: 0,0:23:15.90,0:23:17.57,Main,Brook,0,0,0,,Sadece ölmek istedim.
Dialogue: 0,0:23:20.14,0:23:23.48,Main,Brook,0,0,0,,Ama yaşadım.
Dialogue: 0,0:23:23.97,0:23:25.51,Main,Brook,0,0,0,,İnsanlar benim mutluluğum!
Dialogue: 0,0:23:25.51,0:23:29.39,Main,Brook,0,0,0,,Hepiniz benim neşemsiniz!
Dialogue: 0,0:23:30.01,0:23:34.06,Main,Brook,0,0,0,,O kadar mutluyum ki yapabilseydim ağlardım!
Dialogue: 0,0:23:35.02,0:23:37.79,Main,Brook,0,0,0,,Tayfana katılmamı istedin, değil mi?
Dialogue: 0,0:23:37.79,0:23:40.92,Main,Brook,0,0,0,,Bu beni çok mutlu etti, çok sağol.
Dialogue: 0,0:23:42.29,0:23:44.56,Main,Brook,0,0,0,,Ancak teklifini reddetmeliyim.
Dialogue: 0,0:23:45.56,0:23:46.50,Main,Luffy,0,0,0,,Niye?!
Dialogue: 0,0:23:47.16,0:23:53.87,Main,Brook,0,0,0,,Demin de dediğim gibi, \Ngölgem çalındı ve dünya ışığına dönemem.
Dialogue: 0,0:23:53.87,0:23:58.64,Main,Brook,0,0,0,,Şu anda bu şeytanlar denizinin sisiyle korunuyorum.
Dialogue: 0,0:23:58.64,0:23:59.48,Main,Brook,0,0,0,,Ancak...
Dialogue: 0,0:23:59.48,0:24:05.25,Main,Brook,0,0,0,,...sizinle bu okyanustan ayrılsaydım,\Nbedenimin yok olması an meselesi olurdu.
Dialogue: 0,0:24:05.25,0:24:10.59,Main,Brook,0,0,0,,Gölgemi geri kazanabileceğim neşeli\Ngünü bekleyerek burada kalacağım!
Dialogue: 0,0:24:13.42,0:24:15.49,Main,Luffy,0,0,0,,Neden bahsediyorsun sen?!
Dialogue: 0,0:24:15.49,0:24:18.20,Main,Luffy,0,0,0,,Gölgene ihtiyacın varsa,\Nonu senin için geri alacağım.
Dialogue: 0,0:24:18.91,0:24:21.32,Main,Luffy,0,0,0,,Biri çaldı demiştin, değil mi?
Dialogue: 0,0:24:21.32,0:24:22.07,Main,Luffy,0,0,0,,Kimdi?
Dialogue: 0,0:24:22.07,0:24:23.14,Main,Luffy,0,0,0,,Nerede?
Dialogue: 0,0:24:24.17,0:24:27.96,Main,Brook,0,0,0,,Gerçekten iyi birisin.
Dialogue: 0,0:24:27.96,0:24:29.86,Main,Brook,0,0,0,,Şaşırdım.
Dialogue: 0,0:24:29.86,0:24:31.65,Main,Brook,0,0,0,,Ama sana söylemeyeceğim.
Dialogue: 0,0:24:32.45,0:24:37.79,Main,Brook,0,0,0,,Yeni tanıştığım, gidip benim için ölecek birine söyleyemem.
Dialogue: 0,0:24:38.14,0:24:40.44,Main,Franky,0,0,0,,Hırsızın çok güçlü olduğunu mu düşünüyorsun?
Dialogue: 0,0:24:40.44,0:24:43.93,Main,Franky,0,0,0,,Sorun değil ama en azından ismini söyleyemez misin?
Dialogue: 0,0:24:43.93,0:24:45.84,Main,Brook,0,0,0,,Hayır, söyleyemem.
Dialogue: 0,0:24:45.84,0:24:47.80,Main,Brook,0,0,0,,Söylersem onu bulabilirsiniz!
Dialogue: 0,0:24:50.10,0:24:54.78,Main,Brook,0,0,0,,İkinci hayatım bitmeden onu bulabilecek miyim, bilmiyorum.
Dialogue: 0,0:24:54.78,0:24:59.86,Main,Brook,0,0,0,,Ama bulursam onunla dövüşmeye karar verdim.
Dialogue: 0,0:25:00.14,0:25:01.37,Main,Brook,0,0,0,,Bu bir yana,...
Dialogue: 0,0:25:01.37,0:25:03.24,Main,Brook,0,0,0,,...hadi şarkı söyleyelim.
Dialogue: 0,0:25:06.25,0:25:08.73,Main,Brook,0,0,0,,Müzik benim onurumdur!
Dialogue: 0,0:25:08.73,0:25:11.46,Main,Brook,0,0,0,,Tayfamda müzisyendim.
Dialogue: 0,0:25:12.38,0:25:13.30,Main,Luffy,0,0,0,,Cidden mi?!
Dialogue: 0,0:25:13.30,0:25:15.05,Main,Luffy,0,0,0,,Müzisyen misin?!
Dialogue: 0,0:25:15.05,0:25:17.09,Main,Luffy,0,0,0,,O zaman kesinlikle tayfamıza katılmalısın, aptal!
Dialogue: 0,0:25:19.16,0:25:22.10,Main,Brook,0,0,0,,Birlikte neşeli bir şarkı söyleyelim!
Dialogue: 0,0:25:28.61,0:25:29.69,Main,Sanji,0,0,0,,Hey, ne oldu?
Dialogue: 0,0:25:29.69,0:25:30.41,Main,Sanji,0,0,0,,Sorun nedir?
Dialogue: 0,0:25:30.95,0:25:32.39,Main,Brook,0,0,0,,H-H-...
Dialogue: 0,0:25:33.42,0:25:34.81,Main,Brook,0,0,0,,Hayalet!
Dialogue: 0,0:25:34.81,0:25:37.11,Main,Chopper,0,0,0,,Orada bir şey var!
Dialogue: 0,0:25:38.46,0:25:40.35,Main,Chopper,0,0,0,,Korkuyorum, hayalet var!
Dialogue: 0,0:25:40.35,0:25:41.66,Main,Luffy,0,0,0,,Süper!
Dialogue: 0,0:25:42.40,0:25:43.29,Main,Nami,0,0,0,,Buradan gidiyorum!
Dialogue: 0,0:25:47.39,0:25:48.34,Main,Zoro,0,0,0,,Niye sarsılıyoruz?
Dialogue: 0,0:25:49.15,0:25:50.09,Main,Brook,0,0,0,,Hayır, olamaz!
Dialogue: 0,0:25:52.11,0:25:53.33,Main,Brook,0,0,0,,Olacak şey mi bu?!
Dialogue: 0,0:25:53.87,0:25:57.30,Main,Brook,0,0,0,,Bu gemiyi mi izliyorlardı?!
Dialogue: 0,0:25:57.89,0:25:59.15,Main,Brook,0,0,0,,Lütfen bakın!
Dialogue: 0,0:25:59.15,0:26:01.61,Main,Brook,0,0,0,,Gemi engellenmiş!
Dialogue: 0,0:26:03.13,0:26:05.08,Main,Brook,0,0,0,,Sarsıntıya sebep olan bu!
Dialogue: 0,0:26:08.72,0:26:10.45,Main,Brook,0,0,0,,Burası kapının arkası.
Dialogue: 0,0:26:10.45,0:26:11.65,Main,Luffy,0,0,0,,Kapı mı?
Dialogue: 0,0:26:12.02,0:26:13.08,Main,Brook,0,0,0,,Bunun anlamı...
Dialogue: 0,0:26:14.69,0:26:16.69,Main,Brook,0,0,0,,Geminin arkasına bakın!
Dialogue: 0,0:26:24.28,0:26:25.73,Main,Nami,0,0,0,,Nedir o?
Dialogue: 0,0:26:28.74,0:26:32.57,Main,Brook,0,0,0,,Sudan yüzen bir fıçı almış olabilir misiniz?
Dialogue: 0,0:26:34.86,0:26:35.91,Main,Luffy,0,0,0,,Haklısın!
Dialogue: 0,0:26:36.16,0:26:38.98,Main,Brook,0,0,0,,Elbette o tuzaktı!
Dialogue: 0,0:26:38.98,0:26:42.15,Main,Brook,0,0,0,,Bu gemi o zamandan beri hedef alınmış.
Dialogue: 0,0:26:42.15,0:26:44.68,Main,Luffy,0,0,0,,Ne demek istiyorsun?
Dialogue: 0,0:26:44.68,0:26:48.29,Main,Luffy,0,0,0,,Onca zamandır tam buradaydık.
Dialogue: 0,0:26:56.65,0:26:59.21,Main,Luffy,0,0,0,,Niye orada bir ada var?
Dialogue: 0,0:26:59.21,0:27:02.93,Main,Brook,0,0,0,,O, dolaşan hayalet ada,...
Dialogue: 0,0:27:02.93,0:27:04.90,Main,Brook,0,0,0,,...Thriller Bark.
Dialogue: 0,0:27:10.64,0:27:12.19,Main,Nami,0,0,0,,Durun biraz.
Dialogue: 0,0:27:12.19,0:27:14.73,Main,Nami,0,0,0,,Seyir belirleyici hiç tepki vermiyor!
Dialogue: 0,0:27:14.73,0:27:16.10,Main,Brook,0,0,0,,Doğru.
Dialogue: 0,0:27:16.10,0:27:19.62,Main,Brook,0,0,0,,Çünkü bu ada, uzak Batı Mavi'den yolculuk ederek buraya geldi.
Dialogue: 0,0:27:21.50,0:27:25.01,Main,Brook,0,0,0,,Ama bugün çok şanslı bir gün.
Dialogue: 0,0:27:25.01,0:27:28.43,Main,Brook,0,0,0,,Sadece insanları görmekle kalmadım,\Nen büyük isteğim de gerçeğe dönüştü!
Dialogue: 0,0:27:35.15,0:27:36.60,Main,Sanji,0,0,0,,Çok hafif!
Dialogue: 0,0:27:37.55,0:27:38.46,Main,Brook,0,0,0,,Elbette!
Dialogue: 0,0:27:38.46,0:27:40.57,Main,Brook,0,0,0,,"Sadece ölü kemikler" olduğum için hafif olmam gerekir!
Dialogue: 0,0:27:41.32,0:27:46.28,Main,Brook,0,0,0,,Arkanızdaki kapıdan geçmenin bir\Nyolunu bulun ve lütfen burayı terkedin.
Dialogue: 0,0:27:46.28,0:27:49.01,Main,Brook,0,0,0,,Sakın buraya demir atmayın.
Dialogue: 0,0:27:49.73,0:27:53.72,Main,Brook,0,0,0,,Sizinle tanıştığıma çok mutlu oldum.
Dialogue: 0,0:27:53.72,0:27:56.99,Main,Brook,0,0,0,,Leziz yemeğinizi asla unutmayacağım!
Dialogue: 0,0:27:56.99,0:27:58.16,Main,Brook,0,0,0,,Elveda!
Dialogue: 0,0:27:58.16,0:28:00.46,Main,Brook,0,0,0,,Kaderde varsa, yine karşılaşacağız!
Dialogue: 0,0:28:00.46,0:28:02.16,Main,Luffy,0,0,0,,Hey, dur! Brook!
Dialogue: 0,0:28:02.16,0:28:03.80,Main,Zoro,0,0,0,,O, Şeytan Meyvesi yememiş miydi?!
Dialogue: 0,0:28:03.80,0:28:05.93,Main,Usopp,0,0,0,,Ne yapıyorsun?!
Dialogue: 0,0:28:09.05,0:28:10.42,Main,Usopp,0,0,0,,Suyun üstünde koşuyor!
Dialogue: 0,0:28:10.42,0:28:12.60,Main,Luffy,0,0,0,,Woah, Müthiş!!
Dialogue: 0,0:28:16.89,0:28:19.02,Main,Nami,0,0,0,,N-Neyse, Luffy...
Dialogue: 0,0:28:19.02,0:28:21.00,Main,Nami,0,0,0,,...onun söylediğini yapalım!
Dialogue: 0,0:28:21.00,0:28:25.23,Main,Nami,0,0,0,,Burada neler oluyor bilmiyoruz ama tehlikeli olduğunu biliyoruz!
Dialogue: 0,0:28:26.40,0:28:27.77,Main,Luffy,0,0,0,,Bir şey mi dedin?
Dialogue: 0,0:28:27.77,0:28:30.14,Main,all,0,0,0,,Gidiyor!
