2,180,180,27,1Style: RogerMonologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1Style: Karaoke,Duality,68,&H00292CC7,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,4,0,1,6.8,0,8,23,23,23,1Style: Translation,Duality,68,&H00292CC7,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,4,0,1,6.8,0,2,23,23,34,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:49.92,0:01:59.92,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 50,0:01:57.39,0:02:01.36,Main-207-,,0,0,0,,Ve sonra, tam o anda, döndüm ve dedim ki...Dialogue: 50,0:02:01.36,0:02:03.90,Main-207-,,0,0,0,,"Seni çarpık bacaklı ucube!"Dialogue: 50,0:02:03.90,0:02:05.35,Main-207-,,0,0,0,,Ve o günden sonra,Dialogue: 50,0:02:05.35,0:02:08.52,Main-207-,,0,0,0,,dünyadaki tüm yengeçler çarpık bacaklarının farkına vardı.Dialogue: 50,0:02:10.19,0:02:11.99,Main-207-,,0,0,0,,Bu yüzden mi yan yan yürüyorlar?Dialogue: 50,0:02:11.99,0:02:16.03,Main-207-,,0,0,0,,Hı hı. Ayrıca arkaya doğru zıplayan biri vardı.Dialogue: 50,0:02:16.03,0:02:17.53,Main-207-,,0,0,0,,O bir karidesti.Dialogue: 50,0:02:18.66,0:02:20.95,Main-207-,,0,0,0,,Öyleyse karidesler de mi yengeç?Dialogue: 50,0:02:20.95,0:02:22.86,Main-207-,,0,0,0,,Evet, onlar da yengeç.Dialogue: 50,0:02:24.67,0:02:28.51,Main-207-,,0,0,0,,Zoro, enerjini boşa harcamıyor musun?Dialogue: 50,0:02:28.51,0:02:29.72,Main-207-,,0,0,0,,Kapa' çeneni.Dialogue: 50,0:02:29.72,0:02:32.47,Main-207-,,0,0,0,,Boş ver onları, Nami-san.Dialogue: 50,0:02:32.47,0:02:36.76,Main-207-,,0,0,0,,Tansiyonu düşürecek bir şeyler yapmalılar.Dialogue: 50,0:02:36.76,0:02:39.47,Main-207-,,0,0,0,,Beceriksizler sonuçta. Özellikle...Dialogue: 50,0:02:42.18,0:02:46.27,Main-207-,,0,0,0,,Shichibukai'den öldüresiye dayak yemiş şu kaslı adam.Dialogue: 50,0:02:47.31,0:02:49.86,Main-207-,,0,0,0,,Hey, lanet olası. Ne demeye çalışıyorsun?Dialogue: 50,0:02:50.35,0:02:51.62,Main-207-,,0,0,0,,Yüzüme söyle.Dialogue: 50,0:02:51.62,0:02:53.82,Main-207-,,0,0,0,,Ah, söyleyeyim madem.Dialogue: 50,0:02:53.82,0:02:58.78,Main-207-,,0,0,0,,Luffy'nin kaybetmesinden korkuyorsun.Dialogue: 50,0:02:59.24,0:03:04.12,Main-207-,,0,0,0,,Ben mi?! Korkmak mı?! Seni...Dialogue: 50,0:03:04.12,0:03:05.21,Main-207-,,0,0,0,,süs kaşlı!Dialogue: 50,0:03:05.21,0:03:08.00,Main-207-,,0,0,0,,Şimdi kaşındın! Diline hâkim ol...Dialogue: 50,0:03:08.00,0:03:09.90,Main-207-,,0,0,0,,seni yosun kafa!Dialogue: 50,0:03:09.90,0:03:10.88,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:03:11.49,0:03:13.35,Main-207-,,0,0,0,,Dövüşmek mi istiyorsun?!Dialogue: 50,0:03:15.15,0:03:17.34,Main-207-,,0,0,0,,Kesin şunu! Bu faydasız.Dialogue: 50,0:03:19.09,0:03:23.05,Thoughts-207-,,0,0,0,,Kendilerini tutamıyorlar. Herkes çok gergin.Dialogue: 50,0:03:23.05,0:03:25.28,Thoughts-207-,,0,0,0,,Şimdi benim zamanım, ikinci kaptan olar–Dialogue: 50,0:03:25.28,0:03:27.66,Main-207-,,0,0,0,,Herkes sakin olsun.Dialogue: 50,0:03:27.13,0:03:27.66,Secondary-207-,,0,0,0,,Ha?Dialogue: 50,0:03:27.66,0:03:30.73,Main-207-,,0,0,0,,Luffy-san kaybetmeyecek! Bir söz verdik, değil mi?Dialogue: 50,0:03:30.73,0:03:33.44,Main-207-,,0,0,0,,Alubarna'da bekleyeceğimizi söyledik!Dialogue: 50,0:03:33.44,0:03:36.03,Main-207-,,0,0,0,,En çok endişelenen sensin!Dialogue: 50,0:03:37.37,0:03:38.18,Main-207-,,0,0,0,,Ah!Dialogue: 50,0:03:38.18,0:03:40.99,Main-207-,,0,0,0,,Sen sadece isyan için endişelen.Dialogue: 50,0:03:42.24,0:03:43.70,Main-207-,,0,0,0,,Özür dilerim, Vivi-chan.Dialogue: 50,0:03:43.70,0:03:46.66,Main-207-,,0,0,0,,Son sözünüz buysa benim için konu kapanmıştır.Dialogue: 50,0:03:47.76,0:03:50.74,Main-207-,,0,0,0,,Tamam, düşüncelerimizi Alubarna'ya odaklayalım!Dialogue: 50,0:03:50.74,0:03:53.40,Main-207-,,0,0,0,,Gidelim, Kıskaç!Dialogue: 50,0:03:56.27,0:03:57.25,Main-207-,,0,0,0,,O da ne?Dialogue: 50,0:03:57.25,0:03:58.56,Main-207-,,0,0,0,,Yengecin adı.Dialogue: 50,0:03:59.62,0:04:00.77,Main-207-,,0,0,0,,Kıskaç mı, dedin?Dialogue: 50,0:04:00.77,0:04:02.47,Main-207-,,0,0,0,,– Beğenemedin mi?! – Tabii ki beğendim.Dialogue: 50,0:04:12.69,0:04:15.94,Main-207-,,0,0,0,,Bak! Ç-Çok fazla var!Dialogue: 50,0:04:17.44,0:04:19.39,Main-207-,,0,0,0,,Su...Dialogue: 50,0:04:21.03,0:04:23.32,Main-207-,,0,0,0,,Su çıkıyor!Dialogue: 50,0:04:25.37,0:04:27.65,Main-207-,,0,0,0,,Söylememiş miydim, Luffy-kun?Dialogue: 50,0:04:28.83,0:04:30.75,Main-207-,,0,0,0,,Bu ülke güçlüdür.Dialogue: 50,0:04:33.36,0:04:36.17,Main-207-,,0,0,0,,Yuba hâlâ yaşıyor!Dialogue: 50,0:04:40.24,0:04:42.13,Main-207-,,0,0,0,,Yuba, ölecek.Dialogue: 50,0:04:42.13,0:04:45.60,Main-207-,,0,0,0,,Bu son kum fırtınası orayı yok edecek.Dialogue: 50,0:04:46.36,0:04:50.72,Main-207-,,0,0,0,,Ve İsyan Ordusu'nun öfke alevleri daha da tutuşacak.Dialogue: 50,0:04:53.52,0:04:58.53,Main-207-,,0,0,0,,Başkalarına duyulan bu modası geçmiş merhamet, bu ülkenin sonunu getirecek.Dialogue: 50,0:04:59.99,0:05:03.95,Main-207-,,0,0,0,,Bu senin için de geçerli, Hasır Şapkalı Luffy.Dialogue: 50,0:05:04.61,0:05:08.87,Main-207-,,0,0,0,,O faydasız hisleri en baştan görmezden gelseydin, daha uzun yaşardın.Dialogue: 50,0:05:11.78,0:05:13.71,Main-207-,,0,0,0,,Su...?Dialogue: 50,0:05:13.71,0:05:17.92,Main-207-,,0,0,0,,Hâlâ bu suya minnettar mısın, ha?Dialogue: 50,0:05:30.89,0:05:34.06,Main-207-,,0,0,0,,Ne? Hâlâ hayatta mısın?Dialogue: 50,0:05:52.80,0:05:57.42,Main-207-,,0,0,0,,Epey acı içinde gibisin. Ama birazdan huzura kavuşacaksın.Dialogue: 50,0:06:06.18,0:06:08.25,Main-207-,,0,0,0,,Elveda.Dialogue: 50,0:06:13.03,0:06:15.87,Main-207-,,0,0,0,,Ne vakit kaybı.Dialogue: 50,0:06:28.42,0:06:34.74,Main-207-,,0,0,0,,Hiç önemli değil. Bu kumu atlattığımızda, yağmur yağacak.Dialogue: 50,0:06:34.74,0:06:36.58,Main-207-,,0,0,0,,Her zaman olduğu gibi.Dialogue: 50,0:06:38.75,0:06:42.72,Main-207-,,0,0,0,,Durma, gel! İstediğin kadar saldır, kum fırtınaları!Dialogue: 50,0:06:43.22,0:06:47.89,Main-207-,,0,0,0,,Yuba asla kumlara teslim olmayacak!Dialogue: 50,0:06:56.05,0:06:57.99,Main-207-,,0,0,0,,Alubarna'ya mı gideyim?Dialogue: 50,0:06:59.23,0:07:01.40,Main-207-,,0,0,0,,Hasır Şapka Korsanları'nı mı takip edeyim?Dialogue: 50,0:07:01.40,0:07:04.21,Main-207-,,0,0,0,,Yoksa Kraliyet Ordusu'na mı yardım edeyim?Dialogue: 50,0:07:04.21,0:07:05.82,Main-207-,,0,0,0,,Sana kalmış.Dialogue: 50,0:07:07.06,0:07:10.37,Main-207-,,0,0,0,,Oraya varınca ne yapacağına karar ver.Dialogue: 50,0:07:10.84,0:07:13.62,Main-207-,,0,0,0,,Ama ne demek istiyorsunuz?Dialogue: 50,0:07:14.07,0:07:16.58,Main-207-,,0,0,0,,Kendi adalet anlayışını takip et.Dialogue: 50,0:07:17.38,0:07:21.13,Main-207-,,0,0,0,,Ne olursa olsun, sorumluluğu üstleneceğim.Dialogue: 50,0:07:22.85,0:07:24.72,Main-207-,,0,0,0,,Albay Smoker, nereye gidiyorsunuz?Dialogue: 50,0:07:24.72,0:07:27.43,Main-207-,,0,0,0,,Acil bir işim var. Denize dönüyorum.Dialogue: 50,0:07:28.18,0:07:30.68,Main-207-,,0,0,0,,Her an çağrımı bekle, Tashigi.Dialogue: 50,0:07:31.20,0:07:31.89,Main-207-,,0,0,0,,Başüstüne.Dialogue: 50,0:07:33.35,0:07:36.35,Main-207-,,0,0,0,,Bu ülkeye ne olduğunu dikkatlice izle.Dialogue: 50,0:07:39.72,0:07:41.86,Main-207-,,0,0,0,,Yok olsun veya olmasın.Dialogue: 50,0:07:41.86,0:07:45.53,Main-207-,,0,0,0,,Yaşananlar, yeni bir çağın kapılarını açacak.Dialogue: 50,0:07:52.49,0:07:55.54,Main-207-,,0,0,0,,Başçavuş... Başçavuş!Dialogue: 50,0:07:55.54,0:07:57.16,Main-207-,,0,0,0,,Emirleriniz nedir?Dialogue: 50,0:07:57.16,0:07:57.75,Main-207-,,0,0,0,,Evet...Dialogue: 50,0:08:00.27,0:08:03.94,Flashbacks-207-,,0,0,0,,Bu ülkeye ne olduğunu dikkatlice izle.Dialogue: 50,0:08:03.94,0:08:06.10,Flashbacks-207-,,0,0,0,,Yok olsun veya olmasın.Dialogue: 50,0:08:06.10,0:08:09.76,Flashbacks-207-,,0,0,0,,Yaşananlar, yeni bir çağın kapılarını açacak.Dialogue: 50,0:08:13.37,0:08:17.47,Main-207-,,0,0,0,,Korsan Hasır Şapkalı Luffy ve tayfasının peşinden gideceğiz.Dialogue: 50,0:08:17.47,0:08:21.73,Main-207-,,0,0,0,,Tüm askerler silahlarını kuşansın! Alubarna'ya gidiyoruz!Dialogue: 50,0:08:21.73,0:08:22.44,Main-207-,,0,0,0,,– Başüstüne! – Başüstüne!Dialogue: 50,0:08:24.45,0:08:26.15,Main-207-,,0,0,0,,Hasır Şapkalı Luffy...Dialogue: 50,0:08:35.41,0:08:40.64,Main-207-,,0,0,0,,Bekle bakalım, Cobra! Alabasta'yı savunacağız!Dialogue: 50,0:08:40.64,0:08:43.01,Main-207-,,0,0,0,,Artık senin gibiler başımızda olmayacak!Dialogue: 50,0:08:52.34,0:08:55.48,Main-207-,,0,0,0,,Topu güney girişine yerleştirin! Oyalanmayın! Çabuk!Dialogue: 50,0:08:55.48,0:08:57.85,Main-207-,,0,0,0,,Daha fazla gülle getirin!Dialogue: 50,0:09:01.65,0:09:02.77,Main-207-,,0,0,0,,Chaka-sama!Dialogue: 50,0:09:03.91,0:09:07.03,Main-207-,,0,0,0,,Düşmanın sayısı 2 milyonun üzerinde.Dialogue: 50,0:09:08.24,0:09:12.65,Main-207-,,0,0,0,,Kralın Nanohana'ya saldırısı hakkında ne düşünüyorsun?Dialogue: 50,0:09:12.65,0:09:16.52,Main-207-,,0,0,0,,10 yıldır majestelerine hizmet ediyorum. Bilemiyorum...Dialogue: 50,0:09:16.52,0:09:19.46,Main-207-,,0,0,0,,Evet. Kimse buna inanamaz.Dialogue: 50,0:09:20.24,0:09:23.42,Main-207-,,0,0,0,,Majestelerinin başına kötü bir şey gelmiş olmalı!Dialogue: 50,0:09:25.04,0:09:29.76,Main-207-,,0,0,0,,Bu yüzden, bu savaşı kaybetmememiz daha da önemli.Dialogue: 50,0:09:29.76,0:09:31.68,Main-207-,,0,0,0,,Düşmanın sayısından korkmayın.Dialogue: 50,0:09:31.68,0:09:35.60,Main-207-,,0,0,0,,Kral uğruna! Ve geri dönen Vivi-sama'mız için!Dialogue: 50,0:09:36.10,0:09:38.56,Main-207-,,0,0,0,,Sonuna dek bu ülkeyi koruyacağız!Dialogue: 50,0:09:39.48,0:09:42.85,Main-207-,,0,0,0,,Savaşa bulaşmamış olanlar şehri terk etsin!Dialogue: 50,0:09:42.85,0:09:45.40,Main-207-,,0,0,0,,Kalanların hayatlarını garanti edemeyiz!Dialogue: 50,0:09:45.40,0:09:49.40,Main-207-,,0,0,0,,Kaçın! Savaşın içine sürükleneceğiz!Dialogue: 50,0:09:51.31,0:09:54.37,Main-207-,,0,0,0,,Nihayet işler kızışmaya başladı, ha?Dialogue: 50,0:09:54.85,0:09:56.66,Main-207-,,0,0,0,,İsyanı hızlandırın, tamam mı?Dialogue: 50,0:09:56.66,0:09:58.58,Main-207-,,0,0,0,,İşler çok yavaş, dayanamıyorum.Dialogue: 50,0:10:04.49,0:10:07.42,Main-207-,,0,0,0,,Kral ya da her ne ise umurumda değil,Dialogue: 50,0:10:07.42,0:10:10.58,Main-207-,,0,0,0,,ona bakıcılık yapmaktan gına geldi!Dialogue: 50,0:10:10.58,0:10:13.63,Main-207-,,0,0,0,,Gına geldi! Gına, gına, lanet olsun!Dialogue: 50,0:10:15.76,0:10:18.39,Main-207-,,0,0,0,,Elbette saray muhafızlarını geçip...Dialogue: 50,0:10:18.39,0:10:22.86,Main-207-,,0,0,0,,bu adamı kaçırmak, sadece bizim yapabileceğimiz bir şeydi.Dialogue: 50,0:10:22.86,0:10:25.74,Main-207-,,0,0,0,,Ama iş artık bittiğine göre, bundan sıkıcı ne olabilir ki!Dialogue: 50,0:10:25.74,0:10:27.40,Main-207-,,0,0,0,,Değil mi, Bay 4?Dialogue: 50,0:10:28.10,0:10:29.27,Main-207-,,0,0,0,,Dinliyor musun?!Dialogue: 50,0:10:29.27,0:10:32.02,Main-207-,,0,0,0,,Hep çok yavaş tepki veriyorsun, öf be.Dialogue: 50,0:10:33.36,0:10:34.95,Main-207-,,0,0,0,,Ah, sırtım ağırıyor! Sırtım!Dialogue: 50,0:10:34.95,0:10:37.32,Thoughts-207-,,0,0,0,,Chaka... Koza...Dialogue: 50,0:10:37.76,0:10:42.26,Thoughts-207-,,0,0,0,,Çatışmayı durdurmalısınız. Bu ülkeyi oluşturanlar sizsiniz.Dialogue: 50,0:10:42.26,0:10:44.28,Thoughts-207-,,0,0,0,,Birbirinizi yok etmemelisiniz!Dialogue: 50,0:10:46.80,0:10:48.96,Narrator-207-,,0,0,0,,Savaşın acısını çekenlerin...Dialogue: 50,0:10:55.29,0:10:57.30,Narrator-207-,,0,0,0,,Savaşanların...Dialogue: 50,0:11:04.48,0:11:06.30,Main-207-,,0,0,0,,Hadi, kaçın!Dialogue: 50,0:11:08.42,0:11:10.74,Narrator-207-,,0,0,8,,Savaşı körükleyenlerin...Dialogue: 50,0:11:13.74,0:11:17.00,Narrator-207-,,0,0,8,,Ve gerçeği bilip,  savaşı engellemeye çalışanların....Dialogue: 50,0:11:22.68,0:11:25.06,Narrator-207-,,0,0,8,,Her birinin umudu...Dialogue: 50,0:11:25.06,0:11:28.17,Narrator-207-,,0,0,8,,Başkent Alubarna'da çarpışacak!Dialogue: 50,0:11:31.59,0:11:34.51,Main-207-,,0,0,0,,Ne?! Bu yengeçle nehri geçemez miyiz?!Dialogue: 50,0:11:34.51,0:11:38.77,Main-207-,,0,0,0,,Taşıyıcı yengeçler çölde yaşar, suya dayanamazlar.Dialogue: 50,0:11:38.77,0:11:43.48,Main-207-,,0,0,0,,Ama o bir yengeç! Yengeç! Istakoz değil, değil mi?! Bir şey yap!Dialogue: 50,0:11:44.23,0:11:46.61,Main-207-,,0,0,0,,Hey, bu çok kötü! Başımız dertte!Dialogue: 50,0:11:46.61,0:11:47.44,Main-207-,,0,0,0,,Şuna bakın!Dialogue: 50,0:11:48.02,0:11:50.90,Main-207-,,0,0,0,,Bu nehir, deniz kadar geniş! Yüzerek geçsek bile...Dialogue: 50,0:11:50.90,0:11:53.14,Main-207-,,0,0,0,,asla zamanında varamayız! Bakın!Dialogue: 50,0:11:53.14,0:11:56.58,Main-207-,,0,0,0,,Nehirden sonra çölde kilometrelerce yürümek zorundayız!Dialogue: 50,0:11:56.58,0:11:58.82,Main-207-,,0,0,0,,Bu yengeç diğer kıyıya geçemezse,Dialogue: 50,0:11:58.82,0:12:00.74,Main-207-,,0,0,0,,yolun kalanını koşacak mıyız?!Dialogue: 50,0:12:00.74,0:12:01.66,Main-207-,,0,0,0,,Başka seçenek yok.Dialogue: 50,0:12:01.66,0:12:03.49,Main-207-,,0,0,0,,Asla başaramayacağız!Dialogue: 50,0:12:03.49,0:12:05.96,Main-207-,,0,0,0,,Mümkün değil!Dialogue: 50,0:12:12.80,0:12:15.17,Main-207-,,0,0,0,,Eyvah! Hey, nehir orada!Dialogue: 50,0:12:15.17,0:12:17.63,Main-207-,,0,0,0,,Sandora nehrini görüyorum!Dialogue: 50,0:12:16.98,0:12:17.63,Secondary-207-,,0,0,0,,Ne?Dialogue: 50,0:12:17.63,0:12:20.01,Main-207-,,0,0,0,,Lütfen bir şey yap, Kıskaç-kun~!Dialogue: 50,0:12:20.39,0:12:23.10,Main-207-,,0,0,0,,Doğru ya! Kıskaç, dans eden kızları seviyor!Dialogue: 50,0:12:25.80,0:12:26.96,Main-207-,,0,0,0,,Bu şekilde mi?Dialogue: 50,0:12:26.96,0:12:27.94,Main-207-,,0,0,0,,Büyük ihtimalle.Dialogue: 50,0:12:27.94,0:12:29.14,Main-207-,,0,0,0,,Vay anasını!Dialogue: 50,0:12:31.64,0:12:33.57,Main-207-,,0,0,0,,Ah, bu tarafa bakıyor!Dialogue: 50,0:12:36.01,0:12:37.38,Main-207-,,0,0,0,,Hızlandı!Dialogue: 50,0:12:37.38,0:12:40.04,Main-207-,,0,0,0,,Nami-swan!Dialogue: 50,0:12:43.68,0:12:45.78,Main-207-,,0,0,0,,Yine aptallığınla iki hayvanı mahvettin!Dialogue: 50,0:12:45.78,0:12:48.21,Main-207-,,0,0,0,,İşte, sapık güç!Dialogue: 50,0:12:49.42,0:12:53.17,Main-207-,,0,0,0,,Peki, bu nasıl bize yardımcı oluyor? Chopper!Dialogue: 50,0:12:59.51,0:13:00.63,Main-207-,,0,0,0,,Hadi!Dialogue: 50,0:13:03.60,0:13:04.84,Main-207-,,0,0,0,,Başardı!Dialogue: 50,0:13:06.02,0:13:09.56,Main-207-,,0,0,0,,Hey, hey, bu yengeç harika! İnanılmaz!Dialogue: 50,0:13:09.56,0:13:11.31,Main-207-,,0,0,0,,Oha, aferin!Dialogue: 50,0:13:11.31,0:13:14.32,Main-207-,,0,0,0,,Bu bir mucize! Sadece suyun üzerinde kal ve ilerle!Dialogue: 50,0:13:14.32,0:13:17.53,Main-207-,,0,0,0,,Koş, koş, bütün yolu koş! Hadi!Dialogue: 50,0:13:17.53,0:13:21.70,Main-207-,,0,0,0,,Yapabilirsin! Devam et! Başarabilirsin! Bu yengeç yapabilir!Dialogue: 50,0:13:21.70,0:13:24.77,Main-207-,,0,0,0,,Hey, bu da ne?! Hayal mi görüyorum? Yoksa batıyor muyuz?Dialogue: 50,0:13:24.77,0:13:26.44,Main-207-,,0,0,0,,Batıyoruz!Dialogue: 50,0:13:30.86,0:13:32.37,Main-207-,,0,0,0,,Batmasana, aptal yengeç!Dialogue: 50,0:13:32.37,0:13:36.00,Main-207-,,0,0,0,,Bağırıp çağıracak vaktimiz yok. İlerle.Dialogue: 50,0:13:36.00,0:13:38.30,Main-207-,,0,0,0,,D-Durun biraz.Dialogue: 50,0:13:38.30,0:13:41.97,Main-207-,,0,0,0,,Burada tekne yok mu? Diğer kıyı ne kadar uzakta?Dialogue: 50,0:13:41.97,0:13:43.34,Main-207-,,0,0,0,,50 kilometre kadar.Dialogue: 50,0:13:43.34,0:13:44.30,Main-207-,,0,0,0,,O kadar yüzemeyiz!Dialogue: 50,0:13:46.56,0:13:48.39,Main-207-,,0,0,0,,Teşekkür ederim!Dialogue: 50,0:13:48.39,0:13:50.56,Main-207-,,0,0,0,,Teşekkür ederim, Kıskaç!Dialogue: 50,0:13:50.56,0:13:53.40,Main-207-,,0,0,0,,Mutlu bir şekilde vedalaşmanın zamanı değil!Dialogue: 50,0:13:56.35,0:13:57.94,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:14:00.07,0:14:03.49,Main-207-,,0,0,0,,Ender rastlanan Sandora Kedi Balığı! Gerçekten görmesi zordur!Dialogue: 50,0:14:03.49,0:14:05.81,Main-207-,,0,0,0,,Bunu açıklamana gerek yoktu!Dialogue: 50,0:14:06.88,0:14:08.99,Main-207-,,0,0,0,,Ve sevdiği yiyecek insanlardır!Dialogue: 50,0:14:08.99,0:14:11.33,Main-207-,,0,0,0,,Önce bunu söylemeliydin!Dialogue: 50,0:14:20.46,0:14:22.70,Main-207-,,0,0,0,,Hey, bırak! Göremiyorum!Dialogue: 50,0:14:22.70,0:14:24.47,Main-207-,,0,0,0,,Chopper, bırak!Dialogue: 50,0:14:33.09,0:14:34.81,Main-207-,,0,0,0,,Kung fu dugonglar?!Dialogue: 50,0:14:34.81,0:14:34.85,Main-207-,,0,0,0,,Kung fu dugonglar?!Dialogue: 50,0:14:34.85,0:14:34.89,Main-207-,,0,0,0,,Kung fu dugonglar?!Dialogue: 50,0:14:34.89,0:14:34.93,Main-207-,,0,0,0,,Kung fu dugonglar?!Dialogue: 50,0:14:34.93,0:14:34.97,Main-207-,,0,0,0,,Kung fu dugonglar?!Dialogue: 50,0:14:35.97,0:14:38.37,Main-207-,,0,0,0,,"Ustamızın öğrencilerini terk etmeyiz." dediler.Dialogue: 50,0:14:38.37,0:14:41.58,Main-207-,,0,0,0,,Şey... Luffy'nin öğrencileri değiliz ki.Dialogue: 50,0:14:41.58,0:14:43.71,Main-207-,,0,0,0,,Ama şimdi güvendeyiz!Dialogue: 50,0:14:43.71,0:14:46.99,Main-207-,,0,0,0,,Tamam, yolumuz azaldı! Dayanın!Dialogue: 51,0:14:46.55,0:14:48.16,Main-207-,,0,0,0,,Teşekkür ederim!Dialogue: 50,0:14:48.16,0:14:50.39,Main-207-,,0,0,0,,Bay bay!Dialogue: 50,0:14:52.66,0:14:55.12,Main-207-,,0,0,0,,İyi ilerledik. Zamanında varacak mıyız?Dialogue: 50,0:14:55.12,0:14:56.61,Main-207-,,0,0,0,,Söylemesi zor.Dialogue: 50,0:14:56.61,0:14:59.33,Main-207-,,0,0,0,,Kirpik-kun'a binsek bile geç kalırız.Dialogue: 50,0:14:59.33,0:15:02.74,Main-207-,,0,0,0,,Ve o sadece... iki kişiyi taşıyabilir!Dialogue: 50,0:15:02.74,0:15:06.39,Main-207-,,0,0,0,,Baroque Works bize saldıracaksa, şehre yakın yerde yapacaklardır.Dialogue: 50,0:15:06.39,0:15:09.30,Main-207-,,0,0,0,,Oraya hepimizi birlikte ulaştırmanın bir yolu yok mu?Dialogue: 50,0:15:17.44,0:15:19.30,Main-207-,,0,0,0,,Bakın! Orada!Dialogue: 50,0:15:19.30,0:15:22.73,Main-207-,,0,0,0,,Ne o, düşman mı?! N-N-Ne yaptığımızı çoktan öğrenmişler mi?!Dialogue: 50,0:15:25.03,0:15:26.74,Main-207-,,0,0,0,,H-Hayır! O...!Dialogue: 50,0:15:27.98,0:15:29.64,Main-207-,,0,0,5,,Karoo!Dialogue: 50,0:15:30.65,0:15:33.55,Main-207-,,0,0,5,,Ve Süpersonik Ördek Timi!Dialogue: 50,0:15:35.31,0:15:36.91,Main-207-,,0,0,0,,Bizi almaya geldiniz!Dialogue: 50,0:15:38.20,0:15:39.38,Main-207-,,0,0,0,,Karoo!Dialogue: 50,0:16:01.27,0:16:05.32,Main-207-,,0,0,0,,Et!Dialogue: 50,0:16:12.36,0:16:18.12,Flashbacks-207-,,0,0,0,,Sen ve ben, aynı sınıf korsan değiliz!Dialogue: 50,0:16:18.12,0:16:20.06,Flashbacks-207-,,0,0,0,,Yuba, ölecek.Dialogue: 50,0:16:20.06,0:16:24.61,Flashbacks-207-,,0,0,0,,Ve İsyan Ordusu'nun öfke alevleri daha da tutuşacak.Dialogue: 50,0:17:14.29,0:17:17.18,Main-207-,,0,0,0,,Teşekkür... ederim...Dialogue: 50,0:17:22.34,0:17:23.73,Main-207-,,0,0,0,,Niye dövüşüyorsunuz?Dialogue: 50,0:17:29.49,0:17:31.70,Main-207-,,0,0,0,,Siz D. adını taşıyanlar?Dialogue: 50,0:17:33.87,0:17:35.52,Main-207-,,0,0,0,,"D" mi?Dialogue: 50,0:17:37.19,0:17:39.71,Thoughts-207-,,0,0,0,,Kimsiniz siz?Dialogue: 50,0:17:42.56,0:17:45.11,Main-207-,,0,0,0,,Sanırım sormam vakit kaybı, ha?Dialogue: 50,0:17:51.23,0:17:52.38,Main-207-,,0,0,0,,Seni buldum!Dialogue: 50,0:17:58.04,0:17:59.52,Main-207-,,0,0,0,,Vivi-sama nerede?!Dialogue: 50,0:18:00.02,0:18:01.13,Main-207-,,0,0,0,,Ah.Dialogue: 50,0:18:02.14,0:18:03.73,Main-207-,,0,0,0,,Hemen uyandın mı?Dialogue: 50,0:18:04.66,0:18:07.03,Main-207-,,0,0,0,,Yeteneğine şahit oldum.Dialogue: 50,0:18:07.03,0:18:09.28,Main-207-,,0,0,0,,Bir daha tedbirsiz yakalanmayacağım!Dialogue: 50,0:18:11.44,0:18:14.82,Main-207-,,0,0,0,,Kendini fazla zorlama. Epey yaralanmışsın.Dialogue: 50,0:18:20.75,0:18:24.83,Main-207-,,0,0,0,,Ne mükemmel zamanlama. Orada yatan çocuğu kurtarabilirsin.Dialogue: 50,0:18:27.73,0:18:34.26,Main-207-,,0,0,0,,Kıymetli prensesini buraya kadar getiren cesur şövalye odur.Dialogue: 50,0:18:35.09,0:18:38.06,Main-207-,,0,0,0,,Ayrıca prensesinin sağlığı yerinde.Dialogue: 50,0:18:38.06,0:18:40.30,Main-207-,,0,0,12,,Biz konuşurken Alubarna'ya doğru gidiyor.Dialogue: 50,0:18:40.30,0:18:43.73,Main-207-,,0,0,12,,Ama ne olacağını söyleyemem.Dialogue: 50,0:18:43.73,0:18:45.73,Main-207-,,0,0,0,,Şartlar neyse odur.Dialogue: 50,0:18:59.89,0:19:04.89,Thoughts-207-,,0,0,0,,Ben ona denk değilsem, Vivi-sama'yı kim koruyabilir?Dialogue: 50,0:19:09.27,0:19:12.01,Main-207-,,0,0,0,,E-Et...!Dialogue: 50,0:19:13.11,0:19:16.04,Main-207-,,0,0,0,,Demek son savaş başladı?Dialogue: 50,0:19:16.71,0:19:18.05,Main-207-,,0,0,0,,Gemilerini gördüm.Dialogue: 50,0:19:18.40,0:19:22.89,Main-207-,,0,0,0,,Vivi-sama ve o cesur ruhlar, sağ salim gelmiş olmalılar...Dialogue: 50,0:19:22.89,0:19:26.52,Main-207-,,0,0,0,,Acele etmeliyim! Lütfen zamanında yetişebileyim.Dialogue: 50,0:19:27.88,0:19:29.90,Main-207-,,0,0,0,,Hey, sen! İyi misin?Dialogue: 50,0:19:29.90,0:19:31.79,Main-207-,,0,0,0,,Et...!Dialogue: 50,0:19:35.22,0:19:37.10,Main-207-,,0,0,0,,Et...!Dialogue: 50,0:19:37.10,0:19:42.66,Main-207-,,0,0,0,,Et mi? Bu hâldeyken mi? Ne saçmalıyorsun? Dayan biraz.Dialogue: 50,0:19:43.19,0:19:45.19,Main-207-,,0,0,0,,Sana doktor getireceğim.Dialogue: 50,0:19:48.13,0:19:53.63,Main-207-,,0,0,0,,Lanet olası Crocodile... Bunu ona ödeteceğim.Dialogue: 50,0:19:55.90,0:20:00.80,Main-207-,,0,0,0,,Vivi ve kuru ihtiyarla dalga geçti!Dialogue: 50,0:20:01.36,0:20:03.77,Main-207-,,0,0,0,,Bunu ona ödeteceğim!Dialogue: 50,0:20:05.78,0:20:08.23,Main-207-,,0,0,0,,Kimsin sen?Dialogue: 50,0:20:09.45,0:20:11.25,Main-207-,,0,0,0,,Et...Dialogue: 50,0:20:32.54,0:20:35.26,Main-207-,,0,0,0,,Görüyorum! Hâlâ uzak ama Alubarna orada!Dialogue: 50,0:20:37.15,0:20:40.12,Main-207-,,0,0,0,,Koza, otuz dakikadan az bir sürede orada olacağız!Dialogue: 50,0:20:40.12,0:20:41.26,Main-207-,,0,0,0,,İyi!Dialogue: 50,0:20:41.26,0:20:43.72,Main-207-,,0,0,0,,Alubarna yakında!Dialogue: 50,0:20:43.72,0:20:46.17,Main-207-,,0,0,0,,Cesaretinizi kaybetmeyin!Dialogue: 50,0:20:50.96,0:20:54.86,Main-207-,,0,0,0,,Chaka-sama! İsyan Ordusu, yaklaşık 15 km güneyde göründü!Dialogue: 50,0:20:55.49,0:20:59.01,Main-207-,,0,0,0,,Kısa süre sonra, 2 milyon isyancı Güney Kapısına varacak!Dialogue: 50,0:20:59.01,0:21:02.82,Main-207-,,0,0,0,,Doğu, batı, güney, güneydoğu, güneybatı...Dialogue: 50,0:21:02.82,0:21:04.53,Main-207-,,0,0,0,,Her kapıyı ölümüne savunun!Dialogue: 50,0:21:05.52,0:21:08.52,Main-207-,,0,0,0,,Bu şehre ayak basmalarına izin vermeyin!Dialogue: 50,0:21:08.52,0:21:09.71,Main-207-,,0,0,0,,Başüstüne!Dialogue: 50,0:21:25.14,0:21:29.16,Main-207-,,0,0,0,,Hey, bakın! İsyan Ordusu'nu görebiliyorum!Dialogue: 50,0:21:29.16,0:21:30.98,Main-207-,,0,0,0,,Ne kadar da çoklar!Dialogue: 50,0:21:30.98,0:21:35.04,Main-207-,,0,0,0,,Prenses onları durdurabileceğini düşünüyorsa kuş beyinli olmalı!Dialogue: 50,0:21:35.04,0:21:39.44,Main-207-,,0,0,0,,Ama o kuş beyinli gerçekten gelecek mi?Dialogue: 50,0:21:39.44,0:21:43.23,Main-207-,,0,0,0,,Yoksa gelmeyecek mi?  Gelecek mi? Gelmeyecek mi?Dialogue: 50,0:21:43.23,0:21:44.32,Main-207-,,0,0,0,,Bu çok belirsiz!Dialogue: 50,0:21:44.32,0:21:45.95,Main-207-,,0,0,0,,Hey, hey, hey, hey, hey, hey!Dialogue: 50,0:21:45.95,0:21:48.17,Main-207-,,0,0,0,,Bundan emin miyiz? Emin miyiz?Dialogue: 50,0:21:48.17,0:21:50.92,Main-207-,,0,0,0,,Prenses ve şu korsanlar, gelecekler, değil mi?!Dialogue: 50,0:21:50.92,0:21:53.83,Main-207-,,0,0,0,,Bu gidişle, buraya ilk İsyan Ordusu gelecek!Dialogue: 50,0:21:53.83,0:21:55.92,Main-207-,,0,0,0,,Savaşı durdurmak istemiyorlar mıydı?!Dialogue: 50,0:21:56.44,0:21:59.00,Main-207-,,0,0,0,,Zamanında yetişememe ihtimalleri var.Dialogue: 50,0:21:59.00,0:22:04.17,Secondary-207-,,0,0,0,,İşte... geli... yorlar...Dialogue: 50,0:21:59.75,0:22:04.17,Main-207-,,0,0,0,,Sonuçta Rainbase'de kendilerini büyük bir yenilginin içine soktular.Dialogue: 50,0:22:04.17,0:22:05.39,Main-207-,,0,0,0,,Ne?! Harbi mi?!Dialogue: 50,0:22:06.58,0:22:09.52,Main-207-,,0,0,0,,Ama, ya onlar gelmeden isyan başlarsa?Dialogue: 50,0:22:09.52,0:22:12.14,Main-207-,,0,0,0,,Ne yapacağız?Dialogue: 50,0:22:12.14,0:22:15.12,Main-207-,,0,0,0,,Hiçbir şey yapmak zorunda kalmayacağız.Dialogue: 50,0:22:15.12,0:22:19.82,Main-207-,,0,0,0,,Savaş başlayınca Prenses bile bir şey yapamayacak.Dialogue: 50,0:22:19.82,0:22:23.59,Main-207-,,0,0,0,,Tek yapmamız gereken, öldürmemiz emredilenleri öldürmek.Dialogue: 50,0:22:23.59,0:22:26.51,Main-207-,,0,0,0,,Kafan basmıyor mu?Dialogue: 50,0:22:26.51,0:22:29.72,Main-207-,,0,0,0,,Sana kenpo'mdan tattırmama ne dersin?!Dialogue: 50,0:22:29.72,0:22:31.51,Main-207-,,0,0,0,,Hemen kesin şunu.Dialogue: 50,0:22:31.51,0:22:33.80,Main-207-,,0,0,0,,Ah, sırtım! Sırtım ağrıyor!Dialogue: 50,0:22:33.80,0:22:39.75,Main-207-,,0,0,0,,Ge... li... yor... lar...Dialogue: 50,0:22:33.80,0:22:36.75,Secondary-207-,,0,0,0,,Bay 4, masaj yap!Dialogue: 50,0:22:39.75,0:22:40.76,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:22:41.33,0:22:44.38,Main-207-,,0,0,0,,Niye öyle söylemedin, seni yarım akıllı daruma!Dialogue: 50,0:22:41.33,0:22:44.38,Note-207-,,0,0,0,,Daruma: Yuvarlak Japon BebeğiDialogue: 50,0:22:47.22,0:22:49.19,Main-207-,,0,0,0,,Ördekler...?Dialogue: 50,0:22:50.22,0:22:54.69,Main-207-,,0,0,0,,Ördekler mi? Ne görüyorsunuz, Bayan Merry Christmas?Dialogue: 50,0:22:54.69,0:22:57.98,Main-207-,,0,0,0,,Sayıları biraz fazla değil mi? 6 kişi görüyorum.Dialogue: 50,0:22:57.98,0:23:02.11,Main-207-,,0,0,0,,Hasır Şapka'yı listeden sildikten sonra, 4 kişi kalmış olmaları gerekiyordu.Dialogue: 50,0:23:02.58,0:23:05.02,Main-207-,,0,0,0,,Hayır, Bayan Merry Christmas.Dialogue: 50,0:23:05.02,0:23:09.57,Main-207-,,0,0,0,,Patronu dinlemiyor muydun? Bay Prens onlarla birlikte.Dialogue: 50,0:23:09.57,0:23:13.62,Main-207-,,0,0,0,,Ve yalnız çalışmıyordu, iki kişi daha eklersek sayılar tutuyor.Dialogue: 50,0:23:14.36,0:23:17.29,Main-207-,,0,0,0,,Sayıları önemsiz, hedefimiz sadece Vivi.Dialogue: 50,0:23:18.03,0:23:20.07,Main-207-,,0,0,0,,Ne diye kafanız bu kadar karışık?Dialogue: 50,0:23:20.80,0:23:23.30,Main-207-,,0,0,0,,Bay 1...Dialogue: 50,0:23:23.30,0:23:26.59,Main-207-,,0,0,0,,Sadece Vivi'yi mi yok etmemiz gerekiyor?Dialogue: 50,0:23:27.72,0:23:29.05,Main-207-,,0,0,0,,Öyleyse,Dialogue: 50,0:23:30.46,0:23:33.02,Main-207-,,0,0,0,,hangisinin Vivi olduğunu bana söylesen mi?Dialogue: 50,0:23:34.31,0:23:36.52,Main-207-,,0,0,0,,Hepsi aynı pelerini giyiyor!Dialogue: 50,0:23:38.98,0:23:41.32,Main-207-,,0,0,0,,Ve bindikleri, Alabasta’nın en hızlı kuşları:Dialogue: 50,0:23:41.72,0:23:43.28,Main-207-,,0,0,0,,Dev Lekeli Gagalı Ördekler!Dialogue: 50,0:23:48.27,0:23:50.41,Main-207-,,0,0,0,,Lanet olasıcalar...!Dialogue: 50,0:23:50.41,0:23:53.33,Main-207-,,0,0,0,,Hanginiz Vivi?!Dialogue: 50,0:23:53.33,0:23:55.79,Main-207-,,0,0,0,,Çok belirsiz!Dialogue: 50,0:23:55.79,0:23:58.37,Secondary-207-,,0,0,0,,Çok belirsiz!Dialogue: 50,0:23:58.37,0:24:00.80,Secondary-207-,,0,0,0,,Çok belirsiz!Dialogue: 50,0:24:06.16,0:24:07.93,Main-207-,,0,0,0,,Hakla onları, Bay 4!Dialogue: 50,0:24:12.06,0:24:13.06,Main-207-,,0,0,0,,Kaçının!Dialogue: 50,0:24:16.06,0:24:19.02,Main-207-,,0,0,0,,Atlattılar! O kuşlar çok hızlı, ha?Dialogue: 50,0:24:21.11,0:24:23.86,Main-207-,,0,0,0,,İkisi güneye geçip gitti! Ayrılıyorlar!Dialogue: 50,0:24:23.86,0:24:26.36,Main-207-,,0,0,0,,Bahse varım, güney kapısına gidiyorlardır!Dialogue: 50,0:24:26.78,0:24:29.30,Thoughts-207-,,0,0,0,,Orası İsyan Ordusu'nun gittiği yer.Dialogue: 50,0:24:29.30,0:24:32.08,Thoughts-207-,,0,0,0,,Onlardan biri Vivi olmalı.Dialogue: 50,0:24:32.08,0:24:34.62,Main-207-,,0,0,0,,O ikisini bize bırakın!Dialogue: 50,0:24:35.02,0:24:36.79,Main-207-,,0,0,0,,Kıpırda, Bay 4!Dialogue: 50,0:24:39.04,0:24:42.00,Main-207-,,0,0,0,,Ölümcül Alevli Yıldız!Dialogue: 50,0:24:45.34,0:24:49.43,Main-207-,,0,0,0,,Bay 1, ikisi o tarafa gitti! Biri Vivi olabilir!Dialogue: 50,0:24:50.02,0:24:52.47,Main-207-,,0,0,0,,Batı kapısından girmeyi planlıyorlar.Dialogue: 50,0:24:52.47,0:24:54.60,Main-207-,,0,0,0,,Lanet olsun!Dialogue: 50,0:24:54.60,0:24:56.14,Main-207-,,0,0,0,,Gidelim!Dialogue: 50,0:24:57.77,0:24:59.61,Main-207-,,0,0,0,,Un... deux!Dialogue: 50,0:24:59.61,0:25:02.36,Main-207-,,0,0,0,,Öyleyse biz de güneybatı kapısına gideceğiz!Dialogue: 50,0:25:05.81,0:25:09.89,Main-207-,,0,0,0,,Alubarna'nın beş girişinden üçüne batıdan ulaşabilirler.Dialogue: 50,0:25:10.39,0:25:12.45,Main-207-,,0,0,0,,Planları ayrılıp o girişlere gitmek...Dialogue: 50,0:25:12.45,0:25:14.87,Main-207-,,0,0,0,,Ama fark etmez! Onları içeride yok ederiz!Dialogue: 50,0:25:16.20,0:25:18.50,Main-207-,,0,0,0,,Kaçamayacaksınız!Dialogue: 50,0:25:22.96,0:25:26.32,Main-207-,,0,0,0,,Hey, birileri buraya geliyor! Düşman mı?!Dialogue: 50,0:25:26.32,0:25:27.42,Main-207-,,0,0,0,,Hayır, durun!Dialogue: 50,0:25:27.42,0:25:30.20,Main-207-,,0,0,0,,Onlar Süpersonik Ördek Timi! Bırakın geçsinler!Dialogue: 50,0:25:45.33,0:25:48.71,Main-207-,,0,0,0,,Kaçmanıza izin vermeyeceğim!Dialogue: 50,0:26:04.53,0:26:07.21,Main-207-,,0,0,0,,Bizi buraya kadar takip ettiğin için teşekkürler!Dialogue: 50,0:26:07.21,0:26:08.42,Main-207-,,0,0,0,,Ne?Dialogue: 50,0:26:11.49,0:26:13.26,Main-207-,,0,0,0,,Dur! Dur!Dialogue: 50,0:26:14.82,0:26:18.57,Main-207-,,0,0,0,,Sezgileriniz çok kuvvetli! Evet, ben Prenses Vivi!Dialogue: 50,0:26:18.57,0:26:23.73,Main-207-,,0,0,0,,Sen ne saç— ...b-bahsediyorsun? Gerçek Vivi benim.Dialogue: 50,0:26:26.35,0:26:28.80,Main-207-,,0,0,0,,Bu kadarı yeterli olmalı.Dialogue: 50,0:26:33.22,0:26:36.87,Main-207-,,0,0,0,,Bu kadar kolay kanmış olmanız komik.Dialogue: 50,0:26:37.41,0:26:38.20,Main-207-,,0,0,0,,Hadi...Dialogue: 50,0:26:39.08,0:26:41.71,Main-207-,,0,0,0,,onlara kim olduğumuzu gösterelim.Dialogue: 50,0:26:42.96,0:26:45.88,Main-207-,,0,0,0,,– Çok kötü, yanıldınız! – Çok kötü, yanıldınız!Dialogue: 50,0:26:49.86,0:26:52.22,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:26:57.87,0:26:59.93,Thoughts-207-,,0,0,0,,Hepinize teşekkür ederim.Dialogue: 50,0:27:02.42,0:27:06.52,Main-207-,,0,0,0,,Acele etmeliyim. İsyan Ordusu, neredeyse gelmek üzere!Dialogue: 50,0:27:07.39,0:27:08.82,Main-207-,,0,0,0,,Gidelim, Karoo!Dialogue: 50,0:27:10.53,0:27:12.19,Main-207-,,0,0,0,,Deve mi?!Dialogue: 50,0:27:12.19,0:27:15.45,Main-207-,,0,0,0,,Ve seni hatırlıyorum!Dialogue: 50,0:27:15.45,0:27:17.16,Main-207-,,0,0,0,,Ü-Üzgünüm!Dialogue: 50,0:27:17.16,0:27:19.16,Main-207-,,0,0,0,,Hadi, Zoro! Hakla onları!Dialogue: 50,0:27:19.16,0:27:21.35,Main-207-,,0,0,0,,Kapa' çeneni!Dialogue: 50,0:27:21.35,0:27:23.12,Main-207-,,0,0,0,,Bizi oyuna getirdiler.Dialogue: 50,0:27:21.35,0:27:23.12,Secondary-207-,,0,0,0,,Borcunu hatırlatmam mı gerek?Dialogue: 50,0:27:23.12,0:27:25.33,Main-207-,,0,0,0,,Tam bir komedi, ha?Dialogue: 50,0:27:23.12,0:27:25.33,Secondary-207-,,0,0,0,,O borcu zaten affetmiştin!Dialogue: 50,0:27:26.83,0:27:29.46,Main-207-,,0,0,0,,İsyan sona erecek.Dialogue: 50,0:27:29.46,0:27:31.05,Main-207-,,0,0,0,,Ne dedin sen?!Dialogue: 50,0:27:34.30,0:27:35.93,Thoughts-207-,,0,0,0,,Onları mutlaka durduracağım!Dialogue: 50,0:27:35.93,0:27:39.38,Thoughts-207-,,0,0,0,,Eğer durduramazsam, tüm emeklerimiz boşa gidecek!Dialogue: 50,0:27:41.94,0:27:47.29,Flashbacks-207-,,0,0,0,,Vivi ve Koza, asla karşılaşmamalı!Dialogue: 50,0:27:54.06,0:27:57.30,Main-207-,,0,0,0,,Gülleleri kontrol altına alın! Düşüp yuvarlanmasınlar!Dialogue: 50,0:27:57.30,0:27:59.50,Main-207-,,0,0,0,,Topçular, yerlerinizi koruyun!Dialogue: 50,0:27:59.50,0:28:02.04,Main-207-,,0,0,0,,Güllelerinize sahip çıkın!Dialogue: 50,0:28:02.79,0:28:04.79,Main-207-,,0,0,0,,Yer sallanıyor...Dialogue: 50,0:28:04.79,0:28:07.79,Main-207-,,0,0,0,,2 milyon öfkeli düşmanla karşı karşıyayız.Dialogue: 50,0:28:07.79,0:28:11.25,Main-207-,,0,0,0,,Yer bile gelişlerinden titriyor. Cesaretinizi kaybetmeyin!Dialogue: 50,0:28:22.46,0:28:25.50,Main-207-,,0,0,0,,Sorun yok, Karoo. Benimle kalmak zorunda değilsin.Dialogue: 50,0:28:28.52,0:28:30.73,Main-207-,,0,0,0,,Ezilirsen beni suçlama.Dialogue: 50,0:28:42.63,0:28:47.37,Thoughts-207-,,0,0,0,,Lütfen, Lider, söyleyeceklerimi dinle.Dialogue: 50,0:28:53.38,0:28:57.63,Main-207-,,0,0,0,,Tüm birlikler, bir arada kalın! Güney kapısından gireceğiz!Dialogue: 50,0:28:57.63,0:29:00.55,Main-207-,,0,0,0,,Diğer kapıları içeriden yok edeceğiz!Dialogue: 50,0:29:00.55,0:29:02.84,Main-207-,,0,0,0,,Kararlı olun!Dialogue: 50,0:29:11.52,0:29:13.69,Main-207-,,0,0,0,,İsyan Ordusu, durun!Dialogue: 50,0:29:13.69,0:29:16.44,Main-207-,,0,0,0,,Bu savaş bir tuzak!Dialogue: 50,0:29:19.45,0:29:21.86,Main-207-,,0,0,0,,Lütfen, söyleyeceklerimi dinleyin!Dialogue: 50,0:29:27.29,0:29:29.16,Main-207-,,0,0,0,,İsyan Ordusu! Dur–Dialogue: 50,0:29:34.61,0:29:37.85,Main-207-,,0,0,0,,Hey! Orada duran birini gördün mü?!Dialogue: 50,0:29:37.85,0:29:39.42,Main-207-,,0,0,0,,Birini mi?! Saçmalama!Dialogue: 50,0:29:39.42,0:29:42.62,Main-207-,,0,0,0,,Dikkatini ver, bize ateş etmeye başladılar!Dialogue: 50,0:29:46.46,0:29:50.52,Main-207-,,0,0,0,,Niye...? Artık beni göremezler!Dialogue: 50,0:29:53.00,0:29:56.48,Main-207-,,0,0,0,,Nasıl bu kadar aptalca bir şey yapabildin, Kraliyet Ordusu?!Dialogue: 50,0:29:56.77,0:30:00.45,Main-207-,,0,0,0,,Seni ahmak! Ateş etme emri vermedim!Dialogue: 50,0:30:00.45,0:30:03.12,Main-207-,,0,0,0,,Kafana göre hareket etme!Dialogue: 50,0:30:03.12,0:30:08.25,Main-207-,,0,0,0,,Ö-Özür dilerim. Elim kaydı... dikkatsizdim.Dialogue: 50,0:30:27.98,0:30:31.23,Main-207-,,0,0,0,,Durmayın, içinden geçin! Sadece bir kum bulutu!Dialogue: 50,0:30:32.29,0:30:34.73,Main-207-,,0,0,0,,Hayır, millet! Durun!Dialogue: 50,0:30:35.71,0:30:39.19,Main-207-,,0,0,0,,Ülkemiz için! Krala bedelini ödetin!Dialogue: 50,0:30:39.19,0:30:40.28,Main-207-,,0,0,0,,Lider!Dialogue: 50,0:30:50.37,0:30:52.12,Main-207-,,0,0,0,,Lider!Dialogue: 50,0:30:59.58,0:31:00.76,Main-207-,,0,0,0,,Sorun nedir, Koza?Dialogue: 50,0:31:02.25,0:31:04.43,Main-207-,,0,0,0,,Yok bir şey.Dialogue: 50,0:31:06.16,0:31:07.68,Thoughts-207-,,0,0,0,,Bana mı öyle geldi?Dialogue: 50,0:31:21.56,0:31:22.87,Thoughts-207-,,0,0,0,,Lider!Dialogue: 50,0:31:24.86,0:31:27.82,Main-207-,,0,0,0,,Unutmayın, bu bizim son savaşımız!Dialogue: 50,0:31:30.33,0:31:32.29,Main-207-,,0,0,0,,Durun! Beni dinleyin!Dialogue: 50,0:31:34.75,0:31:36.71,Main-207-,,0,0,0,,Lider!Dialogue: 50,0:31:53.72,0:31:55.73,Main-207-,,0,0,0,,İşte geliyorlar!Dialogue: 50,0:31:55.73,0:31:58.39,Main-207-,,0,0,0,,Topları hazırlayın!Dialogue: 50,0:32:24.60,0:32:28.38,Main-207-,,0,0,0,,Alubarna'yı dize getirin!Dialogue: 50,0:33:00.89,0:33:01.88,Main-207-,,0,0,0,,Karoo...Dialogue: 50,0:33:05.59,0:33:08.22,Main-207-,,0,0,0,,Beni korudun.Dialogue: 50,0:33:11.39,0:33:18.91,Main-207-,,0,0,0,,Çok üzgünüm. Elimizden geleni yaptık ama isyan başladı.Dialogue: 50,0:33:18.91,0:33:20.85,Main-207-,,0,0,0,,Çok üzgünüm...Dialogue: 50,0:33:22.05,0:33:24.35,Main-207-,,0,0,0,,Ama yine de onları durduracağım!Dialogue: 50,0:33:24.35,0:33:26.41,Main-207-,,0,0,0,,Kaç kez olursa olsun, deneyeceğim!Dialogue: 50,0:33:26.41,0:33:30.66,Main-207-,,0,0,0,,Emeklerimizin boşa gitmesine izin veremem.Dialogue: 50,0:33:30.66,0:33:34.90,Main-207-,,0,0,0,,O gemide... bunu öğrendim—Dialogue: 50,0:33:36.19,0:33:38.30,Main-207-,,0,0,0,,Asla vazgeçmeyeceğim!Dialogue: 50,0:33:40.70,0:33:41.79,Main-207-,,0,0,0,,Vivi!Dialogue: 50,0:33:43.71,0:33:45.31,Main-207-,,0,0,0,,Demek buradaydın!Dialogue: 50,0:33:45.31,0:33:46.75,Main-207-,,0,0,0,,Usopp-san!Dialogue: 50,0:33:46.75,0:33:49.97,Main-207-,,0,0,0,,Hâlâ başarabilirsin! Çabuk bin!Dialogue: 50,0:33:49.97,0:33:52.18,Main-207-,,0,0,0,,Tamam! Ama, Karoo...Dialogue: 50,0:33:52.18,0:33:54.18,Main-207-,,0,0,0,,O kuşun işi bitti!Dialogue: 50,0:33:56.37,0:34:00.76,Main-207-,,0,0,0,,Acele etmezsek, isyan daha da kötüleşecek! Hadi!Dialogue: 50,0:34:03.10,0:34:06.11,Thoughts-207-,,0,0,0,,O... kuş mu...?Dialogue: 50,0:34:09.53,0:34:11.70,Flashbacks-207-,,0,0,0,,Gidelim, Karoo!Dialogue: 50,0:34:15.99,0:34:19.33,Main-207-,,0,0,0,,Sorun nedir? Çabuk bin!Dialogue: 50,0:34:21.79,0:34:24.76,Main-207-,,0,0,0,,Usopp-san, kendini kanıtla.Dialogue: 50,0:34:27.11,0:34:30.38,Main-207-,,0,0,0,,Oh, benden şüpheleniyor musun?Dialogue: 50,0:34:31.51,0:34:32.34,Main-207-,,0,0,0,,Gördün mü?Dialogue: 50,0:34:32.34,0:34:33.62,Thoughts-207-,,0,0,0,,O değil!Dialogue: 50,0:34:35.30,0:34:38.41,Main-207-,,0,0,0,,Usopp! Hey, Usopp!Dialogue: 50,0:34:38.41,0:34:40.27,Main-207-,,0,0,0,,Kirpik, kalk!Dialogue: 50,0:34:41.14,0:34:44.97,Main-207-,,0,0,0,,Ah, Sanji. Günaydın.Dialogue: 50,0:34:43.89,0:34:44.97,Secondary-207-,,0,0,0,,Günaydın.Dialogue: 50,0:34:44.97,0:34:47.78,Main-207-,,0,0,0,,Ah, o adama karşı olan dövüşüm mü?Dialogue: 50,0:34:47.78,0:34:51.31,Main-207-,,0,0,0,,Planın yem bölümü mükemmel bir başarıydı.Dialogue: 50,0:34:51.31,0:34:52.28,Main-207-,,0,0,0,,Ama sonra...Dialogue: 50,0:34:52.28,0:34:56.28,Main-207-,,0,0,0,,iki saniyede bitti. Her birimiz için bir saniye.Dialogue: 50,0:34:56.28,0:34:58.20,Main-207-,,0,0,0,,Hiç denedin mi peki?!Dialogue: 50,0:35:00.37,0:35:02.12,Main-207-,,0,0,0,,Ama Sanji, burada ne yapıyorsun?Dialogue: 50,0:35:02.12,0:35:05.92,Main-207-,,0,0,0,,Ördeğin yardım etmem için beni çağırdı! Her neyse...Dialogue: 50,0:35:04.95,0:35:05.92,Secondary-207-,,0,0,0,,Anladım.Dialogue: 50,0:35:06.71,0:35:08.86,Main-207-,,0,0,0,,Bay 2'yi kaçırdın, değil mi?Dialogue: 50,0:35:08.86,0:35:09.88,Main-207-,,0,0,0,,Evet.Dialogue: 50,0:35:15.05,0:35:19.36,Flashbacks-207-,,0,0,0,,Dinleyin, o ucube herifin dönüşümleri kusursuz.Dialogue: 50,0:35:19.36,0:35:24.10,Flashbacks-207-,,0,0,0,,İçimizden birini taklit edip Vivi'nin peşinden gitmeye çalışabilir.Dialogue: 50,0:35:24.10,0:35:27.06,Flashbacks-207-,,0,0,0,,Herhangi biri şüpheli davranıyorsa,Dialogue: 50,0:35:30.02,0:35:32.53,Flashbacks-207-,,0,0,0,,bandajını çıkarın ve işaretlerini doğrulayın.Dialogue: 50,0:35:32.53,0:35:34.53,Flashbacks-207-,,0,0,0,,Bunu yapamazsa, sahtekârdır.Dialogue: 50,0:35:35.04,0:35:40.20,Flashbacks-207-,,0,0,0,,Vay, böylesine önlem almak pek akıllıca olmuş senin için.Dialogue: 50,0:35:40.73,0:35:43.45,Flashbacks-207-,,0,0,0,,Belki de o ucubesin.Dialogue: 50,0:35:43.45,0:35:44.83,Flashbacks-207-,,0,0,0,,Seni doğrayacağım!Dialogue: 50,0:35:44.83,0:35:46.35,Flashbacks-207-,,0,0,0,,Hayır, o Zoro.Dialogue: 50,0:35:46.35,0:35:48.42,Flashbacks-207-,,0,0,0,,Oh be... Zoro'ymuş.Dialogue: 50,0:35:54.63,0:35:57.84,Main-207-,,0,0,0,,Sen... Usopp-san değilsin!Dialogue: 50,0:36:00.03,0:36:01.81,Main-207-,,0,0,0,,Ah, canım...Dialogue: 50,0:36:03.31,0:36:06.77,Main-207-,,0,0,0,,Acaba nasıl anladın?Dialogue: 50,0:36:06.77,0:36:09.40,Main-207-,,0,0,0,,Mükemmel olduğunu düşünmüştüm.Dialogue: 50,0:36:10.53,0:36:13.72,Main-207-,,0,0,0,,Hepinizin aynı bandaja sahip olduğunuza dair...Dialogue: 50,0:36:13.72,0:36:17.20,Main-207-,,0,0,0,,Sıfır-chan'dan bir rapor aldık.Dialogue: 50,0:36:18.88,0:36:21.20,Main-207-,,0,0,0,,Bu çok kötü.Dialogue: 50,0:36:21.73,0:36:23.96,Main-207-,,0,0,0,,Vivi-chan tehlikede!Dialogue: 0,0:01:50.01,0:01:53.68,Title-207-,,0,0,0,,Alubarna'daki HesaplaşmaDialogue: 1,0:01:50.01,0:01:53.68,Title-207-,,0,0,0,,Alubarna'daki HesaplaşmaDialogue: 0,0:04:05.48,0:04:10.27,Captions-207-,,0,0,0,,Yuba Eski İsyancı ÜssüDialogue: 1,0:04:05.48,0:04:10.27,Captions-207-,,0,0,0,,Yuba Eski İsyancı ÜssüDialogue: 0,0:08:47.42,0:08:52.34,Captions-207-,,0,0,0,,Başkent, AlubarnaDialogue: 0,0:15:29.03,0:15:34.12,Captions-207-,,0,0,0,,Timin Lideri Karoo Süpersonik Ördek Timi (Alabasta'nın En Hızlı Birliği)Dialogue: 1,0:15:29.03,0:15:34.12,Captions-207-,,0,0,0,,Timin Lideri Karoo Süpersonik Ördek Timi (Alabasta'nın En Hızlı Birliği)Dialogue: 0,0:18:38.10,0:18:42.27,Captions-207-,,0,0,0,,Hız Timsahı Alabasta'daki 2. En Hızlı HayvanDialogue: 1,0:18:38.10,0:18:42.27,Captions-207-,,0,0,0,,Hız Timsahı Alabasta'daki 2. En Hızlı HayvanDialogue: 0,0:19:12.71,0:19:17.30,Captions-207-,,0,0,0,,Liman Şehri, NanohanaDialogue: 0,0:21:20.51,0:21:26.52,Captions-207-,,0,0,0,,Batı Kapısı, AlubarnaDialogue: 1,0:21:20.51,0:21:26.52,Captions-207-,,0,0,0,,Batı Kapısı, AlubarnaDialogue: 2,0:21:20.51,0:21:26.52,Captions-207-,,0,0,0,,Batı Kapısı, AlubarnaDialogue: 0,0:11:20.70,0:11:20.74,Captions-207-,,0,0,0,,m 0 0 l 163 0 163 35 0 35 0 0Dialogue: 0,0:11:20.74,0:11:20.78,Captions-207-,,0,0,0,,m 0 0 l 163 0 163 35 0 35 0 0Dialogue: 0,0:11:20.78,0:11:20.83,Captions-207-,,0,0,0,,m 0 0 l 163 0 163 35 0 35 0 0Dialogue: 0,0:11:20.83,0:11:20.87,Captions-207-,,0,0,0,,m 0 0 l 163 0 163 35 0 35 0 0Dialogue: 0,0:11:20.87,0:11:20.91,Captions-207-,,0,0,0,,m 0 0 l 