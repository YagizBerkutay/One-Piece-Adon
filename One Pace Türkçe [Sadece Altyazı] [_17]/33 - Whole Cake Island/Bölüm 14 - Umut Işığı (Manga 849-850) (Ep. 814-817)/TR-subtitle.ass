,100,1,0,1,2.2,0,7,10,10,10,1Style: Author,Impress BT,22.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.7,0.7,9,10,10,10,1Style: Attack,Duality,30.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.0,1.0,7,12,12,12,1Style: Lunch Time,Impress BT,55,&H00FFFFFF,&H000000FF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,1,1.5,2,120,120,18,1Style: Chopper,New Dr. Yoshiabibi,55,&H008783D9,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,90,100,0,0,1,2,0,2,10,10,10,1Style: Carrot,GrilledCheese BTN Toasted,55,&H006EE9F0,&H000000FF,&H00666666,&H00000000,0,0,0,0,90,100,0,0,1,2,0,2,10,10,10,1Style: Brook,Okashi^,55,&H00B20081,&H000000FF,&H00656565,&H00000000,-1,0,0,0,100,100,0,0,1,2,0,2,10,10,10,1Style: Tamago,Gretoon,55,&H007343E6,&H000000FF,&H00FFFFFF,&H00000000,-1,0,0,0,100,100,0,0,1,2,0,2,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:01:46.71,0:01:52.71,Lyrics,,0,0,0,karaoke,♪ Yeşil çay? ♪Dialogue: 0,0:01:46.71,0:01:52.75,Lyrics,,0,0,0,karaoke,♪ Çay ♪Dialogue: 0,0:01:52.75,0:01:55.38,Lyrics,,0,0,0,karaoke,♪ Hangimizi istersiniz? ♪Dialogue: 0,0:07:13.51,0:07:15.22,Chopper,,0,0,0,karaoke,Rumble!Dialogue: 0,0:07:13.51,0:07:15.22,Attack,,0,0,0,karaoke,GümbürtüDialogue: 0,0:07:32.31,0:07:35.89,Carrot,,0,0,0,karaoke,Electrical Luna!Dialogue: 0,0:07:32.31,0:07:35.89,Attack,,0,0,0,karaoke,Elektro AyDialogue: 0,0:11:35.13,0:11:37.89,Brook,,0,0,0,karaoke,Swallow Banderole!Dialogue: 0,0:11:35.13,0:11:37.89,Attack,,0,0,0,karaoke,Kırlangıç BandrolüDialogue: 0,0:26:18.38,0:26:21.22,Tamago,,0,0,0,karaoke,Legs Benedict!Dialogue: 0,0:26:18.38,0:26:21.22,Attack,,0,0,0,karaoke,Çılbır BacakDialogue: 0,0:01:34.44,0:01:37.44,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - dmc3 thx to onepace.netDialogue: 0,0:17:01.80,0:17:07.40,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - dmc3 thx to onepace.netDialogue: 0,0:34:44.50,0:34:50.50,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - dmc3 thx to onepace.netDialogue: 0,0:01:34.44,0:01:39.45,Title,,0,0,0,,Umut IşığıDialogue: 0,0:01:40.69,0:01:41.90,Main,,0,0,0,,Reiju nerede?Dialogue: 0,0:01:41.90,0:01:45.91,Main,,0,0,0,,Bilmem. Demin çekip gitti.Dialogue: 0,0:01:42.41,0:01:46.71,Captions,,0,0,0,,Misafir Odası - Vinsmoke AilesiDialogue: 0,0:01:55.42,0:02:00.89,Main,,0,0,0,,O değil de baba, evlendikten sonra Sanjiler nerede yaşayacak?Dialogue: 0,0:02:00.89,0:02:03.10,Main,,0,0,0,,Germa'da tabii.Dialogue: 0,0:02:03.10,0:02:10.02,Main,,0,0,0,,Kızını rehin olarak elimizde bulundurmazsak ileride ne isteyeceklerine akıl ermez.Dialogue: 0,0:02:10.02,0:02:12.44,Main,,0,0,0,,Neticede korsanlarla iş yapıyoruz.Dialogue: 0,0:02:12.44,0:02:15.81,Main,,0,0,0,,Çaktım köfteyi. Rehine ha?Dialogue: 0,0:02:16.78,0:02:22.53,Main,,0,0,0,,Karşı taraf da n'olur ne olmaz diye Sanji'yi rehin tutmak isterse?Dialogue: 0,0:02:22.53,0:02:24.68,Main,,0,0,0,,Saçma sorular sorma Niji.Dialogue: 0,0:02:25.49,0:02:31.50,Main,,0,0,0,,Öyle olsa bile Sanji'yi öldürmeleri bize koyar mı ki?Dialogue: 0,0:02:32.09,0:02:33.52,Main,,0,0,0,,O da doğru.Dialogue: 0,0:02:35.17,0:02:36.67,Main,,0,0,0,,Mümkün değil!Dialogue: 0,0:02:36.67,0:02:39.28,Main,,0,0,0,,Tekrardan...Dialogue: 0,0:02:39.28,0:02:42.44,Main,,0,0,0,,...Sanji'yle birlikte yaşamayı iple çekiyorum.Dialogue: 0,0:02:44.14,0:02:48.39,Captions,,0,0,0,,"Ayna Dünyası" – Brûlée'nin EviDialogue: 0,0:02:55.85,0:02:58.99,Main,,0,0,0,,Yalvarırım! Yapma!Dialogue: 0,0:03:00.91,0:03:03.95,Main,,0,0,0,,Yemek olmak istemiyorum!Dialogue: 0,0:03:07.09,0:03:10.75,Main,,0,0,0,,Acıktınız ama, değil mi çocuklar?Dialogue: 0,0:03:10.75,0:03:14.63,Main,,0,0,0,,Karnımız zil çalıyor!Dialogue: 0,0:03:16.16,0:03:21.51,Main,,0,0,0,,Açık ara en iyi ziyafetimiz olacak!Dialogue: 0,0:03:22.26,0:03:25.64,Main,,0,0,0,,Yemeyin beni ya!Dialogue: 0,0:03:25.64,0:03:30.17,Main,,0,0,0,,- Çözün lütfen! - Ayak diremeyi kes artık.Dialogue: 0,0:03:40.14,0:03:42.78,Thoughts,,0,0,0,,Brûlée kendi kazdığı kuyuya düştü.Dialogue: 0,0:03:47.41,0:03:48.83,Flashbacks,,0,0,0,,Ne?! N'oluyor  ya?!Dialogue: 0,0:03:57.91,0:04:04.29,Thoughts,,0,0,0,,Benimle birlikte yakaladıkları gerçek Carrot değildi.Dialogue: 0,0:04:04.29,0:04:10.85,Thoughts,,0,0,0,,Brûlée'nin yeteneğiyle Carrot'un aynadaki yansımasına dönüşmüş bir kurbağaydı.Dialogue: 0,0:04:12.96,0:04:15.31,Thoughts,,0,0,0,,Gerçek Carrot ise...Dialogue: 0,0:04:18.51,0:04:20.74,Thoughts,,0,0,0,,...tavan arasında!Dialogue: 0,0:04:20.74,0:04:24.57,Main,,0,0,0,,Durun ya! Yemeyin beni!Dialogue: 0,0:04:24.57,0:04:29.45,Main,,0,0,0,,Lütfen! Yardım et! Choniki!Dialogue: 0,0:04:29.45,0:04:32.04,Main,,0,0,0,,Kurtar beni!Dialogue: 0,0:04:34.94,0:04:39.46,Thoughts,,0,0,0,,Yine de kurbağaya acıyorum açıkçası.Dialogue: 0,0:04:41.01,0:04:44.66,Thoughts,,0,0,0,,Bu hanede 16 düşman var.Dialogue: 0,0:04:44.66,0:04:49.62,Thoughts,,0,0,0,,Asıl sıkıntı oluşturanlar ise Randolph, Sosyete Timsah...Dialogue: 0,0:04:49.62,0:04:53.00,Thoughts,,0,0,0,,...ne idiğü belirsiz baca adam Diesel ile...Dialogue: 0,0:04:53.00,0:04:55.70,Thoughts,,0,0,0,,...Brûlée.Dialogue: 0,0:04:56.23,0:04:59.61,Thoughts,,0,0,0,,Ancak ve ancak sahte Carrot'u...Dialogue: 0,0:04:59.61,0:05:03.68,Thoughts,,0,0,0,,...kazana attıkları anda onları savunmasız yakalayabilirim!Dialogue: 0,0:05:03.68,0:05:06.68,Main,,0,0,0,,Randolph, halatı kes.Dialogue: 0,0:05:06.68,0:05:08.20,Main,,0,0,0,,Hay hay.Dialogue: 0,0:05:11.02,0:05:15.58,Main,,0,0,0,,Suya girer girmez tepinmeye başlayacağından kapağı hemencecik kapamalıyım.Dialogue: 0,0:05:17.32,0:05:19.59,Main,,0,0,0,,Kesiyorum, Brûlée-sama!Dialogue: 0,0:05:23.26,0:05:25.34,Thoughts,,0,0,0,,Şimdi! Carrot!Dialogue: 0,0:05:27.30,0:05:29.72,Main,,0,0,0,,Tamamdır! İyice gerilip...Dialogue: 0,0:05:43.56,0:05:47.03,Main,,0,0,0,,Ne halt yiyorsun Randolph?Dialogue: 0,0:05:48.80,0:05:52.12,Main,,0,0,0,,Brûlée-sama, tavan arasından biri çıktı!Dialogue: 0,0:05:52.92,0:05:55.59,Main,,0,0,0,,NEE?!Dialogue: 0,0:05:55.59,0:05:58.83,Main,,0,0,0,,Tavşan kızdan iki tane var!Dialogue: 0,0:06:04.95,0:06:05.96,Main,,0,0,0,,Güzel!Dialogue: 0,0:06:06.81,0:06:09.34,Main,,0,0,0,,Sakin olsana! Sana diyorum!Dialogue: 0,0:06:09.34,0:06:11.43,Main,,0,0,0,,Elini çabuk tut Carrot!Dialogue: 0,0:06:11.43,0:06:14.06,Main,,0,0,0,,Bana güvenebilirsin Choniki!Dialogue: 0,0:06:19.98,0:06:21.83,Main,,0,0,0,,Neyin peşinde ki?Dialogue: 0,0:06:21.83,0:06:24.91,Main,,0,0,0,,Randolph! Halatı kes hemen!Dialogue: 0,0:06:24.91,0:06:26.19,Main,,0,0,0,,E- Emredersiniz!Dialogue: 0,0:06:34.52,0:06:35.74,Main,,0,0,0,,Carrot!Dialogue: 0,0:06:39.42,0:06:41.58,Main,,0,0,0,,Bunu hak ettiniz!Dialogue: 0,0:06:45.77,0:06:48.76,Main,,0,0,0,,Ne?!Dialogue: 0,0:06:48.76,0:06:51.93,Main,,0,0,0,,Olamaz! Bunu yapamazsın! Hayır!Dialogue: 0,0:06:51.93,0:06:54.24,Main,,0,0,0,,Olmaz!Dialogue: 0,0:06:55.85,0:06:59.52,Main,,0,0,0,,- Yandım! Yandım! Yanıyorum! - Brûlée-sama!Dialogue: 0,0:06:59.52,0:07:02.48,Main,,0,0,0,,Yanıyorum ya!Dialogue: 0,0:07:02.73,0:07:05.66,Main,,0,0,0,,Yandım! Yandım!Dialogue: 0,0:07:07.29,0:07:09.20,Main,,0,0,0,,İşte bu!Dialogue: 0,0:07:15.24,0:07:18.43,Main,,0,0,0,,– Brûlée-sama! – Eyvahlar olsun!Dialogue: 0,0:07:22.04,0:07:23.29,Main,,0,0,0,,Olamaz!Dialogue: 0,0:07:23.29,0:07:25.17,Main,,0,0,0,,Brûlée-sama!Dialogue: 0,0:08:22.27,0:08:25.98,Main,,0,0,0,,İşler sarpa sardı! Mama'ya haber vereceğim!Dialogue: 0,0:08:30.11,0:08:31.49,Main,,0,0,0,,Bana bırak Choniki!Dialogue: 0,0:08:31.85,0:08:35.53,Main,,0,0,0,,Çuf çuf! Çuf çuf! Çuf çuf! Çuf!Dialogue: 0,0:08:35.53,0:08:41.29,Main,,0,0,0,,Dangalaklar! Koşmaya bir başladım mı kimse beni yakalayamaz...Dialogue: 0,0:08:42.16,0:08:42.99,Main,,0,0,0,,Ne soktu lan?Dialogue: 0,0:08:42.99,0:08:44.29,Main,,0,0,0,,Garchu!Dialogue: 0,0:08:44.29,0:08:45.75,Main,,0,0,0,,Ha?!Dialogue: 0,0:08:46.51,0:08:48.09,Main,,0,0,0,,Kimim ben?Dialogue: 0,0:08:48.09,0:08:49.95,Main,,0,0,0,,Ne?!Dialogue: 0,0:08:49.99,0:08:52.76,Main,,0,0,0,,Hayır, hayır, olamaz... Bırak beni!Dialogue: 0,0:08:52.79,0:08:54.26,Main,,0,0,0,,Daha değil.Dialogue: 0,0:08:54.26,0:08:56.84,Main,,0,0,0,,Bırak dedim!Dialogue: 0,0:08:56.84,0:08:58.31,Main,,0,0,0,,Tamam.Dialogue: 0,0:08:59.06,0:09:00.68,Main,,0,0,0,,Ne?!Dialogue: 0,0:09:00.68,0:09:03.06,Main,,0,0,0,,Ç- Çarpacağım!Dialogue: 0,0:09:03.06,0:09:05.56,Main,,0,0,0,,Duramıyorum!Dialogue: 0,0:09:05.56,0:09:06.19,Main,,0,0,0,,Güle güle.Dialogue: 0,0:09:08.83,0:09:14.03,Main,,0,0,0,,İşte bu ya! Brulee'nin tayfasını yendik!Dialogue: 0,0:09:15.98,0:09:17.99,Main,,0,0,0,,Choniki!Dialogue: 0,0:09:17.99,0:09:19.45,Main,,0,0,0,,Tamamdır!Dialogue: 0,0:09:19.45,0:09:24.70,Main,,0,0,0,,Böylece Brûlée'nin yeteneğini kullanarak aynalardan geçebileceğiz!Dialogue: 0,0:09:24.70,0:09:29.08,Main,,0,0,0,,Bu boyuttan tüm adayı gezip arkadaşlarımızı arayalım!Dialogue: 0,0:09:29.21,0:09:33.71,Captions,,0,0,0,,Sanji'nin OdasıDialogue: 0,0:09:32.22,0:09:33.62,Main,,0,0,0,,Girebilir miyim-nasu?Dialogue: 0,0:09:33.62,0:09:34.71,Main,,0,0,0,,Gir.Dialogue: 0,0:09:35.42,0:09:37.24,Main,,0,0,0,,Alışverişi hallettiğin için teşekkürler.Dialogue: 0,0:09:37.24,0:09:39.64,Main,,0,0,0,,Lafı olmaz-nasu.Dialogue: 0,0:09:39.64,0:09:42.26,Main,,0,0,0,,Bu arada gelişmeler var-nasu.Dialogue: 0,0:09:42.26,0:09:47.31,Main,,0,0,0,,Hasır Şapka ile Hırsız Kedi'yi yakalamışız-nasu.Dialogue: 0,0:09:49.87,0:09:52.14,Thoughts,,0,0,0,,Luffy ile Nami-san'ı mı?Dialogue: 0,0:10:02.03,0:10:09.00,Flashbacks,,0,0,0,,Kaçmazsan her şey tatlı tatlı çözülür Sanji.Dialogue: 0,0:10:09.36,0:10:15.59,Main,,0,0,0,,Öte yandan bir erkek Mink ile Ruh Kralı hâlâ sorun çıkarıyor.Dialogue: 0,0:10:15.59,0:10:16.88,Thoughts,,0,0,0,,Brook!Dialogue: 0,0:10:16.88,0:10:22.38,Main,,0,0,0,,Şekerleme Generali Smoothie-sama ile  Baran Tamago onları hizaya getirmeye gitmiş olsa da...Dialogue: 0,0:10:22.38,0:10:24.72,Main,,0,0,0,,...hâlâ birkaç sorun--Dialogue: 0,0:10:24.72,0:10:25.81,Main,,0,0,0,,Yeter.Dialogue: 0,0:10:28.14,0:10:29.94,Main,,0,0,0,,İstediklerimi alabilir miyim?Dialogue: 0,0:10:29.94,0:10:32.69,Main,,0,0,0,,Tabii, buyrun-nasu.Dialogue: 0,0:10:32.68,0:10:36.60,Note,,0,0,0,,Not: Bu adam cümlelerini "Nasu: Patlıcan" diye bitiriyor.Dialogue: 0,0:10:32.69,0:10:36.60,Main,,0,0,0,,Acıktıysanız patlıcan getirebilirim.Dialogue: 0,0:10:36.60,0:10:38.07,Main,,0,0,0,,Teşekkürler.Dialogue: 0,0:10:38.95,0:10:41.84,Main,,0,0,0,,- Mutfağı kullanabilir miyim? - Af buyrun?Dialogue: 0,0:10:43.58,0:10:49.09,Main,,0,0,0,,Pudding-chan akşam yemeğinde yoktu, ona bir şeyler pişireceğim.Dialogue: 0,0:10:49.09,0:10:50.86,Main,,0,0,0,,Anlıyorum-nasu.Dialogue: 0,0:10:53.50,0:10:55.92,Main,,0,0,0,,Beni endişelendirdi.Dialogue: 0,0:10:55.92,0:11:00.41,Main,,0,0,0,,Haklısınız, kendisini çok iyi hissetmediğini duymuştum.Dialogue: 0,0:11:02.47,0:11:05.72,Captions,,0,0,0,,Hazine AmbarıDialogue: 0,0:11:09.86,0:11:11.35,Main,,0,0,0,,Anahtarları buldum.Dialogue: 0,0:11:14.68,0:11:17.98,Main,,0,0,0,,Pedro-san! Başaracağım!Dialogue: 0,0:11:17.98,0:11:20.15,Main,,0,0,0,,Şerefsiz!Dialogue: 0,0:11:22.56,0:11:25.20,Main,,0,0,0,,Nasıl cüret edersin?!Dialogue: 0,0:11:26.33,0:11:28.41,Main,,0,0,0,,Başka çarem yoktu!Dialogue: 0,0:11:45.00,0:11:52.27,Main,,0,0,0,,Buraya gelmeden evvel ortağımdan hayatını tehlikeye atmasını istedim!Dialogue: 0,0:12:01.36,0:12:03.11,Main,,0,0,0,,Üzerime düşeni yerine getirmezsem...Dialogue: 0,0:12:04.16,0:12:07.66,Main,,0,0,0,,...ona bakacak yüzüm kalmaz!Dialogue: 0,0:12:15.17,0:12:20.80,Main,,0,0,0,,Zaten yüzüm olmadığını da kim demiş!Dialogue: 0,0:12:22.02,0:12:24.05,Main,,0,0,0,,Muhafızlar, beni duyuyor musunuz?Dialogue: 0,0:12:24.87,0:12:26.21,Main,,0,0,0,,Cevap verin!Dialogue: 0,0:12:26.21,0:12:27.69,Main,,0,0,0,,Elimi çabuk tutmam lazım.Dialogue: 0,0:12:47.57,0:12:50.91,Main,,0,0,0,,Şatoya sızan kişi içerde mi?Dialogue: 0,0:12:50.91,0:12:55.18,Main,,0,0,0,,Mama! Zahmet etmeseydin! Bununla ben ilgilenebilirim!Dialogue: 0,0:12:55.18,0:12:57.67,Main,,0,0,0,,Çekil kenara Smoothie!Dialogue: 0,0:13:12.56,0:13:14.69,Main,,0,0,0,,Kimsin sen?Dialogue: 0,0:13:14.69,0:13:18.46,Main,,0,0,0,,Kimin hazinelerine el sürdüğünü...Dialogue: 0,0:13:18.46,0:13:22.03,Main,,0,0,0,,...bilmiyor musun?!Dialogue: 0,0:13:22.65,0:13:24.32,Main,,0,0,0,,Yoksa...Dialogue: 0,0:13:27.52,0:13:30.74,Main,,0,0,0,,Big Mom!Dialogue: 0,0:13:34.88,0:13:40.25,Main,,0,0,0,,Amanın! Ne tuhaf bir yaratık!Dialogue: 0,0:13:49.25,0:13:52.31,Main,,0,0,0,,İçeri sızan eleman,  avlu yakınındaki koridordan geçiyor!Dialogue: 0,0:13:52.31,0:13:54.12,Main,,0,0,0,,İki kanattan da sıkıştırın!Dialogue: 0,0:14:00.90,0:14:03.67,Main,,0,0,0,,Kalkanlar yukarı!Dialogue: 0,0:14:08.64,0:14:10.91,Main,,0,0,0,,İleri!Dialogue: 0,0:14:18.45,0:14:21.29,Main,,0,0,0,,Az kaldı!Dialogue: 0,0:14:28.43,0:14:31.78,Main,,0,0,0,,Tamamdır! Avluda köşeye kıstırdık!Dialogue: 0,0:14:31.78,0:14:34.83,Main,,0,0,0,,Sıçayım! Neyin peşinde bunlar?Dialogue: 0,0:14:36.73,0:14:39.21,Main,,0,0,0,,Görüşmeyeli uzun zaman oldu-bon!Dialogue: 0,0:14:41.69,0:14:46.19,Captions,,0,0,0,,Whole Cake Şatosu AvlusuDialogue: 0,0:14:46.78,0:14:48.95,Main,,0,0,0,,Baron Tamago!Dialogue: 0,0:14:48.95,0:14:53.10,Main,,0,0,0,,Nox Korsanları Kaptanı Pedro!Dialogue: 0,0:14:53.10,0:14:58.33,Main,,0,0,0,,Her ne kadar düşmanımız olsan da saygımı kazanmıştın.Dialogue: 0,0:14:58.83,0:15:02.34,Main,,0,0,0,,Ne zaman karşılaşsak...Dialogue: 0,0:15:02.85,0:15:06.96,Main,,0,0,0,,...sol gözümüzdeki yara kaşınır durur-toi-et-moi.Dialogue: 0,0:15:08.80,0:15:15.90,Main,,0,0,0,,Beş yıl evvel, yaşamak için âdeta yalvaran adam...Dialogue: 0,0:15:15.90,0:15:19.18,Main,,0,0,0,,...ne diye aynı hatayı işliyor ki?Dialogue: 0,0:15:19.18,0:15:22.90,Main,,0,0,0,,Geriye yaşayacak fazla ömrün de kalmadı-soufflé.Dialogue: 0,0:15:24.97,0:15:28.07,Main,,0,0,0,,O gün Mama...Dialogue: 0,0:15:35.08,0:15:39.37,Main,,0,0,0,,...50 yıllık ömrünü aldı zira-bon!Dialogue: 0,0:15:42.79,0:15:46.63,Main,,0,0,0,,Evet, farkındayım.Dialogue: 0,0:15:51.68,0:15:55.32,Main,,0,0,0,,Ben artık...Dialogue: 0,0:16:00.75,0:16:03.81,Main,,0,0,0,,...memleketime sağ dönmeyi düşünmüyorum.Dialogue: 0,0:16:33.51,0:16:37.01,Captions,,0,0,0,,Tatlı ŞehriDialogue: 0,0:16:39.06,0:16:41.08,Main,,0,0,0,,Sanji!Dialogue: 0,0:16:42.24,0:16:44.56,Main,,0,0,0,,Burada yok!Dialogue: 0,0:16:45.48,0:16:46.91,Main,,0,0,0,,Sanji!Dialogue: 0,0:16:46.91,0:16:49.15,Main,,0,0,0,,Hayalet!Dialogue: 0,0:16:51.82,0:16:54.40,Main,,0,0,0,,Burada da yok!Dialogue: 0,0:17:13.38,0:17:15.69,Main,,0,0,0,,Daha mı uzakta ki?Dialogue: 0,0:17:15.69,0:17:17.18,Main,,0,0,0,,Uyansana, Brûlée!Dialogue: 0,0:17:18.60,0:17:21.81,Main,,0,0,0,,Whole Cake Şatosu'na bağlanan ayna nerede?Dialogue: 0,0:17:21.81,0:17:24.48,Main,,0,0,0,,Diesel! Sen bilmiyor musun?Dialogue: 0,0:17:24.48,0:17:27.44,Main,,0,0,0,,Nereden bileyim be?! Hay böyle işin!Dialogue: 0,0:17:27.44,0:17:32.53,Main,,0,0,0,,Brûlée'yle teması koparmadığımız sürece aynalar içinde gönlümüzce dolaşabiliriz!Dialogue: 0,0:17:33.99,0:17:38.16,Main,,0,0,0,,Whole Cake Adası'ndaki her bir aynaya bağlanan bir boyuttayız.Dialogue: 0,0:17:38.16,0:17:40.83,Main,,0,0,0,,Şatoyu şıp diye bulmalıydık.Dialogue: 0,0:17:40.83,0:17:44.26,Main,,0,0,0,,Brûlée! Uyansana artık!Dialogue: 0,0:17:44.26,0:17:45.41,Main,,0,0,0,,Uykucu!Dialogue: 0,0:17:45.44,0:17:49.64,Main,,0,0,0,,Brûlée uyanana kadar kendimiz aramaya koyulmalıyız!Dialogue: 0,0:17:49.64,0:17:52.74,Main,,0,0,0,,Bulana kadar hız kesmeyelim!Dialogue: 0,0:17:54.37,0:17:58.58,Main,,0,0,0,,Bu yaptığınız yanınıza kalmayacak!Dialogue: 0,0:18:06.69,0:18:11.55,Captions,,0,0,0,,Zindan  KütüphanesiDialogue: 0,0:18:07.30,0:18:11.57,Main,,0,0,0,,Kes şunu Luffy! Aklından neler geçiyor?!Dialogue: 0,0:18:11.57,0:18:13.69,Main,,0,0,0,,Boşa tepiniyorsun.Dialogue: 0,0:18:18.68,0:18:21.76,Main,,0,0,0,,Böyle devam edersen ellerin kopacak!Dialogue: 0,0:18:21.76,0:18:23.77,Main,,0,0,0,,Ben de onu istiyorum zaten!Dialogue: 0,0:18:23.77,0:18:24.95,Main,,0,0,0,,Ne?!Dialogue: 0,0:18:25.32,0:18:27.48,Main,,0,0,0,,Hayır! Yapma!Dialogue: 0,0:18:27.48,0:18:28.83,Main,,0,0,0,,Mecburum!Dialogue: 0,0:18:28.83,0:18:33.17,Main,,0,0,0,,Başka kurtuluş yolumuz var mı ki?!Dialogue: 0,0:18:33.17,0:18:37.51,Main,,0,0,0,,Canından olmaktansa bir çift elinden olmak...Dialogue: 0,0:18:37.51,0:18:39.72,Main,,0,0,0,,...daha iyi değil mi?!Dialogue: 0,0:18:40.43,0:18:42.95,Main,,0,0,0,,Kopmak üzere!Dialogue: 0,0:18:47.52,0:18:50.48,Main,,0,0,0,,Hayır, hayır, hayır! Daha da inceliyorlar!Dialogue: 0,0:18:50.48,0:18:52.50,Main,,0,0,0,,İncelmesini istiyorum zaten!Dialogue: 0,0:18:52.50,0:18:55.94,Main,,0,0,0,,Birilerinin imdadımıza yetişmesini beklerken...Dialogue: 0,0:18:55.94,0:19:01.37,Main,,0,0,0,,...sahip olduğumuz her şeyden olacak ve Big Mom'ın ellerinde ölüp gideceğiz!Dialogue: 0,0:19:01.37,0:19:07.08,Main,,0,0,0,,Saçmalık! Böyle ölmek istemem!Dialogue: 0,0:19:12.04,0:19:14.00,Main,,0,0,0,,Sen de ellerini kopar!Dialogue: 0,0:19:14.00,0:19:16.80,Main,,0,0,0,,Ne?! Delirdin mi ne?! Hayatta yapmam!Dialogue: 0,0:19:16.80,0:19:20.59,Main,,0,0,0,,Öyleyse seni de bir şekilde kurtarırım ama sızlanmayı kes!Dialogue: 0,0:19:20.59,0:19:23.46,Main,,0,0,0,,Senin ellerinin koptuğunu da görmek istemiyorum! Kes artık!Dialogue: 0,0:19:23.46,0:19:25.97,Main,,0,0,0,,Durumumuzun farkına var artık!Dialogue: 0,0:19:25.97,0:19:27.81,Main,,0,0,0,,Ben...Dialogue: 0,0:19:27.81,0:19:31.25,Main,,0,0,0,,...böyle bir fare çukurunda ölecek adam değilim!Dialogue: 0,0:19:31.25,0:19:33.56,Main,,0,0,0,,Yapma!Dialogue: 0,0:19:43.23,0:19:47.01,Captions,,0,0,0,,Sanji'nin Misafir Odası, Whole Cake ŞatosuDialogue: 0,0:19:43.24,0:19:47.01,Main,,0,0,0,,Eyvah. El alışkanlığından bolca yaptım.Dialogue: 0,0:19:47.98,0:19:51.57,Main,,0,0,0,,Pudding-chan bunca yemeği bitiremez herhâlde.Dialogue: 0,0:19:51.57,0:19:53.67,Main,,0,0,0,,Aklım nerelerde benim?Dialogue: 0,0:19:56.57,0:20:00.42,Main,,0,0,0,,Neyse canım, kalırsa da ben yerim.Dialogue: 0,0:20:02.59,0:20:06.43,Main,,0,0,0,,İnanmıyorum! Ne kadar çok yapmışsın!Dialogue: 0,0:20:06.43,0:20:08.47,Main,,0,0,0,,Ama hepsini yiyemem ki.Dialogue: 0,0:20:09.06,0:20:11.50,Main,,0,0,0,,Sen de biraz al o zaman.Dialogue: 0,0:20:11.50,0:20:13.20,Main,,0,0,0,,Aç bakayım ağzını.Dialogue: 0,0:20:15.02,0:20:17.27,Main,,0,0,0,,Ne güzel olur ya!Dialogue: 0,0:20:20.85,0:20:24.61,Main,,0,0,0,,Pudding-chan, prensin geliyor!Dialogue: 0,0:20:26.07,0:20:27.99,Main,,0,0,0,,Bir yere mi gidiyorsunuz-nasu?Dialogue: 0,0:20:28.87,0:20:33.71,Main,,0,0,0,,Evet, dünyada biricik umut ışığımda teselli bulmaya gidiyorum.Dialogue: 0,0:20:33.71,0:20:37.46,Main,,0,0,0,,Öyleyse bir patlıcan da alır mıydınız?Dialogue: 0,0:20:37.46,0:20:39.17,Main,,0,0,0,,Belki daha sonra.Dialogue: 0,0:20:52.64,0:20:55.48,Captions,,0,0,0,,Üçüncü Kattaki Avlu Whole Cake ŞatosuDialogue: 0,0:20:58.94,0:21:04.45,Captions,,0,0,0,,Pedro Eski Nox Korsanları Kaptanı Kelle Ödülü: 382 Milyon BeliDialogue: 0,0:21:07.66,0:21:13.16,Captions,,0,0,0,,Big Mom Korsanları "Şövalye" Baron Tamago Kelle Ödülü: 429 Milyon BeliDialogue: 0,0:21:17.13,0:21:21.84,Main,,0,0,0,,Hasır Şapka ile Hırsız Kedi'yi çoktan yakaladık-bon.Dialogue: 0,0:21:21.84,0:21:23.72,Main,,0,0,0,,Teslim ol-bon.Dialogue: 0,0:21:24.65,0:21:27.04,Main,,0,0,0,,N'olmuş yakaladıysanız?Dialogue: 0,0:21:27.04,0:21:29.73,Main,,0,0,0,,Şu hesabı kapayalım öyleyse-bon!Dialogue: 0,0:21:58.14,0:22:01.50,Main,,0,0,0,,Minklerden çekinmeme gerek kalmadı-bon!Dialogue: 0,0:22:01.50,0:22:03.24,Main,,0,0,0,,Hazırlıklı gelmişsin.Dialogue: 0,0:22:03.24,0:22:07.80,Main,,0,0,0,,Aynen öyle! Beni elektro saldırısından koruyan özel bir tayt giyiyorum-feuille.Dialogue: 0,0:22:07.80,0:22:11.80,Main,,0,0,0,,Seninle olan hesabımı şimdi göreceğim!Dialogue: 0,0:22:12.54,0:22:14.81,Flashbacks,,0,0,0,,Sahiden de sizsiniz abilerim!Dialogue: 0,0:22:14.81,0:22:16.81,Flashbacks,,0,0,0,,- Sen-gara... - Pekoms.Dialogue: 0,0:22:16.84,0:22:19.27,Flashbacks,,0,0,0,,Pedro abi! Zepo abi!Dialogue: 0,0:22:19.27,0:22:20.50,Flashbacks,,0,0,0,,Garchu!Dialogue: 0,0:22:20.50,0:22:22.25,Flashbacks,,0,0,0,,Garchu...Dialogue: 0,0:22:22.25,0:22:23.67,Flashbacks,,0,0,0,,Garchu!Dialogue: 0,0:22:23.67,0:22:24.61,Flashbacks,,0,0,0,,Garchu...Dialogue: 0,0:22:25.00,0:22:26.60,Flashbacks,,0,0,0,,Burada ne işin var?Dialogue: 0,0:22:26.60,0:22:31.31,Flashbacks,,0,0,0,,Grr! Bugüne bugün Big Mom Korsanları mürettebatındayım.Dialogue: 0,0:22:34.94,0:22:37.46,Main,,0,0,0,,Bu sefer tek gözle yakayı kurtaramayacaksın!Dialogue: 0,0:23:09.49,0:23:11.32,Main,,0,0,0,,Nalları dikiyordun-bon!Dialogue: 0,0:23:15.90,0:23:19.74,Main,,0,0,0,,Ara ara sol gözüm şimdi bile sızlar-feuille.Dialogue: 0,0:23:19.74,0:23:23.89,Main,,0,0,0,,Kılıcının verdiği acı hâlâ hatırımda-toilette!Dialogue: 0,0:23:23.89,0:23:27.05,Main,,0,0,0,,Ben de unutmuş değilim.Dialogue: 0,0:23:27.92,0:23:31.84,Flashbacks,,0,0,0,,Bunu yapmayacaktınız işte hırsız bozuntuları.Dialogue: 0,0:23:37.67,0:23:39.68,Flashbacks,,0,0,0,,N'oluyor...Dialogue: 0,0:23:39.68,0:23:41.14,Flashbacks,,0,0,0,,Abi!Dialogue: 0,0:23:54.06,0:23:57.41,Flashbacks,,0,0,0,,100 yıllık ömrünü alıyorum!Dialogue: 0,0:23:59.94,0:24:02.96,Flashbacks,,0,0,0,,Zepo, dayan!Dialogue: 0,0:24:08.32,0:24:09.78,Flashbacks,,0,0,0,,Zepo...Dialogue: 0,0:24:09.80,0:24:11.80,Flashbacks,,0,0,0,,Zepo!!Dialogue: 0,0:24:14.66,0:24:16.51,Flashbacks,,0,0,0,,Zepo abi!Dialogue: 0,0:24:16.59,0:24:21.39,Flashbacks,,0,0,0,,100 yıllık ömrü yokmuş yahu.Dialogue: 0,0:24:21.39,0:24:27.09,Flashbacks,,0,0,0,,Yalnızca 30 yılı kalmış meğer.Dialogue: 0,0:24:28.36,0:24:34.70,Flashbacks,,0,0,0,,Ortağı olduğuna göre kalan borcu ödemelisin.Dialogue: 0,0:24:37.95,0:24:43.46,Flashbacks,,0,0,0,,Haydi, kalan 70 yılı sökül bakayım.Dialogue: 0,0:24:43.46,0:24:47.27,Flashbacks,,0,0,0,,Yalvarırım Mama! Onu abim olarak görüyorum!Dialogue: 0,0:24:47.27,0:24:51.42,Flashbacks,,0,0,0,,70 yılını alırsan Pedro abi de ölür!Dialogue: 0,0:24:51.42,0:24:54.45,Flashbacks,,0,0,0,,Kes şunu Pekoms. Kendini rezil ediyorsun-bon.Dialogue: 0,0:24:54.45,0:24:56.57,Flashbacks,,0,0,0,,Yalvarırım Mama!Dialogue: 0,0:24:56.57,0:24:57.64,Flashbacks,,0,0,0,,Pekoms...Dialogue: 0,0:25:00.34,0:25:04.60,Flashbacks,,0,0,0,,Zırlama Pekoms! Tamam be.Dialogue: 0,0:25:04.60,0:25:08.77,Flashbacks,,0,0,0,,10 yıl. 10 yıl indirim yapacağım.Dialogue: 0,0:25:08.77,0:25:10.31,Flashbacks,,0,0,0,,Ne?!Dialogue: 0,0:25:11.44,0:25:16.48,Flashbacks,,0,0,0,,Fakat Tamago'nun bir gözünü alman affedilir şey değil.Dialogue: 0,0:25:17.45,0:25:19.20,Flashbacks,,0,0,0,,Ömründen 60 yılı alıyorum!Dialogue: 0,0:25:25.90,0:25:30.00,Flashbacks,,0,0,0,,Bir itirazın kalmamıştır umarım Pekoms?Dialogue: 0,0:25:30.00,0:25:32.73,Flashbacks,,0,0,0,,A- Aslında...Dialogue: 0,0:25:37.51,0:25:40.10,Flashbacks,,0,0,0,,Hey, Big Mom!Dialogue: 0,0:25:42.91,0:25:45.31,Flashbacks,,0,0,0,,Bu kaç yıl eder?Dialogue: 0,0:25:47.22,0:25:49.90,Flashbacks,,0,0,0,,Abi!Dialogue: 0,0:25:51.71,0:25:56.70,Flashbacks,,0,0,0,,Burada ölmemin bir anlamı yok! Yeni dünyanın şafağı yaklaşıyor!Dialogue: 0,0:25:56.70,0:25:58.87,Flashbacks,,0,0,0,,Geri dönmem gerek!Dialogue: 0,0:26:06.60,0:26:09.22,Flashbacks,,0,0,0,,Pek de yakışıklısın.Dialogue: 0,0:26:09.22,0:26:12.30,Flashbacks,,0,0,0,,50 yıla düşürdüm gitti.Dialogue: 0,0:26:12.30,0:26:14.84,Flashbacks,,0,0,0,,Yaşa bakalım.Dialogue: 0,0:26:26.41,0:26:32.07,Main,,0,0,0,,Söyle-bon Pedro! Neden döndün?Dialogue: 0,0:26:34.71,0:26:41.07,Main,,0,0,0,,Ortağını öldüren, senin ömründen de 50 yılı alan bu korkunç adaya!Dialogue: 0,0:26:42.72,0:26:48.08,Main,,0,0,0,,Memleketimi yok olmaktan kurtaran Hasır Şapkalar'a borçluyum!Dialogue: 0,0:26:57.81,0:27:04.68,Main,,0,0,0,,Ayrıca günün birinde dünyamızı şafağa taşıyacaklarına inanıyorum!Dialogue: 0,0:27:11.20,0:27:13.15,Flashbacks,,0,0,0,,Pedro!Dialogue: 0,0:27:13.15,0:27:18.11,Flashbacks,,0,0,0,,Dünyamızın şafağına pek bir şey kalmadı!Dialogue: 0,0:27:24.73,0:27:30.21,Main,,0,0,0,,Hasır Şapkalar sizleri-gara geçerek dünyayı değiştirecekler!Dialogue: 0,0:27:31.42,0:27:36.84,Main,,0,0,0,,Hiçbir bok yiyemezler! Nerede olduğunun farkında mısın-bon?!Dialogue: 0,0:27:36.84,0:27:39.26,Main,,0,0,0,,Whole Cake Adası'ndasın-bon!Dialogue: 0,0:27:39.26,0:27:41.69,Main,,0,0,0,,Yani?Dialogue: 0,0:27:41.69,0:27:45.06,Main,,0,0,0,,Hasır Şapkalar'a inanıyorum ben.Dialogue: 0,0:27:45.06,0:27:49.31,Main,,0,0,0,,Bu yüzden de kalan kısacık ömrümü...Dialogue: 0,0:27:50.58,0:27:53.40,Main,,0,0,0,,...onlar için seve seve veririm.Dialogue: 0,0:27:58.69,0:28:01.20,Main,,0,0,0,,Ama yanlış bir fikre kapılmayasın.Dialogue: 0,0:28:01.20,0:28:03.74,Main,,0,0,0,,Öleceğim yer burası değil!Dialogue: 0,0:28:03.74,0:28:07.29,Main,,0,0,0,,Bu adadaki hedeflerini henüz gerçekleştirmediler!Dialogue: 0,0:28:25.03,0:28:27.95,Main,,0,0,0,,Henüz ölmüyorum.Dialogue: 0,0:28:29.85,0:28:32.77,Main,,0,0,0,,N'olur sanki? Daha önce içeri almıştın.Dialogue: 0,0:28:29.93,0:28:34.81,Captions,,0,0,0,,Pudding'in Odasının GirişiDialogue: 0,0:28:32.77,0:28:35.20,Main,,0,0,0,,Hayırdan anlamaz mısın sen şapşal oğlan?Dialogue: 0,0:28:35.20,0:28:36.23,Main,,0,0,0,,Neden ama?Dialogue: 0,0:28:36.23,0:28:42.24,Main,,0,0,0,,Pudding-sama meşgul şu an!Dialogue: 0,0:28:42.24,0:28:43.86,Main,,0,0,0,,Meşgul mü?Dialogue: 0,0:28:43.86,0:28:48.12,Main,,0,0,0,,O güzel dişlerini dökerim şapşal oğlan. Haydi yaylan şimdi şapşal oğlan.Dialogue: 0,0:29:04.40,0:29:06.09,Thoughts,,0,0,0,,Bir saniye.Dialogue: 0,0:29:06.09,0:29:09.97,Thoughts,,0,0,0,,Yanılmıyorsam odasının balkonu vardı.Dialogue: 0,0:29:29.62,0:29:31.66,Main,,0,0,0,,Pencereden girelim bari.Dialogue: 0,0:29:34.87,0:29:39.61,Thoughts,,0,0,0,,Yapmasam daha iyi olur. Sonra adım röntgenciye çıkar.Dialogue: 0,0:29:39.61,0:29:43.95,Main,,0,0,0,,Aman canım, yarın karı-koca olacağız.Dialogue: 0,0:29:43.95,0:29:46.34,Main,,0,0,0,,Üzerini değiştiriyorsa da...Dialogue: 0,0:29:46.34,0:29:50.72,Main,,0,0,0,,H- H- Hatta çıplaksa bile bir şeycik olmaz!Dialogue: 0,0:29:58.43,0:30:01.90,Thoughts,,0,0,0,,Şükürler olsun.  Kahkaha atacak kadar kendini toparladı demek.Dialogue: 0,0:30:03.78,0:30:06.70,Thoughts,,0,0,0,,Gördüm onu. Pudding-chan!Dialogue: 0,0:30:08.45,0:30:10.83,Thoughts,,0,0,0,,Kiminle konuşuyor?Dialogue: 0,0:30:12.79,0:30:14.25,Thoughts,,0,0,0,,Reiju?!Dialogue: 0,0:30:14.25,0:30:16.30,Thoughts,,0,0,0,,Burada ne işi var?!Dialogue: 0,0:30:16.30,0:30:18.49,Thoughts,,0,0,0,,Pudding-chan'la ne işi var acaba?Dialogue: 0,0:30:28.31,0:30:34.35,Main,,0,0,0,,Hayal kurmayı kes kızım! O ezikle evlenir miyim hiç?!Dialogue: 0,0:30:34.35,0:30:36.80,Main,,0,0,0,,Ölürüm de evlenmem!Dialogue: 0,0:30:36.80,0:30:40.02,Flashbacks,,0,0,0,,Ölürüm de evlenmem!Dialogue: 0,0:30:46.18,0:30:50.99,Main,,0,0,0,,Mama'nın göz bebeğiyim ben. Rol kesme yeteneğim sağ olsun.Dialogue: 0,0:30:50.99,0:30:55.95,Main,,0,0,0,,Şu sıralar asabımı bozacak kadar fazla üzerime titriyor hatta.Dialogue: 0,0:30:57.16,0:31:01.17,Main,,0,0,0,,Mama'nın gönlü olsun diye bir erkeği kafalamak çocuk oyuncağı.Dialogue: 0,0:31:01.17,0:31:04.22,Main,,0,0,0,,Hasır Şapkaları oyuna getirmek de oldukça basitti!Dialogue: 0,0:31:05.89,0:31:11.09,Main,,0,0,0,,Bu yüzümü ailemden başka kimse bilmez.Dialogue: 0,0:31:17.93,0:31:21.06,Captions,,0,0,0,,Zindan KütüphanesiDialogue: 0,0:31:21.06,0:31:23.98,Main,,0,0,0,,Yelloz...Dialogue: 0,0:31:23.98,0:31:27.61,Main,,0,0,0,,İki dakika sus be oğlum-fa.Dialogue: 0,0:31:27.61,0:31:31.66,Main,,0,0,0,,Kaltak Pudding!Dialogue: 0,0:31:31.66,0:31:35.78,Main,,0,0,0,,Luffy, dur artık! Harbiden kopacaklar bak!Dialogue: 0,0:31:35.78,0:31:38.50,Main,,0,0,0,,Yaptıklarının bedelini...Dialogue: 0,0:31:42.29,0:31:45.70,Main,,0,0,0,,...ne olursa olsun ödeyecek.Dialogue: 0,0:31:47.82,0:31:50.59,Flashbacks,,0,0,0,,İşin aslı...Dialogue: 0,0:31:51.47,0:31:54.76,Flashbacks,,0,0,0,,...Sanji-san'dan evlilik teklifi aldım.Dialogue: 0,0:31:58.37,0:31:59.52,Flashbacks,,0,0,0,,İyi dinleyin.Dialogue: 0,0:32:02.48,0:32:05.54,Flashbacks,,0,0,0,,Evlenmeyeceğim dememin sebebi...Dialogue: 0,0:32:06.25,0:32:10.61,Flashbacks,,0,0,0,,...Mama'yla tuzağımıza balıklama atlayıp bana aşık olan o dallamayı...Dialogue: 0,0:32:13.53,0:32:16.78,Flashbacks,,0,0,0,,...düğünün ortasında...Dialogue: 0,0:32:18.24,0:32:21.12,Flashbacks,,0,0,0,,...kendi ellerimle vuracağım.Dialogue: 0,0:32:24.08,0:32:28.46,Flashbacks,,0,0,0,,Sizi de sağ bırakmayacağız tabii.Dialogue: 0,0:32:41.00,0:32:42.60,Flashbacks,,0,0,0,,Hey, dur biraz Pudding!Dialogue: 0,0:32:42.60,0:32:44.55,Flashbacks,,0,0,0,,Neler diyorsun sen?!Dialogue: 0,0:32:48.77,0:32:50.28,Flashbacks,,0,0,0,,Elveda.Dialogue: 0,0:32:50.28,0:32:53.03,Flashbacks,,0,0,0,,Zavallı sıçanlar.Dialogue: 0,0:32:54.61,0:32:58.49,Main,,0,0,0,,Başından beri bizi oyuna getiriyormuş!Dialogue: 0,0:32:58.49,0:33:02.66,Main,,0,0,0,,Sanji'nin ne yanlışını gördü ki?! Sıçayım!Dialogue: 0,0:33:04.87,0:33:07.08,Main,,0,0,0,,Ayakta uyuyorsunuz ya!Dialogue: 0,0:33:07.16,0:33:12.15,Main,,0,0,0,,Yok efendim şeytani ordu Germa 66'ymış!Dialogue: 0,0:33:12.16,0:33:16.05,Main,,0,0,0,,Hayal dünyasında yaşamaya devam edin siz, mallar!Dialogue: 0,0:33:23.38,0:33:28.24,Main,,0,0,0,,Mama'nın amacı başından beri  klon asker ordunuzu...Dialogue: 0,0:33:28.24,0:33:30.79,Main,,0,0,0,,...ve bilimsel teknolojinizi ele geçirmekti!Dialogue: 0,0:33:40.61,0:33:42.92,Main,,0,0,0,,Tam bir hanımefendisin.Dialogue: 0,0:33:42.92,0:33:45.29,Main,,0,0,0,,Şu laflara bakın hele?Dialogue: 0,0:33:47.66,0:33:51.69,Main,,0,0,0,,Bize itaat etmeyeceğinizi bildiğimizden işimize yaramazsınız.Dialogue: 0,0:33:51.69,0:33:56.82,Main,,0,0,0,,Germa Krallığı'nın tamamı bölgemizde demir atmış durumda.Dialogue: 0,0:33:56.82,0:34:01.85,Main,,0,0,0,,Sanji'nin siyasi evliliği bahanesiyle şekerin üzerine üşüşmüş sineklerden farksızsınız.Dialogue: 0,0:34:01.85,0:34:03.53,Main,,0,0,0,,Aferin size.Dialogue: 0,0:34:03.53,0:34:06.48,Main,,0,0,0,,Her şey Mama'nın planladığı gibi gitti.Dialogue: 0,0:34:09.39,0:34:11.32,Main,,0,0,0,,Vinsmoke fertleri...Dialogue: 0,0:34:13.68,0:34:16.15,Main,,0,0,0,,...yarınki düğünde...Dialogue: 0,0:34:20.81,0:34:22.83,Main,,0,0,0,,...katledilecek!Dialogue: 0,0:34:44.50,0:34:50.86,Credits,,0,0,0,,Editing:  Feeso, Galaxy 9000  Timing: Halee  Quality Assurance: Feeso, Galaxy 9000, Grug, Pepperjack  Soundtracking:  Halee  Infoboxes & Title:  Datenshi  Karaoke: KaitouYahiko  Attack Effects: KaitouYahiko  Translation: Crunchyroll