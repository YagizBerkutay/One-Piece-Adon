Dialogue: 0,0:13:37.87,0:13:39.15,Pudding,,0,0,0,karaoke,Edit!
Dialogue: 0,0:13:37.87,0:13:39.15,Attack,,0,0,0,karaoke,Düzenle
Dialogue: 0,0:15:52.44,0:15:55.02,Jinbe,,0,0,0,karaoke,Go Sen Mai Gawara...
Dialogue: 0,0:15:52.44,0:15:55.02,Attack,,0,0,0,karaoke,Beş Bin Tuğla...
Dialogue: 0,0:15:56.25,0:15:57.99,Jinbe,,0,0,0,karaoke,...Sei Ken!
Dialogue: 0,0:15:56.25,0:15:57.99,Attack,,0,0,0,karaoke,...Yumruğu!
Dialogue: 0,0:00:15.13,0:00:20.20,Main,,0,0,0,,Bir zamanlar Kuzey Mavi'yi\Ndize getiren Germa 66'nın...
Dialogue: 0,0:00:21.17,0:00:27.79,Main,,0,0,0,,...tepesinde duran altı Vinsmoke\Nyarın delik deşik edilecek.
Dialogue: 0,0:00:27.79,0:00:29.13,Main,,0,0,0,,Salon...
Dialogue: 0,0:00:29.95,0:00:32.40,Main,,0,0,0,,...kanınızın rengiyle boyanacak.
Dialogue: 0,0:00:32.40,0:00:33.63,Main,,0,0,0,,Bum.
Dialogue: 0,0:00:38.66,0:00:42.17,Main,,0,0,0,,Fakat son nefesini verirken de...
Dialogue: 0,0:00:42.17,0:00:46.66,Main,,0,0,0,,...iğrenç kanını etrafa sıçratıp\Nsefil çığlıklar atma.
Dialogue: 0,0:00:46.66,0:00:49.54,Main,,0,0,0,,Aman dikkatli ol.
Dialogue: 0,0:00:49.54,0:00:53.99,Main,,0,0,0,,Düğün pastasına kan sıçrarsa\NMama küplere biner ve...
Dialogue: 0,0:00:53.99,0:00:56.57,Main,,0,0,0,,...taş üstünde taş koymaz.
Dialogue: 0,0:01:00.53,0:01:05.58,Main,,0,0,0,,36 kalibreli kapsüllü tabanca Walker.
Dialogue: 0,0:01:05.58,0:01:08.95,Main,,0,0,0,,Mermilerine "Şeker Kılıfları" diyoruz.
Dialogue: 0,0:01:08.95,0:01:13.88,Main,,0,0,0,,Kalkanların ardındaki zırhlı askerleri bile\Ndelip geçecek şekilde tasarlandı.
Dialogue: 0,0:01:13.88,0:01:16.38,Main,,0,0,0,,Gücünü de bizzat tattın, değil mi?
Dialogue: 0,0:01:18.55,0:01:22.10,Main,,0,0,0,,Metal alaşımlarla sağlamlaştırılmış\Nbedenlerinizi kevgire çevirecek.
Dialogue: 0,0:01:27.73,0:01:29.74,Main,,0,0,0,,Hemen yarın olsa keşke!
Dialogue: 0,0:01:29.74,0:01:35.95,Main,,0,0,0,,Tüm umutlarını bağladığı kişi tabancayı doğrulttuğunda Sanji'nin yüzünü görmek istiyorum!
Dialogue: 0,0:01:37.86,0:01:40.83,Main,,0,0,1,,Ben de iple çekiyorum!
Dialogue: 0,0:01:38.24,0:01:45.63,Captions,,530,0,295,,{\fad(500,500)}Jöle
Dialogue: 0,0:01:39.60,0:01:45.63,Captions,,0,600,315,,{\fad(500,500)}Halı
Dialogue: 0,0:01:40.83,0:01:45.41,Main,,0,0,1,,Salak herif harbiden de\Nonu sevdiğini sanıyor ya!
Dialogue: 0,0:01:50.04,0:01:51.54,Main,,0,0,0,,Eşsiz bir manzara olacak.
Dialogue: 0,0:01:55.26,0:01:58.30,Main,,0,0,0,,Yüzü nasıl bir şekil alacaktır ki?
Dialogue: 0,0:01:58.30,0:02:03.00,Main,,0,0,0,,Dur bakayım...\NBöyle mi?!
Dialogue: 0,0:02:04.22,0:02:06.89,Main,,0,0,0,,- Süper ya!\N- Çok komik!
Dialogue: 0,0:02:10.23,0:02:13.35,Main,,0,0,0,,Yoksa şöyle mi yapar?
Dialogue: 0,0:02:14.07,0:02:16.36,Main,,0,0,0,,P-Pudding-{\i1}chan{\i}...
Dialogue: 0,0:02:20.52,0:02:24.37,Main,,0,0,0,,Neyin var ya? Yüzünü çeviriyorsun.
Dialogue: 0,0:02:24.99,0:02:28.21,Main,,0,0,0,,Şurada kardeşinden dem vuruyoruz.
Dialogue: 0,0:02:29.19,0:02:31.78,Main,,0,0,0,,Aynen ha, düzgünce dinlesene!
Dialogue: 0,0:02:31.78,0:02:33.59,Main,,0,0,0,,Aç kulaklarını!
Dialogue: 0,0:02:33.59,0:02:37.44,Main,,0,0,0,,Nasıl evlilik teklif ettiğini\Nduymak ister misin?
Dialogue: 0,0:02:40.01,0:02:42.92,Main,,0,0,0,,Lan yarılacaktım gülmekten!
Dialogue: 0,0:02:42.92,0:02:47.29,Main,,0,0,0,,Yüz maskesini çıkardığında\Nkamyon çarpmışa benziyordu.
Dialogue: 0,0:02:48.56,0:02:52.86,Main,,0,0,0,,Ama ben de bu anı bekliyordum.
Dialogue: 0,0:02:52.86,0:02:55.99,Main,,0,0,0,,Tam o sırada\Ntimsah gözyaşları dökerek...
Dialogue: 0,0:02:55.99,0:02:57.55,Main,,0,0,0,,...kalbini kazandım.
Dialogue: 0,0:02:57.55,0:03:02.03,Flashbacks,,0,0,0,,Benimle olan evliliğinin\Nsana işkence olmasına izin vermem!
Dialogue: 0,0:03:03.44,0:03:07.46,Main,,0,0,0,,Var ya,\Nerkekler amma geri zekâlılar.
Dialogue: 0,0:03:21.13,0:03:26.16,Main,,0,0,0,,Mal herif o an beni sıkıca sarıp...
Dialogue: 0,0:03:28.05,0:03:30.79,Main,,0,0,0,,...kulağıma şunları fısıldadı.
Dialogue: 0,0:03:37.51,0:03:41.45,Main,,0,0,0,,"Kurtuluşumsun benim. Evlenelim."
Dialogue: 0,0:03:41.45,0:03:43.28,Main,,0,0,0,,"Evlenelim."
Dialogue: 0,0:03:43.28,0:03:45.57,Main,,0,0,0,,"Evlenelim!"
Dialogue: 0,0:03:47.24,0:03:49.62,Main,,0,0,0,,"Evlenelim!"
Dialogue: 0,0:03:49.62,0:03:52.63,Main,,0,0,0,,Dur artık!\NKarnıma ağrılar giriyor!
Dialogue: 0,0:03:53.87,0:03:54.79,Main,,0,0,0,,Baksana!
Dialogue: 0,0:03:54.79,0:03:59.37,Main,,0,0,0,,Böyle rezil bir evlilik\Nteklifi daha duymuş muydun?
Dialogue: 0,0:04:06.17,0:04:08.56,Main,,0,0,0,,Ne gülünç ya.
Dialogue: 0,0:04:08.56,0:04:14.61,Main,,0,0,0,,Senin gibi bir fiyaskoyla\Nkim evlenir bir kere?!
Dialogue: 0,0:04:22.14,0:04:28.08,Main,,0,0,0,,En azından adam gibi bir prens\Ngetiremez miydiniz?!
Dialogue: 0,0:04:34.65,0:04:37.23,Main,,0,0,0,,Sanji!!
Dialogue: 0,0:06:56.68,0:07:04.23,Author,,0,0,0,,{\fad(1000,1000)\fs18} Türkçeleştirme & Çevirmen  {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&} - {\c&H01BAFF&}{\b1}dmc3{\b0}{\c&HFFFFFF&}\N{\fs17}thx to onepace.net
Dialogue: 0,0:16:52.40,0:17:02.40,Author,,0,0,0,,{\fad(500,500)\fs18} Türkçeleştirme & Çevirmen  {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&} - {\c&H01BAFF&}{\b1}dmc3{\b0}{\c&HFFFFFF&}\N{\fs17}thx to onepace.net
Dialogue: 0,0:35:49.13,0:35:53.83,Author,,0,0,0,,{\fad(0,0)\fs18} Türkçeleştirme & Çevirmen  {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&} - {\c&H01BAFF&}{\b1}dmc3{\b0}{\c&HFFFFFF&}\N{\fs17}thx to onepace.net
Dialogue: 0,0:06:56.68,0:07:04.23,Title,,0,0,0,,{\pos(651,488)}{\fad(1000,1000)}Germa'nın Başarısızlığı
Dialogue: 0,0:07:05.10,0:07:09.19,Main,,0,0,0,,Hâlâ ayağa kalkmaya mı çalışıyorsun?
Dialogue: 0,0:07:05.94,0:07:09.70,Captions,,0,0,0,,{\pos(1150,380)}{\fad(250,250)}Hazine \NAmbarı
Dialogue: 0,0:07:10.08,0:07:11.93,Main,,0,0,0,,Ha şunu bileydin.
Dialogue: 0,0:07:14.65,0:07:19.41,Main,,0,0,0,,Neden ama? \NNeden kalkmak istiyorsun ki Ruh Kralı?
Dialogue: 0,0:07:21.37,0:07:24.78,Main,,0,0,0,,Taş yazıt için mi Ruh Kralı?
Dialogue: 0,0:07:24.78,0:07:29.80,Main,,0,0,0,,Sanji'den ziyade taş yazıtın kopyasını\Nçıkarmayı mı bu kadar çok istiyorsun?
Dialogue: 0,0:07:29.80,0:07:31.42,Main,,0,0,0,,Evet.
Dialogue: 0,0:07:33.59,0:07:37.79,Main,,0,0,0,,Sanji-{\i1}san{\i0} çok merhametli adam.
Dialogue: 0,0:07:38.76,0:07:43.92,Main,,0,0,0,,Bu yüzden bir daha asla\Naramıza dönmeyeceğini anladım artık.
Dialogue: 0,0:07:43.92,0:07:47.81,Main,,0,0,0,,Nasıl alçak bir tuzak kurduysanız...
Dialogue: 0,0:07:49.69,0:07:53.22,Main,,0,0,0,,...çok merhametli olduğundan...
Dialogue: 0,0:07:53.22,0:07:58.70,Main,,0,0,0,,...bir başkası uğruna kendini feda etmeyi\Nkafaya koydu mu kimse onu caydıramaz!
Dialogue: 0,0:07:58.70,0:08:04.34,Main,,0,0,0,,Öte yandan kaptanımız, özgüveni yüksek,\Nkendi yolunu çizen bir adamdır!
Dialogue: 0,0:08:04.34,0:08:08.98,Main,,0,0,0,,En iyi seçimi ancak\Nbu iki delikanlı yapabilir!
Dialogue: 0,0:08:12.17,0:08:14.20,Main,,0,0,0,,Demek öyle!
Dialogue: 0,0:08:14.20,0:08:18.84,Main,,0,0,0,,Yapacak bir işin olmadığından mı\Ntaşın kopyasını çıkarmaya geldin yani?
Dialogue: 0,0:08:18.84,0:08:25.30,Main,,0,0,0,,Hayır, en kötü ihtimalle Sanji-san\Naramıza dönmemeye karar verirse..
Dialogue: 0,0:08:25.30,0:08:27.56,Main,,0,0,0,,...kendini suçlamasını istemiyorum!
Dialogue: 0,0:08:30.44,0:08:35.07,Main,,0,0,0,,Bu kurtarma görevinden büyük bir çıkar\Nelde ettiğimizi ona söylemek istiyorum!
Dialogue: 0,0:08:35.78,0:08:39.60,Main,,0,0,0,,Bu yüzden Yol Poneglifi'nin\Nkopyasını çıkaracağım!
Dialogue: 0,0:08:42.41,0:08:46.83,Main,,0,0,0,,En kötü ihtimal dediğin\Nfazla iyimser olmuş!
Dialogue: 0,0:08:46.83,0:08:51.30,Main,,0,0,0,,Sanji'nin aranıza dönmemesi\Nen kötü ihtimal mi oluyor?
Dialogue: 0,0:08:51.30,0:08:53.95,Main,,0,0,0,,Hiç sanmam.
Dialogue: 0,0:08:53.95,0:08:57.08,Main,,0,0,0,,Hiçbiriniz ölmeyeceğini mi sanıyorsunuz?
Dialogue: 0,0:08:57.08,0:09:00.10,Main,,0,0,0,,Pekâlâ hepiniz de ölebilirsiniz!
Dialogue: 0,0:09:00.10,0:09:06.30,Main,,0,0,0,,Hangi beyinsiz kendi planına\Nölümü dâhil eder, genç hanım?
Dialogue: 0,0:09:11.14,0:09:16.15,Captions,,0,0,0,,{\fad(500,500)}Ayna Dünyası
Dialogue: 0,0:09:18.52,0:09:21.11,Main,,0,0,0,,D... D... Dur!
Dialogue: 0,0:09:21.11,0:09:23.86,Main,,0,0,0,,Ha şöyle! Gıdı gıdı gıdı!
Dialogue: 0,0:09:26.07,0:09:28.40,Main,,0,0,0,,Çabuk sökül bakalım!
Dialogue: 0,0:09:28.40,0:09:32.24,Main,,0,0,0,,Carrot'un özel gıdıklama tekniği!
Dialogue: 0,0:09:32.24,0:09:34.61,Main,,0,0,0,,Dur!
Dialogue: 0,0:09:35.33,0:09:37.17,Main,,0,0,0,,Gıdıklamayı kes!
Dialogue: 0,0:09:37.17,0:09:41.29,Main,,0,0,0,,Öt hemen! \NSöylemezsen ölene kadar gıdıklar!
Dialogue: 0,0:09:41.29,0:09:43.13,Main,,0,0,0,,Söyleyeceğim!\NSöyleyeceğim!
Dialogue: 0,0:09:43.13,0:09:45.22,Main,,0,0,0,,Tamamdır Carrot, dur.
Dialogue: 0,0:09:45.22,0:09:47.18,Main,,0,0,0,,Peki.
Dialogue: 0,0:09:50.85,0:09:53.61,Main,,0,0,0,,Bunu ödeyeceksiniz!
Dialogue: 0,0:09:53.61,0:09:57.28,Main,,0,0,0,,Çabuk söyle bakalım.\NHangi ayna şatoya çıkıyor?
Dialogue: 0,0:09:57.28,0:10:01.19,Main,,0,0,0,,Hangisinin nereye çıktığını\Nnereden bileyim be!
Dialogue: 0,0:10:01.19,0:10:04.24,Main,,0,0,0,,Yanlış cevap!
Dialogue: 0,0:10:04.24,0:10:07.04,Main,,0,0,0,,Aynalara sormalısınız diyorum yahu!
Dialogue: 0,0:10:07.04,0:10:10.21,Main,,0,0,0,,- Aynalara mı?\N- Soralım mı?
Dialogue: 0,0:10:10.21,0:10:15.92,Main,,0,0,0,,Evet be! \NAynalar nereye bağlandıklarını biliyor!
Dialogue: 0,0:10:15.92,0:10:17.21,Main,,0,0,0,,Ne?!
Dialogue: 0,0:10:24.60,0:10:26.68,Main,,0,0,0,,Ayna ayna söyle bana!
Dialogue: 0,0:10:26.68,0:10:29.60,Main,,0,0,0,,Hanginiz şatoya çıkıyor?
Dialogue: 0,0:10:29.60,0:10:30.81,Main,,0,0,0,,Ben!
Dialogue: 0,0:10:30.81,0:10:31.79,Main,,0,0,0,,Ben!
Dialogue: 0,0:10:31.79,0:10:34.78,Main,,0,0,0,,- Ben.\N- Ben de.
Dialogue: 0,0:10:36.04,0:10:38.03,Main,,0,0,0,,Cevap verdiler!
Dialogue: 0,0:10:38.03,0:10:40.36,Main,,0,0,0,,- Ben de varım!\N- Ben de.
Dialogue: 0,0:10:40.36,0:10:41.49,Main,,0,0,0,,Ben de!
Dialogue: 0,0:10:41.49,0:10:44.77,Main,,0,0,0,,Galette-sama'nın lavabosundaki aynayım ben.
Dialogue: 0,0:10:44.77,0:10:48.30,Main,,0,0,0,,Ben de ikinci kattaki misafir\Nodasındaki el aynasıyım.
Dialogue: 0,0:10:48.30,0:10:50.67,Main,,0,0,0,,Bendeniz ise dördüncü kattaki\Nkadınlar tuvaletindeki aynayım.
Dialogue: 0,0:10:50.67,0:10:56.05,Main,,0,0,0,,Luffy'ye, Nami'ye, Brook'a, Pedro'ya\Nya da Sanji'ye çıkanınız var mı?
Dialogue: 0,0:10:56.05,0:10:57.92,Main,,0,0,0,,Onları arıyoruz da!
Dialogue: 0,0:10:57.92,0:11:00.63,Main,,0,0,0,,- Kim?\N- Nasıl bir tipleri var?
Dialogue: 0,0:11:00.63,0:11:03.07,Main,,0,0,0,,Sanji-{\i1}sama{\i0} önümden geçmişti.
Dialogue: 0,0:11:03.78,0:11:07.21,Main,,0,0,0,,Sahi ya.\NBizimkileri tanımıyorlar ki.
Dialogue: 0,0:11:07.21,0:11:10.43,Main,,0,0,0,,O iş bende Choniki!\NÇok iyi resim çizerim!
Dialogue: 0,0:11:10.43,0:11:12.52,Main,,0,0,0,,Ne? Resim mi?
Dialogue: 0,0:11:12.52,0:11:14.79,Main,,0,0,0,,Evet!
Dialogue: 0,0:11:18.49,0:11:21.73,Main,,0,0,0,,Böyle geri zekâlı bir kardeşin\Nolduğuna göre amma bahtsızmışsın.
Dialogue: 0,0:11:21.73,0:11:24.82,Main,,0,0,0,,Harbi ama ya!
Dialogue: 0,0:11:25.81,0:11:28.70,Main,,0,0,0,,Kendi hâline bırakırsak\Nsabaha nalları dikmiş olur.
Dialogue: 0,0:11:28.74,0:11:33.87,Main,,0,0,0,,Bunu yapamayız.\NBir çuval incir berbat olur.
Dialogue: 0,0:11:36.12,0:11:39.71,Main,,0,0,0,,Yarına kadar yaşaması lazım...
Dialogue: 0,0:11:51.55,0:11:54.40,Main,,0,0,0,,Pekâlâ ablacığım.
Dialogue: 0,0:11:56.68,0:11:59.45,Main,,0,0,0,,Bu şekilde göçüp gidersen\Nbaşımıza iş açarsın.
Dialogue: 0,0:11:59.45,0:12:02.43,Main,,0,0,0,,Ayrıca demin gördüğün o cadı\Nkarakterimi herkese duyurursan...
Dialogue: 0,0:12:02.43,0:12:04.74,Main,,0,0,0,,...yine başımıza iş açarsın.
Dialogue: 0,0:12:19.09,0:12:20.92,Main,,0,0,0,,Ne yapıyorsun?!
Dialogue: 0,0:12:20.92,0:12:24.00,Main,,0,0,0,,Kıpırdama.\NHemen bitecek.
Dialogue: 0,0:12:59.54,0:13:02.77,Main,,0,0,0,,Hafıza Meyvesi'nin gücü.
Dialogue: 0,0:13:02.77,0:13:07.13,Main,,0,0,0,,Herkesin kafasında anıları\Nkaydeden bir film şeridi vardır.
Dialogue: 0,0:13:07.13,0:13:10.87,Main,,0,0,0,,İllaki tırstığın, kahrolduğun...
Dialogue: 0,0:13:10.87,0:13:14.27,Main,,0,0,0,,...unutmak istediğin\Nanıların vardır, değil mi?
Dialogue: 0,0:13:15.52,0:13:19.15,Main,,0,0,0,,Germa 66'dan da bu beklenirdi ha.
Dialogue: 0,0:13:19.15,0:13:22.73,Main,,0,0,0,,Bacağından vurulduğu hâlde\No kadar mesafe katedebilmiş.
Dialogue: 0,0:13:22.73,0:13:24.58,Main,,0,0,0,,Gereksiz derecede çetin cevizsiniz!
Dialogue: 0,0:13:27.73,0:13:29.98,Main,,0,0,0,,Harbi ya!
Dialogue: 0,0:13:31.49,0:13:37.62,Main,,0,0,0,,Pekâlâ, bu kısma birkaç askerin serseri\Nkurşunuyla vurulduğunu ekledim mi...
Dialogue: 0,0:13:43.71,0:13:45.50,Main,,0,0,0,,Tamamdır!
Dialogue: 0,0:13:47.06,0:13:50.51,Main,,0,0,0,,Benimle alakalı anıların\Nhafızandan kesilip atıldı.
Dialogue: 0,0:13:50.51,0:13:53.43,Main,,0,0,0,,Yarın güzel mi güzel\Nbir düğün yapalım.
Dialogue: 0,0:13:53.87,0:13:56.56,Main,,0,0,0,,Askerleri çağırın da\Nmuayeneye götürsünler.
Dialogue: 0,0:13:56.56,0:13:58.01,Main,,0,0,0,,Hay hay.
Dialogue: 0,0:13:58.01,0:14:01.18,Captions,,0,0,0,,{\fad(500,500)}Zindan Kütüphanesi
Dialogue: 0,0:14:00.84,0:14:04.14,Main,,0,0,0,,Dur! Yapma!{\an8}
Dialogue: 0,0:14:12.45,0:14:16.61,Main,,0,0,0,,Cidden dur artık Luffy! \NBeni korkutuyorsun! Yeter!
Dialogue: 0,0:14:22.33,0:14:25.54,Main,,0,0,0,,Yapma diyorum!\NKolların gerçekten de kopacak!
Dialogue: 0,0:14:25.54,0:14:30.55,Main,,0,0,0,,Koparsa kopsun! \NSanji'ye Pudding'in gerçek yüzünü söylemeliyim!
Dialogue: 0,0:14:30.55,0:14:32.50,Main,,0,0,0,,Yılan kadın!
Dialogue: 0,0:14:36.76,0:14:40.68,Main,,0,0,0,,Yapma!\NYapma diyorum! Luffy!
Dialogue: 0,0:14:40.86,0:14:44.23,Main,,0,0,0,,Pis acıyor ya...\NAma kopmak üzere!
Dialogue: 0,0:14:44.74,0:14:48.83,Main,,0,0,0,,Bu çocuk kafayı sıyırmış-fa.\NBaksana kız.
Dialogue: 0,0:14:48.83,0:14:51.19,Main,,0,0,0,,Ne var be?!\Nİşimiz var görmüyor musun?!
Dialogue: 0,0:14:51.19,0:14:56.65,Main,,0,0,0,,Mama bu gece Lola'nın yerini\Nöğrenmemi istedi-fa.
Dialogue: 0,0:14:56.65,0:14:58.44,Main,,0,0,0,,Sen de söyle yerini artık-fa.
Dialogue: 0,0:14:58.44,0:15:01.28,Main,,0,0,0,,Yok ya!\NArkadaşımı satacak değilim!
Dialogue: 0,0:15:01.28,0:15:03.49,Main,,0,0,0,,Peki, işkence ederim ben de-fa.
Dialogue: 0,0:15:03.49,0:15:05.64,Main,,0,0,0,,Dur!\NSıradan bir işmiş gibi de söyleme!
Dialogue: 0,0:15:07.29,0:15:11.75,Main,,0,0,0,,Her beş saniyede bir\Ntatar yayıyla seni vuracağım.
Dialogue: 0,0:15:11.75,0:15:14.00,Main,,0,0,0,,Ötmek istediğinde ötersin-fa.
Dialogue: 0,0:15:14.00,0:15:16.26,Main,,0,0,0,,Ne diyorsun sen ya?!
Dialogue: 0,0:15:16.26,0:15:18.07,Main,,0,0,0,,Ölürüm o zaman!\NYapma sakın!
Dialogue: 0,0:15:18.07,0:15:19.77,Main,,0,0,0,,Öyleyse konuş işte-{\i1}fa{\i0}.
Dialogue: 0,0:15:19.77,0:15:22.78,Main,,0,0,0,,Hadi lan oradan siğilkafa!\NOnu vuramazsın!
Dialogue: 0,0:15:22.78,0:15:26.01,Main,,0,0,0,,Merak etme Nami! Beş saniyeye\Nkalmadan kollarımı koparacağım!
Dialogue: 0,0:15:26.01,0:15:27.23,Main,,0,0,0,,Ne?!
Dialogue: 0,0:15:27.23,0:15:29.98,Main,,0,0,0,,Hayır! İkisini de istemiyorum!
Dialogue: 0,0:15:29.98,0:15:31.20,Main,,0,0,0,,Çocuklaşma!
Dialogue: 0,0:15:32.15,0:15:35.08,Main,,0,0,0,,Hey! Kimse var mı?
Dialogue: 0,0:15:36.82,0:15:41.82,Main,,0,0,0,,Dur bakalım! Artık şatoya girmen\Nyasak diye biliyorum!
Dialogue: 0,0:15:41.82,0:15:46.45,Main,,0,0,0,,Şato savaş meydanına dönmüş.\NKalın kafalılık etme.
Dialogue: 0,0:15:47.87,0:15:49.71,Main,,0,0,0,,Kusura bakma Opera.
Dialogue: 0,0:15:54.02,0:15:55.13,Main,,0,0,650,,Ne?!
Dialogue: 0,0:16:28.62,0:16:32.67,Main,,0,0,0,,Üzgünüm ama biraz kestirsen?
Dialogue: 0,0:16:33.59,0:16:35.51,Main,,0,0,0,,Jinbe!
Dialogue: 0,0:16:35.51,0:16:37.87,Main,,0,0,0,,Buldum sizi Luffy! Nami!
Dialogue: 0,0:16:37.87,0:16:40.38,Main,,0,0,0,,Burada ne arıyorsun?!
Dialogue: 0,0:16:40.90,0:16:45.22,Main,,0,0,0,,Yakalandığınızı duydum.\NBir şeyiniz olmamasına sevindim.
Dialogue: 0,0:16:45.22,0:16:47.47,Main,,0,0,0,,Konuşma faslı sonraya.
Dialogue: 0,0:16:47.47,0:16:50.39,Main,,0,0,0,,Evvela, kodesten çıkmak ister misiniz?
Dialogue: 0,0:16:50.39,0:16:52.39,Main,,0,0,0,,İsteriz!
Dialogue: 0,0:16:52.39,0:16:56.69,Captions,,0,0,0,,{\fad(550,350)}Whole Cake Şatosu
Dialogue: 0,0:16:56.69,0:16:58.87,Captions,,0,0,0,,{\fad(300,0)}Sağlık Merkezi
Dialogue: 0,0:16:58.87,0:17:04.33,Main,,0,0,0,,Ciddi derecede kan kaybetse de\Nyarası şimdiden iyileşmeye başlamış.
Dialogue: 0,0:17:04.33,0:17:07.79,Main,,0,0,0,,Akıllara zarar sertlikte bir cildi ve\Niyileşme yeteneği var.
Dialogue: 0,0:17:08.41,0:17:12.17,Main,,0,0,0,,Germa'nın genetiğiyle oynanmış\Ninsanları böyle oluyormuş demek.
Dialogue: 0,0:17:12.17,0:17:17.75,Main,,0,0,0,,İstirahat etti mi çay partisine katılacak\Nkadar kendini toplamış olur.
Dialogue: 0,0:17:21.26,0:17:25.09,Main,,0,0,0,,Tüm gece başından ayrılma.
Dialogue: 0,0:17:25.09,0:17:28.76,Main,,0,0,0,,Vinsmokelar'ı da haberdar et.
Dialogue: 0,0:17:28.76,0:17:30.85,Main,,0,0,0,,Epey endişelenmişlerdir.
Dialogue: 0,0:17:30.85,0:17:31.95,Main,,0,0,0,,Emredersiniz.
Dialogue: 0,0:17:31.95,0:17:35.94,Main,,0,0,0,,Dördüncü kattaki sağlık merkezine\Ngidiyorum ben.
Dialogue: 0,0:17:35.94,0:17:42.15,Main,,0,0,0,,Bu gece şato genelinde çok fazla\Nyaralı var. Bana uyku yüzü yok.
Dialogue: 0,0:17:42.15,0:17:45.08,Main,,0,0,0,,Emeklerinize minnettarız.\NKendinize dikkat edin.
Dialogue: 0,0:18:04.10,0:18:05.23,Main,,0,0,0,,Neredeyim ben?
Dialogue: 0,0:18:10.81,0:18:11.94,Main,,0,0,0,,Sanji!
Dialogue: 0,0:18:14.19,0:18:16.39,Main,,0,0,0,,Bacağımı incitmişim.
Dialogue: 0,0:18:17.15,0:18:20.19,Main,,0,0,0,,Olan biteni hatırlıyor musun?
Dialogue: 0,0:18:23.03,0:18:25.61,Main,,0,0,0,,Şatoda yürürken...
Dialogue: 0,0:18:25.61,0:18:29.49,Main,,0,0,0,,...işgalcilerin peşinden giden\Naskerlere rastlayıp...
Dialogue: 0,0:18:30.08,0:18:32.92,Main,,0,0,0,,...kaza kurşununa mı denk geldim?
Dialogue: 0,0:18:32.92,0:18:36.54,Main,,0,0,0,,Aslında kafana yatmıyor, değil mi?\NGayet doğal.
Dialogue: 0,0:18:36.54,0:18:38.83,Main,,0,0,0,,Hafızanla oynandı.
Dialogue: 0,0:18:38.83,0:18:39.42,Main,,0,0,0,,Ne?!
Dialogue: 0,0:18:39.42,0:18:44.71,Main,,0,0,0,,Asıl başına gelenleri anlatayım.
Dialogue: 0,0:18:47.01,0:18:50.27,Captions,,0,30,1,,{\fad(250,250)}Zindan Kütüphanesi
Dialogue: 0,0:18:50.27,0:18:53.72,Main,,0,0,0,,Kitaplar, ateşe karşı çaresizdir.
Dialogue: 0,0:18:53.72,0:18:57.23,Main,,0,0,0,,Kodesi mi yakacaksın?\NEmin misin?
Dialogue: 0,0:18:57.23,0:19:02.02,Main,,0,0,0,,Alevler sizi yutmadan çıkmayı\Nbaşarabilmeniz lazım.
Dialogue: 0,0:19:02.02,0:19:04.69,Main,,0,0,0,,- Tamamdır. Yap haydi.\N- Ne ara?!
Dialogue: 0,0:19:04.69,0:19:07.40,Main,,0,0,0,,Dur, daha hazır değilim ben!
Dialogue: 0,0:19:09.20,0:19:12.03,Main,,0,0,0,,Harbiden yanıp kül olacağız!
Dialogue: 0,0:19:12.03,0:19:14.62,Main,,0,0,0,,Yan artık!
Dialogue: 0,0:19:15.25,0:19:16.45,Main,,0,0,0,,Tamamdır!
Dialogue: 0,0:19:20.75,0:19:21.88,Main,,0,0,0,,Yanıyorum!
Dialogue: 0,0:19:21.88,0:19:24.17,Main,,0,0,0,,Çabuk olun! Luffy! Nami!
Dialogue: 0,0:19:39.94,0:19:43.11,Main,,0,0,0,,Kurtulduk!
Dialogue: 0,0:19:45.49,0:19:50.61,Main,,0,0,0,,Daha önce de böyle bir şey\Nbaşıma gelmişti sanki.
Dialogue: 0,0:19:50.61,0:19:53.83,Main,,0,0,0,,Kusura bakmayın.
Dialogue: 0,0:19:55.08,0:19:58.79,Main,,0,0,0,,Sayende ellerimi koparmama\Ngerek kalmadı, teşekkürler!
Dialogue: 0,0:19:58.79,0:20:02.67,Main,,0,0,0,,Sahi ya, ilk karşılaşmamız...
Dialogue: 0,0:20:03.17,0:20:06.13,Main,,0,0,0,,...böyle bir zindanda olmuştu.
Dialogue: 0,0:20:07.01,0:20:12.67,Main,,0,0,0,,Bakın! Hepsi de sizinle aynı kitapta\Nesir tutuluyordu.
Dialogue: 0,0:20:12.67,0:20:16.89,Main,,0,0,0,,Hayal gücünüz gibi Kitaplar Diyarı'nın da\Nucu bucağı yoktur.
Dialogue: 0,0:20:16.89,0:20:22.23,Main,,0,0,0,,Big Mom'ın Mont d'Or gibi\Nbirçok güçlü dalkavuğu var.
Dialogue: 0,0:20:26.86,0:20:31.20,Main,,0,0,0,,Teşekkürler Jinbe!\NAma burada ne arıyorsun sen?
Dialogue: 0,0:20:32.13,0:20:38.70,Main,,0,0,0,,Kaptanı olduğum Güneş Korsanları\NBig Mom'ın filosuna bağlı.
Dialogue: 0,0:20:38.70,0:20:40.62,Main,,0,0,0,,Ne?!
Dialogue: 0,0:20:40.62,0:20:42.95,Main,,0,0,0,,İyi de...
Dialogue: 0,0:20:42.95,0:20:45.25,Main,,0,0,0,,...o zaman bu yaptığın...
Dialogue: 0,0:20:45.67,0:20:50.17,Main,,0,0,0,,Evet, isyan.\NGeri dönüşü olmayan bir yola girdim.
Dialogue: 0,0:20:51.13,0:20:52.45,Main,,0,0,0,,Başına iş almayasın?
Dialogue: 0,0:20:52.45,0:20:56.36,Main,,0,0,0,,Balık Adam Adası'ndayken bazı\Nsorumlulukların olduğunu söylemiştin.
Dialogue: 0,0:20:56.36,0:20:58.32,Main,,0,0,0,,Hepsinden kurtuldum gitti.
Dialogue: 0,0:20:58.32,0:21:01.47,Main,,0,0,0,,Zindan Kütüphanesi'nden çığlıklar duyulmuş!
Dialogue: 0,0:21:01.47,0:21:04.44,Main,,0,0,0,,- Neler oluyor orada?!\N- Hemen de fark ettiler!
Dialogue: 0,0:21:04.44,0:21:06.62,Main,,0,0,0,,Gerçekten de çok hızlılar.
Dialogue: 0,0:21:06.62,0:21:10.99,Main,,0,0,0,,Öncelikle bizi bulamayacakları\Nbir yere saklanmamız gerek.
Dialogue: 0,0:21:10.99,0:21:13.89,Main,,0,0,0,,- Haklısın.\N- Gidelim öyleyse!
Dialogue: 0,0:21:15.64,0:21:19.16,Main,,0,0,0,,Birden açlık bastı ya.
Dialogue: 0,0:21:19.16,0:21:21.51,Main,,0,0,0,,Böyle bir durumda acıkabiliyor musun?
Dialogue: 0,0:21:21.51,0:21:26.67,Main,,0,0,0,,Luffy parmağını oynatırken bile normal\Ninsanlardan üç kat fazla enerji harcar.
Dialogue: 0,0:21:26.67,0:21:32.03,Main,,0,0,0,,Sorun değil. Bir şeyler yemek\Nistiyorum demedim.
Dialogue: 0,0:21:33.72,0:21:36.70,Main,,0,0,0,,Karnın gurulduyor ama.
Dialogue: 0,0:21:36.70,0:21:38.51,Main,,0,0,0,,Ona aldırma!
Dialogue: 0,0:21:38.51,0:21:43.69,Flashbacks,,0,0,0,,Senin elinden olmayan\Nhiçbir şey yemeyeceğim ona göre!
Dialogue: 0,0:21:43.69,0:21:47.71,Flashbacks,,0,0,0,,Karnım kazınsa da\Nüzerime mızraklar yağsa da...
Dialogue: 0,0:21:47.71,0:21:52.57,Flashbacks,,0,0,0,,...yerimden kıpırdamayıp\Nseni bekleyeceğim!
Dialogue: 0,0:21:52.57,0:21:55.49,Main,,0,0,0,,Neyse, Jinbe, teşekkürler!
Dialogue: 0,0:21:57.60,0:22:00.60,Flashbacks,,0,0,0,,İşin aslı...
Dialogue: 0,0:22:00.60,0:22:05.82,Flashbacks,,0,0,0,,...Sanji-san'dan evlilik teklifi aldım.
Dialogue: 0,0:22:05.82,0:22:09.32,Flashbacks,,0,0,0,,Evlenmeyeceğim dememin sebebi...
Dialogue: 0,0:22:09.32,0:22:14.30,Flashbacks,,0,0,0,,...Mama'yla tuzağımıza balıklama atlayıp\Nbana aşık olan o dallamayı...
Dialogue: 0,0:22:14.30,0:22:17.10,Flashbacks,,0,0,0,,...düğünün ortasında...
Dialogue: 0,0:22:17.10,0:22:19.98,Flashbacks,,0,0,0,,...kendi ellerimle vuracağım.
Dialogue: 0,0:22:19.98,0:22:22.21,Main,,0,0,0,,Başımıza daha kötüsü gelemez!
Dialogue: 0,0:22:22.21,0:22:27.10,Main,,0,0,0,,Biz de Sanji de oyuna getirildik!\NOna söylemem lazım!
Dialogue: 0,0:22:27.10,0:22:29.82,Main,,0,0,0,,Nami'ye göz kulak ol Jinbe!
Dialogue: 0,0:22:29.82,0:22:33.70,Main,,0,0,0,,Luffy, bekle! \NŞatoda sayısız güçlü düşman var!
Dialogue: 0,0:22:33.70,0:22:38.74,Main,,0,0,0,,Hem tam olarak da iyileşmedin!\NSabah olanları unuttun mu?!
Dialogue: 0,0:22:38.74,0:22:41.73,Main,,0,0,0,,Bu sefer yenilmeyeceğim!
Dialogue: 0,0:22:55.25,0:22:58.94,Captions,,0,0,0,,{\pos(1150,405)}{\fad(450,200)}Sağlık\NMerkezi
Dialogue: 0,0:22:58.94,0:23:00.40,Main,,0,0,0,,Bana inanıyor musun?
Dialogue: 0,0:23:00.40,0:23:05.30,Main,,0,0,0,,Elbette inanıyorum.\NBana yalan söylemeyeceğini biliyorum.
Dialogue: 0,0:23:05.30,0:23:09.77,Main,,0,0,0,,Ama Pudding'in gerçek yüzünün\Nbu denli çirkin çıkmasını beklemiyordum.
Dialogue: 0,0:23:09.77,0:23:11.79,Main,,0,0,0,,Tam olarak emin değildim.
Dialogue: 0,0:23:11.79,0:23:15.25,Main,,0,0,0,,Fakat sütten çıkmış ak kaşık gibi\Ngözüktüğünden...
Dialogue: 0,0:23:15.25,0:23:17.79,Main,,0,0,0,,...onu gizlice takip ediyordum.
Dialogue: 0,0:23:18.40,0:23:23.47,Main,,0,0,0,,En başından beri benimle evlenmeyip\Nhepimizi öldürmeyi planlıyorsa...
Dialogue: 0,0:23:23.47,0:23:29.08,Main,,0,0,0,,...onunla evlendiğim sürece Luffyler'i\Nbağışlayacakları için verdikleri söz de...
Dialogue: 0,0:23:29.08,0:23:33.38,Main,,0,0,0,,...hiçbir anlam ifade etmez!
Dialogue: 0,0:23:33.38,0:23:38.25,Main,,0,0,0,,Ateşe yalnızca kendimi atarsam\Nher şey yoluna girecek sanmıştım!
Dialogue: 0,0:23:38.25,0:23:44.26,Main,,0,0,0,,Meğer hayal görüyormuşum!\NNasıl bu kadar naif olabilirim?!
Dialogue: 0,0:23:44.26,0:23:49.52,Main,,0,0,0,,Babamız çok zeki bir adam olsa da\Nbu olayda kibrine yenik düştü.
Dialogue: 0,0:23:49.52,0:23:55.94,Main,,0,0,0,,Bir Yonkou ile masaya otururken\Ndaha temkinli olmalıydı.
Dialogue: 0,0:23:55.94,0:23:59.70,Main,,0,0,0,,Fakat bizim için de fırsat doğdu.
Dialogue: 0,0:23:59.70,0:24:02.81,Main,,0,0,0,,Germa'nın yok edilmesi\Ngerektiğini düşünüyorum.
Dialogue: 0,0:24:03.83,0:24:07.06,Main,,0,0,0,,Hiçbir şey bilmiyor gibi davranıp...
Dialogue: 0,0:24:07.06,0:24:09.70,Main,,0,0,0,,...Big Mom'ın planını uygulamasına\Nizin verelim.
Dialogue: 0,0:24:09.70,0:24:14.04,Main,,0,0,0,,Neler diyorsun?! Çay partisine katılırsan\Nsen de öleceksin Reiju!
Dialogue: 0,0:24:14.04,0:24:17.84,Main,,0,0,0,,Bak sen?\NBenim için mi endişeleniyorsun?
Dialogue: 0,0:24:21.43,0:24:24.88,Main,,0,0,0,,Birlikte geçirdiğimiz son anlar\Npek de iç açıcı değil.
Dialogue: 0,0:24:24.88,0:24:28.52,Main,,0,0,0,,Zamanında sana yardım ettiğim için\Nkendini borçlu falan hissetme.
Dialogue: 0,0:24:29.98,0:24:33.52,Main,,0,0,0,,Hasır Şapkalar'la birlikte\Nbu adadan kaç Sanji.
Dialogue: 0,0:24:33.52,0:24:37.98,Main,,0,0,0,,Ne?! Yapamam! Kaçsam bile\NBaratie'ye ne olacak?!
Dialogue: 0,0:24:37.98,0:24:41.44,Main,,0,0,0,,Kaçtıktan sonra bir şeyler düşünürsün.
Dialogue: 0,0:24:41.44,0:24:43.80,Main,,0,0,0,,Burada kalırsan hepimiz öleceğiz.
Dialogue: 0,0:24:43.80,0:24:48.24,Main,,0,0,0,,Sanji, sen ölemezsin!\NAnnemizin hatrına!
Dialogue: 0,0:24:48.24,0:24:49.67,Main,,0,0,0,,Ne demek istiyorsun?!
Dialogue: 0,0:24:50.14,0:24:55.13,Main,,0,0,0,,Bir türlü aklımdan çıkmayan\Nbir anı var.
Dialogue: 0,0:25:02.55,0:25:05.76,Main,,0,0,0,,Ne anısından bahsediyorsun?
Dialogue: 0,0:25:06.49,0:25:09.12,Main,,0,0,0,,Ebeveynlerimiz arasındaki\Nşiddetli bir tartışma.
Dialogue: 0,0:25:09.12,0:25:11.27,Main,,0,0,0,,Daha çocuk olduğumdan...
Dialogue: 0,0:25:11.27,0:25:16.48,Main,,0,0,0,,...o kibar annemizin küplere binmesinin\Nnedenini merak ediyordum.
Dialogue: 0,0:25:16.48,0:25:19.86,Main,,0,0,0,,Sonrasında ise\Nher şey gün yüzüne çıktı.
Dialogue: 0,0:25:20.82,0:25:24.42,Main,,0,0,0,,Annem o sıra hamileydi.
Dialogue: 0,0:25:24.42,0:25:30.26,Main,,0,0,0,,Dördünüzü katil makinelere dönüştürmeye\Ntüm benliğiyle karşı çıkmıştı!
Dialogue: 0,0:25:30.75,0:25:33.26,Flashbacks,,0,0,0,,- Ciddi misin sen?!\N- Herhâlde!
Dialogue: 0,0:25:33.26,0:25:36.27,Flashbacks,,0,0,0,,Nasıl böyle vicdansız bir şey yaparsın?!
Dialogue: 0,0:25:36.27,0:25:39.13,Flashbacks,,0,0,0,,Ameliyat hazırlıkları tamamlandı bile.
Dialogue: 0,0:25:39.13,0:25:42.19,Flashbacks,,0,0,0,,Yapma!\NBenim çocuklarım onlar!
Dialogue: 0,0:25:42.19,0:25:46.01,Flashbacks,,0,0,0,,Duyguları olmazsa insan da olmazlar!
Dialogue: 0,0:25:46.01,0:25:50.06,Flashbacks,,0,0,0,,Canavar olsunlar bana yeter.\NMühim olan savaş kazanmaları.
Dialogue: 0,0:25:51.85,0:25:57.25,Flashbacks,,0,0,0,,Zamanında Kuzey Mavi'yi fetheden\NVinsmoke Ailesi küllerinden doğacak!
Dialogue: 0,0:25:57.25,0:26:01.04,Flashbacks,,0,0,0,,Bu hayali gerçekleştirmek için de\Ngüce ihtiyacımız var!
Dialogue: 0,0:26:01.04,0:26:04.87,Flashbacks,,0,0,0,,Çocuklarıma ise\Nen büyük gücü bahşedeceğim!
Dialogue: 0,0:26:05.78,0:26:07.86,Flashbacks,,0,0,0,,- Ne?!\N- Götürün onu!
Dialogue: 0,0:26:07.86,0:26:10.05,Flashbacks,,0,0,0,,Ne yapıyorsunuz?!\Nİstemiyorum! Bırakın!
Dialogue: 0,0:26:10.05,0:26:13.20,Flashbacks,,0,0,0,,Hayatım! Yapma!\NBenim çocuklarım onlar!
Dialogue: 0,0:26:13.20,0:26:14.29,Flashbacks,,0,0,0,,Yapma!
Dialogue: 0,0:26:15.03,0:26:17.96,Main,,0,0,0,,{\i1}Sonra da ameliyat gerçekleşti.
Dialogue: 0,0:26:20.71,0:26:28.25,Main,,0,0,0,,Gelgelelim annemiz, babamızın planını\Nbozmak için zehir içti.
Dialogue: 0,0:26:43.86,0:26:46.38,Flashbacks,,0,0,0,,Hey, ne yapıyorsun Sora?!
Dialogue: 0,0:26:46.38,0:26:51.37,Main,,0,0,0,,{\i1}Değiştirilmiş gen özlerini dahi\Netkileyebilecek kadar güçlü bir zehirdi.
Dialogue: 0,0:26:54.16,0:26:57.08,Main,,0,0,0,,{\i1}Lakin gözü kara çabası boşa çıktı.
Dialogue: 0,0:26:59.33,0:27:05.38,Main,,0,0,0,,{\i1}Kardeşlerimin bedenlerinde insanüstü\Nanomaliler ortaya çıkıp durdu.
Dialogue: 0,0:27:05.38,0:27:07.13,Flashbacks,,0,0,0,,İnanılmaz!
Dialogue: 0,0:27:10.55,0:27:13.43,Flashbacks,,0,0,0,,- Ameliyat başarıyla sonuçlanmış.\N- Güzel!
Dialogue: 0,0:27:13.43,0:27:19.71,Flashbacks,,0,0,0,,{\i1}Merak etmeyin! \NGenetik haritaları zehirden etkilenmeyecektir!
Dialogue: 0,0:27:28.75,0:27:30.71,Flashbacks,,0,0,0,,Oynayalım haydi!
Dialogue: 0,0:27:30.71,0:27:34.93,Flashbacks,,0,0,0,,Ama çok tuhaftır ki yalnızca Sanji-sama...
Dialogue: 0,0:27:34.93,0:27:40.10,Flashbacks,,0,0,0,,Öyle bir şey olamaz.\NBiraz daha büyümesini bekleyelim.
Dialogue: 0,0:27:55.22,0:27:59.28,Flashbacks,,0,0,0,,Aç mısınız? Bekleyin biraz.
Dialogue: 0,0:27:59.28,0:28:00.48,Flashbacks,,0,0,0,,Alın bakayım.
Dialogue: 0,0:28:01.65,0:28:03.24,Flashbacks,,0,0,0,,Beğendiniz mi?
Dialogue: 0,0:28:05.07,0:28:08.02,Flashbacks,,0,0,0,,Sanji-{\i1}sama kuşları besliyor!
Dialogue: 0,0:28:08.02,0:28:10.57,Flashbacks,,0,0,0,,Böyle bir kişiliği olmaması lazımdı!
Dialogue: 0,0:28:10.57,0:28:12.03,Flashbacks,,0,0,0,,Sora!
Dialogue: 0,0:28:12.75,0:28:16.92,Main,,0,0,0,,İnsan olarak büyümeye devam ettin.
Dialogue: 0,0:28:16.92,0:28:21.42,Main,,0,0,0,,Diğer taraftan annemiz, aldığı zehrin\Nyan etkilerinden dolayı...
Dialogue: 0,0:28:21.42,0:28:23.72,Main,,0,0,0,,...gitgide zayıf düşmeye başladı.
Dialogue: 0,0:28:24.26,0:28:27.27,Main,,0,0,0,,Yani benim yüzümden mi öldü?!
Dialogue: 0,0:28:27.27,0:28:29.21,Main,,0,0,0,,Öyle bir şeyi aklına bile getirme!
Dialogue: 0,0:28:31.51,0:28:32.80,Flashbacks,,0,0,0,,Anne...
Dialogue: 0,0:28:32.80,0:28:36.00,Flashbacks,,0,0,0,,Reiju! Gel kızım!
Dialogue: 0,0:28:37.42,0:28:39.23,Flashbacks,,0,0,0,,Baban neler yapıyor?
Dialogue: 0,0:28:40.05,0:28:43.58,Flashbacks,,0,0,0,,Bize sürekli antrenman yaptırıyor,\Nhiç bizimle oyun oynamıyor!
Dialogue: 0,0:28:43.58,0:28:48.57,Flashbacks,,0,0,0,,Ichiji, Niji ve Yonji'nin tam bir\Nasker gibi davranmasından çok memnun!
Dialogue: 0,0:28:50.56,0:28:51.87,Flashbacks,,0,0,0,,Demek öyle.
Dialogue: 0,0:28:51.87,0:28:53.34,Flashbacks,,0,0,0,,O nedir peki?
Dialogue: 0,0:28:53.34,0:28:57.50,Flashbacks,,0,0,0,,Sanji bana yemek yapmış!
Dialogue: 0,0:28:57.50,0:28:59.13,Flashbacks,,0,0,0,,Sanji mi?
Dialogue: 0,0:29:01.88,0:29:08.13,Flashbacks,,0,0,0,,Sanji bugün ne dedi biliyor musun?
Dialogue: 0,0:29:09.12,0:29:12.22,Flashbacks,,0,0,0,,"Çabucak iyileş." dedi.
Dialogue: 0,0:29:13.70,0:29:15.99,Flashbacks,,0,0,0,,Dünyadaki en tatlı çocuk ya!
Dialogue: 0,0:29:18.35,0:29:21.52,Flashbacks,,0,0,0,,Burada ne arıyorsun?!
Dialogue: 0,0:29:21.52,0:29:23.06,Flashbacks,,0,0,0,,Baba...
Dialogue: 0,0:29:27.05,0:29:31.99,Flashbacks,,0,0,0,,Oğullarımın bir cesede çiçek\Ngetirmek gibi bir şefkate ihtiyacı yok!
Dialogue: 0,0:29:44.96,0:29:47.71,Flashbacks,,0,0,0,,Zırlamayı kes!
Dialogue: 0,0:29:49.86,0:29:51.51,Flashbacks,,0,0,0,,Ödlek!
Dialogue: 0,0:29:51.51,0:29:53.20,Flashbacks,,0,0,0,,Sulu göz!
Dialogue: 0,0:29:56.87,0:29:57.96,Flashbacks,,0,0,0,,Gidelim.
Dialogue: 0,0:29:59.75,0:30:01.60,Flashbacks,,0,0,0,,Sen de geliyorsun.
Dialogue: 0,0:30:03.08,0:30:04.31,Flashbacks,,0,0,0,,Emredersiniz.
Dialogue: 0,0:30:07.38,0:30:11.37,Main,,0,0,0,,{\i1}Gelgelelim babamızın ülküsü, annemizinkine\Ntaban tabana zıt olduğundan...
Dialogue: 0,0:30:12.09,0:30:15.27,Main,,0,0,0,,{\i1}...kişiliğini hiçbir zaman onaylamadı.
Dialogue: 0,0:30:18.87,0:30:24.40,Main,,0,0,0,,{\i1}Yaşananlar için seni suçlayarak\Nresmen işkence etti.
Dialogue: 0,0:30:24.91,0:30:27.72,Flashbacks,,0,0,0,,Bir daha sakın yemek pişirme!
Dialogue: 0,0:30:27.72,0:30:31.38,Flashbacks,,0,0,0,,Ne yapıyorsun?! Saldırsana!
Dialogue: 0,0:30:34.32,0:30:37.27,Flashbacks,,0,0,0,,Sanji beş para etmez bir fiyasko!
Dialogue: 0,0:30:37.27,0:30:39.71,Flashbacks,,0,0,0,,Fiyasko! Fiyasko!
Dialogue: 0,0:30:50.83,0:30:53.83,Flashbacks,,0,0,0,,Koş!!
Dialogue: 0,0:30:53.83,0:30:56.20,Flashbacks,,0,0,0,,Arkana bakma!!
Dialogue: 0,0:30:56.20,0:31:03.42,Main,,0,0,0,,Annemiz artık aramızda olmasa da\Nnezaketi seninle birlikte yaşıyor.
Dialogue: 0,0:31:03.42,0:31:07.42,Main,,0,0,0,,Fiyasko falan da değilsin.
Dialogue: 0,0:31:07.42,0:31:11.27,Main,,0,0,0,,Annemizin\Nhayatı pahasına koruduğu çocuğu...
Dialogue: 0,0:31:11.27,0:31:14.67,Main,,0,0,0,,...insan vasıfları taşıyarak doğdu.
Dialogue: 0,0:31:14.67,0:31:18.60,Main,,0,0,0,,O da sen oluyorsun Sanji.
Dialogue: 0,0:31:18.60,0:31:23.69,Main,,0,0,0,,Bu yüzden herkesten\Nçok daha şefkatlisin!
Dialogue: 0,0:31:31.06,0:31:33.11,Main,,0,0,0,,Hasır Şapka'yı arayın!
Dialogue: 0,0:31:33.11,0:31:34.78,Main,,0,0,0,,Hangi yöne gitti?
Dialogue: 0,0:31:34.78,0:31:38.95,Main,,0,0,0,,Zindan Kütüphanesi'nden kaçıp ilk kata\Nulaşmayı başardı bile!
Dialogue: 0,0:31:38.95,0:31:42.12,Main,,0,0,0,,- Tüm manga doğruca ikinci kata!\N- Baş üstüne!
Dialogue: 0,0:31:46.08,0:31:48.71,Main,,0,0,0,,Sanji!{\an8}
Dialogue: 0,0:31:46.20,0:31:48.71,Captions,,0,0,0,,{\fad(500,0)}Whole Cake Şatosu - İkinci Kat
Dialogue: 0,0:31:49.08,0:31:53.09,Captions,,0,0,0,,{\pos(633,544)}{\fad(500,0)}Hazine Ambarı \NGirişi
Dialogue: 0,0:31:50.37,0:31:53.09,Main,,0,0,0,,Ne?! Bir sorunumuz daha mı var?{\an8}
Dialogue: 0,0:31:53.09,0:31:56.67,Main,,0,0,0,,Evet efendim.\NPatron Jinbe şatoya girmiş...
Dialogue: 0,0:31:56.67,0:31:58.52,Main,,0,0,0,,İsyan mı çıkardı yoksa?!
Dialogue: 0,0:31:58.52,0:32:01.72,Main,,0,0,0,,Pekâlâ, tüm askerlere şunu ilet.
Dialogue: 0,0:32:01.72,0:32:03.22,Main,,0,0,0,,Peki.
Dialogue: 0,0:32:06.93,0:32:10.64,Main,,0,0,0,,Yarınki vazifemiz, \NMama'nın uzun zamandır beklediği hayali olur.
Dialogue: 0,0:32:10.64,0:32:11.31,Main,,0,0,0,,E- Evet!
Dialogue: 0,0:32:11.31,0:32:14.19,Main,,0,0,0,,- Çuvallarsak ne olur sence?\N- Ne?!
Dialogue: 0,0:32:14.19,0:32:18.26,Main,,0,0,0,,En kötü ihtimalle ne olur diyorum?
Dialogue: 0,0:32:25.70,0:32:28.73,Main,,0,0,0,,D- Düşünmek bile istemiyorum.
Dialogue: 0,0:32:28.73,0:32:30.25,Main,,0,0,0,,Ben de.
Dialogue: 0,0:32:30.25,0:32:35.03,Main,,0,0,0,,Huysuz Mama'mıza başka sorunları da\Nduyurursak...
Dialogue: 0,0:32:35.03,0:32:37.30,Main,,0,0,0,,...yarınki vazifemiz ziyadesiyle etkilenir.
Dialogue: 0,0:32:37.30,0:32:39.47,Main,,0,0,0,,Kesinlikle!
Dialogue: 0,0:32:39.47,0:32:41.50,Main,,0,0,0,,Ne yapacağız öyleyse?
Dialogue: 0,0:32:42.38,0:32:46.23,Main,,0,0,0,,Y- Yoksa benden yalan söylememi...
Dialogue: 0,0:32:46.23,0:32:48.79,Main,,0,0,0,,Mama'ya yalan söylersen\Nölüm cezasına çarptırılırsın.
Dialogue: 0,0:32:48.79,0:32:51.13,Main,,0,0,0,,C- Canımı bağışlayın!
Dialogue: 0,0:32:51.13,0:32:56.49,Main,,0,0,0,,Fakat ortada sorun falan yoksa\Nkendisini bilgilendirmemiz de gerekmiyor.
Dialogue: 0,0:32:56.49,0:32:58.01,Main,,0,0,0,,Haksız mıyım?!
Dialogue: 0,0:32:58.01,0:33:00.44,Main,,0,0,0,,H- Haklısınız efendim!
Dialogue: 0,0:33:02.48,0:33:04.03,Main,,0,0,0,,Şu an dördüncü kattayız.
Dialogue: 0,0:33:04.03,0:33:06.98,Main,,0,0,0,,Bu kata çıkan tüm yolları kapatın!
Dialogue: 0,0:33:06.98,0:33:09.70,Main,,0,0,0,,İşlerinizi alt katlarda görün.
Dialogue: 0,0:33:09.70,0:33:12.40,Main,,0,0,0,,Sorunları da derhâl çözmeye bakın!
Dialogue: 0,0:33:12.40,0:33:15.12,Main,,0,0,0,,Emredersiniz! Anlaşıldı!
Dialogue: 0,0:33:15.12,0:33:19.34,Main,,0,0,0,,Öyleyse sağ yakalamaktansa\Ndoğruca öldürmemiz daha garanti olur!
Dialogue: 0,0:33:19.34,0:33:23.13,Main,,0,0,0,,- Fark etmez! İzin veriyorum!\N- Emredersiniz!
Dialogue: 0,0:33:23.13,0:33:27.10,Main,,0,0,0,,Sanji nerede lan?!
Dialogue: 0,0:33:32.57,0:33:35.28,Main,,0,0,0,,Nerede diyorum?!
Dialogue: 0,0:33:37.24,0:33:39.49,Main,,0,0,0,,Daha düşünecek ne var ki?
Dialogue: 0,0:33:40.25,0:33:42.93,Main,,0,0,0,,Cevabını çoktan aldın işte.
Dialogue: 0,0:33:43.61,0:33:46.75,Main,,0,0,0,,Germa'yı geride bırakıp kaç git Sanji.
Dialogue: 0,0:33:46.75,0:33:51.74,Main,,0,0,0,,Germa mazideki ihtişamına saplanmış kalmış,\Nyıkımdan başka bir şeyi de temsil etmiyor.
Dialogue: 0,0:33:51.74,0:33:54.97,Main,,0,0,0,,Dünyanın bize ihtiyacı yok.
Dialogue: 0,0:33:54.97,0:33:58.76,Main,,0,0,0,,Big Mom'ın tek istediği ise\Nbilimsel teknolojimiz.
Dialogue: 0,0:33:59.34,0:34:03.89,Main,,0,0,0,,Akıl hocanın canını almakla\Nilgilendiğini hiç sanmıyorum.
Dialogue: 0,0:34:05.10,0:34:10.34,Main,,0,0,0,,Deniz restoranını rehin tutan\Nbaban ve kardeşlerin de...
Dialogue: 0,0:34:10.34,0:34:11.98,Main,,0,0,0,,...yarın bu dünyadan göçüp gidecek.
Dialogue: 0,0:34:12.52,0:34:17.11,Main,,0,0,0,,Hak ettiğimizi bulduk işte.\NBir suikastçı grubuyuz neticede.
Dialogue: 0,0:34:17.61,0:34:22.87,Main,,0,0,0,,Onlara karşı nefretten başka bir duygu\Nhissetmediğim doğrudur ama sen ne diye ölesin ki?!
Dialogue: 0,0:34:23.57,0:34:26.44,Main,,0,0,0,,İçimde bir nebze insanlık\Nkalmış olsa da...
Dialogue: 0,0:34:26.44,0:34:31.53,Main,,0,0,0,,...babamıza itaatsizlik etmemek için\Ngenleriyle oynanmış bir suç ortağıyım.
Dialogue: 0,0:34:32.41,0:34:34.34,Main,,0,0,0,,Benim ellerime de kan bulaştı.
Dialogue: 0,0:34:34.96,0:34:36.80,Main,,0,0,0,,Ölmeyi hak ediyorum.
Dialogue: 0,0:34:38.80,0:34:42.13,Main,,0,0,0,,Söylemeyi unuttum bu arada,\Nbileğindeki kelepçeler...
Dialogue: 0,0:34:43.60,0:34:47.68,Main,,0,0,0,,...patlamayacaklar,\Nsahteleriyle değiştirmiştim çünkü.
Dialogue: 0,0:34:49.87,0:34:54.07,Main,,0,0,0,,Burada kalman için\Nbaşka bir sebep kaldı mı?
Dialogue: 0,0:34:55.90,0:34:58.45,Main,,0,0,0,,Kendine gel artık Sanji!
Dialogue: 0,0:35:01.87,0:35:03.99,Main,,0,0,0,,Çekilin lan!
Dialogue: 0,0:35:05.13,0:35:07.91,Main,,0,0,0,,Değer verdiklerini gözünde canlandır!
Dialogue: 0,0:35:08.47,0:35:10.75,Main,,0,0,0,,Değer verdiklerim...
Dialogue: 0,0:35:10.75,0:35:13.64,Main,,0,0,0,,Hasır Şapka'yı durdurun!
Dialogue: 0,0:35:19.47,0:35:22.25,Flashbacks,,0,0,0,,Tayfama katılsana!
Dialogue: 0,0:35:22.25,0:35:24.67,Flashbacks,,0,0,0,,Korsan gemimin aşçısı ol!
Dialogue: 0,0:35:24.67,0:35:27.52,Main,,0,0,0,,Neredesin?!
Dialogue: 0,0:35:30.10,0:35:34.36,Flashbacks,,0,0,0,,İyi bir aşçısın sen,\Ngel de benimle birlikte korsan ol!
Dialogue: 0,0:35:34.81,0:35:37.11,Main,,0,0,0,,Onlar gibi gerçek dostları...
Dialogue: 0,0:35:37.73,0:35:40.15,Main,,0,0,0,,...ömrün boyunca...
Dialogue: 0,0:35:40.15,0:35:42.08,Main,,0,0,0,,...bir daha bulamazsın!
Dialogue: 0,0:35:44.58,0:35:46.52,Main,,0,0,0,,Çekilin!
Dialogue: 0,0:35:46.52,0:35:49.11,Main,,0,0,0,,Sanji!!
Dialogue: 0,0:35:49.11,0:35:53.90,Credits,,0,0,0,,Editing:\N Feeso,\NGalaxy 9000\N\NTiming:\NHalee\N\NQuality Assurance:\NFeeso,\NGalaxy 9000,\NGrug,\NPepperjack\N\NSoundtracking:\N Halee\N\NInfoboxes & Title:\N Datenshi\N\NKaraoke:\NKaitouYahiko\N\NAttack Effects:\NKaitouYahiko\N\NTranslation:\NCrunchyroll
