,1,2.2,0,7,10,10,10,1Style: Author,Impress BT,22.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.7,0.7,9,10,10,10,1Style: Attack,Duality,30.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.0,1.0,7,12,12,12,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:01:34.65,0:01:39.03,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - dmc3 thx to onepace.netDialogue: 0,0:15:43.40,0:15:53.40,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - dmc3 thx to onepace.netDialogue: 0,0:32:10.67,0:32:15.30,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - dmc3 thx to onepace.netDialogue: 0,0:01:34.65,0:01:39.03,Title,,0,0,250,,Mink Kabilesi Muhafız Şefi PedroDialogue: 0,0:01:39.43,0:01:40.59,Main,,0,0,0,,Ayağım...Dialogue: 0,0:01:42.53,0:01:44.89,Main,,0,0,0,,Kahretsin! Kıpırdayamıyorum!Dialogue: 0,0:01:45.35,0:01:46.27,Main,,0,0,0,,Chopper-san!Dialogue: 0,0:01:50.00,0:01:51.37,Main,,0,0,0,,Brook!Dialogue: 0,0:01:53.80,0:01:55.44,Main,,0,0,0,,Beyinsizler...Dialogue: 0,0:01:55.44,0:02:01.03,Main,,0,0,0,,Şekerler aheste aheste vücudunuza nüfuz edecek.Dialogue: 0,0:02:05.70,0:02:09.89,Main,,0,0,0,,Direnmeniz boşa. Burada çakılı kaldınız artık.Dialogue: 0,0:02:13.65,0:02:14.78,Main,,0,0,0,,Chopper-san!Dialogue: 0,0:02:16.49,0:02:19.08,Main,,0,0,0,,Paniklemesenize yahu!Dialogue: 0,0:02:19.08,0:02:20.55,Main,,0,0,0,,Hayret bir şey ya...Dialogue: 0,0:02:21.14,0:02:27.67,Main,,0,0,0,,Nasıl bir hayal dünyasında yaşıyorsunuz da gemiyi geri alabileceğinize inandınız?Dialogue: 0,0:02:27.67,0:02:31.30,Main,,0,0,0,,Sizi yakalamak uğruna...Dialogue: 0,0:02:31.30,0:02:35.39,Main,,0,0,0,,...muhtelif noktalarda kuşatma gerçekleştirmek için...Dialogue: 0,0:02:35.39,0:02:39.02,Main,,0,0,0,,...adanın dört bir yanındaki askerlerimizi seferber ettik.Dialogue: 0,0:02:39.02,0:02:42.57,Main,,0,0,0,,Kaçacak deliğiniz yok.Dialogue: 0,0:02:43.55,0:02:46.99,Main,,0,0,0,,Aramızdaki güç farkı ortada!Dialogue: 0,0:02:48.34,0:02:50.49,Main,,0,0,0,,Sıçayım!Dialogue: 0,0:02:50.49,0:02:54.00,Main,,0,0,0,,D... Dönüşemiyorum bile!Dialogue: 0,0:02:54.00,0:02:56.00,Main,,0,0,0,,Chopper-san'ı bırak!Dialogue: 0,0:02:56.00,0:02:58.74,Main,,0,0,0,,Andaval! İş işten geçti artık!Dialogue: 0,0:02:58.74,0:03:01.71,Main,,0,0,0,,Bana karşı çıkmanızın cezası işte!Dialogue: 0,0:03:01.71,0:03:05.04,Main,,0,0,0,,Sizi şekerden adamlara çevirip bir güzel yalayacağım!Dialogue: 0,0:03:07.28,0:03:10.51,Main,,0,0,0,,Şekerler tüm bedeninizi kaplayıp...Dialogue: 0,0:03:10.51,0:03:13.76,Main,,0,0,0,,...iç organlarınıza girerek nefes almanızı önleyecek.Dialogue: 0,0:03:13.76,0:03:16.83,Main,,0,0,0,,Büyük bir acı eşliğinde...Dialogue: 0,0:03:17.71,0:03:21.36,Main,,0,0,0,,...şekerlerimin avı öldürmeleri yalnızca üç dakika sürer!Dialogue: 0,0:03:22.87,0:03:23.82,Main,,0,0,0,,Olamaz!Dialogue: 0,0:03:23.82,0:03:30.08,Main,,0,0,0,,İşte o zaman şaheserim tamamlanmış oluyor! Şekerden bi' ceset, Şeker Adam!Dialogue: 0,0:03:36.60,0:03:38.26,Main,,0,0,0,,Chopper-san!Dialogue: 0,0:03:38.26,0:03:39.92,Main,,0,0,0,,Kes şunu!Dialogue: 0,0:03:44.45,0:03:47.96,Main,,0,0,0,,Seçimlerinizden pişman olmak için çok geç artık!Dialogue: 0,0:03:47.96,0:03:50.84,Main,,0,0,0,,Size bir şans tanımıştım.Dialogue: 0,0:03:50.84,0:03:54.68,Main,,0,0,0,,İkinize elimi sürmeyeceğim demiştim.Dialogue: 0,0:03:54.68,0:04:01.10,Main,,0,0,0,,Dünyadan haberiniz yok sizin!  Bu ada...Dialogue: 0,0:04:01.10,0:04:04.19,Main,,0,0,0,,...zerre tatlı değil aslında!Dialogue: 0,0:04:04.72,0:04:07.53,Main,,0,0,0,,Chopper-san!Dialogue: 0,0:04:08.52,0:04:11.49,Main,,0,0,0,,...zerre tatlı değil aslında!Dialogue: 0,0:04:18.08,0:04:21.08,Main,,0,0,0,,Sizin gibi tatlı mı tatlı dangalaklar hak ettiğini buldu.Dialogue: 0,0:04:22.86,0:04:26.50,Main,,0,0,0,,Yapma! Tatlıya dönüşmek istemiyorum!Dialogue: 0,0:04:26.50,0:04:28.43,Main,,0,0,0,,Dur!Dialogue: 0,0:04:30.74,0:04:35.82,Main,,0,0,0,,Sizi şeker adamlara çevirip bir güzel yalayacağım!Dialogue: 0,0:04:47.09,0:04:49.15,Main,,0,0,0,,Baksana Peros abi.Dialogue: 0,0:04:50.30,0:04:51.73,Main,,0,0,0,,Mama geliyor.Dialogue: 0,0:04:51.73,0:04:55.62,Main,,0,0,0,,Düğün...Dialogue: 0,0:04:56.10,0:04:58.71,Main,,0,0,0,,Açlık Krizi devam edecek...Dialogue: 0,0:04:58.71,0:05:01.44,Main,,0,0,0,,...pastası!Dialogue: 0,0:05:02.65,0:05:06.50,Main,,0,0,0,,Kakao Adası'ndaki Pudding'e yönlendirmeliyiz.Dialogue: 0,0:05:06.50,0:05:11.30,Main,,0,0,0,,Bu gemide pasta olmadığını çakarsa nalları dikerim.Dialogue: 0,0:05:16.26,0:05:19.08,Main,,0,0,0,,O kadar ilerleme katettiğimizi düşünmüyorum.Dialogue: 0,0:05:22.81,0:05:25.48,Main,,0,0,0,,Pastayı yememe izin verin!Dialogue: 0,0:05:37.48,0:05:39.87,Main,,0,0,0,,Pasta!Dialogue: 0,0:05:39.88,0:05:42.67,Main,,0,0,0,,Kıyıya vardık! Sunny-go'ya atlayalım!Dialogue: 0,0:05:44.44,0:05:47.25,Main,,0,0,0,,Hasır Şapka yaşıyor muymuş?Dialogue: 0,0:05:47.89,0:05:50.80,Main,,0,0,0,,Yıldırıma maruz kalanlar kendi askerlerimiz olmalı.Dialogue: 0,0:05:54.33,0:05:55.39,Main,,0,0,0,,Onlar da kim?Dialogue: 0,0:05:55.84,0:05:58.18,Main,,0,0,0,,Gemi istila edilmiş!Dialogue: 0,0:05:58.18,0:06:00.77,Main,,0,0,0,,Ne? Brook! Chopper!Dialogue: 0,0:06:00.77,0:06:02.02,Main,,0,0,0,,N'oluyor?Dialogue: 0,0:06:03.96,0:06:05.71,Main,,0,0,0,,Ayna Dünyası'na dönün.Dialogue: 0,0:06:07.05,0:06:09.69,Main,,0,0,0,,Yoksa her biriniz...Dialogue: 0,0:06:09.69,0:06:12.82,Main,,0,0,0,,...birkaç saniyeye o herifin ayağının dibinde bayılmış olacaksınız.Dialogue: 0,0:06:15.18,0:06:17.45,Main,,0,0,0,,Aynaya girin çabuk!Dialogue: 0,0:06:17.45,0:06:21.95,Main,,0,0,0,,Perospero ile Katakuri... Gide gide o ikisini bulduk!Dialogue: 0,0:06:21.95,0:06:24.33,Main,,0,0,0,,Felaketlerin ardı arkası kesilmiyor!Dialogue: 0,0:06:26.69,0:06:32.04,Main,,0,0,0,,Buraya varabilmeniz bir mucize. Etkilendim bak.Dialogue: 0,0:06:33.30,0:06:37.55,Main,,0,0,0,,Ama ecelinize koşuyorsunuz!Dialogue: 0,0:06:37.55,0:06:40.27,Main,,0,0,0,,Burada ölmeniz gerek!Dialogue: 0,0:06:48.46,0:06:50.73,Main,,0,0,0,,Candy Maiden!Dialogue: 0,0:06:48.46,0:06:50.73,Attack,,0,0,0,,Şeker TabutDialogue: 0,0:06:50.73,0:06:52.24,Main,,0,0,0,,Şeker duvarı!Dialogue: 0,0:06:52.24,0:06:56.57,Main,,0,0,0,,Sıradan bir duvar olmadığı aşikâr!Dialogue: 0,0:07:02.04,0:07:04.08,Main,,0,0,0,,Gyojin Karate...Dialogue: 0,0:07:02.04,0:07:04.08,Attack,,0,0,0,,Balık Adam Karate...Dialogue: 0,0:07:04.40,0:07:06.33,Main,,0,0,0,,Gomu Gomu no...Dialogue: 0,0:07:08.11,0:07:10.25,Main,,0,0,0,,...Same Gawara Sei Ken!Dialogue: 0,0:07:08.11,0:07:10.25,Attack,,0,0,0,,...Köpekbalığı Tuğla YumruğuDialogue: 0,0:07:10.25,0:07:12.59,Main,,0,0,0,,Jet Bazooka!Dialogue: 0,0:07:10.25,0:07:12.59,Attack,,0,0,0,,Jet BazukaDialogue: 0,0:07:15.80,0:07:16.97,Main,,0,0,0,,İşte bu!Dialogue: 0,0:07:18.90,0:07:20.46,Main,,0,0,0,,Henüz bitmedi...Dialogue: 0,0:07:20.46,0:07:23.80,Main,,0,0,0,,Beni küçümsemeyin!Dialogue: 0,0:07:24.75,0:07:26.31,Main,,0,0,0,,Ha? N'oluyor?Dialogue: 0,0:07:29.75,0:07:31.98,Main,,0,0,0,,Candy Maiden...Dialogue: 0,0:07:29.75,0:07:31.98,Attack,,0,0,0,,Şeker Tabutu...Dialogue: 0,0:07:32.55,0:07:34.40,Main,,0,0,0,,Decoration!Dialogue: 0,0:07:32.55,0:07:34.40,Attack,,0,0,0,,...Süsleme!Dialogue: 0,0:07:35.18,0:07:37.26,Main,,0,0,0,,Kocaman!Dialogue: 0,0:07:37.99,0:07:39.74,Main,,0,0,0,,Yolun sonuna geldiniz!Dialogue: 0,0:07:45.44,0:07:47.33,Main,,0,0,0,,Kimse buradan kaçamaz!Dialogue: 0,0:07:49.82,0:07:51.59,Main,,0,0,0,,Etrafını dolanıp gemiye varalım!Dialogue: 0,0:07:53.46,0:07:55.36,Main,,0,0,0,,Hayır, dümdüz ilerleyin!Dialogue: 0,0:07:59.89,0:08:02.32,Main,,0,0,0,,Gomu Gomu no...Dialogue: 0,0:08:06.23,0:08:08.54,Main,,0,0,0,,Red Hawk!Dialogue: 0,0:08:06.23,0:08:08.54,Attack,,0,0,0,,Kızıl ŞahinDialogue: 0,0:08:17.40,0:08:18.80,Main,,0,0,0,,Alevler mi?Dialogue: 0,0:08:58.24,0:09:01.16,Main,,0,0,0,,Onun-teia yeteneği Luffy'ninkine çok benziyor!Dialogue: 0,0:09:20.13,0:09:23.05,Main,,0,0,0,,Düğün...Dialogue: 0,0:09:24.80,0:09:28.48,Main,,0,0,0,,...pastası!Dialogue: 0,0:09:33.06,0:09:34.23,Main,,0,0,0,,Yaklaşıyor!Dialogue: 0,0:09:38.26,0:09:40.82,Main,,0,0,0,,N'apacağız Luffy? Etrafımız sarıldı!Dialogue: 0,0:09:40.82,0:09:44.01,Main,,0,0,0,,Luffy! Katakuri'yi gemiden indir!Dialogue: 0,0:09:44.01,0:09:46.10,Main,,0,0,0,,Bir şekilde yelken açmaya çalışacağız!Dialogue: 0,0:09:46.10,0:09:47.64,Main,,0,0,0,,Tamamdır!Dialogue: 0,0:09:47.64,0:09:48.90,Main,,0,0,0,,Gemiye!Dialogue: 0,0:09:48.90,0:09:50.26,Main,,0,0,0,,Tamam!Dialogue: 0,0:09:52.71,0:09:55.81,Main,,0,0,0,,Alçak herif!  Ayna boyutundan çıkagelmiş olmalı!Dialogue: 0,0:09:59.48,0:10:05.40,Main,,0,0,0,,Düğün pastası!Dialogue: 0,0:10:06.17,0:10:10.25,Main,,0,0,0,,Mama'nın Açlık Krizi'ne maruz kalmak istemiyorum.Dialogue: 0,0:10:12.68,0:10:15.23,Main,,0,0,0,,Busoshoku!Dialogue: 0,0:10:12.68,0:10:15.23,Note,,0,0,0,,Silahlanma!Dialogue: 0,0:10:17.28,0:10:20.00,Main,,0,0,0,,Gomu Gomu no...Dialogue: 0,0:10:22.05,0:10:25.26,Main,,0,0,0,,Hawk Gatling!Dialogue: 0,0:10:22.05,0:10:25.26,Attack,,0,0,0,,Şahin MitralyözüDialogue: 0,0:10:37.87,0:10:40.91,Main,,0,0,0,,Neden ama?  Haki kullanmama rağmen ona vuramıyorum.Dialogue: 0,0:10:53.36,0:10:55.92,Main,,0,0,0,,Chopper! Brook! İyi misiniz siz?Dialogue: 0,0:10:55.92,0:10:57.09,Main,,0,0,0,,Dayanın!Dialogue: 0,0:11:00.24,0:11:03.26,Main,,0,0,0,,Nerede?Dialogue: 0,0:11:03.26,0:11:05.68,Main,,0,0,0,,Pasta!Dialogue: 0,0:11:10.79,0:11:11.81,Main,,0,0,0,,Carrot.Dialogue: 0,0:11:13.60,0:11:15.60,Main,,0,0,0,,Her şeye hazırlıklı ol.Dialogue: 0,0:11:15.60,0:11:16.36,Main,,0,0,0,,Ne?Dialogue: 0,0:11:17.26,0:11:18.86,Main,,0,0,0,,İnanıyorum ki...Dialogue: 0,0:11:18.86,0:11:20.99,Main,,0,0,0,,...Luffy ve tayfası...Dialogue: 0,0:11:20.99,0:11:27.33,Main,,0,0,0,,...kabilemizin ve Kozuki Klanı'nın asırlardır yolunu gözlediği...Dialogue: 0,0:11:27.33,0:11:31.21,Main,,0,0,0,,...dünyayı yeni bir şafağa taşıyacak kişilerdir!Dialogue: 0,0:11:31.21,0:11:32.67,Main,,0,0,0,,Asırlardır mı?Dialogue: 0,0:11:44.50,0:11:47.64,Main,,0,0,0,,Baksana Mont d'Or, sesim geliyor mu?Dialogue: 0,0:11:47.64,0:11:49.87,Main,,0,0,0,,Evet, geliyor.Dialogue: 0,0:11:49.87,0:11:55.40,Main,,0,0,0,,Whole Cake Adası'nın güneybatı kıyısına savaş gemilerini konuşlandır.Dialogue: 0,0:11:55.40,0:11:58.03,Main,,0,0,0,,Anlaşıldı Peros abi.Dialogue: 0,0:11:59.02,0:12:01.77,Main,,0,0,0,,Hasır Şapkalar hâlâ hayattalar galiba.Dialogue: 0,0:12:04.16,0:12:05.66,Main,,0,0,0,,Bir Coup de...Dialogue: 0,0:12:06.07,0:12:07.44,Main,,0,0,0,,Ne?Dialogue: 0,0:12:07.44,0:12:11.76,Main,,0,0,0,,Coup de Burst!  Gemimiz 1 km ileri atılabilir!Dialogue: 0,0:12:11.76,0:12:15.83,Main,,0,0,0,,Normal yollardan yelken açarsak Big Mom bizi alabora eder!Dialogue: 0,0:12:15.83,0:12:19.60,Main,,0,0,0,,Tam anlamış değilim fakat bu yöntemle kaçabiliriz, değil mi?Dialogue: 0,0:12:19.60,0:12:20.30,Main,,0,0,0,,Evet!Dialogue: 0,0:12:20.30,0:12:23.43,Main,,0,0,0,,Pekâlâ! Onun üzerine oynayalım!Dialogue: 0,0:12:24.93,0:12:26.80,Main,,0,0,0,,Big Mom geliyor!Dialogue: 0,0:12:26.82,0:12:29.26,Main,,0,0,0,,Buldum sizi!Dialogue: 0,0:12:29.91,0:12:32.91,Main,,0,0,0,,Carrot!  Sen-gara yelken açmalarına yardım et!Dialogue: 0,0:12:32.91,0:12:33.70,Main,,0,0,0,,Ne?Dialogue: 0,0:12:33.70,0:12:34.72,Main,,0,0,0,,Çabuk!Dialogue: 0,0:12:34.72,0:12:36.35,Main,,0,0,0,,Peki!Dialogue: 0,0:12:41.17,0:12:44.22,Main,,0,0,0,,Orada mı yoksa?Dialogue: 0,0:12:44.22,0:12:47.61,Main,,0,0,0,,Düğün pastası?!Dialogue: 0,0:12:53.10,0:12:57.28,Main,,0,0,0,,Size diyorum Brook, Chopper! Kendinize gelin!Dialogue: 0,0:12:57.28,0:13:01.54,Main,,0,0,0,,Kaçmayı başarsak bile sizi kaybedersek bir anlamı kalmaz.Dialogue: 0,0:13:03.70,0:13:07.59,Main,,0,0,0,,Güneybatı kıyısındaki Hasır Şapkalar'ın yerini belirledik!Dialogue: 0,0:13:07.59,0:13:11.10,Main,,0,0,0,,Kuru Yemiş Adası Turta Birliği'nden Bakan Amande konuşuyor.Dialogue: 0,0:13:11.10,0:13:13.21,Main,,0,0,0,,Hasır Şapkalar'ı köşeye kıstıracağız.Dialogue: 0,0:13:21.92,0:13:23.41,Main,,0,0,0,,Eyvahlar olsun.Dialogue: 0,0:13:23.41,0:13:27.19,Main,,0,0,0,,Denizden savaş gemileri, karadan ise Big Mom bastırıyor.Dialogue: 0,0:13:27.19,0:13:29.77,Main,,0,0,0,,Çıkmaza düştük!Dialogue: 0,0:13:37.31,0:13:39.74,Main,,0,0,0,,Nami! Elimizi çabuk tutmamız lazım!Dialogue: 0,0:13:39.74,0:13:44.12,Main,,0,0,0,,Biliyorum ama iki kola varili daha doldurmam gerekiyor!Dialogue: 0,0:13:44.12,0:13:48.24,Main,,0,0,0,,Gerisini ben hallederim, sen de Coup-de-falanı hazırla haydi!Dialogue: 0,0:13:48.24,0:13:50.28,Main,,0,0,0,,Tamamdır, ellerinden öper o zaman!Dialogue: 0,0:14:07.90,0:14:10.95,Main,,0,0,0,,Candy Wave!Dialogue: 0,0:14:07.90,0:14:10.95,Attack,,0,0,0,,Şeker DalgasıDialogue: 0,0:14:21.18,0:14:22.50,Main,,0,0,0,,Bu da neydi?Dialogue: 0,0:14:23.85,0:14:25.16,Main,,0,0,0,,Şeker mi?Dialogue: 0,0:14:25.16,0:14:28.75,Main,,0,0,0,,N'apacağız şimdi? Bu durumda Coup de Burst kullanamayız!Dialogue: 0,0:14:37.86,0:14:39.25,Main,,0,0,0,,Ne oldu?Dialogue: 0,0:14:39.25,0:14:42.60,Main,,0,0,0,,Vaziyet sakat! Sunny-go şeker ile kaplandı!Dialogue: 0,0:14:42.61,0:14:43.52,Main,,0,0,0,,Ne?!Dialogue: 0,0:14:47.48,0:14:51.02,Main,,0,0,0,,Şeker Duvarı'nın kudretine tanık oldunuz mu?Dialogue: 0,0:14:51.02,0:14:53.82,Main,,0,0,0,,Mükemmeliyetçi bir kişiliğim var da.Dialogue: 0,0:14:53.82,0:14:55.57,Main,,0,0,0,,Gördüm onu!Dialogue: 0,0:14:58.07,0:14:59.70,Main,,0,0,0,,N'apacağız şimdi?Dialogue: 0,0:14:59.70,0:15:03.66,Main,,0,0,0,,Brook ile Chopper'in yanı sıra gemiyi de eski hâline getir şeker manyağı!Dialogue: 0,0:15:06.16,0:15:07.54,Main,,0,0,0,,Bir şey yapmazsam...Dialogue: 0,0:15:07.54,0:15:10.71,Main,,0,0,0,,Pasta!Dialogue: 0,0:15:10.71,0:15:13.42,Main,,0,0,0,,Ya Mama'nın ellerinde geberip gideceksiniz...Dialogue: 0,0:15:13.42,0:15:17.12,Main,,0,0,0,,...ya da toplar sizi alabora edecek!Dialogue: 0,0:15:30.09,0:15:35.82,Main,,0,0,0,,Her hâlükârda yeni günün ışıklarını göremeyeceksiniz!Dialogue: 0,0:16:10.85,0:16:13.10,Main,,0,0,0,,Juken: Karajishi!Dialogue: 0,0:16:10.85,0:16:13.10,Attack,,0,0,0,,Canavar Kılıç: KarajishiDialogue: 0,0:16:23.51,0:16:27.69,Main,,0,0,0,,Baksana, ne kadarlık kelle ödülüm olduğunu biliyor musun ki?Dialogue: 0,0:16:27.69,0:16:29.37,Main,,0,0,0,,700 milyon canım benim.Dialogue: 0,0:16:30.87,0:16:34.92,Main,,0,0,0,,Senin gibi bir ezme beni alt edemez yani!Dialogue: 0,0:16:45.43,0:16:49.23,Main,,0,0,0,,Paçayı kurtardın-perorin.Dialogue: 0,0:16:50.69,0:16:55.58,Flashbacks,,0,0,0,,Burada ölürsem bir faydam olmaz! Yeni dünyanın şafağı yaklaşıyor!Dialogue: 0,0:16:55.58,0:16:57.79,Flashbacks,,0,0,0,,Geri dönmem gerek!Dialogue: 0,0:17:00.17,0:17:02.63,Flashbacks,,0,0,0,,Pek de bi' yakışıklıymışsın.Dialogue: 0,0:17:02.63,0:17:05.67,Flashbacks,,0,0,0,,50 yıla düşürüyorum.Dialogue: 0,0:17:05.67,0:17:07.55,Flashbacks,,0,0,0,,Yaşa bakalım.Dialogue: 0,0:17:09.29,0:17:10.80,Main,,0,0,0,,O gün...Dialogue: 0,0:17:10.80,0:17:16.35,Main,,0,0,0,,...sol gözünü feda etmeseydin hiç şüphesiz nalları dikmiştin.Dialogue: 0,0:17:17.88,0:17:20.72,Main,,0,0,0,,Hayatta kalmayı bu denli mi istiyordun?Dialogue: 0,0:17:22.37,0:17:23.98,Main,,0,0,0,,Neyse artık...Dialogue: 0,0:17:23.98,0:17:26.93,Main,,0,0,0,,Yaşın kaç?Dialogue: 0,0:17:26.93,0:17:28.48,Main,,0,0,0,,27.Dialogue: 0,0:17:28.48,0:17:35.12,Main,,0,0,0,,Ömründen de 50 yıl çekip alındığına göre şu an 77 yaşında sayılırsın.Dialogue: 0,0:17:36.87,0:17:40.58,Main,,0,0,0,,Pekâlâ, bakalım yaşayacak kaç yılın kaldı...Dialogue: 0,0:17:42.11,0:17:45.46,Main,,0,0,0,,En azından öleceğim yeri kendim seçmek istiyorum.Dialogue: 0,0:17:47.20,0:17:48.47,Main,,0,0,0,,Bu arada...Dialogue: 0,0:17:48.47,0:17:52.85,Main,,0,0,0,,...Nox Korsanları'nın kaptanıydın.Dialogue: 0,0:17:52.85,0:17:56.81,Main,,0,0,0,,"Nox" da "gece" anlamına geliyordu, di' mi?Dialogue: 0,0:17:56.81,0:17:59.14,Main,,0,0,0,,Pek de iç karartıcı bir isimmiş.Dialogue: 0,0:17:59.65,0:18:01.98,Main,,0,0,0,,Her gecenin bir sonu varmış.Dialogue: 0,0:18:03.11,0:18:04.29,Main,,0,0,0,,Yani...Dialogue: 0,0:18:05.43,0:18:08.19,Main,,0,0,0,,..."nox" da şu manaya geliyor:Dialogue: 0,0:18:09.68,0:18:11.60,Main,,0,0,0,,..."alaca karanlık vakti"!Dialogue: 0,0:18:13.19,0:18:17.79,Thoughts,,0,0,0,,Üstadım ve kabilemin umutla beklediği dünyanın yeni şafağının inşasına...Dialogue: 0,0:18:17.79,0:18:19.21,Thoughts,,0,0,0,,...önayak olabilirsem gözüm açık gitmem.Dialogue: 0,0:18:20.61,0:18:23.29,Thoughts,,0,0,0,,Bu kadarcık zamanım da kalmıştır.Dialogue: 0,0:18:27.30,0:18:33.93,Main,,0,0,0,,"Nox"un alaca karanlık anlamına geldiğini söylemiştin...Dialogue: 0,0:18:33.93,0:18:40.44,Main,,0,0,0,,...lakin seni, ölüm denen sonsuz bir karanlıktan ötesi beklemiyor.Dialogue: 0,0:18:40.44,0:18:41.28,Main,,0,0,0,,Yanılıyorsun.Dialogue: 0,0:18:50.68,0:18:54.37,Main,,0,0,0,,Roger! Oden-sama! Beni de yanınıza alın!Dialogue: 0,0:18:56.40,0:18:59.87,Main,,0,0,0,,Ne görev verirseniz yaparım! Yanınızda geleyim!Dialogue: 0,0:19:02.12,0:19:05.76,Main,,0,0,0,,Çocuk, daha vaktin gelmedi.Dialogue: 0,0:19:05.76,0:19:08.52,Main,,0,0,0,,Çocuk değilim ben! Adım Pedro!Dialogue: 0,0:19:14.17,0:19:17.19,Main,,0,0,0,,Günlerim sayılı.Dialogue: 0,0:19:17.19,0:19:22.69,Main,,0,0,0,,Dinle bak. Herkesin bi' vakti vardır.Dialogue: 0,0:19:24.22,0:19:26.32,Main,,0,0,0,,Sabırla bekle.Dialogue: 0,0:19:26.32,0:19:31.95,Main,,0,0,0,,Önünde sonunda da gelecektir. Senin vaktini diyorum.Dialogue: 0,0:19:33.06,0:19:36.20,Main,,0,0,0,,Hoşça kal Pedro.Dialogue: 0,0:19:37.53,0:19:40.20,Main,,0,0,0,,Peki Roger!Dialogue: 0,0:19:50.30,0:19:52.75,Main,,0,0,0,,Pedro!Dialogue: 0,0:19:52.75,0:19:54.01,Main,,0,0,0,,Roger...Dialogue: 0,0:19:54.02,0:19:55.93,Main,,0,0,0,,Ne olmuş ona?Dialogue: 0,0:19:59.76,0:20:01.22,Main,,0,0,0,,Ölmüş!Dialogue: 0,0:20:03.81,0:20:08.92,Main,,0,0,0,,Roger herkesin bi' vakti olduğunu söylemişti.Dialogue: 0,0:20:08.92,0:20:10.92,Main,,0,0,0,,Neler zırvalıyorsun?Dialogue: 0,0:20:10.92,0:20:12.75,Main,,0,0,0,,Benim vaktim de geldi çattı!Dialogue: 0,0:20:15.66,0:20:19.22,Main,,0,0,0,,Senin-gara büyülerini tamamen ortadan kaldırmaya yeter, değil mi?Dialogue: 0,0:20:19.96,0:20:21.14,Main,,0,0,0,,Bombalar mı?Dialogue: 0,0:20:21.14,0:20:24.88,Main,,0,0,0,,Yapma sakın, andaval! Aklından neler geçiyor?Dialogue: 0,0:20:25.38,0:20:27.10,Main,,0,0,0,,Bırak lan!Dialogue: 0,0:20:31.76,0:20:33.05,Flashbacks,,0,0,0,,İçimde...Dialogue: 0,0:20:34.22,0:20:37.24,Flashbacks,,0,0,0,,...son yolculuğumda olduğuma dair bir his var.Dialogue: 0,0:20:37.24,0:20:39.31,Flashbacks,,0,0,0,,Ne demek istiyorsun Pedro?Dialogue: 0,0:20:45.42,0:20:46.37,Main,,0,0,0,,Pedro?!Dialogue: 0,0:20:47.40,0:20:48.66,Main,,0,0,0,,Elveda.Dialogue: 0,0:21:18.22,0:21:20.28,Flashbacks,,0,0,0,,Ne demek istiyorsun Pedro?Dialogue: 0,0:21:20.28,0:21:24.20,Flashbacks,,0,0,0,,Luffyler'i kurtarıp buradan kaçmalarını sağlamanın...Dialogue: 0,0:21:24.69,0:21:29.48,Flashbacks,,0,0,0,,...ne kadar mühim olduğunu bir gün göreceksin.Dialogue: 0,0:21:33.49,0:21:36.21,Main,,0,0,0,,Pedro!!Dialogue: 0,0:21:37.37,0:21:38.92,Flashbacks,,0,0,0,,Dinleyin!Dialogue: 0,0:21:38.92,0:21:42.00,Flashbacks,,0,0,0,,Siz-gara ilerlemeye devam etmelisiniz!Dialogue: 0,0:21:42.00,0:21:43.76,Main,,0,0,0,,Pedro!Dialogue: 0,0:21:44.46,0:21:47.18,Main,,0,0,0,,Yoksa Peros abi...Dialogue: 0,0:21:51.26,0:21:55.32,Main,,0,0,0,,Olamaz! Mama ile Perospero-sama...Dialogue: 0,0:21:55.32,0:21:58.02,Main,,0,0,0,,Patlamaya maruz kaldılar!Dialogue: 0,0:22:10.19,0:22:13.50,Main,,0,0,0,,Özel yeteneği olan şekerler erimeye başlıyor!Dialogue: 0,0:22:18.08,0:22:20.90,Main,,0,0,0,,Kendini feda ettiğine inanamıyorum!Dialogue: 0,0:22:20.90,0:22:23.63,Main,,0,0,0,,Nasıl yaparsın be Pedro!Dialogue: 0,0:22:36.72,0:22:39.24,Main,,0,0,0,,Öleceğim sandıydım ha!Dialogue: 0,0:22:39.24,0:22:41.40,Main,,0,0,0,,İyi misiniz siz?Dialogue: 0,0:22:48.94,0:22:50.42,Main,,0,0,0,,Dur Carrot!Dialogue: 0,0:22:50.42,0:22:55.13,Main,,0,0,0,,Bırak beni! Pedro'nun olduğu yere gideyim! Belki hayattadır!Dialogue: 0,0:22:55.13,0:23:00.15,Main,,0,0,0,,Gidemezsin! Patlamayı sen de gördün! Bizi kurtardı!Dialogue: 0,0:23:00.15,0:23:03.90,Main,,0,0,0,,Az önceye dek hayatta kalma şansımız sıfırdı!Dialogue: 0,0:23:03.90,0:23:07.54,Main,,0,0,0,,Pedro'nun seçimini kabullenmelisin! Lütfen!Dialogue: 0,0:23:10.71,0:23:13.14,Main,,0,0,0,,Uçmaya hazır mıyız Nami?Dialogue: 0,0:23:13.96,0:23:15.77,Main,,0,0,0,,Evet, tüm hazırlıklar tamam!Dialogue: 0,0:23:15.77,0:23:19.30,Main,,0,0,0,,Chopper! Brook! Kendinize geldiniz mi?Dialogue: 0,0:23:20.35,0:23:21.50,Main,,0,0,0,,Ha?Dialogue: 0,0:23:21.50,0:23:22.70,Main,,0,0,0,,Jinbe!Dialogue: 0,0:23:22.70,0:23:25.28,Main,,0,0,0,,Evet, ayıldılar!Dialogue: 0,0:23:26.02,0:23:28.24,Main,,0,0,0,,Yelkenler fora millet!Dialogue: 0,0:23:35.11,0:23:37.62,Main,,0,0,0,,Şu birkaç saniyeyi değerlendiremezsek...Dialogue: 0,0:23:37.62,0:23:40.33,Main,,0,0,0,,...Pedro'nun kemikleri sızlar!Dialogue: 0,0:23:40.33,0:23:43.63,Main,,0,0,0,,Ne olursa olsun buradan kaçacağız!Dialogue: 0,0:23:49.96,0:23:51.80,Main,,0,0,0,,Neye mal olursa olsun!Dialogue: 0,0:23:53.67,0:23:55.60,Main,,0,0,0,,Herkes...Dialogue: 0,0:23:56.72,0:23:59.02,Main,,0,0,0,,...ne demeye celallendi böyle?Dialogue: 0,0:24:01.76,0:24:04.54,Main,,0,0,0,,Defolun Big Mom Korsanları!Dialogue: 0,0:24:04.54,0:24:05.61,Main,,0,0,0,,Carrot!Dialogue: 0,0:24:23.53,0:24:25.15,Main,,0,0,0,,Başım ya...Dialogue: 0,0:24:26.03,0:24:30.25,Main,,0,0,0,,Kalk! Ayağa kalk Carrot! Kılıcını kuşan!Dialogue: 0,0:24:30.25,0:24:33.14,Main,,0,0,0,,O-gara kılıç kullanmayı beceremiyor.Dialogue: 0,0:24:33.14,0:24:35.65,Main,,0,0,0,,Pedro! Burnunu sokma!Dialogue: 0,0:24:35.65,0:24:39.56,Main,,0,0,0,,Carrot benim rehberliğimde sağlam bir kılıç ustası olacak!Dialogue: 0,0:24:39.56,0:24:45.02,Main,,0,0,0,,Güçlenmek tek bir metotla sınırlı değildir. Kıza daha uygun bir cenk biçimi olmalı.Dialogue: 0,0:24:47.11,0:24:48.52,Main,,0,0,0,,Bunlar nedir?Dialogue: 0,0:24:50.72,0:24:52.27,Main,,0,0,0,,Saldırmayı dene.Dialogue: 0,0:24:54.77,0:24:57.61,Main,,0,0,0,,Sana-gara böylesi daha uygun.Dialogue: 0,0:25:03.03,0:25:06.31,Main,,0,0,0,,Sen-gara kısa süreliğine havada süzülebiliyorsun!Dialogue: 0,0:25:06.31,0:25:12.77,Main,,0,0,0,,Süzülme kabiliyetinden ve Elektro'ndan istifade edebilirsen kendi gücünü ve cenk biçimini bulmuş olursun.Dialogue: 0,0:25:12.77,0:25:13.92,Main,,0,0,0,,Gerçekten mi?Dialogue: 0,0:25:14.16,0:25:15.49,Main,,0,0,0,,Evet.Dialogue: 0,0:25:15.49,0:25:18.77,Main,,0,0,0,,Saldır bana. Antrenman partnerin olacağım.Dialogue: 0,0:25:18.77,0:25:20.30,Main,,0,0,0,,Tamamdır!Dialogue: 0,0:25:33.90,0:25:37.08,Thoughts,,0,0,0,,Güçlenemeyeceğimi sanırken...Dialogue: 0,0:25:37.08,0:25:40.84,Thoughts,,0,0,0,,...bana uygun bir yetenek varmış meğer!Dialogue: 0,0:25:40.84,0:25:43.72,Main,,0,0,0,,Bunu da sana borçluyum Pedro.Dialogue: 0,0:25:43.72,0:25:46.05,Main,,0,0,0,,Nasıl cenk ettiğin fark etmez.Dialogue: 0,0:25:46.05,0:25:49.88,Main,,0,0,0,,Bugünden itibaren kudretli bir savaşçı hâline gelerek daima hazır olmalısın.Dialogue: 0,0:25:52.25,0:25:55.84,Main,,0,0,0,,Herkesin bi' vakti vardır.Dialogue: 0,0:25:58.11,0:26:00.21,Main,,0,0,0,,Merak etme...Dialogue: 0,0:26:10.18,0:26:11.60,Main,,0,0,0,,Electrical...Dialogue: 0,0:26:10.18,0:26:11.60,Attack,,0,0,0,,Elektriksel...Dialogue: 0,0:26:18.95,0:26:22.91,Main,,0,0,0,,Burada olduğum sürece yelken açmanıza müsaade etmem!Dialogue: 0,0:26:31.30,0:26:33.75,Main,,0,0,0,,Çekil lan Carrot'un üzerinden!Dialogue: 0,0:26:40.37,0:26:42.49,Main,,0,0,0,,Carrot! Bu herifle ben ilgilenirim!Dialogue: 0,0:26:43.38,0:26:44.89,Main,,0,0,0,,Luffy...Dialogue: 0,0:26:50.47,0:26:53.19,Main,,0,0,0,,Umarım benden kurtulabilecek kadar güçlüsündür.Dialogue: 0,0:26:58.18,0:27:02.59,Main,,0,0,0,,Yelken açacağız diyorum! Bu geminin kaptanı benim!Dialogue: 0,0:27:02.59,0:27:06.20,Main,,0,0,0,,Gomu Gomu no... Elephant Gun!Dialogue: 0,0:27:02.59,0:27:06.20,Attack,,0,0,0,,Lastik-Lastik... Fil Tüfeği!Dialogue: 0,0:27:17.94,0:27:19.52,Main,,0,0,0,,Yelkenler böyle durabilir.Dialogue: 0,0:27:20.79,0:27:23.47,Main,,0,0,0,,Kuzeybatıya doğru Coup de Burst!Dialogue: 0,0:27:23.47,0:27:26.01,Main,,0,0,0,,İstikamet: 45 derece kuzeybatı!Dialogue: 0,0:27:26.01,0:27:27.63,Main,,0,0,0,,Anlıyorum.Dialogue: 0,0:27:27.63,0:27:31.01,Main,,0,0,0,,Böyle tutarsan  adamlarına saldıramayacağım bir gerçek.Dialogue: 0,0:27:31.01,0:27:34.72,Main,,0,0,0,,Artık olacakları öngörsen de engel olamazsın!Dialogue: 0,0:27:36.08,0:27:38.17,Main,,0,0,0,,Abi! Seni kurtarmak için buradayım!Dialogue: 0,0:27:41.18,0:27:43.13,Main,,0,0,0,,Peros abinin kanını yerde bırakmayacağım!Dialogue: 0,0:27:43.13,0:27:46.91,Main,,0,0,0,,Tüm filo düşman gemisine ateş açmaya hazırlansın!Dialogue: 0,0:27:46.91,0:27:48.76,Main,,0,0,0,,Eğim açısını ayarlayın!Dialogue: 0,0:27:49.39,0:27:51.55,Main,,0,0,0,,Köpekbalığım, evine dön bakalım!Dialogue: 0,0:27:53.14,0:27:55.58,Main,,0,0,0,,Chopper-san, sen de halatı çeker misin?Dialogue: 0,0:27:55.60,0:27:59.29,Main,,0,0,0,,Bombardıman başlamadan denizaltını Sunny-go'ya yanaştıralım.Dialogue: 0,0:27:59.29,0:28:02.52,Main,,0,0,0,,Carrot! Sık dişini. Kalkabilir misin?Dialogue: 0,0:28:02.52,0:28:06.00,Main,,0,0,0,,Kalkarım. Teşekkürler Nami.Dialogue: 0,0:28:08.80,0:28:11.62,Main,,0,0,0,,Pastam nerede?Dialogue: 0,0:28:11.62,0:28:12.82,Main,,0,0,0,,Big Mom!Dialogue: 0,0:28:12.82,0:28:18.02,Main,,0,0,0,,Başımız büyük belada!  Gemi talan olmadan buradan çıkmalıyız!Dialogue: 0,0:28:24.90,0:28:29.47,Main,,0,0,0,,O... Pedro mu yoksa? Yaşıyor mu?Dialogue: 0,0:28:42.29,0:28:45.80,Main,,0,0,0,,Sikeyim! Sıçtığımın Pedro'su!Dialogue: 0,0:28:45.80,0:28:47.15,Main,,0,0,0,,Pedro değil!Dialogue: 0,0:28:47.15,0:28:48.53,Main,,0,0,0,,Olamaz...Dialogue: 0,0:28:48.53,0:28:51.75,Main,,0,0,0,,Hay böyle işin... Kanımın donduğunu hissettim lan.Dialogue: 0,0:28:51.75,0:28:55.35,Main,,0,0,0,,Şeker Zırh'ım tuzla buz oldu.Dialogue: 0,0:28:57.85,0:29:02.44,Main,,0,0,0,,Mümkün değil! O-teia nasıl hayatta kalabiliyor?Dialogue: 0,0:29:04.31,0:29:07.59,Main,,0,0,0,,İkinci bombardıman tamamen önlendi gibi duruyor!Dialogue: 0,0:29:07.59,0:29:10.57,Main,,0,0,0,,Üçüncü bombardımana geçin! Çabucak topları doldurun!Dialogue: 0,0:29:11.99,0:29:14.93,Main,,0,0,0,,B- Bırak beni!Dialogue: 0,0:29:14.93,0:29:16.50,Main,,0,0,0,,Nami! Carrot!Dialogue: 0,0:29:17.24,0:29:18.61,Main,,0,0,0,,Jinbe!Dialogue: 0,0:29:18.61,0:29:20.03,Main,,0,0,0,,Brook!Dialogue: 0,0:29:20.03,0:29:21.58,Main,,0,0,0,,Chopper!Dialogue: 0,0:29:38.14,0:29:39.73,Main,,0,0,0,,Diyeceklerime kulak verin!Dialogue: 0,0:29:40.22,0:29:43.94,Main,,0,0,0,,Döneceğim! Gerisini size bırakıyorum!Dialogue: 0,0:29:43.94,0:29:46.28,Main,,0,0,0,,Ne? Bu da ne demek oluyor?Dialogue: 0,0:29:49.36,0:29:54.10,Main,,0,0,0,,Yeke* başlangıç konumuna döndüğünde dolum işlemi tamamlanmış demektir.Dialogue: 0,0:29:54.10,0:29:56.97,Main,,0,0,0,,Tamamdır millet! Bir şeylere tutunun!Dialogue: 0,0:29:56.97,0:29:58.27,Main,,0,0,0,,Anlaşıldı!Dialogue: 0,0:29:58.27,0:30:00.73,Main,,0,0,0,,İstediğin zaman ateşle!Dialogue: 0,0:30:00.73,0:30:02.26,Main,,0,0,0,,Biz de hazırız!Dialogue: 0,0:30:04.17,0:30:05.72,Main,,0,0,0,,Pekâlâ, başlıyoruz!Dialogue: 0,0:30:07.09,0:30:09.89,Main,,0,0,0,,Elinizden kaçırmayın! Ateş!Dialogue: 0,0:30:13.30,0:30:14.24,Main,,0,0,0,,Şimdi!Dialogue: 0,0:30:14.24,0:30:17.90,Main,,0,0,0,,Millet! Sesinizi duyalım!Dialogue: 0,0:30:17.90,0:30:21.14,Main,,0,0,0,,Coup de...Dialogue: 0,0:30:23.40,0:30:26.45,Main,,0,0,0,,Burst!Dialogue: 0,0:30:46.40,0:30:48.00,Main,,0,0,0,,Amande rapor veriyor.Dialogue: 0,0:30:48.00,0:30:51.17,Main,,0,0,0,,Düşman gemisi gökyüzüne uçtu.Dialogue: 0,0:30:51.17,0:30:52.46,Main,,0,0,0,,Gökyüzüne mi?Dialogue: 0,0:30:56.28,0:30:58.42,Main,,0,0,0,,Baksanıza, Luffy nerede?Dialogue: 0,0:31:03.21,0:31:04.70,Main,,0,0,0,,Hasır Şapka lan bu!Dialogue: 0,0:31:04.70,0:31:05.85,Main,,0,0,0,,Kaçın!Dialogue: 0,0:31:12.01,0:31:16.40,Captions,,0,0,0,,Ayna DünyasıDialogue: 0,0:31:17.60,0:31:19.40,Main,,0,0,0,,Aferin sana.Dialogue: 0,0:31:20.10,0:31:22.86,Main,,0,0,0,,Burada seni istediğim kadar pataklayabilirim!Dialogue: 0,0:31:26.19,0:31:27.70,Main,,0,0,0,,Gemiyle bağlantıyı...Dialogue: 0,0:31:27.70,0:31:29.75,Main,,0,0,0,,Kendi elleriyle parçaladı!Dialogue: 0,0:31:41.54,0:31:45.51,Main,,0,0,0,,Kaptanın kararlılığı bu oluyor demek.Dialogue: 0,0:31:46.37,0:31:49.53,Main,,0,0,0,,Lakin benimle aşık atamazsın.Dialogue: 0,0:31:49.53,0:31:52.35,Main,,0,0,0,,Burası mezarın olacak.Dialogue: 0,0:31:52.35,0:31:55.08,Main,,0,0,0,,Sunny-go'ya döneceğim!Dialogue: 0,0:31:55.08,0:31:57.31,Main,,0,0,0,,Seni patakladıktan sonra!Dialogue: 0,0:32:10.67,0:32:15.30,Credits,,0,0,0,,Editing:  Feeso, Galaxy 9000  Timing: Galaxy 9000  Quality Assurance: Feeso, Galaxy 9000, Grug, Pepperjack  Soundtracking:  Halee  Graphics:  Datenshi  Karaoke: KaitouYahiko  Translation: Crunchyroll