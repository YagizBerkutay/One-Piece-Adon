0,0,0,0,0,95,100,1,0,1,2.2,0,7,10,10,10,1Style: Author,Impress BT,20.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.7,0.7,9,10,10,10,1Style: Attack,Duality,30.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.0,1.0,7,12,12,12,1Style: English - OP20,Duality,40.0,&H0098594E,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2.6,0,2,10,10,15,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:01:34.28,0:01:38.16,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - ARE-YOU-SURE thx to onepace.netDialogue: 0,0:10:02.90,0:10:12.90,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - ARE-YOU-SURE thx to onepace.netDialogue: 0,0:26:14.50,0:26:18.70,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - ARE-YOU-SURE thx to onepace.netDialogue: 0,0:01:34.28,0:01:38.16,Title,,0,0,0,,Luffy, Sanji'ye KarşıDialogue: 0,0:01:34.82,0:01:38.11,Main,,0,0,0,,Yeni Dünya'nın sonuna dek...Dialogue: 0,0:01:38.11,0:01:41.62,Main,,0,0,0,,...uç!Dialogue: 0,0:01:42.77,0:01:45.33,Main,,0,0,0,,Cannon Ball!Dialogue: 0,0:01:42.77,0:01:45.33,Attack,,0,0,0,,Gülle TopuDialogue: 0,0:02:34.11,0:02:38.05,Main,,0,0,0,,Mama, 3 Tatlı Komutanı'ndan  Smoothie-sama geldi.Dialogue: 0,0:02:34.17,0:02:37.84,Captions,,0,0,0,,Whole Cake ŞatosuDialogue: 0,0:02:44.05,0:02:46.05,Main,,0,0,0,,Demek öyle.Dialogue: 0,0:02:46.05,0:02:49.66,Main,,0,0,0,,Tatlı Komutanı Katakuri-sama da yakında burada olacak.Dialogue: 0,0:02:49.66,0:02:53.90,Main,,0,0,0,,Üçü bir araya gelmeyeli uzun zaman olmuştu.Dialogue: 0,0:02:54.37,0:02:57.82,Main,,0,0,0,,Ya Cracker? Daha dönmedi mi?Dialogue: 0,0:02:57.82,0:03:01.71,Main,,0,0,0,,Eminim hediye olarak  Hasır Şapka'nın kafasıyla yakında döner!Dialogue: 0,0:03:01.71,0:03:04.08,Main,,0,0,0,,Sabırsızlanıyorum.Dialogue: 0,0:03:18.02,0:03:20.17,Main,,0,0,0,,Ne? O da ne?Dialogue: 0,0:03:29.13,0:03:30.77,Main,,0,0,0,,Ne oldu?Dialogue: 0,0:03:40.40,0:03:41.87,Main,,0,0,0,,Nedir o?!Dialogue: 0,0:03:47.08,0:03:48.70,Main,,0,0,0,,Abi!Dialogue: 0,0:03:51.03,0:03:52.54,Main,,0,0,0,,Abi!Dialogue: 0,0:03:52.54,0:03:54.25,Main,,0,0,0,,Cracker abi!Dialogue: 0,0:03:54.25,0:03:58.00,Main,,0,0,0,,Olamaz! Üç Tatlı Komutanı'mızdan birisi o!Dialogue: 0,0:03:58.00,0:04:02.17,Main,,0,0,0,,Kim yaptı bunu?! Öldüreceğim onu!Dialogue: 0,0:03:58.33,0:04:02.20,Captions,,0,0,0,,Charlotte Mont d'Or Charlotte'un 19. Oğlu, Peynir BakanıDialogue: 0,0:04:02.34,0:04:06.60,Captions,,0,0,0,,Charlotte Opera Charlotte'un 5. Oğlu, Krema BakanıDialogue: 0,0:04:02.52,0:04:05.56,Main,,0,0,0,,Nereden geldi-fa?!Dialogue: 0,0:04:05.56,0:04:07.38,Main,,0,0,0,,Abim sanırım...Dialogue: 0,0:04:07.35,0:04:11.16,Captions,,0,0,0,,Charlotte Galette Charlotte'un 18. Kızı, Tereyağı BakanıDialogue: 0,0:04:07.38,0:04:11.14,Main,,0,0,0,,...Hasır Şapkalı Luffy'nin olduğu ormandan geldi.Dialogue: 0,0:04:11.48,0:04:13.14,Main,,0,0,0,,Bunun anlamı...Dialogue: 0,0:04:15.60,0:04:19.07,Main,,0,0,0,,Hasır Şapkalı Luffy, yakın bir yerlerde-fa!Dialogue: 0,0:04:20.94,0:04:24.03,Main,,0,0,0,,Acil durum alarmı!Dialogue: 0,0:04:28.95,0:04:30.51,Main,,0,0,0,,Tahliye!Dialogue: 0,0:04:30.51,0:04:31.68,Main,,0,0,0,,Ne oldu?!Dialogue: 0,0:04:31.68,0:04:34.83,Main,,0,0,0,,Tatlı Komutanı Cracker-sama yenilmiş!Dialogue: 0,0:04:34.83,0:04:35.83,Main,,0,0,0,,Ne?!Dialogue: 0,0:04:42.46,0:04:46.51,Captions,,0,0,0,,Ayartan OrmanDialogue: 0,0:04:53.26,0:04:55.39,Main,,0,0,0,,Luffy! İyi misin?Dialogue: 0,0:04:55.39,0:04:58.60,Main,,0,0,0,,Ömrüm boyunca yetecek bisküvi yedim.Dialogue: 0,0:04:58.60,0:05:01.50,Main,,0,0,0,,Ama bayağı indin şimdi.Dialogue: 0,0:05:02.27,0:05:05.38,Main,,0,0,0,,Dördüncü Vites çok enerji harcıyor.Dialogue: 0,0:05:08.54,0:05:09.58,Main,,0,0,0,,Pound!Dialogue: 0,0:05:10.07,0:05:12.10,Main,,0,0,0,,Neredeydin sen?!Dialogue: 0,0:05:12.10,0:05:17.58,Main,,0,0,0,,Yenileceğini düşünüp kaçtığım için üzgünüm.Dialogue: 0,0:05:17.58,0:05:19.50,Main,,0,0,0,,Bayağı da dürüstsün.Dialogue: 0,0:05:19.50,0:05:23.75,Main,,0,0,0,,Çünkü 3 Tatlı Komutanı'ndan birisiydi.Dialogue: 0,0:05:23.75,0:05:25.13,Main,,0,0,0,,Neyse ama.Dialogue: 0,0:05:29.39,0:05:33.40,Main,,0,0,0,,Sonuçta kazandık!Dialogue: 0,0:05:33.40,0:05:35.10,Main,,0,0,0,,Başardık! Başardık!Dialogue: 0,0:05:35.43,0:05:37.44,Main,,0,0,0,,Yaşasın! Yaşasın!Dialogue: 0,0:05:39.72,0:05:44.28,Main,,0,0,0,,Neşelenin be! Yonkou'nun en iyi adamlarından birisini yendik!Dialogue: 0,0:05:45.11,0:05:47.53,Main,,0,0,0,,H-Hareket edemiyorum.Dialogue: 0,0:05:47.53,0:05:50.91,Main,,0,0,0,,Yaptıklarımız...Dialogue: 0,0:05:50.91,0:05:55.29,Main,,0,0,0,,Cracker-sama'nın yenilmesine yardım ettik-ju.Dialogue: 0,0:05:56.63,0:06:02.59,Main,,0,0,0,,Herkes Mama'nın Vivre Kartı'nın Homies'ler için çok güçlü olduğunu biliyor.Dialogue: 0,0:06:03.19,0:06:10.18,Main,,0,0,0,,Bu yüzden şu an Mama'nın çocuklarında bile hiç yok.Dialogue: 0,0:06:10.51,0:06:13.02,Main,,0,0,0,,Neden sende var?!Dialogue: 0,0:06:13.02,0:06:14.33,Main,,0,0,0,,Öyle mi?Dialogue: 0,0:06:15.14,0:06:17.98,Main,,0,0,0,,Gerçekten değerli bir şey olduğunu anlamıştım.Dialogue: 0,0:06:17.98,0:06:21.43,Main,,0,0,0,,Ama başınız çok dertte.Dialogue: 0,0:06:21.43,0:06:22.23,Main,,0,0,0,,Ne oldu?Dialogue: 0,0:06:25.28,0:06:29.53,Main,,0,0,0,,Tatlı Komutanı Snack yenildiğinde...Dialogue: 0,0:06:31.62,0:06:35.49,Main,,0,0,0,,...kinli Cracker'ın donanması denizi doldurmuştu...Dialogue: 0,0:06:35.80,0:06:38.78,Main,,0,0,0,,...ve öfkeli Linlin fırtına yaratmıştı.Dialogue: 0,0:06:41.29,0:06:46.51,Main,,0,0,0,,Göz açıp kapayana kadar düşman gemisini batırdığını duydum.Dialogue: 0,0:06:46.98,0:06:48.01,Main,,0,0,0,,Fırtına mı?Dialogue: 0,0:06:48.01,0:06:51.37,Main,,0,0,0,,Linlin hava elementlerini kontrol edebilen bir kadındır.Dialogue: 0,0:06:51.37,0:06:52.34,Main,,0,0,0,,Hava mı?Dialogue: 0,0:06:52.34,0:06:55.46,Main,,0,0,0,,Sol elinde fırtına bulutu Zeus!Dialogue: 0,0:06:57.27,0:07:00.81,Main,,0,0,0,,Sağ elinde Güneş, Prometheus!Dialogue: 0,0:07:02.15,0:07:06.43,Main,,0,0,0,,Kızdığında Big Mom'u durdurabilecek bir şey yoktur.Dialogue: 0,0:07:08.07,0:07:12.91,Main,,0,0,0,,Linlin bunu duymadan önce hemen kaçın!Dialogue: 0,0:07:14.83,0:07:17.45,Main,,0,0,0,,Kızması hiç umurumda değil!Dialogue: 0,0:07:17.45,0:07:18.70,Main,,0,0,0,,Ne?!Dialogue: 0,0:07:21.29,0:07:25.92,Main,,0,0,0,,Kızacak olan benim! Daha da önce o Sanji!Dialogue: 0,0:07:26.13,0:07:29.38,Note,,0,0,0,,Dostlarım, gidip bir kadını görmem lazım. Geri döneceğim. Sanji.Dialogue: 0,0:07:26.84,0:07:29.97,Main,,0,0,0,,Arkasında bir not bırakıp kayboldu.Dialogue: 0,0:07:29.97,0:07:31.97,Main,,0,0,0,,Sebebini falan söylemedi!Dialogue: 0,0:07:34.85,0:07:36.97,Flashbacks,,0,0,0,,Bu benim sorunum.Dialogue: 0,0:07:37.31,0:07:39.23,Flashbacks,,0,0,0,,Kesinlikle geri döneceğim.Dialogue: 0,0:07:41.10,0:07:44.06,Flashbacks,,0,0,0,,Onlara selam söyle.Dialogue: 0,0:07:44.06,0:07:47.38,Main,,0,0,0,,Pudding'in haritası sayesinde buraya kadar gelebildik ama...Dialogue: 0,0:07:47.38,0:07:49.74,Main,,0,0,0,,...Pekoms kayboldu.Dialogue: 0,0:07:49.74,0:07:53.04,Main,,0,0,0,,Ayrıca Pudding, Sanji'yi getireceğini söylemişken...Dialogue: 0,0:07:53.04,0:07:57.03,Main,,0,0,0,,...buluşma noktasında kimse yoktu!Dialogue: 0,0:07:57.03,0:08:00.70,Main,,0,0,0,,Kaybolduğumuz bu ormanda o kadar vaktimiz gitti!Dialogue: 0,0:08:01.39,0:08:06.92,Main,,0,0,0,,Evlendiklerinde, Sanji artık Big Mom'un adamı olmayacak mısın?Dialogue: 0,0:08:08.13,0:08:10.85,Main,,0,0,0,,Harcayacak vaktimiz yok!Dialogue: 0,0:08:12.01,0:08:14.89,Main,,0,0,0,,Evet. Düğün ne zaman?Dialogue: 0,0:08:14.89,0:08:17.02,Main,,0,0,0,,Bugün kaleye...Dialogue: 0,0:08:17.02,0:08:19.54,Main,,0,0,0,,...Vinsmoke Ailesi'nin geleceğini söylemişti.Dialogue: 0,0:08:20.69,0:08:23.90,Main,,0,0,0,,Şu an saat kaç? Hemen onu durdurmalıyız.Dialogue: 0,0:08:23.90,0:08:28.23,Main,,0,0,0,,C-Ciddi misin? Kaçmazsanız gerçekten...Dialogue: 0,0:08:28.23,0:08:30.19,Main,,0,0,0,,Kaçmayacağım!Dialogue: 0,0:08:38.56,0:08:39.79,Main,,0,0,0,,Hey ağaç!Dialogue: 0,0:08:42.48,0:08:44.99,Main,,0,0,0,,Kalenin yerini biliyorsun, değil mi?Dialogue: 0,0:08:44.99,0:08:45.96,Main,,0,0,0,,O...Dialogue: 0,0:08:45.96,0:08:48.00,Main,,0,0,0,,Beni kaleye taşı!Dialogue: 0,0:08:48.00,0:08:49.75,Main,,0,0,0,,Olmaz-ju!Dialogue: 0,0:08:53.24,0:08:57.41,Main,,0,0,0,,Sanji'yi kesinlikle geri alacağız!Dialogue: 0,0:09:20.71,0:09:22.92,Main,,0,0,0,,Nami, beni duyabiliyor musun?Dialogue: 0,0:09:22.92,0:09:23.83,Main,,0,0,0,,Chopper!Dialogue: 0,0:09:23.83,0:09:25.12,Main,,0,0,0,,Durumunuz nasıl?Dialogue: 0,0:09:25.12,0:09:29.36,Main,,0,0,0,,İyiyiz. İşler iyi giderse hemen sizi ve Brook'ları--Dialogue: 0,0:09:29.36,0:09:30.17,Main,,0,0,0,,Ne?Dialogue: 0,0:09:31.29,0:09:33.58,Main,,0,0,0,,İyi durmuyor ama. Chopper?Dialogue: 0,0:09:33.58,0:09:37.07,Main,,0,0,0,,Öte yandan dışarıdan yardım alamayız.Dialogue: 0,0:09:37.07,0:09:38.13,Main,,0,0,0,,Sadece--Dialogue: 0,0:09:38.96,0:09:40.08,Main,,0,0,0,,Chopper?!Dialogue: 0,0:09:40.08,0:09:43.30,Main,,0,0,0,,Nami, endişelenme. Biz iyi--Dialogue: 0,0:09:44.20,0:09:45.93,Main,,0,0,0,,Nasıl endişelenmeyeyim?Dialogue: 0,0:09:45.93,0:09:49.47,Main,,0,0,0,,Yine de Sanji-kun'u bulmak için kaleye gideceğiz.Dialogue: 0,0:09:49.47,0:09:50.61,Main,,0,0,0,,Anladım.Dialogue: 0,0:09:50.61,0:09:54.28,Main,,0,0,0,,Sanji'yi kurtardığınız zaman bu ayna ile bize haber--Dialogue: 0,0:09:55.18,0:09:56.28,Main,,0,0,0,,Kırıldı!Dialogue: 0,0:09:56.28,0:09:58.99,Main,,0,0,0,,Alo Chopper?! Carrot!Dialogue: 0,0:09:59.60,0:10:02.58,Main,,0,0,0,,Normal bir aynaya döndü. İyiler mi?Dialogue: 0,0:10:07.87,0:10:09.83,Main,,0,0,0,,Öncekinden daha mı küçük?!Dialogue: 0,0:10:12.18,0:10:14.55,Main,,0,0,0,,Ne? Ne~?!Dialogue: 0,0:10:14.55,0:10:16.20,Main,,0,0,0,,Neler oluyor?!Dialogue: 0,0:10:23.13,0:10:27.51,Main,,0,0,0,,Normal oldu sayılır. Böyle bir insan bedeni olabilir mi?Dialogue: 0,0:10:27.51,0:10:29.27,Main,,0,0,0,,- Et... - Et mi?Dialogue: 0,0:10:30.92,0:10:32.30,Main,,0,0,0,,Hey genç kız.Dialogue: 0,0:10:33.58,0:10:34.86,Main,,0,0,0,,Şanslısınız.Dialogue: 0,0:10:34.86,0:10:35.99,Main,,0,0,0,,Ne oldu?Dialogue: 0,0:10:35.99,0:10:37.12,Main,,0,0,0,,Oradalar.Dialogue: 0,0:10:42.11,0:10:44.45,Main,,0,0,0,,Germa 66.Dialogue: 0,0:10:46.85,0:10:48.46,Main,,0,0,0,,Sanji'yi görebiliyor musun?Dialogue: 0,0:10:49.29,0:10:50.75,Main,,0,0,0,,O mu?Dialogue: 0,0:10:51.79,0:10:55.05,Main,,0,0,0,,Hey, Sanji!Dialogue: 0,0:10:55.05,0:10:58.42,Main,,0,0,0,,Majesteleri, bir cisim yaklaşıyor.Dialogue: 0,0:11:00.01,0:11:02.93,Main,,0,0,0,,Uzun zaman oldu!Dialogue: 0,0:11:02.93,0:11:07.44,Main,,0,0,0,,Ne?! Bu herif buraya kadar gelmiş mi?!Dialogue: 0,0:11:09.13,0:11:12.46,Main,,0,0,0,,Arkasındaki koca ağaç da ne?! Koşuyor!Dialogue: 0,0:11:12.46,0:11:14.40,Main,,0,0,0,,Hey!Dialogue: 0,0:11:14.40,0:11:16.72,Main,,0,0,0,,Sanji-kun!Dialogue: 0,0:11:16.72,0:11:19.35,Main,,0,0,0,,Şükür yetiştik!Dialogue: 0,0:11:19.35,0:11:21.74,Main,,0,0,0,,Bir daha görüşemeyeceğiz sandım!Dialogue: 0,0:11:22.35,0:11:25.26,Main,,0,0,0,,Neden onlar burada?Dialogue: 0,0:11:25.70,0:11:29.19,Main,,0,0,0,,O, Hasır Şapkalı Luffy mi?Dialogue: 0,0:11:29.19,0:11:32.65,Main,,0,0,0,,Hey! Seni almaya geldik!Dialogue: 0,0:11:32.65,0:11:33.91,Main,,0,0,0,,Sanji!Dialogue: 0,0:11:33.91,0:11:36.42,Main,,0,0,0,,Kessene şunu! Araba devrilecek!Dialogue: 0,0:11:36.71,0:11:38.17,Main,,0,0,0,,Geri dönelim Sanji!Dialogue: 0,0:11:38.17,0:11:41.86,Main,,0,0,0,,Mektupta geri döneceğini söyledin ama beklemek istemiyorum.Dialogue: 0,0:11:44.71,0:11:47.47,Flashbacks,,0,0,0,,Ziyafet!Dialogue: 0,0:11:49.84,0:11:52.30,Main,,0,0,0,,Tek başıma gelecektim ama...Dialogue: 0,0:11:52.30,0:11:55.11,Flashbacks,,0,0,0,,Ellerinin önemli olduğunu söylemiştin.Dialogue: 0,0:11:55.44,0:11:59.55,Flashbacks,,0,0,0,,Bu adadan kaçmaya çalışırsan ellerin patlar!Dialogue: 0,0:12:03.03,0:12:06.41,Flashbacks,,0,0,0,,Mama'nın davetini reddeden olursa...Dialogue: 0,0:12:07.64,0:12:10.87,Main,,0,0,0,,Şu an Zoro'lar Wano'ya varmış olmalı.Dialogue: 0,0:12:11.17,0:12:14.83,Flashbacks,,0,0,0,,Bu kişinin başı uçar.Dialogue: 0,0:12:15.90,0:12:19.53,Main,,0,0,0,,Bu yüzden biz de Nami, Chopper Brook ve ben olarak geldik.Dialogue: 0,0:12:19.53,0:12:24.06,Flashbacks,,0,0,0,,Sen kurbansın Sanji. Ben hiç...Dialogue: 0,0:12:24.06,0:12:28.64,Flashbacks,,0,0,0,,Ama erkeklik onuruna ihanet edersen kendi başımı da keserim!Dialogue: 0,0:12:29.51,0:12:30.97,Flashbacks,,0,0,0,,Sanji, yemek!Dialogue: 0,0:12:31.46,0:12:34.92,Flashbacks,,0,0,0,,Seni azıcık bile oğlum olarak görmüyorum.Dialogue: 0,0:12:34.92,0:12:37.51,Flashbacks,,0,0,0,,Bu ebeveynlerin ödemesi gereken bedeldir.Dialogue: 0,0:12:37.51,0:12:39.94,Flashbacks,,0,0,0,,- Kimsenin bilmesini istemediğim bir utanç! - Sanji!Dialogue: 0,0:12:44.22,0:12:46.97,Flashbacks,,0,0,0,,Hey, Sanji!Dialogue: 0,0:12:48.56,0:12:51.69,Flashbacks,,0,0,0,,Sakın üşütme.Dialogue: 0,0:12:53.40,0:12:55.62,Main,,0,0,0,,Ben de ne yapacağımı bilemeyip...Dialogue: 0,0:12:59.88,0:13:02.55,Main,,0,0,0,,Dursana! Ne yapıyorsun Sanji-kun?Dialogue: 0,0:13:06.50,0:13:09.68,Main,,0,0,0,,Defol seni zavallı, ezik korsan!Dialogue: 0,0:13:13.13,0:13:16.77,Main,,0,0,0,,Benim adım Vinsmoke Sanji.Dialogue: 0,0:13:18.10,0:13:19.49,Main,,0,0,0,,Germa Krallığı'nın...Dialogue: 0,0:13:20.59,0:13:22.11,Main,,0,0,0,,...prensiyim.Dialogue: 0,0:13:22.74,0:13:25.26,Main,,0,0,0,,Sır olarak sakladığım için üzgünüm.Dialogue: 0,0:13:25.26,0:13:28.28,Main,,0,0,0,,Sizi zavallı gösterir sanmıştım.Dialogue: 0,0:13:28.93,0:13:33.29,Main,,0,0,0,,Benimle sizin aranızdaki fark tam anlaşılmamış.Dialogue: 0,0:13:33.29,0:13:38.50,Main,,0,0,0,,Burada kalırsam para harcayabilirim ve gönlümce asker hizmetçi tutabilirim.Dialogue: 0,0:13:39.11,0:13:43.40,Main,,0,0,0,,O rezil gemiye ve sizin arkadaşlığına dönmek...Dialogue: 0,0:13:44.12,0:13:49.68,Main,,0,0,0,,...veya burada Yonkou Big Mom'un güzel kızıyla evlenmek.Dialogue: 0,0:13:49.68,0:13:54.80,Main,,0,0,0,,Hangisinin daha mutlu bir hayat olduğu bariz.Dialogue: 0,0:13:54.80,0:13:57.84,Main,,0,0,0,,O mektubu ciddiye alma.Dialogue: 0,0:13:57.84,0:14:00.08,Main,,0,0,0,,Geri dönmeyeceğim!Dialogue: 0,0:14:00.08,0:14:04.90,Main,,0,0,0,,Buraya kadar geldiniz mi? Elinize sağlık.Dialogue: 0,0:14:06.56,0:14:10.24,Main,,0,0,0,,Defol. Adını unuttum.Dialogue: 0,0:14:10.24,0:14:14.12,Main,,0,0,0,,Saçmalama be! Ne diyorsun? Hayatta inanmam!Dialogue: 0,0:14:14.98,0:14:17.65,Main,,0,0,0,,Tamam, onları kovmana yardım edeceğim.Dialogue: 0,0:14:17.65,0:14:18.90,Main,,0,0,0,,Geri dur!Dialogue: 0,0:14:21.24,0:14:22.72,Main,,0,0,0,,Ben...Dialogue: 0,0:14:23.38,0:14:24.76,Main,,0,0,0,,...onları göndereceğim!Dialogue: 0,0:14:34.89,0:14:37.85,Main,,0,0,0,,Göndereceğim de ne demek Sanji?Dialogue: 0,0:14:37.85,0:14:38.94,Main,,0,0,0,,Defol.Dialogue: 0,0:14:39.55,0:14:41.66,Main,,0,0,0,,Başka bir anlamı yok.Dialogue: 0,0:14:44.29,0:14:47.33,Main,,0,0,0,,Neden geldin bilmiyorum ama...Dialogue: 0,0:14:47.33,0:14:50.73,Main,,0,0,0,,...bu kadar sıkıntıya girmeni takdir ediyorum.Dialogue: 0,0:14:51.53,0:14:56.53,Main,,0,0,0,,Ama gerçekten beni düşünseniz tam tersini yapardınız.Dialogue: 0,0:14:57.09,0:15:00.06,Main,,0,0,0,,Sizinle birlikte fakir ve güçsüz olmaktansa...Dialogue: 0,0:15:00.06,0:15:04.04,Main,,0,0,0,,...güçlü ve zengin Big Mom korsanlarının bir parçası olsam daha iyi.Dialogue: 0,0:15:04.98,0:15:06.92,Main,,0,0,0,,Daha mutlu olacağım.Dialogue: 0,0:15:08.30,0:15:13.72,Main,,0,0,0,,Korsanlar Kralı olup olamayacağından da emin değilim zaten.Dialogue: 0,0:15:13.72,0:15:17.25,Main,,0,0,0,,İyi olan tarafta yer almak insan doğasında var.Dialogue: 0,0:15:17.86,0:15:21.98,Main,,0,0,0,,Şakayı kes Sanji-kun! Bir saattir neyden bahsediyorsun?!Dialogue: 0,0:15:24.58,0:15:27.90,Main,,0,0,0,,Öyleyse o kadar zaman...Dialogue: 0,0:15:28.58,0:15:30.90,Main,,0,0,0,,...benimle dalga geçiyordun.Dialogue: 0,0:15:31.75,0:15:33.60,Main,,0,0,0,,Evet, aynen öyle.Dialogue: 0,0:15:35.22,0:15:37.42,Main,,0,0,0,,Seni hor görüyordum.Dialogue: 0,0:15:40.79,0:15:43.42,Main,,0,0,0,,O ışık da ne? Ateş mi?Dialogue: 0,0:15:45.02,0:15:47.50,Main,,0,0,0,,İzlemesi eğlenceli olacak.Dialogue: 0,0:15:49.13,0:15:53.30,Main,,0,0,0,,Fark etmediğinden gerçeği kabullenmek zor geliyordur.Dialogue: 0,0:15:53.75,0:15:56.93,Main,,0,0,0,,Sana kanıtlayacağım. Hazırlan.Dialogue: 0,0:15:58.86,0:16:01.06,Main,,0,0,0,,Diable Jambe...Dialogue: 0,0:15:58.86,0:16:01.06,Attack,,0,0,0,,Şeytan Bacak...Dialogue: 0,0:16:01.06,0:16:02.23,Main,,0,0,0,,Dur Sanji-kun!Dialogue: 0,0:16:08.96,0:16:11.76,Main,,0,0,0,,Joue Shot!Dialogue: 0,0:16:08.96,0:16:11.76,Attack,,0,0,0,,Yanak VuruşuDialogue: 0,0:16:40.68,0:16:42.43,Main,,0,0,0,,Luffy! Kanaman var!Dialogue: 0,0:16:43.19,0:16:46.15,Main,,0,0,0,,Sanji-kun, gerçekten Luffy'ye...Dialogue: 0,0:16:50.91,0:16:52.44,Main,,0,0,0,,Dövüşe hazırlan.Dialogue: 0,0:16:53.12,0:16:56.22,Main,,0,0,0,,Haki kullan yoksa öleceksin.Dialogue: 0,0:16:57.14,0:17:00.66,Main,,0,0,0,,Seninle konuşmak istiyorum. Neden Haki'ye ihtiyaç duyayım?Dialogue: 0,0:17:09.75,0:17:11.36,Main,,0,0,0,,Seninle...Dialogue: 0,0:17:11.36,0:17:12.92,Main,,0,0,0,,...dövüşmeyeceğim!Dialogue: 0,0:17:19.64,0:17:21.14,Main,,0,0,0,,Öyleyse...Dialogue: 0,0:17:22.31,0:17:23.81,Main,,0,0,0,,...defol!Dialogue: 0,0:17:26.92,0:17:29.69,Main,,0,0,0,,Onu da reddediyorum!Dialogue: 0,0:17:31.20,0:17:32.69,Main,,0,0,0,,Sen her zaman...Dialogue: 0,0:17:33.05,0:17:36.07,Main,,0,0,0,,...bencillik ediyorsun!Dialogue: 0,0:17:54.40,0:17:56.01,Flashbacks,,0,0,0,,Hey aşçı!Dialogue: 0,0:17:56.85,0:17:59.57,Flashbacks,,0,0,0,,Arkadaşlarıma katılsana!Dialogue: 0,0:17:59.57,0:18:02.36,Flashbacks,,0,0,0,,Korsan gemimde aşçı ol!Dialogue: 0,0:18:03.97,0:18:06.15,Main,,0,0,0,,Dursana Sanji-kun!Dialogue: 0,0:18:06.89,0:18:09.90,Main,,0,0,0,,Seni almaya geldik sadece.Dialogue: 0,0:18:09.90,0:18:11.44,Main,,0,0,0,,Luffy...Dialogue: 0,0:18:12.48,0:18:17.65,Main,,0,0,0,,...buraya kadar gelmek için üst düzey kişilerle dövüştü.Dialogue: 0,0:18:17.65,0:18:19.02,Main,,0,0,0,,Artık vücudu...Dialogue: 0,0:18:19.02,0:18:20.47,Main,,0,0,0,,Yapma Nami!Dialogue: 0,0:18:21.53,0:18:23.17,Main,,0,0,0,,Buna karışma!Dialogue: 0,0:18:23.79,0:18:24.87,Main,,0,0,0,,Bu...Dialogue: 0,0:18:25.88,0:18:27.49,Main,,0,0,0,,...bir düello!Dialogue: 0,0:18:31.88,0:18:34.05,Main,,0,0,0,,Ne düellosu be?!Dialogue: 0,0:18:39.97,0:18:40.97,Main,,0,0,0,,Sanji-kun!Dialogue: 0,0:19:09.83,0:19:13.73,Main,,0,0,0,,Defol gözlerim görmesin!Dialogue: 0,0:19:19.80,0:19:20.91,Main,,0,0,0,,Luffy!Dialogue: 0,0:19:20.91,0:19:22.22,Main,,0,0,0,,Defol!Dialogue: 0,0:19:22.89,0:19:24.51,Main,,0,0,0,,Defol!Dialogue: 0,0:19:24.51,0:19:27.26,Main,,0,0,0,,Gözümün önünden...Dialogue: 0,0:19:28.18,0:19:30.34,Main,,0,0,0,,...defol!!Dialogue: 0,0:19:53.51,0:19:55.17,Main,,0,0,0,,Reddediyorum!Dialogue: 0,0:20:18.72,0:20:20.03,Main,,0,0,0,,Luffy!Dialogue: 0,0:20:51.10,0:20:52.43,Main,,0,0,0,,Sanji-kun!Dialogue: 0,0:20:56.27,0:20:57.61,Main,,0,0,0,,Geliyorum!Dialogue: 0,0:21:14.27,0:21:17.29,Main,,0,0,0,,Sanji-kun... Dur artık...Dialogue: 0,0:21:29.68,0:21:32.62,Main,,0,0,0,,Yeter dur! Yapma Sanji-kun!Dialogue: 0,0:21:32.62,0:21:34.68,Main,,0,0,0,,Gideceğiz!Dialogue: 0,0:21:41.86,0:21:43.44,Main,,0,0,0,,Gitmeyeceğim!Dialogue: 0,0:21:46.47,0:21:48.41,Flashbacks,,0,0,0,,İyi bir aşçısın.Dialogue: 0,0:21:48.78,0:21:50.91,Flashbacks,,0,0,0,,Beraber korsan olalım!Dialogue: 0,0:21:55.67,0:21:59.07,Main,,0,0,0,,Concassé!Dialogue: 0,0:21:55.67,0:21:59.07,Attack,,0,0,0,,EzDialogue: 0,0:22:17.72,0:22:20.40,Main,,0,0,0,,Luffy! Luffy!Dialogue: 0,0:22:23.73,0:22:25.70,Main,,0,0,0,,Ne kadar güçlü.Dialogue: 0,0:22:25.70,0:22:28.40,Main,,0,0,0,,Bir Vinsmoke'tan da bu beklenir.Dialogue: 0,0:22:35.37,0:22:36.63,Main,,0,0,0,,Luffy!Dialogue: 0,0:22:36.63,0:22:40.13,Main,,0,0,0,,Luffy! Luffy! Baksana! Kendine gel!Dialogue: 0,0:22:40.13,0:22:42.16,Main,,0,0,0,,Luffy! Luffy!Dialogue: 0,0:22:52.26,0:22:54.53,Main,,0,0,0,,Dur Sanji!Dialogue: 0,0:23:00.80,0:23:02.08,Main,,0,0,0,,Elveda.Dialogue: 0,0:23:02.72,0:23:03.52,Main,,0,0,0,,Özür dilerim.Dialogue: 0,0:23:03.52,0:23:05.86,Main,,0,0,0,,Buna katlanmamalıydık.Dialogue: 0,0:23:05.86,0:23:08.90,Main,,0,0,0,,Şirrete bak! Çok ateşli!Dialogue: 0,0:23:18.44,0:23:22.00,Main,,0,0,0,,Gereksiz bağlar sonunda koptu.Dialogue: 0,0:23:22.89,0:23:24.37,Main,,0,0,0,,Beklettim.Dialogue: 0,0:23:25.44,0:23:27.46,Main,,0,0,0,,- Gidelim. - Baş üstüne.Dialogue: 0,0:23:36.42,0:23:37.58,Main,,0,0,0,,Luffy!Dialogue: 0,0:23:42.35,0:23:44.42,Main,,0,0,0,,Bekle!Dialogue: 0,0:23:44.42,0:23:46.87,Main,,0,0,0,,Sanji!!Dialogue: 0,0:23:52.64,0:23:55.50,Main,,0,0,0,,Ne zavallı korsanı be?!Dialogue: 0,0:23:55.50,0:23:58.62,Main,,0,0,0,,İstemediğin şeyler söylediğini biliyorum!Dialogue: 0,0:23:58.62,0:24:00.94,Main,,0,0,0,,Yalan söylemeyi kes!Dialogue: 0,0:24:00.94,0:24:05.29,Main,,0,0,0,,Beni böyle kolayca gönderebilir misin sandın?!Dialogue: 0,0:24:05.29,0:24:07.46,Main,,0,0,0,,Saçmalama be!Dialogue: 0,0:24:07.46,0:24:11.47,Main,,0,0,0,,Beni ne kadar tekmelersen tekmele...Dialogue: 0,0:24:12.27,0:24:13.95,Main,,0,0,0,,...acı çeken kişi...Dialogue: 0,0:24:16.12,0:24:18.28,Main,,0,0,0,,...sensin!Dialogue: 0,0:24:27.94,0:24:32.05,Main,,0,0,0,,Luffy! Neden?! Sebep ne olursa olsun bunu--Dialogue: 0,0:24:32.05,0:24:33.61,Main,,0,0,0,,Kapa çeneni!Dialogue: 0,0:24:34.22,0:24:36.07,Main,,0,0,0,,Duralım mı Sanji?Dialogue: 0,0:24:37.90,0:24:39.58,Main,,0,0,0,,Devam edin.Dialogue: 0,0:24:47.28,0:24:48.71,Flashbacks,,0,0,0,,Sen...Dialogue: 0,0:24:49.38,0:24:52.00,Flashbacks,,0,0,0,,...All Blue'yu biliyor musun?Dialogue: 0,0:24:52.00,0:24:54.99,Flashbacks,,0,0,0,,Mucizevi bir deniz!Dialogue: 0,0:24:54.99,0:24:56.68,Flashbacks,,0,0,0,,O denizde...Dialogue: 0,0:24:59.25,0:25:01.21,Main,,0,0,0,,Yolculuğumuz...Dialogue: 0,0:25:02.06,0:25:04.21,Main,,0,0,0,,...daha bitmedi!Dialogue: 0,0:25:06.21,0:25:09.65,Main,,0,0,0,,Burada bekleyeceğim!Dialogue: 0,0:25:09.65,0:25:14.67,Main,,0,0,0,,Geri gelmezsen burada ben...Dialogue: 0,0:25:14.67,0:25:16.82,Main,,0,0,0,,...açlıktan öleceğim!Dialogue: 0,0:25:17.72,0:25:22.12,Main,,0,0,0,,Sen benim gemimin aşçısısın!Dialogue: 0,0:25:22.12,0:25:25.69,Flashbacks,,0,0,0,,Gene sıçanlar için yemek yapmış.Dialogue: 0,0:25:26.88,0:25:31.83,Main,,0,0,0,,Senin pişirdiklerinden başka bir şey yemeyeceğim!Dialogue: 0,0:25:34.59,0:25:38.87,Main,,0,0,0,,Acıksam da üstüme mızraklar da yağsa...Dialogue: 0,0:25:38.87,0:25:43.19,Main,,0,0,0,,...burada kalıp seni bekleyeceğim!Dialogue: 0,0:25:58.10,0:26:02.52,Main,,0,0,0,,Geri döndüğüne emin ol Sanji!Dialogue: 0,0:26:03.12,0:26:07.37,Main,,0,0,0,,Sen olmadan ben...Dialogue: 0,0:26:07.94,0:26:12.77,Main,,0,0,0,,...Korsanlar Kralı olamam!Dialogue: 0,0:26:14.51,0:26:18.00,Credits,,0,0,0,,Editing:  Feeso, Galaxy 9000  Timing: Halee  Quality Assurance: Galaxy 9000, Grug, Mr. Luffy, Pepperjack  Soundtracking:  Halee  Graphics:  Datenshi  Translation: Crunchyroll