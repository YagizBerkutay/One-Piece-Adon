Dialogue: 0,0:01:39.72,0:01:43.35,Title,,0,0,250,,{\fad(500,0)}Bana Güveniyorlar
Dialogue: 0,0:01:43.35,0:01:46.60,Main,,0,0,0,,Sinir bozucu, değil mi?
Dialogue: 0,0:01:46.60,0:01:50.34,Main,,0,0,0,,Doğrulmak istiyorsun ama fırsat vermiyorum.
Dialogue: 0,0:01:50.34,0:01:55.42,Main,,0,0,0,,Sol yumruğunu kullanmak istiyorsun,\Nsol omzuna darbe indiriyorum.
Dialogue: 0,0:01:55.42,0:01:59.95,Main,,0,0,0,,Sağ yumruğunu kullanmak istiyorsun,\Nsağ omzuna darbe indiriyorum.
Dialogue: 0,0:01:59.95,0:02:05.99,Main,,0,0,0,,Nitekim hüsrana boğulmaktan başka\Nçaresi olmayan bir budalasın!
Dialogue: 0,0:02:05.99,0:02:09.92,Main,,0,0,0,,Birinin ciğerini okuması böyle bir şeydir işte.
Dialogue: 0,0:02:10.82,0:02:15.38,Main,,0,0,0,,Lakin hüsrana uğraman bana yetmez.
Dialogue: 0,0:02:15.87,0:02:19.62,Main,,0,0,0,,Ya sol ya da sağ tekme...
Dialogue: 0,0:02:19.62,0:02:22.82,Main,,0,0,0,,Daha kılını kıpırdatmamışken\Ndarbe yiyeceksin!
Dialogue: 0,0:02:22.82,0:02:28.20,Main,,0,0,0,,Cesaretin kırılana kadar da\Nbuna devam edeceğim!
Dialogue: 0,0:02:35.20,0:02:38.22,Flashbacks,,0,0,0,,{\i1}Her saldırının bir iradesi vardır.
Dialogue: 0,0:02:43.18,0:02:44.81,Flashbacks,,0,0,0,,{\i1}Keza bir varlığı!
Dialogue: 0,0:02:49.46,0:02:52.80,Flashbacks,,0,0,0,,{\i1}Bodoslama saldırma Luffy.
Dialogue: 0,0:02:59.48,0:03:00.52,Main,,0,0,0,,Al bunu!
Dialogue: 0,0:03:20.81,0:03:22.79,Thoughts,,0,0,0,,{\i1}Bu herif...\NDüşündüğüm gibi!
Dialogue: 0,0:03:30.24,0:03:34.84,Thoughts,,0,0,0,,{\i1}Sürekli olmasa da benim gibi\Ngeleceği görmeye başlıyor!
Dialogue: 0,0:03:46.52,0:03:48.53,Main,,0,0,1,,Olamaz!
Dialogue: 0,0:03:47.15,0:03:53.16,Captions,,0,0,175,,{\fad(500,500)}Bölge Suları - Bege'nin Gemisi
Dialogue: 0,0:03:48.53,0:03:49.43,Main,,0,0,1,,Ne oldu?
Dialogue: 0,0:03:49.43,0:03:52.95,Main,,0,0,1,,Pastanın tepesine krem şantiden...
Dialogue: 0,0:03:52.95,0:03:55.58,Main,,0,0,0,,...gül desenleri yapmayı unuttum!
Dialogue: 0,0:03:56.57,0:03:58.74,Main,,0,0,0,,Ben yaparım.
Dialogue: 0,0:03:58.74,0:04:00.38,Main,,0,0,0,,Krem şanti torbası verin!
Dialogue: 0,0:04:00.38,0:04:01.16,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:04:01.59,0:04:03.49,Main,,0,0,0,,{\fad(150,150)}Sky Walk!
Dialogue: 0,0:04:01.59,0:04:03.49,Note,,0,0,0,,{\fad(150,150)}Sema Yürüyüşü
Dialogue: 0,0:04:17.55,0:04:18.68,Main,,0,0,0,,Vay canına!
Dialogue: 0,0:04:18.68,0:04:19.47,Main,,0,0,0,,Şahane!
Dialogue: 0,0:04:21.91,0:04:23.93,Main,,0,0,0,,Tamamdır! Oldu!
Dialogue: 0,0:04:25.24,0:04:25.92,Main,,0,0,0,,Evet!
Dialogue: 0,0:04:25.92,0:04:26.77,Main,,0,0,0,,Nihayet!
Dialogue: 0,0:04:26.77,0:04:31.94,Main,,0,0,0,,Big Mom'ı durdurmak için yapılmış\Nemsalsiz pasta tamamlanmıştır!
Dialogue: 0,0:04:35.90,0:04:39.45,Main,,0,0,0,,Enfes kokuyor ya...\NBayılacak gibi oluyorum-rero.
Dialogue: 0,0:04:39.45,0:04:41.99,Main,,0,0,0,,Başka söze hacet yok!
Dialogue: 0,0:04:41.99,0:04:45.64,Main,,0,0,0,,Zehir koymaya da lüzum yok!
Dialogue: 0,0:04:45.64,0:04:49.81,Main,,0,0,0,,Big Mom lezzetinden nalları diker umarım!
Dialogue: 0,0:04:55.85,0:04:58.55,Main,,0,0,0,,Şükürler olsun! Yetiştirdik!
Dialogue: 0,0:04:58.55,0:04:59.97,Main,,0,0,0,,Pudding-{\i1}sama{\i1}!{\i0}
Dialogue: 0,0:05:01.44,0:05:02.15,Main,,0,0,0,,Ne?
Dialogue: 0,0:05:04.47,0:05:07.51,Main,,0,0,0,,Hey, siz iyi misiniz?
Dialogue: 0,0:05:07.51,0:05:09.73,Main,,0,0,0,,Şefler birbiri ardına yıkıldılar!
Dialogue: 0,0:05:09.73,0:05:12.97,Main,,0,0,0,,Hiç soluklanmadan çalışmış olmalılar!
Dialogue: 0,0:05:27.73,0:05:32.48,Main,,0,0,0,,Hiç kalkma. Planlarınızdan haberdarız.
Dialogue: 0,0:05:33.57,0:05:36.40,Main,,0,0,0,,"Gece 1'de Kakao Adası'nda."
Dialogue: 0,0:05:36.40,0:05:41.34,Main,,0,0,0,,Kakao Adası'na adımınızı atamadan\Ngeberip gideceksiniz tabii.
Dialogue: 0,0:05:42.32,0:05:47.75,Main,,0,0,0,,Kardeşlerim filolarıyla\Npusuya yatmış vaziyetteler.
Dialogue: 0,0:05:47.75,0:05:52.63,Main,,0,0,0,,Yani buradan çıkabilsen bile\Nbir şey değişmeyecek.
Dialogue: 0,0:05:54.63,0:05:55.88,Main,,0,0,0,,Yine de...
Dialogue: 0,0:05:57.17,0:06:02.34,Main,,0,0,0,,...mutlaka bir aynadan çıkacağım!
Dialogue: 0,0:06:07.16,0:06:10.48,Main,,0,0,0,,Neden böyle gamsız konuşuyorsun ki?
Dialogue: 0,0:06:12.44,0:06:14.86,Main,,0,0,0,,Pudding-{\i1}chan{\i1}! {\i0}Chiffon-{\i1}chan{\i1}!{\i0}
Dialogue: 0,0:06:15.54,0:06:18.46,Main,,0,0,0,,Yardımlarınız olmasa başaramazdım. \NTeşekkürler!
Dialogue: 0,0:06:20.22,0:06:21.67,Main,,0,0,0,,Bu pasta sayesinde...
Dialogue: 0,0:06:22.30,0:06:25.13,Main,,0,0,0,,...hiç şüphesiz ki\Narkadaşlarımı kurtarabilirim.
Dialogue: 0,0:06:29.26,0:06:33.71,Main,,0,0,0,,Orası bilinmez bak!\NTamam, pasta hazır da...
Dialogue: 0,0:06:33.71,0:06:36.52,Main,,0,0,0,,...arkadaşların çoktan geberip gitmiş olabilir!
Dialogue: 0,0:06:36.88,0:06:40.89,Main,,0,0,0,,Hem hayattalarsa da Mama'nın pastayı\Nbeğenip beğenmeyeceği kesin değil!
Dialogue: 0,0:06:40.89,0:06:45.76,Main,,0,0,0,,Bu rezil pastayı götürmenin\Nbir anlamı yok yani Sanji...
Dialogue: 0,0:06:45.76,0:06:46.45,Main,,0,0,0,,...{\i1}san{\i1}!{\i0}
Dialogue: 0,0:06:47.82,0:06:49.62,Main,,0,0,0,,Böyle demek istemedin, değil mi Pudding?
Dialogue: 0,0:06:49.62,0:06:54.66,Main,,0,0,0,,Hayır ya, istemedim tabii!\NAğzımdan neler çıkıyor ya?
Dialogue: 0,0:06:55.90,0:06:59.15,Main,,0,0,0,,Ne olursa olsun gitmem gerek.
Dialogue: 0,0:07:09.36,0:07:12.71,Main,,0,0,0,,Bekleyin!
Dialogue: 0,0:07:14.58,0:07:18.63,Main,,0,0,0,,Düğün pastası!
Dialogue: 0,0:07:18.63,0:07:21.53,Main,,0,0,0,,{\fad(150,150)}Rumble! Monster Point!
Dialogue: 0,0:07:18.63,0:07:21.53,Attack,,0,0,0,,{\fad(150,150)}Gümbürtü! Canavar Noktası!
Dialogue: 0,0:07:26.01,0:07:28.35,Main,,0,0,0,,Ben durdururum.
Dialogue: 0,0:07:28.35,0:07:33.31,Main,,0,0,0,,O şey de ne lan?\NO gemideki herkes canavar mı be?
Dialogue: 0,0:07:33.31,0:07:36.36,Main,,0,0,0,,Napoleon! Tekrar uza bakayım!
Dialogue: 0,0:07:36.36,0:07:38.24,Main,,0,0,0,,Emrin olur Mama!
Dialogue: 0,0:07:41.36,0:07:46.20,Main,,0,0,0,,Chopper! Brook! Jinbe!\NŞimdi gemiyi savunabilirsek...
Dialogue: 0,0:07:46.20,0:07:48.53,Main,,0,0,0,,Evet, farkındayım!
Dialogue: 0,0:07:48.53,0:07:50.74,Main,,0,0,0,,Açıklamana lüzum yok.
Dialogue: 0,0:07:52.04,0:07:53.36,Main,,0,0,0,,Evet!
Dialogue: 0,0:07:53.36,0:07:57.96,Main,,0,0,0,,O vakit gelene değin\Nne olursa olsun göğüs gereceğiz!
Dialogue: 0,0:07:58.52,0:08:03.16,Main,,0,0,0,,En şahane pastayı götürüp\Nmutlaka Mom'ı durduracağım.
Dialogue: 0,0:08:03.16,0:08:05.51,Main,,0,0,0,,Seni pataklayıp...
Dialogue: 0,0:08:07.72,0:08:10.85,Main,,0,0,0,,...mutlaka bir aynadan çıkacağım!
Dialogue: 0,0:08:11.77,0:08:13.14,Main,,0,0,0,,Onlar...
Dialogue: 0,0:08:14.32,0:08:17.48,Main,,0,0,0,,...bana inanıyor çünkü!
Dialogue: 0,0:08:20.54,0:08:22.94,Main,,0,0,0,,Seni ortadan ikiye ayıracağım!
Dialogue: 0,0:08:22.94,0:08:25.70,Main,,0,0,0,,{\fad(150,150)}Kokutei: Palme!
Dialogue: 0,0:08:22.94,0:08:25.70,Attack,,0,0,0,,{\fad(150,150)}Oyma Toynak: Palmiye
Dialogue: 0,0:08:32.64,0:08:33.58,Main,,0,0,0,,Chopper!
Dialogue: 0,0:08:34.59,0:08:36.12,Main,,0,0,0,,{\fad(150,150)}Gust Sword!
Dialogue: 0,0:08:34.59,0:08:36.12,Attack,,0,0,0,,{\fad(150,150)}Bora Kılıcı
Dialogue: 0,0:08:44.82,0:08:46.42,Main,,0,0,0,,{\fad(150,150)}Soul Parade!
Dialogue: 0,0:08:44.82,0:08:46.42,Attack,,0,0,0,,{\fad(150,150)}Ruh Töreni
Dialogue: 0,0:08:49.97,0:08:51.76,Main,,0,0,0,,{\fad(150,150)}Cognac!
Dialogue: 0,0:08:51.76,0:08:54.14,Main,,0,0,0,,Yapma!
Dialogue: 0,0:09:06.53,0:09:08.99,Main,,0,0,0,,Chopper! Artık savaşamazsın!
Dialogue: 0,0:09:08.99,0:09:13.04,Main,,0,0,0,,Başka çarem yok!\NNeyin varmış görelim Big Mom!
Dialogue: 0,0:09:13.04,0:09:18.60,Main,,0,0,0,,Hiç yoktan seni de beraberimde\Ngötürerek denizin dibini boylarım!
Dialogue: 0,0:09:20.45,0:09:22.43,Main,,0,0,0,,Azmini takdir ettim!
Dialogue: 0,0:09:22.43,0:09:26.21,Main,,0,0,0,,Peki şimdi de beni götürebilir misin?
Dialogue: 0,0:09:50.00,0:09:52.07,Main,,0,0,0,,Gerçek... olamaz...
Dialogue: 0,0:09:56.95,0:09:59.87,Main,,0,0,0,,Bu ebatlardayken\Ndeniz suyu bile etkisiz kalır!
Dialogue: 0,0:09:59.87,0:10:03.00,Main,,0,0,0,,Bir Yonkou'nun ruhu\Nböyle oluyormuş demek!
Dialogue: 0,0:10:07.43,0:10:10.43,Main,,0,0,0,,Haydi, gidebildiğiniz kadar uzağa kaçın!
Dialogue: 0,0:10:10.44,0:10:14.64,Main,,0,0,0,,Bir çaresine bakmazsak Sunny-go ile\Nbirlikte yanıp kül olacağız!
Dialogue: 0,0:10:15.79,0:10:18.53,Main,,0,0,0,,Bu kadar dayandıktan sonra\Ninsana koyuyor!
Dialogue: 0,0:10:18.53,0:10:21.40,Main,,0,0,0,,Hem Sanji-{\i1}kun{\i0}'un da eli kulağındadır!
Dialogue: 0,0:10:21.40,0:10:25.24,Main,,0,0,0,,Epey keyif aldım çocuklar.
Dialogue: 0,0:10:25.24,0:10:27.69,Main,,0,0,0,,Şimdi pastayı verin.
Dialogue: 0,0:10:41.38,0:10:42.96,Main,,0,0,0,,Burnuma gelen...
Dialogue: 0,0:10:43.72,0:10:46.17,Main,,0,0,0,,...enfes koku da neyin nesi?
Dialogue: 0,0:10:48.76,0:10:51.83,Main,,0,0,0,,Doğrulma artık. Kazanma şansın yok!
Dialogue: 0,0:10:56.17,0:11:01.43,Main,,0,0,0,,{\i1}Bu andavalın Gözlem Hakisi\Ngitgide benim seviyeme yaklaşıyor!
Dialogue: 0,0:11:20.53,0:11:24.74,Main,,0,0,0,,{\i1}Bir an önce icabına bakmazsam\Nbeklenmedik bir vaka zuhur edebilir!
Dialogue: 0,0:11:28.39,0:11:29.53,Main,,0,0,0,,{\fad(150,150)}Mochi...
Dialogue: 0,0:11:31.85,0:11:33.25,Main,,0,0,0,,{\fad(150,150)}Tsuki!
Dialogue: 0,0:11:31.85,0:11:33.25,Attack,,0,0,0,,{\fad(150,150)}Saplayışı!
Dialogue: 0,0:11:50.58,0:11:52.09,Main,,0,0,0,,O gemi...
Dialogue: 0,0:11:55.22,0:11:56.29,Main,,0,0,0,,Çocuklar!
Dialogue: 0,0:11:58.30,0:12:00.04,Main,,0,0,0,,Gemi geldi!
Dialogue: 0,0:12:01.46,0:12:03.63,Main,,0,0,0,,Pasta da güvertede!
Dialogue: 0,0:12:08.18,0:12:11.51,Main,,0,0,0,,Sanji-{\i1}kun{\i0}lar pastayı pişirip getirmişler!
Dialogue: 0,0:12:11.51,0:12:13.48,Main,,0,0,0,,Oh, Sanji!
Dialogue: 0,0:12:13.48,0:12:15.48,Main,,0,0,0,,Sanji-{\i1}san{\i1}!{\i0}
Dialogue: 0,0:12:15.92,0:12:16.89,Main,,0,0,0,,Mama!
Dialogue: 0,0:12:20.04,0:12:22.48,Main,,0,0,0,,Enfes kokuyor ya!
Dialogue: 0,0:12:26.28,0:12:29.87,Main,,0,0,0,,Geminiz karşıda işte Kara Bacak!
Dialogue: 0,0:12:29.87,0:12:35.25,Main,,0,0,0,,Sıçtığımın Prometheus'u Big Mom'ın\Nruhuyla birlikte devasa boyutlara çıkmış!
Dialogue: 0,0:12:35.25,0:12:39.58,Main,,0,0,0,,Devasa Prometheus'un tepesinde de\NBig Mom'ı görüyorum-rero.
Dialogue: 0,0:12:39.58,0:12:42.59,Main,,0,0,0,,Baba! Arkalarında ise...
Dialogue: 0,0:12:42.59,0:12:44.21,Main,,0,0,0,,...Perospero ile...
Dialogue: 0,0:12:44.21,0:12:45.59,Main,,0,0,0,,...Bavarois...
Dialogue: 0,0:12:45.59,0:12:48.05,Main,,0,0,0,,Hatta Smoothieler de var!
Dialogue: 0,0:12:48.05,0:12:52.31,Main,,0,0,0,,Peşlerinde son derece\Nbaş belası bir filo varmış.
Dialogue: 0,0:12:52.31,0:12:54.90,Main,,0,0,0,,Gemileri de harap olmuş!
Dialogue: 0,0:12:58.10,0:13:00.25,Main,,0,0,0,,Nişan almaya hazırlanın millet!
Dialogue: 0,0:13:00.25,0:13:01.69,Main,,0,0,0,,Tamam!
Dialogue: 0,0:13:01.69,0:13:05.71,Main,,0,0,0,,Rakibimiz Big Mom! Gözünüzü dört açın!
Dialogue: 0,0:13:05.71,0:13:10.45,Main,,0,0,0,,Lakin fırsatını yakaladınız mı\No kadını delik deşik edin!
Dialogue: 0,0:13:10.45,0:13:14.26,Main,,0,0,0,,Tamamdır!
Dialogue: 0,0:13:12.84,0:13:14.26,Secondary,,0,0,0,,{\i1}Rero{\i}!
Dialogue: 0,0:13:21.69,0:13:26.09,Main,,0,0,0,,Nami-{\i1}san{\i0}! Seni kurtarmaya geldim!
Dialogue: 0,0:13:26.09,0:13:32.65,Main,,0,0,0,,O değil de Big Mom ile Perospero\Nsaatlerdir peşlerinde olmalı.
Dialogue: 0,0:13:32.65,0:13:37.10,Main,,0,0,0,,Sağ kalmalarından etkilendim bak!\NBaşlarında kaptanları bile olmadan!
Dialogue: 0,0:13:37.10,0:13:39.89,Main,,0,0,0,,Nami-{\i1}san{\i1}!{\i0}
Dialogue: 0,0:13:39.89,0:13:43.44,Main,,0,0,0,,Pruvada duran biri var! Ama şöyle\Ntuhaf bir enerji hissetmiyor musunuz?
Dialogue: 0,0:13:43.44,0:13:48.74,Main,,0,0,0,,Haki de değil. İyi de\NBege'nin gemisinde ne arıyorlar ki?
Dialogue: 0,0:13:48.74,0:13:52.01,Main,,0,0,0,,Pruvada dans eden biri var!
Dialogue: 0,0:13:52.01,0:13:55.99,Main,,0,0,0,,Bize ne be! Asıl mesele pasta!
Dialogue: 0,0:13:57.76,0:14:04.05,Main,,0,0,0,,Düğünde gördüğümüz pastayı\Ncidden yeniden yapmışlar!
Dialogue: 0,0:14:05.63,0:14:11.34,Main,,0,0,0,,Mama tadını beğenirse\NAçlık Krizi dinecektir de...
Dialogue: 0,0:14:11.34,0:14:16.22,Main,,0,0,0,,...gemide Bege var!\NPastanın zehirli olduğu aşikâr!
Dialogue: 0,0:14:16.22,0:14:20.72,Main,,0,0,0,,Ne yapsam ki? Ne yapsam ya?\NNe yapsam acaba? Ne yapsam ya?
Dialogue: 0,0:14:24.19,0:14:29.11,Main,,0,0,0,,Enfes koku sayesinde saldırıyı kesti.
Dialogue: 0,0:14:29.11,0:14:30.38,Main,,0,0,0,,Bir an...
Dialogue: 0,0:14:30.38,0:14:33.49,Main,,0,0,0,,...gidiciyim demiştim.
Dialogue: 0,0:14:34.71,0:14:37.37,Thoughts,,0,0,0,,{\i1}Pastayı havaya mı uçursam?
Dialogue: 0,0:14:37.37,0:14:42.15,Thoughts,,0,0,0,,{\i1}Olmaz, o zaman da Mama'nın krizini\Ndindirecek bir şey kalmaz ve...
Dialogue: 0,0:14:42.15,0:14:44.01,Thoughts,,0,0,0,,...ülke yok olur!
Dialogue: 0,0:14:44.01,0:14:47.56,Thoughts,,0,0,0,,{\i1}Ama zehirli pastayı yiyip ölürse de...
Dialogue: 0,0:14:47.56,0:14:50.81,Thoughts,,0,0,0,,...hem ülkenin hem de korsan\Ntayfamızın sonu gelecektir!
Dialogue: 0,0:14:50.81,0:14:54.93,Thoughts,,0,0,0,,{\i1}Ne yapsam ya?\NHangisini seçmeliyim ki?
Dialogue: 0,0:14:56.45,0:14:58.05,Main,,0,0,0,,Bak hele Kara Bacak!
Dialogue: 0,0:14:59.49,0:15:04.59,Main,,0,0,0,,Bir anlaşmamız vardı!\NPastayı biz alıyoruz.
Dialogue: 0,0:15:05.48,0:15:11.94,Main,,0,0,0,,Söz verdiğim gibi Mama pastayı yiyip\Nkarnını doyurana kadar ona dokunmayacağız.
Dialogue: 0,0:15:11.94,0:15:13.57,Main,,0,0,0,,Fakat...
Dialogue: 0,0:15:14.14,0:15:16.91,Main,,0,0,0,,...akabinde dilediğimi yapmakta\Nözgürüm, değil mi?
Dialogue: 0,0:15:16.91,0:15:23.40,Main,,0,0,0,,Kafana göre takıl. Vazifemiz\Nbu pasta ile Big Mom'ı sakinleştirmekti.
Dialogue: 0,0:15:23.40,0:15:25.82,Main,,0,0,0,,Onu durdurabiliriz!
Dialogue: 0,0:15:25.82,0:15:28.30,Main,,0,0,0,,Hazırız Sanji...
Dialogue: 0,0:15:29.18,0:15:30.28,Main,,0,0,0,,...{\i1}san{\i1}!{\i0}
Dialogue: 0,0:15:30.28,0:15:31.43,Main,,0,0,0,,Hemen geliyorum.
Dialogue: 0,0:15:31.43,0:15:34.42,Main,,0,0,0,,Acele etsene dangalak,\Ncanına susamadıysan!
Dialogue: 0,0:15:34.95,0:15:36.20,Main,,0,0,0,,Pudding!
Dialogue: 0,0:15:37.95,0:15:40.60,Main,,0,0,0,,Kendine dikkat et!
Dialogue: 0,0:15:43.01,0:15:45.09,Main,,0,0,0,,Şimdi mutlu musun?
Dialogue: 0,0:15:45.99,0:15:47.13,Main,,0,0,0,,Hem de nasıl.
Dialogue: 0,0:15:47.90,0:15:50.60,Main,,0,0,0,,Holça kal abla.
Dialogue: 0,0:15:53.58,0:15:56.44,Main,,0,0,0,,Rabiyan! Tam hız!
Dialogue: 0,0:15:59.18,0:16:02.57,Main,,0,0,0,,Peros abim ile Bavarois abimin\Nfark edemeyeceği bir hızda!
Dialogue: 0,0:16:02.57,0:16:03.49,Main,,0,0,0,,Tamamdır!
Dialogue: 0,0:16:09.22,0:16:13.58,Main,,0,0,0,,Düğün pastam!
Dialogue: 0,0:16:13.58,0:16:15.37,Main,,0,0,0,,İşte buradasın!
Dialogue: 0,0:16:17.98,0:16:20.96,Main,,0,0,0,,Nihayet buldum! Gidelim!
Dialogue: 0,0:16:20.98,0:16:22.09,Main,,0,0,0,,Emredersin!
Dialogue: 0,0:16:22.09,0:16:23.26,Main,,0,0,0,,Mama!
Dialogue: 0,0:16:23.28,0:16:28.35,Main,,0,0,0,,Düğün pastası!
Dialogue: 0,0:16:28.35,0:16:31.16,Main,,0,0,0,,Geliyor! Sancak alabanda!
Dialogue: 0,0:16:31.16,0:16:31.89,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:16:31.89,0:16:37.35,Main,,0,0,0,,Tam süratle güneybatıya!\Nİstikamet Likör Adası!
Dialogue: 0,0:16:41.61,0:16:46.24,Main,,0,0,0,,Perospero-{\i1}sama{\i0}! \NPastayı taşıyan gemi rotasını değiştirdi!
Dialogue: 0,0:16:46.24,0:16:47.20,Main,,0,0,0,,Neden ama?
Dialogue: 0,0:16:47.20,0:16:51.49,Main,,0,0,0,,Pastanın ilgisini çekmesiyle\NMama, Bege'nin gemisinin peşine düştü!
Dialogue: 0,0:16:51.49,0:16:54.60,Main,,0,0,0,,Hasır Şapka'nın gemisiyle\NBege'nin gemisi...
Dialogue: 0,0:16:54.60,0:16:59.26,Main,,0,0,0,,Birbirlerinden ayrılarak\Ngücümüzü bölmek istiyorlar.
Dialogue: 0,0:17:03.68,0:17:05.67,Main,,0,0,0,,Selam! Döndüm!
Dialogue: 0,0:17:05.67,0:17:06.65,Main,,0,0,0,,Sanji-{\i1}kun!{\i}
Dialogue: 0,0:17:06.65,0:17:08.59,Main,,0,0,0,,Sanji-{\i1}san{\i1}!{\i0} Pudding-{\i1}san{\i1}!{\i0}
Dialogue: 0,0:17:08.59,0:17:10.37,Main,,0,0,0,,Sanji!
Dialogue: 0,0:17:10.37,0:17:13.80,Main,,0,0,0,,Hayatımız pamuk ipliğine bağlıydı ya!\Nİşimiz bitti sanmıştık! Teşekkürler!
Dialogue: 0,0:17:13.80,0:17:16.25,Main,,0,0,0,,Bir şeyinin olmamasına çok sevindim!
Dialogue: 0,0:17:20.52,0:17:22.44,Main,,0,0,0,,Güm güm!
Dialogue: 0,0:17:22.82,0:17:25.65,Main,,0,0,0,,Ben de seni seviyorum Nami-swan!
Dialogue: 0,0:17:26.72,0:17:30.50,Main,,0,0,0,,Bu arada Sanji-{\i1}san{\i0},\NBege'nin gemisinde ne işiniz vardı?
Dialogue: 0,0:17:32.54,0:17:34.44,Main,,0,0,0,,Uzun hikâye.
Dialogue: 0,0:17:34.44,0:17:37.41,Main,,0,0,0,,Bege'nin gemisi nereye gidiyor?
Dialogue: 0,0:17:38.09,0:17:42.58,Main,,0,0,0,,Pastayı yedikten sonra\NMom'ın n'apacağını bilmiyoruz.
Dialogue: 0,0:17:42.58,0:17:46.88,Main,,0,0,0,,Bu yüzden pastayı\Nen yakın adaya götürüyorlar.
Dialogue: 0,0:17:46.88,0:17:50.40,Main,,0,0,0,,Ne? Kendilerince yem olmaya mı\Nkarar verdiler yani?
Dialogue: 0,0:17:50.40,0:17:53.03,Main,,0,0,0,,Neden böyle bir şey yapıyor ki?
Dialogue: 0,0:17:53.03,0:17:55.91,Main,,0,0,0,,Hâlâ kadına suikast düzenlemek istiyor.
Dialogue: 0,0:17:55.91,0:17:58.18,Main,,0,0,0,,Anladım. Bege'den beklenir.
Dialogue: 0,0:17:58.91,0:18:02.11,Main,,0,0,0,,Benim için mühim olan\Nbu geminin emniyetidir.
Dialogue: 0,0:18:02.11,0:18:05.96,Main,,0,0,0,,Mom'ı üzerine çekiyorsa canıma minnet.
Dialogue: 0,0:18:05.96,0:18:07.19,Main,,0,0,0,,O değil de...
Dialogue: 0,0:18:08.70,0:18:10.71,Main,,0,0,0,,...gemi de harap olmuş.
Dialogue: 0,0:18:10.71,0:18:13.32,Main,,0,0,0,,Üzgünüm, daha iyi korumalıydım.
Dialogue: 0,0:18:13.32,0:18:18.04,Main,,0,0,0,,Neler diyorsun ya? \NSen olmasan şimdiye hepimiz......
Dialogue: 0,0:18:18.04,0:18:21.65,Main,,0,0,0,,Konuşma faslını sonraya saklayalım.\NBaşınıza bir iş gelmediğine çok sevindim.
Dialogue: 0,0:18:22.93,0:18:26.71,Main,,0,0,0,,Sahi, Pedro ile Carrot-chan nerede?
Dialogue: 0,0:18:30.94,0:18:32.20,Main,,0,0,0,,Şey...
Dialogue: 0,0:18:32.20,0:18:37.44,Main,,0,0,0,,K- Kamarada uyuyorlar!\Nİkisi de savaşmaktan bitap düştü.
Dialogue: 0,0:18:39.88,0:18:41.73,Main,,0,0,0,,Peros abi, n'apacağız şimdi?
Dialogue: 0,0:18:41.73,0:18:44.19,Main,,0,0,0,,Hasır Şapka'nın gemisini mi yoksa\NMama'yı mı takip etmeliyiz?
Dialogue: 0,0:18:50.69,0:18:53.11,Main,,0,0,0,,Ben... Bege!
Dialogue: 0,0:18:53.11,0:18:56.83,Main,,0,0,0,,Bege! Neyin peşindesin lan?
Dialogue: 0,0:18:56.83,0:18:59.88,Main,,0,0,0,,Pastanın senin güvertende\Nne işi var ki?
Dialogue: 0,0:19:01.19,0:19:05.18,Main,,0,0,0,,Mama'nın Açlık Krizini biz dindireceğiz.
Dialogue: 0,0:19:05.18,0:19:08.16,Main,,0,0,0,,Pastayı yedirip kadını rahata erdireceğiz.
Dialogue: 0,0:19:08.16,0:19:13.59,Main,,0,0,0,,Ufak at da civcivler yesin lan, hain!\NPastaya ne koydun lan?
Dialogue: 0,0:19:13.59,0:19:19.25,Main,,0,0,0,,Bir halt koymadım. \NPastayı Pudding'in yaptığını bilmiyor musun?
Dialogue: 0,0:19:19.25,0:19:22.30,Main,,0,0,0,,Sahi! Pudding nerede lan?
Dialogue: 0,0:19:22.30,0:19:28.08,Main,,0,0,0,,Mama için de Pudding için de\No güzel kafanı yorma sen.
Dialogue: 0,0:19:28.08,0:19:30.66,Main,,0,0,0,,Gönlünü ferah tutup\NHasır Şapka'nın peşine düş.
Dialogue: 0,0:19:30.66,0:19:31.98,Main,,0,0,0,,{\i1}Senin gelmişini geçmişini...
Dialogue: 0,0:19:34.23,0:19:36.15,Main,,0,0,0,,Hey, Bege!
Dialogue: 0,0:19:36.56,0:19:38.95,Main,,0,0,0,,Bege'nin peşinden gidiyoruz Bavarois!
Dialogue: 0,0:19:38.95,0:19:39.86,Main,,0,0,0,,Ne?
Dialogue: 0,0:19:39.86,0:19:44.99,Main,,0,0,0,,Baksana! Adım gibi eminim ki\NMama'yı öldürmeyi planlıyorlar!
Dialogue: 0,0:19:44.99,0:19:47.95,Main,,0,0,0,,Pudding'i çoktan öldürmüş de olabilirler.
Dialogue: 0,0:19:47.95,0:19:51.75,Main,,0,0,0,,İyi de Peros abi,\NHasır Şapkalar'ın gemisine n'olacak?
Dialogue: 0,0:19:52.01,0:19:55.90,Main,,0,0,0,,Her hâlükârda Kakao Adası'nda\Ndenizi boylayacaklar! Ayrıca...
Dialogue: 0,0:19:57.21,0:20:01.34,Main,,0,0,0,,Şu an Hasır Şapka'nın gemisinin\Npeşinde kim var sanıyorsun?
Dialogue: 0,0:20:02.63,0:20:03.30,Main,,0,0,0,,Sahi!
Dialogue: 0,0:20:03.30,0:20:05.17,Main,,0,0,0,,Cevap ver!
Dialogue: 0,0:20:05.91,0:20:09.91,Main,,0,0,0,,Hasır Şapka'nın gemisinin\Nensesinde misin Smoothie?
Dialogue: 0,0:20:10.14,0:20:16.40,Captions,,0,0,275,,{\fad(500,0)}Charlotte Smoothie - Charlotte Ailesi'nin 14. Kızı\N(Üç Şekerleme Generali'nden Biri)
Dialogue: 0,0:20:11.59,0:20:14.00,Main,,0,0,1,,Evet, enselerindeyim abi.
Dialogue: 0,0:20:16.40,0:20:20.46,Main,,0,0,0,,Hasır Şapka'nın gemisinin\Npeşinden ayrılmayın siz!
Dialogue: 0,0:20:23.15,0:20:26.37,Main,,0,0,0,,Bavarois'la birlikte Bege ve Mama'nın\Npeşine düşüyoruz!
Dialogue: 0,0:20:29.18,0:20:34.67,Main,,0,0,0,,Canlarının her bir damlasını sıkıp çıkar!
Dialogue: 0,0:20:34.67,0:20:39.92,Main,,0,0,0,,İşkenceler edip korkunun\Ndipsiz çukuruna sok onları!
Dialogue: 0,0:20:39.92,0:20:41.58,Main,,0,0,0,,Anlaşıldı.
Dialogue: 0,0:20:42.80,0:20:46.14,Main,,0,0,0,,Daha işin başından bu vazifeyi\Nbana vermeliydi zaten.
Dialogue: 0,0:20:46.99,0:20:50.18,Main,,0,0,0,,Peros abi kendini kaybediyor.
Dialogue: 0,0:20:54.48,0:20:56.98,Main,,0,0,0,,Kakao adasında kalıp...{\an8}
Dialogue: 0,0:20:53.14,0:20:59.40,Captions,,0,0,240,,{\fad(500,0)}Charlotte Citron - Charlotte Ailesi'nin 15. Kızı
Dialogue: 0,0:20:56.98,0:20:59.40,Main,,0,0,0,,{\an8}...çikolatamızı yerken çayımızdan\Nbirer yudum almak daha dertsiz olurdu.
Dialogue: 0,0:21:00.38,0:21:03.80,Main,,0,0,0,,Amma sabırsızlar ya. Beyinsiz erkekler.
Dialogue: 0,0:21:04.24,0:21:09.75,Captions,,0,0,240,,{\fad(500,0)}Charlotte Cinnamon - Charlotte Ailesi'nin 16. Kızı
Dialogue: 0,0:21:12.66,0:21:14.21,Main,,0,0,0,,Öyle deme yine de.
Dialogue: 0,0:21:20.39,0:21:23.18,Main,,0,0,0,,Millet, savaşmaya hazırlanın!
Dialogue: 0,0:21:23.18,0:21:28.04,Main,,0,0,0,,Kakao Adası'na varmalarına fırsat\Nvermeden gemilerini batıracağız!
Dialogue: 0,0:21:28.04,0:21:29.90,Main,,0,0,0,,Tamamdır!
Dialogue: 0,0:21:36.69,0:21:39.69,Main,,0,0,0,,Luffy'yle bir araya geleceğimiz\Nyerden haberleri mi varmış?
Dialogue: 0,0:21:40.64,0:21:45.00,Main,,0,0,0,,Evet, pusuya yatmış\Nfilolarca çevrilmiştir muhtemelen.
Dialogue: 0,0:21:45.00,0:21:46.81,Main,,0,0,0,,Olamaz.
Dialogue: 0,0:21:46.81,0:21:51.65,Main,,0,0,0,,Huylarının aksine bizi hafife almıyorlar.
Dialogue: 0,0:21:51.65,0:21:56.70,Main,,0,0,0,,Kakao Adası bu bölgedeki son\Nve de en çetin yüzleşmemiz olacak!
Dialogue: 0,0:21:56.70,0:22:00.47,Main,,0,0,0,,N'olursa olsun Luffy'yi kurtarıp\Nburadan çıkacağız!
Dialogue: 0,0:22:00.47,0:22:05.79,Main,,0,0,0,,Lakin filolarıyla kafa kafaya girersek\Nyenilgimiz kaçınılmaz.
Dialogue: 0,0:22:17.04,0:22:19.38,Main,,0,0,0,,Şu yaptığına bir bak!
Dialogue: 0,0:22:38.57,0:22:41.22,Main,,0,0,0,,Ayağın kayar ha!
Dialogue: 0,0:22:48.85,0:22:51.23,Main,,0,0,0,,Hasır Şapka!
Dialogue: 0,0:22:54.18,0:22:56.21,Thoughts,,0,0,0,,{\i1}Planım tıkırında gidiyor!
Dialogue: 0,0:23:10.79,0:23:14.92,Thoughts,,0,0,0,,Abiciğim!
Dialogue: 0,0:23:23.84,0:23:26.25,Thoughts,,0,0,0,,Aslında o savaşta ben de...
Dialogue: 0,0:23:26.25,0:23:28.70,Thoughts,,0,0,0,,Haberim yoktu Flampe!
Dialogue: 0,0:23:28.70,0:23:31.14,Thoughts,,0,0,0,,Ne kadar da düşünceli, güzel bir kızsın!
Dialogue: 0,0:23:34.43,0:23:37.75,Thoughts,,0,0,0,,En sevilen kız kardeşime de bu yakışırdı.
Dialogue: 0,0:23:39.92,0:23:43.82,Thoughts,,0,0,0,,{\i1}Alkışlanası bir kişiliğim ya!\NTatlılıktan öleceğim!
Dialogue: 0,0:23:51.35,0:23:53.51,Main,,0,0,0,,Bir anlık dikkatsizliğin...
Dialogue: 0,0:23:55.68,0:23:57.93,Main,,0,0,0,,...savaşın neticesini belirledi!
Dialogue: 0,0:24:06.18,0:24:08.16,Main,,0,0,0,,Nasıl olur da tedbiri elden bırakırsın?
Dialogue: 0,0:24:28.03,0:24:29.35,Main,,0,0,0,,{\fad(150,150)}Mochi Ginchaku!
Dialogue: 0,0:24:28.03,0:24:29.35,Attack,,0,0,0,,{\fad(150,150)}Vızıldayan Mochi Torbası
Dialogue: 0,0:24:38.15,0:24:40.36,Thoughts,,0,0,0,,{\i1}Neyin var Hasır Şapka?
Dialogue: 0,0:25:06.24,0:25:09.25,Main,,0,0,0,,Tam da seni takdir etmeye\Nbaşlamıştım ki...
Dialogue: 0,0:25:12.84,0:25:15.27,Main,,0,0,0,,...beni hayal kırıklığına uğrattın!
Dialogue: 0,0:25:41.82,0:25:43.69,Main,,0,0,0,,Gördüm gibi!
Dialogue: 0,0:25:44.90,0:25:46.19,Main,,0,0,0,,Hayal mi kurdum acaba?
Dialogue: 0,0:25:48.07,0:25:49.97,Main,,0,0,0,,Hayal kurman iyidir.
Dialogue: 0,0:25:50.78,0:25:55.00,Main,,0,0,0,,Hayal kurmanın bir ötesinde\NGözlem Hakisi yatar!
Dialogue: 0,0:26:01.03,0:26:05.01,Main,,0,0,0,,İçgüdüsel olarak sezebilmen lazım!
Dialogue: 0,0:26:05.01,0:26:06.73,Flashbacks,,0,0,0,,{\i1}İçgüdüsel mi?{\i0}
Dialogue: 0,0:26:15.92,0:26:17.62,Thoughts,,0,0,0,,Yine kalkıyor!
Dialogue: 0,0:26:17.62,0:26:19.54,Thoughts,,0,0,0,,Ayaklarının titremesine bakın ya!
Dialogue: 0,0:26:20.29,0:26:22.59,Thoughts,,0,0,0,,{\i1}Tamamdır! Bir atış daha!
Dialogue: 0,0:26:25.09,0:26:31.26,Thoughts,,0,0,0,,{\i1}Bu sefer ise deminkinden 10 kat\Ndaha güçlü bir uyuşturucu iğne vereceğim!
Dialogue: 0,0:26:34.34,0:26:37.28,Thoughts,,0,0,0,,{\i1}Pes etmek nedir bilmez şebekcik.
Dialogue: 0,0:26:37.28,0:26:39.50,Thoughts,,0,0,0,,{\i1}Geber git artık!
Dialogue: 0,0:26:46.07,0:26:47.09,Thoughts,,0,0,0,,{\fad(150,150)}Shibirebari!
Dialogue: 0,0:26:46.07,0:26:47.09,Attack,,0,0,0,,{\fad(150,150)}Uyuşturucu İğne
Dialogue: 0,0:27:02.35,0:27:06.30,Thoughts,,0,0,0,,{\i1}Ne? \NSes çıkarmayan iğnemi savuşturdu mu?
Dialogue: 0,0:27:12.17,0:27:14.18,Thoughts,,0,0,0,,{\i1}Ama devriliverdi!
Dialogue: 0,0:27:51.09,0:27:53.92,Main,,0,0,0,,Flampe-{\i1}sama{\i0}! Bizi duyacaklar!
Dialogue: 0,0:27:53.92,0:27:57.93,Main,,0,0,0,,İ- İyi de şu maymunun\Nayakta duruş şekli...
Dialogue: 0,0:27:57.93,0:28:01.10,Main,,0,0,0,,...yeni doğmuş bir ceylan\Nyavrusunu andırıyor!
Dialogue: 0,0:28:01.10,0:28:02.53,Main,,0,0,0,,Tir tir titriyorlar!
Dialogue: 0,0:28:04.43,0:28:07.26,Main,,0,0,0,,Durun ya, güldürmesenize!
Dialogue: 0,0:28:07.26,0:28:08.73,Main,,0,0,0,,Baksanıza ama ya!
Dialogue: 0,0:28:08.73,0:28:12.95,Main,,0,0,0,,Rezil herif yara bere içinde kalmış,\Naciz duruma düşmüşken...
Dialogue: 0,0:28:12.95,0:28:15.55,Main,,0,0,0,,...yine de defaatle doğruluyor!
Dialogue: 0,0:28:18.86,0:28:21.89,Main,,0,0,0,,Deli gibi titreyen bacaklarıyla\Ndoğrulmuşken yeri öpüveriyor.
Dialogue: 0,0:28:21.89,0:28:24.02,Main,,0,0,0,,Sonra yine başa sarıyor!
Dialogue: 0,0:28:26.88,0:28:28.65,Thoughts,,0,0,0,,{\i1}Flampe?{\i0}
Dialogue: 0,0:28:40.59,0:28:41.74,Thoughts,,0,0,0,,{\i1}Yoksa...
Dialogue: 0,0:28:55.23,0:28:57.47,Main,,0,0,0,,Abiciğim bu tarafa bakıyor ya!
Dialogue: 0,0:28:57.47,0:29:00.60,Main,,0,0,0,,Of ya, nasıl da kusursuz,\Nhavalı bir erkek!
Dialogue: 0,0:29:05.35,0:29:08.94,Main,,0,0,0,,Katakuri-{\i1}sama{\i0} yanımıza geliyor!
Dialogue: 0,0:29:08.94,0:29:10.88,Main,,0,0,0,,Ne?
Dialogue: 0,0:29:13.17,0:29:17.99,Thoughts,,0,0,0,,{\i1}İyi iş çıkardın!\NPek de akıllı bir kızsın Flampe.
Dialogue: 0,0:29:17.99,0:29:19.39,Thoughts,,0,0,0,,{\i1}Aferin sana.
Dialogue: 0,0:29:19.39,0:29:21.45,Main,,0,0,0,,Beni övecek ya!
Dialogue: 0,0:29:23.04,0:29:26.54,Main,,0,0,0,,Kalbim henüz bunu kaldıramaz ki!
Dialogue: 0,0:29:27.79,0:29:32.17,Thoughts,,0,0,0,,{\i1}Çaktım köfteyi.\NSenin parmağın vardı Flampe.
Dialogue: 0,0:29:35.77,0:29:40.51,Thoughts,,0,0,0,,{\i1}Ses çıkarmayan gözde hava tabancan ile\Nadamın hareketlerini kısıtladın.
Dialogue: 0,0:29:43.83,0:29:49.30,Thoughts,,0,0,0,,{\i1}Amansız bir savaşın ortasında\Ndikkati bir anlığına dağılıverdi.
Dialogue: 0,0:29:50.35,0:29:52.90,Thoughts,,0,0,0,,{\i1}Garip bulmuştum zaten.
Dialogue: 0,0:29:54.62,0:29:56.15,Flashbacks,,0,0,0,,{\fad(150.150)}Mochi...
Dialogue: 0,0:29:58.32,0:29:59.20,Flashbacks,,0,0,0,,{\fad(150,150)}Tsuki!
Dialogue: 0,0:29:58.32,0:29:59.20,Attack,,0,0,0,,{\fad(150,150)}Saplayışı
Dialogue: 0,0:30:01.91,0:30:07.50,Thoughts,,0,0,0,,{\i1}Yine de adama saldırıp midesinde\Ndelik açarak ölümcül bir yara verdim!
Dialogue: 0,0:30:11.05,0:30:15.88,Thoughts,,0,0,0,,{\i1}Böyle onursuz bir zaferi\Nisteyeceğimi mi zannediyorsun?
Dialogue: 0,0:30:15.88,0:30:20.59,Main,,0,0,0,,Baksanıza Flampe-{\i1}sama{\i0}!\NCeylan yavrusu yine ayağa kalkıyor!
Dialogue: 0,0:30:21.47,0:30:23.55,Main,,0,0,0,,Dur be, güldürmesene!
Dialogue: 0,0:30:23.55,0:30:25.00,Main,,0,0,0,,Ayaklarına bakın ya!
Dialogue: 0,0:30:25.00,0:30:26.82,Main,,0,0,0,,Bildiğin ceylan yavrusu!
Dialogue: 0,0:30:29.80,0:30:33.40,Main,,0,0,0,,Böylelikle Katakuri-{\i1}sama{\i0}'nın zaferi\Nkesinleşmiştir!
Dialogue: 0,0:30:34.73,0:30:36.37,Main,,0,0,0,,E herhâlde!
Dialogue: 0,0:30:36.37,0:30:38.40,Main,,0,0,0,,Kusursuz abiciğim için...
Dialogue: 0,0:30:38.40,0:30:40.78,Main,,0,0,0,,...kusursuz bir zafer!
Dialogue: 0,0:30:41.45,0:30:42.62,Main,,0,0,0,,Flampe.
Dialogue: 0,0:30:45.02,0:30:46.66,Main,,0,0,0,,Senin işin miydi?
Dialogue: 0,0:30:46.66,0:30:48.95,Thoughts,,0,0,0,,{\i1}Kesinlikle abiciğim!
Dialogue: 0,0:30:49.49,0:30:52.47,Thoughts,,0,0,0,,{\i1}Ben yaptım!
Dialogue: 0,0:30:52.47,0:30:57.63,Thoughts,,0,0,0,,{\i1}En düşünceli ve tatlış\Nkız kardeşinim, değil mi ama?
Dialogue: 0,0:30:57.63,0:31:01.76,Thoughts,,0,0,0,,{\i1}Kusursuz imajıyla dünyanın\Nen güçlü abiciğinin gözdesi...
Dialogue: 0,0:31:01.76,0:31:04.14,Thoughts,,0,0,0,,{\i1}...benden başkası değil!
Dialogue: 0,0:31:04.14,0:31:07.64,Thoughts,,0,0,0,,{\i1}Başımı okşayıp\Nakıllı bi' kız olduğumu söyle!
Dialogue: 0,0:31:07.64,0:31:10.73,Main,,0,0,0,,Abiciğim!
Dialogue: 0,0:31:11.98,0:31:15.40,Main,,0,0,0,,Siz neye gülüyorsunuz lan dangalaklar!
Dialogue: 0,0:31:37.47,0:31:38.68,Main,,0,0,0,,O...!
Dialogue: 0,0:31:44.56,0:31:46.85,Main,,0,0,0,,Katakuri-{\i1}sama{\i1}!{\i0}
Dialogue: 0,0:31:47.45,0:31:49.58,Main,,0,0,0,,N- Neden ama?
Dialogue: 0,0:31:57.47,0:31:59.75,Main,,0,0,0,,İki erkeğin kavgasında...
Dialogue: 0,0:32:03.14,0:32:06.79,Main,,0,0,0,,...senin kıytırık yardımının yeri yoktur!
Dialogue: 0,0:32:09.96,0:32:11.46,Main,,0,0,0,,Yaklaşma! Dokunma bana!
Dialogue: 0,0:32:12.67,0:32:13.84,Main,,0,0,0,,Başım!
Dialogue: 0,0:32:14.60,0:32:16.22,Main,,0,0,0,,Katakuri-{\i1}sama{\i1}!{\i0}
Dialogue: 0,0:32:22.85,0:32:25.59,Main,,0,0,0,,O beyinsize gülecekseniz...
Dialogue: 0,0:32:25.59,0:32:28.31,Main,,0,0,0,,...bana da gülün haydi!
Dialogue: 0,0:32:46.38,0:32:48.79,Main,,0,0,0,,Rezillik ya!
Dialogue: 0,0:32:52.66,0:32:55.25,Main,,0,0,0,,Aynen ha! Tam bir hüsran!
Dialogue: 0,0:32:55.25,0:32:59.00,Main,,0,0,0,,Of be, kusacağım! Kanın yüzüme sıçradı!
Dialogue: 0,0:32:59.00,0:33:00.38,Main,,0,0,0,,N'apıyorsun sen?
Dialogue: 0,0:33:00.38,0:33:05.18,Main,,0,0,0,,Asillikten geçilmeyen, her daim soğukkanlı,\Nkudretli ve her açıdan kusursuz...
Dialogue: 0,0:33:05.18,0:33:08.37,Main,,0,0,0,,...yönüne hayran olduğumuz abimdin!
Dialogue: 0,0:33:08.40,0:33:10.97,Main,,0,0,0,,Sen ise gittin kendini yaraladın!
Dialogue: 0,0:33:10.97,0:33:15.81,Main,,0,0,0,,Rezilsin!\NKatakuri abiciğim değilsin sen!
Dialogue: 0,0:33:15.81,0:33:17.51,Main,,0,0,0,,Zavallısın!
Dialogue: 0,0:33:18.98,0:33:21.19,Main,,0,0,0,,Bir Pelikan balığını andırıyorsun!
Dialogue: 0,0:33:22.92,0:33:24.99,Main,,0,0,0,,Pelikan balığı dedi!
Dialogue: 0,0:33:24.99,0:33:29.11,Main,,0,0,0,,Durun ya Flampe-{\i1}sama{\i0}!\NGüldüğüm belli olacak!
Dialogue: 0,0:33:29.11,0:33:32.53,Main,,0,0,0,,Aman be...\NHayal kırıklığına uğradım!
Dialogue: 0,0:33:34.90,0:33:37.20,Flashbacks,,0,0,0,,{\i1}Olamaz, Pelikan balığı döndü!
Dialogue: 0,0:33:37.20,0:33:38.57,Flashbacks,,0,0,0,,Yaklaşma bize!
Dialogue: 0,0:33:38.57,0:33:41.94,Flashbacks,,0,0,0,,Hayvan gibi de güçlü ha!
Dialogue: 0,0:33:41.94,0:33:43.39,Flashbacks,,0,0,0,,Kaçın!
Dialogue: 0,0:33:49.80,0:33:52.72,Main,,0,0,0,,Dur! Konuşsana!
Dialogue: 0,0:34:12.58,0:34:15.95,Main,,0,0,0,,Fotoğraf çekin! Herkese gösterin!
Dialogue: 0,0:34:15.95,0:34:18.38,Main,,0,0,0,,Şu ezik herifin suratını!
Dialogue: 0,0:34:26.36,0:34:30.01,Main,,0,0,0,,M- Müsaadenizle!\NAf buyurun Katakuri-sama.
Dialogue: 0,0:34:32.89,0:34:35.85,Main,,0,0,0,,Katakuri-{\i1}sama{\i0}, buraya bi' baksanız!
Dialogue: 0,0:34:35.85,0:34:38.82,Main,,0,0,0,,Harbiden Pelikan balığına benziyor lan!
Dialogue: 0,0:34:39.85,0:34:45.27,Main,,0,0,0,,Herkesin hayranlık duyduğu\Nkusursuz abim, Charlotte Katakuri...
Dialogue: 0,0:34:45.27,0:34:46.53,Main,,0,0,0,,...artık ölmüştür!
Dialogue: 0,0:34:46.53,0:34:51.12,Main,,0,0,0,,Hayran kulübündekilerden Totto Land'ın\Nher bir adasına kadar...
Dialogue: 0,0:34:51.12,0:34:53.48,Main,,0,0,0,,...tüm ulusa yayacağım!
Dialogue: 0,0:34:53.48,0:34:55.83,Main,,0,0,0,,Suratımı pis kanınla kirletip...
Dialogue: 0,0:34:55.83,0:34:59.37,Main,,0,0,0,,...herkesin sevdiceği olan beni\Ntehdit etmeye kalkarsın ha!
Dialogue: 0,0:34:59.37,0:35:03.22,Main,,0,0,0,,Kusursuz bir abilik neyin varmış ki?\NHiç de havalı değilsin!
Dialogue: 0,0:35:03.22,0:35:06.35,Main,,0,0,0,,Öz kardeşin olduğumu\Ndillendirmekten bile utanıyorum!
Dialogue: 0,0:35:08.11,0:35:12.41,Main,,0,0,0,,Çay Partisi'ni mahveden seni de\Nunutmuş değilim Hasır Şapka!
Dialogue: 0,0:35:14.06,0:35:17.08,Main,,0,0,0,,Size bakmak bile\Ninsanın sinirlerini bozuyor!
Dialogue: 0,0:35:17.08,0:35:21.63,Main,,0,0,0,,Bu sefer kalbinizi delip geçecek olan\Nson derece zehirli iğneler ateşleyeceğim!
Dialogue: 0,0:35:21.63,0:35:23.52,Main,,0,0,0,,Aynen! Yapın gitsin!
Dialogue: 0,0:35:23.52,0:35:27.01,Main,,0,0,0,,Yediğiniz haltın telafisi yok!\NEcelinizle buluşmaya hazır olun!
Dialogue: 0,0:35:32.57,0:35:35.10,Main,,0,0,0,,İzleyiciler de amma kafa ütülüyorlar!
Dialogue: 0,0:35:37.05,0:35:39.52,Main,,0,0,0,,Nasılsa ayakta kalamayacaklar!
Dialogue: 0,0:36:01.72,0:36:02.79,Thoughts,,0,0,0,,{\i1}Kralların Hakisi mi?
Dialogue: 0,0:36:03.49,0:36:05.80,Thoughts,,0,0,0,,{\i1}O maymun da mı kullanıyor?
Dialogue: 0,0:36:05.80,0:36:08.09,Thoughts,,0,0,0,,{\i1}Onun kadar ezik biri...
