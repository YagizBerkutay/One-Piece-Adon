00000000,0,0,0,0,95,100,1,0,1,2.2,0,7,10,10,10,1Style: Author,Impress BT,20.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.7,0.7,9,10,10,10,1Style: Attack,Duality,30.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.0,1.0,7,12,12,12,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:01:42.68,0:01:47.85,Narrator,,0,0,0,,Rehberleri Pekoms'un kayboluşunun ardından Luffyler Cacao Adası'ndan ayrılıp...Dialogue: 0,0:01:47.85,0:01:51.08,Narrator,,0,0,0,,...Pudding'in çizdiği rotada Yonkou Big Mom'ın bulunduğu...Dialogue: 0,0:01:49.42,0:01:54.34,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:16:07.00,0:16:17.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:31:13.20,0:31:17.20,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:01:49.42,0:01:54.34,Title,,0,0,170,,Yonko, Charlotte LinlinDialogue: 0,0:01:51.08,0:01:53.74,Narrator,,0,0,0,,...Whole Cake Adası'na doğru yola koyuldular.Dialogue: 0,0:01:57.13,0:02:00.66,Main,,0,0,0,,Pekoms için endişeleniyorum. Arayalım bence!Dialogue: 0,0:02:00.66,0:02:05.68,Main,,0,0,0,,Böyle düşünmene sevindim ama bu dediğin kolay olmayacak. Şimdilik bu konuda endişelenmemek daha iyi.Dialogue: 0,0:02:06.14,0:02:07.48,Main,,0,0,0,,Haklısın ama...Dialogue: 0,0:02:07.48,0:02:11.19,Main,,0,0,0,,Her halükârda düşmana yakalanmadan...Dialogue: 0,0:02:11.19,0:02:13.07,Main,,0,0,0,,...Whole Cake Adası'na varmamız lazım.Dialogue: 0,0:02:13.07,0:02:15.48,Main,,0,0,0,,Şu an neredeyiz?Dialogue: 0,0:02:18.82,0:02:22.78,Main,,0,0,0,,Kakao Adası'ndan henüz çok uzaklaşmadık.Dialogue: 0,0:02:26.50,0:02:28.62,Main,,0,0,0,,Hey, ada göründü!Dialogue: 0,0:02:29.63,0:02:32.84,Main,,0,0,0,,Yaşasın! Nasıl şekerler bekliyor acaba bizi!Dialogue: 0,0:02:32.84,0:02:36.05,Main,,0,0,0,,Kokuya bakılırsa acayip tatlı bir şeyler olduğu kesin!Dialogue: 0,0:02:36.05,0:02:39.38,Main,,0,0,0,,Sırada muhtemelen reçelden yapılma şehir var.Dialogue: 0,0:02:39.38,0:02:41.08,Main,,0,0,0,,Reçel mi?!Dialogue: 0,0:02:41.08,0:02:42.69,Main,,0,0,0,,Karaya çıkmayacağız.Dialogue: 0,0:02:42.69,0:02:44.02,Main,,0,0,0,,Niye?!Dialogue: 0,0:02:44.02,0:02:46.10,Main,,0,0,0,,Hele, şuna bakın..Dialogue: 0,0:02:46.10,0:02:47.82,Main,,0,0,0,,Reçel Adası'nı görür görmez...Dialogue: 0,0:02:47.82,0:02:51.35,Main,,0,0,0,,...karaya yanaşmak yerine Seyir Pusulası 2'nin gösterdiği yöne dönüyoruz.Dialogue: 0,0:02:51.35,0:02:54.72,Main,,0,0,0,,Bu kadar tatlı olmasına rağmen mi Nami?!Dialogue: 0,0:02:54.72,0:02:58.19,Main,,0,0,0,,Bu kadar tatlı olmasına rağmen yanına yaklaşmayacak mıyız?!Dialogue: 0,0:02:58.49,0:02:59.70,Main,,0,0,0,,Bakalım...Dialogue: 0,0:03:00.40,0:03:01.96,Main,,0,0,0,,Şu tarafa.Dialogue: 0,0:03:01.96,0:03:03.37,Main,,0,0,0,,Pekâlâ!Dialogue: 0,0:03:04.87,0:03:08.26,Main,,0,0,0,,Luffy, saat üç yönünde sancak tarafına, Sanji'ye doğru!Dialogue: 0,0:03:08.26,0:03:12.43,Note,,0,0,0,,"Sanji" saat üç anlamına gelir.Dialogue: 0,0:03:08.26,0:03:12.43,Main,,0,0,0,,Aynen öyle Chopper, Carrot! Sanji'ye doğru gidiyoruz!Dialogue: 0,0:03:12.43,0:03:14.05,Main,,0,0,0,,Ama çok tatlı!Dialogue: 0,0:03:14.45,0:03:18.27,Main,,0,0,0,,Sanji'yi almaya gidiyoruz! Sancak alabanda!Dialogue: 0,0:03:18.27,0:03:19.55,Main,,0,0,0,,Çok döndün!Dialogue: 0,0:03:19.55,0:03:21.89,Main,,0,0,0,,Bu işte berbatsın Luffy-san!Dialogue: 0,0:03:21.89,0:03:23.77,Main,,0,0,0,,Sen sanki çok iyisin Brook!Dialogue: 0,0:03:23.77,0:03:26.57,Main,,0,0,0,,Ama çok tatlı...Dialogue: 0,0:03:26.57,0:03:30.94,Main,,0,0,0,,Adaya yaklaşmadan rotamızı bir sonraki adaya çevirerek...Dialogue: 0,0:03:30.94,0:03:34.48,Main,,0,0,0,,...düşmanın gözetleme sistemini atlatabilirmişiz.Dialogue: 0,0:03:34.48,0:03:38.41,Main,,0,0,0,,Vay be, epey yardımcı bir haritaymış.Dialogue: 0,0:03:38.41,0:03:39.70,Main,,0,0,0,,Üstesinden gelebilir misin?Dialogue: 0,0:03:39.70,0:03:40.87,Main,,0,0,0,,Sorman hata.Dialogue: 0,0:03:40.87,0:03:44.13,Main,,0,0,0,,Luffy-san, izninle ben devralayım.Dialogue: 0,0:03:44.13,0:03:45.16,Main,,0,0,0,,Peki.Dialogue: 0,0:03:45.16,0:03:48.12,Main,,0,0,0,,Pekâlâ millet, ben de size bir şeyler pişireyim!Dialogue: 0,0:03:48.12,0:03:48.81,Main,,0,0,0,,Ne dedin?!Dialogue: 0,0:03:49.34,0:03:51.21,Main,,0,0,0,,Ben yemek yapmaya gidiyorum!Dialogue: 0,0:03:51.21,0:03:52.17,Main,,0,0,0,,Lütfen!Dialogue: 0,0:03:52.17,0:03:54.50,Main,,0,0,0,,Luffy, bekle biraz!Dialogue: 0,0:03:54.50,0:03:56.54,Main,,0,0,0,,Ne istiyorsun Nami? Yemek olayını ben halledeceğim dedim.Dialogue: 0,0:03:56.54,0:03:57.34,Main,,0,0,0,,Olmaz!Dialogue: 0,0:03:57.78,0:03:59.92,Main,,0,0,0,,Bu sefer batırmayacağım!Dialogue: 0,0:03:59.92,0:04:04.39,Main,,0,0,0,,Ben pişiririm. Sen bir daha mutfağa adımını bile atma!Dialogue: 0,0:04:04.39,0:04:06.31,Main,,0,0,0,,Bir damla para vermem!Dialogue: 0,0:04:06.31,0:04:07.48,Main,,0,0,0,,İstemiyorum zaten!Dialogue: 0,0:04:07.48,0:04:09.02,Main,,0,0,0,,Oha!Dialogue: 0,0:04:11.86,0:04:15.82,Main,,0,0,0,,Değişelim Pedro! Ben de yardımcı olmak istiyorum!Dialogue: 0,0:04:15.82,0:04:16.86,Main,,0,0,0,,Peki madem.Dialogue: 0,0:04:20.35,0:04:21.65,Main,,0,0,0,,Bakalım bakalım...Dialogue: 0,0:04:23.36,0:04:26.25,Main,,0,0,0,,Baksanıza, deniz üzüm renginde!Dialogue: 0,0:04:27.50,0:04:29.33,Main,,0,0,0,,Üzüm renginde mi?Dialogue: 0,0:04:29.33,0:04:32.12,Main,,0,0,0,,Bu civarlarda denize meyve suyu akıtan bir ada mevcut.Dialogue: 0,0:04:32.12,0:04:33.30,Main,,0,0,0,,Bize bir zararı yok.Dialogue: 0,0:04:33.30,0:04:36.23,Main,,0,0,0,,Ne?! Meyve suyu mu bu?Dialogue: 0,0:04:36.23,0:04:38.17,Main,,0,0,0,,Sonsuz cennet gibi yer!Dialogue: 0,0:04:38.86,0:04:41.92,Main,,0,0,0,,Pedro, bu bölge hakkında nasıl bu kadar çok şey biliyorsun?Dialogue: 0,0:04:45.18,0:04:47.14,Main,,0,0,0,,Buraya daha önce de bir kez gelmiştim.Dialogue: 0,0:04:47.14,0:04:48.18,Main,,0,0,0,,Ne?Dialogue: 0,0:04:54.49,0:04:56.38,Main,,0,0,0,,Devasaymış!Dialogue: 0,0:04:57.65,0:05:00.80,Main,,0,0,0,,Vay canına, ne büyük!Dialogue: 0,0:05:01.33,0:05:05.28,Main,,0,0,0,,Devasa deniz kırkayağı! Bu civarda yaşarlar.Dialogue: 0,0:05:06.57,0:05:09.81,Main,,0,0,0,,Hayır! Devasa deniz kırkayaklarına hayır!Dialogue: 0,0:05:09.81,0:05:11.29,Main,,0,0,0,,Yenileceğiz!Dialogue: 0,0:05:11.29,0:05:13.20,Main,,0,0,0,,Luffy, işini yap!Dialogue: 0,0:05:13.63,0:05:14.83,Main,,0,0,0,,Anlaşıldı!Dialogue: 0,0:05:17.84,0:05:20.63,Main,,0,0,0,,Ben de elimden geleni yapacağım!Dialogue: 0,0:05:26.93,0:05:28.79,Main,,0,0,0,,Geliyor!Dialogue: 0,0:05:28.79,0:05:31.72,Main,,0,0,0,,Gomu Gomu no...Dialogue: 0,0:05:31.72,0:05:34.03,Main,,0,0,0,,...Gatling!Dialogue: 0,0:05:31.72,0:05:34.03,Attack,,0,0,0,,MitralyözDialogue: 0,0:05:48.81,0:05:51.70,Narrator,,0,0,0,,Bu sırada Whole Cake Adası'nda...Dialogue: 0,0:05:50.12,0:05:54.62,Captions,,0,0,0,,Whole Cake AdasıDialogue: 0,0:05:51.70,0:05:54.62,Main,,0,0,0,,Croquembouche!Dialogue: 0,0:05:57.82,0:06:01.10,Main,,0,0,0,,Mama! Dur lütfen! Mama!Dialogue: 0,0:06:06.80,0:06:09.28,Main,,0,0,0,,Mama... Mama yapma lütfen!Dialogue: 0,0:06:09.28,0:06:10.48,Main,,0,0,0,,Çekilin!Dialogue: 0,0:06:11.05,0:06:13.72,Main,,0,0,0,,Croquembouche!Dialogue: 0,0:06:14.56,0:06:18.04,Main,,0,0,0,,Eyvah! Mama'nın hastalığı nüksetti!Dialogue: 0,0:06:18.04,0:06:22.72,Main,,0,0,0,,Acele edin-bon! Bu sefer ne istiyor-soir?!Dialogue: 0,0:06:22.72,0:06:23.57,Main,,0,0,0,,Bu sefer...Dialogue: 0,0:06:24.75,0:06:26.82,Main,,0,0,0,,...croquembouche istiyor!Dialogue: 0,0:06:26.82,0:06:28.84,Main,,0,0,0,,Croquembouche mı?!Dialogue: 0,0:06:28.84,0:06:32.54,Main,,0,0,0,,İçi kremayla doldurulmuş pataşuların koni şeklinde süslendiği o tatlı mı?Dialogue: 0,0:06:32.54,0:06:35.09,Main,,0,0,0,,Pek kolay olmayacak.Dialogue: 0,0:06:35.09,0:06:37.33,Main,,0,0,0,,Dur biraz!Dialogue: 0,0:06:37.33,0:06:39.84,Main,,0,0,0,,Şehirdeki otelde yanılmıyorsam...Dialogue: 0,0:06:39.84,0:06:44.00,Main,,0,0,0,,..."kremalı pastadan" bir turist grubu kalıyordu-je-t'aime!Dialogue: 0,0:06:44.00,0:06:46.01,Main,,0,0,0,,Bu sabah ayrıldılar.Dialogue: 0,0:06:46.01,0:06:49.30,Main,,0,0,0,,Kendimiz yapacağız o zaman! Şef ne diyor?Dialogue: 0,0:06:49.30,0:06:53.45,Main,,0,0,0,,Hamuru özel yapmak istiyorum. Badem getirebilir misiniz?Dialogue: 0,0:06:54.74,0:06:56.60,Main,,0,0,0,,Kabuklu Yemiş Bakanı'na hemen haber veririm!Dialogue: 0,0:06:56.60,0:06:59.60,Main,,0,0,0,,Mama şu anda Tatlı Şehir'e doğru ilerliyor!Dialogue: 0,0:06:59.60,0:07:04.10,Main,,0,0,0,,Buraya mı geliyor?! Başkent burası! Mama'nın kalesi de burada!Dialogue: 0,0:07:04.10,0:07:08.64,Main,,0,0,0,,Söz dinleyecek hali yok! Krizi yüzünden her şeyi unutmuş durumda!Dialogue: 0,0:07:12.02,0:07:14.11,Main,,0,0,0,,Ölü sayısı giderek artmakta!Dialogue: 0,0:07:14.11,0:07:17.44,Main,,0,0,0,,Tatlı Şehir'e tahliye emri verin!Dialogue: 0,0:07:17.44,0:07:21.46,Main,,0,0,0,,Mama'yı şu an durdurabilecek tek şey croquembouche!Dialogue: 0,0:07:21.46,0:07:24.62,Main,,0,0,0,,Bu taraftan! Acele edin! Acele!Dialogue: 0,0:07:26.17,0:07:28.38,Main,,0,0,0,,Mama, dur lütfen!Dialogue: 0,0:07:28.38,0:07:31.13,Main,,0,0,0,,Mama, yapmayalım hadi!Dialogue: 0,0:07:32.59,0:07:36.26,Main,,0,0,0,,Croquembouche getirin bana!Dialogue: 0,0:07:39.06,0:07:42.85,Main,,0,0,0,,Mama Tatlı Şehir'e giriş yaptı! Tatlı Şehir'e giriş yaptı!Dialogue: 0,0:07:42.85,0:07:45.19,Main,,0,0,0,,Sonunda geldi...Dialogue: 0,0:07:45.19,0:07:49.47,Main,,0,0,0,,Mama'nın açlık sancıları bizim için büyük sıkıntı-bon!Dialogue: 0,0:07:49.47,0:07:52.24,Main,,0,0,0,,Bir sonraki krizin ne zaman nüksedeceği de meçhul.Dialogue: 0,0:07:52.24,0:07:58.87,Main,,0,0,0,,Canının istediği şeyden bir lokma yiyene kadar yıkım devam edecek.Dialogue: 0,0:07:58.87,0:08:02.04,Main,,0,0,0,,Siz herkesi tahliye etmeye odaklanın!Dialogue: 0,0:08:02.04,0:08:03.93,Main,,0,0,0,,Kaçın! Acele edin!Dialogue: 0,0:08:03.93,0:08:05.88,Main,,0,0,0,,Big Mom'ın sinir krizlerinden biri bu!Dialogue: 0,0:08:05.88,0:08:08.80,Main,,0,0,0,,- Olamaz! - Bu şehirde bile mi?!Dialogue: 0,0:08:14.64,0:08:18.47,Main,,0,0,0,,Mama! Mama! Bu şehir olmaz!Dialogue: 0,0:08:18.47,0:08:23.02,Main,,0,0,0,,- Kendi kalesini yok edecek! - Boşa uğraşıyorsun. Bizi duymaz.Dialogue: 0,0:08:33.15,0:08:37.63,Main,,0,0,0,,Croquembouche!Dialogue: 0,0:08:41.54,0:08:45.14,Main,,0,0,0,,Croquembouche!Dialogue: 0,0:08:51.96,0:08:54.22,Main,,0,0,0,,Bu değil!Dialogue: 0,0:08:55.76,0:08:57.76,Main,,0,0,0,,Geliyor!Dialogue: 0,0:09:12.90,0:09:15.72,Main,,0,0,0,,Aradığım tat bu değil!Dialogue: 0,0:09:15.72,0:09:18.54,Main,,0,0,0,,Siz de değilsiniz!Dialogue: 0,0:09:18.54,0:09:21.29,Main,,0,0,0,,Bunların hiçbiri değil!Dialogue: 0,0:09:25.33,0:09:27.88,Main,,0,0,0,,Croquembouche!Dialogue: 0,0:09:29.13,0:09:30.92,Main,,0,0,0,,Teşekkür ederim!Dialogue: 0,0:09:31.89,0:09:34.51,Main,,0,0,0,,Moscato-sama bu!Dialogue: 0,0:09:34.51,0:09:37.98,Main,,0,0,0,,Charlotte Ailesi'nin 16. oğlu ve Gelato Bakanı!Dialogue: 0,0:09:37.98,0:09:41.51,Main,,0,0,0,,Mama'nın ailesinden biri eminim onu bir şekilde durdurur!Dialogue: 0,0:09:41.51,0:09:46.02,Main,,0,0,0,,Moscato konuşuyor! Croquembouche ne durumda?!Dialogue: 0,0:09:41.50,0:09:46.02,Captions,,0,0,0,,Charlotte Moscato Charlotte Ailesinin 16. Oğlu Gelato BakanıDialogue: 0,0:09:46.02,0:09:50.58,Main,,0,0,0,,Yarım saat kadar sonra hazır olacakmış-bon!Dialogue: 0,0:09:50.58,0:09:55.36,Main,,0,0,0,,Bu çok geç! En azından kaleyi kurtarmamız lazım!Dialogue: 0,0:09:59.70,0:10:01.49,Main,,0,0,0,,Bu da değil!Dialogue: 0,0:10:02.33,0:10:05.41,Main,,0,0,0,,Mama! Dur lütfen!Dialogue: 0,0:10:06.44,0:10:07.79,Main,,0,0,0,,Sen de kimsin?!Dialogue: 0,0:10:11.29,0:10:14.51,Main,,0,0,0,,Mama! Benim! Moscato!Dialogue: 0,0:10:19.99,0:10:23.54,Main,,0,0,0,,Croquembouche'um nerede?Dialogue: 0,0:10:23.54,0:10:26.52,Main,,0,0,0,,Croquembouche...Dialogue: 0,0:10:26.52,0:10:28.98,Main,,0,0,0,,Croquembouche!Dialogue: 0,0:10:28.98,0:10:34.65,Main,,0,0,0,,30 dakika sık dişini! Şefler canla başla çalışıyor!Dialogue: 0,0:10:34.65,0:10:38.70,Main,,0,0,0,,Çekil oradan Mos Abi! Onu durdurmanın imkanı yok!Dialogue: 0,0:10:38.70,0:10:41.49,Main,,0,0,0,,Başkenti yok etmesine göz mü yumayım?!Dialogue: 0,0:10:42.55,0:10:45.49,Main,,0,0,0,,Çekil yolumdan!Dialogue: 0,0:10:48.71,0:10:52.63,Main,,0,0,0,,Beni bile ayırt edemiyor musun Mama?!Dialogue: 0,0:11:04.64,0:11:06.56,Main,,0,0,0,,Canın...Dialogue: 0,0:11:06.93,0:11:07.60,Main,,0,0,0,,...ya da...Dialogue: 0,0:11:08.61,0:11:11.35,Main,,0,0,0,,...şekerin*!Dialogue: 0,0:11:17.94,0:11:20.20,Main,,0,0,0,,Canın ya da şekerin...Dialogue: 0,0:11:20.20,0:11:22.36,Main,,0,0,0,,Ömrünü mü vereceksin yoksa şekerini mi?!Dialogue: 0,0:11:22.36,0:11:26.24,Main,,0,0,0,,Kulaklarım doğru mu duyuyor Mama?!  Öz oğlun o!Dialogue: 0,0:11:26.24,0:11:28.30,Main,,0,0,0,,Mama, yapma!Dialogue: 0,0:11:28.30,0:11:34.25,Main,,0,0,0,,Kre-Kremamız hazır-fa! Henüz hamuru hazır değil ama Mama, yapma!Dialogue: 0,0:11:34.94,0:11:37.55,Main,,0,0,0,,Şeker henüz burada değil!Dialogue: 0,0:11:37.55,0:11:40.13,Main,,0,0,0,,Şekerimi yiyeceğim...Dialogue: 0,0:11:41.62,0:11:43.68,Main,,0,0,0,,Yıkıl karşımdan!Dialogue: 0,0:11:58.65,0:12:00.19,Main,,0,0,0,,Mama!Dialogue: 0,0:12:00.19,0:12:02.32,Main,,0,0,0,,Moscato, kendine gel!Dialogue: 0,0:12:04.99,0:12:09.50,Main,,0,0,0,,Olamaz-fa! Korkarsan ömrün çalınır-fa!Dialogue: 0,0:12:16.82,0:12:21.22,Main,,0,0,0,,Bağışla beni Mama! Sana bir daha engel olmayacağım!Dialogue: 0,0:12:21.22,0:12:24.76,Main,,0,0,0,,Yalvarıyorum, canımı bari bağışla!Dialogue: 0,0:12:42.01,0:12:44.49,Main,,0,0,0,,40 yılını ver.Dialogue: 0,0:12:51.04,0:12:52.55,Main,,0,0,0,,Abi!Dialogue: 0,0:12:54.02,0:12:56.03,Main,,0,0,0,,Moscato-sama!Dialogue: 0,0:12:56.03,0:12:57.83,Main,,0,0,0,,Kendi oğlunu...Dialogue: 0,0:12:58.92,0:13:02.32,Main,,0,0,0,,...öldürdü!!Dialogue: 0,0:13:05.42,0:13:09.10,Main,,0,0,0,,Croquembouche!Dialogue: 0,0:13:09.67,0:13:13.52,Main,,0,0,0,,Kaçın! Artık önüne kimse geçemez!Dialogue: 0,0:13:19.48,0:13:21.27,Main,,0,0,0,,Ne korkunç.Dialogue: 0,0:13:28.16,0:13:31.08,Main,,0,0,0,,Meyve suyu nehrinden biri geliyor!Dialogue: 0,0:13:31.08,0:13:33.33,Main,,0,0,0,,- Bu şey... - O adam...Dialogue: 0,0:13:33.33,0:13:34.75,Main,,0,0,0,,Hiç şüphesiz!Dialogue: 0,0:13:34.75,0:13:37.83,Main,,0,0,0,,Çekilin yoldan!Dialogue: 0,0:13:36.04,0:13:40.54,Captions,,0,0,0,,Jinbe – Eski Shichibukai Güneş Korsanları KaptanıDialogue: 0,0:13:37.83,0:13:40.54,Main,,0,0,0,,Patron Jinbe!Dialogue: 0,0:13:41.13,0:13:43.21,Main,,0,0,0,,Kurtarın bizi!Dialogue: 0,0:13:43.21,0:13:45.51,Main,,0,0,0,,Yenileceğiz!Dialogue: 0,0:13:46.18,0:13:48.85,Main,,0,0,0,,Yanında croquembouche var!Dialogue: 0,0:13:48.85,0:13:52.64,Main,,0,0,0,,Otelde kalan krema toplarını yakalamış!Dialogue: 0,0:13:52.64,0:13:57.23,Main,,0,0,0,,Hepsi de şeker kaplı, Şeker Bakanı'nın işi mi bu?!Dialogue: 0,0:14:02.56,0:14:04.50,Main,,0,0,0,,Bu tarafa bak hele!Dialogue: 0,0:14:05.32,0:14:07.70,Main,,0,0,0,,Durdurma beni!Dialogue: 0,0:14:08.99,0:14:11.24,Main,,0,0,0,,Yakala!Dialogue: 0,0:14:34.68,0:14:38.39,Main,,0,0,0,,Enfes!Dialogue: 0,0:14:40.01,0:14:43.65,Main,,0,0,0,,- Bu işte! - Mama'nın sancısı dindi!Dialogue: 0,0:14:44.98,0:14:47.28,Main,,0,0,0,,Bu işte bu!Dialogue: 0,0:14:47.81,0:14:52.13,Main,,0,0,0,,Enfes ise ne ala...Dialogue: 0,0:14:52.13,0:14:55.54,Main,,0,0,0,,Çok sağ ol Patron Jinbe!Dialogue: 0,0:14:56.95,0:15:00.08,Main,,0,0,0,,Şefe haber verin! Kriz sona erdi!Dialogue: 0,0:15:00.08,0:15:02.44,Main,,0,0,0,,Tüm bakanları çağırın!Dialogue: 0,0:15:02.44,0:15:06.06,Main,,0,0,0,,Başkent olabilecek en hızlı şekilde onarılsın-bon!Dialogue: 0,0:15:08.80,0:15:14.35,Main,,0,0,0,,Denizlerimin biricik asil şövalyesi Jinbe!Dialogue: 0,0:15:14.35,0:15:19.06,Main,,0,0,0,,Geçen sefer getirdiğin Ponegliff hediyesini çok beğendim.Dialogue: 0,0:15:15.68,0:15:23.36,Captions,,0,0,0,,Charlotte Linlin – Yonko Totto Land Kraliçesi Big Mom Korsanları KaptanıDialogue: 0,0:15:19.06,0:15:21.38,Main,,0,0,0,,Okuyamıyorum gerçi ama...Dialogue: 0,0:15:26.86,0:15:31.39,Main,,0,0,0,,Ne oldu? Bugün ne için buradasın?Dialogue: 0,0:15:31.82,0:15:36.33,Main,,0,0,0,,Amanın? Şehir hiç olmadığı kadar hoş görünüyor.Dialogue: 0,0:15:36.33,0:15:38.58,Main,,0,0,0,,Senin işin mi?Dialogue: 0,0:15:38.58,0:15:44.00,Main,,0,0,0,,Hayır, buraya az önce ayak bastım. Ne olduğuna dair bir fikrim yok.Dialogue: 0,0:15:44.00,0:15:46.42,Main,,0,0,0,,Bak sen...Dialogue: 0,0:15:46.42,0:15:48.63,Main,,0,0,0,,Bugün buraya...Dialogue: 0,0:15:50.22,0:15:54.72,Main,,0,0,0,,...sana önemli bir şey söylemek için geldim.Dialogue: 0,0:16:00.89,0:16:04.65,Main,,0,0,0,,Bizden ayrılmayacaksındır umarım!Dialogue: 0,0:16:07.32,0:16:10.32,Captions,,0,0,0,,Birkaç saat önceDialogue: 0,0:16:12.04,0:16:17.41,Main,,0,0,0,,Hasır Şapkalı Luffy er ya da geç dünyayı değiştirecek bir adam!Dialogue: 0,0:16:18.00,0:16:21.97,Main,,0,0,0,,Hâlâ genç fakat bu denizlerin kralı olacak kişinin...Dialogue: 0,0:16:21.97,0:16:24.71,Main,,0,0,0,,...şu anki Yonkou'dan biri değil...Dialogue: 0,0:16:25.22,0:16:29.34,Main,,0,0,0,,...Hasır Şapkalı Luffy  olacağını düşünüyorum!Dialogue: 0,0:16:32.98,0:16:33.88,Main,,0,0,0,,Ve ben...Dialogue: 0,0:16:34.97,0:16:38.31,Main,,0,0,0,,...ona destek olmak istiyorum!Dialogue: 0,0:16:44.32,0:16:46.21,Flashbacks,,0,0,0,,Ben...Dialogue: 0,0:16:46.70,0:16:48.86,Flashbacks,,0,0,0,,...güçsüzüm!Dialogue: 0,0:16:48.86,0:16:54.50,Main,,0,0,0,,Ben... Ben Hasır Şapka'nın gemisine atlayıp...Dialogue: 0,0:16:54.50,0:16:57.82,Main,,0,0,0,,...tüm hayatımı ona adamak arzusundayım!Dialogue: 0,0:16:57.82,0:17:04.46,Main,,0,0,0,,Biz Balık Halkı'nı özgürlüğe kavuşturacak asıl şeyin bu olduğuna inanıyorum!Dialogue: 0,0:17:06.71,0:17:13.47,Captions,,0,0,0,,Aladdin (Brotula Balık Adamı) Güneş Korsanları'nın İkinci KaptanıDialogue: 0,0:17:08.26,0:17:14.30,Main,,0,0,0,,Geçtiğimiz iki yıl boyunca Luffy-kun hakkında bize çok şey anlattın.Dialogue: 0,0:17:14.80,0:17:19.93,Main,,0,0,0,,O kadar sevdiğin birine katılman bence de iyi olur.Dialogue: 0,0:17:20.86,0:17:22.68,Main,,0,0,0,,Sa-Sahiden mi?!Dialogue: 0,0:17:23.28,0:17:25.64,Main,,0,0,0,,Ondan o kadar çok mu bahsettim?Dialogue: 0,0:17:28.25,0:17:30.65,Main,,0,0,0,,Git hadi, Jinbe!Dialogue: 0,0:17:33.59,0:17:35.32,Main,,0,0,0,,Emin misiniz?Dialogue: 0,0:17:37.07,0:17:40.74,Main,,0,0,0,,Kimsenin seni durdurmaya hakkı yok Kaptan!Dialogue: 0,0:17:40.74,0:17:46.60,Main,,0,0,0,,Aynen öyle! Neptune Ordusu'nun askeri olmana rağmen bizimle...Dialogue: 0,0:17:46.60,0:17:51.67,Main,,0,0,0,,...Marijoa'dan kaçan kölelerle birlikte savaşmak için korsan oldun.Dialogue: 0,0:17:51.67,0:17:57.04,Main,,0,0,0,,Biz Balık Halkı'nın toplum içindeki yerini iyileştirmek için Shichibukai olup...Dialogue: 0,0:17:57.04,0:18:01.57,Main,,0,0,0,,...yine sırf bizi ve memleketimiz Ryugu Krallığı'nı...Dialogue: 0,0:18:01.57,0:18:07.98,Main,,0,0,0,,...koruyabilmek için Big Mom'ın adı altında Big Mom Korsanları'yla ittifak kurdun.Dialogue: 0,0:18:07.98,0:18:13.71,Main,,0,0,0,,Hayatta hep başkalarının iyiliği için bir şeyler yaptın Kaptan!Dialogue: 0,0:18:14.28,0:18:18.21,Main,,0,0,0,,Başkaları için bu kadar  çabaladığın yeter Jinbe.Dialogue: 0,0:18:20.83,0:18:24.29,Main,,0,0,0,,Aynen öyle! Özgür yaşa, Jinbe-san!Dialogue: 0,0:18:24.29,0:18:28.38,Main,,0,0,0,,- Git hadi Jinbe! - Aynen öyle, Kaptan Jinbe!Dialogue: 0,0:18:28.38,0:18:32.21,Main,,0,0,0,,Bize bir şey olmaz! Bizi düşünmene gerek yok!Dialogue: 0,0:18:32.21,0:18:36.09,Main,,0,0,0,,Bundan sonra kendin için yaşa!Dialogue: 0,0:18:52.15,0:18:55.36,Main,,0,0,0,,Hepiniz çok sağ olun!Dialogue: 0,0:19:05.85,0:19:12.00,Main,,0,0,0,,Dedik ama Big Mom'ın Kaptan'ı kolay kolay bırakacağını sanmıyorum.Dialogue: 0,0:19:12.00,0:19:17.61,Main,,0,0,0,,Öfkesini bize de çevirirse kaçmaktan başka seçeneğimiz kalmayacak!Dialogue: 0,0:19:17.61,0:19:20.34,Main,,0,0,0,,Sen ne yapacaksın Aladdin-san?Dialogue: 0,0:19:21.12,0:19:25.87,Main,,0,0,0,,Praline ablayla evlenip Big Mom ailesinin bir parçası oldun sonuçta.Dialogue: 0,0:19:25.87,0:19:27.97,Main,,0,0,0,,Amanın?Dialogue: 0,0:19:29.66,0:19:32.81,Main,,0,0,0,,Benim için endişeleniyor musunuz yoksa?Dialogue: 0,0:19:32.81,0:19:34.36,Main,,0,0,0,,Oh, Abla!Dialogue: 0,0:19:35.86,0:19:39.24,Captions,,0,0,0,,Charlotte Praline (Yarı-İnsan, Yarı-Çekiçbaşlı Köpekbalığı Deniz Kızı) Charlotte Ailesinin 29. KızıDialogue: 0,0:19:39.24,0:19:42.45,Main,,0,0,0,,Dedikodumu mu yapıyorsunuz?Dialogue: 0,0:19:42.45,0:19:44.99,Main,,0,0,0,,Ne dediğimizi duydun mu yoksa?!Dialogue: 0,0:19:44.99,0:19:49.00,Main,,0,0,0,,Burnuma pis kokular geliyor! Benden bir şey mi saklıyorsun?!Dialogue: 0,0:19:48.98,0:19:56.26,Main,,0,0,0,,Aladdin! Mama kızarsa beni geride bırakıp kaçmayı düşünmüyorsun herhâlde?!Dialogue: 0,0:19:56.26,0:19:58.63,Main,,0,0,0,,Hayır, elbette...Dialogue: 0,0:19:58.63,0:20:01.09,Main,,0,0,0,,Düşünmene bile gerek yok!Dialogue: 0,0:20:01.09,0:20:07.14,Main,,0,0,0,,Mama da kimmiş, elbette seni seçerim! Bir şey olursa beni de yanında götür!Dialogue: 0,0:20:07.14,0:20:09.06,Main,,0,0,0,,Her taraf pembe oldu!Dialogue: 0,0:20:11.13,0:20:13.08,Main,,0,0,0,,Kusura bakma Wadatsumi.Dialogue: 0,0:20:13.08,0:20:16.09,Main,,0,0,0,,Seni daha yeni getirdim ama duyduğun gibi.Dialogue: 0,0:20:16.09,0:20:21.70,Main,,0,0,0,,Hiç önemli değil! Burada herkesle birlikte çok mutluyum.Dialogue: 0,0:20:24.51,0:20:31.50,Main,,0,0,0,,Yalnız Praline, Mama'nın beni,  bizi affetmeyeceğine emin misin?Dialogue: 0,0:20:31.50,0:20:38.87,Main,,0,0,0,,Daha önce aynı şeyi deneyenler olmadı değil fakat ayrılmak isteyen herkesin sonu...Dialogue: 0,0:20:38.87,0:20:40.71,Main,,0,0,0,,...ölüm oldu!Dialogue: 0,0:20:42.10,0:20:46.06,Captions,,1000,0,240,,Şimdiki zaman: Whole Cake AdasıDialogue: 0,0:20:46.34,0:20:50.47,Captions,,0,0,0,,Tatlı Şehir Whole Cake Adası BaşkentiDialogue: 0,0:21:05.07,0:21:07.32,Main,,0,0,0,,Moscato-sama!Dialogue: 0,0:21:07.32,0:21:10.66,Main,,0,0,0,,Moscato-sama öldü!Dialogue: 0,0:21:10.66,0:21:13.62,Main,,0,0,0,,Lütfen gözlerini aç Moscato-sama!Dialogue: 0,0:21:13.62,0:21:16.00,Main,,0,0,0,,Moscato-sama!Dialogue: 0,0:21:23.34,0:21:25.22,Main,,0,0,0,,Sonunda geldiler.Dialogue: 0,0:21:32.53,0:21:34.00,Main,,0,0,0,,Çabuk götürün onu buradan.Dialogue: 0,0:21:34.00,0:21:34.60,Main,,0,0,0,,Emredersiniz!Dialogue: 0,0:21:34.60,0:21:36.94,Main,,0,0,0,,Çekil şuradan!Dialogue: 0,0:21:47.12,0:21:48.32,Main,,0,0,0,,Kulaklarınızı iyi açın.Dialogue: 0,0:21:48.32,0:21:52.54,Main,,0,0,0,,Bir saniye bile ıskalamayın! Anladınız değil mi?Dialogue: 0,0:22:02.21,0:22:03.80,Main,,0,0,0,,Moscato-sama...Dialogue: 0,0:22:06.67,0:22:11.28,Main,,0,0,0,,Patron Jinbe de öldürülecek mi Montd'Or-sama?Dialogue: 0,0:22:11.28,0:22:12.98,Main,,0,0,0,,Ne bileyim ben!Dialogue: 0,0:22:12.98,0:22:16.92,Main,,0,0,0,,Mama'yı kızdıran kişi oğlu bile olsa...Dialogue: 0,0:22:16.92,0:22:18.52,Main,,0,0,0,,...sonu belli!Dialogue: 0,0:22:22.30,0:22:28.58,Captions,,10,0,420,,Tatlı Şehir Whole Cake KalesiDialogue: 0,0:22:29.68,0:22:32.74,Main,,0,0,0,,Ayrılıyorsun demek Jinbe?Dialogue: 0,0:22:35.56,0:22:39.34,Main,,0,0,0,,- Neden peki Patron?! - Gitme lütfen Patron! Neden gideceksin ki?!Dialogue: 0,0:22:39.34,0:22:40.75,Main,,0,0,0,,Kesin sesinizi!Dialogue: 0,0:22:46.88,0:22:51.60,Main,,0,0,0,,Ayrılacak kişiye sebep falan sormayın, rezil duruma düşüyorsunuz!Dialogue: 0,0:22:51.60,0:22:54.38,Main,,0,0,0,,Hem kimin umrunda!Dialogue: 0,0:22:57.46,0:23:02.52,Main,,0,0,0,,Korsansan elbet gönlünce yaşamak istersin!Dialogue: 0,0:23:03.01,0:23:05.69,Main,,0,0,0,,Leziz miyim? Ha leziz miyim...Dialogue: 0,0:23:08.22,0:23:10.14,Main,,0,0,0,,Fakat...Dialogue: 0,0:23:10.14,0:23:15.90,Main,,0,0,0,,...sadakat yemininden dönmek efendinin yüzünü karartır!Dialogue: 0,0:23:16.88,0:23:23.11,Main,,0,0,0,,Jinbe, bu yaptığın seni, güçlü bir varlığımı yitireceğim demek oluyor biliyorsun.Dialogue: 0,0:23:23.11,0:23:24.92,Main,,0,0,0,,Evet ama...Dialogue: 0,0:23:24.92,0:23:30.49,Main,,0,0,0,,Aması falan yok! Sen de bir şeyler yitireceksin!Dialogue: 0,0:23:30.49,0:23:33.09,Main,,0,0,0,,Göze göz, dişe diş!Dialogue: 0,0:23:39.63,0:23:41.50,Main,,0,0,0,,Ruleti getirin!Dialogue: 0,0:23:57.60,0:24:00.36,Main,,0,0,0,,Çevir bakalım.Dialogue: 0,0:24:05.00,0:24:11.93,Main,,0,0,0,,Ne kaybedeceksin bakalım!Dialogue: 0,0:24:18.18,0:24:23.27,Narrator,,0,0,0,,Bu sırada Luffyler Big Mom'ın bölgesindeki denizde süzülmekteydiler.Dialogue: 0,0:24:25.92,0:24:27.52,Main,,0,0,0,,Acayip tatlı!Dialogue: 0,0:24:28.89,0:24:31.34,Main,,0,0,0,,Yalnız bir adım bile kımıldamıyor.Dialogue: 0,0:24:31.34,0:24:32.63,Main,,0,0,0,,Olmayacak böyle...Dialogue: 0,0:24:32.63,0:24:35.43,Main,,0,0,0,,Aman ne olacak ki, burada kalıp uyuyalım işte!Dialogue: 0,0:24:35.43,0:24:39.29,Main,,0,0,0,,Olmaz ya! Yine karıncalar saldırırsa ne yapacağız?!Dialogue: 0,0:24:39.29,0:24:43.16,Main,,0,0,0,,Güneş doğar doğmaz yine akmaya başlar ama...Dialogue: 0,0:24:43.16,0:24:46.44,Main,,0,0,0,,Deniz gece vakti soğuyup donuyor.Dialogue: 0,0:24:46.44,0:24:49.50,Main,,0,0,0,,Böyle şeyleri önceden söylesen çok hoş olacak hani!Dialogue: 0,0:24:50.96,0:24:55.11,Main,,0,0,0,,Hemen eritip bu nişasta şurubu denizinden çabucak uzaklaşmamız lazım!Dialogue: 0,0:24:55.11,0:24:55.84,Main,,0,0,0,,Evet!Dialogue: 0,0:24:56.45,0:24:57.95,Main,,0,0,0,,Çekelim!Dialogue: 0,0:24:57.95,0:25:01.60,Main,,0,0,0,,O karıncaları da yalnızca uyuttuk!Dialogue: 0,0:25:01.60,0:25:04.15,Main,,0,0,0,,Uyanırlarsa hiç iyi olmayacak.Dialogue: 0,0:25:04.15,0:25:05.85,Main,,0,0,0,,Aynen öyle.Dialogue: 0,0:25:08.77,0:25:12.55,Main,,0,0,0,,Bu Deniz Karıncaları bir zamanlar gemimi yemişti.Dialogue: 0,0:25:12.55,0:25:13.53,Main,,0,0,0,,Kabus gibi!Dialogue: 0,0:25:13.53,0:25:17.66,Main,,0,0,0,,Bir zamanlar derken... Buraya niye gelmiştin?Dialogue: 0,0:25:17.66,0:25:22.15,Main,,0,0,0,,Pedro bir zamanlar Pekoms'la birlikte korsanlık yapıyordu.Dialogue: 0,0:25:22.15,0:25:24.68,Main,,0,0,0,,Hadi ya! Sahiden mi?Dialogue: 0,0:25:25.20,0:25:27.70,Main,,0,0,0,,Çok saftım.Dialogue: 0,0:25:27.70,0:25:31.96,Main,,0,0,0,,Kâşif olduğumu düşünürdüm ama aranan biri haline döndüm.Dialogue: 0,0:25:31.96,0:25:34.80,Main,,0,0,0,,Pekomslar'a da yarı yola kadar eşlik ettim.Dialogue: 0,0:25:36.68,0:25:39.60,Main,,0,0,0,,Siz-garalara güveniyorum o yüzden anlatabilirim.Dialogue: 0,0:25:39.60,0:25:45.44,Main,,0,0,0,,Nekomamushi Efendi'ye yardımcı olabilmek için Poneglifleri arıyordum.Dialogue: 0,0:25:47.19,0:25:53.53,Main,,0,0,0,,Fakat Big Mom'ın bölgesine adım atmam yolculuğumun sonu oldu.Dialogue: 0,0:25:56.22,0:25:57.45,Main,,0,0,0,,Ben...Dialogue: 0,0:25:57.45,0:26:00.36,Main,,0,0,0,,...burada bir kez yenildim.Dialogue: 0,0:26:07.03,0:26:09.50,Main,,0,0,0,,Pek sık anlattığım bir anım değildir bu.Dialogue: 0,0:26:09.96,0:26:12.34,Main,,0,0,0,,Bunu bilmiyordum işte.Dialogue: 0,0:26:20.30,0:26:23.77,Main,,0,0,0,,Burayla ilgili kötü anılara sahip olmana rağmen yine de geldin...Dialogue: 0,0:26:23.77,0:26:29.19,Main,,0,0,0,,Burayla ilgili deneyimlerim Sanji'yi kurtarmanıza yardımcı olacaksa ne ala.Dialogue: 0,0:26:30.61,0:26:32.61,Main,,0,0,0,,Hatta belki de...Dialogue: 0,0:26:32.61,0:26:36.48,Main,,0,0,0,,...buraya gelmem o kadar da kötü bir şey olmayabilir.Dialogue: 0,0:26:37.54,0:26:43.20,Main,,0,0,0,,Krallarımızın siz-garalara Balina Ağacı'ndaki Yol Poneglifi gösterdiğini duydum.Dialogue: 0,0:26:43.20,0:26:44.74,Main,,0,0,0,,Evet.Dialogue: 0,0:26:44.74,0:26:47.31,Main,,0,0,0,,Duyunca çok şaşırdım.Dialogue: 0,0:26:47.79,0:26:49.64,Main,,0,0,0,,Bizi kurtarmış olsanız dahi...Dialogue: 0,0:26:49.64,0:26:53.17,Main,,0,0,0,,...onu Kozuki Klanı dışında kimselere en son...Dialogue: 0,0:26:53.17,0:26:56.13,Main,,0,0,0,,...26 yıl önce...Dialogue: 0,0:26:56.13,0:26:59.84,Main,,0,0,0,,...Gol D. Roger korsanlarına göstermişlerdi.Dialogue: 0,0:27:00.56,0:27:01.93,Main,,0,0,0,,Korsanlar Kralına mı?!Dialogue: 0,0:27:02.36,0:27:07.45,Main,,0,0,0,,Roger ondan sonra Raftel'e ulaşıp Korsanlar Kralı oldu.Dialogue: 0,0:27:09.64,0:27:16.11,Main,,0,0,0,,Siz-gara Dük Inuarashi ve Nekomamushi Efendi'ye onları hatırlatıyorsunuz.Dialogue: 0,0:27:18.61,0:27:23.57,Main,,0,0,0,,Yol Poneglife ihtiyaç duyacak birileri olmanızı bekliyorlar.Dialogue: 0,0:27:23.99,0:27:27.26,Main,,0,0,0,,Kaido'yla savaştıktan sonra ne yapacaksınız?Dialogue: 0,0:27:27.70,0:27:30.79,Main,,0,0,0,,O kadar ilerisini kim düşünecek şimdi!Dialogue: 0,0:27:30.79,0:27:34.96,Main,,0,0,0,,Ondan sonra Big Mom'daki Yol Poneglife ihtiyacınız olacak!Dialogue: 0,0:27:35.81,0:27:39.48,Main,,0,0,0,,Hazır buradayken, bundan büyük fırsat olmaz!Dialogue: 0,0:27:39.48,0:27:42.55,Main,,0,0,0,,Bölgesinde bu kadar ilerlemişken...Dialogue: 0,0:27:42.55,0:27:48.14,Main,,0,0,0,,...Sanji'yi kurtarmanın yanısıra Big Mom'ın Yol Poneglifini de çalalım derim!Dialogue: 0,0:27:50.39,0:27:53.79,Main,,0,0,0,,Ne? Bu...Dialogue: 0,0:27:54.82,0:27:57.40,Main,,0,0,0,,Sanji'nin yanısıra Yol Poneglifi de öyle mi?Dialogue: 0,0:28:00.37,0:28:05.42,Main,,0,0,0,,Robin de aynı şeyi istemişti ama önce Sanji'yi kurtarmak istiyorum...Dialogue: 0,0:28:05.42,0:28:07.16,Main,,0,0,0,,Biliyorum.Dialogue: 0,0:28:07.16,0:28:11.89,Main,,0,0,0,,Yol Poneglifi ben alırım. Siz-gara Sanji'yi kurtarın.Dialogue: 0,0:28:14.63,0:28:18.77,Main,,0,0,0,,Adaya vardığımızda bana biraz zaman tanır mısınız?Dialogue: 0,0:28:18.77,0:28:20.47,Main,,0,0,0,,Bu sefer alacağım onu!Dialogue: 0,0:28:20.47,0:28:24.59,Main,,0,0,0,,Yani bunu bizim için yapıyorsan biz de seninle geliriz!Dialogue: 0,0:28:24.59,0:28:28.14,Main,,0,0,0,,Hayır, siz Sanji'yi koruyun.Dialogue: 0,0:28:28.14,0:28:30.43,Main,,0,0,0,,Onu almayı başarsanız bile sonrası hiç kolay olmayacak.Dialogue: 0,0:28:35.69,0:28:38.75,Main,,0,0,0,,Öyle demek... O zaman sana güveniyoruz!Dialogue: 0,0:28:39.36,0:28:41.00,Main,,0,0,0,,Harika, karar verildi öyleyse!Dialogue: 0,0:28:41.00,0:28:42.65,Main,,0,0,0,,Elma seçer gibi karar vermesenize...Dialogue: 0,0:28:44.52,0:28:49.24,Main,,0,0,0,,Luffy-san hangi şanslı yıldızın altında doğdu acaba?Dialogue: 0,0:28:50.78,0:28:51.86,Main,,0,0,0,,Bir şey mi dedin Brook?Dialogue: 0,0:28:51.86,0:28:54.87,Main,,0,0,0,,Yok, yok. Bu durumda ben de epey şanslıyım.Dialogue: 0,0:28:54.87,0:28:58.00,Main,,0,0,0,,Ne diyorsun sen yahu? Ne tuhaf birisin.Dialogue: 0,0:29:10.81,0:29:13.84,Main,,0,0,0,,Karıncalar uyandı!Dialogue: 0,0:29:13.84,0:29:15.06,Main,,0,0,0,,Olamaz!Dialogue: 0,0:29:15.06,0:29:17.80,Main,,0,0,0,,Karınca! Karınca! Karınca! Karınca!Dialogue: 0,0:29:17.80,0:29:19.45,Main,,0,0,0,,Geliyorlar!Dialogue: 0,0:29:20.15,0:29:22.95,Main,,0,0,0,,Sunny'i koruyun!Dialogue: 0,0:29:25.07,0:29:29.55,Captions,,1000,0,310,,Ertesi GünDialogue: 0,0:29:34.28,0:29:36.30,Main,,0,0,0,,Millet!Dialogue: 0,0:29:36.30,0:29:37.71,Main,,0,0,0,,Uyanın!Dialogue: 0,0:29:42.03,0:29:43.97,Main,,0,0,0,,Ne? Ne oldu?Dialogue: 0,0:29:55.13,0:29:57.15,Main,,0,0,0,,Şuna bakın!Dialogue: 0,0:30:08.91,0:30:10.53,Main,,0,0,0,,Sonunda geldik!Dialogue: 0,0:30:17.28,0:30:21.24,Main,,0,0,0,,Vay canına, devasa resmen!Dialogue: 0,0:30:21.24,0:30:24.14,Main,,0,0,0,,Yonkou burada yaşıyor demek!Dialogue: 0,0:30:25.58,0:30:27.51,Main,,0,0,0,,Pasta!Dialogue: 0,0:30:29.59,0:30:34.51,Main,,0,0,0,,En büyük pasta Big Mom'ın yaşadığı kale.Dialogue: 0,0:30:34.51,0:30:36.15,Main,,0,0,0,,Kale mi?!Dialogue: 0,0:30:36.15,0:30:38.90,Main,,0,0,0,,Nami-san, dosdoğru mu devam ediyoruz?Dialogue: 0,0:30:38.90,0:30:42.85,Main,,0,0,0,,Evet, şu burun güvenlik olmayan tek yermiş.Dialogue: 0,0:30:42.85,0:30:44.57,Main,,0,0,0,,Anlıyorum.Dialogue: 0,0:30:44.57,0:30:47.10,Main,,0,0,0,,Pudding-san'ın bahsettiği yer.Dialogue: 0,0:30:47.10,0:30:50.81,Main,,0,0,0,,Evet, ona gerçekten çok şey borçluyuz.Dialogue: 0,0:30:50.81,0:30:54.53,Main,,0,0,0,,O olmasaydı buraya kadar gelebilir miydik bilmiyorum.Dialogue: 0,0:30:54.53,0:30:56.12,Main,,0,0,0,,Haklısın.Dialogue: 0,0:30:58.41,0:31:00.96,Main,,0,0,0,,Ha, biri var!Dialogue: 0,0:31:08.54,0:31:09.93,Main,,0,0,0,,Sanji?Dialogue: 0,0:31:09.93,0:31:13.17,Main,,0,0,0,,Sen misin bu?! Hey!Dialogue: 0,0:31:13.17,0:31:15.97,Main,,0,0,0,,Sanji!Dialogue: 0,0:31:13.17,0:31:17.30,OP11 Credits,,0,0,0,,Editing:  Feeso, Galaxy 9000  Timing: Halee Sewil (Opening)  Quality Assurance: Galaxy 9000, Grug, Mr. Luffy, Pepperjack  Soundtracking:  Halee  Graphics:  Datenshi, Yibis (Karaoke)  Translation: Crunchyroll, Yibis (Opening)Dialogue: 0,0:00:00.82,0:00:06.82,Lyrics,,0,0,0,karaoke,♪ Görmedim dünyanın sonunu kendi gözlerimle hiç. ♪Dialogue: 0,0:00:06.82,0:00:13.95,Lyrics,,0,0,0,karaoke,♪ O yüzden çıktım yola sizinle, bunu yapmak için! ♪Dialogue: 0,0:00:23.67,0:00:27.00,Lyrics,,0,0,0,karaoke,♪ Bir denizden diğerine yol alırken,...Dialogue: 0,0:00:29.06,0:00:31.91,Lyrics,,0,0,0,karaoke,...bunun sadece bir peri masalı olduğunu söylemek. ♪Dialogue: 0,0:00:31.92,0:00:38.78,Lyrics,,0,0,0,karaoke,♪ Gerçek, kurgudan daha tuhaf değil mi? ♪Dialogue: 0,0:00:39.94,0:00:43.56,Lyrics,,0,0,0,karaoke,♪ Fakat sırt çevirme hiçbirine ♪Dialogue: 0,0:00:43.56,0:00:50.04,Lyrics,,0,0,0,karaoke,♪ Sağduyu dedikleri zihnidir toplulukların! ♪Dialogue: 0,0:00:51.36,0:00:57.41,Lyrics,,0,0,0,karaoke,♪ Görmedim dünyanın sonunu kendi gözlerimle hiç. ♪Dialogue: 0,0:00:57.41,0:01:01.96,Lyrics,,0,0,0,karaoke,♪ O yüzden gitmemiz lazım Kaptan Özgür-Ruh! ♪Dialogue: 0,0:01:01.96,0:01:04.72,Lyrics,,0,0,0,karaoke,♪ Kim demiş imkansız diye,...Dialogue: 0,0:01:04.71,0:01:07.89,Lyrics,,0,0,0,karaoke,...daha hiçbir şey başlamadan! ♪Dialogue: 0,0:01:07.88,0:01:12.72,Lyrics,,0,0,0,karaoke,♪ Her şeyi bilmek istiyorum ve şimdi bilebiliriz de... ♪Dialogue: 0,0:01:12.72,0:01:18.68,Lyrics,,0,0,0,karaoke,♪ Bilebiliriz, bilebilirsin! Şu anda... ♪Dialogue: 0,0:01:19.06,0:01:24.10,Lyrics,,0,0,0,karaoke,♪ Bilebiliriz, bilebilirim! Bu harika hissi... ♪Dialogue: 0,0:01:24.39,0:01:31.32,Lyrics,,0,0,0,karaoke,♪ Hemen, şimdi, bilebiliriz! ♪Dialogue: 0,0:01:37.34,0:01:38.64,Lyrics,,0,0,0,karaoke,♪ Evet, bilebiliriz! ♪