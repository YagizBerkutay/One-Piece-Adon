yle: Author,Impress BT,20.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.7,0.7,9,10,10,10,1Style: Attack,Duality,30.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.0,1.0,7,12,12,12,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:01:41.74,0:01:44.37,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - ARE-YOU-SURE thx to onepace.netDialogue: 0,0:17:39.50,0:17:48.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - ARE-YOU-SURE thx to onepace.netDialogue: 0,0:35:40.75,0:35:45.55,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - ARE-YOU-SURE thx to onepace.netDialogue: 0,0:01:41.74,0:01:44.37,Title,,0,0,0,,Doğu Mavi'yeDialogue: 0,0:02:08.31,0:02:13.30,Main,,0,0,0,,Çok hızlı ilerliyor! Çocuklarınız gerçekten süper insanlar!Dialogue: 0,0:02:13.94,0:02:16.37,Main,,0,0,0,,- Baba! - Baba-sama!Dialogue: 0,0:02:21.40,0:02:23.03,Main,,0,0,0,,Sizinle gurur duyuyorum.Dialogue: 0,0:02:29.73,0:02:32.25,Main,,0,0,0,,Değerli evlatlarım!Dialogue: 0,0:02:40.68,0:02:45.56,Captions,,0,0,0,,Sanji'nin Tutsak Edilmesinin   Altıncı AyıDialogue: 0,0:02:55.08,0:02:59.94,Main,,0,0,0,,Her yemek vaktinde lüks yemeği nereye götürüyorlar?Dialogue: 0,0:02:59.94,0:03:02.95,Main,,0,0,0,,Bilmem ki. Hiç misafirimiz de yok.Dialogue: 0,0:03:02.95,0:03:08.83,Main,,0,0,0,,Her şeye karışmayın. Kral-sama'nın emri. Biz bize söyleneni pişiririz.Dialogue: 0,0:03:44.08,0:03:45.36,Main,,0,0,0,,Sanji!Dialogue: 0,0:03:46.41,0:03:50.46,Flashbacks,,0,0,0,,Kraliyet başkalarına hizmet etmemeli! Daha kaç defa diyeceğim?!Dialogue: 0,0:03:50.46,0:03:52.62,Flashbacks,,0,0,0,,Annen öldü artık!Dialogue: 0,0:03:52.62,0:03:55.39,Flashbacks,,0,0,0,,Ölenin izinden yürümeyi bırak!Dialogue: 0,0:04:03.05,0:04:04.72,Main,,0,0,0,,Acıdı!Dialogue: 0,0:04:05.63,0:04:07.05,Main,,0,0,0,,Eyvah!Dialogue: 0,0:04:07.05,0:04:10.93,Main,,0,0,0,,– Ah, ah, ah! – İyi misiniz Sanji-sama?!Dialogue: 0,0:04:12.12,0:04:15.76,Main,,0,0,0,,Kral-sama mutfağa almamamızı söyledi.Dialogue: 0,0:04:15.76,0:04:17.27,Main,,0,0,0,,Lütfen!Dialogue: 0,0:04:17.27,0:04:19.78,Main,,0,0,0,,Olur deyin!Dialogue: 0,0:04:32.12,0:04:34.00,Main,,0,0,0,,Bitti!Dialogue: 0,0:04:43.88,0:04:47.66,Main,,0,0,0,,- Kendi başınıza nereye gidiyorsunuz? - Annemi görmeye?Dialogue: 0,0:04:47.66,0:04:51.30,Main,,0,0,0,,Hastane koğuşu çok uzakta ve hava da...Dialogue: 0,0:04:51.30,0:04:52.91,Main,,0,0,0,,- Gidebilirim. - Ama--Dialogue: 0,0:04:52.91,0:04:54.36,Main,,0,0,0,,Beni takip etme.Dialogue: 0,0:04:57.73,0:04:59.90,Main,,0,0,0,,Babama da söyleme.Dialogue: 0,0:05:11.58,0:05:13.68,Main,,0,0,0,,Evlere girin!Dialogue: 0,0:05:30.60,0:05:33.47,Main,,0,0,0,,Ne var?! Bu senin yemeğin değil!Dialogue: 0,0:05:44.72,0:05:46.49,Main,,0,0,0,,Y-Yapma!Dialogue: 0,0:06:01.75,0:06:03.17,Main,,0,0,0,,S-Sanji-sama!Dialogue: 0,0:06:03.17,0:06:05.44,Main,,0,0,0,,Yoksa yalnız mı geldiniz?Dialogue: 0,0:06:11.40,0:06:13.76,Main,,0,0,0,,Yaptığınızı takdir ediyorum.Dialogue: 0,0:06:13.76,0:06:18.69,Main,,0,0,0,,Ama Kraliçe-sama'nın midesini bozmasına izin veremeyiz.Dialogue: 0,0:06:21.15,0:06:25.46,Main,,0,0,0,,Ama belki de tadı güzeldir.Dialogue: 0,0:06:29.74,0:06:31.78,Main,,0,0,0,,Ne?!Dialogue: 0,0:06:44.46,0:06:45.80,Main,,0,0,0,,Sanji!Dialogue: 0,0:06:45.80,0:06:49.13,Main,,0,0,0,,Bu yağmurda beni görmeye mi geldin?Dialogue: 0,0:06:49.13,0:06:52.23,Main,,0,0,0,,Baban öğrenirse kızar bak.Dialogue: 0,0:06:52.23,0:06:54.43,Main,,0,0,0,,- Evet. - Majesteleri.Dialogue: 0,0:06:55.51,0:06:57.56,Main,,0,0,0,,Sanji-sama'dan.Dialogue: 0,0:07:01.11,0:07:03.86,Main,,0,0,0,,Benim için mi yaptın?Dialogue: 0,0:07:09.52,0:07:10.70,Main,,0,0,0,,Epony!Dialogue: 0,0:07:10.70,0:07:12.44,Main,,0,0,0,,E-Emredin Majesteleri!Dialogue: 0,0:07:12.44,0:07:17.42,Main,,0,0,0,,Saygısızlık etme! Sanji'nin benim için yaptığını getir!Dialogue: 0,0:07:17.42,0:07:20.18,Main,,0,0,0,,Tamam.Dialogue: 0,0:07:20.18,0:07:25.41,Main,,0,0,0,,Ama yolda düşürdüğünden ben çöpe atmıştım onu.Dialogue: 0,0:07:25.41,0:07:26.67,Main,,0,0,0,,- Getir! - Baş üstüne!Dialogue: 0,0:07:30.97,0:07:32.78,Main,,0,0,0,,Ne harika.Dialogue: 0,0:07:32.78,0:07:36.72,Main,,0,0,0,,Yumurtalı barbekü, balık ve muz mu?Dialogue: 0,0:07:36.72,0:07:39.23,Main,,0,0,0,,Üzgünüm anne.Dialogue: 0,0:07:39.23,0:07:41.26,Main,,0,0,0,,Batırdım.Dialogue: 0,0:07:41.26,0:07:43.90,Main,,0,0,0,,Yolda takılıp düşürdüm.Dialogue: 0,0:07:43.90,0:07:46.65,Main,,0,0,0,,Hepsi ezildi ve yağmurda ıslandı.Dialogue: 0,0:07:46.65,0:07:48.30,Main,,0,0,0,,Bir bakalım.Dialogue: 0,0:07:54.74,0:07:55.95,Main,,0,0,0,,Leziz!Dialogue: 0,0:07:59.12,0:08:00.76,Main,,0,0,0,,Ne?!Dialogue: 0,0:08:00.76,0:08:03.12,Main,,0,0,0,,- Gerçekten mi?! - Evet.Dialogue: 0,0:08:03.12,0:08:05.42,Main,,0,0,0,,Anne!Dialogue: 0,0:08:06.34,0:08:08.92,Main,,0,0,0,,Sanji, bana yine pişirir misin?Dialogue: 0,0:08:10.09,0:08:11.15,Main,,0,0,0,,Evet!Dialogue: 0,0:08:29.50,0:08:33.70,Main,,0,0,0,,Anne!Dialogue: 0,0:08:34.63,0:08:38.12,Flashbacks,,0,0,0,,Sanji, bana yine pişirir misin?Dialogue: 0,0:08:51.96,0:08:53.76,Main,,0,0,0,,Yemek kitabı ve araç gereçleri mi istiyorsunuz?Dialogue: 0,0:09:18.06,0:09:20.33,Main,,0,0,0,,"All... Blue" mu?Dialogue: 0,0:09:21.38,0:09:24.16,Main,,0,0,0,,"Dünyadaki tüm balıkların yaşadığı...Dialogue: 0,0:09:25.55,0:09:27.70,Main,,0,0,0,,...efsanevi deniz!"Dialogue: 0,0:09:32.34,0:09:34.72,Main,,0,0,0,,Bakın! Gerçekten Sanji demiştim!Dialogue: 0,0:09:36.71,0:09:38.55,Main,,0,0,0,,Haklısın. Cidden o.Dialogue: 0,0:09:39.07,0:09:43.68,Main,,0,0,0,,Yaşıyormuş. Babam neden öyle bir yalan söyledi ki?Dialogue: 0,0:09:43.68,0:09:45.81,Main,,0,0,0,,Çünkü ölmesini istiyor.Dialogue: 0,0:09:47.77,0:09:53.80,Main,,0,0,0,,Öyleyse gerçekten ölürse babam mutlu olur mu?Dialogue: 0,0:10:17.65,0:10:18.97,Main,,0,0,0,,Kesin şunu!Dialogue: 0,0:10:21.35,0:10:26.88,Main,,0,0,0,,Ölmeyi hak eden bir fiyasko değil misin Sanji?!Dialogue: 0,0:10:40.28,0:10:41.91,Main,,0,0,0,,Ah...Dialogue: 0,0:10:41.91,0:10:46.41,Main,,0,0,0,,Senin tarafında olduğumu düşünme. Müdahil olmak istemiyorum.Dialogue: 0,0:10:47.05,0:10:50.86,Main,,0,0,0,,O üçü babamın mükemmel savaşçıları.Dialogue: 0,0:10:50.86,0:10:54.96,Main,,0,0,0,,Ne acırlar ne de üzülürler. Duygusuzdurlar.Dialogue: 0,0:10:57.47,0:11:02.64,Main,,0,0,0,,Benim bedenim de başarıyla modifiye edildi ama onlardan farklıyım.Dialogue: 0,0:11:03.72,0:11:04.86,Main,,0,0,0,,Görüşürüz.Dialogue: 0,0:11:04.86,0:11:07.40,Main,,0,0,0,,T-Teşekkürler, Reiju...Dialogue: 0,0:11:08.43,0:11:12.52,Main,,0,0,0,,Doğru ya. Yakında Red Line'a tırmanacağız.Dialogue: 0,0:11:12.52,0:11:16.44,Main,,0,0,0,,Doğu Mavi'de savaşmaya gidiyoruz.Dialogue: 0,0:11:16.48,0:11:18.96,Main,,0,0,0,,Savaş mı?Dialogue: 0,0:11:20.86,0:11:24.28,Main,,0,0,0,,Doğu Mavi'ye doğru yola çıkıyoruz!Dialogue: 0,0:11:34.13,0:11:37.65,Main,,0,0,0,,Tahmini yolculuk süresi 3 hafta.Dialogue: 0,0:12:26.29,0:12:31.20,Captions,,0,1030,350,,Doğu MaviDialogue: 0,0:12:40.12,0:12:42.57,Main,,0,0,0,,Reiju, ben...Dialogue: 0,0:12:51.02,0:12:52.13,Main,,0,0,0,,...Ben...Dialogue: 0,0:12:52.13,0:12:54.08,Main,,0,0,0,,...aşçı olmak istiyorum!Dialogue: 0,0:12:57.15,0:12:58.50,Main,,0,0,0,,Ateş!Dialogue: 0,0:13:00.17,0:13:04.30,Main,,0,0,0,,- Bunlar Germa 66! - Ne dedin? Gerçekler miymiş?Dialogue: 0,0:13:09.18,0:13:11.22,Main,,0,0,0,,Neler oluyor?Dialogue: 0,0:13:11.22,0:13:15.48,Main,,0,0,0,,Judge-sama, hedef ülke Koijo bizi fark etti!Dialogue: 0,0:13:16.48,0:13:18.23,Main,,0,0,0,,Diz çöktürün.Dialogue: 0,0:13:21.44,0:13:24.15,Main,,0,0,0,,Böyle şeyler deme dedim sana!Dialogue: 0,0:13:28.02,0:13:31.62,Main,,0,0,0,,Burada... Doğu Mavi'de...Dialogue: 0,0:13:35.52,0:13:38.46,Main,,0,0,0,,...kaçabilirsem...Dialogue: 0,0:13:41.32,0:13:43.15,Main,,0,0,0,,...bir daha asla...Dialogue: 0,0:13:43.98,0:13:46.06,Main,,0,0,0,,...babamın yüzünü...Dialogue: 0,0:13:46.69,0:13:49.76,Main,,0,0,0,,...görmem gerekmez değil mi?Dialogue: 0,0:13:58.08,0:13:58.98,Main,,0,0,0,,Geri dur!Dialogue: 0,0:14:03.69,0:14:05.86,Main,,0,0,0,,Tek şansın var!Dialogue: 0,0:14:05.86,0:14:07.70,Main,,0,0,0,,Boşa harcama!Dialogue: 0,0:14:15.70,0:14:17.57,Main,,0,0,0,,Karaya çıkın!Dialogue: 0,0:14:28.80,0:14:30.64,Main,,0,0,0,,Başladı!Dialogue: 0,0:14:30.64,0:14:35.15,Main,,0,0,0,,Demir maskenin anahtarı Baba-sama'nın odasında. Gidip al.Dialogue: 0,0:14:35.15,0:14:36.42,Main,,0,0,0,,Ne?Dialogue: 0,0:14:36.42,0:14:38.48,Main,,0,0,0,,Ben de dışarıyı gözleyeceğim.Dialogue: 0,0:14:38.48,0:14:40.06,Main,,0,0,0,,Anladın mı?Dialogue: 0,0:14:40.06,0:14:41.11,Main,,0,0,0,,Evet!Dialogue: 0,0:14:41.11,0:14:45.11,Main,,0,0,0,,Baba-sama'nın odasına girince duvarda kuru kafa resmi ara!Dialogue: 0,0:14:45.11,0:14:47.85,Main,,0,0,0,,Orada gizli bir kapak bulacaksın!Dialogue: 0,0:15:03.84,0:15:04.96,Main,,0,0,0,,Başardım.Dialogue: 0,0:15:06.24,0:15:07.92,Main,,0,0,0,,Orada ne yapıyorsun?Dialogue: 0,0:15:11.99,0:15:16.47,Main,,0,0,0,,Sanji mi? Burada ne işin var?Dialogue: 0,0:15:21.26,0:15:22.35,Main,,0,0,0,,Baba-sama!Dialogue: 0,0:15:27.63,0:15:32.77,Main,,0,0,0,,Ben bu krallıktan gideceğim! Yoluma çıkma!Dialogue: 0,0:15:33.54,0:15:37.95,Main,,0,0,0,,Mahkumken dilin bayağı uzamış.Dialogue: 0,0:15:37.95,0:15:44.92,Main,,0,0,0,,Senin gibi basit bir veledin tek başına hayatta kalabileceği bir deniz yok.Dialogue: 0,0:15:46.44,0:15:48.21,Main,,0,0,0,,Öleceksin.Dialogue: 0,0:15:54.67,0:15:58.13,Main,,0,0,0,,Ne olmuş yani?! Beni durduramazsın!Dialogue: 0,0:15:58.13,0:15:59.77,Main,,0,0,0,,Bana yardım etmiş olursun.Dialogue: 0,0:16:01.19,0:16:04.46,Main,,0,0,0,,Ben de bir insanım sonuçta.Dialogue: 0,0:16:04.46,0:16:10.82,Main,,0,0,0,,İşe yaramaz bile olsan kendi oğlumu öldüremem.Dialogue: 0,0:16:11.69,0:16:14.36,Main,,0,0,0,,Gönüllü olarak mı gideceksin?Dialogue: 0,0:16:17.91,0:16:24.04,Main,,0,0,0,,Seni durdurmayacağım. Demir maskenin anahtarını da alabilirsin.Dialogue: 0,0:16:27.17,0:16:34.76,Main,,0,0,0,,Ama baban olarak senden son bir istekte bulunabilir miyim Sanji?Dialogue: 0,0:16:37.68,0:16:41.89,Main,,0,0,0,,Senin baban olduğumu...Dialogue: 0,0:16:42.76,0:16:47.06,Main,,0,0,0,,...insanların önünde asla söyleme.Dialogue: 0,0:16:52.71,0:16:56.07,Main,,0,0,0,,Kimsenin bilmesini istemediğim bir utanç!Dialogue: 0,0:16:56.92,0:16:58.84,Main,,0,0,0,,Anlıyorsun değil mi?Dialogue: 0,0:17:47.79,0:17:50.20,Main,,0,0,0,,Limandaki yolcu gemisi ne olacak?Dialogue: 0,0:17:50.20,0:17:54.59,Main,,0,0,0,,Bizimle alakası yok! Şanssız bir gemi sadece! Rahat bırakın!Dialogue: 0,0:17:57.76,0:17:59.39,Main,,0,0,0,,O gemiye bin!Dialogue: 0,0:17:59.97,0:18:04.14,Main,,0,0,0,,Sanji! Erkeksin sen, daha ne kadar ne ağlayacaksın?Dialogue: 0,0:18:05.74,0:18:09.40,Main,,0,0,0,,Dinle! Bir daha sakın buraya dönme!Dialogue: 0,0:18:09.40,0:18:10.31,Main,,0,0,0,,Tamam!Dialogue: 0,0:18:13.04,0:18:16.30,Main,,0,0,0,,Deniz çok büyüktür. Bir gün...Dialogue: 0,0:18:17.53,0:18:22.99,Main,,0,0,0,,Bir gün kesinlikle nazik insanlarla tanışacaksın!Dialogue: 0,0:18:25.58,0:18:27.83,Main,,0,0,0,,Koş!Dialogue: 0,0:18:30.58,0:18:33.00,Main,,0,0,0,,Arkana bırakma!Dialogue: 0,0:18:38.51,0:18:42.22,Main,,0,0,0,,Koş! Sanji!Dialogue: 0,0:19:13.53,0:19:19.22,Captions,,970,0,340,,Ayartan Orman Luffy, Cracker'a KarşıDialogue: 0,0:19:13.53,0:19:19.22,Captions,,0,1020,315,,Dövüş başladığından beri 11 saat geçtiDialogue: 0,0:19:32.84,0:19:36.27,Main,,0,0,0,,Leziz! Güzel ve çıtır çıtır!Dialogue: 0,0:19:36.27,0:19:37.36,Main,,0,0,0,,İşte bu!Dialogue: 0,0:19:37.36,0:19:41.24,Main,,0,0,0,,Cracker-sama'nın Bisküvi Savaşçıları'nı yedi-ju!Dialogue: 0,0:19:41.24,0:19:42.78,Main,,0,0,0,,Ne?!Dialogue: 0,0:19:42.78,0:19:45.41,Main,,0,0,0,,Nasıl olur da yiyorsun?!Dialogue: 0,0:19:45.41,0:19:48.04,Main,,0,0,0,,Bisküviler de yemektir!Dialogue: 0,0:19:48.04,0:19:52.46,Main,,0,0,0,,Aynen öyle Luffy! Onları yediğin zaman eski haline dönemezler!Dialogue: 0,0:19:52.46,0:19:54.54,Main,,0,0,0,,Yiyebildiğin kadar ye!Dialogue: 0,0:19:54.54,0:19:58.26,Main,,0,0,0,,Ne kurnaz bir kadın-ju!Dialogue: 0,0:20:24.06,0:20:27.28,Main,,0,0,0,,Durum fena, bilinci yerinde mi?Dialogue: 0,0:20:33.60,0:20:34.75,Main,,0,0,0,,Çekilin.Dialogue: 0,0:20:34.75,0:20:38.75,Main,,0,0,0,,Reiju-sama, hemen tedavi edeceğiz.Dialogue: 0,0:20:38.75,0:20:40.80,Main,,0,0,0,,Çekilin dedim be!Dialogue: 0,0:20:40.80,0:20:42.30,Main,,0,0,0,,Özür dileriz!Dialogue: 0,0:20:48.25,0:20:50.34,Main,,0,0,0,,Cidden...Dialogue: 0,0:20:50.34,0:20:54.19,Main,,0,0,0,,Nişanlının karşına bu yüzle mi çıkacaksın şimdi?Dialogue: 0,0:20:55.58,0:21:01.18,Main,,0,0,0,,Çalıştığın restoranın sahibinden vazgeçmiş olsan bundan sakınabilirdin.Dialogue: 0,0:21:02.15,0:21:04.03,Main,,0,0,0,,Neden geri döndün ki?Dialogue: 0,0:21:05.22,0:21:10.04,Main,,0,0,0,,Burayı hatırlamak istemediğini düşünmüştüm.Dialogue: 0,0:21:10.04,0:21:11.45,Main,,0,0,0,,Sanji.Dialogue: 0,0:21:35.02,0:21:38.02,Main,,0,0,0,,Tıka basa doydum.Dialogue: 0,0:21:38.02,0:21:40.16,Main,,0,0,0,,Saçmalama lan!Dialogue: 0,0:21:42.03,0:21:46.16,Main,,0,0,0,,Seninle dövüşmekten bıktım ve yoruldum.Dialogue: 0,0:21:48.70,0:21:51.95,Main,,0,0,0,,Dövüşüp kaçıyorsun, geri dönüp yiyorsun.Dialogue: 0,0:21:54.37,0:21:56.77,Main,,0,0,0,,İnsan mı cidden o?Dialogue: 0,0:21:56.77,0:22:00.67,Main,,0,0,0,,Cracker-sama harika ama Hasır Şapka'nın iştahı da harika!Dialogue: 0,0:22:01.21,0:22:03.23,Main,,0,0,0,,Cracker-sama...Dialogue: 0,0:22:03.23,0:22:07.09,Main,,0,0,0,,Gerçekten sonsuz sayıda bisküvi yapabilir mi o?Dialogue: 0,0:22:07.09,0:22:09.05,Main,,0,0,0,,Aynen öyle-ju.Dialogue: 0,0:22:09.05,0:22:12.47,Main,,0,0,0,,Ama gücü bitmek üzere.Dialogue: 0,0:22:12.47,0:22:14.58,Main,,0,0,0,,Seninki de öyle!Dialogue: 0,0:22:14.58,0:22:19.44,Main,,0,0,0,,Çatlayana kadar ye! Sonra arkadaşından vazgeçeceksin!Dialogue: 0,0:22:19.44,0:22:21.61,Main,,0,0,0,,Vazgeçmeyeceğim!Dialogue: 0,0:22:21.61,0:22:24.78,Main,,0,0,0,,Yiyip yiyip Sanji'yi görmeye gideceğim!Dialogue: 0,0:22:26.12,0:22:30.23,Main,,0,0,0,,O zaman daha fazla Bisküvi Savaşçı yapacağım!Dialogue: 0,0:22:33.99,0:22:38.37,Main,,0,0,0,,Ye ve çatla Hasır Şapka!Dialogue: 0,0:22:40.21,0:22:42.84,Main,,0,0,0,,Sonra da...Dialogue: 0,0:22:42.84,0:22:48.16,Main,,0,0,0,,...onlara yardım ettiğinizi Mama'ya söyleyeceğim, Kingbaum!Dialogue: 0,0:22:48.16,0:22:51.39,Main,,0,0,0,,Ne?! Ama zaten başımın üstünü kestin!Dialogue: 0,0:22:51.39,0:22:54.47,Main,,0,0,0,,Bu hiç doğru değil-ju, Cracker-sama!Dialogue: 0,0:22:54.47,0:23:00.73,Main,,0,0,0,,Sadece Mama'nın Vivre Kartı sebebiyle bu kıza yardım ediyoruz-ju!Dialogue: 0,0:23:00.73,0:23:03.98,Main,,0,0,0,,Yani Mama'ya itaat ettiğimiz açık!Dialogue: 0,0:23:04.02,0:23:08.86,Main,,0,0,0,,Bahanelerinizi Mama'ya saklayın! Yoluma çıktığınız bir gerçek!Dialogue: 0,0:23:09.91,0:23:16.37,Main,,0,0,0,,O kadının yağmuru ve taktiği olmasa sert Bisküvi Savaşçılarım...Dialogue: 0,0:23:16.37,0:23:20.42,Main,,0,0,0,,...leziz ve çıtır atıştırmalıklara dönüşmezdi!Dialogue: 0,0:23:20.42,0:23:24.45,Main,,0,0,0,,Kes be! Korsan savaşı budur işte!Dialogue: 0,0:23:24.45,0:23:28.92,Main,,0,0,0,,Sırf zayıflığın ortaya çıktı diye  bizim adamlarımızı suçlama!Dialogue: 0,0:23:29.01,0:23:30.43,Main,,0,0,0,,Bizim mi?!Dialogue: 0,0:23:30.43,0:23:31.74,Main,,0,0,0,,Yoksa...Dialogue: 0,0:23:31.74,0:23:34.10,Main,,0,0,0,,O kadının adamları mıyız artık?Dialogue: 0,0:23:34.92,0:23:36.60,Main,,0,0,0,,Bir şey mi oldu?Dialogue: 0,0:23:36.60,0:23:38.60,Main,,0,0,0,,Özür dilerim!Dialogue: 0,0:23:39.77,0:23:43.01,Main,,0,0,0,,Son noktayı koyalım, Bisküvi Savaşçılar!Dialogue: 0,0:23:45.51,0:23:47.57,Main,,0,0,0,,İşte son!Dialogue: 0,0:23:49.40,0:23:53.78,Main,,0,0,0,,Tek yapabildiğim yemek. Kırsam bile eski hallerine geliyorlar.Dialogue: 0,0:23:53.78,0:23:55.27,Main,,0,0,0,,Ama...Dialogue: 0,0:23:55.27,0:23:57.70,Main,,0,0,0,,Açıkçası daha fazla yiyemem.Dialogue: 0,0:23:57.70,0:24:01.07,Main,,0,0,0,,Beni koruduğunuza emin olun Homies!Dialogue: 0,0:24:01.07,0:24:02.17,Main,,0,0,0,,T-Tamam!Dialogue: 0,0:24:02.17,0:24:06.40,Main,,0,0,0,,Nami, onları yemekten başka bir şey deneyebilir miyiz önce?Dialogue: 0,0:24:07.30,0:24:10.20,Main,,0,0,0,,Onları kırdıktan sonra tekrar oluştuklarında...Dialogue: 0,0:24:10.20,0:24:11.92,Main,,0,0,0,,Weather Egg!Dialogue: 0,0:24:10.20,0:24:11.92,Attack,,0,0,0,,Hava YumurtasıDialogue: 0,0:24:12.59,0:24:16.01,Main,,0,0,0,,Yonkou'nun neyisin bilmem ben!Dialogue: 0,0:24:17.72,0:24:20.77,Main,,0,0,0,,Ama Luffy, Korsanlar Kralı olacak kişi!Dialogue: 0,0:24:20.77,0:24:24.02,Main,,0,0,0,,Yani onun iştahının sınırı yoktur!Dialogue: 0,0:24:24.10,0:24:28.23,Main,,0,0,0,,Ne?! Nami, bir saattir yiyordum zaten!Dialogue: 0,0:24:28.23,0:24:31.76,Main,,0,0,0,,Neden bilmiyorum ama midesinin sınırı yok!Dialogue: 0,0:24:31.76,0:24:32.74,Main,,0,0,0,,Hayır...Dialogue: 0,0:24:32.74,0:24:34.74,Main,,0,0,0,,Rain Spark!Dialogue: 0,0:24:32.74,0:24:34.74,Attack,,0,0,0,,Yağmur KıvılcımıDialogue: 0,0:24:39.24,0:24:43.75,Main,,0,0,0,,Savaşçılar yine yumuşayacak! Olamaz!Dialogue: 0,0:24:44.93,0:24:46.54,Main,,0,0,0,,Hayır... Artık...Dialogue: 0,0:25:01.22,0:25:03.52,Main,,0,0,0,,Bekle beni Sanji!Dialogue: 0,0:25:03.52,0:25:05.91,Main,,0,0,0,,Ulan siz...Dialogue: 0,0:25:15.22,0:25:17.37,Main,,0,0,0,,Nasıl yiyor be?!Dialogue: 0,0:25:24.16,0:25:26.62,Captions,,0,0,0,,Germa 66Dialogue: 0,0:25:26.62,0:25:29.34,Main,,0,0,0,,Judge-sama, vakit geldi.Dialogue: 0,0:25:29.34,0:25:32.08,Main,,0,0,0,,Tüm hazırlıklar tamamlandı.Dialogue: 0,0:25:32.08,0:25:35.34,Main,,0,0,0,,Tamam, çocuklarıma söyleyin.Dialogue: 0,0:25:35.34,0:25:38.89,Main,,0,0,0,,Whole Cake Şatosu'na yola çıkıyoruz.Dialogue: 0,0:25:40.56,0:25:43.09,Main,,0,0,0,,Hazır mısın? Acıtacak.Dialogue: 0,0:25:43.09,0:25:44.48,Main,,0,0,0,,Hemen yap şunu.Dialogue: 0,0:25:46.24,0:25:48.21,Main,,0,0,0,,Biraz karıncalanıyor.Dialogue: 0,0:25:52.48,0:25:53.69,Main,,0,0,0,,Dokunma sakın.Dialogue: 0,0:25:55.74,0:25:56.86,Main,,0,0,0,,Nasıl?Dialogue: 0,0:26:03.95,0:26:05.83,Main,,0,0,0,,Şişlikler gitmiş.Dialogue: 0,0:26:06.91,0:26:09.98,Main,,0,0,0,,Sadece şişliklere yarayan bir yüz maskesi.Dialogue: 0,0:26:09.98,0:26:15.42,Main,,0,0,0,,Normal fiziksel tepkileri bastırdığı için yara daha kötü oluyor.Dialogue: 0,0:26:15.42,0:26:18.95,Main,,0,0,0,,Ama nişanlının senin şişik yüzünü görmesinden iyidir.Dialogue: 0,0:26:21.20,0:26:25.35,Main,,0,0,0,,Charlotte Ailesi üyeleri, kocalarının soyadını almaz.Dialogue: 0,0:26:25.51,0:26:28.98,Main,,0,0,0,,Bu yüzden seni aile parçaları olarak kabul ederlerse mutlu bir hayat sürersin.Dialogue: 0,0:26:29.67,0:26:31.22,Main,,0,0,0,,Ulan...Dialogue: 0,0:26:31.22,0:26:36.19,Main,,0,0,0,,Kendin döndün. Bir şey yapmamı bekleme.Dialogue: 0,0:26:36.80,0:26:38.32,Main,,0,0,0,,İkinci şansın olmayacak.Dialogue: 0,0:26:43.28,0:26:47.37,Main,,0,0,0,,Yine de o yiğitliğin nereden geldi?Dialogue: 0,0:26:52.75,0:26:57.26,Main,,0,0,0,,Kadın! Kadın! Kadın! Kadın!Dialogue: 0,0:26:57.26,0:26:58.84,Main,,0,0,0,,Kadın!Dialogue: 0,0:27:00.43,0:27:04.37,Main,,0,0,0,,Kesin be! Kadın aşçıya ihtiyacımız yok!Dialogue: 0,0:27:06.02,0:27:08.73,Main,,0,0,0,,Çenenizi kapatın!Dialogue: 0,0:27:11.02,0:27:15.02,Main,,0,0,0,,Ben insanlara tekmeleyerek bir şey öğretirim.Dialogue: 0,0:27:15.02,0:27:17.99,Main,,0,0,0,,Bir kadına karşı yapamam bunu!Dialogue: 0,0:27:17.99,0:27:22.03,Main,,0,0,0,,Neden?  Öğrenemeyen bir kadınsa tekmeyi yapıştırırsın.Dialogue: 0,0:27:22.03,0:27:24.43,Main,,0,0,0,,Aptal!Dialogue: 0,0:27:27.83,0:27:30.12,Main,,0,0,0,,Acıdı!Dialogue: 0,0:27:30.12,0:27:33.13,Main,,0,0,0,,Erkekler kadınlara tekme atmamalı!Dialogue: 0,0:27:33.13,0:27:37.05,Main,,0,0,0,,Dinozorların varlığından beri bu mantık vardır!Dialogue: 0,0:27:38.42,0:27:40.50,Main,,0,0,0,,Dinle küçük velet!Dialogue: 0,0:27:40.50,0:27:43.55,Main,,0,0,0,,Bir insan olarak istediğin kadar hata yapabilirsin.Dialogue: 0,0:27:43.55,0:27:47.18,Main,,0,0,0,,Ama erkeklik onuruna ihanet edersen...Dialogue: 0,0:27:47.18,0:27:51.56,Main,,0,0,0,,...erkekliğini kökünden keser ve sonra başımı keserim!Dialogue: 0,0:27:51.60,0:27:54.86,Main,,0,0,0,,Ne?! Neden kendini kesiyorsun?!Dialogue: 0,0:27:58.36,0:28:01.15,Main,,0,0,0,,Ebeveynlerin ödemesi gereken bedel budur.Dialogue: 0,0:28:03.24,0:28:07.37,Main,,0,0,0,,Aptal. Nefret ettiğim birisi olma.Dialogue: 0,0:28:10.80,0:28:13.54,Main,,0,0,0,,Şimdi işine geri dön.Dialogue: 0,0:28:17.53,0:28:20.28,Main,,0,0,0,,Dinozorlar çağından kalma bir gelenek.Dialogue: 0,0:28:32.27,0:28:34.73,Main,,0,0,0,,Sanji-sama, gitme vakti geldi.Dialogue: 0,0:28:34.73,0:28:39.07,Main,,0,0,0,,Whole Cake Şatosu'nda düğün töreniniz olacak.Dialogue: 0,0:28:45.24,0:28:46.86,Main,,0,0,0,,Şunu giy.Dialogue: 0,0:28:46.86,0:28:50.24,Main,,0,0,0,,Sen Vinskome krallık ailesi üyesisin.Dialogue: 0,0:28:50.29,0:28:53.65,Main,,0,0,0,,Buna uygun görünmelisin.Dialogue: 0,0:28:53.65,0:28:55.38,Main,,0,0,0,,Saçmalık.Dialogue: 0,0:29:06.44,0:29:10.64,Captions,,0,0,0,,Brûlée'nin Ayna DünyasıDialogue: 0,0:29:07.01,0:29:10.64,Narrator,,0,0,0,,Aynı sırada Brûlée'nin Ayna Dünyası'nda...Dialogue: 0,0:29:10.64,0:29:13.77,Main,,0,0,0,,Buldum sizi!Dialogue: 0,0:29:15.94,0:29:19.27,Main,,0,0,0,,Döndü!Dialogue: 0,0:29:21.26,0:29:23.40,Main,,0,0,0,,Kaçamazsınız!Dialogue: 0,0:29:32.79,0:29:35.80,Main,,0,0,0,,Daha fazla koşamayacağım Choniki!Dialogue: 0,0:29:37.46,0:29:40.67,Main,,0,0,0,,Ayna içinde koşuşturmayı kesin!Dialogue: 0,0:29:48.15,0:29:50.69,Main,,0,0,0,,İyi düğünler!Dialogue: 0,0:29:54.14,0:29:56.65,Main,,0,0,0,,Tebrikler!Dialogue: 0,0:29:56.65,0:29:58.60,Main,,0,0,0,,Sanji-sama!Dialogue: 0,0:30:02.57,0:30:06.49,Main,,0,0,0,,Bugün Vinsmoke'lar yeni bir başlangıç yapacak.Dialogue: 0,0:30:15.12,0:30:17.96,Main,,0,0,0,,Sanji-sama!Dialogue: 0,0:30:17.96,0:30:21.59,Main,,0,0,0,,Vatandaşlara el salla Sanji.Dialogue: 0,0:30:39.31,0:30:41.73,Flashbacks,,0,0,0,,Gidelim çocuklar!Dialogue: 0,0:31:01.01,0:31:03.56,Main,,0,0,0,,Yetti artık size!Dialogue: 0,0:31:03.56,0:31:06.55,Main,,0,0,0,,Daha fazla yiyemem dedim!Dialogue: 0,0:31:08.53,0:31:09.93,Main,,0,0,0,,Sınırına ulaştın mı?!Dialogue: 0,0:31:09.93,0:31:15.43,Main,,0,0,0,,Yediklerimi asla çıkarmayacağım!Dialogue: 0,0:31:17.64,0:31:23.15,Main,,0,0,0,,Öyleyse karnına saplayayım da işin kolaylaşsın!Dialogue: 0,0:31:23.15,0:31:24.66,Main,,0,0,0,,Dikkat et Luffy!Dialogue: 0,0:31:25.61,0:31:28.28,Main,,0,0,0,,Öyleyse buna bir son vereceğim!Dialogue: 0,0:31:28.28,0:31:30.68,Main,,0,0,0,,Kinniku Fuusen!Dialogue: 0,0:31:28.28,0:31:30.68,Attack,,0,0,0,,Kas BalonuDialogue: 0,0:31:53.09,0:31:54.30,Main,,0,0,0,,Ne?!Dialogue: 0,0:32:15.28,0:32:17.58,Main,,0,0,0,,Gear Fourth!Dialogue: 0,0:32:15.28,0:32:17.58,Attack,,0,0,0,,Dördüncü VitesDialogue: 0,0:32:23.17,0:32:28.00,Main,,0,0,0,,Tankman: Manpuku Version!Dialogue: 0,0:32:23.17,0:32:28.00,Attack,,0,0,0,,Tank Adam: Dolu VersiyonDialogue: 0,0:32:30.38,0:32:32.17,Main,,0,0,0,,Ne oldu? Kocaman!Dialogue: 0,0:32:39.29,0:32:43.48,Main,,0,0,0,,İlk dönüşümünden çok farklı görünüyorsun.Dialogue: 0,0:32:43.48,0:32:47.02,Main,,0,0,0,,O kocaman bedeninle dövüşebilir misin?!Dialogue: 0,0:32:52.32,0:32:55.61,Main,,0,0,0,,Cracker-sama'nın kılıcı kesemedi!Dialogue: 0,0:32:55.61,0:32:57.16,Main,,0,0,0,,Ne kadar sert bu?!Dialogue: 0,0:32:58.99,0:33:02.75,Main,,0,0,0,,Seni burnu havada lanet velet!Dialogue: 0,0:33:05.43,0:33:08.55,Main,,0,0,0,,Şansını zorlama.Dialogue: 0,0:33:09.36,0:33:12.47,Main,,0,0,0,,Hasır Şapka!Dialogue: 0,0:33:12.47,0:33:16.39,Main,,0,0,0,,Seni kesemiyorsam sokarım ben de!Dialogue: 0,0:33:16.39,0:33:17.69,Main,,0,0,0,,Honey...Dialogue: 0,0:33:16.39,0:33:17.69,Attack,,0,0,0,,Ballı...Dialogue: 0,0:33:19.05,0:33:20.60,Main,,0,0,0,,...Pretzel!Dialogue: 0,0:33:24.76,0:33:26.02,Main,,0,0,0,,Daha değil!Dialogue: 0,0:33:26.02,0:33:28.98,Main,,0,0,0,,Bu saldırıyla alev alacaksın!Dialogue: 0,0:33:31.44,0:33:34.65,Main,,0,0,0,,Crush Pretzel!Dialogue: 0,0:33:31.44,0:33:34.65,Attack,,0,0,0,,Ezici PretzelDialogue: 0,0:33:43.54,0:33:45.29,Main,,0,0,0,,Luffy!Dialogue: 0,0:33:53.26,0:33:56.76,Main,,0,0,0,,Bu da ne?! Sert mi yumuşak mı?Dialogue: 0,0:33:59.05,0:34:02.26,Main,,0,0,0,,B-Bu da ne böyle?!Dialogue: 0,0:34:04.43,0:34:05.98,Main,,0,0,0,,Bisküvi Savaşçılar!Dialogue: 0,0:34:07.48,0:34:09.90,Main,,0,0,0,,- Yağmur... - Nami!Dialogue: 0,0:34:09.90,0:34:14.86,Main,,0,0,0,,Kalan bisküvileri ıslatma! Sert kalabilirler!Dialogue: 0,0:34:14.86,0:34:16.45,Main,,0,0,0,,Tamam!Dialogue: 0,0:34:26.96,0:34:30.50,Main,,0,0,0,,Çıkamıyorum! Ne yapacak bu?!Dialogue: 0,0:34:30.54,0:34:33.78,Main,,0,0,0,,Tokluğun gücünü göstereceğim sana!Dialogue: 0,0:34:34.76,0:34:37.42,Main,,0,0,0,,Gomu Gomu no...Dialogue: 0,0:34:59.99,0:35:02.76,Main,,0,0,0,,...Cannon Ball!Dialogue: 0,0:34:59.99,0:35:02.76,Attack,,0,0,0,,...Gülle TopuDialogue: 0,0:34:52.19,0:34:55.46,Main,,0,0,0,,Yeni Dünya'nın sonuna dek...Dialogue: 0,0:34:55.46,0:34:58.40,Main,,0,0,0,,...uç!Dialogue: 0,0:35:40.74,0:35:45.70,Credits,,0,0,0,,Editing:  Feeso, Galaxy 9000  Timing: Halee  Quality Assurance: Feeso, Galaxy 9000, Grug, Pepperjack  Soundtracking:  Halee  Infoboxes & Title:  Datenshi  Karaoke: KaitouYahiko  Translation: CrunchyrollDialogue: 0,0:00:00.82,0:00:06.82,Lyrics,,0,0,0,karaoke,♪ Görmedim dünyanın sonunu kendi gözlerimle hiç. ♪Dialogue: 0,0:00:06.82,0:00:13.95,Lyrics,,0,0,0,karaoke,♪ O yüzden çıktım yola sizinle, bunu yapmak için! ♪Dialogue: 0,0:00:23.67,0:00:27.00,Lyrics,,0,0,0,karaoke,♪ Bir denizden diğerine yol alırken,...Dialogue: 0,0:00:29.06,0:00:31.91,Lyrics,,0,0,0,karaoke,...bunun sadece bir peri masalı olduğunu söylemek. ♪Dialogue: 0,0:00:31.92,0:00:38.78,Lyrics,,0,0,0,karaoke,♪ Gerçek, kurgudan daha tuhaf değil mi? ♪Dialogue: 0,0:00:39.94,0:00:43.56,Lyrics,,0,0,0,karaoke,♪ Fakat sırt çevirme hiçbirine ♪Dialogue: 0,0:00:43.56,0:00:50.04,Lyrics,,0,0,0,karaoke,♪ Sağduyu dedikleri zihnidir toplulukların! ♪Dialogue: 0,0:00:51.36,0:00:57.41,Lyrics,,0,0,0,karaoke,♪ Görmedim dünyanın sonunu kendi gözlerimle hiç. ♪Dialogue: 0,0:00:57.41,0:01:01.96,Lyrics,,0,0,0,karaoke,♪ O yüzden gitmemiz lazım Kaptan Özgür-Ruh! ♪Dialogue: 0,0:01:01.96,0:01:04.72,Lyrics,,0,0,0,karaoke,♪ Kim demiş imkansız diye,...Dialogue: 0,0:01:04.71,0:01:07.89,Lyrics,,0,0,0,karaoke,...daha hiçbir şey başlamadan! ♪Dialogue: 0,0:01:07.88,0:01:12.72,Lyrics,,0,0,0,karaoke,♪ Her şeyi bilmek istiyorum ve şimdi bilebiliriz de... ♪Dialogue: 0,0:01:12.72,0:01:18.68,Lyrics,,0,0,0,karaoke,♪ Bilebiliriz, bilebilirsin! Şu anda... ♪Dialogue: 0,0:01:19.06,0:01:24.10,Lyrics,,0,0,0,karaoke,♪ Bilebiliriz, bilebilirim! Bu harika hissi... ♪Dialogue: 0,0:01:24.39,0:01:31.32,Lyrics,,0,0,0,karaoke,♪ Hemen, şimdi, bilebiliriz! ♪Dialogue: 0,0:01:37.34,0:01:38.64,Lyrics,,0,0,0,karaoke,♪ Evet, bilebiliriz! ♪