2.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.7,0.7,9,10,10,10,1Style: Attack,Duality,30.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.0,1.0,7,12,12,12,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:01:38.15,0:01:42.54,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - dmc3 thx to onepace.netDialogue: 0,0:18:07.70,0:18:14.70,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - dmc3 thx to onepace.netDialogue: 0,0:37:43.35,0:37:46.10,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - dmc3 thx to onepace.netDialogue: 0,0:01:38.15,0:01:42.54,Title,,0,0,250,,Bilinmeyen MamaDialogue: 0,0:01:45.71,0:01:48.59,Main,,0,0,0,,Kokuşmuş sıçan!Dialogue: 0,0:01:51.42,0:01:53.30,Main,,0,0,0,,İş başına Cin!Dialogue: 0,0:01:55.79,0:01:59.81,Main,,0,0,0,,Dileğiniz nedir efendim?Dialogue: 0,0:01:59.81,0:02:03.61,Main,,0,0,0,,Adi sıçanı parçalara ayır!Dialogue: 0,0:02:05.60,0:02:07.07,Main,,0,0,0,,Sana...Dialogue: 0,0:02:07.07,0:02:09.78,Main,,0,0,0,,...okkalı bir ders vereceğim!Dialogue: 0,0:02:19.74,0:02:23.54,Main,,0,0,0,,Daifuku-sama! Biz de arada kaynıyoruz!Dialogue: 0,0:02:24.41,0:02:27.71,Main,,0,0,0,,Nereyi nişan alıyorsun Cin Bey?Dialogue: 0,0:02:29.33,0:02:30.51,Main,,0,0,0,,Kaçamazsın!Dialogue: 0,0:02:30.51,0:02:31.93,Main,,0,0,0,,Böyle gel!Dialogue: 0,0:02:37.09,0:02:39.02,Main,,0,0,0,,Asfalyalarım attı!Dialogue: 0,0:02:39.02,0:02:41.27,Main,,0,0,0,,Maji Giren!Dialogue: 0,0:02:39.02,0:02:41.27,Attack,,0,0,0,,İfrit KesişiDialogue: 0,0:02:43.72,0:02:46.86,Main,,0,0,0,,Durun lütfen Daifuku-sama!Dialogue: 0,0:02:46.86,0:02:48.40,Main,,0,0,0,,Yere batasıca!Dialogue: 0,0:02:50.56,0:02:53.74,Main,,0,0,0,,Pis sıçan bir dümen daha kırmış!Dialogue: 0,0:02:53.74,0:02:56.91,Main,,0,0,0,,Cingöz bir tavşancığa çattık!Dialogue: 0,0:03:01.53,0:03:05.58,Main,,0,0,0,,Bir gemiden diğerine geçerek düşmanı birbirine kırdırıyor!Dialogue: 0,0:03:05.58,0:03:07.92,Main,,0,0,0,,Çok etkileyici!Dialogue: 0,0:03:07.92,0:03:11.97,Main,,0,0,0,,Di' mi ama? Etkileyici, di' mi? Küçük kardeşim gibidir!Dialogue: 0,0:03:11.97,0:03:15.98,Main,,0,0,0,,Ay'ın evresi ve hava koşulları onların lehine olduğunda...Dialogue: 0,0:03:15.98,0:03:18.56,Main,,0,0,0,,...ziyadesiyle güçlü savaşçılar olurlar.Dialogue: 0,0:03:18.56,0:03:20.93,Main,,0,0,0,,Ay evresi ile hava koşulları mı?Dialogue: 0,0:03:20.93,0:03:22.46,Main,,0,0,0,,Evet.Dialogue: 0,0:03:23.17,0:03:29.99,Main,,0,0,0,,Dolunaylı bir gecede açık semadaki Ay'a baktıklarında...Dialogue: 0,0:03:29.99,0:03:36.04,Main,,0,0,0,,...Minkler'in hafızalarında yatan vahşi doğalarının uyandığı rivayet edilir.Dialogue: 0,0:03:36.04,0:03:39.95,Main,,0,0,0,,Beyazlar içindeki yırtıcı eşkâllerine...Dialogue: 0,0:03:39.95,0:03:43.83,Main,,0,0,0,,...Dolunay Aslanı, yani Sulong denir!Dialogue: 0,0:03:43.83,0:03:45.12,Main,,0,0,0,,Sulong mu?Dialogue: 0,0:03:45.12,0:03:50.60,Main,,0,0,0,,Dönüşümleri esasen bilinçlerini yitirip önüne gelene saldırmalarına...Dialogue: 0,0:03:50.60,0:03:52.83,Main,,0,0,0,,...neden olduğu için bayağı sıkıntı yaratır.Dialogue: 0,0:03:52.83,0:03:56.75,Main,,0,0,0,,Hem etrafındakiler hem de kendileri için.Dialogue: 0,0:03:56.75,0:04:00.43,Main,,0,0,0,,Kendileri için mi? Nasıl yani?Dialogue: 0,0:04:00.43,0:04:06.48,Main,,0,0,0,,Minkler bu doğalarını dize getiremezlerse tek gecelik bir savaşta kendilerini tüketip...Dialogue: 0,0:04:06.48,0:04:08.63,Main,,0,0,0,,...ölürler.Dialogue: 0,0:04:08.63,0:04:09.64,Main,,0,0,0,,Ne?Dialogue: 0,0:04:09.64,0:04:10.86,Main,,0,0,0,,Ölürler mi?Dialogue: 0,0:04:10.86,0:04:16.70,Main,,0,0,0,,İki ucu keskin kılıç yani. Hayatlarına mal olan bir savaş biçimi.Dialogue: 0,0:04:17.90,0:04:23.12,Main,,0,0,0,,Carrot-san...  Dümenlerini sökmekle ne iyi düşündün ya!Dialogue: 0,0:04:25.69,0:04:31.09,Main,,0,0,0,,Bu iş göğüs göğüse muharebeye dönüşmeden ona destek çıkacağım!Dialogue: 0,0:04:31.09,0:04:32.53,Main,,0,0,0,,Destek mi çıkacaksın?Dialogue: 0,0:04:32.53,0:04:34.47,Main,,0,0,0,,Denize düşersin ama!Dialogue: 0,0:04:35.66,0:04:38.68,Main,,0,0,0,,Gönlünüzü ferah tutun.Dialogue: 0,0:04:45.01,0:04:48.57,Main,,0,0,0,,Doğru ya! Su yüzeyinde koşabiliyordu!Dialogue: 0,0:04:48.57,0:04:49.90,Main,,0,0,0,,Tüy gibi ne de olsa!Dialogue: 0,0:04:53.01,0:04:58.52,Main,,0,0,0,,Pruva istikametini emniyete almayı onlara bırakıp tam sürat ilerleyelim!Dialogue: 0,0:04:58.52,0:04:59.68,Main,,0,0,0,,Tamamdır!Dialogue: 0,0:04:58.52,0:04:59.68,Secondary,,0,0,0,,Peki!Dialogue: 0,0:04:59.68,0:05:02.45,Main,,0,0,0,,Kaçmayın lan!Dialogue: 0,0:05:13.61,0:05:15.61,Main,,0,0,0,,İskeleye kır!Dialogue: 0,0:05:16.32,0:05:18.20,Main,,0,0,0,,Sancak tarafı!Dialogue: 0,0:05:21.45,0:05:24.87,Main,,0,0,0,,Sümüklü böcekcik!Dialogue: 0,0:05:44.37,0:05:46.93,Main,,0,0,0,,Prometheus...Dialogue: 0,0:05:47.66,0:05:49.98,Main,,0,0,0,,Zeus...Dialogue: 0,0:05:49.98,0:05:51.68,Main,,0,0,0,,Mama?Dialogue: 0,0:05:52.74,0:05:54.78,Main,,0,0,0,,Peros abi!Dialogue: 0,0:05:54.78,0:05:56.33,Main,,0,0,0,,Mama bir tuhaf davranıyor!Dialogue: 0,0:05:56.33,0:05:59.51,Main,,0,0,0,,Bilmez miyim!Dialogue: 0,0:05:59.51,0:06:02.49,Main,,0,0,0,,Epey kilo verdi, soluk alışı da bir garipleşti!Dialogue: 0,0:06:06.57,0:06:10.99,Main,,0,0,0,,Prometheus... Zeus...Dialogue: 0,0:06:10.99,0:06:15.08,Main,,0,0,0,,Napoleon! Zeus ile Prometheus'a ne oldu?Dialogue: 0,0:06:15.08,0:06:16.88,Main,,0,0,0,,Hemen çağırıyorum!Dialogue: 0,0:06:16.88,0:06:22.13,Main,,0,0,0,,Açlık Krizi nüksedeli  neredeyse 8 saat olacak!Dialogue: 0,0:06:22.47,0:06:26.58,Main,,0,0,0,,Bastırmamız hiç bu kadar uzun sürmediğinden...Dialogue: 0,0:06:26.58,0:06:29.62,Main,,0,0,0,,...karnının bu denli kazındığına tanık olmamıştık.Dialogue: 0,0:06:31.22,0:06:37.91,Main,,0,0,0,,Ne hâllere gireceğini biz bile kestiremiyoruz.Dialogue: 0,0:06:37.91,0:06:42.66,Main,,0,0,0,,Ne idiği belirsiz bir canavardan farksız artık-perorin.Dialogue: 0,0:06:42.66,0:06:46.54,Main,,0,0,0,,Kakao Adası'na kadar dayanabilecek mi?Dialogue: 0,0:06:46.54,0:06:49.31,Main,,0,0,0,,Bu arada Peros abi...Dialogue: 0,0:06:49.31,0:06:54.42,Main,,0,0,0,,...Pudding'in an itibariyle pastayı buraya getirdiğine dair haber aldım!Dialogue: 0,0:06:54.42,0:06:58.55,Main,,0,0,0,,Cidden mi? Postumuzu kurtaracak desene!Dialogue: 0,0:06:58.55,0:07:02.20,Main,,0,0,0,,Bir pürüz var ama abi!Dialogue: 0,0:07:02.20,0:07:06.27,Main,,0,0,0,,Pastayı getiren hiç şüphesiz Pudding'miş de...Dialogue: 0,0:07:06.27,0:07:09.65,Main,,0,0,0,,...dedikleri kadarıyla Bege'nin gemisindelermiş.Dialogue: 0,0:07:10.18,0:07:12.90,Main,,0,0,0,,Bege mi dedin?Dialogue: 0,0:07:12.90,0:07:18.55,Main,,0,0,0,,Ülkemizi kurtaracak olan pasta suikastçıların gemisinde ne arıyor lan?Dialogue: 0,0:07:18.55,0:07:20.15,Main,,0,0,0,,B- Bilmiyorum!Dialogue: 0,0:07:20.15,0:07:22.95,Main,,0,0,0,,Ne demek bilmiyorum lan!Dialogue: 0,0:07:22.95,0:07:29.54,Main,,0,0,0,,N'apacağız şimdi?  O pastaya güven olmaz ki artık!Dialogue: 0,0:07:26.11,0:07:29.54,Captions,,0,0,0,,Bölge Suları - Bege'nin GemisiDialogue: 0,0:07:49.18,0:07:51.39,Main,,0,0,0,,N'apıyorsun lan Kara Bacak!Dialogue: 0,0:07:51.39,0:07:54.50,Main,,0,0,0,,Onu benim demem lazım lan! Başlarım yapacağın işe!Dialogue: 0,0:07:54.50,0:07:59.44,Main,,0,0,0,,Ölürüm de pastaya zehir koymana izin vermem!Dialogue: 0,0:07:59.44,0:08:03.80,Main,,0,0,0,,Bu pasta hiç şüphesiz Big Mom'ın midesine girecek!Dialogue: 0,0:08:03.80,0:08:09.11,Main,,0,0,0,,Bunu bildiği hâlde nasıl bir andaval zehir ya da patlayıcı koymaz ki!Dialogue: 0,0:08:09.11,0:08:12.72,Main,,0,0,0,,Yonkou'lardan birini ortadan kaldıracağız işte!Dialogue: 0,0:08:12.72,0:08:16.25,Main,,0,0,0,,Ayağımıza gelen fırsatı göremiyor musun oğlum?Dialogue: 0,0:08:16.25,0:08:20.90,Main,,0,0,0,,Kes sesini! Aşçılık gururumuzu ortaya koyduğumuz bir meydan okumanın içindeyiz!Dialogue: 0,0:08:20.90,0:08:24.71,Main,,0,0,0,,Sikko işlere yeltenme! Düşmanı lezzetle alt edeceğiz!Dialogue: 0,0:08:24.71,0:08:27.34,Main,,0,0,0,,Ha! Aç oğlum gözlerini!Dialogue: 0,0:08:27.34,0:08:32.91,Main,,0,0,0,,Bugüne değin dünyanın dört bir yanındaki envaiçeşit leziz tatlıları yemiş Big Mom'ı...Dialogue: 0,0:08:32.91,0:08:36.64,Main,,0,0,0,,...dumura uğratacak lezzette bir pasta yapmanız gerekiyor!Dialogue: 0,0:08:37.34,0:08:38.98,Main,,0,0,0,,Bu da mümkün değil!Dialogue: 0,0:08:38.98,0:08:44.11,Main,,0,0,0,,Ha şunu bileydin! Çuvallarsak da ölürüz!Dialogue: 0,0:08:44.11,0:08:46.23,Main,,0,0,0,,İple çekiyorum!Dialogue: 0,0:08:46.23,0:08:51.08,Main,,0,0,0,,Lan hadi başardınız diyelim, kadın bizi sağ bırakmaz ki!Dialogue: 0,0:08:51.08,0:08:53.09,Main,,0,0,0,,Kafa şişirme lan!Dialogue: 0,0:08:53.09,0:08:57.68,Main,,0,0,0,,Big Mom'ın evvelinde nasıl biri olduğunu bilmiyorsunuz galiba!Dialogue: 0,0:08:57.68,0:09:03.20,Main,,0,0,0,,Buraya yazıyorum bak, elimize fırsat geçmişken değerlendirmediğimiz için--Dialogue: 0,0:09:14.76,0:09:16.44,Main,,0,0,0,,Baba!Dialogue: 0,0:09:16.44,0:09:18.80,Main,,0,0,0,,Baba'mıza ne yaptın lan!Dialogue: 0,0:09:18.80,0:09:20.02,Main,,0,0,0,,Kara Bacak!Dialogue: 0,0:09:20.02,0:09:23.94,Main,,0,0,0,,Baba'mızın ağzına ne sokuşturdun lan?Dialogue: 0,0:09:23.94,0:09:25.89,Main,,0,0,0,,Kendisine sorun.Dialogue: 0,0:09:28.21,0:09:32.14,Main,,0,0,0,,Bu kremşanti öyle lezizdi ki canımı alacaktı ha!Dialogue: 0,0:09:32.14,0:09:35.77,Main,,0,0,0,,Ne?  Kremşantinin lezizliğinden mi ölecekti yani?Dialogue: 0,0:09:35.77,0:09:38.02,Main,,0,0,0,,Baba, neyse ki bir şeyin yok-rero!Dialogue: 0,0:09:38.02,0:09:40.67,Main,,0,0,0,,Diyeceklerime kulak ver Bege.Dialogue: 0,0:09:42.86,0:09:46.55,Main,,0,0,0,,Suikast düzenlemene karışmam...Dialogue: 0,0:09:46.55,0:09:52.14,Main,,0,0,0,,...ama konuğumu memnun edene dek bekleyeceksin!Dialogue: 0,0:09:52.14,0:09:57.48,Main,,0,0,0,,Karnı aç olan herkesi doyururum! Aşçıların boynunun borcudur bu!Dialogue: 0,0:10:02.80,0:10:04.00,Main,,0,0,0,,Pudding-sama!Dialogue: 0,0:10:04.00,0:10:05.90,Main,,0,0,0,,Siz neden bayılıyorsunuz ki?Dialogue: 0,0:10:05.90,0:10:11.14,Main,,0,0,0,,Bege! Ben de uzun aranın ardından ilk kez aşçılığımı konuşturdum!Dialogue: 0,0:10:11.14,0:10:13.95,Main,,0,0,0,,Tatlıların gücüne inan lütfen!Dialogue: 0,0:10:13.95,0:10:19.38,Main,,0,0,0,,Sıçayım abi ya... Hiptonize falan oldum sanki!Dialogue: 0,0:10:20.63,0:10:25.05,Thoughts,,0,0,0,,Bu pasta Big Mom'a da tesir eder belki.Dialogue: 0,0:10:25.05,0:10:28.02,Main,,0,0,0,,Tamam... Anladım...Dialogue: 0,0:10:29.35,0:10:32.82,Main,,0,0,0,,Elimizi çabuk tutalım! Kremşanti kaplamasını bitirdik mi?Dialogue: 0,0:10:32.82,0:10:34.74,Main,,0,0,0,,Bitmek üzere!Dialogue: 0,0:10:36.45,0:10:40.54,Main,,0,0,0,,Chiffon-sama!  İki şefimiz pastanın kokusundan bayılıverdi!Dialogue: 0,0:10:40.54,0:10:43.84,Main,,0,0,0,,Millet!  Pasta bitene değin kendinizi kaybetmeyin!Dialogue: 0,0:10:43.84,0:10:45.09,Main,,0,0,0,,Emredersiniz!Dialogue: 0,0:10:46.32,0:10:51.71,Thoughts,,0,0,0,,N'olur bir şeyin olmasın... Nami-san, geliyorum!Dialogue: 0,0:10:52.61,0:10:57.83,Main,,0,0,0,,Çabuk ya! Çabuk!Dialogue: 0,0:10:52.71,0:10:57.83,Captions,,0,0,0,,Bölge Suları - Prometheus ve ZeusDialogue: 0,0:10:57.83,0:10:58.88,Main,,0,0,0,,Hangi tarafa?Dialogue: 0,0:10:58.88,0:11:00.23,Main,,0,0,0,,Dümdüz!Dialogue: 0,0:11:00.23,0:11:02.92,Main,,0,0,0,,Napoleon'un sinyalini alıyorum!Dialogue: 0,0:11:02.92,0:11:08.15,Main,,0,0,0,,Bir yangını yiyeceksin diye o kadar yolu geri gittik Prometheus!Dialogue: 0,0:11:08.15,0:11:12.39,Main,,0,0,0,,Beni o kadar yaralayan kimdi acaba Zeus?Dialogue: 0,0:11:12.93,0:11:16.92,Main,,0,0,0,,Kadın düşmanın oyuncağı oldun!Dialogue: 0,0:11:16.93,0:11:22.51,Main,,0,0,0,,Doğrudan Mama'nın ruhundan hayat bulmuş müstesna Homies oluyoruz!Dialogue: 0,0:11:22.51,0:11:26.61,Main,,0,0,0,,Zıkkımlanacaksın diye bir daha Mama'ya ihanet edersen elimde kalırsın!Dialogue: 0,0:11:26.61,0:11:31.42,Main,,0,0,0,,Özür dilerim ya... Ama fırtına bulutlarının tadı ne güzeldi ya!Dialogue: 0,0:11:31.42,0:11:34.03,Main,,0,0,0,,Cidden dediğimi anlıyor musun lan?Dialogue: 0,0:11:34.03,0:11:35.94,Main,,0,0,0,,Dalgaların insafındayız!Dialogue: 0,0:11:35.94,0:11:37.41,Main,,0,0,0,,Sürükleniyoruz!Dialogue: 0,0:11:42.94,0:11:44.59,Captions,,0,0,0,,Bölge Suları - SunnyDialogue: 0,0:11:44.59,0:11:46.30,Main,,0,0,0,,Rotamız açılıyor!Dialogue: 0,0:11:46.30,0:11:48.72,Main,,0,0,0,,Bu gidişle düşman saflarını yarabiliriz!Dialogue: 0,0:11:48.72,0:11:50.61,Main,,0,0,0,,Carrot müthişmiş ya!Dialogue: 0,0:11:50.61,0:11:54.45,Main,,0,0,0,,Chopper! Biz de gemiyi korumalıyız!Dialogue: 0,0:11:54.45,0:11:55.31,Main,,0,0,0,,Tamamdır!Dialogue: 0,0:11:58.34,0:12:00.56,Main,,0,0,0,,Sıçtık, dönüyorlar!Dialogue: 0,0:12:13.22,0:12:16.59,Main,,0,0,0,,Carrot-san, harikuladesin!Dialogue: 0,0:12:16.59,0:12:19.60,Main,,0,0,0,,Hey! İskelet denizde koşuyor ya lan!Dialogue: 0,0:12:20.19,0:12:21.73,Main,,0,0,0,,İndirin gitsin!Dialogue: 0,0:12:21.73,0:12:25.07,Main,,0,0,0,,Ben de gölgesinde kalamam!Dialogue: 0,0:12:26.00,0:12:28.14,Main,,0,0,0,,Ateş! Ateş edin!Dialogue: 0,0:12:53.86,0:12:57.87,Thoughts,,0,0,0,,Bilincimi kaybediyorum! Bu formumdan çıkmam gerekiyor.Dialogue: 0,0:12:57.87,0:12:59.43,Thoughts,,0,0,0,,Kaç gemi kaldı?Dialogue: 0,0:12:59.43,0:13:01.22,Main,,0,0,0,,Kokuşmuş tavşancık!Dialogue: 0,0:13:01.22,0:13:03.52,Main,,0,0,0,,Maji Giren!Dialogue: 0,0:13:01.22,0:13:03.52,Attack,,0,0,0,,İfrit KesişiDialogue: 0,0:13:05.76,0:13:07.49,Main,,0,0,0,,Onun-teia da büyük yardımı dokunuyor!Dialogue: 0,0:13:07.49,0:13:09.35,Main,,0,0,0,,Bu sefer elimden kaçamayacak!Dialogue: 0,0:13:37.91,0:13:39.08,Main,,0,0,0,,Majin...!Dialogue: 0,0:13:37.91,0:13:39.08,Attack,,0,0,0,,İfrit...Dialogue: 0,0:13:40.16,0:13:41.45,Main,,0,0,0,,Carrot-san!Dialogue: 0,0:13:43.50,0:13:45.33,Main,,0,0,0,,Saidan!Dialogue: 0,0:13:43.50,0:13:45.33,Attack,,0,0,0,,DoğrayışıDialogue: 0,0:13:47.63,0:13:50.59,Main,,0,0,0,,Geber küçük sürtük!Dialogue: 0,0:13:50.59,0:13:53.17,Thoughts,,0,0,0,,Üzgünüm Pedro...Dialogue: 0,0:14:06.05,0:14:08.03,Main,,0,0,0,,Baron Ceset!Dialogue: 0,0:14:08.03,0:14:10.04,Main,,0,0,0,,Neyse ki zarar görmemişsin.Dialogue: 0,0:14:10.04,0:14:14.44,Main,,0,0,0,,Naçizane yeteneklerimi zorlayarak diğer gemidekileri uyuttum!Dialogue: 0,0:14:14.44,0:14:18.02,Main,,0,0,0,,Fazlasıyla katkı sağladın. Dönelim haydi!Dialogue: 0,0:14:20.39,0:14:22.92,Main,,0,0,0,,Beni kurtardın! Teşekkür ederim!Dialogue: 0,0:14:22.92,0:14:24.40,Main,,0,0,0,,Biz teşekkür ederiz.Dialogue: 0,0:14:24.40,0:14:27.42,Main,,0,0,0,,Eski hâline nasıl döneceksin peki?Dialogue: 0,0:14:27.42,0:14:31.86,Main,,0,0,0,,Gözlerimi mehtaptan sakınarak dönebilirim.Dialogue: 0,0:14:32.60,0:14:39.04,Main,,0,0,0,,Şapka da olur gözlük de... Hatta gözlerimi de kapayabilirim.Dialogue: 0,0:14:39.04,0:14:43.47,Main,,0,0,0,,Dolunayın parıltısı bizi neşelendiriyor.Dialogue: 0,0:14:43.47,0:14:46.21,Main,,0,0,0,,Gözlerimize ziyafet verdin resmen!Dialogue: 0,0:14:50.60,0:14:53.06,Main,,0,0,0,,Carrot... İyi misin?Dialogue: 0,0:14:54.26,0:14:55.06,Main,,0,0,0,,İyiyim.Dialogue: 0,0:14:55.06,0:14:59.81,Main,,0,0,0,,Teşekkürler!  Sayende bir çıkmazdan kurtulmasını bildik!Dialogue: 0,0:14:59.81,0:15:03.94,Main,,0,0,0,,Abluka altına alınmıştık, gemimiz de alabora olmak üzereydi!Dialogue: 0,0:15:05.72,0:15:08.38,Main,,0,0,0,,Yardımım dokunduğuna sevindim.Dialogue: 0,0:15:08.38,0:15:12.66,Main,,0,0,0,,Ay'ı göremeyeceğim bir kamarada dinlenebilir miyim?Dialogue: 0,0:15:13.33,0:15:18.27,Main,,0,0,0,,Tabii ki!  Gerisini bize bırakıp dinlenmene bak!Dialogue: 0,0:15:21.54,0:15:25.19,Main,,0,0,0,,Peros abi! Daifuku abi artık muharebeye giremez!Dialogue: 0,0:15:25.19,0:15:27.38,Main,,0,0,0,,Filosu sürükleniyor!Dialogue: 0,0:15:27.38,0:15:31.29,Main,,0,0,0,,Daifuku da bir boka yaramıyor be!Dialogue: 0,0:15:34.28,0:15:37.55,Main,,0,0,0,,Mama... Sen iyi misin ya?Dialogue: 0,0:15:43.04,0:15:44.34,Main,,0,0,0,,Gelmişler.Dialogue: 0,0:15:44.34,0:15:46.31,Main,,0,0,0,,Geliyorlar Mama!Dialogue: 0,0:15:47.89,0:15:49.94,Main,,0,0,0,,Zeus! Prometheus!Dialogue: 0,0:15:49.94,0:15:52.48,Main,,0,0,0,,Yettik Mama!Dialogue: 0,0:15:57.15,0:15:59.37,Main,,0,0,0,,M- Mama! Bambaşka birine dönüşmüş sanki.Dialogue: 0,0:15:59.37,0:16:03.54,Main,,0,0,0,,Ne biçim bir çevikliktir bu? Karnı kazındığından dolayı mı böyle?Dialogue: 0,0:16:05.46,0:16:11.54,Main,,0,0,0,,Mama'yı bu denli çevik görüşümden bu yana kaç yıl geçmiştir ki?Dialogue: 0,0:16:12.41,0:16:16.01,Main,,0,0,0,,Düğün pastamı verin!Dialogue: 0,0:16:16.01,0:16:18.66,Main,,0,0,0,,Big Mom ensemizde!Dialogue: 0,0:16:21.38,0:16:23.41,Main,,0,0,0,,Napoleon!Dialogue: 0,0:16:23.41,0:16:25.80,Main,,0,0,0,,Kılıca dönüş.Dialogue: 0,0:16:26.27,0:16:28.18,Main,,0,0,0,,Baş üstüne Mama!Dialogue: 0,0:16:44.22,0:16:46.20,Main,,0,0,0,,N'oluyor lan?Dialogue: 0,0:16:46.20,0:16:48.24,Main,,0,0,0,,Mama...Dialogue: 0,0:16:50.33,0:16:53.42,Main,,0,0,0,,Hasır Şapka!Dialogue: 0,0:17:13.56,0:17:15.10,Main,,0,0,0,,Olamaz!Dialogue: 0,0:17:16.80,0:17:18.70,Main,,0,0,0,,Big Mom!Dialogue: 0,0:17:19.90,0:17:22.17,Main,,0,0,0,,Ne biçim bir forma girmiş?Dialogue: 0,0:17:24.99,0:17:28.79,Main,,0,0,0,,Düğün pastam nerede bakayım?Dialogue: 0,0:17:30.45,0:17:35.88,Main,,0,0,0,,Geri çekilin çocuklar! Gemiyi terk etmeye de hazır olun!Dialogue: 0,0:17:36.51,0:17:37.84,Main,,0,0,0,,Ama...Dialogue: 0,0:17:39.00,0:17:43.60,Main,,0,0,0,,Karnım kazınıyor ya.Dialogue: 0,0:17:43.60,0:17:49.08,Main,,0,0,0,,Lakin başka bir tatlı da beni tatmin etmez.Dialogue: 0,0:17:49.08,0:17:50.16,Main,,0,0,0,,Nerede?Dialogue: 0,0:17:53.92,0:17:58.36,Main,,0,0,0,,Düğün pastası nerede?Dialogue: 0,0:17:58.36,0:18:00.20,Main,,0,0,0,,Eyvah! Sunny-go...Dialogue: 0,0:18:00.20,0:18:01.45,Main,,0,0,0,,Olamaz!Dialogue: 0,0:18:01.45,0:18:04.91,Main,,0,0,0,,Böyle bir canavarı nasıl defedebiliriz ki?Dialogue: 0,0:18:09.18,0:18:12.19,Captions,,0,0,4,,Buğday Adası - Un ŞehriDialogue: 0,0:18:13.41,0:18:15.28,Main,,0,0,0,,Ödüm patladı ha!Dialogue: 0,0:18:36.34,0:18:38.01,Main,,0,0,1,,Aynalar...Dialogue: 0,0:18:36.63,0:18:41.57,Captions,,0,0,1,,Buğday Adası - Un ŞehriDialogue: 0,0:18:38.01,0:18:42.03,Main,,0,0,0,,Bu gidişle şehirde hiç ayna kalmayacak lan!Dialogue: 0,0:18:42.03,0:18:47.26,Main,,0,0,0,,Ayna Dünyası'nda Katakuri-sama'ya karşı bu kadar dayanabileceğini beklemiyordum.Dialogue: 0,0:18:49.89,0:18:53.36,Main,,0,0,0,,Muhtelif adalardan kırılan ayna tutanakları alıyoruz.Dialogue: 0,0:18:49.49,0:18:53.36,Captions,,0,960,380,,Whole Cake AdasıDialogue: 0,0:18:53.36,0:18:57.04,Main,,0,0,0,,Saat 21.30 oldu bile-soir!Dialogue: 0,0:18:57.04,0:19:00.78,Main,,0,0,0,,Çay Partisi'ndeki saldırıdan bu yana neredeyse yarım gün geçmiş!Dialogue: 0,0:19:00.82,0:19:03.42,Main,,0,0,0,,Bu ne biçim iş lan! Sıçayım!Dialogue: 0,0:19:05.70,0:19:10.32,Main,,0,0,0,,Baksanıza...  Enteresan bir şey öğrenmek ister misiniz?Dialogue: 0,0:19:10.32,0:19:14.50,Main,,0,0,0,,Dilini tut! Hasır Şapkalar'ın sağ kalma olasılığı azalacak!Dialogue: 0,0:19:14.50,0:19:17.34,Main,,0,0,0,,Nedir Stussy-sama?Dialogue: 0,0:19:19.46,0:19:22.05,Main,,0,0,0,,Çay Partisi'nde Linlin'in...Dialogue: 0,0:19:22.63,0:19:25.89,Main,,0,0,0,,...gösterdiği Ryugu Sarayı Tamatebako'su var ya?Dialogue: 0,0:19:25.89,0:19:27.55,Main,,0,0,0,,Onu...Dialogue: 0,0:19:27.55,0:19:30.64,Main,,0,0,0,,...Hasır Şapka Luffy'den almıştı, değil mi?Dialogue: 0,0:19:31.55,0:19:33.27,Main,,0,0,0,,Ne olmuş?Dialogue: 0,0:19:33.27,0:19:35.36,Main,,0,0,0,,İşte o Tamatebako'nun içinde...Dialogue: 0,0:19:36.85,0:19:39.36,Main,,0,0,0,,...patlayıcılar vardı.Dialogue: 0,0:19:40.56,0:19:42.66,Main,,0,0,0,,Emin misiniz-bon?Dialogue: 0,0:19:44.66,0:19:49.49,Captions,,0,1040,380,,Ayna DünyasıDialogue: 0,0:19:45.85,0:19:49.49,Main,,0,0,0,,Her zamanki gibi kusursuz ve de havalı!Dialogue: 0,0:19:50.94,0:19:53.35,Main,,0,0,0,,Katakuri abim ya!Dialogue: 0,0:19:53.35,0:19:54.37,Main,,0,0,0,,Ee...Dialogue: 0,0:19:54.37,0:19:57.01,Main,,0,0,0,,...hâlâ isabet ettiremedin mi keskin nişancı?Dialogue: 0,0:19:57.01,0:20:01.46,Main,,0,0,0,,Sormayın, deminden beri fark edilmeden ateş edip duruyorum da...Dialogue: 0,0:20:01.46,0:20:05.47,Main,,0,0,0,,...acayip hızlı hareket ediyor!Dialogue: 0,0:20:05.47,0:20:06.34,Main,,0,0,0,,Hay içine!Dialogue: 0,0:20:06.34,0:20:08.92,Main,,0,0,0,,Hayret bir şey! Beş para etmezsin!Dialogue: 0,0:20:11.79,0:20:13.47,Main,,0,0,0,,Rezil herif!Dialogue: 0,0:20:13.47,0:20:18.52,Main,,0,0,0,,Elimizi çabuk tutup Hasır Şapka'yı haklamazsak işini bitiren Katakuri abim olacak.Dialogue: 0,0:20:19.59,0:20:25.11,Main,,0,0,0,,Millet! Abim kimin başını okşayacakmış bakayım?Dialogue: 0,0:20:25.11,0:20:28.74,Main,,0,0,0,,Elbette Flampe-sama'nın!Dialogue: 0,0:20:28.74,0:20:30.49,Main,,0,0,0,,Ben de öyle düşünmüştüm!Dialogue: 0,0:20:37.18,0:20:39.84,Main,,0,0,0,,41 abim var benim.Dialogue: 0,0:20:39.84,0:20:45.99,Main,,0,0,0,,40 abimin oy kullandığı En İyi Kız Kardeş Ödülü'nü...Dialogue: 0,0:20:47.12,0:20:48.92,Main,,0,0,0,,...kazandım!Dialogue: 0,0:20:48.92,0:20:51.97,Thoughts,,0,0,0,,Herkes sever beni!Dialogue: 0,0:20:53.08,0:20:57.19,Main,,0,0,0,,Ailede en çok sevilen kız kardeşim yani!Dialogue: 0,0:20:57.59,0:21:01.73,Captions,,0,0,300,,Charlotte Ailesi'nin 16. Kızı Charlotte Flampe Katakuri Hayran Kulübü Başkanı ve İntihar Timi KaptanıDialogue: 0,0:20:57.80,0:21:00.64,Main,,0,0,0,,Kız kardeşlerin kraliçesi olacak kadınım!Dialogue: 0,0:21:01.73,0:21:03.60,Main,,0,0,0,,Çok şeker ya!Dialogue: 0,0:21:05.43,0:21:09.11,Main,,0,0,0,,Herkes Katakuri abimin gözdesi olmak istiyor!Dialogue: 0,0:21:09.11,0:21:14.89,Main,,0,0,0,,Ama 38 kız kardeşi de kendisine hayrandır!Dialogue: 0,0:21:14.89,0:21:20.55,Main,,0,0,0,,Hatta erkek kardeşleri bile kendisine hayran.  Çok rakibim var yani!Dialogue: 0,0:21:21.20,0:21:25.26,Main,,0,0,0,,Bu yüzden de abime yardım edip öne geçeceğim!Dialogue: 0,0:21:25.26,0:21:27.36,Main,,0,0,0,,Hislerinizi anlıyoruz Flampe-sama!Dialogue: 0,0:21:28.41,0:21:31.60,Main,,0,0,0,,Biz de Katakuri-sama'nın sevgisini kazanmak istiyoruz!Dialogue: 0,0:21:31.60,0:21:34.84,Main,,0,0,0,,Siz umurumda bile değilsiniz!Dialogue: 0,0:21:35.42,0:21:40.19,Main,,0,0,0,,Buraya geldiğimizde abim kendisi gibi değildi.Dialogue: 0,0:21:41.67,0:21:44.62,Main,,0,0,0,,Şimdi ise her zamanki gibi havalı duruyor!Dialogue: 0,0:21:46.30,0:21:50.44,Main,,0,0,0,,Bir düşmanının abimi zorladığını görmeye tahammül edemiyorum zaten!Dialogue: 0,0:21:53.94,0:21:57.53,Main,,0,0,0,,Her an mükemmel bir görüntü çizmeli!Dialogue: 0,0:21:57.53,0:21:59.99,Main,,0,0,0,,Yoksa hayal kırıklığına uğrarım!Dialogue: 0,0:22:01.28,0:22:02.50,Main,,0,0,0,,Doğru diyorsunuz.Dialogue: 0,0:22:03.24,0:22:06.96,Main,,0,0,0,,Fakat zorlanmıyor aslında.Dialogue: 0,0:22:06.96,0:22:09.61,Main,,0,0,0,,Düşman keçi gibi inatçı sadece!Dialogue: 0,0:22:09.61,0:22:14.10,Main,,0,0,0,,Onlarca ölümcül yara almasına rağmen ayağa kalkıp duruyor!Dialogue: 0,0:22:21.10,0:22:23.22,Main,,0,0,0,,Andaval ya!Dialogue: 0,0:22:24.01,0:22:26.39,Main,,0,0,0,,Gülünç.Dialogue: 0,0:22:45.09,0:22:48.52,Main,,0,0,0,,Düğün pastası!Dialogue: 0,0:22:48.52,0:22:52.17,Main,,0,0,0,,Bu kamaraya mı sakladınız?Dialogue: 0,0:22:52.17,0:22:54.26,Main,,0,0,0,,Dur Big Mom!Dialogue: 0,0:22:55.98,0:22:57.47,Main,,0,0,0,,Göremiyorum!Dialogue: 0,0:22:59.34,0:23:02.18,Main,,0,0,0,,Burada yok!Dialogue: 0,0:23:02.18,0:23:06.64,Main,,0,0,0,,Dur! Gemide pasta falan yok!Dialogue: 0,0:23:08.03,0:23:10.02,Main,,0,0,0,,Ne dedin sen?Dialogue: 0,0:23:10.02,0:23:13.98,Main,,0,0,0,,Hadi oradan... Mümkün değil!Dialogue: 0,0:23:15.03,0:23:18.62,Main,,0,0,0,,Oğlum aksini söyledi!Dialogue: 0,0:23:18.62,0:23:24.84,Main,,0,0,0,,Yalan söylediyse en büyük oğlumu kendi ellerime öldürmem gerekir!Dialogue: 0,0:23:27.26,0:23:31.22,Thoughts,,0,0,0,,H- Hatırlıyor ya!Dialogue: 0,0:23:32.81,0:23:35.34,Flashbacks,,0,0,0,,Yalan söylüyorsan...Dialogue: 0,0:23:35.34,0:23:39.48,Flashbacks,,0,0,0,,...bedelini ömrünle ödersin!Dialogue: 0,0:23:40.96,0:23:46.05,Thoughts,,0,0,0,,Bilinci ne kadar yerinde ki?Dialogue: 0,0:23:48.21,0:23:51.28,Thoughts,,0,0,0,,Örtbas ederim sanmıştım ya!Dialogue: 0,0:23:55.11,0:24:00.73,Main,,0,0,0,,Oğluma yalancı mı diyorsun ha!Dialogue: 0,0:24:01.50,0:24:03.00,Main,,0,0,0,,Hey, Napoleon!Dialogue: 0,0:24:03.00,0:24:04.33,Main,,0,0,0,,Emret, Mama!Dialogue: 0,0:24:05.92,0:24:07.42,Main,,0,0,0,,İş başına!Dialogue: 0,0:24:11.42,0:24:13.11,Main,,0,0,0,,Cognac!Dialogue: 0,0:24:11.42,0:24:15.91,Note,,0,0,0,,Cognac: Adını Fransa'nın Cognac(Konyak) kasabasından alan brendi türü.Dialogue: 0,0:24:13.11,0:24:15.91,Main,,0,0,0,,Sizi yakıp ortadan ikiye ayıracağım!Dialogue: 0,0:24:15.91,0:24:17.21,Main,,0,0,0,,Yanan devasa bir kılıç!Dialogue: 0,0:24:17.21,0:24:19.46,Main,,0,0,0,,Durduramazsın! Kaç Jinbe!Dialogue: 0,0:24:19.46,0:24:21.60,Main,,0,0,0,,Geber!Dialogue: 0,0:24:23.35,0:24:24.67,Main,,0,0,0,,Kairagi!Dialogue: 0,0:24:23.35,0:24:24.67,Attack,,0,0,0,,Erik Çiçeğinden DeriDialogue: 0,0:24:24.67,0:24:26.88,Main,,0,0,0,,Hahaba!Dialogue: 0,0:24:24.67,0:24:26.88,Attack,,0,0,0,,Yıkım KılıcıDialogue: 0,0:24:37.20,0:24:38.54,Main,,0,0,0,,Nasıl olur?Dialogue: 0,0:24:38.54,0:24:41.15,Main,,0,0,0,,Cognac'ı durdurdu!Dialogue: 0,0:24:41.15,0:24:43.31,Main,,0,0,0,,Jinbe!Dialogue: 0,0:24:48.07,0:24:50.66,Main,,0,0,0,,Güç savaşında...Dialogue: 0,0:24:52.82,0:24:57.12,Main,,0,0,0,,...beni alt edebileceğini sanma köpek balığı bozuntusu!Dialogue: 0,0:25:02.17,0:25:03.38,Main,,0,0,0,,Jinbe-san!Dialogue: 0,0:25:03.38,0:25:04.42,Main,,0,0,0,,Olamaz!Dialogue: 0,0:25:04.42,0:25:05.59,Main,,0,0,0,,Jinbe!Dialogue: 0,0:25:14.44,0:25:17.44,Main,,0,0,0,,Pastam nerede? Verin şunu!Dialogue: 0,0:25:17.44,0:25:20.31,Main,,0,0,0,,Açlıktan öleceğim!Dialogue: 0,0:25:20.32,0:25:21.52,Main,,0,0,0,,Carrot!Dialogue: 0,0:25:22.52,0:25:24.52,Main,,0,0,0,,Dur Big Mom!Dialogue: 0,0:25:26.32,0:25:29.24,Thoughts,,0,0,0,,O kamarada Carrot kalıyor!Dialogue: 0,0:25:29.24,0:25:32.15,Main,,0,0,0,,Durmamı istiyorsanız...Dialogue: 0,0:25:32.46,0:25:33.45,Main,,0,0,0,,Nami!Dialogue: 0,0:25:33.45,0:25:35.06,Main,,0,0,0,,...pastanın yerini söyleyin!Dialogue: 0,0:25:42.72,0:25:43.51,Main,,0,0,0,,Nami!Dialogue: 0,0:25:44.47,0:25:45.89,Main,,0,0,0,,Bir şeyim yok!Dialogue: 0,0:25:49.68,0:25:54.60,Main,,0,0,0,,Sıçtık abi! Big Mom'ın kafasındaki alevlerden yelken tutuştu!Dialogue: 0,0:25:56.58,0:25:58.81,Main,,0,0,0,,Nereye sakladınız be...Dialogue: 0,0:25:58.82,0:26:01.05,Main,,0,0,0,,Kaç Nami!Dialogue: 0,0:26:01.05,0:26:05.27,Main,,0,0,0,,...o kadar büyük bir pastayı?Dialogue: 0,0:26:07.54,0:26:09.54,Main,,0,0,0,,Guard Point!Dialogue: 0,0:26:07.54,0:26:09.54,Attack,,0,0,0,,Savunma NoktasıDialogue: 0,0:26:13.88,0:26:15.24,Main,,0,0,0,,Chopper!Dialogue: 0,0:26:16.05,0:26:18.78,Main,,0,0,0,,İnanmıyorum ya...Dialogue: 0,0:26:19.23,0:26:24.67,Main,,0,0,0,,Nasıl bir şekle girmişsin sen! Daha bir ender oldun şimdi!Dialogue: 0,0:26:24.67,0:26:28.53,Main,,0,0,0,,Mutlaka tuhaf yaratıklar koleksiyonumda olacaksın!Dialogue: 0,0:26:28.53,0:26:31.70,Main,,0,0,0,,Minik mi minik tombiş rakunum!Dialogue: 0,0:26:31.70,0:26:35.65,Main,,0,0,0,,R- Rakun değilim ben! Ren geyiğiyim!Dialogue: 0,0:26:37.90,0:26:43.31,Main,,0,0,0,,Düğün pastasını yer yemez seninle Ruh Kralı şahsi malım olacaksınız!Dialogue: 0,0:26:43.31,0:26:48.21,Main,,0,0,0,,Bırak beni! Gemide pasta falan yok! Ben de oyuncağın değilim!Dialogue: 0,0:26:48.21,0:26:49.40,Main,,0,0,0,,Chopper!Dialogue: 0,0:26:50.76,0:26:56.34,Main,,0,0,0,,Gemi denizin dibini boylarsa yalanımı da beraberinde götürebilir!Dialogue: 0,0:26:56.34,0:27:01.45,Main,,0,0,0,,Gemilerini yitirirlerse Hasır Şapkalar hemen hemen yok olmuş demektir!Dialogue: 0,0:27:02.76,0:27:04.37,Main,,0,0,0,,Gemi...Dialogue: 0,0:27:04.37,0:27:09.48,Main,,0,0,0,,Gemi küle dönecek!Dialogue: 0,0:27:25.96,0:27:27.76,Main,,0,0,0,,Gomu Gomu no...Dialogue: 0,0:27:27.76,0:27:30.32,Main,,0,0,0,,Hawk Stamp!Dialogue: 0,0:27:27.76,0:27:30.32,Attack,,0,0,0,,Şahin DamgasıDialogue: 0,0:27:41.36,0:27:43.17,Thoughts,,0,0,0,,Savuşturmaya mı çalıştı?Dialogue: 0,0:27:48.43,0:27:50.26,Main,,0,0,0,,Neden sönmüyor ki...Dialogue: 0,0:27:53.75,0:27:55.51,Main,,0,0,0,,...gözlerinin...Dialogue: 0,0:27:57.26,0:27:58.51,Main,,0,0,0,,...feri!Dialogue: 0,0:28:28.87,0:28:34.18,Main,,0,0,0,,İdrak edemiyorsun galiba. Yere düşmek başlı başına bir utançtır.Dialogue: 0,0:29:00.08,0:29:01.69,Main,,0,0,0,,Gemi...Dialogue: 0,0:29:01.69,0:29:07.02,Main,,0,0,0,,Gemi küle dönecek!Dialogue: 0,0:29:09.11,0:29:14.53,Main,,0,0,0,,Söyleyin bakalım, düğün pastam nerede?Dialogue: 0,0:29:14.53,0:29:15.54,Main,,0,0,0,,Bıraksana!Dialogue: 0,0:29:15.54,0:29:16.47,Main,,0,0,0,,Chopper!Dialogue: 0,0:29:16.47,0:29:19.55,Main,,0,0,0,,Eyvah eyvah! Yangını söndürmemiz lazım!Dialogue: 0,0:29:19.55,0:29:22.19,Main,,0,0,0,,Su! Su!Dialogue: 0,0:29:25.85,0:29:27.38,Main,,0,0,0,,Kairyuu:Dialogue: 0,0:29:25.85,0:29:27.38,Attack,,0,0,0,,Okyanus Akıntısı:Dialogue: 0,0:29:30.80,0:29:33.89,Main,,0,0,0,,Ipponzeoi!Dialogue: 0,0:29:30.80,0:29:33.89,Attack,,0,0,0,,Omuz FırlatışıDialogue: 0,0:30:10.59,0:30:13.47,Main,,0,0,0,,Hay içine! Birdenbire su geliverdi!Dialogue: 0,0:30:19.81,0:30:21.63,Main,,0,0,0,,Jinbe-san!Dialogue: 0,0:30:23.58,0:30:25.47,Main,,0,0,0,,Mama!Dialogue: 0,0:30:25.93,0:30:30.47,Main,,0,0,0,,Gemiden defol Big Mom!Dialogue: 0,0:30:30.47,0:30:32.46,Main,,0,0,0,,Öyleyse...Dialogue: 0,0:30:34.85,0:30:37.94,Main,,0,0,0,,...pastamı verin!Dialogue: 0,0:30:38.98,0:30:42.86,Main,,0,0,0,,Gyojin Karate Ogi:Dialogue: 0,0:30:38.98,0:30:42.86,Attack,,0,0,0,,Balık Adam Karate Gizli Tekniği:Dialogue: 0,0:30:44.99,0:30:47.37,Main,,0,0,0,,Buraikan!Dialogue: 0,0:30:44.99,0:30:47.37,Attack,,0,0,0,,Berduş DelgisiDialogue: 0,0:31:13.04,0:31:14.18,Main,,0,0,0,,Mama!Dialogue: 0,0:31:17.14,0:31:19.27,Main,,0,0,0,,Ne?Dialogue: 0,0:31:21.07,0:31:24.21,Main,,0,0,0,,Oley be! Gemiden attı!Dialogue: 0,0:31:24.21,0:31:26.03,Main,,0,0,0,,Jinbe, süpersin ya!Dialogue: 0,0:31:27.07,0:31:28.20,Main,,0,0,0,,Şükürler olsun!Dialogue: 0,0:31:28.20,0:31:29.30,Main,,0,0,0,,Başardın!Dialogue: 0,0:31:29.30,0:31:31.33,Main,,0,0,0,,Millet!Dialogue: 0,0:31:31.33,0:31:33.63,Main,,0,0,0,,Gemiye daha fazla zarar vermelerine izin verirsek...Dialogue: 0,0:31:33.63,0:31:36.23,Main,,0,0,0,,...Luffyler'in yüzüne nasıl bakarız?Dialogue: 0,0:31:36.23,0:31:38.52,Main,,0,0,0,,Hız kesmeyin!Dialogue: 0,0:31:38.52,0:31:43.01,Main,,0,0,0,,Perosperolar bize yetişirse işimiz bitti demektir!Dialogue: 0,0:31:43.01,0:31:43.65,Main,,0,0,0,,Tamam!Dialogue: 0,0:31:43.65,0:31:44.54,Main,,0,0,0,,Anlaşıldı!Dialogue: 0,0:31:44.54,0:31:46.30,Main,,0,0,0,,Hiç merak etme!Dialogue: 0,0:31:47.63,0:31:49.38,Main,,0,0,0,,Kusura bakmayın ama...Dialogue: 0,0:31:49.38,0:31:53.47,Main,,0,0,0,,...Big Mom'ın kendine gelmesi an meselesi!Dialogue: 0,0:31:56.89,0:31:58.04,Main,,0,0,0,,Carrot ne durumda?Dialogue: 0,0:31:58.04,0:31:59.25,Main,,0,0,0,,Bir şeyi yok!Dialogue: 0,0:32:00.31,0:32:02.81,Main,,0,0,0,,Tam süratte kurtulalım onlardan!Dialogue: 0,0:32:07.65,0:32:10.02,Main,,0,0,0,,Mama, iyi misin?Dialogue: 0,0:32:10.02,0:32:11.24,Main,,0,0,0,,Evet!Dialogue: 0,0:32:15.20,0:32:18.62,Main,,0,0,0,,Fena hamle değildi Jinbe!Dialogue: 0,0:32:19.33,0:32:20.41,Main,,0,0,0,,Geliyor!Dialogue: 0,0:32:20.41,0:32:24.38,Main,,0,0,0,,Sahi! Aklıma bir fikir geldi!Dialogue: 0,0:32:27.51,0:32:29.43,Main,,0,0,0,,Gemilerini keseceğim!Dialogue: 0,0:32:29.43,0:32:31.84,Main,,0,0,0,,Güzel fikir Mama!Dialogue: 0,0:32:31.84,0:32:35.56,Main,,0,0,0,,Kestikten sonra kesin bulurum...Dialogue: 0,0:32:37.52,0:32:39.77,Main,,0,0,0,,...düğün pastamı!Dialogue: 0,0:32:39.77,0:32:43.40,Main,,0,0,0,,Kılıç bu sefer de uzadı! Onu savurursa...Dialogue: 0,0:32:43.40,0:32:45.64,Main,,0,0,0,,Geminin işi bitmiş demektir!Dialogue: 0,0:32:45.64,0:32:48.73,Main,,0,0,0,,En azından artık güvertede değil!Dialogue: 0,0:32:48.73,0:32:50.96,Main,,0,0,0,,Hadi bakayım Zeus-chan...Dialogue: 0,0:32:52.37,0:32:53.86,Main,,0,0,0,,En sevdiklerin, değil mi?Dialogue: 0,0:32:55.28,0:32:56.78,Main,,0,0,0,,Bunlar...Dialogue: 0,0:32:57.20,0:32:58.61,Flashbacks,,0,0,0,,Black Ball!Dialogue: 0,0:32:57.20,0:32:58.61,Attack,,0,0,0,,Kara TopDialogue: 0,0:33:02.25,0:33:06.58,Flashbacks,,0,0,0,,Enfes! Enfes! Enfes abi ya!Dialogue: 0,0:33:08.59,0:33:11.01,Main,,0,0,0,,Çok güzeller ya!Dialogue: 0,0:33:11.01,0:33:14.13,Main,,0,0,0,,Değil mi ama? Haydi, yumul bakayım!Dialogue: 0,0:33:14.13,0:33:16.58,Main,,0,0,0,,N'apsam ki?Dialogue: 0,0:33:16.58,0:33:20.62,Main,,0,0,0,,Aynı tongaya bir daha düşmem!Dialogue: 0,0:33:23.02,0:33:27.35,Main,,0,0,0,,Beni kandırmaya çalışma yılan kadın!Dialogue: 0,0:33:27.35,0:33:29.65,Main,,0,0,0,,Nami!Dialogue: 0,0:33:34.28,0:33:35.84,Main,,0,0,0,,Benim ya.Dialogue: 0,0:33:35.84,0:33:37.49,Main,,0,0,0,,Sen miydin lan?Dialogue: 0,0:33:43.75,0:33:48.42,Main,,0,0,0,,Evet, etim budum olmadığından yıldırımlar bana sökmez.Dialogue: 0,0:33:49.16,0:33:51.34,Main,,0,0,0,,Bak sen?Dialogue: 0,0:33:51.34,0:33:55.47,Main,,0,0,0,,Benimle kapışmak mı istiyorsun Ruh Kralı?Dialogue: 0,0:33:55.47,0:34:01.22,Main,,0,0,0,,Kılıcınla bana çizik dahi atamadığını hatırlıyorum!Dialogue: 0,0:34:01.24,0:34:05.84,Main,,0,0,0,,Öyle olmuştu. O zaman hiç yoktan...Dialogue: 0,0:34:05.84,0:34:09.94,Main,,0,0,0,,...külodunu gösterir misin?Dialogue: 0,0:34:11.55,0:34:13.76,Main,,0,0,0,,Haa?!Dialogue: 0,0:34:13.76,0:34:15.39,Main,,0,0,0,,Ne?Dialogue: 0,0:34:27.28,0:34:28.61,Main,,0,0,0,,Tamamdır.Dialogue: 0,0:34:28.61,0:34:31.08,Main,,0,0,0,,İşimi gördüm.Dialogue: 0,0:34:31.65,0:34:34.57,Main,,0,0,0,,Hanauta Sanchou...Dialogue: 0,0:34:31.65,0:34:34.57,Attack,,0,0,0,,Üç Dizeli Mırıldanış:Dialogue: 0,0:34:34.57,0:34:37.16,Main,,0,0,0,,Tyamasi no...Dialogue: 0,0:34:34.57,0:34:37.16,Attack,,0,0,0,,Ruhani...Dialogue: 0,0:34:38.52,0:34:40.29,Main,,0,0,0,,...Yahazu Giri!Dialogue: 0,0:34:38.52,0:34:40.29,Attack,,0,0,0,,...Çentik Kesişi!Dialogue: 0,0:34:43.68,0:34:48.59,Main,,0,0,0,,Başından beri hedefimizde sen vardın Zeus!Dialogue: 0,0:34:48.59,0:34:51.93,Main,,0,0,0,,Lan! Lan! Sıçayım! Dikkatsizlik ettim!Dialogue: 0,0:34:51.93,0:34:53.97,Main,,0,0,0,,Dayan Zeus!Dialogue: 0,0:34:58.39,0:35:01.31,Main,,0,0,0,,Seidenka Black Ball!Dialogue: 0,0:34:58.39,0:35:01.31,Attack,,0,0,0,,Artı Yüklü Kara Top!Dialogue: 0,0:35:01.31,0:35:05.48,Main,,0,0,0,,Elektriğini boşalt da rahatla hadi Zeus-chan!Dialogue: 0,0:35:05.48,0:35:07.28,Main,,0,0,0,,Senin var ya...Dialogue: 0,0:35:09.03,0:35:11.74,Main,,0,0,0,,B- Bu...Dialogue: 0,0:35:13.78,0:35:14.90,Main,,0,0,0,,Bu da ne?Dialogue: 0,0:35:28.88,0:35:30.31,Main,,0,0,0,,Mama!Dialogue: 0,0:35:30.85,0:35:32.67,Main,,0,0,0,,Gerçek olamaz, Mama!Dialogue: 0,0:35:32.67,0:35:34.57,Main,,0,0,0,,Zeus'u öldürdüler!Dialogue: 0,0:35:37.90,0:35:39.50,Main,,0,0,0,,Mama!Dialogue: 0,0:35:40.82,0:35:42.12,Main,,0,0,0,,İşe yaradı!Dialogue: 0,0:35:42.12,0:35:46.84,Main,,0,0,0,,Zaman kazanmış olduk! Mesafeyi açalım!Dialogue: 0,0:35:46.84,0:35:48.55,Main,,0,0,0,,Elini çabuk tut Brook!Dialogue: 0,0:35:48.55,0:35:49.59,Main,,0,0,0,,Tamamdır!Dialogue: 0,0:35:52.87,0:35:54.26,Main,,0,0,0,,Yakala!Dialogue: 0,0:35:59.34,0:36:01.14,Main,,0,0,0,,Döndüm efendim!Dialogue: 0,0:36:01.14,0:36:03.29,Main,,0,0,0,,Yaşasın! Hoş geldin!Dialogue: 0,0:36:03.29,0:36:05.22,Main,,0,0,0,,Brook, süpersin ya!Dialogue: 0,0:36:06.60,0:36:12.78,Main,,0,0,0,,Zararı asgari düzeyde tutmak istesek de gemi harap oldu!Dialogue: 0,0:36:14.06,0:36:15.82,Main,,0,0,0,,Sahi!Dialogue: 0,0:36:15.82,0:36:17.82,Main,,0,0,0,,Yanımda bir şey getirdim.Dialogue: 0,0:36:19.37,0:36:20.92,Main,,0,0,0,,Oh, Zeus!Dialogue: 0,0:36:20.92,0:36:23.20,Main,,0,0,0,,B- Bela çıkarmasın?Dialogue: 0,0:36:23.20,0:36:25.70,Main,,0,0,0,,O kadar enerjisi kaldığını sanmıyorum.Dialogue: 0,0:36:27.90,0:36:30.08,Main,,0,0,0,,Neredeyim ya?Dialogue: 0,0:36:31.95,0:36:34.29,Main,,0,0,0,,Hoş geldin Zeus.Dialogue: 0,0:36:35.82,0:36:38.10,Main,,0,0,0,,Hoş buldu...Dialogue: 0,0:36:40.79,0:36:45.23,Main,,0,0,0,,Yanılmıyorsam demin...Dialogue: 0,0:36:45.23,0:36:49.80,Main,,0,0,0,,...bana yıldırım atmaya çalışmıştın.Dialogue: 0,0:36:49.80,0:36:50.64,Main,,0,0,0,,Özür dilerim.Dialogue: 0,0:36:50.64,0:36:55.39,Main,,0,0,0,,Özür her şeyi çözseydi polis kuvvetleri de donanma da olmazdı.Dialogue: 0,0:36:59.30,0:37:02.27,Main,,0,0,0,,Galiba yanlış anladın ya.Dialogue: 0,0:37:02.27,0:37:08.28,Main,,0,0,0,,Arkadaşım olmanı istemiyordum ki.Dialogue: 0,0:37:08.28,0:37:09.14,Main,,0,0,0,,Ne?Dialogue: 0,0:37:09.14,0:37:11.03,Main,,0,0,0,,Hizmetkârım...Dialogue: 0,0:37:12.17,0:37:15.87,Main,,0,0,0,,...olacak mısın? Yoksa...Dialogue: 0,0:37:17.10,0:37:18.37,Main,,0,0,0,,...ölecek misin?Dialogue: 0,0:37:19.58,0:37:22.99,Main,,0,0,0,,İyi düşün tatlım.Dialogue: 0,0:37:26.21,0:37:30.01,Main,,0,0,0,,Mama! Mama!Dialogue: 0,0:37:31.81,0:37:33.72,Main,,0,0,0,,Kafa şişirme!Dialogue: 0,0:37:33.72,0:37:35.06,Main,,0,0,0,,Mama!Dialogue: 0,0:37:37.59,0:37:39.93,Main,,0,0,0,,Peşlerine düş Prometheus!Dialogue: 0,0:37:39.93,0:37:41.55,Main,,0,0,0,,Emrin olur Mama!Dialogue: 0,0:37:43.35,0:37:46.10,Credits,,0,0,0,,Editing:  Feeso, Galaxy 9000  Timing: Galaxy 9000  Quality Assurance: Feeso, Galaxy 9000, Grug, Pepperjack  Soundtracking:  Halee  Graphics:  Datenshi  Karaoke: KaitouYahiko  Translation: Crunchyroll  Flampe Age Fix: KaitouYahiko