,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.7,0.7,9,10,10,10,1Style: Attack,Duality,30.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.0,1.0,7,12,12,12,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:01:43.00,0:01:46.91,Main,,0,0,0,,Yüzümü görmelerini istemiyorum!Dialogue: 0,0:01:46.91,0:01:50.14,Main,,0,0,0,,Görürlerse öldürürler!Dialogue: 0,0:01:50.14,0:01:51.50,Main,,0,0,0,,Kapa çeneni!Dialogue: 0,0:01:53.74,0:01:55.49,Main,,0,0,0,,Senin işin olduğunu biliyorlar zaten.Dialogue: 0,0:01:55.49,0:01:58.26,Main,,0,0,0,,Bizimkiler senin yeteneğin sayesinde ortalığı birbirine katıyor.Dialogue: 0,0:02:00.22,0:02:05.04,Main,,0,0,0,,Pekâlâ! Bu ayna, müttefik birliklerin kaçabilmesi için hayati önem arz ediyor.Dialogue: 0,0:02:05.04,0:02:08.33,Main,,0,0,0,,Görevimi yerine getirir getirmez kalbimi geri alacağım.Dialogue: 0,0:02:08.85,0:02:12.92,Main,,0,0,0,,O zaman gelince de hepsine ağzının payını vereceğim!Dialogue: 0,0:02:16.11,0:02:19.84,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - dmc3 thx to onepace.netDialogue: 0,0:14:22.90,0:14:32.90,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - dmc3 thx to onepace.netDialogue: 0,0:28:10.60,0:28:15.40,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - dmc3 thx to onepace.netDialogue: 0,0:02:16.11,0:02:19.84,Title,,0,0,0,,Hey, AnneDialogue: 0,0:02:25.23,0:02:27.25,Thoughts,,0,0,0,,İçeride durumlar ne âlemde?Dialogue: 0,0:02:28.61,0:02:32.15,Thoughts,,0,0,0,,Çığlığı işitmiyorum. Big Mom ne durumda?Dialogue: 0,0:02:37.40,0:02:39.34,Thoughts,,0,0,0,,Tıpkı planladığımız gibi...Dialogue: 0,0:02:39.94,0:02:44.06,Thoughts,,0,0,0,,Pasta hiç edilmiş,  Hasır Şapka sürüsü de ortalıkta cirit atıyor.Dialogue: 0,0:02:44.75,0:02:49.44,Thoughts,,0,0,0,,Anne Carmel'in fotoğrafı da parçalanmış.Dialogue: 0,0:02:49.88,0:02:53.15,Thoughts,,0,0,0,,Öyleyse Big Mom neden çığlığı basmıyor?Dialogue: 0,0:02:56.75,0:02:58.65,Thoughts,,0,0,0,,Neler oluyor ya?Dialogue: 0,0:03:04.23,0:03:06.99,Flashbacks,,0,0,0,,Luffy-san, dinle beni!Dialogue: 0,0:03:06.99,0:03:10.66,Flashbacks,,0,0,0,,Big Mom art arda birden fazla kez afalladığından...Dialogue: 0,0:03:10.66,0:03:13.84,Flashbacks,,0,0,0,,...neye öfkeleneceğini çözemiyor.Dialogue: 0,0:03:14.28,0:03:17.80,Flashbacks,,0,0,0,,Tamam! Öyle diyorsan yapayım!Dialogue: 0,0:03:20.13,0:03:21.90,Main,,0,0,0,,Bana bırakın!Dialogue: 0,0:03:24.14,0:03:28.27,Main,,0,0,0,,Hasır Şapka'yı durdurun! Mama'ya yaklaştırmayın!Dialogue: 0,0:03:38.79,0:03:41.15,Main,,0,0,0,,Neden yoluma çıkıyorsun?Dialogue: 0,0:03:46.97,0:03:48.09,Main,,0,0,0,,Bege!Dialogue: 0,0:03:52.01,0:03:54.63,Main,,0,0,0,,Bege, alçak herif...Dialogue: 0,0:03:58.51,0:04:00.92,Main,,0,0,0,,Geber Katakuri!Dialogue: 0,0:04:03.30,0:04:06.60,Main,,0,0,0,,Ne yapıyorsun Gang Bege?Dialogue: 0,0:04:09.18,0:04:11.93,Main,,0,0,0,,Bize ihanet edeceğini biliyordum Bege.Dialogue: 0,0:04:16.06,0:04:17.00,Main,,0,0,0,,Peros abi!Dialogue: 0,0:04:18.26,0:04:20.90,Main,,0,0,0,,Bir an önce vur şunları!Dialogue: 0,0:04:20.90,0:04:22.24,Main,,0,0,0,,Biliyorum.Dialogue: 0,0:04:24.74,0:04:28.72,Main,,0,0,0,,Of ya... Geleceği gören adam da her şeyi aceleye getiriyor.Dialogue: 0,0:04:29.18,0:04:34.73,Main,,0,0,0,,Fakat şu sahne için ben de geleceği görebiliyorum.Dialogue: 0,0:04:37.14,0:04:42.68,Main,,0,0,0,,Yüzünüzdeki zavallı ifadelerle şekerimle kaplanmışken ölüp gideceksiniz!Dialogue: 0,0:04:44.80,0:04:46.57,Main,,0,0,0,,Alternatif bir gelecek görmüyorum!Dialogue: 0,0:04:50.22,0:04:53.68,Main,,0,0,0,,Hiç yoktan Raid Suits'imiz olsaydı...Dialogue: 0,0:04:53.68,0:04:56.50,Main,,0,0,0,,...canınızın istediğini yapmanıza izin vermezdik!Dialogue: 0,0:04:56.50,0:04:57.80,Main,,0,0,0,,Raid mi?Dialogue: 0,0:04:58.51,0:05:02.82,Main,,0,0,0,,Nedir o? Silah falan mı-perorin?Dialogue: 0,0:05:04.70,0:05:09.55,Main,,0,0,0,,Lütfen ama! Oğlunun düğününe ne diye silah getirmek isteyesin ki?Dialogue: 0,0:05:12.25,0:05:14.46,Main,,0,0,0,,Kaç Reiju!Dialogue: 0,0:05:24.67,0:05:25.76,Main,,0,0,0,,Yine mi sen!Dialogue: 0,0:05:29.06,0:05:31.21,Main,,0,0,0,,Yoluma çıkma!Dialogue: 0,0:05:37.91,0:05:39.30,Main,,0,0,0,,Sanji...Dialogue: 0,0:05:39.30,0:05:43.11,Main,,0,0,0,,Ne işler çeviriyor? Yaygara koparıyor.Dialogue: 0,0:05:55.79,0:05:56.66,Thoughts,,0,0,0,,Sanji...Dialogue: 0,0:05:58.41,0:06:01.25,Thoughts,,0,0,0,,Bu kadar iyi kalpli olacağını ben bile kestiremedim.Dialogue: 0,0:06:01.64,0:06:05.92,Thoughts,,0,0,0,,Bizim gibi beş para etmezlere bile sırtını dönmüyorsun.Dialogue: 0,0:06:08.25,0:06:10.61,Thoughts,,0,0,0,,Bir Vinsmoke ferdi olmaktan her daim nefret ettim...Dialogue: 0,0:06:11.32,0:06:13.24,Thoughts,,0,0,0,,...ve utanç duydum.Dialogue: 0,0:06:14.33,0:06:14.80,Thoughts,,0,0,0,,Fakat...Dialogue: 0,0:06:15.89,0:06:17.98,Thoughts,,0,0,0,,...büyüdüğünü görünce...Dialogue: 0,0:06:20.92,0:06:24.16,Thoughts,,0,0,0,,İçime su serpildi!Dialogue: 0,0:06:29.56,0:06:33.61,Thoughts,,0,0,0,,Zira soyumuzda hâlâ vicdan olduğunu gördüm.Dialogue: 0,0:06:35.26,0:06:38.26,Thoughts,,0,0,0,,Teşekkürler Sanji!Dialogue: 0,0:06:46.30,0:06:49.05,Main,,0,0,0,,Olamaz! Sanji'nin ailesi...Dialogue: 0,0:07:09.06,0:07:09.90,Main,,0,0,0,,Vay adi!Dialogue: 0,0:07:11.15,0:07:12.11,Main,,0,0,0,,Pedro!Dialogue: 0,0:07:12.11,0:07:14.51,Main,,0,0,0,,Ona dokunma Luffy! Devam et!Dialogue: 0,0:07:14.51,0:07:15.10,Main,,0,0,0,,Sağ ol!Dialogue: 0,0:07:16.29,0:07:19.29,Main,,0,0,0,,Go Sen Mai Gawara...Dialogue: 0,0:07:16.29,0:07:19.29,Attack,,0,0,0,,Beş Bin Tuğla...Dialogue: 0,0:07:19.29,0:07:21.29,Main,,0,0,0,,...Sei Ken!Dialogue: 0,0:07:19.29,0:07:21.29,Attack,,0,0,0,,...Yumruğu!Dialogue: 0,0:07:31.18,0:07:31.98,Main,,0,0,0,,Bege!Dialogue: 0,0:07:34.15,0:07:36.01,Main,,0,0,0,,Geber Katakuri!Dialogue: 0,0:07:44.48,0:07:45.70,Main,,0,0,0,,Yapamazsın!Dialogue: 0,0:08:02.00,0:08:03.24,Main,,0,0,0,,Mama...Dialogue: 0,0:08:10.39,0:08:12.26,Main,,0,0,0,,Mama... Hayır!Dialogue: 0,0:08:21.94,0:08:22.73,Main,,0,0,0,,A...Dialogue: 0,0:08:23.43,0:08:25.19,Main,,0,0,0,,Anne...Dialogue: 0,0:08:25.88,0:08:26.42,Main,,0,0,0,,A...Dialogue: 0,0:08:34.75,0:08:36.22,Main,,0,0,0,,Anne!Dialogue: 0,0:08:40.02,0:08:41.79,Main,,0,0,0,,Mama!Dialogue: 0,0:08:52.64,0:08:54.13,Thoughts,,0,0,0,,Güzel!Dialogue: 0,0:10:38.40,0:10:41.72,Main,,0,0,0,,Gerisini kendiniz halledin.Dialogue: 0,0:10:41.72,0:10:43.45,Main,,0,0,0,,Gerçi beni duyamıyorlar.Dialogue: 0,0:11:05.24,0:11:06.83,Main,,0,0,0,,Mama yaralandı mı?Dialogue: 0,0:11:09.27,0:11:11.13,Thoughts,,0,0,0,,Güçten düştü!Dialogue: 0,0:11:20.22,0:11:23.18,Main,,0,0,0,,Hey! Biri Begeler'i durdursun!Dialogue: 0,0:11:28.80,0:11:29.71,Main,,0,0,0,,Bege!Dialogue: 0,0:11:30.39,0:11:33.07,Main,,0,0,0,,Ne cüretle bize ihanet edersin!Dialogue: 0,0:11:33.36,0:11:35.79,Main,,0,0,0,,Elveda Big Mom!Dialogue: 0,0:11:41.56,0:11:42.53,Thoughts,,0,0,0,,Anne...Dialogue: 0,0:11:43.45,0:11:46.51,Thoughts,,0,0,0,,Bana kulak ver lütfen Anne...Dialogue: 0,0:11:47.55,0:11:52.22,Thoughts,,0,0,0,,Dediklerime kimse kulak asmıyor.Dialogue: 0,0:11:53.06,0:11:57.53,Thoughts,,0,0,0,,Hey Anne... Nereye gittin?Dialogue: 0,0:11:59.28,0:12:01.23,Narrator,,0,0,0,,Big Mom'ın gözyaşları...Dialogue: 0,0:12:02.49,0:12:08.61,Narrator,,0,0,0,,...63 yıl önce Yeni Dünya'daki Elbaf'a dayanıyordu.Dialogue: 0,0:12:09.48,0:12:15.47,Narrator,,0,0,0,,Dünyaca ünlü Devler,  Elbaf Savaşçıları burada yaşıyordu.Dialogue: 0,0:12:29.55,0:12:30.92,Main,,0,0,0,,Haydi, in aşağı.Dialogue: 0,0:12:34.40,0:12:38.40,Captions,,0,0,0,,Charlotte Linlin (İnsan, 5 Yaşında)Dialogue: 0,0:12:35.69,0:12:38.40,Main,,0,0,1,,Neresi burası?Dialogue: 0,0:12:38.40,0:12:43.06,Main,,0,0,0,,Sonra anlatırım. Haydi aşağı gel Linlin.Dialogue: 0,0:12:43.61,0:12:44.49,Main,,0,0,0,,Tamam.Dialogue: 0,0:12:45.13,0:12:46.24,Main,,0,0,0,,Hoppa.Dialogue: 0,0:12:50.36,0:12:51.69,Main,,0,0,0,,Söylesenize...Dialogue: 0,0:12:52.66,0:12:57.35,Main,,0,0,0,,Neredeyim? Bir yere mi gidiyoruz?Dialogue: 0,0:12:57.35,0:13:00.09,Main,,0,0,0,,Babacığının bu civarda yapacak bir işi var.Dialogue: 0,0:13:00.09,0:13:02.98,Main,,0,0,0,,Linlin, uslu bir kız olup bizi bekler misin?Dialogue: 0,0:13:02.98,0:13:05.66,Main,,0,0,0,,Ne? Ben de sizinle geliyorum...Dialogue: 0,0:13:05.66,0:13:09.53,Main,,0,0,0,,İtiraz etmezsen çantadan dilediğin kadar şekerleme yiyebilirsin.Dialogue: 0,0:13:09.53,0:13:10.93,Main,,0,0,0,,Evet evet!Dialogue: 0,0:13:11.43,0:13:12.89,Main,,0,0,0,,Ne?!Dialogue: 0,0:13:12.89,0:13:15.27,Main,,0,0,0,,Hepsini yiyebilir miyim? Öyleyse beklemem mi hiç?Dialogue: 0,0:13:15.70,0:13:17.52,Main,,0,0,0,,Burada bekleyeceğim!Dialogue: 0,0:13:21.90,0:13:23.24,Main,,0,0,0,,Görüşürüz!Dialogue: 0,0:13:23.24,0:13:25.53,Main,,0,0,0,,Çabucak dönüverin!Dialogue: 0,0:13:27.87,0:13:29.12,Main,,0,0,0,,Linlin...Dialogue: 0,0:13:29.12,0:13:30.03,Main,,0,0,0,,Şimdi ağlayamazsın.Dialogue: 0,0:13:31.22,0:13:35.00,Main,,0,0,0,,Verdiği onca zarardan sonra yalnızca sürgün edildiği için bile şanslıyız.Dialogue: 0,0:13:35.60,0:13:38.13,Main,,0,0,0,,O kız... Bizi aşıyor...Dialogue: 0,0:13:39.18,0:13:43.27,Main,,0,0,0,,Bu topraklarda Mukaddes Anne'nin yaşadığı rivayet edilir. Linlin'i kurtaracaktır.Dialogue: 0,0:13:43.89,0:13:47.11,Main,,0,0,0,,Demir alın! Tehlikeli sulardayız!Dialogue: 0,0:13:56.12,0:13:58.28,Main,,0,0,0,,Güle güle!Dialogue: 0,0:14:01.04,0:14:04.07,Main,,0,0,0,,Vay! Kocaman balıklar.Dialogue: 0,0:14:08.49,0:14:10.66,Note,,0,0,0,,GURULDARDialogue: 0,0:14:12.25,0:14:16.15,Main,,0,0,0,,Çok tuhaf ya, gitmelerinin üzerinden epey zaman geçti.Dialogue: 0,0:14:16.15,0:14:18.19,Main,,0,0,0,,Karnım kazınıyor...Dialogue: 0,0:14:19.27,0:14:22.69,Main,,0,0,0,,Anne, baba... Nereye gittiniz?Dialogue: 0,0:14:23.16,0:14:25.88,Main,,0,0,0,,Neden dönmüyorsunuz?Dialogue: 0,0:14:31.25,0:14:32.81,Narrator,,0,0,0,,Elbaf'a gelince...Dialogue: 0,0:14:34.55,0:14:39.55,Narrator,,0,0,0,,...bir asır evvel dünyanın korktuğu Dev savaşçıların memleketiydi.Dialogue: 0,0:14:39.55,0:14:41.82,Narrator,,0,0,0,,İsimleri de Dev Korsanları idi.Dialogue: 0,0:14:43.59,0:14:49.00,Narrator,,0,0,0,,Yelken aldıkları sularda kargaşa çıkarıp sayısız şehri yakıp yıkmışlardır.Dialogue: 0,0:14:50.35,0:14:51.16,Narrator,,0,0,0,,Fakat...Dialogue: 0,0:14:52.73,0:14:57.69,Narrator,,0,0,0,,...günün birinde Dev Korsanları ansızın iki kaptanını da yitirerek...Dialogue: 0,0:14:57.69,0:14:59.65,Narrator,,0,0,0,,...efsanelere karışmıştır.Dialogue: 0,0:14:59.65,0:15:04.52,Narrator,,0,0,0,,Hemen akabinde, liderlerinin kaybıyla dikkatsizlik eden birkaç başıboş Dev...Dialogue: 0,0:15:04.52,0:15:08.01,Narrator,,0,0,0,,...Donanma'nın ellerine düşmüş ve infaz edilmek üzeredir.Dialogue: 0,0:15:08.01,0:15:10.17,Main,,0,0,0,,Gebertin!Dialogue: 0,0:15:19.14,0:15:20.48,Main,,0,0,0,,Durun lütfen!Dialogue: 0,0:15:21.89,0:15:23.14,Main,,0,0,0,,İnfazı durdurun!Dialogue: 0,0:15:23.98,0:15:26.26,Main,,0,0,0,,Cennet uzlaşma görmek istiyor!Dialogue: 0,0:15:28.14,0:15:31.45,Narrator,,0,0,0,,Güzel bir gezgin rahibe çıkagelmiştir!Dialogue: 0,0:15:31.57,0:15:35.08,Captions,,0,0,0,,Rahibe CarmelDialogue: 0,0:15:31.45,0:15:34.32,Narrator,,0,0,0,,Adı ise Rahibe Carmel idi.Dialogue: 0,0:15:35.08,0:15:38.29,Main,,0,0,0,,Cennet uzlaşma mı görmek istiyor? Neler saçmalıyorsun?Dialogue: 0,0:15:38.29,0:15:41.23,Main,,0,0,0,,Dünyanın dört bir yanında nasıl dehşet saçtıklarını biliyor musun?Dialogue: 0,0:15:41.23,0:15:44.12,Main,,0,0,0,,Kefaretleri için daha sağlam bir sebep işte! Neden anlamıyorsunuz?Dialogue: 0,0:15:54.87,0:15:56.76,Main,,0,0,0,,Onları öldürürseniz...Dialogue: 0,0:15:56.76,0:16:02.51,Main,,0,0,0,,...Elbaf savaşçıları insanlardan intikam almak için bir ordu kuracaktır.Dialogue: 0,0:16:03.27,0:16:05.36,Main,,0,0,0,,Günahlarını bağışlayın!Dialogue: 0,0:16:13.40,0:16:16.12,Main,,0,0,0,,Onlara bizzat öncülük edeceğim.Dialogue: 0,0:16:21.55,0:16:24.04,Main,,0,0,0,,Tüm ırkların el ele vererek...Dialogue: 0,0:16:26.06,0:16:27.92,Main,,0,0,0,,...birlikte gülümsediği bir dünyaya!Dialogue: 0,0:16:30.13,0:16:35.11,Narrator,,0,0,0,,Nihayetinde Carmel'e "Anne" ismini uygun görüp kökenlerini ayırt etmeksizin...Dialogue: 0,0:16:35.11,0:16:41.32,Narrator,,0,0,0,,...kimsesiz çocuklara kucak açtığı, Kuzu Yuvası adını verdikleri bir yetimhane açtılar.Dialogue: 0,0:16:43.00,0:16:45.53,Narrator,,0,0,0,,Devler'in yaşamını sürdürdüğü Elbaf'ta...Dialogue: 0,0:16:46.66,0:16:50.40,Narrator,,0,0,0,,...diğer yandan da Devler ve insanlar arasında bir köprü görevi gördü.Dialogue: 0,0:16:53.50,0:16:56.12,Narrator,,0,0,0,,Bu olaydan 37 yıl sonra...Dialogue: 0,0:16:57.02,0:16:59.74,Main,,0,0,0,,Artık emin ellerdesin Linlin.Dialogue: 0,0:16:57.02,0:17:02.87,Captions,,690,0,380,,Anne Carmel (80 Yaşında) ve Kuzu Yuvası ÇocuklarıDialogue: 0,0:16:59.74,0:17:03.46,Main,,0,0,0,,Ebeveynlerin dönene dek arkadaş olup birlikte yaşayalım!Dialogue: 0,0:17:03.46,0:17:07.15,Main,,0,0,0,,Bir daha dönmeyecekler! Seni terk ettiler!Dialogue: 0,0:17:07.15,0:17:10.55,Main,,0,0,0,,Burada hepimiz özelizdir.Dialogue: 0,0:17:10.55,0:17:12.38,Main,,0,0,0,,Hem de ailelerimizin bizi kapı dışarı edeceği kadar özeliz!Dialogue: 0,0:17:14.37,0:17:16.47,Main,,0,0,0,,Onlarla çabucak kaynaşırsın.Dialogue: 0,0:17:16.88,0:17:19.16,Main,,0,0,0,,Tamam. Teşekkür ederim.Dialogue: 0,0:17:19.16,0:17:21.27,Main,,0,0,0,,Çok açım!Dialogue: 0,0:17:21.27,0:17:23.74,Main,,0,0,0,,Kocamansın ama! Dev misin?Dialogue: 0,0:17:23.74,0:17:26.04,Main,,0,0,0,,Yemek yiyelim o zaman.Dialogue: 0,0:17:26.34,0:17:29.98,Narrator,,0,0,0,,Bir darbenin akabinde ülkesinden sürgün edilmiş bir prensten tutun...Dialogue: 0,0:17:30.65,0:17:33.42,Narrator,,0,0,0,,...yoksul oldukları için az daha köle edilecek bir çocuğa kadar...Dialogue: 0,0:17:34.05,0:17:37.18,Narrator,,0,0,0,,...ailelerinin bile baş gelemedikleri tüm bu yaramaz çocuklar...Dialogue: 0,0:17:37.18,0:17:41.97,Narrator,,0,0,0,,...kökenlerine bakılmaksızın Devler köyünde yaşıyorlardı.Dialogue: 0,0:17:43.86,0:17:45.06,Main,,0,0,0,,Baksana Anne!Dialogue: 0,0:17:45.06,0:17:47.08,Main,,0,0,0,,Bu kız yeni mi geldi?Dialogue: 0,0:17:50.13,0:17:55.30,Narrator,,0,0,0,,Her şey bir yana, daima etrafındakilerden daha iri olmuş Linlin için...Dialogue: 0,0:17:55.90,0:18:02.78,Narrator,,0,0,0,,...Elbaf; etrafındaki insanları, evleri ve her detayı kendi cüssesine göre bulduğu ilk yer olduğundan...Dialogue: 0,0:18:02.78,0:18:04.69,Narrator,,0,0,0,,...oldukça rahat ediyordu.Dialogue: 0,0:18:05.57,0:18:09.38,Main,,0,0,0,,Harika ya!Dialogue: 0,0:18:11.35,0:18:13.65,Captions,,0,0,0,,Sonraki GünDialogue: 0,0:18:14.08,0:18:18.13,Main,,0,0,0,,Niye böyle oldu? Niye böyle oldu ki?Dialogue: 0,0:18:20.48,0:18:22.77,Main,,0,0,0,,Ay kıyamam. Neyin var Linlin?Dialogue: 0,0:18:23.78,0:18:26.28,Main,,0,0,0,,Sorma Anne ya...Dialogue: 0,0:18:27.83,0:18:32.01,Main,,0,0,0,,...ayıcık ile kurtcuk ormanda kavga ediyorlardı.Dialogue: 0,0:18:32.01,0:18:36.10,Main,,0,0,0,,Kavga etmek yanlış olduğundan arkadaş olmalarına yardım etmem gerektiğini...Dialogue: 0,0:18:36.10,0:18:39.34,Main,,0,0,0,,...düşünerek dün onları aynı kafese koymuştum.Dialogue: 0,0:18:39.34,0:18:44.01,Main,,0,0,0,,Ama ayıcık, kurtcuğu yemiş.Dialogue: 0,0:18:44.01,0:18:46.85,Main,,0,0,0,,Ben de ayıcığa vuruverdim.Dialogue: 0,0:18:47.62,0:18:51.11,Main,,0,0,0,,Ayıcık yaptıklarından pişmanlık duyuyor gibi. Kaç kez vurdun?Dialogue: 0,0:18:51.95,0:18:53.40,Main,,0,0,0,,Sadece bir kez...Dialogue: 0,0:18:55.19,0:18:58.06,Thoughts,,0,0,0,,Tek bir darbede ayıyı öldürmüş mü?Dialogue: 0,0:19:06.14,0:19:07.80,Main,,0,0,0,,Anladım!Dialogue: 0,0:19:07.80,0:19:10.62,Main,,0,0,0,,Tek istediğin arkadaş olmalarını sağlamaktı!Dialogue: 0,0:19:11.23,0:19:13.83,Main,,0,0,0,,Linlin, çok temiz kalpli bir çocuksun!Dialogue: 0,0:19:15.22,0:19:16.58,Main,,0,0,0,,Evet.Dialogue: 0,0:19:16.58,0:19:20.14,Main,,0,0,0,,Haydi öyleyse, diğerleriyle oynamaya gidelim!Dialogue: 0,0:19:20.14,0:19:21.10,Main,,0,0,0,,Peki.Dialogue: 0,0:19:23.66,0:19:28.46,Narrator,,0,0,0,,Linlin'e göre Carmel,  kendisini gerçekten anlayan ilk insandı.Dialogue: 0,0:19:30.00,0:19:34.19,Main,,0,0,0,,Gözlerimle gördüm!  Linlin tek vuruşta ayıyı öldürdü!Dialogue: 0,0:19:34.19,0:19:35.81,Main,,0,0,0,,Kız çok tehlikeli!Dialogue: 0,0:19:36.24,0:19:39.32,Main,,0,0,0,,Dev Eiri-kun'un yaralandığını duydunuz mu?Dialogue: 0,0:19:39.92,0:19:42.82,Main,,0,0,0,,Üzerine konan bir sivrisineğe vurmak istemiş!Dialogue: 0,0:19:43.51,0:19:45.49,Main,,0,0,0,,Birkaç kemiğini kırmış!Dialogue: 0,0:19:47.12,0:19:49.36,Main,,0,0,0,,Acıyor! Canımı acıtıyorsun!Dialogue: 0,0:19:49.36,0:19:52.01,Main,,0,0,0,,Ne yapıyorsun Linlin?Dialogue: 0,0:19:52.01,0:19:53.02,Main,,0,0,0,,Ne oldu?Dialogue: 0,0:19:53.81,0:19:55.75,Main,,0,0,0,,Anne! Kurtar beni!Dialogue: 0,0:19:55.75,0:20:00.70,Main,,0,0,0,,Fazladan bir dirsek eklemi daha olduğundan onun yerine koparırsam sevinir dedim.Dialogue: 0,0:20:00.79,0:20:04.69,Main,,0,0,0,,Olmaz! Kendisi Uzun Kol Kabilesi'nden! Eklemleri öyle olmalı zaten!Dialogue: 0,0:20:04.69,0:20:07.38,Main,,0,0,0,,Demek öyle...Dialogue: 0,0:20:09.01,0:20:10.43,Main,,0,0,0,,Canımı acıtıyorsun!Dialogue: 0,0:20:10.43,0:20:13.01,Main,,0,0,0,,Linlin, ne yapıyorsun?Dialogue: 0,0:20:13.01,0:20:16.24,Main,,0,0,0,,Yüzgeçleri olduğundan onun yerine koparayım istedim.Dialogue: 0,0:20:16.24,0:20:20.75,Main,,0,0,0,,Yapma. Balık Adamlar'da balık özellikleri sıklıkla görülür!Dialogue: 0,0:20:20.75,0:20:23.13,Main,,0,0,0,,Hadi ya? Demek öyle...Dialogue: 0,0:20:24.48,0:20:25.65,Main,,0,0,0,,Çok korktum ya!Dialogue: 0,0:20:33.14,0:20:35.41,Main,,0,0,0,,Çocuklar, affedin onu!Dialogue: 0,0:20:35.70,0:20:38.10,Main,,0,0,0,,Linlin çok temiz kalpli bir kız!Dialogue: 0,0:20:42.68,0:20:45.43,Narrator,,0,0,0,,Carmel, onun yaptığı her şeyi bağışladı.Dialogue: 0,0:20:48.34,0:20:49.55,Main,,0,0,0,,Bekleyin, bekleyin!Dialogue: 0,0:20:51.89,0:20:53.90,Main,,0,0,0,,Linlin beni öldürecek!Dialogue: 0,0:20:53.90,0:20:57.14,Main,,0,0,0,,Beklesenize! Beklesenize!Dialogue: 0,0:20:57.43,0:21:00.79,Narrator,,0,0,0,,10 ay sonra Yeni Dünya'nın en güçlü ülkesi Elbaf'ta...Dialogue: 0,0:20:57.14,0:20:59.43,Captions,,0,0,0,,KashiDialogue: 0,0:21:01.36,0:21:05.57,Narrator,,0,0,0,,...ağır toplar Linlin'i aralarına kabul etmişlerdi.Dialogue: 0,0:21:01.85,0:21:04.38,Captions,,0,0,0,,OimoDialogue: 0,0:21:06.78,0:21:08.69,Main,,0,0,0,,Bekleyin! Bekleyin!Dialogue: 0,0:21:09.20,0:21:11.41,Main,,0,0,0,,Neredeyse 40 yıl oldu.Dialogue: 0,0:21:13.22,0:21:15.62,Main,,0,0,0,,Bu kadar uzun süren bir düello gördünüz mü hiç?Dialogue: 0,0:21:16.58,0:21:21.45,Main,,0,0,0,,Hiç görmedim!  10 yıl kadar sonra gidip onları alalım.Dialogue: 0,0:21:25.13,0:21:28.76,Main,,0,0,0,,Baksana Linlin! Hazırlandınız mı bakayım?Dialogue: 0,0:21:30.95,0:21:33.06,Main,,0,0,0,,Kashii, ne hazırlığı?Dialogue: 0,0:21:34.12,0:21:37.10,Main,,0,0,0,,Sahi Linlin-chan, sanırım ilk kez tecrübe edeceksin.Dialogue: 0,0:21:37.61,0:21:41.92,Main,,0,0,0,,Elbaf'ta Kış Gündönümü Festivali öncesi 12 gün boyunca perhize gireriz.Dialogue: 0,0:21:42.91,0:21:44.36,Main,,0,0,0,,Perhiz mi?Dialogue: 0,0:21:44.36,0:21:48.32,Main,,0,0,0,,Ağzımıza tek lokma koymayız. Yalnızca su içebiliriz.Dialogue: 0,0:21:48.94,0:21:51.17,Main,,0,0,0,,12 gün yarın başlıyor.Dialogue: 0,0:21:51.17,0:21:52.03,Main,,0,0,0,,Ne?Dialogue: 0,0:21:53.24,0:21:55.50,Main,,0,0,0,,Acıkırım ama!Dialogue: 0,0:21:55.50,0:21:58.71,Main,,0,0,0,,Ama dişini sıktın mı festival kutlayacağız!Dialogue: 0,0:22:03.09,0:22:05.59,Main,,0,0,0,,Kendinle savaş Hajrudin!Dialogue: 0,0:22:07.84,0:22:09.50,Main,,0,0,0,,Ayağa kalk Hajrudin!Dialogue: 0,0:22:16.35,0:22:21.06,Captions,,0,0,0,,HajrudinDialogue: 0,0:22:16.75,0:22:20.13,Narrator,,0,0,0,,Bu Dev çocuğu Hajrudin...Dialogue: 0,0:22:20.13,0:22:25.40,Narrator,,0,0,0,,...zamanla Dressrosa'da Luffy ile karşılaşıp kararlılığından etkilenecektir.Dialogue: 0,0:22:26.30,0:22:27.73,Narrator,,0,0,0,,Bartolomeo ve diğerleriyle birlikte...Dialogue: 0,0:22:27.73,0:22:30.20,Narrator,,0,0,0,,...baba-oğul bağı adı altında Luffy ile sake kadehlerini tokuşturmuşlardır.Dialogue: 0,0:22:31.20,0:22:34.72,Narrator,,0,0,0,,Artık Hasır Şapka Filosu'nun bir ferdidir.Dialogue: 0,0:22:37.01,0:22:38.24,Main,,0,0,0,,Çetin çocuk!Dialogue: 0,0:22:39.49,0:22:44.22,Main,,0,0,0,,Dorry ya da Brogy, iki şeften biri çıkageldiğinde...Dialogue: 0,0:22:44.22,0:22:47.38,Main,,0,0,0,,...Dev Korsanları yeniden ayağa kalkmış olacak!Dialogue: 0,0:22:47.73,0:22:51.30,Main,,0,0,0,,Sen bir savaşçısın! Kendini eğitmeye devam Hajrudin!Dialogue: 0,0:22:51.30,0:22:51.88,Main,,0,0,0,,Tamam!Dialogue: 0,0:22:53.66,0:22:56.72,Main,,0,0,0,,Ruh diye buna derim! Raideen!Dialogue: 0,0:22:56.72,0:22:57.52,Main,,0,0,0,,Evet!Dialogue: 0,0:23:06.94,0:23:09.51,Main,,0,0,0,,Şef Çağlayansakal Hazretleri! Şef Dağsakal Hazretleri!Dialogue: 0,0:23:06.32,0:23:13.82,Captions,,0,0,0,,"Dağsakal" Jarl             "Çağlayansakal" JorlDialogue: 0,0:23:06.32,0:23:13.82,Captions,,0,0,0,,  (345 Yaşında)Dialogue: 0,0:23:06.32,0:23:13.82,Captions,,0,0,0,,  (344 Yaşında)Dialogue: 0,0:23:09.51,0:23:14.00,Main,,0,0,0,,Carmel, yağmanın yerine ticaret üzerine telkinde bulunuyor, güzel bir yaklaşım.Dialogue: 0,0:23:14.00,0:23:17.91,Main,,0,0,0,,Gelgelelim savaşçı olduğumuzu da unutmamalıyız!Dialogue: 0,0:23:17.91,0:23:19.09,Main,,0,0,0,,Kesinlikle!Dialogue: 0,0:23:19.09,0:23:22.25,Main,,0,0,0,,Jarl-sama ile Jorl-sama çok havalı ya!Dialogue: 0,0:23:22.25,0:23:26.21,Captions,,0,0,0,,Dev Korsanları Eski Yardımcı Kaptanları (Dünyanın En Yaşlı İki Savaşçısı) Devler'in KahramanlarıDialogue: 0,0:23:22.75,0:23:26.21,Main,,0,0,0,,Tüm Devler savaşçı nezdinde onlara boşuna saygı duymuyor!Dialogue: 0,0:23:26.56,0:23:29.09,Main,,0,0,0,,Günün birinde onlar gibi olmak istiyorum!Dialogue: 0,0:23:30.89,0:23:33.13,Main,,0,0,0,,Sizi hangi rüzgâr attı?Dialogue: 0,0:23:33.91,0:23:38.81,Main,,0,0,0,,Köyde Semla yiyeceğiz,  Kuzu Yuvası'ndaki çocukları almaya geldik.Dialogue: 0,0:23:38.81,0:23:41.56,Main,,0,0,0,,Tam zamanında geldin Linlin.Dialogue: 0,0:23:41.83,0:23:43.18,Main,,0,0,0,,Semla nedir?Dialogue: 0,0:23:43.18,0:23:45.33,Main,,0,0,0,,Çok lezzetli bir tatlıdır!Dialogue: 0,0:23:45.33,0:23:46.77,Main,,0,0,0,,Ne? Tatlı mı?Dialogue: 0,0:23:46.77,0:23:50.48,Main,,0,0,0,,Perhizden önce Semla yiyerek birçok besin öğesi alırız!Dialogue: 0,0:23:50.81,0:23:55.20,Main,,0,0,0,,Hemen mi yiyeceğiz tatlıyı?Dialogue: 0,0:23:55.60,0:24:00.33,Main,,0,0,0,,Badem ezmeli tatlı ekmeğin arasına taptatlı krema sürülür.Dialogue: 0,0:24:00.33,0:24:02.72,Main,,0,0,0,,Üzerine de şeker tozu dökülür!Dialogue: 0,0:24:02.72,0:24:04.93,Main,,0,0,0,,Perhiz öncesi kutlama!Dialogue: 0,0:24:04.93,0:24:07.13,Main,,0,0,0,,Lezzetli duruyor!Dialogue: 0,0:24:10.46,0:24:12.51,Main,,0,0,0,,Pekâlâ ahali!Dialogue: 0,0:24:12.78,0:24:16.32,Main,,0,0,0,,Dün Prens Loki kalede dünyaya geldi!Dialogue: 0,0:24:16.86,0:24:21.43,Main,,0,0,0,,Köyde de Rodo ile Goldberg doğdu!Dialogue: 0,0:24:21.76,0:24:25.31,Main,,0,0,0,,Çocukların gelişimi için Güneş'e teşekkür edin!Dialogue: 0,0:24:25.31,0:24:26.94,Main,,0,0,0,,Teşekkürler Güneş!Dialogue: 0,0:24:26.94,0:24:29.65,Main,,0,0,0,,Şükürler olsun!Dialogue: 0,0:24:29.65,0:24:31.57,Main,,0,0,0,,Evet ya! Semla!Dialogue: 0,0:24:31.57,0:24:33.82,Main,,0,0,0,,Bir sürü yaptık, istediğiniz kadar yiyin!Dialogue: 0,0:24:39.94,0:24:41.83,Main,,0,0,0,,Çok tatlı!Dialogue: 0,0:24:42.34,0:24:44.00,Main,,0,0,0,,Enfes!Dialogue: 0,0:24:44.39,0:24:46.67,Main,,0,0,0,,Çok mutluyum ya!Dialogue: 0,0:24:51.49,0:24:54.59,Main,,0,0,0,,Enfes! Enfes! Tatlı! Tatlı! Enfes! Enfes!Dialogue: 0,0:24:54.59,0:24:55.67,Main,,0,0,0,,Enfes! Enfes!Dialogue: 0,0:25:03.43,0:25:04.72,Main,,0,0,0,,Enfes! Enfes!Dialogue: 0,0:25:03.78,0:25:06.01,Secondary,,0,0,0,,Bekle! Dur Linlin!Dialogue: 0,0:25:06.01,0:25:09.97,Main,,0,0,0,,O kadar hızlı yeme! Bize kalmayacak!Dialogue: 0,0:25:09.97,0:25:12.83,Main,,0,0,0,,Güneş'e teşekkür etmeyi de unutma!Dialogue: 0,0:25:13.57,0:25:16.57,Main,,0,0,0,,Semla!!Dialogue: 0,0:25:19.16,0:25:25.15,Main,,0,0,0,,Enfes! Çok lezzetli ya! Semla!Dialogue: 0,0:25:28.29,0:25:32.29,Captions,,0,0,0,,Perhiz, 3. GünDialogue: 0,0:25:29.26,0:25:32.67,Main,,0,0,1,,Anne, açlıktan ölüyorum.Dialogue: 0,0:25:32.67,0:25:36.84,Main,,0,0,0,,Kış Gündönümü Festivali'nde ölümü ve Güneş'in doğuşunu kutlarız.Dialogue: 0,0:25:37.13,0:25:42.93,Main,,0,0,0,,Zorlu kışa göğüs gerdikten sonra Güneş tekrar üzerimizde doğacaktır.Dialogue: 0,0:25:42.94,0:25:45.31,Captions,,0,0,0,,Perhiz, 4. GünDialogue: 0,0:25:45.60,0:25:50.23,Main,,0,0,0,,Ne kadar zorlanırsan Güneş'in değerini o kadar iyi bilirsin.Dialogue: 0,0:25:50.23,0:25:52.74,Main,,0,0,0,,O yüzden... Dişimizi sıkalım.Dialogue: 0,0:25:56.74,0:26:01.16,Main,,0,0,0,,Sen öyle diyorsan Anne, dişimi sıkacağım.Dialogue: 0,0:26:03.37,0:26:05.87,Captions,,0,0,0,,Perhiz, 5. GünDialogue: 0,0:26:07.11,0:26:08.50,Main,,0,0,0,,Kilo veriyorum.Dialogue: 0,0:26:08.50,0:26:10.04,Main,,0,0,0,,Zerre değişmedin.Dialogue: 0,0:26:10.04,0:26:13.05,Main,,0,0,0,,Öyle mi? Çok tuhaf.Dialogue: 0,0:26:13.05,0:26:13.92,Main,,0,0,0,,Linlin!Dialogue: 0,0:26:15.31,0:26:17.92,Main,,0,0,0,,Çok iyi gidiyorsun! Biraz daha dayan!Dialogue: 0,0:26:19.31,0:26:19.90,Main,,0,0,0,,Uh-huh!Dialogue: 0,0:21:22.11,0:21:23.13,Default,,0,0,0,,Tamam!Dialogue: 0,0:26:20.45,0:26:23.76,Narrator,,0,0,0,,Linlin, Anne'ye büyük bir sevgi beslemeye başlamıştı.Dialogue: 0,0:26:24.14,0:26:26.64,Captions,,0,0,0,,Perhiz, 6. GünDialogue: 0,0:26:27.71,0:26:30.48,Main,,0,0,0,,Semla çok lezzetliydi ya...Dialogue: 0,0:26:32.66,0:26:33.86,Main,,0,0,0,,Yine...Dialogue: 0,0:26:35.32,0:26:38.23,Main,,0,0,0,,...yemek istiyorum!Dialogue: 0,0:26:43.20,0:26:45.70,Captions,,0,0,0,,Perhiz, 7. GünDialogue: 0,0:26:49.20,0:26:50.12,Main,,0,0,0,,Eyvahlar olsun!Dialogue: 0,0:26:53.30,0:26:54.79,Main,,0,0,0,,Anne, yetiş!Dialogue: 0,0:26:56.62,0:26:58.05,Main,,0,0,0,,Ne oldu Gerd?Dialogue: 0,0:27:00.13,0:27:01.68,Main,,0,0,0,,Linlin-chan...Dialogue: 0,0:27:10.01,0:27:10.77,Main,,0,0,0,,Bu...Dialogue: 0,0:27:12.01,0:27:16.53,Main,,0,0,0,,Semla!!Dialogue: 0,0:27:16.53,0:27:17.69,Main,,0,0,0,,Nasıl yaparsın?Dialogue: 0,0:27:18.30,0:27:19.24,Main,,0,0,0,,Linlin!Dialogue: 0,0:27:19.77,0:27:22.95,Main,,0,0,0,,Semla getirin bana!Dialogue: 0,0:27:22.95,0:27:26.53,Main,,0,0,0,,Semla!Dialogue: 0,0:27:28.95,0:27:32.25,Main,,0,0,0,,Linlin, Elbaf köyünü yok etti!Dialogue: 0,0:27:32.86,0:27:34.42,Main,,0,0,0,,Gerçek olamaz!Dialogue: 0,0:27:37.13,0:27:42.34,Main,,0,0,0,,Şimdi yapacağını yaptın işte Linlin! Güneş'e minnettar olma hakkın yok!Dialogue: 0,0:27:42.34,0:27:45.68,Main,,0,0,0,,Çocuk da olsa, sineye çekeceklerimizin bir sınırı vardır!Dialogue: 0,0:27:45.94,0:27:46.97,Main,,0,0,0,,Jorl-sama!Dialogue: 0,0:27:47.51,0:27:49.93,Main,,0,0,0,,Semla... Semla...Dialogue: 0,0:27:50.57,0:27:52.42,Main,,0,0,0,,Carmel... Üzgünüm...Dialogue: 0,0:27:52.42,0:27:55.69,Main,,0,0,0,,Çocuk suretinde olabilir ama...Dialogue: 0,0:27:55.69,0:27:57.56,Main,,0,0,0,,Yapmayın! Jorl-sama!Dialogue: 0,0:27:57.56,0:27:59.08,Main,,0,0,0,,...aslında bir şeytan!Dialogue: 0,0:28:08.58,0:28:11.95,Main,,0,0,0,,Semla...Dialogue: 0,0:28:10.58,0:28:15.60,Credits,,0,0,0,,Editing:  Feeso, Galaxy 9000  Timing: KaitouYahiko  Quality Control: Feeso, Galaxy 9000, Grug, Pepperjack  Soundtracking:  Halee  Graphics:  Datenshi  Karaoke: KaitouYahiko  Translation: Crunchyroll