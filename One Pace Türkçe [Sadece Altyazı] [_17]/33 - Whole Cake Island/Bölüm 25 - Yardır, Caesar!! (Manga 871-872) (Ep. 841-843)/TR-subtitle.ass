yle: Author,Impress BT,22.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.7,0.7,9,10,10,10,1Style: Attack,Duality,30.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.0,1.0,7,12,12,12,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:02.55,0:00:04.79,Main,,0,0,0,,Kaleyi ortadan kaldırdı.Dialogue: 0,0:00:11.06,0:00:14.69,Main,,0,0,0,,Ne demiştim ben? Bildiğin hedef tahtasıyız!Dialogue: 0,0:00:16.61,0:00:20.57,Main,,0,0,0,,Çıktınız demek pireler!Dialogue: 0,0:00:22.44,0:00:24.72,Main,,0,0,0,,Öldük biz!Dialogue: 0,0:01:00.28,0:01:01.60,Main,,0,0,0,,Germa!Dialogue: 0,0:01:01.60,0:01:02.82,Main,,0,0,0,,Çabuk olun!Dialogue: 0,0:01:03.31,0:01:05.85,Main,,0,0,0,,U- Ulan... Neden ben yapıyorum ki?Dialogue: 0,0:01:05.85,0:01:08.30,Main,,0,0,0,,Yeter artık!Dialogue: 0,0:01:18.49,0:01:20.02,Main,,0,0,0,,Durun!Dialogue: 0,0:01:24.10,0:01:25.78,Main,,0,0,0,,Heavenly...Dialogue: 0,0:01:24.10,0:01:25.78,Attack,,0,0,0,,Semavi...Dialogue: 0,0:01:28.88,0:01:30.57,Main,,0,0,0,,Feuer!Dialogue: 0,0:01:28.88,0:01:30.57,Attack,,0,0,0,,...AteşDialogue: 0,0:01:44.75,0:01:45.87,Main,,0,0,0,,Reiju!Dialogue: 0,0:01:45.87,0:01:48.34,Main,,0,0,0,,Önünüze bakın Niji! Yonji!Dialogue: 0,0:01:48.34,0:01:52.18,Main,,0,0,0,,Zayıf olması kendi suçudur! Görevinize odaklanın!Dialogue: 0,0:01:52.18,0:01:54.66,Main,,0,0,0,,Ne kadar da itici bir kardeşim var.Dialogue: 0,0:01:54.66,0:01:57.31,Main,,0,0,0,,Sorun değil! Yenilmeyeceğim!Dialogue: 0,0:02:00.82,0:02:05.20,Main,,0,0,0,,Seninle başlayacağım!  Bacaksız Germa kızı!Dialogue: 0,0:02:07.66,0:02:09.54,Main,,0,0,0,,Gomu Gomu no...Dialogue: 0,0:02:10.44,0:02:13.42,Main,,0,0,0,,Diable Jambe: Crosse...Dialogue: 0,0:02:10.44,0:02:13.42,Attack,,0,0,0,,Şeytan Bacak: Kıç...Dialogue: 0,0:02:16.12,0:02:17.80,Main,,0,0,0,,Elephant Gun!Dialogue: 0,0:02:16.12,0:02:17.80,Attack,,0,0,0,,...Fil TüfeğiDialogue: 0,0:02:18.54,0:02:19.88,Main,,0,0,0,,Strike!Dialogue: 0,0:02:18.54,0:02:19.88,Attack,,0,0,0,,...DarbesiDialogue: 0,0:02:24.76,0:02:27.24,Main,,0,0,0,,Bana çıkma diyene bak hele!Dialogue: 0,0:02:27.24,0:02:30.96,Main,,0,0,0,,Dedim, sen çıkma! Ben çıkarım!Dialogue: 0,0:02:30.96,0:02:32.48,Main,,0,0,0,,Yerim öyle işi!Dialogue: 0,0:02:32.48,0:02:33.64,Main,,0,0,0,,Gittiler...Dialogue: 0,0:02:33.64,0:02:36.56,Main,,0,0,0,,N'apıyorsunuz siz be, aptallar?Dialogue: 0,0:04:12.76,0:04:17.64,Main,,0,0,0,,Ne diye sıvışmaya çalışıyorsunuz ki?Dialogue: 0,0:04:22.42,0:04:29.13,Main,,0,0,0,,Balık Adam Adası'nda bana ne söylediğini hatırlıyor musun Hasır Şapka?Dialogue: 0,0:04:30.08,0:04:33.92,Main,,0,0,0,,"Canına okuyacağım." demiştin.Dialogue: 0,0:04:37.65,0:04:39.96,Flashbacks,,0,0,0,,Monkey D. Luffy...Dialogue: 0,0:04:40.72,0:04:42.97,Flashbacks,,0,0,0,,Adını kafama kazıdım.Dialogue: 0,0:04:43.80,0:04:46.97,Flashbacks,,0,0,0,,Yeni Dünya'ya gel bakalım!Dialogue: 0,0:04:48.93,0:04:51.26,Flashbacks,,0,0,0,,Tabii, geliyorum.Dialogue: 0,0:04:52.48,0:04:56.17,Flashbacks,,0,0,0,,Yeni Dünya'da gününü gösterip...Dialogue: 0,0:04:56.90,0:05:00.57,Flashbacks,,0,0,0,,...Balık Adam Adası'nı himayem altına alacağım!Dialogue: 0,0:05:00.57,0:05:04.83,Main,,0,0,0,,Peki bu adaya geldikten sonra söylediklerini?Dialogue: 0,0:05:05.72,0:05:10.08,Main,,0,0,0,,"Son gülen biz olacağız." demiştin.Dialogue: 0,0:05:10.08,0:05:13.80,Flashbacks,,0,0,0,,Korsanlar Kralı olamayan ise sendin.Dialogue: 0,0:05:13.80,0:05:15.84,Flashbacks,,0,0,0,,Bahanelere sığınma!Dialogue: 0,0:05:16.34,0:05:18.84,Flashbacks,,0,0,0,,Tekrar dövüşelim!Dialogue: 0,0:05:18.84,0:05:22.68,Flashbacks,,0,0,0,,Sırf Yonkou'sun diye kendini bir halt sanma!Dialogue: 0,0:05:22.68,0:05:25.19,Flashbacks,,0,0,0,,Sanji'yi geri alacağım!Dialogue: 0,0:05:25.19,0:05:29.02,Flashbacks,,0,0,0,,Son gülen biz olacağız!Dialogue: 0,0:05:29.02,0:05:33.95,Main,,0,0,0,,Şimdi de kuyruğunu kıstırıp kaçıyor musun, ödlek?Dialogue: 0,0:05:33.95,0:05:35.68,Main,,0,0,0,,Ö... Ö...Dialogue: 0,0:05:35.68,0:05:38.06,Main,,0,0,0,,Ödlek mi?Dialogue: 0,0:05:39.23,0:05:43.71,Main,,0,0,0,,- Yemi yutma Luffy! Seni tahrik ediyor! - Bir tane geçireyim yeter!Dialogue: 0,0:05:43.71,0:05:44.90,Main,,0,0,0,,Dur! Luffy!Dialogue: 0,0:05:44.90,0:05:47.61,Main,,0,0,0,,Lafımın arkasındayım!Dialogue: 0,0:05:47.61,0:05:49.82,Main,,0,0,0,,Big Mom!Dialogue: 0,0:06:12.04,0:06:15.92,Main,,0,0,0,,Nihayetinde Korsanlar Kralı olacak kişi...Dialogue: 0,0:06:21.56,0:06:24.53,Main,,0,0,0,,...benim!Dialogue: 0,0:06:48.90,0:06:54.63,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - dmc3 thx to onepace.netDialogue: 0,0:17:15.30,0:17:25.30,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - dmc3 thx to onepace.netDialogue: 0,0:35:35.27,0:35:41.37,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - dmc3 thx to onepace.netDialogue: 0,0:06:48.90,0:06:54.63,Title,,0,0,420,,Yardır, Caesar!!Dialogue: 0,0:06:52.85,0:06:54.69,Main,,0,0,0,,Helal Germa!Dialogue: 0,0:06:54.69,0:06:57.04,Main,,0,0,0,,Beni korumaya devam edin!Dialogue: 0,0:06:57.04,0:06:58.72,Main,,0,0,0,,Budalalar!Dialogue: 0,0:06:59.22,0:07:01.73,Main,,0,0,0,,Mama'ya kafa tutan herkes...Dialogue: 0,0:07:01.73,0:07:04.92,Main,,0,0,0,,...ellerimde yanarak can verecektir!Dialogue: 0,0:07:05.72,0:07:07.57,Main,,0,0,0,,Taşaklı biri geldi!Dialogue: 0,0:07:07.57,0:07:09.60,Main,,0,0,0,,Ciğersiz Oven demek?Dialogue: 0,0:07:09.92,0:07:12.74,Main,,0,0,0,,Siz ikinizle başlıyorum!Dialogue: 0,0:07:20.04,0:07:22.54,Main,,0,0,0,,Burayı sen halledersin.Dialogue: 0,0:07:22.54,0:07:24.74,Main,,0,0,0,,Yanarak can vermek mi?Dialogue: 0,0:07:24.74,0:07:28.45,Main,,0,0,0,,O fırsatı bulamadan temiz bir dayak yiyeceksin!Dialogue: 0,0:07:28.45,0:07:30.47,Main,,0,0,0,,Ukalaya bak!Dialogue: 0,0:07:30.47,0:07:33.16,Main,,0,0,0,,Duvardan geçirmeye bak bizi!Dialogue: 0,0:07:33.16,0:07:35.54,Main,,0,0,0,,Biz n'apıyorsak!Dialogue: 0,0:07:36.10,0:07:38.25,Main,,0,0,0,,Bitmek bilmiyorlar!Dialogue: 0,0:07:43.39,0:07:46.63,Main,,0,0,0,,Şu duvarı bir aştım mı hayatta kalırım!Dialogue: 0,0:07:48.44,0:07:51.35,Main,,0,0,0,,Kaçmalarına izin vermeyeceğim.Dialogue: 0,0:07:51.70,0:07:53.54,Main,,0,0,0,,Candy Wall!Dialogue: 0,0:07:51.70,0:07:53.54,Attack,,0,0,0,,Şeker DuvarıDialogue: 0,0:07:57.23,0:07:58.44,Main,,0,0,0,,Olamaz!Dialogue: 0,0:08:01.92,0:08:03.57,Main,,0,0,0,,Ne?Dialogue: 0,0:08:03.57,0:08:07.44,Main,,0,0,0,,B- Bu da ne lan?Dialogue: 0,0:08:08.30,0:08:10.46,Main,,0,0,0,,Perospero'nun işidir.Dialogue: 0,0:08:10.46,0:08:13.24,Main,,0,0,0,,Son umudumuz da gitti...Dialogue: 0,0:08:17.10,0:08:21.08,Main,,0,0,0,,Elveda özgürlüğüm!Dialogue: 0,0:08:21.08,0:08:23.87,Main,,0,0,0,,Olamaz! Bizi yutacak! Geri çekil!Dialogue: 0,0:08:23.87,0:08:26.55,Main,,0,0,0,,Çekilmeyin, dümdüz devam!Dialogue: 0,0:08:35.56,0:08:36.60,Main,,0,0,0,,Black...Dialogue: 0,0:08:35.56,0:08:36.60,Attack,,0,0,0,,Kara...Dialogue: 0,0:08:37.42,0:08:37.98,Main,,0,0,0,,Bug!Dialogue: 0,0:08:37.42,0:08:37.98,Attack,,0,0,0,,...BöcekDialogue: 0,0:08:46.48,0:08:47.53,Main,,0,0,0,,Gidin!Dialogue: 0,0:08:47.53,0:08:49.32,Main,,0,0,0,,Ne? Ama...Dialogue: 0,0:08:58.25,0:08:59.76,Main,,0,0,0,,Eyvah...Dialogue: 0,0:09:01.54,0:09:06.43,Main,,0,0,0,,Götümüzü kurtardın Germa 66!Dialogue: 0,0:09:06.43,0:09:10.67,Main,,0,0,0,,İşte bu! Şeker duvarından geçti! Bunu Germa'dan başkası yapamazdı!Dialogue: 0,0:09:11.57,0:09:14.65,Main,,0,0,0,,Yürü be Caesar!Dialogue: 0,0:09:14.65,0:09:17.00,Main,,0,0,0,,Aşağılığın teki olsan da.Dialogue: 0,0:09:17.67,0:09:22.49,Main,,0,0,0,,Sıçarım lan! Buraya kadar gelmişim! Ölmek istemiyorum!Dialogue: 0,0:09:22.49,0:09:27.91,Main,,0,0,0,,Bu duvarı aştım mı...Dialogue: 0,0:09:27.91,0:09:31.08,Main,,0,0,0,,...özgürüm demektir!Dialogue: 0,0:09:34.79,0:09:39.59,Main,,0,0,0,,S- Saklı deniz altı hazinesi Tamatebako hemen burnumun dibinde ama...Dialogue: 0,0:09:41.51,0:09:45.08,Main,,0,0,0,,Gitmiş nereye düşmüş ya-nen...Dialogue: 0,0:09:45.67,0:09:48.28,Main,,0,0,0,,Başka çarem yok. Atlayacağım.Dialogue: 0,0:09:48.28,0:09:51.59,Main,,0,0,0,,Tamatebako ile n'apacaksın Du Feld?Dialogue: 0,0:09:51.59,0:09:53.62,Main,,0,0,0,,S- Sen...Dialogue: 0,0:09:54.46,0:09:57.45,Main,,0,0,0,,...Stussy! İzliyor muydun?Dialogue: 0,0:10:04.29,0:10:06.31,Main,,0,0,0,,Fena düştüm.Dialogue: 0,0:10:06.31,0:10:09.40,Main,,0,0,0,,Lakin içini görebilirim artık.Dialogue: 0,0:10:11.68,0:10:16.97,Main,,0,0,0,,Saklı deniz altı hazinesi... Ederini görelim bakalım!Dialogue: 0,0:10:25.18,0:10:26.44,Main,,0,0,0,,Tobu Shigan...Dialogue: 0,0:10:25.18,0:10:26.44,Attack,,0,0,0,,Fırlayan Parmak Tabancası...Dialogue: 0,0:10:26.44,0:10:30.20,Main,,0,0,0,,Tamatebako bizim, Dünya Hükûmeti'nin olacak.Dialogue: 0,0:10:27.28,0:10:30.65,Captions,,50,0,40,,Eski Lakabı "Şehvet Bölgesi Kraliçesi"Dialogue: 0,0:10:31.45,0:10:35.62,Captions,,0,0,0,,CP "Kalkan" 0, İstihbarat Ajanı StussyDialogue: 0,0:10:33.76,0:10:35.62,Main,,0,0,0,,Beyinsiz kazma.Dialogue: 0,0:10:35.62,0:10:39.12,Main,,0,0,0,,Tabii suçu sana yıkacağım.Dialogue: 0,0:10:39.66,0:10:42.12,Main,,0,0,0,,Sen de haberi böyle yaparsın, değil mi...Dialogue: 0,0:10:42.12,0:10:44.58,Main,,0,0,0,,Morgans?Dialogue: 0,0:10:43.12,0:10:44.58,Thoughts,,0,0,0,,Beni fark etmiş!Dialogue: 0,0:10:44.58,0:10:48.61,Main,,0,0,0,,Olur da en azından içinde ne olduğunu yazabilir miyim?Dialogue: 0,0:10:48.61,0:10:52.61,Main,,0,0,0,,Tabii, fotoğraf çekebilirsin. Kafan çalışıyormuş.Dialogue: 0,0:10:52.61,0:10:54.47,Main,,0,0,0,,Gerçekleri çarpıtıp haber yapan birinden de bu beklenirdi.Dialogue: 0,0:10:54.47,0:10:56.76,Main,,0,0,0,,Hadi oradan, gazeteciyim ben! Bak seni dava ederim!Dialogue: 0,0:11:00.23,0:11:02.02,Main,,0,0,0,,- Ne? - Olamaz!Dialogue: 0,0:11:09.85,0:11:12.19,Main,,0,0,0,,Kaido'yu devirdikten sonra...Dialogue: 0,0:11:14.77,0:11:16.65,Main,,0,0,0,,...sıra sana gelecek!Dialogue: 0,0:11:17.52,0:11:20.57,Main,,0,0,0,,Big Mom!Dialogue: 0,0:11:27.58,0:11:29.33,Main,,0,0,0,,Gıdıkladı!Dialogue: 0,0:11:32.46,0:11:33.63,Main,,0,0,0,,Luffy...Dialogue: 0,0:11:35.17,0:11:38.38,Main,,0,0,0,,Tek yumrukta anlaşmamış mıydık?Dialogue: 0,0:11:38.38,0:11:40.90,Main,,0,0,0,,Kaido mu?Dialogue: 0,0:11:43.76,0:11:48.52,Main,,0,0,0,,O herif boyunuzu aşar.Dialogue: 0,0:11:50.07,0:11:54.52,Main,,0,0,0,,Şerefsizler, ayrıca...Dialogue: 0,0:11:55.02,0:12:01.57,Main,,0,0,0,,...bölgemden kaçabilme hayalini nasıl kurabiliyorsunuz ki?Dialogue: 0,0:12:07.45,0:12:09.24,Main,,0,0,0,,Big Mom!Dialogue: 0,0:12:10.39,0:12:14.04,Main,,0,0,0,,Hayalimiz yerle bir oldu bir kere.Dialogue: 0,0:12:15.25,0:12:19.39,Main,,0,0,0,,Hayal gibi 66 günlük kısa bir sürenin ardından geride kalan ve...Dialogue: 0,0:12:19.39,0:12:23.92,Main,,0,0,0,,...memleketlerinde adım atacakları bir toprak kalmayan hayaletlerin...Dialogue: 0,0:12:25.39,0:12:28.51,Main,,0,0,0,,...yüzüne bakamam!Dialogue: 0,0:12:34.44,0:12:36.52,Main,,0,0,0,,Judge!Dialogue: 0,0:12:40.48,0:12:42.34,Main,,0,0,0,,Senin gibi birine...Dialogue: 0,0:12:42.34,0:12:47.15,Main,,0,0,0,,...krallığımızın 300 yıllık intikam arzusunu emanet etmemeliydim!Dialogue: 0,0:12:47.15,0:12:49.95,Main,,0,0,0,,Kendimden tiksiniyorum!Dialogue: 0,0:12:54.47,0:12:57.19,Main,,0,0,0,,İşlemez!Dialogue: 0,0:12:59.00,0:13:01.64,Main,,0,0,0,,Gözün arkada kalmadan ölebilirsin!Dialogue: 0,0:13:01.64,0:13:05.26,Main,,0,0,0,,Bilimsel teknolojinizi kullanarak...Dialogue: 0,0:13:06.92,0:13:11.64,Main,,0,0,0,,...dünyaya barışı getireceğim!Dialogue: 0,0:13:26.06,0:13:27.56,Main,,0,0,0,,Raitei!Dialogue: 0,0:13:26.06,0:13:27.56,Attack,,0,0,0,,Yıldırım OkuDialogue: 0,0:13:32.19,0:13:33.23,Main,,0,0,0,,Baba-sama!Dialogue: 0,0:13:41.49,0:13:42.78,Main,,0,0,0,,Öldü mü?Dialogue: 0,0:13:42.78,0:13:43.69,Main,,0,0,0,,Baba!Dialogue: 0,0:13:43.69,0:13:45.57,Main,,0,0,0,,Durun lan korumalar!Dialogue: 0,0:13:45.57,0:13:49.04,Main,,0,0,0,,Bizi açıkta mı bırakıyorsunuz...Dialogue: 0,0:14:00.11,0:14:02.72,Main,,0,0,0,,Katakuri!Dialogue: 0,0:14:02.72,0:14:04.68,Main,,0,0,0,,Neredeyse başarıyordunuz.Dialogue: 0,0:14:05.22,0:14:07.22,Main,,0,0,0,,Ramak kalmıştı.Dialogue: 0,0:14:14.68,0:14:16.10,Main,,0,0,0,,Sparking...Dialogue: 0,0:14:14.68,0:14:16.10,Attack,,0,0,0,,Kıvılcımlanan...Dialogue: 0,0:14:16.78,0:14:17.78,Main,,0,0,0,,Figure!Dialogue: 0,0:14:16.78,0:14:17.78,Attack,,0,0,0,,...Silüet!Dialogue: 0,0:14:20.40,0:14:24.40,Main,,0,0,0,,Tasalanma.  Görevimizi yerine getireceğiz. Kaç hadi!Dialogue: 0,0:14:24.40,0:14:25.99,Main,,0,0,0,,Herhâlde kaçacağım lan!Dialogue: 0,0:14:27.87,0:14:31.16,Main,,0,0,0,,Beni gafil avladığını mı sanıyorsun?Dialogue: 0,0:14:33.96,0:14:36.62,Main,,0,0,0,,Ecelinize susamışsınız galiba.Dialogue: 0,0:14:36.62,0:14:39.21,Main,,0,0,0,,Beni tehdit etmen yersiz.Dialogue: 0,0:14:39.21,0:14:43.13,Main,,0,0,0,,Üzülerek söylüyorum ki... Korku hissinden yoksunum.Dialogue: 0,0:14:47.03,0:14:49.86,Main,,0,0,0,,Kaçırmayın! Ateş, ateş!Dialogue: 0,0:14:49.86,0:14:51.70,Main,,0,0,0,,İleri! Başarabilirsin-rero!Dialogue: 0,0:14:51.70,0:14:53.54,Main,,0,0,0,,İşte bu! Devam!Dialogue: 0,0:14:53.54,0:14:55.54,Main,,0,0,0,,Başarabilirsin Caesar!Dialogue: 0,0:14:55.54,0:14:57.04,Main,,0,0,0,,Her ne kadar aşağılığın teki olsan da!Dialogue: 0,0:14:57.04,0:14:58.96,Main,,0,0,0,,Ha? Ne dedin sen?Dialogue: 0,0:15:01.84,0:15:04.27,Main,,0,0,0,,Önüne baksana lan...Dialogue: 0,0:15:04.27,0:15:05.05,Main,,0,0,0,,Ne?Dialogue: 0,0:15:09.02,0:15:10.95,Main,,0,0,0,,- Lan! Çekilsene! - Lan! Çekilsene!Dialogue: 0,0:15:10.95,0:15:13.31,Main,,0,0,0,,- Ha? Kimsin oğlum sen? - Ha? Kimsin oğlum sen?Dialogue: 0,0:15:15.86,0:15:17.27,Main,,0,0,0,,- Bensin! - Bensin!Dialogue: 0,0:15:17.27,0:15:20.21,Main,,0,0,0,,- Hayır ya, ben olamaz ki! - Hayır ya, ben olamaz ki!Dialogue: 0,0:15:20.21,0:15:24.66,Main,,0,0,0,,Benim yahu Caesar Clown!Dialogue: 0,0:15:24.66,0:15:25.95,Main,,0,0,0,,Brûlée!Dialogue: 0,0:15:28.33,0:15:30.38,Main,,0,0,0,,Kaçamazsınız.Dialogue: 0,0:15:30.38,0:15:34.39,Main,,0,0,0,,Size beslediğim kinim dağ kadar olmuş.Dialogue: 0,0:15:34.39,0:15:38.38,Main,,0,0,0,,Nihayet biraz olsun acısını çıkarma fırsatı yakaladım!Dialogue: 0,0:15:42.64,0:15:45.76,Main,,0,0,0,,Başımız belada Caesar!Dialogue: 0,0:15:57.11,0:15:59.45,Main,,0,0,0,,Hepsi yenildi mi?Dialogue: 0,0:16:02.79,0:16:04.62,Main,,0,0,0,,Olamaz ya...Dialogue: 0,0:16:16.09,0:16:18.13,Main,,0,0,0,,Yolun sonuna geldik.Dialogue: 0,0:16:20.80,0:16:22.22,Main,,0,0,0,,Olamaz.Dialogue: 0,0:16:22.22,0:16:24.60,Main,,0,0,0,,Germa!Dialogue: 0,0:16:25.35,0:16:29.44,Main,,0,0,0,,Bu gidişle hiç şüphesiz hepimizi de öldürecekler.Dialogue: 0,0:16:29.44,0:16:31.02,Main,,0,0,0,,Bunu kabullenmiyorum!Dialogue: 0,0:16:31.02,0:16:32.70,Main,,0,0,0,,Öyleyse...Dialogue: 0,0:16:37.07,0:16:40.41,Main,,0,0,0,,Tek çaremiz var.Dialogue: 0,0:16:43.99,0:16:46.70,Main,,0,0,0,,Öylece oturup ecelimizi beklemektense...Dialogue: 0,0:16:47.16,0:16:50.04,Main,,0,0,0,,Savaşacağız, değil mi?Dialogue: 0,0:16:50.04,0:16:52.29,Main,,0,0,0,,- Ben de geliyorum! - Ben de!Dialogue: 0,0:16:52.29,0:16:54.63,Main,,0,0,0,,Biz de geliyoruz tabii ki!Dialogue: 0,0:16:54.63,0:16:56.88,Main,,0,0,0,,Başka çaremiz yok.Dialogue: 0,0:17:12.19,0:17:14.39,Main,,0,0,0,,Tamatebako!Dialogue: 0,0:17:26.39,0:17:30.56,Main,,0,0,0,,Pekâlâ, infazlara...Dialogue: 0,0:17:30.56,0:17:33.42,Main,,0,0,0,,...başlayalım.Dialogue: 0,0:17:53.62,0:17:55.04,Main,,0,0,0,,N'oluyor?Dialogue: 0,0:18:20.48,0:18:24.11,Narrator,,0,0,0,,Zamanda biraz geriye gidelim...Dialogue: 0,0:18:25.90,0:18:29.66,Captions,,0,0,0,,Ryugu Krallığı - Balık Adam AdasıDialogue: 0,0:18:29.70,0:18:34.45,Narrator,,0,0,0,,Ryugu Krallığını Yeni Balık Adam Korsanları'ndan kurtaran Luffyler...Dialogue: 0,0:18:34.45,0:18:39.14,Narrator,,0,0,0,,...teşekkür mahiyetinde Kral Neptune'den Tamatebako'yu almayı kabul etmişlerdir.Dialogue: 0,0:18:39.14,0:18:40.50,Narrator,,0,0,0,,Lakin...Dialogue: 0,0:18:40.50,0:18:42.18,Main,,0,0,0,,Majesteleri!Dialogue: 0,0:18:42.18,0:18:48.36,Main,,0,0,0,,Çalınan tüm hazineleri Luffy-kunlar'a verme konusunda... Şayet bulabilirlerse...Dialogue: 0,0:18:48.36,0:18:52.43,Main,,0,0,0,,...yalnızca Tamatebako'yu geri vermelerini rica etmem gerekiyor.Dialogue: 0,0:18:52.43,0:18:54.25,Main,,0,0,0,,Neler diyorsun?Dialogue: 0,0:18:54.25,0:18:58.52,Main,,0,0,0,,Verdiğim bir hediyeyi geri isteyecek değilim!Dialogue: 0,0:18:58.52,0:19:02.27,Main,,0,0,0,,İçindeki bir hazine değil de...Dialogue: 0,0:19:02.27,0:19:04.40,Main,,0,0,0,,...bomba olsa bile mi?Dialogue: 0,0:19:04.40,0:19:05.65,Main,,0,0,0,,Ne?Dialogue: 0,0:19:05.65,0:19:08.32,Main,,0,0,0,,Açınca büyük bir patlama mı olacak?Dialogue: 0,0:19:08.32,0:19:10.87,Main,,0,0,0,,Derhâl geri istemeliyim!Dialogue: 0,0:19:13.33,0:19:17.83,Main,,0,0,0,,Tüm hazineyi Big Mom'a mı verdiniz?Dialogue: 0,0:19:17.83,0:19:21.00,Main,,0,0,0,,Belki de patlamaz Adalet Bakanı'm.Dialogue: 0,0:19:21.00,0:19:25.12,Main,,0,0,0,,Majesteleri, fazla iyimsersiniz!Dialogue: 0,0:19:25.12,0:19:30.02,Captions,,0,970,365,,Whole Cake AdasıDialogue: 0,0:19:27.38,0:19:30.01,Narrator,,0,0,0,,Günümüze dönecek olursak...Dialogue: 0,0:19:32.88,0:19:38.06,Captions,,0,950,345,,Whole Cake Şatosu'nun İçiDialogue: 0,0:19:33.49,0:19:35.54,Main,,0,0,0,,İkinci kattaki Doğu Baum Pastası tavanından başlayan...Dialogue: 0,0:19:35.54,0:19:38.73,Main,,0,0,0,,...dev bir çatlak Kızıl Barbunyalı Baum Pastası toplantı salonuna ilerliyor!Dialogue: 0,0:19:38.73,0:19:42.61,Main,,0,0,0,,Ne çatlağı be! Tavan çöktü!Dialogue: 0,0:19:42.61,0:19:46.11,Main,,0,0,0,,Üçüncü kat Kızıl Barbunyalı Baum Pastası konuşuyor. Neler oluyor?Dialogue: 0,0:19:46.11,0:19:49.03,Main,,0,0,0,,Oda zemini eğilmeye başladı!Dialogue: 0,0:19:49.03,0:19:51.41,Main,,0,0,0,,Deprem falan değil!Dialogue: 0,0:19:51.53,0:19:54.95,Main,,0,0,0,,Demin açık bir şekilde bir patlama işittim!Dialogue: 0,0:19:54.95,0:19:57.95,Main,,0,0,0,,- Düşman saldırısı mı? - Şato eğilmeye devam ediyor!Dialogue: 0,0:19:57.95,0:19:59.71,Main,,0,0,0,,Neler oluyor?Dialogue: 0,0:20:00.42,0:20:02.79,Main,,0,0,0,,Olamaz.Dialogue: 0,0:20:03.38,0:20:06.17,Main,,0,0,0,,Devriliyor-bon...Dialogue: 0,0:20:06.97,0:20:09.55,Main,,0,0,0,,Whole Cake Şatosu!Dialogue: 0,0:20:10.59,0:20:14.10,Main,,0,0,0,,Devriliyor-bon!Dialogue: 0,0:20:14.10,0:20:16.60,Main,,0,0,0,,Ü ürü üü!Dialogue: 0,0:20:16.72,0:20:21.25,Captions,,0,0,0,,Şeker Şehri, BaşkentDialogue: 0,0:20:24.82,0:20:26.61,Main,,0,0,0,,Düşman toplarının saldırısı mıydı?Dialogue: 0,0:20:26.61,0:20:31.19,Main,,0,0,0,,Bir Yonkou'nun kalesindeyiz! Nasıl olur da bu adayı işgal edebilirler ki?Dialogue: 0,0:20:31.19,0:20:33.54,Main,,0,0,0,,Öyleyse gerçekten de bir patlama oldu!Dialogue: 0,0:20:36.33,0:20:38.83,Main,,0,0,0,,Patlamaya ne sebep oldu ki?Dialogue: 0,0:20:38.83,0:20:40.58,Main,,0,0,0,,Devrilme artık!Dialogue: 0,0:20:40.58,0:20:42.55,Main,,0,0,0,,Hepimiz öleceğiz!Dialogue: 0,0:20:42.55,0:20:45.97,Main,,0,0,0,,Çatı katındaki düğün ile bir alakası olabilir mi?Dialogue: 0,0:21:02.73,0:21:04.82,Main,,0,0,0,,Şaka mı lan bu!Dialogue: 0,0:21:05.94,0:21:08.94,Main,,0,0,0,,Fakat büyük haber malzemesi çıktı!Dialogue: 0,0:21:13.45,0:21:15.92,Main,,0,0,0,,Buna düşündüğüm şey mi sebep oldu?Dialogue: 0,0:21:15.92,0:21:17.17,Main,,0,0,0,,Sanırım!Dialogue: 0,0:21:18.41,0:21:22.46,Main,,0,0,0,,Zamanlama kusursuzdu.  Patlamaya başka ne sebep olmuş olabilir ki?Dialogue: 0,0:21:23.11,0:21:26.84,Main,,0,0,0,,Fakat... Neden Tamatebako?Dialogue: 0,0:21:29.51,0:21:31.68,Main,,0,0,0,,Herkes bir şeylere tutunsun!Dialogue: 0,0:21:34.14,0:21:36.06,Main,,0,0,0,,Hasır Şapkalar nerede?Dialogue: 0,0:21:37.06,0:21:39.14,Main,,0,0,0,,Neler oluyor böyle?Dialogue: 0,0:21:39.14,0:21:40.86,Main,,0,0,0,,Bilmiyorum.Dialogue: 0,0:21:40.86,0:21:45.33,Main,,0,0,0,,Fakat bu olanlar kıçımızı kurtardı. Yoksa ölmüştük.Dialogue: 0,0:21:51.16,0:21:55.21,Main,,0,0,0,,Bu da nedir? Ne oluyor ya?Dialogue: 0,0:22:07.11,0:22:09.79,Main,,0,0,0,,Bu olay hayatımızı kurtardı...Dialogue: 0,0:22:09.79,0:22:12.44,Main,,0,0,0,,Kurtulup kurtulmadığımızı...Dialogue: 0,0:22:13.82,0:22:15.86,Main,,0,0,0,,...henüz bilmiyoruz!Dialogue: 0,0:22:16.45,0:22:18.91,Main,,0,0,0,,Başımız büyük belada Mama!Dialogue: 0,0:22:18.91,0:22:25.12,Main,,0,0,0,,Whole Cake Şatosu an itibariyle bilinmeyen bir patlama nedeniyle yıkılıyor!Dialogue: 0,0:22:38.30,0:22:40.22,Main,,0,0,0,,Dışarıda bir şeyler oluyor!Dialogue: 0,0:22:40.22,0:22:43.59,Main,,0,0,0,,Bege'nin vücudunda hiçbir şey hissetmiyoruz ama...Dialogue: 0,0:22:43.59,0:22:45.64,Main,,0,0,0,,Neler oluyor ki?Dialogue: 0,0:22:47.31,0:22:50.64,Main,,0,0,0,,Bilmiyorum fakat...Dialogue: 0,0:22:50.64,0:22:53.52,Main,,0,0,0,,...ortalık karıştı.Dialogue: 0,0:22:54.82,0:22:56.58,Main,,0,0,0,,Yoksa...Dialogue: 0,0:22:56.58,0:23:00.61,Main,,0,0,0,,...Whole Cake Şatosu mu sallanıyor?Dialogue: 0,0:23:01.20,0:23:03.32,Main,,0,0,0,,Bu ne biçim iş lan?Dialogue: 0,0:23:03.32,0:23:06.12,Main,,0,0,0,,Hayal mi görüyorum?Dialogue: 0,0:23:08.45,0:23:10.08,Main,,0,0,0,,Baksana Caesar!Dialogue: 0,0:23:11.84,0:23:14.42,Main,,0,0,0,,Her yer darmaduman oldu...Dialogue: 0,0:23:17.30,0:23:19.61,Main,,0,0,0,,Nasıl olur?Dialogue: 0,0:23:20.35,0:23:23.68,Main,,0,0,0,,Kim, ne yaptı?Dialogue: 0,0:23:23.68,0:23:25.21,Main,,0,0,0,,Abilerim...Dialogue: 0,0:23:25.64,0:23:27.38,Main,,0,0,0,,Ablalarım...Dialogue: 0,0:23:28.10,0:23:30.48,Main,,0,0,0,,Kardeşlerim!Dialogue: 0,0:23:33.03,0:23:35.19,Main,,0,0,0,,Duramıyorum!Dialogue: 0,0:23:35.19,0:23:36.31,Main,,0,0,0,,Mama!Dialogue: 0,0:23:48.82,0:23:52.53,Main,,0,0,0,,Mama!!Dialogue: 0,0:24:07.46,0:24:10.14,Main,,0,0,0,,Dehşet!Dialogue: 0,0:24:10.14,0:24:14.06,Main,,0,0,0,,Kimin işi bilmiyorum ama minnettar olmam gerek!Dialogue: 0,0:24:14.06,0:24:17.19,Main,,0,0,0,,Kadını öldürmemize gerek kalmadı.Dialogue: 0,0:24:17.19,0:24:19.39,Main,,0,0,0,,Böylece...Dialogue: 0,0:24:19.39,0:24:22.74,Main,,0,0,0,,...Yonkou Big Mom Korsanları tamamıyla...Dialogue: 0,0:24:22.74,0:24:25.31,Main,,0,0,0,,...yok oldu!Dialogue: 0,0:24:33.38,0:24:34.76,Main,,0,0,0,,Mümkün değil!Dialogue: 0,0:24:43.47,0:24:47.44,Main,,0,0,0,,Şato, şehirden bile büyük! Kaçamayız ki!Dialogue: 0,0:24:47.44,0:24:50.65,Main,,0,0,0,,Kaçsalar bile sağ kurtulamazlar!Dialogue: 0,0:25:01.28,0:25:02.41,Main,,0,0,0,,Abi!Dialogue: 0,0:25:05.37,0:25:06.75,Main,,0,0,0,,Sakinleş.Dialogue: 0,0:25:10.08,0:25:14.59,Main,,0,0,0,,Havadislere bak! Havadis diye buna derim!Dialogue: 0,0:25:14.59,0:25:16.84,Main,,0,0,0,,Kendi canının derdine düşmüyor musun?Dialogue: 0,0:25:16.84,0:25:19.18,Main,,0,0,0,,Sahi! Uçamıyorum ben!Dialogue: 0,0:25:24.52,0:25:25.56,Main,,0,0,0,,Fakat...Dialogue: 0,0:25:26.27,0:25:31.81,Main,,0,0,0,,...Big Mom Korsanları böylelikle yok oluyorsa...Dialogue: 0,0:25:32.52,0:25:34.61,Main,,0,0,0,,...gerçekten de büyük havadis.Dialogue: 0,0:25:44.28,0:25:45.12,Main,,0,0,0,,Hey!Dialogue: 0,0:25:46.24,0:25:47.33,Main,,0,0,0,,Sanji-kun!Dialogue: 0,0:25:48.74,0:25:49.73,Main,,0,0,0,,Buradayız!Dialogue: 0,0:25:49.73,0:25:51.44,Main,,0,0,0,,Elinizi çabuk tutun lütfen!Dialogue: 0,0:25:51.44,0:25:53.24,Main,,0,0,0,,Sanji! Luffy!Dialogue: 0,0:25:54.83,0:25:57.08,Main,,0,0,0,,Hayattasınız demek!Dialogue: 0,0:25:59.16,0:26:01.70,Main,,0,0,0,,- Beklettiğimiz için af buyurun! - Bu ne pervasızlık!Dialogue: 0,0:26:01.70,0:26:03.50,Main,,0,0,0,,Hayret bir şeysiniz ya!Dialogue: 0,0:26:03.50,0:26:05.72,Main,,0,0,0,,Göğsümden bir yük kalktı ya.Dialogue: 0,0:26:06.09,0:26:08.90,Main,,0,0,0,,Uç Caesar! Toz olalım buradan!Dialogue: 0,0:26:08.90,0:26:11.09,Main,,0,0,0,,Biz kalmaya pek meraklıyız sanki!Dialogue: 0,0:26:11.09,0:26:13.47,Main,,0,0,0,,Tüyelim! Tüyelim! Tüyelim!Dialogue: 0,0:26:15.66,0:26:16.93,Main,,0,0,0,,Kaçtılar.Dialogue: 0,0:26:18.06,0:26:19.64,Main,,0,0,0,,Görev tamamlandı.Dialogue: 0,0:26:19.64,0:26:20.94,Main,,0,0,0,,Geri çekiliyoruz!Dialogue: 0,0:26:20.94,0:26:22.45,Main,,0,0,0,,Anlaşıldı.Dialogue: 0,0:26:34.58,0:26:37.00,Lyrics,,0,0,0,,♪ Yumuşacık ve kabarık... ♪Dialogue: 0,0:26:37.00,0:26:40.33,Lyrics,,0,0,0,,♪ Islak ve kabarık...Dialogue: 0,0:26:40.33,0:26:44.84,Lyrics,,0,0,0,,...hayat diye bir şey yok. ♪Dialogue: 0,0:26:52.93,0:26:55.55,Main,,0,0,0,,Hey, kalkabilir misin?Dialogue: 0,0:26:58.98,0:27:00.85,Main,,0,0,0,,Olamaz...Dialogue: 0,0:27:00.85,0:27:02.98,Main,,0,0,0,,Sonumuz geldi!Dialogue: 0,0:27:03.27,0:27:06.44,Main,,0,0,0,,Veränderung...Dialogue: 0,0:27:03.27,0:27:06.44,Attack,,0,0,0,,Dönüşüm...Dialogue: 0,0:27:07.38,0:27:08.44,Main,,0,0,0,,Gourmet!Dialogue: 0,0:27:07.38,0:27:08.44,Attack,,0,0,0,,...YemeğiDialogue: 0,0:27:34.34,0:27:36.10,Main,,0,0,0,,N'oluyor?Dialogue: 0,0:27:52.15,0:27:53.53,Main,,0,0,0,,Mama!Dialogue: 0,0:27:54.26,0:27:55.78,Main,,0,0,0,,Mama!Dialogue: 0,0:27:59.78,0:28:01.54,Main,,0,0,0,,Kıl payı yetiştim.Dialogue: 0,0:28:11.50,0:28:13.31,Main,,0,0,0,,Yoğun krema mı?Dialogue: 0,0:28:13.31,0:28:15.76,Main,,0,0,0,,Sürükleniyoruz!Dialogue: 0,0:28:20.26,0:28:22.81,Main,,0,0,0,,- Bu... - Sünger pasta mı?Dialogue: 0,0:28:37.25,0:28:39.21,Main,,0,0,0,,Ne oldu böyle?Dialogue: 0,0:28:41.54,0:28:46.17,Main,,0,0,0,,Whole Cake Şatosu gerçek bir yekpare pastaya dönüştü.Dialogue: 0,0:28:46.17,0:28:50.73,Main,,0,0,0,,Kurtulduk. Baş şefin işi olmalı.Dialogue: 0,0:28:50.73,0:28:53.26,Main,,0,0,0,,Gidiciyim demiştim!Dialogue: 0,0:28:57.39,0:28:59.68,Main,,0,0,0,,İyi misin Mama?Dialogue: 0,0:28:59.68,0:29:01.41,Main,,0,0,0,,Pasta...Dialogue: 0,0:29:01.41,0:29:04.98,Main,,0,0,0,,Şatom bir pastaya dönüştü...Dialogue: 0,0:29:07.19,0:29:11.75,Main,,0,0,0,,Streusen'in yeteneğiyle yaratılan tatlılar...Dialogue: 0,0:29:11.75,0:29:15.20,Main,,0,0,0,,...karnını doyurur doyurmasına da tatları hiç güzel değildir.Dialogue: 0,0:29:15.20,0:29:15.95,Main,,0,0,0,,Mama!Dialogue: 0,0:29:18.87,0:29:20.71,Main,,0,0,0,,Güvende olmana çok sevindim!Dialogue: 0,0:29:21.96,0:29:27.72,Main,,0,0,0,,Lanet olsun... Düğün pastam...Dialogue: 0,0:29:28.47,0:29:31.68,Main,,0,0,0,,Pasta...Dialogue: 0,0:29:33.89,0:29:35.34,Main,,0,0,0,,İyi misin?Dialogue: 0,0:29:35.34,0:29:36.81,Main,,0,0,0,,Yardım etsene!Dialogue: 0,0:29:36.81,0:29:39.56,Main,,0,0,0,,Tamamdır! Artık güvendesin.Dialogue: 0,0:29:39.56,0:29:41.44,Main,,0,0,0,,Ölüyorum sandım!Dialogue: 0,0:29:41.44,0:29:44.41,Main,,0,0,0,,Pastanın altında ezileceğim!Dialogue: 0,0:29:44.41,0:29:46.52,Main,,0,0,0,,Şuradan da ses geliyor!Dialogue: 0,0:29:46.52,0:29:48.69,Main,,0,0,0,,Çabuk yardım edin!Dialogue: 0,0:29:50.35,0:29:51.90,Main,,0,0,0,,B- Bu...Dialogue: 0,0:29:51.90,0:29:55.37,Main,,0,0,0,,Mont d'Or-sama! Ne oldu böyle?Dialogue: 0,0:29:55.37,0:29:58.67,Main,,0,0,0,,Şehir yerle bir oldu, biz de sonumuz geldi sandık!Dialogue: 0,0:29:58.67,0:30:01.02,Main,,0,0,0,,- Kesin sesinizi! - Ne?Dialogue: 0,0:30:01.02,0:30:03.36,Main,,0,0,0,,Bu iş daha bitmedi!Dialogue: 0,0:30:03.36,0:30:07.49,Main,,0,0,0,,Mama'yı öldürmeye çalışanlar kaçmayı başardı!Dialogue: 0,0:30:07.49,0:30:10.82,Main,,0,0,0,,Lakin fazla uzaklaşamadıklarına eminim!Dialogue: 0,0:30:10.82,0:30:14.78,Main,,0,0,0,,Tüm Totto Land adalarındaki turtalara haber salın!Dialogue: 0,0:30:14.78,0:30:19.12,Main,,0,0,0,,Hasır Şapkalar'dan da Ateş Tankı Korsanları'ndan da...Dialogue: 0,0:30:19.12,0:30:22.20,Main,,0,0,0,,...tek bir mürettebat dahi kaçamayacak!Dialogue: 0,0:30:23.66,0:30:30.04,Captions,,0,0,0,,Whole Cake Adası - Kuzeybatı YakasıDialogue: 0,0:30:29.15,0:30:31.42,Main,,0,0,0,,Yeterince uzaklaştık gibi.Dialogue: 0,0:30:31.42,0:30:32.46,Main,,0,0,0,,Def olun!Dialogue: 0,0:30:40.72,0:30:44.46,Main,,0,0,0,,Teşekkürler Bege! Sonumuz geldi sanmıştım.Dialogue: 0,0:30:44.46,0:30:46.16,Main,,0,0,0,,Teşekkür etmeyin bana.Dialogue: 0,0:30:46.16,0:30:49.81,Main,,0,0,0,,Bir iyilik yapmış gibi hissedince kusasım geliyor.Dialogue: 0,0:30:49.81,0:30:53.53,Main,,0,0,0,,Hamallığınızı ben yaptım lan! Nankörler!Dialogue: 0,0:30:53.53,0:30:55.11,Main,,0,0,0,,Kes sesini be ciğersiz herif!Dialogue: 0,0:30:55.11,0:30:59.70,Main,,0,0,0,,Punk Hazard'daki çocuklara neler yaptığını unuttun mu yoksa?Dialogue: 0,0:30:59.70,0:31:03.20,Main,,0,0,0,,Artık işimize yaramazsın... Git bir yerde geber.Dialogue: 0,0:31:04.53,0:31:08.59,Main,,0,0,0,,Bana bak lan!  Bir dâhiyle nasıl olur da böyle konuşursun?Dialogue: 0,0:31:08.59,0:31:13.08,Main,,0,0,0,,Canımı sıkarsan bu mekânı hemencecik zehirli gaza boğarım!Dialogue: 0,0:31:14.96,0:31:17.76,Main,,0,0,0,,Kalbini al.Dialogue: 0,0:31:22.51,0:31:24.68,Main,,0,0,0,,Benim... Benim... Benim...Dialogue: 0,0:31:30.81,0:31:32.79,Main,,0,0,0,,Sen de özgürsün artık.Dialogue: 0,0:31:32.79,0:31:34.53,Main,,0,0,0,,Ezivermeliydin oysa.Dialogue: 0,0:31:35.44,0:31:36.78,Main,,0,0,0,,Olamaz!Dialogue: 0,0:31:37.36,0:31:39.57,Main,,0,0,0,,Lütfen ya!Dialogue: 0,0:31:41.82,0:31:43.24,Main,,0,0,0,,Kesinlikle ezmeliydin.Dialogue: 0,0:31:52.18,0:31:55.18,Main,,0,0,0,,Kalbim...Dialogue: 0,0:31:55.18,0:31:59.43,Main,,0,0,0,,Kalbimi geri aldım!Dialogue: 0,0:31:59.85,0:32:02.18,Main,,0,0,0,,Yüzünüzü şeytan görsün artık!Dialogue: 0,0:32:02.18,0:32:06.27,Main,,0,0,0,,Hoşça kalın dangalaklar, gerizekâlı sürtük!Dialogue: 0,0:32:06.27,0:32:07.54,Main,,0,0,0,,Şato neden yıkıldı ki?Dialogue: 0,0:32:07.54,0:32:09.84,Secondary,,0,0,77,,– Hey!Dialogue: 0,0:32:07.54,0:32:09.84,Main,,0,0,0,,– Evet, hiç beklemiyorduk.Dialogue: 0,0:32:09.84,0:32:11.97,Main,,0,0,0,,– Ne oldu acaba?Dialogue: 0,0:32:10.32,0:32:11.97,Secondary,,0,0,77,,– Hoşça kalın!Dialogue: 0,0:32:11.97,0:32:13.43,Secondary,,0,0,77,,– Hey!Dialogue: 0,0:32:11.97,0:32:13.43,Main,,0,0,0,,– Hiçbir fikrim yok.Dialogue: 0,0:32:13.43,0:32:15.82,Main,,0,0,0,,Kime diyorum lan!Dialogue: 0,0:32:15.82,0:32:17.15,Main,,0,0,0,,Baba!Dialogue: 0,0:32:17.73,0:32:21.16,Main,,0,0,0,,Düşündüğüm gibi Big Mom da aile fertleri de...Dialogue: 0,0:32:21.16,0:32:23.91,Main,,0,0,0,,...sağ kurtuldu gibi-rero!Dialogue: 0,0:32:24.57,0:32:28.44,Main,,0,0,0,,Devrilen şatonun tamamı gerçek bir pastaya dönüşmüş.Dialogue: 0,0:32:28.44,0:32:32.00,Main,,0,0,0,,Streusen yeteneğini konuşturmuş.Dialogue: 0,0:32:33.08,0:32:37.37,Main,,0,0,0,,O adamı hiçbir zaman çözememiştim.Dialogue: 0,0:32:39.92,0:32:43.68,Main,,0,0,0,,Alelade bir baş şef olduğunu düşünmüyorum.Dialogue: 0,0:32:43.68,0:32:46.85,Main,,0,0,0,,Aynı zamanda çetin bir dövüşçü de olmalı.Dialogue: 0,0:32:48.72,0:32:52.44,Main,,0,0,0,,Bu olayla birlikte Big Mom Korsanları'nın sonu geldi demiştim.Dialogue: 0,0:32:52.44,0:32:54.87,Main,,0,0,0,,Şansına tükürdüklerim.Dialogue: 0,0:32:55.65,0:32:58.61,Main,,0,0,0,,Yine de dert değil. Şato yıkıldı.Dialogue: 0,0:32:58.61,0:33:00.57,Main,,0,0,0,,İçime su serpildi.Dialogue: 0,0:33:00.57,0:33:03.41,Main,,0,0,0,,Hoşça kal Hasır Şapka!Dialogue: 0,0:33:03.41,0:33:05.69,Main,,0,0,0,,Geriye topuklamak kalıyor yani?Dialogue: 0,0:33:05.69,0:33:10.19,Main,,0,0,0,,Sabahtan beri öyle yapıyoruz zaten de karşımıza engeller çıkıp durdu.Dialogue: 0,0:33:10.19,0:33:12.75,Main,,0,0,0,,Pekâlâ. Tüyelim o zaman.Dialogue: 0,0:33:12.75,0:33:15.74,Main,,0,0,0,,Sizinle yollarımız burada ayrılıyor Hasır Şapka.Dialogue: 0,0:33:15.74,0:33:17.59,Main,,0,0,0,,Ne? Cidden mi?Dialogue: 0,0:33:17.59,0:33:20.42,Main,,0,0,0,,Big Mom'ı öldüremedik.Dialogue: 0,0:33:20.42,0:33:23.91,Main,,0,0,0,,Artık bir arada kalmak için bir nedenimiz kalmadı.Dialogue: 0,0:33:23.91,0:33:28.10,Main,,0,0,0,,Aynen öyle. Elinizi çabuk tutsanız iyi edersiniz.Dialogue: 0,0:33:28.10,0:33:33.17,Main,,0,0,0,,Geminize ulaşsanız bile Big Mom'ın bölgesinden çıkmanız bir günü bulacaktır.Dialogue: 0,0:33:33.17,0:33:34.52,Main,,0,0,0,,Gerçekten de öyle!Dialogue: 0,0:33:34.52,0:33:36.56,Main,,0,0,0,,Bol şans!Dialogue: 0,0:33:38.77,0:33:40.11,Main,,0,0,0,,Castle Tank!Dialogue: 0,0:33:38.77,0:33:40.11,Attack,,0,0,0,,Kale TankDialogue: 0,0:33:47.87,0:33:50.58,Main,,0,0,0,,"Hasır Şapkalar şu yöne gitti." mi?Dialogue: 0,0:33:50.58,0:33:52.96,Main,,0,0,0,,Böyle ucuz numaralara başvurma!Dialogue: 0,0:33:52.96,0:33:55.46,Main,,0,0,0,,Kes! Hayatta kalmamız gerek!Dialogue: 0,0:33:55.46,0:33:59.24,Main,,0,0,0,,Baba! En azından bi' vedalaşsaydık-rero!Dialogue: 0,0:33:59.24,0:34:02.05,Main,,0,0,0,,Evet ya, Nami benim arkadaşım olmuştu!Dialogue: 0,0:34:02.05,0:34:06.22,Main,,0,0,0,,Rehavete kapılmayın! Asıl kaçış şimdi başlıyor!Dialogue: 0,0:34:07.30,0:34:11.05,Main,,0,0,0,,Pekâlâ, Köpek balığı Denizaltı'ya binip...Dialogue: 0,0:34:11.05,0:34:14.09,Main,,0,0,0,,...doğruca Sunny'ye gidiyoruz!Dialogue: 0,0:34:14.09,0:34:16.55,Main,,0,0,0,,Tamam. Dikkatli olun!Dialogue: 0,0:34:16.55,0:34:20.10,Main,,0,0,0,,Biz de elimizi çabuk tutup çıkarma yaptığımız sahile dönmeliyiz!Dialogue: 0,0:34:20.87,0:34:24.11,Main,,0,0,0,,İki tabur kur Daifuku.Dialogue: 0,0:34:24.11,0:34:25.45,Main,,0,0,0,,Anlaşıldı.Dialogue: 0,0:34:25.95,0:34:29.75,Main,,0,0,0,,İki tabura ayrılıp peşlerine düşeceğiz!Dialogue: 0,0:34:29.75,0:34:35.55,Main,,0,0,0,,Taburun biri Hasır Şapka'nın, diğeri ise Bege'nin kellesini getirecek!Dialogue: 0,0:34:41.35,0:34:42.76,Main,,0,0,0,,Mama.Dialogue: 0,0:34:45.39,0:34:49.21,Main,,0,0,0,,Merak etme. Kimsenin kaçmasına izin vermeyeceğiz.Dialogue: 0,0:34:49.21,0:34:51.27,Thoughts,,0,0,0,,Pasta...Dialogue: 0,0:34:53.19,0:34:57.03,Thoughts,,0,0,0,,Malzemeleri özenle seçilmişti.Dialogue: 0,0:34:57.03,0:35:00.94,Thoughts,,0,0,0,,En leziz düğün pastası olacaktı.Dialogue: 0,0:35:00.94,0:35:05.99,Thoughts,,0,0,0,,Yemeyi iple çekiyordum...Dialogue: 0,0:35:11.96,0:35:16.59,Main,,0,0,0,,Düğün pastası...Dialogue: 0,0:35:17.90,0:35:19.27,Main,,0,0,0,,Mama?Dialogue: 0,0:35:23.93,0:35:29.73,Main,,0,0,0,,Düğün pastam nerede?Dialogue: 0,0:35:30.56,0:35:32.48,Main,,0,0,0,,Tam da zamanında...Dialogue: 0,0:35:32.48,0:35:35.27,Main,,0,0,0,,Çabuk getirin...Dialogue: 0,0:35:35.27,0:35:41.37,Credits,,0,0,0,,Editing:  Feeso, Galaxy 9000  Timing: Halee  Quality Assurance: Feeso, Galaxy 9000, Grug, Pepperjack  Soundtracking:  Halee  Graphics:  Datenshi  Karaoke: KaitouYahiko  Translation: Crunchyroll