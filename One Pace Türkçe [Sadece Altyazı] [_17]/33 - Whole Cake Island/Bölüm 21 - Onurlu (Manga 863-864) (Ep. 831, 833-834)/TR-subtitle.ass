Dialogue: 0,0:00:03.78,0:00:06.96,Captions,,0,0,0,,{\fad(500,0)}Üç Buçuk Saat Önce\NBege'nin Üssü{\pos(653,455)}
Dialogue: 0,0:00:07.18,0:00:10.40,Main,,0,0,0,,Düğün pastasının içine\Nayna mı koyalım?
Dialogue: 0,0:00:10.40,0:00:14.21,Main,,0,0,0,,Aynen! \NPastanın içine ayna koyarsan...
Dialogue: 0,0:00:14.21,0:00:17.71,Main,,0,0,0,,...ayna diyarından \N"Fiçuv!" diye fırlayabilirim!
Dialogue: 0,0:00:17.71,0:00:21.09,Main,,0,0,0,,Böylece hem tatlı\Nhem de eğlenceli olur!
Dialogue: 0,0:00:21.74,0:00:24.39,Main,,0,0,0,,İkisine de lüzum yok!
Dialogue: 0,0:00:24.39,0:00:27.24,Main,,0,0,0,,Bana kendimi tekrarlatma! \NSenin görevin-
Dialogue: 0,0:00:27.24,0:00:30.88,Main,,0,0,0,,Biliyoruz ya! \NFotoğrafı kırmamı istiyorsun, değil mi?
Dialogue: 0,0:00:31.68,0:00:35.08,Main,,0,0,0,,Ama bunu yaparken de\Nkomik bir şekilde giriş yapmak istiyorum!
Dialogue: 0,0:00:35.89,0:00:38.07,Main,,0,0,0,,Saçmalama!
Dialogue: 0,0:00:38.40,0:00:40.87,Main,,0,0,0,,Düğün pastasını\Nmahvetmeyi mi planlıyorsun?
Dialogue: 0,0:00:40.87,0:00:45.39,Main,,0,0,0,,Mama'nın o pastayı nasıl\Niple çektiğinden bihabersiniz.
Dialogue: 0,0:00:45.39,0:00:48.39,Main,,0,0,0,,Ormandayken Namiler'in kopyalarını yapmıştın.
Dialogue: 0,0:00:48.39,0:00:49.07,Main,,0,0,0,,Ne?
Dialogue: 0,0:00:49.07,0:00:49.96,Main,,0,0,0,,Evet!
Dialogue: 0,0:00:49.96,0:00:52.80,Main,,0,0,0,,Brulee canlıların\Naynadaki yansımalarını...
Dialogue: 0,0:00:52.80,0:00:56.16,Main,,0,0,0,,...bir diğerine yönelterek\Ngörünüşlerini kopyalayabilir.
Dialogue: 0,0:01:04.42,0:01:06.54,Main,,0,0,0,,Ne olmuş yani?
Dialogue: 0,0:01:10.06,0:01:14.05,Main,,0,0,0,,Yakaladım.\NHepsini kopyam yap.
Dialogue: 0,0:01:14.05,0:01:15.48,Main,,0,0,0,,Ne?
Dialogue: 0,0:01:15.87,0:01:17.24,Main,,0,0,0,,Baba!
Dialogue: 0,0:01:17.58,0:01:19.48,Main,,0,0,0,,Hallettiniz mi?
Dialogue: 0,0:01:19.48,0:01:22.00,Main,,0,0,0,,Tüm hazırlıklar tamam-rero.
Dialogue: 0,0:01:22.00,0:01:23.36,Main,,0,0,0,,Tamamdır, aferin.
Dialogue: 0,0:01:29.69,0:01:31.42,Main,,0,0,0,,Başladı demek.
Dialogue: 0,0:03:09.37,0:03:13.88,Captions,,0,0,0,,Şimdiki Zaman – Düğün Mekanı
Dialogue: 0,0:03:13.88,0:03:18.55,Main,,0,0,0,,P- Pastadan insanlar çıkıyor!
Dialogue: 0,0:03:21.47,0:03:25.44,Author,,0,0,0,,{\fad(500,500)\fs18} Türkçeleştirme & Çevirmen  {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&} - {\c&H01BAFF&}{\b1}dmc3{\b0}{\c&HFFFFFF&}\N{\fs17}thx to onepace.net
Dialogue: 0,0:17:21.60,0:17:31.60,Author,,0,0,0,,{\fad(500,500)\fs18} Türkçeleştirme & Çevirmen  {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&} - {\c&H01BAFF&}{\b1}dmc3{\b0}{\c&HFFFFFF&}\N{\fs17}thx to onepace.net
Dialogue: 0,0:35:30.90,0:35:35.00,Author,,0,0,0,,{\fad(0,0)\fs18} Türkçeleştirme & Çevirmen  {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&} - {\c&H01BAFF&}{\b1}dmc3{\b0}{\c&HFFFFFF&}\N{\fs17}thx to onepace.net
Dialogue: 0,0:03:21.47,0:03:25.44,Title,,0,0,0,,{\fad(400,0)}Onurlu{\pos(646,488)}
Dialogue: 0,0:03:35.87,0:03:38.27,Main,,0,0,0,,Vay vay! İnanamıyorum!
Dialogue: 0,0:03:39.66,0:03:43.14,Main,,0,0,0,,Yine alengirli ıvır zıvırlar-nen...
Dialogue: 0,0:03:43.14,0:03:47.28,Main,,0,0,0,,Hayır, yanılıyorsun Du Feld!\NBu büyük bir haber!
Dialogue: 0,0:03:47.28,0:03:50.53,Main,,0,0,0,,O gördüğün En Kötü Nesil'den\Nbir korsan!
Dialogue: 0,0:03:51.16,0:03:53.62,Main,,0,0,0,,Hasır Şapka Luffy!
Dialogue: 0,0:03:53.62,0:03:56.26,Main,,0,0,0,,Akıl almaz işler oluyor!
Dialogue: 0,0:03:56.26,0:03:58.68,Main,,0,0,0,,Burada ne işi var ki?
Dialogue: 0,0:04:00.50,0:04:02.83,Main,,0,0,0,,Onların hepsi de Hasır Şapka mı?
Dialogue: 0,0:04:02.83,0:04:04.70,Main,,0,0,0,,Sayıları neden bu kadar fazla ki?
Dialogue: 0,0:04:05.54,0:04:09.36,Main,,0,0,0,,Kaçın!\NPasta yıkılıyor!
Dialogue: 0,0:04:09.70,0:04:12.18,Main,,0,0,0,,Neyin nesi bunlar?
Dialogue: 0,0:04:14.64,0:04:18.90,Main,,0,0,0,,Hasır Şapka Luffy mi?
Dialogue: 0,0:04:23.73,0:04:26.32,Main,,0,0,0,,Aşağılık herif!
Dialogue: 0,0:04:30.49,0:04:32.70,Main,,0,0,0,,Pudding-{\i1}chan{\i0}, topla kendini!
Dialogue: 0,0:04:34.79,0:04:38.89,Thoughts,,0,0,0,,{\i1}Nihayet başladı demek.\NCan alıcı an yaklaşıyor.
Dialogue: 0,0:04:38.89,0:04:40.62,Thoughts,,0,0,0,,{\i1}Ellerinden öper Luffy!
Dialogue: 0,0:04:43.94,0:04:46.34,Main,,0,0,0,,Bu da ne demek oluyor Mont d'Or?!
Dialogue: 0,0:04:46.34,0:04:51.27,Main,,0,0,0,,Hasır Şapka Luffy ve mürettebatı\NZindan Hapishanesi'nde ölmüştü hani?
Dialogue: 0,0:04:52.18,0:04:53.35,Main,,0,0,0,,Sıçayım!
Dialogue: 0,0:04:53.35,0:04:57.23,Main,,0,0,0,,Şerefsiz Opera!\NYalan söylediğini biliyordum!
Dialogue: 0,0:04:57.23,0:05:01.03,Main,,0,0,0,,Kendi postunu kurtarmaya kalkmış!
Dialogue: 0,0:05:09.28,0:05:11.08,Main,,0,0,0,,Benim...
Dialogue: 0,0:05:11.08,0:05:13.04,Main,,0,0,0,,...biricik...
Dialogue: 0,0:05:13.04,0:05:15.29,Main,,0,0,0,,...pastam...
Dialogue: 0,0:05:15.29,0:05:18.65,Main,,0,0,0,,Pastam...
Dialogue: 0,0:05:22.22,0:05:23.39,Main,,0,0,0,,N'oluyor?
Dialogue: 0,0:05:23.82,0:05:25.59,Main,,0,0,0,,Bir tuhaf davranıyor.
Dialogue: 0,0:05:26.29,0:05:30.80,Main,,0,0,0,,Yemek için gün sayıyordum...
Dialogue: 0,0:05:31.52,0:05:35.93,Main,,0,0,0,,Mama, sakinliğini koru lütfen.\NNeler hissettiğini anlıyorum.
Dialogue: 0,0:05:43.23,0:05:45.94,Main,,0,0,0,,Pastam!
Dialogue: 0,0:05:47.20,0:05:49.16,Main,,0,0,0,,Şefim!\NBuradan uzaklaşın lütfen!
Dialogue: 0,0:05:49.16,0:05:51.39,Main,,0,0,0,,Mama'da bir tuhaflık var!
Dialogue: 0,0:05:53.71,0:05:57.80,Main,,0,0,0,,Yeni bir pasta yapın bana!
Dialogue: 0,0:05:57.80,0:06:00.05,Main,,0,0,0,,H- Hemencecik olmaz ki!
Dialogue: 0,0:06:01.04,0:06:03.17,Main,,0,0,0,,Hayatınız mı...
Dialogue: 0,0:06:03.98,0:06:05.45,Main,,0,0,0,,...yoksa...
Dialogue: 0,0:06:05.45,0:06:08.43,Main,,0,0,0,,...düğün pastası mı?
Dialogue: 0,0:06:11.62,0:06:13.79,Main,,0,0,0,,Ç- Çocuklar...
Dialogue: 0,0:06:14.68,0:06:16.37,Main,,0,0,0,,Vay! Ruh Muhabbeti!
Dialogue: 0,0:06:16.37,0:06:19.31,Main,,0,0,0,,Ömürleri yutulacak!\NBüyük haber diye buna derim!
Dialogue: 0,0:06:20.09,0:06:24.78,Main,,0,0,0,,Big Mom insanların yaşama\Narzusunu görebilir!
Dialogue: 0,0:06:24.78,0:06:28.49,Main,,0,0,0,,Ölümden biraz olsun korkarsan...
Dialogue: 0,0:06:28.49,0:06:30.62,Main,,0,0,0,,Bak! Oluyor işte!
Dialogue: 0,0:06:34.39,0:06:36.96,Main,,0,0,0,,İ... İ- İmdat!
Dialogue: 0,0:06:37.74,0:06:39.98,Main,,0,0,0,,Olamaz!
Dialogue: 0,0:06:45.45,0:06:49.43,Main,,0,0,0,,Keyfimi mahveden herkesin...
Dialogue: 0,0:06:49.43,0:06:53.26,Main,,0,0,0,,...ömrünü alırım!
Dialogue: 0,0:06:57.47,0:07:01.15,Captions,,0,0,170,,{\fad(500,700)}Ayna Dünyası
Dialogue: 0,0:07:02.00,0:07:03.40,Main,,0,0,0,,Yürüyün! Yürüyün!
Dialogue: 0,0:07:03.40,0:07:04.82,Main,,0,0,0,,Aynen, geçit burada!
Dialogue: 0,0:07:07.78,0:07:12.07,Main,,0,0,0,,Demin duyduğumuz sese bakılırsa\NBig Mom küplere binmiş olmalı!
Dialogue: 0,0:07:12.07,0:07:14.41,Main,,0,0,0,,Biz de biçare hâldeyiz.
Dialogue: 0,0:07:14.41,0:07:17.41,Main,,0,0,0,,Ortalık umduğumuzdan da\Nfazla karışıyor.
Dialogue: 0,0:07:17.41,0:07:20.19,Main,,0,0,0,,Bunu ödeyeceksiniz!
Dialogue: 0,0:07:21.00,0:07:23.08,Main,,0,0,0,,Hepsini saldınız mı?
Dialogue: 0,0:07:23.08,0:07:24.88,Main,,0,0,0,,Bu, sonuncu Luffy idi!
Dialogue: 0,0:07:26.12,0:07:29.17,Main,,0,0,0,,Pekâlâ! Gidelim Pedro!
Dialogue: 0,0:07:29.17,0:07:31.88,Main,,0,0,0,,Aynen! Luffy'ye arka çıkalım!
Dialogue: 0,0:07:36.02,0:07:38.98,Main,,0,0,0,,Biz de yola koyulmalıyız!\NSanji-kun'u geri almalıyız!
Dialogue: 0,0:07:39.38,0:07:40.32,Main,,0,0,0,,Hazır mısın?
Dialogue: 0,0:07:40.32,0:07:42.60,Main,,0,0,0,,Hazırım! Kulak tıkaçlarımı aldım!
Dialogue: 0,0:07:42.60,0:07:44.73,Main,,0,0,0,,Sanji'nin ailesini kurtaracağız!
Dialogue: 0,0:07:45.74,0:07:49.32,Main,,0,0,0,,Pekâlâ, gerisi sana kalmış\Ninsan müsveddesi.
Dialogue: 0,0:07:50.28,0:07:52.42,Main,,0,0,0,,O kadar kötü biri mi cidden?
Dialogue: 0,0:07:52.42,0:07:54.16,Main,,0,0,0,,Aşağılığın önde gidenidir!
Dialogue: 0,0:08:02.26,0:08:07.13,Main,,0,0,0,,Kalbimi bir alayım hepiniz göreceksiniz...
Dialogue: 0,0:08:14.49,0:08:17.82,Main,,0,0,0,,Alçak Hasır Şapka...
Dialogue: 0,0:08:17.82,0:08:20.06,Main,,0,0,0,,Benimle kafa buluyor!
Dialogue: 0,0:08:26.00,0:08:28.10,Main,,0,0,0,,Adi herif!
Dialogue: 0,0:08:29.98,0:08:32.90,Main,,0,0,0,,Hangisi gerçek Hasır Şapka!
Dialogue: 0,0:08:36.18,0:08:38.74,Flashbacks,,0,0,0,,Monkey D. Luffy...
Dialogue: 0,0:08:38.74,0:08:42.25,Flashbacks,,0,0,0,,Adını kafama kazıyorum.
Dialogue: 0,0:08:42.25,0:08:45.42,Flashbacks,,0,0,0,,Yeni Dünya'ya gel bakalım!
Dialogue: 0,0:08:49.34,0:08:51.84,Flashbacks,,0,0,0,,Uykumu getirdin be!
Dialogue: 0,0:08:51.84,0:08:56.47,Flashbacks,,0,0,0,,Korsanlar Kralı olamayan sendin!
Dialogue: 0,0:08:58.58,0:09:01.30,Flashbacks,,0,0,0,,Seninle bir kez daha kapışacağım!
Dialogue: 0,0:09:01.31,0:09:04.85,Flashbacks,,0,0,0,,Sırf Yonkou'sun diye\Nkendini bir bok sanma!
Dialogue: 0,0:09:04.85,0:09:07.31,Flashbacks,,0,0,0,,Sanji'yi geri alacağım!
Dialogue: 0,0:09:07.31,0:09:11.42,Flashbacks,,0,0,0,,Son gülen biz olacağız!
Dialogue: 0,0:09:18.06,0:09:22.02,Main,,0,0,0,,Pasta devrildi.
Dialogue: 0,0:09:31.78,0:09:34.55,Main,,0,0,0,,Kahretsin...
Dialogue: 0,0:09:35.95,0:09:38.76,Main,,0,0,0,,Lanet olsun...
Dialogue: 0,0:09:41.35,0:09:45.94,Main,,0,0,0,,Ne cüretle düğün pastamı mahveder!
Dialogue: 0,0:09:49.05,0:09:53.82,Main,,0,0,0,,Hangisi gerçek Hasır Şapka Luffy?
Dialogue: 0,0:09:54.52,0:09:57.55,Main,,0,0,0,,Nerede bu?
Dialogue: 0,0:09:58.57,0:10:02.41,Thoughts,,0,0,0,,Geri zekâlı mısın?\NAlt tarafı dikkat dağıtma stratejisi.
Dialogue: 0,0:10:02.41,0:10:06.08,Main,,0,0,0,,Göster kendini Hasır Şapka!
Dialogue: 0,0:10:06.08,0:10:08.97,Thoughts,,0,0,0,,{\i1}Soruna cevap verir mi sanıyorsun?
Dialogue: 0,0:10:08.97,0:10:11.46,Thoughts,,0,0,0,,{\i1}Ne de olsa cevap verirse...
Dialogue: 0,0:10:22.70,0:10:26.07,Main,,0,0,0,,Buradayım lan!
Dialogue: 0,0:10:27.38,0:10:31.40,Thoughts,,0,0,0,,{\i1}C... Cevap verdi!
Dialogue: 0,0:10:32.22,0:10:35.90,Main,,0,0,0,,Demek oradasın Hasır Şapka...
Dialogue: 0,0:10:35.90,0:10:38.70,Main,,0,0,0,,Seni ayağımın altında ezeceğim!
Dialogue: 0,0:10:54.67,0:10:57.30,Main,,0,0,0,,Fotoğrafı gördüm!
Dialogue: 0,0:11:05.68,0:11:09.81,Main,,0,0,0,,Vito... Gotti...\NFırlatıcı hazır mı?
Dialogue: 0,0:11:11.28,0:11:16.18,Main,,0,0,0,,Evet, her an çıkmaya\Nhazırız Baba.
Dialogue: 0,0:11:17.44,0:11:20.40,Thoughts,,0,0,0,,{\i1}Hasır Şapka...\NElinden geleni ardına koyma.
Dialogue: 0,0:11:20.78,0:11:22.43,Main,,0,0,0,,Hayır, bırak saçımı!
Dialogue: 0,0:11:22.43,0:11:24.88,Main,,0,0,0,,Sürü hâlinde saldırıyorlar!
Dialogue: 0,0:11:29.74,0:11:30.70,Main,,0,0,0,,Gel haydi!
Dialogue: 0,0:11:34.39,0:11:37.00,Main,,0,0,0,,Gerçek Luffy'miz şu olmalı.
Dialogue: 0,0:11:37.32,0:11:39.53,Captions,,0,0,0,,{\fad(250,125)}Pastanın İçi{\pos(1033,111)}
Dialogue: 0,0:11:37.00,0:11:40.58,Main,,0,0,0,,Luffy fotoğrafı kırar kırmaz\Nüç saniye geçmesiyle giriyoruz.
Dialogue: 0,0:11:40.58,0:11:41.97,Main,,0,0,0,,Peki.
Dialogue: 0,0:11:41.97,0:11:44.76,Main,,0,0,0,,Kulağınız bende mi?\NCiddiye alın bu işi!
Dialogue: 0,0:11:45.10,0:11:46.88,Main,,0,0,0,,Peki.
Dialogue: 0,0:11:48.80,0:11:50.18,Main,,0,0,0,,Zeus!
Dialogue: 0,0:11:50.18,0:11:51.52,Main,,0,0,0,,Baş üstüne Mama!
Dialogue: 0,0:11:51.52,0:11:52.95,Main,,0,0,0,,Prometheus!
Dialogue: 0,0:11:52.95,0:11:54.40,Main,,0,0,0,,Emrine amadeyim Mama!
Dialogue: 0,0:11:54.40,0:11:56.90,Main,,0,0,0,,Hepsini tek seferde haklayacağım!
Dialogue: 0,0:11:59.78,0:12:00.86,Main,,0,0,0,,Tamamdır!
Dialogue: 0,0:12:03.49,0:12:04.57,Main,,0,0,0,,Çocuk oyuncağı!
Dialogue: 0,0:12:04.57,0:12:06.83,Main,,0,0,0,,Al bakalım!
Dialogue: 0,0:12:06.83,0:12:08.12,Thoughts,,0,0,0,,{\i1}Yapabilir!
Dialogue: 0,0:12:08.12,0:12:10.50,Main,,0,0,0,,{\fad(250,250)}Gomu Gomu no...
Dialogue: 0,0:12:12.96,0:12:15.10,Main,,0,0,0,,Ne?
Dialogue: 0,0:12:16.54,0:12:19.38,Main,,0,0,0,,Gerçeği bu!
Dialogue: 0,0:12:19.38,0:12:22.54,Main,,0,0,0,,Diğer Hasır Şapkalar...
Dialogue: 0,0:12:22.54,0:12:28.56,Main,,0,0,0,,...Brûlée'nin yeteneğiyle dönüşüme\Nuğramış hayvanlar.
Dialogue: 0,0:12:28.56,0:12:30.08,Main,,0,0,0,,Onları boş verin.
Dialogue: 0,0:12:30.08,0:12:33.23,Main,,0,0,0,,Anladım!\NBrûlée'nin yeteneğini kullandılar demek!
Dialogue: 0,0:12:34.23,0:12:35.35,Main,,0,0,0,,Kahretsin!
Dialogue: 0,0:12:37.06,0:12:38.77,Main,,0,0,0,,Bu şey de neyin nesi?
Dialogue: 0,0:12:38.77,0:12:42.48,Main,,0,0,0,,Kollarım da bacaklarım da sıkıştı kaldı!\NÇıkaramıyorum! Nasıl bir yetenek bu?
Dialogue: 0,0:12:42.48,0:12:47.25,Main,,0,0,0,,Katakuri! Bana yardım etmeye mi kalkıyorsun? \NOğlum olsan da...
Dialogue: 0,0:12:47.25,0:12:49.38,Main,,0,0,0,,Hayır Ana!
Dialogue: 0,0:12:49.70,0:12:52.08,Main,,0,0,0,,Bu herifin hedefinde...
Dialogue: 0,0:12:56.04,0:12:59.59,Main,,0,0,0,,...Anne Carmel'in fotoğrafı vardı.
Dialogue: 0,0:13:01.34,0:13:05.58,Main,,0,0,0,,Fotoğrafın bizim için önemini\Nnereden biliyordun?
Dialogue: 0,0:13:05.58,0:13:08.44,Main,,0,0,0,,Yalnızca ailemizden olanlar\Nbiliyor sanıyordum.
Dialogue: 0,0:13:10.30,0:13:12.37,Main,,0,0,0,,Ötmeye başla! Kim söyledi sana?
Dialogue: 0,0:13:12.37,0:13:14.85,Main,,0,0,0,,Kes lan!\NBırak beni dallama!
Dialogue: 0,0:13:14.85,0:13:17.60,Thoughts,,0,0,0,,{\i1}Kahretsin...\NPlan tıkandı kaldı.
Dialogue: 0,0:13:17.60,0:13:20.32,Thoughts,,0,0,0,,{\i1}Kim olduğu fark etmez!\NFotoğrafı kırın yeter!
Dialogue: 0,0:13:29.97,0:13:30.95,Main,,0,0,0,,Luffy!
Dialogue: 0,0:13:30.95,0:13:32.39,Main,,0,0,0,,Hay içine!
Dialogue: 0,0:13:32.39,0:13:33.75,Main,,0,0,0,,Bana bırak Pedro!
Dialogue: 0,0:13:37.52,0:13:39.56,Main,,0,0,0,,{\fad(250,250)}Kairyuu...
Dialogue: 0,0:13:37.52,0:13:39.56,Attack,,0,0,0,,{\fad(250,250)}Okyanus Akıntısı...
Dialogue: 0,0:13:39.56,0:13:42.08,Main,,0,0,0,,{\fad(250,250)}...Ipponzeoi!
Dialogue: 0,0:13:39.56,0:13:42.08,Attack,,0,0,0,,{\fad(250,250)}Omuz Fırlatışı!
Dialogue: 0,0:13:43.67,0:13:45.59,Main,,0,0,0,,Kaçın!
Dialogue: 0,0:14:00.27,0:14:03.38,Main,,0,0,0,,Benden söz etmene gerek yok.
Dialogue: 0,0:14:03.69,0:14:05.31,Main,,0,0,0,,Ucuz yırttım ha.
Dialogue: 0,0:14:05.31,0:14:08.95,Main,,0,0,0,,Katakuri Parametia sınıfı\Nözel bir meyve olan...
Dialogue: 0,0:14:08.95,0:14:11.63,Main,,0,0,0,,...Mochi Mochi Meyvesi yemiştir.
Dialogue: 0,0:14:11.63,0:14:12.45,Main,,0,0,0,,Jinbe!
Dialogue: 0,0:14:12.45,0:14:17.32,Main,,0,0,0,,Bir sıvı yardımıyla ondan kurtulabilirsin\Nfakat hiç elini sürmemen en hayırlısı olur.
Dialogue: 0,0:14:17.70,0:14:18.96,Main,,0,0,0,,Jinbe?
Dialogue: 0,0:14:18.96,0:14:24.00,Main,,0,0,0,,Anne Carmel'i Luffy'ye anlatan bendim.
Dialogue: 0,0:14:24.00,0:14:28.24,Main,,0,0,0,,Müttefikin olduğumdan konuşmalarınıza da\Nkulak misafiri oluyorum.
Dialogue: 0,0:14:32.13,0:14:36.02,Main,,0,0,0,,Andavallar!\NNe cüretle düğünü bölerler!
Dialogue: 0,0:14:36.02,0:14:40.00,Main,,0,0,0,,Sanji'yi kurtarmak için\Nbu kadar ileri gittiler!
Dialogue: 0,0:14:40.00,0:14:42.27,Main,,0,0,0,,Düğün sizlere ömür.
Dialogue: 0,0:14:42.27,0:14:45.26,Main,,0,0,0,,Beyinsiz Hasır Şapka'nın\Nöldüğünü sanmıştım.
Dialogue: 0,0:14:45.26,0:14:49.15,Main,,0,0,0,,Gönlünüzü ferah tutun\NVinsmoke fertleri.
Dialogue: 0,0:14:49.15,0:14:53.41,Main,,0,0,0,,Charlotte Ailesi olarak\Nbu işi çözeceğiz.
Dialogue: 0,0:14:58.62,0:15:00.34,Main,,0,0,0,,Sen...
Dialogue: 0,0:15:00.34,0:15:04.04,Main,,0,0,0,,...tayfamdan ayrılmaktan\Nvazgeçtin sanıyordum.
Dialogue: 0,0:15:04.04,0:15:08.90,Main,,0,0,0,,Buna rağmen pastamı mahveden\Nelemanı korudun.
Dialogue: 0,0:15:09.74,0:15:14.55,Main,,0,0,0,,Bu hareketini bir baş kaldırı olarak\Nnitelendiriyorum, kabul mü...
Dialogue: 0,0:15:14.55,0:15:16.09,Main,,0,0,0,,...Jinbe?
Dialogue: 0,0:15:16.09,0:15:18.80,Main,,0,0,0,,Evet, kesinlikle kabulümdür.
Dialogue: 0,0:15:20.67,0:15:22.66,Main,,0,0,0,,Cesaretin varmış.
Dialogue: 0,0:15:23.81,0:15:27.36,Main,,0,0,0,,Tayfandan ayrılıp...
Dialogue: 0,0:15:31.57,0:15:35.28,Main,,0,0,0,,...Hasır Şapkalar'a katılmak istiyorum!
Dialogue: 0,0:15:36.99,0:15:37.99,Main,,0,0,0,,Ne?
Dialogue: 0,0:15:42.12,0:15:44.46,Main,,0,0,0,,Al sana manşet!
Dialogue: 0,0:15:44.46,0:15:48.30,Main,,0,0,0,,Eski Shichibukai Jinbe\NHasır Şapkalar'a katılıyor!
Dialogue: 0,0:15:50.96,0:15:55.39,Main,,0,0,0,,Öyle olsun. \NAyrıldıktan sonra dilediğini yapabilirsin.
Dialogue: 0,0:15:55.72,0:16:01.34,Main,,0,0,0,,Öyle olsun. Ayrıldıktan sonra\Ndilediğini yapabilirsin.
Dialogue: 0,0:16:01.34,0:16:05.27,Main,,0,0,0,,Hayatını utanç içinde yaşamak\Nistemezsin, değil mi?
Dialogue: 0,0:16:05.27,0:16:06.68,Main,,0,0,0,,Kesinlikle..
Dialogue: 0,0:16:06.68,0:16:11.11,Main,,0,0,0,,Benden başka kimseye\Ndokunmayacağına söz verirsen...
Dialogue: 0,0:16:11.11,0:16:15.54,Main,,0,0,0,,...seve seve ömrümden dilediğin\Nkadarını almana razıyım!
Dialogue: 0,0:16:16.16,0:16:20.52,Main,,0,0,0,,Hey, neden bahsediyorsun Jinbe?\NÖlürsen tayfama katılamazsın ki!
Dialogue: 0,0:16:21.70,0:16:24.95,Main,,0,0,0,,İnsanların ömürlerini almaya bayılırım!
Dialogue: 0,0:16:25.55,0:16:29.66,Main,,0,0,0,,Anlıyorum. \NBenden bu denli hazzetmiyorsun demek.
Dialogue: 0,0:16:29.66,0:16:35.43,Main,,0,0,0,,Benim safımda kalmaktansa\Nölmeyi yeğliyorsun.
Dialogue: 0,0:16:35.43,0:16:37.70,Main,,0,0,0,,Günah benden gitti!
Dialogue: 0,0:16:39.93,0:16:43.35,Main,,0,0,0,,İşte! Yine başlıyor!\NRuh Muhabbeti!
Dialogue: 0,0:16:44.35,0:16:47.86,Main,,0,0,0,,Tamamdır!\NAnlaştık!
Dialogue: 0,0:16:51.15,0:16:53.24,Main,,0,0,0,,Beyinsiz...
Dialogue: 0,0:16:54.65,0:16:56.82,Main,,0,0,0,,Kalacak mısın...
Dialogue: 0,0:17:02.33,0:17:04.12,Main,,0,0,0,,...yoksa...
Dialogue: 0,0:17:04.12,0:17:06.59,Main,,0,0,0,,...ömrün mü?
Dialogue: 0,0:17:09.83,0:17:11.84,Main,,0,0,0,,Ömrüm!
Dialogue: 0,0:17:12.13,0:17:13.45,Main,,0,0,0,,Mama...
Dialogue: 0,0:17:13.45,0:17:15.92,Main,,0,0,0,,Artık geriye dönüş yok...
Dialogue: 0,0:17:15.92,0:17:18.72,Main,,0,0,0,,Jinbe buracıkta ölecek mi yoksa?
Dialogue: 0,0:17:19.80,0:17:21.35,Main,,0,0,0,,Geber...
Dialogue: 0,0:17:39.15,0:17:41.80,Main,,0,0,0,,Kalacak mısın...
Dialogue: 0,0:17:41.80,0:17:43.45,Main,,0,0,0,,...ömrün mü!
Dialogue: 0,0:17:47.16,0:17:51.07,Main,,0,0,0,,R- Ruhu bedenini terk etmiyor!
Dialogue: 0,0:17:51.07,0:17:55.26,Main,,0,0,0,,Gerçek olamaz! \NMama'dan zerre korku duymuyor!
Dialogue: 0,0:17:57.92,0:18:00.14,Main,,0,0,0,,Herhâlde korkmayacağım.
Dialogue: 0,0:18:00.47,0:18:05.23,Main,,0,0,0,,Geleceğin Korsanlar Kralı'nın\Ntayfasına katılmak istiyorum!
Dialogue: 0,0:18:07.27,0:18:11.94,Main,,0,0,0,,Alt tarafı Yonkou olan biri\Ngözümü korkutamaz!
Dialogue: 0,0:18:17.45,0:18:20.62,Main,,0,0,0,,Mama... \NOnun ömrünü alamıyor mu?
Dialogue: 0,0:18:31.03,0:18:33.34,Main,,0,0,0,,Ömrümü almıyorsun madem...
Dialogue: 0,0:18:35.28,0:18:37.88,Main,,0,0,0,,...içki kadehini iade ediyorum.
Dialogue: 0,0:18:48.21,0:18:54.07,Main,,0,0,0,,Böylece Big Mom Korsanları'yla\Nbağım kalmadı!
Dialogue: 0,0:18:54.40,0:18:58.18,Main,,0,0,0,,Benim için verdiğiniz\Nzahmetlere minnettarım!
Dialogue: 0,0:19:06.49,0:19:09.22,Main,,0,0,0,,Planın ortasında bunu yaptığına\Ninanamıyorum.
Dialogue: 0,0:19:09.22,0:19:12.28,Main,,0,0,0,,Çok havalısın be Jinbe!
Dialogue: 0,0:19:15.88,0:19:17.60,Main,,0,0,0,,Yaşasın!
Dialogue: 0,0:19:33.10,0:19:36.10,Main,,0,0,0,,Tebrikler Jinbe...
Dialogue: 0,0:19:39.01,0:19:43.36,Main,,0,0,0,,...böylece düşmanım oluyorsun, değil mi?
Dialogue: 0,0:19:45.48,0:19:46.50,Main,,0,0,0,,Jinbe!
Dialogue: 0,0:19:46.50,0:19:48.36,Main,,0,0,0,,Geber!
Dialogue: 0,0:20:05.49,0:20:07.74,Main,,0,0,0,,Bakın! Şuraya bakın!
Dialogue: 0,0:20:12.56,0:20:17.02,Main,,0,0,0,,A- Anne Carmel'in fotoğrafını parçaladı!
Dialogue: 0,0:20:25.24,0:20:29.46,Main,,0,0,0,,Olamaz! Manşetlik haber!
Dialogue: 0,0:20:30.25,0:20:31.38,Main,,0,0,0,,Mama...
Dialogue: 0,0:20:34.03,0:20:35.76,Main,,0,0,0,,Yaşasın!
Dialogue: 0,0:20:35.76,0:20:38.00,Main,,0,0,0,,İşte bu!
Dialogue: 0,0:20:38.00,0:20:39.41,Main,,0,0,0,,Parçalandı!
Dialogue: 0,0:20:40.34,0:20:45.46,Main,,0,0,0,,N'oluyor ya? Kopya Hasır Şapkalar'ın\Nhayvan olduklarını sanıyordum!
Dialogue: 0,0:20:53.90,0:20:58.78,Thoughts,,0,0,0,,{\i1}Güzel! \NBig Mom fotoğrafın parçalandığını gördü!
Dialogue: 0,0:20:58.78,0:21:01.77,Thoughts,,0,0,0,,{\i1}Bir de çığlığı bastı mı...
Dialogue: 0,0:21:08.36,0:21:10.52,Main,,0,0,0,,Ne yapıyor öyle?
Dialogue: 0,0:21:15.37,0:21:19.49,Main,,0,0,0,,Ölümcül zehir KX Fırlatıcısı\Nateşlenmeye hazır-rero!
Dialogue: 0,0:21:28.32,0:21:30.56,Main,,0,0,0,,Kendi yüzünü yüzdü!
Dialogue: 0,0:21:30.56,0:21:33.28,Main,,0,0,0,,Hayır be!\NBu benim gerçek yüzüm!
Dialogue: 0,0:21:33.28,0:21:35.12,Main,,0,0,0,,İğrenç!
Dialogue: 0,0:21:35.12,0:21:35.90,Main,,0,0,0,,Ne... Ne?
Dialogue: 0,0:21:35.90,0:21:39.68,Main,,0,0,0,,R- Ruh Kralı!
Dialogue: 0,0:21:40.49,0:21:43.70,Main,,0,0,0,,Ölmemiş miydin sen?
Dialogue: 0,0:21:43.70,0:21:47.34,Main,,0,0,0,,Doğrudur, uzun zaman evvel\Nölmüşlüğüm vardır.
Dialogue: 0,0:21:48.96,0:21:50.78,Main,,0,0,0,,Sen...
Dialogue: 0,0:21:50.78,0:21:53.74,Main,,0,0,0,,...o fotoğraftaki kişinin\Nkim olduğunu...
Dialogue: 0,0:21:57.37,0:22:01.34,Main,,0,0,0,,...biliyor musun?
Dialogue: 0,0:22:01.87,0:22:04.29,Main,,0,0,0,,A- Anne...
Dialogue: 0,0:22:05.20,0:22:08.00,Main,,0,0,0,,Neden çığlık atmıyor?
Dialogue: 0,0:22:11.09,0:22:15.93,Main,,0,0,0,,Eyvahlar olsun! O gün tekrar yaşanıyor!\NMama kendini kaybedecek!
Dialogue: 0,0:22:16.13,0:22:20.80,Main,,0,0,0,,Onun kim olduğunu biliyor musun?
Dialogue: 0,0:22:22.84,0:22:27.48,Main,,0,0,0,,Bir de düğün pastası...
Dialogue: 0,0:22:30.19,0:22:33.32,Main,,0,0,0,,Nedenini şimdi anladım!
Dialogue: 0,0:22:35.78,0:22:38.53,Main,,0,0,0,,Mama'nın aklı yerinde değil.\Nİplerini koparacak!
Dialogue: 0,0:22:38.53,0:22:41.43,Main,,0,0,0,,Bu yaşanmadan Hasır Şapkalar'ı öldürün!
Dialogue: 0,0:22:42.70,0:22:43.90,Main,,0,0,0,,Luffy!
Dialogue: 0,0:22:43.90,0:22:47.59,Main,,0,0,0,,Big Mom kendini\Nkaybedene dek hayatta kalmalıyız!
Dialogue: 0,0:22:47.59,0:22:48.38,Main,,0,0,0,,Tamamdır!
Dialogue: 0,0:22:48.38,0:22:50.65,Main,,0,0,0,,Hasır Şapka!
Dialogue: 0,0:22:56.67,0:22:57.66,Main,,0,0,0,,İmdat!
Dialogue: 0,0:22:57.66,0:23:01.14,Main,,0,0,0,,Dur! Bırak!
Dialogue: 0,0:23:10.36,0:23:12.31,Main,,0,0,0,,İyi misin Pudding-{\i1}chan{\i0}?
Dialogue: 0,0:23:12.31,0:23:14.86,Main,,0,0,0,,Güvenli bir yere gidelim.
Dialogue: 0,0:23:42.31,0:23:43.97,Main,,0,0,0,,Dur Pudding-{\i1}chan{\i0}!
Dialogue: 0,0:23:43.97,0:23:45.77,Main,,0,0,0,,Kes sesini!
Dialogue: 0,0:23:46.60,0:23:50.31,Main,,0,0,0,,Bak! İşte gerçek ben!
Dialogue: 0,0:23:51.19,0:23:54.83,Main,,0,0,0,,Afallamış olmalısın!\NHayal kırıklığına uğradın değil mi?
Dialogue: 0,0:23:54.83,0:23:57.06,Main,,0,0,0,,Ama merak etme.
Dialogue: 0,0:23:57.06,0:23:59.37,Main,,0,0,0,,Şimdi öleceksin.
Dialogue: 0,0:24:16.30,0:24:20.71,Main,,0,0,0,,Bu şekilde sayısız insanı kandırdım!
Dialogue: 0,0:24:20.71,0:24:22.42,Main,,0,0,0,,Kendini de mi?
Dialogue: 0,0:24:23.65,0:24:29.63,Main,,0,0,0,,Böylece kendini de kandırıp durdun,\Ndeğil mi Pudding-chan?
Dialogue: 0,0:24:30.88,0:24:34.20,Main,,0,0,0,,K- Kapa çeneni!
Dialogue: 0,0:24:34.20,0:24:36.62,Main,,0,0,0,,Senin gibi bir aptal...
Dialogue: 0,0:24:41.80,0:24:44.63,Main,,0,0,0,,Senin gibi bir aptal...
Dialogue: 0,0:24:45.70,0:24:47.63,Main,,0,0,0,,Çekil, Pudding!
Dialogue: 0,0:24:58.36,0:24:59.51,Main,,0,0,0,,Pudding-{\i1}chan{\i0}?
Dialogue: 0,0:25:08.67,0:25:10.53,Main,,0,0,0,,İyi misin Pudding-{\i1}chan{\i0}?
Dialogue: 0,0:25:10.53,0:25:14.34,Main,,0,0,0,,Planı mahvettin!\NBeş para etmez kız!
Dialogue: 0,0:25:14.34,0:25:16.25,Main,,0,0,0,,Daifuku abi!
Dialogue: 0,0:25:16.69,0:25:22.45,Captions,,0,0,0,,{\fad(500,700)}Charlotte Daifuku\NCharlotte Ailesi'nin 3. Oğlu (Fasulye Bakanı)\N"Hoya Hoya" Meyvesi Yemiş, Lamba Adam{\pos(649,440)}
Dialogue: 0,0:25:17.29,0:25:22.95,Main,,0,0,0,,Damadın ipini kesene kadar plan başlamayacak.{\an8}
Dialogue: 0,0:25:26.74,0:25:28.62,Main,,0,0,0,,Bırak!
Dialogue: 0,0:25:33.57,0:25:35.88,Main,,0,0,0,,Çık dışarı Cin!
Dialogue: 0,0:25:41.20,0:25:42.77,Main,,0,0,0,,Ciiin!
Dialogue: 0,0:25:49.10,0:25:50.40,Main,,0,0,0,,Bu da ne?
Dialogue: 0,0:25:52.94,0:25:54.67,Main,,0,0,0,,Daifuku abi!
Dialogue: 0,0:25:55.74,0:25:58.95,Main,,0,0,0,,Bekle!\Nİşimi bitireceğime söz veriyorum!
Dialogue: 0,0:26:01.23,0:26:05.83,Main,,0,0,0,,O an yapamadıysan\Nartık hiç yapamazsın.
Dialogue: 0,0:26:10.66,0:26:11.75,Main,,0,0,0,,Pudding-{\i1}chan{\i0}!
Dialogue: 0,0:26:17.94,0:26:20.88,Main,,0,0,0,,{\fad(250,250)}Maji Karu!
Dialogue: 0,0:26:17.94,0:26:20.88,Attack,,0,0,0,,{\fad(250,250)}İfrit Avı
Dialogue: 0,0:26:21.92,0:26:24.05,Main,,0,0,0,,{\fad(250,250)}Collier Strike!
Dialogue: 0,0:26:21.92,0:26:24.05,Attack,,0,0,0,,{\fad(250,250)}Boyun Darbesi
Dialogue: 0,0:26:33.89,0:26:36.86,Captions,,0,0,0,,{\fad(500,700)}Ayna Dünyası{\pos(649,550)}
Dialogue: 0,0:26:37.60,0:26:40.36,Main,,0,0,0,,Dur!
Dialogue: 0,0:26:40.36,0:26:44.88,Main,,0,0,0,,Kullanmayın beni artık!
Dialogue: 0,0:26:45.07,0:26:48.84,Main,,0,0,0,,Kes lan sesini!\NKalbim tehlikede!
Dialogue: 0,0:26:54.04,0:26:56.44,Main,,0,0,0,,Amma inatçı çıktınız ha.
Dialogue: 0,0:26:59.11,0:27:01.35,Main,,0,0,0,,N'apıyorsun Bege?
Dialogue: 0,0:27:01.35,0:27:06.89,Main,,0,0,0,,Sus! Güvenlik şefiyim! \NHiçbir şey yapmazsam benden şüphelenirler!
Dialogue: 0,0:27:06.89,0:27:08.90,Main,,0,0,0,,Kaptanlarını yakaladım!
Dialogue: 0,0:27:08.90,0:27:11.13,Main,,0,0,0,,Güzel! Al kellesini!
Dialogue: 0,0:27:12.79,0:27:16.02,Main,,0,0,0,,Aklıma da yattı aslında.
Dialogue: 0,0:27:16.02,0:27:17.90,Main,,0,0,0,,Hadi lan!
Dialogue: 0,0:27:18.71,0:27:21.95,Main,,0,0,0,,Dinle! Başımız belada!
Dialogue: 0,0:27:22.84,0:27:25.58,Main,,0,0,0,,Big Mom neden çığlık atmıyor?
Dialogue: 0,0:27:27.81,0:27:29.83,Main,,0,0,0,,Bu kadar çok kişiyle dövüşemem!
Dialogue: 0,0:27:32.66,0:27:33.92,Main,,0,0,0,,Jinbe!
Dialogue: 0,0:27:33.92,0:27:35.65,Main,,0,0,0,,Oven!
Dialogue: 0,0:27:37.94,0:27:39.30,Main,,0,0,0,,Alçak!
Dialogue: 0,0:27:39.30,0:27:43.34,Main,,0,0,0,,Hey, Pedro!\NSana dokunmasına izin verme!
Dialogue: 0,0:27:48.59,0:27:50.16,Main,,0,0,0,,N'oluyor?
Dialogue: 0,0:27:54.77,0:27:59.11,Captions,,0,0,0,,{\fad(250,0)}Charlotte Oven\NCharlotte Ailesi'nin 4. Oğlu (Kızartma Bakanı)\N"Netsu Netsu" Meyvesi Yemiş, Isı İnsan{\pos(651,402)}
Dialogue: 0,0:27:55.74,0:27:59.11,Main,,0,0,0,,Seni hatırlıyorum Pedro!{\pos(649,715)}
Dialogue: 0,0:27:59.11,0:28:02.44,Main,,0,0,0,,Pekoms seni abisi gibi\Ngörür!
Dialogue: 0,0:28:02.97,0:28:07.85,Main,,0,0,0,,Mama'nın Poneglifi'ni çalmaya geldin\Nfakat ahmakça çuvallayıp...
Dialogue: 0,0:28:07.85,0:28:11.41,Main,,0,0,0,,...sefil bir şekilde bir gözünü ve ömründen\Nyıllarını yitirdin.
Dialogue: 0,0:28:12.69,0:28:16.40,Main,,0,0,0,,Geriye kalan kısacık ömrünle buraya\Ngeldiğine göre...
Dialogue: 0,0:28:16.40,0:28:18.95,Main,,0,0,0,,...ölümü göze almışsındır herhâlde?
Dialogue: 0,0:28:25.91,0:28:28.94,Main,,0,0,0,,Hep göze almıştım zaten!
Dialogue: 0,0:28:30.00,0:28:32.44,Main,,0,0,0,,Seni yakıp kül edeceğim!
Dialogue: 0,0:28:33.72,0:28:36.73,Main,,0,0,0,,Üç saniye çoktan geçti!
Dialogue: 0,0:28:37.32,0:28:39.50,Main,,0,0,0,,Ne oluyor ya?
Dialogue: 0,0:28:39.50,0:28:42.20,Main,,0,0,0,,Çığlık atmıyor ki!
Dialogue: 0,0:28:55.35,0:28:56.88,Main,,0,0,0,,Brook!
Dialogue: 0,0:28:57.38,0:29:01.87,Main,,0,0,0,,Bir şeyim yok. Yaşıyorum.\NAslında ölüyüm.
Dialogue: 0,0:29:02.58,0:29:05.56,Main,,0,0,0,,Bunu yapabileceğini bilmiyordum!
Dialogue: 0,0:29:08.01,0:29:10.70,Main,,0,0,0,,Onu boş ver de\Ndinle beni Luffy-{\i1}san{\i0}!
Dialogue: 0,0:29:10.70,0:29:13.94,Main,,0,0,0,,Ne yapıyorsunuz be?
Dialogue: 0,0:29:13.94,0:29:18.90,Main,,0,0,0,,Bunu bize nasıl yaparsınız!
Dialogue: 0,0:29:18.90,0:29:21.57,Main,,0,0,0,,Olamaz! Bege, çekil!
Dialogue: 0,0:29:23.15,0:29:25.91,Main,,0,0,0,,Kahretsin! \NBöyle olmaması gerekiyordu!
Dialogue: 0,0:29:26.41,0:29:29.14,Main,,0,0,0,,Bir yanlışlık olduğunu söyle!
Dialogue: 0,0:29:29.14,0:29:31.42,Main,,0,0,0,,Big Mom!
Dialogue: 0,0:29:39.32,0:29:44.62,Main,,0,0,0,,Sana güvenmiştim! Yeraltı dünyasında bile\Nonur ve edepten şaşılmaz!
Dialogue: 0,0:29:45.95,0:29:47.80,Main,,0,0,0,,Konuş!
Dialogue: 0,0:29:51.06,0:29:54.44,Main,,0,0,0,,Kendini utandırıyorsun baba.
Dialogue: 0,0:29:54.64,0:29:56.50,Main,,0,0,0,,İşimiz bitti.
Dialogue: 0,0:29:57.08,0:29:59.39,Main,,0,0,0,,Şekerle kaplanmış durumdayız.
Dialogue: 0,0:30:00.18,0:30:04.66,Main,,0,0,0,,Silahlarımızı da aldılar.\NRaid Suits'lerimiz bile yok.
Dialogue: 0,0:30:00.18,0:30:04.66,Note,,0,0,0,,Raid Suits: Baskın Takımları
Dialogue: 0,0:30:04.66,0:30:09.46,Main,,0,0,0,,Zokayı tamamen yutmuşuz.\NSanırım fazla açılıp boğulduk.
Dialogue: 0,0:30:13.40,0:30:16.58,Main,,0,0,0,,Neye gülüyorsunuz dallamalar?
Dialogue: 0,0:30:19.24,0:30:24.24,Thoughts,,0,0,0,,{\i1}Ne yazık ki oğullarını bu kadar\Nsoğukkanlı yapan sensin.
Dialogue: 0,0:30:24.46,0:30:26.08,Thoughts,,0,0,0,,{\i1}Baba-sama...
Dialogue: 0,0:30:27.00,0:30:29.98,Thoughts,,0,0,0,,{\i1}Kendi ecellerinden bile korkmuyorlar.
Dialogue: 0,0:30:30.73,0:30:35.37,Thoughts,,0,0,0,,{\i1}Kardeşlerim olsalar da onları\Ninsan yerine koyamıyorum.
Dialogue: 0,0:30:38.94,0:30:43.90,Main,,0,0,0,,İnanamıyorum ya! Böylesi acınası\Nbir suikastı da ilk kez görüyorum!
Dialogue: 0,0:30:43.90,0:30:48.12,Main,,0,0,0,,Zorbalık yapıyorum sanki-perorin!
Dialogue: 0,0:30:49.74,0:30:53.56,Main,,0,0,0,,Öyle değil mi Judge?
Dialogue: 0,0:30:54.48,0:30:58.56,Main,,0,0,0,,Tüm hayatımı...
Dialogue: 0,0:30:58.56,0:31:00.79,Main,,0,0,0,,Varımı yoğumu...
Dialogue: 0,0:31:00.79,0:31:04.90,Main,,0,0,0,,...Kuzey Mavi'deki ülkelerden\Nintikam almaya adadım!
Dialogue: 0,0:31:04.90,0:31:09.36,Main,,0,0,0,,Germa İmparatorluğu'nu diriltmek umuduyla!
Dialogue: 0,0:31:09.36,0:31:11.39,Main,,0,0,0,,Big Mom!
Dialogue: 0,0:31:11.89,0:31:16.95,Main,,0,0,0,,Cevap ver Big Mom!!
Dialogue: 0,0:31:20.71,0:31:23.40,Main,,0,0,0,,Şu hâline bir bak.
Dialogue: 0,0:31:23.40,0:31:27.00,Main,,0,0,0,,Ne?\NGerma'nın icabına mı bakıyorlar?
Dialogue: 0,0:31:27.00,0:31:30.66,Main,,0,0,0,,Bir manşet haber daha!
Dialogue: 0,0:31:37.85,0:31:41.11,Main,,0,0,0,,Ağlıyor ya!
Dialogue: 0,0:31:43.94,0:31:48.80,Main,,0,0,0,,Bunun gerçek olmadığını\Nsöyle bana!
Dialogue: 0,0:31:48.80,0:31:52.43,Main,,0,0,0,,Nefesini boşa harcıyorsun.\NOna baksana.
Dialogue: 0,0:31:52.89,0:31:57.41,Main,,0,0,0,,Birden fazla şok edici olaya tanık olunca \Nkafası karıştı.
Dialogue: 0,0:31:52.89,0:31:57.41,Secondary,,0,0,0,,Anne... Pasta...
Dialogue: 0,0:31:58.15,0:32:03.16,Main,,0,0,0,,Anne Carmel'in fotoğrafı parçalanınca\Nufaktan endişelenmiştim...
Dialogue: 0,0:32:03.16,0:32:09.66,Main,,0,0,0,,...fakat öfkesinin boyutu bilincini yitirmesine\Nneden olduğundan paçayı kurtardık.
Dialogue: 0,0:32:10.15,0:32:15.79,Main,,0,0,0,,Tutkulu hedefini çok iyi anlıyorum Judge
Dialogue: 0,0:32:17.58,0:32:24.52,Main,,0,0,0,,Fakat kendisini kesip yemek üzereyken\Nbir ineğin çıkardığı seslere kulak asar mısın?
Dialogue: 0,0:32:27.33,0:32:33.54,Main,,0,0,0,,Geber ki ailemizden ol Germa 66!
Dialogue: 0,0:32:34.95,0:32:36.77,Main,,0,0,0,,Sanji'nin ailesi...
Dialogue: 0,0:32:36.77,0:32:39.67,Main,,0,0,0,,Luffy-{\i1}san{\i0}, beni dinle!
Dialogue: 0,0:32:39.67,0:32:43.36,Main,,0,0,0,,Big Mom artarda birden fazla kez\Nafalladığından...
Dialogue: 0,0:32:43.36,0:32:46.92,Main,,0,0,0,,...neye öfkeleneceğini çözemiyor.
Dialogue: 0,0:32:46.92,0:32:51.07,Main,,0,0,0,,Kırılmış fotoğrafı ona\Ntekrar gösterelim!
Dialogue: 0,0:32:51.07,0:32:54.32,Main,,0,0,0,,Tamam!\NÖyle diyorsan yapayım!
Dialogue: 0,0:32:54.32,0:32:56.66,Main,,0,0,0,,Hey, geç kalmadık mı?
Dialogue: 0,0:33:00.44,0:33:01.79,Main,,0,0,0,,Ne oldu?
Dialogue: 0,0:33:02.70,0:33:04.95,Main,,0,0,0,,Deminki adam geliyor!
Dialogue: 0,0:33:07.28,0:33:09.01,Main,,0,0,0,,Katakuri!
Dialogue: 0,0:33:10.40,0:33:14.98,Main,,0,0,0,,Pekâlâ! Devam edin!\NBu plan tutacak!
Dialogue: 0,0:33:15.47,0:33:18.59,Main,,0,0,0,,Katakuri'nin beti benzi atmış!
Dialogue: 0,0:33:18.59,0:33:23.06,Main,,0,0,0,,Yani işlerin iyice karıştığı\Nbir gelecek görmüş olmalı.
Dialogue: 0,0:33:23.46,0:33:25.24,Main,,0,0,0,,Git hadi Hasır Şapka.
Dialogue: 0,0:33:25.24,0:33:26.93,Main,,0,0,0,,Tamam!
Dialogue: 0,0:33:27.44,0:33:29.36,Main,,0,0,0,,Jinbe! Pedro!
Dialogue: 0,0:33:29.36,0:33:32.85,Main,,0,0,0,,Tüm gücümüzle Hasır Şapka'ya\Narka çıkmalıyız! Beni izleyin!
Dialogue: 0,0:33:40.47,0:33:42.28,Main,,0,0,0,,Müttefik kuvvetleri!
Dialogue: 0,0:33:42.79,0:33:48.19,Main,,0,0,0,,Görünmez Senfoniler'inizi hazırlayın!
Dialogue: 0,0:33:48.19,0:33:49.81,Main,,0,0,0,,- Gör...\N- Buldum!
Dialogue: 0,0:33:49.81,0:33:51.20,Main,,0,0,0,,Kulak tıkaçları!
Dialogue: 0,0:33:51.20,0:33:52.56,Main,,0,0,0,,Bege?
Dialogue: 0,0:33:52.56,0:33:55.50,Main,,0,0,0,,Ne diye bağırdı ki?
Dialogue: 0,0:33:57.23,0:33:58.77,Main,,0,0,0,,Başarabilir misin?
Dialogue: 0,0:33:58.77,0:34:03.97,Main,,0,0,0,,Elinde silah olan elemanları ancak böyle\Nhaklayabileceğimizi biliyorsunuz, değil mi?
Dialogue: 0,0:34:07.32,0:34:08.72,Main,,0,0,0,,Bege!
Dialogue: 0,0:34:13.19,0:34:16.81,Main,,0,0,0,,Hasır Şapka'ya ateş et hemen!
Dialogue: 0,0:34:19.47,0:34:21.61,Main,,0,0,0,,Reddediyorum.
Dialogue: 0,0:34:29.42,0:34:36.61,Main,,0,0,0,,Tamamdır! Bunu bir kez daha Big Mom'a\Ngösterdim mi plan gerçekleşecek, değil mi?
Dialogue: 0,0:34:46.68,0:34:50.04,Main,,0,0,0,,{\fad(250,250)}Flambage Shot!
Dialogue: 0,0:34:46.68,0:34:50.04,Attack,,0,0,0,,{\fad(250,250)}Alevli Vuruş
Dialogue: 0,0:35:01.55,0:35:06.49,Main,,0,0,0,,Alt tarafı birazcık ileriyi görebiliyorsun.
Dialogue: 0,0:35:07.52,0:35:10.95,Main,,0,0,0,,Biz geleceği göremesek de...
Dialogue: 0,0:35:11.46,0:35:14.41,Main,,0,0,0,,...onu değiştirme...
Dialogue: 0,0:35:14.88,0:35:18.69,Main,,0,0,0,,...gücümüz var!
Dialogue: 0,0:35:22.28,0:35:27.80,Main,,0,0,0,,H... asır... Ş... apka...
