Dialogue: 0,0:01:42.68,0:01:44.95,Main,,0,0,0,,Sıradışı bir durum yok gibi.
Dialogue: 0,0:01:44.95,0:01:45.87,Main,,0,0,0,,Pekâlâ!
Dialogue: 0,0:01:47.08,0:01:49.20,Main,,0,0,0,,Açlıktan ölüyorum!
Dialogue: 0,0:01:49.20,0:01:53.38,Main,,0,0,0,,Endişelenmeyin. Adanın yakında\Ngörüş alanımıza girmesi lazım.
Dialogue: 0,0:01:53.38,0:01:57.00,Main,,0,0,0,,Fırsat varken\Nsize birkaç bilgi vereyim.
Dialogue: 0,0:01:57.00,0:02:03.51,Main,,0,0,0,,Whole Cake Adası çevresinde\Ntoplam 34 ada bulunuyor.
Dialogue: 0,0:02:03.51,0:02:04.93,Main,,0,0,0,,O kadar çok mu?!
Dialogue: 0,0:02:04.93,0:02:10.39,Main,,0,0,0,,İşleri yürüten her bir bakan için\Nbir ada, toplamda 34.
Dialogue: 0,0:02:10.39,0:02:14.41,Main,,0,0,0,,Bu devasa deniz alanına...
Dialogue: 0,0:02:16.66,0:02:19.10,Main,,0,0,0,,...Totto Land deniyor!
Dialogue: 0,0:02:20.41,0:02:26.95,Author,,0,0,0,,{\fad(1500,1000)\fs18} Türkçeleştirme & Çevirmen  {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&} - {\c&H01BAFF&}{\b1}eray.gns{\b0}{\c&HFFFFFF&}\N{\fs17}thx to onepace.net
Dialogue: 0,0:16:19.40,0:16:27.90,Author,,0,0,0,,{\fad(500,500)\fs18} Türkçeleştirme & Çevirmen  {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&} - {\c&H01BAFF&}{\b1}eray.gns{\b0}{\c&HFFFFFF&}\N{\fs17}thx to onepace.net
Dialogue: 0,0:31:52.50,0:31:56.90,Author,,0,0,0,,{\fad(0,0)\fs18} Türkçeleştirme & Çevirmen  {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&} - {\c&H01BAFF&}{\b1}eray.gns{\b0}{\c&HFFFFFF&}\N{\fs17}thx to onepace.net
Dialogue: 0,0:02:20.41,0:02:26.95,Title,,0,0,420,,{\fad(1500,1000)}Totto Land
Dialogue: 0,0:02:33.33,0:02:36.49,Main,,0,0,0,,Öyle demek. Bağışlayın.
Dialogue: 0,0:02:37.56,0:02:39.72,Main,,0,0,0,,Düşman gemisi sanmıştım.
Dialogue: 0,0:02:39.72,0:02:46.60,Main,,0,0,0,,Evet, bu gemiyi korsanlardan kaçırdım.\NMama'ya bizzat takdim etmek istiyorum.
Dialogue: 0,0:02:46.60,0:02:51.02,Main,,0,0,0,,Amanın! Gemide tatlı\Nbir şeyleriniz mi var yoksa?
Dialogue: 0,0:02:51.02,0:02:55.36,Main,,0,0,0,,- Elbette.\N- Mama'nın çok hoşuna gidecek!
Dialogue: 0,0:02:55.36,0:03:01.20,Main,,0,0,0,,Sürpriz olacak. \NBu gemiden Mama'ya bahsetmeyin.
Dialogue: 0,0:03:01.20,0:03:04.28,Main,,0,0,0,,Harika gerçekten!
Dialogue: 0,0:03:05.78,0:03:09.61,Main,,0,0,0,,Pekâlâ Pekoms-sama, mükemmel birisiniz!
Dialogue: 0,0:03:17.80,0:03:19.41,Main,,0,0,0,,Vay canına be!
Dialogue: 0,0:03:21.08,0:03:23.84,Main,,0,0,0,,Taşlar, evler, her şey...
Dialogue: 0,0:03:30.38,0:03:32.72,Main,,0,0,0,,...çikolatadan yapılma!
Dialogue: 0,0:03:32.72,0:03:34.94,Main,,0,0,0,,Çikolata şehri!
Dialogue: 0,0:03:34.94,0:03:37.08,Main,,0,0,0,,Rüya gibi!
Dialogue: 0,0:03:58.21,0:04:01.80,Main,,0,0,0,,Vay be!\NBinbir çeşit insan var!
Dialogue: 0,0:04:03.38,0:04:06.97,Main,,0,0,0,,Ne bu ya? Bu ne böyle ya?\NNasıl şehir bu?!
Dialogue: 0,0:04:06.97,0:04:09.89,Main,,0,0,0,,Şuna bak! Çikolata akıyor!
Dialogue: 0,0:04:11.68,0:04:14.95,Main,,0,0,0,,Çikolata şelalesinden başlayacağını biliyordum!
Dialogue: 0,0:04:14.95,0:04:16.56,Main,,0,0,0,,Çikolata şelalesi!
Dialogue: 0,0:04:17.66,0:04:20.53,Note,,0,0,0,,Çikolata Hamamı{\an8}
Dialogue: 0,0:04:18.64,0:04:20.53,Main,,0,0,0,,Çikolata hamamı mı?!
Dialogue: 0,0:04:20.53,0:04:22.11,Main,,0,0,0,,Çikolata banyosu!
Dialogue: 0,0:04:23.00,0:04:26.37,Main,,0,0,0,,- Çikolatadan kıyafetler!\N- Yeniyor mu?!
Dialogue: 0,0:04:27.87,0:04:33.76,Main,,0,0,0,,Şimdilik idare etmeyi başardım\Nama burada çok kalmayalım-gao!
Dialogue: 0,0:04:34.37,0:04:38.96,Main,,0,0,0,,Hemen ne yapacaksak yapıp\Nyeniden yola...
Dialogue: 0,0:04:38.96,0:04:40.34,Main,,0,0,0,,Hazır mısınız?
Dialogue: 0,0:04:48.10,0:04:50.68,Main,,0,0,0,,Vay be, çok şirin oldum!
Dialogue: 0,0:04:50.68,0:04:52.85,Main,,0,0,0,,Nami, harika görünüyorsun!
Dialogue: 0,0:04:52.85,0:04:54.23,Main,,0,0,0,,Teşekkür ederim!
Dialogue: 0,0:04:55.90,0:05:00.53,Main,,0,0,0,,Bak! Benim elbisem de\Nhiç fena değil değil mi?
Dialogue: 0,0:05:01.82,0:05:03.73,Main,,0,0,0,,Evet, çok hoş olmuşsun!
Dialogue: 0,0:05:07.87,0:05:10.99,Main,,0,0,0,,Nasıl? \NBöyle korsana benziyor muyum Broo-
Dialogue: 0,0:05:19.22,0:05:20.92,Main,,0,0,0,,Geldiği yerde daha çok var!
Dialogue: 0,0:05:22.80,0:05:28.22,Main,,0,0,0,,Sanji'nin olduğu Whole Cake Adası'na\Nburadan bir günlük mesafe var.
Dialogue: 0,0:05:28.22,0:05:30.30,Main,,0,0,0,,Gidip yiyecek bir şeyler alın.
Dialogue: 0,0:05:30.30,0:05:32.78,Main,,0,0,0,,Pekâlâ! Yaşasın!
Dialogue: 0,0:05:32.78,0:05:35.31,Main,,0,0,0,,Pedro, dürbünün var mı?
Dialogue: 0,0:05:36.56,0:05:39.33,Main,,0,0,0,,Teşekkür derim! Bakalım bakalım...
Dialogue: 0,0:05:39.73,0:05:44.31,Main,,0,0,0,,Vay canına! \NBinbir türlü şey var burada, Pekoms!
Dialogue: 0,0:05:44.80,0:05:48.66,Main,,0,0,0,,Minkler bile var! Harikalar diyarı gibi!
Dialogue: 0,0:05:48.66,0:05:52.99,Main,,0,0,0,,Aynen öyle, Mama'nın hayali bu.
Dialogue: 0,0:05:52.99,0:06:00.32,Main,,0,0,0,,İnsanlar, Minkler, Balık İnsanlar, Uzun Kollular, Uzun Bacaklılar, Cüceler...
Dialogue: 0,0:06:00.92,0:06:05.27,Main,,0,0,0,,Dünyadaki tüm ırkların hiçbir ayrım\Ngözetmeden yaşayabilecekleri bir ülke.
Dialogue: 0,0:06:05.27,0:06:08.13,Main,,0,0,0,,Hatta hayır, dünyadaki\Nher şeyin bir arada olduğu yer!
Dialogue: 0,0:06:09.12,0:06:10.76,Main,,0,0,0,,Her şeyin mi?
Dialogue: 0,0:06:10.76,0:06:16.28,Main,,0,0,0,,Evet, Mama'nın ideal dünyası\NTotto Land!
Dialogue: 0,0:06:18.12,0:06:21.52,Main,,0,0,0,,Hayallerinizin ötesinde bir yerdesiniz!{\an8}
Dialogue: 0,0:06:21.52,0:06:25.80,Main,,0,0,0,,Burası Çikolata Bakanı'nın\Nidare ettiği Kakao Adası!
Dialogue: 0,0:06:25.80,0:06:28.45,Main,,0,0,0,,Gördüğünüz şehirse Çikolata Şehri!
Dialogue: 0,0:06:28.45,0:06:31.90,Main,,0,0,0,,Çikolata Şehri! Ne harika bir isim!
Dialogue: 0,0:06:31.90,0:06:34.40,Main,,0,0,0,,Şehirdeki her şey çikolatadan yapılmadır.
Dialogue: 0,0:06:34.40,0:06:38.08,Main,,0,0,0,,Yok artık! Çikolataya bayılırım!\NYiyebilir miyim?
Dialogue: 0,0:06:38.24,0:06:42.90,Main,,0,0,0,,Gao! Bu şehirde doyana kadar\Nçikolata yiyebilirsiniz!
Dialogue: 0,0:06:42.90,0:06:43.95,Main,,0,0,0,,Yaşasın!
Dialogue: 0,0:06:43.95,0:06:45.71,Main,,0,0,0,,Ama dikkatli olun!
Dialogue: 0,0:06:45.71,0:06:48.40,Main,,0,0,0,,Kiremit çikolatalarını yemek\Nkanunlara aykırıdır.
Dialogue: 0,0:06:48.40,0:06:50.88,Main,,0,0,0,,Keza yerseniz\Nyağmuru ve karı uzak tutamazsınız.
Dialogue: 0,0:06:50.88,0:06:52.80,Main,,0,0,0,,Pencere camları Şeker Bakanı'nın...
Dialogue: 0,0:06:52.80,0:06:55.56,Main,,0,0,0,,...kolonlarsa Bisküvi Bakanı'nın sorumluluğunda.
Dialogue: 0,0:06:55.56,0:07:00.49,Main,,0,0,0,,Çikolata dışında geri kalan\Nher şeyse özel mülk yahut kamu malı.
Dialogue: 0,0:07:01.14,0:07:03.10,Main,,0,0,0,,Leziz görünüyor...
Dialogue: 0,0:07:03.10,0:07:05.17,Main,,0,0,0,,Hey! Kime anlatıyorum!?
Dialogue: 0,0:07:05.17,0:07:07.07,Main,,0,0,0,,Pek kafam almıyor ki.
Dialogue: 0,0:07:07.73,0:07:11.53,Main,,0,0,0,,Şey... Acaba külotlar da çikolatadan mı?!
Dialogue: 0,0:07:11.53,0:07:13.03,Main,,0,0,0,,Elbette.
Dialogue: 0,0:07:14.49,0:07:17.29,Main,,0,0,0,,Tutmayın beni! Çikolata külot!
Dialogue: 0,0:07:18.64,0:07:21.46,Main,,0,0,0,,Buraya oynamaya gelmedik.
Dialogue: 0,0:07:21.46,0:07:24.84,Main,,0,0,0,,Alışverişinizi tamamlar tamamlamaz\Nburaya dönün-gao!
Dialogue: 0,0:07:24.84,0:07:29.70,Main,,0,0,0,,Yüzüm tanındığı için gemide kalacağım\Nama çikolatayı çok severim.
Dialogue: 0,0:07:29.70,0:07:31.10,Main,,0,0,0,,Biraz bana da getirin!
Dialogue: 0,0:07:31.10,0:07:31.93,Main,,0,0,0,,Peki!
Dialogue: 0,0:07:33.26,0:07:35.00,Main,,0,0,0,,Hey, Hasır Şapka!
Dialogue: 0,0:07:35.00,0:07:38.07,Main,,0,0,0,,Gitmeyi planlıyorsan vakit kaybetmeyi\Nbırak da sen de kılık değiş-
Dialogue: 0,0:07:38.07,0:07:40.70,Main,,0,0,0,,Luffyler çoktan gittiler bile.
Dialogue: 0,0:07:40.70,0:07:41.39,Main,,0,0,0,,Ne?!
Dialogue: 0,0:07:41.39,0:07:44.70,Main,,0,0,0,,Hey, sizi buraya\Nbenim getirdiğimi öğrenirlerse...
Dialogue: 0,0:07:44.70,0:07:46.40,Main,,0,0,0,,...bana ne olur\Nhiç biliyor musunuz?!
Dialogue: 0,0:07:46.40,0:07:47.84,Main,,0,0,0,,Dikkatli olun biraz!
Dialogue: 0,0:07:47.84,0:07:51.61,Main,,0,0,0,,Endişelenme!\NHemencecik buluruz onları.
Dialogue: 0,0:07:54.41,0:07:56.40,Main,,0,0,0,,Kafeyi yediler!
Dialogue: 0,0:07:56.40,0:07:57.30,Main,,0,0,0,,Oradalar!
Dialogue: 0,0:07:57.30,0:07:58.74,Main,,0,0,0,,Canınız çıkmasın!
Dialogue: 0,0:08:09.71,0:08:13.32,Main,,0,0,0,,Sadece çikolata duvarları yeseniz\Nsonra yerine koyması kolay da...
Dialogue: 0,0:08:13.32,0:08:15.80,Main,,0,0,0,,...bütün kafe gitmiş be!
Dialogue: 0,0:08:22.98,0:08:29.69,Main,,0,0,0,,Şeker, marşmelov, badem ve jeli beeni mahvettiniz!
Dialogue: 0,0:08:29.69,0:08:33.90,Main,,0,0,0,,Atıştırmakolizm suçu bu!\NDerhal sorguya çekileceksiniz!
Dialogue: 0,0:08:33.90,0:08:35.88,Main,,0,0,0,,Benimle hemen karakola gelin!
Dialogue: 0,0:08:35.88,0:08:40.79,Main,,0,0,0,,Ama ihtiyar, bunu boş yere yapmadık.
Dialogue: 0,0:08:40.79,0:08:43.04,Main,,0,0,0,,Neymiş sebebi?!
Dialogue: 0,0:08:43.07,0:08:44.74,Main,,0,0,0,,Aşırı lezizdi!
Dialogue: 0,0:08:44.74,0:08:47.42,Main,,0,0,0,,Pekâlâ, sevdim bunu, aptallar!\NBenimle gelin!
Dialogue: 0,0:08:50.84,0:08:52.90,Main,,0,0,0,,Eyvah! Tutuklanacaklar!
Dialogue: 0,0:08:52.90,0:08:55.09,Main,,0,0,0,,Dikkat çekmemeliyiz, Pedro-san!
Dialogue: 0,0:08:55.55,0:08:58.05,Main,,0,0,0,,Durun biraz Çokopolis-san!
Dialogue: 0,0:09:03.60,0:09:06.80,Lyrics,,0,0,0,,♪ Halı! Halı! ♪
Dialogue: 0,0:09:06.80,0:09:08.61,Main,,0,0,0,,Halı uçuyor...
Dialogue: 0,0:09:08.64,0:09:11.90,Lyrics,,0,0,0,,♪ Halı! Halı! ♪
Dialogue: 0,0:09:13.88,0:09:16.41,Main,,0,0,0,,Kafenin sahibi!
Dialogue: 0,0:09:16.41,0:09:20.45,Main,,0,0,0,,Eyvah ki ne eyvah!\NDükkanın sahibi de geldi!
Dialogue: 0,0:09:22.37,0:09:24.71,Main,,0,0,0,,Kafenize ne yaptılar bir bakın!
Dialogue: 0,0:09:26.02,0:09:28.29,Main,,0,0,0,,İnanamıyorum!
Dialogue: 0,0:09:35.72,0:09:39.22,Captions,,0,0,0,,{\fad(500,0)}Kafenin Sahibi Caramel
Dialogue: 0,0:09:39.30,0:09:42.18,Captions,,0,0,0,,{\fad(400,0)}Jöle Nitro
Dialogue: 0,0:09:42.31,0:09:44.93,Captions,,0,0,0,,{\fad(300,0)}Halı Rabian
Dialogue: 0,0:09:44.93,0:09:50.52,Main,,0,0,0,,Bir sürü bırakmışsınız!\NBöyle mi anlaşmıştık sizinle?! Öf ya!
Dialogue: 0,0:09:51.73,0:09:54.78,Main,,0,0,0,,Hiçbir şey kalmaması lazımdı!
Dialogue: 0,0:10:01.24,0:10:03.41,Main,,0,0,0,,Hey, tanıyor musun?
Dialogue: 0,0:10:03.41,0:10:05.88,Main,,0,0,0,,Yok, tanımıyorum. Kim bu?
Dialogue: 0,0:10:05.88,0:10:08.29,Main,,0,0,0,,Bir de şu omzundaki şey ne?
Dialogue: 0,0:10:08.29,0:10:13.50,Main,,0,0,0,,Buradaki reçel, bisküvi ve\Nçikolatanın uyumu gibisi yok oysaki!
Dialogue: 0,0:10:15.00,0:10:17.17,Main,,0,0,0,,Yiyin hadi!
Dialogue: 0,0:10:24.24,0:10:25.31,Main,,0,0,0,,Beğendiniz mi?
Dialogue: 0,0:10:25.31,0:10:27.64,Main,,0,0,0,,Enfes!
Dialogue: 0,0:10:28.64,0:10:31.33,Main,,0,0,0,,Çokopolis-san, kusura bakmayın.
Dialogue: 0,0:10:31.33,0:10:34.16,Main,,0,0,0,,Kafenin son kullanma tarihi\Ndolmak üzereydi...
Dialogue: 0,0:10:34.16,0:10:36.98,Main,,0,0,0,,...onlardan tüm binayı\Nyemelerini ben istedim.
Dialogue: 0,0:10:36.98,0:10:41.57,Main,,0,0,0,,Bağışlayın.\NYıkım ekibindendiler demek!
Dialogue: 0,0:10:41.57,0:10:43.35,Main,,0,0,0,,Olmaz ama böyle beyler!
Dialogue: 0,0:10:43.35,0:10:46.33,Main,,0,0,0,,Çalışırken dışarı uyarı tabelası\Nfalan koymanız gerekirdi.
Dialogue: 0,0:10:46.33,0:10:48.54,Main,,0,0,0,,Kafede hâlâ müşteriler vardı üstelik.
Dialogue: 0,0:10:48.54,0:10:50.88,Main,,0,0,0,,Öyleyse yüksek müsaadenizle...
Dialogue: 0,0:10:50.88,0:10:55.96,Main,,0,0,0,,Peki, çok sağ olun! Sizleri de\Nrahatsız ettiğim için özür dilerim!
Dialogue: 0,0:10:55.96,0:10:58.33,Main,,0,0,0,,Önemli bir şey değilmiş.
Dialogue: 0,0:10:58.33,0:10:59.97,Main,,0,0,0,,Boşuna endişelenmişiz.
Dialogue: 0,0:11:00.80,0:11:03.18,Main,,0,0,0,,Sahi ya!
Dialogue: 0,0:11:03.18,0:11:07.10,Main,,0,0,0,,Evliliğinizi kutlarım Pudding-sama!
Dialogue: 0,0:11:07.10,0:11:09.54,Main,,0,0,0,,Düğün günü bu kadar yakın olmasına\Nrağmen hâlâ kafenizle ilgileniyorsunuz.
Dialogue: 0,0:11:09.54,0:11:11.14,Main,,0,0,0,,Çok yormayın kendinizi.
Dialogue: 0,0:11:11.14,0:11:14.89,Main,,0,0,0,,Hepimiz mutluluğunuzu diliyoruz.
Dialogue: 0,0:11:14.89,0:11:16.78,Main,,0,0,0,,Teşekkür ederim!
Dialogue: 0,0:11:17.80,0:11:20.33,Main,,0,0,0,,Luffyleri kurtardı gibi.
Dialogue: 0,0:11:20.33,0:11:23.50,Main,,0,0,0,,Çok iyi biriymiş. Kim acaba?
Dialogue: 0,0:11:23.50,0:11:25.12,Main,,0,0,0,,Ne şanslılar!
Dialogue: 0,0:11:25.89,0:11:29.56,Main,,0,0,0,,Talih geleceğin Korsanlar Kralı'na\Nböyle gülüyor.
Dialogue: 0,0:11:30.87,0:11:32.96,Main,,0,0,0,,Kaptan Pedro?
Dialogue: 0,0:11:34.08,0:11:39.00,Main,,0,0,0,,Kaptan Pedro'sunuz değil mi?!\NGörüşmeyeli o kadar uzun zaman oldu ki!
Dialogue: 0,0:11:39.00,0:11:40.22,Main,,0,0,0,,Neden buradasınız?
Dialogue: 0,0:11:40.72,0:11:43.60,Main,,0,0,0,,Gezmeye geldim. Kimseye bahsetme.
Dialogue: 0,0:11:43.60,0:11:47.14,Main,,0,0,0,,Pe-Peki.\NSizinle karşılaşabilmek büyük şeref.
Dialogue: 0,0:11:48.12,0:11:50.85,Main,,0,0,0,,Bu şehirde tanıdıkların mı var Pedro?
Dialogue: 0,0:11:51.72,0:11:53.48,Main,,0,0,0,,Sonra anlatırım.
Dialogue: 0,0:11:56.19,0:12:00.07,Main,,0,0,0,,Adın Pudding demek? Teşekkür ederim.\NÇok yardımcı oldun.
Dialogue: 0,0:12:00.07,0:12:04.08,Main,,0,0,0,,Olur mu öyle şey!\NAsıl benim size teşekkür etmem lazım!
Dialogue: 0,0:12:04.08,0:12:05.46,Main,,0,0,0,,Neden ki?
Dialogue: 0,0:12:05.46,0:12:07.58,Main,,0,0,0,,Acayip leziz olmuş...
Dialogue: 0,0:12:08.38,0:12:11.54,Main,,0,0,0,,...demediniz mi?
Dialogue: 0,0:12:12.03,0:12:17.05,Main,,0,0,0,,O kafedeki çikolata\Nkendi bulduğum bir karışım!
Dialogue: 0,0:12:17.05,0:12:18.84,Main,,0,0,0,,Ağızda bıraktığı his nasıldı?
Dialogue: 0,0:12:18.84,0:12:22.20,Main,,0,0,0,,Kakao yağına süt ve yoğun saflıkta\Npancar şekeri ekleyip...
Dialogue: 0,0:12:22.20,0:12:26.04,Main,,0,0,0,,...29 derecede\Nüç gün üç gece boyunca yoğurdum!
Dialogue: 0,0:12:26.04,0:12:29.46,Main,,0,0,0,,Neden bahsediyorsun bilmiyorum\Nama efsane ötesiydi!
Dialogue: 0,0:12:29.46,0:12:31.56,Main,,0,0,0,,Öyleydi!
Dialogue: 0,0:12:31.56,0:12:35.90,Main,,0,0,0,,Siz böyle deyince gözyaşlarıma\Nengel olamayacak hale geliyorum!
Dialogue: 0,0:12:35.90,0:12:39.15,Main,,0,0,0,,Teşekkür ederim!\NÇok mutlu ettiniz beni!
Dialogue: 0,0:12:39.15,0:12:41.69,Main,,0,0,0,,N-Ne...
Dialogue: 0,0:12:41.69,0:12:45.49,Main,,0,0,0,,Ne iyi bir kız!
Dialogue: 0,0:12:45.49,0:12:47.72,Main,,0,0,0,,Çikolata yapmayı sever misin?
Dialogue: 0,0:12:47.72,0:12:50.12,Main,,0,0,0,,Tatlı şeylere bayılırım ben!
Dialogue: 0,0:12:50.12,0:12:53.66,Main,,0,0,0,,Bu şehir tamamıyla\Nçikolata kokuyor, cennet resmen!
Dialogue: 0,0:12:53.66,0:12:55.46,Main,,0,0,0,,Masa bile çikolatadan!
Dialogue: 0,0:12:55.46,0:12:56.79,Main,,0,0,0,,Ne güzel!
Dialogue: 0,0:12:56.79,0:13:00.59,Main,,0,0,0,,İşin aslı bir süre daha kalıp sana\Ndüzgünce teşekkür etmek isterdik Pudding...
Dialogue: 0,0:13:00.59,0:13:02.49,Main,,0,0,0,,...ama gitmemiz lazım.
Dialogue: 0,0:13:02.49,0:13:04.97,Main,,0,0,0,,Hadi ya? Çok yazık.
Dialogue: 0,0:13:04.97,0:13:08.18,Main,,0,0,0,,Gitmeden önce\Nazıcık çay içmez misiniz peki?
Dialogue: 0,0:13:08.18,0:13:10.46,Main,,0,0,0,,Şekerli şeylerden sonra iyi gider!
Dialogue: 0,0:13:10.46,0:13:12.56,Main,,0,0,0,,Çay süper fikir!
Dialogue: 0,0:13:12.56,0:13:14.77,Main,,0,0,0,,Peki öyleyse, hemen dönerim.
Dialogue: 0,0:13:14.77,0:13:18.98,Main,,0,0,0,,Ne iyi bir kız! Melek resmen melek!
Dialogue: 0,0:13:21.11,0:13:24.45,Main,,0,0,0,,Sahi ya, adınızı sormayı unuttum.
Dialogue: 0,0:13:24.45,0:13:26.03,Main,,0,0,0,,Ben Luffy.
Dialogue: 0,0:13:26.03,0:13:27.65,Main,,0,0,0,,Korsanlar Kralı olacak...
Dialogue: 0,0:13:27.65,0:13:28.24,Main,,0,0,0,,Dur!
Dialogue: 0,0:13:28.24,0:13:30.08,Main,,0,0,0,,Ne?
Dialogue: 0,0:13:35.50,0:13:37.08,Main,,0,0,0,,Luffy mi?
Dialogue: 0,0:13:42.13,0:13:48.76,Captions,,0,0,0,,{\fad(1000,550)}Whole Cake Adası
Dialogue: 0,0:14:10.62,0:14:13.79,Lyrics,,0,0,0,,♪ Kaç gün kaldı çay partisine? ♪
Dialogue: 0,0:14:13.79,0:14:16.33,Lyrics,,0,0,0,,♪ Üç gün, Mama ♪
Dialogue: 0,0:14:16.33,0:14:17.92,Lyrics,,0,0,0,,♪ Papatya! Papatya! ♪
Dialogue: 0,0:14:17.92,0:14:19.52,Lyrics,,0,0,0,,♪ Öyle hay! ♪
Dialogue: 0,0:14:19.52,0:14:22.88,Lyrics,,0,0,0,,♪ Germa'nın oğluna ne oldu peki? ♪
Dialogue: 0,0:14:22.88,0:14:25.34,Lyrics,,0,0,0,,♪ Pekâlâ adada, Mama! ♪
Dialogue: 0,0:14:25.34,0:14:28.88,Lyrics,,0,0,0,,♪ Eşya! Eşya! Eşya! Eşya! ♪
Dialogue: 0,0:14:29.90,0:14:33.39,Lyrics,,0,0,0,,♪ Düğün olacak! ♪
Dialogue: 0,0:14:33.39,0:14:37.64,Lyrics,,0,0,0,,♪ Pasta ne durumda? ♪
Dialogue: 0,0:14:37.64,0:14:41.40,Lyrics,,0,0,0,,♪ Düğün pastası! ♪
Dialogue: 0,0:14:41.40,0:14:43.15,Lyrics,,0,0,0,,♪ Şekli nasıl? ♪\N♪ Tastamam! ♪
Dialogue: 0,0:14:43.15,0:14:44.90,Lyrics,,0,0,0,,♪ Bütçe peki? ♪\N♪ Gayet cömert! ♪
Dialogue: 0,0:14:44.90,0:14:46.74,Lyrics,,0,0,0,,♪ Malzemeleriyse... ♪
Dialogue: 0,0:14:46.74,0:14:54.73,Lyrics,,0,0,0,,♪ Özenle seçin, öldürüp soyarak herkesi! ♪
Dialogue: 0,0:14:57.75,0:14:58.79,Lyrics,,0,0,0,,♪ Yumurta! ♪
Dialogue: 0,0:15:01.17,0:15:02.46,Lyrics,,0,0,0,,♪ Hazır. ♪
Dialogue: 0,0:15:03.04,0:15:04.67,Lyrics,,0,0,0,,♪ Un! ♪
Dialogue: 0,0:15:06.20,0:15:07.55,Lyrics,,0,0,0,,♪ Hazır! ♪
Dialogue: 0,0:15:08.42,0:15:09.93,Lyrics,,0,0,0,,♪ Meyveler! ♪
Dialogue: 0,0:15:11.76,0:15:13.22,Lyrics,,0,0,0,,♪ Hazır. ♪
Dialogue: 0,0:15:13.68,0:15:16.14,Lyrics,,0,0,0,,♪ Tadı dehşet olacak! ♪
Dialogue: 0,0:15:16.14,0:15:19.64,Lyrics,,0,0,0,,♪ Leziz mi leziz pastayı yiyelim! ♪
Dialogue: 0,0:15:19.64,0:15:22.77,Lyrics,,0,0,0,,♪ Tatlı ilişkiler! ♪
Dialogue: 0,0:15:23.26,0:15:27.90,Lyrics,,0,0,0,,♪ Cehennem çay partisi! ♪
Dialogue: 0,0:15:29.15,0:15:32.28,Lyrics,,0,0,0,,♪ Çilek reçeli mi bu? ♪\N♪ Yoksa birinin kanı mı?! ♪
Dialogue: 0,0:15:32.28,0:15:35.99,Lyrics,,0,0,0,,♪ Hangisi olursa olsun umurumda değil! ♪
Dialogue: 0,0:15:35.99,0:15:39.33,Lyrics,,0,0,0,,♪ Edildiysen davet orada ol muhakkak! ♪
Dialogue: 0,0:15:37.94,0:15:39.96,Lyrics,,0,0,0,,♪ Tatlı bir an! ♪
Dialogue: 0,0:15:39.96,0:15:42.46,Lyrics,,0,0,0,,♪ Şeytana Kurban! ♪
Dialogue: 0,0:15:43.67,0:15:47.21,Lyrics,,0,0,0,,♪ Burası herkesin hayaller ülkesi.... ♪
Dialogue: 0,0:15:47.21,0:15:52.05,Lyrics,,0,0,0,,♪ Tüm ırkların bir araya geldiği... ♪
Dialogue: 0,0:15:52.05,0:15:54.75,Lyrics,,0,0,0,,♪ Totto Land! ♪
Dialogue: 0,0:16:06.06,0:16:10.36,Lyrics,,0,0,0,,♪ Mmm, sabırsızlanıyorum! Buradaymış diye duydum. ♪
Dialogue: 0,0:16:10.36,0:16:14.32,Lyrics,,0,0,0,,♪ Burada, hmm, evet. ♪
Dialogue: 0,0:16:15.82,0:16:20.70,Lyrics,,0,0,0,,{\k79\blur1}{\fad(222,0)\i1}♪ Ha{\k87}sır! {\k99}Şap{\k111}ka! ♪{\i}
Dialogue: 0,0:16:23.29,0:16:27.09,Captions,,0,0,0,,{\fad(750,0)}Çikolata Şehri, Kakao Adası
Dialogue: 0,0:16:27.09,0:16:29.09,Main,,0,0,0,,Luffy derken...
Dialogue: 0,0:16:32.17,0:16:33.43,Main,,0,0,0,,Eyvah ki ne eyvah!
Dialogue: 0,0:16:37.05,0:16:41.64,Main,,0,0,0,,Şimdi fark ettim de, gerçekten de\NHasır Şapkalı Luffy'e benziyorsun!
Dialogue: 0,0:16:43.27,0:16:46.52,Main,,0,0,0,,Aynen öyle!\NKorsanlar Kralı olacak adam!
Dialogue: 0,0:16:48.48,0:16:50.48,Main,,0,0,0,,Ve böylece foyamız ortaya çıkar!
Dialogue: 0,0:16:52.19,0:16:56.47,Main,,0,0,0,,Siz gerçekten de\NKorsan Hasır Şapka Tayfası mısınız?!
Dialogue: 0,0:16:56.47,0:16:57.91,Main,,0,0,0,,Evet, öyleyiz!
Dialogue: 0,0:16:58.28,0:17:02.12,Main,,0,0,0,,Sanji-san'ın dostları! Yok artık!
Dialogue: 0,0:17:02.12,0:17:06.11,Main,,0,0,0,,Neresi yok artık?!\NSanji bizim dostumuz!
Dialogue: 0,0:17:07.11,0:17:08.84,Main,,0,0,0,,Sanji'yi nereden biliyorsun?
Dialogue: 0,0:17:15.13,0:17:17.34,Main,,0,0,0,,Ne?!
Dialogue: 0,0:17:22.35,0:17:27.44,Main,,0,0,0,,Sanji'yle evlenecek\NBig Mom'ın kızı sen misin Pudding?!
Dialogue: 0,0:17:30.65,0:17:32.28,Main,,0,0,0,,Sanji'nin nişanlısı...
Dialogue: 0,0:17:32.28,0:17:36.36,Main,,0,0,0,,Çok kıskandım! Ne güzel bir eş!
Dialogue: 0,0:17:37.46,0:17:40.37,Main,,0,0,0,,E-Eş falan...
Dialogue: 0,0:17:41.83,0:17:43.87,Main,,0,0,0,,Ama nasıl?!
Dialogue: 0,0:17:43.87,0:17:49.58,Main,,0,0,0,,Mama'nın ittifakı dışında olmanıza rağmen\NTART güvenliğini nasıl geçtiniz?!
Dialogue: 0,0:17:49.58,0:17:53.96,Main,,0,0,0,,Neden buraya geldiniz? Öldürüleceksiniz!
Dialogue: 0,0:17:53.96,0:17:59.30,Main,,0,0,0,,Çoktan Mama'nın bölgesindesiniz\Nve Mama çok korkunç bir korsandır!
Dialogue: 0,0:18:00.80,0:18:05.33,Main,,0,0,0,,Ama biliyorum, siz de korkunç korsanlarsınız!
Dialogue: 0,0:18:06.09,0:18:08.15,Main,,0,0,0,,Olamaz!
Dialogue: 0,0:18:08.15,0:18:11.73,Main,,0,0,0,,Bekle! Sakinleş biraz!\NSana bir şey yapmayacağız!
Dialogue: 0,0:18:15.14,0:18:17.56,Main,,0,0,0,,Luffy, n'apalım bunu?
Dialogue: 0,0:18:17.56,0:18:19.86,Main,,0,0,0,,Bir şey yapmayacağız dedik, Pedro!
Dialogue: 0,0:18:22.08,0:18:25.75,Main,,0,0,0,,Sanji-san için geldiniz demek...
Dialogue: 0,0:18:26.95,0:18:29.75,Main,,0,0,0,,Onu geri alacaksınız.
Dialogue: 0,0:18:31.62,0:18:36.92,Main,,0,0,0,,Mama canı ne isterse onu yapıyor,\NSanji-san'ın rızası olmadığını biliyordum.
Dialogue: 0,0:18:36.92,0:18:42.94,Main,,0,0,0,,Kendi çocuklarının evliliklerini dahi\Nkorsan grubunu güçlendirmek için kullanıyor.
Dialogue: 0,0:18:42.94,0:18:48.02,Main,,0,0,0,,Özgürce sevdiğimiz kişiyle evlenme\Ndüşüncesinden çoktan vazgeçtik.
Dialogue: 0,0:18:48.02,0:18:51.73,Main,,0,0,0,,Zaten vazgeç ya da kaç,\Nbaşka seçeneğimiz yok.
Dialogue: 0,0:18:52.81,0:18:59.24,Main,,0,0,0,,Çok sevdiğim ablalarımdan biri\Naşkı aramak için denize yelken açtı.
Dialogue: 0,0:18:59.86,0:19:01.78,Main,,0,0,0,,Kendine bir eş bulabilmek için.
Dialogue: 0,0:19:05.41,0:19:07.88,Main,,0,0,0,,Merak ettiğim için soruyorum...
Dialogue: 0,0:19:07.88,0:19:12.00,Main,,0,0,0,,...Charlotte Ailesi'nin 35. kızısın değil mi?
Dialogue: 0,0:19:12.00,0:19:15.30,Main,,0,0,0,,Big Mom'ın 35 tane kızı mı var\Ndemek oluyor bu?
Dialogue: 0,0:19:15.30,0:19:20.60,Main,,0,0,0,,Tam olarak 39 kızı ve 46 oğlu var.
Dialogue: 0,0:19:20.60,0:19:23.51,Main,,0,0,0,,85 kardeşiz.
Dialogue: 0,0:19:23.51,0:19:24.47,Main,,0,0,0,,Amanın!
Dialogue: 0,0:19:24.47,0:19:28.68,Main,,0,0,0,,Vay canına! 85 kardeşsiniz ha!
Dialogue: 0,0:19:28.68,0:19:35.65,Main,,0,0,0,,Babalarımız başka başka gerçi.\NMama'nın 43 kocası var, 129 kişilik bir aileyiz.
Dialogue: 0,0:19:35.65,0:19:38.69,Main,,0,0,0,,129 mu?!
Dialogue: 0,0:19:38.69,0:19:42.36,Main,,0,0,0,,Bazı abi ve ablalarımın\Nçocukları da var tabii...
Dialogue: 0,0:19:42.36,0:19:45.91,Main,,0,0,0,,...yani onları da dahil edersek\Ndaha da çok oluyor.
Dialogue: 0,0:19:45.91,0:19:51.21,Main,,0,0,0,,Big Mom Korsanları çoğunlukla kan bağına\Nsahip akrabalardan oluşuyor.
Dialogue: 0,0:19:55.08,0:19:56.92,Main,,0,0,0,,Big Mom adının hakkını veriyor!
Dialogue: 0,0:20:01.21,0:20:05.22,Main,,0,0,0,,Sanji'yle tanıştın mı peki?
Dialogue: 0,0:20:05.22,0:20:09.27,Main,,0,0,0,,Ev-Ev-Evet... Bir kerecik...
Dialogue: 0,0:20:10.47,0:20:15.79,Main,,0,0,0,,Kaşları kıvırcıktı ama\Ngerçekten çok iyi kalpli ve kibar biri!
Dialogue: 0,0:20:15.79,0:20:17.80,Lyrics,,0,0,0,,♪ Çiçek! Çiçek! ♪
Dialogue: 0,0:20:17.80,0:20:19.36,Main,,0,0,0,,Gözleri kalpten olsa bile...
Dialogue: 0,0:20:19.36,0:20:23.30,Main,,0,0,0,,...tatlılar konusunda çok bilgiliydi\Nve bana bir sürü şey öğretti!
Dialogue: 0,0:20:23.30,0:20:25.66,Lyrics,,0,0,0,,♪ Çiçek! Çiçek! ♪
Dialogue: 0,0:20:25.66,0:20:28.24,Main,,0,0,0,,Hobilerimiz uyuyor ve çok mert biri!
Dialogue: 0,0:20:28.24,0:20:32.21,Main,,0,0,0,,Bacakları karaymış diye duydum\Nama çok güçlü ve güvenilir biri!
Dialogue: 0,0:20:32.21,0:20:34.00,Main,,0,0,0,,Di' mi ama!
Dialogue: 0,0:20:36.58,0:20:39.50,Main,,0,0,0,,"Kara Bacak" o anlamda değil ki.
Dialogue: 0,0:20:39.50,0:20:44.51,Main,,0,0,0,,Ha şunu bileydin! Harika biridir!
Dialogue: 0,0:20:46.30,0:20:50.47,Main,,0,0,0,,Yo-Yoksa sen Sanji-san'a...
Dialogue: 0,0:20:51.89,0:20:54.77,Main,,0,0,0,,Sanji-kun'a aşık mı oldun?!
Dialogue: 0,0:20:54.77,0:21:00.34,Main,,0,0,0,,Aş-Aşk derken... Yani nasıl desem...
Dialogue: 0,0:21:00.34,0:21:03.36,Main,,0,0,0,,Mama'nın kararına karşı gelemem.
Dialogue: 0,0:21:03.36,0:21:08.07,Main,,0,0,0,,Ve evleneceksem de, evet, şey...
Dialogue: 0,0:21:09.33,0:21:13.71,Main,,0,0,0,,Sanji'yi ben de çok seviyorum!\NSeninle aynıyız!
Dialogue: 0,0:21:13.71,0:21:16.17,Main,,0,0,0,,Öyle çok seviyorum falan...
Dialogue: 0,0:21:17.38,0:21:19.18,Main,,0,0,0,,ŞOK!!
Dialogue: 0,0:21:19.18,0:21:25.34,Main,,0,0,0,,Tamamen ne umduk ne bulduk durumu! \NGelinin bu denli sevimli biri olduğuna inanamıyorum!
Dialogue: 0,0:21:25.34,0:21:28.51,Main,,0,0,0,,Sanji-san'ın gözlerinin\Nkalp kalp olmasına şaşırmamalı!
Dialogue: 0,0:21:30.43,0:21:33.68,Main,,0,0,0,,Elini kolunu bağlayalım bence!
Dialogue: 0,0:21:41.90,0:21:44.44,Main,,0,0,0,,Yoksa bizim burada olduğumuzu öter.
Dialogue: 0,0:21:44.44,0:21:47.28,Main,,0,0,0,,En dıştaki adalardan birinde enselenirsek...
Dialogue: 0,0:21:47.28,0:21:50.37,Main,,0,0,0,,...Sanji'nin olduğu yere ulaşmayı unutun!
Dialogue: 0,0:21:50.99,0:21:53.37,Main,,0,0,0,,Kalbin taş mı senin Pedro?!
Dialogue: 0,0:21:53.37,0:21:56.14,Main,,0,0,0,,Onu nasıl susturmayı planlıyorsun peki?
Dialogue: 0,0:21:56.14,0:22:00.13,Main,,0,0,0,,Big Mom'ın kızı olduğunu unutmayın.
Dialogue: 0,0:22:00.13,0:22:05.03,Main,,0,0,0,,Öyle ama Pudding de annesinden korkuyor!
Dialogue: 0,0:22:05.03,0:22:06.80,Main,,0,0,0,,O yüzden de ötecek!
Dialogue: 0,0:22:06.80,0:22:08.47,Main,,0,0,0,,Nereden biliyorsun ya!
Dialogue: 0,0:22:08.47,0:22:10.72,Main,,0,0,0,,Sen-gara kapa çeneni!
Dialogue: 0,0:22:14.64,0:22:15.56,Main,,0,0,0,,Şey...
Dialogue: 0,0:22:23.48,0:22:27.28,Main,,0,0,0,,Şu an hâlâ Sanji-san'a\Nkarşı yeşeren duygularımı...
Dialogue: 0,0:22:28.11,0:22:29.91,Main,,0,0,0,,...unutabilecek safhadayım.
Dialogue: 0,0:22:39.04,0:22:41.08,Main,,0,0,0,,Totta Adası'ndaki herkes...
Dialogue: 0,0:22:45.05,0:22:48.34,Main,,0,0,0,,...evliliğimi kutluyor.
Dialogue: 0,0:22:50.68,0:22:53.18,Main,,0,0,0,,Vinsmoke Ailesi'nin üyeleri de öyle.
Dialogue: 0,0:22:53.18,0:22:56.10,Main,,0,0,0,,Mama da düğün kekini\Ndört gözle bekliyor.
Dialogue: 0,0:22:58.40,0:23:03.82,Main,,0,0,0,,Hiçbirimiz Mama'nın emrine karşı gelemeyiz,\Nyani aşk için evlenemeyeceğimi biliyordum...
Dialogue: 0,0:23:03.82,0:23:07.44,Main,,0,0,0,,...ama küçüklüğümden beri\Nhep hayalimi süsleyen bir şeydi.
Dialogue: 0,0:23:08.86,0:23:12.66,Main,,0,0,0,,Evleneceğim kişinin\Nnasıl biri olacağını düşünürdüm hep.
Dialogue: 0,0:23:13.83,0:23:17.33,Main,,0,0,0,,Ve Sanji-san geldiğinde...
Dialogue: 0,0:23:35.50,0:23:39.31,Main,,0,0,0,,Tam hayallerimdeki gibi harika biri\Nolduğunu görünce çok şaşırdım.
Dialogue: 0,0:23:40.52,0:23:44.65,Main,,0,0,0,,Ama nihayetinde bana şunu dedi...
Dialogue: 0,0:23:47.57,0:23:51.36,Main,,0,0,0,,"Seninle evlenmek istiyorum\Nama evlenemem."
Dialogue: 0,0:23:54.48,0:23:57.74,Main,,0,0,0,,"Dostlarımın yanına dönmek istiyorum."
Dialogue: 0,0:23:57.74,0:24:02.17,Main,,0,0,0,,Yok artık!\NSanji bir kızı geri mi çevirmiş?!
Dialogue: 0,0:24:03.61,0:24:09.63,Main,,0,0,0,,Ama... Öyle ha... Tabii ya...\NO da maceraya devam etmek istiyor!
Dialogue: 0,0:24:11.17,0:24:14.55,Main,,0,0,0,,Hem bu sadece onun değil...
Dialogue: 0,0:24:14.55,0:24:20.93,Main,,0,0,0,,...hayatlarınız pahasına onu buraya\Nalmaya gelen sizlerin de hisleri.
Dialogue: 0,0:24:22.13,0:24:24.60,Main,,0,0,0,,Ne kadar Mama'nın kararı da olsa...
Dialogue: 0,0:24:24.60,0:24:29.15,Main,,0,0,0,,...evlenmek istemeyen birinin yanında\Nkalmak benim için de zor olacak.
Dialogue: 0,0:24:29.82,0:24:35.91,Main,,0,0,0,,Hem her şeyden öte Sanji-san'ı,\Nona ta buralara gelecek kadar...
Dialogue: 0,0:24:36.81,0:24:39.20,Main,,0,0,0,,...değer veren sizlerden alamam.
Dialogue: 0,0:24:40.91,0:24:45.13,Main,,0,0,0,,Sanji-san da dostlarının yanına\Ndönmek istediğini söyledi hem.
Dialogue: 0,0:24:45.13,0:24:49.05,Main,,0,0,0,,Bu durumda elimden ona yardım\Netmekten başka ne gelir ki?
Dialogue: 0,0:24:50.21,0:24:52.01,Main,,0,0,0,,Bu rotayı takip edin.
Dialogue: 0,0:24:52.88,0:24:55.56,Main,,0,0,0,,Bu yalnızca biz kardeşlerin bildiği...
Dialogue: 0,0:24:55.56,0:24:58.72,Main,,0,0,0,,...Mama'nın izleyemeyeceği tek yol.
Dialogue: 0,0:24:59.37,0:25:00.93,Main,,0,0,0,,Sanji orada mı?
Dialogue: 0,0:25:01.51,0:25:06.86,Main,,0,0,0,,Bu rotayı takip ederseniz\NWhole Cake Adası'na kadar varabilirsiniz.
Dialogue: 0,0:25:06.86,0:25:10.73,Main,,0,0,0,,Fakat Mama Sanji-san'ın\Nkaçmasına asla izin vermez.
Dialogue: 0,0:25:11.23,0:25:15.70,Main,,0,0,0,,O yüzden yarın Whole Cake Adası'nın\Ngüneybatı kıyısında buluşalım.
Dialogue: 0,0:25:17.53,0:25:21.08,Main,,0,0,0,,Sanji-san'ı oraya\Nne pahasına olursa olsun getireceğim.
Dialogue: 0,0:25:21.08,0:25:23.29,Main,,0,0,0,,Size yardım edeceğim!
Dialogue: 0,0:25:23.29,0:25:26.90,Main,,0,0,0,,Emin misin?\NBig Mom seni cezalandırmasın?
Dialogue: 0,0:25:26.90,0:25:30.42,Main,,0,0,0,,Öz kızıyım sonuçta.\NEndişelenmenize gerek yok.
Dialogue: 0,0:25:30.42,0:25:34.38,Main,,0,0,0,,Düşman bölgesindesiniz.\NKendinizi düşünün biraz.
Dialogue: 0,0:25:34.38,0:25:35.76,Main,,0,0,0,,Pudding...
Dialogue: 0,0:25:41.89,0:25:44.85,Main,,0,0,0,,Buna gerçekten emin misin?
Dialogue: 0,0:25:44.85,0:25:48.40,Main,,0,0,0,,Birbirinize epey değer veriyorsunuz.
Dialogue: 0,0:25:50.61,0:25:54.15,Main,,0,0,0,,Pudding-{\i1}san{\i}, sen var ya sen...
Dialogue: 0,0:25:54.15,0:25:58.86,Main,,0,0,0,,Bu seferlik yazık olacak belki ama kim bilir\Nbelki bir sonraki koca adayım...
Dialogue: 0,0:25:59.39,0:26:02.04,Main,,0,0,0,,...daha iyi biri bile çıkabilir!
Dialogue: 0,0:26:02.04,0:26:08.46,Main,,0,0,0,,Ne biçim iyi kalpli bir kız bu!\NGerçekten Yonkou'nun kızı mısın sen?
Dialogue: 0,0:26:11.80,0:26:13.67,Main,,0,0,0,,Çok sağ ol, Pudding!
Dialogue: 0,0:26:13.67,0:26:15.51,Main,,0,0,0,,Rica ederim!
Dialogue: 0,0:26:20.08,0:26:23.52,Main,,0,0,0,,Pudding-{\i1}sama{\i}, sizi almaya geldik.
Dialogue: 0,0:26:23.52,0:26:25.43,Main,,0,0,0,,Bir saniye bekleyin!
Dialogue: 0,0:26:25.43,0:26:29.06,Main,,0,0,0,,İşimin ortasındayım şu an,\Nbirazcık bekleyin.
Dialogue: 0,0:26:30.56,0:26:35.06,Main,,0,0,0,,Artık en azından evlenene kadar bari\Nişinize ara verin, Pudding-{\i1}sama{\i}.
Dialogue: 0,0:26:35.06,0:26:37.95,Main,,0,0,0,,Fakat müşterilerim var...
Dialogue: 0,0:26:37.95,0:26:39.91,Main,,0,0,0,,Evlilik töreni için de hazırlanmanız lazım.
Dialogue: 0,0:26:47.83,0:26:52.25,Main,,0,0,0,,Siz geldiniz demek!\NSipariş ettiğiniz yiyecekleri hazırladım.
Dialogue: 0,0:26:52.25,0:26:54.09,Main,,0,0,0,,Hepsi orada, götürebilirsiniz.
Dialogue: 0,0:26:54.09,0:26:55.80,Main,,0,0,0,,Buradaymışlar!
Dialogue: 0,0:26:55.80,0:26:57.08,Main,,0,0,0,,Taşıyabilecek misiniz?
Dialogue: 0,0:26:57.08,0:26:59.18,Main,,0,0,0,,Sağ olun. Biz hallederiz.
Dialogue: 0,0:27:02.09,0:27:03.62,Main,,0,0,0,,Çokoburger mi?!
Dialogue: 0,0:27:03.62,0:27:07.64,Main,,0,0,0,,Sağa sola bakınmayı bırak!\NGidelim hadi! Pekoms bizi bekliyor!
Dialogue: 0,0:27:07.64,0:27:10.69,Main,,0,0,0,,Çokoburger al bana Nami!
Dialogue: 0,0:27:12.40,0:27:15.36,Main,,0,0,0,,- Çokomakarna!\N- Kızarmış çoko tavuk topları!
Dialogue: 0,0:27:15.36,0:27:18.53,Main,,0,0,0,,Bol bol yiyeceğimiz var, yürüyün hadi!
Dialogue: 0,0:27:22.04,0:27:23.20,Main,,0,0,0,,He?
Dialogue: 0,0:27:23.72,0:27:25.03,Main,,0,0,0,,Pekoms?
Dialogue: 0,0:27:25.03,0:27:26.52,Main,,0,0,0,,Bulabildiniz mi?
Dialogue: 0,0:27:26.52,0:27:27.68,Main,,0,0,0,,Yok!
Dialogue: 0,0:27:27.68,0:27:29.72,Main,,0,0,0,,Çok tuhaf.
Dialogue: 0,0:27:29.72,0:27:32.12,Main,,0,0,0,,Sıçmaya mı gitti acaba?\NTuvalate bakan oldu mu?
Dialogue: 0,0:27:32.12,0:27:34.25,Main,,0,0,0,,Hey!
Dialogue: 0,0:27:35.59,0:27:37.30,Main,,0,0,0,,Tuvalete mesaj bırakılmış!
Dialogue: 0,0:27:45.33,0:27:47.31,Main,,0,0,0,,"Geri dönün" mü?!
Dialogue: 0,0:27:47.31,0:27:51.24,Main,,0,0,0,,- Pekoms mu yazmış bunu?\N- Başka kim olabilir ki?
Dialogue: 0,0:27:51.24,0:27:52.86,Main,,0,0,0,,Birileri mi geldi acaba?
Dialogue: 0,0:27:52.86,0:27:56.09,Main,,0,0,0,,Pekoms'u kaçırmış olabilirler mi?
Dialogue: 0,0:27:56.09,0:27:59.82,Main,,0,0,0,,Geldiğimizi çoktan anlamış olabilirler.
Dialogue: 0,0:27:59.82,0:28:02.57,Main,,0,0,0,,Her halükârda çok ciddi bir durum bu.
Dialogue: 0,0:28:02.57,0:28:04.99,Note,,0,0,0,,Geri Dönün
Dialogue: 0,0:28:05.02,0:28:09.52,Main,,0,0,0,,"Geri dönün" dediğine göre aksi durumda\Nbaşımıza bir şeyler gelecek demek oluyor bu.
Dialogue: 0,0:28:09.52,0:28:10.30,Main,,0,0,0,,Evet.
Dialogue: 0,0:28:10.30,0:28:13.58,Main,,0,0,0,,Pekâlâ millet, bunu unutmayın öyleyse!
Dialogue: 0,0:28:21.16,0:28:22.26,Main,,0,0,0,,Devam ediyoruz!
Dialogue: 0,0:28:23.51,0:28:27.18,Main,,0,0,0,,İşler ilginçleşmeye başladı!
Dialogue: 0,0:28:32.69,0:28:37.15,Captions,,0,0,0,,{\fad(500,0)}Brock Collie Adası, Yeni Dünya
Dialogue: 0,0:29:10.93,0:29:12.48,Main,,0,0,0,,Kahretsin!
Dialogue: 0,0:29:20.57,0:29:22.26,Main,,0,0,0,,- Her şey tamam mı?\N- Evet efendim.
Dialogue: 0,0:29:22.26,0:29:24.20,Main,,0,0,0,,Gidelim öyleyse.
Dialogue: 0,0:29:26.35,0:29:29.08,Main,,0,0,0,,Karımı öldürdünüz!
Dialogue: 0,0:29:29.08,0:29:31.66,Main,,0,0,0,,Çocuklarımı öldürdünüz!
Dialogue: 0,0:29:31.66,0:29:35.25,Main,,0,0,0,,Ülkemi yok ettiniz!
Dialogue: 0,0:29:35.25,0:29:39.84,Main,,0,0,0,,Germa'sınız değil mi siz?!\Nİnsan değilsiniz!
Dialogue: 0,0:29:40.20,0:29:41.09,Main,,0,0,0,,Duvar.
Dialogue: 0,0:30:01.94,0:30:03.99,Main,,0,0,0,,Dört saat sürdüğüne inanamıyorum.
Dialogue: 0,0:30:04.44,0:30:08.61,Main,,0,0,0,,Daha kardeşimin\Nevlilik törenine katılmam lazım.
Dialogue: 0,0:30:12.37,0:30:15.33,Main,,0,0,0,,Ailene ne olduğu umrumda değil.
Dialogue: 0,0:30:16.95,0:30:20.29,Main,,0,0,0,,Keza verdiğiniz bu savaşa da.
Dialogue: 0,0:30:27.03,0:30:28.93,Main,,0,0,0,,Bitti.
Dialogue: 0,0:30:28.93,0:30:33.56,Main,,0,0,0,,Böyle aciz iki ülke arasındaki savaş\Nnasıl iki yıl sürer?!
Dialogue: 0,0:30:34.18,0:30:36.77,Main,,0,0,0,,- Komisyonumuz?\N- Aldım.
Dialogue: 0,0:30:51.16,0:30:55.66,Main,,0,0,0,,- Teşekkür ederiz!\N- Teşekkür ederiz!
Dialogue: 0,0:30:55.66,0:31:01.64,Main,,0,0,0,,Ülkemiz kurtuldu.\NAma bunun için şeytana mı başvurduk?
Dialogue: 0,0:31:01.64,0:31:06.26,Main,,0,0,0,,Hayır, şeytan değil!\NTanrı'nın eli onlar!
Dialogue: 0,0:31:07.07,0:31:12.26,Main,,0,0,0,,Silahlarınızı atın!\NSavaş sona erdi! Sona erdi!
Dialogue: 0,0:31:15.68,0:31:17.64,Main,,0,0,0,,Var ol Germa!
Dialogue: 0,0:31:17.64,0:31:20.98,Main,,0,0,0,,Germa 66 çok yaşa!
Dialogue: 0,0:31:20.98,0:31:26.28,Main,,0,0,0,,Germa! Germa! Germa! Germa!
Dialogue: 0,0:31:31.53,0:31:34.16,Main,,0,0,0,,{\i1}Evlilik törenine üç gün var.{\i}
Dialogue: 0,0:31:34.16,0:31:37.84,Main,,0,0,0,,Whole Cake Adası'na iki güne ulaşırız.
Dialogue: 0,0:31:37.84,0:31:40.16,Main,,0,0,0,,Sanji'nin durumu nedir?
Dialogue: 0,0:31:40.16,0:31:42.38,Main,,0,0,0,,{\i1}Çoktan getirildi.{\i}
Dialogue: 0,0:31:42.38,0:31:46.09,Main,,0,0,0,,Ne harika!\NGörüşmek için can atıyorum.
Dialogue: 0,0:31:46.09,0:31:48.30,Main,,0,0,0,,Yalancı!
Dialogue: 0,0:31:48.30,0:31:50.32,Main,,0,0,0,,İki güne görüşürüz.
Dialogue: 0,0:31:52.47,0:31:57.00,OP11 Credits,,0,0,0,,Editing:\N Feeso,\NGalaxy 9000\N\NTiming:\NHalee,\NSewil (Opening)\N\NQuality Assurance:\NGalaxy 9000,\NGrug,\NMr. Luffy,\NPepperjack\N\NSoundtracking:\N Halee\N\NGraphics:\N Datenshi\N\NTranslation:\NCrunchyroll\NYibis (Opening)
Dialogue: 0,0:00:00.82,0:00:06.82,Lyrics,,0,0,0,karaoke,♪ Görmedim dünyanın sonunu kendi gözlerimle hiç. ♪
Dialogue: 0,0:00:06.82,0:00:13.95,Lyrics,,0,0,0,karaoke,♪ O yüzden çıktım yola sizinle, bunu yapmak için! ♪
Dialogue: 0,0:00:23.67,0:00:27.00,Lyrics,,0,0,0,karaoke,♪ Bir denizden diğerine yol alırken,...
Dialogue: 0,0:00:29.06,0:00:31.91,Lyrics,,0,0,0,karaoke,...bunun sadece bir peri masalı olduğunu söylemek. ♪
Dialogue: 0,0:00:31.92,0:00:38.78,Lyrics,,0,0,0,karaoke,♪ Gerçek, kurgudan daha tuhaf değil mi? ♪
Dialogue: 0,0:00:39.94,0:00:43.56,Lyrics,,0,0,0,karaoke,♪ Fakat sırt çevirme hiçbirine ♪
Dialogue: 0,0:00:43.56,0:00:50.04,Lyrics,,0,0,0,karaoke,♪ Sağduyu dedikleri zihnidir toplulukların! ♪
Dialogue: 0,0:00:51.36,0:00:57.41,Lyrics,,0,0,0,karaoke,♪ Görmedim dünyanın sonunu kendi gözlerimle hiç. ♪
Dialogue: 0,0:00:57.41,0:01:01.96,Lyrics,,0,0,0,karaoke,♪ O yüzden gitmemiz lazım Kaptan Özgür-Ruh! ♪
Dialogue: 0,0:01:01.96,0:01:04.72,Lyrics,,0,0,0,karaoke,♪ Kim demiş imkansız diye,...
Dialogue: 0,0:01:04.71,0:01:07.89,Lyrics,,0,0,0,karaoke,...daha hiçbir şey başlamadan! ♪
Dialogue: 0,0:01:07.88,0:01:12.72,Lyrics,,0,0,0,karaoke,♪ Her şeyi bilmek istiyorum ve şimdi bilebiliriz de... ♪
Dialogue: 0,0:01:12.72,0:01:18.68,Lyrics,,0,0,0,karaoke,♪ Bilebiliriz, bilebilirsin! Şu anda... ♪
Dialogue: 0,0:01:19.06,0:01:24.10,Lyrics,,0,0,0,karaoke,♪ Bilebiliriz, bilebilirim! Bu harika hissi... ♪
Dialogue: 0,0:01:24.39,0:01:31.32,Lyrics,,0,0,0,karaoke,♪ Hemen, şimdi, bilebiliriz! ♪
Dialogue: 0,0:01:37.34,0:01:38.64,Lyrics,,0,0,0,karaoke,♪ Evet, bilebiliriz! ♪
