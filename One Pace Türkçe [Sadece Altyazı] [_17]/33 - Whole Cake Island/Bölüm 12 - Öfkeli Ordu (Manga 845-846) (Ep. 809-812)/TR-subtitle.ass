Dialogue: 0,0:13:57.14,0:14:00.31,Captions,,0,0,0,,{\pos(1146,370)\fs36}{\fad(250,250)}Pudding'in Odası
Dialogue: 0,0:19:34.11,0:19:36.32,Captions,,0,0,0,,{\fad(250,250)}Tatlı Şehir'in Dışı
Dialogue: 0,0:01:36.34,0:01:38.45,Main,,0,0,0,,Luffy.
Dialogue: 0,0:01:38.45,0:01:40.62,Main,,0,0,0,,Gerçekten bekleyecek misin?
Dialogue: 0,0:01:41.08,0:01:43.12,Main,,0,0,0,,Düşman bölgesinin ortası burası.
Dialogue: 0,0:01:46.91,0:01:48.55,Main,,0,0,0,,Bekleyeceğim!
Dialogue: 0,0:01:48.55,0:01:53.55,Main,,0,0,0,,Pound'un dediğine göre\NTatlı Komutanı yenilince...
Dialogue: 0,0:01:53.55,0:01:57.47,Main,,0,0,0,,...göz açıp kapayınca kadar Big Mom'un...
Dialogue: 0,0:01:57.47,0:02:00.59,Main,,0,0,0,,...intikam ordusu fırtınayla beraber gelmiş.
Dialogue: 0,0:02:01.56,0:02:03.68,Main,,0,0,0,,Düşman gelecek ama...
Dialogue: 0,0:02:04.32,0:02:05.68,Main,,0,0,0,,...Sanji-kun...
Dialogue: 0,0:02:05.68,0:02:07.90,Main,,0,0,0,,Sanji geri dönecek!
Dialogue: 0,0:02:07.90,0:02:11.19,Main,,0,0,0,,Burada bekleyeceğim!
Dialogue: 0,0:02:15.28,0:02:21.09,Main,,0,0,0,,Lanet olsun!\NKafam tamamen kırpılmış.
Dialogue: 0,0:02:32.36,0:02:33.79,Main,,0,0,0,,Bu da ne?
Dialogue: 0,0:02:34.38,0:02:37.63,Main,,0,0,0,,Az önce hava açıktı ama\Nbulutlar toplanıyor.
Dialogue: 0,0:02:40.01,0:02:42.32,Main,,0,0,0,,Ne oldu Kingbaum?
Dialogue: 0,0:02:43.20,0:02:47.47,Main,,0,0,0,,O dağ, Mama'nın yaşadığı\NWhole Cake Şatosu.
Dialogue: 0,0:02:47.47,0:02:49.44,Main,,0,0,0,,Mama kızmış-ju!
Dialogue: 0,0:02:51.02,0:02:52.81,Main,,0,0,0,,Big Mom mı?
Dialogue: 0,0:02:54.12,0:02:55.86,Main,,0,0,0,,Ama...
Dialogue: 0,0:02:57.13,0:02:58.89,Main,,0,0,0,,Olamaz...
Dialogue: 0,0:03:01.70,0:03:03.49,Main,,0,0,0,,Yoksa...
Dialogue: 0,0:03:03.49,0:03:05.83,Main,,0,0,0,,Şaka olmalı.
Dialogue: 0,0:03:06.49,0:03:09.50,Main,,0,0,0,,Bir kişinin gücü mü bu?
Dialogue: 0,0:03:13.21,0:03:17.09,Flashbacks,,0,0,0,,{\i1}Linlin'in yanında her zaman\Nhava elementleri bulunur.{\i0}
Dialogue: 0,0:03:17.71,0:03:22.18,Flashbacks,,0,0,0,,{\i1}Kızdığında Big Mom'u durdurabilecek\Nhiçbir şey yoktur.{\i0}
Dialogue: 0,0:03:42.76,0:03:46.99,Main,,0,0,0,,Prometheus-sama ve Zeus-sama\Ncirit atıyor!
Dialogue: 0,0:03:49.80,0:03:53.14,Main,,0,0,0,,Mama... Çok öfkelenmiş.
Dialogue: 0,0:04:46.24,0:04:50.97,Main,,0,0,0,,Yolu açın! Öfkeli ordu geçecek!
Dialogue: 0,0:04:50.97,0:04:54.23,Main,,0,0,0,,Cracker-sama'nın intikamını almak\Niçin ordu kuruldu!
Dialogue: 0,0:04:54.23,0:04:56.35,Main,,0,0,0,,Çekilin! Yolu açın!
Dialogue: 0,0:05:08.84,0:05:11.00,Main,,0,0,0,,Çok fazlalar!
Dialogue: 0,0:05:11.00,0:05:15.35,Main,,0,0,0,,Sanırım öldürmek için \NHasır Şapka'yı arayacaklar.
Dialogue: 0,0:05:20.18,0:05:24.88,Main,,0,0,0,,Doğru hatırlıyorsam orada\Nbekleyeceğini söylemişti.
Dialogue: 0,0:05:27.16,0:05:29.89,Main,,0,0,0,,Artık sonu geldi.
Dialogue: 0,0:05:32.85,0:05:36.39,Main,,0,0,0,,Ne? İnanamıyorum. Öğütücü Bobbin.
Dialogue: 0,0:05:37.83,0:05:40.02,Main,,0,0,0,,Çılgın Hanım Amande.
Dialogue: 0,0:05:40.02,0:05:43.73,Main,,0,0,0,,Katip Mont d'Or!
Dialogue: 0,0:05:43.73,0:05:47.34,Main,,0,0,0,,Toplam ödülleri ne kadardır acaba?
Dialogue: 0,0:05:58.12,0:06:01.23,Flashbacks,,0,0,0,,Burada bekleyeceğim!
Dialogue: 0,0:06:05.55,0:06:08.85,Main,,0,0,0,,Sanırım o kaptan bu orduyu görünce...
Dialogue: 0,0:06:08.85,0:06:11.26,Main,,0,0,0,,...kaçmayacak kadar aptal değildir.
Dialogue: 0,0:06:36.29,0:06:37.91,Main,,0,0,0,,Yağmur.
Dialogue: 0,0:06:42.42,0:06:44.21,Main,,0,0,0,,Hayır.
Dialogue: 0,0:06:44.21,0:06:46.55,Main,,0,0,0,,Bu şerbet.
Dialogue: 0,0:06:49.22,0:06:52.53,Main,,0,0,0,,Ağzıma şerbet de sürmeyeceğim!
Dialogue: 0,0:06:52.53,0:06:55.64,Main,,0,0,0,,Sanji'nin yemekleri haricinde yemeyeceğim!
Dialogue: 0,0:07:07.28,0:07:09.36,Main,,0,0,0,,Mama bu! Mama!
Dialogue: 0,0:07:09.36,0:07:11.95,Main,,0,0,0,,– Mama!\N– Mama!
Dialogue: 0,0:07:13.91,0:07:16.66,Main,,0,0,0,,Hepiniz iyi misiniz?
Dialogue: 0,0:07:16.66,0:07:18.77,Main,,0,0,0,,Mama, mama!
Dialogue: 0,0:07:18.77,0:07:20.62,Main,,0,0,0,,Ne oldu Anana?
Dialogue: 0,0:07:20.62,0:07:25.88,Main,,0,0,0,,Baş şef bıçak kullanmama izin vermiyor.\NPeluş hayvanlarımı kesmek istiyorum.
Dialogue: 0,0:07:25.88,0:07:28.51,Main,,0,0,0,,Bu olamaz.
Dialogue: 0,0:07:28.51,0:07:32.34,Main,,0,0,0,,Dolce, Dragée, gidip ona bir tane alın.
Dialogue: 0,0:07:32.34,0:07:37.50,Main,,0,0,0,,Olmaz Mama! Anana bıçak alınca\Nbalonlarımızı patlatacak!
Dialogue: 0,0:07:37.50,0:07:41.14,Main,,0,0,0,,Evet! Çok kötü birisi o!\NBir gün onu öldüreceğim!
Dialogue: 0,0:07:42.48,0:07:46.19,Main,,0,0,0,,Böyle kötü şeyler dememeliyiz,\Ndeğil mi Mama?
Dialogue: 0,0:07:47.79,0:07:53.24,Main,,0,0,0,,Hepinizin öldürmek istediği\N100-200 kişi vardır.
Dialogue: 0,0:07:53.24,0:07:55.95,Main,,0,0,0,,Birbirinizle iyi geçinin çocuklarım.
Dialogue: 0,0:07:55.95,0:08:00.33,Main,,0,0,0,,Yarın Pudding Abla'nızın\Ndüğün günü.
Dialogue: 0,0:08:00.33,0:08:03.11,Main,,0,0,0,,Eğlenecek misiniz bakalım?
Dialogue: 0,0:08:04.71,0:08:09.05,Main,,0,0,0,,Leziz bir düğün pastası yiyeceksiniz.
Dialogue: 0,0:08:09.05,0:08:11.01,Main,,0,0,0,,Yaşasın! Yaşasın!
Dialogue: 0,0:08:11.01,0:08:13.26,Main,,0,0,0,,Öyleyse buluşalım!
Dialogue: 0,0:08:13.26,0:08:15.97,Main,,0,0,0,,Damadın ailesiyle!
Dialogue: 0,0:08:15.97,0:08:19.28,Main,,0,0,0,,{\i1}Kapı!{\i0}
Dialogue: 0,0:08:26.98,0:08:30.81,Main,,0,0,0,,Hoş geldiniz Germa 66.
Dialogue: 0,0:08:30.81,0:08:32.49,Main,,0,0,0,,Geciktiğim için üzgünüm.
Dialogue: 0,0:08:32.49,0:08:35.57,Thoughts,,0,0,0,,{\i1}Yonkou Big Mom!{\i0}
Dialogue: 0,0:08:35.57,0:08:40.83,Main,,0,0,0,,Küçük bir sorun vardı ama\Nartık sorun kalmamalı.
Dialogue: 0,0:08:51.05,0:08:53.95,Main,,0,0,0,,Pudding, gelmişsin.
Dialogue: 0,0:08:53.95,0:08:55.43,Main,,0,0,0,,Geciktiğim için üzgünüm.
Dialogue: 0,0:09:01.64,0:09:05.56,Main,,0,0,0,,Yine de hakkında çok şey duydum.
Dialogue: 0,0:09:05.56,0:09:10.65,Main,,0,0,0,,Oğlun aşçı değil mi? Pudding'e yaraşır.
Dialogue: 0,0:09:10.65,0:09:14.61,Main,,0,0,0,,Gerçi olmasa da fark etmez.
Dialogue: 0,0:09:14.61,0:09:17.32,Main,,0,0,0,,Politik bir evlilik sonuçta.
Dialogue: 0,0:09:17.32,0:09:23.45,Main,,0,0,0,,Sen ve ben aynı amaçları paylaştığı\Nsürece önemsiz Judge.
Dialogue: 0,0:09:25.98,0:09:31.88,Main,,0,0,0,,Evet ama çocuklarımız mutlu olsa da\Nsorun olmaz.
Dialogue: 0,0:09:34.15,0:09:36.72,Main,,0,0,0,,Yarın güzel bir düğün olmasına.
Dialogue: 0,0:09:36.72,0:09:39.45,Main,,0,0,0,,Evet, olmasına.
Dialogue: 0,0:10:04.66,0:10:06.21,Main,,0,0,0,,Çay.
Dialogue: 0,0:10:44.82,0:10:46.95,Main,,0,0,0,,Biraz sessiz olabilir misiniz?
Dialogue: 0,0:10:46.95,0:10:48.46,Main,,0,0,0,,Ne?!
Dialogue: 0,0:10:56.64,0:10:59.39,Main,,0,0,0,,Ne gürültü böyle.
Dialogue: 0,0:11:11.90,0:11:14.31,Main,,0,0,0,,S... Sanji-{\i1}san{\i}...
Dialogue: 0,0:11:28.12,0:11:31.69,Note,,0,0,0,,İki kişi özel olarak konuşmalıyız.
Dialogue: 0,0:12:02.66,0:12:04.45,Main,,0,0,0,,Çok fena-ju...
Dialogue: 0,0:12:04.45,0:12:06.96,Main,,0,0,0,,Çok fena-ju!
Dialogue: 0,0:12:07.75,0:12:10.33,Main,,0,0,0,,Kaç kişiler?!
Dialogue: 0,0:12:27.11,0:12:29.06,Main,,0,0,0,,Luffy...
Dialogue: 0,0:12:35.86,0:12:39.86,Main,,0,0,0,,Luffy! Lütfen! Saklan en azından!
Dialogue: 0,0:12:39.86,0:12:43.00,Main,,0,0,0,,Buradan biraz uzaklaşsan bir şey olmaz!
Dialogue: 0,0:12:43.00,0:12:44.36,Main,,0,0,0,,Olmaz!
Dialogue: 0,0:12:44.91,0:12:48.12,Main,,0,0,0,,Sanji ben yokken gelebilir!
Dialogue: 0,0:12:48.12,0:12:50.79,Main,,0,0,0,,Siz biraz geri çekilin!
Dialogue: 0,0:12:50.79,0:12:52.70,Main,,0,0,0,,Yapma Luffy! İmkansız bu!
Dialogue: 0,0:12:52.70,0:12:55.42,Main,,0,0,0,,Burası kimin bölgesi anlamıyor musun?
Dialogue: 0,0:13:18.82,0:13:21.02,Main,,0,0,0,,Kocaman bir ordu...
Dialogue: 0,0:13:21.02,0:13:22.82,Main,,0,0,0,,Yenemezsin.
Dialogue: 0,0:13:25.36,0:13:27.74,Main,,0,0,0,,{\i1}Hasır Şapkalı Luffy'yi bulduk!{\i0}
Dialogue: 0,0:13:34.54,0:13:37.00,Main,,0,0,0,,Burada bekleyeceğime...
Dialogue: 0,0:13:40.66,0:13:43.17,Main,,0,0,0,,...söz verdim!
Dialogue: 0,0:13:51.37,0:13:53.64,Main,,0,0,650,,Luffyleri bu adaya sen mi getirdin?
Dialogue: 0,0:13:53.64,0:13:55.16,Main,,0,0,0,,Özür dilerim.
Dialogue: 0,0:13:57.10,0:14:01.38,Main,,0,0,0,,Sanji-san'ı güneybatı limanına\Ngetireceğim diye de söz vermiştim.
Dialogue: 0,0:14:01.38,0:14:06.24,Main,,0,0,0,,Ama sözümü tutamadım ve benim\Nyüzümden başları belada.
Dialogue: 0,0:14:07.28,0:14:09.08,Main,,0,0,0,,Demek öyle.
Dialogue: 0,0:14:09.08,0:14:15.00,Main,,0,0,0,,Bu kadar sıkı gözetilen bir denizi\Nnasıl geçtiler diye merak ediyordum.
Dialogue: 0,0:14:15.46,0:14:19.17,Main,,0,0,0,,Şimdi anlıyorum ama...
Dialogue: 0,0:14:19.17,0:14:22.73,Main,,0,0,0,,...her halükarda sahile gitmezdim.
Dialogue: 0,0:14:23.78,0:14:28.51,Main,,0,0,0,,Daveti düşünüyorsan her şeyi\Nkızı olarak üstlensem hiçbir şey olmazdı!
Dialogue: 0,0:14:28.51,0:14:30.76,Main,,0,0,0,,Bir şekilde düğün olursa iş biter!
Dialogue: 0,0:14:30.76,0:14:33.20,Main,,0,0,0,,Mama politik evliliklere aşina olduğundan...
Dialogue: 0,0:14:33.20,0:14:36.44,Main,,0,0,0,,...kaçma ihtimali olan gelin\Nve damatlara bileklik takar.
Dialogue: 0,0:14:36.44,0:14:39.30,Main,,0,0,0,,Onlarla birlikte adadan\Nkaçmaya çalışırsan...
Dialogue: 0,0:14:39.30,0:14:40.84,Main,,0,0,0,,Patlarlar.
Dialogue: 0,0:14:45.18,0:14:47.49,Main,,0,0,0,,Anahtarı annende.
Dialogue: 0,0:14:47.49,0:14:51.71,Main,,0,0,0,,Almak istersen Big Mom Korsanları'nı\Nyenmekten başka çaren yok.
Dialogue: 0,0:14:51.71,0:14:54.01,Main,,0,0,0,,Yoksa Mama çoktan...
Dialogue: 0,0:14:54.01,0:15:00.12,Main,,0,0,0,,Evet, tüm düzenlemeleri yapmış\Nve ilk olarak...
Dialogue: 0,0:15:03.09,0:15:06.34,Main,,0,0,0,,...etrafımda hiç dostum yok.
Dialogue: 0,0:15:13.72,0:15:16.39,Main,,0,0,0,,Kan bağımız olsa bile...
Dialogue: 0,0:15:21.49,0:15:23.56,Main,,0,0,0,,...bunu yaptılar.
Dialogue: 0,0:15:24.20,0:15:28.03,Main,,0,0,0,,O yaraları gerçek ailen mi yaptı?
Dialogue: 0,0:15:28.03,0:15:29.25,Main,,0,0,0,,Evet.
Dialogue: 0,0:15:29.65,0:15:31.99,Main,,0,0,0,,Böyle bir şey...
Dialogue: 0,0:15:32.62,0:15:38.45,Main,,0,0,0,,Onlar için bir fiyaskoyum ve varlığımı\Nkabullenemiyorlar anlaşılan.
Dialogue: 0,0:15:39.79,0:15:44.15,Main,,0,0,0,,Kraliyet ailesinde doğduğum için\Nbir kez bile sevinmedim.
Dialogue: 0,0:15:47.76,0:15:50.61,Main,,0,0,0,,Bu yüzden denize açıldım.
Dialogue: 0,0:15:51.13,0:15:54.47,Main,,0,0,0,,Var olduğundan bile emin\Nolmadığım bir yeri bulmak için.
Dialogue: 0,0:15:56.02,0:15:57.10,Main,,0,0,0,,Ama...
Dialogue: 0,0:15:59.60,0:16:02.87,Main,,0,0,0,,...bu evliliğe direnirsem...
Dialogue: 0,0:16:04.56,0:16:07.61,Main,,0,0,0,,...ben ve arkadaşlarımın hepsi öleceğiz.
Dialogue: 0,0:16:07.61,0:16:09.32,Main,,0,0,0,,Üstelik...
Dialogue: 0,0:16:09.32,0:16:15.45,Main,,0,0,0,,...Doğu Mavi'deki öz babam gibi gördüğüm\Nçok borçlu olduğum kişiyi öldürürler.
Dialogue: 0,0:16:16.32,0:16:20.45,Main,,0,0,0,,Nereye bakarsam bakayım çıkış yolu yok.
Dialogue: 0,0:16:20.91,0:16:22.22,Main,,0,0,0,,Bu yüzden...
Dialogue: 0,0:16:23.89,0:16:26.54,Main,,0,0,0,,...direnmeyi kesmeye karar verdim.
Dialogue: 0,0:16:32.44,0:16:35.58,Main,,0,0,0,,{\i1}Evliliği kabul etme koşuluyla...
Dialogue: 0,0:16:35.58,0:16:38.76,Main,,0,0,0,,...Big Mom'ın arkadaşlarımı\Nbırakmasını istiyorum.{\i0}
Dialogue: 0,0:16:43.52,0:16:46.60,Main,,0,0,0,,Şu an Luffylerin peşindeler.
Dialogue: 0,0:16:48.04,0:16:50.23,Main,,0,0,0,,Özür dilerim.
Dialogue: 0,0:16:50.23,0:16:54.07,Main,,0,0,0,,Annem seni bu kadar\Nzor bir duruma soktu.
Dialogue: 0,0:16:54.75,0:16:56.21,Main,,0,0,0,,Dur.
Dialogue: 0,0:16:56.21,0:16:58.62,Main,,0,0,0,,Senin hatan yok.
Dialogue: 0,0:16:58.62,0:16:59.53,Main,,0,0,0,,Ama...
Dialogue: 0,0:17:02.68,0:17:08.06,Main,,0,0,0,,13 yaş önce bile tam bir cehennemdeydim.
Dialogue: 0,0:17:08.06,0:17:11.16,Main,,0,0,0,,Yine aynı yere döndüm sadece.
Dialogue: 0,0:17:11.74,0:17:17.09,Main,,0,0,0,,13 yıl boyunca uzak kaldığım\Niçin mutlu olmalıyım.
Dialogue: 0,0:17:17.09,0:17:20.68,Main,,0,0,0,,Aşçılık yeteneğimi\Ngeliştirmeme izin veren kişiler...
Dialogue: 0,0:17:20.68,0:17:23.89,Main,,0,0,0,,...ve yolculuk ettiğim arkadaşlarım...
Dialogue: 0,0:17:24.99,0:17:28.81,Main,,0,0,0,,Tanıştığım kişilerin hepsine çok bağlandım.
Dialogue: 0,0:17:29.45,0:17:32.48,Main,,0,0,0,,Kimseyi incitmek istemiyorum.
Dialogue: 0,0:17:34.46,0:17:38.03,Main,,0,0,0,,Benim maceram burada sona eriyor.
Dialogue: 0,0:17:43.92,0:17:48.92,Main,,0,0,0,,Hey, ağlama lütfen. Kötü hissettiriyor.
Dialogue: 0,0:17:49.75,0:17:51.57,Main,,0,0,0,,Ben...
Dialogue: 0,0:17:55.10,0:17:56.76,Main,,0,0,0,,Sanji-{\i1}san{\i}!
Dialogue: 0,0:17:57.76,0:18:02.60,Main,,0,0,0,,Evliliğimizin cehennem gibi\Nolmasına izin vermeyeceğim!
Dialogue: 0,0:18:10.23,0:18:16.11,Main,,0,0,0,,Özür dilerim! Ne diyorum ben?\NZaten yeterince acı çekiyorsun!
Dialogue: 0,0:18:16.11,0:18:20.28,Main,,0,0,0,,İstenmeyen bir evlilik de\Ncehennem gibi gelmeli!
Dialogue: 0,0:18:20.28,0:18:23.24,Main,,0,0,0,,Nasıl acı içindeki birisine derim?!
Dialogue: 0,0:18:23.24,0:18:25.83,Main,,0,0,0,,Utanıyorum! Özür dilerim!
Dialogue: 0,0:18:25.83,0:18:32.13,Main,,0,0,0,,Daha yeni tanıdım seni.\NKalbindeki boşluğu dolduramam.
Dialogue: 0,0:18:32.13,0:18:37.62,Main,,0,0,0,,Üstelik evliliği istediğine dair\Nbir şey bile söylemedin.
Dialogue: 0,0:18:37.62,0:18:39.30,Main,,0,0,0,,Ben...
Dialogue: 0,0:19:11.08,0:19:14.67,Main,,0,0,0,,Sen kurtuluşumsun.
Dialogue: 0,0:19:15.50,0:19:18.21,Main,,0,0,0,,Sanji-{\i1}san{\i}...
Dialogue: 0,0:19:19.17,0:19:22.14,Main,,0,0,0,,Senin için yeterliysem...
Dialogue: 0,0:19:23.84,0:19:27.44,Main,,0,0,0,,...yarın evlenelim.
Dialogue: 0,0:19:36.32,0:19:38.82,Main,,0,0,0,,Yan cebime koy.
Dialogue: 0,0:19:39.71,0:19:41.15,Main,,0,0,0,,Bu da ne?
Dialogue: 0,0:19:41.80,0:19:43.49,Main,,0,0,0,,Gel bakalım!
Dialogue: 0,0:19:54.15,0:19:55.70,Main,,0,0,0,,Dikkatsizlik ettim.
Dialogue: 0,0:19:55.70,0:20:01.55,Main,,0,0,0,,Senin gibi bir kızın böyle yıldırım\Nsaldırısı yapmasını beklemiyordum.
Dialogue: 0,0:20:34.30,0:20:36.29,Main,,0,0,0,,Meşhur Kılıç...
Dialogue: 0,0:20:38.35,0:20:40.05,Main,,0,0,0,,...Shirauo.
Dialogue: 0,0:20:38.35,0:20:40.05,Note,,0,0,0,,Buz balığı
Dialogue: 0,0:20:40.05,0:20:44.30,Main,,0,0,0,,Düşündüğünüz gibi değil-ju!\NTaraf değiştirmedik!
Dialogue: 0,0:20:46.09,0:20:47.85,Main,,0,0,0,,Amande-{\i1}sama{\i}!
Dialogue: 0,0:21:03.90,0:21:06.93,Main,,0,0,0,,Acıyor...
Dialogue: 0,0:21:06.93,0:21:11.58,Main,,0,0,0,,Ö-Öldüreceksen hemen öldür!
Dialogue: 0,0:21:13.91,0:21:18.61,Main,,0,0,0,,Birisini hemen öldürmek manasız.
Dialogue: 0,0:21:18.61,0:21:23.88,Main,,0,0,0,,En acı verici şekilde ve hızda keserim.
Dialogue: 0,0:21:33.93,0:21:36.50,Main,,0,0,0,,Yok artık Hasır Şapka.
Dialogue: 0,0:21:36.50,0:21:41.52,Main,,0,0,0,,Tüm gece boyunca Cracker Abi\Nile dövüşmüş gibi durmuyor.
Dialogue: 0,0:21:41.52,0:21:44.15,Main,,0,0,0,,Arabulucu Taşlar da güçsüz değildir!
Dialogue: 0,0:21:45.20,0:21:47.93,Main,,0,0,0,,Nasıl çöp gibi parçalıyor bunları?!
Dialogue: 0,0:21:50.37,0:21:53.08,Main,,0,0,0,,Hadi gel!
Dialogue: 0,0:22:02.84,0:22:03.80,Main,,0,0,0,,Luffy!
Dialogue: 0,0:22:09.01,0:22:10.18,Main,,0,0,0,,Bu ne?!
Dialogue: 0,0:22:13.38,0:22:14.27,Main,,0,0,0,,Ah!
Dialogue: 0,0:22:14.27,0:22:18.44,Main,,0,0,0,,İşte taze kremanın tatlılığı budur-fa!
Dialogue: 0,0:22:19.98,0:22:26.15,Main,,0,0,0,,Tatlı krema tatlandırıldığında, \Nbütün vücudun yanar-fa
Dialogue: 0,0:22:32.70,0:22:36.00,Main,,0,0,0,,Dur bakalım.\NÖyle bir şey olmayacak Hasır Şapka.
Dialogue: 0,0:23:01.24,0:23:03.61,Main,,0,0,0,,Burası da neresi?
Dialogue: 0,0:23:24.54,0:23:25.71,Main,,0,0,0,,Burası...
Dialogue: 0,0:23:27.03,0:23:29.30,Main,,0,0,0,,...Kitaplar Dünyası!
Dialogue: 0,0:23:47.32,0:23:48.86,Main,,0,0,0,,Luffy!
Dialogue: 0,0:24:05.88,0:24:08.17,Main,,0,0,0,,Durun!
Dialogue: 0,0:24:14.46,0:24:16.39,Main,,0,0,0,,Luffy! Eğil!
Dialogue: 0,0:24:16.90,0:24:18.31,Main,,0,0,0,,Nami!
Dialogue: 0,0:24:25.52,0:24:26.40,Main,,0,0,0,,Dikkat et!
Dialogue: 0,0:24:39.10,0:24:41.25,Main,,0,0,0,,Luffy!
Dialogue: 0,0:24:45.16,0:24:46.50,Main,,0,0,0,,Olamaz...
Dialogue: 0,0:25:03.91,0:25:05.74,Main,,0,0,0,,Kingbaum...
Dialogue: 0,0:25:18.16,0:25:23.18,Main,,0,0,0,,Arabulucu Taşların neden normal\Nsavaşamadığını ve...
Dialogue: 0,0:25:23.18,0:25:27.12,Main,,0,0,0,,...sizin nasıl ormandan çıktığınızı\Nmerak ediyordum.
Dialogue: 0,0:25:27.12,0:25:29.15,Main,,0,0,0,,Şimdi anladım.
Dialogue: 0,0:25:30.09,0:25:33.67,Main,,0,0,0,,Mama'nın Vivre Kartı neden sende?
Dialogue: 0,0:25:33.67,0:25:36.13,Main,,0,0,0,,Lola yazıyor.
Dialogue: 0,0:25:36.13,0:25:39.20,Main,,0,0,0,,Lola mı?! Ondan mı çalmış?!
Dialogue: 0,0:25:39.20,0:25:42.68,Main,,0,0,0,,Bu nasıl şey be?!\NO kaçan kız öldürülmüş mü?!
Dialogue: 0,0:25:42.68,0:25:44.98,Main,,0,0,0,,- Lola!\N- Son sözleri neydi?!
Dialogue: 0,0:25:44.98,0:25:48.85,Main,,0,0,0,,Öyle değil!\NLola benim arkadaşım! O verdi!
Dialogue: 0,0:25:48.85,0:25:50.34,Main,,0,0,0,,Bilemiyorum.
Dialogue: 0,0:25:50.34,0:25:52.42,Main,,0,0,0,,Mama'ya kendin anlatırsın.
Dialogue: 0,0:25:52.42,0:25:56.03,Main,,0,0,0,,Maalesef sizi canlı yakalama emri aldık.
Dialogue: 0,0:25:56.03,0:25:57.11,Main,,0,0,0,,Gidelim.
Dialogue: 0,0:25:57.48,0:26:00.58,Main,,0,0,0,,Şuna baksana.
Dialogue: 0,0:26:00.58,0:26:04.45,Main,,0,0,0,,Arabulucu Taşların çoğu harap olmuş.
Dialogue: 0,0:26:28.06,0:26:33.07,Main,,0,0,0,,Ben... burada... bekleyeceğim...
Dialogue: 0,0:26:39.31,0:26:41.95,Main,,0,0,0,,Sanji için...
Dialogue: 0,0:26:47.11,0:26:50.00,Main,,0,0,0,,Luffy!!
Dialogue: 0,0:27:04.51,0:27:08.52,Captions,,0,0,0,,{\fad(500,0)}Whole Cake Şatosu
Dialogue: 0,0:27:12.54,0:27:14.33,Main,,0,0,0,,G-Gerçekten mi?
Dialogue: 0,0:27:14.33,0:27:17.19,Main,,0,0,0,,Evet, gerçekten.
Dialogue: 0,0:27:17.19,0:27:23.25,Main,,0,0,0,,Mantıklı anlaşmalara gelince\Nçok uzlaşmacı bir kadınımdır.
Dialogue: 0,0:27:23.25,0:27:25.34,Main,,0,0,0,,Arkadaşlarından...
Dialogue: 0,0:27:25.34,0:27:29.56,Main,,0,0,0,,...Hasır Şapka tayfasından\Nhayattaki herkesi salacağım.
Dialogue: 0,0:27:29.56,0:27:32.42,Main,,0,0,0,,Söz veriyorum.
Dialogue: 0,0:27:33.29,0:27:39.19,Main,,0,0,0,,Kaçma fikrini bir kenara bırakıp\Ndirenmeden evlenirsen...
Dialogue: 0,0:27:39.19,0:27:42.39,Main,,0,0,0,,...gözüm kapalı her şeyi kabul ederim!
Dialogue: 0,0:27:42.39,0:27:47.18,Main,,0,0,0,,Minnettarım!\NPudding-chan'ı kesinlikle mutlu edeceğim!
Dialogue: 0,0:27:50.16,0:27:57.19,Main,,0,0,0,,Biricik kızımı çok sevmişsin.\NBayağı mutlu oldum.
Dialogue: 0,0:28:00.11,0:28:02.42,Main,,0,0,0,,Aç kulaklarını.
Dialogue: 0,0:28:02.42,0:28:09.83,Main,,0,0,0,,Hasır Şapkaların bana yaptıkları\Nnormalde affedilemez şeyler.
Dialogue: 0,0:28:12.12,0:28:18.50,Main,,0,0,0,,Dev gibi bir ormanı yok ettiler ve\NTatlı Komutanlarından birisini indirdiler.
Dialogue: 0,0:28:18.50,0:28:23.87,Main,,0,0,0,,Üstelik Balık Adam adasında\Nsadece şekerlerimi yemekle kalmayıp...
Dialogue: 0,0:28:23.87,0:28:26.47,Main,,0,0,0,,...bana karşı dövüşe tutuştular.
Dialogue: 0,0:28:29.93,0:28:35.21,Main,,0,0,0,,Ama şu an öncelik senin ve\NPudding'in evliliği.
Dialogue: 0,0:28:35.21,0:28:37.23,Main,,0,0,0,,İşler iyi giderse...
Dialogue: 0,0:28:37.23,0:28:42.44,Main,,0,0,0,,...yarın bu vakitlerde Germa'nın\Naskeri gücünü arkama alacağım ve...
Dialogue: 0,0:28:42.44,0:28:50.82,Main,,0,0,0,,...hep beraber harika bir\Ndüğün pastası yiyeceğiz!
Dialogue: 0,0:28:50.82,0:28:58.29,Main,,0,0,0,,Sen kaçmazsan her şey harika gidecek Sanji.
Dialogue: 0,0:28:58.29,0:29:00.21,Main,,0,0,0,,Evet.
Dialogue: 0,0:29:12.93,0:29:15.94,Main,,0,0,0,,Dünya genelinde...
Dialogue: 0,0:29:15.94,0:29:21.92,Captions,,0,0,0,,{\fad(500,0)}Whole Cake Şatosu'ndaki Hazine Ambarı
Dialogue: 0,0:29:15.94,0:29:19.84,Main,,0,0,0,,...asırlarca tek bir hasar almayan...{\an8}
Dialogue: 0,0:29:19.84,0:29:25.00,Main,,0,0,0,,...işlenmiş taş kütlelerinden \Nyani Poneglifler'den 30 tane ...{\an8}
Dialogue: 0,0:29:25.00,0:29:28.66,Main,,0,0,0,,...bulunduğu söylenir-bon!
Dialogue: 0,0:29:31.75,0:29:38.54,Main,,0,0,0,,Onların arasından yalnızca 9 tanesi\Nbelirli bir konudaki malumatları barındırır.
Dialogue: 0,0:29:39.04,0:29:43.62,Main,,0,0,0,,Sözünü ettiklerimin de son ada\NRaftel'e götürülmesi durumunda...
Dialogue: 0,0:29:43.62,0:29:49.05,Main,,0,0,0,,...dünyanın hakikatına ışık tutulacaktır-soir!
Dialogue: 0,0:29:51.35,0:29:54.52,Main,,0,0,0,,Bağışlayın lütfen\NŞekerleme Generali Smoothie-sama!
Dialogue: 0,0:29:54.52,0:29:56.81,Main,,0,0,0,,Yalvarırım! Yalvarırım!
Dialogue: 0,0:29:56.81,0:29:59.73,Main,,0,0,0,,Merhamet edin Smoothie-sama!
Dialogue: 0,0:30:06.24,0:30:11.49,Main,,0,0,0,,Smoothie-{\i1}sama{\i}...
Dialogue: 0,0:30:14.12,0:30:20.91,Main,,0,0,0,,Gelgelelim son ada Raftel'e gitmek için...
Dialogue: 0,0:30:20.91,0:30:24.67,Main,,0,0,0,,...kırmızı renkteki 4 Yol Poneglifi şart!
Dialogue: 0,0:30:24.67,0:30:29.47,Main,,0,0,0,,Geçen gün Jinbe'nin getirdiğiyle beraber...
Dialogue: 0,0:30:29.47,0:30:32.72,Flashbacks,,0,0,0,,Size hediyemdir. Buraya gelirken buldum.
Dialogue: 0,0:30:32.72,0:30:34.27,Flashbacks,,0,0,0,,İkimizin hediyesi!
Dialogue: 0,0:30:34.27,0:30:40.19,Main,,0,0,0,,...Big Mom Korsanları'nın elinde 2 Poneglif ile...
Dialogue: 0,0:30:40.19,0:30:43.19,Main,,0,0,0,,...bir de Rota Poneglifi bulunmaktadır.
Dialogue: 0,0:30:43.19,0:30:47.90,Main,,0,0,0,,Yani toplamda üç yazıtımız var-{\i1}vous plaît{\i}.
Dialogue: 0,0:30:48.74,0:30:52.62,Main,,0,0,0,,Üç yazıtımızın ne kadar\Ndeğerli olduğunun bilincindeyim zaten.
Dialogue: 0,0:30:54.87,0:30:56.50,Main,,0,0,0,,Ama...
Dialogue: 0,0:30:56.83,0:31:01.56,Captions,,0,0,0,,{\pos(640,486)}{\fad(500,250)}3 Şekerleme Generali'nden Biri\NBig Mom Korsanları, Meyve Suyu Bakanı
Dialogue: 0,0:30:56.50,0:31:01.20,Main,,0,0,0,,...güvenliği neden birdenbire\Nartırdın Tamago?{\an8}
Dialogue: 0,0:31:01.20,0:31:03.66,Main,,0,0,0,,Çay partisine kadar boşum.{\an8}
Dialogue: 0,0:31:01.83,0:31:06.78,Captions,,0,0,0,,{\pos(648,486)}Charlotte Smoothie – Charlotte Ailesi'nin 14. Kızı\NKelle Ödülü: 932 Milyon Beli{\fad(500,0)}
Dialogue: 0,0:31:03.66,0:31:06.78,Main,,0,0,0,,Nöbet tutarım yani, dert değil.{\an8}
Dialogue: 0,0:31:06.84,0:31:11.01,Main,,0,0,0,,Peki, minnettarız-{\i1}renaissance{\i}.
Dialogue: 0,0:31:11.01,0:31:17.22,Main,,0,0,0,,5 yıl önce adamıza gelen\Neski bir korsan tayfası kaptanı vardı.
Dialogue: 0,0:31:17.22,0:31:21.96,Main,,0,0,0,,Mink ırkından bir Poneglif\Nhırsızıdır kendisi, görünen o ki...
Dialogue: 0,0:31:21.96,0:31:26.11,Main,,0,0,0,,...tekrardan adamıza sızmış-{\i1}souffle{\i0}.
Dialogue: 0,0:31:26.11,0:31:27.10,Main,,0,0,0,,Eyvah!
Dialogue: 0,0:31:27.10,0:31:32.22,Main,,0,0,0,,Hemşehirlisi Pekoms onun canı için\Nyalvardığından bağışlanmıştı.
Dialogue: 0,0:31:32.22,0:31:35.20,Main,,0,0,0,,Neden geri döndü acaba?!
Dialogue: 0,0:31:37.20,0:31:39.27,Main,,0,0,0,,Pedro!
Dialogue: 0,0:31:41.50,0:31:49.30,Main,,0,0,0,,Kırmızı Yol Poneglifleri'nin tamamını\Ntoplayınca Raftel'e gidilebilir.
Dialogue: 0,0:31:49.30,0:31:52.86,Main,,0,0,0,,Başka bir deyişle, Korsanlar Kralı\Nolmaya uzanan yolu gösteriyor!
Dialogue: 0,0:31:52.86,0:31:57.81,Main,,0,0,0,,Yonkou seviyesindeki bir görev-{\i1}bon{\i0}.
Dialogue: 0,0:32:00.85,0:32:09.11,Main,,0,0,0,,Mama için hayatlarımız pahasına\Nbu taşları korumalıyız-{\i1}chocolat{\i0}!
Dialogue: 0,0:32:14.99,0:32:18.47,Captions,,0,0,0,,{\pos(648,548)}{\fad(500,0)}Whole Cake Şatosu'ndaki Hazine Ambarının Dışı
Dialogue: 0,0:32:22.21,0:32:23.49,Main,,0,0,0,,Brook.
Dialogue: 0,0:32:26.46,0:32:29.05,Captions,,0,0,0,,{\fad(500,0)}İçki Ambarı
Dialogue: 0,0:32:29.05,0:32:31.97,Main,,0,0,0,,Ne?\NGüvenliği artırdılar mı?!
Dialogue: 0,0:32:31.97,0:32:36.75,Main,,0,0,0,,Evet, o kadına Şekerleme Generali\NSmoothie diyorlardı.
Dialogue: 0,0:32:36.75,0:32:39.60,Main,,0,0,0,,Şekerleme Generali...\NEn kıdemlilerden biri yani!
Dialogue: 0,0:32:39.93,0:32:43.98,Main,,0,0,0,,Bence de öyledir.\NŞüphesiz ki çok güçlü geldi gözüme.
Dialogue: 0,0:32:43.98,0:32:48.30,Main,,0,0,0,,Şimdi sıçtık.\NKusursuz güvenlikleri var artık.
Dialogue: 0,0:32:48.30,0:32:51.05,Main,,0,0,0,,Gece bile şansımız kalmadı.
Dialogue: 0,0:32:52.54,0:32:57.67,Main,,0,0,0,,Tamago'nun varlığımı öğrenmesiyle\Nson umudumuz da uçup gitmiş olabilir.
Dialogue: 0,0:32:57.67,0:33:00.69,Main,,0,0,0,,Luffyler zorluklara göğüs gererken...
Dialogue: 0,0:33:00.69,0:33:04.08,Main,,0,0,0,,...görevimizi sorunsuzca tamamlasak\Nharika olurdu.
Dialogue: 0,0:33:04.42,0:33:10.21,Main,,0,0,0,,Dün dediklerin kalbime dokundu esasen.
Dialogue: 0,0:33:11.89,0:33:15.14,Main,,0,0,0,,Luffy-san'ın Korsanlar Kralı olması için...
Dialogue: 0,0:33:15.14,0:33:19.81,Main,,0,0,0,,...önünde sonunda Yol Poneglifi'ne\Nihtiyacı olacak.
Dialogue: 0,0:33:19.81,0:33:24.81,Main,,0,0,0,,Ama buraya tekrar gelmek\No kadar kolay olmayacak.
Dialogue: 0,0:33:25.14,0:33:30.98,Main,,0,0,0,,Ayrıca tekrar gelmeye yeltensek bile\Nordularıyla yüzleşmemiz gerekecek!
Dialogue: 0,0:33:30.98,0:33:33.99,Main,,0,0,0,,Hepimizin buraya kadar\Ngelebileceğini sanmıyorum.
Dialogue: 0,0:33:35.08,0:33:36.57,Main,,0,0,0,,Haklısın.
Dialogue: 0,0:33:36.57,0:33:41.20,Main,,0,0,0,,Hâl böyleyken karşımızda\Nbulunmaz bir fırsat var.
Dialogue: 0,0:33:43.41,0:33:47.67,Main,,0,0,0,,Ama saldırmaya kalkarsak ikimiz de ölürüz!
Dialogue: 0,0:33:48.75,0:33:51.64,Main,,0,0,0,,Baron Tamago'nun hedefinde kim var?
Dialogue: 0,0:33:51.64,0:33:53.25,Main,,0,0,0,,Ben.
Dialogue: 0,0:34:02.51,0:34:04.52,Main,,0,0,0,,Pedro-{\i1}san{\i},...
Dialogue: 0,0:34:04.52,0:34:07.23,Main,,0,0,0,,...yem olur musun?
Dialogue: 0,0:34:10.20,0:34:14.32,Main,,0,0,0,,Aklımı okudun.
