Dialogue: 0,0:09:58.41,0:10:01.59,Lunch Time,,0,0,0,karaoke,– Yeşil çay!
Dialogue: 0,0:10:01.60,0:10:03.66,Lunch Time,,0,0,0,karaoke,Hangisi?
Dialogue: 0,0:10:07.66,0:10:10.22,Lunch Time,,0,0,0,karaoke,Çay! Çay! Çay! Çay!
Dialogue: 0,0:10:10.22,0:10:12.59,Lunch Time,,0,0,0,karaoke,Çay!
Dialogue: 0,0:10:18.18,0:10:20.80,Lunch Time,,0,0,0,karaoke,– Ye bizi! Ye bizi!
Dialogue: 0,0:10:18.18,0:10:20.80,Lunch Time,,0,0,0,karaoke,– Benimle başla!
Dialogue: 0,0:10:20.80,0:10:23.47,Lunch Time,,0,0,0,karaoke,– Ye bizi! Ye bizi!
Dialogue: 0,0:10:20.80,0:10:23.47,Lunch Time,,0,0,0,karaoke,– Beni de yiyebilirsin!
Dialogue: 0,0:10:23.47,0:10:25.88,Lunch Time,,0,0,0,karaoke,Bolca da bal al genç adam.
Dialogue: 0,0:10:25.88,0:10:28.47,Lunch Time,,0,0,0,karaoke,Bolca...
Dialogue: 0,0:10:28.47,0:10:31.52,Lunch Time,,0,0,0,karaoke,Tatlı!
Dialogue: 0,0:10:31.52,0:10:36.48,Lunch Time,,0,0,0,karaoke,Ye ye yemek! Ye ye yemek!
Dialogue: 0,0:10:31.52,0:10:36.48,Lunch Time,,0,0,0,karaoke,Ye ye yemek! Ye ye yemek!
Dialogue: 0,0:10:36.48,0:10:37.98,Lunch Time,,0,0,0,karaoke,– Lahana!
Dialogue: 0,0:10:36.48,0:10:37.98,Lunch Time,,0,0,0,karaoke,– Sosis!
Dialogue: 0,0:10:37.98,0:10:40.70,Lunch Time,,0,0,0,karaoke,– Krep!
Dialogue: 0,0:10:37.98,0:10:40.70,Lunch Time,,0,0,0,karaoke,– Jambon!
Dialogue: 0,0:10:40.70,0:10:44.82,Lunch Time,,0,0,0,karaoke,{\i1}Leziz!{\i0}
Dialogue: 0,0:10:48.46,0:10:52.33,Lunch Time,,0,0,0,karaoke,Böyle şeyler deme!
Dialogue: 0,0:10:48.46,0:10:52.33,Lunch Time,,0,0,0,karaoke,Leziz bir şeyler dene!
Dialogue: 0,0:10:52.33,0:10:56.64,Lunch Time,,0,0,0,karaoke,{\i1}Ye ye yemek! Ye ye yemek!{\i0}
Dialogue: 0,0:10:59.93,0:11:04.89,Lunch Time,,0,0,0,karaoke,{\i1}Nasıl tadım? Lezzetli miyim?{\i0}
Dialogue: 0,0:11:04.89,0:11:11.16,Lunch Time,,0,0,0,karaoke,{\i1}Ye ye yemek! Ye ye yemek!{\i0}
