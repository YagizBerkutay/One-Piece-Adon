Dialogue: 0,0:01:34.22,0:01:37.44,Title,,0,0,250,,{\fad(1000,1000)}Yonko Suikast Planı
Dialogue: 0,0:01:37.45,0:01:41.12,Main,,0,0,0,,Big Mom'a suikast düzenlemek\Nilgimi çekmese de...
Dialogue: 0,0:01:41.12,0:01:45.79,Main,,0,0,0,,...silah ve toplarla öldürülebilecek\Nbiri mi ki?
Dialogue: 0,0:01:50.22,0:01:53.88,Main,,0,0,0,,Benim gözümde çelik bir balondan farksız.
Dialogue: 0,0:01:53.88,0:01:56.09,Main,,0,0,0,,Hatta öldürmek imkânsız desek yeridir.
Dialogue: 0,0:01:56.09,0:02:01.99,Main,,0,0,0,,Evet, suikast dediğin tek hamlede olur.
Dialogue: 0,0:02:01.99,0:02:04.85,Main,,0,0,0,,Aksi hâlde etrafın sarılır ve ölürsün.
Dialogue: 0,0:02:05.74,0:02:08.38,Main,,0,0,0,,Yonkou dedikleri kadar güçlü mü?
Dialogue: 0,0:02:08.38,0:02:10.27,Main,,0,0,0,,Herhâlde! Kadın canavar resmen!
Dialogue: 0,0:02:11.44,0:02:16.58,Main,,0,0,0,,Brook'u kaçırmaya çalışırken uyuyordu!\NOna rağmen öleceğiz sandım!
Dialogue: 0,0:02:17.57,0:02:23.03,Main,,0,0,0,,Sırf tatlı uğruna\Nkendi oğlunu bile öldürmüş biridir.
Dialogue: 0,0:02:24.04,0:02:27.98,Main,,0,0,0,,Öyleyse suikast mekânı olarak neden\Ntüm yüksek rütbelilerin katıldığı...
Dialogue: 0,0:02:27.98,0:02:31.28,Main,,0,0,0,,...çay partisini seçtiniz Bege-san?
Dialogue: 0,0:02:32.96,0:02:36.01,Main,,0,0,0,,Bunu sormanız gayet doğal.
Dialogue: 0,0:02:37.50,0:02:40.07,Main,,0,0,0,,Öncelikle şuna cevap vereyim.
Dialogue: 0,0:02:40.07,0:02:45.68,Main,,0,0,0,,İstediğimiz ortam oluştuğu sürece\NBig Mom'ın kellesini 5 saniyede alırız.
Dialogue: 0,0:02:46.57,0:02:48.23,Main,,0,0,0,,Yalnızca 5 saniyede mi?
Dialogue: 0,0:02:48.23,0:02:50.36,Main,,0,0,0,,Yalnızca deme-{\i1}rero{\i}!
Dialogue: 0,0:02:50.36,0:02:55.19,Main,,0,0,0,,Herkesin içinde 5 saniye kazanmak\Nkolay iş değil-rero.
Dialogue: 0,0:02:55.19,0:02:59.38,Main,,0,0,0,,Big Mom Korsanları'nda çok güçlü elemanlar var,\Nonlar da partide olacak.
Dialogue: 0,0:02:59.38,0:03:05.33,Main,,0,0,0,,Saniyesinde Şekerleme Generalleri gibileri\Nişimize engel olur-rero.
Dialogue: 0,0:03:06.64,0:03:11.47,Main,,0,0,0,,İşte o zaman kafa kafaya muharebe olur,\Nkazanma şansımız da sıfır.
Dialogue: 0,0:03:14.92,0:03:20.05,Main,,0,0,0,,Bu suikast planı Caesar'ın\Nyakalanmasıyla başlamıştır.
Dialogue: 0,0:03:20.05,0:03:24.85,Main,,0,0,0,,Adım Gastino be! Big Mom'ın önünde\Nsakın öyle seslenme bana!
Dialogue: 0,0:03:25.10,0:03:26.14,Main,,0,0,0,,Dinle!
Dialogue: 0,0:03:26.14,0:03:30.99,Main,,0,0,0,,Bu görev biter bitmez kalbimi\Ngeri verip beni serbest bırakıyorsun!
Dialogue: 0,0:03:30.99,0:03:32.81,Main,,0,0,0,,Anlaşmamız böyle!
Dialogue: 0,0:03:32.81,0:03:34.65,Main,,0,0,0,,Unutayım deme.
Dialogue: 0,0:03:34.65,0:03:40.50,Main,,0,0,0,,Sözünü tutmazsan şayet,\Nn'olursa olsun oğlunun canını alırım!
Dialogue: 0,0:03:42.66,0:03:47.79,Main,,0,0,0,,Orasını kafana takma Gashiko!\NBege sözünü tutacaktır!
Dialogue: 0,0:03:47.79,0:03:50.08,Main,,0,0,0,,Gashiko mu?\NAdım Gastino be!
Dialogue: 0,0:03:51.79,0:03:52.54,Main,,0,0,0,,Gashiko!
Dialogue: 0,0:03:52.54,0:03:54.42,Main,,0,0,0,,Aşağılık herif...
Dialogue: 0,0:03:54.42,0:03:58.88,Main,,0,0,0,,Ne fark eder... Adı ne olursa olsun\Nbeş para etmezin teki işte.
Dialogue: 0,0:04:00.63,0:04:03.76,Main,,0,0,0,,Yani önemli bir role sahip, bu da...
Dialogue: 0,0:04:04.84,0:04:05.77,Main,,0,0,0,,Evet!
Dialogue: 0,0:04:07.44,0:04:09.81,Main,,0,0,0,,Yeni icadımı takdim edeyim!
Dialogue: 0,0:04:10.69,0:04:14.00,Main,,0,0,0,,Ölümcül zehir gazı, KX Fırlatıcıları!
Dialogue: 0,0:04:14.00,0:04:16.90,Main,,0,0,0,,Bir tanesi yeter de artar aslında\Nlakin fazladan iki tane daha yaptım!
Dialogue: 0,0:04:16.90,0:04:21.90,Main,,0,0,0,,Her biri doğrudan vücuda\Nbeş gram ağırlığında...
Dialogue: 0,0:04:22.64,0:04:25.46,Main,,0,0,0,,...ö- ölümcül organofosfat nüfuz ettirir!
Dialogue: 0,0:04:25.46,0:04:30.12,Main,,0,0,0,,Tanrıya şirk koşacak bir cinayet silahı!
Dialogue: 0,0:04:31.45,0:04:36.36,Main,,0,0,0,,Normal insanları, \Nderilerine temas ettiği gibi öldürür.
Dialogue: 0,0:04:37.46,0:04:41.14,Main,,0,0,0,,Yani doğrudan vücuduna\Nnüfuz ederse...
Dialogue: 0,0:04:43.88,0:04:45.97,Main,,0,0,0,,%100 olasılıkla...
Dialogue: 0,0:04:45.97,0:04:47.89,Main,,0,0,0,,Hatta %200 olasılıkla...
Dialogue: 0,0:04:49.06,0:04:50.43,Main,,0,0,0,,...öldürür!
Dialogue: 0,0:04:50.43,0:04:52.85,Main,,0,0,0,,Mutlaka öldürür!
Dialogue: 0,0:04:53.07,0:04:56.56,Main,,0,0,0,,Hepiniz geberseniz keşke!
Dialogue: 0,0:04:57.14,0:04:59.75,Main,,0,0,0,,Demek öyle, anladım.
Dialogue: 0,0:04:59.75,0:05:03.36,Main,,0,0,0,,İsabet etmesi hâlinde\Nonu öldürecek bir silahınız var yani?
Dialogue: 0,0:05:03.36,0:05:06.00,Main,,0,0,0,,Hayır, ne yazık ki...
Dialogue: 0,0:05:06.00,0:05:09.88,Main,,0,0,0,,...gücünün zirvesindeyken\Nbu füzeleri ateşlersek...
Dialogue: 0,0:05:09.88,0:05:13.16,Main,,0,0,0,,...gaz sert derisinden içeri\Nnüfuz etmeyecektir.
Dialogue: 0,0:05:14.27,0:05:19.29,Main,,0,0,0,,Bu dünyada Big Mom'ın işini bitirebilecek\Nbir silah yok denebilir.
Dialogue: 0,0:05:26.05,0:05:28.43,Main,,0,0,0,,Öyleyse füzelerin bir getirisi yok!
Dialogue: 0,0:05:28.43,0:05:30.66,Main,,0,0,0,,İyi dinleyin.
Dialogue: 0,0:05:30.66,0:05:34.35,Main,,0,0,0,,Gücünün zirvesindeyken\Nişe yaramaz dedim.
Dialogue: 0,0:05:34.35,0:05:40.25,Main,,0,0,0,,KX Fırlatıcılar'ın işe yaraması için\Niki şart sağlanmalı.
Dialogue: 0,0:05:40.25,0:05:45.37,Main,,0,0,0,,Öncelikle beş saniye boyunca\Nkimsenin bize saldıramayacağı bir ortam.
Dialogue: 0,0:05:45.37,0:05:49.78,Main,,0,0,0,,İkinci olarak ise Mama güçten düşürülmeli.
Dialogue: 0,0:05:49.78,0:05:52.62,Main,,0,0,0,,O şart nasıl sağlanacakmış?
Dialogue: 0,0:05:55.48,0:05:57.67,Main,,0,0,0,,N'apıyorsun?
Dialogue: 0,0:05:57.67,0:06:01.80,Main,,0,0,0,,Bu şartların sağlandığı tek yer...
Dialogue: 0,0:06:04.84,0:06:06.47,Main,,0,0,0,,...çay partisi.
Dialogue: 0,0:06:08.01,0:06:09.97,Main,,0,0,0,,Oh, Pez!
Dialogue: 0,0:06:14.85,0:06:19.31,Main,,0,0,0,,Kusura bakma oğlum!\NBabişko sesini yükseltti!
Dialogue: 0,0:06:19.31,0:06:20.77,Main,,0,0,0,,Geçti oğlum, geçti.
Dialogue: 0,0:06:21.89,0:06:26.15,Main,,0,0,0,,Mama'nın emri altına gireli\Nbir yıldan fazla oluyor.
Dialogue: 0,0:06:26.15,0:06:28.36,Main,,0,0,0,,Lakin yaralandığını hiç görmedik.
Dialogue: 0,0:06:31.24,0:06:33.45,Main,,0,0,0,,Koca bir şehri talan ederken de...
Dialogue: 0,0:06:36.50,0:06:43.42,Main,,0,0,0,,Hatta kurşunlarla bombalar\Nona isabet ederken de...
Dialogue: 0,0:06:47.20,0:06:49.51,Main,,0,0,0,,Bütün bir gemiyi batırırken de...
Dialogue: 0,0:06:52.47,0:06:57.31,Main,,0,0,0,,Vücuduna tek bir çizik dahi almadı.
Dialogue: 0,0:06:59.02,0:07:02.81,Main,,0,0,0,,Dediğiniz gibi çelik bir balondan farksız.
Dialogue: 0,0:07:04.40,0:07:05.69,Main,,0,0,0,,Ancak...
Dialogue: 0,0:07:07.36,0:07:13.03,Main,,0,0,0,,...Mama'nın yaralandığı bir an oldu.
Dialogue: 0,0:07:14.05,0:07:17.33,Main,,0,0,0,,Anne Carmel'in fotoğrafı hadisesini\Ndiyorsun-rero!
Dialogue: 0,0:07:17.33,0:07:19.39,Main,,0,0,0,,Ta kendisi.
Dialogue: 0,0:07:21.97,0:07:27.80,Main,,0,0,0,,Çay partilerinde masaya doğrudan Mama'nın\Nkarşısında olacak şekilde bir fotoğraf...
Dialogue: 0,0:07:27.80,0:07:31.01,Main,,0,0,0,,...konur, oraya kimse oturmaz.
Dialogue: 0,0:07:31.01,0:07:35.44,Main,,0,0,0,,Mama'nın en kıymet verdiği\Nhazinesi denebilir.
Dialogue: 0,0:07:36.43,0:07:37.93,Main,,0,0,0,,Bir fotoğraf mı?
Dialogue: 0,0:07:37.93,0:07:39.27,Main,,0,0,0,,Evet.
Dialogue: 0,0:07:39.27,0:07:42.70,Main,,0,0,0,,Anne Carmel'in portresi!
Dialogue: 0,0:07:42.70,0:07:45.65,Main,,0,0,0,,Mama'nın tek zayıf noktası denebilir!
Dialogue: 0,0:07:49.33,0:07:51.53,Main,,0,0,0,,O kimmiş?
Dialogue: 0,0:07:51.53,0:07:55.37,Main,,0,0,0,,Mama'nın ona hayat borcu var gibi,\Nyalnız detayları bilmiyoruz.
Dialogue: 0,0:07:55.37,0:07:57.38,Main,,0,0,0,,Gizemli biri yani.
Dialogue: 0,0:07:57.38,0:07:58.99,Main,,0,0,0,,Ölmüş mü?
Dialogue: 0,0:07:58.99,0:08:01.25,Main,,0,0,0,,Kayıplara karıştığını duymuştum.
Dialogue: 0,0:08:01.25,0:08:03.87,Main,,0,0,0,,Kayıp biri yani.
Dialogue: 0,0:08:03.87,0:08:08.02,Main,,0,0,0,,Aile üyeleri dahi detayları bilmez.
Dialogue: 0,0:08:10.23,0:08:16.40,Main,,0,0,0,,Bir çay partisinde garson yanlışlıkla\Nfotoğrafı masadan düşürmüştü...
Dialogue: 0,0:08:25.28,0:08:27.03,Flashbacks,,0,0,0,,Anne...
Dialogue: 0,0:08:32.57,0:08:36.07,Main,,0,0,0,,Mama'nın verdiği tepki karşısında\Ndonup kalmıştım.
Dialogue: 0,0:08:36.07,0:08:41.62,Main,,0,0,0,,Beti benzi atarak hiç duymadığım\Nbir çığlık atmıştı!
Dialogue: 0,0:08:43.12,0:08:47.20,Main,,0,0,0,,Tatlı Krizleri'nden farklı bir durumdu.
Dialogue: 0,0:08:47.20,0:08:52.72,Main,,0,0,0,,Kulak zarımızı korumak için kulaklarımızı\Nkapamaktan başka bir şey yapamadık.
Dialogue: 0,0:08:52.72,0:08:57.35,Main,,0,0,0,,Herkes baygınlık geçirip\Nbirbiri ardına yere yığılıyordu!
Dialogue: 0,0:08:58.14,0:09:04.52,Main,,0,0,0,,Çığlığının yanı sıra \NKralların Hakisi'ni de kullanmıştı!
Dialogue: 0,0:09:04.52,0:09:08.15,Main,,0,0,0,,Bir fotoğraf yere düştü diye.
Dialogue: 0,0:09:09.37,0:09:11.94,Main,,0,0,0,,Asıl sonrasında olanlar önemli.
Dialogue: 0,0:09:17.87,0:09:22.70,Main,,0,0,0,,Mama dizlerinin üzerine kapaklandı ve\Nister inanın ister inanmayın...
Dialogue: 0,0:09:23.38,0:09:26.65,Main,,0,0,0,,...dizleri yere değdi diye yaralandı\Nve kanamaya başladı!
Dialogue: 0,0:09:27.71,0:09:32.86,Main,,0,0,0,,Normal insanlar gibi kırmızı kanı olacağını\Ndüşünmediğimden şaşıp kalmıştım.
Dialogue: 0,0:09:33.68,0:09:38.97,Main,,0,0,0,,Böyle kendinden geçtiğinde\Nvücudu zayıf düşüyor yani.
Dialogue: 0,0:09:38.97,0:09:46.89,Main,,0,0,0,,Bu yüzden de çay partisinde o resmi paramparça edersek n'olacak dersiniz?
Dialogue: 0,0:09:51.91,0:09:53.86,Main,,0,0,0,,Mama kendinden geçecek!
Dialogue: 0,0:09:53.86,0:09:58.82,Main,,0,0,0,,Kimseler de 5 saniye kadar bir süre\Nkılını kıpırdatamayacak!
Dialogue: 0,0:09:58.82,0:10:02.74,Main,,0,0,0,,Akabinde KX Fırlatıcıları gerçek gücünü\Ngösterecek ve...
Dialogue: 0,0:10:07.92,0:10:11.17,Main,,0,0,0,,...Yonkou Big Mom ölecek!
Dialogue: 0,0:10:12.69,0:10:17.42,Main,,0,0,0,,Big Mom suikasti haberleri ise\Ndünyanın dört bir yanına duyulacak!
Dialogue: 0,0:10:17.42,0:10:21.10,Main,,0,0,0,,Tamam da o çığlıktan\Nbiz de etkilenmez miyiz?
Dialogue: 0,0:10:22.14,0:10:25.16,Main,,0,0,0,,Merak etmeyin. Bunu da düşündük.
Dialogue: 0,0:10:25.16,0:10:28.56,Main,,0,0,0,,"Görünmez Senfoni Sistemi"!
Dialogue: 0,0:10:28.56,0:10:30.24,Main,,0,0,0,,Kulak tıkaçları!
Dialogue: 0,0:10:30.24,0:10:34.19,Main,,0,0,0,,Alt tarafı bir fotoğrafı kırmak\Nböyle bir karmaşaya yol açacaksa...
Dialogue: 0,0:10:34.19,0:10:37.40,Main,,0,0,0,,...bu esnada Sanji'nin ailesini de\Nkurtarmalıyız!
Dialogue: 0,0:10:38.32,0:10:41.32,Main,,0,0,0,,Ağır ol, çok rahat olacağınızı sanma.
Dialogue: 0,0:10:41.32,0:10:46.68,Main,,0,0,0,,Fotoğrafın parçalanmasından sonra Mama'nın\Nsaldırıya uğraması 3 saniye sürecektir.
Dialogue: 0,0:10:46.68,0:10:51.92,Main,,0,0,0,,Ortalık karışmadan kızgın Big Mom Korsanları\Nterafından çevrilirseniz...
Dialogue: 0,0:10:51.92,0:10:55.84,Main,,0,0,0,,...3 saniye boyunca hayatta kalmanız\Nmucize olur.
Dialogue: 0,0:10:55.84,0:11:00.26,Main,,0,0,0,,Bu rolü senin üstlenmen gerek\NHasır Şapka.
Dialogue: 0,0:11:00.26,0:11:04.02,Main,,0,0,0,,Dur biraz! \NO zaman Luffy yem olacak demektir!
Dialogue: 0,0:11:04.02,0:11:07.43,Main,,0,0,0,,Bege! \NNamiler Lola'nın hayatını kurtarmış!
Dialogue: 0,0:11:07.43,0:11:09.81,Main,,0,0,0,,Nasıl böyle tehlikeli bir rolü verirsin?
Dialogue: 0,0:11:10.53,0:11:11.57,Main,,0,0,0,,Olur!
Dialogue: 0,0:11:12.40,0:11:14.52,Main,,0,0,0,,Yaparım!
Dialogue: 0,0:11:14.52,0:11:16.38,Main,,0,0,0,,Ne?
Dialogue: 0,0:11:24.99,0:11:27.95,Main,,0,0,0,,İyice düşünmen gerek.
Dialogue: 0,0:11:27.95,0:11:33.40,Main,,0,0,0,,O değil de ortaya çıkmak için\Nharika bir fikir geldi aklıma!
Dialogue: 0,0:11:35.44,0:11:37.81,Main,,0,0,0,,Ortaya çıkmak için mi?
Dialogue: 0,0:11:37.81,0:11:42.11,Main,,0,0,0,,Nedir? Neymiş? Meraklandım şimdi!\NDuymak istiyorum!
Dialogue: 0,0:11:42.11,0:11:43.16,Main,,0,0,0,,Ben de!
Dialogue: 0,0:11:43.16,0:11:45.90,Main,,0,0,0,,Olmaz. \NŞimdi söylersem eğlencesi kaçar.
Dialogue: 0,0:11:45.90,0:11:47.39,Main,,0,0,0,,Ne?
Dialogue: 0,0:11:47.39,0:11:50.02,Thoughts,,0,0,0,,{\i1}– Bir de gitmiş endişeleniyoruz.\N– Bir de gitmiş endişeleniyoruz.{\i}
Dialogue: 0,0:11:50.02,0:11:52.85,Main,,0,0,0,,Kafama yattı.\NBildiğini oku o zaman.
Dialogue: 0,0:11:52.85,0:11:54.19,Main,,0,0,0,,Tamamdır.
Dialogue: 0,0:11:54.19,0:11:58.40,Main,,0,0,0,,Peki fotoğrafın ne zaman\Nparçalanacağını biliyor musunuz?
Dialogue: 0,0:11:58.40,0:12:01.04,Main,,0,0,0,,Sanji, Pudding'i öperken, değil mi?
Dialogue: 0,0:12:01.04,0:12:03.35,Main,,0,0,0,,Şapşal, öpmeyeceğim!\NNasıl öpeyim?
Dialogue: 0,0:12:03.35,0:12:07.74,Main,,0,0,0,,Düğün öpücüğü herkesin\Ndikkatini üzerine toplayacaktır.
Dialogue: 0,0:12:07.74,0:12:11.29,Main,,0,0,0,,Tam o anda...
Dialogue: 0,0:12:12.37,0:12:16.46,Main,,0,0,0,,...Pudding-{\i1}san{\i0}, Sanji-san'ı vuracak!
Dialogue: 0,0:12:16.46,0:12:19.20,Main,,0,0,0,,Mermiyi savuştururum.
Dialogue: 0,0:12:19.70,0:12:21.76,Main,,0,0,0,,Bu yüzden işaretimiz\Nsilahın ateşlenmesi olsun.
Dialogue: 0,0:12:21.76,0:12:23.89,Main,,0,0,0,,Tamamdır! Anlaşılması kolay!
Dialogue: 0,0:12:23.89,0:12:27.51,Main,,0,0,0,,Pekâlâ, planın üzerinden geçelim.
Dialogue: 0,0:12:28.72,0:12:34.69,Main,,0,0,0,,Pudding tetiği çektiğinde \NHasır Şapka fotoğrafı parçalar!
Dialogue: 0,0:12:34.69,0:12:37.90,Main,,0,0,0,,Big Mom çığlığı basar.
Dialogue: 0,0:12:37.90,0:12:43.78,Main,,0,0,0,,Biz de Görünmez Senfoni Sistemi'ni\Naktifleştiririz.
Dialogue: 0,0:12:43.78,0:12:44.99,Main,,0,0,0,,Şunlara kulak tıkacı desene.
Dialogue: 0,0:12:44.99,0:12:47.66,Main,,0,0,0,,Gerisi çorap söküğü gibi gelecek.
Dialogue: 0,0:12:48.25,0:12:52.71,Main,,0,0,0,,Herkes paniğe kapılmışken\Nsiz de Germa'yı kurtaracaksınız.
Dialogue: 0,0:12:52.71,0:12:57.17,Main,,0,0,0,,KX Fırlatıcı ve ölümcül gaz mermisiyle...
Dialogue: 0,0:12:58.79,0:13:00.70,Main,,0,0,0,,...Big Mom'a suikast düzenleyeceğiz.
Dialogue: 0,0:13:01.51,0:13:04.51,Main,,0,0,0,,Her şey azami 10 saniyede sonuçlanacak.
Dialogue: 0,0:13:04.51,0:13:07.40,Main,,0,0,0,,Big Mom'ın kellesini alır almaz...
Dialogue: 0,0:13:07.40,0:13:09.26,Main,,0,0,0,,...dangalağımız devreye girecek!
Dialogue: 0,0:13:09.26,0:13:10.96,Main,,0,0,0,,Aynen öyle, olaya el atacağım!
Dialogue: 0,0:13:12.26,0:13:13.35,Main,,0,0,0,,Dangalak mı?
Dialogue: 0,0:13:13.35,0:13:17.19,Main,,0,0,0,,- Beş para etmez herif. \N- Bu pislik de planın bir parçası mı yani?
Dialogue: 0,0:13:17.19,0:13:18.40,Main,,0,0,0,,Susun be!
Dialogue: 0,0:13:18.40,0:13:24.82,Main,,0,0,0,,İyi dinleyin! Muhteşem ben uçabildiği için\Nbir aynayla ortaya çıkacağım!
Dialogue: 0,0:13:24.82,0:13:27.09,Main,,0,0,0,,Bu kadınla birlikte tabii!
Dialogue: 0,0:13:27.09,0:13:31.37,Main,,0,0,0,,Beni de plana dâhil etmesenize!\NMama beni gebertecek!
Dialogue: 0,0:13:31.37,0:13:35.55,Main,,0,0,0,,Brûlée'yi getirmekle\Nçok iyi bir iş çıkardınız.
Dialogue: 0,0:13:35.55,0:13:39.43,Main,,0,0,0,,Kaçışımıza bundan daha fazla\Nkatkı sağlayacak bir şey yok.
Dialogue: 0,0:13:40.54,0:13:44.08,Main,,0,0,0,,Övdün diye mutlu olacak değiliz, şapşal!
Dialogue: 0,0:13:44.96,0:13:45.88,Main,,0,0,0,,Seni şapşal!
Dialogue: 0,0:13:45.88,0:13:50.90,Main,,0,0,0,,İşiniz biter bitmez\Ndoğruca Caesar'ın aynasına atlayın!
Dialogue: 0,0:13:50.90,0:13:54.64,Main,,0,0,0,,Big Mom hâlâ çığlık atıyor olacak.
Dialogue: 0,0:13:54.64,0:13:58.85,Main,,0,0,0,,Sonrasında ayna boyutunda elimizi\Nkolumuzu sallayarak kaçacağız.
Dialogue: 0,0:14:00.90,0:14:05.07,Main,,0,0,0,,Aynalar, adadan kaçmanın\Nen hızlı yöntemi olacaktır.
Dialogue: 0,0:14:05.07,0:14:09.07,Main,,0,0,0,,Ayna Diyarı'ndan geçerek\Nanında Sunny'ye varabiliriz.
Dialogue: 0,0:14:09.07,0:14:11.65,Main,,0,0,0,,Sağlam planmış.
Dialogue: 0,0:14:11.65,0:14:13.74,Main,,0,0,0,,Evet, bence işe yarayacak!
Dialogue: 0,0:14:14.42,0:14:16.88,Thoughts,,0,0,0,,{\i1}Aşağılıklar...
Dialogue: 0,0:14:17.37,0:14:21.58,Main,,0,0,0,,İki taraf da gemisine geçince\Nittifakımız sonlanır.
Dialogue: 0,0:14:21.58,0:14:25.21,Main,,0,0,0,,Bir an önce bu bölgeyi\Nterk etmeye bakmalıyız.
Dialogue: 0,0:14:25.21,0:14:26.91,Main,,0,0,0,,Savaşta şans yanınızda olsun.
Dialogue: 0,0:14:28.38,0:14:29.74,Main,,0,0,0,,Tamamdır!
Dialogue: 0,0:14:31.08,0:14:33.24,Main,,0,0,0,,Tamamız gibi.
Dialogue: 0,0:14:33.24,0:14:36.03,Main,,0,0,0,,Parti saat 10'da başlıyor, değil mi?
Dialogue: 0,0:14:37.78,0:14:40.15,Main,,0,0,0,,İki buçuk saat kaldı.
Dialogue: 0,0:14:40.68,0:14:44.27,Main,,0,0,0,,Damat olduğumdan odama dönmem gerek.
Dialogue: 0,0:14:44.27,0:14:49.18,Main,,0,0,0,,Biz de dönmeliyiz. \NYapmacık güvenlik görevine hazırlanalım.
Dialogue: 0,0:14:50.82,0:14:54.14,Main,,0,0,0,,Baksana Bege.\NSenden bir ricam olacak.
Dialogue: 0,0:14:54.14,0:14:55.16,Main,,0,0,0,,Neymiş?
Dialogue: 0,0:14:55.16,0:14:57.30,Main,,0,0,0,,Eğlenceli bir şekilde ortaya çıkınca...
Dialogue: 0,0:14:57.30,0:15:00.90,Main,,0,0,0,,Başlatma eğlencene! Ölürsün!
Dialogue: 0,0:15:02.29,0:15:05.80,Captions,,0,0,0,,{\fad(300,0)\pos(656,552)}Peynir Şehri, Süt Adası
Dialogue: 0,0:15:02.80,0:15:05.80,Main,,0,0,0,,{\an8}Bugün, çay partisinden dolayı tatil!
Dialogue: 0,0:15:06.34,0:15:09.26,Main,,0,0,0,,Mükemmel peynir ve bira\Nkombinasyonuyla kutlayalım!
Dialogue: 0,0:15:09.26,0:15:11.69,Main,,0,0,0,,Pudding-sama evlenecek yaşa\Ngeldi demek.
Dialogue: 0,0:15:11.69,0:15:16.72,Main,,0,0,0,,Damat da Germa 66'nın üçüncü oğulu.\NGüçlü bir müttefikimiz olacak yani!
Dialogue: 0,0:15:16.72,0:15:21.60,Captions,,0,0,0,,{\fad(300,300)\pos(656,552)}Yer Fıstığı Şehri, Kuru Yemiş Adası
Dialogue: 0,0:15:17.82,0:15:20.79,Main,,0,0,0,,{\an8}Du Feld Şirketler Grubu ailesi teşrif etti.
Dialogue: 0,0:15:20.79,0:15:23.86,Main,,0,0,0,,{\an8}Birçok ünlü davetli!
Dialogue: 0,0:15:24.82,0:15:26.40,Main,,0,0,0,,Bir yastıkta kocayın!
Dialogue: 0,0:15:26.40,0:15:28.90,Main,,0,0,0,,{\an8}Daha düğüne var!
Dialogue: 0,0:15:27.19,0:15:31.45,Captions,,0,0,0,,{\fad(300,0)\pos(656,552)}Çikolata Şehri, Kakao Adası
Dialogue: 0,0:15:29.81,0:15:31.45,Main,,0,0,0,,{\an8}Olsun ya! Çok mutluyum!
Dialogue: 0,0:15:32.53,0:15:35.12,Main,,0,0,0,,Bugün Sanji-sama evleniyor.
Dialogue: 0,0:15:35.12,0:15:39.12,Main,,0,0,0,,Korumalar kalenin içine kadar\Neşlik dahi edemedi.
Dialogue: 0,0:15:35.11,0:15:39.12,Captions,,1000,0,350,,{\fad(250,250)}Germa Krallığı
Dialogue: 0,0:15:39.12,0:15:41.81,Main,,0,0,0,,Hâliyle biz de kaleye giremeyiz.
Dialogue: 0,0:15:41.81,0:15:45.98,Main,,0,0,0,,Herhâlde öyle! \NDüğünde korumayı ne yapsınlar?
Dialogue: 0,0:15:45.98,0:15:48.38,Main,,0,0,0,,Evet, huzur dolu bir gün olması gerek.
Dialogue: 0,0:15:48.88,0:15:51.97,Captions,,0,0,0,,{\fad(300,0)\pos(656,552)}Whole Cake Şatosu
Dialogue: 0,0:15:51.97,0:15:56.31,Main,,0,0,0,,Vinsmoke Ailesi fertlerine\Ngünaydın dileklerimizi iletiyoruz!
Dialogue: 0,0:15:57.40,0:15:58.35,Main,,0,0,0,,Yonji!
Dialogue: 0,0:15:58.35,0:16:00.20,Main,,0,0,0,,{\an8}Kalk da üstünü değiş!
Dialogue: 0,0:15:58.35,0:16:03.40,Captions,,0,0,0,,{\fad(500,500)\pos(656,542)}6. Kat\NAğaç Misafir Odası
Dialogue: 0,0:16:00.20,0:16:03.58,Main,,0,0,0,,{\an8}Reiju nerede? Odasında yok.
Dialogue: 0,0:16:03.58,0:16:07.23,Main,,0,0,0,,Sahi, onu dünden beri görmedim.
Dialogue: 0,0:16:07.23,0:16:12.71,Main,,0,0,0,,Reiju-{\i1}sama başka bir odada\Ngiyinip kuşandı efendim.
Dialogue: 0,0:16:12.71,0:16:13.75,Main,,0,0,0,,Demek öyle.
Dialogue: 0,0:16:13.75,0:16:19.16,Main,,0,0,0,,Çay Partisi'ne daha 1 saat var,\Nacele etmeyin lütfen.
Dialogue: 0,0:16:21.83,0:16:23.99,Main,,0,0,0,,{\an8}N- Ne oldu?
Dialogue: 0,0:16:22.33,0:16:27.13,Captions,,0,0,0,,{\fad(500,0)\pos(656,552)}9. Kat\NBig Mom'ın Yatak Odası
Dialogue: 0,0:16:24.95,0:16:27.13,Main,,0,0,0,,{\an8}Bakanları çağırın!
Dialogue: 0,0:16:31.05,0:16:35.51,Main,,0,0,0,,K- Kıpırdamıyor! Ölmüş!
Dialogue: 0,0:16:35.51,0:16:38.85,Main,,0,0,0,,Biricik iskeletim!
Dialogue: 0,0:16:43.27,0:16:45.77,Main,,0,0,0,,Yazık olmuş Mama.
Dialogue: 0,0:16:45.77,0:16:49.40,Main,,0,0,0,,Bugün iple çektiğin Çay Partisi ile...
Dialogue: 0,0:16:49.40,0:16:52.07,Main,,0,0,0,,Bir de ne var acaba?
Dialogue: 0,0:16:54.74,0:16:59.51,Lyrics,,0,0,0,,♪ Düğün pastası! ♪
Dialogue: 0,0:17:06.40,0:17:11.92,Main,,0,0,0,,Morgans Bey ile diğer özel konuklar\Nçoktan teşrif ettiler.
Dialogue: 0,0:17:14.97,0:17:18.22,Captions,,0,0,0,,{\fad(150,0)\pos(656,552)}Doğu Körfezi, Whole Cake Adası
Dialogue: 0,0:17:21.85,0:17:26.19,Main,,0,0,0,,Bunu yapamazsınız! Çözün beni! Hırr!
Dialogue: 0,0:17:26.94,0:17:32.73,Captions,,0,0,0,,{\fad(500,0)\pos(665,435)}Güneş Korsanları İkinci Kaptan, Aladdin
Dialogue: 0,0:17:27.06,0:17:29.61,Main,,0,0,0,,{\an8}Yanına biraz suyla yiyecek bırakıyoruz.
Dialogue: 0,0:17:29.61,0:17:32.73,Main,,0,0,0,,{\an8}Üzgünüm, ancak çok geçmeden\Nbirileri seni bulacaktır.
Dialogue: 0,0:17:32.73,0:17:34.11,Main,,0,0,0,,Hadi oradan!
Dialogue: 0,0:17:34.11,0:17:37.74,Main,,0,0,0,,Nereye gidiyorsunuz? Hırr!
Dialogue: 0,0:17:37.74,0:17:40.41,Main,,0,0,0,,– Ülkeyi terk ediyoruz.\N– Ne?!
Dialogue: 0,0:17:40.41,0:17:45.08,Main,,0,0,0,,Bu yüzden gece boyu eşyalarınızı\Ntaşıyordunuz demek...
Dialogue: 0,0:17:45.08,0:17:46.82,Main,,0,0,0,,Hoşçakal.
Dialogue: 0,0:17:48.79,0:17:54.14,Main,,0,0,0,,Big Mom Korsanları boyunduruğundasınız,\Nkafanıza göre ülkeyi terk etmeniz...
Dialogue: 0,0:17:54.14,0:17:56.34,Main,,0,0,0,,...Mama'ya ihanet demektir!
Dialogue: 0,0:17:57.06,0:17:59.14,Main,,0,0,0,,Kendisi bu durumdan haberdar mı?
Dialogue: 0,0:17:59.14,0:18:01.76,Main,,0,0,0,,Haberdar olmaması hayrımıza.
Dialogue: 0,0:18:02.42,0:18:04.35,Main,,0,0,0,,Kanatları altından çıkanları öldürür.
Dialogue: 0,0:18:04.35,0:18:06.77,Main,,0,0,0,,Öyle biri, değil mi?
Dialogue: 0,0:18:08.92,0:18:11.61,Main,,0,0,0,,Jinbe sana minnetlerini iletti.
Dialogue: 0,0:18:11.61,0:18:13.32,Main,,0,0,0,,Jinbe mi?
Dialogue: 0,0:18:16.78,0:18:20.70,Main,,0,0,0,,Pekoms'un anlattıklarını dinlediğimiz için\Nçok şanslıyız.
Dialogue: 0,0:18:20.70,0:18:26.41,Main,,0,0,0,,Bege'nin Big Mom'ı o kadar kolay\Nöldürebileceğini sanmıyorum.
Dialogue: 0,0:18:26.41,0:18:30.69,Main,,0,0,0,,Fakat Mama'nın da Germa'ya suikast\Nplanlamasını aklım almıyor.
Dialogue: 0,0:18:31.25,0:18:36.47,Main,,0,0,0,,Luffy ve mürettebatı bunu öğrenirse\NSanji'yi kurtarmak için devreye girerler.
Dialogue: 0,0:18:36.47,0:18:42.18,Main,,0,0,0,,Luffyler tehlikedeyken görmezden gelemem!\NOnlara yardıma gitmeliyim!
Dialogue: 0,0:18:43.43,0:18:46.52,Main,,0,0,0,,Bu da demek oluyor ki...
Dialogue: 0,0:18:47.26,0:18:49.35,Main,,0,0,0,,...tam teşekküllü bir isyan çıkarıyorum.
Dialogue: 0,0:18:49.35,0:18:51.81,Captions,,0,0,0,,{\fad(500,0)\pos(656,490)}Charlotte Praline\NCharlotte Ailesi'nin 21. Kızı, Aladdin ile Evli
Dialogue: 0,0:18:50.19,0:18:53.12,Main,,0,0,0,,{\an8}Big Mom'a sırtımı döneceğim.
Dialogue: 0,0:18:53.77,0:18:58.78,Main,,0,0,0,,Ona olan görevimi tamamlamak için\Nayrıldığımı doğrudan yüzüne söylemiştim.
Dialogue: 0,0:18:59.40,0:19:01.45,Main,,0,0,0,,Gelgelelim rulet üzerindeki\Nnumaralar yüzünden...
Dialogue: 0,0:19:02.48,0:19:05.29,Main,,0,0,0,,...sözümü geri almıştım.
Dialogue: 0,0:19:05.29,0:19:12.08,Main,,0,0,0,,O numaralar benimle birlikte kurban\Nedilecek arkadaşlarımı temsil ediyordu!
Dialogue: 0,0:19:12.75,0:19:16.71,Main,,0,0,0,,Bu yüzden ülkeyi terk etmenizi istiyorum.
Dialogue: 0,0:19:17.48,0:19:19.92,Main,,0,0,0,,Big Mom'ın ödememi istediği bedel...
Dialogue: 0,0:19:19.92,0:19:24.68,Main,,0,0,0,,...hayatımı almaktan öte,\Ngaddarca bir cezalandırmadır!
Dialogue: 0,0:19:24.68,0:19:28.10,Main,,0,0,0,,Çay Partisi'nin yapılacağı gün\Navcı Meze Gemileri...
Dialogue: 0,0:19:28.10,0:19:33.44,Main,,0,0,0,,...her adadan kalkıp misafirlere eşlik edecek. \NGüvenlik zayıflayacak yani.
Dialogue: 0,0:19:33.44,0:19:38.63,Main,,0,0,0,,Çay Partisi'nde bir hadise yaşanırsa\Nherkesin dikkati oraya yönelecektir.
Dialogue: 0,0:19:38.63,0:19:40.74,Main,,0,0,0,,Bu da kaçış biletinizdir!
Dialogue: 0,0:19:40.74,0:19:44.79,Main,,0,0,0,,Bunu göze aldım.\NDerdimiz o değil Jinbe.
Dialogue: 0,0:19:46.28,0:19:50.62,Main,,0,0,0,,Özgürlüğünü kazanmana yardım etmek istiyoruz.
Dialogue: 0,0:19:50.62,0:19:53.00,Main,,0,0,0,,Evet, farkındayım!
Dialogue: 0,0:19:53.00,0:19:54.48,Main,,0,0,0,,Farkında falan değilsin!
Dialogue: 0,0:19:54.48,0:19:58.42,Main,,0,0,0,,Hasır Şapka'yı kurtarmak için\Nkendi canını bile verirsin!
Dialogue: 0,0:19:59.40,0:20:04.64,Main,,0,0,0,,Günün birinde Hasır Şapkalar'a\Nkatılacağımı söylemiştim...
Dialogue: 0,0:20:07.32,0:20:13.91,Main,,0,0,0,,Hayatım pahasına kaptanım \NHasır Şapka Luffy için savaşacağım!
Dialogue: 0,0:20:14.58,0:20:16.98,Main,,0,0,0,,Aladdin, bu dediğim...
Dialogue: 0,0:20:18.06,0:20:20.57,Main,,0,0,0,,...er ya da geç yaşanacak.
Dialogue: 0,0:20:21.55,0:20:24.36,Main,,0,0,0,,Tamam be. İstediğini yap.
Dialogue: 0,0:20:24.91,0:20:29.50,Main,,0,0,0,,Fakat kendi kuyruğunu\Nkurtarmaya da gayret et.
Dialogue: 0,0:20:29.50,0:20:30.70,Main,,0,0,0,,Anlaştık mı?
Dialogue: 0,0:20:31.79,0:20:34.42,Main,,0,0,0,,Balık Adam Adası'na gidiyoruz.
Dialogue: 0,0:20:36.38,0:20:39.96,Main,,0,0,0,,Sen de Ryugu Krallığı için \Nkaygılanıyorsun, değil mi?
Dialogue: 0,0:20:40.90,0:20:42.13,Main,,0,0,0,,Evet.
Dialogue: 0,0:20:42.92,0:20:45.55,Main,,0,0,0,,Adamızı ne pahasına olursa olsun koruyacağız!
Dialogue: 0,0:20:49.89,0:20:51.56,Main,,0,0,0,,Özür dilerim!
Dialogue: 0,0:20:51.56,0:20:54.44,Main,,0,0,0,,Kes şunu. \NBirbirimizi yıllardır tanıyoruz.
Dialogue: 0,0:20:55.32,0:20:57.90,Main,,0,0,0,,Hayatta kalıp tekrar buluşalım Jinbe!
Dialogue: 0,0:21:06.24,0:21:09.33,Main,,0,0,0,,Jinbe neden bana minnet duysun ki?
Dialogue: 0,0:21:09.33,0:21:11.29,Main,,0,0,0,,Bu arada Mama'ya söyledi mi...
Dialogue: 0,0:21:11.29,0:21:13.65,Main,,0,0,0,,Derhâl demir almaya hazırlanın!
Dialogue: 0,0:21:13.65,0:21:15.17,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:21:15.17,0:21:18.71,Main,,0,0,0,,Dursanıza alçaklar!
Dialogue: 0,0:21:21.03,0:21:23.16,Main,,0,0,0,,Nerelerdeydin Reiju?
Dialogue: 0,0:21:18.70,0:21:22.75,Captions,,0,970,360,,{\fad(250,250)}Whole Cake Şatosu
Dialogue: 0,0:21:23.16,0:21:24.72,Main,,0,0,0,,Sizi ilgilendirmez.
Dialogue: 0,0:21:24.72,0:21:29.37,Main,,0,0,0,,Geç saatlere kadar eğleniyordunuz ne de olsa.\NBen de odamı değiştirmelerini istedim.
Dialogue: 0,0:21:29.37,0:21:32.35,Main,,0,0,0,,Büyüklerinin işlerine burnunu sokma, şapşal.
Dialogue: 0,0:21:34.56,0:21:39.27,Main,,0,0,0,,Gidelim bakalım. \NÇay Partisi çatı katında tertiplenecek.
Dialogue: 0,0:21:39.27,0:21:47.32,Main,,0,0,0,,Nihayet gururlu Germa 66, \NBig Mom'ın desteğini alarak...
Dialogue: 0,0:21:47.32,0:21:50.49,Main,,0,0,0,,...Kuzey Mavi'ye tekrar hükmedecek!
Dialogue: 0,0:21:50.49,0:21:52.45,Main,,0,0,0,,Keyfin yerinde gibi.
Dialogue: 0,0:21:52.45,0:21:55.91,Main,,0,0,0,,Ama daha önemlisi...
Dialogue: 0,0:21:55.91,0:21:58.23,Main,,0,0,0,,Sanji kaçmadı, değil mi?
Dialogue: 0,0:21:58.23,0:22:01.92,Main,,0,0,0,,Damat da gelin de düğünü bekliyor.
Dialogue: 0,0:22:01.92,0:22:06.18,Thoughts,,0,0,0,,{\i1}Aklından neler geçiyor Sanji?\NNeden kaçmadın?
Dialogue: 0,0:22:06.18,0:22:09.34,Thoughts,,0,0,0,,{\i1}Başına gelecekleri biliyorsun.
Dialogue: 0,0:22:13.41,0:22:14.98,Main,,0,0,0,,İçim sıkıldı.
Dialogue: 0,0:22:14.98,0:22:16.27,Main,,0,0,0,,Ne oldu?
Dialogue: 0,0:22:16.27,0:22:17.94,Main,,0,0,0,,Düğün öncesi gerginlik mi?
Dialogue: 0,0:22:17.94,0:22:20.23,Main,,0,0,0,,Yok daha neler!
Dialogue: 0,0:22:17.94,0:22:22.16,Captions,,950,0,390,,{\fad(250,250)}Pudding'in Odası
Dialogue: 0,0:22:22.74,0:22:26.70,Main,,0,0,0,,Gerizekâlı Sanji'yi öldürdükten sonra\Nkanı üzerime sıçrasın istemiyorum.
Dialogue: 0,0:22:28.51,0:22:33.49,Main,,0,0,0,,Ayrıca tekrardan hanım bir kız olmak için\Nherkesin hafızasını silmem gerekiyor.
Dialogue: 0,0:22:35.34,0:22:37.52,Main,,0,0,0,,Tüm bunları düşününce...
Dialogue: 0,0:22:38.30,0:22:41.13,Main,,0,0,0,,...çok eriniyorum ya!
Dialogue: 0,0:22:46.95,0:22:49.64,Narrator,,0,0,0,,{\i1}Herkesin kafasında bir amacının olduğu...
Dialogue: 0,0:22:50.87,0:22:54.44,Narrator,,0,0,0,,{\i1}...korkunç Çay Partisi başlamak üzeredir!
Dialogue: 0,0:23:18.37,0:23:20.75,Lyrics,,0,0,0,,♪ Başlıyor! ♪\N♪ Başlıyor! ♪
Dialogue: 0,0:23:20.75,0:23:26.13,Lyrics,,0,0,0,,♪ Mama'nın Çay Partisi'nin vakti geldi! ♪
Dialogue: 0,0:23:26.13,0:23:32.34,Lyrics,,0,0,0,,♪ Geldi çattı! ♪\N♪ Geldi çattı! ♪
Dialogue: 0,0:23:34.69,0:23:38.31,Lyrics,,0,0,0,,♪ Domuz arabası dört nala gelir! ♪
Dialogue: 0,0:23:38.31,0:23:40.56,Lyrics,,0,0,0,,♪ Yetişebilecek midir? ♪
Dialogue: 0,0:23:40.56,0:23:44.77,Lyrics,,0,0,0,,♪ Geç kaldı. ♪\N♪ Hızlanması lazım. ♪
Dialogue: 0,0:23:44.77,0:23:50.07,Lyrics,,0,0,0,,♪ Büyük isimler...
Dialogue: 0,0:23:50.07,0:23:54.07,Lyrics,,0,0,0,,...teşrif edecek! ♪
Dialogue: 0,0:24:03.21,0:24:07.17,Captions,,0,0,0,,{\pos(318,425)}Tefeciler Patronu
Dialogue: 0,0:24:07.88,0:24:10.22,Captions,,0,0,0,,{\fad(0,200}{\pos(950,450)}"Para Babası" {\c&HFF0095&}Du Feld{\c&HFFFFFF&}
Dialogue: 0,0:24:16.43,0:24:21.73,Captions,,0,0,0,,{\pos(400,570)}Şehvet Mıntıkası Kraliçesi
Dialogue: 0,0:24:28.65,0:24:32.65,Captions,,0,0,0,,{\pos(385,425)}Büyük Cellat
Dialogue: 0,0:24:41.50,0:24:45.04,Captions,,0,0,0,,{\pos(843,660)}Dünya Ekonomi Dergisi Başkanı
Dialogue: 0,0:24:46.50,0:24:48.84,Captions,,0,0,0,,{\fad(0,200)\pos(345,525)}"Sansasyonel Haberci" {\c&H00FCFF&}Morgans{\c&HFFFFFF&}
Dialogue: 0,0:24:52.47,0:24:57.26,Captions,,0,0,0,,{\pos(600,570)}Ambarcı Tekeli
Dialogue: 0,0:24:58.31,0:25:01.43,Captions,,0,0,0,,{\fad(0,200)\pos(395,625)}"Zulacı" {\c&H0071FF&}Giberson{\c&HFFFFFF&}
Dialogue: 0,0:25:04.44,0:25:09.65,Captions,,0,0,0,,{\pos(955,445)}Nakliye Kralı
Dialogue: 0,0:25:10.36,0:25:13.86,Captions,,0,0,0,,{\fad(0,200)\pos(310,600)}"Derin Deniz Akıntıları" {\c&HFF3600&}Umit{\c&HFFFFFF&}
Dialogue: 0,0:25:20.32,0:25:25.11,Lyrics,,0,0,0,,♪ Seni niye davet ettiler ki-nen, cellat? ♪
Dialogue: 0,0:25:25.11,0:25:27.50,Lyrics,,0,0,0,,♪ Minicik beynini yorma, bırak düşünmeyi. ♪
Dialogue: 0,0:25:27.50,0:25:28.57,Main,,0,0,0,,Stussy-{\i1}sama!{\i1x{\i0}
Dialogue: 0,0:25:28.57,0:25:32.09,Lyrics,,0,0,0,,♪ Cellatlar düğünlere katılamaz mı? ♪
Dialogue: 0,0:25:33.22,0:25:39.35,Lyrics,,0,0,0,,♪ Senin kadar buram buram kan kokan\Nbiri tarafından hiç yargılanmamıştım Du Feld. ♪
Dialogue: 0,0:25:39.35,0:25:45.02,Lyrics,,0,0,0,,♪ Ah ya, iyi ki davet edildim. ♪
Dialogue: 0,0:25:45.02,0:25:47.31,Main,,0,0,0,,Morgans-{\i1}sama{\i1}!{\i0}
Dialogue: 0,0:25:47.31,0:25:52.46,Lyrics,,0,0,0,,♪ Bu evlilik manşetlere çıkacak!\NŞirketimiz Germa ile güçlü bağlara sahip. ♪
Dialogue: 0,0:25:53.07,0:25:58.12,Lyrics,,0,0,0,,♪ Fakat bu dediğin yeraltı dünyasında\Nkol gezen bir söylentiden ibaret! ♪
Dialogue: 0,0:25:58.12,0:26:00.57,Lyrics,,0,0,0,,♪ Eskide kaldı artık! ♪\N♪ Evet, kesinlikle. ♪
Dialogue: 0,0:26:00.57,0:26:04.00,Lyrics,,0,0,0,,♪ Taşınmaya bile lüzum yok. ♪
Dialogue: 0,0:26:04.77,0:26:08.96,Lyrics,,0,0,0,,♪ Merhabalar, keyifler nasıl? \N Hoş gelmişsiniz. ♪
Dialogue: 0,0:26:08.96,0:26:10.54,Main,,0,0,0,,Perospero-{\i1}kun!{\i0}
Dialogue: 0,0:26:10.54,0:26:14.92,Lyrics,,0,0,0,,♪ Yeraltı dünyasının efendileri...
Dialogue: 0,0:26:14.92,0:26:18.01,Lyrics,,0,0,0,,...yürümeyi dilerseniz biraz geç kalacaksınızdır. ♪
Dialogue: 0,0:26:18.01,0:26:20.01,Lyrics,,0,0,0,,♪ Sizleri salona götürmemi-perorin...
Dialogue: 0,0:26:20.01,0:26:23.39,Lyrics,,0,0,0,,...ister misiniz? ♪
Dialogue: 0,0:26:29.86,0:26:30.86,Main,,0,0,0,,Vay!
Dialogue: 0,0:26:45.70,0:26:53.96,Lyrics,,0,0,0,,♪ Şekerden Yürüyen Merdiven ile! ♪
Dialogue: 0,0:27:01.80,0:27:07.23,Main,,0,0,0,,- İşçilik diye buna derim!\N- Şeker yapıları her zaman...
Dialogue: 0,0:27:07.23,0:27:12.15,Lyrics,,0,0,0,,...ziyadesiyle sanatsal olmuştur! ♪
Dialogue: 0,0:27:13.27,0:27:15.82,Main,,0,0,0,,Onur duydum.
Dialogue: 0,0:27:16.34,0:27:19.26,Main,,0,0,0,,Mama geç kalınmasından nefret eder.
Dialogue: 0,0:27:19.26,0:27:22.16,Main,,0,0,0,,Buyurmaz mısınız?
Dialogue: 0,0:27:22.16,0:27:26.62,Main,,0,0,0,,Bak bak, merdivenler hareket ediyor!
Dialogue: 0,0:27:26.62,0:27:28.57,Main,,0,0,0,,Çok güzel görünüyor!
Dialogue: 0,0:27:28.57,0:27:31.53,Main,,0,0,0,,Sevdim bu işi. Hiç yorulmuyoruz.
Dialogue: 0,0:27:31.53,0:27:33.21,Main,,0,0,0,,Görüşmek üzere.
Dialogue: 0,0:27:35.15,0:27:36.50,Main,,0,0,0,,Alın bakalım.
Dialogue: 0,0:27:38.60,0:27:42.64,Main,,0,0,0,,Üç dakika sonra şeker merdivenini de\Nyalayabilirsiniz.
Dialogue: 0,0:27:43.56,0:27:46.68,Main,,0,0,0,,Benim de gitmem gerek artık.
Dialogue: 0,0:28:07.03,0:28:08.75,Main,,0,0,0,,Enfes kokuyor.
Dialogue: 0,0:28:08.75,0:28:10.46,Main,,0,0,0,,İçeri buyrun lütfen.
Dialogue: 0,0:28:10.46,0:28:13.54,Main,,0,0,0,,Burası her zaman\Ninsanın iştahını açmıştır-nen.
Dialogue: 0,0:28:13.54,0:28:15.73,Main,,0,0,0,,Sefalar getirdiniz değerli konuklarımız.
Dialogue: 0,0:28:15.73,0:28:18.19,Main,,0,0,0,,Merhaba Smoothie.
Dialogue: 0,0:28:18.19,0:28:20.63,Main,,0,0,0,,Bir hoş geldiniz içeceğine ne dersiniz?
Dialogue: 0,0:28:20.63,0:28:26.69,Main,,0,0,0,,Menümüzde Mauri Volkanı'ndan bir lav parçası,\Nbin erkeği bıçaklayan bir güzel ile...
Dialogue: 0,0:28:26.69,0:28:30.35,Main,,0,0,0,,...komik sesler çıkaran bir zürafa var.
Dialogue: 0,0:28:30.35,0:28:33.16,Main,,0,0,0,,- Zürafadan bir bardak alayım.\N- Ben de.
Dialogue: 0,0:28:33.16,0:28:35.15,Main,,0,0,0,,Hay hay. Hemen sıkıyorum.
Dialogue: 0,0:28:41.51,0:28:43.45,Main,,0,0,0,,Çok komik lan!
Dialogue: 0,0:28:46.45,0:28:48.58,Main,,0,0,0,,Buyurun.
Dialogue: 0,0:28:54.20,0:28:57.06,Main,,0,0,0,,Lezzeti de ağızdaki tadı da harika.
Dialogue: 0,0:28:59.25,0:29:00.80,Main,,0,0,0,,Açın ulan!
Dialogue: 0,0:29:00.80,0:29:03.62,Main,,0,0,0,,Sıçarım üst aramanıza!
Dialogue: 0,0:29:00.80,0:29:05.87,Captions,,1040,0,320,,{\fad(250,250)}Çay Partisi'nin Önü
Dialogue: 0,0:29:03.62,0:29:06.41,Main,,0,0,0,,Maalesef buna müsaade edemeyiz Bay Jigra.
Dialogue: 0,0:29:06.41,0:29:08.03,Main,,0,0,0,,Bırakın lan!
Dialogue: 0,0:29:08.03,0:29:11.30,Main,,0,0,0,,Bırakın dedim!
Dialogue: 0,0:29:12.18,0:29:16.48,Captions,,0,0,0,,{\fad(500,0)\pos(640,480)}Organ Mafyası Jigra
Dialogue: 0,0:29:17.12,0:29:20.48,Main,,0,0,0,,Big Mom içeride mi?
Dialogue: 0,0:29:21.61,0:29:26.54,Main,,0,0,0,,Bir önceki Çay Partisi'ne de\Ndavetiye almıştım.
Dialogue: 0,0:29:27.32,0:29:30.58,Main,,0,0,0,,Ne kadar istediysem de katılamadım ama.
Dialogue: 0,0:29:30.58,0:29:34.16,Main,,0,0,0,,Çünkü annemin cenazesini defnetmem gerekti!
Dialogue: 0,0:29:34.16,0:29:36.92,Main,,0,0,0,,Durumu izah eden bir mektup yazmıştım.
Dialogue: 0,0:29:36.92,0:29:41.30,Main,,0,0,0,,Peki Big Mom bana ne gönderdi dersiniz?
Dialogue: 0,0:29:45.17,0:29:48.01,Main,,0,0,0,,Hastaneye yatırılan babamın--
Dialogue: 0,0:30:07.16,0:30:10.62,Main,,0,0,0,,Hey! Kim ateş etti! O da davetliydi!
Dialogue: 0,0:30:15.15,0:30:16.32,Main,,0,0,0,,Sen...
Dialogue: 0,0:30:22.00,0:30:27.10,Captions,,500,0,660,,{\fad(0,1000)}3 Şekerleme Generali'nden Biri
Dialogue: 0,0:30:24.01,0:30:28.00,Captions,,0,50,130,,{\fad(0,1000)}Big Mom Korsanları
Dialogue: 0,0:30:26.01,0:30:28.01,Captions,,0,300,465,,Charlotte Ailesi'nin 2. Oğlu
Dialogue: 0,0:30:28.01,0:30:31.00,Captions,,0,300,465,,{\fad(0,1000)}Charlotte Ailesi'nin 2. Oğlu
Dialogue: 0,0:30:28.01,0:30:32.97,Captions,,0,0,0,,{\fad(0,1000)}Kelle Ödülü: 1 Milyar 57 Milyon Beli
Dialogue: 0,0:30:34.40,0:30:36.56,Main,,0,0,0,,Şekerleme Generali Katakuri!
Dialogue: 0,0:30:40.40,0:30:41.77,Main,,0,0,0,,Onu neden vurdun?
Dialogue: 0,0:30:41.77,0:30:44.53,Main,,0,0,0,,Şunları söyleyecekti.
Dialogue: 0,0:30:45.13,0:30:49.88,Main,,0,0,0,,"Peki Big Mom bana ne gönderdi dersiniz?"
Dialogue: 0,0:30:50.49,0:30:53.99,Main,,0,0,0,,"Hastaneye yatırılan babamın kellesini!"
Dialogue: 0,0:30:54.99,0:30:58.58,Main,,0,0,0,,"İntikamımı almaya geldim!"
Dialogue: 0,0:30:58.58,0:31:00.71,Main,,0,0,0,,"Kapıları açın!"
Dialogue: 0,0:31:00.71,0:31:01.79,Main,,0,0,0,,Bum.
Dialogue: 0,0:31:02.54,0:31:04.84,Main,,0,0,0,,Tekrar ateş edecekti.
Dialogue: 0,0:31:05.75,0:31:09.55,Main,,0,0,0,,İki adamın vurulacaktı.
Dialogue: 0,0:31:11.14,0:31:17.76,Main,,0,0,0,,Bunlar yaşanmadan kendisine\Njöleli şeker atmam sorun mu oluyor?
Dialogue: 0,0:31:17.76,0:31:20.08,Main,,0,0,0,,"Kale" Bege.
Dialogue: 0,0:31:21.93,0:31:25.22,Main,,0,0,0,,Buna benim karar verdiğimi \NMama'ya söylersin.
Dialogue: 0,0:31:27.16,0:31:29.65,Main,,0,0,0,,Sen de şimdi şunları diyeceksin.
Dialogue: 0,0:31:30.75,0:31:32.27,Main,,0,0,0,,"Anladım."
Dialogue: 0,0:31:32.27,0:31:34.74,Main,,0,0,0,,"Tamam öyleyse."
Dialogue: 0,0:31:36.82,0:31:40.57,Thoughts,,0,0,0,,{\i1}Çay Partisi'ndeki en büyük sorun bu eleman!"
Dialogue: 0,0:31:40.57,0:31:46.19,Thoughts,,0,0,0,,{\i1}"Gözlem Hakisi'ni öyle geliştirmiş ki bir yere kadar geleceği bile görebiliyor."
Dialogue: 0,0:31:46.19,0:31:48.26,Thoughts,,0,0,0,,{\i1}Kelle ödülü bir milyarın üstündeki...
Dialogue: 0,0:31:48.26,0:31:50.50,Thoughts,,0,0,0,,{\i1}...canavar!{\i0}
Dialogue: 0,0:31:52.06,0:31:54.82,Main,,0,0,0,,Anladım. Tamam öyleyse.
Dialogue: 0,0:31:56.68,0:31:58.44,Main,,0,0,0,,Vakit geldi.
Dialogue: 0,0:32:21.91,0:32:25.38,Main,,0,0,0,,Çay Partisi vakti geldi çattı.
Dialogue: 0,0:32:32.80,0:32:37.22,Main,,0,0,0,,Millet! Zahmet edip\Ngeldiğiniz için teşekkür ederim!
Dialogue: 0,0:32:46.11,0:32:53.82,Main,,0,0,0,,Kafanıza nereye çevirseniz\Ntatlı görürsünüz!
Dialogue: 0,0:33:01.79,0:33:02.91,Main,,0,0,0,,Yiyin!
Dialogue: 0,0:33:04.71,0:33:05.79,Main,,0,0,0,,İçin!
Dialogue: 0,0:33:07.54,0:33:13.43,Main,,0,0,0,,Partinin keyfini çıkarmaya bakın!
Dialogue: 0,0:33:14.34,0:33:17.47,Main,,0,0,0,,Burada yaşanacak...
Dialogue: 0,0:33:18.18,0:33:20.58,Main,,0,0,0,,...her şeyin tadına varın.
