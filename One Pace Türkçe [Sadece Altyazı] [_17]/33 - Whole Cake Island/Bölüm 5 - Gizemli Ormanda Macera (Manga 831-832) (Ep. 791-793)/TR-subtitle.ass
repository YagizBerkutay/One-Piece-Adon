0,1Style: Author,Impress BT,20.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.7,0.7,9,10,10,10,1Style: Attack,Duality,30.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.0,1.0,7,12,12,12,1Style: Special-Captions,Times New Roman,45,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,-1,0,0,0,100,100,0,0,1,2,0,2,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:01:43.66,0:01:48.14,Captions,,0,0,0,,Whole Cake AdasıDialogue: 0,0:01:48.14,0:01:50.71,Author,,0,0,0,,Türkçeleştirme onepacetr.net  Çevirmenler  eray.gns    ARE-YOU-SURE thx to onepace.netDialogue: 0,0:14:15.20,0:14:25.20,Author,,0,0,0,,Türkçeleştirme onepacetr.net  Çevirmenler  eray.gns    ARE-YOU-SURE thx to onepace.netDialogue: 0,0:32:08.80,0:32:11.80,Author,,0,0,0,,Türkçeleştirme onepacetr.net  Çevirmenler  eray.gns    ARE-YOU-SURE thx to onepace.netDialogue: 0,0:01:48.14,0:01:50.71,Title,,0,0,250,,Gizemli Ormanda MaceraDialogue: 0,0:01:48.44,0:01:50.08,Main,,0,0,0,,Gidelim bakalım!Dialogue: 0,0:01:50.71,0:01:53.80,Main,,0,0,0,,- Bu olayı her görüşümde heyecanlanıyorum!  - Ben de öyle!Dialogue: 0,0:01:53.80,0:01:56.47,Main,,0,0,0,,Üç numaralı kanal!Dialogue: 0,0:01:59.22,0:02:00.72,Main,,0,0,0,,Geliyor işte!Dialogue: 0,0:02:00.72,0:02:03.56,Main,,0,0,0,,Denizaltı Köpekbalığı 3!Dialogue: 0,0:02:13.51,0:02:17.03,Main,,0,0,0,,Öyleyse Pedro-san'ı götürüyorum!Dialogue: 0,0:02:17.03,0:02:19.19,Main,,0,0,0,,Bağışla beni, Luffy!Dialogue: 0,0:02:19.19,0:02:24.12,Main,,0,0,0,,Yalnız gideceğim dedim ama Brook'u da yanımda sürüklüyorum!Dialogue: 0,0:02:25.83,0:02:31.67,Main,,0,0,0,,Pedro-san'a epey yardımcı olurum diye düşünüyorum! Sızma görevleri benim işim!Dialogue: 0,0:02:31.67,0:02:36.00,Main,,0,0,0,,Poneglifin bir kopyasını ne pahasına olursa olsun çıkartacağım!Dialogue: 0,0:02:36.00,0:02:39.38,Main,,0,0,0,,Pekâlâ, size güveniyorum Brook, Pedro!Dialogue: 0,0:02:39.38,0:02:43.51,Main,,0,0,0,,Sanji ve Pudding'le buluştuktan sonra sizi burada bekleriz.Dialogue: 0,0:02:43.51,0:02:49.35,Main,,0,0,0,,Dikkati elden bırakmayalım. Pekoms'un mesajını unutmayın.Dialogue: 0,0:02:49.35,0:02:51.15,Note,,0,0,0,,GERİ DÖNÜNDialogue: 0,0:02:51.15,0:02:55.65,Main,,0,0,0,,Devam etmeye karar verdik, bu işin sonunu göreceğiz!Dialogue: 0,0:02:55.65,0:02:59.03,Main,,0,0,0,,- Size güveniyoruz! - Güle güle!Dialogue: 0,0:02:59.03,0:03:00.20,Main,,0,0,0,,İyi şanslar!Dialogue: 0,0:03:00.89,0:03:03.28,Main,,0,0,0,,Hadi görüşmek üzere!Dialogue: 0,0:03:03.28,0:03:05.55,Main,,0,0,0,,Gidelim öyleyse!Dialogue: 0,0:03:40.81,0:03:45.53,Main,,0,0,0,,Derinlik 15 metre. Görüş açık.Dialogue: 0,0:03:50.28,0:03:52.17,Main,,0,0,0,,Harikulade!Dialogue: 0,0:03:54.45,0:03:58.88,Main,,0,0,0,,Nehrin içinden dosdoğru Big Mom'ın kalesine gidelim!Dialogue: 0,0:03:58.88,0:04:01.46,Main,,0,0,0,,Umarım nehir uygun derinliktedir.Dialogue: 0,0:04:01.46,0:04:03.06,Main,,0,0,0,,Sana güveniyorum!Dialogue: 0,0:04:12.89,0:04:16.40,Captions,,0,0,0,,Güneybatı KıyısıDialogue: 0,0:04:16.40,0:04:18.15,Main,,0,0,0,,Yaşasın!Dialogue: 0,0:04:19.32,0:04:23.99,Main,,0,0,0,,Karaya ayak bastım! Sonunda Big Mom'ın adasındayız!Dialogue: 0,0:04:33.96,0:04:36.92,Main,,0,0,0,,- Macera kokusu alıyorum! - Hayatta olmaz!Dialogue: 0,0:04:36.92,0:04:39.75,Main,,0,0,0,,Sanji-kun'u bulur bulmaz derhal geri döneceğiz!Dialogue: 0,0:04:40.26,0:04:45.17,Main,,0,0,0,,Hey! Sanji! Pudding!Dialogue: 0,0:04:45.17,0:04:48.68,Main,,0,0,0,,Anlaştığımız gibi geldik!Dialogue: 0,0:04:48.68,0:04:51.60,Main,,0,0,0,,Bağırmasana! Düşmana yakalanacağız!Dialogue: 0,0:04:52.06,0:04:55.98,Main,,0,0,0,,O ikisini gördüğüne emin misin Luffy?Dialogue: 0,0:04:55.98,0:04:58.44,Main,,0,0,0,,Gördüm! Eminim!Dialogue: 0,0:04:58.44,0:05:02.57,Main,,0,0,0,,Ama biz baktığımızda kimse yoktu.Dialogue: 0,0:05:04.03,0:05:09.45,Main,,0,0,0,,Lezizmiş! Nami, toprağı yesene bi! Sertleşmiş krema!Dialogue: 0,0:05:10.62,0:05:11.87,Main,,0,0,0,,Dehşet bir şey!Dialogue: 0,0:05:13.83,0:05:18.79,Main,,0,0,0,,Öyle gerçekten de! Beze bu. Tüm ada böyle tatlılarla mı dolu acaba?Dialogue: 0,0:05:18.79,0:05:22.13,Main,,0,0,0,,Oh ya! Burada yaşamak istiyorum!Dialogue: 0,0:05:23.94,0:05:25.42,Main,,0,0,0,,Bu civarlarda olması lazım!Dialogue: 0,0:05:26.34,0:05:32.81,Main,,0,0,0,,Sanji'yle Pudding'i burada gördüğüme eminim ama bir an kafamı çevirince kayboldular!Dialogue: 0,0:05:32.81,0:05:36.85,Main,,0,0,0,,Güneybatı kıyısında olduğumuza hiç şüphe yok...Dialogue: 0,0:05:36.85,0:05:42.31,Main,,0,0,0,,...ve yalan söyleyemediğini biliyorum ama neden kayboldular acaba?Dialogue: 0,0:05:42.31,0:05:45.15,Main,,0,0,0,,Sanji'ye çabucak kavuşmak istiyorum.Dialogue: 0,0:05:48.72,0:05:50.24,Main,,0,0,0,,Oh?Dialogue: 0,0:05:58.84,0:05:59.63,Main,,0,0,0,,Hey!Dialogue: 0,0:05:59.63,0:06:01.37,Main,,0,0,0,,Orada işte!Dialogue: 0,0:06:03.00,0:06:05.46,Main,,0,0,0,,- Sanji! - Ne?Dialogue: 0,0:06:12.35,0:06:14.43,Main,,0,0,0,,Sanji!Dialogue: 0,0:06:14.43,0:06:16.43,Main,,0,0,0,,- Ne oldu? - Hey!Dialogue: 0,0:06:17.52,0:06:18.52,Main,,0,0,0,,Ne oldu?Dialogue: 0,0:06:18.52,0:06:22.61,Main,,0,0,0,,Sanji az önce oradaydı! Neden saklanıyor acaba?Dialogue: 0,0:06:23.20,0:06:24.48,Main,,0,0,0,,Hadi ya?Dialogue: 0,0:06:34.78,0:06:35.58,Main,,0,0,0,,Oh?Dialogue: 0,0:06:35.58,0:06:36.91,Main,,0,0,0,,Sanji?Dialogue: 0,0:06:36.91,0:06:39.67,Main,,0,0,0,,Nereye gitti?Dialogue: 0,0:06:45.60,0:06:49.64,Main,,0,0,0,,Gözümüzden kaçırdık! Yalnız burası acayip leziz görünüyor!Dialogue: 0,0:06:49.64,0:06:51.73,Main,,0,0,0,,Tatlı ormanı!Dialogue: 0,0:06:51.73,0:06:53.60,Main,,0,0,0,,Mis kokuyor!Dialogue: 0,0:06:54.48,0:06:58.10,Main,,0,0,0,,Üçünüz birden gördüyseniz yanılıyor olamazsınız.Dialogue: 0,0:06:59.23,0:07:02.86,Main,,0,0,0,,Ama neden kayboldu acaba?Dialogue: 0,0:07:02.86,0:07:04.48,Main,,0,0,0,,Sanji-kun...Dialogue: 0,0:07:05.11,0:07:08.19,Flashbacks,,0,0,0,,Hiç olmazsa buna inanın.Dialogue: 0,0:07:08.19,0:07:12.20,Flashbacks,,0,0,0,,Dostlarımdan sır saklama niyetinde değildim.Dialogue: 0,0:07:12.57,0:07:15.91,Main,,0,0,0,,Bizimle yüzyüze görüşmeye utanıyor falan mı acaba?Dialogue: 0,0:07:15.91,0:07:21.17,Main,,0,0,0,,Hey! Sanji! Çık ortaya!Dialogue: 0,0:07:21.17,0:07:24.38,Main,,0,0,0,,Seni almaya geldik!Dialogue: 0,0:07:24.38,0:07:26.67,Main,,0,0,0,,Sanji!Dialogue: 0,0:07:34.26,0:07:36.81,Main,,0,0,0,,Pekâlâ, ayrılıp arayalım!Dialogue: 0,0:07:36.81,0:07:41.06,Main,,0,0,0,,Ben şu tarafa, pastaların yanına doğru gidiyorum!Dialogue: 0,0:07:41.06,0:07:42.71,Main,,0,0,0,,Ben böyle dümdüz!Dialogue: 0,0:07:42.71,0:07:45.61,Main,,0,0,0,,Tatlı mı tatlı karamel kokusunun olduğu yöne doğru!Dialogue: 0,0:07:45.61,0:07:50.78,Main,,0,0,0,,Öyleyse ben de böyle gidiyorum! Şu harika fasulye şekerlemelerine bakın!Dialogue: 0,0:07:50.78,0:07:54.32,Main,,0,0,0,,Durun bakalım biraz! Gene bir şeyleri yiyip başımıza dert açmayın!Dialogue: 0,0:07:54.32,0:07:58.92,Main,,0,0,0,,Ne var ya?! Gözümüzden kaçırdık işte, rastgele aramaktan başka ne seçeneğimiz var?Dialogue: 0,0:07:58.92,0:08:01.54,Main,,0,0,0,,Kaybolup da yolunu arayan insanlar gibi konuştun!Dialogue: 0,0:08:01.54,0:08:06.08,Main,,0,0,0,,Sanki bambaşka arzuların peşine düştüğünüzü fark etmedim mi sanıyorsunuz?!Dialogue: 0,0:08:07.02,0:08:09.09,Main,,0,0,0,,Bambaşka mı?Dialogue: 0,0:08:10.30,0:08:12.47,Main,,0,0,0,,Yok öyle bir şey!Dialogue: 0,0:08:13.06,0:08:14.84,Main,,0,0,0,,Yalancılar sizi!Dialogue: 0,0:08:14.84,0:08:22.06,Main,,0,0,0,,Tamam peki, hep beraber arayacağız! Üçünüz de yanımdan ayrılmıyorsunuz, anlaşıldı mı?Dialogue: 0,0:08:22.06,0:08:23.89,Main,,0,0,0,,Peki! Anladım!Dialogue: 0,0:08:28.19,0:08:31.69,Main,,0,0,0,,- Çiçek meğer şekermiş! - Yok artık!Dialogue: 0,0:08:31.69,0:08:34.90,Main,,0,0,0,,Karamel kokusu bunlardan geliyormuş!Dialogue: 0,0:08:41.37,0:08:45.69,Main,,0,0,0,,Acayip şekerli! Dişlerime yapışıyor!Dialogue: 0,0:08:45.69,0:08:48.43,Main,,0,0,0,,Mutluluğun anlamı!Dialogue: 0,0:08:53.80,0:09:00.06,Main,,0,0,0,,Millet, unuttunuz mu yoksa? Buraya Sanji-kun'u almaya geldik!Dialogue: 0,0:09:00.06,0:09:03.06,Main,,0,0,0,,Gözünüz tatlıdan başka şey görmüyor!Dialogue: 0,0:09:03.06,0:09:05.31,Main,,0,0,0,,Amacımız Sanji-kun'u bulmak değil miydi?Dialogue: 0,0:09:05.31,0:09:07.15,Main,,0,0,0,,Biliyoruz ya!Dialogue: 0,0:09:07.50,0:09:10.61,Main,,0,0,0,,Ama aburcuburdan geçilmiyor ne yapalım?!Dialogue: 0,0:09:10.61,0:09:15.45,Main,,0,0,0,,İşte çok tuhaf değil mi?! Düşman bölgesindeyiz!Dialogue: 0,0:09:15.45,0:09:19.79,Main,,0,0,0,,Bir noktaya kadar arayıp Sanji-kun'u bulamazsak derhal geri döneceğiz.Dialogue: 0,0:09:19.79,0:09:21.41,Main,,0,0,0,,Niye?!Dialogue: 0,0:09:21.41,0:09:22.95,Main,,0,0,0,,Nedenmiş o?!Dialogue: 0,0:09:27.31,0:09:30.13,Main,,0,0,0,,Bu yeşil nehir kavun tadında!Dialogue: 0,0:09:30.13,0:09:32.09,Main,,0,0,0,,Sahi mi?! Ver bakayım!Dialogue: 0,0:09:32.09,0:09:35.34,Main,,0,0,0,,Bu köprü de meğer donatmış!Dialogue: 0,0:09:35.34,0:09:38.09,Main,,0,0,0,,Yeter ama ya!Dialogue: 0,0:09:45.81,0:09:47.14,Main,,0,0,0,,Çabuk köprüyü geçin!Dialogue: 0,0:09:52.52,0:09:53.61,Main,,0,0,0,,Nami!Dialogue: 0,0:10:05.58,0:10:07.02,Main,,0,0,0,,Timsah!Dialogue: 0,0:10:08.12,0:10:10.25,Main,,0,0,0,,Halledecek misin Luffy?!Dialogue: 0,0:10:13.08,0:10:14.05,Main,,0,0,0,,Hayır.Dialogue: 0,0:10:18.97,0:10:21.26,Main,,0,0,0,,İnsanlarmış...Dialogue: 0,0:10:31.65,0:10:33.69,Main,,0,0,0,,Ne sandın bizi?!Dialogue: 0,0:10:33.69,0:10:34.98,Main,,0,0,0,,En önemli soru o mu şimdi!Dialogue: 0,0:10:34.98,0:10:38.65,Main,,0,0,0,,Kafasına şapka takmış, kıyafetleri olan, konuşan bir timsah duruyor karşında!Dialogue: 0,0:10:38.65,0:10:41.70,Main,,0,0,0,,Bu orman düşündüğüm gibi çok tehlikeli, çok tuhaf!Dialogue: 0,0:10:42.61,0:10:46.08,Main,,0,0,0,,Etrafına bak, böyle her ufak şeye şaşıracak olursan...Dialogue: 0,0:10:47.81,0:10:51.17,Main,,0,0,0,,Yani tamam, haklısınız da...Dialogue: 0,0:11:06.14,0:11:10.18,Main,,0,0,0,,Bence Pudding'e güvenip denize yakın bir yerde bekleyelim!Dialogue: 0,0:11:10.18,0:11:12.85,Main,,0,0,0,,Eminim Sanji-kun'u getirecektir!Dialogue: 0,0:11:12.85,0:11:16.15,Main,,0,0,0,,Hem bakın, geri dönüş yolumuzu yitirdik bile!Dialogue: 0,0:11:16.15,0:11:19.90,Main,,0,0,0,,Bir şey olmaz! Ne zaman istersek karşı tarafa atlayabiliriz.Dialogue: 0,0:11:34.33,0:11:35.42,Main,,0,0,0,,Ne?!Dialogue: 0,0:11:35.42,0:11:39.13,Main,,0,0,0,,İki tane Luffy var!Dialogue: 0,0:11:39.13,0:11:41.13,Main,,0,0,0,,Yok artık?!Dialogue: 0,0:11:41.13,0:11:42.88,Main,,0,0,0,,Sen de kimsin be?!Dialogue: 0,0:11:48.52,0:11:52.81,Main,,0,0,0,,Ne demek sen de kimsin?! Luffy'im ben! Taklit etmeyi bırak!Dialogue: 0,0:11:52.81,0:11:55.40,Main,,0,0,0,,Bu ne şimdi?! Ne oluyor?! Hangisi gerçek Luffy?!Dialogue: 0,0:11:55.40,0:11:58.53,Main,,0,0,0,,Aynı şekilde hareket edip aynı şekilde konuşuyorlar!Dialogue: 0,0:11:58.53,0:12:00.49,Main,,0,0,0,,Hayır, ufak farklılıklar var!Dialogue: 0,0:12:05.41,0:12:12.04,Main,,0,0,0,,Sanki aynı aynaya bakıyormuş gibi yaraları ve aksesuarları ters tarafta.Dialogue: 0,0:12:12.86,0:12:16.59,Main,,0,0,0,,Gerçekten de aynaya bakarmış gibi! Kimin nesi bu?!Dialogue: 0,0:12:16.59,0:12:19.13,Main,,0,0,0,,Kimsin sen?!Dialogue: 0,0:12:19.13,0:12:23.05,Main,,0,0,0,,Sana kimsin diye soruyor, cevap ver!Dialogue: 0,0:12:25.89,0:12:28.26,Main,,0,0,0,,Orada işte! Sanji'yi buldum!Dialogue: 0,0:12:28.97,0:12:31.06,Main,,0,0,0,,Ağacın üstünde, yukarıda!Dialogue: 0,0:12:33.56,0:12:36.27,Main,,0,0,0,,Hey! Sanji!Dialogue: 0,0:12:39.27,0:12:41.49,Main,,0,0,0,,Çekil önümden be!Dialogue: 0,0:12:41.49,0:12:44.57,Main,,0,0,0,,Sanji-kun, orada ne yapıyorsun?!Dialogue: 0,0:12:45.24,0:12:48.62,Main,,0,0,0,,Gene kaçıyor! Sanji!Dialogue: 0,0:12:49.87,0:12:54.20,Main,,0,0,0,,Adi herif! Çekil önümden!Dialogue: 0,0:12:59.34,0:13:02.76,Main,,0,0,0,,Lanet olsun! Millet siz önden, Sanji'nin peşinden gidin!Dialogue: 0,0:13:02.76,0:13:04.20,Main,,0,0,0,,Pe-Peki!Dialogue: 0,0:13:04.20,0:13:05.76,Main,,0,0,0,,Ben de geliyorum!Dialogue: 0,0:13:05.76,0:13:08.73,Main,,0,0,0,,Birbirinizden ayrılmayın Chopper, Carrot!Dialogue: 0,0:13:08.73,0:13:12.68,Main,,0,0,0,,Çok tuhaf bir orman bu! Yine bir şeyler olabilir!Dialogue: 0,0:13:12.68,0:13:15.98,Main,,0,0,0,,Biliyorum ama Sanji'yi yine gözümüzden kaçırırsak...Dialogue: 0,0:13:15.98,0:13:18.11,Main,,0,0,0,,Sanji!Dialogue: 0,0:13:18.11,0:13:20.15,Main,,0,0,0,,Nami, sen de onlarla git!Dialogue: 0,0:13:20.15,0:13:22.48,Main,,0,0,0,,Ben şunun canına okuyup size yetişirim!Dialogue: 0,0:13:22.48,0:13:24.45,Main,,0,0,0,,Peki, anladım!Dialogue: 0,0:13:31.74,0:13:35.71,Main,,0,0,0,,Sanji!Dialogue: 0,0:13:56.56,0:13:59.02,Main,,0,0,0,,Gomu Gomu no...Dialogue: 0,0:13:59.02,0:14:01.86,Main,,0,0,0,,...Gatling!Dialogue: 0,0:13:59.02,0:14:01.86,Attack,,0,0,0,,...Mitralyöz!Dialogue: 0,0:14:10.16,0:14:13.70,Main,,0,0,0,,Sen de kimsin lanet olası?!Dialogue: 0,0:14:31.46,0:14:32.55,Main,,0,0,0,,Ne?!Dialogue: 0,0:14:38.37,0:14:42.67,Main,,0,0,0,,D-Dev gibi yarısı gömülü bir adam var!Dialogue: 0,0:14:42.67,0:14:44.54,Main,,0,0,0,,Dev bu!Dialogue: 0,0:14:46.19,0:14:49.78,Main,,0,0,0,,- Çok korkuttunuz. - Onu biz demeliyiz be!Dialogue: 0,0:14:49.78,0:14:53.80,Main,,0,0,0,,İyi misin? Kim yaptı bunu sana?Dialogue: 0,0:14:53.80,0:14:54.95,Main,,0,0,0,,Ne?Dialogue: 0,0:14:54.95,0:14:58.12,Main,,0,0,0,,Bedeninin yarısı gömülü.Dialogue: 0,0:14:58.58,0:15:02.13,Main,,0,0,0,,İstediğim için böyleyim.Dialogue: 0,0:15:02.13,0:15:05.88,Main,,0,0,0,,Ne?! Aptal mısın sen?! Endişelenmemeliydim buna!Dialogue: 0,0:15:06.64,0:15:08.26,Main,,0,0,0,,Bu arada...Dialogue: 0,0:15:09.72,0:15:11.19,Main,,0,0,0,,...meyve suyu istiyorum.Dialogue: 0,0:15:11.19,0:15:12.68,Main,,0,0,0,,Bana ne be?!Dialogue: 0,0:15:14.55,0:15:19.39,Main,,0,0,0,,Chopper, ciddiye alma onu. Seni çıldırtır.Dialogue: 0,0:15:20.50,0:15:23.27,Main,,0,0,0,,Bekle, bekleyin çocuklar!Dialogue: 0,0:15:23.27,0:15:25.23,Main,,0,0,0,,Bir şeyler diyor.Dialogue: 0,0:15:25.23,0:15:26.73,Main,,0,0,0,,Görmezden gel.Dialogue: 0,0:15:27.87,0:15:31.45,Main,,0,0,0,,En çok elma suyu severim.Dialogue: 0,0:15:31.45,0:15:34.12,Main,,0,0,0,,- Ne yapayım yani?! - Görmezden gel.Dialogue: 0,0:15:34.12,0:15:39.77,Main,,0,0,0,,Sola giderseniz elma suyu şelalesi var.Dialogue: 0,0:15:39.77,0:15:42.33,Main,,0,0,0,,Ben çok severim.Dialogue: 0,0:15:42.33,0:15:46.89,Main,,0,0,0,,Luffy'nin dediğini hatırlasana. Sanji-kun'u aramalıyız.Dialogue: 0,0:15:48.48,0:15:51.26,Main,,0,0,0,,Rüya mı bu?Dialogue: 0,0:15:51.94,0:15:55.97,Main,,0,0,0,,Birisini arıyorsunuz değil mi? Bu taraftan gitti.Dialogue: 0,0:15:55.97,0:15:58.22,Main,,0,0,0,,Ne? Sanji mi?Dialogue: 0,0:15:58.22,0:16:01.81,Main,,0,0,0,,Takma diyorum ya sana!Dialogue: 0,0:16:01.81,0:16:06.40,Main,,0,0,0,,Elma suyu getirirseniz kim olduğunu söylerim.Dialogue: 0,0:16:06.40,0:16:07.86,Main,,0,0,0,,Tamam, tamam.Dialogue: 0,0:16:11.49,0:16:14.03,Main,,0,0,0,,Dikkat edin! Nami! Chopper!Dialogue: 0,0:16:31.20,0:16:32.13,Main,,0,0,0,,Tavşan mı?Dialogue: 0,0:16:35.43,0:16:37.10,Main,,0,0,0,,Olamaz! Kaçalım!Dialogue: 0,0:16:59.11,0:17:05.25,Main,,0,0,0,,Konuşan ağaçlardan ve timsahtan sonra bizi öldürmeye çalışan bir tavşan var şimdi.Dialogue: 0,0:17:05.25,0:17:09.28,Main,,0,0,0,,Çok tuhaf bir yer burası. Luffy'nin yanına dönelim.Dialogue: 0,0:17:09.28,0:17:12.09,Main,,0,0,0,,Hala yolu biliyoruz.Dialogue: 0,0:17:12.09,0:17:14.07,Main,,0,0,0,,Peki ya Sanji?Dialogue: 0,0:17:14.07,0:17:17.31,Main,,0,0,0,,Gerçek olup olmadığından bile emin değiliz ki!Dialogue: 0,0:17:18.18,0:17:21.72,Main,,0,0,0,,Sonunda birbirimizi görmüştük ama kılını bile kıpırdatmadı!Dialogue: 0,0:17:21.72,0:17:24.11,Main,,0,0,0,,Hiçbir şey de demedi!Dialogue: 0,0:17:25.01,0:17:26.27,Main,,0,0,0,,Evet.Dialogue: 0,0:17:26.27,0:17:29.36,Main,,0,0,0,,Gerçek Sanji-kun olsaydı...Dialogue: 0,0:17:29.36,0:17:32.61,Main,,0,0,0,,...öylece durup seyirci kalır mıydı yani?Dialogue: 0,0:17:32.61,0:17:34.94,Main,,0,0,0,,Anlıyorum, geri dönelim.Dialogue: 0,0:17:36.74,0:17:38.84,Main,,0,0,0,,İbreler...Dialogue: 0,0:17:39.45,0:17:41.74,Main,,0,0,0,,Bakın! Saat de öyle!Dialogue: 0,0:17:48.17,0:17:51.21,Main,,0,0,0,,Bu ormandaki her şey tuhaflığın daniskası!Dialogue: 0,0:18:17.03,0:18:18.64,Lyrics,,0,0,0,,♪ Duydunuz mu? ♪Dialogue: 0,0:18:18.64,0:18:20.28,Lyrics,,0,0,0,,♪ Duyduk ♪Dialogue: 0,0:18:20.28,0:18:23.58,Lyrics,,0,0,0,,♪ Kıpırdayın ♪Dialogue: 0,0:18:23.58,0:18:26.78,Lyrics,,0,0,670,,♪ Ağaç, ağaç, ağaç, ağaç ♪Dialogue: 0,0:18:23.58,0:18:30.21,Special-Captions,,0,0,290,,Whole Cake Adası, Güneybatı Kıyısı Ayartan OrmanDialogue: 0,0:18:26.78,0:18:30.21,Lyrics,,0,0,670,,♪ Kapatın yollarını ♪Dialogue: 0,0:18:30.21,0:18:36.59,Lyrics,,0,0,0,,♪ Çiçek! Çiçek! Çiçek! ♪Dialogue: 0,0:18:36.59,0:18:39.68,Lyrics,,0,0,0,,♪ Oynayalım ♪Dialogue: 0,0:18:39.68,0:18:43.06,Lyrics,,0,0,0,,♪ Ölüm oyunu oynayalım ♪Dialogue: 0,0:18:47.43,0:18:51.65,Main,,0,0,0,,- Chopper, daha hızlı gidemez misin?! - Daha fazlasını yapamam!Dialogue: 0,0:18:52.00,0:18:53.15,Main,,0,0,0,,Geliyor mu?Dialogue: 0,0:18:53.15,0:18:55.65,Main,,0,0,0,,Evet, hala arkamızda!Dialogue: 0,0:18:55.65,0:18:58.18,Main,,0,0,0,,Mümkün olduğunca çabuk şekilde bu ormandan çıkmalıyız!Dialogue: 0,0:18:58.18,0:18:58.82,Main,,0,0,0,,Aynen!Dialogue: 0,0:18:58.82,0:19:01.32,Main,,0,0,0,,Bu tavşan oldukça güçlü!Dialogue: 0,0:19:03.78,0:19:06.16,Main,,0,0,0,,Mink değil ama!Dialogue: 0,0:19:06.16,0:19:07.22,Main,,0,0,0,,Emin misin?Dialogue: 0,0:19:07.22,0:19:08.50,Main,,0,0,0,,Şeytan Meyvesi kullanıcısı mı?Dialogue: 0,0:19:11.83,0:19:12.96,Lyrics,,0,0,0,,♪ Fark ettiler ♪Dialogue: 0,0:19:12.96,0:19:18.17,Lyrics,,0,0,0,,♪ Hasır Şapka tayfası fark etti ♪Dialogue: 0,0:19:18.17,0:19:20.01,Lyrics,,0,0,0,,♪ Bizi ♪Dialogue: 0,0:19:20.01,0:19:23.22,Lyrics,,0,0,0,,♪ Fark etmediler ♪ ♪ Bir tuhaflık var ♪Dialogue: 0,0:19:23.22,0:19:24.64,Lyrics,,0,0,0,,♪ Fark ettiler ♪Dialogue: 0,0:19:24.64,0:19:27.97,Lyrics,,0,0,0,,♪ Brûlée-sama... ♪ ♪ ...oynuyor onlarla ♪Dialogue: 0,0:19:27.97,0:19:30.90,Lyrics,,0,0,0,,♪ Hangisini avlayacak? ♪Dialogue: 0,0:19:30.90,0:19:37.61,Lyrics,,0,0,0,,♪ Sularını çıkarsak ne de lezzetli olur ♪Dialogue: 0,0:20:03.13,0:20:05.55,Main,,0,0,0,,Bakın! Elektro kullanamıyor!Dialogue: 0,0:20:06.80,0:20:08.61,Main,,0,0,0,,Al bakalım!Dialogue: 0,0:20:09.60,0:20:12.52,Main,,0,0,0,,- Carrot! Uzaklaşma! - Tamam!Dialogue: 0,0:20:12.52,0:20:14.27,Main,,0,0,0,,Üzgünüm, Kuş-san!Dialogue: 0,0:20:15.03,0:20:15.69,Main,,0,0,0,,T...Dialogue: 0,0:20:15.69,0:20:18.11,Main,,0,0,0,,Turna!Dialogue: 0,0:20:18.21,0:20:22.64,Captions,,0,0,0,,Randolph – Turna Binicisi Big Mom KorsanlarıDialogue: 0,0:20:30.61,0:20:32.75,Main,,0,0,0,,- Silah... - Bize doğru geliyor!Dialogue: 0,0:20:47.87,0:20:51.81,Narrator,,0,0,0,,Big Mom'un kalesi, Whole Cake Chateau.Dialogue: 0,0:20:52.23,0:20:56.19,Narrator,,0,0,0,,Arkasındaki göle ise Aprico Gölü deniyor.Dialogue: 0,0:21:04.40,0:21:08.37,Main,,0,0,0,,Germa gemisi konuşuyor! Limana giriş izni istiyorum!Dialogue: 0,0:21:08.37,0:21:10.71,Main,,0,0,0,,Devam!Dialogue: 0,0:21:12.04,0:21:15.42,Narrator,,0,0,0,,Big Mom'un ast korsanları...Dialogue: 0,0:21:15.42,0:21:20.21,Narrator,,0,0,0,,...ve yakında ast olacakların limana girmesine izin verilir.Dialogue: 0,0:21:20.21,0:21:22.92,Main,,0,0,0,,Devam edin! Devam edin!Dialogue: 0,0:21:35.64,0:21:38.48,Main,,0,0,0,,Devam edin! Devam edin!Dialogue: 0,0:21:38.48,0:21:41.40,Main,,0,0,0,,Tamam, durun oradan!Dialogue: 0,0:21:41.40,0:21:43.87,Main,,0,0,0,,Çarpmamak için bağlanın.Dialogue: 0,0:21:52.51,0:21:54.25,Narrator,,0,0,0,,Germa...Dialogue: 0,0:21:54.25,0:21:59.84,Narrator,,0,0,0,,...kendi toprakları olmayan tek deniz krallığının adıydı.Dialogue: 0,0:22:00.42,0:22:03.12,Narrator,,0,0,0,,Birkaç düzine gemisi genellikle bağımsız olarak seyahat ederdi....Dialogue: 0,0:22:03.12,0:22:07.93,Narrator,,0,0,0,,...lakin nadir de olsa krallığın şeklini oluşturmak için bazen bir araya gelirlerdi.Dialogue: 0,0:22:17.52,0:22:21.65,Narrator,,0,0,0,,Zamanında zorla Kuzey Mavi'ye hükmetmiş bu ülke...Dialogue: 0,0:22:21.65,0:22:24.87,Narrator,,0,0,0,,...Vinsmoke Ailesi tarafından yönetilirdi.Dialogue: 0,0:22:24.87,0:22:27.94,Narrator,,0,0,0,,Burası Germa Krallığı.Dialogue: 0,0:22:27.94,0:22:33.50,Narrator,,0,0,0,,Orduları Germa 66 ise hala dünyaca tehdit olarak kabul edilir.Dialogue: 0,0:22:33.50,0:22:38.12,Narrator,,0,0,0,,Vatandaşların çoğu erkeklerden ve askerlerden oluşur.Dialogue: 0,0:22:48.30,0:22:52.97,Narrator,,0,0,0,,Aralarında antrenman yapmadıkları bir gün bile yoktur.Dialogue: 0,0:23:07.07,0:23:10.00,Main,,0,0,0,,Daha ne kadar duracaksın?Dialogue: 0,0:23:10.91,0:23:13.37,Main,,0,0,0,,13 yıldır...Dialogue: 0,0:23:13.37,0:23:16.24,Main,,0,0,0,,...seni hiç görmemiş ablana bu mu denir?Dialogue: 0,0:23:21.67,0:23:23.75,Main,,0,0,0,,Kaç kez diyeceğim daha?Dialogue: 0,0:23:23.75,0:23:27.96,Main,,0,0,0,,Ailemle olan bağlarımı kestiğimi açıkça belirttim!Dialogue: 0,0:23:27.96,0:23:32.47,Main,,0,0,0,,Böyle zevksiz bir resmi koyacak kadar da çıldırmış olmalısınız.Dialogue: 0,0:23:46.40,0:23:50.85,Main,,0,0,0,,Kuzey Mavi'nin 4 kralının devrildiği büyük olay.Dialogue: 0,0:23:50.85,0:23:52.92,Main,,0,0,0,,Dört Ulusun Fethi.Dialogue: 0,0:23:54.28,0:24:00.42,Main,,0,0,0,,Babam Kuzey Mavi'yi yine Germa kontrolü altına almayı planlıyor.Dialogue: 0,0:24:01.12,0:24:02.68,Main,,0,0,0,,Bunun neresi yanlış?Dialogue: 0,0:24:02.68,0:24:06.29,Main,,0,0,0,,Bir erkeğin güç ve şöhret istemesi çok normal.Dialogue: 0,0:24:07.12,0:24:10.67,Main,,0,0,0,,Küçük aptal bir korsan grubu içerisinde yer almaktansa...Dialogue: 0,0:24:10.67,0:24:14.27,Main,,0,0,0,,...imtiyazlı kraliyet ailesi mensubu olmanın neden tadını çıkarmıyorsun?Dialogue: 0,0:24:14.80,0:24:16.51,Main,,0,0,0,,Saçmalama.Dialogue: 0,0:24:16.51,0:24:21.85,Main,,0,0,0,,Bak, isteklerini gerçekleştirmeyi bekleyen 10 hizmetçi de var.Dialogue: 0,0:24:21.85,0:24:24.81,Main,,0,0,0,,Çekinmeyin Prensim.Dialogue: 0,0:24:25.98,0:24:27.27,Main,,0,0,0,,Çok güzel!Dialogue: 0,0:24:27.27,0:24:29.86,Main,,0,0,0,,Hepsi kraliyet kanı taşıdığın için.Dialogue: 0,0:24:29.86,0:24:35.78,Main,,0,0,0,,Birliklerimizi savaşan ülkelere gönderirsek asla para sıkıntısı çekmeyiz.Dialogue: 0,0:24:35.78,0:24:38.28,Main,,0,0,0,,Bizzat savaşman da gerekmiyor.Dialogue: 0,0:24:39.57,0:24:41.50,Main,,0,0,0,,Kulağa hoş gelmiyor mu?Dialogue: 0,0:24:42.93,0:24:49.06,Main,,0,0,0,,Biz Vinsmoke Ailesi her zaman birliklerimiz sayesinde güç elde etmişizdir.Dialogue: 0,0:24:50.67,0:24:53.41,Main,,0,0,0,,Senin damarlarında da bu kan akıyor.Dialogue: 0,0:24:53.41,0:24:55.26,Main,,0,0,0,,Çok da umurumda.Dialogue: 0,0:24:55.26,0:24:57.21,Main,,0,0,0,,Onunla evlenmeyeceğim!Dialogue: 0,0:24:57.21,0:25:00.56,Main,,0,0,0,,Pudding iyi bir kız değil mi? Onu sevdim.Dialogue: 0,0:25:02.14,0:25:04.14,Main,,0,0,0,,Başkomutanım, nereye gidiyorsunuz?Dialogue: 0,0:25:04.14,0:25:06.27,Main,,0,0,0,,Sanji'yi göreceğim.Dialogue: 0,0:25:06.27,0:25:07.77,Main,,0,0,0,,Yoluma çıkma.Dialogue: 0,0:25:21.24,0:25:24.04,Main,,0,0,0,,Baba-sama, neden buradasınız?Dialogue: 0,0:25:26.08,0:25:31.67,Captions,,0,0,0,,Vinsmoke Judge – Germa Krallığı Kralı Germa 66 BaşkomutanıDialogue: 0,0:25:31.67,0:25:33.88,Main,,0,0,0,,Hala mızmızlanıyor musun?Dialogue: 0,0:25:34.47,0:25:36.30,Main,,0,0,0,,Seni...Dialogue: 0,0:25:41.60,0:25:43.89,Main,,0,0,0,,Serseri oğlum.Dialogue: 0,0:25:43.89,0:25:45.69,Main,,0,0,0,,Bana öyle hitap etme.Dialogue: 0,0:25:45.69,0:25:49.27,Main,,0,0,0,,Birisine baba diyecek olsam bile o sen olmazsın!Dialogue: 0,0:25:53.62,0:25:58.91,Main,,0,0,0,,Yonji'ye ne yaptın? Çok güçlüdür o.Dialogue: 0,0:25:58.91,0:26:01.37,Main,,0,0,0,,Artık ondan daha güçlüyüm!Dialogue: 0,0:26:08.67,0:26:11.34,Main,,0,0,0,,Gel bakalım dışarı.Dialogue: 0,0:26:12.60,0:26:15.92,Main,,0,0,0,,Erkekler yumruklarıyla konuşmalıdır.Dialogue: 0,0:26:20.72,0:26:23.85,Captions,,0,0,0,,Ayartan OrmanDialogue: 0,0:26:24.77,0:26:27.14,Main,,0,0,0,,Chopper! Carrot! Savuşturun!Dialogue: 0,0:26:27.14,0:26:28.23,Main,,0,0,0,,Tamam!Dialogue: 0,0:26:31.15,0:26:34.18,Main,,0,0,0,,Arkamda neler olu--Dialogue: 0,0:26:34.18,0:26:36.22,Main,,0,0,0,,Olamaz!Dialogue: 0,0:26:37.20,0:26:38.24,Main,,0,0,0,,Ha?!Dialogue: 0,0:26:38.24,0:26:40.66,Main,,0,0,0,,Onunla yolumuzu bulabiliriz.Dialogue: 0,0:26:40.66,0:26:44.83,Main,,0,0,0,,Siz o zamankilersiniz.Dialogue: 0,0:26:50.74,0:26:52.71,Main,,0,0,0,,Lolipop tarlası!Dialogue: 0,0:26:52.71,0:26:56.17,Main,,0,0,0,,Luffy'ye ulaşmamıza az kaldı!Dialogue: 0,0:26:57.51,0:27:01.01,Main,,0,0,0,,Seni adi! Çekil önümden!Dialogue: 0,0:27:05.81,0:27:08.77,Main,,0,0,0,,- Hala dövüşüyor! - Luffy!Dialogue: 0,0:27:08.77,0:27:10.98,Main,,0,0,0,,Kıyıya geri dönelim!Dialogue: 0,0:27:11.42,0:27:13.98,Main,,0,0,0,,Ne? Siz neden buradasınız?Dialogue: 0,0:27:13.98,0:27:16.78,Main,,0,0,0,,Acele et! Sonra anlatırım!Dialogue: 0,0:27:16.78,0:27:19.36,Main,,0,0,0,,Bu orman ürkütücü tuzaklarla dolu!Dialogue: 0,0:27:19.86,0:27:21.36,Main,,0,0,0,,Pekala!Dialogue: 0,0:27:23.37,0:27:25.00,Main,,0,0,0,,Peşimizde birisi var!Dialogue: 0,0:27:25.00,0:27:27.20,Main,,0,0,0,,Hemen ormandan çıkalım!Dialogue: 0,0:27:35.71,0:27:38.67,Main,,0,0,0,,Konuşan timsahı gördüğümüz nehir bu!Dialogue: 0,0:27:38.67,0:27:42.70,Main,,0,0,0,,Doğru hatırlıyorsam nehri geçersek dışarı çıkabiliriz!Dialogue: 0,0:27:42.70,0:27:45.43,Main,,0,0,0,,Üstünden atlayalım!Dialogue: 0,0:27:45.43,0:27:48.14,Main,,0,0,0,,İşte gidiyoruz!Dialogue: 0,0:27:50.02,0:27:53.98,Main,,0,0,0,,Bekleyin çocuklar! O gerçek ben--Dialogue: 0,0:27:53.98,0:27:56.19,Main,,0,0,0,,Bir şey mi dedin Luffy?Dialogue: 0,0:27:56.19,0:27:57.36,Main,,0,0,0,,Hayır, demedim.Dialogue: 0,0:28:01.36,0:28:05.20,Main,,0,0,0,,Millet! Durmadan koşalım böyle!Dialogue: 0,0:28:05.20,0:28:06.33,Main,,0,0,0,,Tamamdır!Dialogue: 0,0:28:07.21,0:28:08.62,Main,,0,0,0,,Sanji'ye ne oldu?Dialogue: 0,0:28:08.62,0:28:13.06,Main,,0,0,0,,Bizden kaçtı ve geri dönmedi.Dialogue: 0,0:28:13.06,0:28:17.63,Main,,0,0,0,,Sanji-kun gibi görünmesine rağmen bir tuhaflık vardı.Dialogue: 0,0:28:17.63,0:28:20.09,Main,,0,0,0,,Dışarı çıkınca konuşuruz Nami!Dialogue: 0,0:28:20.09,0:28:23.13,Main,,0,0,0,,Evet! Çok şükür yolu hala biliyoruz!Dialogue: 0,0:28:23.63,0:28:25.68,Main,,0,0,0,,Birazdan kıyıya ulaşırız!Dialogue: 0,0:28:25.68,0:28:26.68,Main,,0,0,0,,Evet!Dialogue: 0,0:28:31.18,0:28:33.35,Main,,0,0,0,,- Ne? - Bu da ne?Dialogue: 0,0:28:39.23,0:28:42.61,Main,,0,0,0,,Ne?! Nasıl?!Dialogue: 0,0:28:42.61,0:28:46.07,Main,,0,0,0,,Yine geldiniz.Dialogue: 0,0:28:46.07,0:28:49.33,Main,,0,0,0,,Az önce arkama saplanan şeyi çıkarabilir--Dialogue: 0,0:28:49.33,0:28:53.50,Main,,0,0,0,,Geldiğimiz yoldan geri dönmüştük ama!Dialogue: 0,0:28:53.50,0:28:56.58,Main,,0,0,0,,Neden buradasın be?!Dialogue: 0,0:28:57.36,0:29:01.30,Main,,0,0,0,,Bağırmayın, korkutuyorsunuz.Dialogue: 0,0:29:01.30,0:29:08.01,Main,,0,0,0,,Neden buradayım mı dedin? Ben hep buradaydım.Dialogue: 0,0:29:08.01,0:29:13.82,Main,,0,0,0,,Sizler gittiniz ve geri döndünüz.Dialogue: 0,0:29:13.82,0:29:16.94,Main,,0,0,0,,- Chopper, bir kez daha deneyelim! - Tamam!Dialogue: 0,0:29:17.81,0:29:21.73,Main,,0,0,0,,Kafamın arkasındakini çıkarsanıza!Dialogue: 0,0:29:26.20,0:29:28.57,Main,,0,0,0,,Lolipop tarlasını geçiyoruz.Dialogue: 0,0:29:34.58,0:29:36.62,Main,,0,0,0,,Timsahın olduğu nehirden atlıyoruz.Dialogue: 0,0:29:40.42,0:29:42.51,Main,,0,0,0,,Bu sefer kıyıya çıkmalıyız!Dialogue: 0,0:29:47.59,0:29:49.51,Main,,0,0,0,,Çok korkuttunuz!Dialogue: 0,0:29:50.01,0:29:52.81,Main,,0,0,0,,Neden hep buraya dönüyorsunuz?Dialogue: 0,0:29:52.81,0:29:57.90,Main,,0,0,0,,Yine mi?! Seyir Pusulası düzgün çalışmasa bile...Dialogue: 0,0:29:57.90,0:30:02.07,Main,,0,0,0,,...basit bir yol olduğundan yönlere ihtiyacımız yok.Dialogue: 0,0:30:04.66,0:30:06.65,Main,,0,0,0,,Bu taraftan düz gidersek...Dialogue: 0,0:30:06.65,0:30:10.28,Main,,0,0,0,,~ Yavaşça... Yavaşça... ~Dialogue: 0,0:30:12.48,0:30:13.41,Main,,0,0,0,,Eyvah.Dialogue: 0,0:30:13.88,0:30:15.25,Main,,0,0,0,,Çiçek?!Dialogue: 0,0:30:15.25,0:30:18.12,Main,,0,0,0,,Ne?! Ağaçlar ve çiçekler hareket ediyor!Dialogue: 0,0:30:18.12,0:30:20.75,Main,,0,0,0,,Bir, iki! Bir, iki!Dialogue: 0,0:30:20.75,0:30:23.42,Main,,0,0,0,,Toprak hareket ediyor ve konuşuyor!Dialogue: 0,0:30:24.17,0:30:25.42,Main,,0,0,0,,Neler oluyor?Dialogue: 0,0:30:25.42,0:30:28.72,Main,,0,0,0,,Bunlar da ne? Bu ormanın neyi var?Dialogue: 0,0:30:28.72,0:30:31.97,Main,,0,0,0,,- Buldular! - Buldular!Dialogue: 0,0:30:31.97,0:30:35.72,Lyrics,,0,0,0,,♪ Çiçek! ♪Dialogue: 0,0:30:35.72,0:30:39.48,Main,,0,0,0,,Başından beri yol yoktu.Dialogue: 0,0:30:40.31,0:30:43.40,Main,,0,0,0,,Sonunda fark ettiniz...Dialogue: 0,0:30:43.40,0:30:45.80,Main,,0,0,0,,...bu ormanın dehşetini!Dialogue: 0,0:30:45.80,0:30:48.24,Main,,0,0,0,,Beklesene Luffy, ne yapıyorsun?Dialogue: 0,0:30:48.80,0:30:52.66,Main,,0,0,0,,Burası Ayartan Orman.Dialogue: 0,0:30:52.66,0:30:54.87,Main,,0,0,0,,Nami! O Luffy değil!Dialogue: 0,0:31:06.42,0:31:08.38,Main,,0,0,0,,Sen de kimsin be?!Dialogue: 0,0:31:08.80,0:31:10.64,Main,,0,0,0,,Kim miyim?Dialogue: 0,0:31:14.42,0:31:18.06,Main,,0,0,0,,Her zaman yanınızdaydım.Dialogue: 0,0:31:19.04,0:31:23.65,Main,,0,0,0,,Ne kadar denerseniz deneyin asla bu ormandan çıkamayacaksınız!Dialogue: 0,0:31:24.92,0:31:26.79,Main,,0,0,0,,Asla...Dialogue: 0,0:31:26.79,0:31:29.32,Main,,0,0,0,,Ölene dek!Dialogue: 0,0:31:29.32,0:31:31.48,Main,,0,0,0,,Bırak beni!Dialogue: 0,0:31:31.48,0:31:35.48,Main,,0,0,0,,Sakin dur genç hanım.Dialogue: 0,0:31:35.48,0:31:39.62,Main,,0,0,0,,Yüzümdeki yaraya baksana.Dialogue: 0,0:31:36.23,0:31:41.21,Captions,,0,0,0,,Charlotte Brûlée Charlotte Ailesinin 8. KızıDialogue: 0,0:31:39.62,0:31:41.21,Main,,0,0,0,,Korkunç değil mi?Dialogue: 0,0:31:41.21,0:31:43.67,Main,,0,0,0,,Sen de kimsin-teia?! Ağaç mısın?!Dialogue: 0,0:31:43.67,0:31:47.05,Main,,0,0,0,,Ağaç değilim be! Brûlée'yim!Dialogue: 0,0:31:47.05,0:31:48.65,Main,,0,0,0,,Brûlée?Dialogue: 0,0:31:48.65,0:31:53.72,Main,,0,0,0,,Tatlı bir tavşan ve tatlı bir kız...Dialogue: 0,0:31:53.72,0:32:00.18,Main,,0,0,0,,Ne kadar da güzel. Böyle güzel yüzleri görünce...Dialogue: 0,0:32:01.73,0:32:05.31,Main,,0,0,0,,...parçalayasım geliyor!Dialogue: 0,0:32:08.77,0:32:13.80,Credits,,0,0,0,,Editing:  Feeso, Galaxy 9000  Timing: Halee, Sewil (Opening)  Quality Assurance: Feeso Galaxy 9000, Grug, Pepperjack  Soundtracking:  Halee  Graphics:  Datenshi, Yibis (Karaoke)  Translation: Crunchyroll, Yibis (Opening)Dialogue: 0,0:00:00.82,0:00:06.82,Lyrics,,0,0,0,karaoke,♪ Görmedim dünyanın sonunu kendi gözlerimle hiç. ♪Dialogue: 0,0:00:06.82,0:00:13.95,Lyrics,,0,0,0,karaoke,♪ O yüzden çıktım yola sizinle, bunu yapmak için! ♪Dialogue: 0,0:00:23.67,0:00:27.00,Lyrics,,0,0,0,karaoke,♪ Bir denizden diğerine yol alırken,...Dialogue: 0,0:00:29.06,0:00:31.91,Lyrics,,0,0,0,karaoke,...bunun sadece bir peri masalı olduğunu söylemek. ♪Dialogue: 0,0:00:31.92,0:00:38.78,Lyrics,,0,0,0,karaoke,♪ Gerçek, kurgudan daha tuhaf değil mi? ♪Dialogue: 0,0:00:39.94,0:00:43.56,Lyrics,,0,0,0,karaoke,♪ Fakat sırt çevirme hiçbirine ♪Dialogue: 0,0:00:43.56,0:00:50.04,Lyrics,,0,0,0,karaoke,♪ Sağduyu dedikleri zihnidir toplulukların! ♪Dialogue: 0,0:00:51.36,0:00:57.41,Lyrics,,0,0,0,karaoke,♪ Görmedim dünyanın sonunu kendi gözlerimle hiç. ♪Dialogue: 0,0:00:57.41,0:01:01.96,Lyrics,,0,0,0,karaoke,♪ O yüzden gitmemiz lazım Kaptan Özgür-Ruh! ♪Dialogue: 0,0:01:01.96,0:01:04.72,Lyrics,,0,0,0,karaoke,♪ Kim demiş imkansız diye,...Dialogue: 0,0:01:04.71,0:01:07.89,Lyrics,,0,0,0,karaoke,...daha hiçbir şey başlamadan! ♪Dialogue: 0,0:01:07.88,0:01:12.72,Lyrics,,0,0,0,karaoke,♪ Her şeyi bilmek istiyorum ve şimdi bilebiliriz de... ♪Dialogue: 0,0:01:12.72,0:01:18.68,Lyrics,,0,0,0,karaoke,♪ Bilebiliriz, bilebilirsin! Şu anda... ♪Dialogue: 0,0:01:19.06,0:01:24.10,Lyrics,,0,0,0,karaoke,♪ Bilebiliriz, bilebilirim! Bu harika hissi... ♪Dialogue: 0,0:01:24.39,0:01:31.32,Lyrics,,0,0,0,karaoke,♪ Hemen, şimdi, bilebiliriz! ♪Dialogue: 0,0:01:37.34,0:01:38.64,Lyrics,,0,0,0,karaoke,♪ Evet, bilebiliriz! ♪