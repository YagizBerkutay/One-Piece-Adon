,&H00000000,0,0,0,0,95,100,1,0,1,2.2,0,7,10,10,10,1Style: Author,Impress BT,20.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.7,0.7,9,10,10,10,1Style: Attack,Duality,30.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.0,1.0,7,12,12,12,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:01:41.84,0:01:45.65,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:14:17.50,0:14:27.50,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:31:00.75,0:31:03.75,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:01:41.84,0:01:45.65,Title,,0,0,240,,Dünya HareketleniyorDialogue: 0,0:01:45.87,0:01:49.40,Captions,,0,0,240,,Arabasta Kum ÜlkesiDialogue: 0,0:01:54.62,0:01:56.01,Main,,0,0,0,,İleri!Dialogue: 0,0:02:05.31,0:02:06.60,Main,,0,0,0,,O kız...Dialogue: 0,0:02:08.09,0:02:09.74,Main,,0,0,0,,Vivi-sama bu!Dialogue: 0,0:02:09.74,0:02:11.37,Main,,0,0,0,,İyi yolculuklar!Dialogue: 0,0:02:11.37,0:02:12.79,Main,,0,0,0,,Vivi-sama!Dialogue: 0,0:02:12.79,0:02:14.76,Main,,0,0,0,,Majesteleri!Dialogue: 0,0:02:22.08,0:02:23.58,Main,,0,0,0,,Hey, Koza.Dialogue: 0,0:02:24.53,0:02:27.32,Main,,0,0,0,,Vivi-chan epey heyecanlı gibiydi.Dialogue: 0,0:02:27.32,0:02:30.18,Main,,0,0,0,,Korsan ruhu canlanmıştır kesin.Dialogue: 0,0:02:30.18,0:02:32.54,Main,,0,0,0,,Sonunda biraz olsun prenses gibi davranmaya başladı derken...Dialogue: 0,0:02:36.34,0:02:40.22,Main,,0,0,0,,Evet, Hina ben. Arabasta'dan az önce ayrıldık.Dialogue: 0,0:02:40.22,0:02:44.62,Main,,0,0,3,,Nefertari Ailesi'ni sağ salim Mariejoa'ya ulaştıracağız.Dialogue: 0,0:02:40.72,0:02:45.47,Captions,,0,0,240,,Donanma Karargahı Tuğamirali "Kara Kafes" HinaDialogue: 0,0:02:44.62,0:02:47.46,Main,,0,0,3,,Hina-sama, size çiçek getirdim!Dialogue: 0,0:02:47.46,0:02:49.48,Main,,0,0,0,,Sizin için kendi ellerimle topladım!Dialogue: 0,0:02:49.48,0:02:50.86,Main,,0,0,0,,İstemiyorum.Dialogue: 0,0:02:51.40,0:02:54.90,Main,,0,0,0,,Django, Fullbody! Derhal yerlerinize geçin!Dialogue: 0,0:02:54.90,0:02:56.27,Main,,0,0,0,,Emredersiniz!Dialogue: 0,0:02:58.07,0:03:01.14,Main,,0,0,0,,Vivi-sama! Vivi-sama!Dialogue: 0,0:03:02.69,0:03:06.42,Main,,0,0,0,,Orası tehlikeli Vivi-sama!Dialogue: 0,0:03:06.42,0:03:09.48,Main,,0,0,3,,Lütfen o tehlikeli yerden derhal inin!Dialogue: 0,0:03:07.20,0:03:11.83,Captions,,0,0,240,,Arabasta Krallığı Prensesi Nefertari ViviDialogue: 0,0:03:09.48,0:03:11.92,Main,,0,0,3,,Vivi-sama!Dialogue: 0,0:03:12.78,0:03:15.27,Main,,0,0,0,,Rüzgar ne güzel esiyor!Dialogue: 0,0:03:15.27,0:03:19.97,Main,,0,0,0,,Tuhaf bir kuş gelip sizi kaçırırsa ne yapacaksınız?!Dialogue: 0,0:03:19.97,0:03:25.92,Main,,0,0,0,,Keskin nişancının biri uzaklardan sizi hedef alıyorsa, yahut göklerden meteor falan düşerse çok kötü olur!Dialogue: 0,0:03:25.92,0:03:27.38,Main,,0,0,0,,Boşa endişeleniyorsun.Dialogue: 0,0:03:28.18,0:03:30.16,Main,,0,0,0,,Vivi-sama bir zamanlar korsandı.Dialogue: 0,0:03:31.95,0:03:36.08,Main,,0,0,0,,Donanma dibimizdeyken neler söylüyorsun sen Pell, delirdin mi?!Dialogue: 0,0:03:38.69,0:03:41.48,Main,,0,0,0,,Kendinizi fazla zorlamayın, Majesteleri.Dialogue: 0,0:03:41.48,0:03:45.10,Main,,0,0,0,,İyi hissetmiyorsanız derhal geri dönebiliriz.Dialogue: 0,0:03:45.10,0:03:48.22,Main,,0,0,0,,Bir şeyim yok.Dialogue: 0,0:03:48.74,0:03:56.13,Main,,0,0,3,,Nico Robin'le tanıştığım o günden beri  Dünya Hükümeti'ne sormak istediğim bir soru var kafamda.Dialogue: 0,0:03:50.41,0:03:56.13,Captions,,0,0,240,,Arabasta Krallığı Kralı Nefertari CobraDialogue: 0,0:03:56.53,0:03:59.32,Flashbacks,,0,0,0,,Tek isteğim tarihi öğrenmekti...Dialogue: 0,0:04:01.32,0:04:05.05,Flashbacks,,0,0,0,,Hayallerimin önünde çok fazla düşman var...Dialogue: 0,0:04:05.55,0:04:07.54,Main,,0,0,0,,Ponegliflerle alakalı mı?Dialogue: 0,0:04:09.20,0:04:13.83,Main,,0,0,0,,Gerçekleşecek Reverie'ye ne pahasına olursa olsun katılacağım!Dialogue: 0,0:04:13.83,0:04:16.28,Main,,0,0,0,,Mümkünse yıllar önce...Dialogue: 0,0:04:16.28,0:04:21.42,Main,,0,0,0,,...o zamanki Nefertari Ailesi Kralı'nın dünyaya ne yaptığını bilmek istiyorum.Dialogue: 0,0:04:26.37,0:04:27.85,Main,,0,0,0,,Eyvah! Eyvah!Dialogue: 0,0:04:27.85,0:04:30.15,Main,,0,0,0,,Eyvah! Eyvaöeh...Dialogue: 0,0:04:41.39,0:04:44.99,Main,,0,0,0,,Yeter ama artık Vivi-sama!Dialogue: 0,0:04:50.39,0:04:52.73,Main,,0,0,0,,Baba, nasıl oldun?Dialogue: 0,0:04:53.65,0:04:58.02,Main,,0,0,0,,Pek iyi değilim. Artık fazla zamanım kalmadı sanırım.Dialogue: 0,0:04:58.02,0:05:01.15,Main,,0,0,0,,Ölmeden önce kızımın mürüvvetini görebilseydim...Dialogue: 0,0:05:04.28,0:05:08.10,Main,,0,0,0,,Hiç adil değil ama! Gene hastalığını kullanarak beni kandırmaya çalışıyorsun!Dialogue: 0,0:05:08.12,0:05:11.16,Main,,0,0,0,,Elimizde potansiyel eşlere ait tonla fotoğraf var!Dialogue: 0,0:05:13.55,0:05:14.97,Main,,0,0,0,,Hepsini atacağım!Dialogue: 0,0:05:15.96,0:05:18.67,Captions,,0,0,175,,Doğu Mavi - LoguetownDialogue: 0,0:05:23.16,0:05:26.03,Main,,0,0,0,,Tahta geçişinizi kutlarım efendim.Dialogue: 0,0:05:26.03,0:05:32.68,Main,,0,0,0,,Otelimiz dört yılda bir Reverie'ye giden aileler için özel olarak inşa edilmiştir.Dialogue: 0,0:05:32.68,0:05:35.76,Main,,0,0,0,,Umarım hoşunuza gider.Dialogue: 0,0:05:39.01,0:05:42.73,Main,,0,0,3,,Çok da, pek de hoş değil değil.Dialogue: 0,0:05:39.23,0:05:42.73,Captions,,0,0,240,,Goa Krallığı Kraliçesi Sarie NantokanetteDialogue: 0,0:05:42.73,0:05:44.52,Main,,0,0,0,,Değil mi aşkım?Dialogue: 0,0:05:44.52,0:05:46.36,Main,,0,0,0,,Normal.Dialogue: 0,0:05:46.36,0:05:51.70,Main,,0,0,0,,Gold Roger'ın idam edildiği yer manzarasından başka bir özelliği yok.Dialogue: 0,0:05:51.70,0:05:55.29,Main,,0,0,0,,Öy-Öyleyse yorucu yolculuğunuzun ardından size iyi dinlenmeler.Dialogue: 0,0:05:55.29,0:05:56.77,Main,,0,0,0,,Kral Sterry.Dialogue: 0,0:05:56.77,0:06:00.88,Main,,0,0,0,,Evet, size bakmak bile beni rahatsız ediyor. Yıkılın karşımdan, süprüntüler.Dialogue: 0,0:06:00.88,0:06:02.51,Main,,0,0,0,,Em-Em-Emredersiniz!Dialogue: 0,0:06:12.88,0:06:15.85,Narrator,,0,0,0,,Bütün ülkelerdeki bu ufak hareketliliğin nedeni...Dialogue: 0,0:06:15.85,0:06:18.73,Narrator,,0,0,0,,...dört yılda bir, dünyanın merkezinde bulunan...Dialogue: 0,0:06:18.73,0:06:23.52,Narrator,,0,0,0,,...Kutsal Topraklar Marijoa'da yapılan Reverie'nin gerçekleşecek olması.Dialogue: 0,0:06:25.07,0:06:30.87,Narrator,,0,0,0,,Bu büyük ve önemli toplantıda tüm dünyadan 50 ulusun liderleri bir araya gelecek...Dialogue: 0,0:06:30.87,0:06:38.58,Narrator,,0,0,0,,...ve dünyada meydana gelen olayları tartışıp gelecek için yönergeleri belirleyecekler.Dialogue: 0,0:06:38.58,0:06:47.24,Narrator,,0,0,0,,Fakat her biri tedbirli ve kurnaz olan bu liderler arasında işler hiçbir zaman düzgün ilerlemez.Dialogue: 0,0:06:51.85,0:06:55.62,Main,,0,0,3,,Happosui Ordusu lideri Don Chinjao...Dialogue: 0,0:06:54.85,0:06:59.86,Captions,,0,0,173,,Batı Mavi - Kano KrallığıDialogue: 0,0:06:55.62,0:06:59.86,Main,,0,0,3,,Daha doğrusu yeni lideriniz Sai henüz dönmedi mi?Dialogue: 0,0:06:59.86,0:07:03.61,Main,,0,0,0,,Hasır Şapkalar Donquixote Ailesi'ni devirdiğinden beri...Dialogue: 0,0:07:03.61,0:07:06.82,Main,,0,0,0,,...düşmanımız onlardan silah alamaz oldu.Dialogue: 0,0:07:06.82,0:07:10.15,Main,,0,0,0,,Bu sayede savaş da sona ermiş oldu.Dialogue: 0,0:07:10.15,0:07:13.57,Main,,0,0,0,,Görünüşe bakılırsa Reverie'ye yetişebileceğiz.Dialogue: 0,0:07:15.22,0:07:18.96,Main,,0,0,0,,Söylemek istediğimiz tonla şey var!Dialogue: 0,0:07:18.96,0:07:23.28,Captions,,0,0,240,,Red Line'ın Altındaki Deniz Tabanı Ryugu KrallığıDialogue: 0,0:07:25.60,0:07:27.55,Main,,0,0,0,,Benim için imkansız bu!Dialogue: 0,0:07:27.55,0:07:28.89,Main,,0,0,0,,Korkuyorum!Dialogue: 0,0:07:32.01,0:07:35.86,Main,,0,0,0,,Luffy-sama bana söz verdi.Dialogue: 0,0:07:35.86,0:07:41.98,Main,,0,0,0,,Onunla tekrar karşılaştığımızda beni yüzeydeki gerçek ormana götürecek!Dialogue: 0,0:07:38.47,0:07:41.98,Captions,,0,0,240,,Ryugu Krallığı Prensesi, ShirahoshiDialogue: 0,0:07:41.98,0:07:46.98,Main,,0,0,0,,Luffy-kun'un sizi çok daha ötesine götüreceğine eminim!Dialogue: 0,0:07:46.98,0:07:52.03,Main,,0,0,0,,Fakat bu seferlik doğrudan, yalnızca Mariejoa'ya gitmeniz gerekiyor.Dialogue: 0,0:07:52.03,0:07:57.28,Main,,0,0,0,,Ağabeylerin ve Neptün Ordusu da sizinle gelecek Prenses Shirahoshi!Dialogue: 0,0:07:57.28,0:07:58.85,Main,,0,0,0,,Eyvah ki ne eyvah...Dialogue: 0,0:07:58.85,0:08:04.06,Main,,0,0,3,,Baba, bu seferlik onu götürmesek olmaz mi-re-do?Dialogue: 0,0:08:00.54,0:08:04.06,Captions,,0,0,240,,Ryugu Krallığı Prensi, RyuboshiDialogue: 0,0:08:04.33,0:08:09.71,Captions,,0,0,240,,Ryugu Krallığı Prensi, ManboshiDialogue: 0,0:08:04.06,0:08:07.27,Main,,0,0,3,,Evet! Yapılan ankette Balık Adam Adası'nı...Dialogue: 0,0:08:07.27,0:08:09.56,Main,,0,0,3,,...başka yere taşıyalım diyen tonla kişi vardı!Dialogue: 0,0:08:09.56,0:08:11.46,Main,,0,0,0,,Hey mambo!Dialogue: 0,0:08:11.46,0:08:18.85,Main,,0,0,3,,İnsanlara güvenmiyoruz demekten farkı yok bunun-jamon.Dialogue: 0,0:08:14.09,0:08:18.85,Captions,,0,0,240,,Ryugu Krallığı Kralı, NeptuneDialogue: 0,0:08:18.85,0:08:20.73,Main,,0,0,0,,Ne yapmalıyız?Dialogue: 0,0:08:21.23,0:08:24.72,Captions,,0,0,240,,Ryugu Krallığı Prensi, FukaboshiDialogue: 0,0:08:20.74,0:08:24.72,Main,,0,0,3,,Shirahoshi, Hasır Şapkalar sana ne öğretti?!Dialogue: 0,0:08:24.72,0:08:28.86,Main,,0,0,0,,Annemiz Otohime'nin dört gözle beklediği bir toplantıydı bu.Dialogue: 0,0:08:30.86,0:08:32.53,Main,,0,0,0,,Bizimle gel!Dialogue: 0,0:08:34.54,0:08:37.30,Captions,,0,0,240,,Güney Mavi, Kötücül Kara Drum KrallığıDialogue: 0,0:08:37.30,0:08:39.25,Main,,0,0,0,,Wapol-sama, yeni haberlerim var!Dialogue: 0,0:08:40.45,0:08:46.27,Main,,0,0,0,,Bir zamanlar hüküm sürdüğünüz Drum Krallığı, yeni adıyla Sakura Krallığı...Dialogue: 0,0:08:46.27,0:08:49.55,Main,,0,0,0,,...yeni kral Dalton önderliğinde Reverie'ye katılacakmış!Dialogue: 0,0:08:49.55,0:08:52.39,Main,,0,0,0,,Ne?! Sakura Krallığı mı?!Dialogue: 0,0:08:52.39,0:08:53.97,Main,,0,0,0,,Canı çıkası Dalton...Dialogue: 0,0:08:55.43,0:08:59.44,Main,,0,0,0,,Reverie'de ne yapsam da alaşağı etsem onu?!Dialogue: 0,0:09:01.35,0:09:05.62,Captions,,0,0,240,,Grand Line Sakura KrallığıDialogue: 0,0:09:01.36,0:09:05.62,Main,,0,0,3,,Doğru mu bu Dr Kureha? Bu konuda ciddi misiniz?Dialogue: 0,0:09:05.64,0:09:08.65,Captions,,0,0,240,,Sakura Krallığı Kralı, DaltonDialogue: 0,0:09:05.62,0:09:08.65,Main,,0,0,3,,Neden böyle mutsuz görünüyorsunuz?!Dialogue: 0,0:09:08.65,0:09:11.78,Main,,0,0,0,,Ben de geminizin doktoru olacağım işte!Dialogue: 0,0:09:11.78,0:09:13.82,Main,,0,0,0,,Mutlu olmadın mı?Dialogue: 0,0:09:15.24,0:09:17.80,Captions,,0,0,240,,Tutku Krallığı DressrosaDialogue: 0,0:09:15.24,0:09:17.80,Main,,0,0,3,,Ne?! Ben de gelebilir miyim?!Dialogue: 0,0:09:17.80,0:09:21.29,Main,,0,0,0,,Elbette! Nedimem olarak gelmek ister misin?Dialogue: 0,0:09:21.29,0:09:24.14,Main,,0,0,0,,Evet! Çok teşekkür ederim, Viola-san!Dialogue: 0,0:09:24.14,0:09:26.53,Main,,0,0,0,,Çok sevinçli görünüyorsun Rebecca!Dialogue: 0,0:09:26.53,0:09:27.75,Main,,0,0,0,,Öyleyim!Dialogue: 0,0:09:29.34,0:09:32.85,Main,,0,0,0,,Acaba annemin elbisesini mi giysem?!Dialogue: 0,0:09:34.86,0:09:37.02,Main,,0,0,0,,Evet, harika olur!Dialogue: 0,0:09:38.09,0:09:41.35,Captions,,0,0,175,,Prodence KrallığıDialogue: 0,0:09:41.35,0:09:44.79,Main,,0,0,3,,Kral Riku, Donanma refakâtini reddettim!Dialogue: 0,0:09:42.77,0:09:47.02,Captions,,0,0,240,,Prodence Krallığı Kralı 2. ElizabelloDialogue: 0,0:09:44.79,0:09:47.02,Main,,0,0,3,,Kutsal Topraklar'a birlikte gidelim mi?!Dialogue: 0,0:09:48.31,0:09:54.07,Captions,,0,0,240,,Dressrosa Kralı 3. Riku DoldoDialogue: 0,0:09:48.67,0:09:51.44,Main,,0,0,3,,Nedense herkes bir tatil havasında!Dialogue: 0,0:09:51.44,0:09:52.91,Main,,0,0,3,,Öyle olsa ne olur?Dialogue: 0,0:09:53.78,0:09:57.31,Main,,0,0,3,,Reverie festival gibi bir şey!Dialogue: 0,0:09:57.31,0:10:00.06,Narrator,,0,0,0,,Bu sırada Luffyler'in grupta...Dialogue: 0,0:10:00.06,0:10:02.95,Main,,0,0,0,,Hey... sancak tarafına...Dialogue: 0,0:10:02.95,0:10:04.42,Main,,0,0,0,,Peki...Dialogue: 0,0:10:05.78,0:10:06.87,Main,,0,0,0,,Oldu mu?Dialogue: 0,0:10:06.87,0:10:10.29,Main,,0,0,0,,Biraz daha...Dialogue: 0,0:10:10.29,0:10:12.25,Main,,0,0,0,,Bu ne, bu ne, bu ne şimdi?!Dialogue: 0,0:10:12.25,0:10:15.16,Main,,0,0,0,,Kendinize gelin biraz! Batacağız yoksa!Dialogue: 0,0:10:16.74,0:10:22.26,Main,,0,0,0,,Kapa çeneni be! Filin üstünden pat diye atladığın için hepimiz bu haldeyiz, aptal!Dialogue: 0,0:10:22.26,0:10:28.44,Main,,0,0,0,,Teşekkür ederim. Yaşamanın ne tatlı bir şey olduğunu şimdi anlıyorum.Dialogue: 0,0:10:28.44,0:10:31.48,Main,,0,0,0,,Ama bunu yanına bırakmam!Dialogue: 0,0:10:33.07,0:10:37.48,Main,,0,0,0,,Bak ama... Gene rotadan çıktık.Dialogue: 0,0:10:37.48,0:10:40.62,Main,,0,0,0,,İskele tarafına...Dialogue: 0,0:10:41.45,0:10:44.02,Main,,0,0,0,,Tamamdır! Bana bırakın!Dialogue: 0,0:10:44.02,0:10:47.11,Main,,0,0,0,,Biraz onun enerjisini örnek alın...Dialogue: 0,0:10:47.96,0:10:51.54,Main,,0,0,0,,Vay canına! Gerçekten de denizin üstündeyim!Dialogue: 0,0:10:52.42,0:10:55.93,Captions,,0,0,240,,Mink Silahşörlerinin Bir Üyesi CarrotDialogue: 0,0:10:52.48,0:10:55.93,Main,,0,0,3,,Bu ağır gemi gerçekten de suyun üstünde duruyor!Dialogue: 0,0:10:55.93,0:10:58.97,Main,,0,0,0,,Ne-Neden buradasın?!Dialogue: 0,0:11:01.37,0:11:03.76,Main,,0,0,0,,Neeee!!!Dialogue: 0,0:11:06.72,0:11:07.98,Main,,0,0,0,,Carrot?!Dialogue: 0,0:11:08.61,0:11:10.92,Main,,0,0,0,,Carrot, burada ne arıyorsun?!Dialogue: 0,0:11:13.76,0:11:15.82,Main,,0,0,0,,Ben de geldim!Dialogue: 0,0:11:15.82,0:11:17.37,Main,,0,0,0,,Garchu!Dialogue: 0,0:11:19.28,0:11:20.32,Main,,0,0,0,,Nami!Dialogue: 0,0:11:20.35,0:11:20.38,Captions,,0,0,0,,HÜP!Dialogue: 0,0:11:20.38,0:11:20.42,Captions,,0,0,0,,HÜP!Dialogue: 0,0:11:20.42,0:11:20.46,Captions,,0,0,0,,HÜP!Dialogue: 0,0:11:20.46,0:11:20.50,Captions,,0,0,0,,HÜP!Dialogue: 0,0:11:20.50,0:11:20.54,Captions,,0,0,0,,HÜP!Dialogue: 0,0:11:20.54,0:11:20.58,Captions,,0,0,0,,HÜP!Dialogue: 0,0:11:20.58,0:11:20.62,Captions,,0,0,0,,HÜP!Dialogue: 0,0:11:20.62,0:11:20.66,Captions,,0,0,0,,HÜP!Dialogue: 0,0:11:20.66,0:11:20.70,Captions,,0,0,0,,HÜP!Dialogue: 0,0:11:20.70,0:11:20.74,Captions,,0,0,0,,HÜP!Dialogue: 0,0:11:20.74,0:11:20.78,Captions,,0,0,0,,HÜP!Dialogue: 0,0:11:20.78,0:11:20.82,Captions,,0,0,0,,HÜP!Dialogue: 0,0:11:20.82,0:11:20.86,Captions,,0,0,0,,HÜP!Dialogue: 0,0:11:20.86,0:11:20.91,Captions,,0,0,0,,HÜP!Dialogue: 0,0:11:20.91,0:11:20.95,Captions,,0,0,0,,HÜP!Dialogue: 0,0:11:20.95,0:11:20.99,Captions,,0,0,0,,HÜP!Dialogue: 0,0:11:20.99,0:11:21.03,Captions,,0,0,0,,HÜP!Dialogue: 0,0:11:21.03,0:11:21.07,Captions,,0,0,0,,HÜP!Dialogue: 0,0:11:21.07,0:11:21.11,Captions,,0,0,0,,HÜP!Dialogue: 0,0:11:21.11,0:11:21.16,Captions,,0,0,0,,HÜP!Dialogue: 0,0:11:21.16,0:11:21.20,Captions,,0,0,0,,HÜP!Dialogue: 0,0:11:21.20,0:11:21.24,Captions,,0,0,0,,HÜP!Dialogue: 0,0:11:22.28,0:11:23.49,Main,,0,0,0,,Chopper!Dialogue: 0,0:11:23.52,0:11:23.56,Captions,,0,0,0,,HART!Dialogue: 0,0:11:23.56,0:11:23.61,Captions,,0,0,0,,HART!Dialogue: 0,0:11:23.61,0:11:23.65,Captions,,0,0,0,,HART!Dialogue: 0,0:11:23.65,0:11:23.69,Captions,,0,0,0,,HART!Dialogue: 0,0:11:23.69,0:11:23.73,Captions,,0,0,0,,HART!Dialogue: 0,0:11:23.73,0:11:23.77,Captions,,0,0,0,,HART!Dialogue: 0,0:11:23.77,0:11:23.81,Captions,,0,0,0,,HART!Dialogue: 0,0:11:23.81,0:11:23.85,Captions,,0,0,0,,HART!Dialogue: 0,0:11:23.85,0:11:23.89,Captions,,0,0,0,,HART!Dialogue: 0,0:11:23.89,0:11:23.93,Captions,,0,0,0,,HART!Dialogue: 0,0:11:23.93,0:11:23.98,Captions,,0,0,0,,HART!Dialogue: 0,0:11:23.98,0:11:24.02,Captions,,0,0,0,,HART!Dialogue: 0,0:11:24.02,0:11:24.06,Captions,,0,0,0,,HART!Dialogue: 0,0:11:24.06,0:11:24.10,Captions,,0,0,0,,HART!Dialogue: 0,0:11:24.10,0:11:24.14,Captions,,0,0,0,,HART!Dialogue: 0,0:11:24.14,0:11:24.18,Captions,,0,0,0,,HART!Dialogue: 0,0:11:24.18,0:11:24.22,Captions,,0,0,0,,HART!Dialogue: 0,0:11:24.22,0:11:24.26,Captions,,0,0,0,,HART!Dialogue: 0,0:11:24.26,0:11:24.30,Captions,,0,0,0,,HART!Dialogue: 0,0:11:24.30,0:11:24.34,Captions,,0,0,0,,HART!Dialogue: 0,0:11:24.34,0:11:24.38,Captions,,0,0,0,,HART!Dialogue: 0,0:11:25.33,0:11:27.88,Main,,0,0,0,,Baron Ceset!Dialogue: 0,0:11:28.62,0:11:28.62,Main,,0,0,0,,KITIRT!Dialogue: 0,0:11:28.62,0:11:28.62,Main,,0,0,0,,KITIRT!Dialogue: 0,0:11:28.62,0:11:29.41,Main,,0,0,0,,KITIRT!Dialogue: 0,0:11:29.41,0:11:31.13,Main,,0,0,0,,Taş gibi!Dialogue: 0,0:11:31.13,0:11:34.52,Main,,0,0,0,,Çok özür dilerim ama geri dönebilir miyiz?Dialogue: 0,0:11:34.52,0:11:35.71,Main,,0,0,0,,Ne?!Dialogue: 0,0:11:35.71,0:11:39.62,Main,,0,0,0,,N'olur geri dönmeyelim! Wanda beni öldürür!Dialogue: 0,0:11:39.62,0:11:42.84,Main,,0,0,0,,Hayatını kurtarmış kişilere dert olmaya mı çalışıyorsun Carrot?!Dialogue: 0,0:11:44.01,0:11:50.10,Main,,0,0,0,,Bir kere olsun Luffyler'le birlikte  denizde maceraya atılmak istedim!Dialogue: 0,0:11:50.10,0:11:54.02,Main,,0,0,0,,Yonkou'nun kararagâhına sızmaya çalışacağız! Oyun oynamıyoruz!Dialogue: 0,0:11:54.02,0:11:59.44,Main,,0,0,0,,Lütfen! Elimden gelen her şeyi yaparım, beni de yanınızda götürün! Hem başınıza dert olmamak için...Dialogue: 0,0:11:59.44,0:12:01.03,Main,,0,0,0,,...yanımda bunları da getirdim!Dialogue: 0,0:12:01.03,0:12:02.51,Main,,0,0,0,,Yemeğim!Dialogue: 0,0:12:02.51,0:12:03.86,Main,,0,0,0,,İçeceğim!Dialogue: 0,0:12:03.86,0:12:04.99,Main,,0,0,0,,Abur cubur!Dialogue: 0,0:12:04.99,0:12:06.37,Main,,0,0,0,,Değiştirmelik bluz!Dialogue: 0,0:12:06.37,0:12:09.10,Main,,0,0,0,,Ne kadar yetecekler sana peki?Dialogue: 0,0:12:09.10,0:12:13.00,Main,,0,0,0,,Tam tamına yarım gün! Deniz ne büyük değil mi?!Dialogue: 0,0:12:13.72,0:12:18.98,Main,,0,0,0,,Ne?! Big Mom'ın adasına varmamız günler mi sürecek dediniz?!Dialogue: 0,0:12:18.98,0:12:23.55,Main,,0,0,0,,Üstelik o da doğrudan gidersek! O kadar büyük yer mi var ya?!Dialogue: 0,0:12:23.55,0:12:26.35,Main,,0,0,0,,Deniz resmen harikalar diyarıymış!Dialogue: 0,0:12:26.35,0:12:28.79,Main,,0,0,0,,İlk yatılı gezim olacak bu!Dialogue: 0,0:12:28.79,0:12:31.89,Main,,0,0,0,,Harikalar diyarı ha? Ayak basacak yer olsa iyiydi.Dialogue: 0,0:12:31.89,0:12:35.36,Main,,0,0,0,,Kal madem. Hem gemiye çoktan binmişsin bile, yapacak bir şey yok.Dialogue: 0,0:12:35.36,0:12:38.26,Main,,0,0,0,,Kendini koruyabilir misin?Dialogue: 0,0:12:38.26,0:12:41.74,Main,,0,0,0,,Evet! Teşekkür ederim!  Bana bir şey...Dialogue: 0,0:12:41.74,0:12:44.93,Main,,0,0,0,,Havucumu niye yiyorsun?!Dialogue: 0,0:12:48.77,0:12:50.37,Main,,0,0,0,,Kafasını okşa, Luffy!Dialogue: 0,0:12:58.93,0:13:03.60,Main,,0,0,0,,Ucuz yırttık! Cinayate kurban gidecektim!  Güçlüymüşsün!Dialogue: 0,0:13:03.60,0:13:05.66,Main,,0,0,0,,Peki, havucumu yiyebilirsin.Dialogue: 0,0:13:05.66,0:13:07.90,Main,,0,0,0,,Luffy neredeyse yeniliyordu!Dialogue: 0,0:13:10.78,0:13:12.97,Main,,0,0,0,,Carrot güçlü olmasına güçlüdür.Dialogue: 0,0:13:13.50,0:13:18.76,Main,,0,0,0,,Pedro-san, oraya ne ara tırmandınız!? Yüksek yerleri gerçekten de seviyorsunuz.Dialogue: 0,0:13:21.32,0:13:24.37,Main,,0,0,0,,Acıktım ha! Yemek yiyelim!Dialogue: 0,0:13:24.37,0:13:26.61,Main,,0,0,0,,Birileri yemek yapsın!Dialogue: 0,0:13:28.01,0:13:32.95,Main,,0,0,0,,İş başa düştü! Peki madem, ben bir şeyler pişiririm, gözünüzü denizden ayırmayın!Dialogue: 0,0:13:33.98,0:13:35.40,Main,,0,0,0,,- Emredersiniz efendim! - Emredersiniz efendim!Dialogue: 0,0:13:35.40,0:13:36.24,Main,,0,0,0,,Anlaşıldı!Dialogue: 0,0:13:38.07,0:13:40.08,Main,,0,0,0,,Yemekler kişi başı 5000 beli!Dialogue: 0,0:13:40.83,0:13:44.24,Main,,0,0,0,,Bekle! Bekle! Bekle!Dialogue: 0,0:13:44.24,0:13:46.00,Main,,0,0,0,,Tüm harçlığımız o be!Dialogue: 0,0:13:46.00,0:13:48.11,Main,,0,0,0,,Ne öneriyorsunuz peki?Dialogue: 0,0:13:49.17,0:13:52.04,Thoughts,,0,0,0,,İkimizden birinin bir şeyler yapması lazım.Dialogue: 0,0:13:52.04,0:13:53.42,Thoughts,,0,0,0,,Haklısın.Dialogue: 0,0:13:53.42,0:13:58.63,Thoughts,,0,0,0,,Luffy-san'a bırakırsak hayatımızla büyük bir kumar oynamış oluruz!Dialogue: 0,0:13:59.16,0:14:00.75,Main,,0,0,0,,Ben pişiririm!Dialogue: 0,0:14:00.75,0:14:01.85,Main,,0,0,0,,Ne?!Dialogue: 0,0:14:01.85,0:14:05.74,Main,,0,0,0,,Bana bırakın! Parmaklarınızı yemezseniz iyidir!Dialogue: 0,0:14:05.74,0:14:07.09,Main,,0,0,0,,Yok, biz...Dialogue: 0,0:14:07.09,0:14:09.35,Main,,0,0,0,,Lütfen olmasın ama...Dialogue: 0,0:14:09.35,0:14:11.54,Main,,0,0,0,,Yemek! Yemek! Yemek!Dialogue: 0,0:14:11.54,0:14:13.18,Main,,0,0,0,,Yapma lütfen!Dialogue: 0,0:14:13.18,0:14:15.44,Main,,0,0,0,,Luffy, hayatında hiç yemek yaptın mı?!Dialogue: 0,0:14:23.18,0:14:25.80,Main,,0,0,0,,Amma büyük manşet atmışlar.Dialogue: 0,0:14:29.82,0:14:32.78,Main,,0,0,0,,"On yıllardır çözülemeyen adanın gizemi..."Dialogue: 0,0:14:33.99,0:14:36.25,Main,,0,0,0,,"...sonunda ortaya çıktı."Dialogue: 0,0:14:37.58,0:14:41.76,Main,,0,0,0,,"Devrim Ordusu merkez karargâhı Baltigo..."Dialogue: 0,0:14:40.27,0:14:43.15,Note,,0,0,0,,Devrim Ordusu Karargahı bulundu.Dialogue: 0,0:14:43.15,0:14:45.66,Main,,0,0,0,,"...yerlebir edildi!" mi?!Dialogue: 0,0:14:47.93,0:14:49.80,Main,,0,0,0,,Yok artık!Dialogue: 0,0:14:48.79,0:14:50.66,Note,,0,0,0,,Devrim Ordusu Karargahı bulundu.Dialogue: 0,0:14:50.66,0:14:52.88,Main,,0,0,0,,Devrim Ordusu yenilmiş mi?!Dialogue: 0,0:14:52.88,0:14:56.30,Main,,0,0,0,,Sen-gara yanılmıyorsam devrimci Dragon'un...Dialogue: 0,0:14:56.30,0:14:57.50,Main,,0,0,0,,Sabo!Dialogue: 0,0:14:57.50,0:14:59.75,Main,,0,0,0,,Abim bu!Dialogue: 0,0:15:00.88,0:15:06.45,Main,,0,0,0,,Sabo-san mı?! Şu Dressrosa'da karşılaştığını söylediğin diğer abin mi?Dialogue: 0,0:15:06.45,0:15:11.82,Main,,0,0,0,,Kurmay Başkanı mıymış?! Devrim Ordusu'nun en güçlü ikinci ismi!Dialogue: 0,0:15:11.82,0:15:14.82,Main,,0,0,0,,Ne biçim abilerin var senin be?!Dialogue: 0,0:15:14.82,0:15:17.66,Main,,0,0,0,,Bu yanındaki Dragon da öyleyse...Dialogue: 0,0:15:17.66,0:15:22.48,Main,,0,0,0,,Herhâlde! İki yıl önce deden ne demişti unuttun mu?Dialogue: 0,0:15:22.90,0:15:25.30,Flashbacks,,0,0,0,,Babanın adı...Dialogue: 0,0:15:25.30,0:15:29.67,Flashbacks,,0,0,0,,...Monkey D. Dragon. Devrimci!Dialogue: 0,0:15:29.67,0:15:32.97,Main,,0,0,0,,Devrim Ordusu lideri Dragon.Dialogue: 0,0:15:32.97,0:15:35.33,Main,,0,0,0,,Baban işte!Dialogue: 0,0:15:38.04,0:15:41.64,Main,,0,0,0,,Ne?! Babam bu muymuş?!Dialogue: 0,0:15:41.64,0:15:43.14,Main,,0,0,0,,Neden şaşırıyorsun?!Dialogue: 0,0:15:43.14,0:15:44.26,Main,,0,0,0,,İlk defa görüyorum!Dialogue: 0,0:15:44.95,0:15:48.71,Main,,0,0,0,,Luffy'nin babası Devrim Ordusu'nun patronu muymuş?!Dialogue: 0,0:15:48.71,0:15:52.53,Main,,0,0,0,,Vay canına! Vay canına! Garchu!Dialogue: 0,0:15:52.53,0:15:56.69,Main,,0,0,0,,İki yılda hiç mi araştırmadın?Dialogue: 0,0:15:56.69,0:16:01.20,Main,,0,0,0,,İnsan böyle ünlü bir babaya sahip olup da hiç mi merak etmez?!Dialogue: 0,0:16:01.20,0:16:04.18,Main,,0,0,0,,Robin'i uzun süre ağırlamış hem.Dialogue: 0,0:16:04.18,0:16:08.29,Main,,0,0,0,,Hadi ya! İlk defa görüyorum! Bana da pek benzemiyormuş.Dialogue: 0,0:16:08.29,0:16:10.69,Main,,0,0,0,,Ondan ziyade beni asıl endişelendiren Sabo!Dialogue: 0,0:16:10.69,0:16:12.03,Main,,0,0,0,,Of...Dialogue: 0,0:16:13.10,0:16:16.04,Main,,0,0,0,,Tek bir fotoğrafa bakarak söylemesi zor tabii.Dialogue: 0,0:16:19.82,0:16:23.51,Main,,0,0,0,,"Karargâhları anonim bir ipucu sayesinde bulundu."Dialogue: 0,0:16:23.51,0:16:26.88,Main,,0,0,0,,"Fakat Donanma ve Cipher Pol bölgeye iştirak ettiğinde..."Dialogue: 0,0:16:26.88,0:16:31.00,Main,,0,0,0,,"...Karasakal Korsanları karargâhı çoktan yerlebir etmişti."Dialogue: 0,0:16:32.67,0:16:35.43,Main,,0,0,0,,Karasakal mı!? O şerefsizler!Dialogue: 0,0:16:35.43,0:16:40.01,Main,,0,0,0,,Tamam da niye Yonkou Karasakal Devrim Ordusu'nun peşine düşsün ki?Dialogue: 0,0:16:41.08,0:16:46.69,Main,,0,0,0,,Sabo Dressrosa'da şampiyona karşı savaşmıştı ama bir ilgisi olabilir mi acaba?Dialogue: 0,0:16:43.57,0:16:45.96,Secondary,,0,0,0,,Hey, Luffy!Dialogue: 0,0:16:53.64,0:16:58.95,Main,,0,0,0,,Yonkou Karasakal Cipher Pol'la mücadele ettikten sonra bölgeden uzaklaşmış.Dialogue: 0,0:16:58.95,0:17:00.87,Main,,0,0,0,,Hey, Luffy!Dialogue: 0,0:17:00.87,0:17:04.17,Main,,0,0,0,,Herhângi bir ölüm raporu yayınlanmamış.Dialogue: 0,0:17:04.17,0:17:05.35,Main,,0,0,0,,Hey!Dialogue: 0,0:17:05.35,0:17:11.27,Main,,0,0,0,,Baban yahut ağabeyin-gara yakalansa veya öldürülse kesin haberi yapılırdı.Dialogue: 0,0:17:11.27,0:17:12.64,Main,,0,0,0,,Hey, Luffy!Dialogue: 0,0:17:12.64,0:17:15.72,Main,,0,0,0,,Bundan yola çıkarak şimdilik hayattalar diyebiliriz.Dialogue: 0,0:17:15.72,0:17:17.63,Main,,0,0,0,,Evet! Haklısın!Dialogue: 0,0:17:17.63,0:17:19.16,Main,,0,0,0,,Hey, Luffy!Dialogue: 0,0:17:19.16,0:17:20.43,Main,,0,0,0,,Ne var ya deminden beri!Dialogue: 0,0:17:20.43,0:17:24.60,Main,,0,0,0,,Bizim için yemek pişiriyorsun falan sağ ol ama şu normal mi?!Dialogue: 0,0:17:26.06,0:17:26.99,Main,,0,0,0,,Neymiş o?Dialogue: 0,0:17:30.07,0:17:31.86,Main,,0,0,0,,Yangın!Dialogue: 0,0:17:34.60,0:17:37.36,Main,,0,0,0,,Eyvah, ocağın altını açık unuttum!Dialogue: 0,0:17:37.36,0:17:39.44,Main,,0,0,0,,Ne?!Dialogue: 0,0:17:41.44,0:17:42.87,Main,,0,0,0,,Patlama oldu!Dialogue: 0,0:17:42.87,0:17:44.33,Main,,0,0,0,,Ateşi söndürün!Dialogue: 0,0:17:48.65,0:17:50.79,Main,,0,0,0,,Durun biraz! Fırtına yaklaşıyor!Dialogue: 0,0:17:50.79,0:17:52.75,Main,,0,0,0,,Nee?!Dialogue: 0,0:17:55.31,0:17:57.72,Main,,0,0,0,,Bu ne böyle?! Elektro mu?!Dialogue: 0,0:17:59.55,0:18:02.22,Main,,0,0,0,,Derhal yelkenleri toplayın! Yırtılıp gidecekler!Dialogue: 0,0:18:03.11,0:18:04.64,Main,,0,0,0,,Yangını ne yapacağız?!Dialogue: 0,0:18:04.64,0:18:07.56,Main,,0,0,0,,Şiddetli yağış başlayacak, yangını söndürür o!Dialogue: 0,0:18:07.56,0:18:08.79,Main,,0,0,0,,Ne şanslıyız!Dialogue: 0,0:18:08.79,0:18:10.16,Main,,0,0,0,,Şanslık bir durum yok!Dialogue: 0,0:18:17.86,0:18:19.24,Main,,0,0,0,,Sen de bir şeyler yap!Dialogue: 0,0:18:19.24,0:18:22.44,Main,,0,0,0,,Ağır yaralıyım ben!Dialogue: 0,0:18:29.63,0:18:34.38,Captions,,0,0,170,,ZouDialogue: 0,0:18:35.86,0:18:38.68,Main,,0,0,0,,Yani Carrot denizde mi şimdi?!Dialogue: 0,0:18:41.93,0:18:45.07,Main,,0,0,0,,Bunu neden daha erken söylemedin Bariete?Dialogue: 0,0:18:45.07,0:18:47.72,Main,,0,0,0,,Özür dilerim-degosaru Wanda!Dialogue: 0,0:18:47.72,0:18:52.24,Main,,0,0,0,,Carrot'a herkese söylemesi gerektiğini tembihledim-degosaru.Dialogue: 0,0:18:52.24,0:18:54.57,Main,,0,0,0,,Ama o dedi ki...Dialogue: 0,0:18:55.23,0:18:58.55,Flashbacks,,0,0,0,,Olmaz! Kime söylersem söyleyeyim beni engellemeye çalışacaklar!Dialogue: 0,0:19:01.32,0:19:04.31,Main,,0,0,0,,Bir süreliğine sır olarak saklayabilir misin?Dialogue: 0,0:19:04.31,0:19:05.04,Main,,0,0,0,,Şok!Dialogue: 0,0:19:07.03,0:19:08.96,Main,,0,0,0,,Yakalandım-degosaru...Dialogue: 0,0:19:08.96,0:19:12.50,Main,,0,0,0,,Ama Carrot seni kandırmak için yapmad--Dialogue: 0,0:19:13.19,0:19:16.41,Main,,0,0,0,,Endişelenme. Nerede olduğunu öğrenmek yetti.Dialogue: 0,0:19:16.41,0:19:19.60,Main,,0,0,0,,Kayboldu falan sanıp endişelenmiştim.Dialogue: 0,0:19:19.60,0:19:22.34,Main,,0,0,0,,Luffyler'le birlikteyse bir şey olmaz.Dialogue: 0,0:19:33.92,0:19:38.65,Main,,0,0,0,,Dük-sama, siz dinlenmenize bakın lütfen. İsterseniz ekstra muhafız ayarlarım.Dialogue: 0,0:19:44.20,0:19:48.16,Main,,0,0,0,,Düşman muhtemelen Vivre Kartı'na sahip.Dialogue: 0,0:19:44.20,0:19:48.16,Note,,0,0,0,,Vivre: YaşamDialogue: 0,0:19:49.95,0:19:52.44,Main,,0,0,0,,Peki bu nasıl mümkün olabilir?!Dialogue: 0,0:19:53.98,0:19:59.97,Main,,0,0,0,,Umarım o kağıt da Zunesha'nın batırdığı filo gibi denizde kaybolmuştur.Dialogue: 0,0:20:00.49,0:20:02.32,Main,,0,0,0,,Gene gelecekler mi dersiniz?Dialogue: 0,0:20:05.91,0:20:08.00,Main,,0,0,0,,Gözümüzü açık tutsak iyi ederiz.Dialogue: 0,0:20:08.47,0:20:09.26,Main,,0,0,0,,Peki.Dialogue: 0,0:20:40.84,0:20:42.95,Thoughts,,0,0,0,,Gelin çabuk!Dialogue: 0,0:20:48.39,0:20:51.55,Thoughts,,0,0,0,,Çekin beni buradan!Dialogue: 0,0:21:05.45,0:21:07.36,Captions,,0,0,175,,Falanca Bir ÜlkeDialogue: 0,0:21:11.24,0:21:15.70,Main,,0,0,0,,Jack-sama Joker'ı almayı başaramamış!Dialogue: 0,0:21:18.16,0:21:24.80,Main,,0,0,0,,Özetle insan yapımı şeytan meyvesi GÜLÜCÜK ticareti... sona erdi.Dialogue: 0,0:21:41.02,0:21:42.83,Thoughts,,0,0,0,,Bugün ağlak sarhoş modunda.Dialogue: 0,0:21:45.27,0:21:50.68,Main,,0,0,0,,Artık Gifters* sayısını arttıramayacağız anlamına geliyor bu!Dialogue: 0,0:21:56.22,0:21:59.96,Main,,0,0,0,,Joker! Ey Joker!Dialogue: 0,0:21:59.96,0:22:04.05,Main,,0,0,0,,Nasıl yenilirsin sen?!Dialogue: 0,0:22:06.26,0:22:13.07,Main,,0,0,0,,Tamamı güç kullanıcılarından oluşan en güçlü korsan grubunu oluşturacağız dememiş miydin?Dialogue: 0,0:22:22.43,0:22:24.99,Main,,0,0,0,,Ama sen kalk...Dialogue: 0,0:22:32.96,0:22:40.17,Main,,0,0,0,,...hayalimize kavuşamadan  ağzı kusmuk kokulu veletlere yenil!Dialogue: 0,0:22:46.00,0:22:51.64,Main,,0,0,0,,Zavallı Joker! Suç özünde güçsüz olduğun için sende tabii!Dialogue: 0,0:22:51.64,0:22:55.72,Main,,0,0,0,,Fakat Hasır Şapka adı çok konuşulan bir adam. Hafife alırsanız...Dialogue: 0,0:23:18.09,0:23:20.92,Main,,0,0,0,,Hafife alırsam...Dialogue: 0,0:23:20.92,0:23:23.21,Main,,0,0,0,,Ne olurmuş?!Dialogue: 0,0:23:56.16,0:23:59.40,Main,,0,0,0,,Benim kim olduğumu unuttunuz mu?!Dialogue: 0,0:24:00.20,0:24:03.04,Main,,0,0,0,,Huysuz sarhoşa dönüştü!Dialogue: 0,0:24:16.34,0:24:20.56,Main,,0,0,0,,Ka-Kaido-sama, sakinleşin lütfen!Dialogue: 0,0:24:24.87,0:24:29.48,Main,,0,0,0,,Hasır Şapkalı Luffy! Trafalgar Law!Dialogue: 0,0:24:37.12,0:24:41.09,Main,,0,0,0,,Biliyorum! İkisi de şu falanca nesilden değil mi?!Dialogue: 0,0:24:45.15,0:24:48.90,Main,,0,0,0,,Veletler Shichibukai'ın tekini alt ettiler diye kendilerini bir şey sanmaya başlamış!Dialogue: 0,0:24:49.59,0:24:54.47,Main,,0,0,0,,Kimin işini bozduklarını hatırlatmak lazım onlara!Dialogue: 0,0:25:04.78,0:25:07.23,Main,,0,0,0,,Görecekler!Dialogue: 0,0:25:14.07,0:25:17.03,Main,,0,0,0,,Bana bak!Dialogue: 0,0:25:17.03,0:25:20.20,Main,,0,0,0,,Kendi neslinden o aptallara aynen şunu söyleyeceksin:Dialogue: 0,0:25:21.54,0:25:27.66,Main,,0,0,0,,"Derhal kaçın!  Biz meğer korsancılık oynuyormuşuz!"Dialogue: 0,0:25:34.80,0:25:38.41,Main,,0,0,0,,Eustass "Kaptan" Kid!Dialogue: 0,0:25:46.14,0:25:49.94,Captions,,950,0,350,,Thousand SunnyDialogue: 0,0:25:44.70,0:25:46.74,Main,,0,0,0,,Dondum!Dialogue: 0,0:25:46.74,0:25:48.46,Main,,0,0,0,,Çatıyı kapattık!Dialogue: 0,0:25:48.46,0:25:50.02,Main,,0,0,0,,Peki, ellerinize sağlık.Dialogue: 0,0:25:50.02,0:25:54.16,Main,,0,0,0,,Harika, fırtına dindi! Uçan çatıyı da kapadık!Dialogue: 0,0:25:54.64,0:25:58.30,Main,,0,0,0,,Yemeği kurtarmayı başardım, çekinmeden yiyin hadi afiyet olsun!Dialogue: 0,0:25:58.30,0:26:01.66,Main,,0,0,0,,Yaşasın yemek! Açlıktan ölüyoruz!Dialogue: 0,0:26:05.40,0:26:07.08,Main,,0,0,0,,Nasıl olmuş, beğendiniz mi?Dialogue: 0,0:26:08.42,0:26:11.00,Main,,0,0,0,,Kendi özel köri tarifim!Dialogue: 0,0:26:11.46,0:26:15.27,Main,,0,0,0,,Luffy, çiğ pirinç yiyemeyiz!Dialogue: 0,0:26:15.27,0:26:17.76,Main,,0,0,0,,Acı morumsu şey de ne?Dialogue: 0,0:26:17.76,0:26:19.96,Main,,0,0,0,,Balık kemiğinden başka bir şey yok.Dialogue: 0,0:26:19.96,0:26:21.37,Main,,0,0,0,,Reçeli çok kaçmış!Dialogue: 0,0:26:21.37,0:26:24.42,Main,,0,0,0,,Açık mavi, yapış yapıp bir şey de var...Dialogue: 0,0:26:24.42,0:26:27.44,Main,,0,0,0,,Bunu hak edecek ne yaptık?!Dialogue: 0,0:26:27.44,0:26:31.02,Main,,0,0,0,,Sen kalk o kadar uğraş, beğenmesinler! Nankörlüğün böylesi!Dialogue: 0,0:26:34.83,0:26:36.89,Main,,0,0,0,,İğrenç!Dialogue: 0,0:26:36.89,0:26:37.90,Main,,0,0,0,,Gördün mü?Dialogue: 0,0:26:37.90,0:26:39.91,Main,,0,0,0,,Yenmez bu be!Dialogue: 0,0:26:39.91,0:26:41.62,Main,,0,0,0,,Yere dökme!Dialogue: 0,0:26:42.14,0:26:47.21,Main,,0,0,0,,Yiyecekleri ziyan etmişsin! Sanji-san görse acayip kızardı!Dialogue: 0,0:26:49.81,0:26:53.52,Main,,0,0,0,,Dopdolu kilerden geriye hiçbir şey kalmamış!Dialogue: 0,0:26:53.52,0:26:57.89,Main,,0,0,0,,Evet, ilk birkaç denemem olmadı, hepsini kullandım!Dialogue: 0,0:26:57.89,0:27:01.87,Main,,0,0,0,,Ciddi misin sen?!  Hepimize haftalarca yetecek yiyecek vardı!Dialogue: 0,0:27:01.87,0:27:03.32,Main,,0,0,0,,Çok açsınızdır diye düşünüp bol yaptım!Dialogue: 0,0:27:04.43,0:27:06.05,Main,,0,0,0,,Ne gülüyorsun?!Dialogue: 0,0:27:07.59,0:27:10.23,Main,,0,0,0,,Şimdi ne yapacağız?!Dialogue: 0,0:27:10.76,0:27:11.96,Main,,0,0,0,,Luffy...Dialogue: 0,0:27:13.02,0:27:16.08,Main,,0,0,0,,Çok açım...Dialogue: 0,0:27:16.08,0:27:19.53,Main,,0,0,0,,Sanji-san, kurtar bizi!Dialogue: 0,0:27:20.16,0:27:27.94,Narrator,,0,0,0,,Ve böylece Luffyler daha seyahatlerinin ilk gününden yiyecek sıkıntısı çekmeye başladılar.Dialogue: 0,0:27:29.42,0:27:34.75,Captions,,0,0,300,,Bir Kaç Gün Sonra, Big Mom'ın GemisiDialogue: 0,0:27:29.42,0:27:34.79,Lyrics,,0,0,0,,♪ Gemi! Gemi! Gemi! Gemi! ♪Dialogue: 0,0:27:37.36,0:27:39.04,Main,,0,0,0,,Kar yağıyor sanmıştım ama...Dialogue: 0,0:27:40.43,0:27:42.76,Main,,0,0,0,,Pamuk Şeker Kar-soir!Dialogue: 0,0:27:45.46,0:27:48.52,Main,,0,0,0,,Deminden beri Denden Mushi'n susmak bilmedi.Dialogue: 0,0:27:49.24,0:27:52.79,Main,,0,0,0,,Uyarı sinyalleri alıyor-bon.Dialogue: 0,0:27:52.79,0:27:56.21,Main,,0,0,0,,Çoktan Mama'nın bölgesine girdiğimiz anlamına geliyor bu-sufle.Dialogue: 0,0:27:56.21,0:27:59.00,Main,,0,0,0,,Bu uyarı sinyalleri oraya da ulaşıyor mu?Dialogue: 0,0:27:59.00,0:28:03.09,Main,,0,0,0,,Kafan çalışıyormuş! Orası TARTE 28.Dialogue: 0,0:28:03.09,0:28:09.89,Main,,0,0,0,,Orası Big Mom Korsanları'ndan bir grubun hazır vaziyette beklediği bir ileri karakol-millefeuille!Dialogue: 0,0:28:09.89,0:28:14.29,Main,,0,0,0,,Bu Mama'nın gemilerinden biri olmasaydı anında havaya uçururlardı bizi!Dialogue: 0,0:28:16.51,0:28:21.74,Main,,0,0,0,,Ee, karar verdin mi peki? İnatçılık etmemeni öneririm.Dialogue: 0,0:28:21.74,0:28:29.02,Main,,0,0,0,,Germa 66'yla birlikte bize, Big Mom Korsanlarına katılacağına yemin et-bon.Dialogue: 0,0:28:29.02,0:28:33.48,Main,,0,0,0,,Babanın dileği bu-amor.Dialogue: 0,0:28:33.94,0:28:36.71,Main,,0,0,0,,O heriften bahsetme bana! Sinirlerim tepeme çıkıyor!Dialogue: 0,0:28:37.58,0:28:40.50,Main,,0,0,0,,Onunla aramızda hiçbir bağ kalmadı!Dialogue: 0,0:28:47.91,0:28:50.87,Main,,0,0,0,,Sizinle de bu meseleye bir son vermeye geliyorum!Dialogue: 0,0:28:57.24,0:28:59.10,Main,,0,0,0,,Böyle yapma şimdi!Dialogue: 0,0:28:59.10,0:29:02.85,Main,,0,0,0,,Mama tahmin ettiğinden daha misafirperver biridir.Dialogue: 0,0:29:02.85,0:29:08.53,Main,,0,0,0,,Elbette o aptal Hasır Şapka'nın tayfasından olduğunu da biliyor-il vous plaît.Dialogue: 0,0:29:08.53,0:29:16.33,Main,,0,0,0,,Fakat bir zamanlar Doğu Mavi'deki Deniz Restoranı'nda şef olduğun için sana çok değer veriyor-bon.Dialogue: 0,0:29:18.24,0:29:22.97,Main,,0,0,0,,Hatta aşçılık konusunda yetenekliysen çok daha iyi bir şekilde bile ağırlanabilirsin-jour.Dialogue: 0,0:29:22.97,0:29:24.73,Main,,0,0,0,,Hadi lan oradan!Dialogue: 0,0:29:24.73,0:29:30.35,Main,,0,0,0,,Bu ellerle yalnızca dostlarıma yemek pişiririm, anladın mı?!Dialogue: 0,0:29:35.42,0:29:39.46,Main,,0,0,0,,Sırf onlar için cehennemin ortasında bile eğittim kendimi!Dialogue: 0,0:29:44.67,0:29:50.29,Main,,0,0,0,,Yaptığım yemeklere hasret,  gözyaşları içindeki hallerini hayal edebiliyorum!Dialogue: 0,0:29:51.06,0:29:52.64,Main,,0,0,0,,Güldürdün beni!Dialogue: 0,0:29:53.26,0:29:57.61,Main,,0,0,0,,Dostları öldürüldükten sonra bile hiçbir şey olmamış gibi hayatına devam edenlere...Dialogue: 0,0:29:59.14,0:30:01.74,Main,,0,0,0,,...pişirecek yemeğim yok!Dialogue: 0,0:30:01.74,0:30:05.65,Main,,0,0,0,,Pekoms'dan bahsediyorsun sanırım.Dialogue: 0,0:30:05.65,0:30:10.37,Main,,0,0,0,,Maalesef işine duygularını karıştırdı. Bege'in yaptığı doğruydu.Dialogue: 0,0:30:12.14,0:30:14.16,Main,,0,0,0,,Baron Tamago.Dialogue: 0,0:30:15.98,0:30:17.54,Main,,0,0,0,,Vito!Dialogue: 0,0:30:17.54,0:30:22.38,Main,,0,0,0,,Whole Cake Adası'ndan Pudding-sama'nın fotoğrafını göndermişler-rero!Dialogue: 0,0:30:22.93,0:30:25.16,Main,,0,0,0,,Alışman için.Dialogue: 0,0:30:25.16,0:30:31.64,Main,,0,0,0,,İlk kez tanışacağın biriyle evlenmenin zor olacağını onlar da tahmin etmiş olmalılar, ne düşünceliler!Dialogue: 0,0:30:31.64,0:30:36.02,Main,,0,0,0,,Bir şeye alışacağım falan yok aptal herif! Kimseyle evlenmeye niyetim yok!Dialogue: 0,0:30:36.02,0:30:37.67,Main,,0,0,0,,Bak işte ölmezsin ya!Dialogue: 0,0:30:37.67,0:30:40.35,Main,,0,0,0,,Kes be! Yaklaşma yanıma, tekmeyi yersin!Dialogue: 0,0:30:40.35,0:30:41.79,Main,,0,0,0,,Hadi ama şimdi...Dialogue: 0,0:30:41.79,0:30:43.50,Main,,0,0,0,,Yeter ama...Dialogue: 0,0:30:52.44,0:30:54.93,Main,,0,0,0,,Nişanlın bu işte.Dialogue: 0,0:30:54.93,0:31:00.73,Main,,0,0,0,,Charlotte Ailesi'nin 35. kızı, Charlotte Pudding-sama!Dialogue: 0,0:31:00.73,0:31:03.83,OP11 Credits,,0,0,0,,Editing: Feeso, Galaxy 9000  Quality Assurance: Feeso, Galaxy 9000, Grug, Pepperjack  Soundtracking: Halee  Timing: Lance  Karaoke: KaitouYahiko  Graphics: Datenshi  Translation: CrunchyrollDialogue: 0,0:00:00.82,0:00:06.82,Lyrics,,0,0,0,karaoke,♪ Görmedim dünyanın sonunu kendi gözlerimle hiç. ♪Dialogue: 0,0:00:06.82,0:00:13.95,Lyrics,,0,0,0,karaoke,♪ O yüzden çıktım yola sizinle, bunu yapmak için! ♪Dialogue: 0,0:00:23.67,0:00:27.00,Lyrics,,0,0,0,karaoke,♪ Bir denizden diğerine yol alırken,...Dialogue: 0,0:00:29.06,0:00:31.91,Lyrics,,0,0,0,karaoke,...bunun sadece bir peri masalı olduğunu söylemek. ♪Dialogue: 0,0:00:31.92,0:00:38.78,Lyrics,,0,0,0,karaoke,♪ Gerçek, kurgudan daha tuhaf değil mi? ♪Dialogue: 0,0:00:39.94,0:00:43.56,Lyrics,,0,0,0,karaoke,♪ Fakat sırt çevirme hiçbirine ♪Dialogue: 0,0:00:43.56,0:00:50.04,Lyrics,,0,0,0,karaoke,♪ Sağduyu dedikleri zihnidir toplulukların! ♪Dialogue: 0,0:00:51.36,0:00:57.41,Lyrics,,0,0,0,karaoke,♪ Görmedim dünyanın sonunu kendi gözlerimle hiç. ♪Dialogue: 0,0:00:57.41,0:01:01.96,Lyrics,,0,0,0,karaoke,♪ O yüzden gitmemiz lazım Kaptan Özgür-Ruh! ♪Dialogue: 0,0:01:01.96,0:01:04.72,Lyrics,,0,0,0,karaoke,♪ Kim demiş imkansız diye,...Dialogue: 0,0:01:04.71,0:01:07.89,Lyrics,,0,0,0,karaoke,...daha hiçbir şey başlamadan! ♪Dialogue: 0,0:01:07.88,0:01:12.72,Lyrics,,0,0,0,karaoke,♪ Her şeyi bilmek istiyorum ve şimdi bilebiliriz de... ♪Dialogue: 0,0:01:12.72,0:01:18.68,Lyrics,,0,0,0,karaoke,♪ Bilebiliriz, bilebilirsin! Şu anda... ♪Dialogue: 0,0:01:19.06,0:01:24.10,Lyrics,,0,0,0,karaoke,♪ Bilebiliriz, bilebilirim! Bu harika hissi... ♪Dialogue: 0,0:01:24.39,0:01:31.32,Lyrics,,0,0,0,karaoke,♪ Hemen, şimdi, bilebiliriz! ♪Dialogue: 0,0:01:37.34,0:01:38.64,Lyrics,,0,0,0,karaoke,♪ Evet, bilebiliriz! ♪