Dialogue: 0,0:11:25.33,0:11:27.88,Main,,0,0,0,,Baron Ceset!
Dialogue: 0,0:11:28.62,0:11:28.62,Main,,0,0,0,,{\fs90\fr-36\c&H1400CF&\pos(740,640)}KITIRT!
Dialogue: 0,0:11:28.62,0:11:28.62,Main,,0,0,0,,{\fs80\fr-36\c&H1400CF&\pos(750,620)}KITIRT!
Dialogue: 0,0:11:28.62,0:11:29.41,Main,,0,0,0,,{\fs70\fr-34\c&H1400CF&\pos(780,580)}KITIRT!
Dialogue: 0,0:11:29.41,0:11:31.13,Main,,0,0,0,,Taş gibi!
Dialogue: 0,0:11:31.13,0:11:34.52,Main,,0,0,0,,Çok özür dilerim ama\Ngeri dönebilir miyiz?
Dialogue: 0,0:11:34.52,0:11:35.71,Main,,0,0,0,,Ne?!
Dialogue: 0,0:11:35.71,0:11:39.62,Main,,0,0,0,,N'olur geri dönmeyelim!\NWanda beni öldürür!
Dialogue: 0,0:11:39.62,0:11:42.84,Main,,0,0,0,,Hayatını kurtarmış kişilere\Ndert olmaya mı çalışıyorsun Carrot?!
Dialogue: 0,0:11:44.01,0:11:50.10,Main,,0,0,0,,Bir kere olsun Luffyler'le birlikte \Ndenizde maceraya atılmak istedim!
Dialogue: 0,0:11:50.10,0:11:54.02,Main,,0,0,0,,Yonkou'nun kararagâhına sızmaya\Nçalışacağız! Oyun oynamıyoruz!
Dialogue: 0,0:11:54.02,0:11:59.44,Main,,0,0,0,,Lütfen! Elimden gelen her şeyi yaparım, beni de yanınızda götürün! Hem başınıza dert olmamak için...
Dialogue: 0,0:11:59.44,0:12:01.03,Main,,0,0,0,,...yanımda bunları da getirdim!
Dialogue: 0,0:12:01.03,0:12:02.51,Main,,0,0,0,,Yemeğim!
Dialogue: 0,0:12:02.51,0:12:03.86,Main,,0,0,0,,İçeceğim!
Dialogue: 0,0:12:03.86,0:12:04.99,Main,,0,0,0,,Abur cubur!
Dialogue: 0,0:12:04.99,0:12:06.37,Main,,0,0,0,,Değiştirmelik bluz!
Dialogue: 0,0:12:06.37,0:12:09.10,Main,,0,0,0,,Ne kadar yetecekler sana peki?
Dialogue: 0,0:12:09.10,0:12:13.00,Main,,0,0,0,,Tam tamına yarım gün!\NDeniz ne büyük değil mi?!
Dialogue: 0,0:12:13.72,0:12:18.98,Main,,0,0,0,,Ne?! Big Mom'ın adasına varmamız\Ngünler mi sürecek dediniz?!
Dialogue: 0,0:12:18.98,0:12:23.55,Main,,0,0,0,,Üstelik o da doğrudan gidersek!\NO kadar büyük yer mi var ya?!
Dialogue: 0,0:12:23.55,0:12:26.35,Main,,0,0,0,,Deniz resmen harikalar diyarıymış!
Dialogue: 0,0:12:26.35,0:12:28.79,Main,,0,0,0,,İlk yatılı gezim olacak bu!
Dialogue: 0,0:12:28.79,0:12:31.89,Main,,0,0,0,,Harikalar diyarı ha?\NAyak basacak yer olsa iyiydi.
Dialogue: 0,0:12:31.89,0:12:35.36,Main,,0,0,0,,Kal madem. Hem gemiye çoktan\Nbinmişsin bile, yapacak bir şey yok.
Dialogue: 0,0:12:35.36,0:12:38.26,Main,,0,0,0,,Kendini koruyabilir misin?
Dialogue: 0,0:12:38.26,0:12:41.74,Main,,0,0,0,,Evet! Teşekkür ederim! \NBana {\fscx100\fscy100\t(1800,3120,\fscx60\fscy60)}bir şey...
Dialogue: 0,0:12:41.74,0:12:44.93,Main,,0,0,0,,Havucumu niye yiyorsun?!
Dialogue: 0,0:12:48.77,0:12:50.37,Main,,0,0,0,,Kafasını okşa, Luffy!
Dialogue: 0,0:12:58.93,0:13:03.60,Main,,0,0,0,,Ucuz yırttık! Cinayate kurban gidecektim! \NGüçlüymüşsün!
Dialogue: 0,0:13:03.60,0:13:05.66,Main,,0,0,0,,Peki, havucumu yiyebilirsin.
Dialogue: 0,0:13:05.66,0:13:07.90,Main,,0,0,0,,Luffy neredeyse yeniliyordu!
Dialogue: 0,0:13:10.78,0:13:12.97,Main,,0,0,0,,Carrot güçlü olmasına güçlüdür.
Dialogue: 0,0:13:13.50,0:13:18.76,Main,,0,0,0,,Pedro-san, oraya ne ara tırmandınız!?\NYüksek yerleri gerçekten de seviyorsunuz.
Dialogue: 0,0:13:21.32,0:13:24.37,Main,,0,0,0,,Acıktım ha! Yemek yiyelim!
Dialogue: 0,0:13:24.37,0:13:26.61,Main,,0,0,0,,Birileri yemek yapsın!
Dialogue: 0,0:13:28.01,0:13:32.95,Main,,0,0,0,,İş başa düştü! Peki madem, ben bir şeyler\Npişiririm, gözünüzü denizden ayırmayın!
Dialogue: 0,0:13:33.98,0:13:35.40,Main,,0,0,0,,- Emredersiniz efendim!\N- Emredersiniz efendim!
Dialogue: 0,0:13:35.40,0:13:36.24,Main,,0,0,0,,Anlaşıldı!
Dialogue: 0,0:13:38.07,0:13:40.08,Main,,0,0,0,,Yemekler kişi başı 5000 beli!
Dialogue: 0,0:13:40.83,0:13:44.24,Main,,0,0,0,,Bekle! Bekle! Bekle!
Dialogue: 0,0:13:44.24,0:13:46.00,Main,,0,0,0,,Tüm harçlığımız o be!
Dialogue: 0,0:13:46.00,0:13:48.11,Main,,0,0,0,,Ne öneriyorsunuz peki?
Dialogue: 0,0:13:49.17,0:13:52.04,Thoughts,,0,0,0,,{\i1}İkimizden birinin\Nbir şeyler yapması lazım.{\i}
Dialogue: 0,0:13:52.04,0:13:53.42,Thoughts,,0,0,0,,{\i1}Haklısın.{\i}
Dialogue: 0,0:13:53.42,0:13:58.63,Thoughts,,0,0,0,,{\i1}Luffy-san'a bırakırsak hayatımızla\Nbüyük bir kumar oynamış oluruz!{\i}
Dialogue: 0,0:13:59.16,0:14:00.75,Main,,0,0,0,,Ben pişiririm!
Dialogue: 0,0:14:00.75,0:14:01.85,Main,,0,0,0,,Ne?!
Dialogue: 0,0:14:01.85,0:14:05.74,Main,,0,0,0,,Bana bırakın!\NParmaklarınızı yemezseniz iyidir!
Dialogue: 0,0:14:05.74,0:14:07.09,Main,,0,0,0,,Yok, biz...
Dialogue: 0,0:14:07.09,0:14:09.35,Main,,0,0,0,,Lütfen olmasın ama...
Dialogue: 0,0:14:09.35,0:14:11.54,Main,,0,0,0,,Yemek! Yemek! Yemek!
Dialogue: 0,0:14:11.54,0:14:13.18,Main,,0,0,0,,Yapma lütfen!
Dialogue: 0,0:14:13.18,0:14:15.44,Main,,0,0,0,,Luffy, hayatında hiç yemek yaptın mı?!
Dialogue: 0,0:14:23.18,0:14:25.80,Main,,0,0,0,,Amma büyük manşet atmışlar.
Dialogue: 0,0:14:29.82,0:14:32.78,Main,,0,0,0,,"On yıllardır çözülemeyen adanın gizemi..."
Dialogue: 0,0:14:33.99,0:14:36.25,Main,,0,0,0,,"...sonunda ortaya çıktı."
Dialogue: 0,0:14:37.58,0:14:41.76,Main,,0,0,0,,"Devrim Ordusu merkez karargâhı Baltigo..."
Dialogue: 0,0:14:40.27,0:14:43.15,Note,,0,0,0,,Devrim Ordusu Karargahı bulundu.
Dialogue: 0,0:14:43.15,0:14:45.66,Main,,0,0,0,,"...yerlebir edildi!" mi?!
Dialogue: 0,0:14:47.93,0:14:49.80,Main,,0,0,0,,Yok artık!
Dialogue: 0,0:14:48.79,0:14:50.66,Note,,0,0,0,,Devrim Ordusu Karargahı bulundu.
Dialogue: 0,0:14:50.66,0:14:52.88,Main,,0,0,0,,Devrim Ordusu yenilmiş mi?!
Dialogue: 0,0:14:52.88,0:14:56.30,Main,,0,0,0,,Sen-gara yanılmıyorsam\Ndevrimci Dragon'un...
Dialogue: 0,0:14:56.30,0:14:57.50,Main,,0,0,0,,Sabo!
Dialogue: 0,0:14:57.50,0:14:59.75,Main,,0,0,0,,Abim bu!
Dialogue: 0,0:15:00.88,0:15:06.45,Main,,0,0,0,,Sabo-san mı?! Şu Dressrosa'da\Nkarşılaştığını söylediğin diğer abin mi?
Dialogue: 0,0:15:06.45,0:15:11.82,Main,,0,0,0,,Kurmay Başkanı mıymış?!\NDevrim Ordusu'nun en güçlü ikinci ismi!
Dialogue: 0,0:15:11.82,0:15:14.82,Main,,0,0,0,,Ne biçim abilerin var senin be?!
Dialogue: 0,0:15:14.82,0:15:17.66,Main,,0,0,0,,Bu yanındaki Dragon da öyleyse...
Dialogue: 0,0:15:17.66,0:15:22.48,Main,,0,0,0,,Herhâlde! İki yıl önce\Ndeden ne demişti unuttun mu?
Dialogue: 0,0:15:22.90,0:15:25.30,Flashbacks,,0,0,0,,Babanın adı...
Dialogue: 0,0:15:25.30,0:15:29.67,Flashbacks,,0,0,0,,...Monkey D. Dragon. Devrimci!
Dialogue: 0,0:15:29.67,0:15:32.97,Main,,0,0,0,,Devrim Ordusu lideri Dragon.
Dialogue: 0,0:15:32.97,0:15:35.33,Main,,0,0,0,,Baban işte!
Dialogue: 0,0:15:38.04,0:15:41.64,Main,,0,0,0,,Ne?! Babam bu muymuş?!
Dialogue: 0,0:15:41.64,0:15:43.14,Main,,0,0,0,,Neden şaşırıyorsun?!
Dialogue: 0,0:15:43.14,0:15:44.26,Main,,0,0,0,,İlk defa görüyorum!
Dialogue: 0,0:15:44.95,0:15:48.71,Main,,0,0,0,,Luffy'nin babası\NDevrim Ordusu'nun patronu muymuş?!
Dialogue: 0,0:15:48.71,0:15:52.53,Main,,0,0,0,,Vay canına! Vay canına! Garchu!
Dialogue: 0,0:15:52.53,0:15:56.69,Main,,0,0,0,,İki yılda hiç mi araştırmadın?
Dialogue: 0,0:15:56.69,0:16:01.20,Main,,0,0,0,,İnsan böyle ünlü bir babaya sahip olup da\Nhiç mi merak etmez?!
Dialogue: 0,0:16:01.20,0:16:04.18,Main,,0,0,0,,Robin'i uzun süre ağırlamış hem.
Dialogue: 0,0:16:04.18,0:16:08.29,Main,,0,0,0,,Hadi ya! İlk defa görüyorum!\NBana da pek benzemiyormuş.
Dialogue: 0,0:16:08.29,0:16:10.69,Main,,0,0,0,,Ondan ziyade\Nbeni asıl endişelendiren Sabo!
Dialogue: 0,0:16:10.69,0:16:12.03,Main,,0,0,0,,Of...
Dialogue: 0,0:16:13.10,0:16:16.04,Main,,0,0,0,,Tek bir fotoğrafa bakarak\Nsöylemesi zor tabii.
Dialogue: 0,0:16:19.82,0:16:23.51,Main,,0,0,0,,"Karargâhları anonim bir ipucu\Nsayesinde bulundu."
Dialogue: 0,0:16:23.51,0:16:26.88,Main,,0,0,0,,"Fakat Donanma ve Cipher Pol\Nbölgeye iştirak ettiğinde..."
Dialogue: 0,0:16:26.88,0:16:31.00,Main,,0,0,0,,"...Karasakal Korsanları karargâhı\Nçoktan yerlebir etmişti."
Dialogue: 0,0:16:32.67,0:16:35.43,Main,,0,0,0,,Karasakal mı!? O şerefsizler!
Dialogue: 0,0:16:35.43,0:16:40.01,Main,,0,0,0,,Tamam da niye Yonkou Karasakal\NDevrim Ordusu'nun peşine düşsün ki?
Dialogue: 0,0:16:41.08,0:16:46.69,Main,,0,0,0,,Sabo Dressrosa'da şampiyona karşı savaşmıştı ama\Nbir ilgisi olabilir mi acaba?
Dialogue: 0,0:16:43.57,0:16:45.96,Secondary,,0,0,0,,{\an8}Hey, Luffy!
Dialogue: 0,0:16:53.64,0:16:58.95,Main,,0,0,0,,Yonkou Karasakal Cipher Pol'la mücadele\Nettikten sonra bölgeden uzaklaşmış.
Dialogue: 0,0:16:58.95,0:17:00.87,Main,,0,0,0,,Hey, Luffy!
Dialogue: 0,0:17:00.87,0:17:04.17,Main,,0,0,0,,Herhângi bir ölüm raporu yayınlanmamış.
Dialogue: 0,0:17:04.17,0:17:05.35,Main,,0,0,0,,Hey!
Dialogue: 0,0:17:05.35,0:17:11.27,Main,,0,0,0,,Baban yahut ağabeyin-gara\Nyakalansa veya öldürülse kesin haberi yapılırdı.
Dialogue: 0,0:17:11.27,0:17:12.64,Main,,0,0,0,,Hey, Luffy!
Dialogue: 0,0:17:12.64,0:17:15.72,Main,,0,0,0,,Bundan yola çıkarak\Nşimdilik hayattalar diyebiliriz.
Dialogue: 0,0:17:15.72,0:17:17.63,Main,,0,0,0,,Evet! Haklısın!
Dialogue: 0,0:17:17.63,0:17:19.16,Main,,0,0,0,,Hey, Luffy!
Dialogue: 0,0:17:19.16,0:17:20.43,Main,,0,0,0,,Ne var ya deminden beri!
Dialogue: 0,0:17:20.43,0:17:24.60,Main,,0,0,0,,Bizim için yemek pişiriyorsun falan\Nsağ ol ama şu normal mi?!
Dialogue: 0,0:17:26.06,0:17:26.99,Main,,0,0,0,,Neymiş o?
Dialogue: 0,0:17:30.07,0:17:31.86,Main,,0,0,0,,Yangın!
Dialogue: 0,0:17:34.60,0:17:37.36,Main,,0,0,0,,Eyvah, ocağın altını açık unuttum!
Dialogue: 0,0:17:37.36,0:17:39.44,Main,,0,0,0,,Ne?!
Dialogue: 0,0:17:41.44,0:17:42.87,Main,,0,0,0,,Patlama oldu!
Dialogue: 0,0:17:42.87,0:17:44.33,Main,,0,0,0,,Ateşi söndürün!
Dialogue: 0,0:17:48.65,0:17:50.79,Main,,0,0,0,,Durun biraz! Fırtına yaklaşıyor!
Dialogue: 0,0:17:50.79,0:17:52.75,Main,,0,0,0,,Nee?!
Dialogue: 0,0:17:55.31,0:17:57.72,Main,,0,0,0,,Bu ne böyle?! Elektro mu?!
Dialogue: 0,0:17:59.55,0:18:02.22,Main,,0,0,0,,Derhal yelkenleri toplayın!\NYırtılıp gidecekler!
Dialogue: 0,0:18:03.11,0:18:04.64,Main,,0,0,0,,Yangını ne yapacağız?!
Dialogue: 0,0:18:04.64,0:18:07.56,Main,,0,0,0,,Şiddetli yağış başlayacak, yangını söndürür o!
Dialogue: 0,0:18:07.56,0:18:08.79,Main,,0,0,0,,Ne şanslıyız!
Dialogue: 0,0:18:08.79,0:18:10.16,Main,,0,0,0,,Şanslık bir durum yok!
Dialogue: 0,0:18:17.86,0:18:19.24,Main,,0,0,0,,Sen de bir şeyler yap!
Dialogue: 0,0:18:19.24,0:18:22.44,Main,,0,0,0,,Ağır yaralıyım ben!
Dialogue: 0,0:18:29.63,0:18:34.38,Captions,,0,0,170,,{\fad(300,400)}Zou
Dialogue: 0,0:18:35.86,0:18:38.68,Main,,0,0,0,,Yani Carrot denizde mi şimdi?!
Dialogue: 0,0:18:41.93,0:18:45.07,Main,,0,0,0,,Bunu neden daha erken\Nsöylemedin Bariete?
Dialogue: 0,0:18:45.07,0:18:47.72,Main,,0,0,0,,Özür dilerim-degosaru Wanda!
Dialogue: 0,0:18:47.72,0:18:52.24,Main,,0,0,0,,Carrot'a herkese söylemesi\Ngerektiğini tembihledim-degosaru.
Dialogue: 0,0:18:52.24,0:18:54.57,Main,,0,0,0,,Ama o dedi ki...
Dialogue: 0,0:18:55.23,0:18:58.55,Flashbacks,,0,0,0,,Olmaz! Kime söylersem söyleyeyim\Nbeni engellemeye çalışacaklar!
Dialogue: 0,0:19:01.32,0:19:04.31,Main,,0,0,0,,Bir süreliğine\Nsır olarak saklayabilir misin?
Dialogue: 0,0:19:04.31,0:19:05.04,Main,,0,0,0,,{\i1}Şok!{\i0}
Dialogue: 0,0:19:07.03,0:19:08.96,Main,,0,0,0,,Yakalandım-degosaru...
Dialogue: 0,0:19:08.96,0:19:12.50,Main,,0,0,0,,Ama Carrot\Nseni kandırmak için yapmad--
Dialogue: 0,0:19:13.19,0:19:16.41,Main,,0,0,0,,Endişelenme.\NNerede olduğunu öğrenmek yetti.
Dialogue: 0,0:19:16.41,0:19:19.60,Main,,0,0,0,,Kayboldu falan sanıp endişelenmiştim.
Dialogue: 0,0:19:19.60,0:19:22.34,Main,,0,0,0,,Luffyler'le birlikteyse bir şey olmaz.
Dialogue: 0,0:19:33.92,0:19:38.65,Main,,0,0,0,,Dük-sama, siz dinlenmenize bakın lütfen.\Nİsterseniz ekstra muhafız ayarlarım.
Dialogue: 0,0:19:44.20,0:19:48.16,Main,,0,0,0,,Düşman muhtemelen Vivre Kartı'na sahip.
Dialogue: 0,0:19:44.20,0:19:48.16,Note,,0,0,0,,Vivre: Yaşam
Dialogue: 0,0:19:49.95,0:19:52.44,Main,,0,0,0,,Peki bu nasıl mümkün olabilir?!
Dialogue: 0,0:19:53.98,0:19:59.97,Main,,0,0,0,,Umarım o kağıt da Zunesha'nın batırdığı\Nfilo gibi denizde kaybolmuştur.
Dialogue: 0,0:20:00.49,0:20:02.32,Main,,0,0,0,,Gene gelecekler mi dersiniz?
Dialogue: 0,0:20:05.91,0:20:08.00,Main,,0,0,0,,Gözümüzü açık tutsak iyi ederiz.
Dialogue: 0,0:20:08.47,0:20:09.26,Main,,0,0,0,,Peki.
Dialogue: 0,0:20:40.84,0:20:42.95,Thoughts,,0,0,0,,Gelin çabuk!
Dialogue: 0,0:20:48.39,0:20:51.55,Thoughts,,0,0,0,,Çekin beni buradan!
Dialogue: 0,0:21:05.45,0:21:07.36,Captions,,0,0,175,,{\fad(500,0)}Falanca Bir Ülke
Dialogue: 0,0:21:11.24,0:21:15.70,Main,,0,0,0,,Jack-sama Joker'ı almayı başaramamış!
Dialogue: 0,0:21:18.16,0:21:24.80,Main,,0,0,0,,Özetle insan yapımı şeytan meyvesi\NGÜLÜCÜK ticareti... sona erdi.
Dialogue: 0,0:21:41.02,0:21:42.83,Thoughts,,0,0,0,,Bugün ağlak sarhoş modunda.
Dialogue: 0,0:21:45.27,0:21:50.68,Main,,0,0,0,,Artık Gifters* sayısını arttıramayacağız\Nanlamına geliyor bu!
Dialogue: 0,0:21:56.22,0:21:59.96,Main,,0,0,0,,Joker! Ey Joker!
Dialogue: 0,0:21:59.96,0:22:04.05,Main,,0,0,0,,Nasıl yenilirsin sen?!
Dialogue: 0,0:22:06.26,0:22:13.07,Main,,0,0,0,,Tamamı güç kullanıcılarından oluşan en güçlü\Nkorsan grubunu oluşturacağız dememiş miydin?
Dialogue: 0,0:22:22.43,0:22:24.99,Main,,0,0,0,,Ama sen kalk...
Dialogue: 0,0:22:32.96,0:22:40.17,Main,,0,0,0,,...hayalimize kavuşamadan \Nağzı kusmuk kokulu veletlere yenil!
Dialogue: 0,0:22:46.00,0:22:51.64,Main,,0,0,0,,Zavallı Joker! Suç özünde\Ngüçsüz olduğun için sende tabii!
Dialogue: 0,0:22:51.64,0:22:55.72,Main,,0,0,0,,Fakat Hasır Şapka adı çok\Nkonuşulan bir adam. Hafife alırsanız...
Dialogue: 0,0:23:18.09,0:23:20.92,Main,,0,0,0,,Hafife alırsam...
Dialogue: 0,0:23:20.92,0:23:23.21,Main,,0,0,0,,Ne olurmuş?!
Dialogue: 0,0:23:56.16,0:23:59.40,Main,,0,0,0,,Benim kim olduğumu unuttunuz mu?!
Dialogue: 0,0:24:00.20,0:24:03.04,Main,,0,0,0,,{\i1}Huysuz sarhoşa dönüştü!{\i}
Dialogue: 0,0:24:16.34,0:24:20.56,Main,,0,0,0,,Ka-Kaido-sama, sakinleşin lütfen!
Dialogue: 0,0:24:24.87,0:24:29.48,Main,,0,0,0,,Hasır Şapkalı Luffy! Trafalgar Law!
Dialogue: 0,0:24:37.12,0:24:41.09,Main,,0,0,0,,Biliyorum! İkisi de\Nşu falanca nesilden değil mi?!
Dialogue: 0,0:24:45.15,0:24:48.90,Main,,0,0,0,,Veletler Shichibukai'ın tekini alt ettiler\Ndiye kendilerini bir şey sanmaya başlamış!
Dialogue: 0,0:24:49.59,0:24:54.47,Main,,0,0,0,,Kimin işini bozduklarını\Nhatırlatmak lazım onlara!
Dialogue: 0,0:25:04.78,0:25:07.23,Main,,0,0,0,,Görecekler!
Dialogue: 0,0:25:14.07,0:25:17.03,Main,,0,0,0,,Bana bak!
Dialogue: 0,0:25:17.03,0:25:20.20,Main,,0,0,0,,Kendi neslinden o aptallara\Naynen şunu söyleyeceksin:
Dialogue: 0,0:25:21.54,0:25:27.66,Main,,0,0,0,,"Derhal kaçın! \NBiz meğer korsancılık oynuyormuşuz!"
Dialogue: 0,0:25:34.80,0:25:38.41,Main,,0,0,0,,Eustass "Kaptan" Kid!
Dialogue: 0,0:25:46.14,0:25:49.94,Captions,,950,0,350,,{\fad(600,500)\pos(1120,350)}Thousand Sunny
Dialogue: 0,0:25:44.70,0:25:46.74,Main,,0,0,0,,Dondum!
Dialogue: 0,0:25:46.74,0:25:48.46,Main,,0,0,0,,Çatıyı kapattık!
Dialogue: 0,0:25:48.46,0:25:50.02,Main,,0,0,0,,Peki, ellerinize sağlık.
Dialogue: 0,0:25:50.02,0:25:54.16,Main,,0,0,0,,Harika, fırtına dindi!\NUçan çatıyı da kapadık!
Dialogue: 0,0:25:54.64,0:25:58.30,Main,,0,0,0,,Yemeği kurtarmayı başardım,\Nçekinmeden yiyin hadi afiyet olsun!
Dialogue: 0,0:25:58.30,0:26:01.66,Main,,0,0,0,,Yaşasın yemek! Açlıktan ölüyoruz!
Dialogue: 0,0:26:05.40,0:26:07.08,Main,,0,0,0,,Nasıl olmuş, beğendiniz mi?
Dialogue: 0,0:26:08.42,0:26:11.00,Main,,0,0,0,,Kendi özel köri tarifim!
Dialogue: 0,0:26:11.46,0:26:15.27,Main,,0,0,0,,Luffy, çiğ pirinç yiyemeyiz!
Dialogue: 0,0:26:15.27,0:26:17.76,Main,,0,0,0,,Acı morumsu şey de ne?
Dialogue: 0,0:26:17.76,0:26:19.96,Main,,0,0,0,,Balık kemiğinden başka bir şey yok.
Dialogue: 0,0:26:19.96,0:26:21.37,Main,,0,0,0,,Reçeli çok kaçmış!
Dialogue: 0,0:26:21.37,0:26:24.42,Main,,0,0,0,,Açık mavi, yapış yapıp bir şey de var...
Dialogue: 0,0:26:24.42,0:26:27.44,Main,,0,0,0,,Bunu hak edecek ne yaptık?!
Dialogue: 0,0:26:27.44,0:26:31.02,Main,,0,0,0,,Sen kalk o kadar uğraş, beğenmesinler!\NNankörlüğün böylesi!
Dialogue: 0,0:26:34.83,0:26:36.89,Main,,0,0,0,,İğrenç!
Dialogue: 0,0:26:36.89,0:26:37.90,Main,,0,0,0,,Gördün mü?
Dialogue: 0,0:26:37.90,0:26:39.91,Main,,0,0,0,,Yenmez bu be!
Dialogue: 0,0:26:39.91,0:26:41.62,Main,,0,0,0,,Yere dökme!
Dialogue: 0,0:26:42.14,0:26:47.21,Main,,0,0,0,,Yiyecekleri ziyan etmişsin!\NSanji-san görse acayip kızardı!
Dialogue: 0,0:26:49.81,0:26:53.52,Main,,0,0,0,,Dopdolu kilerden geriye\Nhiçbir şey kalmamış!
Dialogue: 0,0:26:53.52,0:26:57.89,Main,,0,0,0,,Evet, ilk birkaç denemem olmadı,\Nhepsini kullandım!
Dialogue: 0,0:26:57.89,0:27:01.87,Main,,0,0,0,,Ciddi misin sen?! \NHepimize haftalarca yetecek yiyecek vardı!
Dialogue: 0,0:27:01.87,0:27:03.32,Main,,0,0,0,,Çok açsınızdır diye düşünüp\Nbol yaptım!
Dialogue: 0,0:27:04.43,0:27:06.05,Main,,0,0,0,,Ne gülüyorsun?!
Dialogue: 0,0:27:07.59,0:27:10.23,Main,,0,0,0,,Şimdi ne yapacağız?!
Dialogue: 0,0:27:10.76,0:27:11.96,Main,,0,0,0,,Luffy...
Dialogue: 0,0:27:13.02,0:27:16.08,Main,,0,0,0,,Çok açım...
Dialogue: 0,0:27:16.08,0:27:19.53,Main,,0,0,0,,Sanji-san, kurtar bizi!
Dialogue: 0,0:27:20.16,0:27:27.94,Narrator,,0,0,0,,{\i1}Ve böylece Luffyler daha seyahatlerinin ilk gününden yiyecek sıkıntısı çekmeye başladılar.{\{\i}
Dialogue: 0,0:27:29.42,0:27:34.75,Captions,,0,0,300,,{\fad(500,500)\pos(180,335)}Bir Kaç Gün Sonra,\NBig Mom'ın Gemisi
Dialogue: 0,0:27:29.42,0:27:34.79,Lyrics,,0,0,0,,♪ Gemi! Gemi! Gemi! Gemi! ♪
Dialogue: 0,0:27:37.36,0:27:39.04,Main,,0,0,0,,Kar yağıyor sanmıştım ama...
Dialogue: 0,0:27:40.43,0:27:42.76,Main,,0,0,0,,Pamuk Şeker Kar-soir!
Dialogue: 0,0:27:45.46,0:27:48.52,Main,,0,0,0,,Deminden beri\NDenden Mushi'n susmak bilmedi.
Dialogue: 0,0:27:49.24,0:27:52.79,Main,,0,0,0,,Uyarı sinyalleri alıyor-bon.
Dialogue: 0,0:27:52.79,0:27:56.21,Main,,0,0,0,,Çoktan Mama'nın bölgesine\Ngirdiğimiz anlamına geliyor bu{\i1}-sufle.{\i0}
Dialogue: 0,0:27:56.21,0:27:59.00,Main,,0,0,0,,Bu uyarı sinyalleri oraya da ulaşıyor mu?
Dialogue: 0,0:27:59.00,0:28:03.09,Main,,0,0,0,,Kafan çalışıyormuş! Orası TARTE 28.
Dialogue: 0,0:28:03.09,0:28:09.89,Main,,0,0,0,,Orası Big Mom Korsanları'ndan bir grubun hazır vaziyette beklediği bir ileri karakol-millefeuille!
Dialogue: 0,0:28:09.89,0:28:14.29,Main,,0,0,0,,Bu Mama'nın gemilerinden biri olmasaydı\Nanında havaya uçururlardı bizi!
Dialogue: 0,0:28:16.51,0:28:21.74,Main,,0,0,0,,Ee, karar verdin mi peki?\Nİnatçılık etmemeni öneririm.
Dialogue: 0,0:28:21.74,0:28:29.02,Main,,0,0,0,,Germa 66'yla birlikte bize,\NBig Mom Korsanlarına katılacağına yemin et-bon.
Dialogue: 0,0:28:29.02,0:28:33.48,Main,,0,0,0,,Babanın dileği bu-amor.
Dialogue: 0,0:28:33.94,0:28:36.71,Main,,0,0,0,,O heriften bahsetme bana!\NSinirlerim tepeme çıkıyor!
Dialogue: 0,0:28:37.58,0:28:40.50,Main,,0,0,0,,Onunla aramızda hiçbir bağ kalmadı!
Dialogue: 0,0:28:47.91,0:28:50.87,Main,,0,0,0,,Sizinle de bu meseleye\Nbir son vermeye geliyorum!
Dialogue: 0,0:28:57.24,0:28:59.10,Main,,0,0,0,,Böyle yapma şimdi!
Dialogue: 0,0:28:59.10,0:29:02.85,Main,,0,0,0,,Mama tahmin ettiğinden\Ndaha misafirperver biridir.
Dialogue: 0,0:29:02.85,0:29:08.53,Main,,0,0,0,,Elbette o aptal Hasır Şapka'nın\Ntayfasından olduğunu da biliyor{\i1}-il vous plaît.{\i0}
Dialogue: 0,0:29:08.53,0:29:16.33,Main,,0,0,0,,Fakat bir zamanlar Doğu Mavi'deki Deniz Restoranı'nda şef olduğun için sana çok değer veriyor{\i1}-bon.{\i0}
Dialogue: 0,0:29:18.24,0:29:22.97,Main,,0,0,0,,Hatta aşçılık konusunda yetenekliysen çok daha iyi bir şekilde bile ağırlanabilirsin{\i1}-jour.{\i0}
Dialogue: 0,0:29:22.97,0:29:24.73,Main,,0,0,0,,Hadi lan oradan!
Dialogue: 0,0:29:24.73,0:29:30.35,Main,,0,0,0,,Bu ellerle yalnızca dostlarıma\Nyemek pişiririm, anladın mı?!
Dialogue: 0,0:29:35.42,0:29:39.46,Main,,0,0,0,,Sırf onlar için cehennemin\Nortasında bile eğittim kendimi!
Dialogue: 0,0:29:44.67,0:29:50.29,Main,,0,0,0,,Yaptığım yemeklere hasret, \Ngözyaşları içindeki hallerini hayal edebiliyorum!
Dialogue: 0,0:29:51.06,0:29:52.64,Main,,0,0,0,,Güldürdün beni!
Dialogue: 0,0:29:53.26,0:29:57.61,Main,,0,0,0,,Dostları öldürüldükten sonra bile hiçbir şey\Nolmamış gibi hayatına devam edenlere...
Dialogue: 0,0:29:59.14,0:30:01.74,Main,,0,0,0,,...pişirecek yemeğim yok!
Dialogue: 0,0:30:01.74,0:30:05.65,Main,,0,0,0,,Pekoms'dan bahsediyorsun sanırım.
Dialogue: 0,0:30:05.65,0:30:10.37,Main,,0,0,0,,Maalesef işine duygularını karıştırdı.\NBege'in yaptığı doğruydu.
Dialogue: 0,0:30:12.14,0:30:14.16,Main,,0,0,0,,Baron Tamago.
Dialogue: 0,0:30:15.98,0:30:17.54,Main,,0,0,0,,Vito!
Dialogue: 0,0:30:17.54,0:30:22.38,Main,,0,0,0,,Whole Cake Adası'ndan Pudding-sama'nın\Nfotoğrafını göndermişler-rero!
Dialogue: 0,0:30:22.93,0:30:25.16,Main,,0,0,0,,Alışman için.
Dialogue: 0,0:30:25.16,0:30:31.64,Main,,0,0,0,,İlk kez tanışacağın biriyle evlenmenin zor olacağını onlar da tahmin etmiş olmalılar, ne düşünceliler!
Dialogue: 0,0:30:31.64,0:30:36.02,Main,,0,0,0,,Bir şeye alışacağım falan yok aptal herif!\NKimseyle evlenmeye niyetim yok!
Dialogue: 0,0:30:36.02,0:30:37.67,Main,,0,0,0,,Bak işte ölmezsin ya!
Dialogue: 0,0:30:37.67,0:30:40.35,Main,,0,0,0,,Kes be! Yaklaşma yanıma, tekmeyi yersin!
Dialogue: 0,0:30:40.35,0:30:41.79,Main,,0,0,0,,Hadi ama şimdi...
Dialogue: 0,0:30:41.79,0:30:43.50,Main,,0,0,0,,Yeter ama...
Dialogue: 0,0:30:52.44,0:30:54.93,Main,,0,0,0,,Nişanlın bu işte.
Dialogue: 0,0:30:54.93,0:31:00.73,Main,,0,0,0,,Charlotte Ailesi'nin 35. kızı, Charlotte Pudding-sama!
Dialogue: 0,0:31:00.73,0:31:03.83,OP11 Credits,,0,0,0,,Editing:\NFeeso,\NGalaxy 9000\N\NQuality Assurance:\NFeeso,\NGalaxy 9000,\NGrug,\NPepperjack\N\NSoundtracking:\NHalee\N\NTiming:\NLance\N\NKaraoke:\NKaitouYahiko\N\NGraphics:\NDatenshi\N\NTranslation:\NCrunchyroll
Dialogue: 0,0:00:00.82,0:00:06.82,Lyrics,,0,0,0,karaoke,♪ Görmedim dünyanın sonunu kendi gözlerimle hiç. ♪
Dialogue: 0,0:00:06.82,0:00:13.95,Lyrics,,0,0,0,karaoke,♪ O yüzden çıktım yola sizinle, bunu yapmak için! ♪
Dialogue: 0,0:00:23.67,0:00:27.00,Lyrics,,0,0,0,karaoke,♪ Bir denizden diğerine yol alırken,...
Dialogue: 0,0:00:29.06,0:00:31.91,Lyrics,,0,0,0,karaoke,...bunun sadece bir peri masalı olduğunu söylemek. ♪
Dialogue: 0,0:00:31.92,0:00:38.78,Lyrics,,0,0,0,karaoke,♪ Gerçek, kurgudan daha tuhaf değil mi? ♪
Dialogue: 0,0:00:39.94,0:00:43.56,Lyrics,,0,0,0,karaoke,♪ Fakat sırt çevirme hiçbirine ♪
Dialogue: 0,0:00:43.56,0:00:50.04,Lyrics,,0,0,0,karaoke,♪ Sağduyu dedikleri zihnidir toplulukların! ♪
Dialogue: 0,0:00:51.36,0:00:57.41,Lyrics,,0,0,0,karaoke,♪ Görmedim dünyanın sonunu kendi gözlerimle hiç. ♪
Dialogue: 0,0:00:57.41,0:01:01.96,Lyrics,,0,0,0,karaoke,♪ O yüzden gitmemiz lazım Kaptan Özgür-Ruh! ♪
Dialogue: 0,0:01:01.96,0:01:04.72,Lyrics,,0,0,0,karaoke,♪ Kim demiş imkansız diye,...
Dialogue: 0,0:01:04.71,0:01:07.89,Lyrics,,0,0,0,karaoke,...daha hiçbir şey başlamadan! ♪
Dialogue: 0,0:01:07.88,0:01:12.72,Lyrics,,0,0,0,karaoke,♪ Her şeyi bilmek istiyorum ve şimdi bilebiliriz de... ♪
Dialogue: 0,0:01:12.72,0:01:18.68,Lyrics,,0,0,0,karaoke,♪ Bilebiliriz, bilebilirsin! Şu anda... ♪
Dialogue: 0,0:01:19.06,0:01:24.10,Lyrics,,0,0,0,karaoke,♪ Bilebiliriz, bilebilirim! Bu harika hissi... ♪
Dialogue: 0,0:01:24.39,0:01:31.32,Lyrics,,0,0,0,karaoke,♪ Hemen, şimdi, bilebiliriz! ♪
Dialogue: 0,0:01:37.34,0:01:38.64,Lyrics,,0,0,0,karaoke,♪ Evet, bilebiliriz! ♪
