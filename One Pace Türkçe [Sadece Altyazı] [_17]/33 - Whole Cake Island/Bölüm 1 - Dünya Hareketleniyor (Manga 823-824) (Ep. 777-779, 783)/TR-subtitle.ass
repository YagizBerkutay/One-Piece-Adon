Dialogue: 0,0:01:41.84,0:01:45.65,Title,,0,0,240,,{\fad(600,600)}Dünya Hareketleniyor
Dialogue: 0,0:01:45.87,0:01:49.40,Captions,,0,0,240,,{\fad(500,0)}Arabasta\NKum Ülkesi
Dialogue: 0,0:01:54.62,0:01:56.01,Main,,0,0,0,,İleri!
Dialogue: 0,0:02:05.31,0:02:06.60,Main,,0,0,0,,O kız...
Dialogue: 0,0:02:08.09,0:02:09.74,Main,,0,0,0,,Vivi-sama bu!
Dialogue: 0,0:02:09.74,0:02:11.37,Main,,0,0,0,,İyi yolculuklar!
Dialogue: 0,0:02:11.37,0:02:12.79,Main,,0,0,0,,Vivi{\i1}-sama!{\i0}
Dialogue: 0,0:02:12.79,0:02:14.76,Main,,0,0,0,,Majesteleri!
Dialogue: 0,0:02:22.08,0:02:23.58,Main,,0,0,0,,Hey, Koza.
Dialogue: 0,0:02:24.53,0:02:27.32,Main,,0,0,0,,Vivi-chan epey heyecanlı gibiydi.
Dialogue: 0,0:02:27.32,0:02:30.18,Main,,0,0,0,,Korsan ruhu canlanmıştır kesin.
Dialogue: 0,0:02:30.18,0:02:32.54,Main,,0,0,0,,Sonunda biraz olsun prenses gibi\Ndavranmaya başladı derken...
Dialogue: 0,0:02:36.34,0:02:40.22,Main,,0,0,0,,Evet, Hina ben.\NArabasta'dan az önce ayrıldık.
Dialogue: 0,0:02:40.22,0:02:44.62,Main,,0,0,3,,Nefertari Ailesi'ni sağ salim Mariejoa'ya ulaştıracağız.
Dialogue: 0,0:02:40.72,0:02:45.47,Captions,,0,0,240,,{\fad(500,250)}Donanma Karargahı Tuğamirali\N"Kara Kafes" Hina
Dialogue: 0,0:02:44.62,0:02:47.46,Main,,0,0,3,,Hina-sama, size çiçek getirdim!
Dialogue: 0,0:02:47.46,0:02:49.48,Main,,0,0,0,,Sizin için kendi ellerimle topladım!
Dialogue: 0,0:02:49.48,0:02:50.86,Main,,0,0,0,,İstemiyorum.
Dialogue: 0,0:02:51.40,0:02:54.90,Main,,0,0,0,,Django, Fullbody!\NDerhal yerlerinize geçin!
Dialogue: 0,0:02:54.90,0:02:56.27,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:02:58.07,0:03:01.14,Main,,0,0,0,,Vivi{\i1}-sama! {\i0}Vivi{\i1}-sama!{\i0}
Dialogue: 0,0:03:02.69,0:03:06.42,Main,,0,0,0,,Orası tehlikeli Vivi-sama!
Dialogue: 0,0:03:06.42,0:03:09.48,Main,,0,0,3,,Lütfen o tehlikeli yerden derhal inin!
Dialogue: 0,0:03:07.20,0:03:11.83,Captions,,0,0,240,,{\fad(500,500)}Arabasta Krallığı Prensesi\NNefertari Vivi
Dialogue: 0,0:03:09.48,0:03:11.92,Main,,0,0,3,,Vivi-{\i1}sama!{\i0}
Dialogue: 0,0:03:12.78,0:03:15.27,Main,,0,0,0,,Rüzgar ne güzel esiyor!
Dialogue: 0,0:03:15.27,0:03:19.97,Main,,0,0,0,,Tuhaf bir kuş gelip\Nsizi kaçırırsa ne yapacaksınız?!
Dialogue: 0,0:03:19.97,0:03:25.92,Main,,0,0,0,,Keskin nişancının biri uzaklardan sizi hedef alıyorsa,\Nyahut göklerden meteor falan düşerse çok kötü olur!
Dialogue: 0,0:03:25.92,0:03:27.38,Main,,0,0,0,,Boşa endişeleniyorsun.
Dialogue: 0,0:03:28.18,0:03:30.16,Main,,0,0,0,,Vivi-sama bir zamanlar korsandı.
Dialogue: 0,0:03:31.95,0:03:36.08,Main,,0,0,0,,Donanma dibimizdeyken\Nneler söylüyorsun sen Pell, delirdin mi?!
Dialogue: 0,0:03:38.69,0:03:41.48,Main,,0,0,0,,Kendinizi fazla zorlamayın, Majesteleri.
Dialogue: 0,0:03:41.48,0:03:45.10,Main,,0,0,0,,İyi hissetmiyorsanız derhal geri dönebiliriz.
Dialogue: 0,0:03:45.10,0:03:48.22,Main,,0,0,0,,Bir şeyim yok.
Dialogue: 0,0:03:48.74,0:03:56.13,Main,,0,0,3,,{\an8}Nico Robin'le tanıştığım o günden beri \NDünya Hükümeti'ne sormak istediğim bir soru var kafamda.
Dialogue: 0,0:03:50.41,0:03:56.13,Captions,,0,0,240,,{\fad(500,0)}Arabasta Krallığı Kralı\NNefertari Cobra
Dialogue: 0,0:03:56.53,0:03:59.32,Flashbacks,,0,0,0,,Tek isteğim tarihi öğrenmekti...
Dialogue: 0,0:04:01.32,0:04:05.05,Flashbacks,,0,0,0,,Hayallerimin önünde çok fazla düşman var...
Dialogue: 0,0:04:05.55,0:04:07.54,Main,,0,0,0,,Ponegliflerle alakalı mı?
Dialogue: 0,0:04:09.20,0:04:13.83,Main,,0,0,0,,Gerçekleşecek Reverie'ye\Nne pahasına olursa olsun katılacağım!
Dialogue: 0,0:04:13.83,0:04:16.28,Main,,0,0,0,,Mümkünse yıllar önce...
Dialogue: 0,0:04:16.28,0:04:21.42,Main,,0,0,0,,...o zamanki Nefertari Ailesi Kralı'nın\Ndünyaya ne yaptığını bilmek istiyorum.
Dialogue: 0,0:04:26.37,0:04:27.85,Main,,0,0,0,,Eyvah! Eyvah!
Dialogue: 0,0:04:27.85,0:04:30.15,Main,,0,0,0,,Eyvah! Eyvaöeh...
Dialogue: 0,0:04:41.39,0:04:44.99,Main,,0,0,0,,Yeter ama artık Vivi-sama!
Dialogue: 0,0:04:50.39,0:04:52.73,Main,,0,0,0,,Baba, nasıl oldun?
Dialogue: 0,0:04:53.65,0:04:58.02,Main,,0,0,0,,Pek iyi değilim.\NArtık fazla zamanım kalmadı sanırım.
Dialogue: 0,0:04:58.02,0:05:01.15,Main,,0,0,0,,Ölmeden önce\Nkızımın mürüvvetini görebilseydim...
Dialogue: 0,0:05:04.28,0:05:08.10,Main,,0,0,0,,Hiç adil değil ama! Gene hastalığını\Nkullanarak beni kandırmaya çalışıyorsun!
Dialogue: 0,0:05:08.12,0:05:11.16,Main,,0,0,0,,Elimizde potansiyel eşlere ait\Ntonla fotoğraf var!
Dialogue: 0,0:05:13.55,0:05:14.97,Main,,0,0,0,,Hepsini atacağım!
Dialogue: 0,0:05:15.96,0:05:18.67,Captions,,0,0,175,,{\fad(250,0)}Doğu Mavi - Loguetown
Dialogue: 0,0:05:23.16,0:05:26.03,Main,,0,0,0,,Tahta geçişinizi kutlarım efendim.
Dialogue: 0,0:05:26.03,0:05:32.68,Main,,0,0,0,,Otelimiz dört yılda bir Reverie'ye giden\Naileler için özel olarak inşa edilmiştir.
Dialogue: 0,0:05:32.68,0:05:35.76,Main,,0,0,0,,Umarım hoşunuza gider.
Dialogue: 0,0:05:39.01,0:05:42.73,Main,,0,0,3,,Çok da, pek de hoş değil değil.
Dialogue: 0,0:05:39.23,0:05:42.73,Captions,,0,0,240,,{\fad(500,0)}Goa Krallığı Kraliçesi\NSarie Nantokanette
Dialogue: 0,0:05:42.73,0:05:44.52,Main,,0,0,0,,Değil mi aşkım?
Dialogue: 0,0:05:44.52,0:05:46.36,Main,,0,0,0,,Normal.
Dialogue: 0,0:05:46.36,0:05:51.70,Main,,0,0,0,,Gold Roger'ın idam edildiği\Nyer manzarasından başka bir özelliği yok.
Dialogue: 0,0:05:51.70,0:05:55.29,Main,,0,0,0,,Öy-Öyleyse yorucu yolculuğunuzun\Nardından size iyi dinlenmeler.
Dialogue: 0,0:05:55.29,0:05:56.77,Main,,0,0,0,,Kral Sterry.
Dialogue: 0,0:05:56.77,0:06:00.88,Main,,0,0,0,,Evet, size bakmak bile beni rahatsız ediyor.\NYıkılın karşımdan, süprüntüler.
Dialogue: 0,0:06:00.88,0:06:02.51,Main,,0,0,0,,Em-Em-Emredersiniz!
Dialogue: 0,0:06:12.88,0:06:15.85,Narrator,,0,0,0,,Bütün ülkelerdeki\Nbu ufak hareketliliğin nedeni...
Dialogue: 0,0:06:15.85,0:06:18.73,Narrator,,0,0,0,,...dört yılda bir,\Ndünyanın merkezinde bulunan...
Dialogue: 0,0:06:18.73,0:06:23.52,Narrator,,0,0,0,,...Kutsal Topraklar Marijoa'da yapılan\NReverie'nin gerçekleşecek olması.
Dialogue: 0,0:06:25.07,0:06:30.87,Narrator,,0,0,0,,Bu büyük ve önemli toplantıda tüm dünyadan\N50 ulusun liderleri bir araya gelecek...
Dialogue: 0,0:06:30.87,0:06:38.58,Narrator,,0,0,0,,...ve dünyada meydana gelen olayları tartışıp\Ngelecek için yönergeleri belirleyecekler.
Dialogue: 0,0:06:38.58,0:06:47.24,Narrator,,0,0,0,,Fakat her biri tedbirli ve kurnaz olan bu liderler arasında işler hiçbir zaman düzgün ilerlemez.
Dialogue: 0,0:06:51.85,0:06:55.62,Main,,0,0,3,,Happosui Ordusu lideri Don Chinjao...
Dialogue: 0,0:06:54.85,0:06:59.86,Captions,,0,0,173,,{\fad(500,0)}Batı Mavi - Kano Krallığı
Dialogue: 0,0:06:55.62,0:06:59.86,Main,,0,0,3,,Daha doğrusu yeni lideriniz Sai henüz dönmedi mi?
Dialogue: 0,0:06:59.86,0:07:03.61,Main,,0,0,0,,Hasır Şapkalar Donquixote Ailesi'ni\Ndevirdiğinden beri...
Dialogue: 0,0:07:03.61,0:07:06.82,Main,,0,0,0,,...düşmanımız onlardan silah alamaz oldu.
Dialogue: 0,0:07:06.82,0:07:10.15,Main,,0,0,0,,Bu sayede savaş da sona ermiş oldu.
Dialogue: 0,0:07:10.15,0:07:13.57,Main,,0,0,0,,Görünüşe bakılırsa Reverie'ye yetişebileceğiz.
Dialogue: 0,0:07:15.22,0:07:18.96,Main,,0,0,0,,Söylemek istediğimiz tonla şey var!
Dialogue: 0,0:07:18.96,0:07:23.28,Captions,,0,0,240,,{\fad(500,500)}Red Line'ın Altındaki Deniz Tabanı\NRyugu Krallığı
Dialogue: 0,0:07:25.60,0:07:27.55,Main,,0,0,0,,Benim için imkansız bu!
Dialogue: 0,0:07:27.55,0:07:28.89,Main,,0,0,0,,Korkuyorum!
Dialogue: 0,0:07:32.01,0:07:35.86,Main,,0,0,0,,Luffy-sama bana söz verdi.
Dialogue: 0,0:07:35.86,0:07:41.98,Main,,0,0,0,,{\an8}Onunla tekrar karşılaştığımızda beni yüzeydeki gerçek ormana götürecek!
Dialogue: 0,0:07:38.47,0:07:41.98,Captions,,0,0,240,,{\fad(500,0)}Ryugu Krallığı Prensesi,\NShirahoshi
Dialogue: 0,0:07:41.98,0:07:46.98,Main,,0,0,0,,Luffy-kun'un sizi çok daha\Nötesine götüreceğine eminim!
Dialogue: 0,0:07:46.98,0:07:52.03,Main,,0,0,0,,Fakat bu seferlik doğrudan,\Nyalnızca Mariejoa'ya gitmeniz gerekiyor.
Dialogue: 0,0:07:52.03,0:07:57.28,Main,,0,0,0,,Ağabeylerin ve Neptün Ordusu da\Nsizinle gelecek Prenses Shirahoshi!
Dialogue: 0,0:07:57.28,0:07:58.85,Main,,0,0,0,,Eyvah ki ne eyvah...
Dialogue: 0,0:07:58.85,0:08:04.06,Main,,0,0,3,,{\an8}Baba, bu seferlik onu götürmesek olmaz mi-re-do?
Dialogue: 0,0:08:00.54,0:08:04.06,Captions,,0,0,240,,{\fad(500,0)}Ryugu Krallığı Prensi,\NRyuboshi
Dialogue: 0,0:08:04.33,0:08:09.71,Captions,,0,0,240,,{\fad(500,500)}Ryugu Krallığı Prensi,\NManboshi
Dialogue: 0,0:08:04.06,0:08:07.27,Main,,0,0,3,,Evet! Yapılan ankette Balık Adam Adası'nı...
Dialogue: 0,0:08:07.27,0:08:09.56,Main,,0,0,3,,...başka yere taşıyalım diyen tonla kişi vardı!
Dialogue: 0,0:08:09.56,0:08:11.46,Main,,0,0,0,,Hey mambo!
Dialogue: 0,0:08:11.46,0:08:18.85,Main,,0,0,3,,İnsanlara güvenmiyoruz demekten farkı yok bunun-jamon.
Dialogue: 0,0:08:14.09,0:08:18.85,Captions,,0,0,240,,{\fad(500,0)}Ryugu Krallığı Kralı,\NNeptune
Dialogue: 0,0:08:18.85,0:08:20.73,Main,,0,0,0,,Ne yapmalıyız?
Dialogue: 0,0:08:21.23,0:08:24.72,Captions,,0,0,240,,{\fad(500,0)}Ryugu Krallığı Prensi,\NFukaboshi
Dialogue: 0,0:08:20.74,0:08:24.72,Main,,0,0,3,,Shirahoshi, Hasır Şapkalar sana ne öğretti?!
Dialogue: 0,0:08:24.72,0:08:28.86,Main,,0,0,0,,Annemiz Otohime'nin\Ndört gözle beklediği bir toplantıydı bu.
Dialogue: 0,0:08:30.86,0:08:32.53,Main,,0,0,0,,Bizimle gel!
Dialogue: 0,0:08:34.54,0:08:37.30,Captions,,0,0,240,,Güney Mavi,\NKötücül Kara Drum Krallığı
Dialogue: 0,0:08:37.30,0:08:39.25,Main,,0,0,0,,Wapol-sama, yeni haberlerim var!
Dialogue: 0,0:08:40.45,0:08:46.27,Main,,0,0,0,,Bir zamanlar hüküm sürdüğünüz\NDrum Krallığı, yeni adıyla Sakura Krallığı...
Dialogue: 0,0:08:46.27,0:08:49.55,Main,,0,0,0,,...yeni kral Dalton önderliğinde\NReverie'ye katılacakmış!
Dialogue: 0,0:08:49.55,0:08:52.39,Main,,0,0,0,,Ne?! Sakura Krallığı mı?!
Dialogue: 0,0:08:52.39,0:08:53.97,Main,,0,0,0,,Canı çıkası Dalton...
Dialogue: 0,0:08:55.43,0:08:59.44,Main,,0,0,0,,Reverie'de ne yapsam da\Nalaşağı etsem onu?!
Dialogue: 0,0:09:01.35,0:09:05.62,Captions,,0,0,240,,{\fad(500,0)}Grand Line\NSakura Krallığı
Dialogue: 0,0:09:01.36,0:09:05.62,Main,,0,0,3,,Doğru mu bu Dr Kureha? Bu konuda ciddi misiniz?
Dialogue: 0,0:09:05.64,0:09:08.65,Captions,,0,0,240,,{\fad(300,0)}Sakura Krallığı Kralı,\NDalton
Dialogue: 0,0:09:05.62,0:09:08.65,Main,,0,0,3,,Neden böyle mutsuz görünüyorsunuz?!
Dialogue: 0,0:09:08.65,0:09:11.78,Main,,0,0,0,,Ben de geminizin doktoru olacağım işte!
Dialogue: 0,0:09:11.78,0:09:13.82,Main,,0,0,0,,Mutlu olmadın mı?
Dialogue: 0,0:09:15.24,0:09:17.80,Captions,,0,0,240,,{\fad(0,0)}Tutku Krallığı\NDressrosa
Dialogue: 0,0:09:15.24,0:09:17.80,Main,,0,0,3,,Ne?! Ben de gelebilir miyim?!
Dialogue: 0,0:09:17.80,0:09:21.29,Main,,0,0,0,,Elbette! Nedimem olarak gelmek ister misin?
Dialogue: 0,0:09:21.29,0:09:24.14,Main,,0,0,0,,Evet! Çok teşekkür ederim, Viola-san!
Dialogue: 0,0:09:24.14,0:09:26.53,Main,,0,0,0,,Çok sevinçli görünüyorsun Rebecca!
Dialogue: 0,0:09:26.53,0:09:27.75,Main,,0,0,0,,Öyleyim!
Dialogue: 0,0:09:29.34,0:09:32.85,Main,,0,0,0,,Acaba annemin elbisesini mi giysem?!
Dialogue: 0,0:09:34.86,0:09:37.02,Main,,0,0,0,,Evet, harika olur!
Dialogue: 0,0:09:38.09,0:09:41.35,Captions,,0,0,175,,{\fad(250,0)}Prodence Krallığı
Dialogue: 0,0:09:41.35,0:09:44.79,Main,,0,0,3,,Kral Riku, Donanma refakâtini reddettim!
Dialogue: 0,0:09:42.77,0:09:47.02,Captions,,0,0,240,,{\fad(500,0)}Prodence Krallığı Kralı\N2. Elizabello
Dialogue: 0,0:09:44.79,0:09:47.02,Main,,0,0,3,,Kutsal Topraklar'a birlikte gidelim mi?!
Dialogue: 0,0:09:48.31,0:09:54.07,Captions,,0,0,240,,{\fad(300,500)}Dressrosa Kralı\N3. Riku Doldo
Dialogue: 0,0:09:48.67,0:09:51.44,Main,,0,0,3,,Nedense herkes bir tatil havasında!
Dialogue: 0,0:09:51.44,0:09:52.91,Main,,0,0,3,,{\i1}Öyle olsa ne olur?{\{\i0}
Dialogue: 0,0:09:53.78,0:09:57.31,Main,,0,0,3,,{\i1}Reverie festival gibi bir şey!{\i}
Dialogue: 0,0:09:57.31,0:10:00.06,Narrator,,0,0,0,,Bu sırada Luffyler'in grupta...
Dialogue: 0,0:10:00.06,0:10:02.95,Main,,0,0,0,,Hey... sancak tarafına...
Dialogue: 0,0:10:02.95,0:10:04.42,Main,,0,0,0,,Peki...
Dialogue: 0,0:10:05.78,0:10:06.87,Main,,0,0,0,,Oldu mu?
Dialogue: 0,0:10:06.87,0:10:10.29,Main,,0,0,0,,Biraz daha...
Dialogue: 0,0:10:10.29,0:10:12.25,Main,,0,0,0,,Bu ne, bu ne, bu ne şimdi?!
Dialogue: 0,0:10:12.25,0:10:15.16,Main,,0,0,0,,Kendinize gelin biraz!\NBatacağız yoksa!
Dialogue: 0,0:10:16.74,0:10:22.26,Main,,0,0,0,,Kapa çeneni be! Filin üstünden pat diye atladığın için hepimiz bu haldeyiz, aptal!
Dialogue: 0,0:10:22.26,0:10:28.44,Main,,0,0,0,,Teşekkür ederim. Yaşamanın ne tatlı\Nbir şey olduğunu şimdi anlıyorum.
Dialogue: 0,0:10:28.44,0:10:31.48,Main,,0,0,0,,Ama bunu yanına bırakmam!
Dialogue: 0,0:10:33.07,0:10:37.48,Main,,0,0,0,,Bak ama... Gene rotadan çıktık.
Dialogue: 0,0:10:37.48,0:10:40.62,Main,,0,0,0,,İskele tarafına...
Dialogue: 0,0:10:41.45,0:10:44.02,Main,,0,0,0,,Tamamdır! Bana bırakın!
Dialogue: 0,0:10:44.02,0:10:47.11,Main,,0,0,0,,Biraz onun enerjisini örnek alın...
Dialogue: 0,0:10:47.96,0:10:51.54,Main,,0,0,0,,Vay canına!\NGerçekten de denizin üstündeyim!
Dialogue: 0,0:10:52.42,0:10:55.93,Captions,,0,0,240,,{\fad(500,0)}Mink Silahşörlerinin Bir Üyesi\NCarrot
Dialogue: 0,0:10:52.48,0:10:55.93,Main,,0,0,3,,Bu ağır gemi gerçekten de suyun üstünde duruyor!
Dialogue: 0,0:10:55.93,0:10:58.97,Main,,0,0,0,,Ne-Neden buradasın?!
Dialogue: 0,0:11:01.37,0:11:03.76,Main,,0,0,0,,Neeee!!!
Dialogue: 0,0:11:06.72,0:11:07.98,Main,,0,0,0,,Carrot?!
Dialogue: 0,0:11:08.61,0:11:10.92,Main,,0,0,0,,Carrot, burada ne arıyorsun?!
Dialogue: 0,0:11:13.76,0:11:15.82,Main,,0,0,0,,Ben de geldim!
Dialogue: 0,0:11:15.82,0:11:17.37,Main,,0,0,0,,Garchu!
Dialogue: 0,0:11:19.28,0:11:20.32,Main,,0,0,0,,Nami!
