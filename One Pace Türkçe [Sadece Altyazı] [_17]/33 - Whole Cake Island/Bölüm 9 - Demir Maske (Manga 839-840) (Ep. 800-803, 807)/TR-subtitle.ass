Dialogue: 0,0:01:42.26,0:01:51.41,Title,,0,0,230,,{\fad(1900,2200)}Demir Maske
Dialogue: 0,0:01:52.02,0:01:55.59,Main,,0,0,0,,Ellerinize sağlık, Ichiji ve Niji.
Dialogue: 0,0:02:00.10,0:02:06.60,Main,,0,0,0,,Broc Coli'deki savaş, Doflamingo rejiminin\Ndüşmesinin bir diğer kurbanıydı.
Dialogue: 0,0:02:07.52,0:02:14.71,Main,,0,0,0,,Birlikler Doflamingo'dan silah temin edemeyince bizden yardım istediler.
Dialogue: 0,0:02:16.12,0:02:19.45,Main,,0,0,0,,Düşmanlarına yetebileceklerini düşünmüyorlardı.
Dialogue: 0,0:02:19.45,0:02:24.02,Main,,0,0,0,,Gereksiz hareketlerin kan\Ndöktüğünün güzel bir kanıtı.
Dialogue: 0,0:02:24.45,0:02:26.46,Main,,0,0,0,,Saçma sebeplere bağlama.
Dialogue: 0,0:02:26.46,0:02:30.36,Main,,0,0,0,,Kim parayı verirse düdüğü çalıyor, o kadar.
Dialogue: 0,0:02:30.36,0:02:34.53,Main,,0,0,0,,İki tarafı da ezersek\Ndaha fazla kazanabiliriz.
Dialogue: 0,0:02:34.53,0:02:37.50,Main,,0,0,0,,O zaman korsandan farksız oluruz.
Dialogue: 0,0:02:37.51,0:02:42.34,Main,,0,0,0,,Hala Dünya Hükümeti\Ntarafından tanınan bir ulusuz.
Dialogue: 0,0:02:42.93,0:02:47.15,Main,,0,0,0,,Bu arada baba, Reverie yaklaşıyor.
Dialogue: 0,0:02:47.15,0:02:48.43,Main,,0,0,0,,Evet.
Dialogue: 0,0:02:49.13,0:02:55.42,Main,,0,0,0,,Ne var ki büyük ihtimalle Reverie'ye\Nkatılma hakkımızı elimizden alacaklar.
Dialogue: 0,0:02:55.42,0:02:57.53,Main,,0,0,0,,Hepiniz buna hazır olun.
Dialogue: 0,0:02:57.93,0:03:01.10,Main,,0,0,0,,Elde edeceğimiz güç inanılmaz!
Dialogue: 0,0:03:01.91,0:03:04.20,Main,,0,0,0,,Germa değişecek!
Dialogue: 0,0:03:07.21,0:03:12.28,Main,,0,0,0,,Babamı mutlu eden çok şey yoktur.
Dialogue: 0,0:03:12.28,0:03:16.01,Main,,0,0,0,,Senin de bir halta yaramana inanamıyorum.
Dialogue: 0,0:03:16.89,0:03:18.72,Main,,0,0,0,,Sanji!
Dialogue: 0,0:03:18.72,0:03:22.08,Main,,0,0,0,,Ortadan kaybolduğun gün çok şaşırmıştık.
Dialogue: 0,0:03:22.08,0:03:23.34,Main,,0,0,0,,Gerçekten.
Dialogue: 0,0:03:24.89,0:03:30.52,Main,,0,0,0,,Zaman zaman seni anardık.
Dialogue: 0,0:03:30.86,0:03:38.56,Main,,0,0,0,,En komik şekilde nerede nasıl\Nölebileceğini merak ederdik.
Dialogue: 0,0:03:43.41,0:03:46.77,Main,,0,0,0,,Tabağında kaldı Niji. Bitir hepsini.
Dialogue: 0,0:03:49.75,0:03:53.38,Main,,0,0,0,,Bunu mu? Kalsın, yemek istemiyorum.
Dialogue: 0,0:03:55.21,0:04:01.47,Main,,0,0,0,,Gırla çikolata yedim ve \Nüstündeki sos berbat görünüyor.
Dialogue: 0,0:04:01.47,0:04:03.41,Main,,0,0,0,,Vıcık vıcık ve iğrenç.
Dialogue: 0,0:04:04.14,0:04:05.83,Main,,0,0,0,,Çöpü hak ediyor.
Dialogue: 0,0:04:05.83,0:04:07.00,Main,,0,0,0,,Ye!
Dialogue: 0,0:04:08.69,0:04:14.40,Main,,0,0,0,,Ne bir yemeğin ne kadar değerli olduğunu \Nne de ne kadar emek verildiğini bilirsin aptal prens!
Dialogue: 0,0:04:14.77,0:04:15.84,Main,,0,0,0,,Aptal mı?!
Dialogue: 0,0:04:16.49,0:04:19.97,Main,,0,0,0,,Ulan, eziğin tekisin Sanji!
Dialogue: 0,0:04:19.97,0:04:22.51,Main,,0,0,0,,Bana ne yapacağımı söylemezsin be!
Dialogue: 0,0:04:22.96,0:04:26.14,Main,,0,0,0,,Baş şefi çağırın! Neredesin Cosette?!
Dialogue: 0,0:04:26.76,0:04:31.02,Captions,,30,0,240,,{\fad(500,0)}Baş Şef\NCosette
Dialogue: 0,0:04:31.02,0:04:36.25,Main,,0,0,0,,Senin iğrenç şeyin yüzünden\Nkardeşim bana çattı!
Dialogue: 0,0:04:36.26,0:04:39.12,Main,,0,0,0,,Evet, çok özür dilerim.
Dialogue: 0,0:04:39.43,0:04:42.33,Main,,0,0,0,,Böyle kötü bir şeyi\NNiji-sama'ya servis etmemeliydim.
Dialogue: 0,0:04:42.33,0:04:43.20,Main,,0,0,0,,Pekala.
Dialogue: 0,0:04:47.10,0:04:49.19,Main,,0,0,0,,Orada kal Cosatte.
Dialogue: 0,0:05:25.84,0:05:30.05,Main,,0,0,0,,Seni...\NDaha ne adilik yapacaksın be?!
Dialogue: 0,0:05:30.05,0:05:33.41,Main,,0,0,0,,Bir kadının yüzünde yara izi\Nbırakmaya mı çalışıyorsun?
Dialogue: 0,0:05:59.16,0:06:03.21,Main,,0,0,0,,Ne dedin? Kadın mı?
Dialogue: 0,0:06:03.99,0:06:07.05,Main,,0,0,0,,Sıradan bir aşçının neyini koruyorsun?!
Dialogue: 0,0:06:13.39,0:06:15.39,Main,,0,0,0,,Ne kadar centilmence.
Dialogue: 0,0:06:16.38,0:06:18.42,Main,,0,0,0,,Yemek de döküldü.
Dialogue: 0,0:06:19.51,0:06:24.10,Main,,0,0,0,,Bu yemeğin adı Aligot.\NPeynirle harmanlanmış patatesten yapılır.
Dialogue: 0,0:06:25.13,0:06:27.60,Main,,0,0,0,,Sanji-sama, ben temizlerim!
Dialogue: 0,0:06:28.77,0:06:33.80,Main,,0,0,0,,Patates bağışıklık sistemini güçlendirir\Nve kan basıncını ayarlar.
Dialogue: 0,0:06:34.23,0:06:36.69,Main,,0,0,0,,Çok besleyicidir.
Dialogue: 0,0:06:37.03,0:06:39.38,Main,,0,0,0,,Önemli kişiler olduğunuzdan mıdır bilmem...
Dialogue: 0,0:06:39.70,0:06:42.71,Main,,0,0,0,,...konfideki et kesimi de\Nçok dikkatli seçilmiş.
Dialogue: 0,0:06:44.25,0:06:47.21,Main,,0,0,0,,Kahvaltı için çok özenle\Nhazırlanmış bir yemek.
Dialogue: 0,0:06:49.72,0:06:51.95,Main,,0,0,0,,Lütfen yapmayın Sanji-sama!
Dialogue: 0,0:06:51.95,0:06:54.03,Main,,0,0,0,,Kraliyet ailesinden birisi yere\Ndüşmüş yemeği yememeli!
Dialogue: 0,0:06:55.46,0:06:58.92,Main,,0,0,0,,Ne yapıyorsun lan?! Midem kalktı!
Dialogue: 0,0:06:59.26,0:07:01.53,Main,,0,0,0,,Baharatı da harikaymış.
Dialogue: 0,0:07:04.30,0:07:06.84,Main,,0,0,0,,Fakirlik ruhuna işlemiş artık!
Dialogue: 0,0:07:08.41,0:07:11.14,Main,,0,0,0,,İğrenç şeyler yapmayı kes!
Dialogue: 0,0:07:11.27,0:07:14.01,Main,,0,0,0,,Yapma Niji! Düğün yakın!
Dialogue: 0,0:07:27.83,0:07:29.69,Main,,0,0,0,,Çok teşekkür ederim.
Dialogue: 0,0:07:29.69,0:07:32.20,Main,,0,0,0,,Vinsmoke'ların utanç kaynağısın.
Dialogue: 0,0:07:32.58,0:07:37.74,Main,,0,0,0,,Asıl bu ailenin bir parçası olduğum\Niçin ben utanıyorum!
Dialogue: 0,0:07:37.74,0:07:38.86,Main,,0,0,0,,Ne dedin?
Dialogue: 0,0:07:39.26,0:07:45.21,Main,,0,0,0,,Yemeğe saygısı olmayan bir salak.\NKadına el kaldıran bir adam.
Dialogue: 0,0:07:45.21,0:07:50.11,Main,,0,0,0,,Kraliyet kibriniz adamlarınızı\Ninsan yerine koydurmuyor!
Dialogue: 0,0:07:50.48,0:07:54.49,Main,,0,0,0,,Yanında olduğum ne varsa karşısındasınız!
Dialogue: 0,0:07:54.49,0:07:59.22,Main,,0,0,0,,Konuşmaların tam fakir\Nedebiyatı saçmalıklar, Sanji.
Dialogue: 0,0:08:00.43,0:08:04.23,Main,,0,0,0,,Çocukluktan beri dediklerini de\Nanlamazdım keza.
Dialogue: 0,0:08:05.95,0:08:09.10,Main,,0,0,0,,Kraliyet dediğin kral gibi davranacak tabii!
Dialogue: 0,0:08:09.10,0:08:11.47,Main,,0,0,0,,Mantıksız olan sensin.
Dialogue: 0,0:08:14.14,0:08:18.80,Main,,0,0,0,,Çok haklı. \NHer zamankinden de kötü durumdasın.
Dialogue: 0,0:08:20.48,0:08:25.64,Main,,0,0,0,,Yoksa bu adam mı böyle tesir etti, Sanji?
Dialogue: 0,0:08:34.49,0:08:38.53,Main,,0,0,0,,Big Mom'un bilgi toplama ağı harikadır.
Dialogue: 0,0:08:38.53,0:08:42.89,Main,,0,0,0,,2 yıl önceye kadar restoranında\Nçalışıyordun değil mi?
Dialogue: 0,0:08:42.89,0:08:45.20,Main,,0,0,0,,Yerini de belirledik.
Dialogue: 0,0:08:45.66,0:08:49.28,Main,,0,0,0,,Resim de yakın zamanda çekilmiş gibi.
Dialogue: 0,0:08:49.28,0:08:52.84,Main,,0,0,0,,Deniz restoranı, Baratie!
Dialogue: 0,0:08:56.92,0:09:00.99,Main,,0,0,0,,Ne oldu? Yüzünün rengi attı.
Dialogue: 0,0:09:02.09,0:09:05.22,Main,,0,0,0,,Az önceki havana ne oldu Sanji?
Dialogue: 0,0:09:05.88,0:09:09.76,Main,,0,0,0,,Bir şeyler söylesene! Ha?! Lan!
Dialogue: 0,0:09:22.44,0:09:23.92,Main,,0,0,0,,Bunlar ne?
Dialogue: 0,0:09:23.92,0:09:26.98,Main,,0,0,0,,Kaçmasını önlemek için kelepçeler-bon.
Dialogue: 0,0:09:28.55,0:09:31.99,Main,,0,0,0,,Hasır Şapka Tayfası da Sanji de...
Dialogue: 0,0:09:31.99,0:09:35.36,Main,,0,0,0,,...evliliğe karşı gibi duruyor-bon.
Dialogue: 0,0:09:35.36,0:09:41.63,Main,,0,0,0,,Bu kelepçeleri ödünç verip onun zayıf\Nnoktasını da söyleyeceğim-soir.
Dialogue: 0,0:09:42.60,0:09:44.43,Main,,0,0,0,,Zayıf nokta mı?
Dialogue: 0,0:09:47.94,0:09:53.40,Main,,0,0,0,,Seni kontrol altına alamadığımız\Nen kötü senaryo için...
Dialogue: 0,0:09:53.40,0:09:59.03,Main,,0,0,0,,..."bu herifin kellesi uçar" tarzı \Nbir tehdit olarak bunu kullanırım.
Dialogue: 0,0:10:05.42,0:10:11.46,Main,,0,0,0,,Aptalca bir şey yapma.\NYapabileceklerimizi sen de biliyorsun.
Dialogue: 0,0:10:11.46,0:10:13.41,Main,,0,0,0,,Direnme sakın.
Dialogue: 0,0:10:13.41,0:10:17.66,Main,,0,0,0,,Arkadaşlarından vazgeç ve \NPudding ile evlenmeyi kabul et.
Dialogue: 0,0:10:18.13,0:10:21.99,Main,,0,0,0,,O zaman her şey yoluna girecek.
Dialogue: 0,0:10:36.61,0:10:39.65,Flashbacks,,0,0,0,,Bacağına ne oldu?
Dialogue: 0,0:10:40.07,0:10:41.75,Flashbacks,,0,0,0,,Neden?!
Dialogue: 0,0:10:41.75,0:10:46.62,Flashbacks,,0,0,0,,Bana bu kadar nazik olman\Niçin hiçbir sebep yok!
Dialogue: 0,0:10:46.62,0:10:49.73,Flashbacks,,0,0,0,,Neden be?! Neden?!
Dialogue: 0,0:10:51.82,0:10:57.57,Flashbacks,,0,0,0,,Sen de benimle aynı\Nhayallere sahipsin çünkü.
Dialogue: 0,0:10:58.98,0:11:01.01,Flashbacks,,0,0,0,,All Blue...
Dialogue: 0,0:11:06.76,0:11:10.96,Flashbacks,,0,0,0,,Harika be adi moruk!\NDeniz restoranı mı bu?!
Dialogue: 0,0:11:10.96,0:11:13.28,Flashbacks,,0,0,0,,İşimiz başımızdan aşkın olacak.
Dialogue: 0,0:11:13.28,0:11:15.12,Flashbacks,,0,0,0,,Ben varsam sorun olmaz!
Dialogue: 0,0:11:18.99,0:11:20.32,Flashbacks,,0,0,0,,Lan küçük velet!
Dialogue: 0,0:11:23.83,0:11:25.79,Flashbacks,,0,0,0,,Çok yavaşsın küçük velet!
Dialogue: 0,0:11:25.79,0:11:27.50,Flashbacks,,0,0,0,,Ben sen değilim be adi moruk!
Dialogue: 0,0:11:28.50,0:11:31.17,Flashbacks,,0,0,0,,Gene mi kadınlar küçük velet?!
Dialogue: 0,0:11:31.17,0:11:32.24,Flashbacks,,0,0,0,,Küçük velet!
Dialogue: 0,0:11:32.59,0:11:33.50,Flashbacks,,0,0,0,,Küçük velet!
Dialogue: 0,0:11:33.71,0:11:34.81,Flashbacks,,0,0,0,,Küçük velet!
Dialogue: 0,0:11:35.13,0:11:36.01,Flashbacks,,0,0,0,,Küçük velet!
Dialogue: 0,0:11:36.40,0:11:37.38,Flashbacks,,0,0,0,,Küçük velet!
Dialogue: 0,0:11:37.78,0:11:39.99,Flashbacks,,0,0,0,,Küçük velet!
Dialogue: 0,0:11:45.93,0:11:46.98,Flashbacks,,0,0,0,,Sanji!
Dialogue: 0,0:11:48.98,0:11:52.19,Flashbacks,,0,0,0,,Sakın üşütme.
Dialogue: 0,0:12:03.70,0:12:06.77,Flashbacks,,0,0,0,,Şef Zeff!
Dialogue: 0,0:12:08.54,0:12:13.63,Flashbacks,,0,0,0,,Yıllarca benim için yaptıklarına\Nteşekkür ediyorum!
Dialogue: 0,0:12:13.63,0:12:18.38,Flashbacks,,0,0,0,,İyiliğini ömrüm boyunca unutmayacağım!
Dialogue: 0,0:12:31.23,0:12:34.93,Main,,0,0,0,,Yarın düzgün bir düğün yapalım.
Dialogue: 0,0:12:35.32,0:12:40.59,Main,,0,0,0,,Bugün Big Mom ve \NPudding ile de yemek yiyeceğiz.
Dialogue: 0,0:12:40.59,0:12:42.71,Main,,0,0,0,,Kalelerine gitmeye hazırlan.
Dialogue: 0,0:12:43.03,0:12:45.53,Main,,0,0,0,,Anladın mı Sanji?
Dialogue: 0,0:12:50.54,0:12:53.15,Main,,0,0,0,,Şu Hasır Şapka nereye kayboldu?
Dialogue: 0,0:12:54.67,0:12:56.05,Main,,0,0,0,,Arayın.
Dialogue: 0,0:12:58.18,0:13:01.52,Main,,0,0,0,,10 dakika çok uzun.
Dialogue: 0,0:13:02.26,0:13:04.96,Main,,0,0,0,,Haki bile kullanamıyorum.
Dialogue: 0,0:13:12.20,0:13:14.11,Main,,0,0,0,,Birisi mi var orada?
Dialogue: 0,0:13:22.88,0:13:25.63,Main,,0,0,0,,Birisi yardım etsin! Doktor çağırın!
Dialogue: 0,0:13:26.76,0:13:28.88,Main,,0,0,0,,Hey, kendine gel!
Dialogue: 0,0:13:28.88,0:13:32.61,Main,,0,0,0,,Lanet olsun! Onun parmağı olmalı!
Dialogue: 0,0:13:33.03,0:13:35.66,Main,,0,0,0,,Bunu hak edecek ne yaptı?
Dialogue: 0,0:13:40.35,0:13:43.50,Main,,0,0,0,,Bir kadını bilincini yitirene kadar dövmüş.
Dialogue: 0,0:13:45.90,0:13:50.47,Main,,0,0,0,,Hiç bu kadar adisini görmemiştim!
Dialogue: 0,0:13:50.47,0:13:53.24,Main,,0,0,0,,Bu senin hatan Sanji.
Dialogue: 0,0:13:53.24,0:13:54.47,Main,,0,0,0,,Yonji!
Dialogue: 0,0:13:56.74,0:13:59.89,Main,,0,0,0,,Avam bir kadını pohpohladın.
Dialogue: 0,0:14:01.15,0:14:03.42,Main,,0,0,0,,Ne demek istiyorsun lan?!
Dialogue: 0,0:14:05.92,0:14:10.70,Main,,0,0,0,,Niji'yi mi görmek istiyorsun?\NElbette bunun arkasında o vardır.
Dialogue: 0,0:14:11.66,0:14:14.27,Main,,0,0,0,,Takip et. Seni götüreyim.
Dialogue: 0,0:14:21.56,0:14:24.67,Main,,0,0,0,,İyi olacaksın, endişelenme.
Dialogue: 0,0:14:26.23,0:14:28.61,Main,,0,0,0,,Ne oldu? Geliyor musun?
Dialogue: 0,0:14:31.40,0:14:35.09,Main,,0,0,0,,Evet, seve seve.
Dialogue: 0,0:14:44.06,0:14:45.00,Main,,0,0,0,,Burası...
Dialogue: 0,0:14:46.24,0:14:48.06,Main,,0,0,0,,Merak ediyordun değil mi?
Dialogue: 0,0:14:48.06,0:14:51.50,Main,,0,0,0,,Çocukken buraya girmemiz yasaktı.
Dialogue: 0,0:15:27.92,0:15:32.13,Main,,0,0,0,,Tip MB 54 adet, Tip MST 30 adet.
Dialogue: 0,0:15:32.13,0:15:35.21,Main,,0,0,0,,Tip MH ise 21 adet eklenmeli.
Dialogue: 0,0:15:35.21,0:15:36.41,Main,,0,0,0,,Anlaşıldı.
Dialogue: 0,0:15:58.95,0:16:01.80,Main,,0,0,0,,Bunlar da ne?!
Dialogue: 0,0:16:06.79,0:16:09.25,Main,,0,0,0,,Ne olduklarını mı merak ediyorsun?
Dialogue: 0,0:16:09.67,0:16:13.92,Main,,0,0,0,,Dünyaya korku salan Germa 66...
Dialogue: 0,0:16:13.92,0:16:16.44,Main,,0,0,0,,...ve işte onun askerleri!
Dialogue: 0,0:16:36.50,0:16:38.55,Main,,0,0,0,,Cracker-sama!!
Dialogue: 0,0:16:38.55,0:16:40.95,Main,,0,0,0,,Cracker mı?! Bu o mu?!
Dialogue: 0,0:16:50.19,0:16:52.76,Main,,0,0,0,,Ne oldu Kingbaum?
Dialogue: 0,0:16:52.76,0:16:56.09,Main,,0,0,0,,Neden Hasır Şapkalar'ın yanındasın?
Dialogue: 0,0:16:58.57,0:17:01.05,Main,,0,0,0,,Mantıklı bir sebebi var.
Dialogue: 0,0:17:13.21,0:17:15.67,Main,,0,0,0,,Bahane istemiyorum.
Dialogue: 0,0:17:16.17,0:17:18.45,Main,,0,0,0,,Hepinizi geberteceğim!
Dialogue: 0,0:17:28.39,0:17:29.93,Main,,0,0,0,,Neyi var onun?
Dialogue: 0,0:17:30.56,0:17:34.68,Main,,0,0,0,,Kadın, ben Tatlı Komutanı Cracker.
Dialogue: 0,0:17:35.75,0:17:37.86,Main,,0,0,0,,Arkadaşıma...
Dialogue: 0,0:17:45.91,0:17:47.71,Main,,0,0,0,,...dokunma!
Dialogue: 0,0:17:48.55,0:17:50.55,Main,,0,0,0,,Hasır Şapka!
Dialogue: 0,0:17:58.29,0:18:02.40,Main,,0,0,0,,Germa 66'nın askerleri mi?
Dialogue: 0,0:18:04.40,0:18:06.43,Main,,0,0,0,,Neden su içindeler?
Dialogue: 0,0:18:06.43,0:18:08.33,Main,,0,0,0,,Kültür sıvısı.
Dialogue: 0,0:18:08.76,0:18:12.77,Main,,0,0,0,,Hepsinin yüzü aynı. Canlı mı bunlar?
Dialogue: 0,0:18:12.77,0:18:15.56,Main,,0,0,0,,Sanji, insanlar...
Dialogue: 0,0:18:16.05,0:18:17.64,Main,,0,0,0,,...üretilebilir!
Dialogue: 0,0:18:18.73,0:18:22.23,Main,,0,0,0,,Germa, nesillerdir bilimin krallığı.
Dialogue: 0,0:18:22.23,0:18:26.05,Main,,0,0,0,,Öyle durmasa da babamız zamanında\Nyetenekli bir bilim adamıymış.
Dialogue: 0,0:18:26.94,0:18:29.88,Main,,0,0,0,,Biz doğmadan önce...
Dialogue: 0,0:18:29.88,0:18:33.41,Main,,0,0,0,,...yasal olmayan yabancı bir\Naraştırma ekibinin parçasıymış...
Dialogue: 0,0:18:33.41,0:18:38.35,Main,,0,0,0,,...ve ünlü Doktor Vegapunk ile\Nsilahlar üzerine çalışıyormuş.
Dialogue: 0,0:18:38.35,0:18:40.33,Main,,0,0,0,,Vegapunk ile mi birlikteymiş?!
Dialogue: 0,0:18:40.71,0:18:42.52,Main,,0,0,0,,Gençlik günlerinde.
Dialogue: 0,0:18:44.04,0:18:47.63,Main,,0,0,0,,O zamanlarda Vegapunk\Ncanlılar içerisindeki...
Dialogue: 0,0:18:47.63,0:18:50.72,Main,,0,0,0,,...soy elementlerini keşfetmiş.
Dialogue: 0,0:18:50.72,0:18:54.43,Main,,0,0,0,,Tanrının yerini almanın bir adım gerisiymiş...
Dialogue: 0,0:18:54.43,0:18:58.58,Main,,0,0,0,,...çünkü yaratılış planlarını bulmaya benzermiş.
Dialogue: 0,0:18:59.92,0:19:05.02,Main,,0,0,0,,Dünya Hükümeti bunu tehlikeli\Nbularak Vegapunk'u tutuklamış.
Dialogue: 0,0:19:05.02,0:19:10.53,Main,,0,0,0,,Araştırma ekibi dağıldı. \NDaha doğrusu Hükümet tarafından satın alındı.
Dialogue: 0,0:19:10.53,0:19:14.63,Main,,0,0,0,,Ne var ki babamız Hükümet'ten kaçıp...
Dialogue: 0,0:19:14.63,0:19:18.08,Main,,0,0,0,,...burada Germa'da araştırmalarına devam etti.
Dialogue: 0,0:19:18.60,0:19:23.27,Main,,0,0,0,,Yaşam kopyalama ve düzenleme araştırmalarına...
Dialogue: 0,0:19:24.64,0:19:28.63,Main,,0,0,0,,Sonra da bu yeraltı tesisini kurdu!
Dialogue: 0,0:19:28.63,0:19:34.18,Main,,0,0,0,,Bunlar birkaç yetenekli askerin kopyaları.
Dialogue: 0,0:19:34.18,0:19:36.39,Main,,0,0,0,,Klon askerler!
Dialogue: 0,0:19:36.39,0:19:38.02,Main,,0,0,0,,Klon mu?
Dialogue: 0,0:19:45.20,0:19:49.26,Main,,0,0,0,,Elbette kişi bunun farkında olmuyor.
Dialogue: 0,0:19:49.80,0:19:51.32,Main,,0,0,0,,Anlıyor musun Sanji?
Dialogue: 0,0:19:52.22,0:19:59.21,Main,,0,0,0,,Çoğu ülke ordumuzdan korkarken\Naynı zamanda sahip de olmak istiyor.
Dialogue: 0,0:19:59.44,0:20:02.58,Main,,0,0,0,,Güçlü ve sadık oldukları için haklılar.
Dialogue: 0,0:20:03.15,0:20:08.04,Main,,0,0,0,,Ölümden korkmamaya ve efendilerine\Nihanet etmemeye programlılar.
Dialogue: 0,0:20:09.12,0:20:11.74,Main,,0,0,0,,Öldüklerinde yeniden üretebiliriz hem.
Dialogue: 0,0:20:11.74,0:20:15.46,Main,,0,0,0,,20 yaşındaki bir askeri üretmesi 5 yıl sürüyor.
Dialogue: 0,0:20:16.01,0:20:19.29,Main,,0,0,0,,Burası askerleri stokladığımız bir depo.
Dialogue: 0,0:20:21.50,0:20:25.28,Main,,0,0,0,,Bak bunları üretmesi 5 yıl sürüyor...
Dialogue: 0,0:20:27.34,0:20:30.74,Main,,0,0,0,,...ama 20 yaşında gibi duruyorlar.
Dialogue: 0,0:20:30.74,0:20:33.01,Main,,0,0,0,,Kes şunu! Yetti artık!
Dialogue: 0,0:20:34.83,0:20:36.91,Main,,0,0,0,,Tepemi attırıyorsun!
Dialogue: 0,0:20:48.67,0:20:49.99,Main,,0,0,0,,Sanji.
Dialogue: 0,0:20:54.39,0:20:57.84,Main,,0,0,0,,Korsan olduğunu duyunca...
Dialogue: 0,0:20:57.84,0:21:02.24,Main,,0,0,0,,...o vasat herifin az daha iyi\Nolabileceğini düşünmüştüm.
Dialogue: 0,0:21:04.27,0:21:06.91,Main,,0,0,0,,Hiç değişmemesi hayal kırıklığına uğrattı.
Dialogue: 0,0:21:07.48,0:21:08.81,Main,,0,0,0,,Niji!
Dialogue: 0,0:21:10.32,0:21:11.65,Main,,0,0,0,,Seni...
Dialogue: 0,0:21:20.76,0:21:23.54,Flashbacks,,0,0,0,,Orada ne yapıyorsun?
Dialogue: 0,0:21:25.46,0:21:27.28,Flashbacks,,0,0,0,,Sen mutfak hizmetçisisin.
Dialogue: 0,0:21:32.81,0:21:34.09,Flashbacks,,0,0,0,,Şey...
Dialogue: 0,0:21:39.57,0:21:41.22,Main,,0,0,0,,Cosette-chan'a...
Dialogue: 0,0:21:43.32,0:21:45.81,Main,,0,0,0,,..ne yaptın lan?!
Dialogue: 0,0:21:48.62,0:21:52.66,Main,,0,0,0,,Yaptığın çok büyük bir suçtu!\NDersini vereceğim!
Dialogue: 0,0:21:53.56,0:21:59.40,Main,,0,0,0,,Bekle Sanji! Doğu Mavi'deki\Nmoruğu rehin tuttuğumuzu unutma.
Dialogue: 0,0:22:01.84,0:22:03.22,Main,,0,0,0,,{\fad(250,250)}Stealth.
Dialogue: 0,0:22:01.84,0:22:03.22,Attack,,0,0,0,,{\fad(250,250)}Gizlilik
Dialogue: 0,0:22:04.47,0:22:09.50,Main,,0,0,0,,Bizim aşçı müsveddesinin böyle\Nolduğuna inanamıyorum.
Dialogue: 0,0:22:10.31,0:22:15.27,Main,,0,0,0,,Karşılık verme.\NYoksa Doğu Mavi'de kan akar.
Dialogue: 0,0:22:16.65,0:22:17.75,Main,,0,0,0,,{\fad(250,250)}Henry...
Dialogue: 0,0:22:18.82,0:22:20.02,Main,,0,0,0,,{\fad(250,250)}...Needle!
Dialogue: 0,0:22:18.82,0:22:20.02,Attack,,0,0,0,,{\fad(250,250)}...İğnesi!
Dialogue: 0,0:22:46.11,0:22:48.11,Main,,0,0,0,,Söylemeliydin.
Dialogue: 0,0:22:48.91,0:22:52.48,Main,,0,0,0,,O aşçı müsveddesine\Naşık olduğunu bilsem...
Dialogue: 0,0:22:52.48,0:22:55.65,Main,,0,0,0,,...yüzünü mahvetmezdim.
Dialogue: 0,0:22:55.98,0:23:01.25,Main,,0,0,0,,Ama şiş bir yüzle de olur dersen...
Dialogue: 0,0:23:01.25,0:23:04.34,Main,,0,0,0,,...hemen aşçın olarak atarım.
Dialogue: 0,0:23:06.36,0:23:09.55,Main,,0,0,0,,Tekrardan hoş geldin Sanji.
Dialogue: 0,0:23:10.52,0:23:13.10,Main,,0,0,0,,Vinsmoke Ailemize!
Dialogue: 0,0:23:16.37,0:23:21.88,Main,,0,0,0,,Sanırım hiyerarşiyi bir kez daha anlatmalıyız.
Dialogue: 0,0:23:25.45,0:23:29.32,Main,,0,0,0,,Sen bir fiyaskosun.
Dialogue: 0,0:23:40.38,0:23:45.09,Main,,0,0,0,,Dinleyin, siz benim en\Nbüyük bilimsel başarılarımsınız.
Dialogue: 0,0:23:45.09,0:23:48.91,Main,,0,0,0,,Bilimsel modifikasyon araştırmalarım sonucunda...
Dialogue: 0,0:23:48.91,0:23:52.68,Main,,0,0,0,,...süper insan güçlerine sahip olarak doğdunuz.
Dialogue: 0,0:23:53.10,0:23:56.45,Main,,0,0,0,,Aptalca duyguların esiri olmadan yaşayacak...
Dialogue: 0,0:23:56.45,0:23:59.90,Main,,0,0,0,,...ve her biriniz kendi birliklerini yönetip...
Dialogue: 0,0:23:59.90,0:24:07.53,Main,,0,0,0,,...bilimin gücüyle Germa 66'yı daha da\Nileri taşıyacak şekilde yöneteceksiniz!
Dialogue: 0,0:24:07.91,0:24:11.30,Main,,0,0,0,,Yetenekleriniz var!\NTek lazım olan antrenman!
Dialogue: 0,0:24:11.30,0:24:13.60,Main,,0,0,0,,Baş üstüne baba!
Dialogue: 0,0:24:36.35,0:24:38.39,Main,,0,0,0,,Evet, Sanji-sama.
Dialogue: 0,0:25:00.25,0:25:02.33,Main,,0,0,0,,Ah, ah, ah.
Dialogue: 0,0:25:21.31,0:25:23.27,Main,,0,0,0,,Yandım! Yandım! Yandım!
Dialogue: 0,0:25:41.88,0:25:43.55,Main,,0,0,0,,Sanji'ye ne oldu?
Dialogue: 0,0:25:44.05,0:25:45.06,Main,,0,0,0,,Bilmiyorum.
Dialogue: 0,0:25:59.43,0:26:01.18,Main,,0,0,0,,Hadi, hadi.
Dialogue: 0,0:26:01.18,0:26:02.91,Main,,0,0,0,,Gel bakalım.
Dialogue: 0,0:26:08.65,0:26:11.01,Main,,0,0,0,,Kaplumbağayla oynamasana!
Dialogue: 0,0:26:11.01,0:26:13.03,Main,,0,0,0,,Ne yapıyorsun lan?!
Dialogue: 0,0:26:13.74,0:26:15.61,Main,,0,0,0,,Artistlik yapma!
Dialogue: 0,0:26:18.11,0:26:20.28,Main,,0,0,0,,Gördün gününü!
Dialogue: 0,0:26:20.66,0:26:23.36,Main,,0,0,0,,- Sanji-sama!\N- Nji-sama!
Dialogue: 0,0:26:39.52,0:26:41.11,Main,,0,0,0,,Yapma! Acıyor!
Dialogue: 0,0:26:43.11,0:26:45.82,Main,,0,0,0,,Pes ediyorum, Niji!
Dialogue: 0,0:26:47.65,0:26:49.99,Main,,0,0,0,,Dur artık!
Dialogue: 0,0:26:57.04,0:26:58.58,Main,,0,0,0,,Niji-sama...
Dialogue: 0,0:26:58.58,0:27:00.96,Main,,0,0,0,,Bırak! Hala vurmak istiyorum!
Dialogue: 0,0:27:03.54,0:27:08.64,Main,,0,0,0,,Neden Sanji diğerlerinden güçsüz?\NFark gittikçe açılıyor.
Dialogue: 0,0:27:12.60,0:27:15.14,Main,,0,0,0,,Test sonuçları geldi.
Dialogue: 0,0:27:15.14,0:27:20.52,Main,,0,0,0,,Ichiji-sama, Niji-sama ve\NYonji-sama çok iyi durumda.
Dialogue: 0,0:27:20.52,0:27:22.69,Main,,0,0,0,,Dış iskelet sistemleri gelişmiş...
Dialogue: 0,0:27:22.69,0:27:28.49,Main,,0,0,0,,...ve bedenlerinin esnekliği ve gücü,\Ngüçlü bir askere denk.
Dialogue: 0,0:27:29.10,0:27:33.60,Main,,0,0,0,,Ne var ki Sanji-sama, söylemesi acı verse de...
Dialogue: 0,0:27:37.50,0:27:39.75,Main,,0,0,0,,Ne oldu? Söyle.
Dialogue: 0,0:27:40.61,0:27:44.21,Main,,0,0,0,,Başarısız olduğunu söylemek zorundayım.
Dialogue: 0,0:27:45.63,0:27:51.05,Main,,0,0,0,,Soy elementlerini dördü için de\Nbaşarıyla eklediğimizi düşünmüştük.
Dialogue: 0,0:27:51.05,0:27:57.16,Main,,0,0,0,,Ama nedense onun soy elementleri\Nşu an normal hallerine dönmüş şeklinde.
Dialogue: 0,0:27:58.20,0:27:59.42,Main,,0,0,0,,Yani...
Dialogue: 0,0:28:00.43,0:28:04.63,Main,,0,0,0,,Sanji-sama normal bir insan.
Dialogue: 0,0:28:12.36,0:28:14.99,Main,,0,0,0,,Neden benimle ilgileniyorsun?
Dialogue: 0,0:28:14.99,0:28:17.54,Main,,0,0,0,,İstemiyor musun?
Dialogue: 0,0:28:17.54,0:28:19.41,Main,,0,0,0,,Hayır.
Dialogue: 0,0:28:19.41,0:28:21.79,Main,,0,0,0,,Reiju, çok naziksin.
Dialogue: 0,0:28:21.79,0:28:23.65,Main,,0,0,0,,Kes sesini! Çeneni kapa!
Dialogue: 0,0:28:25.63,0:28:29.13,Main,,0,0,0,,Yine de neden bana güldün?
Dialogue: 0,0:28:29.13,0:28:34.14,Main,,0,0,0,,Elimden bir şey gelmiyor ki. \NDurdurmaya çalışsam bana da kötü davranırlar.
Dialogue: 0,0:28:34.14,0:28:35.49,Main,,0,0,0,,İstemiyorum!
Dialogue: 0,0:28:38.43,0:28:42.83,NolandBookLiar,,0,0,0,,{\frx350\fry18\frz17.07\org(1050,368.666)\pos(1055,353.667)}Yalancı
Dialogue: 0,0:28:38.43,0:28:42.83,NolandBookNoland,,0,0,0,,{\frx352\fry20\frz14.44\pos(1070,382)}Noland
Dialogue: 0,0:28:38.43,0:28:42.83,DevilFruitsBook,,0,0,0,,{\frx354\fry20\pos(1116.667,653.666)\frz3.953}Şeytan Meyveleri
Dialogue: 0,0:28:41.60,0:28:42.83,Main,,0,0,0,,İşte geldi.
Dialogue: 0,0:28:44.73,0:28:46.18,Main,,0,0,0,,Yiyebilirsin.
Dialogue: 0,0:28:47.27,0:28:49.41,Main,,0,0,0,,Senin için hazırladım.
Dialogue: 0,0:28:52.90,0:28:54.32,Main,,0,0,0,,Lezzetli mi?
Dialogue: 0,0:28:55.60,0:28:59.29,Main,,0,0,0,,Sanji! Gene mi fare için yemek hazırladın?!
Dialogue: 0,0:28:59.29,0:29:02.87,Main,,0,0,0,,Kraliyet ailesi hizmet etmemeli!\NKaç kez diyeceğim daha?!
Dialogue: 0,0:29:02.87,0:29:04.32,Main,,0,0,0,,Ama ben...
Dialogue: 0,0:29:05.42,0:29:09.79,Main,,0,0,0,,Annen öldü artık! Ölenle ölünmüyor!
Dialogue: 0,0:29:10.80,0:29:14.70,Main,,0,0,0,,Kardeşlerinin aksine hiç yeteneğin yok.
Dialogue: 0,0:29:14.70,0:29:19.10,Main,,0,0,0,,Bu yüzden 10, hayır 100 kat daha fazla çalış!
Dialogue: 0,0:29:19.10,0:29:24.71,Main,,0,0,0,,Germa İmparatorluğu'nu tekrar kurmak\Niçin planımın bir parçasısın!
Dialogue: 0,0:29:24.71,0:29:26.51,Main,,0,0,0,,Beni hayal kırıklığına uğratma!
Dialogue: 0,0:29:33.45,0:29:36.32,Main,,0,0,0,,Bir daha yemek pişirme.
Dialogue: 0,0:29:52.59,0:29:56.05,Main,,0,0,0,,Bacakların bu kadar mı iş görüyor Sanji?
Dialogue: 0,0:29:58.19,0:29:59.60,Main,,0,0,0,,İlerleme yok.
Dialogue: 0,0:29:59.60,0:30:02.54,Main,,0,0,0,,- Potansiyeli sıfır.\N- Evet.
Dialogue: 0,0:30:03.14,0:30:06.42,Main,,0,0,0,,Ne kadar da işe yaramaz bir varlık.
Dialogue: 0,0:30:06.42,0:30:08.44,Main,,0,0,0,,Ne yapacağız?
Dialogue: 0,0:30:10.69,0:30:14.40,Main,,0,0,0,,Böyle bir kazaya inanamıyorum, çok üzücü!
Dialogue: 0,0:30:14.40,0:30:19.53,Main,,0,0,0,,Hepsinin Germa'yı yöneten\Nsavaşçılar olmasını bekliyordum.
Dialogue: 0,0:30:19.53,0:30:24.60,Main,,0,0,0,,Gelecek vaat eden oğlumu kaybettim!
Dialogue: 0,0:30:28.25,0:30:30.35,Main,,0,0,0,,Ne? Bu da ne?
Dialogue: 0,0:30:32.05,0:30:37.15,Main,,0,0,0,,Bu da ne böyle? Çıkaramıyorum.\NNe yapıyorsunuz siz?
Dialogue: 0,0:30:37.90,0:30:40.14,Main,,0,0,0,,Sanji gerçekten öldü mü?
Dialogue: 0,0:30:40.14,0:30:43.12,Main,,0,0,0,,Bilmem, o aptala ne olduğu da\Numurumda değil.
Dialogue: 0,0:30:51.86,0:30:55.03,Main,,0,0,0,,Bekleyin! Burada kalmak istemiyorum!
Dialogue: 0,0:30:55.03,0:30:56.56,Main,,0,0,0,,Çıkarın beni!
Dialogue: 0,0:30:56.56,0:30:59.95,Main,,0,0,0,,Arkada bırakmayın! Korkuyorum! Öleceğim!
Dialogue: 0,0:31:00.28,0:31:01.74,Main,,0,0,0,,Babamı istiyorum!
Dialogue: 0,0:31:01.74,0:31:04.81,Main,,0,0,0,,Baba, kurtar beni! Beni öldürecekler!
Dialogue: 0,0:31:06.62,0:31:10.08,Main,,0,0,0,,Bu Kral-sama'nın kararı.
Dialogue: 0,0:31:10.08,0:31:12.38,Main,,0,0,0,,Ne? Babamın mı?
Dialogue: 0,0:31:12.38,0:31:15.15,Main,,0,0,0,,Yalan! Bir hata olmalı!
Dialogue: 0,0:31:15.51,0:31:22.59,Main,,0,0,0,,Kral-sama, Sanji-sama hiç doğmamış\Ngibi davranılmasını istedi.
Dialogue: 0,0:31:22.99,0:31:23.83,Main,,0,0,0,,Ne?
Dialogue: 0,0:31:41.11,0:31:42.99,Main,,0,0,0,,Neden?
Dialogue: 0,0:31:44.03,0:31:47.66,Main,,0,0,0,,Lütfen beni çıkar baba.
Dialogue: 0,0:31:47.66,0:31:52.17,Main,,0,0,0,,Özür dilerim.\NGüçsüz doğduğum için özür dilerim!
Dialogue: 0,0:31:52.17,0:31:56.56,Main,,0,0,0,,Yardım et. Baba, yardım et!
Dialogue: 0,0:31:56.56,0:31:59.88,Main,,0,0,0,,Baba!
Dialogue: 0,0:32:00.30,0:32:05.63,Credits,,0,0,0,,{Change this accordingly}Editing:\N Feeso,\NGalaxy 9000\N\NTiming:\NSewil\N\NQuality Assurance:\NFeeso,\NGalaxy 9000,\NGrug,\NPepperjack,\NSewil\N\NSoundtracking:\N Halee\N\NInfoboxes & Title:\N Datenshi\N\NKaraoke:\NKaitouYahiko\N\NAttack Effects:\NKaitouYahiko\N\NTranslation:\NCrunchyroll
Dialogue: 0,0:00:00.82,0:00:06.82,Lyrics,,0,0,0,karaoke,♪ Görmedim dünyanın sonunu kendi gözlerimle hiç. ♪
Dialogue: 0,0:00:06.82,0:00:13.95,Lyrics,,0,0,0,karaoke,♪ O yüzden çıktım yola sizinle, bunu yapmak için! ♪
Dialogue: 0,0:00:23.67,0:00:27.00,Lyrics,,0,0,0,karaoke,♪ Bir denizden diğerine yol alırken,...
Dialogue: 0,0:00:29.06,0:00:31.91,Lyrics,,0,0,0,karaoke,...bunun sadece bir peri masalı olduğunu söylemek. ♪
Dialogue: 0,0:00:31.92,0:00:38.78,Lyrics,,0,0,0,karaoke,♪ Gerçek, kurgudan daha tuhaf değil mi? ♪
Dialogue: 0,0:00:39.94,0:00:43.56,Lyrics,,0,0,0,karaoke,♪ Fakat sırt çevirme hiçbirine ♪
Dialogue: 0,0:00:43.56,0:00:50.04,Lyrics,,0,0,0,karaoke,♪ Sağduyu dedikleri zihnidir toplulukların! ♪
Dialogue: 0,0:00:51.36,0:00:57.41,Lyrics,,0,0,0,karaoke,♪ Görmedim dünyanın sonunu kendi gözlerimle hiç. ♪
Dialogue: 0,0:00:57.41,0:01:01.96,Lyrics,,0,0,0,karaoke,♪ O yüzden gitmemiz lazım Kaptan Özgür-Ruh! ♪
Dialogue: 0,0:01:01.96,0:01:04.72,Lyrics,,0,0,0,karaoke,♪ Kim demiş imkansız diye,...
Dialogue: 0,0:01:04.71,0:01:07.89,Lyrics,,0,0,0,karaoke,...daha hiçbir şey başlamadan! ♪
Dialogue: 0,0:01:07.88,0:01:12.72,Lyrics,,0,0,0,karaoke,♪ Her şeyi bilmek istiyorum ve şimdi bilebiliriz de... ♪
Dialogue: 0,0:01:12.72,0:01:18.68,Lyrics,,0,0,0,karaoke,♪ Bilebiliriz, bilebilirsin! Şu anda... ♪
Dialogue: 0,0:01:19.06,0:01:24.10,Lyrics,,0,0,0,karaoke,♪ Bilebiliriz, bilebilirim! Bu harika hissi... ♪
Dialogue: 0,0:01:24.39,0:01:31.32,Lyrics,,0,0,0,karaoke,♪ Hemen, şimdi, bilebiliriz! ♪
Dialogue: 0,0:01:37.34,0:01:38.64,Lyrics,,0,0,0,karaoke,♪ Evet, bilebiliriz! ♪
