Dialogue: 0,0:01:34.61,0:01:39.10,Captions,,0,0,0,,{\fad(500,500)\pos(630,550)}Tatlı Şehri Etekleri
Dialogue: 0,0:01:42.20,0:01:44.16,Main,,0,0,0,,Yardımınıza Jinbe mi yetiştii?
Dialogue: 0,0:01:44.16,0:01:46.87,Main,,0,0,0,,Evet, ben de şaşıp kalmıştım.
Dialogue: 0,0:01:47.73,0:01:51.53,Main,,0,0,0,,Sevindim. \NÖyleyse Nami-san da güvende.
Dialogue: 0,0:01:54.38,0:01:58.54,Main,,0,0,0,,Ama onlarla nasıl bir araya\Ngeleceğimizi bulmamız lazım.
Dialogue: 0,0:01:58.54,0:02:02.64,Main,,0,0,0,,Aramıza geri döndüğünü duyduklarında\Neminim havalara uçacaklardır.
Dialogue: 0,0:02:11.70,0:02:12.86,Flashbacks,,0,0,0,,Elveda!
Dialogue: 0,0:02:13.50,0:02:16.53,Flashbacks,,0,0,0,,Üzgünüm, buraya hiç gelmemeliydik!
Dialogue: 0,0:02:17.45,0:02:21.72,Main,,0,0,0,,Nami-san'ın karşısına çıkacak\Nyüzüm yok.
Dialogue: 0,0:02:23.52,0:02:28.12,Main,,0,0,0,,Namiler benden\Ndaha çok merak etti seni.
Dialogue: 0,0:02:28.86,0:02:32.62,Main,,0,0,0,,Fakat onu korkuttum.
Dialogue: 0,0:02:37.63,0:02:39.97,Main,,0,0,0,,Yağmur diniyor.
Dialogue: 0,0:02:50.65,0:02:55.07,Author,,0,0,0,,{\an2\fad(1000,0)\fs18} Türkçeleştirme & Çevirmen  {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&} - {\c&H01BAFF&}{\b1}dmc3{\b0}{\c&HFFFFFF&}\N{\fs17}thx to onepace.net
Dialogue: 0,0:18:08.20,0:18:15.30,Author,,0,0,0,,{\fad(500,500)\fs18} Türkçeleştirme & Çevirmen  {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&} - {\c&H01BAFF&}{\b1}dmc3{\b0}{\c&HFFFFFF&}\N{\fs17}thx to onepace.net
Dialogue: 0,0:36:07.70,0:36:10.70,Author,,0,0,0,,{\fad(0,0)\fs18} Türkçeleştirme & Çevirmen  {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&} - {\c&H01BAFF&}{\b1}dmc3{\b0}{\c&HFFFFFF&}\N{\fs17}thx to onepace.net
Dialogue: 0,0:02:50.65,0:02:55.07,Title,,0,0,0,,{\fad(1000,0)\pos(634,477)}Kale
Dialogue: 0,0:02:55.32,0:02:59.32,Captions,,0,0,0,,{\fad(500,500)\pos(645,550)}Ayna Dünyası
Dialogue: 0,0:03:03.03,0:03:04.53,Main,,0,0,0,,Buldum!
Dialogue: 0,0:03:04.53,0:03:07.64,Main,,0,0,0,,Emin misin? Choniki!
Dialogue: 0,0:03:08.41,0:03:12.25,Main,,0,0,0,,Bu ayna parçası aracılığıyla\Nbizi duyabilirler mi dersiniz?
Dialogue: 0,0:03:12.25,0:03:19.05,Main,,0,0,0,,Son konuşmamızı yaptığımız ayna, \Ncanavar ağaç Kingbaum'un kafasında kırılmıştı.
Dialogue: 0,0:03:23.06,0:03:23.97,Flashbacks,,0,0,0,,Kırıldı!
Dialogue: 0,0:03:25.56,0:03:27.39,Main,,0,0,0,,Yani...
Dialogue: 0,0:03:28.35,0:03:33.15,Main,,0,0,0,,...elimizdekiyle iletişim kurabilen\Nhiç yoktan bir cam parçası vardır.
Dialogue: 0,0:03:35.61,0:03:38.61,Main,,0,0,0,,Hey! Luffy!
Dialogue: 0,0:03:38.61,0:03:40.40,Main,,0,0,0,,Hey!
Dialogue: 0,0:03:40.40,0:03:42.66,Main,,0,0,0,,{\i1}Luffy!{\i}
Dialogue: 0,0:03:44.57,0:03:48.28,Main,,0,0,0,,{\i1}Orada mısın Luffy?!{\i0}
Dialogue: 0,0:03:48.28,0:03:49.59,Main,,0,0,0,,Bu...
Dialogue: 0,0:03:49.59,0:03:51.13,Main,,0,0,0,,Chopper'nın sesi!
Dialogue: 0,0:03:51.66,0:03:54.25,Main,,0,0,0,,{\i1}Hey!{\i}
Dialogue: 0,0:03:54.25,0:03:57.54,Main,,0,0,0,,{\i1}Sesimi alıyorsan cevap ver!
Dialogue: 0,0:03:57.54,0:03:59.55,Main,,0,0,0,,Chopper!
Dialogue: 0,0:04:00.83,0:04:02.26,Main,,0,0,0,,Luffy!
Dialogue: 0,0:04:02.26,0:04:04.47,Main,,0,0,0,,{\i1}Hey!{\i}
Dialogue: 0,0:04:06.26,0:04:09.39,Main,,0,0,0,,{\i1}Luffy! Beni duyabiliyor musun?
Dialogue: 0,0:04:09.39,0:04:11.56,Main,,0,0,0,,{\i1}Hey!{\i}
Dialogue: 0,0:04:11.56,0:04:13.04,Main,,0,0,0,,Buldum!
Dialogue: 0,0:04:13.55,0:04:16.44,Main,,0,0,0,,Buradan geliyormuş,\Nayna parçasından.
Dialogue: 0,0:04:16.44,0:04:18.19,Main,,0,0,0,,{\i1}Beni duyabiliyor musun?
Dialogue: 0,0:04:18.19,0:04:20.57,Main,,0,0,0,,Ayna ne alaka?
Dialogue: 0,0:04:20.57,0:04:25.49,Main,,0,0,0,,Uzun hikâye,\Nayna diyarında olduklarını bil yeter.
Dialogue: 0,0:04:26.49,0:04:28.74,Main,,0,0,0,,Siz iyi misiniz Chopper?
Dialogue: 0,0:04:28.74,0:04:32.96,Main,,0,0,0,,{\i1}Luffy! Oh ya!\NBulduk seni!
Dialogue: 0,0:04:34.58,0:04:37.13,Main,,0,0,0,,Luffy! Sanji-kun da yanında mı?
Dialogue: 0,0:04:38.25,0:04:40.67,Main,,0,0,0,,Evet, hemen yanımda.
Dialogue: 0,0:04:41.54,0:04:44.88,Main,,0,0,0,,Sanji-{\i1}san{\i0}, bir şeyinin\Nolmamasına öyle sevindim ki!
Dialogue: 0,0:04:49.56,0:04:50.72,Main,,0,0,0,,Sizden n'aber?
Dialogue: 0,0:04:50.72,0:04:56.15,Main,,0,0,0,,Aynaların içinden\Nherkesi çekip kurtardık Luffy!
Dialogue: 0,0:04:56.15,0:05:00.44,Main,,0,0,0,,Brook, Poneglifler'in\Nkopyasını çıkarmış üstelik!
Dialogue: 0,0:05:00.44,0:05:01.78,Main,,0,0,0,,Sahi mi?
Dialogue: 0,0:05:01.78,0:05:04.36,Main,,0,0,0,,{\i1}Sizden de bunu beklerdim çocuklar!
Dialogue: 0,0:05:04.36,0:05:09.58,Main,,0,0,0,,Ö- Övdün diye\Nmutlu olmam ki aptal!
Dialogue: 0,0:05:11.16,0:05:12.69,Main,,0,0,0,,Şapşal şey!
Dialogue: 0,0:05:13.68,0:05:15.62,Main,,0,0,0,,Bacaksıza bak!
Dialogue: 0,0:05:16.46,0:05:21.75,Main,,0,0,0,,Luffy, Sanji'yle beraber olman güzel de\Nortak bir zeminde buluşabildiniz mi?
Dialogue: 0,0:05:30.39,0:05:33.56,Main,,0,0,0,,Sanji henüz adadan ayrılamaz.
Dialogue: 0,0:05:33.56,0:05:36.27,Main,,0,0,0,,Ne?
Dialogue: 0,0:05:51.12,0:05:53.91,Main,,0,0,0,,Dinleyin çocuklar.
Dialogue: 0,0:05:53.91,0:05:58.20,Main,,0,0,0,,Big Mom'ın çay partisiyle\Ndüğünü mahvedip...
Dialogue: 0,0:05:58.20,0:06:01.00,Main,,0,0,0,,...Sanji'nin ailesini kurtarıyoruz!
Dialogue: 0,0:06:01.00,0:06:04.38,Main,,0,0,0,,Sonrasında Sanji aramıza dönüyor!
Dialogue: 0,0:06:10.17,0:06:13.56,Main,,0,0,0,,B... Big...
Dialogue: 0,0:06:20.44,0:06:23.48,Main,,0,0,0,,Luffy! Rakibimiz Yonkou!
Dialogue: 0,0:06:25.03,0:06:27.04,Main,,0,0,0,,Şahsi sorunum yüzünden herkesi...
Dialogue: 0,0:06:27.07,0:06:30.28,Main,,0,0,0,,Yani Nami-san'ın hayatını \Ntehlikeye atmak istemem!
Dialogue: 0,0:06:30.74,0:06:31.70,Main,,0,0,0,,Bu yüzden...
Dialogue: 0,0:06:39.33,0:06:42.25,Main,,0,0,0,,Yaşasın!
Dialogue: 0,0:06:46.34,0:06:48.05,Main,,0,0,0,,Neyin var oğlum senin!
Dialogue: 0,0:06:48.05,0:06:53.97,Main,,0,0,0,,Luffy'yle ciddi ciddi dövüştüğünüzü duydum,\Nnasıl endişelendim bir bilsen aptal!
Dialogue: 0,0:06:53.97,0:06:58.35,Main,,0,0,0,,Çok rahatladım!\NSahi ama ya, şapşal şey!
Dialogue: 0,0:06:58.35,0:07:00.98,Main,,0,0,0,,Bacağına tükürdüğüm!
Dialogue: 0,0:07:00.98,0:07:05.48,Main,,0,0,0,,O zaman Sanji-kun aramıza\Ndönebilecek, değil mi Luffy?
Dialogue: 0,0:07:09.86,0:07:12.45,Main,,0,0,0,,Nami-{\i1}san{\i0}... Şey...
Dialogue: 0,0:07:12.45,0:07:15.08,Main,,0,0,0,,Sahi Sanji-{\i1}kun{\i0}...
Dialogue: 0,0:07:15.08,0:07:19.50,Main,,0,0,0,,{\i1}...beni nasıl korkuttuğunu...
Dialogue: 0,0:07:21.24,0:07:23.54,Main,,0,0,0,,...asla unutmayacağım.
Dialogue: 0,0:07:27.54,0:07:28.71,Main,,0,0,0,,Nami...
Dialogue: 0,0:07:32.86,0:07:37.52,Main,,0,0,0,,Yine de şimdilik geride bırakalım.\NÇay partisine bir şey kalmadı.
Dialogue: 0,0:07:37.52,0:07:41.48,Main,,0,0,0,,{\i1}Seni n'olursa olsun\Ngeri alacağım Sanji-kun!
Dialogue: 0,0:07:41.69,0:07:50.15,Thump,,0,0,0,,{\fad(600,0)\frz21.18\fs50\pos(268,56)}Kalbi Çarpar
Dialogue: 0,0:07:41.48,0:07:47.08,Main,,0,0,0,,{\move(640,702,640,702,23,-19)}\NNe?\NAşk itirafı mıydı bu, Nami-san?
Dialogue: 0,0:07:47.08,0:07:50.15,Main,,0,0,0,,Nedenini bilmesem de\Nrahatladım sanki.
Dialogue: 0,0:07:52.92,0:07:56.66,Main,,0,0,0,,Pekâlâ Luffy,\Nşimdi yapmamız gerekeni biliyoruz.
Dialogue: 0,0:07:56.66,0:07:57.82,Main,,0,0,0,,Evet.
Dialogue: 0,0:07:57.82,0:08:02.75,Main,,0,0,0,,Bu arada\NSanji'nin ablası hayatımı kurtarmıştı.
Dialogue: 0,0:08:11.02,0:08:13.09,Main,,0,0,0,,Bu yüzden onları da\Nkurtarmak istiyorum.
Dialogue: 0,0:08:13.09,0:08:15.72,Main,,0,0,0,,{\i1}Evet, hepsini kurtaralım.
Dialogue: 0,0:08:15.72,0:08:18.93,Main,,0,0,0,,Fakat kolay olmayacak.
Dialogue: 0,0:08:18.93,0:08:22.39,Main,,0,0,0,,Hedefimiz Big Mom'ın hakkından gelmek\Nolmasa da...
Dialogue: 0,0:08:22.39,0:08:26.94,Main,,0,0,0,,...bu çay partilerini\Niple çeken birisidir.
Dialogue: 0,0:08:26.94,0:08:33.03,Main,,0,0,0,,Partiyi baltalamakla bir Yonkou'nun\Nöfkesini üzerimize çekmiş olacağız.
Dialogue: 0,0:08:36.66,0:08:43.12,Main,,0,0,0,,Üstelik adada birkaç Bakan'la karşılaşmış\Nolsanız da...
Dialogue: 0,0:08:43.88,0:08:48.21,Main,,0,0,0,,...kendileri Big Mom Korsanları'nın\Nyalnızca küçük bir kısmını oluşturur.
Dialogue: 0,0:08:48.21,0:08:52.38,Main,,0,0,0,,Onlardan çok daha kuvvetlileri\Nçay partisine iştirak edecektir.
Dialogue: 0,0:08:54.88,0:09:00.72,Main,,0,0,0,,Dünyanın dört bir yanındaki\Nyeraltı patronları da davet edildi.
Dialogue: 0,0:09:00.72,0:09:03.85,Main,,0,0,0,,Öte yandan, biz ise...
Dialogue: 0,0:09:08.65,0:09:10.99,Main,,0,0,0,,...yalnızca 10 kişiyiz.
Dialogue: 0,0:09:10.99,0:09:14.20,Main,,0,0,0,,Lan! Bizi niye katıyorsun?
Dialogue: 0,0:09:14.20,0:09:17.07,Main,,0,0,0,,Uydurma!\NYalnızca 8 kişisiniz!
Dialogue: 0,0:09:17.07,0:09:19.49,Main,,0,0,0,,Umarım hepiniz de geberir gidersiniz!
Dialogue: 0,0:09:21.37,0:09:22.58,Main,,0,0,0,,Luffy.
Dialogue: 0,0:09:23.33,0:09:26.50,Main,,0,0,0,,Buradaki herkese söylemiş olsam da...
Dialogue: 0,0:09:26.50,0:09:30.30,Main,,0,0,0,,{\i1}...biraz alakasız gibi gelecek\Nbir şeyden daha bahsetmek istiyorum.
Dialogue: 0,0:09:31.30,0:09:35.26,Main,,0,0,0,,Capone "Gang" Bege'yi tanıyorsun, değil mi?
Dialogue: 0,0:09:35.26,0:09:38.22,Main,,0,0,0,,Evet, Sanji'yi o kaçırmıştı.
Dialogue: 0,0:09:40.81,0:09:45.23,Main,,0,0,0,,En Kötü Nesil'den biri olur,\Nadı da seninki kadar kötüye çıkmıştır.
Dialogue: 0,0:09:45.23,0:09:50.52,Main,,0,0,0,,Memleketi Batı Mavi'deki\Nyeraltı işlerinde...
Dialogue: 0,0:09:50.52,0:09:53.73,Main,,0,0,0,,{\i1}...5 güçlü mafya ailesinin sözü geçer.
Dialogue: 0,0:09:53.73,0:09:58.97,Main,,0,0,0,,Bu ailelerin birinin patronu da...
Dialogue: 0,0:09:58.97,0:10:01.04,Main,,0,0,0,,..."Gang" Bege idi.
Dialogue: 0,0:10:01.64,0:10:08.42,Main,,0,0,0,,"Gang" lakabı ise kiralık katil olarak kötü bir şöhret edindiği gençlik yıllarına dayanır.
Dialogue: 0,0:10:08.42,0:10:10.46,Main,,0,0,0,,Kiralık katil ha...
Dialogue: 0,0:10:10.46,0:10:15.71,Main,,0,0,0,,Çaresiz canlıları yaralamayı ve gitgide\Ngüçten düşmelerini izlemeyi...
Dialogue: 0,0:10:15.71,0:10:21.67,Main,,0,0,0,,...seven ruh hastası bir ergen\Nolduğunu işitmiştim.
Dialogue: 0,0:10:22.60,0:10:24.85,Main,,0,0,0,,Ne biçim herifmiş bu ya?
Dialogue: 0,0:10:24.85,0:10:28.98,Main,,0,0,0,,Aynını da suç babalarına yapmıştır.
Dialogue: 0,0:10:35.19,0:10:37.76,Main,,0,0,0,,Tadını nasıl buldunuz efendim?
Dialogue: 0,0:10:37.76,0:10:40.24,Main,,0,0,0,,Biraz daha acı olmalıydı.
Dialogue: 0,0:10:40.24,0:10:42.66,Main,,0,0,0,,Şöyle yaparsak nasıl olur?
Dialogue: 0,0:10:45.04,0:10:45.74,Main,,0,0,0,,Patron!
Dialogue: 0,0:10:48.58,0:10:50.60,Main,,0,0,0,,Şerefsiz...
Dialogue: 0,0:10:52.73,0:10:55.79,Main,,0,0,0,,Kurşun yeterince acı gelmiştir herhâlde?
Dialogue: 0,0:10:58.56,0:11:03.47,Main,,0,0,0,,Daha genç bir gangsterken bile\Nher daim yeraltı teşkilatı patronlarının...
Dialogue: 0,0:11:03.47,0:11:09.19,Main,,0,0,0,,...kellesini hedeflemiştir, kendi çetesini kurduktan\Nsonra da yalnızca patronları öldürmüştür.
Dialogue: 0,0:11:12.73,0:11:13.61,Main,,0,0,0,,Bege?
Dialogue: 0,0:11:14.38,0:11:16.11,Main,,0,0,0,,Direnme.
Dialogue: 0,0:11:16.11,0:11:18.32,Main,,0,0,0,,Ne? Bana ihanet mi ediyorsun?
Dialogue: 0,0:11:20.28,0:11:22.18,Main,,0,0,0,,Sayıca azınlıktasın!
Dialogue: 0,0:11:22.18,0:11:23.53,Main,,0,0,0,,Bege!
Dialogue: 0,0:11:28.41,0:11:30.33,Main,,0,0,0,,Fakat Bege...
Dialogue: 0,0:11:30.33,0:11:34.34,Main,,0,0,0,,...düşmanlarının ne koltuğuna\Nne de bölgesine göz dikmiştir.
Dialogue: 0,0:11:34.34,0:11:36.29,Main,,0,0,0,,Para ve ganimeti almıştır sadece.
Dialogue: 0,0:11:36.29,0:11:38.80,Captions,,0,0,0,,{\frz24.54\org(664,228)\pos(670.667,214.667)}KANLI TRAJEDİ! İÇ ÇATIŞMA MI?!
Dialogue: 0,0:11:38.80,0:11:41.26,Captions,,0,0,0,,{\frz340.9\pos(609,271.333)}UYANDIRAN KABUS! YERALTI DÜNYASI HALA KARIŞIK!
Dialogue: 0,0:11:41.26,0:11:43.72,Captions,,0,0,0,,{\pos(636,274.666)}YERALTI TEŞKİLATLARINDAKİ KAOSA SUİKASTLER Mİ NEDEN OLDU?
Dialogue: 0,0:11:47.56,0:11:52.07,Main,,0,0,0,,Akabinde de çeteler arası kanlı\Nçekişmeleri ve bu olayların...
Dialogue: 0,0:11:52.07,0:11:56.57,Main,,0,0,0,,...ucunun dokunduğu perde arkasındaki\Nliderlerin öfkelenişini keyifle seyretmiştir.
Dialogue: 0,0:11:57.11,0:11:59.86,Main,,0,0,0,,Aşağılık herifin teki yani.
Dialogue: 0,0:11:59.86,0:12:03.99,Main,,0,0,0,,Fakat ne ekersen onu biçersin.
Dialogue: 0,0:12:03.99,0:12:09.37,Main,,0,0,0,,{\i1}İntikam peşinde olanlar\Nonu hedef alıp durdu.
Dialogue: 0,0:12:13.37,0:12:14.63,Main,,0,0,0,,Gelgelelim...
Dialogue: 0,0:12:14.63,0:12:21.07,Main,,0,0,0,,...Bege bundan bile keyif aldı. Zapt edilmez\Nbir kale inşa edip karşı koydu.
Dialogue: 0,0:12:21.07,0:12:24.30,Main,,0,0,0,,Düşmanlarının hezimetiyle\Nalay eder oldu.
Dialogue: 0,0:12:24.30,0:12:29.18,Main,,0,0,0,,Karadaki hayattan usanınca da\Nicraatlerine denizde devam etti.
Dialogue: 0,0:12:30.00,0:12:31.43,Main,,0,0,0,,Patron!
Dialogue: 0,0:12:31.43,0:12:35.23,Main,,0,0,0,,Kim yaptı lan bunu?\NSoktuklarım!
Dialogue: 0,0:12:35.64,0:12:41.15,Main,,0,0,0,,Tanınmış korsan tayfalarının yalnızca\Nkaptanlarını indirerek adı çıktı.
Dialogue: 0,0:12:47.28,0:12:51.66,Main,,0,0,0,,Denizde şimdi bile intikam\Narayan tayfalara karşı...
Dialogue: 0,0:12:52.52,0:12:56.60,Main,,0,0,0,,...bir Yonkou'nun korumasına girmekten\Ndaha iyi bir sığınılacak liman yoktur.
Dialogue: 0,0:12:56.60,0:12:59.38,Main,,0,0,0,,Bu yüzden de Big Mom'ın\Nbünyesine katıldı.
Dialogue: 0,0:13:01.67,0:13:07.11,Main,,0,0,0,,Big Mom, onun açıkgözlülüğünü ve\Nsavunma yeteneğini takdir ederek...
Dialogue: 0,0:13:07.11,0:13:12.49,Main,,0,0,0,,...önümüzdeki çay partisi için\N"Kale" er unvanını yakıştırıp...
Dialogue: 0,0:13:12.49,0:13:16.40,Main,,0,0,0,,...güvenliğe dair tüm yönetimi\Nkendisine bıraktı.
Dialogue: 0,0:13:16.40,0:13:20.65,Main,,0,0,0,,Bunları neden şimdi anlatıyorsun Jinbe?
Dialogue: 0,0:13:20.65,0:13:26.11,Main,,0,0,0,,Savunma birimleri bizim yanımızda olursa\Nönümüzde bir engel kalmamış olur.
Dialogue: 0,0:13:26.11,0:13:26.95,Main,,0,0,0,,Ne?
Dialogue: 0,0:13:26.95,0:13:31.37,Main,,0,0,0,,Bu seferki çay partisinin\Nbüyük olayı düğündür.
Dialogue: 0,0:13:31.37,0:13:37.50,Main,,0,0,0,,Bilindiği üzere Big Mom düğünde\Ntüm Vinsmoke fertlerini katlederek...
Dialogue: 0,0:13:37.50,0:13:41.38,Main,,0,0,0,,{\i1}...Germa'yı ele geçirmek istiyor.
Dialogue: 0,0:13:41.38,0:13:46.43,Main,,0,0,0,,Bege, Big Mom'ın kellesini alacak!
Dialogue: 0,0:13:46.43,0:13:47.59,Main,,0,0,0,,Ne?
Dialogue: 0,0:13:47.59,0:13:51.01,Main,,0,0,0,,Nasıl olur?\NHerkes bildiğini okuyor öyleyse!
Dialogue: 0,0:13:53.35,0:14:01.82,Main,,0,0,0,,Luffy, sizi bu adaya getiren\NPekoms'u Begeler tutsak alarak...
Dialogue: 0,0:14:01.82,0:14:06.03,Main,,0,0,0,,{\i1}...planlarını gerçekleştirmeye\Nbir adım daha yaklaşmış oldular.
Dialogue: 0,0:14:06.76,0:14:10.24,Main,,0,0,0,,Pekoms!\NDemek başına bunlar gelmiş.
Dialogue: 0,0:14:17.54,0:14:20.13,Main,,0,0,0,,Pekoms ziyadesiyle sadık biri olduğundan...
Dialogue: 0,0:14:20.88,0:14:24.90,Main,,0,0,0,,...Bege sesini kesmek için köpek balıklarıyla dolu bir suya attı onu.
Dialogue: 0,0:14:28.63,0:14:30.72,Main,,0,0,0,,Ne?
Dialogue: 0,0:14:36.77,0:14:38.27,Main,,0,0,0,,Gelgelelim...
Dialogue: 0,0:14:38.27,0:14:44.07,Main,,0,0,0,,...bu olaya şahit olan yoldaşlarım\Ntam zamanında Pekoms'u kurtarmış.
Dialogue: 0,0:14:44.07,0:14:46.57,Main,,0,0,0,,Kendisi şu an istirahat ediyor.
Dialogue: 0,0:14:46.57,0:14:49.31,Main,,0,0,0,,Şükürler olsun.\NBir şeyi yok demek.
Dialogue: 0,0:14:49.31,0:14:52.45,Main,,0,0,0,,Başına amma çok şey gelmiş.
Dialogue: 0,0:14:52.45,0:14:56.75,Main,,0,0,0,,Adi Bege!\NBu yanına kalmayacak!
Dialogue: 0,0:14:59.60,0:15:03.50,Main,,0,0,0,,Luffy, şimdi asıl konuya geliyorum.
Dialogue: 0,0:15:04.38,0:15:10.72,Main,,0,0,0,,{\i1}Pekoms'tan olanları dinleyince\Nbir plan yaptım.
Dialogue: 0,0:15:10.72,0:15:13.39,Main,,0,0,0,,{\i1}Kendi kendime\N"Ne yapardınız?" diye sordum.
Dialogue: 0,0:15:13.97,0:15:16.31,Main,,0,0,0,,Tüm hikâyeyi dinledikten sonra da...
Dialogue: 0,0:15:16.31,0:15:21.15,Main,,0,0,0,,...Sanji'yle ailesini kurtarmak\Nisteyeceğinizden adım gibi emindim.
Dialogue: 0,0:15:23.13,0:15:27.23,Main,,0,0,0,,Pekoms'a olanlara üzülsem de\Nşu şartlar altında...
Dialogue: 0,0:15:27.23,0:15:30.89,Main,,0,0,0,,{\i1}...Bege'yi karşına almak istediğine\Nemin misin?
Dialogue: 0,0:15:34.62,0:15:37.70,Main,,0,0,0,,{\i1}Çay partisi sabah 10'da başlıyor.
Dialogue: 0,0:15:37.70,0:15:40.33,Main,,0,0,0,,{\i1}Yani yaklaşık 5 saat sonra.
Dialogue: 0,0:15:40.33,0:15:44.13,Main,,0,0,0,,Hiçbir planı olmayan\Nbiz 10'umuzun aksine...
Dialogue: 0,0:15:44.13,0:15:46.39,Main,,0,0,0,,Bizi de saymasana lan!
Dialogue: 0,0:15:46.39,0:15:49.76,Main,,0,0,0,,İnsafsızlar! \NPlanlarınızı bizimkilere anlatacağım!
Dialogue: 0,0:15:49.76,0:15:56.94,Main,,0,0,0,,{\i1}Dinle Luffy. Bege'nin çetesi\Nbugüne için çok iyi hazırlandı.
Dialogue: 0,0:16:00.02,0:16:02.08,Main,,0,0,0,,Luffy! Sanji!
Dialogue: 0,0:16:02.82,0:16:05.06,Main,,0,0,0,,Bege'nin planına ortak olalım!
Dialogue: 0,0:16:05.06,0:16:07.07,Main,,0,0,0,,Ne?
Dialogue: 0,0:16:11.53,0:16:14.32,Main,,0,0,0,,Ama haklısın da!
Dialogue: 0,0:16:14.32,0:16:15.91,Main,,0,0,0,,Ne?
Dialogue: 0,0:16:17.12,0:16:19.12,Main,,0,0,0,,Kafayı mı yedin Luffy?
Dialogue: 0,0:16:19.12,0:16:21.10,Main,,0,0,0,,Bu plan kafana yattı mı Luffy?
Dialogue: 0,0:16:21.10,0:16:23.65,Main,,0,0,0,,Söylediğim gibi çıktı, bakın!
Dialogue: 0,0:16:23.65,0:16:26.96,Main,,0,0,0,,Luffy, altımızdan dördü\Nbu plana karşı çıkmıştı!
Dialogue: 0,0:16:26.96,0:16:30.80,Main,,0,0,0,,Bege-san'ın neler yaptığını\Ndinlemedin mi?
Dialogue: 0,0:16:30.80,0:16:33.88,Main,,0,0,0,,Bu şekilde her şey\Nçözüme kavuşacak ama değil mi?
Dialogue: 0,0:16:33.88,0:16:35.98,Main,,0,0,0,,Böyle kestirip atamazsın.
Dialogue: 0,0:16:35.98,0:16:40.02,Main,,0,0,0,,{\i1}Aslında bir görüşme ayarladım bile.\NGitmek istiyor musun?
Dialogue: 0,0:16:40.02,0:16:42.02,Main,,0,0,0,,Tamamdır, hemen gidelim!
Dialogue: 0,0:16:42.02,0:16:44.14,Main,,0,0,0,,Ne?
Dialogue: 0,0:16:44.14,0:16:48.04,Main,,0,0,0,,Merak etme, \Nkafana yatmazsa reddedebilirsin.
Dialogue: 0,0:16:48.04,0:16:51.08,Main,,0,0,0,,Amacımız biraz da olsa\Nonlarınkinden farklı neticede.
Dialogue: 0,0:16:52.11,0:16:57.88,Main,,0,0,0,,{\i1}Luffy, Sanji. \NBegeler'in karargâhı adanın kuzeybatısında.
Dialogue: 0,0:16:57.88,0:17:03.11,Main,,0,0,0,,{\i1}Sekizimiz de bu boyuttan doğruca\Nkarargâhlarına gidiyoruz. Orada görüşürüz!
Dialogue: 0,0:17:03.11,0:17:05.92,Main,,0,0,0,,{\i1}Bizi de katma diyorum be!
Dialogue: 0,0:17:06.48,0:17:08.09,Main,,0,0,0,,Tamamdır, anlaşıldı!
Dialogue: 0,0:17:12.88,0:17:16.93,Captions,,0,0,0,,{\fad(500,0)\pos(645,485)}Ateş Tankı Korsanları Karargâhı,\N Whole Cake Adası
Dialogue: 0,0:17:20.88,0:17:23.06,Main,,0,0,0,,Bobbin'i öldürdün mü?
Dialogue: 0,0:17:23.06,0:17:26.44,Captions,,0,0,0,,{\fad(300,0)\pos(645,545)}Ateş Tankı Korsanları
Dialogue: 0,0:17:23.06,0:17:26.44,Main,,0,0,0,,{\pos(650,715)}Evet efendim, Kara Bacak'ın peşindeydi.
Dialogue: 0,0:17:26.44,0:17:30.18,Main,,0,0,0,,Ne de olsa Germa\Nbenim kahramanım olur.
Dialogue: 0,0:17:31.48,0:17:33.32,Captions,,0,0,0,,{\fad(300,0)\pos(645,550)}"Canavar Tabanca" Vito
Dialogue: 0,0:17:33.32,0:17:36.49,Main,,0,0,0,,Gerçekten de geliyorlar mı?
Dialogue: 0,0:17:37.12,0:17:38.47,Main,,0,0,0,,Baba?
Dialogue: 0,0:17:38.47,0:17:40.66,Captions,,0,0,0,,{\fad(300,0)\pos(645,550)}"Tetikçi" Gotti
Dialogue: 0,0:17:40.66,0:17:44.71,Main,,0,0,0,,Jinbe kafa bulacak bir adam değildir.
Dialogue: 0,0:17:45.26,0:17:48.67,Main,,0,0,0,,İki taraf da Big Mom'a karşı\Nhareket edeceğine göre...
Dialogue: 0,0:17:48.67,0:17:54.01,Main,,0,0,0,,...yersiz düşman edinmekten kaçınmamız\Nkonusunda haklı.
Dialogue: 0,0:17:54.01,0:17:57.38,Main,,0,0,0,,Gerisi Hasır Şapka'nın ağzından\Nçıkacaklara kalmış.
Dialogue: 0,0:17:57.38,0:18:00.10,Main,,0,0,0,,Kafasına yatmazsa...
Dialogue: 0,0:18:01.77,0:18:04.10,Main,,0,0,0,,...buracıkta kellesini alırız!
Dialogue: 0,0:18:07.98,0:18:15.36,Captions,,0,0,0,,{\fad(200,500)\pos(190,510)\fs35}Düğün Pastasının \NSon Rütuşları
Dialogue: 0,0:18:07.98,0:18:15.36,Captions,,0,0,0,,{\fad(200,500)\fs35\pos(1085,510)}Whole Cake Şatosu'nun \N8. Katı - Dev Mutfak
Dialogue: 0,0:18:27.83,0:18:32.35,Lyrics,,0,0,0,,♪ Yumuşacık, kabarık mı kabarık...\N♪ Islak, kabarık mı kabarık...
Dialogue: 0,0:18:32.35,0:18:34.84,Lyrics,,0,0,0,,...hayat! ♪
Dialogue: 0,0:18:34.84,0:18:36.34,Lyrics,,0,0,0,,♪ Yoktur hiç...
Dialogue: 0,0:18:36.34,0:18:42.47,Lyrics,,0,0,0,,{\pos(650,715)}...acı bir hayat! Gözyaşlarının tadı... ♪
Dialogue: 0,0:18:37.97,0:18:42.47,Captions,,0,0,0,,{\fad(300,0)\pos(630,445)}Streusen - "Gurme Şövalyesi"\NBaş Şef, Big Mom Korsanları{\i1}
Dialogue: 0,0:18:42.47,0:18:43.85,Lyrics,,0,0,0,,♪ Bir tutam tuz... ♪
Dialogue: 0,0:18:43.85,0:18:46.96,Lyrics,,0,0,0,,♪ Çile gözyaşları... ♪
Dialogue: 0,0:18:46.96,0:18:49.27,Lyrics,,0,0,0,,♪ Koca bir kaşık dolusu... ♪
Dialogue: 0,0:18:49.27,0:18:54.15,Lyrics,,0,0,0,,♪ Madem öyle, en azından tatlı için...
Dialogue: 0,0:18:54.15,0:19:04.03,Lyrics,,0,0,0,,...istemez misin güzelim bir pasta? ♪
Dialogue: 0,0:18:58.82,0:19:04.03,Secondary,,0,0,0,,{\an8}Baş şefim! Baş şefim!
Dialogue: 0,0:19:04.03,0:19:08.17,Lyrics,,0,0,0,,♪ Yumuşacık, kabarık mı kabarık...\N♪ Islak, kabarık mı kabarık...
Dialogue: 0,0:19:08.17,0:19:11.92,Lyrics,,0,0,0,,♪ Yumuşacık, kabarık mı kabarık...\N♪ Islak, kabarık mı kabarık...
Dialogue: 0,0:19:11.92,0:19:16.00,Lyrics,,0,0,0,,♪ Yumuşacık, kabarık mı kabarık...\N♪ Islak, kabarık mı kabarık...
Dialogue: 0,0:19:16.00,0:19:20.45,Lyrics,,0,0,0,,♪ Yumuşacık, kabarık mı kabarık...\N♪ Islak, kabarık mı kabarık...
Dialogue: 0,0:19:26.26,0:19:30.77,Captions,,0,0,0,,{\fad(300,0)\pos(645,550)}Doğu Körfezi
Dialogue: 0,0:19:27.10,0:19:30.77,Main,,0,0,0,,{\pos(650,720)}Olmaz Pekoms! Daha dinlenmen gerek!
Dialogue: 0,0:19:32.74,0:19:40.32,Main,,0,0,0,,Grr! Jinbe gerçekten de yılan Bege'nin\Ndurumunu Mama'ya anlattı mı?
Dialogue: 0,0:19:40.32,0:19:41.74,Main,,0,0,0,,Elbette!
Dialogue: 0,0:19:41.74,0:19:48.16,Main,,0,0,0,,Sanırım şimdiye de hain Bege,\NMama'nın ellerinde kevgire dönmüştür.
Dialogue: 0,0:19:48.16,0:19:53.52,Main,,0,0,0,,Grr! Sanıyor musun? İhtimaller yetmez!\NGidip bizzat ona söylemeliyim!
Dialogue: 0,0:19:53.52,0:19:55.29,Main,,0,0,0,,Sakin ol bakayım.
Dialogue: 0,0:19:58.04,0:20:00.88,Main,,0,0,0,,İstirahat etmen gerek Pekoms.
Dialogue: 0,0:20:00.88,0:20:07.18,Main,,0,0,0,,Fakat Praline, Jinbe'nin haberi\Nyetiştirmesine engel olurlarsa... Grr!
Dialogue: 0,0:20:07.18,0:20:10.69,Main,,0,0,0,,Derdin buysa, bu işi\NJinbe'ye bırakman çok daha iyi olur!
Dialogue: 0,0:20:10.69,0:20:15.31,Main,,0,0,0,,Şu hâlinle anca yük olursun.\NOtur oturduğun yere!
Dialogue: 0,0:20:15.31,0:20:19.81,Main,,0,0,0,,Evet ya Pekoms! Gemi doktoru olarak\Nseni hayatta bırakmam!
Dialogue: 0,0:20:19.81,0:20:21.53,Main,,0,0,0,,Ayağa bile kalkayım deme!
Dialogue: 0,0:20:21.53,0:20:22.95,Main,,0,0,0,,Aynen! Aynen!
Dialogue: 0,0:20:22.95,0:20:24.87,Main,,0,0,0,,- Kesinlikle.\N- Dinlenmene bak. Dinlen!
Dialogue: 0,0:20:33.51,0:20:36.71,Main,,0,0,0,,Sizde bir tuhaflık var.
Dialogue: 0,0:20:38.00,0:20:42.39,Main,,0,0,0,,Körfezde gece boyunca hareketlilik vardı.
Dialogue: 0,0:20:42.39,0:20:46.39,Main,,0,0,0,,Bir şeyler taşıdıklarını gördüm!
Dialogue: 0,0:20:49.26,0:20:53.64,Main,,0,0,0,,Beni kurtardığınız için minnettarım\Nfakat gitmem gerek!
Dialogue: 0,0:20:53.64,0:20:56.09,Main,,0,0,0,,Hayır, olmaz!\NBırakmayız!
Dialogue: 0,0:20:56.09,0:20:58.86,Main,,0,0,0,,Ne demek bırakmazsınız? Grr!
Dialogue: 0,0:20:58.86,0:21:01.34,Main,,0,0,0,,Ne saklıyorsunuz lan siz?
Dialogue: 0,0:21:01.34,0:21:03.80,Main,,0,0,0,,Eyvah!!
Dialogue: 0,0:21:15.29,0:21:16.78,Main,,0,0,0,,{\pos(650,722)}Geldik!
Dialogue: 0,0:21:15.62,0:21:19.42,Captions,,0,0,0,,{\fad(300,0)\pos(655,545)}Ateş Tankı Korsanları Karargâhı
Dialogue: 0,0:21:16.78,0:21:18.75,Main,,0,0,0,,{\pos(650,722)}Bege'nin karargâhı burası.
Dialogue: 0,0:21:30.45,0:21:33.14,Main,,0,0,0,,Ee, nasıl bir herifmiş bu Bege?
Dialogue: 0,0:21:33.14,0:21:35.48,Main,,0,0,0,,Jinbe'nin dediklerini duydun.
Dialogue: 0,0:21:36.81,0:21:38.94,Flashbacks,,0,0,0,,Ödlek herif!
Dialogue: 0,0:21:44.70,0:21:49.03,Main,,0,0,0,,Komplocu acımasız bir mafya patronu\Nolduğunu varsayabilirsin.
Dialogue: 0,0:21:53.83,0:21:58.71,Captions,,0,0,0,,{\fad(300,300)\pos(185,410)\fs35}Çay Partisinin başlamasına\N4 saat 15 dakika kaldı.
Dialogue: 0,0:22:02.05,0:22:06.45,Main,,0,0,0,,{\pos(650,722)}Kahramanım! Germa'dan Vinsmoke Sanji!
Dialogue: 0,0:22:02.05,0:22:11.06,CaptionsBig,,300,0,310,,{\fad(1000,1000)}"Canavar Tabanca"
Dialogue: 0,0:22:06.45,0:22:09.19,Main,,0,0,0,,{\pos(650,722)}Tekrar karşılaştığımıza çok sevindim-rero!
Dialogue: 0,0:22:10.08,0:22:11.10,Main,,0,0,0,,{\pos(650,722)}Yine mi sen...
Dialogue: 0,0:22:11.10,0:22:14.14,Main,,0,0,0,,Hey, diğerleri nerede?\NBege sen misin?
Dialogue: 0,0:22:14.14,0:22:18.65,Main,,0,0,0,,Acele etme bakayım.\NHerkes geldi ya da rero.
Dialogue: 0,0:22:18.65,0:22:20.36,Main,,0,0,0,,Rero da ne demek be?
Dialogue: 0,0:22:21.40,0:22:24.65,Main,,0,0,0,,Vay! Luffy! Sanji!
Dialogue: 0,0:22:24.65,0:22:26.70,Main,,0,0,0,,Sanji!
Dialogue: 0,0:22:26.70,0:22:29.80,Main,,0,0,0,,Nasıl endişelendirdin var ya,\Nalçak seni!
Dialogue: 0,0:22:29.80,0:22:31.95,Main,,0,0,0,,Kusura bakma...\NHa?
Dialogue: 0,0:22:32.84,0:22:35.54,Main,,0,0,0,,O değil de ne bu kılık?
Dialogue: 0,0:22:37.09,0:22:40.35,Main,,0,0,0,,Siz de banyo yapsanıza.
Dialogue: 0,0:22:41.33,0:22:46.09,Main,,0,0,0,,Ne lan bu rahatlık? Vakit yok vakit!\NHem banyo yapmayı sevmezsin sen!
Dialogue: 0,0:22:46.09,0:22:48.63,Main,,0,0,0,,Hayır, siz de banyo yapmalısınız-rero.
Dialogue: 0,0:22:49.70,0:22:52.35,Main,,0,0,0,,Ancak o zaman konuşma faslına\Ngeçeriz-rero.
Dialogue: 0,0:22:52.35,0:22:54.47,Main,,0,0,0,,Şu şartlar altında banyo yapmak mı?
Dialogue: 0,0:22:54.47,0:22:58.77,Main,,0,0,0,,Babamız pasaklı insanlarla görüşmez.
Dialogue: 0,0:22:58.77,0:23:00.61,Main,,0,0,0,,Kimmiş pasaklı?
Dialogue: 0,0:23:11.11,0:23:15.87,Captions,,0,0,0,,{\fad(500,500)\pos(1095,390)}Bege'nin Karargahı İçi,\NKadınlar Banyosu
Dialogue: 0,0:23:21.64,0:23:25.50,Main,,0,0,0,,Ne? Lola zombi yaban domuzuna mı\Ndönüştü?
Dialogue: 0,0:23:25.50,0:23:29.47,Main,,0,0,0,,Sonra da âşık olduğu adamın\Nkuyruğundan bir an bile ayrılmadı!
Dialogue: 0,0:23:29.47,0:23:32.14,Main,,0,0,0,,Yapar sahiden de!
Dialogue: 0,0:23:32.14,0:23:35.50,Main,,0,0,0,,O an ve de canavar ormanında...
Dialogue: 0,0:23:35.50,0:23:39.02,Main,,0,0,0,,...Lola olmasaydı başıma neler gelirdi\Nkestiremiyorum bile.
Dialogue: 0,0:23:39.02,0:23:44.75,Main,,0,0,0,,Anlıyorum! Ama siz de sonra\Nkardeşimi kurtardınız! Teşekkürler!
Dialogue: 0,0:23:44.75,0:23:47.36,Main,,0,0,0,,Sevinçten ağlıyorum ya.
Dialogue: 0,0:23:47.36,0:23:50.90,Main,,0,0,0,,Küçüklüğümüzden beri\Nbirbirimize çok bağlıydık.
Dialogue: 0,0:23:51.82,0:23:53.37,Flashbacks,,0,0,0,,İkiz olduğumuzdan!
Dialogue: 0,0:23:53.37,0:23:58.66,Main,,0,0,0,,Zombi ha! Ölü biri hareket ediyormuş...\NDeniz harikalar diyarı resmen!
Dialogue: 0,0:23:59.57,0:24:02.37,Main,,0,0,0,,Ama daha sonra\NLola insan oldu tekrar, değil mi?
Dialogue: 0,0:24:02.37,0:24:06.50,Main,,0,0,0,,Evet, eminim şimdi bile\Ntuttuğunu koparan bir korsandır.
Dialogue: 0,0:24:11.34,0:24:14.72,Main,,0,0,0,,Evlenecek birini bulmuş mudur acaba?
Dialogue: 0,0:24:16.84,0:24:22.77,Main,,0,0,0,,Lola'nın düğünden kaçtığını söylerken\NBig Mom küplere binmiş gibiydi.
Dialogue: 0,0:24:26.15,0:24:29.90,Main,,0,0,0,,Evet, büyük yankı uyandırmıştı.
Dialogue: 0,0:24:29.90,0:24:30.86,Main,,0,0,0,,Ne?
Dialogue: 0,0:24:31.41,0:24:35.99,Main,,0,0,0,,Dünyanın dört bir yanındaki Devler\Nboş yere Mama'dan nefret etmez.
Dialogue: 0,0:24:35.99,0:24:39.20,Main,,0,0,0,,Dünyanın dört bir yanındaki Devler mi?
Dialogue: 0,0:24:39.20,0:24:43.80,Main,,0,0,0,,İşte bu yüzden karma bir toplum olan\NTotto Land halkında bile...
Dialogue: 0,0:24:43.80,0:24:46.67,Main,,0,0,0,,...Devler yoktur.
Dialogue: 0,0:24:46.67,0:24:49.21,Thoughts,,0,0,0,,{\i1}Devler harbiden de varmış!
Dialogue: 0,0:24:50.18,0:24:51.40,Main,,0,0,0,,Günün birinde...
Dialogue: 0,0:24:52.70,0:24:58.26,Main,,0,0,0,,...Lola'ya ilk görüşte âşık olduğunu\Nsöyleyen bir adam çıkageldi!
Dialogue: 0,0:24:59.85,0:25:04.77,Main,,0,0,0,,İnanmayacaksınız ama o adam\NDevler ülkesi Elbaf'ın prensi Loki idi!
Dialogue: 0,0:25:04.77,0:25:06.48,Main,,0,0,0,,Prens mi?\NVay be!
Dialogue: 0,0:25:07.86,0:25:10.48,Main,,0,0,0,,Mama öyle mutlu olmuştu ki\Ngözleri dolmuştu!
Dialogue: 0,0:25:11.11,0:25:13.99,Main,,0,0,0,,Lola, Elbaf'ın prensesi olursa...
Dialogue: 0,0:25:13.99,0:25:16.78,Main,,0,0,0,,...Devlerle maziye dayanan husumeti\Nunutulur...
Dialogue: 0,0:25:17.61,0:25:24.58,Main,,0,0,0,,...ve hatta dünyanın en güçlüsü olduğu söylenen\NDev ordusuna söz geçirebilir olurdu.
Dialogue: 0,0:25:24.58,0:25:26.25,Main,,0,0,0,,Anlıyorum.
Dialogue: 0,0:25:27.54,0:25:30.48,Main,,0,0,0,,Ama bizim kız kaçtı gitti.
Dialogue: 0,0:25:31.46,0:25:33.92,Main,,0,0,0,,Sonrasında işler sarpa sardı.
Dialogue: 0,0:25:35.43,0:25:37.96,Main,,0,0,0,,Lola'nın yerine\Nbeni kullanmaya çalışsa da...
Dialogue: 0,0:25:38.72,0:25:41.19,Main,,0,0,0,,...prens, Lola olmadığımı anladı.
Dialogue: 0,0:25:42.10,0:25:46.23,Main,,0,0,0,,Böylece Devler'le olan ilişkisi\Ndaha da beter bir hâl aldı.
Dialogue: 0,0:25:47.50,0:25:52.78,Main,,0,0,0,,Akabinde ise gerçek Devlerle yakınlaşma\Nfikrinden vazgeçip...
Dialogue: 0,0:25:52.78,0:25:56.66,Main,,0,0,0,,...insanları Dev'e dönüştürme araştırmalarına\Nyatırım yapmaya başladı.
Dialogue: 0,0:25:57.66,0:26:03.96,Main,,0,0,0,,Lola'ya olan kini arttı ve\Nonu vatan haini ilan etti!
Dialogue: 0,0:26:03.96,0:26:06.71,Main,,0,0,0,,Olur da geri dönerse\Nhemencecik öldürülür!
Dialogue: 0,0:26:07.92,0:26:13.30,Main,,0,0,0,,Ayrıca Lola'nın tıpkısı olduğum için\Nbana bakmaya da dayanamıyor.
Dialogue: 0,0:26:13.30,0:26:17.51,Flashbacks,,0,0,0,,İğrenç yüzünü gösterme bana!
Dialogue: 0,0:26:18.00,0:26:23.89,Main,,0,0,0,,Her karşılaşmamızda beni döverdi.\NYıllarca yara bere içinde gezdim.
Dialogue: 0,0:26:25.93,0:26:28.95,Main,,0,0,0,,Kendi annemin ellerinde\Nöleceğimi sanmıştım!
Dialogue: 0,0:26:30.50,0:26:34.57,Main,,0,0,0,,O canavarı annem olarak\Ngörmüyorum artık!
Dialogue: 0,0:26:38.45,0:26:47.18,Main,,0,0,0,,Fakat Lola vurdumduymaz bir kız olduğundan \Nannesinin onu öldüreceğini aklının ucundan bile geçirmez.
Dialogue: 0,0:26:48.41,0:26:51.92,Main,,0,0,0,,Anlıyorum...\NŞimdi her şey bir anlam kazandı.
Dialogue: 0,0:26:51.92,0:26:58.55,Main,,0,0,0,,Bu yüzden Bege, Mama'yı öldüreceğini\Nsöylediğinde en ufak bir üzüntü duymadım.
Dialogue: 0,0:26:59.09,0:27:02.81,Main,,0,0,0,,Nankör bir evlat olduğumu düşünebilirsin\Nama gerçek bu.
Dialogue: 0,0:27:04.01,0:27:06.80,Main,,0,0,0,,Aman da aman,\Nbanyo gibisi yok ya!
Dialogue: 0,0:27:08.89,0:27:11.47,Main,,0,0,0,,Cennetteyim sanki!
Dialogue: 0,0:27:11.47,0:27:13.65,Main,,0,0,0,,Yok be, öbür dünyayı istemem!
Dialogue: 0,0:27:14.77,0:27:20.28,Main,,0,0,0,,Savaş bitti gitti sanki. Gevşeyemiyorum.\NHâlâ savaşmamız gerekiyor!
Dialogue: 0,0:27:22.99,0:27:25.12,Main,,0,0,0,,Luffy-{\i1}san{\i}, Luffy-{\i1}san{\i}.
Dialogue: 0,0:27:25.12,0:27:28.50,Main,,0,0,0,,Dolapta süt buldum!
Dialogue: 0,0:27:29.50,0:27:33.13,Main,,0,0,0,,Lan! Dolabı izinsizce açmasanıza!
Dialogue: 0,0:27:33.13,0:27:37.59,Main,,0,0,0,,Bana da süt lazımdı!\NDişimin biri kırıldı da!
Dialogue: 0,0:27:37.59,0:27:41.22,Main,,0,0,0,,Benim de kafatasım çatladı.
Dialogue: 0,0:27:41.22,0:27:43.68,Main,,0,0,0,,Öyleyse süt için teşekkür ettik!
Dialogue: 0,0:27:58.53,0:28:00.70,Main,,0,0,0,,İyileştiler!
Dialogue: 0,0:28:00.70,0:28:03.27,Main,,0,0,0,,Nasıl iyileşirler be?
Dialogue: 0,0:28:03.27,0:28:06.58,Captions,,0,0,0,,{\fad(400,400)\pos(1110,450)\fs35}Çay Partisinin \Nbaşlamasına\N3 saat 30 dakika kaldı.
Dialogue: 0,0:28:03.98,0:28:06.91,Main,,0,0,0,,Bunu unutmayacağım Chiffon!\NSana inanamıyorum!
Dialogue: 0,0:28:06.91,0:28:10.78,Main,,0,0,0,,Mama'yı öldürmek isteyen birine\Nnasıl olur da el uzatırsın!
Dialogue: 0,0:28:12.08,0:28:18.05,Main,,0,0,0,,Chiffon-{\i1}sama{\i0}, tekrar düşünün lütfen!\NMama'yı kimsenin öldüremeyeceğini biliyorsunuz!
Dialogue: 0,0:28:18.05,0:28:19.92,Main,,0,0,0,,Brûlée abla!
Dialogue: 0,0:28:19.92,0:28:23.18,Main,,0,0,0,,Mama'nın bana neler yaptığını\Nbiliyorsun, değil mi?
Dialogue: 0,0:28:24.47,0:28:29.52,Main,,0,0,0,,Lola'nın hayatı tehlikede, \NBege ile Pez benim yegâne ailemdir!
Dialogue: 0,0:28:29.52,0:28:31.21,Main,,0,0,0,,Başka birine de ihtiyacım yok!
Dialogue: 0,0:28:32.74,0:28:34.56,Main,,0,0,0,,Geçti oğlum, geçti.
Dialogue: 0,0:28:42.36,0:28:45.57,Main,,0,0,0,,Pekâlâ, herkes geldi galiba?
Dialogue: 0,0:28:45.57,0:28:48.49,Main,,0,0,0,,Temizlendiniz mi bari?
Dialogue: 0,0:28:49.49,0:28:52.87,Main,,0,0,0,,Kıyafet insanı adam edermiş.
Dialogue: 0,0:28:52.87,0:28:57.21,Main,,0,0,0,,Kılığına dikkat etmeyen birileriyle\Niş konuşmam.
Dialogue: 0,0:29:01.75,0:29:05.09,Main,,0,0,0,,Pekâlâ, üç buçuk saatimiz kaldı.
Dialogue: 0,0:29:05.72,0:29:07.51,Main,,0,0,0,,Bir karara varalım.
Dialogue: 0,0:29:08.64,0:29:12.56,Main,,0,0,0,,Güçlerimizi birleştiriyor muyuz\Nbirleştirmiyor muyuz şimdi...
Dialogue: 0,0:29:32.07,0:29:33.62,Main,,0,0,0,,Tadı güzelmiş, değil mi Luffy?
Dialogue: 0,0:29:33.62,0:29:36.17,Main,,0,0,0,,İki dakika bir şey yapmadan\Nduramıyor musunuz?
Dialogue: 0,0:29:36.17,0:29:39.25,Main,,0,0,0,,Ha? Bunları yememiz için\Nkoymamışlar mı?
Dialogue: 0,0:29:42.01,0:29:45.80,Main,,0,0,0,,Bizim nezdimizde\Nayak bağından ibaretsiniz.
Dialogue: 0,0:29:47.39,0:29:52.02,Main,,0,0,0,,Hepinizi şuracıkta öldürerek\Nbu dertten kolayca kurtulmuş olurdum.
Dialogue: 0,0:29:52.02,0:29:53.52,Main,,0,0,0,,Bunu istediğine emin misin?
Dialogue: 0,0:29:54.64,0:29:59.52,Main,,0,0,0,,Ölürsem şayet,\NBig Mom'a suikast düzenleyemezsin.
Dialogue: 0,0:30:00.30,0:30:02.58,Main,,0,0,0,,Zira ortada bir düğün kalmaz.
Dialogue: 0,0:30:02.58,0:30:06.86,Main,,0,0,0,,Düğünden en az iki saat öncesine dek\Ngeri dönmezsem işkillenirler.
Dialogue: 0,0:30:06.86,0:30:10.63,Main,,0,0,0,,Evet, ne yazık ki dediklerin doğru.
Dialogue: 0,0:30:10.63,0:30:13.33,Main,,0,0,0,,Bu yüzden yalnızca seni\Nsağ bırakırız.
Dialogue: 0,0:30:14.54,0:30:17.17,Main,,0,0,0,,Gövde gösterisi yapmanın\Nsırası değil.
Dialogue: 0,0:30:20.67,0:30:24.80,Main,,0,0,0,,Luffy, içgüdülerin ittifak\Nolabileceğimizi söylüyor mu?
Dialogue: 0,0:30:24.80,0:30:26.01,Main,,0,0,0,,Ne diyorsun?
Dialogue: 0,0:30:45.99,0:30:48.20,Main,,0,0,0,,Sen Caesar'sın, değil mi?
Dialogue: 0,0:30:49.36,0:30:52.69,Main,,0,0,0,,Ne? Caesar mı? Hani?
Dialogue: 0,0:30:52.69,0:30:54.33,Main,,0,0,0,,Bunca zamandır dibimizde.
Dialogue: 0,0:30:54.33,0:30:56.25,Main,,0,0,0,,Nasıl anlamazsın ya?
Dialogue: 0,0:31:07.67,0:31:12.93,Main,,0,0,0,,Bu araştırmanın neticesi yok!\NUğraşmıyorum artık!
Dialogue: 0,0:31:12.93,0:31:16.56,Main,,0,0,0,,Ne yapacaksan yap lan Big Mom!
Dialogue: 0,0:31:19.70,0:31:21.60,Main,,0,0,0,,Caesar Clown!
Dialogue: 0,0:31:26.10,0:31:30.28,Main,,0,0,0,,C- C- Canla başla çalışıyorum!\NBig Mom'a öyle söyle!
Dialogue: 0,0:31:30.28,0:31:31.94,Main,,0,0,0,,Lüzumu yok.
Dialogue: 0,0:31:31.94,0:31:32.95,Main,,0,0,0,,Ne?
Dialogue: 0,0:31:35.16,0:31:39.91,Main,,0,0,0,,Gözetimini devralmak istediğimde\Nsorgusuz sualsiz kabul ettiler.
Dialogue: 0,0:31:39.91,0:31:43.54,Main,,0,0,0,,Artık güvenilir bir Kale'yim!
Dialogue: 0,0:31:47.15,0:31:49.25,Main,,0,0,0,,Kalbim mi o?
Dialogue: 0,0:31:49.25,0:31:54.14,Main,,0,0,0,,Güçlerinle yardım etmen takdirinde\Nseni buradan çıkarırım.
Dialogue: 0,0:31:55.35,0:32:00.49,Main,,0,0,0,,Beyinsiz! Karşında kim var senin?
Dialogue: 0,0:32:00.49,0:32:05.36,Main,,0,0,0,,Dünyaları bile tuzla buz edebilecek\Ndâhi bilim adamıyım ben!
Dialogue: 0,0:32:12.03,0:32:14.04,Main,,0,0,0,,Biliyoruz orasını.
Dialogue: 0,0:32:14.04,0:32:16.41,Main,,0,0,0,,O yüzden geldik zaten.
Dialogue: 0,0:32:18.84,0:32:20.37,Main,,0,0,0,,Hay sıçayım ya!
Dialogue: 0,0:32:20.37,0:32:23.33,Main,,0,0,0,,Önce Big Mom'a çalıştırdılar,\Nşimdi de Bege'ye!
Dialogue: 0,0:32:23.33,0:32:26.26,Main,,0,0,0,,Her hâlükârda köpek gibi\Nçalıştırılıyorum!
Dialogue: 0,0:32:26.26,0:32:28.34,Main,,0,0,0,,Aylaklık etmiyorsundur umarım-{\i1}rero{\i}?
Dialogue: 0,0:32:28.34,0:32:31.59,Main,,0,0,0,,Etmiyorum!\NKarşında kim var senin?
Dialogue: 0,0:32:31.59,0:32:35.26,Main,,0,0,0,,Öncekinin aksine bu vazife\Ntam bana göre.
Dialogue: 0,0:32:35.26,0:32:40.01,Main,,0,0,0,,Şaheserim çok yakında tamamlanacak!
Dialogue: 0,0:32:42.46,0:32:44.48,Main,,0,0,0,,Bunu duyduğuma sevindim.
Dialogue: 0,0:32:44.48,0:32:48.48,Main,,0,0,0,,Hasır Şapkalar da kısa süre sonra\Nburaya geliyor-rero.
Dialogue: 0,0:32:48.48,0:32:51.53,Main,,0,0,0,,Ne? Hasır Şapkalar mı?
Dialogue: 0,0:32:51.53,0:32:54.99,Main,,0,0,0,,Olamaz ya! Yüzlerini\Nbir daha görmek istemiyorum!
Dialogue: 0,0:32:55.24,0:32:59.40,Main,,0,0,0,,Onlar belayı çeken tipler!
Dialogue: 0,0:33:00.41,0:33:05.47,Main,,0,0,0,,Babamız senin de toplantıya\Nkatılmanı istiyor-rero.
Dialogue: 0,0:33:05.47,0:33:07.96,Main,,0,0,0,,Gecikeyim deme.
Dialogue: 0,0:33:12.17,0:33:14.38,Main,,0,0,0,,İnanamıyorum!
Dialogue: 0,0:33:14.38,0:33:16.43,Main,,0,0,0,,Başka çarem kalmadı!
Dialogue: 0,0:33:21.39,0:33:27.15,Main,,0,0,0,,C- Caesar mı? Yanılıyorsun,\NBege'nin sadık adamıyım ben.
Dialogue: 0,0:33:28.04,0:33:30.53,Main,,0,0,0,,"Gangster" Gastino!
Dialogue: 0,0:33:29.65,0:33:33.11,Captions,,0,0,0,,{\fad(150,0)\pos(377,425)}"Gangster"\N Gastino
Dialogue: 0,0:33:34.98,0:33:38.87,Main,,0,0,0,,- Saklamaya çalışmıyor bile...\N- Gastino mu?
Dialogue: 0,0:33:39.36,0:33:40.74,Main,,0,0,0,,Gaz insan olduğundan mı?
Dialogue: 0,0:33:40.74,0:33:43.04,Main,,0,0,0,,Gülüşü de aynı!
Dialogue: 0,0:33:43.04,0:33:46.07,Main,,0,0,0,,Karıştırdım demek ki.\NAf buyur.
Dialogue: 0,0:33:46.07,0:33:49.36,Main,,0,0,0,,Hayır be! Besbelli ki Caesar!
Dialogue: 0,0:33:49.36,0:33:50.17,Main,,0,0,0,,Ne?
Dialogue: 0,0:33:50.17,0:33:53.75,Main,,0,0,0,,Lan! Sensin işte!\NBurada ne işin var?
Dialogue: 0,0:33:53.75,0:33:57.05,Main,,0,0,0,,Burada olmayı istiyor muyum sence?\NDangalak!
Dialogue: 0,0:33:57.05,0:34:00.68,Main,,0,0,0,,Siz andavallar yüzünden\NBig Mom'a teslim edildim.
Dialogue: 0,0:34:00.68,0:34:05.43,Main,,0,0,0,,Elim kolum bağlıyken de\Nyine kalbim üzerinden tehdit edildim.
Dialogue: 0,0:34:05.43,0:34:06.89,Main,,0,0,0,,Eziyet edilmekten bıktım!
Dialogue: 0,0:34:07.87,0:34:12.28,Main,,0,0,0,,Trafalgar Law'a söyle onu gördüğüm yerde\Ngeberteceğim!
Dialogue: 0,0:34:12.28,0:34:14.19,Main,,0,0,0,,Fırsat buldum mu sizi de keza!
Dialogue: 0,0:34:14.19,0:34:17.11,Main,,0,0,0,,Kes zırvalamayı.\NUykumu getiriyorsun.
Dialogue: 0,0:34:23.33,0:34:26.12,Main,,0,0,0,,Vakit kaybediyoruz.
Dialogue: 0,0:34:26.12,0:34:28.55,Main,,0,0,0,,Hasır Şapka.
Dialogue: 0,0:34:28.55,0:34:31.71,Main,,0,0,0,,Var mısın yok musun?
Dialogue: 0,0:34:39.94,0:34:43.10,Main,,0,0,0,,Öncelikle Pekoms'u vurduğun için\Nbir tane geçireyim sana.
Dialogue: 0,0:34:47.69,0:34:48.52,Main,,0,0,0,,Hazır ol.
Dialogue: 0,0:34:53.05,0:34:54.53,Main,,0,0,0,,Yapma!
Dialogue: 0,0:34:56.82,0:34:58.03,Main,,0,0,0,,Ne?
Dialogue: 0,0:35:01.45,0:35:06.29,Main,,0,0,0,,Yumruğunu geri çek Luffy!\NBu şekilde anlaşmaya varamayız!
Dialogue: 0,0:35:06.29,0:35:08.96,Main,,0,0,0,,Ama arkadaşımı vurdu!
Dialogue: 0,0:35:10.00,0:35:13.10,Main,,0,0,0,,Babamıza dilini uzatan\Nkellesinden olur!
Dialogue: 0,0:35:13.10,0:35:14.92,Main,,0,0,0,,Yapma Gotti! Sakinleş-rero.
Dialogue: 0,0:35:14.92,0:35:16.05,Main,,0,0,0,,Yapmayın!
Dialogue: 0,0:35:16.05,0:35:17.67,Main,,0,0,0,,Fark etmez. Bırakın vursun.
Dialogue: 0,0:35:19.59,0:35:21.76,Main,,0,0,0,,Kışkışlayın şunları!
Dialogue: 0,0:35:21.76,0:35:23.39,Main,,0,0,0,,Sen sus.
Dialogue: 0,0:35:25.28,0:35:27.52,Main,,0,0,0,,Neden ya?
Dialogue: 0,0:35:29.02,0:35:30.90,Main,,0,0,0,,Böyle olacağını biliyordum.
Dialogue: 0,0:35:30.90,0:35:33.23,Main,,0,0,0,,Elden bir şey gelmez.
Dialogue: 0,0:35:35.13,0:35:36.94,Main,,0,0,0,,Big Mom'ı seviyor musunuz?
Dialogue: 0,0:35:37.92,0:35:39.40,Main,,0,0,0,,- Hiç!\N- Hayır!
Dialogue: 0,0:35:39.40,0:35:42.54,Main,,0,0,0,,Öyleyse aynı taraftasınız.
Dialogue: 0,0:35:42.54,0:35:47.91,Main,,0,0,0,,Müşterek bir yaşam tarzı veya gaye\Ngütmeseniz de düşmanınız aynı!
Dialogue: 0,0:35:49.00,0:35:52.08,Main,,0,0,0,,Birbirinizi sonra öldürürsünüz.
Dialogue: 0,0:35:52.08,0:35:56.13,Main,,0,0,0,,Şimdilik güçlerinizi birleştirmeniz\Niki tarafın da çıkarına olur!
Dialogue: 0,0:35:59.42,0:36:00.87,Main,,0,0,0,,Planın ne?
Dialogue: 0,0:36:00.87,0:36:03.52,Main,,0,0,0,,Kusursuz bir planım var.
Dialogue: 0,0:36:03.52,0:36:07.68,Main,,0,0,0,,Yapalım hemen!\NSonra da sizinle işim bitiyor!
