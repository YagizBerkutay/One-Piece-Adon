1Style: Author,Impress BT,22.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.7,0.7,9,10,10,10,1Style: Attack,Duality,30.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.0,1.0,7,12,12,12,1Style: Pekoms - Infobox,Roboto,39,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1,0,2,10,10,10,1Style: Map,Roboto,30,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1.1,0,2,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:01:39.48,0:01:44.08,Captions,,50,0,0,,Kakao AdasıDialogue: 0,0:01:43.93,0:01:45.20,Narrator,,0,0,0,,Hasır Şapka tayfasının...Dialogue: 0,0:01:45.20,0:01:49.20,Narrator,,0,0,0,,...Kakao Adası'nda sözleştikleri vakte  32 dakika kalmıştır.Dialogue: 0,0:01:46.19,0:01:50.95,Captions,,40,0,0,,00:28Dialogue: 0,0:01:50.95,0:01:55.25,Main,,0,0,0,,Gelen giden yok. Savaşları daha neticelenmedi galiba.Dialogue: 0,0:01:51.19,0:01:55.26,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - dmc3 thx to onepace.netDialogue: 0,0:14:27.00,0:14:37.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - dmc3 thx to onepace.netDialogue: 0,0:28:52.32,0:28:56.32,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - dmc3 thx to onepace.netDialogue: 0,0:01:51.19,0:01:55.26,Title,,0,0,250,,Son İstekDialogue: 0,0:01:55.25,0:01:58.36,Main,,0,0,0,,Katakuri abimin kaybetme ihtimali var mıdır ki?Dialogue: 0,0:01:58.36,0:02:01.81,Main,,0,0,0,,Ne? Katakuri'nin kaybetme ihtimali mi?Dialogue: 0,0:02:01.81,0:02:04.01,Main,,0,0,0,,Newji! Sen...Dialogue: 0,0:02:04.01,0:02:05.98,Main,,0,0,0,,...ciddi misin?Dialogue: 0,0:02:06.61,0:02:09.15,Main,,0,0,0,,Öyle bir ihtimal hiçbir zaman olmadı!Dialogue: 0,0:02:09.15,0:02:10.31,Main,,0,0,0,,Ah!Dialogue: 0,0:02:10.31,0:02:16.22,Main,,0,0,0,,Ne demeye bana vuruyorsun ki? Newsan'ım ben! Ağzımı açmadım ki!Dialogue: 0,0:02:16.22,0:02:20.00,Main,,0,0,0,,Katakuri hayatı boyunca yenilgi yüzü görmemiştir!Dialogue: 0,0:02:20.42,0:02:22.83,Main,,0,0,0,,Aynen öyle dangalak!Dialogue: 0,0:02:22.83,0:02:26.63,Main,,0,0,0,,Katakuri abimiz bildiğin kusursuz bir adamdır!Dialogue: 0,0:02:26.63,0:02:30.05,Main,,0,0,0,,Anam! Newshi'yim ben ya!Dialogue: 0,0:02:30.05,0:02:32.72,Main,,0,0,0,,Kusura bakmayın Newsan, Newshi...Dialogue: 0,0:02:33.74,0:02:35.17,Main,,0,0,0,,Acıdı!Dialogue: 0,0:02:35.17,0:02:36.54,Main,,0,0,0,,Şimdi ödeştik!Dialogue: 0,0:02:36.54,0:02:37.95,Main,,0,0,0,,Ne dediniz?Dialogue: 0,0:02:37.95,0:02:39.54,Main,,0,0,0,,Salak! Geri zekâlı!Dialogue: 0,0:02:39.54,0:02:43.73,Main,,0,0,0,,Ama hâlâ bizimle iletişime geçmemiş olması da bir tuhaf.Dialogue: 0,0:02:43.73,0:02:46.75,Main,,0,0,0,,Hasır Şapka'nın yerinde olsam ben de böyle yapardım.Dialogue: 0,0:02:46.75,0:02:50.40,Main,,0,0,0,,Tayfasıyla burada saat 01.00'da buluşmak üzere sözleşmişler.Dialogue: 0,0:02:50.95,0:02:56.37,Main,,0,0,0,,Başka bir deyişle, o saate girene dek mürettebatı buraya adımını atmayacak.Dialogue: 0,0:02:56.37,0:03:01.71,Main,,0,0,0,,Öyleyse Ayna Dünyası'nın tek çıkış noktası Brûlée ablayı yakalayıp...Dialogue: 0,0:03:01.71,0:03:06.55,Main,,0,0,0,,...Ayna Dünyası'nda veya öbür adalarda vaktin gelip çatmasını beklerdim!Dialogue: 0,0:03:06.55,0:03:11.30,Main,,0,0,0,,Sahi ya!  Brûlée abla ortalıktan kaybolmuştu!Dialogue: 0,0:03:11.30,0:03:12.43,Main,,0,0,0,,Evet!Dialogue: 0,0:03:12.43,0:03:17.93,Main,,0,0,0,,Yani Katakuri ile olan savaşından kaçarak saat tam 01.00'da Hasır Şapka'nın...Dialogue: 0,0:03:17.93,0:03:21.87,Main,,0,0,0,,...bu aynadan çıkagelmesi kuvvetle muhtemeldir!Dialogue: 0,0:03:21.87,0:03:23.48,Main,,0,0,0,,Anlıyorum, doğru.Dialogue: 0,0:03:23.48,0:03:27.40,Main,,0,0,0,,Brûlée ablamız biraz kalın kafalı olduğundan hemencecik düşman eline düşüveriyor.Dialogue: 0,0:03:27.40,0:03:31.88,Main,,0,0,0,,Akimeg, ayna aracılığıyla dinliyor olabilir bak.Dialogue: 0,0:03:31.88,0:03:33.45,Main,,0,0,0,,Ağzımdan kaçıverdi.Dialogue: 0,0:03:33.45,0:03:37.17,Main,,0,0,0,,Son yarım saat. Gözümüzü dört açalım.Dialogue: 0,0:03:37.17,0:03:39.75,Main,,0,0,0,,Gel artık Hasır Şapka!Dialogue: 0,0:03:39.75,0:03:43.50,Main,,0,0,0,,Orağımla seni ikiye ayıracağım!Dialogue: 0,0:04:00.64,0:04:03.60,Thoughts,,0,0,0,,Hepsi de asker mi?Dialogue: 0,0:04:03.60,0:04:07.98,Thoughts,,0,0,0,,Kullanılabilir durumda bir ayna bırakmışlar gibi.Dialogue: 0,0:04:11.19,0:04:14.65,Thoughts,,0,0,0,,Luffy geldiği vakit bir solukta buradan kaçamazsak...Dialogue: 0,0:04:14.65,0:04:17.32,Thoughts,,0,0,0,,...ikimiz de nalları dikeriz.Dialogue: 0,0:04:19.62,0:04:24.08,Main,,0,0,0,,Luffy'nin gelmesiyle bizim de yollarımız ayrılıyor...Dialogue: 0,0:04:24.08,0:04:25.21,Main,,0,0,0,,Pudding-cha...Dialogue: 0,0:04:25.96,0:04:27.83,Main,,0,0,0,,Çok uzaktasın!Dialogue: 0,0:04:27.83,0:04:30.36,Main,,0,0,0,,Duyuyor musun bari Pudding-chan?Dialogue: 0,0:04:30.36,0:04:33.61,Main,,0,0,0,,B- B- B... Bana bakmasana!Dialogue: 0,0:04:33.61,0:04:35.97,Main,,0,0,0,,D- D- D... Dinliyoruz herhâlde!Dialogue: 0,0:04:35.97,0:04:37.20,Main,,0,0,0,,Sanji...Dialogue: 0,0:04:37.20,0:04:38.47,Main,,0,0,0,,-san!Dialogue: 0,0:04:41.89,0:04:45.18,Main,,0,0,0,,Şöyle bi' düşünüyorum da, epey tuhaf bir şekilde tanışmıştık.Dialogue: 0,0:04:51.27,0:04:56.53,Flashbacks,,0,0,0,,Karşında nişanlın, Charlotte Pudding-sama!Dialogue: 0,0:04:56.86,0:04:59.96,Flashbacks,,0,0,0,,Yarın evlenelim.Dialogue: 0,0:05:03.97,0:05:07.35,Main,,0,0,0,,Seninle vakit geçirmekten çok keyif alsam da...Dialogue: 0,0:05:07.35,0:05:10.27,Main,,0,0,0,,...yakında kendi yollarımıza gitmemiz gerekecek.Dialogue: 0,0:05:10.27,0:05:11.73,Main,,0,0,0,,Her şey için teşekkürler!Dialogue: 0,0:05:19.57,0:05:24.63,Thoughts,,0,0,0,,Seni kandırıp öldürmeye kalkmışken...Dialogue: 0,0:05:24.63,0:05:27.37,Thoughts,,0,0,0,,...teşekkür edemezsin Sanji-san!Dialogue: 0,0:05:27.37,0:05:30.66,Thoughts,,0,0,0,,Özür dilemek istiyorum!Dialogue: 0,0:05:30.66,0:05:34.04,Thoughts,,0,0,0,,Düzgünce özür dilemem gerek!Dialogue: 0,0:05:52.27,0:05:54.00,Main,,0,0,0,,Kes mavrayı!Dialogue: 0,0:05:57.48,0:06:01.61,Thoughts,,0,0,0,,Olamaz ya! Olamaz! Yine batırdım!Dialogue: 0,0:06:01.61,0:06:05.11,Main,,0,0,0,,Doğru diyorsun! Düşmanız biz!Dialogue: 0,0:06:05.65,0:06:09.43,Main,,0,0,0,,Senin gözünde düğünümüz bir tuzaktan ibaretti.Dialogue: 0,0:06:09.43,0:06:14.62,Main,,0,0,0,,Baştan sona her şey Big Mom Korsanları'nın tezgâhıydı.Dialogue: 0,0:06:17.42,0:06:18.42,Main,,0,0,0,,Yine de...Dialogue: 0,0:06:19.25,0:06:21.71,Main,,0,0,0,,...senin için işkence olmuştur belki ama...Dialogue: 0,0:06:24.54,0:06:28.64,Main,,0,0,0,,...nişanlım rolünü iyi ki sen oynamışsın.Dialogue: 0,0:06:41.07,0:06:43.07,Main,,0,0,0,,Yok, niyetim...Dialogue: 0,0:06:43.43,0:06:46.72,Main,,0,0,0,,Özür dilerim! Seni gücendirmek istememiştim!Dialogue: 0,0:06:46.72,0:06:49.13,Thoughts,,0,0,0,,Durun! Çıkmayın gözyaşları!Dialogue: 0,0:06:49.13,0:06:50.66,Thoughts,,0,0,0,,Durun diyorum!Dialogue: 0,0:06:50.66,0:06:52.47,Main,,0,0,0,,Ö- Özür dilerim!Dialogue: 0,0:06:52.47,0:06:54.92,Main,,0,0,0,,Niyetim bu değildi Pudding-chan!Dialogue: 0,0:06:56.29,0:06:58.44,Main,,0,0,0,,B- Baksana Sanji...Dialogue: 0,0:06:58.44,0:06:59.88,Main,,0,0,0,,-san...Dialogue: 0,0:07:02.00,0:07:03.88,Main,,0,0,0,,Bana bir iyilik yapar mısın?Dialogue: 0,0:07:05.34,0:07:09.22,Main,,0,0,0,,Son kez...Dialogue: 0,0:07:11.22,0:07:13.62,Main,,0,0,0,,...bir iyilik yapar mısın?Dialogue: 0,0:07:30.63,0:07:33.95,Captions,,40,0,0,,00:37Dialogue: 0,0:08:40.00,0:08:43.55,Captions,,0,0,0,,Whole Cake AdasıDialogue: 0,0:08:42.69,0:08:46.11,Main,,0,0,0,,Bu noktaya değin sağ kalmayı bildiler!Dialogue: 0,0:08:43.55,0:08:46.11,Captions,,0,0,0,,00:40Dialogue: 0,0:08:46.11,0:08:48.16,Main,,0,0,0,,Hasır Şapkalar!Dialogue: 0,0:08:48.16,0:08:52.22,Main,,0,0,0,,Topyekûn bir saldırıya hazırlanmış olmanıza rağmen elinizden kaçırırsanız...Dialogue: 0,0:08:52.22,0:08:54.70,Main,,0,0,0,,...manşetleri süsleyecektir!Dialogue: 0,0:08:54.70,0:08:58.59,Main,,0,0,0,,Boş yapma Morgans! Eline şok bir haber geçmeyecek!Dialogue: 0,0:08:58.59,0:09:01.31,Main,,0,0,0,,Ne pahasına olursa olsun bunun önüne geçmek için...Dialogue: 0,0:09:01.31,0:09:05.40,Main,,0,0,0,,...gururumuzu bir kenara atıp  Kakao Adası'na binlerce asker yolladık lan!Dialogue: 0,0:09:07.00,0:09:10.71,Main,,0,0,0,,Aynadan çıkıp gelen eski Korsanlar Kralı...Dialogue: 0,0:09:10.71,0:09:13.30,Main,,0,0,0,,...Gold Roger dahi olsa sağ kurtulamaz!Dialogue: 0,0:09:13.30,0:09:17.37,Main,,0,0,0,,Elimize geçirdik mi kellerini vurup yan yana dizeceğiz.Dialogue: 0,0:09:17.37,0:09:20.35,Main,,0,0,0,,O zaman yarınki baskında ilk sayfaya koyarsın!Dialogue: 0,0:09:20.85,0:09:22.49,Main,,0,0,0,,İbretlik olması için!Dialogue: 0,0:09:24.23,0:09:27.77,Main,,0,0,0,,Ziyadesiyle yakışıksızsın. O kadar iğrençleşmeye lüzum yok ki.Dialogue: 0,0:09:28.86,0:09:31.63,Main,,0,0,0,,Saçmalama! En olurunu söyledim daha!Dialogue: 0,0:09:32.40,0:09:34.80,Main,,0,0,0,,Yakında haberler kulağımıza gelir!Dialogue: 0,0:09:34.80,0:09:40.04,Main,,0,0,0,,Tek geminin koca bir filoyu atlatması mümkün değildir!Dialogue: 0,0:09:42.22,0:09:45.27,Captions,,25,0,0,,00:43Dialogue: 0,0:09:46.46,0:09:48.55,Main,,0,0,0,,Durun!Dialogue: 0,0:09:49.23,0:09:52.72,Captions,,35,0,0,,Denizde bir yerde - Bege'nin GemisiDialogue: 0,0:09:50.05,0:09:52.72,Main,,0,0,0,,Pastayı verin!Dialogue: 0,0:09:54.34,0:09:56.18,Main,,0,0,0,,Yelkenler alev aldı!Dialogue: 0,0:09:56.18,0:09:58.35,Main,,0,0,0,,Hemen söndürün yoksa batarız!Dialogue: 0,0:10:00.31,0:10:03.76,Main,,0,0,0,,Böyle devam edemeyiz-rero Baba! Sınırımıza dayandık-rero!Dialogue: 0,0:10:03.76,0:10:06.78,Main,,0,0,0,,Adaya varamadan tahtalı köyü boylayacağız-rero!Dialogue: 0,0:10:06.78,0:10:09.48,Main,,0,0,0,,Pastadan kurtulup tüyelim Baba!Dialogue: 0,0:10:10.02,0:10:12.11,Main,,0,0,0,,Buraya kadar gelmişken paniklemeyin!Dialogue: 0,0:10:12.11,0:10:13.36,Main,,0,0,0,,Rero?Dialogue: 0,0:10:14.56,0:10:18.83,Main,,0,0,0,,Farklı şehirlerde doğduk madem...Dialogue: 0,0:10:18.83,0:10:20.83,Main,,0,0,0,,...en azından...Dialogue: 0,0:10:20.83,0:10:23.58,Main,,0,0,0,,...birlikte ölelim!Dialogue: 0,0:10:23.60,0:10:26.42,Main,,0,0,0,,Baba!Dialogue: 0,0:10:27.71,0:10:28.96,Main,,0,0,0,,Adayı görüyorum!Dialogue: 0,0:10:32.76,0:10:34.26,Main,,0,0,0,,Kabarık Ada!Dialogue: 0,0:10:34.26,0:10:36.14,Main,,0,0,0,,Rero!Dialogue: 0,0:10:36.14,0:10:40.10,Main,,0,0,0,,Varmak üzereyiz! Adamlığınızı görelim bakalım!Dialogue: 0,0:10:40.10,0:10:44.52,Main,,0,0,0,,Tamamdır!Dialogue: 0,0:10:45.38,0:10:48.90,Captions,,30,0,0,,00:45Dialogue: 0,0:10:50.58,0:10:53.76,Main,,0,0,0,,Sözleştiğimiz gibi saat 01.00'a kıl payıyla yetişebiliriz!Dialogue: 0,0:10:55.05,0:10:59.27,Main,,0,0,0,,Fakat asıl endişem,  Ayna Dünyası'nın çıkış bileti Brûlée'dir.Dialogue: 0,0:10:59.27,0:11:04.15,Main,,0,0,0,,Bizimki kazansa bile Brûlée olmadan dünyamıza dönemez!Dialogue: 0,0:11:04.15,0:11:08.90,Main,,0,0,0,,Luffy böyle bir şeyi tafsilatıyla hesap edecek bir adam değildir.Dialogue: 0,0:11:08.90,0:11:10.94,Main,,0,0,0,,Değil mi ya! Aklı ona ermez!Dialogue: 0,0:11:10.94,0:11:13.36,Main,,0,0,0,,Hem de hiç! N'apacağız şimdi?Dialogue: 0,0:11:13.36,0:11:16.64,Main,,0,0,0,,Bir kere saatten haberi var mı ondan da emin değiliz ki.Dialogue: 0,0:11:16.64,0:11:18.10,Main,,0,0,0,,O derece mi?Dialogue: 0,0:11:18.61,0:11:20.72,Main,,0,0,0,,Her şey sarpa sarabilecek olsa da...Dialogue: 0,0:11:21.83,0:11:23.95,Main,,0,0,0,,...sana inancımız tam Luffy!Dialogue: 0,0:11:27.74,0:11:30.01,Captions,,0,240,0,,00:47Dialogue: 0,0:11:54.47,0:11:57.57,Main,,0,0,0,,Düşerken bile ileri doğru devriliyor.Dialogue: 0,0:12:12.65,0:12:14.69,Flashbacks,,0,0,0,,İyi dinle Luffy!Dialogue: 0,0:12:14.98,0:12:17.90,Flashbacks,,0,0,0,,En erken 10 saate oradayız!Dialogue: 0,0:12:17.90,0:12:19.49,Flashbacks,,0,0,0,,Saat 01.00 gibi!Dialogue: 0,0:12:19.50,0:12:22.89,Flashbacks,,0,0,0,,O herifin canına okuduğun gibi...Dialogue: 0,0:12:22.89,0:12:25.93,Flashbacks,,0,0,0,,...Kakao Adası'na çıkan bir ayna aramaya koyul!Dialogue: 0,0:12:25.93,0:12:27.98,Flashbacks,,0,0,0,,Orada buluşuruz!Dialogue: 0,0:12:31.50,0:12:34.33,Main,,0,0,0,,Şu an saat kaç ki?Dialogue: 0,0:13:01.99,0:13:04.16,Main,,0,0,0,,Günün birinde...Dialogue: 0,0:13:06.74,0:13:09.41,Main,,0,0,0,,...Big Mom'ı devirmek için tekrar gelecek misin?Dialogue: 0,0:13:13.83,0:13:15.92,Main,,0,0,0,,Herhâlde! Ne de olsa ben...Dialogue: 0,0:13:15.92,0:13:18.68,Main,,0,0,0,,...Korsanlar Kralı olacak adamım!Dialogue: 0,0:13:31.64,0:13:34.43,Main,,0,0,0,,Oldukça ilerisini görebiliyorsun!Dialogue: 0,0:14:34.12,0:14:37.14,Main,,0,0,0,,Dal... Gidelim...Dialogue: 0,0:14:37.42,0:14:39.29,Main,,0,0,0,,Ha? Dal?Dialogue: 0,0:14:39.96,0:14:42.17,Main,,0,0,0,,Kaçmış!Dialogue: 0,0:14:42.17,0:14:45.55,Main,,0,0,0,,Eyvah!  Dal olmadan buradan çıkamam ki.Dialogue: 0,0:14:45.55,0:14:47.22,Main,,0,0,0,,N- N'apacağım şimdi?Dialogue: 0,0:14:49.31,0:14:51.01,Main,,0,0,0,,Vaktim de kalmadı.Dialogue: 0,0:14:51.01,0:14:53.77,Main,,0,0,0,,Abi!Dialogue: 0,0:14:54.73,0:14:58.73,Main,,0,0,0,,Katakuri abi!Dialogue: 0,0:14:59.86,0:15:01.03,Main,,0,0,0,,Dal!Dialogue: 0,0:15:01.03,0:15:03.71,Main,,0,0,0,,Adım Brûlée be, Hasır Şapka!Dialogue: 0,0:15:03.71,0:15:07.24,Main,,0,0,0,,Nasıl bir bel altı numaraya başvurdun da abimi yenebildin?Dialogue: 0,0:15:07.24,0:15:09.86,Main,,0,0,0,,Katakuri'yi yendin demek!Dialogue: 0,0:15:09.86,0:15:11.99,Main,,0,0,0,,Gözlerime inanamıyorum! Grr!Dialogue: 0,0:15:12.00,0:15:13.33,Main,,0,0,0,,Sen...Dialogue: 0,0:15:16.50,0:15:19.30,Main,,0,0,1,,Adım Nazoms'tur!Dialogue: 0,0:15:16.50,0:15:18.73,Note,,0,0,0,,Nazo: GizemliDialogue: 0,0:15:18.99,0:15:20.92,Captions,,0,0,0,,Gizemli Kurtarıcı - NazomsDialogue: 0,0:15:20.92,0:15:25.64,Main,,0,0,0,,Buradan çıkabilesin diye Brûlée'yi yakalayıp savaşının neticelenmesini bekliyordum!Dialogue: 0,0:15:25.64,0:15:27.41,Main,,0,0,0,,Bir şeyin yoktu yani...Dialogue: 0,0:15:28.18,0:15:29.51,Captions,,0,0,0,,Gizemli Kurtarıcı - NazomsDialogue: 0,0:15:28.18,0:15:29.61,Main,,0,0,0,,Pekoms!Dialogue: 0,0:15:29.51,0:15:32.31,Pekoms - Infobox,,100,0,25,,PekomsDialogue: 0,0:15:32.31,0:15:36.83,Main,,0,0,0,,Evet! Pedro abinin uğrunda kendini feda ettiği canlarınızı...Dialogue: 0,0:15:36.83,0:15:40.68,Main,,0,0,0,,...şimdi yitirmenize izin veremem!Dialogue: 0,0:15:41.44,0:15:45.95,Main,,0,0,0,,Haydi Hasır Şapka!  Kakao Adası'na, yoldaşlarının yanına gidelim!Dialogue: 0,0:15:45.95,0:15:46.92,Main,,0,0,0,,Tamam!Dialogue: 0,0:15:46.92,0:15:48.88,Main,,0,0,0,,Bırak beni!Dialogue: 0,0:15:48.88,0:15:51.03,Captions,,30,0,0,,00:50Dialogue: 0,0:15:51.03,0:15:54.08,Main,,0,0,0,,Kakao Adası görüldü!Dialogue: 0,0:15:58.17,0:15:59.71,Main,,0,0,0,,Kaç gemi yığmışlar ya?Dialogue: 0,0:16:01.17,0:16:03.41,Main,,0,0,0,,Devasa bir filo!Dialogue: 0,0:16:04.09,0:16:06.72,Main,,0,0,0,,Sanji-kun! Orada durum nedir?Dialogue: 0,0:16:07.59,0:16:09.52,Main,,0,0,0,,Luffy daha gelmedi.Dialogue: 0,0:16:09.52,0:16:11.71,Main,,0,0,0,,Kıyıdaki filoya yaklaşmayın!Dialogue: 0,0:16:13.60,0:16:16.93,Main,,0,0,0,,Luffy'yi gemiye getirmenin hâl çaresine bakacağım!Dialogue: 0,0:16:19.58,0:16:22.27,Captions,,35,0,0,,00:55Dialogue: 0,0:16:22.27,0:16:25.73,Main,,0,0,0,,Millet, silahlarınız hazır mı?Dialogue: 0,0:16:25.73,0:16:29.37,Main,,0,0,0,,Evet!Dialogue: 0,0:16:29.37,0:16:32.57,Main,,0,0,0,,Çıkacaksa da şu beş dakika içerisinde olacak!Dialogue: 0,0:16:35.40,0:16:37.36,Main,,0,0,0,,Gel haydi...Dialogue: 0,0:16:37.36,0:16:40.37,Main,,0,0,0,,Hasır Şapka Luffy!Dialogue: 0,0:16:43.25,0:16:44.95,Main,,0,0,0,,Dört dakika kaldı.Dialogue: 0,0:16:53.43,0:16:54.50,Main,,0,0,0,,Bu gemi...Dialogue: 0,0:17:00.89,0:17:02.52,Main,,0,0,0,,Adım gibi eminim!Dialogue: 0,0:17:08.38,0:17:11.24,Main,,0,0,0,,Hasır Şapkalar'ın gemisi!Dialogue: 0,0:17:14.82,0:17:16.93,Main,,0,0,0,,Fark edildik galiba!Dialogue: 0,0:17:16.93,0:17:19.81,Main,,0,0,0,,Bu büyüklükte bir filoyu nasıl toplayabilmişler ki?Dialogue: 0,0:17:19.81,0:17:23.97,Main,,0,0,0,,Hasır Şapkalar'ın gemisini batırın!Dialogue: 0,0:17:25.72,0:17:27.14,Main,,0,0,0,,Geliyorlar!Dialogue: 0,0:17:27.14,0:17:30.41,Main,,0,0,0,,Olamaz ya! Öleceğiz!Dialogue: 0,0:17:30.41,0:17:33.25,Main,,0,0,0,,Luffy, çabuk ol!Dialogue: 0,0:17:33.25,0:17:35.06,Main,,0,0,0,,Adayla aramızdaki mesafeyi koru!Dialogue: 0,0:17:35.08,0:17:36.69,Main,,0,0,0,,Tamamdır!Dialogue: 0,0:17:41.69,0:17:44.78,Main,,0,0,0,,Ne yapıyoruz Smoothie?Dialogue: 0,0:17:44.78,0:17:50.49,Main,,0,0,0,,Pupadan destek vermeyi sürdüreceğiz! Kaçacak yerleri kalmadı.Dialogue: 0,0:17:50.49,0:17:55.91,Main,,0,0,0,,Önlerinde Snack'ın önderliğindeki Büyük Totto Land Filosu varken...Dialogue: 0,0:17:50.49,0:17:59.34,Map,,0,800,360,,Aynalı BölgeDialogue: 0,0:17:50.49,0:17:59.34,Map,,650,0,420,,SunnyDialogue: 0,0:17:50.49,0:17:59.34,Map,,610,0,170,,Smoothie'nin FilosuDialogue: 0,0:17:55.91,0:17:58.50,Main,,0,0,0,,...arkalarında da bizim filomuz bekliyor.Dialogue: 0,0:17:59.34,0:18:02.40,Main,,0,0,0,,Şayet Kakao Adası'na demir atmayı başarsalar dahi...Dialogue: 0,0:18:03.17,0:18:06.33,Main,,0,0,0,,...Oven abilerin ordusu pusuya yatmış durumda.Dialogue: 0,0:18:07.47,0:18:10.23,Main,,0,0,0,,Kapana kısılmış farelerden farksızlar.Dialogue: 0,0:18:11.31,0:18:13.85,Main,,0,0,0,,Yolun sonuna geldiler!Dialogue: 0,0:18:15.65,0:18:18.98,Captions,,0,0,0,,Whole Cake AdasıDialogue: 0,0:18:16.01,0:18:18.98,Main,,0,0,0,,Tüm Den Den Mushi'ler hatta kalsın!Dialogue: 0,0:18:18.98,0:18:22.94,Main,,0,0,0,,Adanın her kesiminden bilgi almamız gerekiyor.Dialogue: 0,0:18:22.94,0:18:25.23,Main,,0,0,0,,Anlaşılmıştır Mont d'Or-sama.Dialogue: 0,0:18:24.33,0:18:27.11,Captions,,980,0,320,,Kakao AdasıDialogue: 0,0:18:27.95,0:18:30.33,Main,,0,0,0,,Son duanı et, boklu velet!Dialogue: 0,0:18:30.33,0:18:34.62,Main,,0,0,0,,İstediğin zaman çıkabilirsin, Hasır Şapka!Dialogue: 0,0:18:42.79,0:18:44.09,Main,,0,0,0,,Lütfen!Dialogue: 0,0:18:44.09,0:18:46.30,Main,,0,0,0,,Elini çabuk tut Luffy!Dialogue: 0,0:18:51.76,0:18:56.98,Main,,0,0,0,,Yardım edin!!Dialogue: 0,0:18:56.98,0:18:59.02,Main,,0,0,0,,Sulong mu?Dialogue: 0,0:18:59.02,0:19:00.56,Main,,0,0,0,,Evet! Grr!Dialogue: 0,0:19:00.56,0:19:06.11,Main,,0,0,0,,Biz Minkler, dolunaya bakarak ilkel formumuza dönüşebiliyoruz.Dialogue: 0,0:19:06.11,0:19:10.64,Main,,0,0,0,,Ama oldum olası kontrol etmeyi beceremediğimden...Dialogue: 0,0:19:10.64,0:19:15.16,Main,,0,0,0,,...Sulong'a dönüşünce vahşi bir canavardan ibaret oluyorum.Dialogue: 0,0:19:15.16,0:19:16.54,Main,,0,0,0,,Canavar mı?Dialogue: 0,0:19:16.54,0:19:20.88,Main,,0,0,0,,Gözüm dönüyor, karşıma çıkan her şeyi yıkıp geçiyorum!Dialogue: 0,0:19:20.88,0:19:24.50,Main,,0,0,0,,Kimsenin sesini işitemezken...Dialogue: 0,0:19:25.96,0:19:28.63,Main,,0,0,0,,...bir istisna vardı!Dialogue: 0,0:19:28.63,0:19:30.93,Main,,0,0,0,,O istisna da Pedro abim idi!Dialogue: 0,0:19:47.03,0:19:49.15,Flashbacks,,0,0,0,,Dur Pekoms!Dialogue: 0,0:19:49.15,0:19:56.51,Main,,0,0,0,,Kontrolümü yitirdiğimde nedense bir tek onun sesiyle birlikte sakinleşebiliyordum.Dialogue: 0,0:20:01.58,0:20:02.45,Main,,0,0,0,,Pedro...Dialogue: 0,0:20:04.41,0:20:10.17,Main,,0,0,0,,Yani yeryüzünde vahşi doğamı bastırabilecek bir insan evladı kalmadı!Dialogue: 0,0:20:12.50,0:20:16.09,Main,,0,0,0,,İyi dinle Hasır Şapka. Bu gece dolunay var!Dialogue: 0,0:20:20.09,0:20:23.72,Main,,0,0,0,,Aynadan geçip Kakao Adası'na çıktığımda...Dialogue: 0,0:20:23.72,0:20:26.93,Main,,0,0,0,,...Sulong formuma gireceğim!Dialogue: 0,0:20:27.56,0:20:33.65,Main,,0,0,0,,Kontrolü yitirdiğimde bunu fırsat bilip Kakao Adası'ndan kaç!Dialogue: 0,0:20:33.65,0:20:36.44,Main,,0,0,0,,Budala! Boşa uğraşıyorsun Pekoms!Dialogue: 0,0:20:36.65,0:20:38.45,Main,,0,0,0,,Pis hain!Dialogue: 0,0:20:38.45,0:20:42.22,Main,,0,0,0,,Yeni bir savaş başlatmaya yetecek çapta insan gücü Kakao Adası'nda toplandı.Dialogue: 0,0:20:42.22,0:20:46.66,Main,,0,0,0,,Sulong formunu sakız niyetine çiğner atarlar!Dialogue: 0,0:20:49.12,0:20:50.21,Main,,0,0,0,,Düşüyorum!Dialogue: 0,0:20:51.00,0:20:53.30,Main,,0,0,0,,Kes sesini, Brûlée!Dialogue: 0,0:20:53.67,0:20:55.92,Main,,0,0,0,,Varmak üzereyiz Hasır Şapka!Dialogue: 0,0:20:56.63,0:20:59.47,Main,,0,0,0,,Pedro abimin fedakârlığının...Dialogue: 0,0:20:59.47,0:21:02.93,Main,,0,0,0,,...ne olursa olsun boşa gitmesine izin verme! Grr!Dialogue: 0,0:21:06.89,0:21:07.98,Main,,0,0,0,,Tamam!Dialogue: 0,0:21:09.44,0:21:11.20,Main,,0,0,0,,Teşekkürler!Dialogue: 0,0:21:11.20,0:21:14.24,Main,,0,0,0,,Haydi, bir halta yara!Dialogue: 0,0:21:14.24,0:21:15.11,Main,,0,0,0,,Ne?Dialogue: 0,0:21:15.11,0:21:19.61,Main,,0,0,0,,Gidiyoruz!Dialogue: 0,0:21:25.56,0:21:27.98,Main,,0,0,0,,Ses aynadan geldi!Dialogue: 0,0:21:27.98,0:21:31.73,Main,,0,0,0,,Yardım edin!!Dialogue: 0,0:21:32.21,0:21:34.38,Main,,0,0,0,,Brûlée ablanın sesi değil miydi?Dialogue: 0,0:21:34.38,0:21:37.63,Main,,0,0,0,,Düşündüğümüz gibi, Hasır Şapka'nın eline düşmüş.Dialogue: 0,0:21:37.63,0:21:39.30,Main,,0,0,0,,Ciğersiz herif!Dialogue: 0,0:21:46.22,0:21:48.88,Main,,0,0,0,,Geliyor! Nişan alıp ateş edin!Dialogue: 0,0:22:04.41,0:22:05.62,Main,,0,0,0,,Ne?Dialogue: 0,0:22:05.62,0:22:07.36,Main,,0,0,0,,Bu...Dialogue: 0,0:22:07.36,0:22:09.70,Main,,0,0,0,,Pekoms!Dialogue: 0,0:22:09.70,0:22:11.00,Main,,0,0,0,,Ne?Dialogue: 0,0:22:12.96,0:22:14.12,Main,,0,0,0,,Benim adım Nazoms!Dialogue: 0,0:22:14.12,0:22:16.75,Main,,0,0,0,,Pekoms! Aynanın içinde ne işin vardı?Dialogue: 0,0:22:16.75,0:22:17.36,Main,,0,0,0,,Ne?Dialogue: 0,0:22:20.71,0:22:24.61,Main,,0,0,0,,K- Kıpırdamayın lan Big Mom Korsanları!Dialogue: 0,0:22:24.61,0:22:27.03,Main,,0,0,0,,A- Aptalca bir işe kalkışırsanız...Dialogue: 0,0:22:27.03,0:22:33.52,Main,,0,0,0,,...bir tanecik kardeşiniz Brûlée'nin beynini kevgire çeviririm! Grr!Dialogue: 0,0:22:33.52,0:22:34.37,Main,,0,0,0,,Brûlée!Dialogue: 0,0:22:34.37,0:22:35.32,Main,,0,0,0,,Brûlée abla!Dialogue: 0,0:22:35.32,0:22:37.56,Main,,0,0,0,,N'olur yapma Pekoms!Dialogue: 0,0:22:37.56,0:22:39.94,Main,,0,0,0,,Pekoms, aklını mı kaçırdın?Dialogue: 0,0:22:39.94,0:22:41.94,Main,,0,0,0,,Önce oturup bi' konuşalım!Dialogue: 0,0:22:41.94,0:22:43.90,Main,,0,0,0,,Brûlée ablayı bırak!!Dialogue: 0,0:22:43.90,0:22:49.48,Main,,0,0,0,,Yardım edin millet!Dialogue: 0,0:22:49.49,0:22:53.66,Thoughts,,0,0,0,,Sulong'a dönüşünce zaten ifşa olacaktım.Dialogue: 0,0:22:56.79,0:22:58.50,Thoughts,,0,0,0,,Artık bir önemi yok!Dialogue: 0,0:23:08.04,0:23:11.93,Thoughts,,0,0,0,,Hasır Şapka'yı yaşatacağım!Dialogue: 0,0:23:11.94,0:23:16.34,Thoughts,,0,0,0,,Pedro abimin uğruna hayatından vazgeçtiği adamı!Dialogue: 0,0:23:28.00,0:23:29.46,Main,,0,0,0,,Olamaz!Dialogue: 0,0:23:31.62,0:23:33.83,Main,,0,0,0,,Sulong'a dönüşüyor!Dialogue: 0,0:23:33.83,0:23:35.61,Main,,0,0,0,,Yapma Pekoms!Dialogue: 0,0:23:35.61,0:23:37.71,Main,,0,0,0,,Kontrolünü yitireceksin!Dialogue: 0,0:23:39.21,0:23:41.95,Main,,0,0,0,,Olamaz!!Dialogue: 0,0:23:43.13,0:23:44.59,Main,,0,0,0,,Dizginleyin şunu!Dialogue: 0,0:23:44.59,0:23:46.72,Main,,0,0,0,,Artık çok geç.Dialogue: 0,0:23:46.72,0:23:48.89,Main,,0,0,0,,Son duanızı edin!Dialogue: 0,0:23:49.85,0:23:51.60,Main,,0,0,0,,Lan!Dialogue: 0,0:23:51.60,0:23:52.94,Main,,0,0,0,,Adi herif!Dialogue: 0,0:23:53.76,0:23:57.04,Main,,0,0,0,,Ulan, bu da ne demek oluyor?Dialogue: 0,0:23:57.04,0:24:02.27,Main,,0,0,0,,Aynadan ne Katakuri ne de Hasır Şapka çıktı!Dialogue: 0,0:24:02.27,0:24:05.36,Main,,0,0,0,,Yoktan yere biricik kız kardeşime...Dialogue: 0,0:24:05.36,0:24:07.70,Main,,0,0,0,,...ne cüretle silah çekersin?Dialogue: 0,0:24:12.16,0:24:12.68,Main,,0,0,0,,Elim!Dialogue: 0,0:24:12.68,0:24:14.58,Main,,0,0,0,,Abi!Dialogue: 0,0:24:16.58,0:24:17.75,Main,,0,0,0,,Heat...Dialogue: 0,0:24:16.58,0:24:17.75,Attack,,0,0,0,,Sıcak...Dialogue: 0,0:24:20.25,0:24:21.88,Main,,0,0,0,,Denasshi!Dialogue: 0,0:24:20.25,0:24:21.88,Attack,,0,0,0,,Rüzgar YumruğuDialogue: 0,0:24:21.88,0:24:24.17,Main,,0,0,0,,Yandım!Dialogue: 0,0:24:24.17,0:24:25.97,Main,,0,0,0,,Olamaz!Dialogue: 0,0:24:25.97,0:24:27.59,Main,,0,0,0,,Hakladı!Dialogue: 0,0:24:34.51,0:24:35.85,Main,,0,0,0,,Hasır Şapka!Dialogue: 0,0:24:42.27,0:24:43.42,Thoughts,,0,0,0,,Luffy!Dialogue: 0,0:24:53.03,0:24:54.08,Main,,0,0,0,,Benim, Sanji!Dialogue: 0,0:24:54.08,0:24:55.21,Main,,0,0,0,,Sanji!Dialogue: 0,0:24:55.21,0:24:56.23,Main,,0,0,0,,Luffy...Dialogue: 0,0:24:57.12,0:24:58.30,Main,,0,0,0,,...geldi!Dialogue: 0,0:24:59.75,0:25:01.88,Main,,0,0,0,,İşte bu!Dialogue: 0,0:25:06.72,0:25:08.01,Main,,0,0,0,,Hasır Şapka!Dialogue: 0,0:25:08.01,0:25:10.05,Main,,0,0,0,,Pekoms adamı saklıyormuş!Dialogue: 0,0:25:10.05,0:25:12.05,Main,,0,0,0,,Yakalayın!Dialogue: 0,0:25:12.05,0:25:15.70,Main,,0,0,0,,Katakuri abimi hinlikle atlatıp çıkageldi demek.Dialogue: 0,0:25:15.70,0:25:17.68,Main,,0,0,0,,Hakkını teslim etmek gerek!Dialogue: 0,0:25:17.68,0:25:20.42,Main,,0,0,0,,İlk ben saldırıyorum!Dialogue: 0,0:25:20.42,0:25:21.98,Main,,0,0,0,,Oley!Dialogue: 0,0:25:23.97,0:25:24.94,Main,,0,0,0,,Yukarı bakın!Dialogue: 0,0:25:27.28,0:25:29.74,Main,,0,0,0,,Sıçramakla hata yaptın.Dialogue: 0,0:25:29.74,0:25:32.49,Main,,0,0,0,,Şimdi açık hedefsin!Dialogue: 0,0:25:34.83,0:25:37.45,Main,,0,0,0,,Teslim ol derim!Dialogue: 0,0:25:42.30,0:25:43.92,Main,,0,0,0,,Raisin abi!Dialogue: 0,0:25:44.50,0:25:46.29,Main,,0,0,0,,O herif de kim?Dialogue: 0,0:25:47.00,0:25:48.09,Main,,0,0,0,,Sanji!Dialogue: 0,0:25:48.92,0:25:50.17,Main,,0,0,0,,Kazandın mı bari?Dialogue: 0,0:25:50.17,0:25:51.40,Main,,0,0,0,,Evet!Dialogue: 0,0:25:54.97,0:25:56.27,Main,,0,0,0,,Aksini düşünmemiştim zaten.Dialogue: 0,0:25:57.18,0:25:58.89,Main,,0,0,0,,Gökyüzünden kaçmaya çalışıyorlar!Dialogue: 0,0:25:58.89,0:26:01.06,Main,,0,0,0,,Kara Bacak bu!Dialogue: 0,0:26:01.06,0:26:02.20,Main,,0,0,0,,Ahmaklık.Dialogue: 0,0:26:02.20,0:26:04.10,Main,,0,0,0,,Bunu da düşündük.Dialogue: 0,0:26:04.10,0:26:07.32,Main,,0,0,0,,Biz de Geppo kullanabiliyoruz!Dialogue: 0,0:26:04.10,0:26:07.32,Note,,0,0,0,,Geppo: Sema YürüyüşüDialogue: 0,0:26:07.32,0:26:08.53,Main,,0,0,0,,Bir!Dialogue: 0,0:26:08.53,0:26:09.61,Main,,0,0,0,,İki!Dialogue: 0,0:26:09.61,0:26:10.78,Main,,0,0,0,,Üç!Dialogue: 0,0:26:10.78,0:26:11.95,Main,,0,0,0,,Dört!Dialogue: 0,0:26:11.95,0:26:13.24,Main,,0,0,0,,Beş!Dialogue: 0,0:26:19.24,0:26:22.56,Main,,0,0,0,,Bir daha dolunay yüzü görmemesini sağlayın!Dialogue: 0,0:26:50.12,0:26:53.42,Main,,0,0,0,,Pekoms!!Dialogue: 0,0:26:53.42,0:26:55.00,Main,,0,0,0,,Savaşta önüne bakmamak...Dialogue: 0,0:26:55.80,0:26:59.66,Main,,0,0,0,,...büyük saygısızlıktır-yu!Dialogue: 0,0:27:05.42,0:27:10.39,Main,,0,0,0,,Bu denli azınlıktayken...Dialogue: 0,0:27:10.39,0:27:13.26,Main,,0,0,0,,...ne kadar çırpınsanız da nafile.Dialogue: 0,0:27:15.77,0:27:16.91,Main,,0,0,0,,Kahretsin!Dialogue: 0,0:27:20.13,0:27:20.74,Main,,0,0,0,,Ne?Dialogue: 0,0:27:21.87,0:27:24.50,Main,,0,0,0,,Limanda patlama oldu!Dialogue: 0,0:27:26.34,0:27:28.80,Main,,0,0,0,,Bu da neyin nesi?Dialogue: 0,0:27:28.80,0:27:31.47,Main,,0,0,0,,Lan, ne oldu-nie?!Dialogue: 0,0:27:31.48,0:27:35.01,Main,,0,0,0,,Kıyıdaki gemiler yanıyor!Dialogue: 0,0:27:35.01,0:27:36.56,Main,,0,0,0,,Neler oluyor?Dialogue: 0,0:27:36.56,0:27:37.74,Main,,0,0,0,,Bombalı saldırı mı?Dialogue: 0,0:27:37.74,0:27:40.47,Main,,0,0,0,,Filo saldırısı Snack-sama!Dialogue: 0,0:27:40.47,0:27:42.01,Main,,0,0,0,,Hangi filo?Dialogue: 0,0:27:42.01,0:27:43.19,Main,,0,0,0,,E- Efendim...Dialogue: 0,0:27:43.19,0:27:45.24,Main,,0,0,0,,Germa filosu!Dialogue: 0,0:27:46.41,0:27:48.44,Main,,0,0,0,,Burada ne arıyorlar ki?Dialogue: 0,0:27:48.44,0:27:51.52,Main,,0,0,0,,Birkaç saat evvel tamamen ortadan kaldırıldılar diye biliyordum!Dialogue: 0,0:27:51.52,0:27:54.50,Main,,0,0,0,,Bir sonraki bombardımana hazırlanın!Dialogue: 0,0:27:54.50,0:27:56.72,Main,,0,0,0,,Germa 66!Dialogue: 0,0:27:56.72,0:27:59.66,Main,,0,0,0,,Burada ne işleri var?Dialogue: 0,0:28:06.28,0:28:08.01,Main,,0,0,0,,Hay böyle işin!Dialogue: 0,0:28:20.36,0:28:22.44,Main,,0,0,0,,Kahrolasıcalar!Dialogue: 0,0:28:22.44,0:28:26.29,Main,,0,0,0,,Çay Partisi'nde bize karşı pek misafirperverdiniz...Dialogue: 0,0:28:26.29,0:28:27.99,Main,,0,0,0,,...Big Mom Korsanları!Dialogue: 0,0:28:27.99,0:28:30.79,Main,,0,0,0,,Germa 66!Dialogue: 0,0:28:31.49,0:28:33.66,Main,,0,0,0,,Burada ne arıyorsunuz siz?Dialogue: 0,0:28:33.66,0:28:36.25,Main,,0,0,0,,Şu tesadüfe bak Sanji.Dialogue: 0,0:28:42.98,0:28:46.19,Main,,0,0,0,,Biz de bu dangalaklara...Dialogue: 0,0:28:46.19,0:28:49.17,Main,,0,0,0,,...unutamayacakları bir ders vermek istemiştik!Dialogue: 0,0:28:52.32,0:28:56.32,Credits,,0,0,0,,Editing:  Feeso, Galaxy 9000  Timing: Galaxy 9000  Quality Assurance: Feeso, Galaxy 9000, Grug, Pepperjack  Soundtracking:  Halee  Graphics:  Datenshi  Karaoke: KaitouYahiko  Translation: Crunchyroll  Pekoms Injury Fix: KaitouYahiko