.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.7,0.7,9,10,10,10,1Style: Attack,Duality,30.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.0,1.0,7,12,12,12,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:01:34.24,0:01:37.99,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - dmc3 thx to onepace.netDialogue: 0,0:14:44.40,0:14:54.40,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - dmc3 thx to onepace.netDialogue: 0,0:29:27.36,0:29:32.26,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - dmc3 thx to onepace.netDialogue: 0,0:01:34.24,0:01:37.99,Title,,0,0,0,,Mükemmel OyuncuDialogue: 0,0:01:39.07,0:01:42.33,Captions,,0,0,0,,Whole Cake Şatosu,  Çatı KatıDialogue: 0,0:01:44.16,0:01:47.46,Main,,0,0,0,,Süper abi ya...Dialogue: 0,0:01:47.46,0:01:49.37,Main,,0,0,0,,Vito, ne yapıyorsun?Dialogue: 0,0:01:49.37,0:01:51.14,Main,,0,0,0,,Baba, muhteşem ya!Dialogue: 0,0:01:51.14,0:01:55.67,Main,,0,0,0,,DEG'in başkanı ile Germa lideri konuşuyor-rero!Dialogue: 0,0:01:51.14,0:01:55.67,Note,,0,0,0,,DEG: Dünya Ekonomi GazetesiDialogue: 0,0:01:55.67,0:02:00.05,Main,,0,0,0,,Herhâlde konuşacaklar! İkisinin de kulaklarıyla ağzı var!Dialogue: 0,0:02:00.05,0:02:04.68,Main,,0,0,0,,Ama ne manyak bir parti ya-rero!Dialogue: 0,0:02:04.68,0:02:08.19,Main,,0,0,0,,En büyük oğul  Şeker Bakanı Perospero.Dialogue: 0,0:02:08.19,0:02:11.65,Main,,0,0,0,,En büyük kız, Meyve Bakanı Compote.Dialogue: 0,0:02:12.21,0:02:15.07,Main,,0,0,0,,İkinci oğul, Şekerleme Generali Katakuri.Dialogue: 0,0:02:15.07,0:02:18.53,Main,,0,0,0,,14. kız Şekerleme Generali Smoothie.Dialogue: 0,0:02:18.53,0:02:21.95,Main,,0,0,0,,Üçüncü oğul Daifuku ile dördüncü oğul Oven.Dialogue: 0,0:02:21.95,0:02:25.87,Main,,0,0,0,,Her yerde canavarlar kol geziyor!Dialogue: 0,0:02:25.87,0:02:29.92,Main,,0,0,0,,Onlarla aynı tarafta olmak insana güven aşılasa da...Dialogue: 0,0:02:32.35,0:02:36.68,Main,,0,0,0,,...her birini düşman edinecek olma düşüncesi tüylerimi diken diken ediyor-rero.Dialogue: 0,0:02:36.68,0:02:38.09,Thoughts,,0,0,0,,Ne? Düşman mı?Dialogue: 0,0:02:38.09,0:02:41.28,Main,,0,0,0,,Çene çalacak vaktin varsa git aşağı katı kontrol et.Dialogue: 0,0:02:41.28,0:02:44.22,Main,,0,0,0,,Tamam Baba. Gidelim Gotti.Dialogue: 0,0:02:44.22,0:02:47.47,Main,,0,0,0,,Düğün pastasının pek şatafatlı olacağını duydum.Dialogue: 0,0:03:08.12,0:03:08.96,Main,,0,0,0,,Mama.Dialogue: 0,0:03:10.94,0:03:13.46,Main,,0,0,0,,Karşınızda Anne Carmel.Dialogue: 0,0:03:15.32,0:03:19.30,Main,,0,0,0,,Evet! Biricik...Dialogue: 0,0:03:19.30,0:03:21.02,Main,,0,0,0,,...Anne'miz!Dialogue: 0,0:03:21.02,0:03:26.19,Main,,0,0,0,,Anne'nin her zamanki gibi içten gülümsediğini görmek çok güzel.Dialogue: 0,0:03:26.19,0:03:27.89,Main,,0,0,0,,Tıpkı güneş gibi!Dialogue: 0,0:03:31.63,0:03:36.07,Main,,0,0,0,,Kesinlikle. Anne'miz dünyamızın ışığıdır!Dialogue: 0,0:03:37.56,0:03:39.90,Thoughts,,0,0,0,,Kimin nesi olduğunu bilmesem de...Dialogue: 0,0:03:39.90,0:03:43.54,Main,,0,0,0,,İlk kez Çay Partisi'ne katılıyorum, resimdeki hanımefendi ile...Dialogue: 0,0:03:43.54,0:03:48.37,Main,,0,0,0,,...nasıl bir bağın var Big Mom?Dialogue: 0,0:03:49.37,0:03:51.96,Main,,0,0,0,,Hatıralarıma...Dialogue: 0,0:03:51.96,0:03:54.67,Main,,0,0,0,,...burnunu sokayım deme!Dialogue: 0,0:04:00.34,0:04:03.34,Main,,0,0,0,,Şerefe!Dialogue: 0,0:04:05.81,0:04:07.57,Main,,0,0,0,,Aşağı katta durum nedir?Dialogue: 0,0:04:07.57,0:04:12.35,Main,,0,0,0,,Çay Partisi hazırlığını tamamlayan aşçılar ziyafet çekiyor.Dialogue: 0,0:04:12.35,0:04:16.02,Main,,0,0,0,,Biz de bu sırada tüm koridorları tuttuk.Dialogue: 0,0:04:16.02,0:04:20.27,Main,,0,0,0,,Güzel. Koridorların kapatılmasıyla bir müddet kimse oradan geçemez.Dialogue: 0,0:04:20.28,0:04:26.95,Main,,0,0,0,,Şimdi de radyo sinyallerini engelleyecek Boynuzlu Den Den Mushiler'i yerleştirip bölgeyi izole edeceğiz.Dialogue: 0,0:04:26.95,0:04:30.62,Main,,0,0,0,,- Malum işi de ayarlamayı unutmayın.  - Tabii efendim!Dialogue: 0,0:04:33.41,0:04:39.70,Main,,0,0,0,,Sana ve kızına ortak bir hediye getirdik-nen Charlotte.Dialogue: 0,0:04:39.71,0:04:43.12,Main,,0,0,0,,Bir hazine sandığı!Dialogue: 0,0:04:43.12,0:04:45.37,Main,,0,0,0,,En sevdiğim!Dialogue: 0,0:04:45.37,0:04:47.93,Main,,0,0,0,,İçinde ne var acaba?Dialogue: 0,0:04:47.93,0:04:51.31,Main,,0,0,0,,Benim de bir hediyem var Linlin.Dialogue: 0,0:04:51.31,0:04:53.64,Main,,0,0,0,,Benimkini de al!Dialogue: 0,0:04:53.64,0:04:57.27,Main,,0,0,0,,Ben de güneyden nadir bir hediye getirdim!Dialogue: 0,0:04:57.27,0:05:01.15,Main,,0,0,0,,Kuzeyin en uç noktasına gittim ben.Dialogue: 0,0:05:02.20,0:05:06.99,Main,,0,0,0,,Minnettarım!  Hep böyle yığınla hediye alıyorum ya!Dialogue: 0,0:05:06.99,0:05:09.94,Main,,0,0,0,,Teşekkürler!Dialogue: 0,0:05:09.94,0:05:12.16,Main,,0,0,0,,Çok mutluyum.Dialogue: 0,0:05:12.16,0:05:18.33,Main,,0,0,0,,Hazine sandığı demişken Mamigo büyük bir deniz altı hazinesi ele geçirdiğini duydum.Dialogue: 0,0:05:18.33,0:05:19.62,Main,,0,0,0,,Bak sen?Dialogue: 0,0:05:19.63,0:05:24.04,Main,,0,0,0,,Kulağın delik ha, senden de bu beklenirdi Morgans.Dialogue: 0,0:05:24.04,0:05:25.38,Main,,0,0,0,,Doğru duymuşsun.Dialogue: 0,0:05:26.13,0:05:31.39,Main,,0,0,0,,Deniz altı kraliyet ailesi içinde nesilden nesle geçen bir hazine sandığı!Dialogue: 0,0:05:32.63,0:05:37.98,Main,,0,0,0,,Nedense Neptune ondan vazgeçti, şimdi de benim avucumda!Dialogue: 0,0:05:41.49,0:05:45.28,Main,,0,0,0,,Karşınızda efsanevi...Dialogue: 0,0:05:45.28,0:05:47.91,Main,,0,0,0,,...Tamatebako!Dialogue: 0,0:05:49.71,0:05:52.48,Main,,0,0,0,,Ne kadar görkemli duruyor!Dialogue: 0,0:05:52.48,0:05:54.04,Main,,0,0,0,,İçinde ne var acaba?Dialogue: 0,0:05:54.04,0:05:57.00,Main,,0,0,0,,Açıp baktın mı Mamigo?!Dialogue: 0,0:05:57.00,0:06:01.24,Main,,0,0,0,,Pudding'in düğününden sonraki büyük şölende açacağım.Dialogue: 0,0:06:01.24,0:06:07.26,Main,,0,0,0,,Diğer hediyelerle birlikte açıp size göstereceğim!Dialogue: 0,0:06:12.10,0:06:13.35,Main,,0,0,0,,Baba!Dialogue: 0,0:06:13.35,0:06:15.63,Main,,0,0,0,,Hallettiniz mi?Dialogue: 0,0:06:15.63,0:06:18.14,Main,,0,0,0,,Tüm hazırlıklar tamam-rero.Dialogue: 0,0:06:18.14,0:06:20.23,Main,,0,0,0,,Tamamdır, elinize sağlık.Dialogue: 0,0:06:20.23,0:06:22.69,Main,,0,0,0,,Siz de çabuk üzerinizi değişin.Dialogue: 0,0:06:22.69,0:06:23.61,Main,,0,0,0,,Baş üstüne.Dialogue: 0,0:06:26.56,0:06:28.65,Main,,0,0,0,,Caesar, aynayı çıkar.Dialogue: 0,0:06:28.65,0:06:30.83,Main,,0,0,0,,Lan adi! Yine o isimle çağırdın!Dialogue: 0,0:06:32.64,0:06:35.22,Main,,0,0,0,,Demek Çay Partisi'ne giriş biletimiz bu oluyor.Dialogue: 0,0:06:36.48,0:06:41.08,Main,,0,0,0,,Fırsatınız varken eğlenmeye bakın ezikler sürüsü!Dialogue: 0,0:06:41.08,0:06:43.47,Thoughts,,0,0,0,,Caesar Clown mı?Dialogue: 0,0:06:43.47,0:06:45.70,Main,,0,0,0,,Sen de eziksin.Dialogue: 0,0:06:45.70,0:06:48.76,Main,,0,0,0,,Git de şu aynayı civara bir yere sakla.Dialogue: 0,0:06:48.76,0:06:50.64,Main,,0,0,0,,Sus be! Biliyoruz herhâlde!Dialogue: 0,0:06:50.64,0:06:53.26,Main,,0,0,0,,Big Mom çığlığı bastı mı...Dialogue: 0,0:06:53.26,0:06:58.09,Main,,0,0,0,,...aynayla birlikte salona dalıyorsun. Görevin bundan ibaret.Dialogue: 0,0:06:59.23,0:07:02.52,Main,,0,0,0,,Başka kaçış güzergâhımız yok bak.Dialogue: 0,0:07:02.52,0:07:05.94,Main,,0,0,0,,Sakın ola aklına başka fikirler gelmesin.Dialogue: 0,0:07:05.94,0:07:08.33,Main,,0,0,0,,Bu saatten sonra size ihanet edemem!Dialogue: 0,0:07:08.33,0:07:11.57,Thoughts,,0,0,0,,Olamaz!  Bege ve tayfası bir işler peşinde!Dialogue: 0,0:07:19.85,0:07:21.66,Main,,0,0,0,,Yontup çıkardım.Dialogue: 0,0:07:21.66,0:07:25.71,Main,,0,0,0,,Boşboğazlık adamı canından eder.Dialogue: 0,0:07:25.71,0:07:28.63,Main,,0,0,0,,Düğüne 30 dakika kaldı.Dialogue: 0,0:07:28.63,0:07:34.11,Main,,0,0,0,,Hasır Şapkalar hazır mı?  Umarım yine aptal gibi vakit harcamıyorlardır.Dialogue: 0,0:07:34.11,0:07:38.35,Main,,0,0,0,,Git kendin bak! Senin vücudundalar!Dialogue: 0,0:07:46.37,0:07:49.60,Main,,0,0,0,,Lan beyinsizler! Ne demeye uyuyorsunuz?Dialogue: 0,0:07:49.60,0:07:51.32,Main,,0,0,0,,Hazırlanmanız gerek!Dialogue: 0,0:07:51.90,0:07:53.70,Main,,0,0,0,,Bırak kestirsinler.Dialogue: 0,0:07:53.70,0:07:57.32,Main,,0,0,0,,Adaya geldiklerinden beri fazla uyumamış gibiler.Dialogue: 0,0:07:57.32,0:07:59.66,Main,,0,0,0,,10 dakika kala hepsini uyandıracağım.Dialogue: 0,0:07:59.66,0:08:01.49,Main,,0,0,0,,İnanılır gibi değil!Dialogue: 0,0:08:01.49,0:08:04.79,Main,,0,0,0,,Ayağıma dolanırlarsa tekmeyi basarım.Dialogue: 0,0:08:04.79,0:08:06.54,Main,,0,0,0,,Sorun olmaz.Dialogue: 0,0:08:07.69,0:08:11.67,Main,,0,0,0,,Onların yerine hazırlıkları tamamlayıp gözcülük ediyorum.Dialogue: 0,0:08:14.97,0:08:17.82,Main,,0,0,0,,Geri zekâlılar sürüsü... Akıl işi değil!Dialogue: 0,0:08:17.82,0:08:18.60,Main,,0,0,0,,Kesinlikle!Dialogue: 0,0:08:20.14,0:08:22.48,Main,,0,0,0,,Sen de içeri dön.Dialogue: 0,0:08:23.23,0:08:26.09,Main,,0,0,0,,Salona gireceğim.Dialogue: 0,0:08:26.09,0:08:28.77,Main,,0,0,0,,Herkes hazır olsun!Dialogue: 0,0:08:30.49,0:08:32.70,Main,,0,0,0,,İçeri girdik mi...Dialogue: 0,0:08:34.74,0:08:37.02,Main,,0,0,0,,...geriye dönüş yok.Dialogue: 0,0:08:39.54,0:08:42.45,Main,,0,0,0,,Sen de hazırsındır umarım...Dialogue: 0,0:08:43.84,0:08:46.08,Main,,0,0,0,,...Vinsmoke Sanji!Dialogue: 0,0:08:46.79,0:08:52.80,Captions,,0,0,0,,9. Kat,  Gelin ile Damadın  Bekleme OdasıDialogue: 0,0:08:54.12,0:08:55.50,Main,,0,0,0,,Ben...Dialogue: 0,0:08:55.50,0:08:58.73,Main,,0,0,0,,Buraya geldiğimde evlenmeyi düşünmediğimden...Dialogue: 0,0:08:59.64,0:09:04.60,Main,,0,0,0,,...şimdi böyle yan yana oturmak bir garip geliyor.Dialogue: 0,0:09:04.60,0:09:07.41,Main,,0,0,0,,Bir rüyadayım sanki...Dialogue: 0,0:09:08.19,0:09:10.49,Thoughts,,0,0,0,,Sakin kal lan, sakin kal!Dialogue: 0,0:09:10.49,0:09:12.57,Thoughts,,0,0,0,,Bir daha zokayı yutmayacağım.Dialogue: 0,0:09:19.84,0:09:21.62,Main,,0,0,0,,Peki...Dialogue: 0,0:09:23.19,0:09:26.96,Main,,0,0,0,,...iyi bir rüya mı yoksa kâbus mu?Dialogue: 0,0:09:27.82,0:09:30.54,Thoughts,,0,0,0,,Çok tatlı anasını satayım!Dialogue: 0,0:09:30.54,0:09:33.77,Main,,0,0,0,,E... Elbette çok iyi bir rüya!Dialogue: 0,0:09:33.77,0:09:36.88,Main,,0,0,0,,Gerçekten mi? Çok sevindim!Dialogue: 0,0:09:36.88,0:09:38.72,Thoughts,,0,0,0,,Sakin ol oğlum!Dialogue: 0,0:09:38.72,0:09:41.51,Thoughts,,0,0,0,,Kız numara yapıyor!Dialogue: 0,0:09:41.52,0:09:43.98,Thoughts,,0,0,0,,Seni öldürmeyi planlıyor!Dialogue: 0,0:09:48.72,0:09:50.15,Thoughts,,0,0,0,,Dur biraz.Dialogue: 0,0:09:50.15,0:09:54.03,Thoughts,,0,0,0,,O gördüklerim rüya olabilir mi?Dialogue: 0,0:09:54.03,0:09:58.29,Thoughts,,0,0,0,,Hayır be, yok, yok! Yemi yutma! Gördüklerine inan!Dialogue: 0,0:09:58.29,0:10:01.06,Main,,0,0,0,,Sanji-san, bir şey mi oldu?Dialogue: 0,0:10:01.06,0:10:04.98,Main,,0,0,0,,Ne? Y- Yok ya, bir şey olmadı. Şeyden...Dialogue: 0,0:10:06.54,0:10:07.57,Main,,0,0,0,,Buldum!Dialogue: 0,0:10:08.58,0:10:12.44,Main,,0,0,0,,D- Düğün öpücüğü var ya... Şey...Dialogue: 0,0:10:12.44,0:10:17.10,Main,,0,0,0,,İlk kez insan içinde yapacağın için çekinirsen diye...Dialogue: 0,0:10:17.10,0:10:20.22,Main,,0,0,0,,İ- İ- İstersen alnından da öpebilirim...Dialogue: 0,0:10:22.21,0:10:25.89,Main,,0,0,0,,Dudağımdan öp lütfen. Evli çiftler olacağız ne de olsa.Dialogue: 0,0:10:42.19,0:10:43.68,Main,,0,0,0,,O ses neydi?Dialogue: 0,0:10:44.51,0:10:47.04,Main,,0,0,0,,Sanji-sama tavana mı çarptı?Dialogue: 0,0:10:48.54,0:10:50.75,Main,,0,0,0,,Nasıl bu hâlde geldi?Dialogue: 0,0:10:50.75,0:10:52.71,Main,,0,0,0,,Çok kan kaybediyor!Dialogue: 0,0:10:52.71,0:10:54.00,Main,,0,0,0,,Olamaz!Dialogue: 0,0:10:55.21,0:10:56.86,Main,,0,0,0,,Sanji-san!Dialogue: 0,0:10:57.59,0:11:00.80,Thoughts,,0,0,0,,Bu sapık kurbağa bozuntusunun derdi ne be?Dialogue: 0,0:11:00.80,0:11:02.82,Thoughts,,0,0,0,,Onu şimdi gebertmek istiyorum!Dialogue: 0,0:11:41.47,0:11:43.30,Main,,0,0,0,,Her şey yolunda, değil mi?Dialogue: 0,0:11:43.30,0:11:46.22,Main,,0,0,0,,Evet, asayiş berkemal.Dialogue: 0,0:11:46.22,0:11:51.44,Main,,0,0,0,,Güzel o zaman. Bugün özel bir gün.Dialogue: 0,0:11:52.21,0:11:54.90,Main,,0,0,0,,Gözünü dört aç-perorin.Dialogue: 0,0:11:55.69,0:11:57.19,Main,,0,0,0,,Biliyorum.Dialogue: 0,0:12:00.24,0:12:03.66,Main,,0,0,0,,Saat 12! Saat 12!Dialogue: 0,0:12:27.43,0:12:33.27,Main,,0,0,0,,Pekâlâ hanımlar ve beyler! Günün olayına geliyoruz!Dialogue: 0,0:12:33.27,0:12:38.23,Main,,0,0,0,,Charlotte Ailesi'nin 35. kızı Charlotte Pudding-sama ile...Dialogue: 0,0:12:38.23,0:12:42.61,Main,,0,0,0,,...Vinsmokelar'ın 3. oğulu Vinsmoke Sanji-sama'nın...Dialogue: 0,0:12:42.61,0:12:44.82,Main,,0,0,0,,...kraliyet düğünü...Dialogue: 0,0:12:44.82,0:12:47.33,Main,,0,0,0,,...şimdi başlıyor!Dialogue: 0,0:12:51.83,0:12:53.12,Lyrics,,0,0,0,,♪ Düğün! ♪Dialogue: 0,0:12:53.12,0:12:55.62,Lyrics,,0,0,0,,♪ Düğün!  ♪ ♪ Düğün! ♪Dialogue: 0,0:12:55.62,0:12:58.00,Lyrics,,0,0,0,,♪ Düğün! ♪Dialogue: 0,0:13:10.06,0:13:11.81,Lyrics,,0,0,0,,♪ Düğün!  ♪ ♪ Düğün! ♪Dialogue: 0,0:13:13.44,0:13:15.81,Main,,0,0,0,,Büyüleyici!Dialogue: 0,0:13:16.69,0:13:21.48,Main,,0,0,0,,Daha fazla bekletmeden  gelin ve damadı sahneye davet ediyoruz!Dialogue: 0,0:13:39.71,0:13:42.88,Main,,0,0,0,,Yonkou Big Mom Korsanları!Dialogue: 0,0:13:42.88,0:13:47.64,Main,,0,0,0,,Diğer tarafta ise şeytani ordu Germa 66!Dialogue: 0,0:13:48.34,0:13:53.68,Main,,0,0,0,,Genç çiftimiz kötü şöhretli ailelerinin hayallerini birbirine bağlayacak!Dialogue: 0,0:13:55.27,0:13:58.20,Main,,0,0,0,,Mariage de Raison!Dialogue: 0,0:13:55.27,0:13:58.20,Note,,0,0,0,,Mantık Evliliği!Dialogue: 0,0:14:01.19,0:14:08.70,Main,,0,0,0,,İkilinin dünya evine adım atmasıyla bir şeytani çiçek daha yeşerecek!Dialogue: 0,0:14:08.70,0:14:11.26,Main,,0,0,0,,Alkış!Dialogue: 0,0:14:14.66,0:14:15.83,Main,,0,0,0,,Şuna baksana!Dialogue: 0,0:14:17.29,0:14:20.21,Main,,0,0,0,,Bu musmutlu günü alkışlayın!Dialogue: 0,0:14:24.13,0:14:26.51,Main,,0,0,0,,Alkışlayın!Dialogue: 0,0:14:32.81,0:14:34.14,Thoughts,,0,0,0,,Vay adi herif!Dialogue: 0,0:14:35.64,0:14:38.02,Thoughts,,0,0,0,,Acayip iyi rol yapıyor!Dialogue: 0,0:14:40.73,0:14:44.23,Narrator,,0,0,0,,Kanlı düğün şimdi başlıyor!Dialogue: 0,0:14:52.41,0:14:53.99,Main,,0,0,0,,Luffy!Dialogue: 0,0:15:00.46,0:15:04.34,Main,,0,0,0,,Tören başladı! Luffy!Dialogue: 0,0:15:04.34,0:15:07.68,Main,,0,0,0,,Daha midemde yer var...Dialogue: 0,0:15:08.42,0:15:10.26,Main,,0,0,0,,Uyansana!Dialogue: 0,0:15:10.80,0:15:13.68,Main,,0,0,0,,Sanji'yi yüzüstü bırakmak mı istiyorsun?Dialogue: 0,0:15:21.69,0:15:24.77,Main,,0,0,0,,Baksanıza! Nasıl uyandırırız?Dialogue: 0,0:15:24.77,0:15:28.37,Main,,0,0,0,,Uyuyakalmadan önce deli gibi ormanda koşuşturduğundan...Dialogue: 0,0:15:28.37,0:15:31.11,Main,,0,0,0,,...ancak yemek ile ayıltabiliriz.Dialogue: 0,0:15:31.11,0:15:34.28,Main,,0,0,0,,Baksanıza, hiç et var mı? Çabuk ama!Dialogue: 0,0:15:34.28,0:15:37.08,Main,,0,0,0,,- Et mi? - Şimdi kahvaltı mı yapacaksınız?Dialogue: 0,0:15:59.46,0:16:02.42,Thoughts,,0,0,0,,Bu, cenazen için çalınan müziktir!Dialogue: 0,0:16:02.42,0:16:06.57,Thoughts,,0,0,0,,Salak salak dinlemeye devam et Sanji!Dialogue: 0,0:16:19.83,0:16:22.08,Main,,0,0,0,,Sanji-san, teşekkür ederim.Dialogue: 0,0:16:22.08,0:16:24.56,Main,,0,0,0,,Sanji-san, ben...Dialogue: 0,0:16:25.66,0:16:27.79,Main,,0,0,0,,...çok mutluyum şu an!Dialogue: 0,0:16:27.79,0:16:32.26,Main,,0,0,0,,P... P-P-P-P-Pudding-chan...Dialogue: 0,0:16:32.26,0:16:35.97,Main,,0,0,0,,B... Ben de!Dialogue: 0,0:16:40.76,0:16:44.18,Thoughts,,0,0,0,,Siktir! Siktir! Uçkuruna sahip çık!Dialogue: 0,0:16:44.18,0:16:47.98,Thoughts,,0,0,0,,Dikkatini vermezsen...Dialogue: 0,0:16:47.99,0:16:50.23,Thoughts,,0,0,0,,Öleceksin oğlum!Dialogue: 0,0:16:52.15,0:16:53.28,Lyrics,,0,0,0,,♪ Düğün! ♪Dialogue: 0,0:16:53.28,0:16:54.32,Lyrics,,0,0,0,,♪ Düğün! ♪Dialogue: 0,0:16:54.32,0:16:55.28,Lyrics,,0,0,0,,♪ Düğün! ♪Dialogue: 0,0:16:55.28,0:16:56.32,Lyrics,,0,0,0,,♪ Düğün! ♪Dialogue: 0,0:16:56.32,0:17:00.20,Lyrics,,0,0,0,,♪ Düğün! ♪Dialogue: 0,0:17:00.20,0:17:02.87,Lyrics,,0,0,0,,♪ Zorlu bir aşka... ♪Dialogue: 0,0:17:02.87,0:17:04.25,Lyrics,,0,0,0,,♪ Tutuldum... ♪Dialogue: 0,0:17:04.25,0:17:06.76,Lyrics,,0,0,0,,♪ Acı bir aşka... ♪Dialogue: 0,0:17:06.76,0:17:08.22,Lyrics,,0,0,0,,♪ Tutuldum... ♪Dialogue: 0,0:17:08.22,0:17:14.01,Lyrics,,0,0,0,,♪ Oldum âşık, düştüm ellerine,  kırıldı kalbim... ♪Dialogue: 0,0:17:14.01,0:17:18.30,Lyrics,,0,0,0,,♪ Bekâr günlerim son buluyor! ♪Dialogue: 0,0:17:18.30,0:17:22.10,Lyrics,,0,0,0,,♪ Yağmura tutulsam da... ♪Dialogue: 0,0:17:22.10,0:17:25.85,Lyrics,,0,0,0,,♪ Üzerime mızraklar yağsa da... ♪Dialogue: 0,0:17:25.85,0:17:30.87,Lyrics,,0,0,0,,♪ ...elini asla bırakmayacağım. ♪Dialogue: 0,0:17:30.87,0:17:32.78,Main,,0,0,0,,- Şef! - Şef!Dialogue: 0,0:17:34.24,0:17:40.78,Lyrics,,0,0,0,,♪ Karşınızda tebrik için... ♪Dialogue: 0,0:17:40.78,0:17:47.87,Lyrics,,0,0,0,,♪ Düğün pastası! ♪Dialogue: 0,0:18:43.76,0:18:45.28,Main,,0,0,0,,Bravo!Dialogue: 0,0:18:45.81,0:18:48.09,Main,,0,0,0,,Çok güzel! Göz kamaştırıcı!Dialogue: 0,0:18:48.09,0:18:50.92,Main,,0,0,0,,Kocaman yapmışlar! İhtişama bakın!Dialogue: 0,0:18:50.92,0:18:52.86,Main,,0,0,0,,Enfes gözüküyor!Dialogue: 0,0:18:52.86,0:18:55.57,Main,,0,0,0,,Fevkalade bir düğün pastası!Dialogue: 0,0:18:55.57,0:19:00.67,Main,,0,0,0,,Yine döktürmüşsün Streusen! Hakkını vermem gerek!Dialogue: 0,0:19:00.67,0:19:02.62,Main,,0,0,0,,Övgülerinize layık değilim efendim.Dialogue: 0,0:19:02.62,0:19:06.95,Main,,0,0,0,,Yemek için sabırsızlanıyorum!Dialogue: 0,0:19:15.71,0:19:20.38,Main,,0,0,0,,Harika! Yeminimizi ettiğimiz masa bu güzelim pasta olacak demek!Dialogue: 0,0:19:20.38,0:19:23.18,Main,,0,0,0,,Hayır, harika olan sensin!Dialogue: 0,0:19:23.18,0:19:27.69,Main,,0,0,0,,Yapma şöyle! Utandırıyorsun Sanji-san!Dialogue: 0,0:19:27.69,0:19:29.56,Thoughts,,0,0,0,,Geber hemen!Dialogue: 0,0:19:29.56,0:19:34.34,Main,,0,0,0,,Pudding-chan çok güzel ya, bana gençliğimi hatırlatıyor.Dialogue: 0,0:19:34.34,0:19:36.74,Main,,0,0,0,,Kaç asır önceydi-nen?Dialogue: 0,0:19:36.74,0:19:38.33,Main,,0,0,0,,Canına susayan var galiba.Dialogue: 0,0:19:39.32,0:19:40.71,Main,,0,0,0,,Acıdı be-nen!Dialogue: 0,0:19:45.25,0:19:48.79,Thoughts,,0,0,0,,Eğlenmenize bakın konuklarım.Dialogue: 0,0:19:48.79,0:19:52.92,Thoughts,,0,0,0,,Doruk noktası...Dialogue: 0,0:20:05.86,0:20:08.72,Thoughts,,0,0,0,,...ansızın yaşanıp bitecek.Dialogue: 0,0:20:08.72,0:20:12.31,Main,,0,0,0,,Buyrun. Size ayrılan yerde düğünün tadını çıkarın.Dialogue: 0,0:20:15.20,0:20:18.40,Thoughts,,0,0,0,,Başlamak üzere!Dialogue: 0,0:20:18.40,0:20:20.28,Thoughts,,0,0,0,,Kan banyosu!Dialogue: 0,0:20:21.04,0:20:23.95,Thoughts,,0,0,0,,Birazdan düğün öpücüğüyle birlikte...Dialogue: 0,0:20:23.95,0:20:26.87,Thoughts,,0,0,0,,...kanlı şölen başlayacak.Dialogue: 0,0:20:26.87,0:20:32.11,Thoughts,,0,0,0,,Kusura bakmayın ama ölmeniz gerek Vinsmokelar!Dialogue: 0,0:20:35.31,0:20:38.06,Main,,0,0,0,,Sanji de ne ballı ha!Dialogue: 0,0:20:38.06,0:20:41.74,Main,,0,0,0,,Hatunun bu kadar güzel olduğunu bilsem kendim evlenirdim.Dialogue: 0,0:20:41.74,0:20:44.65,Main,,0,0,0,,Big Mom'ın kızıyla mı? Hayatta olmaz.Dialogue: 0,0:20:44.65,0:20:48.04,Main,,0,0,0,,O bir kurban. Aklınızdan çıkarmayın.Dialogue: 0,0:20:48.04,0:20:51.86,Main,,0,0,0,,Evlendiğiniz gibi ömrünüz boyunca Big Mom'ın emri altına girersiniz.Dialogue: 0,0:20:51.86,0:20:55.06,Main,,0,0,0,,Haklısın, onu da hiç istemeyiz.Dialogue: 0,0:20:56.08,0:21:01.08,Thoughts,,0,0,0,,Anlıyorum. Charlotte kardeşler etrafımızı sarmışken...Dialogue: 0,0:21:01.67,0:21:04.36,Thoughts,,0,0,0,,...oldukça kolay hedefleriz.Dialogue: 0,0:21:04.36,0:21:08.33,Thoughts,,0,0,0,,Silahsız olduğumuzdan da av hayvanlarından farksızız.Dialogue: 0,0:21:08.92,0:21:10.34,Thoughts,,0,0,0,,Olması gereken bu...Dialogue: 0,0:21:11.43,0:21:14.38,Thoughts,,0,0,0,,Germa artık gereksiz bir krallık.Dialogue: 0,0:21:15.10,0:21:16.29,Thoughts,,0,0,0,,Fakat...Dialogue: 0,0:21:16.84,0:21:17.72,Thoughts,,0,0,0,,Sanji...Dialogue: 0,0:21:22.17,0:21:24.42,Thoughts,,0,0,0,,Senin kaçmanı istiyorum.Dialogue: 0,0:21:25.19,0:21:28.19,Thoughts,,0,0,0,,Bir planın var, değil mi? Sana inanabilir miyim?Dialogue: 0,0:21:29.18,0:21:30.22,Thoughts,,0,0,0,,Luffy-kun!Dialogue: 0,0:21:30.22,0:21:34.06,Main,,0,0,0,,Hastalıkta sağlıkta...Dialogue: 0,0:21:34.06,0:21:37.30,Main,,0,0,0,,...varlıkta ve yoklukta...Dialogue: 0,0:21:37.30,0:21:38.98,Main,,0,0,0,,...ölüm sizi ayırana dek...Dialogue: 0,0:21:38.98,0:21:42.73,Main,,0,0,0,,...bir ve beraber olmaya...Dialogue: 0,0:21:43.32,0:21:47.30,Main,,0,0,0,,Çabuk olun! Vakit yok!Dialogue: 0,0:21:47.30,0:21:49.74,Main,,0,0,0,,Sen hiç konuşma!Dialogue: 0,0:21:50.64,0:21:54.78,Main,,0,0,0,,Birbirinizi sevip sayacağınıza yemin ediyor musunuz?Dialogue: 0,0:22:00.38,0:22:03.84,Main,,0,0,0,,Nihayet arzum gerçek oluyor!Dialogue: 0,0:22:16.10,0:22:20.69,Thoughts,,0,0,0,,N'oluyor Pudding? Neden yere kapaklanıyorsun?Dialogue: 0,0:22:20.69,0:22:24.90,Main,,0,0,0,,Artık peçeyi kaldırıp gelini öpebilirsin.Dialogue: 0,0:22:24.90,0:22:26.78,Main,,0,0,0,,Bir şey mi oldu abi?Dialogue: 0,0:22:27.71,0:22:30.53,Thoughts,,0,0,0,,Geleceği gördün demek Katakuri!Dialogue: 0,0:22:36.16,0:22:38.33,Main,,0,0,0,,Peçeyi kaldıracağım.Dialogue: 0,0:22:39.82,0:22:40.88,Main,,0,0,0,,Peki.Dialogue: 0,0:23:23.80,0:23:26.34,Thoughts,,0,0,0,,İyi bak şimdi Sanji...Dialogue: 0,0:23:27.34,0:23:28.38,Thoughts,,0,0,0,,Bu...Dialogue: 0,0:23:29.36,0:23:31.66,Thoughts,,0,0,0,,İğrenç mi iğrenç...Dialogue: 0,0:23:31.66,0:23:33.88,Thoughts,,0,0,0,,...üçüncü gözüme!Dialogue: 0,0:23:44.61,0:23:45.96,Thoughts,,0,0,0,,Aferin sana.Dialogue: 0,0:23:47.05,0:23:48.78,Thoughts,,0,0,0,,Dona kal böyle.Dialogue: 0,0:23:52.04,0:23:55.12,Main,,0,0,0,,Ne kadar da güzel bir göz!Dialogue: 0,0:24:21.81,0:24:23.23,Main,,0,0,0,,Ne?Dialogue: 0,0:24:26.31,0:24:30.69,Main,,0,0,0,,Özür dilerim!  Yakından bakınca gözlerimi alamadım.Dialogue: 0,0:24:31.87,0:24:33.15,Main,,0,0,0,,Ne yapıyor bu kız?Dialogue: 0,0:24:33.70,0:24:35.62,Main,,0,0,0,,Tereddüt etme Pudding!Dialogue: 0,0:24:36.46,0:24:38.22,Main,,0,0,0,,Pudding... chan?Dialogue: 0,0:24:40.04,0:24:43.50,Thoughts,,0,0,0,,Neler söylüyor bu adam?Dialogue: 0,0:24:43.50,0:24:49.30,Flashbacks,,0,0,0,,Karşında duracak damat Sanji...Dialogue: 0,0:24:49.30,0:24:54.18,Flashbacks,,0,0,0,,...ilk kez üçüncü gözünü görür!Dialogue: 0,0:24:54.98,0:25:01.77,Flashbacks,,0,0,0,,Güzel gelinin iğrenç suratını gördüğü gibi...Dialogue: 0,0:25:01.77,0:25:03.73,Flashbacks,,0,0,0,,...afallayıp kalacak.Dialogue: 0,0:25:16.12,0:25:18.24,Thoughts,,0,0,0,,Hadi oradan!Dialogue: 0,0:25:19.12,0:25:21.16,Thoughts,,0,0,0,,Aklından neler geçiyor bunun?Dialogue: 0,0:25:21.79,0:25:26.98,Thoughts,,0,0,0,,Doğduğum günden bu yana hiçbir zaman...Dialogue: 0,0:25:26.98,0:25:32.46,Thoughts,,0,0,0,,Tek bir kişi bile bu gözü güzel bulduğunu söylemedi!Dialogue: 0,0:25:32.46,0:25:35.76,Thoughts,,0,0,0,,Sorun nedir Pudding? Ateş et işte!Dialogue: 0,0:25:37.73,0:25:40.40,Thoughts,,0,0,0,,Hiç kimse...Dialogue: 0,0:25:43.75,0:25:48.95,Main,,0,0,0,,Kızım olsan da midemi kaldırıyorsun. Kâküllerini uzat Pudding.Dialogue: 0,0:25:51.34,0:25:54.08,Main,,0,0,0,,Peki, baş üstüne.Dialogue: 0,0:25:55.53,0:25:57.49,Main,,0,0,0,,Canavar!Dialogue: 0,0:25:58.34,0:26:00.63,Main,,0,0,0,,Çok iğrenç ya!Dialogue: 0,0:26:00.63,0:26:02.33,Main,,0,0,0,,Ne biçim çocuk bu?Dialogue: 0,0:26:04.04,0:26:06.71,Main,,0,0,0,,Bakın! Bu kız canavarın teki!Dialogue: 0,0:26:08.35,0:26:10.40,Main,,0,0,0,,Yapmayın!Dialogue: 0,0:26:16.63,0:26:18.72,Main,,0,0,0,,Şimdi ne diyorsun canavar?Dialogue: 0,0:26:18.72,0:26:20.93,Main,,0,0,0,,Canavar! Canavar!Dialogue: 0,0:26:27.35,0:26:30.56,Main,,0,0,0,,Benimle alay etmenize sessiz kalacak değilim!Dialogue: 0,0:26:30.56,0:26:33.96,Main,,0,0,0,,Beyinsiz piç kuruları...Dialogue: 0,0:26:33.96,0:26:35.86,Main,,0,0,0,,...hepinizi öldüreceğim!Dialogue: 0,0:26:35.86,0:26:38.36,Main,,0,0,0,,Kaçın!Dialogue: 0,0:26:48.53,0:26:49.71,Main,,0,0,0,,Pudding-chan...Dialogue: 0,0:26:51.35,0:26:52.67,Main,,0,0,0,,Kahrolası...Dialogue: 0,0:26:53.38,0:26:56.98,Main,,0,0,0,,Seni öldüreceğim!Dialogue: 0,0:26:56.98,0:27:00.51,Main,,0,0,0,,Çirkin bir canavarım ben!Dialogue: 0,0:27:01.59,0:27:04.65,Thoughts,,0,0,0,,Lan, planı unuttun mu Pudding?Dialogue: 0,0:27:05.57,0:27:07.48,Main,,0,0,0,,Pudding-chan, iyi misin?Dialogue: 0,0:27:09.52,0:27:11.73,Thoughts,,0,0,0,,Sen yap rahip!Dialogue: 0,0:27:16.90,0:27:18.95,Thoughts,,0,0,0,,İşe yaramaz! Savuşturacak!Dialogue: 0,0:27:33.38,0:27:34.71,Main,,0,0,0,,Savuşturdu!Dialogue: 0,0:27:39.05,0:27:41.18,Thoughts,,0,0,0,,Hasır Şapka! Şimdi!Dialogue: 0,0:27:41.18,0:27:43.68,Main,,0,0,0,,Silah ateşi sesi Luffy!Dialogue: 0,0:27:43.68,0:27:45.51,Main,,0,0,0,,Harika! Yetişebilirim!Dialogue: 0,0:27:47.89,0:27:49.93,Main,,0,0,0,,O silah ateşi de neydi?Dialogue: 0,0:27:49.93,0:27:51.43,Main,,0,0,0,,Rahip ateş etti!Dialogue: 0,0:27:51.43,0:27:52.93,Main,,0,0,0,,Hayır, onu vurdular!Dialogue: 0,0:27:52.93,0:27:53.73,Main,,0,0,0,,Neden?Dialogue: 0,0:27:53.73,0:27:55.48,Main,,0,0,0,,Neler oluyor?Dialogue: 0,0:27:55.48,0:27:56.61,Main,,0,0,0,,Bu...Dialogue: 0,0:27:58.15,0:28:03.05,Main,,0,0,0,,Neler oluyor burada? Katakuri, Pudding'e ne oldu?Dialogue: 0,0:28:03.05,0:28:07.29,Main,,0,0,0,,Daha büyük sorunlarımız var. Beklenmedik bir şey oldu Mama.Dialogue: 0,0:28:07.29,0:28:09.58,Main,,0,0,0,,Yaşanacaklara ben bile engel olamam!Dialogue: 0,0:28:09.58,0:28:12.58,Main,,0,0,0,,Ne yapacağız şimdi? Sanji daha vurulmadı!Dialogue: 0,0:28:12.58,0:28:14.83,Main,,0,0,0,,Plana sadık mı kalalım?Dialogue: 0,0:28:14.83,0:28:17.63,Main,,0,0,0,,Gidelim!Dialogue: 0,0:28:17.63,0:28:22.51,Main,,0,0,0,,Üzgünüm Mama!  Dediklerini yapmaktan başka çarem yoktu!Dialogue: 0,0:28:22.51,0:28:25.39,Main,,0,0,0,,Sanji'yi geri alacağız!Dialogue: 0,0:28:30.24,0:28:31.52,Main,,0,0,0,,N'oluyor?Dialogue: 0,0:28:32.22,0:28:33.60,Thoughts,,0,0,0,,Onları durduramam!Dialogue: 0,0:28:34.62,0:28:37.40,Main,,0,0,0,,Şuradan çıkacaklar!Dialogue: 0,0:28:37.40,0:28:38.65,Main,,0,0,0,,Ne?Dialogue: 0,0:28:57.59,0:29:00.81,Main,,0,0,0,,Big Mom!Dialogue: 0,0:29:23.73,0:29:27.37,Main,,0,0,0,,Ne!!Dialogue: 0,0:29:27.37,0:29:32.33,Credits,,0,0,0,,Editing:  Feeso, Galaxy 9000  Timing: Lance  Quality Assurance: Feeso, Galaxy 9000, Grug, Pepperjack  Soundtracking:  Halee  Infoboxes & Title:  Datenshi  Karaoke: KaitouYahiko  Translation: Crunchyroll