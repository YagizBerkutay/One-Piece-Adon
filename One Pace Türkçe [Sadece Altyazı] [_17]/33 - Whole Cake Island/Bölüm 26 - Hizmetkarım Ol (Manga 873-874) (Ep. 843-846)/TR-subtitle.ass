,FOT-Greco Std B,29,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,95,100,1,0,1,2.2,0,7,10,10,10,1Style: Author,Impress BT,22.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.7,0.7,9,10,10,10,1Style: Attack,Duality,30.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.0,1.0,7,12,12,12,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:01:34.21,0:01:36.58,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - dmc3 thx to onepace.netDialogue: 0,0:17:35.90,0:17:45.90,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - dmc3 thx to onepace.netDialogue: 0,0:34:11.38,0:34:14.40,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - dmc3 thx to onepace.netDialogue: 0,0:01:34.21,0:01:36.58,Title,,0,0,0,,Hizmetkarım OlDialogue: 0,0:01:36.58,0:01:38.85,Main,,0,0,0,,Ne? Durun biraz!Dialogue: 0,0:01:38.85,0:01:43.12,Main,,0,0,0,,Çay Partisi'nin başına bunlar mı geldi-chocolat?Dialogue: 0,0:01:43.12,0:01:45.44,Main,,0,0,0,,H- Hasır Şapkalar mı yaptı?Dialogue: 0,0:01:45.44,0:01:50.43,Main,,0,0,0,,Evet, bildiğin felaket!  Düğün de düğün pastası da mahvoldu!Dialogue: 0,0:01:50.43,0:01:52.74,Main,,0,0,0,,Vinsmokelar'ın infazı da yattı!Dialogue: 0,0:01:52.74,0:01:57.71,Main,,0,0,0,,Yetmezmiş gibi Bege bize ihanet ederek Mama'yı öldürmeye kalktı!Dialogue: 0,0:01:57.71,0:02:03.54,Main,,0,0,0,,Aşağılık Bege... Üstün yeteneklerinden dolayı tüm saygımı kazanmıştı oysa-noir!Dialogue: 0,0:02:03.54,0:02:08.21,Main,,0,0,1,,Fakat patlamanın nedenini hâlâ bilmiyoruz.Dialogue: 0,0:02:04.20,0:02:08.21,Captions,,500,0,280,,Charlotte Ailesi'nin En Büyük KızıDialogue: 0,0:02:10.67,0:02:15.91,Main,,0,0,0,,Andavallar sürüsü de bizimle çatıdaydı, onların işiyse eğer intihara kalkıştılar.Dialogue: 0,0:02:15.91,0:02:17.48,Main,,0,0,0,,Çok zayıf bir ihtimal.Dialogue: 0,0:02:17.48,0:02:21.88,Main,,0,0,0,,Fakat bir belirsizlik neticeye bağlandı-mour.Dialogue: 0,0:02:21.88,0:02:23.70,Main,,0,0,0,,Çay Partisi sırasında...Dialogue: 0,0:02:23.70,0:02:28.02,Main,,0,0,0,,...hiçbir haberleşme hattıyla bölgeye ulaşılamıyordu-bon!Dialogue: 0,0:02:28.02,0:02:31.12,Main,,0,0,0,,Muhtemelen Begeler'in işidir.Dialogue: 0,0:02:31.12,0:02:34.25,Main,,0,0,0,,Tebliğ etmek istediğiniz bir şey var mıydı?Dialogue: 0,0:02:34.25,0:02:40.28,Main,,0,0,0,,Aslına bakarsan Çay Partisi sırasında doğu sahilinde demirleyen Güneş Korsanları...Dialogue: 0,0:02:40.28,0:02:44.08,Main,,0,0,0,,Evet! Topukladılar! Grr!Dialogue: 0,0:02:44.08,0:02:45.22,Main,,0,0,0,,Pekoms!Dialogue: 0,0:02:45.22,0:02:50.17,Main,,0,0,0,,Balık Adam Korsanları mürettebatının tamamı tası tarağı toplayıp toz oldu!Dialogue: 0,0:02:50.17,0:02:54.22,Main,,0,0,0,,Anlıyorum...  Jinbe ondan böyle bir karar alabildi.Dialogue: 0,0:02:56.19,0:02:57.13,Main,,0,0,0,,Jinbe...Dialogue: 0,0:02:58.14,0:03:02.87,Main,,0,0,0,,...Big Mom Korsanları'nı terk ederek Hasır Şapkalar'a katıldı.Dialogue: 0,0:03:03.81,0:03:07.23,Main,,0,0,0,,Ne? Jinbe tayfadan mı ayrıldı?Dialogue: 0,0:03:07.23,0:03:10.24,Main,,0,0,0,,Evet.  Eylemleri şimdi bir anlam kazanıyor.Dialogue: 0,0:03:11.95,0:03:14.26,Main,,0,0,0,,Mama'nın öfkesini mürettebatından çıkaracağını adı gibi biliyordu.Dialogue: 0,0:03:14.26,0:03:17.07,Main,,0,0,0,,Bu yüzden de Jinbe tayfadan ayrılma isteğinden cayarak...Dialogue: 0,0:03:17.07,0:03:20.04,Main,,0,0,0,,...arkadaşlarına durumu izah edip kaçmaları için vakit kazandırdı.Dialogue: 0,0:03:20.04,0:03:23.95,Main,,0,0,0,,Jinbe'den beklenecek zekice bir hamle.Dialogue: 0,0:03:23.95,0:03:25.58,Main,,0,0,0,,Katakuri!Dialogue: 0,0:03:25.58,0:03:29.25,Main,,0,0,0,,Taburlar Hasır Şapka ile Bege'nin peşine düşmüş durumda!Dialogue: 0,0:03:30.10,0:03:31.25,Main,,0,0,0,,Anlaşıldı.Dialogue: 0,0:03:31.25,0:03:34.64,Main,,0,0,0,,Bağımsız birlikler ise Germa'yı işgal ediyor.Dialogue: 0,0:03:34.64,0:03:38.06,Main,,0,0,0,,Pekâlâ... Brûlée, benimle geliyorsun!Dialogue: 0,0:03:38.06,0:03:43.68,Main,,0,0,0,,Elbette abi! Hasır Şapkalar'ı öldürür müsün lütfen?Dialogue: 0,0:03:43.68,0:03:45.52,Main,,0,0,0,,Yaptıklarının bedelini ödetmek istiyorum!Dialogue: 0,0:03:45.52,0:03:49.61,Main,,0,0,0,,Beni bir binek hayvanı gibi kullanarak...Dialogue: 0,0:03:49.61,0:03:52.90,Main,,0,0,0,,...Mama'yı öldürmeye kalkışmalarına yardım etmek zorunda bıraktılar!Dialogue: 0,0:03:53.61,0:03:55.78,Main,,0,0,0,,Niyetim o.Dialogue: 0,0:03:55.78,0:03:58.29,Main,,0,0,0,,Hasır Şapka'nın kellesini bizzat alacağım!Dialogue: 0,0:03:59.11,0:04:03.94,Main,,0,0,0,,İleride Mama'ya gerçek bir tehdit teşkil etmeden evvel...Dialogue: 0,0:04:03.94,0:04:06.75,Main,,0,0,0,,...icabına bakılması gerektiği kanaatine vardım.Dialogue: 0,0:04:23.81,0:04:26.43,Main,,0,0,0,,Millet! Şehri terk edin!Dialogue: 0,0:04:26.43,0:04:27.73,Main,,0,0,0,,Smoothie!Dialogue: 0,0:04:28.39,0:04:30.33,Main,,0,0,0,,Olabildiğince uzağa kaçın!Dialogue: 0,0:04:34.41,0:04:35.77,Main,,0,0,0,,Böyle bir zamanda mı?Dialogue: 0,0:04:35.77,0:04:38.33,Main,,0,0,0,,Ne oldu Smoothie?Dialogue: 0,0:04:39.32,0:04:42.01,Main,,0,0,0,,Millet! Kaçın!Dialogue: 0,0:04:50.54,0:04:54.38,Main,,0,0,0,,Şimdi yaşanıyor olamaz!Dialogue: 0,0:04:54.38,0:04:58.61,Captions,,0,0,0,,Germa KrallığıDialogue: 0,0:04:58.61,0:05:01.89,Main,,0,0,0,,Ne Judge-sama'ya ne de Ichiji-sama'ya ulaşabiliyorum.Dialogue: 0,0:05:01.89,0:05:04.03,Main,,0,0,0,,Ne oldu acaba?Dialogue: 0,0:05:05.52,0:05:06.39,Main,,0,0,0,,Bu da nedir?Dialogue: 0,0:05:12.52,0:05:14.49,Main,,0,0,0,,Big Mom Korsanları mı?Dialogue: 0,0:05:22.88,0:05:26.88,Main,,0,0,0,,Düğün pastam nerede?Dialogue: 0,0:05:41.82,0:05:44.32,Main,,0,0,0,,Kraliçe'nin açlık krizi baş gösterdi!Dialogue: 0,0:05:44.32,0:05:48.65,Main,,0,0,0,,Zaten kısa süre önce bir kriz atlatmıştı oysa!Dialogue: 0,0:05:51.76,0:05:56.58,Main,,0,0,0,,Düğün pastasının yerle bir edildiğini, tadına bakamadığını hatırlamış!Dialogue: 0,0:06:02.96,0:06:05.59,Main,,0,0,0,,Mama'nın elinde tuttuğu ne?Dialogue: 0,0:06:10.59,0:06:13.18,Main,,0,0,0,,Artık çok geç.Dialogue: 0,0:06:20.35,0:06:21.79,Main,,0,0,0,,Olamaz!Dialogue: 0,0:06:30.19,0:06:31.88,Main,,0,0,0,,Opera abi!Dialogue: 0,0:06:31.88,0:06:34.44,Main,,0,0,0,,Hey! Kendine gel!Dialogue: 0,0:06:34.44,0:06:36.30,Main,,0,0,0,,Ömrünü mü aldı yoksa?Dialogue: 0,0:06:36.30,0:06:37.79,Main,,0,0,0,,Abi!Dialogue: 0,0:06:38.82,0:06:43.29,Main,,0,0,0,,Opera abi Mama'yı durdurmak için karşısına çıktı!Dialogue: 0,0:06:44.46,0:06:47.92,Main,,0,0,0,,Kimse Mama'ya yaklaşmasın!Dialogue: 0,0:06:57.73,0:07:00.94,Main,,0,0,0,,Bir çaresine bakmalıyız...Dialogue: 0,0:07:00.94,0:07:02.60,Main,,0,0,0,,Nerede?Dialogue: 0,0:07:03.54,0:07:07.28,Main,,0,0,0,,Düğün pastam!Dialogue: 0,0:07:19.65,0:07:22.71,Main,,0,0,0,,Çabuk olun millet! Yakında kuyruğumuza yapışırlar!Dialogue: 0,0:07:23.79,0:07:24.96,Main,,0,0,0,,Nami!Dialogue: 0,0:07:24.96,0:07:29.27,Main,,0,0,0,,Jinbei'nin sırtındayken ahkâm kesip durma!Dialogue: 0,0:07:29.27,0:07:31.13,Main,,0,0,0,,Karışma kıza!Dialogue: 0,0:07:31.13,0:07:33.85,Main,,0,0,0,,Nami-san çok tatlı zira!Dialogue: 0,0:07:33.85,0:07:36.09,Main,,0,0,0,,Tatlı olduğum kadar da hassasım ama...Dialogue: 0,0:07:38.35,0:07:43.41,Main,,0,0,0,,Big Mom Korsanları'ndan mutlaka peşimize düşenler olacaktır! Elimizi çabuk tutmalıyız!Dialogue: 0,0:07:44.00,0:07:45.62,Main,,0,0,0,,Bana güvenin!Dialogue: 0,0:07:45.62,0:07:51.42,Main,,0,0,0,,Sunny-go'ya çıkan en kestirme yol bu bölgeyle Ayartan Orman'dan geçmektir!Dialogue: 0,0:07:57.43,0:07:58.91,Main,,0,0,0,,Yapılması gerekeni biliyorsunuz!Dialogue: 0,0:07:58.91,0:08:03.97,Main,,0,0,0,,Mama'nın açlık krizini durdurmanın yegâne yolu,  canı çektiği yemeği temin etmektir!Dialogue: 0,0:08:07.38,0:08:11.11,Main,,0,0,0,,Bize lazım olan... Düğün pastası!Dialogue: 0,0:08:11.11,0:08:16.59,Main,,0,0,0,,Baş aşçı nerede?  Pastayı ondan başkası yapamaz!Dialogue: 0,0:08:16.59,0:08:19.39,Main,,0,0,0,,Ş- Şöyle ki... Streusen-sama...Dialogue: 0,0:08:20.12,0:08:22.39,Main,,0,0,0,,...herkesin hayatını kurtardı kurtarmasına da...Dialogue: 0,0:08:23.89,0:08:27.31,Main,,0,0,0,,...kendisi çok kötü bir yere iniş yaptı.Dialogue: 0,0:08:32.14,0:08:35.61,Main,,0,0,0,,Birkaç güne anca toparlanır!Dialogue: 0,0:08:39.06,0:08:42.96,Main,,0,0,0,,Bu gidişle Tatlı Şehri yerle bir olacak! Grr!Dialogue: 0,0:08:42.96,0:08:46.41,Main,,0,0,0,,Mama'yı nasıl durduracağız?Dialogue: 0,0:08:49.29,0:08:52.87,Main,,0,0,0,,Başkentimizde etrafı yakıp yıkmasına izin veremeyiz!Dialogue: 0,0:09:02.66,0:09:05.34,Main,,0,0,0,,Nerede diyorum?Dialogue: 0,0:09:09.20,0:09:10.78,Main,,0,0,0,,Yoksa...Dialogue: 0,0:09:10.78,0:09:12.76,Main,,0,0,0,,Aklına iyi bir fikir geldi galiba!Dialogue: 0,0:09:12.76,0:09:15.60,Main,,0,0,0,,Perospero-sama'dan da bu beklenirdi! Grr!Dialogue: 0,0:09:17.34,0:09:20.81,Main,,0,0,0,,Mama! Düğün pastası...Dialogue: 0,0:09:20.81,0:09:23.43,Main,,0,0,0,,...sapasağlam duruyor!Dialogue: 0,0:09:26.98,0:09:30.94,Main,,0,0,0,,Fazladan bir pasta daha yaptırmıştık Mama!Dialogue: 0,0:09:32.01,0:09:33.51,Main,,0,0,0,,Peros abi!Dialogue: 0,0:09:33.51,0:09:35.60,Main,,0,0,0,,Dur! Neler zırvalıyorsun?Dialogue: 0,0:09:36.20,0:09:41.37,Main,,0,0,0,,Ö- Özenle seçilmiş malzemelerden yapıldı.Dialogue: 0,0:09:41.37,0:09:44.95,Main,,0,0,0,,Ağızda eriyen bir lezzeti var!Dialogue: 0,0:09:44.95,0:09:48.83,Main,,0,0,0,,En enfes düğün pastası yani!Dialogue: 0,0:09:49.60,0:09:52.40,Main,,0,0,0,,Sana vermeyi çok isterdim...Dialogue: 0,0:09:52.40,0:09:56.53,Main,,0,0,0,,...ama ister inan ister inanma,  Hasır Şapkalar pastayı çaldı!Dialogue: 0,0:09:56.53,0:10:01.70,Main,,0,0,0,,Şu anda güneybatı sahiline gidip kaçmaya çalışıyorlar!Dialogue: 0,0:10:03.43,0:10:05.32,Main,,0,0,0,,Düğün...Dialogue: 0,0:10:05.90,0:10:08.09,Main,,0,0,0,,...pastası...Dialogue: 0,0:10:08.09,0:10:12.44,Main,,0,0,0,,Aynen öyle! Onlar çaldı-perorin!Dialogue: 0,0:10:13.34,0:10:15.91,Thoughts,,0,0,0,,Bir nebze de olsa beni dinlediğini varsayıyorum.Dialogue: 0,0:10:15.91,0:10:20.62,Thoughts,,0,0,0,,Hasır Şapkalar'ın peşine düşerse bir taşla iki kuş vurmuş oluruz!Dialogue: 0,0:10:24.64,0:10:26.92,Thoughts,,0,0,0,,Onu ikna edebilir mi ki?Dialogue: 0,0:10:40.34,0:10:43.51,Main,,0,0,0,,Yalan söylüyorsan...Dialogue: 0,0:10:43.51,0:10:48.06,Main,,0,0,0,,...bedelini ömrünle ödersin!Dialogue: 0,0:10:53.19,0:10:54.26,Main,,0,0,0,,Zeus!Dialogue: 0,0:10:55.20,0:10:56.49,Main,,0,0,0,,Buyur Mama!Dialogue: 0,0:11:06.48,0:11:11.54,Main,,0,0,0,,Düğün pastası!Dialogue: 0,0:11:22.15,0:11:24.07,Main,,0,0,0,,Şimdi sıçtım!Dialogue: 0,0:11:24.07,0:11:29.26,Main,,0,0,0,,Mama, Hasır Şapkalar'ı yakalasa bile ortada bir pasta yok!Dialogue: 0,0:11:29.26,0:11:32.98,Main,,0,0,0,,Ne yapacağım şimdi ben?Dialogue: 0,0:11:30.38,0:11:32.98,Secondary,,0,0,0,,Oldukça akıllıca bir fikir demiştim de...Dialogue: 0,0:11:36.77,0:11:40.38,Main,,0,0,0,,Mama döndüğünde işim bitti!Dialogue: 0,0:11:40.73,0:11:42.59,Main,,0,0,0,,Fakat bize vakit kazandırdın!Dialogue: 0,0:11:42.59,0:11:46.25,Main,,0,0,0,,Bu süre zarfında pastayı yapmalıyız, yoksa geride ada falan da kalmaz!Dialogue: 0,0:11:47.24,0:11:51.84,Main,,0,0,0,,Yapamayız, imkânsız. Bi' düşün Smoothie.Dialogue: 0,0:11:51.84,0:11:58.43,Main,,0,0,0,,Baş aşçı Streusen'in bile o pastayı yapması kaç gününü aldı dersin?Dialogue: 0,0:11:59.09,0:12:04.68,Main,,0,0,0,,Diğer ülkeleri yağmalayıp topladığımız ender malzemeler de kalmadı!Dialogue: 0,0:12:05.05,0:12:10.65,Main,,0,0,0,,Pastayı pişirebilecek kişi de şu an komada! Kalkıp pastayı yapacak hâli yok!Dialogue: 0,0:12:12.15,0:12:18.61,Main,,0,0,0,,Mama'nın pastayı hiç tatmaması ise işi daha da yokuşa sürüyor!Dialogue: 0,0:12:18.61,0:12:20.70,Main,,0,0,0,,Öyleyse bu sefer yaptıracağımız pasta...Dialogue: 0,0:12:22.00,0:12:28.83,Main,,0,0,0,,Mama'nın kafasına daha önce hiç yemediği kadar lezzetli bir pasta fikri yerleşmiş!Dialogue: 0,0:12:28.83,0:12:33.92,Main,,0,0,0,,Bu pastayı yapacak aşçıyı nereden bulacağız?Dialogue: 0,0:12:34.46,0:12:36.38,Main,,0,0,0,,Vaziyet sakat.Dialogue: 0,0:12:36.38,0:12:38.51,Main,,0,0,0,,Bir kere bu adanın yok olacağı su götürmez!Dialogue: 0,0:12:38.51,0:12:41.92,Main,,0,0,0,,Sonrasında yaşanacaklar ise... Tam bir muamma.Dialogue: 0,0:12:55.73,0:12:58.64,Main,,0,0,0,,Yardım edeyim mi?Dialogue: 0,0:13:05.82,0:13:07.28,Main,,0,0,0,,Pudding!Dialogue: 0,0:13:07.28,0:13:09.10,Main,,0,0,0,,Oh, Pudding-sama!Dialogue: 0,0:13:09.10,0:13:10.41,Main,,0,0,0,,Pudding-sama!Dialogue: 0,0:13:10.41,0:13:14.99,Main,,0,0,0,,Bu seferki düğün pastası çikolatalı şifon pastasıydı!Dialogue: 0,0:13:14.99,0:13:19.92,Main,,0,0,0,,Yapacağım çikolatanın baş aşçınınkinden aşağı kalır yanı olmaz!Dialogue: 0,0:13:19.92,0:13:24.84,Main,,0,0,0,,Chiffon ablam ise şifon pastaların piridir!Dialogue: 0,0:13:24.84,0:13:28.88,Main,,0,0,0,,İkimiz el ele verirsek o pastayı yapabiliriz!Dialogue: 0,0:13:28.88,0:13:30.98,Main,,0,0,0,,Emin misin Pudding?Dialogue: 0,0:13:30.98,0:13:35.47,Main,,0,0,0,,Fakat Chiffon şu an düşmanımız olan Bege ile evli!Dialogue: 0,0:13:37.33,0:13:39.63,Main,,0,0,0,,Paşa paşa yapacak!Dialogue: 0,0:13:39.63,0:13:41.39,Main,,0,0,0,,Şeytani Pudding kendini gösterdi!Dialogue: 0,0:13:41.39,0:13:44.90,Main,,0,0,0,,Ne?  Pudding-sama bir haydut gibi davranıyor!Dialogue: 0,0:13:46.49,0:13:49.41,Main,,0,0,0,,İşin aslı, pasta için gereken malzemeler...Dialogue: 0,0:13:49.41,0:13:53.27,Main,,0,0,0,,...bölgemizin girişindeki Çikolata Şehri ile...Dialogue: 0,0:13:53.27,0:13:54.98,Main,,0,0,0,,...Kakao Adası'nda istiflendi.Dialogue: 0,0:13:55.78,0:13:59.12,Main,,0,0,0,,Yani ender malzemelerin arkası duruyor!Dialogue: 0,0:14:00.45,0:14:01.63,Main,,0,0,0,,Peros abi!Dialogue: 0,0:14:01.63,0:14:05.46,Main,,0,0,0,,Mama, Hasır Şapkaları ortadan kaldırınca Çikolata Şehri'ne gelmesini sağla!Dialogue: 0,0:14:06.25,0:14:08.80,Main,,0,0,0,,Gerisini ben hallederim!Dialogue: 0,0:14:09.46,0:14:12.72,Main,,0,0,0,,Gerçekten mi? Çok işimize gelir Pudding!Dialogue: 0,0:14:14.57,0:14:17.72,Main,,0,0,0,,Sanji'nin alay konusu oldum!Dialogue: 0,0:14:17.72,0:14:20.64,Flashbacks,,0,0,0,,Ne güzel bir göz!Dialogue: 0,0:14:21.32,0:14:23.65,Main,,0,0,0,,Madem onlardan kurtulacak...Dialogue: 0,0:14:24.50,0:14:27.27,Main,,0,0,0,,...Mama'ya bir ödül vermezsem olmaz.Dialogue: 0,0:14:32.11,0:14:33.61,Main,,0,0,0,,Sıkı dur!Dialogue: 0,0:14:33.61,0:14:35.04,Main,,0,0,0,,Sanji!Dialogue: 0,0:14:37.40,0:14:38.30,Main,,0,0,0,,Ne oldu?Dialogue: 0,0:14:38.30,0:14:41.26,Main,,0,0,0,,Taşikardi hissettim birden.Dialogue: 0,0:14:41.26,0:14:44.02,Main,,0,0,0,,Yine güzel bir kadın beni andı.Dialogue: 0,0:14:44.02,0:14:46.21,Main,,0,0,0,,Ayartan Orman'ı gördüm!Dialogue: 0,0:14:46.74,0:14:51.08,Main,,0,0,0,,Yine mi şu ormana gireceğiz? Umarım kaybolmayız.Dialogue: 0,0:14:51.96,0:14:53.47,Main,,0,0,0,,Baksanıza, şu da nedir?Dialogue: 0,0:14:55.13,0:14:58.42,Main,,0,0,0,,Yapmasana ya Kin-chan!Dialogue: 0,0:14:58.43,0:15:00.90,Main,,0,0,0,,Bir şeyin yok ya Kin-chan?Dialogue: 0,0:15:00.90,0:15:05.72,Main,,0,0,0,,Anam anam!  Dikiş yeri acıyor-ju Lady Tree.Dialogue: 0,0:15:05.72,0:15:11.48,Main,,0,0,0,,Özür dilerim... Ama çabucak kaynayacaktır. Bizim kaynaştığımız gibi!Dialogue: 0,0:15:11.48,0:15:15.65,Main,,0,0,0,,Anam anam! Biraz nazik ol.Dialogue: 0,0:15:20.45,0:15:22.58,Main,,0,0,0,,Ne? Yok artık! Nasıl ya?Dialogue: 0,0:15:23.49,0:15:25.24,Main,,0,0,0,,Hey!Dialogue: 0,0:15:26.41,0:15:28.12,Main,,0,0,0,,Hey!Dialogue: 0,0:15:28.87,0:15:32.22,Main,,0,0,0,,Yaşıyorsun demek Kingbaum!Dialogue: 0,0:15:33.75,0:15:35.85,Main,,0,0,0,,Seni görmek güzel!Dialogue: 0,0:15:35.85,0:15:37.55,Main,,0,0,0,,Ağaç!Dialogue: 0,0:15:42.05,0:15:43.81,Main,,0,0,0,,Y... Y...Dialogue: 0,0:15:44.68,0:15:47.40,Main,,0,0,0,,Yaklaşmayın!Dialogue: 0,0:15:47.40,0:15:50.80,Main,,0,0,0,,Bunu ödeyeceksiniz, adiler!Dialogue: 0,0:15:50.80,0:15:52.10,Main,,0,0,0,,Kin-chan!Dialogue: 0,0:15:52.10,0:15:54.11,Main,,0,0,0,,Lady Tree!Dialogue: 0,0:15:57.16,0:15:59.37,Main,,0,0,0,,Arkaya bakmak yok! Dümdüz ileri!Dialogue: 0,0:15:59.81,0:16:01.91,Main,,0,0,0,,Hay sıçayım!Dialogue: 0,0:16:01.91,0:16:06.99,Main,,0,0,0,,Ha? Nami, Lola'nın Vivre Kartı'nı elinden aldılar diye biliyordum.Dialogue: 0,0:16:06.99,0:16:09.76,Main,,0,0,0,,Aldılar zaten.  Ama n'olur n'olmaz diye ikiye bölmüştüm.Dialogue: 0,0:16:09.76,0:16:11.04,Main,,0,0,0,,Çok akıllıca!Dialogue: 0,0:16:11.04,0:16:13.27,Main,,0,0,0,,Epey hızlı gidiyoruz!Dialogue: 0,0:16:13.27,0:16:17.12,Main,,0,0,0,,Kendisi Ayartan Orman'nın kralı olduğundan içinden direkt geçebilir!Dialogue: 0,0:16:17.12,0:16:20.57,Main,,0,0,0,,Pekâlâ! Sunny-go'ya tam gaz devam!Dialogue: 0,0:16:20.57,0:16:21.88,Main,,0,0,0,,İleri!Dialogue: 0,0:16:21.88,0:16:27.25,Main,,0,0,0,,Veba gibisiniz ha-ju! Şu ülkeyi terk edin artık-ju!Dialogue: 0,0:16:27.25,0:16:28.71,Main,,0,0,0,,Pardon?Dialogue: 0,0:16:29.68,0:16:32.43,Main,,0,0,0,,Nami-san ne diyorsa onu yap lan!Dialogue: 0,0:16:38.82,0:16:43.83,Main,,0,0,0,,Hedefler önümüzde! Bitirin işlerini!Dialogue: 0,0:16:43.83,0:16:47.04,Main,,0,0,0,,Tamamdır!Dialogue: 0,0:16:48.20,0:16:50.48,Main,,0,0,0,,Arkamıza bakın! Düşmanlar!Dialogue: 0,0:16:51.64,0:16:52.96,Main,,0,0,0,,Hücum!Dialogue: 0,0:16:52.96,0:16:55.52,Main,,0,0,0,,Evet!Dialogue: 0,0:16:56.12,0:16:57.86,Main,,0,0,0,,Hızlan Kingbaum!Dialogue: 0,0:16:57.86,0:16:59.80,Main,,0,0,0,,Tüm gücümle koşuyorum zaten-ju!Dialogue: 0,0:16:59.80,0:17:02.52,Main,,0,0,0,,Sana yetişmelerine izin verirsen dikişlerini tek tek sökerim!Dialogue: 0,0:17:02.52,0:17:03.93,Main,,0,0,0,,Senden korkulur!Dialogue: 0,0:17:08.47,0:17:10.31,Main,,0,0,0,,Üzerimizden bir şey geçti!Dialogue: 0,0:17:13.48,0:17:14.40,Main,,0,0,0,,Bu ses...Dialogue: 0,0:17:14.40,0:17:15.44,Main,,0,0,0,,Yok artık!Dialogue: 0,0:17:18.81,0:17:20.50,Main,,0,0,0,,Ne?Dialogue: 0,0:17:20.50,0:17:27.70,Main,,0,0,0,,Düğün pastası!Dialogue: 0,0:17:28.49,0:17:31.33,Main,,0,0,0,,Big Mom!Dialogue: 0,0:17:35.17,0:17:37.76,Main,,0,0,0,,Pastayı verin!Dialogue: 0,0:17:38.91,0:17:43.70,Main,,0,0,0,,Bu sırada ise Tatlı Şehri'ndeki Meyve Suyu Nehri civarında...Dialogue: 0,0:17:45.66,0:17:50.04,Main,,0,0,0,,Gördüm işte! Meyve Suyu Nehri!Dialogue: 0,0:17:50.04,0:17:53.46,Main,,0,0,0,,Köpek Balığı Denizaltı oraya demir atmış idi.Dialogue: 0,0:17:54.05,0:17:55.84,Main,,0,0,0,,O nehre demek...Dialogue: 0,0:17:58.89,0:18:00.61,Main,,0,0,0,,Ne?Dialogue: 0,0:18:00.61,0:18:03.64,Main,,0,0,0,,Nehir kaymakla dolup taşmış!Dialogue: 0,0:18:03.64,0:18:06.39,Main,,0,0,0,,Kokuya gel!Dialogue: 0,0:18:08.60,0:18:12.38,Main,,0,0,0,,Çok güzel! Afiyet olsun!Dialogue: 0,0:18:13.91,0:18:15.57,Main,,0,0,0,,Acayip güzel!Dialogue: 0,0:18:15.57,0:18:21.95,Main,,0,0,0,,Yıkılan Whole Cake Şatosu'nun enkazının bu kadar uzaklara uçtuğuna inanamıyorum.Dialogue: 0,0:18:23.12,0:18:25.77,Main,,0,0,0,,Oy oy oy! Harika!Dialogue: 0,0:18:25.78,0:18:29.38,Main,,0,0,0,,Ne yapsak ki şimdi?Dialogue: 0,0:18:29.38,0:18:30.83,Main,,0,0,0,,Sana soruyorum Chopper-san!Dialogue: 0,0:18:35.17,0:18:38.09,Main,,0,0,0,,Enfes!Dialogue: 0,0:18:45.48,0:18:48.28,Main,,0,0,0,,Big Mom yaklaşıyor!Dialogue: 0,0:18:49.26,0:18:51.01,Main,,0,0,0,,Mama ne diye ön cepheye geldi ki?Dialogue: 0,0:18:51.01,0:18:53.50,Main,,0,0,0,,Bir de hâline baksanıza... Kendinde değil sanki!Dialogue: 0,0:18:53.92,0:18:56.30,Main,,0,0,0,,Yoksa açlık krizi mi tuttu?Dialogue: 0,0:18:56.30,0:19:00.14,Main,,0,0,0,,Düğün pastası!Dialogue: 0,0:19:00.14,0:19:02.60,Main,,0,0,0,,Kurtul ondan Kingbaum!Dialogue: 0,0:19:02.60,0:19:04.36,Main,,0,0,0,,İmkânsız-ju!Dialogue: 0,0:19:08.08,0:19:12.23,Main,,0,0,0,,Elbaf'ın Mızrağı'nı tadın bakalım!Dialogue: 0,0:19:12.23,0:19:13.52,Main,,0,0,0,,Elbaf mı?Dialogue: 0,0:19:17.23,0:19:19.14,Main,,0,0,0,,Saldıracak!Dialogue: 0,0:19:31.30,0:19:33.40,Main,,0,0,0,,Ikoku!Dialogue: 0,0:19:31.30,0:19:33.40,Attack,,0,0,0,,Şanlı UlusDialogue: 0,0:20:20.36,0:20:23.25,Main,,0,0,0,,Düğün...Dialogue: 0,0:20:23.59,0:20:25.88,Main,,0,0,0,,...pastası!!Dialogue: 0,0:20:25.90,0:20:29.93,Main,,0,0,0,,Devler'in tekniğine benziyordu!Dialogue: 0,0:20:29.93,0:20:32.22,Flashbacks,,0,0,0,,Hakoku!Dialogue: 0,0:20:29.93,0:20:32.22,Attack,,0,0,0,,Savaşçı UlusDialogue: 0,0:20:36.85,0:20:38.02,Main,,0,0,0,,Ne alaka?Dialogue: 0,0:20:38.89,0:20:40.81,Main,,0,0,0,,Kingbaum!Dialogue: 0,0:20:45.19,0:20:49.99,Main,,0,0,0,,Mama! Bağışla beni-ju! Tehdit edildim-ju!Dialogue: 0,0:20:52.28,0:20:56.01,Main,,0,0,0,,Olamaz! Bir saldırı daha gelecek! İnip savaşalım!Dialogue: 0,0:20:56.01,0:21:00.63,Main,,0,0,0,,Kingbaum! Demin yanındaki kız kimdi? Kız arkadaşın mı?Dialogue: 0,0:21:02.42,0:21:05.53,Flashbacks,,0,0,0,,Yapmasana ya Kin-chan!Dialogue: 0,0:21:05.53,0:21:08.09,Flashbacks,,0,0,0,,Bir şeyin yok ya Kin-chan?Dialogue: 0,0:21:08.09,0:21:09.70,Flashbacks,,0,0,0,,Kin-chan!Dialogue: 0,0:21:09.70,0:21:11.64,Flashbacks,,0,0,0,,Lady Tree!Dialogue: 0,0:21:12.13,0:21:15.03,Main,,0,0,0,,N- Nişanlım olur-ju.Dialogue: 0,0:21:15.03,0:21:17.85,Main,,0,0,0,,Of ya! Nişanlılar mı?Dialogue: 0,0:21:18.90,0:21:23.15,Main,,0,0,0,,Evet-ju! Ebediyen birlikte olacağımıza ant içtik-ju!Dialogue: 0,0:21:23.16,0:21:25.15,Main,,0,0,0,,Öyleyse...Dialogue: 0,0:21:25.15,0:21:27.82,Main,,0,0,0,,...hayatta kalmalısın!Dialogue: 0,0:21:30.44,0:21:33.10,Main,,0,0,0,,O kadın uğruna hayatta kal!Dialogue: 0,0:21:33.10,0:21:35.45,Main,,0,0,0,,Onu tekrar görebilmek için!Dialogue: 0,0:21:44.21,0:21:48.07,Main,,0,0,0,,Haklısın-ju! Burada ölme lüksüm yok!Dialogue: 0,0:21:48.07,0:21:50.25,Main,,0,0,0,,Koş Kingbaum!Dialogue: 0,0:21:50.25,0:21:54.54,Main,,0,0,0,,O kadınla yepyeni bir hayat ileride yatıyor!Dialogue: 0,0:21:54.54,0:21:58.26,Main,,0,0,0,,Sevdayla dolup taşan bir gelecek var önünde!Dialogue: 0,0:21:59.47,0:22:01.93,Main,,0,0,0,,Lady Tree!Dialogue: 0,0:22:02.73,0:22:04.02,Main,,0,0,0,,Güzel!Dialogue: 0,0:22:05.02,0:22:06.70,Main,,0,0,0,,Bu kadından korkulur...Dialogue: 0,0:22:06.70,0:22:08.34,Main,,0,0,0,,Nami'den de bu beklenirdi!Dialogue: 0,0:22:08.34,0:22:11.21,Main,,0,0,0,,Pastayı verin!Dialogue: 0,0:22:11.21,0:22:12.97,Main,,0,0,0,,Pekâlâ, şimdi benim sıram!Dialogue: 0,0:22:12.97,0:22:16.08,Main,,0,0,0,,Bekle Luffy! Bir planım var!Dialogue: 0,0:22:16.08,0:22:18.31,Main,,0,0,0,,Düğün...Dialogue: 0,0:22:18.31,0:22:19.91,Main,,0,0,0,,N'apacaksın?Dialogue: 0,0:22:22.12,0:22:23.85,Main,,0,0,0,,...pastası!Dialogue: 0,0:22:23.85,0:22:25.62,Main,,0,0,0,,Black Ball!Dialogue: 0,0:22:23.85,0:22:25.62,Attack,,0,0,0,,Kara TopDialogue: 0,0:22:30.84,0:22:33.49,Main,,0,0,0,,Fırtına bulutları birbirini çekermiş!Dialogue: 0,0:22:33.49,0:22:35.18,Main,,0,0,0,,Ikoku!Dialogue: 0,0:22:33.49,0:22:35.18,Attack,,0,0,0,,Şanlı UlusDialogue: 0,0:22:41.31,0:22:42.33,Main,,0,0,0,,İşte bu!Dialogue: 0,0:22:42.33,0:22:44.00,Main,,0,0,0,,Onları yiyor!Dialogue: 0,0:22:44.00,0:22:47.23,Main,,0,0,0,,Leziz! Leziz! Leziz ya!Dialogue: 0,0:22:49.65,0:22:51.40,Main,,0,0,0,,Olamaz! Mama!Dialogue: 0,0:22:52.61,0:22:55.03,Main,,0,0,0,,Durun!Dialogue: 0,0:22:55.04,0:22:57.66,Main,,0,0,0,,N'apıyorsun be Zeus?Dialogue: 0,0:22:58.11,0:23:00.60,Main,,0,0,0,,Eyvah, kendini kaybetti.Dialogue: 0,0:23:00.60,0:23:04.52,Main,,0,0,0,,Ayartan Orman'a doğru kaçıyorlar!Dialogue: 0,0:23:04.52,0:23:07.96,Main,,0,0,0,,Düğün pastası!Dialogue: 0,0:23:07.96,0:23:11.67,Main,,0,0,0,,Ormana adımımızı attık mı avantaj bizde!Dialogue: 0,0:23:13.80,0:23:16.68,Main,,0,0,0,,En nihayetinde Kingbaum...Dialogue: 0,0:23:17.43,0:23:19.64,Main,,0,0,0,,...bu ormanın efendisidir!Dialogue: 0,0:23:19.64,0:23:21.62,Main,,0,0,0,,Kingbaum-sama!Dialogue: 0,0:23:21.62,0:23:24.75,Main,,0,0,0,,Kingbaum-sama geliyor!Dialogue: 0,0:23:24.75,0:23:27.11,Main,,0,0,0,,Çekilin yolumdan!Dialogue: 0,0:23:32.90,0:23:34.45,Main,,0,0,0,,İnanılmaz!Dialogue: 0,0:23:34.45,0:23:35.60,Main,,0,0,0,,İnanmıyorum...Dialogue: 0,0:23:35.60,0:23:37.40,Main,,0,0,0,,Helalin var Koca Ağaç.Dialogue: 0,0:23:38.32,0:23:40.41,Main,,0,0,0,,Çekilin! Çekilin! Çekilin lan!Dialogue: 0,0:23:49.34,0:23:52.44,Main,,0,0,0,,Bakın! Sunny-go'yu gördüm!Dialogue: 0,0:23:52.44,0:23:53.00,Main,,0,0,0,,Ne?Dialogue: 0,0:23:53.00,0:23:55.65,Main,,0,0,0,,Sahile çıkan düz bir patika.Dialogue: 0,0:23:55.65,0:23:58.59,Main,,0,0,0,,Planın harikaymış Nami!Dialogue: 0,0:23:58.59,0:24:01.64,Main,,0,0,0,,Nami-swan'a da bu yakışırdı!Dialogue: 0,0:24:05.80,0:24:09.61,Main,,0,0,0,,Zeus'a binmediği sürece Big Mom'ı kuyruğumuzdan silkebiliriz!Dialogue: 0,0:24:09.61,0:24:11.24,Main,,0,0,0,,Adı Zeus mu?Dialogue: 0,0:24:11.24,0:24:15.24,Main,,0,0,0,,Evet, o bulut Mama'nın ruhundan var edilmiştir.Dialogue: 0,0:24:15.24,0:24:16.91,Main,,0,0,0,,Evet, bendeniz Zeus.Dialogue: 0,0:24:16.91,0:24:18.46,Main,,0,0,0,,Zeus-sama!Dialogue: 0,0:24:18.46,0:24:19.40,Main,,0,0,0,,Zeus!Dialogue: 0,0:24:19.40,0:24:20.04,Main,,0,0,0,,Yetişti!Dialogue: 0,0:24:20.04,0:24:22.34,Main,,0,0,0,,Dikkatli olun! Çok güçlüdür!Dialogue: 0,0:24:22.34,0:24:27.45,Main,,0,0,0,,Baksanıza ya,  şu fırtına bulutlarından biraz daha istiyorum!Dialogue: 0,0:24:28.15,0:24:29.28,Main,,0,0,0,,Ne?Dialogue: 0,0:24:30.49,0:24:33.35,Main,,0,0,0,,Kara Top mu? Tatları güzel miydi?Dialogue: 0,0:24:33.35,0:24:38.71,Main,,0,0,0,,Boğazımdan kayıp geçen bu denli leziz fırtına bulutları yememiştim hiç!Dialogue: 0,0:24:38.71,0:24:40.81,Main,,0,0,0,,Arkası var mı onların?Dialogue: 0,0:24:40.81,0:24:43.59,Main,,0,0,0,,Tatları güzeldi yani?Dialogue: 0,0:24:48.97,0:24:50.95,Main,,0,0,0,,Yumuşacık!Dialogue: 0,0:24:50.95,0:24:54.28,Main,,0,0,0,,Verin hadi, biraz daha verin!Dialogue: 0,0:24:54.28,0:24:57.35,Main,,0,0,0,,Bana bak bulut! Onu boş ver de gezdir bizi!Dialogue: 0,0:24:57.35,0:25:03.00,Main,,0,0,0,,Yapamam. Ruhundan bir parça veren Mama'dan başkası üzerime binemez.Dialogue: 0,0:25:03.00,0:25:05.46,Main,,0,0,0,,Aman be, sıradan bi' bulutmuşsun işte.Dialogue: 0,0:25:05.46,0:25:07.53,Main,,0,0,0,,Harbi sıradanmışsın.Dialogue: 0,0:25:07.53,0:25:10.07,Main,,0,0,0,,Zeus... O zaman...Dialogue: 0,0:25:11.95,0:25:14.55,Main,,0,0,0,,...hizmetkârım olur musun?Dialogue: 0,0:25:14.55,0:25:15.64,Main,,0,0,0,,Ne?Dialogue: 0,0:25:15.64,0:25:17.39,Main,,0,0,0,,Seve seve!Dialogue: 0,0:25:17.39,0:25:19.63,Main,,0,0,0,,Sana sormuyor.Dialogue: 0,0:25:19.63,0:25:23.23,Main,,0,0,0,,Her gün istediğin kadar Kara Top'lardan yiyebilirsin!Dialogue: 0,0:25:23.23,0:25:27.73,Main,,0,0,0,,Ne? Sahi mi? Ne yapsam ki? N'apsam ki?Dialogue: 0,0:25:27.73,0:25:30.37,Main,,0,0,0,,Patronuna hiç mi sadakatin yok?Dialogue: 0,0:25:31.34,0:25:36.29,Main,,0,0,0,,Eminim ki tüm semayı kaplayan dev bir fırtına bulutuna dönüşebilirsin!Dialogue: 0,0:25:36.29,0:25:38.66,Main,,0,0,0,,Harika olurdun var ya!Dialogue: 0,0:25:38.66,0:25:40.80,Main,,0,0,0,,Cidden mi?Dialogue: 0,0:25:40.80,0:25:44.10,Main,,0,0,0,,Hiç böyle iltifatlar almamıştım!Dialogue: 0,0:26:08.14,0:26:10.35,Main,,0,0,0,,M-Mama...Dialogue: 0,0:26:10.93,0:26:12.48,Main,,0,0,0,,Mama!Dialogue: 0,0:26:13.10,0:26:15.90,Main,,0,0,0,,Ayartan Orman!Dialogue: 0,0:26:16.94,0:26:19.44,Main,,0,0,0,,Yollarını kapatın!Dialogue: 0,0:26:30.37,0:26:33.13,Main,,0,0,0,,Eyvah! Mama'yı kızdırdım!Dialogue: 0,0:26:37.21,0:26:39.67,Main,,0,0,0,,Yine sinir bozucu orman oldu!Dialogue: 0,0:26:40.80,0:26:43.68,Main,,0,0,0,,Canlarına okuyup dosdoğru ilerleyemez miyiz ki?Dialogue: 0,0:26:43.70,0:26:45.21,Main,,0,0,0,,Yapamayız!Dialogue: 0,0:26:45.21,0:26:50.12,Main,,0,0,0,,Bu ormanda gözünü karartıp saldırırken tüm yön algını yitirirsin!Dialogue: 0,0:26:50.12,0:26:54.57,Main,,0,0,0,,Evet. Bu orman insanların kafasını karıştırır.Dialogue: 0,0:27:01.86,0:27:05.54,Main,,0,0,0,,Kraliçe varken benim emirlerimi kimse iplemez-ju!Dialogue: 0,0:27:11.70,0:27:12.88,Main,,0,0,0,,Fakat...Dialogue: 0,0:27:15.37,0:27:17.44,Main,,0,0,0,,Lady Tree!Dialogue: 0,0:27:17.44,0:27:19.02,Main,,0,0,0,,Durun!Dialogue: 0,0:27:19.02,0:27:23.06,Main,,0,0,0,,Sevdiceğin ve geleceğin için dört nala koş!Dialogue: 0,0:27:25.34,0:27:27.49,Main,,0,0,0,,Mama'nın emri var! Durdurun onları!Dialogue: 0,0:27:27.49,0:27:29.36,Main,,0,0,0,,Çekilin lan!Dialogue: 0,0:27:29.36,0:27:32.24,Main,,0,0,0,,Burada ölecek değilim-ju!Dialogue: 0,0:27:32.24,0:27:35.19,Main,,0,0,0,,Bunu neden yapıyorsunuz Kingbaum-sama?!Dialogue: 0,0:27:38.14,0:27:40.91,Main,,0,0,0,,Yürü be Kingbaum!Dialogue: 0,0:27:44.53,0:27:46.40,Main,,0,0,0,,Sıkı tutun!Dialogue: 0,0:27:46.40,0:27:47.09,Main,,0,0,0,,Metin.Dialogue: 0,0:27:47.09,0:27:49.38,Main,,0,0,0,,Ağaç! Durayım deme!Dialogue: 0,0:27:50.62,0:27:52.96,Main,,0,0,0,,Gomu Gomu no...Dialogue: 0,0:27:52.96,0:27:55.88,Main,,0,0,0,,Gatling!Dialogue: 0,0:27:52.96,0:27:55.88,Attack,,0,0,0,,...Mitralyöz!Dialogue: 0,0:28:18.03,0:28:20.57,Main,,0,0,0,,Amma kullanışlı yetenekmiş.Dialogue: 0,0:28:24.33,0:28:26.63,Main,,0,0,0,,Bi' sıcak bastı! N'oluyor?Dialogue: 0,0:28:26.64,0:28:28.12,Main,,0,0,0,,Bu...Dialogue: 0,0:28:39.51,0:28:42.03,Main,,0,0,0,,Prometheus-sama!Dialogue: 0,0:28:42.03,0:28:44.28,Main,,0,0,0,,Küplere binmiş!Dialogue: 0,0:28:44.28,0:28:48.23,Main,,0,0,0,,Bak hele Kingbaum.Dialogue: 0,0:28:50.56,0:28:53.49,Main,,0,0,0,,Mama'ya ihanet ettin...Dialogue: 0,0:28:54.90,0:28:57.88,Main,,0,0,0,,P- Prometheus-sama!Dialogue: 0,0:28:57.88,0:28:59.53,Main,,0,0,0,,Çok sıcak!Dialogue: 0,0:29:00.00,0:29:02.87,Main,,0,0,0,,Yaklaşıyor!Dialogue: 0,0:29:02.87,0:29:04.60,Main,,0,0,0,,Üzerimize çökmeye mi çalışıyor?Dialogue: 0,0:29:04.60,0:29:06.59,Main,,0,0,0,,Kingbaum, uzaklaş!Dialogue: 0,0:29:13.88,0:29:18.60,Main,,0,0,0,,Kingbaum, kaç! Nişanlın seni beklemiyor mu?Dialogue: 0,0:29:24.36,0:29:25.96,Main,,0,0,0,,Dondu kaldı! İnelim!Dialogue: 0,0:29:39.34,0:29:40.48,Main,,0,0,0,,Kaç!Dialogue: 0,0:29:40.48,0:29:41.82,Main,,0,0,0,,Nami! Gitmeliyiz!Dialogue: 0,0:29:41.82,0:29:42.94,Main,,0,0,0,,Nami-san!Dialogue: 0,0:29:42.94,0:29:44.82,Main,,0,0,0,,Sen-gara da yaralanacaksın!Dialogue: 0,0:29:44.82,0:29:46.35,Main,,0,0,0,,Nami!Dialogue: 0,0:30:01.45,0:30:02.93,Main,,0,0,0,,Ağaç!Dialogue: 0,0:30:05.04,0:30:06.75,Main,,0,0,0,,Kingbaum...Dialogue: 0,0:30:07.84,0:30:08.93,Main,,0,0,0,,Nami-san!Dialogue: 0,0:30:22.30,0:30:27.60,Main,,0,0,0,,Düğün pastası!Dialogue: 0,0:30:31.77,0:30:32.91,Main,,0,0,0,,Bege nerede?Dialogue: 0,0:30:32.91,0:30:34.92,Main,,0,0,0,,Birazdan ona yetişiriz!Dialogue: 0,0:30:34.92,0:30:37.86,Main,,0,0,1,,Ayartan Orman'da yangın çıkmış.Dialogue: 0,0:30:36.50,0:30:39.96,Captions,,0,0,170,,Tatlı Şehri, BaşkentDialogue: 0,0:30:37.86,0:30:39.95,Main,,0,0,1,,Mama cenk ediyor sanırım.Dialogue: 0,0:30:40.90,0:30:44.01,Main,,0,0,0,,Ayna Dünyası'ndan rapor veriyorum.  Mont d'Or!Dialogue: 0,0:30:44.01,0:30:49.07,Main,,0,0,0,,Her an dilediğimiz yere göndermeye hazır 10 bin askerimiz var!Dialogue: 0,0:30:44.10,0:30:49.35,Captions,,0,1010,350,,Ayna DünyasıDialogue: 0,0:30:51.92,0:30:54.88,Main,,0,0,0,,Anlaşıldı. İrtibatta kalacağız.Dialogue: 0,0:30:54.88,0:30:58.70,Main,,0,0,0,,Şeker, Bisküvi ve Çerez.Dialogue: 0,0:30:58.70,0:31:03.97,Main,,0,0,0,,Bu adalardaki savaş gemileri Hasır Şapkalar'ın demir attığı güneybatı kıyısını gözetlesin.Dialogue: 0,0:31:03.97,0:31:06.36,Main,,0,0,0,,Demir almalarına sakın izin vermeyin!Dialogue: 0,0:31:06.36,0:31:07.41,Main,,0,0,0,,Emredersiniz!Dialogue: 0,0:31:07.41,0:31:11.65,Main,,0,0,0,,Karşılaşacakları ilk engel sizin kuşatmanız olacak.Dialogue: 0,0:31:11.65,0:31:16.84,Main,,0,0,0,,Ardından ise Aroma Adası ile Likör Adası'ndaki turta gemileri gelecek!Dialogue: 0,0:31:16.84,0:31:20.53,Main,,0,0,0,,Hazırlanıp limanda bekleyin.Dialogue: 0,0:31:20.53,0:31:24.05,Main,,0,0,0,,Mıntıka Sümüklü Böcekleri'nin uyarı sinyallerini bekleyin.Dialogue: 0,0:31:24.05,0:31:25.24,Main,,0,0,0,,Anlaşıldı.Dialogue: 0,0:31:27.82,0:31:33.50,Main,,0,0,0,,Mıntıka Sümüklü Böcekleri'nin güvenlik ağından kaçamazlar.Dialogue: 0,0:31:34.12,0:31:38.13,Captions,,0,0,0,,Güneybatı Kıyısı, Sunny-goDialogue: 0,0:31:38.13,0:31:40.11,Main,,0,0,0,,Ormanda patırtı kopuyor.Dialogue: 0,0:31:40.11,0:31:41.83,Main,,0,0,0,,Ona ne şüphe!Dialogue: 0,0:31:43.38,0:31:49.97,Main,,0,0,0,,Mama bizzat peşlerine düştüğünden buraya hayatta varamazlar.Dialogue: 0,0:31:49.97,0:31:51.66,Main,,0,0,0,,Bence de.Dialogue: 0,0:31:51.66,0:31:55.56,Main,,0,0,0,,Öyleyse neden pusu kuruyoruz efendim?Dialogue: 0,0:31:56.39,0:31:58.73,Main,,0,0,0,,N'olur n'olmaz.Dialogue: 0,0:32:04.40,0:32:07.38,Main,,0,0,0,,Turta Tankları ile peşimizdeler!Dialogue: 0,0:32:07.38,0:32:08.74,Main,,0,0,0,,Ateş!Dialogue: 0,0:32:11.82,0:32:15.79,Main,,0,0,0,,Yakında sahile varmış oluruz! Bizi yakalayamazlar!Dialogue: 0,0:32:17.17,0:32:18.76,Main,,0,0,0,,Bege enişte!Dialogue: 0,0:32:18.76,0:32:20.86,Main,,0,0,0,,Oha! Korktum ha!Dialogue: 0,0:32:22.00,0:32:27.11,Main,,0,0,0,,Pudding-sa... Pudding! Genç bir kız olsan da benden merhamet göremezsin!Dialogue: 0,0:32:27.11,0:32:31.60,Main,,0,0,0,,Chiffon ablamla konuşmam gerek! Görüştür bizi!Dialogue: 0,0:32:33.55,0:32:35.73,Main,,0,0,0,,Chiffon abla! Neredesin?Dialogue: 0,0:32:38.35,0:32:40.54,Main,,0,0,0,,Pudding! Burada ne işin var?Dialogue: 0,0:32:40.54,0:32:41.73,Main,,0,0,0,,Abla!Dialogue: 0,0:32:41.73,0:32:44.94,Main,,0,0,0,,Yardımın lazım!Dialogue: 0,0:32:44.94,0:32:48.18,Main,,0,0,0,,Mama'nın yine Açlık Krizi tuttu!Dialogue: 0,0:32:48.28,0:32:51.61,Main,,0,0,0,,Düğün pastası istiyor!Dialogue: 0,0:32:52.28,0:32:54.47,Main,,0,0,0,,Açlık Krizi mi baş gösterdi?Dialogue: 0,0:32:54.47,0:32:59.24,Main,,0,0,0,,Evet, istediği düğün pastası da çikolatalı şifon pastası!Dialogue: 0,0:32:59.24,0:33:01.88,Main,,0,0,0,,Anlamışsındır sanırım.Dialogue: 0,0:33:03.79,0:33:07.07,Main,,0,0,0,,Şifon pastama ihtiyacın var yani.Dialogue: 0,0:33:07.07,0:33:13.46,Main,,0,0,0,,Benim çikolatamla şifon pastanı harmanlarsak...Dialogue: 0,0:33:13.46,0:33:17.30,Main,,0,0,0,,...Mama'nın beğeneceğini bir düğün pastası yapabiliriz!Dialogue: 0,0:33:17.30,0:33:21.73,Main,,0,0,0,,Pastayı yedirdik mi kendine gelmesini sağlayabiliriz!Dialogue: 0,0:33:28.90,0:33:30.73,Main,,0,0,0,,Üzgünüm Pudding...Dialogue: 0,0:33:30.73,0:33:34.40,Main,,0,0,0,,Tıpkı Lola gibi bu ülkeyi terk ediyorum.Dialogue: 0,0:33:34.40,0:33:38.47,Main,,0,0,0,,Ne bu ülkeye ne de Mama'ya olacakları zerre önemsemiyorum artık.Dialogue: 0,0:33:38.47,0:33:41.56,Main,,0,0,0,,Ha şunu bileydin! Hadi uza şimdi Pudding!Dialogue: 0,0:33:41.56,0:33:43.00,Main,,0,0,0,,Yanlış anladın...Dialogue: 0,0:33:50.09,0:33:52.96,Main,,0,0,0,,Asıl amacım...Dialogue: 0,0:33:52.96,0:33:56.68,Main,,0,0,0,,...Mama'yı veya bu ülkeyi kurtarmak değil!Dialogue: 0,0:34:00.75,0:34:04.04,Main,,0,0,0,,Mama'yı bir an önce durdurmazsam...Dialogue: 0,0:34:06.00,0:34:07.59,Main,,0,0,0,,...o adamla...Dialogue: 0,0:34:07.59,0:34:11.38,Main,,0,0,0,,...arkadaşları ölecek!Dialogue: 0,0:34:11.38,0:34:14.40,Credits,,0,0,0,,Editing:  Feeso, Galaxy 9000  Timing: Galaxy 9000  Quality Assurance: Feeso, Galaxy 9000, Grug, Pepperjack  Soundtracking:  Halee  Graphics:  Datenshi  Karaoke: KaitouYahiko  Translation: Crunchyroll