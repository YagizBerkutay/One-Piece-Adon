Dialogue: 0,0:01:38.18,0:01:42.88,Title,,0,0,0,,{\pos(640, 450)\an5\fad(400,0)}Kötü Son Müzikali
Dialogue: 0,0:01:43.65,0:01:45.14,Main,,0,0,0,,Ateş!
Dialogue: 0,0:01:49.63,0:01:51.79,Main,,0,0,0,,Çizik bile almıyorlar lan!
Dialogue: 0,0:01:51.79,0:01:54.10,Main,,0,0,0,,Ne biçim vücutları var?
Dialogue: 0,0:01:55.02,0:01:56.44,Main,,0,0,0,,Sanji!
Dialogue: 0,0:01:56.86,0:02:00.40,Main,,0,0,0,,Yaralı arkadaşını da alıp\Nadadan ayrıl hemen.
Dialogue: 0,0:02:01.02,0:02:03.14,Main,,0,0,0,,Ayak bağı oluyorsun.
Dialogue: 0,0:02:03.14,0:02:04.99,Main,,0,0,0,,Bizi tongaya bastırmışlardı.
Dialogue: 0,0:02:04.99,0:02:07.24,Main,,0,0,0,,Hesabını verecekler!
Dialogue: 0,0:02:07.24,0:02:12.86,Main,,0,0,0,,Bu adanın tamamı\NGerma 66'nın avıdır artık Sanji!
Dialogue: 0,0:02:12.86,0:02:14.26,Main,,0,0,0,,Çocuklar!
Dialogue: 0,0:02:14.77,0:02:18.34,Main,,0,0,0,,Çelikten ciltleri olan hamuruyla oynanmış\Ninsanlar oldukları gerçek miymiş ya?
Dialogue: 0,0:02:18.34,0:02:19.97,Main,,0,0,0,,Bazuka getirin bana!
Dialogue: 0,0:02:23.65,0:02:26.28,Main,,0,0,0,,Germa!
Dialogue: 0,0:02:26.28,0:02:30.61,Main,,0,0,0,,Geberip gittiğinizi sanmıştım!\NNasıl hayatta kaldınız?
Dialogue: 0,0:02:30.61,0:02:32.03,Main,,0,0,0,,Ne demek istiyorsun?
Dialogue: 0,0:02:32.03,0:02:37.91,Main,,0,0,0,,Nusstorte önderliğinde on bin asker\Nkrallığınızı ele geçirmişti!
Dialogue: 0,0:02:37.91,0:02:43.99,Main,,0,0,0,,Sahi, bir haşere ordusu üzerimize\Nçullanmıştı da hepsini denize döktük.
Dialogue: 0,0:02:43.99,0:02:45.09,Main,,0,0,0,,Ne?
Dialogue: 0,0:02:46.00,0:02:49.77,Main,,0,0,0,,M- Mont d'Or konuşuyor! Cevap verin!
Dialogue: 0,0:02:49.77,0:02:53.27,Main,,0,0,0,,{\i1}Nusstorte abi! Cevap ver lütfen!
Dialogue: 0,0:02:53.27,0:02:57.47,Main,,0,0,0,,{\i1}Bassquarte abi! Dosmarche abi!{\i0}
Dialogue: 0,0:02:57.47,0:03:00.95,Main,,0,0,0,,{\i1}Biri cevap versin ya!
Dialogue: 0,0:03:00.95,0:03:04.70,Main,,0,0,0,,Düşündüğüm gibi,\NPekoms'un ihaneti de olmak üzere...
Dialogue: 0,0:03:04.70,0:03:07.96,Main,,0,0,0,,...ummadık taşlar\Nbaşımızı yarıp duruyor-{\i1}vous plaît{\i0}!
Dialogue: 0,0:03:07.96,0:03:14.04,Main,,0,0,0,,Germa'nın filosu nasıl oldu da\NKakao Adası'nda ortaya çıkıverdi-{\i1}noir{\i0}?
Dialogue: 0,0:03:14.04,0:03:18.92,Main,,0,0,0,,Siz dangalaklar, \Nilmî teknolojimizle ne halt yapacaktınız ki?
Dialogue: 0,0:03:18.92,0:03:21.36,Main,,0,0,0,,Bir bok beceremezdiniz!
Dialogue: 0,0:03:22.53,0:03:25.51,Main,,0,0,0,,Piç kuruları!
Dialogue: 0,0:03:25.51,0:03:28.13,Main,,0,0,0,,Sanji! Git artık!
Dialogue: 0,0:03:28.13,0:03:29.14,Main,,0,0,0,,Tamam!
Dialogue: 0,0:03:30.32,0:03:34.53,Main,,0,0,0,,Snacklar'ın filosu Germa'nın\Nyoğun saldırısına maruz kalıyor!
Dialogue: 0,0:03:34.53,0:03:36.52,Main,,0,0,0,,N'apıyoruz?\NYardıma gitmiyor muyuz?
Dialogue: 0,0:03:36.52,0:03:41.71,Main,,0,0,0,,Dikkatiniz dağılmasın! \NHasır Şapka'nın gemisine odaklanmalıyız!
Dialogue: 0,0:03:42.17,0:03:44.81,Main,,0,0,0,,Adayı çevreleyen\Ntüm gemilere bunu ilet!
Dialogue: 0,0:03:44.81,0:03:45.90,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:03:48.02,0:03:52.84,Main,,0,0,0,,Mont d'Or dingilleri \NGerma'nın oltasına düşmüş olmalılar!
Dialogue: 0,0:03:52.84,0:03:55.44,Main,,0,0,0,,Sen de pek farklı bir durumda\Ndeğilsin hani Daifuku abi.
Dialogue: 0,0:03:55.44,0:03:59.77,Main,,0,0,0,,Götümü yırtıp\Nsize yetişmesini bildim ama!
Dialogue: 0,0:04:02.04,0:04:04.46,Captions,,0,0,10,,{\fad(500,0)}Yer Fıstığı Şehri - Çerez Adası
Dialogue: 0,0:04:04.46,0:04:07.62,Main,,0,0,0,,Mama'nın Açlık Krizi henüz dinmiş değil!
Dialogue: 0,0:04:07.62,0:04:10.42,Main,,0,0,0,,Ömürlerimizden feragat etmek karşılığında...
Dialogue: 0,0:04:10.42,0:04:12.94,Main,,0,0,0,,...korunup kollanacağımızı vadeden\Nbir Yonkou'nun himayesinde yaşıyoruz oysa.
Dialogue: 0,0:04:12.94,0:04:16.31,Main,,0,0,0,,Kendi ülkesini yerle bir ettiğine\Ninanamıyorum.
Dialogue: 0,0:04:16.55,0:04:22.57,Captions,,0,0,10,,{\fad(500,500)}Baklagil Şehri - Çıtır Adası
Dialogue: 0,0:04:16.31,0:04:19.57,Main,,0,0,0,,{\an8}Usta aşçı Streusen-sama'nın bile\Ngünlerini alan...
Dialogue: 0,0:04:19.57,0:04:24.70,Main,,0,0,0,,{\an8}...bir düğün pastasını\Nyeniden yapmaları mümkün değil!
Dialogue: 0,0:04:24.70,0:04:30.62,Main,,0,0,0,,Pudding-{\i1}sama{\i0} bile o pastayı\Nbirkaç saat içerisinde yapamaz!
Dialogue: 0,0:04:30.75,0:04:34.37,Captions,,0,0,5,,{\fad(500,0)}Masa Şehri - Sofra Takımı Adası
Dialogue: 0,0:04:30.62,0:04:34.37,Main,,0,0,0,,{\an8}Mama'nın ağzının suyunu akıtacak bir pasta...
Dialogue: 0,0:04:34.37,0:04:36.06,Main,,0,0,0,,Akıl işi değil!
Dialogue: 0,0:04:36.06,0:04:38.38,Main,,0,0,0,,Adadan kaçmaya hazırlanmalıyız!
Dialogue: 0,0:04:38.63,0:04:44.13,Captions,,0,0,10,,{\fad(500,500)}Şerbet Şehri - Dondurma Adası
Dialogue: 0,0:04:41.88,0:04:45.87,Main,,0,0,5,,{\an8}Mama dönmeden evvel kaçıp gidelim!
Dialogue: 0,0:04:45.87,0:04:47.78,Main,,0,0,0,,Mama şu an nerede ki?
Dialogue: 0,0:04:47.78,0:04:49.15,Main,,0,0,0,,Kabartma Adası'nda!
Dialogue: 0,0:04:49.15,0:04:52.52,Main,,0,0,0,,Kabartma Bakanı Chiffon-sama'nın\Nhimayesindeki ada.
Dialogue: 0,0:04:52.52,0:04:55.72,Main,,0,0,0,,{\an8}Açlık Krizi nüksetmiş Mama\Nadamıza geliyor!
Dialogue: 0,0:04:53.14,0:04:57.40,Captions,,0,10,10,,{\fad(500,0)}Kabartma Adası
Dialogue: 0,0:04:55.72,0:04:57.40,Main,,0,0,0,,{\an8}Onu hiçbir şey durduramaz artık!
Dialogue: 0,0:04:57.40,0:04:59.08,Main,,0,0,0,,Chiffon-{\i1}sama{\i}...
Dialogue: 0,0:04:59.08,0:05:02.36,Main,,0,0,0,,Pastayı niye şehrimize getirdi ki?
Dialogue: 0,0:05:02.58,0:05:04.78,Main,,0,0,0,,Kaçın!
Dialogue: 0,0:05:11.49,0:05:13.59,Main,,0,0,0,,Baksana Jinbe!
Dialogue: 0,0:05:13.59,0:05:19.14,Main,,0,0,0,,Germa hakkındaki düşüncen nedir?\NHasmımız mı müttefikimiz mi?
Dialogue: 0,0:05:19.14,0:05:23.73,Main,,0,0,0,,Kaçma fırsatını tepip ne diye\Nyardıma gelme zahmetine girdiler ki?
Dialogue: 0,0:05:23.73,0:05:29.48,Main,,0,0,0,,Ama yalnızca şimdilik bize arka çıkıyorlar,\Ndeğil mi? Elemanlara nasıl güveneceğiz ki?
Dialogue: 0,0:05:29.48,0:05:32.65,Main,,0,0,0,,Dur biraz! Belki Reiju-{\i1}san{\i0}\Nşahsıma külodunu göstermek için--
Dialogue: 0,0:05:41.01,0:05:42.62,Main,,0,0,0,,{\i1}Hey, sesimi alıyor musunuz?
Dialogue: 0,0:05:42.62,0:05:46.79,Main,,0,0,0,,Sanji! \NAdaya bundan daha fazla yaklaşamayız!
Dialogue: 0,0:05:46.79,0:05:50.58,Main,,0,0,0,,{\i1}Biliyorum! \NLimandan olağan hızınızla yelken alın!
Dialogue: 0,0:05:50.58,0:05:53.48,Main,,0,0,0,,{\i1}Ben de bu sırada yetişirim!
Dialogue: 0,0:05:53.48,0:05:55.13,Main,,0,0,0,,Sanji-kun!\NLuffy'den yana durum nedir?
Dialogue: 0,0:05:55.15,0:06:00.01,Main,,0,0,0,,Sırtımda! Şu an vaktim yok!\NNami-{\i1}san{\i0}, size güveniyorum!
Dialogue: 0,0:06:00.01,0:06:00.97,Main,,0,0,0,,{\i1}Tamamdır!
Dialogue: 0,0:06:03.62,0:06:05.97,Main,,0,0,0,,Gidiyoruz Jinbe!\NSancak alabanda!
Dialogue: 0,0:06:05.97,0:06:08.10,Main,,0,0,0,,Sancak alabanda!
Dialogue: 0,0:06:09.69,0:06:11.74,Main,,0,0,0,,Sanji!
Dialogue: 0,0:06:11.74,0:06:14.28,Main,,0,0,0,,Ha gayret!
Dialogue: 0,0:06:23.39,0:06:25.78,Main,,0,0,0,,Germa'nın işini bitirin!
Dialogue: 0,0:06:25.78,0:06:28.30,Main,,0,0,0,,Kara Bacak nereye tüydü?
Dialogue: 0,0:06:30.87,0:06:32.75,Main,,0,0,0,,Toz perdesinden bir bok görülmüyor ki!
Dialogue: 0,0:06:46.82,0:06:48.37,Main,,0,0,0,,İşte orada!
Dialogue: 0,0:06:53.40,0:06:55.06,Main,,0,0,0,,Mıhlayın!
Dialogue: 0,0:07:04.57,0:07:06.99,Main,,0,0,0,,Elinizden kaçırmayın!
Dialogue: 0,0:07:10.16,0:07:14.58,Main,,0,0,0,,Aynen öyle.\NSakın elinizden kaçırmayın!
Dialogue: 0,0:07:15.79,0:07:20.09,Main,,0,0,0,,Hasır Şapka Luffy'yi\Nn'olursa olsun affedemeyiz!
Dialogue: 0,0:07:24.75,0:07:30.64,Main,,0,0,0,,Katakuri abimi hinlikle atlatıp\Nburaya gelmedi.
Dialogue: 0,0:07:31.38,0:07:32.69,Main,,0,0,0,,Brûlée abla...
Dialogue: 0,0:07:33.33,0:07:38.40,Main,,0,0,0,,Ayna Dünyası'nda olanları anlatmamı\Nister misiniz?
Dialogue: 0,0:07:41.38,0:07:43.00,Main,,0,0,0,,Kusursuzluk örneği...
Dialogue: 0,0:07:43.00,0:07:47.27,Main,,0,0,0,,Dünyanın zirvesindeki en güçlü adam...
Dialogue: 0,0:07:48.05,0:07:51.54,Main,,0,0,0,,Katakuri abimiz...
Dialogue: 0,0:07:55.21,0:07:57.84,Main,,0,0,0,,Abimiz...
Dialogue: 0,0:08:05.49,0:08:11.92,Main,,0,0,0,,...Hasır Şapka Luffy'ye yenildi!
Dialogue: 0,0:08:24.45,0:08:25.83,Main,,0,0,0,,Ne dedin sen?
Dialogue: 0,0:08:27.75,0:08:29.96,Thoughts,,0,0,0,,{\i1}Katakuri...{\i0}
Dialogue: 0,0:08:29.96,0:08:32.25,Thoughts,,0,0,0,,{\i1}Yenilgi yüzü görmemiş dillere destan sicilin...
Dialogue: 0,0:08:33.09,0:08:36.06,Thoughts,,0,0,0,,{\i1}...şu götten bacaklı tarafından mı kirlendi?
Dialogue: 0,0:08:37.72,0:08:41.85,Main,,0,0,0,,Mümkün değil!!
Dialogue: 0,0:08:42.31,0:08:44.68,Main,,0,0,0,,Abimiz hayatta kaybetmez!
Dialogue: 0,0:08:44.68,0:08:48.02,Main,,0,0,0,,Katakuri-{\i1}sama{\i0}'yı yenecek\Ninsan evladı daha doğmuş değil!
Dialogue: 0,0:08:48.02,0:08:53.77,Main,,0,0,0,,Kesin pis bir hileye başvurmuştur!\NBu şerefsizi ölsem de bağışlayamam!
Dialogue: 0,0:08:58.81,0:09:01.90,Main,,0,0,0,,Delik deşik edin!
Dialogue: 0,0:09:05.99,0:09:08.74,Main,,0,0,0,,Kılıçtan geçirin!
Dialogue: 0,0:09:14.67,0:09:18.22,Main,,0,0,0,,Sağlam tek bir kemiği kalmayana dek\Nüzerinden geçin!
Dialogue: 0,0:09:18.22,0:09:20.09,Main,,0,0,0,,Baş üstüne!
Dialogue: 0,0:09:37.40,0:09:40.28,Main,,0,0,0,,Kaçamazsın Hasır Şapka!
Dialogue: 0,0:09:58.17,0:10:00.22,Main,,0,0,0,,Piç kurusu!
Dialogue: 0,0:10:00.25,0:10:04.05,Main,,0,0,0,,Hasır Şapka!
Dialogue: 0,0:10:04.74,0:10:06.48,Main,,0,0,0,,Bunun hesabını vereceksin!
Dialogue: 0,0:10:10.06,0:10:13.35,Main,,0,0,0,,Gebert gitsin Oven abi!
Dialogue: 0,0:10:17.58,0:10:19.08,Main,,0,0,0,,{\fad(150,150)}Sparking...
Dialogue: 0,0:10:17.58,0:10:19.08,Attack,,0,0,0,,{\fad(150,150)}Kıvılcım...
Dialogue: 0,0:10:22.26,0:10:23.59,Main,,0,0,0,,{\fad(150,150)}...Valkyrie!
Dialogue: 0,0:10:22.26,0:10:23.59,Attack,,0,0,0,,{\fad(150,150)}...Işık Yumrukları!
