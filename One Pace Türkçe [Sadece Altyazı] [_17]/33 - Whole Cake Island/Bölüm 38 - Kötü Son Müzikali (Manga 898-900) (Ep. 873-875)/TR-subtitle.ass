Dialogue: 0,0:34:15.92,0:34:19.73,Lyrics,,0,0,0,karaoke,♪ Fevkalade olmuş! Bu tatlılık...
Dialogue: 0,0:34:19.73,0:34:23.30,Lyrics,,0,0,0,karaoke,...bir yerlerden tanıdık geliyor. ♪
Dialogue: 0,0:34:23.30,0:34:29.10,Lyrics,,0,0,0,karaoke,♪ Enfes olmuş! ♪
Dialogue: 0,0:37:10.76,0:37:12.39,Lyrics,,0,0,0,karaoke,♪ Kabarık... ♪
Dialogue: 0,0:37:12.89,0:37:14.56,Lyrics,,0,0,0,karaoke,♪ Hapır... ♪
Dialogue: 0,0:37:14.56,0:37:16.35,Lyrics,,0,0,0,karaoke,♪ Hupur... ♪
Dialogue: 0,0:37:18.98,0:37:19.94,Lyrics,,0,0,0,karaoke,♪ Kabarık... ♪
Dialogue: 0,0:37:19.94,0:37:20.98,Lyrics,,0,0,0,karaoke,♪ Hapır... ♪
Dialogue: 0,0:37:20.98,0:37:21.90,Lyrics,,0,0,0,karaoke,♪ Hupur... ♪
Dialogue: 0,0:37:23.02,0:37:23.82,Lyrics,,0,0,0,karaoke,♪ Kabarık... ♪
Dialogue: 0,0:37:23.82,0:37:24.94,Lyrics,,0,0,0,karaoke,♪ Hapır... ♪
Dialogue: 0,0:37:24.94,0:37:25.90,Lyrics,,0,0,0,karaoke,♪ Hupur... ♪
Dialogue: 0,0:37:27.32,0:37:28.35,Lyrics,,0,0,0,karaoke,♪ Neyin...
Dialogue: 0,0:37:29.20,0:37:30.17,Lyrics,,0,0,0,karaoke,...nesi bu? ♪
Dialogue: 0,0:37:30.87,0:37:34.79,Lyrics,,0,0,0,karaoke,♪ Rüya gibi bir tat! ♪
Dialogue: 0,0:37:32.92,0:37:34.79,Lyrics,,0,0,80,karaoke,- Çiçek! Çiçek!
Dialogue: 0,0:37:34.79,0:37:38.97,Lyrics,,0,0,0,karaoke,♪ En uç rüyalarımda bile böylesini görmedim. ♪
Dialogue: 0,0:37:38.97,0:37:42.97,Lyrics,,0,0,0,karaoke,♪ Kelimeler kifayetsiz kalıyor! ♪
Dialogue: 0,0:37:42.97,0:37:44.89,Lyrics,,0,0,0,karaoke,♪ Neyin... Neyin...
Dialogue: 0,0:37:44.89,0:37:46.93,Lyrics,,0,0,0,karaoke,...nesidir bu tat? ♪
Dialogue: 0,0:37:46.93,0:37:50.94,Lyrics,,0,0,0,karaoke,♪ Kokuşmuş enikler dans etmeye başlıyorlar. ♪
Dialogue: 0,0:37:50.94,0:37:53.91,Lyrics,,0,0,0,karaoke,♪ Tadı şey gibi yoğun...
Dialogue: 0,0:37:53.91,0:37:59.88,Lyrics,,0,0,0,karaoke,-- Evcil hayvan mezarlığı! --
Dialogue: 0,0:38:10.87,0:38:13.01,Lyrics,,0,0,0,karaoke,♪ Çok tatlı! ♪
Dialogue: 0,0:38:11.96,0:38:13.01,Lyrics,,0,0,80,karaoke,-- Çok tatlı! --
Dialogue: 0,0:38:13.01,0:38:15.05,Lyrics,,0,0,0,karaoke,♪ Bol sütlü! ♪
Dialogue: 0,0:38:13.87,0:38:15.89,Lyrics,,0,0,80,karaoke,-- Bol sütlü! --
Dialogue: 0,0:38:15.05,0:38:19.97,Lyrics,,0,0,0,karaoke,♪ Pek besleyici ve de...
Dialogue: 0,0:38:17.01,0:38:21.18,Lyrics,,0,0,80,karaoke,-- Pek besleyici ve de...
Dialogue: 0,0:38:22.18,0:38:24.98,Lyrics,,0,0,0,karaoke,...riskli! ♪
Dialogue: 0,0:38:31.06,0:38:36.98,Lyrics,,0,0,0,karaoke,♪ Bakın! Evet, tam bir curcuna! ♪
Dialogue: 0,0:38:35.02,0:38:36.98,Lyrics,,0,0,80,karaoke,-- Gemi! Gemi! --
Dialogue: 0,0:38:36.98,0:38:46.42,Lyrics,,0,0,0,karaoke,♪ Lunaparkın tekine bomba atmışcasına! ♪
Dialogue: 0,0:38:49.99,0:38:52.07,Lyrics,,0,0,0,karaoke,♪ Sanki miden...
Dialogue: 0,0:38:52.07,0:38:57.13,Lyrics,,0,0,0,karaoke,...bayram ediyor! ♪
Dialogue: 0,0:39:03.22,0:39:06.76,Lyrics,,0,0,0,karaoke,♪ Baksana Anne... ♪
Dialogue: 0,0:39:06.76,0:39:15.94,Lyrics,,0,0,0,karaoke,♪ Bu mest eden mutlu tatlılığı tadabiliyor musun? ♪
Dialogue: 0,0:39:18.98,0:39:20.27,Lyrics,,0,0,0,karaoke,♪ Sahi! ♪
Dialogue: 0,0:39:20.32,0:39:24.71,Lyrics,,0,0,0,karaoke,♪ O günkü...
Dialogue: 0,0:39:24.71,0:39:29.99,Lyrics,,0,0,0,karaoke,...mutluluğun tadı işte. ♪
Dialogue: 0,0:39:36.96,0:39:45.01,Lyrics,,0,0,0,karaoke,♪ Günün birinde tekrar birlikte yemek yiyelim. ♪
Dialogue: 0,0:39:45.01,0:39:46.87,Lyrics,,0,0,0,karaoke,♪ Çok tatlı! ♪
Dialogue: 0,0:39:45.93,0:39:48.16,Lyrics,,0,0,80,karaoke,-- Çok tatlı! --
Dialogue: 0,0:39:46.87,0:39:48.97,Lyrics,,0,0,0,karaoke,♪ Bol sütlü! ♪
Dialogue: 0,0:39:48.32,0:39:50.53,Lyrics,,0,0,80,karaoke,-- Bol sütlü! --
Dialogue: 0,0:39:48.97,0:39:56.00,Lyrics,,0,0,0,karaoke,♪ Pek besleyici ve de...
Dialogue: 0,0:39:51.14,0:39:56.52,Lyrics,,0,0,80,karaoke,-- Pek besleyici ve de...
Dialogue: 0,0:39:56.52,0:39:59.44,Lyrics,,0,0,0,karaoke,...riskli! ♪
Dialogue: 0,0:40:13.24,0:40:17.04,Lyrics,,0,0,0,karaoke,♪ Baksana Anne, sence...
Dialogue: 0,0:40:17.04,0:40:19.12,Lyrics,,0,0,0,karaoke,...bunu becerebilir miyim? ♪
Dialogue: 0,0:40:20.94,0:40:25.21,Lyrics,,0,0,0,karaoke,♪ Herkes mutlu mesut! ♪
Dialogue: 0,0:40:25.21,0:40:28.94,Lyrics,,0,0,0,karaoke,♪ Huzur dolu bir ütopyadayız! ♪
Dialogue: 0,0:40:28.94,0:40:37.13,Lyrics,,0,0,0,karaoke,♪ Irkının bir önemi yok! ♪
Dialogue: 0,0:40:37.13,0:40:44.43,Lyrics,,0,0,0,karaoke,♪ Kaçmaya çalışırsan ölürsün ama! ♪
Dialogue: 0,0:40:44.43,0:40:48.91,Lyrics,,0,0,0,karaoke,♪ Şeytani bir anlaşma! ♪
Dialogue: 0,0:40:48.91,0:40:53.07,Lyrics,,0,0,0,karaoke,-- Huzur dolu Totto Land! --
Dialogue: 0,0:40:53.07,0:40:56.82,Lyrics,,0,0,0,karaoke,♪ Hepimiz aileyiz! ♪
Dialogue: 0,0:40:56.82,0:41:01.84,Lyrics,,0,0,0,karaoke,♪ Hoşgörülü kraliçe...
Dialogue: 0,0:41:02.62,0:41:03.95,Lyrics,,0,0,0,karaoke,...Big Mom! ♪
Dialogue: 0,0:41:16.93,0:41:19.04,Lyrics,,0,0,0,karaoke,♪ Enfesti! ♪
Dialogue: 0,0:41:19.04,0:41:21.63,Lyrics,,0,0,0,karaoke,♪ Yapanın eline sağlık! ♪
