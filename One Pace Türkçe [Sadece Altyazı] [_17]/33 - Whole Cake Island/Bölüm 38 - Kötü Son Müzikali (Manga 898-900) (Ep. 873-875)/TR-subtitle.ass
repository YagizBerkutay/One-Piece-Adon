ogue: 0,0:26:03.79,0:26:03.83,Captions,,0,0,0,,KAKAO ADASIDialogue: 0,0:26:03.83,0:26:03.87,Captions,,0,0,0,,KAKAO ADASIDialogue: 0,0:26:03.87,0:26:03.91,Captions,,0,0,0,,KAKAO ADASIDialogue: 0,0:26:03.91,0:26:03.95,Captions,,0,0,0,,KAKAO ADASIDialogue: 0,0:26:03.95,0:26:04.00,Captions,,0,0,0,,KAKAO ADASIDialogue: 0,0:26:04.00,0:26:04.04,Captions,,0,0,0,,KAKAO ADASIDialogue: 0,0:26:04.04,0:26:04.08,Captions,,0,0,0,,KAKAO ADASIDialogue: 0,0:26:04.08,0:26:04.12,Captions,,0,0,0,,KAKAO ADASIDialogue: 0,0:26:04.12,0:26:04.16,Captions,,0,0,0,,KAKAO ADASIDialogue: 0,0:26:04.16,0:26:04.20,Captions,,0,0,0,,KAKAO ADASIDialogue: 0,0:26:04.20,0:26:04.25,Captions,,0,0,0,,KAKAO ADASIDialogue: 0,0:26:04.25,0:26:04.29,Captions,,0,0,0,,KAKAO ADASIDialogue: 0,0:26:04.29,0:26:04.33,Captions,,0,0,0,,KAKAO ADASIDialogue: 0,0:26:04.33,0:26:04.37,Captions,,0,0,0,,KAKAO ADASIDialogue: 0,0:26:04.37,0:26:04.41,Captions,,0,0,0,,KAKAO ADASIDialogue: 0,0:26:04.41,0:26:04.45,Captions,,0,0,0,,KAKAO ADASIDialogue: 0,0:26:04.45,0:26:08.21,Captions,,0,0,0,,KAKAO ADASIDialogue: 0,0:26:02.04,0:26:05.36,Main,,0,0,0,,Kalan tüm gemilerini adanın etrafından göndermişler!Dialogue: 0,0:26:06.32,0:26:08.21,Main,,0,0,0,,Etrafımız sarıldı!Dialogue: 0,0:26:08.97,0:26:11.92,Main,,0,0,0,,Saldırı menziline girmişler bile!Dialogue: 0,0:26:11.92,0:26:13.05,Main,,0,0,0,,Nasıl ama?Dialogue: 0,0:26:14.17,0:26:15.48,Main,,0,0,0,,Aynen öyle!Dialogue: 0,0:26:15.48,0:26:18.64,Main,,0,0,0,,Hem pruvadan hem de pupadan saldırıyoruz tavşancık!Dialogue: 0,0:26:18.64,0:26:19.99,Main,,0,0,0,,Carrot-chan!Dialogue: 0,0:26:19.99,0:26:23.68,Main,,0,0,0,,Ön kapınıza bir filo, arka kapınıza ise Cin dayanmış!Dialogue: 0,0:26:23.68,0:26:24.72,Main,,0,0,0,,Maji...Dialogue: 0,0:26:23.68,0:26:24.72,Attack,,0,0,0,,İfrit...Dialogue: 0,0:26:25.43,0:26:27.48,Main,,0,0,0,,Giren!Dialogue: 0,0:26:25.43,0:26:27.48,Attack,,0,0,0,,KesişiDialogue: 0,0:26:27.50,0:26:28.81,Main,,0,0,0,,Kara Bacak!Dialogue: 0,0:26:29.33,0:26:30.23,Main,,0,0,0,,Sanji!Dialogue: 0,0:26:32.76,0:26:34.44,Main,,0,0,0,,Kocaman!Dialogue: 0,0:26:37.20,0:26:41.62,Main,,0,0,0,,Nihayet yeteneğimin uzanabileceği kadar yakınlaştık!Dialogue: 0,0:26:41.62,0:26:45.62,Main,,0,0,0,,Böyle de zorbalık ettiğimiz izlenimi uyanıyor.Dialogue: 0,0:26:47.91,0:26:50.33,Main,,0,0,0,,Birden nasıl oldu da yanımızda bittiler ki?Dialogue: 0,0:26:50.33,0:26:53.09,Main,,0,0,0,,Pruvadaki gemilere dikkatlice bak!Dialogue: 0,0:26:57.30,0:27:00.24,Main,,0,0,0,,Hepsi de paletli gemi!Dialogue: 0,0:27:01.59,0:27:02.49,Main,,0,0,0,,Olamaz!Dialogue: 0,0:27:02.49,0:27:04.47,Main,,0,0,0,,Bu durumda kaçamayız!Dialogue: 0,0:27:04.47,0:27:06.26,Main,,0,0,0,,Yolun sonuna gelmiş olabiliriz!Dialogue: 0,0:27:06.28,0:27:09.69,Main,,0,0,0,,Şimdi alabora olmak için onca zorluğa göğüs germişiz meğer!Dialogue: 0,0:27:09.69,0:27:11.66,Main,,0,0,0,,Hep birlikte alabora edin!Dialogue: 0,0:27:18.79,0:27:20.10,Main,,0,0,0,,N'oluyor?Dialogue: 0,0:27:24.98,0:27:27.35,Main,,0,0,0,,Deniz yüzeyi yükseliyor lan!Dialogue: 0,0:27:28.56,0:27:34.16,Main,,0,0,0,,Patron'un canını sıkanların...Dialogue: 0,0:27:35.56,0:27:40.60,Main,,0,0,0,,...ümüğünü sıkarım!Dialogue: 0,0:27:45.21,0:27:46.96,Main,,0,0,0,,Ne?Dialogue: 0,0:27:46.96,0:27:50.59,Main,,0,0,0,,Balık Adam Adası'ndan Hordy'nin mürettebatı!Dialogue: 0,0:27:50.59,0:27:52.52,Main,,0,0,0,,Wadatsumi!Dialogue: 0,0:27:53.84,0:27:54.68,Main,,0,0,0,,Ne?Dialogue: 0,0:27:55.05,0:27:55.97,Main,,0,0,0,,Yoksa...Dialogue: 0,0:27:55.97,0:27:57.93,Main,,0,0,0,,Jinbe!Dialogue: 0,0:28:02.86,0:28:04.32,Main,,0,0,0,,Çocuklar!Dialogue: 0,0:28:08.99,0:28:13.60,Main,,0,0,0,,Seni uğurlamaya geldik Kaptan Jinbe!Dialogue: 0,0:28:13.60,0:28:16.37,Main,,0,0,0,,Amanın, eski diyecektik. Eski Kaptan!Dialogue: 0,0:28:23.08,0:28:28.84,Main,,0,0,0,,Bu sulardan çıkana kadar mürettebatınız olarak kalabilir miyiz?Dialogue: 0,0:28:30.36,0:28:32.17,Main,,0,0,0,,Tamam öyleyse!Dialogue: 0,0:28:33.63,0:28:36.13,Main,,0,0,0,,Çekilin lan!Dialogue: 0,0:28:36.13,0:28:37.92,Main,,0,0,0,,Süper ya!Dialogue: 0,0:28:40.26,0:28:42.12,Main,,0,0,0,,N'oluyor?Dialogue: 0,0:28:42.12,0:28:43.81,Main,,0,0,0,,Su alıyoruz!Dialogue: 0,0:28:45.64,0:28:48.35,Main,,0,0,0,,Karinada delik mi açtılar?Dialogue: 0,0:28:49.38,0:28:51.48,Main,,0,0,0,,Denizde Balık Adamlar var!Dialogue: 0,0:28:51.48,0:28:53.69,Main,,0,0,0,,Hiç mi şerefleri kalmamış?Dialogue: 0,0:28:53.69,0:28:56.48,Main,,0,0,0,,Gösterin kendinizi aşağılık Balık Adamlar!Dialogue: 0,0:29:03.55,0:29:05.62,Main,,0,0,0,,Adi gemiler!Dialogue: 0,0:29:09.21,0:29:10.25,Main,,0,0,0,,Hay böyle işin!Dialogue: 0,0:29:10.25,0:29:12.38,Main,,0,0,0,,Hasır Şapkalar'ı elimizden kaçırmayacağım!Dialogue: 0,0:29:14.34,0:29:16.75,Main,,0,0,0,,Majin!Dialogue: 0,0:29:14.34,0:29:16.75,Attack,,0,0,0,,İfritDialogue: 0,0:29:18.63,0:29:20.05,Main,,0,0,0,,Kairyu...Dialogue: 0,0:29:18.63,0:29:20.05,Attack,,0,0,0,,Okyanus Akıntısı...Dialogue: 0,0:29:20.11,0:29:23.14,Main,,0,0,0,,Ipponzeoi!Dialogue: 0,0:29:20.11,0:29:23.14,Attack,,0,0,0,,Omuz FırlatışıDialogue: 0,0:29:43.03,0:29:43.99,Main,,0,0,0,,Bakın!Dialogue: 0,0:29:47.38,0:29:49.56,Main,,0,0,0,,Denizde bir yol belirdi!Dialogue: 0,0:30:02.33,0:30:05.84,Main,,0,0,0,,Biz onları tutarken gidin Kaptan Jinbe!Dialogue: 0,0:30:05.84,0:30:10.26,Main,,0,0,0,,Hasır Şapkalar'ın gemisine zarar verdirtmeyiz!Dialogue: 0,0:30:16.14,0:30:18.10,Main,,0,0,0,,Hakkınız ödenmez!Dialogue: 0,0:30:18.72,0:30:21.13,Main,,0,0,0,,Nasıl fark etmedim ki?Dialogue: 0,0:30:21.13,0:30:26.98,Main,,0,0,0,,Düşmanın Mıntıka Salyangozlarını etkisiz hâle getiren de onlardı.Dialogue: 0,0:30:26.98,0:30:30.78,Main,,0,0,0,,Son ana kadar arkamı kolladılar.Dialogue: 0,0:30:30.78,0:30:34.62,Main,,0,0,0,,Senin arkadaşlarından da bu beklenirdi!Dialogue: 0,0:30:34.62,0:30:36.27,Main,,0,0,0,,Aynen!Dialogue: 0,0:30:36.27,0:30:38.17,Main,,0,0,0,,Teşekkürler...Dialogue: 0,0:30:38.17,0:30:40.12,Main,,0,0,0,,Çocuklar!Dialogue: 0,0:30:40.12,0:30:44.96,Main,,0,0,0,,Jinbe'ye göz kulak olun! Hasır Şapka!Dialogue: 0,0:30:44.96,0:30:46.36,Main,,0,0,0,,Olurum!Dialogue: 0,0:30:49.92,0:30:51.67,Main,,0,0,0,,Ateş!Dialogue: 0,0:30:55.64,0:30:57.13,Main,,0,0,0,,Gattai!Dialogue: 0,0:30:55.64,0:30:57.13,Attack,,0,0,0,,BirleşDialogue: 0,0:31:11.23,0:31:15.44,Main,,0,0,0,,Oven-sama,  Kakao Adası'nda olmanız gerekmiyor mu?Dialogue: 0,0:31:16.36,0:31:20.65,Main,,0,0,0,,Germa'yı Brûlée'ye bıraktım!Dialogue: 0,0:31:21.07,0:31:24.67,Main,,0,0,0,,Elimdekiler Germa'nın Raid Suitler'ini kolayca...Dialogue: 0,0:31:24.67,0:31:27.74,Main,,0,0,0,,...delik deşik edebilecek ağır metal alaşımlı mermilerdir!Dialogue: 0,0:31:27.74,0:31:30.50,Main,,0,0,0,,Şunlara bir ders verin!Dialogue: 0,0:31:30.50,0:31:31.29,Main,,0,0,0,,Emredersiniz!Dialogue: 0,0:31:43.34,0:31:45.30,Main,,0,0,0,,Yine şu herif!Dialogue: 0,0:31:48.22,0:31:51.10,Main,,0,0,0,,Hasır Şapka!Dialogue: 0,0:31:54.94,0:31:58.86,Main,,0,0,0,,Katakuri'yi alt ettin madem...Dialogue: 0,0:31:58.86,0:32:00.82,Main,,0,0,0,,...seni sağ bırakamam!Dialogue: 0,0:32:10.27,0:32:11.96,Main,,0,0,0,,N'olacak?Dialogue: 0,0:32:20.94,0:32:24.27,Thoughts,,0,0,0,,Merak etmeyin. Beğenecek!Dialogue: 0,0:32:24.27,0:32:26.51,Thoughts,,0,0,0,,O pastayı pişiren adam...Dialogue: 0,0:32:26.51,0:32:28.35,Thoughts,,0,0,0,,...gerçek bir şeftir!Dialogue: 0,0:32:29.82,0:32:33.52,Flashbacks,,0,0,0,,Dur Kara Bacak!  Bu yöntem tüm gecemizi alır!Dialogue: 0,0:32:33.52,0:32:35.43,Flashbacks,,0,0,0,,Bunu yapmamız elzem!Dialogue: 0,0:32:35.43,0:32:37.10,Flashbacks,,0,0,0,,İyi de vakit yok!Dialogue: 0,0:32:37.10,0:32:38.71,Flashbacks,,0,0,0,,İki saatte bitireceğim!Dialogue: 0,0:32:38.71,0:32:40.54,Flashbacks,,0,0,0,,Dalga geçiyor olmalısın!Dialogue: 0,0:32:41.99,0:32:46.18,Flashbacks,,0,0,0,,Ne demeye sırıtıyorsun ki? Ciddileş biraz Kara Bacak!Dialogue: 0,0:32:47.02,0:32:51.86,Flashbacks,,0,0,0,,Sizin geminizle ülkemizin akıbeti buna bağlı!Dialogue: 0,0:32:52.95,0:32:54.27,Flashbacks,,0,0,0,,Pardon ya.Dialogue: 0,0:32:55.00,0:32:57.02,Flashbacks,,0,0,0,,Big Mom'ın "Enfes!" diye bağırırken...Dialogue: 0,0:32:57.02,0:33:00.49,Flashbacks,,0,0,0,,...takınacağı neşeli ifadeyi hayal edince dayanamadım da.Dialogue: 0,0:33:01.08,0:33:02.47,Flashbacks,,0,0,0,,Çok şeker ya!Dialogue: 0,0:33:02.47,0:33:03.83,Flashbacks,,0,0,0,,Neşeli ifade mi?Dialogue: 0,0:33:03.83,0:33:06.76,Flashbacks,,0,0,0,,Kadın canınızı almak istiyor!Dialogue: 0,0:33:16.93,0:33:18.32,Main,,0,0,0,,Mama!Dialogue: 0,0:33:21.90,0:33:24.04,Main,,0,0,0,,Zehre yenik mi düştü?Dialogue: 0,0:33:34.92,0:33:40.37,Main,,0,0,0,,Öyle enfes olmuş ki ruhum çıkıp gidecek!Dialogue: 0,0:33:40.37,0:33:43.12,Main,,0,0,0,,Akıl almaz bir tatlılık!Dialogue: 0,0:33:46.46,0:33:50.84,Main,,0,0,0,,İşte bu ya!Dialogue: 0,0:33:50.84,0:33:55.76,Main,,0,0,0,,Düğün pastası!Dialogue: 0,0:33:58.20,0:33:59.91,Main,,0,0,0,,Kendine geldi...Dialogue: 0,0:33:59.91,0:34:01.30,Main,,0,0,0,,Peki ya zehir?Dialogue: 0,0:34:01.30,0:34:06.44,Main,,0,0,0,,Zehirli olduğuna adım gibi eminim! Tesir etmemiştir! Mama'dan da bu beklenirdi!Dialogue: 0,0:34:10.25,0:34:12.61,Main,,0,0,0,,Kara Bacak!Dialogue: 0,0:34:12.61,0:34:15.19,Main,,0,0,0,,Görmeyi umduğun yüz ifadesine bakıyorum!Dialogue: 0,0:34:32.71,0:34:36.23,Main,,0,0,0,,Totto Land'ın tüm adalarına sesleniyorum.Dialogue: 0,0:34:36.23,0:34:40.13,Main,,0,0,0,,Taşkınlık sona ermiştir!Dialogue: 0,0:34:47.22,0:34:51.30,Main,,0,0,0,,35. Charlotte kızı Pudding'in gayretiyle...Dialogue: 0,0:34:51.30,0:34:54.18,Main,,0,0,0,,...Mama'nın Açlık Krizi dinmiştir!Dialogue: 0,0:34:54.18,0:34:59.08,Main,,0,0,0,,Şükürler olsun! Kakao Adası'na yakın olduğumuzdan sıra bize geliyor demiştim!Dialogue: 0,0:34:59.08,0:35:01.01,Main,,0,0,0,,Çok korktum ya!Dialogue: 0,0:35:01.01,0:35:02.61,Main,,0,0,0,,Geçti artık!Dialogue: 0,0:35:03.00,0:35:05.04,Main,,0,0,0,,Sağ ol Bege!Dialogue: 0,0:35:16.50,0:35:23.23,Main,,0,0,0,,Ülkeye ihanet eden Chiffon-sama'dan  faydalanarak Pudding-sama'mız Totto Land'ı kurtardı!Dialogue: 0,0:35:23.23,0:35:24.99,Main,,0,0,0,,Bunu kimse başaramazdı!Dialogue: 0,0:35:24.99,0:35:27.52,Main,,0,0,0,,Teşekkürler Pudding-sama!Dialogue: 0,0:35:27.52,0:35:30.37,Main,,0,0,0,,Pudding-sama'mıza da bu yakışırdı!Dialogue: 0,0:35:30.37,0:35:31.78,Thoughts,,0,0,0,,Yanılıyorsunuz...Dialogue: 0,0:35:32.27,0:35:33.89,Thoughts,,0,0,0,,Ben bir şey yapmadım ki.Dialogue: 0,0:35:41.12,0:35:42.94,Main,,0,0,0,,Gelin bakalım!Dialogue: 0,0:35:51.18,0:35:54.39,Main,,0,0,0,,Sparking... Figure!Dialogue: 0,0:35:51.18,0:35:54.39,Attack,,0,0,0,,Kıvılcımlanan SilüetDialogue: 0,0:36:02.32,0:36:04.61,Main,,0,0,0,,Nekkai Jigoku!Dialogue: 0,0:36:02.32,0:36:04.61,Attack,,0,0,0,,Kaynayan Derya CehennemiDialogue: 0,0:36:17.17,0:36:20.21,Main,,0,0,0,,Herkes deniz tabanına kaçsın!Dialogue: 0,0:36:20.21,0:36:23.59,Main,,0,0,0,,Sıcaktan yaklaşamıyorum ya!Dialogue: 0,0:36:24.44,0:36:27.08,Main,,0,0,0,,Götünüzü kollayacak kimse kalmadı!Dialogue: 0,0:36:27.08,0:36:29.47,Main,,0,0,0,,Kaçacak yeriniz de keza!Dialogue: 0,0:36:33.47,0:36:34.47,Main,,0,0,0,,Kahretsin!Dialogue: 0,0:36:34.47,0:36:37.10,Main,,0,0,0,,N'apıyoruz Luffy?Dialogue: 0,0:36:43.67,0:36:45.00,Main,,0,0,0,,Dümdüz...Dialogue: 0,0:36:46.56,0:36:47.79,Main,,0,0,0,,...ilerleyin!Dialogue: 0,0:36:51.18,0:36:55.12,Main,,0,0,0,,Kraliçe Mama'nın şarkıcıları Kakao Adası'na varmak üzere.Dialogue: 0,0:36:59.17,0:37:03.05,Main,,0,0,0,,İşte bu! Tam zamanında!Dialogue: 0,0:39:18.23,0:39:18.98,Captions,,0,0,660,,Mutlu Yıllar LinlinDialogue: 0,0:39:20.52,0:39:32.79,Captions,,0,0,660,,Mutlu Yıllar LinlinDialogue: 0,0:39:29.99,0:39:32.79,Flashbacks,,0,0,0,,Mutlu Yıllar...Dialogue: 0,0:39:32.79,0:39:35.08,Flashbacks,,0,0,0,,Linlin!Dialogue: 0,0:41:22.08,0:41:27.07,Credits,,0,0,0,,Editing:  Feeso, Galaxy 9000  Timing: KaitouYahiko  Quality Assurance: Feeso, Galaxy 9000, Grug, Pepperjack  Soundtracking:  Halee  Graphics:  Datenshi KaitouYahiko  Karaoke: KaitouYahiko  Translation: Crunchyroll Gaijin