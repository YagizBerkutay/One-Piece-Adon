P A R K I N GDialogue: 0,0:10:25.09,0:10:25.13,Main,,0,0,0,,S P A R K I N GDialogue: 0,0:10:25.13,0:10:25.93,Main,,0,0,0,,S P A R K I N GDialogue: 0,0:10:31.41,0:10:32.47,Main,,0,0,0,,Ichiji?!Dialogue: 0,0:10:33.35,0:10:34.93,Main,,0,0,0,,Kaçsana Sanji!Dialogue: 0,0:10:38.39,0:10:41.21,Main,,0,0,0,,Oven abi! Sen iyi misin?Dialogue: 0,0:10:50.11,0:10:52.12,Main,,0,0,0,,Sırtındakini bırak!Dialogue: 0,0:10:52.12,0:10:54.41,Main,,0,0,0,,Kara Bacak!Dialogue: 0,0:10:54.41,0:10:56.91,Main,,0,0,0,,Yine yeri öpeceksin-yu!Dialogue: 0,0:11:18.21,0:11:21.63,Main,,0,0,0,,Winch Danton!Dialogue: 0,0:11:18.21,0:11:21.63,Attack,,0,0,0,,Vinç GiyotiniDialogue: 0,0:11:20.00,0:11:20.05,Main,,0,0,0,,WINCH DANTONDialogue: 0,0:11:20.05,0:11:20.09,Main,,0,0,0,,WINCH DANTONDialogue: 0,0:11:20.09,0:11:20.13,Main,,0,0,0,,WINCH DANTONDialogue: 0,0:11:20.13,0:11:20.17,Main,,0,0,0,,WINCH DANTONDialogue: 0,0:11:20.17,0:11:20.21,Main,,0,0,0,,WINCH DANTONDialogue: 0,0:11:20.21,0:11:22.72,Main,,0,0,0,,WINCH DANTONDialogue: 0,0:11:45.86,0:11:47.24,Main,,0,0,0,,Yonji?!Dialogue: 0,0:11:47.24,0:11:49.03,Main,,0,0,0,,Git!Dialogue: 0,0:11:52.90,0:11:56.02,Main,,0,0,0,,Seni gördükçe tadım kaçıyor.Dialogue: 0,0:11:59.20,0:12:02.13,Main,,0,0,0,,Vurun! Çatıların hizasında!Dialogue: 0,0:12:03.82,0:12:06.39,Main,,0,0,0,,Katakuri-sama'nın intikamını alacağım!Dialogue: 0,0:12:21.36,0:12:24.18,Main,,0,0,0,,Kaplumbağa gibi hareket edersen kevgire dönersin bak!Dialogue: 0,0:12:25.00,0:12:26.39,Main,,0,0,0,,Niji!Dialogue: 0,0:12:26.39,0:12:28.06,Main,,0,0,0,,Germa!Dialogue: 0,0:12:28.06,0:12:29.43,Main,,0,0,0,,Gidiyoruz!Dialogue: 0,0:12:32.77,0:12:34.52,Main,,0,0,0,,Kosoku no Ken:Dialogue: 0,0:12:32.77,0:12:34.52,Attack,,0,0,0,,Işık Hızında Kılıç:Dialogue: 0,0:12:42.77,0:12:45.95,Main,,0,0,0,,Henry... Blazer!Dialogue: 0,0:12:42.77,0:12:45.95,Attack,,0,0,0,,Elektromotif KesikDialogue: 0,0:12:44.11,0:12:44.15,Main,,0,0,0,,H E N R YDialogue: 0,0:12:44.15,0:12:44.20,Main,,0,0,0,,H E N R YDialogue: 0,0:12:44.20,0:12:44.24,Main,,0,0,0,,H E N R YDialogue: 0,0:12:44.24,0:12:44.28,Main,,0,0,0,,H E N R YDialogue: 0,0:12:44.28,0:12:44.32,Main,,0,0,0,,H E N R YDialogue: 0,0:12:44.32,0:12:44.36,Main,,0,0,0,,H E N R YDialogue: 0,0:12:44.36,0:12:44.41,Main,,0,0,0,,H E N R YDialogue: 0,0:12:44.41,0:12:44.45,Main,,0,0,0,,H E N R YDialogue: 0,0:12:44.45,0:12:44.49,Main,,0,0,0,,H E N R YDialogue: 0,0:12:44.49,0:12:44.53,Main,,0,0,0,,H E N R YDialogue: 0,0:12:44.53,0:12:44.57,Main,,0,0,0,,H E N R YDialogue: 0,0:12:44.57,0:12:44.61,Main,,0,0,0,,H E N R YDialogue: 0,0:12:44.61,0:12:44.66,Main,,0,0,0,,H E N R YDialogue: 0,0:12:44.66,0:12:44.70,Main,,0,0,0,,H E N R YDialogue: 0,0:12:44.70,0:12:44.74,Main,,0,0,0,,H E N R YDialogue: 0,0:12:44.74,0:12:44.78,Main,,0,0,0,,H E N R YDialogue: 0,0:12:44.78,0:12:45.16,Main,,0,0,0,,H E N R YDialogue: 0,0:12:45.16,0:12:45.24,Main,,0,0,0,,H E N R YDialogue: 0,0:12:45.24,0:12:45.36,Main,,0,0,0,,H E N R YDialogue: 0,0:12:45.36,0:12:45.45,Main,,0,0,0,,H E N R YDialogue: 0,0:12:45.45,0:12:45.49,Main,,0,0,0,,H E N R YDialogue: 0,0:12:45.49,0:12:45.66,Main,,0,0,0,,H E N R YDialogue: 0,0:12:44.11,0:12:44.15,Main,,0,0,0,,B L A Z E RDialogue: 0,0:12:44.15,0:12:44.20,Main,,0,0,0,,B L A Z E RDialogue: 0,0:12:44.20,0:12:44.24,Main,,0,0,0,,B L A Z E RDialogue: 0,0:12:44.24,0:12:44.28,Main,,0,0,0,,B L A Z E RDialogue: 0,0:12:44.28,0:12:44.32,Main,,0,0,0,,B L A Z E RDialogue: 0,0:12:44.32,0:12:44.36,Main,,0,0,0,,B L A Z E RDialogue: 0,0:12:44.36,0:12:44.41,Main,,0,0,0,,B L A Z E RDialogue: 0,0:12:44.41,0:12:44.45,Main,,0,0,0,,B L A Z E RDialogue: 0,0:12:44.45,0:12:44.49,Main,,0,0,0,,B L A Z E RDialogue: 0,0:12:44.49,0:12:44.53,Main,,0,0,0,,B L A Z E RDialogue: 0,0:12:44.53,0:12:44.57,Main,,0,0,0,,B L A Z E RDialogue: 0,0:12:44.57,0:12:44.61,Main,,0,0,0,,B L A Z E RDialogue: 0,0:12:44.61,0:12:44.66,Main,,0,0,0,,B L A Z E RDialogue: 0,0:12:44.66,0:12:44.70,Main,,0,0,0,,B L A Z E RDialogue: 0,0:12:44.70,0:12:44.74,Main,,0,0,0,,B L A Z E RDialogue: 0,0:12:44.74,0:12:44.78,Main,,0,0,0,,B L A Z E RDialogue: 0,0:12:44.78,0:12:44.83,Main,,0,0,0,,B L A Z E RDialogue: 0,0:12:44.83,0:12:44.88,Main,,0,0,0,,B L A Z E RDialogue: 0,0:12:44.88,0:12:45.01,Main,,0,0,0,,B L A Z E RDialogue: 0,0:12:45.01,0:12:45.06,Main,,0,0,0,,B L A Z E RDialogue: 0,0:12:45.06,0:12:45.11,Main,,0,0,0,,B L A Z E RDialogue: 0,0:12:45.11,0:12:45.16,Main,,0,0,0,,B L A Z E RDialogue: 0,0:12:45.16,0:12:45.20,Main,,0,0,0,,B L A Z E RDialogue: 0,0:12:45.20,0:12:45.24,Main,,0,0,0,,B L A Z E RDialogue: 0,0:12:45.24,0:12:45.32,Main,,0,0,0,,B L A Z E RDialogue: 0,0:12:45.32,0:12:45.66,Main,,0,0,0,,B L A Z E RDialogue: 0,0:12:54.37,0:12:59.19,Main,,0,0,0,,Olamaz! Oven-sama! Hasır Şapkalar şehirden kaçıyor!Dialogue: 0,0:12:59.19,0:13:01.42,Main,,0,0,0,,Kaçıyorlar mı?Dialogue: 0,0:13:09.32,0:13:12.12,Main,,0,0,0,,Güle güle fiyasko!Dialogue: 0,0:13:15.54,0:13:18.68,Main,,0,0,0,,Snack! Brownie! Joconde!Dialogue: 0,0:13:18.68,0:13:21.09,Main,,0,0,0,,Limanda işlerini bitirin!Dialogue: 0,0:13:21.09,0:13:23.09,Main,,0,0,0,,Size geliyorlar!Dialogue: 0,0:13:23.09,0:13:25.55,Main,,0,0,0,,Lan! Den Den Mushi'den arama geldi ya!Dialogue: 0,0:13:30.21,0:13:32.70,Main,,0,0,0,,Bu şekilde gemiye varabiliriz!Dialogue: 0,0:13:32.70,0:13:36.87,Main,,0,0,0,,Daha ileri gitmesin! Biber gazlı kovanları hazırlayın!Dialogue: 0,0:13:38.20,0:13:41.45,Main,,0,0,0,,Uçmaya dermanını bırakmasak yeter!Dialogue: 0,0:13:53.15,0:13:54.26,Main,,0,0,0,,Ne oldu?Dialogue: 0,0:13:54.26,0:13:56.01,Main,,0,0,0,,Topla kendini!Dialogue: 0,0:13:56.01,0:13:58.07,Main,,0,0,0,,Hey! Hey!Dialogue: 0,0:14:01.30,0:14:02.86,Main,,0,0,0,,Germa!Dialogue: 0,0:14:04.80,0:14:07.24,Main,,0,0,0,,Kardeşimin canını yakanların...Dialogue: 0,0:14:08.68,0:14:10.40,Main,,0,0,0,,...gözünün yaşına bakmam!Dialogue: 0,0:14:12.15,0:14:15.74,Flashbacks,,0,0,0,,Burada... Doğu Mavi'de...Dialogue: 0,0:14:18.10,0:14:19.74,Flashbacks,,0,0,0,,...kaçabilirsem...Dialogue: 0,0:14:23.82,0:14:26.31,Flashbacks,,0,0,0,,...bir daha...Dialogue: 0,0:14:26.31,0:14:29.18,Flashbacks,,0,0,0,,...babamın yüzünü...Dialogue: 0,0:14:29.18,0:14:31.69,Flashbacks,,0,0,0,,...görmek zorunda kalmam, değil mi?Dialogue: 0,0:14:39.80,0:14:41.93,Main,,0,0,0,,Pink Hornet!Dialogue: 0,0:14:39.80,0:14:41.93,Attack,,0,0,0,,Pembe Eşek ArısıDialogue: 0,0:14:45.06,0:14:48.03,Main,,0,0,0,,İşte Hasır Şapka! Ateş edin!Dialogue: 0,0:14:52.27,0:14:55.53,Main,,0,0,0,,Ha bire ilgi isteyen bir kardeşsin ama ya.Dialogue: 0,0:14:57.96,0:15:00.67,Main,,0,0,0,,Arkadaşını sakın bırakma!Dialogue: 0,0:15:01.39,0:15:05.54,Flashbacks,,0,0,0,,Sanji! Sen erkeksin! Ağlayıp durma!Dialogue: 0,0:15:06.44,0:15:10.15,Flashbacks,,0,0,0,,Dinle beni! Bir daha sakın dönme!Dialogue: 0,0:15:10.15,0:15:10.93,Flashbacks,,0,0,0,,Peki!Dialogue: 0,0:15:19.41,0:15:22.46,Flashbacks,,0,0,0,,Koş!!Dialogue: 0,0:15:22.46,0:15:24.01,Flashbacks,,0,0,0,,Arkana bakma sakın!!Dialogue: 0,0:15:28.35,0:15:32.93,Thoughts,,0,0,0,,Sanji...  Emsalsiz genişlikte kalbi olan kardeşim!Dialogue: 0,0:15:33.55,0:15:34.56,Main,,0,0,0,,Reiju!Dialogue: 0,0:15:35.98,0:15:37.19,Main,,0,0,0,,Güle güle!Dialogue: 0,0:15:57.15,0:16:02.07,Main,,0,0,0,,Hasır Şapkalar adadan kaçtı! Filo, cevap ver!Dialogue: 0,0:16:03.40,0:16:06.95,Main,,0,0,0,,Çabuk ol Sanji!Dialogue: 0,0:16:12.71,0:16:14.55,Main,,0,0,0,,Sanji!Dialogue: 0,0:16:14.55,0:16:16.51,Main,,0,0,0,,Geliyor millet!Dialogue: 0,0:16:17.44,0:16:20.01,Main,,0,0,0,,Sanji'nin sırtında da Luffy var!Dialogue: 0,0:16:22.01,0:16:23.75,Main,,0,0,0,,Yaşasın!Dialogue: 0,0:16:23.75,0:16:25.67,Main,,0,0,0,,Sanji'den de bu beklenirdi!Dialogue: 0,0:16:25.67,0:16:26.98,Main,,0,0,0,,Luffy!Dialogue: 0,0:16:30.78,0:16:33.68,Main,,0,0,0,,Sunny-go'ya vardık Luffy!Dialogue: 0,0:16:34.21,0:16:37.28,Main,,0,0,0,,Yemek daha olmadı mı ya Sanji?Dialogue: 0,0:16:40.06,0:16:43.92,Captions,,0,0,235,,Mont d'or'un Taktiksel Operasyon Merkezi Tatlı Şehri, Whole Cake AdasıDialogue: 0,0:16:43.92,0:16:46.00,Main,,0,0,0,,Peros abi!Dialogue: 0,0:16:46.00,0:16:48.85,Main,,0,0,0,,Cevap ver lütfen! Mama ne durumda?Dialogue: 0,0:16:48.85,0:16:50.84,Main,,0,0,0,,Bege'ye ne oldu? Ya pasta?Dialogue: 0,0:16:50.84,0:16:55.60,Main,,0,0,0,,Vaziyet Kakao Adası'ndan da beter bir hâl alacak! Peros abi!Dialogue: 0,0:16:56.22,0:16:59.98,Captions,,0,0,10,,Denizde - Big Mom ve MürettebatıDialogue: 0,0:16:57.05,0:16:59.98,Main,,0,0,0,,Cevap ver lütfen Peros abi!Dialogue: 0,0:16:59.98,0:17:02.29,Main,,0,0,0,,Biliyoruz be!Dialogue: 0,0:17:04.99,0:17:08.78,Main,,0,0,0,,Gözüm hâlâ hem Mama'nın hem de Bege'nin üzerinde!Dialogue: 0,0:17:08.78,0:17:11.72,Main,,0,0,0,,Ha? Neyin var Peros abi?Dialogue: 0,0:17:15.58,0:17:18.58,Main,,0,0,0,,Mont d'Or abi! Benim, Bavarois!Dialogue: 0,0:17:18.58,0:17:24.79,Main,,0,0,0,,Peros abi epeydir kolunu tedavi ettirmediği için güçten düştü!Dialogue: 0,0:17:24.79,0:17:26.02,Main,,0,0,0,,Ne?Dialogue: 0,0:17:26.02,0:17:29.04,Main,,0,0,0,,Şimdi bunun sırası değil-perorin!Dialogue: 0,0:17:29.04,0:17:30.17,Main,,0,0,0,,Ver şunu!Dialogue: 0,0:17:32.45,0:17:38.27,Main,,0,0,0,,Kabartma Adası civar sularındayız! Burası da bildiğin ana baba günü.Dialogue: 0,0:17:38.27,0:17:42.79,Main,,0,0,0,,Chiffon'la Bege nihayet pastayı verdi!Dialogue: 0,0:17:42.79,0:17:47.14,Main,,0,0,0,,Pasta ise Kabartma Adası'nda-perorin!Dialogue: 0,0:17:47.14,0:17:50.89,Main,,0,0,0,,Birkaç dakikaya tüm curcuna bitecek!Dialogue: 0,0:17:51.61,0:17:56.09,Main,,0,0,0,,Pastaya zehir atılmışsa da...Dialogue: 0,0:17:56.09,0:17:58.92,Main,,0,0,0,,...elimizden bir şey gelmez artık!Dialogue: 0,0:18:02.33,0:18:06.57,Main,,0,0,0,,İçinde bulunduğumuz durumun üç olası akıbeti var.Dialogue: 0,0:18:06.57,0:18:10.28,Main,,0,0,0,,İlki, zehirli pastayı yiyince...Dialogue: 0,0:18:11.48,0:18:13.24,Main,,0,0,0,,...Mama ölür!Dialogue: 0,0:18:21.19,0:18:24.65,Main,,0,0,0,,İkincisi, zehir Mama'ya tesir etmese de...Dialogue: 0,0:18:24.65,0:18:26.67,Main,,0,0,0,,...pastanın tadı kötüdür!Dialogue: 0,0:18:26.67,0:18:27.71,Main,,0,0,0,,İğrenç!Dialogue: 0,0:18:28.16,0:18:33.55,Main,,0,0,0,,Bu durumda da Mama tatmin olmayıp ülkeyi yerle bir etmeye devam edecektir!Dialogue: 0,0:18:33.55,0:18:35.51,Main,,0,0,0,,Üçüncü ihtimalde ise...Dialogue: 0,0:18:35.51,0:18:39.03,Main,,0,0,0,,...ne zehir tesir eder ne de pastanın tadı kötüdür!Dialogue: 0,0:18:39.03,0:18:43.36,Main,,0,0,0,,Bunun için bi' mucize gerekse de tek kurtuluş yolumuz oluyor!Dialogue: 0,0:18:43.36,0:18:45.73,Main,,0,0,0,,Kendinizi hazırlayın!Dialogue: 0,0:18:45.73,0:18:50.25,Main,,0,0,0,,Kaderimiz tamamen pastanın tadına bağlı!Dialogue: 0,0:18:52.67,0:18:55.16,Main,,0,0,0,,Daha kötüsü olamazdı-soir!Dialogue: 0,0:18:55.16,0:18:58.12,Main,,0,0,0,,Tüm ülkeye haber salın!Dialogue: 0,0:18:58.12,0:18:59.75,Main,,0,0,0,,Bilmeyen yok zaten!Dialogue: 0,0:18:59.75,0:19:02.40,Main,,0,0,0,,Mama'nın gözü dönmüş!Dialogue: 0,0:19:02.40,0:19:05.35,Main,,0,0,0,,Çerez Adası'nın yok edildiğini işittim.Dialogue: 0,0:19:05.35,0:19:06.04,Main,,0,0,0,,Ne?Dialogue: 0,0:19:06.04,0:19:09.05,Main,,0,0,0,,Totto Land'a n'olacak peki?Dialogue: 0,0:19:09.05,0:19:13.49,Main,,0,0,0,,Pastayla Rus ruleti oynuyoruz resmen-bon!Dialogue: 0,0:19:14.68,0:19:18.22,Main,,0,0,0,,Baksanıza,  Morgans ile Stussy nereye kayboldu?Dialogue: 0,0:19:18.22,0:19:20.48,Main,,0,0,0,,Demin adadan ayrıldılar.Dialogue: 0,0:19:20.48,0:19:21.77,Main,,0,0,0,,Ne?Dialogue: 0,0:19:21.77,0:19:23.42,Main,,0,0,0,,Yakalayın hemen!Dialogue: 0,0:19:23.42,0:19:28.61,Main,,0,0,0,,Olur da her şey kötü giderse yaşananları tüm dünya öğrenir!Dialogue: 0,0:19:28.61,0:19:29.49,Main,,0,0,0,,Emredersiniz!Dialogue: 0,0:19:30.24,0:19:36.20,Main,,0,0,0,,Hele ki şu gazeteci yavşağı sakın ülkeden çıkartmayın!Dialogue: 0,0:19:36.20,0:19:38.95,Main,,0,0,0,,Her haltı basabilir!Dialogue: 0,0:19:38.95,0:19:42.87,Main,,0,0,0,,Bu adanın işi bitti! Kaçalım!Dialogue: 0,0:19:43.21,0:19:47.21,Captions,,0,0,10,,Pofuduk Şehri - Kabartma AdasıDialogue: 0,0:19:42.87,0:19:47.21,Main,,0,0,0,,Tıpkı Çerez Adası gibi Mama tarafından yok edilecek!Dialogue: 0,0:19:47.21,0:19:51.92,Main,,0,0,0,,Hain Bege de Chiffon-sama'nın beynini yıkamış!Dialogue: 0,0:19:55.55,0:19:57.55,Main,,0,0,0,,Chiffon! Neden bahsediyorsun sen?Dialogue: 0,0:19:59.81,0:20:04.98,Main,,0,0,0,,Kara Bacak'ın kendi elleriyle hazırladığı pastaya inandığım için duruyorum.Dialogue: 0,0:20:05.49,0:20:08.42,Main,,0,0,0,,Nereden ve kimlerden öğrendiğini bilmesem de...Dialogue: 0,0:20:08.42,0:20:13.11,Main,,0,0,0,,...aşçılığı Baş Şef'ten dahi iyi olabilir!Dialogue: 0,0:20:16.99,0:20:18.20,Main,,0,0,0,,Vito! Gotti!Dialogue: 0,0:20:18.97,0:20:22.59,Main,,0,0,0,,Kaçışımız için gemi aramaya koyulun!Dialogue: 0,0:20:22.59,0:20:25.32,Main,,0,0,0,,Chiffon'u da alıp geleceğim ben!Dialogue: 0,0:20:25.32,0:20:27.66,Main,,0,0,0,,T- Tamam-rero!Dialogue: 0,0:20:27.66,0:20:28.99,Main,,0,0,0,,Anlaşıldı!Dialogue: 0,0:20:28.99,0:20:31.95,Main,,0,0,0,,Hasır Şapkalar'a olan borcumuzu ödedik.Dialogue: 0,0:20:31.95,0:20:34.33,Main,,0,0,0,,Yeri doldurulmaz gemimizden de olduk.Dialogue: 0,0:20:34.33,0:20:36.85,Main,,0,0,0,,Hasır Şapka dangalakları...Dialogue: 0,0:20:36.85,0:20:40.42,Main,,0,0,0,,...onlar için girdiğimiz bunca külfetten sonra da ölürlerse yakalarını bırakmam!Dialogue: 0,0:20:50.43,0:20:52.89,Main,,0,0,0,,Düğün...Dialogue: 0,0:21:00.32,0:21:04.60,Main,,0,0,0,,...pastası!Dialogue: 0,0:21:09.80,0:21:13.29,Main,,0,0,0,,Yaşasın! Döndüler!Dialogue: 0,0:21:13.29,0:21:14.60,Main,,0,0,0,,Luffy!Dialogue: 0,0:21:14.60,0:21:15.64,Main,,0,0,0,,Sanji!Dialogue: 0,0:21:15.64,0:21:16.63,Main,,0,0,0,,Luffy-san!Dialogue: 0,0:21:16.63,0:21:18.48,Main,,0,0,0,,Luffy!Dialogue: 0,0:21:21.05,0:21:23.02,Main,,0,0,0,,Şükürler olsun ki bir şeyin yok!Dialogue: 0,0:21:23.02,0:21:25.76,Main,,0,0,0,,Çok mutluyum ya! Anlatamam!Dialogue: 0,0:21:27.44,0:21:30.18,Main,,0,0,0,,Nasıl da yere bere içinde kalmış...Dialogue: 0,0:21:31.27,0:21:34.14,Main,,0,0,0,,Helal olsun! Luffy! Sanji!Dialogue: 0,0:21:34.14,0:21:36.43,Main,,0,0,0,,Çok endişelendim ya Luffy!Dialogue: 0,0:21:36.43,0:21:38.60,Main,,0,0,0,,Garchu!Dialogue: 0,0:21:40.75,0:21:43.57,Main,,0,0,0,,Çocuklar... Beni amma beklettiniz ha!Dialogue: 0,0:21:43.57,0:21:45.11,Main,,0,0,0,,Hadi oradan be!Dialogue: 0,0:21:45.11,0:21:48.28,Main,,0,0,0,,Luffy... Katakuri'yi yendin mi?Dialogue: 0,0:21:51.43,0:21:52.41,Main,,0,0,0,,Evet!Dialogue: 0,0:21:52.41,0:21:53.60,Main,,0,0,0,,Süper ya!Dialogue: 0,0:21:53.60,0:21:56.21,Main,,0,0,0,,Senden de bu beklenirdi Luffy-san!Dialogue: 0,0:21:58.50,0:21:59.42,Main,,0,0,0,,Öylece uyudu mu?Dialogue: 0,0:21:59.42,0:22:01.89,Main,,0,0,0,,Kesiklerle morluklar daha duruyor.Dialogue: 0,0:22:01.89,0:22:06.98,Main,,0,0,0,,Chopper-san, tedavi ediver! Ciddi kanaması var, değil mi?Dialogue: 0,0:22:06.98,0:22:07.86,Main,,0,0,0,,Evet!Dialogue: 0,0:22:17.19,0:22:20.25,Main,,0,0,0,,Sanji, sen de vurulmuşsun!Dialogue: 0,0:22:21.57,0:22:24.58,Main,,0,0,0,,Önemli bir şey değil ya.Dialogue: 0,0:22:31.60,0:22:33.98,Main,,0,0,0,,Güzel! Her an isabet ettirebiliriz!Dialogue: 0,0:22:36.41,0:22:39.36,Main,,0,0,0,,Göz açıp kapayıncaya kadar kuyruğumuzda bitmişler!Dialogue: 0,0:22:39.36,0:22:43.16,Main,,0,0,0,,Onlardan kurtulabilmiş değiliz! Seyir hâlindeyken tedaviye başlayın!Dialogue: 0,0:22:43.16,0:22:44.60,Main,,0,0,0,,Peki!Dialogue: 0,0:23:05.26,0:23:06.51,Main,,0,0,0,,Ateş!Dialogue: 0,0:23:19.65,0:23:20.82,Main,,0,0,0,,N'oluyor be?Dialogue: 0,0:23:27.35,0:23:29.45,Main,,0,0,0,,Germa arka çıkıyor!Dialogue: 0,0:23:29.45,0:23:31.37,Main,,0,0,0,,Yere batasıca Judge!Dialogue: 0,0:23:32.10,0:23:33.66,Main,,0,0,0,,Karşılık verelim mi?Dialogue: 0,0:23:33.66,0:23:35.69,Main,,0,0,0,,Hayır, tenezzül etme!Dialogue: 0,0:23:35.69,0:23:39.21,Main,,0,0,0,,Germa aynı zamanda limandaki filo ile savaşıyor!Dialogue: 0,0:23:39.21,0:23:41.26,Main,,0,0,0,,Hasır Şapka'nın gemisine nişan alın!Dialogue: 0,0:23:41.26,0:23:42.00,Main,,0,0,0,,Baş üstüne!Dialogue: 0,0:24:10.68,0:24:14.66,Main,,0,0,0,,O adamda ne buldun ki Hasır Şapka Luffy?Dialogue: 0,0:24:16.58,0:24:19.96,Main,,0,0,0,,Bir kez adımını attın mı tekrar gün yüzü göremeyeceğin...Dialogue: 0,0:24:19.96,0:24:23.04,Main,,0,0,0,,...Yonkou Big Mom'ın çöplüğündeyiz!Dialogue: 0,0:24:23.04,0:24:27.51,Main,,0,0,0,,Sırf onu kurtarmak için mi hayatını tehlikeye attın?Dialogue: 0,0:24:27.51,0:24:31.32,Main,,0,0,0,,Sanji, Germa'nın yüz karasıdır!Dialogue: 0,0:24:32.86,0:24:35.92,Main,,0,0,0,,Derisi kalkan görevi görmez!Dialogue: 0,0:24:38.54,0:24:43.12,Main,,0,0,0,,Bir nebze dahi asillik gururu olmadığından aşçılık yapar!Dialogue: 0,0:24:44.21,0:24:45.42,Main,,0,0,0,,Evet.Dialogue: 0,0:24:46.04,0:24:48.84,Main,,0,0,0,,Budalanın teki gibi duygularıyla oynandı.Dialogue: 0,0:24:49.88,0:24:56.18,Main,,0,0,0,,Saflığı yüzünden yardıma muhtaçlar için kendi canını ortaya koydu!Dialogue: 0,0:24:56.18,0:25:00.93,Main,,0,0,0,,Bir asker için biçilmiş kaftan olmaktan ziyadesiyle ırak, yüz karası...Dialogue: 0,0:25:00.93,0:25:03.41,Main,,0,0,0,,...bir adam işte!Dialogue: 0,0:25:09.10,0:25:11.81,Main,,0,0,0,,Hoşça kalın! Desteğiniz için sağ olun!Dialogue: 0,0:25:12.56,0:25:14.85,Main,,0,0,0,,Cevap versene lan!Dialogue: 0,0:25:15.31,0:25:17.48,Main,,0,0,0,,Hasır Şapka!Dialogue: 0,0:25:17.92,0:25:23.32,Main,,0,0,0,,Şaştım kaldım ha.  Ne diye birdenbire seni övüp durdu ki?Dialogue: 0,0:25:23.32,0:25:27.11,Main,,0,0,0,,Ne? O anlamda söylemedi ki!Dialogue: 0,0:25:27.11,0:25:28.21,Main,,0,0,0,,Ne?Dialogue: 0,0:25:31.47,0:25:33.87,Main,,0,0,0,,Sizin gibilerini daha önce hiç görmedim var ya!Dialogue: 0,0:25:40.63,0:25:42.19,Main,,0,0,0,,Neden ya, söylesene!Dialogue: 0,0:25:42.19,0:25:43.57,Main,,0,0,0,,Ne?Dialogue: 0,0:25:43.57,0:25:45.69,Main,,0,0,0,,Hayır! Olamaz!Dialogue: 0,0:25:47.04,0:25:50.63,Main,,0,0,0,,Jinbe! Pruvada koca bir filo var!Dialogue: 0,0:25:50.63,0:25:52.65,Main,,0,0,0,,Hangi ara geldiler ki?Dialogue: 0,0:25:53.62,0:25:55.53,Main,,0,0,0,,Yeni fark ettiler!Dialogue: 0,0:25:56.99,0:25:58.41,Main,,0,0,0,,Yüzlerce gemi var!Dialogue: 0,0:25:58.41,0:26:01.28,Main,,0,0,0,,N'apacağız ya? Yine kıskaçta kalacağız!Dialogue: 0,0:26:01.28,0:26:01.33,Captions,,0,0,0,,GERMA 66Dialogue: 0,0:26:01.33,0:26:01.37,Captions,,0,0,0,,GERMA 66Dialogue: 0,0:26:01.37,0:26:01.41,Captions,,0,0,0,,GERMA 66Dialogue: 0,0:26:01.41,0:26:01.45,Captions,,0,0,0,,GERMA 66Dialogue: 0,0:26:01.45,0:26:01.49,Captions,,0,0,0,,GERMA 66Dialogue: 0,0:26:01.49,0:26:01.53,Captions,,0,0,0,,GERMA 66Dialogue: 0,0:26:01.53,0:26:01.58,Captions,,0,0,0,,GERMA 66Dialogue: 0,0:26:01.58,0:26:01.62,Captions,,0,0,0,,GERMA 66Dialogue: 0,0:26:01.62,0:26:01.66,Captions,,0,0,0,,GERMA 66Dialogue: 0,0:26:01.66,0:26:01.70,Captions,,0,0,0,,GERMA 66Dialogue: 0,0:26:01.70,0:26:01.74,Captions,,0,0,0,,GERMA 66Dialogue: 0,0:26:01.74,0:26:01.79,Captions,,0,0,0,,GERMA 66Dialogue: 0,0:26:01.79,0:26:01.83,Captions,,0,0,0,,GERMA 66Dialogue: 0,0:26:01.83,0:26:01.87,Captions,,0,0,0,,GERMA 66Dialogue: 0,0:26:01.87,0:26:01.91,Captions,,0,0,0,,GERMA 66Dialogue: 0,0:26:01.91,0:26:01.95,Captions,,0,0,0,,GERMA 66Dialogue: 0,0:26:01.95,0:26:01.99,Captions,,0,0,0,,GERMA 66Dialogue: 0,0:26:01.99,0:26:02.04,Captions,,0,0,0,,GERMA 66Dialogue: 0,0:26:02.04,0:26:02.08,Captions,,0,0,0,,GERMA 66Dialogue: 0,0:26:02.08,0:26:02.12,Captions,,0,0,0,,GERMA 66Dialogue: 0,0:26:02.12,0:26:02.16,Captions,,0,0,0,,GERMA 66Dialogue: 0,0:26:02.16,0:26:02.20,Captions,,0,0,0,,GERMA 66Dialogue: 0,0:26:02.20,0:26:02.24,Captions,,0,0,0,,GERMA 66Dialogue: 0,0:26:02.24,0:26:02.29,Captions,,0,0,0,,GERMA 66Dialogue: 0,0:26:02.29,0:26:02.33,Captions,,0,0,0,,GERMA 66Dialogue: 0,0:26:02.33,0:26:02.37,Captions,,0,0,0,,GERMA 66Dialogue: 0,0:26:02.37,0:26:02.41,Captions,,0,0,0,,GERMA 66Dialogue: 0,0:26:02.41,0:26:02.45,Captions,,0,0,0,,GERMA 66Dialogue: 0,0:26:02.45,0:26:02.49,Captions,,0,0,0,,GERMA 66Dialogue: 0,0:26:02.49,0:26:02.54,Captions,,0,0,0,,GERMA 66Dialogue: 0,0:26:02.54,0:26:02.58,Captions,,0,0,0,,GERMA 66Dialogue: 0,0:26:02.58,0:26:02.62,Captions,,0,0,0,,GERMA 66Dialogue: 0,0:26:02.62,0:26:02.66,Captions,,0,0,0,,GERMA 66Dialogue: 0,0:26:02.66,0:26:02.70,Captions,,0,0,0,,GERMA 66Dialogue: 0,0:26:02.70,0:26:02.74,Captions,,0,0,0,,GERMA 66Dialogue: 0,0:26:02.74,0:26:02.79,Captions,,0,0,0,,GERMA 66D