70,Main,,0,0,0,,it will also reflect it back!Dialogue: 0,0:06:45.13,0:06:46.88,Main,,0,0,0,,Be careful, Carrot!Dialogue: 0,0:06:47.64,0:06:48.93,Main,,0,0,0,,I'll break your stupid mirror!Dialogue: 0,0:06:49.07,0:06:50.64,Brulee,,0,0,0,fx,MDialogue: 0,0:06:49.07,0:06:50.64,Brulee,,0,0,0,fx,iDialogue: 0,0:06:49.10,0:06:50.83,Brulee,,0,0,0,fx,rDialogue: 0,0:06:49.10,0:06:50.83,Brulee,,0,0,0,fx,rDialogue: 0,0:06:49.10,0:06:50.83,Brulee,,0,0,0,fx,oDialogue: 0,0:06:49.13,0:06:51.42,Brulee,,0,0,0,fx,-Dialogue: 0,0:06:49.16,0:06:51.66,Brulee,,0,0,0,fx,wDialogue: 0,0:06:49.16,0:06:51.66,Brulee,,0,0,0,fx,oDialogue: 0,0:06:49.16,0:06:51.66,Brulee,,0,0,0,fx,rDialogue: 0,0:06:49.19,0:06:52.46,Brulee,,0,0,0,fx,lDialogue: 0,0:06:49.19,0:06:52.46,Brulee,,0,0,0,fx,dDialogue: 0,0:06:49.19,0:06:52.46,Brulee,,0,0,0,fx,!Dialogue: 1,0:06:49.53,0:06:53.40,Brulee,,0,0,0,fx,MDialogue: 1,0:06:49.53,0:06:53.41,Brulee,,0,0,0,fx,iDialogue: 1,0:06:49.84,0:06:50.53,Brulee,,0,0,0,fx,MiDialogue: 1,0:06:50.03,0:06:51.12,Brulee,,0,0,0,fx,rroDialogue: 1,0:06:50.12,0:06:53.42,Brulee,,0,0,0,fx,rDialogue: 1,0:06:50.12,0:06:53.43,Brulee,,0,0,0,fx,rDialogue: 1,0:06:50.12,0:06:53.44,Brulee,,0,0,0,fx,oDialogue: 1,0:06:50.33,0:06:53.41,Brulee,,0,0,0,fx,MiDialogue: 1,0:06:50.36,0:06:53.45,Brulee,,0,0,0,fx,-Dialogue: 1,0:06:50.62,0:06:51.36,Brulee,,0,0,0,fx,-Dialogue: 1,0:06:50.86,0:06:52.16,Brulee,,0,0,0,fx,worDialogue: 1,0:06:50.92,0:06:53.44,Brulee,,0,0,0,fx,rroDialogue: 1,0:06:51.16,0:06:53.47,Brulee,,0,0,0,fx,-Dialogue: 1,0:06:51.16,0:06:53.46,Brulee,,0,0,0,fx,wDialogue: 1,0:06:51.16,0:06:53.47,Brulee,,0,0,0,fx,oDialogue: 1,0:06:51.16,0:06:53.48,Brulee,,0,0,0,fx,rDialogue: 1,0:06:51.66,0:06:52.80,Brulee,,0,0,0,fx,ld!Dialogue: 1,0:06:51.80,0:06:53.49,Brulee,,0,0,0,fx,lDialogue: 1,0:06:51.80,0:06:53.50,Brulee,,0,0,0,fx,dDialogue: 1,0:06:51.80,0:06:53.51,Brulee,,0,0,0,fx,!Dialogue: 1,0:06:51.96,0:06:53.50,Brulee,,0,0,0,fx,worDialogue: 1,0:06:52.60,0:06:53.53,Brulee,,0,0,0,fx,ld!Dialogue: 0,0:07:00.04,0:07:00.98,Main,,0,0,0,,Carrot!Dialogue: 0,0:07:11.38,0:07:13.57,Main,,0,0,0,,What did you do to her?!Dialogue: 0,0:07:20.29,0:07:21.83,Main,,0,0,0,,That's the first!Dialogue: 0,0:07:21.83,0:07:24.96,Main,,0,0,0,,I can't get out! Let me out!Dialogue: 0,0:07:24.96,0:07:28.08,Main,,0,0,0,,What did you do?! Let Carrot go!Dialogue: 0,0:07:28.08,0:07:29.17,Main,,0,0,0,,Stay away, Nami!Dialogue: 0,0:07:29.99,0:07:32.37,Main,,0,0,0,,I can't do that.Dialogue: 0,0:07:34.49,0:07:36.43,Main,,0,0,0,,Nami!Dialogue: 0,0:07:36.43,0:07:37.89,Main,,0,0,0,,Chopper!Dialogue: 0,0:07:39.06,0:07:40.94,Main,,0,0,0,,Help me!Dialogue: 0,0:07:44.28,0:07:49.08,Main,,0,0,0,,Mama already knows that you guys are here!Dialogue: 0,0:07:49.08,0:07:49.95,Main,,0,0,0,,What?!Dialogue: 0,0:07:49.95,0:07:54.62,Main,,0,0,0,,Did you think no one knew?! How idiotic!Dialogue: 0,0:08:09.58,0:08:15.93,Main,,0,0,0,,We're all coming after you now. Mama ordered us to!Dialogue: 0,0:08:15.93,0:08:17.26,Main,,0,0,0,,That one...Dialogue: 0,0:08:17.26,0:08:18.61,Main,,0,0,0,,And them...Dialogue: 0,0:08:18.61,0:08:20.21,Main,,0,0,0,,Those fools...Dialogue: 0,0:08:20.21,0:08:21.52,Main,,0,0,0,,And him!Dialogue: 0,0:08:21.52,0:08:25.35,Main,,0,0,0,,We've all been told to...Dialogue: 0,0:08:26.24,0:08:30.37,Main,,0,0,0,,"Let the Straw Hats keep going for now."Dialogue: 0,0:08:30.37,0:08:33.40,Main,,0,0,0,,"Just don't let them find Sanji."Dialogue: 0,0:08:33.40,0:08:38.24,Main,,0,0,0,,"Make them regret trying to mess with me!"Dialogue: 0,0:08:45.63,0:08:50.02,Main,,0,0,0,,Mama knows everything!Dialogue: 0,0:08:56.09,0:08:59.76,Main,,0,0,0,,Alright, Homies! Don't let them escape!Dialogue: 0,0:09:03.68,0:09:05.85,Main,,0,0,0,,You can't get away!Dialogue: 0,0:09:12.06,0:09:13.90,Main,,0,0,0,,No!Dialogue: 0,0:09:13.90,0:09:15.36,Main,,0,0,0,,Chopper!Dialogue: 0,0:09:30.09,0:09:32.38,Main,,0,0,0,,Nami, run!Dialogue: 0,0:09:32.38,0:09:36.55,Main,,0,0,0,,There are too many of them! If all three of us get caught, it'll be the end for us!Dialogue: 0,0:09:37.67,0:09:42.31,Main,,0,0,0,,They're members of an Emperor's crew! We underestimated them!Dialogue: 0,0:09:42.31,0:09:45.89,Main,,0,0,0,,Go look for Luffy! I'll do the best I can here!Dialogue: 0,0:09:46.85,0:09:49.39,Main,,0,0,0,,Okay! I'll be back!Dialogue: 0,0:09:52.41,0:09:52.66,Chopper,,0,0,0,fx,RumDialogue: 0,0:09:52.51,0:09:52.89,Chopper,,0,0,0,fx,ble!Dialogue: 1,0:09:52.66,0:09:52.89,Chopper,,0,0,0,fx,RumDialogue: 0,0:09:52.66,0:09:52.94,Chopper,,0,0,0,fx,m 9 23 b 8 22 7 21 6 20 b 4 18 3 16 2 12 b 2 9 3 5 4 3 b 5 2 6 1 7 1 b 8 3 8 4 9 5 b 10 4 10 3 11 1 b 13 2 14 3 14 3 b 15 5 16 8 16 12 b 15 16 14 18 12 20 b 11 21 10 22 9 9 b 8 22 7 21 5 19 b 4 18 2 16 1 11 b 1 8 2 5 4 3 b 5 2 6 1 7 1 b 8 3 8 4 9 5 b 10 4 10 3 11 1 b 13 2 14 3 14 3 b 16 5 17 8 17 11 b 16 16 14 18 13 19 b 11 21 10 22 9 23Dialogue: 0,0:09:52.66,0:09:52.94,Chopper,,0,0,0,fx,m 9 23 b 8 22 7 21 6 20 b 4 18 3 16 2 12 b 2 9 3 5 4 3 b 5 2 6 1 7 1 b 8 3 8 4 9 5 b 10 4 10 3 11 1 b 13 2 14 3 14 3 b 15 5 16 8 16 12 b 15 16 14 18 12 20 b 11 21 10 22 9 9 b 8 22 7 21 5 19 b 4 18 2 16 1 11 b 1 8 2 5 4 3 b 5 2 6 1 7 1 b 8 3 8 4 9 5 b 10 4 10 3 11 1 b 13 2 14 3 14 3 b 16 5 17 8 17 11 b 16 16 14 18 13 19 b 11 21 10 22 9 23Dialogue: 0,0:09:52.66,0:09:52.94,Chopper,,0,0,0,fx,m 9 23 b 8 22 7 21 6 20 b 4 18 3 16 2 12 b 2 9 3 5 4 3 b 5 2 6 1 7 1 b 8 3 8 4 9 5 b 10 4 10 3 11 1 b 13 2 14 3 14 3 b 15 5 16 8 16 12 b 15 16 14 18 12 20 b 11 21 10 22 9 9 b 8 22 7 21 5 19 b 4 18 2 16 1 11 b 1 8 2 5 4 3 b 5 2 6 1 7 1 b 8 3 8 4 9 5 b 10 4 10 3 11 1 b 13 2 14 3 14 3 b 16 5 17 8 17 11 b 16 16 14 18 13 19 b 11 21 10 22 9 23Dialogue: 0,0:09:52.66,0:09:52.94,Chopper,,0,0,0,fx,m 9 23 b 8 22 7 21 6 20 b 4 18 3 16 2 12 b 2 9 3 5 4 3 b 5 2 6 1 7 1 b 8 3 8 4 9 5 b 10 4 10 3 11 1 b 13 2 14 3 14 3 b 15 5 16 8 16 12 b 15 16 14 18 12 20 b 11 21 10 22 9 9 b 8 22 7 21 5 19 b 4 18 2 16 1 11 b 1 8 2 5 4 3 b 5 2 6 1 7 1 b 8 3 8 4 9 5 b 10 4 10 3 11 1 b 13 2 14 3 14 3 b 16 5 17 8 17 11 b 16 16 14 18 13 19 b 11 21 10 22 9 23D