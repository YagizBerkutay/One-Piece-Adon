2.2,0,7,10,10,10,1Style: Author,Impress BT,22.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.7,0.7,9,10,10,10,1Style: Attack,Duality,30.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.0,1.0,7,12,12,12,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:01:41.28,0:01:46.26,Main,,0,0,0,,Tatlı mı tatlı.. Miskincik!Dialogue: 0,0:01:43.32,0:01:46.26,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - dmc3 thx to onepace.netDialogue: 0,0:14:40.80,0:14:50.80,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - dmc3 thx to onepace.netDialogue: 0,0:33:20.84,0:33:25.90,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - dmc3 thx to onepace.netDialogue: 0,0:01:43.32,0:01:46.26,Title,,0,0,250,,Dalga OdasıDialogue: 0,0:02:04.71,0:02:09.14,Main,,0,0,0,,O da ne demek? Neler oluyor orada?Dialogue: 0,0:02:09.14,0:02:11.07,Main,,0,0,0,,Cevap verin çocuklar!Dialogue: 0,0:02:11.07,0:02:13.67,Main,,0,0,0,,Bizi yutarsa işimiz bitmiştir!Dialogue: 0,0:02:13.67,0:02:16.22,Main,,0,0,0,,Sahi! Coup de Burst!Dialogue: 0,0:02:17.51,0:02:21.49,Main,,0,0,0,,Kullanamayız! Yeterince kolamız yok!Dialogue: 0,0:02:21.49,0:02:25.60,Main,,0,0,0,,Pedro, özür dilerim!  Bizi kurtarmak için kendini feda ettiysen de...Dialogue: 0,0:02:42.39,0:02:44.88,Main,,0,0,0,,Bana kulak verin!Dialogue: 0,0:02:46.10,0:02:49.85,Main,,0,0,0,,Pastam!Dialogue: 0,0:02:55.28,0:02:57.52,Main,,0,0,0,,Bekle! Bekle bekle!Dialogue: 0,0:02:57.52,0:03:00.23,Main,,0,0,0,,Bir saniye bekle, Mama!Dialogue: 0,0:03:00.23,0:03:03.71,Main,,0,0,0,,Böyle yaparsan pasta da denizin dibini boylar!Dialogue: 0,0:03:03.71,0:03:06.09,Main,,0,0,0,,Mama!Dialogue: 0,0:03:06.09,0:03:06.85,Main,,0,0,0,,Acele edin!Dialogue: 0,0:03:06.85,0:03:07.73,Main,,0,0,0,,Tamam!Dialogue: 0,0:03:11.96,0:03:15.26,Main,,0,0,0,,O- Oldu mu Jinbe-san?Dialogue: 0,0:03:15.28,0:03:18.20,Main,,0,0,0,,Evet, iş görür!Dialogue: 0,0:03:18.20,0:03:23.06,Main,,0,0,0,,İyi de akıl işi değil ki! Tüm yelkenleri tek elinle trim* etmeye çalışıyorsun!Dialogue: 0,0:03:26.22,0:03:28.36,Main,,0,0,0,,Nami! Rüzgâr ne durumda?Dialogue: 0,0:03:29.86,0:03:32.74,Main,,0,0,0,,Güneyden şiddetli bir rüzgâr geliyor!Dialogue: 0,0:03:33.23,0:03:34.84,Main,,0,0,0,,Pekâlâ!Dialogue: 0,0:03:34.84,0:03:37.07,Main,,0,0,0,,Ne yapacaksın Jinbe?Dialogue: 0,0:03:43.53,0:03:46.10,Main,,0,0,0,,Çabucak tramola* atacağım!Dialogue: 0,0:03:46.10,0:03:47.60,Main,,0,0,0,,Ne?Dialogue: 0,0:03:47.60,0:03:50.55,Main,,0,0,0,,Dalga geçiyorsun herhâlde! Neden gemiyi çevirmek istiyorsun ki?Dialogue: 0,0:03:51.54,0:03:54.27,Main,,0,0,0,,Yeşil Oda'ya gireceğiz!Dialogue: 0,0:03:54.27,0:03:57.51,Main,,0,0,0,,Geliyoruz! Geliyoruz!Dialogue: 0,0:04:16.19,0:04:18.87,Main,,0,0,0,,Yeşil Oda mı? O da ne?Dialogue: 0,0:04:18.87,0:04:22.70,Main,,0,0,0,,Neden dalganın üzerine gidiyoruz, Jinbe?!Dialogue: 0,0:04:25.22,0:04:29.96,Main,,0,0,0,,Şimdi çaktım!  Yeşil Oda derken cenneti kastediyordun!Dialogue: 0,0:04:29.96,0:04:34.41,Main,,0,0,0,,Doktor! Yanına geliyorum!Dialogue: 0,0:04:36.28,0:04:40.30,Main,,0,0,0,,İşimiz bitti! Kurtulmamız mümkün değil! Gemi sörf yapamaz!Dialogue: 0,0:04:41.57,0:04:43.25,Main,,0,0,0,,Pedro!Dialogue: 0,0:04:49.54,0:04:53.01,Main,,0,0,0,,Sıkı tutunun!Dialogue: 0,0:04:55.42,0:04:58.39,Main,,0,0,0,,Güm!Dialogue: 0,0:05:07.02,0:05:09.78,Main,,0,0,0,,Sorun nedir? Ne oldu?Dialogue: 0,0:05:16.07,0:05:19.02,Main,,0,0,0,,Hey, sesimi alıyor musunuz?Dialogue: 0,0:05:19.02,0:05:22.29,Main,,0,0,0,,Biriniz cevap verin!Dialogue: 0,0:05:25.37,0:05:26.53,Main,,0,0,0,,Ha?Dialogue: 0,0:05:28.78,0:05:33.02,Main,,0,0,0,,Cennette miyiz? Çok güzel...Dialogue: 0,0:05:33.02,0:05:36.34,Main,,0,0,0,,Sağlam geminiz varmış!Dialogue: 0,0:05:36.36,0:05:42.34,Main,,0,0,0,,Yeşil Oda, düşen dalgaların içinde oluşan kısa süreli bir dalga odasıdır.Dialogue: 0,0:05:42.34,0:05:47.96,Main,,0,0,0,,Balık Adam ırkından çocuklar burada oynamaya bayılırlar!Dialogue: 0,0:05:47.96,0:05:50.77,Main,,0,0,0,,Yani burası...Dialogue: 0,0:05:51.76,0:05:54.73,Main,,0,0,0,,Dalganın içinde miyiz?Dialogue: 0,0:05:55.30,0:05:58.01,Main,,0,0,0,,İçinde yelken alacağız! Tutunun!Dialogue: 0,0:06:12.12,0:06:15.83,Main,,0,0,0,,Geminize de rotacınıza da diyecek söz yok!Dialogue: 0,0:06:15.83,0:06:20.68,Main,,0,0,0,,Ustalıkla yönetildiğinde bu gemi yenilgi yüzü görmez!Dialogue: 0,0:06:20.68,0:06:26.26,Main,,0,0,0,,İnanılmaz! Şalopayı kendi uzvu gibi kontrol ediyor resmen!Dialogue: 0,0:06:26.50,0:06:29.65,Main,,0,0,0,,İlk kez böyle bir dümenci görüyorum!Dialogue: 0,0:06:29.65,0:06:32.97,Main,,0,0,0,,Harikasın Jinbe!Dialogue: 0,0:06:32.97,0:06:35.93,Main,,0,0,0,,Ölmeyecek miyiz yani?Dialogue: 0,0:06:45.33,0:06:50.13,Main,,0,0,0,,Düğün...Dialogue: 0,0:06:53.46,0:06:58.02,Main,,0,0,0,,Neyse canım ya...  Pis haşereler hak ettiklerini buldu!Dialogue: 0,0:07:02.00,0:07:03.80,Main,,0,0,0,,Perospero konuşuyor.Dialogue: 0,0:07:03.80,0:07:05.30,Main,,0,0,0,,Dinle Katakuri.Dialogue: 0,0:07:05.30,0:07:08.52,Main,,0,0,0,,Buradakilerin icabına baktık!Dialogue: 0,0:07:08.52,0:07:09.92,Main,,0,0,0,,Ne?Dialogue: 0,0:07:09.92,0:07:12.93,Main,,0,0,0,,Cevap verin, Nami! Brook! Carrot!Dialogue: 0,0:07:12.93,0:07:14.51,Main,,0,0,0,,Tüh ya!Dialogue: 0,0:07:14.51,0:07:17.89,Main,,0,0,0,,Tam da gemiyi basacaktık!Dialogue: 0,0:07:17.89,0:07:19.93,Main,,0,0,0,,Plan yattı çocuklar!Dialogue: 0,0:07:19.93,0:07:24.45,Main,,0,0,0,,Gemi çoktan denizin dibini boylamış anlaşılan.Dialogue: 0,0:07:24.46,0:07:27.40,Main,,0,0,0,,Ama bu işte bir tuhaflık var abla.Dialogue: 0,0:07:27.40,0:07:30.96,Main,,0,0,0,,Aynanın öteki tarafı hiç de denizin altına benzemiyor.Dialogue: 0,0:07:32.21,0:07:33.31,Main,,0,0,0,,Baksana!Dialogue: 0,0:07:33.31,0:07:35.62,Main,,0,0,0,,Mümkün değil!Dialogue: 0,0:07:35.62,0:07:40.59,Main,,0,0,0,,N'olur n'olmaz diye tekrar ok fırlatın ama.Dialogue: 0,0:07:43.84,0:07:47.83,Main,,0,0,0,,İnanmıyorum! Abla! Ayna birden kırılıverdi!Dialogue: 0,0:07:47.83,0:07:50.77,Main,,0,0,0,,Ne? Ne? Nasıl olur?Dialogue: 0,0:07:58.29,0:08:00.87,Main,,0,0,0,,Nami-san! Neden aynayı kırdın ki?Dialogue: 0,0:08:00.87,0:08:04.59,Main,,0,0,0,,Ayna olmadan Luffy-san gemiye dönemez ki!Dialogue: 0,0:08:05.17,0:08:09.91,Flashbacks,,0,0,0,,Bırakın da yalnızca bu herife odaklanayım!Dialogue: 0,0:08:11.89,0:08:16.81,Main,,0,0,0,,Susun da gemideki tüm aynaları kırın!Dialogue: 0,0:08:17.06,0:08:18.04,Main,,0,0,0,,Ama...Dialogue: 0,0:08:18.04,0:08:20.98,Main,,0,0,0,,Luffy'nin işini zorlaştırmak mı istiyorsunuz?Dialogue: 0,0:08:23.52,0:08:26.99,Main,,0,0,0,,Kaptanın emirleri böyle! Acele edin!Dialogue: 0,0:08:28.68,0:08:30.59,Main,,0,0,0,,Hâlâ sağlam aynaları var!Dialogue: 0,0:08:32.77,0:08:34.46,Main,,0,0,0,,Birini buldum Joscar!Dialogue: 0,0:08:34.87,0:08:37.22,Main,,0,0,0,,Ben de buldum Mascar!Dialogue: 0,0:08:40.77,0:08:42.63,Main,,0,0,0,,Bırakıyoruz Joscar!Dialogue: 0,0:08:42.63,0:08:44.60,Main,,0,0,0,,Bırakalım Mascar!Dialogue: 0,0:08:45.36,0:08:47.94,Main,,0,0,0,,Her türlü aynayı bulmaya bakın!Dialogue: 0,0:08:54.23,0:08:55.61,Main,,0,0,0,,Bırakın!Dialogue: 0,0:09:11.17,0:09:12.88,Main,,0,0,0,,Ne?Dialogue: 0,0:09:12.88,0:09:14.89,Main,,0,0,0,,Neler oluyor ya?Dialogue: 0,0:09:19.32,0:09:20.84,Main,,0,0,0,,Böylece bitiyor!Dialogue: 0,0:09:23.90,0:09:26.26,Main,,0,0,0,,Hayattalar mıymış?Dialogue: 0,0:09:26.26,0:09:29.75,Main,,0,0,0,,Peros abi hepsini öldürdüklerini söylemişti oysa.Dialogue: 0,0:09:29.75,0:09:33.51,Main,,0,0,0,,Gemi denizin dibini boyladığından aynalar su basıncından kırılmıştır Joscar!Dialogue: 0,0:09:33.51,0:09:36.70,Main,,0,0,0,,Evet, öyle olmalı Mascar!Dialogue: 0,0:09:36.70,0:09:39.68,Main,,0,0,0,,Bu işte bir terslik var.Dialogue: 0,0:09:41.19,0:09:43.28,Main,,0,0,0,,Hey, Luffy!Dialogue: 0,0:09:45.43,0:09:46.39,Main,,0,0,0,,Sen iyi misin?!Dialogue: 0,0:09:46.72,0:09:47.46,Main,,0,0,0,,Chopper!Dialogue: 0,0:09:50.24,0:09:53.70,Main,,0,0,0,,Konuşmamız lazım, düşmandan uzaklaş hele!Dialogue: 0,0:09:53.70,0:09:54.40,Main,,0,0,0,,Tamam!Dialogue: 0,0:09:56.34,0:09:58.81,Main,,0,0,0,,Hepiniz iyi misiniz?Dialogue: 0,0:09:59.20,0:10:02.17,Main,,0,0,0,,Lan! Hasır Şapka topukluyor!Dialogue: 0,0:10:07.52,0:10:11.74,Main,,0,0,0,,Ne oldu öyle? Şeker müsveddesi Sunny-go'nun alabora olduğunu söyledi!Dialogue: 0,0:10:11.74,0:10:16.53,Main,,0,0,0,,Biz de alabora olacağız sanmıştık! Ama Jinbe dümenciliğini konuşturdu!Dialogue: 0,0:10:21.83,0:10:23.97,Main,,0,0,0,,Hiçbirimiz zarar görmedik Luffy!Dialogue: 0,0:10:24.76,0:10:28.22,Main,,0,0,0,,Luffy-san! Gemideki tüm aynaları kırdık!Dialogue: 0,0:10:28.22,0:10:30.18,Main,,0,0,0,,Tamamdır! Güzel!Dialogue: 0,0:10:30.18,0:10:34.74,Main,,0,0,0,,Artık düşmanlar gemiyi işgal edemeyecek, lakin sen de geri dönemeyeceksin!Dialogue: 0,0:10:34.74,0:10:38.44,Main,,0,0,0,,Evet, sorun değil! Bir çaresini bulacağım.Dialogue: 0,0:10:38.44,0:10:41.57,Main,,0,0,0,,Nah bulursun! Daha kafanda bi' plan bile yok!Dialogue: 0,0:10:41.57,0:10:43.32,Main,,0,0,0,,Pür dikkat dinle şimdi Luffy!Dialogue: 0,0:10:47.65,0:10:51.62,Main,,0,0,0,,Sanji-kun an itibariyle Kakao Adası'nda pasta pişiriyor!Dialogue: 0,0:10:52.51,0:10:54.94,Main,,0,0,0,,Biz de oraya yelken alıyoruz!Dialogue: 0,0:10:54.95,0:10:58.04,Main,,0,0,0,,En erken 10 saate varmış oluruz!Dialogue: 0,0:10:58.04,0:11:00.41,Main,,0,0,0,,Gece saat 1 gibi!Dialogue: 0,0:11:00.41,0:11:03.75,Main,,0,0,0,,Bu yüzden o herifin canına okuduğun gibi...Dialogue: 0,0:11:03.75,0:11:08.38,Main,,0,0,0,,...Kakao Adası'na çıkan bir ayna ara! Orada buluşalım!Dialogue: 0,0:11:12.72,0:11:15.54,Main,,0,0,0,,Sıçayım! Kurtulamıyorum!Dialogue: 0,0:11:20.24,0:11:22.08,Main,,0,0,0,,Bir şey mi oldu Luffy?Dialogue: 0,0:11:22.08,0:11:23.57,Main,,0,0,0,,Dinliyor musun!Dialogue: 0,0:11:40.68,0:11:41.75,Main,,0,0,0,,Luffy!Dialogue: 0,0:11:41.75,0:11:42.96,Main,,0,0,0,,Dinliyorum!Dialogue: 0,0:11:42.96,0:11:44.90,Main,,0,0,0,,Hey! Dediklerime kulak versene!Dialogue: 0,0:12:17.19,0:12:19.20,Main,,0,0,0,,Başı dertte olmasın?Dialogue: 0,0:12:19.20,0:12:20.33,Main,,0,0,0,,Cevap ver lütfen!Dialogue: 0,0:12:20.33,0:12:21.82,Main,,0,0,0,,Luffy!Dialogue: 0,0:12:23.29,0:12:25.37,Main,,0,0,0,,İyi misin, Luffy?!Dialogue: 0,0:12:25.37,0:12:26.58,Main,,0,0,0,,Luffy-san!Dialogue: 0,0:12:55.07,0:12:56.32,Main,,0,0,0,,Yanagi Mochi!Dialogue: 0,0:12:55.07,0:12:56.32,Attack,,0,0,0,,Mochi SöğüdüDialogue: 0,0:13:35.62,0:13:37.21,Main,,0,0,0,,Luffy?Dialogue: 0,0:13:37.21,0:13:39.39,Main,,0,0,0,,Bir şeyin yok, değil mi Luffy-san?Dialogue: 0,0:13:39.78,0:13:42.62,Main,,0,0,0,,N'oldu Luffy?Dialogue: 0,0:14:24.81,0:14:26.98,Main,,0,0,0,,Zaman kaybetmeden adaya varın çocuklar!Dialogue: 0,0:14:28.12,0:14:31.87,Main,,0,0,0,,Yoksa beklemekten ağaç olacağım!Dialogue: 0,0:14:33.72,0:14:35.54,Main,,0,0,0,,Tamamdır!Dialogue: 0,0:14:35.54,0:14:37.87,Main,,0,0,0,,Görüşürüz millet!Dialogue: 0,0:14:37.87,0:14:39.69,Main,,0,0,0,,Görüşürüz!Dialogue: 0,0:14:40.55,0:14:44.23,Main,,0,0,0,,Peşimizdekiler de damlar şimdi! Gözümüzü dört açalım!Dialogue: 0,0:14:44.23,0:14:45.39,Main,,0,0,0,,Anlaşıldı!Dialogue: 0,0:14:45.39,0:14:48.14,Main,,0,0,0,,Gözlem yapmak için köprü üstüne gidelim Carrot!Dialogue: 0,0:14:48.14,0:14:50.43,Main,,0,0,0,,Tamam Choniki!Dialogue: 0,0:15:19.94,0:15:22.71,Main,,0,0,0,,"Böyle bir yerde ölmeyeceğim."...Dialogue: 0,0:15:22.71,0:15:24.63,Main,,0,0,0,,...diyecektin.Dialogue: 0,0:15:27.07,0:15:29.48,Main,,0,0,0,,Son sözlerin bunlar mı yani?Dialogue: 0,0:15:52.83,0:15:56.54,Main,,0,0,0,,Böyle bir yerde ölmeyeceğim!Dialogue: 0,0:15:57.56,0:16:01.50,Main,,0,0,0,,Kimse kendi istediği için ölmez.Dialogue: 0,0:16:02.59,0:16:03.92,Main,,0,0,0,,Ölümler ekseriyetle...Dialogue: 0,0:16:04.52,0:16:06.12,Main,,0,0,0,,...kişinin rızası dışında gerçekleşir.Dialogue: 0,0:16:10.81,0:16:12.14,Main,,0,0,0,,Kesinlikle!Dialogue: 0,0:16:12.14,0:16:14.98,Main,,0,0,0,,Haydi geberip gitsen artık Hasır Şapka!Dialogue: 0,0:16:15.62,0:16:16.44,Main,,0,0,0,,Dal!Dialogue: 0,0:16:16.44,0:16:18.37,Main,,0,0,0,,Adım Brûlée!Dialogue: 0,0:16:18.37,0:16:21.95,Main,,0,0,0,,Yalnızca hırsınla abimi yenebileceğini mi sanıyorsun serseri!Dialogue: 0,0:16:22.46,0:16:26.87,Main,,0,0,0,,Katakuri abim namağlup olmasının yanı sıra...Dialogue: 0,0:16:26.87,0:16:33.52,Main,,0,0,0,,...dünyaya gözlerini açtığından bu yana bir kez olsun sırtı yere gelmemiş bir süper insandır!Dialogue: 0,0:16:33.52,0:16:35.00,Main,,0,0,0,,Konuşma, Brûlée!Dialogue: 0,0:16:35.85,0:16:39.39,Main,,0,0,0,,Doğduğu andan itibaren iki ayağı üzerinde doğrulup...Dialogue: 0,0:16:39.39,0:16:43.09,Main,,0,0,0,,...koltukta uyuduğu rivayet edilir!Dialogue: 0,0:16:43.09,0:16:49.06,Main,,0,0,0,,Hayatı boyunca yatmadı diyorum! Zemine tepki olarak doğmuş bir adam!Dialogue: 0,0:16:50.24,0:16:51.91,Main,,0,0,0,,Her daim asalet saçar!Dialogue: 0,0:16:51.91,0:16:54.19,Main,,0,0,0,,Soğukkanlı ve kudretlidir!Dialogue: 0,0:16:54.19,0:16:56.70,Main,,0,0,0,,Her anlamda kusursuz bir insan!Dialogue: 0,0:16:57.44,0:17:02.26,Main,,0,0,0,,Katakuri abimiz böyle biridir işte!Dialogue: 0,0:17:03.22,0:17:09.08,Main,,0,0,0,,Charlotte ailesinin şaheseriyle senin gibi bir götten bacaklının...Dialogue: 0,0:17:09.08,0:17:12.30,Main,,0,0,0,,...yüzleşmesi bile küstahlığın daniskasıdır!Dialogue: 0,0:17:12.30,0:17:14.81,Main,,0,0,0,,Kes be! Toz ol!Dialogue: 0,0:17:22.05,0:17:25.13,Main,,0,0,0,,Kız kardeşime el sürmeye mi cüret ettin?Dialogue: 0,0:17:26.67,0:17:28.32,Main,,0,0,0,,Abi!Dialogue: 0,0:17:48.84,0:17:50.28,Main,,0,0,0,,Mochi Tsuki!Dialogue: 0,0:17:48.84,0:17:50.28,Attack,,0,0,0,,Mochi SaplayışıDialogue: 0,0:18:01.18,0:18:02.47,Main,,0,0,0,,Belim!Dialogue: 0,0:18:07.00,0:18:08.73,Main,,0,0,0,,Ucuz yırttım ha!Dialogue: 0,0:18:22.81,0:18:24.71,Main,,0,0,0,,Az daha pestilim çıkıyordu!Dialogue: 0,0:18:30.32,0:18:33.18,Main,,0,0,0,,Bu kargının adı Köstebek'tir!Dialogue: 0,0:18:37.16,0:18:42.44,Main,,0,0,0,,Kolların mı yoksa ayakların mı?  Noksanlığı hayatını daha az etkileyecek olanı seç.Dialogue: 0,0:18:43.75,0:18:45.57,Main,,0,0,0,,Bir güzel koparayım!Dialogue: 0,0:18:49.75,0:18:52.65,Main,,0,0,0,,Kellesinden başla abi!Dialogue: 0,0:18:52.65,0:18:54.36,Main,,0,0,0,,Sen konuşma lan!Dialogue: 0,0:19:10.65,0:19:12.95,Main,,0,0,0,,Gomu Gomu no...Dialogue: 0,0:19:12.95,0:19:15.92,Main,,0,0,0,,Giant Rifle!Dialogue: 0,0:19:12.95,0:19:15.92,Attack,,0,0,0,,Dev TüfekDialogue: 0,0:19:29.83,0:19:31.69,Main,,0,0,0,,Konuşmalarınızı duydum...Dialogue: 0,0:19:31.69,0:19:33.63,Main,,0,0,0,,...Hasır Şapka!Dialogue: 0,0:19:34.34,0:19:37.41,Main,,0,0,0,,Buluşma yerinizi!Dialogue: 0,0:19:38.37,0:19:42.32,Main,,0,0,0,,Dalgalarla bi' daha oynamak ister misin Mama?Dialogue: 0,0:19:42.52,0:19:47.53,Captions,,0,1020,315,,Denizde -  Bölge İçindeDialogue: 0,0:19:42.57,0:19:45.12,Main,,0,0,0,,Haydi oynayalım ya!Dialogue: 0,0:19:45.12,0:19:47.53,Main,,0,0,0,,Kime diyo'z Mama?Dialogue: 0,0:19:48.12,0:19:52.12,Main,,0,0,0,,Ne? Gemileri alabora olmamış mı?Dialogue: 0,0:19:52.12,0:19:53.75,Main,,0,0,0,,Emin misin, Brûlée?!Dialogue: 0,0:19:53.75,0:19:56.49,Main,,0,0,0,,Evet, seslerini işittim!Dialogue: 0,0:19:56.52,0:20:01.72,Main,,0,0,0,,Şeker canavarım bir tsunami oluşturup gemilerini yutmuştu ama...Dialogue: 0,0:20:01.72,0:20:04.24,Main,,0,0,0,,Nasıl kaçabildiler ki?Dialogue: 0,0:20:06.95,0:20:09.34,Main,,0,0,0,,Hangi yönteme başvurduklarını bilmiyorum.Dialogue: 0,0:20:09.34,0:20:15.50,Main,,0,0,0,,Lakin hâlâ nefes aldıklarından ve de gece yarısı Kakao Adası'nda buluşacaklarından eminim!Dialogue: 0,0:20:15.51,0:20:20.22,Main,,0,0,0,,Hasır Şapka Luffy ile öyle sözleştiler. Kendi kulaklarımla duydum!Dialogue: 0,0:20:20.22,0:20:22.35,Main,,0,0,0,,Gel gör ki aynı yerin...Dialogue: 0,0:20:22.36,0:20:26.03,Main,,0,0,0,,...bizim de varış noktamız olduğundan bihaberler!Dialogue: 0,0:20:27.16,0:20:32.38,Main,,0,0,0,,Mama! Yemek istediğin pasta Kakao Adası'ndaki Çikolata Şehri'ndeymiş!Dialogue: 0,0:20:32.38,0:20:34.32,Main,,0,0,0,,Sabırsızlanıyorsun, değil mi?Dialogue: 0,0:20:34.80,0:20:37.77,Thoughts,,0,0,0,,Çaresizlikten uydurduğum yalanım...Dialogue: 0,0:20:38.06,0:20:43.37,Thoughts,,0,0,0,,...Mama'yı bu şekilde adaya götürdüm mü açığa çıkmamış olur!Dialogue: 0,0:20:43.37,0:20:48.22,Thoughts,,0,0,0,,Pudding Kakao Adası'nda pastayı pişiriyor!Dialogue: 0,0:20:48.89,0:20:53.37,Thoughts,,0,0,0,,Başımıza ne gelirse gelsin tatlıya bağlayacağım!Dialogue: 0,0:21:03.85,0:21:07.56,Main,,0,0,0,,Düğün pastası!Dialogue: 0,0:21:07.56,0:21:10.15,Main,,0,0,0,,Mama, oraya gidiyoruz demek?Dialogue: 0,0:21:14.20,0:21:18.66,Main,,0,0,0,,Dur dur! Orası Kuru Yemiş Adası!Dialogue: 0,0:21:19.01,0:21:21.51,Main,,0,0,0,,Dursana ya, nereye gidiyorsun?Dialogue: 0,0:21:21.51,0:21:26.63,Main,,0,0,0,,Mama! Gemileri orada değil! Pasta Kakao Adası'na götürülüyor!Dialogue: 0,0:21:26.86,0:21:28.54,Main,,0,0,0,,Düğün...Dialogue: 0,0:21:28.54,0:21:31.42,Main,,0,0,0,,Orada pasta yok Mama! Dur!Dialogue: 0,0:21:28.54,0:21:31.42,Secondary,,0,0,0,,...pastası!Dialogue: 0,0:21:31.42,0:21:34.27,Main,,0,0,0,,O adaya gitme!Dialogue: 0,0:21:34.85,0:21:36.86,Captions,,1020,0,350,,Ayna DünyasıDialogue: 0,0:21:40.33,0:21:41.98,Main,,0,0,0,,Hiç akıllanmıyor.Dialogue: 0,0:21:43.04,0:21:45.07,Main,,0,0,0,,Ağzına sıçtığım!Dialogue: 0,0:21:50.07,0:21:52.15,Main,,0,0,0,,Gomu Gomu no...Dialogue: 0,0:21:53.41,0:21:57.46,Main,,0,0,0,,Grizzly Corkscrew Magnum!Dialogue: 0,0:21:53.41,0:21:57.46,Attack,,0,0,0,,...Dönen Boz Ayı Silahı!Dialogue: 0,0:22:51.07,0:22:52.14,Main,,0,0,0,,Hay içine!Dialogue: 0,0:22:52.14,0:22:55.52,Main,,0,0,0,,Kaçtığımda her zaman bana vurabiliyor!Dialogue: 0,0:22:56.71,0:22:58.54,Main,,0,0,0,,Bu yüzden bitkin düşüyorum.Dialogue: 0,0:23:01.39,0:23:02.75,Main,,0,0,0,,Al benden de o kadar.Dialogue: 0,0:23:04.04,0:23:07.45,Main,,0,0,0,,Şimdiye dek saldırılarımdan bu şekilde kaçınabilen olmamıştı.Dialogue: 0,0:23:08.02,0:23:09.21,Main,,0,0,0,,Stres oluyorum!Dialogue: 0,0:23:25.74,0:23:28.27,Main,,0,0,0,,Köstebek'i elimden almaya çalıştın demek.Dialogue: 0,0:23:30.08,0:23:32.90,Main,,0,0,0,,Sıçayım! Az daha alıyordum!Dialogue: 0,0:23:34.57,0:23:35.91,Main,,0,0,0,,Nagare Mochi!Dialogue: 0,0:23:34.57,0:23:35.91,Attack,,0,0,0,,Akan MochiDialogue: 0,0:23:50.43,0:23:53.64,Main,,0,0,0,,N'oluyor?Dialogue: 0,0:23:55.32,0:23:57.27,Main,,0,0,0,,Zemin mochi'ye dönüştü!Dialogue: 0,0:24:03.66,0:24:06.36,Main,,0,0,0,,Doflamingo da bu tekniği kullanmıştı!Dialogue: 0,0:24:08.08,0:24:10.41,Flashbacks,,0,0,0,,Aç kulaklarını da dinle çaylak!Dialogue: 0,0:24:12.67,0:24:20.51,Flashbacks,,0,0,0,,Şeytan Meyvesi yeteneklerinin  "Uyanış" denilen bir aşaması daha vardır!Dialogue: 0,0:24:21.41,0:24:24.51,Main,,0,0,0,,Benim yeteneğim de uyandı tabii ki.Dialogue: 0,0:24:30.76,0:24:31.96,Main,,0,0,0,,Olamaz!Dialogue: 0,0:24:31.96,0:24:33.73,Main,,0,0,0,,Nafile!Dialogue: 0,0:24:33.73,0:24:37.01,Main,,0,0,0,,Böyle esnek ve yapışkan bir sıvıyla kaplanmışken kılını kıpırdatamazsın.Dialogue: 0,0:24:41.32,0:24:43.68,Main,,0,0,0,,Kelleni mi alsam?Dialogue: 0,0:24:44.00,0:24:47.32,Main,,0,0,0,,Yoksa mochi içinde boğulmanı mı izlesem?Dialogue: 0,0:24:47.32,0:24:49.56,Main,,0,0,0,,Hangisini tercih edersin?Dialogue: 0,0:24:49.56,0:24:51.84,Main,,0,0,0,,Nah ölürüm!Dialogue: 0,0:24:54.98,0:24:56.75,Main,,0,0,0,,Dördüncü Vites mi?Dialogue: 0,0:24:58.00,0:24:59.71,Main,,0,0,0,,Şimdi ilgimi cezbettin.Dialogue: 0,0:25:02.57,0:25:06.59,Captions,,0,0,0,,Whole Cake Adası - Şeker ŞehriDialogue: 0,0:25:11.10,0:25:12.43,Main,,0,0,0,,Çok tuhaf.Dialogue: 0,0:25:14.68,0:25:18.82,Main,,0,0,0,,Hasır Şapkalar'ın gemisinin yerini saptayamadık.Dialogue: 0,0:25:18.82,0:25:21.64,Main,,0,0,0,,Mıntıka Sümüklü Böcekleri ne halt yiyor ki?Dialogue: 0,0:25:23.28,0:25:25.06,Main,,0,0,0,,Kes sesini Pekoms!Dialogue: 0,0:25:25.06,0:25:27.35,Main,,0,0,0,,Daha ne kadar zırlayacaksın oğlum!Dialogue: 0,0:25:28.58,0:25:31.53,Main,,0,0,0,,Pedro abi!Dialogue: 0,0:25:33.46,0:25:35.07,Main,,0,0,0,,Yazık çocuğa.Dialogue: 0,0:25:35.07,0:25:40.75,Main,,0,0,0,,Abisinden farksız olan çocukluk arkadaşı kendini patlatarak ölmeyi seçti-bon...Dialogue: 0,0:25:40.75,0:25:42.00,Main,,0,0,0,,Düşmanımızdı lan!Dialogue: 0,0:25:42.46,0:25:43.47,Main,,0,0,0,,Bon...Dialogue: 0,0:25:45.13,0:25:49.60,Flashbacks,,0,0,0,,Burada ölmemin bir anlamı olmaz! Yeni dünyanın şafağı yaklaşıyor!Dialogue: 0,0:25:50.10,0:25:52.01,Flashbacks,,0,0,0,,Geri dönmem lazım!Dialogue: 0,0:25:54.06,0:25:57.43,Flashbacks,,0,0,0,,Böylelikle senin-gara büyülerin de bozulacak, değil mi?Dialogue: 0,0:25:58.31,0:25:59.35,Flashbacks,,0,0,0,,Patlayıcılar mı?Dialogue: 0,0:26:00.40,0:26:01.52,Flashbacks,,0,0,0,,Hoşça kalın.Dialogue: 0,0:26:10.08,0:26:13.53,Main,,0,0,0,,Benim de ağzım açık kaldı-amour...Dialogue: 0,0:26:16.04,0:26:23.41,Main,,0,0,0,,5 yıl evvel Pedro'nun canı için salya sümük yalvardığına tanık olmuştum-bon.Dialogue: 0,0:26:23.41,0:26:29.37,Main,,0,0,0,,Aynı adam şimdi ise bir avuç korsanın demir alması için kendi canına kıydı.Dialogue: 0,0:26:29.37,0:26:30.63,Main,,0,0,0,,N'olmuş yani?Dialogue: 0,0:26:34.43,0:26:36.05,Main,,0,0,0,,Abi...Dialogue: 0,0:26:36.85,0:26:43.77,Main,,0,0,0,,Hâlâ Hasır Şapka Luffy'yi küçümsüyor olabiliriz-issant!Dialogue: 0,0:26:43.77,0:26:45.26,Main,,0,0,0,,Ne demeye getiriyorsun?Dialogue: 0,0:26:45.26,0:26:48.51,Main,,0,0,0,,Tedbiri elden bırakmamalıyız diyorum-bon!Dialogue: 0,0:26:48.51,0:26:51.46,Main,,0,0,0,,Mama öyle bir serseriye hayatta yenilmez!Dialogue: 0,0:26:51.46,0:26:55.04,Main,,0,0,0,,Hasır Şapka Luffy'nin o denli güçsüz olduğunu mu söylüyorsun?Dialogue: 0,0:26:55.04,0:26:58.16,Main,,0,0,0,,Herhâlde lan!  Korsanlıkta Mama'mızla aşık atamaz!Dialogue: 0,0:26:59.29,0:27:03.75,Main,,0,0,0,,Mama'nın yerle bir edilen şatosuna bakıp da aynı cümleyi kurabilir misin?Dialogue: 0,0:27:03.75,0:27:05.75,Main,,0,0,0,,Kazaydı oğlum!Dialogue: 0,0:27:05.75,0:27:12.35,Main,,0,0,0,,Haydi ona kaza diyelim, sümüklü böcekler de tesadüfen mi yerlerini saptayamıyor?Dialogue: 0,0:27:13.42,0:27:18.08,Main,,0,0,0,,Ne yani?  Tüm bunları planladıklarını mı söylüyorsun?Dialogue: 0,0:27:18.08,0:27:19.90,Main,,0,0,0,,En azından...Dialogue: 0,0:27:19.90,0:27:24.73,Main,,0,0,0,,...ayak bastıklarından bu yana beklenmedik olayların cereyan ettiği bir gerçek-jour.Dialogue: 0,0:27:28.52,0:27:32.41,Main,,0,0,0,,Burnu fazla havada olan şampiyon soluğu yerde alır!Dialogue: 0,0:27:32.41,0:27:35.74,Main,,0,0,0,,Küçük bir ihtimal de olsa Mama'nın adına leke sürmemek için...Dialogue: 0,0:27:35.74,0:27:41.88,Main,,0,0,0,,...bölgemizin en dış hattına güçlü bir filo konuşlandırmalıyız-amour!Dialogue: 0,0:27:55.11,0:27:56.30,Main,,0,0,0,,Mont d'Or-sama.Dialogue: 0,0:27:56.30,0:27:57.06,Main,,0,0,0,,Ne var?Dialogue: 0,0:27:57.06,0:27:59.69,Main,,0,0,0,,Custard-sama sizi arıyor.Dialogue: 0,0:27:59.69,0:28:02.79,Main,,0,0,0,,Custard, Bege'nin peşindeydi, değil mi?Dialogue: 0,0:28:03.65,0:28:07.62,Main,,0,0,0,,Benim, Mont d'Or. Bege'nin icabına baktınız mı?Dialogue: 0,0:28:07.62,0:28:08.62,Main,,0,0,0,,Şöyle ki...Dialogue: 0,0:28:10.78,0:28:13.68,Main,,0,0,0,,...gemilerinin izini kaybettik.Dialogue: 0,0:28:13.68,0:28:14.87,Main,,0,0,0,,Ne?Dialogue: 0,0:28:14.87,0:28:18.84,Main,,0,0,0,,Mıntıka Salyangozları yerlerini bildirmiyor ki!Dialogue: 0,0:28:18.84,0:28:21.00,Main,,0,0,0,,Ha? Tek değilmişiz yani?Dialogue: 0,0:28:21.00,0:28:21.52,Main,,0,0,0,,Ne?Dialogue: 0,0:28:21.52,0:28:25.76,Main,,0,0,0,,Biz de Hasır Şapkalar'ın yerini öğrenemedik!Dialogue: 0,0:28:25.76,0:28:27.09,Main,,0,0,0,,Ciddi misin sen?Dialogue: 0,0:28:27.09,0:28:32.97,Main,,0,0,0,,Her neyse, Bege'yi aramaya koyul! Dinle bak! N'olursa olsun elinden kaçırma!Dialogue: 0,0:28:32.97,0:28:33.93,Main,,0,0,0,,Anlaşıldı!Dialogue: 0,0:28:35.33,0:28:37.75,Main,,0,0,0,,Hey! Gidip bi' göz at!Dialogue: 0,0:28:37.75,0:28:38.44,Main,,0,0,0,,Ne?Dialogue: 0,0:28:38.44,0:28:42.38,Main,,0,0,0,,Denizdeki Mıntıka Salyangozları'nı kontrol et diyorum!Dialogue: 0,0:28:42.38,0:28:43.03,Main,,0,0,0,,Baş üstüne!Dialogue: 0,0:28:43.03,0:28:46.57,Main,,0,0,0,,N'oluyor oğlum ya?Dialogue: 0,0:28:46.82,0:28:51.50,Captions,,0,0,0,,Denizde - Nostra CastelloDialogue: 0,0:28:46.82,0:28:51.50,Note,,0,0,0,,Nostra Castello: İtalyanca'da "Kalemiz".Dialogue: 0,0:28:51.50,0:28:54.96,Main,,0,0,0,,Peşimize daha fazla geminin düşmesini bekliyordum!Dialogue: 0,0:28:54.96,0:28:56.72,Main,,0,0,0,,Bu ne biçim iş?Dialogue: 0,0:28:56.72,0:29:00.77,Main,,0,0,0,,Yerimizi tespit edememişlerdir belki-rero.Dialogue: 0,0:29:00.77,0:29:02.42,Main,,0,0,0,,Mıntıka Salyangozları mı?Dialogue: 0,0:29:02.42,0:29:03.81,Main,,0,0,0,,Rero.Dialogue: 0,0:29:03.81,0:29:08.86,Main,,0,0,0,,Mıntıka Salyangozları varken Den Den Mushi'ler ötüp dururdu.Dialogue: 0,0:29:08.86,0:29:10.89,Main,,0,0,0,,Ama çıtları çıkmıyor-rero.Dialogue: 0,0:29:10.89,0:29:14.87,Main,,0,0,0,,İlk kez böyle bir şey duyuyorum!Dialogue: 0,0:29:15.20,0:29:19.11,Main,,0,0,0,,Ama ne âlâ! Azami hızda ilerlemeye devam!Dialogue: 0,0:29:19.87,0:29:22.28,Main,,0,0,0,,Doğruca Kakao Adası'na!Dialogue: 0,0:29:22.28,0:29:26.36,Main,,0,0,0,,Chiffon'u almak için en kısa güzergâhı seçelim!Dialogue: 0,0:29:26.36,0:29:30.28,Main,,0,0,0,,- Tamamdır! - Rero!Dialogue: 0,0:29:55.47,0:29:58.46,Main,,0,0,0,,Germa gemisinden Nusstorte rapor veriyor.Dialogue: 0,0:29:55.47,0:29:58.46,Note,,0,0,0,,Nusstorte: "Engadiner Nusstorte", İsviçre'de fındıklı tart.Dialogue: 0,0:29:58.46,0:30:01.07,Main,,0,0,0,,Abi! Germa'yı ne yaptınız?Dialogue: 0,0:30:01.07,0:30:06.94,Main,,0,0,0,,10 bin askerle üzerlerinden geçtik. Krallıkları artık harabeye döndü!Dialogue: 0,0:30:07.84,0:30:11.29,Main,,0,0,0,,Abimden de bunu beklerdim! Yine de pervasızlık etmişsiniz.Dialogue: 0,0:30:11.29,0:30:16.26,Main,,0,0,0,,Sahip olduğumuz güç düşünülürse tereyağından kıl çekmek kadar kolay oldu.Dialogue: 0,0:30:16.24,0:30:18.24,Main,,0,0,0,,Ama abi...Dialogue: 0,0:30:19.10,0:30:24.74,Captions,,0,910,410,,Germa KrallığıDialogue: 0,0:30:20.21,0:30:24.74,Main,,0,0,0,,...klon üretim sistemlerine zarar vermediniz, değil mi?Dialogue: 0,0:30:25.42,0:30:29.29,Main,,0,0,0,,Herhâlde ya!  Ne zamandır o teknolojilerini arzuluyoruz!Dialogue: 0,0:30:29.29,0:30:33.25,Main,,0,0,0,,Lakin onun haricinde taş üstünde taş bırakmadık.Dialogue: 0,0:30:34.47,0:30:36.29,Main,,0,0,0,,İyi yapmışsınız!Dialogue: 0,0:30:36.29,0:30:40.63,Main,,0,0,0,,Sıçtığımın Germa'sı! Gözümüzü onlara diktiğimiz anda ölüm fermanları imzalanmıştı!Dialogue: 0,0:30:40.63,0:30:43.27,Main,,0,0,0,,Hasır Şapkalar ne âlemde?Dialogue: 0,0:30:44.02,0:30:47.55,Main,,0,0,0,,İşin aslı denize açılmayı başardılar.Dialogue: 0,0:30:47.55,0:30:50.17,Main,,0,0,0,,Batıya doğru yelken alıyorlar.Dialogue: 0,0:30:51.03,0:30:53.81,Main,,0,0,0,,Ama onları yakalamamız an meselesi.Dialogue: 0,0:30:53.81,0:30:56.49,Main,,0,0,0,,O meseleyi size bırakıyorum öyleyse!Dialogue: 0,0:30:56.49,0:30:59.08,Main,,0,0,0,,Tamamdır, elinize sağlık!Dialogue: 0,0:31:00.62,0:31:03.49,Main,,0,0,0,,Bunu da hallettik.Dialogue: 0,0:31:04.17,0:31:07.15,Main,,0,0,0,,Luffy-kunlar'ın başına bir iş gelmemiş.Dialogue: 0,0:31:07.15,0:31:10.30,Main,,0,0,0,,Şimdi n'apacağız peki?Dialogue: 0,0:31:13.93,0:31:16.43,Main,,0,0,0,,Yola koyulalım! Yelkenler fora!Dialogue: 0,0:31:16.97,0:31:18.67,Main,,0,0,0,,Anlaşıldı!Dialogue: 0,0:31:19.67,0:31:21.98,Main,,0,0,0,,Kin'niku Fusen!Dialogue: 0,0:31:19.67,0:31:21.98,Attack,,0,0,0,,Kas BalonuDialogue: 0,0:31:40.02,0:31:44.03,Main,,0,0,0,,Gücünü artıracağını biliyorken...Dialogue: 0,0:31:44.03,0:31:46.57,Main,,0,0,0,,...neden bir şey yapmadan durayım ki?Dialogue: 0,0:31:56.99,0:31:59.33,Main,,0,0,0,,Bana bak, Hasır Şapka Luffy.Dialogue: 0,0:32:01.47,0:32:05.57,Main,,0,0,0,,Seni küçümsemediğimi bil!Dialogue: 0,0:32:17.65,0:32:18.95,Main,,0,0,0,,Kagami Mochi!Dialogue: 0,0:32:17.65,0:32:18.95,Attack,,0,0,0,,Ayna MochiDialogue: 0,0:32:18.94,0:32:21.51,Main,,0,0,0,,Ne? Onlar da mı mochi ya?Dialogue: 0,0:32:21.51,0:32:24.98,Main,,0,0,0,,Olamaz! Üzerime düşerlerse canlı canlı gömülmüş olurum!Dialogue: 0,0:32:24.98,0:32:27.15,Main,,0,0,0,,Evet, boğulacaksın!Dialogue: 0,0:32:28.15,0:32:29.61,Main,,0,0,0,,İşin bitti!Dialogue: 0,0:32:47.56,0:32:53.40,Main,,0,0,0,,Bu şekilde noktaladığım için af buyur. Canımı sıkmaya başlamıştın.Dialogue: 0,0:32:53.40,0:32:56.03,Main,,0,0,0,,Seni yenmek uzun sürdüğünden...Dialogue: 0,0:32:56.03,0:32:59.36,Main,,0,0,0,,...bugünkü Merienda'mı 40 dakika geciktirdim.Dialogue: 0,0:32:56.03,0:32:59.36,Note,,0,0,0,,Merienda: Hafif bir yemek anlamına gelen İspanyolca kelime.Dialogue: 0,0:33:03.91,0:33:05.29,Main,,0,0,0,,Birazdan acın diner.Dialogue: 0,0:33:08.49,0:33:10.67,Main,,0,0,0,,Elveda, Hasır Şapka....Dialogue: 0,0:33:20.84,0:33:25.90,Credits,,0,0,0,,Editing:  Feeso, Galaxy 9000  Timing: Galaxy 9000  Quality Assurance: Feeso, Galaxy 9000, Grug, Pepperjack  Soundtracking:  Halee  Graphics:  Datenshi  Karaoke: KaitouYahiko  Translation: Crunchyroll