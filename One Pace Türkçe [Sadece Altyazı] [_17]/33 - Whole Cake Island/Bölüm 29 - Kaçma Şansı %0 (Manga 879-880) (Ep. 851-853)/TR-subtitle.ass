Dialogue: 0,0:01:38.33,0:01:43.44,Title,,0,0,260,,{\fad(1000,0)}Kaçma Şansı %0
Dialogue: 0,0:01:48.03,0:01:49.62,Main,,0,0,0,,Mümkün değil...
Dialogue: 0,0:01:52.87,0:01:55.44,Main,,0,0,0,,Olamaz... Olamaz...
Dialogue: 0,0:01:56.46,0:01:59.41,Main,,0,0,0,,Pedro-{\i1}san{\i0} kendini feda etmiş.
Dialogue: 0,0:02:02.29,0:02:05.94,Main,,0,0,0,,Biz... Daha... Daha...
Dialogue: 0,0:02:09.06,0:02:11.83,Main,,0,0,0,,Daha güçlü olsaydık...
Dialogue: 0,0:02:36.19,0:02:38.88,Main,,0,0,0,,Biz değil, düşmanlarımız ağlasın.
Dialogue: 0,0:02:39.94,0:02:42.35,Main,,0,0,0,,Duygularımızı dizginlemeliyiz.
Dialogue: 0,0:02:45.12,0:02:46.69,Main,,0,0,0,,Dur biraz Jinbe-{\i1}san{\i0}!
Dialogue: 0,0:02:47.29,0:02:51.36,Main,,0,0,0,,Nasıl böyle kalpsiz bir şey söylersin?
Dialogue: 0,0:02:51.36,0:02:54.98,Main,,0,0,0,,Pedro-san ile bizim kadar\Nvakit geçirmediğinden dolayı--
Dialogue: 0,0:02:54.98,0:02:58.49,Main,,0,0,0,,Dikkatiniz dağılmasın diyorum, hepsi bu!
Dialogue: 0,0:03:00.13,0:03:03.04,Main,,0,0,0,,Kıyı şeridinde kapana kısılmıştık.
Dialogue: 0,0:03:04.39,0:03:10.58,Main,,0,0,0,,Gittiğimiz yerin son derece tehlikeli olduğunun farkındaydı, \Nbu yüzden de kendini feda etmeye hazırlanmıştı.
Dialogue: 0,0:03:12.34,0:03:13.51,Main,,0,0,0,,Bu olay...
Dialogue: 0,0:03:13.52,0:03:16.47,Main,,0,0,0,,...Pedro'nun zaferidir!
Dialogue: 0,0:03:19.64,0:03:25.85,Main,,0,0,0,,Sizin yüzünüzden düşman\Nne kadar hasar aldı dersiniz?
Dialogue: 0,0:03:26.70,0:03:31.32,Main,,0,0,0,,Eşi benzeri görülmemiş\Nbüyük bir gaf işlemiş oldular!
Dialogue: 0,0:03:31.32,0:03:36.78,Main,,0,0,0,,Sahip olduğunuz kudret\NBig Mom'ı köşeye sıkıştırmış oldu işte!
Dialogue: 0,0:03:36.78,0:03:41.79,Main,,0,0,0,,Kalbinizin derinliklerinde\NPedro'nun sesini duymuyor musunuz?
Dialogue: 0,0:03:44.35,0:03:46.22,Main,,0,0,0,,"Devam edin." diyor!
Dialogue: 0,0:03:57.40,0:04:00.03,Main,,0,0,0,,Luffy bu duruma anında uyanıp...
Dialogue: 0,0:04:00.70,0:04:04.52,Main,,0,0,0,,...düşmanla tek başına\Nçarpışmaya karar verdi!
Dialogue: 0,0:04:05.78,0:04:11.53,Main,,0,0,0,,Katakuri'nin kelle ödülü bir milyarı aşıyor!\NYa batar ya da çıkarız!
Dialogue: 0,0:04:11.53,0:04:14.49,Main,,0,0,0,,Bu hesap daha kapanmadı!
Dialogue: 0,0:04:14.49,0:04:18.37,Main,,0,0,0,,Hâlâ Totto Land sularındayız!
Dialogue: 0,0:04:18.38,0:04:25.75,Main,,0,0,0,,Tez vakte ülkenin korsan kraliçesi\NBig Mom peşimize takılacaktır!
Dialogue: 0,0:04:25.76,0:04:32.13,Main,,0,0,0,,Her an dört bir yanımızdan da düşman\Nfilosunun bombardımanına da hedef olabiliriz!
Dialogue: 0,0:04:32.94,0:04:37.13,Main,,0,0,0,,Big Mom'ın hüküm sürdüğü\Nbölgeden çıkana değin...
Dialogue: 0,0:04:37.73,0:04:42.85,Main,,0,0,0,,...dikkatinizi dağıtamazsınız!\NKalbinizdeki Pedro keza böyle söylemiyor mu?
Dialogue: 0,0:04:51.18,0:04:53.09,Main,,0,0,0,,Özürlerimi sunarım.
Dialogue: 0,0:04:54.02,0:04:56.93,Main,,0,0,0,,Ziyadesiyle yakışıksız hareket ettim.
Dialogue: 0,0:04:59.39,0:05:01.40,Main,,0,0,0,,Nami, talimatları ver!
Dialogue: 0,0:05:01.40,0:05:02.45,Main,,0,0,0,,Tamam!
Dialogue: 0,0:05:02.45,0:05:06.28,Main,,0,0,0,,Sanji-{\i1}kun{\i0}lar Kakao Adası'ndan\Nbize doğru geleceğinden...
Dialogue: 0,0:05:06.28,0:05:08.32,Main,,0,0,0,,...birbirimizi kaybetmek istemeyiz.
Dialogue: 0,0:05:08.32,0:05:11.74,Main,,0,0,0,,Güçlü bir rüzgâr kapımızda!\NBir pupa rüzgârı!
Dialogue: 0,0:05:11.74,0:05:13.45,Main,,0,0,0,,Sancak alabanda!
Dialogue: 0,0:05:13.45,0:05:15.66,Main,,0,0,0,,Keskin bir salcak alabanda!
Dialogue: 0,0:05:15.66,0:05:18.78,Main,,0,0,0,,Sancak kontra yapıp\Ndosdoğru batıya yol alacağız!
Dialogue: 0,0:05:18.78,0:05:20.30,Main,,0,0,0,,En kısa güzergâhtan gidiyoruz!
Dialogue: 0,0:05:20.30,0:05:21.61,Main,,0,0,0,,Anlaşıldı!
Dialogue: 0,0:05:21.61,0:05:24.08,Main,,0,0,0,,Şimdi tükettiğimiz kolaları yeniliyorum!
Dialogue: 0,0:05:27.08,0:05:28.66,Main,,0,0,0,,Gözcülük yapacağım!
Dialogue: 0,0:05:31.31,0:05:32.38,Main,,0,0,0,,Tamamdır!
Dialogue: 0,0:05:32.38,0:05:34.08,Main,,0,0,0,,Yerimdeyim!
Dialogue: 0,0:05:34.08,0:05:34.80,Main,,0,0,0,,Güzel.
Dialogue: 0,0:05:35.31,0:05:38.08,Main,,0,0,0,,Ben de akıntıları izleyeyim.
Dialogue: 0,0:05:47.94,0:05:50.37,Main,,0,0,0,,Saat 6 yönünden gelen var!
Dialogue: 0,0:05:50.37,0:05:52.71,Main,,0,0,0,,Kıyı şeridinde gördüğümüz gemiler!
Dialogue: 0,0:05:53.68,0:05:54.84,Main,,0,0,0,,Bir insan mı o?
Dialogue: 0,0:05:55.68,0:05:57.38,Main,,0,0,0,,M- Mümkün değil...
Dialogue: 0,0:06:01.64,0:06:04.93,Main,,0,0,0,,Pasta!
Dialogue: 0,0:06:04.93,0:06:09.06,Main,,0,0,0,,Olamaz... Bunun...\NMümkün olduğuna inanamıyorum.
Dialogue: 0,0:06:09.06,0:06:12.56,Main,,0,0,0,,Big Mom denizin üzerinden yürüyor!
Dialogue: 0,0:06:12.56,0:06:15.23,Main,,0,0,0,,Saçmalık! O bile yapamaz bunu!
Dialogue: 0,0:06:17.92,0:06:20.96,Main,,0,0,0,,Suyun üzerinden yürümüyor... O şey...
Dialogue: 0,0:06:22.54,0:06:23.76,Main,,0,0,0,,...şeker mi?
Dialogue: 0,0:06:25.41,0:06:29.54,Main,,0,0,0,,Hareket eden devasa bir şeker\Nyığını üzerinde yürüyor!
Dialogue: 0,0:06:30.63,0:06:32.50,Main,,0,0,0,,Şeker aracılığıyla mı?
Dialogue: 0,0:06:32.50,0:06:34.13,Main,,0,0,0,,Bir saniye, öyleyse...
Dialogue: 0,0:06:35.05,0:06:39.13,Main,,0,0,0,,Bu şeker yığınını yapabilecek yegâne kişi...
Dialogue: 0,0:06:39.13,0:06:42.93,Main,,0,0,0,,O-teia yaşıyor!
Dialogue: 0,0:06:44.98,0:06:46.64,Main,,0,0,0,,Lick...
Dialogue: 0,0:06:46.64,0:06:49.44,Main,,0,0,0,,Şeker Sümüklü Böceği!
Dialogue: 0,0:06:49.44,0:06:51.77,Main,,0,0,0,,Zeus hangi cehenneme gitti?
Dialogue: 0,0:06:51.77,0:06:55.65,Main,,0,0,0,,Mama'yı denizden geçirme görevi onundu!
Dialogue: 0,0:06:56.24,0:06:57.32,Main,,0,0,0,,Yoksa...
Dialogue: 0,0:06:57.34,0:07:03.20,Main,,0,0,0,,Dert değil gerçi. \Nİntikam almam icap ediyor artık.
Dialogue: 0,0:07:03.20,0:07:06.91,Main,,0,0,0,,Pedro kendi hayatından vazgeçmişti oysa!
Dialogue: 0,0:07:11.90,0:07:18.11,Main,,0,0,0,,Yitirdiğim kolumun yerini\Nşekerle doldurabilsem de...
Dialogue: 0,0:07:18.11,0:07:22.21,Main,,0,0,0,,Öğle vakitleri sıcacık çayımı yudumlarken...
Dialogue: 0,0:07:22.21,0:07:26.93,Main,,0,0,0,,...tuttuğum fincanın ısısıyla\Nsağ elimin eridiğini her görüşümde...
Dialogue: 0,0:07:27.68,0:07:33.59,Main,,0,0,0,,...Jaguar Mink'in simasını anımsayacağım!
Dialogue: 0,0:07:33.59,0:07:38.17,Main,,0,0,0,,Haksız mıyım Napoleon?\NBenim nezdimde en büyük hakarettir!
Dialogue: 0,0:07:38.17,0:07:42.15,Main,,0,0,0,,Hasır Şapkalar ezeli düşmanlarımız\Noldu bir kere.
Dialogue: 0,0:07:42.15,0:07:43.83,Main,,0,0,0,,Yarınları yok.
Dialogue: 0,0:07:45.91,0:07:48.14,Main,,0,0,0,,Ödeşmiş olmak için...
Dialogue: 0,0:07:48.87,0:07:52.10,Main,,0,0,0,,...arkadaşlarına nasıl işkenceler etsem acaba?
Dialogue: 0,0:07:58.98,0:08:02.99,Captions,,0,0,175,,{\fad(500,0)}Whole Cake Adası
Dialogue: 0,0:08:00.25,0:08:02.99,Main,,0,0,1,,Ha? Neden ola ki?
Dialogue: 0,0:08:03.00,0:08:05.63,Main,,0,0,0,,Herkes tüymüş!
Dialogue: 0,0:08:05.63,0:08:10.62,Main,,0,0,0,,Deli gibi ateş yemek istiyorum ya!\NGücüm kayboluyor.
Dialogue: 0,0:08:10.62,0:08:14.27,Main,,0,0,0,,Ben de fırtına bulutları yemek istiyorum.
Dialogue: 0,0:08:15.60,0:08:19.42,Captions,,0,0,0,,{\fad(500,0)}Totto Land Sınırı İçinde - Denizde
Dialogue: 0,0:08:19.62,0:08:24.54,Main,,0,0,0,,Hadi ya... Thriller Bark'taki Lola-chan\Nçikolata yapımında tam bir ustaydı yani!
Dialogue: 0,0:08:24.54,0:08:28.94,Main,,0,0,0,,Evet. Lola Kakao Adası'nı yöneten\NÇikolata Bakanı idi.
Dialogue: 0,0:08:28.94,0:08:33.48,Main,,0,0,0,,Lakin ayrıldığından bu yana\Nkoltuğu hep boş kaldı.
Dialogue: 0,0:08:33.48,0:08:35.36,Main,,0,0,0,,Neden peki?
Dialogue: 0,0:08:35.36,0:08:41.49,Main,,0,0,0,,Herkesin bir numaralı adayı\Nbu teklifi geri çevirip durdu da ondan.
Dialogue: 0,0:08:41.49,0:08:42.66,Main,,0,0,0,,Di' mi Pudding?
Dialogue: 0,0:08:43.21,0:08:45.78,Main,,0,0,0,,İ- İyi de benim gözümde...
Dialogue: 0,0:08:45.80,0:08:50.71,Main,,0,0,0,,Çikolata Şehri'nin Çikolata Bakanı\NLola ablamdan başkası olamaz!
Dialogue: 0,0:08:50.71,0:08:54.02,Main,,0,0,0,,Günün birinde geri döneceğini de umuyorum.
Dialogue: 0,0:08:54.02,0:08:55.67,Main,,0,0,0,,Ne demek istediğini anlasam da...
Dialogue: 0,0:08:57.54,0:08:58.72,Main,,0,0,0,,Ha?
Dialogue: 0,0:08:59.10,0:09:00.96,Main,,0,0,0,,Ha? Ha? Ha?
Dialogue: 0,0:09:01.27,0:09:03.26,Main,,0,0,0,,Gözlerim yanlış mı görüyor?
Dialogue: 0,0:09:03.22,0:09:04.53,Main,,0,0,0,,Hayır...
Dialogue: 0,0:09:04.74,0:09:08.22,Captions,,0,0,240,,{\fad(500,0)}Pound - Lola ve Chiffon'un Babası
Dialogue: 0,0:09:04.94,0:09:08.22,Main,,0,0,1,,B- Benim kızım galiba!
Dialogue: 0,0:09:08.22,0:09:12.30,Main,,0,0,0,,Hey! Hey!
Dialogue: 0,0:09:15.06,0:09:17.63,Main,,0,0,0,,Hey!
Dialogue: 0,0:09:19.38,0:09:21.44,Main,,0,0,0,,Gitti ya.
Dialogue: 0,0:09:21.44,0:09:23.61,Main,,0,0,0,,Chiffon...
Dialogue: 0,0:09:23.61,0:09:27.66,Main,,0,0,0,,Olmuyor ama!\NHalının içinden çık artık Pudding!
Dialogue: 0,0:09:29.09,0:09:31.26,Main,,0,0,0,,H... Hadi oradan be!
Dialogue: 0,0:09:31.26,0:09:34.80,Main,,0,0,0,,Üzerimde gelinlik var lan!
Dialogue: 0,0:09:34.80,0:09:37.62,Main,,0,0,0,,O adamla aynı halının üzerine oturursam...
Dialogue: 0,0:09:37.62,0:09:43.60,Main,,0,0,0,,...el âlem nikâh kıymış\Nyeni evliler olduğumuzu falan düşünür!
Dialogue: 0,0:09:45.36,0:09:46.51,Main,,0,0,0,,Hangi el âlem ya?
Dialogue: 0,0:09:46.51,0:09:51.55,Main,,0,0,0,,İlla bir gören çıkar!\NBu yanılgıya düşerlerse sinirim bozulur!
Dialogue: 0,0:09:53.08,0:09:56.00,Main,,0,0,0,,S... S... Sinirim bozulmasın diye yani, tamam mı?
Dialogue: 0,0:09:56.00,0:09:58.98,Main,,0,0,0,,Öyle düşünürlerse ben de rahat\Nhissetmem ama düşme sakın.
Dialogue: 0,0:09:59.58,0:10:02.39,Main,,0,0,0,,S- Sus be!
Dialogue: 0,0:10:02.39,0:10:07.70,Thoughts,,0,0,0,,{\i1}Ay! Çok kibar ya! Beni düşünüyor!
Dialogue: 0,0:10:07.79,0:10:13.54,Main,,0,0,0,,Sen kimsin lan!\Nİster düşerim ister düşmem!
Dialogue: 0,0:10:13.54,0:10:15.54,Main,,0,0,0,,Kakao Adası göründü!
Dialogue: 0,0:10:15.54,0:10:18.88,Main,,0,0,0,,Güzel! \NVarır varmaz pastayı yapmaya başlayalım!
Dialogue: 0,0:10:18.90,0:10:23.69,Main,,0,0,0,,Kime diyoruz!\NDediklerimi duydun mu Sanji...
Dialogue: 0,0:10:24.27,0:10:25.67,Main,,0,0,0,,...-{\i1}san{\i1}!{\i0}
Dialogue: 0,0:10:26.18,0:10:30.15,Captions,,0,0,170,,{\fad(500,0)}Ayna Dünyası
Dialogue: 0,0:10:28.65,0:10:30.16,Main,,0,0,1,,Aklını yediğim!
Dialogue: 0,0:10:30.16,0:10:32.21,Main,,0,0,0,,Aynayı kendi elleriyle\Nkırdığına inanamıyorum!
Dialogue: 0,0:10:32.21,0:10:35.96,Main,,0,0,0,,Arkadaşların kaçabilsin diye\Nkendini mi feda edeceksin?
Dialogue: 0,0:10:35.96,0:10:39.30,Main,,0,0,0,,Hepinizin canına okuyacağım!
Dialogue: 0,0:10:41.28,0:10:43.04,Main,,0,0,0,,Siktir lan!
Dialogue: 0,0:10:43.04,0:10:45.21,Main,,0,0,0,,Karşında kim var oğlum senin!
Dialogue: 0,0:10:45.21,0:10:49.42,Main,,0,0,0,,Katakuri-{\i1}sama{\i0}'mızın kelle ödülü\N1 milyar 57 milyon belidir!
Dialogue: 0,0:10:49.42,0:10:52.68,Main,,0,0,0,,Şekerleme Generalleri içerisinde\Nen kudretlisidir!
Dialogue: 0,0:10:55.48,0:10:59.08,Main,,0,0,0,,{\fad(500,0)}Hawk Gatling!
Dialogue: 0,0:10:55.48,0:10:59.08,Attack,,0,0,0,,{\fad(500,0)}Şahin Mitralyözü
Dialogue: 0,0:11:15.85,0:11:17.83,Main,,0,0,0,,Seni taklit ediyorum.
Dialogue: 0,0:11:17.83,0:11:20.34,Main,,0,0,0,,Olmadı mı yoksa?
Dialogue: 0,0:11:24.99,0:11:28.24,Main,,0,0,0,,Fakat şöyle yaparsam daha etkili olur.
Dialogue: 0,0:11:36.02,0:11:37.75,Main,,0,0,0,,Katakuri-{\i1}sama{\i0}'dan da bu beklenirdi!
Dialogue: 0,0:11:40.81,0:11:42.93,Main,,0,0,0,,Katakuri-{\i1}sama{\i0}'nın hiç insafı yok!
Dialogue: 0,0:12:03.61,0:12:05.82,Main,,0,0,0,,Şimdi anlamışsındır.
Dialogue: 0,0:12:10.29,0:12:13.75,Main,,0,0,0,,Az önce de belirttiğim gibi\Nsöz konusu yetenek olunca...
Dialogue: 0,0:12:13.75,0:12:17.29,Main,,0,0,0,,...her hamleni\Ndaha güçlü bir hâliyle tekrarlayabilirim.
Dialogue: 0,0:12:17.29,0:12:21.80,Main,,0,0,0,,Hız olsun, güç olsun... \NAklına ne geliyorsa hepsinde senden üstünüm.
Dialogue: 0,0:12:29.63,0:12:32.68,Main,,0,0,0,,Lastik, mochi'ye kaybetmez!
Dialogue: 0,0:12:41.36,0:12:44.22,Main,,0,0,0,,Yenilmeyeceğim!
Dialogue: 0,0:12:45.20,0:12:47.02,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:12:47.76,0:12:50.08,Main,,0,0,0,,{\fad(150,150)}Hawk Stamp!
Dialogue: 0,0:12:47.76,0:12:50.08,Attack,,0,0,0,,{\fad(150,150)}Şahin Damgası
Dialogue: 0,0:12:52.87,0:12:54.02,Main,,0,0,0,,Bu kadarcık mıydı?
Dialogue: 0,0:12:54.04,0:12:55.23,Main,,0,0,0,,Daha bitirmedim!
Dialogue: 0,0:12:56.09,0:12:57.38,Main,,0,0,0,,Yine kayboluverdi!
Dialogue: 0,0:13:09.12,0:13:12.54,Main,,0,0,0,,Gerçekten de Katakuri-{\i1}sama{\i0}\Nbambaşka bir seviyedeymiş işte!
Dialogue: 0,0:13:21.36,0:13:23.22,Main,,0,0,0,,Şimdi de güç gösterisi mi yapacaksın?
Dialogue: 0,0:13:27.62,0:13:29.18,Main,,0,0,0,,Pes et artık.
Dialogue: 0,0:13:43.38,0:13:46.09,Main,,0,0,0,,Devasa bi' yumruk!
Dialogue: 0,0:13:47.26,0:13:48.97,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:13:49.51,0:13:51.05,Main,,0,0,0,,{\fad(150,150)}Elephant...
Dialogue: 0,0:13:49.51,0:13:51.05,Attack,,0,0,0,,{\fad(150,150)}Fil...
Dialogue: 0,0:13:52.64,0:13:55.43,Main,,0,0,0,,{\fad(150,150)}...Gun!
Dialogue: 0,0:13:52.64,0:13:55.43,Attack,,0,0,0,,{\fad(150,150)}...Tüfeği
Dialogue: 0,0:14:00.56,0:14:04.19,Main,,0,0,0,,Katakuri-{\i1}sama{\i0}'nın yumruğu çok daha büyük!
Dialogue: 0,0:14:35.44,0:14:37.70,Main,,0,0,0,,Fil Tüfeği'ni usulünce...
Dialogue: 0,0:14:37.70,0:14:39.80,Main,,0,0,0,,...yapabildim mi bari?
Dialogue: 0,0:14:40.50,0:14:44.62,Captions,,0,0,1,,{\fad(500,0)}Kakao Adası
Dialogue: 0,0:14:48.68,0:14:52.57,Main,,0,0,0,,Gelinliğin içinde ne kadar güzel duruyor ya!
Dialogue: 0,0:14:52.57,0:14:56.07,Main,,0,0,0,,Yazık kıza ama. Düğünü mahvoldu.
Dialogue: 0,0:14:56.07,0:15:00.55,Main,,0,0,0,,Ama suratı asık olsa bile acayip güzel!
Dialogue: 0,0:15:00.55,0:15:03.62,Main,,0,0,0,,Kabartma Bakanı!
Dialogue: 0,0:15:03.62,0:15:05.25,Main,,0,0,0,,Chi... Chiffon-{\i1}sama{\i0}!
Dialogue: 0,0:15:12.46,0:15:18.43,Main,,0,0,0,,Merak etmeyin millet! \NChiffon ablamın isyanda parmağı yok!
Dialogue: 0,0:15:18.43,0:15:23.06,Main,,0,0,0,,{\fad(0,150)}Her şey kocası\NGang Bege'nin başının altından çıktı!
Dialogue: 0,0:15:24.26,0:15:25.93,Main,,0,0,0,,Üzgünüm.
Dialogue: 0,0:15:25.93,0:15:32.10,Main,,0,0,0,,Seni tehdit ederek pastayı sana\Nzorla yaptıracağımı biliyorlar.
Dialogue: 0,0:15:32.10,0:15:36.52,Main,,0,0,0,,{\fad(0,200)}Önemli değil Pudding.\NŞu an düştüğüm durum böyle.
Dialogue: 0,0:15:40.46,0:15:44.09,Main,,0,0,0,,Yine de Pudding-{\i1}sama{\i0}\Nbugün yaşananlara inanamıyorum.
Dialogue: 0,0:15:44.09,0:15:47.10,Main,,0,0,0,,Musmutlu düğününüzün...
Dialogue: 0,0:15:47.10,0:15:51.64,Main,,0,0,0,,...Hasır Şapka Luffy'nin işgali ve Bege'nin ihanetiyle baltalanacağı kimin aklına gelirdi ki?
Dialogue: 0,0:15:51.64,0:15:56.18,Main,,0,0,0,,Sanji denen herif de\Ndöneğin önde gideniymiş!
Dialogue: 0,0:15:56.18,0:15:58.25,Main,,0,0,0,,Olan oldu artık.
Dialogue: 0,0:15:58.25,0:16:01.53,Main,,0,0,0,,Yaşananlar sizi derinden etkilemiş olmalı!
Dialogue: 0,0:16:01.53,0:16:04.57,Main,,0,0,0,,Mama'nın hiddetini ise kestiremiyorum bile.
Dialogue: 0,0:16:04.57,0:16:07.82,Main,,0,0,0,,Kesinlikle, hem gözü dönmüş durumda\Nhem de karnı aç.
Dialogue: 0,0:16:08.56,0:16:12.90,Main,,0,0,0,,Yetmezmiş gibi Açlık Krizi baş gösterdiğinden\Nülkemizi haritadan silebilir.
Dialogue: 0,0:16:12.90,0:16:15.70,Main,,0,0,0,,Ne kadar dehşet verici...
Dialogue: 0,0:16:15.70,0:16:17.33,Main,,0,0,0,,Her şey hazır mı?
Dialogue: 0,0:16:17.33,0:16:25.55,Main,,0,0,0,,Evet! Yaklaşık 1 saat evvel \NWhole Cake Adası'ndan 31 şef gönderildi.
Dialogue: 0,0:16:33.12,0:16:38.13,Captions,,0,0,0,,{\fad(500,500)}Tatlı Fabrikası - Çikolata Şehri
Dialogue: 0,0:16:40.17,0:16:43.59,Main,,0,0,0,,Sizi bekliyorduk Pudding-{\i1}sama{\i0}!
Dialogue: 0,0:16:43.60,0:16:48.82,Main,,0,0,0,,Whole Cake Adası'nın 31 baş şefi...
Dialogue: 0,0:16:48.82,0:16:52.27,Main,,0,0,0,,...WCI: 31 oluyoruz!{\an8}
Dialogue: 0,0:16:52.27,0:16:59.08,Main,,0,0,0,,Chiffon ablamla birlikte Mama'yı durdurabilecek\Nyegâne düğün pastasını pişireceğiz şimdi.
Dialogue: 0,0:16:59.08,0:17:00.78,Main,,0,0,0,,Yardımlarınızı esirgemeyin lütfen.
Dialogue: 0,0:17:00.78,0:17:05.24,Main,,0,0,0,,Tabii ki efendim!\NHâlihazırda hazırlıklara başladık.
Dialogue: 0,0:17:05.24,0:17:11.04,Main,,0,0,0,,Gelin konumunda olduğundan yaşananlar\Nen çok Pudding-sama'yı üzmüştür.
Dialogue: 0,0:17:11.04,0:17:15.92,Main,,0,0,0,,Bana güvenebilirsiniz! \NMama'nın ülkemizi yok etmesine izin vermeyeceğim!
Dialogue: 0,0:17:15.92,0:17:17.67,Main,,0,0,0,,Pudding-{\i1}sama{\i}!
Dialogue: 0,0:17:17.67,0:17:23.71,Main,,0,0,0,,Aşktan yediği vurgunu atlatıp pasta\Nyapımını bizzat denetlediğine inanamıyorum!
Dialogue: 0,0:17:23.71,0:17:26.30,Main,,0,0,0,,Resmen kurtuluş tanrıçamız ya!
Dialogue: 0,0:17:26.30,0:17:27.60,Main,,0,0,0,,Bol şans!
Dialogue: 0,0:17:28.30,0:17:31.59,Main,,0,0,0,,Rabiyan ile içeri girin abla.
Dialogue: 0,0:17:31.59,0:17:32.51,Main,,0,0,0,,Peki.
Dialogue: 0,0:17:32.52,0:17:35.62,Main,,0,0,0,,Diyeceklerime hepiniz kulak verin lütfen!
Dialogue: 0,0:17:35.62,0:17:38.39,Main,,0,0,0,,Sizden bir ricam olacak!
Dialogue: 0,0:17:38.39,0:17:43.96,Main,,0,0,0,,Hayatlarımız pahasına ülkemizin\Nkaderini etkileyecek pastayı pişireceğiz.
Dialogue: 0,0:17:43.96,0:17:46.24,Main,,0,0,0,,Bu yüzden tüm dikkatimizi\Nvermemiz gerekiyor.
Dialogue: 0,0:17:47.67,0:17:53.41,Main,,0,0,0,,Pastayı pişirirken ne olursa olsun\Nfabrikanın içine bakmayın lütfen!
Dialogue: 0,0:17:53.41,0:17:54.24,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:17:54.24,0:17:59.72,Main,,0,0,0,,Ayrıca kim olursa olsun içeri almıyorsunuz!
Dialogue: 0,0:17:59.72,0:18:00.46,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:18:00.46,0:18:03.62,Main,,0,0,0,,Anlaşılmıştır Pudding-{\i1}sama{\i0}!
Dialogue: 0,0:18:04.25,0:18:06.68,Main,,0,0,0,,Hepinize teşekkür ederim.
Dialogue: 0,0:18:07.92,0:18:10.74,Main,,0,0,0,,Şans sizinle olsun Pudding-{\i1}sama{\i0}!
Dialogue: 0,0:18:11.51,0:18:14.07,Thoughts,,0,0,0,,{\i1}Böylelikle Sanji-san'ı görmeyecekler.
Dialogue: 0,0:18:14.07,0:18:18.05,Thoughts,,0,0,0,,{\i1}Geriye bizimle çalışacak \Nşeflerin icabına bakmak kaldı.
Dialogue: 0,0:18:19.47,0:18:23.62,Main,,0,0,0,,Baş şefler!\NBirer birer içeri gelin lütfen!
Dialogue: 0,0:18:28.23,0:18:32.33,Main,,0,0,0,,Birinci mutfağın baş şefi Bouche\Nvazifeye hazırdır.
Dialogue: 0,0:18:39.12,0:18:41.04,Main,,0,0,0,,Uslu dur bakayım.
Dialogue: 0,0:18:43.81,0:18:45.80,Main,,0,0,0,,Hafızanla biraz oynayacağım.
Dialogue: 0,0:18:45.80,0:18:46.84,Main,,0,0,0,,{\fad(150,150)}Edit!
Dialogue: 0,0:18:45.80,0:18:46.84,Attack,,0,0,0,,{\fad(150,150)}Düzenle
Dialogue: 0,0:18:47.66,0:18:49.40,Main,,0,0,0,,Hey, indir beni.
Dialogue: 0,0:18:49.40,0:18:50.13,Main,,0,0,0,,Tamam!
Dialogue: 0,0:18:50.13,0:18:52.46,Main,,0,0,0,,Haydi bakalım.
Dialogue: 0,0:18:52.46,0:18:54.05,Main,,0,0,1,,Senin için yorucu bir seyahat olmuştur.
Dialogue: 0,0:18:54.05,0:18:58.63,Captions,,0,0,0,,{\fad(500,500}Fabrikanın İçi
Dialogue: 0,0:18:54.22,0:18:58.43,Main,,0,0,0,,Fazla vaktimiz olmadığından yolda\Npastanın bir şablonunu çıkardım.{\an8}
Dialogue: 0,0:18:59.31,0:19:01.27,Main,,0,0,0,,Ne? Hatırlıyor musun ki?
Dialogue: 0,0:19:01.27,0:19:02.65,Main,,0,0,0,,Ekseriyetle.
Dialogue: 0,0:19:02.65,0:19:04.03,Main,,0,0,0,,Yok devenin nalı!
Dialogue: 0,0:19:04.05,0:19:08.20,Main,,0,0,0,,Şeklini hatırlıyorsun desek bile tatmadığın\Nhâlde içeriğini nereden biliyorsun?
Dialogue: 0,0:19:14.36,0:19:15.58,Main,,0,0,0,,Kokusundan...
Dialogue: 0,0:19:15.58,0:19:17.04,Thoughts,,0,0,0,,{\i1}Ciddi misin sen?{\i0}
Dialogue: 0,0:19:17.95,0:19:22.34,Main,,0,0,0,,Haydi elimizi çabuk tutalım!\NHer saniye önemli!
Dialogue: 0,0:19:23.49,0:19:27.97,Main,,0,0,0,,Pudding-{\i1}chan{\i0} şef kıyafetleriyle de\Nyine acayip sevimli!
Dialogue: 0,0:19:27.97,0:19:29.23,Main,,0,0,0,,Ne?
Dialogue: 0,0:19:30.88,0:19:33.52,Main,,0,0,0,,Pudding-{\i1}sama{\i0}, iyi misiniz efendim?
Dialogue: 0,0:19:33.52,0:19:35.68,Main,,0,0,0,,Elimizden geleni yapalım damat-sama!
Dialogue: 0,0:19:35.68,0:19:36.80,Main,,0,0,0,,Ha? Bana mı diyorsun?
Dialogue: 0,0:19:36.80,0:19:38.31,Main,,0,0,0,,Gelsene biraz!
Dialogue: 0,0:19:38.32,0:19:42.08,Main,,0,0,0,,Şeflerin hafızalarındaki düğünle biraz oynadım.
Dialogue: 0,0:19:42.08,0:19:45.91,Main,,0,0,0,,Yani onların kafasında düğün\Nbir pürüz olmadan gerçekleşerek...
Dialogue: 0,0:19:45.91,0:19:50.28,Main,,0,0,0,,...e... e... evlenmiş olduk!
Dialogue: 0,0:19:51.36,0:19:52.73,Main,,0,0,0,,Öte yandan...
Dialogue: 0,0:19:53.78,0:19:57.72,Main,,0,0,0,,...düğün pastası kötü hava şartlarından\Ndolayı yıkıldı.
Dialogue: 0,0:19:57.72,0:20:01.79,Main,,0,0,0,,Mama küplere bindiği için pastayı\Ntekrar yapmamız gerekiyor.
Dialogue: 0,0:20:01.79,0:20:04.50,Main,,0,0,0,,Hafızalarını bu şekilde değiştirdim.
Dialogue: 0,0:20:04.50,0:20:05.54,Main,,0,0,0,,Anladım.
Dialogue: 0,0:20:05.54,0:20:08.84,Main,,0,0,0,,Pastayı ilk pişirdikleri zamana dair\Nhatıralarına netlik kazandırdığım için...
Dialogue: 0,0:20:08.86,0:20:12.71,Main,,0,0,0,,...tekrar yaparken bunun yardımı dokunacaktır.
Dialogue: 0,0:20:14.34,0:20:18.93,Main,,0,0,0,,Bu pasta şablonu ve tarifi\Nkimin elinden çıkma?
Dialogue: 0,0:20:18.93,0:20:20.18,Main,,0,0,0,,Benim.
Dialogue: 0,0:20:20.18,0:20:22.60,Main,,0,0,0,,Damat-sama, siz mi yazdınız?
Dialogue: 0,0:20:22.60,0:20:25.77,Main,,0,0,0,,Evet, bir yanlışlık varsa söyleyin.
Dialogue: 0,0:20:25.77,0:20:27.37,Main,,0,0,0,,Kusursuz!
Dialogue: 0,0:20:27.37,0:20:30.00,Main,,0,0,0,,Aşçı Başı Streusen-sama'nın\Nhazırlamak için bir haftasını harcadığı...
Dialogue: 0,0:20:30.00,0:20:33.41,Main,,0,0,0,,...gizli malzemeyi dahi doğru bilmişsiniz! \NTahmin etmişsiniz!
Dialogue: 0,0:20:33.41,0:20:37.74,Main,,0,0,0,,Maharetli olduğunuzu işitmiştim\Nlakin işin piriymişsiniz!
Dialogue: 0,0:20:37.74,0:20:42.29,Main,,0,0,0,,Beklenmedik olsa da bu pastanın\Nyapımı karı koca olarak...
Dialogue: 0,0:20:42.29,0:20:43.46,Thoughts,,0,0,0,,{\i1}Karı koca mı?
Dialogue: 0,0:20:43.46,0:20:47.52,Main,,0,0,0,,...ilk ortak çalışmanız olacak.
Dialogue: 0,0:20:48.41,0:20:50.79,Main,,0,0,0,,Evet ya, benim de elim ayağıma dolaşıyor.
Dialogue: 0,0:20:50.79,0:20:52.88,Thoughts,,0,0,0,,Karı koca...
Dialogue: 0,0:20:52.88,0:20:54.93,Main,,0,0,0,,İyi misiniz gelin-sama?
Dialogue: 0,0:20:54.93,0:20:56.47,Thoughts,,0,0,0,,G... Geli...
Dialogue: 0,0:20:56.47,0:20:57.34,Main,,0,0,0,,Gelin-sama!
Dialogue: 0,0:20:57.90,0:20:59.74,Main,,0,0,0,,Gelin-sama! Gelin-sama!
Dialogue: 0,0:20:59.74,0:21:01.60,Main,,0,0,0,,Toplayın kendinizi geli--
Dialogue: 0,0:21:01.60,0:21:03.31,Main,,0,0,0,,Dur lan! Kızı öldüreceksin!
Dialogue: 0,0:21:03.31,0:21:04.44,Main,,0,0,0,,Ne?
Dialogue: 0,0:21:05.18,0:21:08.06,Main,,0,0,0,,{\i1}Bize karı koca dedi ya! İnanmıyorum!
Dialogue: 0,0:21:08.06,0:21:09.44,Main,,0,0,0,,Bana bak.
Dialogue: 0,0:21:09.44,0:21:12.58,Thoughts,,0,0,0,,{\i1}Ne? Aniden "Bana bak!" deyiverdi!
Dialogue: 0,0:21:12.58,0:21:16.54,Thoughts,,0,0,0,,{\i1}Yumruğunu masaya vurabilen bir kocaya\Nsahip olmak fena değil aslında.
Dialogue: 0,0:21:16.54,0:21:20.19,Thoughts,,0,0,0,,{\i1}Yok ama ilişkiye doğru başlangıç yapmak lazım.
Dialogue: 0,0:21:20.19,0:21:25.50,Main,,0,0,0,,B- Beni hizmetçin olarak görürsen\Nbi' kaşık suda boğarım seni Sanji...
Dialogue: 0,0:21:25.50,0:21:27.29,Main,,0,0,0,,Bazı malzemelere hemen ihtiyacım var.
Dialogue: 0,0:21:27.29,0:21:32.10,Main,,0,0,0,,Homojenize edilmemiş süt,\Nşeker pancarı, muz, çörek otu...
Dialogue: 0,0:21:32.10,0:21:35.34,Main,,0,0,0,,...kavrulmuş soya unu, yoğurt. Bolca.
Dialogue: 0,0:21:35.34,0:21:36.54,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:21:37.59,0:21:39.43,Main,,0,0,0,,{\i1}...san{\i1}!{\i0}
Dialogue: 0,0:21:40.97,0:21:45.64,Main,,0,0,0,,Millet! Pasta pişene değin\Nzamana karşı yarıştığımızı bilin!
Dialogue: 0,0:21:45.64,0:21:50.37,Main,,0,0,0,,Chiffon-{\i1}chan{\i0}, dev şifon pastası sende.
Dialogue: 0,0:21:50.37,0:21:54.48,Main,,0,0,0,,Pudding-{\i1}chan{\i0}, çikolataları \Nsertleştirme işi de senin ellerinden öper.
Dialogue: 0,0:21:55.53,0:21:58.42,Main,,0,0,0,,2 saat 40 dakikaya bitirmelisiniz!
Dialogue: 0,0:21:58.44,0:22:01.83,Main,,0,0,0,,Gerçekten de zamana karşı yarışıyoruz.
Dialogue: 0,0:22:01.83,0:22:06.54,Main,,0,0,0,,Bu aşamaları geçtikten sonra\Ngizli malzememi ekleyeceğim!
Dialogue: 0,0:22:06.54,0:22:10.31,Main,,0,0,0,,Tadan kişiye\Nmutluluğun doruklarını yaşatacak!
Dialogue: 0,0:22:10.31,0:22:13.38,Main,,0,0,0,,Size gerçek bir tatlı yedireceğim!
Dialogue: 0,0:22:13.38,0:22:16.92,Main,,0,0,0,,G- Gerçek bir tatlı mı?
Dialogue: 0,0:22:16.92,0:22:22.49,Main,,0,0,0,,Üç saate kalmadan pastayı olduğu gibi\Ngemiye yükleyip Kakao Adası'ndan çıkıyoruz.
Dialogue: 0,0:22:22.49,0:22:27.20,Main,,0,0,0,,Soğur soğumaz da\Ngemide süslemeye başlıyoruz.
Dialogue: 0,0:22:27.20,0:22:31.58,Main,,0,0,0,,Big Mom'ın kovaladığı Luffyler'le\NSunny-go'da buluşmadan evvel...
Dialogue: 0,0:22:31.58,0:22:34.86,Main,,0,0,0,,...en leziz pastayı tamamlamış olacağız!
Dialogue: 0,0:22:34.86,0:22:37.28,Main,,0,0,0,,Anladım. Zamanı verimli kullanıyoruz.
Dialogue: 0,0:22:37.28,0:22:39.40,Main,,0,0,0,,Ama o denli hızlı mı?
Dialogue: 0,0:22:39.40,0:22:41.45,Main,,0,0,0,,Nereden bakarsan bak imkânsız!
Dialogue: 0,0:22:41.45,0:22:44.84,Main,,0,0,0,,Yapmamız gerek! \NMama ülkeyi başımıza mı yıksın istiyorsunuz?
Dialogue: 0,0:22:44.84,0:22:48.04,Main,,0,0,0,,Bağışlayın efendim!\NTalimatlarınızı uygulayacağız!
Dialogue: 0,0:22:49.70,0:22:51.11,Main,,0,0,0,,Pekâlâ!
Dialogue: 0,0:22:51.46,0:22:53.02,Main,,0,0,0,,Pişirmeye başlayalım!
Dialogue: 0,0:22:54.38,0:22:56.87,Thoughts,,0,0,0,,{\i1}Lola'yı kurtaranların hatrına!
Dialogue: 0,0:22:57.92,0:22:59.97,Thoughts,,0,0,0,,{\i1}Sanji-{\i0}san'ın hatrına{\i1}!{\i0}
Dialogue: 0,0:22:59.97,0:23:06.23,Thoughts,,0,0,0,,{\i1}Özel tarifim olan acayip\Nkabarık şifon pastamı yapacağım!
Dialogue: 0,0:23:06.23,0:23:09.44,Thoughts,,0,0,0,,{\i1}Sanji-sanlar'ın kaçmasına yardım etmeliyim!
Dialogue: 0,0:23:09.44,0:23:12.43,Thoughts,,0,0,0,,{\i1}Tatlı mı tatlı çikolatam ile!
Dialogue: 0,0:23:13.64,0:23:16.65,Thoughts,,0,0,0,,{\i1}Sıkın dişinizi çocuklar.
Dialogue: 0,0:23:17.65,0:23:19.17,Thoughts,,0,0,0,,{\i1}Gözükara aşçılığımı...{\i}
Dialogue: 0,0:23:20.02,0:23:22.27,Thoughts,,0,0,0,,{\i1}...hepsine göstereceğim!{\i}
Dialogue: 0,0:23:25.69,0:23:29.10,Captions,,1000,0,345,,{\fad(400,0}Ayna Dünyası
Dialogue: 0,0:23:26.70,0:23:29.10,Main,,0,0,0,,{\i1}Katakuri, benim.
Dialogue: 0,0:23:29.10,0:23:31.93,Main,,0,0,0,,Kurtuldun demek Peros abi.
Dialogue: 0,0:23:31.93,0:23:33.65,Main,,0,0,0,,{\i1}Sorma, kıl payıyla.
Dialogue: 0,0:23:33.65,0:23:37.42,Main,,0,0,0,,{\i1}Ulan ne rezil biçimde öldü ama ya!
Dialogue: 0,0:23:37.42,0:23:40.25,Main,,0,0,0,,{\i1}Pedro'yu diyorum.
Dialogue: 0,0:23:40.25,0:23:43.63,Main,,0,0,0,,{\i1}Hasır Şapka! \NSen de tanık oldun, değil mi?
Dialogue: 0,0:23:45.91,0:23:52.14,Main,,0,0,0,,{\i1}Beş para etmez hayatını feda ederek\Nbeni öldürmeye çalıştıysa da...
Dialogue: 0,0:23:52.14,0:23:55.18,Main,,0,0,0,,...gördüğün gibi turp gibiyim!
Dialogue: 0,0:23:55.90,0:23:59.73,Main,,0,0,0,,{\i1}Yani bok yoluna gitti, değil mi?
Dialogue: 0,0:23:59.73,0:24:04.45,Main,,0,0,0,,{\i1}Senin de Pedro gibi bir hiç uğruna\Nöleceğin kesinleşti.
Dialogue: 0,0:24:04.45,0:24:08.15,Main,,0,0,0,,{\i1}Acına son vermesine izin ver haydi-perorin.
Dialogue: 0,0:24:08.15,0:24:10.67,Main,,0,0,0,,Hasır Şapka'nın adamları ne âlemde?
Dialogue: 0,0:24:10.67,0:24:12.84,Main,,0,0,0,,{\i1}İnanmayacaksın ama...
Dialogue: 0,0:24:12.84,0:24:15.52,Main,,0,0,0,,{\i1}...gemiyle gökyüzüne uçup\Nkuşatmamızdan kurtuldular.
Dialogue: 0,0:24:15.52,0:24:18.34,Main,,0,0,0,,Şu an Mama ile peşlerindeyiz.
Dialogue: 0,0:24:18.34,0:24:21.30,Main,,0,0,0,,Denizin üzerinde yürüyoruz.
Dialogue: 0,0:24:21.30,0:24:26.22,Main,,0,0,0,,Canla başla kaçmaya çalışıyorlar fakat\Nçok yakında enselerinde biteriz.
Dialogue: 0,0:24:26.22,0:24:29.89,Main,,0,0,0,,Amandeler'in filosu da yakında bize katılır.
Dialogue: 0,0:24:29.89,0:24:30.80,Main,,0,0,0,,Anladım.
Dialogue: 0,0:24:32.20,0:24:34.10,Main,,0,0,0,,Brûlée.
Dialogue: 0,0:24:35.99,0:24:38.46,Main,,0,0,0,,Ah, Abi...
Dialogue: 0,0:24:38.46,0:24:43.39,Main,,0,0,0,,Daha ne kadar uyuyacaksın? \NSen uyursan askerlerimiz burada tıkılı kalır.
Dialogue: 0,0:24:43.39,0:24:44.37,Main,,0,0,0,,Tamam.
Dialogue: 0,0:24:44.37,0:24:47.80,Main,,0,0,0,,Cesurca mürettebatını kurtardığını düşünürken...
Dialogue: 0,0:24:47.80,0:24:49.40,Main,,0,0,0,,...herifin düştüğü duruma baksana.
Dialogue: 0,0:24:49.40,0:24:53.26,Main,,0,0,0,,Askerlerle gidip Hasır Şapka'nın\Ngemisini kundaklayın ya da zarar verin.
Dialogue: 0,0:24:53.26,0:24:54.28,Main,,0,0,0,,Tamam!
Dialogue: 0,0:24:54.28,0:24:56.04,Main,,0,0,0,,Brûlée abla!
Dialogue: 0,0:24:56.04,0:24:59.43,Main,,0,0,1,,Hasır Şapka'nın gemisine çıkan bir ayna bulduk!
Dialogue: 0,0:24:56.26,0:25:01.50,Captions,,0,500,200,,{\fad(500,0)}Mascarpone\NCharlotte Ailesi'nin 34. Oğlu
Dialogue: 0,0:24:56.26,0:25:01.50,Captions,,500,0,120,,{\pos(900,480)}{\fad(500,0)}Joscarpone\NCharlotte Ailesi'nin 29. Kızı
Dialogue: 0,0:24:59.43,0:25:01.50,Main,,0,0,1,,Birkaç ayna daha var!
Dialogue: 0,0:25:01.50,0:25:06.17,Main,,0,0,0,,Güzel! Hasır Şapka'nın gemisine\Nyanan oklar fırlatalım!
Dialogue: 0,0:25:06.17,0:25:11.97,Main,,0,0,0,,Alevler içinde çırpınırken\NMama'nın ellerinde can verirler umarım!
Dialogue: 0,0:25:12.62,0:25:13.76,Main,,0,0,0,,Sıyırdı!
Dialogue: 0,0:25:18.53,0:25:21.23,Main,,0,0,0,,Aynayı verin lan!
Dialogue: 0,0:25:21.24,0:25:23.52,Main,,0,0,0,,Yoldaşlarımı rahat bırakın!
Dialogue: 0,0:25:24.96,0:25:28.68,Main,,0,0,0,,Benimle bir düellonun ortasındaydın\Nsanki Hasır Şapka.
Dialogue: 0,0:25:30.09,0:25:32.30,Main,,0,0,0,,Oh olsun!
Dialogue: 0,0:25:36.01,0:25:41.28,Main,,0,0,0,,Haydi, Hasır Şapka'nın gemisini yakıp kül edin!
Dialogue: 0,0:25:41.28,0:25:43.40,Main,,0,0,0,,Hay hay!
Dialogue: 0,0:25:46.39,0:25:48.82,Main,,0,0,0,,Hazır mısın Joscar?
Dialogue: 0,0:25:48.82,0:25:51.06,Main,,0,0,0,,Daima Mascar.
Dialogue: 0,0:25:57.51,0:26:00.75,Main,,0,0,0,,Pekâlâ, bırakın!
Dialogue: 0,0:26:04.35,0:26:06.41,Main,,0,0,0,,Durun!!
Dialogue: 0,0:26:16.91,0:26:18.48,Main,,0,0,0,,Durun!
Dialogue: 0,0:26:18.48,0:26:20.81,Main,,0,0,0,,Sen dur asıl.
Dialogue: 0,0:26:20.81,0:26:25.86,Main,,0,0,0,,Biricik kardeşlerime el uzatma!
Dialogue: 0,0:26:33.68,0:26:35.62,Main,,0,0,0,,Bir ayna!
Dialogue: 0,0:26:39.37,0:26:41.04,Main,,0,0,0,,Hey, Nami!
Dialogue: 0,0:26:44.24,0:26:46.49,Main,,0,0,0,,{\i1}Jinbe, sesimi alıyor musunuz?
Dialogue: 0,0:26:46.91,0:26:48.92,Main,,0,0,0,,{\i1}Biriniz cevap verin!
Dialogue: 0,0:26:49.02,0:26:53.58,Captions,,0,0,0,,{\fad(500,500)}Denizde - Totto Land
Dialogue: 0,0:27:03.94,0:27:06.64,Main,,0,0,0,,{\i1}Hey! Sesimi duyan kimse yok mu?
Dialogue: 0,0:27:06.64,0:27:07.85,Main,,0,0,0,,Ne? Luffy mi?
Dialogue: 0,0:27:07.85,0:27:09.08,Main,,0,0,0,,{\i1}Nami!{\i}
Dialogue: 0,0:27:10.62,0:27:12.60,Main,,0,0,0,,Luffy, benim! Sen iyi misin?
Dialogue: 0,0:27:12.84,0:27:15.64,Main,,0,0,0,,{\i1}Gemide hâlâ aynalar var, değil mi?
Dialogue: 0,0:27:15.64,0:27:16.30,Main,,0,0,0,,Ne?!
Dialogue: 0,0:27:16.30,0:27:18.85,Main,,0,0,0,,{\i1}Erkekler kamarasında ya da tuvalette?
Dialogue: 0,0:27:23.13,0:27:26.07,Main,,0,0,0,,Ateş gitgide şiddetleniyor!
Dialogue: 0,0:27:26.07,0:27:27.91,Main,,0,0,0,,Bırakıyoruz Joscar.
Dialogue: 0,0:27:27.91,0:27:30.03,Main,,0,0,0,,Bırakalım Mascar.
Dialogue: 0,0:27:31.51,0:27:34.12,Main,,0,0,0,,Cayır cayır yanıyor!
Dialogue: 0,0:27:36.08,0:27:38.79,Main,,0,0,0,,{\i1}Luffy! Ne olmuş aynalara?
Dialogue: 0,0:27:38.79,0:27:41.13,Main,,0,0,0,,Hepsini tuzla buz edin!
Dialogue: 0,0:27:41.13,0:27:45.88,Main,,0,0,0,,Çıldırdın mı sen? \NO zaman nasıl yanımıza döneceksin ki?
Dialogue: 0,0:27:45.88,0:27:48.88,Main,,0,0,0,,{\i1}Bilmiyorum ama hallederim!
Dialogue: 0,0:27:49.62,0:27:51.80,Main,,0,0,0,,Bir çaresine bakarım!
Dialogue: 0,0:27:52.74,0:27:54.12,Main,,0,0,0,,Koku...
Dialogue: 0,0:27:55.83,0:27:57.49,Main,,0,0,0,,Yanık kokusu alıyorum!
Dialogue: 0,0:27:57.49,0:27:59.88,Main,,0,0,0,,Burnum olmasa da!
Dialogue: 0,0:28:02.56,0:28:03.69,Main,,0,0,0,,Ne?
Dialogue: 0,0:28:04.92,0:28:07.07,Main,,0,0,0,,Kamara yanıyor!
Dialogue: 0,0:28:07.68,0:28:09.09,Main,,0,0,0,,Sorun nedir?
Dialogue: 0,0:28:10.03,0:28:12.18,Main,,0,0,0,,Bu yangın nasıl çıktı?
Dialogue: 0,0:28:13.68,0:28:15.70,Main,,0,0,0,,Ne?
Dialogue: 0,0:28:17.52,0:28:21.60,Main,,0,0,0,,Aynadan yanan oklar düşüyor!\NPupadan toplar yağıyor!
Dialogue: 0,0:28:21.60,0:28:24.35,Main,,0,0,0,,Ardı arkası kesilmiyor!\NGözlerim şaşı kaldı ya!
Dialogue: 0,0:28:24.35,0:28:27.42,Main,,0,0,0,,Sahi, benim gözlerim yok gerçi.
Dialogue: 0,0:28:27.42,0:28:29.98,Main,,0,0,0,,Neyse ne!\NYangını söndürelim Brook!
Dialogue: 0,0:28:32.20,0:28:35.10,Main,,0,0,0,,Haydi çocuklar, ok fırlatmaya devam edin!
Dialogue: 0,0:28:35.10,0:28:37.35,Main,,0,0,0,,Devam edecekmişiz Joscar.
Dialogue: 0,0:28:37.35,0:28:40.27,Main,,0,0,0,,Edelim öyleyse Mascar.
Dialogue: 0,0:28:40.27,0:28:42.61,Main,,0,0,0,,Dursanıza lan andavallar!
Dialogue: 0,0:28:48.13,0:28:49.90,Main,,0,0,0,,{\i1}Luffy!{\i}
Dialogue: 0,0:28:49.90,0:28:52.32,Main,,0,0,0,,Luffy! Sen iyi misin?
Dialogue: 0,0:28:54.59,0:28:58.43,Main,,0,0,0,,Güverteyi basacaklar peşimden gelsin!
Dialogue: 0,0:29:00.04,0:29:01.48,Main,,0,0,0,,Olamaz!
Dialogue: 0,0:29:09.15,0:29:12.80,Main,,0,0,0,,Nami! \NBir an önce tüm aynaları parçalayın!
Dialogue: 0,0:29:12.80,0:29:13.93,Main,,0,0,0,,Ama...
Dialogue: 0,0:29:13.93,0:29:18.76,Main,,0,0,0,,{\i1}Düşman ordusu yolda!\NTek başıma onları durduramam!
Dialogue: 0,0:29:18.76,0:29:22.52,Main,,0,0,0,,Bırakın da yalnızca bu herife odaklanayım!
Dialogue: 0,0:29:27.79,0:29:28.84,Main,,0,0,0,,Ha?
Dialogue: 0,0:29:32.09,0:29:34.03,Main,,0,0,0,,Nami! Sorunumuz var!
Dialogue: 0,0:29:35.05,0:29:37.16,Main,,0,0,0,,Kaçamayız da!
Dialogue: 0,0:29:40.19,0:29:42.13,Main,,0,0,0,,Tsunami!
Dialogue: 0,0:29:42.13,0:29:43.00,Main,,0,0,0,,Ne?
Dialogue: 0,0:29:46.34,0:29:48.46,Main,,0,0,0,,Orada mısın...
Dialogue: 0,0:29:59.35,0:30:02.45,Main,,0,0,0,,Üzgünüm Luffy...
Dialogue: 0,0:30:03.23,0:30:07.10,Main,,0,0,0,,Kaçamazsınız!
Dialogue: 0,0:30:07.12,0:30:10.07,Main,,0,0,0,,{\i1}Nami! Ne oldu?
Dialogue: 0,0:30:10.07,0:30:12.64,Main,,0,0,0,,Yolun...
Dialogue: 0,0:30:12.64,0:30:15.53,Main,,0,0,0,,...sonuna gelmiş olabiliriz.
