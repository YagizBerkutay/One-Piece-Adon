td B,29,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,95,100,1,0,1,2.2,0,7,10,10,10,1Style: Author,Impress BT,22.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.7,0.7,9,10,10,10,1Style: Attack,Duality,30.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.0,1.0,7,12,12,12,1Style: Nami,Lactosa,52,&H002184FE,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2,0,2,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:16:06.86,0:16:09.42,Nami,,0,0,0,karaoke,Raiun Rod!Dialogue: 0,0:16:06.86,0:16:09.42,Attack,,0,0,0,karaoke,Fırtına Bulutu AsasıDialogue: 0,0:01:34.28,0:01:37.29,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - dmc3 thx to onepace.netDialogue: 0,0:14:47.38,0:14:57.38,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - dmc3 thx to onepace.netDialogue: 0,0:29:13.55,0:29:18.85,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - dmc3 thx to onepace.netDialogue: 0,0:01:34.28,0:01:41.60,Title,,0,0,0,,Burada Değil!Dialogue: 0,0:01:41.60,0:01:45.06,Captions,,0,0,0,,Hazine  AmbarıDialogue: 0,0:01:45.04,0:01:47.84,Main,,0,0,0,,Ne tatlı şeysin sen ya!Dialogue: 0,0:01:47.84,0:01:52.67,Main,,0,0,0,,Tepeden tırnağa kemik olmana rağmen yaşıyorsun! Mucize resmen!Dialogue: 0,0:01:52.67,0:01:56.13,Main,,0,0,0,,Takdire şayan bir dövüş de çıkardın Ruh Kralı.Dialogue: 0,0:01:56.13,0:02:01.60,Main,,0,0,0,,Uzlaşmacı Taşlar senden ölesiye korkuyor!Dialogue: 0,0:02:03.61,0:02:09.26,Main,,0,0,0,,Ruh Kralı mahlasını hak ediyormuşsun! Onların ezeli rakibisin resmen!Dialogue: 0,0:02:09.26,0:02:10.56,Main,,0,0,0,,Lakin...Dialogue: 0,0:02:10.73,0:02:12.73,Captions,,0,0,0,,Bicorne Şapka NapoleonDialogue: 0,0:02:10.56,0:02:14.82,Main,,0,0,0,,...bu üçünü yenemezsin.Dialogue: 0,0:02:12.82,0:02:14.82,Captions,,0,0,0,,Fırtına Bulutu ZeusDialogue: 0,0:02:14.90,0:02:16.69,Captions,,0,0,0,,Güneş PrometheusDialogue: 0,0:02:16.69,0:02:21.63,Main,,0,0,0,,Onlara kendi ruhumdan parçalar veriyorum zira.Dialogue: 0,0:02:22.78,0:02:25.96,Main,,0,0,0,,Anlayacağın ruhları bambaşka bir seviyede!Dialogue: 0,0:02:32.29,0:02:35.00,Main,,0,0,0,,Teftişi tamamlamış bulunuyoruz Mama!Dialogue: 0,0:02:36.02,0:02:39.90,Main,,0,0,0,,Elbiselerinde hiçbir şey yok!Dialogue: 0,0:02:41.44,0:02:44.85,Main,,0,0,0,,Bu kabın içinde de bir şey yok!Dialogue: 0,0:02:44.85,0:02:48.19,Main,,0,0,0,,- Baston kılıcında da... - Pelerininde de...Dialogue: 0,0:02:48.19,0:02:49.88,Main,,0,0,0,,...hiçbir şey yok!Dialogue: 0,0:02:49.88,0:02:54.32,Main,,0,0,0,,Yani hiçbir şey çalmamış!Dialogue: 0,0:02:56.96,0:03:00.32,Main,,0,0,0,,Öyleyse sorun kalmadı Ruh Kralı.Dialogue: 0,0:03:00.32,0:03:04.04,Main,,0,0,0,,Senden şüphelendiğim için kusuruma bakma güzel hayvanım benim.Dialogue: 0,0:03:04.04,0:03:08.12,Thoughts,,0,0,0,,Kemiklerim hiç böyle bir aşağılanma tatmamıştı.Dialogue: 0,0:03:08.12,0:03:11.13,Main,,0,0,0,,Başta Tamatebako olmak üzere...Dialogue: 0,0:03:11.13,0:03:14.73,Main,,0,0,0,,...Poneglifler'in kopyasını falan da çalmana izin veremezdim.Dialogue: 0,0:03:14.73,0:03:18.92,Main,,0,0,0,,Kopyalarını kaptırıp da bir kez daha...Dialogue: 0,0:03:18.92,0:03:25.60,Main,,0,0,0,,...başkalarının Raftel'e ulaşmasına göz yumsam alay konusu olurdum!Dialogue: 0,0:03:30.39,0:03:34.73,Main,,0,0,0,,Roger'da olduğu gibi çuvallamayacağım bu sefer!Dialogue: 0,0:03:34.73,0:03:41.28,Main,,0,0,0,,Her bir haltın sesini işitmesini sağlayan tuhaf yeteneğiyle yazıtları okuyabilmişti...Dialogue: 0,0:03:41.28,0:03:46.99,Main,,0,0,0,,...fakat tayfamda da önünde sonunda böyle bir yeteneği uyandıracak biri var.Dialogue: 0,0:03:51.66,0:03:57.63,Main,,0,0,0,,Raftel'e ulaşacak bir sonraki tayfa benimkinden başkası değil!Dialogue: 0,0:03:57.63,0:03:58.75,Main,,0,0,0,,Mama!Dialogue: 0,0:04:00.34,0:04:05.06,Main,,0,0,0,,Canım Pudding'im! İyi insan lafının üstüne.Dialogue: 0,0:04:05.06,0:04:10.64,Main,,0,0,0,,Ne oldu bakayım? Üçüncü gözün gerçek gücünü uyandırdı mı yoksa?Dialogue: 0,0:04:10.64,0:04:14.69,Main,,0,0,0,,Deme şöyle Mama ya! Beni her gördüğünde aynı hikâye!Dialogue: 0,0:04:14.69,0:04:16.94,Main,,0,0,0,,Safkan değilim ben!Dialogue: 0,0:04:16.94,0:04:20.48,Main,,0,0,0,,Böyle bir gücü uyandıracağımın da bir garantisi yok.Dialogue: 0,0:04:23.21,0:04:25.29,Main,,0,0,0,,Kusura bakma kızım.Dialogue: 0,0:04:25.29,0:04:31.10,Main,,0,0,0,,Ama damarlarında nadir mi nadir Üçgözlü Kabilesi kanı aktığı su götürmez.Dialogue: 0,0:04:31.10,0:04:34.34,Main,,0,0,0,,Üç gözlü Kabile ferdi olarak bir uyanış geçirmezsen...Dialogue: 0,0:04:34.34,0:04:37.17,Main,,0,0,0,,...çirkin suratlı bir kızdan ibaret olursun da!Dialogue: 0,0:04:42.67,0:04:45.33,Thoughts,,0,0,0,,P- Pudding-san?Dialogue: 0,0:04:45.33,0:04:46.97,Thoughts,,0,0,0,,Üçgözlü mü?Dialogue: 0,0:04:48.93,0:04:50.81,Thoughts,,0,0,0,,Olamaz!Dialogue: 0,0:04:50.81,0:04:53.23,Thoughts,,0,0,0,,Birbirimizi tanıdığımız...Dialogue: 0,0:04:53.23,0:04:55.69,Thoughts,,0,0,0,,...sır olarak kalmalı!Dialogue: 0,0:04:55.69,0:04:58.23,Thoughts,,0,0,0,,İskelet adam...Dialogue: 0,0:04:58.23,0:05:03.71,Thoughts,,0,0,0,,Buraya ulaşmasını beklemiyordum. Yakalandığı iyi olmuş ama.Dialogue: 0,0:05:04.08,0:05:08.98,Main,,0,0,0,,Baksana Mama! Burada konuşmaya çekiniyorum, odana geçebilir miyiz?Dialogue: 0,0:05:08.98,0:05:12.99,Main,,0,0,0,,Tabii tabii, hiç sorun değil.Dialogue: 0,0:05:45.56,0:05:48.49,Main,,0,0,0,,Ü ürü üü!Dialogue: 0,0:05:50.14,0:05:52.12,Main,,0,0,0,,Bu da...Dialogue: 0,0:05:52.12,0:05:55.91,Main,,0,0,0,,Üçüncü formuna mı evrimleşecek?!Dialogue: 0,0:05:55.91,0:05:58.29,Main,,0,0,0,,Kont Niwatori'ye?!Dialogue: 0,0:05:58.86,0:06:00.38,Main,,0,0,0,,Saçmalık.Dialogue: 0,0:06:00.83,0:06:03.13,Main,,0,0,0,,Şimdi işini bitireceğim.Dialogue: 0,0:06:04.38,0:06:06.92,Main,,0,0,0,,Yapma!Dialogue: 0,0:06:06.92,0:06:11.50,Main,,0,0,0,,Baron Tamago'dan Vikont Hiyoko'ya, sonra da Kont Niwatori'ye evrimleşiyor!Dialogue: 0,0:06:06.92,0:06:11.50,Note,,0,0,0,,Tamago (yumurta), bir Hiyoko (civciv) olarak çıkıp, sonra bir Niwatori (tavuk) haline evrim geçirir.Dialogue: 0,0:06:11.50,0:06:13.94,Main,,0,0,0,,Evrimleştikçe gücü de katlanıyor!Dialogue: 0,0:06:13.94,0:06:16.29,Main,,0,0,0,,Yumurta Meyvesi yedi neticede!Dialogue: 0,0:06:16.29,0:06:20.56,Main,,0,0,0,,Kont Niwatori hakiki bir şövalye diye tırstın herhâlde!Dialogue: 0,0:06:20.56,0:06:24.60,Main,,0,0,0,,Evrimini tamamladı mı karşısında duramayacağın bir güce erişecek!Dialogue: 0,0:06:24.60,0:06:27.03,Main,,0,0,0,,Oyalayın onu!Dialogue: 0,0:06:27.03,0:06:28.65,Main,,0,0,0,,Bekleyecek değilim.Dialogue: 0,0:06:28.65,0:06:31.95,Main,,0,0,0,,Dur!!Dialogue: 0,0:06:42.36,0:06:44.13,Main,,0,0,0,,Durayım öyleyse.Dialogue: 0,0:06:45.28,0:06:47.01,Thoughts,,0,0,0,,Şimdi!Dialogue: 0,0:06:59.31,0:07:02.05,Main,,0,0,0,,Bu kadar askerin etrafı sarması iyi oldu.Dialogue: 0,0:07:03.72,0:07:06.78,Main,,0,0,0,,Şerefsiz!! Ne yapıyorsun lan?!Dialogue: 0,0:07:07.64,0:07:09.36,Main,,0,0,0,,Geri çekilin!Dialogue: 0,0:07:09.76,0:07:11.98,Main,,0,0,0,,Kaçın!Dialogue: 0,0:07:17.19,0:07:19.48,Main,,0,0,0,,Yem olmak gibisi yok.Dialogue: 0,0:07:19.48,0:07:21.08,Main,,0,0,0,,Yapma!!Dialogue: 0,0:07:32.20,0:07:35.35,Main,,0,0,0,,Ü ürü üüü!Dialogue: 0,0:07:56.20,0:08:00.08,Captions,,0,0,0,,Ayna DünyasıDialogue: 0,0:08:03.83,0:08:09.00,Main,,0,0,0,,Kıl payıyla ha! Şimdiye ölmüş olabilirdin Pedro!Dialogue: 0,0:08:09.00,0:08:11.59,Main,,0,0,0,,Bu ne pervasızlıktır ama ya?!Dialogue: 0,0:08:11.59,0:08:15.14,Main,,0,0,0,,Pedro, şaştım kaldım resmen!Dialogue: 0,0:08:16.09,0:08:18.97,Main,,0,0,0,,Asıl şaşırıp kalan bendim!Dialogue: 0,0:08:19.34,0:08:22.27,Flashbacks,,0,0,0,,Buraya bak Pedro!Dialogue: 0,0:08:22.81,0:08:26.73,Main,,0,0,0,,Ansızın bir aynanın içinden size sesleniyorlar!Dialogue: 0,0:08:26.73,0:08:32.07,Main,,0,0,0,,Ana hemencecik böyle bir plan yaptın ya, senden de bu beklenirdi Pedro!Dialogue: 0,0:08:32.07,0:08:35.79,Main,,0,0,0,,O değil de burası ayna boyutu mu oluyormuş?Dialogue: 0,0:08:35.79,0:08:38.08,Main,,0,0,0,,İnanmakta güçlük çekiyorum.Dialogue: 0,0:08:38.08,0:08:43.17,Main,,0,0,0,,Brûlée olmadan kimsecikler buraya giremez de çıkamaz da, yani güvendeyiz!Dialogue: 0,0:08:43.17,0:08:46.79,Main,,0,0,0,,Bu boyutu kullanarak Sanji'yle birlikte kaçabiliriz!Dialogue: 0,0:08:46.79,0:08:49.80,Main,,0,0,0,,Bildiklerini bizimle paylaş şimdi.Dialogue: 0,0:08:52.42,0:08:53.90,Main,,0,0,0,,Ne?!Dialogue: 0,0:08:53.90,0:08:56.38,Main,,0,0,0,,Luffy ile Nami'yi yakalamışlar mı?!Dialogue: 0,0:08:56.38,0:08:58.80,Main,,0,0,0,,Evet, öyle duydum.Dialogue: 0,0:08:58.80,0:09:00.58,Main,,0,0,0,,Brook için de endişeleniyorum.Dialogue: 0,0:09:00.58,0:09:03.77,Main,,0,0,0,,Umarım sorunsuzca Poneglif'in kopyasını alabilmiştir.Dialogue: 0,0:09:04.28,0:09:07.23,Main,,0,0,0,,Hepsi de tehlikede! Elimizi çabuk tutalım!Dialogue: 0,0:09:07.23,0:09:10.63,Main,,0,0,0,,Carrot! Bizimkilerin portreleri bitti mi?Dialogue: 0,0:09:10.63,0:09:12.97,Main,,0,0,0,,Evet, hepsini bitirdim Choniki!Dialogue: 0,0:09:12.97,0:09:15.60,Main,,0,0,0,,Harbi mi?! Eline sağlık!Dialogue: 0,0:09:15.60,0:09:19.02,Main,,0,0,0,,Öyleyse çizimlerini aynalara göstererek onları aramaya koyulalım!Dialogue: 0,0:09:19.02,0:09:20.16,Main,,0,0,0,,Tamam!Dialogue: 0,0:09:21.66,0:09:26.20,Main,,0,0,0,,Ayna ayna söyle bana! Bu gördüğün yüzler nerede?!Dialogue: 0,0:09:26.20,0:09:28.13,Main,,0,0,0,,Gerçekleriyle hiçbir alakaları yok!Dialogue: 0,0:09:28.13,0:09:32.24,Main,,0,0,0,,Uzun saçlı kız demin yanımdan koşarak geçti.Dialogue: 0,0:09:32.24,0:09:34.13,Main,,0,0,0,,Ayna konuştu!Dialogue: 0,0:09:34.13,0:09:39.30,Main,,0,0,0,,Ne?! Nami kurtuldu mu yani? Luffy'yle mi birlikte peki?Dialogue: 0,0:09:39.30,0:09:41.72,Main,,0,0,0,,Patron Jinbe'yle birlikte!Dialogue: 0,0:09:41.72,0:09:44.77,Main,,0,0,0,,J... Jinbe mi?Dialogue: 0,0:09:44.77,0:09:47.60,Main,,0,0,0,,N- Ne?!Dialogue: 0,0:09:49.77,0:09:51.65,Main,,0,0,0,,Sanji!Dialogue: 0,0:09:49.81,0:09:51.65,Captions,,0,0,0,,Baum Kek, Üçüncü KatDialogue: 0,0:09:51.65,0:09:54.15,Main,,0,0,0,,Beni duyuyorsan cevap ver!Dialogue: 0,0:09:54.15,0:09:56.36,Main,,0,0,0,,Dur bakalım Hasır Şapka!Dialogue: 0,0:09:56.74,0:09:58.45,Main,,0,0,0,,Sanji!Dialogue: 0,0:09:58.45,0:09:59.82,Main,,0,0,0,,Sana diyorum!Dialogue: 0,0:09:59.82,0:10:04.46,Main,,0,0,0,,Bilmen gereken bir şey var! Neredesin?!Dialogue: 0,0:10:04.46,0:10:07.62,Main,,0,0,0,,Diyeceklerimi dinle bi'!Dialogue: 0,0:10:09.33,0:10:11.71,Main,,0,0,0,,Kolum kolum...Dialogue: 0,0:10:17.39,0:10:19.55,Main,,0,0,0,,Hasır Şapka nereye kayboldu?!Dialogue: 0,0:10:19.55,0:10:23.09,Main,,0,0,0,,Lan ne kadar hızlı koşuyor! Nereye gitti?Dialogue: 0,0:10:23.09,0:10:24.68,Main,,0,0,0,,Burada mı ki?!Dialogue: 0,0:10:31.86,0:10:33.35,Main,,0,0,0,,Kilitli!Dialogue: 0,0:10:33.35,0:10:36.11,Main,,0,0,0,,- Şu tarafa bakalım! - Tamam!Dialogue: 0,0:10:40.41,0:10:43.37,Main,,0,0,0,,Sanji'nin ablasısın sen!Dialogue: 0,0:10:43.37,0:10:44.36,Main,,0,0,0,,Evet.Dialogue: 0,0:10:44.36,0:10:47.58,Main,,0,0,0,,Neden beni içeri çektin?! Acelem var şurada!Dialogue: 0,0:10:47.58,0:10:52.50,Main,,0,0,0,,Sanji'yi arıyorsun, değil mi? Daha demin buradaydı.Dialogue: 0,0:10:52.50,0:10:55.88,Main,,0,0,0,,Ne?! Cidden mi?! Nereye gitti peki?!Dialogue: 0,0:10:55.88,0:10:59.22,Main,,0,0,0,,Pudding bizi kandırıyormuş!Dialogue: 0,0:10:59.22,0:11:03.98,Main,,0,0,0,,Sanji'nin evleneceği Pudding, onu öldüreceğini söyledi!Dialogue: 0,0:11:05.06,0:11:08.77,Main,,0,0,0,,İyi misin sen? Yaralandın mı?Dialogue: 0,0:11:10.23,0:11:13.27,Main,,0,0,0,,Bir şeyim yok, teşekkür ederim.Dialogue: 0,0:11:13.27,0:11:16.57,Main,,0,0,0,,Pudding mevzusundan haberdar.Dialogue: 0,0:11:16.57,0:11:20.03,Main,,0,0,0,,Ne?! Başından beri biliyor muymuş yani?Dialogue: 0,0:11:20.62,0:11:22.99,Main,,0,0,0,,Daha yeni öğrendi aslında.Dialogue: 0,0:11:24.75,0:11:28.83,Main,,0,0,0,,Bu adadan kaçıp gitmesi için onu ikna etmeye çalıştım ama...Dialogue: 0,0:11:28.83,0:11:32.25,Main,,0,0,0,,...Doğu Mavi'de rehin tutulan tanıdıkları ve de...Dialogue: 0,0:11:32.25,0:11:35.54,Main,,0,0,0,,...sizin başınıza saracağı sorunlar yüzünden endişelendi.Dialogue: 0,0:11:35.54,0:11:37.88,Main,,0,0,0,,Rehin derken Baratie'yi mi kastediyorsun?!Dialogue: 0,0:11:37.88,0:11:44.43,Main,,0,0,0,,Ben de onlarla yakınımdır! Cidden tehlikedelerse bizzat oraya döner ve onlar için savaşırım!Dialogue: 0,0:11:47.39,0:11:49.31,Main,,0,0,0,,Bir şey yemek ister misin?!Dialogue: 0,0:11:49.31,0:11:51.06,Main,,0,0,0,,G- Gerek yok!Dialogue: 0,0:11:58.02,0:12:00.94,Flashbacks,,0,0,0,,Tam burada bekleyeceğim!Dialogue: 0,0:12:00.94,0:12:05.79,Flashbacks,,0,0,0,,Olur da gelmezsen, buracıkta...Dialogue: 0,0:12:05.79,0:12:08.41,Flashbacks,,0,0,0,,...açlıktan ölürüm bak!Dialogue: 0,0:12:08.41,0:12:12.46,Flashbacks,,0,0,0,,Benim gemimin aşçısısın sen!Dialogue: 0,0:12:13.67,0:12:18.71,Flashbacks,,0,0,0,,Senin elinden olmayan hiçbir şeyi yemeyeceğim!Dialogue: 0,0:12:24.74,0:12:29.10,Main,,0,0,0,,Sevindim öyleyse.Dialogue: 0,0:12:29.10,0:12:33.05,Main,,0,0,0,,Sanji, Pudding konusundan haberdar demek.Dialogue: 0,0:12:36.55,0:12:39.25,Main,,0,0,0,,Kandırılmıyorsa sorun yok demektir.Dialogue: 0,0:12:39.25,0:12:42.69,Main,,0,0,0,,Ayrıca yapabileceğim her şeyi de yaptım.Dialogue: 0,0:12:43.49,0:12:46.41,Main,,0,0,0,,Tamamdır, teşekkür ederim Sanji'nin ablası!Dialogue: 0,0:12:46.98,0:12:49.74,Main,,0,0,0,,Ne?! Neden oraya gidiyorsun?!Dialogue: 0,0:12:49.74,0:12:54.08,Main,,0,0,0,,Sözleştiğimiz yer burası değildi!Dialogue: 0,0:13:06.12,0:13:09.05,Main,,0,0,0,,Sanji!Dialogue: 0,0:13:13.48,0:13:17.15,Flashbacks,,0,0,0,,Bu adamın kellesini alırım.Dialogue: 0,0:13:19.73,0:13:23.44,Flashbacks,,0,0,0,,Sen bir kurbansın Sanji.Dialogue: 0,0:13:26.24,0:13:32.74,Flashbacks,,0,0,0,,Kaçmazsan her şey tatlı tatlı çözülür Sanji.Dialogue: 0,0:13:35.37,0:13:37.83,Flashbacks,,0,0,0,,Yarınki düğünde...Dialogue: 0,0:13:37.83,0:13:40.29,Flashbacks,,0,0,0,,...tüm Vinsmoke fertleri...Dialogue: 0,0:13:42.05,0:13:44.51,Flashbacks,,0,0,0,,...katledilecek!Dialogue: 0,0:13:49.85,0:13:53.10,Flashbacks,,0,0,0,,Kaybolun aşağılık korsanlar!Dialogue: 0,0:14:00.49,0:14:05.15,Thoughts,,0,0,0,,Artık geri dönemem Luffy.Dialogue: 0,0:14:12.56,0:14:15.55,Main,,0,0,0,,Evime bir şey düştü!Dialogue: 0,0:14:17.37,0:14:21.75,Main,,0,0,0,,- Güzel evim! - Gecenin bi' yarısı n'oluyor ya?Dialogue: 0,0:14:23.27,0:14:24.67,Main,,0,0,0,,Bir insan mı?Dialogue: 0,0:14:35.35,0:14:38.24,Main,,0,0,0,,B- Baksana! İyi misin sen?Dialogue: 0,0:14:53.41,0:14:55.99,Main,,0,0,0,,Buradaydın demek.Dialogue: 0,0:15:01.74,0:15:04.66,Main,,0,0,0,,Bir an evvel oraya dönmem gerek.Dialogue: 0,0:15:04.66,0:15:08.13,Flashbacks,,0,0,0,,Tam burada bekleyeceğim!Dialogue: 0,0:15:18.38,0:15:21.60,Main,,0,0,0,,Orada beklemem gerek!Dialogue: 0,0:15:21.60,0:15:24.68,Main,,0,0,0,,Tam orada!Dialogue: 0,0:15:36.21,0:15:37.91,Main,,0,0,0,,Yollarını kapayın!Dialogue: 0,0:15:43.54,0:15:47.26,Main,,0,0,0,,Olamaz! Etrafımız sarılacak gibi.Dialogue: 0,0:15:47.26,0:15:49.92,Main,,0,0,0,,Ne?! Bir çıkış yolumuz yok mu?Dialogue: 0,0:15:51.17,0:15:53.01,Main,,0,0,0,,Arkamızdakileri halledebilir misin Nami?!Dialogue: 0,0:15:53.01,0:15:56.39,Main,,0,0,0,,O işi bana bırak! Burama kadar geldi artık!Dialogue: 0,0:16:00.24,0:16:01.94,Main,,0,0,0,,Buldum sizi!Dialogue: 0,0:16:01.94,0:16:04.02,Main,,0,0,0,,Durun!!Dialogue: 0,0:16:04.02,0:16:04.73,Main,,0,0,0,,Nami!Dialogue: 0,0:16:04.73,0:16:06.44,Main,,0,0,0,,Sinirimi bozuyorsunuz artık!Dialogue: 0,0:16:24.17,0:16:26.58,Main,,0,0,0,,Ne?! Chopper!Dialogue: 0,0:16:26.58,0:16:28.75,Main,,0,0,0,,Ne?!Dialogue: 0,0:16:28.75,0:16:31.73,Main,,0,0,0,,Chopper! Burada ne işin var senin?!Dialogue: 0,0:16:31.73,0:16:34.22,Main,,0,0,0,,Ne! Choniki!Dialogue: 0,0:16:34.22,0:16:35.51,Main,,0,0,0,,Carrot!Dialogue: 0,0:16:35.51,0:16:39.14,Main,,0,0,0,,Nami! Sizi kurtarmaya gelmiştik ya!Dialogue: 0,0:16:39.14,0:16:42.48,Main,,0,0,0,,Öyle mi?! Kusura bakmayın ya!Dialogue: 0,0:16:43.45,0:16:46.56,Main,,0,0,0,,Olamaz! Düşmanın dahası da varmış!Dialogue: 0,0:16:47.45,0:16:50.40,Main,,0,0,0,,Nami! Çabuk aynanın içine girin!Dialogue: 0,0:16:50.40,0:16:51.32,Main,,0,0,0,,Ne?!Dialogue: 0,0:16:55.11,0:16:56.78,Main,,0,0,0,,Of of!Dialogue: 0,0:16:56.78,0:16:59.21,Main,,0,0,0,,Neyin var Prometheus?Dialogue: 0,0:16:56.95,0:17:01.95,Captions,,0,0,0,,Kraliçe'nin Odası, Whole Cake ŞatosuDialogue: 0,0:16:59.21,0:17:03.34,Main,,0,0,0,,Ruh Kralı'nın açtığı yara sandığımdan daha derinmiş de...Dialogue: 0,0:17:03.34,0:17:05.56,Main,,0,0,0,,...yine açıldı ya!Dialogue: 0,0:17:06.10,0:17:07.75,Main,,0,0,0,,Kalıbından utan!Dialogue: 0,0:17:07.75,0:17:11.05,Main,,0,0,0,,Aslında takdirimizi hak ediyor.Dialogue: 0,0:17:11.05,0:17:16.05,Main,,0,0,0,,Neticede şimdiye kadar kimseler sizi yaralayamamıştı.Dialogue: 0,0:17:18.68,0:17:22.38,Main,,0,0,0,,Mama, o iskelet hep burada mı kalacak?Dialogue: 0,0:17:22.38,0:17:27.68,Thoughts,,0,0,0,,Ne? İskelet mi? Pudding-san, nasıl öyle dersin?!Dialogue: 0,0:17:27.68,0:17:30.34,Main,,0,0,0,,- Evet, herhâlde! - Çok yakından tutuyor!Dialogue: 0,0:17:30.34,0:17:34.36,Main,,0,0,0,,Bu varlığın eşi benzeri yok! Âdeta ruhani bir sanat eseri.Dialogue: 0,0:17:36.24,0:17:39.92,Main,,0,0,0,,Kitaba koymaktansa bir süre daha yanımda taşıyacağım.Dialogue: 0,0:17:39.92,0:17:40.87,Thoughts,,0,0,0,,Eyvahlar olsun...Dialogue: 0,0:17:40.87,0:17:44.72,Main,,0,0,0,,Sen de Hasır Şapkalar'ı iyi idare ettin.Dialogue: 0,0:17:44.72,0:17:49.43,Main,,0,0,0,,Ayartan Orman'ı geçebilmelerini beklemiyordum gerçi.Dialogue: 0,0:17:49.43,0:17:54.75,Main,,0,0,0,,Yine de zindan kütüphanesine hapsetmeyi başardık.Dialogue: 0,0:17:55.67,0:18:00.22,Main,,0,0,0,,Evet, ben de ziyaret ettim onları. Akıllansınlar şimdi.Dialogue: 0,0:18:00.22,0:18:02.22,Main,,0,0,0,,"Akıllansınlar" mı?Dialogue: 0,0:18:02.22,0:18:06.32,Main,,0,0,0,,- Onları öldürecek misin peki? - Evet, düğünden sonra.Dialogue: 0,0:18:06.32,0:18:10.95,Main,,0,0,0,,Germa'dakilere güzel kızlarımızı gönderdim.Dialogue: 0,0:18:10.95,0:18:14.98,Main,,0,0,0,,Şimdiye kafaları bir milyon olmuştur, hiçbir şeyden şüphe etmezler.Dialogue: 0,0:18:14.98,0:18:19.80,Main,,0,0,0,,Peki. Fakat Reiju beni dikizliyordu.Dialogue: 0,0:18:19.80,0:18:24.16,Main,,0,0,0,,Sezgileri çok kuvvetliymiş. Yine de o sorunun icabına baktım.Dialogue: 0,0:18:25.56,0:18:28.37,Main,,0,0,0,,Ne? Umarım öldürmemişsindir?!Dialogue: 0,0:18:28.37,0:18:32.60,Main,,0,0,0,,Ne diyorsun ya Mama?! Bana hiç mi güvenmiyorsun?! Bacağından vurdum sadece!Dialogue: 0,0:18:32.60,0:18:35.55,Main,,0,0,0,,Bir el ateş ettikten sonra hafızasını da sildim.Dialogue: 0,0:18:35.55,0:18:39.09,Thoughts,,0,0,0,,Olmayan kulaklarıma inanamıyorum.Dialogue: 0,0:18:42.55,0:18:47.35,Thoughts,,0,0,0,,Pudding-san?  Oysa seni hanım hanım bilmiştim.Dialogue: 0,0:18:48.85,0:18:53.20,Main,,0,0,0,,Aman dikkatli ol. Biricik gelinimiz oluyorsun.Dialogue: 0,0:18:53.20,0:18:56.51,Main,,0,0,0,,Olur da intikam almak isterse başımız ağrır.Dialogue: 0,0:18:56.51,0:19:01.03,Main,,0,0,0,,Endişelendiğin için teşekkürler Mama fakat...Dialogue: 0,0:19:01.03,0:19:04.49,Main,,0,0,0,,...silahımı deneme fırsatı da verdi bana.Dialogue: 0,0:19:05.22,0:19:11.62,Main,,0,0,0,,Bu silahla, Germa'nın oynanmış insan bedenlerini kesinlikle delik deşik edebileceğim.Dialogue: 0,0:19:14.11,0:19:16.34,Main,,0,0,0,,Çok güzel!Dialogue: 0,0:19:16.34,0:19:19.34,Main,,0,0,0,,Akıllı kızım benim!Dialogue: 0,0:19:21.24,0:19:26.18,Main,,0,0,0,,Silah atışın yarınki başlama sinyalimiz olacak.Dialogue: 0,0:19:26.18,0:19:29.08,Main,,0,0,0,,Sabırsızlanıyorum!Dialogue: 0,0:19:29.60,0:19:33.03,Main,,0,0,0,,Herkes düğün öpücüğüne odaklanmış hâldeyken...Dialogue: 0,0:19:33.03,0:19:39.78,Main,,0,0,0,,Sanji o sersem suratıyla duvağı kaldırıp seni öpmeye kalkar.Dialogue: 0,0:19:40.18,0:19:41.99,Main,,0,0,0,,Tam o anda...Dialogue: 0,0:19:41.99,0:19:46.87,Main,,0,0,0,,...ilk kez üçüncü gözünü görür!Dialogue: 0,0:19:52.04,0:19:58.25,Main,,0,0,0,,O güzeller güzeli gelinin gerçekteki iğrenç suratını görünce...Dialogue: 0,0:19:59.38,0:20:02.34,Main,,0,0,0,,...birkaç adım geri gider.Dialogue: 0,0:20:02.34,0:20:06.76,Main,,0,0,0,,Tam o sırada yapacaksın! Tamam mı? Tek atışta öldür.Dialogue: 0,0:20:06.76,0:20:10.60,Main,,0,0,0,,İki kaşının arasına, tam buraya nişan al.Dialogue: 0,0:20:16.43,0:20:20.41,Thoughts,,0,0,0,,Pudding-san, Sanji-san'ı mı öldürecek?!Dialogue: 0,0:20:20.41,0:20:24.16,Main,,0,0,0,,Tüm davetliler donup kalacak!Dialogue: 0,0:20:24.16,0:20:29.70,Main,,0,0,0,,Germalılar da küplere binip kaçmaya kalkıştığında...Dialogue: 0,0:20:30.28,0:20:32.75,Main,,0,0,0,,...iş işten geçmiş olacak.Dialogue: 0,0:20:32.75,0:20:38.31,Main,,0,0,0,,Sayısız silah, üzerlerinde çakı bile olmayan Vinsmokelar'a doğrultulacak!Dialogue: 0,0:20:41.09,0:20:45.70,Main,,0,0,0,,Yerler onların kanıyla boyanmadan doğru düzgün tırsma fırsatları bile olmayacak!Dialogue: 0,0:20:45.70,0:20:48.51,Main,,0,0,0,,Tıpkı havai fişekler misali silah atışları hiç dinmeyecek!Dialogue: 0,0:20:48.51,0:20:52.93,Main,,0,0,0,,Ruhları bedenlerini terk ettikten sonra dahi o mermi bombardımanı devam edecek!Dialogue: 0,0:20:52.93,0:20:55.94,Main,,0,0,0,,Zemin kan havuzuna dönecek!Dialogue: 0,0:20:55.94,0:21:00.11,Main,,0,0,0,,6 Vinsmoke'un cansız bedenleri eşliğinde!Dialogue: 0,0:21:00.11,0:21:03.61,Main,,0,0,0,,Silah sesleri ise kutlama atışlarımız olacak!Dialogue: 0,0:21:03.61,0:21:06.66,Main,,0,0,0,,Asıl partimiz o zaman başlayacak!Dialogue: 0,0:21:06.66,0:21:11.19,Main,,0,0,0,,Pastamızı yiyip çayımızı yudumlarken de kutlarız!Dialogue: 0,0:21:12.04,0:21:15.46,Main,,0,0,0,,Beş para etmez liderlerini kaybettiklerinde...Dialogue: 0,0:21:16.37,0:21:22.20,Main,,0,0,0,,...tüm Germa benim olacak!Dialogue: 0,0:21:24.34,0:21:26.80,Captions,,0,0,0,,Ayna OdasıDialogue: 0,0:21:26.80,0:21:28.84,Main,,0,0,0,,Sen iyi misin Choniki?Dialogue: 0,0:21:29.47,0:21:33.34,Main,,0,0,0,,İnanamıyorum! Aynanın içinde miyiz şu an?Dialogue: 0,0:21:33.34,0:21:37.74,Main,,0,0,0,,Jinbe!  Bu sıçanların yanında ne işin var?Dialogue: 0,0:21:37.74,0:21:39.11,Main,,0,0,0,,Brûlée.Dialogue: 0,0:21:39.11,0:21:42.36,Main,,0,0,0,,Bu resmen ihanettir!Dialogue: 0,0:21:43.40,0:21:49.91,Main,,0,0,0,,Tayfadan ayrılmak istediğini ama ruletten tırsıp vazgeçtiğini işitmiştim.Dialogue: 0,0:21:52.29,0:21:57.66,Main,,0,0,0,,Beyazsakal'ın ölümünden sonra  Balık Adam Adası'nı koruduğu için Mama'ya borçluydum.Dialogue: 0,0:21:57.66,0:22:01.84,Main,,0,0,0,,Madem ayrılacaktım, borcumu da ödeyeyim artık dedim.Dialogue: 0,0:22:01.84,0:22:06.76,Main,,0,0,0,,Gelgelelim o ruletten ölümle art niyetten başka bir şey sezmedim.Dialogue: 0,0:22:07.34,0:22:09.14,Main,,0,0,0,,Rulet mi?Dialogue: 0,0:22:09.14,0:22:13.73,Main,,0,0,0,,İyi ki de kabul etmemişsin "Denizin İlk Oğulu" Jinbe.Dialogue: 0,0:22:14.27,0:22:22.07,Main,,0,0,0,,5 yıl önce ortağım da Big Mom'ın merhametini dileyerek ruleti çevirdi...Dialogue: 0,0:22:22.07,0:22:24.59,Main,,0,0,0,,...ve de canından oldu.Dialogue: 0,0:22:25.39,0:22:31.05,Main,,0,0,0,,O alet, çeviren kişiyi öldürmek için yapılmış bir illet.Dialogue: 0,0:22:31.05,0:22:33.20,Main,,0,0,0,,Hileli yani?!Dialogue: 0,0:22:35.41,0:22:40.42,Main,,0,0,0,,Elbette öyle beyinsizler! Mama kimseleri sağ bırakmaz ki!Dialogue: 0,0:22:40.42,0:22:43.17,Main,,0,0,0,,İster ufak tefek bir işgalci...Dialogue: 0,0:22:43.17,0:22:47.67,Main,,0,0,0,,...isterse bir zamanlar sadık bir müttefik korsan olsun!Dialogue: 0,0:22:47.67,0:22:53.34,Main,,0,0,0,,Safına gelenlere kucak açar, ayrılmak isteyenleri ise gebertir!Dialogue: 0,0:22:53.34,0:22:54.65,Main,,0,0,0,,İşte bu da...Dialogue: 0,0:22:54.65,0:22:56.06,Main,,0,0,0,,Zamanımız yok!Dialogue: 0,0:22:59.76,0:23:03.92,Main,,0,0,0,,Yola koyulalım! Brook, Luffy ve Sanji'yi bulmalıyız!Dialogue: 0,0:23:03.92,0:23:07.32,Main,,0,0,0,,Hiçbir yere gitmiyorum! Hepinizi nasıl çekeyim lan?!Dialogue: 0,0:23:07.94,0:23:13.20,Captions,,0,0,0,,Sanji'nin OdasıDialogue: 0,0:23:21.28,0:23:26.60,Main,,0,0,0,,Evet efendim, damat Sanji-sama odasında istirahat ediyor.Dialogue: 0,0:23:26.60,0:23:31.22,Main,,0,0,0,,Ne onun odadan çıkmasına ne de bir başkasının girmesine izin verin!Dialogue: 0,0:23:31.24,0:23:32.70,Main,,0,0,0,,Gözünüzü ondan ayırmayın!Dialogue: 0,0:23:32.70,0:23:33.79,Main,,0,0,0,,Baş üstüne!Dialogue: 0,0:23:39.39,0:23:44.02,Main,,0,0,0,,Olamaz! Uyuyakalmışım-nasu! Hem de Sanji-sama'nın yatağında!Dialogue: 0,0:23:44.02,0:23:47.28,Main,,0,0,0,,Hâlâ dönmemiş mi-nasu?Dialogue: 0,0:23:48.57,0:23:51.99,Main,,0,0,0,,Daha geleceği yok gibi-nasu.Dialogue: 0,0:23:51.99,0:23:55.45,Main,,0,0,0,,E biraz daha kestireyim bari-nasu.Dialogue: 0,0:23:55.66,0:24:01.83,Captions,,0,0,0,,Toplantı OdasıDialogue: 0,0:23:55.46,0:23:59.92,Main,,0,0,0,,Yani Çikolata Şehri'ne kadar Pekoms da onlarlaydı.Dialogue: 0,0:23:59.92,0:24:03.12,Main,,0,0,0,,Amaçları ise Sanji'yi geri almak.Dialogue: 0,0:24:03.14,0:24:06.34,Main,,0,0,0,,Pudding onları merkez adamıza çektiğinde altı kişilerdi.Dialogue: 0,0:24:08.30,0:24:12.38,Main,,0,0,0,,Ruh Kralı da şu an Mama'nın elinde.Dialogue: 0,0:24:12.38,0:24:13.71,Main,,0,0,0,,Dokunmayın!Dialogue: 0,0:24:13.71,0:24:17.82,Main,,0,0,0,,Pedro üçüncü kattaki avluda kendini patlattı, doğru mu?Dialogue: 0,0:24:17.82,0:24:19.64,Main,,0,0,0,,Evet, ü ürü üü.Dialogue: 0,0:24:20.04,0:24:21.65,Main,,0,0,0,,İkisi gitti.Dialogue: 0,0:24:21.65,0:24:26.68,Main,,0,0,0,,Ayartan Orman'a giren dörtlüden tavşan ile rakunu da...Dialogue: 0,0:24:26.68,0:24:31.44,Main,,0,0,0,,...Brûlée abla yakaladığını bu öğlen bildirmişti.Dialogue: 0,0:24:32.32,0:24:37.16,Main,,0,0,0,,Yani altı kişilik ekiplerinin dördünden kurtulduk. Asıl mesele...Dialogue: 0,0:24:39.41,0:24:44.98,Main,,0,0,0,,...Cracker abiyi alt edip Ayartan Orman'dan  çıkmayı başaran bu ikisi.Dialogue: 0,0:24:44.98,0:24:50.34,Main,,0,0,0,,Kendi ellerimizle yer altındaki zindan kütüphanesine kilitlemiştik.Dialogue: 0,0:24:52.34,0:24:56.01,Main,,0,0,0,,Peki neden kurtulduklarına dair bir söylenti dolanıyor?Dialogue: 0,0:25:05.75,0:25:09.40,Main,,0,0,0,,Zindan kütüphanesinde yalnızca birimiz vardı.Dialogue: 0,0:25:09.74,0:25:15.60,Main,,0,0,0,,Neler oldu Opera abi? Jinbe ortaya çıktı diyorlar.Dialogue: 0,0:25:15.60,0:25:19.10,Main,,0,0,0,,Hiçbirinin aslı astarı yok! Kaç kez söyleyeceğim-fa!Dialogue: 0,0:25:19.10,0:25:20.60,Main,,0,0,0,,Peki neredeymiş şu an?Dialogue: 0,0:25:20.60,0:25:25.16,Main,,0,0,0,,Kimse bilmiyor-fa! Bodrum kata ulaşan olmadı!Dialogue: 0,0:25:25.16,0:25:31.55,Main,,0,0,0,,Mama'yla sözleştiğimiz gibi Lola'nın yerini öğrenmek için onlara işkence ediyordum!Dialogue: 0,0:25:31.55,0:25:36.76,Main,,0,0,0,,Hiçbir halt bilmediklerinden cayır cayır yakıp geberttim onları!Dialogue: 0,0:25:36.76,0:25:39.55,Main,,0,0,0,,Biraz ileri gitmiş olabilirim ama...Dialogue: 0,0:25:41.60,0:25:46.78,Main,,0,0,0,,...y- yoksa abine güvenmiyor musun Mont d'Or?!Dialogue: 0,0:25:46.78,0:25:49.23,Main,,0,0,0,,Güveniyorum tabii.Dialogue: 0,0:25:52.40,0:25:56.56,Thoughts,,0,0,0,,Elimden kaçırdığımı söyleyemem! Hayatta olmaz!Dialogue: 0,0:25:56.56,0:25:59.87,Thoughts,,0,0,0,,Yoksa Mama tüm ömrümü söküp alır-fa!Dialogue: 0,0:26:02.79,0:26:05.32,Main,,0,0,0,,Sanji'yle Vinsmokelar'dan ne haber?Dialogue: 0,0:26:05.32,0:26:07.91,Main,,0,0,0,,Hepsi de odasında.Dialogue: 0,0:26:07.91,0:26:09.58,Main,,0,0,0,,Pekâlâ, asayiş berkemal.Dialogue: 0,0:26:10.59,0:26:13.52,Main,,0,0,0,,Tüm işgalciler yakalandı!Dialogue: 0,0:26:13.52,0:26:18.15,Main,,0,0,0,,Şu an dev mutfağımızda yarın için hazırlanıyorlar!Dialogue: 0,0:26:18.15,0:26:24.57,Main,,0,0,0,,Yarın biricik kardeşimiz Pudding için harika bir düğün tertipleyelim!Dialogue: 0,0:26:24.57,0:26:28.39,Main,,0,0,0,,Aynen!Dialogue: 0,0:26:38.49,0:26:41.31,Main,,0,0,0,,Sabaha kadar korumalarla devriye sayısını artırın.Dialogue: 0,0:26:41.31,0:26:42.20,Main,,0,0,0,,Emredersiniz!Dialogue: 0,0:26:43.41,0:26:45.83,Thoughts,,0,0,0,,Opera'ya güvenmiyorum.Dialogue: 0,0:26:46.75,0:26:49.92,Captions,,0,0,0,,Sağlık Merkezi, 3. KatDialogue: 0,0:26:52.96,0:26:57.34,Captions,,0,0,0,,Şeker ŞehriDialogue: 0,0:26:57.38,0:26:59.63,Captions,,0,0,0,,Şatonun İçiDialogue: 0,0:27:01.05,0:27:04.72,Main,,0,0,0,,Hayret bir şey... Bunu Pudding-chan'a mı hazırlamıştım yani?Dialogue: 0,0:27:05.58,0:27:08.10,Main,,0,0,0,,Aklımdan ne geçiyordu ki?Dialogue: 0,0:27:20.43,0:27:23.91,Main,,0,0,0,,Bizimkilerin favori yiyeceklerinden oluşuyor!Dialogue: 0,0:27:26.89,0:27:30.18,Thoughts,,0,0,0,,Çıkar aklından artık! Çıkar aklından!Dialogue: 0,0:27:39.44,0:27:45.12,Thoughts,,0,0,0,,Luffyler için endişelenmeme gerek yok. Kendi başlarına kurtulabilirler.Dialogue: 0,0:27:45.72,0:27:49.89,Thoughts,,0,0,0,,Şeytani ordu Vinsmokelar'ın tüm fertleri ölüp gidecek. Ben de dâhil.Dialogue: 0,0:27:49.89,0:27:52.31,Thoughts,,0,0,0,,Tıpkı Big Mom'ın planladığı gibi.Dialogue: 0,0:27:52.31,0:27:54.75,Thoughts,,0,0,0,,Herkes için en iyisi bu.Dialogue: 0,0:27:54.75,0:27:56.97,Thoughts,,0,0,0,,Böylece düşmanlarımızın da istediği olacak.Dialogue: 0,0:27:56.97,0:28:01.40,Thoughts,,0,0,0,,Biraz kısa sürse de tatmin edici bir hayat yaşadım.Dialogue: 0,0:28:02.16,0:28:04.68,Main,,0,0,0,,Ah, beleş yemek!Dialogue: 0,0:28:06.92,0:28:10.16,Main,,0,0,0,,Vinsmoke Sanji misin sen?Dialogue: 0,0:28:10.16,0:28:13.33,Main,,0,0,0,,Mont d'Or odanda uyuduğunu söylemişti oysa.Dialogue: 0,0:28:14.58,0:28:19.18,Flashbacks,,0,0,0,,Olur da dönmezsen, buracıkta...Dialogue: 0,0:28:19.18,0:28:21.80,Flashbacks,,0,0,0,,...açlıktan ölürüm!Dialogue: 0,0:28:22.58,0:28:24.55,Main,,0,0,0,,Çek lan ellerini!Dialogue: 0,0:28:25.39,0:28:27.35,Main,,0,0,0,,O et...Dialogue: 0,0:28:29.90,0:28:32.38,Main,,0,0,0,,...sana değil!Dialogue: 0,0:28:43.18,0:28:45.15,Main,,0,0,0,,Bu taraftan bi' gürültü geldi!Dialogue: 0,0:28:50.96,0:28:53.11,Main,,0,0,0,,Adi herif...Dialogue: 0,0:28:57.88,0:29:00.34,Main,,0,0,0,,Kaçmasana şerefsiz!Dialogue: 0,0:29:05.47,0:29:07.33,Thoughts,,0,0,0,,N'apıyorum ben ya?!Dialogue: 0,0:29:13.56,0:29:18.91,Credits,,0,0,0,,Editing:  Feeso, Galaxy 9000  Timing: Halee  Quality Assurance: Feeso, Galaxy 9000, Grug, Pepperjack  Soundtracking:  Halee  Infoboxes & Title:  Datenshi  Karaoke: KaitouYahiko  Attack Effects: KaitouYahiko  Translation: Crunchyroll