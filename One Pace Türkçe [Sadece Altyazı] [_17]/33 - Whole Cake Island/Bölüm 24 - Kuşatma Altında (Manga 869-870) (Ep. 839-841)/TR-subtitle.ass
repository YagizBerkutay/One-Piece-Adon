H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.7,0.7,9,10,10,10,1Style: Attack,Duality,30.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.0,1.0,7,12,12,12,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:01:34.31,0:01:37.34,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - dmc3 thx to onepace.netDialogue: 0,0:12:18.00,0:12:23.20,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - dmc3 thx to onepace.netDialogue: 0,0:28:39.50,0:28:42.50,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - dmc3 thx to onepace.netDialogue: 0,0:01:34.31,0:01:37.34,Title,,0,0,0,,Kuşatma AltındaDialogue: 0,0:01:37.34,0:01:41.25,Main,,0,0,0,,Müttefikler! Şimdilik kaleye sığının!Dialogue: 0,0:01:41.25,0:01:42.92,Main,,0,0,0,,Pekâlâ, elimizi çabuk tutalım!Dialogue: 0,0:01:42.92,0:01:44.65,Main,,0,0,0,,Evet, içine girmek istiyorum!Dialogue: 0,0:01:44.65,0:01:47.92,Main,,0,0,0,,Ateş Tankı Korsanları! Koruma ateşi!Dialogue: 0,0:01:47.92,0:01:49.25,Main,,0,0,0,,- Rero! - Baş üstüne!Dialogue: 0,0:01:51.36,0:01:52.69,Main,,0,0,0,,Kahretsin!Dialogue: 0,0:02:01.98,0:02:05.33,Thoughts,,0,0,0,,Bege! Kendi gözlerimle gördüm!Dialogue: 0,0:02:05.33,0:02:08.21,Thoughts,,0,0,0,,Mama'yı öldürmeye kalkıştığına inanamıyorum!Dialogue: 0,0:02:08.21,0:02:11.76,Thoughts,,0,0,0,,Başından beri amacı bu muymuş?Dialogue: 0,0:02:13.01,0:02:15.51,Main,,0,0,0,,Kalenin içine-rero!Dialogue: 0,0:02:15.51,0:02:18.62,Main,,0,0,0,,Rook: Cannon Preparation!Dialogue: 0,0:02:15.51,0:02:18.62,Attack,,0,0,0,,Kale: Topları hazırlaDialogue: 0,0:02:21.34,0:02:23.69,Main,,0,0,0,,Cannon Firing!Dialogue: 0,0:02:21.34,0:02:23.69,Attack,,0,0,0,,Top AteşiDialogue: 0,0:02:26.06,0:02:28.26,Main,,0,0,0,,Acayip havalı ya!Dialogue: 0,0:02:28.26,0:02:30.99,Main,,0,0,0,,Robot! Kaleden robot!Dialogue: 0,0:02:30.99,0:02:33.13,Thoughts,,0,0,0,,Heyecanlanmanın sırası mı yahu?Dialogue: 0,0:02:33.53,0:02:36.97,Thoughts,,0,0,0,,Ne kadar daha dayanabiliriz?Dialogue: 0,0:02:41.84,0:02:44.14,Thoughts,,0,0,0,,Kulak zarım patlayacak-nen!Dialogue: 0,0:02:48.93,0:02:50.05,Main,,0,0,0,,Mochi mi?Dialogue: 0,0:03:03.28,0:03:04.13,Thoughts,,0,0,0,,Bu...Dialogue: 0,0:03:04.13,0:03:06.70,Thoughts,,0,0,0,,Tamatebako!Dialogue: 0,0:03:09.97,0:03:11.13,Thoughts,,0,0,0,,Tamamdır!Dialogue: 0,0:03:11.13,0:03:13.77,Thoughts,,0,0,0,,B- Bu da nesi?Dialogue: 0,0:03:18.08,0:03:22.18,Thoughts,,0,0,0,,Kim lan Gastino-sama'ya bulaşan?Dialogue: 0,0:03:30.06,0:03:31.69,Main,,0,0,0,,Abi!Dialogue: 0,0:03:31.69,0:03:33.79,Thoughts,,0,0,0,,Öldüm!Dialogue: 0,0:03:38.33,0:03:42.47,Thoughts,,0,0,0,,Abi! Teşekkür ederim!Dialogue: 0,0:03:44.49,0:03:46.14,Thoughts,,0,0,0,,İş başına!Dialogue: 0,0:03:49.17,0:03:51.14,Main,,0,0,0,,Geçemezsiniz!Dialogue: 0,0:03:53.88,0:03:56.82,Main,,0,0,0,,Koruma ateşi açın-rero! Çabuk-rero!Dialogue: 0,0:04:05.25,0:04:06.46,Main,,0,0,0,,Nami!Dialogue: 0,0:04:06.99,0:04:09.86,Thoughts,,0,0,0,,Seni sıkarak öldüreceğim!Dialogue: 0,0:04:09.86,0:04:11.06,Thoughts,,0,0,0,,Nami-san!Dialogue: 0,0:04:11.06,0:04:12.36,Main,,0,0,0,,Nami!Dialogue: 0,0:04:13.83,0:04:16.77,Thoughts,,0,0,0,,Rakibin biziz!Dialogue: 0,0:04:22.57,0:04:24.51,Thoughts,,0,0,0,,Tüh.Dialogue: 0,0:04:25.18,0:04:28.45,Main,,0,0,0,,- Oy anam, yandım anam!Dialogue: 0,0:04:27.00,0:04:28.46,Thoughts,,0,0,0,,- Artık kaçamazsınız!Dialogue: 0,0:04:28.46,0:04:30.08,Main,,0,0,0,,Choniki!Dialogue: 0,0:04:33.09,0:04:35.12,Thoughts,,0,0,0,,Ciin!Dialogue: 0,0:05:19.23,0:05:23.07,Main,,0,0,0,,Vazife çağırıyor! Germa 66!Dialogue: 0,0:06:37.84,0:06:40.86,Main,,0,0,0,,Yere batasıcalar!Dialogue: 0,0:06:43.18,0:06:45.68,Main,,0,0,0,,Yanarak geberin!Dialogue: 0,0:06:54.19,0:06:56.26,Main,,0,0,0,,B- Bu...Dialogue: 0,0:07:14.38,0:07:16.62,Thoughts,,0,0,0,,Germa'nın ilmi teknolojisi.Dialogue: 0,0:07:16.62,0:07:21.72,Thoughts,,0,0,0,,Ateşe bile dayanıklı biçim bellekli zırhlar!Dialogue: 0,0:07:21.72,0:07:26.06,Thoughts,,0,0,0,,Bir kez daha şekerim ile yakalayacağım!Dialogue: 0,0:07:26.86,0:07:29.03,Main,,0,0,0,,Candy Wave!Dialogue: 0,0:07:26.86,0:07:29.03,Attack,,0,0,0,,Şeker DalgasıDialogue: 0,0:08:00.05,0:08:02.79,Main,,0,0,0,,Çirkin pireler!Dialogue: 0,0:08:17.86,0:08:22.01,Main,,0,0,0,,Yarmanın teki olsan da bir cacığın yokmuş.Dialogue: 0,0:09:05.49,0:09:06.73,Thoughts,,0,0,0,,Nami-san!Dialogue: 0,0:09:07.97,0:09:10.20,Thoughts,,0,0,0,,Herkes iyi mi?Dialogue: 0,0:09:10.20,0:09:11.36,Thoughts,,0,0,0,,Evet!Dialogue: 0,0:09:12.21,0:09:13.39,Thoughts,,0,0,0,,Sanji-kun!Dialogue: 0,0:09:13.39,0:09:15.77,Thoughts,,0,0,0,,Bir şeyinin olmamasına sevindim Nami-san!Dialogue: 0,0:09:18.38,0:09:20.44,Main,,0,0,0,,Gomu Gomu no...Dialogue: 0,0:09:21.20,0:09:23.28,Main,,0,0,0,,Jet Whip!Dialogue: 0,0:09:21.20,0:09:23.28,Attack,,0,0,0,,Jet KamçıDialogue: 0,0:09:23.28,0:09:24.60,Main,,0,0,0,,Luffy!Dialogue: 0,0:09:24.60,0:09:27.45,Thoughts,,0,0,0,,- Çabuk olun! - Buradayız!Dialogue: 0,0:09:28.68,0:09:31.72,Main,,0,0,0,,Biz de geri çekilmeliyiz-rero!Dialogue: 0,0:09:49.81,0:09:53.81,Thoughts,,0,0,0,,Aman da aman, efsanevi saklı hazine Tamatebako!Dialogue: 0,0:09:53.81,0:09:58.52,Thoughts,,0,0,0,,Burada beni bulamazlar artık! Karmaşa işime geldi-nen!Dialogue: 0,0:09:58.52,0:10:03.55,Thoughts,,0,0,0,,İçindekini başka bir şeyle değiştirmek için bu fırsatı kullanayım.Dialogue: 0,0:10:43.96,0:10:46.12,Thoughts,,0,0,0,,Son şansımız!Dialogue: 0,0:10:48.54,0:10:50.63,Main,,0,0,0,,Cannon Firing!Dialogue: 0,0:10:48.54,0:10:50.63,Attack,,0,0,0,,Top AteşiDialogue: 0,0:10:56.83,0:10:58.14,Thoughts,,0,0,0,,Sıçayım!Dialogue: 0,0:10:58.54,0:11:00.40,Main,,0,0,0,,Candy Wall!Dialogue: 0,0:10:58.54,0:11:00.40,Attack,,0,0,0,,Şeker DuvarıDialogue: 0,0:11:01.08,0:11:02.84,Thoughts,,0,0,0,,Perospero!Dialogue: 0,0:11:02.84,0:11:05.25,Thoughts,,0,0,0,,Canımı yaktınız ya...Dialogue: 0,0:11:05.25,0:11:08.31,Thoughts,,0,0,0,,Germa da yanınızda demek?Dialogue: 0,0:11:09.09,0:11:12.38,Thoughts,,0,0,0,,Son duanızı edin sıçanlar!Dialogue: 0,0:11:12.38,0:11:15.85,Thoughts,,0,0,0,,Şansın varken gül!Dialogue: 0,0:11:24.10,0:11:26.64,Main,,0,0,0,,Rook: Movement!Dialogue: 0,0:11:24.10,0:11:26.64,Attack,,0,0,0,,Kale: İleriDialogue: 0,0:11:44.05,0:11:48.05,Thoughts,,0,0,0,,Tüm cephaneyi arkadan üzerine boşaltacağım!Dialogue: 0,0:11:49.22,0:11:51.69,Main,,0,0,0,,Geber Big Mom!Dialogue: 0,0:11:52.70,0:11:53.43,Main,,0,0,0,,Cannon...Dialogue: 0,0:11:52.70,0:11:53.43,Attack,,0,0,0,,Top...Dialogue: 0,0:11:54.59,0:11:55.93,Main,,0,0,0,,Firing!Dialogue: 0,0:11:54.59,0:11:55.93,Attack,,0,0,0,,...AteşiDialogue: 0,0:11:58.68,0:12:00.37,Thoughts,,0,0,0,,Ne oldu?!Dialogue: 0,0:12:01.15,0:12:05.51,Main,,0,0,0,,Baba! Sol cephedeki toplar imha edildi!Dialogue: 0,0:12:05.51,0:12:09.07,Main,,0,0,0,,Kaledeki tüm toplar mochi ile tıkandığından...Dialogue: 0,0:12:09.07,0:12:11.58,Main,,0,0,0,,...ateşleyemiyoruz!Dialogue: 0,0:12:15.45,0:12:18.02,Thoughts,,0,0,0,,K- Katakuri!Dialogue: 0,0:12:18.25,0:12:22.49,Captions,,0,0,26,,Big Father'ın İçiDialogue: 0,0:12:22.49,0:12:26.02,Main,,0,0,0,,Kaledeki herkese bir duyurum var!Dialogue: 0,0:12:39.69,0:12:43.98,Main,,0,0,0,,Big Father'ın ayakları şekerle kaplandı.Dialogue: 0,0:12:45.41,0:12:48.78,Main,,0,0,0,,Yerimizden kıpırdayamayız!Dialogue: 0,0:12:50.41,0:12:55.44,Main,,0,0,0,,Etrafımız ise Yonkou Big Mom Korsanları tarafından sarılmıştır!Dialogue: 0,0:12:55.44,0:13:00.99,Main,,0,0,0,,Kuşatma altında kazanamayacağımız bir savaşa girmek zorunda bırakıldık!Dialogue: 0,0:13:02.08,0:13:04.22,Main,,0,0,0,,Olamaz...Dialogue: 0,0:13:20.91,0:13:23.78,Thoughts,,0,0,0,,Dışarı çıkan herkesi geberteceğiz.Dialogue: 0,0:13:25.98,0:13:28.78,Thoughts,,0,0,0,,Haydi çıkın artık!Dialogue: 0,0:13:30.11,0:13:33.19,Main,,0,0,0,,Senden bu denli istifade etmelerine nasıl izin verirsin?Dialogue: 0,0:13:33.19,0:13:35.86,Main,,0,0,0,,B- Ben de burada kurbanım abi!Dialogue: 0,0:13:35.86,0:13:39.10,Main,,0,0,0,,Hepsine gününü gösterin gitsin!Dialogue: 0,0:13:41.37,0:13:45.10,Thoughts,,0,0,0,,Zehir mi? O kadın başımıza iş açabilir.Dialogue: 0,0:14:02.39,0:14:03.76,Main,,0,0,0,,Geldin ha!Dialogue: 0,0:14:03.76,0:14:07.81,Main,,0,0,0,,Süpersin Bege! Kocaman bir kaleye dönüşüverdin!Dialogue: 0,0:14:07.81,0:14:09.79,Main,,0,0,0,,Kale Kale Meyvesi çok havalı ya!Dialogue: 0,0:14:09.79,0:14:13.67,Main,,0,0,0,,Hayranlığın sırası değil! Düştüğümüz duruma kafa yorun!Dialogue: 0,0:14:13.67,0:14:14.83,Main,,0,0,0,,İçine edeyim!Dialogue: 0,0:14:14.83,0:14:18.60,Main,,0,0,0,,Bir yıldır üzerinde çalıştığımız suikast planı...Dialogue: 0,0:14:18.60,0:14:20.54,Main,,0,0,0,,...başarısız oldu!Dialogue: 0,0:14:20.54,0:14:24.92,Main,,0,0,0,,İlk kez birini öldüremedik.Dialogue: 0,0:14:25.79,0:14:29.70,Main,,0,0,0,,En nihayetinde Yonkou çapımızı göstermiş oldu.Dialogue: 0,0:14:29.70,0:14:31.88,Main,,0,0,0,,Şimdi ne yapacağız?Dialogue: 0,0:14:31.88,0:14:36.62,Main,,0,0,0,,O kadar fazla vaktimiz yok. Nedenini izah edeyim.Dialogue: 0,0:14:36.62,0:14:39.96,Main,,0,0,0,,Herkes pür dikkat dinlesin!Dialogue: 0,0:14:39.96,0:14:43.60,Main,,0,0,0,,Bu kale benim kendi bedenim. Sağlam olabilir ama yıkılmaz da değil.Dialogue: 0,0:14:43.60,0:14:48.87,Main,,0,0,0,,Kaleyi yıkarlarsa ölürüm. Akabinde kale toz olur gider.Dialogue: 0,0:14:48.87,0:14:52.86,Main,,0,0,0,,Siz de kapı dışarı edilir edilmez canavarların avı olursunuz!Dialogue: 0,0:14:52.86,0:14:54.34,Main,,0,0,0,,Av mı?Dialogue: 0,0:15:08.35,0:15:11.26,Main,,0,0,0,,Onları affetmeyeceğim...Dialogue: 0,0:15:13.66,0:15:14.83,Main,,0,0,0,,Mama!Dialogue: 0,0:15:16.69,0:15:19.83,Main,,0,0,0,,Hiddetini hissedebiliyorum.Dialogue: 0,0:15:31.01,0:15:35.35,Main,,0,0,0,,İçeride kalırsanız öldünüz,  çıkarsanız da öldünüz.Dialogue: 0,0:15:35.35,0:15:37.68,Main,,0,0,0,,Ne kadar umutsuz durumda  olduğumuzu anlayın!Dialogue: 0,0:15:37.68,0:15:42.05,Main,,0,0,0,,İhaleyi bana yıkma Bege!  Dünyada o fırlatıcıların üzerine bir silah yok--Dialogue: 0,0:15:48.59,0:15:50.83,Main,,0,0,0,,- N- Ne oldu? - Baba!Dialogue: 0,0:15:50.83,0:15:52.58,Main,,0,0,0,,Hey, Bege! Sorun nedir?Dialogue: 0,0:15:52.58,0:15:54.63,Main,,0,0,0,,Hayatım, sen iyi misin?Dialogue: 0,0:15:58.14,0:15:59.54,Main,,0,0,0,,Yoksa...Dialogue: 0,0:16:00.57,0:16:01.94,Main,,0,0,0,,Dışarı bakın!Dialogue: 0,0:16:01.94,0:16:03.31,Main,,0,0,0,,Ne?Dialogue: 0,0:16:03.31,0:16:05.02,Main,,0,0,0,,Dışarı mı?Dialogue: 0,0:16:10.82,0:16:12.78,Main,,0,0,0,,Alçaklar!Dialogue: 0,0:16:12.78,0:16:14.95,Main,,0,0,0,,Çıkın dışarı!Dialogue: 0,0:16:16.95,0:16:19.03,Main,,0,0,0,,Bege!Dialogue: 0,0:16:19.03,0:16:21.06,Main,,0,0,0,,Hasır Şapka!Dialogue: 0,0:16:22.33,0:16:24.20,Main,,0,0,0,,Ödüm patlıyor!Dialogue: 0,0:16:24.20,0:16:26.62,Main,,0,0,0,,Bize bakıyor!Dialogue: 0,0:16:27.81,0:16:31.98,Main,,0,0,0,,Big Mom kendine gelmiş!Dialogue: 0,0:16:41.08,0:16:44.25,Main,,0,0,0,,Hepiniz de çıkın dışarı!Dialogue: 0,0:16:44.25,0:16:46.68,Main,,0,0,0,,Yüzünüzü göstersenize budalalar!Dialogue: 0,0:16:49.32,0:16:51.16,Main,,0,0,0,,Hayatım!Dialogue: 0,0:16:51.16,0:16:52.56,Main,,0,0,0,,Baba!Dialogue: 0,0:16:52.56,0:16:55.83,Main,,0,0,0,,Bana ihanet ettin demek?Dialogue: 0,0:16:55.83,0:16:57.54,Main,,0,0,0,,Bege!Dialogue: 0,0:16:59.75,0:17:03.09,Main,,0,0,0,,Hayatım! Dayan!Dialogue: 0,0:17:05.00,0:17:08.84,Main,,0,0,0,,Korkuyorum ya!Dialogue: 0,0:17:08.84,0:17:12.94,Main,,0,0,0,,Çık dışarı Bege!  Hasır Şapka!Dialogue: 0,0:17:16.35,0:17:17.33,Main,,0,0,0,,Bege!Dialogue: 0,0:17:17.93,0:17:19.89,Main,,0,0,0,,Pez sana emanet.Dialogue: 0,0:17:26.02,0:17:27.96,Main,,0,0,0,,Çıkın!Dialogue: 0,0:17:27.96,0:17:30.19,Main,,0,0,0,,Bekle!Dialogue: 0,0:17:30.19,0:17:34.20,Main,,0,0,0,,Benim! Bege benim kocam olur, çocuğumuz da var!Dialogue: 0,0:17:34.20,0:17:36.70,Main,,0,0,0,,Onu affet lütfen! Peşine düşme!Dialogue: 0,0:17:36.70,0:17:38.79,Main,,0,0,0,,Chiffon!Dialogue: 0,0:17:39.62,0:17:43.21,Main,,0,0,0,,Her zamanki gibi Lola'ya öyle çok benziyorsun ki!Dialogue: 0,0:17:44.28,0:17:45.28,Main,,0,0,0,,Saldırıyor!Dialogue: 0,0:17:45.28,0:17:46.28,Main,,0,0,0,,Dikkat et!Dialogue: 0,0:17:46.28,0:17:47.51,Main,,0,0,0,,Geri çekil Chiffon!Dialogue: 0,0:17:47.51,0:17:48.65,Main,,0,0,0,,Hanımım!Dialogue: 0,0:17:48.65,0:17:50.68,Main,,0,0,0,,Mama! Lütfen!Dialogue: 0,0:17:51.05,0:17:55.55,Main,,0,0,0,,Yüzünü bana gösterme demiştim!Dialogue: 0,0:18:02.44,0:18:04.22,Main,,0,0,0,,Son anda çektim.Dialogue: 0,0:18:04.22,0:18:05.43,Main,,0,0,0,,İyi misin?Dialogue: 0,0:18:05.43,0:18:07.17,Main,,0,0,0,,Hanımım!Dialogue: 0,0:18:07.17,0:18:11.17,Main,,0,0,0,,Beni öldürmek için onlarla plan mı yapıyordun Chiffon?Dialogue: 0,0:18:11.17,0:18:14.48,Main,,0,0,0,,Yarının tatlılarını yiyecek kadar ömrün olmayacak!Dialogue: 0,0:18:14.48,0:18:15.81,Main,,0,0,0,,Mama!Dialogue: 0,0:18:19.01,0:18:24.38,Main,,0,0,0,,Kale yıkılıp Bege öldüğünde hepsi kucağımıza düşecek.Dialogue: 0,0:18:24.38,0:18:26.37,Main,,0,0,0,,Hiçbirini elden kaçırmayın!Dialogue: 0,0:18:26.37,0:18:30.19,Main,,0,0,0,,Ateş Tankı Korsanları... Hasır Şapkalar...Dialogue: 0,0:18:30.19,0:18:33.43,Main,,0,0,0,,Ayrıca Jinbe! Germa 66!Dialogue: 0,0:18:33.43,0:18:37.66,Main,,0,0,0,,Düğünü de Çay Partisi'ni de mahvettiler!Dialogue: 0,0:18:37.66,0:18:40.55,Main,,0,0,0,,Bizi bu denli küçümsediklerine inanamıyorum.Dialogue: 0,0:18:40.55,0:18:43.74,Main,,0,0,0,,İbret olsun diye hepsini asalım!Dialogue: 0,0:18:43.74,0:18:46.10,Main,,0,0,0,,Çıkın dışarı!Dialogue: 0,0:18:47.91,0:18:49.65,Main,,0,0,0,,Bege!Dialogue: 0,0:18:50.11,0:18:51.78,Main,,0,0,0,,Hayatım!Dialogue: 0,0:18:55.16,0:18:56.65,Main,,0,0,0,,Sen iyi misin?Dialogue: 0,0:18:56.65,0:18:59.72,Main,,0,0,0,,Soktuğumun cadısı!Dialogue: 0,0:19:01.95,0:19:06.84,Main,,0,0,0,,Bir top güllesi bile Big Father'a tesir etmezken...Dialogue: 0,0:19:06.84,0:19:09.06,Main,,0,0,0,,...ona karşı tamamen savunmasızız!Dialogue: 0,0:19:09.06,0:19:12.30,Main,,0,0,0,,Dışarı çıkıp onu pataklamam gerekiyor!Dialogue: 0,0:19:12.30,0:19:13.50,Main,,0,0,0,,Yapamazsın Luffy!Dialogue: 0,0:19:13.50,0:19:14.71,Main,,0,0,0,,Chopper, durdur onu!Dialogue: 0,0:19:14.71,0:19:16.03,Main,,0,0,0,,Tamam!Dialogue: 0,0:19:19.68,0:19:22.74,Main,,0,0,0,,N'oluyor? Hey! Bırak beni!Dialogue: 0,0:19:22.74,0:19:24.89,Main,,0,0,0,,Hey, Chopper! Bıraksana!Dialogue: 0,0:19:24.89,0:19:28.10,Main,,0,0,0,,Luffy! Kendini kaybetme!Dialogue: 0,0:19:28.10,0:19:32.82,Main,,0,0,0,,Buraya Sanji-kun'u kurtarmaya geldik, değil mi?Dialogue: 0,0:19:32.82,0:19:35.60,Main,,0,0,0,,Ponegliflerin kopyalarını çıkartmanın yanı sıra...Dialogue: 0,0:19:35.60,0:19:39.09,Main,,0,0,0,,...Sanji-kun'un ailesini kurtarma arzusunu da yerine getirebildik!Dialogue: 0,0:19:39.09,0:19:42.56,Main,,0,0,0,,Hedeflerimize ulaştık!Dialogue: 0,0:19:42.56,0:19:47.10,Main,,0,0,0,,Savaşacak vaktin varsa kaçışımız için kafa yormaya bak!Dialogue: 0,0:19:47.10,0:19:52.00,Main,,0,0,0,,Niyetimiz savaşmak olsaydı Zoroları da getirirdik, değil mi?Dialogue: 0,0:19:52.00,0:19:54.97,Main,,0,0,0,,Luffy-san, Nami-san doğru söylüyor.Dialogue: 0,0:19:54.97,0:19:59.61,Main,,0,0,0,,Sayımız az olduğu için buraya kadar gelebildik.Dialogue: 0,0:19:59.61,0:20:03.85,Main,,0,0,0,,Zoro-san'ın bizi beklediği Wano Ülkesi'ne sağ salim gitmeye bakalım!Dialogue: 0,0:20:07.90,0:20:09.32,Main,,0,0,0,,Bege!Dialogue: 0,0:20:09.32,0:20:10.47,Main,,0,0,0,,Baba!Dialogue: 0,0:20:10.47,0:20:12.36,Main,,0,0,0,,Bege!Dialogue: 0,0:20:14.59,0:20:16.53,Main,,0,0,0,,Baksanıza! Bege...Dialogue: 0,0:20:17.24,0:20:19.43,Main,,0,0,0,,N'apacağız peki?Dialogue: 0,0:20:19.43,0:20:22.74,Main,,0,0,0,,Bege bizim yüzümüzden saldırıya uğruyor!Dialogue: 0,0:20:28.91,0:20:31.08,Main,,0,0,0,,Sıçayım...Dialogue: 0,0:20:31.08,0:20:34.91,Main,,0,0,0,,Hâlimiz yaman...Dialogue: 0,0:20:35.61,0:20:39.37,Main,,0,0,0,,Öylece oturup artistlik yapmanızı izleyecek değilim!Dialogue: 0,0:20:39.37,0:20:44.50,Main,,0,0,0,,Dur bi' saniye Bege-san! Bizi de kendinle birlikte yokuşa süremezsin!Dialogue: 0,0:20:44.50,0:20:46.70,Main,,0,0,0,,Ben de üzerime düşeni yaptım!Dialogue: 0,0:20:46.70,0:20:49.55,Main,,0,0,0,,Kalbimi geri ver hemen!Dialogue: 0,0:20:50.34,0:20:52.63,Main,,0,0,0,,Yokuşa sürmek ha...Dialogue: 0,0:20:52.63,0:20:55.10,Main,,0,0,0,,Fena fikir değil.Dialogue: 0,0:20:55.51,0:20:59.31,Main,,0,0,0,,Size ne olacağını hiç umursamadım zaten.Dialogue: 0,0:21:09.53,0:21:11.19,Main,,0,0,0,,Lakin...Dialogue: 0,0:21:11.19,0:21:15.78,Main,,0,0,0,,...yeri doldurulamaz adamlarımla...Dialogue: 0,0:21:15.78,0:21:19.12,Main,,0,0,0,,...bir tanecik eşimle çocuğum da burada.Dialogue: 0,0:21:21.10,0:21:25.03,Main,,0,0,0,,Ölmelerine izin veremem.Dialogue: 0,0:21:25.03,0:21:26.46,Main,,0,0,0,,Hayatım!Dialogue: 0,0:21:26.46,0:21:28.93,Main,,0,0,0,,Baba!Dialogue: 0,0:21:33.20,0:21:34.06,Main,,0,0,0,,Bege!Dialogue: 0,0:21:38.40,0:21:41.71,Main,,0,0,0,,Herkesin hayatta kalacağı...Dialogue: 0,0:21:43.95,0:21:46.61,Main,,0,0,0,,...tek çıkar yol var.Dialogue: 0,0:21:46.61,0:21:47.74,Main,,0,0,0,,Tek yol mu?Dialogue: 0,0:21:47.74,0:21:49.39,Main,,0,0,0,,Neymiş?Dialogue: 0,0:21:53.14,0:21:55.89,Main,,0,0,0,,Dışarı çıkın!Dialogue: 0,0:21:55.89,0:21:58.69,Main,,0,0,0,,Kalenizi tuzla buz edeceğim!Dialogue: 0,0:22:00.67,0:22:03.07,Main,,0,0,0,,Kale uzun süre dayanmayacak.Dialogue: 0,0:22:03.07,0:22:06.11,Main,,0,0,0,,Her an saldırıya geçmeye hazır ol.Dialogue: 0,0:22:07.07,0:22:09.51,Main,,0,0,0,,Bu yumruğumla onları ezip geçeceğim!Dialogue: 0,0:22:09.51,0:22:11.74,Main,,0,0,0,,Her birini...Dialogue: 0,0:22:12.06,0:22:13.91,Main,,0,0,0,,...infaz edelim!Dialogue: 0,0:22:16.61,0:22:21.42,Main,,0,0,0,,Haydi çıkın artık!  Hepinizi ayna diyarında tutacağım!Dialogue: 0,0:22:24.86,0:22:28.53,Main,,0,0,0,,Hayatta kalma yolu... Çare...Dialogue: 0,0:22:28.53,0:22:35.23,Main,,0,0,0,,Big Father'ın içindeki bu oda aslen vücudumun içidir.Dialogue: 0,0:22:36.79,0:22:37.34,Main,,0,0,0,,Hey!Dialogue: 0,0:22:37.34,0:22:39.60,Main,,0,0,0,,Panikleme!Dialogue: 0,0:22:41.64,0:22:44.64,Main,,0,0,0,,Saldırılar ne kadar şiddetli olursa olsun...Dialogue: 0,0:22:45.26,0:22:49.47,Main,,0,0,0,,Big Father eğilse de devrilse de...Dialogue: 0,0:22:50.02,0:22:53.82,Main,,0,0,0,,...yalnızca ben zarar görürüm.Dialogue: 0,0:22:53.82,0:22:58.23,Main,,0,0,0,,İçeride kaldığınız sürece etkilenmeyeceksiniz!Dialogue: 0,0:22:58.23,0:23:02.95,Main,,0,0,0,,- Doğru ya... - Tüm cefayı Bege-san çekiyor.Dialogue: 0,0:23:04.60,0:23:07.53,Main,,0,0,0,,Big Mom'ın sesini duyabiliyoruz.Dialogue: 0,0:23:09.50,0:23:12.27,Main,,0,0,0,,Ama içeride hiçbir hareket olmuyor.Dialogue: 0,0:23:15.42,0:23:17.49,Main,,0,0,0,,Aynen öyle.Dialogue: 0,0:23:17.49,0:23:22.71,Main,,0,0,0,,İnsan silüetine dönsem de öyle kalacak.Dialogue: 0,0:23:22.71,0:23:27.57,Main,,0,0,0,,İyi dinleyin... Sizi içimde tutarken insan silüetime döneceğim.Dialogue: 0,0:23:27.57,0:23:32.16,Main,,0,0,0,,Akabinde Caesar da beni taşıyıp uçarak kaçacağız.Dialogue: 0,0:23:32.16,0:23:36.26,Main,,0,0,0,,Bir pürüz çıkmazsa beladan kurtulmuş oluruz.Dialogue: 0,0:23:37.76,0:23:41.80,Main,,0,0,0,,Dur bakalım! Fikrimi bile almadan canımı nasıl tehlikeye atarsın dallama!Dialogue: 0,0:23:41.80,0:23:44.04,Main,,0,0,0,,Kendi mezarımızı kazıyoruz lan!Dialogue: 0,0:23:44.04,0:23:49.60,Main,,0,0,0,,Anında delik deşik ediliriz! Başarma şansımız hiç yok!Dialogue: 0,0:23:49.60,0:23:51.74,Main,,0,0,0,,Bir sürü Silahlanma Hakisi kullanıcısı da var!Dialogue: 0,0:23:51.74,0:23:54.61,Main,,0,0,0,,Gaza dönüşsem de kaçamam!Dialogue: 0,0:23:54.61,0:23:56.98,Main,,0,0,0,,Bir sorum olacak.Dialogue: 0,0:23:58.45,0:23:59.69,Main,,0,0,0,,Sanji...Dialogue: 0,0:24:02.23,0:24:04.78,Main,,0,0,0,,Neden bizi kurtardın?Dialogue: 0,0:24:06.44,0:24:11.43,Main,,0,0,0,,Tiksindiğin düşmanların oluyoruz. Sazan gibi de oltaya geldik.Dialogue: 0,0:24:14.93,0:24:18.81,Main,,0,0,0,,Babam üzülürdü de ondan.Dialogue: 0,0:24:19.97,0:24:24.04,Main,,0,0,0,,Geçmişteki kırgınlığımı sürdürseydim...Dialogue: 0,0:24:26.86,0:24:28.55,Flashbacks,,0,0,0,,Çıkarın beni lütfen!Dialogue: 0,0:24:28.55,0:24:31.38,Flashbacks,,0,0,0,,Baba! Özür dilerim!Dialogue: 0,0:24:32.42,0:24:36.49,Flashbacks,,0,0,0,,Zayıf olarak doğduğum için özür dilerim!Dialogue: 0,0:24:36.49,0:24:42.79,Flashbacks,,0,0,0,,Yardım et baba!Dialogue: 0,0:24:45.76,0:24:49.08,Main,,0,0,0,,Kan bağın olan ailenin ölümüne gülecek kadar dar kafalı bir sıçan...Dialogue: 0,0:24:49.08,0:24:53.57,Main,,0,0,0,,...olduğum için hayal kırıklığına uğrardı.Dialogue: 0,0:24:53.57,0:24:58.14,Flashbacks,,0,0,0,,Üşütme sakın.Dialogue: 0,0:24:58.14,0:25:01.76,Main,,0,0,0,,Onun yüzüne bakamayacağım bir hayattansa...Dialogue: 0,0:25:01.76,0:25:03.82,Main,,0,0,0,,...ölmeyi yeğlerim!Dialogue: 0,0:25:08.38,0:25:12.39,Flashbacks,,0,0,0,,Diğer insanların yanında...Dialogue: 0,0:25:12.39,0:25:17.02,Flashbacks,,0,0,0,,...baban olduğumu söyleme sakın!Dialogue: 0,0:25:20.90,0:25:25.11,Flashbacks,,0,0,0,,Bu utancı kimsenin öğrenmesini istemiyorum!Dialogue: 0,0:25:25.57,0:25:27.77,Flashbacks,,0,0,0,,Anlıyorsun, değil mi?Dialogue: 0,0:25:31.21,0:25:33.11,Main,,0,0,0,,13 yıl önce...Dialogue: 0,0:25:33.11,0:25:38.55,Main,,0,0,0,,...Germa'dan kaçan Vinsmoke Sanji denizde bir kez öldü.Dialogue: 0,0:25:38.55,0:25:41.29,Main,,0,0,0,,Tam da istediğin gibi.Dialogue: 0,0:25:52.93,0:25:55.23,Main,,0,0,0,,Bu yüzden kabul et!Dialogue: 0,0:25:55.97,0:26:00.60,Main,,0,0,0,,Babam değilsin Vinsmoke Judge!Dialogue: 0,0:26:01.37,0:26:04.40,Main,,0,0,0,,Bir daha da karşımıza çıkayım deme!Dialogue: 0,0:26:28.40,0:26:30.67,Main,,0,0,0,,Öyle olsun.Dialogue: 0,0:26:30.67,0:26:33.01,Main,,0,0,0,,Sözüm söz.Dialogue: 0,0:26:33.01,0:26:35.27,Main,,0,0,0,,Ne sana...Dialogue: 0,0:26:35.27,0:26:38.34,Main,,0,0,0,,...ne de Doğu Mavi'ye yaklaşacağız.Dialogue: 0,0:26:45.35,0:26:47.92,Main,,0,0,0,,Görevimi yerine getirdim!Dialogue: 0,0:26:47.92,0:26:50.49,Main,,0,0,0,,Yeni buyruklar anlaşmamıza dâhil değil!Dialogue: 0,0:26:50.49,0:26:55.02,Main,,0,0,0,,Bir şey yapmazsak sen de ölürsün Caesar!Dialogue: 0,0:26:56.83,0:26:58.90,Main,,0,0,0,,Kapıları açın!Dialogue: 0,0:27:00.36,0:27:05.02,Main,,0,0,0,,Gang Bege! Seninle Caesar Clown semaya karışana kadar...Dialogue: 0,0:27:05.02,0:27:08.02,Main,,0,0,0,,...Germa olarak size eşlik edeceğiz!Dialogue: 0,0:27:08.02,0:27:09.57,Main,,0,0,0,,D- Dur bakalım!Dialogue: 0,0:27:09.57,0:27:12.30,Main,,0,0,0,,N'apacağıma sen niye karar veriyorsun?Dialogue: 0,0:27:12.30,0:27:15.88,Main,,0,0,0,,Hâlâ üst perdeden konuşuyorsun Judge!Dialogue: 0,0:27:18.35,0:27:22.05,Main,,0,0,0,,Sahi... Germa da uçabiliyordu...Dialogue: 0,0:27:22.05,0:27:23.95,Main,,0,0,0,,O zaman sizi geride bırakacağız, uygun mudur?Dialogue: 0,0:27:23.95,0:27:25.42,Main,,0,0,0,,Dert değil.Dialogue: 0,0:27:27.86,0:27:30.86,Main,,0,0,0,,Tamamdır, zaman kazanmak gerekiyorsa ben de...Dialogue: 0,0:27:31.43,0:27:34.39,Main,,0,0,0,,- Lüzum yok Luffy. - Ama...Dialogue: 0,0:27:56.59,0:28:00.46,Main,,0,0,0,,Bu fiyaskoya borçlu kalmak istemiyorum!Dialogue: 0,0:28:02.75,0:28:05.92,Main,,0,0,0,,Onların kafası böyle çalışır.Dialogue: 0,0:28:07.26,0:28:09.30,Main,,0,0,0,,Durun biraz! Hop hop!Dialogue: 0,0:28:09.30,0:28:12.30,Main,,0,0,0,,Yapacağım demedim ki lan andavallar!Dialogue: 0,0:28:12.70,0:28:14.34,Main,,0,0,0,,Caesar!Dialogue: 0,0:28:14.34,0:28:16.31,Main,,0,0,0,,Kes sesini de işe koyul!Dialogue: 0,0:28:16.31,0:28:18.88,Main,,0,0,0,,Oy anam!Dialogue: 0,0:28:18.88,0:28:20.95,Main,,0,0,0,,Bunu ödeyeceksiniz!Dialogue: 0,0:28:24.42,0:28:27.65,Main,,0,0,0,,Çıkın artık!Dialogue: 0,0:28:27.65,0:28:29.19,Main,,0,0,0,,Bege!Dialogue: 0,0:28:38.21,0:28:41.41,Main,,0,0,0,,Germa! Saldırın!Dialogue: 0,0:28:39.50,0:28:41.43,Credits,,0,0,0,,Editing:  Feeso, Galaxy 9000  Timing: Halee  Quality Assurance: Feeso, Galaxy 9000, Grug, Pepperjack  Soundtracking:  Halee  Graphics:  Datenshi  Karaoke: KaitouYahiko  Translation: Crunchyroll