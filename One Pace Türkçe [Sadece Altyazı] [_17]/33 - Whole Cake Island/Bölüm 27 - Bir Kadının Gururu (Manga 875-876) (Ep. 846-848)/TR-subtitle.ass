Dialogue: 0,0:01:34.31,0:01:36.65,Title,,0,0,0,,{\fad(325,0}Bir Kadının Gururu{\pos(643,487)}
Dialogue: 0,0:01:37.72,0:01:40.67,Main,,0,0,0,,Denize çıkmayı başardık.
Dialogue: 0,0:01:44.73,0:01:48.87,Main,,0,0,0,,{\an8}Bi' de Sunny-go'ya vardık mı tamamdır.
Dialogue: 0,0:01:44.73,0:01:48.87,Captions,,0,1000,265,,{\fad(325,0}Meyve Suyu Nehri, Tatlı Şehir
Dialogue: 0,0:01:51.26,0:01:55.09,Main,,0,0,0,,Tadı çok güzel ya!\NMutluluktan havalara uçacağım!
Dialogue: 0,0:01:55.09,0:01:58.26,Main,,0,0,0,,Hadi ya? Ben bu işi beğenmedim ama.\NHer yer yapış yapış olmuş.
Dialogue: 0,0:01:59.22,0:02:01.83,Main,,0,0,0,,Baksana! Dümen de kayganlaşmış.
Dialogue: 0,0:02:01.83,0:02:06.19,Main,,0,0,0,,Aman! Çekilin cici balıklar!
Dialogue: 0,0:02:09.27,0:02:12.27,Main,,0,0,0,,Brook! Şu bir denizkızı değil mi?
Dialogue: 0,0:02:12.27,0:02:14.79,Main,,0,0,0,,Ne? Denizkızı mı?
Dialogue: 0,0:02:14.79,0:02:16.88,Main,,0,0,0,,Deniz adamı diyecektim.
Dialogue: 0,0:02:16.88,0:02:18.11,Main,,0,0,0,,Demek öyle.
Dialogue: 0,0:02:20.49,0:02:23.58,Main,,0,0,0,,N'apıyor acaba?\N Avlanıyordur belki de?
Dialogue: 0,0:02:24.39,0:02:27.62,Main,,0,0,0,,Bize ne canım.
Dialogue: 0,0:02:34.40,0:02:37.44,Captions,,0,0,0,,{\pos(626,476)}Güneybatı Sahili\NAyartan Orman{\fad(500,0)}
Dialogue: 0,0:02:37.44,0:02:42.12,Main,,0,0,0,,Big Mom Açlık Krizi geçirirken\Nkaçmaktan başka bir şey yapamayız!
Dialogue: 0,0:02:42.12,0:02:44.87,Main,,0,0,0,,Açlık Krizi mi? O da nesiymiş?
Dialogue: 0,0:02:45.40,0:02:47.48,Main,,0,0,0,,Öfke nöbeti!
Dialogue: 0,0:02:50.89,0:02:53.46,Main,,0,0,0,,Canının çektiği yemeği yiyene değin...
Dialogue: 0,0:02:55.76,0:02:58.32,Main,,0,0,0,,...önüne çıkan her şeyi\Nayırt etmeksizin yakıp yıkar!
Dialogue: 0,0:02:59.39,0:03:02.17,Main,,0,0,0,,Düğün...
Dialogue: 0,0:03:02.17,0:03:06.05,Main,,0,0,0,,...pastası!!
Dialogue: 0,0:03:07.90,0:03:10.52,Main,,0,0,0,,Bilinci neredeyse kapalıdır.
Dialogue: 0,0:03:11.77,0:03:15.78,Main,,0,0,0,,Bu seferki nöbette\Ncanı düğün pastası çekmiş galiba!
Dialogue: 0,0:03:20.88,0:03:26.00,Main,,0,0,0,,Düğünde pastayı tatma fırsatı\Nbulamadığından olabilir.
Dialogue: 0,0:03:26.00,0:03:28.92,Main,,0,0,0,,Luffy! Pastayı parçalamamalıydın!
Dialogue: 0,0:03:32.68,0:03:35.01,Main,,0,0,0,,Plan tuttu mu tuttu!
Dialogue: 0,0:03:35.01,0:03:38.26,Main,,0,0,0,,Hem öyle leziz bir pasta\Nher gün karşıma çıkmazdı!
Dialogue: 0,0:03:43.72,0:03:45.64,Main,,0,0,0,,Görev sırasında zıkkımlanıyor muydun yani?
Dialogue: 0,0:03:49.87,0:03:53.77,Main,,0,0,0,,Ben de ucundan aldım! Enfesti!
Dialogue: 0,0:03:53.77,0:03:58.20,Main,,0,0,0,,Koşmaya bakalım! \NSunny-go'nun çok uzakta olmadığına eminim!
Dialogue: 0,0:04:00.32,0:04:04.49,Main,,0,0,0,,İyi de bu ormandayken düz bir istikamette\Nkoşup koşmadığını bilemiyoruz ki.
Dialogue: 0,0:04:20.68,0:04:24.18,Main,,0,0,0,,Sahiden de doğru yolda mıyız acaba?
Dialogue: 0,0:04:24.18,0:04:26.10,Main,,0,0,0,,Bakın!
Dialogue: 0,0:04:27.44,0:04:30.02,Main,,0,0,0,,Bu nehir tanıdık geldi!
Dialogue: 0,0:04:31.60,0:04:34.82,Main,,0,0,0,,Nehri geçince Sunny-go'ya varmış oluruz!
Dialogue: 0,0:04:35.73,0:04:37.15,Main,,0,0,0,,Durun biraz!
Dialogue: 0,0:04:42.70,0:04:45.87,Main,,0,0,0,,Hafızam beni yanıltmıyorsa köprü yıkılmıştı!
Dialogue: 0,0:04:45.87,0:04:47.17,Main,,0,0,0,,Haklısın...
Dialogue: 0,0:04:47.17,0:04:50.79,Main,,0,0,0,,Orman hasmımız iken hiçbir şeye güvenemeyiz!
Dialogue: 0,0:04:50.79,0:04:55.29,Main,,0,0,0,,Bizi kafalamaya çalışıyorlar en nihayetinde.
Dialogue: 0,0:04:57.02,0:05:02.18,Main,,0,0,0,,Kafamızı karıştırmak için peyzajı da\Ndeğiştirdiklerine adım gibi eminim.
Dialogue: 0,0:05:02.18,0:05:04.01,Main,,0,0,0,,Başka bir deyişle...
Dialogue: 0,0:05:04.01,0:05:07.31,Main,,0,0,0,,...olduğunu sandığımız yerde değiliz!
Dialogue: 0,0:05:08.19,0:05:11.51,Main,,0,0,0,,Lola'nın Vivre Kartı da yardımcı olmuyor artık.
Dialogue: 0,0:05:11.51,0:05:14.77,Main,,0,0,0,,Olmaz zaten, \NMama'nın şahsı hemen arkamızda zira!
Dialogue: 0,0:05:14.77,0:05:18.28,Main,,0,0,0,,Tam da bu yüzden Zeus'u\Nbeslemeyi sakın ihmal etme Nami.
Dialogue: 0,0:05:18.28,0:05:20.48,Main,,0,0,0,,Evet. Zeus!
Dialogue: 0,0:05:28.11,0:05:29.61,Main,,0,0,0,,Çok...
Dialogue: 0,0:05:29.61,0:05:32.04,Main,,0,0,0,,...lezzetli! Enfes!
Dialogue: 0,0:05:32.04,0:05:37.37,Main,,0,0,0,,Zeus, Mama'ya dönerse \Nkadın bizi anında yakalar.
Dialogue: 0,0:05:40.27,0:05:45.74,Main,,0,0,0,,Bana dön Zeus!
Dialogue: 0,0:05:50.24,0:05:53.04,Main,,0,0,0,,Fazla uyuşuk davranırsak bize yetişir!
Dialogue: 0,0:05:53.04,0:05:56.09,Main,,0,0,0,,Olamaz! Fırça yiyeceğim!
Dialogue: 0,0:05:56.09,0:05:57.46,Main,,0,0,0,,Hey!
Dialogue: 0,0:05:57.46,0:05:58.68,Main,,0,0,0,,Prometheus!
Dialogue: 0,0:05:58.68,0:06:03.35,Main,,0,0,0,,Neden Mama'nın emirlerine\Nitaat etmedin Zeus?
Dialogue: 0,0:06:03.35,0:06:05.84,Main,,0,0,0,,Zeus'cuğum! Buraya bak güzelim!
Dialogue: 0,0:06:07.01,0:06:13.06,Main,,0,0,0,,Sulu mu sulu fırtına bulutlarıyla dolu\Nenfes bir hava yumurtası!
Dialogue: 0,0:06:13.06,0:06:14.85,Main,,0,0,0,,Oha!\NEnfes duruyor!
Dialogue: 0,0:06:14.85,0:06:17.94,Main,,0,0,0,,Kime diyorum! Bekle Zeus!
Dialogue: 0,0:06:21.11,0:06:22.69,Main,,0,0,0,,Bana bak lan Güneş!
Dialogue: 0,0:06:25.03,0:06:26.53,Main,,0,0,0,,Ne cüretle...
Dialogue: 0,0:06:28.29,0:06:30.45,Main,,0,0,0,,...ağaç herifi yakıp kül edersin!
Dialogue: 0,0:06:31.45,0:06:33.10,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:06:33.10,0:06:36.38,Main,,0,0,0,,{\fad(150,150)}Hawk Gatling!
Dialogue: 0,0:06:33.10,0:06:36.38,Attack,,0,0,0,,{\fad(150,150)}...Şahin Mitralyözü
Dialogue: 0,0:06:39.24,0:06:40.97,Main,,0,0,0,,Luffy'ye de bu yakışırdı!
Dialogue: 0,0:06:52.44,0:06:53.86,Main,,0,0,0,,Nasıl olur?
Dialogue: 0,0:06:53.86,0:06:55.78,Main,,0,0,0,,Böyle bir saldırıyla...
Dialogue: 0,0:06:57.26,0:07:00.78,Main,,0,0,0,,...beni yenebileceğini aklından bile geçirme!
Dialogue: 0,0:07:00.79,0:07:02.66,Main,,0,0,0,,Yandım anam!
Dialogue: 0,0:07:02.66,0:07:06.71,Main,,0,0,0,,Silahlanma Hakisi işlemiyorsa\Nbaşımızı Logia'dan da fazla ağrıtacak!
Dialogue: 0,0:07:06.71,0:07:09.25,Main,,0,0,0,,Hepinizi de yakıp kül edeceğim!
Dialogue: 0,0:07:09.25,0:07:12.38,Main,,0,0,0,,Yandım lan! Yandım!
Dialogue: 0,0:07:18.35,0:07:19.74,Main,,0,0,0,,Geri dön Zeus!
Dialogue: 0,0:07:19.74,0:07:23.17,Main,,0,0,0,,Döneceğim!\NDöneceğim dönmesine de...
Dialogue: 0,0:07:24.39,0:07:27.16,Main,,0,0,0,,Bir tanecik daha sulu\Nfırtına bulutu yemek istiyorum!
Dialogue: 0,0:07:27.16,0:07:28.27,Main,,0,0,0,,Seni var ya...
Dialogue: 0,0:07:31.48,0:07:32.47,Main,,0,0,0,,Jinbe!
Dialogue: 0,0:07:32.47,0:07:35.67,Main,,0,0,0,,Köprüyü geçin millet!
Dialogue: 0,0:07:35.67,0:07:36.49,Main,,0,0,0,,Tamam!
Dialogue: 0,0:07:37.50,0:07:38.91,Main,,0,0,0,,{\fad(150,150)}Yari Nami!
Dialogue: 0,0:07:37.50,0:07:38.91,Attack,,0,0,0,,{\fad(150,150)}Mızrak Dalgası
Dialogue: 0,0:07:39.16,0:07:40.36,Main,,0,0,0,,{\fad(150,150)}Murasame!
Dialogue: 0,0:07:39.16,0:07:40.36,Attack,,0,0,0,,{\fad(150,150)}Yağmur Bombardımanı
Dialogue: 0,0:07:42.83,0:07:44.05,Main,,0,0,0,,İşe yaradı mı?
Dialogue: 0,0:07:44.05,0:07:45.33,Main,,0,0,0,,Herhâlde!
Dialogue: 0,0:07:45.33,0:07:48.36,Main,,0,0,0,,Sıkıştırılmış bir alev yığınından ibaret!
Dialogue: 0,0:07:48.36,0:07:50.96,Main,,0,0,0,,Kibirli bir alev de geç!
Dialogue: 0,0:07:53.09,0:07:55.09,Main,,0,0,0,,Yere batasıcalar...
Dialogue: 0,0:07:59.77,0:08:01.18,Main,,0,0,0,,Onlar...
Dialogue: 0,0:08:01.18,0:08:02.97,Captions,,0,0,0,,{\pos(945,718)}Mobile{\fad(400,250)}
Dialogue: 0,0:08:02.72,0:08:04.47,Captions,,0,0,0,,{\pos(338,718)}Kato{\fad(400,250)}
Dialogue: 0,0:08:04.22,0:08:06.73,Captions,,0,0,0,,{\pos(960,718)}Compo{\fad(400,250)}
Dialogue: 0,0:08:03.96,0:08:06.48,Main,,0,0,0,,Son duanızı edin Hasır Şapkalar!{\an8}
Dialogue: 0,0:08:06.48,0:08:08.48,Captions,,0,0,0,,{\pos(343,717)}Laurin{\fad(400,250)}
Dialogue: 0,0:08:06.48,0:08:08.23,Main,,0,0,0,,Ayartan Orman...{\an8}
Dialogue: 0,0:08:08.23,0:08:10.73,Captions,,0,0,0,,{\pos(970,718)}Tablet{\fad(400,250)}
Dialogue: 0,0:08:08.23,0:08:10.48,Main,,0,0,0,,...mezarınız olacak!{\an8}
Dialogue: 0,0:08:10.48,0:08:12.19,Captions,,0,0,0,,{\pos(335,718)}High-Fat{\fad(400,0)}
Dialogue: 0,0:08:10.48,0:08:12.19,Main,,0,0,0,,Geberin!{\an8}
Dialogue: 0,0:08:12.19,0:08:14.40,Main,,0,0,0,,Ne? Önümüze geçtiklerine inanamıyorum!
Dialogue: 0,0:08:14.40,0:08:17.45,Main,,0,0,0,,Homies peyzajı değiştirmiş olmalı!
Dialogue: 0,0:08:29.74,0:08:31.28,Main,,0,0,0,,Etrafımız sarıldı.
Dialogue: 0,0:08:31.28,0:08:34.18,Main,,0,0,0,,Öyleyse yapacak tek bir şey var!
Dialogue: 0,0:08:34.18,0:08:37.47,Main,,0,0,0,,Evet, günlerini gösterelim gitsin!
Dialogue: 0,0:08:51.29,0:08:55.58,Main,,0,0,0,,Sen Pedro'ydun, değil mi?\NBeş yıl evvel de görmüştüm seni.
Dialogue: 0,0:09:03.51,0:09:05.34,Main,,0,0,0,,Hoppa!
Dialogue: 0,0:09:17.86,0:09:19.73,Main,,0,0,0,,Aptal tavşan!
Dialogue: 0,0:09:22.83,0:09:25.46,Main,,0,0,0,,Garchu!
Dialogue: 0,0:09:26.42,0:09:28.78,Main,,0,0,0,,Dur!
Dialogue: 0,0:09:32.79,0:09:34.62,Main,,0,0,0,,İşte bu!
Dialogue: 0,0:09:34.62,0:09:36.33,Main,,0,0,0,,Tablet abi!
Dialogue: 0,0:09:36.33,0:09:38.56,Main,,0,0,0,,Önüne baksan iyi edersin!
Dialogue: 0,0:09:44.88,0:09:46.34,Main,,0,0,0,,{\fad(150,150)}Diable Jambe:
Dialogue: 0,0:09:44.88,0:09:46.34,Attack,,0,0,0,,{\fad(150,150)}Şeytan Bacak:
Dialogue: 0,0:09:52.47,0:09:55.27,Main,,0,0,0,,{\fad(150,150)}Flambage Shot!
Dialogue: 0,0:09:52.47,0:09:55.27,Attack,,0,0,0,,{\fad(150,150)}Alevli Vuruş
Dialogue: 0,0:10:05.70,0:10:07.86,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:10:13.42,0:10:15.79,Main,,0,0,0,,{\fad(150,150)}Eagle Bazooka!
Dialogue: 0,0:10:13.42,0:10:15.79,Attack,,0,0,0,,{\fad(150,150)}Kartal Bazukası
Dialogue: 0,0:10:24.46,0:10:25.89,Main,,0,0,0,,Ayrı düşmeyin sakın!
Dialogue: 0,0:10:25.89,0:10:28.14,Main,,0,0,0,,Bir daha birbirimizi bulamayız yoksa!
Dialogue: 0,0:10:28.14,0:10:28.89,Main,,0,0,0,,Tamam!
Dialogue: 0,0:10:30.52,0:10:31.00,Main,,0,0,0,,Anlaşıldı!
Dialogue: 0,0:10:31.00,0:10:31.67,Main,,0,0,0,,Peki!
Dialogue: 0,0:10:31.67,0:10:33.73,Main,,0,0,0,,Luffy, Carrot'u al!
Dialogue: 0,0:10:33.73,0:10:34.61,Main,,0,0,0,,Tamamdır!
Dialogue: 0,0:10:45.54,0:10:48.16,Main,,0,0,0,,Kaçamazsınız!
Dialogue: 0,0:10:49.33,0:10:50.58,Main,,0,0,0,,Eğilin!
Dialogue: 0,0:11:05.06,0:11:07.07,Main,,0,0,0,,Alın bakalım!
Dialogue: 0,0:11:07.07,0:11:08.49,Main,,0,0,0,,Dikkat edin!
Dialogue: 0,0:11:11.11,0:11:12.47,Main,,0,0,0,,Aşağılık şey...
Dialogue: 0,0:11:24.05,0:11:26.89,Main,,0,0,0,,Pasta!
Dialogue: 0,0:11:29.22,0:11:30.88,Main,,0,0,0,,Yolun sonuna mı geldik?
Dialogue: 0,0:11:30.88,0:11:32.64,Main,,0,0,0,,Eline sağlık!
Dialogue: 0,0:11:32.64,0:11:33.72,Main,,0,0,0,,Zeus!
Dialogue: 0,0:11:33.72,0:11:36.27,Main,,0,0,0,,Leziz mi leziz bir bulut!
Dialogue: 0,0:11:39.11,0:11:40.12,Main,,0,0,0,,Ne?
Dialogue: 0,0:11:40.12,0:11:41.66,Main,,0,0,0,,Yoksa...
Dialogue: 0,0:11:41.66,0:11:43.54,Main,,0,0,0,,N'oluyor?
Dialogue: 0,0:11:45.37,0:11:48.71,Main,,0,0,0,,Enfes ya!
Dialogue: 0,0:11:54.64,0:11:58.18,Main,,0,0,0,,Zeus'un bedenindeki hava yumurtalarım...
Dialogue: 0,0:11:58.18,0:12:02.01,Main,,0,0,0,,Ne yapıyor bu herif?
Dialogue: 0,0:12:02.01,0:12:03.93,Main,,0,0,0,,Bana bak Zeus!
Dialogue: 0,0:12:10.13,0:12:12.41,Main,,0,0,0,,Çocuklar!
Dialogue: 0,0:12:12.41,0:12:15.98,Main,,0,0,0,,Beklettiğimiz için kusura bakmayın!
Dialogue: 0,0:12:30.01,0:12:31.72,Main,,0,0,0,,Onların...
Dialogue: 0,0:12:31.72,0:12:34.72,Main,,0,0,0,,Sunny-go'muzda ne işleri var?
Dialogue: 0,0:12:34.72,0:12:40.43,Main,,0,0,0,,Üzülerek söylüyorum ki\Narkadaşlarınız burada değil-perorin.
Dialogue: 0,0:12:49.07,0:12:51.15,Main,,0,0,0,,{\fad(150,150)}Zeus Breeze...
Dialogue: 0,0:12:49.07,0:12:51.15,Attack,,0,0,0,,{\fad(150,150)}Zeus Meltem...
Dialogue: 0,0:12:54.87,0:12:56.19,Main,,0,0,0,,{\fad(150,150)}Tempo!
Dialogue: 0,0:12:54.87,0:12:56.19,Attack,,0,0,0,,{\fad(150,150)}...Temposu!
Dialogue: 0,0:13:25.88,0:13:28.91,Main,,0,0,0,,Yoksa Luffyler...
Dialogue: 0,0:13:32.33,0:13:34.08,Main,,0,0,0,,Bu gördüğümüz...
Dialogue: 0,0:13:34.08,0:13:40.29,Main,,0,0,0,,Mama, Zeus'u kullanarak işlerini bitirdi galiba. \NÇok geçmeden buraya varır.
Dialogue: 0,0:13:41.68,0:13:45.53,Main,,0,0,0,,Bu herifin dediklerine rağmen\Nbizimkiler sağ salim gelecektir, değil mi?
Dialogue: 0,0:13:45.53,0:13:47.90,Main,,0,0,0,,Evet, hiç şüphem yok!
Dialogue: 0,0:13:49.73,0:13:53.62,Main,,0,0,0,,Arkadaşlarınız çoktan nalları dikmiştir.
Dialogue: 0,0:13:53.62,0:13:57.04,Main,,0,0,0,,E siz n'apacaksınız peki?
Dialogue: 0,0:13:57.04,0:14:02.76,Main,,0,0,0,,Hayatlarınız pahasına gemiyi geri\Nalsanız dahi gelen giden olmayacak.
Dialogue: 0,0:14:05.82,0:14:12.52,Main,,0,0,0,,Yalnızca iki kişi olmanız kaydıyla denizaltına\Natlayıp tüymek isterseniz göz yumabilirim.
Dialogue: 0,0:14:19.74,0:14:21.46,Main,,0,0,0,,Ay canım ne düşüncelisin sen.
Dialogue: 0,0:14:25.34,0:14:27.37,Main,,0,0,0,,{\fad(150,150)}Kung Fu Point!
Dialogue: 0,0:14:25.34,0:14:27.37,Attack,,0,0,0,,{\fad(150,150)}Kung Fu Noktası
Dialogue: 0,0:14:28.92,0:14:32.30,Main,,0,0,0,,İnin lan güverteden!\NSunny-go'muzda duruyorsunuz!
Dialogue: 0,0:14:35.32,0:14:37.10,Main,,0,0,0,,Kapışmak mı istiyorsunuz?
Dialogue: 0,0:14:37.10,0:14:38.84,Main,,0,0,0,,Tabii ki!
Dialogue: 0,0:14:41.30,0:14:43.76,Main,,0,0,0,,Sunny-go'yu elinizden alacağız!
Dialogue: 0,0:14:43.76,0:14:47.60,Main,,0,0,0,,Ecelinize susamışsınız galiba-perorin.
Dialogue: 0,0:14:59.59,0:15:03.24,Main,,0,0,0,,Zerre mola vermeyeceğimiz\Ngösterimizi başlatalım!
Dialogue: 0,0:15:03.24,0:15:04.66,Main,,0,0,0,,Aynen!
Dialogue: 0,0:15:07.96,0:15:10.64,Main,,0,0,0,,Orman...\NNeler olmuş öyle?
Dialogue: 0,0:15:10.64,0:15:12.29,Main,,0,0,0,,Bizimkiler güvende mi acaba?
Dialogue: 0,0:15:12.29,0:15:14.09,Main,,0,0,0,,Rabiyan, hızlan!
Dialogue: 0,0:15:14.09,0:15:15.64,Main,,0,0,0,,Peki!
Dialogue: 0,0:15:19.38,0:15:22.68,Main,,0,0,0,,Böyle bir istekte bulunduğum için\Nözür dilerim abla.
Dialogue: 0,0:15:22.68,0:15:27.43,Main,,0,0,0,,Lafı olmaz! En son birlikte pasta\Nyaptığımızdan bu yana epey olmuştu!
Dialogue: 0,0:15:29.23,0:15:30.75,Main,,0,0,0,,Ayrıca...
Dialogue: 0,0:15:35.11,0:15:37.46,Main,,0,0,0,,Gidiyor musun?\NKafa mı buluyorsun?
Dialogue: 0,0:15:37.46,0:15:43.66,Main,,0,0,0,,Bege! Söylemedim mi sana? \NHasır Şapkalar kardeşim Lola'nın hayatını kurtarmış!
Dialogue: 0,0:15:43.66,0:15:47.00,Main,,0,0,0,,Tamam da Chiffon, çok tehlikeli!\NKaygılandım!
Dialogue: 0,0:15:47.00,0:15:50.48,Main,,0,0,0,,Evet-{\i1}rero{\i0}!\NBizimle birlikte kaçmalısın-{\i1}rero{\i0}!
Dialogue: 0,0:15:50.48,0:15:52.54,Main,,0,0,0,,Pardon kuzucum.\NÇok bağırdım.
Dialogue: 0,0:15:52.54,0:15:55.42,Main,,0,0,0,,Siz olmadan gidemeyiz hanımım.
Dialogue: 0,0:15:55.42,0:15:56.92,Main,,0,0,0,,Kaleye dön Chiffon!
Dialogue: 0,0:15:56.92,0:16:00.59,Main,,0,0,0,,Tehlikeli mi? Pekâlâ farkındayım!
Dialogue: 0,0:16:03.43,0:16:08.67,Main,,0,0,0,,"Lola'yı kurtardığınız için minnettarım."\Ndemek kolay tabii!
Dialogue: 0,0:16:08.67,0:16:13.69,Main,,0,0,0,,Lakin samimiyetin, minnet\Nborcun olan kişiler tehlikedeyken belli olur!
Dialogue: 0,0:16:14.32,0:16:16.57,Main,,0,0,0,,Doğru diyorsun da...
Dialogue: 0,0:16:16.57,0:16:22.28,Main,,0,0,0,,Onurunla yaşamak dedikleri\Nböyle oluyor, değil mi hayatım?
Dialogue: 0,0:16:24.25,0:16:26.33,Main,,0,0,0,,Başıma bi' iş gelirse...
Dialogue: 0,0:16:29.33,0:16:31.56,Main,,0,0,0,,...Pez...
Dialogue: 0,0:16:31.56,0:16:32.79,Main,,0,0,0,,...size emanet!
Dialogue: 0,0:16:39.21,0:16:41.17,Main,,0,0,0,,Chiffon!
Dialogue: 0,0:16:41.76,0:16:44.43,Main,,0,0,0,,Hanımım!
Dialogue: 0,0:16:50.52,0:16:55.15,Main,,0,0,0,,Namiler'i kurtarıp\Nailemin yanına dönmeliyim!
Dialogue: 0,0:16:55.15,0:16:57.38,Main,,0,0,0,,Abla! Gördüm onu!
Dialogue: 0,0:16:58.57,0:17:01.49,Main,,0,0,0,,Pudding, beni dinliyor muydun?
Dialogue: 0,0:17:01.49,0:17:03.95,Main,,0,0,0,,S... Sanji-{\i1}san{\i} o...
Dialogue: 0,0:17:06.12,0:17:07.73,Main,,0,0,0,,S... S...
Dialogue: 0,0:17:08.08,0:17:09.70,Main,,0,0,0,,Sanji...
Dialogue: 0,0:17:14.42,0:17:16.11,Main,,0,0,0,,S...
Dialogue: 0,0:17:16.11,0:17:17.42,Main,,0,0,0,,S...
Dialogue: 0,0:17:17.80,0:17:19.34,Main,,0,0,0,,S...
Dialogue: 0,0:17:19.97,0:17:22.09,Main,,0,0,0,,Sanji salağını gördüm!
Dialogue: 0,0:17:22.09,0:17:23.69,Main,,0,0,0,,Ne?
Dialogue: 0,0:17:28.83,0:17:30.71,Main,,0,0,0,,Acayip güçlü bi' saldırıydı.
Dialogue: 0,0:17:30.71,0:17:34.34,Main,,0,0,0,,İklim Aygıtı bu denli kuvvetli\Nbir yıldırım üretemez!
Dialogue: 0,0:17:34.34,0:17:36.20,Main,,0,0,0,,Böylesi bir güce maruz kalınca...
Dialogue: 0,0:17:39.78,0:17:41.40,Main,,0,0,0,,Big Mom nerede?
Dialogue: 0,0:17:41.40,0:17:42.80,Main,,0,0,0,,Doğrudan saldırının hedefi oldu!
Dialogue: 0,0:17:42.80,0:17:45.71,Main,,0,0,0,,Şu devasa yarıktadır.
Dialogue: 0,0:17:45.71,0:17:49.22,Main,,0,0,0,,Yoksa Big Mom'ı hakladık mı?
Dialogue: 0,0:17:58.87,0:17:59.69,Main,,0,0,0,,Bu da ne?
Dialogue: 0,0:18:07.89,0:18:10.59,Main,,0,0,0,,Düğün...
Dialogue: 0,0:18:10.59,0:18:12.13,Main,,0,0,0,,Big Mom'ın sesi!
Dialogue: 0,0:18:12.13,0:18:14.18,Main,,0,0,0,,Düşündüğüm gibi.
Dialogue: 0,0:18:14.18,0:18:16.57,Main,,0,0,0,,...pastası!
Dialogue: 0,0:18:16.57,0:18:18.50,Main,,0,0,0,,Yaşıyor muymuş?
Dialogue: 0,0:18:21.32,0:18:25.35,Main,,0,0,0,,O kadar kolay havlu atacak biri değil.
Dialogue: 0,0:18:27.56,0:18:28.86,Main,,0,0,0,,Tırmanıyor!
Dialogue: 0,0:18:34.28,0:18:37.16,Main,,0,0,0,,İyi de yarık tırmanamayacağı kadar\Nderin değil mi?
Dialogue: 0,0:18:37.16,0:18:39.25,Main,,0,0,0,,Fırsattan istifade kaçalım biz de!
Dialogue: 0,0:18:39.25,0:18:42.62,Main,,0,0,0,,Aynen, Big Mom olduğu yerde dururken!
Dialogue: 0,0:18:45.43,0:18:48.50,Main,,0,0,0,,Hayır, ilerlemeye başladı bile!
Dialogue: 0,0:18:50.75,0:18:51.60,Main,,0,0,0,,Yeryüzü...
Dialogue: 0,0:18:51.60,0:18:52.80,Main,,0,0,0,,Yok ebesinin nikahı!
Dialogue: 0,0:19:02.62,0:19:07.31,Main,,0,0,0,,Açlık Krizi baş göstermişken\NBig Mom'ı hiçbir şey durduramaz.
Dialogue: 0,0:19:07.31,0:19:10.60,Main,,0,0,0,,Düğün...
Dialogue: 0,0:19:10.60,0:19:13.57,Main,,0,0,0,,...pastası!
Dialogue: 0,0:19:14.19,0:19:16.07,Main,,0,0,0,,Olamaz! Kaçın!
Dialogue: 0,0:19:16.71,0:19:21.08,Main,,0,0,0,,Düğün...
Dialogue: 0,0:19:21.08,0:19:23.70,Main,,0,0,0,,Yok artık! Yeryüzü yarılacak!
Dialogue: 0,0:19:25.89,0:19:27.08,Main,,0,0,0,,Çıkıyor!
Dialogue: 0,0:19:31.88,0:19:34.01,Main,,0,0,0,,Kaçın!
Dialogue: 0,0:19:35.40,0:19:38.18,Main,,0,0,0,,P- Pastayı...
Dialogue: 0,0:19:38.70,0:19:42.18,Main,,0,0,0,,...getirin!
Dialogue: 0,0:19:45.24,0:19:48.33,Main,,0,0,0,,Pastanın sizde olduğunu biliyorum!
Dialogue: 0,0:19:49.95,0:19:53.58,Main,,0,0,0,,Hasır Şapka!
Dialogue: 0,0:19:54.83,0:19:56.34,Main,,0,0,0,,Dışarı çıkıyor!
Dialogue: 0,0:19:59.42,0:20:00.98,Main,,0,0,0,,Hasır Şapkalar!
Dialogue: 0,0:20:00.98,0:20:01.60,Main,,0,0,0,,Ne?
Dialogue: 0,0:20:01.60,0:20:03.01,Main,,0,0,0,,Pudding! Chiffon!
Dialogue: 0,0:20:03.01,0:20:06.97,Main,,0,0,0,,Lan Pudding! Sorunlu musun kızım sen?\NBizi oyuna getirdin!
Dialogue: 0,0:20:06.97,0:20:09.31,Main,,0,0,0,,Mama'nın Açlık Krizini geçirmek için...
Dialogue: 0,0:20:09.31,0:20:12.98,Main,,0,0,0,,Bakın işte! \Nİlk karşılaştığımızda onu bağlamalıydık!
Dialogue: 0,0:20:12.98,0:20:14.60,Main,,0,0,0,,Mama'nın Açlık Krizini...
Dialogue: 0,0:20:14.60,0:20:18.86,Main,,0,0,0,,İyi de Chiffon onun yanında ne arıyor ki?\NBegeler'le birlikte kaçtığını sanıyordum!
Dialogue: 0,0:20:18.86,0:20:19.70,Main,,0,0,0,,Mama'nın Açlık...
Dialogue: 0,0:20:19.70,0:20:20.44,Main,,0,0,0,,Kapışmak mı istiyorsun?
Dialogue: 0,0:20:20.44,0:20:23.15,Main,,0,0,0,,Hayır ulan! İki dakika dinlesenize!
Dialogue: 0,0:20:23.15,0:20:25.62,Main,,0,0,0,,Pudding-{\i1}chan{\i0}, bir şeyin yokmuş.
Dialogue: 0,0:20:26.49,0:20:30.33,Main,,0,0,0,,Güzel vücuduna bi' zarar\Ngelmemesine çok sevindim!
Dialogue: 0,0:20:30.33,0:20:32.68,Main,,0,0,0,,Harika! Harika!
Dialogue: 0,0:20:32.68,0:20:33.67,Main,,0,0,0,,Pudding, kendine gel!
Dialogue: 0,0:20:38.80,0:20:40.59,Main,,0,0,0,,Olamaz! Mama geliyor!
Dialogue: 0,0:20:40.59,0:20:41.80,Main,,0,0,0,,Mama!
Dialogue: 0,0:20:41.80,0:20:45.10,Main,,0,0,0,,Vakit yok!\NPudding, direkt mevzuya gel!
Dialogue: 0,0:20:45.10,0:20:46.14,Main,,0,0,0,,Tamam!
Dialogue: 0,0:20:46.75,0:20:50.86,Main,,0,0,0,,Paçozsunuz işte!\NSağ kurtulmayacaksınız dallamalar!
Dialogue: 0,0:20:51.94,0:20:53.80,Main,,0,0,0,,Gemiciğinize varsanız bile...
Dialogue: 0,0:20:53.80,0:20:59.43,Main,,0,0,0,,...Mama en ücra denizlere kadar peşinizden\Ngelip sizi denizin dibine yollayacak!
Dialogue: 0,0:21:00.87,0:21:02.70,Main,,0,0,0,,Ne diyorsun lan sen, pislik!
Dialogue: 0,0:21:03.95,0:21:07.43,Main,,0,0,0,,Bunları söylemeyecektin Pudding!\NAğzından çıkanları kulağın duyuyor mu?
Dialogue: 0,0:21:07.43,0:21:10.96,Main,,0,0,0,,Sahi ya! Neler diyorum ben?
Dialogue: 0,0:21:10.96,0:21:12.20,Main,,0,0,0,,Bana kulak verin.
Dialogue: 0,0:21:12.20,0:21:18.57,Main,,0,0,0,,Mama deli gibi yemek istediği düğün pastasını\Nsizin çaldığınızı düşünüyor!
Dialogue: 0,0:21:18.57,0:21:22.06,Main,,0,0,0,,Ne? Bizde pasta masta yok ki!
Dialogue: 0,0:21:22.06,0:21:29.06,Main,,0,0,0,,Biliyorum! Fakat pastayı alana kadar okyanusun başından sonuna değin yakanızdan düşmez!
Dialogue: 0,0:21:29.06,0:21:32.60,Main,,0,0,0,,Aynen öyle!\NBu yüzden yanıma gel Sanji!
Dialogue: 0,0:21:32.60,0:21:38.66,Main,,0,0,0,,Arkadaşlarının Mama'nın elinde \Ncan verişini izleyip kahrol!
Dialogue: 0,0:21:43.66,0:21:45.16,Main,,0,0,0,,Niyetimiz o değil ki!
Dialogue: 0,0:21:45.16,0:21:49.21,Main,,0,0,0,,– Ağzından çıkanları kulağın duymuyor mu?\N– Sahi be! Yerin dibine girsem keşke!
Dialogue: 0,0:21:49.21,0:21:52.59,Main,,0,0,0,,Bunları demeye geldiyseniz\Ntoz olun pislikler!
Dialogue: 0,0:21:52.59,0:21:54.84,Main,,0,0,0,,Durun biraz! Yanlış anladınız!
Dialogue: 0,0:21:54.84,0:21:56.44,Main,,0,0,0,,Karabacak Sanji!
Dialogue: 0,0:21:56.44,0:21:57.36,Main,,0,0,0,,Evet?
Dialogue: 0,0:21:57.36,0:22:01.09,Main,,0,0,0,,Pudding'den iyi tatlı yapabildiğini de işittim!
Dialogue: 0,0:22:01.09,0:22:04.51,Main,,0,0,0,,Doğrudur, her türlü pişirme işi\Nbenden sorulur!
Dialogue: 0,0:22:04.96,0:22:08.38,Main,,0,0,0,,Tamamdır!\NÖyleyse pasta pişirmemize yardım et!
Dialogue: 0,0:22:08.38,0:22:11.80,Main,,0,0,0,,Mama'yı durdurabilecek yegâne şey olan\Npastayı pişireceğiz!
Dialogue: 0,0:22:11.80,0:22:14.23,Main,,0,0,0,,Böylece de kaçmanıza\Nyardım etmiş olacağız!
Dialogue: 0,0:22:14.23,0:22:16.15,Main,,0,0,0,,Chiffon! Neden?
Dialogue: 0,0:22:16.15,0:22:21.57,Main,,0,0,0,,Lola için yaptıklarınızı karşılıksız bırakmak istemiyorum! \NBu uğurda da hayatımı ortaya koyacağım!
Dialogue: 0,0:22:21.57,0:22:23.62,Main,,0,0,0,,Teşekkürler Chiffon!
Dialogue: 0,0:22:23.62,0:22:24.45,Main,,0,0,0,,Ne demek!
Dialogue: 0,0:22:24.45,0:22:30.54,Main,,0,0,0,,Ay götüm! Böyle bi' karar alınsa da ablamın\Naksine bunu sizin hatrınıza yapmıyorum!
Dialogue: 0,0:22:30.54,0:22:35.48,Main,,0,0,0,,Kendime pasta yapacaktım, \Ntesadüf ya Mama'nın canı da ondan çekmiş!
Dialogue: 0,0:22:35.48,0:22:40.09,Main,,0,0,0,,B- Buralardan geçerken de şans eseri\Nsizi gördüm! Burada olduğunuzu bilmiyordum!
Dialogue: 0,0:22:41.51,0:22:49.52,Main,,0,0,0,,Y- Yani onca yolu sen ölmeyesin diye\NMama'yı durdurmak için tepmedim lan Sanji...
Dialogue: 0,0:22:50.18,0:22:51.64,Main,,0,0,0,,...{\i1}-san{\i}!
Dialogue: 0,0:22:55.75,0:22:58.44,Thoughts,,0,0,0,,{\i1}Sağı solu belli değil ya!
Dialogue: 0,0:22:58.44,0:23:00.80,Main,,0,0,0,,Anladım! Sağ olun!
Dialogue: 0,0:23:00.80,0:23:02.70,Main,,0,0,0,,Pastayı nerede pişirebiliriz?
Dialogue: 0,0:23:02.70,0:23:05.88,Main,,0,0,0,,Çikolata Şehri'nde malzemelerin\Nbir yedeği duruyor!
Dialogue: 0,0:23:05.88,0:23:12.32,Main,,0,0,0,,Doğruca Çikolata Şehri'ne gidip olabildiğince\Nçabuk bir şekilde pastayı pişireceğiz!{\an8}
Dialogue: 0,0:23:12.32,0:23:16.52,Main,,0,0,0,,Akabinde pastayı gemiyle\Nsize teslim edeceğiz!{\an8}
Dialogue: 0,0:23:16.52,0:23:20.40,Main,,0,0,0,,Peşinizdeki Mama'ya da pastayı yedireceğiz.
Dialogue: 0,0:23:21.94,0:23:26.61,Main,,0,0,0,,Böylece gözü sizi görmeyecek!\NO vakte değin dişinizi sıkın!
Dialogue: 0,0:23:27.32,0:23:28.41,Main,,0,0,0,,Çıkıyor mu?
Dialogue: 0,0:23:28.89,0:23:31.62,Main,,0,0,0,,Düğün...
Dialogue: 0,0:23:31.62,0:23:35.10,Main,,0,0,0,,Yelken açınca karşınıza da düşmanlar çıkacak!
Dialogue: 0,0:23:35.10,0:23:38.29,Main,,0,0,0,,Ancak bununla başa çıkabileceğinize inanıyorum!
Dialogue: 0,0:23:38.29,0:23:39.25,Main,,0,0,0,,Ayıpsın!
Dialogue: 0,0:23:39.25,0:23:41.06,Main,,0,0,0,,Öyleyse sizinle geliyorum!
Dialogue: 0,0:23:41.06,0:23:41.60,Main,,0,0,0,,Ne?!
Dialogue: 0,0:23:41.60,0:23:43.30,Main,,0,0,0,,Evet, atla hemen!
Dialogue: 0,0:23:43.30,0:23:47.98,Main,,0,0,0,,D- D- Dur bakalım!\NBinebileceğini kim söyledi ki aptal!
Dialogue: 0,0:23:47.98,0:23:50.91,Main,,0,0,0,,Pasta!
Dialogue: 0,0:23:58.34,0:23:59.76,Main,,0,0,0,,Yüzeye çıktı!
Dialogue: 0,0:24:02.14,0:24:07.56,Main,,0,0,0,,Big Mom'ı durdurmak için yegâne umudumuz\Npişireceğiniz pastadır!
Dialogue: 0,0:24:07.56,0:24:09.15,Main,,0,0,0,,Evet!
Dialogue: 0,0:24:09.15,0:24:10.63,Main,,0,0,0,,Millet!
Dialogue: 0,0:24:10.63,0:24:14.24,Main,,0,0,0,,Şimdilik sizden ayrılıyorum ama\Ndöneceğime söz veririm!
Dialogue: 0,0:24:14.24,0:24:15.28,Main,,0,0,0,,Peki!
Dialogue: 0,0:24:15.99,0:24:17.69,Main,,0,0,0,,Tamam!
Dialogue: 0,0:24:21.08,0:24:23.49,Main,,0,0,0,,Tamam, hiç şüphem yok!
Dialogue: 0,0:24:31.06,0:24:32.45,Main,,0,0,0,,Bana bakın!
Dialogue: 0,0:24:32.45,0:24:33.66,Main,,0,0,0,,Pudding!
Dialogue: 0,0:24:33.66,0:24:35.05,Main,,0,0,0,,Chiffon!
Dialogue: 0,0:24:38.43,0:24:40.85,Main,,0,0,0,,Olamaz! Yine o saldırı!
Dialogue: 0,0:24:43.81,0:24:44.93,Main,,0,0,0,,Savuşturun!
Dialogue: 0,0:24:47.02,0:24:51.61,Main,,0,0,0,,Orada ne işiniz var sizin?
Dialogue: 0,0:24:51.61,0:24:54.11,Main,,0,0,0,,Luffy! Denizde görüşürüz!
Dialogue: 0,0:24:54.11,0:24:56.07,Main,,0,0,0,,Sana güveniyoruz Sanji!
Dialogue: 0,0:25:00.48,0:25:01.41,Main,,0,0,0,,{\fad(150,150)}Ikoku!
Dialogue: 0,0:25:00.48,0:25:01.41,Attack,,0,0,0,,{\fad(150,150)}Şanlı Ulus
Dialogue: 0,0:25:44.34,0:25:47.50,Main,,0,0,0,,Yeter ama ya...
Dialogue: 0,0:25:47.50,0:25:49.38,Main,,0,0,0,,Kıl payıyla kurtulduk.
Dialogue: 0,0:25:49.38,0:25:51.10,Main,,0,0,0,,Kimsenin bir şeyi yok, değil mi?
Dialogue: 0,0:25:51.10,0:25:54.44,Main,,0,0,0,,Yola koyulalım!\NSunny koyda bizi bekliyor!
Dialogue: 0,0:25:56.31,0:25:59.08,Main,,0,0,0,,Dur! Güzergâhtan saptılar.
Dialogue: 0,0:25:59.82,0:26:05.48,Main,,0,0,0,,Rabiyan, tekrar aşağı in! \NDeminki noktadan doğruca deniz kıyısına uçacaksın!
Dialogue: 0,0:26:05.48,0:26:06.83,Main,,0,0,0,,Baş üstüne!
Dialogue: 0,0:26:07.87,0:26:10.04,Main,,0,0,0,,Luffy-{\i1}kun{\i0}lar!
Dialogue: 0,0:26:10.04,0:26:13.71,Main,,0,0,0,,Durun! Yanlış yoldasınız!\NÖnünüzde koca bir duvar yatıyor!
Dialogue: 0,0:26:13.71,0:26:16.67,Main,,0,0,0,,Ne? Pudding mi?\Nİyi niyetli Pudding!
Dialogue: 0,0:26:16.67,0:26:19.37,Main,,0,0,0,,Dosdoğru ilerlediğimizi sanmıştım.
Dialogue: 0,0:26:19.37,0:26:21.55,Main,,0,0,0,,Kandırılmışız işte!
Dialogue: 0,0:26:21.55,0:26:23.79,Main,,0,0,0,,Çocuklar! Kıyı şu tarafta!
Dialogue: 0,0:26:23.79,0:26:25.60,Main,,0,0,0,,Tamamdır, gidelim!
Dialogue: 0,0:26:26.59,0:26:28.23,Main,,0,0,0,,Geçemezsiniz!
Dialogue: 0,0:26:30.56,0:26:32.40,Main,,0,0,0,,Ben hallederim!
Dialogue: 0,0:26:33.84,0:26:35.23,Main,,0,0,0,,{\fad(150,150)}Memories Fil:
Dialogue: 0,0:26:33.84,0:26:35.23,Attack,,0,0,0,,{\fad(150,150)}Hafıza İplikleri:
Dialogue: 0,0:26:43.45,0:26:45.28,Main,,0,0,0,,{\fad(150,150)}Flashback!
Dialogue: 0,0:26:43.45,0:26:45.28,Attack,,0,0,0,,{\fad(150,150)}Mazi
Dialogue: 0,0:26:48.78,0:26:51.75,Main,,0,0,0,,Sahi, market alışverişine gitmem lazım.
Dialogue: 0,0:26:53.12,0:26:55.78,Main,,0,0,0,,Abim bana vurdu ya!
Dialogue: 0,0:26:55.78,0:26:57.84,Main,,0,0,0,,Köpeğimi yürüyüşe çıkarmam lazım.
Dialogue: 0,0:26:57.84,0:27:01.64,Main,,0,0,0,,Oğlum kayıp, gören oldu mu?
Dialogue: 0,0:27:02.21,0:27:03.93,Main,,0,0,0,,N'oluyor?
Dialogue: 0,0:27:03.93,0:27:06.85,Main,,0,0,0,,Neyse ne, fırsat kaçmadan\Nyola koyulalım!
Dialogue: 0,0:27:07.25,0:27:08.64,Main,,0,0,0,,Ne oldu öyle?
Dialogue: 0,0:27:08.64,0:27:13.26,Main,,0,0,0,,Homies'e aktarılmış ruhların\Nilk sahiplerinin hatıraları...
Dialogue: 0,0:27:13.26,0:27:16.36,Main,,0,0,0,,...gözlerinde canlanıyor.
Dialogue: 0,0:27:16.36,0:27:19.90,Main,,0,0,0,,Kafaları karışmışken\NMama'nın kontrolünden çıkmış olurlar!
Dialogue: 0,0:27:19.90,0:27:23.28,Main,,0,0,0,,Böylelikle de Luffy-{\i1}kun{\i0}lar\Normandan çıkabilir!
Dialogue: 0,0:27:23.28,0:27:25.99,Main,,0,0,0,,Anladım.\NTeşekkürler Pudding-{\i1}chan{\i0}!
Dialogue: 0,0:27:29.41,0:27:33.33,Main,,0,0,0,,Nasıl olur?\NNe zamandır oradasın Sanji...
Dialogue: 0,0:27:33.33,0:27:34.34,Main,,0,0,0,,...{\i1}-san{\i1}!{\i0}
Dialogue: 0,0:27:34.34,0:27:36.02,Main,,0,0,0,,Demin bindim.
Dialogue: 0,0:27:36.02,0:27:37.40,Main,,0,0,0,,Ne?
Dialogue: 0,0:27:37.40,0:27:39.43,Main,,0,0,0,,Fark etmemiş miydin?
Dialogue: 0,0:27:39.43,0:27:42.80,Main,,0,0,0,,Pekâlâ Pudding-{\i1}chan{\i0},\Nsüratle Çikolata Şehri'ne gidelim!
Dialogue: 0,0:27:42.80,0:27:45.22,Main,,0,0,0,,Y- Yüzerek git o zaman mal!
Dialogue: 0,0:27:45.79,0:27:48.35,Main,,0,0,0,,Kızdığında gözlerinin güzelliği ortaya çıkıyor.
Dialogue: 0,0:27:52.26,0:27:54.06,Main,,0,0,0,,Sen iyi misin Pudding?
Dialogue: 0,0:27:54.06,0:27:58.65,Main,,0,0,0,,İ- İyiyim...\NB- Benimle oynama!
Dialogue: 0,0:27:58.65,0:28:02.23,Main,,0,0,0,,Y- Yoksa gebertirim Sanji...
Dialogue: 0,0:28:02.23,0:28:03.61,Main,,0,0,0,,...{\i1}-san{\i1}!{\i0}
Dialogue: 0,0:28:05.13,0:28:07.94,Main,,0,0,0,,Kıyıyı görüyorum!
Dialogue: 0,0:28:07.94,0:28:09.10,Main,,0,0,0,,Elimizi çabuk tutalım!
Dialogue: 0,0:28:09.10,0:28:13.90,Main,,0,0,0,,Başardık! Fakat Pudding\Nsahiden de bizden yana mı şimdi?
Dialogue: 0,0:28:13.90,0:28:19.03,Main,,0,0,0,,Bilemem! Bölgelerinden çıkana değin\Ntedbiri elden bırakmamalıyız!
Dialogue: 0,0:28:23.27,0:28:25.91,Main,,0,0,0,,Kaçamazsınız!
Dialogue: 0,0:28:26.51,0:28:28.50,Main,,0,0,0,,Lan Zeus!
Dialogue: 0,0:28:28.50,0:28:30.88,Main,,0,0,0,,Bunu nasıl yaparsın ya?
Dialogue: 0,0:28:37.38,0:28:39.63,Main,,0,0,0,,Neden bizi de hedef aldın ki?
Dialogue: 0,0:28:39.63,0:28:43.28,Main,,0,0,0,,Özür dilerim. Kasıtlı yapmadım!
Dialogue: 0,0:28:43.28,0:28:48.40,Main,,0,0,0,,Kastına sıçarım senin!\NBi' daha dikkatsizlik etme sakın!
Dialogue: 0,0:28:48.40,0:28:51.15,Main,,0,0,0,,Tamam, farkındayım.
Dialogue: 0,0:28:51.15,0:28:56.11,Main,,0,0,0,,O değil de fırtına bulutu yumurtalarının\Ntadı ne güzeldi ya!
Dialogue: 0,0:28:56.11,0:28:56.94,Main,,0,0,0,,Ha?
Dialogue: 0,0:28:56.94,0:29:02.49,Main,,0,0,0,,Kafam basmıyor mu oğlum?\NMama'nın emirleri her şeyin üstündedir!
Dialogue: 0,0:29:02.49,0:29:04.58,Main,,0,0,0,,Biliyorum ya...
Dialogue: 0,0:29:07.22,0:29:09.49,Main,,0,0,0,,Geri verin...
Dialogue: 0,0:29:09.49,0:29:14.84,Main,,0,0,0,,Düğün pastamı!
Dialogue: 0,0:29:14.84,0:29:15.71,Main,,0,0,0,,Olamaz!
Dialogue: 0,0:29:18.59,0:29:19.67,Main,,0,0,0,,Savuşturun.
Dialogue: 0,0:29:26.66,0:29:27.89,Main,,0,0,0,,Hay içine...
Dialogue: 0,0:29:28.46,0:29:30.47,Main,,0,0,0,,Sıyırdı geçti.
Dialogue: 0,0:29:30.47,0:29:32.14,Main,,0,0,0,,Teşekkürler Jinbe!
Dialogue: 0,0:29:51.02,0:29:55.28,Main,,0,0,0,,Uzlaşmacı Taşlar'a karşı oldukça\Ndirayetli cenk ettin iskelet.
Dialogue: 0,0:29:56.83,0:29:58.81,Main,,0,0,0,,Bendeniz...
Dialogue: 0,0:29:58.81,0:30:01.37,Main,,0,0,0,,...Ruh Kralı'yım da ondan!
Dialogue: 0,0:30:01.37,0:30:05.38,Main,,0,0,0,,Aynadan düşmanlar gelmeye devam ediyor.
Dialogue: 0,0:30:08.09,0:30:12.97,Main,,0,0,0,,Namiler'in odasındaki aynadan geliyorlar.\NAynayı kırsak kızarlar mı acaba?
Dialogue: 0,0:30:12.97,0:30:16.81,Main,,0,0,0,,Kırmayı başarabilirsek\Nsonrasında özrümüzü dileriz.
Dialogue: 0,0:30:17.88,0:30:21.35,Main,,0,0,0,,Kimden özür dileyecekmişsiniz-perorin?
Dialogue: 0,0:30:21.35,0:30:23.80,Main,,0,0,0,,Az önce çarpan yıldırımı\Ngördünüz herhâlde?
Dialogue: 0,0:30:23.80,0:30:27.03,Main,,0,0,0,,Geminize kimseler gelmeyecek.
Dialogue: 0,0:30:30.49,0:30:34.79,Main,,0,0,0,,Size acıyacağımı söylüyorum yahu!
Dialogue: 0,0:30:34.79,0:30:40.46,Main,,0,0,0,,Ne kadar kasarsanız kasın, \Naskerlerimiz ardı arkası kesilmeden gelecek.
Dialogue: 0,0:30:40.46,0:30:44.76,Main,,0,0,0,,Sizler de önünde sonunda\Ntüm gücünüzü tüketeceksiniz.
Dialogue: 0,0:30:44.76,0:30:51.14,Main,,0,0,0,,Tam şu an teslim olursanız\Nhayatlarınızı bağışlarım.
Dialogue: 0,0:30:51.14,0:30:53.48,Main,,0,0,0,,Pes edin haydi.
Dialogue: 0,0:30:55.01,0:30:57.69,Main,,0,0,0,,Boş yapıyorsun.
Dialogue: 0,0:30:58.65,0:31:03.01,Main,,0,0,0,,Bu laflarına cevap vermekten\Ngına geldi artık.
Dialogue: 0,0:31:04.73,0:31:07.32,Main,,0,0,0,,Gemiden inmeni istemek durumundayım.
Dialogue: 0,0:31:07.32,0:31:10.20,Main,,0,0,0,,Sunny-go bizim gemimizdir!
Dialogue: 0,0:31:11.70,0:31:14.91,Main,,0,0,0,,Cidden benimle savaşacak mısın?
Dialogue: 0,0:31:28.26,0:31:30.10,Main,,0,0,0,,Anlıyorum.
Dialogue: 0,0:31:30.10,0:31:35.22,Main,,0,0,0,,Hayatına hiç değer vermiyorsun gibi.
Dialogue: 0,0:31:35.22,0:31:36.89,Main,,0,0,0,,İyi madem.
Dialogue: 0,0:31:36.89,0:31:40.11,Main,,0,0,0,,Seni kendi ellerimle öldüreceğim!
Dialogue: 0,0:31:50.37,0:31:52.89,Main,,0,0,0,,Aha! Ormanın sonu!
Dialogue: 0,0:31:52.89,0:31:56.22,Main,,0,0,0,,Pekâlâ! Dosdoğru Kakao Adası'na gidelim!
Dialogue: 0,0:32:02.36,0:32:04.49,Main,,0,0,0,,Brook! Chopper!
Dialogue: 0,0:32:04.49,0:32:06.66,Main,,0,0,0,,Şuradaki sizin geminiz mi?
Dialogue: 0,0:32:06.66,0:32:09.24,Main,,0,0,0,,Evet, saldırıya uğruyormuş.
Dialogue: 0,0:32:09.24,0:32:11.80,Main,,0,0,0,,Pusu kurmuşlar galiba.
Dialogue: 0,0:32:11.80,0:32:15.56,Main,,0,0,0,,Eyvah! Abilerim de gemide!
Dialogue: 0,0:32:16.95,0:32:20.75,Main,,0,0,0,,Abimler Sanji-san'ın arkadaşlarına saldırıyor!
Dialogue: 0,0:32:20.75,0:32:22.88,Main,,0,0,0,,Ya işte! Arkadaşların öldü oğlum!
Dialogue: 0,0:32:22.88,0:32:27.01,Main,,0,0,0,,Oh olsun! Abilerimle aşık atamazlar!
Dialogue: 0,0:32:27.01,0:32:31.03,Main,,0,0,0,,Arkadaşların denizin dibini boylayacak!
Dialogue: 0,0:32:32.13,0:32:34.46,Main,,0,0,0,,Neler diyorsun Pudding ya?
Dialogue: 0,0:32:34.46,0:32:38.93,Main,,0,0,0,,İnanmıyorum! Öyle demek istememiştim!
Dialogue: 0,0:32:39.56,0:32:43.05,Main,,0,0,0,,Peki n'apacaksın?\NGemiye mi döneceksin?
Dialogue: 0,0:32:44.23,0:32:47.73,Main,,0,0,0,,Hayır, Pudding-chan'ın yanında kalacağım.
Dialogue: 0,0:32:47.73,0:32:48.77,Main,,0,0,0,,Ne?
Dialogue: 0,0:32:50.11,0:32:53.62,Main,,0,0,0,,Emin misin?\NYolumuza devam edeceğiz biz!
Dialogue: 0,0:32:53.62,0:32:56.74,Main,,0,0,0,,Eminim, kendi başlarının çaresine bakarlar.
Dialogue: 0,0:32:57.41,0:33:01.25,Main,,0,0,0,,Daha ziyade, bir an evvel...
Dialogue: 0,0:33:02.87,0:33:07.71,Main,,0,0,0,,...Big Mom'ın aklını alacak\Npastayı pişirmeye başlayalım!
