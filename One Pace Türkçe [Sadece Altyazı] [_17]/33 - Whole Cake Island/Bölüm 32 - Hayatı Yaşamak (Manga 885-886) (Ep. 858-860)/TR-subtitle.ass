Dialogue: 0,0:01:38.18,0:01:40.85,Title,,0,0,0,,{\pos(632,465)}{\fad(350,0)}Hayatı Yaşamak
Dialogue: 0,0:01:43.56,0:01:45.30,Main,,0,0,0,,{\fad(150,150)}Amadare Mochi!
Dialogue: 0,0:01:43.56,0:01:45.30,Attack,,0,0,0,,{\fad(150,150)}Mochi Sağanağı
Dialogue: 0,0:01:56.95,0:02:00.42,Main,,0,0,0,,Hay içine!\NYine güçlü hâline büründü!
Dialogue: 0,0:02:02.12,0:02:04.33,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:02:05.96,0:02:06.99,Main,,0,0,0,,{\fad(150,150)}Kong...
Dialogue: 0,0:02:06.99,0:02:08.34,Main,,0,0,0,,{\fad(150,150)}Gun!
Dialogue: 0,0:02:06.99,0:02:08.34,Attack,,0,0,0,,{\fad(150,150)}Silahı
Dialogue: 0,0:02:13.30,0:02:14.51,Main,,0,0,0,,Donutlar!
Dialogue: 0,0:02:14.51,0:02:16.25,Main,,0,0,0,,{\fad(150,150)}Chikara Mochi!
Dialogue: 0,0:02:14.51,0:02:16.25,Attack,,0,0,0,,{\fad(150,150)}Kudretli Mochi
Dialogue: 0,0:02:26.40,0:02:31.23,Captions,,0,0,0,,{\pos(1131,480)}{\fad(900,0)}Totto Land,\NDenizde bir yerde
Dialogue: 0,0:02:26.40,0:02:31.23,Captions,,0,0,0,,{\pos(143,440)}{\fad(900,0)}Sunny
Dialogue: 0,0:02:28.32,0:02:31.23,Main,,0,0,0,,Üzerini değişmişsin.
Dialogue: 0,0:02:34.66,0:02:36.11,Main,,0,0,0,,Çok sessiz.
Dialogue: 0,0:02:36.11,0:02:38.58,Main,,0,0,0,,Şaşırtıcı biçimde.
Dialogue: 0,0:02:40.46,0:02:44.66,Main,,0,0,0,,Asayiş berkemal!
Dialogue: 0,0:02:45.64,0:02:48.78,Main,,0,0,0,,Fakat illa ki bir belaya çatacağız.
Dialogue: 0,0:02:48.78,0:02:51.59,Main,,0,0,0,,Yonkou olarak gururu söz konusu!
Dialogue: 0,0:02:51.59,0:02:53.45,Main,,0,0,0,,Yine de...
Dialogue: 0,0:02:53.45,0:02:57.59,Main,,0,0,0,,...ilerlemeyi sürdürmekten başka çaremiz yok!
Dialogue: 0,0:02:57.59,0:02:58.84,Main,,0,0,0,,Aynen!
Dialogue: 0,0:02:58.84,0:03:02.39,Main,,0,0,0,,Daha önceki düz hattımızda\Nseyretmeye dönmeliyiz!
Dialogue: 0,0:03:03.00,0:03:04.68,Main,,0,0,0,,Haklısın.
Dialogue: 0,0:03:04.68,0:03:10.38,Main,,0,0,0,,Pastayı temin edecek Sanji-kunlar ile\Nbir araya gelemezsek...
Dialogue: 0,0:03:10.38,0:03:13.08,Main,,0,0,0,,...ayrı düşmemiz bir yana...
Dialogue: 0,0:03:13.08,0:03:18.04,Main,,0,0,0,,...dünyanın öbür ucuna kadar\NBig Mom'ın gazabı yakamızı bırakmaz!
Dialogue: 0,0:03:28.08,0:03:33.09,Captions,,0,0,0,,{\fad(500,0)}Denizde başka bir yerde
Dialogue: 0,0:03:29.71,0:03:32.46,Main,,0,0,0,,{\i1}Totto Land'ın tüm adalarına duyurulur!{\i}{\an8}
Dialogue: 0,0:03:33.09,0:03:38.20,Main,,0,0,0,,{\i1}Adalarınızda yelken almamış\NTurta gemisi kalmasın!
Dialogue: 0,0:03:38.20,0:03:42.89,Main,,0,0,0,,{\i1}Big Mom Korsanları'nın\Nşanına leke sürmemek için...
Dialogue: 0,0:03:42.89,0:03:47.27,Main,,0,0,0,,{\i1}...şu üç adi korsan tayfasının\Npeşine düşeceksiniz!
Dialogue: 0,0:03:47.27,0:03:54.11,Main,,0,0,0,,{\i1}Biz Big Mom Korsanları için ağır\Nkayıplara yol açan Hasır Şapkalar!
Dialogue: 0,0:03:54.11,0:03:57.02,Main,,0,0,0,,Tabii buna önayak olan...
Dialogue: 0,0:03:57.02,0:04:04.37,Main,,0,0,0,,{\i1}...ve kraliçemiz Big Mom'a ihanet edip\Nsuikast düzenleyen Ateş Tankı Korsanları!
Dialogue: 0,0:04:04.37,0:04:09.56,Main,,0,0,0,,{\i1}Akabinde ise baş kaldıran Denizin İlk Oğlu\NJinbe'nin yoldaşları olan...
Dialogue: 0,0:04:09.56,0:04:12.31,Main,,0,0,0,,...ve sırra kadem basan Balık Adamlar'ın...
Dialogue: 0,0:04:12.31,0:04:15.09,Main,,0,0,0,,{\i1}...Güneş Korsanları!
Dialogue: 0,0:04:15.09,0:04:21.72,Main,,0,0,0,,{\i1}Bu korsan tayfaları an itibariyle\NTotto Land denizinde kol geziyor!
Dialogue: 0,0:04:21.72,0:04:26.02,Main,,0,0,0,,Biz mi arayacağız?\NMıntıka Salyangozları'na n'oldu ki?
Dialogue: 0,0:04:26.02,0:04:29.07,Main,,0,0,0,,Ortadan kaybolduklarını işittim.
Dialogue: 0,0:04:29.07,0:04:31.10,Main,,0,0,0,,Ne?
Dialogue: 0,0:04:31.10,0:04:35.82,Main,,0,0,0,,{\i1}Bölgemizden çıkmalarına izin vermeyin!
Dialogue: 0,0:04:35.82,0:04:39.44,Main,,0,0,0,,{\i1}Ne pahasına olursa olsun\Nhepsini bulup...
Dialogue: 0,0:04:39.44,0:04:45.01,Main,,0,0,0,,{\i1}...oracıkta denizin dibine yollayın!
Dialogue: 0,0:04:45.01,0:04:49.51,Main,,0,0,0,,Tamamdır!
Dialogue: 0,0:04:50.50,0:04:53.24,Main,,0,0,0,,Demin kendi ağzınla...
Dialogue: 0,0:04:53.24,0:04:59.17,Main,,0,0,0,,...sakinliğimi koruduğum müddetçe\Nyenilmez olduğumu söyledin, değil mi?
Dialogue: 0,0:05:01.04,0:05:05.63,Main,,0,0,0,,Yine açık vereceksin!\NYenemeyeceğim...
Dialogue: 0,0:05:06.51,0:05:08.22,Main,,0,0,0,,...bir düşman değilsin!
Dialogue: 0,0:05:08.22,0:05:10.80,Main,,0,0,0,,Küçülüyor gibisin.
Dialogue: 0,0:05:10.80,0:05:14.47,Main,,0,0,0,,Sahi!\NDördüncü Vites'in süresi doldu!
Dialogue: 0,0:05:14.47,0:05:16.61,Main,,0,0,0,,Tamamdır, vazgeçtim!
Dialogue: 0,0:05:18.30,0:05:21.06,Main,,0,0,0,,Dile getirdiğin için sağ olasın!
Dialogue: 0,0:05:21.06,0:05:24.02,Main,,0,0,0,,10 dakikalığına Haki kullanamam!
Dialogue: 0,0:05:24.02,0:05:27.53,Main,,0,0,0,,Bu yüzden de olabildiğince\Nuzağa kaçmam lazım!
Dialogue: 0,0:05:27.53,0:05:30.55,Main,,0,0,0,,Süre sınırı olan bir güç artışıydı yani?
Dialogue: 0,0:05:30.55,0:05:32.10,Main,,0,0,0,,{\fad(150,150)}Nagare Mochi!
Dialogue: 0,0:05:30.55,0:05:32.10,Attack,,0,0,0,,{\fad(150,150)}Akan Mochi
Dialogue: 0,0:05:32.12,0:05:35.45,Main,,0,0,0,,Bu fırsatı tepecek kadar saf değilim!
Dialogue: 0,0:05:46.26,0:05:47.59,Main,,0,0,0,,Eyvah!
Dialogue: 0,0:05:50.22,0:05:52.10,Main,,0,0,0,,Bana 10 dakika lazım!
Dialogue: 0,0:05:52.10,0:05:54.60,Main,,0,0,0,,Haki'm olmadan karşısında duramam!
Dialogue: 0,0:05:56.72,0:05:58.66,Main,,0,0,0,,Olmaz! Yenilme lüksüm yok!
Dialogue: 0,0:05:58.66,0:06:01.29,Main,,0,0,0,,Eyvah be! Vaziyet sakat!
Dialogue: 0,0:06:02.50,0:06:06.75,Main,,0,0,0,,Hayal kırıklığına uğradım.\NDüellomuz bitti mi yani?
Dialogue: 0,0:06:14.30,0:06:16.35,Main,,0,0,0,,Olamaz!
Dialogue: 0,0:06:17.24,0:06:20.01,Captions,,0,0,0,,{\pos(641,715)}{\fad(500,0)}Kakao Adası (Çikolata Şehri)
Dialogue: 0,0:06:20.09,0:06:22.62,Captions,,0,0,0,,{\pos(174,79)}{\fad(650,0)}Şeker Fabrikası
Dialogue: 0,0:06:22.62,0:06:24.88,Main,,0,0,0,,Ha? Ne oldu öyle?
Dialogue: 0,0:06:24.88,0:06:27.83,Main,,0,0,0,,Hey, neyin var? İyi misin?
Dialogue: 0,0:06:27.83,0:06:30.95,Main,,0,0,0,,Kremşantiden tatmıştı.
Dialogue: 0,0:06:30.96,0:06:34.08,Main,,0,0,0,,D- Damat-sama zehir mi koymuştu yoksa?
Dialogue: 0,0:06:34.08,0:06:34.79,Main,,0,0,0,,Ne?
Dialogue: 0,0:06:37.93,0:06:39.97,Main,,0,0,0,,Kendisine sorun.
Dialogue: 0,0:06:39.97,0:06:42.74,Main,,0,0,0,,Ö- Ölecektim...
Dialogue: 0,0:06:43.30,0:06:46.85,Main,,0,0,0,,Mutluluktan ölecektim ya!
Dialogue: 0,0:06:46.85,0:06:49.34,Main,,0,0,0,,Lezzetinden dolayı ölüp gidecekti!
Dialogue: 0,0:06:49.34,0:06:51.77,Main,,0,0,0,,Yüzündeki mutluluğa baksanıza!
Dialogue: 0,0:06:51.77,0:06:55.66,Main,,0,0,0,,Sanji-san'ın gizli malzemesi\Nbu kremşanti oluyormuş demek!
Dialogue: 0,0:06:55.66,0:06:58.50,Main,,0,0,0,,Gerçek bir tatlı!
Dialogue: 0,0:07:01.24,0:07:03.23,Main,,0,0,0,,Hazır!
Dialogue: 0,0:07:03.23,0:07:07.04,Main,,0,0,0,,En leziz krema Susam Konstantresi!
Dialogue: 0,0:07:07.04,0:07:10.33,Main,,0,0,0,,B- Ben de tadına bakmak istiyorum!
Dialogue: 0,0:07:10.33,0:07:13.58,Main,,0,0,0,,Şu an olmaz Pudding-chan.
Dialogue: 0,0:07:13.58,0:07:14.42,Main,,0,0,0,,Neden ama?
Dialogue: 0,0:07:14.42,0:07:19.05,Main,,0,0,0,,Senin gibi güven aşılayan bir yoldaşımızı\Nkaybetme lüksüne giremeyiz.
Dialogue: 0,0:07:23.18,0:07:25.76,Main,,0,0,0,,Yemediğin hâlde\Nne diye bayılıyorsun ki?
Dialogue: 0,0:07:30.86,0:07:34.65,Main,,0,0,0,,Böylesi bir krema\Npastanın üzerini kaplarsa...
Dialogue: 0,0:07:35.74,0:07:38.27,Main,,0,0,0,,Hayal etme sakın! Ölür gidersin bak!
Dialogue: 0,0:07:43.87,0:07:49.08,Main,,0,0,0,,Kabarık mı kabarık şifon pastamız da\Nhazır artık Kara Bacak!
Dialogue: 0,0:07:49.08,0:07:50.37,Main,,0,0,0,,Tamamdır!
Dialogue: 0,0:07:52.96,0:07:58.00,Main,,0,0,0,,Sakinleşsene! \NÖyle kabarık ki uçup gidecek sanki!
Dialogue: 0,0:07:58.00,0:08:00.80,Main,,0,0,0,,Ben de bitirdim!
Dialogue: 0,0:08:00.80,0:08:03.28,Main,,0,0,0,,Sanji-san'ın kremşantisini içeren...
Dialogue: 0,0:08:03.28,0:08:07.85,Main,,0,0,0,,...acayip tatlı ve akışkan taze çikolatam!
Dialogue: 0,0:08:09.47,0:08:14.73,Main,,0,0,0,,Ağzını kapatın! \NO kadar akışkan ki kazandan dökülecek!
Dialogue: 0,0:08:19.52,0:08:22.28,Main,,0,0,0,,6'ya beş var.
Dialogue: 0,0:08:22.99,0:08:25.56,Main,,0,0,0,,Plana uygun gidiyoruz.
Dialogue: 0,0:08:27.28,0:08:29.04,Main,,0,0,0,,Gemimiz hazır mı?
Dialogue: 0,0:08:29.04,0:08:30.54,Main,,0,0,0,,Hazır efendim!
Dialogue: 0,0:08:30.54,0:08:35.04,Main,,0,0,0,,Vakitten tasarruf etmek için\Npastayı gemide tamamlayacağız!
Dialogue: 0,0:08:36.10,0:08:40.30,Main,,0,0,0,,Buraya baş koyan Sunny-go ile\Nbir an evvel buluşalım!
Dialogue: 0,0:08:40.30,0:08:42.01,Main,,0,0,0,,Emredersiniz.
Dialogue: 0,0:08:42.01,0:08:43.55,Main,,0,0,0,,Tamamdır!
Dialogue: 0,0:08:43.55,0:08:45.76,Main,,0,0,0,,Vakit geldi çattı!
Dialogue: 0,0:08:45.76,0:08:47.93,Main,,0,0,0,,Haydi bakalım!
Dialogue: 0,0:08:47.93,0:08:52.60,Main,,0,0,0,,Arkadaşlarımızı üzen Big Mom'ı alt edelim!
Dialogue: 0,0:08:58.33,0:09:00.79,Main,,0,0,0,,Efendim, neden yüzünüzü gizliyorsunuz ki?
Dialogue: 0,0:09:01.88,0:09:04.00,Main,,0,0,0,,Utangacım da ondan.
Dialogue: 0,0:09:10.47,0:09:14.68,Main,,0,0,0,,Yolu açın millet! \NPastayı limana naklediyoruz!
Dialogue: 0,0:09:14.68,0:09:18.06,Main,,0,0,0,,İnanmıyorum! \NBu kadar kısa sürede mi pişirmişler?
Dialogue: 0,0:09:18.06,0:09:19.94,Main,,0,0,0,,Şeklini şemailini almış bile!
Dialogue: 0,0:09:19.94,0:09:22.23,Main,,0,0,0,,Enfes de kokuyor!
Dialogue: 0,0:09:23.27,0:09:27.06,Main,,0,0,0,,Tamamlandığında eminim Mama'nın\Ndili düşecektir!
Dialogue: 0,0:09:27.06,0:09:31.03,Main,,0,0,0,,Kokusu bile beni havalara uçurmaya yetiyor! \NCennette miyiz ne?
Dialogue: 0,0:09:34.74,0:09:38.41,Main,,0,0,0,,Pudding-sama ile Chiffon-sama'dan da\Ndaha azı beklenmezdi zaten!
Dialogue: 0,0:09:38.41,0:09:40.91,Main,,0,0,0,,Tabii WCI: 31'i de unutmayalım!
Dialogue: 0,0:09:44.04,0:09:46.09,Main,,0,0,0,,Pekâlâ!\NMama yoldadır!
Dialogue: 0,0:09:46.09,0:09:47.63,Main,,0,0,0,,Elimizi çabuk tutmalıyız!
Dialogue: 0,0:09:48.21,0:09:51.25,Main,,0,0,0,,Pudding-{\i1}sama{\i0}! Chiffon-{\i1}sama{\i0}!
Dialogue: 0,0:09:51.25,0:09:53.51,Main,,0,0,0,,Yolunuz açık olsun!
Dialogue: 0,0:09:54.60,0:09:57.37,Main,,0,0,0,,Bekle bakalım Big Mom.
Dialogue: 0,0:09:58.22,0:10:01.48,Main,,0,0,0,,Sana en leziz pastayı yedireceğim!
Dialogue: 0,0:10:15.30,0:10:16.59,Main,,0,0,0,,{\fad(150,150)}Chikara Mochi!
Dialogue: 0,0:10:15.30,0:10:16.59,Attack,,0,0,0,,{\fad(150,150)}Kudretli Mochi
Dialogue: 0,0:10:51.06,0:10:52.56,Main,,0,0,0,,Brûlée mi?
Dialogue: 0,0:10:57.07,0:11:00.44,Main,,0,0,0,,Yardım et abi!
Dialogue: 0,0:11:02.74,0:11:04.24,Main,,0,0,0,,Yardım et!
Dialogue: 0,0:11:03.32,0:11:04.24,Secondary,,0,0,0,,Beyinsiz!
Dialogue: 0,0:11:04.24,0:11:05.82,Main,,0,0,0,,Abi!
Dialogue: 0,0:11:05.82,0:11:07.16,Main,,0,0,0,,Orada ne işin vardı ki?
Dialogue: 0,0:11:07.16,0:11:09.62,Main,,0,0,0,,Bekle Hasır Şapka!
Dialogue: 0,0:11:12.05,0:11:13.37,Main,,0,0,0,,Sıçayım!
Dialogue: 0,0:11:14.94,0:11:16.25,Main,,0,0,0,,Brûlée!
Dialogue: 0,0:11:24.33,0:11:26.46,Main,,0,0,0,,Ucuz yırttım ha.
Dialogue: 0,0:11:26.46,0:11:28.45,Main,,0,0,0,,Nereye geldik?
Dialogue: 0,0:11:28.45,0:11:30.87,Main,,0,0,0,,Teşekkürler dal.
Dialogue: 0,0:11:31.42,0:11:33.31,Main,,0,0,0,,Adım Brûlée!
Dialogue: 0,0:11:33.31,0:11:34.96,Main,,0,0,0,,Haki'mi...
Dialogue: 0,0:11:34.96,0:11:37.33,Main,,0,0,0,,...tekrar kazanana kadar\Nburada bekleyeceğim!
Dialogue: 0,0:11:49.70,0:11:51.29,Main,,0,0,0,,N- N'oluyor?
Dialogue: 0,0:12:05.38,0:12:10.22,Main,,0,0,0,,Düğün...
Dialogue: 0,0:12:10.22,0:12:11.67,Main,,0,0,0,,Yapma!
Dialogue: 0,0:12:17.33,0:12:20.28,Main,,0,0,0,,Pasta değil bu!
Dialogue: 0,0:12:21.05,0:12:25.61,Main,,0,0,0,,Mama, dur! Burası benim şehrim!
Dialogue: 0,0:12:25.61,0:12:28.37,Main,,0,0,0,,Mama! Kuru Yemiş Adası'na geldin!
Dialogue: 0,0:12:28.37,0:12:32.12,Main,,0,0,0,,Pasta da Hasır Şapka da burada değil!
Dialogue: 0,0:12:32.12,0:12:37.88,Main,,0,0,0,,Neredesin be Hasır Şapka?
Dialogue: 0,0:12:37.88,0:12:39.92,Main,,0,0,0,,Big Mom mı?
Dialogue: 0,0:12:52.95,0:12:56.93,Main,,0,0,0,,Hiç şüphesiz benim kızım!
Dialogue: 0,0:12:56.93,0:13:00.88,Main,,0,0,0,,Chiffon! Adım gibi eminim!
Dialogue: 0,0:13:03.14,0:13:05.41,Main,,0,0,0,,Bekle biraz Pudding!
Dialogue: 0,0:13:08.27,0:13:09.71,Main,,0,0,0,,O...
Dialogue: 0,0:13:09.71,0:13:12.91,Main,,0,0,0,,Oven abi! Yoldan çekil.
Dialogue: 0,0:13:12.91,0:13:16.65,Main,,0,0,0,,Pudding, pastayı nereye götürüyorsun?
Dialogue: 0,0:13:16.65,0:13:19.57,Main,,0,0,0,,Bu adada Hasır Şapkalar'a pusu kurup...
Dialogue: 0,0:13:19.57,0:13:22.83,Main,,0,0,0,,...Açlık Krizi tutan Mama'yı ise\Nburaya çekeceğimiz söylenmişti!
Dialogue: 0,0:13:24.03,0:13:28.17,Main,,0,0,0,,Pastayı gemide tamamlayıp\NMama'yı denizde durduracağız!
Dialogue: 0,0:13:28.17,0:13:29.79,Main,,0,0,0,,Denizde mi?
Dialogue: 0,0:13:29.79,0:13:33.96,Main,,0,0,0,,Gözü dönmüş Mama'mızı Çikolata Şehri'ne\Nsokmak mı istiyorsun?
Dialogue: 0,0:13:33.96,0:13:38.05,Main,,0,0,0,,Peros abiyle temasa geçebilirsek\Ndenizde bir buluşma ayarlayabiliriz!
Dialogue: 0,0:13:47.77,0:13:50.90,Main,,0,0,0,,Evet, dediklerinde haklılık payı var.
Dialogue: 0,0:13:53.70,0:13:57.53,Main,,0,0,0,,Anladım.\NGüzel kardeşim, devam et.
Dialogue: 0,0:13:57.53,0:14:01.99,Main,,0,0,0,,Şükürler olsun!\NTeşekkürler Oven abi!
Dialogue: 0,0:14:01.99,0:14:03.53,Main,,0,0,0,,Ama Chiffon!
Dialogue: 0,0:14:06.79,0:14:09.00,Main,,0,0,0,,Sen bir yere gitmiyorsun!
Dialogue: 0,0:14:09.00,0:14:10.50,Main,,0,0,0,,Chiffon abla!
Dialogue: 0,0:14:12.67,0:14:15.22,Main,,0,0,0,,Çok zalimsiniz Oven-{\i1}sama{\i0}!
Dialogue: 0,0:14:15.22,0:14:17.96,Main,,0,0,0,,Bunu kardeşinize nasıl yaparsınız?
Dialogue: 0,0:14:20.97,0:14:25.85,Main,,0,0,0,,Sizi ırgalamaz! Ailevi bir mesele!
Dialogue: 0,0:14:25.85,0:14:28.39,Main,,0,0,0,,Pastayı limana nakletmelerine\Nyardım edin!
Dialogue: 0,0:14:28.39,0:14:29.65,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:14:31.65,0:14:33.27,Main,,0,0,0,,Chiffon abla!
Dialogue: 0,0:14:34.57,0:14:36.73,Main,,0,0,0,,Chiffon-{\i1}chan{\i}...
Dialogue: 0,0:14:37.33,0:14:38.99,Main,,0,0,0,,Chiffon...
Dialogue: 0,0:14:38.99,0:14:42.82,Main,,0,0,0,,Ne yüzle karşıma çıkarsın?
Dialogue: 0,0:14:42.82,0:14:47.03,Main,,0,0,0,,Kocanın nasıl bir halta kalkıştığını...
Dialogue: 0,0:14:47.03,0:14:49.54,Main,,0,0,0,,...biliyorsundur herhâlde?
Dialogue: 0,0:14:57.76,0:15:01.18,Main,,0,0,0,,Aileden de olsan ihanetin affı yoktur!
Dialogue: 0,0:15:04.35,0:15:06.56,Main,,0,0,0,,Yapma Oven abi!
Dialogue: 0,0:15:06.56,0:15:08.43,Main,,0,0,0,,Bekle Pudding-{\i1}chan{\i0}!
Dialogue: 0,0:15:08.43,0:15:11.60,Main,,0,0,0,,Karşı çıkarsan sen de hain damgası yersin!
Dialogue: 0,0:15:11.60,0:15:12.81,Main,,0,0,0,,Ne?
Dialogue: 0,0:15:12.81,0:15:16.90,Thoughts,,0,0,0,,{\i1}Ay! Benim için endişelenmiş!
Dialogue: 0,0:15:18.73,0:15:23.70,Thoughts,,0,0,0,,{\i1}İyi de gerçek kimliğimi\Nafişe edip savaşamam da.
Dialogue: 0,0:15:28.54,0:15:30.26,Thoughts,,0,0,0,,{\i1}N'apacağım?
Dialogue: 0,0:15:37.86,0:15:42.11,Main,,0,0,0,,Kararımı verdim bir kere!
Dialogue: 0,0:15:43.53,0:15:47.99,Thoughts,,0,0,0,,{\i1}Namiler'in sağ salim ayrıldığını\Ngörmeden borcum ödenmiş olmayacak!
Dialogue: 0,0:15:49.83,0:15:55.25,Main,,0,0,0,,Pastanın tamamlanmasına\Nyardım edeceğim abi!
Dialogue: 0,0:15:57.21,0:16:03.09,Thoughts,,0,0,0,,{\i1}Lola'nın hayatını kurtarmışlar. \NBurada kalırsam vazifemi yerine getiremem!
Dialogue: 0,0:16:06.51,0:16:11.48,Main,,0,0,0,,Kardeşler arasındaki bir sürtüşmeden veya\Nergenlik isyanından bahsetmiyoruz Chiffon!
Dialogue: 0,0:16:11.48,0:16:15.73,Main,,0,0,0,,Kraliçemizi öldürmeye yeltenmiş bir hainsin!
Dialogue: 0,0:16:19.36,0:16:23.15,Main,,0,0,0,,Kendi kardeşimi öldüreceğim\Nhiç aklıma gelmezdi.
Dialogue: 0,0:16:23.15,0:16:26.28,Main,,0,0,0,,Yapma abi!
Dialogue: 0,0:16:26.28,0:16:29.78,Main,,0,0,0,,Ülkenin geri kalanının da\Nibret almasını sağlamalıyız!
Dialogue: 0,0:16:29.78,0:16:31.46,Main,,0,0,0,,Chiffon abla!
Dialogue: 0,0:16:31.46,0:16:35.57,Thoughts,,0,0,0,,{\i1}Eyvah. Belki de sonuçları\Nkafaya takmanın sırası değildir!
Dialogue: 0,0:16:37.58,0:16:42.75,Main,,0,0,0,,Ellerini Chiffon'dan çek Oven-{\i1}kun{\i0}!
Dialogue: 0,0:16:42.75,0:16:45.30,Thoughts,,0,0,0,,{\i1}Şimdi seni kurtarıyorum güzel kızım!
Dialogue: 0,0:16:45.30,0:16:46.55,Main,,0,0,0,,O da kim?
Dialogue: 0,0:16:53.57,0:16:58.08,Main,,0,0,0,,Dangalak herif!\NSeni denize postalamamış mıydım?
Dialogue: 0,0:16:59.83,0:17:01.87,Thoughts,,0,0,0,,{\i1}Elemanı tanımasam da...
Dialogue: 0,0:17:21.73,0:17:23.89,Thoughts,,0,0,0,,{\i1}Kimsenin göremeyeceği bir hızda...
Dialogue: 0,0:17:24.59,0:17:26.44,Thoughts,,0,0,0,,{\i1}...onu kurtardım mı tamamdır!
Dialogue: 0,0:17:33.82,0:17:35.07,Main,,0,0,0,,Ha? Ne?
Dialogue: 0,0:17:35.91,0:17:37.53,Main,,0,0,0,,Araca geçelim Chiffon-{\i1}chan{\i0}.
Dialogue: 0,0:17:37.53,0:17:38.24,Main,,0,0,0,,Ne?
Dialogue: 0,0:17:47.63,0:17:50.84,Main,,0,0,0,,Ne? Demin Oven-sama'yı mı devirdi?
Dialogue: 0,0:17:50.84,0:17:53.96,Main,,0,0,0,,Bu ihtiyar da kimin nesi?
Dialogue: 0,0:17:53.96,0:17:57.22,Main,,0,0,0,,Sandığımdan daha mı güçlüyüm ki?
Dialogue: 0,0:17:57.22,0:17:59.10,Main,,0,0,0,,Ha? Chiffon?
Dialogue: 0,0:17:59.10,0:18:01.05,Main,,0,0,0,,Herhâlde sen yapmadın lan!
Dialogue: 0,0:18:05.77,0:18:08.29,Main,,0,0,0,,Kimin işiydi?
Dialogue: 0,0:18:09.02,0:18:10.27,Main,,0,0,0,,Kara Bacak...
Dialogue: 0,0:18:10.27,0:18:12.73,Main,,0,0,0,,Artık güvendesin Chiffon-{\i1}chan{\i0}.
Dialogue: 0,0:18:12.73,0:18:14.15,Main,,0,0,0,,Teşekkürler!
Dialogue: 0,0:18:14.15,0:18:16.70,Main,,0,0,0,,Abla, saklanman lazım.
Dialogue: 0,0:18:16.70,0:18:18.45,Main,,0,0,0,,T- Tamam.
Dialogue: 0,0:18:20.03,0:18:21.91,Main,,0,0,0,,Bir an önce denize açılalım.
Dialogue: 0,0:18:24.21,0:18:26.71,Main,,0,0,0,,Yolu açın!
Dialogue: 0,0:18:29.67,0:18:32.44,Main,,0,0,0,,Kara Bacak beni kurtardı.
Dialogue: 0,0:18:32.93,0:18:34.51,Main,,0,0,0,,Ama...
Dialogue: 0,0:18:36.47,0:18:39.96,Main,,0,0,0,,...o koca adam kimdi ki?
Dialogue: 0,0:18:58.00,0:19:00.05,Main,,0,0,0,,Buradaydın demek Chiffon!
Dialogue: 0,0:19:01.00,0:19:03.59,Main,,0,0,0,,Yapma Oven abi!
Dialogue: 0,0:19:03.59,0:19:04.66,Main,,0,0,0,,Yılan!
Dialogue: 0,0:19:05.59,0:19:10.83,Main,,0,0,0,,Dur! Pastayı tamamlamak için\NChiffon ablaya ihtiyacımız var!
Dialogue: 0,0:19:12.10,0:19:13.60,Main,,0,0,0,,Chiffon!
Dialogue: 0,0:19:13.60,0:19:19.30,Main,,0,0,0,,Yapma!\NChiffon'u rahat bırak...
Dialogue: 0,0:19:19.30,0:19:22.64,Main,,0,0,0,,Buna nankör evlat demek bile kesmez.
Dialogue: 0,0:19:23.94,0:19:26.31,Main,,0,0,0,,Geriye kemiklerin bile kalmayacak!
Dialogue: 0,0:19:27.77,0:19:29.86,Main,,0,0,0,,{\i1}Sanırım başka çarem kalmadı!
Dialogue: 0,0:19:35.41,0:19:37.01,Main,,0,0,0,,Ne oldu?
Dialogue: 0,0:19:37.01,0:19:39.79,Main,,0,0,0,,{\i1}Oven-{\i0}sama{\i1}, Bege'nin gemisini bulduk!
Dialogue: 0,0:19:40.91,0:19:43.98,Main,,0,0,0,,{\i1}Doğruca üzerinize, Kakao Adası'na gidiyor!
Dialogue: 0,0:19:43.98,0:19:48.55,Main,,0,0,0,,{\i1}Filomuz hemen ensesinde!\NOnları limana iteceğiz!
Dialogue: 0,0:19:48.55,0:19:51.34,Main,,0,0,0,,Bege!\NDalga geçiyorsun herhâlde!
Dialogue: 0,0:19:53.05,0:19:58.60,Main,,0,0,0,,Katı yürekli bir adam olduğunu sanıyordum\Nama seni kurtarmaya geliyor galiba!
Dialogue: 0,0:19:59.14,0:20:00.72,Thoughts,,0,0,0,,{\i1}Bege?!{\i0}
Dialogue: 0,0:20:03.95,0:20:06.32,Main,,0,0,0,,{\i1}Bege!{\i}
Dialogue: 0,0:20:06.32,0:20:09.16,Main,,0,0,0,,{\i1}Benim! Oven!{\i}
Dialogue: 0,0:20:09.87,0:20:11.24,Main,,0,0,0,,Oven mı?
Dialogue: 0,0:20:11.24,0:20:16.92,Main,,0,0,0,,Demin Kakao Adası'nda\Nsuç ortağın Chiffon'u yakaladım.
Dialogue: 0,0:20:16.92,0:20:18.29,Main,,0,0,0,,Ne?
Dialogue: 0,0:20:18.29,0:20:18.74,Main,,0,0,0,,{\i1}Rero{\i0}?!
Dialogue: 0,0:20:18.74,0:20:20.59,Main,,0,0,0,,Hanımımızı mı yakalamışlar?
Dialogue: 0,0:20:20.59,0:20:25.47,Main,,0,0,0,,{\i1}Şehirden çıktık, limana geliyoruz!
Dialogue: 0,0:20:25.47,0:20:29.37,Main,,0,0,0,,{\i1}Siz de dümen kırmadan doğruca limana gelip...{\i}
Dialogue: 0,0:20:25.47,0:20:31.00,Captions,,1060,0,325,,{\fad(650,0)}Kakao Adası, Limanın Önünde
Dialogue: 0,0:20:29.37,0:20:31.01,Main,,0,0,0,,{\i1}...teslim olun!{\i0}
Dialogue: 0,0:20:31.97,0:20:35.57,Main,,0,0,0,,{\i1}Kuralcı bir adamımdır.
Dialogue: 0,0:20:35.57,0:20:39.16,Main,,0,0,0,,Öz kardeşim de olsa elim titremez!
Dialogue: 0,0:20:39.82,0:20:43.46,Main,,0,0,0,,{\i1}Ters bir hareketinizde kellesi gider.
Dialogue: 0,0:20:43.46,0:20:44.84,Main,,0,0,0,,{\i1}Rero?!{\i0}
Dialogue: 0,0:20:44.84,0:20:47.92,Main,,0,0,0,,Bege! Millet!\NDümeni kırıp kaçın hemen!
Dialogue: 0,0:20:48.95,0:20:55.92,Main,,0,0,0,,Buraya bencillik ederek geldim!\NYakalanırsanız hepimiz infaz edilmiş oluruz!
Dialogue: 0,0:20:55.92,0:20:59.76,Main,,0,0,0,,En azından siz yaşamaya devam edin!
Dialogue: 0,0:20:59.76,0:21:03.45,Main,,0,0,0,,{\i1}Mama beni hiç sevmemiştir.
Dialogue: 0,0:21:05.36,0:21:08.45,Main,,0,0,0,,Siz ise...
Dialogue: 0,0:21:08.45,0:21:11.04,Main,,0,0,0,,...sahip olduğum tek ailesiniz!
Dialogue: 0,0:21:26.87,0:21:29.63,Main,,0,0,0,,{\i1}Bu yüzden günün birinde...
Dialogue: 0,0:21:29.63,0:21:32.33,Main,,0,0,0,,{\i1}...intikamımı alın!
Dialogue: 0,0:21:33.50,0:21:37.88,Main,,0,0,0,,Hanımım, neler söylüyorsunuz?
Dialogue: 0,0:21:37.88,0:21:41.34,Main,,0,0,0,,Hanımım!
Dialogue: 0,0:21:45.93,0:21:49.10,Main,,0,0,0,,{\i1}Zırvalamayı kes!
Dialogue: 0,0:21:49.10,0:21:50.27,Main,,0,0,0,,Chiffon!
Dialogue: 0,0:21:52.65,0:21:53.90,Main,,0,0,0,,Oven!
Dialogue: 0,0:21:53.90,0:21:56.52,Main,,0,0,0,,Birazdan limana varırız.
Dialogue: 0,0:21:56.52,0:22:01.40,Main,,0,0,0,,{\i1}Söylediğin gibi limana yanaşacağız!
Dialogue: 0,0:22:01.40,0:22:02.99,Main,,0,0,0,,Bege?!
Dialogue: 0,0:22:02.99,0:22:06.74,Main,,0,0,0,,Chiffon'a elini kaldırma yeter.
Dialogue: 0,0:22:07.41,0:22:08.83,Main,,0,0,0,,Hayatım...
Dialogue: 0,0:22:13.92,0:22:16.27,Main,,0,0,0,,Fazla yufka yüreklisin Bege.
Dialogue: 0,0:22:16.27,0:22:19.69,Main,,0,0,0,,Bu da kellene mal olacak!
Dialogue: 0,0:22:21.67,0:22:24.36,Main,,0,0,0,,Bege'nin gemisi geliyor!
Dialogue: 0,0:22:24.36,0:22:27.70,Main,,0,0,0,,Tüm askerler!\NTetikte olmak için konumlarınızı alın!
Dialogue: 0,0:22:30.16,0:22:34.33,Main,,0,0,0,,Filo! İki kanada ayrılıp\Nkaçış rotalarını kapatın!
Dialogue: 0,0:22:34.33,0:22:35.88,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:22:43.46,0:22:46.32,Main,,0,0,0,,Bege'nin gemisini görüyorum!
Dialogue: 0,0:22:46.32,0:22:50.36,Main,,0,0,0,,Söz verdiği gibi karşı koymadan\Nteslim olmaya geliyor galiba.
Dialogue: 0,0:22:50.36,0:22:53.49,Main,,0,0,0,,Oven-{\i1}sama{\i}'nın aracı limana varıyor!
Dialogue: 0,0:22:54.42,0:22:56.43,Main,,0,0,0,,Hasır Şapka?!
Dialogue: 0,0:22:56.43,0:22:57.03,Main,,0,0,0,,Ne?
Dialogue: 0,0:22:57.03,0:22:58.87,Main,,0,0,0,,Hasır Şapka ile Brûlée mi?
Dialogue: 0,0:22:58.87,0:23:01.40,Main,,0,0,0,,Amande abla!
Dialogue: 0,0:23:01.40,0:23:04.27,Main,,0,0,0,,Ne?\NKorsan Hasır Şapka Luffy mi?
Dialogue: 0,0:23:04.27,0:23:05.98,Main,,0,0,0,,Burada ne arıyor ki?
Dialogue: 0,0:23:05.98,0:23:10.74,Main,,0,0,0,,Mama, şuraya bak!\NHasır Şapka hemen önünde!
Dialogue: 0,0:23:10.74,0:23:12.94,Main,,0,0,0,,Hasır Şapka!
Dialogue: 0,0:23:12.94,0:23:15.39,Main,,0,0,0,,Big Mom'ın burada ne işi var ki?
Dialogue: 0,0:23:15.39,0:23:18.78,Main,,0,0,0,,Denizde Sunny-go'nun peşinde\Nolduğunu sanıyordum!
Dialogue: 0,0:23:18.78,0:23:21.20,Main,,0,0,0,,Yardım et, Mama!
Dialogue: 0,0:23:38.55,0:23:40.51,Main,,0,0,0,,Mama!
Dialogue: 0,0:23:44.35,0:23:46.52,Main,,0,0,0,,Olamaz! Üzerimize geliyor!
Dialogue: 0,0:23:46.52,0:23:52.40,Main,,0,0,0,,Hasır Şapka, pasta nerede?!
Dialogue: 0,0:23:52.40,0:23:54.69,Main,,0,0,0,,Bilmiyorum dedik ya!
Dialogue: 0,0:23:54.69,0:23:58.07,Main,,0,0,0,,Mama, Peros abi! Yardım edin!
Dialogue: 0,0:23:58.07,0:23:59.95,Main,,0,0,0,,Kardeşimi bırak!
Dialogue: 0,0:24:00.75,0:24:02.62,Main,,0,0,0,,{\fad(150,150)}Candy Wall!
Dialogue: 0,0:24:00.75,0:24:02.62,Attack,,0,0,0,,{\fad(150,150)}Şeker Duvarı
Dialogue: 0,0:24:10.26,0:24:11.75,Main,,0,0,0,,{\fad(150,150)}Gear Third!
Dialogue: 0,0:24:10.26,0:24:11.75,Note,,0,0,0,,{\fad(150,150)}Üçüncü Vites
Dialogue: 0,0:24:16.30,0:24:18.92,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:24:18.92,0:24:21.43,Main,,0,0,0,,{\fad(150,150)}Giant Pistol!
Dialogue: 0,0:24:18.92,0:24:21.43,Attack,,0,0,0,,{\fad(150,150)}Dev Tabanca
Dialogue: 0,0:24:26.85,0:24:30.30,Main,,0,0,0,,Oluru yok!\NHaki olmadan kıramıyorum!
Dialogue: 0,0:24:36.15,0:24:37.86,Main,,0,0,0,,Etrafımızı sarıyor!
Dialogue: 0,0:24:43.45,0:24:44.87,Main,,0,0,0,,{\fad(150,150)}Slow Waltz!
Dialogue: 0,0:24:43.45,0:24:44.87,Attack,,0,0,0,,{\fad(150,150)}Aheste Vals
Dialogue: 0,0:24:46.83,0:24:48.62,Main,,0,0,0,,Lan!
Dialogue: 0,0:24:48.62,0:24:51.29,Main,,0,0,0,,Abla! Aman beni kesme!
Dialogue: 0,0:24:53.61,0:24:59.55,Main,,0,0,0,,Maruf Kılıç Shirauo kan arzusuyla yanıp bitiyor.\NSon nefesinden önce tüm acıları tadacaksın.
Dialogue: 0,0:24:59.55,0:25:02.28,Main,,0,0,0,,Sizinle şimdi savaşamam!
Dialogue: 0,0:25:14.06,0:25:16.36,Main,,0,0,0,,Ayna! Ayna!
Dialogue: 0,0:25:17.22,0:25:19.07,Main,,0,0,0,,Peros abi!
Dialogue: 0,0:25:19.07,0:25:21.70,Main,,0,0,0,,Şekerin bana engel oluyor!
Dialogue: 0,0:25:22.39,0:25:23.70,Main,,0,0,0,,{\fad(150,150)}Ame Namekuji!
Dialogue: 0,0:25:22.39,0:25:23.70,Attack,,0,0,0,,{\fad(150,150)}Şeker Sümüklü Böceği
Dialogue: 0,0:25:33.12,0:25:35.50,Main,,0,0,0,,Pastamı...
Dialogue: 0,0:25:35.50,0:25:38.21,Main,,0,0,0,,...geri ver!
Dialogue: 0,0:25:38.92,0:25:41.67,Main,,0,0,0,,Haki'mi toparlayana kadar\Ndurmamam gerek!
Dialogue: 0,0:25:50.06,0:25:52.58,Main,,0,0,0,,Pastamı...
Dialogue: 0,0:25:52.58,0:25:55.05,Main,,0,0,0,,...verin!
Dialogue: 0,0:25:59.93,0:26:03.60,Main,,0,0,0,,Peros abi, Mama'yı durdur!\NBurası benim şehrim!
Dialogue: 0,0:26:03.60,0:26:07.31,Main,,0,0,0,,Mama, ipin ucunu kaçırıyorsun ama...\NŞehri talan ediyorsun!
Dialogue: 0,0:26:09.06,0:26:14.15,Main,,0,0,0,,Kaçamazsın Hasır Şapka!
Dialogue: 0,0:26:26.40,0:26:29.58,Main,,0,0,0,,Hay içine ya!\NŞehir moloz yığınına döndü!
Dialogue: 0,0:26:37.71,0:26:41.96,Main,,0,0,0,,Hasır Şapka nereye kaçtı?
Dialogue: 0,0:26:43.38,0:26:46.30,Main,,0,0,0,,Lan ucuz yırttık ha!
Dialogue: 0,0:26:47.88,0:26:51.04,Main,,0,0,0,,İyi de Big Mom buradaysa...
Dialogue: 0,0:26:51.04,0:26:55.22,Main,,0,0,0,,...Namiler kurtulmayı başardı öyleyse?
Dialogue: 0,0:26:56.20,0:27:01.12,Captions,,0,0,0,,{\fad(500,0)}Denizde bir yerde - Sunny
Dialogue: 0,0:27:03.57,0:27:04.92,Main,,0,0,0,,Gemiler göründü!
Dialogue: 0,0:27:04.92,0:27:08.28,Main,,0,0,0,,Big Mom Korsanları arayı kapatıyor!
Dialogue: 0,0:27:08.28,0:27:10.64,Main,,0,0,0,,Anlaşıldı! Vakit geldi!
Dialogue: 0,0:27:10.64,0:27:13.55,Main,,0,0,0,,Evet!\NKaçıp durmak da sıkıyor insanı!
Dialogue: 0,0:27:13.55,0:27:14.88,Main,,0,0,0,,Saldırıya geçelim!
Dialogue: 0,0:27:14.88,0:27:18.36,Main,,0,0,0,,Ayıpsın, o iş bizde!\NHaydi iş başına Carrot!
Dialogue: 0,0:27:20.52,0:27:22.03,Main,,0,0,0,,Carrot?
Dialogue: 0,0:27:36.88,0:27:39.66,Main,,0,0,0,,Carrot! Neredesin?
Dialogue: 0,0:27:39.66,0:27:42.91,Main,,0,0,0,,Haydi, büyük bir çarpışmaya\Ngireceğiz şimdi!
Dialogue: 0,0:27:44.22,0:27:46.89,Main,,0,0,0,,Baksana Choniki.
Dialogue: 0,0:27:46.89,0:27:47.98,Main,,0,0,0,,Hı?
Dialogue: 0,0:27:51.77,0:27:55.48,Main,,0,0,0,,Bu gece dolunay mı var?
Dialogue: 0,0:27:55.48,0:27:57.11,Main,,0,0,0,,Ha?
Dialogue: 0,0:28:18.71,0:28:20.83,Main,,0,0,0,,Oven-{\i1}sama{\i}!
Dialogue: 0,0:28:45.73,0:28:47.57,Main,,0,0,0,,Aptallar!
Dialogue: 0,0:28:47.57,0:28:51.10,Main,,0,0,0,,Vurdun! Baba!
Dialogue: 0,0:28:53.18,0:28:56.52,Main,,0,0,0,,Hafızana kazı Pez.
Dialogue: 0,0:28:58.65,0:29:02.98,Main,,0,0,0,,Baban hayatı böyle yaşar işte.
Dialogue: 0,0:29:02.98,0:29:06.45,Main,,0,0,0,,Baba!
Dialogue: 0,0:29:12.78,0:29:14.74,Thoughts,,0,0,0,,Çok iyi!
Dialogue: 0,0:29:14.74,0:29:18.00,Thoughts,,0,0,0,,Şimdi n'apacaksın?\NArkandayım Bege!
Dialogue: 0,0:29:27.36,0:29:30.10,Main,,0,0,0,,Biri yardım etsin ya!{\an8}
Dialogue: 0,0:29:30.10,0:29:31.34,Main,,0,0,0,,Kafa şişirme dal!{\an8}
Dialogue: 0,0:29:31.34,0:29:32.65,Main,,0,0,0,,Adım Brûlée!{\an8}
Dialogue: 0,0:29:31.14,0:29:36.14,Captions,,0,0,0,,{\pos(640,711)}{\fad(500,0)}Kızarmış Patates Şehri
Dialogue: 0,0:29:32.65,0:29:36.34,Main,,0,0,0,,{\i1}Rapor veriyorum!\NHasır Şapka Luffy burada görüldü!{\an8}
Dialogue: 0,0:29:37.35,0:29:42.86,Captions,,0,0,0,,{\fad(500,0)}Ayna Dünyası
Dialogue: 0,0:29:37.55,0:29:39.68,Main,,0,0,0,,Bırak beni!{\an8}
Dialogue: 0,0:29:41.15,0:29:42.86,Main,,0,0,0,,{\i1}Hazine Adası'ndan rapor veriyorum!{\an8}
Dialogue: 0,0:29:42.86,0:29:45.46,Main,,0,0,0,,{\i1}Hasır Şapka'yı tespit ettik!
Dialogue: 0,0:29:45.46,0:29:48.70,Main,,0,0,0,,Ne? Bu sefer de Hazine Adası'nda mı çıktı?!{\an8}
Dialogue: 0,0:29:47.31,0:29:53.23,Captions,,0,0,0,,{\fad(500,0)}Tatlı Şehri
Dialogue: 0,0:29:48.70,0:29:53.23,Main,,0,0,0,,{\i1}Hasır Şapka farklı noktalarda tespit ediliyor!\NAnlaşılan Ayna Dünyası'nda koşuşturuyor!{\an8}
Dialogue: 0,0:29:53.23,0:29:57.55,Main,,0,0,0,,Brûlée abla yine mi yakalandı ya?
Dialogue: 0,0:29:58.14,0:29:59.73,Main,,0,0,0,,{\i1}Yeşillik Adası'ndan rapor veriyorum!
Dialogue: 0,0:29:59.73,0:30:07.14,Main,,0,0,0,,{\i1}Evlerde şüpheli birinin görüldüğüne\Ndair telefonlar aldık!
Dialogue: 0,0:30:13.42,0:30:18.54,Main,,0,0,0,,Neyin peşindesin sen? \NKaçmak istiyorsan direkt Kakao Adası'na gitsene!
Dialogue: 0,0:30:18.54,0:30:20.93,Main,,0,0,0,,Ne?\NBunu nereden biliyorsun sen?
Dialogue: 0,0:30:20.93,0:30:24.58,Main,,0,0,0,,Kulak kabarttım!\NHerkes biliyor artık!
Dialogue: 0,0:30:24.58,0:30:26.39,Main,,0,0,0,,Ne? Cidden mi?
Dialogue: 0,0:30:26.39,0:30:30.60,Main,,0,0,0,,Pes et işte!\NAbimi yenemezsin!
Dialogue: 0,0:30:36.61,0:30:39.45,Main,,0,0,0,,Haki'm zaman geçtikçe tükeniyor.
Dialogue: 0,0:30:44.12,0:30:49.67,Main,,0,0,0,,Dövüş uzun sürürse eminim\Nonun Gözlem Hakisi de zayıflayacaktır.
Dialogue: 0,0:30:51.20,0:30:56.13,Main,,0,0,0,,Dışarıdan mal gibi dursan da\Ndövüşe kafan basıyormuş.
Dialogue: 0,0:30:56.13,0:30:58.51,Main,,0,0,0,,Ama o da işime gelmez!
Dialogue: 0,0:31:02.31,0:31:03.73,Flashbacks,,0,0,0,,{\i1}Luffy.{\i}
Dialogue: 0,0:31:03.73,0:31:05.78,Flashbacks,,0,0,0,,Sana izahını yapmış olsam da...
Dialogue: 0,0:31:05.78,0:31:12.20,Flashbacks,,0,0,0,,...Haki çetin bir savaş esnasında\Ndövülmeye başlar.
Dialogue: 0,0:31:12.20,0:31:18.24,Flashbacks,,0,0,0,,Ne kadar dişli rakiplerle karşılaşırsan\No kadar güçleneceksindir!
Dialogue: 0,0:31:22.08,0:31:26.38,Main,,0,0,0,,Ben de biraz olsun\Ngeleceği görebilir miyim acaba?
Dialogue: 0,0:31:26.38,0:31:30.67,Main,,0,0,0,,Ne zırvalıyorsun sen be?\NGötün kalkmasın bücür!
Dialogue: 0,0:31:42.85,0:31:45.06,Main,,0,0,0,,Onu geçmek istiyorum!
Dialogue: 0,0:31:56.07,0:31:59.76,Main,,0,0,0,,Gücünün zirvesindeyken alt etmek istiyorum!
Dialogue: 0,0:32:01.41,0:32:03.16,Main,,0,0,0,,Bir milyar beli...
Dialogue: 0,0:32:04.08,0:32:06.33,Main,,0,0,0,,...kelle ödüllü adamı!
