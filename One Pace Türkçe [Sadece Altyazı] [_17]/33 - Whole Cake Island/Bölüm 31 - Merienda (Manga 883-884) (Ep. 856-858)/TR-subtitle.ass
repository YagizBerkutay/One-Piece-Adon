Dialogue: 0,0:01:38.28,0:01:44.43,Title,,0,0,250,,{\fad(700,0)}Merienda
Dialogue: 0,0:01:59.06,0:02:00.00,Main,,0,0,0,,Pâtissiers!
Dialogue: 0,0:01:59.06,0:02:00.00,Note,,0,0,0,,Pasta Şefleri!
Dialogue: 0,0:02:00.00,0:02:01.16,Main,,0,0,0,,Emredin!
Dialogue: 0,0:02:02.14,0:02:03.84,Main,,0,0,0,,Hemen geliyoruz!
Dialogue: 0,0:02:09.05,0:02:13.14,Main,,0,0,0,,Katakuri-{\i1}sama{\i0}!\NBüyüleyici bir galibiyetti efendim!
Dialogue: 0,0:02:13.14,0:02:16.66,Main,,0,0,0,,Galibiyetiniz daha başlamadan\Naşikâr idi tabii ki!
Dialogue: 0,0:02:16.66,0:02:20.32,Main,,0,0,0,,Bugünkü ara öğüne yetişebilecek misiniz\Ndiye endişelenmiştik sadece.
Dialogue: 0,0:02:21.53,0:02:25.40,Main,,0,0,0,,Saat 3'ten beri hazır bir şekilde\Nişaretinizi bekliyorduk!
Dialogue: 0,0:02:29.78,0:02:32.60,Main,,0,0,0,,Merienda'nızı her gün aynı saatlerde\Nyemeyi isteyen...
Dialogue: 0,0:02:32.60,0:02:36.37,Main,,0,0,0,,...mükemmeliyetçi bi' yapınız olduğunu\Nbildiğimizden üzüntünüzü anlıyoruz!
Dialogue: 0,0:02:36.37,0:02:39.01,Main,,0,0,0,,Şöyle ki, çayınız...
Dialogue: 0,0:02:39.71,0:02:43.29,Main,,0,0,0,,...40 dakika geçtikten sonra\Nsoğudu efendim.
Dialogue: 0,0:02:44.53,0:02:46.26,Main,,0,0,0,,Soğuk çay da kabuldür.
Dialogue: 0,0:02:47.34,0:02:49.67,Main,,0,0,0,,{\i1}Ne kadar hoşgörülü!
Dialogue: 0,0:02:49.67,0:02:52.88,Main,,0,0,0,,Fakat bugünkü tatlılardan\Niftihar duyduğumuzu belirtelim!
Dialogue: 0,0:02:52.88,0:02:56.43,Main,,0,0,0,,Bugünkü Merienda'nızı takdim ederiz!
Dialogue: 0,0:02:56.43,0:02:58.97,Main,,0,0,0,,Kusursuz biri olan Katakuri-sama'mız için...
Dialogue: 0,0:02:58.97,0:03:02.89,Main,,0,0,0,,...kusursuz malzemelerden pişirdik!
Dialogue: 0,0:03:03.41,0:03:07.21,Main,,0,0,0,,Kara borsadan aldığımız\Nen kaliteli Corioli kakaolarından ve...
Dialogue: 0,0:03:07.21,0:03:09.40,Main,,0,0,0,,...bir Gökyüzü Adasında meralanmış...
Dialogue: 0,0:03:09.40,0:03:11.04,Main,,0,0,0,,...besleyici inek sütünden bolca kullanarak...
Dialogue: 0,0:03:11.04,0:03:15.22,Main,,0,0,0,,...kortizol seviyesini dokuzun altında tutarken tatlı mı tatlı ...
Dialogue: 0,0:03:15.22,0:03:17.57,Main,,0,0,0,,...çikolatalı donutları pişirdik!
Dialogue: 0,0:03:17.91,0:03:18.97,Main,,0,0,0,,Ayrıca...
Dialogue: 0,0:03:18.97,0:03:24.83,Main,,0,0,0,,...dün Krema Bakanı Opera-sama'dan aldığımız\Nbirinci kalite kremayı da bir güzel çırpıp...
Dialogue: 0,0:03:26.85,0:03:31.19,Main,,0,0,0,,Hasır Şapka ile olan savaşımda\Nfazla Haki harcadım.
Dialogue: 0,0:03:32.63,0:03:36.24,Main,,0,0,0,,Kaçan tayfasının icabına bakmak için...
Dialogue: 0,0:03:36.81,0:03:39.53,Main,,0,0,0,,...enerjimi toplamam lazım.
Dialogue: 0,0:03:41.33,0:03:43.87,Main,,0,0,0,,Şeker bir güç kaynağıdır!
Dialogue: 0,0:03:48.97,0:03:50.37,Main,,0,0,0,,Hepsini tüketeceğim.
Dialogue: 0,0:04:30.37,0:04:31.72,Main,,0,0,0,,Şimdi tapınağa giriyorum.
Dialogue: 0,0:04:31.72,0:04:32.56,Main,,0,0,0,,Peki efendim!
Dialogue: 0,0:04:32.56,0:04:35.49,Main,,0,0,0,,Kimseleri içeri almayın.
Dialogue: 0,0:04:35.49,0:04:40.04,Main,,0,0,0,,Hiç olur mu efendim? Size kimse\Nrahatsızlık vermeyecek! Keyfinize bakın!
Dialogue: 0,0:05:10.57,0:05:13.08,Main,,0,0,0,,Son derece ihtiyatlı.
Dialogue: 0,0:05:15.39,0:05:20.44,Main,,0,0,0,,Efendimizi yemek yerken gören\Nkimse olmamıştır.
Dialogue: 0,0:05:20.44,0:05:25.37,Main,,0,0,0,,Acayip duyarlı biri. \Nİnsanlar yemek yerken tedbiri elden bırakır.
Dialogue: 0,0:05:25.37,0:05:29.03,Main,,0,0,0,,Lakin etrafımızdakilerle rahatımıza\Nbakabileceğimiz çay faslını dahi...
Dialogue: 0,0:05:29.03,0:05:35.37,Main,,0,0,0,,...odağını toparlayıp aheste aheste\Nbeslendiği bir vakte çeviriyor.
Dialogue: 0,0:05:37.32,0:05:39.91,Main,,0,0,0,,Big Mom Korsanları'nın belkemiğini oluşturan ve...
Dialogue: 0,0:05:39.94,0:05:42.17,Main,,0,0,0,,...bir milyonu geçen kelle ödüllü\Nsavaşçımızdan da bu beklenirdi!
Dialogue: 0,0:05:42.17,0:05:47.82,Main,,0,0,0,,Uyduruk, bir avuç mürettebatı olan\Nbir kaptan ile kıyaslanamaz!
Dialogue: 0,0:05:47.82,0:05:48.47,Main,,0,0,0,,Ha?
Dialogue: 0,0:05:49.17,0:05:50.22,Main,,0,0,0,,Ne oldu?
Dialogue: 0,0:05:50.61,0:05:52.44,Main,,0,0,0,,Şey orada değil miydi?
Dialogue: 0,0:05:52.44,0:05:53.22,Main,,0,0,0,,Neyi diyorsun?
Dialogue: 0,0:05:53.22,0:05:55.47,Main,,0,0,0,,Hasır Şapka'nın eli.
Dialogue: 0,0:05:58.48,0:05:59.97,Main,,0,0,0,,N- Ne?
Dialogue: 0,0:05:59.97,0:06:01.19,Main,,0,0,0,,Neler oluyor?
Dialogue: 0,0:06:01.99,0:06:03.42,Main,,0,0,0,,Mochi hareket ediyor!
Dialogue: 0,0:06:03.42,0:06:04.71,Main,,0,0,0,,O kadarını görüyoruz!
Dialogue: 0,0:06:04.71,0:06:05.72,Main,,0,0,0,,Neden hareket ediyor ama?
Dialogue: 0,0:06:05.72,0:06:07.12,Main,,0,0,0,,Nereden bileyim be?
Dialogue: 0,0:06:13.62,0:06:16.08,Main,,0,0,0,,Ne? Hasır Şapka!
Dialogue: 0,0:06:16.69,0:06:18.09,Main,,0,0,0,,Ölmemiş mi?
Dialogue: 0,0:06:18.09,0:06:19.95,Main,,0,0,0,,O devasa mochi'den\Nkurtulmayı nasıl başardı?
Dialogue: 0,0:06:19.95,0:06:22.05,Main,,0,0,0,,Mochi'yi yedim lan!
Dialogue: 0,0:06:22.05,0:06:23.02,Main,,0,0,0,,Ne?
Dialogue: 0,0:06:23.02,0:06:27.96,Main,,0,0,0,,Ne biçim korsan savaşları yapıyorsunuz siz lan?\NKazanmak için illa bir şeyler mi yemem lazım?
Dialogue: 0,0:06:27.96,0:06:30.73,Main,,0,0,0,,Senden başka o kadar tıkınabilen yok!
Dialogue: 0,0:06:32.88,0:06:35.45,Main,,0,0,0,,Hey! O herif nereye gitti?
Dialogue: 0,0:06:36.01,0:06:38.51,Main,,0,0,0,,Katakuri-sama'yı mı kastediyorsun?
Dialogue: 0,0:06:38.51,0:06:41.34,Main,,0,0,0,,Demin Ayna Dünyası'ndan çıktı!
Dialogue: 0,0:06:41.34,0:06:45.18,Main,,0,0,0,,Mühim bir işi var zira!\NNeyse, biz de gitsek mi artık?
Dialogue: 0,0:06:45.18,0:06:46.96,Main,,0,0,0,,Hoşça kal!
Dialogue: 0,0:06:48.66,0:06:51.56,Main,,0,0,0,,Orada güçlü birinin "sesini" hissediyorum!
Dialogue: 0,0:06:51.56,0:06:54.03,Main,,0,0,0,,{\i1}Sıçtık!\NGözlem Hakisi kullanıyor!
Dialogue: 0,0:06:54.03,0:06:55.69,Main,,0,0,0,,Donut yiyor.
Dialogue: 0,0:06:55.69,0:06:56.80,Note,,0,0,0,,- Burnunu çeker -
Dialogue: 0,0:06:57.37,0:06:58.82,Thoughts,,0,0,0,,{\i1}Gözlem Hakisi mi?
Dialogue: 0,0:06:58.82,0:07:00.86,Main,,0,0,0,,Yok be, iyi bi' koku alma\Nduyusu varmış o kadar.
Dialogue: 0,0:07:01.78,0:07:05.07,Main,,0,0,0,,Ağzına sıçtığım! \NKazandığını sanıp uzanıyordur şimdi!
Dialogue: 0,0:07:05.07,0:07:09.83,Main,,0,0,0,,Saçmalama lan! \NSenin gibi bir beyinsiz efendimizi anlayamaz!
Dialogue: 0,0:07:09.83,0:07:16.09,Main,,0,0,0,,Efendimiz şu an tapınakta\Nsavaş tanrısı ve kendisiyle konuşuyor!
Dialogue: 0,0:07:16.09,0:07:20.76,Main,,0,0,0,,Kutsal bir an yani.\NKendisini kimse rahatsız... edemez...
Dialogue: 0,0:07:32.24,0:07:33.69,Main,,0,0,0,,N- N'apıyor?
Dialogue: 0,0:07:33.69,0:07:35.65,Main,,0,0,0,,Nereye gidiyorsun lan?
Dialogue: 0,0:07:49.86,0:07:52.57,Main,,0,0,0,,Dallama tırsıp kaçtı işte!
Dialogue: 0,0:07:52.57,0:07:55.73,Main,,0,0,0,,Uyduruk, bir avuç mürettebatı olan\Nbir kaptandan ne beklersin ki?
Dialogue: 0,0:07:55.73,0:07:58.14,Main,,0,0,0,,Anca topuklamayı bilir!
Dialogue: 0,0:08:03.21,0:08:04.59,Main,,0,0,0,,Geri mi dönüyor?
Dialogue: 0,0:08:04.59,0:08:05.64,Main,,0,0,0,,Neden?
Dialogue: 0,0:08:06.34,0:08:08.35,Main,,0,0,0,,Yağlarımı yaktım!
Dialogue: 0,0:08:08.35,0:08:11.82,Main,,0,0,0,,Ha?\Nİnsan vücudu bunu yapabilir mi de?
Dialogue: 0,0:08:11.82,0:08:16.24,Main,,0,0,0,,Pekâlâ! Hazır ve nazırım! Başlayalım!
Dialogue: 0,0:08:16.24,0:08:17.78,Main,,0,0,0,,Yapma!
Dialogue: 0,0:08:18.11,0:08:19.70,Main,,0,0,0,,Gelme, gelme!
Dialogue: 0,0:08:19.70,0:08:22.03,Main,,0,0,0,,Tapınağa yaklaşma!
Dialogue: 0,0:08:24.16,0:08:26.21,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:08:29.96,0:08:32.55,Main,,0,0,0,,{\fad(150,150)}Elephant Gun!
Dialogue: 0,0:08:29.96,0:08:32.55,Attack,,0,0,0,,{\fad(150,150)}Fil Tüfeği
Dialogue: 0,0:08:38.14,0:08:41.98,Main,,0,0,0,,{\t(2800,3300,\1c&HFFFFFF&\3c&HFFFFFF&\4c&HFFFFFF&)}Katakuri-{\i1}sama{\i1}!{\i0} Affınıza sığınıyoruz!
Dialogue: 0,0:08:45.07,0:08:48.44,Thoughts,,0,0,0,,{\i1}Güzelim donutlar!
Dialogue: 0,0:08:48.44,0:08:51.67,Thoughts,,0,0,0,,{\i1}Enfes mi enfes donutlar!
Dialogue: 0,0:08:51.67,0:08:54.78,Thoughts,,0,0,0,,{\i1}İç kısmı da ayrı bi' leziz donutlar!
Dialogue: 0,0:08:54.78,0:08:59.26,Thoughts,,0,0,0,,{\i1}Bir başıma donut gömüyorum!\NSırt üstü uzanmış donut yiyorum!
Dialogue: 0,0:08:59.92,0:09:03.68,Thoughts,,0,0,0,,{\i1}Mahrem bir zevk, suçluluk duygusu ve...
Dialogue: 0,0:09:03.68,0:09:05.74,Thoughts,,0,0,0,,{\i1}Donutlar!{\i0}
Dialogue: 0,0:09:05.74,0:09:08.30,Thoughts,,0,0,0,,{\i1}Keyfime bakıyorum.
Dialogue: 0,0:09:08.30,0:09:12.65,Thoughts,,0,0,0,,{\i1}Donutlar, donutlar... Güzelim donutlar!
Dialogue: 0,0:09:12.65,0:09:15.27,Thoughts,,0,0,0,,{\i1}Öyle enfessin ki donut!
Dialogue: 0,0:09:34.28,0:09:38.56,Flashbacks,,0,0,0,,{\i1}Katakuri abim bir süper insandır!
Dialogue: 0,0:09:38.56,0:09:42.17,Flashbacks,,0,0,0,,Hayatı boyunca sırtı yere değmedi diyorum!
Dialogue: 0,0:09:42.17,0:09:44.98,Flashbacks,,0,0,0,,Zemine tepki olarak doğmuş bir adam!
Dialogue: 0,0:09:44.98,0:09:47.11,Flashbacks,,0,0,0,,Her daim asalet saçar!
Dialogue: 0,0:09:47.11,0:09:49.57,Flashbacks,,0,0,0,,Soğukkanlı ve kudretlidir!
Dialogue: 0,0:09:49.57,0:09:51.87,Flashbacks,,0,0,0,,Her anlamda kusursuz bir insan!
Dialogue: 0,0:09:53.48,0:09:57.91,Flashbacks,,0,0,0,,{\i1}Katakuri abimiz böyle biridir işte!
Dialogue: 0,0:10:06.01,0:10:10.11,Main,,0,0,0,,Beni yemek yerken gördün!
Dialogue: 0,0:10:11.29,0:10:14.23,Main,,0,0,0,,Savaşımız daha bitmedi!
Dialogue: 0,0:10:31.66,0:10:32.51,Main,,0,0,0,,Ne?
Dialogue: 0,0:10:43.69,0:10:46.15,Main,,0,0,0,,M- Merhamet edin!
Dialogue: 0,0:10:47.01,0:10:50.21,Main,,0,0,0,,Hiçbir şey görmedim!\NHem de hiçbir şey görmedim!
Dialogue: 0,0:10:50.21,0:10:54.61,Main,,0,0,0,,Kimseye söylemem!\NAğzımı yırtsalar söylemem!
Dialogue: 0,0:10:54.61,0:10:57.72,Main,,0,0,0,,Ağzımla ilgili bir şey mi söyledin?
Dialogue: 0,0:10:58.06,0:10:59.19,Main,,0,0,0,,{\fad(150,150)}Kaku Mochi!
Dialogue: 0,0:10:58.06,0:10:59.19,Attack,,0,0,0,,{\fad(150,150)}Köşeli Mochi
Dialogue: 0,0:10:59.19,0:11:01.17,Main,,0,0,0,,Yapmayın!!
Dialogue: 0,0:11:09.44,0:11:13.72,Main,,0,0,0,,Hayattasın demek! Geberdiğini görene\Ndek beklemediğim için af buyur!
Dialogue: 0,0:11:14.55,0:11:16.73,Main,,0,0,0,,Canıma tak etti artık!
Dialogue: 0,0:11:31.40,0:11:33.36,Main,,0,0,0,,Elim!
Dialogue: 0,0:11:35.54,0:11:38.16,Main,,0,0,0,,Kullandığın Silahlanma Hakisi'nin de\Nötesi vardır!
Dialogue: 0,0:11:38.90,0:11:42.22,Main,,0,0,0,,Benimle aşık atabileceğini sanma!
Dialogue: 0,0:11:42.22,0:11:45.17,Main,,0,0,0,,Benim için\Nbir solucandan fazlası değilsin!
Dialogue: 0,0:12:21.22,0:12:24.72,Main,,0,0,0,,Gerçek yüzümü görenler...
Dialogue: 0,0:12:25.30,0:12:27.43,Main,,0,0,0,,...ölmek zorundadır!
Dialogue: 0,0:12:30.02,0:12:30.73,Main,,0,0,0,,Sıçayım!
Dialogue: 0,0:12:49.29,0:12:52.04,Main,,0,0,0,,Savuşturmadı, tekmeyi yedi!
Dialogue: 0,0:12:53.86,0:12:54.65,Main,,0,0,0,,Neden ama?
Dialogue: 0,0:12:56.92,0:12:59.34,Main,,0,0,0,,Tekme yediysem n'olmuş lan?
Dialogue: 0,0:13:05.55,0:13:07.22,Main,,0,0,0,,Kolayca savuşturabiliyorum!
Dialogue: 0,0:13:11.99,0:13:13.77,Main,,0,0,0,,Peşi sıra kaçtığım yöne saldırmadı!
Dialogue: 0,0:13:41.85,0:13:43.20,Main,,0,0,0,,Yeteneğini...
Dialogue: 0,0:13:44.30,0:13:46.01,Main,,0,0,0,,...anlamaya başlıyorum.
Dialogue: 0,0:13:46.01,0:13:48.39,Main,,0,0,0,,Ha? Ne anlamışsın bakayım?
Dialogue: 0,0:13:48.86,0:13:53.60,Main,,0,0,0,,Dilimde tüy bitti!\NYeteneğin bana denk değil!
Dialogue: 0,0:13:56.82,0:13:58.19,Main,,0,0,0,,Saldırıyorum!
Dialogue: 0,0:14:03.04,0:14:07.20,Main,,0,0,0,,Bu sefer son nefesini verişini izleyeceğim!
Dialogue: 0,0:14:14.01,0:14:15.60,Main,,0,0,0,,{\fad(150,150)}Gear Fourth!
Dialogue: 0,0:14:14.01,0:14:15.60,Note,,0,0,0,,{\fad(150,150)}Dördüncü Vites
Dialogue: 0,0:14:20.18,0:14:21.93,Main,,0,0,0,,{\fad(150,150)}Amadare Mochi!
Dialogue: 0,0:14:20.18,0:14:21.93,Attack,,0,0,0,,{\fad(150,150)}Mochi Sağanağı
Dialogue: 0,0:14:39.29,0:14:40.69,Main,,0,0,0,,{\fad(150,150)}Boundman!
Dialogue: 0,0:14:39.29,0:14:40.69,Attack,,0,0,0,,{\fad(150,150)}Seken Adam
Dialogue: 0,0:14:42.14,0:14:45.59,Main,,0,0,0,,Güçlü olduğun bir gerçek\Nama yenilmez değilsin!
Dialogue: 0,0:14:46.08,0:14:49.41,Main,,0,0,0,,Hadi lan oradan!
Dialogue: 0,0:15:07.67,0:15:10.01,Main,,0,0,0,,Ezil!
Dialogue: 0,0:15:25.86,0:15:27.82,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:15:30.78,0:15:33.16,Main,,0,0,0,,{\fad(150,150)}Kong Gun!
Dialogue: 0,0:15:30.78,0:15:33.16,Attack,,0,0,0,,{\fad(150,150)}Kong Tüfeği
Dialogue: 0,0:15:59.20,0:16:01.38,Main,,0,0,0,,Yenilmez olduğunu sanmıştım!
Dialogue: 0,0:16:07.81,0:16:10.77,Main,,0,0,0,,Silahlanma Hakisi'yle rakibime\Nsağlam bir darbe indirebilmeliydim zira!
Dialogue: 0,0:16:13.82,0:16:17.07,Main,,0,0,0,,Logia kullanıcıları da bir istisna\Nolmamalıydı oysa!
Dialogue: 0,0:16:26.79,0:16:29.50,Main,,0,0,0,,Gel gör ki saldırılarım\Nvücudundan geçip gidiyordu!
Dialogue: 0,0:16:33.29,0:16:35.34,Main,,0,0,0,,Yanılmışım!
Dialogue: 0,0:16:36.65,0:16:38.30,Main,,0,0,0,,Sen de...
Dialogue: 0,0:16:39.66,0:16:41.38,Main,,0,0,0,,...darbe alabilirsin!
Dialogue: 0,0:17:00.18,0:17:02.82,Main,,0,0,0,,Çeliği aratmayan Silahlanma Gardını da...
Dialogue: 0,0:17:08.88,0:17:11.79,Main,,0,0,0,,...Dördüncü Vites ile yarıp geçebilirim!
Dialogue: 0,0:17:15.08,0:17:17.21,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:17:19.71,0:17:21.42,Main,,0,0,0,,{\fad(150,150)}Culverin!
Dialogue: 0,0:17:19.71,0:17:21.42,Attack,,0,0,0,,{\fad(150,150)}Piton
Dialogue: 0,0:17:26.63,0:17:29.84,Main,,0,0,0,,Etkileyici olan mochi yeteneğin falan değil!
Dialogue: 0,0:17:31.17,0:17:33.64,Main,,0,0,0,,Asıl Gözlem Haki'n, değil mi?
Dialogue: 0,0:18:09.02,0:18:11.01,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:18:11.01,0:18:14.68,Main,,0,0,0,,{\fad(150,150)}Rhino Schneider!
Dialogue: 0,0:18:11.01,0:18:14.68,Attack,,0,0,0,,{\fad(150,150)}Gergedan Obüsü
Dialogue: 0,0:18:37.51,0:18:39.91,Flashbacks,,0,0,0,,Katakuri abim...
Dialogue: 0,0:18:40.29,0:18:45.92,Flashbacks,,0,0,0,,{\i1}...sırtı bir kez dahi\Nyere değmemiş bir süper insandır!
Dialogue: 0,0:18:56.59,0:18:58.56,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:18:59.77,0:19:02.48,Main,,0,0,0,,{\fad(150,150)}Kong Organ
Dialogue: 0,0:18:59.77,0:19:02.48,Attack,,0,0,0,,{\fad(150,150)}Kong Çığlık Topu!
Dialogue: 0,0:19:12.40,0:19:14.20,Main,,0,0,0,,Durumu çözmüş olmandan...
Dialogue: 0,0:19:15.36,0:19:16.83,Main,,0,0,0,,...etkilendim sadece.
Dialogue: 0,0:19:18.79,0:19:24.36,Main,,0,0,0,,Dediğin gibi, şeklimi değiştirerek\Netkili bir şekilde savuşturuyordum.
Dialogue: 0,0:19:25.48,0:19:28.18,Main,,0,0,0,,Haki'm ile geleceği görerek\Nbunu yapmak mümkün.
Dialogue: 0,0:19:29.65,0:19:32.59,Main,,0,0,0,,Az önce sakinliğimi biraz yitirdiğimden...
Dialogue: 0,0:19:34.35,0:19:38.00,Main,,0,0,0,,...sana saldırma fırsatı vermiş oldum.
Dialogue: 0,0:19:38.00,0:19:43.03,Main,,0,0,0,,Sakinliğini koruyamadığında\NGözlem Hakisi aktifleşmez zira.
Dialogue: 0,0:19:47.00,0:19:49.77,Main,,0,0,0,,En son kaç yıl evvel\Nyumruk yemiştim acaba?
Dialogue: 0,0:19:59.11,0:20:03.79,Main,,0,0,0,,Kardeşim Cracker'in yenilme nedenini...
Dialogue: 0,0:20:05.89,0:20:08.21,Main,,0,0,0,,...anladım gibi.
Dialogue: 0,0:20:08.81,0:20:10.68,Main,,0,0,0,,Bisküvi herifi mi diyorsun?
Dialogue: 0,0:20:11.24,0:20:13.44,Main,,0,0,0,,{\fad(150,150)}Musou Donuts!
Dialogue: 0,0:20:11.24,0:20:13.44,Attack,,0,0,0,,{\fad(150,150)}Emsalsiz Donutlar
Dialogue: 0,0:20:29.45,0:20:33.00,Main,,0,0,0,,Mochi'den değiller mi? Hay böyle işin!
Dialogue: 0,0:20:33.00,0:20:33.71,Main,,0,0,0,,{\fad(150,150)}Rhino...
Dialogue: 0,0:20:33.00,0:20:33.71,Attack,,0,0,0,,{\fad(150,150)}Gergedan...
Dialogue: 0,0:20:52.11,0:20:54.24,Main,,0,0,0,,{\fad(150,150)}Chikara Mochi!
Dialogue: 0,0:20:52.11,0:20:54.24,Attack,,0,0,0,,{\fad(150,150)}Kudretli Mochi
Dialogue: 0,0:21:34.22,0:21:36.51,Main,,0,0,0,,En ufak bir açık daha vermeyeceğim.
Dialogue: 0,0:21:36.99,0:21:39.35,Main,,0,0,0,,Başladığımız yere döndük şimdi.
Dialogue: 0,0:21:39.60,0:21:43.10,Captions,,0,30,155,,{\fad(300,0)}Kakao Adası
Dialogue: 0,0:21:43.41,0:21:47.65,Main,,0,0,0,,Lütfen kapıyı açın!
Dialogue: 0,0:21:49.70,0:21:53.45,Captions,,0,1015,320,,{\fad(550,0)}Şeker Fabrikası
Dialogue: 0,0:21:53.45,0:21:58.13,Main,,0,0,0,,Bunu yapamayız Pound-{\i1}san{\i0}!\Nİnat etmeden geri çekilin lütfen.
Dialogue: 0,0:21:58.13,0:22:00.39,Main,,0,0,0,,Nedenmiş?
Dialogue: 0,0:22:00.39,0:22:02.63,Main,,0,0,0,,Pudding-{\i1}sama{\i0}'nın kesin talimatı var.
Dialogue: 0,0:22:02.63,0:22:06.93,Main,,0,0,0,,Bir dakikalığına da olsa\NChiffon'u görmek istiyorum sadece!
Dialogue: 0,0:22:06.93,0:22:08.71,Main,,0,0,0,,O adam da kim?
Dialogue: 0,0:22:08.71,0:22:11.44,Main,,0,0,0,,Mama'nın 25'inci eski kocası.
Dialogue: 0,0:22:11.44,0:22:12.93,Main,,0,0,0,,Hadi ya!
Dialogue: 0,0:22:25.55,0:22:28.75,Thoughts,,0,0,0,,Görür görmez tanıdım!
Dialogue: 0,0:22:33.44,0:22:39.50,Thoughts,,0,0,0,,Chiffon doğduğu günden bu yana\Nzerre değişmedi.
Dialogue: 0,0:22:44.50,0:22:47.27,Thoughts,,0,0,0,,Her zamanki gibi şeker mi şeker!
Dialogue: 0,0:22:47.27,0:22:52.58,Thoughts,,0,0,0,,Bir dakikalığına bile olsa\Nonunla konuşmak istiyorum!
Dialogue: 0,0:22:56.31,0:22:59.56,Main,,0,0,0,,Hey! Hey!
Dialogue: 0,0:23:02.36,0:23:04.32,Main,,0,0,0,,Dışarıdan bir gürültü gelmiyor mu?
Dialogue: 0,0:23:06.06,0:23:11.16,Main,,0,0,0,,Biri bağırıyor sanki. Merak etmeyin,\Nkimseyi içeri almazlar!
Dialogue: 0,0:23:11.67,0:23:12.99,Main,,0,0,0,,{\i1}Ne oldu Pudding?{\i0}
Dialogue: 0,0:23:13.51,0:23:16.93,Main,,0,0,0,,Yok bir şey Brûlée abla, dinliyorum.
Dialogue: 0,0:23:17.27,0:23:20.21,Main,,0,0,0,,{\i1}Yani bu gece saat 01.00'da...
Dialogue: 0,0:23:20.21,0:23:27.09,Main,,0,0,0,,{\i1}...izini kaybettiğimiz Hasır Şapkalar'ın gemisi \Nsizin bulunduğunuz Kakao Adası'na varacak!
Dialogue: 0,0:23:27.09,0:23:30.07,Thoughts,,0,0,0,,{\i1}Buraya mı? Gece 01.00'da mı?
Dialogue: 0,0:23:34.60,0:23:38.19,Thoughts,,0,0,0,,{\i1}Planımız Nami-sanlar ile denizde\Nbir araya gelip düğün pastasını...
Dialogue: 0,0:23:38.19,0:23:39.73,Thoughts,,0,0,0,,{\i1}...teslim etmekti oysa.
Dialogue: 0,0:23:43.69,0:23:46.53,Main,,0,0,0,,Hasır Şapkalar'ın gemisi\Nneden Kakao Adası'na geliyor ki?
Dialogue: 0,0:23:47.36,0:23:55.49,Main,,0,0,0,,{\i1}Başıboş kaptanları Hasır Şapka Luffy ile\Norada buluşacaklar da ondan!
Dialogue: 0,0:24:00.24,0:24:05.54,Thoughts,,0,0,0,,{\i1}Demek öyle. Vaziyet hiç iyi değil.\NBig Momlar planımızı öğrenmiş!
Dialogue: 0,0:24:05.54,0:24:07.57,Main,,0,0,0,,Gerçi...
Dialogue: 0,0:24:09.53,0:24:14.14,Main,,0,0,0,,Hasır Şapka Luffy, \NKakao Adası'na varmayı başaramayabilir!
Dialogue: 0,0:24:15.45,0:24:16.93,Main,,0,0,0,,Nasıl yani?
Dialogue: 0,0:24:16.93,0:24:23.52,Main,,0,0,0,,Kendini bi' bok sandığından Katakuri abimize\Nbire bir düelloda meydan okudu!
Dialogue: 0,0:24:34.60,0:24:39.49,Main,,0,0,0,,Bu yüzden hiç şüphesiz\Ngeberip gidecek! Beter olsun!
Dialogue: 0,0:24:43.54,0:24:45.52,Main,,0,0,0,,Bir, iki!
Dialogue: 0,0:24:48.91,0:24:50.45,Main,,0,0,0,,{\i1}Şu an saat 16.00, değil mi?
Dialogue: 0,0:24:51.51,0:24:54.23,Main,,0,0,0,,{\i1}Yani 9 saat sonra...
Dialogue: 0,0:24:54.23,0:24:59.72,Main,,0,0,0,,{\i1}...Hasır Şapkalar adaya varacak ve hiçbir\Nzaman gelmeyecek kaptanlarını bekleyecek.
Dialogue: 0,0:25:01.83,0:25:07.19,Main,,0,0,0,,{\i1}Peşlerindeki Açlık Krizi nükseden Mama ile\NPeros abi de adaya varacak.
Dialogue: 0,0:25:07.19,0:25:10.46,Main,,0,0,0,,Büyük buluşma!
Dialogue: 0,0:25:10.46,0:25:14.49,Main,,0,0,0,,{\i1}Bu durumda çuvallama lüksümüz yok!
Dialogue: 0,0:25:14.49,0:25:17.22,Main,,0,0,0,,{\i1}Mama'yı sana bırakıyoruz Pudding!{\i0}
Dialogue: 0,0:25:18.26,0:25:20.50,Main,,0,0,0,,{\i1}Tüm umudumuz sensin!
Dialogue: 0,0:25:20.50,0:25:22.98,Main,,0,0,0,,Hiç merak etme Brûlée abla!
Dialogue: 0,0:25:22.98,0:25:27.04,Main,,0,0,0,,En leziz düğün pastasını pişirip\NMama'yı durduracağım!
Dialogue: 0,0:25:29.78,0:25:31.76,Main,,0,0,0,,{\i1}İple çekiyorum.
Dialogue: 0,0:25:32.42,0:25:33.71,Main,,0,0,0,,{\i1}Sahi, unutmadan...
Dialogue: 0,0:25:34.51,0:25:38.51,Main,,0,0,0,,{\i1}...Hasır Şapkalar \Nerkenden gelseler bile tasalanma.
Dialogue: 0,0:25:39.65,0:25:43.93,Main,,0,0,0,,{\i1}Adaya az önce intikal eden\NOven abinin adamları halleder.
Dialogue: 0,0:25:43.93,0:25:47.85,Main,,0,0,0,,Ne? Oven abi buraya mı geldi?
Dialogue: 0,0:25:53.86,0:25:55.07,Main,,0,0,0,,Oven-sama gelmiş!
Dialogue: 0,0:25:55.07,0:25:56.15,Main,,0,0,0,,Oven-{\i1}sama{\i}!
Dialogue: 0,0:25:56.36,0:26:02.37,Captions,,0,0,230,,{\fad(400,500)}Charlotte Oven - Charlotte Ailesi'nin 4. Oğlu\NPişirme Bakanı
Dialogue: 0,0:25:56.46,0:25:59.66,Main,,0,0,1,,Ne demek fabrikaya giremem lan?
Dialogue: 0,0:25:59.66,0:26:03.13,Main,,0,0,1,,Pudding-sama öyle buyurdu da.
Dialogue: 0,0:26:03.13,0:26:04.34,Main,,0,0,0,,Ben de mi giremezmişim?
Dialogue: 0,0:26:04.34,0:26:05.77,Main,,0,0,0,,Kimseyi almayın dedi efendim.
Dialogue: 0,0:26:05.77,0:26:09.00,Main,,0,0,0,,Kardeşim öyle istediyse girmeyiz.
Dialogue: 0,0:26:09.00,0:26:13.07,Main,,0,0,0,,Peki fabrikanın önünde\Nniye yaygara kopmuş?
Dialogue: 0,0:26:13.07,0:26:15.67,Main,,0,0,0,,Ne? Şeyden ya...
Dialogue: 0,0:26:16.36,0:26:19.55,Main,,0,0,0,,Hey! Chiffon!
Dialogue: 0,0:26:20.06,0:26:21.52,Main,,0,0,0,,Bu herif...
Dialogue: 0,0:26:30.98,0:26:34.53,Main,,0,0,0,,C- Canımı yakma!
Dialogue: 0,0:26:34.53,0:26:36.65,Main,,0,0,0,,Konuşma lan sinsi herif!
Dialogue: 0,0:26:36.65,0:26:40.70,Main,,0,0,0,,B- Beni hatırlamıyor musun Oven-kun?
Dialogue: 0,0:26:42.24,0:26:45.65,Main,,0,0,0,,Hatırlamaz olur muyum, üvey babamdın.
Dialogue: 0,0:26:45.65,0:26:51.06,Main,,0,0,0,,H- Hatırlamana sevindim.
Dialogue: 0,0:26:51.06,0:26:55.55,Main,,0,0,0,,Bir zamanlar üvey babandım hani.
Dialogue: 0,0:26:59.40,0:27:01.43,Main,,0,0,0,,Bu yüzden senden kurtulmam lazım.
Dialogue: 0,0:27:01.43,0:27:02.55,Main,,0,0,0,,Ne?
Dialogue: 0,0:27:04.70,0:27:07.29,Main,,0,0,0,,Dışarıda yaygarayı koparan kim acaba?
Dialogue: 0,0:27:07.70,0:27:09.17,Main,,0,0,0,,Kafana mı takıldı?
Dialogue: 0,0:27:09.17,0:27:11.71,Main,,0,0,0,,Sanji-{\i1}san{\i0}! Sen de duydun mu?
Dialogue: 0,0:27:11.71,0:27:12.61,Main,,0,0,0,,Duydum.
Dialogue: 0,0:27:12.61,0:27:14.51,Main,,0,0,0,,Luffy-{\i1}kun{\i0}'un başı belada!
Dialogue: 0,0:27:14.51,0:27:15.59,Main,,0,0,0,,Öyle gibi.
Dialogue: 0,0:27:15.59,0:27:18.83,Main,,0,0,0,,Katakuri abiye bire bir düelloda\Nmeydan okuduğuna inanamıyorum!
Dialogue: 0,0:27:18.83,0:27:21.32,Main,,0,0,0,,Pervasızlığın da bir sınırı vardır!
Dialogue: 0,0:27:21.32,0:27:22.22,Main,,0,0,0,,Kesinlikle.
Dialogue: 0,0:27:22.22,0:27:26.65,Main,,0,0,0,,Katakuri abi bir süper insandır!\NKelle ödülü bir milyarın da üstündedir!
Dialogue: 0,0:27:26.65,0:27:30.66,Main,,0,0,0,,Şimdiye dek hiç yenilgi yüzü görmemiştir! \NN'apacağız şimdi?
Dialogue: 0,0:27:31.67,0:27:33.24,Main,,0,0,0,,Öyleyse bugün...
Dialogue: 0,0:27:35.01,0:27:37.27,Main,,0,0,0,,...ilk yenilgisini tadacak.
Dialogue: 0,0:27:38.20,0:27:40.84,Main,,0,0,0,,Şu an bizim üzerimize düşen...
Dialogue: 0,0:27:40.84,0:27:43.77,Main,,0,0,0,,...en lezzetli pastayı pişirmektir, değil mi?
Dialogue: 0,0:27:48.66,0:27:51.18,Main,,0,0,0,,Şapşal arkadaşın...
Dialogue: 0,0:27:51.18,0:27:55.87,Main,,0,0,0,,...Katakuri abimin ellerinde\Ndarmaduman olacak!
Dialogue: 0,0:27:56.35,0:27:57.37,Main,,0,0,0,,Sanji!
Dialogue: 0,0:27:58.85,0:27:59.98,Main,,0,0,0,,Pudding-{\i1}chan{\i}.
Dialogue: 0,0:28:00.66,0:28:04.05,Main,,0,0,0,,Merak etme. Pastayı pişirmeye bakalım.
Dialogue: 0,0:28:04.65,0:28:08.50,Main,,0,0,0,,İlk birlikte çalışmamız oluyor bu, değil mi?
Dialogue: 0,0:28:13.53,0:28:14.22,Main,,0,0,0,,...{\i1}san{\i}!
Dialogue: 0,0:28:14.22,0:28:17.05,Main,,0,0,0,,Eyvahlar olsun!\NPudding-{\i1}sama{\i0}'dan buharlar çıkıyor!
Dialogue: 0,0:28:17.05,0:28:18.38,Main,,0,0,0,,Onu da mı fırına sürdüler ki?
Dialogue: 0,0:28:18.38,0:28:19.26,Main,,0,0,0,,Yok devenin nalı!
Dialogue: 0,0:28:21.70,0:28:24.49,Main,,0,0,0,,Pudding-{\i1}sama{\i}!
Dialogue: 0,0:28:26.66,0:28:30.04,Captions,,0,0,235,,{\fad(400,0)}Denizde bir yerde - Sunny
Dialogue: 0,0:28:30.04,0:28:32.38,Main,,0,0,0,,Peşimizde kimseler yok.
Dialogue: 0,0:28:32.38,0:28:38.01,Main,,0,0,0,,Çok tuhaf. Bu bölgedeyken\Nilla birileri kuyruğumuzda olur!
Dialogue: 0,0:28:38.01,0:28:39.80,Main,,0,0,0,,Neler dönüyor dersin?
Dialogue: 0,0:28:39.80,0:28:41.68,Main,,0,0,0,,Tuzak olmalı!
Dialogue: 0,0:28:41.68,0:28:46.22,Main,,0,0,0,,Merak etmeyin! \NBir saniyeliğine dahi gözümüzü kırpmayacağız!
Dialogue: 0,0:28:46.22,0:28:50.74,Main,,0,0,0,,Sahi, Aladdinler güvende midir acaba?
Dialogue: 0,0:28:51.39,0:28:54.38,Main,,0,0,0,,Umarım bir pürüz çıkmadan ayrılmışlardır.
Dialogue: 0,0:28:54.38,0:28:56.25,Main,,0,0,0,,Ne?
Dialogue: 0,0:28:56.25,0:29:01.46,Main,,0,0,0,,Mama, Kuru Yemiş Adası'nı mı talan ediyor?\NNereden çıktı ki şimdi, Peros abi?
Dialogue: 0,0:29:01.46,0:29:03.13,Main,,0,0,0,,{\i1}Nasıl desem...
Dialogue: 0,0:29:03.13,0:29:06.14,Main,,0,0,0,,Mont d'Or-{\i1}sama{\i0}! \NBir sorunumuz var efendim!
Dialogue: 0,0:29:06.14,0:29:10.27,Main,,0,0,0,,Yine n'oldu lan? \NBoğazımıza kadar boka batmışız zaten!
Dialogue: 0,0:29:10.71,0:29:14.64,Main,,0,0,0,,Denizi araştırmamız nihayetinde...\NAcı bir gerçekle karşılaştık...
Dialogue: 0,0:29:17.39,0:29:18.69,Main,,0,0,0,,Şöyle ki...
Dialogue: 0,0:29:18.69,0:29:21.15,Main,,0,0,0,,Ne?
Dialogue: 0,0:29:18.69,0:29:21.15,Secondary,,0,0,0,,Ü ürü!
Dialogue: 0,0:29:21.15,0:29:25.07,Main,,0,0,0,,Mıntıka Salyangozları'ndan hiç eser yok mu?
Dialogue: 0,0:29:25.07,0:29:26.69,Main,,0,0,0,,Neden ama?
Dialogue: 0,0:29:26.69,0:29:28.57,Main,,0,0,0,,Öldüler mi ki-jour?
Dialogue: 0,0:29:28.57,0:29:30.33,Main,,0,0,0,,Hiçbiri mi durmuyor?
Dialogue: 0,0:29:30.87,0:29:31.95,Main,,0,0,0,,Bilmiyorum ki.
Dialogue: 0,0:29:31.95,0:29:36.93,Main,,0,0,0,,On binlerce salyangoz vardı!\NBirden nasıl sırra kadem basarlar lan!
Dialogue: 0,0:29:37.79,0:29:39.51,Main,,0,0,0,,K- Kaçırılmış olmasınlar?
Dialogue: 0,0:29:39.51,0:29:41.32,Main,,0,0,0,,Kim kaçırsın lan, salak!
Dialogue: 0,0:29:41.32,0:29:44.68,Main,,0,0,0,,Bu durumda düşman gemileri\Nkafasına göre kol gezer!
Dialogue: 0,0:29:44.68,0:29:46.05,Main,,0,0,0,,Bir hâl çaresine bakın!
Dialogue: 0,0:29:46.89,0:29:48.91,Main,,0,0,0,,N- Ne yapalım efendim?
Dialogue: 0,0:29:48.91,0:29:52.86,Main,,0,0,0,,Ortadan kaybolma sebeplerini\Nbulun lan işte! Çabuk!
Dialogue: 0,0:29:52.86,0:29:54.24,Main,,0,0,0,,E- Emredersiniz!
