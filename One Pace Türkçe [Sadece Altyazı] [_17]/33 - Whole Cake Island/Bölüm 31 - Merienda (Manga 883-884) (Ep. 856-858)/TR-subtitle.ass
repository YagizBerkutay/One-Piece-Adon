Dialogue: 0,0:30:10.24,0:30:14.75,Lyrics,,0,0,0,karaoke,♪ Haydi, birlikte şarkı söyleyelim! ♪
Dialogue: 0,0:30:14.75,0:30:19.42,Lyrics,,0,0,0,karaoke,♪ Deniz Salyangozları! ♪
Dialogue: 0,0:30:19.42,0:30:24.09,Lyrics,,0,0,0,karaoke,♪ Çalışmayı bırakınca...
Dialogue: 0,0:30:24.09,0:30:28.64,Lyrics,,0,0,0,karaoke,...dünya güzelleşir! ♪
Dialogue: 0,0:30:28.64,0:30:30.76,Lyrics,,0,0,0,karaoke,♪ Bekçilik mi? Olmaz! ♪
Dialogue: 0,0:30:30.76,0:30:33.18,Lyrics,,0,0,0,karaoke,♪ Rapor vermek mi? Yasakladım gitti! ♪
Dialogue: 0,0:30:33.18,0:30:36.31,Lyrics,,0,0,0,karaoke,♪ Ama şarkı...
Dialogue: 0,0:30:36.31,0:30:38.55,Lyrics,,0,0,0,karaoke,...söyleyebilirsiniz! ♪
Dialogue: 0,0:30:45.84,0:30:50.08,Lyrics,,0,0,0,karaoke,♪ Evet, çalışamazsınız! ♪
Dialogue: 0,0:30:54.99,0:31:02.13,Lyrics,,0,0,0,karaoke,♪ İzin gününün tüm anlamı kaybolur yoksa! ♪
