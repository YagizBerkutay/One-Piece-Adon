Dialogue: 0,0:01:34.36,0:01:39.03,Title,,0,0,0,,{\pos(642,485)}{\fad(750,800)}Luffy ve Big Mom
Dialogue: 0,0:01:35.07,0:01:39.07,Captions,,0,0,0,,{\fad(500,0)}"Ayna Dünyası" – Brûlée'nin Evi
Dialogue: 0,0:01:47.42,0:01:51.95,Main,,0,0,0,,Choniki, yardım et!\NÇok sıcak!
Dialogue: 0,0:01:51.95,0:01:55.46,Main,,0,0,0,,Yakınmayı kes artık, velet!
Dialogue: 0,0:01:55.46,0:01:57.76,Main,,0,0,0,,İnsanları yemem ama...
Dialogue: 0,0:01:58.59,0:02:01.60,Main,,0,0,0,,...Minkler yenebildiğinden tadına bakmalıyım.
Dialogue: 0,0:02:01.60,0:02:04.72,Main,,0,0,0,,Yemeyin beni!\NTadım hiç güzel değildir!
Dialogue: 0,0:02:04.72,0:02:07.28,Main,,0,0,0,,Carrot'u bırak Brûlée!
Dialogue: 0,0:02:07.28,0:02:11.40,Main,,0,0,0,,Gerçek tavşan değil bir kere!\NHerhâlde tadı kötü olacaktır!
Dialogue: 0,0:02:11.40,0:02:13.50,Main,,0,0,0,,– Ne? Öyle mi?
Dialogue: 0,0:02:11.40,0:02:12.68,Secondary,,0,0,0,,– Evet!
Dialogue: 0,0:02:13.50,0:02:16.44,Main,,0,0,0,,– O zaman hiç tatmayayım.
Dialogue: 0,0:02:12.68,0:02:16.44,Secondary,,0,0,0,,– Etim kart olur benim, kötü de kokar! Kusarsınız!
Dialogue: 0,0:02:18.63,0:02:23.74,Main,,0,0,0,,Kızı bırakacak değilim.\NKes sesini ucube ren geyiği!
Dialogue: 0,0:02:23.74,0:02:27.30,Main,,0,0,0,,Mama'nın tuhaf yaratık koleksiyonunun\Nbir parçası olacaksın!
Dialogue: 0,0:02:27.30,0:02:30.00,Main,,0,0,0,,T- Tuhaf yaratık koleksiyonu mu?
Dialogue: 0,0:02:30.00,0:02:34.58,Main,,0,0,0,,Aynen öyle. O yüzden usulca otur.
Dialogue: 0,0:02:42.47,0:02:46.33,Thoughts,,0,0,0,,Tamamdır!\NBuraya kadar idare edebildik.
Dialogue: 0,0:02:47.31,0:02:49.74,Thoughts,,0,0,0,,Ağırlık Güçlendirmesi formundayken\Nbeni bağlamalarını sağlayacağım...
Dialogue: 0,0:02:49.74,0:02:53.53,Thoughts,,0,0,0,,...böylece dönüşüm geçirince zincirlerden\Nanında kurtulmuş olacağım.
Dialogue: 0,0:02:53.53,0:02:57.94,Main,,0,0,0,,Chopper'a yük oluyorum.\NPedro bana fırça atacak!
Dialogue: 0,0:02:57.94,0:03:03.94,Thoughts,,0,0,0,,Canavar Güçlendirmesi'ni kullandığımdan\Nbu yana altı saat geçtiğinden onu da kullanabilirim!
Dialogue: 0,0:03:22.59,0:03:24.39,Main,,0,0,0,,Choniki!
Dialogue: 0,0:03:24.39,0:03:26.14,Thoughts,,0,0,0,,{\i1}Fırsat doğdu!{\i0}
Dialogue: 0,0:03:28.56,0:03:31.44,Captions,,0,0,0,,{\fad(350,400)\pos(1153,420)}Whole Cake\NAdası
Dialogue: 0,0:03:31.48,0:03:34.02,Captions,,0,0,0,,{\fad(350,350)}Başkent, Tatlı Şehir
Dialogue: 0,0:03:36.44,0:03:41.45,Captions,,0,0,0,,{\fad(500,0)}Whole Cake Şatosu Kütüphanesi
Dialogue: 0,0:03:42.04,0:03:44.08,Main,,0,0,0,,Buldum.
Dialogue: 0,0:03:46.71,0:03:50.80,Main,,0,0,0,,Bir kitabın içinde\Nuçsuz bucaksız dünyalar vardır.
Dialogue: 0,0:03:50.80,0:03:56.25,Main,,0,0,0,,Bakın. İnsan yiyen, son derece nadir\Ninsan yüzlü bir aslan!
Dialogue: 0,0:03:57.04,0:03:58.76,Main,,0,0,0,,"Manticore."
Dialogue: 0,0:03:58.76,0:04:04.96,Main,,0,0,0,,İki yıl evvel Karasakal baskını sırasında\NImpel Down'dan kaçan ucube hayvan.
Dialogue: 0,0:04:04.96,0:04:06.80,Main,,0,0,0,,Peştamal, peştamal!
Dialogue: 0,0:04:06.80,0:04:07.66,Main,,0,0,0,,Hareket etti!
Dialogue: 0,0:04:07.66,0:04:10.68,Main,,0,0,0,,Bu da kıvanç kaynağımdır!
Dialogue: 0,0:04:13.61,0:04:15.60,Main,,0,0,0,,Çok güzel değil mi ama?
Dialogue: 0,0:04:15.60,0:04:19.44,Main,,0,0,0,,Kitabın içinde yaşaması ne büyük kayıp.
Dialogue: 0,0:04:19.44,0:04:24.16,Main,,0,0,0,,Kitabın içindeki hayvanlar asla yaşlanmaz.
Dialogue: 0,0:04:24.16,0:04:30.62,Main,,0,0,0,,Hâliyle öyle olacak. Ne de olsa\Nkitabın içindekiler değişmez.
Dialogue: 0,0:04:30.62,0:04:32.32,Main,,0,0,0,,Yardım edin!
Dialogue: 0,0:04:34.16,0:04:40.80,Main,,0,0,0,,Bu kütüphanedeki kitaplar dünyanın dört bir yanından nadir yaratıklara ev sahipliği yapıyor.
Dialogue: 0,0:04:40.80,0:04:41.88,Main,,0,0,0,,Vay anasını!
Dialogue: 0,0:04:41.88,0:04:45.63,Main,,0,0,0,,Oğlum Mont d'Or'un yeteneği sağ olsun.
Dialogue: 0,0:04:45.63,0:04:49.47,Main,,0,0,0,,Geçenlerde de Punk Hazard'dan\Nbir Sentor ele geçirdik.
Dialogue: 0,0:04:49.47,0:04:52.68,Main,,0,0,0,,Güney Mavi'den de bir Griffon!
Dialogue: 0,0:04:53.65,0:04:55.77,Main,,0,0,0,,Hatta buna bile sahibim!
Dialogue: 0,0:04:55.77,0:04:57.82,Main,,0,0,0,,Uzun Uzuvlu insan!
Dialogue: 0,0:04:57.82,0:04:59.36,Main,,0,0,0,,İmdat!
Dialogue: 0,0:04:59.36,0:05:01.73,Main,,0,0,0,,Kurtarın beni!
Dialogue: 0,0:05:02.15,0:05:03.65,Main,,0,0,0,,İnsan da mı var?
Dialogue: 0,0:05:05.37,0:05:07.20,Main,,0,0,0,,Big Mom.
Dialogue: 0,0:05:07.95,0:05:13.89,Main,,0,0,0,,Ülkene adım attığımdan bu yana\Ntürlü türlü ırklara tanık oldum.
Dialogue: 0,0:05:13.89,0:05:19.44,Main,,0,0,0,,Doğal olarak! Ne de olsa Tottoland tüm\Nırkların toplandığı bir ülke olmayı hedefliyor...
Dialogue: 0,0:05:19.44,0:05:24.80,Main,,0,0,0,,Ama gözüme ilişmeyen, \Naklımı kurcalayıp duran bir ırk var.
Dialogue: 0,0:05:24.80,0:05:27.98,Main,,0,0,0,,Burada olsalardı\Nkesin fark ederdik.
Dialogue: 0,0:05:29.00,0:05:31.14,Main,,0,0,0,,Dev Irkı'nı diyorum!
Dialogue: 0,0:05:32.31,0:05:38.23,Main,,0,0,0,,Tüm ırklara ev sahipliği yaptığınız\Nsöylense de onlardan hiçbirini görmedim.
Dialogue: 0,0:05:38.23,0:05:41.07,Main,,0,0,0,,Normal boyutlardan daha büyük\Ninsanlar gördüm sadece.
Dialogue: 0,0:05:49.50,0:05:51.58,Main,,0,0,0,,Hadi ya?
Dialogue: 0,0:05:52.14,0:05:55.18,Main,,0,0,0,,Denk gelmemişsinizdir.
Dialogue: 0,0:05:55.18,0:05:57.22,Main,,0,0,0,,Mama!
Dialogue: 0,0:05:59.67,0:06:01.07,Main,,0,0,0,,Ne var?!
Dialogue: 0,0:06:01.07,0:06:07.76,Main,,0,0,0,,Ma... Mama... Ma, Biz... Biz...\NO ikisini... Buraya getirdik!
Dialogue: 0,0:06:08.84,0:06:10.82,Main,,0,0,0,,Anladım.
Dialogue: 0,0:06:11.22,0:06:14.34,Main,,0,0,0,,Müsaadenizi  isteyeyim ben.\NBugün başım biraz dolu.
Dialogue: 0,0:06:14.34,0:06:18.08,Main,,0,0,0,,Hava açık olmasa da \Nöğleninizin keyfini çıkartın.
Dialogue: 0,0:06:20.55,0:06:22.01,Main,,0,0,0,,Neyin var senin?
Dialogue: 0,0:06:22.01,0:06:24.73,Main,,0,0,0,,B- Biraz gerildim de.
Dialogue: 0,0:06:24.73,0:06:27.89,Main,,0,0,0,,Gerçek Germa 66'yı gördüm ya.
Dialogue: 0,0:06:27.89,0:06:32.45,Main,,0,0,0,,Bilhassa Ichiji-{\i1}sama{\i0} ile Reiju-sama\Nhayal ettiğimden de asil çıktılar!
Dialogue: 0,0:06:34.24,0:06:39.58,Main,,0,0,0,,Kes! Çizgi romana inanacak kadar\Naptal mısın?!
Dialogue: 0,0:06:39.58,0:06:43.04,Main,,0,0,0,,Mühim olan nasıl göründükleri değil.
Dialogue: 0,0:06:43.09,0:06:45.38,Captions,,0,0,0,,{\pos(635,370)}{\fad(500,400)}Zindan Kütüphanesi,\NWhole Cake Şatosu
Dialogue: 0,0:06:46.30,0:06:49.00,Main,,0,0,0,,Bakalım, hangi sayfadalardı?
Dialogue: 0,0:06:49.00,0:06:51.09,Main,,0,0,0,,Sayfa 55-{\i1}fa{\i0}.
Dialogue: 0,0:06:52.42,0:06:53.93,Main,,0,0,0,,55.
Dialogue: 0,0:06:53.93,0:06:55.59,Main,,0,0,0,,Bulduk.
Dialogue: 0,0:06:55.59,0:06:59.02,Main,,0,0,0,,Bunlar mı? Yüz ifadelerini sevdim bak.
Dialogue: 0,0:06:59.02,0:07:01.19,Main,,0,0,0,,Yala!
Dialogue: 0,0:07:03.06,0:07:05.42,Main,,0,0,0,,Daha ne kadar bu şekilde\Ntutulacağız?!
Dialogue: 0,0:07:05.42,0:07:06.90,Main,,0,0,0,,En azından duş aldırın!
Dialogue: 0,0:07:06.90,0:07:09.61,Main,,0,0,0,,Şerbet yağmuru yüzünden\Nher tarafım yapış yapış!
Dialogue: 0,0:07:09.61,0:07:14.53,Main,,0,0,0,,Kulağa çok tatlı geliyor, Şeker-{\i1}chan{\i}. Yala!{\an8}
Dialogue: 0,0:07:10.11,0:07:15.12,Captions,,0,0,0,,{\pos(642,478)}{\fad(500,0)}Perospero – Charlotte Ailesi'nin\NEn Büyük Oğlu
Dialogue: 0,0:07:16.70,0:07:18.74,Main,,0,0,0,,Mama'yı selamlayın.
Dialogue: 0,0:07:18.74,0:07:19.87,Main,,0,0,0,,Ne?!
Dialogue: 0,0:07:24.92,0:07:25.71,Main,,0,0,0,,Ha?
Dialogue: 0,0:07:25.71,0:07:27.42,Main,,0,0,0,,Den Den Mushi mi?!
Dialogue: 0,0:07:34.79,0:07:38.70,Main,,0,0,0,,{\i1}Epeydir görüşmemiştik Hasır Şapka Luffy!{\i0}
Dialogue: 0,0:07:38.70,0:07:41.56,Main,,0,0,0,,{\i1}Nihayet buraya kadar gelebildin demek.{\i0}
Dialogue: 0,0:07:41.56,0:07:43.44,Main,,0,0,0,,Sen misin Big Mom?!
Dialogue: 0,0:07:43.44,0:07:47.56,Main,,0,0,0,,Bırak beni!\NDönmem gereken bir yer var!
Dialogue: 0,0:07:47.56,0:07:50.86,Main,,0,0,0,,Her yeri altına üstüne getirmem\Ngerekse de buradan çıkmam gerek!
Dialogue: 0,0:07:53.35,0:07:57.80,Main,,0,0,0,,{\i1}Bak bak, şevki kırılmamış daha.{\i0}
Dialogue: 0,0:07:58.29,0:08:01.46,Main,,0,0,0,,Tüm tayfanla gelmediğinden...
Dialogue: 0,0:08:01.46,0:08:06.92,Main,,0,0,0,,...Balık Adam Adası'nda bana söylediğini\Nunuttun sandım.
Dialogue: 0,0:08:07.30,0:08:10.42,Flashbacks,,0,0,0,,{\i1}Yeni Dünya'da sana gününü gösterip...{\i0}
Dialogue: 0,0:08:10.42,0:08:14.09,Flashbacks,,0,0,0,,{\i1}...Balık Adam bölgesini\Nkendi himayeme alacağım!{\i0}
Dialogue: 0,0:08:15.25,0:08:18.60,Main,,0,0,0,,Aynen öyle,\Ngünün birinde canına okuyacağım!
Dialogue: 0,0:08:18.60,0:08:22.90,Main,,0,0,0,,Ama şu an Sanji'yi\Ngeri almaya geldik!
Dialogue: 0,0:08:22.90,0:08:26.19,Main,,0,0,0,,Lafa gelince\Nmangalda kül bırakmıyorsun!
Dialogue: 0,0:08:35.16,0:08:40.16,Main,,0,0,0,,Kes sesini! Dövüşmek istiyorsan\Nçık karşıma Big Mom!
Dialogue: 0,0:08:43.40,0:08:47.54,Main,,0,0,0,,Burada seninle kapışacağım!
Dialogue: 0,0:08:55.63,0:08:58.60,Main,,0,0,0,,Sana diyorum!\NÇık karşıma Big Mom!
Dialogue: 0,0:09:00.81,0:09:02.43,Main,,0,0,0,,Çık lan karşıma!
Dialogue: 0,0:09:04.98,0:09:07.02,Main,,0,0,0,,Kapışalım!
Dialogue: 0,0:09:09.07,0:09:11.44,Main,,0,0,0,,{\i1}Sabrımı zorlama.{\i0}
Dialogue: 0,0:09:11.44,0:09:16.53,Main,,0,0,0,,{\i1}Yeni Dünya'ya çok kısa süre önce\Nadım atmış çaylağın tekisin.{\i0}
Dialogue: 0,0:09:16.53,0:09:20.45,Main,,0,0,0,,{\i1}Benimle yüz yüze gelmeyi istemen\Nküstahlığın daniskasıdır.{\i0}
Dialogue: 0,0:09:22.20,0:09:28.67,Main,,0,0,0,,{\i1}Hem seni öldürmek için\Noraya gelmeme lüzum yok ki.{\i0}
Dialogue: 0,0:09:33.84,0:09:36.47,Main,,0,0,0,,{\i1}Aç kulaklarını Hasır Şapka.{\i0}
Dialogue: 0,0:09:37.93,0:09:44.39,Main,,0,0,0,,{\i1}Sanji'den umudunu kesersen\Nsağ bırakırım sizi.{\i0}
Dialogue: 0,0:09:44.39,0:09:45.85,Main,,0,0,0,,Çok beklersin!
Dialogue: 0,0:09:48.52,0:09:51.98,Main,,0,0,0,,{\i1}Sanji ile Pudding'in evliliğinin yeri...{\i0}
Dialogue: 0,0:09:51.98,0:09:53.64,Main,,0,0,0,,{\i1}...benim nezdimde...{\i0}
Dialogue: 0,0:09:53.64,0:09:56.19,Main,,0,0,0,,...çok başkadır.
Dialogue: 0,0:09:58.70,0:10:04.95,Main,,0,0,0,,{\i1}O yüzden işler hallolana dek\Notur oturduğun yere.{\i0}
Dialogue: 0,0:10:09.83,0:10:15.59,Main,,0,0,0,,Bana bak Hasır Şapka, iple çektiğim\Nbir olayın içine edersen...
Dialogue: 0,0:10:16.50,0:10:22.05,Main,,0,0,0,,...elimden çekeceğin var demektir.
Dialogue: 0,0:10:25.85,0:10:27.31,Main,,0,0,0,,{\i1}Sahi ya.{\i}
Dialogue: 0,0:10:28.02,0:10:30.19,Main,,0,0,0,,{\i1}Şeyi hatırlıyor musun?{\i1}
Dialogue: 0,0:10:30.60,0:10:35.32,Main,,0,0,0,,{\i1}Benim için hazırlanan\Ntüm şekerleri yediğinde...{\i0}
Dialogue: 0,0:10:35.32,0:10:41.99,Main,,0,0,0,,{\i1}...Kral Neptune'den aldığın\Ntüm hazineyi usulca teslim etmiştin.{\i0}
Dialogue: 0,0:10:41.99,0:10:45.41,Flashbacks,,0,0,0,,Yanımızda çuval çuval hazine var.
Dialogue: 0,0:10:46.05,0:10:50.05,Flashbacks,,0,0,0,,Hepsi senin olsun!\NŞekerlemelerin yerine sayarsın!
Dialogue: 0,0:10:55.04,0:10:58.88,Main,,0,0,0,,Bil bakalım içlerinden ne çıktı!
Dialogue: 0,0:11:02.86,0:11:05.35,Main,,0,0,0,,Verilen geri alınmaz bilesin!
Dialogue: 0,0:11:06.68,0:11:12.27,Main,,0,0,0,,{\i1}Balık Adam Adası'nda nesilden nesile\Naktarılmış efsanevi hazine sandığı!{\i0}
Dialogue: 0,0:11:12.27,0:11:14.77,Main,,0,0,0,,{\i1}Tamatebako.{\i}
Dialogue: 0,0:11:12.27,0:11:14.77,Note,,0,0,0,,Kıymetli Kutu.
Dialogue: 0,0:11:18.78,0:11:23.08,Main,,0,0,0,,{\i1}Neptune hangi akılla onu verdi ki?{\i0}
Dialogue: 0,0:11:23.08,0:11:28.58,Main,,0,0,0,,Hiç şüphesiz ulusal bir hazine.\Nİçinde ne var acaba?
Dialogue: 0,0:11:32.96,0:11:41.30,Main,,0,0,0,,Hazine sandıklarını çok sevdiğimden\Nşekerleme mevzusunu unuttum gitti.
Dialogue: 0,0:11:41.30,0:11:46.85,Main,,0,0,0,,Yarınki çay partisinde herkesin önünde\NTamatebako'yu açacağım.
Dialogue: 0,0:11:48.49,0:11:51.14,Main,,0,0,0,,Çok eğlenceli olacak!
Dialogue: 0,0:11:51.14,0:11:55.27,Main,,0,0,0,,Başlarım eğlencene!\NSanji evlenmeyecek bir kere!
Dialogue: 0,0:11:56.61,0:11:59.07,Main,,0,0,0,,Hay sıçayım!
Dialogue: 0,0:11:59.07,0:12:01.40,Main,,0,0,0,,- Sahi! Pudding'i görmek istiyorum!\N- Luffy!
Dialogue: 0,0:12:01.40,0:12:04.70,Main,,0,0,0,,- Ona diyeceklerim var! Biz arkadaşız!\N- Ondan bahsetme!
Dialogue: 0,0:12:04.70,0:12:07.83,Main,,0,0,0,,{\i1}Ha? Arkadaş mısınız?{\i0}
Dialogue: 0,0:12:10.17,0:12:15.04,Main,,0,0,0,,{\i1}Saçma sapan konuşma.\NGelinin nereden arkadaşı olasın ki?!{\i0}
Dialogue: 0,0:12:17.80,0:12:19.33,Main,,0,0,0,,Luffy!
Dialogue: 0,0:12:19.88,0:12:21.97,Main,,0,0,0,,Soytarılık yapmayı kes!
Dialogue: 0,0:12:21.97,0:12:23.88,Main,,0,0,0,,{\i1}Unutmadan, genç kız...{\i0}
Dialogue: 0,0:12:24.44,0:12:28.72,Main,,0,0,0,,{\i1}...Lola'yı öldürdüğün kulağıma çalındı.{\i0}
Dialogue: 0,0:12:28.72,0:12:32.09,Main,,0,0,0,,Ne diyorsun sen be?!\NLola benim arkadaşımdır!
Dialogue: 0,0:12:32.09,0:12:35.52,Main,,0,0,0,,Vivre Kartı'nı da arkadaşlığımızın\Nbir sembolü olarak kendisi verdi!
Dialogue: 0,0:12:36.15,0:12:39.34,Flashbacks,,0,0,0,,Mama'nın Vivre Kartı'nın üzerine\Nimzamı atıyorum ki...
Dialogue: 0,0:12:39.34,0:12:43.50,Flashbacks,,0,0,0,,...başınız sıkıştı mı onu bulmak için\Nkullanırsınız.
Dialogue: 0,0:12:43.50,0:12:46.90,Flashbacks,,0,0,0,,Onunla karşılaşırsanız da\Ngayet iyi olduğumu söyleyin.
Dialogue: 0,0:12:46.90,0:12:49.24,Flashbacks,,0,0,0,,Teşekkürler Lola.
Dialogue: 0,0:12:49.24,0:12:52.00,Main,,0,0,0,,Lola gayet iyi durumda.
Dialogue: 0,0:12:52.00,0:12:55.33,Main,,0,0,0,,Bunu iletmemi söyledi. Vazifem tamamlandı.
Dialogue: 0,0:12:55.83,0:12:58.75,Main,,0,0,0,,Annesinin korsan olduğunu\Nsöylemiş olsa da...
Dialogue: 0,0:12:58.75,0:13:02.01,Main,,0,0,0,,...Yonkou Big Mom çıkacağını\Nkırk yıl düşünsem bilemezdim.
Dialogue: 0,0:13:02.59,0:13:07.01,Main,,0,0,0,,Lola, Vivre Kartı'nı gösterince\Nbana yardım edeceğinizi söylemişti bir de...
Dialogue: 0,0:13:07.01,0:13:10.22,Main,,0,0,0,,Hadi oradan be!
Dialogue: 0,0:13:23.15,0:13:25.89,Main,,0,0,0,,{\i1}Ne durumda olduğundan bana ne!{\i0}
Dialogue: 0,0:13:25.89,0:13:27.22,Main,,0,0,0,,{\i1}Gebersin!{\i0}
Dialogue: 0,0:13:27.22,0:13:28.16,Main,,0,0,0,,Ne?!
Dialogue: 0,0:13:28.62,0:13:31.03,Main,,0,0,0,,{\i1}Yerini biliyorsan öt hemen!{\i0}
Dialogue: 0,0:13:31.03,0:13:34.79,Main,,0,0,0,,{\i1}Kellesini alması için\Nbir suikastçı göndereyim!{\i0}
Dialogue: 0,0:13:34.79,0:13:39.00,Main,,0,0,0,,{\i1}Hâlâ aile olduğumuzu\Nsanmasına şaştım kaldım!{\i0}
Dialogue: 0,0:13:39.00,0:13:43.10,Main,,0,0,0,,{\i1}Onun için ne yapsan da\Nevlat kıymet bilmez demişler!{\i0}
Dialogue: 0,0:13:43.10,0:13:49.26,Main,,0,0,0,,Gelmiş geçmiş en mühim siyasi evliliği\Nreddedip kaçan beyinsiz kızın teki!
Dialogue: 0,0:13:50.26,0:13:52.47,Main,,0,0,0,,Onu hayatta affetmem!
Dialogue: 0,0:13:55.28,0:14:00.11,Flashbacks,,0,0,0,,Birinizi eşim olarak alabilirim! Öncelik sende!\NBenimle dünya evine girmek ister misin?
Dialogue: 0,0:14:00.56,0:14:04.86,Flashbacks,,0,0,0,,Absalom benim kocam olacak!
Dialogue: 0,0:14:04.86,0:14:08.84,Flashbacks,,0,0,0,,Bence harika bir çift olursunuz var ya,\Nhatta destek olmak isterim!
Dialogue: 0,0:14:08.84,0:14:11.72,Flashbacks,,0,0,0,,Ne?!\NCidden mi?!
Dialogue: 0,0:14:12.09,0:14:15.45,Flashbacks,,0,0,0,,Seni kurtarmaya geldim arkadaşım!
Dialogue: 0,0:14:18.00,0:14:19.50,Flashbacks,,0,0,0,,Lola!
Dialogue: 0,0:14:19.50,0:14:23.25,Flashbacks,,0,0,0,,Lola! Seni tekrar gördüğüme\Nöyle sevindim ki!
Dialogue: 0,0:14:23.25,0:14:29.27,Flashbacks,,0,0,0,,Namizo ile kardeşten farksız\Nolduğumuz için sana özel.
Dialogue: 0,0:14:30.86,0:14:32.56,Main,,0,0,0,,Lola...
Dialogue: 0,0:14:35.10,0:14:36.22,Main,,0,0,0,,Eğer...
Dialogue: 0,0:14:36.93,0:14:41.10,Main,,0,0,0,,{\i1}...o gün kuzu kuzu evlenseydi...{\i0}
Dialogue: 0,0:14:41.10,0:14:44.02,Main,,0,0,0,,{\i1}...inanılmaz bir güç elde edecektim!{\i1}
Dialogue: 0,0:14:44.02,0:14:50.41,Main,,0,0,0,,Kaido'ymuş, Kızıl Saç'mış,\Nhatta Beyazsakal'ı bile çoktan alt edip...
Dialogue: 0,0:14:50.41,0:14:52.32,Main,,0,0,0,,...şimdiye...
Dialogue: 0,0:14:52.95,0:14:57.29,Main,,0,0,0,,...Korsanlar Kralı olmuştum!
Dialogue: 0,0:15:07.06,0:15:12.22,Main,,0,0,0,,{\i1}Lola'nın arkadaşı, Hırsız Kedi Nami...{\i0}
Dialogue: 0,0:15:13.55,0:15:17.93,Main,,0,0,0,,{\i1}İstesen de istemesen de yerini öteceksin.{\i0}
Dialogue: 0,0:15:20.42,0:15:23.81,Main,,0,0,0,,Uykumu getirdin be Big Mom.
Dialogue: 0,0:15:27.20,0:15:30.78,Main,,0,0,0,,Evlenmeyen Lola'ydı.
Dialogue: 0,0:15:33.49,0:15:37.77,Main,,0,0,0,,Korsanlar Kralı olamayan ise sendin.
Dialogue: 0,0:15:39.04,0:15:41.37,Main,,0,0,0,,Bahanelere sığınma!
Dialogue: 0,0:15:43.83,0:15:45.71,Main,,0,0,0,,Luffy...
Dialogue: 0,0:15:45.71,0:15:48.09,Main,,0,0,0,,Bir kez daha meydan okuyorum sana!
Dialogue: 0,0:15:48.09,0:15:52.01,Main,,0,0,0,,{\i1}Yonkou'sun diye kendini bir bok sanma!{\i0}
Dialogue: 0,0:15:52.01,0:15:54.60,Main,,0,0,0,,Sanji'yi mutlaka geri alacağım!
Dialogue: 0,0:15:54.60,0:15:58.85,Main,,0,0,0,,Son gülen de biz olacağız!
Dialogue: 0,0:16:18.03,0:16:20.03,Main,,0,0,0,,Neler oluyor-soir?!
Dialogue: 0,0:16:24.70,0:16:27.52,Main,,0,0,0,,{\i1}Baron Tamago, şatoya sızanı bulduk!{\i0}
Dialogue: 0,0:16:27.52,0:16:30.01,Main,,0,0,0,,{\i1}Bir Kaplan Mink içeri sızmış!{\i0}
Dialogue: 0,0:16:30.01,0:16:32.26,Main,,0,0,0,,Hayır, Jaguar Mink!
Dialogue: 0,0:16:32.26,0:16:37.26,Thoughts,,0,0,0,,{\i1}Pedro... Düşündüğüm gibi kaleye girmiş bile.{\i0}
Dialogue: 0,0:16:38.56,0:16:40.68,Main,,0,0,0,,Dursana Big Mom!
Dialogue: 0,0:16:42.39,0:16:43.98,Main,,0,0,0,,Çok komiksin ya!
Dialogue: 0,0:16:45.56,0:16:47.57,Main,,0,0,0,,Dalga yapıyorsun herhâlde?!
Dialogue: 0,0:16:47.57,0:16:51.83,Main,,0,0,0,,Kimin şatosunda\Nkime meydan okuyorsun sen ya?!
Dialogue: 0,0:16:51.83,0:16:54.74,Main,,0,0,0,,Kesin be!\NYiyorsa çıkın karşıma, dangalaklar!
Dialogue: 0,0:16:57.57,0:16:58.83,Main,,0,0,0,,Lola...
Dialogue: 0,0:17:04.62,0:17:08.75,Main,,0,0,0,,Baksanıza, abilerim ablalarım!\NEyvallah! Eyvallah!
Dialogue: 0,0:17:09.18,0:17:11.92,Main,,0,0,0,,Anglaise, ne oldu bakayım?!
Dialogue: 0,0:17:15.80,0:17:21.23,Main,,0,0,0,,Hazine Ambarı'na sıçan var!\NEyvallah!
Dialogue: 0,0:17:21.23,0:17:23.77,Main,,0,0,0,,Sızan mı demek istedin Anglaise?
Dialogue: 0,0:17:23.77,0:17:24.98,Main,,0,0,0,,Ha ondan işte!
Dialogue: 0,0:17:24.98,0:17:29.56,Main,,0,0,0,,Bugün var ya,\Ndişlerimi fırçalamayacağım! Eyvallah!
Dialogue: 0,0:17:31.94,0:17:35.95,Captions,,0,0,0,,{\fad(500,500)}Sanji'nin Kaldığı Misafir Odası
Dialogue: 0,0:17:37.41,0:17:39.03,Thoughts,,0,0,0,,Lütfen arkadaşlar,...
Dialogue: 0,0:17:39.42,0:17:42.08,Thoughts,,0,0,0,,...zarar görmeden geri çekilin.
Dialogue: 0,0:17:43.90,0:17:45.71,Main,,0,0,0,,Elinizden kaçırmayın!
Dialogue: 0,0:17:57.59,0:17:59.26,Main,,0,0,0,,Yakalayın!
Dialogue: 0,0:17:59.26,0:18:01.94,Main,,0,0,0,,Kafasına eseni yapmasına izin vermeyin!
Dialogue: 0,0:18:01.94,0:18:04.89,Main,,0,0,0,,Şatoya sızan kişi diğer bölgede!
Dialogue: 0,0:18:06.15,0:18:11.61,Main,,0,0,0,,Pekâlâ, Yonkou Big Mom'ın şatosunda...
Dialogue: 0,0:18:14.28,0:18:16.73,Main,,0,0,0,,...başlayalım mı...
Dialogue: 0,0:18:16.73,0:18:19.41,Main,,0,0,0,,...özel konserimize?!
Dialogue: 0,0:18:19.78,0:18:22.91,Captions,,0,0,0,,{\fad(500,250)}Kraliçe'nin Odası
Dialogue: 0,0:18:24.24,0:18:27.50,Main,,0,0,0,,Kızmadın mı Mama?
Dialogue: 0,0:18:29.33,0:18:32.75,Main,,0,0,0,,Bacaksızın teki\Nbana meydan okudu diye mi?!
Dialogue: 0,0:18:33.50,0:18:37.84,Main,,0,0,0,,Saçmalama Zeus!\NSaksıyı çalıştır biraz!
Dialogue: 0,0:19:28.43,0:19:32.31,Main,,0,0,0,,Ha? Bir sinyal aldım Mama!
Dialogue: 0,0:19:32.31,0:19:35.66,Main,,0,0,0,,Şatoya sızan biri Hazine Ambarı\Nçevresinde ortalığı ayağa kaldırmış!
Dialogue: 0,0:19:35.66,0:19:37.49,Main,,0,0,0,,Sızan mı varmış?!
Dialogue: 0,0:19:50.21,0:19:54.13,Main,,0,0,0,,Tamatebako'nun peşinde mi yoksa?!
Dialogue: 0,0:19:54.88,0:19:57.30,Main,,0,0,0,,Kimmiş bu?!
Dialogue: 0,0:19:59.21,0:20:01.63,Thoughts,,0,0,0,,{\i1}Hay böyle işin!{\i0}
Dialogue: 0,0:19:59.67,0:20:03.18,Captions,,0,0,0,,{\fad(400,350)\pos(1126,395)}Sanji'nin\NMisafir Odası
Dialogue: 0,0:20:01.63,0:20:05.54,Thoughts,,0,0,0,,{\i1}Luffyler adadan sağ ayrılacak.\NBig Mom söz verdi.{\i0}
Dialogue: 0,0:20:05.54,0:20:08.77,Thoughts,,0,0,0,,{\i1}Evlendim mi de Baratie güvende olacak.{\i0}
Dialogue: 0,0:20:10.35,0:20:14.38,Thoughts,,0,0,0,,{\i1}Yoldaşlarıma veda etmek kolay değil bittabi,\Nama en azından kimse ölmeyecek!{\i0}
Dialogue: 0,0:20:14.38,0:20:16.30,Thoughts,,0,0,0,,{\i1}Mühim olan da bu!{\i0}
Dialogue: 0,0:20:17.25,0:20:19.15,Thoughts,,0,0,0,,{\i1}Ne diye surat asıyorum ki?!{\i0}
Dialogue: 0,0:20:19.92,0:20:25.37,Main,,0,0,0,,Suratım asık olursa bir tanecik\Numut ışığım Pudding-chan kahrolur!
Dialogue: 0,0:20:27.91,0:20:32.00,Flashbacks,,0,0,0,,Benimle olan evliliğinin\Nsana işkence olmasına izin vermem!
Dialogue: 0,0:20:35.25,0:20:40.00,Main,,0,0,0,,O kadını üzersem\Nen adi şerefsizin teki olurum!
Dialogue: 0,0:20:42.26,0:20:47.24,Main,,0,0,0,,Böyle güzel bir kızı üzmesene oğlum!\NKendin ol yeter!
Dialogue: 0,0:20:47.24,0:20:50.43,Main,,0,0,0,,Evet ya!\NRomantik bir aşçıyım ben!
Dialogue: 0,0:20:50.43,0:20:52.50,Main,,0,0,0,,Pudding-{\i1}chan{\i}!
Dialogue: 0,0:20:52.50,0:20:55.79,Main,,0,0,0,,Pudding-{\i1}chwan{\i}!!
Dialogue: 0,0:20:55.79,0:20:59.90,Main,,0,0,0,,Seni dünyanın en mutlu\Nkadını yapacağım!
Dialogue: 0,0:21:00.57,0:21:02.11,Captions,,0,0,0,,Pudding'in Odası{\fad(250,0)}
Dialogue: 0,0:21:02.62,0:21:04.22,Main,,0,0,0,,Lola abla mı?
Dialogue: 0,0:21:04.22,0:21:12.75,Main,,0,0,0,,Evet, ondan aldığı Vivre Kartı'yla labirenti\Naratmayan ormandaki Homies'i dize getirmiş.
Dialogue: 0,0:21:13.36,0:21:19.21,Main,,0,0,0,,Bu arada Pudding-{\i1}sama{\i0}, \Ndün seçtiğiniz elbiseyi Mama beğenmedi.
Dialogue: 0,0:21:19.21,0:21:23.01,Main,,0,0,0,,Yarın Mama'nın seçtiği elbiseyi giyin lütfen.
Dialogue: 0,0:21:23.43,0:21:27.03,Main,,0,0,0,,Mama, evlilikten sonraki her şeyi de planladı.
Dialogue: 0,0:21:27.03,0:21:28.05,Main,,0,0,0,,Ayrıca...
Dialogue: 0,0:21:31.85,0:21:34.89,Main,,0,0,0,,Pudding-{\i1}sama{\i0}, avluda hâlâ yağış var.
Dialogue: 0,0:21:35.34,0:21:36.81,Main,,0,0,0,,Pudding-{\i1}sama{\i}?
Dialogue: 0,0:21:40.99,0:21:46.03,Flashbacks,,0,0,0,,Pudding, lafımdan çıkmadığın sürece\Nkılına zarar gelmez.
Dialogue: 0,0:21:46.78,0:21:52.04,Flashbacks,,0,0,0,,Oyuncak bir bebek gibisin Pudding.
Dialogue: 0,0:21:52.14,0:21:55.15,Flashbacks,,0,0,0,,Akıllı kızım Pudding.
Dialogue: 0,0:22:09.44,0:22:14.43,Flashbacks,,0,0,0,,Beni öldürecek hâli yok ya. Aileyiz biz!
Dialogue: 0,0:22:14.43,0:22:18.10,Flashbacks,,0,0,0,,Kiminle evleneceğime kendim karar veririm!
Dialogue: 0,0:22:34.24,0:22:38.00,Main,,0,0,0,,Çay partisinden hemen önceki gün bunun yaşanmasına önleyememelerine aklım almıyor!
Dialogue: 0,0:22:45.80,0:22:48.13,Main,,0,0,0,,Gördüm onu!
Dialogue: 0,0:22:55.62,0:22:57.14,Main,,0,0,0,,Çok hızlı...
Dialogue: 0,0:23:09.95,0:23:12.03,Main,,0,0,0,,Yolun sonuna geldin!
Dialogue: 0,0:23:25.17,0:23:26.92,Main,,0,0,0,,Ateş!
Dialogue: 0,0:23:34.47,0:23:36.22,Main,,0,0,0,,Mıhlayın şunu!
Dialogue: 0,0:23:43.31,0:23:45.57,Main,,0,0,0,,Kaçın!
Dialogue: 0,0:24:01.13,0:24:03.29,Main,,0,0,0,,Şu an nerede?
Dialogue: 0,0:24:03.29,0:24:07.67,Main,,0,0,0,,{\i1}Merdivenlerden avlunun yakınlarındaki \NKırmızı Fasulyeli Baum Pastası üçüncü katına indi!
Dialogue: 0,0:24:07.67,0:24:12.80,Main,,0,0,0,,Onu kolay kolay etkisiz hâle getiremezsiniz!\NAvluda köşeye sıkıştırmaya bakın-soir!
Dialogue: 0,0:24:12.80,0:24:15.26,Main,,0,0,0,,Baş üstüne!
Dialogue: 0,0:24:18.90,0:24:23.77,Main,,0,0,0,,Askerlerin arkası gelse başa çıkamazdım!
Dialogue: 0,0:24:24.60,0:24:27.48,Main,,0,0,0,,İçeri sızan teşrif etmiş.
Dialogue: 0,0:24:30.21,0:24:34.45,Main,,0,0,0,,Yırttım, sayıları epeyce azalmış.
Dialogue: 0,0:24:34.45,0:24:37.24,Main,,0,0,0,,Pedro-san'dan da bu beklenirdi!
Dialogue: 0,0:24:38.58,0:24:41.02,Main,,0,0,0,,Ne biçim şeysin lan sen?
Dialogue: 0,0:24:41.02,0:24:45.37,Main,,0,0,0,,Bizim ülke için bile ucube sayılırsın.
Dialogue: 0,0:24:46.13,0:24:47.96,Main,,0,0,0,,Hiç sorma.
Dialogue: 0,0:24:48.85,0:24:50.84,Main,,0,0,0,,Mama çok sevinecek.
Dialogue: 0,0:24:52.26,0:24:55.09,Main,,0,0,0,,Yakalayın!
Dialogue: 0,0:24:56.14,0:24:59.18,Main,,0,0,0,,{\i1}Bana bak Baron Tamago!{\i}
Dialogue: 0,0:24:59.18,0:25:00.86,Main,,0,0,0,,Smoothie-{\i1}sama{\i}!
Dialogue: 0,0:25:00.86,0:25:03.94,Main,,0,0,0,,Haklı çıktın! Biri daha varmış.
Dialogue: 0,0:25:03.94,0:25:06.44,Main,,0,0,0,,Dediğin gibi o herif yem görevi görüyormuş.
Dialogue: 0,0:25:07.45,0:25:10.69,Main,,0,0,0,,Aşağılık Pedro!\NŞatonun altını üstüne getirdi!
Dialogue: 0,0:25:11.86,0:25:16.75,Main,,0,0,0,,Elemanı hazine ambarına alıp\Nkapıları da kilitlemişiz.
Dialogue: 0,0:25:16.75,0:25:18.66,Main,,0,0,0,,Üzgünüm, dikkatsizlik ettim.
Dialogue: 0,0:25:18.66,0:25:22.00,Main,,0,0,0,,Fakat hazine ambarının tek girişi var!
Dialogue: 0,0:25:22.00,0:25:28.67,Main,,0,0,0,,Hazineleri çalabilse bile sizin\Nelinizden kurtulması mümkün değil!
Dialogue: 0,0:25:28.67,0:25:32.55,Main,,0,0,0,,{\i1}Kapıyı dikkatle beklediğiniz müddetçe\Nbir sorun kalmayacaktır-dezvous.{\i}
Dialogue: 0,0:25:32.55,0:25:35.66,Main,,0,0,0,,Doğru diyorsun, o iş bende.
Dialogue: 0,0:25:35.66,0:25:41.81,Main,,0,0,0,,İçerideki muhafızları alt edip kapıdan\Nçıkarsa öldüreceğim, uygun mudur?
Dialogue: 0,0:25:41.81,0:25:45.20,Main,,0,0,0,,Öldürmeyin, içerideki eleman\Nmuhtemelen bir iskelet-bon.
Dialogue: 0,0:25:45.22,0:25:47.87,Main,,0,0,0,,Mama böylesi tuhaf bir\Nyaratığa bayılacaktır.
Dialogue: 0,0:25:47.87,0:25:50.76,Main,,0,0,0,,{\i1}Tartaklayın ama sağ kalsın!
Dialogue: 0,0:25:50.76,0:25:52.65,Main,,0,0,0,,Pekâlâ.
Dialogue: 0,0:26:04.14,0:26:07.29,Main,,0,0,0,,Pedro-{\i1}san{\i} sizin olayınızı anlattı.
Dialogue: 0,0:26:07.29,0:26:13.09,Main,,0,0,0,,{\an8}Big Mom'ın yeteneği sayesinde\Niçlerinize insan ruhları yerleştirilmiş.
Dialogue: 0,0:26:07.29,0:26:09.29,Captions,,0,0,0,,{\pos(397,696)}Fil
Dialogue: 0,0:26:07.29,0:26:09.29,Captions,,0,0,0,,{\pos(847,271)}Piyon
Dialogue: 0,0:26:09.29,0:26:11.17,Captions,,0,0,0,,{\pos(290,262)}At
Dialogue: 0,0:26:09.29,0:26:11.17,Captions,,0,0,0,,{\pos(842,687)}Kale
Dialogue: 0,0:26:11.17,0:26:13.09,Captions,,0,0,0,,{\pos(495,696)}Şah
Dialogue: 0,0:26:11.17,0:26:13.09,Captions,,0,0,0,,{\pos(666,330)}Vezir
Dialogue: 0,0:26:13.09,0:26:16.55,Main,,0,0,0,,Bu da gösteriyor ki Uzlaşmacı Taşlar...
Dialogue: 0,0:26:19.34,0:26:22.64,Main,,0,0,0,,...ruhları doğrultusunda hareket ediyor!
Dialogue: 0,0:26:24.24,0:26:25.81,Main,,0,0,0,,Eyvah!
Dialogue: 0,0:26:26.31,0:26:28.95,Main,,0,0,0,,Ne hayvani bir güç!
Dialogue: 0,0:26:28.95,0:26:30.77,Main,,0,0,0,,Dursana yahu!
Dialogue: 0,0:26:30.77,0:26:33.19,Main,,0,0,0,,Akort yapacağım daha!
Dialogue: 0,0:26:33.19,0:26:36.92,Main,,0,0,0,,Parçalara ayırın!
Dialogue: 0,0:26:43.33,0:26:46.54,Main,,0,0,0,,Sonun geldi kemik yığını!
Dialogue: 0,0:26:48.46,0:26:50.21,Main,,0,0,0,,Lütfen ama ya!
Dialogue: 0,0:26:50.21,0:26:52.54,Main,,0,0,0,,D- D- D- D- Durun az!
Dialogue: 0,0:26:56.51,0:26:59.09,Main,,0,0,0,,Dursanıza ya!
Dialogue: 0,0:27:21.80,0:27:23.49,Main,,0,0,0,,Ne oldu lan?!
Dialogue: 0,0:27:23.49,0:27:29.21,Main,,0,0,0,,Mahlasımdan bihabersin herhâlde, bebek?
Dialogue: 0,0:27:43.11,0:27:45.89,Main,,0,0,0,,Ruh Kralı derler bana!
Dialogue: 0,0:27:53.16,0:27:55.23,Main,,0,0,0,,Uzlaşmacı Taşlar!
Dialogue: 0,0:27:55.23,0:27:58.40,Main,,0,0,0,,Ruh yerleştirilmiş askerler...
Dialogue: 0,0:27:59.90,0:28:05.03,Main,,0,0,0,,...gözü kara ruhumun\Nhaykırışımın karşısında...
Dialogue: 0,0:28:05.03,0:28:08.49,Main,,0,0,0,,...ayakta kalamazlar bittabi!
Dialogue: 0,0:28:09.54,0:28:14.08,Captions,,0,0,0,,{\fad(550,0)}Zindan Kütüphanesi
Dialogue: 0,0:28:21.76,0:28:24.39,Main,,0,0,0,,Yetti ama-{\i1}fa{\i}!
Dialogue: 0,0:28:32.81,0:28:35.52,Main,,0,0,0,,Buna şaşırdım bak.
Dialogue: 0,0:28:35.93,0:28:38.69,Main,,0,0,0,,Ziyaretini neye borçluyuz Pudding?
Dialogue: 0,0:28:40.08,0:28:41.15,Main,,0,0,0,,Pudding?
Dialogue: 0,0:28:45.49,0:28:50.37,Main,,0,0,0,,- Hey! Pudding! Çıkar bizi! Yakalandık!\N- Dur Luffy!
Dialogue: 0,0:28:50.37,0:28:52.33,Main,,0,0,0,,Diğerleri de duyuyor!
Dialogue: 0,0:28:52.33,0:28:55.96,Main,,0,0,0,,Hangi rüzgâr attı-{\i1}fa{\i}?
Dialogue: 0,0:28:58.06,0:29:04.09,Main,,0,0,0,,Opera abi, Luffy-kunlar'la\Nkodeste biraz konuşabilir miyim?
Dialogue: 0,0:29:04.09,0:29:09.51,Main,,0,0,0,,Luffy-{\i1}kun{\i} mu?\Nİyi, keyfine bak-{\i1}fa{\i}.
Dialogue: 0,0:29:12.35,0:29:14.73,Main,,0,0,0,,Ayracı yerleştireyim.
Dialogue: 0,0:29:25.14,0:29:26.66,Main,,0,0,0,,Pudding...
Dialogue: 0,0:29:27.89,0:29:29.74,Main,,0,0,0,,Arkadaşlar...
Dialogue: 0,0:29:31.31,0:29:32.95,Main,,0,0,0,,Baksana Pudding!
Dialogue: 0,0:29:32.95,0:29:35.30,Main,,0,0,0,,Sahile gittik!
Dialogue: 0,0:29:35.30,0:29:38.67,Main,,0,0,0,,Kes şunu!\NPudding'in başına bela açacaksın!
Dialogue: 0,0:29:42.19,0:29:43.84,Main,,0,0,0,,Hırpalanmışsınız.
Dialogue: 0,0:29:45.28,0:29:46.55,Main,,0,0,0,,Luffy-{\i1}kun{\i}.
Dialogue: 0,0:29:46.55,0:29:48.74,Main,,0,0,0,,Nami-{\i1}chan{\i}.
Dialogue: 0,0:29:50.08,0:29:54.43,Main,,0,0,0,,Abi ve ablalarım sizlere\Nkorkunç şeyler yapmış olmalı.
Dialogue: 0,0:29:55.81,0:29:57.77,Main,,0,0,0,,Özür dilerim.
Dialogue: 0,0:29:58.38,0:30:00.19,Main,,0,0,0,,Hiç gerek yok...
Dialogue: 0,0:30:01.76,0:30:05.12,Main,,0,0,0,,Buluşmak için sözleştiğimiz sahile de\Ngelemedim...
Dialogue: 0,0:30:05.12,0:30:06.75,Main,,0,0,0,,Affınıza sığınıyorum!
Dialogue: 0,0:30:06.75,0:30:10.74,Main,,0,0,0,,Sorun değil. Başını kaldır lütfen.
Dialogue: 0,0:30:12.81,0:30:16.21,Main,,0,0,0,,Ne diye fısıldıyor ki?
Dialogue: 0,0:30:17.54,0:30:20.33,Main,,0,0,0,,İşin aslı...
Dialogue: 0,0:30:21.42,0:30:26.23,Main,,0,0,0,,...Sanji-san'dan evlilik teklifi aldım.
Dialogue: 0,0:30:26.23,0:30:28.03,Main,,0,0,0,,Ne?!
Dialogue: 0,0:31:02.41,0:31:04.46,Main,,0,0,0,,Çok mutlu oldum!
Dialogue: 0,0:31:05.57,0:31:06.80,Main,,0,0,0,,Ama...
Dialogue: 0,0:31:07.63,0:31:11.76,Main,,0,0,0,,...Sanji-san'ın centilmenliğinden\Nöyle dediğini biliyorum.
Dialogue: 0,0:31:13.63,0:31:16.35,Main,,0,0,0,,Hepinizin başına iş açıyorum.
Dialogue: 0,0:31:16.35,0:31:17.52,Main,,0,0,0,,Hiç de bile!
Dialogue: 0,0:31:21.59,0:31:24.32,Main,,0,0,0,,Bu yüzden endişelenmeyin.
Dialogue: 0,0:31:25.07,0:31:28.61,Main,,0,0,0,,Onunla evlenmeyeceğim.
Dialogue: 0,0:31:36.13,0:31:37.50,Main,,0,0,0,,İyi dinleyin.
Dialogue: 0,0:32:03.85,0:32:05.40,Main,,0,0,0,,Hey, dur Pudding!
Dialogue: 0,0:32:16.63,0:32:18.27,Main,,0,0,0,,Elveda.
