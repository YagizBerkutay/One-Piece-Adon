0,120,18,1Style: Credits,FOT-Greco Std B,29,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,95,100,1,0,1,2.2,0,7,10,10,10,1Style: Author,Impress BT,22.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.7,0.7,9,10,10,10,1Style: Attack,Duality,30.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.0,1.0,7,12,12,12,1Style: Carrot,GrilledCheese BTN Toasted,62,&H006EE9F0,&H000000FF,&H00666666,&H00000000,0,0,0,0,90,100,0,0,1,2,0,2,10,10,10,1Style: Big Mom,Cartoon,62,&H00BBACF7,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,90,100,0,0,1,2,0,2,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:08:26.50,0:08:28.27,Note,,0,0,0,,1. Meydan OkumaDialogue: 0,0:09:25.73,0:09:27.58,Note,,0,0,0,,2. Meydan OkumaDialogue: 0,0:11:06.29,0:11:07.73,Note,,0,0,0,,3. Meydan OkumaDialogue: 0,0:11:41.30,0:11:42.72,Note,,0,0,0,,4. Meydan OkumaDialogue: 0,0:04:35.34,0:04:36.72,Carrot,,0,0,0,karaoke,Electro!Dialogue: 0,0:04:35.34,0:04:36.72,Attack,,0,0,0,karaoke,Elektro!Dialogue: 0,0:12:18.84,0:12:20.76,Big Mom,,0,0,0,karaoke,Heavenly...Dialogue: 0,0:12:18.84,0:12:20.76,Attack,,0,0,0,karaoke,İlahi...Dialogue: 0,0:12:21.26,0:12:22.88,Big Mom,,0,0,0,karaoke,...Feuer!Dialogue: 0,0:12:21.26,0:12:22.88,Attack,,0,0,0,karaoke,...Ateş!Dialogue: 0,0:01:34.28,0:01:39.16,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - dmc3 thx to onepace.netDialogue: 0,0:17:53.50,0:18:03.50,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - dmc3 thx to onepace.netDialogue: 0,0:33:41.80,0:33:49.10,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - dmc3 thx to onepace.netDialogue: 0,0:01:34.28,0:01:39.16,Title,,0,0,0,,YalancıDialogue: 0,0:01:41.38,0:01:42.66,Main,,0,0,0,,Neler oluyor?Dialogue: 0,0:01:42.66,0:01:46.92,Main,,0,0,0,,- Bu taraftan bir gürültü geldi! - Kim çıkardı o gürültüyü?!Dialogue: 0,0:01:49.20,0:01:50.29,Main,,0,0,0,,Orası mı?Dialogue: 0,0:01:52.75,0:01:54.72,Main,,0,0,0,,N'oluyor?Dialogue: 0,0:01:55.75,0:01:57.93,Main,,0,0,0,,B- Bobbin-sama!Dialogue: 0,0:01:57.13,0:02:01.85,Captions,,0,0,0,,"Çöpçü" Bobbin Big Mom Korsanlarının Savaşçısı (Fil) Kelle Ödülü: 105,500,000 BeliDialogue: 0,0:01:57.93,0:01:59.83,Main,,0,0,0,,Duvara ne oldu?Dialogue: 0,0:02:01.85,0:02:05.64,Main,,0,0,0,,- Burada ne oldu efendim?! - Buna kim cüret etti?Dialogue: 0,0:02:06.22,0:02:07.79,Main,,0,0,0,,Yok bir şey.Dialogue: 0,0:02:07.79,0:02:08.90,Main,,0,0,0,,İ- İyi de...Dialogue: 0,0:02:08.90,0:02:11.61,Main,,0,0,0,,Siz karışmayın.Dialogue: 0,0:02:14.82,0:02:15.99,Main,,0,0,0,,Bobbin-sa...Dialogue: 0,0:02:28.79,0:02:30.83,Main,,0,0,0,,Merak etmeyin.Dialogue: 0,0:02:31.30,0:02:34.21,Main,,0,0,0,,Bu işi bizzat göreceğim.Dialogue: 0,0:02:34.21,0:02:38.80,Main,,0,0,0,,Yaptığı kesinlikle yanına kalmayacak!Dialogue: 0,0:02:39.18,0:02:41.80,Main,,0,0,0,,Mama'nın çay partisi için...Dialogue: 0,0:02:41.80,0:02:44.72,Main,,0,0,0,,...şeytanın ta kendisi bile...Dialogue: 0,0:02:44.72,0:02:47.18,Main,,0,0,0,,...ininden çıkıp gelir!Dialogue: 0,0:02:51.90,0:02:55.02,Captions,,0,0,0,,Ayna DünyasıDialogue: 0,0:02:55.07,0:02:57.75,Main,,0,0,0,,Ayna ayna! Teşekkürler!Dialogue: 0,0:02:57.75,0:02:59.40,Main,,0,0,0,,Ne demek efendim!Dialogue: 0,0:02:59.84,0:03:00.78,Main,,0,0,0,,Baksanıza...Dialogue: 0,0:03:01.96,0:03:06.36,Main,,0,0,0,,Devasa bir şey Brook'un etrafını sarmış...Dialogue: 0,0:03:12.36,0:03:13.42,Main,,0,0,0,,Yok artık...Dialogue: 0,0:03:18.22,0:03:19.97,Main,,0,0,0,,İnanılır gibi değil...Dialogue: 0,0:03:25.26,0:03:26.47,Main,,0,0,0,,Burası...Dialogue: 0,0:03:29.20,0:03:31.06,Main,,0,0,0,,N'apacaksınız bakayım?Dialogue: 0,0:03:32.32,0:03:33.77,Main,,0,0,0,,Bu oda...Dialogue: 0,0:03:37.31,0:03:40.93,Main,,0,0,0,,...Mama'nın yatak odasıdır!Dialogue: 0,0:03:40.93,0:03:43.51,Main,,0,0,0,,Yonkou Big Mom'ın mı?!Dialogue: 0,0:03:44.20,0:03:46.29,Main,,0,0,0,,N- N- N'apacağız şimdi?!Dialogue: 0,0:03:46.29,0:03:48.95,Main,,0,0,0,,Hayatta olmasına sevinmemiz lazım da...Dialogue: 0,0:03:49.75,0:03:53.37,Main,,0,0,0,,- Brook... - Burada bulmayı beklemiyordum.Dialogue: 0,0:03:56.47,0:03:59.34,Main,,0,0,0,,Tamam da neden Brook'la birlikte uyumuş ki?Dialogue: 0,0:04:00.72,0:04:04.72,Main,,0,0,0,,- Brook da bebek gibi uyuyor ha. - Bu durumda nasıl uyuyabiliyor ki?!Dialogue: 0,0:04:04.72,0:04:07.26,Main,,0,0,0,,Uyan Brook!Dialogue: 0,0:04:10.64,0:04:13.77,Main,,0,0,0,,Olmuyor. Seni duymuyor.Dialogue: 0,0:04:15.56,0:04:20.82,Main,,0,0,0,,Öyle tuhaf, kemiksi bir yaratığı Mama yanı başından ayırır mı hiç?Dialogue: 0,0:04:20.82,0:04:22.90,Main,,0,0,0,,Fakat gönlünüzü ferah tutun...Dialogue: 0,0:04:22.90,0:04:26.07,Main,,0,0,0,,...ellerini gevşetmesini sağlayabilirim.Dialogue: 0,0:04:26.80,0:04:29.91,Main,,0,0,0,,Mama! Benim, Brûlée!Dialogue: 0,0:04:29.91,0:04:30.91,Main,,0,0,0,,Çuff!Dialogue: 0,0:04:30.91,0:04:32.71,Main,,0,0,0,,- Yetiş... - Çuf!Dialogue: 0,0:04:32.71,0:04:35.34,Main,,0,0,0,,- Kesin sesinizi! - Ağızlarını bağlayın!Dialogue: 0,0:04:45.78,0:04:48.06,Main,,0,0,0,,Big Mom'ı uyandırmadık umarım?Dialogue: 0,0:04:52.04,0:04:54.14,Main,,0,0,0,,Şükürler olsun. Hâlâ uykuda...Dialogue: 0,0:04:56.44,0:04:57.86,Main,,0,0,0,,B- B...Dialogue: 0,0:04:57.86,0:04:59.19,Main,,0,0,0,,B...Dialogue: 0,0:04:59.19,0:05:01.57,Main,,0,0,0,,Bizi gördü!Dialogue: 0,0:05:09.31,0:05:12.27,Main,,0,0,0,,Aman ya, sinekmiş.Dialogue: 0,0:05:24.63,0:05:27.26,Main,,0,0,0,,Olamaz! Ne, ne?! N'oluyor?!Dialogue: 0,0:05:27.96,0:05:29.01,Main,,0,0,0,,Uyandı!Dialogue: 0,0:05:29.01,0:05:31.54,Main,,0,0,0,,Brook! Buradayız, burada!Dialogue: 0,0:05:31.54,0:05:33.18,Main,,0,0,0,,Çabuk yanımıza gel!Dialogue: 0,0:05:33.18,0:05:34.79,Secondary,,0,0,0,,Brook!Dialogue: 0,0:05:37.42,0:05:39.48,Main,,0,0,0,,Aa, sinek miydi?Dialogue: 0,0:05:40.40,0:05:42.53,Main,,0,0,0,,Uyumasana lan!Dialogue: 0,0:05:43.62,0:05:46.40,Main,,0,0,0,,Ne oldu Mama?! Düşman saldırısı mı?!Dialogue: 0,0:05:46.40,0:05:48.03,Main,,0,0,0,,Uyuyoruz şurada!Dialogue: 0,0:05:48.03,0:05:50.12,Main,,0,0,0,,Vay alçak!Dialogue: 0,0:05:52.41,0:05:53.87,Main,,0,0,0,,Oradasın demek!Dialogue: 0,0:06:24.18,0:06:25.94,Main,,0,0,0,,Bu ne biçim bir güçtür?Dialogue: 0,0:06:39.14,0:06:41.13,Main,,0,0,0,,Böyle canavarların elinden...Dialogue: 0,0:06:41.92,0:06:43.42,Main,,0,0,0,,...nasıl...Dialogue: 0,0:06:44.09,0:06:45.59,Main,,0,0,0,,...Brook'u...Dialogue: 0,0:06:46.41,0:06:48.59,Main,,0,0,0,,...kurtaracağız ki?Dialogue: 0,0:07:01.48,0:07:03.02,Main,,0,0,0,,Dursana!Dialogue: 0,0:07:03.65,0:07:05.23,Main,,0,0,0,,Sana değil bunlar!Dialogue: 0,0:07:14.50,0:07:19.20,Main,,0,0,0,,Üzgünüm ama ne olursa olsun vermek istediğim biri var.Dialogue: 0,0:07:24.13,0:07:27.42,Captions,,0,0,0,,Ayna DünyasıDialogue: 0,0:07:32.22,0:07:34.79,Main,,0,0,0,,Biraz daha mı saç eklesek?Dialogue: 0,0:07:34.79,0:07:37.54,Main,,0,0,0,,Şimdi nasıl oldu peki?Dialogue: 0,0:07:37.54,0:07:39.68,Main,,0,0,0,,Tamamdır, iyi gibi!Dialogue: 0,0:07:39.68,0:07:41.94,Main,,0,0,0,,Bunu nereden buldun ki?Dialogue: 0,0:07:41.94,0:07:44.36,Main,,0,0,0,,Şatodaki infaz odasından çıktı.Dialogue: 0,0:07:44.36,0:07:47.26,Main,,0,0,0,,Afro saçı görevini de mutfaktaki deniz yosunu gördü.Dialogue: 0,0:07:48.28,0:07:50.32,Main,,0,0,0,,Tamamdır, bitti!Dialogue: 0,0:07:50.98,0:07:55.03,Main,,0,0,0,,- Vay! Brook'un tıpkısı! - Tepeden tırnağa!Dialogue: 0,0:07:55.50,0:07:57.45,Main,,0,0,0,,Bunu Brook'un yerine koyarsak...Dialogue: 0,0:07:58.00,0:08:01.29,Main,,0,0,0,,...yokluğunu anlamayacaktır.Dialogue: 0,0:08:04.71,0:08:08.05,Main,,0,0,0,,Bir de Brûlée'yi aynanın ortasına koyduk mu...Dialogue: 0,0:08:08.50,0:08:12.67,Main,,0,0,0,,...aynadan gönlümüzce girip çıkabiliriz.Dialogue: 0,0:08:13.68,0:08:16.97,Thoughts,,0,0,0,,Hay böyle işin! Bunu ödeyeceksiniz!Dialogue: 0,0:08:16.97,0:08:21.26,Main,,0,0,0,,Böylece her şey hazır gibi. Başlayalım madem.Dialogue: 0,0:08:22.29,0:08:24.52,Main,,0,0,0,,Brook'u Kurtarma Operasyonu!Dialogue: 0,0:08:29.57,0:08:31.49,Main,,0,0,0,,Pekâlâ, gidiyorum!Dialogue: 0,0:08:31.49,0:08:33.39,Main,,0,0,0,,Dikkatli ol Choniki!Dialogue: 0,0:08:33.39,0:08:36.45,Main,,0,0,0,,Biliyorum! O iş bende!Dialogue: 0,0:09:09.02,0:09:10.65,Main,,0,0,0,,Beyinsiz!Dialogue: 0,0:09:13.61,0:09:17.52,Main,,0,0,0,,Çok korktum ya! Ödüm patladı!Dialogue: 0,0:09:17.52,0:09:21.44,Main,,0,0,0,,- İyi misin Choniki? - Başka biri gitmeli.Dialogue: 0,0:09:21.45,0:09:24.71,Main,,0,0,0,,Peki, ben gideyim şimdi!Dialogue: 0,0:09:36.22,0:09:37.18,Main,,0,0,0,,Başardı!Dialogue: 0,0:09:37.69,0:09:40.14,Main,,0,0,0,,Brook, Brook, uyan!Dialogue: 0,0:09:40.14,0:09:42.13,Main,,0,0,0,,Hadisene Brook, uyan.Dialogue: 0,0:09:42.13,0:09:44.39,Main,,0,0,0,,Olamaz! Sümük baloncuğu geliyor!Dialogue: 0,0:09:44.39,0:09:45.48,Main,,0,0,0,,Kaç!Dialogue: 0,0:09:53.27,0:09:55.61,Thoughts,,0,0,0,,Fark edildim mi?Dialogue: 0,0:09:59.12,0:10:01.03,Thoughts,,0,0,0,,Doğruca bana bakıyor!Dialogue: 0,0:10:08.33,0:10:09.29,Main,,0,0,0,,Bu...Dialogue: 0,0:10:09.29,0:10:11.09,Main,,0,0,0,,Peluş tavşan taklidi!Dialogue: 0,0:10:11.09,0:10:12.84,Main,,0,0,0,,Bunu yer mi hiç?!Dialogue: 0,0:10:16.37,0:10:20.50,Main,,0,0,0,,Aman, peluş tavşanmış.Dialogue: 0,0:10:22.22,0:10:24.10,Main,,0,0,0,,Ne? Yedi mi?!Dialogue: 0,0:10:24.10,0:10:25.81,Main,,0,0,0,,Fırsat bu fırsat Carrot!Dialogue: 0,0:10:28.52,0:10:30.14,Thoughts,,0,0,0,,Bu sefer başaracağım...Dialogue: 0,0:10:39.69,0:10:41.75,Main,,0,0,0,,Bu sinek ölmemiş mi?Dialogue: 0,0:10:42.95,0:10:45.84,Main,,0,0,0,,Ne ölmek bilmez şey çıktın sen!Dialogue: 0,0:10:53.54,0:10:57.90,Main,,0,0,0,,- Yüreğim ağzıma geldi! Acayip korktum ya! - Seni çok iyi anlıyorum.Dialogue: 0,0:10:57.90,0:10:59.78,Main,,0,0,0,,Başka birinin daha gitmesi lazım.Dialogue: 0,0:10:59.78,0:11:02.80,Main,,0,0,0,,Tam bir hayal kırıklığı. Ama iş bu noktaya geldiyse...Dialogue: 0,0:11:03.63,0:11:05.26,Main,,0,0,0,,İş başa düşmüştür!Dialogue: 0,0:11:17.08,0:11:18.32,Main,,0,0,0,,Brook!Dialogue: 0,0:11:18.32,0:11:19.80,Main,,0,0,0,,Uyansana!Dialogue: 0,0:11:20.30,0:11:21.23,Main,,0,0,0,,Brook!Dialogue: 0,0:11:27.01,0:11:28.62,Thoughts,,0,0,0,,Yine döndü!Dialogue: 0,0:11:34.76,0:11:36.13,Main,,0,0,0,,İyi oldu!Dialogue: 0,0:11:36.13,0:11:38.38,Main,,0,0,0,,Big Mom'ın ellerinden kurtulmuş oldu.Dialogue: 0,0:11:38.38,0:11:40.31,Main,,0,0,0,,Tamamdır, gidiyorum!Dialogue: 0,0:11:46.12,0:11:47.43,Main,,0,0,0,,Brook, uyan!Dialogue: 0,0:11:51.77,0:11:53.19,Main,,0,0,0,,Brook!Dialogue: 0,0:11:54.31,0:11:56.48,Main,,0,0,0,,Benim, Brook!Dialogue: 0,0:11:59.27,0:12:01.24,Main,,0,0,0,,Hayalet!Dialogue: 0,0:12:03.37,0:12:05.20,Main,,0,0,0,,N'oluyor ya?Dialogue: 0,0:12:06.30,0:12:08.37,Main,,0,0,0,,Daha ölmedin mi sen?Dialogue: 0,0:12:11.80,0:12:12.92,Main,,0,0,0,,Vaziyet sakat!Dialogue: 0,0:12:12.92,0:12:16.13,Main,,0,0,0,,İnatçı sinek!Dialogue: 0,0:12:36.69,0:12:37.82,Main,,0,0,0,,Başardılar!Dialogue: 0,0:12:42.88,0:12:46.24,Main,,0,0,0,,Az... Az daha gidiyordum!Dialogue: 0,0:12:47.02,0:12:49.12,Main,,0,0,0,,Teşekkürler Jinbe!Dialogue: 0,0:12:50.70,0:12:52.88,Main,,0,0,0,,Operasyon tamamlandı!Dialogue: 0,0:12:52.88,0:12:54.83,Main,,0,0,0,,Oley!Dialogue: 0,0:12:54.83,0:12:58.10,Main,,0,0,0,,–Oley ya! -Çok rahatladım!Dialogue: 0,0:13:23.86,0:13:28.78,Captions,,0,0,0,,Tatlı Şehir'in EtekleriDialogue: 0,0:13:30.79,0:13:33.47,Thoughts,,0,0,0,,Burayı epey dağıtmış.Dialogue: 0,0:13:47.64,0:13:51.89,Flashbacks,,0,0,0,,O herifin sonu geldi artık.Dialogue: 0,0:13:53.43,0:13:58.65,Flashbacks,,0,0,0,,Şu an Hasır Şapka ile Hırsız Kedi esir tutuluyor-nasu.Dialogue: 0,0:13:58.65,0:14:03.69,Flashbacks,,0,0,0,,Buraya gelebilmek için Luffy tüm gece yüksek rütbeli adamlarla savaştı!Dialogue: 0,0:14:03.69,0:14:05.55,Flashbacks,,0,0,0,,Vücudu çoktan...Dialogue: 0,0:14:07.00,0:14:08.18,Thoughts,,0,0,0,,Ama...Dialogue: 0,0:14:09.25,0:14:12.37,Thoughts,,0,0,0,,...burada bekleyeceğini söyledin!Dialogue: 0,0:14:15.16,0:14:17.71,Thoughts,,0,0,0,,Neredesin Luffy?!Dialogue: 0,0:14:29.04,0:14:30.85,Main,,0,0,0,,Luffy!Dialogue: 0,0:14:34.77,0:14:35.72,Main,,0,0,0,,Ben...Dialogue: 0,0:14:35.72,0:14:36.68,Main,,0,0,0,,Ben...Dialogue: 0,0:14:36.68,0:14:37.81,Main,,0,0,0,,Ben...Dialogue: 0,0:14:37.81,0:14:40.81,Main,,0,0,0,,Şaştım kaldım!Dialogue: 0,0:14:40.81,0:14:42.61,Main,,0,0,0,,H...Dialogue: 0,0:14:42.61,0:14:42.94,Main,,0,0,0,,H...Dialogue: 0,0:14:42.94,0:14:44.57,Main,,0,0,0,,H...Dialogue: 0,0:14:44.99,0:14:47.36,Main,,0,0,0,,Hem de her şeye!Dialogue: 0,0:14:47.36,0:14:49.70,Main,,0,0,0,,Asıl biz şaştık kaldık be!Dialogue: 0,0:14:50.66,0:14:52.91,Flashbacks,,0,0,0,,Hayalet!Dialogue: 0,0:14:52.91,0:14:55.91,Main,,0,0,0,,En can alıcı yerde bastın çığlığı!Dialogue: 0,0:14:56.84,0:14:58.87,Main,,0,0,0,,Çok teşekkür ederim ya.Dialogue: 0,0:14:58.87,0:15:01.98,Main,,0,0,0,,Neyse, hayatta olduğuna sevindim.Dialogue: 0,0:15:01.98,0:15:05.12,Main,,0,0,0,,Sağ olun, öleceğim sanmıştım.Dialogue: 0,0:15:06.52,0:15:08.17,Main,,0,0,0,,Gerçi zaten ölüyüm de.Dialogue: 0,0:15:11.96,0:15:19.09,Main,,0,0,0,,Güvenliği artırdıklarında Yol Poneglifi'ni almamız mümkün değilmiş demek.Dialogue: 0,0:15:19.72,0:15:23.90,Main,,0,0,0,,Yine de seni zorlayıp hayatını da tehlikeye attım.Dialogue: 0,0:15:25.04,0:15:26.40,Main,,0,0,0,,Özür dilerim.Dialogue: 0,0:15:26.40,0:15:31.16,Main,,0,0,0,,Neler diyorsun?! Her şeyi bizim için yaptın!Dialogue: 0,0:15:31.91,0:15:40.08,Main,,0,0,0,,Senin de dediğin gibi, iki kişi olduğumuzdan bulunmaz bir fırsat yakalamıştık.Dialogue: 0,0:15:40.08,0:15:44.59,Main,,0,0,0,,Aksi hâlde Yol Poneglifi'ni Big Mom'dan başka bir vakitte almaya kalkışsak...Dialogue: 0,0:15:44.84,0:15:49.05,Main,,0,0,0,,...büyük çaplı bir korsan muharebesinin yaşanması işten bile değildi!Dialogue: 0,0:15:50.59,0:15:55.85,Main,,0,0,0,,Bu yüzden şansımız çok az olsa bile denememiz icap etti.Dialogue: 0,0:16:01.48,0:16:03.98,Main,,0,0,0,,Buyrun, kopyalar bunlar.Dialogue: 0,0:16:04.86,0:16:09.32,Main,,0,0,0,,O değil de Pedro-san,  bir şeyiniz olmamasına inanamıyorum ya.Dialogue: 0,0:16:09.32,0:16:10.36,Main,,0,0,0,,Kopyalar mı...Dialogue: 0,0:16:10.36,0:16:11.65,Main,,0,0,0,,Ne?!Dialogue: 0,0:16:11.65,0:16:18.16,Main,,0,0,0,,Ben de çıkmazda olduğumdan yem olmandan başka bir şey bulamamıştım.Dialogue: 0,0:16:18.75,0:16:22.58,Main,,0,0,0,,Dur biraz Brook! Yoksa bunlar...Dialogue: 0,0:16:22.58,0:16:25.37,Main,,0,0,0,,Poneglif kopyaları.Dialogue: 0,0:16:26.19,0:16:28.55,Main,,0,0,0,,Ama kıl payıyla başardım ha!Dialogue: 0,0:16:29.24,0:16:32.09,Main,,0,0,0,,Üçüncü kâğıdı da geçirmeyi bitirdiğim gibi...Dialogue: 0,0:16:32.09,0:16:35.18,Main,,0,0,0,,...içeri Big Mom dalmasın mı!!Dialogue: 0,0:16:39.98,0:16:42.56,Main,,0,0,0,,Kopyaları çıkardın mı?!Dialogue: 0,0:16:45.27,0:16:50.61,Main,,0,0,0,,Orada bir Şekerleme Generali bile vardı! Onca muhafızı alt etmeyi başardın mı?Dialogue: 0,0:16:54.36,0:17:01.44,Main,,0,0,0,,Diğer Yonkoular'ın bile ele geçirmek için can attığı Big Mom'ın Poneglifler'ini...Dialogue: 0,0:17:02.24,0:17:03.62,Main,,0,0,0,,...ele geçirdin mi?!Dialogue: 0,0:17:06.86,0:17:08.75,Main,,0,0,0,,Ha, evet.Dialogue: 0,0:17:10.88,0:17:12.67,Thoughts,,0,0,0,,Ne?!Dialogue: 0,0:17:12.67,0:17:16.64,Thoughts,,0,0,0,,Poneglifler'imizin kopyasını mı çıkarmış?!Dialogue: 0,0:17:16.64,0:17:19.35,Main,,0,0,0,,Brook!Dialogue: 0,0:17:21.16,0:17:23.72,Main,,0,0,0,,Harikasın!Dialogue: 0,0:17:23.72,0:17:25.44,Main,,0,0,0,,Mucize resmen!Dialogue: 0,0:17:25.44,0:17:32.44,Main,,0,0,0,,Hazine Ambarı, Big Mom'ın ailesinden olanların bile kolayca giremeyeceği bir yerdir.Dialogue: 0,0:17:32.44,0:17:34.57,Main,,0,0,0,,Helalin var!Dialogue: 0,0:17:34.57,0:17:37.20,Main,,0,0,0,,Öyleyse külotunu şöyle ucundan bir gösters--Dialogue: 0,0:17:37.20,0:17:38.93,Main,,0,0,0,,Hadi lan!Dialogue: 0,0:17:38.93,0:17:41.08,Main,,0,0,0,,Yine kemikleri kırıldı!Dialogue: 0,0:17:41.08,0:17:44.86,Main,,0,0,0,,Böylece hedeflerimizden birine ulaşmış olduk!Dialogue: 0,0:17:44.86,0:17:48.25,Main,,0,0,0,,Geriye bir tek Sanji'yi kurtarmak kaldı!Dialogue: 0,0:18:33.34,0:18:35.38,Main,,0,0,0,,Ne?!Dialogue: 0,0:18:35.38,0:18:37.14,Main,,0,0,0,,İkisi de ortalıkta yok mu?!Dialogue: 0,0:18:37.14,0:18:38.46,Main,,0,0,0,,Yok!Dialogue: 0,0:18:37.13,0:18:42.14,Captions,,0,0,0,,Ayna DünyasıDialogue: 0,0:18:38.46,0:18:42.92,Main,,0,0,0,,– Önceden yanımdan geçmişlerdi. – Şu an hiçbir yerde yoklar.Dialogue: 0,0:18:42.92,0:18:44.68,Main,,0,0,0,,Sanji'nin odasında bile?Dialogue: 0,0:18:44.68,0:18:47.39,Main,,0,0,0,,Evet, yerinde tuhaf bir tip uyuyor.Dialogue: 0,0:18:47.95,0:18:50.77,Main,,0,0,0,,Sahi, yerini biliyorum galiba.Dialogue: 0,0:18:51.36,0:18:54.57,Main,,0,0,0,,Dışarıda olduğundan civarda ayna da yoktur.Dialogue: 0,0:18:54.57,0:18:57.94,Main,,0,0,0,,Bu sabah Luffy ile Sanji-kun'un...Dialogue: 0,0:19:00.13,0:19:01.66,Main,,0,0,0,,...dövüştükleri yer.Dialogue: 0,0:19:01.66,0:19:05.70,Main,,0,0,0,,Ne?!Dialogue: 0,0:19:06.95,0:19:10.67,Main,,0,0,0,,Luffy'yle Sanji dövüştü mü?!Dialogue: 0,0:19:11.00,0:19:12.38,Main,,0,0,0,,Neden ama, neden ya?!Dialogue: 0,0:19:13.83,0:19:17.62,Main,,0,0,0,,Vinsmokelar'ın bir ferdi olarak Sanji'nin vazifesi var.Dialogue: 0,0:19:18.71,0:19:20.26,Main,,0,0,0,,Demek öyle.Dialogue: 0,0:19:20.26,0:19:23.85,Main,,0,0,0,,Mecburi bir gerekçeyle buraya gelmiş olmalı.Dialogue: 0,0:19:23.85,0:19:27.59,Main,,0,0,0,,Onu kurtarmanın o kadar kolay olacağını sanmam.Dialogue: 0,0:19:29.02,0:19:32.12,Main,,0,0,0,,Fakat kurtarmak istiyorsanız da elinizi çabuk tutmalısınız.Dialogue: 0,0:19:32.90,0:19:37.36,Main,,0,0,0,,Herkes bir araya toplanınca söylemeyi düşünüyordum ama şöyle ki...Dialogue: 0,0:19:37.36,0:19:41.32,Main,,0,0,0,,...yarın düğün gerçekleşirse...Dialogue: 0,0:19:41.32,0:19:43.87,Main,,0,0,0,,...mutlu bir son beklemeyin sakın.Dialogue: 0,0:19:45.08,0:19:46.62,Main,,0,0,0,,Nasıl yani?Dialogue: 0,0:19:46.62,0:19:51.08,Main,,0,0,0,,Buraya Pekoms ile geldiniz, değil mi?Dialogue: 0,0:19:51.08,0:19:53.08,Main,,0,0,0,,Sahi, Pekoms!Dialogue: 0,0:19:53.08,0:19:57.80,Main,,0,0,0,,İyi mi peki? Onu kaybetmiştik.Dialogue: 0,0:19:56.13,0:19:57.80,Note,,0,0,0,,Geri DönünDialogue: 0,0:19:57.80,0:20:03.20,Main,,0,0,0,,Durumu iyi fakat bir komploya kurban giderek...Dialogue: 0,0:20:03.20,0:20:05.76,Main,,0,0,0,,...az daha köpek balıklarına yem oluyordu.Dialogue: 0,0:20:05.76,0:20:07.31,Main,,0,0,0,,Komplo mu?Dialogue: 0,0:20:09.18,0:20:11.42,Main,,0,0,0,,Zamanında fark etmeseydik...Dialogue: 0,0:20:14.06,0:20:16.02,Main,,0,0,0,,...ölmüş olurdu.Dialogue: 0,0:20:16.11,0:20:18.11,Captions,,0,0,0,,Tatlı ŞehriDialogue: 0,0:20:23.07,0:20:26.78,Captions,,0,0,0,,Ağaç Misafir Odası 6. KatDialogue: 0,0:20:23.82,0:20:26.83,Main,,0,0,0,,N- Ne biçim bünyeniz var...Dialogue: 0,0:20:26.83,0:20:29.08,Main,,0,0,0,,...sizin?Dialogue: 0,0:20:30.97,0:20:35.75,Main,,0,0,0,,Rezillik. Bar hatunları içkiden bayılır mı hiç?Dialogue: 0,0:20:41.93,0:20:46.47,Main,,0,0,0,,Sanji'nin arkadaşı olan şu kızı gönderselerdi keşke.Dialogue: 0,0:20:46.47,0:20:52.02,Main,,0,0,0,,Bildim onu! Nami isimli kızı diyorsun, değil mi? Öyle gözü pek hatunları severim.Dialogue: 0,0:20:53.04,0:20:56.48,Main,,0,0,0,,Big Mom'ın eline düştüğünü işitmiştim.Dialogue: 0,0:20:56.48,0:20:59.82,Main,,0,0,0,,Yarın izin verirse o hatunu isterim.Dialogue: 0,0:21:05.88,0:21:11.75,Main,,0,0,0,,Pekâlâ, bu kadar içmek yeter. Yarın gece de ziyafet var.Dialogue: 0,0:21:13.07,0:21:17.40,Main,,0,0,0,,Germa, Yonkou Big Mom ile ittifak kurarak...Dialogue: 0,0:21:17.40,0:21:21.05,Main,,0,0,0,,...bir kez daha Kuzey Mavi'yi fethedecek!Dialogue: 0,0:21:21.05,0:21:24.17,Main,,0,0,0,,Şanlı Germa küçümsenip...Dialogue: 0,0:21:24.17,0:21:32.64,Main,,0,0,0,,...Kuzey Mavi'deki iğrenç ülkeler  tarafından aşağılandı. İntikam günü yakındır!Dialogue: 0,0:21:32.64,0:21:36.00,Main,,0,0,0,,Yarın fethimizi önceden kutlamış olacağız!Dialogue: 0,0:21:39.66,0:21:48.56,Main,,0,0,0,,Uzun zamandır Vinsmokelar'a utançtan başka bir şey getirmemiş olan o fiyasko da nihayet bir halta yarayacak.Dialogue: 0,0:21:48.56,0:21:53.01,Main,,0,0,0,,Harbi ha! Sanji'yi yem ederek turnayı gözünden vurduk!Dialogue: 0,0:21:53.01,0:21:58.83,Main,,0,0,0,,Düşmanlarımız Germa filomuzda Big Mom korsan bayrağını görünce savaşma istekleri uçup gidecek.Dialogue: 0,0:21:58.83,0:22:03.51,Main,,0,0,0,,Bundan sonra daha güçlü denizleri de fethedebiliriz.Dialogue: 0,0:22:04.27,0:22:06.68,Main,,0,0,0,,Sanji'ye minnettar olmalıyız.Dialogue: 0,0:22:06.68,0:22:09.30,Main,,0,0,0,,Sanji'ye minnettar mı olalım?!Dialogue: 0,0:22:12.94,0:22:14.73,Main,,0,0,0,,Fiyaskoya!Dialogue: 0,0:22:14.73,0:22:16.60,Main,,0,0,0,,Bir halta yarayan serseriye!Dialogue: 0,0:22:16.60,0:22:19.14,Main,,0,0,0,,Şerefe!Dialogue: 0,0:22:23.23,0:22:28.54,Main,,0,0,0,,Yarınki çay partisine kadar Vinsmokelar'ı kimseyle görüştürmeyin.Dialogue: 0,0:22:28.54,0:22:29.90,Main,,0,0,0,,Anlaşıldı.Dialogue: 0,0:22:29.90,0:22:34.33,Main,,0,0,0,,Reiju-sama'nın bulunduğu üçüncü kattaki sağlık merkezine de asker konuşlandırdım efendim.Dialogue: 0,0:22:30.12,0:22:34.33,Captions,,0,0,0,,Vinsmoke Ailesine Ayrılmış Misafir Odası ÖnüDialogue: 0,0:22:34.82,0:22:37.00,Main,,0,0,0,,- Gözünüzü dört açın. - Emredersiniz.Dialogue: 0,0:22:37.54,0:22:41.22,Main,,0,0,0,,Vinsmokelar kaderlerinden kaçamayacak.Dialogue: 0,0:22:41.22,0:22:43.38,Main,,0,0,0,,Üstüne vazife olmayan şeyler söyleme!Dialogue: 0,0:22:44.16,0:22:45.26,Main,,0,0,0,,Beyinsiz!Dialogue: 0,0:22:52.54,0:22:54.26,Main,,0,0,0,,Hay içine...Dialogue: 0,0:22:55.52,0:22:58.48,Main,,0,0,0,,Şerefsizler!Dialogue: 0,0:23:35.93,0:23:40.85,Captions,,0,0,0,,Şehrin EteklerindeDialogue: 0,0:23:50.76,0:23:54.20,Flashbacks,,0,0,0,,Defolup gidin, aşağılık korsanlar!Dialogue: 0,0:24:29.28,0:24:30.69,Main,,0,0,0,,Hanji...Dialogue: 0,0:24:39.65,0:24:43.75,Main,,0,0,0,,Beklemeni söylemedim ki.Dialogue: 0,0:24:45.52,0:24:46.67,Flashbacks,,0,0,0,,Reddediyorum!Dialogue: 0,0:24:53.51,0:24:55.22,Main,,0,0,0,,Yiyebildiğini ye.Dialogue: 0,0:24:57.86,0:24:59.72,Main,,0,0,0,,Yemek...Dialogue: 0,0:25:05.46,0:25:10.69,Main,,0,0,0,,Buraya gelirken elimden düştü.  Hepsi birbirine girdi, yağmur suyu da karıştı.Dialogue: 0,0:25:21.59,0:25:23.66,Main,,0,0,0,,Bir fiyasko daha, ha?Dialogue: 0,0:25:44.94,0:25:46.65,Main,,0,0,0,,Leziz!Dialogue: 0,0:26:00.95,0:26:03.04,Main,,0,0,0,,Yediğim en lezzetli yemek ya!Dialogue: 0,0:26:04.79,0:26:08.00,Main,,0,0,0,,Bizim en sevdiklerimizi karıştırmışsın!Dialogue: 0,0:26:08.00,0:26:11.71,Main,,0,0,0,,Keşke bizimkiler de tadabilseydi!Dialogue: 0,0:26:14.93,0:26:17.76,Main,,0,0,0,,Harika olmuş!Dialogue: 0,0:26:17.76,0:26:20.01,Main,,0,0,0,,Süper ya! Süper!Dialogue: 0,0:26:20.94,0:26:22.56,Thoughts,,0,0,0,,Yalan söylemesene!Dialogue: 0,0:26:27.32,0:26:30.04,Main,,0,0,0,,Çok güzel geldi ya!Dialogue: 0,0:26:30.04,0:26:32.36,Main,,0,0,0,,Az daha açlıktan ölüyordum.Dialogue: 0,0:26:36.54,0:26:38.04,Main,,0,0,0,,Yemeğini yediysen git artık.Dialogue: 0,0:26:39.95,0:26:42.28,Main,,0,0,0,,Ne diyorsun sen? Sen de bizimle geliyorsun!Dialogue: 0,0:26:46.58,0:26:47.79,Main,,0,0,0,,İlk olarak...Dialogue: 0,0:26:48.50,0:26:54.22,Main,,0,0,0,,...benim için onca yolu tepen kaptanıma hakaretler ettim.Dialogue: 0,0:26:54.22,0:26:57.97,Main,,0,0,0,,Yetmezmiş gibi karşılık vermediğin hâlde en güçlü saldırılarımı kullandım.Dialogue: 0,0:27:00.18,0:27:05.38,Main,,0,0,0,,Bu yüzden artık gemine adım atamam.Dialogue: 0,0:27:10.33,0:27:11.48,Main,,0,0,0,,İkinci neden...Dialogue: 0,0:27:12.71,0:27:20.26,Main,,0,0,0,,Büyüdüğüm ve de vefa borcum olan kokuşmuş ihtiyarla deniz restoranı Baratie...Dialogue: 0,0:27:20.26,0:27:22.95,Main,,0,0,0,,...planlarında bir değişik olursa diye rehin alındılar.Dialogue: 0,0:27:25.62,0:27:31.46,Main,,0,0,0,,Bu yüzden düğünden kaçamam.Dialogue: 0,0:27:41.34,0:27:42.73,Main,,0,0,0,,Üçüncü neden ise...Dialogue: 0,0:27:42.73,0:27:47.08,Main,,0,0,0,,...Big Mom biyolojik aileme tuzak kurmuş.Dialogue: 0,0:27:48.14,0:27:51.27,Main,,0,0,0,,Birkaç saat sonra hepsi ölecek.Dialogue: 0,0:27:55.62,0:28:02.24,Flashbacks,,0,0,0,,Kaçmadığın sürece her şey tatlı tatlı çözülür Sanji.Dialogue: 0,0:28:07.95,0:28:12.46,Main,,0,0,0,,Biyolojik babama, abilerime ve kardeşime karşı...Dialogue: 0,0:28:12.46,0:28:14.64,Main,,0,0,0,,...hiçbir bağım yok.Dialogue: 0,0:28:15.34,0:28:17.76,Main,,0,0,0,,Aşağılık herifler için nefretten başka bir his beslemiyorum!Dialogue: 0,0:28:20.84,0:28:24.97,Flashbacks,,0,0,0,,Ölmeyi hak eden fiyaskonun tekisin!Dialogue: 0,0:28:24.97,0:28:28.81,Flashbacks,,0,0,0,,Sakın diğer insanların önünde...Dialogue: 0,0:28:29.30,0:28:33.36,Flashbacks,,0,0,0,,...baban olduğumu söyleme!Dialogue: 0,0:28:33.36,0:28:36.67,Flashbacks,,0,0,0,,Kimsenin bilmesini istemediğim bir utancımsın!Dialogue: 0,0:28:39.93,0:28:41.74,Main,,0,0,0,,Yine de...Dialogue: 0,0:28:44.72,0:28:46.03,Main,,0,0,0,,...onlara...Dialogue: 0,0:28:52.38,0:28:55.15,Main,,0,0,0,,...sırtımı dönemiyorum!Dialogue: 0,0:29:10.18,0:29:16.73,Main,,0,0,0,,Bu üç sebep dolayısıyla sizinle birlikte çekip gidemem.Dialogue: 0,0:29:26.11,0:29:28.91,Main,,0,0,0,,Cevabını aldıysan git artık.Dialogue: 0,0:30:34.52,0:30:38.19,Main,,0,0,0,,Asıl içinden geçenleri söyle!Dialogue: 0,0:30:52.42,0:30:55.04,Flashbacks,,0,0,0,,Sanji! Açım!Dialogue: 0,0:30:55.04,0:30:57.40,Flashbacks,,0,0,0,,Bir şeyler pişir be, aptal!Dialogue: 0,0:30:57.40,0:31:00.92,Flashbacks,,0,0,0,,Sanji-kun, bugün yemekte ne var?Dialogue: 0,0:31:16.02,0:31:18.89,Flashbacks,,0,0,0,,Yemeği kim arakladı lan?Dialogue: 0,0:31:19.65,0:31:21.81,Flashbacks,,0,0,0,,Sizin olduğunuzu anlamıştım!Dialogue: 0,0:31:22.76,0:31:25.78,Flashbacks,,0,0,0,,Ceza olarak akşam yemeğini unutun!Dialogue: 0,0:31:47.51,0:31:51.09,Main,,0,0,0,,Luffy... Ben...Dialogue: 0,0:31:52.64,0:31:55.40,Main,,0,0,0,,Sunny-go'ya...Dialogue: 0,0:31:55.40,0:31:57.58,Main,,0,0,0,,...geri dönmek istiyorum!Dialogue: 0,0:32:05.30,0:32:10.95,Main,,0,0,0,,Fakat kaçıp gidecek cesaretim yok!Dialogue: 0,0:32:18.33,0:32:23.31,Main,,0,0,0,,Düğün başladı mı, tek başıma...Dialogue: 0,0:32:24.32,0:32:27.00,Main,,0,0,0,,...hiçbir şeye engel olamayacağımı biliyorum!Dialogue: 0,0:32:28.14,0:32:30.66,Main,,0,0,0,,O aşağılık herifleri...Dialogue: 0,0:32:32.56,0:32:34.98,Main,,0,0,0,,...ailemden saymıyorum bile!Dialogue: 0,0:32:39.61,0:32:40.77,Main,,0,0,0,,Yine de...Dialogue: 0,0:32:43.36,0:32:46.09,Main,,0,0,0,,...onları kurtarmak istiyorum.Dialogue: 0,0:32:55.07,0:32:58.74,Main,,0,0,0,,Çünkü sen böyle birisin.Dialogue: 0,0:33:03.48,0:33:07.50,Main,,0,0,0,,Yanındayız! Düğünü mahvedelim haydi!