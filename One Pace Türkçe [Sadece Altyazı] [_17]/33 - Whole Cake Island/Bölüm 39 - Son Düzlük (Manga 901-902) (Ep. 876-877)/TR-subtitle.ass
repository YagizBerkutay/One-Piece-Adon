Dialogue: 0,0:18:51.94,0:18:58.63,Lyrics,,0,0,0,karaoke,♪ Ruh Pokusu! ♪
Dialogue: 0,0:18:55.06,0:18:58.63,Lyrics,,0,0,80,karaoke,-- Ruh Pokusu! --
Dialogue: 0,0:18:58.63,0:19:04.34,Lyrics,,0,0,0,karaoke,♪ Ruhların ağzından... ♪
Dialogue: 0,0:19:04.34,0:19:10.46,Lyrics,,0,0,0,karaoke,♪ Hiç mi hiç istemeyerek...
Dialogue: 0,0:19:10.46,0:19:16.61,Lyrics,,0,0,0,karaoke,...gemi rüzgârla birlikte uzaklaşırken bir akıntıda...
Dialogue: 0,0:19:16.61,0:19:26.06,Lyrics,,0,0,0,karaoke,...cengin denizinden. ♪
Dialogue: 0,0:19:53.96,0:19:57.80,Lyrics,,0,0,0,karaoke,♪ Mama kendine geldi! ♪
Dialogue: 0,0:19:58.18,0:19:59.92,Lyrics,,0,0,0,karaoke,♪ Çiçek! ♪
Dialogue: 0,0:19:59.92,0:20:06.01,Lyrics,,0,0,0,karaoke,♪ Pek hoşgörülü olmasalar da...
Dialogue: 0,0:20:06.01,0:20:11.89,Lyrics,,0,0,0,karaoke,...neşeyle şarkı söyleyen çiçeklerle ağaçlar...
Dialogue: 0,0:20:11.89,0:20:16.09,Lyrics,,0,0,0,karaoke,...nazikçe aklımızı çelerler. ♪
Dialogue: 0,0:20:16.09,0:20:22.32,Lyrics,,0,0,0,karaoke,♪ Ruh Pokusu! ♪
Dialogue: 0,0:20:22.32,0:20:35.52,Lyrics,,0,0,0,karaoke,♪ Doyumsuz Mama'nın çevirdiği bir dolap. ♪
Dialogue: 0,0:20:40.14,0:20:43.25,Lyrics,,0,0,0,karaoke,♪ Düzmece bir prens ile...
Dialogue: 0,0:20:43.25,0:20:46.51,Lyrics,,0,0,0,karaoke,...güzeller güzeli bir prensesin...
Dialogue: 0,0:20:46.51,0:20:58.44,Lyrics,,0,0,0,karaoke,...kukla gösterisinde ipleri birbirinden uzaklaştırılmıştı. ♪
Dialogue: 0,0:20:58.44,0:21:10.95,Lyrics,,0,0,0,karaoke,♪ Kokusuyla bizi kendine çeken \N bitki özlerinin dahi bir hinliği vardır. ♪
Dialogue: 0,0:21:10.95,0:21:22.84,Lyrics,,0,0,80,karaoke,♪ Bu dünyada yoktur ki baş döndüren
Dialogue: 0,0:21:10.95,0:21:22.84,Lyrics,,0,0,0,karaoke,hoş kokudan beteri, ey dostlar! ♪
Dialogue: 0,0:21:22.84,0:21:30.07,Lyrics,,0,0,0,karaoke,♪ Farkında bile olmadan yanından\N geçip giden gölgeler misali...
Dialogue: 0,0:21:30.07,0:21:41.44,Lyrics,,0,0,0,karaoke,...hayatları pamuk ipliğine bağlı bir \Nmaymun gösterisi! ♪
Dialogue: 0,0:21:49.18,0:21:52.20,Lyrics,,0,0,0,karaoke,♪ Karşılarken verirsin şeker! ♪
Dialogue: 0,0:21:52.20,0:21:55.69,Lyrics,,0,0,0,karaoke,♪ Giderken ise giyotin! ♪
Dialogue: 0,0:21:55.70,0:22:06.47,Lyrics,,0,0,0,karaoke,♪ Galip ayrılan kim olmuştur bilinmez. \N Hepsi gösterinin bir parçasıdır. ♪
Dialogue: 0,0:31:01.62,0:31:08.10,Lyrics,,0,0,0,karaoke,♪ Ruh Pokusu! ♪
Dialogue: 0,0:31:04.50,0:31:08.10,Lyrics,,0,0,80,karaoke,-- Ruh Pokusu! --
Dialogue: 0,0:31:08.10,0:31:14.31,Lyrics,,0,0,0,karaoke,♪ Bir bencilin ağzından... ♪
Dialogue: 0,0:31:14.31,0:31:20.36,Lyrics,,0,0,0,karaoke,♪ Taptatlı bir pasta kokusunun cazibesine kapılınca...
Dialogue: 0,0:31:20.36,0:31:28.12,Lyrics,,0,0,0,karaoke,...ilk önce sormalısın bedelini! ♪
Dialogue: 0,0:31:29.59,0:31:41.67,Lyrics,,0,0,0,karaoke,♪ Bize bir faydası yoktur hiç! ♪
Dialogue: 0,0:31:41.67,0:31:53.69,Lyrics,,0,0,0,karaoke,♪ Ya şeker vereceksin ya da \Neşek şakasına maruz kalacaksın! ♪
Dialogue: 0,0:31:53.69,0:32:06.87,Lyrics,,0,0,0,karaoke,♪ Bu dünyada yoktur ki baş döndüren \Nhoş kokudan beteri, ey dostlar! ♪
Dialogue: 0,0:32:10.69,0:32:14.67,Lyrics,,0,0,0,karaoke,♪ Ruh Pokusu! ♪
Dialogue: 0,0:32:14.67,0:32:17.75,Lyrics,,0,0,0,karaoke,♪ Bencil mi bencil...
Dialogue: 0,0:32:17.75,0:32:25.84,Lyrics,,0,0,0,karaoke,...Mama! ♪
Dialogue: 0,0:32:25.84,0:32:29.01,Lyrics,,0,0,0,karaoke,♪ Ömründen mi verirsin? ♪
Dialogue: 0,0:32:29.01,0:32:33.40,Lyrics,,0,0,0,karaoke,♪ Yoksa ölür müsün? ♪
Dialogue: 0,0:32:33.40,0:32:37.21,Lyrics,,0,0,0,karaoke,♪ Ruh Pokusu! ♪
Dialogue: 0,0:32:37.21,0:32:40.19,Lyrics,,0,0,0,karaoke,♪ Kraliçemizin...
Dialogue: 0,0:32:40.19,0:32:46.55,Lyrics,,0,0,0,karaoke,...şarkısı! ♪
Dialogue: 0,0:01:38.51,0:01:41.99,Captions,,0,0,170,,{\fad(500,0)}Kabartma Adası
Dialogue: 0,0:01:39.65,0:01:41.99,Main,,0,0,1,,Mama! Mama!
Dialogue: 0,0:01:42.01,0:01:46.86,Author,,0,0,0,,{\fad(500,0)\fs18} Türkçeleştirme & Çevirmen  {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&} - {\c&H01BAFF&}{\b1}dmc3{\b0}{\c&HFFFFFF&}\N{\fs17}thx to onepace.net
Dialogue: 0,0:16:43.30,0:16:53.30,Author,,0,0,0,,{\fad(500,500)\fs18} Türkçeleştirme & Çevirmen  {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&} - {\c&H01BAFF&}{\b1}dmc3{\b0}{\c&HFFFFFF&}\N{\fs17}thx to onepace.net
Dialogue: 0,0:34:24.96,0:34:29.98,Author,,0,0,0,,{\fad(0,0)\fs18} Türkçeleştirme & Çevirmen  {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&} - {\c&H01BAFF&}{\b1}dmc3{\b0}{\c&HFFFFFF&}\N{\fs17}thx to onepace.net
Dialogue: 0,0:34:24.96,0:34:29.98,Main,,0,0,0,,# teşekkürler dmc3 #
Dialogue: 0,0:01:42.01,0:01:46.86,Title,,0,0,0,,{\pos(640, 450)\an5\fad(500,0)}Son Düzlük
Dialogue: 0,0:01:44.39,0:01:46.29,Main,,0,0,0,,Perospero-{\i1}sama{\i}...
Dialogue: 0,0:01:47.59,0:01:48.94,Main,,0,0,0,,Akıl alır iş değil!
Dialogue: 0,0:01:49.98,0:01:53.08,Main,,0,0,0,,Eski hâline dönüverdi.
Dialogue: 0,0:01:53.08,0:01:56.91,Main,,0,0,0,,Pudding harikulade bir pasta yapmış ya.
Dialogue: 0,0:02:01.71,0:02:06.42,Main,,0,0,0,,Mama'nın suratında böyle bir neşe\Ngörmemiştim hiç-perorin.
Dialogue: 0,0:02:09.22,0:02:14.09,Main,,0,0,0,,Mama! Kaptanımızsın!\NDurum raporu sunmam gerek!
Dialogue: 0,0:02:14.82,0:02:18.39,Main,,0,0,0,,Öncelikle, \NBege hâlâ bu civarda bir yerdedir.
Dialogue: 0,0:02:20.70,0:02:23.55,Main,,0,0,0,,Çok mutluyum ya...
Dialogue: 0,0:02:23.55,0:02:26.10,Main,,0,0,0,,Kime diyorum ki?
Dialogue: 0,0:02:26.23,0:02:29.48,Captions,,60,0,1,,{\fad(500,0)}Kakao Adası
Dialogue: 0,0:02:32.81,0:02:33.53,Main,,0,0,0,,O gemi...
Dialogue: 0,0:02:35.33,0:02:36.61,Main,,0,0,0,,Bekleyin!
Dialogue: 0,0:02:39.95,0:02:41.90,Main,,0,0,0,,Yanıldık!
Dialogue: 0,0:02:41.90,0:02:44.75,Main,,0,0,0,,Yanan, Hasır Şapkalar'ın gemisi değil!
Dialogue: 0,0:02:45.75,0:02:47.04,Main,,0,0,0,,Ne?
Dialogue: 0,0:02:49.75,0:02:53.63,Main,,0,0,0,,Güneş Korsanları'nın gemisi!
Dialogue: 0,0:02:53.63,0:02:56.88,Main,,0,0,0,,Mümkün değil!\NDoğrudan isabet etmiş olmalıydı!
Dialogue: 0,0:02:56.88,0:02:58.22,Main,,0,0,0,,Gemileri mi değişmişler?
Dialogue: 0,0:02:58.22,0:03:02.53,Main,,0,0,0,,Öyleyse Hasır Şapkalar nereye kayboldu?
Dialogue: 0,0:03:08.46,0:03:09.90,Main,,0,0,0,,Çabuk Wadatsumi!
Dialogue: 0,0:03:09.90,0:03:11.86,Main,,0,0,0,,Daha uzağa götür!
Dialogue: 0,0:03:24.84,0:03:26.70,Main,,0,0,0,,Emin misiniz?
Dialogue: 0,0:03:26.70,0:03:29.87,Main,,0,0,0,,Bu, Fisher Tiger'ın yaptığı\Nefsanevi bir gemidir!
Dialogue: 0,0:03:29.87,0:03:31.21,Main,,0,0,0,,Yap gitsin!
Dialogue: 0,0:03:31.21,0:03:32.75,Main,,0,0,0,,Tamam!
Dialogue: 0,0:03:32.75,0:03:35.63,Main,,0,0,0,,Çabuk! Vaktimiz kalmadı!
Dialogue: 0,0:03:42.72,0:03:44.68,Main,,0,0,0,,Yandım ya!
Dialogue: 0,0:03:54.55,0:03:55.94,Thoughts,,0,0,0,,{\i1}Ne? N'oluyor?
Dialogue: 0,0:04:04.49,0:04:06.41,Thoughts,,0,0,0,,{\i1}Bizi yiyecek!
Dialogue: 0,0:04:07.47,0:04:09.37,Thoughts,,0,0,0,,{\i1}Biraz sıkın dişinizi.
Dialogue: 0,0:04:09.37,0:04:11.11,Main,,0,0,0,,Ne oluyor?
Dialogue: 0,0:04:11.11,0:04:13.46,Main,,0,0,0,,Nereye geldik?
Dialogue: 0,0:04:13.86,0:04:15.80,Main,,0,0,0,,Wadatsumi'nin ağzının içindeyiz!
Dialogue: 0,0:04:18.71,0:04:20.49,Thoughts,,0,0,0,,{\i1}Tüyelim!
Dialogue: 0,0:04:29.00,0:04:30.23,Main,,0,0,0,,Suyun altındalar!
Dialogue: 0,0:04:30.23,0:04:34.48,Main,,0,0,0,,Anlam vermeye çalıştığım belirti\N*Umibozu'nun eliymiş meğer!
Dialogue: 0,0:04:34.48,0:04:37.76,Main,,0,0,0,,Tüm gemiler! \N180 dereceyle pupa istikametine dönün!
Dialogue: 0,0:04:42.21,0:04:46.59,Main,,0,0,0,,Kaçamazsınız kokuşmuş Balık Adamlar!
Dialogue: 0,0:04:57.40,0:04:58.77,Main,,0,0,0,,{\fad(150,150)}Nekkai...
Dialogue: 0,0:04:57.40,0:04:58.77,Attack,,0,0,0,,{\fad(150,150)}Kaynayan Derya...
Dialogue: 0,0:05:01.11,0:05:02.11,Main,,0,0,0,,{\fad(150,150)}Gyorai!
Dialogue: 0,0:05:01.11,0:05:02.11,Attack,,0,0,0,,{\fad(150,150)}Torpidosu
Dialogue: 0,0:05:21.05,0:05:23.96,Main,,0,0,0,,Çok sıcak!
Dialogue: 0,0:05:29.89,0:05:32.66,Main,,0,0,0,,Yandım ya!
Dialogue: 0,0:05:32.66,0:05:34.49,Main,,0,0,0,,Hasır Şapka gemisi su yüzeyine çıktı!
Dialogue: 0,0:05:34.49,0:05:36.14,Main,,0,0,0,,Wada-kichi!
Dialogue: 0,0:05:36.14,0:05:39.36,Main,,0,0,0,,Ateş!\NHasır Şapka'nın gemisini batırın!
Dialogue: 0,0:05:42.44,0:05:44.83,Main,,0,0,0,,Gidin çocuklar!
Dialogue: 0,0:05:46.30,0:05:51.58,Main,,0,0,0,,Hasır Şapka! \NBalık Adam Adası'nda kötü bir çocuktum.
Dialogue: 0,0:05:52.49,0:05:55.04,Main,,0,0,0,,Özür dilerim!
Dialogue: 0,0:06:00.44,0:06:07.26,Main,,0,0,0,,Yine de beni yanına alan\NPatron Jinbe'ye minnettarım!
Dialogue: 0,0:06:08.16,0:06:10.66,Main,,0,0,0,,Adi yaratık...
Dialogue: 0,0:06:10.66,0:06:12.83,Main,,0,0,0,,Çekil lan! Umibozu!
Dialogue: 0,0:06:17.00,0:06:18.59,Main,,0,0,0,,Yanıyorum!
Dialogue: 0,0:06:19.43,0:06:20.38,Main,,0,0,0,,Wadatsumi!
Dialogue: 0,0:06:20.38,0:06:26.21,Main,,0,0,0,,Patronumuz Hasır Şapkalar'a katılmak\Nistediğini söylediğinden beri...
Dialogue: 0,0:06:26.88,0:06:28.41,Main,,0,0,0,,...kafamıza koymuştuk!
Dialogue: 0,0:06:32.68,0:06:37.27,Main,,0,0,0,,Mama ayrılmak isteyen herkesi gebertir.
Dialogue: 0,0:06:41.30,0:06:43.82,Main,,0,0,0,,Öyleyse bize düşen...
Dialogue: 0,0:06:43.82,0:06:47.84,Main,,0,0,0,,Kaptan Jinbe'ye kalkan görevi görüp\Ncan vermemizi mi istiyorsun?
Dialogue: 0,0:06:48.55,0:06:51.94,Main,,0,0,0,,Hepimiz ölürsek olmaz ama!\NBirimiz sağ kalıp hikâyemizi anlatmalı!
Dialogue: 0,0:06:51.94,0:06:53.62,Main,,0,0,0,,Doğru diyorsun bak!
Dialogue: 0,0:06:56.33,0:07:02.00,Main,,0,0,0,,Kaçmak isteyenlere tek laf edemem!\NPeşimden gelecekler ise gözünü karartsın!
Dialogue: 0,0:07:04.47,0:07:09.96,Main,,0,0,0,,Jinbe'nin açtığı yeni sayfaya\Nmani olamayacaklar!
Dialogue: 0,0:07:14.79,0:07:16.89,Main,,0,0,0,,Hepimiz bu karara vardık!
Dialogue: 0,0:07:22.23,0:07:23.78,Main,,0,0,0,,Geri çekil Wadatsumi!
Dialogue: 0,0:07:35.79,0:07:37.75,Main,,0,0,0,,Aladdin! Millet!
Dialogue: 0,0:07:37.76,0:07:40.79,Main,,0,0,0,,Kaçın Jinbe! Hasır Şapkalar!
Dialogue: 0,0:07:56.99,0:08:01.44,Main,,0,0,0,,Sizi böyle uğurluyoruz!
Dialogue: 0,0:08:12.28,0:08:14.33,Main,,0,0,0,,Haydi millet!
Dialogue: 0,0:08:40.28,0:08:41.52,Main,,0,0,0,,Luffy...
Dialogue: 0,0:08:47.07,0:08:52.91,Main,,0,0,0,,Yelken alan bir geminin düşmanı\Nsu almasıdır. Derhâl suyu atın!
Dialogue: 0,0:08:55.61,0:08:58.00,Main,,0,0,0,,Gemi gitgide ağırlaşıp yavaşlıyor.
Dialogue: 0,0:08:58.00,0:09:02.68,Main,,0,0,0,,Yelkenlerdeki yırtıkları onarıp\Ndoğru açıyla rüzgârı yakalayarak...
Dialogue: 0,0:09:02.68,0:09:05.46,Main,,0,0,0,,...olabildiğince hızlı yelken alın!
Dialogue: 0,0:09:06.77,0:09:11.00,Main,,0,0,0,,Bölge sularından çıkmak\Ndaha birkaç saat sürer!
Dialogue: 0,0:09:11.00,0:09:14.22,Main,,0,0,0,,N'apıyorsun Jinbe?\NNe demeye getiriyorsun?
Dialogue: 0,0:09:20.16,0:09:21.84,Main,,0,0,0,,Luffy...
Dialogue: 0,0:09:25.33,0:09:28.98,Main,,0,0,0,,Onları ardımda bırakamam.
Dialogue: 0,0:09:39.50,0:09:41.58,Main,,0,0,0,,Tamam, anlaşıldı!
Dialogue: 0,0:09:42.40,0:09:44.00,Main,,0,0,0,,Öyleyse biz de kalıyoruz!
Dialogue: 0,0:09:45.14,0:09:48.02,Main,,0,0,0,,Bu geminin kaçması için\Nartçı olarak kalacağım!
Dialogue: 0,0:09:50.51,0:09:56.93,Main,,0,0,0,,Ardınızda o sancak gemisiyle filo olduğu\Nsürece asla izinizi kaybettiremezsiniz!
Dialogue: 0,0:09:56.93,0:10:00.00,Main,,0,0,0,,Arkamızı kollamayı...
Dialogue: 0,0:10:00.00,0:10:02.73,Main,,0,0,0,,...bana bırak!
Dialogue: 0,0:10:06.38,0:10:09.73,Main,,0,0,0,,Arkamızı sağlama alıp\Nsağ olarak döneceğim!
Dialogue: 0,0:10:32.64,0:10:34.70,Main,,0,0,0,,Şunu unutma Jinbe!
Dialogue: 0,0:10:37.49,0:10:41.08,Main,,0,0,0,,Kaptanın benim artık!
Dialogue: 0,0:10:51.80,0:10:53.62,Main,,0,0,0,,{\fad(150,150)}Maji Giren
Dialogue: 0,0:10:51.80,0:10:53.62,Attack,,0,0,0,,{\fad(150,150)}İfrit Kesişi
Dialogue: 0,0:10:59.21,0:11:00.94,Main,,0,0,0,,Gemilerini durduramam.
Dialogue: 0,0:11:02.24,0:11:06.40,Main,,0,0,0,,Wano Ülkesi'nde seni bekliyor olacağım!\NNe pahasına olursa olsun gel!
Dialogue: 0,0:11:08.41,0:11:09.24,Main,,0,0,0,,Luffy!
Dialogue: 0,0:11:23.87,0:11:25.67,Main,,0,0,0,,Teşekkürler!
Dialogue: 0,0:11:27.11,0:11:28.05,Main,,0,0,0,,Jinbe!
Dialogue: 0,0:11:31.64,0:11:34.22,Main,,0,0,0,,Canını alsalar bile ölme!
Dialogue: 0,0:11:45.17,0:11:49.23,Main,,0,0,0,,Hasır Şapka veledi hâlâ yaşıyor mu?
Dialogue: 0,0:11:49.23,0:11:52.49,Main,,0,0,0,,Yaşamasına yaşıyor da...
Dialogue: 0,0:11:52.49,0:11:57.46,Main,,0,0,0,,...Kakao Adası'nda kardeşlerimin\Nonunla savaştığını öğrendim.
Dialogue: 0,0:11:57.46,0:11:59.20,Main,,0,0,0,,Kaçacak yeri kalmadı!
Dialogue: 0,0:11:59.22,0:12:03.20,Main,,0,0,0,,Kesinkes ölmemiş ise geliyorum!
Dialogue: 0,0:12:03.20,0:12:06.46,Main,,0,0,0,,Çabuk ol, Benekli Şeker Kurbağası!
Dialogue: 0,0:12:07.29,0:12:10.44,Main,,0,0,0,,Son duanı et, Hasır Şapka!
Dialogue: 0,0:12:10.44,0:12:16.03,Main,,0,0,0,,Ruhundan amansız Homies yapıp\Nher emrime itaat etmeni sağlayacağım!
Dialogue: 0,0:12:29.24,0:12:31.59,Main,,0,0,0,,Postu kurtardık.
Dialogue: 0,0:12:31.59,0:12:36.99,Main,,0,0,0,,Yaşamak güzel şey.\NUsulca yolumuza bakalım.
Dialogue: 0,0:12:36.99,0:12:39.53,Main,,0,0,0,,Germa için endişeleniyorum-rero.
Dialogue: 0,0:12:39.53,0:12:40.99,Main,,0,0,0,,Kes sesini!
Dialogue: 0,0:12:54.48,0:12:56.05,Main,,0,0,0,,Kül ol lan!
Dialogue: 0,0:12:56.05,0:12:58.01,Main,,0,0,0,,{\fad(150,150)}Heat Denasshi!
Dialogue: 0,0:12:56.05,0:12:58.01,Attack,,0,0,0,,{\fad(150,150)}Sıcak Rüzgar Yumruğu
Dialogue: 0,0:13:14.73,0:13:16.38,Main,,0,0,0,,İyi misin Aladdin?
Dialogue: 0,0:13:16.38,0:13:18.53,Main,,0,0,0,,Jinbe! Aramıza mı döndün?
Dialogue: 0,0:13:18.53,0:13:22.25,Main,,0,0,0,,Hayır, hâlâ Hasır Şapka mürettebatıyım!
Dialogue: 0,0:13:22.25,0:13:25.91,Main,,0,0,0,,Kaptanımı kurtarmak için geride kaldım!
Dialogue: 0,0:13:27.50,0:13:29.58,Main,,0,0,0,,Hayret bir şeysin!
Dialogue: 0,0:13:29.58,0:13:32.71,Main,,0,0,0,,Bizi küçümsüyorsun resmen!
Dialogue: 0,0:13:33.69,0:13:35.46,Main,,0,0,0,,Sen öyle diyorsan kardeşim.
Dialogue: 0,0:13:37.18,0:13:39.81,Main,,0,0,0,,Hepiniz de sağ kalıp...
Dialogue: 0,0:13:39.81,0:13:43.01,Main,,0,0,0,,...beni yolcu etmelisiniz!
Dialogue: 0,0:13:43.01,0:13:47.32,Main,,0,0,0,,Ne kadar güçlü olduğunuzu\Nen iyi ben bilirim!
Dialogue: 0,0:13:47.32,0:13:51.75,Main,,0,0,0,,Bu gücünüzü Hasır Şapkalar'ın\Nkaçmasına yardım etmek için kullanalım!
Dialogue: 0,0:14:19.59,0:14:21.26,Main,,0,0,0,,Aşağılık balıklar...
Dialogue: 0,0:14:23.28,0:14:24.81,Main,,0,0,0,,Girdap!
Dialogue: 0,0:14:39.48,0:14:43.62,Main,,0,0,0,,Brook! Tüm hızımızla\Nolabildiğince yol almaya bak!
Dialogue: 0,0:14:43.62,0:14:45.83,Main,,0,0,0,,Anlaşıldı!
Dialogue: 0,0:14:51.09,0:14:55.17,Flashbacks,,0,0,0,,Bir Balık Adam gözünü kararttı mı\Ndeniz akıntılarına bile hükmeder!
Dialogue: 0,0:14:56.13,0:14:57.13,Main,,0,0,0,,İnanılmaz!
Dialogue: 0,0:14:57.13,0:14:58.05,Main,,0,0,0,,Deniz...
Dialogue: 0,0:15:04.12,0:15:08.89,Main,,0,0,0,,Balık Adamlar'ın oluşturduğu akıntı\Nbizi taşıyor!
Dialogue: 0,0:15:10.78,0:15:12.19,Main,,0,0,0,,Jinbe...
Dialogue: 0,0:15:18.29,0:15:22.57,Main,,0,0,0,,Hasır Şapka Luffy, \NJinbe'yi artçı olarak bırakıp uzaklaşıyor!
Dialogue: 0,0:15:22.57,0:15:25.32,Main,,0,0,0,,Filomuz ise tamamen hareketsiz kaldı!
Dialogue: 0,0:15:25.32,0:15:28.45,Main,,0,0,0,,{\i1}İzlerini kaybetmek üzereyiz!
Dialogue: 0,0:15:31.59,0:15:33.55,Main,,0,0,0,,İşte bu! Yürü be Hasır Şapka!
Dialogue: 0,0:15:33.55,0:15:35.29,Main,,0,0,0,,Çocuğu pek bi' destekliyorsun sanki?
Dialogue: 0,0:15:35.29,0:15:38.86,Main,,0,0,0,,Evet, Hasır Şapka da adaylardan biri zira.
Dialogue: 0,0:15:38.86,0:15:39.92,Main,,0,0,0,,Neyin adayıymış?
Dialogue: 0,0:15:40.45,0:15:45.76,Main,,0,0,0,,Stussy... \NEn Kötü Nesil'den haberin var, değil mi?
Dialogue: 0,0:15:47.00,0:15:49.97,Main,,0,0,0,,"Ölüm Cerrahı" Trafalgar Law.
Dialogue: 0,0:15:51.14,0:15:54.02,Main,,0,0,0,,"Sihirbaz" Basil Hawkins.
Dialogue: 0,0:15:55.13,0:15:57.77,Main,,0,0,0,,"Kızıl Bayrak" X. Drake.
Dialogue: 0,0:15:59.04,0:16:01.74,Main,,0,0,0,,"Denizin Gürültüsü" Scratchmen Apoo.
Dialogue: 0,0:16:03.17,0:16:05.28,Main,,0,0,0,,Capone "Gang" Bege.
Dialogue: 0,0:16:06.46,0:16:09.12,Main,,0,0,0,,"Obur" Jewelry Bonney.
Dialogue: 0,0:16:10.25,0:16:12.54,Main,,0,0,0,,"Deli Keşiş" Urouge.
Dialogue: 0,0:16:13.71,0:16:16.29,Main,,0,0,0,,Eustass "Kaptan" Kid.
Dialogue: 0,0:16:17.64,0:16:19.96,Main,,0,0,0,,"Katliam Eri" Killer.
Dialogue: 0,0:16:21.00,0:16:24.43,Main,,0,0,0,,"Karasakal" Marshall D. Teach.
Dialogue: 0,0:16:24.43,0:16:25.26,Main,,0,0,0,,{\fad(0,400)}Son olarak...
Dialogue: 0,0:16:26.36,0:16:29.61,Main,,0,0,0,,"Hasır Şapka" Monkey D. Luffy.
Dialogue: 0,0:16:31.13,0:16:33.89,Main,,0,0,0,,İnanıyorum ki...
Dialogue: 0,0:16:33.89,0:16:38.15,Main,,0,0,0,,En Kötü Nesil olarak anılanların içinden...
Dialogue: 0,0:16:39.49,0:16:43.07,Main,,0,0,0,,...yakında yeni bir Korsanlar Kralı çıkacak!
Dialogue: 0,0:16:48.11,0:16:50.78,Main,,0,0,0,,Anladım. Pedro...
Dialogue: 0,0:16:51.65,0:16:53.12,Main,,0,0,0,,...öldü demek.
Dialogue: 0,0:16:58.00,0:17:01.42,Flashbacks,,0,0,0,,{\i1}Adım Pedro! Lütfen yardım et...
Dialogue: 0,0:17:02.11,0:17:06.34,Flashbacks,,0,0,0,,O ikisini hemen tedavi etmezseniz ölecekler!
Dialogue: 0,0:17:07.43,0:17:09.83,Flashbacks,,0,0,0,,Dünya onları bekliyor!
Dialogue: 0,0:17:11.31,0:17:13.31,Flashbacks,,0,0,0,,O ikisinin...
Dialogue: 0,0:17:15.75,0:17:19.15,Flashbacks,,0,0,0,,...ne olursa olsun...
Dialogue: 0,0:17:19.15,0:17:21.71,Flashbacks,,0,0,0,,...ölmesine izin veremeyiz!
Dialogue: 0,0:17:27.85,0:17:30.36,Thoughts,,0,0,0,,Beni kurtarmaya geldiğinden...
Dialogue: 0,0:17:30.36,0:17:32.54,Thoughts,,0,0,0,,{\i1}Son nefesini vereceğin yerin\Nburası olmadığını söylemiştin...
Dialogue: 0,0:17:35.50,0:17:39.49,Main,,0,0,0,,Üzülme. Üzülme Sanji!
Dialogue: 0,0:17:39.49,0:17:41.89,Main,,0,0,0,,Pedro kendi öyle istedi.
Dialogue: 0,0:17:42.53,0:17:45.47,Main,,0,0,0,,Kendini suçlama yani Sanji!
Dialogue: 0,0:17:47.56,0:17:52.83,Main,,0,0,0,,Siz-{\i1}teia{\i0} Mokomo Dükalığı'nı kurtardığınız için\Nborcumuzu ödemek istedik!
Dialogue: 0,0:17:52.83,0:17:56.57,Main,,0,0,0,,Pedro olmasaydı\No an hepimiz ölüp gitmiştik!
Dialogue: 0,0:18:04.10,0:18:05.70,Main,,0,0,0,,Bu yüzden...
Dialogue: 0,0:18:10.30,0:18:14.13,Main,,0,0,0,,...ona teşekkür etsen yeter, olur mu?
Dialogue: 0,0:18:19.35,0:18:22.75,Main,,0,0,0,,Olması gereken bu çünkü!
Dialogue: 0,0:18:30.68,0:18:33.42,Main,,0,0,0,,Nasıl bir adam olduğunu iyi bilirim.
Dialogue: 0,0:19:34.90,0:19:36.32,Main,,0,0,0,,Pamuk Şeker Sağanağı!
Dialogue: 0,0:19:36.32,0:19:41.57,Main,,0,0,0,,Bölge sınırına epey yaklaştık yani!
Dialogue: 0,0:19:46.49,0:19:50.75,Main,,0,0,0,,Big Mom'ın bölgesinden kurtulmak üzereyiz!
Dialogue: 0,0:22:06.47,0:22:10.10,Main,,0,0,0,,{\fad(150,150)}Gyojin Karate Ogi:
Dialogue: 0,0:22:06.47,0:22:10.10,Attack,,0,0,0,,{\fad(150,150)}Balık Adam Karate Gizli Tekniği:
Dialogue: 0,0:22:10.10,0:22:12.39,Main,,0,0,0,,{\fad(150,150)}Buraikan!
Dialogue: 0,0:22:10.10,0:22:12.39,Attack,,0,0,0,,{\fad(150,150)}Berduş Delgisi!
Dialogue: 0,0:22:18.81,0:22:20.44,Main,,0,0,0,,Sıkın dişinizi!
Dialogue: 0,0:22:20.44,0:22:24.82,Main,,0,0,0,,Luffyler bölgeden\Nçıkar çıkmaz biz de kaçabiliriz!
Dialogue: 0,0:22:35.55,0:22:38.23,Main,,0,0,0,,{\i1}Hey, Hasır Şapkalar'a ne oldu?
Dialogue: 0,0:22:38.23,0:22:40.42,Main,,0,0,0,,{\i1}Peşlerindeki gemilerimizden\Nbir haber gelmedi!
Dialogue: 0,0:22:40.42,0:22:42.88,Main,,0,0,0,,{\i1}İzlerini kaybettiler galiba!
Dialogue: 0,0:22:42.88,0:22:48.33,Main,,0,0,0,,{\i1}Dangalak! \NSınırı geçtiler mi onlara yetişemeyiz!
Dialogue: 0,0:22:52.76,0:22:58.70,Flashbacks,,0,0,0,,Her zamanki gibi Pudding, \Nrol keserek kendine deli divane âşık et.
Dialogue: 0,0:22:58.70,0:23:00.69,Flashbacks,,0,0,0,,Oldu bil Mama!
Dialogue: 0,0:23:01.33,0:23:04.89,Flashbacks,,0,0,0,,Tıpkı bir kukla gibisin ya Pudding!
Dialogue: 0,0:23:04.89,0:23:07.82,Flashbacks,,0,0,0,,İplerini benim tuttuğum.
Dialogue: 0,0:23:10.57,0:23:14.08,Flashbacks,,0,0,0,,{\i1}Mama... Kukla değilim ben.
Dialogue: 0,0:23:16.79,0:23:19.65,Flashbacks,,0,0,0,,Yarın evlenelim.
Dialogue: 0,0:23:19.65,0:23:24.71,Flashbacks,,0,0,0,,{\i1}Hadi oradan! Sen de gerçek yüzümü\Nöğrenince diğer herkes gibi...
Dialogue: 0,0:23:24.71,0:23:28.26,Flashbacks,,0,0,0,,{\i1}Kızım olsan da midemi kaldırıyorsun!
Dialogue: 0,0:23:28.26,0:23:29.26,Flashbacks,,0,0,0,,Canavar kız!
Dialogue: 0,0:23:30.03,0:23:33.18,Flashbacks,,0,0,0,,"Evlenelim." diyor ya!
Dialogue: 0,0:23:31.67,0:23:33.18,Flashbacks,,0,0,0,,--Taklit çok iyi ha!
Dialogue: 0,0:23:33.80,0:23:34.82,Flashbacks,,0,0,0,,İğrenç!
Dialogue: 0,0:23:34.82,0:23:36.77,Flashbacks,,0,0,0,,Bakın! Ucube!
Dialogue: 0,0:23:36.77,0:23:38.31,Flashbacks,,0,0,0,,Yapmayın lütfen!
Dialogue: 0,0:23:40.92,0:23:43.62,Thoughts,,0,0,0,,{\i1}Kimse beni sevmez.
Dialogue: 0,0:23:44.13,0:23:46.78,Flashbacks,,0,0,0,,{\i1}Çirkin bir ucubeyim zira.
Dialogue: 0,0:23:47.22,0:23:50.86,Flashbacks,,0,0,0,,{\i1}Sen de gerçek yüzümü\Nöğrenince diğer herkes gibi...
Dialogue: 0,0:23:52.32,0:23:56.37,Flashbacks,,0,0,0,,{\i1}İyi bak şimdi Sanji!\NBu iğrenç...
Dialogue: 0,0:23:56.94,0:23:59.04,Flashbacks,,0,0,0,,{\i1}...üçüncü gözüme!{\i0}
Dialogue: 0,0:24:04.55,0:24:07.67,Flashbacks,,0,0,0,,Ne güzel bir göz!
Dialogue: 0,0:24:10.00,0:24:11.09,Flashbacks,,0,0,0,,Ne?
Dialogue: 0,0:24:14.16,0:24:17.21,Flashbacks,,0,0,0,,{\fad(0,200)}Pekâlâ! Pişirmeye başlayalım!
Dialogue: 0,0:24:21.13,0:24:25.35,Flashbacks,,0,0,0,,Nişanlım rolünü iyi ki sen oynamışsın.
Dialogue: 0,0:24:32.11,0:24:33.69,Flashbacks,,0,0,0,,Pudding-chan!
Dialogue: 0,0:24:34.10,0:24:36.80,Flashbacks,,0,0,0,,Bana bak Sanji...
Dialogue: 0,0:24:36.80,0:24:38.33,Flashbacks,,0,0,0,,-{\i1}san{\i}...
Dialogue: 0,0:24:40.29,0:24:42.25,Flashbacks,,0,0,0,,Bana bir iyilik yapar mısın?!
Dialogue: 1,0:24:47.00,0:24:48.21,End Roll,,0,0,400,,{\1c&HB0B0B0&\fs50\bord0}Son kez...
Dialogue: 1,0:24:47.00,0:24:48.21,End Roll,,0,0,300,,{\1c&HB0B0B0&\fs50\bord0}...bir iyilik yapar mısın?
Dialogue: 1,0:24:48.21,0:24:48.25,End Roll,,0,0,400,,{\1c&HB0B0B0&\fs50\bord0\blur0}Son {\blur0}kez{\blur0}...
Dialogue: 1,0:24:48.21,0:24:48.25,End Roll,,0,0,300,,{\1c&HB0B0B0&\fs50\bord0\blur0}...bir {\blur0}iyilik yapar mısın{\blur0}?
Dialogue: 1,0:24:48.25,0:24:50.96,End Roll,,0,0,400,,{\1c&HB0B0B0&\fs50\bord0}Son kez...
Dialogue: 1,0:24:48.25,0:24:50.96,End Roll,,0,0,300,,{\1c&HB0B0B0&\fs50\bord0}...bir iyilik yapar mısın?
Dialogue: 1,0:25:25.87,0:25:25.92,End Roll,,0,0,360,,{\1c&HB0B0B0&\fs50\bord0\blur0}Tesekkür {\blur0}ederim{\blur0}...
Dialogue: 1,0:25:25.92,0:25:28.38,End Roll,,0,0,360,,{\1c&HB0B0B0&\fs50\bord0}Tesekkür ederim...
Dialogue: 1,0:25:28.38,0:25:28.42,End Roll,,0,0,360,,{\1c&HB0B0B0&\fs50\bord0\blur0}Tesekkür {\blur0}ederim{\blur0}...
Dialogue: 1,0:25:28.42,0:25:30.28,End Roll,,0,0,360,,{\1c&HB0B0B0&\fs50\bord0}Tesekkür ederim...
Dialogue: 1,0:25:30.28,0:25:32.01,End Roll,,0,0,360,,{\1c&HB0B0B0&\fs50\bord0}Elveda...
Dialogue: 0,0:24:45.42,0:24:50.96,Flashbacks,,0,0,0,,{\an7\pos(621,350)\1c&H050608&\blur50\bord0\fscy2400\fscx1200\p1\clip(32,25,1290,685)}m -21 -19 l 23 -14 l 26 12 l -17 17 l -21 -40
Dialogue: 0,0:25:25.87,0:25:32.01,Flashbacks,,0,0,0,,{\an7\pos(621,322)\1c&H050608&\blur50\bord0\fscy2500\fscx800\p1\clip(309.714,34.286,1017.143,683.429)}m -21 -14 l 19 -14 l 19 16 l -21 16 l -21 -14
Dialogue: 0,0:25:39.54,0:25:41.43,Flashbacks,,0,0,0,,Ne oldu Pudding-{\i1}chan{\i0}?
Dialogue: 0,0:25:42.67,0:25:45.33,Flashbacks,,0,0,0,,Son isteğin...
Dialogue: 0,0:25:45.33,0:25:47.02,Flashbacks,,0,0,0,,...neydi?
Dialogue: 0,0:26:09.46,0:26:13.88,Main,,0,0,0,,Peros abi, cevap ver!\NMama şu an nerede?
Dialogue: 0,0:26:13.88,0:26:15.00,Main,,0,0,0,,Sokayım!
Dialogue: 0,0:26:15.00,0:26:19.00,Main,,0,0,0,,Mont d'Or-{\i1}sama{\i0}!\NKakao Adası'ndan telefon aldık!
Dialogue: 0,0:26:19.00,0:26:21.84,Main,,0,0,0,,{\i1}Bölge sınırlarında bir\NMıntıka Salyangozu varmış galiba!
Dialogue: 0,0:26:21.84,0:26:23.39,Main,,0,0,0,,Artık ne işimize yarar ki!
Dialogue: 0,0:26:23.39,0:26:27.60,Main,,0,0,0,,{\i1}Bir geminin sınırı geçtiğini bildirdiler!\NHasır Şapkalar'ın gemisi bölgemizden çıkmış!
Dialogue: 0,0:26:29.20,0:26:33.63,Main,,0,0,0,,Gemilerinize Germa 66!\NGörev tamamlandı!
Dialogue: 0,0:26:36.58,0:26:38.70,Main,,0,0,0,,Anlaşıldı!
Dialogue: 0,0:26:38.70,0:26:39.56,Main,,0,0,0,,Anlaşıldı!
Dialogue: 0,0:26:39.56,0:26:40.85,Main,,0,0,0,,Anlaşıldı!
Dialogue: 0,0:26:41.40,0:26:43.18,Main,,0,0,0,,Germa geri çekiliyor!
Dialogue: 0,0:26:43.18,0:26:44.52,Main,,0,0,0,,Kaçmalarına izin vermeyin!
Dialogue: 0,0:26:44.52,0:26:46.15,Main,,0,0,0,,Yakalayın!
Dialogue: 0,0:26:57.09,0:27:01.34,Main,,0,0,0,,Seni mağlup olmuş hâlde uzanırken\Ngörmek istemedim abi.
Dialogue: 0,0:27:06.64,0:27:07.71,Main,,0,0,0,,Brûlée.
Dialogue: 0,0:27:08.28,0:27:14.13,Main,,0,0,0,,İlk başta yüzükoyun düşmüşken\Nneden sonra sırtını yere verdin ki?
Dialogue: 0,0:27:16.63,0:27:18.97,Main,,0,0,0,,Neden acaba?
Dialogue: 0,0:27:20.77,0:27:22.81,Main,,0,0,0,,Ama Brûlée...
Dialogue: 0,0:27:22.81,0:27:28.43,Main,,0,0,0,,Hayatım boyunca sırtımın yere\Ngelmediğine dair anlattıklarının...
Dialogue: 0,0:27:29.73,0:27:30.86,Main,,0,0,0,,...aslı yok.
Dialogue: 0,0:27:30.86,0:27:35.47,Main,,0,0,0,,Evet, biliyorum.\NAynalardan izliyordum seni.
Dialogue: 0,0:27:39.88,0:27:41.75,Main,,0,0,0,,Kimsenin bulaşmayacağı...
Dialogue: 0,0:27:42.69,0:27:46.27,Main,,0,0,0,,...kusursuz bir adam profili çiziyordun.
Dialogue: 0,0:27:46.27,0:27:48.39,Main,,0,0,0,,Bizler için.
Dialogue: 0,0:27:52.51,0:27:56.84,Main,,0,0,0,,Katakuri, \Nağzını kapatırsan arkadaş edinebilirsin.
Dialogue: 0,0:27:56.84,0:28:00.77,Main,,0,0,0,,İstemez! Böyle doğmuşum!\NBana gülenleri pataklarım olur biter!
Dialogue: 0,0:28:00.77,0:28:02.44,Main,,0,0,0,,Yılan balığı!
Dialogue: 0,0:28:03.90,0:28:06.20,Main,,0,0,0,,Yılan balığı geldi!
Dialogue: 0,0:28:07.79,0:28:09.70,Main,,0,0,0,,Sopa vakti!
Dialogue: 0,0:28:20.65,0:28:21.43,Main,,0,0,0,,Eyvahlar olsun!
Dialogue: 0,0:28:21.43,0:28:22.68,Main,,0,0,0,,Acele edin!
Dialogue: 0,0:28:21.86,0:28:22.94,Secondary,,0,0,0,,Nasıl olmuş?
Dialogue: 0,0:28:22.94,0:28:24.11,Main,,0,0,0,,Ne oldu ki?
Dialogue: 0,0:28:25.90,0:28:27.00,Main,,0,0,0,,Sorun nedir?
Dialogue: 0,0:28:29.63,0:28:30.55,Main,,0,0,0,,Ne?!
Dialogue: 0,0:28:27.00,0:28:29.63,Main,,0,0,0,,Durum vahim!\NBrûlée ağır yaralanmış!
Dialogue: 0,0:28:30.55,0:28:31.51,Main,,0,0,0,,Brûlée!
Dialogue: 0,0:28:33.90,0:28:36.35,Main,,0,0,0,,Ne oldu sana?
Dialogue: 0,0:28:37.69,0:28:39.48,Main,,0,0,0,,Bir şey olmadı.
Dialogue: 0,0:28:39.90,0:28:43.81,Main,,0,0,0,,Bal gibi de olmuş işte! \NSöyle! Ne oldu?
Dialogue: 0,0:28:43.81,0:28:47.86,Main,,0,0,0,,Dövdüğün adamlar intikam almaya\Ngelmişler Katakuri!
Dialogue: 0,0:28:48.19,0:28:50.57,Main,,0,0,0,,İntikam mı? Kız kardeşim üzerinden?
Dialogue: 0,0:28:50.57,0:28:54.13,Main,,0,0,0,,Neden?\NNeden kız kardeşim ama?
Dialogue: 0,0:29:00.00,0:29:01.52,Main,,0,0,0,,Abi...
Dialogue: 0,0:29:02.10,0:29:06.00,Main,,0,0,0,,Canım... Hiç acımıyor.
Dialogue: 0,0:29:06.00,0:29:09.71,Main,,0,0,0,,Görünüşünde hiçbir şey yok!
Dialogue: 0,0:29:12.75,0:29:15.16,Main,,0,0,0,,Şapşal! Ben...
Dialogue: 0,0:29:18.44,0:29:20.70,Thoughts,,0,0,0,,{\i1}Brûlée benim yüzümden yaralandı.
Dialogue: 0,0:29:24.43,0:29:26.24,Thoughts,,0,0,0,,{\i1}Safmışım meğer!
Dialogue: 0,0:29:26.24,0:29:28.57,Main,,0,0,0,,Geldin demek Katakuri!
Dialogue: 0,0:29:29.80,0:29:30.90,Main,,0,0,0,,Biz de seni bekliyorduk.
Dialogue: 0,0:29:30.90,0:29:33.57,Main,,0,0,0,,Ha? Boğazına ne sardın lan?
Dialogue: 0,0:29:34.48,0:29:38.58,Main,,0,0,0,,Ne cüretle kız kardeşimin\Nyüzünü kesersiniz?
Dialogue: 0,0:29:38.58,0:29:41.20,Thoughts,,0,0,0,,{\i1}Bir daha açık vermeyeceğim!
Dialogue: 0,0:29:44.57,0:29:47.64,Thoughts,,0,0,0,,{\i1}{\fad(0,600)}Gerçek korku neymiş göstereceğim!
Dialogue: 0,0:29:51.73,0:29:53.03,Main,,0,0,0,,Brûlée...
Dialogue: 0,0:29:54.10,0:29:55.59,Main,,0,0,0,,Hasır Şapka?
Dialogue: 0,0:29:58.47,0:30:02.45,Main,,0,0,0,,Duyunca "İyi bari." diyeceksin, değil mi?
Dialogue: 0,0:30:02.45,0:30:05.33,Main,,0,0,0,,Sen de mi geleceği görebiliyorsun?
Dialogue: 0,0:30:08.00,0:30:10.84,Main,,0,0,0,,Az önce bölge sularımızdan çıktı.
Dialogue: 0,0:30:10.84,0:30:12.76,Main,,0,0,0,,Onu affetmeyeceğim ama!
Dialogue: 0,0:30:12.76,0:30:16.51,Main,,0,0,0,,Abime yaptıklarından sonra olmaz!
Dialogue: 0,0:30:17.74,0:30:18.98,Main,,0,0,0,,Bak işte.
Dialogue: 0,0:30:21.99,0:30:25.62,Main,,0,0,0,,Luffyler bölge sularından çıkmış!\NGeri çekilelim!
Dialogue: 0,0:30:29.05,0:30:32.26,Main,,0,0,0,,Germa 66! Geri çekiliyoruz!
Dialogue: 0,0:30:32.26,0:30:35.78,Main,,0,0,0,,Ateş edin! \NGerma'yı elinizden kaçırmayın-{\i1}nie{\i0}!
Dialogue: 0,0:30:42.97,0:30:44.43,Main,,0,0,0,,Geldi demek.
Dialogue: 0,0:30:54.15,0:30:55.78,Main,,0,0,0,,Mama!
Dialogue: 0,0:32:46.97,0:32:50.49,Main,,0,0,0,,Ömür mü ölüm mü?
Dialogue: 0,0:32:53.53,0:33:01.05,Narrator,,0,0,0,,{\i1}Güneş Korsanları, Germa 66 ve\Nhayatını kaybedenlerin umutlarını taşıyan...
Dialogue: 0,0:33:01.05,0:33:07.93,Narrator,,0,0,0,,{\i1}...Hasır Şapka tayfası nihayet Yonko\NBig Mom'ın bölgesinden kurtulmayı bilmişti.
Dialogue: 0,0:33:13.06,0:33:14.38,Main,,0,0,0,,Baksanıza...
Dialogue: 0,0:33:15.62,0:33:18.27,Main,,0,0,0,,Size yemek yapabilir miyim?
Dialogue: 0,0:33:18.93,0:33:20.49,Main,,0,0,0,,Yemek diyorum?
Dialogue: 0,0:33:22.61,0:33:24.07,Main,,0,0,0,,Yemek!
Dialogue: 0,0:33:24.07,0:33:25.84,Main,,0,0,0,,Sanji'nin elinden!
Dialogue: 0,0:33:25.84,0:33:28.16,Main,,0,0,0,,Karnım zil çalıyor!
Dialogue: 0,0:33:28.16,0:33:30.95,Main,,0,0,0,,Açlıktan ölüyorum!
Dialogue: 0,0:33:30.95,0:33:33.68,Main,,0,0,0,,Ölümcül olmayan, \Nbedava ve nefis bir yemek!
Dialogue: 0,0:33:33.68,0:33:36.08,Main,,0,0,0,,Sanji'nin elinden!
Dialogue: 0,0:33:36.61,0:33:40.63,Main,,0,0,0,,Yokluğumda bir şey mi atlattınız da?
Dialogue: 0,0:33:41.57,0:33:44.89,Narrator,,0,0,0,,{\i1}O sırada Güney Mavi'de...
Dialogue: 0,0:33:45.63,0:33:47.21,Main,,0,0,0,,Benim sipariş nerede kaldı ya?
Dialogue: 0,0:33:47.21,0:33:48.71,Main,,0,0,1,,Kime diyoruz!
Dialogue: 0,0:33:48.18,0:33:53.18,Captions,,0,0,235,,{\fad(500,0)}Deniz Restoranı - Baratie
Dialogue: 0,0:33:48.71,0:33:51.30,Main,,0,0,1,,Patron Zeff! Kapı dışarı edelim şunları!
Dialogue: 0,0:33:51.30,0:33:53.18,Main,,0,0,1,,Bu heriflere niye yemek yapıyoruz ki?
Dialogue: 0,0:33:53.18,0:33:55.06,Main,,0,0,0,,Düşmanımızlar yahu!
Dialogue: 0,0:33:55.06,0:33:57.98,Main,,0,0,0,,Ben pişiririm, uzatmayın!
Dialogue: 0,0:33:57.98,0:33:59.97,Main,,0,0,0,,Hadisenize ulan!
Dialogue: 0,0:33:59.97,0:34:01.98,Main,,0,0,0,,Şanslarını zorluyorlar!
Dialogue: 0,0:34:01.98,0:34:06.24,Main,,0,0,0,,Yemek! Yemek! Yemek! Yemek!
Dialogue: 0,0:34:06.24,0:34:08.07,Main,,0,0,0,,Tamam ya, geliyor.
Dialogue: 0,0:34:08.88,0:34:11.70,Main,,0,0,0,,Gündüz de olsa akşam da olsa\Ninsan acıkır.
Dialogue: 0,0:34:13.69,0:34:17.12,Main,,0,0,0,,Düşmanın da olsa dostun da olsa\Ninsan acıkır.
Dialogue: 0,0:34:17.12,0:34:18.50,Main,,0,0,0,,Yumulun bakalım!
Dialogue: 0,0:34:19.80,0:34:22.61,Main,,0,0,0,,Aç olan herkesi doyuracağım!
Dialogue: 0,0:34:22.61,0:34:24.96,Main,,0,0,0,,Konuşma faslı sonraya!
Dialogue: 0,0:34:24.96,0:34:29.98,Credits,,0,0,0,,Editing:\N Feeso\N\NTiming:\NKaitouYahiko\N\NQuality Assurance:\NFeeso,\NGaijin,\NGalaxy 9000,\NGrug,\NPepperjack\N\NSoundtracking:\N Halee\N\NGraphics:\N Datenshi\N\NKaraoke:\NKaitouYahiko\N\NTranslation:\NCrunchyroll\NGaijin
