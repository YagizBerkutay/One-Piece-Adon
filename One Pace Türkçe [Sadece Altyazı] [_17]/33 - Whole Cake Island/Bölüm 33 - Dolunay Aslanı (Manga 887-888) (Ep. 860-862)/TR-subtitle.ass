Dialogue: 0,0:01:38.26,0:01:45.90,Title,,0,0,0,,{\pos(632,465)}{\fad(500,0)}Dolunay Aslanı
Dialogue: 0,0:01:49.36,0:01:51.28,Main,,0,0,0,,Bege!
Dialogue: 0,0:02:05.37,0:02:08.82,Main,,0,0,0,,Olamaz!\NOven abinin tepesi attı!
Dialogue: 0,0:02:08.82,0:02:10.92,Main,,0,0,0,,Limana koşun!
Dialogue: 0,0:02:10.92,0:02:13.17,Main,,0,0,0,,Denizde kaçacak bir yeriniz yok!
Dialogue: 0,0:02:13.17,0:02:14.63,Main,,0,0,0,,Keza karada da!
Dialogue: 0,0:02:14.63,0:02:17.10,Main,,0,0,0,,İnin lan gemiden!
Dialogue: 0,0:02:18.35,0:02:22.14,Main,,0,0,0,,Savaşmayı seçtin demek Bege!
Dialogue: 0,0:02:22.14,0:02:25.90,Main,,0,0,0,,Âlâ.\NSeni bizzat infaz edeceğim!
Dialogue: 0,0:02:25.90,0:02:29.19,Main,,0,0,0,,N'apacağız abla?\NDenize açılamayız!
Dialogue: 0,0:02:29.19,0:02:31.11,Main,,0,0,0,,Pastaya n'olacak?
Dialogue: 0,0:02:33.99,0:02:36.11,Main,,0,0,0,,Hızı artırın.
Dialogue: 0,0:02:36.11,0:02:39.24,Main,,0,0,0,,Dosdoğru limana ilerleyin.
Dialogue: 0,0:02:44.58,0:02:47.29,Main,,0,0,0,,Bege daha da hızlandı!
Dialogue: 0,0:02:47.29,0:02:51.13,Main,,0,0,0,,Kafasından neler geçiyor ki?\NLimana girecek!
Dialogue: 0,0:02:53.76,0:02:56.01,Main,,0,0,0,,Neden hız kesmiyor ki?
Dialogue: 0,0:02:57.98,0:03:00.47,Main,,0,0,0,,Yoksa intihar saldırısı mı düzenliyor?!
Dialogue: 0,0:03:06.24,0:03:09.31,Main,,0,0,0,,Sahile çıkıyor!
Dialogue: 0,0:03:09.31,0:03:10.44,Main,,0,0,0,,Bege!
Dialogue: 0,0:03:10.44,0:03:12.91,Main,,0,0,0,,Tereddüt etmeyin!\NAteş açmaya hazır olun!
Dialogue: 0,0:03:12.91,0:03:15.07,Main,,0,0,0,,Pis hain!
Dialogue: 0,0:03:16.89,0:03:19.09,Main,,0,0,0,,Gölge etmeyin ağzı süt kokan serseriler.
Dialogue: 0,0:03:22.09,0:03:25.59,Main,,0,0,0,,Bu gemi, Nostra Castello...
Dialogue: 0,0:03:25.59,0:03:28.89,Main,,0,0,0,,...yüzergezerdir!
Dialogue: 0,0:03:47.07,0:03:48.59,Main,,0,0,0,,Bege!
Dialogue: 0,0:03:49.62,0:03:52.40,Main,,0,0,0,,Çarkları tank paletine dönüştü!
Dialogue: 0,0:03:52.40,0:03:55.33,Main,,0,0,0,,Böyle bir numarayı da\Nilk kez duyuyorum lan!
Dialogue: 0,0:03:55.33,0:03:58.39,Main,,0,0,0,,E söylemedim de ondandır.
Dialogue: 0,0:04:02.72,0:04:07.18,Main,,0,0,0,,İhanet edeceğim insanlara\Nelimi niye göstereyim ki?
Dialogue: 0,0:04:07.18,0:04:08.89,Main,,0,0,0,,Şerefsiz!
Dialogue: 0,0:04:08.89,0:04:11.15,Main,,0,0,0,,Ateş-{\i1}rero{\i}!
Dialogue: 0,0:04:12.40,0:04:15.41,Main,,0,0,0,,{\i1}Chiffon! Pastayı bize verin!
Dialogue: 0,0:04:15.41,0:04:16.54,Main,,0,0,0,,Ne?
Dialogue: 0,0:04:16.54,0:04:18.96,Main,,0,0,0,,Mümkün değil!\NBu ebatlardaki bir pastayı...
Dialogue: 0,0:04:18.96,0:04:22.88,Main,,0,0,0,,Tam sürat giden bir gemiye\Nnasıl aktarabiliriz ki?
Dialogue: 0,0:04:34.14,0:04:36.85,Main,,0,0,0,,Ne?\NNeeee?
Dialogue: 0,0:04:36.85,0:04:41.58,Main,,0,0,0,,Araç havaya mı kalktı?
Dialogue: 0,0:04:46.27,0:04:47.95,Main,,0,0,0,,N'oluyor?
Dialogue: 0,0:04:50.86,0:04:53.20,Main,,0,0,0,,Ne?
Dialogue: 0,0:04:54.76,0:04:56.33,Main,,0,0,0,,Kara Bacak!
Dialogue: 0,0:04:57.76,0:05:00.25,Main,,0,0,0,,Güvertede yer açın Bege!
Dialogue: 0,0:05:01.64,0:05:03.67,Main,,0,0,0,,Sanji-{\i1}san!{\i0}
Dialogue: 0,0:05:08.31,0:05:10.43,Main,,0,0,0,,Pudding-{\i1}sama{\i1}!{\i0}
Dialogue: 0,0:05:18.60,0:05:20.66,Main,,0,0,0,,Çabuk Bege!
Dialogue: 0,0:05:20.68,0:05:22.72,Main,,0,0,0,,Çekilin çocuklar!
Dialogue: 0,0:05:22.72,0:05:24.51,Main,,0,0,0,,Güvertede yer açın!
Dialogue: 0,0:05:24.51,0:05:28.13,Main,,0,0,0,,E- Emredersin Baba!
Dialogue: 0,0:05:28.13,0:05:31.63,Main,,0,0,0,,Kara Bacak! Getir bakalım!
Dialogue: 0,0:05:34.71,0:05:36.26,Main,,0,0,0,,O da kimin nesi?
Dialogue: 0,0:05:36.26,0:05:38.64,Main,,0,0,0,,Tek bacağı ile...
Dialogue: 0,0:05:38.64,0:05:40.64,Main,,0,0,0,,Aşçı mı yoksa?
Dialogue: 0,0:05:43.16,0:05:44.98,Main,,0,0,0,,Tamamdır! Gidelim!
Dialogue: 0,0:05:44.98,0:05:48.76,Main,,0,0,0,,Millet! Çarpışmaya hazırlanın!
Dialogue: 0,0:06:10.80,0:06:15.82,Main,,0,0,0,,Pasta tek parça indi!
Dialogue: 0,0:06:17.14,0:06:20.82,Main,,0,0,0,,Süperdin be Kara Bacak!
Dialogue: 0,0:06:20.82,0:06:23.00,Main,,0,0,0,,Bu enfes koku da nereden geliyor?
Dialogue: 0,0:06:23.00,0:06:25.41,Main,,0,0,0,,G- Germa'dan da daha azı\Nbeklenmezdi zaten!
Dialogue: 0,0:06:25.41,0:06:26.96,Main,,0,0,0,,Germa'dan değilim ben!
Dialogue: 0,0:06:26.96,0:06:29.90,Main,,0,0,0,,Bege! Pez!
Dialogue: 0,0:06:29.90,0:06:32.16,Main,,0,0,0,,Bir şeyin yok ya hayatım?
Dialogue: 0,0:06:32.16,0:06:34.29,Main,,0,0,0,,Yok yok.
Dialogue: 0,0:06:36.50,0:06:39.63,Main,,0,0,0,,Bir kez mantıklı davransan\Nşaşardım zaten.
Dialogue: 0,0:06:42.29,0:06:44.55,Main,,0,0,0,,Teşekkür ederim!
Dialogue: 0,0:06:47.26,0:06:50.33,Main,,0,0,0,,Pudding-{\i1}sama{\i0}! Kendinize gelin!
Dialogue: 0,0:06:58.43,0:07:00.23,Main,,0,0,0,,Kaçmalarına göz yumacak değilim!
Dialogue: 0,0:07:00.23,0:07:01.39,Main,,0,0,0,,Dikkat edin!
Dialogue: 0,0:07:01.39,0:07:04.86,Main,,0,0,0,,Oven-{\i1}sama{\i0}! Çekilin lütfen!
Dialogue: 0,0:07:04.86,0:07:08.13,Main,,0,0,0,,Kiminle konuştuğunuzu\Nsanıyorsunuz lan siz?
Dialogue: 0,0:07:08.13,0:07:10.33,Main,,0,0,0,,Ellerimle durduracağım!
Dialogue: 0,0:07:11.99,0:07:13.74,Note,,0,0,0,,Ezilme Sesi!
Dialogue: 0,0:07:13.74,0:07:16.16,Main,,0,0,0,,Ezildi!
Dialogue: 0,0:07:18.64,0:07:23.32,Main,,0,0,0,,Geçti canım, geçti Pez.\NBiraz gürültü oldu, evet.
Dialogue: 0,0:07:33.11,0:07:34.63,Main,,0,0,0,,Hâlâ buradaymış.
Dialogue: 0,0:07:37.62,0:07:41.05,Main,,0,0,0,,Kimin nesi ki? Sapık falan mı acaba?
Dialogue: 0,0:07:47.42,0:07:50.14,Main,,0,0,0,,Ha?\NNeye gülüyorsun Pez?
Dialogue: 0,0:07:54.05,0:07:57.11,Thoughts,,0,0,0,,{\i1}Kızım mutluluğu bulmuş anlaşılan.
Dialogue: 0,0:08:02.48,0:08:05.63,Main,,0,0,0,,Güneydoğuya yelken almak\Nistiyoruz Bege.
Dialogue: 0,0:08:05.63,0:08:06.87,Main,,0,0,0,,Tamam.
Dialogue: 0,0:08:06.87,0:08:11.79,Main,,0,0,0,,Şehirden bu şekilde geçip\Ndenize çıkmamız lazım.
Dialogue: 0,0:08:11.79,0:08:13.28,Main,,0,0,0,,Pudding!
Dialogue: 0,0:08:15.74,0:08:18.75,Main,,0,0,0,,Birkaç çikolata evini\Nyıkıp geçmemiz gerekecek.
Dialogue: 0,0:08:18.75,0:08:19.67,Main,,0,0,0,,Ne?
Dialogue: 0,0:08:20.58,0:08:24.43,Main,,0,0,0,,Hep birlikte yelken almak için\Nbaşka çaremiz yok!
Dialogue: 0,0:08:42.74,0:08:44.69,Main,,0,0,0,,İsrafa bak.
Dialogue: 0,0:08:44.69,0:08:47.24,Main,,0,0,0,,Zarar gören evleri sonra onarırım.
Dialogue: 0,0:08:47.24,0:08:51.28,Main,,0,0,0,,Ev dediğin yeniden inşa edilir.\NAileler de keza.
Dialogue: 0,0:08:51.28,0:08:55.29,Main,,0,0,0,,Kesinlikle. Hiç dağılmasalar\Ntabii en güzeli ama...
Dialogue: 0,0:08:56.36,0:08:59.08,Main,,0,0,0,,...evim artık burası.
Dialogue: 0,0:08:59.08,0:09:02.00,Main,,0,0,0,,Yeni ailem de epey bir geniş.
Dialogue: 0,0:09:02.00,0:09:04.67,Main,,0,0,0,,Hanımım!
Dialogue: 0,0:09:15.22,0:09:16.80,Main,,0,0,0,,Şerefsizler!
Dialogue: 0,0:09:16.80,0:09:18.78,Main,,0,0,0,,Top kullanma!
Dialogue: 0,0:09:18.78,0:09:21.63,Main,,0,0,0,,Pastayı havaya uçurabilirsin!
Dialogue: 0,0:09:21.63,0:09:24.86,Main,,0,0,0,,Denize çıkacaklar!\NElinizden kaçırmayın!
Dialogue: 0,0:09:24.86,0:09:27.65,Main,,0,0,0,,{\i1}Filo, adanın güneydoğusuna gidin!
Dialogue: 0,0:09:27.65,0:09:29.74,Main,,0,0,0,,{\i1}Gidiyoruz!
Dialogue: 0,0:09:39.02,0:09:42.96,Main,,0,0,0,,Tamamdır!\NKakao Adası'ndan çıktık!
Dialogue: 0,0:09:44.37,0:09:45.84,Main,,0,0,0,,Yaşasın!
Dialogue: 0,0:09:53.54,0:09:57.27,Main,,0,0,0,,Paletli gemime kimseler yetişemez artık.
Dialogue: 0,0:09:57.93,0:10:01.20,Main,,0,0,0,,Teşekkürler Bege.\NPaçamızı kurtardın.
Dialogue: 0,0:10:01.20,0:10:04.69,Main,,0,0,0,,Sizin için gelmedik zaten Kara Bacak!
Dialogue: 0,0:10:07.22,0:10:09.15,Main,,0,0,0,,Hava birden ısınmadı mı?
Dialogue: 0,0:10:11.25,0:10:14.72,Main,,0,0,0,,Baba, denize bi' hâller oluyor-{\i1}rero{\i0}!
Dialogue: 0,0:10:21.80,0:10:24.27,Main,,0,0,0,,Balıklar yüzeye çıkıyor!
Dialogue: 0,0:10:24.27,0:10:26.44,Main,,0,0,0,,Sıcaktan kaynayarak mı ölmüşler?
Dialogue: 0,0:10:26.44,0:10:29.73,Main,,0,0,0,,Biraz tuzla çok güzel giderler.
Dialogue: 0,0:10:29.73,0:10:32.15,Main,,0,0,0,,Biz de aynı kaderi paylaşacağız salak!
Dialogue: 0,0:10:33.36,0:10:36.71,Main,,0,0,0,,Bunu yapabilecek tek bir adam var.
Dialogue: 0,0:10:36.73,0:10:38.13,Main,,0,0,0,,Bak!
Dialogue: 0,0:10:39.50,0:10:42.26,Main,,0,0,0,,{\fad(150,150)}Nekkai Jigoku!
Dialogue: 0,0:10:39.50,0:10:42.26,Attack,,0,0,0,,{\fad(150,150)}Kaynayan Derya Cehennemi
Dialogue: 0,0:10:42.26,0:10:45.82,Main,,0,0,0,,Isı Isı Meyve'min gücüyle...
Dialogue: 0,0:10:45.82,0:10:49.19,Main,,0,0,0,,...geberene kadar haşlayacağım sizi!
Dialogue: 0,0:10:51.81,0:10:53.48,Main,,0,0,0,,Yanıyor lan!
Dialogue: 0,0:10:53.48,0:10:56.36,Main,,0,0,0,,Deniz kaynıyor-{\i1}rero{\i0}!
Dialogue: 0,0:10:56.36,0:10:58.61,Main,,0,0,0,,Başka sorunlarımız da var!
Dialogue: 0,0:11:00.02,0:11:03.15,Main,,0,0,0,,Olamaz!\NÇikolatanın sıcaklığı değişecek!
Dialogue: 0,0:11:03.15,0:11:05.58,Main,,0,0,0,,Kremşanti de eriyecek!
Dialogue: 0,0:11:05.58,0:11:07.03,Main,,0,0,0,,Öyleyse...
Dialogue: 0,0:11:07.03,0:11:11.67,Main,,0,0,0,,Bu gidişle Big Mom'ın pastası bozulacak!
Dialogue: 0,0:11:13.37,0:11:16.51,Main,,0,0,0,,Kaz kafasından neler geçiyor ki?
Dialogue: 0,0:11:16.51,0:11:20.63,Main,,0,0,0,,Big Mom'ı haşlanmış balıklara\Ntav olmaz ki!
Dialogue: 0,0:11:22.67,0:11:24.39,Main,,0,0,0,,Ne oldu?
Dialogue: 0,0:11:24.39,0:11:27.02,Main,,0,0,0,,Paletler sıcaktan arızalandı!
Dialogue: 0,0:11:27.02,0:11:30.76,Main,,0,0,0,,{\i1}Rero-rero{\i0}!\NGemiyi alabora etmek mi istiyor?
Dialogue: 0,0:11:30.76,0:11:35.02,Main,,0,0,0,,Oven-{\i1}sama{\i0} bu pastanın\Nehemmiyetini unutmuş mu?
Dialogue: 0,0:11:35.02,0:11:37.20,Main,,0,0,0,,Merak etme oğlum.
Dialogue: 0,0:11:37.20,0:11:39.24,Main,,0,0,0,,Hepsi geçecek.
Dialogue: 0,0:11:39.24,0:11:41.32,Main,,0,0,0,,Batın...
Dialogue: 0,0:11:41.32,0:11:43.70,Main,,0,0,0,,Batın lan!
Dialogue: 0,0:11:51.57,0:11:56.21,Main,,0,0,0,,Deminden beri neye gülüp duruyorsun Pez?
Dialogue: 0,0:11:58.00,0:11:59.59,Main,,0,0,0,,Sen de kimsin lan?
Dialogue: 0,0:12:09.01,0:12:11.60,Main,,0,0,0,,Oven-{\i1}sama{\i0}! Dikkat edin!
Dialogue: 0,0:12:13.18,0:12:15.84,Main,,0,0,0,,Kes şunu!
Dialogue: 0,0:12:38.52,0:12:41.27,Main,,0,0,0,,Oven-{\i1}sama{\i1}!{\i0}
Dialogue: 0,0:12:42.21,0:12:44.36,Main,,0,0,0,,Neler oluyor?
Dialogue: 0,0:12:44.36,0:12:46.74,Main,,0,0,0,,O adam da kim ki-{\i1}rero{\i0}?
Dialogue: 0,0:12:46.74,0:12:49.25,Main,,0,0,0,,Oven-{\i1}sama{\i0}'nın eski bir hasmı mı acaba?
Dialogue: 0,0:13:02.05,0:13:03.64,Main,,0,0,0,,Pound!
Dialogue: 0,0:13:05.47,0:13:09.27,Main,,0,0,0,,A- Amma dayanıklıymışsın.
Dialogue: 0,0:13:11.89,0:13:13.48,Main,,0,0,0,,Ağzına sıçtığım!
Dialogue: 0,0:13:15.06,0:13:18.94,Main,,0,0,0,,Üvey oğlunu öldürmeye mi\Nkalkıyorsun lan?
Dialogue: 0,0:13:22.06,0:13:25.78,Main,,0,0,0,,Baba!\NDeniz sıcaklığı düşüyor!
Dialogue: 0,0:13:25.78,0:13:30.99,Main,,0,0,0,,Paletleri toplayın!\NKaynayan bölgeden derhâl çıkalım!
Dialogue: 0,0:13:30.99,0:13:32.32,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:13:32.32,0:13:34.29,Main,,0,0,0,,Elinizi çabuk tutun!\NBir an önce kaçalım!
Dialogue: 0,0:13:34.29,0:13:36.58,Main,,0,0,0,,Emredersiniz hanımım!
Dialogue: 0,0:13:41.89,0:13:45.34,Thoughts,,0,0,0,,{\i1}Ey adını bilmediğim torunum.
Dialogue: 0,0:13:45.34,0:13:47.56,Thoughts,,0,0,0,,{\i1}Mutlu musun bakayım?
Dialogue: 0,0:13:48.10,0:13:53.36,Thoughts,,0,0,0,,{\i1}Babanla annen seni büyütsün, olur mu?
Dialogue: 0,0:13:53.37,0:13:58.19,Thoughts,,0,0,0,,{\i1}Ben yapamadım zira.
Dialogue: 0,0:13:59.36,0:14:02.78,Main,,0,0,0,,Daha doğmadılar mı ya?\NDoğmadılar mı ya?
Dialogue: 0,0:14:11.08,0:14:13.88,Main,,0,0,0,,Linlin, doğumu yapmışsın!
Dialogue: 0,0:14:13.88,0:14:17.51,Main,,0,0,0,,Evet... Adları Lola ile Chiffon.
Dialogue: 0,0:14:17.51,0:14:19.72,Main,,0,0,0,,İkizler.
Dialogue: 0,0:14:19.72,0:14:23.45,Main,,0,0,0,,İkiz mi? Ver bi' kucağıma alayım.
Dialogue: 0,0:14:23.45,0:14:24.48,Main,,0,0,0,,Ne?
Dialogue: 0,0:14:25.30,0:14:29.36,Main,,0,0,0,,Hizmetini tamamladın sen.
Dialogue: 0,0:14:33.07,0:14:34.77,Main,,0,0,0,,Toz ol.
Dialogue: 0,0:14:34.77,0:14:36.14,Main,,0,0,0,,Ne?
Dialogue: 0,0:14:36.14,0:14:37.78,Main,,0,0,0,,Linlin?
Dialogue: 0,0:14:37.78,0:14:39.96,Main,,0,0,0,,Neler diyorsun sen?
Dialogue: 0,0:14:39.96,0:14:43.37,Main,,0,0,0,,Babalarıyım ben! Hem biz...
Dialogue: 0,0:14:43.37,0:14:47.75,Main,,0,0,0,,Aile miyiz?\NKendini bir bok sanma.
Dialogue: 0,0:14:56.96,0:14:58.71,Main,,0,0,0,,Linlin!
Dialogue: 0,0:14:59.05,0:15:01.68,Main,,0,0,0,,Babalarıyım ben!
Dialogue: 0,0:15:01.68,0:15:03.82,Main,,0,0,0,,Yalvarırım!
Dialogue: 0,0:15:03.82,0:15:08.73,Main,,0,0,0,,Bir kez kucağıma alayım bari!
Dialogue: 0,0:15:09.31,0:15:12.98,Main,,0,0,0,,Linlin!
Dialogue: 0,0:15:12.98,0:15:17.52,Main,,0,0,0,,Babalarıyım ben!
Dialogue: 0,0:15:19.44,0:15:22.58,Thoughts,,0,0,0,,{\i1}26 yıl geçti gitti.
Dialogue: 0,0:15:23.24,0:15:27.79,Thoughts,,0,0,0,,{\i1}Chiffon... Bir kez olsun\Nseni gördüğüme çok mutluyum.
Dialogue: 0,0:15:27.79,0:15:32.17,Thoughts,,0,0,0,,{\i1}Peşinde birleri olsa da...
Dialogue: 0,0:15:32.91,0:15:36.63,Thoughts,,0,0,0,,{\i1}...mutlu görünmen bana yetiyor.
Dialogue: 0,0:15:42.71,0:15:44.80,Main,,0,0,0,,Neyin var Pez?
Dialogue: 0,0:15:44.80,0:15:50.06,Main,,0,0,0,,Merak etme oğluşum!\NSıcak denizden şimdi çıkıyoruz!
Dialogue: 0,0:15:50.81,0:15:54.10,Main,,0,0,0,,Korkacak bir şey yok!
Dialogue: 0,0:15:59.35,0:16:01.95,Main,,0,0,0,,Vurma Mama
Dialogue: 0,0:16:01.95,0:16:03.49,Main,,0,0,0,,Kes sesini!
Dialogue: 0,0:16:04.61,0:16:08.50,Main,,0,0,0,,Neden ikiz doğurdum ki?
Dialogue: 0,0:16:08.51,0:16:13.71,Main,,0,0,0,,Sen de muhtemelen\NLola gibi yüz karasısın!
Dialogue: 0,0:16:13.71,0:16:16.09,Main,,0,0,0,,Vurma!
Dialogue: 0,0:16:16.79,0:16:21.59,Main,,0,0,0,,İşime yaramayan evlatlara\Nailemde yer yoktur!
Dialogue: 0,0:16:25.67,0:16:30.55,Main,,0,0,0,,Bir daha çirkin yüzünü bana gösterme!
Dialogue: 0,0:16:33.01,0:16:37.78,Main,,0,0,0,,Geçti oğlum.\NBabuşla anniş yanı başında bak.
Dialogue: 0,0:16:38.90,0:16:42.24,Thoughts,,0,0,0,,{\i1}Çok endişeleniyordum.
Dialogue: 0,0:16:42.73,0:16:45.74,Thoughts,,0,0,0,,{\i1}Zor günlerin oldu mu?
Dialogue: 0,0:16:46.19,0:16:49.45,Thoughts,,0,0,0,,{\i1}Yalnız kaldın mı kızım?
Dialogue: 0,0:16:49.45,0:16:55.06,Thoughts,,0,0,0,,{\i1}Kötü günlerinde yanında\Nolamadığım için özür dilerim.
Dialogue: 0,0:16:56.79,0:16:58.67,Thoughts,,0,0,0,,{\i1}Geç kalmış olsam da...
Dialogue: 0,0:16:59.62,0:17:02.05,Thoughts,,0,0,0,,{\i1}...söyleyeyim.
Dialogue: 0,0:17:03.04,0:17:04.98,Main,,0,0,0,,Bir yastıkta...
Dialogue: 0,0:17:04.98,0:17:07.60,Main,,0,0,0,,...kocayın!
Dialogue: 0,0:17:07.60,0:17:11.56,Main,,0,0,0,,Chiffon!!
Dialogue: 0,0:17:11.56,0:17:12.77,Main,,0,0,0,,Ne?
Dialogue: 0,0:17:19.60,0:17:21.10,Main,,0,0,0,,Çıktık-rero!
Dialogue: 0,0:17:21.10,0:17:23.53,Main,,0,0,0,,Hız kesmeyip filodan kurtulalım!
Dialogue: 0,0:17:26.53,0:17:29.57,Main,,0,0,0,,Pasta güç bela da olsa\Ntek parça kalabildi.
Dialogue: 0,0:17:31.25,0:17:34.50,Main,,0,0,0,,Elimizi çabuk tutalım!\NFazla vaktimiz yok!
Dialogue: 0,0:17:34.50,0:17:36.46,Main,,0,0,0,,Süslemeye başlıyoruz!
Dialogue: 0,0:17:36.46,0:17:38.12,Main,,0,0,0,,Tamamdır!
Dialogue: 0,0:17:36.46,0:17:38.12,Secondary,,0,0,0,,Hay hay!
Dialogue: 0,0:17:38.42,0:17:41.42,Captions,,0,0,0,,{\fad(500,0)}Denizde bir yerde - Sunny
Dialogue: 0,0:17:43.63,0:17:45.72,Main,,0,0,0,,Buldum sizi!
Dialogue: 0,0:17:45.72,0:17:49.43,Main,,0,0,0,,Pastayı verin bakalım!
Dialogue: 0,0:17:54.12,0:17:58.01,Main,,0,0,0,,B- B... B- B- Big Mom?!
Dialogue: 0,0:17:58.01,0:18:00.76,Main,,0,0,0,,Nereden bakarsan bak\Nbu kadın birkaç gömlek üstümüzde!
Dialogue: 0,0:18:00.77,0:18:02.43,Main,,0,0,0,,N'apacağız?
Dialogue: 0,0:18:04.22,0:18:07.18,Main,,0,0,0,,Kaçsak iyi olur galiba.
Dialogue: 0,0:18:07.51,0:18:11.14,Main,,0,0,0,,Hız kestik mi işimiz biter! \NKaçmaya bakalım!
Dialogue: 0,0:18:13.85,0:18:15.26,Main,,0,0,0,,Savunun ulan!
Dialogue: 0,0:18:15.26,0:18:17.39,Main,,0,0,0,,İlk ben varacağım!
Dialogue: 0,0:18:17.39,0:18:19.69,Main,,0,0,0,,Gemilerini batıran ben olacağım ama!
Dialogue: 0,0:18:19.69,0:18:22.07,Main,,0,0,0,,Ha? Düşmanımız kimdi ki?
Dialogue: 0,0:18:22.07,0:18:23.90,Main,,0,0,0,,Hasır Şapkalar oğlum!
Dialogue: 0,0:18:23.90,0:18:28.20,Main,,0,0,0,,Sahi! \Nİyi de hasır şapka göremiyorum ben!
Dialogue: 0,0:18:28.20,0:18:31.33,Main,,0,0,0,,Bakar mısınız?\NHasır Şapkalar nerede?
Dialogue: 0,0:18:31.33,0:18:33.00,Main,,0,0,0,,Şu yöne kaçtılar!
Dialogue: 0,0:18:33.00,0:18:33.99,Main,,0,0,0,,Ne?
Dialogue: 0,0:18:33.99,0:18:35.88,Main,,0,0,0,,Gidelim! Şu yöndelermiş!
Dialogue: 0,0:18:35.88,0:18:37.67,Main,,0,0,0,,Yardımınız için teşekkürler!
Dialogue: 0,0:18:37.67,0:18:40.97,Main,,0,0,0,,Amanın!\NDaha ileri gidemiyorum.
Dialogue: 0,0:18:43.85,0:18:45.56,Main,,0,0,0,,Ne biçim gülleydi onlar?
Dialogue: 0,0:18:45.56,0:18:46.76,Main,,0,0,0,,Hiçbir fikrim yok.
Dialogue: 0,0:18:48.92,0:18:50.93,Main,,0,0,0,,Andavallar!
Dialogue: 0,0:18:50.93,0:18:54.28,Main,,0,0,0,,Bu gülleler hiç mi bi' boka yaramaz?
Dialogue: 0,0:18:54.28,0:18:56.06,Main,,0,0,0,,N'oluyor lan?
Dialogue: 0,0:18:56.06,0:19:00.07,Main,,0,0,0,,Malumunuz, Mama kendinde değilken\Ngülleler de başına buyruk oluyor!
Dialogue: 0,0:19:00.07,0:19:02.19,Main,,0,0,0,,Fırlatın lan beni!
Dialogue: 0,0:19:02.19,0:19:03.78,Main,,0,0,0,,Beni fırlatın asıl!
Dialogue: 0,0:19:03.78,0:19:09.43,Main,,0,0,1,,Bavarois-{\i1}sama{\i1}!{\i0} Onları batırabilirim!
Dialogue: 0,0:19:06.21,0:19:10.79,Captions,,0,0,235,,{\fad(500,0)}Charlotte Ailesi'nin 26. Oğlu\NCharlotte Bavarois
Dialogue: 0,0:19:06.31,0:19:10.79,Note,,0,0,0,,Bavarois: Adını Bavarian Kremasından alır.
Dialogue: 0,0:19:09.43,0:19:10.79,Main,,0,0,1,,Sıçayım!
Dialogue: 0,0:19:10.79,0:19:16.00,Main,,0,0,0,,Mama hiç yavaşlamadı ki.\NBiz de tam sürat gidiyoruz!
Dialogue: 0,0:19:16.00,0:19:17.92,Main,,0,0,0,,Neden yetişemedik gitti?
Dialogue: 0,0:19:19.83,0:19:23.72,Main,,0,0,0,,Denizi avcunun için gibi bilen\NJinbe yanlarında olduğundandır.
Dialogue: 0,0:19:27.51,0:19:31.47,Main,,0,0,0,,Bavarois-{\i1}sama{\i0}! Telefon aldık!
Dialogue: 0,0:19:32.09,0:19:33.69,Main,,0,0,0,,Geldiler demek!
Dialogue: 0,0:19:34.93,0:19:36.40,Main,,0,0,0,,Millet!
Dialogue: 0,0:19:36.40,0:19:38.11,Main,,0,0,0,,Ne oldu Carrot?
Dialogue: 0,0:19:38.11,0:19:40.61,Main,,0,0,0,,Pruva istikametinde düzinelerce gemi var!
Dialogue: 0,0:19:42.70,0:19:44.73,Main,,0,0,0,,Ne?
Dialogue: 0,0:19:44.73,0:19:47.72,Main,,0,0,0,,Eyvah! Kıstırıldık!
Dialogue: 0,0:19:52.18,0:19:57.78,Main,,0,0,0,,Düğün pastası!
Dialogue: 0,0:20:11.91,0:20:13.88,Main,,0,0,0,,{\fad(150,150)}Gear Third!
Dialogue: 0,0:20:11.91,0:20:13.88,Note,,0,0,0,,{\fad(150,150)}Üçüncü Vites
Dialogue: 0,0:20:20.71,0:20:23.55,Main,,0,0,0,,Yeni kavuşmuşuz. Celallenme hemen.
Dialogue: 0,0:20:26.56,0:20:30.87,Main,,0,0,0,,Kaçıp gitseydin eğer,\Nrakibin ben olduğumdan...
Dialogue: 0,0:20:30.87,0:20:33.35,Main,,0,0,0,,...kimse alay etmezdi.
Dialogue: 0,0:20:34.69,0:20:37.11,Main,,0,0,0,,Neden döndün?
Dialogue: 0,0:20:38.38,0:20:44.04,Main,,0,0,0,,Kaçtığın için el âlemin gözünde\Nrezil olmaktansa ölümü mü seçtin?
Dialogue: 0,0:20:44.04,0:20:45.69,Main,,0,0,0,,Ölümü mü seçmişim?
Dialogue: 0,0:20:45.69,0:20:49.54,Main,,0,0,0,,Yoksa bana denk olmadığını anlayıp da...
Dialogue: 0,0:20:49.54,0:20:54.02,Main,,0,0,0,,...müttefiğimiz olmak için yalvarmaya mı geldin?
Dialogue: 0,0:20:55.15,0:20:56.69,Main,,0,0,0,,Yalvarmak mı?
Dialogue: 0,0:20:59.40,0:21:01.00,Main,,0,0,0,,Hadi lan oradan!
Dialogue: 0,0:21:02.06,0:21:03.21,Main,,0,0,0,,Buraya...
Dialogue: 0,0:21:04.16,0:21:06.38,Main,,0,0,0,,...seni yenmeye geldim!
Dialogue: 0,0:21:14.75,0:21:17.47,Main,,0,0,0,,Yenmeye geldin demek?
Dialogue: 0,0:21:17.47,0:21:20.30,Main,,0,0,0,,Öyle bir...
Dialogue: 0,0:21:21.85,0:21:23.85,Main,,0,0,0,,...seçenek sunmadım!
Dialogue: 0,0:21:38.93,0:21:40.31,Main,,0,0,0,,Hay böyle işin!
Dialogue: 0,0:21:40.33,0:21:47.13,Main,,0,0,0,,Big Mom'ları kuyruğumuzdan silkmeye\Nkalmadan pruva istikametini kapattılar.
Dialogue: 0,0:21:48.76,0:21:50.73,Main,,0,0,0,,Bavarois-{\i1}sama{\i1}!{\i0}
Dialogue: 0,0:21:50.73,0:21:55.11,Main,,0,0,0,,{\an8}Daifuku-sama'nın önderliğindeki\Nbir filo pruvada belirdi!
Dialogue: 0,0:21:52.04,0:21:55.11,Captions,,0,0,290,,{\fad(500,0)}Charlotte Ailesi'nin 3. Oğlu\NCharlotte Daifuku
Dialogue: 0,0:21:55.11,0:21:57.72,Main,,0,0,0,,Pupadan da takviye geliyor!
Dialogue: 0,0:21:57.72,0:21:58.91,Main,,0,0,0,,Pupadan mı?
Dialogue: 0,0:22:00.65,0:22:02.16,Main,,0,0,0,,Bu...
Dialogue: 0,0:22:02.16,0:22:07.58,Main,,0,0,0,,{\an8}Şekerleme Generali Smoothie-sama \Nönderliğindeki destek filosu da aramıza katıldı!
Dialogue: 0,0:22:03.80,0:22:07.58,Captions,,0,0,230,,{\fad(500,0)}Charlotte Ailesi'nin 14. Kızı\NŞekerleme Generali Smoothie
Dialogue: 0,0:22:08.88,0:22:12.22,Main,,0,0,0,,{\an8}Ayrıca Smoothie-sama'nın\Nkomuta ettiği amiral gemisi güvertesinde...
Dialogue: 0,0:22:11.01,0:22:16.43,Captions,,0,700,235,,{\fad(500,0)}Charlotte Ailesi'nin 16. Kızı\NCinnamon
Dialogue: 0,0:22:11.01,0:22:16.43,Captions,,650,0,235,,{\fad(500,0)}Charlotte Ailesi'nin 15. Kızı\NCitron
Dialogue: 0,0:22:12.22,0:22:16.43,Main,,0,0,0,,{\an8}...Citron-sama ile Cinnamon-sama da yer alıyor!
Dialogue: 0,0:22:16.43,0:22:18.23,Main,,0,0,0,,Onlar da mı gelmiş?
Dialogue: 0,0:22:19.16,0:22:22.69,Main,,0,0,0,,Ama böylelikle yenilmeziz demektir!
Dialogue: 0,0:22:22.69,0:22:25.42,Main,,0,0,0,,Güzel.\NBirkaç kelle uçuralım çocuklar!
Dialogue: 0,0:22:25.42,0:22:27.37,Main,,0,0,0,,Tamamdır!
Dialogue: 0,0:22:30.48,0:22:35.45,Main,,0,0,0,,Baksana Peros abi ya, ne diye\Nbi' sıçan gemisiyle oyalanıyorsun ki?
Dialogue: 0,0:22:35.45,0:22:38.07,Main,,0,0,0,,{\i1}Alabora edeyim gitsin mi?
Dialogue: 0,0:22:38.07,0:22:41.09,Main,,0,0,0,,Kafana göre takıl-perorin.
Dialogue: 0,0:22:41.09,0:22:43.80,Main,,0,0,0,,Gösteriş meraklısısınız!
Dialogue: 0,0:22:43.80,0:22:49.80,Main,,0,0,0,,Mama her hâlükârda Pudding'in\Nbeklediği Kakao Adası'na gidecek zaten.
Dialogue: 0,0:22:51.17,0:22:54.15,Main,,0,0,0,,Mama'mız da zayıflıyor gibi.
Dialogue: 0,0:22:57.67,0:23:01.48,Main,,0,0,0,,Düğün pastası!
Dialogue: 0,0:23:01.48,0:23:04.94,Main,,0,0,0,,Tüm gemiler bombardımana hazırlansın!
Dialogue: 0,0:23:08.24,0:23:11.69,Main,,0,0,0,,Gemileri menzilinize girer girmez...
Dialogue: 0,0:23:11.69,0:23:13.49,Main,,0,0,0,,...topları ateşleyin!
Dialogue: 0,0:23:14.27,0:23:15.57,Main,,0,0,0,,Eyvahlar olsun...
Dialogue: 0,0:23:15.57,0:23:18.66,Main,,0,0,0,,Daifuku'nun filosu\Ntopları ateşlemeye hazırlanıyor!
Dialogue: 0,0:23:19.74,0:23:23.18,Main,,0,0,0,,Daha menzillerine girmemiş olmalıyız.
Dialogue: 0,0:23:23.18,0:23:28.46,Main,,0,0,0,,İskeleye veya sancağa kaçmaya çalışsak da\Ndört bir yandan önümüzü keserler.
Dialogue: 0,0:23:29.87,0:23:33.84,Main,,0,0,0,,Jinbe, hız kesmeden\Nyol almaya devam edelim!
Dialogue: 0,0:23:33.84,0:23:40.18,Main,,0,0,0,,Lakin karşımızda Daifuku'nun gemisi var.\NBir cini kontrol eden dişli bir rakiptir!
Dialogue: 0,0:23:40.18,0:23:45.39,Main,,0,0,0,,İçinde bulunduğumuz vaziyetten\Nkurtulmak için dosdoğru yelken almalıyız!
Dialogue: 0,0:23:45.39,0:23:48.65,Main,,0,0,0,,Evet. Çatışmaya hazırlanalım.
Dialogue: 0,0:23:48.65,0:23:55.45,Main,,0,0,0,,Gümbürtü Topu ile dağıtacağım!\NGemilerine atlayabilmem için yanaşmaya bak!
Dialogue: 0,0:23:55.45,0:23:59.37,Main,,0,0,0,,Yakın mesafeden çatışma\Nöyle kolay geçmeyecek.
Dialogue: 0,0:23:59.37,0:24:00.31,Main,,0,0,0,,Evet!
Dialogue: 0,0:24:00.31,0:24:02.91,Main,,0,0,0,,Hadi bakalım!
Dialogue: 0,0:24:04.74,0:24:07.88,Main,,0,0,0,,Menzilimize girmeleri an meselesi!
Dialogue: 0,0:24:07.88,0:24:10.80,Main,,0,0,0,,Tüm gülleleri üzerlerine yağdırın!
Dialogue: 0,0:24:10.80,0:24:12.19,Main,,0,0,0,,Oley!
Dialogue: 0,0:24:12.19,0:24:14.01,Main,,0,0,0,,Bizim sıramız geldi çattı!
Dialogue: 0,0:24:14.01,0:24:17.01,Main,,0,0,0,,Bakın hele, ifadesiz gülleleri kullanın.
Dialogue: 0,0:24:17.01,0:24:18.27,Main,,0,0,0,,Lütfen ama ya!
Dialogue: 0,0:24:18.27,0:24:19.55,Main,,0,0,0,,Daifuku-{\i1}sama{\i1}!{\i0}
Dialogue: 0,0:24:19.55,0:24:20.88,Main,,0,0,0,,Kesin lan!
Dialogue: 0,0:24:20.88,0:24:23.02,Main,,0,0,0,,Choniki!
Dialogue: 0,0:24:23.02,0:24:24.63,Main,,0,0,0,,Millet!
Dialogue: 0,0:24:25.24,0:24:28.93,Main,,0,0,0,,Daifukular'ı bana bırakın!
Dialogue: 0,0:24:29.76,0:24:32.64,Main,,0,0,0,,Eminim yardımım dokunacaktır!
Dialogue: 0,0:24:32.64,0:24:34.06,Main,,0,0,0,,Carrot?!
Dialogue: 0,0:24:36.31,0:24:38.19,Main,,0,0,0,,Ne de olsa...
Dialogue: 0,0:24:39.14,0:24:41.90,Main,,0,0,0,,...bu gece dolunay var.
Dialogue: 0,0:24:42.52,0:24:48.07,Main,,0,0,0,,Sulong mu olacaksın yoksa?\NGereken eğitimi aldın mı ki?
Dialogue: 0,0:24:42.52,0:24:48.07,Note,,0,0,0,,Sulong: "Dolunay Aslanı"
Dialogue: 0,0:24:48.07,0:24:52.87,Main,,0,0,0,,Merak etme.\NÖğretmenim Pedro idi.
Dialogue: 0,0:24:54.12,0:24:56.93,Main,,0,0,0,,Pedro burada olsa aynen şöyle derdi:
Dialogue: 0,0:24:57.66,0:25:00.25,Main,,0,0,0,,"Ben hallederim."
Dialogue: 0,0:25:00.25,0:25:02.80,Main,,0,0,0,,Carrot saldıracaksa ben de yanında giderim!
Dialogue: 0,0:25:02.80,0:25:06.25,Main,,0,0,0,,Ben hallederim Choniki!
Dialogue: 0,0:25:07.09,0:25:10.14,Main,,0,0,0,,Pek göstermesem de\NSilahşörler'in bir ferdi olurum.
Dialogue: 0,0:25:11.24,0:25:12.72,Main,,0,0,0,,Topların başına!
Dialogue: 0,0:25:12.72,0:25:15.69,Main,,0,0,0,,Bombardımana tutup tez alabora edeceğiz!
Dialogue: 0,0:25:15.69,0:25:18.52,Main,,0,0,0,,İşaretimi bekleyin!
Dialogue: 0,0:25:20.64,0:25:22.90,Flashbacks,,0,0,0,,{\i1}Ne demek istiyorsun Pedro?{\i0}
Dialogue: 0,0:25:23.73,0:25:27.03,Flashbacks,,0,0,0,,Şimdi Luffyler'i kurtarıp\Nyelken almalarını sağlamanın...
Dialogue: 0,0:25:27.03,0:25:31.91,Flashbacks,,0,0,0,,...ne denli mühim olduğunu\Ngünün birinde anlayacaksın!
Dialogue: 0,0:25:35.33,0:25:36.67,Main,,0,0,0,,{\i1}Savaşacağım...
Dialogue: 0,0:25:36.67,0:25:38.72,Thoughts,,0,0,0,,{\i1}Senin-teia yerine de.
Dialogue: 0,0:25:40.35,0:25:42.15,Main,,0,0,0,,{\i1}Pedro!{\i}
Dialogue: 0,0:26:02.47,0:26:03.80,Main,,0,0,0,,N'oluyor lan?
Dialogue: 0,0:27:05.17,0:27:08.83,Main,,0,0,0,,Gözleri kızıl bir renge büründü.\NBambaşka biri izlenimi uyandırıyor.
Dialogue: 0,0:27:08.83,0:27:12.31,Main,,0,0,0,,Carrot... Çok güzel...
Dialogue: 0,0:27:12.31,0:27:15.27,Main,,0,0,0,,Ne esrarengiz...
Dialogue: 0,0:27:15.27,0:27:18.45,Main,,0,0,0,,Gözlerim bayram ediyor resmen!
Dialogue: 0,0:27:18.45,0:27:21.39,Main,,0,0,0,,Ah bir de külodunu görebilsem...
Dialogue: 0,0:27:21.39,0:27:26.07,Main,,0,0,0,,Dük Inuarashi'nin sözünü ettiği olay\Nbu muydu?
Dialogue: 0,0:27:26.49,0:27:28.88,Flashbacks,,0,0,0,,Savaşa girdiğimizde...
Dialogue: 0,0:27:28.88,0:27:35.54,Flashbacks,,0,0,0,,...Kaido'nun ordusunun bir kolu olan\NJack'in taburu bizi bu hâle getirdi.
Dialogue: 0,0:27:35.54,0:27:41.42,Flashbacks,,0,0,0,,Ama bir dahaki sefere durum farklı olacak!\NAynı hataya ikinci kez düşmeyeceğiz.
Dialogue: 0,0:27:41.42,0:27:43.47,Flashbacks,,0,0,0,,Bizim de bir kozumuz var.
Dialogue: 0,0:27:43.47,0:27:49.51,Flashbacks,,0,0,0,,Bir dahaki çarpışmamızda Mink Kabilesi'nin\Ngerçek gücüne tanık olacaklar!
Dialogue: 0,0:27:49.51,0:27:54.26,Main,,0,0,0,,O gün bahsettiği koza bakıyoruz galiba.
Dialogue: 0,0:27:54.26,0:27:56.48,Main,,0,0,0,,Mink Kabilesi'nin...
Dialogue: 0,0:27:56.48,0:27:58.39,Main,,0,0,0,,...gerçek gücü.
Dialogue: 0,0:28:12.90,0:28:16.16,Main,,0,0,0,,Y- Yoksa bu gördüğüm...
Dialogue: 0,0:28:16.16,0:28:18.50,Main,,0,0,0,,Bir sorunumuz var Daifuku-{\i1}sama{\i0}!
Dialogue: 0,0:28:18.50,0:28:23.29,Main,,0,0,0,,Bu gece dolunay var!\NDüşman saflarındaki Mink kız...
Dialogue: 0,0:28:23.75,0:28:25.25,Main,,0,0,0,,...Sulong'a dönüşmüş!
Dialogue: 0,0:28:28.58,0:28:32.55,Main,,0,0,0,,Çocuklar!\NGöğüs göğüse muharebeye hazırlanın!
Dialogue: 0,0:28:33.21,0:28:37.81,Main,,0,0,0,,Yanılmıyorsam Pedro\NHayalet Ada Zou'luydu.
Dialogue: 0,0:28:37.82,0:28:41.06,Main,,0,0,0,,Vatanları aynı galiba.
Dialogue: 0,0:28:48.56,0:28:50.81,Main,,0,0,0,,Bu gidişle denize düşecek!
Dialogue: 0,0:28:52.56,0:28:54.15,Main,,0,0,0,,Ha? N'oldu öyle?
Dialogue: 0,0:28:54.15,0:28:57.24,Main,,0,0,0,,Su yüzeyinden birden yükseliverdi!
Dialogue: 0,0:29:00.20,0:29:02.04,Main,,0,0,0,,Süper ya!
Dialogue: 0,0:29:02.04,0:29:04.75,Main,,0,0,0,,Daha bir şey görmediniz.
Dialogue: 0,0:29:06.37,0:29:08.51,Main,,0,0,0,,Geliyor! Mıhlayın şunu!
Dialogue: 0,0:29:08.51,0:29:09.29,Main,,0,0,0,,Baş üstüne!
Dialogue: 0,0:29:09.29,0:29:10.89,Main,,0,0,0,,Tedbiri elden bırakmayın!
Dialogue: 0,0:29:10.89,0:29:13.23,Main,,0,0,0,,Zou'lu bir savaşçı! Çok güçlü olmalı!
Dialogue: 0,0:29:15.96,0:29:17.93,Main,,0,0,0,,Ben indiririm!
Dialogue: 0,0:29:19.34,0:29:21.28,Main,,0,0,0,,Ne?
Dialogue: 0,0:29:24.39,0:29:26.61,Main,,0,0,0,,Tereddüt etmeyin!\NBitirin işini!
Dialogue: 0,0:29:40.16,0:29:42.54,Main,,0,0,0,,Sıçayım! Vurun lan şunu!
Dialogue: 0,0:29:48.41,0:29:50.42,Main,,0,0,0,,Elimdesin!
Dialogue: 0,0:30:16.02,0:30:17.32,Main,,0,0,0,,Söylesene!
Dialogue: 0,0:30:17.32,0:30:19.95,Main,,0,0,0,,Neler oluyor Chopper?
Dialogue: 0,0:30:23.79,0:30:25.42,Main,,0,0,0,,Aşağılık sıçan!
Dialogue: 0,0:30:25.42,0:30:30.09,Main,,0,0,0,,Güvertedeki tüm askerlerimi\Nalt ederek mi filoyu durduracaksın?
Dialogue: 0,0:30:30.09,0:30:35.51,Main,,0,0,0,,Bu esnada geminiz alabora\Nolacak ama! Boşa uğraşı--
Dialogue: 0,0:30:37.55,0:30:39.01,Main,,0,0,0,,Dümen mi?
Dialogue: 0,0:30:40.47,0:30:43.23,Main,,0,0,0,,D- Dümeni kırmış!
Dialogue: 0,0:30:43.23,0:30:46.56,Main,,0,0,0,,Sıçtık!\NArtık dalgaların insafındayız!
Dialogue: 0,0:30:47.06,0:30:50.69,Main,,0,0,0,,İğrenç sıçan!
