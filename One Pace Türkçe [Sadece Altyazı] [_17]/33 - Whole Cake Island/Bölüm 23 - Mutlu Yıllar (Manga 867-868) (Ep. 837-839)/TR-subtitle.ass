Dialogue: 0,0:01:34.94,0:01:39.90,Main,,0,0,0,,Linlin!\NÖlümün benim elimden olsun!
Dialogue: 0,0:01:42.65,0:01:44.61,Main,,0,0,0,,Semla...
Dialogue: 0,0:02:03.71,0:02:05.01,Main,,0,0,0,,Yapma Linlin!
Dialogue: 0,0:02:06.48,0:02:07.89,Main,,0,0,0,,Se...
Dialogue: 0,0:02:07.89,0:02:09.10,Main,,0,0,0,,Jorl!
Dialogue: 0,0:02:09.10,0:02:11.11,Main,,0,0,0,,m...
Dialogue: 0,0:02:11.11,0:02:12.52,Main,,0,0,0,,la!
Dialogue: 0,0:02:34.03,0:02:35.67,Main,,0,0,0,,Çağlayansakal Hazretleri!
Dialogue: 0,0:02:35.67,0:02:37.11,Main,,0,0,0,,Jorl-{\i1}sama{\i}!
Dialogue: 0,0:02:40.76,0:02:43.59,Main,,0,0,0,,Semla!!!
Dialogue: 0,0:02:43.59,0:02:45.02,Main,,0,0,0,,Linlin'i tutun.
Dialogue: 0,0:02:45.02,0:02:47.17,Main,,0,0,0,,Köydeki yangını durdurun!
Dialogue: 0,0:02:48.22,0:02:51.05,Main,,0,0,0,,- Yakalayın şunu!\N- Tamam!
Dialogue: 0,0:02:51.05,0:02:53.36,Main,,0,0,0,,Canını yakmayın!
Dialogue: 0,0:02:53.36,0:02:54.86,Main,,0,0,0,,Semla bulabilir misin?
Dialogue: 0,0:02:54.86,0:02:57.45,Main,,0,0,0,,Köydeki ambarda\Nfestival için ayrılmış semla var.
Dialogue: 0,0:02:57.45,0:02:58.87,Main,,0,0,0,,Getir hemen!
Dialogue: 0,0:02:58.87,0:03:00.65,Main,,0,0,0,,T- Tamam!
Dialogue: 0,0:03:09.35,0:03:12.62,Main,,0,0,0,,- Anne, ne yapıyorsun?\N- Çok tehlikeli!
Dialogue: 0,0:03:12.62,0:03:14.45,Main,,0,0,0,,Geri çekilin!
Dialogue: 0,0:03:26.82,0:03:28.95,Main,,0,0,0,,{\fad(150,150)}Gebur...
Dialogue: 0,0:03:37.56,0:03:41.06,Main,,0,0,0,,Anne!
Dialogue: 0,0:03:50.64,0:03:54.01,Main,,0,0,0,,{\fad(150,150)}tstag!
Dialogue: 0,0:03:50.64,0:03:54.01,Note,,0,0,0,,Gerburtstag - Doğumgünü
Dialogue: 0,0:03:59.92,0:04:02.47,Main,,0,0,0,,Anne!
Dialogue: 0,0:04:02.52,0:04:04.56,Main,,0,0,0,,Sana sesleniyorum.
Dialogue: 0,0:04:09.40,0:04:11.07,Main,,0,0,0,,Bu da neyin nesi?
Dialogue: 0,0:04:23.81,0:04:26.28,Main,,0,0,0,,İtaat et!
Dialogue: 0,0:04:27.57,0:04:29.60,Main,,0,0,0,,- Ateşte bir sima var!\N- Ne?
Dialogue: 0,0:04:29.60,0:04:31.62,Main,,0,0,0,,Korkuyorum ya.
Dialogue: 0,0:04:32.00,0:04:33.66,Main,,0,0,0,,İblise benziyor!
Dialogue: 0,0:04:35.40,0:04:38.61,Main,,0,0,0,,Adın Pandora!
Dialogue: 0,0:04:41.67,0:04:43.05,Main,,0,0,0,,Getirdim!
Dialogue: 0,0:04:43.05,0:04:45.04,Main,,0,0,0,,Çabuk ver ona!
Dialogue: 0,0:04:45.88,0:04:47.28,Main,,0,0,0,,Semla!
Dialogue: 0,0:04:47.28,0:04:49.43,Main,,0,0,0,,Çok güzel! Enfes!
Dialogue: 0,0:04:51.63,0:04:53.77,Main,,0,0,0,,Öfkeni yatıştır!
Dialogue: 0,0:05:24.24,0:05:26.48,Main,,0,0,0,,Ateş...
Dialogue: 0,0:05:26.48,0:05:28.05,Main,,0,0,0,,...söndü.
Dialogue: 0,0:05:28.72,0:05:30.05,Main,,0,0,0,,Şuraya bakın!
Dialogue: 0,0:05:32.47,0:05:34.18,Main,,0,0,0,,Çok tatlı!
Dialogue: 0,0:05:34.18,0:05:36.02,Main,,0,0,0,,Merhaba Anne!
Dialogue: 0,0:05:36.02,0:05:37.60,Main,,0,0,0,,Anne...
Dialogue: 0,0:05:37.60,0:05:39.69,Main,,0,0,0,,Bir mucize yarattı!
Dialogue: 0,0:05:39.69,0:05:43.19,Main,,0,0,0,,Hayır, ben yapmadım.
Dialogue: 0,0:05:44.85,0:05:48.89,Main,,0,0,0,,Güneş Tanrısı her şeyi dizginledi.
Dialogue: 0,0:05:51.19,0:05:54.44,Main,,0,0,0,,Çok mutluyum ya!
Dialogue: 0,0:05:55.66,0:06:01.19,Main,,0,0,0,,Cezalandırın onu!\NKız olarak görmeyin sakın!
Dialogue: 0,0:06:01.19,0:06:08.18,Main,,0,0,0,,Şimdi ipini çekmezsek ileride\Ndaha büyük felaketler açacaktır!
Dialogue: 0,0:06:08.84,0:06:11.22,Main,,0,0,0,,- Jorl-{\i1}sama{\i}!\N- Hemen tedavi ettirin!
Dialogue: 0,0:06:13.25,0:06:15.22,Main,,0,0,0,,Dağsakal Hazretleri!
Dialogue: 0,0:06:16.84,0:06:18.81,Main,,0,0,0,,Linlin...
Dialogue: 0,0:06:24.94,0:06:26.76,Main,,0,0,0,,Yalvarırım bağışlayın!
Dialogue: 0,0:06:32.19,0:06:35.16,Main,,0,0,0,,Bana engel mi olacaksın Carmel?
Dialogue: 0,0:06:36.61,0:06:41.65,Main,,0,0,0,,Jorl üç asırdır omuz omuza\Ncenk ettiğim bir dostumdur.
Dialogue: 0,0:06:44.91,0:06:49.49,Main,,0,0,0,,Yaşını göz önüne aldığımda\Nkurtulabileceğini sanmıyorum!
Dialogue: 0,0:06:50.00,0:06:55.93,Main,,0,0,0,,Bir savaşçının ne kadar yaşadığı değil,\Nnasıl can verdiği önemlidir!
Dialogue: 0,0:06:56.42,0:06:58.50,Main,,0,0,0,,Bu işe bir son vermeliyiz.
Dialogue: 0,0:06:58.50,0:07:03.36,Main,,0,0,0,,Elbaf'ın kanunlarını çiğneyenler bağışlanamaz!
Dialogue: 0,0:07:03.36,0:07:07.15,Main,,0,0,0,,Anlıyorum! \NNe kadar bağışlanamaz olsa da...
Dialogue: 0,0:07:07.15,0:07:15.20,Main,,0,0,0,,...Linlin, tüm dünyanın sırtını dönmesiyle\Nkendini Kuzu Yuvası'nda bulan bir zavallıcık...
Dialogue: 0,0:07:15.20,0:07:18.31,Main,,0,0,0,,...olduğundan onu gözden çıkaramam!
Dialogue: 0,0:07:19.65,0:07:22.00,Main,,0,0,0,,Ne yapmayı düşünüyorsun?
Dialogue: 0,0:07:22.94,0:07:27.96,Main,,0,0,0,,Onunla beraber ülkeyi terk edeceğim!
Dialogue: 0,0:07:29.13,0:07:30.09,Main,,0,0,0,,Carmel!
Dialogue: 0,0:07:34.97,0:07:38.08,Main,,0,0,0,,Dağsakal Hazretleri!\NLinlin'i öldürün lütfen!
Dialogue: 0,0:07:38.08,0:07:43.15,Main,,0,0,0,,Böyle korkunç işler yapmışken\Nneden affedecekmişiz ki?
Dialogue: 0,0:07:43.15,0:07:45.90,Main,,0,0,0,,Elbaf onurunuz nereye gitti?
Dialogue: 0,0:07:56.97,0:08:01.78,Main,,0,0,0,,Öyleyse derhâl yıkılın karşımdan.
Dialogue: 0,0:08:05.49,0:08:06.74,Main,,0,0,0,,Neden ama?
Dialogue: 0,0:08:06.74,0:08:07.48,Main,,0,0,0,,Hajrudin!
Dialogue: 0,0:08:07.48,0:08:12.00,Main,,0,0,0,,Bırak beni! Bırak!
Dialogue: 0,0:08:20.72,0:08:23.22,Main,,0,0,0,,Çağlayansakal Hazretleri'ne ne oldu?
Dialogue: 0,0:08:23.90,0:08:25.76,Main,,0,0,0,,Öldü.
Dialogue: 0,0:08:25.76,0:08:28.44,Main,,0,0,0,,Hatırlamıyor mu?
Dialogue: 0,0:08:29.18,0:08:33.53,Narrator,,0,0,0,,{\i1}Devler'in kahramanı Jorl ölmüştü.
Dialogue: 0,0:08:34.95,0:08:39.90,Narrator,,0,0,0,,{\i1}Şeytan yakıştırması yapılan Linlin...\NCarmel'in mucizesi...
Dialogue: 0,0:08:41.58,0:08:44.12,Narrator,,0,0,0,,{\i1}O gün yaşananlar...
Dialogue: 0,0:08:44.12,0:08:50.88,Narrator,,0,0,0,,{\i1}...dünyanın dört bir yanındaki sayılı\NDev milletlerine de duyulmuştu.
Dialogue: 0,0:08:50.88,0:08:55.30,Narrator,,0,0,0,,{\i1}Anne'lerinden ayrılmak istemeyen\NKuzu Yuvası yetimleri ve...
Dialogue: 0,0:08:55.30,0:09:00.39,Narrator,,0,0,0,,{\i1}...tüm Dev ırkının düşmanı\Nhâline gelen Charlotte Linlin ile beraber...
Dialogue: 0,0:09:00.39,0:09:04.54,Narrator,,0,0,0,,{\i1}...Anne Carmel, Elbaf'tan ayrılmıştı.
Dialogue: 0,0:09:04.54,0:09:10.30,Narrator,,0,0,0,,{\i1}Böylece yeni Kuzu Yuvaları'nda\Ntemiz bir sayfa açmışlardı.
Dialogue: 0,0:09:10.30,0:09:12.80,Main,,0,0,0,,Bitti!\Nİşinizi görür mü?
Dialogue: 0,0:09:12.80,0:09:17.36,Main,,0,0,0,,Fazlasıyla hem de.\NSize zahmet verdiğim için özür dilerim.
Dialogue: 0,0:09:17.36,0:09:23.75,Main,,0,0,0,,Siz olmasanız dağın derinlerinde\Nböyle bir ev inşa edemezdim.
Dialogue: 0,0:09:23.75,0:09:28.21,Main,,0,0,0,,Lafı olmaz! Doğrusu Linlin'in yüzünü\Nbir daha görmek istemesem de...
Dialogue: 0,0:09:28.21,0:09:32.36,Main,,0,0,0,,...artık Devler arasında da Mukaddes Anne\Nolarak görülüyorsun.
Dialogue: 0,0:09:32.36,0:09:34.06,Main,,0,0,0,,Emirlerine amadeyiz.
Dialogue: 0,0:09:34.06,0:09:35.74,Main,,0,0,0,,Teşekkür ederim!
Dialogue: 0,0:09:36.58,0:09:43.10,Narrator,,0,0,0,,{\i1}Çocukların endişelerini hafifletmek için\NCarmel yüzünden gülümseme eksik etmez oldu.
Dialogue: 0,0:09:45.06,0:09:47.27,Main,,0,0,0,,Durun! Dursanıza!
Dialogue: 0,0:09:47.27,0:09:53.25,Narrator,,0,0,0,,{\i1}Elbaf'tan ayrılmalarından birkaç gün\Nsonra gündelik hayatlarına dönmüşlerdi.
Dialogue: 0,0:09:53.25,0:09:55.80,Main,,0,0,0,,Olamaz, Linlin beni öldürecek!
Dialogue: 0,0:09:55.80,0:09:58.49,Main,,0,0,0,,Dursanıza ya!
Dialogue: 0,0:09:58.99,0:10:03.95,Narrator,,0,0,0,,{\i1}Kuzu Yuvası, çocukların gülüşleriyle dolup taşıyordu.
Dialogue: 0,0:10:03.95,0:10:05.97,Main,,0,0,0,,Yokluğumda eve iyi bakın.
Dialogue: 0,0:10:05.97,0:10:08.10,Main,,0,0,0,,Tuvaleti temizlerim!
Dialogue: 0,0:10:08.10,0:10:10.33,Main,,0,0,0,,Çamaşırları ben yıkarım!
Dialogue: 0,0:10:10.33,0:10:13.20,Main,,0,0,0,,Ne zaman döneceksin?
Dialogue: 0,0:10:13.20,0:10:16.53,Main,,0,0,0,,Yiyecek bir şeyler alır almaz döneceğim.
Dialogue: 0,0:10:16.53,0:10:18.73,Main,,0,0,0,,Hediye olarak ne istersiniz?
Dialogue: 0,0:10:19.48,0:10:20.89,Main,,0,0,0,,Shortcake!
Dialogue: 0,0:10:19.48,0:10:20.89,Note,,0,0,0,,Küçük, çilekli pasta.
Dialogue: 0,0:10:20.89,0:10:23.68,Main,,0,0,0,,– İskambil kâğıtları!\N– Samuray dövüşü için oyuncak kılıçlar!
Dialogue: 0,0:10:23.68,0:10:25.71,Main,,0,0,0,,Tamamdır.
Dialogue: 0,0:10:26.56,0:10:30.46,Main,,0,0,0,,Görüşürüz Anne! Dikkatli ol!
Dialogue: 0,0:10:33.36,0:10:36.68,Narrator,,0,0,0,,Kuzu Yuvası'na dair bir hikâye\Ndilden dile dolaşırdı.
Dialogue: 0,0:10:36.68,0:10:40.80,Narrator,,0,0,0,,Yaramaz çocuklar Anne'nin şefkatiyle\Ntamamen değişerek...
Dialogue: 0,0:10:40.80,0:10:43.83,Narrator,,0,0,0,,...üvey ailelerine kavuşurdu.
Dialogue: 0,0:10:49.52,0:10:51.51,Main,,0,0,0,,Tam vaktinde.
Dialogue: 0,0:10:52.97,0:10:59.01,Main,,0,0,0,,Herhâlde.\NSizi hiç ektim mi?
Dialogue: 0,0:10:59.01,0:11:01.89,Main,,0,0,0,,İş konuşalım.
Dialogue: 0,0:11:07.69,0:11:10.90,Main,,0,0,0,,Elimde iyi bir kız var.
Dialogue: 0,0:11:16.66,0:11:19.44,Main,,0,0,0,,Elbaf'tan ayrılmanı beklemiyordum.
Dialogue: 0,0:11:19.48,0:11:24.00,Main,,0,0,0,,O kızı kaybetmeyi\Nne kadar istemediğimi anla.
Dialogue: 0,0:11:37.80,0:11:39.90,Main,,0,0,0,,İyi düşünün.
Dialogue: 0,0:11:39.90,0:11:44.60,Main,,0,0,0,,Daha 5 yaşında olmasına rağmen Elbaf köyünün yarısını yok edecek kadar olağanüstü bir kız.
Dialogue: 0,0:11:44.60,0:11:46.66,Main,,0,0,0,,Fakat istediğin ücret...
Dialogue: 0,0:11:46.66,0:11:48.98,Main,,0,0,0,,Fazla değil.
Dialogue: 0,0:11:48.98,0:11:52.83,Main,,0,0,0,,Donanma'da bir koramiral ya da\Nfilo amirali bile olabilir.
Dialogue: 0,0:11:52.83,0:11:57.41,Main,,0,0,0,,Cipher Pol'de ise Kutsal Ejderler için\Nen iyi koruma olacaktır.
Dialogue: 0,0:11:58.82,0:12:01.75,Main,,0,0,0,,50 yıldır çocuk ticareti yapıyorum.
Dialogue: 0,0:12:01.75,0:12:05.58,Main,,0,0,0,,Bu kız ise şu ana kadar\Nelimden geçenlerin arasında bir şaheser!
Dialogue: 0,0:12:06.16,0:12:12.21,Main,,0,0,0,,37 yıl evvel Donanma ile iyi bir gösteri\Nortaya koyarak Elbaf'a sızmayı başardım.
Dialogue: 0,0:12:12.21,0:12:20.97,Main,,0,0,0,,Arabuluculuğum sayesinde John Giant\NDonanma'nın ilk Dev askeri oldu.
Dialogue: 0,0:12:21.91,0:12:25.02,Main,,0,0,0,,Kuzu Yuvası'ndaki çocukları kafalayıp...
Dialogue: 0,0:12:25.02,0:12:30.15,Main,,0,0,0,,...her iki senede bir çiçeği burnunda\Nyetimleri Hükûmet'e satıyorum.
Dialogue: 0,0:12:30.84,0:12:34.07,Main,,0,0,0,,İstihbarat subayı olmak için\Nbiçilmiş kaftan değiller mi?
Dialogue: 0,0:12:34.07,0:12:36.30,Main,,0,0,0,,Yetimlerin izi sürülemez.
Dialogue: 0,0:12:36.30,0:12:39.37,Main,,0,0,0,,Tamam! Anladık! \NParayı toparlamaya çalışacağım.
Dialogue: 0,0:12:40.12,0:12:42.05,Main,,0,0,0,,Yapacaksın tabii!
Dialogue: 0,0:12:42.49,0:12:45.85,Main,,0,0,0,,Mukaddes Anne rolü kesmek\Namma yoruyor!
Dialogue: 0,0:12:45.87,0:12:52.59,Captions,,0,0,0,,{\pos(642,446)}Yetim Taciri\NAnne Carmel\N(Yeraltındaki Namı: Dağ Cadısı){\fad(500,500)}
Dialogue: 0,0:12:46.63,0:12:52.34,Main,,0,0,0,,Bu vesileyle emekli olmayı düşünüyorum.\N{\an8}
Dialogue: 0,0:12:52.34,0:12:57.05,Main,,0,0,0,,Son ticaretim olacak yani.\NParayı eksiksiz istiyorum!
Dialogue: 0,0:13:01.58,0:13:04.35,Main,,0,0,0,,Bugün hangi şarkıyı söylemek istersiniz?
Dialogue: 0,0:13:04.35,0:13:06.60,Main,,0,0,0,,"Binks'in Sakesi"!
Dialogue: 0,0:13:06.60,0:13:09.56,Main,,0,0,0,,Ne? Ama o bir korsan şarkısı.
Dialogue: 0,0:13:09.56,0:13:12.65,Main,,0,0,0,,Evet! Biz de günün birinde korsan olacağız!
Dialogue: 0,0:13:12.65,0:13:15.07,Main,,0,0,0,,Demek öyle, çok havalı!
Dialogue: 0,0:13:17.70,0:13:21.87,Lyrics,,0,0,0,,Binks'in Sakesi'ni götürelim haydi!
Dialogue: 0,0:13:21.87,0:13:25.95,Lyrics,,0,0,0,,♪ Deniz rüzgârları nereye eserse! Dalgalarda yol alalım! ♪
Dialogue: 0,0:13:25.95,0:13:30.25,Lyrics,,0,0,0,,♪ Tuzlu derinlikler hemen dibimizde! \NAkşam güneşinin keyfi tıkırında! ♪
Dialogue: 0,0:13:30.25,0:13:32.05,Lyrics,,0,0,0,,♪ Kuşlar semada daireler çizerken şarkı söylüyorlar! ♪
Dialogue: 0,0:13:32.05,0:13:34.39,Lyrics,,0,0,0,,♪ Kuşlar semada daireler çizerken şarkı söylüyorlar! ♪
Dialogue: 0,0:13:32.75,0:13:37.09,Thoughts,,0,0,0,,{\an8}Her birinizi korsan olma şansı bulamadan Hükûmet'e satacağım oysa!
Dialogue: 0,0:13:34.39,0:13:38.76,Lyrics,,0,0,0,,♪ Eski evime, limana veda ediyoruz! ♪
Dialogue: 0,0:13:38.76,0:13:42.89,Lyrics,,0,0,0,,♪ Gemiler yelken alırken Don ile şarkı söyleyelim! ♪
Dialogue: 0,0:13:42.89,0:13:47.27,Lyrics,,0,0,0,,♪ Sarı ve gri dalgalar çarpışır, tuzlu serpintiler oluşur. ♪
Dialogue: 0,0:13:47.27,0:13:52.55,Lyrics,,0,0,0,,♪ Denizlerin sonuna doğru yelken açarız. ♪
Dialogue: 0,0:13:52.55,0:13:55.25,Main,,0,0,0,,Bir, iki, üç!
Dialogue: 0,0:13:55.25,0:14:00.21,Main,,0,0,0,,Mutlu Yıllar Linlin!
Dialogue: 0,0:14:02.66,0:14:06.51,Main,,0,0,0,,Teşekkür ederim arkadaşlar!
Dialogue: 0,0:14:06.51,0:14:12.02,Main,,0,0,0,,En sevdiğin tatlı olan semlalar'ı üst üste\Nyığarak bu Croquembouche* Kulesi'ni yaptık!
Dialogue: 0,0:14:12.02,0:14:13.98,Main,,0,0,0,,Umarım güzel olmuştur!
Dialogue: 0,0:14:13.98,0:14:17.90,Main,,0,0,0,,Croquembouche Kulesi mi deniyor?\NEnfes duruyor!
Dialogue: 0,0:14:20.82,0:14:22.19,Main,,0,0,0,,Haydi çay partisi yapalım!
Dialogue: 0,0:14:22.19,0:14:23.70,Main,,0,0,0,,Çay partisi mi?
Dialogue: 0,0:14:23.70,0:14:29.82,Main,,0,0,0,,Hep birlikte masaya oturduktan sonra\Nçay içip tatlı yemeye denir!
Dialogue: 0,0:14:29.82,0:14:33.42,Main,,0,0,0,,Çok beğendim! Yapalım haydi!\NÇay partisi!
Dialogue: 0,0:14:33.42,0:14:35.80,Main,,0,0,0,,- Çay demleyelim.\N- Sen de bize katıl Anne!
Dialogue: 0,0:14:35.80,0:14:37.54,Main,,0,0,0,,Katılayım bakalım.
Dialogue: 0,0:14:37.90,0:14:39.38,Main,,0,0,0,,Teşekkür ederim.
Dialogue: 0,0:14:39.38,0:14:40.50,Main,,0,0,0,,Oley be!
Dialogue: 0,0:14:42.23,0:14:44.15,Main,,0,0,0,,Haydi başlayalım!
Dialogue: 0,0:14:44.15,0:14:46.76,Main,,0,0,0,,- İstediğin kadar ye!\N- Yumul gitsin!
Dialogue: 0,0:14:46.76,0:14:49.28,Main,,0,0,0,,Tamam!\NŞükürler olsun!
Dialogue: 0,0:14:50.80,0:14:53.84,Main,,0,0,0,,Enfes!
Dialogue: 0,0:14:55.35,0:14:57.35,Main,,0,0,0,,Çok hızlı yiyor!
Dialogue: 0,0:15:00.32,0:15:03.15,Main,,0,0,0,,Çay partisi çok eğlenceliymiş!
Dialogue: 0,0:15:04.42,0:15:08.53,Main,,0,0,0,,Çok mutluyum ya!\NEnfes bir tadı var!
Dialogue: 0,0:15:09.16,0:15:13.29,Narrator,,0,0,0,,{\i1}Günün birinde Anne Carmel ortadan kaybolur.
Dialogue: 0,0:15:13.29,0:15:19.38,Narrator,,0,0,0,,{\i1}Tam da Linlin'in en mutlu olduğu\Ndoğum gününde!{\i}
Dialogue: 0,0:15:25.08,0:15:29.09,Narrator,,0,0,0,,{\i1}Kendisiyle benzer olaylar yaşamış,\NKuzu Yuvası'ndaki değerli arkadaşlarının...
Dialogue: 0,0:15:29.62,0:15:32.89,Narrator,,0,0,0,,{\i1}Çok sevdiği, açık fikirli ve\Ncömert Anne'sinin...
Dialogue: 0,0:15:33.31,0:15:39.06,Narrator,,0,0,0,,{\i1}...gülüşleriyle çevrelenmişken en sevdiği\Ntatlı olan doğum günü pastasını yiyen...
Dialogue: 0,0:15:39.06,0:15:43.23,Narrator,,0,0,0,,{\i1}...Linlin gözyaşlarına hâkim olamamıştı.
Dialogue: 0,0:15:43.23,0:15:45.36,Main,,0,0,0,,Yiyebildiğin kadar ye Linlin.
Dialogue: 0,0:15:45.36,0:15:47.86,Main,,0,0,0,,Yiyeceğim...\NHepsini yiyeceğim.
Dialogue: 0,0:15:48.46,0:15:54.07,Narrator,,0,0,0,,{\i1}Çok güzel bir gündü.\NGözyaşlarından göremez olmuştu.
Dialogue: 0,0:15:56.70,0:15:59.40,Main,,0,0,0,,Hop, acele etme Linlin!
Dialogue: 0,0:15:59.40,0:16:01.50,Main,,0,0,0,,Senin için yaptık!
Dialogue: 0,0:16:01.50,0:16:02.96,Main,,0,0,0,,Hepsi senindir!
Dialogue: 0,0:16:02.96,0:16:04.98,Main,,0,0,0,,Teşekkür ederim!
Dialogue: 0,0:16:08.63,0:16:10.05,Main,,0,0,0,,Biraz daha ye!
Dialogue: 0,0:16:10.05,0:16:12.18,Main,,0,0,0,,Hep arkadaş kalalım!
Dialogue: 0,0:16:12.18,0:16:13.50,Main,,0,0,0,,Kesinlikle!
Dialogue: 0,0:16:15.36,0:16:17.89,Main,,0,0,0,,Hiç ayrılmayıp eğlenmeye devam edelim!
Dialogue: 0,0:16:17.89,0:16:19.02,Main,,0,0,0,,Evet!
Dialogue: 0,0:16:19.02,0:16:21.59,Main,,0,0,0,,Enfes!
Dialogue: 0,0:16:21.59,0:16:25.91,Narrator,,0,0,0,,{\i1}Harika bir doğum günü olmuştu.
Dialogue: 0,0:16:25.91,0:16:27.70,Main,,0,0,0,,Yalayayım!
Dialogue: 0,0:16:27.70,0:16:33.90,Main,,0,0,0,,Çok mutluyum ya! \NHızımı alamadım, masayı bile ısırdım!
Dialogue: 0,0:16:33.90,0:16:39.78,Main,,0,0,0,,Teşekkürler arkadaşlar!\NBugünü hiç unutmayacağım.
Dialogue: 0,0:16:45.70,0:16:47.23,Main,,0,0,0,,Ne?
Dialogue: 0,0:16:47.50,0:16:50.02,Main,,0,0,0,,Arkadaşlar?
Dialogue: 0,0:16:50.02,0:16:51.23,Main,,0,0,0,,Anne?
Dialogue: 0,0:16:52.20,0:16:54.50,Narrator,,0,0,0,,{\i1}Günün birinde Anne Carmel...
Dialogue: 0,0:16:54.50,0:16:56.20,Main,,0,0,0,,Nereye gittiniz?
Dialogue: 0,0:16:56.20,0:16:58.98,Narrator,,0,0,0,,{\i1}...ansızın sırra kadem basmıştı.
Dialogue: 0,0:16:58.98,0:17:02.15,Main,,0,0,0,,Ha? Ne?
Dialogue: 0,0:17:02.15,0:17:05.78,Main,,0,0,0,,Neredesiniz? Arkadaşlar!\NEvde misiniz?
Dialogue: 0,0:17:17.84,0:17:19.65,Main,,0,0,0,,Hey!
Dialogue: 0,0:17:21.36,0:17:23.22,Main,,0,0,0,,Arkadaşlar!
Dialogue: 0,0:17:25.76,0:17:26.93,Main,,0,0,0,,Linlin!
Dialogue: 0,0:17:31.81,0:17:34.23,Main,,0,0,0,,Buldum sizi!
Dialogue: 0,0:17:34.68,0:17:36.29,Main,,0,0,0,,Ne?
Dialogue: 0,0:17:43.44,0:17:46.62,Main,,0,0,0,,Beni terk etmeyin...
Dialogue: 0,0:17:49.57,0:17:52.58,Main,,0,0,0,,Neredesiniz arkadaşlar?
Dialogue: 0,0:18:01.82,0:18:04.84,Flashbacks,,0,0,0,,{\i1}Baksana Anne...
Dialogue: 0,0:18:04.84,0:18:09.22,Flashbacks,,0,0,0,,{\i1}...neden birdenbire ortadan kayboldun?
Dialogue: 0,0:18:21.60,0:18:24.00,Main,,0,0,0,,Nereye gittin?
Dialogue: 0,0:18:24.00,0:18:27.06,Main,,0,0,0,,Anne!
Dialogue: 0,0:18:27.06,0:18:28.91,Main,,0,0,0,,Mama!
Dialogue: 0,0:18:29.66,0:18:35.05,Narrator,,0,0,0,,{\i1}63 yıl önce Anne Carmel ile diğer\Nçocuklar kayıplara karıştı.
Dialogue: 0,0:18:35.94,0:18:43.43,Narrator,,0,0,0,,{\i1}Big Mom bile bunu bilmez fakat o gün\Nyaşananlara iki kişi şahit olmuştu.
Dialogue: 0,0:18:44.76,0:18:46.98,Main,,0,0,0,,Nereye kayboldunuz?
Dialogue: 0,0:18:46.98,0:18:51.50,Narrator,,0,0,0,,{\i1}Kuzu Yuvası'nda her şey\Nyolunda mı diye bakmaya gelen...
Dialogue: 0,0:18:51.50,0:18:53.27,Narrator,,0,0,0,,{\i1}...Elbaflı savaşçı onlardan biriydi.
Dialogue: 0,0:18:53.97,0:18:56.20,Main,,0,0,0,,C- Canavar!
Dialogue: 0,0:18:56.20,0:18:59.16,Narrator,,0,0,0,,{\i1}Beti benzi atmış hâlde koşarak...
Dialogue: 0,0:18:59.16,0:19:02.94,Narrator,,0,0,0,,{\i1}...bir daha o adanın yakınlarından bile geçmedi.
Dialogue: 0,0:19:04.68,0:19:10.03,Narrator,,0,0,0,,{\i1}Nihayetinde ise Elbaf ve diğer ülkelerdeki\NDevler olan biteni öğrenince...
Dialogue: 0,0:19:10.45,0:19:16.20,Narrator,,0,0,0,,{\i1}...Charlotte Linlin'e olan nefretleri\Ndaha da büyüyerek...
Dialogue: 0,0:19:16.20,0:19:20.34,Narrator,,0,0,0,,{\i1}...adını bile ağızlarına almaz oldular.
Dialogue: 0,0:19:22.22,0:19:26.75,Main,,0,0,0,,Nereye gittiniz? Anne! Arkadaşlar!
Dialogue: 0,0:19:26.75,0:19:30.22,Narrator,,0,0,0,,{\i1}Diğer şahit ise...
Dialogue: 0,0:19:30.22,0:19:35.30,Narrator,,0,0,0,,{\i1}...bir zamanlar korsan olan ve \NBig Mom'ın yalnız kaldığı adada yaşayan...
Dialogue: 0,0:19:35.30,0:19:37.64,Narrator,,0,0,0,,{\i1}...aşçı Streusen idi.
Dialogue: 0,0:19:42.78,0:19:46.01,Narrator,,0,0,0,,{\i1}Bu yaşananlara çok gülmüştü.
Dialogue: 0,0:20:01.94,0:20:03.74,Narrator,,0,0,0,,{\i1}Her türlü nesneyi...
Dialogue: 0,0:20:03.74,0:20:09.26,Narrator,,0,0,0,,{\i1}...yiyeceğe çevirebilen bir yeteneğe,\NKuku Kuku(Pişir) Meyvesi'nin gücüne sahipti.
Dialogue: 0,0:20:16.28,0:20:18.89,Main,,0,0,0,,Böyle bir canavarı ne gördüm ne duydum.
Dialogue: 0,0:20:18.89,0:20:22.10,Main,,0,0,0,,Beni geride bırakmayın...
Dialogue: 0,0:20:23.54,0:20:26.98,Main,,0,0,0,,Kendi hâline bırakırsam ölüp gider.\NO zaman da yazık olur.
Dialogue: 0,0:20:33.33,0:20:35.78,Main,,0,0,0,,Nereye gittin Anne?
Dialogue: 0,0:20:38.22,0:20:41.46,Main,,0,0,0,,Baksana, ne oldu küçük kız?
Dialogue: 0,0:20:41.46,0:20:44.46,Main,,0,0,0,,Ağlayıp durursan karnın acıkır anca.
Dialogue: 0,0:20:45.32,0:20:50.20,Main,,0,0,0,,Bak ne diyeceğim küçük kız, \Nhayallerinden falan bahsetmek ister misin?
Dialogue: 0,0:20:50.20,0:20:51.80,Main,,0,0,0,,Sen kimsin amca?
Dialogue: 0,0:20:51.80,0:20:53.55,Main,,0,0,0,,Fazla yanaşma bakayım!
Dialogue: 0,0:20:53.55,0:20:59.64,Main,,0,0,0,,Baksana amca, Anne'yi gördün mü?\NArkadaşlarımın nereye gittiğini biliyor musun?
Dialogue: 0,0:20:59.64,0:21:03.03,Main,,0,0,0,,Bilmiyorum.\NÇok geçmeden dönerler ama.
Dialogue: 0,0:21:03.50,0:21:04.80,Main,,0,0,0,,Öyle mi dersin?
Dialogue: 0,0:21:04.80,0:21:07.64,Main,,0,0,0,,Evet, o zamana kadar da\Nyanından ayrılmayacağım.
Dialogue: 0,0:21:07.64,0:21:12.74,Main,,0,0,0,,İyi yemek yaparım. \NSeni doyuracak kadar yemek hazırlayabilirim.
Dialogue: 0,0:21:16.20,0:21:19.28,Main,,0,0,0,,Karnım acıktı.
Dialogue: 0,0:21:19.28,0:21:21.69,Main,,0,0,0,,O işi bana bırak!
Dialogue: 0,0:21:40.98,0:21:42.48,Main,,0,0,0,,Gördün mü?
Dialogue: 0,0:21:42.48,0:21:49.07,Narrator,,0,0,0,,{\i1}O an tanışan ikili Big Mom Korsanları'nın\Nkurucu ortakları olacak idi.
Dialogue: 0,0:22:07.04,0:22:09.21,Main,,0,0,0,,Linlin!
Dialogue: 0,0:22:09.21,0:22:12.71,Main,,0,0,0,,Kendine gel! Seni vuracaklar!
Dialogue: 0,0:22:13.64,0:22:16.30,Flashbacks,,0,0,0,,{\i1}Yani bugün çay partisinde...
Dialogue: 0,0:22:16.30,0:22:21.17,Flashbacks,,0,0,0,,{\i1}...o resmi parçaladık mı n'olur dersiniz?
Dialogue: 0,0:22:21.77,0:22:23.60,Flashbacks,,0,0,0,,{\i1}Mama kahrolur!
Dialogue: 0,0:22:23.60,0:22:28.61,Flashbacks,,0,0,0,,{\i1}Orada bulunan herkes ise beş saniyeden\Nuzun bir süre boyunca hareketsiz kalır.
Dialogue: 0,0:22:28.61,0:22:32.82,Flashbacks,,0,0,0,,{\i1}Akabinde KX Fırlatıcı\Ngerçek gücünü göstererek...
Dialogue: 0,0:22:34.11,0:22:37.49,Flashbacks,,0,0,0,,{\i1}...Yonkou Big Mom ölür!
Dialogue: 0,0:22:43.64,0:22:46.29,Main,,0,0,0,,İşin bitti Big Mom!
Dialogue: 0,0:22:47.64,0:22:49.04,Main,,0,0,0,,Mama!
Dialogue: 0,0:23:07.64,0:23:09.92,Thoughts,,0,0,0,,{\i1}Anne.{\i}
Dialogue: 0,0:23:09.92,0:23:13.28,Thoughts,,0,0,0,,{\i1}Herkes işime karışıyor.
Dialogue: 0,0:23:17.84,0:23:23.91,Main,,0,0,0,,İnsanların gözünde gerçek mutluluk\Neşit olmaktır.
Dialogue: 0,0:23:23.91,0:23:29.59,Main,,0,0,0,,Fakat şu anki dünyamızda böyle bir\Nülke bulmak neredeyse imkânsızdır.
Dialogue: 0,0:23:29.59,0:23:34.13,Main,,0,0,0,,O yüzden de burayı ülkemiz yapalım haydi!
Dialogue: 0,0:23:34.13,0:23:37.80,Main,,0,0,0,,Herkesin bu fikirde hareket edeceği bir ülke!
Dialogue: 0,0:23:37.80,0:23:39.18,Main,,0,0,0,,Ülke mi?
Dialogue: 0,0:23:39.18,0:23:43.20,Main,,0,0,0,,Evet, ırk veya din ayrımı\Nyapılmaksızın...
Dialogue: 0,0:23:43.20,0:23:46.10,Main,,0,0,0,,...herkesin aynı şartlarda\Nyaşayacağı bir ülke!
Dialogue: 0,0:23:46.85,0:23:49.69,Main,,0,0,0,,Aynı şartlarda!\NGüzel fikirmiş!
Dialogue: 0,0:23:50.12,0:23:53.27,Main,,0,0,0,,Herkes büyüsün o zaman!
Dialogue: 0,0:23:54.07,0:23:56.44,Main,,0,0,0,,Vay! Süper ya!
Dialogue: 0,0:23:56.99,0:23:59.65,Main,,0,0,0,,Harika bir hayalmiş Anne!
Dialogue: 0,0:24:05.54,0:24:08.58,Main,,0,0,0,,Linlin!
Dialogue: 0,0:24:09.64,0:24:13.67,Main,,0,0,0,,Çocuklar, ele ele verip gayret edelim!
Dialogue: 0,0:24:13.87,0:24:15.20,Main,,0,0,0,,Ben de gayret göstereceğim!
Dialogue: 0,0:24:15.20,0:24:16.78,Main,,0,0,0,,- Ben de! - Ben de!
Dialogue: 0,0:24:16.78,0:24:18.40,Main,,0,0,0,,Evet!
Dialogue: 0,0:24:18.40,0:24:21.33,Main,,0,0,0,,Burayı hayaller ülkesi yapalım haydi!
Dialogue: 0,0:24:21.33,0:24:23.64,Main,,0,0,0,,Ben de elimden geleni yapacağım Anne!
Dialogue: 0,0:24:23.64,0:24:26.72,Main,,0,0,0,,Çok temiz kalplisin Linlin.
Dialogue: 0,0:24:27.28,0:24:28.60,Main,,0,0,0,,Evet!
Dialogue: 0,0:24:28.60,0:24:33.95,Main,,0,0,0,,Böyle ülkelerin sayısı artsa\Ndünya daha huzurlu olurdu.
Dialogue: 0,0:24:33.95,0:24:38.61,Main,,0,0,0,,Herkes musmutlu olabilirdi.
Dialogue: 0,0:24:41.24,0:24:45.45,Main,,0,0,0,,Anne'nin hayali benim de hayalimdi!
Dialogue: 0,0:24:45.90,0:24:50.08,Main,,0,0,0,,Huzur mu?\NHayalin bu mu Linlin?
Dialogue: 0,0:24:50.08,0:24:56.75,Main,,0,0,0,,Evet! Anne'nin seveceği\Nbir ülke inşa edeceğim!
Dialogue: 0,0:25:10.32,0:25:13.14,Main,,0,0,0,,Ağlamayı bıraksan artık?
Dialogue: 0,0:25:13.14,0:25:17.73,Main,,0,0,0,,Baksana ya!\NAnne'nin büyüsünü görmek istiyorum!
Dialogue: 0,0:25:17.73,0:25:18.74,Main,,0,0,0,,Büyü mü?
Dialogue: 0,0:25:18.74,0:25:22.95,Main,,0,0,0,,Evet, Anne büyülü numaraları\Nustaca yapardı.
Dialogue: 0,0:25:22.95,0:25:26.12,Main,,0,0,0,,Galiba ellerini böyle tutup...
Dialogue: 0,0:25:28.62,0:25:30.87,Main,,0,0,0,,...sonra da...
Dialogue: 0,0:25:35.22,0:25:38.84,Lyrics,,0,0,0,,♪ Çiçek, çiçek! Çiçek, çiçek! ♪
Dialogue: 0,0:25:38.84,0:25:42.70,Main,,0,0,0,,Ne? Anne'nin yaptığı büyü numarası!\NNasıl ama?
Dialogue: 0,0:25:42.70,0:25:44.38,Main,,0,0,0,,Ben de yapabiliyorum!
Dialogue: 0,0:25:44.38,0:25:49.20,Lyrics,,0,0,0,,♪ Çiçek, çiçek! Çiçek, çiçek! ♪\N♪ Çiçek, çiçek! ♪
Dialogue: 0,0:25:49.20,0:25:50.85,Lyrics,,0,0,0,,♪ Toprak! ♪
Dialogue: 0,0:25:50.85,0:25:53.77,Lyrics,,0,0,0,,♪ Toprak! ♪\N♪ Çiçek, çiçek! ♪
Dialogue: 0,0:25:56.94,0:26:01.44,Main,,0,0,0,,Ne?\NŞeytan Meyvesi gücü mü?
Dialogue: 0,0:26:01.44,0:26:05.82,Lyrics,,0,0,0,,♪ Çiçek, çiçek! Çiçek, çiçek! ♪\N♪ Ağaç! Ağaç! ♪
Dialogue: 0,0:26:14.96,0:26:18.92,Main,,0,0,0,,Vay canına!\NBen de yapabiliyorum Anne!
Dialogue: 0,0:26:18.92,0:26:23.10,Main,,0,0,0,,{\i1}Teşekkürler Linlin!\NHaydi birlikte şarkı söyleyelim!
Dialogue: 0,0:26:23.10,0:26:26.40,Main,,0,0,0,,{\i1}Enteresan! Pekâlâ, kararımı verdim!
Dialogue: 0,0:26:26.40,0:26:27.81,Main,,0,0,0,,{\i1}Onunla denize açılacağım!
Dialogue: 0,0:26:28.30,0:26:31.94,Main,,0,0,0,,- Güzel! Güzel!\N- Herkesin büyüyüp...
Dialogue: 0,0:26:31.94,0:26:36.44,Main,,0,0,0,,...aynı şekilde yaşadığı ve eşit olduğu bir ülke.
Dialogue: 0,0:26:38.16,0:26:42.99,Main,,0,0,0,,Pekâlâ Linlin.\NHayaller ülkesini kuralım haydi!
Dialogue: 0,0:26:43.48,0:26:45.91,Main,,0,0,0,,Ben de yanındayım!
Dialogue: 0,0:26:45.91,0:26:47.16,Main,,0,0,0,,Peki!
Dialogue: 0,0:26:51.27,0:26:54.28,Main,,0,0,0,,Şu aranan afişine baksanıza!
Dialogue: 0,0:26:54.28,0:26:57.74,Main,,0,0,0,,Bir çocuğa 50 milyon beli ödül mü?
Dialogue: 0,0:26:57.74,0:27:00.54,Main,,0,0,0,,Bu nasıl olur?
Dialogue: 0,0:27:02.86,0:27:07.20,Main,,0,0,0,,Kale tek bir kızın eline mi düşmüş?
Dialogue: 0,0:27:07.20,0:27:09.50,Main,,0,0,0,,Ele başları Charlotte Linlin!
Dialogue: 0,0:27:09.50,0:27:12.87,Main,,0,0,0,,Cipher Pol bu kızın çok büyük bir tehlike\Narz ettiğini bildirdi!
Dialogue: 0,0:27:12.89,0:27:15.24,Main,,0,0,0,,Günün birinde çok\Ngüçlü bir düşman olacak!
Dialogue: 0,0:27:15.24,0:27:16.98,Main,,0,0,0,,Ne pahasına olursa olsun\Nkızı yakalayın!
Dialogue: 0,0:27:16.98,0:27:18.55,Main,,0,0,0,,Tamam!
Dialogue: 0,0:27:22.93,0:27:24.31,Main,,0,0,0,,İşte orada!
Dialogue: 0,0:27:25.44,0:27:28.02,Main,,0,0,0,,Dikkat et Linlin.
Dialogue: 0,0:27:29.90,0:27:32.03,Main,,0,0,0,,Şurada tatlı yiyorum!
Dialogue: 0,0:27:33.69,0:27:35.66,Main,,0,0,0,,Rahatsız etmeyin!
Dialogue: 0,0:27:45.60,0:27:49.24,Narrator,,0,0,0,,{\i1}Charlotte Linlin şehirleri\Nyerle bir etmeyi sürdürerek...
Dialogue: 0,0:27:49.24,0:27:55.45,Narrator,,0,0,0,,{\i1}...bir gecede dünyaya\Ntehdit oluşturmayı başarmıştı.
Dialogue: 0,0:27:55.45,0:27:57.12,Main,,0,0,0,,Bu kız bir korsan!
Dialogue: 0,0:27:58.24,0:28:00.16,Main,,0,0,0,,Kaçın!
Dialogue: 0,0:28:05.38,0:28:08.70,Main,,0,0,0,,Tatlı getirin bana!
Dialogue: 0,0:28:08.70,0:28:10.20,Main,,0,0,0,,Majesteleri!
Dialogue: 0,0:28:10.20,0:28:11.49,Main,,0,0,0,,Olamaz!
Dialogue: 0,0:28:11.49,0:28:17.38,Main,,0,0,0,,O zaman sizlere huzurlu bir\Nhayal ülkesi sözü veririm!
Dialogue: 0,0:28:17.38,0:28:22.74,Main,,0,0,0,,Dediklerime kulak verirseniz\Nmusmutlu olacağınıza eminim!
Dialogue: 0,0:28:22.74,0:28:28.21,Flashbacks,,0,0,0,,{\i1}Kulak asmayanlar ise bencil olduğundan\Nonları öldürmem gerekir!
Dialogue: 0,0:28:29.34,0:28:32.47,Thoughts,,0,0,0,,{\i1}Anne, özlüyorum...
Dialogue: 0,0:28:32.47,0:28:35.18,Thoughts,,0,0,0,,{\i1}Seni özlüyorum!
Dialogue: 0,0:28:39.44,0:28:41.23,Thoughts,,0,0,0,,{\i1}Anne!{\i}
Dialogue: 0,0:28:41.84,0:28:44.77,Thoughts,,0,0,0,,{\i1}Günün birinde herkesi büyüteceğim!
Dialogue: 0,0:28:44.77,0:28:48.36,Thoughts,,0,0,0,,{\i1}O zaman tekrardan\Nbir masanın etrafında oturalım!
Dialogue: 0,0:28:48.98,0:28:54.62,Thoughts,,0,0,0,,{\i1}Fakat hâlâ dediklerime\Nkulak asmayanlar var!
Dialogue: 0,0:28:57.99,0:29:01.93,Thoughts,,0,0,0,,{\i1}Hüznümden gözyaşlarım durmak bilmiyor!
Dialogue: 0,0:29:02.52,0:29:07.50,Thoughts,,0,0,0,,{\i1}Ne de olsa senin bir tanecik fotoğrafın...
Dialogue: 0,0:29:07.50,0:29:09.90,Flashbacks,,0,0,0,,{\i1}Çok temiz kalplisin.{\i}
Dialogue: 0,0:29:13.59,0:29:18.18,Thoughts,,0,0,0,,{\i1}Benim için paha biçilmez olan\Nbir tanecik fotoğrafını...
Dialogue: 0,0:29:18.18,0:29:21.68,Thoughts,,0,0,0,,{\i1}...parçaladılar!
Dialogue: 0,0:29:25.96,0:29:29.73,Thoughts,,0,0,0,,{\i1}Bağışlanamaz...{\i}
Dialogue: 0,0:29:31.11,0:29:34.03,Thoughts,,0,0,0,,{\i1}Hasır Şapkalar!{\i}
Dialogue: 0,0:29:42.91,0:29:50.10,Main,,0,0,0,,{\i1}Onları affetmeyeceğim!
Dialogue: 0,0:30:17.98,0:30:20.62,Main,,0,0,0,,Görev başarısız oldu!
Dialogue: 0,0:30:25.21,0:30:28.38,Main,,0,0,0,,Ne?
Dialogue: 0,0:30:30.20,0:30:31.63,Main,,0,0,0,,Başarısız oldular!
Dialogue: 0,0:30:32.76,0:30:39.43,Main,,0,0,0,,Dinleyin, muhteşem şahsım uçabildiğinden\Nkaçacağımız aynayla mekâna dalacağım!
Dialogue: 0,0:30:40.43,0:30:45.06,Flashbacks,,0,0,0,,{\i1}İşiniz biter bitmez\NCaesar'ın aynasına girin hemen!
Dialogue: 0,0:30:45.46,0:30:48.10,Thoughts,,0,0,0,,{\i1}Ne yazık ki benim sıram geldi çattı!
Dialogue: 0,0:30:48.10,0:30:49.70,Thoughts,,0,0,0,,{\i1}Sıçayım ya!
Dialogue: 0,0:30:49.70,0:30:51.80,Thoughts,,0,0,0,,{\i1}Fırlatıcılarımı yok etti!
Dialogue: 0,0:30:51.80,0:30:56.15,Thoughts,,0,0,0,,{\i1}Canavar cadı! \NNe de olsa kadın Yonkou!
Dialogue: 0,0:31:07.71,0:31:11.88,Thoughts,,0,0,0,,{\i1}Herkes geri çekilsin!\NAynanın içine!
Dialogue: 0,0:31:32.24,0:31:34.15,Thoughts,,0,0,0,,{\i1}Ne akıl almaz bir rüzgâr!
Dialogue: 0,0:32:18.19,0:32:22.54,Thoughts,,0,0,0,,{\i1}Olamaz! Şatonun tepesindeyiz!\NKaçacak yerimiz de yok!
Dialogue: 0,0:32:25.05,0:32:27.87,Thoughts,,0,0,0,,{\i1}Kazanma şansımız hiç yok!
Dialogue: 0,0:32:39.80,0:32:42.75,Main,,0,0,0,,Rook: In Voller Größe!{\fad(150,150)}
Dialogue: 0,0:32:39.80,0:32:42.75,Attack,,0,0,0,,Tam Vücut Kale
Dialogue: 0,0:33:07.09,0:33:08.39,Main,,0,0,0,,Ne?
Dialogue: 0,0:33:48.86,0:33:51.20,Main,,0,0,0,,{\fad(150,150)}Big Father!
Dialogue: 0,0:33:48.86,0:33:51.20,Note,,0,0,0,,{\fad(150,150)}Büyük Baba!
Dialogue: 0,0:33:54.67,0:33:58.86,Main,,0,0,0,,Süper ya!
