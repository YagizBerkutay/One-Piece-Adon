Dialogue: 0,0:01:38.21,0:01:42.85,Title,,0,0,150,,{\fad(500,0)}Luffy, Katakuri'ye Karşı
Dialogue: 0,0:01:45.21,0:01:47.77,Main,,0,0,0,,Pastayı verin!
Dialogue: 0,0:01:50.09,0:01:52.45,Main,,0,0,0,,Şimdi istediğin oldu mu Chiffon?
Dialogue: 0,0:01:52.45,0:01:55.71,Main,,0,0,0,,Evet! Teşekkürler Bege!
Dialogue: 0,0:01:56.32,0:01:59.48,Main,,0,0,0,,O değil de başımıza belayı sardık.
Dialogue: 0,0:01:59.48,0:02:03.85,Main,,0,0,0,,İşin aslı, şu an götümüzü kurtarmak\Nsuikasttan daha önemli!
Dialogue: 0,0:02:03.85,0:02:05.93,Main,,0,0,0,,Ne zırvalıyorsun Bege?
Dialogue: 0,0:02:07.06,0:02:10.42,Main,,0,0,0,,Namiler'in sağ salim kaçmasını\Nsağlamakta karar kırmıştık!
Dialogue: 0,0:02:10.42,0:02:14.73,Main,,0,0,0,,Kendi canımızın derdine düşeceğiz diye\Nsözümüzden dönemeyiz!
Dialogue: 0,0:02:15.82,0:02:18.36,Main,,0,0,0,,Minnet borcunu böyle edersin!
Dialogue: 0,0:02:19.87,0:02:21.41,Main,,0,0,0,,Evet!
Dialogue: 0,0:02:21.41,0:02:22.44,Main,,0,0,0,,{\i1}Rero{\i1}!{\i0}
Dialogue: 0,0:02:23.24,0:02:26.64,Main,,0,0,0,,Tasalanma! Pastanın tadına güven!
Dialogue: 0,0:02:26.64,0:02:29.54,Main,,0,0,0,,Kara Bacak gerçekten de harika bir aşçı!
Dialogue: 0,0:02:31.21,0:02:35.00,Main,,0,0,0,,Ne diyebilirim ki!\NBu yönüne bitiyorum Chiffon!
Dialogue: 0,0:02:35.00,0:02:38.01,Main,,0,0,0,,Hanımım!
Dialogue: 0,0:02:38.01,0:02:42.89,Main,,0,0,0,,Düğün pastası!
Dialogue: 0,0:02:43.93,0:02:46.02,Main,,0,0,0,,Şu filodan kurtulalım millet!
Dialogue: 0,0:02:46.02,0:02:48.64,Main,,0,0,0,,Tamamdır!
Dialogue: 0,0:03:01.50,0:03:03.75,Main,,0,0,0,,Smoothie-{\i1}sama{\i0}'nın gemisi!
Dialogue: 0,0:03:03.75,0:03:05.71,Main,,0,0,0,,Smoothie-{\i1}sama{\i1}!{\i0}
Dialogue: 0,0:03:05.71,0:03:10.04,Main,,0,0,0,,Citron-{\i1}sama{\i1}! {\i0}Cinnamon-{\i1}sama{\i1}!{\i0}
Dialogue: 0,0:03:16.92,0:03:20.97,Main,,0,0,0,,Hasır Şapkalar, hazır mısınız?
Dialogue: 0,0:03:20.97,0:03:23.27,Main,,0,0,0,,Kuyruğumuzda başka bir filo var!
Dialogue: 0,0:03:23.27,0:03:25.85,Main,,0,0,0,,Şekerleme Generali Smoothie'nin gemisi!
Dialogue: 0,0:03:27.14,0:03:30.33,Main,,0,0,0,,Big Mom'dan kurtulduk\Nbu sefer de Şekerleme Generali çıktı!
Dialogue: 0,0:03:30.33,0:03:33.31,Main,,0,0,0,,Her varlığı sıkıp suyunu çıkarabilen kadın.
Dialogue: 0,0:03:34.07,0:03:35.94,Main,,0,0,0,,Smoothie abla!
Dialogue: 0,0:03:37.93,0:03:40.57,Main,,0,0,0,,Kakao Adası'na ne kadar kaldı?
Dialogue: 0,0:03:40.58,0:03:43.03,Main,,0,0,0,,3 saatten biraz fazla!
Dialogue: 0,0:03:43.03,0:03:46.65,Main,,0,0,0,,Sözleştiğimiz gibi tam gece 1'de varacağız!
Dialogue: 0,0:03:46.65,0:03:52.79,Main,,0,0,0,,Fakat Luffy'nin Kakao Adası'nda saat kaçta ve \Ntam olarak nerede ortaya çıkacağını bilmiyoruz.
Dialogue: 0,0:03:52.79,0:03:55.50,Main,,0,0,0,,Kendisini de uyaramıyoruz!
Dialogue: 0,0:03:59.59,0:04:04.18,Main,,0,0,0,,Kakao Adası'ndan çıkmamız için\Naklıma tek bir fikir geldi.
Dialogue: 0,0:04:12.35,0:04:19.59,Captions,,970,0,320,,{\fad(500,0)}Kakao Adası
Dialogue: 0,0:04:14.98,0:04:19.49,Main,,0,0,0,,Oven-{\i1}sama{\i0}! Adayı kuşatacak filolar\Npeşi sıra adaya geliyor!
Dialogue: 0,0:04:19.49,0:04:22.24,Main,,0,0,0,,Ama bu kadar filoya lüzum var mıydı ki?
Dialogue: 0,0:04:22.24,0:04:26.14,Main,,0,0,0,,Katakuri-sama'nın Hasır Şapka'yı\Nelinden kaçıracağını sanmıyorum zaten.
Dialogue: 0,0:04:26.14,0:04:29.08,Main,,0,0,0,,Ben bilmem!\NTamago ile Mont d'Or'a söyleyin!
Dialogue: 0,0:04:29.08,0:04:31.95,Main,,0,0,0,,{\i1}Her filoya ihtiyacımız var Oven abi!
Dialogue: 0,0:04:31.95,0:04:33.73,Main,,0,0,0,,İnanabiliyor musun?
Dialogue: 0,0:04:33.73,0:04:37.67,Main,,0,0,0,,Şatodaki patlama da planlıymış!
Dialogue: 0,0:04:37.67,0:04:39.00,Main,,0,0,0,,Ne?
Dialogue: 0,0:04:39.00,0:04:43.86,Main,,0,0,0,,Çaylağın teki de olsa bir avuç mürettebattan da \Noluşsalar şerefsizleri küçümsemeyin!
Dialogue: 0,0:04:43.86,0:04:46.80,Main,,0,0,0,,Elimizden kaçırırsak rezil oluruz!
Dialogue: 0,0:04:46.80,0:04:50.78,Main,,0,0,0,,Rahat ol. \NBurada mutlaka defterlerini düreceğiz!
Dialogue: 0,0:04:51.73,0:04:55.97,Main,,0,0,0,,Kulak verin! \N3 saat sonra, yani gece 1'de...
Dialogue: 0,0:04:55.97,0:05:00.94,Main,,0,0,0,,...birbirinden ayrılmış Hasır Şapka mürettebatı\NKakao Adası'nda bir araya gelecek.
Dialogue: 0,0:05:01.78,0:05:06.00,Main,,0,0,0,,Hepsinin kökünü kazımak için\Nson fırsatınız olarak bakın!
Dialogue: 0,0:05:06.00,0:05:07.20,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:05:07.80,0:05:14.44,Main,,0,0,0,,Olur da Hasır Şapka gelirse\Nadadaki bir aynadan çıkacak!
Dialogue: 0,0:05:14.44,0:05:18.06,Main,,0,0,0,,Evlere girip\Nşehirdeki tüm aynaları kırın!
Dialogue: 0,0:05:20.67,0:05:23.55,Main,,0,0,0,,Sağır mısınız lan! Dediğimi yapın!
Dialogue: 0,0:05:23.55,0:05:26.01,Main,,0,0,0,,Ama efendim! \NKıymetli eserlerden sayılanları da mı kıralım?
Dialogue: 0,0:05:26.01,0:05:31.26,Main,,0,0,0,,Eleman bir yetenek kullanıcısı. \NKırmak istemediğiniz ayna varsa denize atın.
Dialogue: 0,0:05:31.26,0:05:34.48,Main,,0,0,0,,Akabinde çıkarırsınız! Her hâlükârda...
Dialogue: 0,0:05:35.88,0:05:40.44,Main,,0,0,0,,Adadaki sağlam tek ayna bu kalacak!
Dialogue: 0,0:05:44.90,0:05:48.86,Main,,0,0,0,,Bundan başka ayna kalmayacak!
Dialogue: 0,0:05:48.86,0:05:53.80,Main,,0,0,0,,Hasır Şapka içinizden birinin\Naynasından çıkarsa...
Dialogue: 0,0:05:53.80,0:05:57.00,Main,,0,0,0,,...tüm sülalenizi infaz ederim!
Dialogue: 0,0:05:57.00,0:05:58.07,Main,,0,0,0,,İşe koyulun!
Dialogue: 0,0:05:58.83,0:06:00.27,Main,,0,0,0,,A- Anlaşıldı efendim!
Dialogue: 0,0:06:03.96,0:06:07.93,Main,,0,0,0,,Paçayı kurtarabileceğini sanma Hasır Şapka!
Dialogue: 0,0:06:07.93,0:06:11.68,Main,,0,0,0,,Senin için burası\Nbir çıkış kapısı olmayacak.
Dialogue: 0,0:06:12.23,0:06:14.57,Main,,0,0,0,,Cehennemin eşiği olacak!
Dialogue: 0,0:06:26.09,0:06:28.37,Main,,0,0,0,,Kusura bakma.
Dialogue: 0,0:06:28.37,0:06:32.43,Main,,0,0,0,,İğnelerinden birini bile fark etmedim.\NBen de ahmaklık ettim.
Dialogue: 0,0:06:32.43,0:06:37.59,Main,,0,0,0,,Korsanların savaşında\Nadil olma diye bir şey yoktur!
Dialogue: 0,0:06:39.71,0:06:42.63,Main,,0,0,0,,Savuşturamamak kendi kabahatimdir!
Dialogue: 0,0:07:08.67,0:07:10.82,Main,,0,0,0,,Artık seni...
Dialogue: 0,0:07:10.82,0:07:14.63,Main,,0,0,0,,...kendimden çok daha güçsüz\Nbiri olarak görmüyorum!
Dialogue: 0,0:07:14.63,0:07:17.28,Main,,0,0,0,,Hadi ya? Sevindim!
Dialogue: 0,0:07:17.28,0:07:18.98,Main,,0,0,0,,Sağ ol!
Dialogue: 0,0:07:21.52,0:07:22.55,Main,,0,0,0,,Yine de...
Dialogue: 0,0:07:25.73,0:07:27.45,Main,,0,0,0,,{\fad(0,500)}...kazanacağım!
Dialogue: 0,0:07:29.26,0:07:31.04,Main,,0,0,0,,Anam!
Dialogue: 0,0:07:31.06,0:07:33.55,Main,,0,0,0,,Dinlenmeye vaktin yok!
Dialogue: 0,0:07:33.55,0:07:36.10,Main,,0,0,0,,100 saldırıdan\Nkaçınamazsan yemek de yok!
Dialogue: 0,0:07:36.10,0:07:36.92,Main,,0,0,0,,Ne?
Dialogue: 0,0:07:36.94,0:07:39.44,Main,,0,0,0,,O kadar ağır geldiyse odaklan!
Dialogue: 0,0:07:46.11,0:07:47.93,Main,,0,0,0,,Oradasın!
Dialogue: 0,0:07:47.93,0:07:50.05,Main,,0,0,0,,Anam!
Dialogue: 0,0:07:50.05,0:07:54.28,Main,,0,0,0,,Rakibin hep karşından saldırmaz ki.
Dialogue: 0,0:07:54.28,0:07:59.38,Main,,0,0,0,,Hayvanlar duygularını dizginleyemediğinden\Nakıllarını okumak kolay iştir.
Dialogue: 0,0:07:59.38,0:08:06.29,Main,,0,0,0,,Lakin insanlarda durum değişiyor.\NBeklentilere karşı gelip tongaya düşürebiliriz.
Dialogue: 0,0:08:07.29,0:08:09.09,Note,,0,0,0,,- Gurultu -
Dialogue: 0,0:08:09.10,0:08:10.96,Main,,0,0,0,,Anam!
Dialogue: 0,0:08:21.91,0:08:24.98,Main,,0,0,0,,Midem sırtıma yapıştı ya Rayleigh!
Dialogue: 0,0:08:24.98,0:08:29.32,Main,,0,0,0,,Acıktın diye hasmın\Nsaldırılarına ara verecek mi?
Dialogue: 0,0:08:31.36,0:08:33.36,Main,,0,0,0,,Her saldırının bir iradesi vardır.
Dialogue: 0,0:08:33.36,0:08:34.27,Main,,0,0,0,,Ah!
Dialogue: 0,0:08:34.27,0:08:36.16,Main,,0,0,0,,Keza bir varlığı.
Dialogue: 0,0:08:40.88,0:08:42.70,Main,,0,0,0,,Enfes bir koku alıyorum.
Dialogue: 0,0:08:43.30,0:08:46.46,Main,,0,0,0,,Akşam yemeğim. Kokusuna aldırış etme.
Dialogue: 0,0:08:51.94,0:08:53.36,Main,,0,0,0,,Oradasın!
Dialogue: 0,0:08:58.87,0:08:59.76,Main,,0,0,0,,Oradasın!
Dialogue: 0,0:09:07.12,0:09:11.70,Main,,0,0,0,,Bodoslama saldırma Luffy!
Dialogue: 0,0:09:13.00,0:09:17.11,Main,,0,0,0,,Rayleigh, acıdı ama ya!\NÖfkeni seziyorum bak!
Dialogue: 0,0:09:17.11,0:09:18.76,Main,,0,0,0,,O da Haki işte!
Dialogue: 0,0:09:18.76,0:09:20.90,Main,,0,0,0,,Duyularını keskinleştir!
Dialogue: 0,0:09:20.90,0:09:22.40,Main,,0,0,0,,Acıdı!
Dialogue: 0,0:09:22.40,0:09:24.99,Main,,0,0,0,,Hasmının varlığını hisset!
Dialogue: 0,0:09:24.99,0:09:27.21,Main,,0,0,0,,Öfkeni hissediyorum!
Dialogue: 0,0:09:33.96,0:09:35.80,Main,,0,0,0,,Hay içine!
Dialogue: 0,0:09:38.46,0:09:39.50,Main,,0,0,0,,Kim var orada?
Dialogue: 0,0:09:44.72,0:09:46.26,Main,,0,0,0,,Dağılın millet.
Dialogue: 0,0:09:49.52,0:09:51.52,Main,,0,0,0,,Yemek istemiyorum.
Dialogue: 0,0:09:51.54,0:09:54.94,Main,,0,0,0,,Rayleigh öyle uygun gördüyse\Nyememem lazım!
Dialogue: 0,0:09:58.51,0:10:00.62,Main,,0,0,0,,Odaklan Luffy.
Dialogue: 0,0:10:11.57,0:10:13.06,Main,,0,0,0,,Luffy...
Dialogue: 0,0:10:13.06,0:10:19.61,Main,,0,0,0,,Gözlem Hakisi'nin bir parçası olmasına karşın canlıların duygularını sezmekte oldukça ehilsin gibi duruyor.
Dialogue: 0,0:10:19.61,0:10:22.13,Main,,0,0,0,,Farkında bile değilsindir gerçi.
Dialogue: 0,0:10:22.13,0:10:24.28,Main,,0,0,0,,Ha? Öyle miyim?
Dialogue: 0,0:10:24.28,0:10:27.03,Main,,0,0,0,,Fakat bunu yapabiliyorsan...
Dialogue: 0,0:10:27.03,0:10:31.30,Main,,0,0,0,,...rakibinin hareketlerini de\Nsezebileceğinden zerre şüphem yok.
Dialogue: 0,0:10:33.72,0:10:34.93,Main,,0,0,0,,Peki.
Dialogue: 0,0:10:34.93,0:10:40.57,Main,,0,0,0,,Dünyanın zirvesinde duranların içinde bir nebze geleceği görebilenlerin olduğu rivayet edilir.
Dialogue: 0,0:10:40.57,0:10:41.82,Main,,0,0,0,,Geleceği mi görüyorlar?
Dialogue: 0,0:10:42.44,0:10:45.63,Main,,0,0,0,,Öyle biriyle karşılaşırsan n'apacaksın?
Dialogue: 0,0:10:45.63,0:10:49.78,Main,,0,0,0,,İki yıllık bir eğitimle\Nonların seviyesine varamazsın.
Dialogue: 0,0:10:50.36,0:10:51.54,Main,,0,0,0,,Çetin ceviz olacaklar.
Dialogue: 0,0:10:53.45,0:10:55.91,Main,,0,0,0,,Nasıl bir kişilikte olduğuna bağlı.
Dialogue: 0,0:10:55.91,0:11:00.64,Main,,0,0,0,,Ne? Rakibinin kişiliği mi?\NBunu mu merak ediyorsun?
Dialogue: 0,0:11:00.64,0:11:02.88,Main,,0,0,0,,Aklımın ucundan bile geçmemişti.
Dialogue: 0,0:11:04.25,0:11:05.13,Main,,0,0,0,,Herhâlde merak ediyorum!
Dialogue: 0,0:11:07.17,0:11:09.05,Main,,0,0,0,,Nevi şahsına münhasır birisin ha!
Dialogue: 0,0:11:09.05,0:11:11.76,Main,,0,0,0,,Kaçma lüksünün olmayacağı anlar olacak!
Dialogue: 0,0:11:14.47,0:11:17.89,Main,,0,0,0,,Önünde amansız savaşlar yatıyor gibi.
Dialogue: 0,0:11:23.02,0:11:25.61,Main,,0,0,0,,Pinekleyecek vaktin yok.
Dialogue: 0,0:11:25.61,0:11:26.83,Main,,0,0,0,,Ne?
Dialogue: 0,0:11:26.83,0:11:30.20,Main,,0,0,0,,Bir sonraki eğitime geçiyoruz!\NGel haydi!
Dialogue: 0,0:11:30.20,0:11:31.11,Main,,0,0,0,,Tamamdır!
Dialogue: 0,0:11:35.99,0:11:39.66,Flashbacks,,0,0,0,,Ne biliyorsam öğreteceğim sana!
Dialogue: 0,0:12:15.53,0:12:17.95,Main,,0,0,0,,{\fad(150,150)}Yaki Mochi!
Dialogue: 0,0:12:15.53,0:12:17.95,Attack,,0,0,0,,{\fad(150,150)}Izgara Mochi
Dialogue: 0,0:13:59.87,0:14:03.22,Main,,0,0,0,,{\an8\i0}Bize yetişti mi nalları dikeriz-{\i1}rero{\i0}!
Dialogue: 0,0:13:59.97,0:14:06.05,Captions,,0,0,20,,{\fad(1000,1000)}22:10
Dialogue: 0,0:14:04.01,0:14:06.36,Main,,0,0,0,,{\an8}Elimizde pasta var.
Dialogue: 0,0:14:06.36,0:14:09.33,Main,,0,0,0,,{\an8}Öylece saldıramazlar!
Dialogue: 0,0:14:09.03,0:14:14.00,Captions,,0,0,0,,{\fad(500,0)}Denizde bir yerde - Bege'nin Grubu
Dialogue: 0,0:14:09.33,0:14:14.00,Main,,0,0,0,,{\an8}Prometheus götünü o kadar\Nbüyüttüğünde çevikliğinden olur.
Dialogue: 0,0:14:14.00,0:14:17.55,Main,,0,0,0,,Yakında Likör Adası'na varacağız!
Dialogue: 0,0:14:19.90,0:14:25.01,Main,,0,0,0,,Zorlanmadık ha! \NPaletleri zamanında onarmamıza borçluyuz!
Dialogue: 0,0:14:25.01,0:14:26.95,Main,,0,0,0,,Elinize sağlık çocuklar!
Dialogue: 0,0:14:26.95,0:14:29.35,Main,,0,0,0,,Sağ olun! Teveccühünüz!
Dialogue: 0,0:14:29.35,0:14:33.46,Main,,0,0,0,,Pastayı Likör Adası'na sallayıp\Ntabanları yağlayacağız, değil mi-{\i1}rero{\i0}?
Dialogue: 0,0:14:33.46,0:14:36.09,Main,,0,0,0,,Evet, kafama yattı.
Dialogue: 0,0:14:36.09,0:14:38.01,Main,,0,0,0,,Henüz olmaz.
Dialogue: 0,0:14:38.01,0:14:39.24,Main,,0,0,0,,Sıkıntı nedir Chiffon?
Dialogue: 0,0:14:39.51,0:14:46.74,Captions,,380,0,432,,{\fs28\b1}Likör Adası
Dialogue: 0,0:14:39.51,0:14:46.74,Captions,,0,600,370,,{\fs28\b1}Fındık Adası
Dialogue: 0,0:14:39.51,0:14:46.74,Captions,,700,0,325,,{\fs28\b1}Kabartma Adası
Dialogue: 0,0:14:39.51,0:14:46.74,Captions,,435,0,174,,{\fs28\b1}Kakao Adası
Dialogue: 0,0:14:39.92,0:14:44.40,Main,,0,0,1,,Likör Adası çok yakın olur!\NKabartma Adası'na çekelim onları!
Dialogue: 0,0:14:44.40,0:14:46.74,Main,,0,0,0,,Bana bak! Aklını mı kaçırdın?
Dialogue: 0,0:14:46.74,0:14:52.12,Main,,0,0,0,,Açlık Krizi çeken Mama, Likör Adası'nda\Npastayı yiyip kendine gelirse...
Dialogue: 0,0:14:52.14,0:14:57.84,Main,,0,0,0,,...hâlâ Namiler'in gemisini\Nyakalama fırsatı olur!
Dialogue: 0,0:14:57.84,0:15:00.96,Main,,0,0,0,,N'olmuş yani?\NYeterince yardım ettik zaten!
Dialogue: 0,0:15:00.96,0:15:04.18,Main,,0,0,0,,Hayatımızdan olacağız! Baksana!
Dialogue: 0,0:15:04.18,0:15:07.45,Main,,0,0,0,,Mama'nın karnı iyice kazınmış görünüyor!
Dialogue: 0,0:15:21.75,0:15:24.24,Main,,0,0,0,,Yemek istiyorum!
Dialogue: 0,0:15:30.84,0:15:34.79,Main,,0,0,0,,Hemen yemek istiyorum!
Dialogue: 0,0:15:37.31,0:15:40.46,Main,,0,0,0,,Düğün pastası!
Dialogue: 0,0:15:40.46,0:15:45.39,Main,,0,0,0,,Yemek istiyorum ya! İstiyorum işte ya!
Dialogue: 0,0:15:46.48,0:15:48.49,Main,,0,0,0,,Anladın mı şimdi, Chiffon?
Dialogue: 0,0:15:48.49,0:15:49.40,Main,,0,0,0,,Evet.
Dialogue: 0,0:15:49.40,0:15:51.29,Main,,0,0,0,,Kabartma Adası'na gidelim.
Dialogue: 0,0:15:51.29,0:15:53.14,Main,,0,0,0,,Kime diyorum ki!
Dialogue: 0,0:15:53.14,0:15:58.40,Main,,0,0,0,,Hasır Şapkalara olan minnet borcumu\Ncanıma da mal olsa ödeyeceğim!
Dialogue: 0,0:15:59.16,0:16:01.61,Main,,0,0,0,,Kararımı verdim bir kere!
Dialogue: 0,0:16:01.61,0:16:04.30,Main,,0,0,0,,Gerekirse yalnız giderim!
Dialogue: 0,0:16:06.95,0:16:11.14,Main,,0,0,0,,Rotayı değiştirin!\NKabartma Adası'na yelken alıyoruz!
Dialogue: 0,0:16:11.14,0:16:12.79,Main,,0,0,0,,Ne?
Dialogue: 0,0:16:13.51,0:16:15.83,Main,,0,0,0,,Karıma da bu yakışırdı!
Dialogue: 0,0:16:15.83,0:16:18.63,Main,,0,0,0,,Sana her geçen gün\Ndaha da vuruluyorum Chiffon!
Dialogue: 0,0:16:20.46,0:16:22.57,Main,,0,0,0,,Gidelim çocuklar!
Dialogue: 0,0:16:22.57,0:16:26.47,Main,,0,0,0,,Tamam Baba!
Dialogue: 0,0:16:26.48,0:16:27.97,Main,,0,0,0,,Görüşürüz öyleyse.
Dialogue: 0,0:16:27.97,0:16:30.03,Main,,0,0,0,,Dikkatli ol Sanji.{\an8}
Dialogue: 0,0:16:29.49,0:16:33.98,Captions,,0,0,0,,{\fad(500,0)}Sunny
Dialogue: 0,0:16:30.03,0:16:30.87,Main,,0,0,0,,{\an8}Olurum.
Dialogue: 0,0:16:30.87,0:16:33.98,Main,,0,0,0,,{\an8}Y- Yaklaşma! Öte dur! Sanji...
Dialogue: 0,0:16:33.98,0:16:35.44,Main,,0,0,0,,...{\i1}san{\i}!
Dialogue: 0,0:16:35.44,0:16:39.79,Main,,0,0,0,,Sunny-go size emanet!\NHata lüksümüz yok artık!
Dialogue: 0,0:16:39.79,0:16:40.82,Main,,0,0,0,,Evet!
Dialogue: 0,0:16:40.82,0:16:43.58,Main,,0,0,0,,Pudding-{\i1}chan{\i0}, Kakao Adası'na götür beni.
Dialogue: 0,0:16:43.58,0:16:48.66,Main,,0,0,0,,Bana emir verme!\NOtoriter bir koca ayağı yapamazsın!
Dialogue: 0,0:16:48.66,0:16:49.93,Main,,0,0,0,,Sanji...
Dialogue: 0,0:16:50.51,0:16:52.13,Main,,0,0,0,,...{\i1}san{\i1}!{\i0}
Dialogue: 0,0:16:52.13,0:16:54.33,Main,,0,0,0,,O ses neydi?
Dialogue: 0,0:16:54.33,0:16:55.40,Main,,0,0,0,,Carrot!
Dialogue: 0,0:16:55.40,0:16:57.51,Main,,0,0,0,,Daha iyi hissediyor musun şimdi?
Dialogue: 0,0:16:57.51,0:17:01.36,Main,,0,0,0,,Kusura bakmayın çocuklar, uyuyakalmışım.
Dialogue: 0,0:17:01.36,0:17:05.24,Main,,0,0,0,,Ne kusuru yahu!\NHarikaydın kardeşim benim!
Dialogue: 0,0:17:06.90,0:17:12.19,Main,,0,0,0,,Dolunaya baktıklarında Nekomamushi'yle\NInuarashi de dönüşüm geçiyor mu kardeşim?
Dialogue: 0,0:17:12.19,0:17:13.68,Main,,0,0,0,,Evet!
Dialogue: 0,0:17:13.68,0:17:19.42,Main,,0,0,0,,Üstat Nekomamushi ile Dük Inuarashi\Nbenden katbekat güçlü olurlar hem de!
Dialogue: 0,0:17:19.42,0:17:20.97,Main,,0,0,0,,Hadi ya?
Dialogue: 0,0:17:32.83,0:17:36.31,Main,,0,0,0,,Hangi yönden saldırdıklarını bakıp söyleyin!
Dialogue: 0,0:17:36.31,0:17:37.37,Main,,0,0,0,,Tamamdır!
Dialogue: 0,0:17:37.37,0:17:39.82,Main,,0,0,0,,Yapmayın!
Dialogue: 0,0:17:53.60,0:17:56.17,Main,,0,0,0,,Bu kadar sıvı işimi görmez.
Dialogue: 0,0:17:57.74,0:18:01.46,Main,,0,0,0,,Kendi adamlarını öldürmekle\Nçizgiyi aşıyorsun!
Dialogue: 0,0:18:02.44,0:18:05.48,Main,,0,0,0,,Hasır Şapkalar elimden kaçamayacak!
Dialogue: 0,0:18:05.48,0:18:06.80,Main,,0,0,0,,O da ne öyle?
Dialogue: 0,0:18:06.80,0:18:09.70,Main,,0,0,0,,Dev Irkı'ndan mı ki?
Dialogue: 0,0:18:09.70,0:18:12.25,Main,,0,0,0,,Acaba külodunuzu görebilir--
Dialogue: 0,0:18:12.25,0:18:14.33,Main,,0,0,0,,Kes sesini! Abaza iskelet!
Dialogue: 0,0:18:16.99,0:18:17.99,Main,,0,0,0,,Yine saldırıyor!
Dialogue: 0,0:18:17.99,0:18:19.21,Main,,0,0,0,,Sancağa kır!
Dialogue: 0,0:18:24.49,0:18:26.84,Main,,0,0,0,,Yine sancağa!
Dialogue: 0,0:18:31.62,0:18:33.39,Main,,0,0,0,,Jinbe, iskeleye kır!
Dialogue: 0,0:18:36.80,0:18:38.39,Main,,0,0,0,,Yere batasıca Jinbe!
Dialogue: 0,0:18:46.19,0:18:50.53,Main,,0,0,0,,Gözünüzü dört açın!\NMalumatlarınıza güveniyorum!
Dialogue: 0,0:18:51.46,0:18:52.84,Main,,0,0,0,,O iş bizde!
Dialogue: 0,0:18:52.84,0:18:55.68,Main,,0,0,0,,Merak etme! Sorumluluk bende!
Dialogue: 0,0:18:55.68,0:18:59.23,Main,,0,0,0,,Amanın, daha da büyüyüverdi!
Dialogue: 0,0:19:04.92,0:19:08.09,Main,,0,0,0,,Smoothie! Gemi kaldırmayacak!
Dialogue: 0,0:19:08.10,0:19:11.28,Main,,0,0,0,,Şimdi denizin dibini boylacaklar!
Dialogue: 0,0:19:11.90,0:19:12.88,Main,,0,0,0,,Saldırıyor!
Dialogue: 0,0:19:19.97,0:19:21.97,Main,,0,0,0,,Hayvan gibi lan!
Dialogue: 0,0:19:21.97,0:19:23.82,Main,,0,0,0,,Denizi boylayacağız!
Dialogue: 0,0:19:23.82,0:19:26.02,Main,,0,0,0,,Sancak alabanda Jinbe!
Dialogue: 0,0:19:46.29,0:19:49.59,Main,,0,0,0,,Hepiniz sıkı tutunun!
Dialogue: 0,0:19:49.59,0:19:52.91,Main,,0,0,0,,Ölmek bilmediler!
Dialogue: 0,0:19:53.66,0:19:57.67,Main,,0,0,0,,{\an8}Teşekkürler Pudding-{\i1}chan{\i0}.\NSürekli yardımıma yetişiyorsun.
Dialogue: 0,0:19:53.60,0:19:58.84,Captions,,30,0,240,,{\fad(500,0)}23:08
Dialogue: 0,0:19:57.67,0:19:58.84,Main,,0,0,0,,{\an8}Kes zırvalamayı!
Dialogue: 0,0:19:59.28,0:20:03.40,Main,,0,0,0,,Öteye! Biraz öteye git Sanji...
Dialogue: 0,0:20:03.40,0:20:04.61,Main,,0,0,0,,...{\i1}san{\i1}!{\i0}
Dialogue: 0,0:20:04.61,0:20:07.14,Main,,0,0,0,,Karı-koca gibi gözükeceğiz ya!
Dialogue: 0,0:20:07.14,0:20:08.18,Main,,0,0,0,,Kim görecek be?
Dialogue: 0,0:20:11.97,0:20:13.98,Main,,0,0,0,,O- O değil de...
Dialogue: 0,0:20:13.98,0:20:16.68,Main,,0,0,0,,...bu plan cidden\Nişe yarayacak mı ki?
Dialogue: 0,0:20:16.68,0:20:21.07,Main,,0,0,0,,Luffy filo ve orduların göbeğinde\Nortaya çıkacak.
Dialogue: 0,0:20:21.07,0:20:25.53,Main,,0,0,0,,Kaptanımızı ne pahasına olursa olsun\Nkurtaracağım!
Dialogue: 0,0:20:26.26,0:20:28.12,Main,,0,0,0,,Aynalar ne âlemde?
Dialogue: 0,0:20:28.12,0:20:32.04,Main,,0,0,0,,Emrettiğiniz gibi\Nhepsinden kurtulduk efendim.
Dialogue: 0,0:20:32.04,0:20:36.51,Main,,0,0,0,,Erkek ve kız kardeşleriniz de\Npeşi sıra teşrif ediyorlar efendim.
Dialogue: 0,0:20:36.51,0:20:37.88,Main,,0,0,0,,Pekâlâ.
Dialogue: 0,0:20:37.98,0:20:40.34,Captions,,0,0,170,,{\fad(500,0)}23:36
Dialogue: 0,0:20:40.36,0:20:44.89,Main,,0,0,0,,Ailenin bu kadar ferdinin Kakao Adası'nda\Ntoplandığına inanamıyorum.
Dialogue: 0,0:20:44.89,0:20:48.60,Main,,0,0,0,,Hasır Şapka Luffy'ye\Nne denli tedbirli yaklaşıyorlar ki?
Dialogue: 0,0:20:53.52,0:20:56.11,Main,,0,0,0,,Düşmanın sayısı 10 binler var mı?
Dialogue: 0,0:20:56.11,0:20:57.69,Main,,0,0,0,,10 kişi bile yoklar galiba.
Dialogue: 0,0:20:57.69,0:21:00.49,Main,,0,0,0,,{\an8}Ne? Kestiriyorum ben.
Dialogue: 0,0:20:58.33,0:21:03.36,Captions,,0,0,225,,{\fs32\b1}{\fad(500,0)}Brownie\NCharlotte Ailesi'nin 32. Oğlu
Dialogue: 0,0:21:00.49,0:21:02.41,Main,,0,0,0,,{\an8}Bir hareketlenme olursa beni uyandırın.
Dialogue: 0,0:21:02.41,0:21:03.36,Main,,0,0,0,,{\an8}Emredersiniz!
Dialogue: 0,0:21:03.36,0:21:06.22,Main,,0,0,1,,En Kötü Nesil ha?
Dialogue: 0,0:21:05.05,0:21:10.54,Captions,,0,0,275,,{\fs32\b1}{\fad(500,0)}Snack\NCharlotte Ailesi'nin 25. Oğlu \N(Dört Şekerleme Generali'nin Eski Üyesi)\NKelle Ödülü: 600 Milyon Beli
Dialogue: 0,0:21:06.22,0:21:10.54,Main,,0,0,1,,Meydanda at koşturmalarına izin veremem artık.
Dialogue: 0,0:21:10.54,0:21:14.50,Main,,0,0,0,,Bir zamanlar Şekerleme Generali\Nolarak gururum adına!
Dialogue: 0,0:21:14.90,0:21:20.38,Captions,,0,0,225,,{\fs32\b1}{\fad(500,0)}Joconde\NCharlotte Ailesi'nin 27. Kızı
Dialogue: 0,0:21:14.50,0:21:18.06,Main,,0,0,0,,{\an8}Böyle az sayıda mürettebatı olan\Nbir tayfayla savaşmak için...
Dialogue: 0,0:21:18.06,0:21:20.38,Main,,0,0,0,,{\an8}...tüm birliklerin çağrılması Yonkou\NBig Mom adına gölge düşürüyor.
Dialogue: 0,0:21:22.29,0:21:26.30,Main,,0,0,0,,Yoksa Hasır Şapka Luffy\No denli tehlikeli bir adam mı?
Dialogue: 0,0:21:29.06,0:21:32.78,Main,,0,0,0,,Ciddi misin ya Oven abi?
Dialogue: 0,0:21:32.73,0:21:37.77,Captions,,0,100,255,,{\fad(500,0)}{\fs32\b1}36-40. Oğullar ve 30-34. Kızlar\NCharlotte Ailesi - Decuplets
Dialogue: 0,0:21:32.85,0:21:34.48,Main,,0,0,1,,Festival ortamı resmen!
Dialogue: 0,0:21:34.48,0:21:36.32,Main,,0,0,1,,Epey eğleneceğiz gibi!
Dialogue: 0,0:21:37.78,0:21:42.23,Main,,0,0,0,,Kesin sesinizi! Nasılsa işsizin tekisiniz!\NDediğimi yapın!
Dialogue: 0,0:21:42.23,0:21:46.17,Main,,0,0,0,,{\an8}Aşağılık Hasır Şapka... \NÇay Partisi'nde bizi rezil etti!
Dialogue: 0,0:21:43.50,0:21:48.53,Captions,,0,0,220,,{\fad(500,0)}{\fs32\b1}Chiboust \NCharlotte Ailesi'nin 30. Oğlu
Dialogue: 0,0:21:46.17,0:21:48.53,Main,,0,0,0,,{\an8}İntikamım kellesine mal olacak!
Dialogue: 0,0:21:48.84,0:21:53.91,Captions,,0,0,220,,{\fad(500,0)}{\fs32\b1}Raisin\NCharlotte Ailesi'nin 33. Oğlu
Dialogue: 0,0:21:48.95,0:21:51.93,Main,,0,0,0,,{\an8}Hiddetli ordu adıyla sevk edildiğimizde...
Dialogue: 0,0:21:51.93,0:21:53.91,Main,,0,0,0,,{\an8}...canını almamız gerekirdi.
Dialogue: 0,0:21:53.91,0:21:57.87,Main,,0,0,0,,{\an8}Böylece Çay Partisi'nde çuvallamamış olurduk.
Dialogue: 0,0:21:53.96,0:21:57.87,Captions,,0,0,220,,{\fad(500,0)}{\fs32\b1}Yuen\NCharlotte Ailesi'nin 35. Oğlu
Dialogue: 0,0:21:57.87,0:22:03.34,Main,,0,0,0,,{\an8}Genelde bir işgalcinin hareketlerini\Nkolayca çözerdik oysa.
Dialogue: 0,0:21:58.31,0:22:03.34,Captions,,0,0,220,,{\fad(500,0)}{\fs32\b1}Myukuru\NCharlotte Ailesi'nin 25. Kızı
Dialogue: 0,0:22:03.34,0:22:07.01,Main,,0,0,0,,Mıntıka Salyangozları olmayınca epey uğraştırıyor!
Dialogue: 0,0:22:07.01,0:22:11.22,Main,,0,0,0,,Lakin hazırlığımız tamam,\Ndaha bir buçuk saatimiz de var!
Dialogue: 0,0:22:11.22,0:22:15.10,Main,,0,0,0,,Vakit çatıp gelince defterlerini düreceğiz!
Dialogue: 0,0:22:16.16,0:22:20.50,Narrator,,0,0,0,,{\an8}Hasır Şapkalar'ın Kakao Adası'nda...
Dialogue: 0,0:22:18.60,0:22:23.18,Captions,,0,110,170,,{\fad(500,0)}00:05
Dialogue: 0,0:22:20.50,0:22:22.53,Narrator,,0,0,0,,{\an8}...sözleştikleri vakte yaklaşık 1 saat kalmıştı.
Dialogue: 0,0:22:32.20,0:22:34.75,Main,,0,0,0,,Ne oldu Hasır Şapka?
Dialogue: 0,0:22:35.29,0:22:36.80,Main,,0,0,0,,Savaşımız...
Dialogue: 0,0:22:36.80,0:22:39.05,Main,,0,0,0,,Evet, sahi ya.
Dialogue: 0,0:22:39.05,0:22:41.72,Main,,0,0,0,,...bitti mi yani?
Dialogue: 0,0:22:51.89,0:22:54.90,Main,,0,0,0,,Pekâlâ, ben varım.
Dialogue: 0,0:22:59.31,0:23:00.78,Main,,0,0,0,,Noktayı koyacağım!
Dialogue: 0,0:23:05.19,0:23:08.04,Main,,0,0,0,,Bu hamlemden sonra da ayakta...
Dialogue: 0,0:23:08.04,0:23:10.58,Main,,0,0,0,,Diyeceğimi dedim.
Dialogue: 0,0:23:28.09,0:23:29.44,Main,,0,0,0,,Son hamlem...
Dialogue: 0,0:23:29.76,0:23:30.60,Main,,0,0,0,,Evet...
Dialogue: 0,0:23:35.68,0:23:37.42,Main,,0,0,0,,{\fad(150,150)}Gear Fourth!
Dialogue: 0,0:23:35.68,0:23:37.42,Note,,0,0,0,,{\fad(150,150)}Dördüncü Düzen
Dialogue: 0,0:24:24.56,0:24:26.20,Main,,0,0,0,,{\fad(150,150)}Snakeman!
Dialogue: 0,0:24:24.56,0:24:26.20,Note,,0,0,0,,{\fad(150,150)}Yılan Adam
Dialogue: 0,0:24:35.03,0:24:38.83,Main,,0,0,0,,Yılan Adam mı? \NDeminki formundan biraz daha farklı gibi.
Dialogue: 0,0:24:40.29,0:24:43.66,Main,,0,0,0,,Gerçekten de akıllara zarar\Nbir Gözlem Haki'n var.
Dialogue: 0,0:24:44.04,0:24:45.33,Main,,0,0,0,,Bu yüzden de şimdi...
Dialogue: 0,0:24:46.75,0:24:47.79,Main,,0,0,0,,...daha hızlıyım!
Dialogue: 0,0:24:50.13,0:24:53.61,Thoughts,,0,0,0,,{\i1}Dövüşün bu safhasında neden\Nböyle basit bir saldırıya başvuruyor ki?
Dialogue: 0,0:25:01.35,0:25:03.14,Thoughts,,0,0,0,,{\i1}Neler oluyor?
Dialogue: 0,0:25:06.81,0:25:09.03,Thoughts,,0,0,0,,{\i1}Nasıl oluyor da\Nbaşka açıdan saldırı geliyor?
Dialogue: 0,0:25:10.69,0:25:12.99,Thoughts,,0,0,0,,{\i1}Ne yaptı böyle?
Dialogue: 0,0:25:14.03,0:25:16.34,Thoughts,,0,0,0,,{\i1}Nereden çıkageldi ki?
Dialogue: 0,0:25:18.53,0:25:20.15,Thoughts,,0,0,0,,{\i1}Savuşturduğuma adım gibi eminim!
Dialogue: 0,0:25:24.62,0:25:27.12,Thoughts,,0,0,0,,{\i1}Şimdi anladım.\NBöyle yapıyor demek!
Dialogue: 0,0:25:30.67,0:25:32.34,Main,,0,0,0,,Yakala onu, Piton!
Dialogue: 0,0:25:33.71,0:25:35.01,Main,,0,0,0,,Nafile!
Dialogue: 0,0:25:36.84,0:25:38.89,Main,,0,0,0,,Uzadıktan sonra da hızına hız katar!
Dialogue: 0,0:25:41.26,0:25:43.11,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:25:43.68,0:25:44.81,Main,,0,0,0,,{\fad(150,150)}Jet...
Dialogue: 0,0:25:44.81,0:25:47.44,Main,,0,0,0,,{\fad(150,150)}Culverin!
Dialogue: 0,0:25:44.81,0:25:47.44,Attack,,0,0,0,,{\fad(150,150)}Büyük Yılan Topu
Dialogue: 0,0:26:12.86,0:26:15.17,Main,,0,0,0,,Daha yeni başlıyorum!
Dialogue: 0,0:26:37.07,0:26:40.76,Main,,0,0,0,,Hem güç hem de hız bazında\Nsenden üstünüm!
Dialogue: 0,0:26:42.99,0:26:44.38,Main,,0,0,0,,Yakala şunu!
Dialogue: 0,0:27:06.43,0:27:08.40,Main,,0,0,0,,{\fad(150,150)}Zan Giri Mochi!
Dialogue: 0,0:27:06.43,0:27:08.40,Attack,,0,0,0,,{\fad(150,150)}Doğranmış Mochi
Dialogue: 0,0:27:13.77,0:27:15.65,Main,,0,0,0,,Soktuğumun mochi'si yapıştığından...
Dialogue: 0,0:27:17.07,0:27:18.65,Main,,0,0,0,,...kurtulamıyorum da!
Dialogue: 0,0:27:28.66,0:27:30.87,Main,,0,0,0,,Başım dönüyor!
Dialogue: 0,0:27:33.71,0:27:35.75,Main,,0,0,0,,Dur! N'apıyorsun?
Dialogue: 0,0:27:38.84,0:27:40.59,Main,,0,0,0,,İndir lan!
Dialogue: 0,0:27:40.59,0:27:43.18,Main,,0,0,0,,Hay içine! Ayrılamıyorum!
Dialogue: 0,0:27:43.72,0:27:46.85,Main,,0,0,0,,Kavgamız burada biter Hasır Şapka!
Dialogue: 0,0:28:02.53,0:28:04.28,Main,,0,0,0,,Sıçayım lan!
Dialogue: 0,0:28:40.64,0:28:42.19,Main,,0,0,0,,Ulan!
Dialogue: 0,0:28:43.52,0:28:44.78,Main,,0,0,0,,Canım yanıyor!
Dialogue: 0,0:28:46.02,0:28:47.72,Main,,0,0,0,,Tam bir işkence!
Dialogue: 0,0:28:49.78,0:28:51.41,Main,,0,0,0,,Karnım aç benim!
Dialogue: 0,0:29:03.42,0:29:05.30,Main,,0,0,0,,Ne geveliyorsun sen be?
Dialogue: 0,0:29:05.30,0:29:07.80,Main,,0,0,0,,Kafamdaki her şeyi dillendirdim gitti!
Dialogue: 0,0:29:07.80,0:29:09.86,Main,,0,0,0,,Şimdi rahatladım!
Dialogue: 0,0:29:09.86,0:29:12.66,Main,,0,0,0,,Yıkıl artık Katakuri!
Dialogue: 0,0:29:12.66,0:29:14.66,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:29:14.66,0:29:17.14,Main,,0,0,0,,{\fad(150,150)}Jet Culverin!
Dialogue: 0,0:29:14.66,0:29:17.14,Attack,,0,0,0,,{\fad(150,150)}Jet Büyük Yılan Topu
Dialogue: 0,0:29:17.14,0:29:18.77,Main,,0,0,0,,{\fad(150,150)}Naguri Mochi!
Dialogue: 0,0:29:17.14,0:29:18.77,Attack,,0,0,0,,{\fad(150,150)}Yumruk Mochi
Dialogue: 0,0:29:50.01,0:29:52.10,Main,,0,0,0,,Acıdı!
Dialogue: 0,0:29:53.43,0:29:55.48,Main,,0,0,0,,Fırla Piton!
Dialogue: 0,0:29:57.64,0:30:00.03,Main,,0,0,0,,{\fad(150,150)}Yaki Mochi!
Dialogue: 0,0:29:57.64,0:30:00.03,Attack,,0,0,0,,{\fad(150,150)}Izgara Mochi!
Dialogue: 0,0:30:27.27,0:30:28.08,Main,,0,0,0,,Sıçayım!
Dialogue: 0,0:30:35.52,0:30:36.78,Main,,0,0,0,,Şimdi ne var?
Dialogue: 0,0:30:40.82,0:30:42.32,Main,,0,0,0,,İlginçmiş bak.
Dialogue: 0,0:30:42.32,0:30:43.28,Main,,0,0,0,,Yolla gelsin!
Dialogue: 0,0:30:43.28,0:30:44.49,Main,,0,0,0,,Sıkı dur!
Dialogue: 0,0:30:46.66,0:30:48.59,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:30:51.50,0:30:53.63,Main,,0,0,0,,Black Mamba!
Dialogue: 0,0:30:51.50,0:30:53.63,Attack,,0,0,0,,Kara Mamba
Dialogue: 0,0:31:38.01,0:31:41.22,Main,,0,0,0,,Bir sonraki saldırımda\Nbu hesap kapanacak Hasır Şapka!
Dialogue: 0,0:31:49.06,0:31:53.07,Main,,0,0,0,,N'olursa olsun seni alt edeceğim Katakuri!
Dialogue: 0,0:32:00.70,0:32:01.91,Main,,0,0,0,,Yine şu teknik!
Dialogue: 0,0:32:01.91,0:32:03.75,Main,,0,0,0,,Izdırabına son vereceğim!
Dialogue: 0,0:32:03.76,0:32:05.71,Main,,0,0,0,,İstemez!
Dialogue: 0,0:32:14.35,0:32:16.28,Note,,0,0,0,,- Shakky'nin Soygun Barı -
Dialogue: 0,0:32:20.59,0:32:22.26,Main,,0,0,0,,Sahi ya...
Dialogue: 0,0:32:26.01,0:32:29.31,Main,,0,0,0,,...Monkey-chan iyi midir ki?
Dialogue: 0,0:32:39.31,0:32:41.91,Thoughts,,0,0,0,,{\i1}Zorlukların üstesinden gelmesini bil Luffy!
Dialogue: 0,0:32:48.10,0:32:50.12,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:32:53.08,0:32:54.87,Main,,0,0,0,,{\fad(150,150)}Zan Giri Mochi!
Dialogue: 0,0:32:53.08,0:32:54.87,Attack,,0,0,0,,{\fad(150,150)}Doğranmış Mochi
Dialogue: 0,0:32:56.33,0:32:58.48,Main,,0,0,0,,{\fad(150,150)}King Cobra!
Dialogue: 0,0:32:56.33,0:32:58.48,Attack,,0,0,0,,{\fad(150,150)}Kral Kobra
Dialogue: 0,0:33:02.92,0:33:04.76,Main,,0,0,0,,Artık kaçamazsın!
Dialogue: 0,0:33:05.59,0:33:07.26,Main,,0,0,0,,Fırla!
