Dialogue: 0,0:01:42.08,0:01:46.27,Title,,0,0,0,,{\pos(634,493)}{\fad(1000,1000)}Luffy, Komutan Cracker'a Karşı
Dialogue: 0,0:01:43.30,0:01:46.25,Main,,0,0,0,,Pff! Ne küstah bir velet.
Dialogue: 0,0:01:46.25,0:01:50.42,Main,,0,0,0,,Şu kılıca baksana! Harika değil mi?
Dialogue: 0,0:01:50.42,0:01:55.68,Main,,0,0,0,,Bu kılıcın adı Pretzel!\NDünyada eşi benzeri yok!
Dialogue: 0,0:01:55.68,0:02:00.16,Main,,0,0,0,,Yeni Dünya'nın ne kadar çetin\Nolduğunu size öğreteceğim!
Dialogue: 0,0:02:00.64,0:02:05.52,Main,,0,0,0,,Ne? Dünyada eşi yok mu?\NElinde 6 tanesi var ama!
Dialogue: 0,0:02:07.85,0:02:09.60,Main,,0,0,0,,Hemen kaçalım Luffy!
Dialogue: 0,0:02:09.60,0:02:11.78,Main,,0,0,0,,Olmaz!
Dialogue: 0,0:02:33.92,0:02:37.63,Main,,0,0,0,,Kaçacak bir yeriniz yok!
Dialogue: 0,0:02:42.18,0:02:43.64,Main,,0,0,0,,Lanet olsun!
Dialogue: 0,0:03:39.53,0:03:41.26,Main,,0,0,0,,Abimden de bu beklenirdi.
Dialogue: 0,0:03:41.26,0:03:42.49,Main,,0,0,0,,Luffy...
Dialogue: 0,0:03:59.38,0:04:01.51,Main,,0,0,0,,Olamaz.
Dialogue: 0,0:04:01.51,0:04:06.35,Flashbacks,,0,0,0,,Yonkou'nun adamı bunlar!\NDaha dikkatli olmalıydık!
Dialogue: 0,0:04:06.45,0:04:10.31,Main,,0,0,0,,Luffy bile onun astına karşı zorlanıyor.
Dialogue: 0,0:04:11.56,0:04:13.35,Main,,0,0,0,,Luffy! Kaç!
Dialogue: 0,0:04:16.06,0:04:17.61,Main,,0,0,0,,N-Ne...
Dialogue: 0,0:04:20.03,0:04:24.32,Main,,0,0,0,,Dur bakalım! Sizinle dövüşecek olan benim!
Dialogue: 0,0:04:24.32,0:04:26.37,Main,,0,0,0,,Ben de varım-{\i1}ju{\i}!
Dialogue: 0,0:04:47.76,0:04:52.22,Main,,0,0,0,,Seni anlıyorum. Korkuyorsun değil mi?
Dialogue: 0,0:04:53.52,0:04:57.60,Main,,0,0,0,,En Kötü Nesil mi? Neyi kötüymüş?
Dialogue: 0,0:04:57.60,0:05:01.53,Main,,0,0,0,,Grand Line'ın ilk yarısında\Ngaza geldikten sonra...
Dialogue: 0,0:05:01.53,0:05:09.08,Main,,0,0,0,,...hepiniz "Kaptanımız Korsanlar Kralı olacak." \Ndemeye başladınız ama sonuç sadece hüsran.
Dialogue: 0,0:05:09.08,0:05:11.24,Main,,0,0,0,,Gırla gördüm sizden!
Dialogue: 0,0:05:11.95,0:05:18.79,Main,,0,0,0,,Son 2 yılda bu korsanlardan Mama'nın\Nbölgesine girenler bile oldu.
Dialogue: 0,0:05:18.79,0:05:21.00,Main,,0,0,0,,"Kaptan" Kid.
Dialogue: 0,0:05:21.00,0:05:22.98,Main,,0,0,0,,"Denizin Gürültüsü" Apoo.
Dialogue: 0,0:05:22.98,0:05:24.78,Main,,0,0,0,,"Gang" Bege.
Dialogue: 0,0:05:24.78,0:05:27.55,Main,,0,0,0,,"Deli Keşiş" Urouge.
Dialogue: 0,0:05:27.55,0:05:33.47,Main,,0,0,0,,Direkt haddini bilip astımız\Nolan Bege haricindeki herkes...
Dialogue: 0,0:05:33.47,0:05:41.32,Main,,0,0,0,,...Mama'nın yüzünü bile göremeden,\Nsesini bile duyamadan topukladı!
Dialogue: 0,0:05:41.87,0:05:45.02,Main,,0,0,0,,Tek direnen...
Dialogue: 0,0:05:45.02,0:05:47.40,Main,,0,0,0,,...Deli Keşiş Urouge idi.
Dialogue: 0,0:05:48.66,0:05:53.54,Main,,0,0,0,,Tatlı Komutanlarından birisini\Nyenecek kadar ileri de gitti.
Dialogue: 0,0:05:53.54,0:05:57.29,Main,,0,0,0,,Kısa bir süre önceye kadar\N4 Tatlı Komutanı vardı.
Dialogue: 0,0:05:58.92,0:06:00.83,Main,,0,0,0,,Ama devamı gelmedi.
Dialogue: 0,0:06:00.83,0:06:04.84,Main,,0,0,0,,Mama'yı sinirlendirdi ve Cracker Abim \Ntarafından dayağını yedi.
Dialogue: 0,0:06:04.84,0:06:07.63,Main,,0,0,0,,Kaçacak hiçbir yeri yoktu.
Dialogue: 0,0:06:07.63,0:06:11.58,Main,,0,0,0,,Eminim bir köşede ölmüştür\Nşimdiye kadar.
Dialogue: 0,0:06:18.54,0:06:19.60,Main,,0,0,0,,Kayboldu!
Dialogue: 0,0:06:29.76,0:06:31.62,Main,,0,0,0,,Dinle!
Dialogue: 0,0:06:31.62,0:06:35.45,Main,,0,0,0,,Yeni Dünya'nın çıkmazına ulaştınız!
Dialogue: 0,0:06:41.92,0:06:46.57,Main,,0,0,0,,Yonkou ile savaşmak mı?\NHayal sadece!
Dialogue: 0,0:06:46.57,0:06:49.32,Main,,0,0,0,,Mama'yı göremezsiniz bile!
Dialogue: 0,0:06:49.32,0:06:53.85,Main,,0,0,0,,Çay partisine sızmak mı?\NDüğünü mahvetmek mi?
Dialogue: 0,0:06:53.85,0:06:59.27,Main,,0,0,0,,Arkadaşınızı geri almak için mi?\NHayalden ötesi değil bunlar!
Dialogue: 0,0:06:59.27,0:07:05.15,Main,,0,0,0,,Mama'yı bile göremeden \Nbu ormanda öleceksiniz!
Dialogue: 0,0:07:07.65,0:07:10.32,Main,,0,0,0,,Aygıtım...
Dialogue: 0,0:07:12.91,0:07:17.04,Main,,0,0,0,,Hadi, ayna dünyasına gel!
Dialogue: 0,0:07:18.38,0:07:20.62,Main,,0,0,0,,Bırak beni!
Dialogue: 0,0:07:22.38,0:07:26.13,Main,,0,0,0,,Hadi! Hadi gel bakalım!
Dialogue: 0,0:07:26.13,0:07:31.51,Main,,0,0,0,,Öbür boyutta yüzünü ve\Nbedenini yavaşça keseceğim!
Dialogue: 0,0:07:31.51,0:07:32.80,Main,,0,0,0,,Pound-{\i1}chan{\i0}!
Dialogue: 0,0:07:36.84,0:07:38.93,Main,,0,0,0,,Pes et.
Dialogue: 0,0:07:38.93,0:07:41.31,Main,,0,0,0,,Bırak onu, Brûlée!
Dialogue: 0,0:07:53.46,0:07:55.28,Main,,0,0,0,,Teşekkürler!
Dialogue: 0,0:07:55.28,0:07:57.28,Main,,0,0,0,,Üvey baba Pound!
Dialogue: 0,0:07:57.28,0:08:01.41,Main,,0,0,0,,Pound yani!\NBu yaptığın Mama'ya ihanettir!
Dialogue: 0,0:08:02.00,0:08:05.08,Main,,0,0,0,,İşin bitti!\NKimse seni kurtaramaz artık!
Dialogue: 0,0:09:00.43,0:09:03.56,Main,,0,0,0,,Brûlée geri dönecektir.
Dialogue: 0,0:09:03.56,0:09:09.40,Main,,0,0,0,,Ayna olan her yerden ortaya çıkabilir.
Dialogue: 0,0:09:09.40,0:09:12.11,Main,,0,0,0,,Özür dilerim.\NBana yardım etmek için yaptın.
Dialogue: 0,0:09:13.00,0:09:19.03,Main,,0,0,0,,Zaten canıma kastları vardı.
Dialogue: 0,0:09:19.03,0:09:21.53,Main,,0,0,0,,Eski eşim tarafından.
Dialogue: 0,0:09:24.20,0:09:28.79,Main,,0,0,0,,Aklıma geldi de \Nsen Lola'nın arkadaşı mısın?
Dialogue: 0,0:09:40.26,0:09:43.91,Main,,0,0,0,,Anlıyorum, hata olmamalı.
Dialogue: 0,0:09:43.91,0:09:47.17,Main,,0,0,0,,Lola'nın annesi Big Mom.
Dialogue: 0,0:09:48.52,0:09:53.53,Main,,0,0,0,,Ormandaki ağaçların bu Vivre Kartı'ndan \Nkorkması bunun bir kanıtı.
Dialogue: 0,0:09:54.28,0:09:58.45,Main,,0,0,0,,Bunu bayağı kullanacağım Lola!
Dialogue: 0,0:10:21.20,0:10:24.64,Main,,0,0,0,,Olamaz! Arada kalacağız!
Dialogue: 0,0:10:36.82,0:10:41.90,Main,,0,0,0,,Hey, dağılmayıp Ayartan Orman\Nolarak görevinizi yapın!
Dialogue: 0,0:10:41.90,0:10:44.91,Main,,0,0,0,,Kimseyi buradan dışarı bırakamayız!
Dialogue: 0,0:10:46.33,0:10:47.66,Main,,0,0,0,,T-Tamam!
Dialogue: 0,0:10:47.66,0:10:49.96,Main,,0,0,0,,Yolu kapatın!
Dialogue: 0,0:11:21.11,0:11:25.53,Main,,0,0,0,,Lanet olsun! Çok sert!\NŞu herifin Silahlanması...
Dialogue: 0,0:11:49.10,0:11:54.69,Main,,0,0,0,,Vinsmoke Sanji'yi arkadaşın olarak\Ngörüyorsan neden onu rahat bırakmıyorsun?
Dialogue: 0,0:11:54.69,0:12:00.40,Main,,0,0,0,,Büyük bir krallığın prensi.\NSizden çok farklı bir seviyede.
Dialogue: 0,0:12:02.49,0:12:07.12,Main,,0,0,0,,Asil bir eşle evlenip refah içerisinde...
Dialogue: 0,0:12:07.91,0:12:10.70,Main,,0,0,0,,...hayatını burada sürecek.
Dialogue: 0,0:12:16.01,0:12:22.34,Main,,0,0,0,,Arkadaşınızı tebrik bile etmeyip \Nbencilce geri alma peşindesiniz.
Dialogue: 0,0:12:22.34,0:12:26.04,Main,,0,0,0,,Böyle can sıkıcı bir kaptanı görse...
Dialogue: 0,0:12:26.04,0:12:30.39,Main,,0,0,0,,...o büyük prens iğrenip şöyle der:
Dialogue: 0,0:12:33.94,0:12:39.07,Main,,0,0,0,,"Defol, seni zavallı, ezik korsan!"
Dialogue: 0,0:13:32.24,0:13:35.71,Main,,0,0,0,,Kas Balonu güzel isimmiş.
Dialogue: 0,0:13:38.17,0:13:41.95,Main,,0,0,0,,Bir balon ne yapabilir ki ama?
Dialogue: 0,0:13:43.30,0:13:45.51,Main,,0,0,0,,Bir kez daha tekrar edeceğim!
Dialogue: 0,0:13:45.51,0:13:48.89,Main,,0,0,0,,Defol, seni zavallı, ezik korsan!
Dialogue: 0,0:14:27.08,0:14:29.80,Main,,0,0,0,,Cracker-{\i1}sama{\i0}!
Dialogue: 0,0:14:33.74,0:14:36.43,Main,,0,0,0,,Sanji'yi hafife alma!
Dialogue: 0,0:14:36.43,0:14:40.02,Main,,0,0,0,,Mutlu olup geri dönmek istemese bile...
Dialogue: 0,0:14:40.02,0:14:44.44,Main,,0,0,0,,...bize asla öyle şeyler demez!
Dialogue: 0,0:14:56.60,0:14:59.50,Main,,0,0,0,,Sanji'yi göreceğim ben!
Dialogue: 0,0:15:03.12,0:15:05.46,Main,,0,0,0,,Şansını zorlama!
Dialogue: 0,0:15:17.68,0:15:20.71,Main,,0,0,0,,Cracker-{\i1}sama{\i0}!
Dialogue: 0,0:15:40.50,0:15:41.62,Main,,0,0,0,,Ne oldu?!
Dialogue: 0,0:15:45.98,0:15:49.05,Main,,0,0,0,,İyi iş çıkardın kırarak...
Dialogue: 0,0:15:49.05,0:15:51.30,Main,,0,0,0,,...zırhımı!
Dialogue: 0,0:15:56.97,0:15:58.89,Main,,0,0,0,,Sen de kimsin be?!
Dialogue: 0,0:15:58.89,0:16:01.35,Main,,0,0,0,,Kim miyim?
Dialogue: 0,0:16:02.25,0:16:06.11,Main,,0,0,0,,Tatlı Komutanı Cracker\Nolduğumu söylemiştim sanırım.
Dialogue: 0,0:16:06.11,0:16:11.11,Captions,,0,0,0,,{\fad(500,0)}Bin Kollu Cracker
Dialogue: 0,0:16:15.57,0:16:17.92,Main,,0,0,0,,En sevdiğim zırhımdı o.
Dialogue: 0,0:16:17.92,0:16:21.16,Main,,0,0,0,,Zırh mı?\NYalan söylüyorsun! Kan kustu!
Dialogue: 0,0:16:21.16,0:16:23.87,Main,,0,0,0,,- Reçeldi.\N- Reçel mi?!
Dialogue: 0,0:16:23.87,0:16:28.09,Main,,0,0,0,,Gerçek bir sanatçı olduğum\Niçin eminim tadı da güzeldir.
Dialogue: 0,0:16:30.33,0:16:34.59,Main,,0,0,0,,Bisu Bisu Meyvesi yemiş\Nbisküvi insanım ben.
Dialogue: 0,0:16:34.59,0:16:39.01,Main,,0,0,0,,Sınırsız sayıda bisküvi üretip\Nonları kullanabilirim!
Dialogue: 0,0:16:47.52,0:16:49.65,Main,,0,0,0,,İstediğim şekli verebilirim!
Dialogue: 0,0:16:59.71,0:17:02.58,Main,,0,0,0,,Dikkatlice şekillendirirsem...
Dialogue: 0,0:17:04.41,0:17:08.67,Main,,0,0,0,,İşte! Sert bir savaşçı yüzü!
Dialogue: 0,0:17:10.96,0:17:13.21,Main,,0,0,0,,Tarih boyunca bisküvi...
Dialogue: 0,0:17:13.21,0:17:16.89,Main,,0,0,0,,...yapımcısının gönlüne\Ngöre şekil değiştirmiştir!
Dialogue: 0,0:17:17.89,0:17:22.14,Main,,0,0,0,,Gerçek beni görmüş\Nçok kişi de yok ayrıca.
Dialogue: 0,0:17:23.63,0:17:28.26,Main,,0,0,0,,Hükümet tarafından basılmış\Naranıyor posterimde bile...
Dialogue: 0,0:17:28.26,0:17:31.69,Main,,0,0,0,,...ben değil, zırhım var.
Dialogue: 0,0:17:34.23,0:17:39.45,Main,,0,0,0,,Acıdan nefret ediyorum!\NVurulmaktan da nefret ediyorum!
Dialogue: 0,0:17:39.45,0:17:44.91,Main,,0,0,0,,Bu yüzden ya zırh giyiyorum\Nya da onları dövüştürüyorum!
Dialogue: 0,0:17:44.91,0:17:50.54,Main,,0,0,0,,Ellerimi çarptıkça çoğalıyorlar!\Nİşte rüya gibi böyle çalışıyor bisküvilerim!
Dialogue: 0,0:17:50.54,0:17:54.42,Main,,0,0,0,,Yani emrimde sınırsız bir ordu var!
Dialogue: 0,0:17:55.80,0:17:59.18,Main,,0,0,0,,Canını dişine takıp kırdığın...
Dialogue: 0,0:17:59.18,0:18:05.81,Main,,0,0,0,,...Bisküvi Savaşçılarımdan sonsuz tane üretebilirim!
Dialogue: 0,0:18:05.81,0:18:11.36,Main,,0,0,0,,Vinsmoke Sanji'yi bir daha\Ngöremeyeceğini anladın mı şimdi?
Dialogue: 0,0:18:13.32,0:18:15.69,Flashbacks,,0,0,0,,Kesinlikle geri döneceğim.
Dialogue: 0,0:18:23.62,0:18:26.62,Main,,0,0,0,,Sanji'yi göreceğim!
Dialogue: 0,0:18:32.34,0:18:37.52,Main,,0,0,0,,Ne kadar çabalarsan çabala\Nyenemeyeceğin kişiler olduğunu bilmek de...
Dialogue: 0,0:18:37.52,0:18:41.43,Main,,0,0,0,,...gelişim göstergesidir, velet.
Dialogue: 0,0:18:48.77,0:18:50.23,Main,,0,0,0,,Sana göstereceğim.
Dialogue: 0,0:19:06.16,0:19:09.91,Main,,0,0,0,,- İmkansız cidden!\N- Hiç şansımız yok!
Dialogue: 0,0:19:09.91,0:19:12.17,Main,,0,0,0,,Kaçın!
Dialogue: 0,0:19:22.02,0:19:24.80,Main,,0,0,0,,Burada güvende oluruz sanırım.
Dialogue: 0,0:19:24.80,0:19:27.85,Main,,0,0,0,,Ona denk değiliz.
Dialogue: 0,0:19:27.85,0:19:29.39,Main,,0,0,0,,Buradayım.
Dialogue: 0,0:19:43.12,0:19:45.37,Main,,0,0,0,,Ne ara?!
Dialogue: 0,0:19:46.79,0:19:50.37,Main,,0,0,0,,Ağzını kapatırsan ölümlerden\Nölüm beğenirsin.
Dialogue: 0,0:19:52.23,0:19:58.92,Main,,0,0,0,,Kaçınız kurursa kurusun isteğim\Nhiç değişmeyecek be!
Dialogue: 0,0:19:58.92,0:20:01.88,Main,,0,0,0,,Ne?!
Dialogue: 0,0:20:01.88,0:20:05.26,Main,,0,0,0,,Çok korkunç birisin.
Dialogue: 0,0:20:05.26,0:20:10.42,Main,,0,0,0,,Tatlı Generali Cracker ve annesi Yonkou Big Mom.
Dialogue: 0,0:20:10.42,0:20:12.50,Main,,0,0,0,,Hangisi daha korkunç?
Dialogue: 0,0:20:12.50,0:20:14.44,Main,,0,0,0,,Sen!
Dialogue: 0,0:20:19.53,0:20:22.57,Captions,,0,0,0,,{\fad(500,0)}Brûlée'nin Ayna Dünyası
Dialogue: 0,0:20:30.65,0:20:35.88,Main,,0,0,0,,Anlıyorum, demek öyle.\NDinle Carrot.
Dialogue: 0,0:20:36.52,0:20:42.26,Main,,0,0,0,,Aklıma bir fikir geldi, \Nbu yüzden bana Chopper Aniki(Abi) de.
Dialogue: 0,0:20:43.01,0:20:44.68,Main,,0,0,0,,Tamam, olur.
Dialogue: 0,0:20:44.68,0:20:45.84,Main,,0,0,0,,Güzel.
Dialogue: 0,0:20:45.84,0:20:49.14,Main,,0,0,0,,Peki fikrin ne Choniki?
Dialogue: 0,0:20:49.14,0:20:51.10,Main,,0,0,0,,Choniki?!
Dialogue: 0,0:20:51.10,0:20:55.44,Main,,0,0,0,,Evet, Chopper Aniki'nin kısaltması Choniki!
Dialogue: 0,0:20:56.81,0:20:59.15,Main,,0,0,0,,Neyse artık.
Dialogue: 0,0:20:59.70,0:21:01.84,Main,,0,0,0,,Bu aynalar dünyası...
Dialogue: 0,0:21:01.84,0:21:05.64,Main,,0,0,0,,...Whole Cake Adası'ndaki tüm\Naynalarla bağlı gibi görünüyor.
Dialogue: 0,0:21:05.64,0:21:08.16,Main,,0,0,0,,Evet, sanırım öyle.
Dialogue: 0,0:21:08.16,0:21:13.41,Main,,0,0,0,,Buradan kaçmak yerine Brûlée'nin\Ngücünden istifade etmeliyiz.
Dialogue: 0,0:21:13.41,0:21:14.96,Main,,0,0,0,,İstifade mi?
Dialogue: 0,0:21:14.96,0:21:18.50,Main,,0,0,0,,Aynalar ile Sanji'yi arayabiliriz.
Dialogue: 0,0:21:18.50,0:21:21.30,Main,,0,0,0,,Haklısın! İşte Choniki!
Dialogue: 0,0:21:22.91,0:21:27.59,Main,,0,0,0,,İltifatların beni mutlu etmiyor be hergele!
Dialogue: 0,0:21:28.18,0:21:32.64,Captions,,0,0,235,,{\fad(500,0)}Whole Cake Adası Başkenti\NTatlı Şehir
Dialogue: 0,0:21:59.00,0:22:01.92,Main,,0,0,0,,İyi gitti.
Dialogue: 0,0:22:01.92,0:22:06.38,Main,,0,0,0,,Devriyeden sonra \NBisküvi Savaşçıları şatoya dönerler.
Dialogue: 0,0:22:06.38,0:22:08.34,Main,,0,0,0,,O zaman harekete geçeriz.
Dialogue: 0,0:22:28.87,0:22:33.87,Main,,0,0,0,,Seni yenip Sanji'yi görmeye gideceğim!
Dialogue: 0,0:23:53.42,0:23:55.80,Main,,0,0,0,,Günaydınlar.
Dialogue: 0,0:23:55.80,0:24:00.16,Main,,0,0,0,,Bugün tanışmak için Vinsmoke'ları ağırlayacağız...{\an8}
Dialogue: 0,0:23:59.45,0:24:02.96,Captions,,0,0,0,,{\fad(500,0)}Whole Cake Şatosu
Dialogue: 0,0:24:00.16,0:24:02.96,Main,,0,0,0,,...ve nişan töreni gerçekleştireceğiz Mama.{\an8}
Dialogue: 0,0:24:02.96,0:24:05.92,Main,,0,0,0,,Düğün pastası hala hazır değil mi?
Dialogue: 0,0:24:05.92,0:24:07.63,Main,,0,0,0,,O yarına.
Dialogue: 0,0:24:10.84,0:24:13.51,Main,,0,0,0,,Bir gece geçti.
Dialogue: 0,0:24:13.51,0:24:16.64,Main,,0,0,0,,Küf mantarları ne durumda peki?
Dialogue: 0,0:24:16.64,0:24:19.84,Main,,0,0,0,,Arkadaşları ile görüşmek için son şansları.
Dialogue: 0,0:24:19.84,0:24:24.94,Main,,0,0,0,,Lütfen ama. Cracker-sama'yı\Ngönderdikten sonra nasıl olsun?
Dialogue: 0,0:24:24.94,0:24:31.28,Main,,0,0,0,,Kara Bacak şatoya girdiği gibi bir daha\Ngörme ihtimalleri kalmayacağı doğru.
Dialogue: 0,0:24:31.28,0:24:36.24,Main,,0,0,0,,Hem çay partisi hem de\Ndüğün şatoda kutlanacak.
Dialogue: 0,0:24:36.24,0:24:40.29,Main,,0,0,0,,Onlar da mı kuru gürültüymüş?
Dialogue: 0,0:24:40.29,0:24:44.24,Main,,0,0,0,,Vinsmoke oğullarından\Nbazıları hala gelmedi mi?
Dialogue: 0,0:24:44.24,0:24:49.48,Main,,0,0,0,,Aslında, az önce geldiklerine dair bir arama aldım.{\an8}
Dialogue: 0,0:24:44.96,0:24:49.48,Captions,,0,0,0,,Germa Krallığı{\fad(500,0)}
Dialogue: 0,0:24:51.38,0:24:53.38,Main,,0,0,0,,Güzel, geldiler demek.
Dialogue: 0,0:24:53.38,0:24:56.47,Main,,0,0,0,,Biricik oğullarım.
Dialogue: 0,0:24:56.47,0:25:00.06,Main,,0,0,0,,Sanji ile karşılaşmaları için sabırsızlanıyorum.
Dialogue: 0,0:25:17.94,0:25:20.03,Main,,0,0,0,,Hoş geldiniz!
Dialogue: 0,0:25:24.27,0:25:29.50,Captions,,0,0,0,,{\pos(648,463)}{\fad(500,0)}Vinsmoke Ichiji – "Kıvılcım Kırmızısı"\NVinsmoke Ailesi'nin En Büyük Oğlu
Dialogue: 0,0:25:34.82,0:25:40.05,Captions,,0,0,0,,{\pos(648,463)}{\fad(500,0)}Vinsmoke Niji – "Elektrik Mavisi"\NVinsmoke Ailesi'nin 2. Büyük Oğlu
Dialogue: 0,0:25:43.79,0:25:47.60,Main,,0,0,0,,- Ichiji-sama! Niji-sama!\N- Dönmeniz ne güzel!
Dialogue: 0,0:25:47.60,0:25:51.52,Main,,0,0,0,,Broc Coli'deki uzun savaşı\Nbitirmeniz inanılmaz!
Dialogue: 0,0:26:05.54,0:26:08.94,Main,,0,0,0,,Neden bizi karşılamaya gelmiyor bu?
Dialogue: 0,0:26:08.94,0:26:10.59,Main,,0,0,0,,Boş ver Niji.
