1Style: Author,Impress BT,20.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.7,0.7,9,10,10,10,1Style: Attack,Duality,30.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.0,1.0,7,12,12,12,1Style: Sanji,BlackChancery,55,&H008BEEF0,&H000000FF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,2,0,2,120,120,18,1Style: Judge,LightningBlaze,55,&H0054BFE7,&H000000FF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,2,0,2,120,120,18,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.82,0:00:06.82,Lyrics,,0,0,0,karaoke,♪ Görmedim dünyanın sonunu kendi gözlerimle hiç. ♪Dialogue: 0,0:00:06.82,0:00:13.95,Lyrics,,0,0,0,karaoke,♪ O yüzden çıktım yola sizinle, bunu yapmak için! ♪Dialogue: 0,0:00:23.67,0:00:27.00,Lyrics,,0,0,0,karaoke,♪ Bir denizden diğerine yol alırken,...Dialogue: 0,0:00:29.06,0:00:31.91,Lyrics,,0,0,0,karaoke,...bunun sadece bir peri masalı olduğunu söylemek. ♪Dialogue: 0,0:00:31.92,0:00:38.78,Lyrics,,0,0,0,karaoke,♪ Gerçek, kurgudan daha tuhaf değil mi? ♪Dialogue: 0,0:00:39.94,0:00:43.56,Lyrics,,0,0,0,karaoke,♪ Fakat sırt çevirme hiçbirine ♪Dialogue: 0,0:00:43.56,0:00:50.04,Lyrics,,0,0,0,karaoke,♪ Sağduyu dedikleri zihnidir toplulukların! ♪Dialogue: 0,0:00:51.36,0:00:57.41,Lyrics,,0,0,0,karaoke,♪ Görmedim dünyanın sonunu kendi gözlerimle hiç. ♪Dialogue: 0,0:00:57.41,0:01:01.96,Lyrics,,0,0,0,karaoke,♪ O yüzden gitmemiz lazım Kaptan Özgür-Ruh! ♪Dialogue: 0,0:01:01.96,0:01:04.72,Lyrics,,0,0,0,karaoke,♪ Kim demiş imkansız diye,...Dialogue: 0,0:01:04.71,0:01:07.89,Lyrics,,0,0,0,karaoke,...daha hiçbir şey başlamadan! ♪Dialogue: 0,0:01:07.88,0:01:12.72,Lyrics,,0,0,0,karaoke,♪ Her şeyi bilmek istiyorum ve şimdi bilebiliriz de... ♪Dialogue: 0,0:01:12.72,0:01:18.68,Lyrics,,0,0,0,karaoke,♪ Bilebiliriz, bilebilirsin! Şu anda... ♪Dialogue: 0,0:01:19.06,0:01:24.10,Lyrics,,0,0,0,karaoke,♪ Bilebiliriz, bilebilirim! Bu harika hissi... ♪Dialogue: 0,0:01:24.39,0:01:31.32,Lyrics,,0,0,0,karaoke,♪ Hemen, şimdi, bilebiliriz! ♪Dialogue: 0,0:01:37.34,0:01:38.64,Lyrics,,0,0,0,karaoke,♪ Evet, bilebiliriz! ♪Dialogue: 0,0:01:43.54,0:01:45.41,Main,,0,0,0,,Düello!Dialogue: 0,0:01:46.52,0:01:49.48,Main,,0,0,0,,Başkomutan, meşhur Sanji-sama ile savaşacak!Dialogue: 0,0:01:49.48,0:01:50.71,Main,,0,0,0,,Sanji-sama?Dialogue: 0,0:01:50.71,0:01:52.54,Main,,0,0,0,,Nasıl bir herif böyle?!Dialogue: 0,0:01:52.54,0:01:54.67,Main,,0,0,0,,Görünce anlarız!Dialogue: 0,0:01:55.63,0:01:59.09,Captions,,0,0,0,,Yonji'nin Kalesi, Germa KrallığıDialogue: 0,0:02:01.14,0:02:03.98,Main,,0,0,0,,Hala evliliği reddettiğini duydum.Dialogue: 0,0:02:03.98,0:02:05.93,Main,,0,0,0,,Bu yüzden babamın yerine ona ders vermeye çalıştım.Dialogue: 0,0:02:05.93,0:02:08.73,Main,,0,0,0,,Tıpkı eski günlerdeki gibi.Dialogue: 0,0:02:08.73,0:02:13.98,Main,,0,0,0,,Ama bu oldu işte. Bunu ödeteceğim. Adi Sanji.Dialogue: 0,0:02:13.98,0:02:17.61,Main,,0,0,0,,Olmuyor Yonji-sama, çekiç işe yaramıyor.Dialogue: 0,0:02:25.61,0:02:28.90,Main,,0,0,0,,Baskı uygulayacağım, düzgün dur.Dialogue: 0,0:02:31.88,0:02:33.80,Main,,0,0,0,,Düzelttim.Dialogue: 0,0:02:37.34,0:02:43.18,Main,,0,0,0,,Lanet olsun! Adi herif! Tam bir karın ağrısı!Dialogue: 0,0:02:43.17,0:02:46.18,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - ARE-YOU-SURE thx to onepace.netDialogue: 0,0:16:25.30,0:16:35.30,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - ARE-YOU-SURE thx to onepace.netDialogue: 0,0:32:14.60,0:32:19.50,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - ARE-YOU-SURE thx to onepace.netDialogue: 0,0:02:43.17,0:02:46.18,Title,,0,0,0,,Vinsmoke JudgeDialogue: 0,0:02:46.18,0:02:48.83,Main,,0,0,0,,Demek Sanji-sama o!Dialogue: 0,0:02:53.40,0:02:55.57,Main,,0,0,0,,Hazır mısın?Dialogue: 0,0:02:57.03,0:02:58.61,Main,,0,0,0,,Doğuştan.Dialogue: 0,0:02:58.61,0:02:59.70,Main,,0,0,0,,Öyleyse...Dialogue: 0,0:03:01.28,0:03:02.87,Main,,0,0,0,,...geliyorum!Dialogue: 0,0:03:21.43,0:03:22.82,Main,,0,0,0,,Ne hız ama.Dialogue: 0,0:03:22.82,0:03:26.76,Main,,0,0,0,,Aranan bir korsandan da bu beklenir.Dialogue: 0,0:03:41.36,0:03:43.90,Main,,0,0,0,,Öz babanı ne cüretle tekmelersin?!Dialogue: 0,0:03:44.12,0:03:46.70,Main,,0,0,0,,Sen başlattın be!Dialogue: 0,0:03:46.70,0:03:50.83,Main,,0,0,0,,Babam olduğunu söylemeyi kessen iyi edersin ayrıca!Dialogue: 0,0:03:52.83,0:03:56.70,Main,,0,0,0,,Sen geri dönen oğlum Sanji'sin!Dialogue: 0,0:03:56.70,0:03:59.42,Main,,0,0,0,,Bana saldırırken öyle deme!Dialogue: 0,0:03:59.49,0:04:00.82,Main,,0,0,0,,Çok güçlü.Dialogue: 0,0:04:00.82,0:04:03.40,Main,,0,0,0,,Saldırı kıyafeti bile giymiyor.Dialogue: 0,0:04:04.43,0:04:08.76,Main,,0,0,0,,Çay partisi bittiği gibi korsan gemisine geri döneceğim!Dialogue: 0,0:04:08.76,0:04:10.64,Main,,0,0,0,,Rol icabı evleneceğim sadece!Dialogue: 0,0:04:10.64,0:04:12.23,Main,,0,0,0,,Hala bunu mu diyorsun?!Dialogue: 0,0:04:14.90,0:04:19.73,Main,,0,0,0,,Sadece Big Mom'la aranızda bir bağ olmasını istiyorsunuz değil mi?Dialogue: 0,0:04:19.73,0:04:22.45,Main,,0,0,0,,Öyleyse ne zaman bittiği önemli değil.Dialogue: 0,0:04:22.86,0:04:24.52,Main,,0,0,0,,Bunu yapamazsın.Dialogue: 0,0:04:24.52,0:04:27.12,Main,,0,0,0,,Vinsmoke Ailesi'ni hain yapar.Dialogue: 0,0:04:27.12,0:04:29.79,Main,,0,0,0,,Big Mom'un izin vereceğini mi sanıyorsun buna?!Dialogue: 0,0:04:29.79,0:04:34.20,Main,,0,0,0,,Kaderinizin ne olacağı umurumda değil.Dialogue: 0,0:04:34.20,0:04:38.21,Main,,0,0,0,,Ben sadece arkadaşlarımın hayatını kurtarmak için geldim.Dialogue: 0,0:04:38.21,0:04:40.55,Main,,0,0,0,,Ailene yüz mü çevireceksin?!Dialogue: 0,0:04:41.80,0:04:45.26,Main,,0,0,0,,Siz ailem değilsiniz be!Dialogue: 0,0:04:48.47,0:04:50.92,Flashbacks,,0,0,0,,Gerçekten de mutfaktaymış.Dialogue: 0,0:04:50.92,0:04:54.78,Flashbacks,,0,0,0,,Yine sıçanlar için yemek yapıyordu.Dialogue: 0,0:04:56.85,0:04:59.70,Flashbacks,,0,0,0,,Asiller yemek pişirmemelidir.Dialogue: 0,0:05:00.44,0:05:03.44,Flashbacks,,0,0,0,,Kapa çeneni! Geri verin!Dialogue: 0,0:05:04.49,0:05:06.74,Flashbacks,,0,0,0,,Acıdı...Dialogue: 0,0:05:09.41,0:05:11.06,Flashbacks,,0,0,0,,Aptal!Dialogue: 0,0:05:11.06,0:05:13.25,Flashbacks,,0,0,0,,Dokunma be bana!Dialogue: 0,0:05:15.24,0:05:17.63,Flashbacks,,0,0,0,,Çok güçsüz ve zavallı!Dialogue: 0,0:05:17.63,0:05:19.54,Flashbacks,,0,0,0,,Dördümüz de aynı gün doğduk!Dialogue: 0,0:05:19.88,0:05:22.50,Flashbacks,,0,0,0,,Neden sadece sen bu kadar eziksin ama?!Dialogue: 0,0:05:33.77,0:05:35.56,Flashbacks,,0,0,0,,Ezik!Dialogue: 0,0:05:48.15,0:05:50.53,Flashbacks,,0,0,0,,Baba.Dialogue: 0,0:05:52.08,0:05:54.24,Flashbacks,,0,0,0,,Yine Sanji'yi mi dövüyorsunuz?Dialogue: 0,0:05:57.48,0:05:59.38,Flashbacks,,0,0,0,,Yardım et.Dialogue: 0,0:06:00.46,0:06:02.21,Flashbacks,,0,0,0,,Baba!Dialogue: 0,0:06:03.76,0:06:05.36,Flashbacks,,0,0,0,,Neden?Dialogue: 0,0:06:06.88,0:06:10.09,Flashbacks,,0,0,0,,Neden mi?Dialogue: 0,0:06:10.09,0:06:15.10,Flashbacks,,0,0,0,,Gelecekte iyi bir asker olabilecek gibi durmuyorsun.Dialogue: 0,0:06:15.10,0:06:19.35,Flashbacks,,0,0,0,,Sana yardım etme zorunluluğum yok ve ayağa kalkmayı da hak etmiyorsun.Dialogue: 0,0:06:25.32,0:06:27.27,Flashbacks,,0,0,0,,Baba...Dialogue: 0,0:06:27.27,0:06:30.66,Flashbacks,,0,0,0,,Ailemizin yüz karasısın!Dialogue: 0,0:06:40.08,0:06:43.13,Flashbacks,,0,0,0,,Kalk ayağa! Sana ders vereceğim!Dialogue: 0,0:06:45.09,0:06:47.88,Flashbacks,,0,0,0,,Vinsmoke'ların yüz karası!Dialogue: 0,0:06:47.88,0:06:50.35,Flashbacks,,0,0,0,,Hadi şunu gebert Yonji.Dialogue: 0,0:06:50.35,0:06:52.09,Flashbacks,,0,0,0,,Tamam.Dialogue: 0,0:07:20.58,0:07:23.60,Main,,0,0,0,,Bir şey mi hatırladın?!Dialogue: 0,0:07:25.17,0:07:27.05,Main,,0,0,0,,Kılıcı bacağıyla durdurdu!Dialogue: 0,0:07:31.59,0:07:34.60,Main,,0,0,0,,O güçsüz Sanji'nin Haki kullanmasına inanamıyorum.Dialogue: 0,0:07:35.22,0:07:36.72,Main,,0,0,0,,Kılıç verin.Dialogue: 0,0:07:36.72,0:07:38.31,Main,,0,0,0,,Baş üstüne!Dialogue: 0,0:07:42.32,0:07:43.44,Main,,0,0,0,,Al.Dialogue: 0,0:07:45.18,0:07:46.60,Main,,0,0,0,,Ne oldu?Dialogue: 0,0:07:46.60,0:07:49.40,Main,,0,0,0,,Kılıç kullanmayı bildiğini düşünmüştüm.Dialogue: 0,0:07:54.45,0:07:59.66,Main,,0,0,0,,Böyle bir şey için ellerimi kullanmayacağım.Dialogue: 0,0:08:08.70,0:08:10.63,Main,,0,0,0,,Ellerim...Dialogue: 0,0:08:10.63,0:08:13.55,Main,,0,0,0,,...sadece yemek yapmak içindir.Dialogue: 0,0:08:45.79,0:08:49.71,Main,,0,0,0,,O güçsüz Sanji bu kadar güçlenmiş.Dialogue: 0,0:08:49.71,0:08:52.84,Main,,0,0,0,,Yemek mi? Saçmalık.Dialogue: 0,0:08:52.84,0:08:58.10,Main,,0,0,0,,Hala sıçanlar için yemek mi pişiriyorsun? Asiller hizmet etmemelidir!Dialogue: 0,0:08:58.10,0:08:59.69,Main,,0,0,0,,Utanç verici.Dialogue: 0,0:09:00.42,0:09:02.18,Main,,0,0,0,,Saçmalık.Dialogue: 0,0:09:09.15,0:09:13.90,Main,,0,0,0,,Evlilikle ne sorunun var senin?!Dialogue: 0,0:09:23.16,0:09:25.02,Main,,0,0,0,,Başkomutanın göğüs göğüse çarpışması!Dialogue: 0,0:09:25.02,0:09:27.75,Main,,0,0,0,,Garuda* olarak bilinen adamın dövüş şekli!Dialogue: 0,0:09:27.75,0:09:29.84,Main,,0,0,0,,Çok göremezsin bunu!Dialogue: 0,0:09:29.84,0:09:33.88,Main,,0,0,0,,Hava saldırısı mı? Yazık ki bildiğim yerden geldi.Dialogue: 0,0:09:55.07,0:09:58.41,Main,,0,0,0,,Bilim savaşta avantajdır!Dialogue: 0,0:10:25.72,0:10:30.84,Main,,0,0,0,,O bildiğin Germa geçmişte kaldı.Dialogue: 0,0:10:56.44,0:10:57.42,Main,,0,0,0,,Hey...Dialogue: 0,0:10:58.04,0:11:00.05,Main,,0,0,0,,Bir şey sorabilir miyim?Dialogue: 0,0:11:03.89,0:11:08.48,Main,,0,0,0,,Birisinin biyolojik babası olmak saygı görmeyi gerektirir mi?Dialogue: 0,0:11:09.81,0:11:11.65,Main,,0,0,0,,Senin...Dialogue: 0,0:11:15.04,0:11:20.15,Main,,0,0,0,,...onunla bir tane bile güzel anın yok değil mi?Dialogue: 0,0:11:26.80,0:11:27.99,Main,,0,0,0,,Sen...Dialogue: 0,0:11:28.32,0:11:31.58,Flashbacks,,0,0,0,,Baba! Çıkar beni!Dialogue: 0,0:11:32.88,0:11:34.88,Main,,0,0,0,,...çok acı çektin.Dialogue: 0,0:11:43.34,0:11:47.56,Flashbacks,,0,0,0,,Baba! Çok karanlık!Dialogue: 0,0:11:54.54,0:11:58.23,Thoughts,,0,0,0,,Ona karşı sadece kinin var.Dialogue: 0,0:12:07.83,0:12:10.08,Main,,0,0,0,,Çekilin be!Dialogue: 0,0:13:01.61,0:13:04.26,Main,,0,0,0,,Turp gibisin. Çok şaşırdım.Dialogue: 0,0:13:08.35,0:13:13.02,Main,,0,0,0,,Bizim güçsüz Sanji olduğuna inanamıyorum.Dialogue: 0,0:13:13.02,0:13:14.82,Main,,0,0,0,,Hala zırvalıyorsun.Dialogue: 0,0:13:14.82,0:13:17.60,Main,,0,0,0,,Şu çay partisine katılıp gitmek istiyorum hemen.Dialogue: 0,0:13:17.60,0:13:21.03,Main,,0,0,0,,O zaman Big Mom'un lanet davetinden de kurtulmuş olacağım.Dialogue: 0,0:13:21.53,0:13:26.20,Main,,0,0,0,,Azıcık değişmiş olabileceğini düşünmüştüm ama daha da kötü olmuşsun!Dialogue: 0,0:13:26.20,0:13:29.99,Main,,0,0,0,,Çık bu odadan babalık! Benim için bir yabancıdan ibaretsin!Dialogue: 0,0:13:29.99,0:13:35.41,Main,,0,0,0,,Hayır, damarlarında benim kanım akıyor.Dialogue: 0,0:13:35.41,0:13:39.08,Main,,0,0,0,,Beni yanlış anlama. Tüm Germa askerleri...Dialogue: 0,0:13:39.08,0:13:46.80,Main,,0,0,0,,...Vinsmoke Ailesi için bir an bile düşünmeyen, ölmeye gönüllü kişilerdir.Dialogue: 0,0:13:46.80,0:13:50.97,Main,,0,0,0,,Onlar Germa'nın en büyük askeri gücüdür!Dialogue: 0,0:13:53.36,0:13:58.35,Main,,0,0,0,,Öyleyse o aptal hayalini neden onlarla gerçekleştirmiyorsun?Dialogue: 0,0:13:58.35,0:14:04.10,Main,,0,0,0,,Kuzey Mavi'yi fethetmek mi? Harika. Kötü bir örgüt için mükemmel.Dialogue: 0,0:14:04.10,0:14:07.65,Main,,0,0,0,,Hızlı kavrıyorsun. Aynen öyle.Dialogue: 0,0:14:07.65,0:14:09.86,Main,,0,0,0,,Big Mom'la güçlerimizi birleştirince...Dialogue: 0,0:14:09.86,0:14:12.62,Main,,0,0,0,,...bunu başarmam kesin olacak!Dialogue: 0,0:14:12.62,0:14:15.87,Main,,0,0,0,,Kesinlikle başarabileceğim bir şey olacak!Dialogue: 0,0:14:18.46,0:14:23.00,Main,,0,0,0,,Anladıysan diyecek bir şeyim kalmamış demektir.Dialogue: 0,0:14:23.89,0:14:28.43,Main,,0,0,0,,Bu işi seninle güzel bir şekilde halletmek isterdim ama...Dialogue: 0,0:14:32.10,0:14:37.60,Main,,0,0,0,,...Big Mom'un yardımına ihtiyacım varken kan bağı gerekiyor.Dialogue: 0,0:14:37.60,0:14:39.78,Main,,0,0,0,,Sadece bir evlilik olsa da...Dialogue: 0,0:14:39.78,0:14:45.11,Main,,0,0,0,,...değerli oğullarımı öyle çılgın birisinin kızıyla evlendiremezdim!Dialogue: 0,0:14:46.61,0:14:51.88,Main,,0,0,0,,Sonra başka bir oğlum olduğunu hatırladım.Dialogue: 0,0:14:51.88,0:14:54.24,Main,,0,0,0,,Tam bir yüz karası olan.Dialogue: 0,0:14:55.45,0:14:59.23,Main,,0,0,0,,Sen kurbansın Sanji.Dialogue: 0,0:14:59.23,0:15:02.02,Main,,0,0,0,,Ben hiç değişmedim.Dialogue: 0,0:15:02.02,0:15:06.92,Main,,0,0,0,,Seni azıcık bile oğlum olarak görmüyorum.Dialogue: 0,0:15:11.31,0:15:13.47,Main,,0,0,0,,Bunlar da ne be?Dialogue: 0,0:15:13.47,0:15:16.16,Main,,0,0,0,,Ellerinin önemli olduğunu söylemiştin.Dialogue: 0,0:15:16.16,0:15:17.77,Main,,0,0,0,,Harika o zaman.Dialogue: 0,0:15:18.39,0:15:23.01,Main,,0,0,0,,Kutsal Ejderler'in kölelere taktığı boyun kelepçelerini biliyor musun?Dialogue: 0,0:15:23.61,0:15:28.32,Main,,0,0,0,,Efendilerinden kaçmaya çalışırlarsa kafalarını patlatıyor.Dialogue: 0,0:15:28.80,0:15:30.88,Main,,0,0,0,,Bu da aynı şekilde çalışıyor.Dialogue: 0,0:15:30.88,0:15:34.95,Main,,0,0,0,,Bu adadan kaçmaya çalışırsan ellerin patlayacak.Dialogue: 0,0:15:35.45,0:15:37.79,Main,,0,0,0,,Saçmalama be! Çıkar şunu!Dialogue: 0,0:15:37.79,0:15:41.46,Main,,0,0,0,,Big Mom öngörüsüyle bunları bana ödünç verdi.Dialogue: 0,0:15:41.46,0:15:44.13,Main,,0,0,0,,Anahtar onda.Dialogue: 0,0:15:44.13,0:15:45.79,Main,,0,0,0,,Ne?!Dialogue: 0,0:15:49.34,0:15:51.00,Main,,0,0,0,,Çek elini.Dialogue: 0,0:15:54.65,0:15:57.93,Main,,0,0,0,,Çıkarmaya çalışamazsın.Dialogue: 0,0:15:57.93,0:16:02.85,Main,,0,0,0,,Çıkarmanın tek yolu anahtarı kullanmak tabii ki.Dialogue: 0,0:16:05.32,0:16:08.07,Main,,0,0,0,,Kaçamazsın.Dialogue: 0,0:16:08.07,0:16:10.36,Main,,0,0,0,,Gerçi zaten...Dialogue: 0,0:16:10.91,0:16:15.12,Main,,0,0,0,,...Germa olarak da kaçmana izin vermeyiz!Dialogue: 0,0:16:18.08,0:16:20.91,Main,,0,0,0,,Evlenmek zorundasın!Dialogue: 0,0:16:25.88,0:16:29.34,Captions,,0,0,0,,Başkent Civarında Bir Yerler - Tatlı ŞehriDialogue: 0,0:16:25.89,0:16:29.34,Main,,0,0,0,,Özel baskı! Özel baskı!Dialogue: 0,0:16:29.34,0:16:32.05,Main,,0,0,0,,Patron Jinbe ihanet mi etti?Dialogue: 0,0:16:32.05,0:16:35.05,Main,,0,0,0,,Dün o ve Mama arasında bunlar mı yaşanmış?Dialogue: 0,0:16:36.31,0:16:42.31,Main,,0,0,0,,Patron Jinbe Mama'nın öfke krizini durduğunda çok havalıydı halbuki.Dialogue: 0,0:16:42.31,0:16:45.56,Main,,0,0,0,,Ayrılmak istediğini söylemiş ama...Dialogue: 0,0:16:45.56,0:16:49.28,Main,,0,0,0,,...karşılığını ödemek söz konusu olunca korkup caymış.Dialogue: 0,0:16:49.28,0:16:52.20,Main,,0,0,0,,Öyle mi? Zavallı şey.Dialogue: 0,0:16:53.08,0:16:54.78,Main,,0,0,0,,Tam bir ezik!Dialogue: 0,0:16:54.78,0:16:58.74,Main,,0,0,0,,Bir de "Denizin İlk Oğlu" diyorlar. Saygısını kaybetti.Dialogue: 0,0:16:58.74,0:17:02.04,Main,,0,0,0,,Artık hem hain hem de korkak.Dialogue: 0,0:17:05.92,0:17:07.46,Thoughts,,0,0,0,,Jinbe-san...Dialogue: 0,0:17:07.46,0:17:10.84,Thoughts,,0,0,0,,...Big Mom'a çalışıyordun demek.Dialogue: 0,0:17:10.84,0:17:14.63,Thoughts,,0,0,0,,Bu yüzden Balık Adam Adası,  Big Mom tarafından korunuyordu yani.Dialogue: 0,0:17:16.24,0:17:20.72,Main,,0,0,0,,Jinbe mi? Eski Shichibukai değil mi?Dialogue: 0,0:17:20.72,0:17:23.18,Main,,0,0,0,,Astlarından birisi olduğuna inanamıyorum.Dialogue: 0,0:17:23.18,0:17:26.28,Main,,0,0,0,,Brook, bu adamı tanıyor musun?Dialogue: 0,0:17:26.28,0:17:30.61,Main,,0,0,0,,Evet, bizim için çok önemli birisidir.Dialogue: 0,0:17:30.61,0:17:36.40,Flashbacks,,0,0,0,,Görevimi tamamlayıp,  tekrardan özgür kaldığımda...Dialogue: 0,0:17:36.40,0:17:42.08,Flashbacks,,0,0,0,,...umarım beni yeniden  Hasır Şapka Korsanları'na davet edersiniz!!!Dialogue: 0,0:17:42.16,0:17:46.65,Thoughts,,0,0,0,,Sanırım o gün tayfaya katılma teklifini reddetmesinin sebebi...Dialogue: 0,0:17:46.65,0:17:50.54,Thoughts,,0,0,0,,...Big Mom'a karşı olan görevini yerine getirmek istemesiydi.Dialogue: 0,0:17:51.59,0:17:56.36,Thoughts,,0,0,0,,Bu arada bu hiç de Jinbe-san'ın yapacağı bir şeye benzemiyor.Dialogue: 0,0:17:56.36,0:17:59.28,Thoughts,,0,0,0,,Bizi tekrar görmeye gelmeyecek mi ki?Dialogue: 0,0:17:59.28,0:18:01.59,Main,,0,0,0,,Hey, Brook!Dialogue: 0,0:18:03.99,0:18:06.95,Main,,0,0,0,,Lütfen! Bir yere gitmem gerek!Dialogue: 0,0:18:06.95,0:18:11.24,Main,,0,0,0,,Şu an kıyafet seçmenizden daha önemli bir şey yok.Dialogue: 0,0:18:11.24,0:18:14.48,Main,,0,0,0,,Çocukluk yapmayın-s'il vous plait, Pudding-sama.Dialogue: 0,0:18:14.48,0:18:15.71,Main,,0,0,0,,Ama...Dialogue: 0,0:18:15.71,0:18:17.74,Main,,0,0,0,,Pudding-sama!Dialogue: 0,0:18:17.74,0:18:19.70,Main,,0,0,0,,Bu elbise nasıl?Dialogue: 0,0:18:19.70,0:18:21.33,Main,,0,0,0,,Ya çok yakıştı!Dialogue: 0,0:18:21.33,0:18:26.29,Main,,0,0,0,,Bu elbise nasıl? Tahmin ettiğim gibi çok güzel oldunuz Pudding-sama.Dialogue: 0,0:18:26.29,0:18:29.50,Main,,0,0,0,,Her şey çok yakışıyor size.Dialogue: 0,0:18:29.50,0:18:32.06,Main,,0,0,0,,Hangisini beğendiniz Pudding-sama?Dialogue: 0,0:18:32.06,0:18:33.35,Main,,0,0,0,,Şey...Dialogue: 0,0:18:33.35,0:18:36.71,Main,,0,0,0,,Pudding-sama, damat bey nasıl şeyler seviyor biliyor musunuz?Dialogue: 0,0:18:36.71,0:18:40.61,Main,,0,0,0,,Ne?! Daha tanışmadık ki biz.Dialogue: 0,0:18:40.61,0:18:42.30,Main,,0,0,0,,Neeee?!Dialogue: 0,0:18:42.30,0:18:46.11,Main,,0,0,0,,Dursana Pudding-san, neler oluyor burada?!Dialogue: 0,0:18:46.11,0:18:49.56,Main,,0,0,0,,Sanırım hizmetliler tarafından yakalanmış.Dialogue: 0,0:18:49.56,0:18:52.54,Main,,0,0,0,,Pudding-san şimdiye kadar Sanji-san'ı dışarıya çıkarıp...Dialogue: 0,0:18:52.54,0:18:55.70,Main,,0,0,0,,...Luffy-san'larla buluşturduğunu düşünüyordum.Dialogue: 0,0:18:55.70,0:19:00.29,Main,,0,0,0,,Şu an Sanji bizim burada olduğumuzu bile bilmiyordur eminim.Dialogue: 0,0:19:00.29,0:19:03.95,Main,,0,0,0,,Öyleyse Luffy-san'ın kıyıda gördüğü kişi kimdi?Dialogue: 0,0:19:03.95,0:19:08.79,Main,,0,0,0,,Bilmiyorum. Belki de başka birisini görmüştür.Dialogue: 0,0:19:11.46,0:19:16.89,Main,,0,0,0,,O... Yanılmıyorsam Big Mom'un gemisindeydi o.Dialogue: 0,0:19:16.89,0:19:19.17,Main,,0,0,0,,Evet, ben de onu tanıyorum.Dialogue: 0,0:19:19.17,0:19:21.43,Main,,0,0,0,,Baron Tamago!Dialogue: 0,0:19:24.83,0:19:28.45,Main,,0,0,0,,Baron Tamago, konuşabilir miyim?Dialogue: 0,0:19:33.96,0:19:36.27,Main,,0,0,0,,Ne vardı-soir?Dialogue: 0,0:19:36.27,0:19:40.24,Main,,0,0,0,,Dün Çikolata Şehri'nde demirleyen Hasar Şapkalar'ın gemisi...Dialogue: 0,0:19:40.32,0:19:43.16,Thoughts,,0,0,0,,Öğrenmişler!Dialogue: 0,0:19:43.16,0:19:50.33,Main,,0,0,0,,...ayrıldığında onlara rehberlik eden Pekoms'un da gittiği söyleniyor.Dialogue: 0,0:19:50.33,0:19:52.62,Thoughts,,0,0,0,,Her şeyi biliyorlar!Dialogue: 0,0:19:52.62,0:19:57.89,Main,,0,0,0,,Ayrıca Hasır Şapkalar'dan 4 kişi  Ayartan Orman'da dolanıyor bugün.Dialogue: 0,0:19:56.26,0:20:01.72,Note,,0,0,0,,Carrot'un posterinde "Tavşan Mink" yazıyor.Dialogue: 0,0:19:57.89,0:20:01.72,Main,,0,0,0,,Köşeye sıkıştılar bile. Yakalanmaları an meselesi.Dialogue: 0,0:20:01.72,0:20:05.51,Thoughts,,0,0,0,,Luffy-san'lar yakalanmış mı?!Dialogue: 0,0:20:05.51,0:20:08.77,Main,,0,0,0,,Ama kalan 2 kişiyi hala bulamadık.Dialogue: 0,0:20:08.77,0:20:10.93,Note,,0,0,0,,Pedro'nun posterinde "Leopar Mink" yazıyor.Dialogue: 0,0:20:08.77,0:20:10.93,Main,,0,0,0,,Bunlar.Dialogue: 0,0:20:10.98,0:20:13.94,Thoughts,,0,0,0,,Biziz!Dialogue: 0,0:20:13.94,0:20:17.52,Main,,0,0,0,,Her şey sızdırılmış! Baştan sona her şeyi biliyorlar!Dialogue: 0,0:20:17.52,0:20:20.28,Main,,0,0,0,,Yerin kulağı vardır olayı mı?!Dialogue: 0,0:20:20.28,0:20:24.36,Main,,0,0,0,,O mink leopar değil-soir.Dialogue: 0,0:20:24.87,0:20:28.53,Main,,0,0,0,,Jaguar olan bir Mink. Adı Pedro.Dialogue: 0,0:20:29.08,0:20:30.50,Main,,0,0,0,,Tanıyor musunuz?Dialogue: 0,0:20:31.06,0:20:34.29,Main,,0,0,0,,Geçmişte biraz tanışmışlığımız var.Dialogue: 0,0:20:37.65,0:20:43.84,Main,,0,0,0,,Aklından geçenleri bilirim onun-feuille.Dialogue: 0,0:20:43.84,0:20:48.39,Main,,0,0,0,,- Neyse siz Pekoms'u arayın. - Baş üstüne!Dialogue: 0,0:20:50.83,0:20:55.66,Main,,0,0,0,,Pekoms. Hayatta olduğundan-bon...Dialogue: 0,0:20:55.66,0:20:58.14,Main,,0,0,0,,...uzun süreli arkadaşlığımız hatırına...Dialogue: 0,0:20:58.14,0:21:02.65,Main,,0,0,0,,...seninle birlikte Mama'dan özür dileyecektim.Dialogue: 0,0:21:04.76,0:21:07.95,Main,,0,0,0,,Başıma çok dert açtın-marron.Dialogue: 0,0:21:07.95,0:21:12.79,Thoughts,,0,0,0,,Başımız büyük dertte!Dialogue: 0,0:21:12.79,0:21:16.92,Captions,,0,0,0,,Whole Cake Adası'nın Kuzeydoğu KıyısıDialogue: 0,0:21:15.60,0:21:18.46,Main,,0,0,0,,Kes sesini ufaklık.Dialogue: 0,0:21:18.46,0:21:20.84,Main,,0,0,0,,Sessiz...Dialogue: 0,0:21:20.86,0:21:22.48,Main,,0,0,0,,...ol!Dialogue: 0,0:21:26.34,0:21:30.22,Main,,0,0,0,,Güldü. Çok şükür.Dialogue: 0,0:21:26.34,0:21:30.22,Captions,,0,0,0,,Charlotte Chiffon – Bege'nin Eşi Charlotte Ailesi'nin 22. KızıDialogue: 0,0:21:30.22,0:21:33.10,Captions,,0,0,0,,Capone "Gang" Pez - Bege'nin OğluDialogue: 0,0:21:33.10,0:21:38.10,Main,,0,0,0,,Güzel, güzel, güzel, güzel! Ne güzel çocuksun sen öyle!Dialogue: 0,0:21:33.10,0:21:38.10,Captions,,0,0,0,,Capone "Gang" Bege Ateş Tankı KorsanlarıDialogue: 0,0:21:38.10,0:21:43.99,Main,,0,0,0,,Hey, ufaklık. Umarım sen de bir gün benim gibi büyük bir patron olursun.Dialogue: 0,0:21:46.36,0:21:49.12,Main,,0,0,0,,Gözlerim kanıyor be.Dialogue: 0,0:21:49.97,0:21:52.51,Main,,0,0,0,,Büyüleyici değil mi?Dialogue: 0,0:21:52.51,0:21:55.54,Main,,0,0,0,,Yeni doğdu.Dialogue: 0,0:21:55.54,0:21:58.62,Main,,0,0,0,,Sen ise öleceksin.Dialogue: 0,0:22:00.11,0:22:05.63,Main,,0,0,0,,Muhteşem bir tezat değil mi? Sanki tablo gibi.Dialogue: 0,0:22:07.01,0:22:10.65,Main,,0,0,0,,Bunu sen istedin.Dialogue: 0,0:22:10.65,0:22:13.85,Main,,0,0,0,,Pekoms, sana bir şans vermiştim.Dialogue: 0,0:22:13.85,0:22:17.85,Main,,0,0,0,,Bana pek şans gibi gelmemişti.Dialogue: 0,0:22:17.85,0:22:20.56,Main,,0,0,0,,Zou'da olanları hatırlasana.Dialogue: 0,0:22:20.56,0:22:24.19,Main,,0,0,0,,Empati işe yaramaz bir boktur.Dialogue: 0,0:22:25.99,0:22:30.78,Main,,0,0,0,,Sen bu işe uygun değilsin.Dialogue: 0,0:22:31.45,0:22:36.83,Main,,0,0,0,,Burası birisinden kurtulmak için harika bir yer.Dialogue: 0,0:22:43.46,0:22:45.55,Main,,0,0,0,,Son sözün var mı?Dialogue: 0,0:23:11.24,0:23:14.62,Main,,0,0,0,,Mama'yı çok hafife alıyorsunuz!Dialogue: 0,0:23:51.11,0:23:53.87,Flashbacks,,0,0,0,,Hadi, göster ellerini.Dialogue: 0,0:23:55.53,0:23:57.54,Flashbacks,,0,0,0,,Yara bere olmuş hep.Dialogue: 0,0:24:06.37,0:24:08.25,Flashbacks,,0,0,0,,Velet.Dialogue: 0,0:24:08.80,0:24:10.59,Flashbacks,,0,0,0,,Acıdı!Dialogue: 0,0:24:16.06,0:24:17.97,Flashbacks,,0,0,0,,Derdin ne be lanet moruk?!Dialogue: 0,0:24:17.97,0:24:22.19,Flashbacks,,0,0,0,,Ellerin dövüşmek için mi senin?!Dialogue: 0,0:24:35.19,0:24:37.56,Main,,0,0,0,,Lanet olsun!Dialogue: 0,0:24:39.58,0:24:42.54,Captions,,0,0,0,,Whole Cake KalesiDialogue: 0,0:24:48.13,0:24:52.59,Captions,,0,0,0,,Kraliçenin HuzuruDialogue: 0,0:24:52.59,0:24:58.89,Main,,0,0,0,,Sanırım yeterince para verdim, Caesar Clown.Dialogue: 0,0:24:58.89,0:25:04.10,Main,,0,0,0,,E-E-E-E-Evet. Elbette araştırmayı kesmedim ben de.Dialogue: 0,0:25:04.70,0:25:07.21,Main,,0,0,0,,Hayalim...Dialogue: 0,0:25:22.37,0:25:27.00,Main,,0,0,0,,...dünyanın tüm ırklarının bir aile olup...Dialogue: 0,0:25:27.00,0:25:31.57,Main,,0,0,0,,...aynı yemek masasında göz hizasında oturması.Dialogue: 0,0:25:31.57,0:25:34.67,Main,,0,0,0,,Benim içtiğimi içip...Dialogue: 0,0:25:36.26,0:25:39.97,Main,,0,0,0,,...benim yediğimi yiyecekler!Dialogue: 0,0:25:47.81,0:25:50.82,Main,,0,0,0,,Harika bir hayal değil mi?!Dialogue: 0,0:25:50.82,0:25:55.28,Main,,0,0,0,,Bunu benim için gerçekleştirecek kişi ise sensin Caesar!Dialogue: 0,0:25:57.16,0:26:03.50,Main,,0,0,0,,Bilimin gücüyle aile üyelerimi dev boyutuna getirmek istiyorum.Dialogue: 0,0:26:03.50,0:26:06.89,Main,,0,0,0,,Sürekli tekrar ettiğin gibi...Dialogue: 0,0:26:06.89,0:26:13.50,Main,,0,0,0,,...araştırmalarını bitirmek üzereymişsin ama az daha araştırma parasına ihtiyacın varmış.Dialogue: 0,0:26:13.50,0:26:17.32,Main,,0,0,0,,Ben de heyecanla çok para döktüm sana.Dialogue: 0,0:26:17.32,0:26:20.09,Main,,0,0,0,,Sonuç ne peki?Dialogue: 0,0:26:20.09,0:26:24.18,Main,,0,0,0,,Sayende oldukça iyiler!Dialogue: 0,0:26:24.96,0:26:29.41,Thoughts,,0,0,0,,İnsan bedenini devleştirme. Evet deneyleri yaptım.Dialogue: 0,0:26:29.41,0:26:33.46,Thoughts,,0,0,0,,Tüm dünya da zaten bu teknolojiyi arıyor.Dialogue: 0,0:26:33.46,0:26:39.34,Thoughts,,0,0,0,,Ama çocukları deve dönüştürme deneylerim ölümcüldü.Dialogue: 0,0:26:39.34,0:26:43.72,Thoughts,,0,0,0,,Bu moruğun istediği gibi büyülü bir şekilde insanları deve dönüştürecek...Dialogue: 0,0:26:43.72,0:26:47.08,Thoughts,,0,0,0,,...bir ilaç yapması imkansızdır.Dialogue: 0,0:26:47.08,0:26:51.38,Thoughts,,0,0,0,,Bu yüzden tüm parayı çarçur edip...Dialogue: 0,0:26:55.05,0:26:58.10,Thoughts,,0,0,0,,...her geceye adaya kız çağırdım...Dialogue: 0,0:26:58.10,0:27:02.99,Thoughts,,0,0,0,,...ve tüm paramı içki ve kadına harcadım.Dialogue: 0,0:27:05.99,0:27:11.86,Thoughts,,0,0,0,,Ne güzel günlerdi ama! Sırtımı Joker'e dayayarak çılgınlıklar yapıyordum!Dialogue: 0,0:27:11.86,0:27:13.06,Note,,0,0,0,,Doflamingo Düştü!Dialogue: 0,0:27:13.15,0:27:16.48,Thoughts,,0,0,0,,Joker'in yenileceğini tahmin etmemiştim.Dialogue: 0,0:27:23.07,0:27:27.20,Thoughts,,0,0,0,,Ve de hayatımın sefil bir hal alacağını!Dialogue: 0,0:27:27.20,0:27:32.33,Thoughts,,0,0,0,,Lanet olsun! Her şey düzgünce gidiyordu!Dialogue: 0,0:27:32.33,0:27:35.25,Thoughts,,0,0,0,,Hepsi onun yüzünden...Dialogue: 0,0:27:35.25,0:27:37.26,Main,,0,0,0,,Mimik oyunu mu yapıyorsun?Dialogue: 0,0:27:38.91,0:27:40.34,Main,,0,0,0,,H-Hayır.Dialogue: 0,0:27:40.34,0:27:46.06,Main,,0,0,0,,O! Bu! Ve de her şey! Hepsi Hasar Şapkalı Luffy'nin suçu!Dialogue: 0,0:27:46.06,0:27:50.98,Main,,0,0,0,,Big Mom! Uyumadan  gece gündüz araştırma yapıyordum!Dialogue: 0,0:27:50.98,0:27:54.44,Main,,0,0,0,,Tam tamamlanacaktı ki...Dialogue: 0,0:27:54.44,0:27:58.69,Main,,0,0,0,,...Hasır Şapka ve Trafalgar Law ortaya çıktı!Dialogue: 0,0:28:05.62,0:28:10.54,Main,,0,0,0,,Onlar olmasa devleştirme ilacı tamamlanacaktı!Dialogue: 0,0:28:10.54,0:28:13.42,Main,,0,0,0,,Dahiyim sonuçta!Dialogue: 0,0:28:14.46,0:28:17.58,Main,,0,0,0,,Dünya Hükümeti tarafından yapılmış yüksek teknolojili laboratuvarın...Dialogue: 0,0:28:17.58,0:28:20.17,Main,,0,0,0,,...yok edilmesi çok yazık gerçekten!Dialogue: 0,0:28:20.17,0:28:24.72,Main,,0,0,0,,Sadece öyle bir yerde düzgün sonuç alabilirim!Dialogue: 0,0:28:26.53,0:28:31.73,Main,,0,0,0,,Verdiğiniz o kadar para ve laboratuvar...Dialogue: 0,0:28:31.73,0:28:38.44,Main,,0,0,0,,Onlar olmadığı için artık devleştirme ilacı yapamam!Dialogue: 0,0:28:38.44,0:28:41.28,Main,,0,0,0,,Yapamam!Dialogue: 0,0:28:53.02,0:28:57.79,Main,,0,0,0,,Punk Hazard'daki laboratuvarın aynısını yaptırdım.Dialogue: 0,0:28:57.79,0:28:58.84,Main,,0,0,0,,Ne?!Dialogue: 0,0:28:58.84,0:29:02.09,Main,,0,0,0,,Planları uzun zamandır elimdeydi.Dialogue: 0,0:29:02.09,0:29:08.22,Main,,0,0,0,,Şeker bakanımız şekerden her şeyi yapabilir.Dialogue: 0,0:29:08.22,0:29:12.19,Main,,0,0,0,,Araştırma için istediğin kadar para da harcayabilirsin.Dialogue: 0,0:29:12.19,0:29:13.77,Main,,0,0,0,,Ne?!Dialogue: 0,0:29:13.77,0:29:16.94,Main,,0,0,0,,E-E-E-E-Emin misiniz?Dialogue: 0,0:29:16.94,0:29:20.28,Main,,0,0,0,,Yani memnuniyetle!Dialogue: 0,0:29:20.28,0:29:21.15,Main,,0,0,0,,Yani?Dialogue: 0,0:29:21.76,0:29:22.82,Main,,0,0,0,,Yani mi?Dialogue: 0,0:29:24.45,0:29:26.36,Main,,0,0,0,,Ne zaman hazır olacak?Dialogue: 0,0:29:29.28,0:29:33.25,Main,,0,0,0,,Bir hafta mı? 2 hafta mı?Dialogue: 0,0:29:37.63,0:29:40.96,Main,,0,0,0,,Sabırsızlanıyorum!Dialogue: 0,0:29:41.75,0:29:47.14,Thoughts,,0,0,0,,Saçmalama! İnsanoğlu yüzyıllardır bunu araştırıyor ama...Dialogue: 0,0:29:47.14,0:29:50.18,Thoughts,,0,0,0,,...kimse başaramadı!Dialogue: 0,0:29:55.35,0:29:58.02,Main,,0,0,0,,Yala! Yala!Dialogue: 0,0:29:58.02,0:30:01.52,Main,,0,0,0,,Beğendin mi, Caesar-kun?Dialogue: 0,0:30:04.03,0:30:07.20,Main,,0,0,0,,Çok gerçekçi olmamış mı?Dialogue: 0,0:30:07.20,0:30:12.62,Captions,,0,0,0,,Charlotte Perospero – Şeker Bakanı Charlotte Ailesi'nin En Büyük Oğlu Yala Yala Meyvesi Yemiş Şeker İnsanDialogue: 0,0:30:08.36,0:30:12.62,Main,,0,0,0,,İçerisi de aynı şekilde, yala.Dialogue: 0,0:30:17.29,0:30:19.00,Thoughts,,0,0,0,,Bu...Dialogue: 0,0:30:19.00,0:30:21.25,Thoughts,,0,0,0,,Yoksa... Yapma!Dialogue: 0,0:30:23.59,0:30:25.84,Main,,0,0,0,,Çok eğlenceli.Dialogue: 0,0:30:31.18,0:30:33.52,Thoughts,,0,0,0,,Lanet olsun!Dialogue: 0,0:30:35.98,0:30:38.90,Flashbacks,,0,0,0,,Whole Cake Adası'na vardık.Dialogue: 0,0:30:41.61,0:30:44.36,Flashbacks,,0,0,0,,Bekle! Kara Bacak!Dialogue: 0,0:30:44.36,0:30:47.74,Flashbacks,,0,0,0,,Gitmeden önce kalbimi geri ver!Dialogue: 0,0:30:49.61,0:30:50.70,Flashbacks,,0,0,0,,Doğru ya.Dialogue: 0,0:30:56.66,0:31:01.42,Main,,0,0,0,,Devleştirme ilacını yapmak için 2 haftan var.Dialogue: 0,0:31:01.42,0:31:07.55,Main,,0,0,0,,Olur da uzun sürerse seni şeker adama çevirip yalarım.Dialogue: 0,0:31:09.47,0:31:11.50,Thoughts,,0,0,0,,Öldürüleceğim! 2 haftaya öldürüleceğim!Dialogue: 0,0:31:11.50,0:31:14.22,Thoughts,,0,0,0,,Bir şeyler yapmalıyım!Dialogue: 0,0:31:14.22,0:31:16.14,Captions,,0,0,0,,Güneybatı Kıyısı, GeceDialogue: 0,0:31:20.73,0:31:24.69,Main,,0,0,0,,Defalarca gördüm yüzünüzü.Dialogue: 0,0:31:27.36,0:31:29.00,Main,,0,0,0,,Yine sen.Dialogue: 0,0:31:29.00,0:31:30.53,Main,,0,0,0,,Başka bir tane daha buldum.Dialogue: 0,0:31:33.70,0:31:36.90,Main,,0,0,0,,Çok fazla var.Dialogue: 0,0:31:52.13,0:31:54.70,Main,,0,0,0,,Ayrıca...Dialogue: 0,0:32:11.57,0:32:14.62,Main,,0,0,0,,Siz nasıl çoğaldınız be?!Dialogue: 0,0:32:14.62,0:32:19.70,Credits,,0,0,0,,Editing:  Feeso, Galaxy 9000  Timing: Halee  Quality Assurance: Feeso, Galaxy 9000, Grug, Pepperjack  Soundtracking:  Halee  Infoboxes & Title:  Datenshi  Karaoke: KaitouYahiko  Attack Effects: KaitouYahiko  Translation: CrunchyrollDialogue: 0,0:09:34.60,0:09:36.85,Attack,,0,0,0,karaoke,Şeytan BacakDialogue: 0,0:09:36.99,0:09:38.34,Attack,,0,0,0,karaoke,Boyun...Dialogue: 0,0:09:41.50,0:09:42.85,Attack,,0,0,0,karaoke,...VuruşuDialogue: 0,0:11:50.60,0:11:53.13,Attack,,0,0,0,karaoke,Kızartma TavasıDialogue: 0,0:10:00.50,0:10:03.03,Attack,,0,0,0,karaoke,Elektro