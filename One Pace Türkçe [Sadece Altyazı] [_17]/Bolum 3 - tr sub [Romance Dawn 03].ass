8,23,23,23,1Style: Lyrics-furigana,Duality,36,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,2.95,0,2,23,23,34,1Style: Lyrics,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,2,23,23,34,1Style: Karaoke,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,23,1Style: Kanji,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,146,1Style: Roger-Monologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1Style: Romaji ED,Josefin Sans,82,&H00FFFFFF,&H003592BE,&H00000000,&H64000000,0,0,0,0,100,100,0,0,1,0,4,8,10,10,20,1Style: Translation ED,Josefin Sans,82,&H00FFFFFF,&H000000FF,&H00FFFFFF,&H64000000,0,0,0,0,100,100,0,0,1,0,4,2,10,10,20,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Your media player does not support the subtitle format used in this episode. Subtitles will likely not function properly. Please use one of the recommended video players, preferably mpv: https://mpv.ioDialogue: 0,0:01:59.99,0:02:09.98,Warning,,0,0,0,,Your media player does not support the subtitle format used in this episode. Subtitles will likely not function properly. Please use one of the recommended video players, preferably mpv: https://mpv.ioDialogue: 55,0:00:04.35,0:00:05.86,Main-207-,,0,0,0,,Ne güzel hava var!Dialogue: 55,0:00:05.86,0:00:09.94,Main-207-,,0,0,0,,Bu yönde gitmeye devam edersek adayı birazdan görürüz!Dialogue: 55,0:00:09.94,0:00:12.83,Main-207-,,0,0,0,,Vaay Koby! Harikasın!Dialogue: 55,0:00:12.83,0:00:14.45,Main-207-,,0,0,0,,Gerçekten hedefimize varacak mıyız?Dialogue: 55,0:00:14.45,0:00:15.58,Main-207-,,0,0,0,,Tabii ki!Dialogue: 55,0:00:15.58,0:00:18.14,Main-207-,,0,0,0,,Denizciler en azından yön bulmayı bilmelidir!Dialogue: 55,0:00:20.42,0:00:23.04,Main-207-,,0,0,0,,Şuan gülmenin zamanı değil, Luffy-san.Dialogue: 55,0:00:23.04,0:00:25.38,Main-207-,,0,0,0,,Orada esir tutuluyor.Dialogue: 55,0:00:25.92,0:00:28.15,Main-207-,,0,0,0,,Şu meşhur Korsan Avcısı,...Dialogue: 55,0:00:29.05,0:00:31.34,Main-207-,,0,0,0,,...Roronoa Zoro!Dialogue: 55,0:00:34.64,0:00:40.46,Main-207-,,0,0,0,,Kana susamış bir canavar gibi ödülleri parçalayan adam...Dialogue: 55,0:00:41.90,0:00:45.42,Main-207-,,0,0,0,,Onun insan gibi görünen bir şeytan olduğu söyleniyor.Dialogue: 55,0:02:53.11,0:02:56.59,Main-207-,,0,0,0,,Vardık! Donanma şehri!Dialogue: 55,0:03:01.16,0:03:02.55,Main-207-,,0,0,0,,Hey, Luffy-san!Dialogue: 55,0:03:02.55,0:03:05.54,Main-207-,,0,0,0,,Yoldaşın olmasını istemek delilik!Dialogue: 55,0:03:05.54,0:03:08.57,Main-207-,,0,0,0,,Hala karar vermedim. Sadece iyi biri mi görmek istiyorum.Dialogue: 55,0:03:08.57,0:03:10.96,Main-207-,,0,0,0,,Kötü bir adam olduğu için yakalandı!Dialogue: 55,0:03:14.24,0:03:15.65,Main-207-,,0,0,0,,Mmm! Nefis!Dialogue: 55,0:03:16.33,0:03:19.18,Main-207-,,0,0,0,,Peki bu Zoro denen adam üste mi?Dialogue: 55,0:03:24.56,0:03:27.40,Main-207-,,0,0,0,,"Zoro" ismi buralarda tabu olmuş gibi görünüyor.Dialogue: 55,0:03:28.21,0:03:29.88,Main-207-,,0,0,0,,Neyse, yine de üssü kontrol edelim!Dialogue: 55,0:03:29.88,0:03:31.65,Main-207-,,0,0,0,,Denizci olacaksın, değil mi?Dialogue: 55,0:03:31.65,0:03:35.61,Main-207-,,0,0,0,,E-evet... Ama henüz hazır değilim.Dialogue: 55,0:03:35.61,0:03:39.36,Main-207-,,0,0,0,,Söylentilere göre Yüzbaşı Morgan adında biri bu üsteymiş ve...Dialogue: 55,0:03:45.91,0:03:48.12,Main-207-,,0,0,0,,Ne eğlenceli bir kasaba!Dialogue: 55,0:03:48.12,0:03:49.32,Main-207-,,0,0,0,,Garip...Dialogue: 55,0:03:49.32,0:03:52.92,Main-207-,,0,0,0,,Zoro'yu anlıyorum, ama neden bir Donanma Yüzbaşısı'nın adından korkuyorlar?Dialogue: 55,0:03:53.92,0:03:56.84,Main-207-,,0,0,0,,Bu beni birdenbire huzursuz etti...Dialogue: 55,0:03:56.84,0:03:59.34,Main-207-,,0,0,0,,Öyle eğlencesine yapmadıklarına emin misin?Dialogue: 55,0:03:59.34,0:04:00.92,Main-207-,,0,0,0,,Kimse öyle bir şey yapmaz!Dialogue: 55,0:04:02.87,0:04:04.39,Main-207-,,0,0,0,,Tamamdır! Geldik!Dialogue: 55,0:04:05.22,0:04:07.55,Main-207-,,0,0,0,,Sonunda başardım!Dialogue: 55,0:04:08.38,0:04:10.76,Main-207-,,0,0,0,,Sanırım burada ayrılıyoruz, Luffy-san.Dialogue: 55,0:04:10.76,0:04:12.65,Main-207-,,0,0,0,,Çok kısa bir süreydi, fakat...Dialogue: 55,0:04:12.65,0:04:13.27,Main-207-,,0,0,0,,Ha?Dialogue: 55,0:04:13.27,0:04:14.41,Main-207-,,0,0,0,,Gidiyoruz!Dialogue: 55,0:04:14.41,0:04:16.65,Main-207-,,0,0,0,,Yahu, Luffy-san! Ne yapıyorsun?!Dialogue: 55,0:04:17.03,0:04:19.36,Main-207-,,0,0,0,,Şimdi, nerede bu şeytan?Dialogue: 55,0:04:19.61,0:04:21.74,Main-207-,,0,0,0,,Böyle dışarıda olamaz.Dialogue: 55,0:04:21.74,0:04:23.91,Main-207-,,0,0,0,,Kesin bir hücrede falandır.Dialogue: 55,0:04:23.91,0:04:24.95,Main-207-,,0,0,0,,İşte orada!Dialogue: 55,0:04:24.95,0:04:26.20,Main-207-,,0,0,0,,Mükemmel!Dialogue: 55,0:04:29.08,0:04:29.96,Main-207-,,0,0,0,,Bak! Orada!Dialogue: 55,0:04:29.96,0:04:32.21,Main-207-,,0,0,0,,Açıkta olması imkan–Dialogue: 55,0:04:38.01,0:04:41.36,Thoughts-207-,,0,0,15,,Siyah bandana... haramaki...Dialogue: 55,0:04:38.01,0:04:41.36,Note-207-,,0,0,15,,Haramaki: Karnı örten bir Japon kıfayetiDialogue: 55,0:04:43.13,0:04:46.27,Thoughts-207-,,0,0,0,,Bu R-Roronoa Zoro!Dialogue: 55,0:04:46.27,0:04:48.94,Main-207-,,0,0,0,,Şu ipleri çözersek kolayca kaçabilir!Dialogue: 55,0:04:48.94,0:04:53.02,Main-207-,,0,0,0,,S-Salak olma! Onu serbest bırakırsak ne olacağını kimse bilemez!Dialogue: 55,0:04:53.02,0:04:56.19,Main-207-,,0,0,0,,Eminim seni de öldürmeye çalışır, Luffy-san!Dialogue: 55,0:04:56.19,0:04:58.19,Main-207-,,0,0,0,,Endişelenme! Ben güçlüyüm.Dialogue: 55,0:04:58.19,0:05:00.66,Thoughts-207-,,0,0,0,,Bu adam ciddi mi?!Dialogue: 55,0:05:01.18,0:05:02.51,Main-207-,,0,0,0,,Hey, siz.Dialogue: 55,0:05:04.20,0:05:06.33,Main-207-,,0,0,0,,Göze batıyorsunuz.Dialogue: 55,0:05:08.16,0:05:09.16,Main-207-,,0,0,0,,Kaybolun!Dialogue: 55,0:05:10.37,0:05:14.04,Main-207-,,0,0,0,,Luffy-san! O tayfana katılırsa işin biter!Dialogue: 55,0:05:24.47,0:05:27.31,Main-207-,,0,0,0,,Aman! Luffy-san, lütfen onu durdur!Dialogue: 55,0:05:27.31,0:05:29.05,Main-207-,,0,0,0,,Kendini öldürtecek!Dialogue: 55,0:05:30.32,0:05:31.12,Main-207-,,0,0,0,,Ne var?Dialogue: 55,0:05:31.12,0:05:35.07,Main-207-,,0,0,0,,Aç olmalısın! Senin için biraz pirinç topu yaptım.Dialogue: 55,0:05:35.07,0:05:37.85,Main-207-,,0,0,0,,Ölmek mi istiyorsun, ufaklık? Kaybol!Dialogue: 55,0:05:37.85,0:05:40.40,Main-207-,,0,0,0,,Bayım, bunca zaman hiçbir şey yemedin.Dialogue: 55,0:05:40.89,0:05:46.33,Main-207-,,0,0,0,,Buyur! Bu benim ilk denemem, yapmak için gerçekten çok çalıştım.Dialogue: 55,0:05:47.99,0:05:49.87,Main-207-,,0,0,0,,Aç değilim!Dialogue: 55,0:05:49.87,0:05:52.00,Main-207-,,0,0,0,,Hadi, beni rahatsız etme ve git!Dialogue: 55,0:05:51.37,0:05:52.00,Secondary-207-,,0,0,0,,A-Ama...Dialogue: 55,0:05:52.00,0:05:54.40,Main-207-,,0,0,0,,Onları istemiyorum! Beni sinirlendirme!Dialogue: 55,0:05:55.17,0:05:57.38,Main-207-,,0,0,0,,Küçük kızlara mı sataşıyorsun?Dialogue: 55,0:06:00.62,0:06:02.88,Main-207-,,0,0,0,,Şaşırtıcı derecede iyi görünüyorsun,...Dialogue: 55,0:06:02.90,0:06:04.22,Main-207-,,0,0,0,,...Roronoa Zoro.Dialogue: 55,0:06:04.51,0:06:06.72,Main-207-,,0,0,0,,Başka garip biri daha mı?Dialogue: 55,0:06:06.72,0:06:07.88,Main-207-,,0,0,0,,Şükürler olsun!Dialogue: 55,0:06:07.88,0:06:11.10,Main-207-,,0,0,0,,Donanmadan olmalı! Şimdi küçük kız güvende olacak!Dialogue: 55,0:06:11.71,0:06:15.08,Main-207-,,0,0,0,,Oh? O pirinç topları lezzetli görünüyor.Dialogue: 55,0:06:15.08,0:06:16.13,Main-207-,,0,0,0,,Dur...!Dialogue: 55,0:06:18.68,0:06:19.40,Main-207-,,0,0,0,,Çok tatlı!Dialogue: 55,0:06:19.90,0:06:21.40,Main-207-,,0,0,0,,Bunlar şeker dolu!Dialogue: 55,0:06:21.40,0:06:23.52,Main-207-,,0,0,0,,Pirinç toplarına tuz koyulur! TUZ!Dialogue: 55,0:06:23.78,0:06:26.87,Main-207-,,0,0,0,,Ama tatlı daha lezzetli olur diye düşünmüştüm.Dialogue: 55,0:06:27.77,0:06:30.41,Main-207-,,0,0,0,,Al sana! Al! Al!Dialogue: 55,0:06:28.66,0:06:30.41,Secondary-207-,,0,0,0,,Yapma! Yapma!Dialogue: 55,0:06:30.41,0:06:32.12,Main-207-,,0,0,0,,N-Ne korkunç!Dialogue: 55,0:06:37.29,0:06:41.49,Main-207-,,0,0,0,,B-Bunları yapmak için çok çalıştım...Dialogue: 55,0:06:43.68,0:06:46.18,Main-207-,,0,0,0,,Bu duyuruyu okumadın mı?Dialogue: 55,0:06:46.69,0:06:50.12,Main-207-,,0,0,0,,"Suçlulara yardım edenler idam edilecektir!Dialogue: 55,0:06:50.12,0:06:51.97,Main-207-,,0,0,0,,– Yüzbaşı Morgan."Dialogue: 55,0:06:54.60,0:06:57.46,Main-207-,,0,0,0,,Demek küçük veletler bile babamın ne kadar korkunç olduğunu biliyor!Dialogue: 55,0:06:58.02,0:06:59.25,Main-207-,,0,0,0,,"Babam" mı?Dialogue: 55,0:06:59.25,0:07:01.86,Main-207-,,0,0,0,,O zaman bu Yüzbaşı Morgan'ın oğlu!Dialogue: 55,0:07:02.31,0:07:04.49,Main-207-,,0,0,0,,Hey, bu çocuğu dışarı at.Dialogue: 55,0:07:04.49,0:07:05.11,Main-207-,,0,0,0,,Efendim?!Dialogue: 55,0:07:06.24,0:07:08.97,Main-207-,,0,0,0,,Dedim ki, onu duvarın dışına at!Dialogue: 55,0:07:08.97,0:07:12.37,Main-207-,,0,0,0,,Emirlere uymak zor mu geliyor? Babama söylettirme bana!Dialogue: 55,0:07:12.37,0:07:13.91,Main-207-,,0,0,0,,T-Tabii, efendim... Derhal!Dialogue: 55,0:07:15.62,0:07:16.79,Main-207-,,0,0,0,,Hayır...Dialogue: 55,0:07:16.79,0:07:17.79,Main-207-,,0,0,0,,Hayır!Dialogue: 55,0:07:24.22,0:07:26.50,Main-207-,,0,0,0,,T-Teşekkür ederim.Dialogue: 55,0:07:26.50,0:07:27.92,Main-207-,,0,0,0,,İyi misin, Luffy-san?!Dialogue: 55,0:07:28.90,0:07:30.64,Main-207-,,0,0,0,,Yaralandın mı?Dialogue: 55,0:07:30.64,0:07:33.14,Main-207-,,0,0,0,,Ne berbat bir adam.Dialogue: 55,0:07:33.14,0:07:34.85,Main-207-,,0,0,0,,Bir yerin acıyor mu?Dialogue: 55,0:07:35.29,0:07:36.27,Main-207-,,0,0,0,,Pislik herif...Dialogue: 55,0:07:40.56,0:07:44.11,Main-207-,,0,0,0,,Hayatta kalmakta diretiyorsun.Dialogue: 55,0:07:44.11,0:07:47.53,Main-207-,,0,0,0,,Evet! Bütün bir ay boyunca yaşayacağım!Dialogue: 55,0:07:47.53,0:07:49.67,Main-207-,,0,0,0,,Bol şans sana!Dialogue: 55,0:07:52.24,0:07:54.28,Main-207-,,0,0,0,,Geriye 10 gün kaldı.Dialogue: 55,0:07:54.28,0:07:57.26,Main-207-,,0,0,0,,Eğer o kadar uzun yaşarsan.Dialogue: 55,0:07:58.98,0:08:02.21,Main-207-,,0,0,0,,Nasıl bu kadar zalim olabilir, Luffy-san?!Dialogue: 55,0:08:02.55,0:08:04.42,Main-207-,,0,0,0,,Ha?! Gitmiş mi?!Dialogue: 55,0:08:06.67,0:08:08.93,Main-207-,,0,0,0,,Duyduğuma göre kötü biriymişsin.Dialogue: 55,0:08:08.93,0:08:10.60,Main-207-,,0,0,0,,Sen hala burada mısın?Dialogue: 55,0:08:10.60,0:08:13.13,Main-207-,,0,0,0,,Herkesin görmesi için buraya koyulmak...Dialogue: 55,0:08:13.13,0:08:14.68,Main-207-,,0,0,0,,Sen gerçekten güçlü müsün?Dialogue: 55,0:08:14.68,0:08:16.10,Main-207-,,0,0,0,,Kendi işine bak!Dialogue: 55,0:08:19.23,0:08:22.11,Main-207-,,0,0,0,,Ben olsam muhtemelen üç günde açlıktan ölürdüm!Dialogue: 55,0:08:22.11,0:08:24.48,Main-207-,,0,0,0,,O zaman iraden zayıf.Dialogue: 55,0:08:25.11,0:08:28.24,Main-207-,,0,0,0,,Bunu atlatacağım!Dialogue: 55,0:08:28.24,0:08:29.42,Main-207-,,0,0,0,,Kesinlikle!Dialogue: 55,0:08:30.99,0:08:32.45,Main-207-,,0,0,0,,Ne garip biri.Dialogue: 55,0:08:32.45,0:08:33.49,Main-207-,,0,0,0,,Bekle!Dialogue: 55,0:08:32.99,0:08:33.49,Secondary-207-,,0,0,0,,Ha?Dialogue: 55,0:08:34.54,0:08:36.58,Main-207-,,0,0,0,,Şunu... bana verebilir misin?Dialogue: 55,0:08:37.83,0:08:40.08,Main-207-,,0,0,0,,Bunu yiyecek misin?Dialogue: 55,0:08:40.08,0:08:41.92,Main-207-,,0,0,0,,Çamur topu olmuş.Dialogue: 55,0:08:41.92,0:08:43.54,Main-207-,,0,0,0,,Kapa çeneni de ver şunu!Dialogue: 55,0:08:50.18,0:08:51.64,Main-207-,,0,0,0,,Söylemiştim.Dialogue: 55,0:08:51.64,0:08:53.18,Main-207-,,0,0,0,,Güzeldi.Dialogue: 55,0:08:54.06,0:08:55.64,Main-207-,,0,0,0,,Yemek için teşekkürler.Dialogue: 55,0:08:58.02,0:08:59.27,Main-207-,,0,0,0,,Gerçekten mi?!Dialogue: 55,0:09:00.10,0:09:03.48,Main-207-,,0,0,0,,Evet! Hepsini yedi!Dialogue: 55,0:09:03.48,0:09:04.98,Main-207-,,0,0,0,,Çok mutlu oldum!Dialogue: 55,0:09:04.98,0:09:08.44,Main-207-,,0,0,0,,Zoro gerçekten söyledikleri kadar kötü bir adam mı?Dialogue: 55,0:09:08.44,0:09:10.45,Main-207-,,0,0,0,,Hayır!Dialogue: 55,0:09:10.45,0:09:15.08,Main-207-,,0,0,0,,O bizim için kendini çarmıha gerdirdi...Dialogue: 55,0:09:15.08,0:09:16.95,Main-207-,,0,0,0,,Ha? Nasıl yani?Dialogue: 55,0:09:16.95,0:09:19.71,Main-207-,,0,0,0,,Her şey Helmeppo'nun hatası.Dialogue: 55,0:09:20.87,0:09:23.31,Main-207-,,0,0,0,,Yüzbaşı Morgan'ın oğlu...Dialogue: 55,0:09:24.88,0:09:26.55,Flashbacks-207-,,0,0,0,,Çekilin, çekilin!Dialogue: 55,0:09:26.55,0:09:30.59,Flashbacks-207-,,0,0,0,,Sevimli evcil hayvanıma yol açın!Dialogue: 55,0:09:30.59,0:09:33.05,Flashbacks-207-,,0,0,0,,Kim yoluna çıkarsa infaz edilecek!Dialogue: 55,0:09:39.77,0:09:41.35,Flashbacks-207-,,0,0,0,,Hayır! Kes şunu!Dialogue: 55,0:09:41.35,0:09:42.98,Flashbacks-207-,,0,0,0,,Hey, sen!Dialogue: 55,0:09:42.98,0:09:46.07,Flashbacks-207-,,0,0,0,,Evcil hayvanımla bir sorunun mu var?Dialogue: 55,0:09:46.07,0:09:47.73,Flashbacks-207-,,0,0,0,,Rika! Yapma!Dialogue: 55,0:09:47.73,0:09:49.24,Flashbacks-207-,,0,0,0,,Başımız belaya girecek!Dialogue: 55,0:09:56.16,0:09:57.58,Flashbacks-207-,,0,0,0,,Hass?Dialogue: 55,0:09:57.58,0:09:59.20,Flashbacks-207-,,0,0,0,,Şimdi yandı!Dialogue: 55,0:10:02.29,0:10:06.67,Main-207-,,0,0,0,,Zoro orada bağlıyken, Helmeppo onu tekmeleyip yumrukluyor!Dialogue: 55,0:10:07.29,0:10:09.88,Main-207-,,0,0,0,,Ben... Ben...Dialogue: 55,0:10:09.88,0:10:12.17,Main-207-,,0,0,0,,Demek öyle oldu.Dialogue: 55,0:10:14.72,0:10:18.01,Main-207-,,0,0,0,,Karnım acıktı! Hepimize bedavadan yemek getir!Dialogue: 55,0:10:19.85,0:10:21.85,Main-207-,,0,0,0,,Hey! Çabuk ol biraz alkol getir!Dialogue: 55,0:10:21.85,0:10:23.35,Main-207-,,0,0,0,,Oh, tabii ya.Dialogue: 55,0:10:23.35,0:10:27.11,Main-207-,,0,0,0,,Çok sıkıldığım için, yarın Zoro'yu idam ettireceğim.Dialogue: 55,0:10:27.11,0:10:29.40,Main-207-,,0,0,0,,Herkes dört gözle beklesin.Dialogue: 55,0:10:38.78,0:10:40.54,Main-207-,,0,0,0,,N-Ne yapıyorsun sen?!Dialogue: 55,0:10:40.54,0:10:42.41,Main-207-,,0,0,0,,Luffy-san! Lütfen yapma!Dialogue: 55,0:10:42.41,0:10:44.12,Main-207-,,0,0,0,,Bu adam pislik teki!Dialogue: 55,0:10:44.12,0:10:46.17,Main-207-,,0,0,0,,Sen... sen bana vurdun!Dialogue: 55,0:10:46.17,0:10:48.63,Main-207-,,0,0,0,,Ben Yüzbaşı Morgan'ın oğluyum!Dialogue: 55,0:10:48.63,0:10:49.80,Main-207-,,0,0,0,,Ne olmuş?!Dialogue: 55,0:10:50.17,0:10:52.76,Main-207-,,0,0,0,,Babama söyleyip seni infaz ettireceğim!Dialogue: 55,0:10:53.01,0:10:55.01,Main-207-,,0,0,0,,Benimle kendin dövüş!Dialogue: 55,0:10:55.01,0:10:56.76,Main-207-,,0,0,0,,Luffy-san! Sakin ol!Dialogue: 55,0:10:56.76,0:10:58.68,Main-207-,,0,0,0,,Donanmayı düşmanın yapmak mı istiyorsun?!Dialogue: 55,0:10:58.68,0:11:00.14,Main-207-,,0,0,0,,Kararımı verdim, Koby!Dialogue: 55,0:11:01.72,0:11:05.52,Main-207-,,0,0,0,,Zoro'yu yoldaşım yapacağım!Dialogue: 55,0:11:09.40,0:11:10.62,Main-207-,,0,0,0,,Ben...Dialogue: 55,0:11:11.73,0:11:12.57,Main-207-,,0,0,0,,Mükemmelim!Dialogue: 55,0:11:12.82,0:11:15.95,Main-207-,,0,0,0,,Evet! Kesinlikle haklısınız, Yüzbaşı Morgan, efendim!Dialogue: 55,0:11:15.95,0:11:20.03,Main-207-,,0,0,0,,Ama son zamanlarda bana gelen haraç biraz azalmadı mı?Dialogue: 55,0:11:20.03,0:11:24.75,Main-207-,,0,0,0,,E-eh, vatandaşların cüzdanlarının da bir limiti var...Dialogue: 55,0:11:25.25,0:11:28.04,Main-207-,,0,0,0,,Mesele bana olan saygının derecesi.Dialogue: 55,0:11:28.75,0:11:30.46,Main-207-,,0,0,0,,Katılmıyor musun?Dialogue: 55,0:11:32.42,0:11:33.67,Main-207-,,0,0,0,,Baba!Dialogue: 55,0:11:32.92,0:11:33.67,Secondary-207-,,0,0,0,,Hmm?Dialogue: 55,0:11:34.34,0:11:37.97,Main-207-,,0,0,0,,Öldürmeni istediğim biri var!Dialogue: 55,0:11:43.18,0:11:46.31,Main-207-,,0,0,0,,Yine mi sen? Çok fazla boş vaktin var.Dialogue: 55,0:11:46.31,0:11:48.77,Main-207-,,0,0,0,,İplerini çözeceğim, o yüzden tayfama katıl!Dialogue: 55,0:11:48.77,0:11:49.94,Main-207-,,0,0,0,,Ne dedin sen?!Dialogue: 55,0:11:49.94,0:11:52.65,Main-207-,,0,0,0,,Korsan tayfama katılacak insanlar arıyorum.Dialogue: 55,0:11:53.32,0:11:57.03,Main-207-,,0,0,0,,Boş versene! Bir haydut olacak kadar çaresiz değilim!Dialogue: 55,0:11:57.03,0:11:58.32,Main-207-,,0,0,0,,Unut onu!Dialogue: 55,0:11:58.57,0:12:00.57,Main-207-,,0,0,0,,Korsan olmanın nesi yanlış?!Dialogue: 55,0:12:00.57,0:12:03.20,Main-207-,,0,0,0,,Korsanlar aşağılıktır! Kim olmak ister ki?!Dialogue: 55,0:12:03.20,0:12:04.29,Main-207-,,0,0,0,,Oh, saçmalama!Dialogue: 55,0:12:04.54,0:12:08.25,Main-207-,,0,0,0,,Zaten şeytani bir ödül avcısı olarak tanınıyorsun!Dialogue: 55,0:12:08.50,0:12:11.00,Main-207-,,0,0,0,,İnsanlar istediğini söyleyebilir,...Dialogue: 55,0:12:11.00,0:12:13.71,Main-207-,,0,0,0,,...ama pişmanlık duyduğum hiçbir şey yapmadım.Dialogue: 55,0:12:14.59,0:12:19.68,Main-207-,,0,0,0,,Bunu da atlatacağım ve istediğim şeyi başaracağım!Dialogue: 55,0:12:19.97,0:12:21.85,Main-207-,,0,0,0,,Ha? Anlıyorum.Dialogue: 55,0:12:22.22,0:12:24.89,Main-207-,,0,0,0,,Ama ben, yoldaşım olmana karar verdim!Dialogue: 55,0:12:24.89,0:12:26.31,Main-207-,,0,0,0,,Buna sen karar veremezsin!Dialogue: 55,0:12:26.31,0:12:28.10,Main-207-,,0,0,0,,Duyduğuma göre kılıç kullanıyorsun.Dialogue: 55,0:12:28.52,0:12:32.23,Main-207-,,0,0,0,,Evet... Ama o aptal çocuk eşyalarımı aldı...Dialogue: 55,0:12:32.23,0:12:33.98,Main-207-,,0,0,0,,Gidip onları senin için geri alacağım.Dialogue: 55,0:12:33.98,0:12:34.90,Main-207-,,0,0,0,,Ne?!Dialogue: 55,0:12:34.90,0:12:38.03,Main-207-,,0,0,0,,Kısaca, kılıçlarını istiyorsan, yoldaşım olacaksın!Dialogue: 55,0:12:38.03,0:12:39.28,Main-207-,,0,0,0,,Benimle uğraşma lan!Dialogue: 55,0:12:41.37,0:12:44.12,Main-207-,,0,0,0,,Üssü tek başına basmayı mı planlıyor?!Dialogue: 55,0:12:53.59,0:12:55.69,Main-207-,,0,0,0,,Tamam, orada durun!Dialogue: 55,0:12:56.38,0:12:58.22,Main-207-,,0,0,0,,Bir çekişte ayağa kaldırın.Dialogue: 55,0:12:59.05,0:13:02.14,Main-207-,,0,0,0,,Baba! Neden intikamımı almıyorsun?Dialogue: 55,0:13:02.14,0:13:07.85,Main-207-,,0,0,0,,O herif bana vurdu! Sen bile bana hiç vurmadın!Dialogue: 55,0:13:07.85,0:13:12.15,Main-207-,,0,0,0,,Neden sana hiç vurmadım...Dialogue: 55,0:13:12.44,0:13:13.44,Main-207-,,0,0,0,,...biliyor musun?Dialogue: 55,0:13:13.44,0:13:16.15,Main-207-,,0,0,0,,Şey, çünkü ben senin...Dialogue: 55,0:13:16.78,0:13:17.90,Main-207-,,0,0,0,,Evet.Dialogue: 55,0:13:18.49,0:13:20.40,Main-207-,,0,0,0,,Çünkü sen...Dialogue: 55,0:13:27.33,0:13:31.62,Main-207-,,0,0,0,,vurmaya bile değmeyen işe yaramaz oğlumsun!Dialogue: 55,0:13:32.25,0:13:33.93,Main-207-,,0,0,0,,Bir şeyi açıklığa kavuşturalım!Dialogue: 55,0:13:37.38,0:13:41.68,Main-207-,,0,0,0,,Mükemmel olan senin baban! Yani ben!Dialogue: 55,0:13:44.80,0:13:48.68,Main-207-,,0,0,0,,İnfaz avlusuna gizlice giren bir fare olduğunu duydum.Dialogue: 55,0:13:49.68,0:13:53.27,Main-207-,,0,0,0,,E-eğer, o ufaklıktan bahsediyorsan, ben onun icabına baktım.Dialogue: 55,0:13:53.27,0:13:54.65,Main-207-,,0,0,0,,Onu öldürdün, umarım?Dialogue: 55,0:13:54.90,0:13:58.11,Main-207-,,0,0,0,,Hayır! Yani şey, sadece küçük bir çocuktu...Dialogue: 55,0:13:58.94,0:14:00.74,Main-207-,,0,0,0,,Sen, oradaki!Dialogue: 55,0:14:00.74,0:14:02.28,Main-207-,,0,0,0,,Kasabaya git ve onu yok et!Dialogue: 55,0:14:02.65,0:14:05.66,Main-207-,,0,0,0,,Ama... o sadece küçük bir kız!Dialogue: 55,0:14:05.66,0:14:07.08,Main-207-,,0,0,0,,Bir emir olsa da...Dialogue: 55,0:14:07.87,0:14:12.46,Main-207-,,0,0,0,,Benim emirlerime karşı gelen herkes haindir, küçük veletler bile.Dialogue: 55,0:14:12.46,0:14:14.92,Main-207-,,0,0,0,,A-ama... Yapamam!Dialogue: 55,0:14:20.13,0:14:21.05,Main-207-,,0,0,0,,Teğmen!Dialogue: 55,0:14:21.55,0:14:23.18,Main-207-,,0,0,0,,B-bu kadar ileri gitmene gerek yoktu!Dialogue: 55,0:14:23.93,0:14:28.68,Main-207-,,0,0,0,,Beni Yüzbaşı rütbesine yükselten gücümdü!Dialogue: 55,0:14:28.68,0:14:32.02,Main-207-,,0,0,0,,Dinleyin! Bu dünyada rütbe her şeydir!Dialogue: 55,0:14:33.02,0:14:36.81,Main-207-,,0,0,0,,Bu üsteki en üst rütbe Yüzbaşı'dır...Dialogue: 55,0:14:36.81,0:14:40.13,Main-207-,,0,0,0,,Ve bu beni buradaki herkesten üstün kılıyor!Dialogue: 55,0:14:41.49,0:14:45.42,Main-207-,,0,0,0,,Bu yüzden yaptığım her şey doğrudur!Dialogue: 55,0:14:46.24,0:14:47.57,Main-207-,,0,0,0,,Anladınız mı, sürüngenler?!Dialogue: 55,0:14:47.83,0:14:49.70,Main-207-,,0,0,0,,Evet, efendim! Kesinlikle doğru!Dialogue: 55,0:14:50.20,0:14:52.16,Main-207-,,0,0,0,,Çocuğun ölümü şimdilik bekleyebilir.Dialogue: 55,0:14:52.87,0:14:56.50,Main-207-,,0,0,0,,İyi bakın! Bu, bitmesi yıllar süren,...Dialogue: 55,0:14:57.00,0:14:59.59,Main-207-,,0,0,0,,...otoritemin simgesi!Dialogue: 55,0:14:59.59,0:15:01.40,Main-207-,,0,0,0,,Şimdi, kaldırın!Dialogue: 55,0:15:02.71,0:15:06.18,Main-207-,,0,0,0,,Büyüklüğümü bu üssün tepesinde sergileyin!Dialogue: 55,0:15:09.64,0:15:11.81,Main-207-,,0,0,0,,Garip. Burada kimse yok...Dialogue: 55,0:15:11.81,0:15:15.64,Main-207-,,0,0,0,,O salak oğlu bulup Zoro'nun kılıçlarını geri almalıyım.Dialogue: 55,0:15:15.64,0:15:16.44,Main-207-,,0,0,0,,Ha...?Dialogue: 55,0:15:17.52,0:15:19.40,Main-207-,,0,0,0,,Çek! Çek!Dialogue: 55,0:15:24.74,0:15:26.03,Main-207-,,0,0,0,,Sen, oradaki!Dialogue: 55,0:15:28.95,0:15:30.33,Main-207-,,0,0,0,,Sen çarptın, değil mi?!Dialogue: 55,0:15:32.20,0:15:34.14,Main-207-,,0,0,0,,Yukarıdan bir şeyler duydum...Dialogue: 55,0:15:35.08,0:15:38.38,Main-207-,,0,0,0,,Ç-çok üzgünüm efendim! Dikkatsizlik ettim!Dialogue: 55,0:15:38.38,0:15:42.34,Main-207-,,0,0,0,,Size bu heykelin beni temsil ettiğini söyledim!Dialogue: 55,0:15:42.34,0:15:46.51,Main-207-,,0,0,0,,En ufak bir çizik veya kir zerresi bana ihanettir!Dialogue: 55,0:15:46.97,0:15:48.07,Main-207-,,0,0,0,,Bir bakayım.Dialogue: 55,0:15:49.01,0:15:50.82,Main-207-,,0,0,0,,Lastik-Lastik...Dialogue: 55,0:15:51.35,0:15:52.76,Main-207-,,0,0,0,,Roket!Dialogue: 55,0:15:52.76,0:15:53.77,Main-207-,,0,0,0,,Geber!Dialogue: 55,0:15:55.39,0:15:57.64,Main-207-,,0,0,0,,Çok uzağa zıpladım!Dialogue: 55,0:15:57.64,0:15:58.85,Main-207-,,0,0,0,,O ne?!Dialogue: 55,0:15:58.85,0:16:00.11,Main-207-,,0,0,0,,Yukarıya uçtu!Dialogue: 55,0:16:00.86,0:16:02.17,Main-207-,,0,0,0,,Durdum!Dialogue: 55,0:16:14.04,0:16:15.00,Main-207-,,0,0,0,,Üzgünüm...Dialogue: 55,0:16:17.71,0:16:20.67,Main-207-,,0,0,0,,Yakalayın onu! Onu kendim öldüreceğim!Dialogue: 55,0:16:20.67,0:16:22.13,Main-207-,,0,0,0,,– Derhal, efendim! – Derhal, efendim!Dialogue: 55,0:16:22.13,0:16:24.63,Main-207-,,0,0,0,,Baba! Bu işte! Bana vuran adam bu!Dialogue: 55,0:16:24.63,0:16:25.67,Main-207-,,0,0,0,,Oh! Sensin!Dialogue: 55,0:16:27.17,0:16:28.55,Main-207-,,0,0,0,,Seni arıyordum!Dialogue: 55,0:16:28.55,0:16:30.97,Main-207-,,0,0,0,,Benimle gel! Bir şeyi iade etmen gerekiyor!Dialogue: 55,0:16:30.97,0:16:33.39,Main-207-,,0,0,0,,Ahh! Bırak beni!Dialogue: 55,0:16:31.97,0:16:33.39,Main-207-,,0,0,0,,– Helmeppo-sama! – Helmeppo-sama!Dialogue: 55,0:16:33.39,0:16:35.64,Main-207-,,0,0,0,,Peşinden gidin! Kaçmasına izin vermeyin!Dialogue: 55,0:16:35.64,0:16:38.02,Main-207-,,0,0,0,,Yüzbaşı! İnfaz avlusunda biri var!Dialogue: 55,0:16:38.02,0:16:39.33,Main-207-,,0,0,0,,Ne?Dialogue: 55,0:16:44.07,0:16:47.65,Main-207-,,0,0,0,,Arka arkaya hain çıkıyor...Dialogue: 55,0:16:47.65,0:16:49.61,Main-207-,,0,0,0,,Lütfen kaç, Zoro-san!Dialogue: 55,0:16:49.95,0:16:52.57,Main-207-,,0,0,0,,Bunu yaptığın için öldürüleceksin!Dialogue: 55,0:16:52.57,0:16:55.49,Main-207-,,0,0,0,,Donanmanın böyle davranmasına seyirci kalamam!Dialogue: 55,0:16:55.49,0:16:59.04,Main-207-,,0,0,0,,Ben onurlu bir denizci olmak istiyorum!Dialogue: 55,0:16:59.41,0:17:03.25,Main-207-,,0,0,0,,Dur! Kaçamam! Sadece on gün daha–Dialogue: 55,0:17:03.25,0:17:05.46,Main-207-,,0,0,0,,Yarın infaz edileceksin!Dialogue: 55,0:17:05.71,0:17:06.34,Main-207-,,0,0,0,,Ne?!Dialogue: 55,0:17:06.76,0:17:11.43,Main-207-,,0,0,0,,Helmeppo asla sözünü tutmak niyetinde değildi.Dialogue: 55,0:17:11.43,0:17:15.43,Main-207-,,0,0,0,,Bu yüzden Luffy-san kızdı ve Helmeppo'yu yumrukladı.Dialogue: 55,0:17:16.14,0:17:17.10,Main-207-,,0,0,0,,Öyle mi yaptı?Dialogue: 55,0:17:17.10,0:17:20.48,Main-207-,,0,0,0,,Donanma şimdi Luffy-san'ın peşinde.Dialogue: 55,0:17:21.10,0:17:24.31,Main-207-,,0,0,0,,Senden korsan olmanı istemeyeceğim,...Dialogue: 55,0:17:24.31,0:17:28.32,Main-207-,,0,0,0,,...ama lütfen, Luffy-san'a yardım et!Dialogue: 55,0:17:32.24,0:17:35.87,Main-207-,,0,0,0,,Seni kurtarabilecek tek kişi o.Dialogue: 55,0:17:37.04,0:17:43.54,Main-207-,,0,0,0,,Ve şu anda, onu kurtarabilecek tek kişi sensin.Dialogue: 55,0:17:45.09,0:17:46.34,Main-207-,,0,0,0,,Dur bakalım orada!Dialogue: 55,0:17:50.05,0:17:51.88,Main-207-,,0,0,0,,Zoro'nun kılıçları nerede?Dialogue: 55,0:17:51.88,0:17:56.47,Main-207-,,0,0,0,,Söyleyeceğim! Söyleyeceğim! Beni yerde sürüklemeyi bırak!Dialogue: 55,0:17:56.47,0:17:57.35,Main-207-,,0,0,0,,Tamam! Söyle!Dialogue: 55,0:17:57.35,0:18:00.60,Main-207-,,0,0,0,,Benim odamda... Daha demin geçtik...Dialogue: 55,0:18:00.60,0:18:04.06,Main-207-,,0,0,0,,Niye önceden söylemedin? Şimdi geri gitmemiz lazım.Dialogue: 55,0:18:04.06,0:18:05.31,Main-207-,,0,0,0,,Kıpırdama!Dialogue: 55,0:18:05.31,0:18:06.82,Main-207-,,0,0,0,,Helmeppo-sama'yı bırak!Dialogue: 55,0:18:07.44,0:18:08.32,Main-207-,,0,0,0,,Olmaz.Dialogue: 55,0:18:10.07,0:18:12.07,Main-207-,,0,0,0,,İstiyorsanız ateş edin.Dialogue: 55,0:18:12.07,0:18:14.16,Main-207-,,0,0,0,,Ahh! Hayır! Yapmayın!Dialogue: 55,0:18:14.49,0:18:15.95,Main-207-,,0,0,0,,Çekilin!Dialogue: 55,0:18:16.83,0:18:18.99,Main-207-,,0,0,0,,Bana karşı ihanet suçundan...Dialogue: 55,0:18:18.99,0:18:22.00,Main-207-,,0,0,0,,...ikinizi de burada infaz edeceğim!Dialogue: 55,0:18:25.04,0:18:26.00,Main-207-,,0,0,0,,Bu oda mı?Dialogue: 55,0:18:29.96,0:18:30.96,Main-207-,,0,0,0,,Bingo!Dialogue: 55,0:18:31.97,0:18:34.05,Main-207-,,0,0,0,,Ama burada üç tane kılıç var.Dialogue: 55,0:18:34.05,0:18:35.93,Main-207-,,0,0,0,,Hey! Hangisi Zoro'nun kılıcı?Dialogue: 55,0:18:36.80,0:18:38.68,Main-207-,,0,0,0,,Hadi... bayıldı.Dialogue: 55,0:18:40.89,0:18:41.68,Main-207-,,0,0,0,,Koby!Dialogue: 55,0:18:48.86,0:18:52.57,Main-207-,,0,0,0,,Burada ilginç şeyler yaptınız!Dialogue: 55,0:18:53.49,0:18:57.41,Main-207-,,0,0,0,,Siz ve o hasır şapkalı çocuk, darbe falan mı planlıyordunuz?!Dialogue: 55,0:18:58.12,0:19:00.58,Main-207-,,0,0,0,,Ben hep yalnız savaştım.Dialogue: 55,0:19:00.83,0:19:05.04,Main-207-,,0,0,0,,Askerlerinin arkasına saklanan senin gibi kibirli piçlerin aksine!Dialogue: 55,0:19:05.42,0:19:07.50,Main-207-,,0,0,0,,Roronoa Zoro...Dialogue: 55,0:19:07.50,0:19:09.50,Main-207-,,0,0,0,,Beni sakın hafife alma!Dialogue: 55,0:19:10.00,0:19:14.97,Main-207-,,0,0,0,,Güçlü olabilirsin, ama benim otoritemin karşısında bir hiçsin!Dialogue: 55,0:19:15.97,0:19:17.01,Main-207-,,0,0,0,,Nişan al!Dialogue: 55,0:19:17.64,0:19:18.89,Thoughts-207-,,0,0,0,,Ben...Dialogue: 55,0:19:22.06,0:19:25.60,Thoughts-207-,,0,0,0,,...böyle bir yerde ölemem!Dialogue: 55,0:19:28.61,0:19:30.73,Main-207-,,0,0,0,,Düello sona erdi!Dialogue: 55,0:19:31.02,0:19:34.24,Main-207-,,0,0,0,,Kazanan Kuina! 2,000 kez kazandı, hiç kaybetmedi!Dialogue: 55,0:19:34.24,0:19:36.70,Main-207-,,0,0,0,,K-Kahretsin.Dialogue: 55,0:19:36.70,0:19:39.07,Main-207-,,0,0,0,,Her zamanki gibi güçsüzsün, Zoro.Dialogue: 55,0:19:40.58,0:19:43.70,Main-207-,,0,0,0,,Ne büyük hayal kırıklığı... özellikle bir erkek için.Dialogue: 55,0:19:43.70,0:19:45.83,Main-207-,,0,0,0,,Hey! Zoro güçsüz değil!Dialogue: 55,0:19:45.83,0:19:48.08,Main-207-,,0,0,0,,Erkek öğrenciler arasında en güçlüsü!Dialogue: 55,0:19:48.08,0:19:49.67,Main-207-,,0,0,0,,Yetişkinleri bile yeniyor!Dialogue: 55,0:19:49.67,0:19:50.96,Main-207-,,0,0,0,,Ancak...Dialogue: 55,0:19:50.96,0:19:52.75,Main-207-,,0,0,0,,...benden güçsüz.Dialogue: 55,0:19:53.38,0:19:57.22,Main-207-,,0,0,0,,İki kılıçla bile olsa, güçsüz güçsüzdür.Dialogue: 55,0:19:57.22,0:20:01.26,Main-207-,,0,0,0,,Siz ezik köpekler çenenizi kapatmalısınız.Dialogue: 55,0:20:10.86,0:20:17.07,Main-207-,,0,0,0,,Bu kadar güçlendiğin halde yine kaybettin, Zoro.Dialogue: 55,0:20:17.74,0:20:18.61,Main-207-,,0,0,0,,Sensei!Dialogue: 55,0:20:18.61,0:20:22.62,Main-207-,,0,0,0,,Sırf kızınız olduğu için ona gizli eğitim mi veriyorsunuz?Dialogue: 55,0:20:22.62,0:20:23.54,Main-207-,,0,0,0,,Hile yapmayın!Dialogue: 55,0:20:23.91,0:20:26.66,Main-207-,,0,0,0,,Hayır, hayır. Öyle bir şey yapmıyorum.Dialogue: 55,0:20:27.41,0:20:29.75,Main-207-,,0,0,0,,Zoro'nun güçlendiği doğru,...Dialogue: 55,0:20:30.29,0:20:33.88,Main-207-,,0,0,0,,...ancak, Kuina da güçlendi.Dialogue: 55,0:20:34.38,0:20:35.21,Main-207-,,0,0,0,,Zoro?Dialogue: 55,0:20:35.21,0:20:36.47,Main-207-,,0,0,0,,Zoro...Dialogue: 55,0:20:36.47,0:20:37.67,Main-207-,,0,0,0,,Yüzümü yıkayacağım.Dialogue: 55,0:20:44.68,0:20:45.43,Main-207-,,0,0,0,,Kahretsin!Dialogue: 55,0:20:46.39,0:20:50.15,Main-207-,,0,0,0,,Niye Kuina'yı yenemiyorum?! Niye? Niye?Dialogue: 55,0:20:50.15,0:20:54.15,Main-207-,,0,0,0,,Dünyanın en büyük kılıç ustası olacağım! E Niye?!Dialogue: 55,0:21:05.54,0:21:06.50,Main-207-,,0,0,0,,Zoro?!Dialogue: 55,0:21:06.50,0:21:08.62,Main-207-,,0,0,0,,Burada ne yapıyorsun?Dialogue: 55,0:21:09.12,0:21:13.21,Main-207-,,0,0,0,,Onu benim sormam lazım! Bu saatte burada ne yapıyorsun?!Dialogue: 55,0:21:16.67,0:21:19.93,Main-207-,,0,0,0,,2001. maçımızı yapmayı teklif etmeye geldim.Dialogue: 55,0:21:19.93,0:21:23.43,Main-207-,,0,0,0,,Bunun bizim son düellomuz olmasını planlıyorum!Dialogue: 55,0:21:23.43,0:21:25.10,Main-207-,,0,0,0,,Buna bir son vereceğim!Dialogue: 55,0:21:25.10,0:21:27.47,Main-207-,,0,0,0,,Benimle gerçek bir kılıçla dövüş!Dialogue: 55,0:21:27.47,0:21:29.18,Main-207-,,0,0,0,,Gerçek kılıcın var, değil mi?Dialogue: 55,0:21:31.73,0:21:32.94,Main-207-,,0,0,0,,Benimle mi?Dialogue: 55,0:21:37.07,0:21:38.07,Main-207-,,0,0,0,,Kabul.Dialogue: 55,0:22:14.81,0:22:17.02,Main-207-,,0,0,0,,2001. zaferim.Dialogue: 55,0:22:24.03,0:22:26.62,Main-207-,,0,0,0,,Kahretsin!Dialogue: 55,0:22:27.16,0:22:29.12,Main-207-,,0,0,0,,Böyle işe...Dialogue: 55,0:22:33.50,0:22:36.59,Main-207-,,0,0,0,,Hüsrana uğradığı için ağlayan kişi ben olmalıyım.Dialogue: 55,0:22:37.67,0:22:38.46,Main-207-,,0,0,0,,He?Dialogue: 55,0:22:39.67,0:22:45.14,Main-207-,,0,0,0,,Kızlar büyüdüğü zaman erkeklerden güçsüz olur.Dialogue: 55,0:22:46.09,0:22:48.68,Main-207-,,0,0,0,,Yakında sen bile bana yetişeceksin...Dialogue: 55,0:22:50.35,0:22:54.94,Main-207-,,0,0,0,,Her zaman dünyanın en büyük kılıç ustası olacağını söylüyorsun.Dialogue: 55,0:22:55.73,0:23:00.98,Main-207-,,0,0,0,,Babam bana bir kızın asla öyle olamayacağını söyledi...Dialogue: 55,0:23:02.36,0:23:03.82,Main-207-,,0,0,0,,Biliyorum...Dialogue: 55,0:23:03.82,0:23:08.78,Main-207-,,0,0,0,,Bunu zaten biliyorum... ama bunu kabullenemiyorum!Dialogue: 55,0:23:09.33,0:23:12.04,Main-207-,,0,0,0,,Zoro çok şanslısın. Sen bir erkeksin.Dialogue: 55,0:23:12.79,0:23:15.79,Main-207-,,0,0,0,,Ben de dünyanın en büyük kılıç ustası olmak istiyorum!Dialogue: 55,0:23:16.88,0:23:19.50,Main-207-,,0,0,0,,Göğüslerim çoktan büyümeye başladı...Dialogue: 55,0:23:20.46,0:23:23.92,Main-207-,,0,0,0,,Eğer... eğer bir erkek olarak doğsaydım...Dialogue: 55,0:23:25.47,0:23:28.93,Main-207-,,0,0,0,,Beni yendikten sonra böyle sızlanma!Dialogue: 55,0:23:28.93,0:23:32.43,Main-207-,,0,0,0,,Adil değil! Sen benim hedefimsin!Dialogue: 55,0:23:32.93,0:23:33.89,Main-207-,,0,0,0,,Zoro...Dialogue: 55,0:23:33.89,0:23:35.77,Main-207-,,0,0,0,,Erkek böyle, kız öyle!Dialogue: 55,0:23:35.77,0:23:38.73,Main-207-,,0,0,0,,Bir gün seni yendiğimde, bu mu mazeretin olacak?!Dialogue: 55,0:23:38.73,0:23:40.73,Main-207-,,0,0,0,,Yetenek önemli değilmiş gibi davranıyorsun!Dialogue: 55,0:23:40.73,0:23:44.40,Main-207-,,0,0,0,,Yaptığım bütün sıkı çalışmayı aşağılıyorsun!Dialogue: 55,0:23:44.99,0:23:46.95,Main-207-,,0,0,0,,O yüzden saçmalama!Dialogue: 55,0:23:49.49,0:23:50.78,Main-207-,,0,0,0,,Söz ver bana!Dialogue: 55,0:23:51.37,0:23:55.87,Main-207-,,0,0,0,,Bir gün, birimiz dünyanın en büyük kılıç ustası olacak!Dialogue: 55,0:23:55.87,0:23:57.50,Main-207-,,0,0,0,,Yarışacağız ve kim olacak göreceğiz!Dialogue: 55,0:24:02.21,0:24:03.84,Main-207-,,0,0,0,,Seni şapşal. Çok güçsüzsün...Dialogue: 55,0:24:07.88,0:24:09.51,Main-207-,,0,0,0,,– Söz! – Söz!Dialogue: 55,0:24:13.01,0:24:17.31,Thoughts-207-,,0,0,0,,Güçlenmeliyim! Ki bir sürü kılıç tutabileyim!Dialogue: 55,0:24:17.31,0:24:20.06,Thoughts-207-,,0,0,0,,İki yetmezse, üç kullanacağım.Dialogue: 55,0:24:25.15,0:24:26.90,Main-207-,,0,0,0,,Neyiniz var?Dialogue: 55,0:24:29.49,0:24:30.82,Main-207-,,0,0,0,,Kuina...Dialogue: 55,0:24:32.33,0:24:34.62,Main-207-,,0,0,0,,Kuina öldü...Dialogue: 55,0:24:46.01,0:24:50.22,Main-207-,,0,0,0,,Depo merdivenlerinde ayağı kaymış ve düşmüş.Dialogue: 55,0:24:50.22,0:24:51.05,Main-207-,,0,0,0,,Depoda mı?Dialogue: 55,0:24:51.47,0:24:56.06,Main-207-,,0,0,0,,Sevgili kılıcı için bir bileme taşı arıyormuş.Dialogue: 55,0:24:56.06,0:24:57.85,Main-207-,,0,0,0,,Niye öyle bir şeyi aramış?Dialogue: 55,0:24:58.14,0:24:59.77,Main-207-,,0,0,0,,Kim bilir...Dialogue: 55,0:24:59.77,0:25:01.31,Main-207-,,0,0,0,,Daha bir çocuktu.Dialogue: 55,0:25:01.77,0:25:04.15,Main-207-,,0,0,0,,İnsanları anlayamazsın.Dialogue: 55,0:25:04.15,0:25:07.19,Main-207-,,0,0,0,,Yarın ne olacağını kim bilebilir ki?Dialogue: 55,0:25:16.37,0:25:20.50,Main-207-,,0,0,0,,İnsanlar... çok kırılgan varlıklardır, Zoro.Dialogue: 55,0:25:32.80,0:25:33.76,Main-207-,,0,0,0,,Sensei...Dialogue: 55,0:25:35.68,0:25:38.85,Main-207-,,0,0,0,,O kılıcı... bana verin.Dialogue: 55,0:25:41.35,0:25:43.40,Main-207-,,0,0,0,,Kuina'nın kılıcı mı?Dialogue: 105,0:25:44.31,0:25:48.07,Main-207-,,0,0,0,,Onun için de güçleneceğim!Dialogue: 105,0:25:48.44,0:25:51.86,Main-207-,,0,0,0,,Adım cennete ulaşacak kadar güçlü olacağım!Dialogue: 105,0:25:52.61,0:25:55.95,Main-207-,,0,0,0,,Dünyanın en güçlü kılıç ustası olacağım!Dialogue: 105,0:25:57.95,0:26:00.66,Main-207-,,0,0,0,,Ona söz verdim...Dialogue: 105,0:26:01.21,0:26:01.83,Main-207-,,0,0,0,,Ben...Dialogue: 105,0:26:10.42,0:26:11.51,Main-207-,,0,0,0,,Alabilirsin!Dialogue: 105,0:26:16.85,0:26:21.81,Main-207-,,0,0,0,,Kuina'nın ruhunu ve hayallerini sana bırakıyorum.Dialogue: 105,0:26:46.38,0:26:48.75,Main-207-,,0,0,0,,Lastik-Lastik...Dialogue: 105,0:26:48.75,0:26:49.92,Main-207-,,0,0,0,,Roket!Dialogue: 105,0:26:49.92,0:26:50.92,Main-207-,,0,0,0,,Ateş!Dialogue: 105,0:26:54.88,0:26:55.47,Main-207-,,0,0,0,,Sen–Dialogue: 105,0:26:55.47,0:26:56.51,Main-207-,,0,0,0,,Luffy-san!Dialogue: 105,0:26:56.51,0:26:57.14,Main-207-,,0,0,0,,Hasır Şapka?!Dialogue: 105,0:26:59.26,0:27:00.47,Main-207-,,0,0,0,,İmkanı yok...Dialogue: 105,0:27:02.81,0:27:04.89,Main-207-,,0,0,0,,İşe yaramaz!Dialogue: 105,0:27:09.40,0:27:11.90,Main-207-,,0,0,0,,Sana güçlü olduğumu söylemiştim!Dialogue: 105,0:27:11.90,0:27:15.07,Main-207-,,0,0,0,,L-Lan... Kimsin sen?!Dialogue: 105,0:27:16.20,0:27:18.58,Main-207-,,0,0,0,,Ben, Monkey D. Luffy.Dialogue: 105,0:27:18.58,0:27:20.83,Main-207-,,0,0,0,,Korsanlar Kralı olacak adamım!Dialogue: 0,0:02:54.45,0:02:58.20,Title-207-,,0,0,0,,Korsanlar Kralı ve En İyi Kılıç UstasıDialogue: 1,0:02:54.45,0:02:58.20,Title-207-,,0,0,0,,Korsanlar Kralı ve En İyi Kılıç UstasıDialogue: 0,0:04:35.67,0:04:42.51,Captions-207-,,0,0,0,,"Korsan Avcısı" Roronoa ZoroDialogue: 2,0:04:35.67,0:04:42.51,Captions-207-,,0,0,0,,"Korsan Avcısı" Roronoa ZoroDialogue: 0,0:05:58.80,0:06:04.22,Captions-207-,,0,0,0,,Helmeppo Yüzbaşı Morgan'ın OğluDialogue: 2,0:05:58.80,0:06:04.22,Captions-207-,,0,0,0,,Helmeppo Yüzbaşı Morgan'ın OğluDialogue: 0,0:13:26.24,0:13:31.62,Captions-207-,,0,0,0,,"Balta-El" Morgan Donanma YüzbaşısıDialogue: 2,0:13:26.24,0:13:31.62,Captions-207-,,0,0,0,,"Balta-El" Morgan Donanma YüzbaşısıDialogue: 0,0:06:46.17,0:06:46.21,Captions-207-,,0,0,0,,m 0 142 b 8 141.8 19.6 137.8 28 136 28 136 72 126.5 72 126.5 72 126.5 86 124.5 86 124.5 86 124.5 98 122.3 98 122.3 98 122.3 161 113.7 161 113.7 161 113.7 184 110.2 184 110.2 184 110.2 264 103.9 264 103.9 264 103.9 298 100.9 298 100.9 298 100.9 308 100 308 100 308 100 334 98.1 334 98.1 334 98.1 393 92.8 393 92.8 393 92.8 428 89 428 89 435.6 88.9 439 86.7 444 87.3 452.1 88.5 456.2 92.5 466 91.9 485 90.7 504.5 80.2 521 82.2 534.3 83.8 548.9 95 560 102 542 102 513.5 105.3 498 114.5 487.7 120.6 481.5 129.7 476.8 132.6 476.8 132.6 455 142.6 455 142.6 452 144.5 439.6 154.5 437 157 437 157 429.9 164.9 429.9 164.9 429.9 164.9 423.3 171.1 423.3 1