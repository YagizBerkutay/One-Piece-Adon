0,0,0,0,0,100,100,0,0,1,1.9,1.9,2,180,180,27,1Style: RogerMonologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1Style: Karaoke,Duality,68,&H00292CC7,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,4,0,1,6.8,0,8,23,23,23,1Style: Translation,Duality,68,&H00292CC7,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,4,0,1,6.8,0,2,23,23,34,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:49.92,0:01:59.91,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 50,0:01:52.38,0:01:53.47,Main-207-,,0,0,0,,Evet...Dialogue: 50,0:01:53.47,0:01:55.43,Main-207-,,0,0,0,,Gemilerden birini batırdım...Dialogue: 50,0:01:55.43,0:01:59.10,Main-207-,,0,0,0,,Baroque Works ajanı, Bon Clay'a ait olanı.Dialogue: 50,0:01:59.10,0:02:00.10,Main-207-,,0,0,0,,Ama diğeri...Dialogue: 50,0:02:00.48,0:02:02.69,Main-207-,,0,0,0,,Hadi, kımılda.Dialogue: 50,0:02:02.69,0:02:04.56,Main-207-,,0,0,0,,Demek kaçtılar...Dialogue: 50,0:02:05.36,0:02:07.52,Main-207-,,0,0,0,,Ucuz bir numaraya kandım.Dialogue: 50,0:02:08.23,0:02:10.74,Main-207-,,0,0,0,,Kaçmakta epey iyiler.Dialogue: 50,0:02:13.24,0:02:15.45,Main-207-,,0,0,0,,Leydi Hina, dikkat edin!Dialogue: 50,0:02:15.45,0:02:17.24,Main-207-,,0,0,0,,Cidden beni kızdırıyor.Dialogue: 50,0:02:17.24,0:02:18.28,Main-207-,,0,0,0,,Hina kızdı.Dialogue: 50,0:02:18.28,0:02:20.04,Main-207-,,0,0,0,,Kendi beceriksizliğine mi kızdın?Dialogue: 50,0:02:23.50,0:02:25.83,Main-207-,,0,0,0,,Hayır, alakası yok.Dialogue: 50,0:02:28.00,0:02:32.30,Main-207-,,0,0,0,,Vay be! Leydi Hina'nın Kafes-Kafes Meyvesi her seferinde içimi titretiyor!Dialogue: 50,0:02:32.30,0:02:36.01,Main-207-,,0,0,0,,"Bedenime dokunan her şey hapsolur."Dialogue: 50,0:02:36.39,0:02:38.72,Main-207-,,0,0,0,,Söyle! Mottonu söyle! Lütfen söyle!Dialogue: 50,0:02:42.31,0:02:44.94,Main-207-,,0,0,0,,Bu da ne böyle?! Demir pranga mı?!Dialogue: 50,0:02:44.94,0:02:47.77,Main-207-,,0,0,0,,Beni kızdırıyorsun, Smoker-kun.Dialogue: 50,0:02:48.23,0:02:49.82,Main-207-,,0,0,0,,Sanki daha önce duymadım!Dialogue: 50,0:02:51.07,0:02:51.82,Main-207-,,0,0,0,,Sana...Dialogue: 50,0:02:52.32,0:02:54.40,Main-207-,,0,0,0,,Hasır Şapkalar'ın kaçtığını söylediğimde,Dialogue: 50,0:02:54.95,0:02:57.16,Main-207-,,0,0,0,,bu, hoşuna gitti gibi.Dialogue: 50,0:02:57.16,0:02:57.78,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:02:59.20,0:03:00.66,Main-207-,,0,0,0,,Öyle mi?Dialogue: 50,0:03:00.66,0:03:01.95,Main-207-,,0,0,0,,Neden gitsin ki?Dialogue: 50,0:03:01.95,0:03:02.95,Main-207-,,0,0,0,,Bilmem.Dialogue: 50,0:03:04.33,0:03:08.42,Main-207-,,0,0,0,,Ve sonra resmi bir dille bana dedi ki...Dialogue: 50,0:03:08.42,0:03:12.71,Main-207-,,0,0,0,,"Size söyleyecek önemli bir şeyim var, Babacı– Hayır... Baba."Dialogue: 50,0:03:12.71,0:03:17.14,Main-207-,,0,0,0,,Kral bile olsam, benim için "babacım" unvanından vazgeçmek kadar zor olan...Dialogue: 50,0:03:18.64,0:03:20.85,Main-207-,,0,0,0,,çok az şey vardır.Dialogue: 50,0:03:21.18,0:03:23.52,Main-207-,,0,0,0,,Ne diyorsunuz, Majesteleri?!Dialogue: 50,0:03:37.11,0:03:39.87,Main-207-,,0,0,0,,Ölümünü kabullenemiyorum.Dialogue: 50,0:03:42.33,0:03:43.87,Main-207-,,0,0,0,,Gözyaşı bile akıtamıyorum.Dialogue: 50,0:03:46.41,0:03:49.04,Main-207-,,0,0,0,,Neden acaba? Pell.Dialogue: 50,0:04:00.09,0:04:01.47,Main-207-,,0,0,0,,Ateş! Ateş!Dialogue: 50,0:04:12.73,0:04:14.32,Main-207-,,0,0,0,,Ne oldu, Toto-san?Dialogue: 50,0:04:14.32,0:04:16.78,Main-207-,,0,0,0,,Konuşma bittiğinden beri gülüyorsun!Dialogue: 50,0:04:16.78,0:04:18.36,Main-207-,,0,0,0,,Cidden...Dialogue: 50,0:04:18.36,0:04:20.95,Main-207-,,0,0,0,,O kum fırtınaları aklını mı aldı, ihtiyar?Dialogue: 50,0:04:21.70,0:04:24.29,Main-207-,,0,0,0,,Bu bir sır! Size söyleyemem!Dialogue: 50,0:04:24.66,0:04:25.79,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:04:25.79,0:04:27.54,Main-207-,,0,0,0,,Bu da ne demek?Dialogue: 50,0:04:30.04,0:04:32.59,Main-207-,,0,0,0,,Kendine dikkat et, Luffy-kun!Dialogue: 50,0:04:32.59,0:04:35.51,Main-207-,,0,0,0,,Bir gün Yuba'yı ziyarete gel ve tekrardan suyumuzdan iç!Dialogue: 50,0:04:36.30,0:04:37.38,Main-207-,,0,0,0,,– Ha? – Ha?Dialogue: 50,0:04:40.43,0:04:43.22,Main-207-,,0,0,0,,Neden öylece duruyorsunuz?Dialogue: 50,0:04:43.22,0:04:44.97,Main-207-,,0,0,0,,Gidip kuyu kazın!Dialogue: 50,0:04:44.97,0:04:46.97,Main-207-,,0,0,0,,Peki...Dialogue: 50,0:04:48.81,0:04:55.98,Secondary-207-,,0,0,0,,♪ Ama dünya bir gün değişse bile, çağırırım yine seni ♪Dialogue: 50,0:04:55.98,0:05:03.07,Secondary-207-,,0,0,0,,♪ Döneriz belki o günlere, kaybetmediğimiz her anı gibi ♪Dialogue: 50,0:05:03.07,0:05:10.37,Secondary-207-,,0,0,0,,♪ Götür beni oraya, anıların solmadığı yere ♪Dialogue: 50,0:05:10.37,0:05:17.46,Secondary-207-,,0,0,0,,♪ Lütfen unutulmasına asla izin verme ♪Dialogue: 50,0:04:51.23,0:04:55.23,Main-207-,,0,0,0,,Hey, prensesin konuştuğu kimdi?Dialogue: 50,0:04:55.23,0:04:57.61,Main-207-,,0,0,0,,Bilmem. Önemli de değil zaten.Dialogue: 50,0:04:57.61,0:04:59.61,Main-207-,,0,0,0,,Vivi-sama'yı duyduğuma çok sevindim!Dialogue: 50,0:05:00.07,0:05:02.24,Main-207-,,0,0,0,,Biz de üzerimize düşeni yapmalıyız!Dialogue: 50,0:05:02.24,0:05:04.12,Main-207-,,0,0,0,,Evet, doğru!Dialogue: 50,0:05:04.12,0:05:05.95,Main-207-,,0,0,0,,Sadece sıradan insanlar olsak da.Dialogue: 50,0:05:05.95,0:05:07.75,Main-207-,,0,0,0,,Bunu senden duymak istemiyoruz!Dialogue: 50,0:05:19.26,0:05:22.51,Main-207-,,0,0,0,,Beklendiği gibi, Alubarna kötü durumda görünüyor.Dialogue: 50,0:05:22.51,0:05:25.10,Main-207-,,0,0,0,,Öyleyse, oraya gitmeliyiz.Dialogue: 50,0:05:25.10,0:05:27.31,Main-207-,,0,0,0,,Ama Yuba'yı ayağa kaldırmamız gerek.Dialogue: 50,0:05:27.31,0:05:29.73,Main-207-,,0,0,0,,Sonuçta orası batının merkezi.Dialogue: 50,0:05:29.73,0:05:32.94,Main-207-,,0,0,0,,Sandora Nehri'nden gelen tüm kanallar da onarılmalı.Dialogue: 50,0:05:32.94,0:05:34.56,Main-207-,,0,0,0,,Peki kumarhane?Dialogue: 50,0:05:34.56,0:05:36.48,Main-207-,,0,0,0,,Orası kapandı.Dialogue: 50,0:05:36.48,0:05:37.78,Main-207-,,0,0,0,,Gidelim, millet!Dialogue: 50,0:05:37.78,0:05:39.15,Main-207-,,0,0,0,,– Tamam! – Tamam!Dialogue: 50,0:05:39.61,0:05:42.66,Main-207-,,0,0,0,,O niye özel muamele görüyor?Dialogue: 50,0:05:42.66,0:05:43.66,Main-207-,,0,0,0,,Bilmem...Dialogue: 50,0:05:43.66,0:05:46.49,Main-207-,,0,0,0,,Ama Vivi-sama öyle söyledi. Yapacak bir şey yok.Dialogue: 50,0:05:46.49,0:05:49.33,Main-207-,,0,0,0,,Ayrıca Süpersonik Ördek Takımı'na katılacakmış.Dialogue: 50,0:05:51.91,0:05:53.17,Main-207-,,0,0,0,,Ama o bir deve.Dialogue: 50,0:05:54.29,0:05:55.67,Main-207-,,0,0,0,,Deme ya, gerçekten mi?Dialogue: 50,0:05:58.88,0:05:59.84,Main-207-,,0,0,0,,Peki...Dialogue: 50,0:05:59.84,0:06:02.01,Main-207-,,0,0,0,,Her şey için... teşekkür ederim.Dialogue: 50,0:06:02.01,0:06:04.47,Main-207-,,0,0,0,,Cidden sabırsız birisin.Dialogue: 50,0:06:04.47,0:06:06.97,Main-207-,,0,0,0,,Öyle yaralarla hareket bile etmemen gerekir.Dialogue: 50,0:06:06.97,0:06:08.22,Main-207-,,0,0,0,,Biliyorum, görüşürüz.Dialogue: 50,0:06:08.22,0:06:12.23,Main-207-,,0,0,0,,Şunu iyi anla. Eve gidince doğruca yatağa git!Dialogue: 50,0:06:12.23,0:06:14.23,Main-207-,,0,0,0,,Evet, anlıyorum.Dialogue: 50,0:06:14.60,0:06:16.23,Main-207-,,0,0,0,,Ah sahi, dur biraz.Dialogue: 50,0:06:17.19,0:06:19.15,Main-207-,,0,0,0,,Bunu unuttun. İşte.Dialogue: 50,0:06:40.88,0:06:42.42,Main-207-,,0,0,0,,Hadi, Karoo!Dialogue: 50,0:06:46.59,0:06:48.68,Main-207-,,0,0,0,,Eve, Alubarna'ya gidelim!Dialogue: 50,0:07:01.98,0:07:03.74,Main-207-,,0,0,0,,Smoker-san?Dialogue: 50,0:07:03.74,0:07:05.28,Main-207-,,0,0,0,,Hey, küçük leydi.Dialogue: 50,0:07:05.28,0:07:06.95,Main-207-,,0,0,0,,Bacakların bugün nasıl?Dialogue: 50,0:07:06.95,0:07:10.33,Main-207-,,0,0,0,,L-Lütfen bana öyle demeyin.Dialogue: 50,0:07:21.17,0:07:22.30,Main-207-,,0,0,0,,Teşekkürler...Dialogue: 50,0:07:24.17,0:07:27.22,Main-207-,,0,0,0,,Yeni ödüllerini gördüm.Dialogue: 50,0:07:27.22,0:07:30.10,Main-207-,,0,0,0,,Rakamlar onlara uyuyor.Dialogue: 50,0:07:30.10,0:07:32.52,Main-207-,,0,0,0,,Arkadaşı kılıç ustası ne yaptı, biliyor musun?Dialogue: 50,0:07:32.52,0:07:34.10,Main-207-,,0,0,0,,Roronoa'yı mı diyorsun?Dialogue: 50,0:07:35.23,0:07:38.35,Main-207-,,0,0,0,,Whisky Peak'teki 100 ödül avcısını halletti...Dialogue: 50,0:07:38.35,0:07:42.48,Main-207-,,0,0,0,,ve Alubarna'da Daz Bonez'u yendi.Dialogue: 50,0:07:42.48,0:07:45.03,Main-207-,,0,0,0,,Daz? Suikastçi olan mı?Dialogue: 50,0:07:45.65,0:07:49.20,Main-207-,,0,0,0,,Bu, Batı Mavi'de ödül avcısıyken bildiğimiz ismi.Dialogue: 50,0:07:49.20,0:07:51.87,Main-207-,,0,0,0,,Ama Baroque Works'ta Bay 1 olarak biliniyor.Dialogue: 50,0:07:52.45,0:07:59.29,Main-207-,,0,0,0,,Crocodile'ın bu kadar ünlü ve güçlü karakteri yanına çekmesi etkileyici.Dialogue: 50,0:07:59.63,0:08:02.59,Main-207-,,0,0,0,,Ama yine de hepsi kaybetti.Dialogue: 50,0:08:02.92,0:08:06.47,Main-207-,,0,0,0,,Hasır Şapka Korsanları'yla başka bir zaman hesaplaşacağız.Dialogue: 50,0:08:07.26,0:08:08.05,Main-207-,,0,0,0,,Başüstüne!Dialogue: 50,0:08:09.43,0:08:11.43,Main-207-,,0,0,0,,Görünüşe göre Denizcileri atlattık.Dialogue: 50,0:08:14.52,0:08:17.10,Main-207-,,0,0,0,,Onlardan kurtulduk, değil mi?!Dialogue: 50,0:08:21.36,0:08:22.06,Main-207-,,0,0,0,,Cidden...Dialogue: 50,0:08:22.57,0:08:25.28,Main-207-,,0,0,0,,Bu keyifsiz yanıtlar da neyin nesi?Dialogue: 50,0:08:26.32,0:08:28.28,Main-207-,,0,0,0,,– Onu özlüyoruz! – Onu özlüyoruz!Dialogue: 50,0:08:28.28,0:08:29.95,Main-207-,,0,0,0,,Sızlanmayı kesin!Dialogue: 50,0:08:29.95,0:08:32.95,Main-207-,,0,0,0,,Onu arkada bırakmak istemiyorduysanız,Dialogue: 50,0:08:32.95,0:08:34.54,Main-207-,,0,0,0,,zorla alsaydınız!Dialogue: 50,0:08:35.41,0:08:36.29,Main-207-,,0,0,0,,Seni kalpsiz!Dialogue: 50,0:08:36.29,0:08:37.41,Main-207-,,0,0,0,,Adisin!Dialogue: 50,0:08:37.41,0:08:38.41,Main-207-,,0,0,0,,Yosun Kafa.Dialogue: 50,0:08:38.41,0:08:39.62,Main-207-,,0,0,0,,Üç kılıç stili...Dialogue: 50,0:08:39.62,0:08:40.67,Main-207-,,0,0,0,,Hey, bekle, Luffy.Dialogue: 50,0:08:40.67,0:08:43.04,Main-207-,,0,0,0,,"Üç kılıç stili" bir hakaret değil.Dialogue: 50,0:08:43.04,0:08:44.00,Main-207-,,0,0,0,,Dört kılıç stili...Dialogue: 50,0:08:44.00,0:08:45.67,Main-207-,,0,0,0,,Sorun sayı değil...Dialogue: 50,0:08:45.67,0:08:47.72,Main-207-,,0,0,0,,Dinle, natto'yu kullan.Dialogue: 50,0:08:45.67,0:08:47.72,Note-207-,,0,0,0,,Natto: Mayalanmış soya fasulyesidir ve çok kötü kokar.Dialogue: 50,0:08:47.72,0:08:50.22,Main-207-,,0,0,0,,Natto gibi koktuğunu söyle.Dialogue: 50,0:08:50.59,0:08:52.30,Main-207-,,0,0,0,,Demek sonunda adadan kaçtık.Dialogue: 50,0:08:52.30,0:08:52.97,Main-207-,,0,0,0,,Evet.Dialogue: 50,0:08:54.51,0:08:55.51,Main-207-,,0,0,0,,Aferin.Dialogue: 50,0:08:57.81,0:08:59.48,Main-207-,,0,0,0,,İntikam mı arıyorsun?! Gel!Dialogue: 50,0:08:59.85,0:09:01.35,Main-207-,,0,0,0,,Sen niye buradasın?!Dialogue: 50,0:09:01.35,0:09:04.77,Main-207-,,0,0,0,,Düşman saldırısı! Düşman saldırısı!Dialogue: 50,0:09:06.15,0:09:07.07,Main-207-,,0,0,0,,O kim?Dialogue: 50,0:09:07.07,0:09:08.82,Main-207-,,0,0,0,,Kimin umurunda?Dialogue: 50,0:09:08.82,0:09:10.40,Main-207-,,0,0,0,,Ne kadar güzel bir kadın!Dialogue: 50,0:09:17.58,0:09:22.54,Main-207-,,0,0,0,,Size tehlikeli şeyleri bana doğru tutmamanızı söylemiştim.Dialogue: 50,0:09:22.54,0:09:24.50,Main-207-,,0,0,0,,Ne zamandır bu gemideydin?Dialogue: 50,0:09:24.50,0:09:25.75,Main-207-,,0,0,0,,Bir süredir.Dialogue: 50,0:09:26.25,0:09:28.76,Main-207-,,0,0,0,,Bu elbiseler senin mi? Onları ödünç alıyorum.Dialogue: 50,0:09:28.76,0:09:31.72,Main-207-,,0,0,0,,Ne yaptığını sanıyorsun, Baroque Works?!Dialogue: 50,0:09:31.72,0:09:33.34,Main-207-,,0,0,0,,Monkey D. Luffy...Dialogue: 50,0:09:33.34,0:09:37.47,Main-207-,,0,0,0,,Bana ne yaptığını unutmadın, değil mi?Dialogue: 50,0:09:37.47,0:09:42.06,Main-207-,,0,0,0,,Luffy! Bu güzel bayana ne yaptın, lanet herif?!Dialogue: 50,0:09:42.06,0:09:45.02,Main-207-,,0,0,0,,Konuş, seni pislik!Dialogue: 50,0:09:41.81,0:09:45.02,Main-207-,,0,0,0,,Derhal gemiden in.Dialogue: 50,0:09:45.65,0:09:49.11,Main-207-,,0,0,0,,Hey, sen! Yalan söyleme! Hiçbir şey yapmadım!Dialogue: 50,0:09:49.49,0:09:50.36,Main-207-,,0,0,0,,Evet, yaptın.Dialogue: 50,0:09:50.36,0:09:52.99,Main-207-,,0,0,0,,Bana çok kötü bir muamelede bulundun.Dialogue: 50,0:09:52.99,0:09:55.24,Main-207-,,0,0,0,,Sorumluluğu üstlen.Dialogue: 50,0:09:55.62,0:09:59.08,Secondary-207-,,0,0,0,,"Kötü muamele" mi?  Ona ne yaptın?!Dialogue: 50,0:09:59.08,0:10:03.46,Secondary-207-,,0,0,0,,Sorumluluğu üstlensen iyi olur, yoksa...!Dialogue: 50,0:09:55.24,0:09:58.41,Main-207-,,0,0,0,,O kim ve neler oluyor?Dialogue: 50,0:09:56.74,0:09:58.41,Secondary-207-,,0,0,0,,Gemiyi terket...Dialogue: 50,0:09:58.41,0:10:00.83,Main-207-,,0,0,0,,yoksa Denizcileri çağıracağım!Dialogue: 50,0:10:00.83,0:10:03.46,Main-207-,,0,0,0,,Çok ciddiyim.Dialogue: 50,0:10:04.17,0:10:07.29,Main-207-,,0,0,0,,Neden bahsettiğini bilmiyorum! Benden ne istiyorsun?!Dialogue: 50,0:10:09.30,0:10:11.76,Main-207-,,0,0,0,,Tayfana katılmama izin ver.Dialogue: 50,0:10:11.76,0:10:12.88,Main-207-,,0,0,0,,– Ha?! – Ha?!Dialogue: 50,0:10:17.18,0:10:19.06,Flashbacks-207-,,0,0,0,,Bunu hemen ona içir.Dialogue: 50,0:10:19.06,0:10:22.02,Flashbacks-207-,,0,0,0,,Crocodile'ın zehrinin panzehiri.Dialogue: 50,0:10:22.35,0:10:24.23,Flashbacks-207-,,0,0,0,,Burada gömülü kalsa bile,Dialogue: 50,0:10:24.23,0:10:26.73,Flashbacks-207-,,0,0,0,,lastik vücudu hayatta kalmasını sağlayabilir.Dialogue: 50,0:10:29.07,0:10:30.65,Flashbacks-207-,,0,0,0,,O sırada...Dialogue: 50,0:10:31.28,0:10:34.57,Flashbacks-207-,,0,0,0,,sadece tarihin yazılı olduğunu söylemiştin.Dialogue: 50,0:10:37.62,0:10:39.20,Flashbacks-207-,,0,0,0,,Niye yalan söyledin?Dialogue: 50,0:10:42.00,0:10:43.00,Flashbacks-207-,,0,0,0,,Biliyor muydun...?Dialogue: 50,0:10:43.79,0:10:44.83,Flashbacks-207-,,0,0,0,,Çok kötüsün...Dialogue: 50,0:10:45.37,0:10:49.04,Flashbacks-207-,,0,0,0,,Bu ülkenin tarihi o taşa yazılı değil.Dialogue: 50,0:10:49.04,0:10:53.09,Flashbacks-207-,,0,0,0,,Orada tüm yazılı olan, örgütünün istediği silahla ilgili detaylar.Dialogue: 50,0:10:53.09,0:10:54.97,Flashbacks-207-,,0,0,0,,Ve elbette silahın yeri.Dialogue: 50,0:10:55.34,0:10:57.43,Flashbacks-207-,,0,0,0,,Crocodile için onu doğru çevirseydin,Dialogue: 50,0:10:57.43,0:11:00.85,Flashbacks-207-,,0,0,0,,bu ülke şu anda onun olurdu.Dialogue: 50,0:11:00.85,0:11:02.18,Flashbacks-207-,,0,0,0,,Yanılıyor muyum?Dialogue: 50,0:11:03.56,0:11:05.19,Flashbacks-207-,,0,0,0,,İlgilenmiyorum...Dialogue: 50,0:11:05.19,0:11:10.15,Flashbacks-207-,,0,0,0,,İnsanların ve ülkelerin yaşaması... Açıkçası hiç umurumda değil.Dialogue: 50,0:11:10.52,0:11:14.61,Flashbacks-207-,,0,0,0,,Başından beri Crocodile'a silahı vermek niyetinde değildim.Dialogue: 50,0:11:14.99,0:11:16.95,Flashbacks-207-,,0,0,0,,Anlamıyorum...Dialogue: 50,0:11:16.95,0:11:18.62,Flashbacks-207-,,0,0,0,,Öyleyse buraya neden geldin?Dialogue: 50,0:11:19.58,0:11:21.95,Flashbacks-207-,,0,0,0,,Umutlar ve beklentiler iki farklı şeydir.Dialogue: 50,0:11:23.25,0:11:26.58,Flashbacks-207-,,0,0,0,,Bulmak istediğim şey, Rio Poneglifi'dir.Dialogue: 50,0:11:23.25,0:11:26.58,Note-207-,,0,0,0,,Rio Poneglifi: Gerçek Tarihi Metin.Dialogue: 50,0:11:28.08,0:11:31.84,Flashbacks-207-,,0,0,0,,Dünyadaki bütün poneglifler içerisinde,Dialogue: 50,0:11:31.84,0:11:34.09,Flashbacks-207-,,0,0,0,,gerçek tarihi anlatan sadece o.Dialogue: 50,0:11:35.67,0:11:37.51,Flashbacks-207-,,0,0,0,,O, Rio poneglifi.Dialogue: 50,0:11:39.05,0:11:42.31,Flashbacks-207-,,0,0,0,,"Gerçek tarih" derken ne demek istiyorsun?Dialogue: 50,0:11:43.81,0:11:45.14,Flashbacks-207-,,0,0,0,,Artık yeter.Dialogue: 50,0:11:45.14,0:11:49.65,Flashbacks-207-,,0,0,0,,Yirmi yıl boyunca aradım ve bulduğum tek ipucu buydu.Dialogue: 50,0:11:49.65,0:11:53.53,Flashbacks-207-,,0,0,0,,Bu yer benim son umudumdu ve başarısızlıkla sonuçlandı.Dialogue: 50,0:11:53.53,0:11:56.40,Flashbacks-207-,,0,0,0,,Burada ölmem gerekiyorsa, bana uyar.Dialogue: 50,0:11:58.07,0:12:01.70,Flashbacks-207-,,0,0,0,,O kadar yorgunum ki… Artık bu şekilde devam edemeyeceğim.Dialogue: 50,0:12:06.58,0:12:09.33,Flashbacks-207-,,0,0,0,,Tek istediğim tarihi öğrenmekti.Dialogue: 50,0:12:11.34,0:12:12.84,Flashbacks-207-,,0,0,0,,Ama hayalimin önünde...Dialogue: 50,0:12:13.46,0:12:15.30,Flashbacks-207-,,0,0,0,,çok fazla düşman var.Dialogue: 50,0:12:16.17,0:12:17.59,Flashbacks-207-,,0,0,0,,Şunu merak ediyorum…Dialogue: 50,0:12:18.51,0:12:22.01,Flashbacks-207-,,0,0,0,,Anlatılmayan tarih gün ışığına çıkarılabilir mi?Dialogue: 50,0:12:22.01,0:12:24.89,Flashbacks-207-,,0,0,0,,Poneglifler'in o kaydı içerdiğini mi söylüyorsun?Dialogue: 50,0:12:26.60,0:12:29.02,Flashbacks-207-,,0,0,0,,Öyleyse neden biz...Dialogue: 50,0:12:34.40,0:12:35.65,Flashbacks-207-,,0,0,0,,Pekâlâ, gidelim.Dialogue: 50,0:12:35.65,0:12:36.61,Flashbacks-207-,,0,0,0,,Dur biraz!Dialogue: 50,0:12:36.61,0:12:38.57,Flashbacks-207-,,0,0,0,,Yaşamak için bir sebebim yok!Dialogue: 50,0:12:38.95,0:12:40.24,Flashbacks-207-,,0,0,0,,Beni burada bırak!Dialogue: 50,0:12:41.62,0:12:44.20,Flashbacks-207-,,0,0,0,,Niye seni dinleyeyim ki?Dialogue: 50,0:12:48.41,0:12:52.17,Main-207-,,0,0,0,,O sırada ölmeyi isterken, beni yaşamaya zorladın.Dialogue: 50,0:12:52.17,0:12:54.00,Main-207-,,0,0,0,,Bu senin suçun.Dialogue: 50,0:12:54.50,0:12:57.76,Main-207-,,0,0,0,,Gidecek veya dönecek bir yerim yok.Dialogue: 50,0:12:57.76,0:13:00.26,Main-207-,,0,0,0,,Bu yüzden bırak, bu gemide kalayım.Dialogue: 50,0:13:00.26,0:13:03.51,Main-207-,,0,0,0,,Oh, anladım... O zaman başka seçeneğimiz yok. Hoş geldin.Dialogue: 50,0:13:03.51,0:13:05.76,Main-207-,,0,0,0,,– Luffy! – Luffy!Dialogue: 50,0:13:05.76,0:13:07.77,Main-207-,,0,0,0,,Endişelenmeyin.Dialogue: 50,0:13:07.77,0:13:09.73,Main-207-,,0,0,0,,O kötü biri değil!Dialogue: 50,0:13:09.73,0:13:11.85,Main-207-,,0,0,0,,Mellorine! Mellor–Dialogue: 50,0:13:32.04,0:13:33.08,Main-207-,,0,0,0,,Dikkatini ver!Dialogue: 50,0:13:33.46,0:13:36.09,Main-207-,,0,0,0,,Sorularımı dürüstçe cevapla!Dialogue: 50,0:13:36.09,0:13:37.59,Main-207-,,0,0,0,,Bir daha soracağım.Dialogue: 50,0:13:37.59,0:13:38.63,Main-207-,,0,0,0,,Adın ne?!Dialogue: 50,0:13:39.92,0:13:42.80,Main-207-,,0,0,0,,Oh… Ben Usopp. Tanıştığımıza sevindim. Evet, sevindim.Dialogue: 50,0:13:42.80,0:13:44.35,Main-207-,,0,0,0,,Nico Robin.Dialogue: 50,0:13:44.35,0:13:45.68,Main-207-,,0,0,0,,Tamam, Nico Robin!Dialogue: 50,0:13:45.68,0:13:47.31,Main-207-,,0,0,0,,Mesleğin nedir?Dialogue: 50,0:13:47.31,0:13:48.35,Main-207-,,0,0,0,,Arkeologum.Dialogue: 50,0:13:48.35,0:13:49.48,Main-207-,,0,0,0,,Arkeolog mu?!Dialogue: 50,0:13:49.85,0:13:54.02,Main-207-,,0,0,0,,Uzun bir arkeolog soyundan geliyorum.Dialogue: 50,0:13:54.02,0:14:00.61,Main-207-,,0,0,0,,Aranan bir suçlu olma durumum, sanırım sekiz yaşlarımdayken başladı.Dialogue: 50,0:14:00.94,0:14:02.78,Main-207-,,0,0,0,,Bu, yirmi yıl önceydi.Dialogue: 50,0:14:02.78,0:14:06.12,Main-207-,,0,0,0,,O zamandan beri dikkat çekmemeye çalışıyorum.Dialogue: 50,0:14:06.12,0:14:09.45,Main-207-,,0,0,0,,Sekiz yaşından beri mi? Onca zamandır yalnız mıydın?Dialogue: 50,0:14:11.46,0:14:16.17,Main-207-,,0,0,0,,Hiçbir çocuk, denizde tek başına hayatta kalamaz.Dialogue: 50,0:14:16.96,0:14:19.34,Main-207-,,0,0,0,,Kendimi korumak ve...Dialogue: 50,0:14:19.34,0:14:22.05,Main-207-,,0,0,0,,hedefime ulaşmak için,Dialogue: 50,0:14:22.72,0:14:27.05,Main-207-,,0,0,0,,çeşitli haydutlarla ittifak yapmak zorunda kaldım.Dialogue: 50,0:14:27.05,0:14:28.26,Main-207-,,0,0,0,,Hikaye bu.Dialogue: 50,0:14:29.26,0:14:32.52,Main-207-,,0,0,0,,Bu yüzden, gölgelerde çalışmada oldukça yetkin hâle geldim.Dialogue: 50,0:14:32.52,0:14:34.73,Main-207-,,0,0,0,,İşinize çok yararım.Dialogue: 50,0:14:34.73,0:14:38.11,Main-207-,,0,0,0,,Oh...? Kendine çok güveniyor gibisin.Dialogue: 50,0:14:38.11,0:14:39.32,Main-207-,,0,0,0,,Uzmanlık alanın nedir?Dialogue: 50,0:14:41.15,0:14:42.15,Main-207-,,0,0,0,,Suikast.Dialogue: 50,0:14:42.15,0:14:46.91,Main-207-,,0,0,0,,Luffy! Onu sorgularken çok tehlikeli olduğu sonucuna vardım.Dialogue: 50,0:14:47.91,0:14:49.24,Main-207-,,0,0,0,,Dinlemiyor musunuz be?!Dialogue: 50,0:14:49.99,0:14:51.66,Main-207-,,0,0,0,,Cidden...!Dialogue: 50,0:14:52.04,0:14:54.54,Main-207-,,0,0,0,,Böylesine kolay aldatılmak… Zavallıca!Dialogue: 50,0:14:54.54,0:14:57.88,Main-207-,,0,0,0,,Birkaç gün önce, bir suç örgütünün başkan yardımcısıydı.Dialogue: 50,0:14:58.38,0:15:01.92,Main-207-,,0,0,0,,Böyle birinin bize katılmasına nasıl izin verebiliriz?Dialogue: 50,0:15:02.42,0:15:06.43,Main-207-,,0,0,0,,Bu aptalları kandırmış olabilirsin ama bende işe yaramaz!Dialogue: 50,0:15:06.43,0:15:09.51,Main-207-,,0,0,0,,Bir şey yapmaya kalkışırsan, seni atarım.Dialogue: 50,0:15:11.01,0:15:13.73,Main-207-,,0,0,0,,Peki. Bunu aklımda tutacağım.Dialogue: 50,0:15:13.73,0:15:15.60,Main-207-,,0,0,0,,Bu arada...Dialogue: 50,0:15:15.60,0:15:18.81,Main-207-,,0,0,0,,Crocodile'ın mücevherlerinden birazını getirmiştim.Dialogue: 50,0:15:20.61,0:15:23.32,Main-207-,,0,0,0,,Vay, Abla! Seni seviyorum!Dialogue: 50,0:15:23.32,0:15:24.53,Main-207-,,0,0,0,,– Hey, hey, hey, hey... – Hey, hey, hey, hey...Dialogue: 50,0:15:24.53,0:15:26.28,Main-207-,,0,0,0,,Nami'yi de kaybettik!Dialogue: 50,0:15:26.28,0:15:27.78,Main-207-,,0,0,0,,Bu çok hilekârcaydı.Dialogue: 50,0:15:27.78,0:15:29.53,Main-207-,,0,0,0,,Tamamen büyüsüne kapılmış.Dialogue: 50,0:15:29.53,0:15:30.66,Main-207-,,0,0,0,,– Ha? – Ha?Dialogue: 50,0:15:32.83,0:15:34.71,Main-207-,,0,0,0,,Ah, aşk...Dialogue: 50,0:15:34.71,0:15:36.00,Main-207-,,0,0,0,,Yanında süzülen...Dialogue: 50,0:15:36.00,0:15:40.71,Main-207-,,0,0,0,,alev almış bir odun parçasından başka bir şey değilim.Dialogue: 50,0:15:41.71,0:15:42.71,Main-207-,,0,0,0,,Hazine...Dialogue: 50,0:15:42.71,0:15:44.67,Main-207-,,0,0,0,,Güzelliğin yıldırım gibi beni çarptı.Dialogue: 50,0:15:44.67,0:15:47.80,Main-207-,,0,0,0,,Irmakların paramparça ettiği odun parçasıyım.Dialogue: 50,0:15:48.68,0:15:49.93,Main-207-,,0,0,0,,Sizin için, leydim.Dialogue: 50,0:15:49.93,0:15:51.39,Main-207-,,0,0,0,,Oh, teşekkürler.Dialogue: 50,0:15:51.39,0:15:53.60,Main-207-,,0,0,0,,Hiç şaşırmadım.Dialogue: 50,0:15:53.60,0:15:54.43,Main-207-,,0,0,0,,Evet...Dialogue: 50,0:15:54.43,0:15:57.10,Main-207-,,0,0,0,,Zaten hiç şansı yoktu...Dialogue: 50,0:15:57.10,0:15:58.23,Main-207-,,0,0,0,,Ve böylece...Dialogue: 50,0:15:59.19,0:16:02.94,Main-207-,,0,0,0,,güçlü durmak bize kaldı.Dialogue: 50,0:16:02.94,0:16:06.36,Main-207-,,0,0,0,,Evet, ne kadar zayıflar! Tamamen boyun eğdiler.Dialogue: 50,0:16:06.36,0:16:07.82,Main-207-,,0,0,0,,Hey, Usopp!Dialogue: 50,0:16:06.90,0:16:07.82,Secondary-207-,,0,0,0,,Ne?!Dialogue: 50,0:16:08.32,0:16:09.87,Main-207-,,0,0,0,,Chopper!Dialogue: 50,0:16:16.54,0:16:18.12,Main-207-,,0,0,0,,Sana Robin-chwan mı desem?Dialogue: 50,0:16:18.62,0:16:20.25,Main-207-,,0,0,0,,Ya da Robin-swan mı?Dialogue: 50,0:16:20.25,0:16:21.96,Main-207-,,0,0,0,,Hangisi?Dialogue: 50,0:16:21.96,0:16:23.17,Main-207-,,0,0,0,,Oh? Nereye gidiyorsun?Dialogue: 50,0:16:27.34,0:16:29.38,Main-207-,,0,0,0,,Ne kadın ama...Dialogue: 50,0:16:29.38,0:16:33.31,Main-207-,,0,0,0,,Nami-san'dan çok farklı, daha olgun bir güzelliği var!Dialogue: 50,0:16:38.19,0:16:40.44,Main-207-,,0,0,0,,Güzel bir gemi...Dialogue: 50,0:16:40.44,0:16:42.44,Main-207-,,0,0,0,,Her zaman böyle hareketli midir?Dialogue: 50,0:16:43.19,0:16:44.90,Main-207-,,0,0,0,,Evet, öyledir.Dialogue: 50,0:16:45.48,0:16:46.69,Main-207-,,0,0,0,,Anlıyorum.Dialogue: 50,0:16:49.24,0:16:52.07,Thoughts-207-,,0,0,0,,Ne dolaplar çeviriyor?Dialogue: 50,0:16:58.33,0:17:01.42,Main-207-,,0,0,0,,Bu arada, Bayan Rotacı. Şu anda her şey yolunda mı?Dialogue: 50,0:17:01.42,0:17:03.92,Main-207-,,0,0,0,,Rüzgârda ve havada bir sorun yok!Dialogue: 50,0:17:03.92,0:17:06.42,Main-207-,,0,0,0,,Her şey mükemmel, Robin abla!Dialogue: 50,0:17:06.42,0:17:08.80,Main-207-,,0,0,0,,Demek seni satın aldı, ha?Dialogue: 50,0:17:08.80,0:17:10.93,Main-207-,,0,0,0,,Sanji, atıştırmalığım hazır mı?!Dialogue: 50,0:17:10.93,0:17:12.43,Main-207-,,0,0,0,,Az sabırlı ol!Dialogue: 0,0:01:49.96,0:01:54.34,Title-207-,,0,0,0,,Kaçak YolcuDialogue: 1,0:01:49.96,0:01:54.34,Title-207-,,0,0,0,,Kaçak YolcuDialogue: 0,0:00:01.73,0:00:03.73,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 1,0:00:01.73,0:00:03.73,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 0,0:00:01.73,0:00:03.73,Credits-207-,,0,0,0,,fedew GigglebotDialogue: 1,0:00:01.73,0:00:03.73,Credits-207-,,0,0,0,,fedew GigglebotDialogue: 0,0:00:03.73,0:00:05.73,Credits-207-,,0,0,0,,ZamanlamaDialogue: 1,0:00:03.73,0:00:05.73,Credits-207-,,0,0,0,,ZamanlamaDialogue: 0,0:00:03.73,0:00:05.73,Credits-207-,,0,0,0,,GabDialogue: 1,0:00:03.73,0:00:05.73,Credits-207-,,0,0,0,,GabDialogue: 0,0:00:05.73,0:00:09.73,Credits-207-,,0,0,0,,Kalite KontrolDialogue: 1,0:00:05.73,0:00:09.73,Credits-207-,,0,0,0,,Kalite KontrolDialogue: 0,0:00:05.73,0:00:09.73,Credits-207-,,0,0,0,,Gab Galaxy 9000 Pepperjack Scolines ZenefDialogue: 1,0:00:05.73,0:00:09.73,Credits-207-,,0,0,0,,Gab Galaxy 9000 Pepperjack Scolines ZenefDialogue: 0,0:00:09.73,0:00:11.73,Credits-207-,,0,0,0,,MüzikDialogue: 1,0:00:09.73,0:00:11.73,Credits-207-,,0,0,0,,MüzikDialogue: 0,0:00:09.73,0:00:11.73,Credits-207-,,0,0,0,,HaleeDialogue: 1,0:00:09.73,0:00:11.73,Credits-207-,,0,0,0,,HaleeDialogue: 0,0:00:11.73,0:00:13.73,Credits-207-,,0,0,0,,GrafikDialogue: 1,0:00:11.73,0:00:13.73,Credits-207-,,0,0,0,,GrafikDialogue: 0,0:00:11.73,0:00:13.73,Credits-207-,,0,0,0,,DatenshiDialogue: 1,0:00:11.73,0:00:13.73,Credits-207-,,0,0,0,,DatenshiDialogue: 0,0:00:13.73,0:00:15.73,Credits-207-,,0,0,0,,KaraokeDialogue: 1,0:00:13.73,0:00:15.73,Credits-207-,,0,0,0,,KaraokeDialogue: 0,0:00:13.73,0:00:15.73,Credits-207-,,0,0,0,,KaitouYahikoDialogue: 1,0:00:13.73,0:00:15.73,Credits-207-,,0,0,0,,KaitouYahikoDialogue: 0,0:00:15.73,0:00:17.73,Credits-207-,,0,0,0,,Altyazı Düz