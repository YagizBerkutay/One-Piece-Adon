gue: 0,0:02:22.85,0:02:26.69,Roger-Monologue,,0,0,0,,Son sözleri dünyanın her yerinden maceracıları denize çekti.Dialogue: 0,0:02:26.69,0:02:28.69,Roger-Monologue,,0,0,0,,Hazinem mi?Dialogue: 0,0:02:28.69,0:02:30.48,Roger-Monologue,,0,0,0,,İstiyorsanız, alabilirsiniz.Dialogue: 0,0:02:30.48,0:02:31.69,Roger-Monologue,,0,0,0,,Arayıp bulun!Dialogue: 0,0:02:31.69,0:02:34.28,Roger-Monologue,,0,0,0,,Bu dünyanın sunabileceği her şeyi orada bıraktım!Dialogue: 0,0:02:36.70,0:02:41.41,Roger-Monologue,,0,0,0,,Artık herkes, hayallerinin peşinde Grand Line’a yelken açıyor!Dialogue: 0,0:02:41.41,0:02:44.66,Roger-Monologue,,0,0,0,,Dünya, Büyük Korsan Çağı'na girdi!Dialogue: 0,0:02:44.94,0:02:50.38,Lyrics,,0,0,0,fx,ADialogue: 0,0:02:44.94,0:02:50.38,Lyrics,,0,0,0,fx,tDialogue: 0,0:02:44.94,0:02:50.38,Lyrics,,0,0,0,fx,lDialogue: 0,0:02:44.94,0:02:50.38,Lyrics,,0,0,0,fx,aDialogue: 0,0:02:44.94,0:02:50.38,Lyrics,,0,0,0,fx,yDialogue: 0,0:02:44.94,0:02:50.38,Lyrics,,0,0,0,fx,ıDialogue: 0,0:02:44.94,0:02:50.38,Lyrics,,0,0,0,fx,nDialogue: 0,0:02:44.94,0:02:50.38,Lyrics,,0,0,0,fx,Dialogue: 0,0:02:44.94,0:02:50.38,Lyrics,,0,0,0,fx,gDialogue: 0,0:02:44.94,0:02:50.38,Lyrics,,0,0,0,fx,eDialogue: 0,0:02:44.94,0:02:50.38,Lyrics,,0,0,0,fx,mDialogue: 0,0:02:44.94,0:02:50.38,Lyrics,,0,0,0,fx,iDialogue: 0,0:02:44.94,0:02:50.38,Lyrics,,0,0,0,fx,yDialogue: 0,0:02:44.94,0:02:50.38,Lyrics,,0,0,0,fx,eDialogue: 0,0:02:44.94,0:02:50.38,Lyrics,,0,0,0,fx,,Dialogue: 0,0:02:44.94,0:02:50.38,Lyrics,,0,0,0,fx,Dialogue: 0,0:02:44.94,0:02:50.38,Lyrics,,0,0,0,fx,gDialogue: 0,0:02:44.94,0:02:50.38,Lyrics,,0,0,0,fx,eDialogue: 0,0:02:44.94,0:02:50.38,Lyrics,,0,0,0,fx,tDialogue: 0,0:02:44.94,0:02:50.38,Lyrics,,0,0,0,fx,iDialogue: 0,0:02:44.94,0:02:50.38,Lyrics,,0,0,0,fx,rDialogue: 0,0:02:44.94,0:02:50.38,Lyrics,,0,0,0,fx,iDialogue: 0,0:02:44.94,0:02:50.38,Lyrics,,0,0,0,fx,nDialogue: 0,0:02:44.94,0:02:50.38,Lyrics,,0,0,0,fx,Dialogue: 0,0:02:44.94,0:02:50.38,Lyrics,,0,0,0,fx,uDialogue: 0,0:02:44.94,0:02:50.38,Lyrics,,0,0