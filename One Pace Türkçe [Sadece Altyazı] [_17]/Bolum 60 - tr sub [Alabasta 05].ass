[Script Info]Title: Default Aegisub fileScriptType: v4.00+WrapStyle: 0ScaledBorderAndShadow: yesYCbCr Matrix: TV.709PlayResX: 1440PlayResY: 1080[V4+ Styles]Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, EncodingStyle: Main-480p,Impress BT,80,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.9,3.9,2,180,180,27,1Style: Thoughts-480p,Impress BT,80,&H00FFFFFF,&H00FFFFFF,&H00525252,&H78000000,0,0,0,0,100,100,0,0,1,4.5,3.9375,2,180,180,27,1Style: Flashbacks-480p,Impress BT,80,&H00FFFFFF,&H00FFFFFF,&H00525252,&H78000000,0,-1,0,0,100,100,0,0,1,3.9375,3.9375,2,180,180,27,1Style: Secondary-480p,Impress BT,80,&H00D6D6D6,&H00FFFFFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.9375,3.9375,2,180,180,27,1Style: Title-480p,Gilroy-Bold,95,&H00FEFEFE,&H00002EFF,&H00000000,&H00000000,0,0,0,0,100.0,100,0.1,0,1,2.25,0,2,23,23,383,1Style: Captionsşv2-480p,Gilroy-Bold,85,&H00FFFFFF,&H000019FF,&H00000000,&H00000000,0,0,0,0,100,100,0.1,0,1,3.375,0,2,16,16,27,1Style: Credits-480p,Gilroy-Medium,43,&H00FFFFFF,&H00002EFF,&H00000000,&H00000000,0,0,0,0,95,100,1.6,0,1,5,0,7,16,16,16,1Style: RogerMonologue,Impress BT,80,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1Style: Note,Impress BT,55,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,2.0,2.0,8,10,10,10,1Style: Karaoke,Duality,68,&H00292CC7,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,4,0,1,6.8,0,8,23,23,23,1Style: Translation,Duality,68,&H00292CC7,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,4,0,1,6.8,0,2,23,23,34,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 5,0:01:54.90,0:01:59.17,Main-480p,,0,0,0,,Üç yıldır yağmur yağmadıysa ne olmuş?Dialogue: 5,0:02:00.62,0:02:07.45,Main-480p,,0,0,0,,Ben hâlâ Majestelerine inanıyorum, ülkenin çoğu da öyle.Dialogue: 5,0:02:09.98,0:02:11.52,Main-480p,,0,0,0,,Kaç kez...Dialogue: 5,0:02:11.52,0:02:13.55,Main-480p,,0,0,0,,Kaç kez onları durdurmaya çalıştım...Dialogue: 5,0:02:15.67,0:02:18.47,Main-480p,,0,0,0,,Bir kez olsun dinlemediler beni.Dialogue: 5,0:02:18.47,0:02:20.53,Main-480p,,0,0,0,,İsyan durmayacak.Dialogue: 5,0:02:21.35,0:02:25.32,Main-480p,,0,0,0,,Güçlerinin sınırına ulaştılar.Dialogue: 5,0:02:25.32,0:02:29.00,Main-480p,,0,0,0,,Sıradaki saldırılarıyla her şeyi sona erdirmeyi planlıyorlar.Dialogue: 5,0:02:29.49,0:02:32.15,Main-480p,,0,0,0,,Köşeye sıkıştırıldılar…Dialogue: 5,0:02:36.33,0:02:37.88,Main-480p,,0,0,0,,Ölmeye hazırlar!Dialogue: 5,0:02:41.26,0:02:46.28,Main-480p,,0,0,0,,Lütfen, Vivi-chan! O aptalları durdurmalısın!Dialogue: 5,0:03:03.82,0:03:05.49,Main-480p,,0,0,0,,– Lider nerede? – İçeride.Dialogue: 5,0:03:21.86,0:03:24.89,Main-480p,,0,0,0,,Toto amca, müsterih olun.Dialogue: 5,0:03:25.44,0:03:26.63,Main-480p,,0,0,0,,Vivi-chan...Dialogue: 5,0:03:28.49,0:03:31.44,Main-480p,,0,0,0,,İsyanı durduracağız.Dialogue: 5,0:03:41.31,0:03:42.74,Main-480p,,0,0,0,,Teşekkür ederim!Dialogue: 5,0:04:00.22,0:04:03.46,Flashbacks-480p,,0,0,0,,Elveda, Vivi-chan. Şimdilik veda vakti.Dialogue: 5,0:04:03.46,0:04:07.37,Flashbacks-480p,,0,0,0,,Şehir bir şeye benzemeye başladığında ziyarete gel.Dialogue: 5,0:04:07.37,0:04:09.43,Flashbacks-480p,,0,0,0,,Olur, Toto amca!Dialogue: 5,0:04:10.04,0:04:14.44,Flashbacks-480p,,0,0,0,,Bu ülkenin yeşilliğine yeşillik katacak görkemli bir şehir kuracağız!Dialogue: 5,0:04:17.80,0:04:21.36,Flashbacks-480p,,0,0,0,,Görüşürüz, Vivi! Büyü ve iyi bir prenses ol!Dialogue: 5,0:04:22.08,0:04:23.45,Flashbacks-480p,,0,0,0,,Tamam!Dialogue: 5,0:04:35.70,0:04:36.71,Main-480p,,0,0,0,,Koza!Dialogue: 5,0:04:37.47,0:04:39.61,Main-480p,,0,0,0,,Diğer şehirdeki herkesle iletişime geçtim.Dialogue: 5,0:04:45.40,0:04:49.24,Main-480p,,0,0,0,,Vakit tamam. Harekete geçme zamanı.Dialogue: 5,0:04:49.24,0:04:53.43,Main-480p,,0,0,0,,Evet ama yeteri kadar silahımız yok.Dialogue: 5,0:04:54.52,0:04:57.02,Main-480p,,0,0,0,,Yine de ya şimdi ya asla.Dialogue: 5,0:04:58.80,0:05:01.52,Main-480p,,0,0,0,,Bu ülkeyi koruyabilecek olanlar...Dialogue: 5,0:05:04.52,0:05:05.53,Main-480p,,0,0,0,,sadece bizleriz!Dialogue: 5,0:05:07.85,0:05:09.32,Flashbacks-480p,,0,0,0,,İzin vermem!Dialogue: 5,0:05:09.32,0:05:11.37,Flashbacks-480p,,0,0,0,,Onu ölümüne koruyun, Kum-Kum Klanı!Dialogue: 5,0:05:25.10,0:05:26.88,Main-480p,,0,0,0,,Güya korumalar ha?Dialogue: 5,0:05:26.88,0:05:28.51,Main-480p,,0,0,0,,Başkaları da mı var?!Dialogue: 5,0:05:30.01,0:05:31.72,Main-480p,,0,0,0,,Ah! Ah! Ah!Dialogue: 5,0:05:32.44,0:05:33.39,Main-480p,,0,0,0,,Lan! Kaçtı!Dialogue: 5,0:05:35.82,0:05:38.23,Main-480p,,0,0,0,,Harabelere doğru gidiyor! Yakalayın onu!Dialogue: 5,0:05:41.19,0:05:42.44,Main-480p,,0,0,0,,Engel olun!Dialogue: 5,0:05:44.62,0:05:45.32,Main-480p,,0,0,0,,Çekilin!Dialogue: 5,0:05:49.30,0:05:50.99,Main-480p,,0,0,0,,Bu ne böyle?!Dialogue: 5,0:05:57.68,0:06:01.96,Main-480p,,0,0,0,,Hey! Size ne oldu?! Burada ne oldu?!Dialogue: 5,0:06:02.94,0:06:06.31,Main-480p,,0,0,0,,Kötü adamlar... Vivi'nin peşinde...Dialogue: 5,0:06:06.31,0:06:07.38,Main-480p,,0,0,0,,Ne?!Dialogue: 5,0:06:08.49,0:06:10.58,Main-480p,,0,0,0,,Silahları vardı...Dialogue: 5,0:06:10.58,0:06:12.45,Main-480p,,0,0,0,,Harabelere doğru gittiler!Dialogue: 5,0:06:12.45,0:06:14.35,Main-480p,,0,0,0,,Koza da arkalarından gitti!Dialogue: 5,0:06:14.82,0:06:16.02,Main-480p,,0,0,0,,Ne?!Dialogue: 5,0:06:19.99,0:06:26.20,Main-480p,,0,0,0,,– Oo, Prenses! – Neredesiniz, Prenses?Dialogue: 5,0:06:26.20,0:06:28.04,Main-480p,,0,0,0,,Nerede saklanıyorsun lan?Dialogue: 5,0:06:28.04,0:06:30.68,Main-480p,,0,0,0,,Bulun onu! Kaçmasına izin vermeyin!Dialogue: 5,0:06:30.68,0:06:34.33,Main-480p,,0,0,0,,Prenses Vivi! Hadi çık ortaya!Dialogue: 5,0:06:42.60,0:06:44.63,Main-480p,,0,0,0,,Demek buradasın!Dialogue: 5,0:06:46.05,0:06:49.13,Main-480p,,0,0,0,,Lütfen uslu ol da artık kaçıralım seni!Dialogue: 5,0:06:51.92,0:06:53.54,Main-480p,,0,0,0,,Dur lan!Dialogue: 5,0:06:54.64,0:06:56.01,Main-480p,,0,0,0,,Lider!Dialogue: 5,0:06:57.69,0:06:59.17,Main-480p,,0,0,0,,İyi misin, Vivi?!Dialogue: 5,0:07:00.63,0:07:02.02,Main-480p,,0,0,0,,Kafam...Dialogue: 5,0:07:02.81,0:07:05.90,Main-480p,,0,0,0,,Kum-Kum Klanını küçümseme, seni şeytan!Dialogue: 5,0:07:06.39,0:07:08.40,Main-480p,,0,0,0,,Bu şehri terket!Dialogue: 5,0:07:08.40,0:07:13.01,Main-480p,,0,0,0,,Bak buraya, çocuk. Saçmalamayı bırak da prensesi bize ver.Dialogue: 5,0:07:14.37,0:07:17.60,Main-480p,,0,0,0,,Bizi kızdırmak akıllıca olmaz.Dialogue: 5,0:07:17.60,0:07:20.21,Main-480p,,0,0,0,,Kılıcı var! Kaçalım, Lider!Dialogue: 5,0:07:21.61,0:07:24.29,Main-480p,,0,0,0,,– Bu beni korkutmuyor! – Ha?!Dialogue: 5,0:07:29.88,0:07:32.18,Flashbacks-480p,,0,0,0,,Onu ölümüne koruyun, Kum-Kum Klanı!Dialogue: 5,0:07:33.21,0:07:35.27,Main-480p,,0,0,0,,Lider! Yapma bunu!Dialogue: 5,0:07:35.27,0:07:37.72,Main-480p,,0,0,0,,Dövüşmek istiyorsun ha?Dialogue: 5,0:08:12.93,0:08:13.63,Main-480p,,0,0,0,,Lider!Dialogue: 5,0:08:15.39,0:08:18.64,Main-480p,,0,0,0,,O serseri, patronu yere serdi!Dialogue: 5,0:08:19.39,0:08:22.85,Main-480p,,0,0,0,,Nasıl olur lan?! Şunu iyice bir dövelim!Dialogue: 5,0:08:25.28,0:08:27.10,Main-480p,,0,0,0,,İyi madem! Gel buraya!Dialogue: 5,0:08:27.10,0:08:28.69,Main-480p,,0,0,0,,Ulan!Dialogue: 5,0:08:30.84,0:08:32.69,Main-480p,,0,0,0,,Ahmaklar!Dialogue: 5,0:08:33.19,0:08:35.20,Main-480p,,0,0,0,,Baba! Igaram!Dialogue: 5,0:08:35.77,0:08:37.93,Main-480p,,0,0,0,,Vivi-sama! İyi misiniz?!Dialogue: 5,0:08:37.11,0:08:37.93,Secondary-480p,,0,0,0,,Pislikler!Dialogue: 5,0:08:37.93,0:08:41.16,Main-480p,,0,0,0,,Kızımı kaçıracağınızı mı düşündünüz?!Dialogue: 5,0:08:41.16,0:08:45.71,Main-480p,,0,0,0,,Alçak serseriler! Al bunu! Bunu da! Bunu da!Dialogue: 5,0:08:45.71,0:08:47.54,Main-480p,,0,0,0,,Bunlar da dostları gibi görünüyor.Dialogue: 5,0:08:48.98,0:08:52.59,Main-480p,,0,0,0,,Chaka! Pell! Ne yapıyorsunuz burada?Dialogue: 5,0:08:53.30,0:08:56.42,Main-480p,,0,0,0,,Ne mi yapıyoruz? Aynısını biz de size soruyoruz.Dialogue: 5,0:08:56.42,0:09:00.20,Main-480p,,0,0,0,,Kral neden sarayın dışında, böyle bir yerde bulunuyor?Dialogue: 5,0:09:00.74,0:09:03.19,Main-480p,,0,0,0,,Bu kadar dikkatsiz hareket etmemelisiniz.Dialogue: 5,0:09:05.12,0:09:06.56,Main-480p,,0,0,0,,Igaram! Koza yaralandı!Dialogue: 5,0:09:07.00,0:09:09.84,Main-480p,,0,0,0,,Evet! Hemen doktora görünmesi gerekiyor!Dialogue: 5,0:09:09.84,0:09:12.28,Main-480p,,0,0,0,,Kum-Kum Klanı'nın diğer üyeleri de tepede!Dialogue: 5,0:09:12.28,0:09:14.12,Main-480p,,0,0,0,,İkiniz derhâl bu durumla ilgilenin!Dialogue: 5,0:09:14.12,0:09:14.53,Main-480p,,0,0,0,,Başüstüne!Dialogue: 5,0:09:15.96,0:09:18.06,Main-480p,,0,0,0,,Epey cesur çocuklar!Dialogue: 5,0:09:24.40,0:09:28.46,Main-480p,,0,0,0,,Sorun ne, Vivi? Neden bu kadar üzgünsün?Dialogue: 5,0:09:29.13,0:09:31.97,Main-480p,,0,0,0,,Çok korkmuştum...Dialogue: 5,0:09:33.26,0:09:34.92,Main-480p,,0,0,0,,Evet, ben de...Dialogue: 5,0:09:35.56,0:09:37.93,Main-480p,,0,0,0,,Yanlarında kılıçları bile vardı...Dialogue: 5,0:09:38.80,0:09:39.84,Main-480p,,0,0,0,,Konu o değil!Dialogue: 5,0:09:41.26,0:09:46.35,Main-480p,,0,0,0,,Beni ölene kadar korumalarını söyledin, Lider...Dialogue: 5,0:09:46.35,0:09:48.89,Flashbacks-480p,,0,0,0,,Onu ölümüne koruyun, Kum-Kum Klanı!Dialogue: 5,0:09:53.45,0:09:57.00,Main-480p,,0,0,0,,Ölmekten bahsetmeyin, Lider...Dialogue: 5,0:09:59.31,0:10:03.59,Thoughts-480p,,0,0,0,,Her şeyden çok, arkadaşlarını kaybetmekten korkmuş.Dialogue: 5,0:10:14.13,0:10:17.68,Main-480p,,0,0,0,,Vivi çocuk olabilir ama o yine de bir prenses, Koza.Dialogue: 5,0:10:18.26,0:10:21.84,Main-480p,,0,0,0,,Bugünkü muazzam kahramanlığın göz ardı edilmeyecek.Dialogue: 5,0:10:21.84,0:10:24.22,Main-480p,,0,0,0,,Sana minnettarım. Teşekkür ederim.Dialogue: 5,0:10:25.42,0:10:28.64,Main-480p,,0,0,0,,Vivi arkadaşımız. Gerekeni yaptık.Dialogue: 5,0:10:29.55,0:10:30.60,Main-480p,,0,0,0,,Anlıyorum.Dialogue: 5,0:10:30.60,0:10:34.99,Main-480p,,0,0,0,,Alabasta'nın geleceğinin emin ellerde olduğunu görebiliyorum.Dialogue: 5,0:10:34.99,0:10:36.82,Main-480p,,0,0,0,,Bu ülkeyi seviyor musun?Dialogue: 5,0:10:36.82,0:10:39.61,Main-480p,,0,0,0,,Evet! Burası benim vatanım!Dialogue: 5,0:10:39.61,0:10:41.35,Main-480p,,0,0,0,,Aynı hissediyoruz!Dialogue: 5,0:10:43.57,0:10:45.03,Main-480p,,0,0,0,,Bir şey...Dialogue: 5,0:10:47.93,0:10:50.44,Main-480p,,0,0,0,,Bir şey beni rahatsız ediyor.Dialogue: 5,0:10:50.44,0:10:51.54,Main-480p,,0,0,0,,Nedir?Dialogue: 5,0:10:52.92,0:10:58.26,Main-480p,,0,0,0,,Mevkinizi durmadan zor kararlar almanızı gerektiriyor.Dialogue: 5,0:10:58.26,0:11:01.59,Main-480p,,0,0,0,,Vivi-sama'nın kalbi bunun için çok hassas.Dialogue: 5,0:11:01.59,0:11:03.45,Main-480p,,0,0,0,,Igaram.Dialogue: 5,0:11:03.45,0:11:04.27,Main-480p,,0,0,0,,Buyurun?Dialogue: 5,0:11:05.70,0:11:09.74,Main-480p,,0,0,0,,Bu iyi. Alabasta için gayet iyi.Dialogue: 5,0:11:15.33,0:11:20.58,Main-480p,,0,0,0,,Son nefesime kadar size hizmet edeceğim.Dialogue: 5,0:11:21.55,0:11:22.61,Main-480p,,0,0,0,,Yuba mı?Dialogue: 5,0:11:22.61,0:11:27.04,Main-480p,,0,0,0,,Evet! Baban, babamla konuştu!Dialogue: 5,0:11:27.04,0:11:28.91,Main-480p,,0,0,0,,Toto amcayla mı?Dialogue: 5,0:11:28.91,0:11:33.88,Main-480p,,0,0,0,,Yuba'nın ıssız vahasında şehir kurmak ister mi diye sormuş!Dialogue: 5,0:11:36.19,0:11:39.82,Main-480p,,0,0,0,,Her türden gezgin ve tüccar oradan geçiyor!Dialogue: 5,0:11:39.82,0:11:43.08,Main-480p,,0,0,0,,O bölge Alabasta'nın kalbinde.Dialogue: 5,0:11:43.65,0:11:46.30,Main-480p,,0,0,0,,Şehir tam olana dek sabırla bekle!Dialogue: 5,0:11:46.30,0:11:49.32,Main-480p,,0,0,0,,Bu pek çok vatandaşı mutlu edecek!Dialogue: 5,0:11:52.80,0:11:53.77,Main-480p,,0,0,0,,Harika ha?!Dialogue: 5,0:11:54.74,0:11:58.15,Main-480p,,0,0,0,,Babamın da oranın temsilcisi olması istendi!Dialogue: 5,0:11:58.15,0:11:59.84,Main-480p,,0,0,0,,Sen de gidecek misin, Lider?Dialogue: 5,0:11:59.84,0:12:00.99,Main-480p,,0,0,0,,Elbette!Dialogue: 5,0:12:01.38,0:12:03.78,Main-480p,,0,0,0,,Babam burada kalmamı istiyor.Dialogue: 5,0:12:04.43,0:12:08.21,Main-480p,,0,0,0,,Şehir kurmak hiç kolay değil ama...Dialogue: 5,0:12:08.21,0:12:09.35,Main-480p,,0,0,0,,ben başaracağım!Dialogue: 5,0:12:09.35,0:12:11.75,Main-480p,,0,0,0,,Kendi ellerimle yeni bir şehir kuracağım!Dialogue: 5,0:12:12.44,0:12:15.03,Main-480p,,0,0,0,,Bu ülkenin Yuba'ya ihtiyacı var!Dialogue: 5,0:12:23.47,0:12:25.36,Main-480p,,0,0,0,,Gururlandır bizi, Toto!Dialogue: 5,0:12:25.36,0:12:29.89,Main-480p,,0,0,0,,Elbette, Majesteleri! Muazzam bir şehir inşa edeceğiz!Dialogue: 5,0:12:30.50,0:12:33.39,Main-480p,,0,0,0,,Elveda, Vivi-chan. Şimdilik veda vakti.Dialogue: 5,0:12:33.39,0:12:37.11,Main-480p,,0,0,0,,Şehir bir şeye benzemeye başladığında ziyarete gel.Dialogue: 5,0:12:37.61,0:12:39.40,Main-480p,,0,0,0,,Olur, Toto amca!Dialogue: 5,0:12:40.13,0:12:44.20,Main-480p,,0,0,0,,Bu ülkenin yeşilliğine yeşillik katacak görkemli bir şehir kuracağız!Dialogue: 5,0:12:44.20,0:12:46.16,Main-480p,,0,0,0,,Gitme vakti!Dialogue: 5,0:12:46.16,0:12:50.65,Main-480p,,0,0,0,,Görüşürüz, Vivi! Büyü ve iyi bir prenses ol!Dialogue: 5,0:12:51.66,0:12:52.63,Main-480p,,0,0,0,,Evet!Dialogue: 5,0:12:54.63,0:12:57.03,Main-480p,,0,0,0,,Koza! Ona karşı fazla samimisin!Dialogue: 5,0:12:57.03,0:12:57.89,Main-480p,,0,0,0,,Ah!Dialogue: 5,0:12:59.57,0:13:01.67,Main-480p,,0,0,0,,Koza haklı.Dialogue: 5,0:13:02.79,0:13:06.07,Flashbacks-480p,,0,0,0,,Yuba, bu ülkenin yeşilliğine yeşillik katacak.Dialogue: 5,0:13:11.45,0:13:15.59,Main-480p,,0,0,0,,Mükemmel iş çıkardınız, adamlarım!Dialogue: 5,0:13:16.27,0:13:21.48,Main-480p,,0,0,0,,Şimdi uyuyun, yarın için gücümüzü toplamamız gerekiyor!Dialogue: 5,0:13:21.48,0:13:22.99,Main-480p,,0,0,0,,İyi uykular!Dialogue: 5,0:13:25.10,0:13:26.88,Main-480p,,0,0,0,,Tüm gün uyudun zaten!Dialogue: 5,0:13:27.40,0:13:28.96,Main-480p,,0,0,0,,Lanet olası...Dialogue: 5,0:13:28.96,0:13:32.08,Main-480p,,0,0,0,,Siz canavarlar gibi dayanıklı değilim!Dialogue: 5,0:13:32.70,0:13:35.26,Main-480p,,0,0,0,,İyi halt yedin!Dialogue: 5,0:13:36.02,0:13:39.84,Main-480p,,0,0,0,,Zaten tüm gün yatıp uyuma rekoru sana ait, mavi burunlu!Dialogue: 5,0:13:39.84,0:13:41.88,Main-480p,,0,0,0,,Bu iklim bana göre değil!Dialogue: 5,0:13:41.88,0:13:43.38,Main-480p,,0,0,0,,Sanji-san, orası benim–Dialogue: 5,0:13:43.38,0:13:46.76,Main-480p,,0,0,0,,Evet. Tek uyurken zorlanırsın diye düşündüm.Dialogue: 5,0:13:47.84,0:13:50.80,Main-480p,,0,0,0,,Amacın ne senin bakayım?Dialogue: 5,0:13:50.80,0:13:52.64,Main-480p,,0,0,0,,Cesaretlisin ha?!Dialogue: 5,0:13:52.64,0:13:55.77,Main-480p,,0,0,0,,Hanginiz bana karşı gelmeye hazır?!Dialogue: 5,0:13:55.77,0:13:58.52,Main-480p,,0,0,0,,Uyku nedir bilmez misiniz?!Dialogue: 5,0:13:59.58,0:14:01.15,Main-480p,,0,0,0,,Pekâlâ! Şimdi kaşındınız!Dialogue: 5,0:14:12.14,0:14:17.66,Main-480p,,0,0,0,,Hey, ihtiyar. Hâlâ su çıkmadı. Boğazım kurudu...Dialogue: 5,0:14:17.66,0:14:20.58,Main-480p,,0,0,0,,Böyle bir yerde nasıl yaşıyorsun ki? Çok kötü burası.Dialogue: 5,0:14:20.58,0:14:24.70,Main-480p,,0,0,0,,Su çıkacak. Yuba Vaha'sı hâlâ canlı.Dialogue: 5,0:14:24.70,0:14:27.46,Main-480p,,0,0,0,,Yuba, öyle adi kumlara boyun eğecek değil!Dialogue: 5,0:14:27.46,0:14:29.75,Main-480p,,0,0,0,,Ne kadar gerekiyorsa o kadar kazacağım!Dialogue: 5,0:14:29.75,0:14:34.56,Main-480p,,0,0,0,,Bu toprağı bana kralımızın kendisi emanet etti.Dialogue: 5,0:14:37.39,0:14:39.34,Main-480p,,0,0,0,,İyi, kazalım o zaman!Dialogue: 5,0:14:40.36,0:14:44.36,Main-480p,,0,0,0,,Ha! Dur biraz! Benim kazdığım yere atma!Dialogue: 5,0:14:45.53,0:14:48.19,Main-480p,,0,0,0,,Deliği kapatmak mı istiyorsun?!Dialogue: 5,0:14:48.75,0:14:50.95,Main-480p,,0,0,0,,Hayır, kazıyorum.Dialogue: 5,0:14:50.95,0:14:55.03,Main-480p,,0,0,0,,Yahu kazdığın kum benim kazdığım deliği dolduruyor.Dialogue: 5,0:14:55.03,0:14:58.91,Main-480p,,0,0,0,,Yani bütün emeğim boşa gidecek diyorum!Dialogue: 5,0:14:59.50,0:15:00.39,Main-480p,,0,0,0,,Haa.Dialogue: 5,0:15:01.19,0:15:03.42,Main-480p,,0,0,0,,Demek bu büyülü bir delikmiş!Dialogue: 5,0:15:05.26,0:15:06.33,Main-480p,,0,0,0,,Alakası yok be!Dialogue: 5,0:15:18.84,0:15:21.27,Main-480p,,0,0,0,,Bir süredir kum bu tarafa gelmiyor.Dialogue: 5,0:15:24.08,0:15:26.23,Main-480p,,0,0,0,,Bu kadar kısa sürede mi...?!Dialogue: 5,0:15:27.42,0:15:29.69,Main-480p,,0,0,0,,Uzun yol yorgunu olmasına rağmen…Dialogue: 5,0:15:39.43,0:15:41.75,Main-480p,,0,0,0,,Bu gece huzur içinde dinlen.Dialogue: 5,0:15:43.85,0:15:44.86,Main-480p,,0,0,0,,Et...Dialogue: 5,0:15:47.16,0:15:48.23,Main-480p,,0,0,0,,Tatlı rüyalar.Dialogue: 5,0:15:50.45,0:15:53.16,Main-480p,,0,0,0,,Bunun şakası yok!Dialogue: 5,0:15:54.96,0:15:57.60,Main-480p,,0,0,0,,Daha ne kadar bekleteceksiniz bizi?!Dialogue: 5,0:15:57.60,0:15:59.42,Main-480p,,0,0,0,,Ahtapotpa ikram etseydiniz bari!Dialogue: 5,0:15:59.42,0:16:03.60,Main-480p,,0,0,0,,Dans ettirmeyin beni! Ben bir kuğuyum! Döndürmeyin beni!Dialogue: 5,0:16:06.01,0:16:08.77,Main-480p,,0,0,0,,Bay 2, lütfen sessizce bekleyin.Dialogue: 5,0:16:09.41,0:16:10.86,Main-480p,,0,0,0,,Cidden! Embesil! Embe! Em!Dialogue: 5,0:16:10.86,0:16:13.36,Main-480p,,0,0,0,,Siz de Bayan Merry Christmas.Dialogue: 5,0:16:10.86,0:16:12.90,Secondary-480p,,0,0,0,,Sırtımı ağrıtıyorsun!Dialogue: 5,0:16:14.69,0:16:17.33,Main-480p,,0,0,0,,Birbirinizle geçinmenizi istemek anlamsız gibi.Dialogue: 5,0:16:17.70,0:16:20.71,Main-480p,,0,0,0,,Zaten buna gerek yok.Dialogue: 5,0:16:21.83,0:16:23.79,Main-480p,,0,0,0,,Bayan All Sunday...Dialogue: 5,0:16:23.79,0:16:27.78,Main-480p,,0,0,0,,Herkesin büyük şans peşinde olduğu bu yerde,Dialogue: 5,0:16:27.78,0:16:31.05,Main-480p,,0,0,0,,Hayaller Şehri Rainbase'te...Dialogue: 5,0:16:31.05,0:16:33.51,Main-480p,,0,0,0,,toplandığınız için teşekkür ederim!Dialogue: 5,0:16:33.51,0:16:38.47,Main-480p,,0,0,0,,Şehrin en büyük kumarhanesi Rain Dinners'a hoş geldiniz!Dialogue: 5,0:16:38.47,0:16:43.44,Main-480p,,0,0,0,,Formaliteyi es geçip konuya gelebilir misiniz, Bayan All Sunday?Dialogue: 5,0:16:43.44,0:16:46.12,Main-480p,,0,0,0,,Nasıl isterseniz. Direkt konuya giriyorum.Dialogue: 5,0:16:46.12,0:16:50.40,Main-480p,,0,0,0,,Evet! Başlayalalım! Başlaya! Başla! Baş! Baş! Ba! Ba! B!Dialogue: 5,0:16:50.40,0:16:51.86,Main-480p,,0,0,0,,Başlamadan önce,Dialogue: 5,0:16:51.86,0:16:56.91,Main-480p,,0,0,0,,size örgütümüzün patronunu, yüzünü hiç görmediğiniz kişiyi takdim edeyim.Dialogue: 5,0:16:57.62,0:17:03.02,Main-480p,,0,0,0,,Şimdiye dek onun vekili olarak sizlerle ben görüştüm.Dialogue: 5,0:17:03.02,0:17:05.35,Main-480p,,0,0,0,,Artık buna ihtiyaç olmayacak.Dialogue: 5,0:17:05.35,0:17:06.63,Main-480p,,0,0,0,,Anladığınızı umuyorum.Dialogue: 5,0:17:07.33,0:17:09.45,Main-480p,,0,0,0,,Sonunda zamanı geldi...Dialogue: 5,0:17:10.78,0:17:13.38,Main-480p,,0,0,0,,Ütopya Operasyonu.Dialogue: 5,0:17:15.76,0:17:17.18,Main-480p,,0,0,0,,Crocodile mı?!Dialogue: 5,0:17:18.13,0:17:22.14,Main-480p,,0,0,0,,Baroque Works'ün nihai operasyonu olacak bu.Dialogue: 5,0:17:22.64,0:17:27.10,Main-480p,,0,0,0,,Onu tanıdığınızı görüyorum... En azından yüzünü.Dialogue: 5,0:17:27.10,0:17:30.68,Main-480p,,0,0,0,,Elbette tanıyoruz! Ama bir Shichibukai mi?!Dialogue: 5,0:17:30.68,0:17:33.61,Main-480p,,0,0,0,,Tam bir kodaman var karşımızda!Dialogue: 5,0:17:34.13,0:17:38.32,Main-480p,,0,0,0,,Bunca zaman bir korsanın altında mıydık?!Dialogue: 5,0:17:38.32,0:17:40.74,Main-480p,,0,0,0,,Patronumuz sen misin?Dialogue: 5,0:17:43.32,0:17:44.20,Main-480p,,0,0,0,,Beğenemediniz mi?!Dialogue: 5,0:17:47.21,0:17:49.21,Main-480p,,0,0,0,,Beğenmemek değil ama...Dialogue: 5,0:17:49.21,0:17:52.95,Main-480p,,0,0,0,,Shichibukai zaten hükûmetin yetkilendirdiği korsanlar.Dialogue: 5,0:17:52.95,0:17:54.96,Main-480p,,0,0,0,,Bütün bunlara ne gerek var?Dialogue: 5,0:17:57.28,0:18:01.10,Main-480p,,0,0,0,,İstediğim şey, ne para ne de mevki.Dialogue: 5,0:18:01.83,0:18:03.15,Main-480p,,0,0,0,,Askerî güç istiyorum.Dialogue: 5,0:18:03.15,0:18:04.44,Main-480p,,0,0,0,,Askerî güç mü?Dialogue: 5,0:18:06.10,0:18:08.54,Main-480p,,0,0,0,,İzninizle...Dialogue: 5,0:18:15.46,0:18:17.79,Main-480p,,0,0,0,,asıl hedefimi...Dialogue: 5,0:18:17.79,0:18:22.23,Main-480p,,0,0,0,,ve Baroque Works'ün nihai operasyonunu size anlatayım.Dialogue: 5,0:18:39.62,0:18:43.22,Main-480p,,0,0,0,,Böyle bir şey bu ülkede var mı cidden?Dialogue: 5,0:18:43.22,0:18:46.05,Main-480p,,0,0,0,,O zaman ülkenin tamamını da alıyoruz öyle mi?Dialogue: 5,0:18:46.05,0:18:48.23,Main-480p,,0,0,0,,Tüylerim diken diken oldu!Dialogue: 5,0:18:48.23,0:18:54.19,Main-480p,,0,0,0,,Yani yaptığımız tüm görevler senin büyük planına mı hizmet ediyordu?Dialogue: 5,0:18:54.19,0:18:56.36,Main-480p,,0,0,0,,Aynen öyle.Dialogue: 5,0:18:56.36,0:18:58.44,Main-480p,,0,0,0,,Baroque Works kurulduğundan beri,Dialogue: 5,0:18:58.44,0:19:03.84,Main-480p,,0,0,0,,yaptığınız tüm görevler, planımın olgunlaşabilmesi içindi.Dialogue: 5,0:19:03.84,0:19:07.66,Main-480p,,0,0,0,,Ve o mektuplarda son görevleriniz yazılı.Dialogue: 5,0:19:07.66,0:19:11.73,Main-480p,,0,0,0,,Sonunda Alabasta Krallığı'nın zamanı doldu!Dialogue: 5,0:19:13.67,0:19:17.33,Main-480p,,0,0,0,,Her biriniz görevinizi layıkıyla yerine getirdiğinde,Dialogue: 5,0:19:18.04,0:19:20.72,Main-480p,,0,0,0,,Alabasta Krallığı çökecek.Dialogue: 5,0:19:21.89,0:19:25.39,Main-480p,,0,0,0,,Başka seçenekleri kalmadığından isyancılar ve Kraliyet Ordusu...Dialogue: 5,0:19:26.30,0:19:30.35,Main-480p,,0,0,0,,trajik biçimde Baroque Works'ün kontrolüne geçecek.Dialogue: 5,0:19:30.92,0:19:35.82,Main-480p,,0,0,0,,Bir gecede bu topraklar bizim ütopyamız olacak.Dialogue: 5,0:19:36.60,0:19:42.09,Main-480p,,0,0,0,,Baroque Works'ün nihai operasyonu, Ütopya Operasyonu.Dialogue: 5,0:19:42.77,0:19:44.78,Main-480p,,0,0,0,,Hata yapmaya yer yok.Dialogue: 5,0:19:45.64,0:19:47.58,Main-480p,,0,0,0,,Yarın öğle vakti başlıyoruz.Dialogue: 5,0:19:47.58,0:19:49.14,Main-480p,,0,0,0,,Anlaşıldı.Dialogue: 5,0:19:49.14,0:19:50.75,Main-480p,,0,0,0,,İyi şanslar.Dialogue: 5,0:19:56.84,0:20:01.67,Main-480p,,0,0,0,,Bu sözde operasyonunuzu askıya almanızı rica edeceğim.Dialogue: 5,0:20:05.09,0:20:08.60,Main-480p,,0,0,0,,Bay 3, bu gizli odaya nasıl girdiniz?Dialogue: 5,0:20:08.60,0:20:12.44,Main-480p,,0,0,0,,Bay 3! Hangi taşın altından sürünerek geldin?!Dialogue: 5,0:20:12.44,0:20:14.77,Main-480p,,0,0,0,,Emirler doğrultusunda seni şimdi alt edeceğim!Dialogue: 5,0:20:15.22,0:20:17.90,Main-480p,,0,0,0,,Bekle, Bay 2.Dialogue: 5,0:20:18.38,0:20:21.36,Main-480p,,0,0,0,,"Taşın altından sürünmek" mi? Hiç hoş değil.Dialogue: 5,0:20:21.36,0:20:26.79,Main-480p,,0,0,0,,Spiders Kafe'den beri yanınızdan hiç ayrılmadım.Dialogue: 5,0:20:26.79,0:20:29.95,Main-480p,,0,0,0,,Bunchi'yle yolculuk bile ettim.Dialogue: 5,0:20:29.95,0:20:32.43,Main-480p,,0,0,0,,Tanıştığımıza memnun oldum, Patron.Dialogue: 5,0:20:32.43,0:20:36.92,Main-480p,,0,0,0,,Buraya başım önümde ikinci bir şans istemek için geldim.Dialogue: 5,0:20:37.54,0:20:41.94,Main-480p,,0,0,0,,Verdiğiniz emirleri yerine getiremedikten sonra,Dialogue: 5,0:20:41.94,0:20:45.44,Main-480p,,0,0,0,,Bay 2'yi peşime takmanız gayet olağan bir durumdu.Dialogue: 5,0:20:45.44,0:20:48.76,Main-480p,,0,0,0,,O yüzden yolumdan şaşıp Spiders Kafe'ye...Dialogue: 5,0:20:48.76,0:20:51.93,Main-480p,,0,0,0,,ajanların buluşma yerine gittim.Dialogue: 5,0:20:51.93,0:20:56.40,Main-480p,,0,0,0,,Emirlerimi yerine getirememek mi? Neden bahsediyorsun?Dialogue: 5,0:20:57.78,0:21:03.32,Main-480p,,0,0,0,,Hasır Şapkalar'ı ve Prenses Vivi'yi elimden kaçırdım ya...Dialogue: 5,0:21:06.56,0:21:09.20,Main-480p,,0,0,0,,''Kaçırdım'' mı dedin?!Dialogue: 5,0:21:09.96,0:21:12.17,Main-480p,,0,0,0,,Hâlâ hayatta olduklarını mı söylüyorsun?!Dialogue: 5,0:21:13.40,0:21:15.81,Main-480p,,0,0,0,,Aktarıcı salyangozda bahsettiğin şey neydi o zaman?Dialogue: 5,0:21:16.28,0:21:22.46,Main-480p,,0,0,0,,Korsanları ve Vivi'yi hallettiğini bana söylemedin mi?!Dialogue: 5,0:21:22.46,0:21:25.98,Main-480p,,0,0,0,,Aktarıcı salyangoz mu? N-Ne demek istiyorsunuz?Dialogue: 5,0:21:25.98,0:21:30.64,Main-480p,,0,0,0,,Little Garden'dayken hiç aktarıcı salyangoz kullanmadım.Dialogue: 5,0:21:30.64,0:21:31.83,Main-480p,,0,0,0,,Ne?!Dialogue: 5,0:21:33.79,0:21:36.38,Flashbacks-480p,,0,0,0,,Alo! Burası Boktan bir Restoran.Dialogue: 5,0:21:36.38,0:21:38.40,Flashbacks-480p,,0,0,0,,Rezervasyon ister misiniz?Dialogue: 5,0:21:42.58,0:21:44.43,Main-480p,,0,0,0,,Bu kötü oldu.Dialogue: 5,0:21:44.43,0:21:48.24,Main-480p,,0,0,0,,Uğursuzlar bu yüzden adadan dönmedi demek.Dialogue: 5,0:21:49.69,0:21:52.56,Main-480p,,0,0,0,,Ama en azından birkaçından kurtuldun değil mi?Dialogue: 5,0:21:52.56,0:21:54.45,Main-480p,,0,0,0,,A-Aslında, hayır...Dialogue: 5,0:21:55.71,0:21:58.70,Main-480p,,0,0,0,,Ş-şey… istihbarat raporumuz eksikti!Dialogue: 5,0:21:58.70,0:22:01.74,Main-480p,,0,0,0,,Dört korsan vardı üç değil,Dialogue: 5,0:22:01.74,0:22:04.42,Main-480p,,0,0,0,,uzun burunlu biriyle dört kişi–Dialogue: 5,0:22:04.42,0:22:06.17,Main-480p,,0,0,0,,Aptal!Dialogue: 5,0:22:06.84,0:22:11.25,Main-480p,,0,0,0,,Yahu Sıfır-chan! Adam açıkça dalga geçiyor.Dialogue: 5,0:22:11.25,0:22:12.76,Main-480p,,0,0,0,,Hiçbiri mantıklı değil!Dialogue: 5,0:22:21.06,0:22:24.11,Main-480p,,0,0,0,,Ben... onlarla tanıştım!Dialogue: 5,0:22:24.62,0:22:27.61,Main-480p,,0,0,0,,Buraya gelirken karşılaştık!Dialogue: 5,0:22:28.04,0:22:28.57,Main-480p,,0,0,0,,Ne?!Dialogue: 5,0:22:29.66,0:22:32.55,Main-480p,,0,0,0,,Bu!Dialogue: 5,0:22:32.55,0:22:33.98,Main-480p,,0,0,0,,Bu!Dialogue: 5,0:22:33.98,0:22:35.48,Main-480p,,0,0,0,,Bu!Dialogue: 5,0:22:35.48,0:22:37.18,Main-480p,,0,0,0,,Bir de bu, değil mi?!Dialogue: 5,0:22:37.68,0:22:38.41,Main-480p,,0,0,0,,Ve...Dialogue: 5,0:22:39.41,0:22:42.65,Main-480p,,0,0,0,,bu da bayan Wednesday, krallığın prensesi Vivi mi?!Dialogue: 5,0:22:42.65,0:22:45.92,Main-480p,,0,0,0,,Onlar düşmanımız mıymış?!Dialogue: 5,0:22:46.54,0:22:50.08,Main-480p,,0,0,0,,Evet. Kimliğimi biliyorlar.Dialogue: 5,0:22:50.08,0:22:53.39,Main-480p,,0,0,0,,Onları kendi haline bırakırsak operasyonu sekteye uğratırlar.Dialogue: 5,0:22:56.33,0:22:58.05,Main-480p,,0,0,0,,Sana gelirsek Bay 3.Dialogue: 5,0:22:58.56,0:23:04.21,Main-480p,,0,0,0,,Dediğin gibi, hayvanla birlikte bir kişi daha var.Dialogue: 5,0:23:05.10,0:23:07.40,Main-480p,,0,0,0,,Evcil hayvanı hesaba katmayacağız.Dialogue: 5,0:23:07.40,0:23:13.74,Main-480p,,0,0,0,,Vivi ve diğer dört kişinin çoktan Alabasta'ya girdiklerini varsaymalıyız.Dialogue: 5,0:23:14.25,0:23:17.91,Main-480p,,0,0,0,,Bay 2, hafızanda kayıtlı olan yüzleri fotoğrafla.Dialogue: 5,0:23:17.91,0:23:19.82,Main-480p,,0,0,0,,A-Ama, Patron!Dialogue: 5,0:23:19.82,0:23:23.29,Main-480p,,0,0,0,,Beşinin ve Vivi'nin icabına bakabiliri–Dialogue: 5,0:23:23.29,0:23:25.32,Main-480p,,0,0,0,,Kes sesini, aptal!Dialogue: 5,0:23:27.01,0:23:28.55,Main-480p,,0,0,0,,Bay 3...Dialogue: 5,0:23:29.66,0:23:31.38,Main-480p,,0,0,0,,Bay 3!Dialogue: 5,0:23:32.36,0:23:36.14,Main-480p,,0,0,0,,Sana neden bu pozisyonu verdim, biliyor musun?!Dialogue: 5,0:23:37.84,0:23:44.22,Main-480p,,0,0,0,,Savaş becerilerinde Bay 4'ten bile geridesin, Bay 3!Dialogue: 5,0:23:44.22,0:23:45.82,Main-480p,,0,0,0,,Kas gücü eksikliğini...Dialogue: 5,0:23:45.82,0:23:49.59,Main-480p,,0,0,0,,sinsi kararlılığınla telafi edebileceğini düşünmüştüm.Dialogue: 5,0:23:51.60,0:23:53.61,Main-480p,,0,0,0,,Ama hayal kırıklığına uğradım!Dialogue: 5,0:23:53.61,0:23:55.63,Main-480p,,0,0,0,,B-Bu da ne?!Dialogue: 5,0:23:55.63,0:23:57.58,Main-480p,,0,0,0,,Kuruyor!Dialogue: 5,0:23:59.66,0:24:01.17,Main-480p,,0,0,0,,S-Su...Dialogue: 5,0:24:02.76,0:24:04.30,Main-480p,,0,0,0,,Su...Dialogue: 5,0:24:04.30,0:24:06.02,Main-480p,,0,0,0,,İstediğin su olsun.Dialogue: 5,0:24:18.99,0:24:20.75,Main-480p,,0,0,0,,Yemek zamanı.Dialogue: 5,0:24:22.66,0:24:26.02,Main-480p,,0,0,0,,Burası neresi? Su altında mıyım?Dialogue: 5,0:24:28.83,0:24:31.81,Main-480p,,0,0,0,,T-Tıpkı akvaryum gibi...Dialogue: 5,0:24:32.49,0:24:35.55,Main-480p,,0,0,0,,M-Muz timsahı!Dialogue: 5,0:24:32.49,0:24:35.55,Note,,0,0,0,,Bananawani: Muz+TimsahDialogue: 5,0:24:39.82,0:24:43.16,Main-480p,,0,0,0,,O çelimsiz sığır her şeyi bozdu...Dialogue: 5,0:24:46.39,0:24:49.15,Main-480p,,0,0,0,,Ölmeyi bile beceremiyor!Dialogue: 5,0:24:51.02,0:24:55.12,Main-480p,,0,0,0,,Dinleyin şimdi! Bu beşine iyice bakın!Dialogue: 5,0:24:55.12,0:24:57.43,Main-480p,,0,0,0,,İsyanı durdurmak için her şeyi yapacaklar.Dialogue: 5,0:24:57.43,0:25:00.64,Main-480p,,0,0,0,,Onları kendi hallerine bırakırsak mutlaka bize ulaşacaklar!Dialogue: 5,0:25:00.64,0:25:02.70,Main-480p,,0,0,0,,İyi de Sıfır-chan,Dialogue: 5,0:25:02.70,0:25:04.53,Main-480p,,0,0,0,,Prenses olsa bile,Dialogue: 5,0:25:04.53,0:25:08.11,Main-480p,,0,0,0,,şu noktada isyanı durdurabileceğine inanıyor musun?Dialogue: 5,0:25:09.07,0:25:10.98,Main-480p,,0,0,0,,Ne yazık ki istihbaratımız...Dialogue: 5,0:25:10.98,0:25:17.45,Main-480p,,0,0,0,,isyancıların lideri Koza ve Prenses Vivi'nin çocukluk arkadaşı olduğunu doğruladı.Dialogue: 5,0:25:18.66,0:25:20.77,Main-480p,,0,0,0,,700 bin'in öfkesi.Dialogue: 5,0:25:20.77,0:25:23.20,Main-480p,,0,0,0,,Onları durduramazsa bile...Dialogue: 5,0:25:23.20,0:25:27.38,Main-480p,,0,0,0,,tereddüt etmelerine sebep olabilir.Dialogue: 5,0:25:28.12,0:25:31.95,Main-480p,,0,0,0,,Milyarlarımızdan birçoğunu zaten aralarına sızdırdım.Dialogue: 5,0:25:32.62,0:25:35.53,Main-480p,,0,0,0,,Henüz iletişime geçmediler,Dialogue: 5,0:25:35.53,0:25:39.73,Main-480p,,0,0,0,,bu da demek oluyor ki henüz bir adım atılmamış.Dialogue: 5,0:25:39.73,0:25:43.10,Main-480p,,0,0,0,,Bedeli ne olursa olsun, Vivi ve İsyan Ordusu...Dialogue: 5,0:25:43.10,0:25:45.66,Main-480p,,0,0,0,,operasyondan önce buluşmamalılar.Dialogue: 5,0:25:47.98,0:25:49.93,Main-480p,,0,0,0,,– Bayan All Sunday. – Buyurun?Dialogue: 5,0:25:50.48,0:25:53.78,Main-480p,,0,0,0,,Şartlar gereği, aktarıcı salyangozları kullanmakta sorun yok.Dialogue: 5,0:25:53.78,0:25:56.37,Main-480p,,0,0,0,,Nanoha'daki milyarlarla iletişime geç.Dialogue: 5,0:25:56.95,0:26:00.07,Main-480p,,0,0,0,,"Görür görmez öldürün" emri ver.Dialogue: 5,0:26:00.84,0:26:04.20,Main-480p,,0,0,0,,Prenses Vivi ve korsanları Katorea'ya sokmayın!Dialogue: 5,0:26:05.13,0:26:08.20,Main-480p,,0,0,0,,Vivi ve Koza karşılaşmamalı!Dialogue: 5,0:26:08.92,0:26:10.36,Main-480p,,0,0,0,,Emredersiniz. Derhal.Dialogue: 5,0:26:11.99,0:26:16.18,Main-480p,,0,0,0,,Siz de harekete geçin! Partiye geç kalmayın!Dialogue: 5,0:26:18.28,0:26:21.17,Main-480p,,0,0,0,,Ütopyamızın arifesindeyiz.Dialogue: 5,0:26:29.99,0:26:33.40,Main-480p,,0,0,0,,Daha fazla bela istemiyorum.Dialogue: 5,0:26:33.87,0:26:35.86,Main-480p,,0,0,0,,Hallederiz, Patron!Dialogue: 5,0:26:36.69,0:26:38.65,Main-480p,,0,0,0,,Bize güvenebilirsin!Dialogue: 5,0:26:39.73,0:26:41.64,Main-480p,,0,0,0,,İyi eğlenceler!Dialogue: 5,0:26:46.53,0:26:49.67,Main-480p,,0,0,0,,Uygunsuz tavırlarım için affedin, Vivi-chan.Dialogue: 5,0:26:49.67,0:26:51.57,Main-480p,,0,0,0,,Hayır, hiç de bile.Dialogue: 5,0:26:51.57,0:26:53.61,Main-480p,,0,0,0,,Şimdi gitmemiz gerekiyor, amca!Dialogue: 5,0:26:53.61,0:26:56.17,Main-480p,,0,0,0,,Ah, Luffy-kun. Bunu yanına al.Dialogue: 5,0:26:56.74,0:26:58.11,Main-480p,,0,0,0,,Oha! Su!Dialogue: 5,0:26:58.11,0:26:59.32,Main-480p,,0,0,0,,Su!Dialogue: 5,0:26:59.32,0:27:00.13,Main-480p,,0,0,0,,Çıkardın mı?!Dialogue: 5,0:27:00.75,0:27:05.02,Main-480p,,0,0,0,,Dün gece, sen uykuya dalar dalmaz,Dialogue: 5,0:27:05.02,0:27:07.85,Main-480p,,0,0,0,,kumun nemli katmanına ulaştım.Dialogue: 5,0:27:08.48,0:27:11.79,Main-480p,,0,0,0,,Nemli katmandan çıkarabildiğim bu kadar!Dialogue: 5,0:27:11.79,0:27:14.82,Main-480p,,0,0,0,,Oo! Hiç anlamadım ama teşekkürler!Dialogue: 5,0:27:15.28,0:27:20.32,Main-480p,,0,0,0,,Özbeöz Yuba suyu! Maalesef elimden bu kadarı geldi.Dialogue: 5,0:27:20.88,0:27:23.02,Main-480p,,0,0,0,,Dikkatli içeceğim!Dialogue: 5,0:27:31.81,0:27:34.21,Main-480p,,0,0,0,,Luffy! Ne yapıyorsun?!Dialogue: 5,0:27:37.99,0:27:39.13,Main-480p,,0,0,0,,Luffy?Dialogue: 5,0:27:39.67,0:27:41.30,Main-480p,,0,0,0,,Sorun nedir, Luffy-san?Dialogue: 5,0:27:46.43,0:27:47.31,Main-480p,,0,0,0,,Vazgeçtim.Dialogue: 5,0:27:48.50,0:27:49.65,Main-480p,,0,0,0,,Ha?Dialogue: 5,0:27:51.23,0:27:52.31,Main-480p,,0,0,0,,Vaz mı geçtin?Dialogue: 5,0:27:52.76,0:27:54.77,Main-480p,,0,0,0,,Luffy-san, ne demek istiyorsun?Dialogue: 5,0:27:54.77,0:27:56.60,Main-480p,,0,0,0,,Hadi kalk, Luffy!Dialogue: 5,0:27:56.60,0:28:01.37,Main-480p,,0,0,0,,Senin kaprislerinle uğraşacak vaktimiz yok! Kımılda!Dialogue: 5,0:28:01.94,0:28:03.16,Main-480p,,0,0,0,,Geri dönmüyor muyuz?Dialogue: 5,0:28:03.69,0:28:04.91,Main-480p,,0,0,0,,Dönüyoruz.Dialogue: 5,0:28:04.91,0:28:08.91,Main-480p,,0,0,0,,Eğer geri dönüp Katorea'ya gitmezsek...Dialogue: 5,0:28:08.91,0:28:14.00,Main-480p,,0,0,0,,bir milyon vatandaş çatışacak ve bu ülkeyi mahvedecekler!Dialogue: 5,0:28:14.72,0:28:17.53,Main-480p,,0,0,0,,Vivi-chan için yapıyoruz bunu! Kalk gidiyoruz!Dialogue: 5,0:28:18.72,0:28:20.26,Main-480p,,0,0,0,,Sıkıcı.Dialogue: 5,0:28:21.13,0:28:22.51,Main-480p,,0,0,0,,Ne dedin?!Dialogue: 5,0:28:24.00,0:28:24.51,Main-480p,,0,0,0,,Vivi!Dialogue: 5,0:28:25.10,0:28:26.26,Main-480p,,0,0,0,,Evet?Dialogue: 5,0:28:27.20,0:28:30.31,Main-480p,,0,0,0,,Crocodile'ın kıçına tekmeyi basmak istiyorum!Dialogue: 5,0:28:31.87,0:28:35.97,Main-480p,,0,0,0,,İsyanı durdurmak Crocodile'ı durduracak mı?Dialogue: 5,0:28:36.46,0:28:39.78,Main-480p,,0,0,0,,Hem Katorea'da yapabileceğimiz pek bir şey yok.Dialogue: 5,0:28:40.76,0:28:44.51,Main-480p,,0,0,0,,Ne olursa olsun, biz korsanız. İşler biz olmadan çok daha iyi.Dialogue: 5,0:28:45.99,0:28:49.66,Main-480p,,0,0,0,,Aptal da olsa, iyi bir noktaya değindi.Dialogue: 5,0:28:50.09,0:28:52.96,Main-480p,,0,0,0,,Luffy işte.Dialogue: 5,0:28:52.96,0:28:54.58,Main-480p,,0,0,0,,B-Bu-Dialogue: 5,0:28:54.58,0:28:58.89,Main-480p,,0,0,0,,İnsanların bu savaşta ölmesini engellemek istiyorsun.Dialogue: 5,0:29:00.59,0:29:04.30,Main-480p,,0,0,0,,Tüm vatandaşların... ve bizim!Dialogue: 5,0:29:06.54,0:29:11.43,Main-480p,,0,0,0,,Shichibukai birine ve milyonlarca insana karşı olsak bile,Dialogue: 5,0:29:12.16,0:29:14.73,Main-480p,,0,0,0,,herkesin güvende olmasını istiyorsun.Dialogue: 5,0:29:16.94,0:29:18.72,Main-480p,,0,0,0,,Çok safça değil mi?Dialogue: 5,0:29:22.84,0:29:26.16,Main-480p,,0,0,0,,Dur biraz, Luffy! Vivi'yi anlamaya çalış!Dialogue: 5,0:29:26.16,0:29:27.46,Main-480p,,0,0,0,,Nami-san, bekle.Dialogue: 5,0:29:27.46,0:29:28.49,Main-480p,,0,0,0,,Ama...Dialogue: 5,0:29:29.74,0:29:31.59,Main-480p,,0,0,0,,Ne var bunda?!Dialogue: 5,0:29:32.11,0:29:35.25,Main-480p,,0,0,0,,Kimsenin ölmemesini istemenin nesi yanlış?!Dialogue: 5,0:29:36.76,0:29:38.38,Main-480p,,0,0,0,,İnsanlar ölür.Dialogue: 5,0:29:42.68,0:29:45.04,Main-480p,,0,0,0,,Böyle şeyler söyleme!Dialogue: 5,0:29:45.68,0:29:47.63,Main-480p,,0,0,0,,Tekrar edersen pişman ederim seni!Dialogue: 5,0:29:49.18,0:29:52.64,Main-480p,,0,0,0,,Bunu engellemek için buradayız!Dialogue: 5,0:29:53.44,0:29:55.60,Main-480p,,0,0,0,,Kraliyet Ordusu, İsyan Ordusu,Dialogue: 5,0:29:55.60,0:29:58.48,Main-480p,,0,0,0,,ve bu ülkenin halkı, hiç biri bunları hak etmiyor!Dialogue: 5,0:29:59.15,0:30:04.61,Main-480p,,0,0,0,,Her şey Crocodile'ın suçuyken neden insanlar can versin?Dialogue: 5,0:30:09.80,0:30:13.91,Main-480p,,0,0,0,,Öyleyse neden hayatını riske atıyorsun?Dialogue: 5,0:30:14.58,0:30:17.67,Main-480p,,0,0,0,,– Hey, Luffy! Çok ileri gidiyorsun! – Kahrolası, Luffy!Dialogue: 5,0:30:21.09,0:30:25.27,Main-480p,,0,0,0,,Bu krallığa tek bir bakış atınca ben bile anlayabiliyorum...Dialogue: 5,0:30:26.86,0:30:27.85,Main-480p,,0,0,0,,Neyi?!Dialogue: 5,0:30:28.88,0:30:31.26,Main-480p,,0,0,0,,yapılması... gerekeni!Dialogue: 5,0:30:37.18,0:30:40.98,Flashbacks-480p,,0,0,0,,Yuba, öyle adi kumlara boyun eğecek değil!Dialogue: 5,0:30:41.94,0:30:46.40,Main-480p,,0,0,0,,Tek başına hayatını riske atmak yeterli mi sanıyorsun?Dialogue: 5,0:30:46.86,0:30:50.45,Main-480p,,0,0,0,,O zaman neyi riske atmalıyım, söyle?!Dialogue: 5,0:30:53.71,0:30:56.79,Flashbacks-480p,,0,0,0,,Bunun yanına kâr kalmasına izin veremem!Dialogue: 5,0:30:57.37,0:30:58.25,Main-480p,,0,0,0,,Benim–Dialogue: 5,0:31:00.82,0:31:05.09,Main-480p,,0,0,0,,Benim verecek başka bir şeyim kalmadı...Dialogue: 5,0:31:07.73,0:31:10.89,Main-480p,,0,0,0,,Niye hepimizin hayatını seninkiyle birlikte riske atmıyorsun?!Dialogue: 5,0:31:11.30,0:31:12.55,Main-480p,,0,0,0,,Arkadaş değil miyiz?!Dialogue: 5,0:31:16.48,0:31:18.01,Main-480p,,0,0,0,,Arkadaş değil miyiz?!Dialogue: 5,0:31:22.16,0:31:26.48,Main-480p,,0,0,0,,Vay be, demek bu seni ağlatıyor.Dialogue: 5,0:31:33.95,0:31:36.79,Flashbacks-480p,,0,0,0,,İsyanı durduracağız!Dialogue: 5,0:31:38.29,0:31:41.92,Main-480p,,0,0,0,,Biliyorum, ondan nefret ediyorsun ve onu en çok sen dövmek istiyorsun!Dialogue: 5,0:31:56.34,0:31:57.51,Main-480p,,0,0,0,,Şimdi söyle bana,Dialogue: 5,0:32:00.51,0:32:02.51,Main-480p,,0,0,0,,Crocodile nerede?!Dialogue: 1,0:01:50.26,0:01:54.09,Title-480p,,0,0,0,,Ülkemi SeviyorumDialogue: 1,0:02:50.76,0:02:56.78,Captionsşv2-480p,,0,0,0,,KatoreaDialogue: 1,0:15:48.93,0:15:54.64,Captionsşv2-480p,,0,0,0,,Kumarhane Rain DinnersDialogue: 0,0:00:12.94,0:00:14.67,RogerMonologue,,0,0,0,,Miras alınan irade,Dialogue: 0,0:00:14.67,0:00:17.58,RogerMonologue,,0,0,0,,zamanın gelgitleri ve insanların hayalleri...Dialogue: 0,0:00:17.58,0:00:20.41,RogerMonologue,,0,0,0,,Bunların önüne geçilemez.Dialogue: 0,0:00:20.41,0:00:23.52,RogerMonologue,,0,0,0,,Özgürlüğe aç olan insanlar oldukça...Dialogue: 0,0:00:23.52,0:00:26.15,RogerMonologue,,0,0,0,,bunlar hep var olacak.Dialogue: 0,0:00:01.73,0:00:04.73,Credits-480p,,68,0,23,,Video Düzenleme GigglebotDialogue: 0,0:00:04.73,0:00:07.73,Credits-480p,,68,0,23,,Zamanlama DraSleek PhosCityDialogue: 0,0:00:07.73,0:00:12.73,Credits-480p,,68,0,23,,Kalite Kontrol Galaxy 9000 JT-421 PepperjackDialogue: 0,0:00:12.73,0:00:15.73,Credits-480p,,68,0,23,,Müzik HaleeDialogue: 0,0:00:15.73,0:00:18.73,Credits-480p,,68,0,23,,Grafik DatenshiDialogue: 0,0:00:18.73,0:00:21.73,Credits-480p,,68,0,23,,Karaoke KaitouYahikoDialogue: 0,0:00:21.73,0:00:24.73,Credits-480p,,68,0,23,,Altyazı Düzenleme [TR] Jack Cohle -onepacetr.net-Dialogue: 0,0:00:24.73,0:00:27.73,Credits-480p,,68,0,23,,Çeviri [TR] Jack Cohle -onepacetr.net-Dialogue: 0,0:11:33.88,0:11:35.30,Captionsşv2-480p,,0,0,0,,YubaDialogue: 1,0:11:33.88,0:11:35.30,Captionsşv2