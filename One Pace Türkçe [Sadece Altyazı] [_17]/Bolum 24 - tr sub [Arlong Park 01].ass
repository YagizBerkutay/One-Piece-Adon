00,0,0,0,0,100,100,3,0,1,2.95,0,8,23,23,23,1Style: Lyrics-furigana,Duality,36,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,2.95,0,2,23,23,34,1Style: Lyrics,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,2,23,23,34,1Style: Karaoke,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,23,1Style: Kanji,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,146,1Style: Roger-Monologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1Style: Romaji ED,Josefin Sans,80,&H00D0740C,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,8,10,10,20,1Style: Translation ED,Josefin Sans,82,&H00D0740C,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,2,10,10,20,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:50.01,0:02:00.01,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:02:18.99,0:02:21.75,Main-207-,,0,0,0,,Bugün hava çok güzel!Dialogue: 0,0:02:25.42,0:02:29.25,Main-207-,,0,0,0,,Acaba Grand Line ne kadar uzakta, bu tarafta mı?!Dialogue: 0,0:02:30.55,0:02:32.72,Main-207-,,0,0,0,,Belki de bu tarafta?!Dialogue: 0,0:02:33.09,0:02:34.84,Main-207-,,0,0,0,,Bu tarafta mı?! Yoksa bu tarafta mı?!Dialogue: 0,0:02:35.97,0:02:37.68,Main-207-,,0,0,0,,Çok heyecan verici!Dialogue: 0,0:02:37.68,0:02:39.68,Main-207-,,0,0,0,,Sinirimi bozuyorsun.Dialogue: 0,0:02:39.68,0:02:41.14,Main-207-,,0,0,0,,Yerinde dur, olur mu?Dialogue: 0,0:02:41.14,0:02:43.14,Main-207-,,0,0,0,,Pardon! Pardon!Dialogue: 0,0:02:44.14,0:02:48.90,Main-207-,,0,0,0,,Şimdi aşçımız olduğuna göre tek ihtiyacımız olan Nami'yi geri getirmek.Dialogue: 0,0:02:48.90,0:02:51.11,Main-207-,,0,0,0,,Sonra Grand Line'a gidebileceğiz!Dialogue: 0,0:02:51.73,0:02:53.49,Main-207-,,0,0,0,,Nami-san, ha?Dialogue: 0,0:02:53.49,0:02:57.74,Main-207-,,0,0,0,,O güzel yüzünü hatırlamak bile beni mutlu ediyor!Dialogue: 0,0:02:58.28,0:03:00.33,Main-207-,,0,0,0,,Onu tekrar görmeyi iple çekiyorum!Dialogue: 0,0:03:02.37,0:03:03.83,Main-207-,,0,0,0,,Hey, Yosaku.Dialogue: 0,0:03:03.83,0:03:06.29,Main-207-,,0,0,0,,Nami'nin olduğu yere yaklaştık, değil mi?Dialogue: 0,0:03:07.58,0:03:10.55,Main-207-,,0,0,0,,Beyler, ciddi olun! Bu oyun değil!Dialogue: 0,0:03:10.55,0:03:11.75,Main-207-,,0,0,0,,Hâlâ anlamadınız mı?!Dialogue: 0,0:03:11.75,0:03:16.84,Main-207-,,0,0,0,,Konuştuğumuz her an korkunç Arlong'un karargâhına yaklaşıyoruz!Dialogue: 0,0:03:19.60,0:03:22.39,Main-207-,,0,0,0,,Nami abla gözlerini...Dialogue: 0,0:03:22.39,0:03:24.85,Main-207-,,0,0,0,,Arlong'un aranıyor posterinden ayıramıyordu!Dialogue: 0,0:03:26.89,0:03:28.86,Main-207-,,0,0,0,,Kendinde değildi!Dialogue: 0,0:03:34.03,0:03:39.70,Main-207-,,0,0,0,,Nami abla, 20 milyon beli ödül için Arlong'u yenmeyi düşünüyor!Dialogue: 0,0:03:39.70,0:03:43.54,Main-207-,,0,0,0,,Konuştuğumuz sırada çoktan içlerine sızmış olabilir!Dialogue: 0,0:03:45.54,0:03:46.96,Main-207-,,0,0,0,,Biraz yemek yiyelim.Dialogue: 0,0:03:46.96,0:03:47.54,Main-207-,,0,0,0,,Olur.Dialogue: 0,0:03:49.83,0:03:53.67,Main-207-,,0,0,0,,Arlong hakkında hiçbir şey duymadığınızı söylemeyin?!Dialogue: 0,0:03:53.67,0:03:54.84,Main-207-,,0,0,0,,Arlong mu?Dialogue: 0,0:03:54.84,0:03:55.59,Main-207-,,0,0,0,,Duymadım.Dialogue: 0,0:04:01.18,0:04:03.01,Main-207-,,0,0,0,,Pekâlâ, dinleyin!Dialogue: 0,0:04:03.01,0:04:05.85,Main-207-,,0,0,0,,Sanırım size her şeyi anlatmam gerekiyor!Dialogue: 0,0:04:06.68,0:04:11.19,Main-207-,,0,0,0,,Arlong, Grand Line'ı altını üstüne getiren bir balıkadamdır!Dialogue: 0,0:04:11.19,0:04:12.19,Main-207-,,0,0,0,,Balıkadam mı?Dialogue: 0,0:04:12.19,0:04:14.82,Main-207-,,0,0,0,,Balıkadam, ha? Öyle biriyle karşılaşmadım.Dialogue: 0,0:04:14.82,0:04:17.65,Main-207-,,0,0,0,,Aslında, Grand Line'daki balıkadam adasındaki...Dialogue: 0,0:04:17.65,0:04:20.78,Main-207-,,0,0,0,,deniz kızlarının çok güzel olduğunu duydum!Dialogue: 0,0:04:21.16,0:04:22.41,Main-207-,,0,0,0,,Balıkadamların tipi...Dialogue: 0,0:04:23.28,0:04:24.04,Main-207-,,0,0,0,,böyle mi?Dialogue: 0,0:04:25.58,0:04:26.79,Main-207-,,0,0,0,,Ne şaheser ama!Dialogue: 0,0:04:25.95,0:04:28.25,Main-207-,,0,0,0,,Birazcık odaklanamaz mısınız?!Dialogue: 0,0:04:28.96,0:04:32.00,Main-207-,,0,0,0,,Pekâlâ. En baştan anlatmama izin verin.Dialogue: 0,0:04:32.75,0:04:37.01,Main-207-,,0,0,0,,Grand Line'a korsan mezarı denmesinin ana sebebi...Dialogue: 0,0:04:37.01,0:04:39.47,Main-207-,,0,0,0,,üç büyük gücün denizlerde hüküm sürmesidir.Dialogue: 0,0:04:39.88,0:04:43.85,Main-207-,,0,0,0,,Onlardan biri Shichibukai'dir!Dialogue: 0,0:04:39.88,0:04:43.85,Note-207-,,0,0,0,,Shichibukai=Denizin Yedi Savaş AğasıDialogue: 0,0:04:46.43,0:04:48.23,Main-207-,,0,0,0,,Shichibukai mi?Dialogue: 0,0:04:48.77,0:04:51.69,Main-207-,,0,0,0,,Özetle, hükümetin korsanları.Dialogue: 0,0:04:51.69,0:04:53.27,Main-207-,,0,0,0,,Ciddi misin?Dialogue: 0,0:04:53.27,0:04:57.11,Main-207-,,0,0,0,,Neden korsanlar hükümetin onayını alıyor?Dialogue: 0,0:04:57.74,0:05:02.74,Main-207-,,0,0,0,,Diğer korsanlardan yağmaladıkları hazineden hükümete pay vererek,Dialogue: 0,0:05:02.74,0:05:04.91,Main-207-,,0,0,0,,Shichibukai olmalarına izin veriliyor!Dialogue: 0,0:05:05.66,0:05:09.66,Main-207-,,0,0,0,,Korsanların gözünde, hükümetin köpeğinden başka bir şey değillerdir.Dialogue: 0,0:05:09.66,0:05:11.25,Main-207-,,0,0,0,,Ama aşırı güçlüdürler!Dialogue: 0,0:05:16.96,0:05:22.59,Main-207-,,0,0,0,,Zoro abinin savaştığı korsan, Şahin Göz Mihawk da bir Shichibukai'ydi.Dialogue: 0,0:05:22.59,0:05:24.39,Main-207-,,0,0,0,,Bu harika!Dialogue: 0,0:05:24.39,0:05:26.85,Main-207-,,0,0,0,,Bunlardan yedi tane mi var?!Dialogue: 0,0:05:26.85,0:05:28.60,Main-207-,,0,0,0,,Shichibukai harika!Dialogue: 0,0:05:28.60,0:05:34.56,Main-207-,,0,0,0,,Bir diğer Shichibukai ise balıkadam korsanlarının patronu, Jinbe.Dialogue: 0,0:05:35.23,0:05:38.11,Main-207-,,0,0,0,,Jinbe ile aynı seviyede olan,  Grand Line'da...Dialogue: 0,0:05:38.11,0:05:42.57,Main-207-,,0,0,0,,terör estiren kişi, korsan balıkadam Arlong'dan başkası değil.Dialogue: 0,0:05:44.78,0:05:45.83,Main-207-,,0,0,0,,Bunun gibi mi?Dialogue: 0,0:05:45.83,0:05:48.79,Main-207-,,0,0,0,,Bu sadece bir önceki çizdiğinin ayakta durmuş hali!Dialogue: 0,0:05:49.45,0:05:54.92,Main-207-,,0,0,0,,Arlong, Doğu Mavi'ye geldiğinden beri 20 tane şehri ele geçirdi!Dialogue: 0,0:05:54.92,0:05:58.75,Main-207-,,0,0,0,,Don Krieg'ten çok daha güçlüdür!Dialogue: 0,0:05:59.13,0:06:03.59,Main-207-,,0,0,0,,Ama neden Nami-san böyle biri için tek başına gider ki?Dialogue: 0,0:06:04.34,0:06:07.22,Main-207-,,0,0,0,,Sana söyledim, kafasındaki ödülü istiyor!Dialogue: 0,0:06:07.22,0:06:08.31,Main-207-,,0,0,0,,Kim bilir?Dialogue: 0,0:06:08.31,0:06:11.35,Main-207-,,0,0,0,,Belki de Nami-san aslında bir deniz kızıdır!Dialogue: 0,0:06:11.35,0:06:14.19,Main-207-,,0,0,0,,Özellikle ne kadar sevimli olduğunu göz önüne alırsak!Dialogue: 0,0:06:14.98,0:06:15.77,Main-207-,,0,0,0,,Böyle mi?!Dialogue: 0,0:06:15.77,0:06:18.19,Main-207-,,0,0,0,,Lan, seni öldürürüm!Dialogue: 0,0:06:18.57,0:06:22.07,Main-207-,,0,0,0,,Söylediklerimi anladınız mı?!Dialogue: 0,0:06:22.07,0:06:25.16,Main-207-,,0,0,0,,Balıkadamlar güçlü, değil mi? Anladık!Dialogue: 0,0:06:25.66,0:06:28.12,Main-207-,,0,0,0,,Hayır, anlamadınız!Dialogue: 0,0:06:28.12,0:06:30.12,Main-207-,,0,0,0,,Onların gücünü küçümsüyorsunuz!Dialogue: 0,0:06:30.54,0:06:32.58,Main-207-,,0,0,0,,Gittiğimizde göreceğiz.Dialogue: 0,0:06:32.58,0:06:34.08,Main-207-,,0,0,0,,Endişelenme.Dialogue: 0,0:06:34.58,0:06:37.04,Main-207-,,0,0,0,,Neyse, hadi yemek yiyelim.Dialogue: 0,0:06:37.50,0:06:39.05,Main-207-,,0,0,0,,Evet! Yemek!Dialogue: 0,0:06:39.67,0:06:40.88,Main-207-,,0,0,0,,Ha? Yemek mi?Dialogue: 0,0:06:41.34,0:06:42.72,Main-207-,,0,0,0,,Ne yemek istersiniz?Dialogue: 0,0:06:42.72,0:06:44.97,Main-207-,,0,0,0,,Kemikli et istiyorum!Dialogue: 0,0:06:44.97,0:06:46.76,Main-207-,,0,0,0,,Kızarmış fasulye istiyorum!Dialogue: 0,0:06:46.76,0:06:47.72,Main-207-,,0,0,0,,Tamamdır!Dialogue: 0,0:06:47.72,0:06:48.68,Main-207-,,0,0,0,,Bana bırakın!Dialogue: 0,0:06:50.31,0:06:51.43,Main-207-,,0,0,0,,Hemen hallederim!Dialogue: 0,0:06:52.02,0:06:53.31,Main-207-,,0,0,0,,Et ve fasulye...Dialogue: 0,0:06:54.10,0:06:57.40,Main-207-,,0,0,0,,Aşçının olması ne kadar harika!Dialogue: 0,0:06:57.40,0:06:58.27,Main-207-,,0,0,0,,E-Evet!Dialogue: 0,0:06:58.65,0:07:00.27,Main-207-,,0,0,0,,Et! Kocaman bir et!Dialogue: 0,0:07:00.27,0:07:02.78,Main-207-,,0,0,0,,Ve benim için fasulye! Kocaman bir tabak!Dialogue: 0,0:07:16.50,0:07:17.54,Main-207-,,0,0,0,,Tamamdır.Dialogue: 0,0:07:17.54,0:07:20.29,Main-207-,,0,0,0,,Bu ayın ödemesi. Al bakalım.Dialogue: 0,0:07:21.30,0:07:22.80,Main-207-,,0,0,10,,Arlong-kun.Dialogue: 0,0:07:22.80,0:07:24.88,Main-207-,,0,0,10,,Sıradan korsanlardan farklı bir...Dialogue: 0,0:07:24.88,0:07:26.88,Main-207-,,0,0,10,,yaklaşımın var.Dialogue: 0,0:07:26.88,0:07:28.76,Main-207-,,0,0,10,,Düzenin farkındasın.Dialogue: 0,0:07:31.85,0:07:33.47,Main-207-,,0,0,10,,Sen de öylesin!Dialogue: 0,0:07:33.47,0:07:37.73,Main-207-,,0,0,10,,Benimle arkadaş olduğun sürece bütün Doğu Mavi'den kâr edebilirsin!Dialogue: 0,0:07:38.35,0:07:42.69,Main-207-,,0,0,0,,Bir Denizci albayı için, çok akıllısın!Dialogue: 0,0:07:43.07,0:07:44.32,Main-207-,,0,0,0,,Çok teşekkürler.Dialogue: 0,0:07:46.32,0:07:47.91,Main-207-,,0,0,0,,Bu kadar resmi olma.Dialogue: 0,0:07:47.91,0:07:50.66,Main-207-,,0,0,0,,Paran olduğu zaman dünya mükemmel bir yer.Dialogue: 0,0:07:51.41,0:07:52.37,Main-207-,,0,0,0,,Para en iyisi.Dialogue: 0,0:07:52.37,0:07:54.62,Main-207-,,0,0,0,,Ona her şeyden çok güvenebilirsin.Dialogue: 0,0:07:55.04,0:07:56.58,Main-207-,,0,0,0,,Öyle değil mi?Dialogue: 0,0:07:57.33,0:07:58.71,Main-207-,,0,0,0,,Aynen öyle...Dialogue: 0,0:07:58.71,0:08:03.67,Main-207-,,0,0,0,,İnsanlardan nefret ederim ama sen istisnasın.Dialogue: 0,0:08:04.38,0:08:05.84,Main-207-,,0,0,0,,Artık...Dialogue: 0,0:08:05.84,0:08:06.97,Main-207-,,0,0,0,,Gitmem gerekiyor.Dialogue: 0,0:08:07.47,0:08:09.93,Main-207-,,0,0,0,,Acelen ne? Kal, bir içki iç.Dialogue: 0,0:08:10.80,0:08:15.89,Main-207-,,0,0,0,,Bir denizci devriye gemisi, korsan adasında gözükmemeli.Dialogue: 0,0:08:15.89,0:08:19.85,Main-207-,,0,0,0,,Seni karargâha şikayet eden herkesi öldürürüm.Dialogue: 0,0:08:19.85,0:08:21.69,Main-207-,,0,0,0,,Neyse, biz gidiyoruz.Dialogue: 0,0:08:22.11,0:08:24.19,Main-207-,,0,0,0,,Millet, albay geri dönüyor!Dialogue: 0,0:08:24.19,0:08:26.32,Main-207-,,0,0,0,,Gemisine kadar eşlik edin!Dialogue: 0,0:08:26.32,0:08:27.86,Main-207-,,0,0,10,,Anlaşıldı!Dialogue: 0,0:08:29.45,0:08:31.87,Main-207-,,0,0,10,,Ahtapot kabıma girin! Sizi götüreyim!Dialogue: 0,0:08:31.87,0:08:34.45,Main-207-,,0,0,0,,Olur. Teşekkürler.Dialogue: 0,0:08:34.45,0:08:37.83,Main-207-,,0,0,0,,Ama var ya, yüzünün komikliğine bir türlü inanamıyorum.Dialogue: 0,0:08:37.83,0:08:40.00,Main-207-,,0,0,0,,Fareye benziyor!Dialogue: 0,0:08:40.96,0:08:42.67,Main-207-,,0,0,0,,Lan! Hachi!Dialogue: 0,0:08:42.67,0:08:43.96,Main-207-,,0,0,0,,Ağzına dikkat et!Dialogue: 0,0:08:43.96,0:08:45.80,Main-207-,,0,0,0,,Albay değerli bir misafirimiz!Dialogue: 0,0:08:45.80,0:08:48.34,Main-207-,,0,0,0,,Evet, haklısın! Özür dilerim!Dialogue: 0,0:08:48.34,0:08:50.34,Main-207-,,0,0,0,,Sorun değil.Dialogue: 0,0:08:54.26,0:08:55.97,Main-207-,,0,0,0,,Tamam! Hadi gidelim!Dialogue: 0,0:08:56.72,0:08:58.23,Thoughts-207-,,0,0,0,,Kahrolası balıkadamlar...Dialogue: 0,0:08:58.23,0:09:00.31,Thoughts-207-,,0,0,0,,Midemi bulandırıyorlar.Dialogue: 0,0:09:00.31,0:09:02.44,Thoughts-207-,,0,0,0,,Ama paraları güzel!Dialogue: 0,0:09:17.45,0:09:19.54,Main-207-,,0,0,0,,Hey, sen! Önümden çekil!Dialogue: 0,0:09:20.58,0:09:23.04,Main-207-,,0,0,0,,Buraya Arlong'u öldürmeye geldim!Dialogue: 0,0:09:23.04,0:09:26.00,Main-207-,,0,0,0,,Arlong babamı öldürdü!Dialogue: 0,0:09:28.51,0:09:31.05,Main-207-,,0,0,0,,Çekil, yoksa seni de öldürürüm!Dialogue: 0,0:09:31.68,0:09:32.55,Main-207-,,0,0,0,,Hey!Dialogue: 0,0:09:36.51,0:09:40.81,Main-207-,,0,0,0,,Arlong'un senin gibi bir veletle uğraşacak zamanı yok!Dialogue: 0,0:09:42.65,0:09:44.61,Main-207-,,0,0,0,,Anladın mı? Şimdi evine git!Dialogue: 0,0:09:46.61,0:09:49.99,Main-207-,,0,0,0,,Bu parayla başının çaresine bak.Dialogue: 0,0:09:50.90,0:09:52.70,Main-207-,,0,0,0,,Kahretsin!Dialogue: 0,0:10:00.58,0:10:02.62,Main-207-,,0,0,0,,Oh! Geri dönmüşsün, Nami!Dialogue: 0,0:10:02.62,0:10:04.29,Main-207-,,0,0,0,,Bir süredir yoktun!Dialogue: 0,0:10:04.29,0:10:06.54,Main-207-,,0,0,0,,Nasıldı? Bu seferki vurgun nasıldı?Dialogue: 0,0:10:06.54,0:10:08.67,Main-207-,,0,0,0,,Fena vurgun yaptım!Dialogue: 0,0:10:08.67,0:10:11.34,Main-207-,,0,0,0,,Dolandıracak bir sürü enayi vardı!Dialogue: 0,0:10:11.34,0:10:12.51,Main-207-,,0,0,0,,Şuna baksana!Dialogue: 0,0:10:14.26,0:10:16.47,Main-207-,,0,0,0,,İhanet gerçekten senin göbek adın!Dialogue: 0,0:10:17.01,0:10:18.18,Main-207-,,0,0,0,,İltifat ediyorsun.Dialogue: 0,0:10:18.81,0:10:20.35,Main-207-,,0,0,0,,Hey! Kardeşlerim!Dialogue: 0,0:10:20.35,0:10:23.14,Main-207-,,0,0,0,,Yoldaşımız geri döndü! Hadi kutlayalım!Dialogue: 0,0:10:24.23,0:10:25.10,Main-207-,,0,0,0,,Bu Nami!Dialogue: 0,0:10:25.10,0:10:28.15,Main-207-,,0,0,0,,Nami dönmüş!Dialogue: 0,0:10:48.25,0:10:52.76,Main-207-,,0,0,0,,S-S-Sonunda geldik! Orası Arlong Park!Dialogue: 0,0:10:55.22,0:10:59.85,Main-207-,,0,0,0,,Grand Line'dan gelen balıkadam Arlong'un saklandığı yer orası mı?!Dialogue: 0,0:11:01.52,0:11:04.27,Main-207-,,0,0,0,,Nami gerçekten orada mı?!Dialogue: 0,0:11:05.06,0:11:08.86,Main-207-,,0,0,0,,Nami abla Going Merry'deydi,Dialogue: 0,0:11:08.86,0:11:12.23,Main-207-,,0,0,0,,o yüzden önce gemi adada mı görelim!Dialogue: 0,0:11:12.23,0:11:13.53,Main-207-,,0,0,0,,İ-İyi fikir!Dialogue: 0,0:11:19.12,0:11:20.45,Main-207-,,0,0,0,,Direkt dalıyoruz.Dialogue: 0,0:11:21.79,0:11:24.91,Main-207-,,0,0,0,,N-Neden aniden bunu yapalım ki?!Dialogue: 0,0:11:25.33,0:11:28.79,Main-207-,,0,0,0,,Aptal mısın?! Herhangi bir ipucu bulmadık bile!Dialogue: 0,0:11:29.21,0:11:31.25,Main-207-,,0,0,0,,Malum, balıkadamlar karşımızda!Dialogue: 0,0:11:31.25,0:11:33.26,Main-207-,,0,0,0,,İlk önce bir plana ihtiyacımız var!Dialogue: 0,0:11:33.26,0:11:35.34,Main-207-,,0,0,0,,Onun için zamanımız yok.Dialogue: 0,0:11:35.80,0:11:39.35,Main-207-,,0,0,0,,Luffy, Nami'yi geri getirmemizi emretti.Dialogue: 0,0:11:39.35,0:11:41.76,Main-207-,,0,0,0,,O yüzden ne olursa olsun gidip getireceğim!Dialogue: 0,0:11:42.39,0:11:43.60,Thoughts-207-,,0,0,0,,– Hiç iyi değil. – Hiç iyi değil.Dialogue: 0,0:11:43.93,0:11:44.98,Main-207-,,0,0,0,,Hadi gidelim!Dialogue: 0,0:11:52.19,0:11:53.57,Main-207-,,0,0,0,,İşte orada! Buldum!Dialogue: 0,0:11:53.94,0:11:56.53,Main-207-,,0,0,0,,Bu Going Merry! Neden orada ki?Dialogue: 0,0:11:56.95,0:12:00.37,Main-207-,,0,0,0,,Yani Nami abla burada!Dialogue: 0,0:12:00.37,0:12:04.45,Main-207-,,0,0,0,,Hey, sizi şerefsizler! Ne halt ediyorsunuz?! Çözün beni!Dialogue: 0,0:12:04.87,0:12:09.04,Main-207-,,0,0,0,,Arlong Park'ın çok doğusunda... Cocoyashi Köyü'ndeyiz.Dialogue: 0,0:12:09.04,0:12:10.29,Main-207-,,0,0,0,,Ama bir gariplik var.Dialogue: 0,0:12:10.29,0:12:13.63,Main-207-,,0,0,0,,Gemi neden köyden çok uzakta?Dialogue: 0,0:12:13.63,0:12:15.46,Main-207-,,0,0,0,,Hemen çözün dedim!Dialogue: 0,0:12:15.84,0:12:19.47,Main-207-,,0,0,0,,Yaralandığın için az kalsın ölüyordun!Dialogue: 0,0:12:19.47,0:12:21.14,Main-207-,,0,0,0,,Sakin ol ve dinlen!Dialogue: 0,0:12:23.47,0:12:26.10,Main-207-,,0,0,0,,Her şeyi bana bırakabilirsin!Dialogue: 0,0:12:28.31,0:12:31.69,Thoughts-207-,,0,0,0,,Onu bir gün gerçekten öldüreceğim!Dialogue: 0,0:12:31.69,0:12:35.11,Main-207-,,0,0,0,,Kızı geri getireceğim!Dialogue: 0,0:12:36.57,0:12:39.70,Main-207-,,0,0,0,,Arlong Park'ta olmadığı için çok rahatsın.Dialogue: 0,0:12:40.11,0:12:42.03,Main-207-,,0,0,0,,Sancak alabanda!Dialogue: 0,0:12:42.03,0:12:44.66,Main-207-,,0,0,0,,Hedefimiz Going Merry!Dialogue: 0,0:12:44.66,0:12:46.62,Main-207-,,0,0,0,,Anlaşıldı!Dialogue: 0,0:12:47.00,0:12:48.41,Main-207-,,0,0,0,,Pekâlâ!Dialogue: 0,0:12:48.41,0:12:52.00,Main-207-,,0,0,0,,Bilinmeyen topraklarda yürüdüğüm bu ana,Dialogue: 0,0:12:52.00,0:12:55.13,Main-207-,,0,0,0,,"Kaptan Usopp'un Büyük Macerası" diyorum!Dialogue: 0,0:13:04.97,0:13:06.31,Main-207-,,0,0,0,,İyi misin?!Dialogue: 0,0:13:06.31,0:13:07.47,Main-207-,,0,0,0,,Orada! Orada!Dialogue: 0,0:13:07.47,0:13:09.23,Main-207-,,0,0,0,,Balıkadamlar!Dialogue: 0,0:13:07.47,0:13:09.23,Main-207-,,0,0,0,,Balıkadamlar!Dialogue: 0,0:13:09.98,0:13:11.52,Main-207-,,0,0,0,,Tam yol ileri!Dialogue: 0,0:13:11.52,0:13:12.94,Main-207-,,0,0,0,,Başüstüne!Dialogue: 0,0:13:15.19,0:13:17.19,Main-207-,,0,0,0,,Neden onları geçtiniz?!Dialogue: 0,0:13:18.90,0:13:21.91,Main-207-,,0,0,0,,Kör müsün?! Onlar balıkadamlardı!Dialogue: 0,0:13:21.91,0:13:25.08,Main-207-,,0,0,0,,Arlong'un tayfasındalar! Korkunçlar! Bunda yanlış bir şey mi var?!Dialogue: 0,0:13:25.08,0:13:26.74,Main-207-,,0,0,0,,Bana bağırma!Dialogue: 0,0:13:27.16,0:13:31.21,Main-207-,,0,0,0,,Galiba bütün bölge Arlong'un kontrolü altında!Dialogue: 0,0:13:31.71,0:13:32.67,Main-207-,,0,0,0,,Şimdi ne yapacağız?Dialogue: 0,0:13:33.75,0:13:36.46,Main-207-,,0,0,0,,Pekâlâ! Geri dönüp Nami'yi alamadık diyelim!Dialogue: 0,0:13:36.46,0:13:39.92,Main-207-,,0,0,0,,Aptallar, çözün beni!Dialogue: 0,0:13:40.67,0:13:42.22,Main-207-,,0,0,0,,O tekne yabancı.Dialogue: 0,0:13:42.22,0:13:43.34,Main-207-,,0,0,0,,Şüpheli...Dialogue: 0,0:13:46.26,0:13:46.93,Main-207-,,0,0,0,,Kaçalım!Dialogue: 0,0:13:46.93,0:13:47.64,Main-207-,,0,0,0,,Katılıyorum!Dialogue: 0,0:13:47.64,0:13:50.06,Main-207-,,0,0,0,,Durun bir dakika, size diyorum!Dialogue: 0,0:13:53.10,0:13:54.31,Main-207-,,0,0,0,,– Hoşça kal! – Hoşça kal!Dialogue: 0,0:13:54.81,0:13:57.27,Main-207-,,0,0,0,,Hey! Bari çözün beni!Dialogue: 0,0:14:03.41,0:14:05.16,Main-207-,,0,0,0,,Ha? Sadece o mu var?Dialogue: 0,0:14:05.16,0:14:08.29,Main-207-,,0,0,0,,Ne oldu, biri seni terk mi etti?Dialogue: 0,0:14:08.29,0:14:10.00,Main-207-,,0,0,0,,G-Galiba...Dialogue: 0,0:14:10.00,0:14:11.96,Thoughts-207-,,0,0,0,,İkisini de öldüreceğim!Dialogue: 0,0:14:11.96,0:14:14.79,Main-207-,,0,0,0,,Anladım! O zaman bu yaralar işkence sonucu oldu!Dialogue: 0,0:14:14.79,0:14:18.25,Main-207-,,0,0,0,,Tamamdır! Şimdilik onu Arlong-san'a götürelim!Dialogue: 0,0:14:18.75,0:14:19.88,Main-207-,,0,0,0,,Affet bizi, Zoro!Dialogue: 0,0:14:19.88,0:14:22.84,Main-207-,,0,0,0,,Luffy'e ne kadar cesur olduğunu söyleyeceğim!Dialogue: 0,0:14:22.84,0:14:24.84,Main-207-,,0,0,0,,Çok şanssız!Dialogue: 0,0:14:24.84,0:14:27.01,Main-207-,,0,0,0,,Seni asla unutmayacağım, abi!Dialogue: 0,0:14:27.01,0:14:29.26,Main-207-,,0,0,0,,Tamam o zaman! Şimdilik adaya çıkalım!Dialogue: 0,0:14:29.26,0:14:30.02,Main-207-,,0,0,0,,Olur!Dialogue: 0,0:14:35.19,0:14:38.27,Main-207-,,0,0,0,,Burada Gosa adında bir köy olması lazım!Dialogue: 0,0:14:51.75,0:14:56.08,Main-207-,,0,0,0,,B-Burada ne oldu?!Dialogue: 0,0:14:56.08,0:15:00.59,Main-207-,,0,0,0,,Bir kaç hafta önce Arlong'un harap ettiğini duydum, ama...Dialogue: 0,0:15:00.59,0:15:04.55,Main-207-,,0,0,0,,B-Bütün evler ters dönmüş!Dialogue: 0,0:15:05.05,0:15:10.51,Main-207-,,0,0,0,,Balıkadamların insanlardan on kat daha güçlü olduğunu duydum!Dialogue: 0,0:15:10.93,0:15:15.52,Main-207-,,0,0,0,,Grand Line'dakiler bunu yapacak kapasitede mi?!Dialogue: 0,0:15:21.15,0:15:24.19,Main-207-,,0,0,0,,Sokak nasıl bu hale gelebilir?Dialogue: 0,0:15:24.95,0:15:28.07,Main-207-,,0,0,0,,Momoo diye bir canavar yaptı.Dialogue: 0,0:15:28.07,0:15:29.78,Main-207-,,0,0,0,,Canavar mı?Dialogue: 0,0:15:30.78,0:15:33.08,Main-207-,,0,0,0,,Burada canavarlar da mı var?Dialogue: 0,0:15:33.50,0:15:36.54,Main-207-,,0,0,0,,Onu Grand Line'dan getirdik.Dialogue: 0,0:15:37.33,0:15:39.17,Main-207-,,0,0,0,,Grand Line'dan, ha?Dialogue: 0,0:15:39.50,0:15:42.05,Main-207-,,0,0,0,,Bekle, getirdik mi...?!Dialogue: 0,0:15:42.05,0:15:44.92,Main-207-,,0,0,0,,Terk edilen adamla birliktesin, değil mi?!Dialogue: 0,0:15:47.47,0:15:49.85,Main-207-,,0,0,0,,Bay-bay!Dialogue: 0,0:15:48.76,0:15:49.85,Secondary-207-,,0,0,0,,Geri gel!Dialogue: 0,0:15:50.30,0:15:52.47,Secondary-207-,,0,0,0,,Asla!Dialogue: 0,0:15:50.85,0:15:52.47,Main-207-,,0,0,0,,Kıl payı kurtuldum...Dialogue: 0,0:15:53.60,0:15:54.85,Main-207-,,0,0,0,,Usopp abi,...Dialogue: 0,0:15:55.48,0:15:56.77,Main-207-,,0,0,0,,lütfen güvende ol!Dialogue: 0,0:15:56.77,0:15:59.77,Main-207-,,0,0,0,,Burada Yosaku ve Luffy abiyi bekleyeceğim!Dialogue: 0,0:16:01.44,0:16:04.78,Main-207-,,0,0,0,,Sanki balıkadam beni karada yakalayabilir de!Dialogue: 0,0:16:05.19,0:16:07.28,Main-207-,,0,0,0,,Ben buna alışkınım!Dialogue: 0,0:16:07.28,0:16:10.03,Main-207-,,0,0,0,,Yakalayabilirsen yakala!Dialogue: 0,0:16:11.99,0:16:13.91,Main-207-,,0,0,0,,N-Ne oluyor...?!Dialogue: 0,0:16:13.91,0:16:15.87,Main-207-,,0,0,0,,Buldum seni, balıkadam!Dialogue: 0,0:16:15.87,0:16:19.08,Main-207-,,0,0,0,,Babamın intikamını alacağım!Dialogue: 0,0:16:24.09,0:16:25.76,Main-207-,,0,0,0,,Balıkadamlarla uğraşma!Dialogue: 0,0:16:25.76,0:16:28.88,Main-207-,,0,0,0,,Unutma, Gosa'daki herkes...Dialogue: 0,0:16:28.88,0:16:33.06,Main-207-,,0,0,0,,sırf bir kişi balıkadamlara karşı çıktığı için katledildi.Dialogue: 0,0:16:35.22,0:16:36.27,Main-207-,,0,0,0,,Bekle...Dialogue: 0,0:16:36.27,0:16:38.60,Main-207-,,0,0,0,,Balıkadama benziyorsun, ama insansın.Dialogue: 0,0:16:38.60,0:16:39.39,Main-207-,,0,0,0,,Ucu ucuna.Dialogue: 0,0:16:39.39,0:16:41.06,Main-207-,,0,0,0,,Ucu ucuna mı?!Dialogue: 0,0:16:41.44,0:16:43.44,Main-207-,,0,0,0,,Neredesin?! Orada mısın?!Dialogue: 0,0:16:43.94,0:16:44.94,Main-207-,,0,0,0,,Geliyor!Dialogue: 0,0:16:44.94,0:16:46.44,Main-207-,,0,0,0,,Balıkadam!Dialogue: 0,0:16:46.44,0:16:47.95,Main-207-,,0,0,0,,Gerçeği de mi buradaymış?Dialogue: 0,0:16:50.53,0:16:51.78,Main-207-,,0,0,0,,Geri çekilin!Dialogue: 0,0:16:52.41,0:16:54.28,Main-207-,,0,0,0,,Ben, Kaptan Usopp, sizi koruyacağım!Dialogue: 0,0:16:54.28,0:16:56.25,Main-207-,,0,0,0,,Bir tanesiyle başa çıkabilirim!Dialogue: 0,0:16:58.00,0:16:59.04,Main-207-,,0,0,0,,Al bunu!Dialogue: 0,0:16:59.04,0:17:02.33,Main-207-,,0,0,0,,Ölümcül Kurşun Yıldız–Dialogue: 0,0:17:08.84,0:17:10.88,Main-207-,,0,0,0,,Kimse beni dinlemiyor!Dialogue: 0,0:17:10.88,0:17:13.51,Main-207-,,0,0,0,,Onlara bulaşırsan bizi öldürürler dedim ya!Dialogue: 0,0:17:24.44,0:17:26.32,Main-207-,,0,0,0,,N-Neredeyim ben?Dialogue: 0,0:17:26.32,0:17:27.69,Main-207-,,0,0,0,,Benim evimdesin.Dialogue: 0,0:17:29.36,0:17:30.70,Main-207-,,0,0,0,,Uyandın mı?Dialogue: 0,0:17:30.70,0:17:31.86,Main-207-,,0,0,0,,S-Sen de kimsin?!Dialogue: 0,0:17:32.28,0:17:34.03,Main-207-,,0,0,0,,Ben Nojiko.Dialogue: 0,0:17:34.03,0:17:35.70,Main-207-,,0,0,0,,Burada mandalina yetiştiririm.Dialogue: 0,0:17:35.70,0:17:38.70,Main-207-,,0,0,0,,Doğru! Beni bayılttın!Dialogue: 0,0:17:39.25,0:17:42.50,Main-207-,,0,0,0,,Seni kurtarmaya çalışmama rağmen!Dialogue: 0,0:17:42.83,0:17:44.50,Main-207-,,0,0,0,,Asıl ben seni kurtardım.Dialogue: 0,0:17:45.84,0:17:47.96,Main-207-,,0,0,0,,O balıkadama bir şey yapmış olsaydın,Dialogue: 0,0:17:47.96,0:17:50.55,Main-207-,,0,0,0,,kesinlikle ölmüş olurdun.Dialogue: 0,0:17:50.55,0:17:52.01,Main-207-,,0,0,0,,Lanet olası yabancılar!Dialogue: 0,0:17:54.30,0:17:57.14,Main-207-,,0,0,0,,Ama sen Gosa köyündensin, değil mi?Dialogue: 0,0:17:58.10,0:18:00.52,Main-207-,,0,0,0,,Eğer balıkadamlara karşı gelirsen,Dialogue: 0,0:18:00.52,0:18:04.86,Main-207-,,0,0,0,,ne olacağını çok iyi biliyorsun,  kendi gözlerinle gördün.Dialogue: 0,0:18:04.86,0:18:06.61,Main-207-,,0,0,0,,Biliyorum...!Dialogue: 0,0:18:06.61,0:18:10.82,Main-207-,,0,0,0,,Biliyorum! Ama babamı öldürdüler!Dialogue: 0,0:18:11.36,0:18:14.11,Main-207-,,0,0,0,,Her şeyi çaldılar, köyü yerle bir ettiler,Dialogue: 0,0:18:14.11,0:18:16.16,Main-207-,,0,0,0,,ve tonlarca insanı öldürdüler!Dialogue: 0,0:18:16.16,0:18:17.58,Main-207-,,0,0,0,,Hesabını vermeliler!Dialogue: 0,0:18:17.58,0:18:19.29,Main-207-,,0,0,0,,Ne olursa olsun, vermeliler!Dialogue: 0,0:18:19.66,0:18:23.04,Main-207-,,0,0,0,,O yüzden Arlong Park'a gittim!Dialogue: 0,0:18:23.04,0:18:26.29,Main-207-,,0,0,0,,Ama tayfasından bir kadın bana engel oldu!Dialogue: 0,0:18:29.42,0:18:30.63,Main-207-,,0,0,0,,O...Dialogue: 0,0:18:30.63,0:18:32.05,Main-207-,,0,0,0,,cadı gibiydi!Dialogue: 0,0:18:32.84,0:18:34.38,Main-207-,,0,0,0,,Nefret doluyum!Dialogue: 0,0:18:34.38,0:18:37.01,Main-207-,,0,0,0,,Ölmek umrumda değil, babamın intikamını alacağım!Dialogue: 0,0:18:37.01,0:18:38.26,Main-207-,,0,0,0,,O zaman öl.Dialogue: 0,0:18:39.81,0:18:42.77,Main-207-,,0,0,0,,Ölmeye hazırsan, git ve intikamını al!Dialogue: 0,0:18:42.77,0:18:44.73,Main-207-,,0,0,0,,Ama bunu unutma:Dialogue: 0,0:18:44.73,0:18:48.52,Main-207-,,0,0,0,,Ben ve Arlong Park'taki o "cadı" seni durdurduğumuza göreDialogue: 0,0:18:48.94,0:18:51.44,Main-207-,,0,0,0,,iki kez ölümden kurtuldun!Dialogue: 0,0:18:52.82,0:18:54.70,Main-207-,,0,0,0,,Çayını bitirip gidebilirsin.Dialogue: 0,0:18:54.70,0:18:55.41,Main-207-,,0,0,0,,Hey!Dialogue: 0,0:18:55.41,0:18:58.37,Main-207-,,0,0,0,,Çocuğa kötü davranmıyor musun?!Dialogue: 0,0:18:58.37,0:19:01.91,Main-207-,,0,0,0,,Çocuk ya da değil, eğer biri ölmek istiyorsa, bırak ölsün!Dialogue: 0,0:19:02.75,0:19:06.21,Main-207-,,0,0,0,,Zor günleri atlatacak cesareti yok zaten!Dialogue: 0,0:19:06.21,0:19:07.33,Main-207-,,0,0,0,,Nasıl yani?Dialogue: 0,0:19:07.33,0:19:10.88,Main-207-,,0,0,0,,Ölümden daha acılı bir hayat yaşarken,Dialogue: 0,0:19:10.88,0:19:13.84,Main-207-,,0,0,0,,geleceğe odaklanan bir çocuk tanıyorum.Dialogue: 0,0:19:14.59,0:19:19.97,Main-207-,,0,0,0,,Bu yüzden onun gibi hayatını çöpe atanlardan nefret ediyorum!Dialogue: 0,0:19:22.47,0:19:26.10,Main-207-,,0,0,0,,Ne... Ne yapmalıyım?Dialogue: 0,0:19:26.69,0:19:29.31,Main-207-,,0,0,0,,Çok kızgınım! Ama buna katlanacağım!Dialogue: 0,0:19:30.19,0:19:31.27,Main-207-,,0,0,0,,Peki ya annen?Dialogue: 0,0:19:33.65,0:19:35.28,Main-207-,,0,0,0,,Hâlâ hayatta.Dialogue: 0,0:19:37.20,0:19:39.20,Main-207-,,0,0,0,,Senin için endişelenmiştir.Dialogue: 0,0:19:39.20,0:19:40.53,Main-207-,,0,0,0,,Yanına dön.Dialogue: 0,0:19:52.30,0:19:55.09,Main-207-,,0,0,0,,Dövmelerine rağmen o kadar kötü biri değilsin.Dialogue: 0,0:19:55.09,0:19:56.26,Main-207-,,0,0,0,,Ön yargı!Dialogue: 0,0:19:56.63,0:19:59.22,Main-207-,,0,0,0,,Oysa senin hakkında hiçbir şey bilmiyorum.Dialogue: 0,0:19:59.22,0:20:00.76,Main-207-,,0,0,0,,Ah, doğru!Dialogue: 0,0:20:01.10,0:20:03.39,Main-207-,,0,0,0,,Benim adım Kaptan Usopp!Dialogue: 0,0:20:03.39,0:20:05.52,Main-207-,,0,0,0,,Nami adında bir kızı arıyorum.Dialogue: 0,0:20:08.31,0:20:11.52,Main-207-,,0,0,0,,Ne?! Nami, Arlong korsanlarının bir yetkilisi mi?!Dialogue: 0,0:20:11.94,0:20:12.98,Main-207-,,0,0,0,,Evet.Dialogue: 0,0:20:12.98,0:20:15.15,Main-207-,,0,0,0,,Buradaki herkes bilir.Dialogue: 0,0:20:15.15,0:20:19.36,Main-207-,,0,0,0,,O küçük çocuk bile onun cadı gibi göründüğünü söyledi.Dialogue: 0,0:20:19.36,0:20:23.20,Main-207-,,0,0,0,,Daha da şaşırtıcı olan, o cadı bu evde büyüdü!Dialogue: 0,0:20:27.71,0:20:30.04,Main-207-,,0,0,0,,Nami'yle evlatlık kardeşiz.Dialogue: 0,0:20:32.54,0:20:34.21,Main-207-,,0,0,0,,Yani burası...Dialogue: 0,0:20:35.55,0:20:37.13,Main-207-,,0,0,0,,Nami'nin evi mi?Dialogue: 0,0:20:37.13,0:20:39.76,Main-207-,,0,0,0,,Nami ve ben yetimiz.Dialogue: 0,0:20:40.30,0:20:42.68,Main-207-,,0,0,0,,Bu evde büyüdük.Dialogue: 0,0:20:42.68,0:20:45.06,Main-207-,,0,0,0,,Koruyucu annemiz öldü,Dialogue: 0,0:20:45.06,0:20:49.27,Main-207-,,0,0,0,,ama üçümüz bu evde Cocoyashi köyünde mutlu mesut yaşardık.Dialogue: 0,0:20:52.02,0:20:56.40,Main-207-,,0,0,0,,Sonra, Nami köyüne ve arkadaşlarına ihanet edip,Dialogue: 0,0:20:56.40,0:20:59.15,Main-207-,,0,0,0,,Arlong'un tayfasına mı katıldı?!Dialogue: 0,0:20:59.49,0:21:00.91,Main-207-,,0,0,0,,Az çok öyle.Dialogue: 0,0:21:00.91,0:21:02.95,Main-207-,,0,0,0,,Gerçek bir cadı, ha?Dialogue: 0,0:21:03.78,0:21:06.08,Main-207-,,0,0,0,,Kahretsin! Olan bu mu yani?!Dialogue: 0,0:21:06.08,0:21:08.71,Main-207-,,0,0,0,,Yani bizi de kandırdı!Dialogue: 0,0:21:08.71,0:21:11.63,Main-207-,,0,0,0,,En başından beri hazinemizin peşindeydi!Dialogue: 0,0:21:11.63,0:21:14.84,Main-207-,,0,0,0,,Oysa, köyümü korumak için bana yardım ettiğindeDialogue: 0,0:21:14.84,0:21:18.34,Main-207-,,0,0,0,,ve bizimle yelken açtığında çok mutlu görünüyordu.Dialogue: 0,0:21:18.97,0:21:21.30,Main-207-,,0,0,0,,Öyle mi? Mutlu mu görünüyordu?Dialogue: 0,0:21:23.09,0:21:24.30,Main-207-,,0,0,0,,O mu?Dialogue: 0,0:21:24.81,0:21:28.14,Main-207-,,0,0,0,,Onu geri getirmek için buraya kadar geldik,Dialogue: 0,0:21:28.14,0:21:30.31,Main-207-,,0,0,0,,ama galiba buna gerek kalmad–Dialogue: 0,0:21:34.77,0:21:40.49,Main-207-,,0,0,0,,Bu bana maalesef birimizin balıkadamlar  tarafından yakalandığını hatırlattı.Dialogue: 0,0:21:41.53,0:21:43.41,Main-207-,,0,0,0,,Bu çok kötü.Dialogue: 0,0:21:43.41,0:21:45.74,Main-207-,,0,0,0,,Acaba nasıl dayanıyor?Dialogue: 0,0:21:45.74,0:21:48.08,Main-207-,,0,0,0,,Kapıyı açın!Dialogue: 0,0:21:48.08,0:21:50.54,Main-207-,,0,0,0,,Şüpheli birini getirdik!Dialogue: 0,0:22:01.09,0:22:02.84,Main-207-,,0,0,0,,Tekrar soruyorum.Dialogue: 0,0:22:02.84,0:22:05.85,Main-207-,,0,0,0,,Neden buraya geldin?Dialogue: 0,0:22:06.76,0:22:11.10,Main-207-,,0,0,0,,Zaten söyledim. Bir kadını arıyorum, seni ucube yarı-balık!Dialogue: 0,0:22:12.60,0:22:15.61,Main-207-,,0,0,0,,Alçak bir insan için pek büyük bir ağzın var.Dialogue: 0,0:22:15.61,0:22:19.07,Main-207-,,0,0,0,,Bu seferlik görmezden geleceğim, ama asla "yarı-balık" deme.Dialogue: 0,0:22:20.07,0:22:23.03,Main-207-,,0,0,0,,Biz balıkadamlar, su altında nefes alabilen...Dialogue: 0,0:22:23.03,0:22:25.03,Main-207-,,0,0,0,,evrimleşmiş insanlarız.Dialogue: 0,0:22:25.03,0:22:29.74,Main-207-,,0,0,0,,Bu balık yetenekleri bizi sizden üstün kılıyor.Dialogue: 0,0:22:29.74,0:22:34.21,Main-207-,,0,0,0,,Kanıt olarak, insanları aşan sayısız yeteneğe sahibiz!Dialogue: 0,0:22:35.08,0:22:39.59,Main-207-,,0,0,0,,Balıkadamlar her şeyin efendisidir, bunu kafana sok!Dialogue: 0,0:22:39.59,0:22:44.18,Main-207-,,0,0,0,,İnsanların balıkadamlara meydan okuması doğaya karşı gelmektir!Dialogue: 0,0:22:44.84,0:22:48.31,Main-207-,,0,0,0,,Saçma düşüncelerinden bıktım, Arlong.Dialogue: 0,0:22:50.52,0:22:52.93,Main-207-,,0,0,0,,Kişisel algılama, Nami.Dialogue: 0,0:22:52.93,0:22:55.56,Main-207-,,0,0,0,,İnsan olabilirsin, ama sen bir istisnasın.Dialogue: 0,0:22:55.56,0:22:59.36,Main-207-,,0,0,0,,Yetenekli bir haritacı ve tayfanın vazgeçilmez üyesisin!Dialogue: 0,0:22:59.36,0:23:02.15,Main-207-,,0,0,0,,Bizim için değerli deniz haritaları yapıyorsun!Dialogue: 0,0:23:02.57,0:23:05.78,Main-207-,,0,0,0,,Siz moronlardan çok daha zekiyim.Dialogue: 0,0:23:05.78,0:23:06.99,Main-207-,,0,0,0,,Bu çok doğal.Dialogue: 0,0:23:07.37,0:23:08.24,Main-207-,,0,0,0,,Hey, Nami!Dialogue: 0,0:23:08.24,0:23:09.95,Main-207-,,0,0,0,,"Haritacı" diyerek ne demek istedi?!Dialogue: 0,0:23:09.95,0:23:13.16,Main-207-,,0,0,0,,Neden bu adamlarla dostmuşsun gibi davranıyorsun?!Dialogue: 0,0:23:13.16,0:23:15.96,Main-207-,,0,0,0,,Ne? Senin tanıdığın mı?Dialogue: 0,0:23:15.96,0:23:17.46,Main-207-,,0,0,0,,Saçmalama.Dialogue: 0,0:23:17.46,0:23:18.96,Main-207-,,0,0,0,,Sadece bir hedefti.Dialogue: 0,0:23:18.96,0:23:22.92,Main-207-,,0,0,0,,Elindeki bütün hazineyi çaldım.Dialogue: 0,0:23:23.42,0:23:27.43,Main-207-,,0,0,0,,Kandırıldığını anlamadan beni buraya kadar takip ettiğine inanamıyorum.Dialogue: 0,0:23:27.43,0:23:28.89,Main-207-,,0,0,0,,Ne kadar saf.Dialogue: 0,0:23:29.51,0:23:31.89,Main-207-,,0,0,0,,Bu senin gerçek yüzün, ha?Dialogue: 0,0:23:31.89,0:23:34.39,Main-207-,,0,0,0,,Korsanlara bu kadar laf ettikten sonra...Dialogue: 0,0:23:34.39,0:23:35.89,Main-207-,,0,0,0,,Şaşırdın mı?Dialogue: 0,0:23:35.89,0:23:37.90,Main-207-,,0,0,0,,Hepsi bir oyundu.Dialogue: 0,0:23:37.90,0:23:39.52,Main-207-,,0,0,0,,Bu yeterince açıklıyor mu?Dialogue: 0,0:23:42.15,0:23:43.65,Thoughts-207-,,0,0,0,,O...Dialogue: 0,0:23:51.20,0:23:54.04,Main-207-,,0,0,0,,Ben açık ve net bir şekilde korsanım!Dialogue: 0,0:23:54.04,0:23:56.08,Main-207-,,0,0,0,,Arlong korsanlarında bir yetkiliyim!Dialogue: 0,0:23:58.67,0:24:00.92,Main-207-,,0,0,0,,Yani onları gerçekten kandırdın!Dialogue: 0,0:24:01.67,0:24:03.92,Main-207-,,0,0,0,,Bu kız soğukkanlı bir cadı gibidir,Dialogue: 0,0:24:03.92,0:24:08.13,Main-207-,,0,0,0,,para için kendi ailesinin ölümüne bile göz yumar!Dialogue: 0,0:24:09.34,0:24:14.02,Main-207-,,0,0,0,,Onunla karşılaştığın için şansız olduğunu kabullen ve pes et.Dialogue: 0,0:24:14.02,0:24:15.77,Main-207-,,0,0,0,,Anladım.Dialogue: 0,0:24:16.64,0:24:21.23,Main-207-,,0,0,0,,Zaten ona hiç güvenmemiştim.Dialogue: 0,0:24:21.56,0:24:25.19,Main-207-,,0,0,0,,Katil olsaydı bile, şaşırmazdım.Dialogue: 0,0:24:25.19,0:24:28.70,Main-207-,,0,0,0,,O zaman, çekip gider misin?! Göz zevkimi bozuyorsun!Dialogue: 0,0:24:40.58,0:24:43.84,Main-207-,,0,0,0,,Ne oldu?! Niye aniden suya atladı?!Dialogue: 0,0:24:43.84,0:24:46.30,Main-207-,,0,0,0,,Bu bir çeşit numara mı?!Dialogue: 0,0:24:46.72,0:24:49.72,Main-207-,,0,0,0,,Hayır, kayıp düşmedi de...Dialogue: 0,0:24:49.72,0:24:51.01,Main-207-,,0,0,0,,O zaman kaçtı!Dialogue: 0,0:24:51.43,0:24:55.97,Main-207-,,0,0,0,,Mümkün değil, kolu ve bacağı bağlı! O şekilde yüzemez!Dialogue: 0,0:24:55.97,0:24:57.06,Main-207-,,0,0,0,,İntihar etmiştir.Dialogue: 0,0:24:57.73,0:24:58.94,Main-207-,,0,0,0,,Bırakın ölsün.Dialogue: 0,0:25:02.52,0:25:04.07,Thoughts-207-,,0,0,0,,Aptal herif!Dialogue: 0,0:25:16.75,0:25:17.62,Main-207-,,0,0,0,,Geri geldi.Dialogue: 0,0:25:17.62,0:25:20.29,Main-207-,,0,0,0,,Hey! Ne yapıyorsun, Nami?!Dialogue: 0,0:25:22.71,0:25:23.96,Main-207-,,0,0,0,,Ne yaptığını sanıyorsun?!Dialogue: 0,0:25:26.84,0:25:29.17,Main-207-,,0,0,0,,Asıl sen ne yaptığını sanıyorsun?Dialogue: 0,0:25:32.18,0:25:35.68,Main-207-,,0,0,0,,Sen sadece birinin ölümünü bile izleyemeyen küçük bir kızsın.Dialogue: 0,0:25:35.68,0:25:37.14,Main-207-,,0,0,0,,Rol yapmayı kes artık!Dialogue: 0,0:25:38.64,0:25:42.10,Main-207-,,0,0,0,,Bir dahakine beni daha erken kurtar, aptal! Öleceğimi sandım!Dialogue: 0,0:25:42.98,0:25:44.56,Main-207-,,0,0,0,,Canın cehenneme!Dialogue: 0,0:25:46.11,0:25:48.40,Main-207-,,0,0,0,,Benimle bir daha uğraşırsan öldürürüm seni!Dialogue: 0,0:25:49.19,0:25:50.40,Main-207-,,0,0,0,,Sanmıyorum.Dialogue: 0,0:25:51.74,0:25:53.53,Main-207-,,0,0,0,,Bayağı bandajla sarılmışsın.Dialogue: 0,0:25:53.53,0:25:56.83,Main-207-,,0,0,0,,Değiştirecek kıyafetim yoktu, o yüzden bunları kullandım.Dialogue: 0,0:26:05.63,0:26:07.09,Main-207-,,0,0,0,,Hey, Nami.Dialogue: 0,0:26:07.09,0:26:08.59,Main-207-,,0,0,0,,Onunla ne yapalım?Dialogue: 0,0:26:08.59,0:26:09.92,Main-207-,,0,0,0,,Hapse atın!Dialogue: 0,0:26:09.92,0:26:11.63,Main-207-,,0,0,0,,Onunla kendim ilgileneceğim!Dialogue: 0,0:26:11.63,0:26:14.39,Main-207-,,0,0,0,,Arlong-san ! Arlong-san !Dialogue: 0,0:26:15.68,0:26:17.31,Main-207-,,0,0,0,,Ne oldu, kardeşim?Dialogue: 0,0:26:17.68,0:26:18.47,Main-207-,,0,0,0,,Özür dilerim!Dialogue: 0,0:26:18.47,0:26:24.98,Main-207-,,0,0,0,,Onun uzun burunlu bir arkadaşı vardı ama elimden kaçırdım!Dialogue: 0,0:26:24.98,0:26:27.15,Thoughts-207-,,0,0,0,,Bu da ne, Usopp?!Dialogue: 0,0:26:27.15,0:26:29.32,Thoughts-207-,,0,0,0,,Sende mi fark edildin?!Dialogue: 0,0:26:29.32,0:26:33.49,Main-207-,,0,0,0,,Cocoyashi Köyü'ne kaçtığını düşünüyorum.Dialogue: 0,0:26:34.16,0:26:35.74,Main-207-,,0,0,0,,Cocoyashi Köyü, demek?Dialogue: 0,0:26:36.37,0:26:37.74,Main-207-,,0,0,0,,Mükemmel.Dialogue: 0,0:26:37.74,0:26:39.70,Main-207-,,0,0,0,,Orada başka işlerim de vardı.Dialogue: 0,0:26:45.96,0:26:48.04,Main-207-,,0,0,0,,Millet! Arlong geliyor!Dialogue: 0,0:26:48.04,0:26:49.59,Main-207-,,0,0,0,,Ne?!Dialogue: 0,0:26:49.59,0:26:51.30,Main-207-,,0,0,0,,Ne için?!Dialogue: 0,0:26:51.30,0:26:53.59,Main-207-,,0,0,0,,Haracımızı daha yeni ödedik!Dialogue: 0,0:26:54.51,0:26:58.47,Main-207-,,0,0,0,,Büyük ihtimalle buldukları silahım ile alakalı.Dialogue: 0,0:26:58.47,0:27:00.52,Main-207-,,0,0,0,,Herkes evine dönsün.Dialogue: 0,0:27:00.52,0:27:01.89,Main-207-,,0,0,0,,Gen-san !Dialogue: 0,0:27:02.81,0:27:03.98,Main-207-,,0,0,0,,Geldiler!Dialogue: 0,0:27:12.40,0:27:14.53,Main-207-,,0,0,0,,Yani elinde...Dialogue: 0,0:27:14.53,0:27:17.70,Main-207-,,0,0,0,,silah olan piç sensin.Dialogue: 0,0:27:17.70,0:27:19.74,Main-207-,,0,0,0,,Evet, bu doğru.Dialogue: 0,0:27:19.74,0:27:24.75,Main-207-,,0,0,10,,Silah koleksiyonlarını hep sevmişimdir.Dialogue: 0,0:27:24.75,0:27:28.71,Main-207-,,0,0,10,,Sizin yönetiminizde koleksiyon yapmaya da mı izin yok?Dialogue: 0,0:27:29.17,0:27:31.25,Main-207-,,0,0,0,,Evet, yok.Dialogue: 0,0:27:31.71,0:27:34.59,Main-207-,,0,0,0,,Silahlar, kötülük ve şiddetten başka bir şey doğurmaz.Dialogue: 0,0:27:34.59,0:27:37.72,Main-207-,,0,0,0,,Barışı bozmanın başlıca sebebidirler.Dialogue: 0,0:27:39.05,0:27:41.68,Main-207-,,0,0,0,,Kocaman! Arlong o mu?!Dialogue: 0,0:27:41.68,0:27:43.27,Main-207-,,0,0,0,,İ-İnsan değil!Dialogue: 0,0:27:43.27,0:27:45.35,Main-207-,,0,0,0,,Evet, çünkü balıkadam.Dialogue: 0,0:27:45.35,0:27:46.23,Main-207-,,0,0,0,,Doğru.Dialogue: 0,0:27:46.56,0:27:49.81,Main-207-,,0,0,0,,20 şehir ve köy kontrolüm altında.Dialogue: 0,0:27:49.81,0:27:54.07,Main-207-,,0,0,0,,Yöneticiniz olarak, isyan çıkarmanızı göze alamam.Dialogue: 0,0:27:54.07,0:27:59.78,Main-207-,,0,0,0,,Herkese örnek olması için Gosa liman köyünü yok ettim!Dialogue: 0,0:27:59.78,0:28:01.99,Main-207-,,0,0,0,,Haracınızı zamanında ödememek,Dialogue: 0,0:28:02.45,0:28:05.33,Main-207-,,0,0,0,,bize karşı olan bir isyandır!Dialogue: 0,0:28:05.33,0:28:06.46,Main-207-,,0,0,0,,Hey!Dialogue: 0,0:28:06.46,0:28:07.83,Main-207-,,0,0,0,,Haraç derken?Dialogue: 0,0:28:07.83,0:28:09.21,Main-207-,,0,0,0,,Haraç işte.Dialogue: 0,0:28:09.21,0:28:11.29,Main-207-,,0,0,0,,Onlara ödediğimiz para.Dialogue: 0,0:28:11.79,0:28:15.80,Main-207-,,0,0,0,,Her ay hayatımızı satın alıyoruz.Dialogue: 0,0:28:15.80,0:28:17.80,Main-207-,,0,0,0,,Yetişkinler ve çocuklar...Dialogue: 0,0:28:17.80,0:28:20.80,Main-207-,,0,0,0,,Bir köyde haracını ödeyemeyen olursa...Dialogue: 0,0:28:20.80,0:28:22.89,Main-207-,,0,0,0,,bir kişi bile olsa,...Dialogue: 0,0:28:22.89,0:28:25.64,Main-207-,,0,0,0,,orası Gosa köyü gibi yok edilir.Dialogue: 0,0:28:25.64,0:28:29.23,Main-207-,,0,0,0,,Yani koca köy bir kişi yüzünden mi yok edildi?!Dialogue: 0,0:28:29.23,0:28:31.02,Main-207-,,0,0,0,,İşte Arlong'un yönetim şekli.Dialogue: 0,0:28:31.48,0:28:35.44,Main-207-,,0,0,0,,Onlar insanları öldürmeyi umursamayan bir ırk.Dialogue: 0,0:28:35.44,0:28:36.82,Main-207-,,0,0,0,,Dinleyin.Dialogue: 0,0:28:36.82,0:28:41.95,Main-207-,,0,0,0,,Siz aşağılık insanlar sadece düşünmeden  para ödemeye devam etmelisiniz.Dialogue: 0,0:28:42.70,0:28:46.08,Main-207-,,0,0,0,,Büyük miktarda sermayeye ihtiyacım var!Dialogue: 0,0:28:46.08,0:28:50.21,Main-207-,,0,0,0,,Haracınız sonunda Doğu Mavi'ye hükmedecek,Dialogue: 0,0:28:50.21,0:28:53.42,Main-207-,,0,0,0,,Arlong İmparatorluğu'nun temel taşı olacak!Dialogue: 0,0:28:55.00,0:28:57.30,Main-207-,,0,0,0,,A-Arlong İmparatorluğu mu?!Dialogue: 0,0:28:58.80,0:29:03.47,Main-207-,,0,0,0,,Tüm Doğu Mavi'yi balıkadamların yönetimine mi sokacaklar?!Dialogue: 0,0:29:23.24,0:29:26.87,Main-207-,,0,0,0,,Arlong geri dönmeden önce, hemen toz ol.Dialogue: 0,0:01:50.05,0:01:58.39,Title-207-,,0,0,0,,Arlong ParkDialogue: 1,0:01:50.05,0:01:58.39,Title-207-,,0,0,0,,Arlong ParkDialogue: 0,0:06:14.44,0:06:14.56,Captions-207-,,0,0,0,,m 848 508 l 845 512 840 513 840 518 817 528 814 466 834 445 851 480Dialogue: 0,0:06:14.44,0:06:14.56,Captions-207-,,0,0,0,,m 895 501 l 896 512 896 524 896 539 920 553 921 541 920 529 919 524 919 507Dialogue: 1,0:06:14.44,0:06:14.56,Captions-207-,,0,0,0,,NamiDialogue: 0,0:06:14.56,0:06:14.69,Captions-207-,,0,0,0,,m 768 555 l 706 540 713 451 824 444 843 444 878 454 991 496 995 547 919 542 858 450 847 446 782 458Dialogue: 1,0:06:14.56,0:06:14.69,Captions-207-,,0,0,0,,NamiDialogue: 0,0:06:14.69,0:06:18.19