yle: Author,Impress BT,20,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.8,0.8,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:01:50.10,0:02:00.10,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:13:00.00,0:13:10.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:21:16.10,0:21:18.80,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:01:50.10,0:01:55.98,Title,,0,0,250,,Korsanlar, CP9'a KarşıDialogue: 0,0:02:00.87,0:02:02.08,Main,,0,0,0,,Burası olmalı.Dialogue: 0,0:02:02.08,0:02:03.44,Main,,0,0,0,,Nihayet geldim.Dialogue: 0,0:02:04.52,0:02:07.43,Main,,0,0,0,,Merdivenlerden inip çıkıp durdum.Dialogue: 0,0:02:07.97,0:02:09.41,Main,,0,0,0,,Robin!Dialogue: 0,0:02:09.41,0:02:11.90,Main,,0,0,0,,Hey! Robin!Dialogue: 0,0:02:11.90,0:02:14.59,Main,,0,0,0,,Benim!Dialogue: 0,0:02:15.44,0:02:17.09,Main,,0,0,0,,Robin!Dialogue: 0,0:02:18.17,0:02:20.00,Main,,0,0,0,,Neredesin?!Dialogue: 0,0:02:21.97,0:02:23.37,Main,,0,0,0,,Kahretsin.Dialogue: 0,0:02:25.18,0:02:27.08,Main,,0,0,0,,Lanet olası güvercinli adam.Dialogue: 0,0:02:27.08,0:02:28.80,Main,,0,0,0,,Sahi ya!Dialogue: 0,0:02:28.80,0:02:31.63,Main,,0,0,0,,Nereye gittiklerini zaten biliyorum.Dialogue: 0,0:02:32.72,0:02:36.16,Main,,0,0,0,,Tek yapmam gereken Adalet Kapıları'na gitmek!Dialogue: 0,0:02:38.01,0:02:41.05,Main,,0,0,0,,Robin'in kelepçesinin anahtarı sende, değil mi?Dialogue: 0,0:02:41.05,0:02:43.39,Main,,0,0,0,,Seni öldürmeden önce vermek ister misin?Dialogue: 0,0:02:43.83,0:02:45.81,Main,,0,0,0,,Ne aptalca bir soru.Dialogue: 0,0:02:45.81,0:02:49.37,Main,,0,0,0,,Galley-La konağında  gerçek gücünü göremediğim için...Dialogue: 0,0:02:49.37,0:02:51.54,Main,,0,0,0,,...hayal kırıklığına uğramıştım.Dialogue: 0,0:02:51.54,0:02:55.73,Main,,0,0,0,,Siz korsanların buraya kadar gelebileceğini de  hiç düşünmemiştim.Dialogue: 0,0:02:57.36,0:03:01.45,Main,,0,0,0,,Son karşılaşmamızdakinden çok daha güçlüyüm.  Dikkatli ol.Dialogue: 0,0:03:01.45,0:03:04.75,Main,,0,0,0,,Orası kesin. Gücün dolup taşıyor.Dialogue: 0,0:03:04.75,0:03:06.91,Main,,0,0,0,,Bir canavarın gücü gibi.Dialogue: 0,0:03:07.71,0:03:09.72,Main,,0,0,0,,Gerçekten korkutucu bir adamsın.Dialogue: 0,0:03:11.23,0:03:11.92,Main,,0,0,0,,Ancak...Dialogue: 0,0:03:12.74,0:03:16.79,Main,,0,0,0,,...kılıç ustalığım CP9'ın en iyisidir.Dialogue: 0,0:03:16.79,0:03:18.46,Main,,0,0,0,,Beni hafife alma.Dialogue: 0,0:03:19.42,0:03:20.80,Main,,0,0,0,,Çift kılıç stili, ha?Dialogue: 0,0:03:26.27,0:03:27.50,Main,,0,0,0,,Bacak Fırtınası!Dialogue: 0,0:03:37.02,0:03:40.24,Main,,0,0,0,,Hayır. Üzgünüm ama dört kılıç kullanıyorum.Dialogue: 0,0:03:40.24,0:03:41.86,Main,,0,0,0,,Sorun değil!Dialogue: 0,0:03:41.86,0:03:44.41,Main,,0,0,0,,Sahi, tüm vücudun bir silah, değil mi?!Dialogue: 0,0:03:57.67,0:03:59.21,Main,,0,0,0,,72...Dialogue: 0,0:04:00.63,0:04:01.88,Main,,0,0,0,,Bacak Fırtınası...Dialogue: 0,0:04:02.30,0:04:04.34,Main,,0,0,0,,– ...Pound'luk Top! – ...Beyaz Yıldırım!Dialogue: 0,0:04:08.35,0:04:09.16,Main,,0,0,0,,Kazı!Dialogue: 0,0:04:25.06,0:04:27.07,Main,,0,0,0,,Eğlenceli!Dialogue: 0,0:04:30.42,0:04:33.62,Main,,0,0,0,,Oyunlar için vaktim yok.Dialogue: 0,0:04:33.62,0:04:36.73,Main,,0,0,0,,O zaman beni öldürmelisin.Dialogue: 0,0:04:39.08,0:04:40.34,Main,,0,0,0,,Bacak Fırtınası...Dialogue: 0,0:04:40.34,0:04:41.24,Main,,0,0,0,,...Kaos!Dialogue: 0,0:04:49.47,0:04:51.84,Thoughts,,0,0,0,,Bunu bu kadar rahat kontrol edebiliyor.Dialogue: 0,0:05:00.32,0:05:03.11,Main,,0,0,0,,Pislik. Benimle alay mı ediyorsun?!Dialogue: 0,0:05:03.66,0:05:06.07,Main,,0,0,0,,Hayır, etkilendim.Dialogue: 0,0:05:06.07,0:05:08.87,Main,,0,0,0,,Ama o kadar acelen varsa göstereceğim.Dialogue: 0,0:05:10.04,0:05:12.75,Main,,0,0,0,,Yeni gücüme tanıklık et.Dialogue: 0,0:05:31.99,0:05:34.31,Main,,0,0,0,,B-Bu da ne?Dialogue: 0,0:05:44.94,0:05:47.53,Thoughts,,0,0,0,,Bu oda da ne böyle?Dialogue: 0,0:05:47.53,0:05:51.25,Thoughts,,0,0,0,,Aşırı bahçecilik denen bir şey var.Dialogue: 0,0:05:51.25,0:05:53.12,Thoughts,,0,0,0,,Sanki dışarıdaymışız gibi.Dialogue: 0,0:05:53.83,0:05:54.64,Thoughts,,0,0,0,,Hayır, hayır, hayır!Dialogue: 0,0:05:54.64,0:05:57.21,Thoughts,,0,0,0,,Bu bir yana, öncelik Robin'in kelepçesinde.Dialogue: 0,0:05:57.84,0:05:59.49,Thoughts,,0,0,0,,O anahtar!Dialogue: 0,0:06:01.04,0:06:03.49,Thoughts,,0,0,0,,Sessizce...Dialogue: 0,0:06:03.49,0:06:05.09,Thoughts,,0,0,0,,Sessizce...Dialogue: 0,0:06:07.30,0:06:08.79,Thoughts,,0,0,0,,Düşünecek bir şey yok!Dialogue: 0,0:06:10.14,0:06:12.77,Thoughts,,0,0,0,,Sessizce gidersem...Dialogue: 0,0:06:12.77,0:06:15.56,Thoughts,,0,0,0,,...ve sessizce kaçarsam,...Dialogue: 0,0:06:15.56,0:06:17.95,Thoughts,,0,0,0,,...amacıma ulaşmış olacağım.Dialogue: 0,0:06:17.95,0:06:20.02,Thoughts,,0,0,0,,Yaralanmadan zafer elde edeceğim.Dialogue: 0,0:06:20.02,0:06:21.29,Thoughts,,0,0,0,,Evet, ben...Dialogue: 0,0:06:21.29,0:06:25.11,Thoughts,,0,0,0,,...Şanslı Kral'ım!Dialogue: 0,0:06:34.24,0:06:37.25,Thoughts,,0,0,0,,Sadece biraz daha!Dialogue: 0,0:06:41.92,0:06:44.21,Thoughts,,0,0,0,,H-Horoz mu?!Dialogue: 0,0:06:44.21,0:06:48.88,Thoughts,,0,0,0,,Durum kötü! Sessizlikten çok uzak olan bir kuş neden burada?!Dialogue: 0,0:06:50.94,0:06:51.92,Thoughts,,0,0,0,,Hiç iyi değil!Dialogue: 0,0:06:51.92,0:06:53.31,Thoughts,,0,0,0,,Öterse her şey biter!Dialogue: 0,0:06:53.31,0:06:56.14,Thoughts,,0,0,0,,Öterse o uyanacak ve beni öldürecek!Dialogue: 0,0:06:56.33,0:06:57.07,Thoughts,,0,0,0,,Hey!Dialogue: 0,0:06:57.07,0:06:58.40,Thoughts,,0,0,0,,Ne diye bana bakıyorsun?Dialogue: 0,0:06:58.40,0:06:59.54,Thoughts,,0,0,0,,Ötecek misin?Dialogue: 0,0:06:59.54,0:07:01.27,Thoughts,,0,0,0,,Öyle mi? Ha?Dialogue: 0,0:07:03.61,0:07:06.22,Thoughts,,0,0,0,,Horoz-kun. Horoz-san. Horoz-sama. Yalvarırım!Dialogue: 0,0:07:06.22,0:07:07.84,Thoughts,,0,0,0,,Lütfen ötme!Dialogue: 0,0:07:07.84,0:07:11.25,Thoughts,,0,0,0,,Ötme! Lütfen dur!Dialogue: 0,0:07:12.03,0:07:14.45,Main,,0,0,0,,Bunu yapacak bir horoz yok!Dialogue: 0,0:07:15.50,0:07:17.66,Main,,0,0,0,,Ha? Demek geldin, korsan.Dialogue: 0,0:07:18.29,0:07:20.62,Thoughts,,0,0,0,,L-Lanet olası horoz.Dialogue: 0,0:07:20.62,0:07:23.08,Main,,0,0,0,,Sanırım çılgınlık etme vakti geldi.Dialogue: 0,0:07:23.08,0:07:24.92,Thoughts,,0,0,0,,Lanet olası horoz.Dialogue: 0,0:07:37.60,0:07:39.18,Thoughts,,0,0,0,,G-Güçlü.Dialogue: 0,0:07:41.20,0:07:43.10,Main,,0,0,0,,Yani gelen sen misin?!Dialogue: 0,0:07:44.79,0:07:47.54,Main,,0,0,0,,Hükümet bayrağını vuran kişi.Dialogue: 0,0:07:47.79,0:07:50.66,Note,,0,0,0,,"Sürahideki yazı: İçki"Dialogue: 0,0:07:51.14,0:07:54.02,Main,,0,0,0,,Görünüşe göre yetenekli bir keskin nişancısın.Dialogue: 0,0:07:58.29,0:08:01.16,Main,,0,0,0,,Bu, uyandıktan sonraki ilk vuruşu muydu?!Dialogue: 0,0:08:01.16,0:08:04.02,Main,,0,0,0,,Bu yarım yamalak saldırı için afedersin.Dialogue: 0,0:08:04.02,0:08:05.00,Main,,0,0,0,,Üzgünüm.Dialogue: 0,0:08:06.77,0:08:08.42,Main,,0,0,0,,Acıttı, değil mi?Dialogue: 0,0:08:17.89,0:08:19.93,Main,,0,0,0,,Ama sorun değil.Dialogue: 0,0:08:19.93,0:08:23.31,Main,,0,0,0,,Görünüşüme rağmen işkence etmeyi sevmem.Dialogue: 0,0:08:24.95,0:08:27.02,Main,,0,0,0,,Şeytan Meyvesi?!Dialogue: 0,0:08:27.02,0:08:29.98,Main,,0,0,0,,Inu Inu Meyvesi. Model: Kurt.Dialogue: 0,0:08:27.02,0:08:29.98,Note,,0,0,0,,Inu: KöpekDialogue: 0,0:08:30.55,0:08:33.25,Main,,0,0,0,,Tüm yapmam gereken nefes borunu sökmek  ve her şey sona erecek.Dialogue: 0,0:08:33.25,0:08:37.31,Main,,0,0,0,,Öleceksen acı çekmeye gerek yok.Dialogue: 0,0:08:37.31,0:08:38.95,Main,,0,0,0,,Doğru değil mi?Dialogue: 0,0:08:39.22,0:08:40.71,Main,,0,0,0,,Kurt?!Dialogue: 0,0:08:43.31,0:08:44.67,Main,,0,0,0,,Kahretsin!Dialogue: 0,0:08:45.47,0:08:47.52,Main,,0,0,0,,Bu da ne? Dövüşmek mi istiyorsun?Dialogue: 0,0:08:47.52,0:08:49.42,Main,,0,0,0,,Pek güçlü görünmüyorsun.Dialogue: 0,0:08:49.97,0:08:53.39,Main,,0,0,0,,N-Neyse! Bunu yapacağım!Dialogue: 0,0:08:53.88,0:08:55.25,Main,,0,0,0,,Kapa çeneni!Dialogue: 0,0:08:55.25,0:08:58.60,Main,,0,0,0,,Buraya Robin'e yardım etmeye geldim!Dialogue: 0,0:09:00.61,0:09:02.27,Main,,0,0,0,,T-tavan...Dialogue: 0,0:09:03.62,0:09:04.56,Main,,0,0,0,,...çöküyor!Dialogue: 0,0:09:06.90,0:09:07.96,Main,,0,0,0,,Olamaz!Dialogue: 0,0:09:07.96,0:09:11.61,Main,,0,0,0,,Sadece yarı hayvan olmak istemiştim ama tam bir zürafa oldum!Dialogue: 0,0:09:11.61,0:09:15.07,Main,,0,0,0,,Konuşan bir zürafa düşüyor!Dialogue: 0,0:09:16.67,0:09:17.63,Main,,0,0,0,,Kaku!Dialogue: 0,0:09:17.63,0:09:20.58,Main,,0,0,0,,Yeni gücün çok gülünç!Dialogue: 0,0:09:20.58,0:09:21.84,Main,,0,0,0,,Kurt?!Dialogue: 0,0:09:21.84,0:09:24.41,Main,,0,0,0,,Burası ne böyle?! Hayvanat bahçesi mi?!Dialogue: 0,0:09:33.67,0:09:36.22,Main,,0,0,0,,Ushi Ushi Meyvesi! Model: Zürafa!Dialogue: 0,0:09:33.67,0:09:36.22,Note,,0,0,0,,Ushi - ÖküzDialogue: 0,0:09:37.73,0:09:39.66,Main,,0,0,0,,Seni zavallı pislik!Dialogue: 0,0:09:39.66,0:09:41.97,Main,,0,0,0,,Geri kalan hayatın boyunca  zürafa adam olacaksın!Dialogue: 0,0:09:43.82,0:09:46.07,Main,,0,0,0,,Zürafa olmanın nesi yanlış?!Dialogue: 0,0:09:46.07,0:09:48.90,Main,,0,0,0,,Hoşuma gittiğini söylemiştim!Dialogue: 0,0:09:50.20,0:09:53.00,Thoughts,,0,0,0,,O güvercinli pislik leopardı, değil mi?Dialogue: 0,0:09:53.00,0:09:56.36,Thoughts,,0,0,0,,İki Şeytan Meyvesi yeteneği daha var.Dialogue: 0,0:09:56.71,0:10:00.07,Thoughts,,0,0,0,,CP9, bu tür bir örgüt mü?!Dialogue: 0,0:10:02.21,0:10:05.77,Main,,0,0,0,,Y-Yani Zoan türü Şeytan Meyvesi yeteneği mi var?Dialogue: 0,0:10:05.77,0:10:07.70,Main,,0,0,0,,Kurt adam ve zürafa adam?Dialogue: 0,0:10:07.70,0:10:09.34,Main,,0,0,0,,Tam da kazanacak tiplere çattık.Dialogue: 0,0:10:10.35,0:10:14.16,Main,,0,0,0,,Ama Zoro'yla birlikte düştüğü için kurtuldum.Dialogue: 0,0:10:14.16,0:10:16.21,Thoughts,,0,0,0,,İkiye iki akıntısıyla gideceğim...Dialogue: 0,0:10:16.97,0:10:18.51,Thoughts,,0,0,0,,...ve onun ikisini de yenmesine izin vereceğim.Dialogue: 0,0:10:20.24,0:10:21.36,Thoughts,,0,0,0,,O da ne?Dialogue: 0,0:10:21.36,0:10:23.85,Thoughts,,0,0,0,,Açık bir kasa gibi.Dialogue: 0,0:10:24.77,0:10:27.31,Thoughts,,0,0,0,,Yoksa o tuhaf kelepçeler gerçekten...Dialogue: 0,0:10:28.91,0:10:30.90,Main,,0,0,0,,Gülme dedim!Dialogue: 0,0:10:30.90,0:10:32.08,Main,,0,0,0,,Hey, zürafa!Dialogue: 0,0:10:33.37,0:10:35.74,Main,,0,0,0,,Daha ne kadar tartışmayı planlıyorsun?Dialogue: 0,0:10:35.74,0:10:38.70,Main,,0,0,0,,Vaktim olmadığını söylemiştim.Dialogue: 0,0:10:39.80,0:10:43.33,Main,,0,0,0,,Böylesi uygunsa, seni olduğun halinle doğrayacağım.Dialogue: 0,0:10:43.33,0:10:48.25,Main,,0,0,0,,Zavallı şey...  Bir zürafanın tam yok edici gücünü hafife alma.Dialogue: 0,0:10:49.71,0:10:51.08,Main,,0,0,0,,Dönüşüm...Dialogue: 0,0:10:51.08,0:10:52.67,Main,,0,0,0,,...Melez Formu! Dialogue: 0,0:10:54.05,0:10:55.81,Main,,0,0,0,,Yeniden doğan güçlerimi...Dialogue: 0,0:10:56.43,0:10:59.53,Main,,0,0,0,,...sana göstereceğim.Dialogue: 0,0:11:11.59,0:11:13.00,Main,,0,0,0,,Berbat görünüyorsun!Dialogue: 0,0:11:13.00,0:11:13.99,Main,,0,0,0,,Gabeen!Dialogue: 0,0:11:13.00,0:11:13.99,Note,,0,0,0,,Gabeen - Çene düşmesi efektiDialogue: 0,0:11:13.99,0:11:15.90,Main,,0,0,0,,Sen! Sen demin...Dialogue: 0,0:11:20.17,0:11:23.21,Thoughts,,0,0,0,,Bana ne kadar basit bir şey söylettirdi.Dialogue: 0,0:11:23.21,0:11:24.04,Thoughts,,0,0,0,,Bu hiç iyi değil.Dialogue: 0,0:11:24.04,0:11:26.87,Thoughts,,0,0,0,,Tüm bu saçmalık dilimin sürçmesine neden oldu.Dialogue: 0,0:11:26.87,0:11:29.20,Thoughts,,0,0,0,,Konsantrasyonunu yitirme. Bu sadece kılıcını köreltir.Dialogue: 0,0:11:32.19,0:11:34.84,Main,,0,0,0,,Daha ne kadar gülmeye devam edeceksin, Jabra?!Dialogue: 0,0:11:35.45,0:11:36.82,Main,,0,0,0,,A-Afedersin.Dialogue: 0,0:11:37.75,0:11:39.92,Thoughts,,0,0,0,,Çok gülünç.Dialogue: 0,0:11:39.92,0:11:42.68,Thoughts,,0,0,0,,Niye vücudunun tüm bölümleri o kadar köşeli?Dialogue: 0,0:11:45.86,0:11:48.16,Main,,0,0,0,,B-Bu kelepçe de ne?!Dialogue: 0,0:11:48.16,0:11:49.73,Main,,0,0,0,,Olamaz!Dialogue: 0,0:11:49.95,0:11:52.08,Main,,0,0,0,,Eyvah! Çok üzgünüm, Zoro-kun!Dialogue: 0,0:11:52.08,0:11:54.06,Main,,0,0,0,,Hey! Bu ne demek oluyor, seni sersem?!Dialogue: 0,0:11:54.26,0:11:59.22,Main,,0,0,0,,O-Onlar muhtemelen Robin'inkiyle aynı Deniz Taşı kelepçeler.Dialogue: 0,0:11:59.22,0:12:01.95,Main,,0,0,0,,İki düşmanın da  Şeytan Meyvesi yeteneği olduğu için,...Dialogue: 0,0:12:01.95,0:12:04.82,Main,,0,0,0,,...onları kelepçelersem  güçsüzleşirler diye düşünmüştüm.Dialogue: 0,0:12:04.82,0:12:08.12,Main,,0,0,0,,O zaman niye beni kelepçeledin, seni aptal!?!Dialogue: 0,0:12:08.40,0:12:09.98,Main,,0,0,0,,A-Ama...Dialogue: 0,0:12:12.00,0:12:15.50,Main,,0,0,0,,Zürafanın suratı çok gülünç! Elim kaydı!Dialogue: 0,0:12:16.46,0:12:19.08,Main,,0,0,0,,Dört köşe bir zürafasın!Dialogue: 0,0:12:20.72,0:12:22.31,Main,,0,0,0,,Hiç şüphesiz!Dialogue: 0,0:12:24.01,0:12:26.51,Main,,0,0,0,,Hepinize lanet olsun!Dialogue: 0,0:12:28.48,0:12:32.10,Main,,0,0,0,,Şeytan Meyvesi yeteneğinin  dövüş güçlerinin tadını çıkarın!Dialogue: 0,0:12:33.69,0:12:34.97,Main,,0,0,0,,Bacak Fırtınası...Dialogue: 0,0:12:39.36,0:12:40.72,Main,,0,0,0,,O da ne?!Dialogue: 0,0:12:40.72,0:12:42.19,Main,,0,0,0,,Bir şey geliyor!Dialogue: 0,0:12:43.56,0:12:45.28,Main,,0,0,0,,...Dönen Kesim!Dialogue: 0,0:12:49.32,0:12:50.28,Main,,0,0,0,,Durum kötü!Dialogue: 0,0:12:50.96,0:12:52.20,Main,,0,0,0,,Eğil, Usopp!Dialogue: 0,0:13:14.90,0:13:16.44,Main,,0,0,0,,Anlıyorum.Dialogue: 0,0:13:16.97,0:13:19.31,Main,,0,0,0,,Uzunluk, daha uzun bir erim demek.Dialogue: 0,0:13:20.03,0:13:23.11,Main,,0,0,0,,Yeni gücün merkezkaç kuvvetine ekleme yapıyor.Dialogue: 0,0:13:23.11,0:13:26.08,Main,,0,0,0,,Böylece kılıcın daha dengeli ve güçlü oluyor.Dialogue: 0,0:13:29.91,0:13:31.84,Main,,0,0,0,,Ne?Dialogue: 0,0:13:31.84,0:13:33.87,Main,,0,0,0,,Hey, hiçbir şey kırılmamış.Dialogue: 0,0:13:33.87,0:13:35.21,Main,,0,0,0,,Tavana bir bak.Dialogue: 0,0:13:35.67,0:13:38.08,Main,,0,0,0,,Ne?! Tavan mı?Dialogue: 0,0:13:38.88,0:13:39.75,Main,,0,0,0,,Ha?Dialogue: 0,0:13:40.17,0:13:41.74,Main,,0,0,0,,Gökyüzünü görebiliyorum.Dialogue: 0,0:13:43.30,0:13:44.89,Main,,0,0,0,,Vaaaay.Dialogue: 0,0:13:44.89,0:13:46.22,Main,,0,0,0,,Acaba niye?Dialogue: 0,0:13:47.98,0:13:51.47,Main,,0,0,0,,Hey, Adalet Kulesi'ni kestiğini söylemeye çalışıyor olamazsın, değil mi?!Dialogue: 0,0:13:52.02,0:13:53.72,Main,,0,0,0,,Hey, hey, hey, hey...!Dialogue: 0,0:13:53.72,0:13:54.96,Main,,0,0,0,,Bu çok tehlikeli!Dialogue: 0,0:13:56.38,0:13:57.85,Main,,0,0,0,,Ne zavallıca.Dialogue: 0,0:13:57.86,0:14:00.64,Main,,0,0,0,,Dövüşürken duygularına kapılıyorsun.Dialogue: 0,0:14:00.64,0:14:02.13,Main,,0,0,0,,Kapa çeneni artık.Dialogue: 0,0:14:02.13,0:14:04.48,Main,,0,0,0,,Bu zürafa şeklini seviyorum.Dialogue: 0,0:14:04.48,0:14:06.65,Main,,0,0,0,,Zürafaları seviyorum.Dialogue: 0,0:14:06.97,0:14:09.28,Main,,0,0,0,,Evet, anladım, anladım.Dialogue: 0,0:14:10.37,0:14:13.11,Main,,0,0,0,,Kılıcın ne kadar keskinleşmiş olursa olsun,...Dialogue: 0,0:14:13.11,0:14:16.45,Main,,0,0,0,,...beni biraz olsun korkutmuyor.Dialogue: 0,0:14:18.79,0:14:20.28,Main,,0,0,0,,D-Dur! Kes şunu, Zoro!Dialogue: 0,0:14:20.28,0:14:21.88,Main,,0,0,0,,Acıtıyor! Ne yapıyorsun?!Dialogue: 0,0:14:22.20,0:14:24.15,Main,,0,0,0,,Niye beni çekiştiriyorsun?!Dialogue: 0,0:14:25.09,0:14:27.24,Main,,0,0,0,,Ha? Çekmek?Dialogue: 0,0:14:34.20,0:14:36.27,Main,,0,0,0,,Kilitlenmişiz.Dialogue: 0,0:14:36.27,0:14:38.55,Main,,0,0,0,,NE YAPIYORSUN SEN?!Dialogue: 0,0:14:38.55,0:14:40.48,Main,,0,0,0,,BENİM HATAM DEĞİL!Dialogue: 0,0:14:40.48,0:14:43.44,Main,,0,0,0,,Bana çarptığın için böyle oldu!Dialogue: 0,0:14:43.44,0:14:46.68,Main,,0,0,0,,Çünkü o saldırırken yalı kazığı gibi dikiliyordun!Dialogue: 0,0:14:46.68,0:14:48.45,Main,,0,0,0,,Hemen çıkar şunları!Dialogue: 0,0:14:52.93,0:14:55.37,Main,,0,0,0,,Bu sersemler ne yapıyor?Dialogue: 0,0:14:56.03,0:14:57.31,Main,,0,0,0,,Bilmem.Dialogue: 0,0:14:58.36,0:15:03.37,Main,,0,0,0,,Sonuç olarak, şu anda Robin'le aynı durumdayız.Dialogue: 0,0:15:03.37,0:15:04.63,Main,,0,0,0,,O zaman anahtar...Dialogue: 0,0:15:04.63,0:15:06.96,Main,,0,0,0,,CP9 üyelerinden biri almış...Dialogue: 0,0:15:06.96,0:15:08.63,Main,,0,0,0,,...ve geri almanın tek yolu onları yenmek.Dialogue: 0,0:15:08.63,0:15:11.96,Main,,0,0,0,,Bu imkansız! Bu şekilde nasıl dövüşebiliriz?!Dialogue: 0,0:15:11.96,0:15:14.34,Main,,0,0,0,,Avımız birbirine kilitlendi.Dialogue: 0,0:15:14.34,0:15:16.03,Main,,0,0,0,,Tamam, Jabra.Dialogue: 0,0:15:16.03,0:15:19.64,Main,,0,0,0,,Geri dur ve onları bana bırak.Dialogue: 0,0:15:19.64,0:15:24.15,Main,,0,0,0,,Hey! Avımı çalmaya mı çalışıyorsun?!Dialogue: 0,0:15:24.15,0:15:27.86,Main,,0,0,0,,O zaman ne yapalım? Birlikte dövüşmek istediğini mi söylüyorsun?Dialogue: 0,0:15:28.66,0:15:30.31,Main,,0,0,0,,Bunu yapmaktansa ölürüm.Dialogue: 0,0:15:30.31,0:15:31.45,Main,,0,0,0,,Ben de öyle.Dialogue: 0,0:15:31.45,0:15:32.65,Main,,0,0,0,,Hey, siz!Dialogue: 0,0:15:33.36,0:15:35.12,Main,,0,0,0,,Bize kelepçenizdeki numarayı söyleyin.Dialogue: 0,0:15:36.04,0:15:36.95,Main,,0,0,0,,Numara?Dialogue: 0,0:15:37.53,0:15:40.88,Main,,0,0,0,,Hangi anahtarın hangi kelepçeye ait olduğunu bilmek için,...Dialogue: 0,0:15:40.88,0:15:44.20,Main,,0,0,0,,...her kelepçe ve anahtar çifti ayrı ayrı numaralandırılmıştır.Dialogue: 0,0:15:44.20,0:15:46.87,Main,,0,0,0,,O kelepçenin anahtarı bizdeyse,...Dialogue: 0,0:15:46.87,0:15:48.44,Main,,0,0,0,,...onu sizin için açabiliriz.Dialogue: 0,0:15:48.44,0:15:50.13,Main,,0,0,0,,Ha? Cidden mi?!Dialogue: 0,0:15:50.48,0:15:51.63,Main,,0,0,0,,Numara, numara...Dialogue: 0,0:15:52.07,0:15:53.85,Main,,0,0,0,,Ah, işte! 2 numara!Dialogue: 0,0:15:53.85,0:15:55.10,Main,,0,0,0,,Açın lütfen!Dialogue: 0,0:15:56.44,0:15:57.76,Main,,0,0,0,,Bu değil.Dialogue: 0,0:15:57.78,0:15:59.47,Main,,0,0,0,,Benimki de değil.Dialogue: 0,0:15:59.47,0:16:00.31,Main,,0,0,0,,Çok yazık.Dialogue: 0,0:16:00.31,0:16:03.21,Main,,0,0,0,,Bu da ne?! Tam da umutlanmıştık!Dialogue: 0,0:16:03.21,0:16:04.51,Main,,0,0,0,,Kahretsin.Dialogue: 0,0:16:04.51,0:16:07.98,Main,,0,0,0,,O zaman diğer üç CP9 üyesinden biri almış.Dialogue: 0,0:16:08.56,0:16:10.15,Main,,0,0,0,,Yapacak bir şey yok.Dialogue: 0,0:16:10.67,0:16:12.91,Main,,0,0,0,,O zaman ilk kim öldürürse o kazanır.Dialogue: 0,0:16:12.91,0:16:14.47,Main,,0,0,0,,Sanırım tek yapabileceğimiz bu.Dialogue: 0,0:16:20.22,0:16:21.80,Main,,0,0,0,,NE?!Dialogue: 0,0:16:22.79,0:16:27.67,Captions,,1030,0,370,,Adalet Kulesi İç KısımDialogue: 0,0:16:28.33,0:16:30.67,Main,,0,0,0,,Oh! Bu merdivenler de ne böyle?Dialogue: 0,0:16:31.24,0:16:33.17,Main,,0,0,0,,Kesilmişler ve yerleri değişmiş.Dialogue: 0,0:16:37.46,0:16:41.48,Main,,0,0,0,,Demin hissettiğim darbeden kaynaklanmış olmalı.Dialogue: 0,0:16:41.48,0:16:43.73,Main,,0,0,0,,Umarım binaya bir şey olmaz.Dialogue: 0,0:16:53.02,0:16:54.79,Main,,0,0,0,,Hey, iyi misiniz?!Dialogue: 0,0:17:02.57,0:17:05.37,Main,,0,0,0,,Ha! Zoro! Sogeking!Dialogue: 0,0:17:06.33,0:17:09.38,Main,,0,0,0,,Ha! Hey! Chopper!Dialogue: 0,0:17:11.05,0:17:13.45,Thoughts,,0,0,0,,Ne? El sallıyorlar.Dialogue: 0,0:17:13.45,0:17:15.07,Thoughts,,0,0,0,,Eğleniyor gibiler.Dialogue: 0,0:17:16.42,0:17:18.30,Main,,0,0,0,,Hey!Dialogue: 0,0:17:21.14,0:17:22.18,Main,,0,0,0,,SERSEM!Dialogue: 0,0:17:22.18,0:17:23.88,Main,,0,0,0,,ŞU KELEPÇEYE BAK!Dialogue: 0,0:17:23.88,0:17:26.85,Main,,0,0,0,,2 NUMARALI ANAHTARI BUL!Dialogue: 0,0:17:27.28,0:17:29.31,Main,,0,0,0,,Ne? Anahtar mı?Dialogue: 0,0:17:35.77,0:17:37.41,Main,,0,0,0,,Bu da ne böyle?Dialogue: 0,0:17:37.78,0:17:41.10,Main,,0,0,0,,Bir köprü falan olacağını sanmıştım.Dialogue: 0,0:17:42.62,0:17:45.29,Main,,0,0,0,,Çok büyük bir girdap!Dialogue: 0,0:17:45.90,0:17:48.09,Main,,0,0,0,,Adalet Kapıları'nı görebiliyorum...Dialogue: 0,0:17:48.09,0:17:50.17,Main,,0,0,0,,...ama sıradan bir kayıkla geçebilir miyim?Dialogue: 0,0:17:50.92,0:17:52.77,Main,,0,0,0,,Neyse, hiç vakit yok.Dialogue: 0,0:17:52.77,0:17:54.30,Main,,0,0,0,,Bir şeyler denemeliyim!Dialogue: 0,0:17:54.84,0:17:56.05,Main,,0,0,0,,Başlıyorum!Dialogue: 0,0:17:56.05,0:17:59.47,Main,,0,0,0,,Bekle, Robin!Dialogue: 0,0:18:02.64,0:18:03.85,Thoughts,,0,0,0,,Anlıyorum.Dialogue: 0,0:18:04.47,0:18:07.06,Thoughts,,0,0,0,,Anahtarların ve kelepçelerin numarası var.Dialogue: 0,0:18:07.83,0:18:08.72,Flashbacks,,0,0,0,,Ne?Dialogue: 0,0:18:08.72,0:18:10.55,Flashbacks,,0,0,0,,Böyle kilitlenip kaldıysanız,...Dialogue: 0,0:18:10.55,0:18:12.27,Flashbacks,,0,0,0,,...ikisiyle de dövüşmek zorundayım.Dialogue: 0,0:18:12.60,0:18:13.76,Flashbacks,,0,0,0,,Aptallaşma!Dialogue: 0,0:18:13.76,0:18:16.53,Flashbacks,,0,0,0,,Onlar iki kişi! Yenilirsen...Dialogue: 0,0:18:16.53,0:18:19.61,Flashbacks,,0,0,0,,...hala kilitli olacağız ve bu şekilde öldürüleceğiz.Dialogue: 0,0:18:19.61,0:18:22.66,Flashbacks,,0,0,0,,Lütfen! Tek umudumuz sensin!Dialogue: 0,0:18:22.66,0:18:24.06,Flashbacks,,0,0,0,,Umut?Dialogue: 0,0:18:24.06,0:18:26.70,Flashbacks,,0,0,0,,Bu beni mutlu etmiyor, pislik!Dialogue: 0,0:18:27.12,0:18:29.10,Flashbacks,,0,0,0,,Sanji, Nami veya Franky.Dialogue: 0,0:18:29.10,0:18:33.21,Flashbacks,,0,0,0,,Onlardan biri 2 numaralı anahtarı aldığında, onu hemen buraya getir.Dialogue: 0,0:18:33.21,0:18:34.94,Flashbacks,,0,0,0,,Sana güveniyoruz!Dialogue: 0,0:18:34.94,0:18:38.63,Thoughts,,0,0,0,,Anahtarı en çabuk alacak olan kişi muhtemelen Sanji.Dialogue: 0,0:18:41.40,0:18:43.18,Thoughts,,0,0,0,,Sanji'yi arayacağım.Dialogue: 0,0:18:43.45,0:18:45.10,Thoughts,,0,0,0,,Onların tek umuduyum!Dialogue: 0,0:18:54.11,0:18:57.49,Main,,0,0,0,,Şimdi...Dialogue: 0,0:18:57.49,0:19:02.26,Main,,0,0,0,,Seni yakaladım!Dialogue: 0,0:18:57.49,0:19:03.20,Captions,,0,920,340,,Seviye 0 İzole Koridor Nami, Kumadori'ye KarşıDialogue: 0,0:19:03.77,0:19:04.83,Main,,0,0,0,,Bırak beni!Dialogue: 0,0:19:07.95,0:19:09.21,Main,,0,0,0,,Yoyoi! Dialogue: 0,0:19:09.21,0:19:11.84,Main,,0,0,0,,Vazgeç...Dialogue: 0,0:19:11.84,0:19:15.21,Main,,0,0,0,,...artık!Dialogue: 0,0:19:17.08,0:19:18.38,Main,,0,0,0,,Geber!Dialogue: 0,0:19:27.44,0:19:29.33,Thoughts,,0,0,0,,Ona karşı hiç şansım yok.Dialogue: 0,0:19:32.97,0:19:35.32,Main,,0,0,0,,Franky...Dialogue: 0,0:19:36.90,0:19:37.78,Main,,0,0,0,,Demir Parça!Dialogue: 0,0:19:37.78,0:19:39.09,Main,,0,0,0,,...Boksu!Dialogue: 0,0:19:45.39,0:19:45.95,Main,,0,0,0,,Kazı!Dialogue: 0,0:19:49.20,0:19:51.42,Main,,0,0,0,,Yumrukların ne biçim öyle?Dialogue: 0,0:19:45.95,0:19:53.33,Captions,,930,0,190,,Kiler Önündeki Koridor  Franky, Fukurou'ya KarşıDialogue: 0,0:19:51.42,0:19:53.33,Main,,0,0,0,,Sıradan insan değilsin, değil mi?Dialogue: 0,0:19:53.68,0:19:57.33,Main,,0,0,0,,Vücudunu çelik gibi  ne kadar sertleştirirsen sertleştir,...Dialogue: 0,0:19:57.33,0:20:00.47,Main,,0,0,0,,...yumruklarım gerçek çelikten yapılmıştır.Dialogue: 0,0:20:03.48,0:20:05.51,Main,,0,0,0,,O-olmaz!!Dialogue: 0,0:20:05.91,0:20:08.39,Main,,0,0,0,,Çay içecek zaman değil!Dialogue: 0,0:20:08.38,0:20:14.90,Captions,,890,0,380,,Kalifa'nın Odası Sanji, Kalifa'ya KarşıDialogue: 0,0:20:10.10,0:20:11.10,Main,,0,0,0,,Büyü!Dialogue: 0,0:20:11.10,0:20:13.26,Main,,0,0,0,,Bana büyü yapıldı!Dialogue: 0,0:20:13.26,0:20:17.86,Main,,0,0,0,,Aşk tuzağı denilen büyük bir dalga  tarafından neredeyse yutuluyordum!Dialogue: 0,0:20:19.58,0:20:21.40,Main,,0,0,0,,Zaten üç fincan içtin.Dialogue: 0,0:20:22.38,0:20:23.78,Main,,0,0,0,,Kapa çeneni, cadı!Dialogue: 0,0:20:23.78,0:20:25.62,Main,,0,0,0,,Daha fazla tuzaklarına düşmeyeceğim!Dialogue: 0,0:20:26.11,0:20:29.87,Main,,0,0,0,,Deniz treninde Robin-chan'a  korkunç bir biçimde hakaret eden CP9 üyelerini...Dialogue: 0,0:20:29.87,0:20:31.33,Main,,0,0,0,,...asla unutmayacağım!Dialogue: 0,0:20:36.79,0:20:38.29,Main,,0,0,0,,Şimdi...Dialogue: 0,0:20:38.85,0:20:40.71,Main,,0,0,0,,...bana anahtarını ver!Dialogue: 0,0:20:41.79,0:20:43.12,Main,,0,0,0,,Çok yazık.Dialogue: 0,0:20:43.88,0:20:45.74,Main,,0,0,0,,Sanırım acelen var.Dialogue: 0,0:20:46.18,0:20:49.79,Main,,0,0,0,,Buyur. Lütfen anahtarı al.Dialogue: 0,0:20:51.57,0:20:52.98,Main,,0,0,0,,Nerede?Dialogue: 0,0:20:53.45,0:20:54.94,Main,,0,0,0,,Bilmem.Dialogue: 0,0:20:55.30,0:20:59.57,Main,,0,0,0,,Vücudumda bir yerde. Acaba nereye saklı?Dialogue: 0,0:21:00.75,0:21:02.28,Main,,0,0,0,,Niye beni aramıyorsun?Dialogue: 0,0:21:04.49,0:21:06.45,Main,,0,0,0,,Memnuniyetle!Dialogue: 0,0:21:11.00,0:21:13.16,Main,,0,0,0,,Senin için umutsuz görünüyor.Dialogue: 0,0:21:13.16,0:21:16.08,Main,,0,0,0,,Tam bir aptalım.Dialogue: 0,0:21:16.08,0:21:18.80,Credits,,0,0,0,,Editing: Galaxy 9000  Timing: Galaxy 9000  Quality Assurance: Feeso, Galaxy 9000, Grug, Pepperjack  Soundtracking: Halee  Title & Infoboxes: Datenshi  Karaoke: KaitouYahiko  Translation: Crunchyroll, GaijinDialogue: 0,0:00:00.71,0:00:03.37,Lyrics,,0,0,0,,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪Dialogue: 0,0:00:03.59,0:00:06.46,Lyrics,,0,0,0,,♪ Bayrağımızı süsleyip, gökyüzüne kaldırarak. ♪Dialogue: 0,0:00:12.77,0:00:18.06,Lyrics,,0,0,0,,♪ Sonsuz okyanusu geçip aramaya gidelim. ♪Dialogue: 0,0:00:18.86,0:00:21.81,Lyrics,,0,0,0,,♪ Henüz kimse tarafından...Dialogue: 0,0:00:21.90,0:00:23.94,Lyrics,,0,0,0,,...bulunmamış bu dünyanın mucizesini. ♪Dialogue: 0,0:00:24.82,0:00:27.96,Lyrics,,0,0,0,,♪ Çarpıp duran göğsümüzdeki...Dialogue: 0,0:00:27.96,0:00:29.71,Lyrics,,0,0,0,,...aynı hislerle devam etmeliyiz. ♪Dialogue: 0,0:00:29.71,0:00:35.59,Lyrics,,0,0,0,,♪ Hayaller peşinde koşanlar tarafından bırakılmış ayak izleri. ♪Dialogue: 0,0:00:36.42,0:00:39.39,Lyrics,,0,0,0,,♪ Ne tür bir fırtınalı gece olursa olsun,...Dialogue: 0,0:00:39.39,0:00:42.39,Lyrics,,0,0,0,,...kalplerimizin bir olmasını sağlarsak...Dialogue: 0,0:00:42.39,0:00:46.54,Lyrics,,0,0,0,,...bu zorluğun üstesinden gelebileceğiz! ♪Dialogue: 0,0:00:46.68,0:00:47.86,Lyrics,,0,0,0,,♪ Her zaman ♪Dialogue: 0,0:00:48.76,0:00:51.59,Lyrics,,0,0,0,,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪Dialogue: 0,0:00:51.72,0:00:54.55,Lyrics,,0,0,0,,♪ Bayrağımızı dalgalandırıp gökyüzüne kaldırarak. ♪Dialogue: 0,0:00:54.60,0:00:57.14,Lyrics,,0,0,0,,♪ Kimseye göstermeyeceğiz. ♪Dialogue: 0,0:00:57.23,0:01:00.58,Lyrics,,0,0,0,,♪ Gözlerimizde yaşlar olsa bile. ♪Dialogue: 0,0:01:00.77,0:01:03.52,Lyrics,,0,0,0,,♪ Peşinden gidelim, peşinden gidelim! ♪Dialogue: 0,0:01:03.69,0:01:06.52,Lyrics,,0,0,0,,♪ Hayallerimize giden doğru yolu...Dialogue: 0,0:01:06.61,0:01:09.23,Lyrics,,0,0,0,,...gösteren pusulanın. ♪Dialogue: 0,0:01:09.23,0:01:11.40,Lyrics,,0,0,0,,♪ Durmayacağız. ♪Dialogue: 0,0:01:11.42,0:01:14.42,Lyrics,,0,0,0,,♪ Dünyayı dolaşarak...Dialogue: 0,0:01:14.45,0:01:15.85,Lyrics,,0,0,0,,...yeniden başlayalım! ♪Dialogue: 0,0:01:18.83,0:01:21.49,Lyrics,,0,0,0,,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪Dialogue: 0,0:01:21.80,0:01:24.54,Lyrics,,0,0,0,,♪ Hedefimize doğru herkesten daha fazla. ♪Dialogue: 0,0:01:24.63,0:01:27.12,Lyrics,,0,0,0,,♪ Şimdi kaçmazsak,...Dialogue: 0,0:01:27.22,0:01:30.54,Lyrics,,0,0,0,,...yarını sıkı sıkıya kavrayabileceğiz! ♪Dialogue: 0,0:01:30.60,0:01:33.63,Lyrics,,0,0,0,,♪ Peşinden gidelim, peşinden gidelim! ♪Dialogue: 0,0:01:33.68,0:01:36.51,Lyrics,,0,0,0,,♪ Gözlerinden yansıtılmış tüm şimdiki zamanın. ♪Dialogue: 0,0:01:36.56,0:01:38.93,Lyrics,,0,0,0,,♪ Bembeyaz bir kalp...Dialogue: 0,0:01:39.15,0:01:41.43,Lyrics,,0,0,0,,...bana tüm hikayeyi anlatacak! ♪Dialogue: 0,0:01:41.73,0:01:44.43,Lyrics,,0,0,0,,♪ Yepyeni bir dünyada...Dialogue: 0,0:01:44.53,0:01:45.83,Lyrics,,0,0,0,,...yeniden başlayalım! ♪