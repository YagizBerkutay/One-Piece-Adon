00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.8,0.8,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:01:50.05,0:02:00.05,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:15:00.00,0:15:10.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:28:47.00,0:28:50.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:01:50.05,0:01:55.30,Title,,0,0,260,,2. VitesDialogue: 0,0:01:58.54,0:02:01.84,Main,,0,0,0,,Vites? Tekniklerin mi gelişecek?Dialogue: 0,0:02:01.84,0:02:03.92,Main,,0,0,0,,Vücudunun her yerinden buhar çıkıyor.Dialogue: 0,0:02:03.92,0:02:07.05,Main,,0,0,0,,Bu senin buhar makinesi taklidin mi?Dialogue: 0,0:02:07.05,0:02:09.32,Main,,0,0,0,,Bu ne tür bir blöf?Dialogue: 0,0:02:14.69,0:02:16.07,Main,,0,0,0,,Burada...Dialogue: 0,0:02:18.33,0:02:22.25,Main,,0,0,0,,...hepinizle tanıştığım için memnunum.Dialogue: 0,0:02:24.63,0:02:28.41,Main,,0,0,0,,Sayenizde, arkadaşlarımın hiçbirini yitirmeden ilerleyebileceğim.Dialogue: 0,0:02:36.09,0:02:38.55,Main,,0,0,0,,Gomu Gomu No...Dialogue: 0,0:02:41.47,0:02:46.49,Main,,0,0,0,,Bana vurmak mı istiyorsun? Sadece saldırını savuşturma fırsatı veriyorsun.Dialogue: 0,0:02:47.27,0:02:50.39,Main,,0,0,0,,İyi nişan al ve bana vurmaya çalış.Dialogue: 0,0:02:50.39,0:02:51.03,Main,,0,0,0,,Kazı!Dialogue: 0,0:02:51.03,0:02:52.58,Main,,0,0,0,,...Jet Tabanca!Dialogue: 0,0:03:04.62,0:03:05.74,Main,,0,0,0,,Tüfek!Dialogue: 0,0:03:15.42,0:03:16.97,Thoughts,,0,0,0,,Onu göremiyorum bile!Dialogue: 0,0:03:21.48,0:03:22.64,Main,,0,0,0,,Damga!Dialogue: 0,0:03:23.89,0:03:24.46,Main,,0,0,0,,Ve...Dialogue: 0,0:03:24.46,0:03:25.60,Main,,0,0,0,,Mızrak!Dialogue: 0,0:03:27.85,0:03:29.01,Main,,0,0,0,,Füze!Dialogue: 0,0:03:39.61,0:03:40.77,Thoughts,,0,0,0,,Olamaz!Dialogue: 0,0:03:45.33,0:03:47.61,Thoughts,,0,0,0,,Hayır, hiç şüphe yok.Dialogue: 0,0:03:48.10,0:03:51.45,Flashbacks,,0,0,0,,Burada hepinizle tanıştığım için memnunum.Dialogue: 0,0:03:52.17,0:03:58.76,Thoughts,,0,0,0,,Bu çocuk, Altı Stil'den biri olan Kazı'da ustalaştı!Dialogue: 0,0:04:00.35,0:04:01.15,Main,,0,0,0,,Hava Kapısı.Dialogue: 0,0:04:12.82,0:04:14.98,Thoughts,,0,0,0,,Böyle saçma bir şey olamaz.Dialogue: 0,0:04:14.98,0:04:21.13,Thoughts,,0,0,0,,Sadece kullanmakla kalmadı,  vücudunu tekniğe dayanabilecek noktaya yükseltti.Dialogue: 0,0:04:21.78,0:04:27.38,Thoughts,,0,0,0,,Hiç kimsenin Altı Stil kullanıcısının hızını yakalaması mümkün değil!Dialogue: 0,0:04:27.38,0:04:29.42,Thoughts,,0,0,0,,Kaybetmem mümkün değil!Dialogue: 0,0:04:31.38,0:04:37.05,Thoughts,,0,0,0,,Eğer vücudunu kapıya çevirirsem ve hareketlerini bağlarsam, hiç şansı kalmayacak.Dialogue: 0,0:04:37.05,0:04:40.50,Thoughts,,0,0,0,,Tüm gücümle saldırıp bu dövüşü sona erdireceğim.Dialogue: 0,0:04:40.50,0:04:42.15,Main,,0,0,0,,Kayboldu...Dialogue: 0,0:04:44.52,0:04:45.61,Main,,0,0,0,,Kapı-Kapı.Dialogue: 0,0:04:51.20,0:04:54.42,Main,,0,0,0,,Kaybolurmuş gibi hareket ettiğiniz zaman,...Dialogue: 0,0:04:54.42,0:04:58.87,Main,,0,0,0,,...bir anda on seferden fazla yeri tekmelediğinizi gördüm.Dialogue: 0,0:04:59.35,0:05:00.92,Main,,0,0,0,,Numaranızı farkettim.Dialogue: 0,0:05:00.92,0:05:04.12,Main,,0,0,0,,Bunu nasıl yapacağımı bilmem gerekiyordu.Dialogue: 0,0:05:04.96,0:05:07.88,Main,,0,0,0,,Gomu Gomu No...Dialogue: 0,0:05:09.71,0:05:12.77,Thoughts,,0,0,0,,Bunu karşılayacağım... En güçlü Demir Parça'mla!Dialogue: 0,0:05:15.08,0:05:16.77,Main,,0,0,0,,Güçlü Demir Parça!Dialogue: 0,0:05:16.98,0:05:19.02,Main,,0,0,0,,...Jet Bazuka!Dialogue: 0,0:05:33.64,0:05:36.11,Main,,0,0,0,,Gerçekten dayanıklı birisin.Dialogue: 0,0:05:37.88,0:05:41.88,Main,,0,0,0,,Öyleyse sana çok daha ilginç bir şey göstereceğim.Dialogue: 0,0:05:41.88,0:05:44.05,Main,,0,0,0,,İyi izle!Dialogue: 0,0:05:46.56,0:05:47.58,Main,,0,0,0,,Vites...Dialogue: 0,0:06:02.88,0:06:05.11,Main,,0,0,0,,Fazlasıyla tükendim.Dialogue: 0,0:06:05.11,0:06:07.86,Main,,0,0,0,,Düşündüğüm gibi,  vücudum henüz bununla başa çıkamıyor.Dialogue: 0,0:06:09.79,0:06:12.99,Main,,0,0,0,,Neyse, şimdilik vücudumu önemsemiyorum.Dialogue: 0,0:06:14.60,0:06:17.31,Main,,0,0,0,,Bir sürü engelle yüzleştim.Dialogue: 0,0:06:17.08,0:06:17.10,Note,,0,0,0,,Adalet KapılarıDialogue: 0,0:06:17.10,0:06:17.11,Note,,0,0,0,,Adalet KapılarıDialogue: 0,0:06:17.11,0:06:17.13,Note,,0,0,0,,Adalet KapılarıDialogue: 0,0:06:17.13,0:06:17.15,Note,,0,0,0,,Adalet KapılarıDialogue: 0,0:06:17.15,0:06:17.16,Note,,0,0,0,,Adalet KapılarıDialogue: 0,0:06:17.16,0:06:17.18,Note,,0,0,0,,Adalet KapılarıDialogue: 0,0:06:17.18,0:06:17.20,Note,,0,0,0,,Adalet KapılarıDialogue: 0,0:06:17.20,0:06:17.21,Note,,0,0,0,,Adalet KapılarıDialogue: 0,0:06:17.21,0:06:17.23,Note,,0,0,0,,Adalet KapılarıDialogue: 0,0:06:17.23,0:06:17.25,Note,,0,0,0,,Adalet KapılarıDialogue: 0,0:06:17.25,0:06:17.26,Note,,0,0,0,,Adalet KapılarıDialogue: 0,0:06:17.26,0:06:17.28,Note,,0,0,0,,Adalet KapılarıDialogue: 0,0:06:17.28,0:06:17.30,Note,,0,0,0,,Adalet KapılarıDialogue: 0,0:06:17.30,0:06:17.31,Note,,0,0,0,,Adalet KapılarıDialogue: 0,0:06:17.31,0:06:17.33,Note,,0,0,0,,Adalet KapılarıDialogue: 0,0:06:17.33,0:06:17.35,Note,,0,0,0,,Adalet KapılarıDialogue: 0,0:06:17.35,0:06:17.36,Note,,0,0,0,,Adalet KapılarıDialogue: 0,0:06:17.36,0:06:17.38,Note,,0,0,0,,Adalet KapılarıDialogue: 0,0:06:17.38,0:06:17.40,Note,,0,0,0,,Adalet KapılarıDialogue: 0,0:06:17.40,0:06:17.41,Note,,0,0,0,,Adalet KapılarıDialogue: 0,0:06:17.41,0:06:17.43,Note,,0,0,0,,Adalet KapılarıDialogue: 0,0:06:17.43,0:06:17.45,Note,,0,0,0,,Adalet KapılarıDialogue: 0,0:06:17.45,0:06:17.48,Note,,0,0,0,,Adalet KapılarıDialogue: 0,0:06:17.48,0:06:17.50,Note,,0,0,0,,Adalet KapılarıDialogue: 0,0:06:17.50,0:06:17.51,Note,,0,0,0,,Adalet KapılarıDialogue: 0,0:06:17.51,0:06:17.53,Note,,0,0,0,,Adalet KapılarıDialogue: 0,0:06:17.53,0:06:17.55,Note,,0,0,0,,Adalet KapılarıDialogue: 0,0:06:17.55,0:06:17.56,Note,,0,0,0,,Adalet KapılarıDialogue: 0,0:06:17.56,0:06:1