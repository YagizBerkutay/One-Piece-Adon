.28,Main,,0,0,0,,Buna gerçekten inanamıyorum!Dialogue: 0,0:06:43.28,0:06:46.74,Main,,0,0,0,,Bu baş belası kapı bekçileri artık dostumuz!Dialogue: 0,0:06:47.91,0:06:50.41,Main,,0,0,0,,Savaşçı şansı diye buna denir!Dialogue: 0,0:06:50.41,0:06:54.64,Main,,0,0,0,,Pekâla yoldaşlar! Mahkeme Binası orada!Dialogue: 0,0:06:54.64,0:06:56.29,Main,,0,0,0,,Saldırın!Dialogue: 0,0:06:56.29,0:06:56.32,Note,,0,0,0,,Ana Ada Ön KapısıDialogue: 0,0:06:56.32,0:06:56.34,Note,,0,0,0,,Ana Ada Ön KapısıDialogue: 0,0:06:56.34,0:06:56.35,Note,,0,0,0,,Ana Ada Ön KapısıDialogue: 0,0:06:56.35,0:06:56.37,Note,,0,0,0,,Ana Ada Ön KapısıDialogue: 0,0:06:56.37,0:06:56.39,Note,,0,0,0,,Ana Ada Ön KapısıDialogue: 0,0:06:56.39,0:06:56.40,Note,,0,0,0,,Ana Ada Ön KapısıDialogue: 0,0:06:56.40,0:06:56.42,Note,,0,0,0,,Ana Ada Ön KapısıDialogue: 0,0:06:56.42,0:06:56.44,Note,,0,0,0,,Ana Ada Ön KapısıDialogue: 0,0:06:56.44,0:06:56.45,Note,,0,0,0,,Ana Ada Ön KapısıDialogue: 0,0:06:56.45,0:06:56.47,Note,,0,0,0,,Ana Ada Ön KapısıDialogue: 0,0:06:56.47,0:06:56.49,Note,,0,0,0,,Ana Ada Ön KapısıDialogue: 0,0:06:56.49,0:06:56.50,Note,,0,0,0,,Ana Ada Ön KapısıDialogue: 0,0:06:56.50,0:06:56.52,Note,,0,0,0,,Ana Ada Ön KapısıDialogue: 0,0:06:56.52,0:06:56.54,Note,,0,0,0,,Ana Ada Ön KapısıDialogue: 0,0:06:56.54,0:06:56.55,Note,,0,0,0,,Ana Ada Ön KapısıDialogue: 0,0:06:56.55,0:06:56.57,Note,,0,0,0,,Ana Ada Ön KapısıDialogue: 0,0:06:56.57,0:06:56.59,Note,,0,0,0,,Ana Ada Ön KapısıDialogue: 0,0:06:56.59,0:06:56.60,Note,,0,0,0,,Ana Ada Ön KapısıDialogue: 0,0:06:56.60,0:06:56.62,Note,,0,0,0,,Ana Ada Ön KapısıDialogue: 0,0:06:56.62,0:06:56.65,Note,,0,0,0,,Ana Ada Ön KapısıDialogue: 0,0:06:56.65,0:06:56.67,Note,,0,0,0,,Ana Ada Ön KapısıDialogue: 0,0:06:56.67,0:06:56.69,Note,,0,0,0,,Ana Ada Ön KapısıDialogue: 0,0:06:56.69,0:06:56.70,Note,,0,0,0,,Ana Ada Ön KapısıDialogue: 0,0:06:56.70,0:06:56.72,Note,,0,0,0,,Ana Ada Ön KapısıDialogue: 0,0:06:56.72,0:06:56.74,Note,,0,0,0,,Ana Ada Ön KapısıDialogue: 0,0:06:56.74,0:06:56.75,Note,,0,0,0