000000,&H00000000,0,0,0,0,100,100,0,0,1,0.8,0.8,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:01:50.05,0:02:00.05,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:20:10.00,0:20:20.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:31:03.40,0:31:06.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:01:50.05,0:01:53.38,Title,,0,0,250,,Şeytan Denen KızDialogue: 0,0:01:53.74,0:01:56.26,Main,,0,0,0,,Buraya gelmek için Aqua Laguna'yı geçtiler.Dialogue: 0,0:01:56.26,0:01:59.16,Main,,0,0,0,,Düşününce müthiş bir şey.Dialogue: 0,0:01:59.16,0:02:00.94,Main,,0,0,0,,Epey şanslı gibiler.Dialogue: 0,0:02:00.94,0:02:03.39,Main,,0,0,0,,Bu kez öldürme iznimiz var.Dialogue: 0,0:02:03.39,0:02:06.56,Main,,0,0,0,,Kendimizi tutmak zorunda kalmazsak, kolay olacak.Dialogue: 0,0:02:06.56,0:02:08.08,Main,,0,0,0,,Açılır köprü?Dialogue: 0,0:02:08.08,0:02:11.57,Main,,0,0,0,,Evet. Franky Ailesi, şu anda bunun için dövüşüyor.Dialogue: 0,0:02:11.57,0:02:16.22,Main,,0,0,0,,İndirirlerse, hemen karşıya geçebileceğiz.Dialogue: 0,0:02:16.22,0:02:19.74,Main,,0,0,0,,Gerçekten... tam da gözlerimizin önündeyken...Dialogue: 0,0:02:29.07,0:02:31.21,Main,,0,0,0,,Sen...Dialogue: 0,0:02:31.21,0:02:36.01,Thoughts,,0,0,0,,Bu kadın nasıl bir yük taşıyor böyle?Dialogue: 0,0:02:36.75,0:02:40.07,Main,,0,0,0,,Hey, CP9! Dinleyin!Dialogue: 0,0:02:40.07,0:02:44.02,Main,,0,0,0,,Size onları yok etme izni veriyorum ama Adalet Kulesi'nden saldırın!Dialogue: 0,0:02:45.14,0:02:48.97,Thoughts,,0,0,0,,En önemlisi benim hayatım ve terfim!Dialogue: 0,0:02:48.97,0:02:56.31,Thoughts,,0,0,0,,Bu korsanlar serbest kalır ve bir ihtimal bir şey olursa, beni kim koruyacak?Dialogue: 0,0:02:58.35,0:03:00.34,Main,,0,0,0,,Sizi aptapot* korsanlar!Dialogue: 0,0:03:00.34,0:03:06.26,Main,,0,0,0,,Elinizden geleni yapsanız bile,  sonuçta değiştirebileceğiniz bir şey yok!Dialogue: 0,0:03:06.26,0:03:10.85,Main,,0,0,0,,Bizde suikast grubu CP9'un gücü var.Dialogue: 0,0:03:10.85,0:03:15.99,Main,,0,0,0,,Sadece insan gücüyle açması imkansız olan  Adalet Kapıları var!Dialogue: 0,0:03:15.99,0:03:18.89,Main,,0,0,0,,En önemlisi, şu anda...Dialogue: 0,0:03:18.89,0:03:21.96,Main,,0,0,0,,...bu Altın Den Den Mushi'yi kullanma ve...Dialogue: 0,0:03:21.96,0:03:25.56,Main,,0,0,0,,...Yıkım Çağrısı'nı getirme yetkisine sahibim!Dialogue: 0,0:03:26.26,0:03:27.98,Main,,0,0,0,,Yıkım Çağrısı...Dialogue: 0,0:03:27.98,0:03:29.84,Main,,0,0,0,,Evet.Dialogue: 0,0:03:29.84,0:03:32.62,Main,,0,0,0,,Tam olarak 20 yıl önce,...Dialogue: 0,0:03:32.62,0:03:37.54,Main,,0,0,0,,...senin memleketini yok eden güç, Nico Robin.Dialogue: 0,0:03:37.54,0:03:42.91,Main,,0,0,0,,Ohara adı, ertesi sene çıkan haritadan silindi, değil mi?Dialogue: 0,0:03:42.91,0:03:45.00,Main,,0,0,0,,Robin'in memleketi?Dialogue: 0,0:03:45.00,0:03:47.50,Main,,0,0,0,,Kahrolası maske.Dialogue: 0,0:03:48.00,0:03:51.90,Flashbacks,,0,0,0,,Ev diyebileceğim bir yer veya gidebilecek bir yerim yok.Dialogue: 0,0:03:53.40,0:03:54.67,Main,,0,0,0,,Dur!Dialogue: 0,0:03:54.67,0:03:56.09,Main,,0,0,0,,O olmaz!Dialogue: 0,0:03:57.81,0:04:00.65,Main,,0,0,0,,İyi tepki. Beni ürpertiyor!Dialogue: 0,0:04:00.65,0:04:04.66,Main,,0,0,0,,Ne? Bu, Yıkım Çağrısı'nı başlatan düğmeye...Dialogue: 0,0:04:04.66,0:04:08.84,Main,,0,0,0,,...basmamı istediğin anlamına mı geliyor?Dialogue: 0,0:04:08.84,0:04:13.91,Main,,0,0,0,,O düğmeye bastığında ne olacağını gerçekten anlıyor musun?Dialogue: 0,0:04:13.91,0:04:20.84,Main,,0,0,0,,Sanırım anlıyorum. Korsanların  bu adayı terketme olasılığı sıfıra inecek!Dialogue: 0,0:04:20.84,0:04:23.29,Main,,0,0,0,,Bu düğmeye tek bir basışla.Dialogue: 0,0:04:23.29,0:04:25.30,Main,,0,0,0,,Gerçekten basit.Dialogue: 0,0:04:25.30,0:04:27.62,Main,,0,0,0,,O kadar kolay sona ermeyecek!Dialogue: 0,0:04:27.62,0:04:31.39,Main,,0,0,0,,Eski anıların mı canlandı?Dialogue: 0,0:04:31.39,0:04:34.82,Main,,0,0,0,,O zaman küçük br test için bassam mı?Dialogue: 0,0:04:34.82,0:04:37.01,Main,,0,0,0,,Şimdi, burada.Dialogue: 0,0:04:41.10,0:04:43.27,Main,,0,0,0,,NE YAPIYORSUN?! HEMEN KES ŞUNU!Dialogue: 0,0:04:45.67,0:04:48.83,Main,,0,0,0,,Bana çok bilmişlik taslamamalısın.Dialogue: 0,0:05:05.78,0:05:09.56,Main,,0,0,0,,Ohara'nın ertesi yıl haritadan silindiğini söylemiştin, değil mi?Dialogue: 0,0:05:09.56,0:05:13.10,Main,,0,0,0,,Bir haritaya bakarken insanları görebilir misin?Dialogue: 0,0:05:13.10,0:05:16.94,Main,,0,0,0,,Dünyaya böyle tepeden baktığınız için,...Dialogue: 0,0:05:16.94,0:05:20.31,Main,,0,0,0,,...böyle korkunç bir şey yapabiliyorsunuz!Dialogue: 0,0:05:29.30,0:05:33.99,Main,,0,0,0,,Yıkım Çağrısı, hedefini kendisi gözden kaybeden acımasız bir güçtür.Dialogue: 0,0:05:33.99,0:05:37.16,Main,,0,0,0,,Onu kullanamazsın.Dialogue: 0,0:05:37.16,0:05:40.08,Main,,0,0,0,,Asla....! Yapamazsın!Dialogue: 0,0:05:44.15,0:05:50.04,Captions,,0,0,0,,20 yıl önce – "Batı Mavi" OharaDialogue: 0,0:05:52.64,0:05:53.94,Main,,0,0,0,,Robin orada!Dialogue: 0,0:05:53.94,0:05:55.56,Main,,0,0,0,,Haklayalım onu!Dialogue: 0,0:05:54.79,0:05:58.26,Captions,,0,0,0,,Nico Robin 8 YaşındaDialogue: 0,0:05:57.26,0:05:58.26,Main,,0,0,0,,Ah!Dialogue: 0,0:05:58.81,0:06:00.75,Main,,0,0,0,,Başardık!Dialogue: 0,0:06:00.75,0:06:02.35,Main,,0,0,0,,Hey, Canavar!Dialogue: 0,0:06:02.35,0:06:04.70,Main,,0,0,0,,Çok ürkütücü!Dialogue: 0,0:06:04.70,0:06:10.14,Main,,0,0,0,,Canavar, canavar, canavar, canavar!Dialogue: 0,0:06:13.61,0:06:17.46,Main,,0,0,0,,Ahh! Canavarın saldırısına uğradım!Dialogue: 0,0:06:17.46,0:06:19.73,Main,,0,0,0,,Ürkütücü biri!Dialogue: 0,0:06:19.73,0:06:21.41,Main,,0,0,0,,Bunu unutmayacağız!Dialogue: 0,0:06:45.89,0:06:47.18,Main,,0,0,0,,Hey, sen!Dialogue: 0,0:06:50.68,0:06:55.44,Main,,0,0,0,,Çocuklarım ağlayarak eve geldiler, onlara sebepsiz yere vurduğunu söylüyorlar.Dialogue: 0,0:06:55.44,0:06:58.22,Main,,0,0,0,,Artık çocuklarıma yaklaşma!Dialogue: 0,0:06:58.22,0:07:00.44,Main,,0,0,0,,Bir şey söyleyemez misin?!Dialogue: 0,0:07:00.44,0:07:04.54,Main,,0,0,0,,Üfff... Gerçekten iğrenç bir kızsın.Dialogue: 0,0:07:06.26,0:07:08.05,Main,,0,0,0,,Dur bakalım!Dialogue: 0,0:07:08.05,0:07:10.01,Main,,0,0,0,,Konuşmamız daha bitmedi!Dialogue: 0,0:07:17.77,0:07:21.44,Main,,0,0,0,,Anne, Anne! Bu akşam yemekte ne var?Dialogue: 0,0:07:21.44,0:07:22.65,Main,,0,0,0,,Ne yemek istersin?Dialogue: 0,0:07:22.65,0:07:24.76,Main,,0,0,0,,Ben, ben...Dialogue: 0,0:07:24.76,0:07:26.32,Main,,0,0,0,,...ev pirinci istiyorum!Dialogue: 0,0:07:27.27,0:07:29.35,Main,,0,0,0,,Ev pirincini gerçekten seviyorsun!Dialogue: 0,0:07:29.35,0:07:32.79,Main,,0,0,0,,– Evet! – O zaman çok yapmalıyım.Dialogue: 0,0:07:32.79,0:07:34.11,Main,,0,0,0,,Yaşasın!Dialogue: 0,0:07:42.72,0:07:46.59,Main,,0,0,0,,Ben geldim. Geciktiğim için üzgünüm.Dialogue: 0,0:07:47.52,0:07:48.84,Main,,0,0,0,,Roji teyze?Dialogue: 0,0:07:59.57,0:08:01.96,Thoughts,,0,0,0,,"Robin'e. Bugün..."Dialogue: 0,0:08:01.96,0:08:04.07,Thoughts,,0,0,0,,...kızımızın doğum günü.Dialogue: 0,0:08:04.07,0:08:09.08,Thoughts,,0,0,0,,Bu yüzden üçümüzün bir aile olarak  akşam yemeğine çıkmasına karar verdik.Dialogue: 0,0:08:09.08,0:08:13.19,Thoughts,,0,0,0,,Sana bir ekmek bıraktık, güzelce ye.Dialogue: 0,0:08:14.12,0:08:17.11,Thoughts,,0,0,0,,Fazla reçel kullanma.Dialogue: 0,0:08:17.11,0:08:23.43,Thoughts,,0,0,0,,Yemeğini bitirince, biz eve gelmeden tabakları yıka, evi temizle,...Dialogue: 0,0:08:23.43,0:08:28.49,Thoughts,,0,0,0,,...çamaşırları içeri al ve çok geç olmadan yukarı çık.Dialogue: 0,0:08:35.90,0:08:38.61,Flashbacks,,0,0,0,,Anne, Anne! Akşam yemeğinde ne var?Dialogue: 0,0:08:38.61,0:08:40.62,Flashbacks,,0,0,0,,Ne yemek istersin?Dialogue: 0,0:08:40.62,0:08:42.98,Flashbacks,,0,0,0,,Ben, ben...Dialogue: 0,0:08:42.98,0:08:44.86,Flashbacks,,0,0,0,,...ev pirinci istiyorum!Dialogue: 0,0:08:45.56,0:08:47.58,Flashbacks,,0,0,0,,Ev pirincini gerçekten seviyorsun!Dialogue: 0,0:08:47.58,0:08:50.68,Flashbacks,,0,0,0,,– Evet! – O zaman çok yapmalıyım!Dialogue: 0,0:08:50.68,0:08:51.87,Flashbacks,,0,0,0,,Yaşasın!Dialogue: 0,0:09:06.13,0:09:12.06,Captions,,0,0,0,,Bilgi Ağacı Ohara Kütüphanesi ve Arkeolojik Araştırma MerkeziDialogue: 0,0:09:12.06,0:09:15.14,Main,,0,0,0,,Geliyor. Bu, Robin.Dialogue: 0,0:09:15.14,0:09:16.91,Main,,0,0,0,,Kitabı geri vermeye geliyormuş gibi.Dialogue: 0,0:09:16.91,0:09:18.98,Main,,0,0,0,,Herkes yerine geçsin!Dialogue: 0,0:09:23.56,0:09:27.99,Main,,0,0,0,,İyi akşamlar. Profesör Clover, kitabı geri vermeye geldim.Dialogue: 0,0:09:31.94,0:09:33.83,Main,,0,0,0,,Bir, iki...!Dialogue: 0,0:09:33.83,0:09:37.55,Main,,0,0,0,,Robin, tebrikler!Dialogue: 0,0:09:33.91,0:09:37.55,Captions,,0,0,0,,Ohara ArkeologlarıDialogue: 0,0:09:37.55,0:09:40.64,Main,,0,0,0,,– Müthişsin, Robin! – Bir dahiden de bu beklenir!Dialogue: 0,0:09:40.64,0:09:42.94,Main,,0,0,0,,Kekimiz var! Kek!Dialogue: 0,0:09:42.94,0:09:46.63,Main,,0,0,0,,Robin, geçen gün girdiğin doktora seviyesindeki arkeoloji testinden...Dialogue: 0,0:09:46.63,0:09:48.57,Main,,0,0,0,,...tam not aldın!Dialogue: 0,0:09:48.57,0:09:52.66,Main,,0,0,0,,Bugünden itibaren,  nihayet arkeolog olarak tanınacaksın!Dialogue: 0,0:09:52.66,0:09:58.32,Main,,0,0,0,,Bugünden itibaren, bizimle birlikte araştırma yapacak arkadaşlarımızdan birisin.Dialogue: 0,0:09:58.92,0:10:03.32,Main,,0,0,0,,İşte bilgin olduğunun kanıtı. Al bakalım, Robin.Dialogue: 0,0:10:03.32,0:10:05.27,Main,,0,0,0,,Adına çok sevindim, Robin.Dialogue: 0,0:10:05.27,0:10:06.85,Main,,0,0,0,,Tebrikler!Dialogue: 0,0:10:08.50,0:10:13.70,Main,,0,0,0,,Pekâla, Robin. Arkeolog olmanın ne demek olduğunu iyi bilmelisin!Dialogue: 0,0:10:08.55,0:10:13.70,Captions,,0,0,0,,Profesör Clover Ohara Kütüphanesi'nin Müdürü (Arkeoloji Uzmanı)Dialogue: 0,0:10:13.70,0:10:16.20,Main,,0,0,0,,Tamam, Profesör Clover.Dialogue: 0,0:10:16.20,0:10:20.42,Main,,0,0,0,,Bilgi, geçmişi adlandırmaktır.Dialogue: 0,0:10:20.43,0:10:25.38,Main,,0,0,0,,Bu Bilgi Ağacı 5000 yaşında.Dialogue: 0,0:10:25.38,0:10:27.64,Main,,0,0,0,,Yüzyıllar boyunca insanlar...Dialogue: 0,0:10:27.64,0:10:30.44,Main,,0,0,0,,...dünyanın dört bir yanından  bu ağaca çok miktarda kitap getirdiler.Dialogue: 0,0:10:30.44,0:10:35.57,Main,,0,0,0,,Tüm insanlık için yeri doldurulamaz bir hazinedir.Dialogue: 0,0:10:35.57,0:10:39.86,Main,,0,0,0,,Burası, içerdiği bilginin gururunu taşıyan, dünyanın en büyük ve en geniş kütüphanesi!Dialogue: 0,0:10:39.86,0:10:42.92,Main,,0,0,0,,Bilgi Ağacı'nın altında toplananlar,...Dialogue: 0,0:10:42.92,0:10:45.67,Main,,0,0,0,,...denizlerin ötesinden gelen seçkin arkeologlardır.Dialogue: 0,0:10:45.67,0:10:49.22,Main,,0,0,0,,Bu belgeleri kullandığımızdan,...Dialogue: 0,0:10:49.22,0:10:52.76,Main,,0,0,0,,...bizim için çözülemeyecek tarihsel bir gizem yok!Dialogue: 0,0:10:53.26,0:10:54.97,Main,,0,0,0,,Anlıyor musun, Robin?Dialogue: 0,0:10:54.97,0:10:56.71,Main,,0,0,0,,Evet.Dialogue: 0,0:10:56.71,0:11:03.24,Main,,0,0,0,,Farklı kültürleri araştırarak dünyaya katkıda bulunduğunu görmek isterim.Dialogue: 0,0:11:03.24,0:11:08.06,Main,,0,0,0,,Profesör, Boş Tarih'in sırrını çözmek istiyorum!Dialogue: 0,0:11:08.06,0:11:12.86,Main,,0,0,0,,Ne... Yapamazsın, yapamazsın! Bu her zaman yasak olmuştur!Dialogue: 0,0:11:12.86,0:11:16.67,Main,,0,0,0,,Ne? Niye? Poneglifleri çalışırsak,...Dialogue: 0,0:11:16.67,0:11:19.70,Main,,0,0,0,,...Boş Yüzyıl'da neler olduğunu bileceğiz, değil mi?Dialogue: 0,0:11:21.20,0:11:23.40,Main,,0,0,0,,Bu kadarını nereden biliyorsun?Dialogue: 0,0:11:23.40,0:11:26.96,Main,,0,0,0,,Yine bodrum katındayken bizi gözetlemek için yeteneğini kullandın, değil mi?Dialogue: 0,0:11:26.96,0:11:28.16,Main,,0,0,0,,Ama...Dialogue: 0,0:11:28.16,0:11:33.13,Main,,0,0,0,,Poneglifleri deşifre etmek amacıyla yapılan her şey büyük bir suç olarak görülür!Dialogue: 0,0:11:35.21,0:11:36.68,Main,,0,0,0,,Ama...Dialogue: 0,0:11:36.68,0:11:38.77,Main,,0,0,0,,...gece geç vakitte herkes bodrum katında toplanıp...Dialogue: 0,0:11:38.77,0:11:41.56,Main,,0,0,0,,...Poneglifler üstünde araştırma yapmıyor mu?Dialogue: 0,0:11:41.56,0:11:45.23,Main,,0,0,0,,Robin! Bunu nereden biliyorsun?Dialogue: 0,0:11:45.63,0:11:49.90,Main,,0,0,0,,Ne demek oluyor bu?  Tüm bunları da mı gözetlediğini söylüyorsun?Dialogue: 0,0:11:49.90,0:11:53.13,Main,,0,0,0,,Cevap ver, Robin!Dialogue: 0,0:11:53.13,0:11:55.52,Main,,0,0,0,,Ama...Dialogue: 0,0:11:55.52,0:12:00.02,Main,,0,0,0,,...rica etseydim bile girmeme izin vermezdiniz!Dialogue: 0,0:12:00.50,0:12:08.25,Main,,0,0,0,,Bu yüzden... arkeolog olursam  araştırmanızın bir parçası olmama izin verirsiniz.Dialogue: 0,0:12:08.25,0:12:10.90,Main,,0,0,0,,Bu yüzden çok çalıştım!Dialogue: 0,0:12:12.69,0:12:14.14,Main,,0,0,0,,Robin...Dialogue: 0,0:12:16.55,0:12:22.85,Main,,0,0,0,,Gerçekten arkelog denmeyi  hak edecek kadar çok bilgi edindin!Dialogue: 0,0:12:22.85,0:12:25.93,Main,,0,0,0,,Ama yine de bir çocuksun.Dialogue: 0,0:12:25.93,0:12:29.37,Main,,0,0,0,,Bizimle birlikte çalışırken yakalanırsan,  boynunu vururlar.Dialogue: 0,0:12:29.37,0:12:32.57,Main,,0,0,0,,Bu, tamamen hazırlanarak yaptığımız bir şey.Dialogue: 0,0:12:32.57,0:12:36.70,Main,,0,0,0,,800 yıl önce bu, dünyanın kanunu olduğundan beri,...Dialogue: 0,0:12:36.70,0:12:41.37,Main,,0,0,0,,...gerçeği ortaya çıkarmaya çalışırken  canından olan bir sürü bilim adamı oldu.Dialogue: 0,0:12:41.37,0:12:44.54,Main,,0,0,0,,Bu iyi bir fırsat, sana bundan bahsedeceğim.Dialogue: 0,0:12:44.54,0:12:48.55,Main,,0,0,0,,Antik, tarihsel yazıtları deşifre edebilenler...Dialogue: 0,0:12:48.55,0:12:51.76,Main,,0,0,0,,...sadece Ohara'da vardır.Dialogue: 0,0:12:51.76,0:12:55.21,Main,,0,0,0,,Artık geri dönemeyiz.Dialogue: 0,0:12:55.21,0:12:57.52,Main,,0,0,0,,Bilen Ağaç'ın üstüne yemin et!Dialogue: 0,0:12:57.52,0:12:59.95,Main,,0,0,0,,Bir dahaki sefere bodrum katına yaklaştığında,...Dialogue: 0,0:12:59.95,0:13:05.98,Main,,0,0,0,,...araştırma merkezine ve kütüphaneye girmeni yasaklayacağız! Anladın mı?Dialogue: 0,0:13:09.76,0:13:10.86,Main,,0,0,0,,Robin!Dialogue: 0,0:13:11.56,0:13:15.06,Main,,0,0,0,,Tamamiyle annesinin izinden gidiyor.Dialogue: 0,0:13:15.06,0:13:19.07,Main,,0,0,0,,Henüz birkaç gün önce olan olayı bilmiyor.Dialogue: 0,0:13:19.97,0:13:24.04,Main,,0,0,0,,Robin'in annesi Olvia, çoktan yakalandı.Dialogue: 0,0:13:24.04,0:13:27.37,Main,,0,0,0,,Kaderinin ne olacağını zaten bilebiliriz.Dialogue: 0,0:13:28.98,0:13:31.82,Captions,,0,0,0,,Ertesi GünDialogue: 0,0:14:16.94,0:14:19.70,Main,,0,0,0,,S... Su...Dialogue: 0,0:14:21.94,0:14:23.50,Main,,0,0,0,,Yer solucanı?Dialogue: 0,0:14:21.94,0:14:23.50,Note,,0,0,0,,Mizu: Su, Mimizu: Yer SolucanıDialogue: 0,0:14:31.98,0:14:34.53,Main,,0,0,0,,Çok leziz!Dialogue: 0,0:14:38.55,0:14:42.89,Captions,,0,0,0,,Saul (Dev) KazazedeDialogue: 0,0:14:42.16,0:14:45.47,Main,,0,0,0,,Bu, hayatımı kurtardı. Dialogue: 0,0:14:45.47,0:14:48.95,Main,,0,0,0,,Acaba o kişi de güvende mi?Dialogue: 0,0:14:50.93,0:14:54.73,Main,,0,0,0,,Neyse, beni kurtardın. Sağol.Dialogue: 0,0:14:54.73,0:14:57.65,Main,,0,0,0,,Buralarda bir şehir olmalı.Dialogue: 0,0:14:59.32,0:15:00.91,Main,,0,0,0,,Anlıyorum.Dialogue: 0,0:15:02.48,0:15:07.68,Main,,0,0,0,,Aslında terkedilmiş bir adaya falan sürüklenmek istemiştim.Dialogue: 0,0:15:14.99,0:15:18.86,Main,,0,0,0,,Orada dursan bile hiçbir şey olmayacak.Dialogue: 0,0:15:18.86,0:15:24.53,Main,,0,0,0,,Bacağımı yaraladım. Yani buradan bir yere gitmeyeceğim.Dialogue: 0,0:15:24.53,0:15:29.95,Main,,0,0,0,,Fırsatım varken buradan gidebilmek için  sal falan yapmayı planlıyorum.Dialogue: 0,0:15:30.87,0:15:33.82,Main,,0,0,0,,İlk kez mi dev görüyorsun?Dialogue: 0,0:15:34.91,0:15:40.75,Main,,0,0,0,,Seni uyarayım. Beni, Elbaf'tan gelme o barbar devler gibi yargılama.Dialogue: 0,0:15:40.75,0:15:45.08,Main,,0,0,0,,Sakin dev kabileleri de vardır.Dialogue: 0,0:15:45.08,0:15:46.97,Main,,0,0,0,,Anlıyorum...Dialogue: 0,0:15:47.67,0:15:50.97,Main,,0,0,0,,Sanden imkansız bir şey istemeyi deneyeceğim ama...Dialogue: 0,0:15:50.97,0:15:56.89,Main,,0,0,0,,...eve döndüğünde  benden kimseye bahsetmemeni istiyorum.Dialogue: 0,0:15:56.89,0:15:58.56,Main,,0,0,0,,Tamam.Dialogue: 0,0:15:59.46,0:16:03.15,Main,,0,0,0,,Cevabın çok hızlı oldu. Bu kesinlikle imkansız.Dialogue: 0,0:16:03.65,0:16:05.07,Main,,0,0,0,,Söylemeyeceğim.Dialogue: 0,0:16:09.26,0:16:14.25,Main,,0,0,0,,Yalan. Bir çocuğun sır saklaması mümkün değil!Dialogue: 0,0:16:14.25,0:16:18.28,Main,,0,0,0,,Ama sen ilgimi çekmiyorsun.Dialogue: 0,0:16:34.81,0:16:36.47,Main,,0,0,0,,Dereshi?Dialogue: 0,0:16:36.47,0:16:37.77,Main,,0,0,0,,Ne demek o?Dialogue: 0,0:16:38.27,0:16:41.63,Main,,0,0,0,,Neden bahsediyorsun? Gülüyorum!Dialogue: 0,0:16:43.74,0:16:45.44,Main,,0,0,0,,Gülüyor musun?Dialogue: 0,0:16:45.44,0:16:48.25,Main,,0,0,0,,İlginç birisin!Dialogue: 0,0:16:52.49,0:16:54.98,Main,,0,0,0,,Tuhaf bir gülüş şekli.Dialogue: 0,0:16:57.29,0:17:02.35,Main,,0,0,0,,Çok eskiden beri  gülüşümün tuhaf olduğunu söylerler.Dialogue: 0,0:17:02.35,0:17:05.43,Main,,0,0,0,,Gülünce çok sevimli oluyorsun.Dialogue: 0,0:17:05.43,0:17:08.33,Main,,0,0,0,,– Ne? – Daha çok gülmelisin!Dialogue: 0,0:17:10.35,0:17:15.81,Main,,0,0,0,,Adım Saul. Jaguar D. Saul.Dialogue: 0,0:17:16.41,0:17:17.81,Main,,0,0,0,,D?Dialogue: 0,0:17:17.81,0:17:24.86,Main,,0,0,0,,Evet. Bu konuda pek bir şey bilmiyorum. Sülalemin hepsinde vardır.Dialogue: 0,0:17:24.86,0:17:26.28,Main,,0,0,0,,Senin adın ne?Dialogue: 0,0:17:26.28,0:17:27.55,Main,,0,0,0,,Robin.Dialogue: 0,0:17:27.55,0:17:33.22,Main,,0,0,0,,Anlıyorum. Robin, aslında şu anda  bazı adamlar tarafından kovalanıyorum.Dialogue: 0,0:17:33.22,0:17:35.90,Main,,0,0,0,,Bu yüzden biri beni bulursa, başım büyük derde girecek.Dialogue: 0,0:17:35.90,0:17:37.07,Main,,0,0,0,,Kimseye söylemem.Dialogue: 0,0:17:39.33,0:17:42.72,Captions,,0,0,0,,Devin Kıyıya Sürüklenişinden Sonraki 3. GünDialogue: 0,0:17:48.80,0:17:50.47,Main,,0,0,0,,Çok leziz!Dialogue: 0,0:17:50.47,0:17:51.83,Main,,0,0,0,,İşte bir tane daha.Dialogue: 0,0:17:54.56,0:17:58.80,Main,,0,0,0,,Sadece niyetin bile beni mutlu ediyor.  Kalanını sen ye.Dialogue: 0,0:17:58.80,0:18:05.36,Main,,0,0,0,,Artık doydum.  Birkaç balık yakaladım ve dün gece yedim.Dialogue: 0,0:18:07.16,0:18:12.58,Main,,0,0,0,,Pekâla, neredeyse tamamlandı. Sal yapmaya devam edeceğim!Dialogue: 0,0:18:17.30,0:18:21.20,Main,,0,0,0,,Her halükarda, bol bol vaktin var, değil mi?Dialogue: 0,0:18:21.20,0:18:25.24,Main,,0,0,0,,Bütün gün bana eşlik etmek için buraya geliyorsun.Dialogue: 0,0:18:25.24,0:18:27.81,Main,,0,0,0,,Arkadaşların ve ailen şüphelenebilir.Dialogue: 0,0:18:29.43,0:18:31.44,Main,,0,0,0,,Ailem yok.Dialogue: 0,0:18:31.44,0:18:33.29,Main,,0,0,0,,Bir annem var ama...Dialogue: 0,0:18:33.29,0:18:36.32,Main,,0,0,0,,...küçüklüğümden beri işi dolayısıyla denizlerde dolaşıyor.Dialogue: 0,0:18:36.32,0:18:37.95,Main,,0,0,0,,Yüzünü bile hatırlamıyorum.Dialogue: 0,0:18:39.33,0:18:43.51,Main,,0,0,0,,Arkeologların her birini seviyorum ama araştırmalarına katılmama...Dialogue: 0,0:18:43.51,0:18:45.45,Main,,0,0,0,,...izin vermedikleri için dışarı atıldım.Dialogue: 0,0:18:45.45,0:18:50.58,Main,,0,0,0,,Şehirdeki çocuklar ise ürkütücü olduğumu söylüyorlar ve benimle oynamıyorlar.Dialogue: 0,0:18:53.12,0:18:56.34,Main,,0,0,0,,Demek Şeytan Meyvesi kullanıcısısın.Dialogue: 0,0:18:57.25,0:18:58.71,Main,,0,0,0,,Korkmuyor musun?Dialogue: 0,0:18:58.71,0:19:01.90,Main,,0,0,0,,Bir keresinde Grand Line'a yelken açtım.Dialogue: 0,0:19:01.90,0:19:05.01,Main,,0,0,0,,Orada bir sürü müthiş Şeytan Meyvesi kullanıcısı gördüm.Dialogue: 0,0:19:05.80,0:19:07.36,Main,,0,0,0,,Anlıyorum...Dialogue: 0,0:19:07.36,0:19:09.02,Main,,0,0,0,,Kıskandım!Dialogue: 0,0:19:09.02,0:19:11.05,Main,,0,0,0,,İşe yarar görünüyor!Dialogue: 0,0:19:18.64,0:19:20.36,Main,,0,0,0,,Gerçekten tuhaf bir gülüş şekli.Dialogue: 0,0:19:21.93,0:19:24.12,Main,,0,0,0,,Tuhaf olsun veya olmasın.Dialogue: 0,0:19:24.12,0:19:25.73,Main,,0,0,0,,Biliyor musun?Dialogue: 0,0:19:25.73,0:19:29.16,Main,,0,0,0,,Gülünce mutlu olabilirsin.Dialogue: 0,0:19:29.57,0:19:31.00,Main,,0,0,0,,Neden?Dialogue: 0,0:19:31.00,0:19:34.88,Main,,0,0,0,,Neden olduğunu mu soruyorsun? Mutluyken gülersin!Dialogue: 0,0:19:34.88,0:19:39.63,Main,,0,0,0,,Yani gülersen mutlu olabileceğin anlamına gelir!Dialogue: 0,0:19:39.63,0:19:43.61,Main,,0,0,0,,Çok küçük olsan da, fazlasıyla acı çekiyor gibisin.Dialogue: 0,0:19:43.61,0:19:47.76,Main,,0,0,0,,Sadece gülmen gerek!  Üzgün olduğunda sadece gül!Dialogue: 0,0:19:47.76,0:19:50.64,Main,,0,0,0,,Acı çekerken gülersem, aptal gibi görünürüm.Dialogue: 0,0:19:50.64,0:19:52.62,Main,,0,0,0,,Hiç de bile!Dialogue: 0,0:19:53.62,0:19:57.77,Main,,0,0,0,,Bak, kendin de deneyebilirsin!Dialogue: 0,0:20:02.77,0:20:04.46,Main,,0,0,0,,Deresh!Dialogue: 0,0:20:04.46,0:20:08.54,Main,,0,0,0,,Evet, evet! Aynen öyle!Dialogue: 0,0:20:16.39,0:20:18.27,Main,,0,0,0,,İyisin, iyisin!Dialogue: 0,0:20:23.34,0:20:25.28,Main,,0,0,0,,Burası Denizci Karargâhı.Dialogue: 0,0:20:25.28,0:20:27.98,Main,,0,0,0,,Şef Spandine, cevap bekliyorum.Dialogue: 0,0:20:27.98,0:20:30.19,Main,,0,0,0,,Seni istiyorlar, Şef.Dialogue: 0,0:20:30.19,0:20:33.40,Main,,0,0,0,,Yapacak bir şey yok. Durumumuzu kontrol etmek için olmalı.Dialogue: 0,0:20:33.40,0:20:36.94,Main,,0,0,0,,Kıyı boyunu gördüğümüzde,  onlarla kendimiz bağlantı kuracağız demiştim.Dialogue: 0,0:20:36.99,0:20:41.94,Captions,,0,0,0,,Spandine – CP9 Şefi (20 yıl önce)Dialogue: 0,0:20:36.94,0:20:39.92,Main,,0,0,0,,Ohara veya Opera olması umrumda değil...Dialogue: 0,0:20:39.92,0:20:44.22,Main,,0,0,0,,...ama niye Batı Mavi'ye kadar gitmek zorundayım?Dialogue: 0,0:20:44.22,0:20:45.91,Main,,0,0,0,,Cidden...Dialogue: 0,0:20:45.91,0:20:48.62,Main,,0,0,0,,...zamanımı ayırmaya bile değmeyecek bir iş.Dialogue: 0,0:20:49.69,0:20:54.44,Captions,,0,0,0,,Ertesi Gün, Devin Kıyıya Sürüklenişinden Sonraki 4. GünDialogue: 0,0:21:08.77,0:21:11.50,Main,,0,0,0,,Hey, bir Denizci gemisinin buraya demirlediği doğru mu?Dialogue: 0,0:21:11.50,0:21:13.31,Main,,0,0,0,,Eh, Denizci gemisi mi?Dialogue: 0,0:21:13.31,0:21:15.83,Main,,0,0,0,,Evet, şafak vakti oraya demirlediğini duydum.Dialogue: 0,0:21:15.83,0:21:17.87,Main,,0,0,0,,Niye Denizciler,...Dialogue: 0,0:21:17.87,0:21:19.65,Main,,0,0,0,,...tekrar böyle ücra bir adaya gelsin?Dialogue: 0,0:21:19.65,0:21:23.25,Main,,0,0,0,,Ama ortalıkta hiç Denizci görünmüyordu.Dialogue: 0,0:21:23.25,0:21:24.62,Main,,0,0,0,,O da ne?Dialogue: 0,0:21:24.62,0:21:28.27,Main,,0,0,0,,Sanki içinde kimse olmayan hayalet bir gemi gibi.Dialogue: 0,0:21:28.27,0:21:30.38,Main,,0,0,0,,Böyle bir şey olamaz.Dialogue: 0,0:21:30.98,0:21:34.33,Main,,0,0,0,,– Profesör! – Profesör Clover!Dialogue: 0,0:21:36.64,0:21:38.39,Main,,0,0,0,,Bir şey mi oldu?Dialogue: 0,0:21:38.39,0:21:43.64,Main,,0,0,0,,Doğru olacağını sanmıyorum ama kıyıya bir Denizci gemisi demirledi!Dialogue: 0,0:21:43.64,0:21:48.15,Main,,0,0,0,,Soruşturma olabilir. Önlemimizi almalıyız.Dialogue: 0,0:21:48.15,0:21:50.16,Main,,0,0,0,,Bilginleri bu konuda haberdar edin.Dialogue: 0,0:21:53.30,0:21:55.94,Main,,0,0,0,,Salım tamamlandı!Dialogue: 0,0:22:01.44,0:22:03.09,Main,,0,0,0,,Öyleyse gidiyor musun?Dialogue: 0,0:22:03.09,0:22:05.14,Main,,0,0,0,,O da ne?Dialogue: 0,0:22:05.14,0:22:09.40,Main,,0,0,0,,Yüzünün her yerinde "Yalnızım" yazıyor.Dialogue: 0,0:22:09.40,0:22:13.48,Main,,0,0,0,,Sahi! Bir bayrak falan eklemeyi düşünmüştüm.Dialogue: 0,0:22:13.48,0:22:15.96,Main,,0,0,0,,Biraz daha burada kalmalıyım.Dialogue: 0,0:22:23.00,0:22:27.30,Main,,0,0,0,,Denize...  Robin sen de denize açılmak istiyor musun?Dialogue: 0,0:22:27.30,0:22:28.30,Main,,0,0,0,,Evet.Dialogue: 0,0:22:28.90,0:22:33.27,Main,,0,0,0,,Annem her zaman arkeolojik araştırmayla meşgul.Dialogue: 0,0:22:33.27,0:22:36.61,Main,,0,0,0,,Ama bir gün tekrar bu adaya gelecek.Dialogue: 0,0:22:36.61,0:22:39.56,Main,,0,0,0,,Bir dahakine beni de yanında götürmesini isteyeceğim.Dialogue: 0,0:22:39.56,0:22:44.04,Main,,0,0,0,,Bunun için çok çalıştım ve arkeolog oldum.Dialogue: 0,0:22:44.04,0:22:48.41,Main,,0,0,0,,Arkeolog? Bu kadar küçük olmana rağmen mi?Dialogue: 0,0:22:49.74,0:22:55.88,Main,,0,0,0,,Ama annenin yüzünü bile hatırlamıyorsun?Dialogue: 0,0:22:55.88,0:22:58.66,Main,,0,0,0,,Doğru... ama o benim annem.Dialogue: 0,0:22:59.75,0:23:01.64,Main,,0,0,0,,Onu görmek istiyorum.Dialogue: 0,0:23:03.84,0:23:05.59,Main,,0,0,0,,Biliyor musun, Saul...Dialogue: 0,0:23:05.59,0:23:10.59,Main,,0,0,0,,Tarihin hiç kimse tarafından bilinmeyen boş bir yüzyılı var.Dialogue: 0,0:23:10.59,0:23:14.45,Main,,0,0,0,,Evet, Boş Yüzyıl.Dialogue: 0,0:23:14.45,0:23:19.35,Main,,0,0,0,,Ben de ilgileniyorum ama  Hükümet bu konudaki tüm araştırmaları yasaklıyor.Dialogue: 0,0:23:19.35,0:23:24.36,Main,,0,0,0,,Evet. Annem, bu konuda çalışmak için tüm dünyayı dolaşıyor.Dialogue: 0,0:23:24.36,0:23:28.83,Main,,0,0,0,,Ama hiç kimseye bundan bahsetmemelisin. Sonuçta bu bir suç.Dialogue: 0,0:23:28.83,0:23:29.70,Main,,0,0,0,,Ne?!Dialogue: 0,0:23:29.70,0:23:35.59,Main,,0,0,0,,Y-Yani Poneglif denilen taşları mı arıyor?Dialogue: 0,0:23:36.29,0:23:38.21,Main,,0,0,0,,Poneglifleri biliyor musun?Dialogue: 0,0:23:38.21,0:23:44.48,Main,,0,0,0,,Tabii ki biliyorum! Ama bunun hakkında  insanların önünde konuşma, tamam mı?!Dialogue: 0,0:23:44.48,0:23:48.87,Main,,0,0,0,,Annenin bir şey aramak için  seyahat etmesinden bahsetmiyorum bile...Dialogue: 0,0:23:50.66,0:23:52.02,Main,,0,0,0,,Ne oldu?Dialogue: 0,0:23:52.02,0:23:56.44,Main,,0,0,0,,Robin, annenin adını biliyor musun?Dialogue: 0,0:23:56.90,0:23:57.94,Main,,0,0,0,,Olvia.Dialogue: 0,0:23:59.78,0:24:01.80,Main,,0,0,0,,Nico Olvia deniyor.Dialogue: 0,0:24:08.97,0:24:10.34,Main,,0,0,0,,Saul?!Dialogue: 0,0:24:10.34,0:24:14.26,Thoughts,,0,0,0,,Robin, Olvia'nın kızı.Dialogue: 0,0:24:14.26,0:24:19.73,Main,,0,0,0,,O zaman burası, Ohara denilen ada mı?!Dialogue: 0,0:24:19.73,0:24:24.29,Main,,0,0,0,,– Evet. – Ahh! Korkunç! Bu nasıl olabilir?!Dialogue: 0,0:24:24.29,0:24:27.91,Main,,0,0,0,,Ohara'ya kadar sürüklendim mi?!Dialogue: 0,0:24:28.92,0:24:31.03,Main,,0,0,0,,Şimdi bunun sırası değil!Dialogue: 0,0:24:31.03,0:24:32.81,Main,,0,0,0,,– Robin! – Ne?Dialogue: 0,0:24:32.81,0:24:36.91,Main,,0,0,0,,Seni şaşırtabilir ama hikayemi iyi dinle.Dialogue: 0,0:24:36.91,0:24:41.50,Main,,0,0,0,,Biz konuşurken, Denizci savaş gemileri Ohara'ya doğru geliyor olabilir!Dialogue: 0,0:24:41.50,0:24:43.18,Main,,0,0,0,,Denizciler... Niye?Dialogue: 0,0:24:43.18,0:24:46.54,Main,,0,0,0,,Bu adadaki tüm bilginleri yok etmek için!Dialogue: 0,0:24:47.94,0:24:49.60,Main,,0,0,0,,Yok etmek için?Dialogue: 0,0:24:50.49,0:24:52.99,Main,,0,0,0,,Hükümet adamlarının...Dialogue: 0,0:24:52.99,0:24:56.10,Main,,0,0,0,,– Bu bir yalan. – ...senin arkeolog olduğunu...Dialogue: 0,0:24:56.10,0:24:58.38,Main,,0,0,0,,– Bu bir yalan...! – ...bilmelerine izin vermemelisin!Dialogue: 0,0:24:58.38,0:25:00.09,Main,,0,0,0,,Bütün bunlar yalan!Dialogue: 0,0:25:00.09,0:25:03.56,Main,,0,0,0,,Doğru! Sana yalan söylemem!Dialogue: 0,0:25:03.56,0:25:06.77,Main,,0,0,0,,Hemen şehre gitmeli ve ters giden bir şeyler olup olmadığına bakmalısın!Dialogue: 0,0:25:06.77,0:25:10.18,Main,,0,0,0,,Annen de dönmüş olabilir!Dialogue: 0,0:25:18.42,0:25:21.46,Captions,,0,0,0,,Nico Olvia ArkeologDialogue: 0,0:25:18.68,0:25:21.46,Main,,0,0,0,,Epey zaman oldu çocuklar.Dialogue: 0,0:25:21.46,0:25:23.55,Main,,0,0,0,,– Olvia... – Olvia-san...!Dialogue: 0,0:25:23.55,0:25:25.75,Main,,0,0,0,,Yani o Denizci gemisindeki sen miydin?Dialogue: 0,0:25:25.75,0:25:27.91,Main,,0,0,0,,Denizciler tarafından yakalanmamış mıydın?Dialogue: 0,0:25:34.62,0:25:38.07,Main,,0,0,0,,Döner dönmez kötü haberler taşımak zorunda olduğum için üzgünüm.Dialogue: 0,0:25:38.07,0:25:40.34,Main,,0,0,0,,Ama söylediğim her şey doğru.Dialogue: 0,0:25:40.34,0:25:44.52,Main,,0,0,0,,O zaman bu, Hükümet'in sonunda gözünü bu adaya diktiği anlamına geliyor.Dialogue: 0,0:25:44.92,0:25:46.69,Main,,0,0,0,,Gazeteyi okudunuz mu?Dialogue: 0,0:25:46.69,0:25:51.37,Main,,0,0,0,,Poneglifler üstünde çalışmak için 6 yıl önce Ohara'dan ayrılan araştırma ekibinin...Dialogue: 0,0:25:51.37,0:25:56.21,Main,,0,0,0,,...33 üyesi yok edildi. Ben hariç herkes.Dialogue: 0,0:25:56.21,0:25:58.71,Main,,0,0,0,,Ben de geçici olarak yakalandım.Dialogue: 0,0:25:58.71,0:26:03.92,Main,,0,0,0,,Katledilen arkadaşlarımın eşyaları üstünde yapılan uzun bir soruşturmanın ardından,...Dialogue: 0,0:26:03.92,0:26:06.77,Main,,0,0,0,,...Hükümet, Ohara'dan olduğumuzu keşfetti.Dialogue: 0,0:26:07.76,0:26:13.09,Main,,0,0,0,,Daha başka mazeret bulamıyorum. Bizim yüzümüzden, tehlike bu adaya getirildi.Dialogue: 0,0:26:13.09,0:26:16.48,Main,,0,0,0,,Kes artık! Bu hiç kimsenin hatası değil!Dialogue: 0,0:26:16.48,0:26:20.88,Main,,0,0,0,,Denize açılanlar ve burada kalanlar,  aynı takımın parçası.Dialogue: 0,0:26:20.88,0:26:24.30,Main,,0,0,0,,Kurban olanlar siz değil misiniz?Dialogue: 0,0:26:24.90,0:26:27.06,Main,,0,0,0,,Bizim yüzümüzden çok acı çektiniz.Dialogue: 0,0:26:28.64,0:26:29.98,Main,,0,0,0,,Profesör...Dialogue: 0,0:26:29.98,0:26:34.31,Main,,0,0,0,,Dünyanın her yerinden gelen yetenekli bilim adamları...Dialogue: 0,0:26:34.31,0:26:37.23,Main,,0,0,0,,...tarihin peşinden koşmak için Ohara'da buluşuyorlar...Dialogue: 0,0:26:37.23,0:26:40.12,Main,,0,0,0,,...bu yüzden Hükümet,  başından beri Ohara'yı tehdit olarak gördü.Dialogue: 0,0:26:40.12,0:26:43.47,Main,,0,0,0,,Muhtemelen nihayet bizi yakaladıklarını düşünüyorlar.Dialogue: 0,0:26:43.47,0:26:46.04,Main,,0,0,0,,Bu fırsatın kaçmasına izin vermeyecekler.Dialogue: 0,0:26:46.04,0:26:50.09,Main,,0,0,0,,Doğru ama bu bilgiyi zamanında almayı başardık.Dialogue: 0,0:26:50.09,0:26:54.69,Main,,0,0,0,,Er ya da geç, Ohara'daki  tüm bilginleri silmeye çalışacaklar!Dialogue: 0,0:26:54.69,0:26:58.47,Main,,0,0,0,,Bu yüzden hepiniz, Ohara'dan hemen kaçmalısınız!Dialogue: 0,0:26:58.47,0:27:05.45,Main,,0,0,0,,Doğru... Bu kez, her zamanki gibi  soruşturmayı atlatamayacağız sanırım.Dialogue: 0,0:27:05.45,0:27:09.53,Main,,0,0,0,,Hükümet, bizi öldürmeye çalışıyor.Dialogue: 0,0:27:09.53,0:27:10.87,Main,,0,0,0,,O yüzden, acele edin...Dialogue: 0,0:27:10.87,0:27:12.82,Main,,0,0,0,,Ama biliyorsun, Olvia.Dialogue: 0,0:27:12.82,0:27:17.43,Main,,0,0,0,,Kendi açımdan insanlığın bu hazinelerini arkamda bırakıp kaçamam.Dialogue: 0,0:27:17.43,0:27:19.13,Main,,0,0,0,,Anla beni.Dialogue: 0,0:27:19.13,0:27:22.00,Main,,0,0,0,,Hepimiz aynıyız, Olvia.Dialogue: 0,0:27:22.00,0:27:23.91,Main,,0,0,0,,Çocuklar...Dialogue: 0,0:27:23.91,0:27:26.67,Main,,0,0,0,,Hükümet'in ne yapmayı planladığını bilmiyoruz.Dialogue: 0,0:27:26.67,0:27:30.42,Main,,0,0,0,,Buradan kaçarsak, kıymetli tarihi koruyamayacağız.Dialogue: 0,0:27:30.42,0:27:33.42,Main,,0,0,0,,Bu sefer de elimizden geleni yapacağız.Dialogue: 0,0:27:33.42,0:27:35.23,Main,,0,0,0,,Asıl önemlisi...Dialogue: 0,0:27:35.23,0:27:38.15,Main,,0,0,0,,...seni rahatsız eden bir şey olmalı, değil mi?Dialogue: 0,0:27:38.15,0:27:41.40,Main,,0,0,0,,Ama onunla görüşemem.Dialogue: 0,0:27:42.16,0:27:46.35,Main,,0,0,0,,Karar ver, Olvia. Gemiye binecek misin, binmeyecek misin?Dialogue: 0,0:27:46.35,0:27:48.96,Main,,0,0,0,,Kızına karşı yükümlülüklerin varsa, unut gitsin.Dialogue: 0,0:27:48.96,0:27:51.94,Main,,0,0,0,,Kocanın isteğini gerçekleştireceğiz.Dialogue: 0,0:27:51.94,0:27:53.53,Flashbacks,,0,0,0,,Hayır, geliyorum.Dialogue: 0,0:27:53.53,0:27:59.50,Flashbacks,,0,0,0,,Ben, Ohara'nın bir bilginiyim! Atalarımın arzusundan vazgeçemem!Dialogue: 0,0:28:00.20,0:28:01.50,Thoughts,,0,0,0,,Üzgünüm, Robin.Dialogue: 0,0:28:01.50,0:28:05.43,Thoughts,,0,0,0,,Tüm gizemleri çözeceğim ve kesinlikle geri geleceğim.Dialogue: 0,0:28:11.09,0:28:15.98,Main,,0,0,0,,Anne... Annem nerede? Nereye gitti?Dialogue: 0,0:28:15.98,0:28:21.19,Main,,0,0,0,,Annen iş için denize açıldı. Bir süre burada bizimle kalacaksın.Dialogue: 0,0:28:21.19,0:28:23.77,Main,,0,0,0,,Çok gürültücüsün! Susmazsan, döverim!Dialogue: 0,0:28:23.77,0:28:26.29,Main,,0,0,0,,Hey, hey, kes şunu! O sadece 2 yaşında.Dialogue: 0,0:28:26.29,0:28:27.65,Main,,0,0,0,,Kızımız da 2 yaşında.Dialogue: 0,0:28:27.65,0:28:30.50,Main,,0,0,0,,Kız kardeşinin çocuğu olması umrumda değil.Dialogue: 0,0:28:30.50,0:28:33.68,Main,,0,0,0,,Öyle bir şeyi nasıl alabilirsin?Dialogue: 0,0:28:35.25,0:28:37.00,Main,,0,0,0,,Vay...Dialogue: 0,0:28:37.00,0:28:39.72,Main,,0,0,0,,O da kim?! Olduğun yerde kal!Dialogue: 0,0:28:41.71,0:28:44.68,Main,,0,0,0,,Ş-Şey... Ben... Şe...Dialogue: 0,0:28:47.93,0:28:49.41,Main,,0,0,0,,Afedersiniz.Dialogue: 0,0:28:51.47,0:28:54.94,Main,,0,0,0,,Ne zaman kitap okumak istersen bana söyle.Dialogue: 0,0:28:54.94,0:28:57.89,Main,,0,0,0,,Ama hiç param yok.Dialogue: 0,0:28:57.89,0:29:02.32,Main,,0,0,0,,Benim paraya ihtiyacım yok. Buradaki her şeyi bedavaya okuyabilirsin.Dialogue: 0,0:29:02.32,0:29:06.58,Main,,0,0,0,,– Bedavaya? – Evet, çünkü burası dünyadaki en iyi kütüphane.Dialogue: 0,0:29:06.58,0:29:08.75,Main,,0,0,0,,– Dünyadaki en iyi? – Evet.Dialogue: 0,0:29:08.75,0:29:11.87,Main,,0,0,0,,Sahi, sen Olvia'nın kızısın, değil mi?Dialogue: 0,0:29:12.67,0:29:14.32,Main,,0,0,0,,Kitapları sever misin?Dialogue: 0,0:29:17.29,0:29:20.33,Main,,0,0,0,,Senin gençliğine çok benziyor.Dialogue: 0,0:29:20.33,0:29:23.25,Main,,0,0,0,,Aynı zamanda eşsiz bir deha.Dialogue: 0,0:29:24.27,0:29:27.25,Main,,0,0,0,,İyiyse sorun yok.Dialogue: 0,0:29:27.92,0:29:31.39,Main,,0,0,0,,Bu yolda yürüdüğüm için tüm bağlarımı koparmalıyım.Dialogue: 0,0:29:31.39,0:29:35.35,Main,,0,0,0,,Bir suçlunun kızı olmasına izin veremem.Dialogue: 0,0:29:35.35,0:29:39.07,Main,,0,0,0,,Profesör Clover! Bu kez Dünya Hükümeti'nin bayrağını taşıyan gemiler var!Dialogue: 0,0:29:39.07,0:29:43.02,Main,,0,0,0,,Hükümet gemileri onca yoldan Batı Mavi'ye mi geliyor?Dialogue: 0,0:29:43.02,0:29:46.99,Main,,0,0,0,,Emin misin? Durum ciddileşiyor.Dialogue: 0,0:29:48.94,0:29:50.79,Main,,0,0,0,,Herkes beni iyi dinlesin.Dialogue: 0,0:29:50.79,0:29:53.91,Main,,0,0,0,,Ne arkadaşınız, ne de tanıdığınızım.Dialogue: 0,0:29:55.92,0:29:59.62,Main,,0,0,0,,Bunu aklınıza sokun. Ne olursa olsun!Dialogue: 0,0:29:59.62,0:30:02.54,Main,,0,0,0,,Olvia, dur! Ne yapıyorsun?!Dialogue: 0,0:30:02.54,0:30:06.51,Main,,0,0,0,,Hey, merkeze vardığımızı rapor edin.Dialogue: 0,0:30:02.55,0:30:06.51,Captions,,0,0,0,,Ohara SahiliDialogue: 0,0:30:06.51,0:30:09.51,Main,,0,0,0,,Hadi, hadi, hadi! Çabuk ilerleyin!Dialogue: 0,0:30:09.51,0:30:12.51,Main,,0,0,0,,Çok can sıkıcı.Dialogue: 0,0:30:13.06,0:30:16.63,Main,,0,0,0,,Ama bu iş beni terfi ettirebilir.Dialogue: 0,0:30:16.63,0:30:20.51,Main,,0,0,0,,Hey, bilgin adını taşıyan herkesi alıkoyun.Dialogue: 0,0:30:20.51,0:30:21.44,Main,,0,0,0,,Emredersiniz!Dialogue: 0,0:30:21.44,0:30:25.11,Main,,0,0,0,,– Ne oldu? – Silah taşıyan bir kadın etrafta koşup duruyor!Dialogue: 0,0:30:43.84,0:30:49.05,Main,,0,0,0,,Korkunç bir şey! Üzgünüm, Robin!Dialogue: 0,0:30:49.05,0:30:49.80,Main,,0,0,0,,Koramiral Kuzan!Dialogue: 0,0:30:49.10,0:30:54.46,Captions,,0,0,0,,Batı Mavi Denizde  Bir YerDialogue: 0,0:30:49.80,0:30:51.92,Main,,0,0,0,,Ne oldu?Dialogue: 0,0:30:51.92,0:30:56.03,Main,,0,0,0,,CP9'un şefi Spandine, Ohara'ya varmış.Dialogue: 0,0:30:56.03,0:30:59.45,Main,,0,0,0,,Ne? Bunu söylemek için mi...Dialogue: 0,0:30:59.47,0:31:01.93,Main,,0,0,0,,...BENİ UYANDIRDIN?!Dialogue: 0,0:30:59.96,0:31:03.42,Captions,,0,0,0,,Kuzan Donanma Karargahı Koramirali (Daha Sonra Amiral Aokiji Olacak)Dialogue: 0,0:31:01.93,0:31:03.42,Main,,0,0,0,,Ü-Üzgünüm!Dialogue: 0,0:31:03.42,0:31:06.00,Credits,,0,0,0,,Editing: Galaxy 9000  Timing: Halee  Quality Assurance: Feeso, Galaxy 9000, Grug, Pepperjack  Soundtracking: Halee  Title & Infoboxes: Datenshi  Karaoke: KaitouYahiko  Translation: Crunchyroll, GaijinDialogue: 0,0:00:00.71,0:00:03.37,Lyrics,,0,0,0,,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪Dialogue: 0,0:00:03.59,0:00:06.46,Lyrics,,0,0,0,,♪ Bayrağımızı süsleyip, gökyüzüne kaldırarak. ♪Dialogue: 0,0:00:12.77,0:00:18.06,Lyrics,,0,0,0,,♪ Sonsuz okyanusu geçip aramaya gidelim. ♪Dialogue: 0,0:00:18.86,0:00:21.81,Lyrics,,0,0,0,,♪ Henüz kimse tarafından...Dialogue: 0,0:00:21.90,0:00:23.94,Lyrics,,0,0,0,,...bulunmamış bu dünyanın mucizesini. ♪Dialogue: 0,0:00:24.82,0:00:27.96,Lyrics,,0,0,0,,♪ Çarpıp duran göğsümüzdeki...Dialogue: 0,0:00:27.96,0:00:29.71,Lyrics,,0,0,0,,...aynı hislerle devam etmeliyiz. ♪Dialogue: 0,0:00:29.71,0:00:35.59,Lyrics,,0,0,0,,♪ Hayaller peşinde koşanlar tarafından bırakılmış ayak izleri. ♪Dialogue: 0,0:00:36.42,0:00:39.39,Lyrics,,0,0,0,,♪ Ne tür bir fırtınalı gece olursa olsun,...Dialogue: 0,0:00:39.39,0:00:42.39,Lyrics,,0,0,0,,...kalplerimizin bir olmasını sağlarsak...Dialogue: 0,0:00:42.39,0:00:46.54,Lyrics,,0,0,0,,...bu zorluğun üstesinden gelebileceğiz! ♪Dialogue: 0,0:00:46.68,0:00:47.86,Lyrics,,0,0,0,,♪ Her zaman ♪Dialogue: 0,0:00:48.76,0:00:51.59,Lyrics,,0,0,0,,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪Dialogue: 0,0:00:51.72,0:00:54.55,Lyrics,,0,0,0,,♪ Bayrağımızı dalgalandırıp gökyüzüne kaldırarak. ♪Dialogue: 0,0:00:54.60,0:00:57.14,Lyrics,,0,0,0,,♪ Kimseye göstermeyeceğiz. ♪Dialogue: 0,0:00:57.23,0:01:00.58,Lyrics,,0,0,0,,♪ Gözlerimizde yaşlar olsa bile. ♪Dialogue: 0,0:01:00.77,0:01:03.52,Lyrics,,0,0,0,,♪ Peşinden gidelim, peşinden gidelim! ♪Dialogue: 0,0:01:03.69,0:01:06.52,Lyrics,,0,0,0,,♪ Hayallerimize giden doğru yolu...Dialogue: 0,0:01:06.61,0:01:09.23,Lyrics,,0,0,0,,...gösteren pusulanın. ♪Dialogue: 0,0:01:09.23,0:01:11.40,Lyrics,,0,0,0,,♪ Durmayacağız. ♪Dialogue: 0,0:01:11.42,0:01:14.42,Lyrics,,0,0,0,,♪ Dünyayı dolaşarak...Dialogue: 0,0:01:14.45,0:01:15.85,Lyrics,,0,0,0,,...yeniden başlayalım! ♪Dialogue: 0,0:01:18.83,0:01:21.49,Lyrics,,0,0,0,,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪Dialogue: 0,0:01:21.80,0:01:24.54,Lyrics,,0,0,0,,♪ Hedefimize doğru herkesten daha fazla. ♪Dialogue: 0,0:01:24.63,0:01:27.12,Lyrics,,0,0,0,,♪ Şimdi kaçmazsak,...Dialogue: 0,0:01:27.22,0:01:30.54,Lyrics,,0,0,0,,...yarını sıkı sıkıya kavrayabileceğiz! ♪Dialogue: 0,0:01:30.60,0:01:33.63,Lyrics,,0,0,0,,♪ Peşinden gidelim, peşinden gidelim! ♪Dialogue: 0,0:01:33.68,0:01:36.51,Lyrics,,0,0,0,,♪ Gözlerinden yansıtılmış tüm şimdiki zamanın. ♪Dialogue: 0,0:01:36.56,0:01:38.93,Lyrics,,0,0,0,,♪ Bembeyaz bir kalp...Dialogue: 0,0:01:39.15,0:01:41.43,Lyrics,,0,0,0,,...bana tüm hikayeyi anlatacak! ♪Dialogue: 0,0:01:41.73,0:01:44.43,Lyrics,,0,0,0,,♪ Yepyeni bir dünyada...Dialogue: 0,0:01:44.53,0:01:45.83,Lyrics,,0,0,0,,...yeniden başlayalım! ♪