Dialogue: 1,0:01:49.96,0:01:53.30,Title,,0,0,0,,{\fad(500,0)}Zoro, Kaku'ya Karşı
Dialogue: 0,0:01:58.97,0:02:01.10,Main,,0,0,0,,{\fad(150,150)}Şeytan Biçişi!
Dialogue: 0,0:02:12.14,0:02:13.88,Main,,0,0,0,,Zürafa ve marimo...
Dialogue: 0,0:02:13.98,0:02:16.11,Main,,0,0,0,,...kuleyi çökertmeye mi çalışıyor?
Dialogue: 0,0:02:26.79,0:02:28.00,Main,,0,0,0,,Bu...
Dialogue: 0,0:02:29.34,0:02:30.89,Main,,0,0,0,,..."Adalet Kapısı"...
Dialogue: 0,0:02:31.42,0:02:33.34,Main,,0,0,0,,Bunu takip edersem oraya ulaşabilir miyim?
Dialogue: 0,0:02:36.38,0:02:40.12,Main,,0,0,0,,Nami-sangil muhtemelen çoktan\NRobin-chan'ın olduğu yere gitti.
Dialogue: 0,0:02:44.06,0:02:47.02,Main,,0,0,0,,Ben de acele etmeli ve bu bir numaralı\Nanahtarı oraya götürmeliyim.
Dialogue: 0,0:02:49.89,0:02:50.90,Main,,0,0,0,,Gitmeliyim.
Dialogue: 0,0:02:57.19,0:02:58.95,Main,,0,0,0,,Çabuk gel!
Dialogue: 0,0:03:07.95,0:03:11.25,Main,,0,0,0,,Nihayet geldik. Tereddüt Köprüsü'ndeyiz!
Dialogue: 0,0:03:14.17,0:03:16.00,Main,,0,0,0,,Bak, Nico Robin!
Dialogue: 0,0:03:26.06,0:03:29.89,Main,,0,0,0,,Görüyor musun? Adalet Kapısı açılıyor.
Dialogue: 0,0:03:34.77,0:03:38.74,Main,,0,0,0,,Uzun sürdü. Gerçekten çok uzun sürdü!
Dialogue: 0,0:03:38.74,0:03:40.40,Main,,0,0,0,,Ama nihayet başardım!
Dialogue: 0,0:03:40.40,0:03:43.53,Main,,0,0,0,,O kapıdan geçince hükümetin-
Dialogue: 0,0:03:43.53,0:03:47.24,Main,,0,0,0,,Hayır, dünyanın kahramanı olacağım!
Dialogue: 0,0:03:51.00,0:03:55.67,Main,,0,0,0,,Kapıya giden köprü yükseltildi.
Dialogue: 0,0:03:55.67,0:03:58.21,Main,,0,0,0,,Kahramanı bekliyor!
Dialogue: 0,0:04:06.43,0:04:12.10,Main,,0,0,0,,Mükemmel! \NParlak geleceğe uzanan şu yola bak!
Dialogue: 0,0:04:14.10,0:04:18.27,Main,,0,0,0,,Gerçi senin için daha çok cehennem yolu.
Dialogue: 0,0:04:18.27,0:04:22.86,Main,,0,0,0,,{\fad(0,700)}Öyle düşünmüyor musun, Nico Robin!?
Dialogue: 0,0:04:29.33,0:04:31.37,Main,,0,0,0,,– Hayır!\N– Hey, ne?
Dialogue: 0,0:04:33.08,0:04:34.17,Main,,0,0,0,,Ah!
Dialogue: 0,0:04:36.96,0:04:38.67,Main,,0,0,0,,Hey, dur!
Dialogue: 0,0:04:41.17,0:04:44.93,Main,,0,0,0,,Pislik. Kes şunu artık, seni sürtük!
Dialogue: 0,0:04:44.93,0:04:49.51,Main,,0,0,0,,Hala anlamıyor musun?\NKaçamazsın!
Dialogue: 0,0:04:58.23,0:04:59.69,Thoughts,,0,0,0,,Luffy.
Dialogue: 0,0:04:59.69,0:05:00.44,Thoughts,,0,0,0,,Çocuklar.
Dialogue: 0,0:05:01.23,0:05:02.36,Thoughts,,0,0,0,,Çocuklar!
Dialogue: 0,0:05:07.77,0:05:09.49,Main,,0,0,0,,Çabuk, çabuk!
Dialogue: 0,0:05:09.49,0:05:12.29,Main,,0,0,0,,Zamanında varamazsam bir anlamı kalmaz.
Dialogue: 0,0:05:12.50,0:05:13.87,Main,,0,0,0,,O da ne?
Dialogue: 0,0:05:19.46,0:05:22.17,Main,,0,0,0,,Hedefimize varmamıza on dakika kaldı!
Dialogue: 0,0:05:23.05,0:05:25.93,Main,,0,0,0,,Tüm gemiler konumlarını doğrulasın.
Dialogue: 0,0:05:25.93,0:05:27.13,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:05:27.64,0:05:31.43,Main,,0,0,0,,Hey! Ayağa kalk, sürtük!
Dialogue: 0,0:05:31.43,0:05:34.27,Main,,0,0,0,,Gidelim, Nico Robin!
Dialogue: 0,0:05:38.10,0:05:40.11,Main,,0,0,0,,Bu çıkış mı?
Dialogue: 0,0:05:46.95,0:05:48.87,Main,,0,0,0,,Sen, Hasır Şapka!
Dialogue: 0,0:05:49.28,0:05:51.08,Main,,0,0,0,,Ah! Franky!
Dialogue: 0,0:05:51.08,0:05:53.16,Main,,0,0,0,,Pislik, niye buradasın?!
Dialogue: 0,0:05:53.16,0:05:56.50,Main,,0,0,0,,Aptal, şimdi bana kızacak zaman değil!
Dialogue: 0,0:05:56.50,0:05:58.92,Main,,0,0,0,,Şimdilik sizden yanayım. Vazgeç artık!
Dialogue: 0,0:06:01.92,0:06:05.21,Main,,0,0,0,,Lucci burada mı?\NOnunla sorun mu yaşıyorsun?
Dialogue: 0,0:06:05.57,0:06:09.22,Main,,0,0,0,,Nico Robin nerede?\NAnahtarların ikisini getirdim.
Dialogue: 0,0:06:09.22,0:06:10.76,Main,,0,0,0,,Yardım lazım mı?
Dialogue: 0,0:06:10.76,0:06:12.89,Main,,0,0,0,,Hayır. Asıl önemlisi,...
Dialogue: 0,0:06:13.47,0:06:15.64,Main,,0,0,0,,...lütfen Robin'i durdur!
Dialogue: 0,0:06:17.56,0:06:21.36,Main,,0,0,0,,Güvercinli adamın arkasındaki kapıdan\NAdalet Kapısı'na ulaşabilirsin!
Dialogue: 0,0:06:21.77,0:06:23.69,Main,,0,0,0,,Robin çoktan götürüldü!
Dialogue: 0,0:06:24.36,0:06:27.07,Main,,0,0,0,,Onunla ilgileneceğim.
Dialogue: 0,0:06:28.91,0:06:31.49,Main,,0,0,0,,Bana bırak, pislik!
Dialogue: 0,0:06:47.13,0:06:51.97,Main,,0,0,0,,Bana sorsaydın eti tercih ettiğimi söylerdim!
Dialogue: 0,0:06:53.93,0:06:57.27,Main,,0,0,0,,Umrumda değil dedim zaten, otçul hayvan.
Dialogue: 0,0:07:00.52,0:07:02.90,Main,,0,0,0,,Ama şimdilik anahtarını almalıyım.
Dialogue: 0,0:07:03.66,0:07:06.32,Main,,0,0,0,,Zamanında varamazsam, yenilmekle aynı olur.
Dialogue: 0,0:07:09.38,0:07:12.70,Main,,0,0,0,,{\fad(150,150)}Çift Kılıç Stili: Çift Dilim!
Dialogue: 0,0:07:17.75,0:07:21.12,Main,,0,0,0,,O bandanayı takarsan daha mı güçlü oluyorsun?
Dialogue: 0,0:07:21.54,0:07:22.71,Main,,0,0,0,,Bilmem.
Dialogue: 0,0:07:26.63,0:07:28.21,Main,,0,0,0,,{\fad(150,150)}Kule Tırmanışı!
Dialogue: 0,0:07:31.22,0:07:33.34,Main,,0,0,0,,{\fad(150,150)}Kule İnişi!
Dialogue: 0,0:07:36.58,0:07:38.02,Main,,0,0,0,,{\fad(150,150)}Işık Patlaması!
Dialogue: 0,0:07:39.48,0:07:40.69,Main,,0,0,0,,{\fad(150,150)}Kum Figürü!
Dialogue: 0,0:07:41.54,0:07:43.35,Main,,0,0,0,,Havadaysan işin bitti demektir!
Dialogue: 0,0:07:44.02,0:07:45.54,Main,,0,0,0,,{\fad(150,150)}Tırpan Zürafa!
Dialogue: 0,0:07:55.27,0:07:57.83,Main,,0,0,0,,{\fad(150,150)}Zayıf Noktasız Demir Parça!
Dialogue: 0,0:07:59.31,0:08:00.41,Main,,0,0,0,,Ne?!
Dialogue: 0,0:08:10.55,0:08:14.01,Main,,0,0,0,,"Küp" olsam da, "zayıf noktalar" ım yok. *
Dialogue: 0,0:08:14.59,0:08:16.80,Main,,0,0,0,,Kapa çeneni, ne yapıyorsun sen?!
Dialogue: 0,0:08:17.93,0:08:19.31,Main,,0,0,0,,Ne kadar toyca.
Dialogue: 0,0:08:19.31,0:08:21.02,Main,,0,0,0,,Farketmedin mi?
Dialogue: 0,0:08:21.38,0:08:22.69,Main,,0,0,0,,Ne?
Dialogue: 0,0:08:23.53,0:08:27.82,Main,,0,0,0,,Zürafaların dört bacağı vardır.
Dialogue: 0,0:08:28.40,0:08:29.65,Main,,0,0,0,,{\fad(150,150)}Bacak Fırtınası!
Dialogue: 0,0:08:30.19,0:08:32.15,Main,,0,0,0,,Dövüşmeye çalışıyor musun sen?!
Dialogue: 0,0:08:32.15,0:08:35.91,Main,,0,0,0,,Nereye bakıyorsun?\NSaldırı çoktan başladı.
Dialogue: 0,0:08:38.37,0:08:44.92,Main,,0,0,0,,Saldırılar tavandan sekip yağmur gibi yağacak.
Dialogue: 0,0:08:46.75,0:08:48.00,Main,,0,0,0,,{\fad(150,150)}Zürafa Güz Yağmuru!
Dialogue: 0,0:08:53.34,0:08:54.47,Main,,0,0,0,,{\fad(150,150)}Demir Parça!
Dialogue: 0,0:08:59.06,0:09:01.10,Thoughts,,0,0,0,,Etrafa saldırı yağdırıp duruyor.
Dialogue: 0,0:09:01.10,0:09:03.06,Thoughts,,0,0,0,,Kahretsin! Karşı koyamıyorum!
Dialogue: 0,0:09:14.53,0:09:15.74,Main,,0,0,0,,{\fad(150,150)}Burun Tabancası!
Dialogue: 0,0:09:41.11,0:09:42.72,Main,,0,0,0,,Pislik!
Dialogue: 0,0:09:43.42,0:09:45.48,Main,,0,0,0,,Ne güçlü bir adam.
Dialogue: 0,0:09:45.48,0:09:47.35,Main,,0,0,0,,Şaşırdım.
Dialogue: 0,0:09:48.44,0:09:51.27,Main,,0,0,0,,Çok çalıştım, Zürafa Kavanozu.
Dialogue: 0,0:09:51.27,0:09:54.36,Main,,0,0,0,,Zürafa Kavanozu mu? Ben zürafayım.
Dialogue: 0,0:09:54.36,0:09:55.99,Main,,0,0,0,,Zürafa Kavanozu.
Dialogue: 0,0:09:55.99,0:09:58.91,Main,,0,0,0,,Hayır, zürafayım!
Dialogue: 0,0:10:01.03,0:10:02.74,Main,,0,0,0,,Kapa çeneni!
Dialogue: 0,0:10:02.74,0:10:05.25,Main,,0,0,0,,"Zürafa Kavanozu" veya "Ben zürafayım".
Dialogue: 0,0:10:05.62,0:10:09.29,Main,,0,0,0,,O kadar sinir bozucu ki\Nhangisinin olduğu önemli değil.
Dialogue: 0,0:10:10.48,0:10:14.00,Main,,0,0,0,,Bana hakaret etmenin bedelini ödeyeceksin.
Dialogue: 0,0:10:14.00,0:10:19.18,Main,,0,0,0,,Kendini hazırlamalısın. Oyun vakti bitti.
Dialogue: 0,0:10:19.55,0:10:23.59,Main,,0,0,0,,Önce şu "Demir Parça" yı kıracağım!
Dialogue: 0,0:10:24.89,0:10:26.60,Main,,0,0,0,,{\fad(150,150)}Tek Kılıç Stili:...
Dialogue: 0,0:10:26.60,0:10:28.48,Main,,0,0,0,,{\fad(150,150)}...Kes ve Kınına Sok!
Dialogue: 0,0:10:32.73,0:10:34.36,Main,,0,0,0,,{\fad(150,150)}Aslan Şarkısı!
Dialogue: 0,0:10:35.32,0:10:36.24,Main,,0,0,0,,{\fad(150,150)}Bacak Fırtınası!
Dialogue: 0,0:10:38.28,0:10:39.43,Main,,0,0,0,,{\fad(150,150)}Ejder Kesimi!
Dialogue: 0,0:10:44.23,0:10:46.50,Main,,0,0,0,,Çelik olsaydı kesebilir miydin?
Dialogue: 0,0:10:46.94,0:10:51.13,Main,,0,0,0,,Demir Parça kullanıp\Nkullanmamaya karar veren benim.
Dialogue: 0,0:10:52.74,0:10:56.84,Main,,0,0,0,,Anlıyorum. O zaman bu konuda \Nfarklı bir yol izlemeliyim.
Dialogue: 0,0:11:01.01,0:11:02.39,Main,,0,0,0,,{\fad(150,150)}Bir Goril!
Dialogue: 0,0:11:02.76,0:11:04.14,Main,,0,0,0,,{\fad(150,150)}İki Goril!
Dialogue: 0,0:11:04.14,0:11:06.18,Main,,0,0,0,,Şimdi, gel bakalım!
Dialogue: 0,0:11:08.10,0:11:10.60,Main,,0,0,0,,{\fad(150,150)}Üç Kılıç Stili...
Dialogue: 0,0:11:10.60,0:11:13.19,Main,,0,0,0,,Bu kez de güç testi mi?
Dialogue: 0,0:11:13.96,0:11:15.98,Main,,0,0,0,,Ne kadar ilginç!
Dialogue: 0,0:11:15.98,0:11:16.90,Main,,0,0,0,,{\fad(150,150)}Burun Tabancası!
Dialogue: 0,0:11:18.07,0:11:19.86,Main,,0,0,0,,{\fad(150,150)}...İki Goril Doğrayışı!
Dialogue: 0,0:11:24.73,0:11:26.79,Thoughts,,0,0,0,,Ne güçlü bir saldırı!
Dialogue: 0,0:11:35.53,0:11:38.01,Main,,0,0,0,,Yüksekten atıp tutuyorsun.
Dialogue: 0,0:11:38.01,0:11:42.64,Main,,0,0,0,,Kendinin de yenilebileceğini hiç düşünmedin.
Dialogue: 0,0:11:47.64,0:11:49.18,Main,,0,0,0,,Kendine fazla güveniyorsun!
Dialogue: 0,0:11:49.18,0:11:51.35,Main,,0,0,0,,Sen de öyle!
Dialogue: 0,0:11:55.77,0:11:57.34,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu No...
Dialogue: 0,0:11:57.34,0:11:59.82,Main,,0,0,0,,{\fad(150,150)}...Makineli Tüfek!
Dialogue: 0,0:12:00.19,0:12:01.36,Main,,0,0,0,,{\fad(150,150)}Kağıt Sanatı!
Dialogue: 0,0:12:06.41,0:12:07.85,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu No...
Dialogue: 0,0:12:07.85,0:12:08.95,Main,,0,0,0,,{\fad(150,150)}...Tabanca!!
Dialogue: 0,0:12:08.95,0:12:10.00,Main,,0,0,0,,{\fad(150,150)}Kazı!
Dialogue: 0,0:12:21.01,0:12:22.38,Main,,0,0,0,,Hasır Şapka!
Dialogue: 0,0:12:24.93,0:12:25.97,Main,,0,0,0,,{\fad(150,150)}Bacak Fırtınası!
Dialogue: 0,0:12:34.44,0:12:36.48,Main,,0,0,0,,{\fad(150,150)}Sol Silahlar!
Dialogue: 0,0:12:37.82,0:12:38.44,Main,,0,0,0,,{\fad(150,150)}Kazı!
Dialogue: 0,0:12:39.97,0:12:40.94,Main,,0,0,0,,Ne?
Dialogue: 0,0:12:41.53,0:12:42.82,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu No...
Dialogue: 0,0:12:42.82,0:12:45.05,Main,,0,0,0,,{\fad(150,150)}...Roket!
Dialogue: 0,0:12:48.04,0:12:48.81,Main,,0,0,0,,Ne?
Dialogue: 0,0:12:48.81,0:12:50.45,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu No...
Dialogue: 0,0:12:50.45,0:12:52.75,Main,,0,0,0,,{\fad(150,150)}...Bazuka!
Dialogue: 0,0:12:56.73,0:12:59.34,Main,,0,0,0,,Bir zürafanın tam potansiyelini...
Dialogue: 0,0:12:59.90,0:13:03.22,Main,,0,0,0,,...henüz görmedin.
Dialogue: 0,0:13:03.22,0:13:05.68,Main,,0,0,0,,Bu kadar konuşma yeter. Göster bana.
Dialogue: 0,0:13:06.26,0:13:08.64,Main,,0,0,0,,Söylemene gerek yok.
Dialogue: 0,0:13:08.64,0:13:11.81,Main,,0,0,0,,Zürafanın gücünü dikkatlice seyret.
Dialogue: 0,0:13:14.98,0:13:16.56,Main,,0,0,0,,{\fad(150,150)}Zürafa Topu!
Dialogue: 0,0:13:17.65,0:13:19.73,Main,,0,0,0,,Öyle zürafalar yok.
Dialogue: 0,0:13:19.73,0:13:21.98,Main,,0,0,0,,{\fad(150,150)}Aşırı Burun Tabanca:...
Dialogue: 0,0:13:22.86,0:13:24.49,Main,,0,0,0,,{\fad(150,150)}...Zürafa Adamın Ateş Küreği!
Dialogue: 0,0:13:25.07,0:13:26.28,Main,,0,0,0,,Uzadı?!
Dialogue: 0,0:13:27.20,0:13:28.99,Main,,0,0,0,,Söylememe bile gerek yoktu...
Dialogue: 0,0:13:28.99,0:13:30.78,Main,,0,0,0,,...ama uzun boynun senin zayıf noktan!
Dialogue: 0,0:13:31.49,0:13:33.25,Main,,0,0,0,,Hayır, değil!
Dialogue: 0,0:13:33.25,0:13:34.08,Main,,0,0,0,,{\fad(150,150)}Bacak Frıtınası:...
Dialogue: 0,0:13:34.08,0:13:35.46,Main,,0,0,0,,{\fad(150,150)}...Dönerek Çekilen Kılıç!
Dialogue: 0,0:13:41.96,0:13:44.51,Main,,0,0,0,,Zayıf noktaları olan sensin.
Dialogue: 0,0:13:44.51,0:13:48.26,Main,,0,0,0,,Ne tür bir hayvan bu?
Dialogue: 0,0:13:48.64,0:13:50.47,Main,,0,0,0,,Bu kez kaçamayacaksın.
Dialogue: 0,0:13:51.51,0:13:52.93,Main,,0,0,0,,{\fad(150,150)}Zürafa Topu!
Dialogue: 0,0:13:55.98,0:13:59.44,Main,,0,0,0,,Eyvah, boynumu fazla içeri\Nçektiğim için bacaklarım uzadı!
Dialogue: 0,0:13:59.44,0:14:01.48,Main,,0,0,0,,Bedeninin nesi var böyle?!
Dialogue: 0,0:14:01.48,0:14:07.91,Main,,0,0,0,,Makarna makinesinde buğdayın \Nmakarnaya dönüştürülmesi gibi!
Dialogue: 0,0:14:11.08,0:14:12.28,Main,,0,0,0,,{\fad(150,150)}Makarna Makinesi!
Dialogue: 0,0:14:12.28,0:14:14.04,Main,,0,0,0,,Saldırılarını şimdi isimlendirme!
Dialogue: 0,0:14:14.70,0:14:19.33,Main,,0,0,0,,Uzun bir boyun iyi ama uzun bacakların\Nve kolların da birçok kullanımı var.
Dialogue: 0,0:14:19.96,0:14:24.80,Main,,0,0,0,,En beklenmedik durumları kabullenmekte\Nve kendi avantajıma kullanmakta uzmanım!
Dialogue: 0,0:14:25.92,0:14:29.76,Main,,0,0,0,,Seyret! Bu yeni erimle \Nkullanabileceğim saldırıları.
Dialogue: 0,0:14:32.39,0:14:33.31,Main,,0,0,0,,{\fad(150,150)}Zürafa Adamın Ateş Küreği!
Dialogue: 0,0:14:33.31,0:14:35.18,Main,,0,0,0,,Tüm düşünebildiğin bu muydu?!
Dialogue: 0,0:14:36.64,0:14:37.64,Main,,0,0,0,,Çok fazla konuşma oldu.
Dialogue: 0,0:14:39.48,0:14:41.02,Main,,0,0,0,,{\fad(150,150)}Üç Kılıç Stili:...
Dialogue: 0,0:14:41.02,0:14:42.77,Main,,0,0,0,,{\fad(150,150)}...Tornado!
Dialogue: 0,0:14:42.77,0:14:43.86,Main,,0,0,0,,{\fad(150,150)}Demir Parça!
Dialogue: 0,0:14:47.61,0:14:49.41,Main,,0,0,0,,Ne güç ama!
Dialogue: 0,0:14:49.41,0:14:50.24,Main,,0,0,0,,{\fad(150,150)}Kazı!
Dialogue: 0,0:14:56.37,0:14:57.37,Main,,0,0,0,,{\fad(150,150)}Ay Yürüyüşü!
Dialogue: 0,0:15:01.00,0:15:02.88,Main,,0,0,0,,Üst kata mı atladı?
Dialogue: 0,0:15:06.30,0:15:07.76,Main,,0,0,0,,{\fad(150,150)}Makarna Makinesi!
Dialogue: 0,0:15:10.88,0:15:12.47,Main,,0,0,0,,Seni beklettim.
Dialogue: 0,0:15:17.18,0:15:20.48,Main,,0,0,0,,Boynum gibi kollarım ve bacaklarımın da\Nerimlerini istediğim gibi kontrol edebilirsem,...
Dialogue: 0,0:15:20.48,0:15:22.40,Main,,0,0,0,,...istediğim gibi dövüşebilirim.
Dialogue: 0,0:15:25.32,0:15:28.19,Main,,0,0,0,,Ben dört kılıç stili kullanıcısıyım!
Dialogue: 0,0:15:28.19,0:15:31.70,Main,,0,0,0,,Bu şekilde zürafanın tüm gücünü\Nen uç noktasına kadar kullanabilirim!
Dialogue: 0,0:15:31.70,0:15:34.53,Main,,0,0,0,,Kazanma şansın kalmayacak!
Dialogue: 0,0:15:34.95,0:15:37.91,Main,,0,0,0,,Zürafalar en güçlüsü olsa bile,...
Dialogue: 0,0:15:38.41,0:15:42.00,Main,,0,0,0,,...o sinir bozucu boynu tam\Nolarak kullanabilsen bile,...
Dialogue: 0,0:15:42.42,0:15:45.63,Main,,0,0,0,,...dört kılıç stili kullanıcısı olsan bile...
Dialogue: 0,0:15:46.84,0:15:48.21,Main,,0,0,0,,...ne olmuş?!
Dialogue: 0,0:15:50.47,0:15:51.68,Main,,0,0,0,,Ne?
Dialogue: 0,0:15:52.18,0:15:54.64,Main,,0,0,0,,Kılıçlarımı durdurdu mu?
Dialogue: 0,0:15:56.85,0:16:02.31,Main,,0,0,0,,Yine de beni yenme şansın yok!
Dialogue: 0,0:16:09.44,0:16:10.94,Main,,0,0,0,,{\fad(150,150)}Üç Kılıç Stili:...
Dialogue: 0,0:16:12.15,0:16:13.66,Main,,0,0,0,,{\fad(150,150)}...Leopar.
Dialogue: 0,0:16:14.78,0:16:15.74,Main,,0,0,0,,{\fad(150,150)}Lavta!
Dialogue: 0,0:16:18.62,0:16:19.66,Thoughts,,0,0,0,,Bana doğru mu uçuyor?
Dialogue: 0,0:16:19.66,0:16:21.04,Main,,0,0,0,,{\fad(150,150)}Mücevher!
Dialogue: 0,0:16:21.71,0:16:22.79,Main,,0,0,0,,{\fad(150,150)}Kağıt Sanatı!
Dialogue: 0,0:16:30.76,0:16:33.80,Thoughts,,0,0,0,,İmkansız!\NSaldırıyı savuşturduğumu sanmıştım!
Dialogue: 0,0:16:38.60,0:16:40.43,Thoughts,,0,0,0,,Yoksa bu adam...
Dialogue: 0,0:16:43.59,0:16:47.23,Thoughts,,0,0,0,,...ne yapacağımı biliyor muydu?
Dialogue: 0,0:16:49.87,0:16:52.65,Main,,0,0,0,,Niye bu kadar şaşırdın?
Dialogue: 0,0:16:53.11,0:16:57.32,Main,,0,0,0,,Gerçekten ilk kez yaralanıyor olamazsın.
Dialogue: 0,0:16:57.82,0:17:02.08,Main,,0,0,0,,Anlıyorum. Gerçekten onu kastettin.
Dialogue: 0,0:17:02.08,0:17:06.17,Main,,0,0,0,,Gerçekten senden hoşlanmamamı sağladın.\NAma burada sona eriyor!
Dialogue: 0,0:17:06.17,0:17:11.80,Main,,0,0,0,,Sadece altı stil ustalığım değil, \Naynı zamanda zürafa gücüm de var.
Dialogue: 0,0:17:11.80,0:17:16.01,Main,,0,0,0,,Yetenek, güç, hız.\NNasıl bakarsan bak, yenilmem mümkün değil!
Dialogue: 0,0:17:16.01,0:17:18.43,Main,,0,0,0,,Bir an olsun rahatlamana izin vermeyeceğim!
Dialogue: 0,0:17:19.14,0:17:20.60,Main,,0,0,0,,{\fad(150,150)}Şuriken Bacak Fırtınası!
Dialogue: 0,0:17:27.73,0:17:29.57,Main,,0,0,0,,{\fad(150,150)}Zürafa Adamın Ateş Küreği!
Dialogue: 0,0:17:31.40,0:17:32.48,Thoughts,,0,0,0,,Kahretsin!
Dialogue: 0,0:17:34.99,0:17:37.36,Main,,0,0,0,,Kırbaç gibi bir boyun.
Dialogue: 0,0:17:37.41,0:17:38.66,Main,,0,0,0,,{\fad(150,150)}Kırbaç Bambu Ormanı!
Dialogue: 0,0:17:46.25,0:17:48.13,Main,,0,0,0,,Daha hızlı!
Dialogue: 0,0:17:48.13,0:17:49.21,Main,,0,0,0,,{\fad(150,150)}Vahşi Bambu Ormanı!
Dialogue: 0,0:17:51.80,0:17:55.55,Main,,0,0,0,,Pek çok saldırıyla vurulmak nasıl?!
Dialogue: 0,0:17:58.39,0:18:02.85,Main,,0,0,0,,Hiç durmadan dört kılıç! Hazırla kendini!
Dialogue: 0,0:18:04.93,0:18:06.39,Main,,0,0,0,,{\fad(150,150)}İmparatorluk Öfkesi!
Dialogue: 0,0:18:11.77,0:18:12.61,Main,,0,0,0,,Geliyorum.
Dialogue: 0,0:18:16.24,0:18:18.11,Thoughts,,0,0,0,,Ne güçlü bir saldırı!
Dialogue: 0,0:18:18.11,0:18:22.12,Main,,0,0,0,,Ne oldu?\NTüm yapabildiğin engellemek mi?
Dialogue: 0,0:18:22.45,0:18:24.75,Main,,0,0,0,,Beni yenemezsin!
Dialogue: 0,0:18:28.79,0:18:34.13,Main,,0,0,0,,Dünya Hükümeti'ne karşı çıkan\Nönemsiz korsanların hiç şansı yoktu!
Dialogue: 0,0:18:35.26,0:18:39.18,Main,,0,0,0,,Adaletle mukayese edildiğinde her şey değersizdir!
Dialogue: 0,0:18:39.18,0:18:40.76,Main,,0,0,0,,O kadın bile değersiz!
Dialogue: 0,0:18:47.39,0:18:48.89,Main,,0,0,0,,Seni piç...
Dialogue: 0,0:19:07.06,0:19:09.25,Thoughts,,0,0,0,,Neydi o?!
Dialogue: 0,0:19:09.25,0:19:13.29,Thoughts,,0,0,0,,Bir anlığına bu adam, üç başlı ve \Naltı kollu şiddet tanrısı gibi göründü!
Dialogue: 0,0:19:13.69,0:19:17.26,Thoughts,,0,0,0,,Bu adam ne böyle?
Dialogue: 0,0:19:19.34,0:19:21.59,Main,,0,0,0,,Ukalalık ettin...
Dialogue: 0,0:19:22.43,0:19:24.64,Main,,0,0,0,,...ve çok fazla konuştun, pislik herif.
Dialogue: 0,0:19:25.06,0:19:27.06,Main,,0,0,0,,Seni gücendirdim mi?
Dialogue: 0,0:19:27.52,0:19:31.14,Main,,0,0,0,,Öyleyse kuleyi böldüğüm en güçlü bacak\Nfırtınası "Çember Kesim" i kullanarak...
Dialogue: 0,0:19:31.14,0:19:32.90,Main,,0,0,0,,...seni ikiye böleceğim...
Dialogue: 0,0:19:36.65,0:19:39.36,Main,,0,0,0,,...ve bu iş bitecek!
Dialogue: 0,0:19:39.36,0:19:42.78,Main,,0,0,0,,Pes etmelisin. Kaçacak yer yok!
Dialogue: 0,0:19:42.78,0:19:45.99,Main,,0,0,0,,Bu, deminki gösteriden farklı!
Dialogue: 0,0:19:51.67,0:19:52.71,Main,,0,0,0,,Aptal.
Dialogue: 0,0:19:54.92,0:19:57.67,Main,,0,0,0,,Pes etmesi gereken sensin.
Dialogue: 0,0:20:04.01,0:20:06.47,Main,,0,0,0,,{\fad(150,150)}Şeytani Ruh: Dokuz Kılıç Stili...
Dialogue: 0,0:20:10.20,0:20:11.48,Main,,0,0,0,,{\fad(150,150)}...Asura!
Dialogue: 0,0:20:16.02,0:20:18.28,Thoughts,,0,0,0,,Deminki şeytan!
Dialogue: 0,0:20:18.28,0:20:20.99,Thoughts,,0,0,0,,Sadece ruhuyla ilüzyon mu oluşturuyor?
Dialogue: 0,0:20:21.45,0:20:23.95,Main,,0,0,0,,İyi deneme ama çok geç kaldın!
Dialogue: 0,0:20:23.95,0:20:28.08,Main,,0,0,0,,Çok geç kalan da sensin.
Dialogue: 0,0:20:28.58,0:20:34.08,Main,,0,0,0,,O tür şeyleri söylemek için \NBacak Fırtınası'ndan kurtulmayı beklemelisin!
Dialogue: 0,0:20:34.92,0:20:36.92,Main,,0,0,0,,{\fad(150,150)}Çember Kesim!
Dialogue: 0,0:20:46.39,0:20:47.43,Main,,0,0,0,,Saldırıları...
Dialogue: 0,0:20:48.85,0:20:50.47,Main,,0,0,0,,...dağıttı mı?!
Dialogue: 0,0:20:52.39,0:20:54.35,Main,,0,0,0,,İyi iş çıkardın.
Dialogue: 0,0:20:54.85,0:20:57.98,Main,,0,0,0,,Kan dökmeye giden yolda\Nacı çekmek iyidir.
Dialogue: 0,0:21:09.08,0:21:11.87,Main,,0,0,0,,{\fad(150,150)}Asura: Bir Sis Gümüşü!
Dialogue: 0,0:21:44.15,0:21:49.03,Main,,0,0,0,,Diğer Galley-La ustasından bir mesajım var.
Dialogue: 0,0:21:50.45,0:21:54.62,Flashbacks,,0,0,0,,Onları görürsen de ki,...
Dialogue: 0,0:21:56.62,0:21:59.46,Main,,0,0,0,,Kovuldunuz.
Dialogue: 0,0:22:02.17,0:22:03.92,Main,,0,0,0,,Paulie, ha?
Dialogue: 0,0:22:04.71,0:22:07.05,Main,,0,0,0,,Bu çok yazık işte.
Dialogue: 0,0:22:07.84,0:22:13.56,Main,,0,0,0,,Her zaman suikastçilerin başka\Nişinin olamayacağını söylerlerdi.
Dialogue: 0,0:22:14.77,0:22:17.39,Main,,0,0,0,,Hayvanat bahçesine ne dersin?
Dialogue: 0,0:22:22.44,0:22:24.28,Main,,0,0,0,,Bu harika!
Dialogue: 0,0:22:53.81,0:22:55.02,Main,,0,0,0,,Üzgünüm.
Dialogue: 0,0:23:12.62,0:23:15.16,Main,,0,0,0,,Hey, marimo! Anahtarı aldın mı?
Dialogue: 0,0:23:15.16,0:23:16.24,Main,,0,0,0,,Evet.
Dialogue: 0,0:23:17.25,0:23:18.79,Main,,0,0,0,,Şimdi aldım.
Dialogue: 0,0:23:19.66,0:23:21.21,Main,,0,0,0,,Öyle mi?
Dialogue: 0,0:23:21.92,0:23:24.21,Main,,0,0,0,,Ama gerçekten abartmışsınız.
Dialogue: 0,0:23:24.21,0:23:27.71,Main,,0,0,0,,Kule yine kaydı.\NGerçekten iyi olacak mı?
Dialogue: 0,0:23:27.71,0:23:31.72,Main,,0,0,0,,Bundan bahsetme zahmetine bile girme.\NÖnemli değil zaten.
Dialogue: 0,0:23:33.60,0:23:37.43,Main,,0,0,0,,Böylece bütün anahtarları aldık.
Dialogue: 0,0:23:42.69,0:23:44.06,Main,,0,0,0,,Evet.
Dialogue: 0,0:23:44.52,0:23:46.69,Main,,0,0,0,,Hemen Robin'i almaya gidelim.
Dialogue: 0,0:23:52.07,0:23:55.16,Main,,0,0,0,,Koşun!
Dialogue: 0,0:23:55.81,0:24:00.16,Main,,0,0,0,,Sadece koşun! Tam yol ileri!
Dialogue: 0,0:24:00.16,0:24:05.13,Main,,0,0,0,,Abimiz ve Hasır Şapkalar için endişelenmemeliyiz!
Dialogue: 0,0:24:05.50,0:24:06.34,Main,,0,0,0,,Vırak!
Dialogue: 0,0:24:06.34,0:24:11.35,Main,,0,0,0,,Hayatta kalmak için koşun!\NBacaklarınız kırılsa bile koşmaya devam edin!
Dialogue: 0,0:24:11.35,0:24:13.76,Main,,0,0,0,,Tamam!
Dialogue: 0,0:24:14.51,0:24:16.22,Main,,0,0,0,,Koşun!
Dialogue: 0,0:24:16.22,0:24:18.64,Main,,0,0,0,,Size güveniyoruz, devler!
Dialogue: 0,0:24:18.64,0:24:23.44,Main,,0,0,0,,Siz sadece oturuyorsunuz,\Nbu yüzden sesinizi çıkarmayın!
Dialogue: 0,0:24:24.31,0:24:26.11,Main,,0,0,0,,Katılıyorum!
Dialogue: 0,0:24:26.56,0:24:30.61,Main,,0,0,0,,Hadi, Elbaf adına!
Dialogue: 0,0:24:30.61,0:24:32.07,Main,,0,0,0,,Kapa çeneni!
Dialogue: 0,0:24:34.57,0:24:37.28,Main,,0,0,0,,Nine, daha hızlı! Çabuk, çabuk!
Dialogue: 0,0:24:37.28,0:24:41.66,Main,,0,0,0,,Chimney, ben yaşlı bir kadınım! Sabırlı ol!
Dialogue: 0,0:24:41.66,0:24:46.13,Main,,0,0,0,,Biraz daha içmezsem koşamam.
Dialogue: 0,0:24:47.71,0:24:51.26,Main,,0,0,0,,Nine, düşüyor! Kaldır onu, kaldır!
Dialogue: 0,0:24:52.13,0:24:54.59,Main,,0,0,0,,Bu bir emir mi?
Dialogue: 0,0:24:54.59,0:24:55.76,Main,,0,0,0,,Nine!
Dialogue: 0,0:24:55.76,0:24:57.89,Main,,0,0,0,,Acele edelim!
Dialogue: 0,0:25:24.29,0:25:26.00,Main,,0,0,0,,Nihayet geldik!
Dialogue: 0,0:25:27.04,0:25:28.66,Main,,0,0,0,,Gülmeden duramıyorum!
Dialogue: 0,0:25:28.66,0:25:32.26,Main,,0,0,0,,Hey! Adalet Kapısı muhafızları!\NHer şey hazır mı?!
Dialogue: 0,0:25:32.26,0:25:35.51,Main,,0,0,0,,Evet, hazır! Gelmenizi bekliyor-
Dialogue: 0,0:25:35.51,0:25:38.22,Main,,0,0,0,,Hayır! Saygınızı göstermek için \Nortaya çıkmanız gerek!
Dialogue: 0,0:25:38.22,0:25:40.40,Main,,0,0,0,,Kahraman Spandam-sama geldi!
Dialogue: 0,0:25:40.40,0:25:42.02,Main,,0,0,0,,Emredersiniz, hemen!
Dialogue: 0,0:25:42.47,0:25:45.23,Main,,0,0,0,,Aptallar, bir işi düzgün yapamıyorlar.
Dialogue: 0,0:25:46.06,0:25:47.98,Main,,0,0,0,,Hey, Nico Robin. Şuna bak.
Dialogue: 0,0:25:49.52,0:25:53.23,Main,,0,0,0,,Oradaki küçük kapı gerçek giriş.
Dialogue: 0,0:25:53.69,0:25:59.07,Main,,0,0,0,,Oradan geçince, cennetten\Ncehenneme geçmiş gibi olacaksın.
Dialogue: 0,0:25:59.07,0:26:02.99,Main,,0,0,0,,O an, benim tarihe geçtiğim an olacak!
Dialogue: 0,0:26:16.88,0:26:20.93,Main,,0,0,0,,Hey, hey. Nereye gittiğini sanıyorsun?
Dialogue: 0,0:26:23.10,0:26:27.10,Main,,0,0,0,,Senin için gerçekten üzülüyorum...
Dialogue: 0,0:26:27.52,0:26:31.31,Main,,0,0,0,,...ama başka çarem yok. \NYaşaman için bir sebep yok.
Dialogue: 0,0:26:32.77,0:26:34.73,Main,,0,0,0,,Bir an önce geber.
Dialogue: 0,0:26:37.49,0:26:39.36,Main,,0,0,0,,Sürtük!
Dialogue: 0,0:26:42.58,0:26:44.04,Thoughts,,0,0,0,,Ölmek istemiyorum!
Dialogue: 0,0:26:44.54,0:26:46.00,Thoughts,,0,0,0,,Ölmek istemiyorum!
Dialogue: 0,0:26:46.70,0:26:48.50,Thoughts,,0,0,0,,Ölemem!
Dialogue: 0,0:26:58.09,0:27:00.22,Main,,0,0,0,,Şöyle davranmayı kes!
Dialogue: 0,0:27:00.22,0:27:02.51,Main,,0,0,0,,Kalk artık!
Dialogue: 0,0:27:03.72,0:27:07.14,Main,,0,0,0,,Ne? Onu kaldıramıyorum! Neler oluyor?
Dialogue: 0,0:27:12.69,0:27:16.82,Main,,0,0,0,,Dişleriyle mi tutunuyor?!
Dialogue: 0,0:27:17.24,0:27:20.53,Main,,0,0,0,,Bu kadın ne zaman pes edeceğini\Nbilmiyor, ne sinir bozucu!
Dialogue: 0,0:27:20.95,0:27:23.83,Main,,0,0,0,,Niye yaşamaya bu kadar bağlısın?!
Dialogue: 0,0:27:23.83,0:27:25.58,Main,,0,0,0,,Acınacak derecede tamahkârsın!
Dialogue: 0,0:27:25.58,0:27:30.29,Main,,0,0,0,,Bir suçludan da bu beklenir!\NÖlerek insanları mutlu bile edemiyorsun!
Dialogue: 0,0:27:30.29,0:27:33.75,Main,,0,0,0,,Her şeyin sona erdiği bir noktada\Nniye hala böyle davranıyorsun?!
Dialogue: 0,0:27:34.25,0:27:37.21,Thoughts,,0,0,0,,Ölmek çok korkutucu.
Dialogue: 0,0:27:41.80,0:27:43.30,Thoughts,,0,0,0,,Ölmek istemiyorum.
Dialogue: 0,0:27:44.10,0:27:45.89,Thoughts,,0,0,0,,Kurtarın beni!
Dialogue: 0,0:27:48.89,0:27:50.19,Thoughts,,0,0,0,,Luffy!
Dialogue: 0,0:27:54.02,0:27:55.02,Main,,0,0,0,,{\fad(150,150)}Parmak Tabanca!
Dialogue: 0,0:27:56.32,0:27:58.69,Main,,0,0,0,,İşe yaramaz!
Dialogue: 0,0:27:59.53,0:28:00.49,Main,,0,0,0,,{\fad(150,150)}Sarı Nilüfer!
Dialogue: 0,0:28:03.11,0:28:04.37,Main,,0,0,0,,Hasır Şapka!
Dialogue: 0,0:28:05.20,0:28:06.41,Main,,0,0,0,,Hayır.
Dialogue: 0,0:28:06.62,0:28:10.58,Main,,0,0,0,,Bir an önce o kapıdan geçmeyi düşünmeliyim!
Dialogue: 0,0:28:13.83,0:28:17.17,Main,,0,0,0,,Faydasız. Buradan geçemezsin.
Dialogue: 0,0:28:17.59,0:28:19.14,Main,,0,0,0,,Kapa çeneni!
Dialogue: 0,0:28:19.14,0:28:20.17,Main,,0,0,0,,{\fad(150,0)}Güçlü...
Dialogue: 0,0:28:20.17,0:28:21.17,Main,,0,0,0,,{\fad(100,100)}Demir Parça!
Dialogue: 0,0:28:21.17,0:28:23.05,Main,,0,0,0,,{\fad(0,150)}...Çekiç!
Dialogue: 0,0:28:38.48,0:28:41.03,Main,,0,0,0,,Ne? Tepki dahi yok mu?
Dialogue: 0,0:28:41.95,0:28:44.45,Main,,0,0,0,,O saldırı Chapapa'yı havaya uçurmuştu.
Dialogue: 0,0:28:45.37,0:28:48.91,Main,,0,0,0,,Anlıyorum.\NFukurou'yu yenip buraya mı geldin?
Dialogue: 0,0:28:48.91,0:28:53.54,Main,,0,0,0,,Üzgünüm. Güç seviyem onunkinin beş katı.
Dialogue: 0,0:29:03.34,0:29:06.14,Main,,0,0,0,,Fukurou'yu yenerek iyi iş çıkardın.
Dialogue: 0,0:29:06.14,0:29:09.51,Main,,0,0,0,,Senin gücün de insan üstü.
Dialogue: 0,0:29:09.51,0:29:13.02,Thoughts,,0,0,0,,Bu adam tamamen farklı bir kulvarda!
Dialogue: 0,0:29:13.60,0:29:15.65,Main,,0,0,0,,Artık öl.
Dialogue: 0,0:29:15.65,0:29:17.02,Main,,0,0,0,,{\fad(150,0)}Gomu Gomu No...
Dialogue: 0,0:29:17.02,0:29:18.73,Main,,0,0,0,,{\fad(0,150)}...Jet Tabanca!
Dialogue: 0,0:29:32.29,0:29:34.16,Main,,0,0,0,,Bu da ne?!
Dialogue: 0,0:29:35.25,0:29:37.71,Main,,0,0,0,,O duman da ne?!
Dialogue: 0,0:29:42.48,0:29:44.34,Main,,0,0,0,,{\fad(150,150)}İkinci Düzen!
Dialogue: 0,0:29:54.06,0:29:56.64,Main,,0,0,0,,Bunu çok fazla sürdüremem...
Dialogue: 0,0:29:57.06,0:30:00.06,Main,,0,0,0,,...ama onu durduracağım.\NSen devam et, Franky!
Dialogue: 0,0:30:01.73,0:30:03.23,Main,,0,0,0,,Robin bekliyor!
Dialogue: 0,0:30:04.19,0:30:05.70,Main,,0,0,0,,Tamam, Hasır Şapka!
Dialogue: 0,0:30:05.70,0:30:08.61,Main,,0,0,0,,Ne yaptığını bilmiyorum ama yen onu!
Dialogue: 0,0:30:13.37,0:30:15.83,Main,,0,0,0,,Buna izin vermeyeceğimi...
Dialogue: 0,0:30:17.54,0:30:18.62,Main,,0,0,0,,...söylemedim mi?!
Dialogue: 0,0:30:18.62,0:30:21.84,Main,,0,0,0,,Sen de mi şeytan meyvesi kullanıcısıydın?!
Dialogue: 0,0:30:21.84,0:30:24.88,Main,,0,0,0,,Önce senden kurtulacağım, Franky!
Dialogue: 0,0:30:28.39,0:30:29.64,Main,,0,0,0,,{\fad(150,150)}Jet Kırbaç!
Dialogue: 0,0:30:38.10,0:30:41.06,Main,,0,0,0,,Unuttun mu, Hasır Şapkalı Luffy?
Dialogue: 0,0:30:41.06,0:30:45.78,Main,,0,0,0,,Bu şekildeyken Galley-La\Nbinasında seni tek vuruşta yendim.
Dialogue: 0,0:30:46.69,0:30:50.03,Main,,0,0,0,,Ah, şu mesele.\NEt yedikten sonra daha iyi oldum.
Dialogue: 0,0:30:51.24,0:30:52.58,Main,,0,0,0,,{\fad(150,150)}Kazı!
Dialogue: 0,0:30:52.58,0:30:53.62,Main,,0,0,0,,{\fad(150,150)}Parmak Tabanca!
Dialogue: 0,0:30:55.83,0:30:57.46,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu No...
Dialogue: 0,0:30:57.46,0:30:58.37,Main,,0,0,0,,{\fad(150,150)}Demir Parça!
Dialogue: 0,0:30:59.79,0:31:01.50,Main,,0,0,0,,{\fad(150,150)}...Jet Bazuka!
Dialogue: 0,0:31:08.17,0:31:09.09,Main,,0,0,0,,Franky!
Dialogue: 0,0:31:10.09,0:31:11.51,Main,,0,0,0,,Robin'i geri al!
Dialogue: 0,0:31:12.03,0:31:14.85,Main,,0,0,0,,Lanet olası! Bunun faydasız olduğunu hala anlamıyor musun?!
Dialogue: 0,0:31:14.85,0:31:16.47,Main,,0,0,0,,Kaç kez söyledim sana?!
Dialogue: 0,0:31:16.47,0:31:19.27,Main,,0,0,0,,Artık hiç umudun kalmadı!
Dialogue: 0,0:31:20.17,0:31:22.03,Thoughts,,0,0,0,,Buradan kıpırdayamam.
Dialogue: 0,0:31:22.03,0:31:26.15,Thoughts,,0,0,0,,Herkes beni kurtarmaya gelecek!
Dialogue: 0,0:31:27.86,0:31:30.41,Main,,0,0,0,,Süper bana bırak!
