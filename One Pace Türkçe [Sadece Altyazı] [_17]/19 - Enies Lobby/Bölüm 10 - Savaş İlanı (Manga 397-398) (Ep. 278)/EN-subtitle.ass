0,7,10,10,10,1Style: Lyrics,Duality,55,&H00D8933F,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2.6,0,2,10,10,15,1Style: Narrator,Impress BT,56,&H00FFFFFF,&H000000FF,&H00000000,&H78000000,0,-1,0,0,100,100,0,0,1,1.5,1.5,2,120,120,18,1Style: Kanji - Copy - Copy-furigana,Duality,40,&H00FFFFFF,&H000000FF,&H00E4BA0F,&H00000000,0,0,0,0,100,100,0,0,1,1.5,0,8,502,0,130,1Style: Translation - Copy - Copy-furigana,Duality,40,&H00FFFFFF,&H000000FF,&H00E4BA0F,&H00000000,0,0,0,0,100,100,0,0,1,1.5,0,2,545,0,10,1Style: Kanji-furigana,Duality,30,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2,0,8,10,10,80,1Style: Translation-furigana,Duality,30,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,1.5,0,2,10,10,10,1Style: Karaoke-furigana,Duality,30,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,1.5,0,8,10,10,10,1Style: Default-furigana,Arial,10,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1,1,2,10,10,10,1Style: Karaoke,Duality,55,&H00FFFFFF,&H000000FF,&H00E4BA0F,&H00000000,0,0,0,0,100,100,0,0,1,3,0,8,10,10,10,1Style: Translation,Duality,60,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,2,10,10,10,1Style: Kanji,Duality,60,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,8,10,10,110,1Style: CaptionsBig,Roboto,40,&H00000000,&H000000FF,&H00FFFFFF,&H00FFFFFF,0,0,0,0,100,100,0,0,1,2.5,0,2,10,10,11,1Style: Translation Gray,Duality,55,&H00FFFFFF,&H000000FF,&H00807C7A,&H00000000,0,0,0,0,100,100,0,0,1,3,0,2,10,10,10,1Style: Karaoke Gray-furigana,Duality,40,&H00FFFFFF,&H000000FF,&H00E4BA0F,&H00000000,0,0,0,0,100,100,0,0,1,1.5,0,8,10,10,10,1Style: Kanji Gray-furigana,Duality,40,&H00FFFFFF,&H000000FF,&H00807C7A,&H00000000,0,0,0,0,100,100,0,0,1,1.5,0,8,10,10,120,1Style: Kanji Gray,Duality,55,&H00FFFFFF,&H000000FF,&H00807C7A,&H00000000,0,0,0,0,100,100,0,0,1,3,0,8,10,10,110,1Style: Karaoke Gray,Duality,55,&H00FFFFFF,&H000000FF,&H00807C7A,&H00000000,0,0,0,0,100,100,0,0,1,3,0,8,10,10,10,1Style: Karaoke - Copy - Copy,Duality,55,&H00FFFFFF,&H000000FF,&H00E4BA0F,&H00000000,0,0,0,0,100,100,0,0,1,3,0,8,373,0,10,1Style: Kanji - Copy - Copy,Duality,55,&H00FFFFFF,&H000000FF,&H00E4BA0F,&H00000000,0,0,0,0,100,100,0,0,1,3,0,8,350,0,110,1Style: OP13-Kanji-furigana,Duality,30,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2,0,8,10,10,80,1Style: OP13-Karaoke,Duality,60,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,8,10,10,10,1Style: OP13-Translation,Duality,60,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,2,10,10,10,1Style: OP13-Kanji,Duality,60,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,8,10,10,110,1Style: OP13-Credits,FOT-Greco Std B,40,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,95,100,1,0,1,2.2,0,1,80,10,100,1Style: Pekoms - Infobox,Roboto,39,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,2,2,2,10,10,10,1Style: Map,Roboto,39,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,2,2,2,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text﻿[Script Info]; Script generated by Aegisub 3.2.2; http://www.aegisub.org/Title: Default Aegisub fileScriptType: v4.00+WrapStyle: 0ScaledBorderAndShadow: yesYCbCr Matrix: TV.601PlayResX: 1280PlayResY: 720Dialogue: 0,0:01:50.98,0:01:52.77,Flashbacks,,0,0,0,,Stop it! Saul!Dialogue: 0,0:01:52.77,0:01:54.19,Flashbacks,,0,0,0,,You better be ready! Dialogue: 0,0:01:54.19,0:01:58.70,Flashbacks,,0,0,0,,Make an enemy of me, and I'll make you pay! Dialogue: 0,0:01:57.24,0:02:01.30,Title,,0,0,250,,Declaration of WarDialogue: 0,0:02:10.75,0:02:12.17,Main,,0,0,0,,What's going on?!Dialogue: 0,0:02:12.17,0:02:13.94,Main,,0,0,0,,It's Vice Admiral Saul!Dialogue: 0,0:02:13.94,0:02:19.45,Main,,0,0,0,,First he escapes with Olvia, and now he's attacking us! Dialogue: 0,0:02:19.84,0:02:21.34,Main,,0,0,0,,Why is he here?!Dialogue: 0,0:02:21.34,0:02:23.41,Main,,0,0,0,,W-We don't know!Dialogue: 0,0:02:26.43,0:02:28.22,Main,,0,0,0,,The island is finished! Dialogue: 0,0:02:28.22,0:02:29.96,Main,,0,0,0,,It'll all burn to rubble! Dialogue: 0,0:02:29.96,0:02:34.29,Main,,0,0,0,,Don't give up! Save the books! We have to preserve this history! Dialogue: 0,0:02:35.61,0:02:37.44,Main,,0,0,0,,Throw them into the lake!Dialogue: 0,0:02:37.44,0:02:40.17,Main,,0,0,0,,It's better than having them burn up! Quickly! Dialogue: 0,0:02:43.20,0:02:44.41,Main,,0,0,0,,Now!Dialogue: 0,0:02:48.10,0:02:51.56,Main,,0,0,0,,Saul! Stop it already! You'll die! Dialogue: 0,0:02:51.56,0:02:54.52,Main,,0,0,0,,Throw the books out of the library!Dialogue: 0,0:02:54.52,0:02:56.25,Main,,0,0,0,,Save as many books as possible! Dialogue: 0,0:02:56.25,0:02:59.28,Main,,0,0,0,,Preserve as many pages as we can! Dialogue: 0,0:03:00.26,0:03:03.51,Main,,0,0,0,,So that our ancestors' words... Dialogue: 0,0:03:03.51,0:03:05.83,Main,,0,0,0,,Will reach the future!Dialogue: 0,0:03:09.24,0:03:11.48,Main,,0,0,0,,Robin! What're you doing?!Dialogue: 0,0:03:11.48,0:03:13.96,Main,,0,0,0,,Run to the evacuation ship while you can!Dialogue: 0,0:03:13.96,0:03:17.29,Main,,0,0,0,,You won't survive if you stay here!Dialogue: 0,0:03:51.40,0:03:53.83,Main,,0,0,0,,Mother!Dialogue: 0,0:03:58.71,0:04:00.53,Main,,0,0,0,,Shoot Saul!Dialogue: 0,0:04:01.67,0:04:07.14,Main,,0,0,0,,Robin! Hurry and run! What was your mother's last wish?! Dialogue: 0,0:04:07.14,0:04:09.71,Flashbacks,,0,0,0,,Live, Robin!Dialogue: 0,0:04:10.93,0:04:13.35,Main,,0,0,0,,The evacuation ship is departing!Dialogue: 0,0:04:13.35,0:04:15.60,Main,,0,0,0,,Wait! There's someone's coming!Dialogue: 0,0:04:16.05,0:04:17.02,Main,,0,0,0,,That's...!Dialogue: 0,0:04:18.02,0:04:20.22,Main,,0,0,0,,Ah! Isn't that the monster?!Dialogue: 0,0:04:20.22,0:04:21.44,Main,,0,0,0,,Yeah, it is!Dialogue: 0,0:04:21.44,0:04:23.06,Main,,0,0,0,,Go away, monster!Dialogue: 0,0:04:23.06,0:04:25.00,Main,,0,0,0,,Hey! Don't be ridiculous!Dialogue: 0,0:04:25.00,0:04:26.39,Main,,0,0,0,,Well... wait!Dialogue: 0,0:04:26.39,0:04:31.45,Main,,0,0,0,,Isn't she the daughter of that criminal, Olvia, who was in the paper earlier? Dialogue: 0,0:04:31.45,0:04:35.50,Main,,0,0,0,,That's right! If we let her on the ship, it might cause us trouble!Dialogue: 0,0:04:35.50,0:04:38.83,Main,,0,0,0,,Don't be ridiculous! She's only a child! Hurry and get her on the ship!Dialogue: 0,0:04:38.83,0:04:42.00,Main,,0,0,0,,Evacuation ship! Do not let that brat onboard!Dialogue: 0,0:04:42.00,0:04:43.05,Main,,0,0,0,,What?Dialogue: 0,0:04:43.05,0:04:45.76,Main,,0,0,0,,She may be a child, but she's also an archaeologist!Dialogue: 0,0:04:45.76,0:04:48.05,Main,,0,0,0,,She is a target of our operation!Dialogue: 0,0:04:48.05,0:04:51.41,Main,,0,0,0,,Chief Spandine! I-Is that true?!Dialogue: 0,0:04:51.41,0:04:54.39,Main,,0,0,0,,See? If we had let her onboard, we'd be in danger!Dialogue: 0,0:04:54.39,0:04:56.38,Main,,0,0,0,,Robin!Dialogue: 0,0:04:56.38,0:04:59.39,Main,,0,0,0,,That must be CP9! Those worthless scum! Dialogue: 0,0:04:59.39,0:05:02.53,Main,,0,0,0,,Chief! Vice Admiral Saul is coming this way!Dialogue: 0,0:05:02.53,0:05:06.34,Main,,0,0,0,,Really?! I guess we didn't have to ask Olvia about his whereabouts.Dialogue: 0,0:05:06.34,0:05:08.90,Main,,0,0,0,,Fire! Fire! Fire the cannons at him!Dialogue: 0,0:05:11.30,0:05:12.69,Main,,0,0,0,,Ice Block!Dialogue: 0,0:05:13.23,0:05:14.11,Main,,0,0,0,,Partisan!Dialogue: 0,0:05:17.75,0:05:19.03,Main,,0,0,0,,Saul!Dialogue: 0,0:05:27.51,0:05:28.84,Main,,0,0,0,,Kuzan-san!Dialogue: 0,0:05:29.61,0:05:30.96,Main,,0,0,0,,Kuzan...!Dialogue: 0,0:05:30.96,0:05:32.45,Main,,0,0,0,,Oh, my, my...Dialogue: 0,0:05:32.45,0:05:33.89,Main,,0,0,0,,It wouldn't look good... Dialogue: 0,0:05:33.89,0:05:38.38,Main,,0,0,0,,if a deserter prevented a buster call, would it? Dialogue: 0,0:05:38.38,0:05:40.35,Main,,0,0,0,,Kuzan!Dialogue: 0,0:05:40.35,0:05:44.06,Main,,0,0,0,,Is this really honorable?Dialogue: 0,0:05:44.06,0:05:45.61,Main,,0,0,0,,Pull back!Dialogue: 0,0:05:45.61,0:05:48.86,Main,,0,0,0,,This isn't right! You should know that!Dialogue: 0,0:05:48.86,0:05:50.37,Main,,0,0,0,,This is a warning!Dialogue: 0,0:05:50.37,0:05:53.66,Main,,0,0,0,,Ohara is being wiped out to make an example!Dialogue: 0,0:05:53.66,0:05:57.39,Main,,0,0,0,,If it benefits the future of the world, it can't be helped.Dialogue: 0,0:05:57.39,0:06:00.62,Main,,0,0,0,,In fact, these scholars have broken the law, right?Dialogue: 0,0:06:00.62,0:06:04.58,Main,,0,0,0,,Justice has a different meaning depending on your position.Dialogue: 0,0:06:04.58,0:06:07.70,Main,,0,0,0,,So I won't criticize yours.Dialogue: 0,0:06:07.70,0:06:12.75,Main,,0,0,0,,But if you're going to get in our way, I can't let you do that.Dialogue: 0,0:06:20.89,0:06:23.93,Main,,0,0,0,,Ah! The evacuation ship was destroyed!Dialogue: 0,0:06:23.93,0:06:25.98,Main,,0,0,0,,Wh-Why...?Dialogue: 0,0:06:25.98,0:06:27.98,Main,,0,0,0,,It was cannon fire! From one of the battleships!Dialogue: 0,0:06:27.98,0:06:31.03,Main,,0,0,0,,It came from Vice Admiral Sakazuki's ship!Dialogue: 0,0:06:27.98,0:06:31.03,Captions,,0,0,285,,Vice Admiral Sakazuki Navy Headquarters (Later to Become Admiral Akainu) Dialogue: 0,0:06:31.49,0:06:33.24,Main,,0,0,0,,That idiot...!Dialogue: 0,0:06:33.24,0:06:37.09,Main,,0,0,0,,If we are going to do this, we must do it thoroughly.Dialogue: 0,0:06:37.09,0:06:40.04,Main,,0,0,0,,If even a single scholar were to be hiding on that ship...Dialogue: 0,0:06:40.04,0:06:42.54,Main,,0,0,0,,the sacrifices we've made here would be in vain.Dialogue: 0,0:06:43.50,0:06:47.37,Main,,0,0,0,,We must eradicate even the smallest possibility of evil.Dialogue: 0,0:06:47.37,0:06:52.09,Main,,0,0,0,,Is this really justice?! Can you still claim to be in the right?!Dialogue: 0,0:06:52.09,0:06:54.84,Main,,0,0,0,,I never intended to go as far as that idiot!Dialogue: 0,0:06:55.56,0:06:57.10,Main,,0,0,0,,We're getting out of here, Robin!Dialogue: 0,0:06:57.10,0:06:59.77,Main,,0,0,0,,He's abnormally strong!Dialogue: 0,0:06:59.77,0:07:01.31,Main,,0,0,0,,Saul ran away!Dialogue: 0,0:07:01.31,0:07:03.68,Main,,0,0,0,,He's taking a scholar with him!Dialogue: 0,0:07:06.19,0:07:08.51,Main,,0,0,0,,Ice Time Capsule!Dialogue: 0,0:07:12.86,0:07:14.53,Main,,0,0,0,,Saul! Are you okay?!Dialogue: 0,0:07:16.95,0:07:19.15,Main,,0,0,0,,Robin, run away!Dialogue: 0,0:07:24.08,0:07:26.17,Main,,0,0,0,,Run with all your might!Dialogue: 0,0:07:26.17,0:07:30.59,Main,,0,0,0,,You'll die if you stay on the island! Sail out on my raft!Dialogue: 0,0:07:30.59,0:07:31.88,Main,,0,0,0,,And you, Saul?Dialogue: 0,0:07:31.88,0:07:35.86,Main,,0,0,0,,This is it for me. He got me.Dialogue: 0,0:07:36.71,0:07:37.76,Main,,0,0,0,,Go!Dialogue: 0,0:07:37.76,0:07:40.39,Main,,0,0,0,,I don't want to! I'd be alone at sea! Dialogue: 0,0:07:40.39,0:07:42.43,Main,,0,0,0,,Listen carefully, Robin!Dialogue: 0,0:07:43.43,0:07:48.69,Main,,0,0,0,,You're alone now, but you're sure to meet friends someday! Dialogue: 0,0:07:52.10,0:07:53.36,Main,,0,0,0,,Friends?Dialogue: 0,0:07:53.36,0:07:59.07,Main,,0,0,0,,That's right. The sea is vast, so someday... Dialogue: 0,0:07:59.07,0:08:02.33,Main,,0,0,0,,you'll find friends who'll protect you!Dialogue: 0,0:08:02.33,0:08:07.62,Main,,0,0,0,,No one is born into this world to be alone!Dialogue: 0,0:08:10.13,0:08:13.63,Main,,0,0,0,,Run, Robin! Don't look back!Dialogue: 0,0:08:13.63,0:08:17.89,Main,,0,0,0,,When you're having a bad day, laugh like this, just like I taught you!Dialogue: 0,0:08:17.89,0:08:19.56,Main,,0,0,0,,Watch out, Saul!Dialogue: 0,0:08:22.52,0:08:24.23,Main,,0,0,0,,Ice Time.Dialogue: 0,0:08:26.52,0:08:27.77,Main,,0,0,0,,Saul!Dialogue: 0,0:08:29.23,0:08:32.74,Thoughts,,0,0,0,,Go meet the friends who're waiting for you...Dialogue: 0,0:08:32.74,0:08:35.20,Thoughts,,0,0,0,,somewhere out there, Robin! Dialogue: 0,0:08:39.07,0:08:42.12,Thoughts,,0,0,0,,Live together with them.Dialogue: 0,0:08:56.23,0:08:57.38,Main,,0,0,0,,It's hopeless! Dialogue: 0,0:08:57.38,0:09:01.06,Thoughts,,0,0,0,,So, this is the history humans have chosen. Dialogue: 0,0:09:01.70,0:09:04.98,Thoughts,,0,0,0,,How thoughtless our race is...Dialogue: 0,0:09:05.56,0:09:07.94,Thoughts,,0,0,0,,I'm sorry, Robin.Dialogue: 0,0:09:10.23,0:09:12.57,Thoughts,,0,0,0,,I couldn't even give you...Dialogue: 0,0:09:14.97,0:09:17.07,Thoughts,,0,0,0,,any parting words as a mother.Dialogue: 0,0:09:17.46,0:09:20.76,Main,,0,0,0,,The Tree of Knowledge... has fallen! Dialogue: 0,0:09:28.80,0:09:33.21,Main,,0,0,0,,Absolute justice sometimes drives people mad.Dialogue: 0,0:09:33.59,0:09:36.63,Main,,0,0,0,,I've decided to let you escape from this island.Dialogue: 0,0:09:36.63,0:09:40.64,Main,,0,0,0,,What could possibly sprout from the seed Saul tended? Dialogue: 0,0:09:40.64,0:09:44.01,Main,,0,0,0,,Whom you bear a grudge against is up to you,Dialogue: 0,0:09:44.01,0:09:47.60,Main,,0,0,0,,but for now, just be happy you're alive.Dialogue: 0,0:09:47.60,0:09:49.81,Main,,0,0,0,,Live as quietly as possible.Dialogue: 0,0:09:50.55,0:09:53.15,Main,,0,0,0,,I laid a track of ice on the sea. Dialogue: 0,0:09:53.15,0:09:57.57,Main,,0,0,0,,If you just go straight in that small boat, you'll reach land. Dialogue: 0,0:09:57.57,0:10:00.02,Main,,0,0,0,,Now, remember this: Dialogue: 0,0:10:01.97,0:10:03.70,Main,,0,0,0,,I'm not your ally.Dialogue: 0,0:10:04.12,0:10:08.29,Main,,0,0,0,,I'm your enemy. I'll be the first to come after you if you cause trouble.Dialogue: 0,0:10:09.52,0:10:11.38,Main,,0,0,0,,My mother is on the island!Dialogue: 0,0:10:11.38,0:10:13.79,Main,,0,0,0,,No one will survive.Dialogue: 0,0:10:13.79,0:10:17.20,Main,,0,0,0,,If that pain makes you wish for death, you're free to take that path as well.Dialogue: 0,0:10:18.55,0:10:21.05,Flashbacks,,0,0,0,,This is the best library in the world.Dialogue: 0,0:10:22.09,0:10:23.56,Flashbacks,,0,0,0,,Do you like books?Dialogue: 0,0:10:23.56,0:10:26.35,Flashbacks,,0,0,0,,Today is Robin's birthday!Dialogue: 0,0:10:26.35,0:10:29.44,Flashbacks,,0,0,0,,Happy birthday, Robin!Dialogue: 0,0:10:29.44,0:10:33.02,Flashbacks,,0,0,0,,Hold your head high, Robin! Ohara is honorable!Dialogue: 0,0:10:33.48,0:10:38.57,Flashbacks,,0,0,0,,We cannot give up the future you young ones will live in!Dialogue: 0,0:10:39.02,0:10:42.95,Flashbacks,,0,0,0,,So laugh. When you're having a hard time, just laugh.Dialogue: 0,0:10:43.45,0:10:45.96,Flashbacks,,0,0,0,,It seems stupid to laugh when you're having a hard time.Dialogue: 0,0:10:45.96,0:10:47.92,Flashbacks,,0,0,0,,That's not true.Dialogue: 0,0:11:41.01,0:11:43.96,Flashbacks,,0,0,0,,Go meet the friends who're waiting for you...Dialogue: 0,0:11:43.96,0:11:46.06,Flashbacks,,0,0,0,,somewhere out there, Robin! Dialogue: 0,0:12:04.08,0:12:05.85,Main,,0,0,0,,Survivors?Dialogue: 0,0:12:05.85,0:12:07.27,Main,,0,0,0,,That'd be impossible.Dialogue: 0,0:12:07.98,0:12:09.64,Main,,0,0,0,,– Hey! – Hm?Dialogue: 0,0:12:09.64,0:12:11.25,Main,,0,0,0,,Take a look at this lake.Dialogue: 0,0:12:12.58,0:12:14.21,Main,,0,0,0,,Th-This is...Dialogue: 0,0:12:20.10,0:12:22.72,Main,,0,0,0,,There are enough books to completely fill the lake. Dialogue: 0,0:12:22.72,0:12:24.59,Main,,0,0,0,,Was this by chance?!Dialogue: 0,0:12:24.98,0:12:28.96,Main,,0,0,0,,Yeah, this is the brat! There's no doubt about it!Dialogue: 0,0:12:28.96,0:12:30.96,Main,,0,0,0,,Where'd you find her?! Did you capture her?Dialogue: 0,0:12:30.96,0:12:33.93,Main,,0,0,0,,No, sir! We were looking for a suspicious girl, as ordered...Dialogue: 0,0:12:33.93,0:12:36.87,Main,,0,0,0,,and found this girl on a passenger ship leaving an island...Dialogue: 0,0:12:36.87,0:12:39.14,Main,,0,0,0,,far to the northeast of Ohara.Dialogue: 0,0:12:39.14,0:12:40.90,Main,,0,0,0,,but we lost her right after that.Dialogue: 0,0:12:42.02,0:12:44.07,Main,,0,0,0,,She's got the devil's luck.Dialogue: 0,0:12:44.07,0:12:52.00,Main,,0,0,0,,I definitely saw a brat escaping from the burning Ohara on a small boat!Dialogue: 0,0:12:52.62,0:12:57.78,Main,,0,0,0,,I wanted to go after her, but the helm suddenly got stuck as if it was frozen!Dialogue: 0,0:12:57.78,0:13:01.13,Main,,0,0,0,,I bet Saul let her escape right before he died!Dialogue: 0,0:13:02.72,0:13:05.56,Main,,0,0,0,,If she can decipher the Poneglyphs... Dialogue: 0,0:13:05.56,0:13:08.51,Main,,0,0,0,,she's dangerous regardless of her youth.Dialogue: 0,0:13:09.14,0:13:12.69,Main,,0,0,0,,This operation will come to nothing unless we capture her... Dialogue: 0,0:13:12.69,0:13:15.48,Main,,0,0,0,,as soon as possible — I don't care how! Dialogue: 0,0:13:19.81,0:13:21.57,Main,,0,0,0,,79 million belly?!Dialogue: 0,0:13:21.57,0:13:24.65,Main,,0,0,0,,Such a high bounty for an eight-year-old girl?!Dialogue: 0,0:13:24.65,0:13:27.62,Main,,0,0,0,,They said that she's a survivor of those Ohara devils...Dialogue: 0,0:13:27.62,0:13:29.91,Main,,0,0,0,,who planned the destruction of the world.Dialogue: 0,0:13:29.91,0:13:31.67,Main,,0,0,0,,Ohara?Dialogue: 0,0:13:31.67,0:13:36.55,Main,,0,0,0,,I don't know how, but they said that she sank six Navy battleships.Dialogue: 0,0:13:36.55,0:13:39.01,Main,,0,0,0,,So that's why her bounty is so high.Dialogue: 0,0:13:39.01,0:13:42.38,Main,,0,0,0,,I heard the government and Navy HQ are directly involved in the search. Dialogue: 0,0:13:42.71,0:13:46.73,Main,,0,0,0,,She seems to have inherited the ideology of the executed scholars.Dialogue: 0,0:13:46.73,0:13:48.73,Main,,0,0,0,,It'll be a problem if she's left at large.Dialogue: 0,0:13:48.73,0:13:52.81,Main,,0,0,0,,She's a devil's spawn who shouldn't be left alive! Dialogue: 0,0:13:54.03,0:13:56.73,Main,,0,0,0,,Thank you for always helping me.Dialogue: 0,0:13:56.73,0:13:59.90,Main,,0,0,0,,Sure. Thank you for letting me work.Dialogue: 0,0:13:59.90,0:14:04.61,Main,,0,0,0,,By the way, before lunch, you have guests.Dialogue: 0,0:14:04.61,0:14:05.82,Main,,0,0,0,,What?!Dialogue: 0,0:14:05.82,0:14:07.15,Main,,0,0,0,,Don't let her get away!Dialogue: 0,0:14:07.15,0:14:11.12,Main,,0,0,0,,Now, give me the money! I gave her up, didn't I?!Dialogue: 0,0:14:11.60,0:14:14.58,Main,,0,0,0,,She's small, but she works very hard. Dialogue: 0,0:14:16.61,0:14:19.17,Main,,0,0,0,,Oh? You're still up?Dialogue: 0,0:14:19.17,0:14:21.12,Main,,0,0,0,,We have to go shopping in the morning.Dialogue: 0,0:14:21.12,0:14:22.28,Main,,0,0,0,,Get some rest.Dialogue: 0,0:14:22.28,0:14:23.30,Main,,0,0,0,,Okay.Dialogue: 0,0:14:23.89,0:14:27.26,Main,,0,0,0,,She's a good kid, but if we're with her, we'll be in danger, too.Dialogue: 0,0:14:27.66,0:14:30.22,Main,,0,0,0,,Besides, look at this bounty!Dialogue: 0,0:14:31.37,0:14:33.68,Main,,0,0,0,,Honey! She isn't in her room!Dialogue: 0,0:14:33.68,0:14:36.93,Main,,0,0,0,,Dammit! That little brat caught on!Dialogue: 0,0:14:43.22,0:14:45.94,Main,,0,0,0,,I'm sorry, but I don't have any food.Dialogue: 0,0:14:51.83,0:14:55.12,Main,,0,0,0,,I know about you, Nico Robin!Dialogue: 0,0:14:55.37,0:14:57.70,Main,,0,0,0,,I'm a wanted man, too.Dialogue: 0,0:14:58.18,0:15:00.96,Main,,0,0,0,,If you do chores, I'll feed you.Dialogue: 0,0:15:03.60,0:15:05.68,Main,,0,0,0,,– Captain! – Contact Navy Headquarters!Dialogue: 0,0:15:05.68,0:15:09.56,Main,,0,0,0,,Where's Robin?! Hand her over, dammit!Dialogue: 0,0:15:09.56,0:15:11.34,Main,,0,0,0,,That damn jinx! Dialogue: 0,0:15:14.65,0:15:16.77,Flashbacks,,0,0,0,,Your sin is being alive!Dialogue: 0,0:15:17.90,0:15:20.48,Flashbacks,,0,0,0,,What?! Nico Robin is in town?!Dialogue: 0,0:15:20.82,0:15:23.50,Flashbacks,,0,0,0,,Find her! Hand her over to the government!Dialogue: 0,0:15:27.65,0:15:30.92,Main,,0,0,0,,I found one...! A Poneglyph...!Dialogue: 0,0:15:30.92,0:15:34.42,Main,,0,0,0,,Don't come here! I've got nothing to sell you! Dialogue: 0,0:15:35.22,0:15:39.91,Main,,0,0,0,,I'm sixteen. I'll do anything. Please let me join your organization.Dialogue: 0,0:15:39.91,0:15:42.87,Flashbacks,,0,0,0,,You betrayed me, Robin!Dialogue: 0,0:15:43.47,0:15:47.17,Main,,0,0,0,,Nico Robin. I want you to help me.Dialogue: 0,0:15:49.34,0:15:52.33,Main,,0,0,0,,I heard that you can read Poneglyphs.Dialogue: 0,0:15:55.73,0:16:00.33,Main,,0,0,0,,If... you exercise a buster call right here, right now,Dialogue: 0,0:16:01.28,0:16:03.42,Main,,0,0,0,,then together with Enies Lobby...Dialogue: 0,0:16:07.28,0:16:10.36,Main,,0,0,0,,you will also meet your demise. Dialogue: 0,0:16:10.36,0:16:12.57,Main,,0,0,0,,D-Don't be ridiculous!Dialogue: 0,0:16:13.00,0:16:15.64,Main,,0,0,0,,There's no way our allies would target us!Dialogue: 0,0:16:15.64,0:16:18.00,Main,,0,0,0,,What're you saying?!Dialogue: 0,0:16:18.00,0:16:21.41,Main,,0,0,0,,Twenty years ago, everything was taken away from me...Dialogue: 0,0:16:22.11,0:16:25.13,Main,,0,0,0,,and many people's lives were ruined.Dialogue: 0,0:16:25.57,0:16:29.25,Main,,0,0,0,,It was caused by a single attack — a buster call. Dialogue: 0,0:16:29.96,0:16:31.55,Main,,0,0,0,,That attack is now...Dialogue: 0,0:16:31.55,0:16:35.97,Main,,0,0,0,,aimed at the friends I found who let me lower my guard. Dialogue: 0,0:16:35.97,0:16:39.48,Main,,0,0,0,,The more I wish to be with you,Dialogue: 0,0:16:39.48,0:16:43.32,Main,,0,0,0,,the more my fate will threaten you! Dialogue: 0,0:16:43.32,0:16:46.09,Main,,0,0,0,,No matter how far I travel at sea, Dialogue: 0,0:16:46.09,0:16:49.11,Main,,0,0,0,,I face a colossal enemy that I can't avoid... Dialogue: 0,0:16:49.51,0:16:54.07,Main,,0,0,0,,because the world and its darkness are my enemy!Dialogue: 0,0:16:54.07,0:16:57.49,Main,,0,0,0,,The incident with Aokiji, and this... Dialogue: 0,0:16:57.49,0:17:00.04,Main,,0,0,0,,I've already dragged you into my troubles twice!Dialogue: 0,0:17:01.00,0:17:05.00,Main,,0,0,0,,If this continues forever, no matter how good-natured you are...Dialogue: 0,0:17:07.00,0:17:09.39,Main,,0,0,0,,you'll eventually feel that I'm a burden! Dialogue: 0,0:17:09.39,0:17:12.56,Main,,0,0,0,,One day, I'm sure you'll betray and abandon me!Dialogue: 0,0:17:12.56,0:17:14.77,Main,,0,0,0,,That's what I'm most afraid of!Dialogue: 0,0:17:14.77,0:17:17.90,Main,,0,0,0,,That's why I didn't want you to come to rescue me!Dialogue: 0,0:17:17.90,0:17:19.72,Main,,0,0,0,,If I'm going to die someday anyway,Dialogue: 0,0:17:19.72,0:17:23.18,Main,,0,0,0,,I want to die right here, right now!Dialogue: 0,0:17:27.11,0:17:28.38,Main,,0,0,0,,Robin...Dialogue: 0,0:17:28.38,0:17:30.11,Main,,0,0,0,,Robin-chan...Dialogue: 0,0:17:31.04,0:17:32.19,Main,,0,0,0,,Robin...Dialogue: 0,0:17:33.11,0:17:36.07,Main,,0,0,0,,Now it makes sense.Dialogue: 0,0:17:38.50,0:17:41.53,Main,,0,0,0,,I see! That indeed is a sound argument!Dialogue: 0,0:17:41.53,0:17:47.08,Main,,0,0,0,,I mean, no one is stupid enough to think it's better with you around.Dialogue: 0,0:17:49.14,0:17:51.52,Main,,0,0,0,,Look at that symbol, you damn pirates!Dialogue: 0,0:17:54.52,0:17:58.23,Main,,0,0,0,,That logo symbolizes the unity of over 170 countries...Dialogue: 0,0:17:58.23,0:18:02.36,Main,,0,0,0,,spanning the four blues and the Grand Line.Dialogue: 0,0:18:02.36,0:18:04.69,Main,,0,0,0,,This is the world!Dialogue: 0,0:18:04.69,0:18:09.40,Main,,0,0,0,,Do you now realize how completely powerless your opposition is?!Dialogue: 0,0:18:10.41,0:18:15.86,Main,,0,0,0,,Do you realize how huge the organization chasing this woman is?!Dialogue: 0,0:18:16.31,0:18:19.32,Main,,0,0,0,,I know Robin's enemy now.Dialogue: 0,0:18:19.70,0:18:21.00,Main,,0,0,0,,Sogeking.Dialogue: 0,0:18:21.00,0:18:22.28,Main,,0,0,0,,Hm?Dialogue: 0,0:18:22.66,0:18:25.04,Main,,0,0,0,,Shoot down that flag.Dialogue: 0,0:18:25.04,0:18:26.62,Main,,0,0,0,,Roger.Dialogue: 0,0:18:26.62,0:18:27.44,Main,,0,0,0,,Huh?Dialogue: 0,0:18:28.41,0:18:31.88,Main,,0,0,0,,This is my new weapon, a huge slingshot I call Kabuto!Dialogue: 0,0:18:31.88,0:18:34.84,Main,,0,0,0,,Take a good look at its power!Dialogue: 0,0:18:34.84,0:18:37.92,Main,,0,0,0,,Lethal... Firebird Star!Dialogue: 0,0:18:46.98,0:18:47.98,Main,,0,0,0,,No way...!Dialogue: 0,0:18:51.41,0:18:52.80,Main,,0,0,0,,Mission accomplished.Dialogue: 0,0:18:56.53,0:18:58.32,Main,,0,0,0,,Th-They've gone and done it!Dialogue: 0,0:18:58.32,0:19:02.28,Main,,0,0,0,,Do they understand what it means to attack that flag?!Dialogue: 0,0:19:02.88,0:19:08.25,Main,,0,0,0,,The pirates declared war against the World Government!Dialogue: 0,0:19:08.63,0:19:11.86,Main,,0,0,0,,Are you insane?! Don't think that you'll be able to survive...Dialogue: 0,0:19:11.86,0:19:13.96,Main,,0,0,0,,after making the entire world your enemy!Dialogue: 0,0:19:13.96,0:19:18.84,Main,,0,0,0,,Bring it on!Dialogue: 0,0:19:28.78,0:19:30.38,Main,,0,0,0,,Robin!Dialogue: 0,0:19:31.69,0:19:34.36,Main,,0,0,0,,We still haven't heard you say it!Dialogue: 0,0:19:39.07,0:19:42.66,Main,,0,0,0,,Say you want to live!Dialogue: 0,0:19:45.80,0:19:46.91,Main,,0,0,0,,Robin...Dialogue: 0,0:19:51.54,0:19:52.72,Main,,0,0,0,,Robin!Dialogue: 0,0:19:54.88,0:19:56.96,Thoughts,,0,0,0,,To live...Dialogue: 0,0:19:56.96,0:20:01.19,Flashbacks,,0,0,0,,You shouldn't be allowed to live in this world, Robin!Dialogue: 0,0:20:01.19,0:20:05.09,Flashbacks,,0,0,0,,Your existence itself is a huge crime, Robin!Dialogue: 0,0:20:06.60,0:20:10.06,Thoughts,,0,0,0,,I thought it was something I dared not wish for.Dialogue: 0,0:20:12.60,0:20:16.02,Thoughts,,0,0,0,,No one ever let me wish for it.Dialogue: 0,0:20:16.37,0:20:18.73,Flashbacks,,0,0,0,,I want to die!Dialogue: 0,0:20:18.90,0:20:23.16,Flashbacks,,0,0,0,,The sea is vast, so someday...Dialogue: 0,0:20:23.16,0:20:27.12,Flashbacks,,0,0,0,,you'll find friends who'll protect you!Dialogue: 0,0:20:34.46,0:20:36.46,Flashbacks,,0,0,0,,Believe in Luffy.Dialogue: 0,0:20:38.68,0:20:43.55,Thoughts,,0,0,0,,If... it's really okay for me to utter my wish just once...Dialogue: 0,0:20:45.06,0:20:46.55,Thoughts,,0,0,0,,I...Dialogue: 0,0:20:49.10,0:20:51.56,Main,,0,0,0,,I want to live!Dialogue: 0,0:20:51.56,0:20:55.94,Main,,0,0,0,,Take me back to sea with you!Dialogue: 0,0:21:19.93,0:21:24.13,Main,,0,0,0,,You guys...! I love you guys, dammit!Dialogue: 0,0:21:25.89,0:21:26.88,Main,,0,0,0,,Let's go!Dialogue: 0,0:21:26.88,0:21:30.60,Credits,,0,0,0,,Editing: Feeso, Galaxy 9000  Timing: Galaxy 9000  Quality Assurance: Feeso, Galaxy 9000, Pepperjack, Sewil  Soundtracking: Halee  Title & Infoboxes: Datenshi  Karaoke: KaitouYahiko  Translation: Crunchyroll, GaijinDialogue: 0,0:00:00.33,0:00:02.37,Main,,0,0,0,,Wealth, fame, power...Dialogue: 0,0:00:02.37,0:00:04.17,Main,,0,0,0,,Gold Roger, the King of the Pirates,Dialogue: 0,0:00:04.17,0:00:06.17,Main,,0,0,0,,attained everything this world has to offer.Dialogue: 0,0:00:06.17,0:00:09.84,Main,,0,0,0,,The words he uttered just before his death drove people to the seas.Dialogue: 0,0:00:09.84,0:00:13.58,Main,,0,0,0,,My treasure? If you want it, you can have it!Dialogue: 0,0:00:13.58,0:00:17.37,Main,,0,0,0,,Find it! I left everything this world has to offer there!Dialogue: 0,0:00:19.75,0:00:24.49,Main,,0,0,0,,And so men head for the Grand Line in pursuit of their dreams!Dialogue: 0,0:00:24.49,0:00:27.82,Main,,0,0,0,,The world has truly entered a Great Pirate Era!Dialogue: 1,0:00:28.18,0:00:28.63,Lyrics,,0,0,0,fx,Dialogue: 2,0:00:28.63,0:00:28.88,Lyrics,,0,0,0,fx,Dialogue: 1,0:00:28.23,0:00:28.63,Lyrics,,0,0,0,fx,Dialogue: 2,0:00:28.63,0:00:33.47,Lyrics,,0,0,0,fx,Dialogue: 1,0:00:28.28,0:00:33.22,Lyrics,,0,0,0,fx,We'Dialogue: 2,0:00:33.22,0:00:33.52,Lyrics,,0,0,0,fx,We'Dialogue: 1,0:00:28.33,0:00:33.27,Lyrics,,0,0,0,fx,re goDialogue: 2,0:00:33.27,0:00:33.57,Lyrics,,0,0,0,fx,re goDialogue: 1,0:00:28.38,0:00:33.32,Lyrics,,0,0,0,fx,ingDialogue: 2,0:00:33.32,0:00:33.62,Lyrics,,0,0,0,fx,ingDialogue: 1,0:00:28.43,0:00:33.37,Lyrics,,0,0,0,fx, toDialogue: 2,0:00:33.37,0:00:33.67,Lyrics,,0,0,0,fx, toDialogue: 1,0:00:28.48,0:00:33.42,Lyrics,,0,0,0,fx, gaDialogue: 2,0:00:33.42,0:00:33.72,Lyrics,,0,0,0,fx, gaDialogue: 1,0:00:28.53,0:00:33.47,Lyrics,,0,0,0,fx,thDialogue: 2,0:00:33.47,0:00:33.77,Lyrics,,0,0,0,fx,thDialogue: 1,0:00:28.58,0:00:33.52,Lyrics,,0,0,0,fx,erDialogue: 2,0:00:33.52,0:00:33.82,Lyrics,,0,0,0,fx,erDialogue: 1,0:00:28.63,0:00:33.57,Lyrics,,0