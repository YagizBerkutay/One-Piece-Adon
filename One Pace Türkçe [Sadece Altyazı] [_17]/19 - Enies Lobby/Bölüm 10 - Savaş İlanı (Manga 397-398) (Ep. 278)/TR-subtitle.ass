,20,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1,1,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:01:57.24,0:02:07.24,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:10:53.30,0:11:03.30,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:21:19.00,0:21:29.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:01:50.98,0:01:52.77,Flashbacks,,0,0,0,,Yapma, Saul!Dialogue: 0,0:01:52.77,0:01:54.19,Flashbacks,,0,0,0,,Hazır olun!Dialogue: 0,0:01:54.19,0:01:58.70,Flashbacks,,0,0,0,,Beni düşman edinince o kadar kolay kaçamazsınız!Dialogue: 0,0:01:57.24,0:02:01.30,Title,,0,0,250,,Savaş İlanıDialogue: 0,0:02:10.75,0:02:12.17,Main,,0,0,0,,Neler oluyor?!Dialogue: 0,0:02:12.17,0:02:13.94,Main,,0,0,0,,Bu, Koramiral Saulo!Dialogue: 0,0:02:13.94,0:02:19.45,Main,,0,0,0,,Nico Olvia'yla birlikte kaçan Koramiral Saulo,  bize saldırıyor!Dialogue: 0,0:02:19.84,0:02:21.34,Main,,0,0,0,,O niye burada?Dialogue: 0,0:02:21.34,0:02:23.41,Main,,0,0,0,,Bilmiyorum!Dialogue: 0,0:02:26.43,0:02:28.22,Main,,0,0,0,,Adanın işi bitti!Dialogue: 0,0:02:28.22,0:02:29.96,Main,,0,0,0,,Her şey küle dönecek!Dialogue: 0,0:02:29.96,0:02:34.29,Main,,0,0,0,,Pes etmeyin! Geride kitap bırakmayın! Tarihi aktarmalıyız!Dialogue: 0,0:02:35.61,0:02:37.44,Main,,0,0,0,,Onları pencereden göle atın!Dialogue: 0,0:02:37.44,0:02:40.17,Main,,0,0,0,,Yanmalarından daha iyi! Çabuk!Dialogue: 0,0:02:43.20,0:02:44.41,Main,,0,0,0,,Şimdi!Dialogue: 0,0:02:48.10,0:02:51.56,Main,,0,0,0,,Saul, yeter artık! Öleceksin!Dialogue: 0,0:02:51.56,0:02:54.52,Main,,0,0,0,,Kitapları kütüphanenin dışına atın!Dialogue: 0,0:02:54.52,0:02:56.25,Main,,0,0,0,,Hiçbir kitabın,...Dialogue: 0,0:02:56.25,0:02:59.28,Main,,0,0,0,,...tek bir cümlenin bile kaybolmasına izin vermeyin!Dialogue: 0,0:03:00.26,0:03:03.51,Main,,0,0,0,,Demek son birkaç bin yıllık atalarımızdan kalma sözler,...Dialogue: 0,0:03:03.51,0:03:05.83,Main,,0,0,0,,...geleceğe ulaşabilir!Dialogue: 0,0:03:09.24,0:03:11.48,Main,,0,0,0,,Robin! Ne yapıyorsun?Dialogue: 0,0:03:11.48,0:03:13.96,Main,,0,0,0,,Hala yapabiliyorken tahliye gemisine git!Dialogue: 0,0:03:13.96,0:03:17.29,Main,,0,0,0,,Bu adada kalırsan, daha fazla yaşayamazsın!Dialogue: 0,0:03:51.40,0:03:53.83,Main,,0,0,0,,Anne!Dialogue: 0,0:03:58.71,0:04:00.53,Main,,0,0,0,,Saulo'yu vurun!Dialogue: 0,0:04:01.67,0:04:07.14,Main,,0,0,0,,Robin! Hemen kaç! Annenin isteği neydi?!Dialogue: 0,0:04:07.14,0:04:09.71,Flashbacks,,0,0,0,,YAŞAMALISIN, ROBIN!Dialogue: 0,0:04:10.93,0:04:13.35,Main,,0,0,0,,Tahliye gemisi gidiyor!Dialogue: 0,0:04:13.35,0:04:15.60,Main,,0,0,0,,Durun, biri geliyor!Dialogue: 0,0:04:16.05,0:04:17.02,Main,,0,0,0,,O...Dialogue: 0,0:04:18.02,0:04:20.22,Main,,0,0,0,,O, canavar değil mi?Dialogue: 0,0:04:20.22,0:04:21.44,Main,,0,0,0,,Evet!Dialogue: 0,0:04:21.44,0:04:23.06,Main,,0,0,0,,Defol, canavar!Dialogue: 0,0:04:23.06,0:04:25.00,Main,,0,0,0,,Hey, aptallaşmayın!Dialogue: 0,0:04:25.00,0:04:26.39,Main,,0,0,0,,Hayır, durun.Dialogue: 0,0:04:26.39,0:04:31.45,Main,,0,0,0,,O kız daha önce gazetede çıkan suçlu Olvia'nın kızı değil mi?Dialogue: 0,0:04:31.45,0:04:35.50,Main,,0,0,0,,Evet! Gemiye binmesine izin verirsek, biz de hedef haline geliriz!Dialogue: 0,0:04:35.50,0:04:38.83,Main,,0,0,0,,Aptallaşma!  O sadece bir çocuk, hemen çekin onu!Dialogue: 0,0:04:38.83,0:04:42.00,Main,,0,0,0,,Tahliye gemisi, o veledin binmesine izin vermeyin!Dialogue: 0,0:04:42.00,0:04:43.05,Main,,0,0,0,,Ne?Dialogue: 0,0:04:43.05,0:04:45.76,Main,,0,0,0,,Çocuk olsa bile, o bir arkeolog!Dialogue: 0,0:04:45.76,0:04:48.05,Main,,0,0,0,,Bu saldırının hedeflerinden biri!Dialogue: 0,0:04:48.05,0:04:51.41,Main,,0,0,0,,Şef Spandine! Bu doğru mu?Dialogue: 0,0:04:51.41,0:04:54.39,Main,,0,0,0,,Bakın! Bununla biz de tehlikede oluruz!Dialogue: 0,0:04:54.39,0:04:56.38,Main,,0,0,0,,Robin!Dialogue: 0,0:04:56.38,0:04:59.39,Main,,0,0,0,,CP9, ha? Ne kadar aptalca!Dialogue: 0,0:04:59.39,0:05:02.53,Main,,0,0,0,,Şef! Koramiral Saulo, bize doğru geliyor!Dialogue: 0,0:05:02.53,0:05:06.34,Main,,0,0,0,,Gerçekten mi?! Ona Olvia'nın yerini bile söyletememiştik!Dialogue: 0,0:05:06.34,0:05:08.90,Main,,0,0,0,,Ateş, ateş! Saldırın ona!Dialogue: 0,0:05:11.30,0:05:12.69,Main,,0,0,0,,Buz Blok!Dialogue: 0,0:05:13.23,0:05:14.11,Main,,0,0,0,,Ortaçağ Mızrağı!Dialogue: 0,0:05:17.75,0:05:19.03,Main,,0,0,0,,Saul!Dialogue: 0,0:05:27.51,0:05:28.84,Main,,0,0,0,,Kuzan-san!Dialogue: 0,0:05:29.61,0:05:30.96,Main,,0,0,0,,Kuzan...!Dialogue: 0,0:05:30.96,0:05:32.45,Main,,0,0,0,,Hey, hey.Dialogue: 0,0:05:32.45,0:05:36.34,Main,,0,0,0,,Yıkım Çağrısı, bir şekilde eski bir Denizci tarafından engellenseydi,...Dialogue: 0,0:05:36.36,0:05:38.38,Main,,0,0,0,,...epey gülünç duruma düşmez miydik?Dialogue: 0,0:05:38.38,0:05:40.35,Main,,0,0,0,,Kuzan!Dialogue: 0,0:05:40.35,0:05:44.06,Main,,0,0,0,,...bu bombardımandan gurur duyuyor musun?Dialogue: 0,0:05:44.06,0:05:45.61,Main,,0,0,0,,Aklını başına topla!Dialogue: 0,0:05:45.61,0:05:48.86,Main,,0,0,0,,Bu doğru değil! Bunu biliyorsun!Dialogue: 0,0:05:48.86,0:05:50.37,Main,,0,0,0,,Uyarı olsun diye...!Dialogue: 0,0:05:50.37,0:05:53.66,Main,,0,0,0,,Sırf bu nedenden Ohara'yı yok edecekler!Dialogue: 0,0:05:53.66,0:05:57.39,Main,,0,0,0,,Dünyanın iyiliği içinse, yapacak bir şey yok.Dialogue: 0,0:05:57.39,0:06:00.62,Main,,0,0,0,,Bilginler, kanuna aykırı davranmıyor mu?Dialogue: 0,0:06:00.62,0:06:04.58,Main,,0,0,0,,Adalet denen şey,  durduğun yere göre şekil değiştirir.Dialogue: 0,0:06:04.58,0:06:07.70,Main,,0,0,0,,Bu yüzden adaletini suçlamayacağım.Dialogue: 0,0:06:07.70,0:06:12.75,Main,,0,0,0,,Ama yolumuza çıkacaksan, görmezden gelmeyeceğim.Dialogue: 0,0:06:20.89,0:06:23.93,Main,,0,0,0,,Ah! Tahliye gemisi havaya uçtu!Dialogue: 0,0:06:23.93,0:06:25.98,Main,,0,0,0,,N-Niye?Dialogue: 0,0:06:25.98,0:06:27.98,Main,,0,0,0,,Bombardımandı! Denizci gemisinden geldi!Dialogue: 0,0:06:27.98,0:06:31.03,Main,,0,0,0,,Koramiral Sakazuki'nin gemisinden!Dialogue: 0,0:06:27.98,0:06:31.03,Captions,,0,0,285,,Koramiral Sakazuki Donanma Karârgahı (Daha Sonra Amiral Akainu Olacak) Dialogue: 0,0:06:31.49,0:06:33.24,Main,,0,0,0,,Ahmak....!Dialogue: 0,0:06:33.24,0:06:37.09,Main,,0,0,0,,Bu işi yapıyorsak, esaslı bir şekilde yapmalıyız.Dialogue: 0,0:06:37.09,0:06:40.04,Main,,0,0,0,,Tek bir bilgin bile o gemide saklanıyor olsaydı,...Dialogue: 0,0:06:40.04,0:06:42.54,Main,,0,0,0,,...bugün verilen her kurban boşa olurdu.Dialogue: 0,0:06:43.50,0:06:47.37,Main,,0,0,0,,Kötülük tamamiyle kökünden sökülmeli!Dialogue: 0,0:06:47.37,0:06:52.09,Main,,0,0,0,,Bu, adaletin işleri yürütme şekli mi?! Bunun ardından hala gurur duyabilir misin?!Dialogue: 0,0:06:52.09,0:06:54.84,Main,,0,0,0,,O su katılmamış aptal gibi abartmak niyetinde değildim!Dialogue: 0,0:06:55.56,0:06:57.10,Main,,0,0,0,,Kaç, Robin!Dialogue: 0,0:06:57.10,0:06:59.77,Main,,0,0,0,,Onun gücü anormal!Dialogue: 0,0:06:59.77,0:07:01.31,Main,,0,0,0,,Saul kaçtı!Dialogue: 0,0:07:01.31,0:07:03.68,Main,,0,0,0,,Bir bilgin taşıyor!Dialogue: 0,0:07:06.19,0:07:08.51,Main,,0,0,0,,Buz Vakti Kapsülü!Dialogue: 0,0:07:12.86,0:07:14.53,Main,,0,0,0,,Saul, iyi misin?!Dialogue: 0,0:07:16.95,0:07:19.15,Main,,0,0,0,,Robin, kaç.Dialogue: 0,0:07:24.08,0:07:26.17,Main,,0,0,0,,Koşabildiğin kadar hızlı koş!Dialogue: 0,0:07:26.17,0:07:30.59,Main,,0,0,0,,Adada kalırsan, kesinlikle canından olursun! Salımla denize açıl!Dialogue: 0,0:07:30.59,0:07:31.88,Main,,0,0,0,,Ya sen, Saul?Dialogue: 0,0:07:31.88,0:07:35.86,Main,,0,0,0,,Benim sonum geldi. Yakalandım!Dialogue: 0,0:07:36.71,0:07:37.76,Main,,0,0,0,,Git!Dialogue: 0,0:07:37.76,0:07:40.39,Main,,0,0,0,,Hayır! Denizde hiç kimse yok!Dialogue: 0,0:07:40.39,0:07:42.43,Main,,0,0,0,,İyi dinle, Robin!Dialogue: 0,0:07:43.43,0:07:48.69,Main,,0,0,0,,Şu anda yalnız olabilirsin ama  bir gün kesinlikle arkadaş bulacaksın!Dialogue: 0,0:07:52.10,0:07:53.36,Main,,0,0,0,,Arkadaş?Dialogue: 0,0:07:53.36,0:07:59.07,Main,,0,0,0,,Evet. Deniz engindir. Hiç şüphesiz bir gün,...Dialogue: 0,0:07:59.07,0:08:02.33,Main,,0,0,0,,...seni koruyacak arkadaşların olacaktır!Dialogue: 0,0:08:02.33,0:08:07.62,Main,,0,0,0,,Dünyadaki hiç kimse  tamamen yalnız olarak doğmaz!Dialogue: 0,0:08:10.13,0:08:13.63,Main,,0,0,0,,Koş, Robin! Arkana bakmadan koş!Dialogue: 0,0:08:13.63,0:08:17.89,Main,,0,0,0,,İşler zorlaştığında, sana öğrettiğim gibi yap! Bu şekilde gül!Dialogue: 0,0:08:17.89,0:08:19.56,Main,,0,0,0,,Saul, dikkat et!Dialogue: 0,0:08:22.52,0:08:24.23,Main,,0,0,0,,Ice Time.Dialogue: 0,0:08:26.52,0:08:27.77,Main,,0,0,0,,Saul!Dialogue: 0,0:08:29.23,0:08:32.74,Thoughts,,0,0,0,,Denizde bir yerde kesinlikle seni beklemekte olan arkadaşlarınla...Dialogue: 0,0:08:32.74,0:08:35.20,Thoughts,,0,0,0,,...buluş, Robin! Dialogue: 0,0:08:39.07,0:08:42.12,Thoughts,,0,0,0,,Onlarla birlikte yaşa.Dialogue: 0,0:08:56.23,0:08:57.38,Main,,0,0,0,,İşe yaramaz artık!Dialogue: 0,0:08:57.38,0:09:01.06,Thoughts,,0,0,0,,Bu, insanlık tarafından seçilmiş tarih mi?Dialogue: 0,0:09:01.70,0:09:04.98,Thoughts,,0,0,0,,İnsanlar ne kadar kırılgan şeyler.Dialogue: 0,0:09:05.56,0:09:07.94,Thoughts,,0,0,0,,Üzgünüm, Robin.Dialogue: 0,0:09:10.23,0:09:12.57,Thoughts,,0,0,0,,Bir anneye yakışan sözleri bile...Dialogue: 0,0:09:14.97,0:09:17.07,Thoughts,,0,0,0,,...söyleyemeden senden ayrıldım.Dialogue: 0,0:09:17.46,0:09:20.76,Main,,0,0,0,,Her Şeyi Bilen Ağaç, devriliyor!Dialogue: 0,0:09:28.80,0:09:33.21,Main,,0,0,0,,Mutlak Adalet. Bazen bir kimseyi deliliğe ittiği biliniyordu.Dialogue: 0,0:09:33.59,0:09:36.63,Main,,0,0,0,,Bu adadan kaçmana izin vermeye karar verdim.Dialogue: 0,0:09:36.63,0:09:40.64,Main,,0,0,0,,Saul tarafından korunan bir tohumun neye dönüşeceğini merak ediyorum.Dialogue: 0,0:09:40.64,0:09:44.01,Main,,0,0,0,,İstediğin kişiden nefret etmek senin seçimin.Dialogue: 0,0:09:44.01,0:09:47.60,Main,,0,0,0,,Ama hala yaşıyor olduğun için kendini şanslı say.Dialogue: 0,0:09:47.60,0:09:49.81,Main,,0,0,0,,En sade şekilde yaşamaya çalış.Dialogue: 0,0:09:50.55,0:09:53.15,Main,,0,0,0,,Denizde bir buz hattı bıraktım.Dialogue: 0,0:09:53.15,0:09:57.57,Main,,0,0,0,,Bu küçük kayıkla dümdüz devam et. Karaya ulaşacaksın.Dialogue: 0,0:09:57.57,0:10:00.02,Main,,0,0,0,,Hiçbir zaman unutma.Dialogue: 0,0:10:01.97,0:10:03.70,Main,,0,0,0,,Ben dostun değilim.Dialogue: 0,0:10:04.12,0:10:08.29,Main,,0,0,0,,Bir şey yaparsan, seni yakalamaya gelecek ilk düşman ben olacağım.Dialogue: 0,0:10:09.52,0:10:11.38,Main,,0,0,0,,Annem adada!Dialogue: 0,0:10:11.38,0:10:13.79,Main,,0,0,0,,Hiç kimse kurtarılmayacak.Dialogue: 0,0:10:13.79,0:10:17.20,Main,,0,0,0,,Eğer o acı sana ölümü diliyorsa,  o yolu da seçmekte özgürsün.Dialogue: 0,0:10:18.55,0:10:21.05,Flashbacks,,0,0,0,,Burası dünyanın en büyük kütüphanesi.Dialogue: 0,0:10:22.09,0:10:23.56,Flashbacks,,0,0,0,,Kitapları sever misin?Dialogue: 0,0:10:23.56,0:10:26.35,Flashbacks,,0,0,0,,Bugün Robin'in doğum günü!Dialogue: 0,0:10:26.35,0:10:29.44,Flashbacks,,0,0,0,,Doğum günün kutlu olsun, Robin!Dialogue: 0,0:10:29.44,0:10:33.02,Flashbacks,,0,0,0,,Gurur duy, Robin! Ohara, harika bir yer!Dialogue: 0,0:10:33.48,0:10:38.57,Flashbacks,,0,0,0,,Sizin yaşayacağınız gelecekten vazgeçemeyiz!Dialogue: 0,0:10:39.02,0:10:42.95,Flashbacks,,0,0,0,,Sadece gül. Sıkıntılı zamanlar geçirdiğinde, sadece gül.Dialogue: 0,0:10:43.45,0:10:45.96,Flashbacks,,0,0,0,,Acı çekerken gülersem, aptal gibi görünürüm.Dialogue: 0,0:10:45.96,0:10:47.92,Flashbacks,,0,0,0,,Hiç de bile!Dialogue: 0,0:11:41.01,0:11:46.06,Flashbacks,,0,0,0,,Kesinlikle denizde bir yerde seni beklemekte olan arkadaşlarınla buluş, Robin!Dialogue: 0,0:12:04.08,0:12:05.85,Main,,0,0,0,,Hayatta kalan var mı?Dialogue: 0,0:12:05.85,0:12:07.27,Main,,0,0,0,,Olması mümkün değil.Dialogue: 0,0:12:07.98,0:12:09.64,Main,,0,0,0,,Hey!Dialogue: 0,0:12:09.64,0:12:11.25,Main,,0,0,0,,Şu göle bakın.Dialogue: 0,0:12:12.58,0:12:14.21,Main,,0,0,0,,B-Bu...Dialogue: 0,0:12:20.10,0:12:22.72,Main,,0,0,0,,Gölü dolduracak kadar kitap var!Dialogue: 0,0:12:22.72,0:12:24.59,Main,,0,0,0,,Tesadüf mü bu?!Dialogue: 0,0:12:24.98,0:12:28.96,Main,,0,0,0,,Oh, bu o! Kesinlikle o!Dialogue: 0,0:12:28.96,0:12:30.96,Main,,0,0,0,,Neredeydi? Yakaladınız mı?Dialogue: 0,0:12:30.96,0:12:33.93,Main,,0,0,0,,Hayır! Tek ipucumuz olarak şüpheli küçük bir kızı ararken,...Dialogue: 0,0:12:33.93,0:12:36.87,Main,,0,0,0,,...Ohara'nın kuzeydoğusundaki bir adadan...Dialogue: 0,0:12:36.87,0:12:39.14,Main,,0,0,0,,...yolcu gemisiyle ayrıldığında onu tespit ettik.Dialogue: 0,0:12:39.14,0:12:40.90,Main,,0,0,0,,Ancak hemen gözden kayboldu.Dialogue: 0,0:12:42.02,0:12:44.07,Main,,0,0,0,,Bu kızda şeytan tüyü var.Dialogue: 0,0:12:44.07,0:12:52.00,Main,,0,0,0,,O sırada kızın bir kayıkla Ohara'yı  yutan alevlerden kaçmakta olduğunu gördüm!Dialogue: 0,0:12:52.62,0:12:57.78,Main,,0,0,0,,Ama peşinden gitmeye çalıştığımda, dümen buza takılmış gibi aniden durdu.Dialogue: 0,0:12:57.78,0:13:01.13,Main,,0,0,0,,Saul'un ölmeden önce  onun kaçmasını sağladığına şüphe yok!Dialogue: 0,0:13:02.72,0:13:05.56,Main,,0,0,0,,Küçük olsa da varlığı tehlikeli.Dialogue: 0,0:13:05.56,0:13:08.51,Main,,0,0,0,,Özellikle de Poneglifleri deşifre edebildiği için.Dialogue: 0,0:13:09.14,0:13:12.69,Main,,0,0,0,,Nasıl yapacağınız umrumda değil.  Onu bir an önce yakalamazsak...Dialogue: 0,0:13:12.69,0:13:15.48,Main,,0,0,0,,...bu operasyon boşa gidecek.Dialogue: 0,0:13:19.81,0:13:21.57,Main,,0,0,0,,79 milyon beli?!Dialogue: 0,0:13:21.57,0:13:24.65,Main,,0,0,0,,Sekiz yaşındaki bir kızın bu kadar büyük ödülü mü var?Dialogue: 0,0:13:24.65,0:13:27.62,Main,,0,0,0,,Görünüşe göre, dünyayı yok etmeyi planlayan...Dialogue: 0,0:13:27.62,0:13:29.91,Main,,0,0,0,,...Ohara suçlularından hayatta kalan tek kişi.Dialogue: 0,0:13:29.91,0:13:31.67,Main,,0,0,0,,Şu Ohara mı?!Dialogue: 0,0:13:31.67,0:13:36.55,Main,,0,0,0,,Nasıl yaptığını bilmiyorum ama  altı Denizci savaş gemisini batırdığını duydum.Dialogue: 0,0:13:36.55,0:13:39.01,Main,,0,0,0,,Bu yüzden bu kadar büyük ödül koymuşlar.Dialogue: 0,0:13:39.01,0:13:42.38,Main,,0,0,0,,Hükümet'in ve Denizci Karargâh'ının doğrudan bu konu üstünde çalıştığını duydum!Dialogue: 0,0:13:42.71,0:13:46.73,Main,,0,0,0,,İnfaz edilen bilginlerin fikirleri ona geçmiş.Dialogue: 0,0:13:46.73,0:13:48.73,Main,,0,0,0,,Taşkınlık yapmasına izin veremeyiz.Dialogue: 0,0:13:48.73,0:13:52.81,Main,,0,0,0,,O veledin yaşamasına izin verilemez.  Şeytanın çocuğu o!Dialogue: 0,0:13:54.03,0:13:56.73,Main,,0,0,0,,Yardımın için her zaman minnettarım.Dialogue: 0,0:13:56.73,0:13:59.90,Main,,0,0,0,,Hayır, çalışmama izin verdiğiniz için sağolun.Dialogue: 0,0:13:59.90,0:14:04.61,Main,,0,0,0,,Bu arada, akşam yemeğinden önce senin için birkaç misafirimiz var.Dialogue: 0,0:14:05.82,0:14:07.15,Main,,0,0,0,,Kaçmasına izin vermeyin!Dialogue: 0,0:14:07.15,0:14:11.12,Main,,0,0,0,,Tamam, bana paramı verin! Nerede olduğunu size söyledim, değil mi?!Dialogue: 0,0:14:11.60,0:14:14.58,Main,,0,0,0,,Küçük olmasına rağmen çok çalışıyor.Dialogue: 0,0:14:16.61,0:14:19.17,Main,,0,0,0,,Ne oldu? Hala uyanık mısın?Dialogue: 0,0:14:19.17,0:14:21.12,Main,,0,0,0,,Ayak işlerini yapmak için yarın erken kalkmalısın.Dialogue: 0,0:14:21.12,0:14:22.28,Main,,0,0,0,,Bir an evvel uyu.Dialogue: 0,0:14:22.28,0:14:23.30,Main,,0,0,0,,Tamam.Dialogue: 0,0:14:23.89,0:14:27.26,Main,,0,0,0,,İyi bir kız ama yanımızda kalırsa biz de tehlikeye düşeriz!Dialogue: 0,0:14:27.66,0:14:30.22,Main,,0,0,0,,Üstelik şu ödüle bak!Dialogue: 0,0:14:31.37,0:14:33.68,Main,,0,0,0,,Tatlım! Odasında değil!Dialogue: 0,0:14:33.68,0:14:36.93,Main,,0,0,0,,Kahretsin! Şu velet konuşmamızı duymuş olmalı!Dialogue: 0,0:14:43.22,0:14:45.94,Main,,0,0,0,,Üzgünüm. Hiç yiyeceğim yok.Dialogue: 0,0:14:51.83,0:14:55.12,Main,,0,0,0,,Seni tanıyorum, Nico Robin!Dialogue: 0,0:14:55.37,0:14:57.70,Main,,0,0,0,,Ben de aranan bir adamım.Dialogue: 0,0:14:58.18,0:15:00.96,Main,,0,0,0,,Benim için birkaç küçük iş yaparsan, sana bakarım.Dialogue: 0,0:15:03.60,0:15:05.68,Main,,0,0,0,,– Kaptan! – Bu, Denizci Karargâh'ı!!Dialogue: 0,0:15:05.68,0:15:09.56,Main,,0,0,0,,Robin nerede?! Onu teslim edelim!Dialogue: 0,0:15:09.56,0:15:11.34,Main,,0,0,0,,Kahretsin! O velet lanetli!Dialogue: 0,0:15:14.65,0:15:16.77,Flashbacks,,0,0,0,,Günahın hayatta olmak!Dialogue: 0,0:15:17.90,0:15:20.48,Flashbacks,,0,0,0,,Ne? Nico Robin bu şehirde mi?!Dialogue: 0,0:15:20.82,0:15:23.50,Flashbacks,,0,0,0,,Bulun onu! Hükümet'e teslim edin!Dialogue: 0,0:15:27.65,0:15:30.92,Main,,0,0,0,,Buldum. Bu bir Poneglif.Dialogue: 0,0:15:30.92,0:15:34.42,Main,,0,0,0,,İçeri gelme! Sana satacak bir şeyim yok!Dialogue: 0,0:15:35.22,0:15:39.91,Main,,0,0,0,,On altı yaşındayım. Ne olursa yaparım. Bu örgüte girmeme izin verin.Dialogue: 0,0:15:39.91,0:15:42.87,Flashbacks,,0,0,0,,Bana ihanet ettin, Robin!Dialogue: 0,0:15:43.47,0:15:47.17,Main,,0,0,0,,Nico Robin, gücünü ödünç almak istiyorum.Dialogue: 0,0:15:49.34,0:15:52.33,Main,,0,0,0,,Poneglifleri okuyabildiğini duydum.Dialogue: 0,0:15:55.73,0:16:00.33,Main,,0,0,0,,Şimdi, burada Yıkım Çağrısı'nı tetiklersen,...Dialogue: 0,0:16:01.28,0:16:03.42,Main,,0,0,0,,...Enies Lobby yok edilecek.Dialogue: 0,0:16:07.28,0:16:10.36,Main,,0,0,0,,Buna siz de dahilsiniz.Dialogue: 0,0:16:10.36,0:16:12.57,Main,,0,0,0,,N-neler saçmalıyorsun sen?!Dialogue: 0,0:16:13.00,0:16:15.64,Main,,0,0,0,,Dost bir saldırı bizi yaralar mı sanki?!Dialogue: 0,0:16:15.64,0:16:18.00,Main,,0,0,0,,Neler saçmalıyorsun, seni sürtük?!Dialogue: 0,0:16:18.00,0:16:21.41,Main,,0,0,0,,Yirmi yıl önce bir sürü insanın hayatını mahvederken,...Dialogue: 0,0:16:22.11,0:16:25.13,Main,,0,0,0,,...benden her şeyimi çaldı.Dialogue: 0,0:16:25.57,0:16:29.25,Main,,0,0,0,,Tek bir vuruşla, Yıkım Çağrısı.Dialogue: 0,0:16:29.96,0:16:31.55,Main,,0,0,0,,Bu saldırı...Dialogue: 0,0:16:31.55,0:16:35.97,Main,,0,0,0,,...nihayet ortaya çıktı. Sevdiğim arkadaşlarıma doğrultuldu.Dialogue: 0,0:16:35.97,0:16:39.48,Main,,0,0,0,,Yanınızda olmayı daha fazla istedikçe,...Dialogue: 0,0:16:39.48,0:16:43.32,Main,,0,0,0,,...kaderim dişlerini size daha çok gösteriyor!Dialogue: 0,0:16:43.32,0:16:46.09,Main,,0,0,0,,Denizdeki yolculuğuma ne kadar devam edersem edeyim,...Dialogue: 0,0:16:46.09,0:16:49.11,Main,,0,0,0,,...yine de sarsamayacağım o devasa düşman var!Dialogue: 0,0:16:49.51,0:16:54.07,Main,,0,0,0,,Çünkü düşmanım, dünya ve onun karanlığı!Dialogue: 0,0:16:54.07,0:16:57.49,Main,,0,0,0,,Hem Aokiji olayında, hem de bu kez...Dialogue: 0,0:16:57.49,0:17:00.04,Main,,0,0,0,,...sizi bu işe iki kez karıştırdım!Dialogue: 0,0:17:01.00,0:17:05.00,Main,,0,0,0,,Sonsuza dek böyle devam ederse, ne kadar iyi kimseler olursanız olun...Dialogue: 0,0:17:07.00,0:17:09.39,Main,,0,0,0,,...bir gün beni yük olarak göreceksiniz!Dialogue: 0,0:17:09.39,0:17:12.56,Main,,0,0,0,,Bir gün bana ihanet edeceğiniz ve beni bir kenara atacağınız belli!Dialogue: 0,0:17:12.56,0:17:14.77,Main,,0,0,0,,Beni en çok korkutan bu!Dialogue: 0,0:17:14.77,0:17:17.90,Main,,0,0,0,,Bu yüzden beni kurtarmaya gelmenizi istemedim!Dialogue: 0,0:17:17.90,0:17:19.72,Main,,0,0,0,,Bu canı bir gün yitireceksem,...Dialogue: 0,0:17:19.72,0:17:23.18,Main,,0,0,0,,...burada ölmek istiyorum!Dialogue: 0,0:17:27.11,0:17:28.38,Main,,0,0,0,,Robin...Dialogue: 0,0:17:28.38,0:17:30.11,Main,,0,0,0,,Robin-chan...Dialogue: 0,0:17:31.04,0:17:32.19,Main,,0,0,0,,Robin...Dialogue: 0,0:17:33.11,0:17:36.07,Main,,0,0,0,,Demek öyleydi.Dialogue: 0,0:17:38.50,0:17:41.53,Main,,0,0,0,,Şimdi anlıyorum! Tam isabet!Dialogue: 0,0:17:41.53,0:17:47.08,Main,,0,0,0,,Seninle yolculuk ettikten sonra yük olmadığını düşünecek kadar aptal kimse yok!Dialogue: 0,0:17:49.14,0:17:51.52,Main,,0,0,0,,Şu bayrağa bakın, korsan bozmaları!Dialogue: 0,0:17:54.52,0:17:58.23,Main,,0,0,0,,O işaret, dört denizi ve Grand Line'ı noktalayarak,...Dialogue: 0,0:17:58.23,0:18:02.36,Main,,0,0,0,,...170'den fazla ülkenin birliğini temsil ediyor.Dialogue: 0,0:18:02.36,0:18:04.69,Main,,0,0,0,,Bu, dünya!Dialogue: 0,0:18:04.69,0:18:09.40,Main,,0,0,0,,Bununla karşılaştırıldığında varlığınızın ne kadar önemsiz olduğunu anlıyor musunuz?Dialogue: 0,0:18:10.41,0:18:15.86,Main,,0,0,0,,Bu kadının peşindeki organizasyonun ne kadar güçlü olduğunu anlıyor musunuz?!Dialogue: 0,0:18:16.31,0:18:19.32,Main,,0,0,0,,Robin'in düşmanını çok iyi anlıyorum.Dialogue: 0,0:18:19.70,0:18:21.00,Main,,0,0,0,,Sogeking.Dialogue: 0,0:18:22.66,0:18:25.04,Main,,0,0,0,,O bayrağı alevlere boğ.Dialogue: 0,0:18:25.04,0:18:26.62,Main,,0,0,0,,Anlaşıldı.Dialogue: 0,0:18:28.41,0:18:31.88,Main,,0,0,0,,Yeni silahım, Büyük Pachinko. Kabuto adıyla anılıyor!Dialogue: 0,0:18:31.88,0:18:34.84,Main,,0,0,0,,Muazzam gücünü yakından seyredin!Dialogue: 0,0:18:34.84,0:18:37.92,Main,,0,0,0,,Kesin Öldürücü Ateş Kuşu Yıldızı!Dialogue: 0,0:18:46.98,0:18:47.98,Main,,0,0,0,,Olamaz...!Dialogue: 0,0:18:51.41,0:18:52.80,Main,,0,0,0,,Tamamdır.Dialogue: 0,0:18:56.53,0:18:58.32,Main,,0,0,0,,Şimdi yaptılar işte!Dialogue: 0,0:18:58.32,0:19:02.28,Main,,0,0,0,,Bu adamlar  bayrağa ateş etmenin anlamını biliyorlar mı?Dialogue: 0,0:19:02.88,0:19:08.25,Main,,0,0,0,,Korsanlar, Dünya Hükümeti'ne savaş ilan ettiler!Dialogue: 0,0:19:08.63,0:19:11.86,Main,,0,0,0,,Aklınızı mı kaçırdınız siz?!  Dünyayı kendinize düşman edince...Dialogue: 0,0:19:11.86,0:19:13.96,Main,,0,0,0,,...hayatta kalabileceğinizi sanmayın!Dialogue: 0,0:19:13.96,0:19:18.84,Main,,0,0,0,,BAHSE VAR MISIN?!Dialogue: 0,0:19:28.78,0:19:30.38,Main,,0,0,0,,Robin!Dialogue: 0,0:19:31.69,0:19:34.36,Main,,0,0,0,,Hala senin ağzından duymadım!Dialogue: 0,0:19:39.07,0:19:42.66,Main,,0,0,0,,YAŞAMAK İSTEDİĞİNİ SÖYLE!Dialogue: 0,0:19:45.80,0:19:46.91,Main,,0,0,0,,Robin...Dialogue: 0,0:19:51.54,0:19:52.72,Main,,0,0,0,,Robin!Dialogue: 0,0:19:54.88,0:19:56.96,Thoughts,,0,0,0,,Yaşamak...Dialogue: 0,0:19:56.96,0:20:01.19,Flashbacks,,0,0,0,,Bu dünyada yaşamana izin verilemez, Robin.Dialogue: 0,0:20:01.19,0:20:05.09,Flashbacks,,0,0,0,,Varlığının kendisi affedilemez bir günah, Robin!Dialogue: 0,0:20:06.60,0:20:10.06,Thoughts,,0,0,0,,Bunu istemenin yasak olduğunu düşünmüştüm.Dialogue: 0,0:20:12.60,0:20:16.02,Thoughts,,0,0,0,,Kimse bunu söylememe izin vermezdi.Dialogue: 0,0:20:16.37,0:20:18.73,Flashbacks,,0,0,0,,ÖLMEK İSTİYORUM!Dialogue: 0,0:20:18.90,0:20:23.16,Flashbacks,,0,0,0,,Deniz engindir. Hiç şüphesiz bir gün,...Dialogue: 0,0:20:23.16,0:20:27.12,Flashbacks,,0,0,0,,...seni koruyacak arkadaşların olacaktır!Dialogue: 0,0:20:34.46,0:20:36.46,Flashbacks,,0,0,0,,Luffy'ye inan.Dialogue: 0,0:20:38.68,0:20:43.55,Thoughts,,0,0,0,,Eğer isteğimi haykırmama izin verildiyse,...Dialogue: 0,0:20:45.06,0:20:46.55,Thoughts,,0,0,0,,...ben...Dialogue: 0,0:20:49.10,0:20:51.56,Main,,0,0,0,,YAŞAMAK İSTİYORUM!Dialogue: 0,0:20:51.56,0:20:55.94,Main,,0,0,0,,BENİ DE YANINIZDA DENİZE GÖTÜRÜN!Dialogue: 0,0:21:19.93,0:21:24.13,Main,,0,0,0,,Siz çocuklar...! Sizi seviyorum, lanet olsun!Dialogue: 0,0:21:25.89,0:21:26.88,Main,,0,0,0,,Gidelim!Dialogue: 0,0:21:26.88,0:21:30.60,Credits,,0,0,0,,Editing: Feeso, Galaxy 9000  Timing: Galaxy 9000  Quality Assurance: Feeso, Galaxy 9000, Pepperjack, Sewil  Soundtracking: Halee  Title & Infoboxes: Datenshi  Karaoke: KaitouYahiko  Translation: Crunchyroll, GaijinDialogue: 0,0:00:00.33,0:00:02.37,Main,,0,0,0,,Zenginlik, Şöhret, Güç...Dialogue: 0,0:00:02.37,0:00:04.47,Main,,0,0,0,,Dünyanın sunabileceği her şeyi elde eden adam,...Dialogue: 0,0:00:04.47,0:00:06.37,Main,,0,0,0,,...Korsanlar Kralı Gold Roger.Dialogue: 0,0:00:06.37,0:00:09.74,Main,,0,0,0,,Son sözleri dünyanın her yerinden maceracıları denize çekti.Dialogue: 0,0:00:09.84,0:00:13.58,Main,,0,0,0,,"Hazinem mi?" "İstiyorsanız, size vereceğim!"Dialogue: 0,0:00:13.58,0:00:14.67,Main,,0,0,0,,"Arayın ve bulun!"Dialogue: 0,0:00:14.68,0:00:17.47,Main,,0,0,0,,"Bu dünyanın sunabileceği her şeyi orada bıraktım!"Dialogue: 0,0:00:19.75,0:00:24.49,Main,,0,0,0,,Şimdi erkekler hayallerinin peşinden Grand Line'a doğru gidiyorlar!Dialogue: 0,0:00:24.49,0:00:27.82,Main,,0,0,0,,Dünya, Büyük Korsan Çağı'na girdi!