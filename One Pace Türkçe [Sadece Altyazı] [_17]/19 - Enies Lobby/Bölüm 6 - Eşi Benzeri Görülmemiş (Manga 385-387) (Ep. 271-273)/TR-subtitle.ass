FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.8,0.8,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:01:50.14,0:02:00.14,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:13:48.00,0:13:58.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:29:45.00,0:29:52.80,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:01:50.14,0:01:52.92,Title,,0,0,240,,Eşi Benzeri GörülmemişDialogue: 0,0:02:07.99,0:02:12.01,Flashbacks,,0,0,0,,Ah, bekleyin çocuklar. Unutmuşum.Dialogue: 0,0:02:12.01,0:02:13.34,Flashbacks,,0,0,0,,Bunları da götürün.Dialogue: 0,0:02:18.22,0:02:20.88,Main,,0,0,0,,Durun! O, Şeytan Meyvesi değil mi?Dialogue: 0,0:02:25.56,0:02:27.94,Main,,0,0,0,,Bu...Dialogue: 0,0:02:27.94,0:02:32.20,Main,,0,0,0,,...gerçek bir şey mi?Dialogue: 0,0:02:33.47,0:02:35.54,Main,,0,0,0,,İlk kez görüyorum!Dialogue: 0,0:02:35.54,0:02:38.97,Main,,0,0,0,,Ben de!Dialogue: 0,0:02:38.97,0:02:41.95,Main,,0,0,0,,Çok kötü! Bana onlarla yaklaşmayın!Dialogue: 0,0:02:41.95,0:02:44.87,Main,,0,0,0,,Neden sorun çıkarıyorsun, Jyabura!Dialogue: 0,0:02:44.87,0:02:47.20,Main,,0,0,0,,Aptal! Bilmiyor musun?Dialogue: 0,0:02:47.20,0:02:52.42,Main,,0,0,0,,Meyve kullanıcılarının vücudunda bir şeytan vardır!Dialogue: 0,0:02:52.42,0:02:55.22,Main,,0,0,0,,Örneğin, bir meyveye yaklaşırsam,...Dialogue: 0,0:02:55.22,0:03:02.84,Main,,0,0,0,,...bir şeytan dışarı fırlar ve içimdeki şeytanla savaşmaya başlayarak vücudumun patlamasına neden olur!Dialogue: 0,0:03:02.84,0:03:04.67,Main,,0,0,0,,Bu doğru mu?Dialogue: 0,0:03:06.15,0:03:07.90,Main,,0,0,0,,Aptalca sözler.Dialogue: 0,0:03:07.90,0:03:12.75,Main,,0,0,0,,Üyelerimizden birisinin böyle sıradan bir söylentiye inanmasına izin veremeyiz.Dialogue: 0,0:03:12.75,0:03:19.22,Main,,0,0,0,,Yeteneklerin transferiyle ilgili koşullar,  Grand Line bilim adamları tarafından zaten açığa çıkarıldı.Dialogue: 0,0:03:19.22,0:03:23.83,Main,,0,0,0,,Bahsettiğin şey, sadece Şeytan Meyvesi'nin ikinci kez yenilmesi sonucu oluşur.Dialogue: 0,0:03:23.83,0:03:27.21,Main,,0,0,0,,Vücudu hiçbir iz bırakmadan patlayıp  etrafa dağılırdı ve ölürdü.Dialogue: 0,0:03:27.21,0:03:30.19,Main,,0,0,0,,Ancak açgözlü bir aptal kendini yok ederdi.Dialogue: 0,0:03:30.19,0:03:33.04,Main,,0,0,0,,Eğer tek bir meyvenin  getireceği riskleri düşünürsen,...Dialogue: 0,0:03:33.04,0:03:37.87,Main,,0,0,0,,...ikincisinin sana ne tür bir lanet getireceğini tahmin edebilirsin.Dialogue: 0,0:03:39.14,0:03:41.54,Main,,0,0,0,,Eh? Demek öyle?Dialogue: 0,0:03:41.54,0:03:46.46,Main,,0,0,0,,Ama Şef, iki tane Şeytan Meyvesi ele geçirmekle iyi iş yapmışsın.Dialogue: 0,0:03:46.46,0:03:47.80,Main,,0,0,0,,Nereden buldun onları?Dialogue: 0,0:03:47.80,0:03:50.53,Main,,0,0,0,,Bir sürü bağlantım var.Dialogue: 0,0:03:50.53,0:03:52.86,Main,,0,0,0,,Bir dahaki sefer için onları yiyin.Dialogue: 0,0:03:54.20,0:03:56.94,Thoughts,,0,0,0,,Daha da güçlü olun, CP9!Dialogue: 0,0:03:56.94,0:03:59.31,Flashbacks,,0,0,0,,Ama bir konuda sizi uyarmak zorundayım.Dialogue: 0,0:03:59.31,0:04:03.41,Flashbacks,,0,0,0,,Bu meyvelerin içinde  ne tür bir şeytan olduğunu bilmiyorum.Dialogue: 0,0:04:03.41,0:04:06.50,Main,,0,0,0,,Bu dünyanın meyveleriymiş gibi görünmüyor.Dialogue: 0,0:04:06.50,0:04:10.24,Main,,0,0,0,,Meyveden, yerçekimi alanı gibi  bir güç dalgasının geldiğini hissediyorum.Dialogue: 0,0:04:10.24,0:04:12.29,Main,,0,0,0,,Üstelik resimli kitabımda da değildi.Dialogue: 0,0:04:12.29,0:04:14.84,Main,,0,0,0,,Bu normal.Dialogue: 0,0:04:14.84,0:04:19.31,Main,,0,0,0,,Elde edeceğimiz yeteneklerden meyvenin adını çıkartabiliriz.Dialogue: 0,0:04:19.31,0:04:22.30,Main,,0,0,0,,Ama ne tür yetenekler elde edeceğimiz bir kumar.Dialogue: 0,0:04:22.30,0:04:27.06,Main,,0,0,0,,Bu kumardan tuhaf yetenekler elde edersek,  olası en kötü hayata yol açabilir.Dialogue: 0,0:04:27.06,0:04:30.97,Main,,0,0,0,,Ayrıca suda çekiç haline geleceğiz.Dialogue: 0,0:04:30.97,0:04:34.34,Main,,0,0,0,,Ne tür bir yetenek olursa olsun, nasıl kullanacağınız size kalmış.Dialogue: 0,0:04:34.34,0:04:37.18,Main,,0,0,0,,Bunları yemek gücünüzden bir şey kaybettirmez.Dialogue: 0,0:04:37.18,0:04:40.45,Main,,0,0,0,,Çekiç olmak da o kadar kötü değil.Dialogue: 0,0:04:40.45,0:04:47.38,Main,,0,0,0,,Bu meyvelerden sadece bir tanesini ararken ölen  on binlerce denizci var.Dialogue: 0,0:04:47.96,0:04:50.94,Main,,0,0,0,,Yemeyi deneyin. Epey ilginç.Dialogue: 0,0:04:51.65,0:04:55.46,Main,,0,0,0,,Kalifa, sakın yapma! İyi bir şey değil.Dialogue: 0,0:04:55.46,0:04:57.80,Main,,0,0,0,,Tadı berbat! Aynı pislik gibi!Dialogue: 0,0:04:57.80,0:05:02.48,Main,,0,0,0,,Jyabura, Kaku ve Kalifa'nın güçlenmesini istemiyor, chapapa.Dialogue: 0,0:05:02.48,0:05:10.72,Main,,0,0,0,,Doğru! Kıskançlık ve haset,  erkeklik adına ne büyük bir yara!Dialogue: 0,0:05:13.48,0:05:15.72,Main,,0,0,0,,Kapa çeneni, tamam mı!?Dialogue: 0,0:05:15.72,0:05:18.16,Main,,0,0,0,,Hey, siz. Bunu iyi düşünün!Dialogue: 0,0:05:18.16,0:05:21.42,Main,,0,0,0,,Şansınız yaver giderse,  bundan milyonlar kazanabilirsiniz!Dialogue: 0,0:05:21.42,0:05:24.14,Main,,0,0,0,,Bunun bir lokması,  sorunlarla dolu bir yaşam demek olabilir!Dialogue: 0,0:05:42.60,0:05:45.06,Main,,0,0,0,,Hmm, ilginç, değil mi?Dialogue: 0,0:05:45.06,0:05:48.11,Main,,0,0,0,,Eğer iyiyse, memnuniyetle kabul edeceğim.Dialogue: 0,0:05:49.52,0:05:52.03,Main,,0,0,0,,Yediler! Kahretsin!Dialogue: 0,0:06:02.75,0:06:04.27,Main,,0,0,0,,Ne oldu?!Dialogue: 0,0:06:06.00,0:06:11.38,Main,,0,0,0,,Vücudunuzda bir değişiklik hissediyor musunuz?Dialogue: 0,0:06:21.88,0:06:23.10,Main,,0,0,0,,Tadı çok kötü.Dialogue: 0,0:06:23.10,0:06:24.41,Main,,0,0,0,,DAHA ÖNCE SÖYLESENİZE!!Dialogue: 0,0:06:24.41,0:06:25.57,Main,,0,0,0,,Tadı berbat!Dialogue: 0,0:06:25.57,0:06:27.13,Main,,0,0,0,,Bunu biliyordunuz, chapapa!Dialogue: 0,0:06:27.13,0:06:31.05,Main,,0,0,0,,Hepsini yiyecek kadar cesaretli değil misiniz?Dialogue: 0,0:06:32.41,0:06:36.75,Main,,0,0,0,,Hey, bir şey yapmayı deneyin. Ne tür bir güç kazandınız?Dialogue: 0,0:06:37.88,0:06:40.64,Main,,0,0,0,,Değişiklik falan hissetmiyorum.Dialogue: 0,0:06:40.64,0:06:44.12,Main,,0,0,0,,Kısa süre sonra  değişikliklerin boyutunu farkedeceksiniz.Dialogue: 0,0:06:45.44,0:06:47.90,Main,,0,0,0,,Bu, yeni meyve kullanıcılarının doğuşu.Dialogue: 0,0:06:47.90,0:06:49.58,Main,,0,0,0,,Eğlenceli olacak.Dialogue: 0,0:06:49.58,0:06:53.87,Main,,0,0,0,,En azından yapabiliyorken yeteneklerinizi kontrol etmeye çalışın.Dialogue: 0,0:06:54.09,0:06:56.17,Main,,0,0,0,,Şef-dono'nun emirleri doğrultusunda,...Dialogue: 0,0:06:56.17,0:06:58.58,Main,,0,0,0,,...gerçek bir dövüşte bunu denemek zorunda kalabilirsiniz.Dialogue: 0,0:06:58.58,0:07:04.70,Main,,0,0,0,,Blueno daha fazla bekleyemedi. Küçük ziyafete iştirak etmek için önden gitmiş gibi.Dialogue: 0,0:07:05.80,0:07:05.80,Captions,,0,0,0,,MahkemeDialogue: 0,0:07:05.80,0:07:05.84,Captions,,0,0,0,,MahkemeDialogue: 0,0:07:05.84,0:07:05.88,Captions,,0,0,0,,MahkemeDialogue: 0,0:07:05.88,0:07:05.92,Captions,,0,0,0,,MahkemeDialogue: 0,0:07:05.92,0:07:05.97,Captions,,0,0,0,,MahkemeDialogue: 0,0:07:05.97,0:07:06.01,Captions,,0,0,0,,MahkemeDialogue: 0,0:07:06.01,0:07:06.05,Captions,,0,0,0,,MahkemeDialogue: 0,0:07:06.05,0:07:06.09,Captions,,0,0,0,,MahkemeDialogue: 0,0:07:06.09,0:07:06.13,Captions,,0,0,0,,MahkemeDialogue: 0,0:07:06.13,0:07:06.18,Captions,,0,0,0,,MahkemeDialogue: 0,0:07:06.18,0:07:06.22,Captions,,0,0,0,,MahkemeDialogue: 0,0:07:06.22,0:07:06.26,Captions,,0,0,0,,MahkemeDialogue: 0,0:07:06.26,0:07:06.30,Captions,,0,0,0,,MahkemeDialogue: 0,0:07:06.30,0:07:06.34,Captions,,0,0,0,,MahkemeDialogue: 0,0:07:06.34,0:07:06.38,Captions,,0,0,0,,MahkemeDialogue: 0,0:07:06.38,0:07:06.43,Captions,,0,0,0,,MahkemeDialogue: 0,0:07:06.43,0:07:06.47,Captions,,0,0,0,,MahkemeDialogue: 0,0:07:06.47,0:07:06.51,Captions,,0,0,0,,MahkemeDialogue: 0,0:07:06.51,0:07:06.55,Captions,,0,0,0,,MahkemeDialogue: 0,0:07:06.55,0:07:06.59,Captions,,0,0,0,,MahkemeDialogue: 0,