Dialogue: 0,0:20:49.53,0:20:49.57,Captions,,0,0,0,,{=15}{\fscy100\fscx100\pos(923.05,205.45)}Adalet Kulesi
Dialogue: 0,0:20:49.57,0:20:49.61,Captions,,0,0,0,,{=9}{\fscy100\fscx100\pos(332.11,584.71)}Mahkeme
Dialogue: 0,0:20:49.57,0:20:49.61,Captions,,0,0,0,,{=15}{\fscy100\fscx100\pos(923.05,205.69)}Adalet Kulesi
Dialogue: 0,0:20:49.61,0:20:49.69,Captions,,0,0,0,,{=9}{\fscy100\fscx100\pos(332.11,584.79)}Mahkeme
Dialogue: 0,0:20:49.61,0:20:49.69,Captions,,0,0,0,,{=15}{\fscy100\fscx100\pos(923.05,205.77)}Adalet Kulesi
Dialogue: 0,0:20:50.43,0:20:51.57,Main,,0,0,0,,Ha?
Dialogue: 0,0:20:52.33,0:20:57.33,Main,,0,0,0,,{\i1}Ana Ada'nın Ön Kapısı'ndaki bekçilerle ilgili bir durum var. \NOimo ve Kashii de korsanlara katıldı.{\i0}
Dialogue: 0,0:20:57.33,0:21:00.61,Main,,0,0,0,,{\i1}Şu anda, Ana Ada'nın orta bölümünü yok ediyorlar!{\i0}
Dialogue: 0,0:21:00.61,0:21:03.17,Main,,0,0,0,,Yolu açın!
Dialogue: 0,0:21:08.12,0:21:12.13,Main,,0,0,0,,{\i1}Zaiyat raporundaki asker kaybımız...{\i0}
Dialogue: 0,0:21:12.13,0:21:13.82,Main,,0,0,0,,{\i1}...2000'i geçiyor!{\i0}
Dialogue: 0,0:21:13.82,0:21:16.27,Main,,0,0,0,,B-Beş kişi değil miydi?
Dialogue: 0,0:21:16.27,0:21:20.68,Main,,0,0,0,,{\i1}Bu arada, bin kadarını kendi başına halleden \Nkaptanları Hasır Şapkalı Luffy,...{\i0}
Dialogue: 0,0:21:20.68,0:21:25.24,Main,,0,0,0,,{\i1}...ortadan kayboldu!\NAraştırma halen devam ediyor!{\i0}
Dialogue: 0,0:21:26.39,0:21:33.86,Main,,0,0,0,,{\i1}Muhtemelen bu, Enies Lobby tarihi başladığından beri \Nortaya çıkan en kötü durum!{\i0}
Dialogue: 0,0:21:39.23,0:21:40.68,Main,,0,0,0,,Blueno,...
Dialogue: 0,0:21:40.68,0:21:42.82,Main,,0,0,0,,...orada ne yapıyorsun?
Dialogue: 0,0:21:45.78,0:21:47.96,Main,,0,0,0,,Neler oluyor?
Dialogue: 0,0:21:47.96,0:21:50.14,Main,,0,0,0,,Şu anda bu adada...
Dialogue: 0,0:21:50.36,0:21:53.84,Main,,0,0,0,,...NELER OLUYOR?!
Dialogue: 0,0:21:54.94,0:21:59.82,Main,,0,0,0,,{\i1}Baskerville! Yargıç Baskerville! \NCevap ver, benim!{\i0}
Dialogue: 0,0:21:59.82,0:22:02.68,Main,,0,0,0,,Oh, Şef Spandam!
Dialogue: 0,0:22:00.43,0:22:00.47,Captions,,0,0,0,,{=5}{\fad(690,0)\fscy100\fscx100\pos(316.42,445.83)}Mahkeme
Dialogue: 0,0:22:00.47,0:22:00.51,Captions,,0,0,0,,{=5}{\fad(680,0)\fscy100\fscx100\pos(316.25,442.4)}Mahkeme
Dialogue: 0,0:22:00.51,0:22:00.55,Captions,,0,0,0,,{=5}{\fad(670,0)\fscy100\fscx100\pos(316.02,439.53)}Mahkeme
Dialogue: 0,0:22:00.55,0:22:00.59,Captions,,0,0,0,,{=5}{\fad(660,0)\fscy100\fscx100\pos(315.85,436.95)}Mahkeme
Dialogue: 0,0:22:00.59,0:22:00.64,Captions,,0,0,0,,{=5}{\fad(650,0)\fscy100\fscx100\pos(315.6,434.92)}Mahkeme
Dialogue: 0,0:22:00.64,0:22:00.68,Captions,,0,0,0,,{=5}{\fad(640,0)\fscy100\fscx100\pos(315.36,432.93)}Mahkeme
Dialogue: 0,0:22:00.68,0:22:00.72,Captions,,0,0,0,,{=5}{\fad(630,0)\fscy100\fscx100\pos(315.34,431.4)}Mahkeme
Dialogue: 0,0:22:00.72,0:22:00.76,Captions,,0,0,0,,{=5}{\fad(620,0)\fscy100\fscx100\pos(315.36,430.35)}Mahkeme
Dialogue: 0,0:22:00.76,0:22:00.80,Captions,,0,0,0,,{=5}{\fad(610,0)\fscy100\fscx100\pos(315.34,429.45)}Mahkeme
Dialogue: 0,0:22:00.80,0:22:02.68,Captions,,0,0,0,,{=5}{\fad(600,0)\fscy100\fscx100\pos(315.35,428.87)}Mahkeme
Dialogue: 0,0:22:02.68,0:22:04.88,Main,,0,0,0,,Ben, soldaki Sol Baskerville!
Dialogue: 0,0:22:04.88,0:22:06.96,Main,,0,0,0,,Ben sağdaki Sağ Baskerville!
Dialogue: 0,0:22:06.96,0:22:12.53,Main,,0,0,0,,Ortada duran ben,\NMerkezi Ana Hat'taki Yalnız Yolum!
Dialogue: 0,0:22:12.53,0:22:13.50,Main,,0,0,0,,O da kim?
Dialogue: 0,0:22:13.50,0:22:15.39,Main,,0,0,0,,{\i1}Bana oradaki durumu anlatın!{\i0}
Dialogue: 0,0:22:15.39,0:22:19.41,Main,,0,0,0,,Korsanların, Mahkeme Binası'nın olduğu \Nmeydana geldiğini duydum!
Dialogue: 0,0:22:19.41,0:22:20.61,Main,,0,0,0,,Durum?
Dialogue: 0,0:22:21.74,0:22:23.83,Main,,0,0,0,,Evet, durum!
Dialogue: 0,0:22:26.28,0:22:27.75,Main,,0,0,0,,Durum...
Dialogue: 0,0:22:28.59,0:22:31.75,Main,,0,0,0,,İşin aslı artık meydanda değil, içerideler!
Dialogue: 0,0:22:31.75,0:22:34.08,Main,,0,0,0,,Bu bir felaket!
Dialogue: 0,0:22:34.08,0:22:35.76,Main,,0,0,0,,{\i1}Ne dediniz!?{\i0}
Dialogue: 0,0:22:42.10,0:22:44.99,Main,,0,0,0,,Ya... Yargıç, rapor vereceğim!
Dialogue: 0,0:22:44.99,0:22:51.70,Main,,0,0,0,,Mahkeme Binası'nın büyük taş kapıları \Nkesilerek açıldı ve korsanlar hücum ettiler!
Dialogue: 0,0:22:51.70,0:22:53.64,Main,,0,0,0,,Bunu kendim görebiliyorum, aptal!
Dialogue: 0,0:22:53.64,0:22:56.54,Main,,0,0,0,,Burada fazla kalabalık yok.
Dialogue: 0,0:22:56.54,0:23:00.12,Main,,0,0,0,,Hemen ilerleyebilecek gibiyiz ama o şey de ne?
Dialogue: 0,0:23:02.43,0:23:04.40,Main,,0,0,0,,Ah? O da ne? O kafalar!?
Dialogue: 0,0:23:04.40,0:23:07.28,Main,,0,0,0,,Aynı hikayelerde duyduğum \Nüç başlı bekçi köpek gibi!
Dialogue: 0,0:23:07.28,0:23:08.61,Main,,0,0,0,,Bu bir Cerlickus!
Dialogue: 0,0:23:08.61,0:23:10.13,Main,,0,0,0,,Hayır, Cerberus!
Dialogue: 0,0:23:10.13,0:23:12.28,Main,,0,0,0,,Bu ne gürültü, sessiz olun!
Dialogue: 0,0:23:12.28,0:23:14.73,Main,,0,0,0,,Burası kutsal yargı yeri!
Dialogue: 0,0:23:14.73,0:23:20.09,Main,,0,0,0,,Şimdi kaderinizi belirleyecek hükmün\Nne olduğuna karar vereceğim!
Dialogue: 0,0:23:20.09,0:23:21.17,Main,,0,0,0,,Vırak!
Dialogue: 0,0:23:23.06,0:23:27.26,Main,,0,0,0,,Pekâla çocuklar, şimdilik Hasır Şapka-san'ın\Nolduğu çatıya ulaşmaya çalışın.
Dialogue: 0,0:23:27.26,0:23:30.73,Main,,0,0,0,,Yokozuna ve diğerlerinin bir kısmı,\Ndestek kuvvetlerinin kapıdan girmesini engelleyecek.
Dialogue: 0,0:23:30.73,0:23:35.18,Main,,0,0,0,,Arkanızı kollayacağız, şimdilik bir an önce ilerleyin!
Dialogue: 0,0:23:35.18,0:23:36.32,Main,,0,0,0,,Anlaşıldı.
Dialogue: 0,0:23:36.32,0:23:39.41,Main,,0,0,0,,Şuraya bak.\NBir duruşma başlamış gibi.
Dialogue: 0,0:23:36.32,0:23:39.41,Secondary,,0,0,0,,{\an8}Suçları şudur!
Dialogue: 0,0:23:39.41,0:23:42.56,Secondary,,0,0,0,,{\an8}Birincisi, Dünya Hükümeti'ne ait olan...
Dialogue: 0,0:23:39.41,0:23:42.56,Main,,0,0,0,,Boşverin, çok can sıkıcı. Ne taraftan?
Dialogue: 0,0:23:42.56,0:23:45.11,Secondary,,0,0,0,,{\an8}...Enies Lobby'e adım atma eylemi...
Dialogue: 0,0:23:42.56,0:23:45.11,Main,,0,0,0,,Düz gidiyoruz!\NHer iki tarafta da merdiven var.
Dialogue: 0,0:23:45.11,0:23:46.63,Main,,0,0,0,,Oradan yukarıya çıkabiliriz!
Dialogue: 0,0:23:46.63,0:23:47.78,Main,,0,0,0,,Tamam!
Dialogue: 0,0:23:47.78,0:23:53.07,Main,,0,0,0,,Bu ne kabalık!\NKutsal yargıyı görmezden geldiler!
Dialogue: 0,0:23:53.07,0:23:55.92,Main,,0,0,0,,Onları affetmeyeceğiz!\NAdli Ada'yı alaya alıyorlar!
Dialogue: 0,0:23:55.92,0:23:58.51,Main,,0,0,0,,Al bakalım! Al bunu!
Dialogue: 0,0:24:02.98,0:24:06.10,Main,,0,0,0,,Ne?\NKılıçları eğiliyor gibi görünüyor!
Dialogue: 0,0:24:08.03,0:24:10.74,Main,,0,0,0,,{\fad(150,150)}Cazibe Şeytanı'nın Uykusuz Gecesi,...
Dialogue: 0,0:24:11.85,0:24:13.88,Main,,0,0,0,,{\fad(150,150)}...Şeytan Biçişi!
Dialogue: 0,0:24:21.45,0:24:23.87,Main,,0,0,0,,Kapıyı kesen o muydu?
Dialogue: 0,0:24:27.36,0:24:30.18,Main,,0,0,0,,Pekâla, gidelim. Yol açıldı!
Dialogue: 0,0:24:33.12,0:24:37.30,Main,,0,0,0,,Bu kadar güçlüyken niye kaptan değil?
Dialogue: 0,0:24:38.38,0:24:43.40,Main,,0,0,0,,Durun, durun, durun!\NÇekilin yolumdan, ren geyiği ve aptal kılıç ustası!
Dialogue: 0,0:24:43.40,0:24:44.97,Main,,0,0,0,,Elbise nii-chan.
Dialogue: 0,0:24:44.97,0:24:46.78,Main,,0,0,0,,Bu tehlikeli düşman bölgesinde,...
Dialogue: 0,0:24:46.78,0:24:50.31,Main,,0,0,0,,...Nami-san'ın yolunu açan ben olacağım!\NÇekilin yoldan!
Dialogue: 0,0:24:50.31,0:24:51.39,Main,,0,0,0,,– Lan!\N– Hey, dikkat et!
Dialogue: 0,0:24:51.39,0:24:53.98,Main,,0,0,0,,Niye kavga etmeye başlıyorsunuz?!
Dialogue: 0,0:24:55.33,0:24:57.15,Main,,0,0,0,,Dövüşmek mi istiyorsun?
Dialogue: 0,0:24:57.15,0:25:01.29,Main,,0,0,0,,Kapa çeneni! Utanmadan Nami-san'ın yoluna\Nçıkma cüretini gösterme!
Dialogue: 0,0:25:01.29,0:25:04.04,Main,,0,0,0,,Nami-san bu taraftan.\NSadece ve sadece beni izle!
Dialogue: 0,0:25:04.04,0:25:08.16,Main,,0,0,0,,Biliyorsun, buraya Robin'i kurtarmaya geldik.
Dialogue: 0,0:25:08.16,0:25:13.30,Main,,0,0,0,,Doğru, Robin-chan onu kurtarmamı bekliyor!
Dialogue: 0,0:25:13.30,0:25:15.92,Main,,0,0,0,,Umarım şu an yalnızlıktan ağlamıyordur!
Dialogue: 0,0:25:15.92,0:25:17.48,Main,,0,0,0,,Üfff!
Dialogue: 0,0:25:19.84,0:25:21.82,Main,,0,0,0,,Biz ona bakmıyorken Zoro koşup gitmiş!
Dialogue: 0,0:25:21.82,0:25:22.98,Main,,0,0,0,,Ne?
Dialogue: 0,0:25:22.98,0:25:25.81,Main,,0,0,0,,Dur Zoro! Orası doğru yön değil!
Dialogue: 0,0:25:25.81,0:25:26.98,Main,,0,0,0,,Ne?
Dialogue: 0,0:25:26.98,0:25:30.23,Main,,0,0,0,,Merdiven demiştim!\NNasıl olur da yanılıp o taraftan gidersin!?
Dialogue: 0,0:25:30.23,0:25:31.60,Main,,0,0,0,,Çok mu hayalperestsin!?
Dialogue: 0,0:25:31.60,0:25:34.22,Main,,0,0,0,,Kapa çeneni!\NAnlatımın aşırı karışıktı!
Dialogue: 0,0:25:34.22,0:25:35.91,Main,,0,0,0,,Benim hatalı olmam mümkün değil!
Dialogue: 0,0:25:36.66,0:25:39.74,Main,,0,0,0,,Zoro, bir dahaki sefere ilaç yapmaya çalışacağım!
Dialogue: 0,0:25:39.74,0:25:41.46,Main,,0,0,0,,Umutsuz aptallar için bir ilaç.
Dialogue: 0,0:25:41.46,0:25:42.86,Main,,0,0,0,,Umutsuz aptallar? Hey...
Dialogue: 0,0:25:42.86,0:25:43.78,Main,,0,0,0,,Chopper...
Dialogue: 0,0:25:44.25,0:25:46.94,Secondary,,0,0,0,,Robin-chwan! Ben geliyorum!
Dialogue: 0,0:25:44.25,0:25:46.94,Main,,0,0,0,,Onun için de işe yarayacağından emin ol.
Dialogue: 0,0:25:46.94,0:25:49.34,Main,,0,0,0,,Tamam, anlaşıldı.
Dialogue: 0,0:25:49.34,0:25:52.34,Main,,0,0,0,,Acaba abimiz kurtulacak mı?
Dialogue: 0,0:25:52.34,0:25:55.72,Main,,0,0,0,,Onlar, "vakti geldiğinde güvenilebilecek" tipler...
Dialogue: 0,0:25:55.72,0:26:00.23,Main,,0,0,0,,...olabilir... kesinlikle... muhtemelen...
Dialogue: 0,0:26:00.23,0:26:02.82,Main,,0,0,0,,Bu büyük bir suç!
Dialogue: 0,0:26:02.82,0:26:05.40,Main,,0,0,0,,Bu büyük bir günah!
Dialogue: 0,0:26:05.40,0:26:08.15,Main,,0,0,0,,Öyleyse ikiniz arasındaki konumumu kullanıp...
Dialogue: 0,0:26:08.15,0:26:09.30,Main,,0,0,0,,...onları ölüme mahkum ediyorum!
Dialogue: 0,0:26:09.30,0:26:10.46,Main,,0,0,0,,Kabul edilmiştir!
Dialogue: 0,0:26:12.38,0:26:15.85,Main,,0,0,0,,Yargıcı görmezden gelmeyin!
Dialogue: 0,0:26:29.65,0:26:31.98,Main,,0,0,0,,Chopper, Nami, siz devam edin!
Dialogue: 0,0:26:33.36,0:26:36.23,Main,,0,0,0,,Bu adamın icabına bakar bakmaz\Npeşinizden geleceğim.
Dialogue: 0,0:26:37.06,0:26:41.07,Main,,0,0,0,,Bize karşı kazanabileceğini mi düşünüyorsun?\NSeni ukala korsan!
Dialogue: 0,0:26:41.07,0:26:44.60,Main,,0,0,0,,Sana nasıl dehşet saçtığımı göstereceğim.
Dialogue: 0,0:26:49.47,0:26:51.58,Main,,0,0,0,,Çekin!
Dialogue: 0,0:26:53.87,0:26:56.34,Main,,0,0,0,,Du... Durun!
Dialogue: 0,0:26:57.34,0:27:06.06,Secondary,,0,0,0,,{\an8}Haydi!
Dialogue: 0,0:27:00.37,0:27:02.96,Main,,0,0,0,,D... Du... Durun...
Dialogue: 0,0:27:12.49,0:27:15.24,Main,,0,0,0,,Rakibin biz olacağız, Cerberus!
Dialogue: 0,0:27:15.24,0:27:16.66,Main,,0,0,0,,Franky Ailesi!
Dialogue: 0,0:27:18.07,0:27:18.94,Main,,0,0,0,,Gidelim!
Dialogue: 0,0:27:18.94,0:27:21.68,Main,,0,0,0,,Ah... tamam.
Dialogue: 0,0:27:35.22,0:27:37.39,Main,,0,0,0,,Yüzümdeki kapı kapandı!
Dialogue: 0,0:27:37.39,0:27:41.26,Main,,0,0,0,,Elbette. Kapılar açıldıktan sonra hep kapanır.
Dialogue: 0,0:27:41.26,0:27:43.92,Main,,0,0,0,,Bacak Fırtına'mı savuşturarak iyi iş çıkardın.
Dialogue: 0,0:27:43.92,0:27:46.63,Main,,0,0,0,,Evet, pek önemli değil.
Dialogue: 0,0:27:46.63,0:27:48.37,Main,,0,0,0,,Ne kadar beklenmedik bir durum.
Dialogue: 0,0:27:51.54,0:27:53.34,Main,,0,0,0,,Seni pislik!
Dialogue: 0,0:27:54.96,0:27:56.11,Main,,0,0,0,,Zıpladı!
Dialogue: 0,0:27:58.61,0:28:00.76,Main,,0,0,0,,{\fad(150,150)}Parmak Tabanca!
Dialogue: 0,0:28:00.76,0:28:02.26,Main,,0,0,0,,{\fad(150,150)}Kazı!
Dialogue: 0,0:28:02.26,0:28:04.16,Main,,0,0,0,,{\fad(150,150)}Güçlü Demir Parça!
Dialogue: 0,0:28:06.28,0:28:08.62,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu No...
Dialogue: 0,0:28:08.62,0:28:09.55,Main,,0,0,0,,{\fad(150,150)}...Mermi!
Dialogue: 0,0:28:09.55,0:28:10.89,Main,,0,0,0,,{\fad(150,150)}Demir Parça!
Dialogue: 0,0:28:15.27,0:28:17.43,Main,,0,0,0,,{\fad(150,150)}Bacak Fırtınası!
Dialogue: 0,0:28:28.81,0:28:32.20,Thoughts,,0,0,0,,{\i1}Mükemmel bir şekilde hızıma erişti.{\i0}
Dialogue: 0,0:28:32.20,0:28:34.55,Thoughts,,0,0,0,,{\i1}Bacak Fırtınası'nın yönünü bile değiştirdi!{\i0}
Dialogue: 0,0:28:34.55,0:28:37.55,Thoughts,,0,0,0,,{\i1}Fiziksel yetenekleri inanılmaz.{\i0}
Dialogue: 0,0:28:38.57,0:28:39.72,Main,,0,0,0,,Hiç iyi olmaz!
Dialogue: 0,0:28:40.97,0:28:44.73,Main,,0,0,0,,Bu şekilde kalırsam hiç iyi olmaz.
Dialogue: 0,0:28:44.73,0:28:48.94,Main,,0,0,0,,Aokiji'ye yenildiğimde, düşündümde...
Dialogue: 0,0:28:48.94,0:28:52.90,Main,,0,0,0,,"İleride denizde bu kadar güçlü adamlarla karşılaşırsam,...
Dialogue: 0,0:28:52.90,0:28:55.98,Main,,0,0,0,,...güçlenmeden...
Dialogue: 0,0:28:55.98,0:28:58.32,Main,,0,0,0,,...arkadaşlarımı koruyamam."
Dialogue: 0,0:28:59.78,0:29:06.10,Main,,0,0,0,,Bazıları o seviyede güçlü olmasa da \Narkadaşlarımı yanımda istiyorum.
Dialogue: 0,0:29:06.10,0:29:11.79,Main,,0,0,0,,Herkesten daha güçlü olmazsam,\Nhepsini kaybederim!
Dialogue: 0,0:29:11.79,0:29:13.76,Main,,0,0,0,,Öyleyse ne yapmak istiyorsun?
Dialogue: 0,0:29:14.63,0:29:18.37,Main,,0,0,0,,Her şeyimi kullanarak dövüşmenin\Nbir yolunu düşündüm.
Dialogue: 0,0:29:18.37,0:29:21.37,Main,,0,0,0,,Bu sayede kimseyi yitirmeyeceğim.
Dialogue: 0,0:29:23.68,0:29:26.64,Main,,0,0,0,,Bu sayede kimsenin sürüklenip gitmesine \Nizin vermeyeceğim.
Dialogue: 0,0:29:26.64,0:29:31.14,Thoughts,,0,0,0,,{\i1}Ne yapıyor bu?\NVücudunda neler oluyor?{\i0}
Dialogue: 0,0:29:33.39,0:29:35.82,Main,,0,0,0,,Artık sen...
Dialogue: 0,0:29:35.82,0:29:38.40,Main,,0,0,0,,...bana yetişemezsin.
Dialogue: 0,0:29:38.40,0:29:39.53,Main,,0,0,0,,Ne?
Dialogue: 0,0:29:39.53,0:29:44.29,Main,,0,0,0,,Tüm tekniklerim tek bir adımla gelişecek!
Dialogue: 0,0:29:46.35,0:29:48.86,Main,,0,0,0,,{\fad(150,150)}İkinci Düzen!
Dialogue: 0,0:29:49.71,0:29:52.90,Credits,,0,0,0,,Editing:\N Galaxy 9000\N\NTiming:\NKaitouYahiko,\NLance\N\NQuality Assurance:\NFeeso,\NGalaxy 9000,\NPepperjack\N\NSoundtracking:\N Halee\N\NGraphics:\N Datenshi\N\NKaraoke:\NKaitouYahiko\N\NTranslation:\NCrunchyroll,\NGaijin
Dialogue: 0,0:00:00.71,0:00:03.37,Lyrics,,0,0,0,,{\fad(0,0)}♪ Koşmaya başlayalım, koşmaya başlayalım! ♪
Dialogue: 0,0:00:03.59,0:00:06.46,Lyrics,,0,0,0,,♪ Bayrağımızı süsleyip, gökyüzüne kaldırarak. ♪
Dialogue: 0,0:00:12.77,0:00:18.06,Lyrics,,0,0,0,,♪ Sonsuz okyanusu geçip aramaya gidelim. ♪
Dialogue: 0,0:00:18.86,0:00:21.81,Lyrics,,0,0,0,,♪ Henüz kimse tarafından...
Dialogue: 0,0:00:21.90,0:00:23.94,Lyrics,,0,0,0,,...bulunmamış bu dünyanın mucizesini. ♪
Dialogue: 0,0:00:24.82,0:00:27.96,Lyrics,,0,0,0,,♪ Çarpıp duran göğsümüzdeki...
Dialogue: 0,0:00:27.96,0:00:29.71,Lyrics,,0,0,0,,...aynı hislerle devam etmeliyiz. ♪
Dialogue: 0,0:00:29.71,0:00:35.59,Lyrics,,0,0,0,,♪ Hayaller peşinde koşanlar tarafından bırakılmış ayak izleri. ♪
Dialogue: 0,0:00:36.42,0:00:39.39,Lyrics,,0,0,0,,♪ Ne tür bir fırtınalı gece olursa olsun,...
Dialogue: 0,0:00:39.39,0:00:42.39,Lyrics,,0,0,0,,...kalplerimizin bir olmasını sağlarsak...
Dialogue: 0,0:00:42.39,0:00:46.54,Lyrics,,0,0,0,,{\fad(0,0)}...bu zorluğun üstesinden gelebileceğiz! ♪
Dialogue: 0,0:00:46.68,0:00:47.86,Lyrics,,0,0,0,,♪ Her zaman ♪
Dialogue: 0,0:00:48.76,0:00:51.59,Lyrics,,0,0,0,,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪
Dialogue: 0,0:00:51.72,0:00:54.55,Lyrics,,0,0,0,,{\fad(0,0)}♪ Bayrağımızı dalgalandırıp gökyüzüne kaldırarak. ♪
Dialogue: 0,0:00:54.60,0:00:57.14,Lyrics,,0,0,0,,♪ Kimseye göstermeyeceğiz. ♪
Dialogue: 0,0:00:57.23,0:01:00.58,Lyrics,,0,0,0,,{\fad(0,0)}♪ Gözlerimizde yaşlar olsa bile. ♪
Dialogue: 0,0:01:00.77,0:01:03.52,Lyrics,,0,0,0,,♪ Peşinden gidelim, peşinden gidelim! ♪
Dialogue: 0,0:01:03.69,0:01:06.52,Lyrics,,0,0,0,,♪ Hayallerimize giden doğru yolu...
Dialogue: 0,0:01:06.61,0:01:09.23,Lyrics,,0,0,0,,...gösteren pusulanın. ♪
Dialogue: 0,0:01:09.23,0:01:11.40,Lyrics,,0,0,0,,{\fad(0,0)}♪ Durmayacağız. ♪
Dialogue: 0,0:01:11.42,0:01:14.42,Lyrics,,0,0,0,,♪ Dünyayı dolaşarak...
Dialogue: 0,0:01:14.45,0:01:15.85,Lyrics,,0,0,0,,...yeniden başlayalım! ♪
Dialogue: 0,0:01:18.83,0:01:21.49,Lyrics,,0,0,0,,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪
Dialogue: 0,0:01:21.80,0:01:24.54,Lyrics,,0,0,0,,♪ Hedefimize doğru herkesten daha fazla. ♪
Dialogue: 0,0:01:24.63,0:01:27.12,Lyrics,,0,0,0,,♪ Şimdi kaçmazsak,...
Dialogue: 0,0:01:27.22,0:01:30.54,Lyrics,,0,0,0,,{\fad(0,0)}...yarını sıkı sıkıya kavrayabileceğiz! ♪
Dialogue: 0,0:01:30.60,0:01:33.63,Lyrics,,0,0,0,,♪ Peşinden gidelim, peşinden gidelim! ♪
Dialogue: 0,0:01:33.68,0:01:36.51,Lyrics,,0,0,0,,♪ Gözlerinden yansıtılmış tüm şimdiki zamanın. ♪
Dialogue: 0,0:01:36.56,0:01:38.93,Lyrics,,0,0,0,,♪ Bembeyaz bir kalp...
Dialogue: 0,0:01:39.15,0:01:41.43,Lyrics,,0,0,0,,...bana tüm hikayeyi anlatacak! ♪
Dialogue: 0,0:01:41.73,0:01:44.43,Lyrics,,0,0,0,,♪ Yepyeni bir dünyada...
Dialogue: 0,0:01:44.53,0:01:45.83,Lyrics,,0,0,0,,...yeniden başlayalım! ♪
