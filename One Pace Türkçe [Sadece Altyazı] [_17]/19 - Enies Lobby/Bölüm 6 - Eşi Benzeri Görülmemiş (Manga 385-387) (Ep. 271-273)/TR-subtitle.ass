Dialogue: 0,0:13:43.27,0:13:45.62,Main,,0,0,0,,{\i1}...ve Mahkeme Binası'na ulaştı!{\i0}
Dialogue: 0,0:13:45.62,0:13:47.86,Main,,0,0,0,,{\i1}Tekrarlıyorum! Korsanlar...{\i0}
Dialogue: 0,0:13:50.90,0:13:53.61,Main,,0,0,0,,Bak, Funk Freed.
Dialogue: 0,0:13:55.96,0:13:58.88,Main,,0,0,0,,Altın Den-Den Mushi.
Dialogue: 0,0:13:58.88,0:14:01.60,Main,,0,0,0,,Bu ışıltılı Den-Den Mushi gerçekten değerli bir eşya.
Dialogue: 0,0:14:01.60,0:14:06.82,Main,,0,0,0,,Bir Yıkım Çağrısı yapma yetkisi verdiği için,\Nyalnızca bir Donanma amiralinden...
Dialogue: 0,0:14:06.82,0:14:10.39,Main,,0,0,0,,...izin almış olanlar buna sahip olabilir.
Dialogue: 0,0:14:10.39,0:14:16.33,Main,,0,0,0,,Bir Yıkım Çağrısı yapabilmem için Aokiji,\Nonu geçici olarak bana emanet etti.
Dialogue: 0,0:14:17.76,0:14:21.96,Main,,0,0,0,,Şu an nasıl olduğuna bir bak!\NEğer silahların uyanışı gerçekleşirse,...
Dialogue: 0,0:14:21.96,0:14:26.66,Main,,0,0,0,,...Amiral'den izin almaya gerek kalmadan,\Nbu küçük şeyi tamamiyle kendim kontrol edeceğim.
Dialogue: 0,0:14:26.66,0:14:30.07,Main,,0,0,0,,Kesinlikle birliklere istediği gibi hükmeden \Nadam olacağım.
Dialogue: 0,0:14:34.94,0:14:39.10,Main,,0,0,0,,Bu düğmeye tek bir basışla,\Ntüm ada yok olacak.
Dialogue: 0,0:14:40.79,0:14:44.45,Main,,0,0,0,,Yetki, yine aynı bir silah gibi.
Dialogue: 0,0:14:44.45,0:14:46.29,Main,,0,0,0,,Şef Spandam!
Dialogue: 0,0:14:47.66,0:14:49.60,Main,,0,0,0,,Aklımı aldın!
Dialogue: 0,0:14:49.60,0:14:52.70,Main,,0,0,0,,Sorunun nedir senin?! \NKapıyı çalamaz mısın?!
Dialogue: 0,0:14:52.70,0:14:55.08,Main,,0,0,0,,Neredeyse düğmeye basıyordum!
Dialogue: 0,0:14:55.08,0:14:59.80,Main,,0,0,0,,G-Gerçekten üzgünüm.\NAma acil bir durum olduğu için...
Dialogue: 0,0:14:59.80,0:15:02.56,Main,,0,0,0,,Enies Lobby'nin Ana Ada'sından bir arama var.
Dialogue: 0,0:15:02.56,0:15:07.56,Main,,0,0,0,,Ne?! Bir arama mı?!\NDoğrudan bu odayı aramaları gerekirdi!
Dialogue: 0,0:15:07.56,0:15:10.78,Main,,0,0,0,,Ve... Hey!\NAhize yerinden çıkmış!
Dialogue: 0,0:15:10.78,0:15:13.32,Main,,0,0,0,,Bunu sürekli kim yapıyor?
Dialogue: 0,0:15:13.32,0:15:17.55,Main,,0,0,0,,Demin acil durumla ilgili bir şey demiştin.
Dialogue: 0,0:15:17.55,0:15:18.66,Main,,0,0,0,,Evet!
Dialogue: 0,0:15:26.70,0:15:28.16,Main,,0,0,0,,Spanda...
Dialogue: 0,0:15:35.86,0:15:37.77,Main,,0,0,0,,Hey, Nico Robin!
Dialogue: 0,0:15:37.77,0:15:42.32,Main,,0,0,0,,Görünüşe göre Enies Lobby'nin\NAna Ada'sından gelen acil bir rapor var.
Dialogue: 0,0:15:42.32,0:15:47.10,Main,,0,0,0,,Muhtemelen çok acil değil ama\Nçoğunu önceden tahmin edebilirsin.
Dialogue: 0,0:15:49.10,0:15:54.30,Main,,0,0,0,,Ellerinden geleni yaptılar ve\Nbeş askerimizi yenmeyi başardılar.
Dialogue: 0,0:15:54.32,0:15:56.96,Main,,0,0,0,,Hasır Şapkalı Luffy'ye ne oldu?
Dialogue: 0,0:15:56.96,0:16:03.50,Main,,0,0,0,,En iyi kapı bekçileri Oimo ve Kashii'nin önünde,\Nacaba arkadaşların hangi korkunç yöntemle ezildiler?
Dialogue: 0,0:16:05.85,0:16:11.79,Main,,0,0,0,,Dünya Hükümeti'ne karşı duran\Nahmakların kaderini birlikte soralım!
Dialogue: 0,0:16:11.79,0:16:13.87,Main,,0,0,0,,Çok kötü birisin!
Dialogue: 0,0:16:13.87,0:16:15.26,Main,,0,0,0,,Kapa çeneni, serseri!
Dialogue: 0,0:16:18.98,0:16:21.10,Main,,0,0,0,,Hey, asker!
Dialogue: 0,0:16:21.10,0:16:23.55,Main,,0,0,0,,Evet, ben Spandam.
Dialogue: 0,0:16:23.55,0:16:28.56,Main,,0,0,0,,{\i1}Evet! Şef-dono mu? Hele şükür.\NNihayet rapor verebilirim!{\i0}
Dialogue: 0,0:16:28.56,0:16:30.31,Main,,0,0,0,,{\i1}Na... Nasıl başlasam?{\i0}
Dialogue: 0,0:16:32.31,0:16:35.62,Main,,0,0,0,,Sakin ol, ahmak!\NHasır Şapka tayfası hakkında, değil mi?
Dialogue: 0,0:16:35.62,0:16:39.29,Main,,0,0,0,,Ne olmuş onlara? Ah, dur, dur.\Nİyi dinleyin.
Dialogue: 0,0:16:39.29,0:16:45.04,Main,,0,0,0,,Önemli bilgiyi vermeye devam et ve\Nyüksek sesle, net bir şekilde söyle.
Dialogue: 0,0:16:45.04,0:16:46.42,Main,,0,0,0,,Tamam! Saldırga-
Dialogue: 0,0:16:46.42,0:16:48.22,Main,,0,0,0,,{\i1}Hepsini öldürdünüz mü?{\i0}
Dialogue: 0,0:16:48.22,0:16:50.68,Main,,0,0,0,,{\i1}Evet, çünkü düşman zayıftı!{\i0}
Dialogue: 0,0:16:50.68,0:16:53.00,Main,,0,0,0,,Saldırganlar 60 kadar korsandan oluşuyor!
Dialogue: 0,0:16:53.00,0:16:56.86,Main,,0,0,0,,Aslında bu, Enies Lobby'nin \NAna Ada'sının içine düştüğü en kötü durum!
Dialogue: 0,0:16:56.86,0:17:00.42,Main,,0,0,0,,Mahkeme Binası'na kadar olan yerleri ele geçirdiler!
Dialogue: 0,0:17:05.68,0:17:08.15,Main,,0,0,0,,Enies Lobby'nin Ana Ada'sındaki tüm personele!
Dialogue: 0,0:17:08.15,0:17:11.11,Main,,0,0,0,,Herkes derhal Mahkeme Binası'na gelsin!
Dialogue: 0,0:17:14.10,0:17:16.69,Main,,0,0,0,,İyi iş çıkardın, Gomorrah!
Dialogue: 0,0:17:16.69,0:17:20.58,Main,,0,0,0,,İkinizin de emeklerinin boşa gitmesine\Nizin vermeyeceğiz!
Dialogue: 0,0:17:22.95,0:17:27.47,Main,,0,0,0,,İçeri giriyoruz beyler! \NFranky abimizi kurtaracağız!
Dialogue: 0,0:17:27.47,0:17:30.55,Main,,0,0,0,,Evet!
Dialogue: 0,0:17:30.55,0:17:35.86,Main,,0,0,0,,Korsanlar, Mahkeme Binası'na geldiler!
Dialogue: 0,0:17:44.86,0:17:46.56,Main,,0,0,0,,Luffy'yi görebiliyor musunuz?
Dialogue: 0,0:17:46.56,0:17:47.34,Main,,0,0,0,,Hayır.
Dialogue: 0,0:17:50.22,0:17:54.96,Main,,0,0,0,,Çatının tepesindeyse, \Noraya tırmanmamız mümkün değil.
Dialogue: 0,0:17:54.96,0:17:57.85,Main,,0,0,0,,Lastikten de yapılmadık.
Dialogue: 0,0:17:58.56,0:18:01.23,Main,,0,0,0,,Yukarıda kaç tane CP9 gördünüz?
Dialogue: 0,0:18:01.23,0:18:04.49,Main,,0,0,0,,Sadece boynuzlu iri adamı gördük.
Dialogue: 0,0:18:05.30,0:18:10.84,Main,,0,0,0,,Robin-chan'ı ve Franky'yi böyle bir yere getirdikten sonra, \Norada toplanacaklarına inanmak güç.
Dialogue: 0,0:18:12.00,0:18:14.38,Main,,0,0,0,,Neyse, Luffy'ye erişmek için acele etmeliyiz.
Dialogue: 0,0:18:14.38,0:18:16.33,Main,,0,0,0,,Robin'i kurtarmak için acele etmeliyiz.
Dialogue: 0,0:18:16.33,0:18:18.58,Main,,0,0,0,,Çabuk olun! Mahkeme Binası'nın önüne!
Dialogue: 0,0:18:18.58,0:18:20.79,Main,,0,0,0,,Köprü henüz indirilmedi! Onlara erişelim!
Dialogue: 0,0:18:33.36,0:18:35.44,Main,,0,0,0,,Vırak!
Dialogue: 0,0:18:42.58,0:18:44.58,Main,,0,0,0,,Oh, müthişti, kurbağa!
Dialogue: 0,0:18:44.58,0:18:48.45,Main,,0,0,0,,Bu, Gomorrah'ı deviren çelik gülle! \NO kurbağanın nesi var?!
Dialogue: 0,0:18:50.08,0:18:51.25,Main,,0,0,0,,Vırak!
Dialogue: 0,0:18:51.25,0:18:54.95,Main,,0,0,0,,Neredeler? Kaçıyorlar! Üç kişiler!
Dialogue: 0,0:18:54.95,0:18:58.00,Main,,0,0,0,,Niye kaçıyorlar? İlk önce onlar saldırdı.
Dialogue: 0,0:18:58.00,0:19:02.88,Main,,0,0,0,,Aptal! Bütün gün kaçıp duran düşmanı \Nkovalamaya başlarsak, sadece vakit kaybı olur!
Dialogue: 0,0:19:19.09,0:19:22.10,Main,,0,0,0,,Kapa çeneni, bu doğrulama.
Dialogue: 0,0:19:24.07,0:19:27.79,Main,,0,0,0,,Bize ne tür bir düşmanın geleceğini bilmek de iyidir.
Dialogue: 0,0:19:27.79,0:19:30.74,Main,,0,0,0,,Müthiş... Ne oldu?
Dialogue: 0,0:19:31.36,0:19:33.19,Main,,0,0,0,,Bu adam da ne böyle?
Dialogue: 0,0:19:33.19,0:19:36.62,Main,,0,0,0,,O şeyi sallayabilmesi için \Ninsan üstü bir güce sahip olmalı!
Dialogue: 0,0:19:36.62,0:19:39.72,Main,,0,0,0,,Bu da Kanun Koruyucu Birim gibi \Nözel bir birlik mi?
Dialogue: 0,0:19:39.72,0:19:42.80,Main,,0,0,0,,Hala bir şey saklıyor olabilir.
Dialogue: 0,0:19:42.80,0:19:43.97,Main,,0,0,0,,Dikkatli olun.
Dialogue: 0,0:19:46.89,0:19:50.34,Main,,0,0,0,,Pekâla, acele edelim!\NDiğer askerler bu tarafa geliyor.
Dialogue: 0,0:19:50.34,0:19:51.65,Main,,0,0,0,,Erişmeliyiz!
Dialogue: 0,0:19:51.65,0:19:54.69,Main,,0,0,0,,En azından Mahkeme Binası'nın ağır, \Ntaş kapısını açamayacaklar!
Dialogue: 0,0:19:54.69,0:19:56.82,Main,,0,0,0,,Girişte durdurun onları!
Dialogue: 0,0:19:56.82,0:20:00.27,Main,,0,0,0,,Sahi. Biz bu koca kapıyı...
Dialogue: 0,0:20:03.22,0:20:04.72,Main,,0,0,0,,...nasıl...
Dialogue: 0,0:20:05.98,0:20:07.70,Main,,0,0,0,,...açacağız?
Dialogue: 0,0:20:09.91,0:20:12.98,Main,,0,0,0,,İlk biz giriyoruz, geride kalmayın!
Dialogue: 0,0:20:12.98,0:20:17.19,Main,,0,0,0,,K-Kalın taş kapıyı kesti!
Dialogue: 0,0:20:17.19,0:20:18.44,Main,,0,0,0,,Zanbai!
Dialogue: 0,0:20:18.44,0:20:24.26,Main,,0,0,0,,Biz de sağ ve sol kule için ikiye ayrılacağız!\NAçılır köprünün manivelalarını çekeceğiz.
Dialogue: 0,0:20:24.26,0:20:26.66,Main,,0,0,0,,A-Anlaşıldı. Size güveniyorum.
Dialogue: 0,0:20:26.66,0:20:29.97,Main,,0,0,0,,Pekâla, bizde üç takıma ayrılacağız.
Dialogue: 0,0:20:30.66,0:20:33.77,Main,,0,0,0,,Benimle gelenler, Mahkeme Binası'nın\Niçeriden temizlenmesine yardım edecek.
Dialogue: 0,0:20:33.79,0:20:35.17,Main,,0,0,0,,Sadece birkaçınıza ihtiyacım var.
Dialogue: 0,0:20:35.17,0:20:37.67,Main,,0,0,0,,Dövüşte iyi şanslar! Dağılın!
