FF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.8,0.8,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:01:53.88,0:01:58.72,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:12:53.00,0:13:03.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:24:14.80,0:24:17.70,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 1,0:01:53.88,0:01:58.72,Title,,0,0,0,,Rob LucciDialogue: 0,0:02:09.94,0:02:13.32,Main,,0,0,0,,Geldiler! Saldırı başladı!Dialogue: 0,0:02:16.28,0:02:17.95,Main,,0,0,0,,Dikkat edin!Dialogue: 0,0:02:17.95,0:02:19.11,Main,,0,0,0,,Koşun!Dialogue: 0,0:02:19.11,0:02:20.78,Main,,0,0,0,,Zamanında varalım!Dialogue: 0,0:02:20.78,0:02:22.62,Main,,0,0,0,,Biliyoruz!Dialogue: 0,0:02:27.46,0:02:29.50,Main,,0,0,0,,Yıkım Çağrısı'nı başlatın!Dialogue: 0,0:02:29.50,0:02:34.38,Main,,0,0,0,,Hedefimiz: Korsan "Hasır Şapka" ve tayfası. Yaklaşık altmış kişiler!Dialogue: 0,0:02:34.38,0:02:37.38,Main,,0,0,0,,Ayrıca Amiral Aokiji'yle anlaşıldığı üzere,...Dialogue: 0,0:02:37.38,0:02:42.49,Main,,0,0,0,,...Tereddüt Köprüsü'nde olduğu tespit edilen Nico Robin hedef alınmayacak!Dialogue: 0,0:02:42.49,0:02:44.28,Main,,0,0,0,,Durumu anlamaya gerek yok!Dialogue: 0,0:02:44.28,0:02:48.14,Main,,0,0,0,,Adalet Adası Enies Lobby'deki her şeyi yok edin!Dialogue: 0,0:02:48.14,0:02:50.14,Main,,0,0,0,,Tüm gemiler konumunu alsın!Dialogue: 0,0:02:56.65,0:03:02.03,Main,,0,0,0,,Tekrar ediyorum. Hedefimiz: Korsan  "Hasır Şapka" ve tayfası. Yaklaşık altmış kişiler!Dialogue: 0,0:03:02.03,0:03:05.24,Main,,0,0,0,,Enies Lobby'deki her şeyi yok edin!Dialogue: 0,0:03:07.45,0:03:09.71,Main,,0,0,0,,Ah... H-Hey!Dialogue: 0,0:03:09.71,0:03:12.90,Main,,0,0,0,,Hey, hepiniz bakın! Kaçmayın!Dialogue: 0,0:03:12.90,0:03:15.34,Main,,0,0,0,,Bakın, savaş gemileri bu köprüyü görmezden geliyor!Dialogue: 0,0:03:25.39,0:03:27.47,Main,,0,0,0,,Çünkü ben buradayım!Dialogue: 0,0:03:27.47,0:03:29.93,Main,,0,0,0,,Babam da bunu söylemişti!Dialogue: 0,0:03:29.93,0:03:33.31,Main,,0,0,0,,"Her şeyi vuran o saldırı bile beni es geçti!"Dialogue: 0,0:03:35.61,0:03:40.03,Main,,0,0,0,,Şimdilik suçlu Nico Robin'in olduğu köprüyü bırakın.Dialogue: 0,0:03:40.03,0:03:43.03,Main,,0,0,0,,Hey, bakın! Burada güvendeyiz!Dialogue: 0,0:03:43.03,0:03:46.41,Main,,0,0,0,,CP9 lideri olduğum için!Dialogue: 0,0:03:52.96,0:03:55.79,Main,,0,0,0,,Delilik bu.Dialogue: 0,0:03:57.42,0:03:59.26,Main,,0,0,0,,H-Hey, sen...Dialogue: 0,0:04:07.43,0:04:09.72,Thoughts,,0,0,0,,Titrememe engel olamıyorum.Dialogue: 0,0:04:33.46,0:04:36.42,Main,,0,0,0,,Acele edin! Hızlı hareket edin!Dialogue: 0,0:04:36.79,0:04:38.92,Main,,0,0,0,,O kadar büyüklenme, aptal!Dialogue: 0,0:04:38.92,0:04:41.96,Main,,0,0,0,,Öyle konuştuğunda yaralarım acıyor.Dialogue: 0,0:04:41.96,0:04:45.43,Main,,0,0,0,,Biraz daha nazikçe taşıyabilir misiniz?Dialogue: 0,0:04:45.43,0:04:49.72,Main,,0,0,0,,Aptallaşma! Başladığımızda tamamiyle tükenmiştin.Dialogue: 0,0:04:49.72,0:04:52.71,Main,,0,0,0,,Ama ben, gürleyen bir sesle her şeyi komuta eden liderim...Dialogue: 0,0:04:52.71,0:04:56.15,Main,,0,0,0,,...ve ciddi bir şekilde yaralandım!Dialogue: 0,0:04:56.15,0:04:59.07,Main,,0,0,0,,Ah, tüm kaburgalarım kırılmış! Altısı da!Dialogue: 0,0:04:59.07,0:05:01.07,Main,,0,0,0,,Sayıları altıdan fazla, bu yüzden iyisin.Dialogue: 0,0:05:01.07,0:05:02.82,Main,,0,0,0,,Cidden sinir bozucusun.Dialogue: 0,0:05:02.82,0:05:07.07,Main,,0,0,0,,Sahi, yeni silahım Kabuto'nun sırrını bilmek ister misiniz?Dialogue: 0,0:05:07.07,0:05:11.33,Main,,0,0,0,,Açıklayacağım! Sogeking'in silahı Kabuto-Dialogue: 0,0:05:11.33,0:05:13.96,Main,,0,0,0,,– Ta-da! – Kapa çeneni, yoksa seni yürütürüz!Dialogue: 0,0:05:14.87,0:05:18.92,Main,,0,0,0,,Lütfen yapmayın, kaburgalarım kırık. 10 tanesi de.Dialogue: 0,0:05:18.92,0:05:20.15,Main,,0,0,0,,Ondan fazlası var.Dialogue: 0,0:05:20.75,0:05:23.76,Main,,0,0,0,,O zaman 20... 30?Dialogue: 0,0:05:23.76,0:05:25.09,Main,,0,0,0,,Yüze ne dersin?Dialogue: 0,0:05:25.09,0:05:26.22,Main,,0,0,0,,Yüzden de fazla!Dialogue: 0,0:05:26.22,0:05:28.59,Main,,0,0,0,,Yalan söylüyorsunuz!Dialogue: 0,0:05:34.06,0:05:35.31,Main,,0,0,0,,O...Dialogue: 0,0:05:40.31,0:05:42.28,Main,,0,0,0,,Su!Dialogue: 0,0:05:43.07,0:05:45.32,Main,,0,0,0,,Neler oluyor?!Dialogue: 0,0:05:47.74,0:05:52.29,Main,,0,0,0,,Niye su var? Niye? Niye?! Kaçacak yer yok!Dialogue: 0,0:05:52.29,0:05:53.95,Main,,0,0,0,,Biri yardım etsin!Dialogue: 0,0:06:11.64,0:06:16.23,Main,,0,0,0,,Tünelde kimse olsun olmasın,  artık orada bir yol yok.Dialogue: 0,0:06:16.23,0:06:17.81,Main,,0,0,0,,Sen!Dialogue: 0,0:06:18.39,0:06:21.36,Main,,0,0,0,,Bu tünel de denizin altında.Dialogue: 0,0:06:29.20,0:06:30.87,Main,,0,0,0,,Pislik!Dialogue: 0,0:06:49.93,0:06:54.06,Main,,0,0,0,,Burada deniz seviyesinin üstünde olduğumuz için deniz suyu bize ulaşmayacak.Dialogue: 0,0:06:55.64,0:06:59.39,Main,,0,0,0,,Onları duyabiliyor musun? Savaş gemisi saldırılarının sesini.Dialogue: 0,0:07:05.73,0:07:11.74,Main,,0,0,0,,Korsanlara ne oldu? Nico Robin'e ne oldu?Dialogue: 0,0:07:11.74,0:07:14.45,Main,,0,0,0,,Endişelenmiş olmalısın.Dialogue: 0,0:07:23.42,0:07:26.71,Main,,0,0,0,,Onları kurtarmaya gitmek istiyorsan, gidebilirsin.Dialogue: 0,0:07:27.59,0:07:30.51,Main,,0,0,0,,Gözlerimi senden ayırmayacağım.Dialogue: 0,0:07:35.05,0:07:39.39,Main,,0,0,0,,Şu anda ne olursa olsun hayatta kalacaklar.Dialogue: 0,0:07:39.39,0:07:44.06,Main,,0,0,0,,Ama şimdi senden ayrılırsam, gidip arkadaşlarımı öldüreceksin!Dialogue: 0,0:07:44.06,0:07:47.53,Main,,0,0,0,,Bu yüzden gözlerimi senden ayırmayacağım.Dialogue: 0,0:08:04.25,0:08:06.38,Main,,0,0,0,,Saldırı başlıyor.Dialogue: 0,0:08:06.38,0:08:10.21,Main,,0,0,0,,Sahi, bir süredir şu tuhaf sesleri duyuyordum.Dialogue: 0,0:08:10.21,0:08:11.42,Main,,0,0,0,,Kapa çeneni!Dialogue: 0,0:08:11.42,0:08:13.22,Main,,0,0,0,,Olamaz!Dialogue: 0,0:08:13.22,0:08:15.51,Main,,0,0,0,,Büyükanne! Neler oluyor?!Dialogue: 0,0:08:15.51,0:08:18.76,Main,,0,0,0,,Kimin umurunda?!  Acele edip burdan çıkmalıyız!Dialogue: 0,0:08:21.93,0:08:24.19,Main,,0,0,0,,Yetenekli bir lidersin.Dialogue: 0,0:08:24.19,0:08:27.02,Main,,0,0,0,,Sadece bir aptal sözlerini duyardı.Dialogue: 0,0:08:27.52,0:08:31.28,Main,,0,0,0,,Ama buna sadık kalabilecek misin?Dialogue: 0,0:08:35.28,0:08:38.24,Main,,0,0,0,,Ölsen bile sonuç aynı olacak!Dialogue: 0,0:09:00.64,0:09:04.81,Main,,0,0,0,,Hey! Gidip Nico Robin'i yakalayın artık!Dialogue: 0,0:09:04.81,0:09:09.15,Main,,0,0,0,,Her şey sona erdiğinde, dünyanın kahramanı olacağım.Dialogue: 0,0:09:09.15,0:09:13.28,Main,,0,0,0,,Yıkım Çağrısı bile ne kadar büyük olduğumu görüyor ve benden kaçınıyor!Dialogue: 0,0:09:27.10,0:09:27.92,Main,,0,0,0,,Ustura!Dialogue: 0,0:09:30.34,0:09:31.71,Main,,0,0,0,,Parmak Tabanca!Dialogue: 0,0:09:33.12,0:09:35.24,Main,,0,0,0,,Bacak Fırtınası: Leopar Kuyruğu!Dialogue: 0,0:09:42.89,0:09:44.81,Main,,0,0,0,,Beni yenebilir misin?Dialogue: 0,0:09:45.31,0:09:48.56,Main,,0,0,0,,Kazanmazsam kimseyi koruyamam!Dialogue: 0,0:09:52.11,0:09:54.78,Main,,0,0,0,,Gomu Gomu No...Dialogue: 0,0:09:56.32,0:09:58.82,Main,,0,0,0,,...Tüfek!Dialogue: 0,0:09:58.82,0:10:01.04,Main,,0,0,0,,Demir Parça: Havlu PüskülüDialogue: 0,0:10:15.46,0:10:16.67,Main,,0,0,0,,Ustura!Dialogue: 0,0:10:19.89,0:10:24.22,Main,,0,0,0,,Dünya Hükümeti'ne karşı durmakla iyi iş çıkardın.Dialogue: 0,0:10:42.07,0:10:46.87,Main,,0,0,0,,Gomu Gomu No Tabanca!Dialogue: 0,0:10:51.96,0:10:53.54,Main,,0,0,0,,Uçan Parmak Tabanca!Dialogue: 0,0:10:57.76,0:10:58.80,Main,,0,0,0,,Kürdan!Dialogue: 0,0:11:11.27,0:11:12.69,Main,,0,0,0,,Üç Kürdan!Dialogue: 0,0:11:31.75,0:11:33.50,Main,,0,0,0,,Uçan Parmak Tabanca!Dialogue: 0,0:11:34.29,0:11:35.38,Main,,0,0,0,,Alevli Kürdan!Dialogue: 0,0:11:49.18,0:11:54.61,Main,,0,0,0,,Canlı bir adam bekliyor olsaydım, hayal kırıklığına uğrardım.Dialogue: 0,0:11:54.61,0:11:58.98,Main,,0,0,0,,O saldırıdan sonra tüm gücünü yitirdin mi?Dialogue: 0,0:12:04.24,0:12:09.50,Main,,0,0,0,,Canlı bir dövüş istiyorsan, sana göstereceğim.Dialogue: 0,0:12:09.50,0:12:11.96,Main,,0,0,0,,Başka bir strateji.Dialogue: 0,0:12:11.96,0:12:14.54,Main,,0,0,0,,Üçüncü Düzen!Dialogue: 0,0:12:24.43,0:12:25.97,Main,,0,0,0,,Kemik Balon!Dialogue: 0,0:12:27.05,0:12:28.43,Main,,0,0,0,,Kemik?Dialogue: 0,0:12:28.43,0:12:31.06,Main,,0,0,0,,Güç, bir kemikten diğerine geçiyor.Dialogue: 0,0:12:32.43,0:12:34.69,Main,,0,0,0,,İzle! Sol elim...Dialogue: 0,0:12:36.40,0:12:39.32,Main,,0,0,0,,...bir devin eli!Dialogue: 0,0:12:39.32,0:12:42.28,Main,,0,0,0,,Gözümü korkutmaya çalışıyorsan, yapma.Dialogue: 0,0:12:42.28,0:12:44.78,Main,,0,0,0,,Gomu Gomu No...Dialogue: 0,0:12:44.78,0:12:45.74,Main,,0,0,0,,Demir Parça!Dialogue: 0,0:12:45.74,0:12:48.74,Main,,0,0,0,,...Dev Tabanca!Dialogue: 0,0:13:00.42,0:13:02.63,Main,,0,0,0,,O da ne?!Dialogue: 0,0:13:20.69,0:13:25.45,Thoughts,,0,0,0,,Kendimden geçiyorum. Bu şekilde okyanusa düşseydim...Dialogue: 0,0:13:49.97,0:13:51.31,Main,,0,0,0,,Ne oldu öyle?Dialogue: 0,0:13:51.31,0:13:53.27,Main,,0,0,0,,Acele edin ve yaralılara yardım edin!Dialogue: 0,0:13:59.10,0:14:00.23,Main,,0,0,0,,Ne o?!Dialogue: 0,0:14:00.23,0:14:02.65,Main,,0,0,0,,– Canavar? – Hayır, şeytan meyvesi kullanıcısı!Dialogue: 0,0:14:04.65,0:14:09.07,Thoughts,,0,0,0,,Bir savaş gemisi güvertesi? Kurtuldum.Dialogue: 0,0:14:09.07,0:14:10.74,Main,,0,0,0,,Köprü tarafından geldi.Dialogue: 0,0:14:10.74,0:14:11.78,Main,,0,0,0,,Korsan mı?Dialogue: 0,0:14:11.78,0:14:14.58,Main,,0,0,0,,Çok kocaman bir el de gördüm!Dialogue: 0,0:14:14.58,0:14:17.29,Main,,0,0,0,,Durun, durun, durun dedim!Dialogue: 0,0:14:17.29,0:14:21.34,Main,,0,0,0,,İlerisi tehlikeli! Su bizi yutacak!Dialogue: 0,0:14:21.34,0:14:23.93,Main,,0,0,0,,Suyu duyamıyor musunuz?!Dialogue: 0,0:14:23.93,0:14:28.97,Main,,0,0,0,,Bu tüneli su bassaydı bile  hepimiz boğulmaz mıydık?Dialogue: 0,0:14:28.97,0:14:31.80,Main,,0,0,0,,Zoro-kun, suyu duymuyor musun?Dialogue: 0,0:14:31.80,0:14:35.43,Main,,0,0,0,,Evet, biraz tuhaf gibi.Dialogue: 0,0:14:35.43,0:14:37.39,Main,,0,0,0,,Durun artık!Dialogue: 0,0:14:37.39,0:14:40.10,Main,,0,0,0,,Başka yol yok! Devam etmeliyiz!Dialogue: 0,0:14:43.77,0:14:45.09,Main,,0,0,0,,Biliyordum!Dialogue: 0,0:14:45.09,0:14:47.28,Main,,0,0,0,,Yaşlı kadın ve Nami, su tarafından kovalanıyor!Dialogue: 0,0:14:48.70,0:14:51.57,Main,,0,0,0,,Ah! Korsan abiler!Dialogue: 0,0:14:52.03,0:14:54.74,Main,,0,0,0,,Suyla ilgili bir şey yapın!Dialogue: 0,0:14:54.74,0:14:56.66,Main,,0,0,0,,Ne yapmamız gerekiyor ki?Dialogue: 0,0:14:56.66,0:14:59.92,Main,,0,0,0,,Gördünüz mü, tünel tamamiyle suya gömülecek!Dialogue: 0,0:14:59.92,0:15:03.24,Main,,0,0,0,,Nami-san, benimle olmak için geliyor!Dialogue: 0,0:15:03.24,0:15:04.14,Main,,0,0,0,,Ne kadar iyimser!Dialogue: 0,0:15:04.14,0:15:06.17,Main,,0,0,0,,Kahretsin. Burada tıkılıp kalacağız.Dialogue: 0,0:15:09.97,0:15:12.47,Main,,0,0,0,,Kesemiyor muyum? Sadece taş veya çelik değil mi?Dialogue: 0,0:15:12.47,0:15:14.14,Main,,0,0,0,,Burası bir deniz altı tünelli.Dialogue: 0,0:15:14.14,0:15:17.47,Main,,0,0,0,,Muhtemelen su basıncına dayanacak kadar sert bir şeyden yapılmıştır.Dialogue: 0,0:15:17.47,0:15:19.77,Main,,0,0,0,,Yani kaçacak yer yok mu?!Dialogue: 0,0:15:30.61,0:15:32.78,Main,,0,0,0,,Burası güvenli değil! Öleceğiz!Dialogue: 0,0:15:32.78,0:15:34.20,Main,,0,0,0,,Acele edin!Dialogue: 0,0:15:34.20,0:15:37.24,Main,,0,0,0,,Faydasız, deniz treni gitmiyor!Dialogue: 0,0:15:37.24,0:15:39.16,Main,,0,0,0,,Bir makinist yok mu?Dialogue: 0,0:15:40.04,0:15:42.42,Main,,0,0,0,,Şimdiden bu kadar uzağa geldiler, çabuk!Dialogue: 0,0:15:50.51,0:15:51.72,Main,,0,0,0,,Koramiral.Dialogue: 0,0:15:51.72,0:15:54.68,Main,,0,0,0,,Tereddüt Köprüsü'ndeki  Nico Robin'in yakalanma durumu nedir?Dialogue: 0,0:15:54.68,0:15:56.97,Main,,0,0,0,,– Boşverin. – Ama...Dialogue: 0,0:15:56.97,0:16:01.94,Main,,0,0,0,,O adam bu adada ve Nico Robin'e eşlik etmekle görevlendirildi.Dialogue: 0,0:16:02.56,0:16:04.90,Main,,0,0,0,,Karışmamız için bir sebep yok.Dialogue: 0,0:16:05.73,0:16:09.36,Main,,0,0,0,,Biz sadece Tereddüt Köprüsü dışındaki her şeyi yok edeceğiz.Dialogue: 0,0:16:09.36,0:16:10.44,Main,,0,0,0,,Emredersiniz!Dialogue: 0,0:16:10.86,0:16:12.07,Main,,0,0,0,,Koramiral,...Dialogue: 0,0:16:12.07,0:16:16.49,Main,,0,0,0,,..."o adam" derken CP9'daki  Rob Lucci'den mi bahsediyorsunuz?Dialogue: 0,0:16:22.54,0:16:24.54,Main,,0,0,0,,Gerçekten şeytan meyvesi kullanıcısı!Dialogue: 0,0:16:26.42,0:16:28.34,Main,,0,0,0,,Kimsin sen?Dialogue: 0,0:16:30.88,0:16:33.30,Main,,0,0,0,,Kimsin dedik! Cevap ver!Dialogue: 0,0:16:33.30,0:16:35.55,Main,,0,0,0,,Kesin şunu, aptallar!Dialogue: 0,0:16:35.55,0:16:36.47,Main,,0,0,0,,Kaptan?Dialogue: 0,0:16:36.97,0:16:38.81,Main,,0,0,0,,Hemen indirin silahlarınızı.Dialogue: 0,0:16:38.81,0:16:41.18,Main,,0,0,0,,O adamın kim olduğunu biliyor musunuz?!Dialogue: 0,0:16:41.18,0:16:44.98,Main,,0,0,0,,O, CP9'dan Rob Lucci!Dialogue: 0,0:16:52.36,0:16:53.86,Main,,0,0,0,,Rob Lucci-san...Dialogue: 0,0:16:53.86,0:16:55.45,Main,,0,0,0,,Ne?! O...Dialogue: 0,0:16:55.45,0:16:57.53,Main,,0,0,0,,Üzgünüm, lütfen bağışlayın!Dialogue: 0,0:16:57.53,0:17:00.24,Main,,0,0,0,,Çenenizi kapalı tutun.  Sinirimi bozuyorsunuz.Dialogue: 0,0:17:06.58,0:17:09.88,Main,,0,0,0,,Rob Lucci'yle ilgili söylentiler duydum ama...Dialogue: 0,0:17:09.88,0:17:11.55,Main,,0,0,0,,...gerçekten o kadar gücü var mı?Dialogue: 0,0:17:12.80,0:17:15.88,Main,,0,0,0,,On beş yıl önceydi.Dialogue: 0,0:17:15.88,0:17:21.72,Main,,0,0,0,,Bir krallıktaki 500 asker, korsanlar tarafından yakalandı.Dialogue: 0,0:17:24.06,0:17:29.44,Main,,0,0,0,,Korsanların kaptanı,  rehinelerin canlarına karşılık tahtı istedi.Dialogue: 0,0:17:29.44,0:17:34.71,Main,,0,0,0,,Rehinelerin canlarını önemseyen krallık, teslim olmanın eşiğindeydi.Dialogue: 0,0:17:34.71,0:17:37.97,Main,,0,0,0,,Bu yüzden Dünya Hükümeti tek bir çocuk gönderdi.Dialogue: 0,0:17:39.03,0:17:40.16,Thoughts,,0,0,0,,Çocuk?Dialogue: 0,0:17:40.16,0:17:43.83,Thoughts,,0,0,0,,Lanet olası hükümet. Bunu bize nasıl yaparlar?Dialogue: 0,0:17:48.25,0:17:49.22,Main,,0,0,0,,Kazı!Dialogue: 0,0:17:55.09,0:17:56.09,Main,,0,0,0,,Bacak Fırtınası!Dialogue: 0,0:18:14.36,0:18:17.61,Main,,0,0,0,,Çocuk korsan üssüne sızdı...Dialogue: 0,0:18:17.61,0:18:22.53,Main,,0,0,0,,...ve rehin tutulan 500 askeri öldürdü.Dialogue: 0,0:18:22.53,0:18:24.75,Main,,0,0,0,,Hepsini mi?Dialogue: 0,0:18:24.75,0:18:28.00,Main,,0,0,0,,Delilik! Bunu yapmasına izin var mıydı?Dialogue: 0,0:18:28.00,0:18:31.96,Main,,0,0,0,,Dünya Hükümeti'yle birlikte olsa bile, adalet için olsa bile,...Dialogue: 0,0:18:33.38,0:18:35.21,Main,,0,0,0,,Ü-Üzgünüm!Dialogue: 0,0:18:35.21,0:18:39.93,Captions,,0,0,0,,AdaletDialogue: 0,0:18:35.96,0:18:39.93,Main,,0,0,0,,Anlıyor musun? Adalet sadece çocuk oyunu değildir!Dialogue: 0,0:18:39.93,0:18:42.22,Main,,0,0,0,,Bunu sakın unutmayın!Dialogue: 0,0:18:42.22,0:18:43.35,Main,,0,0,0,,Emredersiniz!Dialogue: 0,0:18:44.60,0:18:47.02,Main,,0,0,0,,Elbette korsanlar kızdı...Dialogue: 0,0:18:47.02,0:18:50.81,Main,,0,0,0,,...ve ceset dağının tepesinde duran çocuğa yoğun bir saldırı başlattılar.Dialogue: 0,0:18:51.81,0:18:57.28,Main,,0,0,0,,Ama çocuk patlamalardan çıktı, kaptanın başını aldı...Dialogue: 0,0:18:57.69,0:19:00.70,Main,,0,0,0,,...ve bu krize tek başına son verdi.Dialogue: 0,0:19:02.91,0:19:05.79,Main,,0,0,0,,B-Bu da ne?Dialogue: 0,0:19:08.79,0:19:12.46,Main,,0,0,0,,Kıymetli rehinelerimize bunu nasıl yaparsın?!Dialogue: 0,0:19:12.46,0:19:14.42,Main,,0,0,0,,Onlar suçluydu.Dialogue: 0,0:19:15.17,0:19:17.92,Main,,0,0,0,,Bu yüzden adalet adına onları öldürdüm.Dialogue: 0,0:19:17.92,0:19:19.30,Main,,0,0,0,,Suçlu mu?Dialogue: 0,0:19:19.30,0:19:22.97,Main,,0,0,0,,Bir krallığın askerleri olarak güçsüz olmak suçtur.Dialogue: 0,0:19:22.97,0:19:24.81,Main,,0,0,0,,Beyler, haklayın onu!Dialogue: 0,0:19:40.28,0:19:43.07,Main,,0,0,0,,Bundan nasıl sağ çıktı?Dialogue: 0,0:19:47.46,0:19:48.58,Main,,0,0,0,,Kazı!Dialogue: 0,0:19:56.11,0:19:57.00,Main,,0,0,0,,Parmak Tabanca!Dialogue: 0,0:20:05.60,0:20:07.10,Main,,0,0,0,,Patron.Dialogue: 0,0:20:07.10,0:20:09.06,Main,,0,0,0,,C-Canavar bu!Dialogue: 0,0:20:13.98,0:20:17.52,Main,,0,0,0,,Sırtı top ateşinin yaralarıyla kaplanan çocuk,...Dialogue: 0,0:20:17.52,0:20:21.19,Main,,0,0,0,,...sadece 13 yaşındaydı ve CP9 ajanlarından biriydi.Dialogue: 0,0:20:21.19,0:20:24.61,Main,,0,0,0,,Karanlık adalet için yaşıyor. CP9 tarihinin en güçlüsü.Dialogue: 0,0:20:24.61,0:20:28.74,Main,,0,0,0,,Acımasız bir ölüm silahı olarak bilinir.Dialogue: 0,0:20:28.74,0:20:32.16,Main,,0,0,0,,13 yaşındaki birinin bu kadar gücü olması...Dialogue: 0,0:20:32.16,0:20:37.21,Main,,0,0,0,,İşte bu yüzden tek yapmamız gereken  kendi görevimizi yerine getirmek.Dialogue: 0,0:20:38.04,0:20:39.92,Main,,0,0,0,,Gomu Gomu No...Dialogue: 0,0:20:39.92,0:20:42.55,Main,,0,0,0,,...Roket!Dialogue: 0,0:20:42.55,0:20:43.93,Main,,0,0,0,,Bu kez ne oldu?Dialogue: 0,0:20:44.43,0:20:46.30,Main,,0,0,0,,Bu tarafa başka bir şey geliyor!Dialogue: 0,0:20:46.30,0:20:49.26,Main,,0,0,0,,O adam 100 milyon ödüllü Hasır Şapkalı Luffy!Dialogue: 0,0:20:49.26,0:20:50.56,Main,,0,0,0,,Gerçekten çok şişman!Dialogue: 0,0:20:50.56,0:20:52.68,Main,,0,0,0,,İşte oradasın, güvercinli adam!Dialogue: 0,0:20:52.68,0:20:54.19,Main,,0,0,0,,Vurun onu!Dialogue: 0,0:20:57.44,0:21:00.32,Main,,0,0,0,,Bu işe yaramaz!  Bunun için fazla güçlüyüm!Dialogue: 0,0:21:05.41,0:21:09.79,Main,,0,0,0,,Gomu Gomu No Dev Balta!Dialogue: 0,0:21:13.29,0:21:15.42,Main,,0,0,0,,Ne?! Dev mi?Dialogue: 0,0:21:45.70,0:21:49.45,Main,,0,0,0,,Gomu Gomu No Dev Kamçı!Dialogue: 0,0:21:52.24,0:21:54.33,Main,,0,0,0,,Yoldan çekilin!Dialogue: 0,0:21:54.33,0:21:55.71,Main,,0,0,0,,Direk yıkılıyor!Dialogue: 0,0:21:55.71,0:21:57.79,Main,,0,0,0,,Düşüyor!Dialogue: 0,0:21:57.79,0:22:01.21,Main,,0,0,0,,Bunların dövüşü gerçekten tehlikeli!Dialogue: 0,0:22:03.17,0:22:05.26,Main,,0,0,0,,Kürdan Parmak Tabanca!Dialogue: 0,0:22:08.68,0:22:12.01,Main,,0,0,0,,Gücün artıyor ama görünüşe göre hızın azalıyor.Dialogue: 0,0:22:16.64,0:22:18.65,Main,,0,0,0,,Bacak Fırtınası: Galip Kuş!Dialogue: 0,0:22:28.41,0:22:30.91,Main,,0,0,0,,Çelik tabakayı kesti?!Dialogue: 0,0:22:30.91,0:22:32.45,Main,,0,0,0,,Bu gemi tehlikede!Dialogue: 0,0:22:37.12,0:22:39.67,Main,,0,0,0,,Çok yakındı, beni neredeyse ikiye bölüyordu.Dialogue: 0,0:22:45.55,0:22:47.30,Main,,0,0,0,,Bunu gördün mü, Cutty Flam?Dialogue: 0,0:22:47.30,0:22:51.80,Main,,0,0,0,,İşiniz bitti! Hayır, başından beri bitmişti zaten!Dialogue: 0,0:22:51.80,0:22:54.43,Main,,0,0,0,,Kapa çeneni! Hala anlamıyor musun?!Dialogue: 0,0:22:54.43,0:22:57.10,Main,,0,0,0,,Hasır Şapka'yla dövüşen kişi, Lucci!Dialogue: 0,0:22:57.10,0:22:59.31,Main,,0,0,0,,CP9 tarihinin en güçlü kişisi!Dialogue: 0,0:22:59.31,0:23:01.98,Main,,0,0,0,,Diğerlerine ne olduğunu bilmiyorum...Dialogue: 0,0:23:01.98,0:23:04.27,Main,,0,0,0,,...ama o gerçekten özel!Dialogue: 0,0:23:04.27,0:23:09.11,Main,,0,0,0,,Hasır Şapka'nın işini bitirdikten sonra sıra sana gelecek, Cutty Flam!Dialogue: 0,0:23:09.78,0:23:11.87,Thoughts,,0,0,0,,Sana güveniyorum, Hasır Şapka.Dialogue: 0,0:23:11.87,0:23:15.29,Main,,0,0,0,,Neler oluyor? Söyleyin.Dialogue: 0,0:23:15.29,0:23:17.37,Main,,0,0,0,,Evet, Koramiral!Dialogue: 0,0:23:17.37,0:23:21.79,Main,,0,0,0,,Görünüşe göre Hasır Şapkalı Luffy ve CP9'dan Rob Lucci şu anda dövüşüyor!Dialogue: 0,0:23:21.79,0:23:23.92,Main,,0,0,0,,Dört no'lu gemi ağır hasır gördü!Dialogue: 0,0:23:23.92,0:23:27.13,Main,,0,0,0,,Rob Lucci ölmeyecek.Dialogue: 0,0:23:27.13,0:23:31.68,Main,,0,0,0,,Tüm gemiler. 4 numaralı gemiyi vurmaya hazırlanın.Dialogue: 0,0:23:31.68,0:23:33.80,Main,,0,0,0,,Beş saniye içinde eş zamanlı atış!Dialogue: 0,0:23:34.22,0:23:36.06,Main,,0,0,0,,Koramiral, lütfen kesin şunu!Dialogue: 0,0:23:36.06,0:23:38.10,Main,,0,0,0,,O gemide bin adamımız var!Dialogue: 0,0:23:49.53,0:23:53.07,Main,,0,0,0,,Bir anlık tereddütün korkunç sonuçları olabilir.Dialogue: 0,0:23:53.07,0:23:56.03,Main,,0,0,0,,Geleceği hiç düşünmüyor musunuz?Dialogue: 0,0:24:06.84,0:24:08.05,Main,,0,0,0,,Ateş!Dialogue: 0,0:24:14.76,0:24:14.84,Credits,,0,0,0,,Editing:  Galaxy 9000  Timing: PhosCity  Quality Control: danpmss, DolphinWeabu, Honoka, Galaxy 9000, Pepperjack  Soundtracking:  Halee  Graphics:  Datenshi  Karaoke: KaitouYahiko  Translation: Crunchyroll, GaijinDialogue: 0,0:24:14.84,0:24:14.89,Credits,,0,0,0,,Editing:  Galaxy 9000  Timing: PhosCity  Quality Control: danpmss, DolphinWeabu, Honoka, Galaxy 9000, Pepperjack  Soundtracking:  Halee  Graphics:  Datenshi  Karaoke: KaitouYahiko  Translation: Crunchyroll, GaijinDialogue: 0,0:24:14.89,0:24:14.93,Credits,,0,0,0,,Editing:  Galaxy 9000  Timing: PhosCity  Quality Control: danpmss, DolphinWeabu, Honoka, Galaxy 9000, Pepperjack  Soundtracking:  Halee  Graphics:  Datenshi  Karaoke: KaitouYahiko  Translation: Crunchyroll, GaijinDialogue: 0,0:24:14.93,0:24:14.97,Credits,,0,0,0,,Editing:  Galaxy 9000  Timing: PhosCity  Quality Control: danpmss, DolphinWeabu, Honoka, Galaxy 9000, Pepperjack  Soundtracking:  Halee  Graphics:  Datenshi  Karaoke: KaitouYahiko  Translation: Crunchyroll, GaijinDialogue: 0,0:24:14.97,0:24:15.01,Credits,,0,0,0,,Editing:  Galaxy 9000  Timing: PhosCity  Quality Control: danpmss, DolphinWeabu, Honoka, Galaxy 9000, Pepperjack  Soundtracking:  Halee  Graphics:  Datenshi  Karaoke: KaitouYahiko  Translation: Crunchyroll, GaijinDialogue: 0,0:24:15.01,0:24:15.05,Credits,,0,0,0,,Editing:  Galaxy 9000  Timing: PhosCity  Quality Control: danpmss, DolphinWeabu, Honoka, Galaxy 9000, Pepperjack  Soundtracking:  Halee  Graphics:  Datenshi  Karaoke: KaitouYahiko  Translation: Crunchyroll, GaijinDialogue: 0,0:24:15.05,0:24:15.10,Credits,,0,0,0,,Editing:  Galaxy 9000  Timing: PhosCity  Quality Control: danpmss, DolphinWeabu, Honoka, Galaxy 9000, Pepperjack  Soundtracking:  Halee  Graphics:  Datenshi  Karaoke: KaitouYahiko  Translation: Crunchyroll, GaijinDialogue: 0,0:24:15.10,0:24:15.14,Credits,,0,0,0,,Editing:  Galaxy 9000  Timing: PhosCity  Quality Control: danpmss, DolphinWeabu, Honoka, Galaxy 9000, Pepperjack  Soundtracking:  Halee  Graphics:  Datenshi  Karaoke: KaitouYahiko  Translation: Crunchyroll, 