Arial,20,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,2,2,2,10,10,10,1Style: Karaoke,Duality,65,&H002FıAAF,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2,0,8,10,10,10,1Style: Translation,Duality,65,&H002FıAAF,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2,0,2,10,10,10,1Style: Kanji,Duality,65,&H002FıAAF,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2,0,8,10,10,120,1Style: Lyrics,Futura Md BT,39.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1.5,1,2,10,10,10,1Style: Author,Impress BT,20.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.8,0.8,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.71,0:00:03.37,Lyrics,,0,0,0,,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪Dialogue: 0,0:00:03.59,0:00:06.46,Lyrics,,0,0,0,,♪ Bayrağımızı süsleyip, gökyüzüne kaldırarak. ♪Dialogue: 0,0:00:12.77,0:00:18.06,Lyrics,,0,0,0,,♪ Sonsuz okyanusu geçip aramaya gidelim. ♪Dialogue: 0,0:00:18.86,0:00:21.81,Lyrics,,0,0,0,,♪ Henüz kimse tarafından...Dialogue: 0,0:00:21.90,0:00:23.94,Lyrics,,0,0,0,,...bulunmamış bu dünyanın mucizesini. ♪Dialogue: 0,0:00:24.82,0:00:27.96,Lyrics,,0,0,0,,♪ Çarpıp duran göğsümüzdeki...Dialogue: 0,0:00:27.96,0:00:29.71,Lyrics,,0,0,0,,...aynı hislerle devam etmeliyiz. ♪Dialogue: 0,0:00:29.71,0:00:35.59,Lyrics,,0,0,0,,♪ Hayaller peşinde koşanlar tarafından bırakılmış ayak izleri. ♪Dialogue: 0,0:00:36.42,0:00:39.39,Lyrics,,0,0,0,,♪ Ne tür bir fırtınalı gece olursa olsun,...Dialogue: 0,0:00:39.39,0:00:42.39,Lyrics,,0,0,0,,...kalplerimizin bir olmasını sağlarsak...Dialogue: 0,0:00:42.39,0:00:46.54,Lyrics,,0,0,0,,...bu zorluğun üstesinden gelebileceğiz! ♪Dialogue: 0,0:00:46.68,0:00:47.86,Lyrics,,0,0,0,,♪ Her zaman ♪Dialogue: 0,0:00:48.76,0:00:51.59,Lyrics,,0,0,0,,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪Dialogue: 0,0:00:51.72,0:00:54.55,Lyrics,,0,0,0,,♪ Bayrağımızı dalgalandırıp gökyüzüne kaldırarak. ♪Dialogue: 0,0:00:54.60,0:00:57.14,Lyrics,,0,0,0,,♪ Kimseye göstermeyeceğiz. ♪Dialogue: 0,0:00:57.23,0:01:00.58,Lyrics,,0,0,0,,♪ Gözlerimizde yaşlar olsa bile. ♪Dialogue: 0,0:01:00.77,0:01:03.52,Lyrics,,0,0,0,,♪ Peşinden gidelim, peşinden gidelim! ♪Dialogue: 0,0:01:03.69,0:01:06.52,Lyrics,,0,0,0,,♪ Hayallerimize giden doğru yolu...Dialogue: 0,0:01:06.61,0:01:09.23,Lyrics,,0,0,0,,...gösteren pusulanın. ♪Dialogue: 0,0:01:09.23,0:01:11.40,Lyrics,,0,0,0,,♪ Durmayacağız. ♪Dialogue: 0,0:01:11.42,0:01:14.42,Lyrics,,0,0,0,,♪ Dünyayı dolaşarak...Dialogue: 0,0:01:14.45,0:01:15.85,Lyrics,,0,0,0,,...yeniden başlayalım! ♪Dialogue: 0,0:01:18.83,0:01:21.49,Lyrics,,0,0,0,,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪Dialogue: 0,0:01:21.80,0:01:24.54,Lyrics,,0,0,0,,♪ Hedefimize doğru herkesten daha fazla. ♪Dialogue: 0,0:01:24.63,0:01:27.12,Lyrics,,0,0,0,,♪ Şimdi kaçmazsak,...Dialogue: 0,0:01:27.22,0:01:30.54,Lyrics,,0,0,0,,...yarını sıkı sıkıya kavrayabileceğiz! ♪Dialogue: 0,0:01:30.60,0:01:33.63,Lyrics,,0,0,0,,♪ Peşinden gidelim, peşinden gidelim! ♪Dialogue: 0,0:01:33.68,0:01:36.51,Lyrics,,0,0,0,,♪ Gözlerinden yansıtılmış tüm şimdiki zamanın. ♪Dialogue: 0,0:01:36.56,0:01:38.93,Lyrics,,0,0,0,,♪ Bembeyaz bir kalp...Dialogue: 0,0:01:39.15,0:01:41.43,Lyrics,,0,0,0,,...bana tüm hikayeyi anlatacak! ♪Dialogue: 0,0:01:41.73,0:01:44.43,Lyrics,,0,0,0,,♪ Yepyeni bir dünyada...Dialogue: 0,0:01:44.53,0:01:45.83,Lyrics,,0,0,0,,...yeniden başlayalım! ♪Dialogue: 0,0:01:50.16,0:02:00.16,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:14:59.03,0:15:09.03,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:25:10.00,0:25:20.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:01:50.16,0:01:55.79,Title,,0,0,0,,Kovuldular!Dialogue: 0,0:01:56.54,0:01:59.71,Main,,0,0,0,,H-Hey! O kılıç ustasını tanıyorum!Dialogue: 0,0:01:59.71,0:02:03.02,Main,,0,0,0,,Hasır Şapka'nın emrindeki,  Korsan Avcısı Zoro!Dialogue: 0,0:02:04.49,0:02:05.74,Main,,0,0,0,,Onun emrinde olduğunu söylüyorlar.Dialogue: 0,0:02:05.74,0:02:09.36,Main,,0,0,0,,O zaman sen ondan daha aşağı değil misin?  Korsan A.Dialogue: 0,0:02:10.95,0:02:12.50,Main,,0,0,0,,O zaman B.Dialogue: 0,0:02:13.36,0:02:16.98,Main,,0,0,0,,Pislik! Kafama ödül konulunca,  seninki benimkinin yanında ufak kalacak!Dialogue: 0,0:02:16.98,0:02:17.93,Main,,0,0,0,,O zaman C.Dialogue: 0,0:02:17.93,0:02:19.83,Main,,0,0,0,,Biri konuşurken dinlemeyi öğren!Dialogue: 0,0:02:19.83,0:02:21.81,Main,,0,0,0,,Hey. İkiniz de kesin şunu.Dialogue: 0,0:02:21.81,0:02:23.56,Main,,0,0,0,,Sogeking, onlara katılmıyor musun?Dialogue: 0,0:02:23.56,0:02:25.81,Main,,0,0,0,,Bu da stratejimin bir parçası, Chopper-kun.Dialogue: 0,0:02:25.81,0:02:27.86,Main,,0,0,0,,Ehh? Demek bu yüzden...Dialogue: 0,0:02:28.95,0:02:30.39,Main,,0,0,0,,Trende arkadaşları var!Dialogue: 0,0:02:30.39,0:02:31.22,Main,,0,0,0,,Bulunduk!Dialogue: 0,0:02:31.22,0:02:33.93,Main,,0,0,0,,İçeride hala birkaç kişi olmalı! Çıkmadan önce onları havaya uçurun!Dialogue: 0,0:02:33.93,0:02:36.34,Main,,0,0,0,,Hey, durun!  Nami-san, hala içeride!Dialogue: 0,0:02:36.34,0:02:37.72,Main,,0,0,0,,Ateş!Dialogue: 0,0:02:44.66,0:02:47.58,Main,,0,0,0,,Bu adamlara üç misli ödeteceğim!Dialogue: 0,0:02:47.58,0:02:48.78,Main,,0,0,0,,Dur bakalım, Korsan A.Dialogue: 0,0:02:49.17,0:02:50.09,Main,,0,0,0,,Ne?Dialogue: 0,0:02:50.09,0:02:52.53,Main,,0,0,0,,Böyle bir saldırı,  onun gibi birini öldürmeye yetmez.Dialogue: 0,0:02:52.53,0:02:55.93,Main,,0,0,0,,Çünkü Korsan A olduğun için bu tür şeyleri bilmiyorsun.Dialogue: 0,0:02:55.93,0:02:58.24,Main,,0,0,0,,Seni marimo...Dialogue: 0,0:03:00.75,0:03:03.03,Main,,0,0,0,,Ah, ödümü ko-Dialogue: 0,0:03:05.64,0:03:07.24,Main,,0,0,0,,İyi misin, Sogeking?Dialogue: 0,0:03:08.70,0:03:10.81,Main,,0,0,0,,İyiyim, Chopper-kun.Dialogue: 0,0:03:10.81,0:03:12.52,Main,,0,0,0,,Ateş kes!Dialogue: 0,0:03:13.28,0:03:14.31,Main,,0,0,0,,Ne oldu?Dialogue: 0,0:03:14.63,0:03:15.57,Main,,0,0,0,,Şuna bakın!Dialogue: 0,0:03:15.57,0:03:17.23,Main,,0,0,0,,Hey!Dialogue: 0,0:03:17.60,0:03:20.39,Main,,0,0,0,,Durun, ben sadece yaşlı bir kadınım!Dialogue: 0,0:03:20.39,0:03:24.21,Main,,0,0,0,,Ben sadece bir çocuğum ve bu da küçük bir hayvan! Kırılgan kimseleriz!Dialogue: 0,0:03:25.57,0:03:31.55,Main,,0,0,0,,Hasır Şapkalar,  treni sürmemiz için bizi tehdit etti!Dialogue: 0,0:03:31.55,0:03:33.35,Main,,0,0,0,,Treni sürmemiz için!Dialogue: 0,0:03:39.21,0:03:41.13,Main,,0,0,0,,Nasıl sarhoş bir rehine almış olabilirler?!Dialogue: 0,0:03:41.13,0:03:44.51,Main,,0,0,0,,Çok yakındı.  Rehineleri öldürmek üzereydik!Dialogue: 0,0:03:44.51,0:03:49.77,Main,,0,0,0,,Üstelik o korkak korsanlar, yaşlı bir kadını, bir çocuğu ve küçük bir hayvanı rehin almışlar.Dialogue: 0,0:03:49.77,0:03:50.10,Main,,0,0,0,,Ne?Dialogue: 0,0:03:50.10,0:03:54.10,Main,,0,0,0,,Dumanlar bulut oluşturuyor gibi.Dialogue: 0,0:03:54.61,0:03:57.62,Main,,0,0,0,,Soğuk toplar ve sıcak toplar.Dialogue: 0,0:03:58.21,0:04:00.73,Main,,0,0,0,,Atmosferdeki nem, yoğunlaşarak bulut oluşturur.Dialogue: 0,0:04:01.06,0:04:05.11,Main,,0,0,0,,Nami-swan! Kaçabilmişsin!Dialogue: 0,0:04:05.64,0:04:08.91,Main,,0,0,0,,Hey, bulut gittikçe büyüyor!Dialogue: 0,0:04:08.91,0:04:12.71,Main,,0,0,0,,Nine, nine. Bulut büyüyor.Dialogue: 0,0:04:13.83,0:04:16.63,Main,,0,0,0,,O bulut biraz tehlikeli.Dialogue: 0,0:04:16.63,0:04:19.08,Main,,0,0,0,,Chimney, Gonbe, buraya gelin.Dialogue: 0,0:04:21.49,0:04:24.00,Main,,0,0,0,,Mükemmel İklim Aygıtı'ndan beklendiği gibi.Dialogue: 0,0:04:24.00,0:04:27.62,Main,,0,0,0,,Bulutun büyüklüğü ve hızı  öncekinden tamamen farklı!Dialogue: 0,0:04:27.62,0:04:32.15,Main,,0,0,0,,Elektrik gücünü deneyeceğim!Dialogue: 0,0:04:33.07,0:04:38.12,Main,,0,0,0,,O kız ne yapmaya çalışıyor? Kaçsak iyi olur!Dialogue: 0,0:04:38.12,0:04:40.45,Main,,0,0,0,,İşte geliyor!Dialogue: 0,0:04:41.34,0:04:45.00,Main,,0,0,0,,Yıldırım Tenpo!Dialogue: 0,0:04:55.98,0:05:02.18,Main,,0,0,0,,Olamaaaz!Dialogue: 0,0:05:02.18,0:05:03.86,Main,,0,0,0,,Aşırı güçlü! Öleceğim!Dialogue: 0,0:05:03.86,0:05:05.47,Main,,0,0,0,,Aaaah! Sogeking!Dialogue: 0,0:05:05.47,0:05:07.16,Main,,0,0,0,,Nami, niye Sogeking'e vurdun?!Dialogue: 0,0:05:08.33,0:05:10.30,Main,,0,0,0,,Sorun değil. Sadece içimden geldi.Dialogue: 0,0:05:10.30,0:05:14.18,Main,,0,0,0,,Benim hatam değil! Belli ki senin kullanma şeklinde bir terslik var!Dialogue: 0,0:05:14.57,0:05:18.81,Main,,0,0,0,,Ayrıca Usopp-kun, onu o şekilde kullanılması için yaptığını hatırlamadığını söylüyor!Dialogue: 0,0:05:19.23,0:05:20.27,Main,,0,0,0,,Ama öyle olsa bile...Dialogue: 0,0:05:21.40,0:05:24.52,Main,,0,0,0,,Ne güç ama!  Çoğunun icabına baktı.Dialogue: 0,0:05:27.58,0:05:28.36,Main,,0,0,0,,Ah...Dialogue: 0,0:05:28.36,0:05:29.82,Main,,0,0,0,,Lanet olası, Nami!Dialogue: 0,0:05:29.82,0:05:31.65,Main,,0,0,0,,Bunu niye yaptın?!Dialogue: 0,0:05:31.65,0:05:33.56,Main,,0,0,0,,Özür dile, Sogeking!Dialogue: 0,0:05:33.56,0:05:35.47,Main,,0,0,0,,Sen özür dile! Aptal mısın?!Dialogue: 0,0:05:35.47,0:05:40.36,Main,,0,0,0,,Nami-san! Bu bana, seninle ilk tanıştığımda hissettiğim şoku anımsattı!Dialogue: 0,0:05:40.36,0:05:42.87,Main,,0,0,0,,Bu tayfanın nesi var böyle?Dialogue: 0,0:05:42.87,0:05:47.35,Main,,0,0,0,,O kızın sadece onlara destek olmak için bulunduğunu sanmıştım ama ana dövüşçülerinden biriymiş.Dialogue: 0,0:05:49.49,0:05:53.46,Main,,0,0,0,,Bu arada, önden giden o aptal nerede?Dialogue: 0,0:05:53.46,0:05:57.82,Main,,0,0,0,,Bilmem. Bu ada küçük olmaktan çok uzak.  Aramamız lazım.Dialogue: 0,0:05:58.32,0:05:58.98,Main,,0,0,0,,Ne?Dialogue: 0,0:06:01.50,0:06:03.65,Main,,0,0,0,,Kesinlikle orada!Dialogue: 0,0:06:05.61,0:06:06.91,Main,,0,0,0,,Öyleyse...Dialogue: 0,0:06:07.47,0:06:08.87,Main,,0,0,0,,...peşinden gidelim mi?Dialogue: 0,0:06:16.01,0:06:19.84,Main,,0,0,0,,Lanet olası korsanlar epey kargaşa çıkarıyor!Dialogue: 0,0:06:20.19,0:06:21.73,Main,,0,0,0,,Affedilemez!Dialogue: 0,0:06:22.83,0:06:24.21,Main,,0,0,0,,Al bakalım!Dialogue: 0,0:06:25.03,0:06:27.94,Captions,,0,0,0,,Enies Lobby Ana AdaDialogue: 0,0:06:38.61,0:06:41.46,Main,,0,0,0,,Gomu Gomu No...Dialogue: 0,0:06:41.46,0:06:42.82,Main,,0,0,0,,...Mızrak!Dialogue: 0,0:06:47.66,0:06:49.42,Main,,0,0,0,,Ağacın tepesine zıpladı!Dialogue: 0,0:06:51.85,0:06:55.67,Main,,0,0,0,,Lanet olasıcalar. Bir türlü tükenmiyorlar.  Daha ileri gidemem.Dialogue: 0,0:06:55.67,0:06:57.40,Main,,0,0,0,,Hey, bu tarafa!Dialogue: 0,0:06:58.45,0:06:59.84,Main,,0,0,0,,Aksi yöne mi koşuyorlar?Dialogue: 0,0:07:00.23,0:07:02.60,Main,,0,0,0,,Adamlarımızın bir kısmını  Ana Ada'nın ön kapısına gönderin!Dialogue: 0,0:07:02.60,0:07:07.24,Main,,0,0,0,,Korsanlar kapıyı kırdı ve  içeri girmeye başladı! Onları durdurmalıyız!Dialogue: 0,0:07:07.24,0:07:11.53,Main,,0,0,0,,Geldiler! Bu harika!  Şimdi çok eğleneceğiz!Dialogue: 0,0:07:12.77,0:07:13.85,Main,,0,0,0,,Evet!Dialogue: 0,0:07:13.85,0:07:15.27,Main,,0,0,0,,Çok yazık! Kaçırdın!Dialogue: 0,0:07:15.27,0:07:16.92,Main,,0,0,0,,Orada! Ateş!Dialogue: 0,0:07:16.92,0:07:20.08,Captions,,0,0,0,,Ana Ada, Ada kapısının önüDialogue: 0,0:07:24.01,0:07:25.84,Main,,0,0,0,,Ne oldu?Dialogue: 0,0:07:28.24,0:07:29.57,Main,,0,0,0,,Misafirlerimiz var.Dialogue: 0,0:07:40.56,0:07:43.41,Main,,0,0,0,,Biz, Ön Kapı'yı koruma görevi verilen Kanun Koruyucu Birim'iz.Dialogue: 0,0:07:44.87,0:07:48.01,Main,,0,0,0,,Bu hattı kimse geçemez!Dialogue: 0,0:07:48.01,0:07:50.94,Main,,0,0,0,,Vazgeçin hainler!Dialogue: 0,0:08:03.53,0:08:05.80,Main,,0,0,0,,Tamamen kuşatılmışız gibi görünüyor.Dialogue: 0,0:08:05.80,0:08:07.97,Main,,0,0,0,,Şimdi biraz daha yakından baktığımda,  çok fazla düşman var!Dialogue: 0,0:08:08.92,0:08:10.83,Main,,0,0,0,,Ne olmuş?Dialogue: 0,0:08:11.24,0:08:15.11,Main,,0,0,0,,Küstahça konuşuyor. Beyler, saldı-Dialogue: 0,0:08:23.21,0:08:24.48,Main,,0,0,0,,Tutunun!Dialogue: 0,0:08:42.58,0:08:46.01,Main,,0,0,0,,Biraz eğlenmemize izin verebilirdin.Dialogue: 0,0:08:46.01,0:08:47.15,Main,,0,0,0,,Aptal!Dialogue: 0,0:08:48.09,0:08:50.27,Main,,0,0,0,,Buraya gelmekteki asıl amacınızı unutmayın!Dialogue: 0,0:08:50.27,0:08:52.51,Main,,0,0,0,,Dövüşeceğiniz yer burası değil!Dialogue: 0,0:08:53.06,0:08:57.09,Main,,0,0,0,,Doğru. O kadar çok kişi karşısında, güneş batana kadar orada olurduk.Dialogue: 0,0:09:00.90,0:09:03.06,Main,,0,0,0,,Enerji dolu değiller mi?Dialogue: 0,0:09:03.06,0:09:05.66,Main,,0,0,0,,Ölmeyin!Dialogue: 0,0:09:05.66,0:09:07.98,Main,,0,0,0,,Saldırın!Dialogue: 0,0:09:11.39,0:09:13.12,Main,,0,0,0,,Askerler, kaçın!Dialogue: 0,0:09:13.41,0:09:17.04,Main,,0,0,0,,Bunlar Water 7'dan gelme Kral Boğalar! Onlarla uğraşırken dikkatli olun!Dialogue: 0,0:09:20.38,0:09:21.79,Main,,0,0,0,,Kahretsin!Dialogue: 0,0:09:22.17,0:09:24.00,Main,,0,0,0,,Al bakalım!Dialogue: 0,0:09:28.46,0:09:30.76,Main,,0,0,0,,Size bir kez daha saldırıyoruz!Dialogue: 0,0:09:34.23,0:09:36.64,Main,,0,0,0,,Kanun Koruyucu Birim, hattı yeniden oluşturun!Dialogue: 0,0:09:36.85,0:09:38.12,Main,,0,0,0,,Emredersiniz!Dialogue: 0,0:09:38.12,0:09:43.15,Main,,0,0,0,,Size izin vermeyeceğiz!  Köpeklerimizin bacakları o balıklara yenilmeyecek!Dialogue: 0,0:09:44.27,0:09:46.86,Main,,0,0,0,,Eyvah! Erişiyorlar!Dialogue: 0,0:09:46.86,0:09:47.65,Main,,0,0,0,,Olamaz!Dialogue: 0,0:09:48.03,0:09:49.35,Main,,0,0,0,,Daha hızlı gidemez miyiz?Dialogue: 0,0:09:49.35,0:09:50.93,Main,,0,0,0,,Hey, aşçı-niichan.Dialogue: 0,0:09:53.30,0:09:54.23,Main,,0,0,0,,Ne oldu?Dialogue: 0,0:09:55.40,0:09:57.25,Main,,0,0,0,,Dizginleri sana bırakıyorum.Dialogue: 0,0:09:59.86,0:10:01.21,Main,,0,0,0,,Siz...Dialogue: 0,0:10:13.75,0:10:18.57,Main,,0,0,0,, Onlarla karşılaşırsanız, şu mesajı iletin.Dialogue: 0,0:10:20.34,0:10:22.55,Main,,0,0,0,,"Kovuldunuz!"Dialogue: 0,0:10:24.03,0:10:25.52,Main,,0,0,0,,Kesinlikle.Dialogue: 0,0:10:26.07,0:10:27.92,Main,,0,0,0,,Atlayın!Dialogue: 0,0:10:28.63,0:10:30.23,Main,,0,0,0,,İzin vermeyeceğiz!Dialogue: 0,0:10:30.60,0:10:33.02,Main,,0,0,0,,Size güveniyoruz, Galley-La!Dialogue: 0,0:10:33.57,0:10:35.74,Main,,0,0,0,,Sizi şişleyeceğiz!Dialogue: 0,0:10:35.74,0:10:38.75,Main,,0,0,0,,Yarım Düğüm Hava Hamlesi!Dialogue: 0,0:10:46.38,0:10:49.38,Main,,0,0,0,,Kanun Koruyucu Birim yenildi.Dialogue: 0,0:10:49.38,0:10:52.25,Main,,0,0,0,,Eh! O ahmaklar tedbiri elden bıraktı!Dialogue: 0,0:10:52.25,0:10:56.53,Main,,0,0,0,,Sıradan hiçbir insan  hareketlerimize denk değildir! Gidin!Dialogue: 0,0:10:57.86,0:11:01.86,Main,,0,0,0,,Onlar farkedemeden, kazığa geçirin onları!Dialogue: 0,0:11:08.44,0:11:11.40,Main,,0,0,0,,Yine yenildiler!Dialogue: 0,0:11:12.29,0:11:13.66,Main,,0,0,0,,Bu adamlar neyin nesi böyle?Dialogue: 0,0:11:17.89,0:11:20.58,Main,,0,0,0,,Çok güçlüler!Dialogue: 0,0:11:28.71,0:11:30.94,Main,,0,0,0,,Burayla biz ilgileneceğiz.Dialogue: 0,0:11:30.94,0:11:34.93,Captions,,0,0,0,,Enies Lobby Adalet KulesiDialogue: 0,0:11:44.01,0:11:48.98,Main,,0,0,0,,O zamandan beri mizacın hiç değişmemiş,  Cutty Flam.Dialogue: 0,0:11:48.98,0:11:54.40,Main,,0,0,0,,Hala yaşadığını ve planların sende olduğunu daha erken bilseydim,...Dialogue: 0,0:11:54.40,0:11:56.82,Main,,0,0,0,,...arama zahmetine girmek zorunda kalmazdım.Dialogue: 0,0:11:57.35,0:12:03.71,Main,,0,0,0,,Şu durumunda, seni geçmiş günahlarınla kontrol etmek aşırı derecede kolay olurdu.Dialogue: 0,0:12:05.61,0:12:10.97,Main,,0,0,0,,Diğer taraftan kardeşin Iceberg,  baş belasının tekiydi.Dialogue: 0,0:12:11.54,0:12:12.79,Main,,0,0,0,,Tom'un çırağı olarak,...Dialogue: 0,0:12:12.79,0:12:19.19,Main,,0,0,0,,...Water 7'ın tersanelerini bir araya getirdi ve onları büyük bir şirketin içine yerleştirdi.Dialogue: 0,0:12:19.19,0:12:23.35,Main,,0,0,0,,Nefret etmesi gerektiği Dünya Hükümeti'yle müttefik olma inisiyatifinden faydalandı.Dialogue: 0,0:12:23.90,0:12:28.80,Main,,0,0,0,,Şirketi fazla geçmeden, Dünya Hükümeti için iyi kurulmuş bir teminatçı haline geldi.Dialogue: 0,0:12:29.69,0:12:32.74,Main,,0,0,0,,Galley-La gemi yapım şirketinin ve...Dialogue: 0,0:12:32.74,0:12:35.84,Main,,0,0,0,,...su başkenti Water 7'ın başkanı oldu.Dialogue: 0,0:12:36.33,0:12:41.44,Main,,0,0,0,,Hükümet için, hiç kimsenin şüphelenmeyeceği vazgeçilmez bir adam oldu.Dialogue: 0,0:12:41.44,0:12:45.67,Main,,0,0,0,,Bu, ona karşı hiçbir şey yapamayacağımız anlamına geliyordu.Dialogue: 0,0:12:47.73,0:12:51.61,Flashbacks,,0,0,0,,Pislik! Gemilerinle Dünya Hükümeti'ne yardım etmiyor musun?!Dialogue: 0,0:12:51.61,0:12:55.14,Flashbacks,,0,0,0,,Benimle uğraşma!  Seni kesinlikle affetmeyeceğim!Dialogue: 0,0:12:56.12,0:12:59.42,Thoughts,,0,0,0,,Bu yüzden Hükümet'le anlaşma yapmış.Dialogue: 0,0:12:59.42,0:13:02.88,Main,,0,0,0,,O adam akıllı biriydi.Dialogue: 0,0:13:05.25,0:13:08.93,Main,,0,0,0,,Ama rüzgar benden yana esmeye başladı!Dialogue: 0,0:13:08.93,0:13:14.03,Main,,0,0,0,,Uyuşukluğumdan silkinmek ve planlarımı desteklemek üzereyken...Dialogue: 0,0:13:14.39,0:13:17.45,Main,,0,0,0,,...Amiral Aokiji'den harika haberler aldım!Dialogue: 0,0:13:18.02,0:13:23.92,Main,,0,0,0,,Kötü kadın Nico Robin'in bir korsan gemisine bindiğini ve Water 7'a doğru geldiğini söylüyordu.Dialogue: 0,0:13:24.52,0:13:28.63,Main,,0,0,0,,Kendimi sakinleştirmek için bir fincan kahve aldım.Dialogue: 0,0:13:29.13,0:13:34.60,Main,,0,0,0,,Yıkım Çağrısı'nı kullanma izni de dahil olmak üzere, bütün bilgiyi planıma ekledim.Dialogue: 0,0:13:34.62,0:13:38.32,Main,,0,0,0,,Planımda birkaç değişiklik olmuş olsa bile...Dialogue: 0,0:13:38.82,0:13:45.67,Main,,0,0,0,,Bakın! Antik silahın uyanışının  anahtarları şu anda elimde!Dialogue: 0,0:13:48.67,0:13:54.00,Main,,0,0,0,,Anlıyor musunuz?  Dünyanın tüm rüzgarları şu anda bana doğru esiyor!Dialogue: 0,0:14:01.25,0:14:07.38,Main,,0,0,0,,İstemiş olsam, şu anda güçlü bir ülkeye hükmetme yeteneği benim kontrolümde!Dialogue: 0,0:14:09.07,0:14:13.35,Main,,0,0,0,,Aokiji, niye sana Yıkım Çağrısı gücünü verdi?Dialogue: 0,0:14:35.05,0:14:39.78,Main,,0,0,0,,Beni sorgulama cüretini gösterme! Seni küstah sürtük!Dialogue: 0,0:14:40.46,0:14:46.23,Main,,0,0,0,,Benim için olmasaydı,  varlığının değeri beş para etmezdi!Dialogue: 0,0:14:48.82,0:14:52.52,Main,,0,0,0,,Bana teşekkür ediyor olmalısın!Dialogue: 0,0:14:54.11,0:14:58.66,Main,,0,0,0,,Hem de şeytani Ohara şehrinin pis kanını taşıyorken!Dialogue: 0,0:14:59.02,0:15:01.44,Main,,0,0,0,,Pekâla, beni iyi dinle.Dialogue: 0,0:15:01.81,0:15:08.79,Main,,0,0,0,,Şu andan itibaren, kendine defalarca kez ölmeyi tercih ettiğini söyleyecek kadar çok acı çekeceksin.Dialogue: 0,0:15:08.79,0:15:10.88,Main,,0,0,0,,Hazır olsan iyi olur.Dialogue: 0,0:15:10.88,0:15:12.23,Main,,0,0,0,,Seni çok fazla yaralayacağım.Dialogue: 0,0:15:12.58,0:15:13.51,Main,,0,0,0,,Seni kullanacağım...Dialogue: 0,0:15:13.87,0:15:15.40,Main,,0,0,0,,...ve denize atacağım!Dialogue: 0,0:15:15.86,0:15:19.01,Main,,0,0,0,,Varlığın bu kadar günah işte!Dialogue: 0,0:15:24.93,0:15:28.81,Main,,0,0,0,,Ah, sahi.  Demin birkaç haber aldık.Dialogue: 0,0:15:29.83,0:15:36.12,Main,,0,0,0,,Seni fazlasıyla geri almak istediği için buraya saldıran bir aptalın varlığına dair bir rapor aldım.Dialogue: 0,0:15:37.67,0:15:38.62,Main,,0,0,0,,Olamaz!Dialogue: 0,0:15:38.62,0:15:44.54,Main,,0,0,0,,Önemli bir şey değil! Şimdiye dek hepsi yakalanmış olmalı.Dialogue: 0,0:15:44.54,0:15:47.21,Main,,0,0,0,,Hasır Şapkalı Luffy ve tayfası.Dialogue: 0,0:15:49.15,0:15:51.14,Thoughts,,0,0,0,,Ne kadar inatçı insanlar.Dialogue: 0,0:15:53.61,0:15:59.19,Main,,0,0,0,,Enies Lobby'nin on bin askeri önünde, çöplükten başka bir şey değiller.Dialogue: 0,0:15:59.19,0:16:03.21,Main,,0,0,0,,Neyse, hapisaneye bir gemi göndermek üzereydim.Dialogue: 0,0:16:03.21,0:16:05.24,Main,,0,0,0,,Bir hatıra olarak mükemmel bir şey.Dialogue: 0,0:16:05.24,0:16:10.29,Main,,0,0,0,,Cutty Flam'la birlikte onları  Impel Down'a göndermeyi planlıyorum.Dialogue: 0,0:16:15.89,0:16:18.34,Main,,0,0,0,,Dur!  Bu anlaşmamızdan farklı değil mi?!Dialogue: 0,0:16:18.34,0:16:23.26,Main,,0,0,0,,Sizinle işbirliği yapma şartım, onların  güvenli bir şekilde kaçmalarına izin vermenizdi!Dialogue: 0,0:16:32.91,0:16:35.71,Main,,0,0,0,,Ne diye bu kadar hararetlice dikleniyorsun?Dialogue: 0,0:16:35.71,0:16:39.60,Main,,0,0,0,,Lucci!  Ona sunduğumuz şartları tam olarak söyle.Dialogue: 0,0:16:39.60,0:16:46.84,Main,,0,0,0,,Nico Robin haricindeki 6 Hasır Şapka üyesinin Water 7'dan güvenli bir şekilde çıkabilmesi.Dialogue: 0,0:16:46.84,0:16:51.29,Main,,0,0,0,,Evet. Aynen öyle. Bunda bir yanlışlık yok, değil mi?Dialogue: 0,0:16:58.60,0:17:04.14,Main,,0,0,0,,Water 7'dan güvenli bir şekilde ayrıldıktan sonra buraya gelmediler mi?Dialogue: 0,0:17:05.79,0:17:07.63,Main,,0,0,0,,Ne dedin sen?!Dialogue: 0,0:17:08.61,0:17:12.56,Main,,0,0,0,,Sakın böyle bir detay yüzünden anlaşmamızı bozacağını söyleme!Dialogue: 0,0:17:13.91,0:17:18.48,Main,,0,0,0,,Çok çirkin bir durum. Bunlarda insanlığın kırıntısı bile yok!Dialogue: 0,0:17:19.01,0:17:21.42,Main,,0,0,0,,Ah? Ne dedin?Dialogue: 0,0:17:23.34,0:17:25.21,Main,,0,0,0,,Kapa çeneni, seni süprüntü!Dialogue: 0,0:17:25.21,0:17:30.41,Main,,0,0,0,,Sizin gibi suçlulara vermiş olduğumuz sözleri tutma gibi bir zorunluluğumuz bile yok!Dialogue: 0,0:17:30.41,0:17:32.53,Main,,0,0,0,,Al bakalım, al! Pislik!Dialogue: 0,0:17:32.88,0:17:33.99,Main,,0,0,0,,Sen de!Dialogue: 0,0:17:35.37,0:17:37.58,Main,,0,0,0,,Bu kadar ukala olma!Dialogue: 0,0:17:37.98,0:17:43.25,Main,,0,0,0,,Korsanları kandırıp onları yakalamak, Denizciler'in doğal olarak yaptığı şey!Dialogue: 0,0:17:57.24,0:17:58.64,Main,,0,0,0,,Korkak.Dialogue: 0,0:18:03.26,0:18:06.32,Main,,0,0,0,,Hala bu kadar küstahça konuşabiliyorsun.Dialogue: 0,0:18:06.91,0:18:09.34,Main,,0,0,0,,Şimdiye dek başkalarına ihanet ederek yaşayan...Dialogue: 0,0:18:09.34,0:18:12.49,Main,,0,0,0,,...bir kadın için uygun bir ölüm seçeceğime emin ol.Dialogue: 0,0:18:21.37,0:18:25.68,Main,,0,0,0,,Hepiniz birbirinizle iyi geçinmeli ve sonra da ölmelisiniz.Dialogue: 0,0:18:25.68,0:18:30.11,Main,,0,0,0,,Büyük adaletin karşısında direnmek boşadır.Dialogue: 0,0:18:38.40,0:18:40.75,Main,,0,0,0,,Hey, orada neler oluyor?Dialogue: 0,0:18:48.21,0:18:49.54,Main,,0,0,0,,Bir şey geliyor!Dialogue: 0,0:19:02.08,0:19:06.03,Main,,0,0,0,,Evet! Sodom, Gomorrah!  İlerlemeye devam edin!Dialogue: 0,0:19:08.15,0:19:12.87,Main,,0,0,0,,Kahretsin! Demek bunlar onlar! Bunlar, Ana Ada Kapısı'nı yarıp geçen korsanlar!Dialogue: 0,0:19:12.87,0:19:15.54,Main,,0,0,0,,Ateş! Devirin onları!Dialogue: 0,0:19:15.54,0:19:17.31,Main,,0,0,0,,Vırak, vırak!Dialogue: 0,0:19:17.31,0:19:19.38,Main,,0,0,0,,Canınızın bağışlanmasını istiyorsanız, yolu açın!Dialogue: 0,0:19:19.38,0:19:21.33,Main,,0,0,0,,Alın bakalım! Alın bakalım!Dialogue: 0,0:19:23.09,0:19:25.63,Main,,0,0,0,,Tekrar düzen oluşturmaya çalışın!Dialogue: 0,0:19:28.37,0:19:31.80,Main,,0,0,0,,Pis korsanlar bu kadar ukalalık etmemeli!Dialogue: 0,0:19:37.98,0:19:40.07,Main,,0,0,0,,Hazır ol, korsan!Dialogue: 0,0:19:40.07,0:19:42.57,Main,,0,0,0,,Hayır!Dialogue: 0,0:19:45.14,0:19:46.58,Main,,0,0,0,,Seni yiyeceğim!Dialogue: 0,0:19:46.58,0:19:48.59,Main,,0,0,0,,İzin almadan binme!Dialogue: 0,0:19:49.97,0:19:52.67,Main,,0,0,0,,Her şey yolunda gidiyor!  Neyse ki siz bizim yanımızdasınız!Dialogue: 0,0:19:52.67,0:19:55.13,Main,,0,0,0,,Bizi Luffy'ye götürmenize güveniyoruz, Kral Boğalar!Dialogue: 0,0:19:58.56,0:20:03.81,Main,,0,0,0,,Peşinden gidin! Kaçmasına izin vermeyin! Sadece bir düşman var! Çembere alın!Dialogue: 0,0:20:04.78,0:20:05.70,Main,,0,0,0,,Dur!Dialogue: 0,0:20:06.46,0:20:08.56,Main,,0,0,0,,Yolumdan çekil!Dialogue: 0,0:20:09.12,0:20:11.41,Main,,0,0,0,,Yoluma çıkma!Dialogue: 0,0:20:17.04,0:20:18.75,Main,,0,0,0,,Pislikler!Dialogue: 0,0:20:19.56,0:20:22.93,Main,,0,0,0,,Binbaşı, bu adam korkunç!Dialogue: 0,0:20:22.93,0:20:26.67,Main,,0,0,0,,Tereddüt etmeyin, ahmaklar! Gidin!Dialogue: 0,0:20:29.43,0:20:30.47,Main,,0,0,0,,Binbaşı!Dialogue: 0,0:20:35.61,0:20:38.19,Main,,0,0,0,,Orası çıkmaz yol gibi görünüyor.Dialogue: 0,0:20:38.83,0:20:40.69,Main,,0,0,0,,Henüz seni götürmesinler,...Dialogue: 0,0:20:42.65,0:20:45.60,Main,,0,0,0,,...Robin!Dialogue: 0,0:20:48.13,0:20:51.67,Main,,0,0,0,,Pekâla korumalar.  Şunları zincirlerinden sürükleyip götürün.Dialogue: 0,0:20:51.67,0:20:52.12,Main,,0,0,0,,Emredersiniz.Dialogue: 0,0:20:52.66,0:20:56.53,Main,,0,0,0,,Nico Robin'in deniz taşı kelepçesinin gevşemediğinden emin olun.Dialogue: 0,0:20:56.53,0:21:00.41,Main,,0,0,0,,Cutty Flam, Impel Down'a gidiyor. Nico Robin ise, Denizci Karargâhı'na.Dialogue: 0,0:21:00.41,0:21:02.30,Main,,0,0,0,,Kalkış hazırlıkları tamamlanır tamamlanmaz,...Dialogue: 0,0:21:02.30,0:21:04.38,Main,,0,0,0,,...onları Adalet Kapısı'ndan geçirin.Dialogue: 0,0:21:04.38,0:21:06.67,Main,,0,0,0,,Emredersiniz! Anlaşıldı!Dialogue: 0,0:21:06.67,0:21:08.01,Main,,0,0,0,,Ve...Dialogue: 0,0:21:08.52,0:21:11.10,Main,,0,0,0,,...size söyleyeceğim bir şey var.Dialogue: 0,0:21:11.10,0:21:13.31,Main,,0,0,0,,Cutty Flam, aşırı derecede şid-Dialogue: 0,0:21:15.71,0:21:18.63,Secondary,,0,0,80,,Bana yardım et! Hey, Kalifa!Dialogue: 0,0:21:14.42,0:21:16.71,Main,,0,0,0,,Hasır Şapka ortaya çıktı mı?Dialogue: 0,0:21:17.89,0:21:18.91,Main,,0,0,0,,Bu cinsel taciz.Dialogue: 0,0:21:18.91,0:21:19.92,Main,,0,0,0,,Evet...Dialogue: 0,0:21:20.93,0:21:24.08,Secondary,,0,0,80,,Hey! Hey! Birisi! Birisi! Yardım! Hey!Dialogue: 0,0:21:20.40,0:21:23.72,Main,,0,0,0,,Demin bu konuda bir rapor aldık, chapapa.Dialogue: 0,0:21:24.08,0:21:26.78,Secondary,,0,0,80,,Ne yapıyorsun?! Hey!Dialogue: 0,0:21:23.72,0:21:26.78,Main,,0,0,0,,Şef o kadar üzgündü ki neredeyse utanç vericiydi.Dialogue: 0,0:21:27.44,0:21:29.14,Secondary,,0,0,80,,Şefi bırak!Dialogue: 0,0:21:27.30,0:21:29.15,Main,,0,0,0,,Ama o sırada,...Dialogue: 0,0:21:29.14,0:21:30.70,Secondary,,0,0,80,,Şimdiden vazgeç, seni piç kurusu!Dialogue: 0,0:21:29.15,0:21:30.70,Main,,0,0,0,,...sadece beş kişinin yenildiği bildirildi.Dialogue: 0,0:21:35.73,0:21:38.04,Thoughts,,0,0,0,,Ahize yerinden çıkmış.Dialogue: 0,0:21:38.04,0:21:38.19,Captions,,0,0,0,,MahkemeDialogue: 0,0:21:38.19,0:21:38.33,Captions,,0,0,0,,MahkemeDialogue: 0,0:21:38.33,0:21:38.45,Captions,,0,0,0,,MahkemeDialogue: 0,0:21:38.45,0:21:38.60,Captions,,0,0,0,,MahkemeDialogue: 0,0:21:38.60,0:21:38.64,Captions,,0,0,0,,MahkemeDialogue: 0,0:21:38.64,0:21:39.10,Captions,,0,0,0,,MahkemeDialogue: 0,0:21:39.10,0:21:39.15,