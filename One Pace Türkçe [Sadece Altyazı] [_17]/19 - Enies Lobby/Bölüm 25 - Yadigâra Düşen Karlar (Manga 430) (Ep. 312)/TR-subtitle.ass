Dialogue: 0,0:00:00.00,0:00:06.49,Title,,0,0,0,,{\fad(750,750)}Yadigâra Düşen Karlar
Dialogue: 5,0:00:00.76,0:00:04.00,Main,,0,0,0,,Hey! Hey, hey, hey! Usopp!
Dialogue: 5,0:00:04.00,0:00:06.76,Main,,0,0,0,,Neredesin, Usopp?
Dialogue: 5,0:00:06.76,0:00:08.36,Main,,0,0,0,,Hey!
Dialogue: 5,0:00:08.36,0:00:10.19,Main,,0,0,0,,Usopp!
Dialogue: 5,0:00:10.61,0:00:12.90,Main,,0,0,0,,Ha? Burada da yok.
Dialogue: 5,0:00:13.89,0:00:15.11,Main,,0,0,0,,Usopp!
Dialogue: 5,0:00:15.51,0:00:16.99,Main,,0,0,0,,Usopp!
Dialogue: 5,0:00:17.57,0:00:19.12,Main,,0,0,0,,Usopp!
Dialogue: 5,0:00:19.12,0:00:21.63,Main,,0,0,0,,Neredesin, Usopp?
Dialogue: 5,0:00:22.24,0:00:24.04,Main,,0,0,0,,Hey, seni çağırıyorlar.
Dialogue: 5,0:00:24.04,0:00:27.38,Main,,0,0,0,,H-Hayır, yapamam. \NBen olduğumu bilirlerse...
Dialogue: 5,0:00:27.38,0:00:30.67,Main,,0,0,0,,Çık artık ortaya!
Dialogue: 5,0:00:31.71,0:00:34.06,Main,,0,0,0,,Çıkmazsan canına okuyacağım!
Dialogue: 5,0:00:34.06,0:00:35.68,Main,,0,0,0,,Okuyacağım!
Dialogue: 5,0:00:36.42,0:00:40.99,Main,,0,0,0,,Hey, Usopp'un nerede olduğunu\Nbiliyor musun, Sogeking? Kayboldu!
Dialogue: 5,0:00:40.99,0:00:45.44,Main,,0,0,0,,L-Lütfen rahat olun.\NKendisi daha küçük bir gemiyle önden gitti.
Dialogue: 5,0:00:47.05,0:00:48.44,Main,,0,0,0,,Niye?
Dialogue: 5,0:00:48.44,0:00:51.40,Main,,0,0,0,,Sonuçta bu, onun gemisi.
Dialogue: 5,0:00:51.40,0:00:56.11,Main,,0,0,0,,Usopp'u nasıl tanımazlar?
Dialogue: 5,0:00:59.11,0:01:00.99,Main,,0,0,0,,Burada da yok.
Dialogue: 5,0:01:02.09,0:01:04.34,Main,,0,0,0,,Neler oluyor?
Dialogue: 5,0:01:07.64,0:01:10.30,Main,,0,0,0,,Burada gerçekten hiç kimse yok.
Dialogue: 5,0:01:10.30,0:01:12.34,Main,,0,0,0,,Tuhaf.
Dialogue: 5,0:01:12.34,0:01:15.00,Main,,0,0,0,,Kim getirmiş olabilir ki?
Dialogue: 5,0:01:15.00,0:01:19.86,Main,,0,0,0,,O sırada birinin \Nbizi çağırdığını gerçekten duydum.
Dialogue: 5,0:01:19.86,0:01:21.48,Main,,0,0,0,,Öyle mi?
Dialogue: 5,0:01:21.48,0:01:24.14,Main,,0,0,0,,Evet. Kesinlikle çağırıldık.
Dialogue: 5,0:01:24.14,0:01:28.86,Main,,0,0,0,,Daha önce de söyledim, değil mi?\NO, Merry'nin sesiydi!
Dialogue: 5,0:01:29.40,0:01:31.07,Main,,0,0,0,,Ne, cidden mi?!
Dialogue: 5,0:01:33.57,0:01:36.50,Main,,0,0,0,,Hey, Merry. Bir şey söyle!
Dialogue: 5,0:01:36.50,0:01:39.20,Main,,0,0,0,,Aptal, gemiler konuşamaz.
Dialogue: 5,0:01:39.80,0:01:44.16,Main,,0,0,0,,Ben de aynı şeyi düşünüyordum.
Dialogue: 5,0:01:45.11,0:01:49.88,Main,,0,0,0,,Ama böyle bir şey imkansız.
Dialogue: 5,0:01:59.82,0:02:01.22,Main,,0,0,0,,Bu tarafa gelen bir gemi var!
Dialogue: 5,0:02:01.81,0:02:03.27,Main,,0,0,0,,Ne, kim o?
Dialogue: 5,0:02:05.40,0:02:06.74,Main,,0,0,0,,Hasır Şapkalar!
Dialogue: 5,0:02:06.74,0:02:07.81,Main,,0,0,0,,Yaşıyorlar!
Dialogue: 5,0:02:07.81,0:02:10.58,Main,,0,0,0,,İyisiniz!
Dialogue: 5,0:02:10.58,0:02:12.82,Main,,0,0,0,,Galley-La Şirketi'nin gemisi!
Dialogue: 5,0:02:12.82,0:02:14.16,Main,,0,0,0,,Müthiş!
Dialogue: 5,0:02:14.16,0:02:16.78,Main,,0,0,0,,Aqua Laguna'dan çıkmış \Nolmalarına inanamıyorum!
Dialogue: 5,0:02:18.59,0:02:21.74,Main,,0,0,0,,Enies Lobby'den de çıkmışlar!
Dialogue: 5,0:02:22.78,0:02:25.87,Main,,0,0,0,,Hey, Buz amca!
Dialogue: 5,0:02:25.87,0:02:27.51,Main,,0,0,0,,Aptalburg.
Dialogue: 5,0:02:29.99,0:02:31.58,Main,,0,0,0,,Nico Robin.
Dialogue: 5,0:02:37.27,0:02:39.01,Main,,0,0,0,,İnanılmazlar.
Dialogue: 5,0:02:39.61,0:02:41.47,Main,,0,0,0,,Dünya Hükümeti'ne karşı çıkıyorlar.
Dialogue: 5,0:02:48.25,0:02:51.75,Main,,0,0,0,,Gerçekten her şeyi geri aldılar.
Dialogue: 5,0:03:06.50,0:03:07.50,Main,,0,0,0,,Merry!
Dialogue: 5,0:03:09.96,0:03:11.79,Main,,0,0,0,,Bakın! Gemileri...
Dialogue: 5,0:03:12.39,0:03:14.63,Main,,0,0,0,,Hey, ne oldu? \NNe oldu böyle birden?
Dialogue: 5,0:03:14.63,0:03:18.26,Main,,0,0,0,,Birden falan olmadı.\NOlacak şey buydu zaten.
Dialogue: 5,0:03:20.26,0:03:24.19,Main,,0,0,0,,Merry'nin bir daha denize\Naçılamayacağını söylediler.
Dialogue: 5,0:03:24.19,0:03:25.14,Main,,0,0,0,,Ama...
Dialogue: 5,0:03:26.93,0:03:28.85,Main,,0,0,0,,Merry...
Dialogue: 5,0:03:33.80,0:03:37.65,Main,,0,0,0,,Amca, durum kötü!\NMerry'nin başı dertte! Bir şey yap!
Dialogue: 5,0:03:37.65,0:03:40.95,Main,,0,0,0,,Siz tam zamanında geldiniz!\NHepiniz gemi marangozusunuz, değil mi?
Dialogue: 5,0:03:40.95,0:03:43.45,Main,,0,0,0,,Lütfen! Bir şey yapın!
Dialogue: 5,0:03:43.45,0:03:46.12,Main,,0,0,0,,O, tüm yolculuklarımızda\Nyanımızda olan bir arkadaş!
Dialogue: 5,0:03:46.12,0:03:49.45,Main,,0,0,0,,Daha yeni de bizi kurtardı!
Dialogue: 5,0:03:49.45,0:03:51.87,Main,,0,0,0,,Lütfen amca!
Dialogue: 5,0:03:54.08,0:03:55.75,Main,,0,0,0,,Onu bırakmanın...
Dialogue: 5,0:03:58.11,0:03:59.67,Main,,0,0,0,,...zamanı geldi.
Dialogue: 5,0:04:03.50,0:04:06.65,Main,,0,0,0,,Zaten tüm yapabileceğimi yaptım.
Dialogue: 5,0:04:15.74,0:04:17.57,Flashbacks,,0,0,0,,Bu ses de ne?
Dialogue: 5,0:04:22.00,0:04:24.36,Flashbacks,,0,0,0,,Hurdalık adasında biri mi var?
Dialogue: 5,0:04:28.18,0:04:31.47,Flashbacks,,0,0,0,,Bu, Hasır Şapkagil'in gemisi mi?
Dialogue: 5,0:04:33.88,0:04:37.38,Flashbacks,,0,0,0,,Aqua Laguna mahvetmiş. Korkunç durumda.
Dialogue: 5,0:04:40.79,0:04:42.88,Flashbacks,,0,0,0,,Hayır, bu daha da önceden.
Dialogue: 5,0:04:44.45,0:04:45.84,Flashbacks,,0,0,0,,Denize açılmak istiyorum.
Dialogue: 5,0:04:48.10,0:04:49.06,Flashbacks,,0,0,0,,Ne?
Dialogue: 5,0:04:54.14,0:04:57.31,Flashbacks,,0,0,0,,Sadece bir kez daha\Ndenize açılmak istiyorum!
Dialogue: 5,0:05:24.00,0:05:26.27,Flashbacks,,0,0,0,,Ne yapıyorum ben?
Dialogue: 5,0:05:26.27,0:05:28.51,Flashbacks,,0,0,0,,Bu gemi ümitsiz vaka.
Dialogue: 5,0:05:29.80,0:05:32.18,Flashbacks,,0,0,0,,Iceburg-san!
Dialogue: 5,0:05:32.74,0:05:36.73,Flashbacks,,0,0,0,,Orada ne yapıyorsunuz?\NBüyük bir dalga daha geliyor!
Dialogue: 5,0:05:43.17,0:05:44.62,Flashbacks,,0,0,0,,Sağol.
Dialogue: 5,0:06:08.05,0:06:10.09,Flashbacks,,0,0,0,,Ne?! Gemi mi hazırlayalım?
Dialogue: 5,0:06:10.39,0:06:12.05,Flashbacks,,0,0,0,,Fırtına hala çok güçlü!
Dialogue: 5,0:06:12.74,0:06:14.31,Flashbacks,,0,0,0,,O zaman yalnız gideceğim.
Dialogue: 5,0:06:14.31,0:06:15.69,Flashbacks,,0,0,0,,Olmaz!
Dialogue: 5,0:06:15.69,0:06:18.36,Flashbacks,,0,0,0,,Yalnız gitmenize izin veremeyiz!
Dialogue: 5,0:06:20.00,0:06:23.54,Main,,0,0,0,,Şu anda\Nbir mucizeye tanıklık ediyorum.
Dialogue: 5,0:06:24.38,0:06:28.95,Main,,0,0,0,,Kendi sınırlarını fazlasıyla zorlayan bir gemi.
Dialogue: 5,0:06:31.41,0:06:33.45,Main,,0,0,0,,Yıllarca gemi marangozluğu yaptım.
Dialogue: 5,0:06:34.47,0:06:37.73,Main,,0,0,0,,Ama hiç bu kadar müthiş bir gemi görmedim.
Dialogue: 5,0:06:39.29,0:06:41.49,Main,,0,0,0,,Harikulade bir şey.
Dialogue: 5,0:06:49.42,0:06:51.97,Flashbacks,,0,0,0,,Gidelim çocuklar!
Dialogue: 5,0:06:55.14,0:06:57.91,Flashbacks,,0,0,0,,Macera denizine dönelim!
Dialogue: 5,0:06:58.69,0:07:01.15,Flashbacks,,0,0,0,,Merry!
Dialogue: 5,0:07:02.40,0:07:04.69,Flashbacks,,0,0,0,,Sizi almaya geldim!
Dialogue: 5,0:07:21.20,0:07:22.58,Main,,0,0,0,,Anlıyorum.
Dialogue: 5,0:08:20.76,0:08:24.06,Main,,0,0,0,,Herkes hazır mı?
Dialogue: 5,0:08:24.06,0:08:25.38,Main,,0,0,0,,Evet.
Dialogue: 5,0:08:32.78,0:08:36.90,Main,,0,0,0,,Denizin dibi karanlık ve tenha.
Dialogue: 5,0:08:36.90,0:08:39.20,Main,,0,0,0,,Bu yüzden seni uğurlayacağız.
Dialogue: 5,0:08:43.00,0:08:46.00,Main,,0,0,0,,Muhtemelen Usopp'un\Nburada olmaması daha iyi.
Dialogue: 5,0:08:46.00,0:08:49.88,Main,,0,0,0,,Bunu kaldıramazdı.
Dialogue: 5,0:08:50.26,0:08:52.00,Main,,0,0,0,,Ne düşünüyorsun?
Dialogue: 5,0:08:52.00,0:08:53.84,Main,,0,0,0,,Bu doğru değil.
Dialogue: 5,0:08:54.50,0:08:58.06,Main,,0,0,0,,Veda zamanları hep gelmek zorundadır.
Dialogue: 5,0:08:58.06,0:09:00.39,Main,,0,0,0,,Artık gözyaşı yok.
Dialogue: 5,0:09:05.60,0:09:08.77,Main,,0,0,0,,Bunun için zaten hazırlanmış.
Dialogue: 5,0:09:39.15,0:09:44.39,Main,,0,0,0,,Bunca zamandır bizi taşıdığın için sağol, Merry.
Dialogue: 5,0:09:56.92,0:09:57.99,Main,,0,0,0,,Kar...
Dialogue: 5,0:10:09.69,0:10:10.99,Flashbacks,,0,0,0,,Bir karavela!
Dialogue: 5,0:10:16.46,0:10:20.80,Flashbacks,,0,0,0,,Bununla birlikte korsan gemisi\NGoing Merry tam oldu!
Dialogue: 5,0:10:21.39,0:10:24.80,Flashbacks,,0,0,0,,Yeni gemimize ve yeni\Narkadaşımıza kadeh kaldıralım!
Dialogue: 5,0:10:34.34,0:10:36.96,Flashbacks,,0,0,0,,Bakın, Merry'ye çok zarar verdiniz!
Dialogue: 5,0:10:36.96,0:10:39.24,Flashbacks,,0,0,0,,Herkes geminin idaresine yardım etmeli!
Dialogue: 5,0:10:39.24,0:10:41.00,Flashbacks,,0,0,0,,Sakın unutmayın!
Dialogue: 5,0:10:41.00,0:10:42.00,Flashbacks,,0,0,0,,Emredersiniz.
Dialogue: 5,0:10:42.00,0:10:43.37,Flashbacks,,0,0,0,,Ü-Üzgünüm.
Dialogue: 5,0:10:44.67,0:10:47.43,Flashbacks,,0,0,0,,Hey, ne yapmaya çalışıyorsun?
Dialogue: 5,0:10:47.43,0:10:49.52,Flashbacks,,0,0,0,,Topla talim yapıyorum!
Dialogue: 5,0:10:49.52,0:10:51.25,Flashbacks,,0,0,0,,Ama bir türlü olmuyor.
Dialogue: 5,0:10:51.25,0:10:53.96,Flashbacks,,0,0,0,,Bırak ben yapayım demiştim!
Dialogue: 5,0:10:56.46,0:10:59.92,Flashbacks,,0,0,0,,Müthiş! Tek atışta vurdun!
Dialogue: 5,0:10:59.92,0:11:03.64,Flashbacks,,0,0,0,,Vurdum! Hem de tek atışta!
Dialogue: 5,0:11:17.39,0:11:20.78,Flashbacks,,0,0,0,,Zoro! Pislik! Orası benim koltuğum!
Dialogue: 5,0:11:21.70,0:11:24.78,Flashbacks,,0,0,0,,O ışıktan sonrası Grand Line'ın girişi.
Dialogue: 5,0:11:26.18,0:11:29.12,Flashbacks,,0,0,0,,All Blue'yu bulacağım.
Dialogue: 5,0:11:30.19,0:11:31.96,Flashbacks,,0,0,0,,Korsanlar Kralı olacağım!
Dialogue: 5,0:11:33.00,0:11:34.79,Flashbacks,,0,0,0,,En iyi kılıç ustası olacağım.
Dialogue: 5,0:11:35.90,0:11:38.55,Flashbacks,,0,0,0,,Bir dünya haritası çizeceğim.
Dialogue: 5,0:11:39.00,0:11:43.26,Flashbacks,,0,0,0,,B-Ben de denizin cesur bir adamı olacağım!
Dialogue: 5,0:11:45.33,0:11:48.66,Flashbacks,,0,0,0,,Grand Line'a gidelim!
Dialogue: 5,0:11:57.65,0:11:59.78,Flashbacks,,0,0,0,,Grand Line'ın girişi bir dağ.
Dialogue: 5,0:12:00.75,0:12:01.99,Flashbacks,,0,0,0,,Dağ?
Dialogue: 5,0:12:17.95,0:12:20.55,Flashbacks,,0,0,0,,Girdik!
Dialogue: 5,0:12:20.88,0:12:23.68,Flashbacks,,0,0,0,,Bu, dünyanın en büyük okyanusu!
Dialogue: 5,0:12:24.76,0:12:27.41,Flashbacks,,0,0,0,,Hadi!
Dialogue: 5,0:12:50.99,0:12:52.50,Flashbacks,,0,0,0,,Başardık!
Dialogue: 5,0:12:53.25,0:12:57.91,Flashbacks,,0,0,0,,Geri dönemeyiz! Dümdüz ileri gidelim!
Dialogue: 5,0:13:05.49,0:13:07.59,Flashbacks,,0,0,0,,Arkadaşınız olmama izin verin.
Dialogue: 5,0:13:07.92,0:13:11.20,Flashbacks,,0,0,0,,Gidecek veya dönecek bir yerim yok.
Dialogue: 5,0:13:11.20,0:13:13.42,Flashbacks,,0,0,0,,Bu yüzden geminizde kalmama izin verin.
Dialogue: 5,0:13:13.42,0:13:16.92,Flashbacks,,0,0,0,,Ah, öyle mi?\NO zaman yapacak bir şey yok.
Dialogue: 0,0:13:16.92,0:13:17.50,Flashbacks,,0,0,0,,Olur.
Dialogue: 5,0:13:17.50,0:13:18.48,Flashbacks,,0,0,0,,Luffy!
Dialogue: 5,0:13:19.38,0:13:21.53,Flashbacks,,0,0,0,,Bu geminin rotacısı kim?
Dialogue: 5,0:13:22.20,0:13:24.49,Flashbacks,,0,0,0,,Uçuyoruz!
Dialogue: 5,0:13:24.49,0:13:28.68,Flashbacks,,0,0,0,,Müthiş! Gemi havada uçuyor!
Dialogue: 5,0:13:32.12,0:13:35.41,Flashbacks,,0,0,0,,Gökyüzü Adası!
Dialogue: 5,0:14:57.44,0:14:58.52,Main,,0,0,0,,Üzgünüm.
Dialogue: 5,0:15:06.36,0:15:09.76,Main,,0,0,0,,Herkesi biraz daha ileri götürmek istemiştim.
Dialogue: 5,0:15:12.18,0:15:13.72,Main,,0,0,0,,Üzgünüm.
Dialogue: 5,0:15:13.72,0:15:16.60,Main,,0,0,0,,Her zaman birlikte maceralara gitmek istemiştim.
Dialogue: 5,0:15:16.60,0:15:19.69,Main,,0,0,0,,Merry!
Dialogue: 5,0:15:20.71,0:15:21.96,Main,,0,0,0,,Ses...?
Dialogue: 5,0:15:25.16,0:15:26.18,Main,,0,0,0,,Ama ben-
Dialogue: 5,0:15:26.18,0:15:30.20,Main,,0,0,0,,Özür dilemesi gereken biri varsa, \No da biziz, Merry!
Dialogue: 5,0:15:31.08,0:15:33.77,Main,,0,0,0,,Dümen tutmada kötüyüm.
Dialogue: 5,0:15:33.77,0:15:36.20,Main,,0,0,0,,Bu yüzden seni buzdağlarına çarptım!
Dialogue: 5,0:15:36.20,0:15:39.34,Main,,0,0,0,,Yelkenini de mahvettim.
Dialogue: 5,0:15:41.27,0:15:46.79,Main,,0,0,0,,Zoro ve Sanji de aptal oldukları\Niçin bir sürü şey kırdılar!
Dialogue: 5,0:15:46.80,0:15:51.48,Main,,0,0,0,,Usopp bunları tamir etmeye çalıştı\Nama bu işte hiç de iyi değildi!
Dialogue: 5,0:15:52.51,0:15:54.70,Main,,0,0,0,,Özür dilemesi gereken biri varsa,...
Dialogue: 5,0:16:01.58,0:16:04.56,Main,,0,0,0,,Ama mutluydum.
Dialogue: 5,0:16:08.70,0:16:13.60,Main,,0,0,0,,Bana hep iyi davrandınız. Çok sağolun.
Dialogue: 5,0:16:18.74,0:16:22.75,Main,,0,0,0,,Ben gerçekten çok mutluydum!
Dialogue: 5,0:16:26.75,0:16:29.00,Main,,0,0,0,,Sizin sayenizde!
Dialogue: 5,0:16:38.81,0:16:44.50,Main,,0,0,0,,MERRY!
Dialogue: 0,0:16:42.10,0:16:45.15,Credits,c,0,0,0,,Editing:\N Galaxy 9000\N\NTiming:\NPhosCity\N\NQuality Control:\Ndanpmss,\NGalaxy 9000,\NPepperjack,\NZenef\N\NSoundtracking:\N Halee\N\NGraphics:\N Datenshi\N\NKaraoke:\NKaitouYahiko\N\NTranslation:\NCrunchyroll,\NGaijin
Dialogue: 5,0:10:09.88,0:10:19.02,Lyrics-2,song,0,0,0,,{\an8\i1}♪ Her gün güneş batana kadar kendimizi çamurla kirletirdik. ♪
Dialogue: 5,0:10:19.12,0:10:28.22,Lyrics-2,song,0,0,0,,{\an8\i1}♪ Bu kadar ahmakça ziyan ettiğimiz o günleri bir kenara atmak zor. ♪
Dialogue: 5,0:10:29.01,0:10:38.52,Lyrics-2,song,0,0,0,,{\an8\i1}♪ Ben bir hayalperestim ama böyle biriyim işte. ♪
Dialogue: 5,0:10:38.67,0:10:47.14,Lyrics-2,song,0,0,0,,{\an8\i1}♪ Yapboz gibi parçalanmak istemiyorsan sorun değil. ♪
Dialogue: 5,0:10:47.76,0:10:57.04,Lyrics-2,song,0,0,0,,{\an8\i1}♪ Sana göre bir kimsenin evet demesi hayır demesiyle aynı. ♪
Dialogue: 5,0:10:57.04,0:11:07.16,Lyrics-2,song,0,0,0,,{\an8\i1}♪ Her zaman özgür olacağımızı sanmıştık. ♪
Dialogue: 5,0:11:07.16,0:11:17.29,Lyrics-2,song,0,0,0,,{\an8\i1}♪ Rüzgar yarına doğru estiğinde yapboz parçalanmış olsa bile...
Dialogue: 5,0:11:17.29,0:11:26.18,Lyrics-2,song,0,0,0,,{\an8\i1}...kimse bizi suçlamayacak. ♪
Dialogue: 5,0:11:26.18,0:11:31.79,Lyrics-2,song,0,0,0,,{\an8\i1}♪ O gün hayallerimizin...
Dialogue: 5,0:11:31.79,0:11:36.41,Lyrics-2,song,0,0,0,,{\an8\i1}...yanlış olmadığına inandık. ♪
Dialogue: 5,0:11:36.41,0:11:45.66,Lyrics-2,song,0,0,0,,{\an8\i1}♪ Sadece sert denizlerin ötesine geçtik. ♪
Dialogue: 5,0:11:45.66,0:11:55.16,Lyrics-2,song,0,0,0,,{\an8\i1}♪ Kalbinde taşıdığın acıyı her zaman biliyordum. ♪
Dialogue: 5,0:11:55.16,0:12:05.04,Lyrics-2,song,0,0,0,,{\an8\i1}♪ Gemiyi terketsen ve farklı bir dünyada olsan bile...
Dialogue: 5,0:12:05.04,0:12:14.95,Lyrics-2,song,0,0,0,,{\an8\i1}...sonuçta gülümseyebileceğiz. ♪
Dialogue: 5,0:13:17.25,0:13:26.95,Lyrics-2,song,0,0,0,,{\an8\i1}♪ Şimdi bile hayal kurmaya devam ediyoruz. ♪
Dialogue: 5,0:13:26.95,0:13:37.16,Lyrics-2,song,0,0,0,,{\an8\i1}♪ Kucaklanmış hayallere tutunmaya devam ediyoruz. ♪
Dialogue: 5,0:13:37.16,0:13:46.20,Lyrics-2,song,0,0,0,,{\an8\i1}♪ Bugün sert denizlerle mücadele edeceğiz. ♪
Dialogue: 5,0:13:46.20,0:13:54.41,Lyrics-2,song,0,0,0,,{\an8\i1}♪ Acı çekerken bile sözlerimiz yalanlara dönüşmeyecek. ♪
Dialogue: 5,0:13:54.41,0:14:05.37,Lyrics-2,song,0,0,0,,{\an8\i1}♪ Ve bir gün, gemiyi terkeden ve farklı bir dünyada olan sana,...
Dialogue: 5,0:14:05.37,0:14:16.08,Lyrics-2,song,0,0,0,,{\an8\i1}...o tamamlanmış yapbozu göndereceğim. ♪
