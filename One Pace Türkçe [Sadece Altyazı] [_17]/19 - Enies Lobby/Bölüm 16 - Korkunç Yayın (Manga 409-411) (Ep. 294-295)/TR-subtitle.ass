FF,&H00000000,&H78000000,0,-1,0,0,100,100,0,0,1,1.5,1.5,2,120,120,18,1Style: Author,Impress BT,20,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.8,0.8,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.71,0:00:03.37,Lyrics,,0,0,0,,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪Dialogue: 0,0:00:03.59,0:00:06.46,Lyrics,,0,0,0,,♪ Bayrağımızı süsleyip, gökyüzüne kaldırarak. ♪Dialogue: 0,0:00:12.77,0:00:18.06,Lyrics,,0,0,0,,♪ Sonsuz okyanusu geçip aramaya gidelim. ♪Dialogue: 0,0:00:18.86,0:00:21.81,Lyrics,,0,0,0,,♪ Henüz kimse tarafından...Dialogue: 0,0:00:21.90,0:00:23.94,Lyrics,,0,0,0,,...bulunmamış bu dünyanın mucizesini. ♪Dialogue: 0,0:00:24.82,0:00:27.96,Lyrics,,0,0,0,,♪ Çarpıp duran göğsümüzdeki...Dialogue: 0,0:00:27.96,0:00:29.71,Lyrics,,0,0,0,,...aynı hislerle devam etmeliyiz. ♪Dialogue: 0,0:00:29.71,0:00:35.59,Lyrics,,0,0,0,,♪ Hayaller peşinde koşanlar tarafından bırakılmış ayak izleri. ♪Dialogue: 0,0:00:36.42,0:00:39.39,Lyrics,,0,0,0,,♪ Ne tür bir fırtınalı gece olursa olsun,...Dialogue: 0,0:00:39.39,0:00:42.39,Lyrics,,0,0,0,,...kalplerimizin bir olmasını sağlarsak...Dialogue: 0,0:00:42.39,0:00:46.54,Lyrics,,0,0,0,,...bu zorluğun üstesinden gelebileceğiz! ♪Dialogue: 0,0:00:46.68,0:00:47.86,Lyrics,,0,0,0,,♪ Her zaman ♪Dialogue: 0,0:00:48.76,0:00:51.59,Lyrics,,0,0,0,,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪Dialogue: 0,0:00:51.72,0:00:54.55,Lyrics,,0,0,0,,♪ Bayrağımızı dalgalandırıp gökyüzüne kaldırarak. ♪Dialogue: 0,0:00:54.60,0:00:57.14,Lyrics,,0,0,0,,♪ Kimseye göstermeyeceğiz. ♪Dialogue: 0,0:00:57.23,0:01:00.58,Lyrics,,0,0,0,,♪ Gözlerimizde yaşlar olsa bile. ♪Dialogue: 0,0:01:00.77,0:01:03.52,Lyrics,,0,0,0,,♪ Peşinden gidelim, peşinden gidelim! ♪Dialogue: 0,0:01:03.69,0:01:06.52,Lyrics,,0,0,0,,♪ Hayallerimize giden doğru yolu...Dialogue: 0,0:01:06.61,0:01:09.23,Lyrics,,0,0,0,,...gösteren pusulanın. ♪Dialogue: 0,0:01:09.23,0:01:11.40,Lyrics,,0,0,0,,♪ Durmayacağız. ♪Dialogue: 0,0:01:11.42,0:01:14.42,Lyrics,,0,0,0,,♪ Dünyayı dolaşarak...Dialogue: 0,0:01:14.45,0:01:15.85,Lyrics,,0,0,0,,...yeniden başlayalım! ♪Dialogue: 0,0:01:18.83,0:01:21.49,Lyrics,,0,0,0,,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪Dialogue: 0,0:01:21.80,0:01:24.54,Lyrics,,0,0,0,,♪ Hedefimize doğru herkesten daha fazla. ♪Dialogue: 0,0:01:24.63,0:01:27.12,Lyrics,,0,0,0,,♪ Şimdi kaçmazsak,...Dialogue: 0,0:01:27.22,0:01:30.54,Lyrics,,0,0,0,,...yarını sıkı sıkıya kavrayabileceğiz! ♪Dialogue: 0,0:01:30.60,0:01:33.63,Lyrics,,0,0,0,,♪ Peşinden gidelim, peşinden gidelim! ♪Dialogue: 0,0:01:33.68,0:01:36.51,Lyrics,,0,0,0,,♪ Gözlerinden yansıtılmış tüm şimdiki zamanın. ♪Dialogue: 0,0:01:36.56,0:01:38.93,Lyrics,,0,0,0,,♪ Bembeyaz bir kalp...Dialogue: 0,0:01:39.15,0:01:41.43,Lyrics,,0,0,0,,...bana tüm hikayeyi anlatacak! ♪Dialogue: 0,0:01:41.73,0:01:44.43,Lyrics,,0,0,0,,♪ Yepyeni bir dünyada...Dialogue: 0,0:01:44.53,0:01:45.83,Lyrics,,0,0,0,,...yeniden başlayalım! ♪Dialogue: 0,0:01:50.12,0:01:57.17,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:13:40.48,0:13:47.48,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:26:26.00,0:26:29.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:01:50.12,0:01:57.17,Title,,0,0,250,,Korkunç YayınDialogue: 0,0:01:51.04,0:01:57.04,Main,,0,0,0,,Buraya kadar geldiğin için seni tebrik etmeme izin ver.Dialogue: 0,0:01:57.46,0:01:59.45,Main,,0,0,0,,Yalnız başına.Dialogue: 0,0:02:01.39,0:02:03.61,Main,,0,0,0,,Yalnız gelmedim.Dialogue: 0,0:02:03.61,0:02:05.76,Main,,0,0,0,,Yalnız gelmek istemezdim.Dialogue: 0,0:02:07.56,0:02:11.69,Main,,0,0,0,,Ben sizden farklıyım. Yalnız değilim!Dialogue: 0,0:02:12.07,0:02:15.58,Main,,0,0,0,,Tüm arkadaşlarım buraya gelmeyi başaracak!Dialogue: 0,0:02:27.66,0:02:28.91,Main,,0,0,0,,Bacak Fırtınası!Dialogue: 0,0:02:37.55,0:02:38.54,Main,,0,0,0,,Kazı!Dialogue: 0,0:02:39.04,0:02:40.53,Main,,0,0,0,,Durum kötü!Dialogue: 0,0:02:40.53,0:02:41.65,Main,,0,0,0,,Hazırla kendini.Dialogue: 0,0:02:41.65,0:02:43.01,Main,,0,0,0,,Tamam!Dialogue: 0,0:02:43.01,0:02:44.85,Main,,0,0,0,,Aptalca bir şey yapma.Dialogue: 0,0:02:44.85,0:02:46.56,Main,,0,0,0,,A-Anladım!Dialogue: 0,0:02:47.26,0:02:49.31,Main,,0,0,0,,Hayır, dur! Öleceğim!Dialogue: 0,0:02:49.31,0:02:51.06,Main,,0,0,0,,Beni öldüreceksin!Dialogue: 0,0:02:56.69,0:03:00.50,Main,,0,0,0,,İşe yaramıyor. Kayganlaştığım için ayağa kalkamıyorum.Dialogue: 0,0:03:00.50,0:03:01.86,Main,,0,0,0,,Neyse...Dialogue: 0,0:03:01.86,0:03:06.68,Main,,0,0,0,,Bekle bakalım. Karşı saldırımı yapacağım.Dialogue: 0,0:03:11.87,0:03:18.05,Main,,0,0,0,,Ah, ah, ah! Lanet olası geyik goril. Sanırım onu hafife aldım.Dialogue: 0,0:03:19.42,0:03:22.10,Main,,0,0,0,,Ama daha da önemlisi anahtarı almam lazım.Dialogue: 0,0:03:22.10,0:03:24.72,Main,,0,0,0,,Hemen sekretere ulaşmazsam...Dialogue: 0,0:03:32.50,0:03:35.11,Main,,0,0,0,,Hey, geyi goril! Dur biraz!Dialogue: 0,0:03:58.88,0:04:00.72,Main,,0,0,0,,Gidelim, Oimo!Dialogue: 0,0:04:00.72,0:04:02.68,Main,,0,0,0,,Tamam, Kashi!Dialogue: 0,0:04:04.68,0:04:07.27,Main,,0,0,0,,Onlara ateş etmeye devam etmeliyiz!Dialogue: 0,0:04:07.27,0:04:10.35,Main,,0,0,0,,Atış birimi, atışınızı Kashi'ye yoğunlaştırın!Dialogue: 0,0:04:16.61,0:04:19.32,Main,,0,0,0,,Şimdi! Yakalayın onu!Dialogue: 0,0:04:27.70,0:04:29.94,Main,,0,0,0,,Görünüşe göre dışarıda bir şey oldu.Dialogue: 0,0:04:29.94,0:04:33.29,Main,,0,0,0,,Devler ellerinden geleni yapmaya çalıştı ama...Dialogue: 0,0:04:33.29,0:04:35.60,Main,,0,0,0,,...tükendiler mi acaba?Dialogue: 0,0:04:55.27,0:04:57.88,Main,,0,0,0,,Hey! Hey, acele et!Dialogue: 0,0:04:59.65,0:05:01.94,Main,,0,0,0,,Kahretsin, durum kötü.Dialogue: 0,0:05:01.94,0:05:04.97,Main,,0,0,0,,Korsanlar buraya kadar gelmemeliydi!Dialogue: 0,0:05:06.63,0:05:08.63,Main,,0,0,0,,Hey! Herkes cevap versin!Dialogue: 0,0:05:08.63,0:05:11.66,Main,,0,0,0,,CP9! Ne yapıyorsunuz siz?!Dialogue: 0,0:05:11.66,0:05:14.22,Main,,0,0,0,,Korsanlardan biri buraya geldi!Dialogue: 0,0:05:16.16,0:05:19.04,Main,,0,0,0,,Hey, dinliyor musunuz?  Cevap verin artık!Dialogue: 0,0:05:25.38,0:05:26.37,Main,,0,0,0,,Dur!Dialogue: 0,0:05:27.93,0:05:30.51,Main,,0,0,0,,Sen onu...Dialogue: 0,0:05:38.90,0:05:44.92,Main,,0,0,0,,A-A-Altın Den Den Mushi!Dialogue: 0,0:05:55.70,0:06:09.30,Note,,0,0,0,,DonanmaDialogue: 0,0:05:56.90,0:06:00.06,Main,,0,0,0,,Gümüş Den Den Mushi sinyal aldı!Dialogue: 0,0:06:00.06,0:06:02.33,Main,,0,0,0,,Yıkım Çağrısı istendi!Dialogue: 0,0:06:02.33,0:06:06.01,Main,,0,0,0,,Yıkım Çağrısı, Amiral Aokiji tarafından istendi!Dialogue: 0,0:06:06.01,0:06:07.35,Main,,0,0,0,,Neresi?Dialogue: 0,0:06:07.35,0:06:09.30,Main,,0,0,0,,Enies Lobby!Dialogue: 0,0:06:09.30,0:06:12.76,Main,,0,0,0,,Hedefimize yakın olan beş koramirali çağırın.Dialogue: 0,0:06:12.76,0:06:15.97,Main,,0,0,0,,Bu mesafede en hızlısı karargâhtan ayrılmak olur.Dialogue: 0,0:06:15.97,0:06:17.46,Main,,0,0,0,,Ne kadar sürer?Dialogue: 0,0:06:17.46,0:06:19.90,Main,,0,0,0,,Otuz dakika içinde varabiliriz.Dialogue: 0,0:06:19.90,0:06:22.87,Main,,0,0,0,,Hemen on savaş gemisi hazırlayın.Dialogue: 0,0:06:22.87,0:06:24.83,Main,,0,0,0,,Beş koramiral çağırın.Dialogue: 0,0:06:24.83,0:06:26.06,Main,,0,0,0,,Çabuk!Dialogue: 0,0:06:26.06,0:06:27.44,Main,,0,0,0,,Emredersiniz!Dialogue: 0,0:06:27.44,0:06:29.69,Main,,0,0,0,,Yıkım Çağrısı istendi!Dialogue: 0,0:06:29.69,0:06:32.07,Main,,0,0,0,,Hedefimiz Enies Lobby!Dialogue: 0,0:06:32.07,0:06:35.41,Main,,0,0,0,,Derhal on savaş gemisi hazırlayın!Dialogue: 0,0:06:35.87,0:06:37.57,Main,,0,0,0,,Hey! Hey!Dialogue: 0,0:06:38.37,0:06:39.55,Main,,0,0,0,,Evet, Şef?Dialogue: 0,0:06:39.55,0:06:42.64,Main,,0,0,0,,Kahretsin. Küçük Den Den Mushi'nin olduğu el bu.Dialogue: 0,0:06:42.64,0:06:44.75,Main,,0,0,0,,Çok dikkatsizdim.Dialogue: 0,0:06:44.75,0:06:48.72,Main,,0,0,0,,Niye Altın Den Den Mushi'ye basmak zorunda kaldım?Dialogue: 0,0:06:48.72,0:06:51.34,Main,,0,0,0,,Ve biraz önce...Dialogue: 0,0:06:51.34,0:06:56.12,Main,,0,0,0,,...Yıkım Çağrısı istedim!Dialogue: 0,0:07:07.83,0:07:10.44,Main,,0,0,0,,Y-Yıkım Çağrısı mı? Olamaz.Dialogue: 0,0:07:10.44,0:07:12.16,Main,,0,0,0,,Bu duyuru da ne böyle?Dialogue: 0,0:07:12.16,0:07:16.20,Main,,0,0,0,,Nasıl yapabilirsin? Hemen durdur şunu!Dialogue: 0,0:07:17.16,0:07:18.66,Main,,0,0,0,,Robin'in sesi!Dialogue: 0,0:07:18.66,0:07:21.12,Main,,0,0,0,,İşler çok kötüleşecek!Dialogue: 0,0:07:21.12,0:07:23.08,Main,,0,0,0,,Robin!Dialogue: 0,0:07:23.08,0:07:26.48,Main,,0,0,0,,Ne? Durdurmak mı?Dialogue: 0,0:07:26.48,0:07:30.92,Main,,0,0,0,,Hey, hey. Sen kiminle konuştuğunu sanıyorsun?Dialogue: 0,0:07:30.92,0:07:33.05,Main,,0,0,0,,Bu konuşma ne böyle?Dialogue: 0,0:07:33.05,0:07:34.39,Main,,0,0,0,,Hey, kıpırdamayın!Dialogue: 0,0:07:34.39,0:07:36.43,Main,,0,0,0,,KIPIRDAYAMIYORUZ!Dialogue: 0,0:07:42.86,0:07:47.22,Main,,0,0,0,,Yıkım Çağrısı müthiş, değil mi? Bunun nesi yanlış?Dialogue: 0,0:07:48.36,0:07:51.03,Main,,0,0,0,,Bu, Şef Spandam'ın sesi, değil mi?Dialogue: 0,0:07:56.48,0:07:59.90,Main,,0,0,0,,Evet. Sorun değil.Dialogue: 0,0:07:59.90,0:08:04.38,Main,,0,0,0,,Ben Cipher Pol No. 9'un şefiyim.Dialogue: 0,0:08:04.38,0:08:09.49,Main,,0,0,0,,Seni sağ salim hükümete  teslim etmek için Yıkım Çağrısı istedim.Dialogue: 0,0:08:10.54,0:08:12.47,Main,,0,0,0,,Evet, bu harika!Dialogue: 0,0:08:12.47,0:08:15.46,Main,,0,0,0,,Ama ne olursa olsun...Dialogue: 0,0:08:15.46,0:08:20.60,Main,,0,0,0,,...önce tüm korsanların öldüğünden emin olmalıyız!Dialogue: 0,0:08:21.67,0:08:23.37,Main,,0,0,0,,Saçmalık.Dialogue: 0,0:08:23.37,0:08:26.61,Main,,0,0,0,,Sana söylemedim mi?! Hepsi o değil!Dialogue: 0,0:08:27.09,0:08:30.31,Main,,0,0,0,,O saldırıda hiç insanlık yok!Dialogue: 0,0:08:31.38,0:08:35.20,Main,,0,0,0,,Şef ve... O kadın kim?Dialogue: 0,0:08:35.20,0:08:38.98,Main,,0,0,0,,Enies Lobby'deki her şey alevlerle kaplanacak!Dialogue: 0,0:08:38.98,0:08:42.25,Main,,0,0,0,,Binalar, insanlar, hatta adanın kendisi!Dialogue: 0,0:08:45.06,0:08:50.20,Main,,0,0,0,,Amacına ulaşmak için her şeyi feda eden kâbusumsu bir saldırı!Dialogue: 0,0:08:50.20,0:08:52.26,Main,,0,0,0,,Yıkım Çağrısı bu işte!Dialogue: 0,0:08:52.26,0:08:57.89,Main,,0,0,0,,Yirmi yıl önce Ohara'da ne olduğu hakkında hiçbir fikrin yok!Dialogue: 0,0:08:58.59,0:09:04.81,Main,,0,0,0,,Ah, sorun değil. Hükümet umursamıyor.Dialogue: 0,0:09:04.81,0:09:09.52,Main,,0,0,0,,Aptal Cutty Flam,  Pluton'un planlarını yaktıktan sonra...Dialogue: 0,0:09:22.87,0:09:26.53,Main,,0,0,0,,...antik silahları elde edebilmemizin tek yolu sensin.Dialogue: 0,0:09:27.46,0:09:31.31,Main,,0,0,0,,Bu çağı tamamen altüst etmeye yetecek ordu gücü bu yana geliyor.Dialogue: 0,0:09:31.31,0:09:37.76,Main,,0,0,0,,Seni götürmekte ısrar eden o aptalları tamamiyle yok etmek uğruna...Dialogue: 0,0:09:38.01,0:09:41.60,Main,,0,0,0,,...kaç bin askerin öldüğü önemli değil.Dialogue: 0,0:09:41.60,0:09:46.06,Main,,0,0,0,,Muhteşem bir gelecek için gereken bir fedakârlık!Dialogue: 0,0:09:46.88,0:09:51.02,Main,,0,0,0,,Daha da önemlisi terfi edeceğim.Dialogue: 0,0:09:51.02,0:09:53.55,Main,,0,0,0,,Neden bahsediyor bu?!Dialogue: 0,0:09:53.55,0:09:56.53,Main,,0,0,0,,Bizi feda etmek mi? Şaka yapıyor olmalı!Dialogue: 0,0:09:56.53,0:09:59.45,Main,,0,0,0,,İnsan hayatının ne olduğunu sanıyorsun?!Dialogue: 0,0:09:59.45,0:10:04.38,Main,,0,0,0,,Unutma; CP9, hükümetin suikastçileridir.Dialogue: 0,0:10:04.38,0:10:09.27,Main,,0,0,0,,Bin kişiyi kurtarmak için 100 kişinin ölmesi gerekliyse,...Dialogue: 0,0:10:09.27,0:10:13.46,Main,,0,0,0,,...hemen o 100 kişiyi öldürürüz.Dialogue: 0,0:10:19.18,0:10:23.31,Main,,0,0,0,,Gerçek adalet için acımasız olmak gerekir.Dialogue: 0,0:10:25.81,0:10:30.81,Main,,0,0,0,,Neyse, içeri giren korsanları bile durduramayan değersiz askerler...Dialogue: 0,0:10:30.81,0:10:33.49,Main,,0,0,0,,...ölse daha iyi olur, aptal!Dialogue: 0,0:10:38.20,0:10:41.43,Main,,0,0,0,,O Den Den Mushi hala açık.Dialogue: 0,0:10:43.20,0:10:45.66,Main,,0,0,0,,EYVAH!Dialogue: 0,0:10:45.66,0:10:48.16,Main,,0,0,0,,Tüm konuşma yayınlandı mı?!Dialogue: 0,0:10:53.47,0:10:58.51,Main,,0,0,0,,Ş-Şey, benim adım Hasır Şapkalı Luffy.Dialogue: 0,0:10:58.51,0:11:00.13,Main,,0,0,0,,YALANCI!Dialogue: 0,0:11:00.64,0:11:02.54,Main,,0,0,0,,Herkes adayı terketsin!Dialogue: 0,0:11:02.54,0:11:05.10,Main,,0,0,0,,Enies Lobby'ye doğru Yıkım Çağrısı geliyor!Dialogue: 0,0:11:05.10,0:11:08.02,Main,,0,0,0,,Adadaki hiç kimse güvende olmayacak!Dialogue: 0,0:11:08.02,0:11:11.48,Main,,0,0,0,,Bunları söyleme!Dialogue: 0,0:11:20.29,0:11:22.41,Main,,0,0,0,,– O... – Yıkım Çağrısı...Dialogue: 0,0:11:23.82,0:11:27.41,Main,,0,0,0,,Galiba Yıkım Çağrısı geliyor.Dialogue: 0,0:11:27.91,0:11:30.37,Main,,0,0,0,,Bu adam ne yapıyor?Dialogue: 0,0:11:30.37,0:11:32.48,Main,,0,0,0,,Sanırım tehlikedeyiz.Dialogue: 0,0:11:32.48,0:11:34.63,Main,,0,0,0,,TEHLİKEDE OLAN BENİM!Dialogue: 0,0:11:34.63,0:11:40.42,Main,,0,0,0,,Çok yazık.  Başka şansınız yokmuş gibi görünüyor.Dialogue: 0,0:11:40.42,0:11:42.25,Main,,0,0,0,,Endişelenme.Dialogue: 0,0:11:42.25,0:11:45.89,Main,,0,0,0,,Bu tür şeylere alışkınız.Dialogue: 0,0:11:49.15,0:11:54.86,Main,,0,0,0,,Korsan çocuk, ne tür bir yıldız altında doğdun?Dialogue: 0,0:11:55.16,0:11:59.40,Main,,0,0,0,,İşler daha da ilginçleşiyor!Dialogue: 0,0:12:02.30,0:12:04.51,Main,,0,0,0,,Yıkım Çağrısı istenmiş!Dialogue: 0,0:12:04.51,0:12:06.22,Main,,0,0,0,,Savaş gemileri geliyor!Dialogue: 0,0:12:07.37,0:12:10.37,Main,,0,0,0,,Enies Lobby'den çıkın!Dialogue: 0,0:12:12.99,0:12:16.02,Main,,0,0,0,,Niye savaş gemilerinden kaçıyorlar?Dialogue: 0,0:12:16.02,0:12:18.45,Main,,0,0,0,,Adanın alevlerle kaplanacağını söylediler.Dialogue: 0,0:12:18.45,0:12:20.21,Main,,0,0,0,,Ama burası hükümetin adası!Dialogue: 0,0:12:20.21,0:12:22.09,Main,,0,0,0,,Bilmediğimi mi sanıyorsun?!Dialogue: 0,0:12:22.09,0:12:26.26,Main,,0,0,0,,Hey, kaçıyorsanız önce bizi çözün!Dialogue: 0,0:12:32.75,0:12:34.31,Main,,0,0,0,,Yıkım Çağrısı!Dialogue: 0,0:12:34.31,0:12:36.45,Main,,0,0,0,,Burada kalırsak öleceğiz!Dialogue: 0,0:12:36.45,0:12:39.46,Main,,0,0,0,,Gemileri ana kapıya getirin! Yelken açmaya hazırlanın!Dialogue: 0,0:12:39.46,0:12:42.99,Main,,0,0,0,,Denizciler saldırmaya geliyor!Dialogue: 0,0:12:47.44,0:12:49.35,Main,,0,0,0,,Bizi geride bıraktılar.Dialogue: 0,0:12:49.35,0:12:52.97,Main,,0,0,0,,Hey, ne yapacağız?! Tehlikede değil miyiz?!Dialogue: 0,0:12:52.97,0:12:56.26,Main,,0,0,0,,Buraya geldiğimizden beri tehlikedeydik.Dialogue: 0,0:12:56.26,0:12:59.75,Main,,0,0,0,,Abimiz? Franky abimiz ne durumda?Dialogue: 0,0:12:59.75,0:13:03.78,Main,,0,0,0,,Evet, geri gelmezse onunla birlikte eve dönemeyiz.Dialogue: 0,0:13:03.78,0:13:05.43,Main,,0,0,0,,Hasır Şapkalar için de durum aynı!Dialogue: 0,0:13:05.43,0:13:08.18,Main,,0,0,0,,Öyleyse ne olacak?Dialogue: 0,0:13:09.27,0:13:14.14,Main,,0,0,0,,Herkese ne oldu?!Dialogue: 0,0:13:14.64,0:13:17.40,Main,,0,0,0,,Biz de acele etmeliyiz.Dialogue: 0,0:13:17.40,0:13:20.98,Main,,0,0,0,,Bu işi hemen bitirmeli ve Adalet Kapısı'na gitmeliyiz.Dialogue: 0,0:13:21.50,0:13:22.69,Main,,0,0,0,,Buldum.Dialogue: 0,0:13:22.69,0:13:25.77,Main,,0,0,0,,Ne? Neyi buldun?Dialogue: 0,0:13:25.77,0:13:29.44,Main,,0,0,0,,Bu kelepçeyi çıkarmanın yolunu mu? Buradan çıkmanın yolunu mu?Dialogue: 0,0:13:29.44,0:13:33.79,Main,,0,0,0,,Sen, isimli kılıç "Burun Fırtınası" sın.Dialogue: 0,0:13:33.79,0:13:36.72,Main,,0,0,0,,Bunun sırası değil!Dialogue: 0,0:13:36.72,0:13:40.29,Main,,0,0,0,,Chopper! Daha bulamadın mı?!Dialogue: 0,0:13:51.41,0:13:54.27,Main,,0,0,0,,Sinir bozucu şeyler söylüyorsun.Dialogue: 0,0:13:55.13,0:13:58.15,Main,,0,0,0,,Korsanlar gerçekten kaçsaydı,...Dialogue: 0,0:13:59.09,0:14:00.92,Main,,0,0,0,,...tam olarak...Dialogue: 0,0:14:03.11,0:14:05.65,Main,,0,0,0,,...bunu nasıl öderdin?Dialogue: 0,0:14:10.72,0:14:12.41,Main,,0,0,0,,O da neydi?Dialogue: 0,0:14:12.41,0:14:15.58,Main,,0,0,0,,Robin nereden konuşuyordu?Dialogue: 0,0:14:16.21,0:14:18.35,Main,,0,0,0,,Bu odanın diğer tarafından.Dialogue: 0,0:14:25.76,0:14:29.38,Main,,0,0,0,,Geçmene izin vermeyeceğim.Dialogue: 0,0:15:15.10,0:15:19.73,Main,,0,0,0,,Çekil. Robin o kapının ardında olmalı!Dialogue: 0,0:15:19.73,0:15:22.90,Main,,0,0,0,,Orada. Onu görmeyeceksin.Dialogue: 0,0:15:22.90,0:15:25.27,Main,,0,0,0,,Bir daha asla.Dialogue: 0,0:15:28.94,0:15:31.35,Main,,0,0,0,,Olaylar artık hızlanıyor.Dialogue: 0,0:15:34.26,0:15:38.16,Main,,0,0,0,,Bu kulede uzun süre kalırsak ölecek gibiyiz.Dialogue: 0,0:15:40.47,0:15:43.52,Main,,0,0,0,,Kaçıyorsan anahtarını bırak.Dialogue: 0,0:15:43.52,0:15:44.21,Main,,0,0,0,,Kazı!Dialogue: 0,0:15:44.68,0:15:46.16,Main,,0,0,0,,Üzgünüm.Dialogue: 0,0:15:47.43,0:15:50.59,Main,,0,0,0,,Daha uzun oynamak isterdim...Dialogue: 0,0:15:57.18,0:15:58.55,Thoughts,,0,0,0,,Eyvah...Dialogue: 0,0:16:09.32,0:16:12.70,Main,,0,0,0,,Ama biz de acele edip kaçmalıyız.Dialogue: 0,0:16:20.24,0:16:21.91,Main,,0,0,0,,Altın Köpük!Dialogue: 0,0:16:32.65,0:16:36.26,Thoughts,,0,0,0,,Sanji-kun'u haklayan saldırı. Neyden kaçınmam gerektiğini bile biliyordum.Dialogue: 0,0:16:43.16,0:16:45.18,Main,,0,0,0,,İklim Aygıtı'mı tutamıyorum.Dialogue: 0,0:16:47.01,0:16:50.11,Main,,0,0,0,,Tüm bedenim çok düzgün olduğu için ayağa kalkamıyorum!Dialogue: 0,0:16:54.28,0:16:56.67,Main,,0,0,0,,Bedenime ne yaptın?!Dialogue: 0,0:16:57.66,0:17:01.98,Main,,0,0,0,,Ne yazık ki bedeninin kıvrımlarını da düzeltiyor.Dialogue: 0,0:17:01.98,0:17:04.71,Main,,0,0,0,,Ama bu en güzel cilt.Dialogue: 0,0:17:04.71,0:17:06.42,Main,,0,0,0,,Kıskandım.Dialogue: 0,0:17:06.97,0:17:10.01,Main,,0,0,0,,Diğer taraftan gücün yarıya düşüyor.Dialogue: 0,0:17:10.01,0:17:12.92,Main,,0,0,0,,Anahtarımdan vazgeçsen iyi olur.Dialogue: 0,0:17:13.22,0:17:16.43,Main,,0,0,0,,B-Bunu yapamam!Dialogue: 0,0:17:16.43,0:17:18.20,Main,,0,0,0,,Soğuk Saldırı!Dialogue: 0,0:17:21.14,0:17:24.63,Main,,0,0,0,,Faydasız. Oyun saatimiz bitti.Dialogue: 0,0:17:25.44,0:17:26.24,Main,,0,0,0,,Bacak Fırtınası!Dialogue: 0,0:17:30.21,0:17:31.78,Main,,0,0,0,,Serap Tempo.Dialogue: 0,0:17:31.78,0:17:33.48,Main,,0,0,0,,Buradayım.Dialogue: 0,0:17:33.48,0:17:36.11,Main,,0,0,0,,Ne zaman...?! Bu nasıl olabilir?Dialogue: 0,0:17:36.11,0:17:36.91,Main,,0,0,0,,Parmak Tabanca!Dialogue: 0,0:17:42.69,0:17:45.49,Main,,0,0,0,,Bir sahte daha mı? Şimdi neredesin?Dialogue: 0,0:17:45.49,0:17:46.67,Main,,0,0,0,,Buraya, buraya!Dialogue: 0,0:17:52.78,0:17:54.01,Main,,0,0,0,,O da ne?Dialogue: 0,0:17:54.34,0:17:56.80,Main,,0,0,0,,B-Büyümüş mü?Dialogue: 0,0:18:00.08,0:18:02.90,Main,,0,0,0,,Sen de mi Şeytan Meyvesi kullanıcısısın?Dialogue: 0,0:18:03.56,0:18:05.18,Thoughts,,0,0,0,,Aptal sarışın.Dialogue: 0,0:18:49.02,0:18:51.26,Main,,0,0,0,,Robin!Dialogue: 0,0:19:59.67,0:20:01.29,Main,,0,0,0,,Yıkım Çağrısı!Dialogue: 0,0:20:01.29,0:20:03.09,Main,,0,0,0,,Savaş gemileri geliyor!Dialogue: 0,0:20:03.09,0:20:06.97,Main,,0,0,0,,Burada kalırsak bizi de yok edecekler!Dialogue: 0,0:20:06.97,0:20:09.10,Main,,0,0,0,,Kaçın!Dialogue: 0,0:20:16.73,0:20:20.28,Main,,0,0,0,,Zoan meyvesi... Gizli silahın bu muydu?Dialogue: 0,0:20:20.28,0:20:23.38,Main,,0,0,0,,O ben değilim dedim ya!Dialogue: 0,0:20:23.38,0:20:25.82,Thoughts,,0,0,0,,Ama o şey...Dialogue: 0,0:20:26.49,0:20:32.04,Thoughts,,0,0,0,,...rengeyiğine benziyor. Ayrıca şu şapka ve işaret var.Dialogue: 0,0:20:32.04,0:20:36.50,Thoughts,,0,0,0,,Ama gerçekten Chopper olamaz!Dialogue: 0,0:20:39.24,0:20:41.01,Main,,0,0,0,,Bir tür vahşi hayvan meyvesi mi?Dialogue: 0,0:20:43.51,0:20:44.72,Main,,0,0,0,,Ay Yürüyüşü!Dialogue: 0,0:20:47.14,0:20:48.31,Main,,0,0,0,,Bacak Fırtınası!Dialogue: 0,0:20:48.31,0:20:50.50,Main,,0,0,0,,Hey! Dur!Dialogue: 0,0:20:51.35,0:20:54.42,Main,,0,0,0,,Chopper! Hey, sen Chopper'sın, değil mi?Dialogue: 0,0:20:54.42,0:20:56.48,Main,,0,0,0,,Nasıl öyle oldun?Dialogue: 0,0:21:05.79,0:21:08.99,Main,,0,0,0,,Bedenim yüzünden mi beni tanımıyorsun?Dialogue: 0,0:21:08.99,0:21:10.54,Main,,0,0,0,,Sen Chopper değil misin?Dialogue: 0,0:21:11.48,0:21:16.83,Main,,0,0,0,,Dinle, o şeyin sen olduğunu asla düşünmedim!Dialogue: 0,0:21:17.50,0:21:18.71,Main,,0,0,0,,Chopper!Dialogue: 0,0:21:19.20,0:21:22.21,Thoughts,,0,0,0,,Beni görmezden geliyor! Küstah kız!Dialogue: 0,0:21:24.42,0:21:26.52,Main,,0,0,0,,Chopper! Sorun nedir?Dialogue: 0,0:21:26.52,0:21:29.55,Main,,0,0,0,,İyi bak, benim! Nami!Dialogue: 0,0:21:37.34,0:21:38.32,Main,,0,0,0,,Chopper!Dialogue: 0,0:21:43.20,0:21:44.36,Main,,0,0,0,,Chopper, kes şunu!Dialogue: 0,0:22:01.32,0:22:03.71,Main,,0,0,0,,Sanji-kun merdivenlerin dibindeydi.Dialogue: 0,0:22:03.71,0:22:07.33,Main,,0,0,0,,Bu yaratık nereden çıktı acaba?Dialogue: 0,0:22:07.33,0:22:10.55,Main,,0,0,0,,Ona dokunma! O benim arkadaşım!Dialogue: 0,0:22:34.44,0:22:36.41,Main,,0,0,0,,Chopper'a ne olmuş?Dialogue: 0,0:22:38.14,0:22:40.79,Main,,0,0,0,,Durum kötü. Onu bir an önce durdurmalıyım!Dialogue: 0,0:22:43.77,0:22:48.82,Main,,0,0,0,,Arkadaşın mı? Korsanların epey rahatsız edici hayvanları var.Dialogue: 0,0:22:48.82,0:22:50.26,Main,,0,0,0,,Chopper!Dialogue: 0,0:22:52.53,0:22:55.64,Thoughts,,0,0,0,,Yine mi beni görmezden geliyor? Küstah kız!Dialogue: 0,0:22:56.09,0:22:58.82,Main,,0,0,0,,O canavarı durdurmaya gidebilirsin...Dialogue: 0,0:22:58.82,0:23:02.40,Main,,0,0,0,,...ama seni durdurmam emredildi.Dialogue: 0,0:23:02.40,0:23:05.19,Main,,0,0,0,,Bu işi bitirme zamanım geldi.Dialogue: 0,0:23:05.19,0:23:06.14,Main,,0,0,0,,Bacak Fırtınası!Dialogue: 0,0:23:06.78,0:23:11.24,Thoughts,,0,0,0,,Hayır! Tüm bedenim böyleyken  saldırıyı atlatamam!Dialogue: 0,0:23:14.20,0:23:16.06,Main,,0,0,0,,Atlattım mı?Dialogue: 0,0:23:16.06,0:23:18.69,Thoughts,,0,0,0,,Bacaklarımdan biri normale dönmüş!Dialogue: 0,0:23:18.69,0:23:22.04,Thoughts,,0,0,0,,Niye? Ne oldu?Dialogue: 0,0:23:23.10,0:23:24.30,Thoughts,,0,0,0,,Islak.Dialogue: 0,0:23:24.30,0:23:27.38,Thoughts,,0,0,0,,Deminki karmaşa içinde... Evet!Dialogue: 0,0:23:28.38,0:23:33.18,Thoughts,,0,0,0,,Su! Sabunun gücü suyla giderilebilir!Dialogue: 0,0:23:46.19,0:23:48.11,Main,,0,0,0,,Beni hafife almıyor musun?Dialogue: 0,0:23:48.11,0:23:51.74,Main,,0,0,0,,Artık Altın Köpük'ten nasıl kurtulacağını bildiğine göre...Dialogue: 0,0:23:51.74,0:23:53.95,Main,,0,0,0,,...gerçekten bunu yapmana izin vereceğimi mi sanıyorsun?Dialogue: 0,0:23:57.45,0:24:00.41,Main,,0,0,0,,Koyun Bulutu: Rahatlatıcı Köpük!Dialogue: 0,0:24:01.65,0:24:04.71,Main,,0,0,0,,O köpükleri rüzgarla uzaklaştıracağım!Dialogue: 0,0:24:04.71,0:24:06.06,Main,,0,0,0,,Siklon-Dialogue: 0,0:24:08.36,0:24:09.56,Main,,0,0,0,,Kahretsin!Dialogue: 0,0:24:12.50,0:24:16.05,Main,,0,0,0,,Hayır, gücüm...Dialogue: 0,0:24:19.31,0:24:20.52,Main,,0,0,0,,Kıvrılan Parmak Tabanca!Dialogue: 0,0:24:21.49,0:24:22.73,Main,,0,0,0,,Aygıt...Dialogue: 0,0:24:22.73,0:24:24.08,Main,,0,0,0,,Kırbaç!Dialogue: 0,0:24:40.13,0:24:41.77,Main,,0,0,0,,Kurtuldum.Dialogue: 0,0:24:41.77,0:24:43.12,Main,,0,0,0,,Kurtuldun mu?Dialogue: 0,0:24:45.22,0:24:48.77,Main,,0,0,0,,Beni böyle savurursan,...Dialogue: 0,0:24:48.77,0:24:52.32,Main,,0,0,0,,...vücudumdaki can sıkıcı köpüklerden kurtulurum.Dialogue: 0,0:24:52.32,0:24:57.10,Main,,0,0,0,,Blöf yapıyorsun. Eğer dilersen,  seni ölene kadar savurmaya devam edeceğim.Dialogue: 0,0:25:00.59,0:25:02.77,Main,,0,0,0,,Hava bulutlu!Dialogue: 0,0:25:02.77,0:25:04.54,Main,,0,0,0,,Bulutlu Tempo!Dialogue: 0,0:25:07.84,0:25:11.28,Main,,0,0,0,,Eskiden olduğu gibi sihir gösterisi değil!Dialogue: 0,0:25:13.15,0:25:15.74,Main,,0,0,0,,Bulutlar. Daha çok yıldırım mı?Dialogue: 0,0:25:18.12,0:25:21.69,Main,,0,0,0,,Böyle küçük bulutlardan yıldırım çıkmaz.Dialogue: 0,0:25:21.69,0:25:24.79,Main,,0,0,0,,Başka bir şey yaparlar.Dialogue: 0,0:25:25.45,0:25:26.30,Main,,0,0,0,,Yapamazsın!Dialogue: 0,0:25:26.30,0:25:28.30,Main,,0,0,0,,Hayır, yapamazsın!Dialogue: 0,0:25:29.21,0:25:31.25,Main,,0,0,0,,Hava yağmurlu!Dialogue: 0,0:25:31.25,0:25:32.34,Main,,0,0,0,,Soğuk Topu!Dialogue: 0,0:25:32.34,0:25:33.63,Main,,0,0,0,,Kazı!Dialogue: 0,0:25:34.59,0:25:36.05,Main,,0,0,0,,Yağ...Dialogue: 0,0:25:36.05,0:25:37.88,Main,,0,0,0,,Yağmur Tempo!Dialogue: 0,0:25:45.98,0:25:50.23,Main,,0,0,0,,Seni bu kadar güzelleştirdikten sonra bu hiç de hoş değil.Dialogue: 0,0:25:50.23,0:25:55.11,Main,,0,0,0,,Teslim olmak güzelse, reddetmek zorundayım.Dialogue: 0,0:25:55.11,0:25:56.65,Main,,0,0,0,,Soğuk Saldırı!Dialogue: 0,0:26:02.54,0:26:04.71,Main,,0,0,0,,Serap Tempo!Dialogue: 0,0:26:07.44,0:26:08.61,Main,,0,0,0,,Gitti mi?Dialogue: 0,0:26:08.61,0:26:12.46,Main,,0,0,0,,Güçlerini ve CP9'un...Dialogue: 0,0:26:13.97,0:26:16.13,Main,,0,0,0,,...kuvvetini anlıyorum.Dialogue: 0,0:26:16.13,0:26:18.45,Main,,0,0,0,,Bu da ne?Dialogue: 0,0:26:20.49,0:26:22.25,Main,,0,0,0,,Serap Tempo:Dialogue: 0,0:26:23.26,0:26:25.93,Main,,0,0,0,,*Fata Morgana!Dialogue: 0,0:26:25.93,0:26:29.80,Credits,,0,0,0,,Editing:  Galaxy 9000  Timing: Galaxy 9000  Quality Control: danpmss, DolphinWeabu, Galaxy 9000, Honoka, ItsKipz, Pepperjack  Soundtracking:  Halee  Graphics:  Datenshi  Karaoke: KaitouYahiko  Translation: Crunchyroll, Gaijin