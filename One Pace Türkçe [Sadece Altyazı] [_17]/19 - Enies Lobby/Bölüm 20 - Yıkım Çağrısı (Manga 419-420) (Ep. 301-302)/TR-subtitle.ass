Dialogue: 1,0:01:50.00,0:01:53.84,Title,,0,0,0,,{\fad(550,0)}Yıkım Çağrısı
Dialogue: 0,0:02:12.32,0:02:15.78,Main,,0,0,0,,Hey, şuna bakın!\NBunu ilk kez görüyorum!
Dialogue: 0,0:02:15.78,0:02:20.24,Main,,0,0,0,,Haklısın! Olduğunu bile hiç duymamıştım.
Dialogue: 0,0:02:21.95,0:02:25.12,Main,,0,0,0,,Adalet Kapısı tamamiyle açıldı!
Dialogue: 0,0:02:25.12,0:02:28.21,Main,,0,0,0,,Karargâh'tan gelen savaş gemilerinin geçmesi için!
Dialogue: 0,0:02:28.21,0:02:31.21,Main,,0,0,0,,Yıkım Çağrısı için!
Dialogue: 0,0:02:35.55,0:02:41.64,Main,,0,0,0,,Kokoro nine kapının hiç tamamiyle\Naçılmadığını söylemişti.
Dialogue: 0,0:02:42.26,0:02:47.35,Main,,0,0,0,,Neler oluyor?\NYıkım Çağrısı nedir?
Dialogue: 0,0:02:47.35,0:02:49.69,Main,,0,0,0,,Hasır Şapkalar dünyaya karşı bir savaş başlattı.
Dialogue: 0,0:02:49.69,0:02:52.86,Main,,0,0,0,,Onları yok etmek için buraya kadar geliyorlar mı?
Dialogue: 0,0:02:52.86,0:02:54.65,Main,,0,0,0,,Kahretsin!
Dialogue: 0,0:02:54.65,0:02:57.78,Main,,0,0,0,,Lütfen ölme, Ağabey!
Dialogue: 0,0:02:57.78,0:02:59.11,Main,,0,0,0,,Yeah!
Dialogue: 0,0:02:59.11,0:03:00.78,Main,,0,0,0,,Yaşa ve geri dön!
Dialogue: 0,0:03:00.78,0:03:03.32,Main,,0,0,0,,Hasır Şapka!
Dialogue: 0,0:03:16.17,0:03:21.01,Main,,0,0,0,,Franky, Robin'le ilgilenecek.
Dialogue: 0,0:03:22.64,0:03:27.72,Thoughts,,0,0,0,,Dikkatsizlik ettim.\NBu kadar gücü olabileceğini hiç düşünmemiştim.
Dialogue: 0,0:03:27.72,0:03:31.19,Main,,0,0,0,,Nefes alman zorlaşmış gibi görünüyor.
Dialogue: 0,0:03:31.19,0:03:33.23,Main,,0,0,0,,Buhar yüzünden mi?
Dialogue: 0,0:03:39.24,0:03:43.11,Main,,0,0,0,,Seni yenebilirsem sorun değil.
Dialogue: 0,0:03:46.95,0:03:49.20,Main,,0,0,0,,Anlıyorum. Ne kadar inatçı.
Dialogue: 0,0:03:51.50,0:03:52.96,Main,,0,0,0,,Başarmak zorundayım!
Dialogue: 0,0:03:53.75,0:03:55.88,Main,,0,0,0,,Henüz gitme, Nico Robin!
Dialogue: 0,0:03:58.30,0:04:00.05,Main,,0,0,0,,Muhafızlar, dışarı!
Dialogue: 0,0:04:00.05,0:04:01.05,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:04:07.97,0:04:10.41,Main,,0,0,0,,Adalet Kapısı muhafızları!
Dialogue: 0,0:04:10.41,0:04:13.19,Main,,0,0,0,,Denizci Karargâhı konvoy gemisi askerleri!
Dialogue: 0,0:04:14.35,0:04:18.53,Main,,0,0,0,,Şu anda, Cipher Pol 9'un lideri olan Şef Spandam...
Dialogue: 0,0:04:18.53,0:04:24.74,Main,,0,0,0,,...Adalet Kulesi'nden buraya doğru\Nçok tehlikeli bir suçluya eşlik ediyor.
Dialogue: 0,0:04:25.28,0:04:27.66,Main,,0,0,0,,Tüm birlikler sıraya girip selam dursun!
Dialogue: 0,0:04:27.66,0:04:28.62,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:04:38.21,0:04:41.01,Main,,0,0,0,,Bak, gemiyi çoktan hazırlamışlar.
Dialogue: 0,0:04:41.01,0:04:43.88,Main,,0,0,0,,Önümüzde hiçbir engel kalmadı.
Dialogue: 0,0:04:48.43,0:04:50.39,Main,,0,0,0,,Sahi, Nico Robin.
Dialogue: 0,0:04:50.39,0:04:53.77,Main,,0,0,0,,Senin için birkaç iyi haberim var.
Dialogue: 0,0:04:54.56,0:05:00.61,Main,,0,0,0,,Demin çıktığımız merdivenlerin\Nyukarısına mayın yerleştirdim.
Dialogue: 0,0:05:00.61,0:05:05.03,Main,,0,0,0,,Eğer biri buraya gelmeye çalışırsa,...
Dialogue: 0,0:05:05.03,0:05:10.49,Main,,0,0,0,,..."BOM" ve havaya uçacaklar.
Dialogue: 0,0:05:10.95,0:05:13.20,Main,,0,0,0,,Nasıl? Harika, değil mi?
Dialogue: 0,0:05:13.20,0:05:16.37,Main,,0,0,0,,Ama endişeye gerek yok.
Dialogue: 0,0:05:16.37,0:05:19.59,Main,,0,0,0,,Merdivenlere kadar gelmeyi\Nbaşarabilecek hiç kimse yok.
Dialogue: 0,0:05:23.87,0:05:27.09,Main,,0,0,0,,Ama ben kapıdan geçmeyeceğim!
Dialogue: 0,0:05:37.81,0:05:40.31,Main,,0,0,0,,Beni kurtaracaklarını söylediler.
Dialogue: 0,0:05:40.31,0:05:43.40,Main,,0,0,0,,Kimse gelmiyor, aptal kadın!
Dialogue: 0,0:05:43.90,0:05:48.49,Main,,0,0,0,,Hepsi Yıkım Çağrısı'nın alevlerine\Nkapılacak ve ölümüne yanacak!
Dialogue: 0,0:05:49.91,0:05:54.18,Main,,0,0,0,,Korsanların kutsal bayrağımızı\Nyakması utanç vericiydi.
Dialogue: 0,0:05:54.21,0:05:57.25,Main,,0,0,0,,Bu yüzden Yıkım Çağrısı onları yok edecek!
Dialogue: 0,0:05:58.50,0:06:04.01,Main,,0,0,0,,Aynı 20 yıl önce Ohara'yı kasıp\Nkavuran Denizci devi gibi.
Dialogue: 0,0:06:05.26,0:06:07.22,Main,,0,0,0,,Şimdi, kıpırda.
Dialogue: 0,0:06:07.76,0:06:10.22,Main,,0,0,0,,Kendi ayaklarınla yürü!
Dialogue: 0,0:06:10.80,0:06:11.76,Thoughts,,0,0,0,,Saul...
Dialogue: 0,0:06:13.85,0:06:14.81,Main,,0,0,0,,Seni...
Dialogue: 0,0:06:17.35,0:06:19.35,Main,,0,0,0,,Şef, lütfen acele edin!
Dialogue: 0,0:06:19.35,0:06:23.23,Main,,0,0,0,,Biliyorum, kapa çeneni! \NBen kahramanım!
Dialogue: 0,0:06:23.23,0:06:26.86,Main,,0,0,0,,Sen, bahse varım hiçbir şey\Nbilmediğimi düşünüyorsun, değil mi?
Dialogue: 0,0:06:27.36,0:06:31.95,Main,,0,0,0,,Eski Koramiral Jaguar D. Saul'un\Ngörevini kötüye kullandığını,...
Dialogue: 0,0:06:31.95,0:06:37.91,Main,,0,0,0,,...annen Olvia'yı, Ohara'ya olanları,...
Dialogue: 0,0:06:38.33,0:06:40.25,Main,,0,0,0,,...her şeyi biliyorum!
Dialogue: 0,0:06:41.67,0:06:43.75,Main,,0,0,0,,Niye diye merak ediyor musun?
Dialogue: 0,0:06:43.75,0:06:45.34,Main,,0,0,0,,Çünkü bana anlatıldı.
Dialogue: 0,0:06:45.34,0:06:50.59,Main,,0,0,0,,Şeytanlar yurdu Ohara'ya giden kişi,\Nsuçlarını ortaya çıkaran kişi...
Dialogue: 0,0:06:50.59,0:06:55.72,Main,,0,0,0,,...Yıkım Çağrısı sinyalini gönderen kişi,\No zamanlar CP9'un başıydı.
Dialogue: 0,0:06:55.72,0:06:59.31,Main,,0,0,0,,Babam Spandine'dı!
Dialogue: 0,0:07:04.98,0:07:07.03,Flashbacks,,0,0,0,,Pekâla Ohara bilginleri,...
Dialogue: 0,0:07:07.69,0:07:11.32,Flashbacks,,0,0,0,,...böylece ölüme mahkum olmanıza karar verildi!
Dialogue: 0,0:07:13.57,0:07:14.33,Flashbacks,,0,0,0,,Kurtulun onlardan!
Dialogue: 0,0:07:24.25,0:07:26.67,Flashbacks,,0,0,0,,Profesör!
Dialogue: 0,0:07:29.72,0:07:31.13,Flashbacks,,0,0,0,,Ohara...
Dialogue: 0,0:07:34.51,0:07:36.60,Flashbacks,,0,0,0,,...çok fazla şey biliyordu.
Dialogue: 0,0:07:37.01,0:07:38.77,Flashbacks,,0,0,0,,Yıkım Çağrısı!
Dialogue: 0,0:07:39.35,0:07:40.73,Flashbacks,,0,0,0,,Gerisini size bırakıyorum.
Dialogue: 0,0:07:50.32,0:07:52.70,Flashbacks,,0,0,0,,Git artık, Saul!
Dialogue: 0,0:07:55.29,0:07:56.99,Flashbacks,,0,0,0,,Olur mu dersin?
Dialogue: 0,0:07:56.99,0:07:57.74,Flashbacks,,0,0,0,,Evet.
Dialogue: 0,0:07:58.24,0:08:02.16,Flashbacks,,0,0,0,,Hayır! Ben de burada kalacağım!
Dialogue: 0,0:08:02.16,0:08:04.88,Flashbacks,,0,0,0,,Anne!
Dialogue: 0,0:08:04.88,0:08:07.80,Flashbacks,,0,0,0,,Bana böyle seslenmene çok sevindim.
Dialogue: 0,0:08:08.38,0:08:09.76,Flashbacks,,0,0,0,,Sağol.
Dialogue: 0,0:08:10.51,0:08:13.30,Flashbacks,,0,0,0,,Şu andan itibaren benim için de...
Dialogue: 0,0:08:13.30,0:08:14.84,Flashbacks,,0,0,0,,Yaşa, Robin!
Dialogue: 0,0:08:23.19,0:08:28.73,Main,,0,0,0,,Bana Ohara'daki herkesin öldüğü söylendi.
Dialogue: 0,0:08:28.73,0:08:32.45,Main,,0,0,0,,Ama hükümet, kaçan bir veledin izini kaybetti.
Dialogue: 0,0:08:34.11,0:08:35.11,Main,,0,0,0,,Nasıldı?
Dialogue: 0,0:08:35.53,0:08:41.62,Main,,0,0,0,,O sekiz yaşındaki çocuk, para arayan yetişkinler\Ntarafından kaç kez öldürülme tehlikesi atlattı?
Dialogue: 0,0:08:43.58,0:08:47.04,Main,,0,0,0,,Yanında kaldığın kimseye güvenemedin.
Dialogue: 0,0:08:47.04,0:08:51.05,Main,,0,0,0,,Huzurla uyuyacağın bir yer olmadı.\NAç kaldın.
Dialogue: 0,0:08:51.84,0:08:56.64,Main,,0,0,0,,O 20 yılın neye benzediğini\Nhayal bile etmek istemiyorum.
Dialogue: 0,0:08:58.49,0:09:01.02,Main,,0,0,0,,Çok korkunç olduğu için mi ağlıyorsun?
Dialogue: 0,0:09:01.02,0:09:05.60,Main,,0,0,0,,Yirmi yıl önce başına ödül koyan...
Dialogue: 0,0:09:05.60,0:09:07.56,Main,,0,0,0,,...babamdı!
Dialogue: 0,0:09:08.56,0:09:10.19,Main,,0,0,0,,Her şey dünya huzuru için!
Dialogue: 0,0:09:14.11,0:09:20.28,Main,,0,0,0,,Şimdi, 20 yıl sonra o adamın oğlu, \NOhara'nın hayatta kalan son kişisini yakalayarak,...
Dialogue: 0,0:09:20.28,0:09:23.25,Main,,0,0,0,,...Ohara savaşının perdesini kapatıyor.
Dialogue: 0,0:09:24.41,0:09:26.92,Main,,0,0,0,,Ohara kaybetti!
Dialogue: 0,0:09:29.34,0:09:32.34,Flashbacks,,0,0,0,,Robin! Gurur duy, Robin!
Dialogue: 0,0:09:33.55,0:09:37.51,Flashbacks,,0,0,0,,Annen iyi iş çıkardı!\NOhara iyi iş çıkardı!
Dialogue: 0,0:09:37.51,0:09:41.76,Flashbacks,,0,0,0,,Bir gün bu adanın tarihini aktaracaksın, Robin!
Dialogue: 0,0:09:42.22,0:09:45.85,Flashbacks,,0,0,0,,{\fad(0,550)}Ohara, dünyayla dövüştü!
Dialogue: 0,0:09:51.90,0:09:54.10,Main,,0,0,0,,Ben hala yaşıyorum!
Dialogue: 0,0:09:54.10,0:09:58.52,Main,,0,0,0,,Ama öleceksin, değil mi?! Ha?
Dialogue: 0,0:10:08.45,0:10:09.44,Main,,0,0,0,,Ne?
Dialogue: 0,0:10:16.13,0:10:19.09,Main,,0,0,0,,C-Cutty Flam? O niye buradaydı?
Dialogue: 0,0:10:19.47,0:10:22.39,Main,,0,0,0,,Neyse. Mayına bastı. Aptal!
Dialogue: 0,0:10:22.39,0:10:24.56,Main,,0,0,0,,Mayın ona hak ettiği dersi verdi!
Dialogue: 0,0:10:26.81,0:10:28.77,Thoughts,,0,0,0,,Benim için gelmiş!
Dialogue: 0,0:10:28.77,0:10:32.44,Main,,0,0,0,,Ama durum kötü. Bunu beklemem iyi oldu.
Dialogue: 0,0:10:33.77,0:10:35.23,Main,,0,0,0,,Gel hadi!
Dialogue: 0,0:10:37.11,0:10:39.03,Thoughts,,0,0,0,,Söyleyemem.
Dialogue: 0,0:10:39.03,0:10:42.99,Main,,0,0,0,,Hey, gemiyi harekete geçirin, Denizciler! \NBinin hemen!
Dialogue: 0,0:10:42.99,0:10:45.04,Main,,0,0,0,,Emredersiniz, anlaşıldı!
Dialogue: 0,0:10:45.04,0:10:46.41,Main,,0,0,0,,Kalkıyoruz!
Dialogue: 0,0:10:46.41,0:10:47.12,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:10:48.00,0:10:51.08,Thoughts,,0,0,0,,O kadar acı verici ki göz\Nyaşlarıma engel olamıyorum!
Dialogue: 0,0:10:55.30,0:10:57.21,Main,,0,0,0,,İyi izle!
Dialogue: 0,0:10:57.21,0:11:02.43,Main,,0,0,0,,Bu, tarihe geçecek kahramanın ilk adımı olacak! İlk-
Dialogue: 0,0:11:16.57,0:11:18.65,Main,,0,0,0,,İyi misiniz, Şef?
Dialogue: 0,0:11:19.32,0:11:20.99,Main,,0,0,0,,Ne? Kim var orada?
Dialogue: 0,0:11:20.99,0:11:22.49,Main,,0,0,0,,Köprüde kimse yok!
Dialogue: 0,0:11:22.49,0:11:26.41,Main,,0,0,0,,Bu imkansız! Bir yerde \Nsaklanıyor olmalılar! Arayın!
Dialogue: 0,0:11:26.99,0:11:28.04,Main,,0,0,0,,Nerede?
Dialogue: 0,0:11:38.13,0:11:42.13,Main,,0,0,0,,Hey! Ne yapıyorsunuz?\NNeden saldırmıyorsun?!
Dialogue: 0,0:11:42.13,0:11:45.43,Main,,0,0,0,,Ama Şef, düşmanı bulamıyoruz!
Dialogue: 0,0:11:47.39,0:11:50.02,Main,,0,0,0,,Ah! Orada!
Dialogue: 0,0:12:06.74,0:12:09.62,Main,,0,0,0,,Adalet Kulesi'nin çatısında!
Dialogue: 0,0:12:09.62,0:12:14.42,Main,,0,0,0,,Adalet Kulesi mi?!\NOradan ne yapabilirler ki?!
Dialogue: 0,0:12:21.17,0:12:23.58,Main,,0,0,0,,O herif ne öyle?!
Dialogue: 0,0:12:24.01,0:12:28.89,Main,,0,0,0,,Bu mesafeden rüzgar eserken\Nbizi vurmayı nasıl başarıyor?
Dialogue: 0,0:12:28.89,0:12:30.39,Main,,0,0,0,,Kim o?!
Dialogue: 0,0:12:31.39,0:12:32.85,Main,,0,0,0,,Uzun Burun-kun!
Dialogue: 0,0:12:33.64,0:12:37.31,Main,,0,0,0,,Bak, keskin nişancımız harika, değil mi?
Dialogue: 0,0:12:38.61,0:12:41.07,Main,,0,0,0,,O aptallar kendilerine gelen şeyi yuttular!
Dialogue: 0,0:12:41.07,0:12:42.78,Main,,0,0,0,,Robin-chan, kaç!
Dialogue: 0,0:12:43.82,0:12:45.70,Main,,0,0,0,,Gerçekten şarkı söylemesi gerekiyor mu?
Dialogue: 0,0:12:45.70,0:12:48.28,Main,,0,0,0,,Pislik!
Dialogue: 0,0:12:51.00,0:12:52.12,Main,,0,0,0,,Şef!
Dialogue: 0,0:12:55.08,0:13:00.13,Main,,0,0,0,,Kahretsin! Siz ne yapıyorsunuz?!\NHemen öldürün onu!
Dialogue: 0,0:13:00.13,0:13:05.26,Main,,0,0,0,,Deniyoruz! Ama mermilerimiz o kadar uzağa gitmiyor!\NÜstelik bu mesafeden nişan almak zor!
Dialogue: 0,0:13:05.26,0:13:08.10,Main,,0,0,0,,O keskin nişancı müthiş!
Dialogue: 0,0:13:08.85,0:13:10.56,Main,,0,0,0,,Nico Robin kaçıyor!
Dialogue: 0,0:13:10.56,0:13:13.68,Main,,0,0,0,,Kaçmasına izin vermeyin, aptallar!\NVurun onu!
Dialogue: 0,0:13:13.68,0:13:16.94,Main,,0,0,0,,– Emredersiniz!\N– Onu öldürmeden ölümüne vurun!
Dialogue: 0,0:13:16.94,0:13:17.52,Main,,0,0,0,,Ne?
Dialogue: 0,0:13:31.29,0:13:32.75,Main,,0,0,0,,Ateş!
Dialogue: 0,0:14:09.82,0:14:12.08,Main,,0,0,0,,O da kim?!
Dialogue: 0,0:14:12.70,0:14:14.08,Main,,0,0,0,,Sen...
Dialogue: 0,0:14:16.54,0:14:19.67,Main,,0,0,0,,Bana bir şey olmaz, çelikten yapıldım.
Dialogue: 0,0:14:19.67,0:14:21.50,Main,,0,0,0,,Mayının işe yaramadı, Spanda!
Dialogue: 0,0:14:23.21,0:14:27.77,Main,,0,0,0,,Franky-{\i1}kun{\i0}, Franky-{\i1}kun{\i0}.\NBen Sogeking.
Dialogue: 0,0:14:27.77,0:14:30.97,Main,,0,0,0,,Ha? Den Den Mushi.
Dialogue: 0,0:14:30.97,0:14:32.81,Main,,0,0,0,,Nami'den aldım.
Dialogue: 0,0:14:32.81,0:14:37.64,Main,,0,0,0,,Asıl mesele, yakınında kırmızı bir elbise olmalı.
Dialogue: 0,0:14:37.64,0:14:38.89,Main,,0,0,0,,Kırmızı elbise?
Dialogue: 0,0:14:38.89,0:14:40.10,Main,,0,0,0,,Evet, var!
Dialogue: 0,0:14:40.10,0:14:42.27,Main,,0,0,0,,İçinde iki anahtar var.
Dialogue: 0,0:14:42.27,0:14:45.11,Main,,0,0,0,,Sendekileri de hesaba katarsak,\Nhepsi bu kadar olmalı.
Dialogue: 0,0:14:46.19,0:14:48.03,Main,,0,0,0,,Tüm anahtarlar mı?!
Dialogue: 0,0:14:49.78,0:14:51.74,Main,,0,0,0,,Sana tam hedefe ulaştırdım.
Dialogue: 0,0:14:52.91,0:14:54.16,Main,,0,0,0,,Görev tamamlandı.
Dialogue: 0,0:14:55.29,0:14:57.45,Main,,0,0,0,,Acele etmeliyiz. Burası tehlikeli.
Dialogue: 0,0:14:57.45,0:14:59.00,Main,,0,0,0,,Bir numara.
Dialogue: 0,0:14:59.00,0:15:00.42,Main,,0,0,0,,Üç numara.
Dialogue: 0,0:15:00.42,0:15:02.13,Main,,0,0,0,,Dört numara. Hayır!
Dialogue: 0,0:15:02.13,0:15:03.17,Main,,0,0,0,,Beş numara!
Dialogue: 0,0:15:05.09,0:15:06.05,Main,,0,0,0,,İşe yaradı!
Dialogue: 0,0:15:10.93,0:15:13.89,Main,,0,0,0,,İmkansız!\NG-Gerçek anahtarlar mı?!
Dialogue: 0,0:15:16.01,0:15:18.14,Main,,0,0,0,,Hey, hey, dayan biraz.
Dialogue: 0,0:15:18.14,0:15:20.56,Main,,0,0,0,,Ama bunun anlamı...
Dialogue: 0,0:15:22.26,0:15:27.53,Main,,0,0,0,,...Adalet Kulesi'ndeki bütün\NCP9 üyelerini yendiniz mi?!
Dialogue: 0,0:15:35.37,0:15:37.04,Main,,0,0,0,,Hayır, bu imkansız!
Dialogue: 0,0:15:37.04,0:15:40.83,Main,,0,0,0,,Muhtemelen anahtarları çalıp \Nkaçmışsınızdır. Kahretsin!
Dialogue: 0,0:15:41.62,0:15:44.42,Main,,0,0,0,,Ben Franky! Hey, Uzun Burun!
Dialogue: 0,0:15:44.88,0:15:47.46,Main,,0,0,0,,Nico Robin'in kelepçesi açıldı.
Dialogue: 0,0:15:47.46,0:15:48.92,Main,,0,0,0,,Oley!
Dialogue: 0,0:15:49.30,0:15:51.51,Main,,0,0,0,,Uzun Burun-kun, teşekkür ederim.
Dialogue: 0,0:15:52.05,0:15:57.10,Main,,0,0,0,,Tüm bunlar sona erince, anahtarları\Nalanlara teşekkür etmek için beklemelisin.
Dialogue: 0,0:15:57.93,0:16:02.14,Main,,0,0,0,,Hiç şüphesiz Luffy-kungil'in arkadaşısın!
Dialogue: 0,0:16:02.14,0:16:04.65,Main,,0,0,0,,Bunu unutma ve git!
Dialogue: 0,0:16:06.23,0:16:07.27,Main,,0,0,0,,Evet.
Dialogue: 0,0:16:09.94,0:16:11.74,Main,,0,0,0,,{\fad(150,150)}Altı Çiçek!
Dialogue: 0,0:16:12.70,0:16:14.20,Main,,0,0,0,,Ne?
Dialogue: 0,0:16:14.20,0:16:15.82,Main,,0,0,0,,{\fad(150,150)}Tokatla!
Dialogue: 0,0:16:24.89,0:16:26.92,Main,,0,0,0,,Artık bunu istediğim kadar yapabilirim.
Dialogue: 0,0:16:36.30,0:16:38.06,Main,,0,0,0,,Şef!
Dialogue: 0,0:16:38.06,0:16:41.35,Main,,0,0,0,,Tamam, siz de bir an önce buraya gelin!
Dialogue: 0,0:16:41.35,0:16:43.89,Main,,0,0,0,,Gitmek için her şeyi hazırlayacağım!
Dialogue: 0,0:16:43.89,0:16:45.60,Main,,0,0,0,,Anlaşıldı!
Dialogue: 0,0:16:46.52,0:16:48.61,Main,,0,0,0,,Hemen aşağı gel, Sogeking!
Dialogue: 0,0:16:48.61,0:16:52.44,Main,,0,0,0,,Hayır! Suçlunun deniz taşı kelepçesi çıktı!
Dialogue: 0,0:16:52.44,0:16:54.20,Main,,0,0,0,,Onu yeniden yakalayın!
Dialogue: 0,0:16:56.74,0:16:59.70,Main,,0,0,0,,Aynen planladığım gibi.
Dialogue: 0,0:17:02.29,0:17:03.83,Thoughts,,0,0,0,,Ne?
Dialogue: 0,0:17:07.42,0:17:08.84,Thoughts,,0,0,0,,Bir şey duydum.
Dialogue: 0,0:17:25.64,0:17:26.65,Main,,0,0,0,,Ne?
Dialogue: 0,0:17:32.23,0:17:33.69,Main,,0,0,0,,Yoksa...
Dialogue: 0,0:17:36.78,0:17:38.66,Main,,0,0,0,,Savaş gemileri mi saldırıyor?
Dialogue: 0,0:17:38.66,0:17:39.95,Main,,0,0,0,,Parmaklıklar...
Dialogue: 0,0:17:44.96,0:17:51.55,Main,,0,0,0,,Koramiral!\NÖnceki saldırı 4 yönüne isabet etti!
Dialogue: 0,0:17:51.55,0:17:53.59,Main,,0,0,0,,– Ne olmuş?\N– Ha?
Dialogue: 0,0:17:53.59,0:17:55.88,Main,,0,0,0,,Bunun nesi önemli diye soruyorum.
Dialogue: 0,0:17:55.88,0:17:57.80,Main,,0,0,0,,Emredersiniz. Emin değilim.
Dialogue: 0,0:17:57.80,0:18:02.31,Main,,0,0,0,,Bu rastgele bir saldırı.\NNe vurduğumuzun önemi yok.
Dialogue: 0,0:18:02.31,0:18:03.27,Main,,0,0,0,,Emredersiniz.
Dialogue: 0,0:18:03.27,0:18:07.02,Main,,0,0,0,,Görevimiz her şeyi alevlere boğmak.
Dialogue: 0,0:18:09.86,0:18:12.36,Main,,0,0,0,,Adayı çevreleyen parmaklık yok edildi.
Dialogue: 0,0:18:12.36,0:18:13.94,Main,,0,0,0,,Epey büyük bir patlamaydı.
Dialogue: 0,0:18:14.44,0:18:18.61,Main,,0,0,0,,Çok fazla gemi gelince\Nsaldırılar yağmur gibi olacak.
Dialogue: 0,0:18:18.61,0:18:19.95,Main,,0,0,0,,Bak.
Dialogue: 0,0:18:21.24,0:18:27.58,Main,,0,0,0,,Gemilerin bu denize girmesini\Nimkansız kılan girdaplar kayboldu.
Dialogue: 0,0:18:28.00,0:18:31.42,Main,,0,0,0,,Adalet Kapısı saldırılar\Niçin açıldığında böyle oldu.
Dialogue: 3,0:18:31.42,0:18:33.98,Main,,0,0,0,,Kapı, deniz akıntılarını...
Dialogue: 3,0:18:34.00,0:18:36.13,Main,,0,0,0,,...engelleyerek bu girdapları oluşturuyordu.
Dialogue: 3,0:18:36.13,0:18:39.18,Main,,0,0,0,,Kapı açılınca akıntılar engellenmediği için...
Dialogue: 3,0:18:39.18,0:18:41.30,Main,,0,0,0,,...her şey normale döndü...
Dialogue: 3,0:18:41.30,0:18:43.39,Main,,0,0,0,,...ve girdaplar yok oldu.
Dialogue: 0,0:18:43.85,0:18:45.39,Main,,0,0,0,,Yani savaş gemileri...
Dialogue: 0,0:18:45.39,0:18:47.64,Main,,0,0,0,,...kolayca girebilecek.
Dialogue: 0,0:18:49.65,0:18:52.23,Main,,0,0,0,,– Sogeking!\N– Zamanımız tükendi!
Dialogue: 0,0:18:52.23,0:18:53.77,Main,,0,0,0,,Oradan atla!
Dialogue: 0,0:18:55.40,0:18:57.57,Main,,0,0,0,,Nasıl yapabilirim!
Dialogue: 0,0:18:57.57,0:19:02.16,Main,,0,0,0,,Sizinki gibi insan üstü bir gücüm yok.
Dialogue: 0,0:19:02.16,0:19:05.54,Main,,0,0,0,,Bunu yapabilmem mümkün değil!
Dialogue: 0,0:19:05.54,0:19:08.79,Main,,0,0,0,,Ben tamamiyle normal bir süper kahramanım!
Dialogue: 0,0:19:12.88,0:19:14.46,Main,,0,0,0,,Usopp!
Dialogue: 0,0:19:16.30,0:19:17.92,Main,,0,0,0,,Adalet Kulesi?
Dialogue: 0,0:19:18.34,0:19:19.55,Main,,0,0,0,,Uzun Burun-kun!
Dialogue: 0,0:19:19.55,0:19:20.72,Main,,0,0,0,,Uzun Burun!
Dialogue: 0,0:19:20.72,0:19:23.39,Main,,0,0,0,,Bakın, bu kez Adalet Kulesi'ni vurdular!
Dialogue: 0,0:19:23.39,0:19:25.68,Main,,0,0,0,,Adalet Kulesi mi?
Dialogue: 0,0:19:26.06,0:19:28.64,Main,,0,0,0,,Onlar iyi mi?
Dialogue: 0,0:19:34.98,0:19:38.15,Main,,0,0,0,,O patlama hiç de normal değildi!
Dialogue: 0,0:19:38.15,0:19:39.90,Main,,0,0,0,,Saldırı altındayız!
Dialogue: 0,0:19:39.90,0:19:41.57,Main,,0,0,0,,Hemen adadan çıkalım!
Dialogue: 0,0:20:20.49,0:20:22.24,Main,,0,0,0,,Bu olamaz.
Dialogue: 0,0:20:23.20,0:20:26.70,Main,,0,0,0,,HEY! USOPP!
Dialogue: 0,0:20:29.79,0:20:32.75,Main,,0,0,0,,Sen mi çağırdın?!
Dialogue: 0,0:20:39.17,0:20:40.38,Main,,0,0,0,,Hayatta mıydın?!
Dialogue: 0,0:20:40.38,0:20:43.43,Main,,0,0,0,,Hayatını riske atarak aşağı atlayan kahramanı...
Dialogue: 0,0:20:43.43,0:20:46.60,Main,,0,0,0,,...kurtarmaya bile çalışmadınız mı?! Aptallar!
Dialogue: 0,0:20:48.68,0:20:52.77,Main,,0,0,0,,Franky, Robin-chan, biz iyiyiz.\NŞimdi oraya geliyoruz!
Dialogue: 0,0:20:53.52,0:20:54.73,Main,,0,0,0,,Hele şükür.
Dialogue: 0,0:20:54.73,0:20:57.11,Main,,0,0,0,,O zaman burada bir şeyler yapmalıyız.
Dialogue: 0,0:20:57.11,0:20:59.78,Main,,0,0,0,,Dövüşecek kadar iyi misin?
Dialogue: 0,0:20:59.78,0:21:01.23,Main,,0,0,0,,Elbette.
Dialogue: 0,0:21:01.23,0:21:05.20,Main,,0,0,0,,Çabuk olun beyler!\NSaldırı tam anlamıyla başlamadan!
Dialogue: 0,0:21:05.20,0:21:06.45,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:21:06.91,0:21:09.79,Main,,0,0,0,,Bu köprünün diğer tarafında konvoy gemisi var.
Dialogue: 0,0:21:09.79,0:21:12.70,Main,,0,0,0,,Sence o gemi, buradan çıkış biletimiz olur mu?
Dialogue: 0,0:21:12.70,0:21:15.87,Main,,0,0,0,,Gemi çalmak, kaçmanın tek yoluymuş gibi görünüyor.
Dialogue: 0,0:21:15.87,0:21:17.83,Main,,0,0,0,,Haklayın onları!
Dialogue: 0,0:21:22.71,0:21:23.51,Main,,0,0,0,,{\fad(150,150)}Ustura!
Dialogue: 0,0:21:29.01,0:21:30.56,Main,,0,0,0,,{\fad(150,150)}Jet Tabanca!
Dialogue: 0,0:21:51.83,0:21:53.45,Main,,0,0,0,,Düşündüğüm gibi.
Dialogue: 0,0:21:55.29,0:21:58.04,Main,,0,0,0,,Temelde doping yapıyorsun.
Dialogue: 0,0:21:58.04,0:22:01.21,Main,,0,0,0,,Kanının akışını hızlandırmak için\Nbacaklarını pompa gibi kullanıyorsun.
Dialogue: 0,0:22:01.88,0:22:06.80,Main,,0,0,0,,Normal bir insan olsaydın, kan basıncının\Nbu kadar yükselmesi kalbini patlatmaya yeterdi.
Dialogue: 0,0:22:06.80,0:22:10.43,Main,,0,0,0,,Ama organların ve damarların lastik\Nolduğu için bununla başedebiliyorsun.
Dialogue: 0,0:22:10.43,0:22:12.51,Main,,0,0,0,,Sadece lastik insan tarafından\Nkullanılabilecek bir yetenek.
Dialogue: 0,0:22:13.14,0:22:17.56,Main,,0,0,0,,Kesinlikle bedeninin sınırlarını zorluyorsun.
Dialogue: 0,0:22:17.56,0:22:21.73,Main,,0,0,0,,Bedenin buna zor zar dayanabiliyor!\NPek akıllı değilsin.
Dialogue: 0,0:22:22.27,0:22:25.82,Main,,0,0,0,,Yaşamını kısaltıyorsun!
Dialogue: 0,0:22:26.32,0:22:29.07,Main,,0,0,0,,Her şeyin benden alınmasından iyidir!
Dialogue: 0,0:22:29.82,0:22:32.20,Main,,0,0,0,,Yapabildiğim her şeyi yapacağım!
Dialogue: 0,0:22:32.24,0:22:34.54,Main,,0,0,0,,Çok fazla şey istiyorsun!
Dialogue: 0,0:22:35.79,0:22:38.71,Main,,0,0,0,,Deminki patlamayı hissettin mi?
Dialogue: 0,0:22:38.71,0:22:42.75,Main,,0,0,0,,Muhtemelen ısınma saldırısı yapan\NDenizci Karargâhı'nın savaş gemileriydi.
Dialogue: 0,0:22:42.75,0:22:46.26,Main,,0,0,0,,Dakikalar sonra tam saldırı başlayacak.
Dialogue: 0,0:22:46.26,0:22:50.39,Main,,0,0,0,,Adalet Kulesi'ndeki arkadaşların ölecek.
Dialogue: 0,0:22:50.39,0:22:56.85,Main,,0,0,0,,Bir ihtimal yeraltı tünelinden bize\Nulaşmak için koşan birileri varsa...
Dialogue: 0,0:22:58.27,0:22:58.98,Main,,0,0,0,,{\fad(150,150)}Bacak Fırtınası!
Dialogue: 0,0:23:07.40,0:23:08.49,Main,,0,0,0,,Ne?
Dialogue: 0,0:23:18.41,0:23:21.88,Main,,0,0,0,,Deniz suyu, tüneli dolduracak...
Dialogue: 0,0:23:21.88,0:23:24.38,Main,,0,0,0,,...ve orada olanları boğacak.
Dialogue: 0,0:23:39.00,0:23:39.86,Main,,0,0,0,,Sen...
Dialogue: 0,0:23:40.52,0:23:44.02,Main,,0,0,0,,Senin için hiçbir şey yolunda\Ngitmeyecek, Hasır Şapka.
Dialogue: 0,0:23:44.44,0:23:49.56,Main,,0,0,0,,Herkesi kurtarmak ve güvenle kaçmak\Ngibi aptalca bir umuda ulaşmak için...
Dialogue: 0,0:23:49.56,0:23:51.03,Main,,0,0,0,,...ne kadar ileri gideceğini görelim.
Dialogue: 0,0:23:51.03,0:23:53.41,Main,,0,0,0,,Ne yapıyorsun, seni pislik?!
Dialogue: 0,0:24:10.09,0:24:13.05,Main,,0,0,0,,Kokoro-san! Chimney! Gonbe!
Dialogue: 0,0:24:13.47,0:24:15.47,Main,,0,0,0,,Yönler için sağolun!
Dialogue: 0,0:24:17.01,0:24:19.18,Main,,0,0,0,,Korsan abla!
Dialogue: 0,0:24:21.73,0:24:23.44,Main,,0,0,0,,Demin büyük bir sarsıntı oldu.
Dialogue: 0,0:24:25.19,0:24:27.40,Main,,0,0,0,,Sonunda başlamış gibiler.
Dialogue: 0,0:24:27.40,0:24:29.53,Main,,0,0,0,,Saldırı, saldırı!
Dialogue: 0,0:24:52.76,0:24:54.13,Main,,0,0,0,,Çabuk!
Dialogue: 0,0:24:54.13,0:24:57.43,Main,,0,0,0,,Nico Robin'i yakalayın ve gemiye bindirin!
Dialogue: 0,0:24:57.43,0:24:59.47,Main,,0,0,0,,Zamanımız tükeniyor!\NSavaş gemileri geliyor!
Dialogue: 0,0:24:59.89,0:25:02.10,Main,,0,0,0,,Çok geç kaldık.
Dialogue: 0,0:25:02.10,0:25:03.48,Main,,0,0,0,,Ne dedin?!
Dialogue: 0,0:25:08.31,0:25:09.98,Main,,0,0,0,,Sisin içinde!
Dialogue: 0,0:25:09.98,0:25:11.69,Main,,0,0,0,,Orada bir şey var!
Dialogue: 0,0:25:12.28,0:25:15.49,Main,,0,0,0,,Hey, beyler! Kaçmayın!
Dialogue: 0,0:25:21.79,0:25:23.54,Main,,0,0,0,,Olamaz!
Dialogue: 0,0:25:27.08,0:25:28.38,Main,,0,0,0,,Şuna bakın!
Dialogue: 0,0:25:28.38,0:25:31.17,Main,,0,0,0,,Geldiler! Nihayet geldiler!
Dialogue: 0,0:26:18.68,0:26:21.05,Main,,0,0,0,,Bir savaş gemisi filosu.
Dialogue: 0,0:26:21.05,0:26:24.14,Main,,0,0,0,,Yıkım Çağrısı başladı!
Dialogue: 0,0:12:25.00,0:12:28.68,Main,,0,0,0,,{\an8}♪ Keskin nişancılar adasında... ♪
Dialogue: 0,0:12:29.04,0:12:31.23,Main,,0,0,0,,{\an8}♪ ...doğdum. ♪
Dialogue: 0,0:12:38.02,0:12:40.98,Main,,0,0,0,,{\an8}♪ Ya da kalbini... ♪
Dialogue: 0,0:12:41.65,0:12:45.20,Main,,0,0,0,,{\an8}♪ ...kilitle!! ♪
Dialogue: 0,0:17:44.33,0:17:57.80,Captions,,0,0,0,,{\an8}"Adalet"
