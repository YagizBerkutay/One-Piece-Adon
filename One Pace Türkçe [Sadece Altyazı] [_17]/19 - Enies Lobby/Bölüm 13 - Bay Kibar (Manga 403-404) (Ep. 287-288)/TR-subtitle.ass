Dialogue: 0,0:00:06.41,0:00:07.83,Main,,0,0,0,,Nico Robin'i arıyorsan,...
Dialogue: 0,0:00:08.73,0:00:13.78,Main,,0,0,0,,...biz konuşurken \NAdalet Kapıları'na gittikçe yaklaşıyor.
Dialogue: 0,0:00:13.78,0:00:18.99,Main,,0,0,0,,Ama sanırım cehenneme yaklaştığını söylemeliyiz.
Dialogue: 0,0:00:18.99,0:00:21.23,Main,,0,0,0,,Bunu zaten biliyorum.
Dialogue: 0,0:00:21.23,0:00:24.97,Main,,0,0,0,,Doğru, Robin-chan'ın hayatı söz konusu.
Dialogue: 0,0:00:24.97,0:00:28.75,Main,,0,0,0,,Bana engel olursan, kadın bile olsan geri durmam!
Dialogue: 0,0:00:28.75,0:00:32.72,Main,,0,0,0,,Yaralanmadan önce anahtarını ver!
Dialogue: 0,0:00:34.83,0:00:38.18,Main,,0,0,0,,Bağırmak seni anahtara ulaştırmaz.
Dialogue: 0,0:00:38.61,0:00:41.89,Main,,0,0,0,,Beni kadın olarak düşünmek zorunda değilsin.
Dialogue: 0,0:00:42.36,0:00:45.31,Main,,0,0,0,,Kolay bir dünyada yaşamadım.
Dialogue: 0,0:00:45.93,0:00:48.57,Main,,0,0,0,,Yok etme emri olduğu sürece,...
Dialogue: 0,0:00:48.57,0:00:51.82,Main,,0,0,0,,...tüm yapmam gereken canını almak.
Dialogue: 0,0:00:58.74,0:01:00.96,Main,,0,0,0,,Sana canımı vermiyorum.
Dialogue: 0,0:01:00.96,0:01:03.30,Main,,0,0,0,,İstediğim şey,...
Dialogue: 0,0:01:03.30,0:01:06.17,Main,,0,0,0,,...Robin-chan'ın kelepçesinin anahtarı.
Dialogue: 0,0:01:06.17,0:01:09.46,Main,,0,0,0,,O zaman çay saati bitse olur mu?
Dialogue: 0,0:01:09.65,0:01:10.68,Main,,0,0,0,,Kazı!{\fad(150,150)}
Dialogue: 0,0:01:16.74,0:01:19.14,Main,,0,0,0,,Gücün gerçekten süper insan gücü.
Dialogue: 0,0:01:26.84,0:01:27.52,Main,,0,0,0,,Açık verdin!
Dialogue: 0,0:01:33.01,0:01:35.03,Main,,0,0,0,,İlk vuruşu yaptım.
Dialogue: 0,0:01:46.28,0:01:48.58,Main,,0,0,0,,Sen nasıl böyle bir şey yapabilirsin?
Dialogue: 0,0:01:48.96,0:01:52.29,Main,,0,0,0,,Kasıtsız orgazm dedikleri\Nbu olsa gerek, öyle değil mi?
Dialogue: 0,0:01:53.32,0:01:56.01,Main,,0,0,0,,Seni lanet olası velet!
Dialogue: 0,0:01:56.38,0:01:57.13,Main,,0,0,0,,Ay Yürüyüşü!{\fad(150,150)}
Dialogue: 0,0:02:23.56,0:02:24.70,Thoughts,,0,0,0,,Çok hızlı!
Dialogue: 0,0:02:25.52,0:02:27.75,Main,,0,0,0,,Seni yere yapıştırdım.
Dialogue: 0,0:02:28.14,0:02:30.11,Main,,0,0,0,,Çoktan kaybettin!
Dialogue: 0,0:02:30.11,0:02:31.65,Main,,0,0,0,,Şimdi anahtarı...
Dialogue: 0,0:02:31.65,0:02:32.59,Main,,0,0,0,,Parmak Tabanca!{\fad(150,150)}
Dialogue: 0,0:02:36.74,0:02:37.80,Main,,0,0,0,,Bacak Fırtınası!{\fad(150,150)}
Dialogue: 0,0:02:43.50,0:02:45.47,Main,,0,0,0,,Ne sıkıcı bir adam.
Dialogue: 0,0:02:46.00,0:02:48.27,Main,,0,0,0,,Yine de kendine korsan diyorsun.
Dialogue: 0,0:02:48.27,0:02:50.30,Main,,0,0,0,,Ne kadar karaktersizsin.
Dialogue: 0,0:02:50.30,0:02:52.31,Main,,0,0,0,,Hey! Kapa çeneni!
Dialogue: 0,0:02:52.98,0:02:54.90,Main,,0,0,0,,Bana anahtarı ver!
Dialogue: 0,0:02:56.85,0:03:00.65,Main,,0,0,0,,Aşikâr tehditlerinden bıktım artık.
Dialogue: 0,0:03:04.59,0:03:07.33,Main,,0,0,0,,Eğlenceli bir şey yapmamı ister misin?
Dialogue: 0,0:03:07.84,0:03:11.64,Main,,0,0,0,,Saldırmazsan, hayatta kalamayacaksın.
Dialogue: 0,0:05:01.23,0:05:05.65,Title,,0,0,250,,Bay Kibar{\fad(500,0)}
Dialogue: 0,0:05:07.19,0:05:08.91,Thoughts,,0,0,0,,Peşimden gelmiyor.
Dialogue: 0,0:05:08.91,0:05:12.75,Captions,,860,0,365,,1.Kat - Karşılama Alanı\NNami, Kumadori'ye karşı{\fad(500,0)}
Dialogue: 0,0:05:12.75,0:05:15.00,Thoughts,,0,0,0,,Hele şükür.
Dialogue: 0,0:05:15.00,0:05:19.13,Thoughts,,0,0,0,,Bir daha beni yakalasaydı kesin ölmüştüm.
Dialogue: 0,0:05:19.13,0:05:21.21,Thoughts,,0,0,0,,Kaçmam lazım.
Dialogue: 0,0:05:21.21,0:05:22.92,Main,,0,0,0,,Hayatın Dönüşü!{\fad(150,150)}
Dialogue: 0,0:05:25.53,0:05:29.26,Main,,0,0,0,,Yoyoi! Yoi! Yoi! Yoyoi!
Dialogue: 0,0:05:30.54,0:05:31.51,Main,,0,0,0,,Kahretsin!
Dialogue: 0,0:05:31.51,0:05:36.23,Main,,0,0,0,,Şimdi, şimdi! Seni...
Dialogue: 0,0:05:36.23,0:05:39.30,Main,,0,0,0,,...vurayım mı...
Dialogue: 0,0:05:39.30,0:05:42.69,Main,,0,0,0,,...yoksa ölümüne boğayım mı?
Dialogue: 0,0:05:42.69,0:05:46.77,Main,,0,0,0,,Bu doğada soğuk bir rüzgar esiyor!
Dialogue: 0,0:05:46.77,0:05:52.49,Main,,0,0,0,,Baharın filizlenmesini\Nbekleyemeyen huzurlu bir ölüm!
Dialogue: 0,0:05:57.49,0:05:59.15,Main,,0,0,0,,En azından bir kez olsun...
Dialogue: 0,0:05:59.15,0:06:03.56,Main,,0,0,0,,...güzel kırmızı çiçeklerin açmasına izin ver!
Dialogue: 0,0:06:03.56,0:06:06.44,Main,,0,0,0,,Onları etrafa saçmak,...
Dialogue: 0,0:06:06.44,0:06:10.37,Main,,0,0,0,,...insan doğasına olan yükümlülüğüm!
Dialogue: 0,0:06:15.60,0:06:20.02,Main,,0,0,0,,Diğer tarafa gittiğinde ölen annemi görünce,...
Dialogue: 0,0:06:20.02,0:06:24.02,Main,,0,0,0,,...iyi olduğumu ve...
Dialogue: 0,0:06:24.02,0:06:28.36,Main,,0,0,0,,...öldürmeye devam ettiğimi...
Dialogue: 0,0:06:28.36,0:06:31.49,Main,,0,0,0,,...bilmesini sağla!
Dialogue: 0,0:06:31.49,0:06:34.20,Main,,0,0,0,,Şimdi, geber!
Dialogue: 0,0:06:34.20,0:06:38.05,Main,,0,0,0,,Şimdi, şimdi, şimdi!
Dialogue: 0,0:06:38.05,0:06:38.87,Main,,0,0,0,,Hayır!
Dialogue: 0,0:06:39.33,0:06:43.30,Main,,0,0,0,,Baharı Hazırlayan Duygu!
Dialogue: 0,0:06:44.70,0:06:47.47,Main,,0,0,0,,Gül Renkli Yarık Toynak!{\fad(150,150)}
Dialogue: 0,0:06:59.21,0:07:00.94,Main,,0,0,0,,Nami! İyi misin?!
Dialogue: 0,0:07:04.01,0:07:05.16,Main,,0,0,0,,Chopper.
Dialogue: 0,0:07:05.16,0:07:07.07,Main,,0,0,0,,Sağol, beni kurtardın.
Dialogue: 0,0:07:07.07,0:07:08.86,Main,,0,0,0,,O neydi öyle?
Dialogue: 0,0:07:08.86,0:07:11.14,Main,,0,0,0,,Şeytan Meyvesi mi yemiş?
Dialogue: 0,0:07:11.14,0:07:12.47,Main,,0,0,0,,Bilmiyorum.
Dialogue: 0,0:07:12.47,0:07:16.33,Main,,0,0,0,,Saçı ahtapot gibi hareket ediyor.\NHiç bir şey yapamadım.
Dialogue: 0,0:07:17.05,0:07:19.57,Main,,0,0,0,,Neyse, şimdi fırsatımız var, Chopper.
Dialogue: 0,0:07:19.57,0:07:21.17,Main,,0,0,0,,Hemen gidelim buradan.
Dialogue: 0,0:07:21.58,0:07:22.59,Main,,0,0,0,,Niye?
Dialogue: 0,0:07:22.59,0:07:24.65,Main,,0,0,0,,Onu yenmezsek anahtarı...
Dialogue: 0,0:07:24.65,0:07:25.88,Main,,0,0,0,,Bu anahtar mı?
Dialogue: 0,0:07:29.84,0:07:33.58,Main,,0,0,0,,O farketmeden anahtarı çaldım ama kaçamadım.
Dialogue: 0,0:07:33.58,0:07:35.38,Main,,0,0,0,,Diğerlerinin durumunu biliyor musun?
Dialogue: 0,0:07:35.38,0:07:36.33,Main,,0,0,0,,Hey, Nami.
Dialogue: 0,0:07:36.33,0:07:37.81,Main,,0,0,0,,O anahtarın numarası kaç?
Dialogue: 0,0:07:38.17,0:07:39.50,Main,,0,0,0,,Numarası mı?
Dialogue: 0,0:07:39.50,0:07:40.75,Main,,0,0,0,,Üç.
Dialogue: 0,0:07:40.75,0:07:41.73,Main,,0,0,0,,O değil.
Dialogue: 0,0:07:41.73,0:07:43.52,Main,,0,0,0,,Bu numara neyin nesi?
Dialogue: 0,0:07:48.45,0:07:49.74,Main,,0,0,0,,Bir şey düştü.
Dialogue: 0,0:07:51.14,0:07:53.78,Main,,0,0,0,,Bu oyuncak bebek mi?
Dialogue: 0,0:07:53.78,0:07:55.20,Main,,0,0,0,,Değil.
Dialogue: 0,0:07:56.59,0:07:57.91,Main,,0,0,0,,Sanji?!
Dialogue: 0,0:07:58.68,0:08:00.40,Main,,0,0,0,,Niye böyle görünüyor?
Dialogue: 0,0:08:00.91,0:08:02.42,Main,,0,0,0,,Sanji!
Dialogue: 0,0:08:02.42,0:08:03.89,Main,,0,0,0,,Hey, ne oldu?!
Dialogue: 0,0:08:03.89,0:08:06.00,Main,,0,0,0,,Niye vücudun böyle?
Dialogue: 0,0:08:06.00,0:08:07.71,Main,,0,0,0,,İyi misin, Sanji-kun?!
Dialogue: 0,0:08:12.25,0:08:13.38,Main,,0,0,0,,Sanji!
Dialogue: 0,0:08:17.58,0:08:20.13,Main,,0,0,0,,Üzgünüm. Yenildim.
Dialogue: 0,0:08:21.04,0:08:23.84,Main,,0,0,0,,Anahtarı alamadım.
Dialogue: 0,0:08:23.84,0:08:27.78,Main,,0,0,0,,Dur, Sanji. Seni hemen iyileştireceğim!
Dialogue: 0,0:08:27.78,0:08:31.32,Thoughts,,0,0,0,,Sanji-kun'un yenileceğini hiç düşünmemiştim.
Dialogue: 0,0:08:41.26,0:08:42.83,Main,,0,0,0,,Sanji-kun.
Dialogue: 0,0:08:42.83,0:08:45.54,Main,,0,0,0,,Gerçekten kazanamadın mı?
Dialogue: 0,0:08:45.54,0:08:48.04,Main,,0,0,0,,Gerçekten düzgünce dövüştün mü?
Dialogue: 0,0:08:48.81,0:08:51.08,Main,,0,0,0,,Rakibin o kadındı, değil mi?
Dialogue: 0,0:08:51.08,0:08:53.55,Main,,0,0,0,,Kadınlara karşı yumuşaksın, değil mi?
Dialogue: 0,0:08:54.53,0:08:57.32,Main,,0,0,0,,Anahtar konusunda üzgünüm.
Dialogue: 0,0:08:57.32,0:08:58.53,Main,,0,0,0,,Mesele bu değil!
Dialogue: 0,0:08:58.53,0:09:03.23,Main,,0,0,0,,Aptalca kibarlık anlayışın yüzünden\Nölebilirdin diyorum!
Dialogue: 0,0:09:03.66,0:09:06.16,Main,,0,0,0,,Bu hale gelmiş olmana rağmen,\Nyine de bundan gurur duyacak mısın?
Dialogue: 0,0:09:06.16,0:09:07.94,Main,,0,0,0,,Ölürsen ne olacak?!
Dialogue: 0,0:09:08.53,0:09:10.74,Main,,0,0,0,,Ölmek...
Dialogue: 0,0:09:10.74,0:09:12.94,Main,,0,0,0,,...istediğimden değil.
Dialogue: 0,0:09:12.94,0:09:18.13,Main,,0,0,0,,Ama asla bir kadına vurmayacak şekilde büyütüldüm.
Dialogue: 0,0:09:18.13,0:09:19.78,Main,,0,0,0,,Bu yüzden,...
Dialogue: 0,0:09:20.69,0:09:25.24,Main,,0,0,0,,...ölsem bile asla bir kadını tekmelemem!
Dialogue: 0,0:09:30.06,0:09:31.63,Main,,0,0,0,,Çok aptalsın.
Dialogue: 0,0:09:31.63,0:09:32.59,Main,,0,0,0,,Aptal!
Dialogue: 0,0:09:33.06,0:09:35.54,Main,,0,0,0,,Hey! Ne yapıyorsun, Nami?!
Dialogue: 0,0:09:35.54,0:09:38.24,Main,,0,0,0,,Kaçmak da kibarlık anlayışına aykırıysa,...
Dialogue: 0,0:09:38.24,0:09:40.64,Main,,0,0,0,,...en azından onu bir kenara at!
Dialogue: 0,0:09:40.64,0:09:44.08,Main,,0,0,0,,Sebepsiz yere ölmek ise ayrı bir konu!
Dialogue: 0,0:09:44.95,0:09:47.89,Main,,0,0,0,,O kadını bana bırak.
Dialogue: 0,0:09:48.87,0:09:50.17,Main,,0,0,0,,Ayrıca...
Dialogue: 0,0:09:50.79,0:09:53.90,Main,,0,0,0,,...kibarlık anlayışın konusundaki\Nfikrimi değiştirdim.
Dialogue: 0,0:09:53.90,0:09:54.81,Main,,0,0,0,,Ne?!
Dialogue: 0,0:09:54.81,0:09:57.00,Main,,0,0,0,,Beni daha çok sevdiğini mi söyledin?
Dialogue: 0,0:09:57.00,0:09:58.57,Main,,0,0,0,,Öyle demedi!
Dialogue: 0,0:10:04.60,0:10:07.83,Main,,0,0,0,,Ben bu adam kadar nazik biri değilim.
Dialogue: 0,0:10:08.23,0:10:09.57,Main,,0,0,0,,Ben de öyle.
Dialogue: 0,0:10:09.57,0:10:12.04,Main,,0,0,0,,İyi anlaşacak gibiyiz.
Dialogue: 0,0:10:27.42,0:10:30.26,Main,,0,0,0,,Bekle!
Dialogue: 0,0:10:30.26,0:10:31.27,Main,,0,0,0,,Ahtapot adam!
Dialogue: 0,0:10:31.27,0:10:32.72,Main,,0,0,0,,Kaçmana...
Dialogue: 0,0:10:32.72,0:10:38.54,Main,,0,0,0,,Kaçmana izin vermeyeceğim!
Dialogue: 0,0:10:38.54,0:10:39.96,Main,,0,0,0,,Nami, o kadını hakla.
Dialogue: 0,0:10:39.96,0:10:41.70,Main,,0,0,0,,Bu adamla ben ilgilenirim!
Dialogue: 0,0:10:42.70,0:10:44.05,Main,,0,0,0,,Tamam!
Dialogue: 0,0:10:47.01,0:10:49.34,Main,,0,0,0,,Yoluma çıkmana izin vermeyeceğim!
Dialogue: 0,0:10:49.34,0:10:50.44,Main,,0,0,0,,Çapraz...{\fad(150,150)}
Dialogue: 0,0:10:51.71,0:10:52.40,Main,,0,0,0,,...Yarık Toynak!{\fad(150,150)}
Dialogue: 0,0:11:03.68,0:11:06.31,Main,,0,0,0,,Vay canına! Korsan abi!
Dialogue: 0,0:11:06.31,0:11:08.11,Main,,0,0,0,,Ne yapıyorsun?!
Dialogue: 0,0:11:18.10,0:11:22.12,Main,,0,0,0,,Üff! Öyle bir kayıkla okyanusu\Ngeçebilmen mümkün değil!
Dialogue: 0,0:11:22.12,0:11:23.62,Main,,0,0,0,,Aptal falan mısın sen?!
Dialogue: 0,0:11:24.49,0:11:28.67,Main,,0,0,0,,Ama sen...\NRobin o kapıya götürüldü!
Dialogue: 0,0:11:28.67,0:11:33.33,Main,,0,0,0,,Acele etmeliyim yoksa onu geri getiremeyeceğim!
Dialogue: 0,0:11:35.25,0:11:36.67,Main,,0,0,0,,Bekle, korsan abi!
Dialogue: 0,0:11:36.67,0:11:38.17,Main,,0,0,0,,Sakin ol!
Dialogue: 0,0:11:38.17,0:11:44.16,Main,,0,0,0,,Sana Adalet Kapıları'na ulaşmanın\Nbir yolunu söylemeye geldik!
Dialogue: 0,0:11:44.16,0:11:44.85,Main,,0,0,0,,Ne?
Dialogue: 0,0:11:47.37,0:11:49.18,Main,,0,0,0,,Gerçekten müthişsin, biliyor musun?
Dialogue: 0,0:11:49.18,0:11:51.18,Main,,0,0,0,,Bunu nasıl öğrendin?
Dialogue: 0,0:11:52.31,0:11:57.32,Main,,0,0,0,,Demin Lucci'yle birlikte o adam,\Nyüksek sesle gülerek buradan geçti.
Dialogue: 0,0:11:57.32,0:11:59.45,Main,,0,0,0,,Biz de peşlerinden gittik!
Dialogue: 0,0:11:59.45,0:12:06.66,Note,,0,0,30,,{\c&H00FCFF&}{\pos(570,450)\an5}Lucci'yle Olan Adam
Dialogue: 0,0:12:02.26,0:12:05.30,Main,,0,0,0,,Girişi bilmezlerse peşimizden gelmeleri mümkün değil!
Dialogue: 0,0:12:05.30,0:12:06.66,Main,,0,0,0,,Ahmaklar!
Dialogue: 0,0:12:06.66,0:12:10.62,Main,,0,0,0,,Lucci ve siyah saçlı abla da kapılardan geçti.
Dialogue: 0,0:12:24.77,0:12:26.39,Main,,0,0,0,,Bu kapı, değil mi?
Dialogue: 0,0:12:30.81,0:12:33.45,Main,,0,0,0,,Epey sert bir çelik kapı.
Dialogue: 0,0:12:33.45,0:12:36.00,Main,,0,0,0,,Nasıl açılacağını biliyor musun?
Dialogue: 0,0:12:36.00,0:12:39.09,Main,,0,0,0,,Lucci'yle olan adam burada bir şeylere dokunuyordu.
Dialogue: 0,0:12:39.09,0:12:42.19,Main,,0,0,0,,Şuradaki anahtar deliğiyle çalışıyor olmalı!
Dialogue: 0,0:12:42.87,0:12:44.82,Main,,0,0,0,,Ama anahtar yok.
Dialogue: 0,0:12:51.92,0:12:53.96,Main,,0,0,0,,Siz geride durun.
Dialogue: 0,0:12:53.96,0:12:56.18,Main,,0,0,0,,Ha? Ne yapacaksın?
Dialogue: 0,0:12:58.50,0:13:01.34,Main,,0,0,0,,Buradan Adalet Kapıları'na ulaşabilirim, değil mi?
Dialogue: 0,0:13:01.74,0:13:03.76,Main,,0,0,0,,Şey... evet.
Dialogue: 0,0:13:07.64,0:13:09.47,Main,,0,0,0,,Üçüncü Düzen!{\fad(150,150)}
Dialogue: 0,0:13:39.26,0:13:40.54,Main,,0,0,0,,Açıldı.
Dialogue: 0,0:13:40.54,0:13:42.25,Main,,0,0,0,,Tamam! Gidiyorum o zaman!
Dialogue: 0,0:13:43.01,0:13:45.72,Main,,0,0,0,,Niye bu kadar küçük oldun?!
Dialogue: 0,0:14:00.66,0:14:03.36,Main,,0,0,0,,Çok eğlencelisin, korsan abi!
Dialogue: 0,0:14:03.76,0:14:06.50,Main,,0,0,0,,Demin acayip bir gürültü olmadı mı?
Dialogue: 0,0:14:06.50,0:14:07.57,Main,,0,0,0,,Yoksa bana mı öyle geldi?
Dialogue: 0,0:14:07.57,0:14:09.28,Main,,0,0,0,,Hayır, bu olamaz.
Dialogue: 0,0:14:10.05,0:14:13.34,Main,,0,0,0,,Belki de kapıyı yok eden\Nkorsanlardan birinin sesiydi.
Dialogue: 0,0:14:13.34,0:14:15.75,Main,,0,0,0,,Ne?! Bu kadar aptalca bir şey nasıl olabilir?!
Dialogue: 0,0:14:15.75,0:14:18.35,Main,,0,0,0,,O kalın, çelik kapıyı mı kastediyorsun?
Dialogue: 0,0:14:18.35,0:14:22.17,Main,,0,0,0,,Her şey bir yana, onu bulmuş olmaları imkansız.
Dialogue: 0,0:14:22.17,0:14:27.30,Main,,0,0,0,,Hayır, biliyor olmalılar.\NBir çocuk ve hayvanı peşimizden geliyordu.
Dialogue: 0,0:14:27.30,0:14:28.52,Main,,0,0,0,,Ne?!
Dialogue: 0,0:14:28.52,0:14:31.74,Main,,0,0,0,,B-Bilmene rağmen niye onları durdurmadın?!
Dialogue: 0,0:14:33.04,0:14:34.56,Main,,0,0,0,,Öyle yapmam için...
Dialogue: 0,0:14:35.12,0:14:36.81,Main,,0,0,0,,...emir verilmedi.
Dialogue: 0,0:14:36.81,0:14:38.98,Main,,0,0,0,,Ne diyorsun, seni aptal?!
Dialogue: 0,0:14:39.41,0:14:41.90,Main,,0,0,0,,Öyle bir şeye kendi başına\Nkarar verebilmen gerekir!
Dialogue: 0,0:14:41.90,0:14:44.73,Main,,0,0,0,,Onları bırakırsak ne olabileceğini bilmiyor musun?
Dialogue: 0,0:14:44.73,0:14:46.32,Main,,0,0,0,,Ne oldu? Hey?!
Dialogue: 0,0:14:46.32,0:14:48.45,Main,,0,0,0,,Yani buraya biri mi geliyor?
Dialogue: 0,0:14:56.31,0:14:58.50,Main,,0,0,0,,Tamam! Normale döndüm!
Dialogue: 0,0:15:01.11,0:15:03.46,Main,,0,0,0,,Bekle, Robin!
Dialogue: 0,0:15:06.47,0:15:10.18,Main,,0,0,0,,Güvercinli pislik!\NKesinlikle canına okuyacağım!
Dialogue: 0,0:15:10.43,0:15:16.60,Captions,,0,900,360,,Kiler Koridoru\NFranky, Fukuro'ya karşı{\fad(500,0)}
Dialogue: 0,0:15:11.13,0:15:15.86,Thoughts,,0,0,0,,Kahretsin, bir an önce kolamı doldurmalıyım.
Dialogue: 0,0:15:16.60,0:15:21.44,Thoughts,,0,0,0,,Bu kadar büyük bir bedene sahip olan biri için, \Netrafta zıplamayı kesinlikle seviyor.
Dialogue: 0,0:15:24.78,0:15:27.57,Main,,0,0,0,,Chapapa. Buradayım.
Dialogue: 0,0:15:29.91,0:15:34.08,Main,,0,0,0,,- Kaçmakta hızlı gibisin.\N- Chapapa.
Dialogue: 0,0:15:34.08,0:15:38.79,Main,,0,0,0,,O kadar gurur duyduğun şu yumruklarından\Nbirini bile yemek zorunda değilim.
Dialogue: 0,0:15:38.79,0:15:41.46,Main,,0,0,0,,Franky Üçgen Kaldırıcı!{\fad(150,150)}
Dialogue: 0,0:15:47.00,0:15:48.34,Main,,0,0,0,,Aptal favorilerine...
Dialogue: 0,0:15:49.31,0:15:50.72,Main,,0,0,0,,...kanmayacağım!
Dialogue: 0,0:15:51.83,0:15:52.54,Main,,0,0,0,,Lanet olası!
Dialogue: 0,0:15:55.39,0:15:57.81,Main,,0,0,0,,Sol Silahlar!{\fad(150,150)}
Dialogue: 0,0:16:03.24,0:16:05.26,Main,,0,0,0,,Kahretsin, kolam neredeyse bitti.
Dialogue: 0,0:16:05.26,0:16:06.99,Main,,0,0,0,,Hemen mutfağa gitmeliyim!
Dialogue: 0,0:16:06.99,0:16:08.32,Main,,0,0,0,,Dur, seni pislik!
Dialogue: 0,0:16:08.78,0:16:11.32,Main,,0,0,0,,Lanet olsun, kurtulmuşsun!
Dialogue: 0,0:16:11.32,0:16:13.53,Main,,0,0,0,,Kesinlikle birinci sınıf bir korkaksın!
Dialogue: 0,0:16:13.83,0:16:15.04,Main,,0,0,0,,Chapa.
Dialogue: 0,0:16:15.45,0:16:16.41,Main,,0,0,0,,Ne dedin?!
Dialogue: 0,0:16:18.87,0:16:20.95,Main,,0,0,0,,Ne oldu, korkak?
Dialogue: 0,0:16:20.95,0:16:22.83,Main,,0,0,0,,Bu kez kaçmıyor musun?
Dialogue: 0,0:16:22.83,0:16:25.40,Main,,0,0,0,,Seni pislik!
Dialogue: 0,0:16:25.40,0:16:28.30,Main,,0,0,0,,O sözlerle beni sinirlendirdin!
Dialogue: 0,0:16:29.55,0:16:31.84,Main,,0,0,0,,Öldürücü vuruşumu karşılamayı dene!
Dialogue: 0,0:16:31.84,0:16:35.18,Main,,0,0,0,,Parmak Tabanca'dan daha hızlı ve \Naşırı derecede ağır bir yumruk!
Dialogue: 0,0:16:35.18,0:16:36.33,Main,,0,0,0,,Sert Hayvan!{\fad(150,150)}
Dialogue: 0,0:16:40.07,0:16:42.18,Main,,0,0,0,,Chapapa.
Dialogue: 0,0:16:43.74,0:16:46.55,Main,,0,0,0,,Öyle küçük bir yumruk işe yaramaz.
Dialogue: 0,0:16:47.95,0:16:49.19,Main,,0,0,0,,Güçlü...{\fad(150,150)}
Dialogue: 0,0:16:49.61,0:16:50.63,Main,,0,0,0,,Demir Parça!{\fad(150,150)}
Dialogue: 0,0:16:50.63,0:16:52.27,Main,,0,0,0,,...Çekiç!{\fad(150,150)}
Dialogue: 0,0:16:57.56,0:17:00.99,Main,,0,0,0,,Güçsüz bir yumruğun var.
Dialogue: 0,0:17:00.99,0:17:02.66,Main,,0,0,0,,Sert Hayvan!{\fad(150,150)}
Dialogue: 0,0:17:18.15,0:17:21.55,Main,,0,0,0,,Seninki gevşek bir yumruk.
Dialogue: 0,0:17:22.91,0:17:23.88,Main,,0,0,0,,Hayır.
Dialogue: 0,0:17:23.88,0:17:26.99,Main,,0,0,0,,Asıl seninki yumuşak bir yumruk.
Dialogue: 0,0:17:26.99,0:17:29.69,Main,,0,0,0,,O zaman seninki kağıt gibi bir yumruk.
Dialogue: 0,0:17:29.69,0:17:33.03,Main,,0,0,0,,Seninki sadece norakura külotu.
Dialogue: 0,0:17:34.54,0:17:36.07,Main,,0,0,0,,Külot mu?
Dialogue: 0,0:17:36.07,0:17:37.90,Main,,0,0,0,,O yumruk değil!
Dialogue: 0,0:17:37.90,0:17:39.94,Main,,0,0,0,,Sen sadece külotsun!
Dialogue: 0,0:17:39.94,0:17:41.90,Main,,0,0,0,,Seni aptal sütyen!
Dialogue: 0,0:17:41.90,0:17:43.86,Main,,0,0,0,,Kapa çeneni, seni çorap!
Dialogue: 0,0:17:43.86,0:17:44.73,Main,,0,0,0,,Paçalı don!
Dialogue: 0,0:17:44.73,0:17:45.62,Main,,0,0,0,,Bol şort!
Dialogue: 0,0:17:45.62,0:17:46.67,Main,,0,0,0,,*Fundoshi!
Dialogue: 0,0:17:46.67,0:17:48.63,Main,,0,0,0,,Chapapapa!
Dialogue: 0,0:17:57.42,0:17:58.88,Main,,0,0,0,,Çekil, seni pislik!
Dialogue: 0,0:17:58.88,0:18:00.55,Main,,0,0,0,,Kapa çeneni, kurbağa ağızlı!
Dialogue: 0,0:18:01.04,0:18:02.27,Main,,0,0,0,,Harika!
Dialogue: 0,0:18:02.27,0:18:04.16,Main,,0,0,0,,Mutfaktayım!
Dialogue: 0,0:18:05.23,0:18:08.62,Main,,0,0,0,,Koca bir buzdolapları var!
Dialogue: 0,0:18:14.02,0:18:15.37,Main,,0,0,0,,O...
Dialogue: 0,0:18:15.37,0:18:17.49,Main,,0,0,0,,Muhtemelen Goril Şeytan Meyvesi yemiş.
Dialogue: 0,0:18:17.49,0:18:19.27,Main,,0,0,0,,Kahretsin.
Dialogue: 0,0:18:19.27,0:18:21.47,Main,,0,0,0,,Üç dakika çoktan doldu.
Dialogue: 0,0:18:21.92,0:18:25.27,Main,,0,0,0,,Gümbürtü Topu'nu çok çabuk kullandım.
Dialogue: 0,0:18:25.27,0:18:26.29,Main,,0,0,0,,Ne yapacağım?
Dialogue: 0,0:18:29.08,0:18:30.17,Main,,0,0,0,,Yoyoi!
Dialogue: 0,0:18:32.79,0:18:35.88,Main,,0,0,0,,Üçüncü dünyadan hayatını çek!
Dialogue: 0,0:18:35.88,0:18:38.76,Main,,0,0,0,,Bu bitirici vuruş!
Dialogue: 0,0:18:39.06,0:18:39.95,Main,,0,0,0,,Yoyo!
Dialogue: 0,0:18:41.05,0:18:42.00,Main,,0,0,0,,Pislik!
Dialogue: 0,0:18:43.74,0:18:45.01,Main,,0,0,0,,Harika, kilidi var!
Dialogue: 0,0:18:46.37,0:18:47.56,Main,,0,0,0,,Chapa! Kumadori!
Dialogue: 0,0:18:49.68,0:18:51.60,Main,,0,0,0,,Evet! Onu kilitledim!
Dialogue: 0,0:18:51.84,0:18:52.92,Main,,0,0,0,,Seni pislik!
Dialogue: 0,0:18:52.92,0:18:54.60,Main,,0,0,0,,Hey! Dur, goril!
Dialogue: 0,0:18:54.60,0:18:56.99,Main,,0,0,0,,O buzdolabında işim var!
Dialogue: 0,0:18:56.99,0:18:59.57,Main,,0,0,0,,Ahh! CP9 ve serseri!
Dialogue: 0,0:18:59.57,0:19:01.84,Main,,0,0,0,,Ben Franky'yim! Dostum!
Dialogue: 0,0:19:01.84,0:19:02.99,Main,,0,0,0,,Goril kimmiş?!
Dialogue: 0,0:19:02.99,0:19:03.74,Main,,0,0,0,,Çok yavaşsın!
Dialogue: 0,0:19:04.49,0:19:05.48,Main,,0,0,0,,Dinle!
Dialogue: 0,0:19:05.48,0:19:09.07,Main,,0,0,0,,Luffy gibi, seni affetmedim.
Dialogue: 0,0:19:09.07,0:19:11.32,Main,,0,0,0,,Usopp'un bizi terketmesinin nedeni...
Dialogue: 0,0:19:13.17,0:19:15.43,Main,,0,0,0,,...sensin!
Dialogue: 0,0:19:15.43,0:19:17.09,Main,,0,0,0,,Usopp'u geri ver!
Dialogue: 0,0:19:17.09,0:19:20.13,Main,,0,0,0,,Ama demin birlikteydiniz.
Dialogue: 0,0:19:20.13,0:19:22.64,Main,,0,0,0,,Unut şimdi bunu!
Dialogue: 0,0:19:22.64,0:19:24.64,Main,,0,0,0,,Nico Robin'i kurtarmak istemiyor musun?!
Dialogue: 0,0:19:24.64,0:19:27.60,Main,,0,0,0,,Kurtarmak istiyorum! Robin!
Dialogue: 0,0:19:27.60,0:19:31.68,Main,,0,0,0,,O zaman dolaptan üç kola al ve bana ver!
Dialogue: 0,0:19:31.68,0:19:33.97,Main,,0,0,0,,Böylece güçlenebilirim!
Dialogue: 0,0:19:33.97,0:19:38.28,Main,,0,0,0,,Bu heriflerin işini anında\Nbitirip anahtarlarını alacağım!
Dialogue: 0,0:19:38.28,0:19:40.69,Main,,0,0,0,,Ne tür bir aptal kolayla güçlenir?
Dialogue: 0,0:19:40.69,0:19:42.45,Main,,0,0,0,,Uğraşma benimle! Ben güçlenirim!
Dialogue: 0,0:19:44.50,0:19:46.18,Main,,0,0,0,,Siz...
Dialogue: 0,0:19:46.18,0:19:49.53,Main,,0,0,0,,...bu komediyi daha ne kadar\Nsürdürmeyi planlıyorsunuz?
Dialogue: 0,0:19:49.53,0:19:52.89,Main,,0,0,0,,Üstelik dövüş sırasında çay mı içmek istiyorsunuz?
Dialogue: 0,0:19:52.89,0:19:54.80,Main,,0,0,0,,Bu terbiyesizlik!
Dialogue: 0,0:19:55.42,0:19:57.19,Main,,0,0,0,,Sert Hayvan Gizli Saldırı!{\fad(150,150)}
Dialogue: 0,0:20:00.29,0:20:01.76,Main,,0,0,0,,Baykuş Cephe Saldırısı!{\fad(150,150)}
Dialogue: 0,0:20:04.89,0:20:06.50,Main,,0,0,0,,Chapapapapapapa!
Dialogue: 0,0:20:08.00,0:20:09.94,Main,,0,0,0,,Sol Mermiler!{\fad(150,150)}
Dialogue: 0,0:20:17.63,0:20:19.76,Main,,0,0,0,,O da ne?!
Dialogue: 0,0:20:23.11,0:20:24.45,Main,,0,0,0,,Ahh! Durum kötü!
Dialogue: 0,0:20:24.45,0:20:26.70,Main,,0,0,0,,Doğru, o artık bizden yana.
Dialogue: 0,0:20:26.70,0:20:27.66,Main,,0,0,0,,Söylediğini yapsam iyi olur.
Dialogue: 0,0:20:30.92,0:20:33.08,Main,,0,0,0,,Bir anlığına açıp kapatırsam, dışarı çıkamaz.
Dialogue: 0,0:20:35.20,0:20:35.91,Main,,0,0,0,,Açık!
Dialogue: 0,0:20:36.12,0:20:36.92,Main,,0,0,0,,Yoyoi!
Dialogue: 0,0:20:37.00,0:20:42.17,Main,,0,0,0,,Kapı açıldı...
Dialogue: 0,0:20:42.66,0:20:43.63,Main,,0,0,0,,İyi!
Dialogue: 0,0:20:43.63,0:20:44.92,Main,,0,0,0,,Franky!
Dialogue: 0,0:20:46.28,0:20:47.72,Main,,0,0,0,,Beni kurtardın!
Dialogue: 0,0:20:54.81,0:20:58.77,Main,,0,0,0,,TAZE!
Dialogue: 0,0:21:00.28,0:21:02.24,Main,,0,0,0,,Ne?
Dialogue: 0,0:21:04.71,0:21:08.03,Main,,0,0,0,,Tazelik en iyisi!\NSebze Yumruğu, hadi!
Dialogue: 0,0:21:08.56,0:21:09.16,Main,,0,0,0,,Sert Hayvan.{\fad(150,150)}
Dialogue: 0,0:21:12.00,0:21:14.33,Main,,0,0,0,,Hey! Bu sebze suyuydu!
Dialogue: 0,0:21:15.61,0:21:17.83,Main,,0,0,0,,Kim tazelik en iyisi der?! Lanet olsun!
Dialogue: 0,0:21:17.83,0:21:19.92,Main,,0,0,0,,Bana kola ver!
Dialogue: 0,0:21:19.92,0:21:21.80,Main,,0,0,0,,Sadece susamamış mıydın?
Dialogue: 0,0:21:23.68,0:21:25.76,Main,,0,0,0,,Yoyoi! Kapı...
Dialogue: 0,0:21:25.76,0:21:26.79,Main,,0,0,0,,Al!
Dialogue: 0,0:21:26.79,0:21:28.01,Main,,0,0,0,,Sağol!
Dialogue: 0,0:21:31.01,0:21:34.98,Main,,0,0,0,,İyi bir kalbin var, değil mi?
Dialogue: 0,0:21:35.56,0:21:37.94,Main,,0,0,0,,Şimdi...
Dialogue: 0,0:21:37.94,0:21:39.69,Main,,0,0,0,,İşte oturuyorum!
Dialogue: 0,0:21:39.69,0:21:42.98,Main,,0,0,0,,Şimdilik tarladaki iş bitti.
Dialogue: 0,0:21:42.98,0:21:46.36,Main,,0,0,0,,Sakinleşelim ve dövüşü bırakalım!
Dialogue: 0,0:21:46.36,0:21:48.49,Main,,0,0,0,,Biraz çay iç!
Dialogue: 0,0:21:48.49,0:21:49.99,Main,,0,0,0,,Çay sana güç verir!
Dialogue: 0,0:21:50.41,0:21:53.45,Main,,0,0,0,,Seni kahrolası sersem!
Dialogue: 0,0:21:54.70,0:21:56.75,Thoughts,,0,0,0,,Çok şaşırtıcı.
Dialogue: 0,0:21:56.98,0:21:57.84,Main,,0,0,0,,Hey!
Dialogue: 0,0:21:57.84,0:22:02.39,Main,,0,0,0,,Başka bir şey içerse ne olur acaba\Nşeklindeki yüz ifadesi de ne öyle, pislik?!
Dialogue: 0,0:22:03.17,0:22:05.45,Main,,0,0,0,,Başka bir şey yok, geyik!
Dialogue: 0,0:22:05.45,0:22:07.55,Main,,0,0,0,,Mesele kendini nasıl hissettiğin değil mi?
Dialogue: 0,0:22:07.55,0:22:08.72,Main,,0,0,0,,Ben sadece kola kullanırım!
Dialogue: 0,0:22:10.77,0:22:13.81,Main,,0,0,0,,Bu kola!\NHiç şüphesiz, bu kola!
Dialogue: 0,0:22:14.18,0:22:15.43,Main,,0,0,0,,Kurtarıcımsın!
Dialogue: 0,0:22:18.18,0:22:22.23,Main,,0,0,0,,Neler oluyor bilmiyorum ama\Nistediğini yapmana izin vermeyeceğim!
Dialogue: 0,0:22:22.23,0:22:23.27,Main,,0,0,0,,Bacak Fırtınası!{\fad(150,150)}
Dialogue: 0,0:22:25.11,0:22:26.24,Main,,0,0,0,,Franky!
Dialogue: 0,0:22:36.70,0:22:40.55,Main,,0,0,0,,SÜPER!
Dialogue: 0,0:23:06.10,0:23:07.36,Main,,0,0,0,,Ne oldu?
Dialogue: 0,0:23:07.36,0:23:09.99,Main,,0,0,0,,Sırf biraz kola içtin diye\Nbir şey değişecek değil ya.
Dialogue: 0,0:23:12.95,0:23:14.53,Main,,0,0,0,,Gardını al.
Dialogue: 0,0:23:15.73,0:23:16.89,Main,,0,0,0,,Chapa! Seni aptal!
Dialogue: 0,0:23:16.89,0:23:19.91,Main,,0,0,0,,Bana güçsüz yumruklarından\Nbiriyle daha mı vuracaksın?
Dialogue: 0,0:23:20.41,0:23:23.67,Main,,0,0,0,,Güçlü Çekiç!{\fad(150,150)}
Dialogue: 0,0:23:41.19,0:23:44.69,Main,,0,0,0,,Vaay! MÜTHİŞ!
Dialogue: 0,0:24:04.05,0:24:05.72,Main,,0,0,0,,Bunun için üzgünüm.
Dialogue: 0,0:24:06.02,0:24:09.07,Main,,0,0,0,,Şu ana dek yumruklarım...
Dialogue: 0,0:24:09.07,0:24:11.55,Main,,0,0,0,,...dediğin gibi gerçekten güçsüzdü.
Dialogue: 0,0:24:11.55,0:24:14.60,Credits,,0,0,0,,Editing:\N Galaxy 9000\N\NTiming:\NGalaxy 9000\N\NQuality Control:\Ndanpmss,\NDolphinWeabu,\NFeeso,\NGalaxy 9000,\NGrug,\NHonoka,\NPepperjack\N\NSoundtracking:\N Halee\N\NGraphics:\N Datenshi\N\NKaraoke:\NKaitouYahiko\N\NTranslation:\NCrunchyroll,\NGaijin\N
Dialogue: 0,0:03:12.14,0:03:14.81,Lyrics,,0,0,0,karaoke,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪
Dialogue: 0,0:03:15.06,0:03:17.90,Lyrics,,0,0,0,karaoke,♪ Bayrağımızı süsleyip, gökyüzüne kaldırarak. ♪
Dialogue: 0,0:03:24.24,0:03:29.49,Lyrics,,0,0,0,karaoke,♪ Sonsuz okyanusu geçip aramaya gidelim. ♪
Dialogue: 0,0:03:30.33,0:03:33.25,Lyrics,,0,0,0,karaoke,♪ Henüz kimse tarafından...
Dialogue: 0,0:03:33.33,0:03:35.33,Lyrics,,0,0,0,karaoke,...bulunmamış bu dünyanın mucizesini. ♪
Dialogue: 0,0:03:36.29,0:03:39.42,Lyrics,,0,0,0,karaoke,♪ Çarpıp duran göğsümüzdeki...
Dialogue: 0,0:03:39.42,0:03:41.21,Lyrics,,0,0,0,karaoke,...aynı hislerle devam etmeliyiz. ♪
Dialogue: 0,0:03:41.21,0:03:47.09,Lyrics,,0,0,0,karaoke,♪ Hayaller peşinde koşanlar tarafından bırakılmış ayak izleri. ♪
Dialogue: 0,0:03:47.93,0:03:50.89,Lyrics,,0,0,0,karaoke,♪ Ne tür bir fırtınalı gece olursa olsun,...
Dialogue: 0,0:03:50.89,0:03:53.85,Lyrics,,0,0,0,karaoke,...kalplerimizin bir olmasını sağlarsak...
Dialogue: 0,0:03:53.85,0:03:58.02,Lyrics,,0,0,0,karaoke,...bu zorluğun üstesinden gelebileceğiz! ♪
Dialogue: 0,0:03:58.15,0:03:59.27,Lyrics,,0,0,0,karaoke,♪ Her zaman ♪
Dialogue: 0,0:04:00.23,0:04:03.07,Lyrics,,0,0,0,karaoke,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪
Dialogue: 0,0:04:03.23,0:04:06.03,Lyrics,,0,0,0,karaoke,♪ Bayrağımızı dalgalandırıp gökyüzüne kaldırarak. ♪
Dialogue: 0,0:04:06.07,0:04:08.57,Lyrics,,0,0,0,karaoke,♪ Kimseye göstermeyeceğiz. ♪
Dialogue: 0,0:04:08.66,0:04:11.99,Lyrics,,0,0,0,karaoke,♪ Gözlerimizde yaşlar olsa bile. ♪
Dialogue: 0,0:04:12.29,0:04:14.95,Lyrics,,0,0,0,karaoke,♪ Peşinden gidelim, peşinden gidelim! ♪
Dialogue: 0,0:04:15.20,0:04:17.96,Lyrics,,0,0,0,karaoke,♪ Hayallerimize giden doğru yolu...
Dialogue: 0,0:04:18.04,0:04:20.63,Lyrics,,0,0,0,karaoke,...gösteren pusulanın. ♪
Dialogue: 0,0:04:20.63,0:04:22.88,Lyrics,,0,0,0,karaoke,♪ Durmayacağız. ♪
Dialogue: 0,0:04:23.20,0:04:26.20,Lyrics,,0,0,0,,♪ Dünyayı dolaşarak...
Dialogue: 0,0:04:26.23,0:04:27.93,Lyrics,,0,0,0,,...yeniden başlayalım! ♪
Dialogue: 0,0:04:30.30,0:04:32.93,Lyrics,,0,0,0,karaoke,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪
Dialogue: 0,0:04:33.26,0:04:35.98,Lyrics,,0,0,0,karaoke,♪ Hedefimize doğru herkesten daha fazla. ♪
Dialogue: 0,0:04:36.10,0:04:38.56,Lyrics,,0,0,0,karaoke,♪ Şimdi kaçmazsak,...
Dialogue: 0,0:04:38.69,0:04:41.98,Lyrics,,0,0,0,karaoke,{\fad(0,30)}...yarını sıkı sıkıya kavrayabileceğiz! ♪
Dialogue: 0,0:04:42.06,0:04:45.07,Lyrics,,0,0,0,karaoke,♪ Peşinden gidelim, peşinden gidelim! ♪
Dialogue: 0,0:04:45.19,0:04:47.99,Lyrics,,0,0,0,karaoke,♪ Gözlerinden yansıtılmış tüm şimdiki zamanın. ♪
Dialogue: 0,0:04:48.07,0:04:50.36,Lyrics,,0,0,0,karaoke,♪ Bembeyaz bir kalp...
Dialogue: 0,0:04:50.66,0:04:52.87,Lyrics,,0,0,0,karaoke,...bana tüm hikayeyi anlatacak! ♪
Dialogue: 0,0:04:53.39,0:04:56.19,Lyrics,,0,0,0,,♪ Dünyayı dolaşarak...
Dialogue: 0,0:04:56.32,0:04:57.82,Lyrics,,0,0,0,,...yeniden başlayalım! ♪
