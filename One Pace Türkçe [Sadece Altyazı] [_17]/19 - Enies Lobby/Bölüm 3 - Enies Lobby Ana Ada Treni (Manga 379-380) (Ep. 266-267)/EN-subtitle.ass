ıAAF,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2,0,2,10,10,10,1Style: Kanji,Duality,65,&H002FıAAF,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2,0,8,10,10,120,1Style: Sign,FOT-Greco Std B,40,&H00000000,&H000000FF,&H00F3F3F4,&H00000000,0,0,0,0,100,100,0,0,1,3,0,2,10,10,10,1Style: Sign2,Baskerville Old Face,45,&H00FFFFFF,&H000000FF,&H00040303,&H00000000,-1,0,0,0,100,100,1.5,0,1,1.3,1,2,10,10,10,1Style: Sign - Map,Roboto,35,&H00000000,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,0,0,5,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextComment: 5,0:00:12.40,0:00:14.47,Main-207+,,0,0,0,,Editing: Galaxy 9000Comment: 5,0:00:14.45,0:00:16.52,Main-207+,,0,0,0,,Quality Assurance: Feeso PepperjackComment: 5,0:00:16.49,0:00:18.56,Main-207+,,0,0,0,,Opening & Attack Effects: KaitouYahikoComment: 5,0:00:18.53,0:00:20.60,Main-207+,,0,0,0,,Timing: HaleeComment: 5,0:00:20.58,0:00:22.65,Main-207+,,0,0,0,,Soundtracking: HaleeComment: 5,0:00:22.62,0:00:24.69,Main-207+,,0,0,0,,Title Card & Infoboxes: DatenshiComment: 0,0:05:55.45,0:05:57.79,Sign,,0,0,1,,GatherineComment: 2,0:05:55.45,0:05:57.79,Sign,,0,0,1,,GatherineDialogue: 1,0:01:55.84,0:02:01.14,Title,,0,0,0,,Express to Enies Lobby, Main IslandDialogue: 2,0:01:55.84,0:02:01.14,Title,,0,0,0,,Express to Enies Lobby, Main IslandDialogue: 5,0:02:07.23,0:02:09.77,Main-207+,,0,0,0,,It's been a while, Chief.Dialogue: 5,0:02:09.77,0:02:12.23,Main-207+,,0,0,0,,Yeah...Dialogue: 5,0:02:12.99,0:02:16.00,Main-207+,,0,0,0,,Cutty Flam, the criminal who is responsibleDialogue: 5,0:02:16.00,0:02:20.99,Main-207+,,0,0,0,,for assaulting government officials in Water 7 eight years ago...Dialogue: 5,0:02:20.99,0:02:24.05,Main-207+,,0,0,0,,Nico Robin, the criminal who was involved in the incidentDialogue: 5,0:02:24.05,0:02:29.00,Main-207+,,0,0,0,,where Navy battleships were attacked  in Ohara in the West Blue...Dialogue: 5,0:02:29.00,0:02:32.06,Main-207+,,0,0,0,,We've completed the escort of these two without a hitch.Dialogue: 5,0:02:32.73,0:02:35.09,Main-207+,,0,0,0,,They're both behind those doors.Dialogue: 5,0:02:35.85,0:02:41.60,Main-207+,,0,0,0,,Welcome back! Lucci, Kaku, Blueno, and Kalifa!Dialogue: 5,0:02:41.60,0:02:42.95,Main-207+,,0,0,0,,That's sexual harassment.Dialogue: 5,0:02:42.95,0:02:44.89,Main-207+,,0,0,0,,Just saying your name is?!Dialogue: 5,0:02:48.82,0:02:51.65,Main-207+,,0,0,0,,Long time no see, Lucci.Dialogue: 5,0:02:51.65,0:02:54.65,Main-207+,,0,0,0,,It appears that your audacity has increased considerably.Dialogue: 5,0:02:55.25,0:02:58.07,Main-207+,,0,0,0,,It appears that your stupidity has as well, Jabra.Dialogue: 5,0:02:58.70,0:03:00.49,Main-207+,,0,0,0,,What'd you say?Dialogue: 5,0:03:01.82,0:03:05.92,Main-207+,,0,0,0,,Stop it, both of you. We just got back.Dialogue: 5,0:03:05.92,0:03:11.92,Main-207+,,0,0,0,,Yoyoi! He's right. Stop it, you two.Dialogue: 5,0:03:12.73,0:03:19.60,Main-207+,,0,0,0,,We have been reunited after five years!Dialogue: 5,0:03:30.65,0:03:32.98,Main-207+,,0,0,0,,Chapapa...Dialogue: 5,0:03:34.47,0:03:36.23,Main-207+,,0,0,0,,Chapa...Dialogue: 5,0:03:36.23,0:03:37.65,Main-207+,,0,0,0,,Cha... pa...Dialogue: 5,0:03:39.47,0:03:41.00,Main-207+,,0,0,0,,Ow...Dialogue: 5,0:03:41.70,0:03:45.24,Main-207+,,0,0,0,,I thought you'd get on it right away, Fukuro.Dialogue: 5,0:03:46.00,0:03:48.66,Main-207+,,0,0,0,,Six Powers Skill: Competition!Dialogue: 5,0:03:49.60,0:03:54.41,Main-207+,,0,0,0,,Suppose an armed guard's strength is power level 10.Dialogue: 3,0:03:52.17,0:03:52.21,Sign,,0,0,0,,Power Level 10Dialogue: 3,0:03:52.21,0:03:52.25,Sign,,0,0,0,,Power Level 10Dialogue: 3,0:03:52.25,0:03:52.29,Sign,,0,0,0,,Power Level 10Dialogue: 3,0:03:52.29,0:03:52.33,Sign,,0,0,0,,Power Level 10Dialogue: 3,0:03:52.33,0:03:52.37,Sign,,0,0,0,,Power Level 10Dialogue: 3,0:03:52.37,0:03:52.42,Sign,,0,0,0,,Power Level 10Dialogue: 3,0:03:52.42,0:03:52.46,Sign,,0,0,0,,Power Level 10Dialogue: 3,0:03:52.46,0:03:52.50,Sign,,0,0,0,,Power Level 10Dialogue: 3,0:03:52.50,0:03:55.29,Sign,,0,0,0,,Power Level 10Dialogue: 3,0:03:55.29,0:03:55.42,Sign,,0,0,0,,Power Level 10Dialogue: 3,0:03:55.42,0:03:55.54,Sign,,0,0,0,,Power Level 10Dialogue: 3,0:03:55.54,0:03:56.17,Sign,,0,0,0,,Power Level 10Dialogue: 2,0:03:52.17,0:03:52.21,Sign,,0,0,0,,m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 2,0:03:52.21,0:03:52.25,Sign,,0,0,0,,m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 2,0:03:52.25,0:03:52.29,Sign,,0,0,0,,m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 2,0:03:52.29,0:03:52.33,Sign,,0,0,0,,m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 2,0:03:52.33,0:03:52.37,Sign,,0,0,0,,m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 2,0:03:52.37,0:03:52.42,Sign,,0,0,0,,m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 2,0:03:52.42,0:03:52.46,Sign,,0,0,0,,m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 2,0:03:52.46,0:03:52.50,Sign,,0,0,0,,m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 2,0:03:52.50,0:03:55.29,Sign,,0,0,0,,m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 2,0:03:55.29,0:03:55.42,Sign,,0,0,0,,m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 2,0:03:55.42,0:03:55.54,Sign,,0,0,0,,m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 2,0:03:55.54,0:03:56.17,Sign,,0,0,0,,m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 1,0:03:52.17,0:03:52.21,Sign,,0,0,0,,m 713 365 l 713 417 999 417 999 365 713 365 m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 1,0:03:52.21,0:03:52.25,Sign,,0,0,0,,m 713 365 l 713 417 999 417 999 365 713 365 m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 1,0:03:52.25,0:03:52.29,Sign,,0,0,0,,m 713 365 l 713 417 999 417 999 365 713 365 m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 1,0:03:52.29,0:03:52.33,Sign,,0,0,0,,m 713 365 l 713 417 999 417 999 365 713 365 m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 1,0:03:52.33,0:03:52.37,Sign,,0,0,0,,m 713 365 l 713 417 999 417 999 365 713 365 m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 1,0:03:52.37,0:03:52.42,Sign,,0,0,0,,m 713 365 l 713 417 999 417 999 365 713 365 m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 1,0:03:52.42,0:03:52.46,Sign,,0,0,0,,m 713 365 l 713 417 999 417 999 365 713 365 m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 1,0:03:52.46,0:03:52.50,Sign,,0,0,0,,m 713 365 l 713 417 999 417 999 365 713 365 m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 1,0:03:52.50,0:03:55.29,Sign,,0,0,0,,m 713 365 l 713 417 999 417 999 365 713 365 m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 1,0:03:55.29,0:03:55.42,Sign,,0,0,0,,m 713 365 l 713 417 999 417 999 365 713 365 m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 1,0:03:55.42,0:03:55.54,Sign,,0,0,0,,m 713 365 l 713 417 999 417 999 365 713 365 m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 1,0:03:55.54,0:03:56.17,Sign,,0,0,0,,m 713 365 l 713 417 999 417 999 365 713 365 m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 5,0:03:54.41,0:03:56.17,Main-207+,,0,0,0,,Your power levels...Dialogue: 5,0:03:56.17,0:04:01.00,Main-207+,,0,0,0,,I'm gonna reveal them. I'm gonna reveal your strength.Dialogue: 5,0:04:01.00,0:04:04.10,Main-207+,,0,0,0,,First, Kalifa. She has a power level of 630.Dialogue: 5,0:04:04.10,0:04:06.85,Main-207+,,0,0,0,,Blueno has a power level of 820.Dialogue: 5,0:04:06.85,0:04:10.10,Main-207+,,0,0,0,,Kaku has a power level of 2,200.Dialogue: 5,0:04:10.10,0:04:12.28,Main-207+,,0,0,0,,Lucci has...Dialogue: 5,0:04:15.02,0:04:17.27,Main-207+,,0,0,0,,a power level of 4,000!Dialogue: 5,0:04:17.27,0:04:20.51,Main-207+,,0,0,0,,4,000?! Hey, did you measure it properly?!Dialogue: 5,0:04:20.51,0:04:22.76,Main-207+,,0,0,0,,I've never heard of such a high power level!Dialogue: 5,0:04:22.76,0:04:24.36,Main-207+,,0,0,0,,It's correct!Dialogue: 5,0:04:24.36,0:04:27.66,Main-207+,,0,0,0,,They've all gotten stronger! Chapapa!Dialogue: 5,0:04:28.43,0:04:33.89,Main-207+,,0,0,0,,Since I measured Jabra and Kumadori's too,  I know who's stronger!Dialogue: 5,0:04:39.67,0:04:41.59,Main-207+,,0,0,0,,Hey! Objection, Fukuro!Dialogue: 5,0:04:42.17,0:04:45.96,Main-207+,,0,0,0,,Setting Lucci aside, what's the deal with  me being weaker than even Kaku?!Dialogue: 5,0:04:45.96,0:04:47.26,Main-207+,,0,0,0,,Chapapa!Dialogue: 5,0:04:47.26,0:04:50.01,Main-207+,,0,0,0,,Kaku has gotten stronger, too!Dialogue: 5,0:04:50.62,0:04:53.74,Main-207+,,0,0,0,,Hey, don't be so sure of yourself, Kaku!Dialogue: 5,0:04:53.74,0:04:56.98,Main-207+,,0,0,0,,"Competition" is a technique that just measures one's martial arts ability.Dialogue: 5,0:04:57.53,0:05:00.81,Main-207+,,0,0,0,,In real battles my devil fruit powers  are added to my abilities.Dialogue: 5,0:05:00.81,0:05:03.58,Main-207+,,0,0,0,,Just don't forget that you can't defeat me.Dialogue: 5,0:05:03.58,0:05:08.32,Main-207+,,0,0,0,,Think whatever you like.  I'm not interested in things like that.Dialogue: 5,0:05:08.32,0:05:12.41,Main-207+,,0,0,0,,That's right. Don't listen to a stray dog.Dialogue: 5,0:05:13.71,0:05:18.88,Main-207+,,0,0,0,,A stray dog, Lucci?! You damn goblin cat!Dialogue: 5,0:05:27.59,0:05:29.93,Main-207+,,0,0,0,,Hey, stop it, both of you!Dialogue: 5,0:05:29.93,0:05:34.46,Main-207+,,0,0,0,,At any rate, Jabra is lashing  out at us quite a bit, isn't he?Dialogue: 5,0:05:34.46,0:05:37.00,Main-207+,,0,0,0,,All the guards on the islandDialogue: 5,0:05:37.00,0:05:41.99,Main-207+,,0,0,0,,are talking about Jabra getting rejected by the waitress Gatherine yesterday.Dialogue: 5,0:05:42.57,0:05:43.74,Main-207+,,0,0,0,,Oh, that's why.Dialogue: 5,0:05:43.74,0:05:47.86,Main-207+,,0,0,0,,H-Hey, hold on a sec!  Why does everyone know about that?!Dialogue: 5,0:05:47.86,0:05:52.12,Main-207+,,0,0,0,,I told the guards on the main  island about it. Chapapa!Dialogue: 5,0:05:52.99,0:05:53.83,Main-207+,,0,0,0,,So you're the one?!Dialogue: 1,0:05:55.45,0:05:57.79,Sign,,0,0,1,,m 376 541 l 891 549 890 633 375 629Dialogue: 2,0:05:55.45,0:05:57.79,Sign,,0,0,1,,GatherineDialogue: 5,0:05:57.79,0:05:59.64,Main-207+,,0,0,0,,Geez...Dialogue: 5,0:05:59.64,0:06:03.09,Main-207+,,0,0,0,,This is all because you started right  in on that stupid ranking stuff.Dialogue: 5,0:06:03.09,0:06:06.65,Main-207+,,0,0,0,,Having mastered the Six Powers,Dialogue: 5,0:06:06.65,0:06:09.62,Main-207+,,0,0,0,,you all have far surpassed average people.Dialogue: 5,0:06:09.62,0:06:13.01,Main-207+,,0,0,0,,Power level 500 would be enough for you to be called superhuman, right?Dialogue: 5,0:06:13.92,0:06:18.10,Main-207+,,0,0,0,,The chief has a power level of nine, less than one guard. Chapapa.Dialogue: 5,0:06:18.10,0:06:22.21,Main-207+,,0,0,0,,Don't say that! It's okay because I'm your commander-in-chief!Dialogue: 5,0:06:22.21,0:06:25.15,Main-207+,,0,0,0,,Besides, I have a special backup sword, right?!Dialogue: 5,0:06:25.15,0:06:28.32,Main-207+,,0,0,0,,I've always known that you're weak, Chief.Dialogue: 5,0:06:29.62,0:06:34.49,Main-207+,,0,0,0,,H-H-Hey, you shouldn't be so blunt, Kalifa.Dialogue: 5,0:06:34.49,0:06:37.89,Main-207+,,0,0,0,,– That's sexual harassment. – What?! Responding to your comment is?!Dialogue: 5,0:06:39.98,0:06:40.92,Main-207+,,0,0,0,,Chief...Dialogue: 5,0:06:40.92,0:06:43.25,Main-207+,,0,0,0,,Wh... What is it?Dialogue: 5,0:06:43.25,0:06:45.07,Main-207+,,0,0,0,,That's sexual harassment!Dialogue: 5,0:06:45.07,0:06:46.46,Main-207+,,0,0,0,,My existence is?!Dialogue: 5,0:06:47.42,0:06:52.39,Main-207+,,0,0,0,,Yoyoi! Kalifa! How rude of you!Dialogue: 5,0:06:53.17,0:06:59.86,Main-207+,,0,0,0,,Chief! I will... I will take responsibility  by committing ritual suicide!Dialogue: 5,0:06:59.86,0:07:01.47,Main-207+,,0,0,0,,Ritual suicide!Dialogue: 5,0:07:03.16,0:07:07.42,Main-207+,,0,0,0,,How regrettable...! I can't die.Dialogue: 5,0:07:07.42,0:07:09.74,Main-207+,,0,0,0,,I said just die already, you jerk!Dialogue: 5,0:07:14.83,0:07:20.92,Main-207+,,0,0,0,,Anyway, you've done a great job over the past five years.Dialogue: 5,0:07:24.50,0:07:29.41,Main-207+,,0,0,0,,Oh, that's right... This isn't really  a reward for your efforts or anything,Dialogue: 5,0:07:29.41,0:07:31.51,Main-207+,,0,0,0,,but I do have something I wanna give you.Dialogue: 5,0:07:31.51,0:07:35.01,Main-207+,,0,0,0,,Well, I'll do that later.Dialogue: 5,0:07:35.71,0:07:37.68,Main-207+,,0,0,0,,So, in any case, let me meet...Dialogue: 5,0:07:39.12,0:07:42.12,Main-207+,,0,0,0,,the "hope" of the entire world!Dialogue: 5,0:08:26.61,0:08:28.62,Main-207+,,0,0,0,,Go in already!Dialogue: 5,0:08:30.92,0:08:32.86,Main-207+,,0,0,0,,You too!Dialogue: 5,0:08:39.86,0:08:41.83,Main-207+,,0,0,0,,Coo coo?Dialogue: 5,0:08:47.15,0:08:49.96,Main-207+,,0,0,0,,Chapapa... Chapa!Dialogue: 5,0:08:57.03,0:08:58.89,Main-207+,,0,0,0,,I feel on top of the world!Dialogue: 5,0:08:58.89,0:09:05.35,Main-207+,,0,0,0,,I'm surprised to see you survived that accident eight years ago, Cutty Flam.Dialogue: 5,0:09:05.35,0:09:08.80,Main-207+,,0,0,0,,And also... the woman whom the world considers dangerous,Dialogue: 5,0:09:08.80,0:09:12.79,Main-207+,,0,0,0,,and has been trying to capture, Nico Robin...Dialogue: 5,0:09:15.49,0:09:18.62,Main-207+,,0,0,0,,I'm feeling great! However...Dialogue: 5,0:09:18.62,0:09:21.50,Main-207+,,0,0,0,,unfortunately, the public doesn't knowDialogue: 5,0:09:21.50,0:09:28.04,Main-207+,,0,0,0,,how truly valuable and great what we've achieved today is.Dialogue: 5,0:09:28.04,0:09:30.24,Main-207+,,0,0,0,,It'll be several years...Dialogue: 5,0:09:31.00,0:09:35.34,Main-207+,,0,0,0,,before it actually comes to be known.Dialogue: 5,0:09:36.01,0:09:38.74,Main-207+,,0,0,0,,In my opinion, the justice those old geezersDialogue: 5,0:09:38.74,0:09:41.51,Main-207+,,0,0,0,,in the current government dole out is too lenient!Dialogue: 5,0:09:41.51,0:09:45.00,Main-207+,,0,0,0,,Goals can't be achieved without sacrifice.Dialogue: 5,0:09:45.75,0:09:49.69,Main-207+,,0,0,0,,We're working in order to ensure  peace for all of humanity.Dialogue: 5,0:09:50.69,0:09:57.82,Main-207+,,0,0,0,,It's fine if we have to sacrifice some fools in our way to maintain peace...Dialogue: 5,0:09:57.82,0:10:02.85,Main-207+,,0,0,0,,including that fishman who didn't hand over what we told him to...Dialogue: 5,0:10:02.85,0:10:08.21,Main-207+,,0,0,0,,He deserved to be killed... as a rebel against justice.Dialogue: 5,0:10:11.22,0:10:13.71,Main-207+,,0,0,0,,He deserved it. He did!Dialogue: 5,0:10:14.30,0:10:16.93,Main-207+,,0,0,0,,You're crazy!Dialogue: 5,0:10:16.93,0:10:19.59,Main-207+,,0,0,0,,Tom-san put his life on the line to protect the blueprints,Dialogue: 5,0:10:19.59,0:10:23.22,Main-207+,,0,0,0,,because idiots like you exist!Dialogue: 5,0:10:28.14,0:10:31.73,Main-207+,,0,0,0,,Wh-What're you guys doing?! Help me! Hey!Dialogue: 5,0:10:32.66,0:10:36.07,Main-207+,,0,0,0,,Ow, ow, ow, ow! Ow!Dialogue: 5,0:10:36.07,0:10:38.11,Main-207+,,0,0,0,,Kumadori!Dialogue: 5,0:10:38.11,0:10:39.57,Main-207+,,0,0,0,,Yoyoi!Dialogue: 5,0:10:44.34,0:10:48.12,Main-207+,,0,0,0,,Roger!Dialogue: 5,0:10:48.12,0:10:50.92,Main-207+,,0,0,0,,Hurry up and help me, hey! Hey!Dialogue: 5,0:10:51.58,0:10:55.05,Main-207+,,0,0,0,,Now... now... now...!Dialogue: 5,0:10:56.30,0:10:57.72,Main-207+,,0,0,0,,Yoi!Dialogue: 5,0:10:59.76,0:11:01.22,Main-207+,,0,0,0,,Yo...!Dialogue: 5,0:11:02.60,0:11:04.10,Main-207+,,0,0,0,,Ow!Dialogue: 5,0:11:48.51,0:11:50.53,Main-207+,,0,0,0,,This is the main island, reporting to the chief!Dialogue: 5,0:11:50.53,0:11:53.65,Main-207+,,0,0,0,,Chief Spandam! Please come in!Dialogue: 5,0:11:54.30,0:11:55.81,Main-207+,,0,0,0,,It's no good! I can't get through!Dialogue: 5,0:11:55.81,0:11:58.40,Main-207+,,0,0,0,,Does he have the receiver off the hook again?Dialogue: 5,0:11:58.40,0:12:02.57,Main-207+,,0,0,0,,Not again, at a critical time like this, seriously!Dialogue: 5,0:12:02.57,0:12:05.39,Main-207+,,0,0,0,,Hey, where did Straw Hat go?Dialogue: 5,0:12:05.39,0:12:07.24,Main-207+,,0,0,0,,He's right underneath you!Dialogue: 5,0:12:07.24,0:12:09.12,Main-207+,,0,0,0,,What?! Right underneath us?!Dialogue: 5,0:12:11.69,0:12:13.87,Main-207+,,0,0,0,,Attack him now!Dialogue: 5,0:12:13.87,0:12:15.63,Main-207+,,0,0,0,,There he is! He's down there!Dialogue: 5,0:12:15.63,0:12:17.09,Main-207+,,0,0,0,,Dammit! I've been boxed in!Dialogue: 5,0:12:54.16,0:12:58.09,Main-207+,,0,0,0,,Th-The wall is... The wall is falling!Dialogue: 5,0:12:58.85,0:13:00.79,Main-207+,,0,0,0,,Get out of here!Dialogue: 5,0:13:10.56,0:13:13.23,Main-207+,,0,0,0,,Ah! Watch out!Dialogue: 5,0:13:17.81,0:13:21.32,Main-207+,,0,0,0,,Chief Spandam! Please come in! Please advise us on what to do!Dialogue: 5,0:13:21.32,0:13:23.82,Main-207+,,0,0,0,,We can't stop Straw Hat Luffy!Dialogue: 5,0:13:25.28,0:13:28.14,Main-207+,,0,0,0,,Straw Hat Luffy is headed to the courthouse!Dialogue: 0,0:13:25.32,0:13:30.07,Captions,,0,0,0,,Enies Lobby Main Island CourthouseDialogue: 1,0:13:25.32,0:13:30.07,Captions,,0,0,0,,Enies Lobby Main Island CourthouseDialogue: 5,0:13:28.14,0:13:30.08,Main-207+,,0,0,0,,Strengthen the defenses! Hurry up!Dialogue: 5,0:13:30.08,0:13:31.93,Main-207+,,0,0,0,,Be quiet!Dialogue: 5,0:13:31.93,0:13:33.37,Main-207+,,0,0,0,,What's this ruckus?!Dialogue: 5,0:13:33.37,0:13:36.00,Main-207+,,0,0,0,,You guys woke me up!Dialogue: 5,0:13:36.00,0:13:37.92,Main-207+,,0,0,0,,Ch-Chief Justice!Dialogue: 2,0:13:38.96,0:13:44.42,Sign2,,0,0,0,,"Three-Headed" BaskervilleDialogue: 3,0:13:38.96,0:13:44.42,Sign2,,0,0,0,,"Three-Headed" BaskervilleDialogue: 2,0:13:38.96,0:13:44.42,Sign2,,0,0,0,,Chief Justice, Enies LobbyDialogue: 3,0:13:38.96,0:13:44.42,Sign2,,0,0,0,,Chief Justice, Enies LobbyDialogue: 5,0:13:39.24,0:13:44.42,Main-207+,,0,0,0,,That's right! As a matter of fact, I am the chief justice of Enies Lobby!Dialogue: 5,0:13:44.42,0:13:48.49,Main-207+,,0,0,0,,On the left, I am the left Baskerville!Dialogue: 5,0:13:49.17,0:13:53.20,Main-207+,,0,0,0,,On the right, I am the right Baskerville!Dialogue: 5,0:13:53.20,0:13:58.31,Main-207+,,0,0,0,,And in the center, I am "Central Freeway"!Dialogue: 5,0:13:58.31,0:13:59.52,Main-207+,,0,0,0,,Say what?!Dialogue: 5,0:13:59.52,0:14:05.14,Main-207+,,0,0,0,,Ch-Chief Justice! A pirate is going on a rampage on the main island,Dialogue: 5,0:14:05.14,0:14:08.61,Main-207+,,0,0,0,,but they said that they can't get  in touch with Chief Spandam.Dialogue: 5,0:14:08.61,0:14:10.12,Main-207+,,0,0,0,,Please give us instructions on his behalf!Dialogue: 5,0:14:10.12,0:14:13.62,Main-207+,,0,0,0,,A pirate! Pirates are guilty!Dialogue: 5,0:14:14.29,0:14:15.56,Main-207+,,0,0,0,,Hmm...Dialogue: 5,0:14:16.29,0:14:20.00,Main-207+,,0,0,0,,Oh, come on. Why don't we let him off?Dialogue: 5,0:14:20.00,0:14:21.39,Main-207+,,0,0,0,,Hmm...Dialogue: 5,0:14:21.39,0:14:23.67,Main-207+,,0,0,0,,Then, let's compromise and give him...Dialogue: 5,0:14:23.67,0:14:24.92,Main-207+,,0,0,0,,the death penalty!Dialogue: 5,0:14:24.92,0:14:26.66,Main-207+,,0,0,0,,Say what?!Dialogue: 5,0:14:28.18,0:14:30.62,Main-207+,,0,0,0,,There's trouble, Chief Justice!Dialogue: 5,0:14:30.62,0:14:35.01,Main-207+,,0,0,0,,We got a report that Kashi was taken out  at the island gate by Straw Hat's comradesDialogue: 5,0:14:35.01,0:14:37.14,Main-207+,,0,0,0,,and that Oimo is losing, too!Dialogue: 5,0:14:37.14,0:14:39.94,Main-207+,,0,0,0,,What?! Don't let them past the gate!Dialogue: 5,0:14:41.24,0:14:45.13,Main-207+,,0,0,0,,Send 100 watchdogs immediately!Dialogue: 5,0:14:45.13,0:14:46.28,Main-207+,,0,0,0,,Yes, sir!Dialogue: 0,0:14:46.32,0:14:50.49,Captions,,0,0,0,,Enies Lobby Island GateDialogue: 1,0:14:46.32,0:14:50.49,Captions,,0,0,0,,Enies Lobby Island GateDialogue: 5,0:14:50.49,0:14:53.53,Main-207+,,0,0,0,,Dammit! It's been more than five minutes!Dialogue: 5,0:14:53.53,0:14:57.20,Main-207+,,0,0,0,,This is bad! Hurry up and open  up the path for Rocketman!Dialogue: 5,0:14:57.20,0:14:59.67,Main-207+,,0,0,0,,I'm not gonna let you through this gate!Dialogue: 5,0:15:01.12,0:15:03.29,Main-207+,,0,0,0,,We unlocked the gate!Dialogue: 5,0:15:03.29,0:15:05.33,Main-207+,,0,0,0,,Now we can push the doors open!Dialogue: 5,0:15:05.33,0:15:07.01,Main-207+,,0,0,0,,What?! Crap!Dialogue: 5,0:15:07.01,0:15:08.32,Main-207+,,0,0,0,,All right! Good going!Dialogue: 5,0:15:08.32,0:15:10.00,Main-207+,,0,0,0,,Go!Dialogue: 5,0:15:10.63,0:15:13.26,Main-207+,,0,0,0,,Don't touch this gate!Dialogue: 5,0:15:18.35,0:15:19.77,Main-207+,,0,0,0,,Take this!Dialogue: 5,0:15:21.73,0:15:24.69,Main-207+,,0,0,0,,Whoa! Just what you'd expect from a Galley-La foreman!Dialogue: 5,0:15:24.69,0:15:27.69,Main-207+,,0,0,0,,What?! This is just a rope!Dialogue: 5,0:15:28.49,0:15:31.00,Main-207+,,0,0,0,,Franky Family! Pull it!Dialogue: 5,0:15:31.00,0:15:32.11,Main-207+,,0,0,0,,Yeah!Dialogue: 5,0:15:32.66,0:15:37.26,Main-207+,,0,0,0,,Just leave it to us! Let's go, Sodom! Gomorrah! Grab the rope!Dialogue: 5,0:15:43.79,0:15:46.69,Main-207+,,0,0,0,,Charge into the gate!Dialogue: 5,0:15:47.76,0:15:51.47,Main-207+,,0,0,0,,H-Hey! Hold on a sec! I'm feeling dizzy!Dialogue: 5,0:15:51.47,0:15:53.68,Main-207+,,0,0,0,,Push the doors!Dialogue: 5,0:15:59.06,0:16:01.00,Main-207+,,0,0,0,,Look! The doors are...!Dialogue: 5,0:16:01.00,0:16:02.35,Main-207+,,0,0,0,,The doors are opening!Dialogue: 5,0:16:02.35,0:16:04.77,Main-207+,,0,0,0,,What happened to Oimo?!Dialogue: 5,0:16:04.77,0:16:06.73,Main-207+,,0,0,0,,Just a little more!Dialogue: 5,0:16:18.89,0:16:21.75,Main-207+,,0,0,0,,The gate has been opened!Dialogue: 1,0:16:21.75,0:16:21.79,Sign - Map,,0,0,0,,m -68 -20 l 69 -20 69 20 -68 20Dialogue: 1,0:16:21.79,0:16:21.83,Sign - Map,,0,0,0,,m -68 -20 l 69 -20 69 20 -68 20Dialogue: 1,0:16:21.83,0:16:21.87,Sign - Map,,0,0,0,,m -68 -20 l 69 -20 69 20 -68 20Dialogue: 1,0:16:21.87,0:16:21.91,Sign - Map,,0,0,0,,m -68 -20 l 69 -20 69 20 -68 20Dialogue: 1,0:16:21.91,0:16:21.96,Sign - Map,,0,0,0,,m -68 -20 l 69 -20 69 20 -68 20Dialogue: 1,0:16:21.96,0:16:22.00,Sign - Map,,0,0,0,,m -68 -20 l 69 -20 69 20 -68 20Dialogue: 1,0:16:22.00,0:16:22.04,Sign - Map,,0,0,0,,m -68 -20 l 69 -20 69 20 -68 20Dialogue: 1,0:16:22.04,0:16:22.08,Sign - Map,,0,0,0,,m -68 -20 l 69 -20 69 20 -68 20Di