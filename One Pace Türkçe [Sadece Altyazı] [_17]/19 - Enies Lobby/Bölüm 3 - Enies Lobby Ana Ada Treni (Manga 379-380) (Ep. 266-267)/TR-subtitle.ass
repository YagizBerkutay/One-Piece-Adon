F,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2,0,2,10,10,10,1Style: Kanji,Duality,65,&H002FıAAF,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2,0,8,10,10,120,1Style: Sign,FOT-Greco Std B,40,&H00000000,&H000000FF,&H00F3F3F4,&H00000000,0,0,0,0,100,100,0,0,1,3,0,2,10,10,10,1Style: Sign2,PT Sans,45,&H00FFFFFF,&H000000FF,&H00040303,&H00000000,-1,0,0,0,100,100,1.5,0,1,1.3,1,2,10,10,10,1Style: Sign - Map,Roboto,35,&H00000000,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,0,0,5,10,10,10,1Style: Author,Impress BT,20,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1,1,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:01:55.84,0:02:05.84,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:12:32.00,0:12:42.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:22:57.00,0:23:07.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 1,0:01:55.84,0:02:01.14,Title,,0,0,0,,Enies Lobby Ana Ada TreniDialogue: 2,0:01:55.84,0:02:01.14,Title,,0,0,0,,Enies Lobby Ana Ada TreniDialogue: 5,0:02:07.23,0:02:09.77,Main-207+,,0,0,0,,Epey zaman oldu, Şef.Dialogue: 5,0:02:12.99,0:02:16.00,Main-207+,,0,0,0,,Sekiz yıl önce hükümet memurlarının...Dialogue: 5,0:02:16.00,0:02:20.99,Main-207+,,0,0,0,,...saldırıya uğradığı olayla ilgili aranan suçlu, Cutty Flam.Dialogue: 5,0:02:20.99,0:02:24.05,Main-207+,,0,0,0,,Yirmi yıl önce,  Batı Mavi'de bulunan...Dialogue: 5,0:02:24.05,0:02:29.00,Main-207+,,0,0,0,,...Ohara'da Donanma savaş gemilerinin saldırıya uğradığı olaya karışan suçlu Nico Robin.Dialogue: 5,0:02:29.00,0:02:32.06,Main-207+,,0,0,0,,Gecikme olmadan onları buraya getirdik.Dialogue: 5,0:02:32.73,0:02:35.09,Main-207+,,0,0,0,,O ikisi, kapının diğer tarafında bekliyor.Dialogue: 5,0:02:35.85,0:02:41.60,Main-207+,,0,0,0,,Geri dönmeniz harika!  Lucci, Kaku, Blueno, Kalifa!Dialogue: 5,0:02:41.60,0:02:42.95,Main-207+,,0,0,0,,Bu cinsel taciz.Dialogue: 5,0:02:42.95,0:02:44.89,Main-207+,,0,0,0,,Sadece adını söylemek mi?!Dialogue: 5,0:02:48.82,0:02:51.65,Main-207+,,0,0,0,,Epey zaman oldu, Lucci.Dialogue: 5,0:02:51.65,0:02:54.65,Main-207+,,0,0,0,,Küstah suratın  biraz olsun değişmemiş görünüyor.Dialogue: 5,0:02:55.25,0:02:58.07,Main-207+,,0,0,0,,Aynısı senin aptal suratın için de geçerli, Jyabura.Dialogue: 5,0:02:58.70,0:03:00.49,Main-207+,,0,0,0,,Ne?Dialogue: 5,0:03:01.82,0:03:05.92,Main-207+,,0,0,0,,İkiniz ara veremez misiniz?  Daha döner dönmez dövüşmek de ne oluyor?Dialogue: 5,0:03:05.92,0:03:11.92,Main-207+,,0,0,0,,Yoyoi!  Doğru, ikiniz de kesin şunu!Dialogue: 5,0:03:12.73,0:03:19.60,Main-207+,,0,0,0,,Bu, beş yıldır ilk karşılaşmamız değil mi?!Dialogue: 5,0:03:30.65,0:03:32.98,Main-207+,,0,0,0,,Chapapa...Dialogue: 5,0:03:34.47,0:03:36.23,Main-207+,,0,0,0,,Chapa...Dialogue: 5,0:03:36.23,0:03:37.65,Main-207+,,0,0,0,,Cha... pa...Dialogue: 5,0:03:41.70,0:03:45.24,Main-207+,,0,0,0,,Bunu yapacağını en başından biliyordum, Fukurou.Dialogue: 5,0:03:46.00,0:03:48.66,Main-207+,,0,0,0,,Altı Şekil Stil Yarışması!Dialogue: 5,0:03:49.60,0:03:54.41,Main-207+,,0,0,0,,Silahlı bir askerin gücü 10 güç seviyesindedir.Dialogue: 3,0:03:52.17,0:03:52.21,Sign,,0,0,0,,Güç Seviyesi 10Dialogue: 3,0:03:52.21,0:03:52.25,Sign,,0,0,0,,Güç Seviyesi 10Dialogue: 3,0:03:52.25,0:03:52.29,Sign,,0,0,0,,Güç Seviyesi 10Dialogue: 3,0:03:52.29,0:03:52.33,Sign,,0,0,0,,Güç Seviyesi 10Dialogue: 3,0:03:52.33,0:03:52.37,Sign,,0,0,0,,Güç Seviyesi 10Dialogue: 3,0:03:52.37,0:03:52.42,Sign,,0,0,0,,Güç Seviyesi 10Dialogue: 3,0:03:52.42,0:03:52.46,Sign,,0,0,0,,Güç Seviyesi 10Dialogue: 3,0:03:52.46,0:03:52.50,Sign,,0,0,0,,Güç Seviyesi 10Dialogue: 3,0:03:52.50,0:03:55.29,Sign,,0,0,0,,Güç Seviyesi 10Dialogue: 3,0:03:55.29,0:03:55.42,Sign,,0,0,0,,Güç Seviyesi 10Dialogue: 3,0:03:55.42,0:03:55.54,Sign,,0,0,0,,Güç Seviyesi 10Dialogue: 3,0:03:55.54,0:03:56.17,Sign,,0,0,0,,Güç Seviyesi 10Dialogue: 2,0:03:52.17,0:03:52.21,Sign,,0,0,0,,m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 2,0:03:52.21,0:03:52.25,Sign,,0,0,0,,m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 2,0:03:52.25,0:03:52.29,Sign,,0,0,0,,m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 2,0:03:52.29,0:03:52.33,Sign,,0,0,0,,m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 2,0:03:52.33,0:03:52.37,Sign,,0,0,0,,m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 2,0:03:52.37,0:03:52.42,Sign,,0,0,0,,m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 2,0:03:52.42,0:03:52.46,Sign,,0,0,0,,m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 2,0:03:52.46,0:03:52.50,Sign,,0,0,0,,m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 2,0:03:52.50,0:03:55.29,Sign,,0,0,0,,m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 2,0:03:55.29,0:03:55.42,Sign,,0,0,0,,m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 2,0:03:55.42,0:03:55.54,Sign,,0,0,0,,m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 2,0:03:55.54,0:03:56.17,Sign,,0,0,0,,m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 1,0:03:52.17,0:03:52.21,Sign,,0,0,0,,m 713 365 l 713 417 999 417 999 365 713 365 m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 1,0:03:52.21,0:03:52.25,Sign,,0,0,0,,m 713 365 l 713 417 999 417 999 365 713 365 m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 1,0:03:52.25,0:03:52.29,Sign,,0,0,0,,m 713 365 l 713 417 999 417 999 365 713 365 m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 1,0:03:52.29,0:03:52.33,Sign,,0,0,0,,m 713 365 l 713 417 999 417 999 365 713 365 m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 1,0:03:52.33,0:03:52.37,Sign,,0,0,0,,m 713 365 l 713 417 999 417 999 365 713 365 m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 1,0:03:52.37,0:03:52.42,Sign,,0,0,0,,m 713 365 l 713 417 999 417 999 365 713 365 m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 1,0:03:52.42,0:03:52.46,Sign,,0,0,0,,m 713 365 l 713 417 999 417 999 365 713 365 m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 1,0:03:52.46,0:03:52.50,Sign,,0,0,0,,m 713 365 l 713 417 999 417 999 365 713 365 m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 1,0:03:52.50,0:03:55.29,Sign,,0,0,0,,m 713 365 l 713 417 999 417 999 365 713 365 m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 1,0:03:55.29,0:03:55.42,Sign,,0,0,0,,m 713 365 l 713 417 999 417 999 365 713 365 m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 1,0:03:55.42,0:03:55.54,Sign,,0,0,0,,m 713 365 l 713 417 999 417 999 365 713 365 m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 1,0:03:55.54,0:03:56.17,Sign,,0,0,0,,m 713 365 l 713 417 999 417 999 365 713 365 m 993 412 l 719 412 719 370 993 370 993 412Dialogue: 5,0:03:54.41,0:03:56.17,Main-207+,,0,0,0,,Sizinkiyse...Dialogue: 5,0:03:56.17,0:04:01.00,Main-207+,,0,0,0,,Bir bakalım, bir bakalım.  Gücünüz nedir?Dialogue: 5,0:04:01.00,0:04:04.10,Main-207+,,0,0,0,,Önce Kalifa. 630 güç seviyesi!Dialogue: 5,0:04:04.10,0:04:06.85,Main-207+,,0,0,0,,Blueno, 820 güç seviyesi!Dialogue: 5,0:04:06.85,0:04:10.10,Main-207+,,0,0,0,,Kaku, 2200 güç seviyesi.Dialogue: 5,0:04:10.10,0:04:12.28,Main-207+,,0,0,0,,Lucci,...Dialogue: 5,0:04:15.02,0:04:17.27,Main-207+,,0,0,0,,...4000 güç seviyesi!Dialogue: 5,0:04:17.27,0:04:20.51,Main-207+,,0,0,0,,Dört bin mi dedin?! Hey, cidden mi diyorsun?!Dialogue: 5,0:04:20.51,0:04:22.76,Main-207+,,0,0,0,,Hiç böyle bir güç seviyesi duymadım!Dialogue: 5,0:04:22.76,0:04:24.36,Main-207+,,0,0,0,,Doğru!Dialogue: 5,0:04:24.36,0:04:27.66,Main-207+,,0,0,0,,Herkes güçlenmiş, chapapa!Dialogue: 5,0:04:28.43,0:04:33.89,Main-207+,,0,0,0,,Jyabura ve Kumadori'nin güçlerini de biliyorum. Bu yüzden kimin daha güçlü olduğunu anladım!Dialogue: 5,0:04:39.67,0:04:41.59,Main-207+,,0,0,0,,Hey, bu hiç adil değil Fukurou!Dialogue: 5,0:04:42.17,0:04:45.96,Main-207+,,0,0,0,,Lucci bir yana, Kaku'nun da altında kalmam ne demek oluyor?!Dialogue: 5,0:04:45.96,0:04:47.26,Main-207+,,0,0,0,,Chapapa!Dialogue: 5,0:04:47.26,0:04:50.01,Main-207+,,0,0,0,,Kaku'da güçlenmiş!Dialogue: 5,0:04:50.62,0:04:53.74,Main-207+,,0,0,0,,Hey! Ukalalık etme, Kaku!Dialogue: 5,0:04:53.74,0:04:56.98,Main-207+,,0,0,0,,Yarışma, sadece fiziksel güç seviyesini ölçmekte kullanılan bir tekniktir.Dialogue: 5,0:04:57.53,0:05:00.81,Main-207+,,0,0,0,,Gerçek dövüşte  Şeytan Meyvesi gücü de sayılacak!Dialogue: 5,0:05:00.81,0:05:03.58,Main-207+,,0,0,0,,Sana karşı asla yenilmeyeceğimi unutma!Dialogue: 5,0:05:03.58,0:05:08.32,Main-207+,,0,0,0,,İstediğin gibi düşün.  Böyle şeylere ilgim yok.Dialogue: 5,0:05:08.32,0:05:12.41,Main-207+,,0,0,0,,Doğru. Başıboş bir köpeğin dediklerini dikkate alma.Dialogue: 5,0:05:13.71,0:05:18.88,Main-207+,,0,0,0,,Başıboş köpek kimmiş, Lucci? Seni canavar kedi!Dialogue: 5,0:05:27.59,0:05:29.93,Main-207+,,0,0,0,,İkiniz de kesin şunu.Dialogue: 5,0:05:29.93,0:05:34.46,Main-207+,,0,0,0,,Şu Jyabura, epey sert davranıyor.Dialogue: 5,0:05:34.46,0:05:37.00,Main-207+,,0,0,0,,Jyabura'nın, sekreter kız...Dialogue: 5,0:05:37.00,0:05:41.99,Main-207+,,0,0,0,,...Gyatharin tarafından aldatılması, adadaki Denizciler arasında en çok konuşulan konu!Dialogue: 5,0:05:42.57,0:05:43.74,Main-207+,,0,0,0,,Demek sebebi bu.Dialogue: 5,0:05:43.74,0:05:47.86,Main-207+,,0,0,0,,D-Durun biraz!  Bunu niye herkes biliyor?!Dialogue: 5,0:05:47.86,0:05:52.12,Main-207+,,0,0,0,,Ana Ada'da bundan bahsetmiştim, chapapa!Dialogue: 5,0:05:52.99,0:05:53.83,Main-207+,,0,0,0,,Sen miydin?Dialogue: 1,0:05:55.45,0:05:57.79,Sign,,0,0,1,,m 376 541 l 891 549 890 633 375 629Dialogue: 2,0:05:55.45,0:05:57.79,Sign,,0,0,1,,GyatharinDialogue: 5,0:05:57.79,0:05:59.64,Main-207+,,0,0,0,,Üfff!Dialogue: 5,0:05:59.64,0:06:03.09,Main-207+,,0,0,0,,Aptalca bir rütbe listesi yüzünden dövüşmeyin.Dialogue: 5,0:06:03.09,0:06:06.65,Main-207+,,0,0,0,,Hepiniz altı şekil çalışmasını bitirdiğiniz için,...Dialogue: 5,0:06:06.65,0:06:09.62,Main-207+,,0,0,0,,...normal insan gücünün çok ötesindesiniz!Dialogue: 5,0:06:09.62,0:06:13.01,Main-207+,,0,0,0,,500 güç seviyesi, kendinizi süper insan olarak görmek için yeterli zaten.Dialogue: 5,0:06:13.92,0:06:18.10,Main-207+,,0,0,0,,Şefin 9 güç seviyesi var.  O tek, chapapa.Dialogue: 5,0:06:18.10,0:06:22.21,Main-207+,,0,0,0,,Öyle deme! Bunun önemi yok! Ben sadece emirleri veren şefim!Dialogue: 5,0:06:22.21,0:06:25.15,Main-207+,,0,0,0,,Üstelik özel kılıcım var!Dialogue: 5,0:06:25.15,0:06:28.32,Main-207+,,0,0,0,,Şefin güçsüzlüğünü uzun zamandır hepimiz biliyoruz.Dialogue: 5,0:06:29.62,0:06:34.49,Main-207+,,0,0,0,,H-H-H-Hey! Bu konuda bu kadar açık sözlü olmamalısın, Kalifa!Dialogue: 5,0:06:34.49,0:06:37.89,Main-207+,,0,0,0,,– Bu cinsel taciz. – Eh?! Cevap verdiğim için mi?!Dialogue: 5,0:06:39.98,0:06:40.92,Main-207+,,0,0,0,,Şef.Dialogue: 5,0:06:40.92,0:06:43.25,Main-207+,,0,0,0,,N-Ne var?Dialogue: 5,0:06:43.25,0:06:45.07,Main-207+,,0,0,0,,Bu cinsel taciz.Dialogue: 5,0:06:45.07,0:06:46.46,Main-207+,,0,0,0,,Varlığım mı?!Dialogue: 5,0:06:47.42,0:06:52.39,Main-207+,,0,0,0,,Yoyoi!  Kalifa, ne kadar kabasın!Dialogue: 5,0:06:53.17,0:06:59.86,Main-207+,,0,0,0,,Şef! Bunun sorumluluğunu üstlenmem için karnımı deşmeme izin verin!Dialogue: 5,0:06:59.86,0:07:01.47,Main-207+,,0,0,0,,Seppuku!Dialogue: 5,0:07:03.16,0:07:07.42,Main-207+,,0,0,0,,Ölemiyorum.Dialogue: 5,0:07:07.42,0:07:09.74,Main-207+,,0,0,0,,Zaten bir an önce kendini öldürmeni söylemiştim!Dialogue: 5,0:07:14.83,0:07:20.92,Main-207+,,0,0,0,,Neyse, beş yıllık göreviniz boyunca gerçekten iyi iş çıkardınız.Dialogue: 5,0:07:24.50,0:07:29.41,Main-207+,,0,0,0,,Evet!  Bu işin ödülü gibi değil ama...Dialogue: 5,0:07:29.41,0:07:31.51,Main-207+,,0,0,0,,...size vermek istediğim bir şey var.Dialogue: 5,0:07:31.51,0:07:35.01,Main-207+,,0,0,0,,Şimdilik bunu bir kenara bırakacağız.Dialogue: 5,0:07:35.71,0:07:37.68,Main-207+,,0,0,0,,Beni onlarla görüştürün.Dialogue: 5,0:07:39.12,0:07:42.12,Main-207+,,0,0,0,,Tüm dünyanın umuduyla birlikte.Dialogue: 5,0:08:26.61,0:08:28.62,Main-207+,,0,0,0,,Hemen içeri girin!Dialogue: 5,0:08:30.92,0:08:32.86,Main-207+,,0,0,0,,Sen de!Dialogue: 5,0:08:47.15,0:08:49.96,Main-207+,,0,0,0,,Chapapa... Chapa!Dialogue: 5,0:08:57.03,0:08:58.89,Main-207+,,0,0,0,,Daha mutlu olamazdım!Dialogue: 5,0:08:58.89,0:09:05.35,Main-207+,,0,0,0,,Sekiz sene önceki olaydan sağ çıkmayı iyi becerdin, Cutty Flam.Dialogue: 5,0:09:05.35,0:09:08.80,Main-207+,,0,0,0,,Tüm dünyanın tehdit olarak gördüğü...Dialogue: 5,0:09:08.80,0:09:12.79,Main-207+,,0,0,0,,ve aranan suçlu kadın, Nico Robin.Dialogue: 5,0:09:15.49,0:09:18.62,Main-207+,,0,0,0,,Kendimi harika hissediyorum! Yine de...Dialogue: 5,0:09:18.62,0:09:21.50,Main-207+,,0,0,0,,Çok yazık ama dünyadaki insanlar,...Dialogue: 5,0:09:21.50,0:09:28.04,Main-207+,,0,0,0,,...hala bugünkü başarımızın  ne kadar muhteşem olduğunu bilmiyor.Dialogue: 5,0:09:28.04,0:09:35.34,Main-207+,,0,0,0,,İşin aslı,  bu olayların duyulması birkaç yıl sürebilir.Dialogue: 5,0:09:36.01,0:09:38.74,Main-207+,,0,0,0,,Bana sorarsanız, o yaşlı adamların...Dialogue: 5,0:09:38.74,0:09:41.51,Main-207+,,0,0,0,,...adaleti hala çok yumuşak!Dialogue: 5,0:09:41.51,0:09:45.00,Main-207+,,0,0,0,,Hiçbir şeyi feda etmeden amaçlarınıza ulaşamazsınız.Dialogue: 5,0:09:45.75,0:09:49.69,Main-207+,,0,0,0,,Tüm insanlığa  barış getirmek için de çalışıyoruz.Dialogue: 5,0:09:50.69,0:09:57.82,Main-207+,,0,0,0,,İşimizi engelleyen o ahmakları, büyük barışın kurbanları olarak öldürmekte bir sorun yok.Dialogue: 5,0:09:57.82,0:10:02.85,Main-207+,,0,0,0,,Kendisinden istediklerimizi  teslim etmeyen balık adam dahil...Dialogue: 5,0:10:02.85,0:10:08.21,Main-207+,,0,0,0,,...adalete başkaldıran herkes öldürülmeyi hak etti.Dialogue: 5,0:10:11.22,0:10:13.71,Main-207+,,0,0,0,,Hak etti, hak etti.Dialogue: 5,0:10:14.30,0:10:16.93,Main-207+,,0,0,0,,Sinirimi bozuyor!Dialogue: 5,0:10:16.93,0:10:19.59,Main-207+,,0,0,0,,Tom-san, sadece o planları korumak için hayatını feda etti!Dialogue: 5,0:10:19.59,0:10:23.22,Main-207+,,0,0,0,,Sırf senin gibi aptallar var olduğu için!Dialogue: 5,0:10:28.14,0:10:31.73,Main-207+,,0,0,0,,Ne yapıyorsunuz?!  Yardım edin!Dialogue: 5,0:10:36.07,0:10:38.11,Main-207+,,0,0,0,,Kumadori!Dialogue: 5,0:10:38.11,0:10:39.57,Main-207+,,0,0,0,,Yoyoi!Dialogue: 5,0:10:44.34,0:10:48.12,Main-207+,,0,0,0,,Anlaşıldı!Dialogue: 5,0:10:48.12,0:10:50.92,Main-207+,,0,0,0,,Hemen beni kurtar, hey!Dialogue: 5,0:10:51.58,0:10:55.05,Main-207+,,0,0,0,,Şimdi... şimdi... şimdi...!Dialogue: 5,0:10:56.30,0:10:57.72,Main-207+,,0,0,0,,Yoi!Dialogue: 5,0:10:59.76,0:11:01.22,Main-207+,,0,0,0,,Yo...!Dialogue: 5,0:11:48.51,0:11:50.53,Main-207+,,0,0,0,,Ana Ada'dan şefe mesaj!Dialogue: 5,0:11:50.53,0:11:53.65,Main-207+,,0,0,0,,Şef Spandam?  Cevap bekliyorum!Dialogue: 5,0:11:54.30,0:11:55.81,Main-207+,,0,0,0,,Faydasız, bağlanmıyor!Dialogue: 5,0:11:55.81,0:11:58.40,Main-207+,,0,0,0,,Belki yine ahizesi açık kalmıştır.Dialogue: 5,0:11:58.40,0:12:02.57,Main-207+,,0,0,0,,Yine mi? Böyle önemli bir zamanda da!Dialogue: 5,0:12:02.57,0:12:05.39,Main-207+,,0,0,0,,Hey, Hasır Şapka nereye kayboldu?Dialogue: 5,0:12:05.39,0:12:07.24,Main-207+,,0,0,0,,Tam altında!Dialogue: 5,0:12:07.24,0:12:09.12,Main-207+,,0,0,0,,Eh? Altımda mı?Dialogue: 5,0:12:11.69,0:12:13.87,Main-207+,,0,0,0,,Herkes aynı anda saldırsın!Dialogue: 5,0:12:13.87,0:12:15.63,Main-207+,,0,0,0,,İşte! Aşağıda!Dialogue: 5,0:12:15.63,0:12:17.09,Main-207+,,0,0,0,,Kahretsin, köşeye sıkıştım!Dialogue: 5,0:12:54.16,0:12:58.09,Main-207+,,0,0,0,,Duvar... Duvar çöküyor!Dialogue: 5,0:12:58.85,0:13:00.79,Main-207+,,0,0,0,,Kaçın!Dialogue: 5,0:13:10.56,0:13:13.23,Main-207+,,0,0,0,,Çok tehlikeli!Dialogue: 5,0:13:17.81,0:13:21.32,Main-207+,,0,0,0,,Şef Spandam, cevap bekliyorum! Emirlerinizi verin!Dialogue: 5,0:13:21.32,0:13:23.82,Main-207+,,0,0,0,,Hasır Şapkalı Luffy durmuyor!Dialogue: 5,0:13:25.28,0:13:28.14,Main-207+,,0,0,0,,Hasır Şapkalı Luffy, adliyeye doğru gidiyor!Dialogue: 0,0:13:25.32,0:13:30.07,Captions,,0,0,0,,Enies Lobby Ana Ada AdliyeDialogue: 1,0:13:25.32,0:13:30.07,Captions,,0,0,0,,Enies Lobby Ana Ada AdliyeDialogue: 5,0:13:28.14,0:13:30.08,Main-207+,,0,0,0,,Savunmamızı arttırın, çabuk!Dialogue: 5,0:13:30.08,0:13:31.93,Main-207+,,0,0,0,,Kapayın çenenizi!Dialogue: 5,0:13:31.93,0:13:33.37,Main-207+,,0,0,0,,Bu yaygara da neyin nesi?Dialogue: 5,0:13:33.37,0:13:36.00,Main-207+,,0,0,0,,Daha yeni uyandım!Dialogue: 5,0:13:36.00,0:13:37.92,Main-207+,,0,0,0,,Ya-Yargıç!Dialogue: 2,0:13:38.96,0:13:44.42,Sign2,,0,0,0,,"3 Başlı" BaskervilleDialogue: 3,0:13:38.96,0:13:44.42,Sign2,,0,0,0,,"3 Başlı" BaskervilleDialogue: 2,0:13:38.96,0:13:44.42,Sign2,,0,0,0,,Enies Lobby Baş YargıcıDialogue: 3,0:13:38.96,0:13:44.42,Sign2,,0,0,0,,Enies Lobby Baş YargıcıDialogue: 5,0:13:39.24,0:13:44.42,Main-207+,,0,0,0,,Evet! Saklamaya gerek yok. Ben, Enies Lobby'nin baş yargıcıyım!Dialogue: 5,0:13:44.42,0:13:48.49,Main-207+,,0,0,0,,Ben, sol eliyle yazan, Sol Baskerville!Dialogue: 5,0:13:49.17,0:13:53.20,Main-207+,,0,0,0,,Ben, sağ eliyle yazan, Sağ Baskerville!Dialogue: 5,0:13:53.20,0:13:58.31,Main-207+,,0,0,0,,Ben, ortadaki, Merkez Otoyol!Dialogue: 5,0:13:58.31,0:13:59.52,Main-207+,,0,0,0,,O da ne?!Dialogue: 5,0:13:59.52,0:14:05.14,Main-207+,,0,0,0,,Ya-Yargıç! Ada Ada'da karışıklık çıkaran yalnız bir korsan var.Dialogue: 5,0:14:05.14,0:14:08.61,Main-207+,,0,0,0,,Görünüşe göre Şef Spandam'a da ulaşamıyoruz.Dialogue: 5,0:14:08.61,0:14:10.12,Main-207+,,0,0,0,,Lütfen onun yerine kumandayı üstlenin!Dialogue: 5,0:14:10.12,0:14:13.62,Main-207+,,0,0,0,,Bir korsan mı? Korsan suçludur!Dialogue: 5,0:14:16.29,0:14:20.00,Main-207+,,0,0,0,,Öyle şeyler demeyi kes.  Bırak masum kalsın!Dialogue: 5,0:14:21.39,0:14:23.67,Main-207+,,0,0,0,,O zaman ben tarafsız kalacağım.Dialogue: 5,0:14:23.67,0:14:24.92,Main-207+,,0,0,0,,İdama mahkum edin!Dialogue: 5,0:14:24.92,0:14:26.66,Main-207+,,0,0,0,,Niye?!Dialogue: 5,0:14:28.18,0:14:30.62,Main-207+,,0,0,0,,Başımız dertte! Yargıç!Dialogue: 5,0:14:30.62,0:14:35.01,Main-207+,,0,0,0,,Kashii'nin Hasır Şapka'nın yoldaşları tarafından  ada kapısında kaçırıldığına...Dialogue: 5,0:14:35.01,0:14:37.14,Main-207+,,0,0,0,,...ve Oimo'nun da kaybettiğine dair  bir rapor aldık!Dialogue: 5,0:14:37.14,0:14:39.94,Main-207+,,0,0,0,,Ne?  Kapı kesinlikle açılmamalı!Dialogue: 5,0:14:41.24,0:14:45.13,Main-207+,,0,0,0,,Ana Ada'ya  100 kanun koruyucu birim gönderin!Dialogue: 5,0:14:45.13,0:14:46.28,Main-207+,,0,0,0,,Emredersiniz!Dialogue: 0,0:14:46.32,0:14:50.49,Captions,,0,0,0,,Enies Lobby Ada KapısıDialogue: 1,0:14:46.32,0:14:50.49,Captions,,0,0,0,,Enies Lobby Ada KapısıDialogue: 5,0:14:50.49,0:14:53.53,Main-207+,,0,0,0,,Kahretsin!  Söz verdiğimiz 5 dakikalık süre doldu!Dialogue: 5,0:14:53.53,0:14:57.20,Main-207+,,0,0,0,,Durum kötü!  Çabuk Roket Adam için yolu açın!Dialogue: 5,0:14:57.20,0:14:59.67,Main-207+,,0,0,0,,Bu kapıyı ele geçirmenize izin vermeyeceğim!Dialogue: 5,0:15:01.12,0:15:03.29,Main-207+,,0,0,0,,Kapının kilidini açtık!Dialogue: 5,0:15:03.29,0:15:05.33,Main-207+,,0,0,0,,Açılması için sadece itmeniz gerek!Dialogue: 5,0:15:05.33,0:15:07.01,Main-207+,,0,0,0,,Ne?! Kahretsin!Dialogue: 5,0:15:07.01,0:15:08.32,Main-207+,,0,0,0,,Tamam, iyi iş!Dialogue: 5,0:15:08.32,0:15:10.00,Main-207+,,0,0,0,,Gidelim!Dialogue: 5,0:15:10.63,0:15:13.26,Main-207+,,0,0,0,,O kapıya dokunmayın!Dialogue: 5,0:15:18.35,0:15:19.77,Main-207+,,0,0,0,,Al bunu!Dialogue: 5,0:15:21.73,0:15:24.69,Main-207+,,0,0,0,,Müthiş!  Galley-La ustabaşından beklendiği gibi!Dialogue: 5,0:15:24.69,0:15:27.69,Main-207+,,0,0,0,,Böyle bir iple ne yapmaya çalışıyorsun?Dialogue: 5,0:15:28.49,0:15:31.00,Main-207+,,0,0,0,,Franky Ailesi, çekin!Dialogue: 5,0:15:31.00,0:15:32.11,Main-207+,,0,0,0,,Evet!Dialogue: 5,0:15:32.66,0:15:37.26,Main-207+,,0,0,0,,Biz hallederiz.  Hadi, Sodom, Gomorrah! İplere asılın!Dialogue: 5,0:15:43.79,0:15:46.69,Main-207+,,0,0,0,,Bu taraftan saldıralım!Dialogue: 5,0:15:47.76,0:15:51.47,Main-207+,,0,0,0,,D-Durun biraz! Başım dönüyor!Dialogue: 5,0:15:51.47,0:15:53.68,Main-207+,,0,0,0,,Kapıyı itin!Dialogue: 5,0:15:59.06,0:16:01.00,Main-207+,,0,0,0,,Kapı...Dialogue: 5,0:16:01.00,0:16:02.35,Main-207+,,0,0,0,,Kapı açılıyor!Dialogue: 5,0:16:02.35,0:16:04.77,Main-207+,,0,0,0,,Oimo'ya ne oldu?!Dialogue: 5,0:16:04.77,0:16:06.73,Main-207+,,0,0,0,,Biraz daha!Dialogue: 5,0:16:18.89,0:16:21.75,Main-207+,,0,0,0,,Kapıyı açtık!Dialogue: 1,0:16:21.75,0:16:21.79,Sign - Map,,0,0,0,,m -68 -20 l 69 -20 69 20 -68 20Dialogue: 1,0:16:21.79,0:16:21.83,Sign - Map,,0,0,0,,m -68 -20 l 69 -20 69 20 -68 20Dialogue: 1,0:16:21.83,0:16:21.87,Sign - Map,,0,0,0,,m -68 -20 l 69 -20 69 20 -68 20Dialogue: 1,0:16:21.87,0:16:21.91,Sign - Map,,0,0,0,,m -68 -20 l 69 -20 69 20 -68 20Dialogue: 1,0:16:21.91,0:16:21.96,Sign - Map,,0,0,0,,m -68 -20 l 69 -20 69 20 -68 20Dialogue: 1,0:16:21.96,0:16:22.00,Sign - Map,,0,0,0,,m -68 -20 l 69 -20 69 20 -68 20Dialogue: 1,0:16:22.00,0:16:22.04,Sign - Map,,0,0,0,,m -68 -20 l 69 -20 69 20 -68 20Dialogue: 1,0:16:22.04,0:16:22.08,Sign - Map,,0,0,0,,m -68 -20 l 69 -20 69 20 -68 20Dialogue: 1,0:16:22.08,0:16:22.12,Sign - Map,,0,0,0,,m -68 -20 l 69 -20 69 20 -68 20Dialogue: 1,0:16:22.12,0:16:22.16,Sign - Map,,0,0,0,,m -68 -20 l 69 -20 69 20 -68 20Dialogue: 1,0:16:22.16,0:16:22.21,Sign - Map,,0,0,0,,m -68 -20 l 69 -20 69 20 -68 20Dialogue: 1,0:16:22.21,0:16:22.25,Sign - Map,,0,0,0,,m -68 -20 l 69 -20 69 20 -68 20Dialogue: 1,0:16:22.25,0:16:22.29,Sign - Map,,0,0,0,,m -68 -20 l 69 -20 69 20 -68 20Dialogue: 1,0:16:22.29,0:16:22.33,Sign - Map,,0,0,0,,m -68 -20 l 69 -20 69 20 -68 20Dialogue: 1,0:16:22.33,0:16:22.37,Sign - Map,,0,0,0,,m -68 -20 l 69 -20 69 20 -68 20Dialogue: 1,0:16:22.37,0:16:22.41,Sign - Map,,0,0,0,,m -68 -20 l 69 -20 69 20 -68 20Dialogue: 1,0:16:22.41,0:16:22.46,Sign - Map,,0,0,0,,m -68 -20 l 69 -20 69 20 -68 20Dialogue: 1,0:16:22.46,0:16:22.50,Sign - Map,,0,0,0,,m -68 -20 l 69 -20 69 20 -68 20Dialogue: 1,0:16:22.50,0:16:22.54,Sign - Map,,0,0,0,,m -68 -20 l 69 -20 69 20 -68 20Dialogue: 1,0:16:22.54,0:16:22.58,Sign - Map,,0,0,0,,m -68 -20 l 69 -20 69 20 -68 20Dialogue: 1,0:16:22.58,0:16:22.62,Sign - Map,,0,0,0,,m -68 -20 l 69 -20 69 20 -68 20Dialogue: 1,0:16:22.62,0:16:22.66,Sign - Map,,0,0,0,,m -68 -20 l 69 -20 69 20 -68 20Dialogue: 1,0:16:22.66,0:16:22.71