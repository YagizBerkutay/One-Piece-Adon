Dialogue: 0,0:01:50.11,0:01:53.90,Title,,0,0,0,,{\pos(645,475)}Ohara, Dünya Hükümeti'ne Karşı{\fad(500,0)}
Dialogue: 0,0:01:58.84,0:02:00.46,Main,,0,0,0,,Ne oldu, Robin?
Dialogue: 0,0:02:01.71,0:02:04.18,Main,,0,0,0,,Annem buraya geldi mi?
Dialogue: 0,0:02:05.38,0:02:10.35,Main,,0,0,0,,Ne diyorsun sen? \NAnnenin Ohara'da olması mümkün değil.
Dialogue: 0,0:02:11.44,0:02:13.98,Flashbacks,,0,0,0,,Tüm bağlarımı koparmalıyım.
Dialogue: 0,0:02:13.98,0:02:16.36,Flashbacks,,0,0,0,,Bir suçlunun kızı olmasına izin veremem.
Dialogue: 0,0:02:17.15,0:02:19.36,Main,,0,0,0,,Böyle aniden ne oldu?
Dialogue: 0,0:02:21.06,0:02:23.40,Main,,0,0,0,,Sahi. Bu korkunç!
Dialogue: 0,0:02:23.40,0:02:26.05,Main,,0,0,0,,Adadaki bütün bilginleri yakalamak için...
Dialogue: 0,0:02:26.05,0:02:28.12,Main,,0,0,0,,...Denizci savaş gemileri adaya geliyor.
Dialogue: 0,0:02:28.12,0:02:31.51,Main,,0,0,0,,Şehirde panik var mı?
Dialogue: 0,0:02:32.96,0:02:36.94,Main,,0,0,0,,Bahsettiğin şey savaş gemileri değil, \NHükümet gemileri.
Dialogue: 0,0:02:36.96,0:02:39.70,Main,,0,0,0,,Görünüşe göre çoktan adaya demirlemişler.
Dialogue: 0,0:02:39.70,0:02:43.66,Main,,0,0,0,,Muhtemelen bu, soruşturmaların en serti olacak.
Dialogue: 0,0:02:43.66,0:02:47.13,Main,,0,0,0,,Dinle, Robin. Hükümet'ten kimselerle karşılaşırsan,...
Dialogue: 0,0:02:47.13,0:02:51.31,Main,,0,0,0,,...arkeolog olduğunu bilmelerine izin vermemelisin.
Dialogue: 0,0:02:51.31,0:02:55.76,Main,,0,0,0,,Çok küçük olduğun için \Nhiç kimse arkeolog olduğundan şüphelenmez.
Dialogue: 0,0:02:55.79,0:02:57.16,Main,,0,0,0,,Anladın mı?
Dialogue: 0,0:02:58.40,0:02:59.66,Main,,0,0,0,,Çekil!
Dialogue: 0,0:03:01.24,0:03:04.87,Main,,0,0,0,,Çalışmayı bırakın! \NEllerinizi havaya kaldırıp dışarı çıkın!
Dialogue: 0,0:03:04.87,0:03:06.99,Main,,0,0,0,,Bu biraz aşırı şiddet içermiyor mu?
Dialogue: 0,0:03:06.99,0:03:12.46,Main,,0,0,0,,Ohara araştırma merkezinin, Poneglifleri deşifre\Nederek muazzam bir suç işlediği düşünülmektedir.
Dialogue: 0,0:03:12.46,0:03:16.42,Main,,0,0,0,,Tam bir soruşturma yürüteceğiz.\NBu yüzden derhal dışarı çıkmalısınız!
Dialogue: 0,0:03:16.42,0:03:18.78,Main,,0,0,0,,Aceleci davranmayın.
Dialogue: 0,0:03:18.78,0:03:23.21,Main,,0,0,0,,Buradaki her şey, \Nanlayamayacağınız kadar çok değerlidir.
Dialogue: 0,0:03:23.21,0:03:25.24,Main,,0,0,0,,Bunu dinlemek zorunda değilim!
Dialogue: 0,0:03:25.24,0:03:26.32,Main,,0,0,0,,Onları dışarı götürün!
Dialogue: 0,0:03:26.32,0:03:27.40,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:03:27.40,0:03:29.33,Main,,0,0,0,,Yerli halka!
Dialogue: 0,0:03:29.33,0:03:35.35,Main,,0,0,0,,Bu adadaki bilginlerin, dünyanın yok olmasını\Nisteyen şeytanlar olduğundan şüphelenilmektedir.
Dialogue: 0,0:03:35.35,0:03:36.77,Main,,0,0,0,,Ne?! Niye?!
Dialogue: 0,0:03:36.77,0:03:41.40,Main,,0,0,0,,Onlar, tüm dünyada tanınmış olan\Nmükemmel bilginler ve bu adanın gururu!
Dialogue: 0,0:03:41.40,0:03:45.58,Main,,0,0,0,,Şu noktadan itibaren, \Ntüm ada detaylı bir soruşturmadan geçecek!
Dialogue: 0,0:03:45.58,0:03:48.85,Main,,0,0,0,,Bu nedenle arkeolojiyle alakası olmayanlar,...
Dialogue: 0,0:03:48.85,0:03:50.76,Main,,0,0,0,,...kimlikleriyle birlikte...
Dialogue: 0,0:03:50.76,0:03:53.87,Main,,0,0,0,,...batı kıyısındaki tahliye gemisine gitsin.
Dialogue: 0,0:03:53.87,0:03:55.98,Main,,0,0,0,,Tahliye gemisi? \NNiye bu kadar aşırıya kaçıyorlar?
Dialogue: 0,0:03:55.98,0:03:59.48,Main,,0,0,0,,Bilginlerle alakalıysa, bizim ilgimiz yok!
Dialogue: 0,0:03:59.48,0:04:01.94,Main,,0,0,0,,Adadan ayrılmaya gerek yok.
Dialogue: 0,0:04:01.94,0:04:04.81,Main,,0,0,0,,Sizi uyarmak bizim görevimizdi.
Dialogue: 0,0:04:04.81,0:04:09.67,Main,,0,0,0,,Bu tavsiyeyi görmezden gelmek istiyorsanız, \Nbaşınıza ne gelirse gelsin...
Dialogue: 0,0:04:09.67,0:04:12.77,Main,,0,0,0,,...ilgimiz dahilinde olmayacak.
Dialogue: 0,0:04:18.11,0:04:20.87,Main,,0,0,0,,– Şehirden uzaklaşın!\N– Batı kıyısına gidin!
Dialogue: 0,0:04:20.87,0:04:23.00,Main,,0,0,0,,Dünya Hükümeti bir şeyler planlıyor!
Dialogue: 0,0:04:25.95,0:04:28.68,Main,,0,0,0,,Ahhh! Vuruldum!
Dialogue: 0,0:04:28.68,0:04:31.68,Main,,0,0,0,,İş-İşim bitti! Gidiciyim, kahretsin!
Dialogue: 0,0:04:31.68,0:04:36.29,Main,,0,0,0,,Bunu üst yönetime rapor edin!\NŞef unvanı oğluma geçmeli!
Dialogue: 0,0:04:36.29,0:04:38.46,Main,,0,0,0,,Şef, iyi bakın.
Dialogue: 0,0:04:38.46,0:04:40.82,Main,,0,0,0,,Sadece paltonuzun kolunu delip geçti.
Dialogue: 0,0:04:40.82,0:04:42.87,Main,,0,0,0,,Ah, öyle mi?
Dialogue: 0,0:04:45.11,0:04:47.06,Main,,0,0,0,,Bir sonraki mermi ıskalamayacak.
Dialogue: 0,0:04:47.94,0:04:52.24,Main,,0,0,0,,Donanma hapishanesinden kaçan \Nbecerikli bir kaçakla burada karşılaşmak...
Dialogue: 0,0:04:52.24,0:04:56.53,Main,,0,0,0,,...ne büyük tesadüf, \Nsence de öyle değil mi Nico Olvia?
Dialogue: 0,0:04:56.53,0:05:00.64,Main,,0,0,0,,Ohara'daki bilginlerle olan ilişkisini hiçbir zaman\Nkabul etmeyen kadın, burada ortaya çıkıyor.
Dialogue: 0,0:05:00.64,0:05:06.08,Main,,0,0,0,,Sanki burasının \Nmemleketi olduğunu kabulleniyormuş gibi.
Dialogue: 0,0:05:06.08,0:05:10.55,Main,,0,0,0,,Adadaki bilim adamlarını\Nsenin suçunun aynısıyla yaftalama işi yürürlükte.
Dialogue: 0,0:05:10.55,0:05:15.27,Main,,0,0,0,,Burada olmam kanıt olarak gösterilemez.
Dialogue: 0,0:05:15.27,0:05:21.07,Main,,0,0,0,,Her türlü mazereti hazırlamış olmalısın.\NAkıllı bir kadınsın.
Dialogue: 0,0:05:21.07,0:05:23.02,Main,,0,0,0,,Ama sorun değil.
Dialogue: 0,0:05:23.02,0:05:26.61,Main,,0,0,0,,Ohara'yla olan ilişkinin artık önemi yok.
Dialogue: 0,0:05:26.61,0:05:29.45,Main,,0,0,0,,Bu adanın her köşesini didik didik edersek,...
Dialogue: 0,0:05:29.45,0:05:33.55,Main,,0,0,0,,...Poneglifler üzerinde çalıştığınıza dair \Nhemen bir kanıt buluruz.
Dialogue: 0,0:05:33.55,0:05:37.41,Main,,0,0,0,,Hükümet, bu ihtimalin %100 olduğundan emin.
Dialogue: 0,0:05:37.41,0:05:42.49,Main,,0,0,0,,Hükümet, altı yıldır orada burada kaçıp duran...
Dialogue: 0,0:05:42.49,0:05:45.70,Main,,0,0,0,,...sizi yakalamayı sadece \Nküçük bir olay olarak gördü.
Dialogue: 0,0:05:45.70,0:05:49.89,Main,,0,0,0,,Dünyanın herhangi bir yerinde, \Nne zaman bir Poneglif araştırmacısı yakalasalar,...
Dialogue: 0,0:05:49.89,0:05:53.39,Main,,0,0,0,,...hep Ohara'yla olan bağlantısını araştırıyorlar.
Dialogue: 0,0:05:53.39,0:05:55.39,Main,,0,0,0,,Niye olduğunu anlıyor musun?
Dialogue: 0,0:05:56.36,0:05:58.85,Main,,0,0,0,,Yoksa... Ohara'yı örnek haline getirmek için mi?
Dialogue: 0,0:05:58.85,0:06:03.62,Main,,0,0,0,,Aynen öyle. Arkeoloji'nin kutsal mekanı \NOhara ezilseydi, bilimsel dünyada...
Dialogue: 0,0:06:03.62,0:06:05.32,Main,,0,0,0,,...büyük bir curcunaya sebep olurdu.
Dialogue: 0,0:06:05.32,0:06:11.27,Main,,0,0,0,,Boş Yüzyıl'ın peşinden gitmenin\Nsonuçlarını dünyaya gösterebileceğiz.
Dialogue: 0,0:06:11.27,0:06:15.78,Main,,0,0,0,,O zaman beklemede olan, \NKarargâh'tan gelme savaş gemileri...
Dialogue: 0,0:06:15.78,0:06:19.87,Main,,0,0,0,,Hey hey... ne kadarını biliyorsun?
Dialogue: 0,0:06:19.87,0:06:21.08,Main,,0,0,0,,Doğru.
Dialogue: 0,0:06:21.08,0:06:25.42,Main,,0,0,0,,Tek bir suçlunun kaçmamasını sağlamak için oradalar.
Dialogue: 0,0:06:25.42,0:06:29.53,Main,,0,0,0,,Ama formalite icabı, \Nsuçlu olup olmadıklarını teyit etmeliyiz.
Dialogue: 0,0:06:29.53,0:06:31.84,Main,,0,0,0,,Sonuçta biz korsan değiliz.
Dialogue: 0,0:06:31.84,0:06:36.18,Main,,0,0,0,,Bu yüzden bu adada derin bir araştırma yapmak ve\Nbu olayla ilgisi olmayanları...
Dialogue: 0,0:06:36.18,0:06:40.43,Main,,0,0,0,,...tahliye etmek için bunca yolu geldim.
Dialogue: 0,0:06:40.43,0:06:43.06,Main,,0,0,0,,Evet, bu yüzden buradayım.
Dialogue: 0,0:06:43.06,0:06:44.47,Main,,0,0,0,,Bitirin işini.
Dialogue: 0,0:06:56.29,0:06:59.21,Main,,0,0,0,,Durun! Bu kitaplar insanlığın hazinesi!
Dialogue: 0,0:06:59.21,0:07:01.08,Main,,0,0,0,,Bu adam hala orada mı?! Çıkarın dışarı!
Dialogue: 0,0:07:01.08,0:07:03.29,Main,,0,0,0,,– Gel!\N– Kahretsin! Sizi pislikler!
Dialogue: 0,0:07:03.29,0:07:07.27,Main,,0,0,0,,Bir yere saklanmış olmalı! \NOnu kesinlikle bulmalısınız!
Dialogue: 0,0:07:07.27,0:07:11.27,Captions,,0,0,0,,{\fs36\pos(180,421)}Ohara'nın Kuzeybatı Kıyısı\NSaul'un Konumu{\fad(500,0)}
Dialogue: 0,0:07:11.87,0:07:13.89,Thoughts,,0,0,0,,{\i1}Bu korkunç.{\i0}
Dialogue: 0,0:07:13.89,0:07:19.31,Thoughts,,0,0,0,,{\i1}Görebildiğim kadarıyla yaklaşan savaş gemileri var!{\i0}
Dialogue: 0,0:07:19.97,0:07:21.85,Main,,0,0,0,,Hepsi bu kadar mı?
Dialogue: 0,0:07:21.85,0:07:25.28,Main,,0,0,0,,Tamam, tüm bilginleri buraya toplayın!
Dialogue: 0,0:07:25.28,0:07:27.73,Main,,0,0,0,,Bakın, bilginler yakalanmış.
Dialogue: 0,0:07:27.73,0:07:29.39,Main,,0,0,0,,Ne yapmışlar Allah aşkına?
Dialogue: 0,0:07:29.39,0:07:32.09,Main,,0,0,0,,Dünyayı yok etmek için araştırma mı yapıyorlarmış?
Dialogue: 0,0:07:32.09,0:07:33.24,Main,,0,0,0,,Yalan olmalı!
Dialogue: 0,0:07:33.24,0:07:35.31,Main,,0,0,0,,Tahliye gemisi nerede?!
Dialogue: 0,0:07:35.31,0:07:37.25,Main,,0,0,0,,Batı kıyısında! Çabuk!
Dialogue: 0,0:07:37.25,0:07:39.87,Main,,0,0,0,,Hemen oraya gidin! Batı kıyısına!
Dialogue: 0,0:07:39.87,0:07:43.54,Main,,0,0,0,,Robin. Görünüşe bakılırsa bir tahliye gemisi var.
Dialogue: 0,0:07:43.54,0:07:46.28,Main,,0,0,0,,Artık Hükümet'in ne yapmayı planladığını bilmiyoruz.
Dialogue: 0,0:07:46.28,0:07:47.97,Main,,0,0,0,,Sen de hemen oraya git.
Dialogue: 0,0:07:47.97,0:07:51.93,Main,,0,0,0,,Olmaz! Gemiye binsem bile,\Niçinde iyi kimseler yok ki!
Dialogue: 0,0:07:51.93,0:07:53.61,Main,,0,0,0,,Sizinle burada kalacağım!
Dialogue: 0,0:07:53.61,0:07:56.05,Main,,0,0,0,,– Robin...\N– Ama ben de herkesle aynıyım!
Dialogue: 0,0:07:56.05,0:07:57.76,Main,,0,0,0,,Boşver, git artık!
Dialogue: 0,0:08:00.23,0:08:02.15,Main,,0,0,0,,Nasılsınız beyler?
Dialogue: 0,0:08:02.15,0:08:04.57,Main,,0,0,0,,Geldiğiniz için teşekkürler Şef!
Dialogue: 0,0:08:04.57,0:08:10.74,Main,,0,0,0,,Her neyse, burada asla \Nvahşi bir hayvanla karşılaşmayı beklemiyordum.
Dialogue: 0,0:08:14.00,0:08:17.20,Main,,0,0,0,,Neredeyse öldürülüyordum.
Dialogue: 0,0:08:17.20,0:08:18.50,Thoughts,,0,0,0,,{\i1}Olvia...!
Dialogue: 0,0:08:18.50,0:08:20.45,Thoughts,,0,0,0,,{\i1}Olvia-san...!
Dialogue: 0,0:08:20.45,0:08:24.15,Main,,0,0,0,,Pekâla, iyi dinleyin. Bu kadın bir kaçak.
Dialogue: 0,0:08:24.15,0:08:28.88,Main,,0,0,0,,Grubu, antik yazıtları \Ndeşifre etme suçundan ötürü yok edildi.
Dialogue: 0,0:08:28.88,0:08:32.06,Main,,0,0,0,,Ancak henüz asıl can alıcı noktasını bilmiyoruz.
Dialogue: 0,0:08:32.06,0:08:38.38,Main,,0,0,0,,Ama bu kadınla bir bağlantınız varsa, \Nişler daha da kolaylaşır.
Dialogue: 0,0:08:40.24,0:08:42.74,Thoughts,,0,0,0,,{\i1}Bunu bir kadına yapmak korkunç bir şey.{\i0}
Dialogue: 0,0:08:42.74,0:08:46.59,Main,,0,0,0,,Robin, tahliye gemisine git. Çabuk!
Dialogue: 0,0:08:46.59,0:08:48.18,Thoughts,,0,0,0,,{\i1}Robin...
Dialogue: 0,0:08:52.82,0:08:54.42,Thoughts,,0,0,0,,{\i1}Robin...!
Dialogue: 0,0:08:57.09,0:08:59.63,Thoughts,,0,0,0,,{\i1}Ne kadar da...{\i0}
Dialogue: 0,0:09:03.68,0:09:06.22,Thoughts,,0,0,0,,{\i1}...büyümüşsün.{\i0}
Dialogue: 0,0:09:06.93,0:09:09.19,Thoughts,,0,0,0,,{\i1}Olvia...
Dialogue: 0,0:09:12.94,0:09:14.51,Main,,0,0,0,,N-Ne yaptı bu?!
Dialogue: 0,0:09:14.51,0:09:16.89,Main,,0,0,0,,Kütüphanenin ne olduğunu sanıyor bu adam?!
Dialogue: 0,0:09:16.89,0:09:19.48,Main,,0,0,0,,Ne tür bir şiddete başvuruyorsunuz böyle?!
Dialogue: 0,0:09:19.48,0:09:22.57,Main,,0,0,0,,Vay... epey gösterişli oldu.
Dialogue: 0,0:09:24.70,0:09:26.63,Main,,0,0,0,,{\i1}Merhaba? Şef-dono mu?!{\i0}
Dialogue: 0,0:09:26.73,0:09:28.16,Main,,0,0,0,,Evet, benim.
Dialogue: 0,0:09:28.16,0:09:29.86,Main,,0,0,0,,{\i1}Onu bulduk!{\i0}
Dialogue: 0,0:09:29.86,0:09:31.45,Main,,0,0,0,,{\i1}Bodrum katta,...{\i0}
Dialogue: 0,0:09:31.45,0:09:33.90,Main,,0,0,0,,{\i1}...Ponegliflere benzer büyük bir taş var.{\i0}
Dialogue: 0,0:09:33.90,0:09:36.46,Main,,0,0,0,,{\i1}Ayrıca antik harfler üzerinde araştırma\Nyapıldığına dair açık delil bulduk.{\i0}
Dialogue: 0,0:09:36.46,0:09:38.11,Main,,0,0,0,,Tamam, iyi iş.
Dialogue: 0,0:09:41.82,0:09:44.32,Main,,0,0,0,,Pekâla, Ohara bilginleri!
Dialogue: 0,0:09:44.32,0:09:48.29,Main,,0,0,0,,Mahrumiyetinize karar verildi!
Dialogue: 0,0:09:48.67,0:09:50.35,Main,,0,0,0,,Gerçekten çok kötü.
Dialogue: 0,0:09:50.35,0:09:56.15,Main,,0,0,0,,Bugün, dünyanın en iyi arkeologları\Nhayatlarını kaybedecek.
Dialogue: 0,0:10:00.05,0:10:04.01,Main,,0,0,0,,Şuna bakın. Ne hayal kırıklığı ama.\NBuradaki tek işim buydu!
Dialogue: 0,0:10:04.01,0:10:06.28,Main,,0,0,0,,Sadece Gorosei'ye* rapor vermemiz lazım.
Dialogue: 0,0:10:06.28,0:10:07.63,Main,,0,0,0,,Anlaşıldı.
Dialogue: 0,0:10:09.06,0:10:12.30,Main,,0,0,0,,Profesör, herkes öldürülecek mi? Yalan, değil mi?
Dialogue: 0,0:10:12.30,0:10:14.99,Main,,0,0,0,,Gerçekten sadece antik yazılar okunduğu için mi? Niye?
Dialogue: 0,0:10:14.99,0:10:17.16,Main,,0,0,0,,Seni aptal küçük velet!
Dialogue: 0,0:10:17.19,0:10:23.73,Main,,0,0,0,,Onların amacı, güçlü bir silahı uyandırmak ve \Nbir sürü insanı öldürmek!
Dialogue: 0,0:10:23.73,0:10:26.26,Main,,0,0,0,,Yalan! Hiç kimse böyle yapmayı düşünmüyor!
Dialogue: 0,0:10:26.26,0:10:30.80,Main,,0,0,0,,Robin, lütfen dur. \NHükümet'in aşağılık kuklası bunu asla anlayamazdı.
Dialogue: 0,0:10:30.80,0:10:31.75,Main,,0,0,0,,NE?!
Dialogue: 0,0:10:31.75,0:10:35.40,Main,,0,0,0,,Hükümet'in korktuğu şey gerçekten silah mı?
Dialogue: 0,0:10:35.60,0:10:36.76,Main,,0,0,0,,– Profesör!\N– Profesör Clover!
Dialogue: 0,0:10:36.76,0:10:38.51,Main,,0,0,0,,Hatta bekliyorlar, Şef.
Dialogue: 0,0:10:38.51,0:10:39.55,Main,,0,0,0,,Tamam.
Dialogue: 0,0:10:39.55,0:10:41.48,Main,,0,0,0,,Pekâla.
Dialogue: 0,0:10:41.48,0:10:46.18,Main,,0,0,0,,Ölmeden önce Gorousei'yle,\Ndünyanın zirvesindekilerle konuşmama izin verin.
Dialogue: 0,0:10:46.18,0:10:49.75,Main,,0,0,0,,Biz Ohara bilginleri uzun bir süredir \Naraştırmalarımızı sürdürüyoruz ve...
Dialogue: 0,0:10:49.75,0:10:51.69,Main,,0,0,0,,...araştırmamız henüz bitmemiş olsa da...
Dialogue: 0,0:10:51.69,0:10:54.02,Main,,0,0,0,,...Boş Yüzyıl hakkında bir hipotez oluşturduk.
Dialogue: 0,0:10:54.02,0:10:56.44,Main,,0,0,0,,Bu yüzden onlara bildirmek istiyorum.
Dialogue: 0,0:10:57.08,0:10:58.56,Main,,0,0,0,,Saçma meseleler...
Dialogue: 0,0:10:58.56,0:10:59.91,Main,,0,0,0,,– Hey.\N– Evet.
Dialogue: 0,0:10:59.91,0:11:02.37,Main,,0,0,0,,Robin, hemen buradan uzaklaş.
Dialogue: 0,0:11:02.37,0:11:05.37,Main,,0,0,0,,Söylediğim şeyi duyarsan, suç olacak.
Dialogue: 0,0:11:06.24,0:11:08.04,Main,,0,0,0,,Profesör...
Dialogue: 0,0:11:08.04,0:11:11.10,Main,,0,0,0,,Hey, görünüşe göre bilginlerin suçu doğrulanmış.
Dialogue: 0,0:11:11.10,0:11:12.46,Main,,0,0,0,,Gerçekten mi?!
Dialogue: 0,0:11:12.46,0:11:16.46,Main,,0,0,0,,Hey! Batı kıyısına yaklaşan Denizci savaş gemileri var!
Dialogue: 0,0:11:16.46,0:11:20.27,Main,,0,0,0,,Bir şey olmak üzere! Hemen tahliye gemisine!
Dialogue: 0,0:11:20.27,0:11:21.91,Main,,0,0,0,,N-Ne...?!
Dialogue: 0,0:11:21.91,0:11:23.72,Main,,0,0,0,,Bu bir dev!
Dialogue: 0,0:11:26.61,0:11:29.56,Main,,0,0,0,,Neredesin, Robin?!
Dialogue: 0,0:11:29.56,0:11:33.66,Main,,0,0,0,,Hemen bu adadan kaçmalısın!
Dialogue: 0,0:11:38.38,0:11:41.37,Main,,0,0,0,,Yıkım Çağrısı isteği henüz yapılmadı mı?
Dialogue: 0,0:11:41.37,0:11:43.79,Main,,0,0,0,,Hala beklemedeyiz.
Dialogue: 0,0:11:43.79,0:11:45.79,Main,,0,0,0,,Çabuk!
Dialogue: 0,0:11:45.79,0:11:47.83,Main,,0,0,0,,Tahliye gemisine kaçın!
Dialogue: 0,0:11:50.80,0:11:53.80,Main,,0,0,0,,Poneglif denilen şey bu mu?
Dialogue: 0,0:11:53.80,0:11:58.26,Main,,0,0,0,,Evet. Ne yaparsak yapalım, \Netrafına patlayıcı yerleştirmek bile ona zarar vermez.
Dialogue: 0,0:11:58.26,0:12:03.73,Main,,0,0,0,,Ne tüyler ürpertici bir taş... Bunların dünyanın dört bir yanına dağıldığına inanamıyorum...
Dialogue: 0,0:12:03.73,0:12:05.05,Main,,0,0,0,,{\i1}Öyle mi?{\i0}
Dialogue: 0,0:12:05.05,0:12:07.63,Main,,0,0,0,,Evet. Bu büyük bir suç.
Dialogue: 0,0:12:08.35,0:12:11.80,Main,,0,0,0,,Kanıtlara el koyduğumuza göre, \Nemirlerinizi yerine getireceğiz.
Dialogue: 0,0:12:11.80,0:12:16.14,Main,,0,0,0,,{\i1}Yapacak bir şey yok. Gerçekten içler acısı bir sonuç...{\i0}
Dialogue: 0,0:12:16.14,0:12:20.51,Main,,0,0,0,,{\i1}...ama dünyanın kanununu yıktılar. \NBunu onların yanına bırakamayız.{\i0}
Dialogue: 0,0:12:20.51,0:12:24.36,Main,,0,0,0,,Yeterince duydum. \NKüçük konuşmanıza son verin, Gorousei.
Dialogue: 0,0:12:25.32,0:12:29.77,Main,,0,0,0,,Ne kadar kabasın, seni aşağılık! \NDünyanın liderleriyle konuşuyorsun!
Dialogue: 0,0:12:29.77,0:12:33.64,Main,,0,0,0,,{\i1}Demek sen arkeoloji otoritesisin,\NOhara'lı Profesör Clover.{\i0}
Dialogue: 0,0:12:34.39,0:12:37.79,Main,,0,0,0,,{\i1}Dünyanın kültürel mirasına büyük katkı sağlayan birisin.{\i0}
Dialogue: 0,0:12:37.82,0:12:39.11,Main,,0,0,0,,{\i1}Adını iyi biliyorum.
Dialogue: 0,0:12:39.11,0:12:42.31,Main,,0,0,0,,{\i1}Senin gibi bir adamın \Ndoğru yoldan ayrıldığını düşünmek...{\i0}
Dialogue: 0,0:12:42.31,0:12:45.32,Main,,0,0,0,,Geçmiş, tüm insanlığa aittir.
Dialogue: 0,0:12:46.02,0:12:52.53,Main,,0,0,0,,Hiç kimsenin, anlatılmamış tarihi \Nbilme arzusunu engellemeye hakkı yoktur.
Dialogue: 0,0:12:52.53,0:12:53.46,Main,,0,0,0,,Profesör...
Dialogue: 0,0:12:53.46,0:12:57.56,Main,,0,0,0,,{\i1}Bir kimse Poneglifleri okursa,\Ndünyaya büyük tehlike getirecek olan antik silahların...{\i0}
Dialogue: 0,0:12:57.56,0:12:59.80,Main,,0,0,0,,{\i1}...uyanma olasılığı ortaya çıkacak.{\i0}
Dialogue: 0,0:13:00.92,0:13:02.76,Main,,0,0,0,,{\i1}Kötü niyetleriniz olmasa bile,...{\i0}
Dialogue: 0,0:13:02.76,0:13:06.66,Main,,0,0,0,,{\i1}...bir kimse onları kötü son için kullanmayı arzularsa,\Ndurum aynı olacak.{\i0}
Dialogue: 0,0:13:07.10,0:13:11.31,Main,,0,0,0,,Geçmiş ne olursa olsun, \Ntarihi insanların elleriyle yapılmış olduğu sürece,...
Dialogue: 0,0:13:11.31,0:13:13.26,Main,,0,0,0,,...hepsini kabul etme sorumluluğumuz var.
Dialogue: 0,0:13:13.26,0:13:15.56,Main,,0,0,0,,Bir kimse korkmadan bunu anlayabilirse,...
Dialogue: 0,0:13:15.56,0:13:18.22,Main,,0,0,0,,...ne olursa olsun \Nkarşı tedbirleri almak mümkün olacak.
Dialogue: 0,0:13:18.22,0:13:19.68,Main,,0,0,0,,{\i1}İdealist bir iddia.{\i0}
Dialogue: 0,0:13:19.68,0:13:25.41,Main,,0,0,0,,Öyle mi acaba? İmkansız olması fikri, \Naçıkça amacınıza uymuyor mu?
Dialogue: 0,0:13:25.41,0:13:28.44,Main,,0,0,0,,Günümüz dünyasında kalmış olan doğrular içerisinde......
Dialogue: 0,0:13:28.44,0:13:33.07,Main,,0,0,0,,...en çok bilmek istediklerimiz,\NPonegliflere kazınmış mesajlar...
Dialogue: 0,0:13:33.07,0:13:34.87,Main,,0,0,0,,...ve var olmalarının sebebidir.
Dialogue: 0,0:13:34.87,0:13:39.02,Main,,0,0,0,,Eski insanlar, \Nmesajlarını geleceğe aktarmak için,...
Dialogue: 0,0:13:39.02,0:13:41.96,Main,,0,0,0,,...niye onları sert taşa kazıdı?
Dialogue: 0,0:13:41.96,0:13:44.37,Main,,0,0,0,,Tarihi, kırılmaz taşlara kazıdılar...
Dialogue: 0,0:13:44.37,0:13:46.63,Main,,0,0,0,,ve tüm dünyaya dağıttılar.
Dialogue: 0,0:13:46.63,0:13:50.38,Main,,0,0,0,,Kâğıda veya kitaplara yazdıklarında...
Dialogue: 0,0:13:50.38,0:13:54.86,Main,,0,0,0,,...mesajlarının yok olacağından \Nkorktukları için değil mi?
Dialogue: 0,0:13:54.86,0:13:58.76,Main,,0,0,0,,Kısacası bu, Poneglifleri arkada bırakan insanların,...
Dialogue: 0,0:13:58.76,0:14:00.86,Main,,0,0,0,,...açık bir düşmanı olduğunun kanıtı.
Dialogue: 0,0:14:02.70,0:14:06.17,Main,,0,0,0,,Ne demeye çalışıyorsun, Profesör Clover?
Dialogue: 0,0:14:06.17,0:14:11.22,Main,,0,0,0,,Bu insanların bir düşman tarafından yenildiği\Nşeklindeki diğer olasılığı düşünürsek,...
Dialogue: 0,0:14:11.22,0:14:15.53,Main,,0,0,0,,...o düşman yaşamış ve tarihte kalmış olmalı.
Dialogue: 0,0:14:16.53,0:14:22.97,Main,,0,0,0,,Ne tuhaftır ki, \N800 yıl önce Boş Yüzyıl nihayet sona ererken,...
Dialogue: 0,0:14:22.97,0:14:27.69,Main,,0,0,0,,...Dünya Hükümeti olarak bilinen organizasyon kuruldu.
Dialogue: 0,0:14:30.52,0:14:35.65,Main,,0,0,0,,Yenilen insanların düşmanı bugünkü Dünya Hükümeti'yse,...
Dialogue: 0,0:14:35.65,0:14:38.89,Main,,0,0,0,,...Boş Yüzyıl'ın, \NDünya Hükümeti'nin elleri tarafından silinmiş...
Dialogue: 0,0:14:38.89,0:14:42.62,Main,,0,0,0,,...uygunsuz bir tarih olduğu sonucuna varabiliriz.
Dialogue: 0,0:14:42.62,0:14:48.33,Main,,0,0,0,,O zamandan kalma tarihsel dökümanları okuyarak\Nve belirli sayıda Poneglifi deşifre ederek,...
Dialogue: 0,0:14:48.33,0:14:52.30,Main,,0,0,0,,...çok geçmeden bir krallığın varlığını farkettik.
Dialogue: 0,0:14:52.30,0:14:58.11,Main,,0,0,0,,Bu metinlerin bize açıkladığı şey, \Ngüçlü bir krallığın varlığıydı.
Dialogue: 0,0:14:58.11,0:15:00.95,Main,,0,0,0,,Bir zamanlar muazzam gücünden gurur duymuş...
Dialogue: 0,0:15:00.95,0:15:05.34,Main,,0,0,0,,...ama o ülkeyle ilgili bütün bilgiler tamamen silinmiş.
Dialogue: 0,0:15:05.34,0:15:11.51,Main,,0,0,0,,Dünya Hükümeti diye bahsettikleri \Nmüttefik bir ulusun eylemlerini farkettiklerinde,...
Dialogue: 0,0:15:11.51,0:15:17.32,Main,,0,0,0,,...fikirlerini geleceğe aktarmak için\Ngerçeği taşlara kazımış olmaları muhtemel.
Dialogue: 0,0:15:17.32,0:15:21.28,Main,,0,0,0,,O taşlar, bugüne kadar \Ndünyada kalmış olan Poneglifler'dir.
Dialogue: 0,0:15:22.03,0:15:25.09,Main,,0,0,0,,Anlıyorum. Bu cüretkâr bir hipotez.
Dialogue: 0,0:15:25.09,0:15:28.75,Main,,0,0,0,,{\i1}Antik silahların dünyayı zorlayacağı kesin.{\i0}
Dialogue: 0,0:15:28.75,0:15:34.56,Main,,0,0,0,,Ama daha da önemlisi, o ülkenin varlığının ve \Nfikirlerinin gerçek tarihle birlikte...
Dialogue: 0,0:15:34.56,0:15:39.84,Main,,0,0,0,,...ortaya çıkarılmış olması siz Dünya Hükümeti için \Ndaha fazla tehdit oluşturmuyor mu?
Dialogue: 0,0:15:41.60,0:15:44.96,Main,,0,0,0,,Bu tehditin doğasını açığa çıkarmalıyız...
Dialogue: 0,0:15:44.96,0:15:50.60,Main,,0,0,0,,...ama her şeyi çözmenin anahtarı, \Nbir zamanların görkemli krallığının adı olan...
Dialogue: 0,0:15:52.24,0:15:53.44,Main,,0,0,0,,ÖLDÜRÜN ONU!
Dialogue: 0,0:16:03.87,0:16:06.20,Main,,0,0,0,,Profesör!
Dialogue: 0,0:16:08.94,0:16:10.66,Main,,0,0,0,,{\i1}Ohara,...{\i0}
Dialogue: 0,0:16:13.41,0:16:15.38,Main,,0,0,0,,– Pislikler!\N– Bu ne cüret?!
Dialogue: 0,0:16:15.38,0:16:18.21,Main,,0,0,0,,Profesör Clover!
Dialogue: 0,0:16:18.22,0:16:20.97,Main,,0,0,0,,{\i1}...çok fazlasını öğrenmiş.{\i0}
Dialogue: 0,0:16:22.61,0:16:25.17,Main,,0,0,0,,Saldırı emrini verin.
Dialogue: 0,0:16:26.00,0:16:27.83,Main,,0,0,0,,Kıpırdamayın, ifritler!
Dialogue: 0,0:16:27.83,0:16:30.34,Main,,0,0,0,,{\i1}Kimsenin kaçmasına izin vermemelisiniz.{\i0}
Dialogue: 0,0:16:37.32,0:16:42.66,Main,,0,0,0,,Öyleyse Amiral Sengoku'nun \Nbana verdiği Altın Den Den Mushi'yle,...
Dialogue: 0,0:16:42.66,0:16:43.72,Main,,0,0,0,,Profesör?
Dialogue: 0,0:16:43.72,0:16:45.34,Main,,0,0,0,,Robin...
Dialogue: 0,0:16:45.34,0:16:49.11,Main,,0,0,0,,Aptal. Burada olmamalısın. Kaç!
Dialogue: 0,0:16:49.11,0:16:51.33,Main,,0,0,0,,...Yıkım Çağrısı'nı başlatacağım!
Dialogue: 0,0:16:51.33,0:16:53.25,Main,,0,0,0,,Bu işi bitirin.
Dialogue: 0,0:16:54.08,0:16:56.53,Main,,0,0,0,,Bir şey yaptı! O adam...
Dialogue: 0,0:16:57.62,0:17:00.48,Main,,0,0,0,,Hemen tahliye gemisine git, Robin!
Dialogue: 0,0:17:00.48,0:17:02.68,Main,,0,0,0,,Hayır! Yalnız olmak istemiyorum!
Dialogue: 0,0:17:02.68,0:17:06.08,Main,,0,0,0,,Aptalca şeyler söyleme. Böyle bir zamanda...
Dialogue: 0,0:17:06.88,0:17:08.52,Thoughts,,0,0,0,,{\i1}Robin...
Dialogue: 0,0:17:11.89,0:17:14.38,Main,,0,0,0,,Yıkım Çağrısı isteği geldi!{\an8}
Dialogue: 0,0:17:11.89,0:17:14.38,Captions,,0,0,0,,{\pos(639,438)}Altın Den Den Mushi için \NGümüş Den Den Mushi Alıcısı{\fad(400,0)}
Dialogue: 0,0:17:14.38,0:17:18.09,Main,,0,0,0,,Tüm gemiler, hazır olun! Saldırı için hazırlanın!
Dialogue: 0,0:17:20.51,0:17:21.83,Main,,0,0,0,,Hey!
Dialogue: 0,0:17:21.83,0:17:22.97,Main,,0,0,0,,Bu...
Dialogue: 0,0:17:23.95,0:17:25.72,Main,,0,0,0,,Her Şeyi Bilen Ağaç yanıyor!
Dialogue: 0,0:17:26.48,0:17:29.14,Main,,0,0,0,,Hey, bu ne içindi, Dünya Hükümeti?!
Dialogue: 0,0:17:29.14,0:17:32.90,Main,,0,0,0,,Başımızı kesmekle yetinmelisiniz!
Dialogue: 0,0:17:32.90,0:17:36.65,Main,,0,0,0,,Bilmiyorum. \NDeminki patlama yangın başlatmış olmalı.
Dialogue: 0,0:17:38.70,0:17:40.32,Main,,0,0,0,,Bizi ahmak yerine koyma!
Dialogue: 0,0:17:40.32,0:17:43.18,Main,,0,0,0,,Oradaki belgelerin \Nne kadar önemli olduğunu bilmiyorsunuz!
Dialogue: 0,0:17:43.18,0:17:44.66,Main,,0,0,0,,Hey! Kıpırdama!
Dialogue: 0,0:17:44.66,0:17:47.12,Main,,0,0,0,,Sorun değil. Artık silahlara gerek yok.
Dialogue: 0,0:17:48.41,0:17:50.79,Main,,0,0,0,,Hükümet memurları geri çekiliyor.
Dialogue: 0,0:17:52.19,0:17:54.28,Main,,0,0,0,,Kitaplar. Çabuk olun!
Dialogue: 0,0:17:55.83,0:17:58.04,Main,,0,0,0,,Kütüphanedeki yangını söndürün!
Dialogue: 0,0:18:08.29,0:18:10.31,Main,,0,0,0,,Çabuk! Suyu buraya verin!
Dialogue: 0,0:18:12.06,0:18:14.65,Main,,0,0,0,,Kitapları kütüphanenin dışına taşıyın!
Dialogue: 0,0:18:28.50,0:18:30.45,Main,,0,0,0,,O kadını getiriyoruz.
Dialogue: 0,0:18:31.13,0:18:32.23,Main,,0,0,0,,Gel.
Dialogue: 0,0:18:33.81,0:18:38.05,Main,,0,0,0,,Hala sadece onun bildiği bilgiler var.
Dialogue: 0,0:18:38.05,0:18:39.97,Main,,0,0,0,,Burada ölmesine izin veremeyiz.
Dialogue: 0,0:18:44.04,0:18:45.78,Flashbacks,,0,0,0,,Anne!
Dialogue: 0,0:18:49.39,0:18:54.18,Thoughts,,0,0,0,,{\i1}Robin. Lütfen hemen kaç.{\i0}
Dialogue: 0,0:18:54.18,0:18:56.36,Thoughts,,0,0,0,,{\i1}Kesinlikle ölmemelisin.{\i0}
Dialogue: 0,0:18:56.94,0:18:58.76,Flashbacks,,0,0,0,,Anne, anne!
Dialogue: 0,0:19:02.31,0:19:04.57,Main,,0,0,0,,Robin, çabuk!
Dialogue: 0,0:19:04.57,0:19:06.43,Main,,0,0,0,,Hemen buradan git.
Dialogue: 0,0:19:10.24,0:19:12.25,Main,,0,0,0,,– Robin{\i1}-chan{\i1}!{\i0}\N– Robin!
Dialogue: 0,0:19:20.11,0:19:23.22,Main,,0,0,0,,Sen... annem misin?
Dialogue: 0,0:19:28.26,0:19:32.01,Flashbacks,,0,0,0,,Olvia, biniyor musun yoksa binmiyor musun?
Dialogue: 0,0:19:32.01,0:19:33.59,Flashbacks,,0,0,0,,Anne!
Dialogue: 0,0:19:33.59,0:19:38.52,Flashbacks,,0,0,0,,– Onu tutuyorum, hemen git!\N– Anne, gitme! Anne!
Dialogue: 0,0:19:38.52,0:19:41.27,Flashbacks,,0,0,0,,Anne! Anne!
Dialogue: 0,0:19:41.27,0:19:43.40,Flashbacks,,0,0,0,,{\i1}Üzgünüm, Robin.{\i0}
Dialogue: 0,0:19:43.40,0:19:46.48,Flashbacks,,0,0,0,,{\i1}Artık kendime anne diyemem.{\i0}
Dialogue: 0,0:19:46.48,0:19:51.72,Flashbacks,,0,0,0,,{\i1}Şimdi affedilemem. Bir anne olamam.{\i0}
Dialogue: 0,0:20:00.34,0:20:02.96,Flashbacks,,0,0,0,,– Canavar!\N– Canavar!
Dialogue: 0,0:20:02.96,0:20:05.71,Flashbacks,,0,0,0,,Annesi tarafından terkedilmiş!
Dialogue: 0,0:20:05.71,0:20:08.38,Flashbacks,,0,0,0,,Robin, o kızımın elbisesi!
Dialogue: 0,0:20:08.38,0:20:11.05,Flashbacks,,0,0,0,,Üzgünüm teyze! \NSadece denemek istemiştim!
Dialogue: 0,0:20:11.05,0:20:14.27,Flashbacks,,0,0,0,,Beleşçi olmasına rağmen çok yiyor.
Dialogue: 0,0:20:22.73,0:20:24.38,Main,,0,0,0,,Sen...
Dialogue: 0,0:20:26.88,0:20:28.61,Main,,0,0,0,,...annem misin?
Dialogue: 0,0:20:33.54,0:20:38.01,Main,,0,0,0,,Ne oldu? Çocuğun mu var?
Dialogue: 0,0:20:39.34,0:20:40.54,Main,,0,0,0,,Hayır.
Dialogue: 0,0:20:41.46,0:20:42.91,Main,,0,0,0,,Olvia{\i1}-san{\i0}...
Dialogue: 0,0:20:43.42,0:20:45.28,Main,,0,0,0,,Üzgünüm...
Dialogue: 0,0:20:46.43,0:20:50.00,Main,,0,0,0,,Sanırım benzettin.
Dialogue: 0,0:20:50.70,0:20:55.39,Thoughts,,0,0,0,,{\i1}Affet beni, Robin.\NBir suçlunun kızı olmanı istemiyorum!{\i0}
Dialogue: 0,0:20:55.39,0:20:57.34,Thoughts,,0,0,0,,{\i1}Olvia...{\i0}
Dialogue: 0,0:20:57.74,0:20:59.28,Main,,0,0,0,,Tuhaf velet.
Dialogue: 0,0:21:00.06,0:21:01.70,Main,,0,0,0,,Hadi, gidiyoruz.
Dialogue: 0,0:21:16.41,0:21:19.20,Main,,0,0,0,,Ben Robin'im!
Dialogue: 0,0:21:19.20,0:21:23.33,Main,,0,0,0,,Çok büyüdüm! Beni hatırlamıyor musun?
Dialogue: 0,0:21:23.33,0:21:26.33,Main,,0,0,0,,Hep dönüşünü bekliyordum!
Dialogue: 0,0:21:26.33,0:21:28.00,Main,,0,0,0,,Gerçekten...
Dialogue: 0,0:21:29.04,0:21:31.30,Main,,0,0,0,,...annem...
Dialogue: 0,0:21:31.81,0:21:33.76,Main,,0,0,0,,...değil misin?
Dialogue: 0,0:21:35.13,0:21:37.72,Main,,0,0,0,,Bir gün seninle birlikte...
Dialogue: 0,0:21:37.72,0:21:39.27,Main,,0,0,0,,...el ele tutuşarak...
Dialogue: 0,0:21:40.52,0:21:43.47,Main,,0,0,0,,...yürümek istiyorum.
Dialogue: 0,0:21:43.47,0:21:48.35,Main,,0,0,0,,Çok çalıştım ve arkeolog oldum!
Dialogue: 0,0:21:48.35,0:21:50.81,Main,,0,0,0,,Poneglifleri de okuyabiliyorum!
Dialogue: 0,0:21:52.36,0:21:53.87,Main,,0,0,0,,O çocuk mu?!
Dialogue: 0,0:21:53.87,0:21:55.87,Main,,0,0,0,,Kes şunu, Robin!
Dialogue: 0,0:21:55.87,0:22:00.32,Main,,0,0,0,,Bu yüzden lütfen yanında kalmama izin ver!
Dialogue: 0,0:22:00.32,0:22:02.64,Main,,0,0,0,,Anne!
Dialogue: 0,0:22:02.64,0:22:04.29,Main,,0,0,0,,Robin...!
Dialogue: 0,0:22:05.50,0:22:07.30,Main,,0,0,0,,Artık...
Dialogue: 0,0:22:07.92,0:22:09.64,Main,,0,0,0,,...beni...
Dialogue: 0,0:22:10.27,0:22:12.93,Main,,0,0,0,,...yalnız bırakma lütfen!
Dialogue: 0,0:22:17.86,0:22:21.13,Main,,0,0,0,,Bu bombardıman da ne?!
Dialogue: 0,0:22:21.13,0:22:23.73,Main,,0,0,0,,{\i1}Yıkım Çağrısı başlıyor.{\i0}
Dialogue: 0,0:22:23.73,0:22:26.27,Main,,0,0,0,,{\i1}Tüm gemiler saldırıya başlasın.{\i0}
Dialogue: 0,0:22:26.27,0:22:30.71,Main,,0,0,0,,{\i1}Arkeoloji adası Ohara'daki her şeyi hedef alın.{\i0}
Dialogue: 0,0:22:30.71,0:22:35.84,Main,,0,0,0,,{\i1}Oharalı bilginlerinin yaptığı araştırma,\Nbeklentilerimizin önüne geçti.{\i0}
Dialogue: 0,0:22:35.84,0:22:40.05,Main,,0,0,0,,{\i1}O bilgi aktarılabilir. \NO adadan dışarı çıkmasına izin vermeyin.{\i0}
Dialogue: 0,0:22:40.05,0:22:45.64,Main,,0,0,0,,{\i1}Ohara'da yaşayan şeytanları tamamen yok edin.\NAdalet adına!{\i0}
Dialogue: 0,0:22:49.40,0:22:52.04,Main,,0,0,0,,Kahretsin! Bu da ne?!
Dialogue: 0,0:22:52.04,0:22:56.40,Main,,0,0,0,,Adayı henüz terketmedik! \NBizi öldürmek mi istiyorlar?
Dialogue: 0,0:22:57.35,0:23:00.10,Main,,0,0,0,,Her Şeyi Bilen Ağaç, doğrudan isabet aldı!
Dialogue: 0,0:23:00.10,0:23:02.65,Main,,0,0,0,,Bu, Karargâh'ın gücü olmalı.
Dialogue: 0,0:23:02.65,0:23:06.86,Main,,0,0,0,,Hükümet, başından beri böyle bitirmeyi planlıyordu. \NAhmaklar.
Dialogue: 0,0:23:06.86,0:23:10.11,Main,,0,0,0,,Şef, çocuk arkeolog olduğunu söylüyor.
Dialogue: 0,0:23:10.11,0:23:13.86,Main,,0,0,0,,Evet, gerçekten öyle dedi.\NGerçi doğru olup olmadığını bilmiyorum.
Dialogue: 0,0:23:13.86,0:23:16.17,Main,,0,0,0,,Bilmediğimiz için en güvenli çözüm, sorunu silmektir.
Dialogue: 0,0:23:16.17,0:23:19.84,Main,,0,0,0,,Yüzünü unutmayın.\NAdadan ayrılmasına izin vermeyin sakın.
Dialogue: 0,0:23:19.84,0:23:21.11,Main,,0,0,0,,Geri çekiliyoruz!
Dialogue: 0,0:23:21.11,0:23:22.45,Main,,0,0,0,,O zaman Olvia...
Dialogue: 0,0:23:24.06,0:23:27.49,Main,,0,0,0,,Yeter! Hiç sırası değil, boşverin onu!
Dialogue: 0,0:23:27.49,0:23:30.26,Main,,0,0,0,,Burada kalırsak biz de havaya uçacağız!
Dialogue: 0,0:23:30.26,0:23:32.98,Main,,0,0,0,,İlk önceliğimiz benim hayatım!
Dialogue: 0,0:23:32.98,0:23:35.77,Main,,0,0,0,,Herkes geri çekilsin! Gemiye dönün!
Dialogue: 0,0:23:44.16,0:23:46.36,Main,,0,0,0,,Kütüphane yangını konusunda bir şey yapın!
Dialogue: 0,0:23:46.36,0:23:48.36,Main,,0,0,0,,Her Şeyi Bilen Ağaç'ı koruyun!
Dialogue: 0,0:24:09.34,0:24:11.33,Main,,0,0,0,,Uzun zamandır...
Dialogue: 0,0:24:14.66,0:24:16.53,Main,,0,0,0,,...bunu yapmak istemiştim.
Dialogue: 0,0:24:19.45,0:24:21.09,Main,,0,0,0,,Robin!
Dialogue: 0,0:24:23.58,0:24:25.77,Main,,0,0,0,,Anne!
Dialogue: 0,0:24:28.42,0:24:31.49,Main,,0,0,0,,Benim hatam... Robin...
Dialogue: 0,0:24:31.49,0:24:35.46,Main,,0,0,0,,Poneglifleri okuyabildiğin doğru mu?
Dialogue: 0,0:24:36.07,0:24:39.60,Main,,0,0,0,,Daha dikkatli olsaydım...
Dialogue: 0,0:24:40.17,0:24:43.86,Main,,0,0,0,,Üzgünüm, ne olursa olsun onları okumak istedim.
Dialogue: 0,0:24:43.86,0:24:48.06,Main,,0,0,0,,Bu kadar büyük bir şeyi başarmana gerçekten şaşırdım.
Dialogue: 0,0:24:48.06,0:24:51.74,Main,,0,0,0,,Elinden geleni yapıp çok çalışmışsın.
Dialogue: 0,0:24:51.74,0:24:55.76,Main,,0,0,0,,Herkesin yapabileceği bir şey değil. Müthişsin, Robin!
Dialogue: 0,0:25:02.09,0:25:06.81,Main,,0,0,0,,İyi ki bunu tek bilenler, \Ndemin burada olan memurlardı.
Dialogue: 0,0:25:07.05,0:25:09.13,Main,,0,0,0,,Burada daha fazla vakit kaybedemeyiz.
Dialogue: 0,0:25:09.13,0:25:11.66,Main,,0,0,0,,Olvia, Robin'i al ve kaç!
Dialogue: 0,0:25:11.66,0:25:14.68,Main,,0,0,0,,Robin'le birlikte tahliye gemisine sızmayı başarabilirsen,...
Dialogue: 0,0:25:14.68,0:25:16.28,Main,,0,0,0,,...ikiniz adadan kaçabilirsiniz!
Dialogue: 0,0:25:19.74,0:25:23.41,Main,,0,0,0,,Robin! Burada mıydın? Seni arıyordum!
Dialogue: 0,0:25:23.41,0:25:24.62,Main,,0,0,0,,Saul!
Dialogue: 0,0:25:24.62,0:25:26.61,Main,,0,0,0,,Olvia'yla da karşılaşmışsın.
Dialogue: 0,0:25:26.61,0:25:29.71,Main,,0,0,0,,Saul! Niye bu adadasın?
Dialogue: 0,0:25:29.71,0:25:35.48,Main,,0,0,0,,Bir tür kader olmalı. Gemim battı ve \Nsahilde Robin tarafından kurtarıldım.
Dialogue: 0,0:25:35.48,0:25:37.72,Main,,0,0,0,,Asıl önemlisi, durum gerçekten kötü!
Dialogue: 0,0:25:37.72,0:25:39.93,Main,,0,0,0,,Hemen adayı terketmelisiniz!
Dialogue: 0,0:25:39.93,0:25:41.55,Main,,0,0,0,,Robin'le ilgilen.
Dialogue: 0,0:25:41.55,0:25:43.59,Main,,0,0,0,,Her pahasına kızımın adadan kaçmasına yardım et!
Dialogue: 0,0:25:43.59,0:25:48.02,Main,,0,0,0,,Hayır! Ya sen, anne? Benimle kalmayacak mısın?
Dialogue: 0,0:25:48.84,0:25:50.48,Main,,0,0,0,,Olvia, sen...
Dialogue: 0,0:25:50.48,0:25:53.40,Main,,0,0,0,,Hala burada yapmam gereken bir şey var.
Dialogue: 0,0:25:53.40,0:25:57.49,Main,,0,0,0,,Anne! Senden ayrılmak istemiyorum! \NDaha yeni karşılaştık!
Dialogue: 0,0:25:57.49,0:25:59.03,Main,,0,0,0,,Ben de burada kalacağım!
Dialogue: 0,0:25:59.03,0:26:00.79,Main,,0,0,0,,Robin...
Dialogue: 0,0:26:00.79,0:26:03.90,Main,,0,0,0,,Bir Ohara bilgini olarak, \Ntüm bunları çok iyi biliyor olmalısın.
Dialogue: 0,0:26:03.90,0:26:05.77,Main,,0,0,0,,Tarih, insanların hazinesidir.
Dialogue: 0,0:26:05.77,0:26:09.25,Main,,0,0,0,,Yaşamak üzere olduğun geleceği kesinlikle aydınlatacağım.
Dialogue: 0,0:26:09.25,0:26:12.16,Main,,0,0,0,,Ancak gelecek nesile...
Dialogue: 0,0:26:12.16,0:26:15.59,Main,,0,0,0,,...geçmişten miras aldığın tarihi öğretmelisin. \NYoksa o tarih yok olacak.
Dialogue: 0,0:26:15.59,0:26:17.55,Main,,0,0,0,,– Yangını söndürün!\N– Kitapları koruyun!
Dialogue: 0,0:26:17.55,0:26:21.43,Main,,0,0,0,,Ohara, tarihi açığa vurmak istemedi.
Dialogue: 0,0:26:21.43,0:26:24.02,Main,,0,0,0,,Sadece geçmişin seslerini duymak\Nve onları korumak istedik!
Dialogue: 0,0:26:24.02,0:26:30.75,Main,,0,0,0,,Araştırmamız burada sona eriyor. \NAma Ohara yok olsa bile,...
Dialogue: 0,0:26:31.63,0:26:37.15,Main,,0,0,0,,...sizin yaşayacağınız gelecekten vazgeçemeyiz!
Dialogue: 0,0:26:37.94,0:26:40.16,Main,,0,0,0,,Anlamıyorum!
Dialogue: 0,0:26:41.29,0:26:44.31,Main,,0,0,0,,Bir gün anlayacaksın.
Dialogue: 0,0:26:46.37,0:26:49.17,Main,,0,0,0,,Git artık, Saul!
Dialogue: 0,0:26:51.25,0:26:53.00,Main,,0,0,0,,Emin misin?
Dialogue: 0,0:26:53.00,0:26:54.70,Main,,0,0,0,,Evet.
Dialogue: 0,0:26:54.70,0:26:58.37,Main,,0,0,0,,Hayır! Ben de burada kalmak istiyorum! Anne!
Dialogue: 0,0:26:58.37,0:27:01.12,Main,,0,0,0,,Anne!
Dialogue: 0,0:27:01.12,0:27:04.11,Thoughts,,0,0,0,,{\i1}Bana anne diye seslendiğini duyduğuma çok sevindim.{\i0}
Dialogue: 0,0:27:04.85,0:27:06.63,Thoughts,,0,0,0,,{\i1}Teşekkür ederim.{\i0}
Dialogue: 0,0:27:06.63,0:27:09.67,Thoughts,,0,0,0,,{\i1}Şu andan itibaren benim payımı da almalı ve...{\i0}
Dialogue: 0,0:27:09.67,0:27:11.30,Main,,0,0,0,,YAŞAMALISIN, ROBIN!
Dialogue: 0,0:27:28.54,0:27:31.61,Main,,0,0,0,,Koramiral! Koramiral Kuzan!
Dialogue: 0,0:27:31.61,0:27:32.99,Main,,0,0,0,,Ne?!
Dialogue: 0,0:27:32.99,0:27:35.54,Main,,0,0,0,,Adada... Evet, hiç şüphesiz!
Dialogue: 0,0:27:35.54,0:27:39.12,Main,,0,0,0,,Ne oldu?! Konuya gel!
Dialogue: 0,0:27:39.12,0:27:41.95,Main,,0,0,0,,Kaçak, Koramiral Saul!
Dialogue: 0,0:27:41.95,0:27:44.30,Main,,0,0,0,,Saul! Geri dön, lütfen!
Dialogue: 0,0:27:44.30,0:27:46.54,Main,,0,0,0,,İmkansız, bunu yapamam!
Dialogue: 0,0:27:46.54,0:27:49.52,Main,,0,0,0,,Robin! Gurur duy Robin!
Dialogue: 0,0:27:49.52,0:27:53.48,Main,,0,0,0,,Annen harika biri! Ohara, harika bir yer!
Dialogue: 0,0:27:53.48,0:27:58.03,Main,,0,0,0,,Bir gün bu adanın tarihini aktarman gerekecek, Robin!
Dialogue: 0,0:27:58.03,0:28:01.77,Main,,0,0,0,,Ohara, dünyaya karşı dövüştü!
Dialogue: 0,0:28:04.32,0:28:07.41,Flashbacks,,0,0,0,,Kesin şunu! Sadece yakalamak yeterli!
Dialogue: 0,0:28:07.41,0:28:12.78,Flashbacks,,0,0,0,,Onlar kavgacı korsanlar değil!\NOnları kontrol edemeyecek kadar güçsüz müsünüz?!
Dialogue: 0,0:28:12.78,0:28:16.49,Flashbacks,,0,0,0,,Tarihi araştıran bir sürü gemi yakaladık.
Dialogue: 0,0:28:16.49,0:28:20.54,Flashbacks,,0,0,0,,Niye kesinlikle ölmeleri gerektiğini anlamıyorum!
Dialogue: 0,0:28:20.54,0:28:24.26,Flashbacks,,0,0,0,,Koramiral Saul! Hayatta kalan birini bulduk!
Dialogue: 0,0:28:24.26,0:28:26.46,Flashbacks,,0,0,0,,Arkadaşlarımı nasıl katledebilirsiniz?!
Dialogue: 0,0:28:27.59,0:28:30.43,Flashbacks,,0,0,0,,Gerçekten silahı istiyor musun?
Dialogue: 0,0:28:30.43,0:28:31.88,Flashbacks,,0,0,0,,Sizi zavallı insanlar.
Dialogue: 0,0:28:31.88,0:28:34.34,Flashbacks,,0,0,0,,Dur durak bilmeden, sebepsiz yere bize saldırıyordunuz!
Dialogue: 0,0:28:34.34,0:28:35.80,Flashbacks,,0,0,0,,Hey, o bir Koramiral!
Dialogue: 0,0:28:35.80,0:28:39.94,Flashbacks,,0,0,0,,Sadece silahın uyanışını engellemek istiyormuş gibi davranarak, kanunları asla sorgulamıyorsunuz!
Dialogue: 0,0:28:39.94,0:28:44.53,Flashbacks,,0,0,0,,Sadece hakkında hiçbir şey bilmediğiniz \Ngeçmişten korkmuyor musunuz?!
Dialogue: 0,0:28:45.75,0:28:47.53,Flashbacks,,0,0,0,,Bu çok gizli bir görev.
Dialogue: 0,0:28:47.53,0:28:49.70,Flashbacks,,0,0,0,,Yıkım Çağrısı?
Dialogue: 0,0:28:49.70,0:28:55.21,Flashbacks,,0,0,0,,Bu büyük saldırının on savaş gemisinden birini\Nkomuta edecek, beş Koramiral'den biri ol.
Dialogue: 0,0:28:55.39,0:28:59.16,Flashbacks,,0,0,0,,Onlar bilgin!\NNiye bu kadar ileri gitmek zorundayız?
Dialogue: 0,0:28:59.16,0:29:01.00,Flashbacks,,0,0,0,,Yakaladığımız bunca bilgin içerisinde,...
Dialogue: 0,0:29:01.00,0:29:05.12,Flashbacks,,0,0,0,,...gözlerim sadece tarihi bilmek isteyen insanlar görüyor!
Dialogue: 0,0:29:05.12,0:29:08.92,Flashbacks,,0,0,0,,Üzerinde çalıştıkları araştırma tehlikeliyse,\NHükümet'in onlara yardım etmesi gerekir!
Dialogue: 0,0:29:08.92,0:29:11.84,Flashbacks,,0,0,0,,Başkalarının canını gereksiz yere alan biziz!
Dialogue: 0,0:29:11.84,0:29:15.13,Flashbacks,,0,0,0,,Suçlu olduklarına dair bana bir tür kanıt verin.
Dialogue: 0,0:29:15.13,0:29:18.34,Flashbacks,,0,0,0,,Hükümet'ten şüphe mi ediyorsun?\NKapa çeneni ve itaat et.
Dialogue: 0,0:29:23.06,0:29:27.10,Flashbacks,,0,0,0,,Sadece biraz hikayeni duymama izin ver.
Dialogue: 0,0:29:27.10,0:29:31.07,Flashbacks,,0,0,0,,Acil durum!\NKoramiral Saul, bir suçluyla birlikte kaçtı!
Dialogue: 0,0:29:31.82,0:29:35.54,Flashbacks,,0,0,0,,Bir sonraki görevimizle ilgili her şeyi biliyor.
Dialogue: 0,0:29:35.54,0:29:38.75,Flashbacks,,0,0,0,,Peşlerine düşün!\NSaul ve Olvia'yı her pahasına yakalayın.
Dialogue: 0,0:29:38.75,0:29:41.19,Flashbacks,,0,0,0,,Ateş açsanız da umrumda değil.
Dialogue: 0,0:29:41.19,0:29:44.70,Flashbacks,,0,0,0,,Bize ulaştıklarında peşimizden gelenlerin icabına bakacağım.
Dialogue: 0,0:29:44.70,0:29:47.67,Flashbacks,,0,0,0,,Saul, Denizciler'e asla geri dönemeyeceksin.
Dialogue: 0,0:29:47.67,0:29:52.65,Flashbacks,,0,0,0,,Sorun değil. İçimde bu şüpheci his oldukça,\NDenizci olarak kalamam.
Dialogue: 0,0:29:52.65,0:29:57.09,Flashbacks,,0,0,0,,Kanunları koruyor olabilirler ama\Nbu seferki görev fazlasıyla acımasız.
Dialogue: 0,0:29:57.09,0:29:59.34,Flashbacks,,0,0,0,,Ben sadece kendi adaletime sadık kaldım.
Dialogue: 0,0:29:59.34,0:30:02.30,Flashbacks,,0,0,0,,Pekâla, hemen gidip memleketindekileri uyar.
Dialogue: 0,0:30:02.30,0:30:03.85,Flashbacks,,0,0,0,,Sana teşekkür etmeyeceğim.
Dialogue: 0,0:30:03.85,0:30:06.02,Flashbacks,,0,0,0,,Şansının açık olması için dua edeceğim.
Dialogue: 0,0:30:09.58,0:30:11.30,Main,,0,0,0,,ATEŞ!
Dialogue: 0,0:30:13.42,0:30:16.29,Main,,0,0,0,,Beni hedef alarak geldiler!
Dialogue: 0,0:30:20.59,0:30:22.13,Main,,0,0,0,,Saul!
Dialogue: 0,0:30:22.13,0:30:23.78,Main,,0,0,0,,Ah, isabet etti!
Dialogue: 0,0:30:23.78,0:30:24.91,Main,,0,0,0,,Afedersiniz!
Dialogue: 0,0:30:24.91,0:30:28.13,Main,,0,0,0,,Özür dileme! O artık şeytanların suç ortağı!
Dialogue: 0,0:30:28.13,0:30:32.51,Thoughts,,0,0,0,,Üzgünüm, Robin. Bu seni korkutmuş olmalı.
Dialogue: 0,0:30:33.27,0:30:35.27,Thoughts,,0,0,0,,Burada biraz bekle.
Dialogue: 0,0:30:35.27,0:30:41.18,Thoughts,,0,0,0,,Kıyıdan ateş ederken Robin'i yaralasalardı, ne yapardım?!
Dialogue: 0,0:30:41.53,0:30:44.18,Main,,0,0,0,,Koramiral, lütfen yapmayın! Ne yapmayı planlıyorsunuz?!
Dialogue: 0,0:30:44.18,0:30:49.17,Main,,0,0,0,,Neyin doğru olduğu hakkında hiçbir fikrim yok.\NBu yüzden sadece arkadaşımı koruyacağım!
Dialogue: 0,0:30:49.17,0:30:51.44,Main,,0,0,0,,Yapma, Saul!
Dialogue: 0,0:30:51.79,0:30:53.25,Main,,0,0,0,,Hazır olun!
Dialogue: 0,0:30:53.25,0:30:59.74,Main,,0,0,0,,Beni düşman edinince o kadar kolay kaçamazsınız!
Dialogue: 0,0:31:05.42,0:31:08.81,Credits,,0,0,0,,Editing:\NFeeso,\NGalaxy 9000\N\NTiming:\NHalee\N\NQuality Assurance:\NFeeso,\NGalaxy 9000,\NPepperjack,\NSewil\N\NSoundtracking:\NHalee\N\NTitle & Infoboxes:\NDatenshi\N\NKaraoke:\NKaitouYahiko\N\NTranslation:\NCrunchyroll
Dialogue: 0,0:00:00.71,0:00:03.37,Lyrics,,0,0,0,,{\fad(0,0)}♪ Koşmaya başlayalım, koşmaya başlayalım! ♪
Dialogue: 0,0:00:03.59,0:00:06.46,Lyrics,,0,0,0,,♪ Bayrağımızı süsleyip, gökyüzüne kaldırarak. ♪
Dialogue: 0,0:00:12.77,0:00:18.06,Lyrics,,0,0,0,,♪ Sonsuz okyanusu geçip aramaya gidelim. ♪
Dialogue: 0,0:00:18.86,0:00:21.81,Lyrics,,0,0,0,,♪ Henüz kimse tarafından...
Dialogue: 0,0:00:21.90,0:00:23.94,Lyrics,,0,0,0,,...bulunmamış bu dünyanın mucizesini. ♪
Dialogue: 0,0:00:24.82,0:00:27.96,Lyrics,,0,0,0,,♪ Çarpıp duran göğsümüzdeki...
Dialogue: 0,0:00:27.96,0:00:29.71,Lyrics,,0,0,0,,...aynı hislerle devam etmeliyiz. ♪
Dialogue: 0,0:00:29.71,0:00:35.59,Lyrics,,0,0,0,,♪ Hayaller peşinde koşanlar tarafından bırakılmış ayak izleri. ♪
Dialogue: 0,0:00:36.42,0:00:39.39,Lyrics,,0,0,0,,♪ Ne tür bir fırtınalı gece olursa olsun,...
Dialogue: 0,0:00:39.39,0:00:42.39,Lyrics,,0,0,0,,...kalplerimizin bir olmasını sağlarsak...
Dialogue: 0,0:00:42.39,0:00:46.54,Lyrics,,0,0,0,,{\fad(0,0)}...bu zorluğun üstesinden gelebileceğiz! ♪
Dialogue: 0,0:00:46.68,0:00:47.86,Lyrics,,0,0,0,,♪ Her zaman ♪
Dialogue: 0,0:00:48.76,0:00:51.59,Lyrics,,0,0,0,,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪
Dialogue: 0,0:00:51.72,0:00:54.55,Lyrics,,0,0,0,,{\fad(0,0)}♪ Bayrağımızı dalgalandırıp gökyüzüne kaldırarak. ♪
Dialogue: 0,0:00:54.60,0:00:57.14,Lyrics,,0,0,0,,♪ Kimseye göstermeyeceğiz. ♪
Dialogue: 0,0:00:57.23,0:01:00.58,Lyrics,,0,0,0,,{\fad(0,0)}♪ Gözlerimizde yaşlar olsa bile. ♪
Dialogue: 0,0:01:00.77,0:01:03.52,Lyrics,,0,0,0,,♪ Peşinden gidelim, peşinden gidelim! ♪
Dialogue: 0,0:01:03.69,0:01:06.52,Lyrics,,0,0,0,,♪ Hayallerimize giden doğru yolu...
Dialogue: 0,0:01:06.61,0:01:09.23,Lyrics,,0,0,0,,...gösteren pusulanın. ♪
Dialogue: 0,0:01:09.23,0:01:11.40,Lyrics,,0,0,0,,{\fad(0,0)}♪ Durmayacağız. ♪
Dialogue: 0,0:01:11.42,0:01:14.42,Lyrics,,0,0,0,,♪ Dünyayı dolaşarak...
Dialogue: 0,0:01:14.45,0:01:15.85,Lyrics,,0,0,0,,...yeniden başlayalım! ♪
Dialogue: 0,0:01:18.83,0:01:21.49,Lyrics,,0,0,0,,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪
Dialogue: 0,0:01:21.80,0:01:24.54,Lyrics,,0,0,0,,♪ Hedefimize doğru herkesten daha fazla. ♪
Dialogue: 0,0:01:24.63,0:01:27.12,Lyrics,,0,0,0,,♪ Şimdi kaçmazsak,...
Dialogue: 0,0:01:27.22,0:01:30.54,Lyrics,,0,0,0,,{\fad(0,0)}...yarını sıkı sıkıya kavrayabileceğiz! ♪
Dialogue: 0,0:01:30.60,0:01:33.63,Lyrics,,0,0,0,,♪ Peşinden gidelim, peşinden gidelim! ♪
Dialogue: 0,0:01:33.68,0:01:36.51,Lyrics,,0,0,0,,♪ Gözlerinden yansıtılmış tüm şimdiki zamanın. ♪
Dialogue: 0,0:01:36.56,0:01:38.93,Lyrics,,0,0,0,,♪ Bembeyaz bir kalp...
Dialogue: 0,0:01:39.15,0:01:41.43,Lyrics,,0,0,0,,...bana tüm hikayeyi anlatacak! ♪
Dialogue: 0,0:01:41.73,0:01:44.43,Lyrics,,0,0,0,,♪ Yepyeni bir dünyada...
Dialogue: 0,0:01:44.53,0:01:45.83,Lyrics,,0,0,0,,...yeniden başlayalım! ♪
