,2,120,120,18,1Style: Author,Impress BT,20,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.8,0.8,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:02:08.27,0:02:16.07,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:13:42.50,0:13:52.50,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:34:20.80,0:34:23.79,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 1,0:02:08.27,0:02:16.07,Title,,0,0,0,,Burası Cehennem Falan DeğilDialogue: 0,0:02:03.40,0:02:05.10,Main,,0,0,0,,Luffy...Dialogue: 0,0:02:05.90,0:02:08.10,Main,,0,0,0,,Hemen çık ortaya!Dialogue: 0,0:02:50.73,0:02:53.82,Main,,0,0,0,,Her an gidebiliriz!Dialogue: 0,0:02:53.82,0:02:56.07,Main,,0,0,0,,Luffy gelir gelmez gideceğiz!Dialogue: 0,0:02:56.07,0:02:57.25,Main,,0,0,0,,Tamam.Dialogue: 0,0:03:00.99,0:03:08.12,Main,,0,0,0,,Ama düşünüyorum da şu anda orada bizim kadar gemi var.Dialogue: 0,0:03:08.80,0:03:13.54,Main,,0,0,0,,Gitmeye çalışsak bile,  buradan kaçmak neredeyse imkansız.Dialogue: 0,0:03:13.54,0:03:16.14,Main,,0,0,0,,Ana kuzeybatı kapısından rapor veriyorum.Dialogue: 0,0:03:16.14,0:03:19.60,Main,,0,0,0,,Tüm Enies Lobby denizcileri ve ajanları toplandı.Dialogue: 0,0:03:19.60,0:03:26.93,Main,,0,0,0,,Ana kapıda kaçmak üzere olan 50 kadar korsan tespit ettik.Dialogue: 0,0:03:26.93,0:03:28.55,Main,,0,0,0,,Onlar...Dialogue: 0,0:03:30.00,0:03:34.30,Main,,0,0,0,,Zambaigil! Gördünüz mü, size söylemedim mi? Adadan güvenle çıktılar!Dialogue: 0,0:03:34.30,0:03:36.51,Main,,0,0,0,,Onlar için endişelenmeye gerek yok!Dialogue: 0,0:03:36.51,0:03:40.25,Main,,0,0,0,,Onları öldürseniz bile ölmezler!Dialogue: 0,0:03:42.28,0:03:43.63,Main,,0,0,0,,Bu kez-Dialogue: 0,0:03:43.63,0:03:47.57,Main,,0,0,0,,Saldırımızın ardından hiçbir şey kalmadı.Dialogue: 0,0:03:47.57,0:03:49.16,Main,,0,0,0,,Hepsi öldü.Dialogue: 0,0:03:50.54,0:03:53.96,Main,,0,0,0,,Adanın şu anki durumunda hayatta kalmak imkansız.Dialogue: 0,0:03:53.96,0:03:57.95,Main,,0,0,0,,Enies Lobby'de hayatta kalan kişi sayısı: Sıfır.Dialogue: 0,0:03:59.63,0:04:02.09,Main,,0,0,0,,İkinci gemiden rapor veriyorum.Dialogue: 0,0:04:02.71,0:04:06.01,Main,,0,0,0,,Güneydoğu Adalet Binası'ndan ve Adalet Kulesi'nden...Dialogue: 0,0:04:06.64,0:04:09.32,Main,,0,0,0,,...köprüye bağlanan yeraltı tüneline kadar...Dialogue: 0,0:04:09.32,0:04:11.03,Main,,0,0,0,,...her şey yok edildi.Dialogue: 0,0:04:12.26,0:04:16.65,Main,,0,0,0,,Kalan tek hedef, Tereddüt Köprüsü.Dialogue: 0,0:04:28.87,0:04:30.68,Main,,0,0,0,,Franky...Dialogue: 0,0:04:32.72,0:04:34.33,Main,,0,0,0,,Onlar...Dialogue: 0,0:04:35.61,0:04:41.55,Flashbacks,,0,0,0,,Tamam. Siz doğruca Adalet Binası'na gidin ve orada Hasır Şapka-san'la buluşun.Dialogue: 0,0:04:42.10,0:04:45.46,Flashbacks,,0,0,0,,Biz iki gruba ayrılacağız ve kolları çekeceğiz.Dialogue: 0,0:04:47.27,0:04:49.93,Main,,0,0,0,,Galley-La'nın adamları da mı?Dialogue: 0,0:04:50.45,0:04:55.39,Flashbacks,,0,0,0,,Onları görürsen de ki,...Dialogue: 0,0:04:57.03,0:04:59.19,Flashbacks,,0,0,0,,..."Kovuldunuz".Dialogue: 0,0:05:00.09,0:05:02.90,Main,,0,0,0,,Oimo! Kashi!Dialogue: 0,0:05:02.94,0:05:05.61,Flashbacks,,0,0,0,,Bizi...Dialogue: 0,0:05:05.61,0:05:07.74,Flashbacks,,0,0,0,,...kandırmaya...Dialogue: 0,0:05:07.74,0:05:09.78,Flashbacks,,0,0,0,,...nasıl cüret edersiniz?!Dialogue: 0,0:05:10.36,0:05:14.25,Main,,0,0,0,,Yokozuna da onlarla birlikteydi.Dialogue: 0,0:05:15.83,0:05:18.29,Flashbacks,,0,0,0,,Bizimle gelmek ister misin?Dialogue: 0,0:05:23.21,0:05:28.72,Main,,0,0,0,,Sodom ve Gomorrah! Herkes...Dialogue: 0,0:05:34.21,0:05:38.44,Flashbacks,,0,0,0,,"Geri kalan hayatım boyunca Franky ağabeyimizle kalacağım!" dedi.Dialogue: 0,0:05:48.73,0:05:51.23,Flashbacks,,0,0,0,,Kalbinden vuruldu!Dialogue: 0,0:05:51.23,0:05:52.83,Flashbacks,,0,0,0,,Düşmeden önce acele edin!Dialogue: 0,0:05:52.83,0:05:56.58,Flashbacks,,0,0,0,,Siz devam etmezseniz, ne olacak?!Dialogue: 0,0:05:57.51,0:06:02.38,Main,,0,0,0,,İnsanlar gerçekten bu kadar kolay ölebilir mi?Dialogue: 0,0:06:03.00,0:06:06.72,Main,,0,0,0,,İnsanları haritada göremezsin.Dialogue: 0,0:06:07.41,0:06:14.35,Main,,0,0,0,,Umursamazca bir adayı o haritadan siliyorlar.Dialogue: 0,0:06:15.02,0:06:17.60,Main,,0,0,0,,Yıkım Çağrısı bu işte.Dialogue: 0,0:06:25.41,0:06:28.86,Flashbacks,,0,0,0,,Ağabey! Seni kurtarmaya geldik!Dialogue: 0,0:06:28.86,0:06:31.69,Flashbacks,,0,0,0,,Eve birlikte dönelim!Dialogue: 0,0:06:35.37,0:06:38.81,Main,,0,0,0,,Acele et, Hasır Şapka!Dialogue: 0,0:06:38.81,0:06:42.38,Main,,0,0,0,,Arkadaşların seni bekliyor!Dialogue: 0,0:06:42.38,0:06:45.84,Main,,0,0,0,,Ölürsen bunu kabul etmeyeceğim!Dialogue: 0,0:06:50.31,0:06:51.89,Main,,0,0,0,,Franky...Dialogue: 0,0:06:52.92,0:06:55.26,Main,,0,0,0,,Gomu Gomu No...Dialogue: 0,0:06:55.26,0:06:57.31,Main,,0,0,0,,...Jet Tabanca!Dialogue: 0,0:07:01.57,0:07:03.44,Main,,0,0,0,,Zararı azaltmak için geri mi atladı?Dialogue: 0,0:07:04.90,0:07:06.73,Main,,0,0,0,,Parmak Tabanca!Dialogue: 0,0:07:18.91,0:07:20.92,Main,,0,0,0,,Jet Mermi!Dialogue: 0,0:07:25.67,0:07:28.51,Main,,0,0,0,,Çift Jet Tabanca!Dialogue: 0,0:07:36.43,0:07:38.31,Main,,0,0,0,,Gomu Gomu No...Dialogue: 0,0:07:39.38,0:07:41.12,Main,,0,0,0,,Altı stilde tam olarak ustalaşanların...Dialogue: 0,0:07:41.63,0:07:46.27,Main,,0,0,0,,...mümkün olan en güçlü saldırısını göstermeme izin ver!Dialogue: 0,0:07:47.00,0:07:48.53,Main,,0,0,0,,Altı Stil Gizli Saldırı!Dialogue: 0,0:07:51.32,0:07:52.61,Main,,0,0,0,,Altı Kral Silahı!Dialogue: 0,0:08:15.23,0:08:19.77,Main,,0,0,0,,Gökyüzü Adası'ndaki darbe kadranları gibi.Dialogue: 0,0:08:22.64,0:08:26.25,Main,,0,0,0,,Ama gücü çok daha fazla!Dialogue: 0,0:08:27.11,0:08:29.36,Main,,0,0,0,,Bacak Fırtınası: Galip Kuş!Dialogue: 0,0:08:34.13,0:08:35.33,Main,,0,0,0,,Luffy!Dialogue: 0,0:08:37.41,0:08:39.16,Main,,0,0,0,,Lucci güçlü biri.Dialogue: 0,0:08:39.62,0:08:43.96,Main,,0,0,0,,Hasır Şapka, Lucci'yi orada tutuyor olmasaydı,...Dialogue: 0,0:08:43.96,0:08:47.54,Main,,0,0,0,,...kaçımız ölürdük bilmiyorum.Dialogue: 0,0:08:48.30,0:08:51.05,Main,,0,0,0,,Bazen bunu düşündüğüm oldu.Dialogue: 0,0:08:52.40,0:08:58.68,Main,,0,0,0,,Başından beri Luffy, her zaman kiminle dövüşeceğini biliyor gibiydi.Dialogue: 0,0:08:59.31,0:09:02.14,Flashbacks,,0,0,0,,Güvercinli adamın canına okuyacağım!Dialogue: 0,0:09:02.75,0:09:05.94,Main,,0,0,0,,İçgüdüleriyle hareket ediyor. Senden daha fazla.Dialogue: 0,0:09:13.39,0:09:14.71,Main,,0,0,0,,Rapor veriyorum, efendim!Dialogue: 0,0:09:14.71,0:09:17.61,Main,,0,0,0,,Hasır Şapkalı Luffy birinci kulede!Dialogue: 0,0:09:17.61,0:09:19.03,Main,,0,0,0,,Yaşıyor mu?Dialogue: 0,0:09:19.03,0:09:23.20,Main,,0,0,0,,Tüm gemilere Tereddüt Köprüsü yanında savaş konumu almalarını söyleyin.Dialogue: 0,0:09:23.67,0:09:25.87,Main,,0,0,0,,– Emredersiniz! – Söyleyin onlara!Dialogue: 0,0:09:30.00,0:09:32.80,Main,,0,0,0,,Ölmeyecek, değil mi?Dialogue: 0,0:09:33.99,0:09:35.22,Main,,0,0,0,,Aptal mısın?Dialogue: 0,0:09:35.22,0:09:37.13,Main,,0,0,0,,Ne?!Dialogue: 0,0:09:37.13,0:09:39.35,Main,,0,0,0,,Aptal olan sensin!Dialogue: 0,0:09:59.68,0:10:00.53,Main,,0,0,0,,Ne?Dialogue: 0,0:10:01.00,0:10:02.20,Main,,0,0,0,,Duvarlar...Dialogue: 0,0:10:04.53,0:10:07.37,Main,,0,0,0,,Birinci kule ayrıldı!Dialogue: 0,0:10:15.20,0:10:18.04,Main,,0,0,0,,Köprünün yarısını havaya uçurdular.Dialogue: 0,0:10:18.04,0:10:19.59,Main,,0,0,0,,Neler oluyor?Dialogue: 0,0:10:21.17,0:10:25.60,Main,,0,0,0,,Birinci kulede CP9'dan Rob Lucci ve Hasır Şapkalı Luffy var.Dialogue: 0,0:10:27.74,0:10:29.56,Main,,0,0,0,,Savaş gemileri geliyor!Dialogue: 0,0:10:32.15,0:10:34.82,Main,,0,0,0,,Tüm gemiler Tereddüt Köprüsü etrafında savaş konumu alsın!Dialogue: 0,0:10:35.32,0:10:37.36,Main,,0,0,0,,Tereddüt Köprüsü'nde ve konvoy gemisinde...Dialogue: 0,0:10:37.36,0:10:41.37,Main,,0,0,0,,...Korsan Avcısı Zoro ve Nico Robin de  dahil olmak üzere toplam 9 korsan var!Dialogue: 0,0:10:42.30,0:10:46.87,Main,,0,0,0,,Adalet Kulesi'ndeki CP9 üyelerinin yenilmesinden sorumlu ana kuvvet olduklarına inanıyoruz!Dialogue: 0,0:10:49.35,0:10:51.21,Main,,0,0,0,,Robin'i geri almaya geliyorlar.Dialogue: 0,0:10:52.85,0:10:54.55,Main,,0,0,0,,Buna izin vermeyeceğiz!Dialogue: 0,0:10:57.43,0:11:00.29,Main,,0,0,0,,Ama gerçekten müthiş kimseler!Dialogue: 0,0:11:00.29,0:11:07.02,Main,,0,0,0,,Enies Lobby, yıllardır CP9 sayesinde delinmez bir şekilde kalmıştı.Dialogue: 0,0:11:07.52,0:11:10.06,Main,,0,0,0,,Hepsi tek bir tayfa tarafından yok edildi...Dialogue: 0,0:11:10.06,0:11:13.09,Main,,0,0,0,,...ve kaptanları Rob Lucci'ye denk.Dialogue: 0,0:11:13.09,0:11:17.03,Main,,0,0,0,,Hasır Şapkalı Luffy,  gerçekten sıradan bir acemi değil.Dialogue: 0,0:11:17.03,0:11:20.11,Main,,0,0,0,,Ama Lucci karşısında kazanamaz.Dialogue: 0,0:11:20.11,0:11:24.32,Main,,0,0,0,,Kötülüğü şimdi durdurarak, bu tayfanın sebep olduğu...Dialogue: 0,0:11:24.32,0:11:26.99,Main,,0,0,0,,...yıkımı temizleyeceğiz!Dialogue: 0,0:11:28.00,0:11:29.75,Main,,0,0,0,,Hey, oraya bakın!Dialogue: 0,0:11:45.51,0:11:47.64,Main,,0,0,0,,Luffy-kun!Dialogue: 0,0:11:48.60,0:11:50.86,Main,,0,0,0,,Buraya bak!Dialogue: 0,0:11:50.86,0:11:53.44,Main,,0,0,0,,Herkes güvenle köprüye ulaştı!Dialogue: 0,0:11:55.90,0:11:58.66,Main,,0,0,0,,Hepimiz iyiyiz!Dialogue: 0,0:11:58.66,0:12:01.50,Main,,0,0,0,,Bizim için endişelenmeye gerek yok, Luffy-kun!Dialogue: 0,0:12:01.50,0:12:03.61,Main,,0,0,0,,Robin-chan'ı da kurtardık!Dialogue: 0,0:12:05.19,0:12:08.29,Main,,0,0,0,,Tek yapman gereken onu yenmek!Dialogue: 0,0:12:08.72,0:12:10.12,Main,,0,0,0,,Yen onu, Luffy!Dialogue: 0,0:12:10.12,0:12:11.53,Main,,0,0,0,,Birlikte...Dialogue: 0,0:12:11.53,0:12:13.08,Main,,0,0,0,,...geri dönelim!Dialogue: 0,0:12:28.20,0:12:31.81,Main,,0,0,0,,Artık sadece an meselesi.Dialogue: 0,0:12:36.30,0:12:42.03,Main,,0,0,0,,Görünüşe göre, dediğin gibi  hepsi hayatta kalmış. Etkilendim.Dialogue: 0,0:12:42.03,0:12:46.53,Main,,0,0,0,,Ama şimdi, bunu ne kadar devam ettirebileceğini göreceğiz.Dialogue: 0,0:12:46.93,0:12:50.49,Main,,0,0,0,,Kötülük bu dünyada başarılı olamayacak!Dialogue: 0,0:12:51.08,0:12:53.40,Main,,0,0,0,,Kıdemli yüzbaşılar ve  daha alt rütbeler geride kalsın.Dialogue: 0,0:12:54.08,0:12:59.17,Main,,0,0,0,,Albaylar ve binbaşılar,  200 elit dövüşçü bu işe hemen son versin.Dialogue: 0,0:13:00.84,0:13:02.51,Main,,0,0,0,,Albay mı?Dialogue: 0,0:13:02.51,0:13:05.59,Main,,0,0,0,,Bunlar şu duman adam Smoker'la aynı rütbeden değil mi?Dialogue: 0,0:13:06.32,0:13:08.05,Main,,0,0,0,,Hem de sayıları bu kadar çok mu?!Dialogue: 0,0:13:08.51,0:13:10.56,Main,,0,0,0,,Bizden korktukları anlamına gelir.Dialogue: 0,0:13:10.56,0:13:12.94,Main,,0,0,0,,Nine, korkuyorum.Dialogue: 0,0:13:28.78,0:13:31.62,Main,,0,0,0,,Ha? Sanji nerede?Dialogue: 0,0:13:32.19,0:13:33.79,Main,,0,0,0,,Biraz önce buradaydı!Dialogue: 0,0:13:33.79,0:13:37.96,Main,,0,0,0,,Ne? Böyle bir zamanda  nereye gidiyor? Aptal aşçı.Dialogue: 0,0:13:38.29,0:13:41.87,Main,,0,0,0,,Herkes dövüş için hazırlansın!Dialogue: 0,0:13:42.32,0:13:45.05,Main,,0,0,0,,Hadi!Dialogue: 0,0:13:52.07,0:13:54.90,Main,,0,0,0,,Gösteriş yapmayı bırakın ve saldırın artık!Dialogue: 0,0:13:55.77,0:13:59.52,Main,,0,0,0,,Eğlenceli olacak. Yine istediğimi yapabileceğim.Dialogue: 0,0:14:00.53,0:14:03.48,Main,,0,0,0,,Ne olursa olsun, onları burada haklayacağız!Dialogue: 0,0:14:03.91,0:14:06.40,Main,,0,0,0,,Luffy gelene dek bunu yapacağız!Dialogue: 0,0:14:06.78,0:14:10.20,Main,,0,0,0,,Gemiden inmemiz lazım. Zarar görürse gidemeyiz!Dialogue: 0,0:14:10.84,0:14:12.66,Main,,0,0,0,,Tekrar yakalanmayacağım.Dialogue: 0,0:14:16.54,0:14:19.50,Main,,0,0,0,,Hareket edemiyorum!Dialogue: 0,0:14:20.00,0:14:21.54,Main,,0,0,0,,Saldırın!Dialogue: 0,0:14:23.55,0:14:26.51,Main,,0,0,0,,Nico Robin'i geri alın!Dialogue: 0,0:14:28.47,0:14:31.30,Main,,0,0,0,,Onu geri almak için bunca zahmete katlandıktan sonra bunun olacağını mı sanıyorsunuz?Dialogue: 0,0:14:31.73,0:14:35.45,Main,,0,0,0,,200 Denizci kulağa hoş geliyor!Dialogue: 0,0:14:35.45,0:14:37.56,Main,,0,0,0,,Ama çok fazlalar.Dialogue: 0,0:14:38.00,0:14:39.48,Main,,0,0,0,,Sol...Dialogue: 0,0:14:40.06,0:14:41.06,Main,,0,0,0,,...Silahlar!Dialogue: 0,0:14:43.23,0:14:47.78,Main,,0,0,0,,Hepsini tek tek haklaması zor olacak. Bu işi hemen bitireceğim!Dialogue: 0,0:14:50.04,0:14:52.87,Main,,0,0,0,,Sogeking'in gücünü size göstereceğim!Dialogue: 0,0:14:52.87,0:14:54.24,Main,,0,0,0,,Ayçiçeği Yıldızı!Dialogue: 0,0:15:03.83,0:15:06.34,Main,,0,0,0,,Bunu bir atış müsabakasına çevirelim mi o zaman?Dialogue: 0,0:15:09.29,0:15:10.59,Main,,0,0,0,,Lanet olası!Dialogue: 0,0:15:11.59,0:15:13.66,Main,,0,0,0,,Bu işe yaramayacak!Dialogue: 0,0:15:13.66,0:15:15.85,Main,,0,0,0,,Sol Silahlar!Dialogue: 0,0:15:20.69,0:15:21.90,Main,,0,0,0,,Hiçbir yere kaçmıyorsun.Dialogue: 0,0:15:21.90,0:15:23.98,Main,,0,0,0,,Güçlü Sağ!Dialogue: 0,0:15:38.99,0:15:42.22,Main,,0,0,0,,Nine, bu tarafa geliyorlar.Dialogue: 0,0:15:42.99,0:15:44.17,Main,,0,0,0,,Durum kötü.Dialogue: 0,0:15:44.81,0:15:49.13,Main,,0,0,0,,Robin, sen burada kal. Onları durduracağım.Dialogue: 0,0:15:53.01,0:15:54.36,Main,,0,0,0,,Geliyorum.Dialogue: 0,0:15:54.36,0:15:56.61,Main,,0,0,0,,Gökgürültüsü Saldırısı!Dialogue: 0,0:16:00.01,0:16:01.35,Main,,0,0,0,,Sallanan Kol!Dialogue: 0,0:16:11.28,0:16:12.73,Main,,0,0,0,,Gök Gürültüsü Topu!Dialogue: 0,0:16:13.17,0:16:14.95,Main,,0,0,0,,– Ne? – Bulut?Dialogue: 0,0:16:19.70,0:16:21.66,Main,,0,0,0,,Yıldırım Tempo!Dialogue: 0,0:16:23.20,0:16:24.47,Main,,0,0,0,,Başardım.Dialogue: 0,0:16:25.52,0:16:27.56,Main,,0,0,0,,Tuhaf bir silah kullanıyor!Dialogue: 0,0:16:27.56,0:16:28.84,Main,,0,0,0,,Lanet olası korsan!Dialogue: 0,0:16:39.68,0:16:40.72,Main,,0,0,0,,Robin.Dialogue: 0,0:16:41.90,0:16:46.73,Main,,0,0,0,,Ben de Hasır Şapkalar'dan biriyim. Hep birlikte dövüşeceğiz.Dialogue: 0,0:16:50.94,0:16:52.36,Main,,0,0,0,,Daha fazlası mı var?!Dialogue: 0,0:16:52.81,0:16:57.24,Main,,0,0,0,,Hey! Biz sadece rehineyiz!Dialogue: 0,0:16:57.24,0:16:59.09,Main,,0,0,0,,Gerçekten güçsüzüz!Dialogue: 0,0:17:16.89,0:17:19.26,Main,,0,0,0,,Luffy buraya gelene dek onları tutun!Dialogue: 0,0:17:31.28,0:17:32.31,Main,,0,0,0,,Kazı!Dialogue: 0,0:17:36.78,0:17:42.04,Main,,0,0,0,,Kuvvetini yitiriyor gibisin ve o tekniğin gücü de düşmeye başlıyor.Dialogue: 0,0:17:45.91,0:17:47.92,Main,,0,0,0,,Faydasız.Dialogue: 0,0:17:47.92,0:17:50.96,Main,,0,0,0,,Gerçekten Enies Lobby'yi yenemeyecek kadar güçsüzsün.Dialogue: 0,0:17:50.96,0:17:52.46,Main,,0,0,0,,Hepsi bu!Dialogue: 0,0:17:53.42,0:17:56.84,Main,,0,0,0,,Gomu Gomu No Jet Balta!Dialogue: 0,0:17:57.37,0:17:59.51,Main,,0,0,0,,Enies Lobby mahvolsa bile...Dialogue: 0,0:18:02.81,0:18:05.67,Main,,0,0,0,,...hükümetin amacına engel olan o kadını...Dialogue: 0,0:18:05.67,0:18:08.31,Main,,0,0,0,,...yok etmek için cehennemin  dibine kadar takip ederdim!Dialogue: 0,0:18:08.31,0:18:10.81,Main,,0,0,0,,Her şey karanlık adalet adına!Dialogue: 0,0:18:10.81,0:18:15.28,Main,,0,0,0,,Buraya Robin'i ondan kurtarmaya geldik!Dialogue: 0,0:18:16.70,0:18:18.24,Main,,0,0,0,,Jet Damga!Dialogue: 0,0:18:23.22,0:18:25.04,Main,,0,0,0,,Altı Kral Silahı!Dialogue: 0,0:19:27.61,0:19:28.78,Main,,0,0,0,,Luffy!Dialogue: 0,0:19:32.00,0:19:33.90,Main,,0,0,0,,– Yakaladım! – Hayır!Dialogue: 0,0:19:35.07,0:19:37.90,Main,,0,0,0,,Hey, ne diye orada duruyorsun, Soge-Dialogue: 0,0:19:47.82,0:19:51.22,Main,,0,0,0,,Luffy!Dialogue: 0,0:19:54.23,0:19:55.79,Main,,0,0,0,,Luffy!Dialogue: 0,0:19:56.60,0:20:00.26,Main,,0,0,0,,Ne yapıyorsun?!Dialogue: 0,0:20:00.26,0:20:03.22,Main,,0,0,0,,Ayağa kalk!Dialogue: 0,0:20:03.22,0:20:07.23,Main,,0,0,0,,Luffy!Dialogue: 0,0:20:08.27,0:20:10.48,Main,,0,0,0,,Sol Silahlar!Dialogue: 0,0:20:18.87,0:20:21.65,Main,,0,0,0,,Süper!Dialogue: 0,0:20:24.84,0:20:26.03,Main,,0,0,0,,Binbaşı!Dialogue: 0,0:20:26.66,0:20:28.28,Main,,0,0,0,,Bu korsanlar ne biçim böyle?Dialogue: 0,0:20:28.28,0:20:31.96,Main,,0,0,0,,Müthiş dövüşçüler! Yüzbaşılara karşı durabiliyorlar!Dialogue: 0,0:20:41.71,0:20:43.72,Main,,0,0,0,,O kadın şeytan meyvesi kullanıcısı mı?Dialogue: 0,0:20:44.26,0:20:46.43,Main,,0,0,0,,Haklayacağım onu! Hadi!Dialogue: 0,0:20:50.71,0:20:52.10,Main,,0,0,0,,100 Çiçek!Dialogue: 0,0:20:56.87,0:20:57.94,Main,,0,0,0,,Fiskele!Dialogue: 0,0:21:06.57,0:21:08.24,Main,,0,0,0,,İşte geliyorum!Dialogue: 0,0:21:08.24,0:21:10.23,Main,,0,0,0,,Gök Gürültüsü Topu!Dialogue: 0,0:21:12.32,0:21:14.33,Main,,0,0,0,,Yıldırım Tempo!Dialogue: 0,0:21:18.86,0:21:19.96,Main,,0,0,0,,Şimdilik bu kadar.Dialogue: 0,0:21:29.20,0:21:32.35,Main,,0,0,0,,Bunlar bir çoğundan farklı.Dialogue: 0,0:21:37.41,0:21:38.77,Main,,0,0,0,,Çift Kılıç Stili.Dialogue: 0,0:21:43.05,0:21:45.24,Main,,0,0,0,,Şahin Dalgası!Dialogue: 0,0:21:48.98,0:21:51.08,Main,,0,0,0,,Sırada kim var?Dialogue: 0,0:21:56.08,0:21:57.33,Main,,0,0,0,,Usopp...Dialogue: 0,0:22:05.82,0:22:08.26,Main,,0,0,0,,Luffy!Dialogue: 0,0:22:13.83,0:22:16.23,Main,,0,0,0,,Luffy!Dialogue: 0,0:22:33.40,0:22:35.21,Main,,0,0,0,,U-Usopp?Dialogue: 0,0:22:35.21,0:22:39.58,Main,,0,0,0,,Sen... Sen de mi geldin?Dialogue: 0,0:22:43.40,0:22:45.77,Main,,0,0,0,,Beni yanlış anlama!Dialogue: 0,0:22:45.77,0:22:50.39,Main,,0,0,0,,Sadece Robin'i kurtarmaya geldim!Dialogue: 0,0:22:51.00,0:22:55.26,Main,,0,0,0,,Seni görmeye falan gelmedim!Dialogue: 0,0:22:55.77,0:22:57.74,Main,,0,0,0,,Üfff. Şu aptal!Dialogue: 0,0:23:01.00,0:23:04.23,Main,,0,0,0,,Hey, sen! CP9'un kedi patronu!Dialogue: 0,0:23:06.46,0:23:11.53,Main,,0,0,0,,Sen! Rakibin ben olacağım! Bana gel bakalım!Dialogue: 0,0:23:16.81,0:23:21.75,Main,,0,0,0,,Evet! Rakibin benim!Dialogue: 0,0:23:22.29,0:23:23.04,Main,,0,0,0,,Hey!Dialogue: 0,0:23:23.54,0:23:27.77,Main,,0,0,0,,Hey... dur!  Kes şunu hemen!Dialogue: 0,0:23:28.61,0:23:31.01,Main,,0,0,0,,Ondan uzak dur!Dialogue: 0,0:23:31.01,0:23:34.75,Main,,0,0,0,,Yenildiğine göre artık seninle işim kalmadı.Dialogue: 0,0:23:35.36,0:23:38.14,Main,,0,0,0,,Ne olursa olsun onları öldüreceğim.Dialogue: 0,0:23:38.14,0:23:40.98,Main,,0,0,0,,Oradan izleyebilirsin.Dialogue: 0,0:23:41.86,0:23:46.23,Main,,0,0,0,,Evet, gel bakalım kedi patron! Seni havaya uçuracağım!Dialogue: 0,0:23:47.42,0:23:51.61,Main,,0,0,0,,Aptal mısın sen? Kes şunu, Usopp! Seni öldürecek!Dialogue: 0,0:23:51.61,0:23:57.20,Main,,0,0,0,,Kapa çeneni! Ölüme bu kadar yakınken ne yapacaksın?!Dialogue: 0,0:23:59.30,0:24:02.37,Main,,0,0,0,,Onun canına okuyacağım!Dialogue: 0,0:24:02.98,0:24:06.36,Main,,0,0,0,,O zaman ayağa kalk!Dialogue: 0,0:24:06.36,0:24:11.28,Main,,0,0,0,,Ölmek üzereymişsin gibi bakmayı bırak!Dialogue: 0,0:24:12.49,0:24:15.10,Main,,0,0,0,,Bu sana hiç yakışmıyor!Dialogue: 0,0:24:20.05,0:24:25.02,Main,,0,0,0,,Patlamalarla karartılmış olsa bile, yine de gökyüzünü görebiliriz!Dialogue: 0,0:24:26.40,0:24:29.03,Main,,0,0,0,,Hala denizi görebiliriz!Dialogue: 0,0:24:35.37,0:24:40.33,Main,,0,0,0,,Burası... Burası cehennem değil!Dialogue: 0,0:24:46.14,0:24:50.76,Main,,0,0,0,,Ölecekmişsin gibi bakmayı kes, pislik!Dialogue: 0,0:24:53.72,0:24:58.15,Main,,0,0,0,,Beni endişelendirmeyi bırak, lanet olası!Dialogue: 0,0:25:04.28,0:25:05.75,Main,,0,0,0,,Anladım.Dialogue: 0,0:25:08.39,0:25:11.49,Main,,0,0,0,,Burası cehennem falan değil.Dialogue: 0,0:25:14.28,0:25:15.82,Main,,0,0,0,,Luffy!Dialogue: 0,0:25:23.75,0:25:28.75,Main,,0,0,0,,Yen onu! Böylece birlikte geri dönebiliriz, Luffy!Dialogue: 0,0:25:29.59,0:25:32.71,Main,,0,0,0,,Elbette!Dialogue: 0,0:25:37.32,0:25:39.46,Main,,0,0,0,,Yine mi hareket edebiliyorsun?Dialogue: 0,0:25:42.78,0:25:46.90,Main,,0,0,0,,Pes etmeyeceğim.Dialogue: 0,0:25:48.16,0:25:49.85,Main,,0,0,0,,Seni yenene kadar...Dialogue: 0,0:25:51.11,0:25:55.99,Main,,0,0,0,,...düşmeyeceğim!Dialogue: 0,0:26:00.42,0:26:02.95,Main,,0,0,0,,Hayatın Dönüşü: İptal!Dialogue: 0,0:26:04.94,0:26:08.35,Main,,0,0,0,,Karışmandan bıktım artık.Dialogue: 0,0:26:08.35,0:26:11.38,Main,,0,0,0,,Seni güçlü bir vuruşla yeneceğim.Dialogue: 0,0:26:12.21,0:26:15.34,Main,,0,0,0,,Arkadaşların için endişelenme, Hasır Şapka.Dialogue: 0,0:26:16.48,0:26:21.60,Main,,0,0,0,,İstediğin gibi her birini...Dialogue: 0,0:26:22.38,0:26:26.56,Main,,0,0,0,,...seninle birlikte cehenneme göndereceğim!Dialogue: 0,0:26:40.43,0:26:41.78,Main,,0,0,0,,Noktalar!Dialogue: 0,0:26:57.42,0:26:58.94,Main,,0,0,0,,Luffy...Dialogue: 0,0:27:16.94,0:27:17.90,Main,,0,0,0,,Galip Kuş!Dialogue: 0,0:27:23.13,0:27:26.58,Main,,0,0,0,,Kahretsin! Bu adamların nesi var böyle?! Onlara vuramıyorum!Dialogue: 0,0:27:35.58,0:27:37.67,Main,,0,0,0,,Hey! Kazandım!Dialogue: 0,0:27:37.67,0:27:39.71,Main,,0,0,0,,Al sana!Dialogue: 0,0:27:45.66,0:27:48.81,Main,,0,0,0,,Sana Beri Beri no Mi'nin gücünü göstereceğim.Dialogue: 0,0:27:45.66,0:27:48.81,Note,,0,0,0,,Beri Beri no Mi: Dut Dut MeyvesiDialogue: 0,0:27:52.44,0:27:55.11,Main,,0,0,0,,Kahretsin, kıpırdayamıyorum bile.Dialogue: 0,0:27:57.22,0:27:59.49,Main,,0,0,0,,Hiçbir şey yapamazsın!Dialogue: 0,0:28:00.70,0:28:01.70,Main,,0,0,0,,Sağol!Dialogue: 0,0:28:02.24,0:28:05.49,Main,,0,0,0,,Hey, dur bakalım biraz.Dialogue: 0,0:28:06.07,0:28:09.11,Main,,0,0,0,,Gitmeyi o kadar istiyorsan,...Dialogue: 0,0:28:09.11,0:28:10.61,Main,,0,0,0,,Hey, d-dur!Dialogue: 0,0:28:10.61,0:28:12.62,Main,,0,0,0,,Sol Silahlar!Dialogue: 0,0:28:15.69,0:28:18.76,Main,,0,0,0,,Dikkatli olun! Bazıları şeytan meyvesi kullanıcısı!Dialogue: 0,0:28:22.88,0:28:24.39,Main,,0,0,0,,Ben de öyleyim!Dialogue: 0,0:28:24.39,0:28:27.97,Main,,0,0,0,,30 Çiçek: Kavra!Dialogue: 0,0:28:33.40,0:28:35.48,Main,,0,0,0,,Sen Roronoa Zoro musun?Dialogue: 0,0:28:36.70,0:28:38.57,Main,,0,0,0,,Öyleysem ne olmuş?Dialogue: 0,0:28:39.12,0:28:41.11,Main,,0,0,0,,Seni yeneceğim!Dialogue: 0,0:28:41.78,0:28:43.24,Main,,0,0,0,,İyi şanslar!Dialogue: 0,0:28:48.98,0:28:52.26,Main,,0,0,0,,Ben, Sabi Sabi meyvesi yiyen küf adamım.Dialogue: 0,0:28:48.98,0:28:52.26,Note,,0,0,0,,Sabi Sabi: Küf KüfDialogue: 0,0:28:52.26,0:28:54.46,Main,,0,0,0,,Beni yenemezsin.Dialogue: 0,0:28:55.44,0:28:57.92,Main,,0,0,0,,Kahretsin! Yubashiri...Dialogue: 0,0:28:58.27,0:29:03.30,Main,,0,0,0,,Bütün kılıçlarını küflendireceğim.Dialogue: 0,0:29:04.00,0:29:05.89,Main,,0,0,0,,İlginç.Dialogue: 0,0:29:07.35,0:29:09.35,Main,,0,0,0,,Dene bakalım.Dialogue: 0,0:29:15.85,0:29:19.48,Main,,0,0,0,,Anlıyor musun? Beni kılıçla yenemezsin!Dialogue: 0,0:29:22.24,0:29:26.20,Main,,0,0,0,,H-hareket edemiyorum!Dialogue: 0,0:29:26.68,0:29:31.49,Main,,0,0,0,,Tüm eklemlerini küflendirdim. Şimdi de tüm bedenini küflendireceğim!Dialogue: 0,0:29:31.49,0:29:32.66,Main,,0,0,0,,Kahretsin!Dialogue: 0,0:29:32.66,0:29:34.71,Main,,0,0,0,,Ateş Kuşu Yıldızı!Dialogue: 0,0:29:41.09,0:29:43.55,Main,,0,0,0,,İyi misin, Zoro-kun?Dialogue: 0,0:29:50.76,0:29:54.31,Main,,0,0,0,,Gomu Gomu No Jet Tabanca!Dialogue: 0,0:30:01.65,0:30:05.93,Main,,0,0,0,,Gomu Gomu No Jet Tabanca!Dialogue: 0,0:30:07.82,0:30:09.64,Main,,0,0,0,,Buna tekrar düşeceğimi mi sanıyorsun?Dialogue: 0,0:30:11.78,0:30:13.24,Main,,0,0,0,,En Geniş Halka!Dialogue: 0,0:30:14.50,0:30:16.46,Main,,0,0,0,,Altı Kral Silahı!Dialogue: 0,0:31:03.10,0:31:05.22,Flashbacks,,0,0,0,,Seni yenene dek...Dialogue: 0,0:31:06.09,0:31:10.80,Flashbacks,,0,0,0,,...düşmeyeceğim!Dialogue: 0,0:31:25.41,0:31:30.61,Flashbacks,,0,0,0,,Öyle tehlikeli bir kadını alırsanız, yakında buna pişman olacaksınız.Dialogue: 0,0:31:31.20,0:31:33.07,Main,,0,0,0,,Gomu Gomu No...Dialogue: 0,0:31:33.41,0:31:36.87,Flashbacks,,0,0,0,,Bitti artık. Bir daha birbirimizi görmeyeceğiz.Dialogue: 0,0:31:37.25,0:31:41.58,Flashbacks,,0,0,0,,Bu, sizin gibi insanların karışacağı bir şey değil.Dialogue: 0,0:31:41.71,0:31:46.34,Flashbacks,,0,0,0,,Robin bizim için ölmek niyetinde!Dialogue: 0,0:31:49.22,0:31:50.34,Main,,0,0,0,,Demir Parça!Dialogue: 0,0:31:53.05,0:31:56.26,Flashbacks,,0,0,0,,Ciddi misiniz siz?!  Tüm dünyaya savaş ilan ettiğinize göre...Dialogue: 0,0:31:56.26,0:31:58.14,Flashbacks,,0,0,0,,...artık hayatta kalabileceğinizi sanmayın!Dialogue: 0,0:31:58.68,0:32:02.94,Flashbacks,,0,0,0,,O kadını yok etmek için cehennemin dibine kadar izlerdim!Dialogue: 0,0:32:03.15,0:32:05.57,Flashbacks,,0,0,0,,Yaşamak istiyorum!Dialogue: 0,0:32:09.15,0:32:10.24,Main,,0,0,0,,Jet...Dialogue: 0,0:32:11.99,0:32:16.09,Main,,0,0,0,,...Makineli Tüfek!Dialogue: 0,0:32:55.74,0:32:57.18,Main,,0,0,0,,Ne oldu?Dialogue: 0,0:32:57.91,0:32:59.20,Main,,0,0,0,,Neler oluyor?Dialogue: 0,0:33:03.09,0:33:04.04,Main,,0,0,0,,Luffy!Dialogue: 0,0:33:04.67,0:33:05.83,Main,,0,0,0,,Luffy!Dialogue: 0,0:33:08.00,0:33:09.80,Main,,0,0,0,,İlk kule?Dialogue: 0,0:33:13.60,0:33:16.07,Main,,0,0,0,,Hey. O da ne?Dialogue: 0,0:33:16.07,0:33:18.01,Main,,0,0,0,,Hey, oraya bakın!Dialogue: 0,0:33:18.43,0:33:20.79,Main,,0,0,0,,Tüm gemilere rapor veriyorum.Dialogue: 0,0:33:20.79,0:33:22.39,Main,,0,0,0,,Tüm gemilere rapor veriyorum!Dialogue: 0,0:33:22.93,0:33:26.60,Main,,0,0,0,,CP9'dan Rob Lucci demin...Dialogue: 0,0:33:26.60,0:33:34.17,Main,,0,0,0,,...demin korsan "Hasır Şapkalı Luffy" tarafından yenildi!Dialogue: 0,0:33:39.98,0:33:41.20,Main,,0,0,0,,Luffy.Dialogue: 0,0:33:49.81,0:33:51.05,Main,,0,0,0,,Bitti.Dialogue: 0,0:33:51.81,0:33:54.30,Main,,0,0,0,,Bu kadarı yeterli olmalı.Dialogue: 0,0:33:58.70,0:34:02.60,Main,,0,0,0,,Birlikte geri dönelim!Dialogue: 0,0:34:03.21,0:34:08.06,Main,,0,0,0,,Robin!!!Dialogue: 0,0:34:20.78,0:34:23.74,Credits,,0,0,0,,Editing:  Galaxy 9000  Timing: PhosCity  Quality Control: danpmss, DolphinWeabu, ItsKipz, Galaxy 9000, Pepperjack  Soundtracking:  Halee  Graphics:  Datenshi  Karaoke: KaitouYahiko  Translation: Crunchyroll, GaijinDialogue: 0,0:00:00.71,0:00:03.37,Lyrics,,0,0,0,,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪Dialogue: 0,0:00:03.59,0:00:06.46,Lyrics,,0,0,0,,♪ Bayrağımızı süsleyip, gökyüzüne kaldırarak. ♪Dialogue: 0,0:00:12.77,0:00:18.06,Lyrics,,0,0,0,,♪ Sonsuz okyanusu geçip aramaya gidelim. ♪Dialogue: 0,0:00:18.86,0:00:21.81,Lyrics,,0,0,0,,♪ Henüz kimse tarafından...Dialogue: 0,0:00:21.90,0:00:23.94,Lyrics,,0,0,0,,...bulunmamış bu dünyanın mucizesini. ♪Dialogue: 0,0:00:24.82,0:00:27.96,Lyrics,,0,0,0,,♪ Çarpıp duran göğsümüzdeki...Dialogue: 0,0:00:27.96,0:00:29.71,Lyrics,,0,0,0,,...aynı hislerle devam etmeliyiz. ♪Dialogue: 0,0:00:29.71,0:00:35.59,Lyrics,,0,0,0,,♪ Hayaller peşinde koşanlar tarafından bırakılmış ayak izleri. ♪Dialogue: 0,0:00:36.42,0:00:39.39,Lyrics,,0,0,0,,♪ Ne tür bir fırtınalı gece olursa olsun,...Dialogue: 0,0:00:39.39,0:00:42.39,Lyrics,,0,0,0,,...kalplerimizin bir olmasını sağlarsak...Dialogue: 0,0:00:42.39,0:00:46.54,Lyrics,,0,0,0,,...bu zorluğun üstesinden gelebileceğiz! ♪Dialogue: 0,0:00:46.68,0:00:47.86,Lyrics,,0,0,0,,♪ Her zaman ♪Dialogue: 0,0:00:48.76,0:00:51.59,Lyrics,,0,0,0,,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪Dialogue: 0,0:00:51.72,0:00:54.55,Lyrics,,0,0,0,,♪ Bayrağımızı dalgalandırıp gökyüzüne kaldırarak. ♪Dialogue: 0,0:00:54.60,0:00:57.14,Lyrics,,0,0,0,,♪ Kimseye göstermeyeceğiz. ♪Dialogue: 0,0:00:57.23,0:01:00.58,Lyrics,,0,0,0,,♪ Gözlerimizde yaşlar olsa bile. ♪Dialogue: 0,0:01:00.77,0:01:03.52,Lyrics,,0,0,0,,♪ Peşinden gidelim, peşinden gidelim! ♪Dialogue: 0,0:01:03.69,0:01:06.52,Lyrics,,0,0,0,,♪ Hayallerimize giden doğru yolu...Dialogue: 0,0:01:06.61,0:01:09.23,Lyrics,,0,0,0,,...gösteren pusulanın. ♪Dialogue: 0,0:01:09.23,0:01:11.40,Lyrics,,0,0,0,,♪ Durmayacağız. ♪Dialogue: 0,0:01:11.42,0:01:14.42,Lyrics,,0,0,0,,♪ Dünyayı dolaşarak...Dialogue: 0,0:01:14.45,0:01:15.85,Lyrics,,0,0,0,,...yeniden başlayalım! ♪Dialogue: 0,0:01:18.83,0:01:21.49,Lyrics,,0,0,0,,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪Dialogue: 0,0:01:21.80,0:01:24.54,Lyrics,,0,0,0,,♪ Hedefimize doğru herkesten daha fazla. ♪Dialogue: 0,0:01:24.63,0:01:27.12,Lyrics,,0,0,0,,♪ Şimdi kaçmazsak,...Dialogue: 0,0:01:27.22,0:01:30.54,Lyrics,,0,0,0,,...yarını sıkı sıkıya kavrayabileceğiz! ♪Dialogue: 0,0:01:30.60,0:01:33.63,Lyrics,,0,0,0,,♪ Peşinden gidelim, peşinden gidelim! ♪Dialogue: 0,0:01:33.68,0:01:36.51,Lyrics,,0,0,0,,♪ Gözlerinden yansıtılmış tüm şimdiki zamanın. ♪Dialogue: 0,0:01:36.56,0:01:38.93,Lyrics,,0,0,0,,♪ Bembeyaz bir kalp...Dialogue: 0,0:01:39.15,0:01:41.43,Lyrics,,0,0,0,,...bana tüm hikayeyi anlatacak! ♪Dialogue: 0,0:01:41.73,0:01:44.43,Lyrics,,0,0,0,,♪ Yepyeni bir dünyada...Dialogue: 0,0:01:44.53,0:01:45.83,Lyrics,,0,0,0,,...yeniden başlayalım! ♪