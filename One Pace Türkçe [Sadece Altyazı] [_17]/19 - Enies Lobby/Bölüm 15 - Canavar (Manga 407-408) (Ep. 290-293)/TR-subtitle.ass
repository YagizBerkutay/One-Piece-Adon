Dialogue: 0,0:01:50.06,0:01:55.38,Title,,0,0,250,,Canavar{\fad(1000,0)}
Dialogue: 0,0:02:03.88,0:02:13.18,Main,,0,0,0,,Öfkeli aslana merhamet etmek yakışmaz!
Dialogue: 0,0:02:13.18,0:02:14.39,Main,,0,0,0,,Acıyor.
Dialogue: 0,0:02:16.10,0:02:19.78,Thoughts,,0,0,0,,{\i1}İkinci gümbürtü topu kumar gibi.{\i0}
Dialogue: 0,0:02:19.78,0:02:22.56,Thoughts,,0,0,0,,{\i1}Toplamda 7 dönüşüm var.{\i0}
Dialogue: 0,0:02:22.56,0:02:27.66,Thoughts,,0,0,0,,{\i1}Bu yüzden Kol Noktası'na \Ndönüşme ihtimalim yedide bir.{\i0}
Dialogue: 0,0:02:28.71,0:02:33.67,Thoughts,,0,0,0,,{\i1}Yapabilirsem, ona en güçlü saldırımla vurabilirim.{\i0}
Dialogue: 0,0:02:34.15,0:02:37.34,Main,,0,0,0,,Bu tek fırsatım!
Dialogue: 0,0:02:37.64,0:02:39.39,Main,,0,0,0,,Kol Noktası!{\fad(150,150)}
Dialogue: 0,0:02:40.07,0:02:42.97,Main,,0,0,0,,Shishi Kebap!{\fad(150,150)}
Dialogue: 0,0:02:48.61,0:02:50.50,Main,,0,0,0,,Arkadaşım için!
Dialogue: 0,0:02:50.50,0:02:52.46,Main,,0,0,0,,Kol Noktası!{\fad(150,150)}
Dialogue: 0,0:02:54.36,0:02:55.94,Main,,0,0,0,,Kol Noktası!{\fad(150,150)}
Dialogue: 0,0:02:59.30,0:03:00.63,Thoughts,,0,0,0,,Bu değil!
Dialogue: 0,0:03:00.63,0:03:03.20,Thoughts,,0,0,0,,Bu değil! Niye yapamıyorum?!
Dialogue: 0,0:03:03.20,0:03:06.87,Thoughts,,0,0,0,,{\i1}Bir şekilde Kol Noktası'na ulaşmalıyım!{\i0}
Dialogue: 0,0:03:13.47,0:03:15.63,Main,,0,0,0,,Dönüştüm! Ne zaman oldu bu?
Dialogue: 0,0:03:15.63,0:03:17.34,Main,,0,0,0,,Hazırla kendini!
Dialogue: 0,0:03:17.34,0:03:19.13,Thoughts,,0,0,0,,{\i1}Her şeyim buna bağlı.{\i0}
Dialogue: 0,0:03:19.13,0:03:20.76,Main,,0,0,0,,Hepsi bu vuruşa bağlı.
Dialogue: 0,0:03:21.36,0:03:23.11,Main,,0,0,0,,Yarık Toynak...{\fad(150,150)}
Dialogue: 0,0:03:23.11,0:03:25.39,Main,,0,0,0,,Aslan Parmak Tabanca!{\fad(150,150)}
Dialogue: 0,0:03:32.39,0:03:36.47,Main,,0,0,0,,Şimdi geri durursam başka fırsatım olmayacak!
Dialogue: 0,0:03:36.47,0:03:37.23,Main,,0,0,0,,Yarık Toynak...{\fad(150,150)}
Dialogue: 0,0:03:38.24,0:03:40.24,Main,,0,0,0,,Güçlü Demir Parça!{\fad(150,150)} {.}
Dialogue: 0,0:03:40.74,0:03:43.54,Main,,0,0,0,,{\fad(150,150)}...Kiraz Çiçeği Kar Fırtınası!
Dialogue: 0,0:03:48.16,0:03:49.87,Thoughts,,0,0,0,,Düş artık!
Dialogue: 0,0:03:49.87,0:03:53.83,Thoughts,,0,0,0,,Bu en güçlü saldırım.
Dialogue: 0,0:03:57.54,0:03:59.28,Main,,0,0,0,,Ahh...
Dialogue: 0,0:04:04.24,0:04:07.94,Main,,0,0,0,,Ahh... muhteşem...!
Dialogue: 0,0:04:07.94,0:04:14.56,Main,,0,0,0,,Gerçekten çok güzel kiraz çiçeği tipisi.
Dialogue: 0,0:04:16.57,0:04:18.19,Main,,0,0,0,,Bu...
Dialogue: 0,0:04:20.11,0:04:22.15,Main,,0,0,0,,...gerçekten...
Dialogue: 0,0:04:23.44,0:04:25.61,Main,,0,0,0,,Başardım mı?
Dialogue: 0,0:04:32.58,0:04:35.44,Main,,0,0,0,,Kesinlikle affedilemez!
Dialogue: 0,0:04:35.44,0:04:39.14,Main,,0,0,0,,Şimdi aslanın yıldırımını göreceksin!
Dialogue: 0,0:04:45.38,0:04:47.59,Main,,0,0,0,,Bacak Fırtınası Nilüfer Açışı!{\fad(150,150)}
Dialogue: 0,0:04:51.07,0:04:55.56,Thoughts,,0,0,0,,{\i1}Yapamam.\NArtık dövüşecek gücüm kalmadı.{\i0}
Dialogue: 0,0:04:56.71,0:04:58.11,Flashbacks,,0,0,0,,Chopper!
Dialogue: 0,0:04:59.04,0:05:02.82,Flashbacks,,0,0,0,,Chopper, ne yaptın Allah aşkına?
Dialogue: 0,0:05:03.76,0:05:06.28,Flashbacks,,0,0,0,,Hatırlamıyorum.
Dialogue: 0,0:05:09.68,0:05:13.11,Flashbacks,,0,0,0,,Bu, hatırlamadığın için\Nunutabileceğimiz bir şey değil.
Dialogue: 0,0:05:13.11,0:05:17.08,Flashbacks,,0,0,0,,Kimsenin ölmemiş olması iyi.
Dialogue: 0,0:05:17.08,0:05:19.87,Flashbacks,,0,0,0,,Sen uyurken,...
Dialogue: 0,0:05:19.87,0:05:22.75,Flashbacks,,0,0,0,,...tüm ülke o gecenin karmaşası içindeydi.
Dialogue: 0,0:05:22.75,0:05:25.38,Flashbacks,,0,0,0,,Seni nasıl cezalandıracağımı bilmiyorum.
Dialogue: 0,0:05:25.38,0:05:28.09,Flashbacks,,0,0,0,,O kadar korkunç bir şey mi yaptım?
Dialogue: 0,0:05:28.09,0:05:30.77,Flashbacks,,0,0,0,,Neredeyse bir şehrin tamamını yakıp kül ettin.
Dialogue: 0,0:05:30.77,0:05:33.92,Flashbacks,,0,0,0,,Baban gibi deneyler yapmaktan\Nhoşlanmanı umursamıyorum...
Dialogue: 0,0:05:33.92,0:05:36.80,Flashbacks,,0,0,0,,...ama bunu sadece dikkatlice\Ndüşündükten sonra yapmalısın.
Dialogue: 0,0:05:36.83,0:05:38.06,Flashbacks,,0,0,0,,Böyle yapılması gerekir.
Dialogue: 0,0:05:39.13,0:05:42.02,Flashbacks,,0,0,0,,Dikkatli düşünce mi?
Dialogue: 0,0:05:42.48,0:05:46.15,Flashbacks,,0,0,0,,Vay be. \NSen bile onun gibi sorun çıkarıyorsun.
Dialogue: 0,0:05:47.49,0:05:49.65,Flashbacks,,0,0,0,,Üzgünüm, Doktorin!
Dialogue: 0,0:05:49.65,0:05:51.32,Flashbacks,,0,0,0,,Bir daha yapmayacağım.
Dialogue: 0,0:05:51.32,0:05:54.79,Flashbacks,,0,0,0,,Bir daha yapmayacağım, lütfen beni kovama!
Dialogue: 0,0:05:56.32,0:06:00.29,Flashbacks,,0,0,0,,Aptal, bir an önce iyileş.
Dialogue: 0,0:06:00.29,0:06:01.95,Flashbacks,,0,0,0,,Alışverişe bile gidemiyorum!
Dialogue: 0,0:06:04.62,0:06:08.01,Main,,0,0,0,,Hayatın Dönüşü!{\fad(150,150)}
Dialogue: 0,0:06:08.74,0:06:10.55,Main,,0,0,0,,Saç Boğması!{\fad(150,150)}
Dialogue: 0,0:06:15.46,0:06:18.76,Main,,0,0,0,,A-Ağlama! Ağlama!
Dialogue: 0,0:06:18.76,0:06:22.11,Main,,0,0,0,,Ağlarsan, kendine adam diyemezsin!
Dialogue: 0,0:06:22.11,0:06:23.69,Thoughts,,0,0,0,,{\i1}Öldürüleceğim.{\i0}
Dialogue: 0,0:06:23.69,0:06:29.73,Main,,0,0,0,,Ağustos böceklerinin ağladığı\Nbir kasaba evini yad etmiyoruz.
Dialogue: 0,0:06:29.73,0:06:37.20,Main,,0,0,0,,Kendini hazırladın ve Cehennem ateşlerine giden\Nbu ölüm yolculuğuna çıkmaya karar verdin.
Dialogue: 0,0:06:37.20,0:06:41.14,Main,,0,0,0,,Yolcu edilirken bir gün geri dönme sözü verildi.
Dialogue: 0,0:06:41.14,0:06:44.38,Main,,0,0,0,,Dökülen meşe yaprakları çok kızıl!
Dialogue: 0,0:06:44.38,0:06:48.83,Main,,0,0,0,,Kıpırdama ve bunu kabullen!\NHadi, hadi, hadi, hadi!
Dialogue: 0,0:06:48.83,0:06:54.85,Main,,0,0,0,,Aydınlık bir kızıl... \NSaf Meşe Mayalanması!{\fad(150,150)}
Dialogue: 0,0:06:55.78,0:06:57.43,Thoughts,,0,0,0,,{\i1}Öleceğim.{\i0}
Dialogue: 0,0:07:00.42,0:07:04.27,Thoughts,,0,0,0,,{\i1}Robin. Evet, vazgeçemem.{\i0}
Dialogue: 0,0:07:08.17,0:07:10.55,Main,,0,0,0,,Saç Boğmamdan kaçtı!
Dialogue: 0,0:07:10.55,0:07:11.36,Main,,0,0,0,,Gümbürtü!{\fad(150,150)}
Dialogue: 0,0:07:15.16,0:07:18.95,Thoughts,,0,0,0,,{\i1}Öleceksem, yapacağım.{\i0}
Dialogue: 0,0:07:18.95,0:07:23.63,Thoughts,,0,0,0,,{\i1}Lütfen kimsenin\Nbu odaya gelmesine izin verme.{\i0}
Dialogue: 0,0:07:26.61,0:07:29.59,Flashbacks,,0,0,0,,Üç gümbürtü topu kullandım...
Dialogue: 0,0:07:29.59,0:07:34.55,Flashbacks,,0,0,0,,...ve sonra kendimden geçtim.\NDaha sonraysa...
Dialogue: 0,0:07:34.55,0:07:39.06,Flashbacks,,0,0,0,,Şeytan Meyvesi'nin yakıp yıkması diyebiliriz.
Dialogue: 0,0:07:39.06,0:07:43.52,Flashbacks,,0,0,0,,Bir daha asla o bölgeye geçme.
Dialogue: 0,0:07:43.52,0:07:49.49,Flashbacks,,0,0,0,,Dostlarını, düşmanlarını ve kendi\Nbedenini yok eden korkunç bir güç.
Dialogue: 0,0:07:49.49,0:07:52.21,Flashbacks,,0,0,0,,Neredeyse gerçek bir...
Dialogue: 0,0:07:56.78,0:07:58.82,Flashbacks,,0,0,0,,...canavar gibiydin!
Dialogue: 0,0:08:09.44,0:08:10.42,Main,,0,0,0,,Kahretsin.
Dialogue: 0,0:08:11.49,0:08:16.60,Main,,0,0,0,,Bu haftaki süper ben, \Nonunla umduğumdan daha fazla sorun yaşadı.
Dialogue: 0,0:08:20.16,0:08:21.56,Main,,0,0,0,,Ama...
Dialogue: 0,0:08:23.52,0:08:25.58,Main,,0,0,0,,...artık anahtarını aldım.
Dialogue: 0,0:08:29.08,0:08:30.94,Main,,0,0,0,,Dört numara, ha?
Dialogue: 0,0:08:31.44,0:08:35.44,Main,,0,0,0,,Kılıç ustası ve burun adam,\Niki numarayı istemişti, değil mi?
Dialogue: 0,0:08:35.85,0:08:37.68,Main,,0,0,0,,Bu adamın ki dört.
Dialogue: 0,0:08:37.68,0:08:39.36,Main,,0,0,0,,Onun ki üç.
Dialogue: 0,0:08:39.36,0:08:41.55,Main,,0,0,0,,O zaman geriye tek kişi kalıyor.
Dialogue: 0,0:08:41.55,0:08:45.68,Main,,0,0,0,,İki numaralı anahtar sekreter kadında olmalı.
Dialogue: 0,0:08:46.26,0:08:48.50,Main,,0,0,0,,Acele etsem iyi olur.
Dialogue: 0,0:08:48.50,0:08:50.34,Main,,0,0,0,,Yardıma gideceğim.
Dialogue: 0,0:09:13.54,0:09:16.20,Main,,0,0,0,,Pek vaktiniz yok, değil mi?
Dialogue: 0,0:09:16.20,0:09:19.58,Main,,0,0,0,,Geri durmayacağını söylediğini sanmıştım ama...
Dialogue: 0,0:09:19.58,0:09:22.20,Main,,0,0,0,,...yanlış mı duydum?
Dialogue: 0,0:09:22.20,0:09:25.04,Main,,0,0,0,,Benimle alay ediyor!\NSeni affetmeyeceğim!
Dialogue: 0,0:09:25.54,0:09:28.08,Main,,0,0,0,,Madem öyle, gel bakalım.
Dialogue: 0,0:09:28.08,0:09:33.34,Main,,0,0,0,,Beklemene gerek yok.\NDövüş çoktan başladı.
Dialogue: 0,0:09:33.34,0:09:38.97,Main,,0,0,0,,Bir Şeytan Meyvesi kullanıcısı,\Ndüşmanının önünde nasıl banyo yapabilir?
Dialogue: 0,0:09:38.97,0:09:42.85,Main,,0,0,0,,Bedeninin sadece yarısını kullanıyorsan, \Ngüçlerin minumum olmalı.
Dialogue: 0,0:09:43.35,0:09:47.02,Main,,0,0,0,,Bunun beni saldırıya açık hale\Ngetirdiğini mi söylemeye çalışıyorsun?
Dialogue: 0,0:09:51.15,0:09:53.78,Main,,0,0,0,,Bunu dert etmene gerek yok.
Dialogue: 0,0:09:53.78,0:09:57.03,Main,,0,0,0,,Senin güçlerin de sınırlı.
Dialogue: 0,0:09:57.03,0:09:58.39,Main,,0,0,0,,İzninle.
Dialogue: 0,0:10:07.08,0:10:09.54,Main,,0,0,0,,Bana ne yaptın?!
Dialogue: 0,0:10:11.69,0:10:17.67,Main,,0,0,0,,Bu gizemi çözmek de Şeytan Meyvesi \Nkullanıcısıyla dövüşmenin bir parçası, değil mi?
Dialogue: 0,0:10:23.43,0:10:28.10,Thoughts,,0,0,0,,{\i1}Sanji-kun'u o hale gelmesi kesinlikle bu kadının işi.{\i0}
Dialogue: 0,0:10:28.82,0:10:32.73,Thoughts,,0,0,0,,{\i1}Dikkatli olsam iyi olur, yoksa onun\Nyerine geçmenin bir anlamı kalmazdı.{\i0}
Dialogue: 0,0:10:35.41,0:10:38.65,Thoughts,,0,0,0,,{\i1}Gücüm biraz geri gelmeye başlıyor.{\i0}
Dialogue: 0,0:10:43.75,0:10:48.33,Main,,0,0,0,,Mükemmel İklim Aygıtı'nın \Ngüç kapasitesini sana göstereceğim!
Dialogue: 0,0:10:48.76,0:10:52.54,Main,,0,0,0,,Sadece sevimli, güzel bir kız olduğumu\Ndüşündüysen, ölümüne yanıldın!
Dialogue: 0,0:10:55.91,0:10:57.42,Main,,0,0,0,,{\i1}Bacaklarımı oynatabiliyorum.{\i0}
Dialogue: 0,0:11:02.76,0:11:04.52,Main,,0,0,0,,Geliyorum.
Dialogue: 0,0:11:05.47,0:11:07.22,Main,,0,0,0,,Gök Gürültüsü Saldırısı!{\fad(150,150)}
Dialogue: 0,0:11:09.63,0:11:11.28,Main,,0,0,0,,Sallanan Kol!{\fad(150,150)}
Dialogue: 0,0:11:25.72,0:11:27.41,Main,,0,0,0,,Ne ölümcül bir silah.
Dialogue: 0,0:11:31.61,0:11:33.08,Main,,0,0,0,,Bu...
Dialogue: 0,0:11:34.15,0:11:35.79,Main,,0,0,0,,...bulut mu?
Dialogue: 0,0:11:35.79,0:11:38.80,Main,,0,0,0,,Sessizce beni yenmene izin\Nvereceğimi düşünmedin, değil mi?
Dialogue: 0,0:11:40.01,0:11:44.80,Main,,0,0,0,,Yıldırım Tempo!{\fad(150,150)}
Dialogue: 0,0:11:56.13,0:11:59.32,Main,,0,0,0,,Bu kadar rahat olursan, olacağı budur.
Dialogue: 0,0:12:20.50,0:12:22.29,Main,,0,0,0,,Ne şaşırtıcı ama.
Dialogue: 0,0:12:22.29,0:12:25.43,Main,,0,0,0,,İçerideyken yıldırımla\Nkarşılaşacağımı hiç düşünmemiştim.
Dialogue: 0,0:12:27.18,0:12:31.03,Main,,0,0,0,,Ne?\NOnu yıldırımdan koruyan ne?
Dialogue: 0,0:12:31.03,0:12:33.15,Main,,0,0,0,,Köpüğe dönüştü ve yok oldu.
Dialogue: 0,0:12:33.15,0:12:36.86,Main,,0,0,0,,O gizemi çözene dek kazanma şansın yok.
Dialogue: 0,0:12:38.41,0:12:40.53,Main,,0,0,0,,Acaba bunu yapacak kapasitede misin?
Dialogue: 0,0:12:40.53,0:12:43.87,Main,,0,0,0,,Sanki sabun köpüğe dönüşüyormuş gibiydi.
Dialogue: 0,0:12:43.87,0:12:46.51,Main,,0,0,0,,Awa Awa Meyvesi, Sabun Kadın olabilir misin?
Dialogue: 0,0:12:43.87,0:12:46.51,Note,,0,0,0,,Awa - Köpük
Dialogue: 0,0:12:46.51,0:12:48.09,Main,,0,0,0,,Ya da ona benzer bir şey?
Dialogue: 0,0:12:49.70,0:12:53.43,Main,,0,0,0,,Ama yeteneğimi anlamış olsan bile...
Dialogue: 0,0:12:53.43,0:12:57.13,Main,,0,0,0,,...kazanabileceğin anlamına gelmez, küstah ahmak!
Dialogue: 0,0:12:57.13,0:13:00.00,Thoughts,,0,0,0,,{\i1}Tam hedefi tutturmuşum. \NNedense üzüldüm birden.{\i0}
Dialogue: 0,0:13:01.04,0:13:04.13,Main,,0,0,0,,Doğru. Temizlikten ötürü...
Dialogue: 0,0:13:04.51,0:13:07.07,Main,,0,0,0,,...Köpük Köpük Meyvesini yedim...
Dialogue: 0,0:13:07.07,0:13:09.85,Main,,0,0,0,,...ve bütün vücudum köpürerek \Nsabun insana dönüştü.
Dialogue: 0,0:13:13.40,0:13:14.77,Main,,0,0,0,,Güzel, değil mi?
Dialogue: 0,0:13:14.77,0:13:16.76,Main,,0,0,0,,Vah, çok seksi!
Dialogue: 0,0:13:16.78,0:13:18.56,Main,,0,0,0,,Onun gibi bir sekreterim olsaydı, \Ngerçekten mutlu olurdum.
Dialogue: 0,0:13:18.56,0:13:20.23,Main,,0,0,0,,BEN YAŞLI SAPIKLARDAN DEĞİLİM!
Dialogue: 0,0:13:20.73,0:13:25.57,Main,,0,0,0,,Ama aslında dövüşmek için değil, değil mi?\NPek etkili gibi görünmüyor.
Dialogue: 0,0:13:25.57,0:13:31.66,Main,,0,0,0,,Ama vücudumdan çıkan köpükler\Ntamamen kontrol edilebilir.
Dialogue: 0,0:13:34.62,0:13:36.19,Main,,0,0,0,,Ne?
Dialogue: 0,0:13:36.19,0:13:37.68,Main,,0,0,0,,Sana göstereyim.
Dialogue: 0,0:13:38.60,0:13:40.04,Main,,0,0,0,,Banyo köpükleri!
Dialogue: 0,0:13:40.54,0:13:42.42,Main,,0,0,0,,Köpük Ustası...{\fad(150,150)}
Dialogue: 0,0:13:42.74,0:13:44.46,Main,,0,0,0,,...Sabun Koyun!{\fad(150,150)}
Dialogue: 0,0:13:48.33,0:13:49.59,Main,,0,0,0,,Bu...
Dialogue: 0,0:13:51.29,0:13:52.92,Main,,0,0,0,,Nasıl? Güzel, değil mi?
Dialogue: 0,0:13:54.51,0:13:56.27,Main,,0,0,0,,Aptal mısın sen?
Dialogue: 0,0:13:57.13,0:13:59.27,Main,,0,0,0,,Görünüşüne bakıp karar verme.
Dialogue: 0,0:14:00.58,0:14:03.48,Main,,0,0,0,,Koyun Bulutu: Rahatlatıcı Köpük!{\fad(150,150)} {.}
Dialogue: 0,0:14:04.57,0:14:09.49,Main,,0,0,0,,Demin odaya girdiğinde niye güçlerini yitirdin?
Dialogue: 0,0:14:10.19,0:14:11.25,Thoughts,,0,0,0,,{\i1}Evet.{\i0}
Dialogue: 0,0:14:11.25,0:14:14.09,Thoughts,,0,0,0,,{\i1}Bu kadının yeteneği yüzünden olmalı.{\i0}
Dialogue: 0,0:14:14.09,0:14:15.21,Thoughts,,0,0,0,,{\i1}Köpük?{\i0}
Dialogue: 0,0:14:15.21,0:14:18.23,Thoughts,,0,0,0,,{\i1}Aslında bu odaya girer girmez...{\i0}
Dialogue: 0,0:14:21.83,0:14:23.84,Thoughts,,0,0,0,,{\i1}...yer köpükle kaplandı.{\i0}
Dialogue: 0,0:14:26.13,0:14:27.23,Main,,0,0,0,,Eyvah!
Dialogue: 0,0:14:33.68,0:14:35.43,Main,,0,0,0,,Çok geç farkettin.
Dialogue: 0,0:14:38.39,0:14:40.31,Main,,0,0,0,,Güçlerimi yitiriyorum ve demin...
Dialogue: 0,0:14:40.31,0:14:44.90,Main,,0,0,0,,...yerdeki köpüğe bastığım için öyle oldu.
Dialogue: 0,0:14:45.60,0:14:49.76,Main,,0,0,0,,Bu yeteneğin gerçek dehşetini\Nyavaşça keşfedeceksin.
Dialogue: 0,0:14:59.87,0:15:04.46,Main,,0,0,0,,Vücudumun ürettiği köpüklerin her şeyi\Ntemizleme ve parlatma yeteneği var.
Dialogue: 0,0:15:04.78,0:15:09.11,Main,,0,0,0,,Elbette güçle birlikte, pislikle\Ndonukluğu da ve diğer her şeyi.
Dialogue: 0,0:15:09.93,0:15:16.39,Main,,0,0,0,,Unutmamanı istediğim şey\Nbenim de bir suikastçi olduğum.
Dialogue: 0,0:15:18.83,0:15:22.43,Main,,0,0,0,,Bedenimi hareket ettirebiliyorum.\NÇünkü köpükler kayboldu.
Dialogue: 0,0:15:23.36,0:15:25.36,Main,,0,0,0,,Seni affetmeyeceğim.
Dialogue: 0,0:15:25.36,0:15:27.53,Main,,0,0,0,,Gök Gürültüsü Topu!{\fad(150,150)}
Dialogue: 0,0:15:30.04,0:15:31.52,Main,,0,0,0,,Tam olarak anlamadığım...
Dialogue: 0,0:15:32.37,0:15:33.77,Main,,0,0,0,,...tek şey o silah.
Dialogue: 0,0:15:36.58,0:15:39.29,Main,,0,0,0,,Altın Baloncuk!{\fad(150,150)}
Dialogue: 0,0:15:43.75,0:15:45.16,Main,,0,0,0,,Ne yapıyorsun?!
Dialogue: 0,0:15:48.33,0:15:50.68,Main,,0,0,0,,Ayakta duramıyorum.
Dialogue: 0,0:15:50.68,0:15:53.45,Main,,0,0,0,,Bacaklarıma ne olmuş böyle?!
Dialogue: 0,0:15:56.80,0:15:58.18,Main,,0,0,0,,Güzel, değil mi?
Dialogue: 0,0:15:58.18,0:16:03.31,Main,,0,0,0,,Dokunduğum her şeyin\Ncildini tamamiyle parlatarak,...
Dialogue: 0,0:16:03.31,0:16:06.23,Main,,0,0,0,,...güzelce parlamasını sağlıyor.
Dialogue: 0,0:16:06.93,0:16:09.99,Main,,0,0,0,,Bedeninin her parçasını.
Dialogue: 0,0:16:20.58,0:16:24.46,Main,,0,0,0,,Bir erkek için... Bir erkek için...
Dialogue: 0,0:16:24.80,0:16:33.43,Main,,0,0,0,,...asla kaçınamayacağı dövüşe giden bir yol vardır!
Dialogue: 0,0:16:33.43,0:16:34.88,Main,,0,0,0,,Kazı!{\fad(150,150)}
Dialogue: 0,0:16:34.88,0:16:37.73,Main,,0,0,0,,Bacak Fırtınası Nilüfer Açışı!{\fad(150,150)}
Dialogue: 0,0:16:41.59,0:16:42.80,Main,,0,0,0,,Al bakalım!
Dialogue: 0,0:16:42.80,0:16:46.02,Main,,0,0,0,,Saf Meşe Mayalanması!{\fad(150,150)}
Dialogue: 0,0:17:32.13,0:17:33.07,Main,,0,0,0,,Demir Parça!{\fad(150,150)}
Dialogue: 0,0:17:57.42,0:18:00.36,Main,,0,0,0,,Başka ne kaldı bilmiyorum...
Dialogue: 0,0:18:00.36,0:18:02.97,Main,,0,0,0,,...bu yüzden kolamı doldursam iyi olur.
Dialogue: 0,0:18:03.42,0:18:06.68,Main,,0,0,0,,Sahi, o geyiğe ne oldu acaba?
Dialogue: 0,0:18:10.00,0:18:12.36,Main,,0,0,0,,O da neydi?!
Dialogue: 0,0:18:23.70,0:18:25.87,Main,,0,0,0,,Ne bu...
Dialogue: 0,0:18:26.37,0:18:27.72,Main,,0,0,0,,...böyle?!
Dialogue: 0,0:18:32.79,0:18:36.55,Main,,0,0,0,,Bu adam buzdolabına kilitlenen CP9!
Dialogue: 0,0:18:36.55,0:18:39.76,Main,,0,0,0,,Onu bu canavar mı yendi?
Dialogue: 0,0:18:48.39,0:18:50.69,Main,,0,0,0,,Nedir bu böyle?!
Dialogue: 0,0:18:56.51,0:19:00.07,Main,,0,0,0,,O geyik de aynı tür şapkadan giymiyor muydu?
Dialogue: 0,0:19:00.46,0:19:04.42,Main,,0,0,0,,Hey, sen!\NSen şu geyik goril değilsin, değil mi?
Dialogue: 0,0:19:18.81,0:19:21.26,Main,,0,0,0,,Hey, bu doğru olamaz, değil mi?
Dialogue: 0,0:19:21.74,0:19:24.05,Main,,0,0,0,,Hiç şüphe yok!
Dialogue: 0,0:19:25.25,0:19:27.02,Main,,0,0,0,,Kumadori-{\i1}san!{\i0}
Dialogue: 0,0:19:27.02,0:19:30.16,Main,,0,0,0,,Adalet Kulesi'nden buraya dek\Nuçtuğunu mu söylemeye çalışıyorsun?!
Dialogue: 0,0:19:30.16,0:19:33.10,Main,,0,0,0,,Olamaz! Kim yapabilir ki...?
Dialogue: 0,0:19:35.11,0:19:39.07,Main,,0,0,0,,Cidden nesi var bunun?
Dialogue: 0,0:19:53.33,0:19:54.58,Thoughts,,0,0,0,,{\i1}Ses?{\i0}
Dialogue: 0,0:20:00.18,0:20:01.71,Main,,0,0,0,,Hey, acele et!
Dialogue: 0,0:20:01.71,0:20:05.47,Main,,0,0,0,,Ne diye duruyorsun, Nico Robin?
Dialogue: 0,0:20:06.00,0:20:10.58,Main,,0,0,0,,Hey, dinliyor musun?!\NSen, varlığı günah olan kadın!
Dialogue: 0,0:20:10.58,0:20:13.03,Main,,0,0,0,,Hey, Lucci! Getir şunu!
Dialogue: 0,0:20:13.03,0:20:15.15,Main,,0,0,0,,Saçından çek!
Dialogue: 0,0:20:19.27,0:20:20.44,Main,,0,0,0,,Bu bir emir.
Dialogue: 0,0:20:20.44,0:20:23.10,Main,,0,0,0,,İlerle, Nico Robin.
Dialogue: 0,0:20:26.03,0:20:33.45,Main,,0,0,0,,Yoksa hala Hasır Şapka tayfasından birinin seni\Nkurtarmaya geldiğini mi düşünüyorsun?
Dialogue: 0,0:20:34.66,0:20:36.12,Main,,0,0,0,,Seni aptal!
Dialogue: 0,0:20:36.12,0:20:41.45,Main,,0,0,0,,Onlar gibi bu kadar güçsüz görünen korsanlar\Nnasıl tek umudun olabilir?
Dialogue: 0,0:20:41.45,0:20:44.80,Main,,0,0,0,,Muhtemelen deminki gürültü sadece bize öyle geldi.
Dialogue: 0,0:20:44.80,0:20:47.18,Main,,0,0,0,,Buraya gelebilmeleri mümkün değil!
Dialogue: 0,0:20:47.18,0:20:53.02,Main,,0,0,0,,Sen o aptalca hayali görmeye devam ederken,\NAdalet Kapıları'ndan geçeceğiz.
Dialogue: 0,0:20:53.72,0:20:58.25,Main,,0,0,0,,Adalet Kapıları'nın önünde Tereddüt Köprüsü vardır.
Dialogue: 0,0:20:58.25,0:21:01.08,Main,,0,0,0,,O yarı indirilmiş köprüyü geçip...
Dialogue: 0,0:21:01.08,0:21:05.96,Main,,0,0,0,,...kapılardan geçeceğiz.\NSonra köprünün diğer yarısı yükseltilecek.
Dialogue: 0,0:21:05.97,0:21:08.61,Main,,0,0,0,,...ve nihayet Adalet Kapıları'nda geçeceğiz.
Dialogue: 0,0:21:09.49,0:21:12.41,Main,,0,0,0,,Kapılar tekrar kapanınca,...
Dialogue: 0,0:21:12.41,0:21:17.80,Main,,0,0,0,,...bir daha "umut" hissini asla yaşayamayacaksın.
Dialogue: 0,0:21:17.80,0:21:20.45,Main,,0,0,0,,Bir daha asla.
Dialogue: 0,0:21:20.45,0:21:25.05,Main,,0,0,0,,Hissetmene izin verilen tek duygu,\Nyaptıklarının suçluluğudur.
Dialogue: 0,0:21:25.05,0:21:30.85,Main,,0,0,0,,Bu güne kadar yaşamış olmanın suçu!\NBunu ödemeye devam edeceksin!
Dialogue: 0,0:21:30.85,0:21:33.68,Main,,0,0,0,,Değil mi, Nico Robin?!
Dialogue: 0,0:21:48.70,0:21:50.41,Main,,0,0,0,,Pekâla, acele edelim.
Dialogue: 0,0:21:50.41,0:21:52.27,Main,,0,0,0,,Hemen gel!
Dialogue: 0,0:21:57.93,0:22:05.76,Main,,0,0,0,,ROBIN!
Dialogue: 0,0:22:13.45,0:22:16.62,Main,,0,0,0,,O da neydi?! Birinin sesiydi!
Dialogue: 0,0:22:16.62,0:22:18.64,Main,,0,0,0,,Hey! O ses neydi öyle?!
Dialogue: 0,0:22:21.52,0:22:26.32,Main,,0,0,0,,Şef, lütfen Nico Robin'i alın ve önden gidin.
Dialogue: 0,0:22:28.08,0:22:30.06,Main,,0,0,0,,Kapı!
Dialogue: 0,0:22:30.86,0:22:34.58,Main,,0,0,0,,Bu seferki çelikten yapılmış gibi görünmüyor.
Dialogue: 0,0:22:45.64,0:22:49.18,Main,,0,0,0,,Aniden her yer genişledi. Neresi burası?!
Dialogue: 0,0:22:51.77,0:22:54.47,Main,,0,0,0,,Buldum seni, güvercinli pislik!
Dialogue: 0,0:22:57.43,0:22:59.31,Main,,0,0,0,,İyi iş çıkardın!
Dialogue: 0,0:22:57.43,0:23:00.60,Credits,,0,0,0,,Editing:\N Galaxy 9000\N\NTiming:\NGalaxy 9000,\NKaitouYahiko\N\NQuality Control:\Ndanpmss,\NDolphinWeabu,\NHonoka,\NGalaxy 9000,\NPepperjack\N\NSoundtracking:\N Halee\N\NGraphics:\N Datenshi\N\NKaraoke:\NKaitouYahiko\N\NTranslation:\NCrunchyroll,\NGaijin
