Dialogue: 0,0:01:50.00,0:01:52.90,Author,,0,0,0,,{\an2\fad(440,0)\fs17} Türkçeleştirme & Çevirmen  {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&} - {\c&H01BAFF&}{\b1}kazasker{\b0}{\c&HFFFFFF&}\N{\fs18}thx to onepace.net
Dialogue: 0,0:21:07.20,0:21:09.53,Author,,0,0,0,,{\fad(0,0)\fs17} Türkçeleştirme & Çevirmen  {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&} - {\c&H01BAFF&}{\b1}kazasker{\b0}{\c&HFFFFFF&}\N{\fs18}thx to onepace.net
Dialogue: 0,0:01:50.00,0:01:52.90,Title,,0,0,250,,{\fad(440,0)}The Hunter
Dialogue: 0,0:01:53.90,0:01:55.68,Main,,0,0,0,,Deminki seraplar.
Dialogue: 0,0:01:55.68,0:01:57.72,Main,,0,0,0,,Sadece biri mi gerçek?
Dialogue: 0,0:01:57.72,0:02:00.25,Main,,0,0,0,,Evet. Bir tanesi benim.
Dialogue: 0,0:02:00.25,0:02:05.18,Main,,0,0,0,,Diğerleriyse aşırı soğuğun neden olduğu çarpıtmalar. Havanın kendi içinde ilüzyonlar.
Dialogue: 0,0:02:06.25,0:02:08.23,Main,,0,0,0,,İlüzyonlar mı?
Dialogue: 0,0:02:08.23,0:02:11.25,Main,,0,0,0,,Ne kadar gizemli ve güzel.
Dialogue: 0,0:02:11.25,0:02:17.24,Main,,0,0,0,,Ama düşünürsen, ilüzyonların\Nsaldırılardan yara almayacağını farkedersin.
Dialogue: 0,0:02:17.24,0:02:21.03,Main,,0,0,0,,Yani bunun tek mantığı beni yanıltmak.
Dialogue: 0,0:02:21.03,0:02:22.24,Main,,0,0,0,,Aynen öyle.
Dialogue: 0,0:02:23.02,0:02:26.33,Main,,0,0,0,,Bu iş ciddileşiyor. Hiç de hoş değil.
Dialogue: 0,0:02:26.33,0:02:27.41,Main,,0,0,0,,Gök Gürültüsü Saldırısı!{\fad(150,150)}
Dialogue: 0,0:02:29.25,0:02:32.27,Main,,0,0,0,,Gerçek ben, bu beşlinin arasında.
Dialogue: 0,0:02:32.27,0:02:34.27,Main,,0,0,0,,Ne olmuş?
Dialogue: 0,0:02:34.27,0:02:35.76,Main,,0,0,0,,Ve...
Dialogue: 0,0:02:35.76,0:02:37.27,Main,,0,0,0,,Gök Gürültüsü Topu!{\fad(150,150)}
Dialogue: 0,0:02:38.17,0:02:42.76,Main,,0,0,0,,Bu saldırıların sadece %20'si gerçek.\NHepsini atlatabilir misin?
Dialogue: 0,0:02:43.28,0:02:44.89,Thoughts,,0,0,0,,{\i1}Hayır. Tetikte olmalıyım!{\i0}
Dialogue: 0,0:02:45.32,0:02:46.31,Thoughts,,0,0,0,,{\i1}Sen ne-{\i0}
Dialogue: 0,0:02:49.27,0:02:51.66,Main,,0,0,0,,Ama o, gücün %100'üydü.
Dialogue: 0,0:03:03.66,0:03:06.48,Main,,0,0,0,,İklim Aygıtı öncekinden çok farklı.
Dialogue: 0,0:03:06.48,0:03:09.41,Main,,0,0,0,,Basit bir Gök Gürültüsü Topu'nda bu kadar güç var.
Dialogue: 0,0:03:09.41,0:03:12.83,Main,,0,0,0,,Sıradaki büyük saldırımla seni yeneceğim.
Dialogue: 0,0:03:13.48,0:03:17.84,Main,,0,0,0,,Ne diye böyle sözler veriyorsun?\NÇok ukalasın!
Dialogue: 0,0:03:17.84,0:03:20.51,Main,,0,0,0,,Söz değil. Tahmin.
Dialogue: 0,0:03:20.51,0:03:22.90,Main,,0,0,0,,Nem ve sıcaklık üzerinde kontrolüm var.
Dialogue: 0,0:03:22.90,0:03:25.64,Main,,0,0,0,,Bu odadaki hava tamamiyle benim!
Dialogue: 0,0:03:26.51,0:03:29.23,Main,,0,0,0,,Havayı kontrol etmen niye önemli olsun ki?
Dialogue: 0,0:03:29.23,0:03:31.98,Main,,0,0,0,,Altı Stil, tüm insan yeteneklerinin\Nüstesinden gelir!
Dialogue: 0,0:03:31.98,0:03:33.10,Main,,0,0,0,,Küstah kız!
Dialogue: 0,0:03:34.14,0:03:35.40,Main,,0,0,0,,O gerçek olan değil miydi?
Dialogue: 0,0:03:35.40,0:03:39.15,Main,,0,0,0,,Gerçek olanı bulma olasılığın %20.
Dialogue: 0,0:03:46.81,0:03:50.68,Main,,0,0,0,,Bugünkü havada\Ndengeli bir basınç içinde...
Dialogue: 0,0:03:50.68,0:03:54.46,Main,,0,0,0,,...sert hava akımları ve \Nbirkaç fırtına bulutu olacak.
Dialogue: 0,0:03:54.46,0:03:58.55,Main,,0,0,0,,Çok yakında yıldırım ve gök gürültüsü,\Ngöğsünü bile delip geçebilir.
Dialogue: 0,0:03:58.55,0:04:02.26,Main,,0,0,0,,Kalp uyuşukluğuna dikkat et!
Dialogue: 0,0:04:02.26,0:04:04.43,Main,,0,0,0,,Kara Bulut Tempo!{\fad(150,150)}
Dialogue: 0,0:04:04.43,0:04:08.24,Main,,0,0,0,,Yıldırıma karşı nasıl korunduğumu\Nsana daha önce göstermiştim.
Dialogue: 0,0:04:08.24,0:04:09.64,Main,,0,0,0,,Sadece hazır olmalıyım!
Dialogue: 0,0:04:09.64,0:04:14.65,Main,,0,0,0,,Öyle korunurken hareket\Nedememe dezavantajına sahipsin.
Dialogue: 0,0:04:18.45,0:04:20.38,Main,,0,0,0,,Beni hafife alma.
Dialogue: 0,0:04:20.41,0:04:23.32,Main,,0,0,0,,Onu basit bir saldırıyla\Nyenebileceğini mi söylüyorsun?
Dialogue: 0,0:04:23.42,0:04:24.54,Main,,0,0,0,,İyi.
Dialogue: 0,0:04:24.54,0:04:26.37,Main,,0,0,0,,Sabun Koyun!{\fad(150,150)}
Dialogue: 0,0:04:27.00,0:04:29.35,Main,,0,0,0,,Sadece gerçek olana vurmama gerek yok.
Dialogue: 0,0:04:29.35,0:04:33.46,Main,,0,0,0,,"Rahatlatıcı Köpük" dalgasıyla hepinizi yutacağım!
Dialogue: 0,0:04:35.25,0:04:36.33,Main,,0,0,0,,Koyun Bulutu...{\fad(150,150)}
Dialogue: 0,0:04:38.55,0:04:40.50,Main,,0,0,0,,...Gelgit Dalgası!{\fad(150,150)}
Dialogue: 0,0:04:46.22,0:04:48.26,Main,,0,0,0,,Bana vurursa her şey biter!
Dialogue: 0,0:04:48.26,0:04:51.18,Main,,0,0,0,,Resmen yutulmuş olan, gerçek sen olacaksın!
Dialogue: 0,0:04:51.18,0:04:53.68,Main,,0,0,0,,Bunun olmasına izin vereceğimi mi sanıyorsun?
Dialogue: 0,0:04:53.68,0:04:55.39,Main,,0,0,0,,Siklon Tempo!{\fad(150,150)}
Dialogue: 0,0:04:57.34,0:04:59.63,Main,,0,0,0,,Onları rüzgarla uçuruyor!
Dialogue: 0,0:05:06.56,0:05:10.44,Main,,0,0,0,,Ama kurtulan gerçek olan olmalı!
Dialogue: 0,0:05:22.30,0:05:23.74,Main,,0,0,0,,Parmak Tabanca!{\fad(150,150)}
Dialogue: 0,0:05:25.17,0:05:28.44,Main,,0,0,0,,Ah, senin de ilüzyon olduğunu sanmıştım.
Dialogue: 0,0:05:30.17,0:05:32.15,Main,,0,0,0,,Artık kaçamazsın.
Dialogue: 0,0:05:32.15,0:05:35.14,Main,,0,0,0,,Seni delik deşik edeceğim.
Dialogue: 0,0:05:40.18,0:05:42.11,Main,,0,0,0,,Unuttun mu?
Dialogue: 0,0:05:43.07,0:05:47.03,Main,,0,0,0,,Bir rotacının hava tahminini dinlemelisin.
Dialogue: 0,0:05:52.56,0:05:55.17,Main,,0,0,0,,Yıldırım, fırtına bulutundan...
Dialogue: 0,0:05:55.17,0:05:56.75,Main,,0,0,0,,...İklim Aygıtı'na gelecek.
Dialogue: 0,0:06:04.01,0:06:04.51,Main,,0,0,0,,Gel!
Dialogue: 0,0:06:08.80,0:06:10.15,Thoughts,,0,0,0,,Deminki...
Dialogue: 0,0:06:15.21,0:06:17.14,Main,,0,0,0,,Gök Gürültüsü Mızrağı Tempo!{\fad(150,150)}
Dialogue: 0,0:06:22.38,0:06:24.23,Main,,0,0,0,,Ne kadar güçlü olursan ol,...
Dialogue: 0,0:06:24.23,0:06:26.94,Main,,0,0,0,,...tahminim her zaman doğrudur.
Dialogue: 0,0:06:45.19,0:06:48.61,Main,,0,0,0,,Arkadaşım bekliyor. Anahtarını alıyorum!
Dialogue: 0,0:06:55.76,0:06:58.54,Main,,0,0,0,,Geyik goril, neredesin?
Dialogue: 0,0:06:58.54,0:07:01.76,Main,,0,0,0,,Franky? Niye oradasın?
Dialogue: 0,0:07:01.76,0:07:02.95,Main,,0,0,0,,Ah, onee-chan.
Dialogue: 0,0:07:04.65,0:07:07.77,Main,,0,0,0,,Sizin şu geyik goril bu tarafa geldi, değil mi?
Dialogue: 0,0:07:07.77,0:07:09.98,Main,,0,0,0,,Geyik? Chopper?
Dialogue: 0,0:07:09.98,0:07:11.99,Main,,0,0,0,,Evet, o geyik goril.
Dialogue: 0,0:07:11.99,0:07:16.29,Main,,0,0,0,,Evet, geldi! Neydi o öyle?\NChopper'a ne oldu?!
Dialogue: 0,0:07:16.29,0:07:18.22,Main,,0,0,0,,Ne bileyim! Sana soracaktım!
Dialogue: 0,0:07:18.22,0:07:21.96,Main,,0,0,0,,O tür bir şeye dönüşemiyor mu?
Dialogue: 0,0:07:21.96,0:07:25.17,Main,,0,0,0,,Bilmiyorum, daha önce onu hiç böyle görmedim!
Dialogue: 0,0:07:25.17,0:07:30.01,Main,,0,0,0,,Öyle mi? Onunla nasıl uğraşacağınızı bildiğinizi düşünmüştüm.
Dialogue: 0,0:07:30.01,0:07:32.84,Main,,0,0,0,,O zaman öldürelim onu gitsin.
Dialogue: 0,0:07:34.76,0:07:38.44,Main,,0,0,0,,Bunu bir daha söylersen, \Nseni öldüren ben olacağım!
Dialogue: 0,0:07:38.44,0:07:41.39,Main,,0,0,0,,Bir daha söylemeyeceğim. Bir daha asla.
Dialogue: 0,0:07:43.23,0:07:47.56,Main,,0,0,0,,Neyse, iyi iş!\NBu kadının işini bitirdin mi?
Dialogue: 0,0:07:47.56,0:07:50.90,Main,,0,0,0,,Ondaki 2 numaralı anahtara ihtiyacımız var.
Dialogue: 0,0:07:50.90,0:07:54.32,Main,,0,0,0,,Anahtar? Biraz bekle. Ben de onu arıyordum.
Dialogue: 0,0:07:54.76,0:07:57.78,Main,,0,0,0,,Anahtar, anahtar. Nereye saklamış?
Dialogue: 0,0:07:58.38,0:08:00.14,Main,,0,0,0,,Bu harika!
Dialogue: 0,0:08:00.94,0:08:03.17,Main,,0,0,0,,O canavar da ne öyle?
Dialogue: 0,0:08:03.76,0:08:07.62,Main,,0,0,0,,Bir zoan meyvesi kullanıcısı daha mı vardı?
Dialogue: 0,0:08:07.62,0:08:09.97,Main,,0,0,0,,Bu adam da mı CP9'dan?
Dialogue: 0,0:08:09.97,0:08:13.47,Main,,0,0,0,,Ama tanıdık görünüyor.
Dialogue: 0,0:08:14.30,0:08:16.05,Main,,0,0,0,,Ch-Chopper?!
Dialogue: 0,0:08:21.30,0:08:23.69,Main,,0,0,0,,Chopper, biziz!
Dialogue: 0,0:08:23.69,0:08:25.60,Main,,0,0,0,,Kes şunu!
Dialogue: 0,0:08:27.77,0:08:31.24,Main,,0,0,0,,Hey, o şey gerçekten Chopper mı?\NNiye bizi tanımıyor?!
Dialogue: 0,0:08:31.42,0:08:36.42,Main,,0,0,0,,Bilmiyorum ama Chopper olmalı!\NÖyle şapkası ve boynuzları olan başka bir şey yok!
Dialogue: 0,0:08:36.42,0:08:39.51,Main,,0,0,0,,Peki o zaman umudumuz?\Nİki numaralı anahtar?
Dialogue: 0,0:08:39.51,0:08:42.65,Main,,0,0,0,,Bilmiyorum, işimiz bitti. Öleceğiz.
Dialogue: 0,0:08:42.65,0:08:45.33,Main,,0,0,0,,Ama tuhaf.
Dialogue: 0,0:08:46.10,0:08:49.84,Main,,0,0,0,,Ölüme yakın olan o gibi görünüyor.
Dialogue: 0,0:08:49.84,0:08:52.86,Main,,0,0,0,,Yaşam gücü gerçekten hızlı tükeniyor.
Dialogue: 0,0:08:52.86,0:08:55.85,Main,,0,0,0,,N-Neden bahsediyorsun?
Dialogue: 0,0:08:55.85,0:09:00.43,Main,,0,0,0,,O şekilde olmak muazzam miktarda\Nenerji kullanıyormuş gibi.
Dialogue: 0,0:09:00.43,0:09:04.07,Main,,0,0,0,,Ne?! Bu konuda ne yapabiliriz?
Dialogue: 0,0:09:04.07,0:09:07.61,Main,,0,0,0,,Ya anahtar?!\Nİki numaralı anahtar nerede?!
Dialogue: 0,0:09:07.61,0:09:09.89,Main,,0,0,0,,Ne olduğunu bilmiyorum...
Dialogue: 0,0:09:09.89,0:09:13.85,Main,,0,0,0,,...ama muhtemelen elinden geldiğince dövüştü...
Dialogue: 0,0:09:14.63,0:09:16.91,Main,,0,0,0,,...ve o şeye dönüştü.
Dialogue: 0,0:09:16.91,0:09:18.12,Main,,0,0,0,,Şimdi...
Dialogue: 0,0:09:22.70,0:09:26.75,Main,,0,0,0,,Çok fazla sorun çıkarıyor.\NO yaratık ne öyle?
Dialogue: 0,0:09:26.75,0:09:29.09,Main,,0,0,0,,Yıkım Çağrısı ise hala yaklaşıyor.
Dialogue: 0,0:09:29.09,0:09:32.71,Main,,0,0,0,,Sinir bozucu. Bu yüzden korsanlardan biri olmalı.
Dialogue: 0,0:09:33.63,0:09:35.07,Main,,0,0,0,,Engel oluyorsa,...
Dialogue: 0,0:09:35.07,0:09:36.82,Main,,0,0,0,,...ondan kurtulmamız gerek.
Dialogue: 0,0:09:39.84,0:09:41.08,Main,,0,0,0,,Güçsüz ama...
Dialogue: 0,0:09:41.08,0:09:43.85,Main,,0,0,0,,...bu şekilde bir şey elde ederiz.
Dialogue: 0,0:09:43.85,0:09:46.51,Main,,0,0,0,,Kahretsin! Chopper'ı haklayacaklar!
Dialogue: 0,0:09:46.51,0:09:49.08,Main,,0,0,0,,Düzleştir kendini, Burun Fırtınası!
Dialogue: 0,0:09:49.08,0:09:51.77,Main,,0,0,0,,Ne yapıyorsun?!
Dialogue: 0,0:09:51.77,0:09:54.22,Main,,0,0,0,,36 Pound'luk Top!{\fad(150,150)}
Dialogue: 0,0:09:56.90,0:09:58.07,Main,,0,0,0,,Pislik.
Dialogue: 0,0:09:58.85,0:10:00.19,Main,,0,0,0,,Yoldan çekilin çocuklar!
Dialogue: 0,0:10:00.19,0:10:02.28,Main,,0,0,0,,– Ha?\N– O...!
Dialogue: 0,0:10:02.28,0:10:04.62,Main,,0,0,0,,Franky! Ne yapmaya çalışıyorsun,...
Dialogue: 0,0:10:04.62,0:10:05.87,Main,,0,0,0,,...bu adamlar bizim-
Dialogue: 0,0:10:05.87,0:10:07.96,Main,,0,0,0,,Biliyorum, kapa çeneni.
Dialogue: 0,0:10:11.86,0:10:14.83,Main,,0,0,0,,Tek çözüm bu.
Dialogue: 0,0:10:14.83,0:10:16.92,Main,,0,0,0,,Şeytan Meyvesi kullanıcılarının\Nbir tek zayıflığı vardır.
Dialogue: 0,0:10:16.92,0:10:18.87,Main,,0,0,0,,Onu denize uçuracağım.
Dialogue: 0,0:10:18.87,0:10:21.43,Main,,0,0,0,,Üzgünüm ama bu yapmak zorunda olduğum bir şey!
Dialogue: 0,0:10:23.14,0:10:24.91,Main,,0,0,0,,Güçlü...{\fad(150,150)}
Dialogue: 0,0:10:26.81,0:10:27.77,Main,,0,0,0,,...Rüzgar!{\fad(150,150)}
Dialogue: 0,0:10:37.57,0:10:40.84,Main,,0,0,0,,Franky, seni pislik! Ne yapıyorsun?
Dialogue: 0,0:10:40.84,0:10:43.33,Main,,0,0,0,,Öyle bir şeyi arkadaşımıza yapamazsın!
Dialogue: 0,0:10:43.86,0:10:47.18,Main,,0,0,0,,Endişelenmeyin.\NBunu zaten birlikte çalıştık.
Dialogue: 0,0:10:47.18,0:10:48.29,Main,,0,0,0,,Ha?
Dialogue: 0,0:11:01.09,0:11:05.29,Main,,0,0,0,,Öyle bir şey yaparak\Nne yapmaya çalışıyorlar?
Dialogue: 0,0:11:05.29,0:11:08.14,Main,,0,0,0,,Cidden sinir bozucu bir grup.
Dialogue: 0,0:11:16.94,0:11:18.44,Main,,0,0,0,,Nihayet özgür müsünüz?
Dialogue: 0,0:11:19.84,0:11:22.41,Main,,0,0,0,,Gülme, pişman olmalısın.
Dialogue: 0,0:11:22.94,0:11:29.95,Main,,0,0,0,,Deminki gibi beni öldürme şansı\Nbir daha asla eline geçmeyecek.
Dialogue: 0,0:11:31.30,0:11:33.08,Main,,0,0,0,,Dünya Hükümeti!
Dialogue: 0,0:11:33.59,0:11:35.46,Main,,0,0,0,,Savaş gemileri saldırmaya geliyor!
Dialogue: 0,0:11:35.46,0:11:36.84,Main,,0,0,0,,Enies Lobby'den çıkın!
Dialogue: 0,0:11:36.84,0:11:38.72,Main,,0,0,0,,Ateş etmeye başlayacaklar!
Dialogue: 0,0:11:38.72,0:11:40.26,Main,,0,0,0,,Herkes adadan çıksın!
Dialogue: 0,0:11:40.26,0:11:42.17,Main,,0,0,0,,Yıkım Çağrısı'na yakalanacağız!
Dialogue: 0,0:11:42.17,0:11:44.81,Main,,0,0,0,,Burada kalırsak öleceğiz!
Dialogue: 0,0:11:51.77,0:11:54.79,Main,,0,0,0,,Dur, Nico Robin!
Dialogue: 0,0:11:55.76,0:11:59.80,Main,,0,0,0,,Geri dönsen bile korsanlar ölmüş olacak!
Dialogue: 0,0:12:03.83,0:12:05.45,Main,,0,0,0,,Aptallaşmayı bırak!
Dialogue: 0,0:12:07.12,0:12:09.88,Main,,0,0,0,,Gösterelim ona, Funkfreed!
Dialogue: 0,0:12:12.04,0:12:14.42,Thoughts,,0,0,0,,{\i1}Luffy orada.{\i0}
Dialogue: 0,0:12:16.67,0:12:18.81,Main,,0,0,0,,Onu öldürme.
Dialogue: 0,0:12:20.84,0:12:23.46,Main,,0,0,0,,Fildişi...{\fad(150,150)}
Dialogue: 0,0:12:23.46,0:12:24.82,Main,,0,0,0,,...Ok!{\fad(150,150)}
Dialogue: 0,0:12:41.06,0:12:43.59,Main,,0,0,0,,Kaçamazsın, aptal!
Dialogue: 0,0:12:43.59,0:12:45.20,Main,,0,0,0,,Benimle uğraşma!
Dialogue: 0,0:12:45.82,0:12:49.99,Main,,0,0,0,,Şimdi, hayaller kapısına birlikte gidelim.
Dialogue: 0,0:12:55.84,0:12:57.78,Main,,0,0,0,,Normale döndü.
Dialogue: 0,0:13:02.05,0:13:04.22,Main,,0,0,0,,Ölmüş gibi görünmüyor.
Dialogue: 0,0:13:04.22,0:13:08.14,Main,,0,0,0,,Arkadaşları onunla nasıl\Nuğraşacaklarını bilmiyorlardı bile.
Dialogue: 0,0:13:08.14,0:13:11.44,Flashbacks,,0,0,0,,Nico Robin'i kurtarmak istemiyor musun?!
Dialogue: 0,0:13:11.44,0:13:13.42,Flashbacks,,0,0,0,,İstiyorum!
Dialogue: 0,0:13:13.42,0:13:18.56,Main,,0,0,0,,Neyse, CP9 üyelerinden birini hallettin.
Dialogue: 0,0:13:20.07,0:13:27.24,Main,,0,0,0,,Beni yaralamış olsan bile arkadaşının\Nhatrına seni affedeceğim.
Dialogue: 0,0:13:29.31,0:13:31.27,Main,,0,0,0,,Gitme vakti.
Dialogue: 0,0:13:33.28,0:13:38.60,Main,,0,0,0,,Hayır, acele etsem bile \NAdalet Kapısı'na nasıl ulaşacağım?
Dialogue: 0,0:13:40.26,0:13:42.28,Main,,0,0,0,,Yolu göster!
Dialogue: 0,0:13:43.90,0:13:45.04,Main,,0,0,0,,Çocuklar!
Dialogue: 0,0:13:45.04,0:13:46.59,Main,,0,0,0,,Franky'yi bulduk!
Dialogue: 0,0:13:48.51,0:13:51.93,Main,,0,0,0,,Ne? Adalet Kapısı'na giden\Nbir tünel mi biliyorsunuz?
Dialogue: 0,0:13:51.93,0:13:55.83,Main,,0,0,0,,Biliyoruz! İnsanlara göstermek için buradayız!
Dialogue: 0,0:13:57.39,0:13:59.15,Main,,0,0,0,,Ninem de burada.
Dialogue: 0,0:13:59.15,0:14:01.17,Main,,0,0,0,,Hemen nerede olduğunu gösterin!
Dialogue: 0,0:14:01.17,0:14:04.39,Main,,0,0,0,,O zaman size ve Kokoro'ya ne\Nyapmanız gerektiğini söyleyebilirim.
Dialogue: 0,0:14:04.39,0:14:05.26,Main,,0,0,0,,Anlaşıldı.
Dialogue: 0,0:14:08.84,0:14:12.37,Main,,0,0,0,,Kendinden geçmiş ama iyi gibi görünüyor.
Dialogue: 0,0:14:12.37,0:14:17.66,Main,,0,0,0,,Hayır! Önden gitmeli ve Nico Robin'e\Nbu anahtarları ulaştırmalıyım!
Dialogue: 0,0:14:18.12,0:14:20.67,Main,,0,0,0,,Siz geyiği alın ve peşimden gelin!
Dialogue: 0,0:14:20.67,0:14:24.31,Main,,0,0,0,,– Tamam.\N– Anlaşıldı! İyi şanslar, Franky!
Dialogue: 0,0:14:29.24,0:14:33.31,Flashbacks,,0,0,0,,Demek Chopper'ı durdurmanın tek yolu bu.
Dialogue: 0,0:14:33.31,0:14:38.35,Flashbacks,,0,0,0,,Üç ve dört no'lu anahtarları\Nal ve hemen Robin'e git.
Dialogue: 0,0:14:38.35,0:14:41.77,Flashbacks,,0,0,0,,Bunlardan biri Robin'in kelepçesini açabilir.
Dialogue: 0,0:14:41.77,0:14:45.70,Flashbacks,,0,0,0,,Biri işe yararsa, beni bu seketerin\Nküçük Den Den Mushi'sinden ara.
Dialogue: 0,0:14:45.70,0:14:47.31,Flashbacks,,0,0,0,,Tamam.
Dialogue: 0,0:14:48.36,0:14:51.99,Flashbacks,,0,0,0,,Ben Zoro ve Burun Kral'ı kurtarmaya gideceğim!
Dialogue: 0,0:14:51.99,0:14:54.60,Flashbacks,,0,0,0,,Kulağa hoş geliyor ama sonra ne olacak?
Dialogue: 0,0:14:54.60,0:15:02.82,Flashbacks,,0,0,0,,Nico Robin'i kurtarsak bile, bu kuleden\NEnies Lobby'ye köprü bağlantısı yok.
Dialogue: 0,0:15:02.84,0:15:03.84,Flashbacks,,0,0,0,,Geri dönemeyeceğiz!
Dialogue: 0,0:15:03.84,0:15:05.35,Flashbacks,,0,0,0,,Evet.
Dialogue: 0,0:15:05.35,0:15:10.47,Flashbacks,,0,0,0,,Yıkım Çağrısı gelirken, geri dönmek\Niçin vaktimiz bile olmayacak.
Dialogue: 0,0:15:10.47,0:15:11.14,Flashbacks,,0,0,0,,O zaman...
Dialogue: 0,0:15:11.14,0:15:14.30,Flashbacks,,0,0,0,,Bu yüzden ne yapmamız gerektiğini biliyoruz!
Dialogue: 0,0:15:17.23,0:15:19.70,Flashbacks,,0,0,0,,Arkamızda "ölüm şelalesi", önümüzde "gizem yolu".
Dialogue: 0,0:15:19.70,0:15:20.81,Flashbacks,,0,0,0,,Hangisini seçerdin?
Dialogue: 0,0:15:20.81,0:15:22.56,Flashbacks,,0,0,0,,Elbette önü.
Dialogue: 0,0:15:22.56,0:15:28.36,Flashbacks,,0,0,0,,Bu yüzden kulede işimiz bitince\Nherkes Adalet Kapısı'na gidecek!
Dialogue: 0,0:15:28.36,0:15:30.36,Flashbacks,,0,0,0,,Ondan sonrasını bırak...
Dialogue: 0,0:15:30.36,0:15:32.02,Flashbacks,,0,0,0,,– Sana mı?\N– Şansa!
Dialogue: 0,0:15:32.02,0:15:33.62,Flashbacks,,0,0,0,,Şansa mı?!
Dialogue: 0,0:15:41.02,0:15:42.03,Main,,0,0,0,,Çok fazla...
Dialogue: 0,0:15:42.03,0:15:43.75,Main,,0,0,0,,...vakit kaybettik.
Dialogue: 0,0:15:45.71,0:15:46.96,Main,,0,0,0,,Gerçekten kaybettiniz!
Dialogue: 0,0:15:47.12,0:15:50.17,Main,,0,0,0,,Böyle bir zamanda ikiniz\Nnasıl aylaklık edebilirsiniz?!
Dialogue: 0,0:15:50.17,0:15:53.13,Main,,0,0,0,,Çünkü o aptallık etti.
Dialogue: 0,0:15:53.13,0:15:56.31,Main,,0,0,0,,İkiniz de aptalsınız!\NHemen alın şu anahtarları!
Dialogue: 0,0:15:56.31,0:15:57.56,Main,,0,0,0,,Bacak Fırtınası:{\fad(150,150)}
Dialogue: 0,0:15:59.64,0:16:00.90,Main,,0,0,0,,Çizgi!{\fad(150,150)}
Dialogue: 0,0:16:03.13,0:16:05.79,Main,,0,0,0,,Emirlerime uymakla iyi iş çıkardın, Zoro-kun!
Dialogue: 0,0:16:05.79,0:16:07.26,Main,,0,0,0,,Dövüş, Zoro!
Dialogue: 0,0:16:07.26,0:16:09.36,Main,,0,0,0,,Siz de dövüşün!
Dialogue: 0,0:16:13.36,0:16:14.95,Main,,0,0,0,,O uzun boyun...
Dialogue: 0,0:16:15.38,0:16:17.45,Main,,0,0,0,,...zayıf noktan!
Dialogue: 0,0:16:17.45,0:16:19.45,Main,,0,0,0,,Hayır, değil!
Dialogue: 0,0:16:22.79,0:16:26.50,Main,,0,0,0,,Onu bile istediğim gibi hareket\Nettirme yeteneğim var.
Dialogue: 0,0:16:26.50,0:16:27.79,Main,,0,0,0,,Ve saldırmak için...
Dialogue: 0,0:16:28.80,0:16:30.30,Main,,0,0,0,,Burun Tabancası!{\fad(150,150)}
Dialogue: 0,0:16:38.37,0:16:40.14,Main,,0,0,0,,N-Ne?
Dialogue: 0,0:16:40.14,0:16:42.35,Main,,0,0,0,,Sadece yakınında olmakla bile bu kadar\Nbüyük bir şok dalgası mı oluyor?
Dialogue: 0,0:16:55.74,0:16:57.87,Main,,0,0,0,,Kayada dört köşe bir delik açtı!
Dialogue: 0,0:16:57.87,0:16:59.69,Main,,0,0,0,,O burun Sogepp'inkinden bile daha etkileyici!
Dialogue: 0,0:16:59.69,0:17:02.14,Main,,0,0,0,,Sogepp kim?!
Dialogue: 0,0:17:02.14,0:17:03.70,Main,,0,0,0,,Aptalca karşılaştırmalara son ver!
Dialogue: 0,0:17:03.70,0:17:09.25,Main,,0,0,0,,Evet ama Kaku meyve yeteneklerini\Nkullanmakta epey iyileşmiş.
Dialogue: 0,0:17:10.50,0:17:15.35,Main,,0,0,0,,K-Kurt! R-Rakibin ben olacağım!
Dialogue: 0,0:17:15.35,0:17:18.05,Main,,0,0,0,,O kadar heyecan yapma.
Dialogue: 0,0:17:18.05,0:17:21.52,Main,,0,0,0,,Arkadaşınızı kurtarmak istiyorsunuz, değil mi?
Dialogue: 0,0:17:21.52,0:17:25.89,Main,,0,0,0,,E-Evet, anahtarını alacağım!
Dialogue: 0,0:17:30.23,0:17:31.71,Main,,0,0,0,,Hemen al.
Dialogue: 0,0:17:33.12,0:17:36.35,Main,,0,0,0,,Ve gidip Nico Robin'i kurtarın.
Dialogue: 0,0:17:36.35,0:17:38.62,Main,,0,0,0,,Sen...
Dialogue: 0,0:17:39.03,0:17:45.21,Main,,0,0,0,,Aslında öldürmeyi sevmiyorum.\NKan görmeye dayanamıyorum.
Dialogue: 0,0:17:46.29,0:17:51.96,Main,,0,0,0,,O zaman anahtarı alacağım...
Dialogue: 0,0:17:53.59,0:17:55.35,Main,,0,0,0,,Hayır! Dikkat et!
Dialogue: 0,0:17:56.38,0:17:57.72,Main,,0,0,0,,On Parmak Tabanca!{\fad(150,150)}
Dialogue: 0,0:18:02.39,0:18:04.22,Main,,0,0,0,,Tedbiri elden bırakma!
Dialogue: 0,0:18:04.22,0:18:08.27,Main,,0,0,0,,Ben kurtum.\NSeni kandırır ve yerim!
Dialogue: 0,0:18:21.12,0:18:22.12,Main,,0,0,0,,Usopp!
Dialogue: 0,0:18:22.12,0:18:27.87,Thoughts,,0,0,0,,Kahretsin!\NNe yapıyorum ben?
Dialogue: 0,0:18:30.14,0:18:32.04,Main,,0,0,0,,Ne aptal maskeli bir adam!
Dialogue: 0,0:18:32.04,0:18:35.33,Main,,0,0,0,,Deminki gibi etrafta koşmaya ne dersin?
Dialogue: 0,0:18:35.33,0:18:37.51,Main,,0,0,0,,Bu konuda iyiydin!
Dialogue: 0,0:18:37.51,0:18:39.33,Main,,0,0,0,,Benimle alay etme.
Dialogue: 0,0:18:42.37,0:18:46.47,Main,,0,0,0,,Artık öyle bir vaktim yok.
Dialogue: 0,0:18:47.38,0:18:49.69,Main,,0,0,0,,Yeni Silah Kabuto!
Dialogue: 0,0:18:49.69,0:18:52.02,Main,,0,0,0,,Kesin Öldürücü Ayçiçeği Yıldızı!{\fad(150,150)}
Dialogue: 0,0:19:05.02,0:19:07.08,Main,,0,0,0,,Ne, havai fişekler mi?
Dialogue: 0,0:19:08.66,0:19:09.70,Main,,0,0,0,,Usopp!
Dialogue: 0,0:19:09.70,0:19:11.00,Main,,0,0,0,,Ay Yürüyüşü!{\fad(150,150)}
Dialogue: 0,0:19:21.33,0:19:23.18,Main,,0,0,0,,Dur!
Dialogue: 0,0:19:38.61,0:19:43.36,Main,,0,0,0,,Söz verdiğim gibi \Nseni çabuk öldüreceğim. Acıtmayacak.
Dialogue: 0,0:19:43.36,0:19:48.91,Main,,0,0,0,,Çobanına bağlı haldeyken daha güvendeydin.
Dialogue: 0,0:19:49.08,0:19:53.88,Main,,0,0,0,,Ama küçük kuzu kendi\Nbaşına dolaşmaya çıktığı için...
Dialogue: 0,0:19:53.88,0:19:57.34,Main,,0,0,0,,Şimdi korkunç kurt seni yiyecek!
Dialogue: 0,0:20:00.33,0:20:02.78,Main,,0,0,0,,İşte bu kadar!
Dialogue: 0,0:20:02.78,0:20:05.43,Main,,0,0,0,,Hey, bırak onu! Kahrolası kurt!
Dialogue: 0,0:20:05.43,0:20:08.56,Main,,0,0,0,,Onu öldürme! Lütfen!\NAnahtarına ihtiyacımız yok!
Dialogue: 0,0:20:10.36,0:20:13.96,Main,,0,0,0,,Aptal! Sonra sen öleceksin!
Dialogue: 0,0:20:16.33,0:20:17.48,Main,,0,0,0,,Bacak Fırtınası!{\fad(150,150)}
Dialogue: 0,0:20:18.79,0:20:19.86,Main,,0,0,0,,Kahretsin!
Dialogue: 0,0:20:19.86,0:20:22.49,Main,,0,0,0,,Şimdi, geber!
Dialogue: 0,0:20:28.24,0:20:30.34,Main,,0,0,0,,USOPP!
Dialogue: 0,0:20:53.13,0:20:55.98,Main,,0,0,0,,Sen de kimsin?!
Dialogue: 0,0:21:05.90,0:21:07.22,Main,,0,0,0,,Avcı.
Dialogue: 0,0:21:07.22,0:21:09.50,Credits,,0,0,0,,Editing:\N Galaxy 9000\N\NTiming:\NGalaxy 9000\N\NQuality Control:\NGalaxy 9000,\NItsKipz,\NPepperjack\N\NSoundtracking:\N Halee\N\NGraphics:\N Datenshi\N\NKaraoke:\NKaitouYahiko\N\NTranslation:\NCrunchyroll,\NGaijin
Dialogue: 0,0:00:00.71,0:00:03.37,Lyrics,,0,0,0,,{\fad(0,0)}♪ Koşmaya başlayalım, koşmaya başlayalım! ♪
Dialogue: 0,0:00:03.59,0:00:06.46,Lyrics,,0,0,0,,♪ Bayrağımızı süsleyip, gökyüzüne kaldırarak. ♪
Dialogue: 0,0:00:12.77,0:00:18.06,Lyrics,,0,0,0,,♪ Sonsuz okyanusu geçip aramaya gidelim. ♪
Dialogue: 0,0:00:18.86,0:00:21.81,Lyrics,,0,0,0,,♪ Henüz kimse tarafından...
Dialogue: 0,0:00:21.90,0:00:23.94,Lyrics,,0,0,0,,...bulunmamış bu dünyanın mucizesini. ♪
Dialogue: 0,0:00:24.82,0:00:27.96,Lyrics,,0,0,0,,♪ Çarpıp duran göğsümüzdeki...
Dialogue: 0,0:00:27.96,0:00:29.71,Lyrics,,0,0,0,,...aynı hislerle devam etmeliyiz. ♪
Dialogue: 0,0:00:29.71,0:00:35.59,Lyrics,,0,0,0,,♪ Hayaller peşinde koşanlar tarafından bırakılmış ayak izleri. ♪
Dialogue: 0,0:00:36.42,0:00:39.39,Lyrics,,0,0,0,,♪ Ne tür bir fırtınalı gece olursa olsun,...
Dialogue: 0,0:00:39.39,0:00:42.39,Lyrics,,0,0,0,,...kalplerimizin bir olmasını sağlarsak...
Dialogue: 0,0:00:42.39,0:00:46.54,Lyrics,,0,0,0,,{\fad(0,0)}...bu zorluğun üstesinden gelebileceğiz! ♪
Dialogue: 0,0:00:46.68,0:00:47.86,Lyrics,,0,0,0,,♪ Her zaman ♪
Dialogue: 0,0:00:48.76,0:00:51.59,Lyrics,,0,0,0,,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪
Dialogue: 0,0:00:51.72,0:00:54.55,Lyrics,,0,0,0,,{\fad(0,0)}♪ Bayrağımızı dalgalandırıp gökyüzüne kaldırarak. ♪
Dialogue: 0,0:00:54.60,0:00:57.14,Lyrics,,0,0,0,,♪ Kimseye göstermeyeceğiz. ♪
Dialogue: 0,0:00:57.23,0:01:00.58,Lyrics,,0,0,0,,{\fad(0,0)}♪ Gözlerimizde yaşlar olsa bile. ♪
Dialogue: 0,0:01:00.77,0:01:03.52,Lyrics,,0,0,0,,♪ Peşinden gidelim, peşinden gidelim! ♪
Dialogue: 0,0:01:03.69,0:01:06.52,Lyrics,,0,0,0,,♪ Hayallerimize giden doğru yolu...
Dialogue: 0,0:01:06.61,0:01:09.23,Lyrics,,0,0,0,,...gösteren pusulanın. ♪
Dialogue: 0,0:01:09.23,0:01:11.40,Lyrics,,0,0,0,,{\fad(0,0)}♪ Durmayacağız. ♪
Dialogue: 0,0:01:11.42,0:01:14.42,Lyrics,,0,0,0,,♪ Dünyayı dolaşarak...
Dialogue: 0,0:01:14.45,0:01:15.85,Lyrics,,0,0,0,,...yeniden başlayalım! ♪
Dialogue: 0,0:01:18.83,0:01:21.49,Lyrics,,0,0,0,,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪
Dialogue: 0,0:01:21.80,0:01:24.54,Lyrics,,0,0,0,,♪ Hedefimize doğru herkesten daha fazla. ♪
Dialogue: 0,0:01:24.63,0:01:27.12,Lyrics,,0,0,0,,♪ Şimdi kaçmazsak,...
Dialogue: 0,0:01:27.22,0:01:30.54,Lyrics,,0,0,0,,{\fad(0,0)}...yarını sıkı sıkıya kavrayabileceğiz! ♪
Dialogue: 0,0:01:30.60,0:01:33.63,Lyrics,,0,0,0,,♪ Peşinden gidelim, peşinden gidelim! ♪
Dialogue: 0,0:01:33.68,0:01:36.51,Lyrics,,0,0,0,,♪ Gözlerinden yansıtılmış tüm şimdiki zamanın. ♪
Dialogue: 0,0:01:36.56,0:01:38.93,Lyrics,,0,0,0,,♪ Bembeyaz bir kalp...
Dialogue: 0,0:01:39.15,0:01:41.43,Lyrics,,0,0,0,,...bana tüm hikayeyi anlatacak! ♪
Dialogue: 0,0:01:41.73,0:01:44.43,Lyrics,,0,0,0,,♪ Yepyeni bir dünyada...
Dialogue: 0,0:01:44.53,0:01:45.83,Lyrics,,0,0,0,,...yeniden başlayalım! ♪
