Dialogue: 1,0:01:49.92,0:01:54.74,Title,,0,0,0,,{\fad(440,0)}Sanji, Jabra'ya Karşı
Dialogue: 0,0:01:56.40,0:01:57.38,Main,,0,0,0,,Sanji-{\i1}kun!{\i0}
Dialogue: 0,0:01:59.44,0:02:00.80,Main,,0,0,0,,Sanji...!
Dialogue: 0,0:02:00.80,0:02:03.42,Main,,0,0,0,,Nasıl normale döndün?
Dialogue: 0,0:02:03.42,0:02:06.66,Main,,0,0,0,,Yukarıdan bir küvet düştü ve iyileştim.
Dialogue: 0,0:02:06.66,0:02:09.02,Main,,0,0,0,,Muhtemelen su yüzünden oldu.
Dialogue: 0,0:02:18.43,0:02:20.24,Main,,0,0,0,,Ama daha da önemlisi Nami-san,...
Dialogue: 0,0:02:22.45,0:02:25.43,Main,,0,0,0,,...tekrardan bana aşık oldun mu?
Dialogue: 0,0:02:29.18,0:02:31.58,Main,,0,0,0,,Keşke küvet kafana düşseydi.
Dialogue: 0,0:02:38.30,0:02:39.44,Main,,0,0,0,,Hanapp!
Dialogue: 0,0:02:38.30,0:02:39.44,Note,,0,0,0,,{\an8}Hanapp: Burun ve Usopp isminin "pp" si.
Dialogue: 0,0:02:39.44,0:02:44.88,Main,,0,0,0,,Şimdi adım Sogeking gibi bir şey değil mi?
Dialogue: 0,0:02:47.45,0:02:50.40,Main,,0,0,0,,Ü-Üzgünüm, Sanji-kun.
Dialogue: 0,0:02:52.41,0:02:53.39,Main,,0,0,0,,Ben...
Dialogue: 0,0:02:55.42,0:02:58.40,Main,,0,0,0,,...gerçekten...
Dialogue: 0,0:02:58.40,0:03:00.73,Main,,0,0,0,,Hayatta olduğun sürece sorun değil.
Dialogue: 0,0:03:00.73,0:03:03.74,Main,,0,0,0,,Herkesin yapıp yapamayacağı şeyler vardır.
Dialogue: 0,0:03:04.86,0:03:06.08,Main,,0,0,0,,Sanji!
Dialogue: 0,0:03:09.85,0:03:13.04,Main,,0,0,0,,Dışarı bakın.
Dialogue: 0,0:03:15.27,0:03:16.25,Main,,0,0,0,,Olamaz.
Dialogue: 0,0:03:34.23,0:03:38.10,Main,,0,0,0,,Adalet Kapısı açılıyor.
Dialogue: 0,0:03:39.90,0:03:41.78,Main,,0,0,0,,Robin.
Dialogue: 0,0:03:48.30,0:03:52.27,Main,,0,0,0,,O kapı açılır ve Robin-chan geçip giderse,...
Dialogue: 0,0:03:52.27,0:03:56.30,Main,,0,0,0,,...Deniz Kralı yuvaları yüzünden\Ndenizi oradan geçemeyiz...
Dialogue: 0,0:03:56.30,0:04:00.18,Main,,0,0,0,,...ve onun ötesinde \NYeraltı Hapisanesi'yle Denizci Karargâhı var.
Dialogue: 0,0:04:00.18,0:04:04.34,Main,,0,0,0,,Robin-chan tamamiyle bizden\Nalınıp götürülmüş olacak.
Dialogue: 0,0:04:04.34,0:04:09.24,Main,,0,0,0,,Olamaz.\NLuffy zamanında varamadı mı?
Dialogue: 0,0:04:18.53,0:04:22.92,Main,,0,0,0,,Kahretsin, vuramıyorum!\NRobin beni bekliyor.
Dialogue: 0,0:04:23.66,0:04:27.45,Main,,0,0,0,,Vazgeç.\NOnu bir daha göremeyeceksin.
Dialogue: 0,0:04:28.29,0:04:30.82,Main,,0,0,0,,Buradan geçemeyeceksin.
Dialogue: 0,0:04:48.76,0:04:50.59,Main,,0,0,0,,Gomu Gomu No...{\fad(150,150)}
Dialogue: 0,0:04:50.59,0:04:53.10,Main,,0,0,0,,...Makineli Tüfek!{\fad(150,150)}
Dialogue: 0,0:04:53.10,0:04:55.12,Main,,0,0,0,,Bu işe yaramayacak.
Dialogue: 0,0:05:12.54,0:05:13.83,Main,,0,0,0,,Gel bakalım!
Dialogue: 0,0:05:16.54,0:05:19.50,Main,,0,0,0,,Gel dedim!\NKöprüye gidiyoruz!
Dialogue: 0,0:05:24.30,0:05:26.31,Main,,0,0,0,,Başarabilir miyim?
Dialogue: 0,0:05:26.31,0:05:31.30,Main,,0,0,0,,Umarım 3 veya 4 numaralı anahtardan biri Nico Robin'in kelepçesini açar...
Dialogue: 0,0:05:31.30,0:05:34.58,Main,,0,0,0,,Ama şimdilik onları durdurmalıyım!
Dialogue: 0,0:05:35.30,0:05:37.52,Main,,0,0,0,,Bu yoldan!
Dialogue: 0,0:05:37.52,0:05:39.31,Main,,0,0,0,,Bu yoldan mı?
Dialogue: 0,0:05:39.31,0:05:41.23,Main,,0,0,0,,Chimney, acele et.
Dialogue: 0,0:05:39.31,0:05:41.23,Secondary,,0,0,0,,Bu yoldan!
Dialogue: 0,0:05:41.23,0:05:44.29,Main,,0,0,0,,Kule de saldırıya uğrayacak.
Dialogue: 0,0:05:44.29,0:05:48.82,Main,,0,0,0,,Bekle, nine!\NBunu yapmazsam diğerleri kaybolacak!
Dialogue: 0,0:06:05.31,0:06:09.34,Main,,0,0,0,,Benimle dövüşüyorsan şansın tükenmiş olmalı.
Dialogue: 0,0:06:12.22,0:06:13.92,Main,,0,0,0,,Hey, bırakın bineyim!
Dialogue: 0,0:06:13.92,0:06:16.64,Main,,0,0,0,,Olmaz! \NDeniz Treni tamamen doldu!
Dialogue: 0,0:06:16.64,0:06:19.48,Main,,0,0,0,,Başka bir gemi hazırlayın!
Dialogue: 0,0:06:19.48,0:06:22.19,Main,,0,0,0,,Pislik, sadece sakin olduğunu sanmıştım!
Dialogue: 0,0:06:22.19,0:06:25.01,Main,,0,0,0,,Yani bunca zamandır kendini\Nkendi ipine mi bağladın?!
Dialogue: 0,0:06:25.01,0:06:27.49,Main,,0,0,0,,Evet, sadece durumdan faydalandım.
Dialogue: 0,0:06:27.49,0:06:30.65,Main,,0,0,0,,Ya Franky abimiz? Hasır Şapka tayfası?
Dialogue: 0,0:06:30.65,0:06:34.33,Main,,0,0,0,,Onlar yenilmez!\NOnlar için endişelenmemize gerek yok!
Dialogue: 0,0:06:34.53,0:06:37.29,Main,,0,0,0,,Hemen adadan gidelim!
Dialogue: 0,0:06:37.29,0:06:39.74,Main,,0,0,0,,Tamam!
Dialogue: 0,0:06:39.74,0:06:42.50,Note,,0,0,0,,Donanma
Dialogue: 0,0:06:42.50,0:06:47.29,Main,,0,0,0,,On savaş gemisi adalet adası\NEnies Lobby'ye doğru yola çıktı!
Dialogue: 0,0:06:55.72,0:06:58.55,Main,,0,0,0,,Olası en kötü durumla karşı karşıyayız.
Dialogue: 0,0:06:58.55,0:07:03.77,Main,,0,0,0,,Ama bu kötü durumda bile \Nbir yerlerde saklanma fırsatı olmalı.
Dialogue: 0,0:07:03.77,0:07:05.48,Main,,0,0,0,,Sanji!
Dialogue: 0,0:07:07.19,0:07:10.12,Main,,0,0,0,,Bu adamın anahtarını bana bırakın.
Dialogue: 0,0:07:12.46,0:07:16.58,Main,,0,0,0,,Dövüşçü mü değiştiriyorsunuz?\NBenim için farketmez.
Dialogue: 0,0:07:17.59,0:07:20.56,Main,,0,0,0,,Senin yapamadığını yapacağım,...
Dialogue: 0,0:07:21.46,0:07:24.24,Main,,0,0,0,,...sen de benim yapamadığımı yap.
Dialogue: 0,0:07:26.22,0:07:28.42,Main,,0,0,0,,İyi düşün!
Dialogue: 0,0:07:29.81,0:07:31.24,Main,,0,0,0,,Durumu anla.
Dialogue: 0,0:07:31.88,0:07:37.40,Main,,0,0,0,,Buradaysan Robin-chan'ın kurtarılabilmesi için bir yol olmalı, Usopp!
Dialogue: 0,0:07:39.68,0:07:44.83,Thoughts,,0,0,0,,{\i1}Buradaysam, Robin'i kurtarabilir miyiz?{\i0}
Dialogue: 0,0:08:01.46,0:08:03.39,Main,,0,0,0,,Kazı!{\fad(150,150)}
Dialogue: 0,0:08:03.39,0:08:04.54,Main,,0,0,0,,Gidin!
Dialogue: 0,0:08:04.54,0:08:06.52,Main,,0,0,0,,T-Tamam! Usopp!
Dialogue: 0,0:08:06.52,0:08:07.76,Main,,0,0,0,,A-Ah! Yaralarım...
Dialogue: 0,0:08:07.76,0:08:11.21,Main,,0,0,0,,Sadece dayan!\NBu, öldürülmekten daha iyi değil mi?
Dialogue: 0,0:08:11.21,0:08:13.51,Main,,0,0,0,,Haklısın!
Dialogue: 0,0:08:16.43,0:08:17.63,Main,,0,0,0,,Demir Parça Dövüş Stili!{\fad(150,150)}
Dialogue: 0,0:08:19.23,0:08:20.64,Main,,0,0,0,,Kurt Mermisi!{\fad(150,150)}
Dialogue: 0,0:08:35.91,0:08:40.87,Main,,0,0,0,,O kadar da harika değilsin.\NZaman harcadığıma değmez!
Dialogue: 0,0:08:46.54,0:08:48.54,Main,,0,0,0,,Ah, anladım!
Dialogue: 0,0:08:48.54,0:08:50.00,Main,,0,0,0,,Ne?
Dialogue: 0,0:08:50.00,0:08:54.56,Main,,0,0,0,,Yapabiliriz. Buradaysam \NRobin'i kurtarabiliriz! Lanet olsun!
Dialogue: 0,0:08:54.56,0:08:57.25,Main,,0,0,0,,"Lanet olsun" mu? \NŞu işi heyecanlanmadan yapamaz mısın?
Dialogue: 0,0:08:57.25,0:08:58.44,Main,,0,0,0,,Acele edelim, Nami-kun!
Dialogue: 0,0:08:58.44,0:09:00.01,Main,,0,0,0,,Dur biraz!
Dialogue: 0,0:09:00.01,0:09:02.39,Main,,0,0,0,,Anladım, anladım!
Dialogue: 0,0:09:02.39,0:09:06.44,Main,,0,0,0,,Hey, sessiz ol!\NKurtun peşimizden gelmesine neden olacaksın!
Dialogue: 0,0:09:10.90,0:09:12.57,Main,,0,0,0,,Belki de onları öldürmeliyim!
Dialogue: 0,0:09:39.56,0:09:41.01,Main,,0,0,0,,Ah, beni hazırlıksız yakaladı.
Dialogue: 0,0:09:52.61,0:09:53.61,Main,,0,0,0,,On Parmak Tabanca!{\fad(150,150)}
Dialogue: 0,0:09:54.87,0:09:57.30,Main,,0,0,0,,Üçüncü Sınıf Kıyma!{\fad(150,150)}
Dialogue: 0,0:09:57.30,0:09:58.86,Main,,0,0,0,,Demir Parça!{\fad(150,150)}
Dialogue: 0,0:10:11.89,0:10:14.54,Main,,0,0,0,,Acıttığını mı sanıyorsun, aptal?
Dialogue: 0,0:10:14.54,0:10:16.97,Thoughts,,0,0,0,,{\i1}Bu adamın tekmeleri ne biçim böyle?{\i0}
Dialogue: 0,0:10:18.36,0:10:21.88,Main,,0,0,0,,Şu demir parça tekniğiniz...
Dialogue: 0,0:10:22.91,0:10:24.89,Main,,0,0,0,,...gerçekten can sıkıcı.
Dialogue: 0,0:10:24.89,0:10:26.89,Main,,0,0,0,,Yalnız Kurdun Bacak Fırtınası!{\fad(150,150)}
Dialogue: 0,0:10:33.07,0:10:34.56,Main,,0,0,0,,Omuz Kızartması!{\fad(150,150)}
Dialogue: 0,0:10:34.90,0:10:35.94,Main,,0,0,0,,Fileto!{\fad(150,150)}
Dialogue: 0,0:10:35.94,0:10:37.36,Main,,0,0,0,,Gerdan!{\fad(150,150)}
Dialogue: 0,0:10:37.36,0:10:40.16,Main,,0,0,0,,Mide! But! Kuyruk! Uyluk! Baldır!{\fad(150,150)}
Dialogue: 0,0:10:48.12,0:10:49.87,Main,,0,0,0,,Dana Eti Vuruşu!{\fad(150,150)}
Dialogue: 0,0:10:49.87,0:10:50.98,Main,,0,0,0,,Demir Parça Dövüş Stili!{\fad(150,150)}
Dialogue: 0,0:10:53.91,0:10:56.89,Main,,0,0,0,,Sana söylemedim mi? \NTekmelerin beni...
Dialogue: 0,0:10:56.89,0:10:58.51,Main,,0,0,0,,...acıtmıyor, rouga*!{\fad(150,150)}
Dialogue: 0,0:11:03.35,0:11:05.09,Main,,0,0,0,,Acıttı mı, rouga*?
Dialogue: 0,0:11:05.09,0:11:08.11,Main,,0,0,0,,Demir Parça Dövüş Stili!\NKurt Dişi Duruşu!
Dialogue: 0,0:11:11.07,0:11:16.78,Main,,0,0,0,,Bedeni demir parça kullanırken hareket\Nedebilen tek altı stil kullanıcısı benim!
Dialogue: 0,0:11:16.78,0:11:19.11,Main,,0,0,0,,Kapa çeneni artık!
Dialogue: 0,0:11:19.11,0:11:21.07,Main,,0,0,0,,İkinci Sınıf Kıyma!{\fad(150,150)}
Dialogue: 0,0:11:32.03,0:11:34.84,Main,,0,0,0,,Acıtmış gibi görünüyor ama acıtmadı mı?
Dialogue: 0,0:11:39.84,0:11:41.80,Main,,0,0,0,,Nasıl?
Dialogue: 0,0:11:48.01,0:11:50.03,Main,,0,0,0,,Etkilendim.
Dialogue: 0,0:11:50.03,0:11:53.99,Main,,0,0,0,,Senin gibi biriyle dövüşmeyi bekliyordum.
Dialogue: 0,0:11:57.94,0:12:02.25,Main,,0,0,0,,Gidip benim için Robin'i kurtarabilir misin?
Dialogue: 0,0:12:02.25,0:12:05.06,Main,,0,0,0,,Ne? Neden bahsediyorsun sen?
Dialogue: 0,0:12:05.06,0:12:09.83,Main,,0,0,0,,Daha önce bahsetmedim ama Robin...
Dialogue: 0,0:12:09.83,0:12:15.13,Main,,0,0,0,,...uzun zamandır kayıp olan kız kardeşim.
Dialogue: 0,0:12:15.13,0:12:16.96,Main,,0,0,0,,Ne?
Dialogue: 0,0:12:16.96,0:12:18.63,Main,,0,0,0,,Gerçekten mi?
Dialogue: 0,0:12:18.63,0:12:23.63,Main,,0,0,0,,Bilmiyordum, daha önce hiç bahsetmemişti.
Dialogue: 0,0:12:23.63,0:12:25.60,Main,,0,0,0,,Elbette bahsetmez.
Dialogue: 0,0:12:25.60,0:12:27.63,Main,,0,0,0,,Ama gerçek bu.
Dialogue: 0,0:12:27.63,0:12:29.63,Main,,0,0,0,,Lütfen Robin'i kurtar!
Dialogue: 0,0:12:31.06,0:12:33.64,Main,,0,0,0,,Tamam, ben hallederim!
Dialogue: 0,0:12:33.64,0:12:37.15,Main,,0,0,0,,Anahtarı alacağım ve gidip Robin-chan'ı...
Dialogue: 0,0:12:40.69,0:12:43.11,Main,,0,0,0,,Buna inanır mıyım sanki, rouga*!
Dialogue: 0,0:12:48.28,0:12:51.45,Main,,0,0,0,,Robin-chan senin kız kardeşin mi?
Dialogue: 0,0:12:51.45,0:12:55.42,Main,,0,0,0,,Aptal, daha inanılır bir yalan söyle!
Dialogue: 0,0:13:01.40,0:13:02.98,Main,,0,0,0,,Şimdi anlamış olmalısın.
Dialogue: 0,0:13:02.98,0:13:07.55,Main,,0,0,0,,Ne yaparsan yap, o kapıdan geçemeyeceksin.
Dialogue: 0,0:13:07.55,0:13:12.63,Main,,0,0,0,,Hayır. Ne yapmak zorunda olduğum\Numrumda değil! Geçeceğim!
Dialogue: 0,0:13:12.63,0:13:14.67,Main,,0,0,0,,Anlaşamıyor gibiyiz.
Dialogue: 0,0:13:14.67,0:13:17.15,Main,,0,0,0,,Ne yaptığının önemi yok.
Dialogue: 0,0:13:17.15,0:13:19.08,Main,,0,0,0,,Bunun için vaktim yok.
Dialogue: 0,0:13:19.08,0:13:21.94,Main,,0,0,0,,Gomu Gomu No Makineli Tüfek!{\fad(150,150)}
Dialogue: 0,0:13:21.94,0:13:23.69,Main,,0,0,0,,Damga!{\fad(150,150)}
Dialogue: 0,0:13:23.69,0:13:24.88,Main,,0,0,0,,Kırbaç!{\fad(150,150)}
Dialogue: 0,0:13:24.88,0:13:26.82,Main,,0,0,0,,Mızrak!{\fad(150,150)}
Dialogue: 0,0:13:48.53,0:13:51.63,Main,,0,0,0,,Nihayet seni incittim mi, kurt-kun?
Dialogue: 0,0:13:51.63,0:13:54.10,Main,,0,0,0,,Pislik, anahtarım!
Dialogue: 0,0:13:54.68,0:13:56.89,Main,,0,0,0,,Bana sen verdin.
Dialogue: 0,0:13:56.89,0:13:59.08,Main,,0,0,0,,Pislik.
Dialogue: 0,0:13:59.08,0:14:00.19,Main,,0,0,0,,Demir Parça!{\fad(150,150)}
Dialogue: 0,0:14:02.75,0:14:05.83,Main,,0,0,0,,– Görüşürüz!\N– DUR!
Dialogue: 0,0:14:05.83,0:14:08.76,Main,,0,0,0,,İnsanları kandırması gereken benim!
Dialogue: 0,0:14:08.76,0:14:10.50,Main,,0,0,0,,Benimle alay ediyor!
Dialogue: 0,0:14:10.50,0:14:11.37,Main,,0,0,0,,Kazı!{\fad(150,150)}
Dialogue: 0,0:14:19.54,0:14:21.34,Main,,0,0,0,,Parti Masası!{\fad(150,150)}
Dialogue: 0,0:14:21.34,0:14:22.52,Main,,0,0,0,,Demir Parça Dövüş Stili!{\fad(150,150)}
Dialogue: 0,0:14:23.75,0:14:25.31,Main,,0,0,0,,Uyluk Vuruşu!{\fad(150,150)}
Dialogue: 0,0:14:29.53,0:14:31.76,Main,,0,0,0,,Kebap Şişi!{\fad(150,150)}
Dialogue: 0,0:14:35.98,0:14:38.75,Main,,0,0,0,,Kahretsin, şimdi kızdım işte!
Dialogue: 0,0:14:38.75,0:14:41.80,Main,,0,0,0,,Yaralanmayı gerçekten \No kadar çok istiyorsan, sorun değil.
Dialogue: 0,0:14:43.73,0:14:47.24,Main,,0,0,0,,Demir Parça Dövüş Stili!\NKurt-Muz Duruşu!{\fad(150,150)}
Dialogue: 0,0:14:49.56,0:14:52.12,Main,,0,0,0,,Kurdun Av Bölgesi Ağı!{\fad(150,150)}
Dialogue: 0,0:14:52.12,0:14:53.33,Main,,0,0,0,,Havayı mı kesti?!
Dialogue: 0,0:14:58.62,0:15:00.00,Main,,0,0,0,,Önemli Kurt Adımı!{\fad(150,150)}
Dialogue: 0,0:15:12.19,0:15:14.63,Main,,0,0,0,,Demir parça yumruğumun gücü nasıl?
Dialogue: 0,0:15:14.63,0:15:16.62,Main,,0,0,0,,Acıtmış olmalı!
Dialogue: 0,0:15:16.62,0:15:17.81,Main,,0,0,0,,Ay Yürüyüşü!{\fad(150,150)}
Dialogue: 0,0:15:21.88,0:15:24.92,Main,,0,0,0,,Bacak Fırtınası!\NDeri Veremi Dört!{\fad(150,150)}
Dialogue: 0,0:15:39.51,0:15:44.86,Main,,0,0,0,,Anahtarımı çalıp kaçmaya\Nkalktığın için epey aptalsın!
Dialogue: 0,0:15:44.86,0:15:49.55,Main,,0,0,0,,Ben kurtum! Yakalayıp yiyene dek \Narkandan kovalayacağım!
Dialogue: 0,0:15:52.34,0:15:54.58,Main,,0,0,0,,Ne, hayatta mıydın?
Dialogue: 0,0:15:54.58,0:15:59.48,Main,,0,0,0,,Kaçmak niyetinde değilim.\NÖldürülmek niyetinde değilim.
Dialogue: 0,0:16:02.51,0:16:04.56,Main,,0,0,0,,Seni affetmek niyetinde değilim.
Dialogue: 0,0:16:04.56,0:16:05.89,Main,,0,0,0,,Affetmek mi?
Dialogue: 0,0:16:08.44,0:16:10.69,Main,,0,0,0,,Bunu Nico Robin için mi yapıyorsun?
Dialogue: 0,0:16:11.46,0:16:14.99,Main,,0,0,0,,Bu tür hisler sadece dövüşte sana engel olur.
Dialogue: 0,0:16:14.99,0:16:18.49,Main,,0,0,0,,O umutsuz, aptal kadına acıyacak vaktin varsa,...
Dialogue: 0,0:16:18.49,0:16:21.91,Main,,0,0,0,,...buradan canlı çıkmanın bir yolunu düşünmelisin!
Dialogue: 0,0:16:22.90,0:16:24.63,Main,,0,0,0,,Söylediğine dikkat et.
Dialogue: 0,0:16:26.52,0:16:30.59,Main,,0,0,0,,Kızdığım zaman ısınırım.
Dialogue: 0,0:16:30.59,0:16:33.67,Main,,0,0,0,,Denemiyorsun bile, kazanman mümkün değil!
Dialogue: 0,0:16:33.67,0:16:36.44,Main,,0,0,0,,Şu anda epey acı içinde olmalısın.
Dialogue: 0,0:16:36.44,0:16:39.45,Main,,0,0,0,,Hala yeterli değilse...
Dialogue: 0,0:16:39.45,0:16:42.52,Main,,0,0,0,,Demir Parça Dövüş Stili!\NŞeytani Cennet Kurdu!{\fad(150,150)}
Dialogue: 0,0:16:57.93,0:17:02.02,Main,,0,0,0,,Güleceksen, şimdi gülme zamanı.
Dialogue: 0,0:17:13.67,0:17:17.47,Main,,0,0,0,,Ne diye öyle dönüyorsun bilmiyorum ama...
Dialogue: 0,0:17:21.93,0:17:25.56,Main,,0,0,0,,Ne? Bacağı mı kızarmış?
Dialogue: 0,0:17:26.46,0:17:28.47,Main,,0,0,0,,Şeytanın bacağı...
Dialogue: 0,0:17:28.47,0:17:30.52,Main,,0,0,0,,...Şeytan Bacak!{\fad(150,150)}
Dialogue: 0,0:17:30.52,0:17:35.66,Main,,0,0,0,,Isınmış bir bacak yüksek hızla vurur,...
Dialogue: 0,0:17:39.02,0:17:39.87,Thoughts,,0,0,0,,Parlak?!
Dialogue: 0,0:17:48.79,0:17:50.49,Main,,0,0,0,,SICAK!
Dialogue: 0,0:17:51.49,0:17:56.26,Main,,0,0,0,,...şeytanla aynı güce sahiptir.
Dialogue: 0,0:18:09.49,0:18:12.40,Main,,0,0,0,,Sıcak, sıcak, sıcak!
Dialogue: 0,0:18:14.45,0:18:17.92,Main,,0,0,0,,Y-Yandım!\NKemiklerime kadar yandım!
Dialogue: 0,0:18:18.46,0:18:20.44,Main,,0,0,0,,Demir Parça bile işe yaramadı!
Dialogue: 0,0:18:20.44,0:18:23.87,Main,,0,0,0,,O tekme ne biçim öyle?!
Dialogue: 0,0:18:28.34,0:18:32.88,Main,,0,0,0,,Aptal, altı stil kullanıcısıyla\Ndövüşürken havaya zıplamak...
Dialogue: 0,0:18:32.88,0:18:34.46,Main,,0,0,0,,Şeytan Bacak!{\fad(150,150)}
Dialogue: 0,0:18:35.45,0:18:37.80,Main,,0,0,0,,Birinci Sınıf Kıyma!{\fad(150,150)}
Dialogue: 0,0:18:37.01,0:18:37.80,Secondary,,0,0,0,,Ay Yürüyüşü!{\fad(150,150)}
Dialogue: 0,0:18:40.28,0:18:41.44,Main,,0,0,0,,Aptal!
Dialogue: 0,0:18:41.44,0:18:42.92,Main,,0,0,0,,Tam bir aptalsın!
Dialogue: 0,0:18:42.92,0:18:45.34,Main,,0,0,0,,Çok fazla ukalalık edersen, dövüşü kaybedersin!
Dialogue: 0,0:18:45.34,0:18:46.92,Main,,0,0,0,,Ben kazandım!
Dialogue: 0,0:18:48.98,0:18:49.85,Main,,0,0,0,,Al bakalım!
Dialogue: 0,0:18:49.85,0:18:51.23,Main,,0,0,0,,Ay Işığında On Parmak Tabanca!{\fad(150,150)}
Dialogue: 0,0:18:57.89,0:19:01.03,Main,,0,0,0,,Bir eli mi durdurdun? Çok yazık.
Dialogue: 0,0:19:01.46,0:19:03.67,Main,,0,0,0,,Bir tekme daha atsaydın,...
Dialogue: 0,0:19:03.67,0:19:05.99,Main,,0,0,0,,...bütün parmak tabancaları durdururdun!
Dialogue: 0,0:19:06.91,0:19:08.60,Main,,0,0,0,,Hayır, başka çarem yok.
Dialogue: 0,0:19:08.60,0:19:13.00,Main,,0,0,0,,Son tekme bitirici darbe.
Dialogue: 0,0:19:15.44,0:19:17.20,Main,,0,0,0,,Şeytan Bacak!{\fad(150,150)}
Dialogue: 0,0:19:17.20,0:19:19.05,Main,,0,0,0,,D-Dur!
Dialogue: 0,0:19:19.45,0:19:21.01,Main,,0,0,0,,Alevli...{\fad(150,150)}
Dialogue: 0,0:19:27.34,0:19:29.38,Main,,0,0,0,,...Vuruş!{\fad(150,150)}
Dialogue: 0,0:19:39.46,0:19:42.14,Main,,0,0,0,,Yemek pişirme Tanrı vergisidir.
Dialogue: 0,0:19:44.23,0:19:46.58,Main,,0,0,0,,Baharatlarsa Şeytan vergisi.
Dialogue: 0,0:19:50.46,0:19:54.58,Main,,0,0,0,,Görünüşe göre senin için biraz fazla baharatlıydı.
Dialogue: 0,0:19:54.58,0:19:57.60,Credits,,0,0,0,,Editing:\N Galaxy 9000\N\NTiming:\NGalaxy 9000\N\NQuality Control:\NGalaxy 9000,\NItsKipz,\NPepperjack\N\NSoundtracking:\N Halee\N\NGraphics:\N Datenshi\N\NKaraoke:\NKaitouYahiko\N\NTranslation:\NCrunchyroll,\NGaijin
Dialogue: 0,0:00:00.71,0:00:03.37,Lyrics,,0,0,0,,{\fad(0,0)}♪ Koşmaya başlayalım, koşmaya başlayalım! ♪
Dialogue: 0,0:00:03.59,0:00:06.46,Lyrics,,0,0,0,,♪ Bayrağımızı süsleyip, gökyüzüne kaldırarak. ♪
Dialogue: 0,0:00:12.77,0:00:18.06,Lyrics,,0,0,0,,♪ Sonsuz okyanusu geçip aramaya gidelim. ♪
Dialogue: 0,0:00:18.86,0:00:21.81,Lyrics,,0,0,0,,♪ Henüz kimse tarafından...
Dialogue: 0,0:00:21.90,0:00:23.94,Lyrics,,0,0,0,,...bulunmamış bu dünyanın mucizesini. ♪
Dialogue: 0,0:00:24.82,0:00:27.96,Lyrics,,0,0,0,,♪ Çarpıp duran göğsümüzdeki...
Dialogue: 0,0:00:27.96,0:00:29.71,Lyrics,,0,0,0,,...aynı hislerle devam etmeliyiz. ♪
Dialogue: 0,0:00:29.71,0:00:35.59,Lyrics,,0,0,0,,♪ Hayaller peşinde koşanlar tarafından bırakılmış ayak izleri. ♪
Dialogue: 0,0:00:36.42,0:00:39.39,Lyrics,,0,0,0,,♪ Ne tür bir fırtınalı gece olursa olsun,...
Dialogue: 0,0:00:39.39,0:00:42.39,Lyrics,,0,0,0,,...kalplerimizin bir olmasını sağlarsak...
Dialogue: 0,0:00:42.39,0:00:46.54,Lyrics,,0,0,0,,{\fad(0,0)}...bu zorluğun üstesinden gelebileceğiz! ♪
Dialogue: 0,0:00:46.68,0:00:47.86,Lyrics,,0,0,0,,♪ Her zaman ♪
Dialogue: 0,0:00:48.76,0:00:51.59,Lyrics,,0,0,0,,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪
Dialogue: 0,0:00:51.72,0:00:54.55,Lyrics,,0,0,0,,{\fad(0,0)}♪ Bayrağımızı dalgalandırıp gökyüzüne kaldırarak. ♪
Dialogue: 0,0:00:54.60,0:00:57.14,Lyrics,,0,0,0,,♪ Kimseye göstermeyeceğiz. ♪
Dialogue: 0,0:00:57.23,0:01:00.58,Lyrics,,0,0,0,,{\fad(0,0)}♪ Gözlerimizde yaşlar olsa bile. ♪
Dialogue: 0,0:01:00.77,0:01:03.52,Lyrics,,0,0,0,,♪ Peşinden gidelim, peşinden gidelim! ♪
Dialogue: 0,0:01:03.69,0:01:06.52,Lyrics,,0,0,0,,♪ Hayallerimize giden doğru yolu...
Dialogue: 0,0:01:06.61,0:01:09.23,Lyrics,,0,0,0,,...gösteren pusulanın. ♪
Dialogue: 0,0:01:09.23,0:01:11.40,Lyrics,,0,0,0,,{\fad(0,0)}♪ Durmayacağız. ♪
Dialogue: 0,0:01:11.42,0:01:14.42,Lyrics,,0,0,0,,♪ Dünyayı dolaşarak...
Dialogue: 0,0:01:14.45,0:01:15.85,Lyrics,,0,0,0,,...yeniden başlayalım! ♪
Dialogue: 0,0:01:18.83,0:01:21.49,Lyrics,,0,0,0,,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪
Dialogue: 0,0:01:21.80,0:01:24.54,Lyrics,,0,0,0,,♪ Hedefimize doğru herkesten daha fazla. ♪
Dialogue: 0,0:01:24.63,0:01:27.12,Lyrics,,0,0,0,,♪ Şimdi kaçmazsak,...
Dialogue: 0,0:01:27.22,0:01:30.54,Lyrics,,0,0,0,,{\fad(0,0)}...yarını sıkı sıkıya kavrayabileceğiz! ♪
Dialogue: 0,0:01:30.60,0:01:33.63,Lyrics,,0,0,0,,♪ Peşinden gidelim, peşinden gidelim! ♪
Dialogue: 0,0:01:33.68,0:01:36.51,Lyrics,,0,0,0,,♪ Gözlerinden yansıtılmış tüm şimdiki zamanın. ♪
Dialogue: 0,0:01:36.56,0:01:38.93,Lyrics,,0,0,0,,♪ Bembeyaz bir kalp...
Dialogue: 0,0:01:39.15,0:01:41.43,Lyrics,,0,0,0,,...bana tüm hikayeyi anlatacak! ♪
Dialogue: 0,0:01:41.73,0:01:44.43,Lyrics,,0,0,0,,♪ Yepyeni bir dünyada...
Dialogue: 0,0:01:44.53,0:01:45.83,Lyrics,,0,0,0,,...yeniden başlayalım! ♪
