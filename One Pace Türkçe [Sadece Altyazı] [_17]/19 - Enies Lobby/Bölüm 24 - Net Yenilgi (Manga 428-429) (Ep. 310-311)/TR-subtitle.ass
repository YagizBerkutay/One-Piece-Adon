,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.8,0.8,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:02:04.22,0:02:10.06,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:14:10.00,0:14:18.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:33:07.00,0:33:17.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:01:52.34,0:01:52.86,Main,,0,0,0,,Bu...Dialogue: 0,0:01:52.84,0:01:55.09,Main,,0,0,0,,B-Bu olamaz!Dialogue: 0,0:01:55.51,0:02:00.14,Main,,0,0,0,,Şu anki CP9'un, en güçlü Cipher Pol olduğu söyleniyordu.Dialogue: 0,0:02:00.14,0:02:04.10,Main,,0,0,0,,Liderleri Rob Lucci bile...Dialogue: 1,0:02:04.22,0:02:10.06,Title,,0,0,240,,Net YenilgiDialogue: 0,0:02:04.75,0:02:07.41,Main,,0,0,0,,...korsanlar tarafından yenildi mi?!Dialogue: 0,0:02:24.49,0:02:28.46,Main,,0,0,0,,Luffy kazandı!Dialogue: 0,0:02:43.03,0:02:45.10,Main,,0,0,0,,Bizi gerçekten korkuttu.Dialogue: 0,0:02:45.10,0:02:47.52,Main,,0,0,0,,Nihayet başardın, Hasır Şapka.Dialogue: 0,0:02:47.52,0:02:49.19,Main,,0,0,0,,Luffy!Dialogue: 0,0:02:51.31,0:02:54.69,Main,,0,0,0,,Herkes kaçış gemisine. Yola çıkıyoruz!Dialogue: 0,0:02:56.15,0:02:58.86,Main,,0,0,0,,Başardın, Luffy!Dialogue: 0,0:03:01.69,0:03:03.87,Main,,0,0,0,,İyi iş, Hasır Şapka-san!Dialogue: 0,0:03:05.07,0:03:08.29,Main,,0,0,0,,Aptallar, herkes bizi duyacak!Dialogue: 0,0:03:08.29,0:03:11.26,Main,,0,0,0,,Sorun değil, bilmeleri gerek!Dialogue: 0,0:03:11.26,0:03:13.17,Main,,0,0,0,,Hey! Bu sesler de ne?Dialogue: 0,0:03:13.49,0:03:16.91,Main,,0,0,0,,Emin değiliz! Bir yerden Den Den Mushi araması geliyor.Dialogue: 0,0:03:16.91,0:03:19.13,Main,,0,0,0,,Ağabey!Dialogue: 0,0:03:26.17,0:03:28.53,Thoughts,,0,0,0,,Ne? Bu ses...Dialogue: 0,0:03:39.37,0:03:44.47,Main,,0,0,0,,Kesin şunu! Zaten kaçarken  öldüğümüzü düşünmelerini sağladık.Dialogue: 0,0:03:44.47,0:03:45.91,Main,,0,0,0,,Siz.Dialogue: 0,0:03:46.51,0:03:47.70,Main,,0,0,0,,Bunlar onlar.Dialogue: 0,0:03:51.71,0:03:55.27,Main,,0,0,0,,Bunlar ön kapıda durdurulan korsanlar değil mi?Dialogue: 0,0:03:55.27,0:03:59.20,Main,,0,0,0,,Ama hepsi çukura düşmüştü.Dialogue: 0,0:03:59.20,0:04:01.85,Main,,0,0,0,,Hayatta kalmaları mümkün değil!Dialogue: 0,0:04:08.35,0:04:11.73,Flashbacks,,0,0,0,,Kahretsin! Ateş ediyorlar!Dialogue: 0,0:04:11.73,0:04:13.64,Flashbacks,,0,0,0,,Ağabey!Dialogue: 0,0:04:52.29,0:04:54.07,Main,,0,0,0,,Aptal, ittirme!Dialogue: 0,0:04:54.07,0:04:55.77,Main,,0,0,0,,Düşeceğiz!Dialogue: 0,0:04:56.62,0:04:57.68,Main,,0,0,0,,İp kopacak!Dialogue: 0,0:04:57.69,0:05:00.61,Main,,0,0,0,,Aptallar, Galley-La ipi kopmaz!Dialogue: 0,0:05:01.75,0:05:04.04,Main,,0,0,0,,Üff, hepinize sessiz olun dediğimi sanmıştım.Dialogue: 0,0:05:04.79,0:05:07.27,Main,,0,0,0,,Hepimiz iyiyiz!Dialogue: 0,0:05:07.27,0:05:10.97,Main,,0,0,0,,Devler bizim yerimize tüm darbeyi aldı!Dialogue: 0,0:05:11.74,0:05:14.77,Main,,0,0,0,,Epey inatçılar, değil mi?Dialogue: 0,0:05:14.77,0:05:18.21,Main,,0,0,0,,Nine, hepsi hayatta!Dialogue: 0,0:05:18.69,0:05:21.35,Main,,0,0,0,,Sodom ve Gomorrah da iyi!Dialogue: 0,0:05:21.35,0:05:22.67,Main,,0,0,0,,Hele şükür!Dialogue: 0,0:05:22.67,0:05:26.93,Main,,0,0,0,,Artık burada kalamayız. Kalırsak savaş gemileri gelecek.Dialogue: 0,0:05:26.93,0:05:28.32,Main,,0,0,0,,Hemen çıkın buradan!Dialogue: 0,0:05:28.33,0:05:31.56,Main,,0,0,0,,Yani bir kaçış planımız var, iyi olacağız!Dialogue: 0,0:05:31.83,0:05:34.86,Main,,0,0,0,,Hepimiz bundan sağ çıkacağız ve yakında yine karşılaşacağız!Dialogue: 0,0:05:34.92,0:05:36.03,Main,,0,0,0,,Evet!Dialogue: 0,0:05:36.03,0:05:37.19,Main,,0,0,0,,Acele edelim!Dialogue: 0,0:05:37.68,0:05:40.44,Main,,0,0,0,,Önce siz tırmanın!Dialogue: 0,0:05:40.44,0:05:43.37,Main,,0,0,0,,Kan beynime doldu.Dialogue: 0,0:05:43.37,0:05:45.36,Main,,0,0,0,,Düşeceğim.Dialogue: 0,0:05:46.05,0:05:47.85,Main,,0,0,0,,Tamam, tırmanın!Dialogue: 0,0:05:48.53,0:05:50.18,Main,,0,0,0,,Tırmanın!Dialogue: 0,0:05:50.18,0:05:51.54,Main,,0,0,0,,Düşüyorum!Dialogue: 0,0:05:52.29,0:05:54.16,Main,,0,0,0,,İttirmeyi bırakın!Dialogue: 0,0:05:54.50,0:05:57.32,Main,,0,0,0,,Çocuklar! Aptallar!Dialogue: 0,0:05:57.32,0:06:01.34,Main,,0,0,0,,Sizin için endişeleneceğimi mi sandınız, aptallar?Dialogue: 0,0:06:01.98,0:06:07.31,Main,,0,0,0,,Ah, şu aptallar!  Hele şükür, hele şükür! Çok sevindim!Dialogue: 0,0:06:10.37,0:06:12.99,Main,,0,0,0,,Evet, bu harika.Dialogue: 0,0:06:13.85,0:06:16.63,Main,,0,0,0,,Ama ölürsen bir önemi kalmayacak.Dialogue: 0,0:06:19.05,0:06:20.41,Main,,0,0,0,,Doğru.Dialogue: 0,0:06:21.63,0:06:24.03,Main,,0,0,0,,Hemen ana kapıya gidelim mi?Dialogue: 0,0:06:24.38,0:06:27.63,Main,,0,0,0,,Sonra gideriz. Şimdilik buradaki işi bitireceğiz.Dialogue: 0,0:06:27.63,0:06:31.03,Main,,0,0,0,,Ne yapıyorsunuz?!  Hemen görevinizi bitirin!Dialogue: 0,0:06:31.47,0:06:32.49,Main,,0,0,0,,Emredersiniz!Dialogue: 0,0:06:37.12,0:06:40.79,Main,,0,0,0,,Hey! Gelmeye devam edin bakalım!Dialogue: 0,0:06:41.79,0:06:44.46,Main,,0,0,0,,Yıldırım Tempo!Dialogue: 0,0:06:47.05,0:06:48.84,Main,,0,0,0,,Kaplan Avı!Dialogue: 0,0:06:49.19,0:06:51.05,Main,,0,0,0,,Şeytan Biçişi!Dialogue: 0,0:06:51.91,0:06:53.55,Main,,0,0,0,,Pound'luk Top!Dialogue: 0,0:06:58.75,0:07:00.31,Main,,0,0,0,,100 Çiçek!Dialogue: 0,0:07:08.53,0:07:11.59,Main,,0,0,0,,Gözlerinizi ilk kuledeki  Hasır Şapkalı Luffy'den ayırmayın!Dialogue: 0,0:07:11.59,0:07:13.94,Main,,0,0,0,,Emredersiniz ama...Dialogue: 0,0:07:15.37,0:07:19.65,Main,,0,0,0,,...korsan Hasır Şapkalı Luffy,  ağır şekilde yaralanmış görünüyor!!Dialogue: 0,0:07:19.65,0:07:22.96,Main,,0,0,0,,Hala o noktadan kıpırdamadı!Dialogue: 0,0:07:24.69,0:07:25.59,Main,,0,0,0,,Ne?!Dialogue: 0,0:07:32.89,0:07:34.85,Main,,0,0,0,,Hey, Luffy!Dialogue: 0,0:07:34.85,0:07:38.80,Main,,0,0,0,,Ne yapıyorsun?! Hemen buraya gel!Dialogue: 0,0:07:38.83,0:07:40.69,Main,,0,0,0,,Buradan gitmezsek, sağ kalamayız!Dialogue: 0,0:07:47.57,0:07:50.40,Main,,0,0,0,,Ne oldu?! Sadece biraz daha!Dialogue: 0,0:07:50.85,0:07:52.91,Main,,0,0,0,,Güçlerinle buraya uç!Dialogue: 0,0:07:52.91,0:07:55.24,Main,,0,0,0,,Geri kalan yolda sana yardım edeceğim!Dialogue: 0,0:08:00.87,0:08:03.57,Main,,0,0,0,,Etrafımızda savaş gemilerinden ve okyanustan başka bir şey yok!Dialogue: 0,0:08:03.57,0:08:06.09,Main,,0,0,0,,Burada kalırsan, öldürüleceksin!Dialogue: 0,0:08:06.51,0:08:09.93,Main,,0,0,0,,Görünüşe göre korsanlar  çalıntı gemiyle kaçmayı planlıyor.Dialogue: 0,0:08:11.09,0:08:14.05,Main,,0,0,0,,Luffy!Dialogue: 0,0:08:21.09,0:08:22.77,Main,,0,0,0,,Bedenim...Dialogue: 0,0:08:26.87,0:08:27.86,Main,,0,0,0,,...hiç...Dialogue: 0,0:08:34.11,0:08:36.03,Main,,0,0,0,,...kıpırdamıyor.Dialogue: 0,0:08:36.93,0:08:38.74,Main,,0,0,0,,Kıpırdamıyor mu?Dialogue: 0,0:08:39.33,0:08:43.29,Main,,0,0,0,,Aptallaşma!  Düşmanını yenmedin mi?!Dialogue: 0,0:08:43.29,0:08:47.79,Main,,0,0,0,,Robin'i çoktan kurtardık! Tüm yapmamız gereken kaçmak!Dialogue: 0,0:08:47.79,0:08:50.17,Main,,0,0,0,,Lütfen elinden geleni yap!Dialogue: 0,0:08:56.93,0:08:58.18,Main,,0,0,0,,Usopp!Dialogue: 0,0:09:00.68,0:09:04.09,Main,,0,0,0,,Gemiyi Luffy'nin olduğu yere götüreceğiz!Dialogue: 0,0:09:04.09,0:09:05.85,Main,,0,0,0,,Herkes çabuk gemiye binsin!Dialogue: 0,0:09:07.15,0:09:07.90,Main,,0,0,0,,Ateş!Dialogue: 0,0:09:19.45,0:09:21.20,Main,,0,0,0,,Olamaz! Kaçış gemimiz!Dialogue: 0,0:09:26.04,0:09:29.24,Main,,0,0,0,,Olamaz! Artık hiç umut yok!Dialogue: 0,0:09:29.24,0:09:32.80,Main,,0,0,0,,Buradan çıkmamızın başka yolu yok!Dialogue: 0,0:09:39.43,0:09:43.27,Main,,0,0,0,,Kokoro-san... Chimney... Gonbe... Chopper!Dialogue: 0,0:09:49.85,0:09:52.02,Main,,0,0,0,,O-Olamaz!Dialogue: 0,0:10:12.05,0:10:14.17,Main,,0,0,0,,Başardık!Dialogue: 0,0:10:14.63,0:10:15.92,Main,,0,0,0,,Çekilin yoldan!Dialogue: 0,0:10:15.92,0:10:17.27,Main,,0,0,0,,Hele şükür!Dialogue: 0,0:10:26.19,0:10:29.15,Main,,0,0,0,,Sanji-kun, nerelerdeydin?Dialogue: 0,0:10:31.43,0:10:34.31,Main,,0,0,0,,Afedersin, ilgilenmem gereken bir iş vardı.Dialogue: 0,0:10:36.17,0:10:39.77,Main,,0,0,0,,Her halükarda, burada başımız ciddi belada.Dialogue: 0,0:10:39.77,0:10:41.66,Main,,0,0,0,,Robin-chan elimizde olduğu için...Dialogue: 0,0:10:41.66,0:10:44.87,Main,,0,0,0,,...bize saldırmayacaklarını düşünmüştüm ama gemi-Dialogue: 0,0:10:46.97,0:10:49.83,Main,,0,0,0,,Buraya kadar korsanlar! Yaşlı kadını kurtaracağız ve-Dialogue: 0,0:10:50.01,0:10:51.88,Main,,0,0,0,,Bu olmayacak!Dialogue: 0,0:10:52.63,0:10:54.88,Main,,0,0,0,,Denizkızı Tekmesi!Dialogue: 0,0:11:00.39,0:11:01.30,Main,,0,0,0,,Ateş.Dialogue: 0,0:11:07.97,0:11:09.56,Main,,0,0,0,,Niye her zaman bu oluyor?!Dialogue: 0,0:11:09.56,0:11:11.44,Main,,0,0,0,,Onları ikinci kuleye gitmeleri için zorlayın.Dialogue: 0,0:11:11.77,0:11:12.81,Main,,0,0,0,,Ateş!Dialogue: 0,0:11:16.37,0:11:19.21,Main,,0,0,0,,Çok yakındı! Koşun, koşun!Dialogue: 0,0:11:20.43,0:11:21.24,Main,,0,0,0,,Ateş.Dialogue: 0,0:12:02.67,0:12:06.27,Main,,0,0,0,,Kahretsin, köprüyü yok ettiler!Dialogue: 0,0:12:06.27,0:12:07.81,Main,,0,0,0,,Bu kulede sıkıştık!Dialogue: 0,0:12:07.81,0:12:10.11,Main,,0,0,0,,Başka bir şey yapamayız!Dialogue: 0,0:12:10.11,0:12:12.67,Main,,0,0,0,,Dövüşmek zorundayız.Dialogue: 0,0:12:12.67,0:12:16.58,Main,,0,0,0,,Aptallaşma! Daha da güçlü adamlar gönderecekler!Dialogue: 0,0:12:16.58,0:12:20.59,Main,,0,0,0,,Birinci kuleye ateş etmeye hazırlanın!Dialogue: 0,0:12:34.06,0:12:37.56,Main,,0,0,0,,Hasır Şapkalı Luffy'yi yok edin!Dialogue: 0,0:12:44.61,0:12:47.24,Main,,0,0,0,,Luffy!!Dialogue: 0,0:12:53.15,0:12:55.50,Thoughts,,0,0,0,,Luffy'nin başı dertte! Bu tarafa geliyorlar!Dialogue: 0,0:12:56.83,0:12:57.84,Main,,0,0,0,,Durum kötü.Dialogue: 0,0:12:57.84,0:13:00.01,Main,,0,0,0,,Luffy!Dialogue: 0,0:13:00.80,0:13:07.18,Main,,0,0,0,,Faydasız, bu mesafeden tek yapabileceğim onu denize düşürmek.Dialogue: 0,0:13:07.18,0:13:09.18,Main,,0,0,0,,Luffy!Dialogue: 0,0:13:09.61,0:13:12.61,Main,,0,0,0,,Olamaz, işler şimdi cidden kötüleşti!Dialogue: 0,0:13:12.61,0:13:16.57,Main,,0,0,0,,Hasır Şapka-san kazandı ama ayağa kalkamıyor, bu yüzden öldürülecek!Dialogue: 0,0:13:17.44,0:13:18.75,Main,,0,0,0,,Hasır Şapka!Dialogue: 0,0:13:18.75,0:13:20.72,Main,,0,0,0,,Hasır Şapka-san!Dialogue: 0,0:13:22.03,0:13:25.03,Main,,0,0,0,,Ayağa kalk, Hasır Şapka-san!Dialogue: 0,0:13:25.03,0:13:27.34,Main,,0,0,0,,Dayan, çocuk!Dialogue: 0,0:13:27.34,0:13:29.15,Main,,0,0,0,,Korsan abi!Dialogue: 0,0:13:30.13,0:13:32.66,Main,,0,0,0,,Luffy! Ayağa kalk! Lütfen!Dialogue: 0,0:13:32.99,0:13:35.37,Main,,0,0,0,,Bir şeyler yapmalısın, Luffy!Dialogue: 0,0:13:35.37,0:13:36.59,Main,,0,0,0,,Luffy!Dialogue: 0,0:13:36.59,0:13:37.81,Main,,0,0,0,,Hasır Şapka!Dialogue: 0,0:13:37.81,0:13:41.27,Main,,0,0,0,,Hasır Şapka-san! Elinden geleni yap!Dialogue: 0,0:13:41.27,0:13:43.09,Main,,0,0,0,,Hasır Şapka!Dialogue: 0,0:13:47.75,0:13:50.18,Main,,0,0,0,,Durum kötü. Gerçekten kötü.Dialogue: 0,0:13:53.91,0:13:55.10,Thoughts,,0,0,0,,Yine mi?Dialogue: 0,0:13:55.65,0:13:56.52,Main,,0,0,0,,Kim o?!Dialogue: 0,0:13:58.25,0:14:02.27,Main,,0,0,0,,Aptal, öldürülmek mi istiyorsun? Niye öylece duruyorsun?Dialogue: 0,0:14:02.98,0:14:05.63,Main,,0,0,0,,Bu kimin sesi?Dialogue: 0,0:14:06.53,0:14:10.24,Main,,0,0,0,,S-Sahi. O zamankiyle aynı!Dialogue: 0,0:14:18.59,0:14:20.23,Main,,0,0,0,,Neler oluyor?!Dialogue: 0,0:14:20.23,0:14:21.38,Main,,0,0,0,,Hasır Şapka-san!Dialogue: 0,0:14:21.37,0:14:22.80,Main,,0,0,0,,Hasır Şapka!Dialogue: 0,0:14:22.80,0:14:25.05,Main,,0,0,0,,Sadece adamlarımın sesi!Dialogue: 0,0:14:25.49,0:14:29.18,Main,,0,0,0,,Hayır, değil! Bunca zamandır çağıran ses!Dialogue: 0,0:14:43.17,0:14:44.55,Main,,0,0,0,,Aşağıya?Dialogue: 0,0:14:46.39,0:14:48.35,Main,,0,0,0,,Aşağıya mı bakın?Dialogue: 0,0:14:59.61,0:15:03.67,Main,,0,0,0,,Gerçekten duyuyorum! Ne? "Aşağıya"?Dialogue: 0,0:15:09.03,0:15:10.01,Thoughts,,0,0,0,,Kim o?Dialogue: 0,0:15:11.77,0:15:13.10,Main,,0,0,0,,Neler oluyor?Dialogue: 0,0:15:19.27,0:15:20.85,Main,,0,0,0,,Aşağı bakın diyor!Dialogue: 0,0:15:20.85,0:15:22.98,Main,,0,0,0,,Neden bahsediyorsun, rengeyiği-chan?Dialogue: 0,0:15:23.34,0:15:27.97,Main,,0,0,0,,Hasır Şapkalı Luffy'yi vurmak için beş saniye.Dialogue: 0,0:15:27.97,0:15:29.00,Main,,0,0,0,,Luffy!Dialogue: 0,0:15:29.00,0:15:30.65,Main,,0,0,0,,Hasır Şapka-san!Dialogue: 0,0:15:38.87,0:15:42.55,Main,,0,0,0,,Okyanusa atlayın!Dialogue: 0,0:15:42.55,0:15:43.71,Main,,0,0,0,,Dört saniye.Dialogue: 0,0:15:44.15,0:15:46.17,Main,,0,0,0,,Okyanusa!Dialogue: 0,0:15:46.99,0:15:47.92,Main,,0,0,0,,Usopp?!Dialogue: 0,0:15:47.92,0:15:51.04,Main,,0,0,0,,Robin, Luffy'yi okyanusa atabilir misin?Dialogue: 0,0:15:51.04,0:15:52.01,Main,,0,0,0,,Ben hallederim.Dialogue: 0,0:15:52.01,0:15:54.26,Main,,0,0,0,,Aptal, kendini öldürmeye mi çalışıyorsun?!Dialogue: 0,0:15:54.93,0:15:57.22,Main,,0,0,0,,Bunun bir yararı olması mümkün değil!Dialogue: 0,0:15:57.91,0:15:59.18,Main,,0,0,0,,Üç!Dialogue: 0,0:15:59.18,0:16:02.69,Main,,0,0,0,,Bir şey olmayacak! Bizi kurtarmaya geldi!Dialogue: 0,0:16:02.69,0:16:06.57,Main,,0,0,0,,Hala bir arkadaşımız daha var!Dialogue: 0,0:16:07.63,0:16:08.53,Main,,0,0,0,,İki!Dialogue: 0,0:16:08.53,0:16:11.17,Main,,0,0,0,,Chopper, gördün mü?Dialogue: 0,0:16:11.17,0:16:12.53,Main,,0,0,0,,Gördüm!Dialogue: 0,0:16:16.21,0:16:18.24,Main,,0,0,0,,100 Çiçek!Dialogue: 0,0:16:24.93,0:16:25.92,Main,,0,0,0,,Bir!Dialogue: 0,0:16:25.92,0:16:27.45,Main,,0,0,0,,Hezaren Çiçeği!Dialogue: 0,0:16:29.85,0:16:31.76,Main,,0,0,0,,Hareket ediyorum! Robin mi?Dialogue: 0,0:16:34.64,0:16:36.60,Main,,0,0,0,,Okyanusa!Dialogue: 0,0:16:36.60,0:16:38.56,Main,,0,0,0,,Okyanusa!Dialogue: 0,0:16:38.56,0:16:40.52,Main,,0,0,0,,Okyanusa!Dialogue: 0,0:16:45.21,0:16:47.77,Main,,0,0,0,,Luffy'yi izleyin!Dialogue: 0,0:16:48.65,0:16:50.73,Main,,0,0,0,,Hadi!Dialogue: 0,0:16:51.53,0:16:53.70,Main,,0,0,0,,Hadi!Dialogue: 0,0:16:54.47,0:16:56.53,Main,,0,0,0,,Okyanusa!Dialogue: 0,0:16:56.90,0:16:59.75,Main,,0,0,0,,Korsanlar okyanusa atlıyor!Dialogue: 0,0:16:59.75,0:17:03.25,Main,,0,0,0,,Aptallar! Oraya atlarlarsa,  başarabilmeleri mümkün değil!Dialogue: 0,0:17:03.86,0:17:06.43,Main,,0,0,0,,Akıllarını mı kaçırmış bunlar?!Dialogue: 0,0:17:20.23,0:17:22.67,Thoughts,,0,0,0,,Gidelim çocuklar!Dialogue: 0,0:17:31.48,0:17:32.94,Main,,0,0,0,,Ateş!Dialogue: 0,0:17:40.55,0:17:43.20,Thoughts,,0,0,0,,Macera denizine dönelim!Dialogue: 0,0:17:46.16,0:17:51.03,Main,,0,0,0,,MERRY'YE BİNİN!Dialogue: 0,0:17:53.69,0:17:57.19,Main,,0,0,0,,Merry!Dialogue: 0,0:17:58.99,0:18:00.83,Thoughts,,0,0,0,,Sizi almaya geldim!Dialogue: 0,0:18:03.21,0:18:05.17,Main,,0,0,0,,Akıllarından ne geçiyor?Dialogue: 0,0:18:05.17,0:18:07.71,Main,,0,0,0,,Okyanusa atlarlarsa işleri biter!Dialogue: 0,0:18:07.71,0:18:09.61,Main,,0,0,0,,İçlerinde şeytan meyvesi kullanıcıları var.Dialogue: 0,0:18:10.10,0:18:11.51,Main,,0,0,0,,Bu intiharla aynı şey!Dialogue: 0,0:18:12.07,0:18:13.48,Main,,0,0,0,,Hey, durun.Dialogue: 0,0:18:14.73,0:18:16.07,Main,,0,0,0,,O da ne?Dialogue: 0,0:18:17.03,0:18:20.81,Main,,0,0,0,,Bir gemi! Bayrağına bakarsak,  Hasır Şapka tayfasının gemisi!Dialogue: 0,0:18:20.81,0:18:23.54,Main,,0,0,0,,Savaş gemileri filosunu nasıl geçti?Dialogue: 0,0:18:43.49,0:18:45.47,Main,,0,0,0,,Burada kim var bilmiyorum ama bizi kur-Dialogue: 0,0:18:53.63,0:18:54.32,Main,,0,0,0,,Ne?Dialogue: 0,0:19:05.87,0:19:07.51,Main,,0,0,0,,Bir sorun mu var, Sanji-kun?Dialogue: 0,0:19:07.51,0:19:09.62,Main,,0,0,0,,Şey, Nami-san.Dialogue: 0,0:19:10.21,0:19:14.14,Main,,0,0,0,,Buraya kadar geldim ama kimseyi göremiyorum.Dialogue: 0,0:19:19.25,0:19:22.39,Main,,0,0,0,,Cidden bir dahakine bunu kendiniz yapmalısınız!Dialogue: 0,0:19:23.83,0:19:27.31,Main,,0,0,0,,Atlayın, şeytan meyvesi kullanıcıları!Dialogue: 0,0:19:27.89,0:19:30.35,Main,,0,0,0,,Robin-chwan!Dialogue: 0,0:19:30.35,0:19:34.53,Main,,0,0,0,,Lütfen bana gel!Dialogue: 0,0:19:39.95,0:19:44.16,Main,,0,0,0,,Bu Merry! Bu Merry!Dialogue: 0,0:19:44.16,0:19:46.70,Main,,0,0,0,,Merry'yi çok seviyorum!Dialogue: 0,0:19:47.79,0:19:50.33,Main,,0,0,0,,Merry. Merry!Dialogue: 0,0:19:50.33,0:19:53.92,Main,,0,0,0,,Merry hala hayatta.Dialogue: 0,0:19:53.92,0:19:57.84,Main,,0,0,0,,Bunu niye yaptın?Dialogue: 0,0:19:58.31,0:20:03.59,Main,,0,0,0,,Ben... Ben... Ben artık...Dialogue: 0,0:20:03.59,0:20:08.81,Main,,0,0,0,,Buna inanamıyorum. Bu gemi okyanusa düşmüştü!Dialogue: 0,0:20:22.47,0:20:24.89,Main,,0,0,0,,Buraya kim getirdi acaba?Dialogue: 0,0:20:24.89,0:20:27.23,Main,,0,0,0,,Bunu sonra düşünün. Ne yapacağımızı söyle.Dialogue: 0,0:20:27.23,0:20:27.95,Main,,0,0,0,,Ah, doğru.Dialogue: 0,0:20:27.95,0:20:29.37,Main,,0,0,0,,Gidelim buradan!Dialogue: 0,0:20:29.37,0:20:31.45,Main,,0,0,0,,Hey, ne yapıyorsun, Sanji-kun?Dialogue: 0,0:20:31.45,0:20:34.23,Main,,0,0,0,,N-Nami-swan!Dialogue: 0,0:20:35.01,0:20:39.67,Main,,0,0,0,,Çok yakındı! O gemilerin beni öldüreceğini sanmıştım!Dialogue: 0,0:20:39.67,0:20:43.05,Main,,0,0,0,,Hey, Robin! Beni kurtardığın için sa-Dialogue: 0,0:20:52.25,0:20:54.10,Flashbacks,,0,0,0,,Gerisini biz hallederiz!Dialogue: 0,0:21:05.81,0:21:08.63,Main,,0,0,0,,Luffy'ye ve hepinize...Dialogue: 0,0:21:09.43,0:21:10.58,Main,,0,0,0,,...teşekkür ederim!Dialogue: 0,0:21:20.55,0:21:22.59,Main,,0,0,0,,Lafı bile olmaz!Dialogue: 0,0:21:28.29,0:21:31.52,Main,,0,0,0,,Bu tip aptalca konuşmaları kaçtıktan sonraya saklayın.Dialogue: 0,0:21:31.52,0:21:34.52,Main,,0,0,0,,Aptalca değil, marimo!Dialogue: 0,0:21:34.52,0:21:36.39,Main,,0,0,0,,Evet, marimo!Dialogue: 0,0:21:36.39,0:21:39.02,Main,,0,0,0,,Kapa çeneni! Burada ölürsek her şey biter!Dialogue: 0,0:21:39.02,0:21:41.27,Main,,0,0,0,,Robin-chan'dan özür dile!Dialogue: 0,0:21:41.27,0:21:43.74,Main,,0,0,0,,Zoro! Özür dile!Dialogue: 0,0:21:42.21,0:21:43.73,Secondary,,0,0,0,,Kesin şunu!Dialogue: 0,0:21:43.73,0:21:45.11,Main,,0,0,0,,Hey, Chopper.Dialogue: 0,0:21:45.61,0:21:47.35,Main,,0,0,0,,Hareket edebiliyor musun?Dialogue: 0,0:21:48.45,0:21:51.31,Main,,0,0,0,,Evet, edebiliyorum!Dialogue: 0,0:21:51.31,0:21:54.08,Main,,0,0,0,,Tekrardan hareket edebiliyorum, Zoro!Dialogue: 0,0:21:54.49,0:21:57.32,Main,,0,0,0,,Hemen Robin'den özür dileDialogue: 0,0:21:57.32,0:21:58.31,Main,,0,0,0,,Pes et.Dialogue: 0,0:21:58.31,0:22:00.05,Main,,0,0,0,,Hayır! Hayır!Dialogue: 0,0:22:00.97,0:22:04.66,Main,,0,0,0,,Pekâla çocuklar, gidelim buradan!Dialogue: 0,0:22:04.66,0:22:06.34,Main,,0,0,0,,Tamam!Dialogue: 0,0:22:06.34,0:22:10.44,Main,,0,0,0,,Hey, hey! Şaka yapıyor olmalısınız. Gerçekten kaçmaya mı çalışacaklar?Dialogue: 0,0:22:10.44,0:22:13.72,Main,,0,0,0,,Kaçmaya çalışırlarsa, Nico Robin de dahil olmak üzere hepsini havaya uçurun!Dialogue: 0,0:22:14.20,0:22:16.60,Main,,0,0,0,,Ama Nico Robin'in hayatta kalması gerekmiyor mu?Dialogue: 0,0:22:17.07,0:22:20.73,Main,,0,0,0,,Amiral Aokiji böyle dedi.Dialogue: 0,0:22:20.73,0:22:22.57,Main,,0,0,0,,Tüm gemiler ateşe hazırlansın!Dialogue: 0,0:22:22.92,0:22:25.55,Main,,0,0,0,,A-Amiral Aokiji mi?!Dialogue: 0,0:22:25.55,0:22:27.27,Main,,0,0,0,,Tamam, nişan al!Dialogue: 0,0:22:27.27,0:22:32.27,Main,,0,0,0,,Tüm gemiler ateşe hazırlansın! Tüm gemiler ateşe hazırlansın!Dialogue: 0,0:22:34.23,0:22:37.68,Thoughts,,0,0,0,,Koca bir yalan ama kaçmalarına izin veremem. Onları öldüreceğim!Dialogue: 0,0:22:37.68,0:22:39.12,Thoughts,,0,0,0,,Hepsi bu şekilde ölecek!Dialogue: 0,0:22:41.50,0:22:44.98,Main,,0,0,0,,Herkes işe koyulsun!Dialogue: 0,0:22:44.98,0:22:47.47,Main,,0,0,0,,Pislik Spanda. Hala hayatta mı?Dialogue: 0,0:22:47.80,0:22:49.22,Main,,0,0,0,,Bize nişan alıyorlar!Dialogue: 0,0:22:49.22,0:22:51.22,Main,,0,0,0,,Rüzgarı yakalayalım ve doğuya gidelim!Dialogue: 0,0:22:51.22,0:22:53.16,Main,,0,0,0,,Faydasız! Tamamiyle çevrildik!Dialogue: 0,0:22:53.16,0:22:56.18,Main,,0,0,0,,Hepsi tam bize nişan alıyor!Dialogue: 0,0:22:56.18,0:22:59.64,Main,,0,0,0,,Bu gemiyi ıskalamaları mümkün değil.Dialogue: 0,0:22:59.64,0:23:00.90,Main,,0,0,0,,Ateş!Dialogue: 0,0:23:10.19,0:23:14.83,Main,,0,0,0,,Kendilerini mi vurdular? Diğerleri de hiç vurmadı.Dialogue: 0,0:23:15.19,0:23:17.66,Main,,0,0,0,,Nereye nişan alıyorsunuz?Dialogue: 0,0:23:17.66,0:23:20.57,Main,,0,0,0,,Tuhaf! Nasılsa nişanımız kaydı!Dialogue: 0,0:23:20.57,0:23:22.08,Main,,0,0,0,,Aptalca mazeretler uydurma!Dialogue: 0,0:23:24.09,0:23:25.40,Main,,0,0,0,,Çekilin!Dialogue: 0,0:23:25.40,0:23:27.17,Main,,0,0,0,,Yapamıyoruz! Çarpacağız!Dialogue: 0,0:23:35.81,0:23:38.41,Main,,0,0,0,,Çarpacağız! Neler oluyor Allah aşkına!Dialogue: 0,0:23:41.69,0:23:44.72,Main,,0,0,0,,Neler oluyor? Nedir bu?Dialogue: 0,0:23:44.72,0:23:46.47,Main,,0,0,0,,B-Bakın!Dialogue: 0,0:23:47.44,0:23:49.11,Main,,0,0,0,,Ne?!Dialogue: 0,0:23:50.03,0:23:52.93,Main,,0,0,0,,Adalet Kapısı kapanıyor!Dialogue: 0,0:23:52.93,0:23:55.85,Main,,0,0,0,,Kapı tarafından engellenen akıntılar  girdaplar oluşturdu...Dialogue: 0,0:23:55.85,0:23:57.21,Main,,0,0,0,,...ve bizi rotamızdan çıkarıyorlar!Dialogue: 0,0:23:57.21,0:23:59.40,Main,,0,0,0,,Nişanımız bu yüzden mi kaydı?Dialogue: 0,0:23:59.40,0:24:00.87,Main,,0,0,0,,Girdaplara yakalanmayın!Dialogue: 0,0:24:00.87,0:24:03.50,Main,,0,0,0,,N-Neler oluyor?Dialogue: 0,0:24:07.69,0:24:09.60,Main,,0,0,0,,Oyalanmayı bırakın, çabuk!Dialogue: 0,0:24:09.60,0:24:11.72,Main,,0,0,0,,Çok geç, herkes kaçsın!Dialogue: 0,0:24:12.18,0:24:16.05,Main,,0,0,0,,Aptallar, niye kapıyı kapattınız? Ne yapıyorsunuz böyle?!Dialogue: 0,0:24:16.69,0:24:20.33,Main,,0,0,0,,Kapıyı açıp kapatan kol,  Tereddüt Köprüsü'nün üçüncü kulesindeydi.Dialogue: 0,0:24:20.33,0:24:21.65,Main,,0,0,0,,Bizden biri olması mümkün değil!Dialogue: 0,0:24:21.65,0:24:23.98,Main,,0,0,0,,Vaay, düşündüğümden de iyiydi!Dialogue: 0,0:24:23.98,0:24:26.49,Main,,0,0,0,,Sanji! Yoksa demin  bunu yapmaya mı gitmiştin?Dialogue: 0,0:24:26.49,0:24:27.02,Main,,0,0,0,,Evet.Dialogue: 0,0:24:28.43,0:24:31.40,Main,,0,0,0,,Sadece güç kullanarak onlardan kaçamayız.Dialogue: 0,0:24:36.81,0:24:38.07,Flashbacks,,0,0,0,,Tam isabet.Dialogue: 0,0:24:40.04,0:24:42.54,Main,,0,0,0,,Müthişsin, Sanji!Dialogue: 0,0:24:42.54,0:24:43.50,Main,,0,0,0,,Dahi misin sen?Dialogue: 0,0:24:44.03,0:24:47.75,Main,,0,0,0,,Övüp durmayın şunu. Girdaplar bizim için de tehlikeli olacak.Dialogue: 0,0:24:47.75,0:24:49.46,Main,,0,0,0,,Ah! Doğru! Öle-Dialogue: 0,0:24:49.46,0:24:51.92,Main,,0,0,0,,Hepiniz sessiz olun!Dialogue: 0,0:24:53.53,0:24:59.14,Main,,0,0,0,,Merry'yle geçemeyeceğimiz bir okyanus yok!Dialogue: 0,0:25:00.99,0:25:03.10,Main,,0,0,0,,Doğru! Sana güveniyoruz, rotacı!Dialogue: 0,0:25:00.99,0:25:03.10,Secondary,,0,0,0,,Nami-san çok mükemmel!Dialogue: 0,0:25:03.58,0:25:05.79,Main,,0,0,0,,Ne yapacağımızı bulana dek dayanın!Dialogue: 0,0:25:05.79,0:25:06.94,Main,,0,0,0,,Biz hallederiz!Dialogue: 0,0:25:15.33,0:25:19.31,Main,,0,0,0,,Tek Kılıç Stili: 36 Pound'luk Top!Dialogue: 0,0:25:22.23,0:25:25.84,Main,,0,0,0,,Kahretsin! Niye?! Niye savaş gemileri onları vuramıyor?!Dialogue: 0,0:25:25.90,0:25:30.22,Main,,0,0,0,,Siz embesiller, zavallı tek bir gemiyi bile devirecek kapasitede değil misiniz?!Dialogue: 0,0:25:31.11,0:25:32.55,Main,,0,0,0,,Benim için bir kez daha doldur!Dialogue: 0,0:25:32.57,0:25:34.09,Main,,0,0,0,,Olmaz! O olmaz!Dialogue: 0,0:25:34.09,0:25:36.29,Main,,0,0,0,,Bir tane kaçırdım, yakala Sanji!Dialogue: 0,0:25:36.29,0:25:37.55,Main,,0,0,0,,Alt Kaburga!Dialogue: 0,0:25:37.90,0:25:42.02,Main,,0,0,0,,Ah! Ben de dövüşeceğim!Dialogue: 0,0:25:42.49,0:25:44.89,Main,,0,0,0,,Aptal, henüz kıpırdayamazsın!Dialogue: 0,0:25:46.33,0:25:48.98,Main,,0,0,0,,O haklı, Luffy. Burayla biz ilgileniriz.Dialogue: 0,0:25:49.54,0:25:51.19,Main,,0,0,0,,Sen sadece dinlen!Dialogue: 0,0:25:55.61,0:26:00.54,Main,,0,0,0,,Ah! Ne dediğiniz umrumda değil,...Dialogue: 0,0:26:00.54,0:26:05.15,Main,,0,0,0,,...ben de dövüşeceğim.Dialogue: 0,0:26:06.12,0:26:10.02,Main,,0,0,0,,Kim başarırsa madalya vereceğim. Vurun şunları artık!Dialogue: 0,0:26:10.02,0:26:12.55,Main,,0,0,0,,Tüm gemiler ateş etsin!Dialogue: 0,0:26:12.55,0:26:14.13,Main,,0,0,0,,Ateş!Dialogue: 0,0:26:16.97,0:26:20.80,Main,,0,0,0,,Ama ben kaptanım!Dialogue: 0,0:26:34.53,0:26:35.74,Main,,0,0,0,,Bir...Dialogue: 0,0:26:35.74,0:26:36.99,Main,,0,0,0,,...iki...Dialogue: 0,0:26:36.99,0:26:38.91,Main,,0,0,0,,...üç!Dialogue: 0,0:26:38.91,0:26:41.70,Main,,0,0,0,,Hayır! Bize geri geliyorlar!Dialogue: 0,0:26:47.33,0:26:49.31,Main,,0,0,0,,Biz kurtardın, Kaptan!Dialogue: 0,0:26:49.31,0:26:51.33,Main,,0,0,0,,Bir kaptana da bu yakışır!Dialogue: 0,0:26:51.33,0:26:53.37,Main,,0,0,0,,Hey! Canavarsınız siz!Dialogue: 0,0:26:53.37,0:26:54.25,Main,,0,0,0,,V!Dialogue: 0,0:26:53.37,0:26:54.25,Note,,0,0,0,,V (Victory) - Zafer İşareti!Dialogue: 0,0:26:59.55,0:27:02.51,Main,,0,0,0,,Buldum. Zafere giden yolu.Dialogue: 0,0:27:02.51,0:27:05.61,Main,,0,0,0,,Chopper, bizi biraz iskele yönüne çevir! 9 yönüne!Dialogue: 0,0:27:05.61,0:27:06.98,Main,,0,0,0,,Tamam!Dialogue: 0,0:27:08.17,0:27:10.98,Main,,0,0,0,,Korsan gemisi şelaleye doğru gidiyor!Dialogue: 0,0:27:10.98,0:27:14.40,Main,,0,0,0,,Ateş, ateş! Ne yapıyorsunuz?Dialogue: 0,0:27:14.40,0:27:17.44,Main,,0,0,0,,Hepiniz aptal mısınız?! Hemen batırın şunu artık!Dialogue: 0,0:27:17.83,0:27:20.08,Main,,0,0,0,,Girdapların dönüşünü kullanıyor gibiler!Dialogue: 0,0:27:20.08,0:27:21.41,Main,,0,0,0,,Ne inanılmaz bir hız!Dialogue: 0,0:27:21.41,0:27:24.80,Main,,0,0,0,,Ben de yardım edebilirim!Dialogue: 0,0:27:24.80,0:27:27.25,Main,,0,0,0,,İyi şanslar, rengeyiği-chan!Dialogue: 0,0:27:27.25,0:27:32.57,Main,,0,0,0,,Hadi! Devam et!Dialogue: 0,0:27:34.31,0:27:38.30,Main,,0,0,0,,Kahretsin! Kahretsin! Lanet olasıcalar!Dialogue: 0,0:27:38.66,0:27:41.89,Main,,0,0,0,,Enies Lobby'nin tüm gücünü kullandım.Dialogue: 0,0:27:42.30,0:27:46.76,Main,,0,0,0,,Ulusal seviyedeki  Yıkım Çağrısı'nın tüm gücünü kullandım!Dialogue: 0,0:27:46.76,0:27:50.73,Main,,0,0,0,,Niye, o değersiz korsanlardan...Dialogue: 0,0:27:50.73,0:27:55.69,Main,,0,0,0,,...tek bir kadını bile...Dialogue: 0,0:27:57.23,0:28:01.07,Main,,0,0,0,,...ele geçiremiyorum?!Dialogue: 0,0:28:26.27,0:28:27.14,Main,,0,0,0,,Şef!Dialogue: 0,0:28:34.35,0:28:35.93,Main,,0,0,0,,Yardım edin!Dialogue: 0,0:28:39.29,0:28:40.78,Main,,0,0,0,,Kurtarın...Dialogue: 0,0:28:43.17,0:28:44.11,Main,,0,0,0,,Kavra!Dialogue: 0,0:28:49.27,0:28:51.04,Main,,0,0,0,,Ş-Şef!Dialogue: 0,0:28:56.79,0:29:01.63,Main,,0,0,0,,Kavga! Kavga! Kavga!Dialogue: 0,0:28:58.11,0:29:00.39,Secondary,,0,0,0,,Evet, hepsi bu kadar.Dialogue: 0,0:29:00.39,0:29:01.63,Secondary,,0,0,0,,Franky...Dialogue: 0,0:29:02.01,0:29:03.59,Main,,0,0,0,,Yardımın lazım!Dialogue: 0,0:29:03.59,0:29:04.38,Main,,0,0,0,,Tamam!Dialogue: 0,0:29:10.81,0:29:13.10,Main,,0,0,0,,Kendinizi sağlamlaştırın.Dialogue: 0,0:29:13.52,0:29:17.11,Main,,0,0,0,,Önlerini kesin!  Girdaplardan çıkmalarına izin vermeyin!Dialogue: 0,0:29:17.53,0:29:21.19,Main,,0,0,0,,Biraz geminin canını yakabilir.  Bu yüzden üzgünüm.Dialogue: 0,0:29:21.59,0:29:24.33,Main,,0,0,0,,Güçlü Rüzgar!Dialogue: 0,0:29:25.93,0:29:28.53,Main,,0,0,0,,K-Korsan gemisi... uçuyor mu?Dialogue: 0,0:29:29.16,0:29:30.91,Main,,0,0,0,,Bu mümkün mü ki?Dialogue: 0,0:29:30.91,0:29:33.20,Main,,0,0,0,,Savaş gemilerinden kaçtılar!Dialogue: 0,0:29:34.35,0:29:37.13,Main,,0,0,0,,Bu geminin deneyimini görmezden gelmeyin.Dialogue: 0,0:29:37.13,0:29:40.60,Main,,0,0,0,,Merry, 10 bin metre havaya yükselen bir gemidir!Dialogue: 0,0:29:40.60,0:29:43.51,Main,,0,0,0,,Kesin Öldürücü Süper Duman Yıldızı!Dialogue: 0,0:29:47.95,0:29:49.14,Main,,0,0,0,,Duman bombası!!Dialogue: 0,0:29:55.45,0:29:56.72,Main,,0,0,0,,Pislikler!Dialogue: 0,0:29:56.72,0:29:58.60,Main,,0,0,0,,Peşlerinden! Bizden hızlı gidemezler!Dialogue: 0,0:29:58.97,0:30:01.60,Main,,0,0,0,,Yapamayız! Girdaplara yakalandık!Dialogue: 0,0:30:01.60,0:30:03.19,Main,,0,0,0,,Batmamak için elimizden gelen  her şeyi yapıyoruz!Dialogue: 0,0:30:10.39,0:30:12.24,Main,,0,0,0,,Ateş! Ateş!Dialogue: 0,0:30:43.13,0:30:45.36,Main,,0,0,0,,Hasır Şapkalar kaçtı!Dialogue: 0,0:30:45.86,0:30:48.24,Main,,0,0,0,,Tamam. Biz de geri dönmeliyiz!Dialogue: 0,0:30:59.75,0:31:04.53,Main,,0,0,0,,Hadi, Püfleyen Tom!Dialogue: 0,0:31:11.67,0:31:15.14,Main,,0,0,0,,B-Burada mıydınız, efendim? Peşlerinden gideceğiz!Dialogue: 0,0:31:15.61,0:31:18.13,Main,,0,0,0,,Burada sona ermesine izin vermeyeceğiz!Dialogue: 0,0:31:18.13,0:31:22.23,Main,,0,0,0,,Ne olursa olsun Denizciler- Hayır, Dünya Hükümeti-Dialogue: 0,0:31:22.66,0:31:26.23,Main,,0,0,0,,Hasır Şapka korsanlarını durduracağız! Kesinlikle!Dialogue: 0,0:31:26.23,0:31:30.03,Main,,0,0,0,,Suçlu Nico Robin'i mutlaka yakalayacağız!Dialogue: 0,0:31:30.03,0:31:34.35,Main,,0,0,0,,Daha fazla savaş gemisi ve asker alacağız ve-Dialogue: 0,0:31:34.35,0:31:35.33,Main,,0,0,0,,Sorun değil.Dialogue: 0,0:31:35.33,0:31:36.47,Main,,0,0,0,,Ama...Dialogue: 0,0:31:36.47,0:31:39.60,Main,,0,0,0,,Bir ülkenin askeri gücü kadar güçlü olan  Yıkım Çağrısı'nı kullandık.Dialogue: 0,0:31:39.60,0:31:43.80,Main,,0,0,0,,Bu filonun yaptığı hatayı ve  mevcut durumu göz önüne aldığımızda...Dialogue: 0,0:31:43.80,0:31:47.30,Main,,0,0,0,,...hukukun simgesi olan  Enies Lobby'de sonuç oldukça bariz.Dialogue: 0,0:31:48.49,0:31:52.26,Main,,0,0,0,,Bu durum, tam bir yenilgiyle sonuçlandı.Dialogue: 0,0:31:53.53,0:31:56.15,Main,,0,0,0,,Kafasının üstünde iyi olacak mısın?Dialogue: 0,0:31:56.15,0:31:58.93,Main,,0,0,0,,Evet, bu benim özel koltuğum.Dialogue: 0,0:31:58.93,0:32:02.55,Main,,0,0,0,,İşte. Düşme sakın.Dialogue: 0,0:32:03.21,0:32:05.90,Main,,0,0,0,,Sağol, canavar nine.Dialogue: 0,0:32:08.57,0:32:10.31,Main,,0,0,0,,Sağol, Merry.Dialogue: 0,0:32:10.31,0:32:12.36,Main,,0,0,0,,Sayende kaçtık.Dialogue: 0,0:32:13.15,0:32:16.45,Main,,0,0,0,,Merry'nin bizi kurtarmaya geleceğini hiç düşünmemiştim.Dialogue: 0,0:32:16.45,0:32:20.83,Main,,0,0,0,,Ama şimdi düşünüyorum da,  her zaman senin tarafından korunduk.Dialogue: 0,0:32:21.24,0:32:23.79,Main,,0,0,0,,Arkadaşımız olmana çok sevindim.Dialogue: 0,0:32:24.40,0:32:26.89,Main,,0,0,0,,Sağol, Merry.Dialogue: 0,0:32:26.89,0:32:28.79,Main,,0,0,0,,Ama siz...Dialogue: 0,0:32:29.33,0:32:32.26,Main,,0,0,0,,...epey inanılmaz şeyler yaptınız.Dialogue: 0,0:32:32.26,0:32:37.19,Main,,0,0,0,,Dünya Hükümeti'nin bayrağını yaktınız.Dialogue: 0,0:32:37.19,0:32:40.61,Main,,0,0,0,,Ne? Özel bir şey değil.Dialogue: 0,0:32:41.51,0:32:46.65,Main,,0,0,0,,Sadece bizden alınan arkadaşımızı geri alıyorduk.Dialogue: 0,0:32:47.59,0:32:50.61,Main,,0,0,0,,Sen de Robin'i kurtardın, bu yüzden sağol.Dialogue: 0,0:32:51.53,0:32:56.57,Main,,0,0,0,,Şey, benim kadar harika biri için pek özel bir şey sayılmaz.Dialogue: 0,0:32:57.67,0:32:59.16,Main,,0,0,0,,Neyse!Dialogue: 0,0:32:59.16,0:33:00.04,Main,,0,0,0,,Bu dövüş...Dialogue: 0,0:33:01.25,0:33:03.33,Main,,0,0,0,,...bizim...Dialogue: 0,0:33:03.33,0:33:06.25,Main,,0,0,0,,...zaferimiz!Dialogue: 0,0:33:14.22,0:33:17.40,Credits,,0,0,0,,Editing:  Galaxy 9000  Timing: KaitouYahiko  Quality Control: danpmss, DolphinWeabu, Galaxy 9000, Pepperjack Zenef  Soundtracking:  Halee  Graphics:  Datenshi  Karaoke: KaitouYahiko  Translation: Crunchyroll, GaijinDialogue: 0,0:00:00.71,0:00:03.37,Lyrics,,0,0,0,,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪Dialogue: 0,0:00:03.59,0:00:06.46,Lyrics,,0,0,0,,♪ Bayrağımızı süsleyip, gökyüzüne kaldırarak. ♪Dialogue: 0,0:00:12.77,0:00:18.06,Lyrics,,0,0,0,,♪ Sonsuz okyanusu geçip aramaya gidelim. ♪Dialogue: 0,0:00:18.86,0:00:21.81,Lyrics,,0,0,0,,♪ Henüz kimse tarafından...Dialogue: 0,0:00:21.90,0:00:23.94,Lyrics,,0,0,0,,...bulunmamış bu dünyanın mucizesini. ♪Dialogue: 0,0:00:24.82,0:00:27.96,Lyrics,,0,0,0,,♪ Çarpıp duran göğsümüzdeki...Dialogue: 0,0:00:27.96,0:00:29.71,Lyrics,,0,0,0,,...aynı hislerle devam etmeliyiz. ♪Dialogue: 0,0:00:29.71,0:00:35.59,Lyrics,,0,0,0,,♪ Hayaller peşinde koşanlar tarafından bırakılmış ayak izleri. ♪Dialogue: 0,0:00:36.42,0:00:39.39,Lyrics,,0,0,0,,♪ Ne tür bir fırtınalı gece olursa olsun,...Dialogue: 0,0:00:39.39,0:00:42.39,Lyrics,,0,0,0,,...kalplerimizin bir olmasını sağlarsak...Dialogue: 0,0:00:42.39,0:00:46.54,Lyrics,,0,0,0,,...bu zorluğun üstesinden gelebileceğiz! ♪Dialogue: 0,0:00:46.68,0:00:47.86,Lyrics,,0,0,0,,♪ Her zaman ♪Dialogue: 0,0:00:48.76,0:00:51.59,Lyrics,,0,0,0,,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪Dialogue: 0,0:00:51.72,0:00:54.55,Lyrics,,0,0,0,,♪ Bayrağımızı dalgalandırıp gökyüzüne kaldırarak. ♪Dialogue: 0,0:00:54.60,0:00:57.14,Lyrics,,0,0,0,,♪ Kimseye göstermeyeceğiz. ♪Dialogue: 0,0:00:57.23,0:01:00.58,Lyrics,,0,0,0,,♪ Gözlerimizde yaşlar olsa bile. ♪Dialogue: 0,0:01:00.77,0:01:03.52,Lyrics,,0,0,0,,♪ Peşinden gidelim, peşinden gidelim! ♪Dialogue: 0,0:01:03.69,0:01:06.52,Lyrics,,0,0,0,,♪ Hayallerimize giden doğru yolu...Dialogue: 0,0:01:06.61,0:01:09.23,Lyrics,,0,0,0,,...gösteren pusulanın. ♪Dialogue: 0,0:01:09.23,0:01:11.40,Lyrics,,0,0,0,,♪ Durmayacağız. ♪Dialogue: 0,0:01:11.42,0:01:14.42,Lyrics,,0,0,0,,♪ Dünyayı dolaşarak...Dialogue: 0,0:01:14.45,0:01:15.85,Lyrics,,0,0,0,,...yeniden başlayalım! ♪Dialogue: 0,0:01:18.83,0:01:21.49,Lyrics,,0,0,0,,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪Dialogue: 0,0:01:21.80,0:01:24.54,Lyrics,,0,0,0,,♪ Hedefimize doğru herkesten daha fazla. ♪Dialogue: 0,0:01:24.63,0:01:27.12,Lyrics,,0,0,0,,♪ Şimdi kaçmazsak,...Dialogue: 0,0:01:27.22,0:01:30.54,Lyrics,,0,0,0,,...yarını sıkı sıkıya kavrayabileceğiz! ♪Dialogue: 0,0:01:30.60,0:01:33.63,Lyrics,,0,0,0,,♪ Peşinden gidelim, peşinden gidelim! ♪Dialogue: 0,0:01:33.68,0:01:36.51,Lyrics,,0,0,0,,♪ Gözlerinden yansıtılmış tüm şimdiki zamanın. ♪Dialogue: 0,0:01:36.56,0:01:38.93,Lyrics,,0,0,0,,♪ Bembeyaz bir kalp...Dialogue: 0,0:01:39.15,0:01:41.43,Lyrics,,0,0,0,,...bana tüm hikayeyi anlatacak! ♪Dialogue: 0,0:01:41.73,0:01:44.43,Lyrics,,0,0,0,,♪ Yepyeni bir dünyada...Dialogue: 0,0:01:44.53,0:01:45.83,Lyrics,,0,0,0,,...yeniden başlayalım! ♪