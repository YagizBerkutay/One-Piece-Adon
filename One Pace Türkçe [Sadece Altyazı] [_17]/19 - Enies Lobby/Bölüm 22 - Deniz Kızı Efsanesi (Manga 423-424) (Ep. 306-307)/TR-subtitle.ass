Dialogue: 1,0:01:49.96,0:01:55.47,Title,,0,0,0,,{\fad(700,0)}Deniz Kızı Efsanesi
Dialogue: 0,0:02:03.18,0:02:04.39,Main,,0,0,0,,Çok yakındı!
Dialogue: 0,0:02:08.19,0:02:12.32,Main,,0,0,0,,Savaş gemileri niye birbirine ateş ediyor?\NAptal mı bunlar?
Dialogue: 0,0:02:12.32,0:02:15.11,Main,,0,0,0,,Ama yine küçüldüm.
Dialogue: 0,0:02:15.11,0:02:20.53,Main,,0,0,0,,Üçüncü, süper bir fikir ve güçlü\Nama yan etkisi epey kötü.
Dialogue: 0,0:02:21.41,0:02:23.49,Main,,0,0,0,,Bir dakika kadar büyüktüm,...
Dialogue: 0,0:02:23.49,0:02:25.83,Main,,0,0,0,,...bu yüzden muhtemelen \Nbir dakika kadar küçük olacağım.
Dialogue: 0,0:02:26.25,0:02:29.29,Main,,0,0,0,,Normale dönene dek saklanmalıyım,\Nyoksa beni öldürecek!
Dialogue: 0,0:02:39.97,0:02:42.76,Main,,0,0,0,,Ciddi mi yoksa şaka mı yapıyor?
Dialogue: 0,0:02:42.76,0:02:44.85,Main,,0,0,0,,Öyle ya da böyle yaşıyor.
Dialogue: 0,0:02:44.85,0:02:48.73,Main,,0,0,0,,Gerçi o saldırıda ölseydi,\Nzaman harcadığıma değmezdi.
Dialogue: 0,0:03:09.54,0:03:11.67,Main,,0,0,0,,İşte ön kapı!
Dialogue: 0,0:03:11.67,0:03:13.08,Main,,0,0,0,,Neredeyse vardık!
Dialogue: 0,0:03:16.46,0:03:18.51,Main,,0,0,0,,Acele edin!
Dialogue: 0,0:03:19.80,0:03:26.06,Flashbacks,,0,0,0,,Sevdiğin Franky, \Naynı Tom-san gibi götürüldü!
Dialogue: 0,0:03:26.72,0:03:28.52,Flashbacks,,0,0,0,,Bizimle gelmek ister misin?
Dialogue: 0,0:03:35.31,0:03:38.32,Main,,0,0,0,,Vırak!
Dialogue: 0,0:03:45.58,0:03:48.66,Main,,0,0,0,,Hasır Şapka o savaş gemisindeydi \Nve parçalara ayrıldı!
Dialogue: 0,0:03:48.66,0:03:50.37,Main,,0,0,0,,Hak ettiğini buldu!
Dialogue: 0,0:03:51.50,0:03:54.38,Main,,0,0,0,,Kaptanın öldü!
Dialogue: 0,0:03:55.29,0:03:58.25,Main,,0,0,0,,Hey, hey!\NDenizciler niye ateş ediyor?
Dialogue: 0,0:03:58.71,0:04:02.09,Main,,0,0,0,,Çağırdığım Yıkım Çağrısı'nın gücü bu işte!
Dialogue: 0,0:04:02.09,0:04:05.05,Main,,0,0,0,,Adalet bu, Cutty Flam!
Dialogue: 0,0:04:05.05,0:04:08.77,Main,,0,0,0,,Şimdi, Nico Robin'i teslim et.
Dialogue: 0,0:04:08.77,0:04:13.14,Main,,0,0,0,,Bunu yaparsan, \Nsuçlarından ötürü seni affedeceğim.
Dialogue: 0,0:04:13.14,0:04:17.32,Main,,0,0,0,,Zaten o kadını niye koruyorsun ki?
Dialogue: 0,0:04:17.86,0:04:19.82,Main,,0,0,0,,Korsan değilsin ya!
Dialogue: 0,0:04:19.82,0:04:24.86,Main,,0,0,0,,Dünya Hükümeti, kendini senin\Ngibi vatandaşları korumaya adamış.
Dialogue: 0,0:04:24.86,0:04:28.74,Main,,0,0,0,,Damarlarında Ohara kanı akan o kadına,\Ngerçekten bizden daha fazla mı güveniyorsun?
Dialogue: 0,0:04:30.08,0:04:33.83,Main,,0,0,0,,Bize karşı çıkarsan, aynı Tom gibi...
Dialogue: 0,0:04:40.00,0:04:43.93,Main,,0,0,0,,Yüzümde şişecek yer kalmadı.
Dialogue: 0,0:04:47.30,0:04:49.64,Main,,0,0,0,,Fil Kılıç, Funkfreed!
Dialogue: 0,0:04:49.64,0:04:50.85,Main,,0,0,0,,O şey güçlü!
Dialogue: 0,0:04:51.27,0:04:55.48,Main,,0,0,0,,Tamam mı, Funkfreed?\NArtık karşı koyamadıklarına göre,...
Dialogue: 0,0:04:55.48,0:04:59.19,Main,,0,0,0,,...savunmasız haldeyken \NNico Robin'e öldürücü bir darbe vur.
Dialogue: 0,0:04:59.65,0:05:01.18,Main,,0,0,0,,Al bakalım!
Dialogue: 0,0:05:01.18,0:05:03.53,Main,,0,0,0,,{\fad(150,150)}Fil Doğrayışı!
Dialogue: 0,0:05:07.78,0:05:09.20,Main,,0,0,0,,Seni...
Dialogue: 0,0:05:20.92,0:05:21.75,Main,,0,0,0,,Durdurdu mu?
Dialogue: 0,0:05:29.26,0:05:32.06,Main,,0,0,0,,Senin için gerçekten umut yok.
Dialogue: 0,0:05:33.47,0:05:37.90,Main,,0,0,0,,Lanet olsun, Funkfreed!\NSen bir filsin, güç savaşında nasıl kaybedersin?!
Dialogue: 0,0:05:37.90,0:05:39.44,Main,,0,0,0,,Doğra hepsini!
Dialogue: 0,0:05:42.19,0:05:45.15,Main,,0,0,0,,Burnunu normale döndür, fil.
Dialogue: 0,0:05:45.19,0:05:48.16,Main,,0,0,0,,Tabii alnında bir delik açmamı istemiyorsan.
Dialogue: 0,0:05:50.83,0:05:53.83,Main,,0,0,0,,Evet, aynen böyle. İyi iş.
Dialogue: 0,0:05:53.83,0:05:57.00,Main,,0,0,0,,Nico Robin, Hasır Şapkagil burada olacak mı?
Dialogue: 0,0:05:57.96,0:05:59.88,Main,,0,0,0,,Hepsi burada olacak.
Dialogue: 0,0:06:02.96,0:06:06.88,Main,,0,0,0,,Her şeyimi onlar üzerine bahse\Nkoyduğumu söylemiştim, Spanda.
Dialogue: 0,0:06:06.88,0:06:07.51,Main,,0,0,0,,Ne?
Dialogue: 0,0:06:08.43,0:06:11.89,Main,,0,0,0,,Bu günün geleceğini hiç düşünmemiştim.
Dialogue: 0,0:06:13.06,0:06:16.39,Main,,0,0,0,,O gün gücüm olsaydı,...
Dialogue: 0,0:06:16.85,0:06:18.73,Flashbacks,,0,0,0,,Suç değişti.
Dialogue: 0,0:06:19.19,0:06:23.69,Flashbacks,,0,0,0,,Korsanlar Kralı Gold Roger'a\Nbir gemi yaptığı için,...
Dialogue: 0,0:06:23.69,0:06:27.65,Flashbacks,,0,0,0,,...gemi marangozu Tom, \NEnies Lobby'ye götürülecek.
Dialogue: 0,0:06:28.20,0:06:29.24,Flashbacks,,0,0,0,,Hepsi bu kadar.
Dialogue: 0,0:06:32.45,0:06:35.58,Flashbacks,,0,0,0,,Yaşlı adam niye böyle bir şey yapıyor?
Dialogue: 0,0:06:35.58,0:06:38.25,Flashbacks,,0,0,0,,Neyse. Onlarla bir işim yok.
Dialogue: 0,0:06:38.25,0:06:40.67,Flashbacks,,0,0,0,,Çırakları serbest bırakın!
Dialogue: 0,0:06:46.59,0:06:49.43,Flashbacks,,0,0,0,,Tom-san artık kurtarılamaz.
Dialogue: 0,0:06:50.01,0:06:53.60,Flashbacks,,0,0,0,,Dünya Hükümeti'ne karşıyız.\NYapabileceğimiz bir şey yok.
Dialogue: 0,0:06:53.60,0:06:58.23,Flashbacks,,0,0,0,,Burada kalın.\NTom-san tarafından kurtarıldınız.
Dialogue: 0,0:06:58.23,0:07:00.10,Flashbacks,,0,0,0,,Onlara karşı çıkarsanız...
Dialogue: 0,0:07:00.10,0:07:02.48,Flashbacks,,0,0,0,,...kaçını hallederseniz halledin,\Nhiçbir şey değişmeyecek!
Dialogue: 0,0:07:03.06,0:07:06.86,Flashbacks,,0,0,0,,Enies Lobby, hükümetin adalet adası.
Dialogue: 0,0:07:06.86,0:07:12.37,Flashbacks,,0,0,0,,Oradan dönen hiçbir suçlu olmadı!
Dialogue: 0,0:07:14.87,0:07:16.79,Flashbacks,,0,0,0,,Aptal mı bu?
Dialogue: 0,0:07:16.79,0:07:17.75,Flashbacks,,0,0,0,,Ne yapalım?
Dialogue: 0,0:07:18.70,0:07:20.33,Flashbacks,,0,0,0,,Sen de mi aptalsın?!
Dialogue: 0,0:07:20.33,0:07:25.13,Flashbacks,,0,0,0,,İstediği gibi ölmesine izin vereceğiz!\NFarketmeyecek!
Dialogue: 0,0:07:25.13,0:07:26.30,Flashbacks,,0,0,0,,Emredersiniz.
Dialogue: 0,0:07:28.92,0:07:31.30,Flashbacks,,0,0,0,,Dur, Üfleyen Tom.
Dialogue: 0,0:07:33.76,0:07:38.27,Flashbacks,,0,0,0,,Yapımcını nereye götürdüğünü sanıyorsun?!
Dialogue: 0,0:07:47.94,0:07:50.24,Flashbacks,,0,0,0,,Vırak, vırak!
Dialogue: 0,0:07:52.45,0:07:54.28,Flashbacks,,0,0,0,,Gitmene izin vermeyeceğim.
Dialogue: 0,0:07:59.33,0:08:01.83,Flashbacks,,0,0,0,,Tom-san'ı geri ver!
Dialogue: 0,0:08:05.00,0:08:08.13,Main,,0,0,0,,Ne olursa olsun Tom-san'ı kurtarmak istemiştim.
Dialogue: 0,0:08:08.75,0:08:11.80,Main,,0,0,0,,Enies Lobby'nin delinmezliğinin\Nhikayesini bilenler,...
Dialogue: 0,0:08:12.55,0:08:15.64,Main,,0,0,0,,...Dünya Hükümeti'nin büyüklüğünü bilenler,...
Dialogue: 0,0:08:17.14,0:08:21.68,Main,,0,0,0,,...Hasır Şapkalar, tüm bunları görmezden\Ngeldiler ve ilerlemeye devam ettiler.
Dialogue: 0,0:08:28.86,0:08:34.24,Main,,0,0,0,,Tek bir arkadaşlarını kurtarmak için,\Ntereddüt etmeden Dünya Hükümeti'yle yüzleştiler.
Dialogue: 0,0:08:35.16,0:08:37.45,Main,,0,0,0,,İnanılmaz.
Dialogue: 0,0:08:41.37,0:08:45.33,Main,,0,0,0,,Bu gün bile Tom-san'ın ölümünü asla unutmadım.
Dialogue: 0,0:08:46.46,0:08:48.46,Main,,0,0,0,,O ajanın aptal suratını...
Dialogue: 0,0:08:49.75,0:08:51.42,Main,,0,0,0,,...tamamen...
Dialogue: 0,0:08:53.97,0:08:55.63,Main,,0,0,0,,...mahvolana dek...
Dialogue: 0,0:08:55.63,0:08:58.64,Main,,0,0,0,,Hey, dur, aptal! Yapma! Hey!
Dialogue: 0,0:08:59.10,0:09:02.35,Main,,0,0,0,,...ezmek istedim!
Dialogue: 0,0:09:19.42,0:09:20.66,Main,,0,0,0,,Aynen böyle.
Dialogue: 0,0:09:21.79,0:09:25.08,Main,,0,0,0,,Onlar sayesinde nihayet bu fırsatı buldum.
Dialogue: 0,0:09:30.25,0:09:32.88,Main,,0,0,0,,{\fad(150,150)}Sol Silahlar!
Dialogue: 0,0:09:35.88,0:09:38.51,Main,,0,0,0,,Daha önce bir kez öldüm!
Dialogue: 0,0:09:38.51,0:09:43.35,Main,,0,0,0,,Hasır Şapkalar'ın buradan canlı ayrılmasını sağlayacaksa, bana ne olduğu umrumda değil!
Dialogue: 0,0:09:52.78,0:09:55.36,Main,,0,0,0,,Gemiyi hazırlayın!
Dialogue: 0,0:09:55.36,0:09:57.49,Main,,0,0,0,,Onlara bir kaçış yolu açıyorum!
Dialogue: 0,0:10:09.75,0:10:12.25,Main,,0,0,0,,Ben de yardım edeceğim. Artık iyiyim.
Dialogue: 0,0:10:20.68,0:10:22.81,Flashbacks,,0,0,0,,Tüm gücünle koş!
Dialogue: 0,0:10:22.81,0:10:27.73,Flashbacks,,0,0,0,,Adada kalırsan öleceksin!\NSalımla denize açıl!
Dialogue: 0,0:10:27.73,0:10:28.44,Flashbacks,,0,0,0,,Ya sen, Saul?
Dialogue: 0,0:10:28.94,0:10:32.86,Flashbacks,,0,0,0,,Benim için her şey bitti. Yakalandım.
Dialogue: 0,0:10:33.69,0:10:34.28,Flashbacks,,0,0,0,,Git!
Dialogue: 0,0:10:34.65,0:10:37.05,Flashbacks,,0,0,0,,Hayır!\NDenizde hiç kimseyi tanımıyorum!
Dialogue: 0,0:10:37.05,0:10:40.82,Main,,0,0,0,,Bu Ohara'dakinden farklı.
Dialogue: 0,0:10:40.82,0:10:42.83,Main,,0,0,0,,Korkacak bir şeyim yok.
Dialogue: 0,0:10:42.83,0:10:47.79,Main,,0,0,0,,Artık yalnız değilim!
Dialogue: 0,0:10:56.09,0:10:58.26,Main,,0,0,0,,B-Beni buldu.
Dialogue: 0,0:10:59.43,0:11:02.30,Main,,0,0,0,,Böyle dengesiz bir teknik.
Dialogue: 0,0:11:02.30,0:11:04.39,Main,,0,0,0,,O vuruşları yemeyi istiyor olmalısın.
Dialogue: 0,0:11:04.39,0:11:07.73,Main,,0,0,0,,Bu güç için ödediğin bedel bu.
Dialogue: 0,0:11:07.73,0:11:10.60,Main,,0,0,0,,{\fad(150,150)}Hayatın Dönüşü: Kağıt Sanatı Dövüşçü Şekli!
Dialogue: 0,0:11:17.23,0:11:18.07,Main,,0,0,0,,{\fad(150,150)}Parmak Tabanca!
Dialogue: 0,0:11:27.24,0:11:30.96,Main,,0,0,0,,Bu ahmakça saldırılara devam edersen-
Dialogue: 0,0:11:40.34,0:11:43.30,Main,,0,0,0,,S-Sıkıştım!
Dialogue: 0,0:11:43.30,0:11:44.72,Main,,0,0,0,,Eyvah!
Dialogue: 0,0:11:46.26,0:11:52.69,Main,,0,0,0,,Çok yazık. Şimdi bu aptal şekildeyken\Ngeber, Hasır Şapka!
Dialogue: 0,0:11:53.77,0:11:56.23,Main,,0,0,0,,{\fad(150,150)}Parmak Tabanca: Noktalar!
Dialogue: 0,0:11:57.32,0:12:01.61,Main,,0,0,0,,Normale dön, vücut! Çabuk!\NÖldürüleceğim!
Dialogue: 0,0:12:15.04,0:12:17.67,Thoughts,,0,0,0,,Deminki saldırı bacaklarıma mı zarar verdi?
Dialogue: 0,0:12:19.21,0:12:20.83,Main,,0,0,0,,Dönüyor, dönüyor!
Dialogue: 0,0:12:33.23,0:12:35.23,Main,,0,0,0,,Gördün mü? Seni...
Dialogue: 0,0:12:35.23,0:12:38.19,Main,,0,0,0,,...gerçekten yaraladı!
Dialogue: 0,0:12:52.54,0:12:54.71,Thoughts,,0,0,0,,Gerçekten yapılabilecek bir şey yok mu?
Dialogue: 0,0:12:57.67,0:13:02.21,Thoughts,,0,0,0,,Bir şey yapmazsam, herkes boğulacak!
Dialogue: 0,0:13:02.21,0:13:05.18,Thoughts,,0,0,0,,Robin-chan'ı daha yeni kurtarmıştık!
Dialogue: 0,0:13:06.05,0:13:10.39,Thoughts,,0,0,0,,Her şey bitti mi gerçekten? Hayatım...
Dialogue: 0,0:13:10.89,0:13:13.70,Thoughts,,0,0,0,,...eğlenceliydi ama...
Dialogue: 0,0:13:13.70,0:13:16.40,Thoughts,,0,0,0,,Hey! Ölmeye hazır değilim!
Dialogue: 0,0:13:16.40,0:13:21.45,Thoughts,,0,0,0,,Denizin Cesur Savaşçısı Usopp-sama'nın son\Nanlarının, boğularak olmasına izin vermeyeceğim!
Dialogue: 0,0:13:23.53,0:13:25.61,Thoughts,,0,0,0,,Nefes alamıyorum.
Dialogue: 0,0:13:27.91,0:13:31.16,Thoughts,,0,0,0,,Acıtıyor. Görüşüm bulanıyor.
Dialogue: 0,0:13:31.95,0:13:33.04,Thoughts,,0,0,0,,Yardım edin!
Dialogue: 0,0:13:34.20,0:13:39.04,Main,,0,0,0,,Sorun yok. Dayanın.\NÖlmenize izin vermeyeceğim.
Dialogue: 0,0:13:41.92,0:13:43.92,Thoughts,,0,0,0,,Ne?\NNeler oluyor?
Dialogue: 0,0:13:44.59,0:13:46.59,Thoughts,,0,0,0,,Bir şey beni yakaladı!
Dialogue: 0,0:13:59.52,0:14:01.48,Thoughts,,0,0,0,,Hayal mi görüyorum?
Dialogue: 0,0:14:02.19,0:14:03.44,Thoughts,,0,0,0,,Öyle olmalı.
Dialogue: 0,0:14:05.28,0:14:08.53,Thoughts,,0,0,0,,Denizciler bilinçlerini yitirirken,...
Dialogue: 0,0:14:09.45,0:14:12.41,Thoughts,,0,0,0,,...zarif bir kuyruk yüzgeci gördüklerini söylerler.
Dialogue: 0,0:14:14.29,0:14:18.42,Thoughts,,0,0,0,,Yukarı bakarken uzun, akıcı bir saç görürler.
Dialogue: 0,0:14:19.79,0:14:21.88,Thoughts,,0,0,0,,Böyle hayal gibi...
Dialogue: 0,0:14:22.54,0:14:26.72,Thoughts,,0,0,0,,...güzel bir şekil. Denizkızı efsaneleri.
Dialogue: 0,0:14:30.22,0:14:33.31,Thoughts,,0,0,0,,Bu bir hayalse, ben uyanmak...
Dialogue: 0,0:14:35.27,0:14:36.14,Thoughts,,0,0,0,,...istemi-
Dialogue: 0,0:14:36.51,0:14:41.48,Main,,0,0,0,,Çok hızlı gideceğiz! Sakın ölmeyin!
Dialogue: 0,0:14:41.86,0:14:42.90,Thoughts,,0,0,0,,Du...
Dialogue: 0,0:14:44.53,0:14:46.82,Flashbacks,,0,0,0,,– Du...\N– Du...
Dialogue: 0,0:14:46.82,0:14:49.41,Thoughts,,0,0,0,,Du... Dugon*?!
Dialogue: 0,0:15:09.84,0:15:15.35,Main,,0,0,0,,Üzgünüm çocuklar! Bu gemiyi alıyoruz.
Dialogue: 0,0:15:20.23,0:15:25.27,Main,,0,0,0,,Eski konvoy gemisi, artık bir kaçış gemisi.
Dialogue: 0,0:15:25.27,0:15:26.78,Main,,0,0,0,,Evet.
Dialogue: 0,0:15:26.78,0:15:29.57,Main,,0,0,0,,Şimdi sadece Hasır Şapkalar'ı bekliyoruz.
Dialogue: 0,0:15:41.71,0:15:42.67,Main,,0,0,0,,Ne?
Dialogue: 0,0:15:43.63,0:15:46.34,Main,,0,0,0,,Sakın...
Dialogue: 0,0:15:47.55,0:15:50.76,Main,,0,0,0,,...ölmeyin!
Dialogue: 0,0:16:05.98,0:16:07.73,Main,,0,0,0,,Acele edin!
Dialogue: 0,0:16:09.28,0:16:13.03,Main,,0,0,0,,Enies Lobby'nin çıkışı az ileride!
Dialogue: 0,0:16:13.03,0:16:14.62,Main,,0,0,0,,Biraz daha!
Dialogue: 0,0:16:14.62,0:16:15.99,Main,,0,0,0,,Elinizden geleni yapın, devler!
Dialogue: 0,0:16:16.45,0:16:18.29,Main,,0,0,0,,Devam edin!
Dialogue: 0,0:16:20.41,0:16:22.21,Main,,0,0,0,,Adadan ayrılabiliriz!
Dialogue: 0,0:16:22.21,0:16:23.46,Main,,0,0,0,,Neredeyse vardık!
Dialogue: 0,0:16:29.25,0:16:30.84,Main,,0,0,0,,Başardık!
Dialogue: 0,0:16:30.84,0:16:33.80,Main,,0,0,0,,Devlerin gücü nasılmış bakalım?
Dialogue: 0,0:16:44.44,0:16:45.77,Main,,0,0,0,,Olamaz!
Dialogue: 0,0:16:47.11,0:16:48.90,Main,,0,0,0,,Üç savaş gemisi!
Dialogue: 0,0:16:48.90,0:16:50.78,Main,,0,0,0,,Bizi bekliyorlarmış!
Dialogue: 0,0:16:50.78,0:16:52.78,Main,,0,0,0,,Bakın! Gerçekten geldiler!
Dialogue: 0,0:16:52.78,0:16:55.45,Main,,0,0,0,,Ama onları Adalet Binası'nda\Nbağlı olarak bırakmıştık!
Dialogue: 0,0:16:55.91,0:16:57.12,Main,,0,0,0,,Nasıl?
Dialogue: 0,0:16:58.16,0:16:59.49,Main,,0,0,0,,Koramiral!
Dialogue: 0,0:16:59.49,0:17:00.37,Main,,0,0,0,,Evet...
Dialogue: 0,0:17:01.12,0:17:03.16,Main,,0,0,0,,– ...nişan alın.\N– Emredersiniz!
Dialogue: 0,0:17:03.16,0:17:05.04,Main,,0,0,0,,Birliğinizle birlikte Denizci şifrenizi verin...
Dialogue: 0,0:17:05.04,0:17:08.71,Main,,0,0,0,,...ve kimliğinizi gösterin. \NSonra da gemiye binin.
Dialogue: 0,0:17:08.71,0:17:10.25,Main,,0,0,0,,Tamam, devam et.
Dialogue: 0,0:17:10.25,0:17:13.67,Main,,0,0,0,,Hele şükür, \Nadayla birlikte gideceğimizi sanmıştım.
Dialogue: 0,0:17:26.56,0:17:29.19,Main,,0,0,0,,Direnmek faydasız, korsanlar.
Dialogue: 0,0:17:29.19,0:17:32.40,Main,,0,0,0,,Tek bir hareket yaparsanız, ateş açılacak.
Dialogue: 0,0:17:32.82,0:17:34.36,Main,,0,0,0,,Durum kötü!
Dialogue: 0,0:17:34.36,0:17:37.82,Main,,0,0,0,,Geçmemize izin vereceklerini sanmıyorum!
Dialogue: 0,0:17:37.82,0:17:40.28,Main,,0,0,0,,Arkamızda yanmakta olan ada var.
Dialogue: 0,0:17:40.28,0:17:41.95,Main,,0,0,0,,Kaçacak yer yok.
Dialogue: 0,0:17:41.95,0:17:44.91,Main,,0,0,0,,Önümüzdeyse sadece silahlar ve toplar var.
Dialogue: 0,0:17:46.83,0:17:49.92,Main,,0,0,0,,Şimdi ne düşünüyorsun, Paulie?
Dialogue: 0,0:17:51.34,0:17:52.84,Main,,0,0,0,,Geride kalan hayatıma bakıyorum.
Dialogue: 0,0:17:54.72,0:17:56.30,Main,,0,0,0,,Öyle konuşma.
Dialogue: 0,0:17:56.30,0:17:57.51,Main,,0,0,0,,Ve...
Dialogue: 0,0:17:57.51,0:17:58.55,Main,,0,0,0,,Ve?
Dialogue: 0,0:18:00.05,0:18:02.47,Main,,0,0,0,,...sonra ne olacağına bakıyorum.
Dialogue: 0,0:18:02.89,0:18:04.27,Main,,0,0,0,,Vırak!
Dialogue: 0,0:18:10.06,0:18:12.02,Main,,0,0,0,,Tüm denizciler ve ajanlar gemiye bindi.
Dialogue: 0,0:18:12.44,0:18:15.44,Main,,0,0,0,,Bütün gemiler ana kapıdan uzaklaşsın.
Dialogue: 0,0:18:16.19,0:18:18.45,Main,,0,0,0,,Ne yapıyorlar?
Dialogue: 0,0:18:28.92,0:18:35.05,Main,,0,0,0,,Altıncı, yedinci ve sekizinci gemi, ana\Nkapıda korsanlar olduğunu belirledi!
Dialogue: 0,0:18:39.13,0:18:42.22,Main,,0,0,0,,Hey, çocuklar! Uyanın!
Dialogue: 0,0:18:42.22,0:18:43.43,Main,,0,0,0,,Hey!
Dialogue: 0,0:18:56.23,0:18:58.49,Main,,0,0,0,,Bu bir mucize olmalı.
Dialogue: 0,0:18:58.86,0:19:04.58,Main,,0,0,0,,Bir türlü inanamıyorum.\NGerçek bir şok yaşamış olmalılar.
Dialogue: 0,0:19:05.20,0:19:10.25,Main,,0,0,0,,Görünüşe göre nefes almayı bırakmış\Nolmalılar, yani fazla su yutmamışlar.
Dialogue: 0,0:19:11.21,0:19:13.29,Main,,0,0,0,,Hele şükür. Acaba...
Dialogue: 0,0:19:15.55,0:19:20.01,Main,,0,0,0,,...onları bu kadar şok eden ne?
Dialogue: 0,0:19:20.68,0:19:22.14,Main,,0,0,0,,Sensin.
Dialogue: 0,0:19:27.64,0:19:32.23,Main,,0,0,0,,Korsanlar kralı çocuğun kurtarmaya geldiği arkadaş.
Dialogue: 0,0:19:33.52,0:19:35.72,Main,,0,0,0,,Vardiya istasyonunda karşılaşmıştık, değil mi?
Dialogue: 0,0:19:35.75,0:19:36.85,Main,,0,0,0,,Seni hatırlıyorum.
Dialogue: 0,0:19:38.78,0:19:40.99,Main,,0,0,0,,O zaman...
Dialogue: 0,0:19:41.78,0:19:46.08,Main,,0,0,0,,...böyle bir şey yapacağınızı hiç düşünmemiştim.
Dialogue: 0,0:19:46.08,0:19:49.75,Main,,0,0,0,,Hemen üstüne elbise giy, aptal kocakarı!
Dialogue: 0,0:19:49.75,0:19:53.75,Main,,0,0,0,,Korsanlar Kralı olacağını söyleyince gülmüştüm.
Dialogue: 0,0:19:53.88,0:19:55.96,Flashbacks,,0,0,0,,Arkadaşlarımız bekliyor!
Dialogue: 0,0:19:55.96,0:19:58.13,Flashbacks,,0,0,0,,Yoldan çekilin!
Dialogue: 0,0:19:58.51,0:20:01.88,Main,,0,0,0,,Ama gerçekten olabilirmiş gibi görünüyor.
Dialogue: 0,0:20:13.56,0:20:15.19,Main,,0,0,0,,Nami-san iyi mi?
Dialogue: 0,0:20:15.19,0:20:18.23,Main,,0,0,0,,Her zamanki gibi neşelisiniz.
Dialogue: 0,0:20:18.90,0:20:20.57,Main,,0,0,0,,Hayatta olduğunuza sevindim.
Dialogue: 0,0:20:22.45,0:20:27.87,Main,,0,0,0,,Ahhh! Doğruymuş!\NDenizkızları gerçekten yok!
Dialogue: 0,0:20:28.29,0:20:30.25,Main,,0,0,0,,Demek doğruymuş!
Dialogue: 0,0:20:30.27,0:20:32.65,Main,,0,0,0,,"Denizkızı gördüğünü sanırsan,\No aslında bir dugondur!"
Dialogue: 0,0:20:33.42,0:20:36.71,Main,,0,0,0,,Aptallar!\NHenüz denizkızı olduğunu söylemedi!
Dialogue: 0,0:20:36.71,0:20:37.96,Main,,0,0,0,,Hayalimi mahvetmeyin!
Dialogue: 0,0:20:37.96,0:20:41.10,Main,,0,0,0,,Ben bir buzbalığı denizkızıyım.
Dialogue: 0,0:20:41.10,0:20:43.84,Main,,0,0,0,,Kes şunu, yapma!
Dialogue: 0,0:20:43.84,0:20:48.35,Main,,0,0,0,,Ama daha önce hiç ayağı olan\Nbir denizkızı duymamıştım.
Dialogue: 0,0:20:50.52,0:20:52.43,Main,,0,0,0,,Ben de itiraz ediyorum!
Dialogue: 0,0:20:54.90,0:20:57.02,Main,,0,0,0,,Denizkızları...
Dialogue: 0,0:20:57.02,0:21:01.18,Main,,0,0,0,,Denizkızları 30 yaşına geldiklerinde,...
Dialogue: 0,0:21:01.18,0:21:06.28,Main,,0,0,0,,...kuyrukları ikiye ayrılır.\NBöylece karada yaşayabilirler.
Dialogue: 0,0:21:06.78,0:21:09.03,Main,,0,0,0,,Bir gün Balıkadam Adası'na\Ngiderseniz, anlayacaksınız.
Dialogue: 0,0:21:09.03,0:21:11.75,Main,,0,0,0,,Ha? İkiye mi? Anlıyorum,...
Dialogue: 0,0:21:11.75,0:21:15.79,Main,,0,0,0,,...aynı 100 yıl yaşadıktan\Nsonra kuyrukları ikiye ayrılan kediler gibi.
Dialogue: 0,0:21:16.29,0:21:17.92,Main,,0,0,0,,Ah, Bake-Neko*?
Dialogue: 0,0:21:18.38,0:21:20.75,Main,,0,0,0,,Bizi onlarla karıştırmayın!
Dialogue: 0,0:21:21.25,0:21:25.01,Main,,0,0,0,,Minnettarlığınız nerede?!
Dialogue: 0,0:21:25.93,0:21:29.18,Main,,0,0,0,,Çok teşekkür ederiz, Kokoro-san.
Dialogue: 0,0:21:30.56,0:21:31.97,Main,,0,0,0,,Lafı bile olmaz!
Dialogue: 0,0:21:50.24,0:21:56.12,Main,,0,0,0,,Robin-{\i1}chwaaan!
Dialogue: 0,0:21:56.54,0:21:59.00,Main,,0,0,0,,Ha? Neredeyim ben?
Dialogue: 0,0:22:00.54,0:22:02.75,Main,,0,0,0,,Robin!
Dialogue: 0,0:22:02.75,0:22:06.55,Main,,0,0,0,,Zamanında başardığımıza çok sevindim, Robin!\Nİyisin, değil mi?
Dialogue: 0,0:22:07.01,0:22:08.34,Main,,0,0,0,,Robin!
Dialogue: 0,0:22:08.34,0:22:11.14,Main,,0,0,0,,Evet. Sizin sayenizde.
Dialogue: 0,0:22:11.76,0:22:12.56,Main,,0,0,0,,Sağolun.
Dialogue: 0,0:22:14.02,0:22:16.35,Main,,0,0,0,,Hiç önemli değil!
Dialogue: 0,0:22:19.86,0:22:24.07,Main,,0,0,0,,Nine, müthişsin! Denizkızı mıydın?
Dialogue: 0,0:22:25.24,0:22:29.28,Main,,0,0,0,,Her zaman yüzgecinin ve pullarının\Nolmasının tuhaf olduğunu düşünmüştüm!
Dialogue: 0,0:22:29.28,0:22:30.57,Main,,0,0,0,,Bunu anlamalıydın!
Dialogue: 0,0:22:32.70,0:22:33.79,Main,,0,0,0,,Chopper?!
Dialogue: 0,0:22:34.24,0:22:35.04,Main,,0,0,0,,İyi misin?
Dialogue: 0,0:22:35.75,0:22:36.71,Main,,0,0,0,,Şey...
Dialogue: 0,0:22:38.04,0:22:40.88,Main,,0,0,0,,Hareket edemiyorum.
Dialogue: 0,0:22:40.88,0:22:45.42,Main,,0,0,0,,Elbette. Olanları sonra açıklarım.
Dialogue: 0,0:22:49.51,0:22:50.39,Main,,0,0,0,,Zoro!
Dialogue: 0,0:23:08.78,0:23:11.16,Main,,0,0,0,,Zoro! Yani, Zoro-kun!
Dialogue: 0,0:23:14.03,0:23:14.99,Main,,0,0,0,,Hey, şuna bakın.
Dialogue: 0,0:23:23.00,0:23:26.00,Main,,0,0,0,,Daha önce üzerinde olduğumuz adayla\Naynı ada olduğuna inanmak güç.
Dialogue: 0,0:23:28.55,0:23:32.64,Main,,0,0,0,,Bu saldırılar da ne böyle?\NSanki bir ateş denizi gibi!
Dialogue: 0,0:23:37.02,0:23:42.15,Main,,0,0,0,,Görünüşe göre Nico Robin hayatta\Nkalacak şekilde saldırmaları emredilmiş.
Dialogue: 0,0:23:43.27,0:23:46.40,Main,,0,0,0,,Bu yüzden mi köprüye ateş etmiyorlar?
Dialogue: 0,0:23:49.03,0:23:52.03,Main,,0,0,0,,Onu hayatta tutmaya çalışıyorlarsa,\Nonun için geri gelecekler demektir.
Dialogue: 0,0:23:52.66,0:23:55.74,Main,,0,0,0,,Enies Lobby tamamiyle yok olduktan sonra,...
Dialogue: 0,0:23:55.74,0:23:59.75,Main,,0,0,0,,...muhtemelen Nico Robin'i geri\Nalmak için dövüşmeye gelecekler.
Dialogue: 0,0:23:59.75,0:24:03.08,Main,,0,0,0,,Durum kötü! Zaten mahvolduk...
Dialogue: 0,0:24:03.08,0:24:05.67,Main,,0,0,0,,...ve o gemilerde\Nher türlü güçlü adam vardır.
Dialogue: 0,0:24:06.34,0:24:08.13,Main,,0,0,0,,Luffy nerede?
Dialogue: 0,0:24:08.13,0:24:13.43,Main,,0,0,0,,Galiba şu ilk kulede dövüşüyor.
Dialogue: 0,0:24:22.89,0:24:26.31,Main,,0,0,0,,Muhtemelen güvercinli pislik\NRob Lucci'yle dövüşüyor.
Dialogue: 0,0:24:26.90,0:24:28.98,Main,,0,0,0,,Pek uzak değil, yardıma gidebiliriz.
Dialogue: 0,0:24:28.98,0:24:30.11,Main,,0,0,0,,Gitme.
Dialogue: 0,0:24:31.19,0:24:33.53,Main,,0,0,0,,Güvercinli adam normal biri değil.
Dialogue: 0,0:24:34.16,0:24:38.99,Main,,0,0,0,,O karmaşaya yakalanırsan,\Nne olacağını Allah bilir.
Dialogue: 0,0:24:45.04,0:24:48.09,Main,,0,0,0,,Savaş gemisi filosunun ne zaman\Nburaya geleceğini bilmiyoruz.
Dialogue: 0,0:24:48.67,0:24:51.17,Main,,0,0,0,,Buradan çıkış yolumuzu yitirmek istemeyiz.
Dialogue: 0,0:24:51.59,0:24:54.01,Main,,0,0,0,,Bu yüzden Luffy'yi burada bekleyeceğiz.
Dialogue: 0,0:24:54.55,0:24:55.76,Main,,0,0,0,,Hepsi bu.
Dialogue: 0,0:25:08.02,0:25:09.57,Main,,0,0,0,,Fırtına şimdi başlıyor.
Dialogue: 0,0:25:11.19,0:25:12.11,Main,,0,0,0,,Anladım.
Dialogue: 0,0:25:24.37,0:25:27.92,Main,,0,0,0,,Franky.\NArkadaşların iyi mi?
Dialogue: 0,0:25:31.13,0:25:34.63,Main,,0,0,0,,Aptal! Onlar ne olursa olsun iyidir!
Dialogue: 0,0:25:34.63,0:25:36.89,Main,,0,0,0,,Bir şey olmaz, kaçıyorlar!
Dialogue: 0,0:25:41.43,0:25:43.48,Main,,0,0,0,,Hey, Paulie! Geri dön!
Dialogue: 0,0:25:48.19,0:25:50.57,Main,,0,0,0,,Ne yapıyorsun, bırak Den Den Mushi'yi!
Dialogue: 0,0:25:51.36,0:25:53.69,Main,,0,0,0,,Hasır Şapkalar'ın nasıl olduğunu bilmeliyiz!
Dialogue: 0,0:25:56.15,0:25:59.37,Main,,0,0,0,,Lanet olsun! Ateş ediyorlar!
Dialogue: 0,0:25:59.37,0:26:01.45,Main,,0,0,0,,Ağabey!
Dialogue: 0,0:26:30.36,0:26:32.02,Main,,0,0,0,,Artık bitti.
Dialogue: 0,0:26:33.15,0:26:36.03,Main,,0,0,0,,Seni yenene kadar durmayacağım.
Dialogue: 0,0:26:36.53,0:26:38.91,Main,,0,0,0,,Kendini öldürmek niyetinde misin?
Dialogue: 0,0:26:39.41,0:26:41.57,Main,,0,0,0,,Ne olacağını bilmiyorum.
Dialogue: 0,0:26:47.37,0:26:49.33,Main,,0,0,0,,İkinci Düzen!
Dialogue: 0,0:26:49.33,0:26:52.42,Credits,,0,0,0,,Editing:\N Galaxy 9000\N\NTiming:\NPhosCity\N\NQuality Control:\Ndanpmss,\NItsKipz,\NGalaxy 9000,\NPepperjack\N\NSoundtracking:\N Halee\N\NGraphics:\N Datenshi\N\NKaraoke:\NKaitouYahiko\N\NTranslation:\NCrunchyroll,\NGaijin
Dialogue: 0,0:00:00.71,0:00:03.37,Lyrics,,0,0,0,,{\fad(0,0)}♪ Koşmaya başlayalım, koşmaya başlayalım! ♪
Dialogue: 0,0:00:03.59,0:00:06.46,Lyrics,,0,0,0,,♪ Bayrağımızı süsleyip, gökyüzüne kaldırarak. ♪
Dialogue: 0,0:00:12.77,0:00:18.06,Lyrics,,0,0,0,,♪ Sonsuz okyanusu geçip aramaya gidelim. ♪
Dialogue: 0,0:00:18.86,0:00:21.81,Lyrics,,0,0,0,,♪ Henüz kimse tarafından...
Dialogue: 0,0:00:21.90,0:00:23.94,Lyrics,,0,0,0,,...bulunmamış bu dünyanın mucizesini. ♪
Dialogue: 0,0:00:24.82,0:00:27.96,Lyrics,,0,0,0,,♪ Çarpıp duran göğsümüzdeki...
Dialogue: 0,0:00:27.96,0:00:29.71,Lyrics,,0,0,0,,...aynı hislerle devam etmeliyiz. ♪
Dialogue: 0,0:00:29.71,0:00:35.59,Lyrics,,0,0,0,,♪ Hayaller peşinde koşanlar tarafından bırakılmış ayak izleri. ♪
Dialogue: 0,0:00:36.42,0:00:39.39,Lyrics,,0,0,0,,♪ Ne tür bir fırtınalı gece olursa olsun,...
Dialogue: 0,0:00:39.39,0:00:42.39,Lyrics,,0,0,0,,...kalplerimizin bir olmasını sağlarsak...
Dialogue: 0,0:00:42.39,0:00:46.54,Lyrics,,0,0,0,,{\fad(0,0)}...bu zorluğun üstesinden gelebileceğiz! ♪
Dialogue: 0,0:00:46.68,0:00:47.86,Lyrics,,0,0,0,,♪ Her zaman ♪
Dialogue: 0,0:00:48.76,0:00:51.59,Lyrics,,0,0,0,,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪
Dialogue: 0,0:00:51.72,0:00:54.55,Lyrics,,0,0,0,,{\fad(0,0)}♪ Bayrağımızı dalgalandırıp gökyüzüne kaldırarak. ♪
Dialogue: 0,0:00:54.60,0:00:57.14,Lyrics,,0,0,0,,♪ Kimseye göstermeyeceğiz. ♪
Dialogue: 0,0:00:57.23,0:01:00.58,Lyrics,,0,0,0,,{\fad(0,0)}♪ Gözlerimizde yaşlar olsa bile. ♪
Dialogue: 0,0:01:00.77,0:01:03.52,Lyrics,,0,0,0,,♪ Peşinden gidelim, peşinden gidelim! ♪
Dialogue: 0,0:01:03.69,0:01:06.52,Lyrics,,0,0,0,,♪ Hayallerimize giden doğru yolu...
Dialogue: 0,0:01:06.61,0:01:09.23,Lyrics,,0,0,0,,...gösteren pusulanın. ♪
Dialogue: 0,0:01:09.23,0:01:11.40,Lyrics,,0,0,0,,{\fad(0,0)}♪ Durmayacağız. ♪
Dialogue: 0,0:01:11.42,0:01:14.42,Lyrics,,0,0,0,,♪ Dünyayı dolaşarak...
Dialogue: 0,0:01:14.45,0:01:15.85,Lyrics,,0,0,0,,...yeniden başlayalım! ♪
Dialogue: 0,0:01:18.83,0:01:21.49,Lyrics,,0,0,0,,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪
Dialogue: 0,0:01:21.80,0:01:24.54,Lyrics,,0,0,0,,♪ Hedefimize doğru herkesten daha fazla. ♪
Dialogue: 0,0:01:24.63,0:01:27.12,Lyrics,,0,0,0,,♪ Şimdi kaçmazsak,...
Dialogue: 0,0:01:27.22,0:01:30.54,Lyrics,,0,0,0,,{\fad(0,0)}...yarını sıkı sıkıya kavrayabileceğiz! ♪
Dialogue: 0,0:01:30.60,0:01:33.63,Lyrics,,0,0,0,,♪ Peşinden gidelim, peşinden gidelim! ♪
Dialogue: 0,0:01:33.68,0:01:36.51,Lyrics,,0,0,0,,♪ Gözlerinden yansıtılmış tüm şimdiki zamanın. ♪
Dialogue: 0,0:01:36.56,0:01:38.93,Lyrics,,0,0,0,,♪ Bembeyaz bir kalp...
Dialogue: 0,0:01:39.15,0:01:41.43,Lyrics,,0,0,0,,...bana tüm hikayeyi anlatacak! ♪
Dialogue: 0,0:01:41.73,0:01:44.43,Lyrics,,0,0,0,,♪ Yepyeni bir dünyada...
Dialogue: 0,0:01:44.53,0:01:45.83,Lyrics,,0,0,0,,...yeniden başlayalım! ♪
