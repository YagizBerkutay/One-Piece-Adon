F,&H00000000,&H78000000,0,-1,0,0,100,100,0,0,1,1.5,1.5,2,120,120,18,1Style: Author,Impress BT,20,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.8,0.8,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:01:50.02,0:01:56.44,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:20:32.50,0:20:42.50,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:00:00.71,0:00:03.37,Lyrics,,0,0,0,,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪Dialogue: 0,0:00:03.59,0:00:06.46,Lyrics,,0,0,0,,♪ Bayrağımızı süsleyip, gökyüzüne kaldırarak. ♪Dialogue: 0,0:00:12.77,0:00:18.06,Lyrics,,0,0,0,,♪ Sonsuz okyanusu geçip aramaya gidelim. ♪Dialogue: 0,0:00:18.86,0:00:21.81,Lyrics,,0,0,0,,♪ Henüz kimse tarafından...Dialogue: 0,0:00:21.90,0:00:23.94,Lyrics,,0,0,0,,...bulunmamış bu dünyanın mucizesini. ♪Dialogue: 0,0:00:24.82,0:00:27.96,Lyrics,,0,0,0,,♪ Çarpıp duran göğsümüzdeki...Dialogue: 0,0:00:27.96,0:00:29.71,Lyrics,,0,0,0,,...aynı hislerle devam etmeliyiz. ♪Dialogue: 0,0:00:29.71,0:00:35.59,Lyrics,,0,0,0,,♪ Hayaller peşinde koşanlar tarafından bırakılmış ayak izleri. ♪Dialogue: 0,0:00:36.42,0:00:39.39,Lyrics,,0,0,0,,♪ Ne tür bir fırtınalı gece olursa olsun,...Dialogue: 0,0:00:39.39,0:00:42.39,Lyrics,,0,0,0,,...kalplerimizin bir olmasını sağlarsak...Dialogue: 0,0:00:42.39,0:00:46.54,Lyrics,,0,0,0,,...bu zorluğun üstesinden gelebileceğiz! ♪Dialogue: 0,0:00:46.68,0:00:47.86,Lyrics,,0,0,0,,♪ Her zaman ♪Dialogue: 0,0:00:48.76,0:00:51.59,Lyrics,,0,0,0,,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪Dialogue: 0,0:00:51.72,0:00:54.55,Lyrics,,0,0,0,,♪ Bayrağımızı dalgalandırıp gökyüzüne kaldırarak. ♪Dialogue: 0,0:00:54.60,0:00:57.14,Lyrics,,0,0,0,,♪ Kimseye göstermeyeceğiz. ♪Dialogue: 0,0:00:57.23,0:01:00.58,Lyrics,,0,0,0,,♪ Gözlerimizde yaşlar olsa bile. ♪Dialogue: 0,0:01:00.77,0:01:03.52,Lyrics,,0,0,0,,♪ Peşinden gidelim, peşinden gidelim! ♪Dialogue: 0,0:01:03.69,0:01:06.52,Lyrics,,0,0,0,,♪ Hayallerimize giden doğru yolu...Dialogue: 0,0:01:06.61,0:01:09.23,Lyrics,,0,0,0,,...gösteren pusulanın. ♪Dialogue: 0,0:01:09.23,0:01:11.40,Lyrics,,0,0,0,,♪ Durmayacağız. ♪Dialogue: 0,0:01:11.42,0:01:14.42,Lyrics,,0,0,0,,♪ Dünyayı dolaşarak...Dialogue: 0,0:01:14.45,0:01:15.85,Lyrics,,0,0,0,,...yeniden başlayalım! ♪Dialogue: 0,0:01:18.83,0:01:21.49,Lyrics,,0,0,0,,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪Dialogue: 0,0:01:21.80,0:01:24.54,Lyrics,,0,0,0,,♪ Hedefimize doğru herkesten daha fazla. ♪Dialogue: 0,0:01:24.63,0:01:27.12,Lyrics,,0,0,0,,♪ Şimdi kaçmazsak,...Dialogue: 0,0:01:27.22,0:01:30.54,Lyrics,,0,0,0,,...yarını sıkı sıkıya kavrayabileceğiz! ♪Dialogue: 0,0:01:30.60,0:01:33.63,Lyrics,,0,0,0,,♪ Peşinden gidelim, peşinden gidelim! ♪Dialogue: 0,0:01:33.68,0:01:36.51,Lyrics,,0,0,0,,♪ Gözlerinden yansıtılmış tüm şimdiki zamanın. ♪Dialogue: 0,0:01:36.56,0:01:38.93,Lyrics,,0,0,0,,♪ Bembeyaz bir kalp...Dialogue: 0,0:01:39.15,0:01:41.43,Lyrics,,0,0,0,,...bana tüm hikayeyi anlatacak! ♪Dialogue: 0,0:01:41.73,0:01:44.43,Lyrics,,0,0,0,,♪ Yepyeni bir dünyada...Dialogue: 0,0:01:44.53,0:01:45.83,Lyrics,,0,0,0,,...yeniden başlayalım! ♪Dialogue: 0,0:01:50.02,0:01:56.44,Title,,0,0,250,,Hayata Dönüş Dialogue: 0,0:02:09.85,0:02:13.68,Main,,0,0,0,,Sahi, Franky. Zamanımız varken açıklayayım.Dialogue: 0,0:02:13.68,0:02:14.69,Main,,0,0,0,,Ne?!Dialogue: 0,0:02:16.68,0:02:21.32,Main,,0,0,0,,Yani iki numaralı anahtar olmadan yapabileceğimiz bir şey yok mu?Dialogue: 0,0:02:21.32,0:02:23.24,Main,,0,0,0,,Evet. Doğru.Dialogue: 0,0:02:23.24,0:02:25.49,Main,,0,0,0,,Nasıl bu kadar aptal olabilirler?Dialogue: 0,0:02:25.49,0:02:28.46,Main,,0,0,0,,Neyse, şimdi durumu anlıyorum.Dialogue: 0,0:02:37.17,0:02:39.60,Main,,0,0,0,,Şimdi gerçekten kızdım!Dialogue: 0,0:02:42.85,0:02:46.47,Main,,0,0,0,,Sert biri, değil mi? Ayağa kalktı.Dialogue: 0,0:02:46.47,0:02:48.35,Main,,0,0,0,,Sadece otur ve izle.Dialogue: 0,0:02:49.15,0:02:52.80,Main,,0,0,0,,Franky...Dialogue: 0,0:02:55.02,0:02:57.18,Main,,0,0,0,,...Muhrip Topu!Dialogue: 0,0:02:58.18,0:03:02.00,Main,,0,0,0,,Ah! Bunu yaparken omuzlarımı çıkarmak zorunda olmaktan nefret ediyorum!Dialogue: 0,0:03:02.00,0:03:04.99,Main,,0,0,0,,Ne?! O zaman yapma!Dialogue: 0,0:03:06.00,0:03:06.99,Main,,0,0,0,,Aptal.Dialogue: 0,0:03:06.99,0:03:12.54,Main,,0,0,0,,Benim gibi bir Altı Stil kullanıcısını mermiler asla vuramaz!Dialogue: 0,0:03:12.54,0:03:15.04,Main,,0,0,0,,Ne kadar kaçarsan kaç,...Dialogue: 0,0:03:15.04,0:03:20.55,Main,,0,0,0,,...Franky Muhrip Topu'mdan kaçma şansın yok.Dialogue: 0,0:03:20.55,0:03:24.55,Main,,0,0,0,,Çünkü bu güdümlü top mermisi!Dialogue: 0,0:03:25.30,0:03:27.31,Thoughts,,0,0,0,,Güdümlü top mermisi?Dialogue: 0,0:03:27.31,0:03:31.81,Thoughts,,0,0,0,,Yoksa top mermisi düşmanı sezip  peşinden mi gidiyor?Dialogue: 0,0:03:42.82,0:03:45.32,Thoughts,,0,0,0,,Hiç öyle bir teknoloji duymamıştım!Dialogue: 0,0:03:45.32,0:03:47.28,Thoughts,,0,0,0,,Bu adam neyin nesi böyle?!Dialogue: 0,0:03:54.15,0:03:55.25,Main,,0,0,0,,Bekle!Dialogue: 0,0:03:55.25,0:03:57.67,Main,,0,0,0,,İzini sen mi sürüyorsun?!Dialogue: 0,0:03:57.67,0:04:00.13,Main,,0,0,0,,Bekle dedim!Dialogue: 0,0:04:03.22,0:04:05.80,Main,,0,0,0,,Ne yapıyorum ben? Lanet olası!Dialogue: 0,0:04:12.43,0:04:14.54,Main,,0,0,0,,Yine kayboldu.Dialogue: 0,0:04:17.84,0:04:18.98,Main,,0,0,0,,Neredesin?!Dialogue: 0,0:04:18.98,0:04:21.70,Main,,0,0,0,,Beni aramak faydasız.Dialogue: 0,0:04:21.70,0:04:25.36,Main,,0,0,0,,Ben Altı Stil kullanıcısıyım ve Kazı'da uzmanım.Dialogue: 0,0:04:25.36,0:04:28.37,Main,,0,0,0,,Işık hızından hızlı olmak bir yana,...Dialogue: 0,0:04:28.37,0:04:33.83,Main,,0,0,0,,...avına yaklaşan bir baykuş gibi sessizce hareket ederek...Dialogue: 0,0:04:33.83,0:04:37.58,Main,,0,0,0,,...mükemmel bir suikast gerçekleştiririm.Dialogue: 0,0:04:42.26,0:04:44.01,Main,,0,0,0,,Baykuş, ha?Dialogue: 0,0:04:44.01,0:04:50.06,Main,,0,0,0,,Hedef, öldürülmek üzere olduğu ana dek beni hiç görmez.Dialogue: 0,0:04:52.89,0:04:54.31,Main,,0,0,0,,Burada saklanıyordu!Dialogue: 0,0:04:56.27,0:05:00.07,Main,,0,0,0,,Görünüşe göre bu hiç beklenmedik bir durumdu.Dialogue: 0,0:05:00.07,0:05:01.82,Main,,0,0,0,,Ukala pislik.Dialogue: 0,0:05:01.82,0:05:04.72,Main,,0,0,0,,Daha önce hiç bu kadar küçük düşürülmemiştim!Dialogue: 0,0:05:04.72,0:05:07.07,Main,,0,0,0,,Ben CP9 üyesiyim!Dialogue: 0,0:05:08.53,0:05:09.67,Main,,0,0,0,,Kazı!Dialogue: 0,0:05:15.75,0:05:17.38,Main,,0,0,0,,Demir Parça Topu!Dialogue: 0,0:05:21.50,0:05:23.63,Main,,0,0,0,,Hey! Dikkat et!Dialogue: 0,0:05:25.05,0:05:27.09,Main,,0,0,0,,Kahretsin, altımızda okyanus var!Dialogue: 0,0:05:32.31,0:05:34.77,Main,,0,0,0,,Franky!Dialogue: 0,0:05:39.44,0:05:40.40,Main,,0,0,0,,Eyvah!Dialogue: 0,0:05:41.94,0:05:44.44,Main,,0,0,0,,Akıntıya kapılırsa,...Dialogue: 0,0:05:44.44,0:05:46.78,Main,,0,0,0,,...şelale havzasına gidecek!Dialogue: 0,0:05:47.28,0:05:49.78,Main,,0,0,0,,Okyanusta ona yardım da edemem.Dialogue: 0,0:05:50.87,0:05:54.70,Main,,0,0,0,,Franky! Başarabilirsin!Dialogue: 0,0:05:58.67,0:06:02.42,Main,,0,0,0,,Şelaleye düşsem bile, Ay Yürüyüşü'm var.Dialogue: 0,0:06:02.42,0:06:05.92,Main,,0,0,0,,Durum kötü. Duramıyorum!Dialogue: 0,0:06:05.92,0:06:09.26,Main,,0,0,0,,Çok güçlü bir akıntı. Nefesim fazla dayanmayacak.Dialogue: 0,0:06:09.26,0:06:11.56,Main,,0,0,0,,Akıntıya karşı gitmeliyim!Dialogue: 0,0:06:12.40,0:06:14.76,Main,,0,0,0,,Düşmeye devam et!Dialogue: 0,0:06:18.27,0:06:20.88,Main,,0,0,0,,O ses... Buzdolabının kapağını açmış olabilir mi?Dialogue: 0,0:06:23.00,0:06:29.22,Main,,0,0,0,,Yemek için şükürler olsun!Dialogue: 0,0:06:29.22,0:06:31.32,Main,,0,0,0,,Şişmanlamış!Dialogue: 0,0:06:32.32,0:06:35.79,Main,,0,0,0,,Ne kadar yedin öyle?!Dialogue: 0,0:06:46.26,0:06:48.96,Main,,0,0,0,,Böyle bir yerde ölmek istemiyorum!Dialogue: 0,0:06:49.72,0:06:52.93,Main,,0,0,0,,Çoktan havzaya gelmişim!Dialogue: 0,0:06:52.93,0:06:56.39,Main,,0,0,0,,Düşüyorum! Düşüyorum! Düşüyorum!Dialogue: 0,0:06:57.31,0:06:59.77,Main,,0,0,0,,Franky Kelebek!Dialogue: 0,0:07:04.57,0:07:06.69,Main,,0,0,0,,Bunu yapmana izin vermeyeceğim!Dialogue: 0,0:07:07.00,0:07:07.99,Main,,0,0,0,,Ay Yürüyüşü!Dialogue: 0,0:07:15.53,0:07:16.98,Main,,0,0,0,,Sert Hayvan! Dialogue: 0,0:07:22.42,0:07:24.13,Main,,0,0,0,,Seni pislik!Dialogue: 0,0:07:32.51,0:07:35.10,Main,,0,0,0,,Sol Silahlar!Dialogue: 0,0:07:35.30,0:07:36.22,Main,,0,0,0,,Kâğıt Sanatı!Dialogue: 0,0:07:39.34,0:07:40.23,Main,,0,0,0,,Slime!Dialogue: 0,0:07:43.06,0:07:46.02,Main,,0,0,0,,Kahretsin! O da neydi öyle?!Dialogue: 0,0:07:48.15,0:07:49.94,Main,,0,0,0,,Çok yakındı!Dialogue: 0,0:07:50.94,0:07:53.45,Thoughts,,0,0,0,,Kahretsin, bu gerçekten kötü.Dialogue: 0,0:07:53.45,0:07:55.12,Thoughts,,0,0,0,,Kıyıya çıkmalıyım.Dialogue: 0,0:07:55.12,0:08:00.08,Main,,0,0,0,,1.0 Kola Topu!  Osuruk Vuruşu!Dialogue: 0,0:08:04.69,0:08:06.29,Main,,0,0,0,,Şimdi anlıyor musun?Dialogue: 0,0:08:06.29,0:08:09.13,Main,,0,0,0,,Altı Stil'i sadece güçle yenemezsin.Dialogue: 0,0:08:09.55,0:08:11.10,Main,,0,0,0,,Güçlü Çekiç!Dialogue: 0,0:08:11.10,0:08:11.96,Main,,0,0,0,,Kağıt Sanatı.Dialogue: 0,0:08:15.76,0:08:18.68,Main,,0,0,0,,Şelaleye düş!Dialogue: 0,0:08:19.68,0:08:21.73,Main,,0,0,0,,Güçlü Sağ!Dialogue: 0,0:08:27.19,0:08:28.64,Main,,0,0,0,,Al bakalım!Dialogue: 0,0:08:43.79,0:08:45.67,Main,,0,0,0,,Bırak beni, lanet olası!Dialogue: 0,0:08:45.67,0:08:49.67,Main,,0,0,0,,Tek ayaklı Ay Yürüyüşü'yle ikimizi birden desteklemek çok zor!Dialogue: 0,0:08:51.09,0:08:53.01,Main,,0,0,0,,Düşeceğiz!Dialogue: 0,0:08:53.01,0:08:55.51,Main,,0,0,0,,Evet, sanırım öyle.Dialogue: 0,0:08:55.51,0:08:59.76,Main,,0,0,0,,O zaman düşmeden önce beni kıyıya götürebilirsin.Dialogue: 0,0:09:00.76,0:09:07.27,Main,,0,0,0,,Yoksa ikimizin de ağırlığını desteklerken benimle burada mı dövüşmek istersin?Dialogue: 0,0:09:07.27,0:09:09.19,Main,,0,0,0,,Bu işin nereye vardığını görebiliyorum.Dialogue: 0,0:09:09.19,0:09:12.19,Main,,0,0,0,,Ama bu, benim hayatımı da riske atardı.Dialogue: 0,0:09:13.19,0:09:18.16,Main,,0,0,0,,Şu anda aynı kaderle yüzleşiyoruz. Kıyıya geri dönelim.Dialogue: 0,0:09:21.98,0:09:24.08,Main,,0,0,0,,İyi, aynen böyle!Dialogue: 0,0:09:24.08,0:09:25.58,Main,,0,0,0,,İyi, iyi!Dialogue: 0,0:09:25.58,0:09:28.58,Main,,0,0,0,,Kıyıya birlikte dönelim.Dialogue: 0,0:09:29.85,0:09:33.69,Main,,0,0,0,,Ama yukarı çıktığımızda bu dövüş sona erecek.Dialogue: 0,0:09:33.69,0:09:36.09,Main,,0,0,0,,Oh? Öyle mi dersin?Dialogue: 0,0:09:38.09,0:09:45.06,Main,,0,0,0,,Çünkü şu anda tek vuruşla işini bitirmek için bir yol düşündüm!Dialogue: 0,0:09:45.66,0:09:49.48,Main,,0,0,0,,Oh, öyle mi? Ben de düşündüm, Fukurou-kun.Dialogue: 0,0:09:52.78,0:09:54.99,Main,,0,0,0,,Şimdi ne yapacaksın?Dialogue: 0,0:09:54.99,0:10:00.20,Main,,0,0,0,,Beni hemen kıyıya götür! Ondan sonra seni nakavt edebileceğim!Dialogue: 0,0:10:01.78,0:10:06.96,Main,,0,0,0,,İkinci kez söylemene gerek yok! Bir daha asla konuşmamanı sağlayacağım!Dialogue: 0,0:10:09.96,0:10:12.47,Main,,0,0,0,,Hızlı Dönen Demir Parça Topu!Dialogue: 0,0:10:12.47,0:10:15.63,Main,,0,0,0,,Bu güçle seni kulenin köşesine yapıştıracağım!Dialogue: 0,0:10:17.90,0:10:22.10,Main,,0,0,0,,Anlıyorum. Kesinlikle ezilecekmişim gibi görünüyor!Dialogue: 0,0:10:22.55,0:10:25.56,Main,,0,0,0,,Sentor Franky!Dialogue: 0,0:10:29.65,0:10:30.81,Main,,0,0,0,,Bacaklarının ikisini de bağladım.Dialogue: 0,0:10:30.81,0:10:34.32,Main,,0,0,0,,Böylece istediğin gibi hareket edemeyeceksin!Dialogue: 0,0:10:34.32,0:10:35.99,Main,,0,0,0,,Ne olmuş?Dialogue: 0,0:10:36.12,0:10:39.86,Main,,0,0,0,,Böyle yapsan bile bu gücü durdurabilmen mümkün değil!Dialogue: 0,0:10:39.86,0:10:41.87,Main,,0,0,0,,Gerek yok!Dialogue: 0,0:10:43.87,0:10:46.58,Main,,0,0,0,,70mm Kalibreli, 0.2 Kola Topu!Dialogue: 0,0:10:47.31,0:10:49.58,Main,,0,0,0,,Biraz Rüzgar Vuruşu!Dialogue: 0,0:10:50.79,0:10:53.24,Main,,0,0,0,,Gücü durdurdu!Dialogue: 0,0:10:53.24,0:10:57.11,Main,,0,0,0,,Dönüşü tamamiyle durdu! Kahretsin!Dialogue: 0,0:10:57.11,0:11:00.84,Main,,0,0,0,,Bu kadarı yeter! Artık kıyının üstündeyiz.Dialogue: 0,0:11:00.84,0:11:02.84,Main,,0,0,0,,Al bakalım!Dialogue: 0,0:11:02.84,0:11:06.75,Main,,0,0,0,,70mm Kalibreli, 1.5 Maksimum Kola Gücü!Dialogue: 0,0:11:06.75,0:11:08.11,Main,,0,0,0,,Rüzgar...Dialogue: 0,0:11:08.11,0:11:10.77,Main,,0,0,0,,Ne yapıyorsun, seni pislik?!Dialogue: 0,0:11:15.32,0:11:17.94,Main,,0,0,0,,Pes et artık!Dialogue: 0,0:11:17.94,0:11:19.07,Main,,0,0,0,,Rüzgar...Dialogue: 0,0:11:19.74,0:11:20.74,Main,,0,0,0,,...Vuruşu!Dialogue: 0,0:11:28.48,0:11:33.00,Main,,0,0,0,,SÜPER!Dialogue: 0,0:11:40.88,0:11:43.44,Main,,0,0,0,,2 numaralı anahtar henüz burada değil mi?Dialogue: 0,0:11:43.44,0:11:45.64,Main,,0,0,0,,Zoro-kun! Tükendim! Çok yoruldum!Dialogue: 0,0:11:45.64,0:11:47.10,Main,,0,0,0,,Beni sırtına bindir!Dialogue: 0,0:11:47.10,0:11:48.30,Main,,0,0,0,,Asla!Dialogue: 0,0:11:49.81,0:11:50.64,Main,,0,0,0,,Bacak Fırtınası!Dialogue: 0,0:11:58.23,0:11:59.69,Main,,0,0,0,,Parmak Tabanca!Dialogue: 0,0:11:59.69,0:12:01.11,Main,,0,0,0,,Ne yapıyorsun?Dialogue: 0,0:12:01.11,0:12:06.07,Main,,0,0,0,,Seni pislik! O saldırıyı yaptığında beni hedefliyordun, değil mi?!Dialogue: 0,0:12:06.07,0:12:09.08,Main,,0,0,0,,Yanlış bir suçlama. Ama dövüşmek istiyorsan, hazırım.Dialogue: 0,0:12:09.08,0:12:12.71,Main,,0,0,0,,Ben de yoluma çıkmandan rahatsız oluyordum.Dialogue: 0,0:12:12.71,0:12:16.67,Main,,0,0,0,,Ne dedin?! Bunu ben söyleyecektim, seni vejeteryan!Dialogue: 0,0:12:16.67,0:12:20.17,Main,,0,0,0,,Hayır, aslında eti seviyorum.Dialogue: 0,0:12:20.57,0:12:22.97,Main,,0,0,0,,Taş, kâğıt, makas oynayacağız, Sogeking.Dialogue: 0,0:12:22.97,0:12:25.77,Main,,0,0,0,,Bu şey sorun oluyor.Dialogue: 0,0:12:25.77,0:12:28.31,Main,,0,0,0,,Bu kelepçeyi çıkarmanın bir yolu var.Dialogue: 0,0:12:28.31,0:12:31.73,Main,,0,0,0,,Yenilen elini keser.Dialogue: 0,0:12:33.69,0:12:37.29,Main,,0,0,0,,Bu kadar korkunç bir şeyi ifadesiz bir suratla nasıl söyleyebilirsin?!Dialogue: 0,0:12:37.29,0:12:40.09,Main,,0,0,0,,Açıklamayı bitirmedim!Dialogue: 0,0:12:40.09,0:12:42.69,Main,,0,0,0,,Kelepçeden kurtulan kişi...Dialogue: 0,0:12:42.69,0:12:46.20,Main,,0,0,0,,...elini alacak ve hemen Chopper'a gidecek.Dialogue: 0,0:12:46.20,0:12:49.20,Main,,0,0,0,,Sonra da onu eski yerine diktirecek!Dialogue: 0,0:12:49.20,0:12:51.66,Main,,0,0,0,,Biz oyuncak değiliz! Aptallaşma!Dialogue: 0,0:12:56.43,0:12:58.43,Main,,0,0,0,,Bir fikrim daha var.Dialogue: 0,0:12:58.43,0:13:00.63,Main,,0,0,0,,Artık duymak istemiyorum!Dialogue: 0,0:13:02.99,0:13:05.18,Main,,0,0,0,,Tartışmaktan yoruldum.Dialogue: 0,0:13:05.18,0:13:10.64,Main,,0,0,0,,Sen hazır olduğunda hazırım. Kazanan avı kendine alır.Dialogue: 0,0:13:18.19,0:13:20.15,Main,,0,0,0,,– Hım? – O... Dialogue: 0,0:13:32.62,0:13:35.62,Main,,0,0,0,,Pekâla, Sogeking. Duruşunu bozma.Dialogue: 0,0:13:37.12,0:13:38.83,Main,,0,0,0,,Sen kılıçsın!Dialogue: 0,0:13:38.83,0:13:44.13,Main,,0,0,0,,Avukatımı çağırın! Seni kesinlikle dava edeceğim!Dialogue: 0,0:13:57.02,0:14:00.12,Main,,0,0,0,,Senin gibi kendi bedeniyle ilgilenmekten bu kadar aciz olan kimseyle karşılaşmamıştım.Dialogue: 0,0:14:00.12,0:14:02.72,Main,,0,0,0,,Dakikalar içinde nasıl şişmanlayabilirsin?Dialogue: 0,0:14:04.03,0:14:12.74,Main,,0,0,0,,Kalbim için endişelenmeye,  endi-endi-endi, endişelenmeye...Dialogue: 0,0:14:12.74,0:14:16.65,Main,,0,0,0,,Senin için endişelenmiyorum! Sadece normal konuş!Dialogue: 0,0:14:16.65,0:14:18.04,Main,,0,0,0,,Endişelenmeye gerek yok diyecektin, değil mi?Dialogue: 0,0:14:18.04,0:14:19.54,Main,,0,0,0,,Minnettarım!Dialogue: 0,0:14:19.54,0:14:24.05,Main,,0,0,0,,Aslında uzlaşabiliyorsun!Dialogue: 0,0:14:24.05,0:14:26.35,Main,,0,0,0,,Anladım, kes artık şunu!Dialogue: 0,0:14:26.35,0:14:28.55,Main,,0,0,0,,Endişelenmeme gerek yok, değil mi?Dialogue: 0,0:14:28.55,0:14:30.05,Main,,0,0,0,,Hey, geri gel!Dialogue: 0,0:14:30.05,0:14:34.06,Main,,0,0,0,,Evet, evet! Aynen öyle!Dialogue: 0,0:14:34.06,0:14:37.10,Main,,0,0,0,,Çünkü...Dialogue: 0,0:14:37.10,0:14:38.90,Main,,0,0,0,,...gördüğün gibi...Dialogue: 0,0:14:38.90,0:14:41.44,Main,,0,0,0,,Hayata Dönüş! Dialogue: 0,0:14:44.14,0:14:46.02,Thoughts,,0,0,0,,N-Ne?Dialogue: 0,0:14:46.03,0:14:47.53,Main,,0,0,0,,Sindir!Dialogue: 0,0:14:48.79,0:14:50.49,Main,,0,0,0,,İçine Çek!Dialogue: 0,0:14:50.49,0:14:52.49,Main,,0,0,0,,Normale Dön!Dialogue: 0,0:14:55.49,0:14:56.87,Main,,0,0,0,,Nesin sen böyle?!Dialogue: 0,0:14:56.87,0:14:58.37,Main,,0,0,0,,Ne yaptın öyle?Dialogue: 0,0:14:58.37,0:15:00.25,Main,,0,0,0,,Tekrar yapabilir misin?Dialogue: 0,0:15:00.25,0:15:02.75,Main,,0,0,0,,Hayata Dönüş!Dialogue: 0,0:15:02.75,0:15:04.54,Main,,0,0,0,,Sindir!Dialogue: 0,0:15:04.54,0:15:07.05,Main,,0,0,0,,İçine Çek!Dialogue: 0,0:15:10.05,0:15:13.18,Main,,0,0,0,,Müthişsin! Nasıl yapıyorsun?!Dialogue: 0,0:15:13.88,0:15:17.60,Main,,0,0,0,,Evet, sorduğun için sağol!Dialogue: 0,0:15:18.18,0:15:21.31,Main,,0,0,0,,Bin yıl denizde ve bin yıl dağlarda...Dialogue: 0,0:15:21.31,0:15:24.27,Main,,0,0,0,,...rüzgarı içime ççekerek ve temiz su içerek,...Dialogue: 0,0:15:24.27,0:15:27.23,Main,,0,0,0,,...usta eğitiminden geçtim.Dialogue: 0,0:15:27.23,0:15:33.74,Main,,0,0,0,,Tüm-tüm-tüm bunlara katlanarak Hayata Dönüş'ü elde ettim!Dialogue: 0,0:15:34.90,0:15:39.12,Main,,0,0,0,,İnsanlar; başlarındaki saçtan bağırsaklarına, ayak parmaklarına,...Dialogue: 0,0:15:39.12,0:15:45.13,Main,,0,0,0,,...hatta en önemsiz kılına kadar duyularını yoğunlaştırabilir ve onları uç sınırlarına kadar zorlayarak,...Dialogue: 0,0:15:45.13,0:15:50.22,Main,,0,0,0,,...vücudunun her parçasını kontrol etmeyi mümkün hale getirebilir.Dialogue: 0,0:15:51.02,0:15:54.08,Main,,0,0,0,,Duyularımızı saçımızın ucuna kadar iletmek mi?Dialogue: 0,0:15:54.39,0:15:57.60,Main,,0,0,0,,Sanırım bunu bir yerde okumuştum.Dialogue: 0,0:15:57.60,0:15:59.60,Main,,0,0,0,,Biyolojik Geribildirim denen bir şey.Dialogue: 0,0:16:00.52,0:16:04.94,Main,,0,0,0,,O zaman saçlarının ahtapot gibi hareket etmesi o güç yüzünden mi?Dialogue: 0,0:16:07.65,0:16:10.90,Main,,0,0,0,,Ahtapot mu dedin? Ne kabasın!Dialogue: 0,0:16:11.50,0:16:15.24,Main,,0,0,0,,Ben kesinlikle...Dialogue: 0,0:16:17.12,0:16:24.00,Main,,0,0,0,,...aslan, aslan dediğin şeyim!Dialogue: 0,0:16:24.00,0:16:26.50,Main,,0,0,0,,Hangisi olduğu farketmez, değil mi?Dialogue: 0,0:16:27.21,0:16:29.92,Main,,0,0,0,,Hayata Dönüş!Dialogue: 0,0:16:29.92,0:16:31.52,Main,,0,0,0,,Saç Boğması!Dialogue: 0,0:16:44.85,0:16:45.85,Main,,0,0,0,,Kahretsin!Dialogue: 0,0:16:47.36,0:16:49.52,Main,,0,0,0,,Yakalanırsam işim biter!Dialogue: 0,0:16:49.52,0:16:50.48,Main,,0,0,0,,Kazı!Dialogue: 0,0:16:50.48,0:16:52.53,Main,,0,0,0,,Nerede?Dialogue: 0,0:16:57.12,0:16:59.20,Main,,0,0,0,,Parmak Tabanca: Istaka!Dialogue: 0,0:17:03.50,0:17:06.17,Main,,0,0,0,,O çubuk sivri bile değil.Dialogue: 0,0:17:10.13,0:17:11.76,Main,,0,0,0,,Istaka! Istaka! Istaka!Dialogue: 0,0:17:12.56,0:17:14.17,Main,,0,0,0,,Ağırlık Noktası!Dialogue: 0,0:17:14.17,0:17:15.01,Main,,0,0,0,,Demir Parça!Dialogue: 0,0:17:20.97,0:17:23.43,Main,,0,0,0,,Ah, ah, ah!Dialogue: 0,0:17:23.73,0:17:26.19,Main,,0,0,0,,Ne oldu?Dialogue: 0,0:17:26.19,0:17:27.49,Thoughts,,0,0,0,,Kahretsin.Dialogue: 0,0:17:27.49,0:17:32.11,Thoughts,,0,0,0,,Düşündüğüm gibi ona Kol Noktası veya  Boynuz Noktası'yla saldırmazsam kımıldamayacak bile.Dialogue: 0,0:17:34.41,0:17:37.82,Thoughts,,0,0,0,,Ama gümbürtü topu sınırım,...Dialogue: 0,0:17:37.82,0:17:40.33,Thoughts,,0,0,0,,...altı saatte bir top.Dialogue: 0,0:17:40.33,0:17:42.83,Thoughts,,0,0,0,,O sınırı aşmak bedenim için aşırı zorlayıcı.Dialogue: 0,0:17:45.00,0:17:51.13,Thoughts,,0,0,0,,Üstelik ikinci top esnasında dönüşüm bozuluyor ve kontrolden çıkıyor.Dialogue: 0,0:17:51.13,0:17:55.72,Thoughts,,0,0,0,,Üçüncüsündeyse bilincimi yitiriyorum ve dövüşmek söz konusu bile olmuyor.Dialogue: 0,0:17:55.72,0:17:59.89,Thoughts,,0,0,0,,Ne yapacağım? Sadece bir tane dahaysa başarabilirim.Dialogue: 0,0:18:02.39,0:18:06.89,Main,,0,0,0,,Şiş kebap olmaya hazırlan!Dialogue: 0,0:18:08.69,0:18:10.89,Main,,0,0,0,,Shishi Kebap!Dialogue: 0,0:18:08.69,0:18:10.89,Note,,0,0,0,,Shishi - Aslan, 'Şiş Kebap' ifadesinde kelime oyunu yapıyor.Dialogue: 0,0:18:25.91,0:18:28.41,Thoughts,,0,0,0,,Böyle devam ederse vakit kaybı olacak!Dialogue: 0,0:18:28.41,0:18:29.54,Thoughts,,0,0,0,,Gümbürtü!Dialogue: 0,0:18:30.96,0:18:33.20,Thoughts,,0,0,0,,Riski çok ama işe yarama ihtimali var.Dialogue: 0,0:18:34.00,0:18:35.21,Thoughts,,0,0,0,,Ya hep ya hiç!Dialogue: 0,0:18:35.21,0:18:38.22,Thoughts,,0,0,0,,Üç dakika içinde bu işi bitirmeliyim!Dialogue: 0,0:18:38.22,0:18:39.20,Main,,0,0,0,,Al bakalım!Dialogue: 0,0:18:39.20,0:18:40.54,Main,,0,0,0,,Boynuz Noktası!Dialogue: 0,0:18:43.14,0:18:44.47,Thoughts,,0,0,0,,Hayır!Dialogue: 0,0:18:44.47,0:18:46.22,Main,,0,0,0,,Sıcak! Sıcak! Sıcak!Dialogue: 0,0:18:47.68,0:18:49.10,Main,,0,0,0,,Kebap!Dialogue: 0,0:18:50.94,0:18:52.69,Main,,0,0,0,,Zıplama Noktası!Dialogue: 0,0:18:53.54,0:18:55.65,Main,,0,0,0,,Bu değil!Dialogue: 0,0:19:11.75,0:19:15.55,Thoughts,,0,0,0,,Gerçekten kontrol edemiyorum. Kahretsin!Dialogue: 0,0:19:15.55,0:19:17.76,Thoughts,,0,0,0,,Kol Noktası'nı çıkarabilseydim...Dialogue: 0,0:19:17.76,0:19:21.28,Thoughts,,0,0,0,,...ona en iyi Yarık Toynak'ımla vurabilirdim.Dialogue: 0,0:19:21.76,0:19:24.26,Thoughts,,0,0,0,,Bu oda alev aldığı için tehlikeli.Dialogue: 0,0:19:24.26,0:19:29.22,Thoughts,,0,0,0,,Anahtarı bile olmayan bu adamla vakit harcayamam.Dialogue: 0,0:19:29.22,0:19:33.69,Thoughts,,0,0,0,,Bir an önce 2 numaralı anahtarı almalıyım...Dialogue: 0,0:19:34.00,0:19:36.98,Thoughts,,0,0,0,,...ve Zorogil'i serbest bırakmalıyım.Dialogue: 0,0:19:36.98,0:19:40.70,Thoughts,,0,0,0,,Robin'i de kurtaramayacağım.Dialogue: 0,0:19:42.32,0:19:45.38,Thoughts,,0,0,0,,Evet. Robin!Dialogue: 0,0:19:45.38,0:19:48.33,Main,,0,0,0,,Evet! Ben...Dialogue: 0,0:19:49.03,0:19:50.29,Main,,0,0,0,,Ben...Dialogue: 0,0:19:50.29,0:19:55.88,Main,,0,0,0,,Ben arkadaşımı kurtarmak için dövüşüyorum!Dialogue: 0,0:19:55.88,0:19:58.98,Main,,0,0,0,,Sert bir hayvansın!Dialogue: 0,0:19:59.96,0:20:02.93,Main,,0,0,0,,Hayata Dönüş!Dialogue: 0,0:20:12.57,0:20:14.77,Main,,0,0,0,,Saçı el şekline dönüştü.Dialogue: 0,0:20:14.77,0:20:18.48,Main,,0,0,0,,Yapmalıyım! Böyle bir yerde ölemem!Dialogue: 0,0:20:18.78,0:20:20.90,Main,,0,0,0,,BEN ONLARIN UMUDUYUM!Dialogue: 0,0:20:20.90,0:20:23.11,Main,,0,0,0,,Aslan Parmak Tabanca!Dialogue: 0,0:20:35.88,0:20:38.60,Credits,,0,0,0,,Editing:  Galaxy 9000  Timing: Galaxy 9000  Quality Control: danpmss, Honoka, Galaxy 9000, Grug, Pepperjack  Soundtracking:  Halee  Graphics:  Datenshi  Karaoke: KaitouYahiko  Translation: Crunchyroll, Gaijin