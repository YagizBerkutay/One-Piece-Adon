,&H00FFFFFF,&H000000FF,&H002FıAAF,&H00000000,0,0,0,0,100,100,0,0,1,2,0,8,10,10,80,1Style: Translation,Duality,65,&H002FıAAF,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2,0,2,10,10,10,1Style: Kanji,Duality,65,&H002FıAAF,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2,0,8,10,10,120,1Style: Author,Impress BT,22.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1,1,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:01:50.04,0:02:00.04,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:18:26.00,0:18:36.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:01:50.04,0:01:57.05,Title,,0,0,0,,Yargı Adası'nda Büyük Hesaplaşma!!Dialogue: 1,0:01:50.04,0:01:57.05,Title,,0,0,0,,Yargı Adası'nda Büyük Hesaplaşma!!Dialogue: 0,0:01:57.05,0:02:00.76,Main-207+,,0,0,0,,Gerçekten üzgünüm ama lütfen geçmeme izin verir misiniz?Dialogue: 0,0:02:02.65,0:02:04.93,Main-207+,,0,0,0,,Nazikçe istesen bile...Dialogue: 0,0:02:04.93,0:02:08.98,Main-207+,,0,0,0,,...hayır dediğim zaman hayır demektir!Dialogue: 0,0:02:14.15,0:02:16.15,Main-207+,,0,0,0,,Anladım! O zaman...Dialogue: 0,0:02:16.76,0:02:18.11,Main-207+,,0,0,0,,...hazır olun!Dialogue: 0,0:02:18.65,0:02:19.78,Main-207+,,0,0,0,,Lanet olası korsan!Dialogue: 0,0:02:19.78,0:02:21.59,Main-207+,,0,0,0,,Gomu Gomu No...Dialogue: 0,0:02:23.61,0:02:24.91,Main-207+,,0,0,0,,...Müttefik Robot!Dialogue: 0,0:02:33.09,0:02:35.13,Main-207+,,0,0,0,,Hey, çok pis bir numara!Dialogue: 0,0:02:35.13,0:02:36.83,Main-207+,,0,0,0,,Ona bu şekilde saldıramayız!Dialogue: 0,0:02:39.09,0:02:42.73,Main-207+,,0,0,0,,Ne çocuksu bir numara! Tereddüt etmeyin!Dialogue: 0,0:02:44.22,0:02:47.18,Main-207+,,0,0,0,,Müttefik Robot Yumruğu!Dialogue: 0,0:02:48.87,0:02:49.31,Main-207+,,0,0,0,,Üzgünüm!Dialogue: 0,0:02:51.48,0:02:53.36,Main-207+,,0,0,0,,Müttefik Robot Tekmesi!Dialogue: 0,0:02:55.87,0:02:58.03,Main-207+,,0,0,0,,Ah!! Çok üzgünüm! *Senpai!Dialogue: 0,0:02:58.03,0:02:59.95,Main-207+,,0,0,0,,Dalga geçmeyi bırak!Dialogue: 0,0:03:00.89,0:03:02.12,Main-207+,,0,0,0,,Sırtın tamamen açıkta!Dialogue: 0,0:03:13.88,0:03:14.75,Main-207+,,0,0,0,,Lanet...Dialogue: 0,0:03:24.79,0:03:27.77,Main-207+,,0,0,0,,Durdurun onu! Sadece tek kişi!Dialogue: 0,0:03:50.95,0:03:54.01,Main-207+,,0,0,0,,Bu da ne?  Bedeni çok hafif görünüyor!Dialogue: 0,0:03:54.01,0:03:55.79,Main-207+,,0,0,0,,Acelem var.Dialogue: 0,0:03:56.22,0:03:59.05,Main-207+,,0,0,0,,Yine görüşelim! Görüşürüz!Dialogue: 0,0:04:07.26,0:04:10.22,Main-207+,,0,0,0,,Dur!Dialogue: 0,0:04:10.65,0:04:13.65,Main-207+,,0,0,0,,İçeri girdi!  Hemen peşinden gidin!Dialogue: 0,0:04:13.65,0:04:15.74,Main-207+,,0,0,0,,Ana Ada'ya girdi!Dialogue: 0,0:04:15.74,0:04:17.84,Main-207+,,0,0,0,,Ana Ada Kapısı'ndan Şef'e mesaj!Dialogue: 0,0:04:17.84,0:04:21.83,Main-207+,,0,0,0,,Hasır Şapkalı Luffy, Ana Ada'ya girdi!Dialogue: 0,0:04:21.83,0:04:25.31,Main-207+,,0,0,0,,Ne?!  Ana Ada'ya girmesine izin mi verdiniz?!Dialogue: 0,0:04:25.31,0:04:27.28,Main-207+,,0,0,0,,Neler oluyor?!Dialogue: 0,0:04:27.28,0:04:28.97,Main-207+,,0,0,0,,Ya Oimo ve Kashii?Dialogue: 0,0:04:28.97,0:04:31.25,Main-207+,,0,0,0,,Onlar da mı yenildi?Dialogue: 0,0:04:31.25,0:04:35.05,Main-207+,,0,0,0,,Hayır, onların ülkesinde gece vakti olmalı. Bu yüzden...Dialogue: 0,0:04:36.09,0:04:37.71,Main-207+,,0,0,0,,...uyuyor olmalılar.Dialogue: 0,0:04:37.71,0:04:41.05,Main-207+,,0,0,0,,Şimdi uyuyacak zaman mı?!  Hemen uyandırın şunları!Dialogue: 0,0:04:41.05,0:04:43.67,Main-207+,,0,0,0,,Ana Ada'da uyuyan askerleri de uyandırın!Dialogue: 0,0:04:43.67,0:04:45.39,Main-207+,,0,0,0,,Anlaşıldı!Dialogue: 0,0:04:46.69,0:04:52.39,Main-207+,,0,0,0,,Tek bir davetsiz misafir için bu kadar bağırman doğru mu, patron?Dialogue: 0,0:04:53.61,0:04:55.86,Main-207+,,0,0,0,,Biz buradayız.Dialogue: 0,0:04:55.86,0:04:59.65,Main-207+,,0,0,0,,Aptallaşmayın! Dünya Hükümeti'nin girişindeki Yargı Adası,...Dialogue: 0,0:04:59.65,0:05:02.90,Main-207+,,0,0,0,,...onun kutsal sorgucunu takmış gibidir.Dialogue: 0,0:05:03.55,0:05:09.62,Main-207+,,0,0,0,,Buraya girmeye çalışan bir aptal,  en azından bunun ne anlama geldiğini bilmeli.Dialogue: 0,0:05:09.62,0:05:15.41,Main-207+,,0,0,0,,O adam tek bir arkadaşını  geri almak için Ana Ada'ya kadar geldi.Dialogue: 0,0:05:15.41,0:05:18.17,Main-207+,,0,0,0,,Bizi küçümsüyor! Buna nasıl cüret eder?Dialogue: 0,0:05:18.89,0:05:22.31,Main-207+,,0,0,0,,Hasır Şapka Tayfası ve onların lanet olası adamları...Dialogue: 0,0:05:23.01,0:05:27.51,Main-207+,,0,0,0,,Kapıcılar!  Bana Ana Kapı'daki durumu rapor edin!Dialogue: 0,0:05:27.51,0:05:28.93,Main-207+,,0,0,0,,Hey, kapıcılar!Dialogue: 0,0:05:30.35,0:05:31.85,Main-207+,,0,0,0,,Kaç düşman var?!Dialogue: 0,0:05:32.79,0:05:34.27,Main-207+,,0,0,0,,Şimdi neredeler?!Dialogue: 0,0:05:34.89,0:05:37.29,Main-207+,,0,0,0,,Cevap ver, Ana Kapı!Dialogue: 0,0:05:37.29,0:05:39.15,Main-207+,,0,0,0,,Hey, ne oldu?!Dialogue: 0,0:05:40.51,0:05:43.86,Main-207+,,0,0,0,,Cevap ver, Ana Kapı!Dialogue: 0,0:05:45.57,0:05:47.24,Main-207+,,0,0,0,,İp Hareketi!Dialogue: 0,0:05:47.24,0:05:50.19,Main-207+,,0,0,0,,Sekiz Düğüm Numarası!Dialogue: 0,0:05:51.37,0:05:53.99,Main-207+,,0,0,0,,Bazuka Sopa!Dialogue: 0,0:05:56.17,0:05:58.42,Main-207+,,0,0,0,,Bunun için mermi bile harcamayız!Dialogue: 0,0:05:58.80,0:06:01.34,Main-207+,,0,0,0,,Bu kapıdan girmeye çalışın!  Kapıları açın!Dialogue: 0,0:06:05.59,0:06:07.22,Main-207+,,0,0,0,,Açmalarına izin vermeyin!Dialogue: 0,0:06:07.68,0:06:09.68,Main-207+,,0,0,0,,Yolumuza çıkıyorsun!Dialogue: 0,0:06:09.68,0:06:11.49,Main-207+,,0,0,0,,Mozu, sola git!Dialogue: 0,0:06:11.49,0:06:13.22,Main-207+,,0,0,0,,Anlaşıldı!Dialogue: 0,0:06:13.87,0:06:15.60,Main-207+,,0,0,0,,Geçmenize izin vermeyeceğim!Dialogue: 0,0:06:16.34,0:06:18.48,Main-207+,,0,0,0,,Burnumdan kıl çıktı!Dialogue: 0,0:06:18.99,0:06:20.44,Main-207+,,0,0,0,,Dikkatini dağıtmamalısın!Dialogue: 0,0:06:23.98,0:06:24.90,Main-207+,,0,0,0,,Çabuk!Dialogue: 0,0:06:25.25,0:06:26.49,Main-207+,,0,0,0,,Sana borçluyum!Dialogue: 0,0:06:33.20,0:06:35.87,Main-207+,,0,0,0,,Omurga Ezici!Dialogue: 0,0:06:42.65,0:06:46.30,Main-207+,,0,0,0,,Daha açılmadı mı, Mozu, Kiwi?!Dialogue: 0,0:06:47.39,0:06:51.05,Main-207+,,0,0,0,,Bu anahtar deliği, Franky Ailesi'nin bir üyesine karşı fazla dayanmaz!Dialogue: 0,0:06:53.37,0:06:54.76,Main-207+,,0,0,0,,Tamamdır!Dialogue: 0,0:06:55.29,0:06:56.47,Main-207+,,0,0,0,,Burası da tamam!Dialogue: 0,0:06:56.47,0:07:01.73,Main-207+,,0,0,0,,Evet! Kapıları açma zamanı! Süper İnsan Gücünde Yok Ediciler!Dialogue: 0,0:07:08.44,0:07:11.24,Main-207+,,0,0,0,,Geçmelerine izin vermeyin!  Kahretsin!Dialogue: 0,0:07:11.64,0:07:13.12,Main-207+,,0,0,0,,Defolun!  Engel oluyorsunuz!Dialogue: 0,0:07:28.42,0:07:30.17,Main-207+,,0,0,0,,Geçelim!Dialogue: 0,0:07:35.09,0:07:37.99,Main-207+,,0,0,0,,İlk olarak Ana Kapı'yı yarıp geçtik!Dialogue: 0,0:07:40.57,0:07:44.37,Main-207+,,0,0,0,,Ooooh! Bu delik de ne?!Dialogue: 0,0:07:44.37,0:07:48.55,Main-207+,,0,0,0,,Zamanımız yok, aşağı bakmayın! İleri!Dialogue: 0,0:07:48.55,0:07:51.54,Main-207+,,0,0,0,,Ana Ada'ya koşmaya devam edin!Dialogue: 0,0:07:51.54,0:07:53.82,Main-207+,,0,0,0,,Bu bir şelale!Dialogue: 0,0:07:57.49,0:07:58.33,Main-207+,,0,0,0,,Yaşasın!Dialogue: 0,0:07:58.33,0:08:00.77,Main-207+,,0,0,0,,Hey, çocuklar!  Bu taraftan!Dialogue: 0,0:08:00.77,0:08:03.46,Main-207+,,0,0,0,,Çabuk yardım edin!Dialogue: 0,0:08:10.39,0:08:14.67,Main-207+,,0,0,0,,Kashii-san! Oimo-san! Lütfen hemen uyanın!Dialogue: 0,0:08:14.67,0:08:18.76,Main-207+,,0,0,0,,Ana Kapı, davetsiz misafirler tarafından açıldı!Dialogue: 0,0:08:21.75,0:08:26.31,Main-207+,,0,0,0,,Ana Kapı'nın açıldığını söyledi, Oimo.Dialogue: 0,0:08:26.31,0:08:31.69,Main-207+,,0,0,0,,Bunun olmasına izin veremeyiz, Kashii.Dialogue: 0,0:08:35.39,0:08:37.39,Main-207+,,0,0,0,,Yeni uyandığımız için biraz zor.Dialogue: 0,0:08:37.39,0:08:39.41,Main-207+,,0,0,0,,Yapacak işimiz var.  Gidelim.Dialogue: 0,0:09:02.85,0:09:12.78,Sign2,,0,0,0,,Kashii Enies Lobby  Ada Kapısı'nın BekçisiDialogue: 1,0:09:02.85,0:09:12.78,Sign2,,0,0,0,,Kashii Enies Lobby  Ada Kapısı'nın BekçisiDialogue: 0,0:09:02.85,0:09:12.78,Sign2,,0,0,0,,Oimo Enies Lobby  Ada Kapısı'nın BekçisiDialogue: 1,0:09:02.85,0:09:12.78,Sign2,,0,0,0,,Oimo Enies Lobby  Ada Kapısı'nın BekçisiDialogue: 0,0:09:05.21,0:09:07.59,Main-207+,,0,0,5,,Henüz yeterince uyumadım.Dialogue: 0,0:09:08.44,0:09:11.59,Main-207+,,0,0,5,,Hemen şunların icabına bakıp  uyumaya devam edelim.Dialogue: 0,0:09:11.59,0:09:12.78,Main-207+,,0,0,5,,Bence de!Dialogue: 0,0:09:12.78,0:09:15.45,Main-207+,,0,0,0,,D-D-Devler!Dialogue: 0,0:09:15.85,0:09:20.54,Main-207+,,0,0,0,,Buraya niye geldiğinizi bilmiyorum...Dialogue: 0,0:09:20.54,0:09:23.57,Main-207+,,0,0,0,,...ama ezilmeden önce evinize dönmelisiniz!Dialogue: 0,0:09:23.57,0:09:24.78,Main-207+,,0,0,0,,Değil mi, Oimo?Dialogue: 0,0:09:24.78,0:09:27.37,Main-207+,,0,0,0,,Evet, Kashii. Bence de öyle.Dialogue: 0,0:09:28.14,0:09:31.55,Main-207+,,0,0,0,,Kemiklerini ezip dümdüz edelim.Dialogue: 0,0:09:31.55,0:09:35.59,Main-207+,,0,0,0,,Kapıcı olarak devleri tutmak hiç adil değil!Dialogue: 0,0:09:35.92,0:09:39.99,Main-207+,,0,0,0,,Çok büyükler! Süper İnsan Gücündeki Yok Ediciler, onların yanında ufacık kaldı.Dialogue: 0,0:09:41.31,0:09:43.30,Main-207+,,0,0,0,,Şimdi, evinize dönün!Dialogue: 0,0:09:43.30,0:09:45.22,Main-207+,,0,0,0,,Bu kapıdan geçmenize izin vermeyeceğim.Dialogue: 0,0:09:45.22,0:09:46.85,Main-207+,,0,0,0,,Ben de!Dialogue: 0,0:09:46.85,0:09:48.47,Main-207+,,0,0,0,,Geliyorlar!Dialogue: 0,0:09:48.47,0:09:52.44,Main-207+,,0,0,0,,Düşman kim olursa olsun,  tereddüt etmemeliyiz! Franky Ailesi!Dialogue: 0,0:09:52.87,0:09:54.49,Main-207+,,0,0,0,,Ağabeyimiz için!Dialogue: 0,0:09:54.49,0:09:57.89,Main-207+,,0,0,0,,Evet.Dialogue: 0,0:09:59.37,0:10:02.12,Main-207+,,0,0,0,,Hey, anlıyor musunuz?Dialogue: 0,0:10:02.57,0:10:03.74,Main-207+,,0,0,0,,Evet.Dialogue: 0,0:10:04.11,0:10:05.70,Main-207+,,0,0,0,,Tamam!Dialogue: 0,0:10:07.92,0:10:12.29,Main-207+,,0,0,0,,Sadece üçümüz yapabiliriz!Dialogue: 0,0:10:12.29,0:10:17.72,Main-207+,,0,0,0,,O devler bile, gemi parçalamaktan kazandığımız süper insan gücümüze karşı koyamaz!Dialogue: 0,0:10:17.72,0:10:19.80,Main-207+,,0,0,0,,Yok Ediciler!Dialogue: 0,0:10:42.35,0:10:45.95,Main-207+,,0,0,0,,Üç Süper İnsan Gücündeki Yok Edici...Dialogue: 0,0:10:45.95,0:10:47.97,Main-207+,,0,0,0,,Bir anda yenildiler!Dialogue: 0,0:10:49.65,0:10:52.84,Main-207+,,0,0,0,,Biz doğuştan savaşçıyız!Dialogue: 0,0:10:53.15,0:10:58.47,Main-207+,,0,0,0,,Normalden biraz daha iri olan insanlarınkiyle mukayese edildiğinde, damarlarımızda akan kan çok farklıdır.Dialogue: 0,0:11:00.01,0:11:02.93,Main-207+,,0,0,0,,Hiçbirinizin geçmesine izin vermeyeceğim!Dialogue: 0,0:11:02.93,0:11:04.55,Main-207+,,0,0,0,,Ben de!Dialogue: 0,0:11:09.77,0:11:14.63,Main-207+,,0,0,0,,Korkmayın!  Moraliniz bozulmasın!Dialogue: 0,0:11:14.63,0:11:18.73,Main-207+,,0,0,0,,Evet!  Franky Ağabey'imiz o kapıların ardında!Dialogue: 0,0:11:22.79,0:11:27.63,Main-207+,,0,0,0,,Ağabeyimizin adına leke sürülmeyecek şekilde dövüşün! Franky Ailesi!Dialogue: 0,0:11:36.35,0:11:38.26,Main-207+,,0,0,0,,Hey! Hasır Şapkalı Luffy!Dialogue: 0,0:11:38.69,0:11:41.53,Main-207+,,0,0,0,,Yanında kaç arkadaşını getirdin?Dialogue: 0,0:11:43.09,0:11:46.18,Main-207+,,0,0,0,,Enies Lobby'de 10 binden fazla asker var!Dialogue: 0,0:11:47.01,0:11:49.55,Main-207+,,0,0,0,,Evet, yalnızım.Dialogue: 0,0:11:55.17,0:11:57.32,Main-207+,,0,0,0,,Yolu açın!Dialogue: 0,0:12:02.93,0:12:05.87,Main-207+,,0,0,0,,Söz dinleyip evinize dönmezseniz...Dialogue: 0,0:12:05.87,0:12:08.17,Main-207+,,0,0,0,,...sizi ezeceğiz!Dialogue: 0,0:12:19.53,0:12:24.22,Main-207+,,0,0,0,,Korkmayın!  Franky Ağabey'imiz, o kapıların ardında!Dialogue: 0,0:12:31.65,0:12:36.02,Main-207+,,0,0,0,,Onlara ağabeyimizin adına leke sürmeyecek bir dövüş gösterin! Franky Ailesi!Dialogue: 0,0:12:42.11,0:12:46.16,Main-207+,,0,0,0,,Başarısız olmayın! Roket Adam için yolu temizleyelim!Dialogue: 0,0:12:52.27,0:12:54.67,Main-207+,,0,0,0,,Kapıyı açmaya zorlayın!Dialogue: 0,0:12:58.63,0:13:01.88,Main-207+,,0,0,0,,Hiçbirinizin kapıdan geçmesine izin vermeyeceğim!Dialogue: 0,0:13:08.35,0:13:09.76,Main-207+,,0,0,0,,Yok Ediciler!Dialogue: 0,0:13:09.76,0:13:10.83,Main-207+,,0,0,0,,Çocuklar!Dialogue: 0,0:13:11.93,0:13:15.81,Main-207+,,0,0,0,,Kahretsin! Ana gücümüze bunu yapmaya nasıl cüret ederler?Dialogue: 0,0:13:15.81,0:13:17.19,Main-207+,,0,0,0,,Hadi!Dialogue: 0,0:13:25.11,0:13:26.78,Main-207+,,0,0,0,,Ne?Dialogue: 0,0:13:27.29,0:13:28.42,Main-207+,,0,0,0,,Zambai!Dialogue: 0,0:13:28.42,0:13:29.37,Main-207+,,0,0,0,,Kiwi! Mozu!Dialogue: 0,0:13:29.84,0:13:31.20,Main-207+,,0,0,0,,Galley-La!Dialogue: 0,0:13:35.71,0:13:37.41,Main-207+,,0,0,0,,Üzgünüm, geciktik!Dialogue: 0,0:13:37.41,0:13:41.37,Main-207+,,0,0,0,,Sodom ve Gomorrah'ı karaya çıkarmak umduğumuzdan uzun sürdü!Dialogue: 0,0:13:41.37,0:13:44.26,Main-207+,,0,0,0,,Zambai! Yok Ediciler...Dialogue: 0,0:13:44.59,0:13:46.07,Main-207+,,0,0,0,,Anlıyorum.Dialogue: 0,0:13:46.77,0:13:49.70,Main-207+,,0,0,0,,Şimdi onları tedavi edecek zamanımız yok!Dialogue: 0,0:13:49.70,0:13:55.43,Main-207+,,0,0,0,,Ağabeyimizin olduğu yere ulaşmak için, ne olursa olsun o kapıları açmalıyız!Dialogue: 0,0:14:05.29,0:14:05.99,Main-207+,,0,0,0,,Gidelim!Dialogue: 0,0:14:06.99,0:14:07.53,Main-207+,,0,0,0,,Tamam!Dialogue: 0,0:14:09.89,0:14:13.10,Main-207+,,0,0,0,,Bu adamın sandallarını yok edeceğiz. Mozu!Dialogue: 0,0:14:13.10,0:14:14.75,Main-207+,,0,0,0,,Anlaşıldı, Kiwi!Dialogue: 0,0:14:22.75,0:14:25.71,Main-207+,,0,0,0,,Gemi Dibi Ayıran Kesiş!Dialogue: 0,0:14:28.71,0:14:30.01,Main-207+,,0,0,0,,İp Hareketi!Dialogue: 0,0:14:30.48,0:14:33.18,Main-207+,,0,0,0,,Esnek Bağ Kabı!Dialogue: 0,0:14:46.03,0:14:47.40,Main-207+,,0,0,0,,Kashii!Dialogue: 0,0:14:52.95,0:14:54.01,Main-207+,,0,0,0,,Tilestone!Dialogue: 0,0:14:54.01,0:14:55.41,Main-207+,,0,0,0,,Evet!Dialogue: 0,0:15:08.59,0:15:10.27,Main-207+,,0,0,0,,Tünel Kilidi!Dialogue: 0,0:15:10.27,0:15:11.64,Main-207+,,0,0,0,,Çivileme tamam!Dialogue: 0,0:15:23.63,0:15:25.94,Main-207+,,0,0,0,,Sizi...Dialogue: 0,0:15:25.94,0:15:28.24,Main-207+,,0,0,0,,...ezeceğim!Dialogue: 0,0:15:34.81,0:15:36.20,Main-207+,,0,0,0,,Kashii!Dialogue: 0,0:15:43.35,0:15:44.63,Main-207+,,0,0,0,,Tamamdır!Dialogue: 0,0:15:49.21,0:15:50.76,Main-207+,,0,0,0,,Pislikler.Dialogue: 0,0:15:51.39,0:15:54.09,Main-207+,,0,0,0,,Çocuklar, bir tur daha yapalım!Dialogue: 0,0:15:54.09,0:15:56.59,Main-207+,,0,0,0,,Evet!Dialogue: 0,0:16:03.53,0:16:05.21,Main-207+,,0,0,0,,Orada işler ne durumda?Dialogue: 0,0:16:05.21,0:16:10.87,Main-207+,,0,0,0,,Şu anda Ana Ada Kapısı'nın önünde, Oimo ve Kashii'nin düşmanla yüzleşiyor olması gerekiyor.Dialogue: 0,0:16:10.87,0:16:12.67,Main-207+,,0,0,0,,Bana göre sorun olmamalı.Dialogue: 0,0:16:12.67,0:16:16.98,Main-207+,,0,0,0,,Öyle mi? Ana Ada'ya giren  Hasır Şapka'yı yakaladınız mı?Dialogue: 0,0:16:16.98,0:16:19.50,Main-207+,,0,0,0,,Ah, şey...Dialogue: 0,0:16:19.87,0:16:23.77,Main-207+,,0,0,0,,Tahmini olarak, aşağı yukarı 400.Dialogue: 0,0:16:23.77,0:16:27.13,Main-207+,,0,0,0,,400? Neden bahsediyorsun?Dialogue: 0,0:16:27.13,0:16:29.03,Main-207+,,0,0,0,,Zarar durumunu rapor ediyorum.Dialogue: 0,0:16:35.95,0:16:38.19,Main-207+,,0,0,0,,Ha? Zarar raporu mu?Dialogue: 0,0:16:38.19,0:16:40.77,Main-207+,,0,0,0,,Dört yüzden fazla askerin yenildiğini mi söylüyorsun?!Dialogue: 0,0:16:41.12,0:16:43.73,Main-207+,,0,0,0,,Buna bir yüz daha eklendi.Dialogue: 0,0:16:44.45,0:16:46.75,Main-207+,,0,0,0,,Hayır, afedersiniz.  Düzeltme yapacağım.Dialogue: 0,0:16:46.75,0:16:49.94,Main-207+,,0,0,0,,Elbette yapacaksın.  Askerler o kadar güçsüz değil!Dialogue: 0,0:16:50.42,0:16:52.28,Main-207+,,0,0,0,,O kadar fazlasının yenildiğine inanmamı mı bekliyorsun?!Dialogue: 0,0:16:52.28,0:16:55.45,Main-207+,,0,0,0,,Kurban varsa tam olarak rapor et!Dialogue: 0,0:17:01.83,0:17:04.56,Main-207+,,0,0,0,,Evet, o zaman raporumu veriyorum.Dialogue: 0,0:17:04.56,0:17:09.21,Main-207+,,0,0,0,,Şimdilik kurban sayısı 5- *Niin!Dialogue: 0,0:17:10.51,0:17:12.30,Main-207+,,0,0,0,,Beş kişi mi?!Dialogue: 0,0:17:12.30,0:17:14.55,Main-207+,,0,0,0,,Beş kişiyle mi karıştırdın?!Dialogue: 0,0:17:14.55,0:17:18.16,Main-207+,,0,0,0,,Üfff, düzgün bir  rapor bile veremiyor musun?!Dialogue: 0,0:17:18.16,0:17:21.06,Main-207+,,0,0,0,,Beş... yüz kişi.Dialogue: 0,0:17:22.59,0:17:27.52,Main-207+,,0,0,0,,Görünüşe göre Hasır Şapkalı Luffy, dövüş bile yapmadan adada koşuşturuyor.Dialogue: 0,0:17:27.52,0:17:32.35,Main-207+,,0,0,0,,Ah, elbette öyle olacak! Bir kerede o kadar fazla askerle yüzleşen...Dialogue: 0,0:17:32.35,0:17:36.03,Main-207+,,0,0,0,,...bir aptalı yakalamak an meselesi!Dialogue: 0,0:17:38.59,0:17:39.99,Main-207+,,0,0,0,,İyi iş çıkardınız.Dialogue: 0,0:17:40.57,0:17:44.37,Main-207+,,0,0,0,,Şef, Lucci'nin ekibi geldi.Dialogue: 0,0:17:44.77,0:17:46.31,Main-207+,,0,0,0,,Döndüler mi?Dialogue: 0,0:17:46.89,0:17:48.04,Main-207+,,0,0,0,,İçeri girsinler!Dialogue: 0,0:17:50.63,0:17:52.81,Main-207+,,0,0,0,,Hey, Sogeking...Dialogue: 0,0:17:54.53,0:17:54.92,Main-207+,,0,0,0,,Hey!Dialogue: 0,0:17:55.03,0:17:57.43,Main-207+,,0,0,0,,Acıttı, hey!Dialogue: 0,0:17:57.43,0:18:00.43,Main-207+,,0,0,0,,Bu soğuk hava aygıt fonksiyonunu nasıl yapacağımla ilgili.Dialogue: 0,0:18:00.43,0:18:02.43,Main-207+,,0,0,0,,Bir bakayım.Dialogue: 0,0:18:02.43,0:18:04.43,Main-207+,,0,0,0,,Eh, bana sorma!Dialogue: 0,0:18:06.99,0:18:09.35,Main-207+,,0,0,0,,Çocuklar, zaman geldi!Dialogue: 0,0:18:10.79,0:18:12.77,Main-207+,,0,0,0,,Geç oluyor, gitmeye ne dersiniz?Dialogue: 0,0:18:13.13,0:18:16.33,Main-207+,,0,0,0,,Şimdiye iki kapıyı da açmış olmalılar!Dialogue: 0,0:18:16.33,0:18:19.62,Main-207+,,0,0,0,,Saldıralım! Saldıralım!Dialogue: 0,0:18:20.27,0:18:24.03,Main-207+,,0,0,0,,Samuray adam!  Bariyerlerle sen ilgilen!Dialogue: 0,0:18:24.67,0:18:26.33,Main-207+,,0,0,0,,Ben hallederim!Dialogue: 0,0:18:33.21,0:18:39.05,Credits,,0,0,0,,Editing:  Galaxy 9000  Timing: Galaxy 9000, Lance, PhosCity  Quality Control: Feeso, Galaxy 9000, Mr. Luffy, Pepperjack  Soundtracking:  Halee  Graphics:  Datenshi  Translation: CrunchyrollDialogue: 0,0:00:00.71,0:00:03.37,Lyrics,,0,0,0,,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪Dialogue: 0,0:00:03.59,0:00:06.46,Lyrics,,0,0,0,,♪ Bayrağımızı süsleyip, gökyüzüne kaldırarak. ♪Dialogue: 0,0:00:12.77,0:00:18.06,Lyrics,,0,0,0,,♪ Sonsuz okyanusu geçip aramaya gidelim. ♪Dialogue: 0,0:00:18.86,0:00:21.81,Lyrics,,0,0,0,,♪ Henüz kimse tarafından...Dialogue: 0,0:00:21.90,0:00:23.94,Lyrics,,0,0,0,,...bulunmamış bu dünyanın mucizesini. ♪Dialogue: 0,0:00:24.82,0:00:27.96,Lyrics,,0,0,0,,♪ Çarpıp duran göğsümüzdeki...Dialogue: 0,0:00:27.96,0:00:29.71,Lyrics,,0,0,0,,...aynı hislerle devam etmeliyiz. ♪Dialogue: 0,0:00:29.71,0:00:35.59,Lyrics,,0,0,0,,♪ Hayaller peşinde koşanlar tarafından bırakılmış ayak izleri. ♪Dialogue: 0,0:00:36.42,0:00:39.39,Lyrics,,0,0,0,,♪ Ne tür bir fırtınalı gece olursa olsun,...Dialogue: 0,0:00:39.39,0:00:42.39,Lyrics,,0,0,0,,...kalplerimizin bir olmasını sağlarsak...Dialogue: 0,0:00:42.39,0:00:46.54,Lyrics,,0,0,0,,...bu zorluğun üstesinden gelebileceğiz! ♪Dialogue: 0,0:00:46.68,0:00:47.86,Lyrics,,0,0,0,,♪ Her zaman ♪Dialogue: 0,0:00:48.76,0:00:51.59,Lyrics,,0,0,0,,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪Dialogue: 0,0:00:51.72,0:00:54.55,Lyrics,,0,0,0,,♪ Bayrağımızı dalgalandırıp gökyüzüne kaldırarak. ♪Dialogue: 0,0:00:54.60,0:00:57.14,Lyrics,,0,0,0,,♪ Kimseye göstermeyeceğiz. ♪Dialogue: 0,0:00:57.23,0:01:00.58,Lyrics,,0,0,0,,♪ Gözlerimizde yaşlar olsa bile. ♪Dialogue: 0,0:01:00.77,0:01:03.52,Lyrics,,0,0,0,,♪ Peşinden gidelim, peşinden gidelim! ♪Dialogue: 0,0:01:03.69,0:01:06.52,Lyrics,,0,0,0,,♪ Hayallerimize giden doğru yolu...Dialogue: 0,0:01:06.61,0:01:09.23,Lyrics,,0,0,0,,...gösteren pusulanın. ♪Dialogue: 0,0:01:09.23,0:01:11.40,Lyrics,,0,0,0,,♪ Durmayacağız. ♪Dialogue: 0,0:01:11.42,0:01:14.42,Lyrics,,0,0,0,,♪ Dünyayı dolaşarak...Dialogue: 0,0:01:14.45,0:01:15.85,Lyrics,,0,0,0,,...yeniden başlayalım! ♪Dialogue: 0,0:01:18.83,0:01:21.49,Lyrics,,0,0,0,,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪Dialogue: 0,0:01:21.80,0:01:24.54,Lyrics,,0,0,0,,♪ Hedefimize doğru herkesten daha fazla. ♪Dialogue: 0,0:01:24.63,0:01:27.12,Lyrics,,0,0,0,,♪ Şimdi kaçmazsak,...Dialogue: 0,0:01:27.22,0:01:30.54,Lyrics,,0,0,0,,...yarını sıkı sıkıya kavrayabileceğiz! ♪Dialogue: 0,0:01:30.60,0:01:33.63,Lyrics,,0,0,0,,♪ Peşinden gidelim, peşinden gidelim! ♪Dialogue: 0,0:01:33.68,0:01:36.51,Lyrics,,0,0,0,,♪ Gözlerinden yansıtılmış tüm şimdiki zamanın. ♪Dialogue: 0,0:01:36.56,0:01:38.93,Lyrics,,0,0,0,,♪ Bembeyaz bir kalp...Dialogue: 0,0:01:39.15,0:01:41.43,Lyrics,,0,0,0,,...bana tüm hikayeyi anlatacak! ♪Dialogue: 0,0:01:41.73,0:01:44.43,Lyrics,,0,0,0,,♪ Yepyeni bir dünyada...Dialogue: 0,0:01:44.53,0:01:45.83,Lyrics,,0,0,0,,...yeniden başlayalım! ♪Dialogue: 2,0:00:00.14,0:00:00.98,Karaoke,,0,0,0,fx,HDialogue: 2,0:00:00.17,0:00:00.98,Karaoke,,0,0,0,fx,aDialogue: 3,0:00:00.98,0:00:01.39,Karaoke,,0,0,0,fx,HaDialogue: 3,0:00:00.98,0:00:01.39,Karaoke,,0,0,0,fx,HaDialogue: 3,0:00:00.98,0:00:01.39,Karaoke,,0,0,0,fx,HaDialogue: 3,0:00:00.98,0:00:01.39,Karaoke,,0,0,0,fx,HaDialogue: 3,0:00:00.98,0:00:01.39,Karaoke,,0,0,0,fx,HaDialogue: 2,0:00:00.21,0:00:01.09,Karaoke,,0,0,0,fx,sDialogue: 2,0:00:00.24,0:00:01.09,Karaoke,,0,0,0,fx,hDialogue: 2,0:00:00.28,0:00:01.09,Karaoke,,0,0,0,fx,iDialogue: 3,0:00:01.09,0:00:01.87,Karaoke,,0,0,0,fx,shiDialogue: 3,0:00:01.09,0:00:01.87,Karaoke,,0,0,0,fx,shiDialogue: 3,0:00:01.09,0:00:01.87,Karaoke,,0,0,0,fx,shiDialogue: 3,0:00:01.09,0:00:01.87,Karaoke,,0,0,0,fx,shiDialogue: 3,0:00:01.09,0:00:01.87,Karaoke,,0,0,0,fx,shiDialogue: 2,0:00:00.31,0:00:01.57,Karaoke,,0,0,0,fx,rDialogue: 2,0:00:00.35,0:00:01.57,Karaoke,,0,0,0,fx,iDialogue: 3,0:00:01.57,0:00:02.03,Karaoke,,0,0,0,fx,riDialogue: 3,0:00:01.57,0:00:02.03,Karaoke,,0,0,0,fx,riDialogue: 3,0:00:01.57,0:00:02.03,Karaoke,,0,0,0,fx,riDialogue: 3,0:00:01.57,0:00:02.03,Karaoke,,0,0,0,fx,riDialogue: 3,0:00:01.57,0:00:02.03,Karaoke,,0,0,0,fx,riDialogue: 2,0:00:00.38,0:00:01.73,Karaoke,,0,0,0,fx,dDial