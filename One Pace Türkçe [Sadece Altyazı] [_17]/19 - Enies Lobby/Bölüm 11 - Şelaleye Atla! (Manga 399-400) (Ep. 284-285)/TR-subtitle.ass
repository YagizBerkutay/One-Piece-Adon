Dialogue: 0,0:01:53.09,0:01:54.64,Flashbacks,,0,0,0,,Dünyayı kendinize düşman edince...
Dialogue: 0,0:01:54.64,0:01:56.38,Flashbacks,,0,0,0,,...hayatta kalabileceğinizi sanmayın!
Dialogue: 0,0:01:56.61,0:02:01.47,Flashbacks,,0,0,0,,BAHSE VAR MISIN?!
Dialogue: 0,0:02:03.98,0:02:07.77,Title,,0,0,250,,Şelaleye Atla!{\fad(1000,0)}
Dialogue: 0,0:02:07.77,0:02:13.73,Captions,,975,0,310,,Mahkeme Dışı\NMeydan{\fad(500,0)}
Dialogue: 0,0:02:13.73,0:02:18.74,Captions,,950,0,335,,Sol Kule\N(Mozu ve Lulu){\fad(500,0)}
Dialogue: 0,0:02:22.16,0:02:24.65,Main,,0,0,0,,Tamamdır! Levyeyi çektik!
Dialogue: 0,0:02:24.65,0:02:27.75,Main,,0,0,0,,BAŞARDIK!
Dialogue: 0,0:02:27.75,0:02:32.72,Captions,,0,930,290,,Sağ Kule\N(Kiwi ve Tilestone){\fad(500,0)}
Dialogue: 0,0:02:36.68,0:02:39.51,Main,,0,0,0,,Görünüşe göre Mozugil de başarmış!
Dialogue: 0,0:02:39.51,0:02:42.26,Main,,0,0,0,,Hadi, Hasır Şapka!
Dialogue: 0,0:02:46.00,0:02:47.64,Main,,0,0,0,,Köprü indiriliyor!
Dialogue: 0,0:02:48.23,0:02:51.00,Main,,0,0,0,,Görünüşe bakılırsa başarmışlar.
Dialogue: 0,0:02:51.00,0:02:52.70,Main,,0,0,0,,Harika zamanlama.
Dialogue: 0,0:02:58.14,0:02:59.97,Main,,0,0,0,,Heyecandan titriyorum.
Dialogue: 0,0:03:01.57,0:03:03.36,Main,,0,0,0,,Hemen indirin şunu!
Dialogue: 0,0:03:04.64,0:03:06.04,Main,,0,0,0,,Ne kötü bakışlı bir surat.
Dialogue: 0,0:03:08.38,0:03:09.37,Main,,0,0,0,,Robin!
Dialogue: 0,0:03:10.81,0:03:13.33,Main,,0,0,0,,Ne olursa olsun seni kurtaracağız!
Dialogue: 0,0:03:14.80,0:03:16.29,Main,,0,0,0,,Gelmeyin!
Dialogue: 0,0:03:17.05,0:03:18.63,Main,,0,0,0,,Çok istekliler.
Dialogue: 0,0:03:19.60,0:03:22.03,Main,,0,0,0,,Hükümet'in bayrağından korkmuyorlar.
Dialogue: 0,0:03:22.03,0:03:23.59,Main,,0,0,0,,Faydasız.
Dialogue: 0,0:03:23.59,0:03:26.76,Main,,0,0,0,,Bize denk olmaları mümkün değil.
Dialogue: 0,0:03:27.04,0:03:29.12,Main,,0,0,0,,Gelmeyin!
Dialogue: 0,0:03:29.12,0:03:31.33,Main,,0,0,0,,Açılır köprü iniyor!
Dialogue: 0,0:03:31.33,0:03:33.77,Main,,0,0,0,,Hadi, Hasır Şapka-san!
Dialogue: 0,0:03:34.02,0:03:36.55,Main,,0,0,0,,Lanet olası korsanlar!
Dialogue: 0,0:03:36.55,0:03:39.11,Main,,0,0,0,,İzin vermeyeceğiz!
Dialogue: 0,0:03:39.11,0:03:41.46,Main,,0,0,0,,Havan topunu hazırlayın!
Dialogue: 0,0:03:41.46,0:03:44.45,Main,,0,0,0,,Yıkmanız gerekse de açılır köprüyü durdurun!
Dialogue: 0,0:03:44.77,0:03:46.66,Main,,0,0,0,,Bunu yapmanıza izin vermeyeceğim!
Dialogue: 0,0:03:46.66,0:03:48.87,Main,,0,0,0,,Boru Düğümlü Bıçaklar!{\fad(150,150)}
Dialogue: 0,0:03:48.99,0:03:51.22,Main,,0,0,0,,İşiniz bitti!
Dialogue: 0,0:03:51.22,0:03:54.36,Main,,0,0,0,,Parçalayıcı Darbe!{\fad(150,150)}
Dialogue: 0,0:04:14.77,0:04:17.07,Main,,0,0,0,,Yargıç Baskerville!
Dialogue: 0,0:04:20.51,0:04:22.11,Main,,0,0,0,,Çok yazık!
Dialogue: 0,0:04:22.11,0:04:24.70,Main,,0,0,0,,Aslında biz yargıç üçlüsüyüz!
Dialogue: 0,0:04:25.32,0:04:26.41,Main,,0,0,0,,Ne?!
Dialogue: 0,0:04:26.41,0:04:29.87,Main,,0,0,0,,Ben, sol Baskerville ve adım Bas!
Dialogue: 0,0:04:29.87,0:04:33.33,Main,,0,0,0,,Ben, sağ Baskerville ve adım Kerville!
Dialogue: 0,0:04:33.33,0:04:36.58,Main,,0,0,0,,Ve ben, merkez Baskerville,\Nbenim adım ise,...
Dialogue: 0,0:04:36.58,0:04:37.84,Main,,0,0,0,,...prenses!
Dialogue: 0,0:04:37.94,0:04:39.30,Main,,0,0,0,,Sen neden bahsediyorsun?!
Dialogue: 0,0:04:39.30,0:04:42.75,Main,,0,0,0,,Sadece üçü bir arada mıymış?
Dialogue: 0,0:04:42.75,0:04:44.26,Main,,0,0,0,,Ne için?
Dialogue: 0,0:04:44.26,0:04:47.22,Main,,0,0,0,,Çünkü biz çok iyi arkadaşız!
Dialogue: 0,0:04:47.22,0:04:48.83,Main,,0,0,0,,Kapayın çenenizi!
Dialogue: 0,0:04:49.58,0:04:51.68,Main,,0,0,0,,Ateş! \NHavan topu kullanın!
Dialogue: 0,0:05:02.69,0:05:04.07,Main,,0,0,0,,Açılır köprü durdu mu?!
Dialogue: 0,0:05:04.07,0:05:05.76,Main,,0,0,0,,Bize engel oluyorlar!
Dialogue: 0,0:05:05.76,0:05:07.03,Main,,0,0,0,,Bu da ne?! Lanet olsun!
Dialogue: 0,0:05:07.72,0:05:10.59,Main,,0,0,0,,Kim yaptı bunu?!
Dialogue: 0,0:05:13.04,0:05:14.86,Main,,0,0,0,,Şef Spandam!
Dialogue: 0,0:05:14.86,0:05:17.31,Main,,0,0,0,,Adalet Kulesi'nden kaçın!
Dialogue: 0,0:05:23.92,0:05:26.63,Main,,0,0,0,,T-Tamam! İyi iş çıkardın!
Dialogue: 0,0:05:26.63,0:05:30.74,Main,,0,0,0,,Onlar buraya gelmeden Adalet Kapıları'na gideceğiz!
Dialogue: 0,0:05:30.74,0:05:32.51,Main,,0,0,0,,Hey, Nico Robin!
Dialogue: 0,0:05:32.51,0:05:34.77,Main,,0,0,0,,Biri Cutty Flam'ı alsın!
Dialogue: 0,0:05:35.12,0:05:36.14,Main,,0,0,0,,Robin!
Dialogue: 0,0:05:37.20,0:05:39.90,Main,,0,0,0,,Bunu yapacak kapasiteleri yok. Onlar sadece korsan.
Dialogue: 0,0:05:42.03,0:05:45.67,Main,,0,0,0,,Bizde suikast grubu CP9 var!
Dialogue: 0,0:05:47.04,0:05:52.75,Main,,0,0,0,,Bilginler adasından hayatta kalan ve\Nbir silahı uyandırmaya çalışan kişi, Nico Robin
Dialogue: 0,0:05:52.75,0:05:57.54,Main,,0,0,0,,Bu silahın planlarına sahip olan kişi, Cutty Flam
Dialogue: 0,0:05:58.22,0:06:02.70,Main,,0,0,0,,Bu fırsatı kaçırıp daha fazla güç kazanma şansımı \Nkesinlikle yok saymayacağım!
Dialogue: 0,0:06:07.74,0:06:09.06,Main,,0,0,0,,Cutty Flam...
Dialogue: 0,0:06:17.23,0:06:18.65,Main,,0,0,0,,Onlar...
Dialogue: 0,0:06:18.65,0:06:20.35,Main,,0,0,0,,Yoksa sen...
Dialogue: 0,0:06:23.52,0:06:26.94,Main,,0,0,0,,Antik silah Pluton'un planları.
Dialogue: 0,0:06:26.94,0:06:29.08,Main,,0,0,0,,Gerçek planlar.
Dialogue: 0,0:06:29.08,0:06:30.57,Main,,0,0,0,,Bana inanıyor musun?
Dialogue: 0,0:06:33.54,0:06:37.50,Main,,0,0,0,,Lucci, Kaku.\NSiz anlayabilirsiniz, değil mi?
Dialogue: 0,0:06:47.55,0:06:49.59,Main,,0,0,0,,Bunu hiç düşünmemiştim ama...
Dialogue: 0,0:06:50.37,0:06:55.56,Main,,0,0,0,,...bunca zamandır \Nonları kendi içinde mi saklıyordun?
Dialogue: 0,0:06:58.06,0:07:00.42,Main,,0,0,0,,G-Gerçek mi?
Dialogue: 0,0:07:00.42,0:07:01.98,Main,,0,0,0,,Onlar gerçek mi?!
Dialogue: 0,0:07:03.94,0:07:06.24,Main,,0,0,0,,Ver onları! Ver onları!
Dialogue: 0,0:07:06.24,0:07:08.18,Main,,0,0,0,,Uzun zamandır beklediğim planlar!
Dialogue: 0,0:07:08.18,0:07:09.57,Main,,0,0,0,,Nico Robin.
Dialogue: 0,0:07:11.49,0:07:15.93,Main,,0,0,0,,Sanırım gerçekten halk arasındaki\N söylentilere güvenemezsin.
Dialogue: 0,0:07:16.56,0:07:19.48,Main,,0,0,0,,Bu berbat yere gelirken\Ngeçirdiğimiz zaman içerisinde,...
Dialogue: 0,0:07:19.48,0:07:24.18,Main,,0,0,0,,...silahı kötü amaçlar uğruna kullanacak\Nbir şeytan olmadığını öğrendim.
Dialogue: 0,0:07:25.59,0:07:31.16,Main,,0,0,0,,En başından, Water 7 gemi işçilerinin \Nnesilden nesile miras aldıkları şey,...
Dialogue: 0,0:07:31.16,0:07:34.58,Main,,0,0,0,,...silahın nasıl yapılacağıyla ilgili \Nplanlar değildi.
Dialogue: 0,0:07:36.59,0:07:39.20,Flashbacks,,0,0,0,,Tom-san tarafından \Nyarım bırakılmış büyük bir görev.
Dialogue: 0,0:07:39.20,0:07:42.34,Flashbacks,,0,0,0,,Gelecek nesillere aktarmak için \Nher şeyi feda etmeye değecek planlar.
Dialogue: 0,0:07:42.34,0:07:47.44,Flashbacks,,0,0,0,,Nico Robin denilen kadının bu antik silahı\Nuyandırması tehdidi olduğu sürece,...
Dialogue: 0,0:07:47.44,0:07:51.32,Flashbacks,,0,0,0,,...dünyanın, bir direniş gücü olarak bu silaha ihtiyacı var.
Dialogue: 0,0:07:53.18,0:07:55.28,Main,,0,0,0,,Hey, Spanda.
Dialogue: 0,0:07:55.30,0:07:59.40,Main,,0,0,0,,Tom-san'ın ve Iceburg'ın \Ncanları pahasına korumaya çalıştıkları şey,...
Dialogue: 0,0:07:59.40,0:08:00.75,Main,,0,0,0,,Hemen ver şunu bana!
Dialogue: 0,0:08:00.75,0:08:03.69,Main,,0,0,0,,...bu silahın mimarının arzusudur.
Dialogue: 0,0:08:03.69,0:08:07.71,Main,,0,0,0,,Yani antik silah, \Nsenin gibi bir aptalın ellerine düşseydi,...
Dialogue: 0,0:08:07.71,0:08:10.37,Main,,0,0,0,,...ve sorun çıkarmak için hayat bulsaydı...
Dialogue: 0,0:08:10.37,0:08:13.76,Main,,0,0,0,,...ona karşı koyması için \Nbir silah yapılması gerekirdi.
Dialogue: 0,0:08:14.44,0:08:19.13,Main,,0,0,0,,Gerçekten Nico Robin'i kullandığınızda\Nsilahı uyandırabilirsiniz.
Dialogue: 0,0:08:19.13,0:08:21.13,Main,,0,0,0,,Onun maksadı bu olmasa bile,...
Dialogue: 0,0:08:21.13,0:08:23.78,Main,,0,0,0,,...bu işi yapması için \Nkullanılma ihtimali olduğu sürece,...
Dialogue: 0,0:08:23.78,0:08:25.73,Main,,0,0,0,,...o tehlikeli biri.
Dialogue: 0,0:08:25.73,0:08:32.26,Main,,0,0,0,,Ama onun, ölümün yüzüne bakarken\Ntereddüt etmeyen arkadaşları var.
Dialogue: 0,0:08:32.26,0:08:33.49,Main,,0,0,0,,Bu yüzden...
Dialogue: 0,0:08:34.91,0:08:36.91,Main,,0,0,0,,...bahse gireceğim.
Dialogue: 0,0:08:37.56,0:08:38.90,Main,,0,0,0,,Şu anda...
Dialogue: 0,0:08:38.90,0:08:43.87,Main,,0,0,0,,...bu tasarımcının hayalini gerçekleştirme ihtimali varsa, \Nyapabileceğim tek bir şey var.
Dialogue: 0,0:08:43.87,0:08:46.61,Main,,0,0,0,,Gevezeliği bırak ve onları hemen bana ver!
Dialogue: 0,0:08:46.61,0:08:48.09,Main,,0,0,0,,Onlar benim!
Dialogue: 0,0:09:06.43,0:09:07.85,Main,,0,0,0,,Ne yapıyorsun sen?!
Dialogue: 0,0:09:09.26,0:09:10.83,Main,,0,0,0,,Yanıp kül oldu!
Dialogue: 0,0:09:13.03,0:09:14.29,Main,,0,0,0,,Lanet olsun!
Dialogue: 0,0:09:14.29,0:09:15.82,Main,,0,0,0,,Seni öldüreceğim!
Dialogue: 0,0:09:16.28,0:09:19.78,Main,,0,0,0,,Beş yıllık görevimiz...
Dialogue: 0,0:09:26.96,0:09:31.46,Main,,0,0,0,,Direniş gücü olarak kullanılması \Ndüşünülen bu planlar da...
Dialogue: 0,0:09:31.46,0:09:34.29,Main,,0,0,0,,...hükümet tarafından arandı.
Dialogue: 0,0:09:35.67,0:09:38.44,Main,,0,0,0,,Aslında bu şeyin varlığı gizli tutulmuştu.
Dialogue: 0,0:09:38.44,0:09:41.51,Main,,0,0,0,,Ortaya çıktığında yok edilmeli.
Dialogue: 0,0:09:41.87,0:09:46.12,Main,,0,0,0,,Artık antik silaha karşı koyacak bir güç yok.
Dialogue: 0,0:09:46.12,0:09:48.95,Main,,0,0,0,,Nico Robin şimdi sizin tarafınızdan götürülürse,...
Dialogue: 0,0:09:48.95,0:09:50.48,Main,,0,0,0,,...dünya sona erecek.
Dialogue: 0,0:09:50.48,0:09:53.11,Main,,0,0,0,,Ama Hasır Şapkalar kazanırsa,...
Dialogue: 0,0:09:53.73,0:09:57.96,Main,,0,0,0,,...elinizde kesinlikle hiçbir şey kalmayacak.
Dialogue: 0,0:09:57.96,0:10:01.91,Main,,0,0,0,,Şahsen onların zaferine bahse giriyorum.
Dialogue: 0,0:10:01.91,0:10:04.41,Main,,0,0,0,,Nasıl bu kadar aptalca bir şey yapabildin?
Dialogue: 0,0:10:04.41,0:10:08.16,Main,,0,0,0,,Galiba sen de şimdi burada ölmek istiyorsun, ha?
Dialogue: 0,0:10:09.42,0:10:11.36,Main,,0,0,0,,Ağabey!
Dialogue: 0,0:10:12.33,0:10:14.70,Main,,0,0,0,,Ağabey!
Dialogue: 0,0:10:15.34,0:10:18.30,Main,,0,0,0,,Franky Ağabey!
Dialogue: 0,0:10:18.30,0:10:19.26,Main,,0,0,0,,Hey, bakın!
Dialogue: 0,0:10:19.26,0:10:20.68,Main,,0,0,0,,Ağabey, Adalet Kulesi'nde!
Dialogue: 0,0:10:20.68,0:10:22.55,Main,,0,0,0,,Bu harika! İyi görünüyor!
Dialogue: 0,0:10:22.55,0:10:24.26,Main,,0,0,0,,Hey! Bu Ağabey!
Dialogue: 0,0:10:24.26,0:10:25.61,Main,,0,0,0,,Ağabey!
Dialogue: 0,0:10:25.61,0:10:27.77,Main,,0,0,0,,Sana yardıma geldik!
Dialogue: 0,0:10:27.77,0:10:31.19,Main,,0,0,0,,Hasır Şapkalarla birlikte geldik!
Dialogue: 0,0:10:31.19,0:10:33.99,Main,,0,0,0,,Sodom ve Gomorrah da çok çalıştı!
Dialogue: 0,0:10:33.99,0:10:35.19,Main,,0,0,0,,Abi!
Dialogue: 0,0:10:35.19,0:10:37.07,Main,,0,0,0,,Bizimle birlikte eve dön!
Dialogue: 0,0:10:37.07,0:10:39.93,Main,,0,0,0,,Yaralanmadın değil mi?!
Dialogue: 0,0:10:39.93,0:10:42.74,Main,,0,0,0,,Çocuklar!
Dialogue: 0,0:10:42.74,0:10:44.68,Main,,0,0,0,,Çocuklar, lanet olsun!
Dialogue: 0,0:10:45.07,0:10:47.24,Main,,0,0,0,,Bana yardıma gelmenizi kim istedi?
Dialogue: 0,0:10:47.79,0:10:51.28,Main,,0,0,0,,Gelmenizi kim istedi?!
Dialogue: 0,0:10:55.34,0:10:57.04,Main,,0,0,0,,SİZİ SERSEMLER!
Dialogue: 0,0:10:57.04,0:11:00.28,Main,,0,0,0,,Lanet olsun! Ağlamıyorum!
Dialogue: 0,0:11:08.60,0:11:11.17,Main,,0,0,0,,Kapayın çenenizi! Hepiniz!
Dialogue: 0,0:11:11.61,0:11:13.19,Main,,0,0,0,,Hey! Şeytan mısın sen?!
Dialogue: 0,0:11:13.19,0:11:14.77,Main,,0,0,0,,Robin bekliyor!
Dialogue: 0,0:11:14.77,0:11:16.65,Main,,0,0,0,,Hemen köprüyü indirin!
Dialogue: 0,0:11:16.65,0:11:18.53,Main,,0,0,0,,Ah, doğru.
Dialogue: 0,0:11:18.53,0:11:20.28,Main,,0,0,0,,Acele edin sersemler!
Dialogue: 0,0:11:20.28,0:11:21.38,Main,,0,0,0,,Evet!
Dialogue: 0,0:11:21.38,0:11:24.24,Main,,0,0,0,,Siz sersemler acele etseniz iyi olur!\NCanınıza okuyacağım!
Dialogue: 0,0:11:24.24,0:11:26.32,Main,,0,0,0,,D-Doğru.
Dialogue: 0,0:11:26.32,0:11:29.87,Main,,0,0,0,,Tutarsız şeyler söylediğinde bile\N Nami-san'ı seviyorum!
Dialogue: 0,0:11:29.87,0:11:31.87,Main,,0,0,0,,Hey, Hasır Şapka!
Dialogue: 0,0:11:33.33,0:11:36.41,Main,,0,0,0,,Adamlarımla ilgilenmiş gibi görünüyorsun.
Dialogue: 0,0:11:36.41,0:11:38.30,Main,,0,0,0,,Bu kez...
Dialogue: 0,0:11:38.30,0:11:40.31,Main,,0,0,0,,...usta marangoz olan Franky-sama,...
Dialogue: 0,0:11:40.31,0:11:43.30,Main,,0,0,0,,...senin süper dövüş gücün olacak!
Dialogue: 0,0:11:43.30,0:11:45.05,Main,,0,0,0,,İstediğini yap!
Dialogue: 0,0:11:45.05,0:11:49.27,Main,,0,0,0,,Hala Usopp konusunda sana kızgınım!
Dialogue: 0,0:11:49.72,0:11:52.56,Main,,0,0,0,,Ama yanı başında duruyor.
Dialogue: 0,0:11:53.64,0:11:55.49,Main,,0,0,0,,Cutty Flam...
Dialogue: 0,0:11:56.29,0:11:58.58,Main,,0,0,0,,Buna nasıl cüret edersin?
Dialogue: 0,0:12:00.12,0:12:02.32,Main,,0,0,0,,Planlarımı...
Dialogue: 0,0:12:11.74,0:12:14.21,Main,,0,0,0,,Ahh! Ağabey!
Dialogue: 0,0:12:14.79,0:12:19.17,Main,,0,0,0,,Ağabey şelaleye düşüyor!
Dialogue: 0,0:12:19.17,0:12:21.23,Main,,0,0,0,,Franky!
Dialogue: 0,0:12:21.23,0:12:22.88,Main,,0,0,0,,{\i1}Hey, korsanlar!{\i0}
Dialogue: 0,0:12:22.88,0:12:24.57,Main,,0,0,0,,Kokoro-{\i1}san?!{\i0}
Dialogue: 0,0:12:24.57,0:12:26.25,Main,,0,0,0,,{\i1}Her şeyi duyabiliyorum.{\i0}
Dialogue: 0,0:12:26.25,0:12:28.11,Main,,0,0,0,,{\i1}Ne diye oyalanıyorsunuz?{\i0}
Dialogue: 0,0:12:28.11,0:12:29.41,Main,,0,0,0,,Oyalanmak mı?
Dialogue: 0,0:12:29.41,0:12:31.35,Main,,0,0,0,,Ama daha köprünün yarısı indi.
Dialogue: 0,0:12:31.35,0:12:34.60,Main,,0,0,0,,Yarısı yeter de artar bile!
Dialogue: 0,0:12:34.60,0:12:36.81,Main,,0,0,0,,Dört saniye sonra orada olacağım.
Dialogue: 0,0:12:38.23,0:12:39.71,Main,,0,0,0,,Bu ne lan?!
Dialogue: 0,0:12:39.71,0:12:42.64,Main,,0,0,0,,Tüm kalbinizle şelaleye atlayın!
Dialogue: 0,0:12:42.64,0:12:45.16,Main,,0,0,0,,Hey, şu deminki...
Dialogue: 0,0:12:46.74,0:12:48.22,Main,,0,0,0,,Nine miydi?
Dialogue: 0,0:12:48.22,0:12:49.26,Main,,0,0,0,,Ne demek istedi?
Dialogue: 0,0:12:49.26,0:12:50.33,Main,,0,0,0,,Bilmiyorum.
Dialogue: 0,0:12:50.33,0:12:52.20,Main,,0,0,0,,Ama şelaleye atlayın dedi.
Dialogue: 0,0:12:59.13,0:13:00.77,Main,,0,0,0,,Deniz treni!
Dialogue: 0,0:13:00.77,0:13:02.53,Main,,0,0,0,,Niye Mahkeme Binası'nda?!
Dialogue: 0,0:13:04.09,0:13:07.11,Main,,0,0,0,,Chimney, çanı elinden geldiğince sert çal!
Dialogue: 0,0:13:07.11,0:13:08.43,Main,,0,0,0,,Tamam!
Dialogue: 0,0:13:11.92,0:13:13.52,Main,,0,0,0,,Deniz treni sesi?
Dialogue: 0,0:13:16.49,0:13:18.44,Main,,0,0,0,,O gülüş ne demek oluyor?
Dialogue: 0,0:13:18.79,0:13:19.95,Main,,0,0,0,,Yargıç!
Dialogue: 0,0:13:19.95,0:13:21.94,Main,,0,0,0,,Lütfen yoldan çekilin!
Dialogue: 0,0:13:23.11,0:13:25.15,Main,,0,0,0,,ORADA DUR!
Dialogue: 0,0:13:36.35,0:13:37.67,Main,,0,0,0,,Gidelim!
Dialogue: 0,0:13:38.20,0:13:40.00,Main,,0,0,0,,Biliyordum!
Dialogue: 0,0:13:43.92,0:13:45.88,Main,,0,0,0,,Hayır!
Dialogue: 0,0:13:48.02,0:13:50.99,Main,,0,0,0,,Roket Adam hala koşabilir!
Dialogue: 0,0:13:50.99,0:13:54.46,Main,,0,0,0,,Efsanevi gemi yapım şirketi, Tom'un İşçileri'ni...
Dialogue: 0,0:13:54.46,0:13:56.56,Main,,0,0,0,,...hafife almayın!
Dialogue: 0,0:14:00.44,0:14:01.94,Main,,0,0,0,,Roket Adam?!
Dialogue: 0,0:14:07.86,0:14:09.82,Main,,0,0,0,,UÇTU!
Dialogue: 0,0:14:24.13,0:14:25.40,Main,,0,0,0,,Ne?!
Dialogue: 0,0:14:25.40,0:14:27.59,Main,,0,0,0,,Geldiler!
Dialogue: 0,0:14:32.51,0:14:33.98,Main,,0,0,0,,Şelale!
Dialogue: 0,0:14:37.91,0:14:40.68,Thoughts,,0,0,0,,{\i1}Eski zamanlardaki gibi, Tom-san!{\i0}
Dialogue: 0,0:14:44.33,0:14:47.61,Flashbacks,,0,0,0,,Roger adında bir adama yardım ettiğim doğru...
Dialogue: 0,0:14:47.61,0:14:51.28,Flashbacks,,0,0,0,,...ve bundan gurur duyuyorum!
Dialogue: 0,0:14:51.28,0:14:52.37,Flashbacks,,0,0,0,,Ben Luffy.
Dialogue: 0,0:14:52.37,0:14:54.22,Flashbacks,,0,0,0,,Korsanlar Kralı olacak kişiyim.
Dialogue: 0,0:14:54.22,0:14:54.85,Flashbacks,,0,0,0,,Cidden mi?
Dialogue: 0,0:14:54.85,0:14:55.37,Flashbacks,,0,0,0,,Evet.
Dialogue: 0,0:14:56.81,0:14:59.29,Thoughts,,0,0,0,,{\i1}Roger da...{\i0}
Dialogue: 0,0:14:59.83,0:15:02.82,Thoughts,,0,0,0,,{\i1}...aptalın tekiydi, değil mi?{\i0}
Dialogue: 0,0:15:02.82,0:15:07.06,Thoughts,,0,0,0,,{\i1}Ve sen ona yardım ettin, değil mi?{\i0}
Dialogue: 0,0:15:07.06,0:15:08.99,Thoughts,,0,0,0,,{\i1}Ne tuhaftır ki,...{\i0}
Dialogue: 0,0:15:08.99,0:15:14.20,Thoughts,,0,0,0,,{\i1}...tüm Tom'un İşçileri ailesi, \Nşimdi Hasır Şapka'ya yardım ediyor.{\i0}
Dialogue: 0,0:15:16.74,0:15:20.73,Thoughts,,0,0,0,,{\i1}Sen de aynısını yapardın, değil mi Tom-san?
Dialogue: 0,0:15:29.54,0:15:31.54,Main,,0,0,0,,Duvara çarpacağız!
Dialogue: 0,0:15:31.54,0:15:34.07,Main,,0,0,0,,Ezileceğiz!
Dialogue: 0,0:15:50.16,0:15:51.80,Main,,0,0,0,,Kaçın!
Dialogue: 0,0:16:07.17,0:16:08.32,Main,,0,0,0,,Geldiler....
Dialogue: 0,0:16:08.32,0:16:09.81,Main,,0,0,0,,Geldiler!
Dialogue: 0,0:16:09.81,0:16:11.21,Main,,0,0,0,,Lanet olsun!
Dialogue: 0,0:16:11.21,0:16:12.68,Main,,0,0,0,,Hey, gel bakalım!
Dialogue: 0,0:16:15.02,0:16:18.24,Thoughts,,0,0,0,,{\i1}Şu Deniz Taşı kelepçeleri açabilseydim...{\i0}
Dialogue: 0,0:16:20.58,0:16:24.00,Main,,0,0,0,,Artık istediğinizi yapabilirsiniz, CP9!
Dialogue: 0,0:16:24.68,0:16:28.27,Main,,0,0,0,,Onları bu Adalet Kulesi'nde yok edin!
Dialogue: 0,0:16:30.47,0:16:32.97,Main,,0,0,0,,Size onları öldürme izni veriyorum!
Dialogue: 0,0:16:32.97,0:16:35.48,Main,,0,0,0,,Lucci! Benimle gel!
Dialogue: 0,0:16:35.48,0:16:37.93,Main,,0,0,0,,Her şey bir yana, önce beni korumalısın!
Dialogue: 0,0:16:37.93,0:16:39.28,Main,,0,0,0,,Anladın mı?!
Dialogue: 0,0:16:39.28,0:16:40.92,Main,,0,0,0,,Funkfreed!
Dialogue: 0,0:16:52.86,0:16:54.88,Main,,0,0,0,,İyi çocuk.{\an8}
Dialogue: 0,0:16:54.20,0:16:57.87,Captions,,0,0,275,,Fil Kılıcı\NFunkfreed\NFil-Fil Meyvesi{\fad(500,0)}
Dialogue: 0,0:16:58.29,0:17:02.64,Main,,0,0,0,,CP9'un yanısıra, özellikle seçilmiş bu kılıcım var.
Dialogue: 0,0:17:02.77,0:17:06.47,Main,,0,0,0,,Sakince düşünürsem, korkacak bir şeyim yok.
Dialogue: 0,0:17:06.47,0:17:08.96,Main,,0,0,0,,Şimdi, Adalet Kapıları'na gidelim.
Dialogue: 0,0:17:08.96,0:17:12.84,Main,,0,0,0,,Bu kadını geri alabileceğinizi düşünüyorsanız,\Ndeneyin bakalım Hasır Şapkalar!
Dialogue: 0,0:17:13.57,0:17:15.36,Main,,0,0,0,,Franky Ağabey iyi!
Dialogue: 0,0:17:15.36,0:17:19.04,Main,,0,0,0,,Hasır Şapka-san nihayet Adalet Kulesi'ne ulaştı!
Dialogue: 0,0:17:19.04,0:17:21.31,Main,,0,0,0,,Ağabey artık tutsak değil!
Dialogue: 0,0:17:21.31,0:17:23.12,Main,,0,0,0,,Görünüşe göre dövüşe katılıyor!
Dialogue: 0,0:17:23.12,0:17:25.42,Main,,0,0,0,,Evet, o böyle biri!
Dialogue: 0,0:17:25.42,0:17:27.98,Main,,0,0,0,,Hakla onları, Ağabey!
Dialogue: 0,0:17:27.98,0:17:30.73,Main,,0,0,0,,Hasır Şapka, elinden geleni yap!
Dialogue: 0,0:17:31.23,0:17:33.49,Main,,0,0,0,,Gerisini size bırakıyoruz, Hasır Şapka.
Dialogue: 0,0:17:36.85,0:17:38.78,Main,,0,0,0,,Hey, iyi misiniz?
Dialogue: 0,0:17:38.78,0:17:40.79,Main,,0,0,0,,Yaşlı kadın Kokoro? Ufaklıklar?
Dialogue: 0,0:17:40.79,0:17:42.66,Main,,0,0,0,,Siz niye buradasınız?
Dialogue: 0,0:17:42.66,0:17:46.44,Main,,0,0,0,,Roket Adam gibi \Nçok tehlikeli bir şeyi getirmişsiniz!
Dialogue: 0,0:17:46.44,0:17:48.83,Main,,0,0,0,,Gerçi bu sayede kurtulduk.
Dialogue: 0,0:17:48.83,0:17:51.00,Main,,0,0,0,,Hey! Hey, yaşlı kadın! Kendine gel!
Dialogue: 0,0:17:51.00,0:17:53.70,Main,,0,0,0,,Hey, lütfen! Ölme, olur mu?!
Dialogue: 0,0:17:53.70,0:17:55.79,Main,,0,0,0,,ÖLME!
Dialogue: 0,0:18:08.05,0:18:09.45,Main,,0,0,0,,Burnumuz kanadı.
Dialogue: 0,0:18:09.45,0:18:13.13,Main,,0,0,0,,Sadece burun kanamasından fazlası olmalı!
Dialogue: 0,0:18:13.13,0:18:15.41,Main,,0,0,0,,İşte geldik!
Dialogue: 0,0:18:16.86,0:18:17.86,Main,,0,0,0,,Hasır Şapka...!
Dialogue: 0,0:18:17.86,0:18:19.13,Main,,0,0,0,,Hey!
Dialogue: 0,0:18:19.13,0:18:21.57,Main,,0,0,0,,Sağol, Canavar nine!
Dialogue: 0,0:18:21.57,0:18:24.31,Main,,0,0,0,,Hey, çocuklar! Hemen kalkın!
Dialogue: 0,0:18:24.31,0:18:25.99,Main,,0,0,0,,Bu ne ki?!
Dialogue: 0,0:18:26.67,0:18:29.40,Main,,0,0,0,,Bizi kendin gibi bir lastik adamla mukayese etme.
Dialogue: 0,0:18:29.40,0:18:32.90,Main,,0,0,0,,Bizim gibi etten ve kemikten ibaret olan insanların \Nböyle bir giriş yaptıktan sonra...
Dialogue: 0,0:18:32.90,0:18:34.67,Main,,0,0,0,,...iyi olması mümkün değil.
Dialogue: 0,0:18:40.61,0:18:42.14,Main,,0,0,0,,Herkes iyi.
Dialogue: 0,0:18:42.14,0:18:44.85,Main,,0,0,0,,Siz de biraz tuhafsınız!
Dialogue: 0,0:18:44.85,0:18:46.64,Main,,0,0,0,,Bilin diye söylüyorum.
Dialogue: 0,0:18:46.64,0:18:48.30,Main,,0,0,0,,Orada merdivenler var!
Dialogue: 0,0:18:48.30,0:18:50.20,Main,,0,0,0,,Hemen Robin'i geri alalım!
Dialogue: 0,0:18:57.74,0:18:58.90,Main,,0,0,0,,Durun.
Dialogue: 0,0:19:00.93,0:19:02.07,Main,,0,0,0,,O da ne öyle?!
Dialogue: 0,0:19:02.07,0:19:03.99,Main,,0,0,0,,Chapapapa...
Dialogue: 0,0:19:03.99,0:19:06.40,Main,,0,0,0,,Saldırıya uğradık!
Dialogue: 0,0:19:06.40,0:19:08.52,Main,,0,0,0,,Son odaya gitseniz bile,...
Dialogue: 0,0:19:08.52,0:19:10.62,Main,,0,0,0,,...Nico Robin artık orada değil.
Dialogue: 0,0:19:10.62,0:19:13.37,Main,,0,0,0,,Lucci, onu çoktan Adalet Kapıları'na götürdü.
Dialogue: 0,0:19:14.41,0:19:16.90,Main,,0,0,0,,Ah, Şef de gitti.
Dialogue: 0,0:19:19.32,0:19:20.17,Main,,0,0,0,,Öyle mi?
Dialogue: 0,0:19:20.17,0:19:22.82,Main,,0,0,0,,Bu sağlam bilgi için sağol.
Dialogue: 0,0:19:22.82,0:19:25.43,Main,,0,0,0,,Chapapa... Onlara söyledim.
Dialogue: 0,0:19:25.87,0:19:27.64,Main,,0,0,0,,Ne tuhaf bir adam.
Dialogue: 0,0:19:27.64,0:19:28.80,Main,,0,0,0,,Neyse.
Dialogue: 0,0:19:28.80,0:19:30.92,Main,,0,0,0,,Şu an gittikleri yere...
Dialogue: 0,0:19:30.92,0:19:32.91,Main,,0,0,0,,...nasıl ulaşılacağını söylemeyeceğim.
Dialogue: 0,0:19:32.91,0:19:35.78,Main,,0,0,0,,Biz, CP9 buna izin vermeyeceğiz.
Dialogue: 0,0:19:35.78,0:19:39.74,Main,,0,0,0,,Sizi yok etme emri aldık, chapapa.
Dialogue: 0,0:19:39.74,0:19:41.61,Thoughts,,0,0,0,,{\i1}Yok etme emri mi?{\i0}
Dialogue: 0,0:19:41.61,0:19:47.82,Main,,0,0,0,,Nico Robin'i serbest bırakabilmek için \Nbizi geçmek zorundasınız.
Dialogue: 0,0:19:47.82,0:19:48.61,Main,,0,0,0,,Evet!
Dialogue: 0,0:19:48.61,0:19:51.29,Main,,0,0,0,,Bunu söylemenize gerek yok. Maksadımız bu zaten.
Dialogue: 0,0:19:51.29,0:19:52.44,Main,,0,0,0,,Chapapa...
Dialogue: 0,0:19:52.44,0:19:54.72,Main,,0,0,0,,Çok isteklisin!
Dialogue: 0,0:19:54.72,0:19:57.00,Main,,0,0,0,,Ama bir şey daha söylememe izin verin.
Dialogue: 0,0:19:57.00,0:19:59.02,Main,,0,0,0,,Neymiş?! İstediğini yap.
Dialogue: 0,0:19:59.02,0:20:01.87,Main,,0,0,0,,Sağol.
Dialogue: 0,0:20:01.87,0:20:03.72,Main,,0,0,0,,O zaman açıkça söyliyeyim.
Dialogue: 0,0:20:04.30,0:20:05.97,Main,,0,0,0,,Şuna bakın!
Dialogue: 0,0:20:05.97,0:20:07.40,Main,,0,0,0,,Anahtar?
Dialogue: 0,0:20:07.40,0:20:08.43,Main,,0,0,0,,O ne için?
Dialogue: 0,0:20:09.16,0:20:14.73,Main,,0,0,0,,Nico Robin'in Deniz Taşı kelepçelerini\Naçmak için gereken anahtar!
Dialogue: 0,0:20:14.73,0:20:16.08,Main,,0,0,0,,Deniz Taşı?
Dialogue: 0,0:20:16.08,0:20:19.39,Main,,0,0,0,,Şeytan Meyvesi yeteneklerini etkisiz kılan bir taş.
Dialogue: 0,0:20:19.39,0:20:22.45,Main,,0,0,0,,Denize düşmekle aynı etkiye sahip.
Dialogue: 0,0:20:22.93,0:20:26.08,Main,,0,0,0,,Demek Robin bu yüzden o kadar ürkekti.
Dialogue: 0,0:20:26.08,0:20:27.78,Main,,0,0,0,,Hem de o kadar güçlü olmasına rağmen.
Dialogue: 0,0:20:27.78,0:20:29.09,Main,,0,0,0,,Evet.
Dialogue: 0,0:20:29.09,0:20:30.73,Main,,0,0,0,,Normalde Robin-chan,...
Dialogue: 0,0:20:30.73,0:20:34.47,Main,,0,0,0,,...bu pislikler tarafından\Nyakalanacak kadar güçsüz olmazdı.
Dialogue: 0,0:20:34.47,0:20:36.42,Main,,0,0,0,,Acı verici olmalı.
Dialogue: 0,0:20:36.42,0:20:37.96,Main,,0,0,0,,Anlıyorum.
Dialogue: 0,0:20:37.96,0:20:42.26,Main,,0,0,0,,Nico Robin'i kurtarabilme ihtimalinize karşın...
Dialogue: 0,0:20:42.26,0:20:44.90,Main,,0,0,0,,...Deniz Taşı'nın elmas kadar \Nsert olduğunu söyleyeyim.
Dialogue: 0,0:20:44.90,0:20:48.43,Main,,0,0,0,,O kelepçeler asla çıkarılamaz.
Dialogue: 0,0:20:49.04,0:20:50.50,Main,,0,0,0,,Chapapa...
Dialogue: 0,0:20:50.50,0:20:52.02,Main,,0,0,0,,Onlara yine söyledim.
Dialogue: 0,0:20:52.46,0:20:54.35,Main,,0,0,0,,Gerçekten çok tuhaf biri.
Dialogue: 0,0:20:54.35,0:20:58.59,Main,,0,0,0,,Yine de sizin için farketmezse,\Ngidip Nico Robin'i kurtarın.
Dialogue: 0,0:20:58.59,0:21:01.03,Main,,0,0,0,,Chapapapapa!
Dialogue: 0,0:21:01.35,0:21:02.99,Main,,0,0,0,,O zaman...
Dialogue: 0,0:21:03.34,0:21:06.36,Main,,0,0,0,,...ONU BANA VER!
Dialogue: 0,0:21:10.17,0:21:12.91,Main,,0,0,0,,Görünüşe bakılırsa o da şu tekniği kullanabiliyor.
Dialogue: 0,0:21:13.35,0:21:14.96,Main,,0,0,0,,Panik yapmayın.
Dialogue: 0,0:21:15.31,0:21:18.56,Main,,0,0,0,,Henüz bunun \Ngerçek anahtar olup olmadığını söylemedim.
Dialogue: 0,0:21:18.56,0:21:20.97,Main,,0,0,0,,NE?!
Dialogue: 0,0:21:22.38,0:21:28.46,Main,,0,0,0,,Başka bir kelepçenin anahtarı olabilir!
Dialogue: 0,0:21:28.46,0:21:30.70,Main,,0,0,0,,Chapapa papa!
Dialogue: 0,0:21:31.39,0:21:33.81,Main,,0,0,0,,Bu kulede...
Dialogue: 0,0:21:33.81,0:21:38.63,Main,,0,0,0,,...benle birlikte beş CP9 üyesi var!
Dialogue: 0,0:21:38.63,0:21:42.25,Main,,0,0,0,,Her birimizde bir anahtar var...
Dialogue: 0,0:21:39.85,0:21:42.25,Secondary,,0,0,0,,Bir, iki, hadi!
Dialogue: 0,0:21:42.25,0:21:46.24,Main,,0,0,0,,...ve sizi bekliyoruz!
Dialogue: 0,0:21:42.25,0:21:44.69,Secondary,,0,0,0,,Bir, iki, dans et!
Dialogue: 0,0:21:46.24,0:21:49.33,Main,,0,0,0,,O zaman sizi yakalayıp anahtarınızı almazsak...
Dialogue: 0,0:21:49.33,0:21:51.54,Main,,0,0,0,,...ve Robin'in kelepçelerinde denemezsek,...
Dialogue: 0,0:21:51.54,0:21:53.83,Main,,0,0,0,,...gerçek olup olmadığını bilemeyecek miyiz?
Dialogue: 0,0:21:53.83,0:21:56.51,Main,,0,0,0,,Zaman kazanmak için ne aptalca bir yol.
Dialogue: 0,0:21:56.51,0:21:57.98,Main,,0,0,0,,Biz bunu yaparken...
Dialogue: 0,0:21:57.98,0:22:01.35,Main,,0,0,0,,...Robin-chan'ı götürmeyi planlıyorsunuz, değil mi?
Dialogue: 0,0:22:01.35,0:22:04.05,Main,,0,0,0,,Bu durumda öncelik Robin.
Dialogue: 0,0:22:04.05,0:22:08.81,Main,,0,0,0,,Önce Robin'in kendisini ele geçirmeliyiz.\NAnahtarlar sonraya kalabilir.
Dialogue: 0,0:22:08.81,0:22:11.23,Main,,0,0,0,,O aptalı boşverip acele edin.
Dialogue: 0,0:22:11.23,0:22:12.06,Main,,0,0,0,,Chapa!
Dialogue: 0,0:22:12.06,0:22:17.64,Note,,0,0,0,,O tuhaf
Dialogue: 0,0:22:12.54,0:22:13.90,Main,,0,0,0,,Chapapa!
Dialogue: 0,0:22:13.90,0:22:16.28,Main,,0,0,0,,Akıllı birisin!
Dialogue: 0,0:22:16.28,0:22:18.57,Main,,0,0,0,,Ama böyle yaparsanız,...
Dialogue: 0,0:22:18.57,0:22:23.61,Main,,0,0,0,,...bu anahtarı okyanusa atacağım, chapapa!
Dialogue: 0,0:22:25.61,0:22:28.39,Main,,0,0,0,,Size bir fırsat tanıyoruz.
Dialogue: 0,0:22:28.39,0:22:28.95,Main,,0,0,0,,Görüşürüz.
Dialogue: 0,0:22:29.46,0:22:31.53,Main,,0,0,0,,Hey! Dur biraz!
Dialogue: 0,0:22:31.53,0:22:32.74,Main,,0,0,0,,Hey, dur!
Dialogue: 0,0:22:33.64,0:22:35.89,Main,,0,0,0,,Niye sen beklemiyorsun?!
Dialogue: 0,0:22:36.91,0:22:39.34,Main,,0,0,0,,Biraz dur!
Dialogue: 0,0:22:39.34,0:22:42.68,Main,,0,0,0,,Her birimiz ayrı olarak \Nne yapacağımıza karar verene dek bekle!
Dialogue: 0,0:22:43.10,0:22:45.85,Main,,0,0,0,,Bırak beni! Bırakın!
Dialogue: 0,0:22:45.85,0:22:48.25,Main,,0,0,0,,Sakin ol, Hasır Şapka-kun.
Dialogue: 0,0:22:48.25,0:22:51.09,Secondary,,0,0,0,,Bırak beni!
Dialogue: 0,0:22:48.78,0:22:51.09,Main,,0,0,0,,Lucci, şu güvercinli adam mı?
Dialogue: 0,0:22:51.09,0:22:53.16,Main,,0,0,0,,Evet, o.
Dialogue: 0,0:22:53.16,0:22:55.97,Main,,0,0,0,,O adam ve Robin-chan birlikteyse,...
Dialogue: 0,0:22:56.57,0:22:59.23,Main,,0,0,0,,...Luffy'yi önden onların peşinden göndermeliyiz.
Dialogue: 0,0:22:59.23,0:23:00.42,Main,,0,0,0,,Luffy.
Dialogue: 0,0:23:00.42,0:23:02.98,Main,,0,0,0,,Önden git ve o güvercinli adamın işini bitir.
Dialogue: 0,0:23:02.98,0:23:05.50,Main,,0,0,0,,Bırakın beni! Bırakın!
Dialogue: 0,0:23:05.50,0:23:08.38,Main,,0,0,0,,Luffy hariç altı kişiyiz.
Dialogue: 0,0:23:08.38,0:23:11.26,Main,,0,0,0,,Buradaki beş CP9 üyesinden...
Dialogue: 0,0:23:11.26,0:23:15.14,Main,,0,0,0,,...Robin-chan'ın kelepçesini açabilecek olan \Nbeş anahtarı alacağız ve Luffy'nin peşinden gideceğiz.
Dialogue: 0,0:23:16.40,0:23:19.02,Main,,0,0,0,,Robin-kun kapılardan geçerse, her şey biter!
Dialogue: 0,0:23:19.02,0:23:21.62,Main,,0,0,0,,Her şey zamana karşı bir yarış!
Dialogue: 0,0:23:21.62,0:23:23.92,Main,,0,0,0,,Yenilmek zaman kaybı!
Dialogue: 0,0:23:26.75,0:23:28.88,Main,,0,0,0,,Bu uğurda ölseniz bile herkes kazanmalı!
Dialogue: 0,0:23:28.88,0:23:29.99,Main,,0,0,0,,Tamam!
Dialogue: 0,0:23:29.99,0:23:32.84,Main,,0,0,0,,Elinizden geleni yapın!
Dialogue: 0,0:23:33.37,0:23:37.10,Main,,0,0,0,,Hadi korsan abiler!
Dialogue: 0,0:23:41.67,0:23:43.80,Main,,0,0,0,,Chimney? Gonbe?
Dialogue: 0,0:23:43.80,0:23:45.90,Main,,0,0,0,,Nereye gitti bunlar?
Dialogue: 0,0:23:45.90,0:23:48.94,Main,,0,0,0,,Demin oradaydılar!
Dialogue: 0,0:23:49.32,0:23:51.24,Main,,0,0,0,,Bir yerlerde kesinlikle onlara rastlayacağım!
Dialogue: 0,0:23:51.24,0:23:54.62,Main,,0,0,0,,Adalet Kapıları'na ulaşmanıza izin vermiyorum!
Dialogue: 0,0:23:54.62,0:23:57.24,Main,,0,0,0,,Robin!
Dialogue: 0,0:24:00.05,0:24:02.08,Main,,0,0,0,,Sana yardım gelmiyor, Nico Robin.
Dialogue: 0,0:24:04.42,0:24:09.12,Main,,0,0,0,,Öncelikle Adalet Kapıları'na\Nnasıl ulaşacaklarını bilmiyorlar.
Dialogue: 0,0:24:14.97,0:24:17.81,Main,,0,0,0,,Çık ortaya! Güvercinli pislik!
Dialogue: 0,0:24:17.81,0:24:20.31,Main,,0,0,0,,Durum kötü! Dövüşmeden önce...
Dialogue: 0,0:24:20.31,0:24:22.85,Main,,0,0,0,,Mutfak nerede?
Dialogue: 0,0:24:22.89,0:24:24.85,Flashbacks,,0,0,0,,Osuruk Vuruşu!{\fad(150,150)}
Dialogue: 0,0:24:26.75,0:24:29.54,Main,,0,0,0,,Osuruk Vuruşu bir buçuk şişe kola kullanıyor.
Dialogue: 0,0:24:29.54,0:24:32.36,Main,,0,0,0,,Bugün zaten iki şişeden fazla kullandım.
Dialogue: 0,0:24:32.71,0:24:36.28,Main,,0,0,0,,Üç şişe dolu lazım, yoksa CP9'la dövüşemem!
Dialogue: 0,0:24:38.08,0:24:40.04,Main,,0,0,0,,O oda! Mutfak gibi görünüyor!
Dialogue: 0,0:24:46.77,0:24:50.36,Main,,0,0,0,,Chapapapapa...
Dialogue: 0,0:24:50.36,0:24:54.13,Main,,0,0,0,,Ben, dedikodu seven Sessiz Baykuş.
Dialogue: 0,0:24:54.57,0:24:56.10,Main,,0,0,0,,Anahtarımı istiyor musun?
Dialogue: 0,0:24:56.10,0:24:57.11,Main,,0,0,0,,Kahretsin!
Dialogue: 0,0:24:57.11,0:24:58.85,Main,,0,0,0,,Kolamı doldurmadan önce olmaz!
Dialogue: 0,0:24:58.85,0:25:00.36,Main,,0,0,0,,Chapa...!
Dialogue: 0,0:25:12.68,0:25:14.52,Main,,0,0,0,,Tanrıya şükür.
Dialogue: 0,0:25:18.21,0:25:19.43,Main,,0,0,0,,Burada kimse yok.
Dialogue: 0,0:25:21.75,0:25:23.16,Main,,0,0,0,,İyi, burada da yok.
Dialogue: 0,0:25:25.59,0:25:26.87,Main,,0,0,0,,Etrafta hiç kimse yok.
Dialogue: 0,0:25:27.73,0:25:31.26,Thoughts,,0,0,0,,Neler oluyor?\NHiçbir yerde kimseyi bulamıyorum!
Dialogue: 0,0:25:31.26,0:25:33.40,Thoughts,,0,0,0,,Evet, kimse olmaması iyi ama...
Dialogue: 0,0:25:38.79,0:25:40.88,Main,,0,0,0,,Anlıyorum, demek benden korkuyorsun!
Dialogue: 0,0:25:40.88,0:25:42.97,Main,,0,0,0,,Ahhh...!
Dialogue: 0,0:25:43.36,0:25:44.93,Thoughts,,0,0,0,,Burada biri var!
Dialogue: 0,0:25:50.40,0:25:51.97,Main,,0,0,0,,Uyuyor mu?
Dialogue: 0,0:25:52.75,0:25:54.70,Main,,0,0,0,,O da mı CP9 üyesi?
Dialogue: 0,0:25:56.33,0:26:00.12,Main,,0,0,0,,Anahtarı açıkta uyuyor!
Dialogue: 0,0:26:00.12,0:26:05.16,Main,,0,0,0,,Bu kadar fazla şanslı olmam mümkün mü?!\NBelki de büyük bir şans!
Dialogue: 0,0:26:06.91,0:26:10.84,Main,,0,0,0,,Bu zindan benzeri koridor.
Dialogue: 0,0:26:14.26,0:26:16.47,Main,,0,0,0,,Yoyoi!
Dialogue: 0,0:26:16.98,0:26:20.51,Main,,0,0,0,,Lanet olası korsan!
Dialogue: 0,0:26:20.51,0:26:26.23,Main,,0,0,0,,Nihayet burada, yüzüncü yılda karşılaştık!
Dialogue: 0,0:26:26.62,0:26:30.10,Main,,0,0,0,,Yavaş, yavaş!
Dialogue: 0,0:26:30.10,0:26:34.65,Main,,0,0,0,,Orada dur!
Dialogue: 0,0:26:36.69,0:26:37.99,Main,,0,0,0,,Yoyoi!
Dialogue: 0,0:26:42.45,0:26:44.08,Thoughts,,0,0,0,,{\i1}Çok gürültücü.{\i0}
Dialogue: 0,0:26:44.08,0:26:45.95,Main,,0,0,0,,Ya burası?!
Dialogue: 0,0:26:48.76,0:26:50.34,Main,,0,0,0,,Kahretsin...
Dialogue: 0,0:26:50.95,0:26:53.00,Main,,0,0,0,,Burada da kimse yok.
Dialogue: 0,0:27:01.63,0:27:03.60,Main,,0,0,0,,Lütfen rahatla ve keyfine bak.
Dialogue: 0,0:27:05.81,0:27:09.27,Main,,0,0,0,,Biraz çay içmeye ne dersin?
Dialogue: 0,0:27:23.79,0:27:25.87,Main,,0,0,0,,Lütfen!
Dialogue: 0,0:27:35.78,0:27:38.34,Main,,0,0,0,,Hemen kılıçlarını çektin mi?
Dialogue: 0,0:27:39.88,0:27:43.30,Main,,0,0,0,,Biraz kan tadı almak için ağlıyorlar.
Dialogue: 0,0:27:43.30,0:27:46.30,Credits,,0,0,0,,Editing:\NFeeso,\NGalaxy 9000\N\NTiming:\NGalaxy 9000\N\NQuality Assurance:\NFeeso,\NGalaxy 9000,\NGrug,\NPepperjack,\NSewil\N\NSoundtracking:\NHalee\N\NTitle & Infoboxes:\NDatenshi\N\NKaraoke:\NKaitouYahiko\N\NTranslation:\NCrunchyroll,\NGaijin
Dialogue: 0,0:00:00.71,0:00:03.37,Lyrics,,0,0,0,,{\fad(0,0)}♪ Koşmaya başlayalım, koşmaya başlayalım! ♪
Dialogue: 0,0:00:03.59,0:00:06.46,Lyrics,,0,0,0,,♪ Bayrağımızı süsleyip, gökyüzüne kaldırarak. ♪
Dialogue: 0,0:00:12.77,0:00:18.06,Lyrics,,0,0,0,,♪ Sonsuz okyanusu geçip aramaya gidelim. ♪
Dialogue: 0,0:00:18.86,0:00:21.81,Lyrics,,0,0,0,,♪ Henüz kimse tarafından...
Dialogue: 0,0:00:21.90,0:00:23.94,Lyrics,,0,0,0,,...bulunmamış bu dünyanın mucizesini. ♪
Dialogue: 0,0:00:24.82,0:00:27.96,Lyrics,,0,0,0,,♪ Çarpıp duran göğsümüzdeki...
Dialogue: 0,0:00:27.96,0:00:29.71,Lyrics,,0,0,0,,...aynı hislerle devam etmeliyiz. ♪
Dialogue: 0,0:00:29.71,0:00:35.59,Lyrics,,0,0,0,,♪ Hayaller peşinde koşanlar tarafından bırakılmış ayak izleri. ♪
Dialogue: 0,0:00:36.42,0:00:39.39,Lyrics,,0,0,0,,♪ Ne tür bir fırtınalı gece olursa olsun,...
Dialogue: 0,0:00:39.39,0:00:42.39,Lyrics,,0,0,0,,...kalplerimizin bir olmasını sağlarsak...
Dialogue: 0,0:00:42.39,0:00:46.54,Lyrics,,0,0,0,,{\fad(0,0)}...bu zorluğun üstesinden gelebileceğiz! ♪
Dialogue: 0,0:00:46.68,0:00:47.86,Lyrics,,0,0,0,,♪ Her zaman ♪
Dialogue: 0,0:00:48.76,0:00:51.59,Lyrics,,0,0,0,,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪
Dialogue: 0,0:00:51.72,0:00:54.55,Lyrics,,0,0,0,,{\fad(0,0)}♪ Bayrağımızı dalgalandırıp gökyüzüne kaldırarak. ♪
Dialogue: 0,0:00:54.60,0:00:57.14,Lyrics,,0,0,0,,♪ Kimseye göstermeyeceğiz. ♪
Dialogue: 0,0:00:57.23,0:01:00.58,Lyrics,,0,0,0,,{\fad(0,0)}♪ Gözlerimizde yaşlar olsa bile. ♪
Dialogue: 0,0:01:00.77,0:01:03.52,Lyrics,,0,0,0,,♪ Peşinden gidelim, peşinden gidelim! ♪
Dialogue: 0,0:01:03.69,0:01:06.52,Lyrics,,0,0,0,,♪ Hayallerimize giden doğru yolu...
Dialogue: 0,0:01:06.61,0:01:09.23,Lyrics,,0,0,0,,...gösteren pusulanın. ♪
Dialogue: 0,0:01:09.23,0:01:11.40,Lyrics,,0,0,0,,{\fad(0,0)}♪ Durmayacağız. ♪
Dialogue: 0,0:01:11.42,0:01:14.42,Lyrics,,0,0,0,,♪ Dünyayı dolaşarak...
Dialogue: 0,0:01:14.45,0:01:15.85,Lyrics,,0,0,0,,...yeniden başlayalım! ♪
Dialogue: 0,0:01:18.83,0:01:21.49,Lyrics,,0,0,0,,♪ Koşmaya başlayalım, koşmaya başlayalım! ♪
Dialogue: 0,0:01:21.80,0:01:24.54,Lyrics,,0,0,0,,♪ Hedefimize doğru herkesten daha fazla. ♪
Dialogue: 0,0:01:24.63,0:01:27.12,Lyrics,,0,0,0,,♪ Şimdi kaçmazsak,...
Dialogue: 0,0:01:27.22,0:01:30.54,Lyrics,,0,0,0,,{\fad(0,0)}...yarını sıkı sıkıya kavrayabileceğiz! ♪
Dialogue: 0,0:01:30.60,0:01:33.63,Lyrics,,0,0,0,,♪ Peşinden gidelim, peşinden gidelim! ♪
Dialogue: 0,0:01:33.68,0:01:36.51,Lyrics,,0,0,0,,♪ Gözlerinden yansıtılmış tüm şimdiki zamanın. ♪
Dialogue: 0,0:01:36.56,0:01:38.93,Lyrics,,0,0,0,,♪ Bembeyaz bir kalp...
Dialogue: 0,0:01:39.15,0:01:41.43,Lyrics,,0,0,0,,...bana tüm hikayeyi anlatacak! ♪
Dialogue: 0,0:01:41.73,0:01:44.43,Lyrics,,0,0,0,,♪ Yepyeni bir dünyada...
Dialogue: 0,0:01:44.53,0:01:45.83,Lyrics,,0,0,0,,...yeniden başlayalım! ♪
