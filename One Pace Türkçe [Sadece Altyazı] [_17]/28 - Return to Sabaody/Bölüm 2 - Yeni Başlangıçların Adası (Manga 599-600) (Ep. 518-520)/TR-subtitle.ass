0000,&H00000000,0,0,0,0,100,100,0,0,1,1.2,1.2,8,10,10,10,1Style: Author,Impress BT Pace,28.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1,1,9,10,10,10,1Style: Attack,Duality,45.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.7,1.7,7,12,12,12,1Style: Armored Me Main,FOT-KafuTechno Std E Strp,95,&H00FFFFFF,&H000000FF,&H00000000,&H78000000,-1,0,0,0,100,100,0,0,1,3.8,3.8,2,300,300,27,1Style: Captions-PTS,Gilroy-Bold,54.0,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,3,0,2,15,15,15,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 50,0:01:59.04,0:02:00.47,Main-207+,,0,0,0,,Çabuk ol.Dialogue: 50,0:02:00.47,0:02:02.21,Main-207+,,0,0,0,,Çabuk ol ve özür dile!Dialogue: 50,0:02:02.75,0:02:05.64,Main-207+,,0,0,0,,Ölümüne mi susamış bu adam?Dialogue: 50,0:02:06.96,0:02:13.73,Main-207+,,0,0,0,,Sanıyorum önümde ne kadar  pervasız davrandığının farkına varıyorsundur!Dialogue: 50,0:02:14.65,0:02:19.42,Main-207+,,0,0,0,,Korkudan dilini yutmanın  sebebi de bu olsa gerek.Dialogue: 50,0:02:19.42,0:02:20.72,Main-207+,,0,0,0,,Az evvel...Dialogue: 50,0:02:20.72,0:02:27.03,Main-207+,,0,0,0,,...uzun burunlu bir adam ve uzun saçları olan bir kadın, bize karşı çıkmaya cüret etti.Dialogue: 50,0:02:27.03,0:02:31.84,Main-207+,,0,0,0,,Bu durum kaptanı aptal durumuna düşürdü,  bu yüzden acele et ve özür dile.Dialogue: 50,0:02:32.55,0:02:34.24,Main-207+,,0,0,0,,Derhal yere kapan!Dialogue: 50,0:02:34.24,0:02:39.75,Main-207+,,0,0,0,,Yoksa bu küçücük hata hayatına mâl olacak.Dialogue: 50,0:02:39.75,0:02:43.88,Main-207+,,0,0,0,,Kaptanın eli tetikteyken sık kaşınır.Dialogue: 50,0:02:46.16,0:02:50.45,Main-207+,,0,0,0,,Dizlerinin üstüne çök artık! Uğraştığın kişi Hasır Şapkalı Luffy!Dialogue: 50,0:02:50.45,0:02:53.27,Main-207+,,0,0,0,,Öldürülmek mi istiyor o?! Af dile!Dialogue: 50,0:02:53.27,0:02:55.43,Main-207+,,0,0,0,,Gerçekten çok özür dilerim!Dialogue: 50,0:02:55.43,0:02:57.49,Main-207+,,0,0,0,,Ama biraz acelem var o yüzden...Dialogue: 50,0:02:58.86,0:03:01.30,Main-207+,,0,0,0,,Onun sorunu ne?Dialogue: 50,0:03:06.83,0:03:08.41,Main-207+,,0,0,0,,Pekala!Dialogue: 50,0:03:08.98,0:03:11.34,Main-207+,,0,0,0,,Buraya kadar!Dialogue: 50,0:03:50.19,0:03:53.58,Main-207+,,0,0,0,,Hey, o bir şeyler mi yaptı?Dialogue: 50,0:03:58.97,0:04:02.16,Main-207+,,0,0,0,,Denize gitmek istiyorum.  Balık avlamak istiyorum.Dialogue: 50,0:04:02.16,0:04:04.03,Main-207+,,0,0,0,,Yapamazsın seni bok beyinli!Dialogue: 50,0:04:04.03,0:04:08.97,Main-207+,,0,0,0,,Nedenmiş?  Ayrıca seni neden dinleyecekmişim?!Dialogue: 50,0:04:08.97,0:04:13.12,Main-207+,,0,0,0,,Seninle kendi isteğimle mi  yürüyorum sanıyorsun?!Dialogue: 50,0:04:13.12,0:04:17.41,Main-207+,,0,0,0,,Gezip de kaybolursan başıma  daha büyük bela açarsın!Dialogue: 50,0:04:17.41,0:04:18.64,Main-207+,,0,0,0,,Seni yosun kafalı!Dialogue: 50,0:04:18.64,0:04:23.01,Main-207+,,0,0,0,,Herkes yakında burada olacak  o yüzden benimle gemiye gel!Dialogue: 50,0:04:23.51,0:04:24.55,Main-207+,,0,0,0,,Dialogue: 50,0:04:26.35,0:04:28.05,Main-207+,,0,0,0,,Aman be.Dialogue: 50,0:04:29.27,0:04:33.19,Main-207+,,0,0,0,,Yedinci ne zamandan beri  birinciye patronluk taslar oldu.Dialogue: 50,0:04:33.19,0:04:36.33,Main-207+,,0,0,0,,Bizi neden buraya varış  sıralamamıza göre kıdemliyorsun?Dialogue: 50,0:04:36.33,0:04:40.90,Main-207+,,0,0,0,,Senin ilk gelen olman tesadüftü!  Sakın ola bu yüzden kafan karışmasın!Dialogue: 50,0:04:40.90,0:04:44.84,Main-207+,,0,0,0,,Evet, pardon benim hatam... yedinci numara.Dialogue: 50,0:04:44.84,0:04:46.97,Main-207+,,0,0,0,,Pekala, sen kaşındın!Dialogue: 50,0:04:47.97,0:04:50.67,Main-207+,,0,0,0,,İki yıl boyunca cehennemde  bacak antrenmanlarımı yaptım!Dialogue: 50,0:04:51.24,0:04:54.61,Main-207+,,0,0,0,,Hadi bakalım!  Seni güzelce ikiye doğrayacağım!Dialogue: 50,0:05:00.22,0:05:01.73,Main-207+,,0,0,0,,Kaptan...!Dialogue: 50,0:05:01.73,0:05:02.89,Main-207+,,0,0,0,,Kaptan Luffy!Dialogue: 50,0:05:04.11,0:05:05.49,Main-207+,,0,0,0,,Lanet olsun!Dialogue: 50,0:05:06.42,0:05:07.93,Main-207+,,0,0,0,,Luffy!Dialogue: 50,0:05:09.19,0:05:11.40,Main-207+,,0,0,0,,Sizi özlemişim çocuklar!Dialogue: 50,0:05:11.40,0:05:12.60,Main-207+,,0,0,0,,Hey!Dialogue: 50,0:05:12.60,0:05:14.80,Main-207+,,0,0,0,,Luffy!Dialogue: 50,0:05:13.90,0:05:14.80,Secondary-207+,,0,0,0,,Ne?Dialogue: 50,0:05:15.46,0:05:16.97,Main-207+,,0,0,0,,Franky!Dialogue: 50,0:05:16.42,0:05:16.97,Secondary-207+,,0,0,0,,He?Dialogue: 50,0:05:16.97,0:05:19.07,Main-207+,,0,0,0,,Nami!Dialogue: 50,0:05:18.30,0:05:19.07,Secondary-207+,,0,0,0,,He?!Dialogue: 50,0:05:21.84,0:05:25.11,Main-207+,,0,0,0,,S... Sogeking?!Dialogue: 50,0:05:24.56,0:05:25.11,Secondary-207+,,0,0,0,,Hm?Dialogue: 50,0:05:25.11,0:05:27.41,Main-207+,,0,0,0,,Harika!Dialogue: 50,0:05:27.41,0:05:30.71,Main-207+,,0,0,0,,İki yıl boyunca çok değişmişsiniz!Dialogue: 50,0:05:30.71,0:05:32.98,Main-207+,,0,0,0,,Eminim hepiniz güçlenmişsinizdir!Dialogue: 50,0:05:32.98,0:05:34.18,Main-207+,,0,0,0,,Dialogue: 50,0:05:34.18,0:05:36.30,Main-207+,,0,0,0,,Bunlar Hasır Şapkalar.Dialogue: 50,0:05:36.30,0:05:38.94,Main-207+,,0,0,0,,Sokakta ne yapıyorlar?Dialogue: 50,0:05:38.94,0:05:40.39,Main-207+,,0,0,0,,Şey... şöyle oldu, az önce...Dialogue: 50,0:05:40.39,0:05:45.33,Main-207+,,0,0,0,,Göz kontağından sakının.  Onlarla savaş başlatmak istemezsiniz.Dialogue: 50,0:05:46.67,0:05:48.46,Main-207+,,0,0,0,,L-lanet olsun!Dialogue: 50,0:05:48.46,0:05:50.71,Main-207+,,0,0,0,,Ne oldu sana?Dialogue: 50,0:05:51.30,0:05:52.47,Main-207+,,0,0,0,,Bilmiyorum!Dialogue: 50,0:05:53.27,0:05:55.71,Main-207+,,0,0,0,,Tüm vücudum buz kesti.Dialogue: 50,0:05:57.71,0:05:59.77,Main-207+,,0,0,0,,Ne tür bi numara yaptı öyle?Dialogue: 50,0:06:00.58,0:06:04.25,Main-207+,,0,0,0,,Oh, evet! Başka bir problemimiz daha var.Dialogue: 50,0:06:04.25,0:06:05.75,Main-207+,,0,0,0,,Şöyle ki, Cocoa–Dialogue: 50,0:06:05.75,0:06:07.32,Main-207+,,0,0,0,,Hayır, demek istediğim...Dialogue: 50,0:06:07.32,0:06:09.26,Main-207+,,0,0,0,,Nico Robin...Dialogue: 50,0:06:09.26,0:06:10.55,Main-207+,,0,0,0,,Ne dedin, Zoro?!Dialogue: 50,0:06:10.55,0:06:13.05,Main-207+,,0,0,0,,Nico Robin kaçırıldı mı?!Dialogue: 50,0:06:13.05,0:06:16.43,Main-207+,,0,0,0,,Özür dilerim. Gözümüzün önünde oldu.Dialogue: 50,0:06:16.43,0:06:19.00,Main-207+,,0,0,0,,Evet, bu doğru. İş çok ciddi, Luffy!Dialogue: 50,0:06:19.00,0:06:22.53,Main-207+,,0,0,0,,Kaçırılıp götürülüyor olabilir... tıpkı Camie gibi!Dialogue: 50,0:06:22.53,0:06:23.97,Main-207+,,0,0,0,,Ne...?Dialogue: 50,0:06:25.21,0:06:26.50,Main-207+,,0,0,0,,Kim yaptı?Dialogue: 50,0:06:26.50,0:06:29.72,Main-207+,,0,0,0,,Hiçbir fikrim yok.Dialogue: 50,0:06:29.72,0:06:30.84,Main-207+,,0,0,0,,Kaptan,Dialogue: 50,0:06:30.84,0:06:37.15,Main-207+,,0,0,0,,sanıyorum ki gerçek Nico Robin'den bir şeyler isteyen kişiler yanlışlıkla Cocoa'yı aldılar.Dialogue: 50,0:06:37.15,0:06:38.45,Main-207+,,0,0,0,,Evet olabilir.Dialogue: 50,0:06:39.46,0:06:44.32,Main-207+,,0,0,0,,Gerçek Robin'e o kadar çok benziyordu ki... Benzemesi aleyhimize oldu.Dialogue: 50,0:06:44.96,0:06:48.33,Main-207+,,0,0,0,,Hey fısırdamayı bırakın!Dialogue: 50,0:06:47.32,0:06:48.33,Secondary-207+,,0,0,0,,Ne?Dialogue: 50,0:06:49.99,0:06:52.23,Main-207+,,0,0,0,,Peki madem. Onu kendi haline bırakın.Dialogue: 50,0:06:52.23,0:06:54.00,Main-207+,,0,0,0,,Kaderi buymuş.Dialogue: 50,0:06:54.00,0:06:55.73,Main-207+,,0,0,0,,– Ne?! – Ne?! Tamamdır, Kaptan.Dialogue: 50,0:06:56.60,0:06:59.84,Main-207+,,0,0,0,,Hey, Luffy! Robin kaçırıldı!Dialogue: 50,0:07:01.00,0:07:04.55,Main-207+,,0,0,0,,Merak edip duruyorum,  bu yaratık da neyin nesi?Dialogue: 50,0:07:05.61,0:07:07.89,Main-207+,,0,0,0,,Şaka mıydı bu?Dialogue: 50,0:07:07.89,0:07:10.58,Main-207+,,0,0,0,,Bu konu hakkında şaka yapma!Dialogue: 50,0:07:10.58,0:07:13.32,Main-207+,,0,0,0,,Nasıl konuşabiliyor?  Doldurulmuş hayvan mı o?Dialogue: 50,0:07:13.32,0:07:15.15,Main-207+,,0,0,0,,Sözünü geri al, Luffy!Dialogue: 50,0:07:15.15,0:07:16.09,Main-207+,,0,0,0,,Kes be!Dialogue: 50,0:07:20.19,0:07:21.70,Main-207+,,0,0,0,,Unutun gitsin şu şeyi.Dialogue: 50,0:07:21.70,0:07:27.90,Main-207+,,0,0,0,,Benimle Koru 46'da bünyemize  kattığımız 100 kişiyle birlikte buluşun.Dialogue: 50,0:07:28.43,0:07:29.93,Main-207+,,0,0,0,,Şu uzun burunlu adam...Dialogue: 50,0:07:30.44,0:07:31.90,Main-207+,,0,0,0,,...ve turuncu saçlı kadın...Dialogue: 50,0:07:32.78,0:07:35.23,Main-207+,,0,0,0,,...bir de pelerinli ve  koca çantalı şu velet...Dialogue: 50,0:07:36.27,0:07:38.84,Main-207+,,0,0,0,,O üçünü bulun...Dialogue: 50,0:07:38.84,0:07:43.65,Main-207+,,0,0,0,,...ve Hasır Şapkalı Luffy'ye  karşı geldiklerine pişman edin!Dialogue: 50,0:07:43.65,0:07:45.05,Main-207+,,0,0,0,,– Derhal! – Derhal!Dialogue: 50,0:07:45.05,0:07:48.69,Main-207+,,0,0,0,,Onları buraya getirirken  öldürmemeye dikkat etmeliyiz.Dialogue: 50,0:07:48.69,0:07:52.89,Main-207+,,0,0,0,,Bu fırsatı Hasır Şapka'lara bulaşmanın  ne demek olduğunu göstermek için kullanalım!Dialogue: 50,0:07:52.89,0:07:54.19,Main-207+,,0,0,0,,Tamamdır, hadi gidelim!Dialogue: 50,0:07:54.19,0:07:56.63,Main-207+,,0,0,0,,Bekleyin bir dakika, çocuklar!Dialogue: 50,0:07:56.63,0:08:00.03,Main-207+,,0,0,0,,Şu geçtiğimiz iki yıl,  kişiliklerinizi bu kadar mı çarpıttı?!Dialogue: 50,0:08:00.03,0:08:01.43,Main-207+,,0,0,0,,Luffy?!Dialogue: 50,0:08:01.43,0:08:05.20,Main-207+,,0,0,0,,Ben... ben... çok üzgün hissediyorum...Dialogue: 50,0:08:05.20,0:08:07.24,Main-207+,,0,0,0,,Tek yapabildiğim ağlamak!Dialogue: 50,0:08:07.90,0:08:10.31,Main-207+,,0,0,0,,Yine mi, bu yaratık ne ya?Dialogue: 50,0:08:10.31,0:08:12.78,Main-207+,,0,0,0,,Robin'e ne olacak peki?Dialogue: 50,0:08:12.78,0:08:14.37,Main-207+,,0,0,0,,Neden hiçbir şey söylemiyorsunuz?Dialogue: 50,0:08:14.37,0:08:16.96,Main-207+,,0,0,0,,Nasıl?  Nasıl oluyor da konuşabiliyor?Dialogue: 50,0:08:16.96,0:08:19.38,Main-207+,,0,0,0,,Oyuncakları baya geliştirmişler!Dialogue: 50,0:08:19.38,0:08:23.42,Main-207+,,0,0,0,,Kahretsin! Sizi yanlış yargılamışım!Dialogue: 50,0:08:23.42,0:08:27.99,Main-207+,,0,0,0,,Yalnız yapmam gerekse de onu kurtaracağım!Dialogue: 50,0:08:31.33,0:08:34.77,Main-207+,,0,0,0,,Bekle beni, Robin!Dialogue: 50,0:08:37.23,0:08:38.37,Main-207+,,0,0,0,,Ne oldu?Dialogue: 50,0:08:38.37,0:08:40.25,Main-207+,,0,0,0,,Kendi aralarında mı kavga ediyorlar?Dialogue: 50,0:08:40.63,0:08:41.51,Main-207+,,0,0,0,,Bunlar onlar...Dialogue: 50,0:08:42.41,0:08:44.27,Main-207+,,0,0,0,,Hiç şüphe yok.Dialogue: 50,0:08:44.27,0:08:48.90,Main-207+,,0,0,0,,Hasır Şapka Korsanları iki yıl  öncesinden tamamen farklı gözükebilirler...Dialogue: 50,0:08:49.87,0:08:52.35,Main-207+,,0,0,0,,...ama hiç kimsenin bu kadar  tuhaf bir evcil hayvanı olamaz!Dialogue: 50,0:08:52.92,0:08:54.08,Main-207+,,0,0,0,,Onlar...Dialogue: 50,0:08:55.35,0:08:58.56,Main-207+,,0,0,0,,...Hasır Şapkalar! Yaşıyorlar!Dialogue: 50,0:08:59.76,0:09:05.53,Main-207+,,0,0,0,,Burası Koru 47. Korsan grubunu teşhis ettik. Bunlar Hasır Şapkalar!Dialogue: 50,0:09:09.71,0:09:13.74,Main-207+,,0,0,8,,Görünüşe göre, Hasır Şapkalar'ın bu adadan...Dialogue: 50,0:09:13.74,0:09:16.81,Main-207+,,0,0,0,,...tüm yanına çektiği korsanlar Koru 46'da toplanıyorlar!Dialogue: 0,0:09:13.74,0:09:16.81,Note,,0,0,0,,ACİL: TAYFA ARANIYORDialogue: 50,0:09:16.81,0:09:19.64,Main-207+,,0,0,0,,Anlaşıldı! Tamam!Dialogue: 50,0:09:19.64,0:09:23.48,Main-207+,,0,0,0,,Sivilleri derhal tahliye edin!Dialogue: 50,0:09:22.59,0:09:23.48,Secondary-207+,,0,0,0,,Anlaşıldı!Dialogue: 50,0:09:23.48,0:09:27.66,Main-207+,,0,0,0,,Korsanlar Koru 46'da toplanıyorlar!Dialogue: 50,0:09:27.66,0:09:31.15,Main-207+,,0,0,0,,Hedef Hasır Şapkalar! Kanunsuz bölgeye baskın yapıyoruz!Dialogue: 50,0:09:31.15,0:09:32.99,Main-207+,,0,0,0,,Aksiyona hazır olun!Dialogue: 50,0:09:32.99,0:09:37.76,Main-207+,,0,0,0,,Onları Koru 40, 42 ve 44'ten kıstırın!Dialogue: 50,0:09:37.76,0:09:40.10,Main-207+,,0,0,0,,G-1'den destek kuvvetleri yolda!Dialogue: 50,0:09:47.35,0:09:49.71,Main-207+,,0,0,0,,S-Sentomaru-san!Dialogue: 50,0:09:50.14,0:09:51.81,Main-207+,,0,0,0,,İlk ben gidiyorum!Dialogue: 50,0:09:52.35,0:09:56.11,Main-207+,,0,0,0,,Yanıma PX-5 ve PX-7'yi alıyorum!Dialogue: 50,0:09:56.11,0:09:59.62,Main-207+,,0,0,0,,Ne..? Pacifistaları mı konuşlandıracaksınız?Dialogue: 50,0:09:59.62,0:10:01.32,Main-207+,,0,0,0,,Elbette!Dialogue: 50,0:10:03.25,0:10:06.56,Main-207+,,0,0,0,,Hepiniz Hasır Şapkalar'ı küçümsüyorsunuz!Dialogue: 50,0:10:08.07,0:10:10.60,Main-207+,,0,0,0,,Savaş olduğundan beri iki yıl geçti.Dialogue: 50,0:10:10.60,0:10:12.90,Main-207+,,0,0,0,,Güçlenmiş olmalılar!Dialogue: 50,0:10:13.43,0:10:17.23,Main-207+,,0,0,0,,Normalde bu adaya uğrayan  çaylaklara hiç benzemezler!Dialogue: 50,0:10:20.51,0:10:21.63,Main-207+,,0,0,0,,İki yıl önce...Dialogue: 50,0:10:23.07,0:10:27.54,Main-207+,,0,0,0,,...Shichibukai Kuma'nın  yaptıkları hala gizemini koruyor.Dialogue: 50,0:10:30.63,0:10:35.39,Main-207+,,0,0,0,,Ancak, kişiliğini kaybettikten  sonraki davranışlarını gözlemledim.Dialogue: 50,0:10:35.39,0:10:41.86,Main-207+,,0,0,0,,Böylece Hasır Şapkaların bir gün burada tekrar buluşacağı sonucuna vardım.Dialogue: 50,0:10:42.19,0:10:44.03,Main-207+,,0,0,0,,Gidelim!Dialogue: 50,0:10:58.91,0:11:00.95,Main-207+,,0,0,0,,Robin!Dialogue: 50,0:11:02.87,0:11:05.62,Main-207+,,0,0,0,,Onu nereye götürdüler?!Dialogue: 50,0:11:06.52,0:11:11.89,Main-207+,,0,0,0,,Kahretsin! Kahretsin! Kahretsin! Kahretsin!Dialogue: 50,0:11:12.48,0:11:15.13,Main-207+,,0,0,0,,Herkese ne oldu?!Dialogue: 50,0:11:16.82,0:11:22.67,Main-207+,,0,0,0,,Luffy, Zoro, Nami, Sanji, Franky...Dialogue: 50,0:11:22.67,0:11:25.65,Main-207+,,0,0,0,,Ne kadar şevkatliydiler!Dialogue: 50,0:11:26.40,0:11:29.64,Main-207+,,0,0,0,,Robin kaçırıldı ve tek  söylediği "kendi haline bırakın" mı?Dialogue: 50,0:11:31.74,0:11:34.22,Main-207+,,0,0,0,,Bu çok zalimce!Dialogue: 50,0:11:34.22,0:11:38.01,Main-207+,,0,0,0,,Sadece... ben ne diye geçtiğimiz  iki yıl boyunca bu kadar çalıştım?!Dialogue: 50,0:11:39.53,0:11:41.12,Main-207+,,0,0,0,,Ve kim için?Dialogue: 50,0:11:44.58,0:11:46.49,Main-207+,,0,0,0,,Hey, Chopper!Dialogue: 50,0:11:46.49,0:11:47.86,Main-207+,,0,0,0,,Hey!Dialogue: 50,0:11:51.04,0:11:52.23,Main-207+,,0,0,0,,Buraya bak!Dialogue: 50,0:11:53.61,0:11:55.63,Main-207+,,0,0,0,,Onun Chopper olduğunu biliyordum!Dialogue: 50,0:11:59.20,0:12:00.96,Main-207+,,0,0,0,,Usopp!Dialogue: 50,0:12:00.96,0:12:04.10,Main-207+,,0,0,0,,Vay be, ne kadar büyümüşsün!Dialogue: 50,0:12:04.10,0:12:06.94,Main-207+,,0,0,0,,Eminim artık seni sürmek çok rahattır!Dialogue: 50,0:12:06.94,0:12:08.28,Main-207+,,0,0,0,,İyi misin?Dialogue: 50,0:12:08.28,0:12:09.15,Main-207+,,0,0,0,,Evet!Dialogue: 50,0:12:09.15,0:12:13.28,Main-207+,,0,0,0,,Haklı!  Eskisinden daha yumuşacıksın!Dialogue: 50,0:12:13.28,0:12:14.65,Main-207+,,0,0,0,,He?Dialogue: 50,0:12:14.65,0:12:16.79,Main-207+,,0,0,0,,Uzun zaman oldu, Chopper!Dialogue: 50,0:12:17.82,0:12:18.66,Main-207+,,0,0,0,,Sen?Dialogue: 50,0:12:20.99,0:12:22.07,Main-207+,,0,0,0,,Nami?Dialogue: 50,0:12:22.07,0:12:22.93,Main-207+,,0,0,0,,Evet, benim.Dialogue: 50,0:12:24.59,0:12:25.70,Main-207+,,0,0,0,,Aa, doğru!Dialogue: 50,0:12:26.14,0:12:29.77,Main-207+,,0,0,0,,Sizi gördüğüme sevindim ama  zamanımız daralıyor!Dialogue: 50,0:12:29.77,0:12:31.97,Main-207+,,0,0,0,,Robin'in başı dertte!Dialogue: 50,0:12:37.31,0:12:39.94,Main-207+,,0,0,0,,Ne?  Onların sahtekar olduğunu mu söylüyorsun?Dialogue: 50,0:12:40.36,0:12:42.57,Main-207+,,0,0,0,,Bu yüzden mi iki Nami var?!Dialogue: 50,0:12:43.35,0:12:44.65,Main-207+,,0,0,0,,Lütfen!Dialogue: 50,0:12:45.53,0:12:49.29,Main-207+,,0,0,0,,Robin hükümetten 20 yıldır kaçıyor!Dialogue: 50,0:12:49.29,0:12:53.36,Main-207+,,0,0,0,,Onun öylece bi çuvala atılıp da  kolayca kaçırılması düşüncesi çok saçma.Dialogue: 50,0:12:53.88,0:12:54.91,Main-207+,,0,0,0,,Anladım!Dialogue: 50,0:12:54.91,0:12:57.63,Main-207+,,0,0,0,,Bir şeyler yanlış diye düşünmüştüm...Dialogue: 50,0:12:57.63,0:12:59.49,Main-207+,,0,0,0,,Tanıdık kokmuyordu bile!Dialogue: 50,0:13:01.50,0:13:03.76,Main-207+,,0,0,0,,Of, şu an çok sinirlendim!Dialogue: 50,0:13:03.76,0:13:07.37,Main-207+,,0,0,0,,Neler oluyor? Neden bizim gibi davransınlar ki?!Dialogue: 50,0:13:07.37,0:13:10.80,Main-207+,,0,0,0,,Nasıl olur da bizi taklit ederler!Dialogue: 50,0:13:10.80,0:13:12.88,Main-207+,,0,0,0,,Sanki bizler çok da...Dialogue: 50,0:13:12.88,0:13:14.81,Main-207+,,0,0,0,,çok da... çok da...Dialogue: 50,0:13:14.81,0:13:19.31,Main-207+,,0,0,0,,...sanki çok da mühim  kişilermişiz gibi, sersem şeyler!Dialogue: 50,0:13:19.31,0:13:21.57,Main-207+,,0,0,0,,Ne diye bu kadar mutlusun?Dialogue: 50,0:13:21.57,0:13:26.86,Main-207+,,0,0,0,,Yani, sanırım kaptanın şanını düşünürsek  bu tür sahtekarların varlığını kabullenmemiz gerek.Dialogue: 50,0:13:28.27,0:13:30.12,Main-207+,,0,0,0,,İmzamı nasıl atsam acaba...Dialogue: 50,0:13:30.12,0:13:32.46,Main-207+,,0,0,0,,Oh! Ben kendiminkini hazırladım bile!Dialogue: 50,0:13:32.46,0:13:36.77,Main-207+,,0,0,0,,Bunun iyi anlamda bir şöhret  olmadığının farkındasınız, değil mi?Dialogue: 50,0:13:42.07,0:13:45.02,Main-207+,,0,0,0,,Hey, Chopper!Dialogue: 50,0:13:46.15,0:13:47.81,Main-207+,,0,0,0,,Chopper!Dialogue: 50,0:13:47.81,0:13:53.22,Main-207+,,0,0,0,,Hay ya, tam da gerçek Hasır Şapkalar'ın evcil  hayvanına denk gelmiştik ama şimdi kaybettik!Dialogue: 50,0:13:54.55,0:13:56.09,Main-207+,,0,0,0,,Of! Yan tarafım acıyor!Dialogue: 50,0:13:56.22,0:13:58.02,Flashbacks-207+,,0,0,0,,Ne dedin sen?!Dialogue: 50,0:13:58.02,0:14:02.49,Flashbacks-207+,,0,0,0,,O tuhaf yaratık gerçek  Hasır Şapkalar'ın mıydı?!Dialogue: 50,0:14:02.95,0:14:04.83,Flashbacks-207+,,0,0,0,,Neden daha önce söylemedin?Dialogue: 50,0:14:04.83,0:14:06.82,Flashbacks-207+,,0,0,0,,Gidin ve onu geri getirin!Dialogue: 50,0:14:06.82,0:14:08.23,Flashbacks-207+,,0,0,0,,– Ne?! – Ne?!Dialogue: 50,0:14:08.30,0:14:12.44,Main-207+,,0,0,0,,Nereye bakmamız gerektiğini  bilmezsek onu asla bulamayız!Dialogue: 50,0:14:12.44,0:14:16.06,Main-207+,,0,0,0,,Onu tamamen kaybettik! Sabaody Takımadaları çok büyük!Dialogue: 50,0:14:16.06,0:14:17.94,Main-207+,,0,0,0,,Offff! Yan tarafım! Çok acıyor!Dialogue: 50,0:14:21.41,0:14:24.83,Main-207+,,0,0,0,,Daha fazla koşamayız! Hadi... sadece yürüyelim.Dialogue: 50,0:14:26.18,0:14:30.62,Main-207+,,0,0,0,,Hancock haklıymış. Bu bıyıklara ihtiyacım var.Dialogue: 50,0:14:30.62,0:14:32.72,Main-207+,,0,0,0,,Beladan uzak durmamı söyledi.Dialogue: 50,0:14:35.97,0:14:37.17,Main-207+,,0,0,0,,Hey! Bak!Dialogue: 50,0:14:37.17,0:14:40.00,Main-207+,,0,0,0,,Bu Kaptan'ın bahsettiği velet mi?Dialogue: 50,0:14:40.00,0:14:43.57,Main-207+,,0,0,0,,Velet mi sence o?  Daha çok neşeli bir yaşlı adama benziyor.Dialogue: 50,0:14:45.24,0:14:46.94,Main-207+,,0,0,0,,Oh? Sizler!Dialogue: 50,0:14:48.94,0:14:52.28,Main-207+,,0,0,0,,H-hey, kardeşim. Hadi biraz yürüyüşe çıkalım.Dialogue: 50,0:14:52.28,0:14:55.65,Main-207+,,0,0,0,,Sessizce gel ve beladan uzak durmuş ol.Dialogue: 50,0:14:55.65,0:15:00.62,Main-207+,,0,0,0,,Kaptanımız çok öfkeli. Uzun bir hayat yaşamaktan vazgeç.Dialogue: 50,0:15:01.65,0:15:04.47,Main-207+,,0,0,0,,Ne o?  Konuşamayacak kadar korktun mu?Dialogue: 50,0:15:04.47,0:15:07.45,Main-207+,,0,0,0,,Sen Sanji'sin değilsin, değil mi?Dialogue: 50,0:15:06.46,0:15:07.47,Secondary-207+,,0,0,0,,Ne?!Dialogue: 50,0:15:07.47,0:15:08.89,Main-207+,,0,0,0,,Sen de Zoro olmalısın.Dialogue: 50,0:15:08.89,0:15:12.42,Main-207+,,0,0,0,,Uzun zaman olmuştu çocuklar!Dialogue: 50,0:15:09.22,0:15:11.38,Secondary-207+,,0,0,0,,N-ne...?!Dialogue: 50,0:15:12.43,0:15:15.59,Main-207+,,0,0,0,,H-hey, uzun zaman olmuştu, değil mi?Dialogue: 50,0:15:15.59,0:15:17.87,Main-207+,,0,0,0,,E-evet! Hadi yola koyulalım!Dialogue: 50,0:15:17.87,0:15:20.59,Main-207+,,0,0,0,,Oh, herkes çoktan geldi mi?Dialogue: 50,0:15:20.59,0:15:23.83,Main-207+,,0,0,0,,Hepinizi beklettiğim için özür dilerim.Dialogue: 50,0:15:27.81,0:15:31.21,Main-207+,,0,0,0,,Sence bizi birileriyle  karıştırıyor olabilir mi?Dialogue: 50,0:15:31.21,0:15:32.90,Main-207+,,0,0,0,,Kimin umurunda!Dialogue: 50,0:15:32.90,0:15:35.12,Main-207+,,0,0,0,,Sadece onu Kaptan'a teslim etmeliyiz!Dialogue: 50,0:15:49.47,0:15:51.63,Main-207+,,0,0,0,,Burası Koru 46.Dialogue: 50,0:15:52.46,0:15:58.17,Main-207+,,0,0,0,,Daha da fazla çaylak  Hasır Şapkalar'a katılıp buraya geliyor.Dialogue: 50,0:15:58.17,0:16:01.51,Main-207+,,0,0,0,,Dört kaptan görüyorum.Dialogue: 50,0:16:01.51,0:16:04.55,Main-207+,,0,0,5,,92 Milyon Beli ödüllü...Dialogue: 50,0:16:04.55,0:16:06.05,Main-207+,,0,0,5,,"Sakatlanmış" Albion.Dialogue: 50,0:16:06.92,0:16:08.87,Main-207+,,0,0,5,,88 Milyon Beli ödüllü...Dialogue: 50,0:16:08.87,0:16:10.79,Main-207+,,0,0,5,,Lip "Hizmet" Doughty.Dialogue: 50,0:16:11.98,0:16:15.33,Main-207+,,0,0,0,,V-ve...bazı süper çaylaklar...Dialogue: 50,0:16:15.99,0:16:18.27,Main-207+,,0,0,5,,Caribou Korsanları'nın kaptanı.Dialogue: 50,0:16:18.27,0:16:20.63,Main-207+,,0,0,5,,210 Milyon Beli ödüllü...Dialogue: 50,0:16:20.63,0:16:22.57,Main-207+,,0,0,5,,"Yağlı Saç" Caribou!Dialogue: 50,0:16:23.26,0:16:25.55,Main-207+,,0,0,5,,Artı kardeşi ve yardımcı kaptanı.Dialogue: 50,0:16:25.55,0:16:27.98,Main-207+,,0,0,5,,190 Milyon Beli ödüllü...Dialogue: 50,0:16:27.98,0:16:30.21,Main-207+,,0,0,5,,"Kan Sıçratan" Coribou!Dialogue: 50,0:16:37.68,0:16:43.79,Secondary-207+,,0,0,0,,Tekrar! Tekrar! Tekrar! Tekrar!Dialogue: 50,0:16:43.79,0:16:49.59,Secondary-207+,,0,0,0,,Tekrar! Tekrar! Tekrar!Dialogue: 50,0:16:49.59,0:16:52.65,Main-207+,,0,0,0,,Anladım. Donanma, he?Dialogue: 50,0:16:53.50,0:16:54.56,Main-207+,,0,0,0,,Pekala.Dialogue: 50,0:16:49.59,0:16:54.56,Secondary-207+,,0,0,0,,Tekrar! Tekrar! Tekrar!Dialogue: 50,0:16:54.56,0:16:56.50,Main-207+,,0,0,0,,Zorlamayın!Dialogue: 50,0:16:56.50,0:16:58.74,Main-207+,,0,0,0,,Ruh Kralı! Bize geri dön!Dialogue: 50,0:16:54.56,0:16:58.74,Secondary-207+,,0,0,0,,Tekrar! Tekrar! Tekrar!Dialogue: 50,0:16:58.74,0:17:01.49,Main-207+,,0,0,0,,Biraz daha zamana ihtiyacım var.Dialogue: 50,0:17:01.49,0:17:04.71,Main-207+,,0,0,0,,Evet... hayranlarım tekrar çağrısı yapıyor...Dialogue: 50,0:16:58.74,0:17:04.71,Secondary-207+,,0,0,0,,Tekrar! Tekrar! Tekrar!Dialogue: 50,0:17:04.71,0:17:09.98,Secondary-207+,,0,0,0,,Tekrar! Tekrar! Tekrar!Dialogue: 50,0:17:09.98,0:17:14.52,Main-207+,,0,0,0,,...durmayacakları için, geri dönmeliyim.Dialogue: 50,0:17:09.98,0:17:14.52,Secondary-207+,,0,0,0,,Tekrar! Tekrar! Tekrar!Dialogue: 50,0:17:31.00,0:17:33.94,Main-207+,,0,0,0,,Beklediğiniz için teşekkürler, millet!Dialogue: 50,0:17:38.91,0:17:42.55,Main-207+,,0,0,0,,Buraya kadar! Gösteri bitti!Dialogue: 50,0:17:42.55,0:17:44.75,Main-207+,,0,0,0,,Donanma burada mı? Ama neden..?Dialogue: 50,0:17:44.75,0:17:50.25,Main-207+,,0,0,0,,Rumbar Korsanları'nın kaptan vekili:  "Mırıldanan Kılıç Ustası" Brook!Dialogue: 50,0:17:50.25,0:17:52.76,Main-207+,,0,0,0,,Ödül: 33 Milyon Beli!Dialogue: 50,0:17:52.76,0:17:56.49,Main-207+,,0,0,0,,Senin bu korsan olduğundan şüpheleniyoruz!Dialogue: 50,0:17:57.34,0:17:58.92,Main-207+,,0,0,0,,Dahası...Dialogue: 50,0:17:58.92,0:18:03.47,Main-207+,,0,0,0,,...elimizdeki istihbarata göre şu an aktif olarak  Hasır Şapka Korsanları tayfasının bir parçasısın!Dialogue: 50,0:18:03.47,0:18:05.67,Main-207+,,0,0,0,,Ruh Kralı Brook–Dialogue: 50,0:18:05.67,0:18:07.97,Main-207+,,0,0,0,,Daha doğrusu, korsan Brook...Dialogue: 50,0:18:07.97,0:18:10.73,Main-207+,,0,0,0,,...tutuklusun!Dialogue: 50,0:18:13.34,0:18:15.68,Main-207+,,0,0,0,,Bu olamaz...  Bizim sevgili Brook'umuz olamaz..!Dialogue: 50,0:18:15.68,0:18:17.88,Main-207+,,0,0,0,,Ruh Kralı bir suçlu mu?Dialogue: 50,0:18:17.88,0:18:19.63,Main-207+,,0,0,0,,O bir korsan mı?Dialogue: 50,0:18:19.63,0:18:22.69,Main-207+,,0,0,0,,Ama duyduğuma göre Hasır Şapkalı Luffy öldü!Dialogue: 50,0:18:23.45,0:18:26.39,Main-207+,,0,0,0,,Her şey bitti, Brook.Dialogue: 50,0:18:26.39,0:18:29.16,Main-207+,,0,0,0,,Bunun arkasında senin  olabileceğini düşünmüştüm...Dialogue: 50,0:18:29.82,0:18:31.16,Main-207+,,0,0,0,,Menajer.Dialogue: 50,0:18:31.16,0:18:35.16,Main-207+,,0,0,0,,Kuliste erken emeklilik  planlarından bahsettiğinde...Dialogue: 50,0:18:35.16,0:18:36.97,Main-207+,,0,0,0,,...bana büyük bir şok yaşattın.Dialogue: 50,0:18:36.97,0:18:42.21,Main-207+,,0,0,0,,Çok popüler olmuştun, birlikte tonla para kazanacaktık.Dialogue: 50,0:18:42.21,0:18:47.88,Main-207+,,0,0,0,,Bize ihanet ettiğinde küçük ticari girişimimiz de sona ermiş oldu.Dialogue: 50,0:18:50.38,0:18:54.12,Main-207+,,0,0,0,,Haydi birlikte ölelim, Ruh Kralı.Dialogue: 50,0:18:57.79,0:19:00.69,Main-207+,,0,0,5,,Çok güzel!Dialogue: 50,0:19:00.69,0:19:05.66,Main-207+,,0,0,0,,Değil mi?! Vücudu inanılmaz!Dialogue: 50,0:19:13.97,0:19:15.41,Main-207+,,0,0,0,,Tıpki bir robot gibisin!Dialogue: 50,0:19:15.41,0:19:17.91,Main-207+,,0,0,0,,Lazer fırlatabilir misin... ya da füze?!Dialogue: 50,0:19:17.91,0:19:19.91,Main-207+,,0,0,0,,Peki ya dönüşümler?Dialogue: 50,0:19:19.91,0:19:21.21,Main-207+,,0,0,0,,Doğal olarak!Dialogue: 50,0:19:21.21,0:19:23.81,Main-207+,,0,0,0,,Erkeklerin tutkularını, hayallerini...Dialogue: 50,0:19:23.81,0:19:26.75,Main-207+,,0,0,0,,...omuzlayan, eyleme geçiren şeye...Dialogue: 50,0:19:26.75,0:19:28.85,Main-207+,,0,0,0,,...dediğimiz o şeyim...Dialogue: 50,0:19:34.16,0:19:36.39,Main-207+,,0,0,0,,Robot! Robot!Dialogue: 50,0:19:36.39,0:19:39.46,Main-207+,,0,0,0,,Dizginle kendini Chopper! Bu kadar heyecan ölümcül olabilir!Dialogue: 50,0:19:42.78,0:19:44.42,Main-207+,,0,0,0,,Ancak, Franky...Dialogue: 50,0:19:44.42,0:19:47.90,Main-207+,,0,0,0,,...o koca ellerle hassas işler yapamazsın, değil mi?Dialogue: 50,0:19:50.47,0:19:51.91,Main-207+,,0,0,0,,Bir şey mi diyordun?Dialogue: 50,0:19:51.91,0:19:54.43,Main-207+,,0,0,0,,Şuna bak! El çıktı!Dialogue: 50,0:19:54.43,0:19:56.11,Main-207+,,0,0,0,,Elinin içinden el çıktı!Dialogue: 50,0:19:56.11,0:19:58.80,Secondary-207+,,0,0,0,,Harika! İşte Dönüşüm!Dialogue: 50,0:19:58.23,0:19:59.48,Main-207+,,0,0,0,,Robin!Dialogue: 50,0:20:00.62,0:20:01.52,Main-207+,,0,0,0,,Nami!Dialogue: 50,0:20:02.47,0:20:04.45,Main-207+,,0,0,0,,Harika görünüyorsun!Dialogue: 50,0:20:04.45,0:20:06.49,Secondary-207+,,0,0,0,,Dönüşüm! Dönüşüm!Dialogue: 50,0:20:06.49,0:20:09.79,Main-207+,,0,0,0,,Şu tuhafın vücudunun sorunu ne?Dialogue: 50,0:20:10.95,0:20:12.96,Main-207+,,0,0,0,,Bilmem. Ben anlayamıyorum.Dialogue: 50,0:20:14.20,0:20:16.50,Main-207+,,0,0,0,,Ah, kaplama bu mu?Dialogue: 50,0:20:16.50,0:20:19.44,Main-207+,,0,0,0,,Burnum. Burnuma bas.Dialogue: 50,0:20:19.44,0:20:20.24,Main-207+,,0,0,0,,Burnuna mı?Dialogue: 50,0:20:20.24,0:20:23.56,Main-207+,,0,0,0,,Basılı tut.  En az üç saniye kadar.Dialogue: 50,0:20:24.20,0:20:27.21,Main-207+,,0,0,0,,Lütfen burna en  az üç saniye kadar basınız.Dialogue: 50,0:20:27.21,0:20:29.61,Main-207+,,0,0,0,,Tekrar etti! Tıpkı bir robot gibi!Dialogue: 50,0:20:30.30,0:20:34.68,Main-207+,,0,0,0,,Çok heyecanlı... Çok heyecanlı... Çok heyecanlı...Dialogue: 50,0:20:32.27,0:20:34.68,Secondary-207+,,0,0,0,,Bir, iki, üç...Dialogue: 50,0:20:35.89,0:20:37.42,Main-207+,,0,0,0,,Vay! Saç!Dialogue: 50,0:20:37.42,0:20:39.93,Main-207+,,0,0,0,,Saç..!Dialogue: 50,0:20:40.82,0:20:42.29,Main-207+,,0,0,0,,Saçını değiştirebiliyor musun?Dialogue: 50,0:20:44.23,0:20:45.33,Main-207+,,0,0,0,,Tabii, yapabilirim.Dialogue: 50,0:20:45.33,0:20:48.06,Main-207+,,0,0,0,,– Vay vay! – Vay vay!Dialogue: 50,0:20:48.06,0:20:51.73,Main-207+,,0,0,0,,Oh, bu Nami! N'aber?Dialogue: 50,0:20:51.73,0:20:53.64,Main-207+,,0,0,0,,Yaa, selam...Dialogue: 50,0:20:53.64,0:20:56.11,Main-207+,,0,0,0,,İki yıl boyunca ne yapıyordu bu?Dialogue: 50,0:20:56.11,0:20:58.88,Main-207+,,0,0,0,,Silahlarını görebilir miyim? He, görebilir miyim?!Dialogue: 50,0:21:02.95,0:21:07.55,Main-207+,,0,0,0,,Sabırsızlanma! Asıl etkinlik o ya zaten. Luffy buraya gelene kadar bekleyin -meka.Dialogue: 50,0:21:07.55,0:21:09.19,Main-207+,,0,0,0,,Robot gibi hareket etti!Dialogue: 50,0:21:09.19,0:21:11.02,Main-207+,,0,0,0,,Sonuna "meka" ekledi!Dialogue: 50,0:21:13.95,0:21:14.96,Main-207+,,0,0,0,,Çocuklar.Dialogue: 50,0:21:16.03,0:21:17.93,Main-207+,,0,0,0,,Rayleigh-san! Shakky!Dialogue: 50,0:21:17.93,0:21:21.78,Main-207+,,0,0,0,,Buluşmanızı böldüğüm için kusuruma bakmayın, ama...Dialogue: 50,0:21:21.78,0:21:25.07,Main-207+,,0,0,0,,...takımadalar şu anda kargaşa içinde.Dialogue: 50,0:21:25.07,0:21:26.74,Main-207+,,0,0,0,,Korsan Brook!Dialogue: 50,0:21:27.26,0:21:31.17,Main-207+,,0,0,0,,Enstrümanını bırak  ve ellerini hayava kaldır!Dialogue: 50,0:21:32.41,0:21:33.44,Main-207+,,0,0,0,,Grup.Dialogue: 50,0:21:34.41,0:21:36.58,Main-207+,,0,0,0,,Back vokalciler ve dansçılar!Dialogue: 50,0:21:36.58,0:21:40.45,Main-207+,,0,0,0,,Beni bir şarkıda daha  desteklemenizi istiyorum.Dialogue: 50,0:21:44.42,0:21:46.32,Main-207+,,0,0,0,,Endişelenmeyin!Dialogue: 50,0:21:46.32,0:21:49.03,Main-207+,,0,0,0,,Müziğim artık güçlendi.Dialogue: 50,0:21:49.89,0:21:51.83,Main-207+,,0,0,0,,Delirdin mi sen?Dialogue: 50,0:21:51.83,0:21:54.03,Main-207+,,0,0,0,,Senin için artık her şey bitti, Brook.Dialogue: 50,0:21:54.03,0:21:58.00,Main-207+,,0,0,0,,Menajer, geçtiğimiz iki yıldaki  her şey için sana çok teşekkür ederim.Dialogue: 50,0:21:59.47,0:22:02.97,Main-207+,,0,0,0,,Beni bu takımadalara getirdiğin  için ektstra teşekkür ederim.Dialogue: 50,0:22:03.81,0:22:09.19,Main-207+,,0,0,0,,Bu ada, ezici yenilgimizin  hüzünlü anısını taşıyor...Dialogue: 50,0:22:09.19,0:22:11.31,Main-207+,,0,0,0,,...o yüzden burası tekrar  başladığımız yer olacak!Dialogue: 50,0:22:12.41,0:22:14.12,Main-207+,,0,0,0,,Ben bir müzisyenim.Dialogue: 50,0:22:14.12,0:22:19.19,Main-207+,,0,0,0,,Hasır Şapka tayfasındaki rolüm  macerayı biraz daha eğlenceli kılmak.Dialogue: 50,0:22:20.04,0:22:23.25,Main-207+,,0,0,0,,İnsanlar Hasır Şapkalı Luffy'nin  öldüğünü mü düşünüyor?Dialogue: 50,0:22:23.25,0:22:25.46,Main-207+,,0,0,0,,Bu saçmalık!Dialogue: 50,0:22:25.46,0:22:28.10,Main-207+,,0,0,0,,Bunu tüm dünyaya yayın:Dialogue: 50,0:22:28.10,0:22:31.53,Main-207+,,0,0,0,,Korsan Hasır Şapkalı Luffy...Dialogue: 50,0:22:31.53,0:22:34.20,Main-207+,,0,0,0,,...yaşıyor!Dialogue: 50,0:22:37.71,0:22:41.61,Main-207+,,0,0,0,,Bir gün, Dünya'nın denizlerine  korsanlar kral olarak hükmedecek!Dialogue: 50,0:22:41.61,0:22:45.31,Main-207+,,0,0,0,,Ana ofis mi..? Beni duyuyor musun? Haberler..! Büyük haberlerim var!Dialogue: 50,0:22:45.31,0:22:50.99,Main-207+,,0,0,0,,Ayrılışı sessiz bir ayrılış olmamalı! Oh, bebeğim!Dialogue: 50,0:22:52.59,0:22:54.02,Main-207+,,0,0,0,,Ruh Kralı!Dialogue: 50,0:22:54.02,0:22:58.63,Main-207+,,0,0,0,,Beni iliklerinize kadar sevin!Dialogue: 50,0:22:56.97,0:23:03.47,Secondary-207+,,0,0,0,,– Evet! – Evet!Dialogue: 50,0:23:00.37,0:23:03.47,Main-207+,,0,0,0,,Bu şarkıyı, canım arkadaşlarıma adıyorum.Dialogue: 50,0:23:03.47,0:23:07.04,Main-207+,,0,0,0,,Bu benim son ruhum... Dinleyin!Dialogue: 50,0:23:07.04,0:23:08.80,Main-207+,,0,0,0,,Evet!Dialogue: 50,0:23:08.80,0:23:12.11,Main-207+,,0,0,0,,Luffy-san, haydi Yeni Dünya'ya gidelim!Dialogue: 50,0:23:12.11,0:23:14.68,Main-207+,,0,0,0,,Seni ahmak! Dedim ki gösteri bi–Dialogue: 50,0:23:14.68,0:23:15.81,Main-207+,,0,0,0,,Kes sesini, Donanma!Dialogue: 50,0:23:18.28,0:23:20.65,Main-207+,,0,0,0,,İzin verin bir şarkı daha duyalım!Dialogue: 50,0:23:20.65,0:23:22.15,Main-207+,,0,0,0,,Şarkı söylemesine izin verin!Dialogue: 50,0:23:22.15,0:23:25.76,Main-207+,,0,0,0,,Evet, izin verin! Bizim için önemli olan tek şey onun Ruh Kralı olması!Dialogue: 50,0:23:26.47,0:23:29.69,Main-207+,,0,0,0,,Gördünüz mü?  Müzik her zaman sizin tarafınızdadır!Dialogue: 50,0:23:32.26,0:23:33.90,Main-207+,,0,0,0,,Bir, 'ki, üç dört...Dialogue: 50,0:23:36.17,0:23:37.83,Main-207+,,0,0,0,,"Yeni Dünya."Dialogue: 50,0:23:44.67,0:23:47.04,Main-207+,,0,0,5,,Burası Koru 46.Dialogue: 50,0:23:47.87,0:23:51.55,Main-207+,,0,0,5,,Burada en az 100 korsan var.Dialogue: 50,0:23:54.12,0:23:58.59,Main-207+,,0,0,0,,Eğer hepsi Hasır Şapkalı Luffy'nin  tayfasına katıldıysa, o halde bu tam bi ac–Dialogue: 50,0:24:03.19,0:24:05.33,Main-207+,,0,0,0,,Hey, sorun ne?! Cevap ver!Dialogue: 50,0:24:08.00,0:24:10.20,Main-207+,,0,0,0,,Bu iyi değil! Destek birliklerine acele etmelerini söyle!Dialogue: 50,0:24:11.63,0:24:14.57,Main-207+,,0,0,0,,Vay, vay vay...Dialogue: 50,0:24:14.57,0:24:19.48,Main-207+,,0,0,0,,Şüphelenmeye başlamıştım,  bu bir denizci olmasın!Dialogue: 50,0:24:19.48,0:24:21.94,Main-207+,,0,0,0,,Oyy!Dialogue: 50,0:24:21.94,0:24:25.35,Main-207+,,0,0,0,,Neler varmış burada?Dialogue: 50,0:24:29.84,0:24:34.57,Main-207+,,0,0,0,,Ah! Ah! Sakın deme...Dialogue: 50,0:24:35.73,0:24:40.66,Main-207+,,0,0,0,,Yoksa şu minik denizci  Donanma'ya haber mi yaydı?Dialogue: 50,0:24:42.13,0:24:43.76,Main-207+,,0,0,0,,Ne?Dialogue: 50,0:24:44.37,0:24:46.44,Main-207+,,0,0,0,,O bir Donanma askeri.Dialogue: 50,0:24:46.44,0:24:48.90,Main-207+,,0,0,0,,H-hayır, onları henüz çağırmadım!Dialogue: 50,0:24:48.90,0:24:50.67,Main-207+,,0,0,0,,Tam da...Dialogue: 50,0:24:50.67,0:24:55.24,Main-207+,,0,0,0,,Sakın ha. Sakın aklından bile geçirme.Dialogue: 50,0:24:55.24,0:25:00.07,Main-207+,,0,0,0,,Yoksa, her yer kan olacak...Dialogue: 50,0:25:00.07,0:25:03.52,Main-207+,,0,0,0,,Senin ve arkadaşlarının kanı!Dialogue: 50,0:25:03.52,0:25:06.36,Main-207+,,0,0,0,,Yanlış mıyım, Coribou?Dialogue: 50,0:25:06.36,0:25:09.73,Main-207+,,0,0,0,,Ha?  Çok üzgünüm, kardeşim, çok üzgünüm!Dialogue: 50,0:25:09.73,0:25:13.33,Main-207+,,0,0,0,,Buradayım, seni ahmak!Dialogue: 50,0:25:14.49,0:25:16.07,Main-207+,,0,0,0,,Özür dilerim.Dialogue: 50,0:25:16.07,0:25:17.47,Main-207+,,0,0,0,,Hala yanlış yön...Dialogue: 50,0:25:17.47,0:25:20.20,Main-207+,,0,0,0,,...seni aptal budala!Dialogue: 50,0:25:20.20,0:25:22.64,Main-207+,,0,0,0,,Denizci Katili Caribou...Dialogue: 50,0:25:48.30,0:25:51.83,Main-207+,,0,0,0,,Bu kadar eğlence yeter.Dialogue: 50,0:25:51.83,0:25:54.70,Main-207+,,0,0,0,,– Yaptı! – Şanının hakkını veriyor.Dialogue: 50,0:25:56.67,0:26:01.98,Main-207+,,0,0,0,,Oh, Tanrım! Merhamet et!Dialogue: 50,0:26:01.98,0:26:08.22,Main-207+,,0,0,0,,Bu ahmak Donanma askeri silahına  uzandı ve beni öldürmeye yeltendi!Dialogue: 50,0:26:08.22,0:26:11.42,Main-207+,,0,0,0,,Lütfen ona merhamet göster!Dialogue: 50,0:26:11.42,0:26:14.89,Main-207+,,0,0,0,,Üzgünüm, Tanrım! Çok üzgünüm!Dialogue: 50,0:26:16.01,0:26:18.33,Main-207+,,0,0,0,,Göm onu, Coribou!Dialogue: 50,0:26:18.33,0:26:23.43,Main-207+,,0,0,0,,Bu denizci bir günahkar... ve canlı gömülmeli!Dialogue: 50,0:26:23.43,0:26:24.20,Main-207+,,0,0,0,,Tamam!Dialogue: 50,0:26:24.20,0:26:26.06,Main-207+,,0,0,0,,Kazmalıyım, kazmalıyım...Dialogue: 50,0:26:26.06,0:26:29.87,Main-207+,,0,0,0,,B-b-bekle bir dakika! Bunu yapma!Dialogue: 50,0:26:29.87,0:26:31.87,Main-207+,,0,0,0,,Donanma'yı çağırmadım ben!Dialogue: 50,0:26:26.06,0:26:31.87,Secondary-207+,,0,0,0,,Bir delik kazıyorum, sadece kazıyorum...Dialogue: 50,0:26:31.87,0:26:33.81,Main-207+,,0,0,0,,Bu kadar yeter Caribou!Dialogue: 50,0:26:34.87,0:26:36.15,Main-207+,,0,0,0,,Oh?Dialogue: 50,0:26:36.15,0:26:41.62,Main-207+,,0,0,0,,Şu vasıfsız denizciyi  bir yerlere at gitsin.Dialogue: 50,0:26:42.89,0:26:45.82,Main-207+,,0,0,0,,Kaptan Hasır Şapkalı Luffy geliyor!Dialogue: 50,0:26:47.89,0:26:50.89,Main-207+,,0,0,0,,Etrafınıza bakın!Dialogue: 50,0:26:50.89,0:26:52.77,Main-207+,,0,0,0,,Muhtemelen birbirinizi bilmiyorsunuz...Dialogue: 50,0:26:52.77,0:26:55.49,Main-207+,,0,0,0,,...ama artık hepiniz  benim için çalışıyorsunuz...Dialogue: 50,0:26:56.40,0:26:59.24,Main-207+,,0,0,0,,...Hasır Şapka Korsanları'nın  tayfasının bir parçası olarak!Dialogue: 50,0:27:02.14,0:27:05.91,Main-207+,,0,0,0,,Bu demek oluyor ki,  ben korsanlar kralı olduğumda...Dialogue: 50,0:27:05.91,0:27:08.11,Main-207+,,0,0,0,,...bu da sizi kralın tayfasından yapar!Dialogue: 50,0:27:09.65,0:27:12.01,Main-207+,,0,0,0,,Bunu başarabilmek için, bundan sonra...Dialogue: 50,0:27:12.01,0:27:15.27,Main-207+,,0,0,0,,...bedeninizi ve ruhunuzu  bana adamak zorundasınız...Dialogue: 50,0:27:15.27,0:27:17.49,Main-207+,,0,0,0,,...ve hayatınızı savaşta riske atmalısınız!Dialogue: 50,0:27:19.16,0:27:23.19,Main-207+,,0,0,0,,Hayal gibi! Dünya Hükümeti'nin  üç üssünü de ele geçirdi...Dialogue: 50,0:27:23.19,0:27:27.03,Main-207+,,0,0,0,,...Enies Lobby, Impel Down  ve Donanma Karargâhı!Dialogue: 50,0:27:27.03,0:27:33.24,Main-207+,,0,0,0,,Böyle eşsiz bir korsanın emrinde  hizmet ettiğiniz için şanslısınız!Dialogue: 50,0:27:33.24,0:27:37.87,Main-207+,,0,0,0,,Korsanlar Kralı ünvanının en  güçlü adaylarından biri olacak!Dialogue: 50,0:27:37.87,0:27:40.21,Main-207+,,0,0,0,,Çoğunluğun üzerine atlasak iyi olur!Dialogue: 50,0:27:43.97,0:27:46.62,Main-207+,,0,0,0,,Vay be, katılım oldukça  yüksek gibi görünüyor.Dialogue: 50,0:27:46.62,0:27:48.22,Main-207+,,0,0,0,,Öyle mi?Dialogue: 50,0:27:48.22,0:27:50.85,Main-207+,,0,0,0,,Herkesi görmek için sabırsızlanıyorum.Dialogue: 50,0:27:55.56,0:27:57.86,Main-207+,,0,0,0,,Kesin sesinizi!Dialogue: 50,0:27:59.73,0:28:03.83,Main-207+,,0,0,0,,Burada toplanmanızı istedik çünkü...Dialogue: 50,0:28:03.83,0:28:09.97,Main-207+,,0,0,0,,Benim, sevgili patronunuzun,  onuruna leke sürüldü!Dialogue: 50,0:28:13.74,0:28:17.01,Main-207+,,0,0,0,,Sorumlular bu takımadalarda bir yerlerde!Dialogue: 50,0:28:17.01,0:28:21.48,Main-207+,,0,0,0,,Onları bulmanızı ve buraya  sürüklemenizi istiyorum!Dialogue: 50,0:28:22.50,0:28:24.85,Main-207+,,0,0,0,,Oldu bil, patron!Dialogue: 50,0:28:24.85,0:28:27.26,Main-207+,,0,0,0,,O ahmakları affetmeyeceğim!Dialogue: 50,0:28:29.02,0:28:31.96,Main-207+,,0,0,0,,Eh, iki yıl insanları  gerçekten değiştiriyor.Dialogue: 50,0:28:32.79,0:28:34.73,Main-207+,,0,0,0,,Artık ikiniz pek  konuşmuyorsunuz, değil mi?Dialogue: 50,0:28:35.66,0:28:40.94,Main-207+,,0,0,0,,Görünüşe göre bu bıyıklı adam  gerçek Hasır Şapkaları biliyor.Dialogue: 50,0:28:40.94,0:28:42.44,Main-207+,,0,0,0,,Kim ki o?Dialogue: 50,0:28:42.44,0:28:46.31,Main-207+,,0,0,0,,Bu konu beni aşar ama  çok konuşursak durumu ele veririz.Dialogue: 50,0:28:46.31,0:28:49.67,Main-207+,,0,0,0,,Tek yapmamız gereken onu kaptana götürmek.Dialogue: 50,0:28:49.67,0:28:50.41,Main-207+,,0,0,0,,Tamam.Dialogue: 50,0:28:50.41,0:28:53.78,Main-207+,,0,0,0,,İkinizin birbirinize karşı bu kadar  dost canlısı olduğunuzu hatırlamıyorum.Dialogue: 50,0:28:55.68,0:28:57.52,Main-207+,,0,0,0,,Eh, sonuçta iki yıl geçti.Dialogue: 50,0:28:59.29,0:29:01.29,Main-207+,,0,0,0,,Sizler de farklı gözüküyorsunuz.Dialogue: 50,0:29:01.29,0:29:02.63,Main-207+,,0,0,0,,Siz de mi kılık değiştirdiniz?Dialogue: 50,0:29:08.03,0:29:10.67,Main-207+,,0,0,0,,Hey, bekleyin!Dialogue: 50,0:29:10.67,0:29:12.40,Main-207+,,0,0,0,,Donanma mı?Dialogue: 50,0:29:12.40,0:29:16.58,Main-207+,,0,0,0,,Evet, o sahtekârların gerçek  Hasır Şapkalar olduğunu sanıyorlar...Dialogue: 50,0:29:16.58,0:29:19.11,Main-207+,,0,0,0,,...ve adaya bir baskın düzenlediler.Dialogue: 50,0:29:19.11,0:29:22.85,Main-207+,,0,0,0,,Hatlarına sızdım, dolayısıyla bir hata yok.Dialogue: 50,0:29:22.85,0:29:28.48,Main-207+,,0,0,0,,Brook ile Den Den Mushi  aracılığıyla görüştüm ve olanları anlattım.Dialogue: 50,0:29:28.48,0:29:30.79,Main-207+,,0,0,0,,Yakında buraya doğru yol alır.Dialogue: 50,0:29:30.79,0:29:34.16,Main-207+,,0,0,0,,Oh, yani bir yıldız olmayı bırakacak mı?Dialogue: 50,0:29:34.16,0:29:36.73,Main-207+,,0,0,0,,İşte gerçek bir erkek davranışı.Dialogue: 50,0:29:36.73,0:29:39.70,Main-207+,,0,0,0,,Nami-chan, rotacı sendin, değil mi?Dialogue: 50,0:29:39.70,0:29:43.58,Main-207+,,0,0,0,,Sana kaplamalı gemi nasıl sürülür  onu öğreteceğim, dikkatli dinle.Dialogue: 50,0:29:43.58,0:29:44.30,Main-207+,,0,0,0,,Tamam.Dialogue: 50,0:29:45.10,0:29:46.24,Main-207+,,0,0,0,,Elimden gelenin en iyisini yapacağım!Dialogue: 50,0:29:46.24,0:29:48.27,Main-207+,,0,0,0,,Oh, bu da ne?Dialogue: 50,0:29:48.27,0:29:50.17,Main-207+,,0,0,0,,Her şey paketlendi ve hazır.Dialogue: 50,0:29:50.17,0:29:53.68,Main-207+,,0,0,0,,Ama Rayleigh, Luffy henüz burada değil!Dialogue: 50,0:29:53.68,0:29:55.04,Main-207+,,0,0,0,,Endişelenme!Dialogue: 50,0:29:55.04,0:29:57.05,Main-207+,,0,0,0,,Kaptan!Dialogue: 50,0:29:57.05,0:29:57.71,Main-207+,,0,0,0,,He?Dialogue: 50,0:29:57.71,0:30:00.22,Main-207+,,0,0,0,,Bana "Büyük Patron" diyeceksin, ahmak!Dialogue: 50,0:30:00.22,0:30:07.56,Main-207+,,0,0,0,,Gerçek evcil hayvanı bulamadık ama  bu aradığın o diğer eleman değil mi?Dialogue: 50,0:30:08.86,0:30:10.06,Main-207+,,0,0,0,,Ah.Dialogue: 50,0:30:10.79,0:30:14.06,Main-207+,,0,0,0,,Luffy çoktan geldi.Dialogue: 50,0:30:18.17,0:30:19.44,Main-207+,,0,0,0,,Sabırsızlanıyorum!Dialogue: 50,0:30:19.44,0:30:23.91,Main-207+,,0,0,0,,Sanji'ye erkenden uğradığı vakitte  bebek Den Den Mushi vermiştim.Dialogue: 50,0:30:23.91,0:30:25.41,Main-207+,,0,0,0,,Şimdi Zoro ile birlikte.Dialogue: 50,0:30:25.41,0:30:27.64,Main-207+,,0,0,0,,Oh, bu harika.Dialogue: 50,0:30:27.64,0:30:32.01,Main-207+,,0,0,0,,Acele etmelisiniz. Donanma yakında burada olur.Dialogue: 50,0:30:32.01,0:30:35.95,Main-207+,,0,0,0,,Şu an sadece  Monkey-chan'a ulaşamıyoruz.Dialogue: 50,0:30:35.95,0:30:39.46,Main-207+,,0,0,0,,Ancak tayfa olarak bu vivre kartını  yanınızda bulundurmalısınız.Dialogue: 50,0:30:39.46,0:30:41.82,Main-207+,,0,0,0,,Onu doğruca size yönlendirecektir.Dialogue: 50,0:30:41.82,0:30:45.53,Main-207+,,0,0,0,,Koru 42 direk denizin yanında, gidiş için harika bir mekan.Dialogue: 50,0:30:45.53,0:30:48.46,Main-207+,,0,0,0,,Buluşacağınız yere doğru yelken açın.Dialogue: 50,0:30:49.20,0:30:53.17,Main-207+,,0,0,0,,Biraz telaşlı oldu ama  bu iki yılı atlattınız ve...Dialogue: 50,0:30:54.24,0:30:56.94,Main-207+,,0,0,0,,...nihayet yeni bir  başlangıç için zaman geldi!Dialogue: 0,0:01:53.30,0:01:58.64,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Zyrecon thx to onepace.netDialogue: 0,0:15:37.70,0:15:47.70,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Zyrecon thx to onepace.netDialogue: 0,0:31:08.00,0:31:14.40,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Zyrecon thx to onepace.netDialogue: 0,0:01:53.30,0:01:58.64,Title,,0,0,0,,Yeni Başlangıçların AdasıDialogue: 0,0:09:08.93,0:09:12.67,Captions-PTS,,0,0,0,,Donanma İstasyonu, Koru 66Dialogue: 1,0:09:08.93,0:09:12.67,Captions-PTS,,0,0,0,,Donanma İstasyonu, Koru 66Dialogue: 0,0:10:58.98,0:11:05.62,Captions-PTS,,0,0,0,,Sabaody Takımadaları Koru 35Dialogue: 1,0:10:58.98,0:11:05.62,Captions-PTS,,0,0,0,,Sabaody Takımadaları Koru 35Dialogue: 0,0:15:39.69,0:15:45.13,Captions-PTS,,0,0,0,,Hasır Şapka Buluşma Noktası, Koru 46Dialogue: 1,0:15:39.69,0:15:45.13,Captions-PTS,,0,0,0,,Hası