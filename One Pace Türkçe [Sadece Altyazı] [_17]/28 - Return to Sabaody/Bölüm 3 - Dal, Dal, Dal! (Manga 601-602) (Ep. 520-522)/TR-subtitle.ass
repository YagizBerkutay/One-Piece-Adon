Dialogue: 0,0:00:08.28,0:00:08.88,Rock Concert Main,,0,0,0,,♪ Oh, evet! ♪
Dialogue: 0,0:00:10.30,0:00:11.10,Rock Concert Main,,0,0,0,,♪ Çocuklar! ♪
Dialogue: 0,0:00:14.72,0:00:17.72,Rock Concert Main,,0,0,0,,♪ Bu bir kahramanın hikayesi. ♪
Dialogue: 0,0:00:18.72,0:00:21.79,Rock Concert Main,,0,0,0,,♪ Kral olacak adamın hikayesi. ♪
Dialogue: 0,0:00:22.66,0:00:25.96,Rock Concert Main,,0,0,0,,♪ Dövüşte ikinci şans yoktur. ♪
Dialogue: 0,0:00:26.26,0:00:29.73,Rock Concert Main,,0,0,0,,♪ Yine de ayağında sandaletten başka bir şey olmadan dimdik ayakta duruyor. ♪
Dialogue: 0,0:00:32.23,0:00:32.83,Rock Concert Main,,0,0,0,,♪ Oh, evet! ♪
Dialogue: 0,0:00:35.97,0:00:36.97,Rock Concert Main,,0,0,0,,♪ Hadi bebek! ♪
Dialogue: 0,0:00:44.95,0:00:47.75,Rock Concert Main,,0,0,0,,♪ Hayallerine ulaşanlar bazen...
Dialogue: 0,0:00:48.58,0:00:51.97,Rock Concert Main,,0,0,0,,...hayalleri çok uzakta göründüğü için endişelenmeli. ♪
Dialogue: 0,0:00:52.62,0:01:00.97,Rock Concert Main,,0,0,0,,♪ Sadece kendinle yüzleştikten sonra,\Ngerçek manada başarılı olacaksın. ♪
Dialogue: 0,0:01:01.30,0:01:08.60,Rock Concert Main,,0,0,0,,♪ Diğer tüm hayallerden daha büyük bir hayale sarılmak istiyor...
Dialogue: 0,0:01:09.54,0:01:16.33,Rock Concert Main,,0,0,0,,...ama ona zaten ulaşacağına dair içimde bir his var. ♪
Dialogue: 0,0:01:16.64,0:01:18.48,Rock Concert Main,,0,0,0,,♪ Gün bugündür! ♪
Dialogue: 0,0:01:18.81,0:01:20.81,Rock Concert Main,,0,0,0,,♪ Yeterince uzun bekledik. ♪
Dialogue: 0,0:01:20.83,0:01:24.83,Rock Concert Main,,0,0,0,,♪ Artık beklemek yok, bir gece daha beklemek zorunda değiliz. ♪
Dialogue: 0,0:01:24.86,0:01:26.66,Rock Concert Main,,0,0,0,,♪ Gün bugündür! ♪
Dialogue: 0,0:01:26.68,0:01:28.68,Rock Concert Main,,0,0,0,,♪ En mükemmel gün! ♪
Dialogue: 0,0:01:28.70,0:01:35.80,Rock Concert Main,,0,0,0,,♪ Bozuk saate vur gitsin! ♪
Dialogue: 0,0:01:35.83,0:01:46.53,Rock Concert Main,,0,0,0,,♪ Yeni Dünya için! ♪
Dialogue: 0,0:01:46.55,0:01:51.95,Rock Concert Main,,0,0,0,,♪ Dünya değişecek! ♪
Dialogue: 0,0:01:58.15,0:01:59.09,Rock Concert Main,,0,0,0,,♪ Bir kez daha! ♪
Dialogue: 50,0:02:15.85,0:02:17.09,Main-207+,,0,0,0,,Ne?! Ah..!
Dialogue: 50,0:02:23.31,0:02:24.87,Main-207+,,0,0,0,,Sizi salaklar!
Dialogue: 50,0:02:24.87,0:02:27.06,Main-207+,,0,0,0,,Sizin yüzünüzden kaçtı!
Dialogue: 50,0:02:27.06,0:02:29.53,Main-207+,,0,0,0,,Altın yumurtlayan tavuk kaçtı!
Dialogue: 50,0:02:31.87,0:02:35.11,Main-207+,,0,0,0,,Binayı boşaltın!\NHepinizi tutuklatamayacağımızı sanmayın!
Dialogue: 50,0:02:35.11,0:02:38.68,Main-207+,,0,0,0,,Hey Donanma, ne yapıyorsunuz?\NRuh Kralı'nı tutuklamayın!
Dialogue: 50,0:02:38.68,0:02:41.11,Main-207+,,0,0,0,,{\i1}Hey, neler oluyor orada?
Dialogue: 50,0:02:41.11,0:02:42.85,Main-207+,,0,0,0,,İsyan var!
Dialogue: 50,0:02:42.85,0:02:46.72,Main-207+,,0,0,0,,Donanma birden Ruh Kralı'nı \Ntutuklamaya hazır şekilde içeri damladı...
Dialogue: 50,0:02:47.28,0:02:50.39,Main-207+,,0,0,0,,...ancak hayranlar, denizcileri \Nengellediği için kaçtı!
Dialogue: 50,0:02:50.39,0:02:53.76,Main-207+,,0,0,0,,Lanet olsun!\NSeni hain..!
Dialogue: 50,0:02:54.36,0:02:56.39,Main-207+,,0,0,0,,Çok doğru!\NBu büyük bir haber!
Dialogue: 50,0:02:56.39,0:02:59.26,Main-207+,,0,0,0,,Müzisyen Brook, Hasır Şapkalı Luffy'nin tayfasında!
Dialogue: 50,0:02:59.26,0:03:00.76,Main-207+,,0,0,0,,O gerçekten bir korsan!
Dialogue: 50,0:03:07.67,0:03:11.74,Main-207+,,0,0,0,,Sizlere müteşekkirim!\Nİşte buna iyi zamanlama derim.
Dialogue: 50,0:03:11.74,0:03:16.58,Main-207+,,0,0,0,,Bizi Shakky Abla gönderdi!\NArkadaşların Koru 42'de bekliyor olmalı.
Dialogue: 50,0:03:16.58,0:03:20.08,Main-207+,,0,0,0,,Uzun zaman oldu!\NKalbim hasretle dolu!
Dialogue: 50,0:03:20.08,0:03:23.22,Main-207+,,0,0,0,,Oh, dolacak bir kalbim yok.
Dialogue: 50,0:03:28.66,0:03:30.69,Main-207+,,0,0,0,,{\i1}Bu doğru!
Dialogue: 50,0:03:30.69,0:03:33.63,Main-207+,,0,0,0,,{\i1}Donanma harekete geçti ve\NLuffy de bölgede bulunuyor!
Dialogue: 50,0:03:33.63,0:03:38.10,Main-207+,,0,0,0,,{\i1}Sunny'yi Koru 42'ye götürüyoruz,\Nyani sizinle orada görüşürüz!
Dialogue: 50,0:03:38.10,0:03:39.24,Main-207+,,0,0,0,,Anlaşıldı.
Dialogue: 50,0:03:39.24,0:03:39.94,Main-207+,,0,0,0,,{Clank.-OG}{Ka-lick. -Ryan, none of the above}{VG-clank? ka-lick. }
Dialogue: 50,0:03:39.94,0:03:40.74,Main-207+,,0,0,0,,Neymiş?
Dialogue: 50,0:03:40.74,0:03:42.47,Main-207+,,0,0,0,,Hey, dinlemiyor muydun?
Dialogue: 50,0:03:42.47,0:03:44.24,Main-207+,,0,0,0,,Yani...
Dialogue: 50,0:03:44.88,0:03:50.61,Main-207+,,0,0,0,,Donanma. Gelmek. Biz. Gemi. Kaçmak.
Dialogue: 50,0:03:51.18,0:03:52.15,Main-207+,,0,0,0,,Anladın mı?
Dialogue: 50,0:03:52.15,0:03:55.75,Main-207+,,0,0,0,,Tabii ki anladım! \NNeden öyle konuşuyorsun? Normal söylesene!
Dialogue: 50,0:03:56.69,0:03:59.49,Main-207+,,0,0,0,,Senin gibi bir kas kafa \Nbaşka türlü anlayamazdı.
Dialogue: 50,0:03:59.49,0:04:00.29,Main-207+,,0,0,0,,Ne?!
Dialogue: 50,0:04:00.96,0:04:05.26,Main-207+,,0,0,0,,Tamam. Sen. Sonra. Kesildi.
Dialogue: 50,0:04:05.26,0:04:06.66,Main-207+,,0,0,0,,Yav, hee.
Dialogue: 50,0:04:06.66,0:04:09.63,Main-207+,,0,0,0,,Bu arada, şu bağırışları duyuyor musun?
Dialogue: 50,0:04:09.07,0:04:09.63,Secondary-207+,,0,0,0,,Ha?
Dialogue: 50,0:04:12.17,0:04:14.84,Main-207+,,0,0,0,,Haklısın. Orası. Gürültülü.
Dialogue: 50,0:04:23.35,0:04:25.58,Main-207+,,0,0,0,,Kesin sesinizi, moronlar!
Dialogue: 50,0:04:28.19,0:04:31.36,Main-207+,,0,0,0,,Bana saygısızlık etme cüretini gösteren...
Dialogue: 50,0:04:31.36,0:04:33.89,Main-207+,,0,0,0,,...faillerden birini bulduk!
Dialogue: 50,0:04:35.06,0:04:37.09,Main-207+,,0,0,0,,Bu eleman!
Dialogue: 50,0:04:36.39,0:04:37.09,Secondary-207+,,0,0,0,,Ha?
Dialogue: 50,0:04:37.09,0:04:40.23,Main-207+,,0,0,0,,{\i1}Bu{\i0} adama iyi bir ders vererek başlayacağım!
Dialogue: 50,0:04:40.23,0:04:44.23,Main-207+,,0,0,0,,Ona... ne kadar korkunç \Nolabileceğimi göstereceğim!
Dialogue: 50,0:04:44.23,0:04:47.37,Main-207+,,0,0,0,,Ve ona birazdan yapacaklarım...
Dialogue: 50,0:04:47.37,0:04:50.81,Main-207+,,0,0,0,,...her birinize bir uyarı olacak!
Dialogue: 50,0:04:50.81,0:04:54.01,Main-207+,,0,0,0,,Bana bulaşırsanız, işte bunu alırsınız!
Dialogue: 50,0:04:54.65,0:04:56.78,Main-207+,,0,0,0,,Demek istediğimi \Nanladınız mı, sizi kaypaklar?
Dialogue: 50,0:04:58.22,0:05:01.95,Main-207+,,0,0,0,,400 milyonluk Beri ödülü olan \Nbir adam kesinlikle korkutucu oluyor.
Dialogue: 50,0:05:01.95,0:05:03.85,Main-207+,,0,0,0,,Bu elemanın sorunu ne?
Dialogue: 50,0:05:03.85,0:05:07.12,Main-207+,,0,0,0,,Zoro, Sanji, onu tanıyor musunuz?
Dialogue: 50,0:05:06.56,0:05:07.12,Secondary-207+,,0,0,0,,Ha?
Dialogue: 50,0:05:07.12,0:05:08.36,Main-207+,,0,0,0,,Eh, az evvel...
Dialogue: 50,0:05:09.86,0:05:12.40,Main-207+,,0,0,0,,Durun, korsanlar!
Dialogue: 50,0:05:13.10,0:05:17.63,Main-207+,,0,0,0,,Hasır Şapkalı Luffy ve tüm takipçileri,\Nderhal teslim olun!
Dialogue: 50,0:05:17.63,0:05:18.87,Main-207+,,0,0,0,,D-donanma..?!
Dialogue: 50,0:05:18.87,0:05:23.07,Main-207+,,0,0,0,,Koru 46'dan tüm çıkışları kapattık!
Dialogue: 50,0:05:23.07,0:05:24.98,Main-207+,,0,0,0,,Artık kaçabileceğiniz bir yer yok!
Dialogue: 50,0:05:25.58,0:05:28.38,Main-207+,,0,0,0,,N... nasıl Donanma beni bulabildi?
Dialogue: 50,0:05:29.61,0:05:30.95,Main-207+,,0,0,0,,Bu söylediğin de ne demek oluyor?
Dialogue: 50,0:05:30.95,0:05:33.55,Main-207+,,0,0,0,,Hey, Kaptan! Kuşatma altındayız!
Dialogue: 50,0:05:33.55,0:05:35.72,Main-207+,,0,0,0,,Panikleme, sersem!
Dialogue: 50,0:05:35.72,0:05:37.96,Main-207+,,0,0,0,,Neden tüm bu yeni üyeleri aldık sanıyorsun?
Dialogue: 50,0:05:37.96,0:05:40.12,Main-207+,,0,0,0,,Bazıları 100 milyon değerinde!
Dialogue: 50,0:05:40.12,0:05:41.49,Main-207+,,0,0,0,,Ama sayıca üstünler...
Dialogue: 50,0:05:41.49,0:05:42.69,Main-207+,,0,0,0,,Sadece izle, mankafa!
Dialogue: 50,0:05:44.36,0:05:46.06,Main-207+,,0,0,0,,Hey, Caribou!
Dialogue: 50,0:05:46.06,0:05:48.87,Main-207+,,0,0,0,,Şu denizciyi temiz bir yol \Nyaratmak için kalkan olarak kullan!
Dialogue: 50,0:05:49.47,0:05:50.63,Main-207+,,0,0,0,,"Denizci"..?
Dialogue: 50,0:05:50.63,0:05:54.27,Main-207+,,0,0,0,,Görünüşe göre gözcülerimizden \Nbirini yakalamış olabilirler!
Dialogue: 50,0:05:54.27,0:05:55.44,Main-207+,,0,0,0,,Kahretsin,\Nbu hiç iyi değil!
Dialogue: 50,0:05:55.91,0:05:57.67,Secondary-207+,,0,0,0,,Ne yapıyorsun, Caribou?!
Dialogue: 50,0:05:57.67,0:06:00.51,Secondary-207+,,0,0,0,,Onu kullanmak, buradan çıkış biletimiz!
Dialogue: 50,0:06:02.08,0:06:06.62,Main-207+,,0,0,0,,Bunu yapamam Patron!
Dialogue: 50,0:06:05.82,0:06:06.62,Secondary-207+,,0,0,0,,Ne?
Dialogue: 50,0:06:07.12,0:06:09.62,Main-207+,,0,0,0,,Çünkü bu asker yalan söyledi...
Dialogue: 50,0:06:09.62,0:06:13.26,Main-207+,,0,0,0,,Henüz Donanma'yı çağırmadığını söylemişti!
Dialogue: 50,0:06:14.86,0:06:15.76,Main-207+,,0,0,0,,Sakın yapma!
Dialogue: 50,0:06:24.84,0:06:28.44,Main-207+,,0,0,0,,Zırdeli emirlerimi görmezden geliyor!
Dialogue: 50,0:06:29.27,0:06:31.34,Main-207+,,0,0,0,,Oy oy, dediğini de yaptı...
Dialogue: 50,0:06:32.11,0:06:37.65,Main-207+,,0,0,0,,Kötü adamlara yalan söyleyebileceğine \Ndair söylenmemiş bir kural var gibi görünüyor.
Dialogue: 50,0:06:37.65,0:06:39.68,Main-207+,,0,0,0,,Oğlum var ya, bunu iğrenç mi buluyorum!
Dialogue: 50,0:06:41.08,0:06:44.35,Main-207+,,0,0,0,,Görünüşe göre teslim \Nolmaya hiç niyetleri yok!
Dialogue: 50,0:06:44.89,0:06:46.89,Main-207+,,0,0,0,,Peşlerine düşün! Korsanları haklayın!
Dialogue: 50,0:06:48.76,0:06:53.50,Main-207+,,0,0,0,,Patronumuz 400 milyon değerinde!\NO Hasır Şapkalı Luffy, bilirsiniz ya?!
Dialogue: 50,0:06:53.50,0:06:55.20,Main-207+,,0,0,0,,Saldırın!
Dialogue: 50,0:06:58.90,0:07:00.77,Main-207+,,0,0,0,,Bu hiç iyi değil, Kaptan. \NHadi kaçalım!
Dialogue: 50,0:07:00.77,0:07:03.01,Main-207+,,0,0,0,,Sizi nankörler! Kaptanınızı dinleyin!
Dialogue: 50,0:07:03.01,0:07:06.84,Main-207+,,0,0,0,,Ha? \NBana neden "patron" diye hitap ediyorlar?
Dialogue: 50,0:07:06.84,0:07:09.61,Main-207+,,0,0,0,,Tekrar soruyorum, \Nbu söylediğin de ne demek oluyor?
Dialogue: 50,0:07:21.06,0:07:23.73,Main-207+,,0,0,0,,Cesur olun! Gidin!
Dialogue: 50,0:07:24.96,0:07:26.03,Main-207+,,0,0,0,,Sen...
Dialogue: 50,0:07:26.76,0:07:30.83,Main-207+,,0,0,0,,88 milyon değerindeki adam,\NDudak "Servis" Doughty!
Dialogue: 50,0:07:32.30,0:07:34.74,Main-207+,,0,0,0,,Dövüş şeklin hoşuma gitti.
Dialogue: 50,0:07:34.74,0:07:36.94,Main-207+,,0,0,0,,Korkmayın! Ateşe hazır olun!
Dialogue: 50,0:07:41.21,0:07:44.35,Main-207+,,0,0,0,,92 milyon ödüllü...
Dialogue: 50,0:07:45.28,0:07:46.98,Main-207+,,0,0,0,,"Yaralı" Albion!
Dialogue: 50,0:07:49.32,0:07:52.42,Main-207+,,0,0,0,,Geri adım atmayın!\NAdalet için savaşın!
Dialogue: 50,0:07:52.42,0:07:53.42,Main-207+,,0,0,0,,Evet!
Dialogue: 50,0:07:54.83,0:08:00.00,Main-207+,,0,0,0,,Ne kokuşmuş bir şey!\Nİki yüzlülerin kanı!
Dialogue: 50,0:08:00.00,0:08:03.47,Main-207+,,0,0,0,,210 milyon ödüllü...\NKorsan "Yağlı saç" Caribou!
Dialogue: 50,0:08:03.87,0:08:05.27,Main-207+,,0,0,0,,Hemen teslim ol!
Dialogue: 50,0:08:07.07,0:08:09.37,Main-207+,,0,0,0,,Olamaz! Şeytan meyvesi mi yedin?
Dialogue: 50,0:08:11.54,0:08:13.81,Main-207+,,0,0,0,,Bunu yapmamalıydın!
Dialogue: 50,0:08:13.81,0:08:16.18,Main-207+,,0,0,0,,Kendini bu kadar zorlaman pek de sağlıklı değil.
Dialogue: 50,0:08:18.32,0:08:19.28,Flashbacks-207+,,0,0,0,,Kılıcım..!
Dialogue: 50,0:08:23.02,0:08:25.02,Main-207+,,0,0,0,,Hey! {\i1}O da{\i0} neydi öyle?!
Dialogue: 50,0:08:25.02,0:08:26.72,Main-207+,,0,0,0,,Pacifista!
Dialogue: 50,0:08:26.72,0:08:27.42,Main-207+,,0,0,0,,Ne?!
Dialogue: 50,0:08:34.16,0:08:36.93,Main-207+,,0,0,0,,Neden Donanma'nın insan silahları burada?!
Dialogue: 50,0:08:38.47,0:08:41.14,Main-207+,,0,0,0,,Bunlar Kuma'ya benzeyen şeyler!
Dialogue: 50,0:08:41.14,0:08:43.61,Main-207+,,0,0,0,,Ama Hanckock bana \Nbaşıma bela açmamamı söyledi...
Dialogue: 50,0:08:43.61,0:08:47.91,Main-207+,,0,0,0,,Cidden artık, bu söylediklerin de \Nne anlama geliyor senin?!
Dialogue: 50,0:08:53.32,0:08:56.69,Main-207+,,0,0,0,,Korsan Hasır Şapkalı Luffy:
Dialogue: 50,0:08:56.69,0:09:00.72,Main-207+,,0,0,0,,Onlar gerçek birer Pacifista mı?\NBeni mi hedef alıyorlar cidden?!
Dialogue: 50,0:09:02.26,0:09:04.73,Main-207+,,0,0,0,,Pacifista demek, he? \NNe kadar da heyecan verici!
Dialogue: 50,0:09:10.67,0:09:16.21,Main-207+,,0,0,0,,88 Milyon Beli ödüllü,\NDudak "Service" Doughty: Durdruldu.
Dialogue: 50,0:09:16.21,0:09:18.08,Main-207+,,0,0,0,,Kaptan Doughty!
Dialogue: 50,0:09:20.84,0:09:25.02,Main-207+,,0,0,0,,Pacifista'yı takip edin! Korsanları yakalayın!
Dialogue: 50,0:09:24.18,0:09:25.02,Secondary-207+,,0,0,0,,Evet!
Dialogue: 50,0:09:25.02,0:09:26.62,Main-207+,,0,0,0,,Tek atışta mı?!
Dialogue: 50,0:09:26.62,0:09:29.52,Main-207+,,0,0,0,,88 milyon ödüle rağmen, \Nrakip bile olamadı.
Dialogue: 50,0:09:29.52,0:09:32.69,Main-207+,,0,0,0,,Bu kötü haber...\NBekle, Kaptan, nereye gidiyorsun?!
Dialogue: 50,0:09:32.69,0:09:34.42,Main-207+,,0,0,0,,Beni bekleyin!
Dialogue: 50,0:09:33.76,0:09:34.42,Secondary-207+,,0,0,0,,Hey, hey!
Dialogue: 50,0:09:34.42,0:09:38.46,Main-207+,,0,0,0,,Salaklar! Doughty'i paramparça ettiler, \Nonlara denk değiliz! Kaçmamız gerek!
Dialogue: 50,0:09:44.43,0:09:47.17,Main-207+,,0,0,0,,Patron Hasır Şapka, bir şeyler yapın!
Dialogue: 50,0:09:48.14,0:09:52.31,Main-207+,,0,0,0,,Hiçbir şey yapamazsak, \Nbu insan silahlar hepimizi öldürecek!
Dialogue: 50,0:09:52.31,0:09:54.48,Main-207+,,0,0,0,,Patron–
Dialogue: 50,0:09:54.48,0:09:55.35,Main-207+,,0,0,0,,Ha?
Dialogue: 50,0:09:55.35,0:09:57.45,Main-207+,,0,0,0,,Patron gitmiş!
Dialogue: 50,0:09:57.45,0:09:59.28,Main-207+,,0,0,0,,Patron mu?
Dialogue: 50,0:10:00.08,0:10:01.75,Main-207+,,0,0,0,,Hasır Şapka'dan mı söz ediyorlar?
Dialogue: 50,0:10:02.45,0:10:04.72,Main-207+,,0,0,0,,Bekleyin! Ciğerlerim çok acıyor!
Dialogue: 50,0:10:04.72,0:10:07.36,Main-207+,,0,0,0,,Aptallar sizi...! Kaçın yoksa bizi–
Dialogue: 50,0:10:08.83,0:10:10.56,Main-207+,,0,0,0,,Çekil yolumdan, ahmak!
Dialogue: 50,0:10:10.96,0:10:13.13,Main-207+,,0,0,0,,Ha? Sen de kimsin?
Dialogue: 50,0:10:16.70,0:10:17.97,Main-207+,,0,0,0,,Bu...
Dialogue: 50,0:10:18.97,0:10:20.04,Main-207+,,0,0,0,,Patron!
Dialogue: 50,0:10:24.64,0:10:27.44,Main-207+,,0,0,0,,Neden etrafta Hasır Şapka'yım diye dolanıyorsun?
Dialogue: 50,0:10:27.44,0:10:31.78,Main-207+,,0,0,0,,H-hey, pislik herif!\NBenim kim olduğumu bilmiyor musun?!
Dialogue: 50,0:10:31.78,0:10:35.69,Main-207+,,0,0,0,,Yolumdan çekil yoksa seni deşer ve \Nbağırsaklarını liğme liğme ederim.
Dialogue: 50,0:10:35.69,0:10:40.86,Main-207+,,0,0,0,,Duymadın mı yoksa?!\NBen Devrimci Dragon'un oğluyum!
Dialogue: 50,0:10:40.86,0:10:43.59,Main-207+,,0,0,0,,Kahraman Garp'ın torunu!
Dialogue: 50,0:10:43.59,0:10:48.60,Main-207+,,0,0,0,,400 Milyon Beli ödüllü \Nmeşhur korsan, Hasır–
Dialogue: 50,0:10:51.54,0:10:55.17,Main-207+,,0,0,0,,Hasır Şapka senin gibi bir aşağılık değil!
Dialogue: 50,0:10:57.94,0:10:58.71,Main-207+,,0,0,0,,Ne..?
Dialogue: 50,0:10:58.71,0:10:59.68,Main-207+,,0,0,0,,Ha?
Dialogue: 50,0:10:59.68,0:11:00.88,Main-207+,,0,0,0,,Ah...!
Dialogue: 50,0:11:00.88,0:11:02.85,Main-207+,,0,0,0,,– Ne?!\N– Ne?!
Dialogue: 50,0:11:03.81,0:11:07.05,Main-207+,,0,0,0,,Patron Hasır Şapka!
Dialogue: 50,0:11:08.08,0:11:09.55,Main-207+,,0,0,0,,Şimdi anlıyorum.
Dialogue: 50,0:11:09.55,0:11:13.92,Main-207+,,0,0,0,,Hepsi sahte Hasır Şapka tayfasına\N katılmaları için kandırıldılar.
Dialogue: 50,0:11:13.92,0:11:16.26,Main-207+,,0,0,0,,PX-5, gerçekte kim bu adam?
Dialogue: 50,0:11:20.40,0:11:23.63,Main-207+,,0,0,0,,Korsan "Üç Dilli" Demaro Black.
Dialogue: 50,0:11:23.63,0:11:26.14,Main-207+,,0,0,0,,Ödül: 26 Milyon Beli.
Dialogue: 50,0:11:26.14,0:11:27.00,Main-207+,,0,0,0,,– Ne?!\N– Ne?!
Dialogue: 50,0:11:27.00,0:11:29.47,Main-207+,,0,0,0,,Yirmi altı milyon. Bu demek oluyor ki...
Dialogue: 50,0:11:30.57,0:11:32.58,Main-207+,,0,0,0,,...onlar sahtekâr!
Dialogue: 50,0:11:34.41,0:11:36.11,Main-207+,,0,0,0,,Öğrendiler! Kaçın!
Dialogue: 50,0:11:37.31,0:11:39.28,Main-207+,,0,0,0,,Bu ezik ne yaptı yani şimdi?
Dialogue: 50,0:11:39.28,0:11:43.45,Main-207+,,0,0,0,,Hasır Şapka gibi davranıp bizi kandırdı!
Dialogue: 50,0:11:43.45,0:11:45.62,Main-207+,,0,0,0,,Çünkü gerçek olan öldü!
Dialogue: 50,0:11:45.62,0:11:51.36,Main-207+,,0,0,0,,Kahretsin! Neredeyse 26 Milyon Beli ödüllü\Nbir aşağılık tarafından emir alacaktım!
Dialogue: 50,0:11:51.36,0:11:52.13,Main-207+,,0,0,0,,Ne?
Dialogue: 50,0:11:52.93,0:11:55.77,Main-207+,,0,0,0,,Ben gibi mi davranmaya çalışıyordu?
Dialogue: 50,0:11:55.77,0:11:57.37,Main-207+,,0,0,0,,Sanji ve Zoro da mı?
Dialogue: 50,0:11:57.37,0:12:00.14,Main-207+,,0,0,0,,Oysa gerçeklerine çok benziyorlardı!
Dialogue: 50,0:12:00.64,0:12:03.54,Main-207+,,0,0,0,,Başka bir şey olmadan hemen \Nburadan kaçsam iyi olacak.
Dialogue: 50,0:12:04.11,0:12:09.05,Main-207+,,0,0,0,,Şu sahtekâr tam bir aptaldı, \Nama siz budalaların da şansı kalmadı.
Dialogue: 50,0:12:09.05,0:12:11.68,Main-207+,,0,0,0,,Hepiniz tutuklusunuz!
Dialogue: 50,0:12:13.95,0:12:18.56,Main-207+,,0,0,0,,Ve görünüşe göre,\Ngerçek Hasır Şapka da burada.
Dialogue: 50,0:12:19.52,0:12:23.96,Main-207+,,0,0,0,,PX-5 bu bölgeye girdiğimiz \Nan onu tespit edebildi.
Dialogue: 50,0:12:23.96,0:12:26.43,Main-207+,,0,0,0,,Ateş, PX-5!
Dialogue: 50,0:12:37.24,0:12:38.34,Main-207+,,0,0,0,,Bu çok yakındı!
Dialogue: 50,0:12:41.21,0:12:42.41,Main-207+,,0,0,0,,Bu neydi şimdi ya?!
Dialogue: 50,0:12:42.41,0:12:45.35,Main-207+,,0,0,0,,Bu çantada benim için çok \Ndeğerli yemeklerimi taşıyorum!
Dialogue: 50,0:12:47.85,0:12:50.99,Main-207+,,0,0,0,,Yüz... yüzü...
Dialogue: 50,0:12:55.06,0:12:58.13,Main-207+,,0,0,0,,Tıpkı posterdeki gibi!
Dialogue: 50,0:13:00.83,0:13:03.97,Main-207+,,0,0,0,,Yani o gerçek Hasır Şapka mıydı?!
Dialogue: 50,0:13:03.97,0:13:05.44,Main-207+,,0,0,0,,Toparlanın!
Dialogue: 50,0:13:05.44,0:13:08.27,Main-207+,,0,0,0,,Hali hazırda zaten gerçek \Nolanı yakalamaya gelmiştik!
Dialogue: 50,0:13:08.27,0:13:09.01,Main-207+,,0,0,0,,– Evet, efendim!\N– Evet, efendim!
Dialogue: 50,0:13:09.01,0:13:10.21,Main-207+,,0,0,0,,Hasır Şapka!
Dialogue: 50,0:13:10.21,0:13:13.68,Main-207+,,0,0,0,,Ne?! Yine mi yoluma çıkıp \Nbeni durdurmayı deneyeceksin?!
Dialogue: 50,0:13:14.24,0:13:17.71,Main-207+,,0,0,0,,Başıma bela açmamam gerekiyordu ki \Nrahatça denize açılabileyim!
Dialogue: 50,0:13:17.71,0:13:20.92,Main-207+,,0,0,0,,Endişelenme! Açılmana gerek yok!
Dialogue: 50,0:13:21.35,0:13:25.82,Main-207+,,0,0,0,,İki yıl öncesinin aksine,\Nartık resmi olarak Donanma'nın bir üyesiyim!
Dialogue: 50,0:13:25.82,0:13:28.06,Main-207+,,0,0,0,,Yani şu an seni yakaladığım\N zamana gelmiş bulunmaktayız!
Dialogue: 50,0:13:28.49,0:13:29.79,Main-207+,,0,0,0,,PX-5!
Dialogue: 50,0:13:37.53,0:13:38.70,Main-207+,,0,0,0,,Çok yavaş...
Dialogue: 50,0:13:42.87,0:13:43.87,Main-207+,,0,0,0,,Ne?!
Dialogue: 50,0:13:48.91,0:13:50.81,Main-207+,,0,0,0,,{\fad(150,150)}Gear Second!
Dialogue: 0,0:13:48.91,0:13:50.81,Attack,,0,0,0,,İkinci Vites
Dialogue: 50,0:13:57.05,0:13:58.42,Main-207+,,0,0,0,,{\fad(150,150)}Gomu-Gomu no...
Dialogue: 0,0:13:57.05,0:13:58.42,Attack,,0,0,0,,Lastik-Lastik
Dialogue: 50,0:14:08.53,0:14:10.40,Main-207+,,0,0,0,,{\fad(150,150)}Jet Pistol!
Dialogue: 0,0:14:08.53,0:14:10.40,Attack,,0,0,0,,Jet Tabancası
Dialogue: 50,0:14:17.41,0:14:18.88,Main-207+,,0,0,0,,Hasır Şapka...
Dialogue: 50,0:14:20.04,0:14:22.11,Main-207+,,0,0,0,,Bu... haki!
Dialogue: 50,0:14:24.95,0:14:28.42,Main-207+,,0,0,0,,Pacifista'yı tek yumrukta indirdi!
Dialogue: 50,0:14:36.59,0:14:37.83,Main-207+,,0,0,0,,Görüşürüz!
Dialogue: 50,0:14:37.83,0:14:40.70,Main-207+,,0,0,0,,Eminim bir gün tekrar \Nbir yerlerde karşılaşacağız!
Dialogue: 50,0:14:40.70,0:14:42.10,Main-207+,,0,0,0,,Bekle, Hasır Şapka!
Dialogue: 50,0:14:42.10,0:14:44.30,Main-207+,,0,0,0,,Hasır Şapka'nın kaçmasına izin vermeyin!
Dialogue: 50,0:14:44.30,0:14:45.54,Main-207+,,0,0,0,,– Evet!\N– Evet!
Dialogue: 50,0:14:47.64,0:14:49.67,Main-207+,,0,0,0,,Hey, Luffy!
Dialogue: 50,0:14:49.67,0:14:50.57,Main-207+,,0,0,0,,Oh?
Dialogue: 50,0:14:50.57,0:14:53.01,Main-207+,,0,0,0,,Luffy! Sen olduğunu biliyordum!
Dialogue: 50,0:14:53.01,0:14:56.01,Main-207+,,0,0,0,,Hemencecik nasıl başını \Nbelaya sokmayı becerdin?!
Dialogue: 50,0:14:56.51,0:14:58.38,Main-207+,,0,0,0,,Ohhh!
Dialogue: 50,0:14:58.38,0:15:03.22,Main-207+,,0,0,0,,Bu sefer gerçekten sizsiniz!\NUzun zaman oldu, çocuklar!
Dialogue: 50,0:15:03.22,0:15:06.99,Main-207+,,0,0,0,,Roronoa! Kara Bacak!\NDemek gerçekten hayattalar!
Dialogue: 50,0:15:06.99,0:15:08.79,Main-207+,,0,0,0,,PX-7!
Dialogue: 50,0:15:16.93,0:15:18.90,Main-207+,,0,0,0,,– Çekil yolumdan!\N– Çekil yolumdan!
Dialogue: 50,0:15:24.34,0:15:25.64,Main-207+,,0,0,0,,Onu kestim!
Dialogue: 50,0:15:25.64,0:15:28.01,Main-207+,,0,0,0,,Hayır, ben onun boynunu kırdım!
Dialogue: 50,0:15:30.11,0:15:33.28,Main-207+,,0,0,0,,Bunlar Hasır Şapkalar!\N{\i1}Gerçek{\i0} olanlar!
Dialogue: 50,0:15:33.28,0:15:36.39,Main-207+,,0,0,0,,Sahteleriyle zerre alakaları yok!
Dialogue: 50,0:15:41.56,0:15:43.73,Main-207+,,0,0,0,,Hey Luffy, sen dokuzuncusun.
Dialogue: 50,0:15:43.73,0:15:45.90,Main-207+,,0,0,0,,Kes artık!\NBu konuda böbürlenmeyi bırak!
Dialogue: 50,0:15:45.90,0:15:48.33,Main-207+,,0,0,0,,Luffy, acele et!\NHerkes gemide bekliyor!
Dialogue: 50,0:15:48.33,0:15:49.17,Main-207+,,0,0,0,,Tamam!
Dialogue: 50,0:15:50.90,0:15:54.44,Main-207+,,0,0,0,,Kaçmalarına izin vermeyin!\NHer ne pahasına olursa olsun yakalayın!
Dialogue: 50,0:15:54.44,0:15:55.24,Main-207+,,0,0,0,,– Evet, efendim!\N– Evet, efendim!
Dialogue: 50,0:15:55.24,0:16:00.18,Main-207+,,0,0,0,,Çok uzun zaman oldu!\NUmarım herkes iyidir!
Dialogue: 50,0:16:00.18,0:16:01.85,Main-207+,,0,0,0,,Çok mutluyum!
Dialogue: 50,0:16:09.39,0:16:10.85,Main-207+,,0,0,0,,Hey, sorun ne?
Dialogue: 50,0:16:13.89,0:16:14.69,Main-207+,,0,0,0,,Oh!
Dialogue: 50,0:16:16.03,0:16:19.00,Main-207+,,0,0,0,,Rayleigh!
Dialogue: 50,0:16:19.00,0:16:20.56,Main-207+,,0,0,0,,Ne?!
Dialogue: 50,0:16:20.56,0:16:22.23,Main-207+,,0,0,0,,İmkansız!
Dialogue: 50,0:16:23.17,0:16:24.97,Main-207+,,0,0,0,,Kara Kral Rayleigh mi?!
Dialogue: 50,0:16:28.71,0:16:32.71,Main-207+,,0,0,0,,Seni kontrol edeyim diye bir \Nuğramıştım ama iyi idare ediyor gibisin.
Dialogue: 50,0:16:33.38,0:16:36.25,Main-207+,,0,0,0,,Becerilerini daha da geliştirmişsin.
Dialogue: 50,0:16:36.25,0:16:37.31,Main-207+,,0,0,0,,Evet!
Dialogue: 50,0:16:37.71,0:16:41.22,Main-207+,,0,0,0,,Şimdi yola koyul!\NArkadaşların seni bekliyor.
Dialogue: 50,0:16:41.22,0:16:46.89,Main-207+,,0,0,0,,Tamamdır! Rayleigh, geçtiğimiz iki \Nyıldaki her şey için teşekkür ederim!
Dialogue: 50,0:16:48.06,0:16:51.26,Main-207+,,0,0,0,,Bak işte bu sana hiç benzemiyor. \NHaydi git artık!
Dialogue: 50,0:17:00.70,0:17:01.47,Main-207+,,0,0,0,,Rayleigh!
Dialogue: 50,0:17:04.17,0:17:05.64,Main-207+,,0,0,0,,Başaracağım!
Dialogue: 50,0:17:09.48,0:17:15.32,Main-207+,,0,0,0,,Korsanlar Kralı olacağım!
Dialogue: 50,0:17:28.36,0:17:29.73,Main-207+,,0,0,0,,Ne yapıyorsunuz siz?!
Dialogue: 50,0:17:29.73,0:17:31.57,Main-207+,,0,0,0,,Hasır Şapka'yı getirin hemen!
Dialogue: 50,0:17:32.50,0:17:33.54,Main-207+,,0,0,0,,Ups!
Dialogue: 50,0:17:33.54,0:17:35.27,Main-207+,,0,0,0,,Acele et, Luffy!
Dialogue: 50,0:17:35.27,0:17:37.17,Main-207+,,0,0,0,,Rayleigh, her şey için teşekkürler!
Dialogue: 50,0:17:37.17,0:17:39.14,Main-207+,,0,0,0,,Evet o halde, Rayleigh...!
Dialogue: 50,0:17:40.04,0:17:42.41,Main-207+,,0,0,0,,Tekrardan her şey için teşekkürler!
Dialogue: 50,0:17:42.41,0:17:45.18,Main-207+,,0,0,0,,Artık gidiyorum!
Dialogue: 50,0:17:49.72,0:17:50.75,Main-207+,,0,0,0,,Evet...
Dialogue: 50,0:18:08.54,0:18:09.97,Main-207+,,0,0,0,,Şu tarafa gittiler!
Dialogue: 50,0:18:09.97,0:18:11.91,Main-207+,,0,0,0,,– Peşlerine düşün!\N– Uzaklaşmalarına izin vermeyin!
Dialogue: 50,0:18:14.51,0:18:16.75,Main-207+,,0,0,0,,En tepeye yüksel!
Dialogue: 50,0:18:19.65,0:18:23.79,Main-207+,,0,0,0,,Hasır Şapkalar Koru 42'ye doğru ilerliyor!
Dialogue: 50,0:18:23.79,0:18:25.86,Main-207+,,0,0,0,,Kaçmalarına izin vermeyin!
Dialogue: 50,0:18:30.33,0:18:31.79,Main-207+,,0,0,0,,Bu da neydi?!
Dialogue: 50,0:18:34.00,0:18:36.17,Main-207+,,0,0,0,,Kara Kral Rayleigh!
Dialogue: 50,0:18:36.17,0:18:38.50,Main-207+,,0,0,0,,Öğrencim yeni hayatına yelken açıyor.
Dialogue: 50,0:18:38.50,0:18:40.37,Main-207+,,0,0,0,,Ona bu kadar sert davranmayın.
Dialogue: 50,0:18:43.24,0:18:45.48,Main-207+,,0,0,0,,Bu-bu çizgi de ne?!
Dialogue: 50,0:18:46.38,0:18:49.31,Main-207+,,0,0,0,,Buradan ileri gitmenizi pek tavsiye etmem.
Dialogue: 50,0:18:54.68,0:18:58.12,Main-207+,,0,0,0,,Oh, baloncuk çantalar! Ne kadar çoklar!
Dialogue: 50,0:18:58.12,0:18:59.52,Main-207+,,0,0,0,,İçlerinde neler var?
Dialogue: 50,0:18:59.52,0:19:02.63,Main-207+,,0,0,0,,Hepsi yiyecekle dolu.\NGeçtiğimiz iki yıl boyunca...
Dialogue: 50,0:19:02.65,0:19:05.76,Main-207+,,0,0,0,,...herkesin midesinin büyümüş\Nolabileceğini düşündüm.
Dialogue: 50,0:19:05.76,0:19:07.90,Main-207+,,0,0,0,,Karnınızı bir güzel doyuracağım!
Dialogue: 50,0:19:07.90,0:19:11.13,Main-207+,,0,0,0,,Gerçekten mi?! \NSenin yemeklerini tatmak için sabırsızlanıyorum!
Dialogue: 50,0:19:11.13,0:19:13.47,Main-207+,,0,0,0,,Buradalar! \NBu yönde ilerliyorlar!
Dialogue: 50,0:19:14.97,0:19:16.91,Main-207+,,0,0,0,,Oh, daire çizdiler!
Dialogue: 50,0:19:18.17,0:19:19.71,Main-207+,,0,0,0,,Başka çare yok, he?
Dialogue: 50,0:19:19.71,0:19:21.71,Main-207+,,0,0,0,,Herkes saldırsın!
Dialogue: 50,0:19:21.71,0:19:22.85,Main-207+,,0,0,0,,Evet!
Dialogue: 50,0:19:27.15,0:19:29.69,Main-207+,,0,0,0,,Ben bir... pire olmak istiyorum...
Dialogue: 50,0:19:29.69,0:19:31.22,Main-207+,,0,0,0,,Sorun ne? Ne yapıyor...?
Dialogue: 50,0:19:31.22,0:19:33.22,Main-207+,,0,0,0,,Böcek olmak istiyorum...
Dialogue: 50,0:19:33.22,0:19:34.69,Main-207+,,0,0,0,,Ne?!
Dialogue: 50,0:19:34.69,0:19:36.46,Main-207+,,0,0,0,,Bu saçmalık da ne...
Dialogue: 50,0:19:40.66,0:19:42.27,Main-207+,,0,0,0,,Ben... ben...
Dialogue: 50,0:19:43.23,0:19:45.84,Main-207+,,0,0,0,,Bit olmak istiyorum...
Dialogue: 50,0:19:45.84,0:19:47.14,Main-207+,,0,0,0,,Hey!
Dialogue: 50,0:19:47.14,0:19:48.40,Main-207+,,0,0,0,,Bu şey olmalı...
Dialogue: 50,0:19:51.67,0:19:53.64,Main-207+,,0,0,0,,Tam da tahmin ettiğim gibi...
Dialogue: 50,0:19:53.64,0:19:55.48,Main-207+,,0,0,0,,...bu zırvalık {\i1}senin{\i0} başının altından çıktı.
Dialogue: 50,0:19:57.25,0:19:58.85,Main-207+,,0,0,0,,İnanamıyorum!
Dialogue: 50,0:20:00.15,0:20:03.52,Main-207+,,0,0,0,,Henüz hiçbir yere gitmemişsin!
Dialogue: 50,0:20:03.52,0:20:06.92,Main-207+,,0,0,0,,Bu doğru!\NSeni Thriller Bark'tan hatırlıyorum!
Dialogue: 50,0:20:07.59,0:20:08.83,Main-207+,,0,0,0,,Kimdi o?
Dialogue: 50,0:20:08.83,0:20:11.99,Main-207+,,0,0,0,,Hala ne yapıyorsun sen burada?
Dialogue: 50,0:20:11.99,0:20:15.93,Main-207+,,0,0,0,,Seni bu adaya getiren \Nkişiye daha fazla nazik olmalısın!
Dialogue: 50,0:20:15.93,0:20:18.17,Main-207+,,0,0,0,,Eğer seni yönlendirmemiş olsaydım...
Dialogue: 50,0:20:19.90,0:20:22.41,Main-207+,,0,0,0,,Biraz olsun minnettarlık gö–
Dialogue: 50,0:20:22.41,0:20:23.81,Main-207+,,0,0,0,,{Sniff, sniff...}
Dialogue: 50,0:20:23.81,0:20:26.54,Main-207+,,0,0,0,,Gerçek bir kadın!\NGerçek bir kadın!
Dialogue: 50,0:20:26.54,0:20:29.01,Main-207+,,0,0,0,,Tabii ki öyleyim!\NNesin sen, hasta mı?
Dialogue: 50,0:20:29.01,0:20:31.58,Main-207+,,0,0,0,,Her neyse, hadi artık yelken açın!
Dialogue: 50,0:20:31.58,0:20:33.68,Main-207+,,0,0,0,,Çevrede bir kısım Donanma gemisi toplanmış.
Dialogue: 50,0:20:33.68,0:20:34.55,Main-207+,,0,0,0,,– Ne?\N– Ne?
Dialogue: 50,0:20:35.18,0:20:37.59,Main-207+,,0,0,0,,Yakında buradan hiçbir çıkış yolunuz olmayacak.
Dialogue: 50,0:20:42.46,0:20:43.53,Main-207+,,0,0,0,,Oh?!
Dialogue: 50,0:20:43.53,0:20:44.69,Main-207+,,0,0,0,,Bu ses..!
Dialogue: 50,0:20:44.69,0:20:49.43,Main-207+,,0,0,0,,Usopp-{\i1}san{\i0}! Nami-{\i1}san{\i0}! Robin-{\i1}san{\i0}!
Dialogue: 50,0:20:49.43,0:20:52.67,Main-207+,,0,0,0,,{FFFranky-san! -OG}{Franky-san! -Ryan}Frrranky-{\i1}san{\i0}!{Z}
Dialogue: 50,0:20:57.11,0:20:57.91,Main-207+,,0,0,0,,Brook!
Dialogue: 50,0:20:57.91,0:21:00.91,Main-207+,,0,0,0,,Hey! Yıldız olmayı bir kenara \Nattığına inanamıyorum!
Dialogue: 50,0:21:00.91,0:21:01.64,Main-207+,,0,0,0,,Harikasın!
Dialogue: 50,0:21:04.15,0:21:07.02,Main-207+,,0,0,0,,Çok uzun zaman olmuştu, millet!
Dialogue: 50,0:21:07.02,0:21:10.72,Main-207+,,0,0,0,,İkiniz de çok güzelleşmişsiniz!
Dialogue: 50,0:21:13.59,0:21:14.92,Main-207+,,0,0,0,,Pekala, Nami-{\i1}san{\i0}!
Dialogue: 50,0:21:15.36,0:21:16.86,Main-207+,,0,0,0,,İyi yıl oldu, yani...
Dialogue: 50,0:21:18.83,0:21:21.60,Main-207+,,0,0,0,,Ah! Bize şarkı mı yazdın?
Dialogue: 50,0:21:25.54,0:21:28.00,Main-207+,,0,0,0,,...bana karşı nazik olup,\Niç çamaşırlarını bana gös–
Dialogue: 50,0:21:28.00,0:21:29.81,Main-207+,,0,0,0,,Ne dediğini sanıyorsun {\i1}sen{\i0}?!
Dialogue: 50,0:21:29.81,0:21:32.88,Main-207+,,0,0,0,,İki yıl önce de asla \Ngörmene izin vermiyordum!
Dialogue: 50,0:21:32.88,0:21:36.21,Main-207+,,0,0,0,,Se-seni tekrar gördüğüm için \No kadar heyecanlıyım ki... Gördün mü?
Dialogue: 50,0:21:36.21,0:21:39.98,Main-207+,,0,0,0,,Bu... kalbimi titretiyor... \NHem de...
Dialogue: 50,0:21:39.98,0:21:44.25,Secondary-207+,,0,0,0,,{\an8}...titreyecek bir kalbim olmamasına rağmen...
Dialogue: 50,0:21:40.72,0:21:44.25,Main-207+,,0,0,0,,Hey, rock yıldızı dibi vurdu.
Dialogue: 50,0:21:44.25,0:21:48.32,Main-207+,,0,0,0,,Cidden ama! \NErgen tavırlarınız hala devam ediyor.
Dialogue: 50,0:21:49.49,0:21:54.70,Main-207+,,0,0,0,,Bu arada...\NHenüz herkesi gemide göremiyorum.
Dialogue: 50,0:21:54.70,0:21:58.17,Main-207+,,0,0,0,,Oh, evet. Chopper onları almak için gitti.
Dialogue: 50,0:21:56.87,0:21:58.63,Secondary-207+,,0,0,0,,{\an8}Hey!
Dialogue: 50,0:21:58.17,0:21:58.63,Main-207+,,0,0,0,,– Ha?\N– Ha?
Dialogue: 50,0:22:05.81,0:22:07.48,Main-207+,,0,0,0,,Amma da uzun sürdü!
Dialogue: 50,0:22:07.48,0:22:10.08,Main-207+,,0,0,0,,Hey!
Dialogue: 50,0:22:11.98,0:22:14.48,Main-207+,,0,0,0,,Çocuklar!
Dialogue: 50,0:22:16.59,0:22:18.92,Main-207+,,0,0,0,,Onları buldum!
Dialogue: 50,0:22:20.42,0:22:23.43,Main-207+,,0,0,0,,Luffy! Zoro! Sanji!
Dialogue: 50,0:22:23.43,0:22:25.66,Main-207+,,0,0,0,,Hey!
Dialogue: 50,0:22:27.63,0:22:31.43,Main-207+,,0,0,0,,Luffy-{\i1}san{\i0}! Seni çok özledim!
Dialogue: 50,0:22:31.43,0:22:34.50,Main-207+,,0,0,0,,Kesinlikle daha erkeksi gözüküyorsunuz!
Dialogue: 50,0:22:36.74,0:22:38.67,Main-207+,,0,0,0,,Tekrardan birlikteyiz!
Dialogue: 50,0:22:42.51,0:22:43.35,Main-207+,,0,0,0,,Sonunda–
Dialogue: 50,0:22:43.35,0:22:44.21,Main-207+,,0,0,0,,Oh!
Dialogue: 50,0:22:44.21,0:22:46.62,Main-207+,,0,0,0,,Çocuklar!
Dialogue: 50,0:22:55.12,0:22:57.29,Main-207+,,0,0,0,,Ne?!
Dialogue: 50,0:22:58.06,0:23:00.23,Main-207+,,0,0,0,,Sanji!
Dialogue: 50,0:23:06.57,0:23:08.54,Main-207+,,0,0,0,,Pekala o halde,\Nteşekkür ederim!
Dialogue: 50,0:23:08.54,0:23:10.87,Main-207+,,0,0,0,,Torino Krallığı'ndaki herkese \Nbenim için selam söyle.
Dialogue: 50,0:23:12.61,0:23:14.81,Main-207+,,0,0,0,,Usopp! Sanji iyi mi?!
Dialogue: 50,0:23:14.81,0:23:18.01,Main-207+,,0,0,0,,Bir...Bir...Bir güzel kadın...
Dialogue: 50,0:23:18.01,0:23:20.52,Main-207+,,0,0,0,,Hey, benimle kal!
Dialogue: 50,0:23:18.91,0:23:20.52,Secondary-207+,,0,0,0,,İki güzel kadın...
Dialogue: 50,0:23:20.52,0:23:23.32,Main-207+,,0,0,0,,Chopper, durumu gerçekten kötü!\NKanamayı durdurmalıyız!
Dialogue: 50,0:23:25.02,0:23:27.96,Main-207+,,0,0,0,,F-F-Franky, sen...!
Dialogue: 50,0:23:27.96,0:23:29.49,Main-207+,,0,0,0,,Sorun nedir?
Dialogue: 50,0:23:30.59,0:23:33.76,Main-207+,,0,0,0,,Seni endişelendiren bir durum mu var-{\fnFOT-KafuTechno Std E Strp\i1\b1}mecha{\fn\i0\b0}?
Dialogue: 50,0:23:34.30,0:23:37.20,Main-207+,,0,0,0,,"Mecha" mı?! Ben de denemek istiyorum!
Dialogue: 50,0:23:36.23,0:23:37.20,Secondary-207+,,0,0,0,,Bekle, Luffy!
Dialogue: 50,0:23:37.97,0:23:39.64,Main-207+,,0,0,0,,Bu saçmalıkla sonra uğraşırsın!
Dialogue: 50,0:23:39.64,0:23:42.97,Main-207+,,0,0,0,,Görünüşe göre Donanma \Ngemileri çoktan buradalar!
Dialogue: 50,0:23:45.88,0:23:48.01,Main-207+,,0,0,0,,Oh, hayır! \NNe zaman buraya geldiler?!
Dialogue: 50,0:23:50.28,0:23:52.42,Main-207+,,0,0,0,,Üç Donanma gemisi!
Dialogue: 50,0:23:55.58,0:23:58.29,Main-207+,,0,0,0,,Hey, onlar bize vurmadan,\Nbizim onları vurmamız gerekiyor!
Dialogue: 50,0:23:58.29,0:24:01.22,Main-207+,,0,0,0,,Ateş! Onları derinliklere gömün!
Dialogue: 50,0:24:04.73,0:24:05.66,Main-207+,,0,0,0,,{\fad(150,150)}Slave...
Dialogue: 0,0:24:04.73,0:24:05.66,Attack,,0,0,0,,{\fad(150,150)}Köle
Dialogue: 50,0:24:06.46,0:24:07.13,Main-207+,,0,0,0,,{\fad(150,150)}Arrow!
Dialogue: 0,0:24:06.46,0:24:07.13,Attack,,0,0,0,,{\fad(150,150)}Oku
Dialogue: 50,0:24:13.50,0:24:15.44,Main-207+,,0,0,0,,Ne..? Neler oluyor?
Dialogue: 50,0:24:15.44,0:24:17.27,Main-207+,,0,0,0,,Bu gemi...
Dialogue: 50,0:24:20.54,0:24:22.58,Main-207+,,0,0,0,,Kuja Korsanları!
Dialogue: 50,0:24:24.91,0:24:26.22,Main-207+,,0,0,0,,Kim...
Dialogue: 50,0:24:27.92,0:24:30.39,Main-207+,,0,0,0,,...benim önüme...
Dialogue: 50,0:24:31.95,0:24:34.09,Main-207+,,0,0,0,,...bir Donanma gemisi koydu?
Dialogue: 50,0:24:42.40,0:24:44.37,Main-207+,,0,0,0,,Bu... Kuja Korsanları'nın Bayrağı!
Dialogue: 50,0:24:44.37,0:24:45.87,Main-207+,,0,0,0,,"Kuja" mı?
Dialogue: 50,0:24:45.87,0:24:50.71,Main-207+,,0,0,0,,Bir Shichibukai olan, Korsan İmparatoriçe \Ntarafından yönetilen güçlü, Amazon korsanları.
Dialogue: 50,0:24:50.71,0:24:52.11,Main-207+,,0,0,0,,Shichibukai mi?!
Dialogue: 50,0:24:52.11,0:24:54.18,Main-207+,,0,0,0,,Adı Boa Hancock.
Dialogue: 50,0:24:54.18,0:25:00.25,Main-207+,,0,0,0,,Onu gören herkesin ona anında \Naşık olup taşa dönüştüğünü söylerler.
Dialogue: 50,0:25:00.25,0:25:03.32,Main-207+,,0,0,0,,Oh, çok parlak!\NAmma da göz kamaştırıyor!
Dialogue: 50,0:25:03.32,0:25:05.69,Main-207+,,0,0,0,,Güzelliğinin bir sonu yok!
Dialogue: 50,0:25:05.69,0:25:08.39,Main-207+,,0,0,0,,Oh şaka yapmıyormuşsun!\NTam bir tanrıça gibi!
Dialogue: 50,0:25:09.26,0:25:10.86,Main-207+,,0,0,0,,Tanrıça mı?!
Dialogue: 50,0:25:10.86,0:25:11.83,Main-207+,,0,0,0,,Nerede o?!
Dialogue: 50,0:25:11.83,0:25:13.60,Main-207+,,0,0,0,,Tanrıça mı? Tanrıça mı?
Dialogue: 50,0:25:14.16,0:25:18.03,Main-207+,,0,0,0,,Tanrıça... Oh, tanrıça... Oh, tanrıça... T... T... Tanrıça...
Dialogue: 50,0:25:18.77,0:25:20.37,Main-207+,,0,0,0,,Taşa dönüştü!
Dialogue: 50,0:25:21.17,0:25:23.01,Main-207+,,0,0,0,,Hey, Hancok ve korsanları!
Dialogue: 50,0:25:23.01,0:25:23.71,Main-207+,,0,0,0,,– Ha?\N– Ha?
Dialogue: 50,0:25:24.57,0:25:27.31,Main-207+,,0,0,0,,Gemini çek, Boa Hancock!
Dialogue: 50,0:25:27.31,0:25:29.71,Main-207+,,0,0,0,,İşimize engel olmaya mı çalışıyorsun?
Dialogue: 50,0:25:29.71,0:25:31.68,Main-207+,,0,0,0,,Asılsız ithamlarınıza derhal son verin!
Dialogue: 50,0:25:31.68,0:25:34.98,Main-207+,,0,0,0,,Benim yolumdan çekilesim pek yok.
Dialogue: 50,0:25:34.98,0:25:37.19,Main-207+,,0,0,0,,T-tam bir çocuk gibi davranıyor!
Dialogue: 50,0:25:37.65,0:25:38.79,Main-207+,,0,0,0,,Bir sorun olur mu?
Dialogue: 50,0:25:40.89,0:25:44.06,Flashbacks-207+,,0,0,0,,Git, Luffy. İşte sana fırsat!
Dialogue: 50,0:25:44.86,0:25:48.70,Main-207+,,0,0,0,,Bize göz kırptı!
Dialogue: 50,0:25:48.70,0:25:51.07,Main-207+,,0,0,0,,Bize yardım etti.\NHaydi hemen yelken açalım!
Dialogue: 50,0:25:51.07,0:25:52.94,Main-207+,,0,0,0,,O Shichibukai ile tanışıyor musunuz?
Dialogue: 50,0:25:52.94,0:25:57.64,Main-207+,,0,0,0,,Evet... Kadınlar Adası'na gönderildim\Nve onlarla arkadaş olduk.
Dialogue: 50,0:25:57.64,0:26:00.81,Main-207+,,0,0,0,,Orası ağzına kadar kadınla \Ndolu efsanevi ada, değil mi?
Dialogue: 50,0:26:00.81,0:26:02.08,Main-207+,,0,0,0,,Gerçek olduğunu bilmiyordum...
Dialogue: 50,0:26:02.68,0:26:05.51,Main-207+,,0,0,0,,Korsan İmparatoriçe ile arkadaş mı?!
Dialogue: 50,0:26:05.51,0:26:09.89,Main-207+,,0,0,0,,Hey! Hiç bir kere bile antrenman yaptın mı ki sen?!
Dialogue: 50,0:26:09.89,0:26:11.05,Main-207+,,0,0,0,,Evet, tamamen hazırım!
Dialogue: 50,0:26:11.05,0:26:14.89,Main-207+,,0,0,0,,Kahretsin... Bu hiç adil değil..! Hiç adil değil..!
Dialogue: 50,0:26:14.89,0:26:16.46,Main-207+,,0,0,0,,İyi misin, Sanji?
Dialogue: 50,0:26:17.36,0:26:20.40,Main-207+,,0,0,0,,Vay, demek onlar Luffy'nin arkadaşları!
Dialogue: 50,0:26:20.40,0:26:23.83,Main-207+,,0,0,0,,Daha önce hiç görmediğim bir sürü yaratık var.
Dialogue: 50,0:26:23.83,0:26:26.47,Main-207+,,0,0,0,,– Bir, iki, üç, dört...\N– Eğleniyor gibi duruyorlar!
Dialogue: 50,0:26:27.17,0:26:30.14,Main-207+,,0,0,0,,Tamamdır, yelken açmaya hazır olun!
Dialogue: 50,0:26:30.14,0:26:31.91,Main-207+,,0,0,0,,– Evet!\N– Evet, Nami-{\i1}swan{\i0}!
Dialogue: 50,0:26:31.91,0:26:34.94,Main-207+,,0,0,0,,Ha? Sorun nedir, Usopp?
Dialogue: 50,0:26:34.94,0:26:39.05,Main-207+,,0,0,0,,Sadece...\Nsizler tüm o denizcileri patakladınız mı?
Dialogue: 50,0:26:39.05,0:26:43.72,Main-207+,,0,0,0,,Hayır. Uçarak uzaklaşırken hala \Nbize bağırdıklarını duyabiliyorduk.
Dialogue: 50,0:26:44.62,0:26:47.82,Main-207+,,0,0,0,,O halde, neden \Nadadan peşimize düşmediler?
Dialogue: 50,0:26:55.43,0:26:57.67,Main-207+,,0,0,0,,Burası Takviye Takımı 3!
Dialogue: 50,0:26:57.67,0:26:58.77,Main-207+,,0,0,0,,Beni duyabiliyor musunuz?
Dialogue: 50,0:27:00.00,0:27:01.97,Main-207+,,0,0,0,,{\i1}Ne oldu?
Dialogue: 50,0:27:01.97,0:27:04.61,Main-207+,,0,0,0,,Koru 42'ye geçemiyoruz!
Dialogue: 50,0:27:04.61,0:27:05.71,Main-207+,,0,0,0,,{\i1}Neden?!
Dialogue: 50,0:27:05.71,0:27:07.74,Main-207+,,0,0,0,,Ç-çünkü...
Dialogue: 50,0:27:07.74,0:27:10.55,Main-207+,,0,0,0,,...yolumuzu kesen kocaman böcekler var!
Dialogue: 50,0:27:10.55,0:27:12.01,Main-207+,,0,0,0,,{\i1}Ne? Böcekler mi?!
Dialogue: 50,0:27:14.92,0:27:16.65,Main-207+,,0,0,0,,Onlar da ne?!
Dialogue: 50,0:27:20.42,0:27:21.76,Main-207+,,0,0,0,,Ateş!
Dialogue: 50,0:27:29.20,0:27:33.27,Main-207+,,0,0,0,,Usopp-{\i1}un{\i0}'un yeni macera-{\i1}un{\i0}'unu \Nmahvetmelerine izin vermeyeceğim!
Dialogue: 50,0:27:36.67,0:27:39.44,Main-207+,,0,0,0,,Erkekler yollarını ayırdığı zaman,\Ngöz yaşı dökmeyiz-{\i1}un{\i0}.
Dialogue: 50,0:27:40.54,0:27:43.65,Main-207+,,0,0,0,,İyi şanslar, Usopp-{\i1}un{\i0}!
Dialogue: 50,0:27:45.11,0:27:47.55,Main-207+,,0,0,0,,Gelmedikleri sürece, sorun yok.
Dialogue: 50,0:27:47.55,0:27:50.05,Main-207+,,0,0,0,,Eğer başları dertteyse, \Nsansımız yaver gitti.
Dialogue: 50,0:27:50.05,0:27:52.35,Main-207+,,0,0,0,,Hadi artık ayrılalım!
Dialogue: 50,0:27:52.35,0:27:54.72,Main-207+,,0,0,0,,Nami, yolu göster!
Dialogue: 50,0:27:54.72,0:27:55.52,Main-207+,,0,0,0,,Bana bırakın!
Dialogue: 50,0:27:57.56,0:27:58.33,Main-207+,,0,0,0,,Tamamdır!
Dialogue: 50,0:28:00.83,0:28:02.03,Main-207+,,0,0,0,,Burası Takım 4.
Dialogue: 50,0:28:02.03,0:28:03.77,Main-207+,,0,0,0,,Üzgünüm.
Dialogue: 50,0:28:03.77,0:28:07.10,Main-207+,,0,0,0,,Bir anda yağmur başladı ve ıslak barut ateş almıyor!
Dialogue: 50,0:28:07.10,0:28:08.80,Main-207+,,0,0,0,,{\i1}Yağmur mu? Neresi yağmurlu?
Dialogue: 50,0:28:08.80,0:28:10.14,Main-207+,,0,0,0,,Yağmur mu? Neresi yağmurlu?
Dialogue: 50,0:28:10.14,0:28:14.21,Main-207+,,0,0,0,,Sabaody Takımadaları'nda hava \Nbugün güneşli olmalıydı!
Dialogue: 50,0:28:17.95,0:28:19.78,Main-207+,,0,0,0,,Şimşek kullanmayın.
Dialogue: 50,0:28:19.78,0:28:23.05,Main-207+,,0,0,0,,Sivillerin yaralanmasını istemeyiz.
Dialogue: 50,0:28:23.05,0:28:26.06,Main-207+,,0,0,0,,Baloncuklar o kadar rahatsız edici ki...
Dialogue: 50,0:28:26.06,0:28:29.66,Main-207+,,0,0,0,,Bu kadar mükemmel bir rüzgar \Nyakaladığımıza inanamıyorum.
Dialogue: 50,0:28:29.66,0:28:32.60,Main-207+,,0,0,0,,Bizi doğrudan Sabaody Takımadaları'na getirdi.
Dialogue: 50,0:28:32.60,0:28:36.57,Main-207+,,0,0,0,,Çünkü Nami-{\i1}chan{\i0} çok iyi bir kız.
Dialogue: 50,0:28:40.10,0:28:45.67,Main-207+,,0,0,0,,Bol şans!\NSeni burada Weatheria'da özleyeceğiz!
Dialogue: 50,0:29:02.42,0:29:03.73,Main-207+,,0,0,0,,Oh, şişiyor!
Dialogue: 50,0:29:05.66,0:29:08.53,Main-207+,,0,0,0,,Ne? Bu jöle şişiyor mu?
Dialogue: 50,0:29:12.07,0:29:15.07,Main-207+,,0,0,0,,Oh, baloncuk çatımız var!
Dialogue: 50,0:29:15.74,0:29:16.71,Main-207+,,0,0,0,,Herkes dinlesin.
Dialogue: 50,0:29:17.44,0:29:22.18,Main-207+,,0,0,0,,Kaplamalı bir gemi\Nher türlü basıncı hafifletebilir.
Dialogue: 50,0:29:22.18,0:29:27.68,Main-207+,,0,0,0,,Franky geminin omurgasını destekleyen \Nyüzdürme torbasını çıkardığında
Dialogue: 50,0:29:27.68,0:29:31.62,Main-207+,,0,0,0,,{\i1}Sunny{\i0}'nin kaplaması onun \Nbatmaya başlamasını sağlayacaktır.
Dialogue: 50,0:29:31.62,0:29:32.62,Main-207+,,0,0,0,,Bu şekilde çalışıyor.
Dialogue: 50,0:29:32.62,0:29:34.22,Main-207+,,0,0,0,,– Anlıyorum.\N– Anlıyorum.
Dialogue: 50,0:29:34.22,0:29:35.69,Main-207+,,0,0,0,,Çok karmaşık, he?
Dialogue: 50,0:29:35.69,0:29:37.83,Main-207+,,0,0,0,,Her neyse, yelkenleri indirin!
Dialogue: 50,0:29:37.83,0:29:38.66,Main-207+,,0,0,0,,Yelkenleri mi?
Dialogue: 50,0:29:38.66,0:29:42.83,Main-207+,,0,0,0,,Rüzgar yerine, kaplamalı olan bir gemiyi \Ndeniz akıntıları hareket ettirir.
Dialogue: 50,0:29:42.83,0:29:45.87,Main-207+,,0,0,0,,Yani sadece gittiği yere batmaz.
Dialogue: 50,0:29:46.54,0:29:49.37,Main-207+,,0,0,0,,Peki! Donanma tekrar ortaya \Nçıkmadan önce acele edelim!
Dialogue: 50,0:29:50.71,0:29:54.08,Main-207+,,0,0,0,,Burası Koru 42'den Merkez Takımı 5!
Dialogue: 50,0:29:54.08,0:29:55.74,Main-207+,,0,0,0,,Bu bir acil durumdur!
Dialogue: 50,0:29:55.74,0:29:59.65,Main-207+,,0,0,0,,Bizden önce gelen ekipler, \NTakım 2, hepsi... ehm... negatif oldular!
Dialogue: 50,0:29:59.65,0:30:01.78,Main-207+,,0,0,0,,{\i1}"Negatif" diyerek ne demeye çalışıyorsun?
Dialogue: 50,0:30:01.78,0:30:03.05,Main-207+,,0,0,0,,Yosun olmak istiyorum...
Dialogue: 50,0:30:03.05,0:30:05.85,Main-207+,,0,0,0,,İyi değilim.\NSu piresi olmak istiyorum...
Dialogue: 50,0:30:05.85,0:30:10.63,Main-207+,,0,0,0,,Dediklerine göre Hasır Şapkalı Luffy\Ndev bir kuşa binmiş ve uçup gitmiş!
Dialogue: 50,0:30:10.63,0:30:13.20,Main-207+,,0,0,0,,{\i1}Kuş mu? Sizler şimdi ne yapıyorsunuz?!
Dialogue: 50,0:30:13.20,0:30:16.03,Main-207+,,0,0,0,,Bilinmeyen düşmanlara karşı savaşıyoruz!
Dialogue: 50,0:30:17.20,0:30:20.87,Main-207+,,0,0,0,,Donanma takviyeleri!\NTam da ayrılmak üzereydik...
Dialogue: 50,0:30:20.87,0:30:22.74,Main-207+,,0,0,0,,Herkes baksın!
Dialogue: 50,0:30:24.74,0:30:27.34,Main-207+,,0,0,0,,Hasır Şapka'nın gemisi artık menzilde!
Dialogue: 50,0:30:28.51,0:30:31.51,Main-207+,,0,0,0,,Bekle bir dakika!\NDev bir kuş bize doğru geliyor!
Dialogue: 50,0:30:41.49,0:30:42.99,Main-207+,,0,0,0,,Bu o!
Dialogue: 50,0:30:44.53,0:30:45.86,Main-207+,,0,0,0,,Artık arkamızdalar!
Dialogue: 50,0:30:45.86,0:30:47.16,Main-207+,,0,0,0,,Ben hallederim!
Dialogue: 50,0:30:49.77,0:30:51.10,Flashbacks-207+,,0,0,0,,Nasıldım, Nami-{\i1}san{\i0}?
Dialogue: 50,0:30:51.10,0:30:53.30,Flashbacks-207+,,0,0,0,,Lütfen beni izliyor ol...
Dialogue: 50,0:30:53.30,0:30:55.80,Flashbacks-207+,,0,0,0,,Ne kadar güçlendiğimi gör.
Dialogue: 50,0:30:55.80,0:30:58.07,Main-207+,,0,0,0,,Sanji!
Dialogue: 50,0:31:00.54,0:31:03.55,Main-207+,,0,0,0,,Cevap ver, Takım 5! \NNeler oluyor?!
Dialogue: 50,0:31:03.55,0:31:05.61,Main-207+,,0,0,0,,{\i1}B-biz...
Dialogue: 50,0:31:05.61,0:31:10.25,Main-207+,,0,0,0,,Beklenmedik...\Nengellerle karşılaşıyoruz...
Dialogue: 50,0:31:10.25,0:31:11.75,Main-207+,,0,0,0,,Yapmayın!
Dialogue: 50,0:31:14.22,0:31:18.26,Main-207+,,0,0,0,,Bizi bu şekilde reddetmeye \Nnasıl cürret edersiniz?
Dialogue: 50,0:31:18.26,0:31:20.70,Main-207+,,0,0,0,,Belki hepsi de utangaçtır.
Dialogue: 50,0:31:20.70,0:31:23.60,Main-207+,,0,0,0,,Utanmanıza gerek yok!
Dialogue: 50,0:31:24.20,0:31:27.14,Main-207+,,0,0,0,,Bir ara çay içmeye çıkalım!
Dialogue: 50,0:31:27.90,0:31:31.81,Main-207+,,0,0,0,,Be-be-ben deli...\NBen deliriyorum, değil mi?!
Dialogue: 50,0:31:34.44,0:31:38.21,Main-207+,,0,0,0,,Ah!\NAmma da sevimli bir suratın varmış!
Dialogue: 50,0:31:38.21,0:31:39.35,Main-207+,,0,0,0,,Hayır, yapma!
Dialogue: 50,0:31:42.25,0:31:44.92,Main-207+,,0,0,0,,{\i1}Sorun ne? Cevap ver, Takım 5!
Dialogue: 50,0:31:46.76,0:31:49.02,Flashbacks-207+,,0,0,0,,Sanji-{\i1}kyun{\i0}, işte sana fırsat!
Dialogue: 50,0:31:51.46,0:31:53.90,Main-207+,,0,0,0,,Hey, hey, sorun ne, Sanji?!
Dialogue: 50,0:31:55.06,0:32:00.24,Main-207+,,0,0,0,,B-b-ben bilemiyorum... Birden bire,\Nsanki birileri kalbimi sıkıyormuş gibi hissettim...
Dialogue: 50,0:32:00.24,0:32:01.87,Main-207+,,0,0,0,,Yüzdürme torbasını çıkardım!
Dialogue: 50,0:32:01.87,0:32:04.04,Main-207+,,0,0,0,,Tamam! Yelken ne durumda?
Dialogue: 50,0:32:04.04,0:32:06.34,Main-207+,,0,0,0,,Sen hazır olduğunda hazırız!
Dialogue: 50,0:32:06.91,0:32:08.41,Main-207+,,0,0,0,,Gitme zamanı mı, Nami?
Dialogue: 50,0:32:08.41,0:32:10.41,Main-207+,,0,0,0,,Evet, emirinizle, Kaptan.
Dialogue: 50,0:32:17.75,0:32:18.92,Main-207+,,0,0,0,,Tamamdır.
Dialogue: 50,0:32:23.43,0:32:25.13,Main-207+,,0,0,0,,Hey millet!
Dialogue: 50,0:32:26.26,0:32:31.23,Main-207+,,0,0,0,,Size söylemek istediğim \Nçok şey var ama öncelikle...
Dialogue: 50,0:32:31.23,0:32:35.24,Main-207+,,0,0,0,,...iki yıl boyunca benim bencil kararıma \Nuyduğunuz için teşekkür ederim!
Dialogue: 50,0:32:35.24,0:32:38.04,Main-207+,,0,0,0,,Sanki bu ilk defa oluyor da.
Dialogue: 50,0:32:38.04,0:32:41.24,Main-207+,,0,0,0,,Çok haklı! Sen hep böyleydin!
Dialogue: 50,0:32:45.81,0:32:49.72,Main-207+,,0,0,0,,Tuğamiral, korsan gemisi batıyor!
Dialogue: 50,0:32:49.72,0:32:51.72,Main-207+,,0,0,0,,Ne?! Lanet olsun!
Dialogue: 50,0:32:51.72,0:32:53.09,Main-207+,,0,0,0,,Kahretsin seni!
Dialogue: 50,0:32:53.09,0:32:54.99,Main-207+,,0,0,0,,O korsanların ne kadar...
Dialogue: 50,0:32:54.99,0:32:57.56,Main-207+,,0,0,0,,...şeytan oldukları konusunda\Nbir fikrin var mı?
Dialogue: 50,0:32:57.56,0:32:58.99,Main-207+,,0,0,0,,Tuğamiral!
Dialogue: 50,0:32:59.96,0:33:02.53,FlashbackSecondary-207+,,0,0,0,,Dikkatli ol, Luffy.
Dialogue: 50,0:33:05.40,0:33:07.57,Main-207+,,0,0,0,,Yelkenleri indirin!
Dialogue: 50,0:33:07.57,0:33:08.70,Main-207+,,0,0,0,,– Evet!\N– Evet!
Dialogue: 50,0:33:16.41,0:33:19.41,Main-207+,,0,0,0,,Yelkenler fora!
Dialogue: 50,0:33:19.41,0:33:21.78,Main-207+,,0,0,0,,– Evet!\N– Evet!
Dialogue: 50,0:33:28.29,0:33:32.29,Main-207+,,0,0,0,,Haydi Balık Adam Adası'na gidelim!
