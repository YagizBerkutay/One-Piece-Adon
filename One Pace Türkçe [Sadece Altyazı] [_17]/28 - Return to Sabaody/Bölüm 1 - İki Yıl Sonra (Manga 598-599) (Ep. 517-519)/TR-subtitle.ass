0000,&H00000000,0,0,0,0,100,100,0,0,1,1.2,1.2,8,10,10,10,1Style: Author,Impress BT Pace,28.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1,1,9,10,10,10,1Style: Attack,Duality,45.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.7,1.7,7,12,12,12,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 50,0:00:09.79,0:00:13.01,Narrator-207+,,0,0,0,,Donanma Karargâhı, Shichibukai ve...Dialogue: 50,0:00:09.79,0:00:13.01,Note,,0,0,0,,Shichibukai: Yedi Savaş AğasıDialogue: 50,0:00:13.01,0:00:18.55,Narrator-207+,,0,0,0,,...Beyazsakal Korsanları arasındaki  Zirve Savaşı'nın üzerinden iki yıl geçti.Dialogue: 50,0:00:20.14,0:00:25.71,Narrator-207+,,0,0,0,,Kadınlar Adası'nın kuzey batısında  ıssız ada, Luscaina..Dialogue: 50,0:00:26.44,0:00:28.50,Main-207+,,0,0,0,,Luffy!Dialogue: 50,0:00:28.50,0:00:31.32,Main-207+,,0,0,0,,Tamam! Geliyorum!Dialogue: 50,0:00:38.96,0:00:43.93,Main-207+,,0,0,0,,İnanamıyorum.  İki yıl oldu bile.Dialogue: 50,0:01:21.60,0:01:22.57,Main-207+,,0,0,0,,Hey!Dialogue: 50,0:01:25.57,0:01:28.51,Main-207+,,0,0,0,,Dikkat edin.  O benim arkadaşım.Dialogue: 50,0:01:35.48,0:01:39.84,Main-207+,,0,0,0,,Luffy, gemi sen ne zaman  istersen yelken açmaya hazır!Dialogue: 50,0:01:39.84,0:01:42.12,Main-207+,,0,0,0,,Tamam, teşekkürler!Dialogue: 50,0:01:43.42,0:01:44.70,Main-207+,,0,0,0,,Bu harika.Dialogue: 50,0:01:44.70,0:01:47.02,Main-207+,,0,0,0,,Adanın patronu artık o.Dialogue: 50,0:01:47.88,0:01:54.68,Main-207+,,0,0,0,,Olay şu ki, biz arkadaş olduk, yani onları yemek olarak görmekten artık vazgeçtim.Dialogue: 50,0:01:54.68,0:01:57.00,Main-207+,,0,0,0,,Yine de çok leziz görünüyorlar.Dialogue: 50,0:01:57.78,0:01:59.57,Main-207+,,0,0,0,,Sorun yok, Luffy.Dialogue: 50,0:01:59.57,0:02:03.09,Main-207+,,0,0,0,,Tüm favori yemeklerin gemide mevcut.Dialogue: 50,0:02:03.09,0:02:07.28,Main-207+,,0,0,0,,Bu kadar düşünceli olduğuma  göre çok iyi bir eş olacağım.Dialogue: 50,0:02:08.13,0:02:11.18,Main-207+,,0,0,0,,Evlenmeyeceğim, ama yemekler için teşekkür ederim!Dialogue: 50,0:02:12.01,0:02:14.52,Main-207+,,0,0,0,,Bu sert tarafını sevmekten  kendimi alıkoyamıyorum!Dialogue: 50,0:02:15.43,0:02:18.10,Main-207+,,0,0,0,,Rayleigh altı ay önce ayrıldı.Dialogue: 50,0:02:18.10,0:02:21.10,Main-207+,,0,0,0,,Seni Sabaody'de bekliyor olmalı.Dialogue: 50,0:02:21.10,0:02:24.90,Main-207+,,0,0,0,,Bana temel şeyleri öğretmeyi  bir buçuk yılda tamamladı.Dialogue: 50,0:02:24.90,0:02:28.47,Main-207+,,0,0,0,,Artık size ve adaya  veda etme vakti çocuklar!Dialogue: 50,0:02:31.62,0:02:32.82,Main-207+,,0,0,0,,Pekala...Dialogue: 50,0:02:34.80,0:02:36.04,Main-207+,,0,0,0,,Haydi gidelim!Dialogue: 50,0:04:41.27,0:04:44.43,Main-207+,,0,0,0,,Donanma Karargâhı'nın taşındığını  biliyor muydun?Dialogue: 50,0:04:44.43,0:04:46.84,Main-207+,,0,0,0,,Ne? Taşındı mı?Dialogue: 50,0:04:46.84,0:04:51.07,Main-207+,,0,0,0,,Evet, G-1 şubesi ile yer değiştirdiler...Dialogue: 50,0:04:51.07,0:04:53.54,Main-207+,,0,0,0,,...Red Line'ın diğer tarafında kaldı.Dialogue: 50,0:04:54.14,0:04:57.78,Main-207+,,0,0,0,,Sengoku'nun varisi  bu kadar kararlı biri işte.Dialogue: 50,0:04:57.78,0:05:03.55,Main-207+,,0,0,0,,Ne de olsa, karargâhı Yonko'nun da bulunduğu denize kurdu.Dialogue: 50,0:05:04.19,0:05:08.09,Main-207+,,0,0,0,,Ama değişim sayesinde  karargâh'ın etkisi burada daha az...Dialogue: 50,0:05:08.09,0:05:10.69,Main-207+,,0,0,0,,...yani adada daha fazla  kanunsuz bölge var.Dialogue: 50,0:05:11.96,0:05:17.33,Main-207+,,0,0,0,,Hmm, iki yıl önceye göre daha katı  görünüyor olmasına şaşmamalı.Dialogue: 50,0:05:17.33,0:05:19.14,Main-207+,,0,0,0,,Hey, bunu gördün mü?!Dialogue: 50,0:05:19.14,0:05:21.04,Main-207+,,0,0,0,,Evet, ben de şaşkına döndüm.Dialogue: 50,0:05:21.04,0:05:25.44,Main-207+,,0,0,0,,Hasır Şapka'ların tekar  ortaya çıktığına inanamıyorum!Dialogue: 50,0:05:25.44,0:05:30.78,Main-207+,,0,0,0,,Harbiden. İki yıldır sessizdiler, o yüzden onların öldüğünü düşünmüştük.Dialogue: 50,0:05:31.08,0:05:34.18,Main-207+,,0,0,0,,Tayfaya adam bile arıyorlar!Dialogue: 50,0:05:34.18,0:05:38.16,Main-207+,,0,0,0,,Dialogue: 50,0:05:38.16,0:05:40.79,Main-207+,,0,0,0,,Dialogue: 50,0:05:34.18,0:05:40.79,Main-207+,,0,0,0,,Grand Line'ın ilk yarısında hayatta  kalabilen korsanlar gelmeye devam ediyor.Dialogue: 50,0:05:40.79,0:05:45.80,Main-207+,,0,0,0,,Yeni Dünya'da vahşice koşturmadan önce tayfasını  genişletmek için onları kendisine katıyor.Dialogue: 50,0:05:45.80,0:05:49.23,Main-207+,,0,0,0,,Heyecan verici duruyor!  Belki ben de katılmalıyım!Dialogue: 50,0:05:49.23,0:05:50.73,Main-207+,,0,0,0,,İmkanı yok!Dialogue: 50,0:05:50.73,0:05:54.24,Main-207+,,0,0,0,,Şu an adada 100 milyonun  üstünde ödülü olan insanlar var.Dialogue: 50,0:05:54.24,0:05:57.41,Main-207+,,0,0,0,,Seni kesinlikle almazlar!Dialogue: 50,0:05:57.41,0:05:59.44,Main-207+,,0,0,0,,Ne?!Dialogue: 50,0:06:06.18,0:06:08.36,Main-207+,,0,0,0,,Hey, deme öyle!Dialogue: 50,0:06:08.36,0:06:09.82,Main-207+,,0,0,0,,Bu konuda bir şey yapamaz mısın?Dialogue: 50,0:06:09.82,0:06:14.16,Main-207+,,0,0,0,,Biletler tükendi!  Ne olmasını bekliyordun?!Dialogue: 50,0:06:14.16,0:06:18.45,Main-207+,,0,0,0,,Burada süperstar Ruh Kralı Brook'un  dünya turnesinden bahsediyoruz!Dialogue: 50,0:06:18.45,0:06:21.13,Main-207+,,0,0,0,,Bu ada turnenin son durağı!Dialogue: 50,0:06:21.13,0:06:24.12,Main-207+,,0,0,0,,Mekan zaten doldu!Dialogue: 50,0:06:29.01,0:06:30.71,Main-207+,,0,0,0,,Menajer!Dialogue: 50,0:06:31.73,0:06:35.67,Main-207+,,0,0,0,,Bugün ortaya harika bir gösteri koyacağım!Dialogue: 50,0:06:35.67,0:06:38.40,Main-207+,,0,0,0,,Evet, bu harika olur!Dialogue: 50,0:06:38.40,0:06:42.62,Main-207+,,0,0,0,,TD'lerin harika gidiyor ve  bir milyon kopya sattı!Dialogue: 0,0:06:38.40,0:06:42.62,Note,,0,0,0,,TD: Kadran türlerinden müzik dinleteni, Tone Dial.Dialogue: 50,0:06:42.62,0:06:46.26,Main-207+,,0,0,0,,Sen kesinlikle soul müziğinin kralısın.Dialogue: 50,0:06:46.26,0:06:49.12,Main-207+,,0,0,0,,Kalabağı dinle!Dialogue: 50,0:06:49.12,0:06:58.00,Secondary-207+,,0,0,0,,Ruh Kralı! Ruh Kralı! Ruh Kralı! Ruh Kralı!Dialogue: 50,0:06:53.17,0:06:54.50,Main-207+,,0,0,0,,Menajer...Dialogue: 50,0:06:55.63,0:06:58.00,Main-207+,,0,0,0,,...konserden önce...Dialogue: 50,0:06:58.70,0:07:00.57,Main-207+,,0,0,0,,...sana söylemem gereken önemli bir şey var.Dialogue: 50,0:07:02.52,0:07:04.25,Main-207+,,0,0,0,,Neymiş?Dialogue: 50,0:07:10.03,0:07:11.83,Main-207+,,0,0,0,,Haydi, bebeğim!Dialogue: 50,0:07:11.83,0:07:13.75,Secondary-207+,,0,0,0,,Evet!Dialogue: 50,0:07:13.75,0:07:16.05,Main-207+,,0,0,0,,Biz...Dialogue: 50,0:07:16.05,0:07:18.42,Secondary-207+,,0,0,0,,...kemikteniz!Dialogue: 50,0:07:18.42,0:07:19.29,Main-207+,,0,0,0,,Kemikteniz!Dialogue: 50,0:07:19.29,0:07:20.39,Secondary-207+,,0,0,0,,Kemikteniz!Dialogue: 50,0:07:20.39,0:07:21.36,Main-207+,,0,0,0,,Kemikteniz!Dialogue: 50,0:07:21.36,0:07:22.53,Secondary-207+,,0,0,0,,Kemikteniz!Dialogue: 50,0:07:22.53,0:07:22.92,Main-207+,,0,0,0,,Kemikteniz!Dialogue: 50,0:07:22.92,0:07:23.53,Secondary-207+,,0,0,0,,Kemikteniz!Dialogue: 50,0:07:23.53,0:07:23.89,Main-207+,,0,0,0,,Kemikteniz!Dialogue: 50,0:07:23.89,0:07:24.43,Secondary-207+,,0,0,0,,Kemikteniz!Dialogue: 50,0:07:24.43,0:07:24.83,Main-207+,,0,0,0,,Kemikteniz! Kemikteniz! Kemikteniz!Dialogue: 50,0:07:24.83,0:07:25.31,Main-207+,,0,0,0,,Kemikteniz! Kemikteniz!  Kemikteniz!Dialogue: 50,0:07:25.31,0:07:25.86,Main-207+,,0,0,0,,Kemikteniz! Kemikteniz! Kemikteniz!Dialogue: 50,0:07:25.86,0:07:28.33,Main-207+,,0,0,0,,Kemikteniz!Dialogue: 50,0:07:34.71,0:07:40.01,Rock Concert Secondary,,0,0,0,,♪ Vahşi olmak için kemikteniz! ♪Dialogue: 50,0:07:38.98,0:07:43.16,Main-207+,,0,0,0,,İnanamıyorum...  Nasıl bu kadar bencil olabilir?!Dialogue: 50,0:07:43.16,0:07:45.65,Main-207+,,0,0,0,,Hey, bana Den Den Mushi'yi ver!Dialogue: 50,0:07:45.65,0:07:49.55,Main-207+,,0,0,0,,Bu işten o kadar kolay kurtulmana izin vermeyeceğim, Brook!Dialogue: 50,0:07:49.55,0:07:57.16,Main-207+,,0,0,0,,Bugünü en iyi yıl dönümü yapalım!Dialogue: 50,0:08:09.62,0:08:12.74,Main-207+,,0,0,0,,Kadınlar! Gerçek olanlar!Dialogue: 50,0:08:13.56,0:08:15.76,Main-207+,,0,0,0,,Ah, buna hiç şüphe yok!Dialogue: 50,0:08:15.76,0:08:19.35,Main-207+,,0,0,0,,Önümde gerçek hanımlar var!Dialogue: 50,0:08:21.06,0:08:24.04,Main-207+,,0,0,0,,Burada, bu adada, her gece...Dialogue: 50,0:08:24.04,0:08:26.92,Main-207+,,0,0,0,,...hayalini kurduğum gerçek kadınlar var!Dialogue: 50,0:08:27.43,0:08:29.09,Main-207+,,0,0,0,,Yaşasın Sabaody!Dialogue: 50,0:08:29.09,0:08:32.40,Main-207+,,0,0,0,,Bir hanıma ihtiyacım var!Dialogue: 50,0:08:32.40,0:08:33.82,Main-207+,,0,0,0,,Sanji-kyun!Dialogue: 50,0:08:34.63,0:08:36.81,Main-207+,,0,0,0,,Seni burada bırakıyoruz.Dialogue: 50,0:08:36.81,0:08:39.98,Main-207+,,0,0,0,,Ayrılmak istemiyorum, ama bir gün eminim tekrar bir araya geleceğiz!Dialogue: 50,0:08:42.32,0:08:46.41,Main-207+,,0,0,0,,Ben sizi bir daha asla görmek istemiyorum! Yolculuk için teşekkürer! Ivan'a selamlarımı iletin!Dialogue: 50,0:08:46.41,0:08:47.88,Main-207+,,0,0,0,,Adam gibi adam, Sanji...Dialogue: 50,0:08:47.88,0:08:51.03,Main-207+,,0,0,0,,...cehennemden resmen dönmüştür!Dialogue: 50,0:08:51.03,0:08:52.34,Main-207+,,0,0,0,,Ne derler bilirsin.Dialogue: 50,0:08:52.34,0:08:55.71,Main-207+,,0,0,0,,Erkekler hoşlandığı kızlara kaba davranmaktan kendini alıkoyamaz.Dialogue: 50,0:08:55.71,0:08:58.29,Main-207+,,0,0,0,,Çok doğru. Başıma gelmişti.Dialogue: 50,0:08:58.29,0:09:01.66,Main-207+,,0,0,0,,Onu asla unutmayacağım!Dialogue: 50,0:09:01.66,0:09:06.23,Main-207+,,0,0,0,,Bekleyin beni, Nami-swan, Robin-chwan!Dialogue: 50,0:09:12.20,0:09:15.61,Main-207+,,0,0,0,,He? Yanlış mı duydum?Dialogue: 50,0:09:15.61,0:09:19.38,Main-207+,,0,0,0,,55 milyon beli ödül mü?Dialogue: 50,0:09:19.38,0:09:22.67,Main-207+,,0,0,8,,Posteri tekrar kontrol et!Dialogue: 50,0:09:22.67,0:09:26.34,Main-207+,,0,0,8,,Diyor ki,  "70 milyonun ödülün altındakiler başvuramaz."Dialogue: 50,0:09:26.34,0:09:30.09,Main-207+,,0,0,8,,Daha aşağıdaki  kaptanlarla uğraşacak değiliz.Dialogue: 50,0:09:30.09,0:09:34.51,Main-207+,,0,0,0,,Sizler nasıl buraya tek  parça halinde geldiniz?Dialogue: 50,0:09:35.54,0:09:36.89,Main-207+,,0,0,0,,Lanet olsun!Dialogue: 50,0:09:36.89,0:09:39.13,Main-207+,,0,0,0,,Kaybol, pislik.Dialogue: 50,0:09:39.13,0:09:42.40,Main-207+,,0,0,0,,Devrimci Dragon'un oğlu  olduğumu bilmiyor musun?!Dialogue: 50,0:09:45.37,0:09:48.20,Main-207+,,0,0,8,,Ayak bağı olacak birine ihtiyacımız yok!Dialogue: 50,0:09:48.20,0:09:50.51,Main-207+,,0,0,8,,Biz özel bir korsan tayfasıyız!Dialogue: 50,0:09:50.51,0:09:52.75,Main-207+,,0,0,8,,Bizim ligimiz farklı.Dialogue: 50,0:09:52.75,0:09:56.18,Main-207+,,0,0,8,,Önüne gelenin bize katılabileceğini sanma.Dialogue: 50,0:09:57.93,0:09:58.78,Main-207+,,0,0,0,,Kaybol.Dialogue: 50,0:10:04.19,0:10:06.80,Main-207+,,0,0,0,,Hasır Şapka Luffy merhametsiz.Dialogue: 50,0:10:06.80,0:10:09.26,Main-207+,,0,0,0,,Eh evet, daha şimdiden  çok fazla şey başardı.Dialogue: 50,0:10:11.29,0:10:15.29,Main-207+,,0,0,0,,Hey Franky, şimdiden kaç kişi aldık?Dialogue: 50,0:10:15.29,0:10:17.37,Main-207+,,0,0,0,,Yüz kadar.Dialogue: 50,0:10:17.37,0:10:20.20,Main-207+,,0,0,0,,Grup halinde üç korsan tayfası katıldı.Dialogue: 50,0:10:20.20,0:10:22.65,Main-207+,,0,0,0,,On tanesinin ödülü var.Dialogue: 50,0:10:23.60,0:10:28.33,Main-207+,,0,0,0,,Güzel ve onlardan ikisi  yüksek profilli çaylaklar.Dialogue: 50,0:10:29.65,0:10:33.26,Main-207+,,0,0,0,,Yağlı Saç Caribou ve  Kan Sıçratan Coribou.Dialogue: 50,0:10:33.26,0:10:35.18,Main-207+,,0,0,0,,İkisi de denizci katili olarak biliniyor.Dialogue: 50,0:10:35.18,0:10:39.24,Main-207+,,0,0,0,,Bu kardeşler 210 milyon  ve 190 milyon ödüllü kaptanlar.Dialogue: 50,0:10:41.20,0:10:43.16,Main-207+,,0,0,0,,Kullanışlı olacaklar!Dialogue: 50,0:10:43.64,0:10:47.20,Main-207+,,0,0,0,,Daha fazla takipçi edinelim! Yaşlı adam, bize bir tur daha lazım!Dialogue: 50,0:10:48.21,0:10:49.20,Main-207+,,0,0,0,,E-evet!Dialogue: 50,0:10:49.20,0:10:51.34,Main-207+,,0,0,0,,Acele et!Dialogue: 50,0:10:52.77,0:10:56.41,Main-207+,,0,0,0,,Oh? Ve sen, bayan,  bir süredir oradasın.Dialogue: 50,0:10:56.93,0:11:00.25,Main-207+,,0,0,0,,Yalnız içmeyi bırak da bize katıl!Dialogue: 50,0:11:00.25,0:11:02.65,Main-207+,,0,0,0,,Amma da şirinmiş.Dialogue: 50,0:11:08.72,0:11:11.69,Main-207+,,0,0,0,,Hayatta olmaz. Birini bekliyorum.Dialogue: 50,0:11:11.69,0:11:13.22,Main-207+,,0,0,0,,Ne?Dialogue: 50,0:11:13.99,0:11:15.39,Main-207+,,0,0,0,,Onu reddetti.Dialogue: 50,0:11:15.39,0:11:18.46,Main-207+,,0,0,0,,Hey, hey, evet demen daha iyi olur!Dialogue: 50,0:11:18.46,0:11:20.56,Main-207+,,0,0,0,,O Hasır Şapka Luffy!Dialogue: 50,0:11:20.56,0:11:21.40,Main-207+,,0,0,0,,Hatırladın mı?Dialogue: 50,0:11:21.40,0:11:25.54,Main-207+,,0,0,0,,İki yıl önce Zirve Savaşı'na  dalan çılgın korsan!Dialogue: 50,0:11:25.54,0:11:26.64,Main-207+,,0,0,0,,Onu duydun, değil mi?!Dialogue: 50,0:11:28.34,0:11:30.07,Main-207+,,0,0,0,,Birini mi bekliyorsun?Dialogue: 50,0:11:30.07,0:11:35.45,Main-207+,,0,0,0,,Kaptan Luffy'nin adını duyduğunda merhamet  için ağlayıp yalvaracak olan pısırık biri olmalı.Dialogue: 50,0:11:35.45,0:11:37.81,Main-207+,,0,0,0,,Gel buraya!Dialogue: 50,0:11:39.25,0:11:41.65,Main-207+,,0,0,0,,Sadece bir kere söyleyeceğim!Dialogue: 50,0:11:42.62,0:11:46.62,Main-207+,,0,0,0,,Sen ve ben iyi bir eşleşme değiliz, o yüzden seninle içmiyorum.Dialogue: 50,0:11:50.26,0:11:51.33,Main-207+,,0,0,0,,Ne?Dialogue: 50,0:11:52.13,0:11:56.23,Main-207+,,0,0,0,,Anladın mı, Hasır Şapka... kim demiştin?Dialogue: 50,0:11:58.42,0:11:59.25,Main-207+,,0,0,0,,Ha?Dialogue: 50,0:12:01.17,0:12:02.74,Main-207+,,0,0,0,,"Kim" mi dedin sen?!Dialogue: 50,0:12:04.41,0:12:06.44,Main-207+,,0,0,0,,Ben Hasır Şapka Luffy!Dialogue: 50,0:12:08.24,0:12:11.45,Main-207+,,0,0,0,,Hey, özür dilesen iyi olur! Tehlikedesin!Dialogue: 50,0:12:11.45,0:12:12.38,Main-207+,,0,0,0,,He?Dialogue: 50,0:12:17.05,0:12:20.06,Main-207+,,0,0,0,,Baya cesurmuşsun!Dialogue: 50,0:12:22.69,0:12:24.89,Main-207+,,0,0,0,,Bırak ben halledeyim.Dialogue: 50,0:12:26.70,0:12:31.10,Main-207+,,0,0,0,,Hey, sen! Komik kız.Dialogue: 50,0:12:32.70,0:12:35.10,Main-207+,,0,0,0,,O halde olayı senin için daha  kolay bir hale getireyim.Dialogue: 50,0:12:35.10,0:12:37.91,Main-207+,,0,0,0,,Kaptan Luffy ile birlikte içecek misin?Dialogue: 50,0:12:37.91,0:12:39.88,Main-207+,,0,0,0,,Yoksa ölecek misin?Dialogue: 50,0:12:41.24,0:12:43.51,Main-207+,,0,0,0,,Bilgin olsun, benim de bir ödülüm var.Dialogue: 50,0:12:43.51,0:12:45.72,Main-207+,,0,0,0,,Ben Kedi Hırsız Nami!Dialogue: 50,0:12:46.58,0:12:47.62,Main-207+,,0,0,0,,Benimle uğraşma!Dialogue: 50,0:12:48.38,0:12:50.29,Main-207+,,0,0,0,,Midori Boshi:Dialogue: 0,0:12:48.38,0:12:50.29,Attack,,0,0,0,,Ölümcül Yeşil Yıldız:Dialogue: 50,0:12:52.32,0:12:53.12,Main-207+,,0,0,0,,Devil!Dialogue: 0,0:12:52.32,0:12:53.12,Attack,,0,0,0,,ŞeytanDialogue: 50,0:12:58.26,0:12:59.16,Main-207+,,0,0,0,,Ha?Dialogue: 50,0:12:59.16,0:13:00.83,Main-207+,,0,0,0,,Bu-bu da ne?!Dialogue: 50,0:13:01.90,0:13:03.83,Main-207+,,0,0,0,,Bu şey neyin nesi?Dialogue: 50,0:13:05.24,0:13:07.07,Main-207+,,0,0,0,,Yardım et, Kaptan!Dialogue: 50,0:13:07.07,0:13:09.07,Main-207+,,0,0,0,,Uzaklaş benden, ahmak!Dialogue: 50,0:13:10.31,0:13:13.18,Main-207+,,0,0,0,,Bu bitki de ne?Dialogue: 50,0:13:13.18,0:13:16.31,Main-207+,,0,0,0,,Eee, genç hanım, benimle içmeye ne dersin?Dialogue: 50,0:13:23.92,0:13:25.76,Main-207+,,0,0,0,,Usopp, çok uzun zaman oldu!Dialogue: 50,0:13:25.76,0:13:29.19,Main-207+,,0,0,0,,İnanamıyorum! Çok güçlenmişsin!Dialogue: 50,0:13:29.19,0:13:33.66,Main-207+,,0,0,0,,Sen de tıpkı bir çiçek gibi açmışsın!Dialogue: 50,0:13:33.66,0:13:38.17,Main-207+,,0,0,0,,Ne?! Şu genç serseriyi mi bekliyormuş?!Dialogue: 50,0:13:38.17,0:13:40.10,Main-207+,,0,0,0,,Bunu sen mi yaptın?Dialogue: 50,0:13:40.10,0:13:42.94,Main-207+,,0,0,0,,Evet, ben yaptım! Bu benim yeni silahım: Pop Green! (Yeşil Aç!)Dialogue: 50,0:13:42.94,0:13:47.61,Main-207+,,0,0,0,,İki yıl denize öylece bakıp da  bir şey yapmadığımı sanma sakın.Dialogue: 50,0:13:47.61,0:13:49.21,Main-207+,,0,0,0,,Üzgünüm ama...Dialogue: 50,0:13:50.05,0:13:53.35,Main-207+,,0,0,0,,...artık sen ve Chopper ile birlikte  zayıf üçlüye dahil değilim!Dialogue: 50,0:13:53.35,0:13:57.19,Main-207+,,0,0,0,,Hiçbir şeyden etkilenmeyen bir savaşçı oldum!Dialogue: 50,0:13:57.19,0:14:01.06,Main-207+,,0,0,0,,Hey dostum! Bize bunu sen mi yaptın!Dialogue: 50,0:14:01.06,0:14:04.43,Main-207+,,0,0,0,,Ne?! Sogeking! Neden?!Dialogue: 50,0:14:04.43,0:14:06.06,Main-207+,,0,0,0,,Boş ver onları Usopp!Dialogue: 50,0:14:06.06,0:14:07.56,Main-207+,,0,0,0,,Haydi başka bir yere gidelim.Dialogue: 50,0:14:07.56,0:14:08.90,Main-207+,,0,0,0,,Ayrıca, senden bir iyilik isteyeceğim.Dialogue: 50,0:14:08.90,0:14:10.27,Main-207+,,0,0,0,,Hey siz, bekleyin!Dialogue: 50,0:14:10.27,0:14:11.30,Main-207+,,0,0,0,,Ne, Luffy?!Dialogue: 50,0:14:11.30,0:14:12.37,Main-207+,,0,0,0,,Haydi gidelim!Dialogue: 50,0:14:12.37,0:14:14.47,Main-207+,,0,0,0,,Hey hanımefendi, henüz ödeme yapmadınız!Dialogue: 50,0:14:14.47,0:14:15.77,Main-207+,,0,0,0,,Üstü kalsın!Dialogue: 50,0:14:17.17,0:14:19.58,Main-207+,,0,0,0,,Lanet olsun!  Adımızı karalıyorlar!Dialogue: 50,0:14:19.58,0:14:20.48,Main-207+,,0,0,0,,Hakla onları!Dialogue: 50,0:14:22.81,0:14:24.51,Main-207+,,0,0,0,,Hay lanet!Dialogue: 50,0:14:25.22,0:14:28.35,Main-207+,,0,0,0,,He?! bu kara baloncuklar da ne?!Dialogue: 50,0:14:35.49,0:14:38.46,Main-207+,,0,0,0,,Onlar ne be? Bulut mu?Dialogue: 50,0:14:51.14,0:14:53.34,Main-207+,,0,0,0,,Ne oluyor?!Dialogue: 50,0:14:53.34,0:14:56.81,Main-207+,,0,0,0,,Ve böylece elime yeni teknolojiler geçti...Dialogue: 50,0:14:56.81,0:14:59.45,Main-207+,,0,0,0,,Cidden mi?  Gökyüzünde miydin?Dialogue: 50,0:15:25.91,0:15:31.58,Main-207+,,0,0,0,,Bulun o ikisini ve öldürün!Dialogue: 50,0:15:34.12,0:15:37.25,Main-207+,,0,0,0,,Bir raporum var! Sabaody Takımadaları'nda...Dialogue: 50,0:15:37.79,0:15:40.29,Main-207+,,0,0,0,,Ne? Hasır Şapkalar mı?!Dialogue: 50,0:15:40.29,0:15:44.63,Main-207+,,0,0,0,,Evet, efendim! Raporlar diyor ki orası  yeni tayfa üyesi alımı yaptıkları yermiş.Dialogue: 50,0:15:46.23,0:15:48.23,Main-207+,,0,0,0,,Bunu karargâha bildirin.Dialogue: 50,0:15:48.23,0:15:50.27,Main-207+,,0,0,0,,Eğer hayattaysa, bu kötü haber.Dialogue: 50,0:15:50.93,0:15:52.84,Main-207+,,0,0,0,,Derhal birlikleri toplayın!Dialogue: 50,0:15:52.84,0:15:56.71,Main-207+,,0,0,0,,Sabaody Takımadaları'ndaki  aramayı yoğunlaştırın!Dialogue: 50,0:16:17.19,0:16:18.63,Main-207+,,0,0,0,,Onlardan kurtulabildim mi acaba?Dialogue: 50,0:16:21.30,0:16:22.77,Main-207+,,0,0,0,,Brook'un konseri mi?Dialogue: 50,0:16:23.93,0:16:26.37,Main-207+,,0,0,0,,Hasır Şapkalar'a tayfa alımı mı?Dialogue: 50,0:16:27.97,0:16:30.37,Main-207+,,0,0,0,,Neler oluyor?Dialogue: 50,0:16:32.31,0:16:34.34,Main-207+,,0,0,0,,"Ruh Kralı"?Dialogue: 50,0:16:35.58,0:16:37.75,Main-207+,,0,0,8,,N-ne?!Dialogue: 50,0:16:37.75,0:16:40.62,Main-207+,,0,0,8,,Şu kılıçmoron buraya gelen ilk kişi mi?!Dialogue: 50,0:16:40.62,0:16:42.52,Main-207+,,0,0,0,,İnanamıyorum!Dialogue: 50,0:16:42.52,0:16:44.85,Main-207+,,0,0,0,,Sonraki yolculuğumuz zorlu geçecek.Dialogue: 50,0:16:45.22,0:16:50.93,Main-207+,,0,0,0,,Franky-chan ikinci geldi, yaklaşık  10 gün önceydi ve hemen gemiyi görmeye gitti.Dialogue: 50,0:16:50.93,0:16:52.93,Main-207+,,0,0,0,,Sunny güvende, değil mi?Dialogue: 50,0:16:52.93,0:16:57.47,Main-207+,,0,0,0,,Tek bir çizik bile yok ve kaplama da çoktan bitti.Dialogue: 50,0:16:57.47,0:16:58.84,Main-207+,,0,0,0,,Güzel.Dialogue: 50,0:16:58.84,0:17:01.00,Main-207+,,0,0,0,,Güzel bir iş çıkardı.Dialogue: 50,0:17:01.37,0:17:03.84,Main-207+,,0,0,0,,Onurlu yaralar için asla pişmanlık duymam!Dialogue: 50,0:17:04.21,0:17:07.01,Main-207+,,0,0,0,,Evet! İyileşmek için bir yıl!Dialogue: 50,0:17:07.01,0:17:10.11,Main-207+,,0,0,0,,Bu kadar güçlü bir görev duygusuna  sahip olduğunu bilmiyordum.Dialogue: 50,0:17:11.25,0:17:12.85,Main-207+,,0,0,0,,Sağol, Duval.Dialogue: 50,0:17:12.85,0:17:15.15,Main-207+,,0,0,0,,Ne, yakışıklı olduğumu mu düşünüyorsun?Dialogue: 50,0:17:16.09,0:17:18.42,Main-207+,,0,0,0,,İyiliğinin karşılığını verdim, genç efendi!Dialogue: 50,0:17:18.42,0:17:20.16,Main-207+,,0,0,0,,Yağmurlu veya rüzgarlı farketmeksizin...Dialogue: 50,0:17:20.16,0:17:22.96,Main-207+,,0,0,0,,...tehlikeli korsanlar geminizin peşindeydi.Dialogue: 50,0:17:22.96,0:17:26.93,Main-207+,,0,0,0,,Ama her gün kesiklere ve  morluklara rağmen savaştım!Dialogue: 50,0:17:26.93,0:17:29.13,Main-207+,,0,0,0,,Acı dolu zamanlardı!Dialogue: 50,0:17:29.57,0:17:31.40,Main-207+,,0,0,0,,Duval-sama!Dialogue: 50,0:17:31.40,0:17:34.64,Main-207+,,0,0,0,,Yine de, nasıl bu kadar kötü yaralandın?Dialogue: 50,0:17:34.64,0:17:38.37,Main-207+,,0,0,0,,Gel, düş bana... yani dinle beni, genç efendi.Dialogue: 50,0:17:38.37,0:17:42.45,Main-207+,,0,0,0,,Çünkü donanma en nihayetinde...Dialogue: 50,0:17:39.01,0:17:42.45,Secondary-207+,,0,0,0,,Ve Nami-chan gelen üçüncüydü...Dialogue: 50,0:17:42.45,0:17:44.85,Main-207+,,0,0,0,,Nami-swan!Dialogue: 50,0:17:44.85,0:17:46.85,Main-207+,,0,0,0,,Nerede o?!Dialogue: 50,0:17:46.85,0:17:49.39,Main-207+,,0,0,0,,Zaman öldürmeye alışverişe gitti.Dialogue: 50,0:17:49.39,0:17:51.35,Main-207+,,0,0,0,,Benim hikayeme ne oldu peki?!Dialogue: 50,0:17:51.35,0:17:55.02,Main-207+,,0,0,0,,Nami-san alışverişte! Nami-san alışverişte!Dialogue: 50,0:17:55.02,0:17:58.96,Main-207+,,0,0,0,,Usopp-chan bir kaç gün önce  dördüncü olarak geldi ve kasabaya indi.Dialogue: 50,0:17:58.96,0:18:01.90,Main-207+,,0,0,0,,Dün beşinci olarak Chopper-chan geldi.Dialogue: 50,0:18:01.90,0:18:05.40,Main-207+,,0,0,0,,Brook-chan bugün  buraya bir konser için geldi.Dialogue: 50,0:18:05.40,0:18:06.00,Main-207+,,0,0,0,,Konser mi?Dialogue: 50,0:18:07.34,0:18:10.11,Main-207+,,0,0,0,,Sonra da sen geldin.Dialogue: 50,0:18:10.11,0:18:14.94,Main-207+,,0,0,0,,Yani sen de dahil yedi üye  takımadalara gelmiş oldunuz.Dialogue: 50,0:18:15.75,0:18:18.68,Main-207+,,0,0,0,,Nico Robin ya da Luffy'yi henüz görmedik.Dialogue: 50,0:18:18.68,0:18:22.82,Main-207+,,0,0,0,,Sadece bu adaya gelmek  bile oldukça fazla zor.Dialogue: 50,0:18:23.55,0:18:25.29,Main-207+,,0,0,0,,Yani hepiniz oldukça etkileyicisiniz.Dialogue: 50,0:18:25.29,0:18:28.02,Main-207+,,0,0,0,,Yeniden birleşmeniz çok hoş.Dialogue: 50,0:18:28.36,0:18:33.26,Main-207+,,0,0,0,,Evet. Bu bir kenara, Luffy'yi senin eğittiğine inanamıyorum.Dialogue: 50,0:18:33.26,0:18:35.80,Main-207+,,0,0,0,,Şu an inanılmaz güçlü olmalı.Dialogue: 50,0:18:36.10,0:18:38.30,Main-207+,,0,0,0,,Onu 6 aydır görmedim.Dialogue: 50,0:18:38.30,0:18:40.50,Main-207+,,0,0,0,,Gelişimini görmek için sabırsızlanıyorum.Dialogue: 50,0:18:40.50,0:18:43.34,Main-207+,,0,0,0,,Gelişim...Dialogue: 50,0:18:43.34,0:18:47.54,Main-207+,,0,0,0,,Acaba Nami-san ne tür bir gelişim yaptı!Dialogue: 50,0:18:47.54,0:18:49.41,Main-207+,,0,0,0,,Hey, sen iyi misin?!Dialogue: 50,0:18:53.62,0:18:57.72,Main-207+,,0,0,0,,Hey, Zoro! Sanji! Robin!Dialogue: 50,0:18:57.72,0:19:00.62,Main-207+,,0,0,0,,Sonunda tekrar buluştuk, ancak çok tuhaf davranıyorsunuz!Dialogue: 50,0:19:01.52,0:19:05.33,Main-207+,,0,0,0,,Zoro ve Sanji, iki yıl  boyunca çok yakınlaşmışsınız.Dialogue: 50,0:19:05.33,0:19:08.73,Main-207+,,0,0,0,,Ama benimle niye konuşmuyorsunuz?Dialogue: 50,0:19:09.17,0:19:10.83,Main-207+,,0,0,0,,Hey, hala bizi takip ediyor.Dialogue: 50,0:19:11.23,0:19:14.04,Main-207+,,0,0,0,,Oh, utangaç davranıyorsunuz, sizi ahmaklar!Dialogue: 50,0:19:14.04,0:19:19.44,Main-207+,,0,0,0,,Şu rakun biz Hasır Şapkalar  hakkında biraz fazla şey biliyor.Dialogue: 50,0:19:19.44,0:19:22.35,Main-207+,,0,0,0,,Evet, benim de aklımı kurcalıyor...Dialogue: 50,0:19:22.35,0:19:25.25,Main-207+,,0,0,0,,Olabilir mi ki? Şuna bak.Dialogue: 50,0:19:25.75,0:19:27.35,Main-207+,,0,0,0,,Sakın bana onun...!Dialogue: 50,0:19:30.79,0:19:34.42,Main-207+,,0,0,0,,Gerçek 50 Beli ödüllü,  Pamuk Şeker Seven Chopper!Dialogue: 50,0:19:34.42,0:19:35.49,Main-207+,,0,0,0,,Yani bu onları evcil hayvanı!Dialogue: 50,0:19:35.49,0:19:38.79,Main-207+,,0,0,0,,Biraz değişmişsiniz.  Ama çok da umurumda değil.Dialogue: 50,0:19:39.56,0:19:44.03,Main-207+,,0,0,0,,Onlar ölmeden önce adaya damlamış  olmalı, şimdi de serbestçe geziyor.Dialogue: 50,0:19:44.03,0:19:48.91,Main-207+,,0,0,0,,Yani bizi sahiplerinin geri  döndüğünü sandığı için takip ediyor.Dialogue: 50,0:19:49.34,0:19:52.11,Main-207+,,0,0,0,,O zaman o tilkiyi bırakıp  yerine bunu alalım.Dialogue: 50,0:19:52.11,0:19:55.88,Main-207+,,0,0,0,,Eğer hayvan posterle birebir aynı olursa daha gerçekçi gözükmüş oluruz.Dialogue: 50,0:19:55.88,0:19:57.91,Main-207+,,0,0,0,,Onu tutacak mıyız? Ne yer, ne içer ki?Dialogue: 50,0:19:57.91,0:19:59.35,Main-207+,,0,0,0,,Pamuk şeker!Dialogue: 50,0:19:59.35,0:20:00.42,Main-207+,,0,0,0,,Bizde hiç yok ama.Dialogue: 50,0:20:02.49,0:20:04.89,Main-207+,,0,0,0,,Artık sana ihtiyacımız yok!  Uzaklaş!Dialogue: 50,0:20:08.93,0:20:10.56,Main-207+,,0,0,0,,Gel buraya, Chopper.Dialogue: 50,0:20:13.26,0:20:15.13,Main-207+,,0,0,0,,Al bakalım, bir salatalık.Dialogue: 50,0:20:15.13,0:20:16.80,Main-207+,,0,0,0,,Korkunç! Robin, korkunçsun!Dialogue: 50,0:20:16.80,0:20:17.70,Main-207+,,0,0,0,,İşte şansımız!Dialogue: 50,0:20:21.04,0:20:22.31,Main-207+,,0,0,0,,Oh, Robin!Dialogue: 50,0:20:22.31,0:20:24.61,Main-207+,,0,0,0,,Ne? Hey, Nico Robin!Dialogue: 50,0:20:24.61,0:20:26.08,Main-207+,,0,0,0,,Kimdi onlar?Dialogue: 50,0:20:26.08,0:20:28.78,Main-207+,,0,0,0,,Bu çok kötü! Robin kaçırıldı!Dialogue: 50,0:20:28.78,0:20:30.95,Main-207+,,0,0,0,,Onlar adam kaçıranlar!Dialogue: 50,0:20:30.95,0:20:34.92,Main-207+,,0,0,0,,Hey, bunu Kaptan Luffy'ye  bildirmemiz gerekmiyor mu?Dialogue: 50,0:20:34.92,0:20:37.62,Main-207+,,0,0,0,,Ne?! Luffy ile görüştünüz bile mi?Dialogue: 50,0:20:37.62,0:20:38.65,Main-207+,,0,0,0,,Haklısın!Dialogue: 50,0:20:38.65,0:20:40.86,Main-207+,,0,0,0,,Şimdiye yeni üyeler edinmişlerdir!Dialogue: 50,0:20:40.86,0:20:43.76,Main-207+,,0,0,0,,Doğru, hemen Robin'i kurtarmalıyız, he?Dialogue: 50,0:20:43.76,0:20:44.99,Main-207+,,0,0,0,,Yolu gösterin!Dialogue: 50,0:20:48.23,0:20:51.60,Main-207+,,0,0,0,,Burası Sabaody! Nico Robin'i yakaladık!Dialogue: 50,0:20:51.60,0:20:54.97,Main-207+,,0,0,0,,Onu bırakmayan bir tür  tilki yaratık ile birlikte.Dialogue: 50,0:20:56.41,0:20:59.98,Main-207+,,0,0,0,,Acele etsem iyi olur. Şimdiye çoktan burada olabilirler.Dialogue: 50,0:21:04.11,0:21:06.88,Main-207+,,0,0,0,,Hey, sen iyi misin?! Hey!Dialogue: 50,0:21:07.52,0:21:08.85,Main-207+,,0,0,0,,O korkunç!Dialogue: 50,0:21:08.85,0:21:10.69,Main-207+,,0,0,0,,Onu birdenbire vurdu!Dialogue: 50,0:21:10.69,0:21:11.79,Main-207+,,0,0,0,,Çok kötü!Dialogue: 50,0:21:11.79,0:21:14.76,Main-207+,,0,0,0,,Hey, benimle kal!Dialogue: 50,0:21:14.76,0:21:16.46,Main-207+,,0,0,0,,Neden yaptın bunu?!Dialogue: 50,0:21:16.46,0:21:18.46,Main-207+,,0,0,0,,Biz sana ne yaptık?!Dialogue: 50,0:21:19.56,0:21:21.03,Main-207+,,0,0,0,,"Üzgünüm" dedim, öyle değil mi?!Dialogue: 50,0:21:21.03,0:21:23.00,Main-207+,,0,0,0,,Onu başkasıyla karıştırdım!Dialogue: 50,0:21:23.00,0:21:27.40,Main-207+,,0,0,0,,Kusuruma bakmayın. Tam da size benzeyen bir çifti arıyordum.Dialogue: 50,0:21:28.27,0:21:31.07,Main-207+,,0,0,0,,Uzun saçlı bir kadın ve  uzun burunlu bir erkek.Dialogue: 50,0:21:31.07,0:21:34.08,Main-207+,,0,0,0,,Yanlış anladın ve gördüğün an vurdun mu?!Dialogue: 50,0:21:34.08,0:21:37.35,Main-207+,,0,0,0,,Tanrım! Hasır Şapka Luffy korkunç biri!Dialogue: 50,0:21:37.35,0:21:42.05,Main-207+,,0,0,0,,Ha? Sakın benimle bir  problemin olduğunu söyleme?!Dialogue: 50,0:21:43.52,0:21:44.95,Main-207+,,0,0,0,,Görünüşe bakılırsa var.Dialogue: 50,0:21:49.73,0:21:52.53,Main-207+,,0,0,0,,Beni suçlamayın.  Onların hatasıydı.Dialogue: 50,0:21:53.53,0:21:55.53,Main-207+,,0,0,0,,Hey, benimle kal! İyi misin?!Dialogue: 50,0:21:56.13,0:21:58.97,Main-207+,,0,0,0,,Bulun o ikisini!Dialogue: 50,0:22:01.00,0:22:03.57,Main-207+,,0,0,0,,Öylece kaçmalarına izin veremeyiz!Dialogue: 50,0:22:03.57,0:22:05.31,Main-207+,,0,0,0,,Öldürün onları ki... bu bir örnek olsun.Dialogue: 50,0:22:25.59,0:22:29.97,Main-207+,,0,0,0,,Oh, sana mı çarptım?  Özür dilerim!Dialogue: 50,0:22:29.97,0:22:31.30,Main-207+,,0,0,0,,Hoşçakal!Dialogue: 50,0:22:32.44,0:22:33.64,Main-207+,,0,0,0,,Onun sorunu ne?Dialogue: 50,0:22:33.64,0:22:36.11,Main-207+,,0,0,0,,Hasır Şapka Luffy'nin kim  olduğunu bilmiyor mu?Dialogue: 50,0:22:36.11,0:22:39.11,Main-207+,,0,0,0,,O-o artık yürüyen ölü bir adam!Dialogue: 50,0:22:41.41,0:22:43.68,Main-207+,,0,0,0,,Bekle bi' dakika!Dialogue: 50,0:22:57.76,0:22:58.63,Main-207+,,0,0,0,,Ha?Dialogue: 50,0:23:00.16,0:23:03.07,Flashbacks-207+,,0,0,0,,Uzakta gözüken Sabaody Takımadaları.Dialogue: 50,0:23:03.77,0:23:07.64,Flashbacks-207+,,0,0,0,,Luffy, burada vedalaşmalıyız.Dialogue: 50,0:23:07.64,0:23:10.64,Flashbacks-207+,,0,0,0,,Aramızdaki ilişkiyi  öğrenmelerine izin veremeyiz.Dialogue: 50,0:23:11.31,0:23:12.41,Flashbacks-207+,,0,0,0,,Hı-hı.Dialogue: 50,0:23:12.41,0:23:13.84,Flashbacks-207+,,0,0,0,,Şunu al ve...Dialogue: 50,0:23:14.98,0:23:16.25,Flashbacks-207+,,0,0,0,,...bu şekilde tak.Dialogue: 50,0:23:16.25,0:23:19.15,Flashbacks-207+,,0,0,0,,Ona ihtiyacım yok. Bu çok abartılı.Dialogue: 50,0:23:19.15,0:23:20.22,Flashbacks-207+,,0,0,0,,Öyle mi?Dialogue: 50,0:23:20.72,0:23:22.95,Flashbacks-207+,,0,0,0,,Yine de eğer ki bir şey olursa diye...Dialogue: 50,0:23:22.95,0:23:23.92,Flashbacks-207+,,0,0,0,,Tamam.Dialogue: 50,0:23:24.72,0:23:26.36,Flashbacks-207+,,0,0,0,,Çok dikkatli olmalısın.Dialogue: 50,0:23:26.89,0:23:29.23,Flashbacks-207+,,0,0,0,,Yüzünü mutlaka gizle.Dialogue: 50,0:23:30.13,0:23:33.96,Flashbacks-207+,,0,0,0,,Dünya seni öldü biliyor, ama...Dialogue: 50,0:23:34.33,0:23:37.87,Flashbacks-207+,,0,0,0,,...insanlar iki yıl önceden senin tipini biliyor.Dialogue: 50,0:23:37.87,0:23:41.34,Flashbacks-207+,,0,0,0,,Eğer başına bela açarsan, yelken açamazsınız.Dialogue: 50,0:23:41.34,0:23:43.01,Flashbacks-207+,,0,0,0,,Anlaşıldı.Dialogue: 50,0:23:43.01,0:23:47.91,Flashbacks-207+,,0,0,0,,Ve çantana ek olarak,  50 kıyafet, 1000 öğlen yemeği...Dialogue: 50,0:23:47.91,0:23:50.91,Flashbacks-207+,,0,0,0,,...peçete, kağıt mendil ve beş yıla yetecek kadar havlu...Dialogue: 50,0:23:50.91,0:23:56.19,Flashbacks-207+,,0,0,0,,...üç yıla yetecek kadar su ve atıştırmalık,  gümüş yemek takımları, diş fırçaları, sabun...Dialogue: 50,0:23:56.19,0:23:59.22,Flashbacks-207+,,0,0,0,,...el kremleri, üç yıla yetecek kadar böcek ısırığı merhemi, ve...Dialogue: 50,0:23:59.22,0:24:01.89,Flashbacks-207+,,0,0,0,,Biraz hafifletsene!Dialogue: 50,0:24:01.19,0:24:01.89,FlashbackSecondary-207+,,0,0,0,,Ne?Dialogue: 50,0:24:04.33,0:24:06.50,Flashbacks-207+,,0,0,0,,Tayfanla güvenli bir şekilde  bir araya gelmenizi diliyorum.Dialogue: 50,0:24:06.50,0:24:09.50,Flashbacks-207+,,0,0,0,,Tamamdır. Her şey için teşekkür ederim!Dialogue: 50,0:24:10.67,0:24:12.27,Flashbacks-207+,,0,0,0,,Bol şans!Dialogue: 50,0:24:12.27,0:24:16.71,Flashbacks-207+,,0,0,0,,Sabaody'nin bu günlerde  tehlikeli hale geldiğini duydum.Dialogue: 50,0:24:17.11,0:24:22.44,Flashbacks-207+,,0,0,0,,Evet. Bu yüzden Nyavy orada  olup bitenlere çok dikkat ediyor.Dialogue: 50,0:24:22.44,0:24:24.61,Flashbacks-207+,,0,0,0,,Ekstra Ekstra dikkatli ol!Dialogue: 50,0:24:24.61,0:24:25.31,Flashbacks-207+,,0,0,0,,Olurum.Dialogue: 50,0:24:25.95,0:24:31.89,Flashbacks-207+,,0,0,0,,Eğer bize ihtiyacın olursa biz, Kuja Korsanları,  her zaman sana yardım etmeye geliriz!Dialogue: 50,0:24:31.89,0:24:34.29,Flashbacks-207+,,0,0,0,,Lütfen bunu aklında tut.Dialogue: 50,0:24:36.03,0:24:38.69,Flashbacks-207+,,0,0,0,,Ve bana bir iyilik yapar mısın?Dialogue: 50,0:24:38.69,0:24:41.13,Flashbacks-207+,,0,0,0,,Ne? Seninle evlenmeyeceğim.Dialogue: 50,0:24:41.13,0:24:47.80,Flashbacks-207+,,0,0,0,,Hayır, sadece hoşçakal  demeden ayrılmanı istiyorum.Dialogue: 50,0:24:47.80,0:24:51.31,Flashbacks-207+,,0,0,0,,Oh, zaten daha önce  kimseye böyle söylemedim.Dialogue: 50,0:24:51.77,0:24:53.01,Flashbacks-207+,,0,0,0,,Seni tekrar görmeyi çok isterim.Dialogue: 50,0:24:57.75,0:25:00.02,Flashbacks-207+,,0,0,0,,Pekala, ben kaçtım!Dialogue: 50,0:25:00.02,0:25:00.98,Flashbacks-207+,,0,0,0,,Görüşürüz!Dialogue: 50,0:25:00.98,0:25:02.32,Flashbacks-207+,,0,0,0,,Kendine dikkat et, Luffy!Dialogue: 50,0:25:02.32,0:25:04.59,Flashbacks-207+,,0,0,0,,Görüşürüz!Dialogue: 50,0:25:04.59,0:25:07.49,Flashbacks-207+,,0,0,0,,Benimle tekrar görüşmek istediğini söyledi!Dialogue: 50,0:25:07.49,0:25:09.06,Flashbacks-207+,,0,0,0,,Bu dedikleri şeyin adı mı...Dialogue: 50,0:25:10.16,0:25:11.89,Flashbacks-207+,,0,0,0,,...evlenme teklifi?!Dialogue: 50,0:25:11.89,0:25:14.23,Flashbacks-207+,,0,0,0,,Nayır, kesinlikle Nneğil!Dialogue: 50,0:25:16.37,0:25:21.24,Main-207+,,0,0,0,,Hancock bana başıma bela  açmamam gerektiğini söyledi.Dialogue: 50,0:25:21.24,0:25:24.87,Main-207+,,0,0,0,,Hey, bana bilerek çarptın, değil mi?Dialogue: 50,0:25:24.87,0:25:27.71,Main-207+,,0,0,0,,O herif yandı!Dialogue: 50,0:26:06.98,0:26:08.15,Main-207+,,0,0,0,,Sunny !Dialogue: 50,0:26:15.82,0:26:19.33,Main-207+,,0,0,0,,Seni iki yıl boyunca  beklettiğimiz için özür dileriz.Dialogue: 50,0:26:21.40,0:26:23.00,Main-207+,,0,0,0,,İyi olmana çok sevindim!Dialogue: 50,0:26:29.54,0:26:31.94,Main-207+,,0,0,0,,Çekici bebeğimiz gelmiş!Dialogue: 50,0:26:31.94,0:26:36.25,Main-207+,,0,0,0,,Sen bizim süper arkeoloğumuz...Dialogue: 50,0:26:42.15,0:26:43.99,Main-207+,,0,0,0,,...Robin'sin değil mi?!Dialogue: 50,0:27:03.74,0:27:05.94,Main-207+,,0,0,0,,Hiç değişmemişsin, Franky!Dialogue: 50,0:27:05.94,0:27:08.21,Main-207+,,0,0,0,,Tabii ki değiştim, seni budala!Dialogue: 50,0:27:08.21,0:27:12.35,Main-207+,,0,0,0,,Şimdi vücudumdaki romantik  erkekliğe tanık ol!Dialogue: 50,0:27:12.35,0:27:17.55,Main-207+,,0,0,0,,Bu harikulade, türünün tek örneği  dönüşüm ile gözlerin bayram etsin!Dialogue: 50,0:27:18.62,0:27:23.79,Main-207+,,0,0,0,,İnsan aklının çok ötesindeyim artık!Dialogue: 50,0:27:24.39,0:27:28.50,Main-207+,,0,0,0,,Evet, artık seni sadece bir insan  olarak görmek epey zor gibi duruyor.Dialogue: 50,0:27:29.26,0:27:33.00,Main-207+,,0,0,0,,Hey, hey! Artık sapık  olduğumu mu söylemeye çalışıyorsun?Dialogue: 50,0:27:33.00,0:27:35.34,Main-207+,,0,0,0,,Ne güzel bir iltifat!Dialogue: 50,0:27:43.45,0:27:45.18,Main-207+,,0,0,0,,Kaplama dedikleri şey bu mu?Dialogue: 50,0:27:46.55,0:27:47.75,Main-207+,,0,0,0,,Tıpkı jöle gibi.Dialogue: 50,0:27:48.52,0:27:52.65,Main-207+,,0,0,0,,Çok doğru! Rayleigh işini biliyor!Dialogue: 50,0:27:52.65,0:27:54.22,Main-207+,,0,0,0,,Artık denizin derinliklerine dalabiliriz.Dialogue: 50,0:27:54.22,0:27:56.66,Main-207+,,0,0,0,,Ne teknoloji ama!Dialogue: 50,0:27:57.33,0:27:59.86,Main-207+,,0,0,0,,Az önce Rayleigh ve diğerleriyle görüştüm.Dialogue: 50,0:27:59.86,0:28:01.73,Main-207+,,0,0,0,,Ooo yani bara gittin.Dialogue: 50,0:28:01.73,0:28:03.40,Main-207+,,0,0,0,,Sen kaçıncıymışsın?Dialogue: 50,0:28:03.40,0:28:04.67,Main-207+,,0,0,0,,Sekizinci.Dialogue: 50,0:28:05.33,0:28:06.90,Main-207+,,0,0,0,,Luffy dışında herkes burada.Dialogue: 50,0:28:07.44,0:28:11.27,Main-207+,,0,0,0,,Anlıyorum.  Yakında yeni bir yolculuğa çıkacağız.Dialogue: 50,0:28:11.27,0:28:13.61,Main-207+,,0,0,0,,Gemiyi olabilecek en iyi durumuna getirdim.Dialogue: 50,0:28:16.65,0:28:19.25,Main-207+,,0,0,0,,Yeni silahlar da hazır!Dialogue: 50,0:28:20.72,0:28:22.52,Main-207+,,0,0,0,,Sabırsızlanıyorum.Dialogue: 50,0:28:22.52,0:28:24.79,Main-207+,,0,0,0,,Bu arada diğerleri nerede?Dialogue: 50,0:28:25.32,0:28:29.96,Main-207+,,0,0,0,,Usopp ve Sanji erkenden buradaydı.  Usopp yakıt almaya gitti.Dialogue: 50,0:28:29.96,0:28:32.56,Main-207+,,0,0,0,,Sanji de yemek almaya gitti.Dialogue: 50,0:28:32.56,0:28:35.53,Main-207+,,0,0,0,,Anladım. Aslında buraya doğru gelirken...Dialogue: 50,0:28:36.40,0:28:38.47,Main-207+,,0,0,0,,...bunu buldum.Dialogue: 50,0:28:39.77,0:28:43.51,Main-207+,,0,0,0,,Bunun ne olduğunu biliyor muydun? Kim bu Ruh Kralı?Dialogue: 50,0:28:43.51,0:28:46.31,Main-207+,,0,0,0,,Yaa, o Brook.Dialogue: 50,0:28:46.31,0:28:50.15,Main-207+,,0,0,0,,Evet, biliyorum. Her yerde TD'lerini gördüm.Dialogue: 50,0:28:52.85,0:28:55.42,Main-207+,,0,0,0,,Son günlerde spot ışığı  altında parlayan biri.Dialogue: 50,0:28:56.55,0:28:59.72,Main-207+,,0,0,0,,Karanlık, sessiz, sisli denizden...Dialogue: 50,0:28:59.72,0:29:03.69,Main-207+,,0,0,0,,...hayranları, yaptıkları tezahüratlarla onu sahnenin o parlak ışığına doğru itmiş oldu.Dialogue: 50,0:29:10.17,0:29:12.17,Main-207+,,0,0,0,,Belki de...Dialogue: 50,0:29:13.77,0:29:19.81,Main-207+,,0,0,8,,...tekrardan korsan olmak istemeyebilir.Dialogue: 50,0:29:21.28,0:29:25.58,Rock Concert Main,,0,0,0,,♪ Soul King gizemli... ♪Dialogue: 50,0:29:26.35,0:29:29.18,Rock Concert Main,,0,0,0,,♪ O kemikten başka bir şey değil! ♪Dialogue: 50,0:29:31.42,0:29:39.39,Rock Concert Main,,0,0,0,,♪ Kafatasında Afro! Kızlar farklılığa bayılır! ♪Dialogue: 50,0:29:35.76,0:29:39.39,Rock Concert Secondary,,0,0,0,,♪ Kafatasında Afro! Kızlar farklılığa bayılır! ♪Dialogue: 50,0:29:39.39,0:29:43.80,Rock Concert Main,,0,0,0,,♪ Onun dizlerini zayıflatmak ister misin? ♪Dialogue: 50,0:29:43.80,0:29:46.37,Rock Concert Main,,0,0,0,,♪ Sütüm var! Sütüm var! ♪Dialogue: 50,0:29:46.37,0:29:54.34,Rock Concert Main,,0,0,0,,♪ Proteinden çok kalsiyuma ihtiyacın var! ♪Dialogue: 50,0:29:52.41,0:29:54.34,Rock Concert Secondary,,0,0,0,,♪ Ah-ahhh...! ♪Dialogue: 50,0:29:57.68,0:30:00.75,Main-207+,,0,0,0,,Neden bir şey söylemiyorsun?Dialogue: 50,0:30:00.75,0:30:04.75,Main-207+,,0,0,0,,Benim kim olduğumu bile bile mi bana çarptın?Dialogue: 50,0:30:05.29,0:30:08.39,Main-207+,,0,0,0,,Gördün mü? Beni aptal gibi gösterdin.Dialogue: 50,0:30:09.12,0:30:12.23,Main-207+,,0,0,0,,Beni insan içinde küçük düşürdün.Dialogue: 50,0:30:12.96,0:30:14.43,Main-207+,,0,0,0,,Burada benden bahsediyoruz.Dialogue: 50,0:30:14.43,0:30:18.17,Main-207+,,0,0,0,,Ben 400 milyon ödüllü elit bir korsanım!Dialogue: 50,0:30:18.17,0:30:21.44,Main-207+,,0,0,0,,Şimdi hemen dizlerinin üzerine çök...Dialogue: 50,0:30:21.44,0:30:23.77,Main-207+,,0,0,0,,...ve hayatın için yalvar!Dialogue: 50,0:30:30.78,0:30:35.78,Main-207+,,0,0,0,,Hey, balıkçı, en iyi fiyatından bana biraz balık sat!Dialogue: 50,0:30:35.78,0:30:37.42,Main-207+,,0,0,0,,He? Burada kimse yok mu?Dialogue: 50,0:30:39.86,0:30:41.76,Main-207+,,0,0,0,,Hey, buranın sahibi sen misin?Dialogue: 50,0:30:43.99,0:30:45.06,Main-207+,,0,0,0,,Sorun ne?Dialogue: 50,0:30:45.06,0:30:47.03,Main-207+,,0,0,0,,O gitti!Dialogue: 50,0:30:47.03,0:30:48.80,Main-207+,,0,0,0,,Yeşil saçlı adam!Dialogue: 50,0:30:49.47,0:30:52.30,Main-207+,,0,0,0,,Yeşil saçlı mı?  Neler oldu?Dialogue: 50,0:30:52.30,0:30:57.27,Main-207+,,0,0,0,,Çok kötü bir şey yaptım! Tam az önce oldu...Dialogue: 50,0:30:57.61,0:31:00.31,Flashbacks-207+,,0,0,0,,Yaşlı adam, balık tutmak istiyorum.Dialogue: 50,0:30:58.21,0:31:00.31,FlashbackSecondary-207+,,0,0,0,,He?Dialogue: 50,0:31:00.31,0:31:01.18,Flashbacks-207+,,0,0,0,,Ney...?Dialogue: 50,0:31:02.18,0:31:05.91,Flashbacks-207+,,0,0,0,,Genç adam, pek de balık  tutacak birine benzemiyorsun.Dialogue: 50,0:31:06.38,0:31:09.52,Flashbacks-207+,,0,0,0,,Arkadaşlarımla bu adada buluşacağıma söz verdim.Dialogue: 50,0:31:09.52,0:31:13.36,Flashbacks-207+,,0,0,0,,Ama buraya ilk gelen ben oldum ve hiçbirini henüz göremedim.Dialogue: 50,0:31:13.36,0:31:17.06,Flashbacks-207+,,0,0,0,,O yüzden yapacak hiçbir şeyim yok.Dialogue: 50,0:31:17.06,0:31:19.09,Flashbacks-207+,,0,0,0,,Beni balıkçı teknene alır mısın?Dialogue: 50,0:31:19.09,0:31:23.30,Flashbacks-207+,,0,0,0,,Tabii, seni tekneme alırım. Neden gidip de beni içinde beklemiyorsun?Dialogue: 50,0:31:25.23,0:31:27.60,Main-207+,,0,0,0,,Ona tam olarak bunu söyledim.Dialogue: 50,0:31:27.60,0:31:31.31,Main-207+,,0,0,0,,Yeşil saç, üç kılıç ve bir haramaki* mi vardı?Dialogue: 50,0:31:31.31,0:31:35.11,Main-207+,,0,0,0,,Evet, ayrıca gözünde derin bir yara var.Dialogue: 50,0:31:35.11,0:31:36.08,Main-207+,,0,0,0,,Onu tanıyor musun?Dialogue: 50,0:31:36.08,0:31:37.41,Main-207+,,0,0,0,,Gözünde yara mı?Dialogue: 50,0:31:38.41,0:31:39.65,Main-207+,,0,0,0,,Şu muydu?Dialogue: 50,0:31:39.65,0:31:43.62,Main-207+,,0,0,0,,Oo evet, işte buydu! Arkadaşın mı?Dialogue: 50,0:31:43.62,0:31:45.92,Main-207+,,0,0,0,,Eh, bir tanıdığım diyelim.Dialogue: 50,0:31:45.92,0:31:49.49,Main-207+,,0,0,0,,Ona balıkçı teknesine binmesini söyledim.Dialogue: 50,0:31:49.49,0:31:51.03,Main-207+,,0,0,0,,Kesinlikle öyle dedim.Dialogue: 50,0:31:51.03,0:31:53.96,Main-207+,,0,0,0,,Ama buraya geri döndüğmde...Dialogue: 50,0:31:55.56,0:31:57.37,Flashbacks-207+,,0,0,0,,Hayır, genç adam, bu o değil!Dialogue: 50,0:31:57.37,0:31:59.57,Flashbacks-207+,,0,0,0,,Bu bir korsan gemisi!Dialogue: 50,0:32:00.14,0:32:04.91,Flashbacks-207+,,0,0,0,,Beyler! hayalini kurduğumuz  Yeni Dünya için yelken açıyoruz!Dialogue: 50,0:32:07.14,0:32:08.71,Flashbacks-207+,,0,0,0,,U-uyan, genç adam!Dialogue: 50,0:32:08.71,0:32:11.15,Flashbacks-207+,,0,0,0,,Yanlış gemidesin!Dialogue: 50,0:32:11.15,0:32:16.75,Main-207+,,0,0,0,,Sanırım o halde  Balık Adam Adası'na doğru gidiyor.Dialogue: 50,0:32:21.32,0:32:22.86,Main-207+,,0,0,0,,Salak şey!Dialogue: 50,0:32:27.86,0:32:30.57,Main-207+,,0,0,0,,İlk onun ortaya çıkmış olmasının onluk  bir hareket olmadığının farkındaydım.Dialogue: 50,0:32:30.57,0:32:34.74,Main-207+,,0,0,0,,Böyle bir şey yapacağını biliyordum!Dialogue: 50,0:32:35.04,0:32:37.84,Main-207+,,0,0,0,,Bir korsan gemisindeydi!  Şimdiye çoktan ölmüş olabilir!Dialogue: 50,0:32:37.84,0:32:41.71,Main-207+,,0,0,0,,Hayır, hayır, sorun değil. Senin hatan değildi.Dialogue: 50,0:32:42.41,0:32:46.28,Main-207+,,0,0,0,,O ölmez. Nereye gittiğini bildiğimiz için şanslıyız.Dialogue: 50,0:32:46.28,0:32:47.88,Main-207+,,0,0,0,,Bu bir kenara, biraz balık alabilir miyim?Dialogue: 50,0:32:47.88,0:32:49.79,Main-207+,,0,0,0,,Şey, ama...Dialogue: 50,0:32:49.79,0:32:51.12,Secondary-207+,,0,0,0,,Hey, o da ne?!Dialogue: 50,0:32:52.55,0:32:55.19,Main-207+,,0,0,0,,Suya bakın!  Bir şeyler yüzeye çıkıyor!Dialogue: 50,0:32:57.46,0:32:58.53,Main-207+,,0,0,0,,O da ne?Dialogue: 50,0:32:59.03,0:33:00.86,Main-207+,,0,0,0,,Kocaman!Dialogue: 50,0:33:12.54,0:33:14.41,Main-207+,,0,0,0,,Bu kocaman bir gemi!Dialogue: 50,0:33:14.41,0:33:17.65,Main-207+,,0,0,0,,Kötü kaplandı da su  basıncıyla mı parçalandı ki?Dialogue: 50,0:33:17.65,0:33:19.31,Main-207+,,0,0,0,,Ya da deniz kralları  tarafından mı saldırıya uğradı?Dialogue: 50,0:33:19.31,0:33:22.99,Main-207+,,0,0,0,,Ortadan ikiye kesilmiş gibi görünüyor!Dialogue: 50,0:33:22.99,0:33:24.35,Main-207+,,0,0,0,,Delirme!Dialogue: 50,0:33:24.35,0:33:26.66,Main-207+,,0,0,0,,Bu kadar büyük bir gemiyi ne kesebilir?Dialogue: 50,0:33:26.66,0:33:28.29,Main-207+,,0,0,0,,Seni pislik!Dialogue: 50,0:33:28.29,0:33:32.33,Main-207+,,0,0,0,,Yeni Dünya'ya gitme  hayalimizi nasıl yerle bir edersin?!Dialogue: 50,0:33:33.90,0:33:35.93,Main-207+,,0,0,0,,Kaderin bir cilvesi işte!Dialogue: 50,0:33:35.93,0:33:38.13,Main-207+,,0,0,0,,Geminize veba getiren kendi lanetli...Dialogue: 50,0:33:38.13,0:33:41.07,Main-207+,,0,0,0,,...kaderinizi suçlamanız gerek.Dialogue: 50,0:33:41.07,0:33:43.07,Main-207+,,0,0,0,,Çok kibirli!Dialogue: 50,0:33:43.07,0:33:44.11,Main-207+,,0,0,0,,Bakın!Dialogue: 50,0:33:44.11,0:33:45.31,Main-207+,,0,0,0,,Birileri gemide!Dialogue: 50,0:33:45.31,0:33:49.75,Main-207+,,0,0,0,,Of, geri döndü. Daha az umurumda olamazdı.Dialogue: 50,0:33:58.42,0:33:59.62,Main-207+,,0,0,0,,Yanlış...Dialogue: 50,0:34:01.16,0:34:02.89,Main-207+,,0,0,0,,...gemiye bindim.Dialogue: 0,0:04:33.86,0:04:39.80,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Zyrecon thx to onepace.netDialogue: 0,0:18:49.50,0:18:59.50,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Zyrecon thx to onepace.netDialogue: 0,0:34:02.90,0:34:05.80,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Zyrecon thx to onepace.netDialogue: 0,0:04:33.86,0:04:39.80,Title,,0,0,0,,İki Yıl SonraDialogue: 0,0:04:30.05,0:04:33.78,Captions,,0,0,0,,10 Küsür Gün Sonra Bir BardaDialogue: 0,0:05:30.78,0:05:34.18,Note,,0,0,0,,Dialogue: 0,0:05:30.78,0:05:30.81,Captions,,0,0,0,,m 473.4 576.6 b 467 575 464.2 573.1 454.8 563.1 443.8 551.7 442.9 548.2 445.6 527.3 446.1 523.5 445.5 518 443.2 506.3 441.6 497.6 439.6 486.7 439 482 438.3 477.3 436.7 467 435.4 459 434.1 451 433 443.3 433 441.7 433 440.2 432.7 439 432.3 439 432 439 429.4 440.5 426.6 442.4 408.3 454.4 403 457.1 392.4 459.6 372.8 464.2 359.7 457.5 358.3 442.2 357.4 431.9 358.5 42