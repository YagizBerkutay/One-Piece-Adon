00,0,0,0,0,100,100,3,0,1,2.95,0,8,23,23,23,1Style: Lyrics-furigana,Duality,36,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,2.95,0,2,23,23,34,1Style: Lyrics,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,2,23,23,34,1Style: Karaoke,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,23,1Style: Kanji,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,146,1Style: Roger-Monologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1Style: Romaji ED,Josefin Sans,82,&H00FFFFFF,&H003592BE,&H00000000,&H64000000,0,0,0,0,100,100,0,0,1,0,4,8,10,10,20,1Style: Translation ED,Josefin Sans,82,&H00FFFFFF,&H000000FF,&H00FFFFFF,&H64000000,0,0,0,0,100,100,0,0,1,0,4,2,10,10,20,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:50.01,0:02:00.01,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 50,0:01:54.68,0:01:56.93,Main-207-,,0,0,0,,Oha!Dialogue: 50,0:01:56.93,0:01:58.77,Main-207-,,0,0,0,,Onlar da dövüşmek istiyor!Dialogue: 50,0:02:00.52,0:02:01.81,Main-207-,,0,0,0,,Gaza geldim!Dialogue: 50,0:02:02.44,0:02:04.60,Main-207-,,0,0,0,,İhtiyar! Söz verdin, değil mi?Dialogue: 50,0:02:04.60,0:02:08.78,Main-207-,,0,0,0,,Eğer onları defedersem, kamarotluğu bırakacağım. Olur mu?Dialogue: 50,0:02:08.78,0:02:10.15,Main-207-,,0,0,0,,Daha fazlasını isteyemem.Dialogue: 50,0:02:10.15,0:02:14.74,Main-207-,,0,0,0,,Eğer bir yıl boyunca kamarot olursan, bu restoran darmadağın olur.Dialogue: 50,0:02:15.11,0:02:16.45,Main-207-,,0,0,0,,Tamam!Dialogue: 50,0:02:16.45,0:02:21.12,Main-207-,,0,0,0,,Gerçekten Korsanlar Kralı mı olmak istiyorsun, çocuk?Dialogue: 50,0:02:22.08,0:02:26.42,Main-207-,,0,0,0,,O gemiyi aldığımız sürece, Grand Line'dan korkmaya gerek yok!Dialogue: 50,0:02:27.21,0:02:31.84,Main-207-,,0,0,0,,Bir donanma gemisi gibi davranmak veya beyaz bayrak çekmek yerine,Dialogue: 50,0:02:32.84,0:02:37.14,Main-207-,,0,0,0,,düşmana yanaşıp ani bir saldırı yapmak daha etkili olacaktır!Dialogue: 50,0:02:37.68,0:02:40.56,Main-207-,,0,0,0,,Mükemmel bir sinsi saldırı yapabiliriz.Dialogue: 50,0:02:40.56,0:02:42.85,Main-207-,,0,0,0,,Cidden öyle saçma bir gemide...Dialogue: 50,0:02:42.85,0:02:46.52,Main-207-,,0,0,0,,korsanların olacağını kimse düşünmez.Dialogue: 50,0:02:46.52,0:02:51.40,Main-207-,,0,0,0,,A-Ama, Don... O gemiyi kullanarak Grand Line'a girsek bile,Dialogue: 50,0:02:51.40,0:02:55.66,Main-207-,,0,0,0,,tekrar Şahin Göz Mihawk gibi biriyle karşılaşırsak...Dialogue: 50,0:02:59.53,0:03:03.66,Main-207-,,0,0,0,,Hâlâ onun gibi birinden mi korkuyorsunuz? Ha?!Dialogue: 50,0:03:03.66,0:03:05.04,Main-207-,,0,0,0,,H-Hayır...Dialogue: 50,0:03:05.04,0:03:09.00,Main-207-,,0,0,0,,Sıradan biri öyle devasa bir gemiyi doğrayabilir mi sanıyorsunuz?!Dialogue: 50,0:03:10.46,0:03:13.97,Main-207-,,0,0,0,,O muhtemelen bir şeytan meyvesinin gücüydü.Dialogue: 50,0:03:13.97,0:03:18.01,Main-207-,,0,0,0,,Şeytan meyvesi kullanıcıları toplum tarafından efsane olarak anılsada...Dialogue: 50,0:03:18.01,0:03:21.43,Main-207-,,0,0,0,,Grand Line onlarla dolu.Dialogue: 50,0:03:21.89,0:03:26.94,Main-207-,,0,0,0,,Mihawk gemimizi doğradığında garip bir güç kullanmış olmalı.Dialogue: 50,0:03:26.94,0:03:33.36,Main-207-,,0,0,0,,Grand Line’a girince, o velet de sıradan bir korsan olacak.Dialogue: 50,0:03:34.24,0:03:40.37,Main-207-,,0,0,0,,Ama Kızıl Bacak Zeff orada bir yıl boyunca seyahat etti.Dialogue: 50,0:03:42.83,0:03:47.71,Main-207-,,0,0,0,,Zeff’in o canavarlarla başa çıkmanın yolunu bildiğini düşünüyorum.Dialogue: 50,0:03:48.33,0:03:53.80,Main-207-,,0,0,0,,Ve bu yollar kesinlikle ondaki seyir defterinde yazıyor olmalı.Dialogue: 50,0:03:54.30,0:03:57.30,Main-207-,,0,0,0,,Eğer şanslıysak, One Piece ile ilgili bilgilerde.Dialogue: 50,0:03:57.63,0:04:00.05,Main-207-,,0,0,0,,Anladım... İşte bizim Don Krieg!Dialogue: 50,0:04:00.05,0:04:05.27,Main-207-,,0,0,0,,Gemi ve seyir defteri elimizdeyse, One Piece’e ulaşmak hâlâ mümkün!Dialogue: 50,0:04:05.27,0:04:07.31,Main-207-,,0,0,0,,Anladınız mı, beyler?!Dialogue: 50,0:04:07.31,0:04:09.65,Main-207-,,0,0,0,,Gidelim! O restoranı ele geçireceğiz!Dialogue: 50,0:04:09.65,0:04:11.23,Main-207-,,0,0,0,,– Evet! – Evet!Dialogue: 50,0:04:12.15,0:04:14.94,Main-207-,,0,0,0,,Bu gemi, biz aşçılarındır!Dialogue: 50,0:04:14.94,0:04:17.78,Main-207-,,0,0,0,,Yönetim odasına git ve yüzgeçleri aç.Dialogue: 50,0:04:17.78,0:04:21.12,Main-207-,,0,0,0,,Ne? Yüzgeçleri mi açayım?Dialogue: 50,0:04:21.12,0:04:23.49,Main-207-,,0,0,0,,Düşmana adım atacak zemin verecek!Dialogue: 50,0:04:23.49,0:04:24.95,Main-207-,,0,0,0,,Sorun değil.Dialogue: 50,0:04:24.95,0:04:28.50,Main-207-,,0,0,0,,İnsanlar içeride yemek yiyor, o yüzden savaşı dışarıda tutmalıyız.Dialogue: 50,0:04:28.50,0:04:32.25,Main-207-,,0,0,0,,Savaş içeride patlak verirse, bu moruk sızlanıp durur.Dialogue: 50,0:04:32.25,0:04:34.38,Main-207-,,0,0,0,,Bir şey mi dedin, lanet velet?Dialogue: 50,0:04:34.38,0:04:37.13,Main-207-,,0,0,0,,Evet, sızlanacağını söyledim! Hadi, git.Dialogue: 50,0:04:37.13,0:04:38.47,Main-207-,,0,0,0,,T-Tamam...!Dialogue: 50,0:04:41.22,0:04:44.60,Main-207-,,0,0,0,,Geliyorlar! Geliyorlar! Sonunda geliyorlar!Dialogue: 50,0:04:44.60,0:04:46.22,Main-207-,,0,0,0,,İşte gidiyorum!Dialogue: 50,0:04:46.22,0:04:49.02,Main-207-,,0,0,0,,Lastik-Lastik Roket!Dialogue: 50,0:04:49.64,0:04:51.31,Main-207-,,0,0,0,,Buraya doğru uçuyor!Dialogue: 50,0:04:51.77,0:04:52.65,Main-207-,,0,0,0,,Ve...Dialogue: 50,0:04:52.65,0:04:54.94,Main-207-,,0,0,0,,Lastik-Lastik...Dialogue: 50,0:04:54.90,0:04:57.03,Main-207-,,0,0,0,,Dev Tırpan!Dialogue: 50,0:05:07.29,0:05:09.54,Main-207-,,0,0,0,,O kamarot hiç fena değil!Dialogue: 50,0:05:09.54,0:05:11.08,Main-207-,,0,0,0,,B-Bu adam da...Dialogue: 50,0:05:11.08,0:05:12.46,Main-207-,,0,0,0,,neyin nesi?!Dialogue: 50,0:05:12.46,0:05:17.34,Main-207-,,0,0,0,,Grand Line böyle adamlarla mı kaynıyor?Dialogue: 50,0:05:17.34,0:05:18.51,Main-207-,,0,0,0,,Sanji!Dialogue: 50,0:05:19.34,0:05:22.30,Main-207-,,0,0,0,,Onun nasıl dövüştüğünü dikkatli izle.Dialogue: 50,0:05:22.68,0:05:26.18,Main-207-,,0,0,0,,Sana yemek veren restorana saldırdığına inanamıyorum.Dialogue: 50,0:05:26.18,0:05:29.56,Main-207-,,0,0,0,,Senin gibi iyilik bilmez bir pisliği mahvedeceğim!Dialogue: 50,0:05:31.85,0:05:34.81,Main-207-,,0,0,0,,Sınırlı alan varken su üstünde dövüşmek mi?Dialogue: 50,0:05:34.81,0:05:39.82,Main-207-,,0,0,0,,En azından şeytan meyvesi yiyenler yüzemez, değil mi...Dialogue: 50,0:05:39.82,0:05:40.99,Main-207-,,0,0,0,,çapa velet?!Dialogue: 50,0:05:40.99,0:05:43.32,Main-207-,,0,0,0,,Evet! Onun yerine esniyorum!Dialogue: 50,0:05:46.28,0:05:49.25,Main-207-,,0,0,0,,Sanji! Yüzgeçler açılıyor!Dialogue: 50,0:06:03.05,0:06:04.76,Main-207-,,0,0,0,,Denizden...Dialogue: 50,0:06:05.30,0:06:07.64,Main-207-,,0,0,0,,bir platform yükseliyor!Dialogue: 50,0:06:18.98,0:06:21.90,Main-207-,,0,0,0,,Oha, çok iyi!Dialogue: 50,0:06:26.12,0:06:29.62,Main-207-,,0,0,0,,Ölene kadar savaşacağız, lanet korsanlar!Dialogue: 50,0:06:29.62,0:06:30.87,Main-207-,,0,0,0,,Anladım.Dialogue: 50,0:06:30.87,0:06:34.25,Main-207-,,0,0,0,,Restoranı korumak için savaş alanı oluşturdunuz.Dialogue: 50,0:06:34.83,0:06:38.75,Main-207-,,0,0,0,,O gemi zaten bizim olacağı için, bu bizim işimize de geliyor.Dialogue: 50,0:06:38.75,0:06:42.17,Main-207-,,0,0,0,,O gemiyi daha çok istemeye başladım.Dialogue: 50,0:06:43.22,0:06:46.05,Main-207-,,0,0,0,,Bu restoranı almanıza izin vermeyeceğiz!Dialogue: 50,0:06:46.05,0:06:48.43,Main-207-,,0,0,0,,Evet! Bizi küçümseme!Dialogue: 50,0:06:48.43,0:06:50.97,Main-207-,,0,0,0,,Biz dövüşçü aşçılarız!Dialogue: 50,0:06:58.73,0:07:02.86,Main-207-,,0,0,0,,Hadi! Baratie'nin deniz savaşı silahı, Uskumru Kafa 1!Dialogue: 50,0:07:02.86,0:07:06.70,Main-207-,,0,0,0,,Eğer ölmek istemiyorsanız, buradan hemen gidin!Dialogue: 50,0:07:10.24,0:07:11.74,Main-207-,,0,0,0,,O da ne?Dialogue: 50,0:07:11.74,0:07:14.21,Main-207-,,0,0,0,,Çok havalı! Ben de istiyorum!Dialogue: 50,0:07:14.21,0:07:15.92,Main-207-,,0,0,0,,Daha hızlı sür!Dialogue: 50,0:07:15.92,0:07:16.71,Main-207-,,0,0,0,,Deniyorum!Dialogue: 50,0:07:18.71,0:07:20.54,Main-207-,,0,0,0,,Ateş!Dialogue: 50,0:07:25.34,0:07:27.09,Main-207-,,0,0,0,,Düşeceğim!Dialogue: 50,0:07:28.68,0:07:29.85,Main-207-,,0,0,0,,Tamamdır! Aferin!Dialogue: 50,0:07:29.85,0:07:33.52,Main-207-,,0,0,0,,Patty! Carne! Bitirin işlerini!Dialogue: 50,0:07:35.73,0:07:37.19,Main-207-,,0,0,0,,Oldukça iyiler!Dialogue: 50,0:07:39.19,0:07:42.40,Main-207-,,0,0,0,,Başka yöne bakma! Ona nişan alıyoruz!Dialogue: 50,0:07:42.40,0:07:44.15,Main-207-,,0,0,0,,Anlaşıldı!Dialogue: 50,0:07:44.15,0:07:46.95,Main-207-,,0,0,0,,Krieg! Hazırla kendini!Dialogue: 50,0:07:47.36,0:07:52.91,Main-207-,,0,0,0,,Deniz Restoranı Baratie’nin denizlerdeki savaş gücüne şahit ol!Dialogue: 50,0:08:02.67,0:08:04.67,Main-207-,,0,0,0,,Ne? Bir şeye mi çarptık?Dialogue: 50,0:08:04.67,0:08:06.59,Main-207-,,0,0,0,,Ha? Sıkıştık!Dialogue: 50,0:08:07.13,0:08:09.18,Main-207-,,0,0,0,,Ben Don Krieg...Dialogue: 50,0:08:09.93,0:08:12.47,Main-207-,,0,0,0,,Dünyanın denizlerine hükmedecek olan adamım!Dialogue: 50,0:08:12.47,0:08:14.43,Main-207-,,0,0,0,,O ben olacağım dedim ya!Dialogue: 50,0:08:14.43,0:08:17.69,Main-207-,,0,0,0,,Sizin oyunlarınıza zamanım yok!Dialogue: 50,0:08:22.61,0:08:24.69,Main-207-,,0,0,0,,Ne kadar da delice bir kuvvet!Dialogue: 50,0:08:33.16,0:08:35.54,Main-207-,,0,0,0,,Bu tarafa doğru geliyor!Dialogue: 50,0:08:35.54,0:08:38.08,Main-207-,,0,0,0,,Restoran yok olacak!Dialogue: 50,0:08:55.56,0:08:56.64,Main-207-,,0,0,0,,– Sanji! – Sanji!Dialogue: 50,0:08:56.64,0:08:58.27,Main-207-,,0,0,0,,A-Ayağıyla mı?!Dialogue: 50,0:09:10.45,0:09:12.57,Main-207-,,0,0,0,,O-O nasıl bir bacak gücü!Dialogue: 50,0:09:12.57,0:09:15.41,Main-207-,,0,0,0,,O garip tekneyi uzağa tekmeledi!Dialogue: 50,0:09:15.95,0:09:17.75,Main-207-,,0,0,0,,O ayak tekniği...Dialogue: 50,0:09:17.75,0:09:19.04,Main-207-,,0,0,0,,Oldukça iyi!Dialogue: 50,0:09:23.25,0:09:24.75,Main-207-,,0,0,0,,Seni pislik, Sanji!Dialogue: 50,0:09:24.75,0:09:26.34,Main-207-,,0,0,0,,Müttefiklerini mi ezeceksin?!Dialogue: 50,0:09:26.96,0:09:27.71,Main-207-,,0,0,0,,Evet.Dialogue: 50,0:09:27.71,0:09:30.63,Main-207-,,0,0,0,,Evet de ne demek seni çılgın yahni!Dialogue: 50,0:09:30.63,0:09:35.47,Main-207-,,0,0,0,,Az kalsın güçlü müttefikler kaybediyordun, seni makarna kafalı!Dialogue: 50,0:09:35.93,0:09:41.10,Main-207-,,0,0,0,,Şu an aşçıların şaka yapma zamanı mı gerçekten?Dialogue: 50,0:09:42.19,0:09:43.81,Main-207-,,0,0,0,,Halledelim şunları!Dialogue: 50,0:09:51.95,0:09:54.37,Main-207-,,0,0,0,,Silahı bile olsa, aşçı aşçıdır.Dialogue: 50,0:09:54.37,0:09:57.74,Main-207-,,0,0,0,,Biz sizden çok ayrı bir seviyede olan uzman dövüşçüleriz.Dialogue: 50,0:09:57.74,0:10:02.37,Main-207-,,0,0,0,,Şimdi, uslu aşçılar olun ve karada yemek yapacak yer bulun.Dialogue: 50,0:10:02.37,0:10:06.04,Main-207-,,0,0,0,,Hey, beyler! Neden kolayca alt ediliyorsunuz?!Dialogue: 50,0:10:06.04,0:10:08.25,Main-207-,,0,0,0,,Kendinize dövüşçü aşçı mı diyorsunuz?!Dialogue: 50,0:10:09.13,0:10:10.21,Main-207-,,0,0,0,,Çok güçlüler!Dialogue: 50,0:10:10.59,0:10:13.38,Main-207-,,0,0,0,,Önceki düşmanlardan çok farklılar!Dialogue: 50,0:10:13.38,0:10:16.97,Main-207-,,0,0,0,,Bizi o sıradan korsanlarla bir tutmayın.Dialogue: 50,0:10:16.97,0:10:21.23,Main-207-,,0,0,0,,Biz Doğu Mavi'nin hakimleri, Krieg Korsanları'yız.Dialogue: 50,0:10:21.23,0:10:27.19,Main-207-,,0,0,0,,Krieg Korsanları’nın buyruğuyla, o gemi artık bizim!Dialogue: 50,0:10:27.19,0:10:29.48,Main-207-,,0,0,0,,On yıldan fazladır aşçıyım.Dialogue: 50,0:10:29.48,0:10:31.82,Main-207-,,0,0,0,,300 restoranda çalıştım.Dialogue: 50,0:10:31.82,0:10:34.91,Main-207-,,0,0,0,,Hep sorun çıkardığım ve kaba olduğum için kovuldum.Dialogue: 50,0:10:34.91,0:10:38.91,Main-207-,,0,0,0,,Onca restorana uğradıktan sonra bu restorana geldik.Dialogue: 50,0:10:40.20,0:10:41.91,Flashbacks-207-,,0,0,0,,Kimse var mı?!Dialogue: 50,0:10:41.91,0:10:45.54,Flashbacks-207-,,0,0,0,,Kızıl Bacak Zeff tarafından işletilen restoran burası mı?!Dialogue: 50,0:10:45.54,0:10:48.38,Flashbacks-207-,,0,0,0,,Bu "Lanet Aşçılar Aranıyor" afişi doğru olsa iyi olur!Dialogue: 50,0:10:51.88,0:10:54.09,Flashbacks-207-,,0,0,0,,Evet, doğru.Dialogue: 50,0:10:56.59,0:11:00.51,Flashbacks-207-,,0,0,0,,İster uzman suçlular olsunlar, ister kaçak mahkumlar olsunlar,Dialogue: 50,0:11:00.51,0:11:05.14,Flashbacks-207-,,0,0,0,,eğer yemek istiyorlarsa ve yolları bu restorana düşmüşse,Dialogue: 50,0:11:05.14,0:11:07.65,Flashbacks-207-,,0,0,0,,karınları doyana kadar onları besleyeceğiz.Dialogue: 50,0:11:07.65,0:11:11.65,Flashbacks-207-,,0,0,0,,Bununla baş edebilir misiniz?!Dialogue: 50,0:11:11.65,0:11:13.03,Flashbacks-207-,,0,0,0,,– Başüstüne! – Başüstüne!Dialogue: 50,0:11:19.12,0:11:21.91,Flashbacks-207-,,0,0,0,,Müşterilere böyle berbat bir çorba veremeyiz!Dialogue: 50,0:11:22.33,0:11:23.95,Flashbacks-207-,,0,0,0,,Neden bana vuruyorsun?!Dialogue: 50,0:11:23.95,0:11:25.71,Flashbacks-207-,,0,0,0,,Bu kararlılığın bir işareti!Dialogue: 50,0:11:25.71,0:11:27.21,Flashbacks-207-,,0,0,0,,Kapa çeneni!Dialogue: 50,0:11:27.21,0:11:30.88,Main-207-,,0,0,0,,Dövüşmek ya da yemek pişirmek, istediğimizi yaparız.Dialogue: 50,0:11:30.88,0:11:33.96,Main-207-,,0,0,0,,Başka hiçbir restoran ile kıyaslanamaz!Dialogue: 50,0:11:33.96,0:11:35.17,Main-207-,,0,0,0,,Öyle diyolar.Dialogue: 50,0:11:35.17,0:11:37.18,Main-207-,,0,0,0,,Anladın mı, Krieg?Dialogue: 50,0:11:37.64,0:11:41.64,Main-207-,,0,0,0,,Her gün kendimizi yemek pişirmeye adamak zorlu bir savaştı.Dialogue: 50,0:11:41.64,0:11:46.14,Main-207-,,0,0,0,,Onunla karşılaştırıldığında, siz korsanlar hiçbir şey!Dialogue: 50,0:11:46.14,0:11:47.60,Main-207-,,0,0,0,,Aynen öyle!Dialogue: 50,0:11:47.60,0:11:48.65,Main-207-,,0,0,0,,Dövüşelim!Dialogue: 50,0:11:48.65,0:11:49.31,Main-207-,,0,0,0,,– Evet! – Evet!Dialogue: 50,0:11:49.31,0:11:51.77,Main-207-,,0,0,0,,Patronu koruyun!Dialogue: 50,0:11:50.11,0:11:51.77,Secondary-207-,,0,0,0,,Restoranı koruyun!Dialogue: 50,0:12:04.54,0:12:05.75,Main-207-,,0,0,0,,O-O da kim...?Dialogue: 50,0:12:13.92,0:12:16.55,Main-207-,,0,0,0,,Ne yapıyorsunuz siz?Dialogue: 50,0:12:17.84,0:12:19.89,Main-207-,,0,0,0,,Bu ucube de neyin nesi?Dialogue: 50,0:12:22.97,0:12:24.89,Main-207-,,0,0,0,,Saldırılamaz: dolayısıyla yenilmez!Dialogue: 50,0:12:24.89,0:12:27.85,Main-207-,,0,0,0,,Krieg Korsanları'nın yenilmez üyesi,Dialogue: 50,0:12:28.23,0:12:30.48,Main-207-,,0,0,0,,Pearl-san derken, benden bahsederler.Dialogue: 50,0:12:30.85,0:12:32.19,Main-207-,,0,0,0,,Pearl-san!Dialogue: 50,0:12:32.56,0:12:35.15,Main-207-,,0,0,0,,Patty! Carne! İyi misiniz?!Dialogue: 50,0:12:35.15,0:12:42.12,Main-207-,,0,0,0,,İyi değiller, çünkü Pearl'ün Sürprizi'ni yani ölümcül yumruğumu tattılar.Dialogue: 50,0:12:44.24,0:12:48.21,Main-207-,,0,0,0,,Vay! Ne kadar da güzel bir bıçak. Alacağım.Dialogue: 50,0:12:49.04,0:12:54.00,Main-207-,,0,0,0,,Hey, bırak şunu. Ver şunu bana! Bırak şunu, seni lanet herif!Dialogue: 50,0:13:06.52,0:13:09.10,Main-207-,,0,0,0,,Gerçekten de iyi tekme atıyor!Dialogue: 50,0:13:09.10,0:13:11.44,Main-207-,,0,0,0,,Mutfak bıçağı bir aşçının ruhudur.Dialogue: 50,0:13:11.44,0:13:15.07,Main-207-,,0,0,0,,Siz amatörler sakın düşüncesizce ona elinizi sürmeyin!Dialogue: 50,0:13:15.69,0:13:16.78,Main-207-,,0,0,0,,Sanji...Dialogue: 50,0:13:17.36,0:13:19.40,Main-207-,,0,0,0,,Şunu sıkıca tut ve yerde kal.Dialogue: 50,0:13:20.40,0:13:22.49,Main-207-,,0,0,0,,Onların icabına ben bakacağım.Dialogue: 50,0:13:22.82,0:13:25.99,Main-207-,,0,0,0,,Sıradan bir aşçıya yenilmeyeceğiz!Dialogue: 50,0:13:34.13,0:13:35.59,Main-207-,,0,0,0,,Sıradan bir aşçı mı?Dialogue: 50,0:13:35.59,0:13:38.01,Main-207-,,0,0,0,,O zaman sizi fileto yapmama ne dersiniz, piçler?!Dialogue: 50,0:13:39.97,0:13:43.14,Main-207-,,0,0,0,,Onları sadece tekmelerle dövmen ne kadar da saygısızca.Dialogue: 50,0:13:43.14,0:13:45.10,Main-207-,,0,0,0,,Bu bir prensip mi?Dialogue: 50,0:13:45.43,0:13:47.43,Main-207-,,0,0,0,,Bir aşçı için, elleri hayatıdır.Dialogue: 50,0:13:47.43,0:13:50.52,Main-207-,,0,0,0,,Dövüşte onları incitemem.Dialogue: 50,0:13:50.52,0:13:53.06,Main-207-,,0,0,0,,Seni de bu bacak ile indireceğim.Dialogue: 50,0:13:53.06,0:13:54.52,Main-207-,,0,0,0,,İndirmek mi?Dialogue: 50,0:13:54.52,0:13:55.94,Main-207-,,0,0,0,,Saçmalık.Dialogue: 50,0:13:55.94,0:14:00.99,Main-207-,,0,0,0,,Ben bütün 61 savaşımı da hasar almadan kazanan yenilmez biriyim.Dialogue: 50,0:14:01.61,0:14:05.91,Main-207-,,0,0,0,,Hiçbir savaşta kanımın döküldüğü olmadı,Dialogue: 50,0:14:05.91,0:14:08.12,Main-207-,,0,0,0,,bir damla bile.Dialogue: 50,0:14:08.54,0:14:10.95,Main-207-,,0,0,0,,Hasarsız zafer, gücümün kanıtıdır.Dialogue: 50,0:14:13.04,0:14:16.00,Main-207-,,0,0,0,,Ben bir kalkan adam ve bir centilmenim.Dialogue: 50,0:14:16.42,0:14:17.96,Main-207-,,0,0,0,,Zarifim, değil mi?Dialogue: 50,0:14:18.46,0:14:21.42,Main-207-,,0,0,0,,Bu bir espri miydi? Hiç komik değildi.Dialogue: 50,0:14:21.42,0:14:23.18,Main-207-,,0,0,0,,Hey, hasır şapkalı velet!Dialogue: 50,0:14:23.18,0:14:25.26,Main-207-,,0,0,0,,Dikkat et, yoksa canın yanacak!Dialogue: 50,0:14:31.81,0:14:34.81,Main-207-,,0,0,0,,Savaş gemisi topları bile bana işlemez.Dialogue: 50,0:14:34.81,0:14:36.77,Main-207-,,0,0,0,,Hiçbir saldırıdan hasar almam!Dialogue: 50,0:14:39.98,0:14:42.28,Main-207-,,0,0,0,,Ah, ödüm patladı.Dialogue: 50,0:14:42.28,0:14:43.99,Main-207-,,0,0,0,,Denize düşmediğim iyi oldu.Dialogue: 50,0:14:47.66,0:14:48.53,Main-207-,,0,0,0,,Ne?Dialogue: 50,0:14:50.16,0:14:51.62,Main-207-,,0,0,0,,Sıçtık.Dialogue: 50,0:14:51.62,0:14:52.87,Main-207-,,0,0,0,,Kan! Olamaz!Dialogue: 50,0:14:52.87,0:14:54.58,Main-207-,,0,0,0,,Pearl-san, endişelenmeyin!Dialogue: 50,0:14:54.96,0:14:56.33,Main-207-,,0,0,0,,Sadece bir burun kanaması!Dialogue: 50,0:14:56.33,0:14:58.59,Main-207-,,0,0,0,,Dövüşürken olan bir yara değil!Dialogue: 50,0:14:58.59,0:15:01.05,Main-207-,,0,0,0,,Lütfen sakinleşin, Pearl-san!Dialogue: 50,0:15:01.05,0:15:02.05,Main-207-,,0,0,0,,Ne oluyor?Dialogue: 50,0:15:02.46,0:15:05.01,Main-207-,,0,0,0,,O-O-O-O-Onlar tehlikeliler!Dialogue: 50,0:15:05.38,0:15:08.01,Main-207-,,0,0,0,,Onun neyi var? Garip davranıyor.Dialogue: 50,0:15:08.76,0:15:10.47,Main-207-,,0,0,0,,Burnu kanadıysa ne olmuş?Dialogue: 50,0:15:13.60,0:15:15.56,Main-207-,,0,0,0,,Kes şunu, Pearl!Dialogue: 50,0:15:15.56,0:15:17.94,Main-207-,,0,0,0,,Sadece bir burun kanaması! Sakinliğini koru!Dialogue: 50,0:15:20.48,0:15:22.36,Main-207-,,0,0,0,,O ne yapmaya çalışıyor?Dialogue: 50,0:15:22.69,0:15:28.37,Main-207-,,0,0,0,,Tehlike! Tehlike! Tehlike!Dialogue: 50,0:15:32.12,0:15:33.83,Main-207-,,0,0,0,,Olamaz! Başladı!Dialogue: 50,0:15:33.83,0:15:37.00,Main-207-,,0,0,0,,Pearl sakinliğini kaybettiğinde, gerçekten tutuşuyor!Dialogue: 50,0:15:37.00,0:15:38.04,Main-207-,,0,0,0,,Ne?Dialogue: 50,0:15:38.88,0:15:42.59,Main-207-,,0,0,0,,Ateş İncisi...Dialogue: 50,0:15:43.21,0:15:46.01,Main-207-,,0,0,0,,Patlama!Dialogue: 50,0:15:47.97,0:15:50.85,Main-207-,,0,0,0,,Pearl-san! Lütfen durun!Dialogue: 50,0:15:52.93,0:15:56.69,Main-207-,,0,0,0,,Yanın! Bu alev ve ateşten kalkanımla...Dialogue: 50,0:15:56.69,0:15:58.90,Main-207-,,0,0,0,,ne kadar yenilmez olduğumu bilemezsiniz!Dialogue: 50,0:16:00.81,0:16:04.90,Main-207-,,0,0,0,,Gerzek! Sahiplenmeye çalıştığımız gemiyi kül edecek!Dialogue: 50,0:16:04.90,0:16:07.74,Secondary-207-,,0,0,0,,Ah, ah, ah, ah...Dialogue: 50,0:16:06.24,0:16:07.24,Main-207-,,0,0,0,,Kahretsin!Dialogue: 50,0:16:07.74,0:16:11.24,Main-207-,,0,0,0,,Kahretsin! Açık sularda alev denizinden kaçış yok!Dialogue: 50,0:16:11.24,0:16:13.95,Main-207-,,0,0,0,,Bu hiç iyi değil! Restoran yanacak!Dialogue: 50,0:16:14.45,0:16:16.46,Main-207-,,0,0,0,,Restoran yanacak mı dedin?Dialogue: 50,0:16:16.46,0:16:17.75,Main-207-,,0,0,0,,Yanın! Yanın!Dialogue: 50,0:16:17.75,0:16:18.87,Main-207-,,0,0,0,,Orospu çocuğu!Dialogue: 50,0:16:19.21,0:16:21.84,Main-207-,,0,0,0,,Aptal! Kavrulacaksın, Sanji!Dialogue: 50,0:16:22.75,0:16:24.34,Main-207-,,0,0,0,,Bu restoranı...Dialogue: 50,0:16:24.34,0:16:27.17,Main-207-,,0,0,0,,yakmana izin vermeyeceğim!Dialogue: 50,0:16:30.39,0:16:32.93,Main-207-,,0,0,0,,N-Ne kadar da pervasız!Dialogue: 50,0:16:32.93,0:16:34.68,Main-207-,,0,0,0,,Kızarmak mı istiyor?!Dialogue: 50,0:16:35.27,0:16:38.19,Main-207-,,0,0,0,,En vahşi hayvanlar bile Ateş İncisi'nden uzak durur.Dialogue: 50,0:16:40.27,0:16:41.56,Main-207-,,0,0,0,,Seni kafasız!Dialogue: 50,0:16:41.56,0:16:44.15,Main-207-,,0,0,0,,Eğer ateşten korksaydım aşçı olmazdım!Dialogue: 50,0:16:44.15,0:16:46.53,Main-207-,,0,0,0,,L-Lanet olsun!Dialogue: 50,0:16:46.53,0:16:48.57,Main-207-,,0,0,0,,Ne kadar da zarif bir herif!Dialogue: 50,0:16:49.57,0:16:50.41,Main-207-,,0,0,0,,Hadi bakalım!Dialogue: 50,0:16:55.08,0:16:56.29,Main-207-,,0,0,0,,Çok iyi vurdu!Dialogue: 50,0:16:56.29,0:16:58.87,Main-207-,,0,0,0,,Pearl-san'ın yenilmez duvarını yıktı!Dialogue: 50,0:17:03.88,0:17:05.38,Main-207-,,0,0,0,,Bu aşçı da ne?Dialogue: 50,0:17:05.38,0:17:07.26,Main-207-,,0,0,0,,Kafayı yemiş...!Dialogue: 50,0:17:07.26,0:17:12.30,Main-207-,,0,0,0,,S-S-S-S-Seni pislik! Ateş! Daha fazla ateş!Dialogue: 50,0:17:12.30,0:17:14.76,Main-207-,,0,0,0,,Daha fazla ateş incisi lazım!Dialogue: 50,0:17:16.72,0:17:18.23,Main-207-,,0,0,0,,Restoran alev alıcak!Dialogue: 50,0:17:18.23,0:17:21.73,Main-207-,,0,0,0,,Eğer alevler mutfağa ulaşırsa, restoran havaya uçar!Dialogue: 50,0:17:21.73,0:17:23.77,Main-207-,,0,0,0,,Patron! Lütfen oradan çekilin!Dialogue: 50,0:17:23.77,0:17:25.77,Main-207-,,0,0,0,,Patron!Dialogue: 50,0:17:36.03,0:17:39.00,Main-207-,,0,0,0,,A-Ateş incilerim!Dialogue: 50,0:17:39.00,0:17:41.50,Main-207-,,0,0,0,,Böyle şeyler çocuk oyuncağı!Dialogue: 50,0:17:41.83,0:17:44.46,Main-207-,,0,0,0,,Tekmesinden gelen rüzgar alevleri söndürdü!Dialogue: 50,0:17:44.46,0:17:46.71,Main-207-,,0,0,0,,Bu da ne?! Bu adam insanüstü!Dialogue: 50,0:17:46.71,0:17:49.42,Main-207-,,0,0,0,,Yani Kızıl Bacak Zeff hâlâ güçlü mü?!Dialogue: 50,0:17:49.80,0:17:52.34,Main-207-,,0,0,0,,Bu harikaydı, ihtiyar! Çok etkilendim!Dialogue: 50,0:17:52.34,0:17:53.64,Main-207-,,0,0,0,,O zaman,Dialogue: 50,0:17:53.64,0:17:58.47,Main-207-,,0,0,0,,restoran alev almadan önce sizi yüzgeçlerle birlikte batıracağım!Dialogue: 50,0:18:01.73,0:18:04.19,Main-207-,,0,0,0,,Sanji! Dikkat et!Dialogue: 50,0:18:04.52,0:18:07.19,Main-207-,,0,0,0,,Olamaz! Etrafı alevlerle kaplı!Dialogue: 50,0:18:11.45,0:18:12.28,Main-207-,,0,0,0,,Ah, ah, ah...Dialogue: 50,0:18:12.28,0:18:13.53,Main-207-,,0,0,0,,Kamarot!Dialogue: 50,0:18:13.78,0:18:17.16,Main-207-,,0,0,0,,Lastik-Lastik Bazuka!Dialogue: 50,0:18:18.99,0:18:21.29,Main-207-,,0,0,0,,Demir topu geri gönderdi!Dialogue: 50,0:18:18.99,0:18:21.29,Secondary-207-,,0,0,0,,Ah, ah, ah...Dialogue: 50,0:18:21.29,0:18:23.96,Main-207-,,0,0,0,,Ah, ah, ah!Dialogue: 50,0:18:37.85,0:18:40.85,Main-207-,,0,0,0,,Pearl-san'ın bu sefer işi bitti!Dialogue: 50,0:18:40.85,0:18:42.81,Main-207-,,0,0,0,,– Pearl-san...! – Pearl-san...!Dialogue: 50,0:18:42.81,0:18:44.73,Main-207-,,0,0,0,,O da neydi?Dialogue: 50,0:18:44.73,0:18:46.27,Main-207-,,0,0,0,,O adam cidden aptal.Dialogue: 50,0:18:46.77,0:18:48.65,Main-207-,,0,0,0,,Herkes mi işe yaramaz.Dialogue: 50,0:18:48.65,0:18:51.28,Main-207-,,0,0,0,,Nihayetinde, güvenebileceğim tek kişi kendim.Dialogue: 50,0:18:57.32,0:19:00.16,Main-207-,,0,0,0,,Bu savaş burada biter.Dialogue: 0,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 1,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 0,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Galaxy 9000 MeggoDialogue: 1,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Galaxy 9000 MeggoDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,