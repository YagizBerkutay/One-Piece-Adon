FFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,1.9,1.9,2,180,180,27,1Style: Kanji-furigana,Duality,36,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,2.95,0,8,23,23,146,1Style: Karaoke-furigana,Duality,36,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,2.95,0,8,23,23,23,1Style: Lyrics-furigana,Duality,36,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,2.95,0,2,23,23,34,1Style: Lyrics,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,2,23,23,34,1Style: Karaoke,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,23,1Style: Kanji,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,146,1Style: Roger-Monologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1Style: Romaji ED,Josefin Sans,82,&H00FFFFFF,&H003592BE,&H00000000,&H64000000,0,0,0,0,100,100,0,0,1,0,4,8,10,10,20,1Style: Translation ED,Josefin Sans,82,&H00FFFFFF,&H000000FF,&H00FFFFFF,&H64000000,0,0,0,0,100,100,0,0,1,0,4,2,10,10,20,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:50.01,0:02:00.01,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 50,0:01:50.01,0:01:51.47,Main-207-,,0,0,0,,Hey, uşak!Dialogue: 50,0:01:51.47,0:01:52.51,Main-207-,,0,0,0,,Dayan!Dialogue: 50,0:01:52.51,0:01:53.76,Main-207-,,0,0,0,,Şimdi, nefes al!Dialogue: 50,0:01:53.76,0:01:55.51,Main-207-,,0,0,0,,İyice derin derin al!Dialogue: 50,0:01:55.51,0:01:57.76,Main-207-,,0,0,0,,İyi misin? Hey!Dialogue: 50,0:01:57.76,0:02:00.14,Main-207-,,0,0,0,,Biraz su ister misin? Hey!Dialogue: 50,0:02:01.81,0:02:03.19,Main-207-,,0,0,0,,Bu hiç iyi değil!Dialogue: 50,0:02:03.19,0:02:05.44,Main-207-,,0,0,0,,Benim özel puddingimi yemek ister misin?Dialogue: 50,0:02:05.44,0:02:06.15,Main-207-,,0,0,0,,Çok iyidir!Dialogue: 50,0:02:06.15,0:02:09.57,Main-207-,,0,0,0,,Aptal! Zehirlenmiş birine zehir mi yedirmek istiyorsun?!Dialogue: 50,0:02:09.57,0:02:11.28,Main-207-,,0,0,0,,Hey, zehir derken?!Dialogue: 50,0:02:11.28,0:02:13.07,Main-207-,,0,0,0,,Konuşana bak hele!Dialogue: 50,0:02:13.07,0:02:14.07,Main-207-,,0,0,0,,Ne dedin?!Dialogue: 50,0:02:14.07,0:02:16.70,Main-207-,,0,0,0,,Herkes etli yemeklerime dünyanın en iyisi der!Dialogue: 50,0:02:16.70,0:02:19.24,Main-207-,,0,0,0,,Uğruna ölünecek kadar iyiler!Dialogue: 50,0:02:19.87,0:02:21.12,Main-207-,,0,0,0,,Sakın ölme!Dialogue: 50,0:02:23.87,0:02:26.75,Main-207-,,0,0,0,,B-Bu dövüşün sonucu ne olacak?Dialogue: 50,0:02:26.75,0:02:28.84,Main-207-,,0,0,0,,Aptal! O sadece acemi şansıydı!Dialogue: 50,0:02:28.84,0:02:31.84,Main-207-,,0,0,0,,Don'un öyle aptal bir velede yenilmesinin imkanı yok!Dialogue: 50,0:02:31.84,0:02:33.22,Main-207-,,0,0,0,,Endişelenme!Dialogue: 50,0:02:33.22,0:02:34.63,Main-207-,,0,0,0,,Kamarot...Dialogue: 50,0:02:36.30,0:02:41.27,Main-207-,,0,0,0,,“Burada ölmeyeceğim” diyorsun, ha?Dialogue: 50,0:02:44.27,0:02:47.69,Main-207-,,0,0,0,,Eğer burada ölmeyeceksen...Dialogue: 50,0:02:47.69,0:02:49.65,Main-207-,,0,0,0,,o zaman...Dialogue: 50,0:02:50.23,0:02:52.69,Main-207-,,0,0,0,,kim ölecek?!Dialogue: 50,0:02:54.15,0:02:55.66,Main-207-,,0,0,0,,Elbette, sen!Dialogue: 50,0:02:57.37,0:02:59.37,Main-207-,,0,0,0,,Hayır, sen!Dialogue: 50,0:03:03.41,0:03:05.42,Main-207-,,0,0,0,,Don yine dayak yedi!Dialogue: 50,0:03:05.42,0:03:08.00,Main-207-,,0,0,0,,Neler oluyor?!Dialogue: 50,0:03:08.54,0:03:14.51,Main-207-,,0,0,0,,D-Düşmanlarımızın daha Don'a dokunamadan ölmeleri gerekiyordu.Dialogue: 50,0:03:14.97,0:03:17.30,Main-207-,,0,0,0,,Don'un yenilmez olması gerekiyordu.Dialogue: 50,0:03:17.30,0:03:18.39,Main-207-,,0,0,0,,O...Dialogue: 50,0:03:20.22,0:03:22.39,Main-207-,,0,0,0,,O velet de neyin nesi?!Dialogue: 50,0:03:24.56,0:03:26.98,Main-207-,,0,0,0,,Cidden iyi!Dialogue: 50,0:03:26.98,0:03:29.52,Main-207-,,0,0,0,,Evet, aklım almıyor.Dialogue: 50,0:03:29.52,0:03:30.77,Main-207-,,0,0,0,,O muhteşem!Dialogue: 50,0:03:30.77,0:03:32.36,Main-207-,,0,0,0,,Krieg'in işini bitir!Dialogue: 50,0:03:32.36,0:03:34.69,Main-207-,,0,0,0,,Evet, yapabilir!Dialogue: 50,0:03:34.69,0:03:38.07,Main-207-,,0,0,0,,O velet cidden Don'un seviyesinde dövüşüyor.Dialogue: 50,0:03:38.07,0:03:41.24,Main-207-,,0,0,0,,Şaka gibi... Don, onun gibi birine mi yeniliyor?Dialogue: 50,0:03:41.24,0:03:43.08,Main-207-,,0,0,0,,Don yenilmez biri olmalıydı...Dialogue: 50,0:03:43.08,0:03:46.21,Main-207-,,0,0,0,,Don Krieg’in “en güçlü” unvanı tarihe karışmak üzere.Dialogue: 50,0:03:46.21,0:03:48.67,Main-207-,,0,0,0,,Saçma sapan konuşmayı bırakın!Dialogue: 50,0:03:56.84,0:03:58.09,Main-207-,,0,0,0,,O da...Dialogue: 50,0:03:59.05,0:04:01.35,Main-207-,,0,0,0,,S-Sonunda...Dialogue: 50,0:04:01.35,0:04:03.56,Main-207-,,0,0,0,,Don Krieg'in en güçlü silahı...Dialogue: 50,0:04:03.56,0:04:05.06,Main-207-,,0,0,0,,Kudretli Savaş Mızrağı!Dialogue: 50,0:04:06.23,0:04:07.48,Main-207-,,0,0,0,,O da ne?Dialogue: 50,0:04:07.48,0:04:08.73,Main-207-,,0,0,0,,Patladı.Dialogue: 50,0:04:09.15,0:04:10.65,Main-207-,,0,0,0,,Şimdi...Dialogue: 50,0:04:10.65,0:04:13.40,Main-207-,,0,0,0,,Daha ne kadar kaçabileceğini görelim.Dialogue: 50,0:04:13.40,0:04:16.28,Main-207-,,0,0,0,,İzlemesi güzel olacak, çapa çocuk.Dialogue: 50,0:04:16.65,0:04:21.03,Main-207-,,0,0,0,,O uyduruk kazıklara dayanmış olabilirsin ama..Dialogue: 50,0:04:21.03,0:04:24.74,Main-207-,,0,0,0,,Kudretli Savaş Mızrağı bambaşkadır.Dialogue: 50,0:04:25.54,0:04:27.75,Main-207-,,0,0,0,,Ona dokunduğun an parçalanırsın!Dialogue: 50,0:04:30.42,0:04:32.38,Main-207-,,0,0,0,,O mızrak da ne öyle?!Dialogue: 50,0:04:33.84,0:04:35.80,Main-207-,,0,0,0,,Sakın düşme, düşme!Dialogue: 50,0:04:36.30,0:04:38.13,Main-207-,,0,0,0,,O mızrak da neyin nesi?Dialogue: 50,0:04:38.13,0:04:40.76,Main-207-,,0,0,0,,Her vuruşta patlıyor mu?Dialogue: 50,0:04:42.35,0:04:44.47,Main-207-,,0,0,0,,Ne? Dizlerim...Dialogue: 50,0:04:46.56,0:04:48.81,Main-207-,,0,0,0,,Bu dövüş uzarsa sıkıntı...Dialogue: 50,0:04:48.81,0:04:50.44,Main-207-,,0,0,0,,Çok kan kaybetti.Dialogue: 50,0:04:50.85,0:04:52.52,Main-207-,,0,0,0,,Fazla dayanamaz...Dialogue: 50,0:04:52.52,0:04:55.02,Main-207-,,0,0,0,,Kendini çok zorladın.Dialogue: 50,0:04:55.02,0:04:58.49,Main-207-,,0,0,0,,Artık sınırına ulaşıyor olmalısın.Dialogue: 50,0:04:58.49,0:04:59.99,Main-207-,,0,0,0,,Kahretsin...Dialogue: 50,0:04:59.99,0:05:03.49,Main-207-,,0,0,0,,Bu sarsıntıda tam kapasite dövüşemem.Dialogue: 50,0:05:03.49,0:05:04.99,Main-207-,,0,0,0,,Bitkinim.Dialogue: 50,0:05:04.99,0:05:09.25,Main-207-,,0,0,0,,O Kudretli Savaş Mızrağı her zamanki gibi harika.Dialogue: 50,0:05:09.83,0:05:14.09,Main-207-,,0,0,0,,Evet. Mızrağı ne kadar sert vurursan,Dialogue: 50,0:05:14.09,0:05:16.34,Main-207-,,0,0,0,,o kadar büyük bir patlama oluyor.Dialogue: 50,0:05:16.34,0:05:19.67,Main-207-,,0,0,0,,Don'dan başka birinin zapt edebileceği bir silah değil!Dialogue: 50,0:05:25.89,0:05:28.89,Main-207-,,0,0,0,,Ama bu nasıl bir güç...Dialogue: 50,0:05:28.89,0:05:31.52,Main-207-,,0,0,0,,O ağır mızrağı çok kolay sallıyor.Dialogue: 50,0:05:31.52,0:05:35.52,Main-207-,,0,0,0,,O omuzluklarla en az bir ton ağırlığında olmalı!Dialogue: 50,0:05:35.94,0:05:39.61,Main-207-,,0,0,0,,Don'un en güçlü olmasının sebebi bu işte!Dialogue: 50,0:05:46.99,0:05:47.95,Main-207-,,0,0,0,,Al şunu!Dialogue: 50,0:05:51.96,0:05:53.25,Main-207-,,0,0,0,,Geber!Dialogue: 50,0:05:54.21,0:05:55.17,Main-207-,,0,0,0,,Kamarot!Dialogue: 50,0:05:58.63,0:05:59.84,Main-207-,,0,0,0,,Ucuz atlattım.Dialogue: 50,0:06:03.43,0:06:05.05,Main-207-,,0,0,0,,Seni...Dialogue: 50,0:06:05.05,0:06:07.14,Main-207-,,0,0,0,,lanet böcek!Dialogue: 50,0:06:17.61,0:06:18.82,Main-207-,,0,0,0,,Kamarot!Dialogue: 50,0:06:33.08,0:06:34.54,Main-207-,,0,0,0,,Kamarot...Dialogue: 50,0:06:36.21,0:06:37.59,Main-207-,,0,0,0,,Daha bitirmedim.Dialogue: 50,0:06:37.59,0:06:40.05,Main-207-,,0,0,0,,Beni kızdırdın.Dialogue: 50,0:06:40.05,0:06:42.26,Main-207-,,0,0,0,,O kadar kolay ölmene izin vermeyeceğim.Dialogue: 50,0:06:42.59,0:06:43.76,Main-207-,,0,0,0,,Kahretsin!Dialogue: 50,0:06:43.76,0:06:47.26,Main-207-,,0,0,0,,O Krieg pisliği ardı ardına yeni silah çıkarıyor.Dialogue: 50,0:06:47.26,0:06:49.22,Main-207-,,0,0,0,,O kamarotun buna gücü yetmez.Dialogue: 50,0:06:49.22,0:06:52.85,Main-207-,,0,0,0,,Üzerinde ne kadar silah olursa olsun,Dialogue: 50,0:06:52.85,0:06:57.15,Main-207-,,0,0,0,,kör bir kararlığın mızrağına sahip olan birini kimse yenemez.Dialogue: 50,0:07:14.08,0:07:15.16,Main-207-,,0,0,0,,Fazla basit...Dialogue: 50,0:07:25.63,0:07:28.14,Main-207-,,0,0,0,,İşte şimdi ezmeye değersin.Dialogue: 50,0:07:36.48,0:07:39.19,Main-207-,,0,0,0,,Yaşamak ya da ölmek...Dialogue: 50,0:07:39.19,0:07:45.11,Main-207-,,0,0,0,,Korsanlar arasındaki çatışmada, ölüm korkusu seni dağıtır.Dialogue: 50,0:07:45.11,0:07:46.70,Main-207-,,0,0,0,,Neden bahsediyorsun?Dialogue: 50,0:07:46.70,0:07:48.32,Main-207-,,0,0,0,,En azından...Dialogue: 50,0:07:59.17,0:08:00.92,Main-207-,,0,0,0,,En azından...Dialogue: 50,0:08:04.30,0:08:06.38,Main-207-,,0,0,0,,o velet...Dialogue: 50,0:08:07.01,0:08:09.34,Main-207-,,0,0,0,,hiç tereddüt etmiyor!Dialogue: 50,0:08:21.90,0:08:24.82,Main-207-,,0,0,0,,Bu bir hayatta kalma içgüdüsü mü?Dialogue: 50,0:08:27.15,0:08:29.95,Main-207-,,0,0,0,,Yoksa kararlılığı yüzünden mi ölümden korkmuyor?Dialogue: 50,0:08:32.99,0:08:34.58,Main-207-,,0,0,0,,Kararlılık...Dialogue: 50,0:08:45.88,0:08:50.09,Main-207-,,0,0,0,,S-Seni şerefsiz!Dialogue: 50,0:08:55.35,0:08:56.60,Main-207-,,0,0,0,,Evet! Harikasın!Dialogue: 50,0:08:56.60,0:08:58.93,Main-207-,,0,0,0,,Kamarot! Devam et!Dialogue: 50,0:08:57.52,0:08:58.93,Secondary-207-,,0,0,0,,Hakla onu!Dialogue: 50,0:09:01.56,0:09:03.11,Main-207-,,0,0,0,,Sana söyledim...Dialogue: 50,0:09:03.48,0:09:05.86,Main-207-,,0,0,0,,burası senin öleceğin yer!Dialogue: 50,0:09:09.70,0:09:13.78,Main-207-,,0,0,0,,Ben rakipsizim!Dialogue: 50,0:09:19.75,0:09:23.58,Main-207-,,0,0,0,,Krieg'in topladığı filo, yüzlerce silahı ve zehri...Dialogue: 50,0:09:23.58,0:09:26.21,Main-207-,,0,0,0,,Eğer bunların hepsi güçse...Dialogue: 50,0:09:30.34,0:09:32.89,Main-207-,,0,0,0,,o veledin mızrağı da...Dialogue: 50,0:09:32.89,0:09:35.35,Main-207-,,0,0,0,,güç demektir.Dialogue: 50,0:09:36.76,0:09:39.68,Main-207-,,0,0,0,,Yüreğinde taşıdığı mızrak.Dialogue: 50,0:09:40.85,0:09:47.57,Main-207-,,0,0,0,,O mızrağı boş yere tutan bir aptal tanıyorum.Dialogue: 50,0:09:57.62,0:09:59.33,Main-207-,,0,0,0,,K-Kudretli Savaş Mızrağım...Dialogue: 50,0:09:59.83,0:10:01.66,Main-207-,,0,0,0,,Ne yaptın sen?!Dialogue: 50,0:10:09.17,0:10:11.63,Main-207-,,0,0,0,,Beş kez yumrukladım.Dialogue: 50,0:10:12.42,0:10:15.26,Main-207-,,0,0,0,,Sanırım mızrağın bu kadar.Dialogue: 50,0:10:18.72,0:10:20.35,Main-207-,,0,0,0,,Hazırlan...Dialogue: 50,0:10:24.06,0:10:26.48,Main-207-,,0,0,0,,Şimdi seni tekmeleyecek kadar alanım var!Dialogue: 50,0:10:27.98,0:10:28.94,Main-207-,,0,0,0,,Ne?Dialogue: 50,0:10:28.94,0:10:33.40,Main-207-,,0,0,0,,Keskin ucu kırıldı, sadece çubuklu bomba kaldı elinde.Dialogue: 50,0:10:33.40,0:10:35.03,Main-207-,,0,0,0,,Gücü yarı yarıya indi.Dialogue: 50,0:10:35.03,0:10:36.57,Main-207-,,0,0,0,,Öyle mi?Dialogue: 50,0:10:36.57,0:10:37.53,Main-207-,,0,0,0,,Evet, öyle.Dialogue: 50,0:10:38.91,0:10:40.12,Main-207-,,0,0,0,,Çubuklu bomba, ha?Dialogue: 50,0:10:40.12,0:10:41.75,Main-207-,,0,0,0,,Gayet yeterli.Dialogue: 50,0:10:41.75,0:10:46.13,Main-207-,,0,0,0,,Haline bakılırsa, seni uçurmak için yeter de artar bile.Dialogue: 50,0:10:46.79,0:10:51.71,Main-207-,,0,0,0,,Vücudun bu haldeyken, söylediklerin hep blöf gibi geliyor.Dialogue: 50,0:10:52.09,0:10:53.42,Main-207-,,0,0,0,,Blöf yapmıyorum.Dialogue: 50,0:10:55.51,0:10:57.55,Main-207-,,0,0,0,,O çocuk bayağı iyi.Dialogue: 50,0:10:57.55,0:10:59.43,Main-207-,,0,0,0,,Gerçekten de başarabilir!Dialogue: 50,0:11:00.26,0:11:02.06,Main-207-,,0,0,0,,Bu kötü...Dialogue: 50,0:11:02.06,0:11:04.39,Main-207-,,0,0,0,,Kudretli Savaş Mızrağı'nı nasıl kırdı?Dialogue: 50,0:11:09.90,0:11:13.28,Main-207-,,0,0,0,,Ama çok fazla patlamaya maruz kaldı...Dialogue: 50,0:11:13.28,0:11:14.86,Main-207-,,0,0,0,,Vücudu artık dayanamaz.Dialogue: 50,0:11:17.11,0:11:18.62,Main-207-,,0,0,0,,Pes et artık!Dialogue: 50,0:11:18.62,0:11:21.83,Main-207-,,0,0,0,,Bana kafa tuttuğun an,Dialogue: 50,0:11:22.95,0:11:25.25,Main-207-,,0,0,0,,ölüm fermanını imzaladın!Dialogue: 50,0:11:25.25,0:11:26.12,Main-207-,,0,0,0,,Ölmeyeceğim!Dialogue: 50,0:11:31.25,0:11:32.88,Main-207-,,0,0,0,,Hey! Buradayım!Dialogue: 50,0:11:32.88,0:11:34.01,Main-207-,,0,0,0,,Maymun!Dialogue: 50,0:11:42.01,0:11:43.43,Main-207-,,0,0,0,,Oradan oraya zıplıyor!Dialogue: 50,0:11:48.81,0:11:49.98,Main-207-,,0,0,0,,Faydasız!Dialogue: 50,0:11:53.82,0:11:56.03,Main-207-,,0,0,0,,Üstünde daha kaç tane silah var?Dialogue: 50,0:12:06.04,0:12:07.87,Main-207-,,0,0,0,,Lastik-Lastik...Dialogue: 50,0:12:08.25,0:12:10.00,Main-207-,,0,0,0,,Mitralyöz!Dialogue: 50,0:12:22.64,0:12:23.68,Main-207-,,0,0,0,,Güçsüz!Dialogue: 50,0:12:24.39,0:12:28.89,Main-207-,,0,0,0,,Yumrukların bu wootz çelik zırha karşı etkisiz!Dialogue: 50,0:12:28.89,0:12:31.81,Main-207-,,0,0,0,,Üstünde bir çizik bile bırakamadın.Dialogue: 50,0:12:34.73,0:12:36.65,Main-207-,,0,0,0,,Lastik-Lastik Tabanca!Dialogue: 50,0:12:46.54,0:12:48.04,Main-207-,,0,0,0,,Don!Dialogue: 50,0:12:49.75,0:12:51.58,Main-207-,,0,0,0,,Bu ne küstahlık?!Dialogue: 50,0:12:57.51,0:13:01.01,Main-207-,,0,0,0,,Faydasız! Faydasız! Tamamen faydasız!Dialogue: 50,0:13:01.01,0:13:06.60,Main-207-,,0,0,0,,Yüzlerce maymun yumruğu bile bu zırhı kıramaz!Dialogue: 50,0:13:08.06,0:13:10.94,Main-207-,,0,0,0,,Sanırım oldukça yaklaştım.Dialogue: 50,0:13:13.86,0:13:15.07,Main-207-,,0,0,0,,Gitmiş...Dialogue: 50,0:13:15.07,0:13:16.57,Main-207-,,0,0,0,,Buradayım!Dialogue: 50,0:13:21.61,0:13:22.61,Main-207-,,0,0,0,,Dinle.Dialogue: 50,0:13:22.61,0:13:27.83,Main-207-,,0,0,0,,Nihai kuvvet, en güçlü ekipman ve en yüksek güç demektir!Dialogue: 50,0:13:28.83,0:13:31.83,Main-207-,,0,0,0,,Güçlü olan hayatta kalır.Dialogue: 50,0:13:31.83,0:13:33.79,Main-207-,,0,0,0,,Güçlü olan!Dialogue: 50,0:13:37.05,0:13:38.63,Main-207-,,0,0,0,,Benden bahsediyorsun! Dialogue: 50,0:13:38.63,0:13:43.76,Main-207-,,0,0,0,,Lastik-Lastik...Dialogue: 50,0:13:41.34,0:13:43.76,Secondary-207-,,0,0,0,,Faydasız! Faydasız! Faydasız!Dialogue: 50,0:13:43.76,0:13:47.39,Main-207-,,0,0,0,,İnadın bile seni anca bir yere kadar götürebilir!Dialogue: 50,0:13:51.10,0:13:53.73,Main-207-,,0,0,0,,Bazuka!Dialogue: 50,0:14:03.28,0:14:04.57,Main-207-,,0,0,0,,Hiç iyi değil!Dialogue: 50,0:14:04.57,0:14:07.20,Main-207-,,0,0,0,,Yapabileceğin tek şey bu!Dialogue: 50,0:14:10.58,0:14:13.83,Main-207-,,0,0,0,,Ne?! Yenilmez zırhım çatlıyor mu?!Dialogue: 50,0:14:16.79,0:14:18.17,Main-207-,,0,0,0,,Ama çok geç.Dialogue: 50,0:14:18.92,0:14:22.72,Main-207-,,0,0,0,,İşin bitti, çapa velet!Dialogue: 50,0:14:26.43,0:14:28.39,Main-207-,,0,0,0,,Bu bir tuzak! Kaç!Dialogue: 50,0:14:38.07,0:14:39.73,Main-207-,,0,0,0,,Kamarot!Dialogue: 50,0:14:56.92,0:14:59.63,Flashbacks-207-,,0,0,0,,Bu bir hayatta kalma içgüdüsü mü?Dialogue: 50,0:15:00.00,0:15:02.71,Flashbacks-207-,,0,0,0,,Yoksa kararlılığı yüzünden mi ölümden korkmuyor?Dialogue: 50,0:15:06.55,0:15:08.55,Main-207-,,0,0,0,,Lastik-Lastik...Dialogue: 50,0:15:08.55,0:15:10.06,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:15:12.93,0:15:15.98,Main-207-,,0,0,0,,Bazuka!Dialogue: 50,0:15:41.88,0:15:43.01,Main-207-,,0,0,0,,İşte böyle!Dialogue: 50,0:15:42.17,0:15:43.01,Secondary-207-,,0,0,0,,Aferin!Dialogue: 50,0:15:43.01,0:15:44.80,Main-207-,,0,0,0,,Sen en iyisisin, Kamarot!Dialogue: 50,0:15:47.13,0:15:49.26,Main-207-,,0,0,0,,Kazandım!Dialogue: 50,0:15:53.22,0:15:55.10,Main-207-,,0,0,0,,Kendini çok kaptırma, velet!Dialogue: 50,0:15:55.68,0:15:56.56,Main-207-,,0,0,0,,Yaşıyor!Dialogue: 50,0:15:59.56,0:16:00.19,Main-207-,,0,0,0,,Olamaz!Dialogue: 50,0:16:05.11,0:16:08.28,Main-207-,,0,0,0,,Bakalım bu çelik ağdan kaçabilecek misin?Dialogue: 50,0:16:19.12,0:16:20.63,Main-207-,,0,0,0,,Altımız okyanus!Dialogue: 50,0:16:20.63,0:16:23.13,Main-207-,,0,0,0,,Artık bitti, çapa velet!Dialogue: 50,0:16:23.13,0:16:26.67,Main-207-,,0,0,0,,Son gülen ben oldum!Dialogue: 50,0:16:30.80,0:16:32.76,Main-207-,,0,0,0,,Evet! İşte bizim Don!Dialogue: 50,0:16:32.76,0:16:35.27,Main-207-,,0,0,0,,Düşür onu!Dialogue: 50,0:16:33.68,0:16:35.27,Secondary-207-,,0,0,0,,Bitir işini!Dialogue: 50,0:16:39.44,0:16:41.90,Main-207-,,0,0,0,,Kollarım ve bacaklarım özgürse, zafer benimdir!Dialogue: 50,0:16:42.61,0:16:44.61,Thoughts-207-,,0,0,0,,Neden tökezlemiyor?Dialogue: 50,0:16:46.40,0:16:47.99,Thoughts-207-,,0,0,0,,Niye o kadar ileri gidiyor?Dialogue: 50,0:16:47.99,0:16:49.15,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:16:49.57,0:16:51.53,Main-207-,,0,0,0,,Bununla beraber...Dialogue: 50,0:16:51.53,0:16:53.49,Main-207-,,0,0,0,,bitecek!Dialogue: 50,0:16:58.50,0:17:01.54,Main-207-,,0,0,0,,Lastik-Lastik...Dialogue: 50,0:17:12.14,0:17:13.51,Main-207-,,0,0,0,,Dev Çekiç!Dialogue: 50,0:17:36.12,0:17:37.54,Main-207-,,0,0,0,,Don Krieg...Dialogue: 50,0:17:37.54,0:17:41.16,Main-207-,,0,0,0,,Don... Don yenildi! Nasıl?!Dialogue: 50,0:17:41.16,0:17:41.83,Main-207-,,0,0,0,,Kahretsin!Dialogue: 50,0:17:41.83,0:17:43.38,Main-207-,,0,0,0,,İşte böyle, Kamarot!Dialogue: 50,0:17:43.38,0:17:45.79,Main-207-,,0,0,0,,Helal olsun!Dialogue: 50,0:17:42.54,0:17:45.79,Secondary-207-,,0,0,0,,Lanet olsun! Nasıl? Don nasıl...Dialogue: 50,0:17:47.55,0:17:48.92,Main-207-,,0,0,0,,Cidden başardı!Dialogue: 50,0:17:48.92,0:17:50.59,Main-207-,,0,0,0,,H-Harika!Dialogue: 50,0:17:50.59,0:17:51.97,Main-207-,,0,0,0,,Gerçek mi bu?Dialogue: 50,0:17:51.97,0:17:54.18,Main-207-,,0,0,0,,Don Krieg'den bahsediyoruz burada!Dialogue: 50,0:17:54.18,0:17:55.55,Main-207-,,0,0,0,,Çok güçlü!Dialogue: 50,0:17:55.55,0:17:57.76,Main-207-,,0,0,0,,O çok güçlü!Dialogue: 50,0:17:58.89,0:18:01.02,Main-207-,,0,0,0,,B-Bütün bu yaygara da ne?Dialogue: 50,0:18:01.02,0:18:03.27,Main-207-,,0,0,0,,Ah! Kendine geldin demek!Dialogue: 50,0:18:03.27,0:18:04.65,Main-207-,,0,0,0,,O kaybetti!Dialogue: 50,0:18:04.65,0:18:06.02,Main-207-,,0,0,0,,Senin Don kaybetti!Dialogue: 50,0:18:06.48,0:18:07.48,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:18:23.29,0:18:26.96,Main-207-,,0,0,0,,Hayal kurmayı bırak ve o çocuğu kurtar!Dialogue: 50,0:18:27.34,0:18:28.42,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:18:28.42,0:18:30.26,Main-207-,,0,0,0,,Yukarı çıkamaz!Dialogue: 50,0:18:30.26,0:18:30.96,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:18:31.55,0:18:34.64,Main-207-,,0,0,0,,Şeytan meyvesi sahipleri deniz tarafından lanetlenir.Dialogue: 50,0:18:34.64,0:18:36.43,Main-207-,,0,0,0,,Çapa gibi batarlar.Dialogue: 50,0:18:36.43,0:18:38.60,Main-207-,,0,0,0,,Ne diyorsun sen, moruk?!Dialogue: 50,0:18:39.35,0:18:41.06,Main-207-,,0,0,0,,Önceden söylemeliydin!Dialogue: 50,0:18:41.73,0:18:43.89,Main-207-,,0,0,0,,Çok geçse ne yapacaksın?!Dialogue: 50,0:19:14.55,0:19:16.18,Main-207-,,0,0,0,,Hey! Sık dişini!Dialogue: 50,0:19:16.80,0:19:19.18,Thoughts-207-,,0,0,0,,Ölmeyeceğini söylemiştin, değil mi?Dialogue: 50,0:19:20.06,0:19:22.14,Thoughts-207-,,0,0,0,,Bu senin kararlığın, değil mi?!Dialogue: 50,0:19:22.77,0:19:24.10,Thoughts-207-,,0,0,0,,Değil mi?!Dialogue: 50,0:19:27.44,0:19:29.02,Flashbacks-207-,,0,0,0,,Ölmeyeceğim!Dialogue: 50,0:19:32.90,0:19:35.95,Flashbacks-207-,,0,0,0,,Burada ölmeyeceğim.Dialogue: 50,0:19:37.45,0:19:39.03,Thoughts-207-,,0,0,0,,Cidden...Dialogue: 50,0:19:42.87,0:19:45.87,Flashbacks-207-,,0,0,0,,Zoro!Dialogue: 50,0:19:49.38,0:19:52.38,FlashbackThoughts-207-,,0,0,0,,Ölmek yerine hırsından vazgeçmesi lazımdı!Dialogue: 50,0:19:52.96,0:19:54.38,Flashbacks-207-,,0,0,0,,Çok basit lan!Dialogue: 50,0:19:54.38,0:19:56.47,Flashbacks-207-,,0,0,0,,Sadece hırsından vazgeç!Dialogue: 50,0:20:06.23,0:20:08.15,Thoughts-207-,,0,0,0,,Her biri...Dialogue: 50,0:20:20.24,0:20:23.45,Flashbacks-207-,,0,0,0,,Neden bilmiyorum, ama...Dialogue: 50,0:20:25.33,0:20:27.83,Flashbacks-207-,,0,0,0,,eğer bir adım bile geri çekilirsem,Dialogue: 50,0:20:27.83,0:20:34.09,Flashbacks-207-,,0,0,0,,geçmişteki sözler ve yeminler gibi önemli birçok şey parçalanacak,Dialogue: 50,0:20:34.09,0:20:37.47,Flashbacks-207-,,0,0,0,,ve şu anda bulunduğum konuma geri gelemeyeceğim.Dialogue: 50,0:20:38.30,0:20:42.76,Flashbacks-207-,,0,0,0,,Kör bir kararlığın mızrağına sahip olan birini kimse yenemez.Dialogue: 50,0:20:44.26,0:20:50.73,Flashbacks-207-,,0,0,0,,O mızrağı boş yere tutan bir aptal tanıyorum.Dialogue: 50,0:21:01.78,0:21:03.24,Main-207-,,0,0,0,,Hey, Kamarot!Dialogue: 50,0:21:03.24,0:21:05.24,Main-207-,,0,0,0,,Sakın öleyim deme!Dialogue: 50,0:21:05.70,0:21:07.95,Main-207-,,0,0,0,,Don! Ne oldu?!Dialogue: 50,0:21:07.95,0:21:11.12,Main-207-,,0,0,0,,Don neden...?Dialogue: 50,0:21:10.25,0:21:11.12,Secondary-207-,,0,0,0,,Don!Dialogue: 50,0:21:11.12,0:21:13.50,Main-207-,,0,0,0,,Don Krieg yenildi...Dialogue: 50,0:21:13.50,0:21:15.75,Main-207-,,0,0,0,,Bu doğru olamaz...Dialogue: 50,0:21:15.75,0:21:18.34,Main-207-,,0,0,0,,Doğu Mavi'nin hakimi o...Dialogue: 50,0:21:18.34,0:21:20.34,Main-207-,,0,0,0,,Öyle desen bile...Dialogue: 50,0:21:20.34,0:21:22.47,Main-207-,,0,0,0,,Sonuç ortada!Dialogue: 50,0:21:22.47,0:21:26.56,Main-207-,,0,0,0,,O övündüğü zırhı paramparça oldu ve yenildi.Dialogue: 50,0:21:27.39,0:21:29.98,Main-207-,,0,0,0,,Bayağı iyi dövüldü. Bakmayacak mısın?Dialogue: 50,0:21:31.73,0:21:35.23,Main-207-,,0,0,0,,O benim hayranlık duyduğum tek adam.Dialogue: 50,0:21:35.23,0:21:37.69,Main-207-,,0,0,0,,Onun en güçlü olduğuna inanmıştım!Dialogue: 50,0:21:44.87,0:21:46.62,Main-207-,,0,0,0,,Hey bekle, uşak!Dialogue: 50,0:21:46.62,0:21:48.70,Main-207-,,0,0,0,,Hareket edersen, zehir vücuduna yayılır!Dialogue: 50,0:21:48.70,0:21:50.16,Main-207-,,0,0,0,,Kımıldama!Dialogue: 50,0:21:50.16,0:21:52.54,Main-207-,,0,0,0,,Hey! Öleceksin!Dialogue: 50,0:21:49.45,0:21:51.16,Secondary-207-,,0,0,0,,Senin iyiliğin için söylüyorum!Dialogue: 50,0:21:52.54,0:21:53.92,Main-207-,,0,0,0,,Kamarot!Dialogue: 50,0:21:53.92,0:21:55.46,Main-207-,,0,0,0,,Ölme sakın!Dialogue: 50,0:21:55.46,0:21:57.00,Main-207-,,0,0,0,,Duydun mu beni?!Dialogue: 50,0:21:57.00,0:21:59.97,Main-207-,,0,0,0,,Hala yapman gereken şeyler var, değil mi?!Dialogue: 50,0:22:00.47,0:22:01.72,Main-207-,,0,0,0,,Kamarot! Sakın ölme!Dialogue: 50,0:22:10.39,0:22:11.64,Main-207-,,0,0,0,,Sen var ya...Dialogue: 50,0:22:13.90,0:22:15.31,Main-207-,,0,0,0,,Cidden başka bir şeysin.Dialogue: 50,0:22:15.31,0:22:17.90,Main-207-,,0,0,0,,Ben en güçlüyüm!Dialogue: 50,0:22:17.90,0:22:20.57,Main-207-,,0,0,0,,Ben... Ben kazanacağım!Dialogue: 50,0:22:20.57,0:22:24.41,Main-207-,,0,0,0,,Benim kuvvetimi kimse geçemez!Dialogue: 50,0:22:25.20,0:22:26.49,Main-207-,,0,0,0,,Don! Lütfen dur!Dialogue: 50,0:22:26.49,0:22:29.04,Main-207-,,0,0,0,,Zapt edin onu! Bilinci yerinde bile değil!Dialogue: 50,0:22:30.12,0:22:31.33,Main-207-,,0,0,0,,Kazanacağım!Dialogue: 50,0:22:31.33,0:22:33.25,Main-207-,,0,0,0,,Lütfen dur, Don!Dialogue: 50,0:22:34.04,0:22:36.71,Main-207-,,0,0,0,,Kendi gücümle kazanacağım!Dialogue: 50,0:22:44.80,0:22:47.30,Main-207-,,0,0,0,,Ben...Dialogue: 50,0:22:47.30,0:22:49.51,Main-207-,,0,0,0,,kazanmak...Dialogue: 50,0:22:49.51,0:22:51.22,Main-207-,,0,0,0,,zorundayım!Dialogue: 50,0:22:53.35,0:22:55.81,Main-207-,,0,0,0,,Kimse beni yenemez!Dialogue: 50,0:23:02.07,0:23:03.57,Main-207-,,0,0,0,,Don Krieg...Dialogue: 50,0:23:03.57,0:23:05.78,Main-207-,,0,0,0,,Kaybettik.Dialogue: 50,0:23:06.20,0:23:08.49,Main-207-,,0,0,0,,– Komutan! – Komutan!Dialogue: 50,0:23:08.49,0:23:12.00,Main-207-,,0,0,0,,Onurla geri çekilip, sıfırdan başlayalım.Dialogue: 50,0:23:14.79,0:23:17.58,Main-207-,,0,0,0,,Her şey için teşekkürler, Sanji-san.Dialogue: 50,0:23:17.58,0:23:18.75,Main-207-,,0,0,0,,Lafı olmaz.Dialogue: 50,0:23:18.75,0:23:20.46,Main-207-,,0,0,0,,Bir daha geri gelme!Dialogue: 50,0:23:21.63,0:23:23.05,Main-207-,,0,0,0,,Sanji-san,Dialogue: 50,0:23:23.05,0:23:27.09,Main-207-,,0,0,0,,o uyandığında, lütfen ona şunu iletin...Dialogue: 50,0:23:30.85,0:23:34.60,Main-207-,,0,0,0,,"Grand Line'da tekrar görüşelim."Dialogue: 50,0:23:35.69,0:23:36.65,Main-207-,,0,0,0,,Sen...Dialogue: 50,0:23:37.48,0:23:39.90,Main-207-,,0,0,0,,İyice düşündüm deDialogue: 50,0:23:39.90,0:23:43.11,Main-207-,,0,0,0,,yapmak istediğim tek şey bu.Dialogue: 50,0:23:43.69,0:23:48.62,Main-207-,,0,0,0,,Farkına varmadan Don Krieg’in hırsı benim de hırsım oldu.Dialogue: 50,0:23:54.16,0:23:55.62,Main-207-,,0,0,0,,Belki de...Dialogue: 50,0:23:56.16,0:23:58.88,Main-207-,,0,0,0,,sadece birkaç saat yaşayabileceğim.Dialogue: 50,0:23:59.58,0:24:03.67,Main-207-,,0,0,0,,Çok zamanım kalmadığından karar vermem biraz aptalca oldu amaDialogue: 50,0:24:03.67,0:24:06.26,Main-207-,,0,0,0,,bu sefer işleri kendi istediğim gibi...Dialogue: 50,0:24:06.26,0:24:07.38,Main-207-,,0,0,0,,yapmak istiyorum.Dialogue: 50,0:24:08.01,0:24:11.18,Main-207-,,0,0,0,,Öyleyse, kaçacak yerim yok demektir, değil mi?Dialogue: 50,0:24:17.89,0:24:20.19,Main-207-,,0,0,0,,Don'a olan sadakat da neymiş!Dialogue: 50,0:24:20.73,0:24:25.94,Main-207-,,0,0,0,,Don Krieg'in adını kalkan olarak kullanıp kaçıyordum.Dialogue: 50,0:24:27.20,0:24:32.83,Main-207-,,0,0,0,,Kararını verdikten sonra, düşmandan korkmak ya da kendini korumak gibi...Dialogue: 50,0:24:32.83,0:24:35.58,Main-207-,,0,0,0,,boş şeyleri düşünmene gerek kalmaz.Dialogue: 50,0:24:35.58,0:24:37.91,Main-207-,,0,0,0,,Bunları bana o öğretti.Dialogue: 50,0:24:43.09,0:24:44.30,Main-207-,,0,0,0,,Patty! Carne!Dialogue: 50,0:24:44.84,0:24:46.80,Main-207-,,0,0,0,,Market alışveriş teknemizi ona verin!Dialogue: 50,0:24:46.80,0:24:49.22,Main-207-,,0,0,0,,Ne?! Aptal mısın sen?!Dialogue: 50,0:24:49.22,0:24:52.47,Main-207-,,0,0,0,,Teknemizi neden korsanlara vermek zorundayız ki?!Dialogue: 50,0:24:52.47,0:24:55.85,Main-207-,,0,0,0,,Market alışverişi için ne kullanacağız?! Seni salak!Dialogue: 50,0:24:55.85,0:24:56.98,Main-207-,,0,0,0,,O haklı!Dialogue: 50,0:24:56.98,0:24:59.02,Main-207-,,0,0,0,,Bırak da yüzsünler!Dialogue: 50,0:24:59.02,0:25:01.94,Main-207-,,0,0,0,,Susun ve getirin artık şunu!Dialogue: 50,0:25:05.57,0:25:07.19,Main-207-,,0,0,0,,Tamam be...Dialogue: 50,0:25:07.19,0:25:08.95,Main-207-,,0,0,0,,Bize bağırma...Dialogue: 50,0:25:09.32,0:25:12.53,Main-207-,,0,0,0,,– Tamam, tamam, getiriyoruz! – Tamam, tamam, getiriyoruz!Dialogue: 50,0:25:20.29,0:25:22.21,Main-207-,,0,0,0,,Batacak!Dialogue: 50,0:25:35.72,0:25:39.10,Main-207-,,0,0,0,,Neden tereddüt ettim? Neden bu kadar endişeliydim?Dialogue: 50,0:25:39.10,0:25:42.10,Main-207-,,0,0,0,,Şimdi düşününce, aptal gibi hissediyorum.Dialogue: 50,0:25:57.66,0:25:58.75,Main-207-,,0,0,0,,Peki o zaman!Dialogue: 50,0:25:59.12,0:26:00.91,Main-207-,,0,0,0,,Tekne için minnettarız.Dialogue: 50,0:26:01.41,0:26:03.75,Main-207-,,0,0,0,,Geri getirmek zorunda değiliz, değil mi?Dialogue: 50,0:26:03.75,0:26:04.58,Main-207-,,0,0,0,,Evet.Dialogue: 50,0:26:05.00,0:26:09.21,Main-207-,,0,0,0,,Geri getirmeye cesaretin varsa, dene de gör, küçük balık.Dialogue: 50,0:26:09.21,0:26:10.76,Main-207-,,0,0,0,,Aynen öyle!Dialogue: 50,0:26:10.76,0:26:12.72,Main-207-,,0,0,0,,Şunu kafanıza sokun:Dialogue: 50,0:26:12.72,0:26:16.51,Main-207-,,0,0,0,,Bu yer, yüzen restoran, savaş gemisi Baratie!Dialogue: 50,0:26:16.51,0:26:17.47,Main-207-,,0,0,0,,– Evet! – Evet!Dialogue: 50,0:26:18.72,0:26:21.43,Main-207-,,0,0,0,,Ne korkutucu bir restoran.Dialogue: 0,0:01:50.05,0:01:55.35,Title-207-,,0,0,0,,Kudretli Savaş MızrağıDialogue: 1,0:01:50.05,0:01:55.35,Title-207-,,0,0,0,,Kudretli Savaş MızrağıDialogue: 0,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 1,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 0,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Galaxy 9000 MeggoDialogue: 1,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Galaxy 9000 MeggoDialogue: 0,0:00:04.28,0:00:06.78,Cr