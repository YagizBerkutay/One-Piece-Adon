Dialogue: 0,0:01:42.70,0:01:44.68,Title,,0,0,240,,{\fad(300,300)}Cora-san
Dialogue: 0,0:01:49.54,0:01:54.05,Captions,,0,0,0,,{\fad(526,0)\pos(640,488)}Corazon ve Donquixote Ailesi Buluşma Yeri\NSwallow Adası
Dialogue: 0,0:01:54.74,0:01:58.60,Main,,0,0,0,,Dikkati elden bırakmayın.\NDüşmanımız Doflamingo!
Dialogue: 0,0:01:58.94,0:02:00.67,Main,,0,0,0,,Sengoku ahmağı...
Dialogue: 0,0:02:00.91,0:02:06.13,Captions,,0,0,0,,{\fad(526,0)\pos(640,485)}Donanma Karargahı\NKoramiral Tsuru
Dialogue: 0,0:02:02.98,0:02:06.14,Main,,0,0,3,,{\an8}...bu haberi kimden aldı da\Nbizi buraya sürdü?!
Dialogue: 0,0:02:06.54,0:02:08.01,Main,,0,0,0,,Koramiral Tsuru!
Dialogue: 0,0:02:09.08,0:02:11.51,Main,,0,0,0,,Minion Adası'ndaki gözcü gemisinden\Nhaber aldık!
Dialogue: 0,0:02:14.25,0:02:20.01,Captions,,0,0,0,,{\fad(526,0)\pos(640,482)}Diez Barrels'ın Saklandığı Yer\NMinion Adası
Dialogue: 0,0:02:17.84,0:02:20.28,Main,,0,0,3,,{\an8\i1}Barrels'in saklanma yeri\Nalev mi aldı?{\i0}
Dialogue: 0,0:02:20.28,0:02:23.04,Main,,0,0,0,,Evet! Ne olup bittiğini\Nöğrenmeye gidiyoruz!
Dialogue: 0,0:02:23.04,0:02:24.06,Main,,0,0,0,,{\i1}Aptal herif!{\i0}
Dialogue: 0,0:02:25.22,0:02:28.23,Main,,0,0,0,,{\i1}Sizin orada olduğunuzu öğrenirlerse\Nanlaşma falan yatar!{\i0}
Dialogue: 0,0:02:28.90,0:02:33.23,Main,,0,0,0,,{\i1}Kıyı şeridini kontrol edip\Nşüpheli birilerini görürseniz haber verin!{\i0}
Dialogue: 0,0:02:33.23,0:02:34.00,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:02:40.58,0:02:44.49,Captions,,0,0,0,,{\fad(504,0)\pos(640,480)}Hayalet Kasaba\NKorsanların Saklanma Yeri
Dialogue: 0,0:02:41.70,0:02:43.86,Main,,0,0,3,,Çabuk söndürün!
Dialogue: 0,0:02:46.84,0:02:48.02,Main,,0,0,0,,Kaptan Barrels!
Dialogue: 0,0:02:49.34,0:02:50.41,Main,,0,0,0,,Dayanın!
Dialogue: 0,0:02:51.84,0:02:52.96,Main,,0,0,0,,Bırak beni!
Dialogue: 0,0:02:54.02,0:02:56.49,Main,,0,0,0,,Beni boşverin şimdi!
Dialogue: 0,0:02:57.20,0:03:00.36,Main,,0,0,0,,Beş milyar belilik anlaşma\Nuçup gitmek üzere!
Dialogue: 0,0:03:00.90,0:03:04.00,Main,,0,0,0,,Ope Ope Meyvesi'ni geri getirin!
Dialogue: 0,0:03:09.08,0:03:10.04,Main,,0,0,0,,Cora-san...
Dialogue: 0,0:03:12.04,0:03:14.86,Main,,0,0,0,,İyisin.\NÇok sevindim.
Dialogue: 0,0:03:15.40,0:03:16.44,Main,,0,0,0,,{\fad(150,150)}Sessizlik.
Dialogue: 0,0:03:20.02,0:03:20.85,Main,,0,0,0,,Bak!
Dialogue: 0,0:03:21.52,0:03:23.11,Main,,0,0,0,,Ope Ope Meyvesi'ni aldım!
Dialogue: 0,0:03:25.74,0:03:29.70,Main,,0,0,0,,Bina alev alıp da\Nsilah sesleri falan duyunca...
Dialogue: 0,0:03:29.70,0:03:32.60,Main,,0,0,0,,...sana bir şey oldu sandım.
Dialogue: 0,0:03:32.60,0:03:35.66,Main,,0,0,0,,Bana ne olduğunu\Nkim takar şimdi?!
Dialogue: 0,0:03:36.08,0:03:38.25,Main,,0,0,0,,Sevin be!
Dialogue: 0,0:03:38.25,0:03:41.16,Main,,0,0,0,,Hayatını kurtaracak şeytan meyvesi bu!
Dialogue: 0,0:03:42.16,0:03:45.14,Main,,0,0,0,,Ama onu yesem bile...
Dialogue: 0,0:03:45.80,0:03:47.41,Main,,0,0,0,,...hastalığımın kesin olarak\Ngeçeceğini bilmiyoruz.
Dialogue: 0,0:03:49.40,0:03:52.29,Main,,0,0,0,,Ne diyorsun sen be?!\Nİyileşeceksin elbet!
Dialogue: 0,0:03:52.29,0:03:54.98,Main,,0,0,0,,Ye hadi! Çabuk ol!
Dialogue: 0,0:03:53.66,0:03:54.86,Secondary,,0,0,0,,Ne yapıyo'sun!?
Dialogue: 0,0:03:56.80,0:03:57.68,Main,,0,0,0,,İğrençmiş!
Dialogue: 0,0:03:58.48,0:04:01.02,Main,,0,0,0,,Acele et! Çiğne hadi!
Dialogue: 0,0:04:01.56,0:04:03.09,Main,,0,0,0,,Yut gitsin!
Dialogue: 0,0:04:17.44,0:04:24.80,Main,,0,0,0,,Cora-san, ben henüz\Ngüç kullanıcısı olmak için hazır değildim!
Dialogue: 0,0:04:28.44,0:04:29.44,Main,,0,0,0,,Cora-san?
Dialogue: 0,0:04:29.94,0:04:31.40,Main,,0,0,0,,H-Hey!
Dialogue: 0,0:04:31.40,0:04:32.58,Main,,0,0,0,,Böylesi âlâ...
Dialogue: 0,0:04:33.94,0:04:37.70,Main,,0,0,0,,Kendini iyileştirebilirsin artık.
Dialogue: 0,0:04:38.08,0:04:42.76,Main,,0,0,0,,Doflamingo'dan daha akıllı davrandık...\NKazandık.
Dialogue: 0,0:04:43.52,0:04:45.71,Main,,0,0,0,,Neyin var, Cora-san?
Dialogue: 0,0:04:45.71,0:04:47.12,Main,,0,0,0,,Yorgun mu düştün?
Dialogue: 0,0:04:49.00,0:04:50.31,Main,,0,0,0,,Yoksa bu...
Dialogue: 0,0:04:58.90,0:05:00.12,Main,,0,0,0,,Kan revan içindesin!
Dialogue: 0,0:05:01.20,0:05:03.05,Main,,0,0,0,,Cora-san, vuruldun mu?
Dialogue: 0,0:05:04.80,0:05:07.20,Main,,0,0,0,,Evet, biraz sakarlık ettim...
Dialogue: 0,0:05:07.20,0:05:09.97,Main,,0,0,0,,Lanet olsun!\NHiç mi aklın yok senin, Cora-san?!
Dialogue: 0,0:05:09.97,0:05:10.84,Main,,0,0,0,,Sahi ya!
Dialogue: 0,0:05:11.80,0:05:13.66,Main,,0,0,0,,İyileş! İyileş!
Dialogue: 0,0:05:15.90,0:05:17.27,Main,,0,0,0,,İyileş!
Dialogue: 0,0:05:19.48,0:05:22.43,Main,,0,0,0,,Kanaman dursun!\NDursun!
Dialogue: 0,0:05:23.07,0:05:25.70,Main,,0,0,0,,Ope Ope'nin gücü iyileştirsin onu!
Dialogue: 0,0:05:24.64,0:05:25.68,Secondary,,0,0,0,,Şapşal şey...
Dialogue: 0,0:05:26.12,0:05:29.71,Main,,0,0,0,,Öyle büyü gibi yetenek olmadığını\Nsöylemiştim sana.
Dialogue: 0,0:05:30.20,0:05:32.48,Main,,0,0,0,,Ne yapmam lazım o zaman?!
Dialogue: 0,0:05:32.48,0:05:35.64,Main,,0,0,0,,Benim yüzümden vuruldun!
Dialogue: 0,0:05:37.16,0:05:39.90,Main,,0,0,0,,Law, bana bir şey olmaz!
Dialogue: 0,0:05:40.90,0:05:42.78,Main,,0,0,0,,Bu kadarcık şey öldürmez beni...
Dialogue: 0,0:05:43.46,0:05:44.44,Main,,0,0,0,,Cora-san!
Dialogue: 0,0:05:45.46,0:05:48.56,Main,,0,0,0,,Ama bir süreliğine\Nkanamayı durdurmam lazım...
Dialogue: 0,0:05:49.54,0:05:50.90,Main,,0,0,0,,Beni iyi dinle, Law.
Dialogue: 0,0:05:51.66,0:05:55.59,Main,,0,0,0,,Ope Ope Meyvesi'ni ele geçirdik,\Norası kesin.
Dialogue: 0,0:05:56.48,0:06:00.92,Main,,0,0,0,,Ama bu Doffy'nin kontrolden\Nçıkmasının önüne geçemeyecek.
Dialogue: 0,0:06:02.44,0:06:05.86,Main,,0,0,0,,Böyle güçsüz bir anında seni kullanacağım için kusura bakma ama senden bir isteğim olacak.
Dialogue: 0,0:06:07.58,0:06:12.48,Main,,0,0,0,,Adanın batı kıyısında gözcülük yapan\Nbir donanma gemisi gördüm.
Dialogue: 0,0:06:13.22,0:06:16.08,Main,,0,0,0,,Bunu onlara vermeni istiyorum...
Dialogue: 0,0:06:16.78,0:06:21.50,Main,,0,0,0,,Silindiri gördüklerinde\Nne için olduğunu bilirler.
Dialogue: 0,0:06:22.00,0:06:25.42,Main,,0,0,0,,Bu küçücük kutu çok uzaklardaki...
Dialogue: 0,0:06:25.42,0:06:28.34,Main,,0,0,0,,...Dressrosa adındaki krallığın kurtuluşu olacak.
Dialogue: 0,0:06:28.34,0:06:29.54,Main,,0,0,0,,Krallık mı?
Dialogue: 0,0:06:30.36,0:06:33.23,Main,,0,0,0,,Donanma'dan nefret ediyorum ama ben...
Dialogue: 0,0:06:33.23,0:06:35.17,Main,,0,0,0,,Doktor oğlu değil misin?
Dialogue: 0,0:06:36.56,0:06:40.24,Main,,0,0,0,,Sen bunu ulaştırır ulaştırmaz\Nhemencecik bu adadan kaçacağız.
Dialogue: 0,0:06:45.18,0:06:48.35,Main,,0,0,0,,Ve birlikte dünyayı gezeceğiz!
Dialogue: 0,0:06:57.88,0:06:58.66,Thoughts,,0,0,0,,{\i1}Donanma askerleri...{\i0}
Dialogue: 0,0:07:04.52,0:07:05.64,Thoughts,,0,0,0,,{\i1}Tek başına!{\i0}
Dialogue: 0,0:07:08.60,0:07:09.87,Main,,0,0,0,,Al bunu!
Dialogue: 0,0:07:11.22,0:07:13.26,Main,,0,0,0,,Gizli mektup ha?
Dialogue: 0,0:07:14.34,0:07:16.14,Main,,0,0,0,,Birileri senden\Ngetirmeni istedi sanırım?
Dialogue: 0,0:07:16.62,0:07:17.72,Main,,0,0,0,,Teşekkür ederim.
Dialogue: 0,0:07:20.62,0:07:23.88,Main,,0,0,0,,Güvenli ellerde, endişelenme.
Dialogue: 0,0:07:24.68,0:07:28.01,Main,,0,0,0,,Yalnız ufaklık,\Nsesin epey güçsüz çıkıyor.
Dialogue: 0,0:07:30.08,0:07:32.08,Main,,0,0,0,,Sana güvenebilir miyim?
Dialogue: 0,0:07:33.74,0:07:37.61,Main,,0,0,0,,Evet, mektuptan bahsediyorsan\Ntüm sorumluluğu ben...
Dialogue: 0,0:07:37.61,0:07:39.72,Main,,0,0,0,,Kurtarmanı istediğim biri var!
Dialogue: 0,0:07:40.96,0:07:43.81,Main,,0,0,0,,Vuruldu ve ölmek üzere!
Dialogue: 0,0:07:44.32,0:07:46.71,Main,,0,0,0,,Yalvarıyorum kurtarın onu!
Dialogue: 0,0:07:48.06,0:07:50.72,Main,,0,0,0,,Ölmesini hiç ama hiç istemiyorum!
Dialogue: 0,0:07:52.58,0:07:56.04,Main,,0,0,0,,Benim yüzümden vuruldu!
Dialogue: 0,0:08:05.18,0:08:06.88,Main,,0,0,0,,Cora-san!
Dialogue: 0,0:08:08.30,0:08:10.17,Main,,0,0,0,,Bu abi seni iyileştirecekmiş!
Dialogue: 0,0:08:14.00,0:08:15.09,Main,,0,0,0,,Cora-san!
Dialogue: 0,0:08:16.66,0:08:17.58,Main,,0,0,0,,Vergo!
Dialogue: 0,0:08:17.58,0:08:20.53,Main,,0,0,0,,Corazon!?\NBurada ne arıyorsun?!
Dialogue: 0,0:08:20.53,0:08:21.91,Main,,0,0,0,,Konuşabiliyor musun sen?!
Dialogue: 0,0:08:22.30,0:08:25.42,Thoughts,,0,0,0,,{\i1}Kahretsin!\NYoksa bunun gizli görevi...{\i0}
Dialogue: 0,0:08:31.18,0:08:32.52,Main,,0,0,0,,Tanışıyor musunuz?
Dialogue: 0,0:08:33.14,0:08:35.09,Main,,0,0,0,,Vergo...
Dialogue: 0,0:08:36.70,0:08:37.70,Flashbacks,,0,0,0,,{\i1}Vergo mu?{\i0}
Dialogue: 0,0:08:38.12,0:08:42.43,Flashbacks,,0,0,0,,{\i1}Çok gizli bir görev için\Naileden ayrılmış güçlü bir adam.{\i0}
Dialogue: 0,0:08:43.34,0:08:46.57,Flashbacks,,0,0,0,,{\i1}Görevin ayrıntıları\Naile üyelerinden bile saklanıyor.{\i0}
Dialogue: 0,0:08:46.57,0:08:49.13,Flashbacks,,0,0,0,,{\i1}Seni zerre ilgilendirmeyen biri.{\i0}
Dialogue: 0,0:08:59.76,0:09:01.08,Main,,0,0,0,,Yapma!\NO...
Dialogue: 0,0:09:04.98,0:09:08.46,Thoughts,,0,0,0,,{\i1}Vergo'nun görevi\NDonanma'ya sızmakmış!{\i0}
Dialogue: 0,0:09:09.04,0:09:10.62,Thoughts,,0,0,0,,{\i1}Şansa bak!{\i0}
Dialogue: 0,0:09:10.98,0:09:15.83,Thoughts,,0,0,0,,{\i1}Binlerce donanma askeri arasında\Nmektup geçe geçe onun eline geçti!{\i0}
Dialogue: 0,0:09:18.42,0:09:20.77,Main,,0,0,0,,Anlaşıldı, Rosinante!
Dialogue: 0,0:09:22.12,0:09:22.67,Main,,0,0,0,,Geri ver onu!
Dialogue: 0,0:09:26.01,0:09:27.08,Main,,0,0,0,,Cora-san!
Dialogue: 0,0:09:28.02,0:09:29.91,Main,,0,0,0,,Cora-san!
Dialogue: 0,0:09:34.39,0:09:35.76,Main,,0,0,0,,Rosinante!
Dialogue: 0,0:09:35.76,0:09:36.72,Main,,0,0,0,,Yapma!
Dialogue: 0,0:09:38.92,0:09:40.60,Main,,0,0,0,,Seni! Seni!\NLanet olası!
Dialogue: 0,0:09:40.60,0:09:42.74,Main,,0,0,0,,Lanet olası!
Dialogue: 0,0:09:43.60,0:09:45.83,Main,,0,0,0,,Sen şu Vergo denen herifsin değil mi?!
Dialogue: 0,0:09:49.00,0:09:50.87,Main,,0,0,0,,Vergo denen herif mi?
Dialogue: 0,0:09:51.30,0:09:55.26,Main,,0,0,0,,Sanırım sen de\NBeyaz Şehir'den gelen Law'sun.
Dialogue: 0,0:09:56.04,0:10:00.75,Main,,0,0,0,,Hikayeni biliyorum.\Nİkiniz ortadan kaybolmuşsunuz.
Dialogue: 0,0:10:01.58,0:10:04.16,Main,,0,0,0,,Saygı denen şeyden haberin yok!
Dialogue: 0,0:10:04.66,0:10:09.28,Main,,0,0,0,,Büyük senpain olarak bana\NVergo-san diyeceksin!
Dialogue: 0,0:10:16.00,0:10:16.59,Main,,0,0,0,,Law!
Dialogue: 0,0:10:17.44,0:10:20.49,Main,,0,0,0,,Mektupta döktürmüşsün.
Dialogue: 0,0:10:20.49,0:10:25.17,Main,,0,0,0,,Donanma'nın eline geçecek olsaydı\Nailenin işi bitmişti.
Dialogue: 0,0:10:25.56,0:10:28.26,Main,,0,0,0,,Gelecek planlarımız dahil\Nher şey suya düşmüş olacaktı.
Dialogue: 0,0:10:30.74,0:10:33.44,Main,,0,0,0,,O velet ailenden daha mı değerli?!
Dialogue: 0,0:10:35.56,0:10:37.12,Main,,0,0,0,,Nidaime Corazon!
Dialogue: 0,0:10:42.96,0:10:45.62,Main,,0,0,0,,Ailemizde senin gibi bir\Nsıçan olduğuna inanamıyorum!
Dialogue: 0,0:10:52.58,0:10:56.82,Main,,0,0,0,,Sekiz yaşındayken\Nbirden sırra kadem basmış...
Dialogue: 0,0:10:56.82,0:11:01.92,Main,,0,0,0,,...ve on dört yıl sonra da\Nbirden karşımıza çıkıvermiştin.
Dialogue: 0,0:11:01.92,0:11:03.71,Main,,0,0,0,,Bana sorarsan çok şüpheli bir durum!
Dialogue: 0,0:11:04.20,0:11:09.05,Main,,0,0,0,,Fakat kardeşi olduğundan\NDoffy senden şüphelenmedi!
Dialogue: 0,0:11:09.44,0:11:10.38,Main,,0,0,0,,Rosinante!
Dialogue: 0,0:11:19.40,0:11:23.56,Main,,0,0,0,,Yapma lütfen... Cora-san...\NBu gidişle ölecek!
Dialogue: 0,0:11:41.80,0:11:45.82,Main,,0,0,0,,{\i1}Öldürmedin onları değil mi?{\i0}
Dialogue: 0,0:11:47.32,0:11:50.18,Main,,0,0,0,,Durum ne yani şimdi?
Dialogue: 0,0:11:50.56,0:11:53.09,Main,,0,0,0,,{\i1}Corazon Donanma casusuymuş...{\i0}
Dialogue: 0,0:11:53.09,0:11:55.76,Main,,0,0,0,,{\i1}...ve seni enseleyebilmeleri için\Naileye geri dönmüş!{\i0}
Dialogue: 0,0:11:57.98,0:12:00.66,Main,,0,0,0,,{\i1}Dikkatli ol.\NTüm planlarını biliyor olmalılar!{\i0}
Dialogue: 0,0:12:01.34,0:12:02.90,Main,,0,0,0,,{\i1}Şu an neredesin, Doffy?{\i0}
Dialogue: 0,0:12:03.44,0:12:10.09,Main,,0,0,0,,Bir süredir uzaktan randevu noktası Swallow Adası'nı izliyorum da bu süreçte iki savaş gemisi belirdi.
Dialogue: 0,0:12:10.09,0:12:13.44,Main,,0,0,0,,Onları görünce ikna oldum.
Dialogue: 0,0:12:13.44,0:12:17.65,Main,,0,0,0,,Biricik kardeşim bana diş biliyormuş.
Dialogue: 0,0:12:19.28,0:12:21.33,Main,,0,0,0,,Ve sonra fark ettim ki...
Dialogue: 0,0:12:22.08,0:12:24.26,Main,,0,0,0,,...benim tek ailem...
Dialogue: 0,0:12:24.74,0:12:26.32,Main,,0,0,0,,...sizsiniz!
Dialogue: 0,0:12:27.70,0:12:30.66,Main,,0,0,0,,Maalesef düşündüğüm şey doğru çıktı.
Dialogue: 0,0:12:31.62,0:12:35.27,Main,,0,0,0,,Sizin de bulunduğunuz\NMinion Adası'na çıktık.
Dialogue: 0,0:12:36.80,0:12:39.14,Main,,0,0,0,,Ama anlaşılan geç kaldık.
Dialogue: 0,0:12:39.82,0:12:45.81,Main,,0,0,0,,Karaya çıktığımızda Barrels'in adamları şeytan meyvesi çalındı bağrışlarıyla etrafta koşturuyorlardı.
Dialogue: 0,0:12:46.16,0:12:47.76,Main,,0,0,0,,Corazon çaldı muhtemelen!
Dialogue: 0,0:12:48.10,0:12:52.73,Main,,0,0,0,,{\i1}Oradaysa sakın bir yere kaçmasın!\NOpe Ope Meyvesi onda!{\i0}
Dialogue: 0,0:12:52.73,0:12:54.16,Main,,0,0,0,,Pekâlâ...
Dialogue: 0,0:12:54.62,0:12:55.92,Main,,0,0,0,,Lanet olasıcalar!
Dialogue: 0,0:12:56.42,0:12:58.85,Main,,0,0,0,,{\i1}Kaçtılar ha?{\i0}
Dialogue: 0,0:12:59.66,0:13:00.83,Main,,0,0,0,,{\i1}Neyse, önemi yok.{\i0}
Dialogue: 0,0:13:03.38,0:13:05.70,Main,,0,0,0,,Şehirde oldukları müddetçe...
Dialogue: 0,0:13:06.58,0:13:08.98,Main,,0,0,0,,...hiçbir yere kaçamayacaklar!
Dialogue: 0,0:13:22.32,0:13:24.22,Main,,0,0,0,,Ne oldu?! Bir şey düşüyor!
Dialogue: 0,0:13:24.54,0:13:25.62,Main,,0,0,0,,Bu da ne böyle?!
Dialogue: 0,0:13:26.80,0:13:28.59,Main,,0,0,0,,Bu adaya ne oluyor?!
Dialogue: 0,0:13:34.96,0:13:36.76,Main,,0,0,0,,Kılıç gibi keskinler!
Dialogue: 0,0:13:36.76,0:13:38.49,Main,,0,0,0,,Acayip de sertler!
Dialogue: 0,0:13:38.49,0:13:40.67,Main,,0,0,0,,Lanet olsun!\NDışarı çıkış yok!
Dialogue: 0,0:13:42.06,0:13:43.28,Main,,0,0,0,,O şey de ne?
Dialogue: 0,0:13:43.60,0:13:46.74,Main,,0,0,0,,Sanıyorum Doffy'nin gücü.
Dialogue: 0,0:13:47.58,0:13:51.18,Main,,0,0,0,,Daha önce hiç görmedim\Nama tek bir şey kesin ki...
Dialogue: 0,0:13:52.08,0:13:53.85,Main,,0,0,0,,...kaçacak hiçbir yerimiz kalmadı.
Dialogue: 0,0:13:59.96,0:14:02.28,Thoughts,,0,0,0,,{\i1}Kafesin içinde\NParazit'i kullanıyor ha?{\i0}
Dialogue: 0,0:14:03.80,0:14:07.03,Thoughts,,0,0,0,,{\i1}Cehennem bu...{\i0}
Dialogue: 0,0:14:16.70,0:14:19.92,Main,,0,0,0,,Cora-san, ne oluyor?
Dialogue: 0,0:14:29.74,0:14:33.54,Thoughts,,0,0,0,,{\i1}Law'un tek başına kaçması\Nmümkün olabilir.{\i0}
Dialogue: 0,0:14:36.18,0:14:38.28,Thoughts,,0,0,0,,{\i1}Beni artık kimse kurtaramaz da...{\i0}
Dialogue: 0,0:14:39.92,0:14:42.62,Thoughts,,0,0,0,,{\i1}Öldükten sonra\Nbeni hatırlar mısın?{\i0}
Dialogue: 0,0:14:44.02,0:14:45.96,Thoughts,,0,0,0,,{\i1}Ölümü gülerek karşılayacağım...{\i0}
Dialogue: 0,0:14:53.18,0:14:57.93,Thoughts,,0,0,0,,{\i1}Çünkü günün birinde\Nbeni hatırlayacak olursan...{\i0}
Dialogue: 0,0:15:01.60,0:15:03.64,Thoughts,,0,0,0,,{\i1}...gülümserkenki halimi\Nhatırlamanı isterim.{\i0}
Dialogue: 0,0:15:09.56,0:15:11.58,Main,,0,0,0,,Law, gitmemiz lazım.
Dialogue: 0,0:15:19.42,0:15:20.52,Main,,0,0,0,,Gidelim!
Dialogue: 0,0:15:27.60,0:15:29.87,Flashbacks,,0,0,0,,{\i1}Doffy.\NPatronumuz.{\i0}
Dialogue: 0,0:15:30.80,0:15:34.38,Flashbacks,,0,0,0,,Herkes bayıldı ha?
Dialogue: 0,0:15:34.88,0:15:37.73,Flashbacks,,0,0,0,,"Haki" yüzünden olmalı!
Dialogue: 0,0:15:39.20,0:15:40.92,Flashbacks,,0,0,0,,Ağabey, yapma!
Dialogue: 0,0:15:40.92,0:15:43.02,Flashbacks,,0,0,0,,Ağabey!
Dialogue: 0,0:15:44.70,0:15:48.69,Flashbacks,,0,0,0,,Gücümü niye aldın?!
Dialogue: 0,0:15:50.04,0:15:55.73,Flashbacks,,0,0,0,,İntikam almanı sağlayacak\Ngüce kavuşmak ister misin?
Dialogue: 0,0:15:57.00,0:16:00.10,Flashbacks,,0,0,0,,Yaptıklarının geri dönüşü yok!
Dialogue: 0,0:16:01.22,0:16:04.84,Flashbacks,,0,0,0,,Kelleni alıp\NKutsal Topraklar'a geri döneceğim!
Dialogue: 0,0:16:11.46,0:16:14.35,Flashbacks,,0,0,0,,Doflamingo.\NRosinante.
Dialogue: 0,0:16:16.58,0:16:18.53,Flashbacks,,0,0,0,,Benim gibi bir babaya\Nsahip olduğunuz için...
Dialogue: 0,0:16:20.14,0:16:21.42,Flashbacks,,0,0,0,,...özür dilerim.
Dialogue: 0,0:16:54.78,0:16:56.19,Main,,0,0,0,,Yapma! Yapma!
Dialogue: 0,0:16:56.92,0:17:00.20,Main,,0,0,0,,Birden ne oldu bilmiyorum!
Dialogue: 0,0:17:00.88,0:17:04.97,Main,,0,0,0,,Devasa, kafes gibi bir şey\Nşehri aniden sardı!
Dialogue: 0,0:17:04.97,0:17:06.50,Main,,0,0,0,,İçeri giremiyoruz!
Dialogue: 0,0:17:06.84,0:17:11.68,Main,,0,0,0,,Ve inanması güç ama içeride\Nkorsanlar aralarında bir sorun çıkmış gibi...
Dialogue: 0,0:17:11.68,0:17:13.38,Main,,0,0,0,,...birbirlerini katlediyorlar!
Dialogue: 0,0:17:14.65,0:17:15.70,Main,,0,0,0,,Drie!
Dialogue: 0,0:17:16.34,0:17:18.28,Main,,0,0,0,,Nereye gidiyorsun? Yardım et bana!
Dialogue: 0,0:17:18.62,0:17:20.62,Main,,0,0,0,,Bu kafese bir şey yapamıyor musun?!
Dialogue: 0,0:17:20.62,0:17:22.59,Main,,0,0,0,,Gitme!
Dialogue: 0,0:17:26.22,0:17:27.98,Captions,,0,0,330,,{\fad(250,250)}Barrels Korsanları Sığınağı
Dialogue: 0,0:17:28.44,0:17:30.42,Main,,0,0,0,,Donquixote Ailesi bunlar!
Dialogue: 0,0:17:31.72,0:17:33.12,Main,,0,0,0,,Drie!
Dialogue: 0,0:17:33.12,0:17:35.93,Main,,0,0,0,,Lanet olsun!\NNereye gitti bu velet?!
Dialogue: 0,0:17:36.28,0:17:38.95,Main,,0,0,0,,En ihtiyacım olduğu anda kaçtı!
Dialogue: 0,0:17:39.88,0:17:44.52,Main,,0,0,0,,Herkesten güçlü olmasına rağmen\Nödleğin teki!
Dialogue: 0,0:17:54.69,0:17:56.49,Main,,0,0,0,,Doflamingo!
Dialogue: 0,0:17:56.49,0:17:59.94,Main,,0,0,0,,Ope Ope Meyvesi'ni\Nsiz çaldınız değil mi?!
Dialogue: 0,0:18:00.38,0:18:03.30,Main,,0,0,0,,Öyle olsaydı\Nburaya kadar yormazdım kendimi!
Dialogue: 0,0:18:03.68,0:18:08.06,Main,,0,0,0,,Ne cüretle çaldırırsın onu\Ngerizekalı ayyaş!
Dialogue: 0,0:18:12.30,0:18:15.08,Main,,0,0,0,,Hazine odasındayız-in!
Dialogue: 0,0:18:15.08,0:18:19.04,Main,,0,0,0,,Tüm hazineyi gemiye taşıyın!
Dialogue: 0,0:18:19.04,0:18:21.65,Main,,0,0,0,,Harika-in!
Dialogue: 0,0:18:22.10,0:18:27.03,Main,,0,0,0,,Hiç fena değil!\NAdamlarda sağlam mal varmış!
Dialogue: 0,0:18:27.03,0:18:31.52,Main,,0,0,0,,Ne oyalanıp duruyorsunuz orada?!\NCorazon'u bulun!
Dialogue: 0,0:18:32.54,0:18:33.56,Main,,0,0,0,,Buffalo!
Dialogue: 0,0:18:34.22,0:18:35.86,Main,,0,0,0,,Durum oradan nasıl görünüyor?!
Dialogue: 0,0:18:39.02,0:18:43.54,Main,,0,0,0,,Her taraf kül olmuş! \NKimsenin sağ kurtulması mümkün değil-dasuyan!
Dialogue: 0,0:18:45.60,0:18:47.53,Main,,0,0,0,,Bir mesaj yakaladım!
Dialogue: 0,0:18:47.53,0:18:49.62,Main,,0,0,0,,{\i1}Çocuğun birini\Nkoruyucu gözaltına aldık.{\i0}
Dialogue: 0,0:18:49.98,0:18:52.58,Main,,0,0,0,,{\i1}Kazazede aramalarına\Ndevam ediyoruz!{\i0}
Dialogue: 0,0:18:53.88,0:18:56.65,Main,,0,0,0,,Donanma birilerini\Nkoruyucu gözaltına almış!
Dialogue: 0,0:19:03.05,0:19:04.18,Main,,0,0,0,,Lanet olası!
Dialogue: 0,0:19:04.18,0:19:05.06,Main,,0,0,0,,Doffy!
Dialogue: 0,0:19:05.66,0:19:07.63,Main,,0,0,0,,Corazon'u buldular sanırım!
Dialogue: 0,0:19:08.44,0:19:11.94,Thoughts,,0,0,0,,{\i1}Law.\NBurası korsanlar için kör nokta.{\i0}
Dialogue: 0,0:19:12.68,0:19:14.87,Thoughts,,0,0,0,,{\i1}Seni burada bulamayacaklar.\NBir yere kıpırdama!{\i0}
Dialogue: 0,0:19:16.02,0:19:18.04,Main,,0,0,0,,Corazon şu tarafa kaçtı!
Dialogue: 0,0:19:19.52,0:19:21.08,Main,,0,0,0,,Lao G, bu taraftan!
Dialogue: 0,0:19:25.08,0:19:27.12,Thoughts,,0,0,0,,{\i1}Açamıyorum!?{\i0}
Dialogue: 0,0:19:27.48,0:19:28.91,Thoughts,,0,0,0,,{\i1}Üstünde bir şey var!{\i0}
Dialogue: 0,0:19:28.91,0:19:30.00,Main,,0,0,0,,Tamamdır!
Dialogue: 0,0:19:46.34,0:19:47.33,Main,,0,0,0,,Acıdı be...
Dialogue: 0,0:19:54.78,0:19:55.86,Main,,0,0,0,,Adi herif!
Dialogue: 0,0:19:55.86,0:19:57.81,Main,,0,0,0,,Neden dilsiz numarası yapıyordun?!
Dialogue: 0,0:20:00.10,0:20:05.97,Main,,0,0,0,,Sizinle konuşacak\Nhiçbir şeyim olmadığı için.
Dialogue: 0,0:20:05.97,0:20:07.02,Main,,0,0,0,,Seni var ya...
Dialogue: 0,0:20:07.88,0:20:10.02,Main,,0,0,0,,Genç Bey'le bu şekilde\Nne cüretle dalga geçersin?!
Dialogue: 0,0:20:11.13,0:20:13.22,Main,,0,0,0,,Fazla abarttın, Gladius!
Dialogue: 0,0:20:13.86,0:20:16.19,Main,,0,0,0,,Genç Bey gelene kadar ölecek.
Dialogue: 0,0:20:19.30,0:20:21.30,Main,,0,0,0,,Ölsün ne olacak!
Dialogue: 0,0:20:21.30,0:20:26.76,Main,,0,0,0,,Donanma'yla aramızda\Nsavaş çıkartmaya çalışıyordu!
Dialogue: 0,0:20:28.48,0:20:31.08,Main,,0,0,0,,Ne günahkâr biri!
Dialogue: 0,0:20:39.35,0:20:41.75,Main,,0,0,0,,Genç Bey geldi!
Dialogue: 0,0:20:51.88,0:20:53.90,Main,,0,0,0,,Görüşmeyeli uzun zaman oldu...
Dialogue: 0,0:20:55.86,0:20:56.73,Main,,0,0,0,,...Corazon.
Dialogue: 0,0:21:26.08,0:21:27.64,Flashbacks,,0,0,0,,Gidecek bir yerin yok demek?
Dialogue: 0,0:21:29.57,0:21:32.40,Flashbacks,,0,0,0,,Benimle gelmek ister misin?
Dialogue: 0,0:21:42.15,0:21:47.80,Main,,0,0,0,,Bahriyeli Numarası 01746.
Dialogue: 0,0:21:48.26,0:21:52.59,Main,,0,0,0,,Donanma Karargâh Komutanı Rosinante.
Dialogue: 0,0:21:54.66,0:21:58.50,Main,,0,0,0,,Donquixote Ailesi, kaptan Doflamingo.
Dialogue: 0,0:21:59.70,0:22:05.32,Main,,0,0,0,,Elinden yaşanacak bir trajedinin\Nönüne geçebilmek için gizli görevdeydim.
Dialogue: 0,0:22:06.40,0:22:08.37,Main,,0,0,0,,Donanma askeriyim!
Dialogue: 0,0:22:15.44,0:22:17.94,Main,,0,0,0,,Sana yalan söylediğim için\Nözür dilerim...
Dialogue: 0,0:22:19.68,0:22:22.48,Main,,0,0,0,,Benden nefret etme diye böyle yaptım.
Dialogue: 0,0:22:25.48,0:22:27.59,Thoughts,,0,0,0,,{\i1}Ne diyorsun sen?!{\i0}
Dialogue: 0,0:22:28.14,0:22:29.40,Thoughts,,0,0,0,,{\i1}Zaten...{\i0}
Dialogue: 0,0:22:30.40,0:22:32.26,Thoughts,,0,0,0,,{\i1}...biliyordum!{\i0}
Dialogue: 0,0:22:34.03,0:22:38.30,Main,,0,0,0,,Lanet olası! Özür dilemekle bir şeyleri\Ndeğiştirebileceğini mi sanıyorsun?!
Dialogue: 0,0:22:38.30,0:22:41.76,Main,,0,0,0,,Yavan şakalarını\Nbir kenara bırak da...
Dialogue: 0,0:22:42.10,0:22:44.28,Main,,0,0,0,,...şu iki soruma cevap ver!
Dialogue: 0,0:22:44.82,0:22:47.84,Main,,0,0,0,,Ope Ope Meyvesi nerede?!\NLaw nereye gitti?!
Dialogue: 0,0:22:49.06,0:22:52.52,Main,,0,0,0,,Ope Ope Meyvesi'ni\NLaw'a yedirdim!
Dialogue: 0,0:22:53.88,0:22:56.12,Main,,0,0,0,,Güç kullanıcısı artık!
Dialogue: 0,0:22:56.92,0:23:00.02,Main,,0,0,0,,Kafesin dışına çıkmayı başardı.
Dialogue: 0,0:23:00.02,0:23:05.20,Main,,0,0,0,,Eminim şimdiye gözcü donanma gemisinde\Nkoruyucu gözaltına alınmıştır bile.
Dialogue: 0,0:23:05.20,0:23:07.16,Main,,0,0,0,,Artık onun kılına bile dokunamazsın!
Dialogue: 0,0:23:07.16,0:23:08.57,Main,,0,0,0,,Genç Bey'im!
Dialogue: 0,0:23:09.06,0:23:13.44,Main,,0,0,0,,Az önce telsizden donanmanın bir çocuğu\Nkoruyucu gözaltına aldığını duymuştuk!
Dialogue: 0,0:23:13.61,0:23:16.57,Main,,0,0,0,,Neden daha önce haber vermediniz?!
Dialogue: 0,0:23:16.57,0:23:19.06,Main,,0,0,0,,Gelebildiğimiz kadar \Nhızlı gelmeye çalıştık-dasuyan!
Dialogue: 0,0:23:19.06,0:23:20.44,Main,,0,0,0,,Özür dileriz!
Dialogue: 0,0:23:20.91,0:23:22.12,Thoughts,,0,0,0,,{\i1}Çocuk mu?!{\i0}
Dialogue: 0,0:23:23.60,0:23:25.22,Thoughts,,0,0,0,,{\i1}Rastlantıya bak!{\i0}
Dialogue: 0,0:23:25.97,0:23:27.64,Thoughts,,0,0,0,,{\i1}Law hâlâ burada...{\i0}
Dialogue: 0,0:23:29.62,0:23:33.52,Main,,0,0,0,,Hemen ilgilenin!\NKuş Kafesi'ni kaldırıyorum!
Dialogue: 0,0:23:33.92,0:23:37.74,Thoughts,,0,0,0,,{\i1}Biliyordum Law!\NEvren bile hayatta kalmanı istiyor!{\i0}
Dialogue: 0,0:23:38.12,0:23:42.33,Thoughts,,0,0,0,,{\i1}Kurtarıcılar birbiri ardına\Nyardımımıza yetişiyor.{\i0}
Dialogue: 0,0:23:42.74,0:23:44.85,Main,,0,0,0,,Yelken açmaya hazırlanın!
Dialogue: 0,0:23:44.85,0:23:48.20,Main,,0,0,0,,Haber doğruysa\NDonanma gözcü gemisini batıracak...
Dialogue: 0,0:23:48.52,0:23:50.23,Main,,0,0,0,,...ve Law'u geri alacağız!
Dialogue: 0,0:23:51.24,0:23:51.94,Main,,0,0,0,,Yapma.
Dialogue: 0,0:23:52.92,0:23:54.60,Main,,0,0,0,,Law'un peşinden gidip de ne yapacaksın?
Dialogue: 0,0:23:55.52,0:23:58.66,Main,,0,0,0,,Ne mi yapacağım!?
Dialogue: 0,0:23:58.66,0:24:01.49,Main,,0,0,0,,Ope Ope Meyvesi'ni yemişse...
Dialogue: 0,0:24:01.49,0:24:07.56,Main,,0,0,0,,...uğruma ölmek için yetiştirilecek elbette!
Dialogue: 0,0:24:08.90,0:24:12.66,Main,,0,0,0,,Çok fazla gereksiz iş başardın delikanlı!
Dialogue: 0,0:24:13.26,0:24:15.67,Main,,0,0,0,,Neden ısrarla\Nayakbağı olmaya çalışıyorsun?!
Dialogue: 0,0:24:15.67,0:24:20.60,Main,,0,0,0,,Neden öz ailemden birini daha\Nöldürmeye zorluyorsun beni?!
Dialogue: 0,0:24:22.21,0:24:24.64,Thoughts,,0,0,0,,{\i1}Cora-san, bir şey olmayacağına\Neminsin değil mi?!{\i0}
Dialogue: 0,0:24:27.38,0:24:30.30,Main,,0,0,0,,Beni vuramayacağını biliyorum...
Dialogue: 0,0:24:31.20,0:24:34.08,Main,,0,0,0,,Babana çok benziyorsun!
Dialogue: 0,0:24:34.08,0:24:36.09,Main,,0,0,0,,{\i1}Bir şey olmayacak demiştin!{\i0}
Dialogue: 0,0:24:36.09,0:24:37.15,Flashbacks,,0,0,0,,{\i1}Beni dinle, Law.{\i0}
Dialogue: 0,0:24:37.92,0:24:43.64,Flashbacks,,0,0,0,,{\i1}Korsanlar hazine sandığı görünce\Ndayanamaz ve gemilerine götürürler.{\i0}
Dialogue: 0,0:24:44.80,0:24:50.06,Flashbacks,,0,0,0,,Yani burada kalırsan \Nmutlaka kafesten dışarı çıkmayı da başarırsın.
Dialogue: 0,0:24:50.06,0:24:51.26,Flashbacks,,0,0,0,,Kaçırma bu fırsatı.
Dialogue: 0,0:24:51.66,0:24:52.37,Flashbacks,,0,0,0,,Ya sen, Cora-san?!
Dialogue: 0,0:24:54.56,0:24:56.06,Flashbacks,,0,0,0,,Şapşal şey...
Dialogue: 0,0:24:56.06,0:24:59.74,Flashbacks,,0,0,0,,Doffy senin ve\NOpe Ope Meyvesi gücünün peşinde.
Dialogue: 0,0:25:00.36,0:25:02.64,Flashbacks,,0,0,0,,Öz kardeşim benim.
Dialogue: 0,0:25:03.32,0:25:08.06,Flashbacks,,0,0,0,,Bana eminim kızacaktır\Nama öldürmesine imkan yok.
Dialogue: 0,0:25:08.92,0:25:10.00,Flashbacks,,0,0,0,,{\fad(150,150)}Sakin.
Dialogue: 0,0:25:12.82,0:25:17.49,Flashbacks,,0,0,0,,Dokunduğun şeylerin\Nses çıkartmamasını sağlayacak bir teknik bu.
Dialogue: 0,0:25:17.49,0:25:20.03,Flashbacks,,0,0,0,,Başka bir şehirde görüşmek üzere.
Dialogue: 0,0:25:20.76,0:25:21.87,Flashbacks,,0,0,0,,Hey, Law.
Dialogue: 0,0:25:24.56,0:25:26.10,Flashbacks,,0,0,0,,Seni seviyorum!
Dialogue: 0,0:25:33.02,0:25:35.16,Thoughts,,0,0,0,,{\b1}Böyle söylememiştin bana, Cora-san!
Dialogue: 0,0:25:35.58,0:25:37.88,Thoughts,,0,0,0,,{\b1}Öldürmeyecek demiştin!
Dialogue: 0,0:25:40.86,0:25:45.49,Main,,0,0,0,,Law sana boyun eğmeyecek, Doffy...
Dialogue: 0,0:25:45.49,0:25:47.56,Main,,0,0,0,,Beyaz Kurşun Hastalığı'na yakalanıp...
Dialogue: 0,0:25:48.19,0:25:51.57,Main,,0,0,0,,...üç yıllık ömür biçilmiş bir hayat.
Dialogue: 0,0:25:52.38,0:25:54.63,Main,,0,0,0,,Ama kazandı.
Dialogue: 0,0:25:56.62,0:25:58.37,Main,,0,0,0,,Kim olduğunu unutmuş...
Dialogue: 0,0:25:58.98,0:26:03.34,Main,,0,0,0,,...yolu kaçık korsanın tekine çıkan\No Law değil artık.
Dialogue: 0,0:26:04.34,0:26:10.00,Main,,0,0,0,,Senin gibi yıkımdan başka bir şey getirmeyen\Nbirinden öğreneceği hiçbir şeyi yok!
Dialogue: 0,0:26:10.00,0:26:11.91,Main,,0,0,0,,Yalnız bırak onu!
Dialogue: 0,0:26:12.32,0:26:14.76,Main,,0,0,0,,Özgür o!
Dialogue: 0,0:26:31.94,0:26:35.34,Flashbacks,,0,0,0,,Kimmiş canavar,\Nbir daha söyle de görelim!
Dialogue: 0,0:26:35.68,0:26:38.84,Flashbacks,,0,0,0,,Oha düşüp alev aldı!
Dialogue: 0,0:26:39.38,0:26:41.21,Flashbacks,,0,0,0,,Ne güzel,\Nsessiz bir uyku çektin ama değil mi?!
Dialogue: 0,0:26:41.21,0:26:42.46,Flashbacks,,0,0,0,,Biliyoruz tamam!
Dialogue: 0,0:27:20.40,0:27:21.45,Thoughts,,0,0,0,,{\i1}Daha değil.{\i0}
Dialogue: 0,0:27:21.63,0:27:25.06,Thoughts,,0,0,0,,{\i1}Biraz daha yaşayacağım...{\i0}
Dialogue: 0,0:27:25.06,0:27:26.69,Main,,0,0,0,,Gemiyi buraya getirin!
Dialogue: 0,0:27:27.72,0:27:29.18,Thoughts,,0,0,0,,{\i1}Çünkü şimdi ölürsem...{\i0}
Dialogue: 0,0:27:30.56,0:27:35.02,Thoughts,,0,0,0,,{\i1}...sana yaptığım büyü bozulacak...{\i0}
Dialogue: 0,0:27:35.86,0:27:39.04,Thoughts,,0,0,0,,{\i1}...ve sesin, çıkardığın sesler...{\i0}
Dialogue: 0,0:27:39.44,0:27:41.94,Thoughts,,0,0,0,,{\i1}...tüm adada yankılanacak.{\i0}
Dialogue: 0,0:27:43.44,0:27:45.10,Thoughts,,0,0,0,,{\i1}Git Law...{\i0}
Dialogue: 0,0:27:46.64,0:27:49.51,Thoughts,,0,0,0,,{\i1}Sessizce... Kimselere belli etmeden...{\i0}
Dialogue: 0,0:27:50.20,0:27:52.72,Thoughts,,0,0,0,,{\i1}Uzaklara... Çok uzaklara git.{\i0}
Dialogue: 0,0:27:53.78,0:27:56.45,Thoughts,,0,0,0,,{\i1}Seni burada tutan hiçbir şey kalmadı artık.{\i0}
Dialogue: 0,0:27:57.68,0:28:00.06,Thoughts,,0,0,0,,{\i1}Ne Beyaz Şehir'e\Nörülen demir duvarlar...{\i0}
Dialogue: 0,0:28:00.58,0:28:02.24,Thoughts,,0,0,0,,...ne de biçilen kısacık ömür...
Dialogue: 0,0:28:03.08,0:28:05.43,Thoughts,,0,0,0,,{\i1}Seni sınırlayacak\Nhiçbir şey kalmadı artık.{\i0}
Dialogue: 0,0:28:08.38,0:28:11.40,Main,,0,0,0,,Tsuru'nun savaş gemisi!\NLanet olsun!
Dialogue: 0,0:28:17.86,0:28:19.14,Thoughts,,0,0,0,,{\i1}Artık...{\i0}
Dialogue: 0,0:28:20.88,0:28:22.15,Thoughts,,0,0,0,,{\i1}...özgürsün...{\i0}
Dialogue: 0,0:28:30.00,0:28:31.01,Main,,0,0,0,,Ateş!
Dialogue: 0,0:28:51.51,0:28:58.00,OP11 Credits,,0,0,0,,Editing: Galaxy 9000\N\NTiming: Datenshi\NSewil (Opening)\N\NQC: Mr. Luffy\N\NSoundtracking: Halee\N\NTC/Infoboxes: Datenshi\N\NOriginal Translation: Yibis
