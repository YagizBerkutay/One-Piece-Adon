nts]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:23.75,0:00:28.07,Credits,,0,0,0,,Translation & initial timing YibisDialogue: 0,0:00:28.16,0:00:32.16,Credits,,0,0,0,,Timing HaleeDialogue: 0,0:00:34.66,0:00:37.60,Credits,,0,0,0,,Quality-checking Sewil Galaxy 9000 HaleeDialogue: 0,0:00:39.02,0:00:42.64,Credits,,0,0,0,,Soundtracking HaleeDialogue: 0,0:00:45.87,0:00:48.56,Credits,,0,0,0,,Video editing SewilDialogue: 0,0:00:45.87,0:00:48.56,Credits,,0,0,0,,Raw provider GS-RawsDialogue: 0,0:00:01.26,0:00:03.90,Lyrics,,0,0,0,,♪ Gidelim tüm parıltımızla, koşar adım, sonsuza dek! ♪Dialogue: 0,0:00:03.93,0:00:06.66,Lyrics,,0,0,0,,♪ İlerlemeye devam edelim! ♪Dialogue: 0,0:00:06.70,0:00:09.57,Lyrics,,0,0,0,,♪ Değişmeyen bağlar mutlak aydınlatacak... ♪Dialogue: 0,0:00:09.63,0:00:12.67,Lyrics,,0,0,0,,♪ ...rüyamızın sonunu! ♪Dialogue: 0,0:00:12.77,0:00:15.27,Lyrics,,0,0,0,,♪ Uyan, uyan, uyan, uyan haydi kalbim! ♪Dialogue: 0,0:00:15.34,0:00:18.18,Lyrics,,0,0,0,,♪ Başaracağız! Durmaksızın devam! ♪Dialogue: 0,0:00:23.72,0:00:28.07,Lyrics,,0,0,0,,♪ Tek pusulamız özgürlüktür. En sıkı dostlarız. ♪Dialogue: 0,0:00:28.15,0:00:34.59,Lyrics,,0,0,0,,♪ Kendi rotamızı bundan sonra da yine kendimiz çizeceğiz. ♪Dialogue: 0,0:00:34.66,0:00:39.00,Lyrics,,0,0,0,,♪ Her gün tam hız ilerliyoruz. Doğuya git, batıya git. ♪Dialogue: 0,0:00:39.06,0:00:45.44,Lyrics,,0,0,0,,♪ Birbiri ardına yapmak istediğimiz şeyler buluyor ve yapıyoruz da hepsini. ♪Dialogue: 0,0:00:45.50,0:00:50.99,Lyrics,,0,0,0,,♪ Sabahları etmeye dayanamaz aceleci gönlümüz. (Bekleyemem!) ♪Dialogue: 0,0:00:51.11,0:00:56.05,Lyrics,,0,0,0,,♪ Neden alıp biz yapıştırmıyoruz güneşi göğe. ♪Dialogue: 0,0:00:56.11,0:00:58.95,Lyrics,,0,0,0,,♪ Zorla ve yola çıkmıyoruz! ♪Dialogue: 0,0:00:59.95,0:01:02.65,Lyrics,,0,0,0,,♪ Evet tüm parıltımızla, koşar adım, sonsuza dek! ♪Dialogue: 0,0:01:02.72,0:01:06.59,Lyrics,,0,0,0,,♪ Hayal kırıntılarımız birleştirerek. ♪Dialogue: 0,0:01:06.66,0:01:10.75,Lyrics,,0,0,0,,♪ Titretiyorsa eğer gönlünü var mı daha büyük hazine. ♪Dialogue: 0,0:01:10.83,0:01:13.43,Lyrics,,0,0,0,,♪ Gidelim tüm parıltımızla, koşar adım, sonsuza dek! ♪Dialogue: 0,0:01:13.50,0:01:16.13,Lyrics,,0,0,0,,♪ İlerlemeye devam edelim! ♪Dialogue: 0,0:01:16.20,0:01:19.17,Lyrics,,0,0,0,,♪ Değişmeyen bağlar mutlak aydınlatacak... ♪Dialogue: 0,0:01:19.24,0:01:22.24,Lyrics,,0,0,0,,♪ ...rüyamızın sonunu! ♪Dialogue: 0,0:01:22.31,0:01:24.94,Lyrics,,0,0,0,,♪ Uyan, uyan, uyan, uyan haydi kalbim ♪Dialogue: 0,0:01:25.01,0:01:27.41,Lyrics,,0,0,0,,♪ Başaracağız! Durmaksızın devam! ♪Dialogue: 0,0:01:33.07,0:01:35.47,Captions,Caption,0,0,0,,Kraliyet Sarayı - 1.Kat (Kule Duvarı)Dialogue: 0,0:01:38.21,0:01:48.21,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gnsDialogue: 0,0:12:44.00,0:12:54.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gnsDialogue: 0,0:26:25.00,0:26:35.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gnsDialogue: 0,0:01:38.21,0:01:40.78,Title,,0,0,230,,Yalancı UsolandDialogue: 0,0:01:46.99,0:01:49.66,Main,Luffy,0,0,0,,Nereye de gitsek önümüze çıkıyor!Dialogue: 0,0:01:49.66,0:01:55.23,Main,Violet,0,0,0,,Pica'nın bu taştan sarayı gönlünce kontrol edebildiğini söylemiştim!Dialogue: 0,0:01:59.00,0:02:03.14,Main,Violet,0,0,0,,Hasır Şapka, onu bir başına bırakarak iyi mi ettik acaba?Dialogue: 0,0:02:03.14,0:02:05.22,Main,Luffy,0,0,0,,Zoro'yu mu diyorsun?Dialogue: 0,0:02:05.91,0:02:08.07,Main,Luffy,0,0,0,,Onun için endişelenmene gerek yok!Dialogue: 0,0:02:08.07,0:02:10.58,Main,Luffy,0,0,0,,Zoro her türlü şeyin üstesinden gelmesini bilir!Dialogue: 0,0:02:10.84,0:02:14.78,Captions,Caption,0,0,0,,Aynı Kat Zoro, Pica'ya KarşıDialogue: 0,0:02:18.95,0:02:20.72,Main,Zoro,0,0,0,,Sonu gelecek gibi değil!Dialogue: 0,0:02:20.72,0:02:25.16,Main,Zoro,0,0,0,,İşini bitirebilmek için nasıl ve neresine saldırmak lazım bunun?!Dialogue: 0,0:02:25.16,0:02:27.66,Captions,Caption,0,0,0,,Kraliyet Sarayı  1.Kat -  Asker ve  Küçük İnsanlarDialogue: 0,0:02:28.29,0:02:31.10,Main,Kabu,0,0,0,,Komutan! Başka bir yönetici daha!Dialogue: 0,0:02:33.03,0:02:37.37,Main,Ranpo,0,0,0,,Pica Ordusu'nun üyelerinden Gladius bu!Dialogue: 0,0:02:37.37,0:02:39.77,Main,Kabu,0,0,0,,Bu şekilde kazanmana imkan yok!Dialogue: 0,0:02:39.77,0:02:42.84,Main,Kabu,0,0,0,,Rampo'yla ikimiz dikkatini üzerimize çekeceğiz!Dialogue: 0,0:02:42.84,0:02:44.21,Main,Kabu,0,0,0,,Sen ilerlemeye devam et!Dialogue: 0,0:02:44.21,0:02:47.88,Main,Thunder Soldier,0,0,0,,Olmaz! Gene kendinizi benim için feda etmeyi mi planlıyorsunuz?!Dialogue: 0,0:02:47.88,0:02:48.88,Main,Kabu,0,0,0,,Rampo!Dialogue: 0,0:02:49.58,0:02:51.52,Main,Ranpo,0,0,0,,İki tarafından birlikte saldıralım, Kabu-san!Dialogue: 0,0:02:51.52,0:02:52.50,Main,Kabu,0,0,0,,Tamamdır!Dialogue: 0,0:02:53.79,0:02:54.45,Main,Thunder Soldier,0,0,0,,Bekleyin!Dialogue: 0,0:02:57.32,0:03:00.76,Main,Gladius,0,0,0,,Neden böyle işe yaramaz böceklerle ilgilenmek zorunda kalıyorum ki?!Dialogue: 0,0:03:05.53,0:03:06.27,Main,Thunder Soldier,0,0,0,,Kabu!Dialogue: 0,0:03:07.57,0:03:08.53,Main,Thunder Soldier,0,0,0,,Rampo!Dialogue: 0,0:03:32.42,0:03:35.49,Main,Gladius,0,0,0,,Oyuncaklar öyle hızlı kaçamazlar maalesef!Dialogue: 0,0:03:41.30,0:03:44.84,Main,Gladius,0,0,0,,Ben Pamu Pamu Meyvesi yemiş patlayan insanım!Dialogue: 0,0:03:47.77,0:03:51.58,Main,Gladius,0,0,0,,Kendi vücudumu patlatabildiğim gibi...Dialogue: 0,0:03:52.14,0:03:53.05,Main,Gladius,0,0,0,,...ayrıca...Dialogue: 0,0:03:56.12,0:03:58.48,Main,Gladius,0,0,0,,...dokunduğum inorganik şeyleri de patlatabilirim.Dialogue: 0,0:04:01.10,0:04:04.06,Main,Gladius,0,0,0,,Senin gibi bir teneke oyuncağı tamamıyla ortadan kaldırabilirim!Dialogue: 0,0:04:05.56,0:04:06.56,Main,Thunder Soldier,0,0,0,,Bırak beni!Dialogue: 0,0:04:06.56,0:04:08.39,Main,Thunder Soldier,0,0,0,,Yapmam gereken...Dialogue: 0,0:04:12.33,0:04:13.80,Main,Thunder Soldier,0,0,0,,...bir görevim var!Dialogue: 0,0:04:17.60,0:04:19.07,Main,Thunder Soldier,0,0,0,,Rebecca!Dialogue: 0,0:04:19.77,0:04:22.51,Main,Gladius,0,0,0,,Patla ve kaybol bu dünyadan!Dialogue: 0,0:04:23.44,0:04:26.68,Main,Luffy,0,0,0,,Jet Zımba!Dialogue: 0,0:04:32.82,0:04:33.55,Main,Gladius,0,0,0,,Kimsin sen?!Dialogue: 0,0:04:36.32,0:04:38.46,Main,Luffy,0,0,0,,Asker, Franky'ler nerede?Dialogue: 0,0:04:38.46,0:04:39.89,Main,Thunder Soldier,0,0,0,,Sen...Dialogue: 0,0:04:39.89,0:04:41.99,Main,Luffy,0,0,0,,Onlarla beraber değil miydin?Dialogue: 0,0:04:41.99,0:04:44.06,Main,Violet,0,0,0,,Hasır Şapka, konuşacak vakit yok!Dialogue: 0,0:04:44.73,0:04:46.30,Main,Gladius,0,0,0,,Hasır Şapkalı Luffy!Dialogue: 0,0:04:47.03,0:04:48.30,Main,Gladius,0,0,0,,Violet!Dialogue: 0,0:04:48.90,0:04:50.88,Main,Gladius,0,0,0,,Ne cüretle...Dialogue: 0,0:04:51.87,0:04:55.51,Main,Gladius,0,0,0,,Ne cüretle Genç Beyimize ihanet edersin?!Dialogue: 0,0:04:55.51,0:04:56.94,Main,Luffy,0,0,0,,Gel bakalım!Dialogue: 0,0:04:56.94,0:04:58.24,Main,Violet,0,0,0,,Olmaz, kaçalım!Dialogue: 0,0:04:58.24,0:04:59.01,Main,Luffy,0,0,0,,Ne oluyor be?Dialogue: 0,0:04:59.01,0:05:03.05,Main,Violet,0,0,0,,Zamanımız yok! Ayrıca epey can sıkıcı biridir!Dialogue: 0,0:05:03.05,0:05:06.35,Main,Violet,0,0,0,,Taht odasına varmaya bakalım biz!Dialogue: 0,0:05:06.35,0:05:08.69,Main,Thunder Soldier,0,0,0,,Viola-sama, neden buradasın?!Dialogue: 0,0:05:09.29,0:05:10.39,Main,Violet,0,0,0,,Kim olduğumu biliyor musun?Dialogue: 0,0:05:10.39,0:05:13.76,Main,Thunder Soldier,0,0,0,,Biliyorum! Sen beni hatırlamasan bile...Dialogue: 0,0:05:13.76,0:05:19.93,Main,Violet,0,0,0,,Görü yeteneğim sayesinde  Rebecca'yla ikinizi izliyordum hep!Dialogue: 0,0:05:20.60,0:05:23.07,Main,Violet,0,0,0,,Çok zor günler geçirdiğinizi biliyorum. Teşekkür ederim!Dialogue: 0,0:05:25.04,0:05:26.41,Main,Gladius,0,0,0,,Violet!Dialogue: 0,0:05:26.97,0:05:30.04,Main,Gladius,0,0,0,,Senin gibi bir hainin kaçmasına asla...Dialogue: 0,0:05:32.88,0:05:34.18,Main,Gladius,0,0,0,,...izin vermem!Dialogue: 0,0:05:34.18,0:05:35.85,Main,Violet,0,0,0,,Kimseye ihanet etmedim ben!Dialogue: 0,0:05:35.85,0:05:41.25,Main,Violet,0,0,0,,On yıl önceki o günden beri sizlere bir kez bile güvenmemiştim çünkü!Dialogue: 0,0:05:41.25,0:05:44.02,Main,Gladius,0,0,0,,Genç Beyimize saygısızlık ettiğin gerçeğini değiştirmez bu!Dialogue: 0,0:05:45.02,0:05:46.49,Main,Gladius,0,0,0,,Kask Patlaması!Dialogue: 0,0:05:53.27,0:05:54.80,Main,Thunder Soldier,0,0,0,,Viola-sama!Dialogue: 0,0:05:54.80,0:05:55.50,Main,Luffy,0,0,0,,Lanet olsun!Dialogue: 0,0:05:58.14,0:06:00.07,Main,Luffy,0,0,0,,Ciddi bir yaralanma olmadı, değil mi?Dialogue: 0,0:06:00.07,0:06:01.51,Main,Luffy,0,0,0,,Özür dilerim, seni koruyamadım!Dialogue: 0,0:06:01.51,0:06:03.68,Main,Luffy,0,0,0,,Bunu nasıl yapacağımızın bir önemi yok değil mi?Dialogue: 0,0:06:03.68,0:06:04.58,Main,Violet,0,0,0,,Bekle biraz!Dialogue: 0,0:06:04.58,0:06:06.28,Main,Violet,0,0,0,,Merdivenler o tarafta değil...Dialogue: 0,0:06:11.55,0:06:12.35,Main,Thunder Soldier,0,0,0,,Ne oluyor?!Dialogue: 0,0:06:12.35,0:06:13.45,Main,Violet,0,0,0,,Nereye gidiyorsun?!Dialogue: 0,0:06:13.45,0:06:14.82,Main,Luffy,0,0,0,,Orası sanırım?Dialogue: 0,0:06:20.86,0:06:22.16,Main,Gladius,0,0,0,,Nereye kayboldular?!Dialogue: 0,0:06:26.53,0:06:29.03,Main,Gladius,0,0,0,,Genç Beyim! Neden buradasınız?Dialogue: 0,0:06:30.10,0:06:33.74,Captions,Caption,0,0,240,,Don Quixote Doflaemon Kılık Değiştirmiş Kin'emonDialogue: 0,0:06:30.70,0:06:31.64,Main,Kin'emon,0,0,2,,Genç Bey mi?Dialogue: 0,0:06:32.77,0:06:33.74,Main,Kin'emon,0,0,2,,Ben Don Quixote-Dialogue: 0,0:06:33.74,0:06:36.18,Main,Wicca,0,0,0,,Doflamingo'ya Genç Bey diyorlar!Dialogue: 0,0:06:37.24,0:06:39.08,Main,Kin'emon,0,0,0,,Benim!Dialogue: 0,0:06:39.08,0:06:41.71,Main,Gladius,0,0,0,,Sarayda izinsiz dolananlar mevcut.Dialogue: 0,0:06:41.71,0:06:44.42,Main,Gladius,0,0,0,,Lütfen biz onların icabına bakana kadar üst katta kalın.Dialogue: 0,0:06:44.42,0:06:47.19,Main,Kin'emon,0,0,0,,Maalesef bu mümkün değil.Dialogue: 0,0:06:47.19,0:06:49.56,Main,Kin'emon,0,0,0,,Yani burası elbette size emanet.Dialogue: 0,0:06:49.56,0:06:52.76,Main,Kin'emon,0,0,0,,Ben yeraltına inip Kanjuro'nun durumuna bakacağım.Dialogue: 0,0:06:53.59,0:06:55.89,Main,Gladius,0,0,0,,Şu hurdalıktan kaybolan samurayı mı diyorsunuz?Dialogue: 0,0:06:56.50,0:06:57.10,Main,Kin'emon,0,0,0,,Ne?!Dialogue: 0,0:06:57.60,0:06:59.33,Main,Kin'emon,0,0,0,,Kayboldu mu dedin?!Dialogue: 0,0:07:00.47,0:07:04.10,Main,Thunder Soldier,0,0,2,,Amanın! Kendimizi doğrudan hedefimizin kapısında bulduk!Dialogue: 0,0:07:00.63,0:07:04.10,Captions,Caption,0,0,235,,Kraliyet Sarayı 2.Kat Taht OdasıDialogue: 0,0:07:04.10,0:07:06.34,Main,Luffy,0,0,0,,Neden saklanıyoruz ki ya?!Dialogue: 0,0:07:06.34,0:07:07.54,Main,Luffy,0,0,0,,Mingo gözümüzün önünde işte!Dialogue: 0,0:07:08.31,0:07:09.44,Main,Violet,0,0,0,,Sessiz ol!Dialogue: 0,0:07:09.44,0:07:12.28,Main,Violet,0,0,0,,Planlarını mahvetme!Dialogue: 0,0:07:12.28,0:07:13.38,Main,Luffy,0,0,0,,Plan mı?Dialogue: 0,0:07:17.22,0:07:22.82,Main,Doflamingo,0,0,0,,Yalnızca GÜLÜCÜK fabrikasını yok etmeyi planladığınızı sanıyordum.Dialogue: 0,0:07:23.39,0:07:28.46,Main,Doflamingo,0,0,0,,Fakat neden Hasır Şapkalar Green Bit'in Küçük İnsanları'yla işbirliği içindeler?Dialogue: 0,0:07:29.18,0:07:32.70,Main,Doflamingo,0,0,0,,Rastgele canları istediği için yaptıkları bir şey değil bu.Dialogue: 0,0:07:33.73,0:07:34.93,Main,Law,0,0,0,,Küçük İnsanlar mı?Dialogue: 0,0:07:34.93,0:07:38.50,Main,Doflamingo,0,0,0,,Yeraltına sızmayı nasıl başardılar?Dialogue: 0,0:07:43.61,0:07:46.28,Main,Doflamingo,0,0,0,,Neden Sugar'ın peşindeler?Dialogue: 0,0:07:46.98,0:07:50.25,Main,Doflamingo,0,0,0,,Neyin peşinde olduklarını bilmiyorum ama...Dialogue: 0,0:07:50.25,0:07:54.65,Main,Doflamingo,0,0,0,,...yaptıkları şeyler gitgide canımı daha da sıkmaya başladı.Dialogue: 0,0:07:55.22,0:08:00.39,Main,Doflamingo,0,0,0,,Eğer işin içinde çok büyük bir tesadüf yoksa...Dialogue: 0,0:08:03.20,0:08:07.63,Main,Doflamingo,0,0,0,,...bu ülkenin ardında yatan karanlığı biliyorlar demektir bu!Dialogue: 0,0:08:13.34,0:08:16.91,Main,Baby 5,0,0,0,,Cevap ver! Genç Beyimiz sana bir soru sordu, Law!Dialogue: 0,0:08:21.05,0:08:24.05,Main,Buffalo,0,0,0,,Sonra böyle ağlayacaksan hiç yapma o zaman-dasuyan!Dialogue: 0,0:08:24.05,0:08:25.88,Main,Buffalo,0,0,0,,Hiç değişmeyeceksiniz!Dialogue: 0,0:08:26.72,0:08:28.05,Main,Law,0,0,0,,Demiştim.Dialogue: 0,0:08:28.72,0:08:33.46,Main,Law,0,0,0,,Onlarla bir ilgim yok artık! İttifakımız sona erdi.Dialogue: 0,0:08:34.13,0:08:37.96,Main,Law,0,0,0,,Neden bahsettiğini ise zerre bilmiyorum.Dialogue: 0,0:08:49.40,0:08:53.91,Main,Doflamingo,0,0,0,,Violet yanımızda olsaydı aklından geçenleri hemen söylerdi bize.Dialogue: 0,0:08:54.48,0:08:55.68,Main,Doflamingo,0,0,0,,Yoksa diyorum...Dialogue: 0,0:08:56.18,0:09:00.32,Main,Doflamingo,0,0,0,,...onları sen mi kışkırttın, Kral Riku?Dialogue: 0,0:09:00.32,0:09:04.19,Main,Doflamingo,0,0,0,,Tontattalar vakti zamanında sana hizmet etmişlerdi.Dialogue: 0,0:09:06.66,0:09:09.84,Main,Violet,0,0,0,,Baba! Neden buradasın?!Dialogue: 0,0:09:09.84,0:09:11.96,Main,Luffy,0,0,0,,Trao yaşıyor gibi.Dialogue: 0,0:09:12.50,0:09:17.30,Thoughts,Thunder Soldier,0,0,0,,Kral Riku, on yılın ardından hâlâ iyi olmanıza çok sevindim!Dialogue: 0,0:09:19.00,0:09:23.21,Flashbacks,Riku,0,0,0,,Adın Kyros demek? Gel benimle!Dialogue: 0,0:09:23.54,0:09:26.98,Thoughts,Thunder Soldier,0,0,0,,Sizi ne pahasına olursa olsun kurtaracağım!Dialogue: 0,0:09:29.88,0:09:31.78,Thoughts,Thunder Soldier,0,0,0,,Ne yapıyor bu Leo'lar?!Dialogue: 0,0:09:31.78,0:09:37.72,Thoughts,Thunder Soldier,0,0,0,,Dressrosa'daki tüm oyuncakların yeniden insan olduğu o kısacık an...Dialogue: 0,0:09:37.72,0:09:40.36,Thoughts,Thunder Soldier,0,0,0,,...Doflamingo'yu yenebileceğimiz tek fırsat olacak!Dialogue: 0,0:09:40.36,0:09:42.94,Thoughts,Thunder Soldier,0,0,0,,Mutlaka işini bitireceğim!Dialogue: 0,0:09:42.94,0:09:45.70,Thoughts,Thunder Soldier,0,0,0,,Kabu'ların fedakarlıklarının boşa gitmesine müsaade etmem!Dialogue: 0,0:09:45.70,0:09:49.17,Thoughts,Thunder Soldier,0,0,0,,Size güveniyorum Leo, Usoland!Dialogue: 0,0:09:50.07,0:09:54.61,Captions,Caption,0,0,180,,Oyuncak EviDialogue: 0,0:09:54.61,0:09:58.14,Main,Marine,0,0,0,,Vazgeç bu direnişten Franky, usul usul teslim ol!Dialogue: 0,0:09:59.14,0:10:00.25,Main,Franky,0,0,0,,Kapa çeneni...Dialogue: 0,0:10:00.85,0:10:03.75,Main,Franky,0,0,0,,Kapa çeneni lan!Dialogue: 0,0:10:08.52,0:10:14.73,Main,Franky,0,0,0,,Bu yeri manasızca yıkmaya karar verdim! Hazırlansanız iyi edersiniz!Dialogue: 0,0:10:19.10,0:10:24.27,Thoughts,Franky,0,0,0,,Peşimde bunlar varken yeraltına inersem  Küçük İnsanlar'a ayakbağı olmuş olurum yalnızca.Dialogue: 0,0:10:24.80,0:10:28.04,Thoughts,Franky,0,0,0,,SOP Operasyonu size emanet millet!Dialogue: 0,0:10:28.77,0:10:31.11,Main,Franky,0,0,0,,Gelin bakalım!Dialogue: 0,0:10:33.88,0:10:35.22,Thoughts,Franky,0,0,0,,Burasıyla ben ilgileneceğim!Dialogue: 0,0:10:35.22,0:10:36.98,Thoughts,Franky,0,0,0,,Sana güveniyorum, Usoland!Dialogue: 0,0:10:37.42,0:10:41.89,Captions,Caption,0,0,0,,Yer Altı Ticaret Limanı Yönetim Kulesi'nin KalıntılarıDialogue: 0,0:10:38.58,0:10:40.22,Main,Pirate,0,0,0,,Neler oluyor orada?!Dialogue: 0,0:10:40.22,0:10:41.85,Main,Pirate,0,0,0,,İzinsiz giriş yapanlar varmış.Dialogue: 0,0:10:41.85,0:10:45.82,Main,Pirate,0,0,0,,Ama bizim Trebol-sama'mız var!Dialogue: 0,0:10:45.82,0:10:50.06,Main,Pirate,0,0,0,,Onlar için üzülüyorum aslında çünkü Trebol-sama'dan kimse sağ kurtulamaz!Dialogue: 0,0:10:55.67,0:10:59.47,Main,Trébol,0,0,0,,Daha kaç kare karşımda doğrulacak bunlar?!Dialogue: 0,0:11:05.24,0:11:08.51,Thoughts,Robin,0,0,0,,Dikkatsizlik ettim! Beni de oyuncağa dönüştürdü!Dialogue: 0,0:11:09.05,0:11:12.65,Thoughts,Robin,0,0,0,,Herkes beni unutmuş olmalı.Dialogue: 0,0:11:13.19,0:11:14.55,Thoughts,Robin,0,0,0,,Usopp!Dialogue: 0,0:11:15.35,0:11:16.96,Thoughts,Robin,0,0,0,,Usopp nereye gitti?!Dialogue: 0,0:11:16.96,0:11:18.96,Thoughts,Robin,0,0,0,,Hadi Usopp!Dialogue: 0,0:11:19.62,0:11:21.33,Thoughts,Robin,0,0,0,,Senden başka kimse kalmadı!Dialogue: 0,0:11:21.93,0:11:24.56,Thoughts,Robin,0,0,0,,İnsana çevir beni!Dialogue: 0,0:11:26.06,0:11:30.17,Main,Sugar,0,0,0,,Bunu bana yedirmeye çalışıyorlardı.Dialogue: 0,0:11:30.17,0:11:31.90,Main,Sugar,0,0,0,,Zehirli kesin.Dialogue: 0,0:11:32.57,0:11:34.34,Main,Sugar,0,0,0,,İğrenç de kokuyor.Dialogue: 0,0:11:35.61,0:11:38.81,Thoughts,Leo,0,0,0,,Gücümüz kalmadı artık...Dialogue: 0,0:11:39.04,0:11:40.19,Flashbacks,Usopp,0,0,0,,Endişelenme!Dialogue: 0,0:11:40.21,0:11:43.68,Flashbacks,Usopp,0,0,0,,Bir şeyler ters gidecek olursa hemen işleri yoluna koyacağım!Dialogue: 0,0:11:44.42,0:11:46.18,Thoughts,Leo,0,0,0,,Usoland...Dialogue: 0,0:11:46.18,0:11:47.45,Main,Usopp,0,0,0,,Kıpırda!Dialogue: 0,0:11:47.45,0:11:49.19,Main,Pirate,0,0,0,,Nereye gidiyorsun ahbap?Dialogue: 0,0:11:51.12,0:11:52.82,Main,Usopp,0,0,0,,Tamamdır, kaçma başarılı!Dialogue: 0,0:11:52.82,0:11:55.03,Main,Usopp,0,0,0,,Kusura bakmayın, Tontatta Kabilesi!Dialogue: 0,0:11:55.03,0:11:58.43,Thoughts,Robin,0,0,0,,Usopp! Neredesin!? Nereye gittin!?Dialogue: 0,0:11:58.43,0:12:03.62,Main,Usopp,0,0,0,,Sahi ya, cesaretinizi resimli bir kitap yazarak gelecek nesillere anlatacağım!Dialogue: 0,0:12:03.62,0:12:06.74,Main,Usopp,0,0,0,,"Dürüst Tontattalar!" Harika oldu bu isim!Dialogue: 0,0:12:06.74,0:12:08.57,Main,Usopp,0,0,0,,Yaşamam lazım benim!Dialogue: 0,0:12:08.57,0:12:11.18,Main,Usopp,0,0,0,,Hem her şey Franky'nin suçu!Dialogue: 0,0:12:11.18,0:12:12.84,Main,Usopp,0,0,0,,Nerede kaldı ki sanki?!Dialogue: 0,0:12:12.84,0:12:17.18,Main,Usopp,0,0,0,,Beni kahraman yapan bir yalan uğruna ölecek değilim!Dialogue: 0,0:12:17.82,0:12:23.56,Main,Usopp,0,0,0,,Tamamdır, kaçtım kaçmasına ama asıl sorun buradan nasıl çıkacağımda!Dialogue: 0,0:12:24.32,0:12:28.69,Main,Usopp,0,0,0,,Geldiğimiz delikten kaçabilmeme imkan yok sanırım.Dialogue: 0,0:12:28.69,0:12:31.46,Main,Usopp,0,0,0,,Sahi ya, asansör var demişti!Dialogue: 0,0:12:31.46,0:12:34.03,Main,Trébol,0,0,0,,Dışarıdakiler!Dialogue: 0,0:12:34.77,0:12:39.00,Main,Trébol,0,0,0,,Siz çalışıyorsunuz di' mi?Dialogue: 0,0:12:39.00,0:12:41.57,Main,Trébol,0,0,0,,Oyun sergilemiyoruz burada, terbiyesizler sizi!Dialogue: 0,0:12:42.37,0:12:43.60,Main,Pirate,0,0,0,,Eyvah!Dialogue: 0,0:12:43.60,0:12:45.31,Main,Pirate,0,0,0,,İşinizin başına dönün!Dialogue: 0,0:12:46.96,0:12:48.15,Secondary,Pirate,0,0,0,,Sandıkları taşımaya devam!Dialogue: 0,0:12:47.65,0:12:49.18,Main,Pirate,0,0,0,,Sallanma!Dialogue: 0,0:12:49.71,0:12:51.98,Main,Pirate,0,0,0,,Acele edin aptallar!Dialogue: 0,0:12:51.98,0:12:56.12,Thoughts,Toy,0,0,0,,Birileri Don Quixote Ailesi'ne karşı gelmeye çalışıyor!Dialogue: 0,0:12:56.12,0:12:59.86,Thoughts,Toy,0,0,0,,Oyuncak olduğum sekiz yılda ilk kez böyle bir şey görüyorum!Dialogue: 0,0:12:59.86,0:13:03.03,Thoughts,Toy,0,0,0,,Kimsin bilmiyorum ama yık bu yeri lütfen!Dialogue: 0,0:13:03.93,0:13:07.67,Main,Usopp,0,0,0,,Gösteri mi?! Göreceğimi gördüm ben!Dialogue: 0,0:13:08.53,0:13:10.50,Main,Sugar,0,0,0,,Bunları ne yapalım?Dialogue: 0,0:13:13.64,0:13:18.54,Main,Trébol,0,0,0,,Baksana baksana, bir şey mi demeye çalışıyor bunlar?Dialogue: 0,0:13:20.08,0:13:21.15,Main,Gnome,0,0,0,,Uso...Dialogue: 0,0:13:21.15,0:13:22.04,Main,Gnome,0,0,0,,... la...Dialogue: 0,0:13:22.04,0:13:23.32,Main,Gnome,0,0,0,,... nd.Dialogue: 0,0:13:24.12,0:13:26.69,Main,Gnome,0,0,0,,... land.Dialogue: 0,0:13:27.52,0:13:29.59,Main,Gnome,0,0,0,,Usoland.Dialogue: 0,0:13:30.99,0:13:32.76,Main,Gnome,0,0,0,,Usola...Dialogue: 0,0:13:33.16,0:13:36.43,Main,Gnome,0,0,0,,Usoland.Dialogue: 0,0:13:36.43,0:13:39.36,Main,Usopp,0,0,0,,Lanet olsun, nerede bu asansör ya?!Dialogue: 0,0:13:39.36,0:13:42.27,Main,Gnome,0,0,0,,Usoland.Dialogue: 0,0:13:42.27,0:13:45.70,Main,Gnome,0,0,0,,Usoland.Dialogue: 0,0:13:46.47,0:13:49.24,Main,Gnome,0,0,0,,Usoland.Dialogue: 0,0:13:49.24,0:13:50.98,Main,Sugar,0,0,0,,"Usoland" mı?Dialogue: 0,0:13:52.38,0:13:54.78,Main,Sugar,0,0,0,,Az önce söylediği isim.Dialogue: 0,0:14:06.60,0:14:08.06,Main,Toy,0,0,0,,Usoland mı?Dialogue: 0,0:13:54.78,0:14:00.79,Main,Gnomes,0,0,0,,Usoland... Usoland...Dialogue: 0,0:13:56.15,0:13:57.32,Main,Leo,0,0,0,,Uso...Dialogue: 0,0:13:58.22,0:14:01.95,Thoughts,Toy,0,0,0,,Usoland!Dialogue: 0,0:14:08.06,0:14:11.30,Thoughts,Usopp,0,0,0,,Çağırmasanıza be!Dialogue: 0,0:14:13.37,0:14:17.60,Main,Trébol,0,0,0,,Usoland mı? O da kimmiş?Dialogue: 0,0:14:17.60,0:14:20.81,Main,Sugar,0,0,0,,Az önce de söylemişlerdi adını, Küçük İnsanlar'ın dostu.Dialogue: 0,0:14:20.81,0:14:22.74,Main,Sugar,0,0,0,,Aptal. Öl.Dialogue: 0,0:14:24.41,0:14:26.04,Main,Trébol,0,0,0,,Ölmeyeceğim lan boklu velet!Dialogue: 0,0:14:30.52,0:14:34.55,Main,Leo,0,0,0,,Usoland bizim kahramanımız!Dialogue: 0,0:14:36.09,0:14:38.39,Main,Trébol,0,0,0,,Kahramanınız mı?Dialogue: 0,0:14:38.39,0:14:41.89,Main,Trébol,0,0,0,,Sizi kurtaracak yani?Dialogue: 0,0:14:41.89,0:14:43.88,Main,Leo,0,0,0,,Evet!Dialogue: 0,0:14:43.88,0:14:46.10,Main,Leo,0,0,0,,Sadece bizi de değil hem!Dialogue: 0,0:14:46.10,0:14:52.07,Main,Leo,0,0,0,,Her şeyi yoluna koyacağını söyledi o!Dialogue: 0,0:14:52.07,0:14:57.78,Main,Leo,0,0,0,,Her gün burada çalışmaya zorlanan oyuncakları da...Dialogue: 0,0:14:57.78,0:15:00.28,Thoughts,Toy,0,0,0,,Ne? Bizi mi diyor?Dialogue: 0,0:15:00.28,0:15:05.28,Main,Leo,0,0,0,,...fabrikada köle gibi çalıştırılan dostlarımızı da...Dialogue: 0,0:15:05.28,0:15:13.79,Main,Leo,0,0,0,,Şehirde yüzlerinde koca bir gülümsemeyle dolaşan fakat içleri kan ağlayan oyuncakları da...Dialogue: 0,0:15:13.79,0:15:20.10,Main,Leo,0,0,0,,...canparelerini yitirmiş olduklarını bile hatırlayamayan ülkenin Büyük İnsanları'nı da...Dialogue: 0,0:15:20.10,0:15:23.97,Main,Leo,0,0,0,,Usoland herkesi kurtaracak olan...Dialogue: 0,0:15:24.34,0:15:27.31,Main,Leo,0,0,0,,...efsanevi kahramanımız!Dialogue: 0,0:15:32.54,0:15:34.95,Thoughts,Usopp,0,0,0,,Kahramanlık falan aman kalsın!Dialogue: 0,0:15:34.95,0:15:37.65,Main,Trébol,0,0,0,,Çok zavallısınız siz yahu!Dialogue: 0,0:15:37.65,0:15:39.82,Main,Trébol,0,0,0,,Bunların hepsi yalan be!Dialogue: 0,0:15:40.95,0:15:44.49,Main,Trébol,0,0,0,,Sizi gene kandırmışlar!Dialogue: 0,0:15:44.49,0:15:46.19,Main,Gnome,0,0,0,,Sahi mi?!Dialogue: 0,0:15:46.19,0:15:51.06,Main,Trébol,0,0,0,,Bu denli yaralanmanıza rağmen yardımınıza geldi mi mesela?Dialogue: 0,0:15:51.09,0:15:52.80,Main,Trébol,0,0,0,,Alın size kanıt!Dialogue: 0,0:15:53.10,0:15:55.70,Main,Trébol,0,0,0,,Nerede hani o kahramanınız?Dialogue: 0,0:15:55.70,0:15:57.60,Main,Trébol,0,0,0,,Hani nerede?Dialogue: 0,0:15:58.50,0:16:01.21,Main,Gnome,0,0,0,,Ama dedi ki...Dialogue: 0,0:16:01.21,0:16:05.91,Main,Trébol,0,0,0,,Siz ahmaklara şimdi bir tarafıyla gülüyordur!Dialogue: 0,0:16:08.51,0:16:11.78,Main,Trébol,0,0,0,,Sizin dürüst olduğunuzu biliyorum...Dialogue: 0,0:16:12.32,0:16:14.85,Main,Trébol,0,0,0,,...o yüzden size her şeyi yoluna koyacağını söyleyen...Dialogue: 0,0:16:14.85,0:16:18.72,Main,Trébol,0,0,0,,...o kişinin yalan olmadığına eminim.Dialogue: 0,0:16:18.72,0:16:20.73,Main,Trébol,0,0,0,,Ondan ümidinizi kesin!Dialogue: 0,0:16:20.73,0:16:23.53,Thoughts,Usopp,0,0,0,,Üzgünüm ama haklı!Dialogue: 0,0:16:23.53,0:16:26.20,Thoughts,Usopp,0,0,0,,Siz de kaçmaya bakın! İyi şanslar!Dialogue: 0,0:16:26.20,0:16:28.20,Main,Gnome,0,0,0,,Olamaz...Dialogue: 0,0:16:35.61,0:16:37.24,Main,Leo,0,0,0,,Kapa çeneni!Dialogue: 0,0:16:37.24,0:16:40.45,Main,Leo,0,0,0,,Usoland yalancı değil!Dialogue: 0,0:16:54.06,0:16:55.49,Main,Leo,0,0,0,,Usoland dedi ki...Dialogue: 0,0:16:56.23,0:16:59.24,Flashbacks,Usopp,0,0,0,,Ben Noland'ın torunuyum!Dialogue: 0,0:16:59.24,0:17:01.87,Flashbacks,Gnomes,0,0,0,,Vay canına!Dialogue: 0,0:17:02.43,0:17:08.54,Main,Leo,0,0,0,,Usoland bize ne olursa olsun bizi mutlaka kurtaracağını söyledi!Dialogue: 0,0:17:08.54,0:17:11.24,Main,Leo,0,0,0,,Böyle söyledi bize!Dialogue: 0,0:17:13.01,0:17:14.25,Main,Gnome,0,0,0,,Evet!Dialogue: 0,0:17:14.25,0:17:15.48,Main,Gnome,0,0,0,,Evet!Dialogue: 0,0:17:15.48,0:17:16.71,Main,Gnome,0,0,0,,Evet!Dialogue: 0,0:17:16.71,0:17:17.92,Main,Gnome,0,0,0,,Evet!Dialogue: 0,0:17:17.92,0:17:18.82,Main,Gnome,0,0,0,,Öyle dedi!Dialogue: 0,0:17:18.82,0:17:25.72,Main,Gnome,0,0,0,,Evet! Evet! Evet!Dialogue: 0,0:17:27.26,0:17:29.83,Main,Gnome,0,0,0,,Bize söz verdi!Dialogue: 0,0:17:29.83,0:17:33.40,Main,Gnome,0,0,0,,Kahramanımız bize yalan söylemez!Dialogue: 0,0:17:34.77,0:17:40.17,Main,Gnome,0,0,0,,Usoland'a daha fazla hakaret edecek olursan hesabını ödersin!Dialogue: 0,0:17:41.11,0:17:44.58,Main,Gnome,0,0,0,,Hazırlansanız iyi edersiniz!Dialogue: 0,0:17:46.11,0:17:48.95,Main,Gnome,0,0,0,,Usoland buraya gelince sizi-Dialogue: 0,0:17:53.12,0:17:56.92,Main,Trébol,0,0,0,,"Pigya" mı dedi o? Ne komikmiş!Dialogue: 0,0:17:56.92,0:17:59.59,Main,Trébol,0,0,0,,Tontattalar'ın çok komik bir ölüm çığlığı var.Dialogue: 0,0:18:00.99,0:18:02.23,Main,Bobomba,0,0,0,,Leo!Dialogue: 0,0:18:02.23,0:18:05.56,Main,Inhel,0,0,0,,Doğru! SOP Operasyonunu...Dialogue: 0,0:18:05.56,0:18:09.00,Main,Inhel,0,0,0,,Usoland mutlaka başarıyla sonuçlandıracaktır!Dialogue: 0,0:18:12.87,0:18:13.94,Main,Gnome,0,0,0,,Evet!Dialogue: 0,0:18:15.24,0:18:17.58,Main,Gnome,0,0,0,,Asıl zavallı olan sizlersiniz!Dialogue: 0,0:18:21.65,0:18:24.48,Main,Trébol,0,0,0,,Çağırsanıza o zaman hadi şu...Dialogue: 0,0:18:25.85,0:18:27.69,Thoughts,Toy,0,0,0,,Eyvah, çok kötü bir şeyler oluyor.Dialogue: 0,0:18:30.39,0:18:33.76,Main,Usopp,0,0,0,,Yapmayın!Dialogue: 0,0:18:34.63,0:18:39.03,Main,Usopp,0,0,0,,Yeter be!Dialogue: 0,0:18:44.30,0:18:45.70,Main,Gnomes,0,0,0,,Usoland!Dialogue: 0,0:18:45.70,0:18:48.41,Main,Gnomes,0,0,0,,Usoland!Dialogue: 0,0:18:48.87,0:18:49.97,Thoughts,Robin,0,0,0,,Usopp!Dialogue: 0,0:18:49.97,0:18:50.98,Thoughts,Robin,0,0,0,,Şükürler olsun!Dialogue: 0,0:18:52.21,0:18:58.48,Main,Usopp,0,0,0,,Bana nasıl bu kadar güvenebiliyorsunuz be?! Küçük ahmaklar sizi!Dialogue: 0,0:19:00.12,0:19:03.39,Main,Usopp,0,0,0,,Onun da dediği gibi, her şey yalandı!Dialogue: 0,0:19:05.02,0:19:10.80,Main,Usopp,0,0,0,,Efsanevi kahraman falan değilim, hem zaten Usoland da adım değil!Dialogue: 0,0:19:13.60,0:19:18.37,Main,Usopp,0,0,0,,Ben Hasır Şapka tayfasının keskin mi keskin keskin nişancısı...Dialogue: 0,0:19:18.37,0:19:20.47,Main,Usopp,0,0,0,,...Usopp'um!Dialogue: 0,0:19:20.47,0:19:23.17,Main,Usopp,0,0,0,,Korsanım!Dialogue: 0,0:19:23.17,0:19:25.52,Thoughts,Toy,0,0,0,,Hasır Şapka taydasından mı...Dialogue: 0,0:19:25.52,0:19:27.28,Thoughts,Toy,0,0,0,,Burada ne arıyor?!Dialogue: 0,0:19:35.42,0:19:37.02,Main,Leo,0,0,0,,Neden...Dialogue: 0,0:19:38.12,0:19:41.33,Main,Leo,0,0,0,,Neden böyle diyorsun?!Dialogue: 0,0:19:44.53,0:19:50.20,Main,Leo,0,0,0,,Korsan olabilirsin ama aynı zamanda kahramansın da değil mi?Dialogue: 0,0:19:50.20,0:19:52.37,Main,Usopp,0,0,0,,Kahraman falan değilim diyorum size!Dialogue: 0,0:19:52.37,0:19:54.34,Main,Usopp,0,0,0,,Korsandan başka bir şey değiilim!Dialogue: 0,0:19:56.27,0:19:58.44,Main,Usopp,0,0,0,,İkide bir söyletmeyin aynı şeyi!Dialogue: 0,0:19:58.44,0:20:01.65,Main,Usopp,0,0,0,,Kandırdım işte sizi!Dialogue: 0,0:20:01.65,0:20:05.12,Main,Usopp,0,0,0,,Sizse bir an olsun bana inanmayı bırakmadınız!Dialogue: 0,0:20:14.19,0:20:20.83,Main,Trébol,0,0,0,,Yani şimdi sen ta buralara kadar onları kandırdığını söylemeye mi geldin?Dialogue: 0,0:20:22.23,0:20:26.47,Main,Usopp,0,0,0,,Evet yoksa bunlar ölene dek bana inanmaya devam edeceklerdi!Dialogue: 0,0:20:26.47,0:20:29.91,Main,Usopp,0,0,0,,Böyle bir şeyi bilerek uykusuz geçecek gecelerin aksine...Dialogue: 0,0:20:30.58,0:20:34.08,Main,Usopp,0,0,0,,...bana bu denli inanan onlara...Dialogue: 0,0:20:34.58,0:20:37.59,Main,Usopp,0,0,0,,...hayatım pahasına da olsa teşekkür etmeye...Dialogue: 0,0:20:37.61,0:20:40.62,Main,Usopp,0,0,0,,...gelmemin çok daha havalı olacağını düşündüm!Dialogue: 0,0:20:42.95,0:20:45.24,Main,Usopp,0,0,0,,Adım Usopp!Dialogue: 0,0:20:45.24,0:20:47.89,Main,Usopp,0,0,0,,Bunu sakın unutmayın Tontattalar!Dialogue: 0,0:20:47.89,0:20:54.10,Main,Usopp,0,0,0,,Burada ölecek olursam Noland'ın yanına heykelimi dikin!Dialogue: 0,0:20:54.10,0:20:59.34,Main,Usopp,0,0,0,,Efsanevi kahramanınız olmak üzereyim!Dialogue: 0,0:21:03.21,0:21:05.08,Main,Leo,0,0,0,,Usopp!Dialogue: 0,0:21:05.68,0:21:08.31,Thoughts,Toy,0,0,0,,Hasır Şapka tayfasından Usopp...Dialogue: 0,0:21:08.31,0:21:12.32,Thoughts,Toy,0,0,0,,Kurtarıcımız o mu olacak acaba?!Dialogue: 0,0:21:16.35,0:21:17.49,Main,Trébol,0,0,0,,Umutsuz vakasın resmen!Dialogue: 0,0:21:17.49,0:21:19.22,Main,Usopp,0,0,0,,Ya batacak ya çıkacağız!Dialogue: 0,0:21:19.22,0:21:24.16,Main,Usopp,0,0,0,,Özel Saldırı Yeşil Yıldız Platanus...Dialogue: 0,0:21:27.17,0:21:28.23,Main,Usopp,0,0,0,,...Shuriken!Dialogue: 0,0:21:40.88,0:21:42.81,Main,Usopp,0,0,0,,Beğendin mi bunu yaratık!Dialogue: 0,0:21:42.81,0:21:50.49,Main,Usopp,0,0,0,,Ben efsanevi kahraman, Hasır Şapka tayfasının keskin nişancısı, Kaptan Usopp'um!Dialogue: 0,0:21:50.49,0:21:52.72,Main,Gnomes,0,0,0,,Usoland!Dialogue: 0,0:21:52.72,0:21:54.29,Main,Usopp,0,0,0,,Usopp diyorum!Dialogue: 0,0:21:54.29,0:21:56.26,Main,Gnomes,0,0,0,,Usoland!Dialogue: 0,0:21:56.26,0:21:58.63,Main,Usopp,0,0,0,,Usopp diyorum be size!Dialogue: 0,0:21:58.63,0:22:04.10,Main,Gnomes,0,0,0,,Efsanevi kahramanımız, Usoland!Dialogue: 0,0:22:05.80,0:22:09.01,Captions,Caption,0,0,240,,Royal Palace, 2.Kat Taht OdasıDialogue: 0,0:22:05.77,0:22:08.54,Main,Grunt,0,0,0,,Genç Bey'imize benzeyen birinin burada olduğu anlamına mı geliyor bu?Dialogue: 0,0:22:10.98,0:22:14.85,Main,Doflamingo,0,0,0,,Sarayda bana benzeyen birini gördünüz mü daha önce?Dialogue: 0,0:22:14.85,0:22:16.48,Thoughts,Thunder Soldier,0,0,0,,Kral Riku-sama!Dialogue: 0,0:22:18.52,0:22:20.42,Thoughts,Thunder Soldier,0,0,0,,Bu kılıç güzele benziyor.Dialogue: 0,0:22:20.42,0:22:23.82,Thoughts,Thunder Soldier,0,0,0,,Normale dönebilirsem bunu kullanacağım!Dialogue: 0,0:22:23.82,0:22:27.73,Main,Violet,0,0,0,,Babam bugün kolezyumda savaşıyordu.Dialogue: 0,0:22:27.73,0:22:29.73,Main,Luffy,0,0,0,,Ne? Hadi ya?Dialogue: 0,0:22:29.73,0:22:33.80,Main,Violet,0,0,0,,Doflamingo'nun tahttan çekilme haberinin yalan çıkması...Dialogue: 0,0:22:35.07,0:22:38.47,Main,Violet,0,0,0,,...hepimizin sabrını yitirmesine yol açtı.Dialogue: 0,0:22:38.97,0:22:42.44,Thoughts,Thunder Soldier,0,0,0,,Kral Riku-sama kolezyumda mı savaşmış?!Dialogue: 0,0:22:45.81,0:22:47.68,Main,Guard,0,0,0,,Çocuğun biri cinayet işlemiş!Dialogue: 0,0:22:47.68,0:22:51.92,Main,Guard,0,0,0,,Gecekondu mahallesinde çıkan kavgada iki kişi ölmüş!Dialogue: 0,0:23:02.36,0:23:07.47,Captions,Caption,0,0,240,,Gecekondu Mahallesinde Bir Çocuk Kyros (15 Yaşında)Dialogue: 0,0:23:10.84,0:23:11.94,Main,Guard,0,0,0,,Kral Riku-sama!Dialogue: 0,0:23:11.94,0:23:14.47,Main,Guard,0,0,0,,Kral Riku-sama, ne yapıyorsunuz?!Dialogue: 0,0:23:14.47,0:23:15.47,Main,Guard,0,0,0,,Tehlikeli biri o!Dialogue: 0,0:23:15.47,0:23:20.11,Main,Guard,0,0,0,,Çocuk gibi görünebilir fakat ünlü bir hayduttur!Dialogue: 0,0:23:24.48,0:23:26.68,Main,Guard,0,0,0,,Kral tehlike altında! Ateş edin!Dialogue: 0,0:23:26.68,0:23:28.65,Main,Riku,0,0,0,,Durun, ateş etmeyin!Dialogue: 0,0:23:28.65,0:23:29.75,Main,Riku,0,0,0,,İndirin silahlarınızı!Dialogue: 0,0:23:30.52,0:23:32.22,Main,Guard,0,0,0,,Fa-Fakat...Dialogue: 0,0:23:32.22,0:23:39.18,Main,Riku,0,0,0,,Onlarca serseriyle bir başına savaşıp...Dialogue: 0,0:23:39.18,0:23:45.27,Main,Riku,0,0,0,,...pek çoğunu yaraladığını,  ikisini de öldürdüğünü duydum.Dialogue: 0,0:23:45.27,0:23:49.77,Main,Kyros,0,0,0,,Hepsi bir olup arkadaşımı öldürdüler!Dialogue: 0,0:23:49.77,0:23:52.14,Main,Kyros,0,0,0,,Onun intikamını alıyorum ben!Dialogue: 0,0:23:53.28,0:23:55.28,Main,Riku,0,0,0,,Canavar mısın sen?Dialogue: 0,0:23:55.28,0:24:00.02,Main,Kyros,0,0,0,,Ne dersen de! Senin gibi asilzadenin teki ne bilecek!?Dialogue: 0,0:24:00.02,0:24:03.55,Main,Kyros,0,0,0,,Bu dünyada tek güvendiğim insandı o!Dialogue: 0,0:24:04.26,0:24:06.99,Main,Kyros,0,0,0,,Kardeşimden farksızdı benim için!Dialogue: 0,0:24:08.93,0:24:10.93,Main,Riku,0,0,0,,Adın Kyros değil mi?Dialogue: 0,0:24:11.43,0:24:13.60,Main,Riku,0,0,0,,Benimle gel!Dialogue: 0,0:24:17.17,0:24:19.50,Main,Announcer,0,0,0,,On beş yaşındaki katil Kyros!Dialogue: 0,0:24:18.34,0:24:25.31,Captions,Caption,0,0,0,,Corrida KolezyumuDialogue: 0,0:24:19.50,0:24:22.72,Main,Announcer,0,0,0,,Tecrübeli bir gladyatörle savaşacak!Dialogue: 0,0:24:22.72,0:24:25.33,Main,Crowd,0,0,0,,Kolezyum kutsal mekandır!Dialogue: 0,0:24:29.65,0:24:34.39,Main,Guard,0,0,0,,Ne yetenek ama! Kılıcı kör olmasaydı rakibini öldürecekti!Dialogue: 0,0:24:34.39,0:24:38.19,Main,Riku,0,0,0,,Barbarlık o arenaya çıkınca yetenek oluveriyor birden demek?Dialogue: 0,0:24:38.79,0:24:42.30,Main,Guard,0,0,0,,Kaldığı odadaki neredeyse tüm gladyatörleri öldüresiye dövdü.Dialogue: 0,0:24:42.30,0:24:47.10,Main,Guard,0,0,0,,Altı gündür hiçbir şey yemedi  ve tek söylediği şey "Kral Riku'yu çağırın." oldu.Dialogue: 0,0:24:47.10,0:24:50.60,Main,Kyros,0,0,0,,Kral Riku, bana ne yapacaksın?!Dialogue: 0,0:24:50.60,0:24:55.04,Main,Guard,0,0,0,,Kral Riku-sama kaç sene sürerse sürsün...Dialogue: 0,0:24:55.04,0:24:58.54,Main,Guard,0,0,0,,...yüz oyunda galip gelebilirsen seni serbest bırakmayı planlıyor.Dialogue: 0,0:24:58.64,0:25:01.88,Captions,Caption,0,0,175,,Dört Ay SonraDialogue: 0,0:25:04.68,0:25:07.59,Main,Announcer,0,0,0,,Kyros yaptığı yüz maçtan yüzünü de kazandı!Dialogue: 0,0:25:07.59,0:25:11.31,Main,Announcer,0,0,0,,Yıldız gladyatör bile karşısında kılıcını konuşturamadı!Dialogue: 0,0:25:11.33,0:25:14.23,Main,Announcer,0,0,0,,Kyros çok kısa sürede özgürlüğüne kavuştu!Dialogue: 0,0:25:14.99,0:25:17.30,Main,Crowd,0,0,0,,Seni dışarıda istemiyoruz katil!Dialogue: 0,0:25:19.46,0:25:21.17,Main,Riku,0,0,0,,Dışarı çıkmak istemiyor musun?Dialogue: 0,0:25:21.17,0:25:24.00,Main,Kyros,0,0,0,,İstenmediğim yere gitmem ben!Dialogue: 0,0:25:25.27,0:25:28.84,Main,Riku,0,0,0,,Ne ara insanların istediği biri olmayı arzular oldun?Dialogue: 0,0:25:28.84,0:25:30.11,Main,Kyros,0,0,0,,Kapa çeneni!Dialogue: 0,0:25:34.88,0:25:36.15,Thoughts,Kyros,0,0,0,,Canavarlar...Dialogue: 0,0:25:37.28,0:25:39.02,Thoughts,Kyros,0,0,0,,...kafeste oldukları müddetçe...Dialogue: 0,0:25:40.02,0:25:41.39,Thoughts,Kyros,0,0,0,,...sevilirler!Dialogue: 0,0:25:46.19,0:25:48.29,Main,Announcer,0,0,0,,200. galibiyeti!Dialogue: 0,0:25:48.29,0:25:50.32,Main,Crowd,0,0,0,,Birileri Kyros'u yensin artık!Dialogue: 0,0:25:50.32,0:25:52.03,Main,Crowd,0,0,0,,Kyros'u yenin!Dialogue: 0,0:25:55.07,0:25:57.30,Main,Announcer,0,0,0,,300. galibiyeti!Dialogue: 0,0:25:57.30,0:26:02.31,Main,Announcer,0,0,0,,Kyros'u kimse durduramaz! Kahramanlar karşısında birbiri ardına devriliyor!Dialogue: 0,0:26:06.21,0:26:08.66,Main,Announcer,0,0,2,,Sonunda! Sonunda...Dialogue: 0,0:26:08.11,0:26:12.38,Captions,Caption,0,0,240,,Kolezyumda 4. YılıDialogue: 0,0:26:08.66,0:26:12.82,Main,Announcer,0,0,2,,...eşi görülmemiş 1000. galibiyetini kazanıyor!Dialogue: 0,0:26:12.82,0:26:14.42,Main,Crowd,0,0,0,,Kyros-sama!Dialogue: 0,0:26:14.42,0:26:16.32,Main,Crowd,0,0,0,,Aynen böyle, Kyros!Dialogue: 0,0:26:24.90,0:26:26.33,Main,Riku,0,0,0,,Gene buradasın demek?Dialogue: 0,0:26:26.33,0:26:27.50,Main,Kyros,0,0,0,,Uzak dur benden!Dialogue: 0,0:26:29.03,0:26:31.04,Main,Kyros,0,0,0,,Anlayamazsın!Dialogue: 0,0:26:31.50,0:26:37.91,Main,Kyros,0,0,0,,Nereye gidersem gideyim cinayet işlemiş bir canavar olacağım hep!Dialogue: 0,0:26:40.55,0:26:42.93,Main,Kyros,0,0,0,,Keşke...Dialogue: 0,0:26:42.93,0:26:45.28,Main,Kyros,0,0,0,,...herkes...Dialogue: 0,0:26:45.28,0:26:48.39,Main,Kyros,0,0,0,,...beni unutsa!