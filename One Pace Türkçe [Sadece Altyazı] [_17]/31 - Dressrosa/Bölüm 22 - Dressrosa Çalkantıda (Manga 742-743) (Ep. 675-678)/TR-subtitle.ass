Dialogue: 0,0:01:33.77,0:01:39.91,Main,Announcer,0,0,0,,Birden ün kazanmış gizemli ve güçlü Ricky\NKyros'un karşısında!
Dialogue: 0,0:01:41.95,0:01:43.68,Main,Announcer,0,0,0,,Kazanan Kyros!
Dialogue: 0,0:01:43.68,0:01:47.52,Main,Announcer,0,0,0,,Dokuz senede yaptığı 3000 müsabakadan\N3000'ini de kazandı!
Dialogue: 0,0:01:47.52,0:01:53.39,Main,Announcer,0,0,0,,Yaşayan efsane Kyros! Yenilmez kelimesi\Nbu adamın ardından bulunmuş sanki!
Dialogue: 0,0:01:53.39,0:01:56.50,Main,Kyros,0,0,0,,Neden gizlice katıldınız,...
Dialogue: 0,0:01:56.50,0:01:57.63,Main,Kyros,0,0,0,,...Kral Riku-sama?!
Dialogue: 0,0:01:59.13,0:02:04.17,Main,Riku,0,0,0,,Bana dövüşmeyi öğretmenin ardından\Nepey güçlenmişim değil mi?
Dialogue: 0,0:02:04.17,0:02:09.68,Main,Riku,0,0,0,,Benim kim olduğumu anlayınca dikkatin dağıldı gerçi. \NÖyle düşündüğün gibi bir "canavar" değilsin anlaşılan.
Dialogue: 0,0:02:10.81,0:02:12.68,Main,Riku,0,0,0,,Yetmez mi bu kadar?
Dialogue: 0,0:02:13.48,0:02:19.85,Main,Riku,0,0,0,,Dokuz yılını, hayatını\Nbu kafeste kilitli geçirdin.
Dialogue: 0,0:02:16.46,0:02:21.69,Title,,0,0,430,,{\fad(1500,0)}Dressrosa Çalkantıda
Dialogue: 0,0:02:21.20,0:02:24.66,Main,Riku,0,0,0,,Çıkma vakti artık.\NYapmanı istediğim bir iş var.
Dialogue: 0,0:02:25.29,0:02:31.93,Main,Riku,0,0,0,,Kyros, geçmişte yaptıklarından pişmanlık duymaktansa \Nşu günden sonra pek çok canlar kurtarabilirsin.
Dialogue: 0,0:02:31.93,0:02:34.03,Main,Riku,0,0,0,,Bu da hayatta seçebileceğin yollardan\Nbiri kendine.
Dialogue: 0,0:02:37.37,0:02:38.60,Main,Kyros,0,0,0,,Emredersiniz!
Dialogue: 0,0:02:47.18,0:02:49.52,Main,Crowd,0,0,2,,Kyros, sana güveniyoruz!
Dialogue: 0,0:02:47.28,0:02:50.82,Captions,Caption,0,0,175,,{\fad(467,233)}Bir Yıl Sonra
Dialogue: 0,0:02:49.52,0:02:52.42,Main,Crowd,0,0,2,,Kyros, yaptıkların için teşekkür ederiz!
Dialogue: 0,0:02:52.08,0:02:56.59,Captions,Caption,0,0,240,,{\fad(1001,0)}Dressrosa Kral Riku Ordusu Komutanı\NKyros (25 Yaşında)
Dialogue: 0,0:02:56.59,0:02:58.92,Main,Crowd,0,0,0,,{\i1}Ay Kyros-sama!
Dialogue: 0,0:03:00.99,0:03:04.70,Main,Scarlett,0,0,0,,Kızların göz bebeğisin anlaşılan\NKyros-sama!
Dialogue: 0,0:03:04.70,0:03:07.37,Main,Scarlett,0,0,0,,Ama unutma ki sen bir katilsin!
Dialogue: 0,0:03:07.37,0:03:12.47,Main,Scarlett,0,0,0,,Babamın saraya girmene izin vermesini\Naklım hayalim almıyor resmen!
Dialogue: 0,0:03:12.47,0:03:13.92,Main,Guard,0,0,0,,{\i1}Prensesimiz!
Dialogue: 0,0:03:13.92,0:03:16.88,Main,Violet,0,0,0,,Abla olmaz ama!\NGeçmişin yaralarını böyle deşemezsin!
Dialogue: 0,0:03:16.88,0:03:21.11,Main,Scarlett,0,0,0,,Üstüne üstlük adalet ordusunun başına\Nseni geçirmesineyse hiç anlam veremiyorum!
Dialogue: 0,0:03:21.11,0:03:22.51,Main,Violet,0,0,0,,Abla!
Dialogue: 0,0:03:22.51,0:03:26.82,Main,Scarlett,0,0,0,,{\an8}Tüm ülkeyi kandırsan da\Nbeni kandıramazsın!
Dialogue: 0,0:03:25.48,0:03:34.43,Captions,Caption,0,0,240,,{\fad(2002,0)}Dressrosa Prensesi\NScarlet (15 Yaşında)
Dialogue: 0,0:03:26.82,0:03:28.95,Main,Scarlett,0,0,2,,{\an8}Günün birinde \Ngerçek rengini göstereceksin!
Dialogue: 0,0:03:28.95,0:03:34.43,Main,Scarlett,0,0,2,,{\an8}Ne benim ne de kız kardeşimin\Nyanına yaklaşma! Bize dokunma!
Dialogue: 0,0:03:35.43,0:03:38.60,Main,Violet,0,0,2,,Ama abla, o birazcık...
Dialogue: 0,0:03:35.53,0:03:39.30,Captions,Caption,0,0,240,,{\fad(500,0)}İkinci Prenses (Küçük Kardeş)\NViola (10 Yaşında)
Dialogue: 0,0:03:38.60,0:03:40.67,Main,Scarlett,0,0,2,,Bakma!
Dialogue: 0,0:03:41.10,0:03:42.77,Main,Scarlett,0,0,0,,Öyle çarpık bir zihni görmek istemezsin!
Dialogue: 0,0:03:42.77,0:03:45.77,Main,Kyros,0,0,0,,Fakat sizi korumak benim görevim!
Dialogue: 0,0:03:45.77,0:03:47.51,Main,Scarlett,0,0,0,,İstemez kalsın!
Dialogue: 0,0:03:50.08,0:03:52.36,Main,Guard,0,0,0,,Scarlet-sama kaçırıldı!
Dialogue: 0,0:03:52.36,0:03:53.44,Main,Guard,0,0,0,,Korsanlar!
Dialogue: 0,0:03:53.44,0:03:54.78,Main,Guard,0,0,0,,Muhafızlara ne oldu?
Dialogue: 0,0:03:54.78,0:03:56.08,Main,Guard,0,0,0,,Hepsi de yenildi!
Dialogue: 0,0:03:57.08,0:03:58.45,Main,Guard,0,0,0,,Olamaz!
Dialogue: 0,0:04:07.06,0:04:09.23,Main,Kyros,0,0,0,,Özür dilerim!
Dialogue: 0,0:04:11.16,0:04:12.93,Main,Kyros,0,0,0,,İstemeden size dokundum!
Dialogue: 0,0:04:14.20,0:04:18.47,Main,Scarlett,0,0,0,,Kyros, çok korktum!
Dialogue: 0,0:04:19.57,0:04:22.51,Main,Kyros,0,0,0,,Özür dilerim!\NÖzür dilerim!
Dialogue: 0,0:04:27.48,0:04:29.68,Main,Violet,0,0,0,,Ablam bir şeyler pişiriyor!
Dialogue: 0,0:04:29.68,0:04:31.78,Main,Riku,0,0,0,,Kafasını falan mı vurdu acaba?!
Dialogue: 0,0:04:33.85,0:04:35.12,Main,Kyros,0,0,0,,Şey...
Dialogue: 0,0:04:43.80,0:04:48.07,Main,Riku,0,0,0,,Ne dedin?! Kızlarımın korumalığından\Nistifa mı etmek istiyorsun?!
Dialogue: 0,0:04:48.07,0:04:51.10,Main,Riku,0,0,0,,Scarlet'e aşık mısın yoksa?
Dialogue: 0,0:04:51.10,0:04:51.94,Main,Kyros,0,0,0,,Ne?!
Dialogue: 0,0:04:51.94,0:04:54.57,Main,Kyros,0,0,0,,Hayır!\NKatiyen öyle bir şey yok...
Dialogue: 0,0:04:54.57,0:05:04.06,Main,Riku,0,0,0,,Evlenmenize herkesin mutlu olacağına eminim fakat sosyal zorunluluklar suçlu geçmişine izin vermeyecektir.
Dialogue: 0,0:05:04.06,0:05:06.69,Main,Riku,0,0,0,,Herkese açık bir hayat yaşamak böyle işte.
Dialogue: 0,0:05:06.69,0:05:12.46,Main,Scarlett,0,0,0,,Baba, onunla evlenemeyeceksem\Nölmeyi yeğlerim!
Dialogue: 0,0:05:22.67,0:05:24.32,Main,Crowd,0,0,0,,Scarlet-sama!
Dialogue: 0,0:05:24.32,0:05:29.01,Main,Crowd,0,0,0,,Çok ani bir hastalığa yakalandı. \NOysaki günün birinde harika bir kraliçe olacaktı.
Dialogue: 0,0:05:32.85,0:05:37.68,Main,Riku,0,0,0,,Scarlet, bugünden böyle\Nkraliyet ailesinin bir parçası değilsin.
Dialogue: 0,0:05:38.05,0:05:40.92,Main,Riku,0,0,0,,İnsanlar seni öldü bilecek.
Dialogue: 0,0:05:40.92,0:05:42.22,Main,Scarlett,0,0,0,,Peki.
Dialogue: 0,0:05:43.92,0:05:47.33,Main,Kyros,0,0,0,,İyiliğinize daha da fazla nankörlükle\Nkarşılık veriyorum gibi, Kral Riku-sama.
Dialogue: 0,0:05:47.33,0:05:49.83,Main,Riku,0,0,0,,Affedilemez bir davranış!
Dialogue: 0,0:05:50.66,0:05:53.27,Main,Riku,0,0,0,,Olurdu eğer yerinde başkası olsaydı!
Dialogue: 0,0:05:53.27,0:05:56.74,Main,Riku,0,0,0,,Kyros, böyle bir şey ne duydum ne gördüm!
Dialogue: 0,0:06:04.46,0:06:06.35,Main,Scarlett,0,0,0,,Adı Rebecca.
Dialogue: 0,0:06:07.15,0:06:09.78,Main,Scarlett,0,0,0,,Kyros, kucağına al haydi.
Dialogue: 0,0:06:09.78,0:06:11.38,Main,Scarlett,0,0,0,,Kızın o senin.
Dialogue: 0,0:06:13.15,0:06:15.45,Main,Kyros,0,0,0,,Öyle günahsız bir şeye dokunamam ben!
Dialogue: 0,0:06:15.45,0:06:19.36,Main,Kyros,0,0,0,,Kirlenmiş eller benimkiler!\NOnu da kirletmek istemem!
Dialogue: 0,0:06:21.33,0:06:23.70,Main,Scarlett,0,0,0,,Baban ne tuhaf biri değil mi, Rebecca?
Dialogue: 0,0:06:26.60,0:06:29.17,Main,Kyros,0,0,0,,Melek gibisin sanki, Rebecca!
Dialogue: 0,0:06:29.76,0:06:33.71,Main,Kyros,0,0,0,,Seni koruyacak,\Nhep yanında olacağım!
Dialogue: 0,0:06:36.18,0:06:37.98,Main,Riku,0,0,0,,Deden geldi!
Dialogue: 0,0:06:37.98,0:06:39.52,Main,Rebecca,0,0,0,,Dede!
Dialogue: 0,0:06:39.52,0:06:42.56,Main,Riku,0,0,0,,Rebecca, kocaman olmuşsun!
Dialogue: 0,0:06:42.56,0:06:45.25,Main,Scarlett,0,0,0,,Baba, çıkar yüzündeki maskeyi artık!
Dialogue: 0,0:06:45.25,0:06:46.55,Main,Riku,0,0,0,,Kyros.
Dialogue: 0,0:06:46.55,0:06:48.35,Main,Kyros,0,0,0,,Eldivenler!
Dialogue: 0,0:06:48.65,0:06:51.36,Main,Kyros,0,0,0,,Ne şirin! Ne şirin!
Dialogue: 0,0:06:52.16,0:06:53.66,Main,Scarlett,0,0,0,,Şuna bak yine ağlıyor!
Dialogue: 0,0:07:08.17,0:07:10.81,Main,Scarlett,0,0,0,,Saray alevler içinde!
Dialogue: 0,0:07:11.54,0:07:14.08,Main,Scarlett,0,0,0,,Bu ülkeye neler oluyor?
Dialogue: 0,0:07:14.08,0:07:18.18,Main,Kyros,0,0,0,,Ben saraya gidiyorum,\Ntamam mı Scarlet, Rebecca?
Dialogue: 0,0:07:18.18,0:07:19.45,Main,Rebecca,0,0,0,,Baba!
Dialogue: 0,0:07:19.45,0:07:23.92,Main,Kyros,0,0,0,,Burada herhângi bir tehlike sezerseniz\NKızıl Çiçek Bahçesi'ne gidip bekleyin beni!
Dialogue: 0,0:07:23.92,0:07:26.12,Main,Kyros,0,0,0,,Ne pahasına olursa olsun\Nsizi almaya geleceğim!
Dialogue: 0,0:07:33.23,0:07:34.67,Main,Kyros,0,0,0,,Lanet olsun!
Dialogue: 0,0:07:37.97,0:07:41.67,Main,Kyros,0,0,0,,Bu ülkeye ve krala\Nne yaptın söyle, lanet korsan!
Dialogue: 0,0:07:41.67,0:07:45.28,Main,Doflamingo,0,0,0,,Kral şehri aleve verdi, görmedin mi?
Dialogue: 0,0:07:46.31,0:07:48.95,Main,Kyros,0,0,0,,Kral asla öyle bir şey yapmaz!
Dialogue: 0,0:07:48.95,0:07:50.95,Main,Riku,0,0,0,,Kyros!
Dialogue: 0,0:07:52.99,0:07:57.59,Main,Kyros,0,0,0,,Çöz bu Kairouseki'den zincirleri!\NGüç kullanıcısı değilim!
Dialogue: 0,0:07:57.59,0:08:01.56,Main,Doflamingo,0,0,0,,Kyros, seninle ilgili\Nkulağıma güzel şeyler çalındı.
Dialogue: 0,0:08:02.16,0:08:04.86,Main,Doflamingo,0,0,0,,Benim için çalışmaya başla.
Dialogue: 0,0:08:04.86,0:08:09.37,Main,Doflamingo,0,0,0,,Kral tahtından edildi ve\Nkraliyet ailesinin tüm üyeleri ölecekler!
Dialogue: 0,0:08:09.37,0:08:16.34,Main,Doflamingo,0,0,0,,Kraliyet ailesinin parçası olan karınla kızını bulmaları için çoktan adamlarımı yolladım bile!
Dialogue: 0,0:08:17.68,0:08:20.20,Main,Doflamingo,0,0,0,,İzle bak şimdi!
Dialogue: 0,0:08:20.20,0:08:24.92,Main,Doflamingo,0,0,0,,Kral Riku'nun yönettiği Dressrosa'nın\Nsonu geldi artık!
Dialogue: 0,0:08:29.96,0:08:33.09,Main,Doflamingo,0,0,0,,Kendi bacağını kesti!
Dialogue: 0,0:08:33.09,0:08:34.03,Main,Riku,0,0,0,,Kyros!
Dialogue: 0,0:08:50.11,0:08:51.61,Main,Riku,0,0,0,,Oyuncak mı?
Dialogue: 0,0:08:55.51,0:08:59.12,Main,Buffalo,0,0,0,,Oyuncak kralı omuzlayıp kaçtı-dasuyan!
Dialogue: 0,0:08:59.99,0:09:01.59,Thoughts,Kyros,0,0,0,,{\i1}Oyuncağa dönüştüm?!{\i0}
Dialogue: 0,0:09:01.59,0:09:04.72,Thoughts,Kyros,0,0,0,,{\i1}Nasıl bir hâl bu?! \NHayal mi görüyorum?!{\i0}
Dialogue: 0,0:09:08.43,0:09:10.93,Main,Kyros,0,0,0,,Kyros'um ben, Kral Riku-sama!
Dialogue: 0,0:09:10.93,0:09:14.60,Main,Riku,0,0,0,,Özür dilerim, hiç hatırlayamadım ama...
Dialogue: 0,0:09:16.47,0:09:21.11,Main,Riku,0,0,0,,...benim için yaptıklarını unutmayacağım,\Ntuhaf oyuncak.
Dialogue: 0,0:09:21.77,0:09:25.68,Main,Kyros,0,0,0,,Kaç! Scarlet, Rebecca!
Dialogue: 0,0:09:25.68,0:09:28.55,Main,Kyros,0,0,0,,Sözleştiğimiz yerde bekleyin beni!
Dialogue: 0,0:09:32.95,0:09:36.22,Thoughts,Kyros,0,0,0,,{\i1}Herkes unuttu mu beni?!{\i0}
Dialogue: 0,0:09:40.83,0:09:43.70,Thoughts,Kyros,0,0,0,,{\i1}Kızıl Çiçek Bahçesi'ne ulaşmam lazım!{\i0}
Dialogue: 0,0:09:43.70,0:09:45.95,Thoughts,Kyros,0,0,0,,{\i1}Scarlet'le Rebecca beni bekliyorlar!{\i0}
Dialogue: 0,0:09:55.64,0:09:57.58,Thoughts,Kyros,0,0,0,,{\i1}Scarlet?!{\i0}
Dialogue: 0,0:10:01.08,0:10:03.22,Main,Kyros,0,0,0,,Scarlet!
Dialogue: 0,0:10:09.96,0:10:11.69,Main,Kyros,0,0,0,,Scarlet!
Dialogue: 0,0:10:21.27,0:10:22.70,Main,Citizen,0,0,0,,Birileri vuruldu!
Dialogue: 0,0:10:22.70,0:10:24.57,Main,Citizen,0,0,0,,Gene Kral Riku ordusunun işi mi?!
Dialogue: 0,0:10:25.74,0:10:30.44,Thoughts,Kyros,0,0,0,,{\i1}Neden?!\NNeden beni beklemedin?!{\i0}
Dialogue: 0,0:10:35.88,0:10:37.28,Thoughts,Kyros,0,0,0,,{\i1}Şimdi anlıyorum...{\i0}
Dialogue: 0,0:10:39.62,0:10:42.92,Thoughts,Kyros,0,0,0,,{\i1}Verdiğimiz sözler\Nve yaşadıklarımızla beraber...{\i0}
Dialogue: 0,0:10:44.92,0:10:46.39,Thoughts,Kyros,0,0,0,,{\i1}...senin de...{\i0}
Dialogue: 0,0:10:47.63,0:10:49.26,Thoughts,Kyros,0,0,0,,{\i1}...aklından kayıp gittim demek?!{\i0}
Dialogue: 0,0:10:55.53,0:10:57.54,Main,Kyros,0,0,0,,Scarlet!
Dialogue: 0,0:10:59.87,0:11:02.77,Main,Kyros,0,0,0,,Scarlet, dayan lütfen!
Dialogue: 0,0:11:02.77,0:11:06.21,Main,Kyros,0,0,0,,Scarlet! Scarlet!
Dialogue: 0,0:11:08.98,0:11:11.25,Main,Kyros,0,0,0,,Scarlet!\NDayan lütfen!
Dialogue: 0,0:11:14.25,0:11:16.79,Main,Scarlett,0,0,0,,Kimsin bilmiyorum ama...
Dialogue: 0,0:11:18.19,0:11:22.69,Main,Scarlett,0,0,0,,...kızım aç bir şekilde\Ngeri dönmemi bekliyor.
Dialogue: 0,0:11:22.69,0:11:24.73,Main,Scarlett,0,0,0,,Lütfen...
Dialogue: 0,0:11:25.26,0:11:27.33,Main,Kyros,0,0,0,,Benim, Kyros!
Dialogue: 0,0:11:27.80,0:11:30.14,Main,Scarlet,0,0,0,,Lütfen...
Dialogue: 0,0:11:36.68,0:11:38.18,Main,Kyros,0,0,0,,Scarlet?
Dialogue: 0,0:11:38.78,0:11:40.41,Main,Kyros,0,0,0,,Scarlet!
Dialogue: 0,0:11:47.79,0:11:51.92,Main,Kyros,0,0,0,,{\i1}Scarlet!
Dialogue: 0,0:11:52.76,0:11:55.23,Thoughts,Kyros,0,0,0,,{\i1}Onu bu şekilde nasıl kaybederim?!{\i0}
Dialogue: 0,0:11:55.23,0:11:59.83,Thoughts,Kyros,0,0,0,,{\i1}Cehennem sanki!\NNasıl bir iş bu?!{\i0}
Dialogue: 0,0:11:59.83,0:12:06.00,Thoughts,Kyros,0,0,0,,{\i1}Bu lanet teneke kollarla son nefesini verirken bile sıcaklığını hissedemiyorum!{\i0}
Dialogue: 0,0:12:09.94,0:12:17.38,Main,Kyros,0,0,0,,{\i1}Scarlet!
Dialogue: 0,0:12:21.52,0:12:22.99,Main,Violet,0,0,0,,Asker-san!
Dialogue: 0,0:12:24.26,0:12:25.39,Main,Violet,0,0,0,,Asker-san!
Dialogue: 0,0:12:26.36,0:12:27.73,Main,Violet,0,0,0,,Asker-san!
Dialogue: 0,0:12:28.19,0:12:30.13,Main,Kyros,0,0,0,,Viola-sama!
Dialogue: 0,0:12:30.13,0:12:31.80,Main,Luffy,0,0,0,,İyi misin?
Dialogue: 0,0:12:31.80,0:12:35.13,Main,Violet,0,0,0,,Bir sorunumuz var! \NDüşmanların birinci kattan yaklaştığını görebiliyorum!
Dialogue: 0,0:12:38.84,0:12:42.97,Main,Gladius,0,0,0,,Affedilemez! Demek o kişi\NGenç Bey'in kılığına bürünmüş biriydi?!
Dialogue: 0,0:12:43.48,0:12:46.10,Main,Gladius,0,0,0,,Hasır Şapkalar ikinci katta olmalılar!
Dialogue: 0,0:12:46.10,0:12:48.45,Main,Gladius,0,0,0,,Duvarda Violet'in kanı vardı!
Dialogue: 0,0:12:48.45,0:12:49.68,Main,Kyros,0,0,0,,Durum hiç iyi değil.
Dialogue: 0,0:12:50.82,0:12:53.22,Thoughts,Kyros,0,0,0,,{\i1}Acaba iki taraflı\Nkapana kısılmayı beklemek yerine...{\i0}
Dialogue: 0,0:12:54.32,0:12:58.26,Thoughts,Kyros,0,0,0,,{\i1}...Doflamingo'ya şu an\Nsürpriz bir saldırıda mı bulunsak?{\i0}
Dialogue: 0,0:13:01.39,0:13:04.10,Thoughts,Kyros,0,0,0,,{\i1}Usoland'lar başaramayacak anlaşılan.{\i0}
Dialogue: 0,0:13:06.57,0:13:10.50,Main,Kyros,0,0,0,,Aklıma gelmişken, siz korsandınız değil mi?
Dialogue: 0,0:13:11.00,0:13:13.54,Main,Kyros,0,0,0,,Sonradan Fraland'la Usoland'ın da\Nkorsan olduğunu anladım.
Dialogue: 0,0:13:14.61,0:13:15.87,Main,Luffy,0,0,0,,Bir sorun mu var?
Dialogue: 0,0:13:15.87,0:13:17.78,Main,Kyros,0,0,0,,Ben de suçluyum.
Dialogue: 0,0:13:18.24,0:13:21.25,Main,Kyros,0,0,0,,Hedefimiz bir olduktan sonra\Ngüçlerimizi birleştirmemiz iyi.
Dialogue: 0,0:13:21.35,0:13:25.72,Captions,Caption,0,0,175,,{\fad(1000,0)}Corrida Kolezyumu
Dialogue: 0,0:13:29.05,0:13:31.20,Main,Guard,0,0,0,,Kolezyumun temelinde çatlaklar var!
Dialogue: 0,0:13:31.20,0:13:36.06,Main,Guard,0,0,0,,Finallerden önce bile\Nyüzlerce güçlü savaşçı inletti arenayı!
Dialogue: 0,0:13:36.06,0:13:38.80,Main,Guard,0,0,0,,Arena bir günde çok hasar aldı!
Dialogue: 0,0:13:38.80,0:13:43.40,Main,Guard,0,0,0,,Burgess böyle saldırmaya devam ederse\Nburası fazla dayanmayacak!
Dialogue: 0,0:13:43.40,0:13:45.97,Main,Burgess,0,0,0,,Şok Dalgası Dirseği!
Dialogue: 0,0:13:50.51,0:13:51.90,Main,Citizen,0,0,0,,Şerefsize bak!
Dialogue: 0,0:13:51.90,0:13:53.51,Main,Citizen,0,0,0,,Bize doğru yapmasana!
Dialogue: 0,0:13:57.58,0:13:58.48,Main,Sabo,0,0,0,,Güzelmiş!
Dialogue: 0,0:14:02.22,0:14:05.69,Main,Diamante,0,0,0,,Daha kaç kere söyleteceksin Rebecca?!
Dialogue: 0,0:14:05.69,0:14:11.36,Main,Diamante,0,0,0,,Annen Scarlet'i vurup öldüren kişi bendim!
Dialogue: 0,0:14:11.36,0:14:15.83,Main,Bartolomeo,0,0,0,,Lan lan! Bu tarz sözlü saldırılara karşı\Nbariyerim hiçbir işe yaramaz!
Dialogue: 0,0:14:15.83,0:14:20.77,Thoughts,Rebecca,0,0,0,,{\i1}Asker-san!\Nİşe yaramazın tekiyim!{\i0}
Dialogue: 0,0:14:21.27,0:14:24.71,Flashbacks,Rebecca,0,0,0,,Anne, acıktım.
Dialogue: 0,0:14:24.71,0:14:26.61,Flashbacks,Scarlett,0,0,0,,Ben gidip\Nyiyecek bir şeyler bulayım öyleyse.
Dialogue: 0,0:14:27.31,0:14:28.35,Flashbacks,Rebecca,0,0,0,,Peki!
Dialogue: 0,0:14:29.61,0:14:33.25,Thoughts,Rebecca,0,0,0,,{\i1}Hareket edemeyecek kadar öfkeliyim!{\i0}
Dialogue: 0,0:14:33.35,0:14:36.02,Captions,Caption,0,0,0,,{\fad(500,0)}Oyuncak Evi
Dialogue: 0,0:14:39.49,0:14:42.33,Main,Marine,0,0,0,,Syborg Franky susturuldu!
Dialogue: 0,0:14:43.06,0:14:47.13,Thoughts,Franky,0,0,0,,{\i1}U-Usopp, başaracağını biliyorum!{\i0}
Dialogue: 0,0:14:47.13,0:14:50.64,Thoughts,Franky,0,0,0,,{\i1}Ateşle şu panik dalgasının fitilini artık!{\i0}
Dialogue: 0,0:14:50.64,0:14:56.11,Main,Gnomes,0,0,2,,{\i1}Usoland! Usoland!
Dialogue: 0,0:14:51.04,0:14:55.61,Captions,Caption,0,0,0,,{\fad(250,516)\pos(640,545)}Yer Altı Ticaret Limanı
Dialogue: 0,0:15:00.88,0:15:03.15,Thoughts,Toy,0,0,0,,{\i1}Yönetim kulesinde\Nçok acayip bir savaş yaşanıyor!{\i0}
Dialogue: 0,0:15:03.15,0:15:06.72,Thoughts,Toy,0,0,0,,{\i1}Hasır Şapka tayfasından Usopp,\Nhadi bastır!{\i0}
Dialogue: 0,0:15:06.72,0:15:09.28,Thoughts,Toy,0,0,0,,{\i1}Hayatımda yüzünü bile hiç görmedim\Nama iyi şanslar Usopp!{\i0}
Dialogue: 0,0:15:09.28,0:15:12.32,Thoughts,Toy,0,0,0,,{\i1}Kazanırsan ömrümün sonuna kadar\Nborçlu olacağım sana!{\i0}
Dialogue: 0,0:15:12.32,0:15:13.43,Thoughts,Toy,0,0,0,,{\i1}Haydi!{\i0}
Dialogue: 0,0:15:13.43,0:15:14.69,Thoughts,Toy,0,0,0,,{\i1}Haydi!{\i0}
Dialogue: 0,0:15:14.69,0:15:17.06,Thoughts,Cavendish,0,0,0,,{\i1}Hayatımın sonuna kadar\Noyuncak olarak kalmak istemiyorum!{\i0}
Dialogue: 0,0:15:17.06,0:15:20.10,Thoughts,Cavendish,0,0,0,,{\i1}Beni kurtarırsan\NHasır Şapkalar'ın peşini bırakacağım!{\i0}
Dialogue: 0,0:15:20.10,0:15:23.60,Thoughts,Hairudin,0,0,0,,{\i1}Senin için bile çalışırım be!\NHaydi göster gücünü!{\i0}
Dialogue: 0,0:15:23.60,0:15:27.04,Thoughts,Dagama,0,0,0,,{\i1}Tüm param senin olsun,\Nyeter ki yen şunları!{\i0}
Dialogue: 0,0:15:27.04,0:15:30.38,Main,Doflamingo,0,0,0,,{\i1}Trebol, Sugar'ı derhal saraya getir!{\i0}
Dialogue: 0,0:15:31.98,0:15:36.95,Main,Trébol,0,0,0,,Endişelenme Doffy, bugün beklenmedik\Nhiçbir sorun yaşamayacağız!
Dialogue: 0,0:15:39.14,0:15:41.62,Main,Sugar,0,0,0,,Düşman kendinde bile değil şu anda.
Dialogue: 0,0:15:41.62,0:15:43.72,Main,Leo,0,0,0,,Usoland!
Dialogue: 0,0:15:43.72,0:15:46.32,Main,Sugar,0,0,0,,Bu zehirli üzümü geri vereyim.
Dialogue: 0,0:15:46.79,0:15:48.50,Main,Cotton,0,0,0,,Tatababasco..
Dialogue: 0,0:15:48.50,0:15:50.16,Main,Inhel,0,0,0,,Umudumuz!
Dialogue: 0,0:15:51.13,0:15:53.10,Main,Sugar,0,0,0,,Al sen ye ve...
Dialogue: 0,0:15:54.40,0:15:55.90,Main,Sugar,0,0,0,,Öl.
Dialogue: 0,0:16:27.23,0:16:30.14,Main,Trébol,0,0,0,,Sugar, ne yapıyorsun?!
Dialogue: 0,0:16:30.14,0:16:32.34,Main,Trébol,0,0,0,,Kendine gel!
Dialogue: 0,0:16:37.11,0:16:39.28,Main,Leo,0,0,0,,Sugar...
Dialogue: 0,0:16:39.28,0:16:42.61,Main,Leo,0,0,0,,...bayıldı!
Dialogue: 0,0:16:42.61,0:16:45.45,Main,Trébol,0,0,0,,Su{\fscx250}-{\r}
Dialogue: 0,0:16:45.45,0:16:49.15,Main,Trébol,0,0,0,,Sugar bayıldı!
Dialogue: 0,0:16:59.80,0:17:01.10,Main,Robin,0,0,0,,Normale döndüm!
Dialogue: 0,0:17:15.45,0:17:16.85,Main,Grunt,0,0,0,,Oyuncaklar...
Dialogue: 0,0:17:17.48,0:17:20.22,Main,Grunt,0,0,0,,...gittikçe büyüyorlar!
Dialogue: 0,0:17:22.59,0:17:26.99,Main,Hairudin,0,0,0,,Normale döndüm!
Dialogue: 0,0:17:26.99,0:17:28.08,Main,Trébol,0,0,0,,Sugar!
Dialogue: 0,0:17:28.08,0:17:29.83,Main,Trébol,0,0,0,,Hey! Hey!
Dialogue: 0,0:17:30.76,0:17:33.83,Main,Trébol,0,0,0,,Eyvah!
Dialogue: 0,0:17:35.77,0:17:36.97,Main,Marine,0,0,0,,Bu patırdı da neyin nesi?!
Dialogue: 0,0:17:36.97,0:17:38.20,Main,Franky,0,0,0,,Ne oluyor?
Dialogue: 0,0:17:38.20,0:17:41.54,Main,Bastille,0,0,0,,Ne oluyor burada-dara?
Dialogue: 0,0:17:42.34,0:17:43.61,Main,Toy,0,0,0,,Bu da nesi?!
Dialogue: 0,0:17:45.11,0:17:46.91,Main,Citizen,0,0,0,,Tuhaf bir ihtiyara dönüştü!
Dialogue: 0,0:17:49.61,0:17:52.02,Main,Toy,0,0,0,,Ne oluyor?
Dialogue: 0,0:17:53.59,0:17:54.92,Main,Citizen,0,0,0,,Normale döndüm!
Dialogue: 0,0:17:56.09,0:17:57.62,Main,Toy,0,0,0,,Bekle lütfen!
Dialogue: 0,0:18:06.90,0:18:11.27,Main,Trébol,0,0,0,,{\i1}Su-Sugar...\NÖzür dilerim, Doffy!{\i0}
Dialogue: 0,0:18:11.27,0:18:13.37,Main,Buffalo,0,0,0,,Çok bağırıyorsun Trebol!
Dialogue: 0,0:18:13.64,0:18:16.01,Main,Doflamingo,0,0,0,,Sugar'a ne oldu?
Dialogue: 0,0:18:16.31,0:18:17.88,Main,Trébol,0,0,0,,{\i1}Ba-- Ba--{\i0}
Dialogue: 0,0:18:17.88,0:18:20.08,Main,Trébol,0,0,0,,Bayıl---
Dialogue: 0,0:18:20.08,0:18:22.61,Main,Trébol,0,0,0,,{\i1}Bayıldı!{\i0}
Dialogue: 0,0:18:24.08,0:18:25.42,Main,Doflamingo,0,0,0,,Lan...
Dialogue: 0,0:18:26.65,0:18:29.05,Main,Doflamingo,0,0,0,,Şaka mı yapıyorsun sen?!
Dialogue: 0,0:18:29.05,0:18:33.00,Main,Trébol,0,0,0,,On yıldır topladığımız hizmetkarlarımız...
Dialogue: 0,0:18:33.00,0:18:34.93,Main,Trébol,0,0,0,,...yeniden insan olmaya başladılar!
Dialogue: 0,0:18:34.93,0:18:38.50,Main,Trébol,0,0,0,,Hobi Hobi Meyvesi'nin büyüsü bozuldu!
Dialogue: 0,0:18:38.50,0:18:40.12,Main,Citizen,0,0,0,,Hatırlıyorum!
Dialogue: 0,0:18:40.12,0:18:44.44,Main,Announcer,0,0,0,,Ne oluyor böyle?!
Dialogue: 0,0:18:44.44,0:18:47.82,Main,Announcer,0,0,0,,Ne oluyor böyle acaba?!\NOyuncaklar...
Dialogue: 0,0:18:47.82,0:18:51.51,Main,Announcer,0,0,0,,Oyuncaklar insana dönüşmeye başladılar!
Dialogue: 0,0:18:55.46,0:18:58.52,Main,Announcer,0,0,0,,Sadece insana da değil anlaşılan!
Dialogue: 0,0:19:01.55,0:19:04.02,Main,Diamante,0,0,0,,Yoksa Sugar...
Dialogue: 0,0:19:04.02,0:19:07.02,Main,Dellinger,0,0,0,,On yıllık emeğimiz!
Dialogue: 0,0:19:07.02,0:19:10.03,Main,Machvise,0,0,0,,Birileri Sugar'ı yenmiş olmalı-in!
Dialogue: 0,0:19:10.03,0:19:14.00,Main,Pink,0,0,0,,Rezil boklu bücür kadın!
Dialogue: 0,0:19:15.00,0:19:16.13,Main,Pink,0,0,0,,Fakat...
Dialogue: 0,0:19:17.07,0:19:19.16,Main,Pink,0,0,0,,...umarım yaralanmamıştır.
Dialogue: 0,0:19:19.16,0:19:22.04,Main,Women,0,0,0,,{\i1}Ay!\NNe kadar erkeksi!{gag}
Dialogue: 0,0:19:23.71,0:19:25.74,Main,Grunt,0,0,0,,{\i1}Saray, cevap verin!{\i0}
Dialogue: 0,0:19:26.54,0:19:29.11,Main,Grunt,0,0,0,,Acil durum haberleri alıp duruyoruz!
Dialogue: 0,0:19:29.11,0:19:31.75,Main,Grunt,0,0,0,,{\i1}Güney kasabası Sevio'dan acil durum çağrısı!{\i0}
Dialogue: 0,0:19:31.75,0:19:35.72,Main,Grunt,0,0,0,,Limanda çalışan oyuncaklar\Nbirden korsana dönüştüler!
Dialogue: 0,0:19:38.02,0:19:40.02,Main,Grunt,0,0,0,,{\i1}Doğu kasabası Carta'dan sesleniyorum!{\i0}
Dialogue: 0,0:19:40.02,0:19:42.73,Main,Grunt,0,0,0,,Oyuncaklar eski Dressrosa askerlerine dönüştüler!
Dialogue: 0,0:19:42.73,0:19:44.66,Main,Grunt,0,0,0,,Hükümet yetkililerine dönüştüler!
Dialogue: 0,0:19:44.66,0:19:46.88,Main,Grunt,0,0,0,,Denizaşırı ülkelerden donanma askeri\Nve kıdemli yetkililere dönüştüler!
Dialogue: 0,0:19:46.88,0:19:48.57,Main,Grunt,0,0,0,,Vahşi hayvanlar!
Dialogue: 0,0:19:48.57,0:19:50.67,Main,Grunt,0,0,0,,Primula Bölgesi'nden arıyorum!
Dialogue: 0,0:19:51.77,0:19:53.61,Main,Grunt,0,0,0,,Gerçek mi bunlar?!
Dialogue: 0,0:20:01.55,0:20:02.95,Main,Robin,0,0,0,,Toparla kendini, Usopp!
Dialogue: 0,0:20:02.95,0:20:04.52,Main,Gnomes,0,0,0,,Usoland!
Dialogue: 0,0:20:04.52,0:20:06.85,Main,Gnomes,0,0,0,,{\i1}Usoland!{\i0}
Dialogue: 0,0:20:06.85,0:20:11.49,Main,Robin,0,0,0,,Sayende ben dahil hepimiz normale döndük!
Dialogue: 0,0:20:11.49,0:20:13.12,Main,Leo,0,0,0,,Başardın!
Dialogue: 0,0:20:14.26,0:20:18.73,Main,Leo,0,0,0,,SOP Operasyonu başarıyla sonuçlandı!
Dialogue: 0,0:20:20.10,0:20:23.90,Main,Bian,0,0,0,,Herkes yeniden insan oldu ve çok mutlu!
Dialogue: 0,0:20:25.14,0:20:27.24,Main,Child,0,0,0,,Neyin var, Onepoko?
Dialogue: 0,0:20:27.24,0:20:30.17,Main,Child,0,0,0,,Baksana anne,\NOnepoko tuhaf davranıyor!
Dialogue: 0,0:20:32.74,0:20:34.25,Main,Woman,0,0,0,,Onepoco!
Dialogue: 0,0:20:35.81,0:20:37.65,Main,Woman,0,0,0,,One...poko?
Dialogue: 0,0:20:40.55,0:20:42.59,Main,Woman,0,0,0,,One... Hayır!
Dialogue: 0,0:20:45.32,0:20:46.92,Main,Milo,0,0,0,,Normale döndüm!
Dialogue: 0,0:20:46.92,0:20:47.76,Main,Woman,0,0,0,,Hayatım!
Dialogue: 0,0:20:48.46,0:20:50.48,Main,Child,0,0,0,,Baba!\NOnepoko değilsin!
Dialogue: 0,0:20:50.48,0:20:52.16,Main,Milo,0,0,0,,Evet, babanım ben senin!
Dialogue: 0,0:20:52.16,0:20:53.46,Main,Child,0,0,0,,Baba!
Dialogue: 0,0:20:54.03,0:20:58.80,Main,Woman,0,0,0,,Bunca zaman seni nasıl unuttuk biz?!
Dialogue: 0,0:20:58.80,0:21:03.84,Main,Milo,0,0,0,,Öyle bir lanetti çünkü! Sonsuza dek\Noyuncak olarak kalacağım sandım!
Dialogue: 0,0:21:06.01,0:21:08.35,Main,Child,0,0,0,,Baba, yukarı kaldırsana beni!
Dialogue: 0,0:21:09.21,0:21:10.62,Main,Milo,0,0,0,,Uç haydi!
Dialogue: 0,0:21:18.36,0:21:21.09,Main,Zoro,0,0,0,,Lanet olsun, yine sesi kesildi!
Dialogue: 0,0:21:21.09,0:21:23.66,Main,Zoro,0,0,0,,Nereye kayboldu bu taş herif!?
Dialogue: 0,0:21:28.07,0:21:28.83,Main,Robin,0,0,0,,Millet!
Dialogue: 0,0:21:34.64,0:21:36.97,Main,Usopp,0,0,0,,Şey...
Dialogue: 0,0:21:36.97,0:21:39.18,Main,Usopp,0,0,0,,Yaşıyorum hâlâ...
Dialogue: 0,0:21:39.18,0:21:42.38,Main,Leo,0,0,0,,Kahraman yaşıyor!
Dialogue: 0,0:21:44.88,0:21:45.78,Main,Robin,0,0,0,,Usopp!
Dialogue: 0,0:21:45.78,0:21:49.15,Main,Leo,0,0,0,,Usoland!\NÇok ama çok teşekkürler!
Dialogue: 0,0:21:54.29,0:21:58.40,Main,Usopp,0,0,0,,Her şey plana uygun gitti!
Dialogue: 0,0:21:58.40,0:22:00.57,Main,Gnomes,0,0,0,,{\i1}Çok havalı!
Dialogue: 0,0:22:03.97,0:22:07.84,Main,Usopp,0,0,0,,Gerisini dostlarıma bırakın!
Dialogue: 0,0:22:07.84,0:22:12.14,Main,Usopp,0,0,0,,Savaş yeni başlıyor.
Dialogue: 0,0:22:13.31,0:22:14.85,Main,Gnomes,0,0,0,,{\i1}Peki!
Dialogue: 0,0:22:20.02,0:22:22.62,Main,Citizen,0,0,0,,Doflamingo'yu devirelim!
Dialogue: 0,0:22:22.62,0:22:25.42,Main,Citizen,0,0,0,,Doflamingo kandırdı bizi!
Dialogue: 0,0:22:25.42,0:22:28.02,Main,Citizen,0,0,0,,Ne diyorsun sen yahu?\NÇok iyi bir kral o.
Dialogue: 0,0:22:28.02,0:22:31.04,Main,Citizen,0,0,0,,Gerçek Doflamingo'yu bilmiyorsun!
Dialogue: 0,0:22:31.04,0:22:33.80,Main,Citizen,0,0,0,,Şeytanın ta kendisi o!
Dialogue: 0,0:22:33.80,0:22:36.00,Main,Pirate,0,0,0,,Doflamingo'yu öldürün!
Dialogue: 0,0:22:37.40,0:22:39.17,Main,Citizen,0,0,0,,Doflamingo, çık dışarı!
Dialogue: 0,0:22:39.17,0:22:42.14,Main,Citizen,0,0,0,,On yılın acısını\Nçıkartacağım senden!
Dialogue: 0,0:22:42.51,0:22:45.51,Main,Bastille,0,0,0,,Issho-san, ne oluyor böyle-dara?
Dialogue: 0,0:22:46.18,0:22:49.21,Main,Fujitora,0,0,0,,Dalgaların yönü değişti anlaşılan.
Dialogue: 0,0:22:50.72,0:22:57.42,Main,Fujitora,0,0,0,,Bu ülkenin ardında düşündüğümden daha derin bir karanlık yatıyormuş.
Dialogue: 0,0:22:57.42,0:23:00.09,Main,Citizen,0,0,0,,Doflamingo'yu alaşağı edelim!
Dialogue: 0,0:23:41.70,0:23:43.23,Main,Luffy,0,0,0,,O da kim?!
Dialogue: 0,0:23:43.23,0:23:44.87,Main,Violet,0,0,0,,Kyros ağabey!
Dialogue: 0,0:23:45.87,0:23:49.24,Main,Violet,0,0,0,,Onu ben bile unutmuşum!
Dialogue: 0,0:23:49.24,0:23:51.54,Main,Luffy,0,0,0,,Ne diyorsun sen?!
Dialogue: 0,0:23:52.01,0:23:53.91,Main,Luffy,0,0,0,,Asker nereye gitti?!
Dialogue: 0,0:23:53.91,0:23:55.08,Main,Violet,0,0,0,,Asker o işte!
Dialogue: 0,0:23:55.08,0:23:56.88,Main,Luffy,0,0,0,,İnsan ama o!
Dialogue: 0,0:23:56.88,0:24:03.02,Main,Violet,0,0,0,,Oyuncaklar aslında insandılar\Nfakat anılarımızdan silindiler!
Dialogue: 0,0:24:03.02,0:24:08.89,Main,Violet,0,0,0,,Güç kullanıcısı Sugar bayıldığından \Nanılarımıza da yeniden kavuştuk!
Dialogue: 0,0:24:13.23,0:24:16.27,Main,Violet,0,0,0,,Kral Riku Ordusu'nun eski komutanı...
Dialogue: 0,0:24:16.27,0:24:17.34,Main,Violet,0,0,0,,...Kyros'un ta kendisi o!
Dialogue: 0,0:24:20.57,0:24:24.14,Main,Violet,0,0,0,,Kolezyum tarihinin en güçlü gladyatörü!
Dialogue: 0,0:24:24.54,0:24:26.86,Main,Luffy,0,0,0,,O heykeldeki ihtiyar değil mi o?!
Dialogue: 0,0:24:26.86,0:24:30.41,Main,Violet,0,0,0,,Evet, onun heykeli!\NAyrıca...
Dialogue: 0,0:24:31.35,0:24:33.52,Main,Violet,0,0,0,,...Rebecca'nın öz babası!
Dialogue: 0,0:24:33.52,0:24:36.15,Main,Luffy,0,0,0,,Ne?!\NBabamı bilmiyorum demişti ama!
Dialogue: 0,0:24:36.15,0:24:38.14,Main,Violet,0,0,0,,İnsanlar seni unuttuklarında...
Dialogue: 0,0:24:38.62,0:24:41.96,Main,Violet,0,0,0,,...kendini hatırlatacak\Nhiçbir şey yapamazsın!
Dialogue: 0,0:24:41.96,0:24:47.06,Main,Violet,0,0,0,,O yüzden de on yıldır\Nhep sevdiceği kızını korudu!
Dialogue: 0,0:24:56.34,0:25:02.98,Main,Violet,0,0,0,,Oyuncak asker olarak\Ngünbegün onun yanındaydı!
Dialogue: 0,0:25:11.99,0:25:13.42,Main,Grunt,0,0,0,,Sen de kimsin be?!
Dialogue: 0,0:25:18.54,0:25:19.93,Main,Doflamingo,0,0,0,,Sen...
Dialogue: 0,0:25:19.93,0:25:21.33,Main,Riku,0,0,0,,Kyros!
Dialogue: 0,0:25:21.33,0:25:22.53,Main,Kyros,0,0,0,,Evet!
Dialogue: 0,0:25:24.44,0:25:28.74,Main,Kyros,0,0,0,,On yıl beklettiğim için bağışlayın!
Dialogue: 0,0:25:29.31,0:25:32.91,Main,Kyros,0,0,0,,Sizi kurtarmaya geldim!
Dialogue: 0,0:25:51.80,0:25:56.33,Main,Kyros,0,0,0,,Dressrosa'yı geri almak için buradayım!
Dialogue: 0,0:26:07.11,0:26:08.21,Main,Kyros,0,0,0,,On yıl!
Dialogue: 0,0:26:09.98,0:26:13.28,Main,Kyros,0,0,0,,Tam on yıl boyunca katlandık!
Dialogue: 0,0:26:16.55,0:26:17.96,Main,Grunts,0,0,0,,{\i1}Doflamingo-sama!
Dialogue: 0,0:26:17.96,0:26:20.09,Main,Buffalo,0,0,0,,Genç Beyim!
Dialogue: 0,0:26:20.09,0:26:21.16,Main,Buffalo,0,0,0,,Lanet olası!
Dialogue: 0,0:26:25.40,0:26:27.16,Main,Luffy,0,0,0,,Mingo öldü!
Dialogue: 0,0:26:27.16,0:26:29.40,Main,Luffy,0,0,0,,Ben döveceğim onu diye\No kadar heveslenmiştim oysaki...
Dialogue: 0,0:26:29.40,0:26:30.33,Main,Grunt,0,0,0,,Oradalar!
Dialogue: 0,0:26:30.33,0:26:31.54,Main,Grunt,0,0,0,,Gördüm!\NLanet olasıcalar!
Dialogue: 0,0:26:31.54,0:26:32.32,Main,Violet,0,0,0,,Buldular bizi!
Dialogue: 0,0:26:32.32,0:26:33.50,Main,Grunt,0,0,0,,Ateş!
Dialogue: 0,0:26:34.71,0:26:36.71,Main,Luffy,0,0,0,,Trao'yu kurtaralım!
Dialogue: 0,0:26:39.08,0:26:41.61,Captions,Caption,0,0,0,,{\fad(302,0)\pos(1035.691,90.5)}Corrida Kolezyumu
Dialogue: 0,0:26:46.12,0:26:48.45,Main,Citizen,0,0,0,,Bu gorilin ne işi var burada?!
Dialogue: 0,0:26:48.45,0:26:50.09,Main,Citizen,0,0,0,,Kaçın!
Dialogue: 0,0:26:50.59,0:26:52.49,Main,Diamante,0,0,0,,İnanamıyorum buna!
Dialogue: 0,0:26:53.06,0:26:57.16,Main,Diamante,0,0,0,,Lanet olası Trebol\NSugar'ı savunmasız bıraktı anlaşılan!
Dialogue: 0,0:26:57.16,0:26:58.33,Main,Diamante,0,0,0,,Beyinsiz şey!
Dialogue: 0,0:26:58.33,0:27:00.66,Main,Bartolomeo,0,0,0,,Daha ne kadar ağlayacaksın?!
Dialogue: 0,0:27:00.66,0:27:02.37,Main,Bartolomeo,0,0,0,,Bebek bakıcısıyız sanki burada!
Dialogue: 0,0:27:02.37,0:27:03.90,Main,Rebecca,0,0,0,,Ondan değil!
Dialogue: 0,0:27:05.17,0:27:06.60,Main,Rebecca,0,0,0,,Benim...
Dialogue: 0,0:27:07.14,0:27:10.31,Main,Rebecca,0,0,0,,...bir babam vardı!
Dialogue: 0,0:27:11.31,0:27:15.78,Main,Sabo,0,0,0,,Anlaşılan ülkenin karanlıklarında\Nböyle bir dolap dönüyormuş, Rebecca.
Dialogue: 0,0:27:18.92,0:27:22.29,Main,Sabo,0,0,0,,Her şeyin özü vardır.
Dialogue: 0,0:27:23.09,0:27:24.52,Main,Sabo,0,0,0,,Bu alanın bile.
Dialogue: 0,0:27:24.52,0:27:29.79,Main,Bartolomeo,0,0,0,,Büyük Senpaim!\NNe dediğini zerre anlamadım!
Dialogue: 0,0:27:30.90,0:27:32.76,Main,Sabo,0,0,0,,Bu ring de öyle mesela.
Dialogue: 0,0:27:33.70,0:27:35.37,Main,Sabo,0,0,0,,Özü mevcut.
Dialogue: 0,0:27:38.20,0:27:40.77,Main,Sabo,0,0,0,,Buradaki savaşa bir son verelim.
Dialogue: 0,0:27:49.98,0:27:51.65,Main,Sabo,0,0,0,,{\fad(150,150)}Ejder Pençesi Yumruğu!
Dialogue: 0,0:27:54.65,0:27:58.86,Main,Sabo,0,0,0,,{\fad(150,150)}Ejder Nefesi!
Dialogue: 0,0:28:06.96,0:28:11.44,Main,Announcer,0,0,0,,Amanın! Lucy'nin inanılmaz saldırısı sonucu...
Dialogue: 0,0:28:11.44,0:28:13.24,Main,Announcer,0,0,0,,...ring batmaya başladı!
Dialogue: 0,0:28:14.31,0:28:16.44,Main,Citizen,0,0,0,,Ring patladı resmen!
Dialogue: 0,0:28:20.74,0:28:22.15,Main,Burgess,0,0,0,,Süzülüyoruz!
Dialogue: 0,0:28:23.28,0:28:25.62,Main,Diamante,0,0,0,,Lanet olası, ne yaptın?!
Dialogue: 0,0:28:25.62,0:28:28.19,Main,Sabo,0,0,0,,Olmam gereken başka bir yer var.\NBu yarışmayı kazanacağım şimdi!
Dialogue: 0,0:28:32.46,0:28:34.76,Main,Hack,0,0,0,,{\i1}Dehşet bir ses duydum orada!{\i0}
Dialogue: 0,0:28:34.76,0:28:35.79,Main,Koala,0,0,0,,Hack?
Dialogue: 0,0:28:35.79,0:28:37.70,Main,Hack,0,0,0,,{\i1}Gene düşüncesizce\Nbir şeyler yaptı kesin!{\i0}
Dialogue: 0,0:28:38.96,0:28:41.43,Main,Koala,0,0,0,,Yeraltına doğru\Nyola koyulmak üzere.
