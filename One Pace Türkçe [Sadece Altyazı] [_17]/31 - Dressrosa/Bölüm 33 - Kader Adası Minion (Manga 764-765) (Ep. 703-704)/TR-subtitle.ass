Dialogue: 0,0:01:42.66,0:01:46.13,Title,,0,0,240,,{\fad(300,300)}Kader Adası: Minion
Dialogue: 0,0:01:52.34,0:01:55.18,Main,,0,0,0,,Neden!?\NNe zamandan beri konuşabiliyorsun?!
Dialogue: 0,0:01:56.66,0:01:57.88,Main,,0,0,0,,Kendimi bildim bileli.
Dialogue: 0,0:01:59.88,0:02:03.30,Main,,0,0,0,,Bunca zamandır\NDoflamingo'yu kandırıyor muydun?!
Dialogue: 0,0:02:03.91,0:02:09.85,Main,,0,0,0,,Ona hiçbir zaman dilsiz olduğumu söylemedim.\NKendi kendine buna karar verdi.
Dialogue: 0,0:02:09.85,0:02:12.78,Main,,0,0,0,,Kandırmaktan ne farkı var bunun?!
Dialogue: 0,0:02:12.78,0:02:13.96,Main,,0,0,0,,Aklından...
Dialogue: 0,0:02:15.64,0:02:16.74,Main,,0,0,0,,{\fad(150,150)}Sessizlik!
Dialogue: 0,0:02:30.75,0:02:33.62,Main,,0,0,0,,Sokaktaki tüm sesler kayboldu!
Dialogue: 0,0:02:33.62,0:02:34.77,Main,,0,0,0,,Neden?!
Dialogue: 0,0:02:35.35,0:02:38.87,Main,,0,0,0,,İnsanların konuştuğunu görebiliyorum\Nama hiçbir şey duyamıyorum!
Dialogue: 0,0:02:38.87,0:02:41.75,Main,,0,0,0,,Çok sesin çıkıyor,\Naraya bir duvar koydum.
Dialogue: 0,0:02:42.44,0:02:43.66,Main,,0,0,0,,Ses geçirmez bir duvar.
Dialogue: 0,0:02:44.42,0:02:47.04,Main,,0,0,0,,Buradan dışarısının sesini duyamadığın gibi...
Dialogue: 0,0:02:47.38,0:02:50.38,Main,,0,0,0,,...dışarıdan da bizim sesimizi duyamazlar.
Dialogue: 0,0:02:50.38,0:02:53.42,Main,,0,0,0,,Nagi Nagi Meyvesi yemiş\Nsessiz insanım.
Dialogue: 0,0:02:56.00,0:02:58.16,Main,,0,0,0,,Şeytan Meyvesi\Ngüç kullanıcısı mısın?!
Dialogue: 0,0:03:00.38,0:03:03.31,Main,,0,0,0,,Bu ne şimdi anasını?! Her tarafından\Nayrı bir yalan fırlıyormuş resmen!
Dialogue: 0,0:03:03.31,0:03:06.76,Main,,0,0,0,,Yoksa hep aptallar gibi sağa sola takılıp\Ndüşmelerin de yalan mıydı?!
Dialogue: 0,0:03:08.42,0:03:10.77,Main,,0,0,0,,Evet, elbette.
Dialogue: 0,0:03:10.77,0:03:12.49,Main,,0,0,0,,Hepsi numara.
Dialogue: 0,0:03:12.49,0:03:14.24,Main,,0,0,0,,Yalancı!\NOmzun alev aldı!
Dialogue: 0,0:03:16.73,0:03:20.98,Main,,0,0,0,,Çocukluktan kalan sakarlıklar bunlar.\NŞu saatten sonra değişemem. Sakarım.
Dialogue: 0,0:03:20.98,0:03:24.52,Main,,0,0,0,,Kapa çeneni be! Doğru olan tek şeyin\Nen saçma özelliğin mi yani?!
Dialogue: 0,0:03:24.52,0:03:27.16,Main,,0,0,0,,Tüm bunları\Ndostlarından neden saklıyorsun?!
Dialogue: 0,0:03:27.16,0:03:29.09,Main,,0,0,0,,Onları dostum olarak görmüyorum.
Dialogue: 0,0:03:29.09,0:03:35.30,Main,,0,0,0,,Tek istediğim ağabeyim Doffy'nin\Nkontrolden çıkmasını engellemek.
Dialogue: 0,0:03:36.05,0:03:41.20,Main,,0,0,0,,İyi kalpli anne babamızdan onun gibi canavar\Nnasıl dünyaya geldi aklım almıyor.
Dialogue: 0,0:03:46.12,0:03:49.12,Main,,0,0,0,,Bir damla olsun\Ninsanlık yok onda.
Dialogue: 0,0:03:50.74,0:03:52.80,Main,,0,0,0,,Yardım edin!
Dialogue: 0,0:03:55.87,0:03:58.28,Main,,0,0,0,,Çocuklarımın bir suçu yok!
Dialogue: 0,0:03:58.28,0:04:00.80,Main,,0,0,0,,Tüm oklarınızı bana fırlatın!
Dialogue: 0,0:04:01.77,0:04:05.34,Main,,0,0,0,,Yalvarıyorum!\NÇocuklarıma zarar vermeyin!
Dialogue: 0,0:04:07.00,0:04:11.24,Main,,0,0,0,,Çok acıyor baba!\NDayanamayacağım!
Dialogue: 0,0:04:12.97,0:04:15.93,Main,,0,0,0,,Bu yaptığınız\Nyanınıza kâr kalmaz!
Dialogue: 0,0:04:17.52,0:04:18.52,Main,,0,0,0,,Ağabey...
Dialogue: 0,0:04:18.52,0:04:21.30,Main,,0,0,0,,Öldüremeyeceksiniz beni!
Dialogue: 0,0:04:26.56,0:04:32.68,Main,,0,0,0,,Ne olursa olsun sağ kalacak\Nve hepinizi...
Dialogue: 0,0:04:32.68,0:04:38.94,Main,,0,0,0,,Hepinizi bir bir geberteceğim!
Dialogue: 0,0:04:38.94,0:04:43.28,Main,,0,0,0,,Doğduğu andan itibaren\Nkorku nedir bilmeyen kötü tabiatlı biri.
Dialogue: 0,0:04:45.80,0:04:48.98,Main,,0,0,0,,Doffy'nin bu acımasız yönünü bilen\Nyegâne kişiler...
Dialogue: 0,0:04:49.65,0:04:55.26,Main,,0,0,0,,...ben dahil dört yönetici ve\NSendai Corazon Vergo.
Dialogue: 0,0:04:55.88,0:04:57.31,Main,,0,0,0,,Vergo mu?
Dialogue: 0,0:04:57.31,0:05:02.69,Main,,0,0,0,,Çok gizli bir görev için\Naileden ayrılmış güçlü bir adam.
Dialogue: 0,0:05:03.18,0:05:06.42,Main,,0,0,0,,Görevin ayrıntıları\Naile üyelerinden bile saklanıyor.
Dialogue: 0,0:05:06.42,0:05:08.75,Main,,0,0,0,,Seni pek ilgilendirmeyen biri.
Dialogue: 0,0:05:10.13,0:05:12.54,Main,,0,0,0,,Ağabeyim gibi bir canavara dönüşme!
Dialogue: 0,0:05:13.00,0:05:14.36,Main,,0,0,0,,Git buradan, Law!
Dialogue: 0,0:05:14.36,0:05:18.24,Main,,0,0,0,,Hiçbir yere gitmeyeceğim!\NTam da olmak istediğim kişi o!
Dialogue: 0,0:05:18.24,0:05:20.76,Main,,0,0,0,,Gizli ad "D."!\NHiç şüphesiz...
Dialogue: 0,0:05:21.26,0:05:24.24,Main,,0,0,0,,Sen o kaderi çoktan yazılmış ailenin,\ND. Ailesi'nin bir parçasısın.
Dialogue: 0,0:05:24.80,0:05:28.39,Main,,0,0,0,,Memleketimde çocuklar şöyle korkutulurdu...
Dialogue: 0,0:05:29.09,0:05:32.66,Main,,0,0,0,,"Yaramazlık yaparsan D. seni yer."
Dialogue: 0,0:05:34.88,0:05:38.92,Main,,0,0,0,,Sık sık tüm dünyada kötü şöhret kazanmış\ND. adına sahip kişiler ortaya çıkardı...
Dialogue: 0,0:05:39.89,0:05:43.10,Main,,0,0,0,,...ve ihtiyarlar kaş çatıp\Nşöyle söylenirlerdi...
Dialogue: 0,0:05:45.18,0:05:48.07,Main,,0,0,0,,"D." mutlaka\Nyeni bir fırtınaya neden olacak.
Dialogue: 0,0:05:48.78,0:05:52.59,Main,,0,0,0,,Ne diyorsun sen be!?\NCanavar falan mıyım ben?
Dialogue: 0,0:05:52.59,0:05:53.68,Main,,0,0,0,,Olabilir.
Dialogue: 0,0:05:54.23,0:05:56.36,Main,,0,0,0,,Gerçek anlamını\Nkimse bilmiyor fakat...
Dialogue: 0,0:05:56.75,0:06:01.74,Main,,0,0,0,,...tarih boyunca tüm dünyada durmaksızın\Nve gizlice miras kalan bir isim o.
Dialogue: 0,0:06:01.74,0:06:07.28,Main,,0,0,0,,Ayrıca bazı yerlerde D. Ailesi'ni\Nşöyle ananlar da mevcut...
Dialogue: 0,0:06:10.12,0:06:11.65,Main,,0,0,0,,"Tanrıların baş düşmanı!"
Dialogue: 0,0:06:16.40,0:06:17.66,Main,,0,0,0,,Tanrıların mı?!
Dialogue: 0,0:06:18.00,0:06:21.11,Main,,0,0,0,,Tanrı derken eğer\N"Tenryuubitolar'dan" bahsediyorlarsa...
Dialogue: 0,0:06:21.11,0:06:25.30,Main,,0,0,0,,...insanlarınızın amacının "dünyanın yıkımı"\Nolduğunu da düşünebiliriz.
Dialogue: 0,0:06:27.83,0:06:32.44,Main,,0,0,0,,Fakat Doffy'nin gözünde\Nadının bambaşka bir anlamı var.
Dialogue: 0,0:06:32.44,0:06:36.14,Main,,0,0,0,,"D.'ler tanrıların\Ntam zıttı olmalılar."
Dialogue: 0,0:06:38.42,0:06:40.39,Main,,0,0,0,,Neden bahsediyorsun anlamıyorum!
Dialogue: 0,0:06:40.39,0:06:44.78,Main,,0,0,0,,Aileye mümkün olduğunca\Nçok kişiyi gebertebilmek için katıldım!
Dialogue: 0,0:06:44.78,0:06:48.62,Main,,0,0,0,,Senin değil\NDoflamingo'nun adamıyım ben!
Dialogue: 0,0:06:48.62,0:06:52.42,Main,,0,0,0,,Bir yıla öleceğim nasılsa!\NKaçıp da ne yapayım?!
Dialogue: 0,0:06:52.42,0:06:54.57,Main,,0,0,0,,Buradan kaç ve tedavinin yolunu ara!
Dialogue: 0,0:06:54.57,0:06:55.56,Main,,0,0,0,,Öyle bir yol yok!
Dialogue: 0,0:06:56.44,0:07:00.98,Main,,0,0,0,,Konuşabildiğini ve gücünü,\Nher şeyi Doflamingo'ya söyleyeceğim!
Dialogue: 0,0:07:00.98,0:07:01.94,Main,,0,0,0,,Yapma!
Dialogue: 0,0:07:02.75,0:07:05.13,Main,,0,0,0,,Aileden kovulmakla da kalmayacaksın!
Dialogue: 0,0:07:05.13,0:07:06.10,Main,,0,0,0,,Lanet olası velet!
Dialogue: 0,0:07:11.96,0:07:14.17,Main,,0,0,0,,İki yılda güçlendim ben!
Dialogue: 0,0:07:14.17,0:07:15.46,Main,,0,0,0,,Oh canıma değsin!
Dialogue: 0,0:07:18.53,0:07:21.79,Main,,0,0,0,,Law! Gene Kan Kanunu'nu çiğnedin!
Dialogue: 0,0:07:21.79,0:07:25.46,Main,,0,0,0,,Öyle ağızlarınızı oynatarak\Nne yapıyordunuz?!
Dialogue: 0,0:07:25.88,0:07:27.78,Main,,0,0,0,,Çeneni kapalı tutarsan\Ndondurma alırım.
Dialogue: 0,0:07:27.78,0:07:30.97,Main,,0,0,0,,500 belilik dev boydan istiyorum-dasuyan!
Dialogue: 0,0:07:30.97,0:07:32.74,Main,,0,0,0,,Baby 5, borç ver biraz.
Dialogue: 0,0:07:32.74,0:07:33.74,Main,,0,0,0,,Ne?!
Dialogue: 0,0:07:33.74,0:07:35.72,Main,,0,0,0,,Pe-Peki!
Dialogue: 0,0:07:36.21,0:07:39.32,Main,,0,0,0,,Bana ihtiyacı var!
Dialogue: 0,0:07:44.16,0:07:45.44,Main,,0,0,0,,{\i1}Buraya kadar mıydı?!{\i0}
Dialogue: 0,0:07:53.58,0:07:55.00,Main,,0,0,0,,{\i1}Lanet olsun!{\i0}
Dialogue: 0,0:07:55.50,0:07:59.38,Main,,0,0,0,,{\i1}O velede güvenip\Nher şeyi anlattım!{\i0}
Dialogue: 0,0:08:01.22,0:08:02.29,Main,,0,0,0,,Corazon!
Dialogue: 0,0:08:02.29,0:08:05.88,Main,,0,0,0,,Yelken açıyoruz!\NGene Donanma'dan Tsuru peşimizde.
Dialogue: 0,0:08:05.88,0:08:07.86,Main,,0,0,0,,Burada olduğumuzu biliyorlar!
Dialogue: 0,0:08:08.39,0:08:11.38,Main,,0,0,0,,{\i1}Henüz söylememiş mi?!{\i0}
Dialogue: 0,0:08:13.05,0:08:14.86,Main,,0,0,0,,Söylememeye karar verdim.
Dialogue: 0,0:08:15.63,0:08:17.30,Main,,0,0,0,,İyice düşününce...
Dialogue: 0,0:08:17.30,0:08:20.96,Main,,0,0,0,,...iki yıl önce bıçakladığımı söylemediğin,\Nsana borçlu olduğum geldi aklıma.
Dialogue: 0,0:08:21.50,0:08:23.08,Main,,0,0,0,,Böylece ödeşmiş olduk.
Dialogue: 0,0:08:25.90,0:08:27.85,Note,,0,0,0,,{\fade(450,0)}Tsuru
Dialogue: 0,0:08:33.93,0:08:36.03,Main,,0,0,0,,Corazon'la Law nerede?
Dialogue: 0,0:08:37.91,0:08:40.96,Main,,0,0,0,,Gemide görmüştüm onları ama...\NBurada değiller mi?
Dialogue: 0,0:08:49.60,0:08:52.94,Main,,0,0,0,,Genç Bey'im...\NCorazon'un hamağında bunu buldum.
Dialogue: 0,0:08:52.94,0:08:54.56,Captions,,0,0,0,,{\blur0.9\c&H2C292A&\frz16\fs50\pos(450,80.143)\3c&H000000&\3a&H46&}Law'un hastalığını
Dialogue: 0,0:08:52.94,0:08:54.56,Captions,,0,0,0,,{\blur0.9\frz20\c&H282528&\fs50\pos(790,653)\3c&H000000&\3a&H46&}iyileştirmeye gidiyorum
Dialogue: 0,0:08:54.15,0:08:56.77,Main,,0,0,0,,Eşyalarını toplayıp ayrılmışlar.
Dialogue: 0,0:08:56.77,0:08:58.88,Main,,0,0,0,,Bu ne demek şimdi?!
Dialogue: 0,0:09:04.26,0:09:06.08,Main,,0,0,0,,Adam kaçırıyorlar!
Dialogue: 0,0:09:07.16,0:09:09.82,Main,,0,0,0,,Den Den Mushi'ye cevap ver!
Dialogue: 0,0:09:09.82,0:09:11.94,Main,,0,0,0,,Doflamingo değil mi arayan?!\NBen konuşurum!
Dialogue: 0,0:09:12.58,0:09:13.51,Main,,0,0,0,,Cevap ver dedim!
Dialogue: 0,0:09:13.51,0:09:15.63,Main,,0,0,0,,Cevap versene be!
Dialogue: 0,0:09:15.63,0:09:17.84,Main,,0,0,0,,Doflamingo, yardım et!
Dialogue: 0,0:09:17.84,0:09:20.24,Main,,0,0,0,,Bana ne yapacaksın?!
Dialogue: 0,0:09:20.24,0:09:21.46,Main,,0,0,0,,Söyle!
Dialogue: 0,0:09:27.13,0:09:29.03,Main,,0,0,0,,Doflamingo'yu mu arıyorsun?!
Dialogue: 0,0:09:29.03,0:09:31.40,Main,,0,0,0,,Kurtar beni!
Dialogue: 0,0:09:32.04,0:09:36.96,Main,,0,0,0,,- Prinç Krakerleri!\N- "Kraker topları!" Benim.
Dialogue: 0,0:09:36.96,0:09:39.22,Main,,0,0,0,,{\i1}Rosinante.{\i0}
Dialogue: 0,0:09:39.80,0:09:41.89,Main,,0,0,0,,Görevime bir süre ara veriyorum.
Dialogue: 0,0:09:41.89,0:09:48.42,Note,,0,0,0,,Donanma
Dialogue: 0,0:09:50.30,0:09:55.17,Secondary,,0,0,0,,{\c&H424145&\fscx131\fscy121\blur0.8\frz344\frx5\fry7\org(423,361)\pos(608,155)\3c&H000000&\3a&HFF&}MUTLAK ADALET
Dialogue: 0,0:09:51.16,0:09:52.52,Main,,0,0,0,,Başın belaya falan mı girdi?
Dialogue: 0,0:09:52.52,0:09:53.97,Main,,0,0,0,,Yok, özel bir durum.
Dialogue: 0,0:09:53.97,0:09:55.18,Main,,0,0,0,,Pekâlâ, anlaşılmıştır.
Dialogue: 0,0:09:56.00,0:09:57.81,Main,,0,0,0,,{\i1}Küçükler ne durumda?{\i0}
Dialogue: 0,0:09:57.81,0:10:00.18,Main,,0,0,0,,{\i1}Tüm zorbalıklarına rağmen\Nhâlâ oradalar mı?{\i0}
Dialogue: 0,0:10:00.18,0:10:02.15,Main,,0,0,0,,O üçünün ayrılacağını sanmam...
Dialogue: 0,0:10:02.95,0:10:07.82,Main,,0,0,0,,Aile epey kötü anılır oldu.\NDikkatli ol.
Dialogue: 0,0:10:07.82,0:10:08.52,Main,,0,0,3,,{\i1}Peki.{\i0}
Dialogue: 0,0:10:08.06,0:10:11.54,Captions,,0,0,240,,{\fad(526,0)}Donanma Karargahı\NAmiral Sengoku
Dialogue: 0,0:10:11.72,0:10:15.24,Main,,0,0,0,,Bu dava sana emanet.\Nİstediğini yapmakta özgürsün.
Dialogue: 0,0:10:15.92,0:10:17.77,Main,,0,0,0,,Gelişmelerden haberdar edersin.
Dialogue: 0,0:10:17.77,0:10:20.94,Main,,0,0,0,,{\i1}Anlaşılmıştır.\NAyrıntıları yazılı olarak gönderirim.{\i0}
Dialogue: 0,0:10:27.97,0:10:31.69,Captions,,0,0,240,,{\fad(500,0)}Kumandan\NDonquixote Rosinante
Dialogue: 0,0:10:32.47,0:10:33.72,Main,,0,0,0,,Amiral Sengoku!
Dialogue: 0,0:10:34.01,0:10:38.00,Captions,,0,0,0,,{\pos(985,650)\frz360\c&H4B3B35&\3c&H4E3E38&\3a&H46&\fs50}Buda
Dialogue: 0,0:10:34.64,0:10:37.14,Main,,0,0,0,,Daha önce bahsettiğim\Ntransfer isteğinde bulunan kişi geldi.
Dialogue: 0,0:10:37.14,0:10:39.18,Main,,0,0,0,,Pekâlâ, gir.
Dialogue: 0,0:10:42.14,0:10:43.66,Main,,0,0,0,,Transfer olmak istiyorsun demek?
Dialogue: 0,0:10:44.49,0:10:46.39,Main,,0,0,0,,Adın kulağıma çalınmıştı.
Dialogue: 0,0:10:46.39,0:10:50.50,Main,,0,0,0,,Donanma'da birinci yılını doldurmuşsun\Nve oldukça da başarılıymışsın...
Dialogue: 0,0:10:50.50,0:10:53.41,Main,,0,0,0,,G-5'e transfer olmak istiyorsun demek?
Dialogue: 0,0:10:53.41,0:10:57.70,Main,,0,0,0,,Öncelikle sol yanağındaki sarısı gözüken\Nyumurtanın nedenini sormak istiyorum...
Dialogue: 0,0:10:57.70,0:10:59.94,Main,,0,0,0,,Emredersiniz!\NAdım Vergo efendim!
Dialogue: 0,0:11:02.68,0:11:04.81,Main,,0,0,0,,Kiminle konuştun?!
Dialogue: 0,0:11:04.81,0:11:09.46,Main,,0,0,0,,Görev falan dedin!\NDonanma askeri falan mısın yoksa?!
Dialogue: 0,0:11:09.46,0:11:11.02,Main,,0,0,0,,Donanma'yı sevmiyor musun?
Dialogue: 0,0:11:11.02,0:11:13.56,Main,,0,0,0,,Hükümet'le ilgisi olan kişiler\Nmidemi bulandırıyor!
Dialogue: 0,0:11:14.04,0:11:15.32,Main,,0,0,0,,Donanma askeri değilim.
Dialogue: 0,0:11:15.32,0:11:16.28,Main,,0,0,0,,Doğru mu söylüyorsun?!
Dialogue: 0,0:11:17.16,0:11:19.62,Main,,0,0,0,,Hastaneye falan gitmek istemiyorum!
Dialogue: 0,0:11:19.62,0:11:22.26,Main,,0,0,0,,Normal veletler gibi davranmayı bırak!
Dialogue: 0,0:11:22.76,0:11:24.94,Main,,0,0,0,,Hastalığını iyileştireceğim!
Dialogue: 0,0:11:25.49,0:11:27.40,Main,,0,0,0,,Gerekirse tüm hastaneleri tek tek gezeceğiz!
Dialogue: 0,0:11:27.90,0:11:31.40,Main,,0,0,0,,Bak! Ne büyük bir hastane!\NEminim seni tedavi ederler!
Dialogue: 0,0:11:31.77,0:11:34.64,Main,,0,0,0,,Beyaz Kurşun Hastalığı mı?!
Dialogue: 0,0:11:34.64,0:11:38.21,Main,,0,0,0,,Epeydir bilinen bir hastalık. \NŞöyle sağlamından ilacın falan yok mu, doktor?
Dialogue: 0,0:11:38.21,0:11:41.80,Main,,0,0,0,,Kusura bakma ama nerelisin sen?
Dialogue: 0,0:11:42.72,0:11:43.58,Main,,0,0,0,,Flevance.
Dialogue: 0,0:11:43.58,0:11:45.30,Main,,0,0,0,,Beyaz Şehir!
Dialogue: 0,0:11:45.98,0:11:48.24,Main,,0,0,0,,Olamaz! Bana da bulaşacak!
Dialogue: 0,0:11:48.24,0:11:51.65,Main,,0,0,0,,Antiseptik ve eldiven getirin çabuk!\NGaz maskelerini takın!
Dialogue: 0,0:11:51.65,0:11:55.09,Main,,0,0,0,,Ayrıca derhal güvenliğe\Nve Hükümet'e haber verin!
Dialogue: 0,0:11:55.09,0:11:57.48,Secondary,,0,0,77,,Hayır! Hayır ya!
Dialogue: 0,0:11:56.32,0:11:57.52,Main,,0,0,0,,Al işte!
Dialogue: 0,0:11:57.52,0:11:58.98,Secondary,,0,0,77,,Hayır! Hayır! Hayır! Hayır!
Dialogue: 0,0:11:58.24,0:11:59.08,Main,,0,0,0,,Law!
Dialogue: 0,0:11:58.98,0:12:00.62,Secondary,,0,0,77,,Hayırrr!
Dialogue: 0,0:11:59.33,0:12:01.96,Main,,0,0,0,,İnsan bile değilim artık!
Dialogue: 0,0:12:08.60,0:12:12.69,Main,,0,0,0,,Beyaz canavar!\NGit buradan, yalvarıyorum!
Dialogue: 0,0:12:12.69,0:12:17.38,Main,,0,0,0,,Ne cüretle\No veledi buraya getirirsin?!
Dialogue: 0,0:12:17.38,0:12:20.08,Main,,0,0,0,,Bu hastanede kaç hasta yatıyor\Nbiliyor musun sen?!
Dialogue: 0,0:12:19.58,0:12:22.13,Main,,0,0,0,,{\a6\i1}Acil durum. Acil durum.{\i0}
Dialogue: 0,0:12:22.13,0:12:25.37,Main,,0,0,0,,{\a6\i1}Hastanemizde Beyaz Kurşun Hastalığı'na sahip\Nbir çocuk mevcut.{\i0}
Dialogue: 0,0:12:29.26,0:12:32.46,Main,,0,0,0,,Büyük olan ortalığı birbirine katıyor!
Dialogue: 0,0:12:32.46,0:12:34.50,Main,,0,0,0,,{\a6\i1}Tüm binayı sterilize edeceğiz.{\i0}
Dialogue: 0,0:12:36.23,0:12:38.08,Main,,0,0,0,,Ben böyle kötü bir hastane görmedim!
Dialogue: 0,0:12:38.44,0:12:42.11,Main,,0,0,0,,Özür dilerim.\NEski anılarını mı hatırlattı sana?
Dialogue: 0,0:12:42.11,0:12:45.64,Main,,0,0,0,,Bu yüzden hastaneye falan\Ngitmek istemiyorum dedim sana!
Dialogue: 0,0:12:47.20,0:12:49.01,Main,,0,0,0,,Bunda şansımız yaver gitmedi...
Dialogue: 0,0:12:49.51,0:12:51.79,Main,,0,0,0,,Ama eminim bir sonraki hastanede\Niyi bir doktor bulacağız!
Dialogue: 0,0:12:51.79,0:12:53.14,Main,,0,0,0,,İstemiyorum işte!
Dialogue: 0,0:12:54.30,0:12:58.33,Main,,0,0,0,,Beyaz Kurşun Hastalığı mı?!\NOlamaz! Birileri bana yardım etsin!
Dialogue: 0,0:12:58.33,0:13:00.46,Main,,0,0,0,,Beyaz Şehir kazazedesi!
Dialogue: 0,0:13:02.19,0:13:04.45,Main,,0,0,0,,Bir sonrakine gidelim!\NEminim bir sonraki çözümümüz olacak!
Dialogue: 0,0:13:04.45,0:13:06.40,Main,,0,0,0,,Yeter artık!\Nİstemiyorum!
Dialogue: 0,0:13:06.40,0:13:08.15,Main,,0,0,0,,Alo?! Dünya Hükümeti mi?!
Dialogue: 0,0:13:08.15,0:13:09.83,Main,,0,0,0,,Flevance kazazedesi var burada!
Dialogue: 0,0:13:09.83,0:13:11.50,Main,,0,0,0,,Neden hepsini de öldürmediniz?!
Dialogue: 0,0:13:11.50,0:13:14.88,Main,,0,0,0,,Bak Law!\NŞehir ne kadar da nazik duruyor!
Dialogue: 0,0:13:14.88,0:13:15.84,Main,,0,0,0,,İstemiyorum!
Dialogue: 0,0:13:15.84,0:13:18.96,Main,,0,0,0,,Olamaz, bize de bulaşacak!\NKaçın!
Dialogue: 0,0:13:19.94,0:13:22.08,Main,,0,0,0,,Sen de doktor musun be?!
Dialogue: 0,0:13:21.78,0:13:23.44,Secondary,,0,0,0,,{\a6}Sekiz hastane hasar gördü.
Dialogue: 0,0:13:22.30,0:13:23.74,Main,,0,0,0,,O ikisi nereye gitti?!
Dialogue: 0,0:13:23.74,0:13:25.63,Secondary,,0,0,0,,{\a6}Hastalıklı çocuk şu anda...
Dialogue: 0,0:13:25.63,0:13:30.39,Main,,0,0,0,,Corazon, hastalığımın iyileşmemesini geçtim,\Nartık dayanma gücüm kalmadı...
Dialogue: 0,0:13:30.39,0:13:33.22,Main,,0,0,0,,Sızlanmayı bırak!\NBir sonraki hastane çözümümüz olacak!
Dialogue: 0,0:13:33.22,0:13:36.87,Main,,0,0,0,,Ya tedaviyi bulacağız ya da öleceksin!\NHayatın söz konusu artık!
Dialogue: 0,0:13:36.87,0:13:38.06,Main,,0,0,0,,Dayan!
Dialogue: 0,0:13:38.06,0:13:39.84,Main,,0,0,0,,Beyaz Kurşun Hastalığı!
Dialogue: 0,0:13:39.84,0:13:42.03,Main,,0,0,0,,Hastaneyi kapatın! İçeri girecekler!
Dialogue: 0,0:13:42.03,0:13:45.06,Main,,0,0,0,,Hepinizi geberteceğim!
Dialogue: 0,0:13:45.06,0:13:46.47,Main,,0,0,0,,Yapma Corazon!
Dialogue: 0,0:13:46.64,0:13:48.86,Main,,0,0,0,,Corazon!
Dialogue: 0,0:13:54.54,0:13:59.35,Captions,,0,0,170,,{\fad(520,300)}6 Ay Sonra
Dialogue: 0,0:14:06.49,0:14:08.79,Main,,0,0,0,,Ne yapıyorum ben?
Dialogue: 0,0:14:08.79,0:14:13.85,Main,,0,0,0,,O acılarla dolu şehirde doğmuş çocuğa\Naynı acıları tekrar tekrar yaşatıyorum...
Dialogue: 0,0:14:14.62,0:14:16.82,Main,,0,0,0,,Üstelik bir gram bile iyileşemedi...
Dialogue: 0,0:14:18.27,0:14:19.66,Main,,0,0,0,,D. için mi yapıyorum bunu?
Dialogue: 0,0:14:20.62,0:14:23.61,Main,,0,0,0,,Hayır...\ND. falan umrumda değil artık.
Dialogue: 0,0:14:24.70,0:14:28.51,Main,,0,0,0,,Onun için...\NOnun için çok üzülüyorum.
Dialogue: 0,0:14:29.84,0:14:31.45,Main,,0,0,0,,Eminim ikide bir...
Dialogue: 0,0:14:31.95,0:14:34.84,Main,,0,0,0,,...canını yakan birinden...
Dialogue: 0,0:14:35.64,0:14:38.61,Main,,0,0,0,,...bunu duymak istemiyorsundur.
Dialogue: 0,0:14:40.80,0:14:43.28,Main,,0,0,0,,Senin gibi küçücük\Nkaba bir veletten...
Dialogue: 0,0:14:44.41,0:14:46.73,Main,,0,0,0,,..."Öleceğim nasılsa" lafını duymak...
Dialogue: 0,0:14:46.73,0:14:48.27,Main,,0,0,0,,...kalbimi acıtıyor.
Dialogue: 0,0:14:48.27,0:14:53.44,Main,,0,0,0,,Beni bıçakladığın o gün...
Dialogue: 0,0:14:54.78,0:14:56.56,Main,,0,0,0,,...zerre acımadı!
Dialogue: 0,0:14:57.78,0:15:00.64,Main,,0,0,0,,Acılar içinde olanın\Nsen olduğunu biliyorum!
Dialogue: 0,0:15:01.66,0:15:03.81,Main,,0,0,0,,Zavallı şey!
Dialogue: 0,0:15:04.18,0:15:04.95,Main,,0,0,0,,Law!
Dialogue: 0,0:15:24.36,0:15:25.48,Main,,0,0,0,,Cora-san...
Dialogue: 0,0:15:26.47,0:15:28.17,Main,,0,0,0,,Cora-san dedim!
Dialogue: 0,0:15:30.70,0:15:32.22,Main,,0,0,0,,Ne biçim surat o?!
Dialogue: 0,0:15:33.48,0:15:36.56,Main,,0,0,0,,Cora-san dedin bana...
Dialogue: 0,0:15:36.56,0:15:38.80,Main,,0,0,0,,Kapa çeneni!\NAç şu Den Den Mushi'yi!
Dialogue: 0,0:15:41.98,0:15:44.19,Main,,0,0,0,,{\i1}Benim, Corazon.{\i0}
Dialogue: 0,0:15:48.90,0:15:52.36,Main,,0,0,0,,Corazon, sensin değil mi?
Dialogue: 0,0:15:57.03,0:16:00.76,Main,,0,0,0,,{\i1}İkiniz çekip gideli\Naltı ay oldu.{\i0}
Dialogue: 0,0:16:01.14,0:16:02.67,Main,,0,0,0,,{\i1}Law da yanında mı?{\i0}
Dialogue: 0,0:16:04.48,0:16:05.74,Thoughts,,0,0,0,,{\i1}Doflamingo!{\i0}
Dialogue: 0,0:16:14.44,0:16:18.43,Main,,0,0,0,,{\i1}Anlıyorum.\Nİkinizin de iyi olması ne hoş!{\i0}
Dialogue: 0,0:16:18.43,0:16:20.50,Main,,0,0,0,,{\i1}Doktor bulabildiniz mi?{\i0}
Dialogue: 0,0:16:22.86,0:16:24.34,Main,,0,0,0,,Tahmin etmiştim.
Dialogue: 0,0:16:25.65,0:16:28.10,Main,,0,0,0,,Law'u da alıp gemiye geri dön.
Dialogue: 0,0:16:28.88,0:16:31.57,Main,,0,0,0,,{\i1}Hastalığını iyileştirebiliriz.{\i0}
Dialogue: 0,0:16:34.29,0:16:37.80,Main,,0,0,0,,{\i1}Elime Ope Ope Meyvesine dair\Nbilgi geçti.{\i0}
Dialogue: 0,0:16:38.88,0:16:42.58,Main,,0,0,0,,{\i1}Donanma'nın teklif ettiği\Nbüyük para karşısında...{\i0}
Dialogue: 0,0:16:42.58,0:16:47.95,Main,,0,0,0,,{\i1}...meyvenin asıl değerini bilmeyen\Naptal korsanlar takası kabul edecek gibi.{\i0}
Dialogue: 0,0:16:47.95,0:16:52.10,Main,,0,0,0,,Bu işin perde arkasında\Neminim Hükümet var.
Dialogue: 0,0:16:52.42,0:16:54.36,Main,,0,0,0,,Tehlikesi büyük ama\Nbu fırsatı değerlendireceğiz.
Dialogue: 0,0:16:57.43,0:17:01.25,Main,,0,0,0,,{\i1}Meyveyi ele geçirdiğimizde\Nvereceği güç yüzünden...{\i0}
Dialogue: 0,0:17:01.25,0:17:05.67,Main,,0,0,0,,{\i1}...onu en güvendiğim kişinin\Nyemesini istiyorum.{\i0}
Dialogue: 0,0:17:07.77,0:17:10.68,Main,,0,0,0,,{\i1}Senin yemeni, Corazon.{\i0}
Dialogue: 0,0:17:11.60,0:17:15.25,Main,,0,0,0,,{\i1}Ve Law'un hastalığını iyileştireceksin.{\i0}
Dialogue: 0,0:17:21.98,0:17:24.69,Main,,0,0,0,,Siz ne diyorsunuz?
Dialogue: 0,0:17:24.69,0:17:28.09,Main,,0,0,0,,Sık sık yerimizi bulup...
Dialogue: 0,0:17:29.26,0:17:32.73,Main,,0,0,0,,...peşimize takılan Tsuru da dahil...
Dialogue: 0,0:17:32.73,0:17:38.03,Main,,0,0,0,,...son altı ayda\NDonanma'nın yüzünü dahi görmedik.
Dialogue: 0,0:17:38.03,0:17:41.87,Main,,0,0,0,,Corazon'un aramızda olmadığı\No altı ayda.
Dialogue: 0,0:17:41.87,0:17:46.71,Main,,0,0,0,,Donanma'yı o mu haberdar ediyordu diyorsun?
Dialogue: 0,0:17:48.23,0:17:49.71,Main,,0,0,0,,Her şey şans eseri de olabilir.
Dialogue: 0,0:17:49.71,0:17:55.70,Main,,0,0,0,,Umarım öyledir.\NÖz kardeşimden...
Dialogue: 0,0:17:55.70,0:17:58.21,Main,,0,0,0,,...ben de şüphe duymak istemem.
Dialogue: 0,0:18:00.70,0:18:02.03,Main,,0,0,0,,Haberler dehşet, Law!
Dialogue: 0,0:18:04.28,0:18:07.82,Main,,0,0,0,,Kurtulma şansın var!\NDoktor falan kim takar artık!
Dialogue: 0,0:18:07.82,0:18:12.44,Main,,0,0,0,,Ope Ope Meyvesi'ni elde edebilirsek \NBeyaz Kurşun Hastalığı'nı da tedavi edebileceğiz!
Dialogue: 0,0:18:13.14,0:18:14.27,Main,,0,0,0,,Ope Ope Meyvesi de ne ki?
Dialogue: 0,0:18:14.27,0:18:16.88,Main,,0,0,0,,İnsan vücudunu modifiye etmeni\Nsağlayan bir güç veriyor.
Dialogue: 0,0:18:16.88,0:18:20.11,Main,,0,0,0,,Mucizevi ameliyatlar yaparak bilinmeyen\Nhastalıkları bile iyileştirebilirsin!
Dialogue: 0,0:18:21.27,0:18:23.65,Main,,0,0,0,,Öyle büyülü müyülü şeylere pek...
Dialogue: 0,0:18:23.65,0:18:28.02,Main,,0,0,0,,Hayır! Büyü değil bu!\NTıbbi bilgi şart elbette!
Dialogue: 0,0:18:30.70,0:18:37.30,Main,,0,0,0,,Tüm Flevance halkının \Ngüvendiği bir doktorun oğlu olduğunu biliyorum!
Dialogue: 0,0:18:37.93,0:18:41.73,Main,,0,0,0,,Meyve senin için biçilmiş kaftan işte!
Dialogue: 0,0:18:41.73,0:18:44.97,Main,,0,0,0,,Ben mi?!\NDoflamingo senin yemeni istemişti!
Dialogue: 0,0:18:48.68,0:18:51.86,Main,,0,0,0,,Kişi iki Şeytan Meyvesi yerse ölür.
Dialogue: 0,0:18:52.90,0:18:57.10,Main,,0,0,0,,Doffy halihazırda güç kullanıcısı olduğumu\Nbilmediği için öyle dedi.
Dialogue: 0,0:18:59.12,0:19:02.72,Main,,0,0,0,,İkimiz artık aileye dönmeyeceğiz!
Dialogue: 0,0:19:11.53,0:19:14.97,Main,,0,0,0,,Yolculuğumuzun düşündüğümden daha uzun\Nsüreceğini fark edince karar verdim.
Dialogue: 0,0:19:16.86,0:19:20.91,Main,,0,0,0,,Doffy artık muhtemelen\Nona ihanet ettiğimi biliyor.
Dialogue: 0,0:19:22.49,0:19:26.88,Main,,0,0,0,,Pek öyle gelmedi kulağa ama.\NHatta meyveyi bile sana ye dedi.
Dialogue: 0,0:19:26.88,0:19:31.72,Main,,0,0,0,,Doffy'nin Ope Ope Meyvesi'ni\Nyememi istemesinin başka bir nedeni var!
Dialogue: 0,0:19:35.51,0:19:36.92,Thoughts,,0,0,0,,{\i1}Doffy...{\i0}
Dialogue: 0,0:19:36.92,0:19:39.12,Thoughts,,0,0,0,,{\i1}Seni reddedemeyeceğimi bildiğinden...{\i0}
Dialogue: 0,0:19:39.49,0:19:42.29,Thoughts,,0,0,0,,{\i1}...hayatım karşılığında\Nsonsuz yaşam elde etmenin peşindesin.{\i0}
Dialogue: 0,0:19:42.87,0:19:44.81,Thoughts,,0,0,0,,{\i1}Geri dönersem canımdan olacağım!{\i0}
Dialogue: 0,0:19:45.52,0:19:51.24,Main,,0,0,0,,Beni dinle, Doffy'lerden önce davranıp\NOpe Ope Meyvesi'ni çalacağız!
Dialogue: 0,0:19:52.34,0:19:53.86,Main,,0,0,0,,Meyveyi sen yiyeceksin!
Dialogue: 0,0:19:54.47,0:19:58.14,Main,,0,0,0,,Sen iyileşince de\Nbir yerlere gider saklanırız!
Dialogue: 0,0:20:01.41,0:20:05.78,Main,,0,0,0,,Yelken açmaya hazırlan! \NOpe Ope Meyvesi'ni ne olursa olsun alacağız!
Dialogue: 0,0:20:10.20,0:20:12.83,Main,,0,0,0,,"Pirinç krakerleri!"
Dialogue: 0,0:20:12.83,0:20:14.32,Main,,0,0,0,,"Kraker topları!" Benim.
Dialogue: 0,0:20:14.32,0:20:18.73,Main,,0,0,0,,{\i1}Rosinante! Epeydir sesin soluğun çıkmıyor,\Nendişelendirdin beni!{\i0}
Dialogue: 0,0:20:18.73,0:20:20.53,Main,,0,0,0,,{\i1}Garp! Sen az git gezin!{\i0}
Dialogue: 0,0:20:20.53,0:20:25.71,Main,,0,0,0,,{\i1}Nedenmiş?! \NO kadar senbei krakeri getirdik sana! Çay koy!{\i0}
Dialogue: 0,0:20:25.71,0:20:27.40,Thoughts,,0,0,0,,{\i1}Koramiral Garp...{\i0}
Dialogue: 0,0:20:27.40,0:20:30.11,Main,,0,0,0,,Kötü bir zamanda mı aradım, Sengoku-san?
Dialogue: 0,0:20:30.11,0:20:35.38,Main,,0,0,0,,{\i1}Çık diyorum sana gerzek herif!\Nİşim var işim!{\i0}
Dialogue: 0,0:20:36.18,0:20:39.28,Main,,0,0,0,,Oh Kuzan!\NSenbei krakeri var, yer misin?!
Dialogue: 0,0:20:40.95,0:20:42.84,Main,,0,0,0,,{\i1}Şimdi müsait mi?{\i0}
Dialogue: 0,0:20:42.84,0:20:44.92,Main,,0,0,0,,Evet, kusura bakma.\NKonuşabilirsin.
Dialogue: 0,0:20:44.92,0:20:47.56,Main,,0,0,0,,{\i1}Ope Ope Meyvesi takasından\Nhaberiniz var mı?{\i0}
Dialogue: 0,0:20:51.60,0:20:53.56,Main,,0,0,0,,Onu nereden biliyorsun?!
Dialogue: 0,0:20:53.56,0:20:55.67,Main,,0,0,0,,Ağabeyim öğrenmiş.
Dialogue: 0,0:20:55.67,0:20:59.37,Main,,0,0,0,,Ne?! \NÇok gizli bir olaydı bu!
Dialogue: 0,0:21:00.22,0:21:03.27,Thoughts,,0,0,0,,{\i1}Cora-san'ın Den Den Mushi'de\Nkonuştuğu kişi...{\i0}
Dialogue: 0,0:21:03.27,0:21:06.58,Main,,0,0,0,,O korsanların\Nson göründükleri yeri soracaktım.
Dialogue: 0,0:21:06.58,0:21:10.35,Main,,0,0,0,,{\i1}Takas zamanından önce yerlerini\Nbulabileceğimizi sanmıyorum...{\i0}
Dialogue: 0,0:21:10.35,0:21:15.65,Main,,0,0,0,,Doflamingo'nun takas zamanından önce meyveyi\Nçalmaya çalışacağını söylesem bile mi?
Dialogue: 0,0:21:15.65,0:21:17.15,Main,,0,0,0,,{\i1}Doğru mu bu?!{\i0}
Dialogue: 0,0:21:17.15,0:21:18.78,Thoughts,,0,0,0,,{\i1}Tuhaf...{\i0}
Dialogue: 0,0:21:20.29,0:21:22.52,Thoughts,,0,0,0,,{\i1}Başım dönüyor sanki.{\i0}
Dialogue: 0,0:21:22.85,0:21:24.70,Main,,0,0,0,,Takas ne zaman ve nerede olacak?
Dialogue: 0,0:21:25.40,0:21:28.60,Main,,0,0,0,,{\i1}Üç hafta sonra,\NNorth Blue'nun Rubeck kasabasında.{\i0}
Dialogue: 0,0:21:29.66,0:21:31.10,Thoughts,,0,0,0,,{\i1}Rubeck...{\i0}
Dialogue: 0,0:21:32.10,0:21:38.18,Main,,0,0,0,,Takastan üç gün önce\NSwallow Adası'nda Doffy'lerle buluşacağım.
Dialogue: 0,0:21:38.18,0:21:39.88,Main,,0,0,0,,{\i1}Üç gün önce ha?{\i0}
Dialogue: 0,0:21:40.21,0:21:44.98,Main,,0,0,0,,{\i1}O zaman ailenin tüm üyeleri\Nsavaş zamanını orada bekleyeceklerdir.{\i0}
Dialogue: 0,0:21:45.29,0:21:46.95,Main,,0,0,0,,{\i1}Çok sağlam bir bilgi bu.{\i0}
Dialogue: 0,0:21:46.95,0:21:51.95,Main,,0,0,0,,Doflamingo'nun sonu geldi demektir!\NSwallow Adası'nda pusuya yatacak...
Dialogue: 0,0:21:51.95,0:21:55.58,Main,,0,0,0,,...ve Donquixote Ailesi'ni\Ntek hamlede yakalayacağız!
Dialogue: 0,0:21:56.05,0:21:58.03,Main,,0,0,0,,Sen adaya yaklaşma!
Dialogue: 0,0:21:58.92,0:22:00.32,Main,,0,0,0,,Kesinlikle.
Dialogue: 0,0:22:01.44,0:22:06.83,Main,,0,0,0,,Doffy'yle perde arkasından bağlantılı olan önemli kişilerin ve iş ortaklarının listesini...
Dialogue: 0,0:22:06.83,0:22:09.27,Main,,0,0,0,,...yakın bir zamanda ileteceğim.
Dialogue: 0,0:22:10.05,0:22:14.84,Main,,0,0,0,,North Blue'nun karanlık yüzünü\Ngün ışığına çıkartmanız için yeter de artar.
Dialogue: 0,0:22:14.84,0:22:16.75,Main,,0,0,0,,{\i1}Pekâlâ öyleyse.\NEllerine sağlık.{\i0}
Dialogue: 0,0:22:19.49,0:22:22.19,Main,,0,0,0,,Law! Hazır mısın?
Dialogue: 0,0:22:22.19,0:22:23.32,Main,,0,0,0,,Hemen yelken açmamız...
Dialogue: 0,0:22:24.02,0:22:25.42,Main,,0,0,0,,Law!
Dialogue: 0,0:22:25.42,0:22:29.24,Main,,0,0,0,,Şaka yapıyorsun değil mi?!\NKendine gel!
Dialogue: 0,0:22:30.90,0:22:34.00,Main,,0,0,0,,Tam talih yüzümüze güldü derken!
Dialogue: 0,0:22:34.00,0:22:36.21,Main,,0,0,0,,Üç sene olmadı ki daha!
Dialogue: 0,0:22:36.21,0:22:38.54,Main,,0,0,0,,Hesaplarına göre daha yaşaman gerekmiyor mu?!
Dialogue: 0,0:22:38.54,0:22:42.61,Main,,0,0,0,,Eyvah! Alev gibi yanıyor!\NNe yapmalı şimdi?!
Dialogue: 0,0:22:42.61,0:22:45.11,Main,,0,0,0,,Doktorlardan fayda yok!
Dialogue: 0,0:22:45.11,0:22:49.26,Main,,0,0,0,,Lanet olsun! \NNe yapayım ben şimdi?! Söylesene Law!
Dialogue: 0,0:22:49.26,0:22:50.75,Main,,0,0,0,,Dayan lütfen!
Dialogue: 0,0:22:51.92,0:22:54.86,Main,,0,0,0,,Üç hafta daha sık dişini!
Dialogue: 0,0:22:55.75,0:22:57.98,Main,,0,0,0,,En azından denemem için şans ver!
Dialogue: 0,0:23:02.47,0:23:11.37,Captions,,0,0,175,,{\fad(1000,0)}Takastan 3 Gün Önce
Dialogue: 0,0:23:04.08,0:23:06.98,Main,,0,0,3,,{\an8}Lanet olsun! Denizin bu kadar\Nhırçın olması şart mıydı?!
Dialogue: 0,0:23:07.38,0:23:08.89,Main,,0,0,3,,Cora-san...
Dialogue: 0,0:23:08.89,0:23:11.37,Main,,0,0,3,,Ne? Ne oldu, Law?!
Dialogue: 0,0:23:11.37,0:23:16.07,Main,,0,0,0,,Hükümet öleceğimizi bile bile...
Dialogue: 0,0:23:16.07,0:23:19.21,Main,,0,0,0,,...para kazanmak için\NBeyaz Kurşun çıkarttırdı bize!
Dialogue: 0,0:23:20.47,0:23:23.88,Main,,0,0,0,,Ailemi... Flevance halkını...
Dialogue: 0,0:23:24.98,0:23:27.25,Main,,0,0,0,,Hepsini de Hükümet öldürdü!
Dialogue: 0,0:23:31.16,0:23:36.04,Main,,0,0,0,,O yüzden sen de onlarla dost,\NDonanma askeriysen...
Dialogue: 0,0:23:36.04,0:23:37.83,Main,,0,0,0,,...açık açık söyle lütfen.
Dialogue: 0,0:23:37.83,0:23:41.37,Main,,0,0,0,,Ne saçmalıyorsun sen?!\NDonanma falan değilim ben!
Dialogue: 0,0:23:44.10,0:23:45.44,Main,,0,0,0,,Sevindim!
Dialogue: 0,0:23:45.44,0:23:49.11,Main,,0,0,0,,Hepsini geçtim, şunu bilmen lazım ki...
Dialogue: 0,0:23:49.11,0:23:51.71,Main,,0,0,0,,...Ope Ope Meyvesi'ni çalmamız demek...
Dialogue: 0,0:23:51.71,0:23:56.56,Main,,0,0,0,,...Doflamingo'yu da Donanma'yı da Hükümet'i de \Nherkesi karşımıza alacağız anlamına geliyor!
Dialogue: 0,0:23:56.97,0:23:59.26,Main,,0,0,0,,Herkes peşimize düşecek!
Dialogue: 0,0:24:00.50,0:24:02.60,Main,,0,0,0,,Canın uğruna savaşmaya hazır ol!
Dialogue: 0,0:24:07.80,0:24:15.55,Captions,,0,0,170,,{\fad(1000,769)}Minion Adası
Dialogue: 0,0:24:10.18,0:24:13.50,Main,,0,0,3,,Korsanları buldunuz mu, Sengoku-san?
Dialogue: 0,0:24:13.50,0:24:17.57,Main,,0,0,3,,{\i1}Evet, takasın yapılacağı ada\NRubeck'in doğusunda...{\i0}
Dialogue: 0,0:24:18.57,0:24:21.47,Main,,0,0,0,,{\i1}...Minion Adası'nda\Nbir hayalet kasaba var.{\i0}
Dialogue: 0,0:24:21.47,0:24:24.11,Main,,0,0,0,,{\i1}Anlaşılan orada saklanıyorlarmış.{\i0}
Dialogue: 0,0:24:25.21,0:24:29.48,Main,,0,0,0,,{\i1}Korsanın adı Diez Barrels.\NTanıdık geldi mi?{\i0}
Dialogue: 0,0:24:29.48,0:24:32.23,Main,,0,0,0,,Evet, eski Donanma subayı...
Dialogue: 0,0:24:32.23,0:24:33.64,Main,,0,0,0,,{\i1}Aynen öyle.{\i0}
Dialogue: 0,0:24:34.47,0:24:38.69,Main,,0,0,0,,{\i1}Gözcü gemimiz\NMinion Adası'nda bekliyor.{\i0}
Dialogue: 0,0:24:41.78,0:24:47.23,Main,,0,0,0,,{\i1}Bu sırada Doflamingo'yla buluşacak olduğun\NSwallow Adası'nda...{\i0}
Dialogue: 0,0:24:47.23,0:24:50.57,Main,,0,0,0,,{\i1}...iki savaş gemisi demirli.{\i0}
Dialogue: 0,0:24:51.57,0:24:55.77,Main,,0,0,0,,{\i1}Doflamingo'nun Ope Ope Meyvesi'ni\Nçalmasına izin vermeyeceğim!{\i0}
Dialogue: 0,0:24:56.57,0:25:00.44,Main,,0,0,0,,Law, fazla uzun sürmeyecek.\NBurada bekle.
Dialogue: 0,0:25:19.94,0:25:22.73,Main,,0,0,0,,Drie, içki!\Nİçki getir!
Dialogue: 0,0:25:24.05,0:25:25.44,Main,,0,0,0,,Hemen.
Dialogue: 0,0:25:25.44,0:25:29.80,Main,,0,0,0,,Tek bir meyve\Nne kadar tutuyor dersiniz?
Dialogue: 0,0:25:30.37,0:25:32.10,Main,,0,0,0,,Beş milyar teklif ettiler!
Dialogue: 0,0:25:34.41,0:25:38.28,Main,,0,0,0,,Aptallık resmen! \NHükümet kafayı falan mı sıyırdı acaba!?
Dialogue: 0,0:25:38.28,0:25:43.62,Main,,0,0,0,,O parayı bi' aldık mı artık\Nkorsanlık yapmamıza gerek kalmaz!
Dialogue: 0,0:25:46.33,0:25:47.42,Main,,0,0,0,,Aynen öyle!
Dialogue: 0,0:25:48.71,0:25:50.78,Main,,0,0,0,,Kulağa basit gibi geliyor ama...
Dialogue: 0,0:25:51.55,0:25:53.39,Main,,0,0,0,,...bunu doktorun teki yerse...
Dialogue: 0,0:25:53.39,0:25:57.30,Main,,0,0,0,,...tüm dünyada arzulanan\Nünlü biri haline gelir.
Dialogue: 0,0:25:59.48,0:26:05.20,Main,,0,0,0,,Dediklerine göre zamanında bunu yiyen doktor\Nsayısız mucizevi ameliyat gerçekleştirip...
Dialogue: 0,0:26:05.20,0:26:08.14,Main,,0,0,0,,...inatçı ve nadir hastalıklara\Nçare olmuş.
Dialogue: 0,0:26:09.22,0:26:13.19,Main,,0,0,0,,Tabii bizim umrumuzda\Nolmayan bir şey!
Dialogue: 0,0:26:13.19,0:26:15.05,Main,,0,0,0,,Para olarak daha iyi bizim için!
Dialogue: 0,0:26:15.05,0:26:16.72,Main,,0,0,0,,Aynen öyle!
Dialogue: 0,0:26:23.10,0:26:24.53,Main,,0,0,0,,Şuna bak, Law!
Dialogue: 0,0:26:25.33,0:26:28.87,Main,,0,0,0,,Dokunduğum her şeyin sesini kesecek\Nbir teknik bu!
Dialogue: 0,0:26:29.47,0:26:30.94,Main,,0,0,0,,{\fad(150,150)}Sakin!
Dialogue: 0,0:26:35.50,0:26:36.77,Note,,0,0,0,,Ses Yok!
Dialogue: 0,0:26:38.64,0:26:39.44,Thoughts,,0,0,0,,Surata bak...
Dialogue: 0,0:26:44.29,0:26:45.32,Note,,0,0,0,,Ses Yok!
Dialogue: 0,0:26:45.72,0:26:46.78,Note,,0,0,0,,Ses Yok!
Dialogue: 0,0:26:47.68,0:26:48.45,Thoughts,,0,0,0,,Koktu!
Dialogue: 0,0:26:49.25,0:26:51.82,Main,,0,0,0,,Gördün mü?!\NHiçbir şey duymadın değil mi?!
Dialogue: 0,0:26:51.82,0:26:54.76,Main,,0,0,0,,Böyle bir güç neyine yarayacak ki?!
Dialogue: 0,0:26:54.76,0:26:56.06,Main,,0,0,0,,Bir damla albenisi yok!
Dialogue: 0,0:26:57.02,0:26:59.56,Main,,0,0,0,,Baby 5'ın Buki Buki'si çok daha iyi!
Dialogue: 0,0:27:00.90,0:27:04.10,Main,,0,0,0,,Lanet olsun!\NHaklısın, keşke o güç bende de olsaydı...
Dialogue: 0,0:27:04.10,0:27:07.70,Main,,0,0,0,,Ama kimse benim kadar\Nsessiz bir ortamda uyuyamaz!
Dialogue: 0,0:27:07.70,0:27:08.96,Main,,0,0,0,,Kim takar ya!?
Dialogue: 0,0:27:28.26,0:27:30.19,Main,,0,0,0,,Bu titreme de neyin nesi!?
Dialogue: 0,0:27:31.33,0:27:36.49,Main,,0,0,0,,Kaptan, hiç ses çıkmadan bina patladı!
Dialogue: 0,0:27:36.49,0:27:39.44,Main,,0,0,0,,Ne dedin?!\NÖyle saçma şey mi olur?!
Dialogue: 0,0:27:41.09,0:27:43.21,Main,,0,0,0,,Hazine evi alev aldı!
Dialogue: 0,0:27:43.71,0:27:45.78,Main,,0,0,0,,Söndürün çabuk!
Dialogue: 0,0:27:45.78,0:27:46.98,Main,,0,0,0,,Ne oluyor?!
Dialogue: 0,0:27:50.31,0:27:52.12,Main,,0,0,0,,İzinsiz dolanan birileri mi var?!
Dialogue: 0,0:27:53.78,0:27:55.14,Main,,0,0,0,,Işıklar söndü!
Dialogue: 0,0:27:55.14,0:27:56.59,Main,,0,0,0,,Üstümüze cam parçaları düşüyor!
Dialogue: 0,0:27:56.59,0:27:59.22,Main,,0,0,0,,Lamba...\NLamba getirin!
Dialogue: 0,0:28:00.36,0:28:03.12,Main,,0,0,0,,Birileri ışık yaksın!
Dialogue: 0,0:28:04.96,0:28:07.03,Main,,0,0,0,,Çabuk ışık yaksanıza!
Dialogue: 0,0:28:22.98,0:28:26.22,Note,,0,0,0,,Ses Yok!
Dialogue: 0,0:28:34.53,0:28:37.23,Thoughts,,0,0,0,,{\i1}Başardım Law!\NOpe Ope Meyvesi'ni aldım!{\i0}
Dialogue: 0,0:28:39.06,0:28:41.10,Thoughts,,0,0,0,,{\i1}Hastalığın iyileşecek!{\i0}
Dialogue: 0,0:28:51.94,0:28:53.89,Main,,0,0,0,,Bu da kimin nesi?!\NÖdümü patlattı!
Dialogue: 0,0:28:53.89,0:28:55.98,Main,,0,0,0,,Nereden geldi ki?
Dialogue: 0,0:28:55.98,0:29:00.85,Main,,0,0,0,,Siyah paltolu bir adam\NOpe Ope Meyvesi'ni çaldı!
Dialogue: 0,0:29:00.85,0:29:02.49,Main,,0,0,0,,Kaçmasına izin vermeyin!
Dialogue: 0,0:29:04.22,0:29:05.42,Main,,0,0,0,,Bu o!
Dialogue: 0,0:29:20.42,0:29:23.74,Flashbacks,,0,0,0,,Zor olacak biliyorum\Nama biraz burada bekle.
Dialogue: 0,0:29:27.80,0:29:29.04,Flashbacks,,0,0,0,,Göz açıp kapayıncaya döneceğim.
Dialogue: 0,0:29:30.18,0:29:32.08,Flashbacks,,0,0,0,,Ope Ope Meyvesi'yle birlikte!
Dialogue: 0,0:29:34.95,0:29:39.00,OP11 Credits,,0,0,0,,Editing: Galaxy 9000\N\NTiming: Datenshi\N\NQC: Mr. Luffy\N\NSoundtracking: Halee\N\NTC/Infoboxes: Datenshi\N\NOriginal Translation: Yibis
