,0,0,0,100,100,0,0,1,2,0,2,10,10,15,1Style: King Punch,Impress BT,75,&H0071CAF9,&H00FFFFFF,&H005240CE,&H78000000,0,0,0,0,100,100,0,0,1,2,3,2,120,120,18,1Style: Author,Impress BT,25,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1,1,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:23.73,0:00:28.05,Credits,,0,0,0,,Translation & initial timing Tsuki Yibis (Opening)Dialogue: 0,0:00:28.13,0:00:32.14,Credits,,0,0,0,,Timing Galaxy 9000  Time-checking SewilDialogue: 0,0:00:34.64,0:00:37.58,Credits,,0,0,0,,Quality-checking Sewil Galaxy 9000 HaleeDialogue: 0,0:00:39.01,0:00:42.61,Credits,,0,0,0,,Soundtracking HaleeDialogue: 0,0:00:45.48,0:00:48.15,Credits,,0,0,0,,Video editing SewilDialogue: 0,0:01:00.40,0:01:04.50,Credits,,0,0,0,,Raw provider CrunchyrollDialogue: 0,0:00:01.26,0:00:03.90,Wake up! lyrics,,0,0,0,,♪ Gidelim tüm parıltımızla, koşar adım, sonsuza dek! ♪Dialogue: 0,0:00:03.93,0:00:06.66,Wake up! lyrics,,0,0,0,,♪ İlerlemeye devam edelim! ♪Dialogue: 0,0:00:06.70,0:00:09.57,Wake up! lyrics,,0,0,0,,♪ Değişmeyen bağlar mutlak aydınlatacak... ♪Dialogue: 0,0:00:09.63,0:00:12.67,Wake up! lyrics,,0,0,0,,♪ ...rüyamızın sonunu! ♪Dialogue: 0,0:00:12.77,0:00:15.27,Wake up! lyrics,,0,0,0,,♪ Uyan, uyan, uyan, uyan haydi kalbim! ♪Dialogue: 0,0:00:15.34,0:00:18.18,Wake up! lyrics,,0,0,0,,♪ Başaracağız! Durmaksızın devam! ♪Dialogue: 0,0:00:23.72,0:00:28.07,Wake up! lyrics,,0,0,0,,♪ Tek pusulamız özgürlüktür. En sıkı dostlarız. ♪Dialogue: 0,0:00:28.15,0:00:34.59,Wake up! lyrics,,0,0,0,,♪ Kendi rotamızı bundan sonra da yine kendimiz çizeceğiz. ♪Dialogue: 0,0:00:34.66,0:00:39.00,Wake up! lyrics,,0,0,0,,♪ Her gün tam hız ilerliyoruz. Doğuya git, batıya git. ♪Dialogue: 0,0:00:39.06,0:00:45.44,Wake up! lyrics,,0,0,0,,♪ Birbiri ardına yapmak istediğimiz şeyler buluyor ve yapıyoruz da hepsini. ♪Dialogue: 0,0:00:45.50,0:00:50.99,Wake up! lyrics,,0,0,0,,♪ Sabahları etmeye dayanamaz aceleci gönlümüz. (Bekleyemem!) ♪Dialogue: 0,0:00:51.11,0:00:56.05,Wake up! lyrics,,0,0,0,,♪ Neden alıp biz yapıştırmıyoruz güneşi göğe. ♪Dialogue: 0,0:00:56.11,0:00:58.95,Wake up! lyrics,,0,0,0,,♪ Zorla ve yola çıkmıyoruz! ♪Dialogue: 0,0:00:59.95,0:01:02.65,Wake up! lyrics,,0,0,0,,♪ Evet tüm parıltımızla, koşar adım, sonsuza dek! ♪Dialogue: 0,0:01:02.72,0:01:06.59,Wake up! lyrics,,0,0,0,,♪ Hayal kırıntılarımız birleştirerek. ♪Dialogue: 0,0:01:06.66,0:01:10.75,Wake up! lyrics,,0,0,0,,♪ Titretiyorsa eğer gönlünü var mı daha büyük hazine. ♪Dialogue: 0,0:01:10.83,0:01:13.43,Wake up! lyrics,,0,0,0,,♪ Gidelim tüm parıltımızla, koşar adım, sonsuza dek! ♪Dialogue: 0,0:01:13.50,0:01:16.13,Wake up! lyrics,,0,0,0,,♪ İlerlemeye devam edelim! ♪Dialogue: 0,0:01:16.20,0:01:19.17,Wake up! lyrics,,0,0,0,,♪ Değişmeyen bağlar mutlak aydınlatacak... ♪Dialogue: 0,0:01:19.24,0:01:22.24,Wake up! lyrics,,0,0,0,,♪ ...rüyamızın sonunu! ♪Dialogue: 0,0:01:22.31,0:01:24.94,Wake up! lyrics,,0,0,0,,♪ Uyan, uyan, uyan, uyan haydi kalbim ♪Dialogue: 0,0:01:25.01,0:01:27.41,Wake up! lyrics,,0,0,0,,♪ Başaracağız! Durmaksızın devam! ♪Dialogue: 0,0:01:29.41,0:01:32.85,Main,,0,0,0,,Karanlığa kapıl, Hasır Şapka!Dialogue: 0,0:01:33.38,0:01:42.09,Main,,0,0,0,,Yenilmeyeceğim! One Piece'i bulacak ve Korsanlar Kralı olacağım!Dialogue: 0,0:01:44.16,0:01:49.43,Wake up! lyrics,,0,0,0,,♪ Üstesinden geldiğimiz her zorluk arttırıyor olasılıkları. (Kalamam!) ♪Dialogue: 0,0:01:49.60,0:01:54.67,Wake up! lyrics,,0,0,0,,♪ Yarın da, öbürgün de... ♪Dialogue: 0,0:01:54.69,0:01:58.68,Wake up! lyrics,,0,0,0,,♪ Yaşayacağız o içimizi titreten yoğun heyecanı! ♪Dialogue: 0,0:01:58.71,0:02:01.15,Wake up! lyrics,,0,0,0,,♪ Evet tüm parıltımızla, koşar adım, sonsuza dek! ♪Dialogue: 0,0:02:01.21,0:02:05.25,Wake up! lyrics,,0,0,0,,♪ Merakının peşinden koşarken... ♪Dialogue: 0,0:02:05.32,0:02:09.35,Wake up! lyrics,,0,0,0,,♪ Git kaderinin götürdüğü yere keza budur macera dediğin. ♪Dialogue: 0,0:02:09.39,0:02:12.06,Wake up! lyrics,,0,0,0,,♪ Gidelim tüm parıltımızla, koşar adım, sonsuza dek! ♪Dialogue: 0,0:02:12.09,0:02:14.76,Wake up! lyrics,,0,0,0,,♪ Aç kalbinin rota haritasını... ♪Dialogue: 0,0:02:14.79,0:02:17.80,Wake up! lyrics,,0,0,0,,♪ Güçle olan o bağın ele geçirecek... ♪Dialogue: 0,0:02:17.86,0:02:20.93,Wake up! lyrics,,0,0,0,,♪ ...rüyanın sonunu! ♪Dialogue: 0,0:02:20.97,0:02:23.50,Wake up! lyrics,,0,0,0,,♪ Asla, asla, asla, asla engel olma! ♪Dialogue: 0,0:02:23.57,0:02:26.34,Wake up! lyrics,,0,0,0,,♪ Başaracağız! Durmaksızın devam! ♪Dialogue: 0,0:02:30.03,0:02:40.03,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gnsDialogue: 0,0:09:47.00,0:09:57.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gnsDialogue: 0,0:20:55.50,0:21:05.50,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gnsDialogue: 0,0:02:30.03,0:02:38.51,Title,,0,0,0,,B Bloğu Yanıyor! Tuhaf Rakipler ve Kral Yumruğu!Dialogue: 10,0:02:39.40,0:02:45.19,Main,,0,0,0,,O zamanlar Garp biz korsanlar için şeytanın ta kendisiydi.Dialogue: 10,0:02:45.19,0:02:50.50,Main,,0,0,0,,Üzerinden yıllar geçmesine rağmen aldığım yara hâlâ iyileşmedi.Dialogue: 10,0:02:50.50,0:02:52.65,Main,,0,0,0,,Hey, doğru mu bu?!?!Dialogue: 10,0:02:52.65,0:02:56.66,Main,,0,0,0,,Yok yahu, yanlış duydum ben! Adım Lucy benim!Dialogue: 10,0:02:58.34,0:03:02.60,Main,,0,0,0,,Dedenin bana yaptıklarının hesabını vereceksin.Dialogue: 10,0:03:02.60,0:03:04.49,Main,,0,0,0,,Dedemin yaptıkları beni zerre bağlamaz!Dialogue: 10,0:03:04.49,0:03:06.86,Main,,0,0,0,,Garp'ın torunusun yani!?Dialogue: 10,0:03:06.86,0:03:08.15,Main,,0,0,0,,Hayır, değilim!Dialogue: 10,0:03:08.25,0:03:11.42,Main,,0,0,0,,Gerçekten de Hasır Şapkalı Luffy isen...Dialogue: 10,0:03:12.23,0:03:13.97,Main,,0,0,0,,...seni şuracıkta doğrarım!Dialogue: 10,0:03:16.20,0:03:23.28,Main,,0,0,0,,Garp'ın oğlu Dragon'un varlığından daha önce haberim olsaydı...Dialogue: 10,0:03:24.44,0:03:28.64,Main,,0,0,0,,...sen doğmayacaktın bile.Dialogue: 10,0:03:32.40,0:03:33.90,Main,,0,0,0,,Hey, ne oldu?!Dialogue: 10,0:03:34.10,0:03:36.61,Main,,0,0,0,,Don Chinjao delirdi!Dialogue: 10,0:03:36.61,0:03:37.60,Main,,0,0,0,,Yok artık?!Dialogue: 10,0:03:37.60,0:03:39.00,Main,,0,0,0,,Bekle biraz, ihtiyar!Dialogue: 10,0:03:39.82,0:03:42.10,Main,,0,0,0,,Çıkart şu sakalı!Dialogue: 10,0:03:42.10,0:03:43.70,Main,,0,0,0,,Dur be! Çıkartmayacağım!Dialogue: 10,0:03:45.60,0:03:49.39,Main,,0,0,0,,Şaka mı bu yahu?! Gene mi saldıracak?Dialogue: 10,0:03:49.70,0:03:52.15,Main,,0,0,0,,Ne kadar paslanmıştır bilmiyorum ama...Dialogue: 10,0:03:52.15,0:03:56.20,Main,,0,0,0,,...en parlak dönemlerinde 500 milyondan fazla ödülü vardı bu adamın!Dialogue: 10,0:03:59.00,0:04:02.45,Main,,0,0,0,,Lanet olası Don Chinjao! Engel olup durma!Dialogue: 10,0:04:02.45,0:04:03.69,Main,,0,0,0,,Benim o!Dialogue: 10,0:04:07.64,0:04:09.98,Main,,0,0,0,,Cavendish kılıcını çekti!Dialogue: 10,0:04:09.98,0:04:14.40,Main,,0,0,0,,Dünyanın en iyi kılıçlarından biri olan Durandal bu mu?!Dialogue: 0,0:04:15.57,0:04:16.86,Main,,0,0,0,,Al bakalım!Dialogue: 10,0:04:16.86,0:04:17.70,Main,,0,0,0,,Kafa-Silahı!Dialogue: 10,0:04:17.92,0:04:18.82,Main,,0,0,0,,Güzel Kılıç!Dialogue: 0,0:04:18.96,0:04:20.70,Main,,0,0,0,,Mavi Kuş!Dialogue: 10,0:04:25.72,0:04:27.47,Main,,0,0,0,,Kafasını deldi!Dialogue: 10,0:04:27.47,0:04:29.19,Main,,0,0,0,,Hayır, delmedi!Dialogue: 10,0:04:33.91,0:04:35.65,Main,,0,0,0,,Birbirlerini ittiriyorlar!Dialogue: 10,0:04:38.90,0:04:40.65,Main,,0,0,0,,Durandal'ı batıramıyorum!Dialogue: 10,0:04:40.65,0:04:45.05,Main,,0,0,0,,Bir yanda kılıca karşı dayanıklı bir kafa, öte yanda devi tutabilecek bir güç!Dialogue: 10,0:04:45.05,0:04:46.71,Main,,0,0,0,,Hiçbir insan yapamaz bunları!Dialogue: 10,0:04:51.64,0:04:54.22,Main,,0,0,0,,İyice kolları sıvamadan yenemeyeceğim anlaşılan!Dialogue: 10,0:04:55.16,0:04:56.58,Main,,0,0,0,,Seni adi!Dialogue: 10,0:04:59.15,0:05:01.04,Main,,0,0,0,,Dur dedik sana!Dialogue: 10,0:05:05.61,0:05:07.59,Main,,0,0,0,,Chinjao'yu devirdi!Dialogue: 10,0:05:07.84,0:05:10.42,Main,,0,0,0,,Bu sakallı bücür de kimin nesi!?Dialogue: 10,0:05:13.76,0:05:15.82,Main,,0,0,0,,Amanın...Dialogue: 10,0:05:15.82,0:05:18.64,Main,,0,0,0,,Bir işe yaramamış!Dialogue: 10,0:05:18.64,0:05:21.73,Main,,0,0,0,,O efsane gerçek mi acaba?Dialogue: 10,0:05:21.73,0:05:25.96,Main,,0,0,0,,Sözde bir kafa atışıyla Donuk Kıta'yı kırmış!Dialogue: 10,0:05:25.96,0:05:27.60,Main,,0,0,0,,Kafa atarak mı?!Dialogue: 10,0:05:27.60,0:05:31.87,Main,,0,0,0,,Zerre etki etmemiş. Oysaki epey sağlam vurmuştum.Dialogue: 10,0:05:36.55,0:05:38.63,Main,,0,0,0,,Amanın...Dialogue: 10,0:05:38.63,0:05:42.92,Main,,0,0,0,,Görünüşe bakılırsa ikiniz de epey güçlüsünüz.Dialogue: 10,0:05:42.92,0:05:46.82,Main,,0,0,0,,Fakat daha çok çalışmanız lazım!Dialogue: 10,0:05:46.82,0:05:51.36,Main,,0,0,0,,Bu denli güçlü oluşuna bakarsak Hasır Şapka olduğuna şüphe yok.Dialogue: 10,0:05:51.66,0:05:53.83,Main,,0,0,0,,Ne istiyorsun ya! Rahat bırak beni!Dialogue: 10,0:05:53.83,0:05:55.98,Main,,0,0,0,,Başkalarının şanını çalmanla olsun...Dialogue: 10,0:05:55.98,0:05:58.12,Main,,0,0,0,,...kabus olmuş bir dedenin torunu olmanla olsun...Dialogue: 10,0:05:58.12,0:06:00.27,Main,,0,0,0,,...nefreti üzerine çekmede üstüne yok gibi!Dialogue: 10,0:06:00.27,0:06:03.07,Main,,0,0,0,,Hiçbiri benim suçum değil ki!Dialogue: 10,0:06:03.78,0:06:05.61,Main,,0,0,0,,Zaten Lucy'im ben.Dialogue: 10,0:06:05.61,0:06:11.41,Main,,0,0,0,,Yoluma çıkacak olursan seni de öldürmek zorunda kalırım, genç şövalye!Dialogue: 10,0:06:18.01,0:06:21.04,Main,,0,0,0,,Bekle ihtiyar! Yeter bu kadar!Dialogue: 10,0:06:21.04,0:06:23.23,Main,,0,0,0,,Burada kontrolünü kaybedersen eleneceksin!Dialogue: 10,0:06:23.59,0:06:25.63,Main,,0,0,0,,Kano Krallığı'ndan Sai'yle Boo bunlar!Dialogue: 10,0:06:26.99,0:06:29.67,Main,,0,0,0,,Bırakın beni ey güzel torunlarım!Dialogue: 10,0:06:29.67,0:06:32.59,Main,,0,0,0,,Olmaz! Neden yapıyorsun bilmiyorum ama buna izin veremeyiz!Dialogue: 10,0:06:32.59,0:06:36.69,Main,,0,0,0,,Sonunda ebedi düşmanımı, Garp'ın tohumunu buldum!Dialogue: 10,0:06:36.69,0:06:38.09,Main,,0,0,0,,Şimdi elenecek olursak...Dialogue: 10,0:06:38.09,0:06:41.93,Main,,0,0,0,,...buraya gelmemizdeki asıl hedefe ulaşamayacağız, ihtiyar!Dialogue: 10,0:06:41.93,0:06:45.34,Main,,0,0,0,,Ne yapıyorsunuz siz orada?!Dialogue: 10,0:06:45.34,0:06:48.91,Main,,0,0,0,,Arena dışında savaşıyorsanız sizi atmak zorunda kalacağız!Dialogue: 10,0:06:50.51,0:06:52.31,Main,,0,0,0,,Muhafızlar geliyor.Dialogue: 10,0:06:52.31,0:06:54.44,Main,,0,0,0,,Elenip elenmemek umrumda değil!Dialogue: 10,0:06:54.44,0:06:56.26,Main,,0,0,0,,Seni şuracıkta...Dialogue: 10,0:06:57.95,0:06:59.52,Main,,0,0,0,,Nereye gitti?!Dialogue: 10,0:07:00.85,0:07:06.33,Main,,0,0,0,,İhtiyar, sahte sakallı o adi de bizimle birlikte C Bloğu'nda!Dialogue: 10,0:07:07.91,0:07:10.53,Main,,0,0,0,,Öldüreceksen arenaya sakla!Dialogue: 10,0:07:10.73,0:07:13.70,Main,,0,0,0,,Kaçmana izin vermem, Hasır Şapka!Dialogue: 10,0:07:13.70,0:07:18.67,Main,,0,0,0,,Savaş başlamadan alacağım canını!Dialogue: 10,0:07:18.67,0:07:23.61,Main,,0,0,0,,Darmaduman ettiler etrafı. Mesele neydi acaba?Dialogue: 10,0:07:23.61,0:07:26.42,Main,,0,0,0,,Hasır Şapka dediklerini duydum ama...Dialogue: 10,0:07:26.42,0:07:30.83,Main,,0,0,0,,Hasır Şapka demek? Akıllara korsan Hasır Şapkalı Luffy geliyor.Dialogue: 10,0:07:30.83,0:07:32.39,Main,,0,0,0,,Sence o da mı katılmıştır?Dialogue: 10,0:07:32.59,0:07:34.36,Main,,0,0,0,,Yok canım sen de!Dialogue: 10,0:07:35.22,0:07:37.02,Main,,0,0,0,,İşe bak...Dialogue: 10,0:07:37.07,0:07:41.18,Main,,0,0,0,,Kim olduğumu kimseye belli etmeyeceğim diye Franky'e söz vermiştim oysa.Dialogue: 10,0:07:42.20,0:07:46.40,Main,,0,0,0,,Gözlerime inanamıyorum! Tank'ı devirdiler!Dialogue: 10,0:07:47.65,0:07:53.25,Main,,0,0,0,,Dressrosa Savunma Ordusu komutanı Tank Lepant elendi!Dialogue: 10,0:07:53.25,0:07:58.31,Main,,0,0,0,,Abdullah ve Jeet ikilisine kurban düştü!Dialogue: 10,0:07:58.31,0:08:01.36,Main,,0,0,0,,Kalleşçe savaşıyorlar!Dialogue: 10,0:08:01.36,0:08:03.19,Main,,0,0,0,,Tank Komutan!Dialogue: 10,0:08:03.19,0:08:06.62,Main,,0,0,0,,100'den fazla kişinin elenmesinin ardından...Dialogue: 10,0:08:06.62,0:08:10.28,Main,,0,0,0,,...arenada nihayetinde 30 kişi kaldı!Dialogue: 10,0:08:11.86,0:08:13.30,Main,,0,0,0,,Çok az kaldı!Dialogue: 10,0:08:13.30,0:08:17.07,Main,,0,0,0,,Geri kalanlar ne kadar güçlü olurlarsa olsunlar Kral Yumruğu'muz oldukça kazanacağız.Dialogue: 10,0:08:17.51,0:08:19.61,Main,,0,0,0,,Sırada kim var?Dialogue: 10,0:08:19.61,0:08:23.65,Main,,0,0,0,,Kan görmek isteyen çıksın karşımıza!Dialogue: 10,0:08:23.65,0:08:26.09,Main,,0,0,0,,Güçlü adam Lepant'ı devirmiş Abdullah ve Jeet ikilisi...Dialogue: 10,0:08:26.09,0:08:29.02,Main,,0,0,0,,...bir sonraki rakiplerini kışkırtmaya çalışıyorlar!Dialogue: 10,0:08:42.05,0:08:44.10,Main,,0,0,0,,Bellamy!Dialogue: 10,0:08:44.10,0:08:46.50,Main,,0,0,0,,Zalim... Kötü...Dialogue: 10,0:08:46.59,0:08:50.78,Main,,0,0,0,,Bu sözler sanırsınız bu adam için var!Dialogue: 10,0:08:56.19,0:09:01.50,Main,,0,0,0,,Aynı zamanda da iki güçlü adam Jiaokungdo dövüş sanatı ustası...Dialogue: 10,0:09:01.50,0:09:06.80,Main,,0,0,0,,...Blue Gilly ile  gizemli gladyatör Ricky savaşıyor!Dialogue: 10,0:09:09.34,0:09:12.04,Main,,0,0,0,,Şu Balık-Adam çok güçlü var ya!Dialogue: 10,0:09:12.24,0:09:15.53,Main,,0,0,0,,Deminden beri rakiplerini birer yumrukta indiriyor resmen!Dialogue: 10,0:09:15.53,0:09:17.19,Main,,0,0,0,,Acayip bir şey!Dialogue: 10,0:09:18.05,0:09:19.45,Main,,0,0,0,,Heyecandan öleceğim!Dialogue: 10,0:09:26.50,0:09:27.75,Main,,0,0,0,,Durdurun şunu!Dialogue: 10,0:09:27.85,0:09:30.08,Main,,0,0,0,,İnanamıyorum!Dialogue: 10,0:09:30.18,0:09:34.99,Main,,0,0,0,,Bartolomeo insanlarla daha ne kadar dalga geçmeyi planlıyor?Dialogue: 10,0:09:35.09,0:09:37.79,Main,,0,0,0,,Neden kimse ağzını burnunu kırmıyor şunun?Dialogue: 10,0:09:39.29,0:09:42.46,Main,,0,0,0,,Onlarca seyirci karşısında...Dialogue: 10,0:09:42.46,0:09:46.17,Main,,0,0,0,,...şeyini çıkarttı ve işemeye başladı!Dialogue: 10,0:09:46.17,0:09:50.37,Main,,0,0,0,,Kolezyum kolezyum olalı böyle bir şey görmedi!Dialogue: 10,0:09:52.20,0:09:55.14,Main,,0,0,0,,Ferahladım resmen!Dialogue: 10,0:09:55.49,0:10:00.98,Main,,0,0,0,,Birileri şunu durdursun!Dialogue: 10,0:10:02.30,0:10:04.50,Main,,0,0,0,,Ve işte o birileri geldi!Dialogue: 10,0:10:04.50,0:10:07.83,Main,,0,0,0,,Kimilerimiz bu savaşı ciddiye alıyoruz, evlat!Dialogue: 10,0:10:07.83,0:10:08.81,Main,,0,0,0,,Ne dedin?Dialogue: 10,0:10:08.81,0:10:13.11,Main,,0,0,0,,Arkadan saldırdığım için bağışlarsın artık!Dialogue: 10,0:10:13.85,0:10:18.29,Main,,0,0,0,,Dur biraz! Savaşmaya hazır değilim daha!Dialogue: 10,0:10:18.39,0:10:22.93,Main,,0,0,0,,Cezayı kesmeye gelen kahraman savaşçı Balık-Adam Hack!Dialogue: 0,0:10:25.36,0:10:27.94,Main,,0,0,0,,4000 Tuğla...Dialogue: 10,0:10:27.94,0:10:31.98,Main,,0,0,0,,Göster şuna gününü Hack!Dialogue: 0,0:10:31.98,0:10:33.95,Main,,0,0,0,,...Yumruğu!Dialogue: 10,0:10:40.90,0:10:43.71,Main,,0,0,0,,Dermişim!Dialogue: 10,0:10:46.60,0:10:50.25,Main,,0,0,0,,Ne yaptı?! Niye Hack devrildi?Dialogue: 10,0:10:50.25,0:10:52.99,Main,,0,0,0,,Neler oluyor?!Dialogue: 10,0:10:52.99,0:10:55.36,Main,,0,0,0,,Bu da neydi?Dialogue: 10,0:10:55.36,0:10:59.05,Main,,0,0,0,,Ne tür bir yaratıksın sen...Dialogue: 10,0:10:59.05,0:11:01.86,Main,,0,0,0,,...Bartolomeo?!Dialogue: 10,0:11:10.36,0:11:12.94,Main,,0,0,0,,Hack yenildi!Dialogue: 10,0:11:13.88,0:11:17.02,Main,,0,0,0,,Hem de kılına bile dokunamadan!Dialogue: 10,0:11:18.02,0:11:21.14,Main,,0,0,0,,Bartolomeo ne yaptı öyle!?Dialogue: 10,0:11:21.24,0:11:26.94,Main,,0,0,0,,Lanet olsun! Hack'ı destekliyordum ben, geberesice horoz kafa seni!Dialogue: 10,0:11:26.94,0:11:28.90,Main,,0,0,0,,Gyats-san, sizin herkese eşit davranmanız lazım!Dialogue: 10,0:11:29.06,0:11:32.07,Main,,0,0,0,,Henüz kimin kazanacağı belli değil!Dialogue: 10,0:11:32.07,0:11:35.37,Main,,0,0,0,,B Bloğunda 24 yarışmacı kaldı.Dialogue: 10,0:11:35.37,0:11:37.87,Main,,0,0,0,,Yakında sonuç belli olacak desene.Dialogue: 10,0:11:38.36,0:11:40.34,Main,,0,0,0,,Kendini epey bir şey sanıyor bu!Dialogue: 10,0:11:42.80,0:11:44.17,Main,,0,0,0,,Artık herkes yara aldı sayılır!Dialogue: 10,0:11:44.78,0:11:46.67,Main,,0,0,0,,Vakit geldi sayılır!Dialogue: 10,0:11:52.57,0:11:55.81,Main,,0,0,0,,Güçlü yarışmacılar birbiri ardına eleniyorlar!Dialogue: 10,0:11:55.81,0:12:00.80,Main,,0,0,0,,Hack'ın ardından gizemli gladyatör Ricky de zeminin tozundan nasibini alıyor!Dialogue: 10,0:12:00.80,0:12:02.96,Main,,0,0,0,,Blue Gilly tam güç ayakta!Dialogue: 10,0:12:03.73,0:12:05.54,Main,,0,0,0,,Blue Gilly-sama!Dialogue: 10,0:12:05.80,0:12:10.55,Main,,0,0,0,,Öyle kör bir kılıçla ne kesmeyi planlıyordun ihtiyar?Dialogue: 10,0:12:10.55,0:12:13.89,Thoughts,,0,0,0,,Yaşlanmaya engel olamıyor insan.Dialogue: 10,0:12:17.99,0:12:20.89,Thoughts,,0,0,0,,Tüm bu tezahürat midemi bulandırıyor.Dialogue: 10,0:12:21.24,0:12:25.33,Thoughts,,0,0,0,,Doflamingo, midemi bulandırıyorsun!Dialogue: 10,0:12:32.22,0:12:36.57,Main,,0,0,0,,Dagama'nın planı sayesinde geriye pek kimse kalmadı!Dialogue: 10,0:12:37.07,0:12:40.79,Main,,0,0,0,,Dagama işaret verdiğinde bu birlik de son bulacak.Dialogue: 10,0:12:40.79,0:12:44.24,Main,,0,0,0,,Ondan sonra da savaşıp kendi aramızda bir birinci belirleyeceğiz.Dialogue: 10,0:12:48.80,0:12:52.90,Main,,0,0,0,,Millet, hâlâ beraberken Blue Gilly'nin işini bitirin!Dialogue: 10,0:12:53.07,0:12:53.89,Main,,0,0,0,,Tamamdır!Dialogue: 10,0:13:09.36,0:13:10.50,Main,,0,0,0,,Dagama?!Dialogue: 10,0:13:12.34,0:13:15.47,Main,,0,0,0,,Ellerinize sağlık, geri zekalı köpekler sizi!Dialogue: 10,0:13:16.29,0:13:17.37,Main,,0,0,0,,Neden?Dialogue: 10,0:13:17.37,0:13:19.24,Main,,0,0,0,,Bize işaret verecektin!Dialogue: 10,0:13:19.24,0:13:22.15,Main,,0,0,0,,Yoksa sen... Dagama!Dialogue: 10,0:13:26.75,0:13:28.09,Main,,0,0,0,,Siz...Dialogue: 10,0:13:29.52,0:13:34.35,Main,,0,0,0,,Kusuruma bakmayın, avlanması gereken köpekler varmış.Dialogue: 10,0:13:34.35,0:13:36.44,Main,,0,0,0,,Birlik mi oldunuz?!Dialogue: 10,0:13:36.44,0:13:39.23,Main,,0,0,0,,Ta en başından beri bizden kurtulmayı mı planlıyorsunuz?Dialogue: 10,0:13:41.77,0:13:46.64,Main,,0,0,0,,Sonra paralarınızı vereceğim! Sizin burada işiniz kalmadı!Dialogue: 10,0:13:46.64,0:13:47.95,Main,,0,0,0,,Dagama!Dialogue: 10,0:13:52.54,0:13:56.66,Main,,0,0,0,,Kafalarını kullanamayan savaşçılar cephede birer piyon olmaktan öte gidemezler!Dialogue: 10,0:13:56.66,0:13:58.68,Main,,0,0,0,,Sana güveniyorum, Uzunbacaklı Adam!Dialogue: 10,0:14:01.40,0:14:05.02,Main,,0,0,0,,Bana arkanı dönmenle senin de işin bitmiş oldu...Dialogue: 10,0:14:05.02,0:14:06.88,Main,,0,0,0,,...Blue Gilly.Dialogue: 10,0:14:09.97,0:14:10.96,Main,,0,0,0,,Ne?!Dialogue: 10,0:14:14.37,0:14:17.02,Main,,0,0,0,,Hain Blue Gilly!Dialogue: 10,0:14:18.95,0:14:22.49,Main,,0,0,0,,Taktikçi Dagama elendi!Dialogue: 10,0:14:24.92,0:14:26.80,Main,,0,0,0,,İyi hareketti, Uzunbacaklı Adam!Dialogue: 10,0:14:26.80,0:14:28.59,Main,,0,0,0,,Blue Gilly-sama!Dialogue: 10,0:14:29.56,0:14:35.39,Main,,0,0,0,,İnsanların senin gibi şüpheli birine inanmaları bile benim için büyük bir şok.Dialogue: 10,0:14:35.39,0:14:38.12,Main,,0,0,0,,Öte yandaysa...Dialogue: 10,0:14:45.93,0:14:49.91,Main,,0,0,0,,Devrilen kişi saldırıyı yapan Bellamy oldu!Dialogue: 10,0:14:51.31,0:14:54.57,Main,,0,0,0,,Bu Bartolomeo ne yaptı?!Dialogue: 10,0:14:56.34,0:14:58.44,Main,,0,0,0,,Gözlerime inanamıyorum!Dialogue: 10,0:14:58.69,0:15:02.52,Main,,0,0,0,,Adamımız Bellamy tükendi!Dialogue: 10,0:15:03.89,0:15:08.12,Main,,0,0,0,,Ne tür bir güç kullanıcısı bu?!Dialogue: 10,0:15:11.87,0:15:13.03,Main,,0,0,0,,Bellamy...Dialogue: 0,0:15:13.03,0:15:17.57,Main,,0,0,0,,Bellamy de aynı Hack gibi kendi saldırıp kendi yaralandı!Dialogue: 0,0:15:17.57,0:15:20.07,Main,,0,0,0,,Bu herif ne yaptı ona?Dialogue: 10,0:15:20.37,0:15:23.53,Main,,0,0,0,,Hey, Bellamy, dayan!Dialogue: 10,0:15:25.50,0:15:28.97,Main,,0,0,0,,Şimdi ne yapacaksın bakalım, Elizabello?Dialogue: 10,0:15:28.97,0:15:32.51,Main,,0,0,0,,Arkasına sığınacağı adamları olmayan kraldan daha çaresizini bulamazsın!Dialogue: 10,0:15:35.41,0:15:39.22,Main,,0,0,0,,Herkes seni öldürmek için can atıyormuş.Dialogue: 10,0:15:46.51,0:15:49.44,Main,,0,0,0,,Dagama işini layıkıyla yerine getirdi.Dialogue: 10,0:15:49.44,0:15:51.84,Main,,0,0,0,,Hazırım artık.Dialogue: 10,0:15:51.84,0:15:53.90,Main,,0,0,0,,Geriye yumruğumu sallamak kalıyor!Dialogue: 10,0:15:55.01,0:15:59.68,Main,,0,0,0,,Bizler o pozisyondayken korunan kişiler asıl sizdiniz.Dialogue: 10,0:15:59.68,0:16:03.84,Main,,0,0,0,,Keza kınından çıkmış kılıç kadar tehlikeli başka hiçbir şey yoktur.Dialogue: 10,0:16:03.84,0:16:07.71,Main,,0,0,0,,Haksız mıyım, delikanlı?Dialogue: 10,0:16:10.39,0:16:13.46,Main,,0,0,0,,Baksana, şimdi düşündüm de...Dialogue: 10,0:16:13.46,0:16:14.10,Main,,0,0,0,,Ne oldu?Dialogue: 10,0:16:14.20,0:16:18.30,Main,,0,0,0,,Prodence kralıyla ilgili tek yumrukta...Dialogue: 10,0:16:18.30,0:16:22.31,Main,,0,0,0,,...düşman kalesini yerle bir etti diye bir haber vardı.Dialogue: 10,0:16:22.31,0:16:25.71,Main,,0,0,0,,Yok canım daha neler! Bir çeşit silah falan kullanmıştır.Dialogue: 10,0:16:25.71,0:16:30.56,Main,,0,0,0,,Hayır, sözde Yonkou'ları bile devirebilecek bir yumrukmuş!Dialogue: 10,0:16:30.56,0:16:31.17,Main,,0,0,0,,Ne?Dialogue: 10,0:16:31.95,0:16:35.72,Main,,0,0,0,,Eğer bu doğruysa ve o yumruğu atacak olursa...Dialogue: 10,0:16:35.72,0:16:38.82,Main,,0,0,0,,...Kolezyumun bu tarafına denk gelecek!Dialogue: 10,0:16:38.82,0:16:39.66,Main,,0,0,0,,Ne?!Dialogue: 10,0:16:39.66,0:16:42.11,Main,,0,0,0,,Öyle şey gerçek olur mu hiç yahu!?Dialogue: 10,0:16:42.11,0:16:44.88,Main,,0,0,0,,Ben de duymuştum o haberi!Dialogue: 10,0:16:44.88,0:16:49.29,Main,,0,0,0,,Böyle bir yerde o denli yıkım gücü olan bir yumruk fırlatamaz!Dialogue: 10,0:16:55.04,0:16:57.24,Main,,0,0,0,,Havaya tuhaf bir tedirginlik hakim!Dialogue: 10,0:16:57.24,0:17:01.00,Main,,0,0,0,,Bulunduğu posizyonda şu ana dek kıpırdamamış olan kral harekete geçti!Dialogue: 10,0:17:07.24,0:17:12.31,Main,,0,0,0,,Mera Mera Meyvesi bizim, Prodence Krallığı'nın olacak!Dialogue: 10,0:17:13.70,0:17:15.33,Main,,0,0,0,,Hiç iyi görünmüyor durum!Dialogue: 10,0:17:15.33,0:17:16.18,Main,,0,0,0,,Şaka mı bu?!Dialogue: 10,0:17:16.18,0:17:19.09,Main,,0,0,0,,Burası güvenli değil!Dialogue: 10,0:17:19.09,0:17:20.02,Main,,0,0,0,,Kaçın!Dialogue: 10,0:17:24.83,0:17:28.36,Main,,0,0,0,,Yoksa o kaleyi yerle bir etme olayı gerçek miymiş?!Dialogue: 10,0:17:31.95,0:17:35.27,Main,,0,0,0,,Amma inatçı çıktın ha! Bu ne şimdi? Bırak yakamı!Dialogue: 10,0:17:36.49,0:17:40.29,Main,,0,0,0,,Bırakmam! Yayımın gücünü hafife alma!Dialogue: 0,0:17:45.76,0:17:49.47,King Punch,,0,0,0,,Kral...Dialogue: 10,0:17:51.77,0:17:53.48,Main,,0,0,0,,Elizabello'yu öldüreceğim!Dialogue: 10,0:17:53.48,0:17:54.39,Main,,0,0,0,,Çekil yolumdan!Dialogue: 0,0:17:54.51,0:17:56.51,Main,,0,0,0,,Kayan...Dialogue: 0,0:17:56.87,0:18:00.24,King Punch,,0,0,0,,...Yumruğu!Dialogue: 10,0:18:32.44,0:18:34.50,Main,,0,0,0,,Nasıl...Dialogue: 10,0:18:34.50,0:18:37.66,Main,,0,0,0,,Nasıl bir güçtür bu böyle?!Dialogue: 10,0:18:37.66,0:18:41.40,Main,,0,0,0,,Arenadaki kimsenin bundan sağ kurtulabileceğini sanmıyorum!Dialogue: 10,0:18:43.07,0:18:45.10,Main,,0,0,0,,Harika bir yumruktu!Dialogue: 10,0:18:45.10,0:18:46.60,Main,,0,0,0,,Böyle bir şeyi ilk defa görüyorum!Dialogue: 10,0:18:46.60,0:18:48.88,Main,,0,0,0,,Bellamy! Blue Gilly!Dialogue: 10,0:18:48.88,0:18:53.18,Main,,0,0,0,,...ve diğer tüm potansiyel galipler elendiler!Dialogue: 10,0:18:53.18,0:18:57.28,Main,,0,0,0,,B Bloğu, 138 kişilik serbest dövüşün kazananı...Dialogue: 10,0:18:57.28,0:18:59.31,Main,,0,0,0,,...Prodence Krallığı'ndan çıkıp gelmiş...Dialogue: 10,0:18:59.31,0:19:02.15,Main,,0,0,0,,Şuna bakın, biri var!Dialogue: 10,0:19:03.22,0:19:05.16,Main,,0,0,0,,Gördünüz mü? Orada işte!Dialogue: 10,0:19:05.16,0:19:09.39,Main,,0,0,0,,O taraftaki seyirci onun savunması sayesinde yerlerinden savrulmamış!Dialogue: 0,0:19:14.12,0:19:15.52,Main,,0,0,0,,Bariyer!Dialogue: 10,0:19:17.47,0:19:21.07,Main,,0,0,0,,İnsanlar parmak çaprazlayarak bariyer yaratabilirler.Dialogue: 10,0:19:21.07,0:19:23.67,Main,,0,0,0,,Çocuklar bile bilir bunu be!Dialogue: 10,0:19:24.25,0:19:27.71,Main,,0,0,0,,Ben Bari Bari Meyvesi yemiş bariyer insanım!Dialogue: 0,0:19:27.71,0:19:30.17,Main,,0,0,0,,Bariyer Çarpması!Dialogue: 10,0:19:39.04,0:19:43.71,Main,,0,0,0,,Dövüşçü Kral 2. Elizabello devrildi!Dialogue: 10,0:19:44.88,0:19:47.68,Main,,0,0,0,,B Bloğu kazananı...Dialogue: 10,0:19:47.68,0:19:49.08,Main,,0,0,0,,Lanet olsun!Dialogue: 10,0:19:49.08,0:19:52.12,Main,,0,0,0,,...Bartolomeo!Dialogue: 10,0:19:53.75,0:19:57.54,Main,,0,0,0,,Hepinizin canı cehenneme!Dialogue: 10,0:20:00.86,0:20:02.23,Main,,0,0,0,,Defol!Dialogue: 10,0:20:02.23,0:20:04.17,Main,,0,0,0,,Lanet olası!Dialogue: 10,0:20:07.53,0:20:11.02,Main,,0,0,0,,Ne? O tuhaf adam kazandı.Dialogue: 10,0:20:12.46,0:20:15.89,Main,,0,0,0,,Mera Mera Meyvesi'ni o kişi için kazanacağım!Dialogue: 0,0:20:20.75,0:20:24.92,Captions,,0,0,220,,Kolzeyumun İçi Tribünlere Giden YolDialogue: 10,0:20:22.84,0:20:24.13,Main,,0,0,0,,Sen de mi yani?!Dialogue: 10,0:20:24.13,0:20:26.67,Main,,0,0,0,,Sessiz ol! Çok bağırıyorsun!Dialogue: 10,0:20:29.10,0:20:32.75,Main,,0,0,0,,Sen de mi fabrikayı yok etmeyi planlıyordun?Dialogue: 10,0:20:32.75,0:20:37.52,Main,,0,0,0,,Öyle! Dostlarımla birlikte epeydir buna hazırlanmaktaydık!Dialogue: 10,0:20:39.19,0:20:42.97,Main,,0,0,0,,Nerede olduğunu söyle derhal yok edeyim orasını!Dialogue: 10,0:20:42.97,0:20:43.92,Main,,0,0,0,,Olmaz!Dialogue: 10,0:20:44.17,0:20:48.99,Main,,0,0,0,,Çünkü bizler o fabrika çalışanlarını kurtarmak istiyoruz!Dialogue: 10,0:20:48.99,0:20:54.40,Main,,0,0,0,,Planımız bu krallığın düşüşüne neden olabilecek büyük bir kurgudur!Dialogue: 10,0:20:54.40,0:20:59.12,Main,,0,0,0,,Eğer Doflamingo'ya karşı gelebilecek cesaret ve kararlılığa sahipsen...Dialogue: 10,0:20:59.12,0:21:03.83,Main,,0,0,0,,...sana bu acıların krallığı Dressrosa hakkındaki her şeyi anlatacağım!