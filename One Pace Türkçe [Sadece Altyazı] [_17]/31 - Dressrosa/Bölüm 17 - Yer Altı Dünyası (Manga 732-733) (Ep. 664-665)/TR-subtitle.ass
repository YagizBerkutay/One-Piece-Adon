87,OP_665_Signs,Bottom left caption,0,0,0,,Ticaret  LimanıDialogue: 1,0:17:02.17,0:17:05.87,OP_665_Signs,Bottom middle caption,0,0,0,,FabrikaDialogue: 1,0:17:02.17,0:17:05.87,OP_665_Signs,Bottom right caption,0,0,0,,AsansörDialogue: 0,0:17:06.23,0:17:08.19,Main,Grunt,0,0,0,,Atlayın çabuk!Dialogue: 0,0:17:08.19,0:17:11.08,Main,Grunt,0,0,0,,Oyuncak Evi'nin önünde izinsiz biri var!Dialogue: 0,0:17:11.08,0:17:14.04,Main,Grunt,0,0,0,,Hasır Şapkalar'dan biri belirmiş!Dialogue: 0,0:17:14.04,0:17:18.06,Main,Grunt,0,0,0,,Doğu girişinde Senyor Pink-sama'yla dövüşüyormuş sanırım!Dialogue: 0,0:17:18.06,0:17:20.89,Main,Grunt,0,0,0,,Bu kattaki fabrikaya ulaşmaya çalışıyormuş!Dialogue: 0,0:17:20.89,0:17:22.65,Main,Thunder Soldier,0,0,0,,Fraland!Dialogue: 0,0:17:22.65,0:17:25.56,Main,Grunt,0,0,0,,İşini biz bitirirsek bonus da alırız!Dialogue: 0,0:17:25.56,0:17:28.03,Main,Grunt,0,0,0,,Hadi ya? Ne kadar peki?Dialogue: 0,0:17:28.03,0:17:30.63,Main,Grunt,0,0,0,,Az olmayacağı kesin!Dialogue: 0,0:17:28.73,0:17:30.09,Secondary,Fodder,0,0,0,,Hadi yapalım.Dialogue: 0,0:17:30.63,0:17:31.84,Main,Grunt,0,0,0,,Harbi mi?!Dialogue: 0,0:17:31.84,0:17:33.05,Main,Grunt,0,0,0,,Öyle diyorlar!Dialogue: 0,0:17:34.99,0:17:37.13,Main,Grunt,0,0,0,,Yazılı bir şey yok yani?!Dialogue: 0,0:17:47.13,0:17:51.87,Main,Thunder Soldier,0,0,0,,Bu gidişle Oyuncak Evi ve  yeraltı arasında gidip geleceğiz!Dialogue: 0,0:17:52.37,0:17:54.05,Main,Thunder Soldier,0,0,0,,Asansörü ele geçirelim!Dialogue: 0,0:17:54.74,0:17:56.65,Main,Thunder Soldier,0,0,0,,Siz burada kalın!Dialogue: 0,0:18:00.49,0:18:01.82,Main,Thunder Soldier,0,0,0,,Kıpırdamayın!Dialogue: 0,0:18:01.82,0:18:03.79,Main,Thunder Soldier,0,0,0,,Bu asansöre el koyuyorum!Dialogue: 0,0:18:03.79,0:18:04.81,Main,Grunt,0,0,0,,Sen...Dialogue: 0,0:18:04.81,0:18:06.86,Main,Grunt,0,0,0,,Kolezyumun Yıldırım Askeri bu!Dialogue: 0,0:18:06.86,0:18:08.03,Main,Grunt,0,0,0,,Buraya nasıl gelmiş?!Dialogue: 0,0:18:09.17,0:18:10.12,Main,Thunder Soldier,0,0,0,,Çok yavaşsın!Dialogue: 0,0:18:12.40,0:18:13.77,Main,Grunt,0,0,0,,Seni adi!Dialogue: 0,0:18:16.67,0:18:18.34,Main,Thunder Soldier,0,0,0,,Çok yavaş!Dialogue: 0,0:18:20.75,0:18:21.75,Flashbacks,Thunder Soldier,0,0,0,,Çok yavaşsın!Dialogue: 0,0:18:22.92,0:18:26.44,Flashbacks,Rebecca,0,0,0,,Vurdun bana! Aile içi şiddet resmen!Dialogue: 0,0:18:26.44,0:18:28.12,Flashbacks,Thunder Soldier,0,0,0,,Yok öyle aile içi şiddet falan,...Dialogue: 0,0:18:28.12,0:18:30.60,Flashbacks,Thunder Soldier,0,0,0,,...istediğim için vurmuyorum!Dialogue: 0,0:18:31.21,0:18:33.32,Flashbacks,Rebecca,0,0,0,,O zaman vururmuş gibi yap vurma!Dialogue: 0,0:18:33.32,0:18:36.68,Flashbacks,Thunder Soldier,0,0,0,,Tehlike anı hissi olmazsa gelişme de olmaz!Dialogue: 0,0:18:36.68,0:18:39.14,Flashbacks,Thunder Soldier,0,0,0,,Odaklan, Rebecca!Dialogue: 0,0:18:42.64,0:18:46.93,Flashbacks,Thunder Soldier,0,0,0,,İnsan sezileri bundan çok daha gelişmiştir!Dialogue: 0,0:18:46.93,0:18:48.96,Flashbacks,Thunder Soldier,0,0,0,,Sınırlama kendini!Dialogue: 0,0:18:48.96,0:18:51.27,Flashbacks,Thunder Soldier,0,0,0,,İnsan güçlerine inan!Dialogue: 0,0:18:51.27,0:18:54.31,Flashbacks,Rebecca,0,0,0,,Asker-san, oyuncaksın ama sen!Dialogue: 0,0:18:54.90,0:18:56.64,Flashbacks,Thunder Soldier,0,0,0,,Mızmızlanmayı bırak!Dialogue: 0,0:19:00.24,0:19:04.26,Flashbacks,Rebecca,0,0,0,,Savaşmak istemiyorum artık!Dialogue: 0,0:19:06.72,0:19:10.16,Flashbacks,Rebecca,0,0,0,,Sen hep beni korursun Asker-san!Dialogue: 0,0:19:10.48,0:19:12.80,Flashbacks,Thunder Soldier,0,0,0,,Oyuncağım ben!Dialogue: 0,0:19:12.80,0:19:16.57,Flashbacks,Thunder Soldier,0,0,0,,Yağmur ve rüzgar bedenimi paslandırır!Dialogue: 0,0:19:21.93,0:19:24.19,Flashbacks,Thunder Soldier,0,0,0,,Bu vücutla ne kadar dayanabileceğim bilinmez!Dialogue: 0,0:19:26.31,0:19:28.48,Flashbacks,Thunder Soldier,0,0,0,,Ayağa kalk, Rebecca!Dialogue: 0,0:19:29.80,0:19:31.46,Flashbacks,Thunder Soldier,0,0,0,,Güçlü ol!Dialogue: 0,0:19:37.44,0:19:39.68,Thoughts,Thunder Soldier,0,0,0,,Savaşmak için yaratılmış bir beden değil bu!Dialogue: 0,0:19:40.22,0:19:44.60,Thoughts,Thunder Soldier,0,0,0,,Belki de çocuklar büyümeden önce kırılmak...Dialogue: 0,0:19:44.60,0:19:47.63,Thoughts,Thunder Soldier,0,0,0,,...oyuncakların kaderinde vardır!Dialogue: 0,0:19:50.58,0:19:53.12,Thoughts,Thunder Soldier,0,0,0,,Bağışla, Rebecca!Dialogue: 0,0:19:58.02,0:20:02.46,Thoughts,Thunder Soldier,0,0,0,,Bu işe yaramaz babanın elinden yalnızca sana nasıl daha güçlü olabileceğini öğretmek geliyor!Dialogue: 0,0:20:04.60,0:20:07.45,Main,Grunt,0,0,0,,Bu kadar güçlü müymüş bu?!Dialogue: 0,0:20:07.45,0:20:09.11,Main,Grunt,0,0,0,,Amacın ne senin?Dialogue: 0,0:20:09.11,0:20:11.57,Main,Grunt,0,0,0,,Oyuncağın tekisin, ne istiyorsun?!Dialogue: 0,0:20:11.83,0:20:15.04,Main,Thunder Soldier,0,0,0,,Çocuğumun mutlu bir şekilde yaşayabileceği...Dialogue: 0,0:20:15.04,0:20:17.74,Main,Thunder Soldier,0,0,0,,...huzurlu bir ülke istiyorum!Dialogue: 0,0:20:18.04,0:20:22.93,Main,Thunder Soldier,0,0,0,,Dressrosa'yı Kral Riku Ailesi adına geri alacağım!Dialogue: 0,0:20:24.34,0:20:25.71,Main,Grunt,0,0,0,,Kral Riku mu?!Dialogue: 0,0:20:25.71,0:20:27.89,Main,Grunt,0,0,0,,Ne saçmalıklar zırvalıyorsun sen be?!Dialogue: 0,0:20:28.88,0:20:32.39,Thoughts,Thunder Soldier,0,0,0,,Bu uğurda hayatımı vermeye razıyım!Dialogue: 0,0:20:40.99,0:20:43.45,Captions,,0,0,220,,Corrida KolezyumuDialogue: 0,0:20:43.75,0:20:46.02,Main,Announcer,0,0,0,,Ne oldu öyle?!Dialogue: 0,0:20:47.68,0:20:49.13,Main,Sabo,0,0,0,,Çok hızlıydı.Dialogue: 0,0:20:49.13,0:20:51.48,Main,Bartolomeo,0,0,0,,Ne oldu be!?Dialogue: 0,0:20:51.48,0:20:53.03,Main,Bartolomeo,0,0,0,,Hiçbir şey göremedim!Dialogue: 0,0:20:53.92,0:20:55.95,Main,Sabo,0,0,0,,Duymuştum ama...Dialogue: 0,0:20:56.90,0:21:02.16,Main,Announcer,0,0,0,,İnanamıyorum! Herkes yere yığıldı!Dialogue: 0,0:21:02.94,0:21:07.44,Main,Announcer,0,0,0,,D Bloğu'nun geriye kalan en güçlü katılımcıları patır patır yere yığıldı!Dialogue: 0,0:21:07.86,0:21:11.32,Main,Announcer,0,0,0,,Ayakta kimse kalmadı!Dialogue: 0,0:21:13.00,0:21:16.25,Main,Announcer,0,0,0,,Nasıl bir şey bu böyle?!Dialogue: 0,0:21:16.25,0:21:20.72,Main,Announcer,0,0,0,,Her şey bir anda oldu!Dialogue: 0,0:21:26.86,0:21:28.00,Main,Announcer,0,0,0,,Durun biraz!Dialogue: 0,0:21:29.20,0:21:32.80,Main,Announcer,0,0,0,,Biri ayağa kalkmaya çalışıyor!