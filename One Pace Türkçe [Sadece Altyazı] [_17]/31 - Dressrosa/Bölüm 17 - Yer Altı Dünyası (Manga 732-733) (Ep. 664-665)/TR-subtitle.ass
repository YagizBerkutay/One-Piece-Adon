Dialogue: 0,0:01:44.79,0:01:47.42,Main,Thunder Soldier,0,0,0,,Şimdi hepimiz yeraltı geçidinden...
Dialogue: 0,0:01:47.42,0:01:49.02,Main,Thunder Soldier,0,0,0,,...limana ulaşacağız!
Dialogue: 0,0:01:49.02,0:01:52.62,Main,Leo,0,0,0,,Hedefimiz tek bir kız!
Dialogue: 0,0:01:53.84,0:01:55.43,Main,Leo,0,0,0,,Sugar!
Dialogue: 0,0:01:55.43,0:01:58.41,Main,Flapper,0,0,0,,Fakat küçük bir kız olması\Nişin kolay olacağı anlamına gelmiyor!
Dialogue: 0,0:01:58.41,0:02:03.54,Main,Leo,0,0,0,,Sugar'ı bayıltacak ve ülkedeki oyuncakların\Nyeniden insan olmasını sağlayacağız!
Dialogue: 0,0:02:13.66,0:02:15.25,Main,Usopp,0,0,0,,Çok sıkışık!
Dialogue: 0,0:02:15.25,0:02:18.45,Main,Usopp,0,0,0,,Robiland'la biz zar zor sığıyoruz!
Dialogue: 0,0:02:18.45,0:02:23.14,Main,Usopp,0,0,0,,Fraland, sen de kollarını ve omuzlarını\Nyerlerinden çıkartırsan olur sanki?
Dialogue: 0,0:02:23.59,0:02:24.76,Main,Franky,0,0,0,,Çıkartamam ki ulan!
Dialogue: 0,0:02:25.78,0:02:29.90,Main,Franky,0,0,0,,Hey, Benland oradan geçemez!
Dialogue: 0,0:02:30.28,0:02:35.05,Main,Leo,0,0,0,,Şimdi tabii o geçidi\NBüyük İnsanları düşünerek yapmamıştık.
Dialogue: 0,0:02:35.05,0:02:37.00,Main,Thunder Soldier,0,0,0,,Oyuncak Evi'nden girmekten başka\Nbir seçeneğin yok!
Dialogue: 0,0:02:37.52,0:02:41.87,Main,Thunder Soldier,0,0,0,,Oyuncak Evi sarayın da üzerinde bulunduğu\No koca platonun merkezindedir.
Dialogue: 0,0:02:41.87,0:02:46.07,Main,Thunder Soldier,0,0,0,,Oyuncaklar her gece oraya dönerler.
Dialogue: 0,0:02:46.07,0:02:48.08,Main,Thunder Soldier,0,0,0,,İnsanların içeri girmesi yasaktır.
Dialogue: 0,0:02:48.08,0:02:51.65,Main,Franky,0,0,0,,Oyuncaklar orada yaşadıkları için mi\N"ev" diyorsun?
Dialogue: 0,0:02:51.65,0:02:56.59,Main,Thunder Soldier,0,0,0,,Lafta ev,\Nyatacak yatak falan yok elbette.
Dialogue: 0,0:02:56.59,0:03:00.43,Main,Thunder Soldier,0,0,0,,İçinde yalnızca\Nzemine uzanan bir geçit mevcut.
Dialogue: 0,0:03:00.43,0:03:04.73,Main,Thunder Soldier,0,0,0,,Her gece oyuncaklar\No geçitten geçerek yeraltına iner...
Dialogue: 0,0:03:04.73,0:03:07.04,Main,Thunder Soldier,0,0,0,,...gece boyunca çalışırlar.
Dialogue: 0,0:03:07.96,0:03:13.10,Main,Usopp,0,0,0,,Yani şehirdeki oyuncaklar\Nhep yorgunlar mı?!
Dialogue: 0,0:03:15.03,0:03:19.21,Main,Franky,0,0,0,,Evet! Çalışmaya zorlanan\NTontattalılar'ın durumu da farklı değil!
Dialogue: 0,0:03:19.21,0:03:21.55,Main,Usopp,0,0,0,,İşin özü...
Dialogue: 0,0:03:21.55,0:03:25.18,Main,Usopp,0,0,0,,...Fraland oradan GÜLÜCÜK fabrikasına\Nulaşabilir değil mi?
Dialogue: 0,0:03:25.18,0:03:29.31,Main,Thunder Soldier,0,0,0,,Evet! Dört farklı tarafta\Ndört farklı geçit mevcut.
Dialogue: 0,0:03:29.31,0:03:32.56,Main,Thunder Soldier,0,0,0,,Fakat tüm geçitler\Nsıkı bir şekilde korunur!
Dialogue: 0,0:03:32.56,0:03:35.17,Main,Franky,0,0,0,,Öylesi daha eğlenceli olur benim için!
Dialogue: 0,0:03:36.48,0:03:40.67,Main,Franky,0,0,0,,Hem madem oraya gideceksem\Nortalığı ayağa kaldırmadan olmaz!
Dialogue: 0,0:03:41.68,0:03:43.62,Main,Thunder Soldier,0,0,0,,Neden öyle bir şey yapacaksın?!
Dialogue: 0,0:03:43.62,0:03:46.66,Main,Franky,0,0,0,,{\i1}Öylesi sizin için daha iyi olmaz mı?
Dialogue: 0,0:03:46.66,0:03:47.52,Main,Thunder Soldier,0,0,0,,{\i1}Nasıl yani?
Dialogue: 0,0:03:47.52,0:03:52.91,Main,Franky,0,0,0,,{\i1}Ben onların dikkatini çekerken siz de\NSugar'la olan meselenizi halledersiniz.{\i0}
Dialogue: 0,0:04:03.54,0:04:04.92,Main,Pirate,0,0,0,,Bu da kim?
Dialogue: 0,0:04:05.82,0:04:06.99,Main,Pirate,0,0,0,,Slip mayo mu giymiş o?!
Dialogue: 0,0:04:06.99,0:04:08.83,Main,Pirate,0,0,0,,{\i1}Bu saçlar da neyin nesi?!
Dialogue: 0,0:04:10.33,0:04:11.53,Main,Pirate,0,0,0,,Silah mı?
Dialogue: 0,0:04:11.53,0:04:12.96,Main,Pirate,0,0,0,,Yoksa aptallık mı?!
Dialogue: 0,0:04:14.43,0:04:17.25,Main,Pirate,0,0,0,,İki çene çukuru var!
Dialogue: 0,0:04:18.83,0:04:23.96,Main,Pirate,0,0,0,,Hiç şüphesiz Hasır Şapkalar'ın\NSayborg Franky'si bu!
Dialogue: 0,0:04:32.22,0:04:35.46,Main,Woman,0,0,0,,Olmaz ama Senyor!\NDomatesi öyle hunharca ısırırsanız...
Dialogue: 0,0:04:35.46,0:04:37.54,Main,Woman,0,0,0,,...her tarafınız domates suyu olur!
Dialogue: 0,0:04:47.97,0:04:50.27,Main,Woman,0,0,0,,Ne kadar da...
Dialogue: 0,0:04:51.84,0:04:54.88,Main,Woman,0,0,0,,...erkeksi!
Dialogue: 0,0:04:54.88,0:04:58.10,Main,Pink,0,0,0,,{\an8}Düşün yakamdan, genç kızlar!
Dialogue: 0,0:04:55.46,0:05:02.25,Captions,Caption,0,0,220,,{\fad(504,0)}Senyor Pink - Don Quixote Ailesi\NYöneticisi (Diamante Ordusu)
Dialogue: 0,0:04:59.29,0:05:02.25,Main,Pink,0,0,0,,{\an8}Daha genç erkekler bulun kendinize!
Dialogue: 0,0:05:02.25,0:05:04.12,Main,Woman,0,0,0,,Öyle deme ama Senyor!
Dialogue: 0,0:05:04.12,0:05:06.62,Main,Woman,0,0,0,,Bize böyle soğuk davranma, Senyor!
Dialogue: 0,0:05:08.58,0:05:10.46,Main,Señor,0,0,0,,Sizin gibi veletler...
Dialogue: 0,0:05:11.82,0:05:13.83,Main,Señor,0,0,0,,...ilgimi çekmiyor.
Dialogue: 0,0:05:14.84,0:05:16.70,Main,Woman,0,0,0,,{\i1}Ay Senyor!
Dialogue: 0,0:05:16.70,0:05:18.72,Main,Woman,0,0,0,,Bırakma beni, Senyor!
Dialogue: 0,0:05:18.72,0:05:20.67,Main,Woman,0,0,0,,{\i1}Senyor!
Dialogue: 0,0:05:20.67,0:05:22.91,Main,Woman,0,0,0,,{\i1}Senyor!
Dialogue: 0,0:05:24.54,0:05:27.31,Main,Franky,0,0,0,,Bu sapık adi de kimin nesi lan?!
Dialogue: 0,0:05:27.31,0:05:29.07,Main,Pirate,0,0,0,,{\i1}Bak şu konuşana derler adama!
Dialogue: 0,0:05:29.07,0:05:32.10,Main,Pirate,0,0,0,,Oyuncak Evi\Ndoğu girişinden arıyorum!
Dialogue: 0,0:05:32.10,0:05:33.35,Main,Pirate,0,0,0,,Düşman burada belirdi!
Dialogue: 0,0:05:33.84,0:05:36.65,Main,Franky,0,0,0,,İzninizle içeri geçeyim ben!
Dialogue: 0,0:05:38.08,0:05:39.62,Main,Franky,0,0,0,,{\fad(150,150)}Sol Silahlar!
Dialogue: 0,0:05:44.26,0:05:45.59,Main,Pirate,0,0,0,,İndirin şunu!
Dialogue: 0,0:05:46.86,0:05:50.43,Main,Pirate,0,0,0,,Hasır Şapkalar'dan Sayborg Franky!
Dialogue: 0,0:05:50.43,0:05:52.60,Main,Franky,0,0,0,,{\fad(150,150)}Coup de...
Dialogue: 0,0:05:54.47,0:05:55.32,Main,Franky,0,0,0,,{\fad(150,150)}...Hava Deliği!
Dialogue: 0,0:06:09.74,0:06:11.68,Main,Doflamingo,0,0,0,,Gördün mü?
Dialogue: 0,0:06:11.68,0:06:15.07,Main,Doflamingo,0,0,0,,Aptallar sorun çıkartıyor.
Dialogue: 0,0:06:15.07,0:06:20.04,Main,Doflamingo,0,0,0,,Dünya Hükümeti'ne bağlı ülkeleri koruma işinin sizin göreviniz olduğunu sanıyordum.
Dialogue: 0,0:06:25.44,0:06:27.53,Main,Diamante,0,0,0,,Başladılar demek?
Dialogue: 0,0:06:41.81,0:06:45.44,Main,Sugar,0,0,0,,Oyuncak Evi'ne saldırıyorlar.
Dialogue: 0,0:06:47.25,0:06:48.57,Main,Trébol,0,0,0,,Endişelenme!
Dialogue: 0,0:06:48.57,0:06:52.90,Main,Trébol,0,0,0,,Hasır Şapkalar\NGÜLÜCÜK fabrikasının peşinde.
Dialogue: 0,0:06:52.90,0:06:56.09,Main,Trébol,0,0,0,,Ama hani olur da\Nburaya kadar gelirlerse...
Dialogue: 0,0:06:56.09,0:07:00.73,Main,Trébol,0,0,0,,Hepsini oyuncak yapalım, olur mu?
Dialogue: 0,0:07:03.21,0:07:05.52,Main,Trébol,0,0,0,,Varlığını...
Dialogue: 0,0:07:05.52,0:07:10.54,Main,Trébol,0,0,0,,...kimseler bilmiyor,\Ndeğil mi ama değil mi?
Dialogue: 0,0:07:11.68,0:07:12.90,Main,Sugar,0,0,0,,Öyle sanırım.
Dialogue: 0,0:07:15.38,0:07:18.18,Captions,,0,0,180,,{\fad(506,0)}Yer Altı Geçidi
Dialogue: 0,0:07:18.60,0:07:21.42,Main,Thunder Soldier,0,0,0,,Limana vardık sayılır!
Dialogue: 0,0:07:21.42,0:07:25.96,Main,Gnome,0,0,0,,Komutan! Fraland Oyuncak Evi'nde\Netrafı birbirine katmaya başladı!
Dialogue: 0,0:07:25.96,0:07:27.04,Main,Thunder Soldier,0,0,0,,Güzel!
Dialogue: 0,0:07:27.21,0:07:31.63,Flashbacks,Franky,0,0,0,,Hem madem oraya gideceksem\Nortalığı ayağa kaldırmadan olmaz!
Dialogue: 0,0:07:31.63,0:07:33.53,Main,Thunder Soldier,0,0,0,,Umarım başına bir şey gelmez!
Dialogue: 0,0:07:33.53,0:07:37.14,Main,Usopp,0,0,0,,Endişelenme!\NSüper sayborgdan bahsediyoruz!
Dialogue: 0,0:07:37.14,0:07:43.27,Main,Thunder Soldier,0,0,0,,Fakat yeni aldığım habere göre\NOyuncak Evi'ni dört aile yöneticisi koruyormuş!
Dialogue: 0,0:07:43.27,0:07:44.58,Main,Usopp,0,0,0,,Yöneticiler mi?!
Dialogue: 0,0:07:44.58,0:07:47.60,Main,Gnome,0,0,0,,Hem de Diamante Ordusu!
Dialogue: 0,0:07:47.60,0:07:49.75,Main,Gnome,0,0,0,,Savaşçılardan oluşan bir takım!
Dialogue: 0,0:07:49.75,0:07:55.10,Main,Usopp,0,0,0,,Dövüşlerde kazanma oranları yüzde yüz!
Dialogue: 0,0:07:55.10,0:07:57.29,Main,Gnome,0,0,0,,Kolezyum'un yıldızları!
Dialogue: 0,0:07:57.29,0:08:01.79,Main,Usopp,0,0,0,,Yüzde yüz derken\Nhiç kaybetmemişler mi yani?!
Dialogue: 0,0:08:02.52,0:08:04.88,Main,Thunder Soldier,0,0,0,,Aynen öyle!\NBu da demektir ki...
Dialogue: 0,0:08:06.20,0:08:10.13,Main,Thunder Soldier,0,0,0,,...gerçek güçlerini\Nhenüz kimse bilmiyor!
Dialogue: 0,0:08:15.01,0:08:18.34,Main,Usopp,0,0,0,,Ailede göz önünde bulundurulması gereken\Nkaç kişi var, Leo?
Dialogue: 0,0:08:18.34,0:08:24.78,Main,Leo,0,0,0,,Tüm ülke şu anda 10 yönetici ve\Nonların 2000 adamı tarafından yönetiliyor.
Dialogue: 0,0:08:24.78,0:08:28.89,Main,Leo,0,0,0,,Üst düzey üç yönetici de\Neşsiz ordularıyla...
Dialogue: 0,0:08:28.89,0:08:32.94,Main,Leo,0,0,0,,...bu kişileri yönetmekte.
Dialogue: 0,0:08:34.35,0:08:36.56,Main,Leo,0,0,0,,Bunlardan ilki Trebol Ordusu...
Dialogue: 0,0:08:36.56,0:08:38.88,Main,Leo,0,0,0,,...özel yeteneklere sahip kişilerden oluşuyor.
Dialogue: 0,0:08:35.09,0:08:39.01,Captions,Caption,0,0,0,,{\fs(45)\fad(519,227)\pos(640,560)}Trebol Ordusu (Özel Yetenek Birliği)
Dialogue: 0,0:08:40.20,0:08:43.45,Captions,Caption,0,0,0,,{\fs(45)\fad(491,246)\pos(640,580)}Sugar
Dialogue: 0,0:08:44.70,0:08:47.96,Captions,Caption,0,0,0,,{\fs(45)\fad(491,210)\pos(640,580)}Violet
Dialogue: 0,0:08:49.20,0:08:52.49,Captions,Caption,0,0,0,,{\fs(45)\fad(491,194)\pos(640,580)}Giolla
Dialogue: 0,0:08:54.62,0:08:57.06,Main,Leo,0,0,0,,İkincisi Diamante Ordusu...
Dialogue: 0,0:08:57.06,0:08:59.39,Main,Leo,0,0,0,,Savaşçılardan oluşuyor.
Dialogue: 0,0:08:55.74,0:08:59.60,Captions,Caption,0,0,0,,{\fs(45)\fad(500,227)\pos(640,560)}Diamante Ordusu (Savaşçı Birliği)
Dialogue: 0,0:09:00.82,0:09:03.74,Captions,Caption,0,0,0,,{\fs(45)\fad(491,200)\pos(640,580)}Lao G
Dialogue: 0,0:09:04.89,0:09:07.68,Captions,Caption,0,0,0,,{\fs(45)\fad(491,200)\pos(640,580)}Machvise
Dialogue: 0,0:09:08.86,0:09:11.81,Captions,Caption,0,0,0,,{\fs(45)\fad(491,200)\pos(640,580)}Senyor Pink
Dialogue: 0,0:09:13.00,0:09:15.95,Captions,Caption,0,0,0,,{\fs(45)\fad(451,220)\pos(640,580)}Dellinger
Dialogue: 0,0:09:17.87,0:09:19.87,Main,Leo,0,0,0,,Sonuncusuysa Pica Ordusu!
Dialogue: 0,0:09:20.65,0:09:22.80,Main,Leo,0,0,0,,Komando birliği!
Dialogue: 0,0:09:19.97,0:09:24.66,Captions,Caption,0,0,0,,{\fs(45)\fad(520,227)\pos(650,560)}Pica Ordusu (Özel Saldırı Birliği)
Dialogue: 0,0:09:25.80,0:09:28.76,Captions,Caption,0,0,0,,{\fs(45)\fad(471,200)\pos(640,580)}Gladius
Dialogue: 0,0:09:30.28,0:09:33.73,Captions,Caption,0,0,0,,{\fs(45)\fad(518,180)\pos(640,505)}Buffalo ve\NBaby 5
Dialogue: 0,0:09:38.50,0:09:41.48,Main,Leo,0,0,0,,Ayrıca iki kişinin de\Ndenizaşırı ülkelerde olduğunu biliyoruz.
Dialogue: 0,0:09:41.79,0:09:45.78,Captions,Caption,0,0,0,,{\fs(45)\fad(218,0)\pos(640,560)}Üst düzey yönetici Vergo!
Dialogue: 0,0:09:46.36,0:09:49.50,Captions,Caption,0,0,0,,{\fs(45)\fad(218,0)\pos(640,565)}Ve yönetici Monet!
Dialogue: 0,0:09:50.73,0:09:53.09,Thoughts,Usopp,0,0,0,,Savaşçıların grubuyla karşılaşmayacağız yani!
Dialogue: 0,0:09:53.09,0:09:54.61,Thoughts,Usopp,0,0,0,,Sana iyi şanslar, Franky!
Dialogue: 0,0:09:54.61,0:09:57.01,Main,Leo,0,0,0,,Ama hepsi de epey güçlüler!
Dialogue: 0,0:09:57.01,0:09:59.31,Main,Usopp,0,0,0,,Ne?! Böyle şansın ben ya!
Dialogue: 0,0:10:07.07,0:10:09.22,Main,Leo,0,0,0,,Özür dilerim, Usoland!
Dialogue: 0,0:10:10.70,0:10:11.55,Main,Robin,0,0,0,,Teşekkür ederim.
Dialogue: 0,0:10:11.55,0:10:12.87,Main,Gancho,0,0,0,,Lafı olmaz.
Dialogue: 0,0:10:13.38,0:10:18.53,Main,Leo,0,0,0,,Geldik. Limanın ve fabrikanın bulunduğu\Nyeraltı dünyasındayız.
Dialogue: 0,0:10:20.37,0:10:22.87,Main,Usopp,0,0,0,,Epey sesli yermiş.
Dialogue: 0,0:10:24.91,0:10:27.67,Main,Usopp,0,0,0,,Yukarıdan mı geliyor bu ses?
Dialogue: 0,0:10:27.67,0:10:30.71,Main,Pirate,0,0,0,,Hanginiz düşürdü lan bunu?!
Dialogue: 0,0:10:30.71,0:10:32.64,Main,Pirate,0,0,0,,Oyuncak altında kalmış.
Dialogue: 0,0:10:32.64,0:10:34.60,Main,Toy,0,0,0,,Özür dilerim!
Dialogue: 0,0:10:34.60,0:10:38.25,Main,Toy,0,0,0,,İstediğiniz kadar çalışacağım,\Nizin verin ailemi göreyim!
Dialogue: 0,0:10:38.25,0:10:41.99,Main,Pirate,0,0,0,,Aptallar! Aylık hedefine ulaşamayanlar\Nhurdaya çıkacak haberiniz olsun!
Dialogue: 0,0:10:41.99,0:10:42.90,Main,Pirate,0,0,0,,Götürün şunu!
Dialogue: 0,0:10:42.90,0:10:46.30,Main,Toy,0,0,0,,Durun!\NÇalışabilirim!
Dialogue: 0,0:10:46.30,0:10:48.35,Main,Toy,0,0,0,,Yardım edin!
Dialogue: 0,0:10:49.75,0:10:50.66,Main,Robin,0,0,0,,Usopp.
Dialogue: 0,0:10:53.58,0:10:54.70,Main,Usopp,0,0,0,,Robin, ben...
Dialogue: 0,0:10:57.23,0:10:58.02,Main,Robin,0,0,0,,Bak.
Dialogue: 0,0:11:01.70,0:11:05.44,Main,Toy,0,0,0,,Durun çalışabilirim!\NYardım edin!
Dialogue: 0,0:11:05.44,0:11:08.76,Main,Pirate,0,0,0,,Sevmediysen anlaşma manlaşma yok!
Dialogue: 0,0:11:08.76,0:11:11.44,Main,Pirate,0,0,0,,Adi herif, zaafımdan faydalanıyorsun!
Dialogue: 0,0:11:11.44,0:11:13.69,Main,Pirate,0,0,0,,Joker senpai yanınızda olmasaydı...
Dialogue: 0,0:11:22.62,0:11:25.60,Main,Usopp,0,0,0,,Bu da ne anasını?!
Dialogue: 0,0:11:25.60,0:11:28.65,Main,Usopp,0,0,0,,Devasa bir liman şehri resmen bu!
Dialogue: 0,0:11:37.73,0:11:40.91,Main,Announcer,0,0,0,,Suleiman saldırılarına devam ediyor!
Dialogue: 0,0:11:40.91,0:11:42.83,Main,Audience,0,0,0,,Hadi!
Dialogue: 0,0:11:42.83,0:11:44.58,Main,Audience,0,0,0,,Geber Rebecca!
Dialogue: 0,0:11:44.74,0:11:48.34,Main,Audience,0,0,0,,Suleiman, al şunun kellesini!
Dialogue: 0,0:11:50.62,0:11:56.09,Main,Announcer,0,0,0,,Bir zamanlar\NDias Deniz Savaşı'nın kahramanıydı...
Dialogue: 0,0:11:56.09,0:12:00.06,Main,Announcer,0,0,0,,...fakat savaş şuçlusu olarak\Nülkesinden atılmasının ardından...
Dialogue: 0,0:12:02.58,0:12:07.44,Main,Announcer,0,0,4,,{\an8}...dünyanın karanlık tarafında at koşturan\Nbir ölüm meleğine dönüştü!
Dialogue: 0,0:12:02.26,0:12:07.92,Captions,,0,0,240,,{\fad(525,525)}Dias Deniz Savaşı'ndaki A Sınıfı Savaş Suçlusu\NCellat Suleiman
Dialogue: 0,0:12:08.68,0:12:13.13,Main,Suleiman,0,0,0,,Her şeyi ülkem için yaptım.
Dialogue: 0,0:12:13.13,0:12:14.72,Main,Suleiman,0,0,0,,Ülkemi severdim.
Dialogue: 0,0:12:16.71,0:12:18.85,Main,Suleiman,0,0,0,,Peki ya sen?
Dialogue: 0,0:12:20.95,0:12:28.66,Main,Suleiman,0,0,0,,Nefret edildiğin bu ülkede \Nnefes almak bile zor olsa gerek senin için.
Dialogue: 0,0:12:29.96,0:12:32.43,Main,Rebecca,0,0,0,,Hiçbir zorluk koymaz bana.
Dialogue: 0,0:12:32.43,0:12:35.43,Main,Rebecca,0,0,0,,Nefret edilen biri olmak da öyle...
Dialogue: 0,0:12:35.70,0:12:39.28,Main,Rebecca,0,0,0,,Yalnızca Asker-san'la\Nyaşamak istiyorum!
Dialogue: 0,0:12:40.64,0:12:42.76,Main,Announcer,0,0,0,,Vazgeçmiyor!
Dialogue: 0,0:12:42.76,0:12:49.18,Main,Announcer,0,0,0,,İğrenç mi iğrenç Rebecca'yla birlikte\ND Bloğu'ndan geriye yalnızca 30 yarışmacı kaldı!
Dialogue: 0,0:12:51.68,0:12:55.42,Main,Announcer,0,0,0,,Bir kişi daha, pardon,\Nhayvan daha düştü!
Dialogue: 0,0:12:56.17,0:12:58.40,Main,Announcer,0,0,4,,Düzinelerce kişiyi alt edip...
Dialogue: 0,0:12:55.78,0:13:01.84,Captions,,0,0,240,,{\fad(525,525)}Sahte Maceraperest \N(Büyük Yonta Maria Filosu Komodoru)\NOrlumbus
Dialogue: 0,0:12:58.40,0:13:00.01,Main,Announcer,0,0,4,,...ringi kana bulayan adam...
Dialogue: 0,0:13:00.01,0:13:03.37,Main,Announcer,0,0,4,,...savaşçı aslan Agyo az önce...
Dialogue: 0,0:13:03.40,0:13:07.57,Main,Announcer,0,0,4,,...Orlumbus'un kamçısının kurbanı oldu!
Dialogue: 0,0:13:12.49,0:13:14.25,Main,Audience,0,0,0,,Ne güçlü!
Dialogue: 0,0:13:14.25,0:13:15.57,Main,Audience,0,0,0,,Amiral!
Dialogue: 0,0:13:15.64,0:13:18.81,Captions,,0,0,180,,{\fad(525,0)}Korsan Cavendish
Dialogue: 0,0:13:18.88,0:13:22.11,Captions,,0,0,240,,{\fad(525,0)}Kundakçı Damask
Dialogue: 0,0:13:16.26,0:13:18.81,Main,Announcer,0,0,4,,Favorilerden biri mi kazanacak?!
Dialogue: 0,0:13:18.81,0:13:22.11,Main,Announcer,0,0,4,,{\an8}Yoksa kazanan\Nhiç beklenmedik biri mi olacak?!
Dialogue: 0,0:13:22.11,0:13:25.92,Main,Announcer,0,0,4,,{\an8}Finallere yalnızca \Ntek bir kişi adını yazdırabilir!
Dialogue: 0,0:13:22.18,0:13:25.92,Captions,,0,0,240,,{\fad(525,0)}Büyücü Mummy
Dialogue: 0,0:13:25.92,0:13:28.42,Main,Announcer,0,0,0,,Kral Riku'nun torununun canını...
Dialogue: 0,0:13:30.43,0:13:32.86,Main,Announcer,0,0,0,,...kim alacak?!
Dialogue: 0,0:13:34.42,0:13:37.40,Thoughts,Rebecca,0,0,0,,{\i1}Asker-san, neredesin şimdi?{\i0}
Dialogue: 0,0:13:37.72,0:13:39.23,Thoughts,Rebecca,0,0,0,,{\i1}Ölme lütfen!{\i0}
Dialogue: 0,0:13:39.23,0:13:41.36,Thoughts,Rebecca,0,0,0,,{\i1}Başka hiçbir şey istemiyorum!{\i0}
Dialogue: 0,0:13:42.41,0:13:47.34,Captions,,0,0,180,,{\fad(525,0)}Dressrosa'nın Altı \NYer Altı Ticaret Limanı
Dialogue: 0,0:13:59.79,0:14:02.59,Main,Usopp,0,0,0,,Oyuncak Asker gitti mi?!
Dialogue: 0,0:14:02.59,0:14:03.82,Main,Usopp,0,0,0,,Komutan değil miydi o?
Dialogue: 0,0:14:04.17,0:14:07.94,Main,Leo,0,0,0,,Komutanın, biz SOP Operasyonu'nu\Ntamamlar tamamlamaz...
Dialogue: 0,0:14:07.97,0:14:13.00,Main,Leo,0,0,0,,...Doflamingo'yu savunmasız yakalayıp\Nöldürmek gibi büyük bir görevi var!
Dialogue: 0,0:14:13.00,0:14:17.46,Main,Leo,0,0,0,,O yüzden Tontatta'dan birkaç kişiyle\Nbirlikte saraya doğru yola koyuldu!
Dialogue: 0,0:14:17.46,0:14:19.24,Main,Dwarf,0,0,0,,İyi şanslar, komutan!
Dialogue: 0,0:14:19.24,0:14:21.57,Main,Dwarf,0,0,0,,{\i1}İyi şanslar!{\i0}
Dialogue: 0,0:14:22.12,0:14:25.81,Main,Leo,0,0,0,,Bizim yanımızda sen varsın zaten\Nkahraman Usoland!
Dialogue: 0,0:14:25.81,0:14:31.37,Main,Leo,0,0,0,,Lütfen Sugar'ı bayıltma yani\NSOP Operasyonunun başına geç!
Dialogue: 0,0:14:39.59,0:14:44.10,Thoughts,Usopp,0,0,0,,{\i1}En ciddi görev değil mi o?!{\i0}
Dialogue: 0,0:14:48.89,0:14:50.86,Main,Leo,0,0,0,,Şu anda buradayız.
Dialogue: 0,0:14:53.42,0:14:55.64,OP_665_Signs,,0,500,80,,{\move(324,706,393,662,5,1474)}Trebol
Dialogue: 0,0:14:53.42,0:14:55.64,OP_665_Signs,,0,500,80,,{\move(634,724,631,662,5,1307)}Sugar
Dialogue: 0,0:14:53.89,0:14:55.64,Captions,,0,500,80,,{\move(526,730,517,716,3,803)}Yönetim Kulesi
Dialogue: 0,0:14:51.83,0:14:54.11,Main,Leo,0,0,0,,{\an8}Yeraltındaki tüm köprüler hareketli.
Dialogue: 0,0:14:52.82,0:14:55.64,OP_665_Signs,,0,500,80,,{\move(236,96,343,156,5,2107)}Asansör
Dialogue: 0,0:14:53.52,0:14:55.64,Captions,,0,500,80,,{\move(94,720,183,644,5,1507)}Fabrika
Dialogue: 0,0:14:53.52,0:14:55.64,Captions,,0,500,80,,{\move(1176,302,1129,284,5,1273)}Yer Altı\NGeçidi
Dialogue: 0,0:14:55.64,0:14:58.56,Main,Leo,0,0,0,,Ve deniz anemonuna benzeyen...
Dialogue: 0,0:15:01.45,0:15:03.51,Main,Leo,0,0,0,,...şu uzaktaki bina da...
Dialogue: 0,0:15:04.34,0:15:08.62,Main,Leo,0,0,0,,...Sugar'ın da içinde bulunduğu\NYönetim Kulesi!
Dialogue: 0,0:15:12.91,0:15:16.25,Main,Grunt,0,0,0,,Kim var orada?!\NAylaklık mı ediyorsunuz?
Dialogue: 0,0:15:18.66,0:15:21.08,Main,Usopp,0,0,0,,Buldular bizi!\NBitti işimiz!
Dialogue: 0,0:15:21.08,0:15:24.20,Main,Grunt,0,0,0,,Size diyorum!\NHangi gemidensiniz?!
Dialogue: 0,0:15:24.20,0:15:28.10,Main,Grunt,0,0,0,,Ben öylece geçiyordum!
Dialogue: 0,0:15:28.10,0:15:32.68,Main,Grunt,0,0,0,,Simsarlar hariç kimsenin\Ngemiden inmesine izin yok!
Dialogue: 0,0:15:32.68,0:15:33.91,Main,Leo,0,0,0,,Inhel.
Dialogue: 0,0:15:33.91,0:15:34.65,Main,Inhel,0,0,0,,Tamamdır!
Dialogue: 0,0:15:44.54,0:15:46.62,Main,Grunt,0,0,0,,Periler burada!
Dialogue: 0,0:15:46.62,0:15:48.38,Main,Grunt,0,0,0,,{\i1}Neyimiz var neyimiz yok aldılar!{\i0}
Dialogue: 0,0:15:48.57,0:15:50.40,Main,Leo & Inhel,0,0,0,,{\fad(150,150)}Tontatta Stili!
Dialogue: 0,0:15:50.85,0:15:52.60,Main,Leo & Inhel,0,0,0,,{\fad(150,150)}Kuyruk Çekici!
Dialogue: 0,0:15:57.77,0:16:00.37,Main,Usopp,0,0,0,,Yere çakıldılar...
Dialogue: 0,0:16:00.93,0:16:03.67,Main,Cotton,0,0,0,,Kıyafetlerinizi alın Usoland, Robiland!
Dialogue: 0,0:16:04.03,0:16:07.69,Main,Flapper,0,0,0,,Yalnız ne kadar da\Nsivri zekalı birisiniz!
Dialogue: 0,0:16:07.69,0:16:10.83,Main,Flapper,0,0,0,,Korkmuş gibi yaparak\Ndüşmanın dikkatini dağıttınız!
Dialogue: 0,0:16:13.37,0:16:17.63,Main,Usopp,0,0,0,,Yalnız bir şey dikkatimi çekti de,\Nhepiniz böyle güçlü müsünüz?
Dialogue: 0,0:16:17.63,0:16:19.26,Main,Flapper,0,0,0,,Evet!
Dialogue: 0,0:16:19.44,0:16:23.87,Main,Leo,0,0,0,,Ama Noland ailesi\NDeniz Kralları'nı bile yenebiliyordu,...
Dialogue: 0,0:16:23.87,0:16:25.26,Main,Leo,0,0,0,,...biz sana ayakbağı oluruz resmen!
Dialogue: 0,0:16:27.21,0:16:31.20,Thoughts,Usopp,0,0,0,,{\i1}Beni nasıl bir canavar sanıyor bunlar?!{\i0}
Dialogue: 0,0:16:31.80,0:16:38.94,Thoughts,Usopp,0,0,0,,{\i1}Fakat belki savaşmama gerek kalmadan\Nişimizi bitirebiliriz burada!{\i0}
Dialogue: 0,0:16:38.94,0:16:43.05,Main,Usopp,0,0,0,,Pekâlâ millet,\NUsoland komutayı ele alıyor!
Dialogue: 0,0:16:43.05,0:16:44.92,Main,Usopp,0,0,0,,Hedefimiz bir kız!
Dialogue: 0,0:16:45.27,0:16:48.19,Main,Usopp,0,0,0,,Gidip ödünü patlatalım şunun!
Dialogue: 0,0:16:48.19,0:16:49.59,Main,Usopp,0,0,0,,Takılın peşime!
Dialogue: 0,0:16:49.59,0:16:51.22,Main,Dwarves,0,0,0,,Emredersiniz!
Dialogue: 0,0:16:51.22,0:16:54.51,Main,Usopp,0,0,0,,Yani...
Dialogue: 0,0:16:54.51,0:16:56.26,Main,Usopp,0,0,0,,Yolu siz gösterin!
Dialogue: 0,0:16:56.26,0:16:59.36,Main,Dwarves,0,0,0,,{\i1}Evet!{\i0}
Dialogue: 0,0:16:59.36,0:17:02.17,Main,Leo,0,0,0,,Hedefimiz Yönetim Kulesi!
