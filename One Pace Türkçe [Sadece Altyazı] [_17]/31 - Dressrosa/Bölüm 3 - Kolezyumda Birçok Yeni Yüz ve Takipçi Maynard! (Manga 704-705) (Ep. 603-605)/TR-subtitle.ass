0,2,10,10,15,1Style: Author,Impress BT,25,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1,1,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:23.75,0:00:28.07,Credits,,0,0,0,,Translation & initial timing Tsuki Yibis (Opening)Dialogue: 0,0:00:28.15,0:00:32.16,Credits,,0,0,0,,Timing Sewil Galaxy 9000  Time-checking SewilDialogue: 0,0:00:34.66,0:00:37.60,Credits,,0,0,0,,Quality-checking Sewil Galaxy 9000Dialogue: 0,0:00:39.03,0:00:42.63,Credits,,0,0,0,,Soundtracking HaleeDialogue: 0,0:00:45.50,0:00:48.17,Credits,,0,0,0,,Video editing SewilDialogue: 0,0:01:00.42,0:01:04.52,Credits,,0,0,0,,Raw provider CrunchyrollDialogue: 0,0:00:01.26,0:00:03.90,Wake up! lyrics,,0,0,0,,♪ Gidelim tüm parıltımızla, koşar adım, sonsuza dek! ♪Dialogue: 0,0:00:03.93,0:00:06.66,Wake up! lyrics,,0,0,0,,♪ İlerlemeye devam edelim! ♪Dialogue: 0,0:00:06.70,0:00:09.57,Wake up! lyrics,,0,0,0,,♪ Değişmeyen bağlar mutlak aydınlatacak... ♪Dialogue: 0,0:00:09.63,0:00:12.67,Wake up! lyrics,,0,0,0,,♪ ...rüyamızın sonunu! ♪Dialogue: 0,0:00:12.77,0:00:15.27,Wake up! lyrics,,0,0,0,,♪ Uyan, uyan, uyan, uyan haydi kalbim! ♪Dialogue: 0,0:00:15.34,0:00:18.18,Wake up! lyrics,,0,0,0,,♪ Başaracağız! Durmaksızın devam! ♪Dialogue: 0,0:00:23.72,0:00:28.07,Wake up! lyrics,,0,0,0,,♪ Tek pusulamız özgürlüktür. En sıkı dostlarız. ♪Dialogue: 0,0:00:28.15,0:00:34.59,Wake up! lyrics,,0,0,0,,♪ Kendi rotamızı bundan sonra da yine kendimiz çizeceğiz. ♪Dialogue: 0,0:00:34.66,0:00:39.00,Wake up! lyrics,,0,0,0,,♪ Her gün tam hız ilerliyoruz. Doğuya git, batıya git. ♪Dialogue: 0,0:00:39.06,0:00:45.44,Wake up! lyrics,,0,0,0,,♪ Birbiri ardına yapmak istediğimiz şeyler buluyor ve yapıyoruz da hepsini. ♪Dialogue: 0,0:00:45.50,0:00:50.99,Wake up! lyrics,,0,0,0,,♪ Sabahları etmeye dayanamaz aceleci gönlümüz. (Bekleyemem!) ♪Dialogue: 0,0:00:51.11,0:00:56.05,Wake up! lyrics,,0,0,0,,♪ Neden alıp biz yapıştırmıyoruz güneşi göğe. ♪Dialogue: 0,0:00:56.11,0:00:58.95,Wake up! lyrics,,0,0,0,,♪ Zorla ve yola çıkmıyoruz! ♪Dialogue: 0,0:00:59.95,0:01:02.65,Wake up! lyrics,,0,0,0,,♪ Evet tüm parıltımızla, koşar adım, sonsuza dek! ♪Dialogue: 0,0:01:02.72,0:01:06.59,Wake up! lyrics,,0,0,0,,♪ Hayal kırıntılarımız birleştirerek. ♪Dialogue: 0,0:01:06.66,0:01:10.75,Wake up! lyrics,,0,0,0,,♪ Titretiyorsa eğer gönlünü var mı daha büyük hazine. ♪Dialogue: 0,0:01:10.83,0:01:13.43,Wake up! lyrics,,0,0,0,,♪ Gidelim tüm parıltımızla, koşar adım, sonsuza dek! ♪Dialogue: 0,0:01:13.50,0:01:16.13,Wake up! lyrics,,0,0,0,,♪ İlerlemeye devam edelim! ♪Dialogue: 0,0:01:16.20,0:01:19.17,Wake up! lyrics,,0,0,0,,♪ Değişmeyen bağlar mutlak aydınlatacak... ♪Dialogue: 0,0:01:19.24,0:01:22.24,Wake up! lyrics,,0,0,0,,♪ ...rüyamızın sonunu! ♪Dialogue: 0,0:01:22.31,0:01:24.94,Wake up! lyrics,,0,0,0,,♪ Uyan, uyan, uyan, uyan haydi kalbim ♪Dialogue: 0,0:01:25.01,0:01:27.41,Wake up! lyrics,,0,0,0,,♪ Başaracağız! Durmaksızın devam! ♪Dialogue: 0,0:01:29.41,0:01:32.85,Main,,0,0,0,,Karanlığa kapıl, Hasır Şapka!Dialogue: 0,0:01:33.38,0:01:42.09,Main,,0,0,0,,Yenilmeyeceğim! One Piece'i bulacak ve Korsanlar Kralı olacağım!Dialogue: 0,0:01:44.16,0:01:49.43,Wake up! lyrics,,0,0,0,,♪ Üstesinden geldiğimiz her zorluk arttırıyor olasılıkları. (Kalamam!) ♪Dialogue: 0,0:01:49.60,0:01:54.67,Wake up! lyrics,,0,0,0,,♪ Yarın da, öbürgün de... ♪Dialogue: 0,0:01:54.69,0:01:58.68,Wake up! lyrics,,0,0,0,,♪ Yaşayacağız o içimizi titreten yoğun heyecanı! ♪Dialogue: 0,0:01:58.71,0:02:01.15,Wake up! lyrics,,0,0,0,,♪ Evet tüm parıltımızla, koşar adım, sonsuza dek! ♪Dialogue: 0,0:02:01.21,0:02:05.25,Wake up! lyrics,,0,0,0,,♪ Merakının peşinden koşarken... ♪Dialogue: 0,0:02:05.32,0:02:09.35,Wake up! lyrics,,0,0,0,,♪ Git kaderinin götürdüğü yere keza budur macera dediğin. ♪Dialogue: 0,0:02:09.39,0:02:12.06,Wake up! lyrics,,0,0,0,,♪ Gidelim tüm parıltımızla, koşar adım, sonsuza dek! ♪Dialogue: 0,0:02:12.09,0:02:14.76,Wake up! lyrics,,0,0,0,,♪ Aç kalbinin rota haritasını... ♪Dialogue: 0,0:02:14.79,0:02:17.80,Wake up! lyrics,,0,0,0,,♪ Güçle olan o bağın ele geçirecek... ♪Dialogue: 0,0:02:17.86,0:02:20.93,Wake up! lyrics,,0,0,0,,♪ ...rüyanın sonunu! ♪Dialogue: 0,0:02:20.97,0:02:23.50,Wake up! lyrics,,0,0,0,,♪ Asla, asla, asla, asla engel olma! ♪Dialogue: 0,0:02:23.57,0:02:26.34,Wake up! lyrics,,0,0,0,,♪ Başaracağız! Durmaksızın devam! ♪Dialogue: 0,0:02:30.03,0:02:40.03,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gnsDialogue: 0,0:13:42.90,0:13:52.90,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gnsDialogue: 0,0:26:45.00,0:26:55.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gnsDialogue: 0,0:02:30.03,0:02:38.70,Title,,0,0,0,,Kolezyumda Birçok Yeni Yüz ve Takipçi Maynard!Dialogue: 10,0:02:43.17,0:02:45.54,Main,,0,0,0,,O bücür ne yaptı öyle?!Dialogue: 10,0:02:46.16,0:02:48.54,Main,,0,0,0,,Spartan'ı yendi!Dialogue: 10,0:02:48.54,0:02:49.31,Main,,0,0,0,,Yok artık!Dialogue: 10,0:02:49.31,0:02:52.45,Main,,0,0,0,,Kolezyumun yıldız gladyatörlerinden biri o be!Dialogue: 10,0:02:52.45,0:02:55.62,Main,,0,0,0,,Belki de ayağı falan takılmıştır bir yere?Dialogue: 10,0:02:55.62,0:02:57.79,Main,,0,0,0,,Ayağı takılsa yere gömülür müydü be!Dialogue: 10,0:02:57.79,0:03:00.86,Main,,0,0,0,,Ben nereye oturabilirim acaba?Dialogue: 10,0:03:00.86,0:03:02.78,Main,,0,0,0,,Sen misin burada savaş başlatan?Dialogue: 10,0:03:02.78,0:03:05.03,Main,,0,0,0,,Derhal terk et bu odayı! Diskalifiye edildin!Dialogue: 10,0:03:05.03,0:03:06.20,Main,,0,0,0,,Ne?!Dialogue: 10,0:03:06.20,0:03:08.77,Main,,0,0,0,,Mücadeleler öncesi kavga çıkartan serserilerle işimiz yok bizim!Dialogue: 10,0:03:11.66,0:03:13.27,Main,,0,0,0,,Durun bakalım!Dialogue: 0,0:03:13.42,0:03:16.76,Captions,,0,0,210,,Chinjao Ailesi Kano Krallığı'ndan Bir EkipDialogue: 10,0:03:14.65,0:03:16.76,Main,,0,0,0,,Tam orada bir durun!Dialogue: 0,0:03:16.72,0:03:20.26,Captions,,0,0,420,,Don ChinjaoDialogue: 0,0:03:17.89,0:03:22.73,Captions,,750,0,210,,SaiDialogue: 10,0:03:18.02,0:03:23.08,Main,,0,0,0,,Birini diskalifiye edecekseniz şu kocamanı etmeniz lazım, o başlattı!Dialogue: 0,0:03:22.83,0:03:24.75,Captions,,0,650,210,,BooDialogue: 10,0:03:23.08,0:03:24.75,Main,,0,0,0,,Gerçi artık kendinde değil ya...Dialogue: 10,0:03:24.75,0:03:27.74,Main,,0,0,0,,Kano Krallığı'ndan Sai'yle Boo!Dialogue: 10,0:03:27.74,0:03:29.90,Main,,0,0,0,,Don Chinjao bile gelmiş!Dialogue: 10,0:03:29.90,0:03:31.59,Main,,0,0,0,,Efsane be o adam!Dialogue: 10,0:03:32.90,0:03:35.05,Main,,0,0,0,,Sayenizde oldu, sağ olun!Dialogue: 10,0:03:35.05,0:03:37.68,Main,,0,0,0,,Lafı olmaz!Dialogue: 10,0:03:37.68,0:03:40.86,Main,,0,0,0,,Lafı olmaz yahu!Dialogue: 10,0:03:40.86,0:03:43.34,Main,,0,0,0,,Sağ olasın demene gerek yok...Dialogue: 10,0:03:43.34,0:03:45.90,Main,,0,0,0,,Sağ olasın dediğini duymamıza lüzum yok...Dialogue: 10,0:03:45.90,0:03:49.52,Main,,0,0,0,,Teşekkürünü geri al lan!Dialogue: 10,0:03:49.52,0:03:51.78,Main,,0,0,0,,Teşekkürü bu kadar reddetmene gerek yok ağabey!Dialogue: 10,0:03:51.78,0:03:54.56,Main,,0,0,0,,Bana öyle kelimeler kullanma aptal herif!Dialogue: 10,0:03:54.56,0:03:57.93,Main,,0,0,0,,Kusuruna bakma, çok çabuk galeyana gelir.Dialogue: 10,0:03:57.93,0:03:59.58,Main,,0,0,0,,Çeşit çeşit insan var işte dünyada.Dialogue: 10,0:03:59.58,0:04:05.46,Main,,0,0,0,,Lanet olası, kendi grubundakilerle çeteleşmeyi bırak artık Dagama!Dialogue: 10,0:04:05.46,0:04:07.58,Main,,0,0,0,,Şuna bakın!Dialogue: 10,0:04:07.58,0:04:11.33,Main,,0,0,0,,Evet, neredeyse her bir ülkenin tüm kodamanları toplanmış.Dialogue: 0,0:04:11.64,0:04:17.30,Captions,,0,0,240,,Funk Kardeşler Komşu Bir Ülkenin SuikastçileriDialogue: 10,0:04:11.69,0:04:17.30,Main,,0,0,0,,Olay şeytan meyvesi için verilen ülkeler arası bir müsabakaya dönecek gibi.Dialogue: 0,0:04:17.51,0:04:22.01,Captions,,0,0,180,,Kelly Funk - Büyük KardeşDialogue: 10,0:04:17.30,0:04:20.20,Main,,0,0,0,,Çeteleşip başkalarının ipini kesmek ha?Dialogue: 10,0:04:20.20,0:04:22.01,Main,,0,0,0,,Tüküreyim sizin gibilerine!Dialogue: 0,0:04:22.11,0:04:29.74,Captions,,0,0,180,,Bobby Funk - Küçük KardeşDialogue: 10,0:04:22.01,0:04:24.66,Main,,0,0,0,,Savaşlar bireysel.Dialogue: 10,0:04:24.66,0:04:29.98,Main,,0,0,0,,Çeteleşip hile yapmaya kalksanız bile nihayetinde her bloğun tek galibi bir sonraki tura geçecek.Dialogue: 0,0:04:30.09,0:04:36.10,Captions,,0,0,260,,Dagama - Prodence Krallığı TaktiçisiDialogue: 10,0:04:29.98,0:04:32.58,Main,,0,0,0,,Bana maval okumayı kesin!Dialogue: 10,0:04:32.58,0:04:35.85,Main,,0,0,0,,Siz de ülkenizin emriyle buraya geldiniz!Dialogue: 10,0:04:35.85,0:04:38.29,Main,,0,0,0,,Mera Mera'yı ele geçiren ülke...Dialogue: 10,0:04:38.29,0:04:40.68,Main,,0,0,0,,...sahip olduğu tüm silahlardan bile daha büyük bir güce sahip olmayı geçtim...Dialogue: 0,0:04:38.80,0:04:44.30,Captions,,0,0,240,,Elizabello II - Dövüşen Kral Prodence Krallığı KralıDialogue: 10,0:04:40.68,0:04:44.30,Main,,0,0,0,,...aynı zamanda diplomatik ilişkiler ve gözdağı konusunda da büyük bir üstünlüğe kavuşacak!Dialogue: 10,0:04:44.89,0:04:49.15,Main,,0,0,0,,Kafanı kaldır da etrafındakilere bir bak!Dialogue: 10,0:04:49.42,0:04:54.59,Main,,0,0,0,,Al işte hemen şurada Dias Deniz Savaşı'na katılmış A sınıfı suçlu Cellat Suleiman duruyor!Dialogue: 10,0:04:55.30,0:05:00.88,Main,,0,0,0,,Hükümet tesisini bombalamış eski ödül avcıları Abdullah ve Jeet!Dialogue: 10,0:05:01.13,0:05:05.78,Main,,0,0,0,,Uydurma maceracı Halledici Orlumbus.Dialogue: 10,0:05:06.14,0:05:08.90,Main,,0,0,0,,Don Quixote Ailesi'nin desteklediği...Dialogue: 10,0:05:08.90,0:05:12.99,Main,,0,0,0,,...100 milyonun üstünde ödülü olan sadist korsan Sırtlan Bellamy.Dialogue: 10,0:05:12.99,0:05:17.40,Main,,0,0,0,,Ayrıca Korsan Asilzade Cavendish'in yanısıra...Dialogue: 10,0:05:17.40,0:05:22.21,Main,,0,0,0,,...bir yıl önce ünlenmiş çılgın çaylak Bartolomeo da burada!Dialogue: 10,0:05:22.21,0:05:28.57,Main,,0,0,0,,Söyle bakalım şimdi sence bunca adı çıkmış kişi hiç plan yapmıyor mu?Dialogue: 10,0:05:29.34,0:05:32.03,Main,,0,0,0,,Eğer yapmıyorlarsa aptallar demektir!Dialogue: 10,0:05:32.03,0:05:35.20,Main,,0,0,0,,Eminim siz de kendinizce planlar yapıyorsunuzdur!Dialogue: 10,0:05:35.80,0:05:38.62,Main,,0,0,0,,İlk tur serbest mücadele olacak.Dialogue: 10,0:05:38.62,0:05:41.42,Main,,0,0,0,,Bloklardan yalnızca birer galip sonraki tura geçebilecek.Dialogue: 10,0:05:41.42,0:05:43.86,Main,,0,0,0,,İşte bu!Dialogue: 10,0:05:43.86,0:05:45.84,Main,,0,0,0,,A bloğunun savaşı yakında başlayacak!Dialogue: 10,0:05:45.84,0:05:49.03,Main,,0,0,0,,Sonra da B, C ve D blokları savaşacak.Dialogue: 10,0:05:49.03,0:05:52.88,Main,,0,0,0,,Toplam 550 kişilik katılımcı kafilesinden...Dialogue: 10,0:05:52.88,0:05:56.74,Main,,0,0,0,,...yalnızca dört kişi ilk turu kazanabilecek!Dialogue: 10,0:05:56.74,0:06:00.87,Main,,0,0,0,,Yani kazanmak öyle kolay olmayacak.Dialogue: 10,0:06:00.87,0:06:02.47,Main,,0,0,0,,Değil mi ama?!Dialogue: 10,0:06:02.47,0:06:08.38,Main,,0,0,0,,Siz de birilerine rüşvet yedirerek abi kardeş aynı bloğa düştünüz kesin.Dialogue: 10,0:06:08.38,0:06:09.91,Main,,0,0,0,,Tamamen rastlantı!Dialogue: 10,0:06:11.07,0:06:13.12,Main,,0,0,0,,Rastlantı.Dialogue: 10,0:06:13.12,0:06:15.34,Main,,0,0,0,,Ben hangi bloktayım?Dialogue: 10,0:06:15.34,0:06:17.87,Main,,0,0,0,,Karşılama görevlisinin söylemiş olması lazım.Dialogue: 10,0:06:18.38,0:06:20.76,Main,,0,0,0,,Numaran 556 olduğuna göre C bloğundasındır.Dialogue: 10,0:06:20.76,0:06:23.72,Main,,0,0,0,,Herkesin başka başka şeyler peşinde olduğunu biliyorum fakat...Dialogue: 10,0:06:23.72,0:06:29.20,Main,,0,0,0,,...Mera Mera Meyvesi'ni kazanacak kişiye göre yarın çok farklı bir dünyaya uyanabiliriz.Dialogue: 10,0:06:29.20,0:06:33.30,Main,,0,0,0,,O yüzden boş lafı bırakalım da elimizden geleni yapalım beyler!Dialogue: 10,0:06:43.43,0:06:48.39,Main,,0,0,0,,Zırhlar! Miğferler!Dialogue: 0,0:06:48.57,0:06:53.16,Captions,,0,0,210,,Kolezyum CephaneliğiDialogue: 10,0:06:48.39,0:06:53.16,Main,,0,0,0,,Harika! İstediğimizi kullanabiliyor muyuz?!Dialogue: 10,0:06:53.16,0:06:55.79,Main,,0,0,0,,Ateşli silahlar hariç her şey kullanılabilir.Dialogue: 10,0:06:56.50,0:06:59.28,Main,,0,0,0,,Yarı çıplak ihtiyar savaşçı heykeli!Dialogue: 10,0:06:59.28,0:07:01.73,Main,,0,0,0,,Harika!Dialogue: 10,0:07:01.73,0:07:04.07,Main,,0,0,0,,İstiyorum!Dialogue: 10,0:07:04.97,0:07:07.02,Main,,0,0,0,,Bu zırhı giyeceğim!Dialogue: 10,0:07:07.02,0:07:09.61,Main,,0,0,0,,Bir de ihtiyardan bile havalı bir miğfer!Dialogue: 10,0:07:11.58,0:07:13.14,Main,,0,0,0,,Mükemmelim!Dialogue: 10,0:07:13.41,0:07:15.93,Main,,0,0,0,,Keşke Usopp'lara da gösterebilsem!Dialogue: 10,0:07:20.82,0:07:22.25,Main,,0,0,0,,Ne oldu?!Dialogue: 10,0:07:22.25,0:07:25.36,Main,,0,0,0,,Asilzade çok...Dialogue: 10,0:07:25.36,0:07:26.12,Main,,0,0,0,,Asilzade mi?!Dialogue: 10,0:07:26.12,0:07:29.32,Main,,0,0,0,,Tüm kadın görevliler bayılmaya başladılar!Dialogue: 10,0:07:29.32,0:07:29.76,Main,,0,0,0,,Ne dedin?!Dialogue: 10,0:07:32.30,0:07:34.64,Main,,0,0,0,,Olamaz, kalbim bu heyecana dayanmayacak!Dialogue: 10,0:07:35.95,0:07:38.70,Main,,0,0,0,,Şuna bakın, Cavendish bu!Dialogue: 10,0:07:38.70,0:07:41.53,Main,,0,0,0,,Korsan Asilzade mi!? Yaşıyor muymuş?Dialogue: 10,0:07:41.53,0:07:43.48,Main,,0,0,0,,Ne güzelliktir bu böyle?!Dialogue: 10,0:07:44.98,0:07:47.91,Main,,0,0,0,,Soyunma odası burası demek?Dialogue: 10,0:07:48.34,0:07:50.32,Main,,0,0,0,,Sen oradaki!Dialogue: 10,0:07:51.57,0:07:53.22,Main,,0,0,0,,Olmaz öyle.Dialogue: 0,0:07:54.50,0:07:58.41,Captions,,0,0,240,,Lucy - GladyatörDialogue: 10,0:07:54.37,0:07:58.41,Main,,0,0,0,,Giyebileceklerin konusunda bir ağırlık sınırı var.Dialogue: 10,0:07:58.96,0:08:02.99,Main,,0,0,0,,Ne yapsan beyhude gerçi.Dialogue: 10,0:08:03.54,0:08:06.48,Main,,0,0,0,,Mera Mera Meyvesi'ni ben kazanacağım.Dialogue: 0,0:08:06.55,0:08:08.87,Captions,,0,0,280,,Güzel Korsanlar'ın Kaptanı "Beyaz Atlı Cavendish"  Ödülü: 280 Milyon BeliDialogue: 10,0:08:09.17,0:08:15.59,Main,,0,0,0,,Evet! Sade ve sadece bana ait o güzel güç...Dialogue: 10,0:08:16.16,0:08:17.40,Main,,0,0,0,,Ağırlık sınırını aşıyorsun.Dialogue: 10,0:08:17.40,0:08:18.47,Main,,0,0,0,,Ne?Dialogue: 10,0:08:18.47,0:08:21.05,Main,,0,0,0,,Az önce kime dedim ben! Gel az şöyle!Dialogue: 10,0:08:21.05,0:08:24.25,Main,,0,0,0,,Öf ya, ne de harika olmuştum oysaki!Dialogue: 10,0:08:24.75,0:08:27.99,Main,,0,0,0,,Demek o yüzden herkes yarı çıplak.Dialogue: 10,0:08:28.82,0:08:32.12,Main,,0,0,0,,Glatyatörler onlar için gösterinin bir parçası sadece.Dialogue: 10,0:08:32.12,0:08:35.99,Main,,0,0,0,,Kaybeden kişiden dökülen kanı görmek seyirciyi coşturur.Dialogue: 10,0:08:35.99,0:08:42.62,Main,,0,0,0,,İnsanlar gerçek kişiliklerini ortaya dökerler kolezyumda.Dialogue: 10,0:08:42.62,0:08:46.15,Main,,0,0,0,,Kim boğazına kadar zırhla kaplı insanlar arasındaki bitmek bilmez müsabakayı izlemek ister ki?Dialogue: 10,0:08:46.15,0:08:51.24,Main,,0,0,0,,Onlar için bu savaş bir gösteriden ibaret.Dialogue: 10,0:08:51.24,0:08:53.28,Main,,0,0,0,,Pelerini de mi çıkartsam acaba?Dialogue: 10,0:08:53.64,0:08:55.88,Main,,0,0,0,,Çok da harika duruyordu!Dialogue: 10,0:08:56.66,0:08:57.98,Main,,0,0,0,,Baksana...Dialogue: 10,0:08:59.46,0:09:03.36,Main,,0,0,0,,...az önce şu koca herifi yenerken gördüm seni.Dialogue: 10,0:09:03.36,0:09:04.69,Main,,0,0,0,,Kimsin sen?Dialogue: 10,0:09:04.69,0:09:05.86,Main,,0,0,0,,Luffy ben!Dialogue: 10,0:09:05.86,0:09:06.74,Main,,0,0,0,,Ne?!Dialogue: 10,0:09:07.52,0:09:08.16,Main,,0,0,0,,Lu...Dialogue: 10,0:09:08.16,0:09:10.90,Main,,0,0,0,,Korsanlar Kralı olacak adamım!Dialogue: 10,0:09:11.88,0:09:12.95,Main,,0,0,0,,Lu...Dialogue: 10,0:09:12.95,0:09:14.74,Main,,0,0,0,,Lucy değil mi senin adın be?!Dialogue: 10,0:09:14.74,0:09:16.30,Main,,0,0,0,,Sahi ya, Lucy'di evet.Dialogue: 10,0:09:17.36,0:09:19.87,Main,,0,0,0,,Kafamızı karıştırmasana!Dialogue: 10,0:09:19.87,0:09:22.20,Main,,0,0,0,,Lucy demek?Dialogue: 10,0:09:22.20,0:09:24.82,Main,,0,0,0,,Hasır Şapkalı Luffy burada sandım bir an!Dialogue: 10,0:09:24.82,0:09:26.14,Main,,0,0,0,,Öyle olmadığı bariz ortada!Dialogue: 10,0:09:26.14,0:09:29.28,Main,,0,0,0,,Ben onun sekiz metre olduğunu duymuştum!Dialogue: 10,0:09:29.28,0:09:30.78,Main,,0,0,0,,Bunu sevdim bak!Dialogue: 10,0:09:32.02,0:09:34.06,Main,,0,0,0,,Sahiden de...Dialogue: 10,0:09:34.86,0:09:37.36,Main,,0,0,0,,...Hasır Şapkalı Luffy olsaydın...Dialogue: 10,0:09:37.36,0:09:40.83,Main,,0,0,0,,...seni şuracıkta öldürürdüm.Dialogue: 10,0:09:40.83,0:09:41.83,Main,,0,0,0,,Ne?Dialogue: 10,0:09:41.83,0:09:45.80,Main,,0,0,0,,Yeni Dünya'ya üç yıl önce geldim.Dialogue: 10,0:09:47.32,0:09:52.89,Main,,0,0,0,,Herkes 200 milyondan fazla ödülü olan o güzel çaylağı konuşuyordu.Dialogue: 10,0:09:53.76,0:09:56.38,Main,,0,0,0,,Her gün gazetelerde ben vardım.Dialogue: 10,0:09:56.38,0:10:00.86,Main,,0,0,0,,Kızlar aranıyor posterlerim için deli olurlardı.Dialogue: 10,0:10:00.86,0:10:05.46,Main,,0,0,0,,Dağıtılan posterlerin hepsini çalarlardı.Dialogue: 10,0:10:07.02,0:10:09.78,Main,,0,0,0,,Herkes benim için deli olurdu.Dialogue: 10,0:10:10.42,0:10:12.27,Main,,0,0,0,,"Büyük yıldız bize bak!"Dialogue: 10,0:10:12.27,0:10:13.74,Main,,0,0,0,,"Ne, bana mı seslendiniz?"Dialogue: 10,0:10:13.74,0:10:14.73,Main,,0,0,0,,"Elbette!"Dialogue: 10,0:10:16.58,0:10:17.43,Main,,0,0,0,,Ama...Dialogue: 10,0:10:17.43,0:10:19.55,Main,,0,0,0,,...bir yılın ardından...Dialogue: 10,0:10:20.40,0:10:23.75,Main,,0,0,0,,...tüm dikkatleri Beyazsakal'ın En İyiler Savaşı topladı!Dialogue: 10,0:10:24.18,0:10:29.60,Main,,0,0,0,,Hasır Şapkalı Luffy, Beyazsakal'la birlikte dünyanın yeni gözdesi haline dönüştü!Dialogue: 10,0:10:30.26,0:10:31.49,Main,,0,0,0,,Bununla kalsa iyi ya!Dialogue: 10,0:10:31.84,0:10:36.58,Main,,0,0,0,,Birbiri ardına ortaya çıkan çaylaklar üzerlerindeki o Musibet Nesil damgasıyla birlikte...Dialogue: 10,0:10:36.58,0:10:39.36,Main,,0,0,0,,...ortalığı birbirine katmaya başladılar.Dialogue: 10,0:10:39.72,0:10:42.99,Main,,0,0,0,,Gazeteciler resmen beni görmez oldular!Dialogue: 10,0:10:42.99,0:10:46.86,Main,,0,0,0,,O yüzden de o can sıkıcı yeni gelenleri geberteceğim!Dialogue: 10,0:10:46.86,0:10:48.39,Main,,0,0,0,,Hepsini de!Dialogue: 10,0:10:48.39,0:10:50.90,Main,,0,0,0,,Biraz abartıyorsun sanki?Dialogue: 10,0:10:50.90,0:10:52.40,Main,,0,0,0,,Ne dersen de!Dialogue: 10,0:10:52.40,0:10:55.66,Main,,0,0,0,,Dünyanın kalbini yeniden kazanabilmek için...Dialogue: 10,0:10:55.66,0:10:59.42,Main,,0,0,0,,...kaç yeni yetmeyi gebertmem gerekirse gereksin bunu yapacağım.Dialogue: 10,0:11:00.94,0:11:05.03,Main,,0,0,0,,Bunun için de Mera Mera Meyvesi'ni ele geçireceğim!Dialogue: 10,0:11:05.52,0:11:06.93,Main,,0,0,0,,Böyle tamamsın.Dialogue: 10,0:11:06.93,0:11:10.68,Main,,0,0,0,,Kime konuşuyorum ben ya!Dialogue: 10,0:11:13.42,0:11:14.90,Main,,0,0,0,,Sen de mi savaşacaksın?Dialogue: 10,0:11:14.90,0:11:17.22,Main,,0,0,0,,Pek güçlü görünmesen de epey şirinmişsin!Dialogue: 10,0:11:20.80,0:11:23.70,Main,,0,0,0,,Evet...Dialogue: 10,0:11:23.70,0:11:27.00,Main,,0,0,0,,Bu ihtiyara benzedim sonuçta.Dialogue: 10,0:11:27.42,0:11:29.58,Main,,0,0,0,,O adam ilgini mi çekti?Dialogue: 10,0:11:30.18,0:11:30.97,Main,,0,0,0,,Sen de kimsin?Dialogue: 10,0:11:31.92,0:11:35.78,Main,,0,0,0,,Rebecca. Gladyatörüm.Dialogue: 0,0:11:34.51,0:11:39.98,Captions,,0,0,240,,Rebecca  Corrida Kolezyumu GladyatörüDialogue: 10,0:11:35.78,0:11:37.54,Main,,0,0,0,,Az önce yaptığın şey için teşekkür ederim.Dialogue: 10,0:11:37.54,0:11:39.98,Main,,0,0,0,,Spartan'dan nefret ederdim.Dialogue: 10,0:11:41.38,0:11:44.48,Main,,0,0,0,,Bu adam bir efsaneydi.Dialogue: 10,0:11:44.48,0:11:49.85,Main,,0,0,0,,Corrida Kolezyumu tarihindeki en güçlü gladyatör, Kyros!Dialogue: 10,0:11:49.85,0:11:53.22,Main,,0,0,0,,Yaptığı 3000 maçın 3000'ini de kazanmış biri.Dialogue: 10,0:11:53.22,0:11:56.62,Main,,0,0,0,,Ve sadece bir kez yaralanmıştır.Dialogue: 10,0:11:56.62,0:11:59.30,Main,,0,0,0,,Vay canına, o kadar mükemmel biri demek!Dialogue: 10,0:11:59.30,0:12:02.96,Main,,0,0,0,,20 yıl öncesine kadar hâlâ savaşıyormuş.Dialogue: 10,0:12:04.17,0:12:09.77,Main,,0,0,0,,Fakat bu şehirde kimse onu bilmez.Dialogue: 10,0:12:09.77,0:12:10.56,Main,,0,0,0,,Ne?Dialogue: 10,0:12:10.56,0:12:16.34,Main,,0,0,0,,Ülkenin yaşlıları olsun, gladyatörleri olsun kimseler onu görmemiş.Dialogue: 10,0:12:16.34,0:12:19.78,Main,,0,0,0,,Dressrosa'daki en gizemli heykeldir bu.Dialogue: 10,0:12:19.78,0:12:22.46,Main,,0,0,0,,Gladyatör Kyros gerçekten var mıydı...Dialogue: 10,0:12:22.46,0:12:29.26,Main,,0,0,0,,...yoksa birileri mi uydurdu, bu heykel ne zaman ve niçin yapıldı bilinmez.Dialogue: 10,0:12:29.26,0:12:34.87,Main,,0,0,0,,Tek bildiğimiz bu levhada yazanlar.Dialogue: 10,0:12:34.87,0:12:37.17,Main,,0,0,0,,Onu kimseler tanımasa da...Dialogue: 10,0:12:37.17,0:12:40.67,Main,,0,0,0,,...kimseler buradan kaldırmak da istemiyor.Dialogue: 10,0:12:40.67,0:12:42.77,Main,,0,0,0,,Bu da bir o kadar tuhaf.Dialogue: 10,0:12:42.77,0:12:45.82,Main,,0,0,0,,Pek anlamadım ama...Dialogue: 10,0:12:45.82,0:12:49.58,Main,,0,0,0,,...bu heykeli çok sevdim ben, çok erkeksi!Dialogue: 10,0:12:51.06,0:12:53.06,Main,,0,0,0,,Ben de seviyorum.Dialogue: 10,0:12:53.06,0:12:55.75,Main,,0,0,0,,Selam büyük savaşçı Rebecca-chan!Dialogue: 10,0:12:57.66,0:13:00.72,Main,,0,0,0,,Yenilmez kız! Bugün de öyle olur umarım!Dialogue: 10,0:13:00.72,0:13:02.92,Main,,0,0,0,,Hem çok sevinmişsindir!Dialogue: 10,0:13:02.92,0:13:06.56,Main,,0,0,0,,Yıllardır sana sataşan Spartan'ı öyle yenilirken görmek falan...Dialogue: 10,0:13:07.56,0:13:09.97,Main,,0,0,0,,Neyse beyler bırakın! Gidelim!Dialogue: 10,0:13:12.94,0:13:14.32,Main,,0,0,0,,Bunlar da ne ayak böyle?Dialogue: 10,0:13:14.32,0:13:15.34,Main,,0,0,0,,Boşver onları sen.Dialogue: 10,0:13:17.84,0:13:19.01,Main,,0,0,0,,Ben...Dialogue: 10,0:13:21.82,0:13:24.66,Main,,0,0,0,,...bugün son kez savaşacağım.Dialogue: 10,0:13:24.66,0:13:27.85,Main,,0,0,0,,Mera Mera Meyvesi'nin gücünü elde edecek...Dialogue: 10,0:13:27.85,0:13:31.12,Main,,0,0,0,,...ve Doflamingo'yu öldüreceğim!Dialogue: 10,0:13:31.12,0:13:33.22,Main,,0,0,0,,Ne?! Mingo'yu mu?!Dialogue: 10,0:13:33.64,0:13:35.31,Main,,0,0,0,,Hangi bloktasın?Dialogue: 10,0:13:35.31,0:13:36.16,Main,,0,0,0,,C.Dialogue: 10,0:13:36.16,0:13:38.43,Main,,0,0,0,,Harika öyleyse, ben D'deyim.Dialogue: 10,0:13:38.98,0:13:42.60,Main,,0,0,0,,Umarım ikimiz de ilk turdan sağ çıkarız.Dialogue: 10,0:13:43.52,0:13:45.49,Main,,0,0,0,,Lucy.Dialogue: 10,0:13:57.66,0:14:01.69,Main,,0,0,0,,A bloğunun kazananı kese kağıtlı adam!Dialogue: 10,0:14:01.69,0:14:04.59,Main,,0,0,0,,Bay Store!Dialogue: 10,0:14:07.17,0:14:10.46,Main,,0,0,0,,Göz açıp kapayana kadar oldu bitti her şey!Dialogue: 10,0:14:11.48,0:14:16.63,Main,,0,0,0,,Maskesini gerçekten de çıkartacak mı acaba?!Dialogue: 10,0:14:17.42,0:14:20.30,Main,,0,0,0,,Çıkarttı!Dialogue: 10,0:14:20.88,0:14:22.57,Main,,0,0,0,,Ne?!Dialogue: 10,0:14:23.72,0:14:29.61,Main,,0,0,0,,Gözlerime inanamıyorum! Kese kağıtlı adam tanıdığımız biri çıktı!Dialogue: 10,0:14:29.61,0:14:32.68,Main,,0,0,0,,Ne ilginç bir başlangıç, ne beklenmedik bir yarışmacı!Dialogue: 10,0:14:32.68,0:14:36.70,Main,,0,0,0,,A bloğu serbest dövüşünün kazananı...Dialogue: 10,0:14:37.29,0:14:39.62,Main,,0,0,0,,Bu herif...Dialogue: 10,0:14:39.62,0:14:44.44,Main,,0,0,0,,...ağlayan bebeklerin bile sesini kesen Yonkou Karasakal Korsanları'nın Birinci Gemi Kaptanı...Dialogue: 10,0:14:44.44,0:14:48.06,Main,,0,0,0,,...Jesus Burgess!Dialogue: 10,0:14:51.50,0:14:52.55,Main,,0,0,0,,Bu herif...Dialogue: 10,0:14:53.52,0:14:56.14,Main,,0,0,0,,...daha önce tanıştığım o şampiyon!Dialogue: 0,0:14:59.19,0:15:03.78,Captions,,0,0,210,,Sahne 1 "Corrida Kolezyumu"Dialogue: 10,0:15:00.70,0:15:03.78,Main,,0,0,0,,Karasakal Korsanları mı?!Dialogue: 10,0:15:03.78,0:15:08.32,Main,,0,0,0,,Luffy böyle bir şeyi kolayca kazanır diyordum ama...Dialogue: 10,0:15:08.32,0:15:10.76,Main,,0,0,0,,...belki de biraz zorlayacak.Dialogue: 10,0:15:10.76,0:15:13.39,Main,,0,0,0,,Umarım kimliği açığa çıkmaz.Dialogue: 10,0:15:13.39,0:15:15.76,Main,,0,0,0,,Ben de yavaştan işimin başına döneyim.Dialogue: 10,0:15:15.76,0:15:18.70,Main,,0,0,0,,Dur biraz, ben de geliyorum!Dialogue: 10,0:15:19.24,0:15:20.70,Main,,0,0,0,,Bu ne şimdi ya! Bırak!Dialogue: 10,0:15:20.70,0:15:23.97,Main,,0,0,0,,Fabrikanın yerini bilmeyen biriyle işim yok benim!Dialogue: 10,0:15:23.97,0:15:27.54,Main,,0,0,0,,Doflamingo ailesinden rütbeli birinin ağzını yüzünü dağıtıp...Dialogue: 10,0:15:28.04,0:15:30.58,Main,,0,0,0,,Dur biraz be, sessiz ol!Dialogue: 10,0:15:28.04,0:15:30.58,Secondary,,0,0,0,,...fabrikanın nerede olduğunu...Dialogue: 10,0:15:30.58,0:15:32.54,Main,,0,0,0,,Ne be?!Dialogue: 10,0:15:33.98,0:15:35.96,Main,,0,0,0,,Başka bir yere gidelim!Dialogue: 10,0:15:35.96,0:15:38.35,Main,,0,0,0,,Böyle bir yerde söylenmemesi  gereken şeyler söylüyorsun!Dialogue: 10,0:15:38.90,0:15:41.59,Main,,0,0,0,,Sen de kimsin?Dialogue: 0,0:15:41.86,0:15:44.12,Captions,,0,0,210,,Aynı Yer "Tribün Civarı"Dialogue: 10,0:15:42.22,0:15:44.12,Main,,0,0,0,,"Korsan Asker" Hajrudin!Dialogue: 0,0:15:44.12,0:15:45.54,Main,,0,0,0,,Cavendish!?Dialogue: 10,0:15:45.54,0:15:47.52,Main,,0,0,0,,"Misyoner" Gambia bile katılımcılar arasında!Dialogue: 10,0:15:47.52,0:15:48.80,Main,,0,0,0,,Çabucak gidelim!Dialogue: 10,0:15:48.80,0:15:51.83,Main,,0,0,0,,Aceleye ne lüzum var yahu!Dialogue: 10,0:15:51.83,0:15:54.53,Main,,0,0,0,,Evet, al birini vur ötekine.Dialogue: 10,0:15:54.92,0:15:57.58,Main,,0,0,0,,Burgess benim için de büyük sürpriz oldu.Dialogue: 10,0:15:57.58,0:16:00.40,Main,,0,0,0,,Derhal Issho-san'la konuşacağım.Dialogue: 10,0:16:00.40,0:16:01.36,Main,,0,0,0,,Pekâlâ.Dialogue: 10,0:16:01.36,0:16:02.67,Main,,0,0,0,,Bak az!Dialogue: 10,0:16:02.67,0:16:06.28,Main,,0,0,0,,Abicim, kendi kendine mi konuşuyorsun?Dialogue: 0,0:16:10.06,0:16:14.57,Captions,,0,0,240,,Barto Kulübü Korsan Grubunun Üye Sorumlusu, Ödülü: 67 Milyon BeliDialogue: 0,0:16:15.23,0:16:19.72,Captions,,0,0,180,,Misyoner GambiaDialogue: 10,0:16:09.48,0:16:14.70,Main,,0,0,0,,Yoksa gerçekten de biriyle mi konuşuyordun?Dialogue: 10,0:16:14.70,0:16:18.39,Main,,0,0,0,,Oldukça şüpheli bir durum!Dialogue: 10,0:16:20.83,0:16:22.70,Main,,0,0,0,,Değil mi ama, değil mi ama?Dialogue: 10,0:16:22.70,0:16:24.60,Main,,0,0,0,,Ne yazıyor o kağıtta?Dialogue: 10,0:16:24.60,0:16:27.63,Main,,0,0,0,,Fısır fısır bir sürü güzel isim çıktı ağzından!Dialogue: 10,0:16:28.34,0:16:31.04,Main,,0,0,0,,Yoksa Donanma'dan mısın?!Dialogue: 10,0:16:32.10,0:16:36.50,Main,,0,0,0,,İyi misiniz efendim? Cevap verin!Dialogue: 10,0:16:36.50,0:16:38.14,Main,,0,0,0,,Her şey yolunda.Dialogue: 10,0:16:38.14,0:16:40.68,Main,,0,0,0,,On dakika sonra yine arayacağım.Dialogue: 10,0:16:42.38,0:16:45.96,Main,,0,0,0,,Seyirciler hâlâ A bloğu savaşının coşkusunu yaşıyor!Dialogue: 10,0:16:45.96,0:16:51.08,Main,,0,0,0,,Acaba B bloğunda nasıl bir savaş baş gösterecek!Dialogue: 10,0:16:51.08,0:16:52.59,Main,,0,0,0,,Gidelim yavaştan.Dialogue: 10,0:16:53.00,0:16:57.46,Main,,0,0,0,,Epey tanıdık isim geçiyor, değil mi?Dialogue: 10,0:17:00.18,0:17:02.10,Main,,0,0,0,,Ne yapmalıyız sizce?Dialogue: 10,0:17:02.54,0:17:03.53,Main,,0,0,0,,Paltonuz.Dialogue: 0,0:17:19.86,0:17:24.87,Captions,,0,0,180,,Donanma Kârargahı AmirallerindenDialogue: 0,0:17:25.00,0:17:29.49,Captions,,0,0,250,,Fujitora (Issho)Dialogue: 10,0:17:11.82,0:17:16.90,Main,,0,0,0,,Bize sanırım üç Donanma gemisi gerekecek.Dialogue: 10,0:17:16.90,0:17:21.66,Main,,0,0,0,,Bu arada biz de şeye gidelim...Dialogue: 10,0:17:21.66,0:17:23.62,Main,,0,0,0,,Neydi adı?Dialogue: 10,0:17:23.62,0:17:25.12,Main,,0,0,0,,Green Bit efendim.Dialogue: 10,0:17:25.12,0:17:27.26,Main,,0,0,0,,Evet, oraya gidelim işte.Dialogue: 10,0:17:27.26,0:17:29.49,Main,,0,0,0,,Bir de neydi...Dialogue: 10,0:17:29.49,0:17:33.26,Main,,0,0,0,,Mümkün olduğunda çok sıhhiye hazır bulunsun.Dialogue: 10,0:17:33.26,0:17:35.83,Main,,0,0,0,,Ne kadar yaralımız olacak bilinmez.Dialogue: 10,0:17:35.83,0:17:40.46,Main,,0,0,0,,Ayrıca bir de kolezyumdaki izleyici sayısıyla...Dialogue: 10,0:17:40.46,0:17:43.02,Main,,0,0,0,,...şehrin nüfusunu öğrenmenizi istiyorum.Dialogue: 10,0:17:43.02,0:17:46.46,Main,,0,0,0,,Emredersiniz... Fakat düşman sayısı daha önemli değil mi?Dialogue: 10,0:17:46.46,0:17:48.13,Main,,0,0,0,,Böyle bir şey gerekli mi?Dialogue: 10,0:17:48.90,0:17:55.85,Main,,0,0,0,,Göz önünde bulundurmamız gereken şey düşman sayısından ziyade...Dialogue: 10,0:17:55.85,0:18:00.32,Main,,0,0,0,,...korumamız gereken insan sayısıdır, yanılıyor muyum?Dialogue: 10,0:18:05.02,0:18:05.86,Main,,0,0,0,,Emredersiniz!Dialogue: 10,0:18:05.86,0:18:07.82,Main,,0,0,0,,Maynard ben.Dialogue: 10,0:18:08.53,0:18:10.94,Main,,0,0,0,,Maynard ben.Dialogue: 10,0:18:11.32,0:18:13.37,Main,,0,0,0,,Burada her şey yolunda.Dialogue: 0,0:18:13.54,0:18:17.07,Captions,,0,0,220,,Tuvalet/ÇöplükDialogue: 0,0:18:17.21,0:18:21.38,Captions,,0,0,250,,0429 numara  CapmanDialogue: 10,0:18:13.76,0:18:17.07,Main,,0,0,0,,Yalnız az önce bahsettiğim Misyoner Gambia...Dialogue: 10,0:18:17.07,0:18:19.50,Main,,0,0,0,,...şu Bartolomeo'nun adamlarından olan...Dialogue: 10,0:18:19.50,0:18:21.38,Main,,0,0,0,,Onun adını silebilirsiniz.Dialogue: 10,0:18:23.06,0:18:24.65,Main,,0,0,0,,Başka birisini o sanmışım.Dialogue: 10,0:18:26.18,0:18:29.84,Main,,0,0,0,,La-Lanet olası Donanma...Dialogue: 0,0:18:30.86,0:18:34.49,Captions,,0,0,250,,Donanma Kârargahı Koramirallerinden Takipçi MaynardDialogue: 10,0:18:31.42,0:18:34.49,Main,,0,0,0,,Ben de buradaki planı sürdüreceğim.Dialogue: 0,0:18:36.93,0:18:41.92,Captions,,0,0,180,,Kuzeydoğuda Bir KafeDialogue: 0,0:18:43.08,0:18:47.52,Captions,,0,0,270,,Sahne 2 Caesar Teslim TakımıDialogue: 0,0:18:46.24,0:18:48.51,Main,,0,0,0,,Green Bit demek?Dialogue: 0,0:18:48.51,0:18:51.41,Main,,0,0,0,,Oraya gitmenizi önermem.Dialogue: 0,0:18:52.16,0:18:56.31,Main,,0,0,0,,Araştırmacı yahut kâşif falan mısınız?Dialogue: 0,0:18:56.31,0:19:01.20,Main,,0,0,0,,Hayatınızı riske atmanıza değecek bir nedeniniz yoksa gitmeyin daha iyi.Dialogue: 0,0:19:02.06,0:19:06.36,Main,,0,0,0,,Köprü epey sağlam görünüyor gerçi ama...Dialogue: 0,0:19:06.36,0:19:09.96,Main,,0,0,0,,Evet, demirden yapılmadır.Dialogue: 0,0:19:09.96,0:19:15.10,Main,,0,0,0,,Ama bakın, sizin de görebileceğiniz gibi bugünlerde kimse kullanmıyor.Dialogue: 0,0:19:16.13,0:19:21.04,Main,,0,0,0,,Green Bit civarlarında Savaşçı Balık sürüsü yaşıyor.Dialogue: 0,0:19:21.72,0:19:25.86,Main,,0,0,0,,Onlar gelene kadar insanlar özgürce kullanırlardı köprüyü...Dialogue: 0,0:19:25.86,0:19:28.35,Main,,0,0,0,,...tabii bu anlattığım 200 yıl öncesinin hikayesi.Dialogue: 0,0:19:29.76,0:19:32.48,Main,,0,0,0,,Bayım, Savaşçı Balık da nedir?Dialogue: 0,0:19:32.48,0:19:35.72,Main,,0,0,0,,Boynuzları olan vahşi balıklar.Dialogue: 0,0:19:35.72,0:19:39.52,Main,,0,0,0,,Gemiyle falan yaklaşmaya çalışırsanız batırırlar.Dialogue: 0,0:19:40.22,0:19:44.43,Main,,0,0,0,,O yüzden de köprüyü demirlerle desteklemişlerdi ama işe yaramıyor.Dialogue: 0,0:19:44.43,0:19:46.80,Main,,0,0,0,,İşe yaramıyor da ne demek?!Dialogue: 0,0:19:46.80,0:19:49.97,Main,,0,0,0,,Demirleri de mi aşabiliyorlar yani?Dialogue: 0,0:19:49.97,0:19:53.60,Main,,0,0,0,,Maalesef köprünün şimdiki halini bilmiyorum.Dialogue: 0,0:19:53.60,0:19:58.50,Main,,0,0,0,,Sadece geçenler bilir ama tabii geçmeye kalkıp da geri dönen olmadı şimdiye kadar.Dialogue: 0,0:19:58.50,0:19:59.34,Main,,0,0,0,,Ne?!Dialogue: 0,0:19:59.34,0:20:01.40,Main,,0,0,0,,Bak az, Trao!Dialogue: 0,0:20:01.40,0:20:03.96,Main,,0,0,0,,Derhal teslim bölgesini değiştirmen lazım!Dialogue: 0,0:20:03.96,0:20:05.26,Main,,0,0,0,,Doğru söylüyor!Dialogue: 0,0:20:05.26,0:20:07.20,Main,,0,0,0,,Öyle bir yerde teslim edilmenin nasıl bir şey olduğunu bir düşün, aptal!Dialogue: 0,0:20:07.20,0:20:08.72,Main,,0,0,0,,Aptal!Dialogue: 0,0:20:08.72,0:20:09.70,Main,,0,0,0,,Değiştirmeyeceğiz.Dialogue: 0,0:20:09.70,0:20:12.28,Main,,0,0,0,,Buraya kadar geldik, söylenmeyi bırakın.Dialogue: 0,0:20:12.28,0:20:13.74,Main,,0,0,0,,Ben asıl,...Dialogue: 0,0:20:13.74,0:20:17.33,Main,,0,0,0,,...bu ülkenin durumu konusunda endişeleniyorum.Dialogue: 0,0:20:18.10,0:20:20.66,Main,,0,0,0,,Kralları aniden tahttan çekilmesine rağmen...Dialogue: 0,0:20:20.66,0:20:24.54,Main,,0,0,0,,...neden bu kadar sakinler?Dialogue: 0,0:20:24.54,0:20:27.22,Main,,0,0,0,,Halihazırda zaten beklenmedik bir durumla karşı karşıyayız.Dialogue: 0,0:20:27.22,0:20:28.77,Main,,0,0,0,,Niye bu kadar rahatsın o zaman?!Dialogue: 0,0:20:30.42,0:20:31.92,Main,,0,0,0,,Sen ne yapıyorsun, Robi-Dialogue: 0,0:20:37.05,0:20:39.02,Main,,0,0,0,,Ne oluyor yahu?Dialogue: 0,0:20:39.02,0:20:40.92,Main,,0,0,0,,CP-0.Dialogue: 0,0:20:40.92,0:20:43.45,Main,,0,0,0,,Ne?! CP mi?Dialogue: 0,0:20:43.78,0:20:47.04,Main,,0,0,0,,Dünyanın en güçlü istihbarat örgütü.Dialogue: 0,0:20:47.04,0:20:51.23,Main,,0,0,0,,Cipher Pol Aigis 0!Dialogue: 0,0:20:51.23,0:20:55.37,Main,,0,0,0,,CP-9'la bir bağlantıları mı var yoksa?Dialogue: 0,0:20:55.37,0:20:57.94,Main,,0,0,0,,O örgütün en güçlüleri.Dialogue: 0,0:21:00.48,0:21:04.44,Main,,0,0,0,,Onlar harekete geçmişse pek iyi şeyler olmayacak demektir.Dialogue: 0,0:21:05.66,0:21:07.10,Main,,0,0,0,,Aynen öyle.Dialogue: 0,0:21:10.23,0:21:13.47,Captions,,0,0,250,,Sahne 3 Peri ve ZoroDialogue: 0,0:21:18.08,0:21:19.52,Main,,0,0,0,,Yakaladım!Dialogue: 0,0:21:21.52,0:21:23.34,Main,,0,0,0,,Katanamı geri alıyorum!Dialogue: 0,0:21:33.84,0:21:34.91,Main,,0,0,0,,Olamaz!Dialogue: 0,0:21:37.14,0:21:40.22,Main,,0,0,0,,Eyvah!Dialogue: 0,0:21:40.22,0:21:43.51,Main,,0,0,0,,Salağın tekiyim ben! İnsan beni görecek!Dialogue: 0,0:21:44.23,0:21:46.70,Main,,0,0,0,,Kaçmam lazım yoksa insan beni görecek...Dialogue: 0,0:21:51.84,0:21:57.04,Captions,,0,0,240,,Sahne 4 Başıboş Koşturan Kin'emonDialogue: 0,0:21:57.13,0:22:00.00,Main,,0,0,0,,Siz de kimsiniz?Dialogue: 0,0:22:00.00,0:22:04.13,Main,,0,0,0,,Ben yalnızca buradan geçmekte olan bir ihtiyarım.Dialogue: 0,0:22:04.13,0:22:09.16,Main,,0,0,0,,Yalancı! Şapkanın altındaki topuz değil mi?Dialogue: 0,0:22:12.02,0:22:16.61,Main,,0,0,0,,Senin samuray Tilki Alevi Kin'emon olduğuna şüphe yok!Dialogue: 0,0:22:17.48,0:22:22.44,Main,,0,0,0,,Seni Punk Hazard'dan yayınlanan videoda gördük.Dialogue: 0,0:22:22.44,0:22:25.96,Main,,0,0,0,,Ve senin gibi bir samurayın buraya geri döneceğini düşündük.Dialogue: 0,0:22:25.96,0:22:28.13,Main,,0,0,0,,Haksız mıyım?Dialogue: 0,0:22:29.08,0:22:31.46,Main,,0,0,0,,Sakin ol bakalım biraz!Dialogue: 0,0:22:31.46,0:22:35.30,Main,,0,0,0,,Tabii aradığın şu Kanjuro'nun ölmesini istiyorsan iş başka.Dialogue: 0,0:22:39.29,0:22:43.47,Captions,,0,0,280,,Sahne 5 Sanji AşıkDialogue: 0,0:22:43.96,0:22:46.51,Main,,0,0,0,,Hedefe kilitlendim.Dialogue: 0,0:22:59.22,0:23:02.78,Main,,0,0,0,,Violet-chwan!Dialogue: 0,0:23:02.78,0:23:06.00,Thoughts,,0,0,0,,"Sevgili Nami-san, Robin-chan..."Dialogue: 0,0:23:06.58,0:23:08.97,Thoughts,,0,0,0,,"Orada havalar nasıl?"Dialogue: 0,0:23:14.26,0:23:18.01,Main,,0,0,0,,Gözlerime inanamıyorum! Ne kadar da güçlüsün!Dialogue: 0,0:23:18.01,0:23:22.70,Main,,0,0,0,,Yok yahu! 16 metre yükseklikteki bir keskin nişancıyı kim olsa fark ederdi!Dialogue: 0,0:23:22.70,0:23:23.71,Main,,0,0,0,,Lafını etmeye değmez!Dialogue: 0,0:23:23.71,0:23:25.40,Main,,0,0,0,,Ne güvenilir biri!Dialogue: 0,0:23:25.40,0:23:30.22,Thoughts,,0,0,0,,"Ben şimdilerde aşk isimli bir fırtınaya teslimim!"Dialogue: 0,0:23:30.22,0:23:32.52,Thoughts,,0,0,0,,"Ben şimdilerde...Dialogue: 0,0:23:32.52,0:23:34.16,Thoughts,,0,0,0,,...aşığım!"Dialogue: 0,0:23:35.90,0:23:37.93,Main,,0,0,0,,Yanındayım hiç korkma!Dialogue: 0,0:23:38.04,0:23:44.32,Captions,,0,0,280,,Sahne 6 Sunny Güvenlik TakımıDialogue: 0,0:23:43.28,0:23:46.87,Main,,0,0,0,,Olmaz ya, hepsini içemezsin!Dialogue: 0,0:23:46.87,0:23:51.38,Main,,0,0,0,,Dinle bak, çeşnicibaşının işi içinde zehir var mı yok mu...Dialogue: 0,0:23:51.40,0:23:56.48,Main,,0,0,0,,...diye Shogun'un yiyip içeceği şeylerden birer tadım almaktır!Dialogue: 0,0:23:56.48,0:23:57.50,Main,,0,0,0,,Anladın mı?Dialogue: 0,0:23:57.50,0:23:58.82,Main,,0,0,0,,Evet!Dialogue: 0,0:23:58.82,0:24:00.60,Main,,0,0,0,,Yap bakalım!Dialogue: 0,0:24:00.60,0:24:02.75,Main,,0,0,0,,Çay getir, Choppa'emon.Dialogue: 0,0:24:04.40,0:24:06.92,Captions,,0,0,250,,Hizmetli Choppa'emonDialogue: 0,0:24:02.75,0:24:04.30,Main,,0,0,0,,Emredersiniz!Dialogue: 0,0:24:04.30,0:24:06.92,Main,,0,0,0,,Derhal emrinize amade ediyorum efendim!Dialogue: 0,0:24:08.88,0:24:13.80,Captions,,570,0,670,,Hizmetçi O-NamiDialogue: 0,0:24:08.88,0:24:12.34,Main,,0,0,0,,Paşam, keyfiniz yerinde mi?Dialogue: 0,0:24:12.34,0:24:14.60,Main,,0,0,0,,Evet, zerre derdim tasam kalmadı.Dialogue: 0,0:24:15.26,0:24:18.40,Main,,0,0,0,,Harika hissediyorum.Dialogue: 0,0:24:18.40,0:24:22.06,Main,,0,0,0,,Anlıyorum, ne güzel öyleyse.Dialogue: 0,0:24:23.26,0:24:26.02,Main,,0,0,0,,Ben de harika hissediyorum!Dialogue: 0,0:24:31.86,0:24:35.30,Main,,0,0,0,,Acıdı ama Nami-san!Dialogue: 0,0:24:36.26,0:24:38.90,Main,,0,0,0,,Bacağınızda uyuma partisi yapmıyor muyduk?Dialogue: 0,0:24:38.90,0:24:40.46,Main,,0,0,0,,O nasıl bir partiymiş öyle?!Dialogue: 0,0:24:40.46,0:24:43.70,Main,,0,0,0,,Shogunculuk oynuyoruz.Dialogue: 0,0:24:43.70,0:24:45.76,Main,,0,0,0,,Shogunculuk mu?Dialogue: 0,0:24:45.76,0:24:52.30,Main,,0,0,0,,Momo yalnız kaldığında çok ciddi ve mutsuz görünüyor.Dialogue: 0,0:24:52.30,0:24:54.38,Main,,0,0,0,,Ne olduğunu söylemese de...Dialogue: 0,0:24:54.38,0:24:58.24,Main,,0,0,0,,...bu yaşına rağmen kalbinde derin bir yara taşıyor sanırım.Dialogue: 0,0:24:58.24,0:24:59.28,Main,,0,0,0,,Hadi ya?Dialogue: 0,0:24:59.28,0:25:03.01,Main,,0,0,0,,Anlıyorum... Demek durum bu?Dialogue: 0,0:25:03.01,0:25:04.94,Main,,0,0,0,,Bak az, Kemik-kichi!Dialogue: 0,0:25:04.94,0:25:05.32,Main,,0,0,0,,Buyrun?Dialogue: 0,0:25:05.70,0:25:08.25,Main,,0,0,0,,Ortamı şenlendirecek bir şeyler yap!Dialogue: 0,0:25:08.25,0:25:12.52,Main,,0,0,0,,Olmaz, sadece Luffy-san'dan emir alır-Dialogue: 0,0:25:12.52,0:25:13.47,Main,,0,0,0,,Yap işte!Dialogue: 0,0:25:15.52,0:25:24.03,Wake up! lyrics,,0,0,0,,♪ Bıktım artık, Bıktım artık ♪Dialogue: 0,0:25:24.03,0:25:28.31,Wake up! lyrics,,0,0,0,,♪ Kaç kez, kaç kez gömersek gömelim ♪Dialogue: 0,0:25:28.31,0:25:32.44,Wake up! lyrics,,0,0,0,,♪ Gelecek geri ♪Dialogue: 0,0:25:32.44,0:25:33.58,Wake up! lyrics,,0,0,0,,Evet!Dialogue: 0,0:25:33.58,0:25:39.55,Wake up! lyrics,,0,0,0,,♪ Güçlü Ceset ♪Dialogue: 0,0:25:39.55,0:25:40.50,Wake up! lyrics,,0,0,0,,♪ Haydi bakalım! ♪Dialogue: 0,0:25:46.02,0:25:48.24,Main,,0,0,0,,Herkese teşekkürler!Dialogue: 0,0:25:54.70,0:25:56.70,Main,,0,0,0,,Hiç sevmedim...Dialogue: 0,0:25:56.70,0:25:57.82,Main,,0,0,0,,Ne oluyor?Dialogue: 0,0:25:57.82,0:26:01.94,Main,,0,0,0,,Gemide sadece biz varız sanıyordum.Dialogue: 0,0:26:01.94,0:26:05.76,Main,,0,0,0,,Alın benden de o kadar! Bu ses de neydi?Dialogue: 0,0:26:05.76,0:26:06.71,Main,,0,0,0,,Tüylerim diken diken oldu!Dialogue: 0,0:26:06.71,0:26:08.18,Main,,0,0,0,,Korkuyorum!Dialogue: 0,0:26:08.18,0:26:09.45,Main,,0,0,0,,O-Nami!Dialogue: 0,0:26:09.45,0:26:13.12,Main,,0,0,0,,Hiç ama hiç sevmedim!Dialogue: 0,0:26:13.12,0:26:17.32,Main,,0,0,0,,Erkek yatakhanesinden geliyor.Dialogue: 0,0:26:17.32,0:26:19.36,Main,,0,0,0,,Hiç sevmedim hiç!Dialogue: 0,0:26:21.46,0:26:23.96,Main,,0,0,0,,Bariz biri var orada!Dialogue: 0,0:26:23.96,0:26:25.30,Main,,0,0,0,,Kimin sesi bu?Dialogue: 0,0:26:25.32,0:26:28.43,Captions,,0,0,220,,Corrida KolezyumuDialogue: 0,0:26:28.86,0:26:34.20,Main,,0,0,0,,B Bloğu savaşçıları! Capman buralarda mı?Dialogue: 0,0:26:34.20,0:26:36.19,Main,,0,0,0,,Bartolomeo?Dialogue: 0,0:26:41.62,0:26:44.82,Main,,0,0,0,,Sen Bartolomeo'sun değil mi?Dialogue: 0,0:26:45.42,0:26:47.58,Main,,0,0,0,,B Bloğu savaşı başlamak üzere!Dialogue: 0,0:26:47.98,0:26:53.24,Main,,0,0,0,,Bir de Capman isimli savaşçıyı gördün mü?Dialogue: 0,0:26:55.64,0:26:58.48,Main,,0,0,0,,Sanmıyorum.