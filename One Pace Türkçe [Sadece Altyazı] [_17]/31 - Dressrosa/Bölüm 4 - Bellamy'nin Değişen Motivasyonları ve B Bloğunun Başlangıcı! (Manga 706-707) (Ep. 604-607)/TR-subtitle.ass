Dialogue: 0,0:02:30.04,0:02:38.62,Title,,0,0,0,,{\fad(2000,2000)}Bellamy'nin Değişen Motivasyonları ve B Bloğunun Başlangıcı!
Dialogue: 0,0:02:39.74,0:02:43.34,Main,,0,0,0,,Şimdi sahneye çıkan savaşçımızsa...
Dialogue: 0,0:02:43.34,0:02:46.88,Main,,0,0,0,,...biraz geç kalmış olsa da\No da B Bloğu'ndan!
Dialogue: 0,0:02:47.94,0:02:53.75,Main,,0,0,0,,Sadece bir yılda ünlenip\NYeni Dünya'ya giriş yaptı!
Dialogue: 0,0:02:54.32,0:02:58.16,Main,,0,0,0,,Zalimlikte eşi olmayan çılgın çaylak!
Dialogue: 0,0:02:58.72,0:03:02.53,Main,,0,0,0,,Korsanları şişe geçirip kızartmış\Nve bunun videosunu paylaşmış kişi!
Dialogue: 0,0:03:03.09,0:03:06.06,Main,,0,0,0,,Masum sivilleri bombalamış adam!
Dialogue: 0,0:03:07.12,0:03:12.80,Main,,0,0,0,,{\an8}"Yok olup gitmesi gereken en sinir bozucu\Nkorsan" listesinde ilk sırada!
Dialogue: 0,0:03:07.94,0:03:13.61,Captions,,0,0,280,,{\fad(600,0)}Barto Kulübü Korsanları Kaptanı\NYamyam Bartolomeo\NÖdül: 150 Milyon Beli
Dialogue: 0,0:03:12.80,0:03:13.61,Main,,0,0,0,,{\an8}Korsan...
Dialogue: 0,0:03:14.94,0:03:19.00,Main,,0,0,0,,...Bartolomeo!
Dialogue: 0,0:03:19.90,0:03:22.00,Main,,0,0,0,,Hepiniz...
Dialogue: 0,0:03:22.00,0:03:26.75,Main,,0,0,0,,...geberin!
Dialogue: 0,0:03:32.26,0:03:33.73,Main,,0,0,0,,Defol buradan!
Dialogue: 0,0:03:33.73,0:03:37.01,Main,,0,0,0,,Asıl sen geber git!
Dialogue: 0,0:03:41.46,0:03:43.66,Main,,0,0,0,,Ne yapıyorsun?!
Dialogue: 0,0:03:46.95,0:03:48.11,Main,,0,0,0,,Yoksa...
Dialogue: 0,0:03:48.11,0:03:49.81,Main,,0,0,0,,Bomba bu!
Dialogue: 0,0:03:50.94,0:03:53.01,Main,,0,0,0,,İnsan kaynıyor burası, kaçamıyorum!
Dialogue: 0,0:03:53.85,0:03:56.27,Main,,0,0,0,,Çekilsene be moruk,\Nyürümeyi mi bilmiyorsun?!
Dialogue: 0,0:03:56.27,0:03:57.62,Main,,0,0,0,,Asıl sen yolu tıkadın!
Dialogue: 0,0:03:57.62,0:04:00.75,Main,,0,0,0,,Kadınlar önden!\NBırakın geçeyim!
Dialogue: 0,0:04:00.75,0:04:03.76,Main,,0,0,0,,Boşverin ötekileri beni kurtarın,\Nzengin ederim sizi!
Dialogue: 0,0:04:13.22,0:04:14.53,Main,,0,0,0,,Topmuş...
Dialogue: 0,0:04:17.88,0:04:19.44,Main,,0,0,0,,Reziller!
Dialogue: 0,0:04:27.00,0:04:30.15,Main,,0,0,0,,Senden epey nefret ediyor gibiler, genç.
Dialogue: 0,0:04:30.15,0:04:33.50,Main,,0,0,0,,Onlar gibi bok beyinlilerin\Nsevgisine ihtiyacım yok.
Dialogue: 0,0:04:34.22,0:04:37.20,Main,,0,0,0,,Fakat B bloğu yarışmacıları\Nbu kadarla sınırlı değil!
Dialogue: 0,0:04:37.20,0:04:38.88,Main,,0,0,0,,Son bir katılımcı daha var!
Dialogue: 0,0:04:38.88,0:04:41.96,Main,,0,0,0,,Deli-lomeo gibi değil kendisi!
Dialogue: 0,0:04:42.50,0:04:46.57,Main,,0,0,0,,{\fad(0,210)}Ülkemizin kralı\NDoflamingo'ya saygı duyan...
Dialogue: 0,0:04:46.73,0:04:54.81,Main,,0,0,0,,...ve ona uzak bir ülkeden devasa bir altın sütun getirip sadakât yeminleri etmiş biri!
Dialogue: 0,0:04:54.95,0:04:56.71,Main,,0,0,0,,Yoksa düşündüğüm kişi mi?!
Dialogue: 0,0:04:56.71,0:05:02.25,Main,,0,0,0,,O zamandan beri de bizlere barbar\Nkorsan krallığı diyen pek çok ülkenin...
Dialogue: 0,0:05:02.25,0:05:05.72,Main,,0,0,0,,...pek çok kasabasını yok etmiş\Nve onları bizimle anlaşmaya itmiş...
Dialogue: 0,0:05:05.72,0:05:08.45,Main,,0,0,0,,...Dressrosa'nın Mermisi!
Dialogue: 0,0:05:08.45,0:05:13.76,Main,,0,0,0,,Bu kişiye kraliyet ailesi\Ntarafından büyük bir şans verildi!
Dialogue: 0,0:05:15.40,0:05:18.41,Captions,,0,0,210,,{\fad(200,200)}Kolezyumun Arkası
Dialogue: 10,0:05:15.80,0:05:17.53,Main,,0,0,0,,{\an8}Revir şu tarafta!
Dialogue: 10,0:05:17.53,0:05:20.20,Main,,0,0,0,,{\an8}Yeterli sedyemiz yok!\NYürüyebiliyorsanız beklemeyin!
Dialogue: 10,0:05:20.20,0:05:23.47,Main,,0,0,0,,Şu şampiyon tarafından\Nepey fena tartaklanmışlar.
Dialogue: 10,0:05:27.97,0:05:29.54,Main,,0,0,0,,Bak az!
Dialogue: 10,0:05:30.62,0:05:33.65,Main,,0,0,0,,Kör değilim ben!
Dialogue: 10,0:05:34.07,0:05:36.30,Main,,0,0,0,,Kendini ne kadar saklarsan sakla...
Dialogue: 10,0:05:36.30,0:05:40.09,Main,,0,0,0,,...kariyerime büyük gölge düşürmüş\Nbir adinin yüzünü...
Dialogue: 10,0:05:42.56,0:05:44.99,Main,,0,0,0,,...asla unutmam!
Dialogue: 0,0:05:46.32,0:05:48.36,Main,,0,0,0,,Sen!
Dialogue: 0,0:05:49.90,0:05:50.80,Main,,0,0,0,,Yanılmıyorsam...
Dialogue: 0,0:05:52.04,0:05:55.20,Main,,0,0,0,,...elmas kafalı ihtiyarın başına\Nepey dert açmıştın.
Dialogue: 0,0:05:56.05,0:05:56.51,Main,,0,0,0,,Maro'ydu.
Dialogue: 0,0:05:56.51,0:05:57.76,Main,,0,0,0,,Bellamy!
Dialogue: 0,0:05:57.76,0:05:59.20,Main,,0,0,0,,Evet, Bellamy'di.
Dialogue: 0,0:05:59.69,0:06:01.81,Main,,0,0,0,,Neden buradasın?
Dialogue: 0,0:06:01.92,0:06:06.26,Captions,,0,0,180,,{\fad(500,500)}Bellamy Korsanları'nın Eski Kaptanı
Dialogue: 0,0:06:01.81,0:06:03.96,Main,,0,0,0,,{\pos(641.6,716.4)}Önemli bir nedeni yok.
Dialogue: 0,0:06:03.96,0:06:07.12,Main,,0,0,0,,{\pos(635.2,713.2)}Jaya'nın insanlarından değilim sonuçta.
Dialogue: 0,0:06:06.45,0:06:11.28,Captions,,0,0,240,,{\fad(500,0)}Sırtlan Bellamy: Ödülü 195 milyon beli
Dialogue: 0,0:06:07.12,0:06:10.30,Main,,0,0,0,,{\pos(640,716.4)}İstediğimi yapmakta özgürüm.
Dialogue: 0,0:06:10.30,0:06:11.28,Main,,0,0,0,,{\pos(640,714.8)}Ayrıca...
Dialogue: 0,0:06:12.20,0:06:17.66,Main,,0,0,0,,...Doflamingo küçüklüğümden beri\Nörnek aldığım bir korsan oldu.
Dialogue: 0,0:06:17.66,0:06:21.00,Main,,0,0,0,,Mera Mera Meyvesi\Nilgimi çekmese de...
Dialogue: 0,0:06:21.00,0:06:24.62,Main,,0,0,0,,...bunu yapmamı gerektirecek\Nbaşka nedenler var!
Dialogue: 0,0:06:24.62,0:06:26.87,Main,,0,0,0,,Öyleyse seninle yine savaşmam gerekecek!
Dialogue: 0,0:06:26.87,0:06:29.57,Main,,0,0,0,,Ben eski ben değilim artık.
Dialogue: 0,0:06:31.14,0:06:33.10,Main,,0,0,0,,Hasır Şapka.
Dialogue: 0,0:06:33.10,0:06:36.51,Main,,0,0,0,,Gökyüzü Adası'na gittim.
Dialogue: 0,0:06:36.51,0:06:42.00,Main,,0,0,0,,Dostlarımı kaybettim bunun sonucunda\Nama dünyaya bakışım da değişti.
Dialogue: 0,0:06:42.00,0:06:43.10,Main,,0,0,0,,Skypiea'ya gittin demek?
Dialogue: 0,0:06:43.10,0:06:46.52,Main,,0,0,0,,O insanlara\Nbir şey yapmadın değil mi?!
Dialogue: 0,0:06:50.27,0:06:51.56,Main,,0,0,0,,Kim bilir?
Dialogue: 0,0:06:53.19,0:06:57.69,Main,,0,0,0,,Anlayacağın artık sana karşı kin beslemiyorum.
Dialogue: 0,0:06:58.80,0:07:02.40,Main,,0,0,0,,Er ya da geç gelecek\No büyük dalgada boğulmamak için...
Dialogue: 0,0:07:02.40,0:07:05.44,Main,,0,0,0,,...Doflamingo'nun gemisine bineceğim.
Dialogue: 0,0:07:07.35,0:07:11.34,Main,,0,0,0,,Sana gülmeyeceğim artık.
Dialogue: 0,0:07:14.00,0:07:18.35,Main,,0,0,0,,Bu mücadeleyi kazanırsa...
Dialogue: 0,0:07:18.35,0:07:24.58,Main,,0,0,0,,...azminin göstergesi olacak meyve sayesinde Don Quixote Ailesi'nde...
Dialogue: 0,0:07:24.58,0:07:27.49,Main,,0,0,0,,...idari bir konuma geçirilmesine karar verildi!
Dialogue: 0,0:07:27.49,0:07:32.03,Main,,0,0,0,,Yarışmayı kazanma konusunda\Niddialı isimlerden biri!
Dialogue: 0,0:07:32.03,0:07:34.70,Main,,0,0,0,,Korsan...
Dialogue: 0,0:07:34.70,0:07:39.15,Main,,0,0,0,,...Sırtlan Bellamy!
Dialogue: 0,0:07:41.18,0:07:44.68,Main,,0,0,0,,{\i1}Bellamy!{\i0}
Dialogue: 0,0:07:48.25,0:07:53.18,Main,,0,0,0,,Amma da popüler çıktı!
Dialogue: 0,0:07:53.18,0:07:58.11,Main,,0,0,0,,Ve böylece 138 yarışmacının tamamı\Narenaya çıkmış oldu!
Dialogue: 0,0:07:58.75,0:08:01.46,Main,,0,0,0,,Yarışmacı ringde ölür\Nveya ring dışına atılırsa...
Dialogue: 0,0:08:01.46,0:08:04.50,Main,,0,0,0,,...elenmiş sayılacak!
Dialogue: 0,0:08:06.56,0:08:10.43,Main,,0,0,0,,Tek bir kazanan olacak!
Dialogue: 0,0:08:14.65,0:08:17.08,Main,,0,0,0,,Savaş...
Dialogue: 0,0:08:17.08,0:08:18.51,Main,,0,0,0,,{\an3}Savaşçı Kral \N2. Elizabello!
Dialogue: 0,0:08:18.51,0:08:19.91,Main,,0,0,0,,Dövüş sanatçısı \NBlue Gilly!
Dialogue: 0,0:08:19.91,0:08:21.35,Main,,0,0,0,,Askeri Kumandan\NTank Lepant!
Dialogue: 0,0:08:21.35,0:08:22.75,Main,,0,0,0,,Suçlu Abdullah!
Dialogue: 0,0:08:22.75,0:08:24.18,Main,,0,0,0,,Korsan\NBartolomeo
Dialogue: 0,0:08:24.18,0:08:25.58,Main,,0,0,0,,Gladyatör\NRicky
Dialogue: 0,0:08:25.58,0:08:27.02,Main,,0,0,0,,Korsan\NBellamy
Dialogue: 0,0:08:27.02,0:08:28.42,Main,,0,0,0,,Taktikçi\NDagama
Dialogue: 0,0:08:28.42,0:08:29.85,Main,,0,0,0,,Balık Adam Savaşçı\NHack
Dialogue: 0,0:08:29.85,0:08:31.66,Main,,0,0,0,,Suçlu\NJeet
Dialogue: 0,0:08:31.66,0:08:34.13,Main,,0,0,0,,...başlasın!
Dialogue: 0,0:08:38.16,0:08:40.72,Main,,0,0,0,,Kiminle başlasam acaba?
Dialogue: 0,0:09:02.95,0:09:05.62,Main,,0,0,0,,Bu ne böyle, sanki ordu var gibi!
Dialogue: 0,0:09:05.62,0:09:08.99,Main,,0,0,0,,Alçaklık bu!\NResmen takım olmuşlar!
Dialogue: 0,0:09:08.99,0:09:12.90,Main,,0,0,0,,Böyle serbest dövüş mü olur be!?
Dialogue: 0,0:09:14.78,0:09:19.86,Main,,0,0,0,,Geberip gittikten sonra\Nistediğiniz kadar korkak dersiniz bize!
Dialogue: 0,0:09:19.86,0:09:25.24,Main,,0,0,0,,Tek bir kazanan olacak sonuçta!\NBize de lazım olan bu!
Dialogue: 0,0:09:27.01,0:09:32.15,Main,,0,0,0,,Anlaşılan birlikte savaşan\Nyarışmacılara sahibiz!
Dialogue: 0,0:09:32.15,0:09:34.23,Main,,0,0,0,,Buna izin var mı ki?
Dialogue: 0,0:09:34.23,0:09:38.42,Main,,0,0,0,,Pek güzel bir şey olmasa da\Nkurallara da aykırı değil sanırım.
Dialogue: 0,0:09:39.75,0:09:41.93,Main,,0,0,0,,Böyle bir şeyi düşünse düşünse...
Dialogue: 0,0:09:42.66,0:09:46.70,Main,,0,0,0,,...Prodence Krallığı'nın taktikçisi\NDagama düşünür.
Dialogue: 0,0:09:50.88,0:09:55.92,Main,,0,0,0,,{\i1}Mera Mera Meyvesi mutlaka bize,\NProdence Krallığı'nın eline geçmeli!{\i0}
Dialogue: 0,0:09:56.63,0:10:02.18,Main,,0,0,0,,{\i1}Kralımız, Elizabello II,\Nyıkım silahı olmak için doğmuştur.{\i0}
Dialogue: 0,0:10:02.66,0:10:07.93,Main,,0,0,0,,{\i1}Doğuştan gelen fiziksel gücü sayesinde\Nattığı yumruğun eşi benzeri yoktur!{\i0}
Dialogue: 0,0:10:13.94,0:10:20.04,Main,,0,0,0,,{\an8\i1}Bir defasında düşman kalesinde tek bir yumrukla\Ndelik açıp tüm dünyayı şaşırtmıştır!{\i0}
Dialogue: 0,0:10:13.98,0:10:20.95,B Block text,,0,0,280,,{\fad(1000,2000)}Prodence'in Kralı\N"Savaşçı Kral"\N2. Elizabello
Dialogue: 0,0:10:21.82,0:10:25.77,Main,,0,0,0,,{\i1}Fakat bu gücün\Ntek bir dezavantajı mevcut.{\i0}
Dialogue: 0,0:10:25.77,0:10:31.68,Main,,0,0,0,,{\i1}Tek bir yumruk atabilmesi için bir saatlik bir konsantrasyon ve ısınma gerekli.{\i0}
Dialogue: 0,0:10:32.44,0:10:36.33,Main,,0,0,0,,{\i1}Her savaşta yalnızca\Nbir kez kullanabilir bu yumruğu!{\i0}
Dialogue: 0,0:10:36.33,0:10:42.10,Main,,0,0,0,,{\i1}İsabet ettiği takdirde Yonkou'yu bile alaşağı edebileceği söylenen "Kral Yumruğu"!{\i0}
Dialogue: 0,0:10:42.10,0:10:45.89,Main,,0,0,0,,{\i1}Zafer kazanması\Ndoğru zamanlamada bitiyor!{\i0}
Dialogue: 0,0:10:46.29,0:10:48.64,Main,,0,0,0,,Kral'ım, hazırlık nasıl gidiyor?
Dialogue: 0,0:10:50.22,0:10:53.59,Main,,0,0,0,,Biraz daha sürecek,\Nkoruyun beni.
Dialogue: 0,0:10:54.30,0:10:56.20,Main,,0,0,0,,Nasıl emrederseniz!
Dialogue: 0,0:10:56.40,0:10:59.51,Main,,0,0,0,,Maaşınızın hakkını verin!
Dialogue: 0,0:10:59.51,0:11:03.59,Main,,0,0,0,,Kralı koruyup alandaki yarışmacı sayısını azaltmaya çalışın!
Dialogue: 0,0:11:03.59,0:11:05.38,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:11:05.62,0:11:07.44,Main,,0,0,0,,Söyle bakalım Lepanto...
Dialogue: 0,0:11:08.38,0:11:12.65,Main,,0,0,0,,...Dressrosa ordusu kumandanının başka bir ülkenin taktikçisine yardım etmesi doğru mu?!
Dialogue: 0,0:11:12.89,0:11:17.36,B Block text,,0,0,0,,{\pos(976,122)\fad(230,0)}Dressrosa'nın Savunma \NOrdusu Komutanı
Dialogue: 0,0:11:14.40,0:11:17.36,B Block text,,0,0,0,,{\fad(230,0)\pos(878,492)}Tank Lepanto
Dialogue: 0,0:11:13.78,0:11:17.36,Main,,0,0,0,,Bellamy, bu dünyada para konuşur!
Dialogue: 0,0:11:18.30,0:11:21.83,Main,,0,0,0,,Büyük bir hayalin peşinde koşacağıma\Nparama bakarım daha iyi!
Dialogue: 0,0:11:23.11,0:11:24.86,Main,,0,0,0,,Kulaklarımı acıttın resmen.
Dialogue: 0,0:11:30.09,0:11:31.72,Main,,0,0,0,,Lanet olsun, düşüyorum!
Dialogue: 0,0:11:32.54,0:11:35.54,Main,,0,0,0,,Üç yarışmacı alan dışına çıktıkları için elendiler!
Dialogue: 0,0:11:38.50,0:11:42.55,Main,,0,0,0,,Elbette ringi çevreleyen\Nsuların içinde de...
Dialogue: 0,0:11:42.83,0:11:45.45,Main,,0,0,0,,...Kolzeyum'un benzersiz eğlencesi bekliyor onları!
Dialogue: 0,0:11:48.72,0:11:50.52,Main,,0,0,0,,Gösterin günlerini!
Dialogue: 0,0:11:50.52,0:11:53.14,Main,,0,0,0,,Savaşçı Balık sürüsü!
Dialogue: 0,0:11:59.78,0:12:03.05,Main,,0,0,0,,Ringin içi de dışı da cehennem!
Dialogue: 0,0:12:03.05,0:12:06.05,Main,,0,0,0,,Yara almadan bu yerden kurtulmak imkansız!
Dialogue: 0,0:12:06.05,0:12:10.79,Main,,0,0,0,,Corrida Kolezyumu huzurlarınızda!
Dialogue: 0,0:12:10.79,0:12:13.72,Main,,0,0,0,,O şeyle vuramazsın bana!
Dialogue: 0,0:12:17.12,0:12:19.07,Main,,0,0,0,,{\fad(150,150)}Sıçrama...
Dialogue: 0,0:12:22.72,0:12:25.20,Main,,0,0,0,,{\fad(150,150)}...Ölüm Vuruşu!
Dialogue: 10,0:12:41.92,0:12:43.61,Main,,0,0,0,,Abdullah!
Dialogue: 10,0:12:44.31,0:12:46.24,Main,,0,0,0,,Hazırla kendini!
Dialogue: 10,0:12:55.09,0:12:58.06,Main,,0,0,0,,Sırtınızı mı dönüyorsunuz bana?
Dialogue: 10,0:13:02.49,0:13:04.50,Main,,0,0,0,,Ödlekler!
Dialogue: 0,0:13:04.81,0:13:09.17,B Block text,,0,0,220,,{\fad(175,0)}Abdullah & Jeet
Dialogue: 10,0:13:06.02,0:13:07.42,Main,,0,0,0,,Ödlekler mi?
Dialogue: 10,0:13:07.42,0:13:09.17,Main,,0,0,0,,Sevdim bak bunu!
Dialogue: 10,0:13:10.70,0:13:13.50,Main,,0,0,0,,Gerzek Balık-Adam!
Dialogue: 10,0:13:15.37,0:13:19.54,Main,,0,0,0,,Ne diye insan yarışmalarına\Nkatılıyorsun hilkat garibesi!?
Dialogue: 10,0:13:21.58,0:13:23.08,Main,,0,0,0,,Dilini mi yuttun?!
Dialogue: 10,0:13:23.08,0:13:24.82,Main,,0,0,0,,Acınası...
Dialogue: 10,0:13:24.82,0:13:26.02,Main,,0,0,0,,Ne?!
Dialogue: 10,0:13:26.02,0:13:28.75,Main,,0,0,0,,Kendi konuşmaktan aciz kukla gibisin.
Dialogue: 10,0:13:29.70,0:13:32.36,Main,,0,0,0,,İyisi mi yumruklarımızla anlaşalım!
Dialogue: 10,0:13:33.52,0:13:36.48,Main,,0,0,0,,Öyle yapalım o zaman!
Dialogue: 10,0:13:39.13,0:13:41.70,Main,,0,0,0,,Hareket ettiremiyorum!
Dialogue: 10,0:13:45.03,0:13:48.61,Main,,0,0,0,,{\fad(150,150)}4000 Tuğla Yumruğu!
Dialogue: 10,0:13:50.44,0:13:59.35,Main,,0,0,0,,Aynı dostum ve ırkımızın umudu Jinbei'nin yaptığı gibi yumruklarımızla gayet dostane ilişkiler kurabiliriz!
Dialogue: 0,0:13:54.33,0:13:59.35,B Block text,,0,0,320,,{\fad(160,0)\fs33}Balık Adam Karatesi Ustası\NBalık Adam Jujutsusu\N{\fs}Yüzüncü Seviye Hack
Dialogue: 10,0:13:59.35,0:14:02.42,Main,,0,0,0,,O nedenle de\Nsavaşmaya devam edeceğim!
Dialogue: 10,0:14:09.16,0:14:12.63,Main,,0,0,0,,Lanet olası!
Dialogue: 10,0:14:12.63,0:14:17.57,Main,,0,0,0,,Ne yapıyorsunuz siz be?\NKarşınızda silahsız, çırpı gibi biri var!
Dialogue: 10,0:14:17.57,0:14:22.67,Main,,0,0,0,,Silahsız olması, çırpı gibi olması\Nbir şeyi değiştirmiyor!
Dialogue: 0,0:14:23.11,0:14:26.84,B Block text,,0,0,320,,{\fad(260,0)\fs33}Uzun Bacak Kabilesinden\NJao Kun Do Dövüş Sanatı Ustası\N{\fs}Blue Gilly
Dialogue: 10,0:14:24.00,0:14:26.84,Main,,0,0,0,,Bacakları demirden kamçı gibi!
Dialogue: 10,0:14:28.67,0:14:30.22,Main,,0,0,0,,Siz yok musunuz!
Dialogue: 10,0:14:30.22,0:14:34.55,Main,,0,0,0,,Yaklaşın biraz daha yahu,\Nuzak duruyorsunuz sıkılıyorum sonra!
Dialogue: 10,0:14:34.55,0:14:36.86,Main,,0,0,0,,Uzunbacak Kabilesi'nden\Nbiri var işte karşınızda!
Dialogue: 10,0:14:36.86,0:14:39.22,Main,,0,0,0,,Bacaklarına saldırın!
Dialogue: 10,0:14:41.99,0:14:44.03,Main,,0,0,0,,İmkansız!\NYanına yaklaşamıyoruz!
Dialogue: 10,0:14:48.30,0:14:49.73,Main,,0,0,0,,O hareket...
Dialogue: 10,0:14:49.73,0:14:53.24,Main,,0,0,0,,Tekmenin nereden geleceğini anlayamıyorum!
Dialogue: 10,0:15:07.82,0:15:08.63,Main,,0,0,0,,Hey!
Dialogue: 10,0:15:09.58,0:15:11.72,Main,,0,0,0,,Daha önce hiç görmediğim bir gladyatör var.
Dialogue: 10,0:15:11.72,0:15:12.82,Main,,0,0,0,,Bak işte, şu!
Dialogue: 10,0:15:13.72,0:15:16.79,Main,,0,0,0,,Çok güçlü biri.\NKim olduğunu biliyor musun?
Dialogue: 10,0:15:16.79,0:15:20.40,Main,,0,0,0,,Uzun zamandır burada gladyatörüm...
Dialogue: 10,0:15:20.40,0:15:23.17,Main,,0,0,0,,...ama öyle birini\Nilk defa görüyorum!
Dialogue: 10,0:15:23.47,0:15:28.01,Main,,0,0,0,,Kolezyumun gladyatörleri\Nbir kılıç bir de kalkan taşırlar.
Dialogue: 10,0:15:28.01,0:15:32.88,Main,,0,0,0,,Ama oysa Wano Krallığı'nın\Nsamurayları gibi tek kılıç kullanıyor!
Dialogue: 10,0:15:32.88,0:15:34.18,Main,,0,0,0,,Gücünü test edelim!
Dialogue: 10,0:15:34.18,0:15:35.08,Main,,0,0,0,,Peki!
Dialogue: 10,0:15:39.86,0:15:40.83,Main,,0,0,0,,Çok yavaşsınız!
Dialogue: 0,0:15:43.26,0:15:44.59,B Block text,,0,0,0,,{\pos(810,394)\fad(150,0)}Eski Gladyatör\NRicky
Dialogue: 10,0:15:44.95,0:15:48.50,Main,,0,0,0,,Pelerininde kuru kafa işareti olan\Ngladyatörün ne yaptığını gördün mü?
Dialogue: 10,0:15:48.50,0:15:49.38,Main,,0,0,0,,Evet.
Dialogue: 10,0:15:49.38,0:15:52.70,Main,,0,0,0,,Epey güçlü birisiymiş ama daha önce\Nburada gördüğümü hatırlamıyorum.
Dialogue: 10,0:15:53.50,0:15:56.06,Main,,0,0,0,,Sanırım ben...
Dialogue: 10,0:15:56.06,0:15:58.97,Main,,0,0,0,,...böyle kalkansız dövüşen birini...
Dialogue: 10,0:15:59.43,0:16:02.96,Main,,0,0,0,,...daha önce de görmüştüm.
Dialogue: 10,0:16:02.96,0:16:05.88,Main,,0,0,0,,Neydi adı?
Dialogue: 0,0:16:09.52,0:16:11.16,Main,,0,0,0,,Şuna bakın!
Dialogue: 0,0:16:11.16,0:16:11.68,Main,,0,0,0,,Ne?!
Dialogue: 0,0:16:12.12,0:16:15.02,Main,,0,0,0,,Ne yapıyorsun sen be?!\NCanına mı susadın?
Dialogue: 0,0:16:15.42,0:16:17.39,Main,,0,0,0,,Neden kimse ona saldırmıyor?
Dialogue: 0,0:16:17.39,0:16:20.55,Main,,0,0,0,,Bartolomeo, adam gibi \Ndövüşmeyeceksen defol git!
Dialogue: 0,0:16:23.22,0:16:25.63,Captions,,0,0,220,,{\fad(240,0)}Dövüş İzleme Bölümü
Dialogue: 0,0:16:23.48,0:16:25.63,Main,,0,0,0,,{\an8}Dalga geçiyor yine!
Dialogue: 0,0:16:25.63,0:16:30.43,Main,,0,0,0,,Bu herif de aynı Hasır Şapkalar gibi\Ncan sıkıcı çaylaklardan biri.
Dialogue: 0,0:16:30.73,0:16:33.72,Main,,0,0,0,,Bu yarışmada onun da\Nicabına bakmam gerekecek.
Dialogue: 0,0:16:34.48,0:16:36.87,Main,,0,0,0,,Ne yapıyorsun orada, Kabak?
Dialogue: 0,0:16:37.17,0:16:40.69,Main,,0,0,0,,Melun Neslin posterlerine bakıyordum.
Dialogue: 0,0:16:40.69,0:16:44.02,Main,,0,0,0,,Yenilemek lazım tabii bunları da.
Dialogue: 0,0:16:44.31,0:16:46.72,Main,,0,0,0,,Bıçak izlerinden yüzleri görünmez olmuş.
Dialogue: 0,0:16:47.22,0:16:51.19,Main,,0,0,0,,Boşversene işte?
Dialogue: 0,0:16:51.19,0:16:53.01,Main,,0,0,0,,Olmaz!
Dialogue: 0,0:16:53.97,0:16:55.16,Main,,0,0,0,,Hepsini öldüreceğim!
Dialogue: 0,0:16:55.89,0:16:58.85,Main,,0,0,0,,Yarışmanın büyük bir ödülü var.
Dialogue: 0,0:16:58.85,0:17:03.92,Main,,0,0,0,,Apoo yahut Kid en azından biri katılır diye umuyordum ama...
Dialogue: 0,0:17:05.08,0:17:08.23,Main,,0,0,0,,Gerçi hâlâ burada olup olmadıklarını bilmiyorum.
Dialogue: 0,0:17:08.23,0:17:13.74,Main,,0,0,0,,Onlar da aynı Burgess gibi\Nyüzlerini saklıyor olabilirler.
Dialogue: 0,0:17:13.74,0:17:17.40,Main,,0,0,0,,Eğer onlardan biri buradaysa bir sonraki tura geçmelerini beklemeli miyim yoksa...
Dialogue: 0,0:17:19.86,0:17:24.26,Main,,0,0,0,,Savaş buradan mı izleniyor?
Dialogue: 0,0:17:28.88,0:17:33.42,Main,,0,0,0,,Manzara epey iyiymiş.
Dialogue: 0,0:17:33.42,0:17:35.25,Main,,0,0,0,,Aklıma gelmişken...
Dialogue: 0,0:17:35.76,0:17:38.75,Main,,0,0,0,,...Garp-san'ın keyfi yerinde mi...
Dialogue: 0,0:17:38.75,0:17:40.62,Main,,0,0,0,,...Hasır Şapkalı Luffy-kun?
Dialogue: 0,0:17:41.74,0:17:43.96,Main,,0,0,0,,Dedemi tanıyor musun?
Dialogue: 0,0:17:43.96,0:17:45.14,Main,,0,0,0,,Ne?!
Dialogue: 0,0:17:46.38,0:17:51.19,Main,,0,0,0,,Zamanında Garp-san\Naz kalsın öldürüyordu beni.
Dialogue: 0,0:17:52.40,0:17:57.37,Main,,0,0,0,,O gün gelecek tüm nesillerine\Nkin güdeceğime yemin etmiştim.
Dialogue: 0,0:17:58.89,0:18:00.99,Main,,0,0,0,,N-Nee!?
