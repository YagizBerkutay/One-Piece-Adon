Dialogue: 0,0:02:30.03,0:02:38.88,Title,,0,0,0,,{\fad(2000,2000)}Corrida Kolezyumu!\NBüyük Turnuva
Dialogue: 0,0:02:53.50,0:02:55.09,Main,Man,0,0,0,,Bu herif de kimin nesi?
Dialogue: 0,0:03:01.43,0:03:03.22,Main,Sanji,0,0,0,,Güç Kullanıcısı demek?
Dialogue: 0,0:03:03.22,0:03:05.53,Main,Zoro,0,0,0,,Ne tür bir Güç'tü bu?
Dialogue: 0,0:03:06.11,0:03:08.28,Main,Fujitora,0,0,0,,Özürlerimi sunuyorum, efendim.
Dialogue: 0,0:03:08.28,0:03:11.46,Main,Fujitora,0,0,0,,Onarım masraflarını buraya yollayabilirsiniz.
Dialogue: 0,0:03:11.46,0:03:13.05,Main,Clerk,0,0,0,,Elbette...
Dialogue: 0,0:03:13.05,0:03:14.75,Main,Clerk,0,0,0,,Ne?!
Dialogue: 0,0:03:14.75,0:03:16.60,Main,Clerk,0,0,0,,Yoksa sen...
Dialogue: 0,0:03:16.60,0:03:18.31,Main,Fujitora,0,0,0,,İzninizi isteyeyim.
Dialogue: 0,0:03:18.75,0:03:21.91,Main,Luffy,0,0,0,,İhtiyar amma güçlüymüşsün ha!\NKimsin sen?
Dialogue: 0,0:03:23.40,0:03:30.72,Main,Fujitora,0,0,0,,İkimizin de iyiliği için \Nbunu şimdi söylemesem iyi olur.
Dialogue: 0,0:03:34.90,0:03:37.09,Main,Man,0,0,0,,Hey! Dikkat et ya, kör müsün?!
Dialogue: 0,0:03:37.09,0:03:39.36,Main,Fujitora,0,0,0,,Özür dilerim, bir şey olmadı ya?
Dialogue: 0,0:03:39.36,0:03:44.44,Main,Sanji,0,0,0,,"İkimizin de iyiliği için..." mi?\NÜnlü biri falan mı ki?
Dialogue: 0,0:03:44.44,0:03:48.34,Main,Zoro,0,0,0,,Sıradan biri olmadığı kesin.
Dialogue: 0,0:03:49.08,0:03:50.16,Main,Man,0,0,0,,Çantam gitmiş!
Dialogue: 0,0:03:50.16,0:03:51.58,Main,Man,0,0,0,,Benim de saatim yok!
Dialogue: 0,0:03:51.58,0:03:53.45,Main,Woman,0,0,0,,Cüzdanım yok!
Dialogue: 0,0:03:53.45,0:03:56.38,Main,Toy,0,0,0,,Amanın, benim de ceketim gitmiş!
Dialogue: 0,0:03:56.38,0:03:59.28,Main,Man,0,0,0,,Güpegündüz,\Netrafı toz duman almışken soyulduk!
Dialogue: 0,0:04:00.32,0:04:03.09,Main,Sanji,0,0,0,,Az evvelki ihtiyar hırsız mıymış?
Dialogue: 0,0:04:04.04,0:04:05.46,Main,Zoro,0,0,0,,Biri burada değil!
Dialogue: 0,0:04:05.46,0:04:06.92,Main,Kin'emon,0,0,0,,Ne oldu?
Dialogue: 0,0:04:06.92,0:04:08.23,Main,Zoro,0,0,0,,Katanam yok!
Dialogue: 0,0:04:09.34,0:04:11.45,Main,Zoro,0,0,0,,Az evvel burada duran Shusui yok!
Dialogue: 0,0:04:11.45,0:04:14.03,Main,Kin'emon,0,0,0,,Ne dedin?! Wano Krallığı'nın\Nulusal hazinesi olan katana mı?!
Dialogue: 0,0:04:14.40,0:04:16.00,Main,OH GOD KILL IT WITH FIRE,0,0,0,,Herkesi soymuşlar anlaşılan.
Dialogue: 0,0:04:17.50,0:04:19.42,Main,OH GOD KILL IT WITH FIRE,0,0,0,,Eşyalarınızı periler aldı.
Dialogue: 0,0:04:19.42,0:04:23.21,Main,Zoro,0,0,0,,Ne diyorsun sen be!? Bu periler dediğin şey bir tür çapulcu grubu ismi mi?
Dialogue: 0,0:04:23.21,0:04:27.31,Main,OH GOD KILL IT WITH FIRE,0,0,0,,Periler perilerdir.\NGülüp geçmek en mantıklısı.
Dialogue: 0,0:04:27.31,0:04:33.14,Main,OH GOD KILL IT WITH FIRE,0,0,0,,Ta eski zamanlardan beri göze görünmeyen Dressrosa'nın koruyucu tanrılarıdır periler.
Dialogue: 0,0:04:33.14,0:04:37.32,Main,OH GOD KILL IT WITH FIRE,0,0,0,,Yaptıkları şeyleri görmezden gelmemiz gerekir.
Dialogue: 0,0:04:37.32,0:04:38.56,Main,Woman,0,0,0,,Yapacak bir şey yok!
Dialogue: 0,0:04:39.20,0:04:40.54,Main,Zoro,0,0,0,,Şakanın sırası değil!
Dialogue: 0,0:04:40.54,0:04:43.76,Main,Kin'emon,0,0,0,,Aynen öyle!\NWano Krallığı'nın ulusal hazinesidir o!
Dialogue: 0,0:04:43.76,0:04:45.75,Main,Zoro,0,0,0,,Benim katanam o be!
Dialogue: 0,0:04:45.75,0:04:47.49,Main,Kin'emon,0,0,0,,Senin değil!
Dialogue: 0,0:04:48.00,0:04:54.15,Main,Kin'emon,0,0,0,,Bir noktada sana meydan okuyup Shusui'yi Wano Krallığı adına geri alacağım!
Dialogue: 0,0:04:54.15,0:04:56.98,Main,Zoro,0,0,0,,Bana uyar! Meydan okumanı kabul edip seni bir güzel yeneceğim!
Dialogue: 0,0:05:00.61,0:05:03.11,Main,Zoro,0,0,0,,Aç gözlülük ettin peri!
Dialogue: 0,0:05:03.11,0:05:04.60,Main,Zoro,0,0,0,,Kaçamazsın!
Dialogue: 0,0:05:05.51,0:05:07.48,Main,Luffy,0,0,0,,Hey Zoro, nereye gidiyorsun?!
Dialogue: 0,0:05:07.48,0:05:08.90,Main,Sanji,0,0,0,,Bekle!
Dialogue: 0,0:05:08.90,0:05:12.54,Main,Sanji,0,0,0,,Öyle boş boş dolaşıp kaybolman için\Nayıracak vaktimiz yok!
Dialogue: 0,0:05:12.54,0:05:14.22,Main,Luffy,0,0,0,,Kulağa eğlenceli geliyor!
Dialogue: 0,0:05:14.74,0:05:16.16,Main,Franky,0,0,0,,Bekle bakalım Luffy!
Dialogue: 0,0:05:16.16,0:05:17.98,Main,Kin'emon,0,0,0,,Hırsızı mı buldun?!
Dialogue: 0,0:05:17.98,0:05:20.65,Main,Kin'emon,0,0,0,,Wano Krallığı'nın ulusal hazinesini\Nkimsenin almasına müsaade etmem!
Dialogue: 0,0:05:20.65,0:05:23.29,Main,Luffy,0,0,0,,Bırak beni be!\NBen de gideceğim!
Dialogue: 0,0:05:23.29,0:05:25.92,Main,Franky,0,0,0,,Aklıma bir şey geldi.
Dialogue: 0,0:05:25.92,0:05:26.50,Main,Luffy,0,0,0,,Bir şey mi geldi?
Dialogue: 0,0:05:35.51,0:05:42.00,Main,Franky,0,0,0,,Böyle bunlarla beraberken ipleri elime almam kaçınılmaz.
Dialogue: 0,0:05:42.00,0:05:45.40,Main,Franky,0,0,0,,Her şeyi ağabeyinize bırakın.
Dialogue: 0,0:05:48.84,0:05:51.47,Main,Franky,0,0,0,,Doflamingo için çalışıyorsun, değil mi?
Dialogue: 0,0:05:52.63,0:05:56.12,Main,Franky,0,0,0,,Ama bu bizi korkutmayacak.
Dialogue: 0,0:05:56.12,0:06:01.00,Main,Luffy,0,0,0,,Amcam, sorduğumuz soruları\Nyavaştan cevaplamaya başla istersen!
Dialogue: 0,0:06:01.04,0:06:03.20,Main,Masked man,0,0,0,,Dedim ya size!
Dialogue: 0,0:06:03.20,0:06:06.95,Main,Masked man,0,0,0,,Samurayların peşine düştüğümü\Nhatırlıyorum ama onlardan birini...
Dialogue: 0,0:06:06.97,0:06:10.72,Main,Masked man,0,0,0,,...nasıl yakaladıklarını, nerede\Ntuttuklarını falan bilmiyorum.
Dialogue: 0,0:06:10.72,0:06:14.54,Main,Masked man,0,0,0,,Ayrıca şu GÜLÜCÜK denen şeyiyse hiç bilmiyorum.
Dialogue: 0,0:06:15.36,0:06:17.66,Main,Franky,0,0,0,,GÜLÜCÜK'ün ne olduğunu bile\Nbilmiyorsun demek?
Dialogue: 0,0:06:17.76,0:06:21.68,Main,Masked man,0,0,0,,Ne GÜLÜCÜK'ü ne de fabrikasını biliyorum.
Dialogue: 0,0:06:22.67,0:06:23.76,Main,Masked man,0,0,0,,Kimsiniz siz?!
Dialogue: 0,0:06:24.50,0:06:28.41,Main,Luffy,0,0,0,,Olaya gel, kendi adamları bile\Ndurumdan habersiz.
Dialogue: 0,0:06:28.41,0:06:31.56,Main,Franky,0,0,0,,Öyleyse bize daha rütbeli kişileri\Nnerede buluruz onu söyle.
Dialogue: 0,0:06:32.28,0:06:34.41,Main,Franky,0,0,0,,Belki de bu ayak takımından biridir.
Dialogue: 0,0:06:35.23,0:06:39.24,Main,Masked man,0,0,0,,Herkes bugün epey meşgul,\Nkim nerededir hiç bilmiyorum.
Dialogue: 0,0:06:39.24,0:06:41.75,Main,Masked man,0,0,0,,Ben de Kolezyum'a çağırıldım.
Dialogue: 0,0:06:41.98,0:06:43.00,Main,Masked man,0,0,0,,Bakın!
Dialogue: 0,0:06:43.00,0:06:47.15,Main,Masked man,0,0,0,,Bugün krallıktaki herkes Kolezyum'da toplanacak.
Dialogue: 0,0:06:47.15,0:06:52.33,Main,Masked man,0,0,0,,Corrida Kolezyumu. Yüksek rütbeli birilerini görmek istiyorsanız oraya gidin!
Dialogue: 0,0:06:52.63,0:06:55.00,Main,Masked man,0,0,0,,Bugün çok büyük bir müsabaka düzenlenecek.
Dialogue: 0,0:06:55.08,0:06:58.80,Main,Masked man,0,0,0,,Tüm aile üyeleri muhtemelen orada olacaklar.
Dialogue: 0,0:06:59.02,0:07:04.07,Main,Masked man,0,0,0,,Nedendir bilinmez, Genç Bey'imiz\Nkazanana akıl almaz bir ödül verecek!
Dialogue: 0,0:07:04.91,0:07:07.65,Main,Masked man,0,0,0,,Acayip şaşırtıcı bir şeydi!
Dialogue: 0,0:07:09.41,0:07:10.88,Main,Masked man,0,0,0,,Herkesin istediği bir şey!
Dialogue: 0,0:07:11.99,0:07:13.17,Main,Luffy,0,0,0,,Yoksa...
Dialogue: 0,0:07:14.63,0:07:17.05,Main,Luffy,0,0,0,,...şu Mingo'nun bahsettiği leziz et mi?!
Dialogue: 0,0:07:17.66,0:07:21.57,Main,Franky,0,0,0,,İsteyeceğin bir şeye\Nsahip olduğunu söylemişti.
Dialogue: 0,0:07:23.50,0:07:26.16,Captions,,0,0,180,,{\fad(420,0)}Corrida Kolezyumu
Dialogue: 0,0:07:23.20,0:07:24.10,Main,Child,0,0,0,,{\an8}Ah!
Dialogue: 0,0:07:24.10,0:07:26.16,Main,Child,0,0,0,,{\an8}Yıldırım Asker geldi!
Dialogue: 0,0:07:26.16,0:07:30.26,Main,Announcer,0,0,0,,Bayanlar, baylar ve oyuncaklar!
Dialogue: 0,0:07:31.15,0:07:32.64,Main,Child,0,0,0,,Acıdı be!
Dialogue: 0,0:07:32.64,0:07:34.33,Main,Child,0,0,0,,Biz de görmek istiyoruz!
Dialogue: 0,0:07:34.33,0:07:36.30,Main,Toy,0,0,0,,Bırak girelim!
Dialogue: 0,0:07:36.30,0:07:39.96,Main,Soldier-san,0,0,0,,Çocuklar için uygun değil burası!\Nİnsanlar birbirine kıyacak!
Dialogue: 0,0:07:39.96,0:07:41.02,Main,Soldier-san,0,0,0,,Evlerinize dönün!
Dialogue: 0,0:07:44.44,0:07:46.50,Main,Announcer,0,0,0,,Bugün sizlere...
Dialogue: 0,0:07:46.50,0:07:48.11,Main,Announcer,0,0,0,,...dehşet bir müsabaka izleteceğiz!
Dialogue: 0,0:07:48.50,0:07:52.84,Main,Announcer,0,0,0,,Kral bugün için bizlere...
Dialogue: 0,0:07:52.84,0:07:55.85,Main,Announcer,0,0,0,,...çok özel bir ödül bahşetti!
Dialogue: 0,0:07:56.20,0:08:00.19,Main,Announcer,0,0,0,,İki yıl önce Marineford'daki En İyiler Savaşı'nda...
Dialogue: 0,0:08:00.19,0:08:02.79,Main,Announcer,0,0,0,,...hayatını kaybetmiş bir adam vardı.
Dialogue: 0,0:08:02.79,0:08:09.45,Main,Announcer,0,0,0,,Efsanevi Beyazsakal Korsanları'nın 2. bölük komutanı Korsanlar Kralı'nın oğlu...
Dialogue: 0,0:08:09.45,0:08:11.30,Main,Announcer,0,0,0,,...Ace'den bahsediyorum!
Dialogue: 0,0:08:14.28,0:08:18.01,Main,Announcer,0,0,0,,Anlatılanlara göre yumruğuyla\Nsavaş gemilerini parçalayıp...
Dialogue: 0,0:08:18.22,0:08:22.19,Main,Announcer,0,0,0,,...şehirleri yakıp cehenneme çevirebilirmiş!
Dialogue: 0,0:08:23.38,0:08:30.17,Main,Announcer,0,0,0,,Ve işte bu devasa güç Şeytan Meyvesi haliyle bir kez daha karşınızda!
Dialogue: 0,0:08:30.17,0:08:31.92,Main,Toy,0,0,0,,Karşımızda mı?!
Dialogue: 0,0:08:31.92,0:08:32.84,Main,Citizen,0,0,0,,Sahiden mi?!
Dialogue: 0,0:08:33.63,0:08:35.42,Main,Announcer,0,0,0,,Bakın!
Dialogue: 0,0:08:37.27,0:08:41.43,Main,Announcer,0,0,0,,Galip bu yasaklı meyveyi kazanacak!
Dialogue: 0,0:08:42.02,0:08:46.27,Main,Announcer,0,0,0,,En güçlü tür olan Logia Tipi bir Şeytan Meyvesi!
Dialogue: 0,0:08:48.70,0:08:52.60,Main,Announcer,0,0,0,,Mera Mera Meyvesi!
Dialogue: 0,0:08:55.35,0:08:57.20,Main,Franky,0,0,0,,Gerçek mi ki?
Dialogue: 0,0:08:57.20,0:08:59.80,Main,Masked man,0,0,0,,Genç Bey'imiz yalan söyler mi sanıyorsun?!
Dialogue: 0,0:09:03.90,0:09:05.12,Main,Luffy,0,0,0,,Ace'in...
Dialogue: 0,0:09:07.94,0:09:10.05,Main,Luffy,0,0,0,,...Mera Mera Meyvesi.
Dialogue: 0,0:09:12.13,0:09:16.17,Main,Announcer,0,0,0,,Bugün kolezyumumuz, \NYeni Dünyanın her yerinden...
Dialogue: 0,0:09:16.17,0:09:20.24,Main,Announcer,0,0,0,,...Kralımız tarafından çağrılan yetenekli ve güçlü savaşçılara ev sahipliği yapacak.
Dialogue: 0,0:09:20.24,0:09:25.91,Main,Announcer,0,0,0,,Fakat bu değerli ödülü \Nöyle kolay kolay vermeyeceğiz!
Dialogue: 0,0:09:27.08,0:09:33.48,Main,Announcer,0,0,0,,Gücü yetene gidecek meyve! Savaşacak gladyatörlerimiz sıradan gladyatörlere hiç benzemiyor!
Dialogue: 0,0:09:33.48,0:09:36.85,Main,Announcer,0,0,0,,Bloklarda kazanan kişilerle\Nsavaşacak gladyatörlerimiz...
Dialogue: 0,0:09:39.12,0:09:42.68,Main,Announcer,0,0,0,,...Don Quixote Ailesi'nden şu isimler!
Dialogue: 0,0:09:44.90,0:09:49.48,Main,Announcer,0,0,0,,Senor Pink!
Dialogue: 0,0:09:52.66,0:09:54.67,Main,Announcer,0,0,0,,Dellinger!
Dialogue: 0,0:09:57.41,0:10:00.31,Main,Announcer,0,0,0,,Lao G!
Dialogue: 0,0:10:02.80,0:10:05.57,Main,Announcer,0,0,0,,Machvise!
Dialogue: 0,0:10:05.57,0:10:06.99,Main,Citizen,0,0,0,,Vise!
Dialogue: 0,0:10:07.65,0:10:11.35,Main,Announcer,0,0,0,,Ayrıca kolezyumun kahramanı...
Dialogue: 0,0:10:12.00,0:10:16.83,Main,Announcer,0,0,0,,...Bay Diamante!
Dialogue: 0,0:10:17.19,0:10:19.23,Main,Citizen,0,0,0,,Diamante-sama!
Dialogue: 0,0:10:19.23,0:10:21.52,Main,Citizen,0,0,0,,Diamante!
Dialogue: 0,0:10:21.90,0:10:24.51,Main,Citizen,0,0,0,,Başlasın artık!
Dialogue: 0,0:10:24.51,0:10:26.50,Main,Citizen,0,0,0,,Dövüş görmek istiyoruz!
Dialogue: 0,0:10:39.90,0:10:43.99,Main,Luffy,0,0,0,,Ace'in Mera Mera Meyvesi orada ne arıyor?
Dialogue: 0,0:10:45.28,0:10:50.93,Main,Masked man,0,0,0,,Aynı özelliğe sahip iki \NŞeytan Meyvesi olamaz normalde.
Dialogue: 0,0:10:51.34,0:10:55.19,Main,Masked man,0,0,0,,Fakat güç kullanıcısı öldüğünde...
Dialogue: 0,0:10:55.19,0:11:01.11,Main,Masked man,0,0,0,,...dünyada bir yerlerde bu ölen kişiye ait\Nşeytan meyvesi yeniden belirir.
Dialogue: 0,0:11:01.11,0:11:06.33,Main,Masked man,0,0,0,,Ve onu yiyen kişi de\Nbu gücün yeni sahibi olur.
Dialogue: 0,0:11:06.33,0:11:11.35,Main,Masked man,0,0,0,,Ateş Yumruk Ace öldüğünde kimselere belli etmeksizin Mera Mera Meyvesi yeniden belirdi...
Dialogue: 0,0:11:11.35,0:11:14.05,Main,Masked man,0,0,0,,...ve Genç Beyimiz'in eline geçti!
Dialogue: 0,0:11:14.05,0:11:19.87,Main,Masked man,0,0,0,,Genç Beyimiz'in Logia türü Şeytan Meyvesi'ni\Nyarışma ödülü yaptığına inanmak zor.
Dialogue: 0,0:11:19.87,0:11:25.10,Main,Masked man,0,0,0,,Öyle devasa bir güç elde edebilseydim\Nhayatım kökten değişirdi!
Dialogue: 0,0:11:25.95,0:11:28.33,Main,Luffy,0,0,0,,Sana yedirir miyim o meyveyi!?
Dialogue: 0,0:11:29.39,0:11:32.54,Main,Franky,0,0,0,,Sahi ya şu Ace senin...
Dialogue: 0,0:11:32.85,0:11:35.37,Main,Luffy,0,0,0,,Mera Mera Meyvesi'ni istiyorum!
Dialogue: 0,0:11:36.00,0:11:39.51,Main,Luffy,0,0,0,,Sahi bak, sen yemez misin Franky?
Dialogue: 0,0:11:39.51,0:11:42.11,Main,Franky,0,0,0,,Yüzmekten vazgeçemem, kusura bakma.
Dialogue: 0,0:11:42.11,0:11:45.89,Main,Luffy,0,0,0,,Gomu Gomu Meyvesi yediğimden\Nben yiyemem ama...
Dialogue: 0,0:11:45.89,0:11:50.69,Main,Luffy,0,0,0,,...Ace'in gücünün hiç tanımadığım birinde\Nolmasına da müsaade edemem!
Dialogue: 0,0:11:50.69,0:11:53.30,Main,Franky,0,0,0,,Bir tür yadigâr senin için sanırım?
Dialogue: 0,0:11:53.30,0:11:55.45,Main,Franky,0,0,0,,Böyle gözünün içine sokulduğunu düşününce...
Dialogue: 0,0:11:55.48,0:11:58.60,Main,Franky,0,0,0,,...Doflamingo'nun kurduğu bir tuzak olma ihtimali yüksek...
Dialogue: 0,0:11:58.60,0:12:00.38,Main,Franky,0,0,0,,Ama şu da kesin ki...
Dialogue: 0,0:12:01.51,0:12:03.75,Main,Franky,0,0,0,,...bu fırsatın elinden kaçmasına\Nmüsaade edemezsin!
Dialogue: 0,0:12:04.66,0:12:07.04,Main,Franky,0,0,0,,Sonra yaşayacağın pişmanlıktan yeğdir.
Dialogue: 0,0:12:07.04,0:12:09.83,Main,Franky,0,0,0,,Zaten kolezyum da yolumuzun üzerinde.
Dialogue: 0,0:12:09.88,0:12:11.62,Main,Franky,0,0,0,,Gidelim bakalım!
Dialogue: 0,0:12:17.35,0:12:19.42,Main,Masked man,0,0,0,,Aptallar!
Dialogue: 0,0:12:19.42,0:12:23.81,Main,Masked man,0,0,0,,Sırf istiyorsunuz diye sizin olacak olsaydı\Nkimseler kalkıp da hayatını riske atmazdı.
Dialogue: 0,0:12:23.81,0:12:26.73,Main,Masked man,0,0,0,,Kolezyumu hafife almayın.
Dialogue: 0,0:12:27.44,0:12:30.29,Captions,,0,0,180,,{\fad(300,0)}# Gizemli Peri Takip Ekibi #
Dialogue: 0,0:12:31.90,0:12:35.83,Main,Zoro,0,0,0,,Yesinler perilerinizi!\NBildiğin hırsızın tekiydi işte!
Dialogue: 0,0:12:36.38,0:12:38.20,Main,Sanji,0,0,0,,Bekle dedim sana!
Dialogue: 0,0:12:38.20,0:12:40.86,Main,Sanji,0,0,0,,Birkaç katanan gitmiş ne yazar,\Nunut gitsin işte!
Dialogue: 0,0:12:40.86,0:12:42.85,Main,Zoro,0,0,0,,Olmaz öyle şey aptal herif!
Dialogue: 0,0:12:44.54,0:12:48.85,Main,Zoro,0,0,0,,Lanet olası! Kaçamayacaksın!
Dialogue: 0,0:12:50.00,0:12:51.13,Main,Sanji,0,0,0,,Bu...
Dialogue: 0,0:12:51.13,0:12:52.48,Main,Zoro,0,0,0,,Periyi mi buldun?!
Dialogue: 0,0:13:06.67,0:13:12.39,Captions,,0,0,240,,{\fad(480,480)}Dansçı Violet
Dialogue: 0,0:13:14.69,0:13:16.37,Main,Citizen,0,0,0,,Akıl almazdı!
Dialogue: 0,0:13:16.37,0:13:18.61,Main,Citizen,0,0,0,,İçimi titretti resmen!
Dialogue: 0,0:13:18.61,0:13:21.85,Main,Citizen,0,0,0,,Dansının eşi benzeri yok!
Dialogue: 0,0:13:27.92,0:13:29.05,Main,Sanji,0,0,0,,Ne?
Dialogue: 0,0:13:31.38,0:13:32.11,Main,Sanji,0,0,0,,Ço...
Dialogue: 0,0:13:33.02,0:13:34.63,Main,Sanji,0,0,0,,Çok güzel!
Dialogue: 0,0:13:34.63,0:13:37.66,Main,Zoro,0,0,0,,Burada kadınların adamları bıçakladıklarını\Nduymuştun değil mi?
Dialogue: 0,0:13:38.04,0:13:40.33,Main,Zoro,0,0,0,,Bıçaklanmak senin gibilerin kaderinde var.
Dialogue: 0,0:13:45.97,0:13:48.11,Main,Sanji,0,0,0,,{\i1}Bıçaklanmak falan umrumda değil!
Dialogue: 0,0:13:50.95,0:13:54.31,Main,Sanji,0,0,0,,Olamaz ya, kayboldu!
Dialogue: 0,0:13:55.81,0:13:58.48,Main,Sanji,0,0,0,,Lanet olası yol bilmez yosun kafa!
Dialogue: 0,0:13:58.48,0:14:01.29,Main,Sanji,0,0,0,,Neyse! Ne güzel işte,...
Dialogue: 0,0:14:01.29,0:14:05.51,Main,Sanji,0,0,0,,...bırakırız onu bu adada. \NOnu durdurabilmek için...
Dialogue: 0,0:14:05.51,0:14:07.37,Main,Sanji,0,0,0,,...elimden geleni yaptım sonuçta!
Dialogue: 0,0:14:11.60,0:14:16.70,Main,Sanji,0,0,0,,Buralar da çiftlerden geçilmiyor arkadaş, kıskandım be!
Dialogue: 0,0:14:21.97,0:14:27.29,Main,Sanji,0,0,0,,Acaba Nami-san'la Robin-chan\Nburada bana aşık olurlar mıydı?
Dialogue: 0,0:14:27.29,0:14:28.72,Main,Violet,0,0,0,,Bakar mısınız!
Dialogue: 0,0:14:29.58,0:14:32.32,Main,Violet,0,0,0,,Sizinle az önce göz göze gelmiştik değil mi?
Dialogue: 0,0:14:34.95,0:14:36.64,Main,Violet,0,0,0,,Lütfen,...
Dialogue: 0,0:14:36.64,0:14:38.41,Main,Violet,0,0,0,,...sarılın bana!
Dialogue: 0,0:14:38.41,0:14:40.33,Main,Sanji,0,0,0,,Neeee?!
Dialogue: 0,0:14:48.53,0:14:51.25,Main,Guard,0,0,0,,Nereye kayboldu bu kadın?!
Dialogue: 0,0:14:51.25,0:14:56.70,Main,Guard,0,0,0,,Arka kapıdan bu Aşıklar Pasajı'na çıkmış olmalı!\NHenüz çok uzaklaştığını sanmıyorum!
Dialogue: 0,0:14:56.70,0:14:58.24,Main,Guard,0,0,0,,Şehirden çıkmasına izin veremeyiz!
Dialogue: 0,0:14:58.24,0:14:59.28,Main,Guard,0,0,0,,Emredersiniz!
Dialogue: 0,0:15:02.19,0:15:04.94,Main,Violet,0,0,0,,Teşekkür ederim, gittiler sanırım.
Dialogue: 0,0:15:07.33,0:15:10.69,Main,Violet,0,0,0,,Şey, artık bırakabilirsiniz.
Dialogue: 0,0:15:13.00,0:15:16.06,Main,Sanji,0,0,0,,Ne demek!\NBenim için büyük bir zevkti!
Dialogue: 0,0:15:19.19,0:15:22.99,Main,Violet,0,0,0,,Özür dilerim, kafanızı falan mı vurdunuz?
Dialogue: 0,0:15:22.99,0:15:27.31,Main,Sanji,0,0,0,,Hayır, vurulduğum tek şey\Nsizinle bu şekilde karşılaşmamız oldu!
Dialogue: 0,0:15:27.31,0:15:29.41,Main,Violet,0,0,0,,Çok kanıyorsunuz ama...
Dialogue: 0,0:15:29.41,0:15:31.48,Main,Sanji,0,0,0,,Hiç önemli değil.
Dialogue: 0,0:15:32.50,0:15:33.68,Main,Violet,0,0,0,,Ay yazık.
Dialogue: 0,0:15:36.91,0:15:40.28,Main,Sanji,0,0,0,,Olamaz!\NAşkıma daha fazla engel olamıyorum!
Dialogue: 0,0:15:40.97,0:15:43.64,Main,Violet,0,0,0,,Ne?! Olmaz!\NBana o gözle bakmamalısınız!
Dialogue: 0,0:15:44.42,0:15:47.86,Main,Violet,0,0,0,,Ben aşktan vazgeçmiş bir kadınım!
Dialogue: 0,0:15:48.43,0:15:50.92,Main,Violet,0,0,0,,Bana vurulmuş tüm erkekler...{\fscx250}-{\r}
Dialogue: 0,0:15:50.92,0:15:51.73,Main,Sanji,0,0,0,,Evet!
Dialogue: 0,0:15:51.73,0:15:54.57,Main,Sanji,0,0,0,,Hepsi de çok mutluydu kesin!
Dialogue: 0,0:15:54.89,0:15:58.37,Main,Sanji,0,0,0,,Peşindekiler kimdi?!
Dialogue: 0,0:15:58.92,0:16:01.81,Main,Sanji,0,0,0,,Yardımcı olabileceğim\Nherhangi bir şey varsa söyle!
Dialogue: 0,0:16:03.89,0:16:06.08,Main,Violet,0,0,0,,Peşimdekiler polisti.
Dialogue: 0,0:16:07.48,0:16:10.69,Main,Violet,0,0,0,,Adamın birini...
Dialogue: 0,0:16:11.96,0:16:15.29,Main,Violet,0,0,0,,...aşkımız pek iyi gitmediği için bıçakladım.
Dialogue: 0,0:16:15.29,0:16:17.05,Main,Sanji,0,0,0,,Ne?!
Dialogue: 0,0:16:17.05,0:16:22.01,Main,Sanji,0,0,0,,Ülke kadınlarının aşk konusunda adamları bıçaklayacak kadar tutkulu oldukları doğru demek?!
Dialogue: 0,0:16:22.01,0:16:22.95,Main,Sanji,0,0,0,,Nasıl istersen!
Dialogue: 0,0:16:22.95,0:16:24.74,Main,Violet,0,0,0,,Ha tamamsın yani?
Dialogue: 0,0:16:26.70,0:16:28.15,Main,Sanji,0,0,0,,Ne oldu?!
Dialogue: 0,0:16:28.82,0:16:33.11,Main,Violet,0,0,0,,Yapma! Benim gibi bir kadına\Nbu kadar iyi davranma!
Dialogue: 0,0:16:35.96,0:16:37.08,Main,Violet,0,0,0,,Yoksa...
Dialogue: 0,0:16:37.86,0:16:39.72,Main,Violet,0,0,0,,...aşık olacağım sana.
Dialogue: 0,0:16:42.92,0:16:45.48,Main,Violet,0,0,0,,Adım Violet.
Dialogue: 0,0:16:45.48,0:16:49.95,Main,Violet,0,0,0,,Acaba bir sonraki şehre kadar\Nbana eşlik edebilir misin?
Dialogue: 0,0:16:50.60,0:16:52.02,Main,Violet,0,0,0,,Ve orada...
Dialogue: 0,0:16:53.02,0:16:55.63,Main,Violet,0,0,0,,...öldürmeni istediğim biri var!
Dialogue: 0,0:17:01.84,0:17:05.10,Captions,,0,0,210,,{\fad(420,0)}Corrida Kolezyumu
Dialogue: 0,0:17:02.66,0:17:05.10,Main,Luffy,0,0,0,,{\an8}Amma büyükmüş bu kolezyum ha!
Dialogue: 0,0:17:05.34,0:17:09.24,Main,Franky,0,0,0,,Şu coşkuya bak be!\NBenim de katılasım geldi!
Dialogue: 0,0:17:09.24,0:17:10.99,Main,Luffy,0,0,0,,İnsanlar çıldırıyor resmen!
Dialogue: 0,0:17:11.95,0:17:14.11,Main,Soldier,0,0,0,,İşimizi zorlaştırıyor!
Dialogue: 0,0:17:14.11,0:17:16.00,Main,Soldier,0,0,0,,Vazgeç bu işten artık!
Dialogue: 0,0:17:16.00,0:17:17.78,Main,Soldier,0,0,0,,Seni aranan azılı oyuncak asker!
Dialogue: 0,0:17:17.78,0:17:20.44,Main,Soldier-san,0,0,0,,Vuramazsınız!\NVuramazsınız!
Dialogue: 0,0:17:21.29,0:17:23.47,Main,Soldier-san,0,0,0,,{\fad(150,150)}Jet Yürüyüş!
Dialogue: 0,0:17:28.81,0:17:30.80,Main,Soldier-san,0,0,0,,Yavaş herifler, bana bakın!
Dialogue: 0,0:17:31.27,0:17:33.90,Main,Soldier-san,0,0,0,,{\an8}Kolezyuma ayak bastım!
Dialogue: 0,0:17:32.67,0:17:37.17,Captions,,0,0,240,,{\fad(500,0)}Tek Bacaklı Asker\NNamıdiğer: Öfkeli Yıldırım Asker
Dialogue: 0,0:17:33.90,0:17:36.41,Main,Soldier-san,0,0,0,,{\an8}Kuralı biliyorsunuz!
Dialogue: 0,0:17:38.89,0:17:42.91,Main,Soldier-san,0,0,0,,Ne polis ne de Donanma\Nkolezyuma girebilir!
Dialogue: 0,0:17:43.92,0:17:48.68,Main,Soldier-san,0,0,0,,Kolezyumdaki kişi bir suçlu dahi olsa\Nsizin yapabileceğiniz bir şey yok!
Dialogue: 0,0:17:49.11,0:17:54.11,Main,Soldier-san,0,0,0,,Ülkede geçerli tek kanun\NDon Quixote Ailesi'nin koyduğu kanundur.
Dialogue: 0,0:17:54.11,0:17:59.42,Main,Soldier-san,0,0,0,,O tetiği çekecek olursanız\Nbirer suçlu olacaksınız!
Dialogue: 0,0:17:59.42,0:18:01.73,Main,Soldier-san,0,0,0,,Defolun!
Dialogue: 0,0:18:01.73,0:18:02.67,Main,Soldier,0,0,0,,Lanet olası!
Dialogue: 0,0:18:06.43,0:18:11.60,Main,Soldier-san,0,0,0,,Amanın, ihtiyar insanlar! Çantalarınızı\Ntaşımaya yardım etmemi ister misiniz?
Dialogue: 0,0:18:11.60,0:18:14.60,Main,Franky,0,0,0,,Bu da nesi şimdi?\NBirden pek bir kibarlaştı.
Dialogue: 0,0:18:15.64,0:18:17.32,Main,Luffy,0,0,0,,Ne komik bir oyuncak asker!
Dialogue: 0,0:18:19.74,0:18:21.21,Main,Soldier-san,0,0,0,,Komik mi buldunuz beni?
Dialogue: 0,0:18:21.21,0:18:24.62,Main,Soldier-san,0,0,0,,Peki ya buna ne dersiniz?\NBuna ne dersiniz?
Dialogue: 0,0:18:26.36,0:18:28.32,Main,Franky,0,0,0,,Dostum, çekilir misin önümüzden?
Dialogue: 0,0:18:29.58,0:18:33.06,Main,Soldier-san,0,0,0,,Yolunuza çıktım demek!\NBağışlayın!
Dialogue: 0,0:18:33.06,0:18:35.94,Main,Franky,0,0,0,,Amma da utandın!
Dialogue: 0,0:18:36.74,0:18:39.30,Main,Franky,0,0,0,,Ciddisin değil mi sen?
Dialogue: 0,0:18:39.30,0:18:41.86,Main,Soldier-san,0,0,0,,Yok yahu!
Dialogue: 0,0:18:41.86,0:18:44.58,Main,Soldier-san,0,0,0,,Oyuncaklar insanları güldürmek için varlar!
Dialogue: 0,0:18:44.58,0:18:47.57,Main,Soldier-san,0,0,0,,Ciddi oyuncak diye bir şey yoktur!
Dialogue: 0,0:18:49.29,0:18:50.71,Main,Luffy,0,0,0,,Üstüne alındı!
Dialogue: 0,0:18:51.05,0:18:56.18,Main,Staff,0,0,0,,Bugünkü yarışma için olan\Ngönüllü başvuru süresi sona ermek üzere!
Dialogue: 0,0:18:56.60,0:18:59.28,Main,Staff,0,0,0,,Gönüllü kim katılmak ister ki zaten?
Dialogue: 0,0:18:59.28,0:19:01.09,Main,Staff,0,0,0,,Ödlekler sürüsü.
Dialogue: 0,0:19:01.29,0:19:05.30,Main,Franky,0,0,0,,Luffy, sanırım yollarımız burada ayrılacak.
Dialogue: 0,0:19:05.30,0:19:06.73,Main,Luffy,0,0,0,,Peki madem.
Dialogue: 0,0:19:06.73,0:19:09.33,Main,Luffy,0,0,0,,Buradayım burada!\NKatılmak istiyorum!
Dialogue: 0,0:19:09.33,0:19:12.55,Main,Luffy,0,0,0,,{\i1}Katılacağım, katılacağım!{\i0}
Dialogue: 10,0:19:20.04,0:19:22.82,Main,,0,0,0,,Bu ne ya?\NO ihtiyar mı katılacakmış?
Dialogue: 10,0:19:22.82,0:19:24.23,Main,,0,0,0,,Tahtası falan mı eksik acaba?
Dialogue: 10,0:19:24.23,0:19:26.51,Main,,0,0,0,,Bugün kimlerin yarıştığını\Nbilmiyor mu acaba?
Dialogue: 10,0:19:29.15,0:19:32.90,Main,,0,0,0,,Bak az Luffy,\Ntek bir şeye dikkat etmeni istiyorum.
Dialogue: 10,0:19:32.90,0:19:36.44,Main,,0,0,0,,Gönlünce savaşabilirsin ama\Nasla kim olduğunu belli etme.
Dialogue: 10,0:19:36.44,0:19:37.62,Main,,0,0,0,,Tamamdır!
Dialogue: 10,0:19:37.62,0:19:38.98,Main,,0,0,0,,Adını yaz öyleyse.
Dialogue: 10,0:19:38.98,0:19:40.32,Main,,0,0,0,,Luf...
Dialogue: 10,0:19:40.32,0:19:41.26,Main,,0,0,0,,Aptal mısın nesin sen?!
Dialogue: 0,0:19:41.37,0:19:44.95,Captions,,0,0,180,,{\fad(450,0)}No: 0556 - Lucy
Dialogue: 10,0:19:46.79,0:19:49.06,Main,,0,0,0,,Burası savaşçıların soyunma odası.
Dialogue: 10,0:19:49.06,0:19:50.89,Main,,0,0,0,,Çağrılana kadar serbestsin.
Dialogue: 10,0:19:50.89,0:19:53.18,Main,,0,0,0,,Vay canına, heyecana gel!
Dialogue: 10,0:19:54.37,0:19:56.66,Main,,0,0,0,,Mera Mera Meyvesi benim olacak!
Dialogue: 10,0:19:56.66,0:19:58.54,Main,,0,0,0,,Benim olacak işte mal herif!
Dialogue: 10,0:20:13.06,0:20:16.12,Main,,0,0,0,,Şu bücür de kimin nesi?
Dialogue: 10,0:20:22.78,0:20:23.73,Main,,0,0,0,,İlginç.
Dialogue: 10,0:20:25.40,0:20:28.02,Main,,0,0,0,,İstediğimiz silahı kullanabiliyoruz anlaşılan.
Dialogue: 10,0:20:33.61,0:20:35.78,Main,,0,0,0,,Bu da kim?
Dialogue: 10,0:20:36.61,0:20:39.65,Main,,0,0,0,,İçeri son giren katılımcı.
Dialogue: 10,0:20:39.65,0:20:42.26,Main,,0,0,0,,Ne diye gelmiş ki bu bücür?
Dialogue: 0,0:20:47.74,0:20:53.23,Captions,,0,0,240,,{\fad(450,0)}Spartan\NCorrida Kolezyumu Gladyatörü (51 Kez Aylık Turnuva Galibi)
Dialogue: 10,0:20:47.64,0:20:51.84,Main,,0,0,0,,{\an8}Bu tarz şakalardan nefret ederim!
Dialogue: 10,0:21:04.41,0:21:08.54,Main,,0,0,0,,Bana bak sahte sakallı velet,\Nsavaş alanındasın!
Dialogue: 10,0:21:08.54,0:21:10.11,Main,,0,0,0,,Yapma Spartan!
Dialogue: 10,0:21:10.11,0:21:14.08,Main,,0,0,0,,Eziklerin dayak yemesini izlemenin \Nnesi eğlenceli?!
Dialogue: 10,0:21:14.08,0:21:17.82,Main,,0,0,0,,Seyirciler yalnızca başa baş\Nmücadelelerde eğleniyorlar!
Dialogue: 10,0:21:18.34,0:21:21.86,Main,,0,0,0,,Senin gibilere uygun bir yer\Ndeğil burası, evine dön!
Dialogue: 10,0:21:22.47,0:21:25.90,Main,,0,0,0,,Derhal git buradan!
Dialogue: 10,0:21:45.56,0:21:47.32,Main,,0,0,0,,Memnun oldum!
