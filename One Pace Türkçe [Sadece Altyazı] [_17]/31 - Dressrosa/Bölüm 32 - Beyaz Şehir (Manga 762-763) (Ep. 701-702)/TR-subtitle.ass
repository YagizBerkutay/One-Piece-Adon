0,10,10,1Style: OP12 Lyrics,FOT-Greco Std B,39,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,2.6,0,2,10,10,15,1Style: Romaji - OP18 Styleı,Designosaur,45,&H00E9FFFE,&H00E9FFFE,&H00AD0B00,&H00FFE700,0,0,0,0,100,100,1,0,1,1.5,0,8,22,22,12,1Style: Romaji - OP18 Style1_alt,Designosaur,45,&H00E9FFFE,&H00E9FFFE,&H00AD0B00,&H00FFE700,0,0,0,0,100,100,1,0,1,1.5,0,8,22,22,12,1Style: English - OP18,Designosaur,39,&H00FFFFFF,&H00FFFFFF,&H00030303,&H00000000,0,-1,0,0,110,100,1,0,1,2.25,0,2,22,22,18,1Style: Captions,Impress BT,45,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,2,0,2,10,10,10,1Style: Karaokefade,Impress BT,55,&H00FFFFFF,&HFF0000Eı,&H00000000,&HFF000000,0,0,0,0,100,100,0,0,1,1.8,1.5,2,120,120,18,1Style: Author,Impress BT,25,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1,1,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:02.49,0:00:04.79,English - OP18,,0,0,0,,~ Dövüş! ~ ♪ Çarpış ve yüksel yerinden ♪Dialogue: 0,0:00:04.79,0:00:08.00,English - OP18,,0,0,0,,♪ Aşmamız gereken zor günlerimiz bunlar ♪Dialogue: 0,0:00:08.00,0:00:12.84,English - OP18,,0,0,0,,♪ Keza sıradan günler yetmez sususluğumuzu dindirmeye ♪Dialogue: 0,0:00:12.84,0:00:15.09,English - OP18,,0,0,0,,~ İşte başlıyoruz! ~ ♪ Kaçmadan, hep ileriye ♪Dialogue: 0,0:00:15.09,0:00:19.17,English - OP18,,0,0,0,,♪ Ulu rüzgarlarda yaşayalım harabeye dönsek bile ♪Dialogue: 0,0:00:19.17,0:00:21.87,English - OP18,,0,0,0,,♪ Hedefse hâlâ çok uzakta ♪Dialogue: 0,0:00:21.87,0:00:26.69,English - OP18,,0,0,0,,♪ Aşmalı bu zor günleri ♪Dialogue: 0,0:00:28.53,0:00:31.61,English - OP18,,0,0,0,,♪ Yine yapalım, evet, kaç kez daha, bebeğim ♪Dialogue: 0,0:00:31.83,0:00:34.11,English - OP18,,0,0,0,,♪ Hayalimi gerçekleştirmek için doğrulmalı yerimden ♪Dialogue: 0,0:00:34.33,0:00:36.72,English - OP18,,0,0,0,,♪ Çünkü her gün sanki yeniden test ediliyor ♪Dialogue: 0,0:00:36.96,0:00:39.42,English - OP18,,0,0,0,,♪ İrade gücüm ♪Dialogue: 0,0:00:39.42,0:00:40.69,English - OP18,,0,0,0,,~ Haydi gidelim! ~Dialogue: 0,0:00:40.92,0:00:44.46,English - OP18,,0,0,0,,♪ İstemiyorum bahaneler üretip küçük başarılarla yetinmeyi ♪Dialogue: 0,0:00:44.67,0:00:45.96,English - OP18,,0,0,0,,~ Haydi gidelim! ~Dialogue: 0,0:00:46.18,0:00:49.66,English - OP18,,0,0,0,,♪ Vahşi ve kanunsuz içine düştüğüm şu dünyada ♪Dialogue: 0,0:00:49.89,0:00:54.18,English - OP18,,0,0,0,,♪ Gardımı indirmiş rüzgarla esip giderken  gerçeklik çalınıyor yüzüme ♪Dialogue: 0,0:00:54.18,0:00:59.47,English - OP18,,0,0,0,,♪ Acımasızca döv beni, vur bana ve  düşecek olursam da yine ♪Dialogue: 0,0:01:00.36,0:01:04.57,English - OP18,,0,0,0,,♪ Biliyorum yeniden doğrulup ileriye bakabilenler olacak ♪Dialogue: 0,0:01:04.57,0:01:07.82,English - OP18,,0,0,0,,♪ Son gülüp kazananlar ♪Dialogue: 0,0:01:07.82,0:01:10.12,English - OP18,,0,0,0,,~ Koşmalı şeref yolunda oraya varana kadar ~Dialogue: 0,0:01:10.30,0:01:12.54,English - OP18,,0,0,0,,~ Dövüş! ~ ♪ Kurtul kabuslarından, güçlü ol ♪Dialogue: 0,0:01:12.54,0:01:15.72,English - OP18,,0,0,0,,♪ Aşmamız gereken zor günlerimiz bunlar ♪Dialogue: 0,0:01:15.72,0:01:20.80,English - OP18,,0,0,0,,♪ Kolay yol? Yok öyle bir şey ♪Dialogue: 0,0:01:20.80,0:01:23.13,English - OP18,,0,0,0,,~ İşte başlıyoruz! ~ ♪ Hep en iyisi ol ♪Dialogue: 0,0:01:23.13,0:01:27.18,English - OP18,,0,0,0,,♪ Sorumluluklarını düşünmeden ilerle ♪Dialogue: 0,0:01:27.18,0:01:29.81,English - OP18,,0,0,0,,♪ Ve tüm dileklerimizi bir araya getirerek ♪Dialogue: 0,0:01:29.81,0:01:34.99,English - OP18,,0,0,0,,♪ Aşmalı bu zor günleri ♪Dialogue: 0,0:01:42.63,0:01:52.63,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gnsDialogue: 0,0:14:36.00,0:14:46.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gnsDialogue: 0,0:28:10.00,0:28:20.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gnsDialogue: 0,0:01:42.63,0:01:45.85,Title,,0,0,240,,Beyaz ŞehirDialogue: 0,0:01:45.87,0:01:51.14,Captions,,0,0,240,,Spider Miles - Liman Şehri Atık İşleme TesisiDialogue: 0,0:01:53.88,0:01:57.01,Captions,,900,0,130,,Beyaz Şehirli Çocuk Trafalgar Law ~ 10 Yaşında ~Dialogue: 0,0:01:59.20,0:02:00.95,Main,,0,0,0,,Atın şunu dışarı!Dialogue: 0,0:02:00.95,0:02:02.94,Main,,0,0,0,,Baksana, baksana Law!Dialogue: 0,0:02:02.94,0:02:04.72,Main,,0,0,0,,İki hafta oldu.Dialogue: 0,0:02:04.72,0:02:06.84,Main,,0,0,0,,Buradan çıkıp gitmek istemiyor musun?Dialogue: 0,0:02:06.84,0:02:12.50,Main,,0,0,0,,Geldiğinden beri Corazon'un az dayağını yemedin.Dialogue: 0,0:02:14.28,0:02:17.48,Main,,0,0,0,,Çocuklar kadar yetişkinler de kaçıyor.Dialogue: 0,0:02:17.92,0:02:21.27,Main,,0,0,0,,Bu sayede de bu masada sadece en iyiler toplanıyor.Dialogue: 0,0:02:21.27,0:02:24.24,Main,,0,0,0,,Senin gibi güçsüz bir velet ne kadar dayanır sanıyorsun?Dialogue: 0,0:02:24.24,0:02:27.46,Main,,0,0,0,,Başına ne gelirse gelsin "Kan Kuralı"nı unutma.Dialogue: 0,0:02:28.30,0:02:32.45,Main,,0,0,0,,Üyelerden biri yöneticileri yaralayacak olursa aile paramparça olur.Dialogue: 0,0:02:32.45,0:02:36.72,Main,,0,0,0,,Bir keresinde Pica-sama'ya gülmüştüm, işkenceyle aklımı aldılar resmen.Dialogue: 0,0:02:37.90,0:02:39.94,Main,,0,0,0,,Böyle şeyler beni korkutmuyor.Dialogue: 0,0:02:40.26,0:02:43.35,Main,,0,0,0,,Cehennemi gördüm ben.Dialogue: 0,0:02:43.37,0:02:48.70,Captions,,750,0,250,,Donquixote Korsanları Kaptan Donquixote DoflamingoDialogue: 0,0:02:45.12,0:02:49.06,Main,,0,0,0,,Kurusıkı atmakta özgürsün tabii.Dialogue: 0,0:02:49.06,0:02:53.35,Main,,0,0,0,,Ama Corazon biricik, öz kardeşim benim.Dialogue: 0,0:02:53.35,0:02:57.47,Main,,0,0,0,,Eğer birileri kılına dahi zarar verecek olursa bizzat ben...Dialogue: 0,0:02:57.47,0:02:59.42,Main,,0,0,0,,...sonları olurum!Dialogue: 0,0:03:02.66,0:03:04.79,Main,,0,0,0,,Derisine bakın!Dialogue: 0,0:03:04.79,0:03:07.83,Main,,0,0,0,,Beyaz Kurşun Hastalığı! Yakalanırsan acıdan ölürsün!Dialogue: 0,0:03:07.83,0:03:12.74,Main,,0,0,0,,Ne?! Bulaşıcı mı bu?! İğrenç birisin!Dialogue: 0,0:03:12.74,0:03:14.62,Main,,0,0,0,,Çık git buradan-dasuyan!Dialogue: 0,0:03:16.58,0:03:20.58,Main,,0,0,0,,Giolla, temelsiz söylentilerle insanların kafasını bulandırma.Dialogue: 0,0:03:20.58,0:03:21.77,Main,,0,0,0,,Hiç yakıştıramadım.Dialogue: 0,0:03:21.77,0:03:24.38,Main,,0,0,0,,Bak, Buffalo inandı sana.Dialogue: 0,0:03:24.80,0:03:26.94,Main,,0,0,0,,Beyaz Kurşun Hastalığının nedeni  zehirlenmedir.Dialogue: 0,0:03:26.94,0:03:28.77,Main,,0,0,0,,Bulaşıcı değil.Dialogue: 0,0:03:28.77,0:03:31.94,Main,,0,0,0,,Yine de yanıma yaklaşma-dasuyan!Dialogue: 0,0:03:31.94,0:03:33.79,Main,,0,0,0,,Öyle bir hastalığa yakalanmak istemiyorum-dasuyan!Dialogue: 0,0:03:33.79,0:03:34.61,Main,,0,0,0,,Bana bak.Dialogue: 0,0:03:35.40,0:03:40.40,Main,,0,0,0,,Beyaz Şehir Flevance'da başka kurtulanlar da var mı?Dialogue: 0,0:03:40.40,0:03:41.46,Main,,0,0,0,,Bilmiyorum.Dialogue: 0,0:03:41.46,0:03:43.52,Main,,0,0,0,,Arkama bakmadan kaçtım.Dialogue: 0,0:03:43.52,0:03:45.57,Main,,0,0,0,,Nasıl başardın bunu?Dialogue: 0,0:03:45.57,0:03:48.94,Main,,0,0,0,,Cesetlerin altında saklanarak sınırı geçtim.Dialogue: 0,0:03:49.54,0:03:51.68,Main,,0,0,0,,Yemek yiyoruz!Dialogue: 0,0:03:53.80,0:03:56.12,Main,,0,0,0,,Bu kin niye peki?Dialogue: 0,0:03:57.20,0:04:00.35,Main,,0,0,0,,Hiçbir şeye inancım kalmadı.Dialogue: 0,0:04:00.35,0:04:02.15,Main,,0,0,0,,Ölmekten de korkmuyorum!Dialogue: 0,0:04:02.39,0:04:03.80,Main,,0,0,0,,Corazon!Dialogue: 0,0:04:03.80,0:04:05.36,Main,,0,0,0,,Şansını fazla zorlama!Dialogue: 0,0:04:05.94,0:04:09.90,Main,,0,0,0,,Ne pahasına olursa olsun yaptıklarının hesabını soracağım!Dialogue: 0,0:04:10.06,0:04:13.07,Main,,0,0,0,,Aptal mısın sen be? Nerenle dinliyorsun?!Dialogue: 0,0:04:13.29,0:04:15.70,Main,,0,0,0,,Öyle bir şey yaparsan işkence ederler sana!Dialogue: 0,0:04:15.70,0:04:17.05,Main,,0,0,0,,Kazığa oturturlar!Dialogue: 0,0:04:17.05,0:04:19.16,Main,,0,0,0,,Korsanlarla şaka olmaz!Dialogue: 0,0:04:19.16,0:04:20.84,Main,,0,0,0,,Çocuk kimisi aptal olur!Dialogue: 0,0:04:20.87,0:04:24.22,Main,,0,0,0,,İki damla gözyaşı dökünce hemen bağışlanacağını sanma!Dialogue: 0,0:04:27.33,0:04:30.85,Captions,,0,0,0,,Liman Şehri RakeshDialogue: 0,0:04:31.02,0:04:34.35,Main,,0,0,0,,Şu çocuğun geldiği Beyaz Şehir nasıl bir yer?Dialogue: 0,0:04:34.66,0:04:38.69,Main,,0,0,0,,İnsanların Flevance dedikleri bir ülke...Dialogue: 0,0:04:38.69,0:04:40.18,Main,,0,0,0,,Flevance mı?Dialogue: 0,0:04:40.18,0:04:40.98,Main,,0,0,0,,Evet.Dialogue: 0,0:04:41.46,0:04:46.10,Main,,0,0,0,,İnsanları zengin kasabaları da sanki  peri masalından fırlamış karlar ülkesi misali...Dialogue: 0,0:04:46.10,0:04:48.15,Main,,0,0,0,,...toprağından bitkisine beyazmış.Dialogue: 0,0:04:48.15,0:04:52.53,Main,,0,0,0,,Bu dünyadan değilmişçesine güzel bir ülke olduğunu duymuştum.Dialogue: 0,0:04:53.58,0:04:58.61,Main,,0,0,0,,Günün birinde yeraltında Beyaz Kurşun isimli bir tür kurşunu keşfedince...Dialogue: 0,0:04:58.61,0:05:02.26,Main,,0,0,0,,...şehirlerine tüm o fantastik beyazlığı verenin de bu olduğunu anlamışlar.Dialogue: 0,0:05:03.06,0:05:08.92,Main,,0,0,0,,Beyaz Kurşundan çanak çömlek, boya tatlandırıcı, kozmetik ürünler hatta silah bile yapmışlar.Dialogue: 0,0:05:09.59,0:05:14.34,Main,,0,0,0,,Tüm dünyadan insanlar bu yüksek kalite Beyaz Kurşun ürünleri almak isteyince de...Dialogue: 0,0:05:14.83,0:05:18.74,Main,,0,0,0,,...Flevance büyük bir sanayi halini almış.Dialogue: 0,0:05:19.76,0:05:24.40,Main,,0,0,0,,İleri görüşlü Dünya Hükümeti de ürünleri  insanlara ulaştırabilmek için taşımacılık işine girmiş.Dialogue: 0,0:05:24.92,0:05:27.66,Main,,0,0,0,,Beyaz Kurşun sayesinde insanlar acayip zengin olmuşlar.Dialogue: 0,0:05:30.58,0:05:34.98,Main,,0,0,0,,Law, bu tarz ameliyatlarda bu kan damarını kullanıyorsun.Dialogue: 0,0:05:34.98,0:05:35.61,Main,,0,0,0,,Vay be!Dialogue: 0,0:05:35.61,0:05:38.08,Main,,0,0,0,,Ağabey, festivale gidelim!Dialogue: 0,0:05:38.08,0:05:40.66,Main,,0,0,0,,Evet, üçünüz gidin.Dialogue: 0,0:05:42.44,0:05:45.91,Main,,0,0,0,,Peki. Ama yarım saat sadece.Dialogue: 0,0:05:45.91,0:05:48.59,Main,,0,0,0,,İlgilenmemiz gereken bir sürü hastamız var.Dialogue: 0,0:05:48.59,0:05:49.70,Main,,0,0,0,,Yaşasın!Dialogue: 0,0:05:50.40,0:05:54.37,Main,,0,0,0,,Law, festivale gidiyoruz!Dialogue: 0,0:05:55.36,0:05:56.40,Main,,0,0,0,,Evet!Dialogue: 0,0:05:56.40,0:06:00.04,Main,,0,0,0,,Beyaz Şehir herkesin tatlı rüyalarına giren bir ülkeydi.Dialogue: 0,0:06:00.04,0:06:03.05,Main,,0,0,0,,Ben de gitmek isterdim!Dialogue: 0,0:06:03.05,0:06:05.58,Main,,0,0,0,,"Rüyalarına giren"in G'si!Dialogue: 0,0:06:06.62,0:06:08.55,Main,,0,0,0,,Ama artık o ülkeden eser kalmadı.Dialogue: 0,0:06:08.55,0:06:09.46,Main,,0,0,0,,Ne?Dialogue: 0,0:06:23.30,0:06:26.78,Main,,0,0,0,,10 yıl önce kadar, Beyaz Kurşun endüstrisi kurulduğunda...Dialogue: 0,0:06:27.57,0:06:31.18,Main,,0,0,0,,...Dünya Hükümeti ülkede jeolojik araştırma yapıp...Dialogue: 0,0:06:32.84,0:06:36.50,Main,,0,0,0,,...olayın gerçeğini öğrenmiş.Dialogue: 0,0:06:36.50,0:06:37.38,Main,,0,0,0,,Gerçeği mi?Dialogue: 0,0:06:37.38,0:06:38.74,Main,,0,0,0,,Zehir.Dialogue: 0,0:06:38.74,0:06:39.70,Main,,0,0,0,,Ne?Dialogue: 0,0:06:39.70,0:06:43.02,Main,,0,0,0,,Kazıp çıkarmadığın müddetçe zararı olmayan bir zehir.Dialogue: 0,0:06:43.25,0:06:46.82,Main,,0,0,0,,Ama bir şekilde eline geçecek olursa vücudunu tüketir.Dialogue: 0,0:06:47.72,0:06:48.95,Main,,0,0,0,,Ne?!Dialogue: 0,0:06:48.95,0:06:53.58,Main,,0,0,0,,Bunu bilmelerine rağmen kolay yoldan zengin olabilmek için...Dialogue: 0,0:06:53.58,0:06:57.63,Main,,0,0,0,,...Hükümet ve ülkenin asilzadeleri bu bilgiyi gizli tuttular.Dialogue: 0,0:06:58.04,0:07:01.93,Main,,0,0,0,,Halksa her şeyden habersiz Beyaz Kurşun çıkartmaya devam etti.Dialogue: 0,0:07:02.15,0:07:05.14,Main,,0,0,0,,Ölecekler ama hepsi de!Dialogue: 0,0:07:05.14,0:07:05.96,Main,,0,0,0,,Evet.Dialogue: 0,0:07:07.06,0:07:11.28,Main,,0,0,0,,Tabii şu ana kadarki en kötü kısım zehirle ilgili olandı.Dialogue: 0,0:07:12.24,0:07:16.31,Main,,0,0,0,,Bir de bu kurşunun genç bir kişinin vücudunda biriktiğini düşün...Dialogue: 0,0:07:16.31,0:07:22.26,Main,,0,0,0,,Bu kişinin kendi çocuğu olduğunda doğan çocuk da kısa bir ömre sahip oluyor.Dialogue: 0,0:07:24.39,0:07:28.46,Main,,0,0,0,,Yeni doğan çocuk büyüyüp kendi çocuğu olduğu vakit...Dialogue: 0,0:07:28.46,0:07:31.64,Main,,0,0,0,,...yeni doğan çocuğun hayatıysa daha da kısa oluyor.Dialogue: 0,0:07:31.64,0:07:32.47,Main,,0,0,0,,Yaş 10Dialogue: 0,0:07:31.65,0:07:32.47,Main,,0,0,0,,Yaş 30Dialogue: 0,0:07:31.65,0:07:32.47,Main,,0,0,0,,Yaş 50Dialogue: 0,0:07:31.65,0:07:32.47,Main,,0,0,0,,Yaş 70Dialogue: 0,0:07:31.65,0:07:32.47,Main,,0,0,0,,Tahmini ÖmürDialogue: 0,0:07:31.65,0:07:32.47,Main,,0,0,0,,Zamanla Oluşan       Olumsuz EtkiDialogue: 0,0:07:31.65,0:07:32.47,Main,,0,0,0,,Çocuk YokDialogue: 0,0:07:32.18,0:07:34.20,Main,,0,0,0,,Nesilden nesile ortalama hayat azalıp...Dialogue: 0,0:07:32.47,0:07:36.63,Main,,0,0,0,,Yaş 10Dialogue: 0,0:07:32.47,0:07:36.63,Main,,0,0,0,,Yaş 30Dialogue: 0,0:07:32.47,0:07:36.63,Main,,0,0,0,,Yaş 50Dialogue: 0,0:07:32.47,0:07:36.63,Main,,0,0,0,,Yaş 70Dialogue: 0,0:07:32.47,0:07:36.63,Main,,0,0,0,,Tahmini ÖmürDialogue: 0,0:07:32.47,0:07:36.63,Main,,0,0,0,,Zamanla Oluşan       Olumsuz EtkiDialogue: 0,0:07:32.47,0:07:36.63,Main,,0,0,0,,Çocuk  YokDialogue: 0,0:07:34.20,0:07:38.68,Main,,0,0,0,,...Law gibi daha yetişkin olamadan ölecek çocuğun  doğumuyla da neslin sonu gelmiş oluyor.Dialogue: 0,0:07:40.26,0:07:44.30,Main,,0,0,0,,Dünya sonunda Beyaz Kurşun'un zehirli olduğunu öğrendiğinde...Dialogue: 0,0:07:45.96,0:07:47.77,Main,,0,0,0,,Her şey için çok geçti.Dialogue: 0,0:07:50.16,0:07:54.89,Main,,0,0,0,,Bir noktada insanlar birbiri ardına bayılmaya başladılar.Dialogue: 0,0:07:54.89,0:07:58.58,Main,,0,0,0,,Yaşlılar, gençler, çocuklar.Dialogue: 0,0:07:58.58,0:08:02.78,Main,,0,0,0,,Ömürleri farklı olduğundan tüm nesiller aynı anda hastalandı.Dialogue: 0,0:08:03.64,0:08:09.44,Main,,0,0,0,,Vücutları ve saçları hızla beyazlayıp vücutları acı içinde insanlar öldüler.Dialogue: 0,0:08:10.34,0:08:13.17,Main,,0,0,0,,Hiçbir doktor bu konuda bir şey yapamadı.Dialogue: 0,0:08:20.78,0:08:24.92,Main,,0,0,0,,O çocuğun ülkesindeki herkes öldü mü yani?!Dialogue: 0,0:08:25.46,0:08:27.10,Main,,0,0,0,,Çok üzüldüm...Dialogue: 0,0:08:27.10,0:08:29.40,Main,,0,0,0,,Asıl trajedi ondan sonra başladı.Dialogue: 0,0:08:29.40,0:08:30.24,Main,,0,0,0,,Ne?Dialogue: 0,0:08:30.24,0:08:36.24,Main,,0,0,0,,Komşu ülkeler Beyaz Şehir'in insanlarının aynı semptomlardan öldüğünü görünce...Dialogue: 0,0:08:36.24,0:08:41.32,Main,,0,0,0,,...Beyaz Kurşun Hastalığı'nın bulaşıcı olduğunu düşündüler.Dialogue: 0,0:08:40.55,0:08:44.63,Main,,0,600,330,,Beyaz ŞehirDialogue: 0,0:08:41.66,0:08:48.51,Main,,0,0,0,,Bu nedenle de dört bir yandan ülkeyi kapatıp Beyaz Şehir konusunda karantina önlemleri aldılar.Dialogue: 0,0:08:48.96,0:08:53.74,Main,,0,0,0,,Asilzadeler Hükümet'ten yardım alıp ilk zamanlarda ülkeden kaçtı.Dialogue: 0,0:08:53.74,0:08:55.51,Main,,0,0,0,,Halk kendi kaderine terk edilmişti.Dialogue: 0,0:08:56.58,0:09:02.26,Main,,0,0,0,,Tedavi umutlarıyla başka şehre  göçmeye çalışan Beyaz Şehir vatandaşları...Dialogue: 0,0:09:02.26,0:09:09.78,Main,,0,0,0,,...sanki kafesten kaçmaya çalışan birer canavarmış gibi korkulup öldürüldüler.Dialogue: 0,0:09:11.60,0:09:14.35,Main,,0,0,0,,Hoşlarına gitmeyen şeyleri hasıraltı ettiler.Dialogue: 0,0:09:14.35,0:09:15.67,Main,,0,0,0,,Lanet olsun!Dialogue: 0,0:09:17.54,0:09:20.84,Main,,0,0,0,,Hastalığın verdiği acı başkasının sorunuydu nasılsa.Dialogue: 0,0:09:21.00,0:09:23.58,Main,,0,0,0,,İnsanlar böyle işte...Dialogue: 0,0:09:24.02,0:09:26.31,Main,,0,0,0,,Ama Flavence bu duruma sessiz kalmadı.Dialogue: 0,0:09:27.24,0:09:30.60,Main,,0,0,0,,Ellerinde ne ironiktir ki tonla kurşun mermi vardı.Dialogue: 0,0:09:34.96,0:09:37.32,Main,,0,0,0,,Ve nihayetinde savaş başgösterdi.Dialogue: 0,0:09:38.04,0:09:42.17,Main,,0,0,0,,Düğer ülkeler yaptıklarını nefsi müdafaa olarak adlandırıp bir damla bile merhamet göstermediler.Dialogue: 0,0:09:42.99,0:09:46.13,Main,,0,0,0,,Gerisini tahmin etmişsindir.Dialogue: 0,0:09:51.60,0:09:52.97,Main,,0,0,0,,Law-kun!Dialogue: 0,0:09:52.97,0:09:55.35,Main,,0,0,0,,Haydi, sen de gel bizimle!Dialogue: 0,0:09:55.35,0:10:00.01,Main,,0,0,0,,Çocukların kaçmalarına izin vereceklerini söyleyen iyi kalpli askerler geldi!Dialogue: 0,0:10:00.01,0:10:00.87,Main,,0,0,0,,Law!Dialogue: 0,0:10:00.87,0:10:02.02,Main,,0,0,0,,Kurtulacağız!Dialogue: 0,0:10:07.04,0:10:10.20,Main,,0,0,0,,Rahibe, kız kardeşim ölüyor!Dialogue: 0,0:10:10.78,0:10:12.30,Main,,0,0,0,,Gidemem!Dialogue: 0,0:10:12.30,0:10:13.66,Main,,0,0,0,,Lammy-chan mı?!Dialogue: 0,0:10:14.00,0:10:15.49,Main,,0,0,0,,Anlıyorum...Dialogue: 0,0:10:16.42,0:10:20.53,Main,,0,0,0,,Öyleyse seni bir sonraki gemiye bindirmelerini isteriz!Dialogue: 0,0:10:20.53,0:10:22.46,Main,,0,0,0,,Seni almaya geleceğim!Dialogue: 0,0:10:22.46,0:10:24.59,Main,,0,0,0,,Law! Gelmiyor musun?!Dialogue: 0,0:10:24.59,0:10:26.26,Main,,0,0,0,,Gidelim işte!Dialogue: 0,0:10:26.26,0:10:29.59,Main,,0,0,0,,Lammy'i de sonra kurtarırlar!Dialogue: 0,0:10:29.59,0:10:33.28,Main,,0,0,0,,Babam da annem de öldü!Dialogue: 0,0:10:33.28,0:10:36.38,Main,,0,0,0,,Ama bana yaşamamı söylediler!Dialogue: 0,0:10:37.18,0:10:40.22,Main,,0,0,0,,Ne olursa olsun yaşayacağım!Dialogue: 0,0:10:41.16,0:10:42.52,Main,,0,0,0,,Dinle, Law-kun.Dialogue: 0,0:10:42.75,0:10:45.52,Main,,0,0,0,,Her zaman umut vardır.Dialogue: 0,0:10:46.58,0:10:50.30,Main,,0,0,0,,Merhamet dolu bir yardım eli...Dialogue: 0,0:10:50.46,0:10:52.98,Main,,0,0,0,,...aynı bu şekilde sana da ulaşacak.Dialogue: 0,0:10:56.04,0:10:58.54,Main,,0,0,0,,Doktor, yardım et bize!Dialogue: 0,0:10:58.54,0:11:00.44,Main,,0,0,0,,Doktor!Dialogue: 0,0:11:00.69,0:11:03.34,Main,,0,0,0,,İmkansız! Oraya gidemem!Dialogue: 0,0:11:03.34,0:11:06.81,Main,,0,0,0,,Yeterli doktorumuz yok! Elimizde ne yedek kan kaldı ne bir şey!Dialogue: 0,0:11:07.18,0:11:11.23,Main,,0,0,0,,Beyaz Kurşun'u vücuttan çıkartmaya yarayan bir yol olmalı!Dialogue: 0,0:11:11.23,0:11:12.65,Main,,0,0,0,,Bulaşıcı değil!Dialogue: 0,0:11:12.65,0:11:15.18,Main,,0,0,0,,Hükümet insanları neden bundan haberdar etmiyor?!Dialogue: 0,0:11:18.16,0:11:21.45,Main,,0,0,0,,Ağabey, her yanım acıyor.Dialogue: 0,0:11:22.10,0:11:24.66,Main,,0,0,0,,Gittikçe daha çok yerim beyazlıyor.Dialogue: 0,0:11:26.36,0:11:28.84,Main,,0,0,0,,Biraz daha sık dişini.Dialogue: 0,0:11:28.84,0:11:31.70,Main,,0,0,0,,Babamız ülkenin en iyi doktoru.Dialogue: 0,0:11:31.70,0:11:33.37,Main,,0,0,0,,Eminim seni iyileştirecek.Dialogue: 0,0:11:34.12,0:11:36.99,Main,,0,0,0,,Dışarısı neden bu kadar gürültülü?Dialogue: 0,0:11:36.99,0:11:40.35,Main,,0,0,0,,Festival var! Flevance hep ışıl ışıldır.Dialogue: 0,0:11:40.92,0:11:44.24,Main,,0,0,0,,Çabucak iyileş de yine beraber festivale gidelim!Dialogue: 0,0:11:45.76,0:11:46.38,Main,,0,0,0,,Peki!Dialogue: 0,0:11:49.70,0:11:52.67,Main,,0,0,0,,Lammy, azıcık orada bekle.Dialogue: 0,0:11:52.67,0:11:53.48,Main,,0,0,0,,Peki...Dialogue: 0,0:11:57.64,0:11:59.58,Main,,0,0,0,,İki hastalıklı kişiden kurtulduk!Dialogue: 0,0:12:16.34,0:12:17.68,Flashbacks,,0,0,0,,Law!Dialogue: 0,0:12:17.93,0:12:20.85,Flashbacks,,0,0,0,,Law, festivale gidiyoruz!Dialogue: 0,0:12:25.26,0:12:27.48,Main,,0,0,0,,Anne!Dialogue: 0,0:12:27.48,0:12:30.56,Main,,0,0,0,,Baba!Dialogue: 0,0:12:49.60,0:12:51.43,Flashbacks,,0,0,0,,Dinle, Law-kun. Dialogue: 0,0:12:51.43,0:12:54.32,Flashbacks,,0,0,0,,Her zaman umut vardır.Dialogue: 0,0:12:55.06,0:12:57.32,Flashbacks,,0,0,0,,Merhamet dolu bir yardım eli...Dialogue: 0,0:12:57.76,0:13:00.39,Flashbacks,,0,0,0,,...aynı bu şekilde sana da ulaşacak.Dialogue: 0,0:13:03.16,0:13:06.33,Main,,0,0,0,,Rahibe!Dialogue: 0,0:13:06.33,0:13:08.47,Main,,0,0,0,,Millet!Dialogue: 0,0:13:10.62,0:13:12.22,Flashbacks,,0,0,0,,Gidelim işte!Dialogue: 0,0:13:12.22,0:13:15.56,Flashbacks,,0,0,0,,Ne olursa olsun yaşayacağım!Dialogue: 0,0:13:17.94,0:13:19.94,Main,,0,0,0,,Hastane...Dialogue: 0,0:13:23.58,0:13:26.28,Main,,0,0,0,,Lammy!Dialogue: 0,0:13:31.56,0:13:36.24,Main,,0,0,0,,Beyaz Şehir Flevance yok oldu.Dialogue: 0,0:13:40.37,0:13:44.10,Main,,0,0,0,,Sonu insanların elinden oldu.Dialogue: 0,0:13:44.10,0:13:48.40,Main,,0,0,0,,On yaşında biri bunları yaşadıktan sonra...Dialogue: 0,0:13:49.60,0:13:53.58,Main,,0,0,0,,Kişiliği de mahvoluyor tabii.Dialogue: 0,0:13:57.18,0:13:59.08,Thoughts,,0,0,0,,Buldum seni, Corazon!Dialogue: 0,0:13:59.70,0:14:03.99,Thoughts,,0,0,0,,Ailem, kız kardeşim, kilisedeki herkes ölürken...Dialogue: 0,0:14:03.99,0:14:06.90,Thoughts,,0,0,0,,...böyle bir gerzeğin yaşaması hiç adil değil!Dialogue: 0,0:14:07.32,0:14:09.21,Thoughts,,0,0,0,,Çenemi kapalı tutarsam bir şey olmaz.Dialogue: 0,0:14:09.21,0:14:15.02,Thoughts,,0,0,0,,Aşağılığın teki yok olup gitse bile kimsenin umrunda olmaz!Dialogue: 0,0:14:24.94,0:14:27.15,Thoughts,,0,0,0,,Lanet olsun! Gördü beni!Dialogue: 0,0:14:27.60,0:14:32.44,Main,,0,0,0,,Ka-Kan Kuralı'nı çiğnedi!Dialogue: 0,0:14:32.44,0:14:34.54,Main,,0,0,0,,Hakkı hazığa oturtulmaktır-dasuyan!Dialogue: 0,0:14:34.54,0:14:37.84,Main,,0,0,0,,Genç Bey'e haber vermem lazım-dasuyan!Dialogue: 0,0:14:44.16,0:14:46.53,Flashbacks,,0,0,0,,Tenryuubito ailesi!Dialogue: 0,0:14:49.58,0:14:51.74,Flashbacks,,0,0,0,,Öldürün!Dialogue: 0,0:14:54.51,0:14:56.75,Flashbacks,,0,0,0,,Eski Tenryuubito ailesi!Dialogue: 0,0:14:56.75,0:14:58.68,Main,,0,0,0,,Onları öldürsek bile donanma hiçbir şey yapmayacak!Dialogue: 0,0:14:58.68,0:15:00.55,Main,,0,0,0,,Amiraller gelmeyecek!Dialogue: 0,0:15:00.75,0:15:04.21,Main,,0,0,0,,Şükürler olsun, sonunda öcümü alabileceğim!Dialogue: 0,0:15:04.21,0:15:06.62,Main,,0,0,0,,Olanlara sessizce katlanmaktan bıkmıştım!Dialogue: 0,0:15:06.62,0:15:08.98,Main,,0,0,0,,Çekiçle tüm kemiklerini kıralım!Dialogue: 0,0:15:08.98,0:15:11.24,Main,,0,0,0,,Bin ok atalım!Dialogue: 0,0:15:11.24,0:15:13.86,Main,,0,0,0,,Olmaz, çabucak ölmesinler!Dialogue: 0,0:15:13.86,0:15:17.70,Main,,0,0,0,,Olabildiğince canlı tutup acı çekmelerini sağlayalım!Dialogue: 0,0:15:18.60,0:15:20.53,Main,,0,0,0,,Bana bakın!Dialogue: 0,0:15:20.75,0:15:24.68,Main,,0,0,0,,Beş ve iki yaşlarındaki oğullarım...Dialogue: 0,0:15:25.02,0:15:28.54,Main,,0,0,0,,...sırt Tenryuubitolar'ın yoluna çıktılar diye...Dialogue: 0,0:15:28.54,0:15:33.03,Main,,0,0,0,,Sırf bu yüzden öldürüldüler!Dialogue: 0,0:15:33.03,0:15:37.02,Main,,0,0,0,,Köleleştirdiğiniz kızım korkunç bir halde eve dönüp...Dialogue: 0,0:15:37.02,0:15:40.76,Main,,0,0,0,,...tek bir söz bile söylemeden üçüncü günün sonunda canına kıydı!Dialogue: 0,0:15:42.92,0:15:48.08,Main,,0,0,0,,Beni de köleniz yaptınız! Bu gözlerim...Dialogue: 0,0:15:48.08,0:15:51.18,Main,,0,0,0,,Siz lanet olasıcalar yüzünden...Dialogue: 0,0:15:51.18,0:15:53.27,Main,,0,0,0,,Karımı geri verin!Dialogue: 0,0:15:53.27,0:15:57.53,Main,,0,0,0,,Bize ne olduğu, hayatlarımız umrunuzda değil!Dialogue: 0,0:15:57.53,0:16:00.72,Main,,0,0,0,,Size ödediğimiz Cennet Harcı yüzünden...Dialogue: 0,0:16:00.72,0:16:03.24,Main,,0,0,0,,...ülkem kıtlığa yenik düşüp yok oldu!Dialogue: 0,0:16:03.24,0:16:06.28,Main,,0,0,0,,Açlık nedir bilir misiniz?!Dialogue: 0,0:16:06.28,0:16:09.35,Main,,0,0,0,,Herkes bir deri bir kemik kalıp öldü!Dialogue: 0,0:16:09.35,0:16:11.85,Main,,0,0,0,,Nasılsa tanrı değil misiniz!?Dialogue: 0,0:16:11.85,0:16:13.89,Main,,0,0,0,,İnsanlardan farklısınız!Dialogue: 0,0:16:13.89,0:16:16.09,Main,,0,0,0,,Eminim bundan ölmezsiniz de!Dialogue: 0,0:16:18.58,0:16:19.62,Main,,0,0,0,,Doffy!Dialogue: 0,0:16:19.62,0:16:20.40,Main,,0,0,0,,Ağabey!Dialogue: 0,0:16:21.90,0:16:23.06,Main,,0,0,0,,Lanet olsun!Dialogue: 0,0:16:24.12,0:16:25.66,Main,,0,0,0,,İnsanları ne hakla...Dialogue: 0,0:16:26.10,0:16:28.73,Main,,0,0,0,,...böcekten bile değersiz tutarsınız?!Dialogue: 0,0:16:29.28,0:16:34.52,Main,,0,0,0,,Acı çekmenin, kederin, ızdırabın ne demek olduğunu bilir misiniz?!Dialogue: 0,0:16:34.52,0:16:36.92,Main,,0,0,0,,Size soruyorum Tenryuubitolar!Dialogue: 0,0:17:11.94,0:17:13.22,Main,,0,0,0,,Ne var?Dialogue: 0,0:17:18.97,0:17:23.25,Captions,,0,0,0,,Marijoa Kutsal Topraklar, 33 yıl önceDialogue: 0,0:17:25.06,0:17:27.48,Main,,0,0,0,,Ciddi misiniz, Aziz Homing?!Dialogue: 0,0:17:27.48,0:17:29.53,Main,,0,0,0,,Böyle bir şey yapacağınız aklımdan geçmezdi!Dialogue: 0,0:17:29.53,0:17:33.30,Main,,0,0,0,,Tanrı rütbenizi ardınızda bırakıp insan mı olacaksınız?!Dialogue: 0,0:17:33.30,0:17:36.60,Captions,,0,0,0,,Dünya Asilzadesi (Tenryuubito) Aziz Donquixote HomingDialogue: 0,0:17:33.82,0:17:36.60,Main,,0,0,3,,Doğduğum andan beri insanım zaten.Dialogue: 0,0:17:36.60,0:17:39.48,Main,,0,0,0,,Bizim de mi insan olduğumuzu ima ediyorsun, ey?!Dialogue: 0,0:17:39.48,0:17:40.76,Main,,0,0,0,,Kutsala hakaret bu!Dialogue: 0,0:17:40.76,0:17:42.94,Main,,0,0,0,,Tenryuubitolar'ın ne olduğunu sanıyorsun sen?!Dialogue: 0,0:17:42.94,0:17:47.04,Main,,0,0,0,,Seni hain! Kâfirlik içinde vardı zaten!Dialogue: 0,0:17:47.04,0:17:48.81,Main,,0,0,0,,Aynen öyle, hain seni!Dialogue: 0,0:17:48.81,0:17:50.46,Main,,0,0,0,,Küstahlık bu, ey!Dialogue: 0,0:17:50.46,0:17:52.86,Main,,0,0,0,,Marijoa'dan defolun!Dialogue: 0,0:17:55.26,0:17:58.38,Main,,0,0,0,,Sizi buradan öte götüremeyiz.Dialogue: 0,0:17:58.72,0:18:01.05,Main,,0,0,0,,Kuzey Sonu'na geldik.Dialogue: 0,0:18:01.05,0:18:03.16,Main,,0,0,0,,Dünya Hükümeti'ne üye olmayan bir ulus.Dialogue: 0,0:18:03.86,0:18:07.15,Main,,0,0,0,,Uygun ev ve eşyalar sizin için hazırlandı.Dialogue: 0,0:18:07.15,0:18:09.32,Main,,0,0,0,,Teşekkür ederiz. Bu kadarı âlâ.Dialogue: 0,0:18:09.32,0:18:12.54,Main,,0,0,0,,Öyleyse Tenryuubito kimlik çiplerinizi alayım.Dialogue: 0,0:18:15.40,0:18:19.61,Main,,0,0,0,,Dördümüz, mütevazi bir hayat sürelim.Dialogue: 0,0:18:20.76,0:18:23.35,Main,,0,0,0,,Baba, köleler nerede ey?Dialogue: 0,0:18:23.35,0:18:25.51,Main,,0,0,0,,Eşyaları kölelere taşıtalım ey.Dialogue: 0,0:18:27.92,0:18:30.36,Main,,0,0,0,,Doffy, Rochinante.Dialogue: 0,0:18:30.36,0:18:33.38,Main,,0,0,0,,Size her şeyi en baştan öğretmemiz gerekecek.Dialogue: 0,0:18:37.13,0:18:41.81,Main,,0,0,0,,Doffy, bundan böyle insan olarak yaşayacağız.Dialogue: 0,0:18:41.81,0:18:43.07,Main,,0,0,0,,İnsan mı?Dialogue: 0,0:18:43.07,0:18:47.07,Main,,0,0,0,,Marijoa'dan çok daha zengin bir hayat süreceğiz.Dialogue: 0,0:18:47.26,0:18:51.17,Main,,0,0,0,,Bahsettiğim zenginlik eşyalarla sahip olunan türden değil.Dialogue: 0,0:18:51.17,0:18:52.94,Main,,0,0,0,,Kalbin zenginliğinden bahsediyorum.Dialogue: 0,0:18:55.18,0:18:56.48,Main,,0,0,0,,Hey!Dialogue: 0,0:18:56.69,0:18:58.90,Main,,0,0,0,,Neden diz çökmüyorsunuz?!Dialogue: 0,0:18:58.90,0:19:00.63,Main,,0,0,0,,Saygısız pislikler!Dialogue: 0,0:19:00.63,0:19:02.72,Main,,0,0,0,,Ne cüretle önümden geçersiniz!?Dialogue: 0,0:19:02.72,0:19:04.82,Main,,0,0,0,,Birileri tabanca getirsin!Dialogue: 0,0:19:05.05,0:19:07.46,Main,,0,0,0,,Kim olduğumu biliyor musunuz siz?!Dialogue: 0,0:19:09.34,0:19:11.55,Main,,0,0,0,,Tenryuubitolar nerede?!Dialogue: 0,0:19:11.55,0:19:12.81,Main,,0,0,0,,Bulalım onları!Dialogue: 0,0:19:12.81,0:19:14.18,Main,,0,0,0,,Asalım!Dialogue: 0,0:19:14.18,0:19:18.32,Main,,0,0,0,,Baba, neden diz çökmüyorlar ey?!Dialogue: 0,0:19:18.32,0:19:20.43,Main,,0,0,0,,İçeride yoklar! Kaçmışlar!Dialogue: 0,0:19:20.43,0:19:23.07,Main,,0,0,0,,Bulun!  Fazla uzaklaşmış olamazlar!Dialogue: 0,0:19:23.07,0:19:26.02,Main,,0,0,0,,Öldürmeyin sakın!  Acı çektirelim!Dialogue: 0,0:19:26.02,0:19:27.42,Main,,0,0,0,,Evet!Dialogue: 0,0:19:27.42,0:19:31.64,Main,,0,0,0,,Yüzyılların acısını o aileden çıkartacağız!Dialogue: 0,0:19:31.64,0:19:33.82,Main,,0,0,0,,Evet!Dialogue: 0,0:19:40.82,0:19:41.93,Main,,0,0,0,,Doffy!Dialogue: 0,0:19:45.66,0:19:50.10,Main,,0,0,0,,Baba, neden peşimizdeler ey?!Dialogue: 0,0:19:55.02,0:19:58.29,Main,,0,0,0,,En azından yağmurdan kurtulduğumuza şükretmeliyiz.Dialogue: 0,0:19:58.29,0:20:02.21,Main,,0,0,0,,Bu civardaki insanlar bizi henüz duymamışlar.Dialogue: 0,0:20:02.21,0:20:05.48,Main,,0,0,0,,Böyle pis bir yerde nasıl yaşarım?!Dialogue: 0,0:20:05.48,0:20:09.75,Main,,0,0,0,,Her tarafta böcekler var ve koku midemi bulandırıyor ey!Dialogue: 0,0:20:13.10,0:20:15.15,Main,,0,0,0,,Aileyi bulun!Dialogue: 0,0:20:15.15,0:20:16.82,Main,,0,0,0,,Buralarda olmalılar!Dialogue: 0,0:20:18.26,0:20:20.26,Main,,0,0,0,,Onları bulur bulmaz öldürün!Dialogue: 0,0:20:21.34,0:20:23.38,Main,,0,0,0,,Kaçmamız lazım. Hemen!Dialogue: 0,0:20:30.48,0:20:33.48,Main,,0,0,0,,İşlerin bu denli kötü olmasını beklemiyordum.Dialogue: 0,0:20:34.02,0:20:38.22,Main,,0,0,0,,Fazla iyimser düşündüm. Yalvarıyorum, ne isterseniz yaparım!Dialogue: 0,0:20:38.22,0:20:43.40,Main,,0,0,0,,Karımı ve çocuklarımı kabul etseniz yeter. Lütfen onları Marijoa'ya geri alın!Dialogue: 0,0:20:43.69,0:20:47.23,Main,,0,0,0,,Burada kalırsak hepimiz öldürüleceğiz!Dialogue: 0,0:20:47.40,0:20:49.91,Main,,0,0,0,,O hayatı kendin seçtin ey.Dialogue: 0,0:20:49.91,0:20:51.66,Main,,0,0,0,,Ardında bıraktığın bir şeyi geri alamazsın.Dialogue: 0,0:20:51.66,0:20:55.83,Main,,0,0,0,,Bir daha da arama! Alçak insan seni!Dialogue: 0,0:21:02.11,0:21:04.17,Main,,0,0,0,,Ekmek hırsızları sizi!Dialogue: 0,0:21:08.98,0:21:13.93,Flashbacks,,0,0,0,,Baba!  Hayatımda ilk kez acı çekiyorum ey!Dialogue: 0,0:21:19.60,0:21:20.90,Thoughts,,0,0,0,,Baba!Dialogue: 0,0:21:21.58,0:21:25.45,Thoughts,,0,0,0,,Hayatımda ilk kez acıktım ey!Dialogue: 0,0:21:30.78,0:21:32.40,Main,,0,0,0,,Çabuk ye, Rocy!Dialogue: 0,0:21:33.44,0:21:34.58,Main,,0,0,0,,Birileri görecek şimdi!Dialogue: 0,0:21:36.96,0:21:38.92,Main,,0,0,0,,Anne, yiyecek getirdik ey!Dialogue: 0,0:21:39.26,0:21:41.15,Main,,0,0,0,,Doffy. Rocy.Dialogue: 0,0:21:42.46,0:21:43.28,Main,,0,0,0,,Anne!Dialogue: 0,0:21:44.24,0:21:46.34,Main,,0,0,0,,Özür dilerim... Kendimi pek...Dialogue: 0,0:21:47.02,0:21:48.41,Main,,0,0,0,,...iyi...Dialogue: 0,0:21:54.32,0:21:55.83,Thoughts,,0,0,0,,Baba...Dialogue: 0,0:21:56.76,0:22:00.30,Thoughts,,0,0,0,,Annem öldü ey!Dialogue: 0,0:22:02.26,0:22:04.60,Main,,0,0,0,,Yakaladık!Dialogue: 0,0:22:04.80,0:22:09.57,Main,,0,0,0,,Canımı alın ama oğullarımı bağışlayın!Dialogue: 0,0:22:11.64,0:22:13.82,Main,,0,0,0,,Yalvarıyorum! Yalvarıyorum!Dialogue: 0,0:22:16.36,0:22:18.29,Thoughts,,0,0,0,,Baba!Dialogue: 0,0:22:18.29,0:22:20.05,Thoughts,,0,0,0,,Senin yüzünden...Dialogue: 0,0:22:20.72,0:22:25.08,Thoughts,,0,0,0,,...şu düştüğümüz hale bak ey!Dialogue: 0,0:22:29.00,0:22:32.58,Main,,0,0,0,,Genç Bey'im, Law'u yakaladık!Dialogue: 0,0:22:32.98,0:22:36.56,Main,,0,0,0,,Birden kaçmaya karar vermiş anlaşılan.Dialogue: 0,0:22:36.56,0:22:38.51,Main,,0,0,0,,Lanet olsun, bırakın beni!Dialogue: 0,0:22:39.50,0:22:42.16,Main,,0,0,0,,Limana varmıştı bile-in.Dialogue: 0,0:22:42.16,0:22:45.56,Main,,0,0,0,,Cora-san'ı bıçakladığı için ona işkence yapacaklar şimdi-dasuyan!Dialogue: 0,0:22:45.56,0:22:47.66,Main,,0,0,0,,Zavallı Law, onca şey yaşamasına rağmen...Dialogue: 0,0:22:52.42,0:22:53.59,Thoughts,,0,0,0,,Corazon!Dialogue: 0,0:22:55.12,0:22:58.22,Thoughts,,0,0,0,,Kahretsin, ölmemiş!Dialogue: 0,0:22:58.22,0:23:00.96,Thoughts,,0,0,0,,Boş yere mi öleceğim şimdi?!Dialogue: 0,0:23:00.96,0:23:03.88,Thoughts,,0,0,0,,Buffalo'ya dondurma alıp onu susturmuştum ama...Dialogue: 0,0:23:03.88,0:23:06.84,Thoughts,,0,0,0,,...demek Doflamingo'ya kendi söylemiş!Dialogue: 0,0:23:06.84,0:23:09.90,Thoughts,,0,0,0,,Bıçağın vücuduna saplandığına eminim!Dialogue: 0,0:23:10.72,0:23:13.20,Thoughts,,0,0,0,,Nasıl böyle hiçbir şey olmamış gibi davranabilir?!Dialogue: 0,0:23:14.22,0:23:15.44,Main,,0,0,0,,Law...Dialogue: 0,0:23:16.04,0:23:19.79,Main,,0,0,0,,Seni buraya tek bir şey için çağırdım.Dialogue: 0,0:23:19.79,0:23:25.28,Main,,0,0,0,,Seni resmi olarak Don Quixote Ailesi'ne kabul etmeye karar verdim.Dialogue: 0,0:23:27.58,0:23:29.35,Main,,0,0,0,,Aile-in!Dialogue: 0,0:23:33.72,0:23:37.16,Main,,0,0,0,,Yaşadığın korkunç şeyler yüzünden sahip olduğun...Dialogue: 0,0:23:37.16,0:23:41.19,Main,,0,0,0,,...gözlerindeki o eşi bulunmaz, nefret dolu bakışın...Dialogue: 0,0:23:43.42,0:23:45.97,Main,,0,0,0,,Gereken şey sende mevcut.Dialogue: 0,0:23:47.97,0:23:50.57,Main,,0,0,0,,Sende umut ışığı görüyor!Dialogue: 0,0:23:50.57,0:23:53.44,Main,,0,0,0,,Genç Bey'imiz ileri görüşlü biridir!Dialogue: 0,0:23:54.20,0:23:57.54,Thoughts,,0,0,0,,Corazon'a ne yaptığımı hâlâ bilmiyor mu?Dialogue: 0,0:23:57.54,0:24:01.86,Thoughts,,0,0,0,,Neden?  İstese yazarak da olsa söyleyebilir...Dialogue: 0,0:24:02.36,0:24:04.44,Thoughts,,0,0,0,,Neyin peşinde?Dialogue: 0,0:24:07.22,0:24:12.72,Main,,0,0,0,,İleri görüşlü olsa ne yazar, üç sene içinde nasıl olsa öleceğim!Dialogue: 0,0:24:14.62,0:24:17.30,Main,,0,0,0,,Orası şansına bağlı.Dialogue: 0,0:24:17.30,0:24:17.97,Main,,0,0,0,,Şans mı?Dialogue: 0,0:24:18.80,0:24:22.50,Main,,0,0,0,,Karaborsa bizim işimiz.Dialogue: 0,0:24:22.50,0:24:25.12,Main,,0,0,0,,Elimizden Şeytan Meyveleri de geçiyor.Dialogue: 0,0:24:25.12,0:24:29.12,Main,,0,0,0,,Ve bazı meyveler insan aklının ötesinde güçlere sahip.Dialogue: 0,0:24:29.12,0:24:32.75,Main,,0,0,0,,Hastalığını iyileştirecek güce sahip olanlarına denk gelebiliriz.Dialogue: 0,0:24:32.75,0:24:34.32,Main,,0,0,0,,Şeytan Meyvesi mi?Dialogue: 0,0:24:34.32,0:24:37.56,Main,,0,0,0,,Şanslıysan...Dialogue: 0,0:24:37.56,0:24:44.08,Main,,0,0,0,,...ömrünün kalan üç yılında denk geleceğimiz bir Şeytan Meyvesi...Dialogue: 0,0:24:44.08,0:24:50.40,Main,,0,0,0,,Önümüzdeki 10 yıl seni sağ kolum olacak şekilde yetiştireceğim.Dialogue: 0,0:24:53.66,0:24:54.51,Main,,0,0,0,,Ne oldu?Dialogue: 0,0:24:56.36,0:24:58.84,Captions,,0,400,200,,DüşmanDialogue: 0,0:24:59.56,0:25:01.21,Main,,0,0,0,,Hakladılar demek?Dialogue: 0,0:25:01.21,0:25:03.01,Main,,0,0,0,,İşlerini bitirdin mi?!Dialogue: 0,0:25:03.56,0:25:06.15,Captions,,0,450,130,,BitirdimDialogue: 0,0:25:06.15,0:25:08.76,Main,,0,0,0,,İyi öyleyse. Tedavi ettirmeyi unutma.Dialogue: 0,0:25:08.76,0:25:12.14,Thoughts,,0,0,0,,Beni niye korudu?!Dialogue: 0,0:25:14.38,0:25:17.07,Thoughts,,0,0,0,,Ne yapmaya çalışıyor bu?!Dialogue: 0,0:25:19.66,0:25:23.72,Main,,0,0,0,,Merkezimizi güneydoğudaki Reverse Mountain'e doğru kaydırıp...Dialogue: 0,0:25:23.72,0:25:25.78,Main,,0,0,0,,...işi büyüteceğiz.Dialogue: 0,0:26:42.04,0:26:45.94,Main,,0,0,0,,2 yıl sonraDialogue: 0,0:26:42.04,0:26:45.94,Main,,0,0,0,,2 yıl sonraDialogue: 0,0:26:43.26,0:26:46.04,Main,,0,0,0,,Gerçek adlarımızı söyledik sana!Dialogue: 0,0:26:46.52,0:26:49.04,Main,,0,0,0,,Pek umrumda değil.Dialogue: 0,0:26:49.04,0:26:51.68,Main,,0,0,0,,Çok sıkıcısın! Hiç eğlenceli değil!Dialogue: 0,0:26:51.68,0:26:54.46,Main,,0,0,0,,Eğlensem de eğlenmesem de öleceğim sonuçta.Dialogue: 0,0:26:55.02,0:26:56.93,Main,,0,0,0,,Beyazlıklar epey artmış.Dialogue: 0,0:26:57.56,0:26:59.52,Main,,0,0,0,,Bir yıl daha yaşar mıyım bilinmez...Dialogue: 0,0:27:00.62,0:27:04.54,Main,,0,0,0,,Düşündüğümden daha erken ölebilirim.Dialogue: 0,0:27:04.88,0:27:08.67,Main,,0,0,0,,Onu boşver de, gerçek adın varsa söyle-dasuyan!Dialogue: 0,0:27:08.67,0:27:12.18,Main,,0,0,0,,Yoksa iki yıl önce Cora-san'ı bıçakladığını Genç Bey'e söyleriz!Dialogue: 0,0:27:17.04,0:27:20.52,Main,,0,0,0,,Trafalgar D. Water Law.Dialogue: 0,0:27:22.00,0:27:25.86,Main,,0,0,0,,Normalde bu ismi kimseye söylememem lazım.Dialogue: 0,0:27:26.30,0:27:31.49,Main,,0,0,0,,Benim sizin gibi kodadım yok, yani adım pek değişmiyor aslında.Dialogue: 0,0:27:31.49,0:27:35.10,Main,,0,0,0,,"D." gizli adım, "Water"sa gerçek adım.Dialogue: 0,0:27:35.10,0:27:36.66,Main,,0,0,0,,Ailem nesiller boyunca...Dialogue: 0,0:27:36.66,0:27:39.16,Main,,0,0,0,,Bu muydu yahu?!  Hiç eğlenceli değilmiş!Dialogue: 0,0:27:39.16,0:27:40.24,Main,,0,0,0,,Öyle-dasuyan.Dialogue: 0,0:27:40.24,0:27:42.81,Main,,0,0,0,,Niye soruyorsunuz o zaman?!Dialogue: 0,0:27:46.52,0:27:47.78,Main,,0,0,0,,Bırak beni!Dialogue: 0,0:27:47.78,0:27:51.12,Main,,0,0,0,,Ne var Corazon?! Ne istiyorsun!?Dialogue: 0,0:27:51.12,0:27:54.06,Main,,0,0,0,,Gene dayak yiyecek.Dialogue: 0,0:27:54.06,0:27:57.19,Main,,0,0,0,,Cora-san her zamankindan daha korkunç görünüyordu.Dialogue: 0,0:28:03.54,0:28:06.63,Main,,0,0,0,,Ne istiyorsun be, Corazon?! Kavga mı?!Dialogue: 0,0:28:06.63,0:28:09.84,Main,,0,0,0,,Az önce söylediklerin doğru mu?Dialogue: 0,0:28:09.84,0:28:10.45,Main,,0,0,0,,Ne?Dialogue: 0,0:28:10.77,0:28:13.97,Main,,0,0,0,,Kim var orada?!Dialogue: 0,0:28:13.97,0:28:15.67,Main,,0,0,0,,Gizli adın olan "D" den bahsediyorum.Dialogue: 0,0:28:16.64,0:28:19.76,Main,,0,0,0,,Eğer doğruysa git buradan.Dialogue: 0,0:28:19.76,0:28:21.58,Main,,0,0,0,,Doffy'den uzaklaş!Dialogue: 0,0:28:23.16,0:28:28.58,Main,,0,0,0,,Law, onun yakınlarında olmaması gereken birisin!Dialogue: 0,0:28:32.19,0:28:34.40,OP11 Credits,,0,0,0,,Editing: Galaxy 9000  Timing: Datenshi  QC: Mr. Luffy  Soundtracking: Halee  TC/Infoboxes: Datenshi  Original Translation: Yibis