Dialogue: 0,0:01:42.60,0:01:45.00,Title,,0,0,250,,{\fad(800,800)}Russian'a Sevgilerle
Dialogue: 0,0:01:47.87,0:01:51.71,Main,,0,0,0,,Canımı sıkıyorsun ama, Nico Robin!
Dialogue: 0,0:01:52.68,0:01:55.66,Main,,0,0,0,,Rakiplerinin biraz fazla dezavantajlı\Nolduklarını düşünmüyor musun?
Dialogue: 0,0:01:55.66,0:01:56.55,Main,,0,0,0,,Dezavantaj mı?
Dialogue: 0,0:01:56.55,0:02:02.68,Main,,0,0,0,,Bunu adil bir müsabaka\Nfalan mı sanıyorsun?
Dialogue: 0,0:02:03.73,0:02:06.68,Main,,0,0,0,,Onları idam etmek için\Nburadayım, Nico Robin!
Dialogue: 0,0:02:08.73,0:02:10.98,Main,,0,0,0,,Tam tersi olmasın o?
Dialogue: 0,0:02:14.73,0:02:18.74,Main,,0,0,0,,Komutan-san, Rebecca için\Ntetikte olmana gerek yok!
Dialogue: 0,0:02:18.74,0:02:21.45,Main,,0,0,0,,Onun yanında ben varım artık.
Dialogue: 0,0:02:22.69,0:02:24.71,Main,,0,0,0,,Sağ olasın!\NBorcun ödenmez!
Dialogue: 0,0:02:24.71,0:02:26.66,Main,,0,0,0,,Öfkeden kudurmama...
Dialogue: 0,0:02:27.74,0:02:29.37,Main,,0,0,0,,...ramak kalmıştı!
Dialogue: 0,0:02:31.15,0:02:35.05,Captions,,0,0,330,,{\fad(300,300)}Kralın Platosu\N3. Seviye
Dialogue: 0,0:02:38.63,0:02:40.30,Main,,0,0,0,,Ne yapıyorsunuz siz be?!
Dialogue: 0,0:02:42.70,0:02:44.68,Main,,0,0,0,,Acı bize!
Dialogue: 0,0:02:44.68,0:02:49.06,Main,,0,0,0,,Düşmüş bir dostumuzun\Ncesedini taşıyorduk! İzin ver gidelim!
Dialogue: 0,0:02:49.69,0:02:52.48,Main,,0,0,0,,Ölmedi ki o!
Dialogue: 0,0:02:52.48,0:02:53.72,Main,,0,0,0,,Öyle.
Dialogue: 0,0:02:53.72,0:02:59.03,Main,,0,0,0,,Fakat kendine gelene dek, birkaç gün,\Nen azından yaralarını sarmak istiyoruz!
Dialogue: 0,0:02:59.03,0:03:01.57,Main,,0,0,0,,Yalvarıyorum! \NSavaşçı misali merhamet et bize!
Dialogue: 0,0:03:01.57,0:03:03.53,Main,,0,0,0,,Yalvarıyoruz!\NMerhamet!
Dialogue: 0,0:03:03.53,0:03:04.74,Main,,0,0,0,,Yalvarıyoruz!
Dialogue: 0,0:03:05.75,0:03:08.37,Main,,0,0,0,,Tamam ya, kaybolun gözümün önünden!
Dialogue: 0,0:03:08.37,0:03:10.24,Main,,0,0,0,,Çok teşekkür ederiz!
Dialogue: 0,0:03:14.72,0:03:15.49,Main,,0,0,0,,Cidden var ya...
Dialogue: 0,0:03:15.49,0:03:20.07,Captions,,0,0,170,,{\fad(300,0)}GÜLÜCÜK Fabrikası
Dialogue: 0,0:03:16.26,0:03:19.49,Main,,0,0,1,,Ay Senyor!
Dialogue: 0,0:03:20.05,0:03:22.02,Main,,0,0,0,,Bağlandı!
Dialogue: 0,0:03:23.03,0:03:26.50,Main,,0,0,0,,Viola-sama, fabrika takımı konuşuyor!
Dialogue: 0,0:03:26.50,0:03:29.02,Main,,0,0,0,,Prenses Mansherry ve Leo'ların\Ndurumları nedir?!
Dialogue: 0,0:03:30.17,0:03:35.06,Main,,0,0,0,,Umarım iyi kalpli, alçakgönüllü\Nprensesimizin bir şeyi yoktur!
Dialogue: 0,0:03:35.06,0:03:36.98,Main,,0,0,0,,Endişeden öleceğim...
Dialogue: 0,0:03:36.98,0:03:41.04,Main,,0,0,0,,İşler çok kötü bir hâl almak üzere...
Dialogue: 0,0:03:41.04,0:03:41.82,Main,,0,0,0,,{\i1}Kötü mü?!{\i0}
Dialogue: 0,0:03:41.82,0:03:46.58,Main,,0,0,0,,{\i1}Bekleyin biraz, Leo'yu arayacağım.\NKapatmayın!{\i0}
Dialogue: 0,0:03:46.65,0:03:48.95,Captions,,0,0,320,,{\fad(300,300)}Eski Kralın Platosu
Dialogue: 0,0:03:47.59,0:03:49.56,Main,,0,0,660,,Leo, duyabiliyor musun?
Dialogue: 0,0:03:49.56,0:03:51.12,Main,,0,0,0,,Viola-sama!
Dialogue: 0,0:03:51.12,0:03:54.33,Main,,0,0,0,,{\i1}Siper Kulesi'ne varmak üzereyiz!{\i0}
Dialogue: 0,0:03:54.33,0:03:57.47,Main,,0,0,0,,Çok yakında saraydaki şapele\Nvarmış olacağız!
Dialogue: 0,0:03:57.47,0:03:59.57,Main,,0,0,0,,Leo, hızlanmanız lazım!
Dialogue: 0,0:03:59.57,0:04:04.14,Main,,0,0,0,,Mansherry Giolla'nın elinde\Nve gücünü kullanmaya zorlanıyor!
Dialogue: 0,0:04:04.65,0:04:07.68,Main,,0,0,0,,Ne?! Bu çok kötü bir haber!
Dialogue: 0,0:04:07.68,0:04:09.82,Main,,0,0,1,,Eyvah!\NAcele et, Leo!
Dialogue: 0,0:04:09.56,0:04:14.04,Captions,,0,0,170,,{\fad(300,0)}Kule Duvarı Sarayın Altı
Dialogue: 0,0:04:09.82,0:04:11.70,Main,,0,0,1,,Küçük insanlar, gördüm onları!
Dialogue: 0,0:04:11.70,0:04:14.02,Main,,0,0,1,,Yukarı geliyorlar!
Dialogue: 0,0:04:14.02,0:04:15.73,Main,,0,0,1,,Vurun şunları!
Dialogue: 0,0:04:14.22,0:04:17.67,Captions,,0,0,170,,{\fad(300,0)}Saraya Çıkan Merdivenler
Dialogue: 0,0:04:18.22,0:04:21.32,Main,,0,0,0,,Bomba getirin! Merdivenlerle beraber\Nhavaya uçuracağım onları!
Dialogue: 0,0:04:26.93,0:04:28.66,Main,,0,0,0,,Oraya çabucak varacağız!
Dialogue: 0,0:04:28.66,0:04:33.04,Main,,0,0,0,,Biraz daha dayan, Prenses Mansherry!
Dialogue: 0,0:04:33.56,0:04:36.71,Main,,0,0,0,,Derhal işe koyul!
Dialogue: 0,0:04:36.76,0:04:38.60,Captions,,0,900,590,,{\fad(300,0)}İbadet Yerinin Arkası, Zemin Kat\N Ceza Odası
Dialogue: 0,0:04:36.71,0:04:38.59,Main,,0,0,0,,Küçük prenses!
Dialogue: 0,0:04:45.91,0:04:47.95,Main,,0,0,1,,Artık yapamıyorum...
Dialogue: 0,0:04:46.58,0:04:51.02,Captions,,0,0,240,,{\fad(300,0)}Tontatta Tonta Şefinin Kızı (Prenses)\NMansherry
Dialogue: 0,0:04:51.02,0:04:54.94,Main,,0,0,0,,Greenbit'e dönmeme izin verin lütfen!
Dialogue: 0,0:04:54.94,0:04:58.34,Main,,0,0,0,,Artık size yardım edemem!
Dialogue: 0,0:04:58.34,0:04:59.82,Main,,0,0,0,,Kapa çeneni!
Dialogue: 0,0:04:59.82,0:05:02.50,Main,,0,0,0,,Boa Hancock diye bana mı seslendin?!
Dialogue: 0,0:05:03.69,0:05:07.94,Main,,0,0,0,,Ağzımdan öyle bir kelime çıkmadı...
Dialogue: 0,0:05:09.00,0:05:10.91,Main,,0,0,0,,Çocuklaşma!
Dialogue: 0,0:05:10.91,0:05:14.96,Main,,0,0,0,,Güçlerini gösterme zamanın geldi!
Dialogue: 0,0:05:14.96,0:05:16.42,Main,,0,0,0,,Bak!
Dialogue: 0,0:05:16.42,0:05:18.52,Main,,0,0,0,,Yenilen yöneticilerimiz!
Dialogue: 0,0:05:24.45,0:05:28.26,Main,,0,0,0,,Yöneticilerimize karşı savaşanlarsa...
Dialogue: 0,0:05:29.35,0:05:33.31,Main,,0,0,0,,...kazanmış olmalarına rağmen\Nhepsi de ağır yaralı.
Dialogue: 0,0:05:34.77,0:05:41.23,Main,,0,0,0,,Chiyu Chiyu Meyvesi gücünle\Nyöneticilerimizi ayaklandırabilirsen...
Dialogue: 0,0:05:41.23,0:05:45.53,Main,,0,0,0,,...düşmanlarımızın yenilmekten başka\Nbir seçenekleri olmayacak!
Dialogue: 0,0:05:45.53,0:05:49.40,Main,,0,0,0,,Savaşın akışına\Nbüyük bir darbe olacak bu!
Dialogue: 0,0:05:52.44,0:05:53.42,Main,,0,0,0,,Haydi bakalım...
Dialogue: 0,0:05:53.42,0:05:58.58,Main,,0,0,0,,...Sugar'ı iyileştirdiğin gücünü\Nbir kez daha kullan!
Dialogue: 0,0:05:58.58,0:06:02.71,Main,,0,0,0,,Sihirli suyla dolu\NSulama Kabı'nı çıkar dışarı!
Dialogue: 0,0:06:02.71,0:06:05.06,Main,,0,0,0,,Hadi dedim! Hadi!
Dialogue: 0,0:06:05.06,0:06:07.09,Main,,0,0,0,,Hadi!
Dialogue: 0,0:06:11.63,0:06:13.68,Main,,0,0,0,,Biliyorum ben!
Dialogue: 0,0:06:15.06,0:06:20.73,Main,,0,0,0,,Siz Kral Riku-sama'ya bela olan\Nkötü insanlarsınız!
Dialogue: 0,0:06:21.03,0:06:26.13,Main,,0,0,0,,Kral Doflamingo bize yalan söylüyor.
Dialogue: 0,0:06:26.13,0:06:30.14,Main,,0,0,0,,Ne olmuş yani?!\NSiz kabilecek ne bilirsiniz ki?!
Dialogue: 0,0:06:30.14,0:06:37.14,Main,,0,0,0,,Artık kötü insanları\Niyileştirmek istemiyorum!
Dialogue: 0,0:06:39.21,0:06:39.83,Main,,0,0,0,,Ne--
Dialogue: 0,0:06:45.70,0:06:48.19,Main,,0,0,0,,{\i1}Ne şirin!{\i0}
Dialogue: 0,0:06:49.21,0:06:51.20,Main,,0,0,0,,Şirin!
Dialogue: 0,0:06:51.20,0:06:52.93,Main,,0,0,0,,Hemen eridiniz!
Dialogue: 0,0:06:54.83,0:06:58.68,Main,,0,0,0,,Kimmiş o milenyumluk güzel?!
Dialogue: 0,0:06:59.49,0:07:01.90,Main,,0,0,0,,Hadi!
Dialogue: 0,0:07:02.40,0:07:03.53,Main,,0,0,0,,{\i1}Yardım et!{\i0}
Dialogue: 0,0:07:04.94,0:07:06.50,Main,,0,0,0,,Demek...
Dialogue: 0,0:07:09.15,0:07:13.72,Main,,0,0,0,,...fabrikadaki arkadaşlarının\Nbaşına gelecekleri umursamıyorsun?!
Dialogue: 0,0:07:13.72,0:07:19.91,Main,,0,0,0,,İnsanlarınızı iyileştirirsem\Nyine birilerinin canını yakacaklar!
Dialogue: 0,0:07:20.23,0:07:21.53,Main,,0,0,0,,Küstah!
Dialogue: 0,0:07:21.53,0:07:25.46,Main,,0,0,0,,Ben içindeki gücü\Nortaya çıkartmasını bilirim!
Dialogue: 0,0:07:26.53,0:07:29.59,Main,,0,0,0,,{\i1}Kurtar beni, Leo!{\i0}
Dialogue: 0,0:07:31.60,0:07:32.47,Main,,0,0,0,,Tam isabet!
Dialogue: 0,0:07:33.76,0:07:35.01,Main,,0,0,0,,Kabu-san!
Dialogue: 0,0:07:35.01,0:07:38.47,Main,,0,0,0,,Kabu-san?! Leo!\NKabu-san'a ne oldu?!
Dialogue: 0,0:07:39.16,0:07:40.43,Main,,0,0,0,,Durma!
Dialogue: 0,0:07:40.43,0:07:42.30,Main,,0,0,0,,Devam et, Leo!
Dialogue: 0,0:07:42.30,0:07:44.83,Main,,0,0,0,,Ben sana yetişirim!   \NBir şeyim yok!
Dialogue: 0,0:07:50.04,0:07:53.05,Main,,0,0,0,,Acıyor!\NCanımı yakıyorsun!
Dialogue: 0,0:08:22.59,0:08:23.90,Main,,0,0,0,,Ne oldu bana?!
Dialogue: 0,0:08:23.90,0:08:25.35,Main,,0,0,0,,İyileşti!
Dialogue: 0,0:08:29.78,0:08:32.70,Main,,0,0,0,,Şimdi anlıyorum, küçük prenses.
Dialogue: 0,0:08:32.70,0:08:36.82,Main,,0,0,0,,Demek gözyaşlarınla da\Nyaraları iyileştirebiliyorsun!
Dialogue: 0,0:08:36.82,0:08:39.33,Main,,0,0,0,,Ağla hadi!
Dialogue: 0,0:08:41.50,0:08:43.46,Main,,0,0,0,,Hayır!
Dialogue: 0,0:08:44.00,0:08:47.88,Main,,0,0,0,,Hadi dedim!\Nİyileştirici gözyaşlarını dök!
Dialogue: 0,0:08:47.88,0:08:51.47,Main,,0,0,0,,Canım yanıyor!\NKurtar beni!
Dialogue: 0,0:08:54.30,0:08:56.05,Main,,0,0,0,,Leo, acele et!
Dialogue: 0,0:08:56.36,0:08:57.05,Main,,0,0,0,,Ediyorum!
Dialogue: 0,0:08:59.56,0:09:01.77,Main,,0,0,0,,Ne oldu, Viola?!
Dialogue: 0,0:09:01.77,0:09:05.52,Main,,0,0,0,,Giolla, Mansherry'nin gözyaşlarının\Niyileştirici özellikte olduğunu fark etti!
Dialogue: 0,0:09:05.52,0:09:06.02,Main,,0,0,0,,{\i1}Ne?!{\i0}
Dialogue: 0,0:09:06.51,0:09:10.48,Main,,0,0,0,,{\i1}Şimdi de ağlasın diye onu dövüyor!{\i0}
Dialogue: 0,0:09:10.48,0:09:11.44,Main,,0,0,0,,Ne?!
Dialogue: 0,0:09:11.44,0:09:14.52,Main,,0,0,0,,Prenses!
Dialogue: 0,0:09:14.52,0:09:18.12,Main,,0,0,0,,Ben Mouji, seni kurtarmaya geliyorum!
Dialogue: 0,0:09:18.38,0:09:22.62,Main,,0,0,0,,Şu saatten sonra bir şey yapamazsın!\NHer şey Leo'yla Kabu-san'a emanet!
Dialogue: 0,0:09:23.41,0:09:26.92,Main,,0,0,0,,Tontattaların prensesi\Niyileştirme gücüne mi sahip?
Dialogue: 0,0:09:26.92,0:09:29.48,Main,,0,0,0,,Chiyu Chiyu Meyvesi güç kullanıcısı.
Dialogue: 0,0:09:30.53,0:09:35.47,Main,,0,0,0,,Yeteneği yaşayan şeyleri\Niyileştirmesini sağlıyor.
Dialogue: 0,0:09:35.47,0:09:38.00,Main,,0,0,0,,Düşmanın onu istemesine şaşmamalı!
Dialogue: 0,0:09:38.00,0:09:39.14,Main,,0,0,0,,Şaşmamalı!
Dialogue: 0,0:09:39.14,0:09:45.16,Main,,0,0,0,,Giolla bunu kullanarak düşmüş yöneticileri\Nyeniden savaşa katmanın peşinde.
Dialogue: 0,0:09:45.16,0:09:47.23,Main,,0,0,0,,Başarırsa bizim için çok kötü olur!
Dialogue: 0,0:09:49.80,0:09:52.15,Main,,0,0,0,,Al başına belayı işte!
Dialogue: 0,0:09:52.15,0:09:53.61,Main,,0,0,0,,Leo, sana güveniyoruz!
Dialogue: 0,0:09:53.93,0:09:55.36,Main,,0,0,0,,Kabu-san, bastır!
Dialogue: 0,0:09:55.36,0:09:59.95,Main,,0,0,0,,Yoksa, acaba diyorum\NSugar da orada olabilir mi?!
Dialogue: 0,0:10:01.60,0:10:01.91,Main,,0,0,0,,Orada!
Dialogue: 0,0:10:02.18,0:10:04.79,Main,,0,0,0,,Ne!?
Dialogue: 0,0:10:15.94,0:10:19.01,Main,,0,0,0,,O da iyileşecek ha?!\NYok artık daha neler!
Dialogue: 0,0:10:19.01,0:10:21.64,Main,,0,0,0,,Başarabilirsin, Leo!
Dialogue: 0,0:10:24.18,0:10:26.53,Main,,0,0,0,,Git hadi! Prensesi kurtar!
Dialogue: 0,0:10:26.53,0:10:28.43,Main,,0,0,0,,Kurtar!
Dialogue: 0,0:10:31.60,0:10:34.00,Main,,0,0,0,,Yaramazlar odasını görüyorum!
Dialogue: 0,0:10:38.24,0:10:40.41,Main,,0,0,0,,Buldum onu!
Dialogue: 0,0:10:40.41,0:10:41.54,Main,,0,0,0,,Leo!
Dialogue: 0,0:10:41.54,0:10:42.25,Main,,0,0,0,,Prenses!
Dialogue: 0,0:10:43.40,0:10:44.83,Main,,0,0,0,,Çok geç kaldın!
Dialogue: 0,0:10:44.83,0:10:46.17,Main,,0,0,0,,Yakalayın!
Dialogue: 0,0:10:54.47,0:10:59.68,Main,,0,0,0,,Donquixote Ailesi yöneticileri,\Ndirilin haydi!
Dialogue: 0,0:10:59.68,0:11:03.44,Main,,0,0,0,,İkinci tur başlıyor!
Dialogue: 0,0:11:04.00,0:11:05.10,Main,,0,0,0,,Leo!
Dialogue: 0,0:11:05.10,0:11:06.40,Main,,0,0,0,,Çekil yolumdan!
Dialogue: 0,0:11:06.40,0:11:08.36,Main,,0,0,0,,Giolla'yla sen ilgilen!
Dialogue: 0,0:11:20.41,0:11:21.25,Main,,0,0,0,,{\fad(150,150)}Böcek...
Dialogue: 0,0:11:23.25,0:11:24.83,Main,,0,0,0,,{\fad(150,150)}...Aparkatı!
Dialogue: 0,0:11:32.19,0:11:33.30,Main,,0,0,0,,Ne?!
Dialogue: 0,0:11:35.18,0:11:38.18,Main,,0,0,0,,Dik, dik, dik, dik, dik!
Dialogue: 0,0:11:40.24,0:11:41.27,Main,,0,0,0,,Dik!
Dialogue: 0,0:11:42.97,0:11:43.85,Main,,0,0,0,,Dik...
Dialogue: 0,0:11:43.85,0:11:46.06,Main,,0,0,0,,Dik, dik, dik, dik!
Dialogue: 0,0:11:51.97,0:11:55.07,Main,,0,0,0,,Onları dizip yeniden deneyeceğim!
Dialogue: 0,0:11:55.07,0:11:57.12,Main,,0,0,0,,Gerek yok!
Dialogue: 0,0:11:57.12,0:11:58.83,Main,,0,0,0,,Dik, dik, dik, dik, dik!
Dialogue: 0,0:12:00.03,0:12:02.33,Main,,0,0,0,,Dik, dik, dik, dik, dik...
Dialogue: 0,0:12:03.45,0:12:04.96,Main,,0,0,0,,Ne?!
Dialogue: 0,0:12:09.18,0:12:13.38,Main,,0,0,0,,Bir daha ayrılamayın diye\Nsizi birbirinize dikeceğim!
Dialogue: 0,0:12:19.19,0:12:20.60,Main,,0,0,0,,Ne oluyor?!
Dialogue: 0,0:12:20.60,0:12:22.89,Main,,0,0,0,,{\fad(150,150)}Haute Couture!
Dialogue: 0,0:12:20.89,0:12:22.89,Note,,0,0,0,,{\fad(150,150)}Üst Seviye Dikiş
Dialogue: 0,0:12:23.88,0:12:25.73,Main,,0,0,0,,Kırkyama!
Dialogue: 0,0:12:25.73,0:12:27.20,Main,,0,0,0,,Ne?!
Dialogue: 0,0:12:43.42,0:12:47.29,Main,,0,0,0,,{\i1}Leo beni kurtarmaya geldi...{\i0}
Dialogue: 0,0:12:47.29,0:12:51.59,Main,,0,0,0,,{\i1}Aynı bir prens gibi!{\i0}
Dialogue: 0,0:12:51.59,0:12:54.69,Main,,0,0,0,,Sanat adeta...
Dialogue: 0,0:13:08.64,0:13:11.64,Captions,,900,0,310,,{\fad(300,300)}Eski Kralın Platosu
Dialogue: 0,0:13:09.41,0:13:11.69,Main,,0,0,0,,Başardılar!\NTam zamanında hem de!
Dialogue: 0,0:13:12.19,0:13:14.03,Main,,0,0,0,,Sahiden mi?!
Dialogue: 0,0:13:14.03,0:13:18.15,Main,,0,0,0,,Kimse iyileşemeden\NGiolla'nın işini bitirdiler!
Dialogue: 0,0:13:18.43,0:13:21.49,Main,,0,0,0,,Küçük insan, sen çok yaşa!
Dialogue: 0,0:13:21.49,0:13:24.34,Main,,0,0,0,,{\i1}Mansherry kurtarıldı!{\i0}
Dialogue: 0,0:13:24.34,0:13:27.71,Main,,0,0,0,,Yaşasın!
Dialogue: 0,0:13:33.18,0:13:36.26,Main,,0,0,0,,Leo, çok korktum...
Dialogue: 0,0:13:39.83,0:13:43.18,Main,,0,0,0,,Prenses, kilo almışsın yine.
Dialogue: 0,0:13:44.59,0:13:49.07,Main,,0,0,230,,{\fad(300,300)}Tontatta Prensesi\NPrenses Mansherry Kurtarıldı
Dialogue: 0,0:13:50.15,0:13:51.27,Main,,0,0,0,,Hep aynı manzara...
Dialogue: 0,0:13:51.27,0:13:54.94,Main,,0,0,0,,Leo! Leo!
Dialogue: 0,0:13:56.24,0:13:58.60,Main,,0,0,0,,Bacağım incinmiş.
Dialogue: 0,0:13:59.00,0:14:01.45,Main,,0,0,0,,İstersen sırtında taşıyabilirsin!
Dialogue: 0,0:14:03.84,0:14:05.89,Main,,0,0,0,,Kucağına da alabilirsin!
Dialogue: 0,0:14:06.44,0:14:09.14,Main,,0,0,0,,Prensesin bencil yüzü de\Nkendini gösterdi işte!
Dialogue: 0,0:14:09.64,0:14:14.14,Main,,0,0,0,,Gerçekten yaralandıysan\Nkendi kendini pekâlâ iyileştirebilirsin!
Dialogue: 0,0:14:14.14,0:14:20.09,Main,,0,0,0,,Hem sen çok iyi koşardın!\NHaydi koşup kaçalım buradan!
Dialogue: 0,0:14:21.99,0:14:23.89,Main,,0,0,0,,Kaçmıyorum o zaman!
Dialogue: 0,0:14:24.54,0:14:26.34,Main,,0,0,0,,Ne?! Al işte!
Dialogue: 0,0:14:26.34,0:14:28.04,Main,,0,0,0,,Prensesin mızmız hali!
Dialogue: 0,0:14:28.04,0:14:30.93,Main,,0,0,0,,Hem gelip kurtarmanı\Nben istemedim ki!
Dialogue: 0,0:14:30.93,0:14:33.90,Main,,0,0,0,,O da ne demekmiş öyle?!
Dialogue: 0,0:14:33.90,0:14:36.64,Main,,0,0,0,,Ciddi ciddi bırakıp gideceğim ama!
Dialogue: 0,0:14:36.64,0:14:38.35,Main,,0,0,0,,Git işte!
Dialogue: 0,0:14:41.64,0:14:43.54,Main,,0,0,0,,Al sırtına da gidelim!
Dialogue: 0,0:14:43.54,0:14:45.44,Main,,0,0,0,,Acelemiz var!
Dialogue: 0,0:14:45.44,0:14:46.41,Main,,0,0,0,,Acıdı...
Dialogue: 0,0:14:49.81,0:14:53.29,Main,,0,0,0,,Cidden ama! Bencil, kaprisli ve\Nçok çabuk sinirlenen birisin!
Dialogue: 0,0:14:53.29,0:14:56.72,Main,,0,0,0,,Gerçekten de\Nçok belalı bir prensessin!
Dialogue: 0,0:14:57.64,0:14:59.93,Main,,0,0,0,,{\i1}Leo'nun sırtı...{\i0}
Dialogue: 0,0:15:00.69,0:15:03.57,Main,,0,0,0,,{\i1}Prenses diğer herkese karşı\Nçok naziktir.{\i0}
Dialogue: 0,0:15:04.98,0:15:07.93,Main,,0,0,0,,{\i1}Leo bunu ne zaman anlayacak\Nçok merak ediyorum?{\i0}
Dialogue: 0,0:15:10.25,0:15:11.34,Main,,0,0,0,,Eyvah!
Dialogue: 0,0:15:11.34,0:15:15.15,Main,,0,0,0,,Mansherry'i almışlar!\NKüçük İnsanlar'ı durdurun!
Dialogue: 0,0:15:15.48,0:15:18.32,Main,,0,0,0,,Şu tarafa gittiler!\NElinizden kaçırmayın!
Dialogue: 0,0:15:19.50,0:15:22.39,Main,,0,0,0,,{\i1}Çok yazık oldu...{\i0}
Dialogue: 0,0:15:22.39,0:15:24.78,Main,,0,0,0,,{\i1}Fakat bu büyük bir sorun!{\i0}
Dialogue: 0,0:15:24.78,0:15:28.83,Main,,0,0,0,,{\i1}Genç Bey'e haber vermem lazım!{\i0}
Dialogue: 0,0:15:29.36,0:15:33.54,Main,,0,0,0,,{\i1}Mansherry'nin nihai tekniği\NGenç Bey'in planının bir parçası.{\i0}
Dialogue: 0,0:15:34.33,0:15:39.17,Main,,0,0,0,,{\i1}Kendi kısalan hayatı karşılığında\Nbaşka şeyleri düzeltebildiği bir güç!{\i0}
Dialogue: 0,0:15:39.17,0:15:43.17,Main,,0,0,0,,{\i1}Genç Bey'imiz, GÜLÜCÜK fabrikasına\Nbir şey olsa bile...{\i0}
Dialogue: 0,0:15:43.17,0:15:46.68,Main,,0,0,0,,{\i1}...Chiyu Chiyu Meyvesi'nin gücüne\Nsahip olduğumuz müddetçe...{\i0}
Dialogue: 0,0:15:47.28,0:15:51.52,Main,,0,0,0,,{\i1}...onu eski haline getirebileceğimizi\Ndüşünüyor olmalı!{\i0}
Dialogue: 0,0:15:55.42,0:15:58.36,Main,,0,0,0,,{\i1}Bu gidişle... fa... fa...{\i0}
Dialogue: 0,0:15:58.74,0:16:00.69,Captions,,0,0,230,,{\fad(300,300)}GÜLÜCÜK Fabrikası
Dialogue: 0,0:16:00.84,0:16:04.36,Captions,,0,0,330,,{\fad(300,300)}Franky, Senyor Pink'e Karşı
Dialogue: 0,0:15:58.36,0:16:00.96,Main,,0,0,1,,Fabrika yok olacak!
Dialogue: 0,0:16:00.96,0:16:04.95,Main,,0,0,1,,Senyor, fabrikayı hayatın pahasına koru!
Dialogue: 0,0:16:04.95,0:16:06.95,Main,,0,0,0,,{\fad(150,150)}Franky...
Dialogue: 0,0:16:06.95,0:16:10.20,Main,,0,0,0,,{\i1}Olamaz! \NKaç, Senyor!{\i0}
Dialogue: 0,0:16:10.95,0:16:12.87,Main,,0,0,0,,{\fad(150,150)}Sert...
Dialogue: 0,0:16:12.87,0:16:14.87,Main,,0,0,0,,{\fad(150,150)}...Çekiç!
Dialogue: 0,0:16:20.46,0:16:22.86,Main,,0,0,0,,Gene yere daldı!
Dialogue: 0,0:16:22.86,0:16:26.24,Main,,0,0,0,,Fraland, gene aynı şeyi yapacak!
Dialogue: 0,0:16:26.24,0:16:27.93,Main,,0,0,0,,{\i1}Kaç!{\i0[/piccolo]}
Dialogue: 0,0:16:31.37,0:16:32.52,Main,,0,0,0,,{\fad(150,150)}Miyav Miyav...
Dialogue: 0,0:16:32.52,0:16:34.31,Main,,0,0,0,,{\fad(150,150)}...Suplex!
Dialogue: 0,0:16:42.76,0:16:44.74,Main,,0,0,0,,Senyor!
Dialogue: 0,0:16:56.18,0:16:58.21,Main,,0,0,0,,İkisi de güçlerinin sınırındalar artık!
Dialogue: 0,0:16:58.21,0:16:59.96,Main,,0,0,0,,Fraland!
Dialogue: 0,0:17:00.79,0:17:04.82,Main,,0,0,0,,O saldırıdan kaçabileceğini\Nbiliyorum, Fraland!
Dialogue: 0,0:17:04.82,0:17:08.09,Main,,0,0,0,,30 keredir aynı saldırının\Nhedefi oluyorsun! Neden?!
Dialogue: 0,0:17:09.85,0:17:12.53,Main,,0,0,0,,İşime karışmayın, Tontattalar!
Dialogue: 0,0:17:12.53,0:17:17.27,Main,,0,0,0,,Sahi ya... Senyor da\Naynı yumruğu 30 kez yedi...
Dialogue: 0,0:17:17.27,0:17:19.16,Main,,0,0,0,,Neden ama?!
Dialogue: 0,0:17:19.16,0:17:22.50,Main,,0,0,0,,Hiçbir erkek kendine\Niçki ikram eden birinden...
Dialogue: 0,0:17:22.50,0:17:26.94,Main,,0,0,0,,...bardağını kaçırmaz!
Dialogue: 0,0:17:26.94,0:17:29.25,Main,,0,0,0,,Ne?! Yani şimdi...
Dialogue: 0,0:17:29.25,0:17:33.42,Main,,0,0,0,,Sıkı bir eleman bu!\NO yüzden de...
Dialogue: 0,0:17:33.42,0:17:36.83,Main,,0,0,0,,...saldırılarından kaçmayacağım!
Dialogue: 0,0:17:36.83,0:17:41.38,Main,,0,0,0,,Tüm saldırılarını yiyecek\Nve sonunda kazanacağım!
Dialogue: 0,0:17:41.38,0:17:43.67,Main,,0,0,0,,Sert stilim... {\alpha&HFF&}Bu işte!
Dialogue: 0,0:17:43.67,0:17:46.77,Main,,0,0,0,,Sert stilim... Bu işte!
Dialogue: 0,0:17:48.54,0:17:51.92,Main,,0,0,0,,Endişenizi anlıyorum fakat\Nerkekler arasında bir mücadele bu!
Dialogue: 0,0:17:51.92,0:17:54.56,Main,,0,0,0,,Ne olursa olsun kazanacağım, görün bakın!
Dialogue: 0,0:17:54.56,0:17:59.77,Main,,0,0,0,,Bir daha onların kölesi olmanıza\Nmüsaade etmem!
Dialogue: 0,0:18:04.01,0:18:06.81,Main,,0,0,0,,{\i1}Fraland!{\i0}
Dialogue: 0,0:18:08.18,0:18:13.57,Main,,0,0,0,,Ucuz bir barın edeceğinden\Ndaha beter sarhoş ettin beni, evlat.
Dialogue: 0,0:18:14.46,0:18:17.75,Main,,0,0,0,,Az önce söylediklerini unutma.
Dialogue: 0,0:18:19.29,0:18:20.75,Main,,0,0,0,,Artık...
Dialogue: 0,0:18:21.77,0:18:26.62,Main,,0,0,0,,...o kadar genç değilim, \Nsıradaki saldırımla bu işe bir son vereceğim.
Dialogue: 0,0:18:26.62,0:18:29.91,Main,,0,0,0,,Senyor, ondan önce\Nbir şey söyleyebilir miyim!?
Dialogue: 0,0:18:29.91,0:18:31.97,Main,,0,0,0,,Çok ama çok uzaktasınız!
Dialogue: 0,0:18:31.97,0:18:37.06,Main,,0,0,0,,Anlıyorsun değil mi?!
Dialogue: 0,0:18:38.10,0:18:41.23,Main,,0,0,0,,Tüm saldırılarımı yiyeceğini söyledin!
Dialogue: 0,0:18:41.23,0:18:46.40,Main,,0,0,0,,Eğer sözünün eriysen,\Nbu saldırımı da ye ve...
Dialogue: 0,0:18:47.42,0:18:49.40,Main,,0,0,0,,...hayatta kalmaya çalış bakalım!
Dialogue: 0,0:18:55.24,0:18:59.91,Main,,0,0,0,,Eğer ayakların üzerinde doğrulabilirsen\Nben kaybettim demektir!
Dialogue: 0,0:19:00.61,0:19:04.83,Main,,0,0,0,,Son saldırını tüm bedenimle kabul edeceğim!
Dialogue: 0,0:19:05.92,0:19:08.30,Main,,0,0,0,,Âlâ!
Dialogue: 0,0:19:14.46,0:19:16.83,Main,,0,0,0,,Kulenin duvarı boyunca yüzüyor!
Dialogue: 0,0:19:16.83,0:19:19.16,Main,,0,0,0,,Ne yapmaya çalışıyor?!
Dialogue: 0,0:19:23.09,0:19:27.52,Main,,0,0,0,,Bugün de bahtıma\Nhava pek bir kasvetli ama...
Dialogue: 0,0:19:27.52,0:19:29.57,Main,,0,0,0,,...böyle uçmaya devam edersem...
Dialogue: 0,0:19:29.57,0:19:32.45,Main,,0,0,0,,...Russian'ı görebilirim.
Dialogue: 0,0:19:32.45,0:19:33.98,Main,,0,0,0,,Russian mı?
Dialogue: 0,0:19:33.98,0:19:37.61,Main,,0,0,0,,Evet... Gimlet adında\Nbir de oğlum var.
Dialogue: 0,0:19:38.79,0:19:44.95,Main,,0,0,0,,Fakat maalesef yerçekimi inatçı.\NDaha fazla uçamam.
Dialogue: 0,0:19:44.95,0:19:47.29,Main,,0,0,0,,Neden bahsediyorsun sen?!
Dialogue: 0,0:19:47.29,0:19:51.05,Main,,0,0,0,,Sayborg, arka kısmın et ve kan değil mi?!
Dialogue: 0,0:19:51.90,0:19:54.63,Main,,0,0,0,,Demek bile bile...
Dialogue: 0,0:19:54.63,0:19:58.30,Main,,0,0,0,,Sus artık yoksa dilini ısırırsın!
Dialogue: 0,0:20:01.60,0:20:04.70,Main,,0,0,0,,{\fad(150,150)}Miyav Miyav Supleks!
Dialogue: 0,0:20:05.78,0:20:10.70,Main,,0,0,0,,{\fad(150,150)}Bebek...
Dialogue: 0,0:20:10.70,0:20:12.53,Main,,0,0,0,,{\fad(150,150)}...Cümbüşü!
Dialogue: 0,0:20:43.65,0:20:45.43,Main,,0,0,0,,Fraland!
Dialogue: 0,0:20:55.56,0:20:57.03,Main,,0,0,0,,Anlaştığımız üzere...
Dialogue: 0,0:20:57.76,0:21:00.44,Main,,0,0,0,,...sıra bende!
Dialogue: 0,0:21:03.30,0:21:04.45,Main,,0,0,0,,Eyvah ki ne eyvah!
Dialogue: 0,0:21:08.33,0:21:09.92,Main,,0,0,0,,{\i1}Kusuruma bakma, Genç Bey'im.{\i0}
Dialogue: 0,0:21:09.92,0:21:11.38,Main,,0,0,0,,{\fad(150,150)}Franky...
Dialogue: 0,0:21:11.70,0:21:15.42,Main,,0,0,0,,{\fad(150,150)}...Demir Boks!
Dialogue: 0,0:21:15.42,0:21:18.51,Main,,0,0,0,,{\i1}O zamanlar da\Nböyleydi değil mi Russian?{\i0}
Dialogue: 0,0:21:19.80,0:21:23.76,Main,,0,0,0,,{\i1}Seninle tanıştığım gece de,\Ngülümsemeni yitirdiğin o gece de...{\i0}
Dialogue: 0,0:21:30.27,0:21:34.53,Main,,0,0,0,,{\i1}...böyle kıyamet kopmuşçasına yağmurluydu.{\i0}
Dialogue: 0,0:21:40.07,0:21:43.42,Main,,0,0,0,,Hiç yağmur yağacak gibi de\Ndeğildi oysaki, su gibi oldum!
Dialogue: 0,0:21:44.42,0:21:47.54,Main,,0,0,0,,Bu kadar ıslanmana rağmen\Nneden gülüyorsun?
Dialogue: 0,0:21:48.40,0:21:52.03,Main,,0,0,0,,Yağmuru seviyorum.
Dialogue: 0,0:21:56.95,0:21:59.88,Main,,0,0,0,,Sevmediğim şeyler mi?
Dialogue: 0,0:21:59.88,0:22:02.89,Main,,0,0,0,,Korsanlar!\NOnlardan ölesiye nefret ediyorum!
Dialogue: 0,0:22:03.51,0:22:06.48,Main,,0,0,0,,Sen ne işle meşgulsün peki?
Dialogue: 0,0:22:08.06,0:22:10.48,Main,,0,0,0,,Bankada çalışıyorum.
Dialogue: 0,0:22:11.01,0:22:12.65,Main,,0,0,0,,Hadi ya?
Dialogue: 0,0:22:22.51,0:22:23.70,Main,,0,0,0,,Hayatım!
Dialogue: 0,0:22:26.16,0:22:29.91,Main,,0,0,0,,Hayatım, adını ne koyalım?
Dialogue: 0,0:22:29.91,0:22:31.19,Main,,0,0,0,,Şeye ne dersin...
Dialogue: 0,0:22:31.96,0:22:33.40,Main,,0,0,0,,Gimlet.
Dialogue: 0,0:22:34.06,0:22:35.38,Main,,0,0,0,,Çok beğendim!
Dialogue: 0,0:23:06.49,0:23:07.08,Main,,0,0,0,,Ne?
Dialogue: 0,0:23:08.75,0:23:10.75,Main,,0,0,0,,Gimlet öldü mü?
Dialogue: 0,0:23:11.32,0:23:15.34,Main,,0,0,0,,Bir hafta önce,\Nhaber bile vermeden gittiğin gün...
Dialogue: 0,0:23:16.33,0:23:19.00,Main,,0,0,0,,...ateşi birden yükseldi.
Dialogue: 0,0:23:19.00,0:23:21.63,Main,,0,0,0,,Hastaneye götürdüm ama başaramadı!
Dialogue: 0,0:23:24.17,0:23:25.09,Main,,0,0,0,,Yalancı!
Dialogue: 0,0:23:25.09,0:23:25.64,Main,,0,0,0,,Ne?
Dialogue: 0,0:23:26.68,0:23:27.72,Main,,0,0,0,,Yalancı!
Dialogue: 0,0:23:27.99,0:23:30.47,Main,,0,0,0,,Bankayı defalarca aradım!
Dialogue: 0,0:23:30.47,0:23:33.10,Main,,0,0,0,,Senin gibi bir çalışanları yokmuş!
Dialogue: 0,0:23:33.82,0:23:36.02,Main,,0,0,0,,Doğruyu söyle bana!
Dialogue: 0,0:23:36.02,0:23:38.98,Main,,0,0,0,,Ne iş yapıyorsun?!
Dialogue: 0,0:23:38.98,0:23:41.21,Main,,0,0,0,,Ne tür bir parayla hayatımızı sürdürüyoruz?!
Dialogue: 0,0:23:41.21,0:23:42.32,Main,,0,0,0,,Söyle!
Dialogue: 0,0:23:42.86,0:23:45.45,Main,,0,0,0,,Söyleyemiyor musun?!
Dialogue: 0,0:23:45.94,0:23:48.66,Main,,0,0,0,,Baba olmaya layık değilsin!
Dialogue: 0,0:23:48.66,0:23:50.43,Main,,0,0,0,,Çekil yolumdan!
Dialogue: 0,0:23:50.43,0:23:52.00,Main,,0,0,0,,Bekle!
Dialogue: 0,0:23:52.89,0:23:56.08,Main,,0,0,0,,Bekle Russian, fırtına var!
Dialogue: 0,0:23:56.99,0:23:58.29,Main,,0,0,0,,Rahat bırak beni!
Dialogue: 0,0:23:59.40,0:24:00.42,Main,,0,0,0,,Peşimden de gelme!
Dialogue: 0,0:24:03.61,0:24:05.55,Main,,0,0,0,,{\i1}Düşündüğün gibi değil, Russian...{\i0}
Dialogue: 0,0:24:06.54,0:24:08.89,Main,,0,0,0,,{\i1}Sana her şeyi anlatamamamın nedeni...{\i0}
Dialogue: 0,0:24:09.51,0:24:10.47,Main,,0,0,0,,Russian!
Dialogue: 0,0:24:10.47,0:24:11.84,Main,,0,0,0,,Neredesin?!
Dialogue: 0,0:24:12.73,0:24:14.40,Main,,0,0,0,,Russian!
Dialogue: 0,0:24:20.03,0:24:21.87,Main,,0,0,0,,Yağmur yüzünden...
Dialogue: 0,0:24:22.44,0:24:26.91,Main,,0,0,0,,...toprak kayması yaşanmış ve\Nkarınız da o anda oradaymış.
Dialogue: 0,0:24:27.52,0:24:29.68,Main,,0,0,0,,Durumu oldukça ciddi...
Dialogue: 0,0:24:30.37,0:24:32.55,Main,,0,0,0,,Bitkisel hayatta mı?
Dialogue: 0,0:24:32.55,0:24:35.34,Main,,0,0,0,,Evet, bilinci yerinde değil.
Dialogue: 0,0:24:36.00,0:24:38.41,Main,,0,0,0,,Ve maalesef bu gidişle...
Dialogue: 0,0:24:38.41,0:24:42.63,Main,,0,0,0,,...bir daha asla\Nhislerini belli edemeyecek.
Dialogue: 0,0:24:43.61,0:24:46.59,Main,,0,0,0,,Vücudunun bu duruma ne kadar\Ndayanabileceğini bilmiyoruz.
Dialogue: 0,0:24:46.59,0:24:50.05,Main,,0,0,0,,{\i1}Benim gibi biriyle tanışmasaydın...{\i0}
Dialogue: 0,0:24:50.05,0:24:52.39,Main,,0,0,0,,Hayatım, teşekkür ederim!
Dialogue: 0,0:24:54.42,0:24:57.58,Main,,0,0,0,,{\i1}Özür dilerim!\NSeni kaybetmek istemediğim için...{\i0}
Dialogue: 0,0:24:58.20,0:25:00.73,Main,,0,0,0,,{\i1}...yalan söyledim sana.{\i0}
Dialogue: 0,0:25:03.48,0:25:05.25,Main,,0,0,0,,{\i1}Bir cevap duymak istiyorum...{\i0}
Dialogue: 0,0:25:09.26,0:25:11.04,Main,,0,0,0,,{\i1}Bir ses...{\i0}
Dialogue: 0,0:25:13.07,0:25:14.33,Main,,0,0,0,,{\i1}Bir kez daha...{\i0}
Dialogue: 0,0:25:14.65,0:25:16.16,Main,,0,0,0,,{\i1}Bir kez daha...{\i0}
Dialogue: 0,0:25:16.82,0:25:18.68,Main,,0,0,0,,{\i1}Gülmesini istiyorum.{\i0}
Dialogue: 0,0:25:19.45,0:25:23.40,Main,,0,0,0,,{\fad(0,3000)\i1}Bir kez daha...{\i0}
Dialogue: 0,0:25:24.98,0:25:26.40,Main,,0,0,0,,Russian, bak.
Dialogue: 0,0:25:26.40,0:25:29.18,Main,,0,0,0,,Gimlet'e giydirdiğimiz şapkadan buldum!
Dialogue: 0,0:25:30.03,0:25:33.62,Main,,0,0,0,,Bana da benziyordu hem,\Nonu andırıyorum değil mi?
Dialogue: 0,0:25:34.20,0:25:37.74,Main,,0,0,0,,Özür dilerim!\NHaddimi aştım...
Dialogue: 0,0:25:37.74,0:25:40.00,Main,,0,0,0,,Beni bu halde görürlerse...
Dialogue: 0,0:25:50.37,0:25:51.89,Main,,0,0,0,,{\i1}Russian...{\i0}
Dialogue: 0,0:26:23.79,0:26:25.12,Main,,0,0,0,,Harikasın var ya moruk!
Dialogue: 0,0:26:25.12,0:26:28.46,Main,,0,0,0,,Oğlunu kaybetmiş ve\Nkarısı da büyük bir kaza geçirdi.
Dialogue: 0,0:26:28.46,0:26:31.93,Main,,0,0,0,,Kendini bu denli kaybetmiş olmasına\Nşaşırmamak lazım...
Dialogue: 0,0:26:36.70,0:26:42.38,Main,,0,0,0,,Pink! \NModa anlayışına ne oldu senin?!
Dialogue: 0,0:26:44.74,0:26:46.18,Main,,0,0,0,,Çıkıyorum ben.
Dialogue: 0,0:26:47.33,0:26:49.37,Main,,0,0,0,,Sapığa bak!
Dialogue: 0,0:26:49.37,0:26:51.01,Main,,0,0,0,,Sapık geçiyor!
Dialogue: 0,0:26:51.01,0:26:52.50,Main,,0,0,0,,İğrenç!
Dialogue: 0,0:26:52.50,0:26:53.48,Main,,0,0,0,,Oha adama bak!
Dialogue: 0,0:26:53.48,0:26:54.88,Main,,0,0,0,,Sus bakayım!
Dialogue: 0,0:27:11.86,0:27:13.00,Main,,0,0,0,,Russian...
Dialogue: 0,0:27:16.22,0:27:18.41,Main,,0,0,0,,Benim için...
Dialogue: 0,0:27:19.56,0:27:25.82,Main,,0,0,0,,...bu kıyafetler dünyadaki tüm pahalı\Ntakım elbiselerden bile daha değerli.
Dialogue: 0,0:27:32.57,0:27:34.93,Main,,0,0,0,,{\i1}Çünkü yalnızca\Nben bu kıyafetleri giyince...{\i0}
Dialogue: 0,0:27:37.40,0:27:39.70,Main,,0,0,0,,{\i1}...gülüyorsun.{\i0}
Dialogue: 0,0:28:05.48,0:28:07.06,Main,,0,0,0,,{\i1}Senyor!{\i0}
Dialogue: 0,0:28:07.06,0:28:09.45,Main,,0,0,0,,{\i1}Fraland!{\i0}
Dialogue: 0,0:28:25.23,0:28:27.61,Main,,0,0,0,,Zavallı...
Dialogue: 0,0:28:28.70,0:28:34.23,Main,,0,0,0,,Neyi hatırlayıp da ağlıyorsun...
Dialogue: 0,0:28:34.23,0:28:35.48,Main,,0,0,0,,Ağabey.
Dialogue: 0,0:28:53.48,0:28:57.23,Main,,0,0,0,,İleride bir gün\Nbir yerlerde karşılaşacak olursak...
Dialogue: 0,0:28:58.05,0:28:59.75,Main,,0,0,0,,...karşılıklı birer kadeh devirelim.
Dialogue: 0,0:29:00.61,0:29:02.83,Main,,0,0,0,,Ve bana...
Dialogue: 0,0:29:04.07,0:29:08.18,Main,,0,0,0,,...Russian denen kadını anlat.
Dialogue: 0,0:29:09.03,0:29:12.53,Main,,0,0,0,,{\fad(250,450)\fs48\pos(640,400)\blur0.2}GÜLÜCÜK Fabrikası Savaşı
Dialogue: 0,0:29:12.53,0:29:14.41,Main,,0,0,0,,{\fad(450,0)\fs48\pos(640,470)\blur0.2}Kazanan: Franky
