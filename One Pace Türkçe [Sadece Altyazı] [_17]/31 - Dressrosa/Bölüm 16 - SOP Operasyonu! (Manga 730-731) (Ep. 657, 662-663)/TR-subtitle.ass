,30,1Style: Lyrics,Impress BT,43,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,2,0,2,10,10,15,1Style: Author,Impress BT,25,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1,1,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:23.75,0:00:28.07,Credits,,0,0,0,,Translation & initial timing YibisDialogue: 0,0:00:28.16,0:00:32.16,Credits,,0,0,0,,Timing Sewil Galaxy 9000Dialogue: 0,0:00:34.66,0:00:37.60,Credits,,0,0,0,,Quality-checking Sewil Galaxy 9000 HaleeDialogue: 0,0:00:39.02,0:00:42.64,Credits,,0,0,0,,Soundtracking HaleeDialogue: 0,0:00:45.87,0:00:48.56,Credits,,0,0,0,,Video editing         SewilDialogue: 0,0:00:45.87,0:00:48.56,Credits,,0,0,0,,Raw provider      GS-RawsDialogue: 0,0:00:01.26,0:00:03.90,Lyrics,,0,0,0,,♪ Gidelim tüm parıltımızla, koşar adım, sonsuza dek! ♪Dialogue: 0,0:00:03.93,0:00:06.66,Lyrics,,0,0,0,,♪ İlerlemeye devam edelim! ♪Dialogue: 0,0:00:06.70,0:00:09.57,Lyrics,,0,0,0,,♪ Değişmeyen bağlar mutlak aydınlatacak... ♪Dialogue: 0,0:00:09.63,0:00:12.67,Lyrics,,0,0,0,,♪ ...rüyamızın sonunu! ♪Dialogue: 0,0:00:12.77,0:00:15.27,Lyrics,,0,0,0,,♪ Uyan, uyan, uyan, uyan haydi kalbim! ♪Dialogue: 0,0:00:15.34,0:00:18.18,Lyrics,,0,0,0,,♪ Başaracağız! Durmaksızın devam! ♪Dialogue: 0,0:00:23.72,0:00:28.07,Lyrics,,0,0,0,,♪ Tek pusulamız özgürlüktür. En sıkı dostlarız. ♪Dialogue: 0,0:00:28.15,0:00:34.59,Lyrics,,0,0,0,,♪ Kendi rotamızı bundan sonra da yine kendimiz çizeceğiz. ♪Dialogue: 0,0:00:34.66,0:00:39.00,Lyrics,,0,0,0,,♪ Her gün tam hız ilerliyoruz. Doğuya git, batıya git. ♪Dialogue: 0,0:00:39.06,0:00:45.44,Lyrics,,0,0,0,,♪ Birbiri ardına yapmak istediğimiz şeyler buluyor ve yapıyoruz da hepsini. ♪Dialogue: 0,0:00:45.50,0:00:50.99,Lyrics,,0,0,0,,♪ Sabahları etmeye dayanamaz aceleci gönlümüz. (Bekleyemem!) ♪Dialogue: 0,0:00:51.11,0:00:56.05,Lyrics,,0,0,0,,♪ Neden alıp biz yapıştırmıyoruz güneşi göğe. ♪Dialogue: 0,0:00:56.11,0:00:58.95,Lyrics,,0,0,0,,♪ Zorla ve yola çıkmıyoruz! ♪Dialogue: 0,0:00:59.95,0:01:02.65,Lyrics,,0,0,0,,♪ Evet tüm parıltımızla, koşar adım, sonsuza dek! ♪Dialogue: 0,0:01:02.72,0:01:06.59,Lyrics,,0,0,0,,♪ Hayal kırıntılarımız birleştirerek. ♪Dialogue: 0,0:01:06.66,0:01:10.75,Lyrics,,0,0,0,,♪ Titretiyorsa eğer gönlünü var mı daha büyük hazine. ♪Dialogue: 0,0:01:10.83,0:01:13.43,Lyrics,,0,0,0,,♪ Gidelim tüm parıltımızla, koşar adım, sonsuza dek! ♪Dialogue: 0,0:01:13.50,0:01:16.13,Lyrics,,0,0,0,,♪ İlerlemeye devam edelim! ♪Dialogue: 0,0:01:16.20,0:01:19.17,Lyrics,,0,0,0,,♪ Değişmeyen bağlar mutlak aydınlatacak... ♪Dialogue: 0,0:01:19.24,0:01:22.24,Lyrics,,0,0,0,,♪ ...rüyamızın sonunu! ♪Dialogue: 0,0:01:22.31,0:01:24.94,Lyrics,,0,0,0,,♪ Uyan, uyan, uyan, uyan haydi kalbim ♪Dialogue: 0,0:01:25.01,0:01:27.41,Lyrics,,0,0,0,,♪ Başaracağız! Durmaksızın devam! ♪Dialogue: 0,0:01:31.50,0:01:41.50,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gnsDialogue: 0,0:12:08.40,0:12:18.40,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gnsDialogue: 0,0:25:35.00,0:25:45.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gnsDialogue: 0,0:01:31.50,0:01:40.30,Title,,0,0,0,,Bölüm 16 SOP Operasyonu!Dialogue: 0,0:01:48.93,0:01:52.07,Main,Usopp,0,0,0,,O patlama ve silah sesleri de neydi öyle?!Dialogue: 0,0:01:52.07,0:01:53.29,Main,Usopp,0,0,0,,Trao'ya ne oldu?Dialogue: 0,0:01:53.29,0:01:55.20,Main,Sanji,0,0,0,,Duyuyor musun Luffy?Dialogue: 0,0:01:55.20,0:01:56.93,Main,Sanji,0,0,0,,Ne oluyor orada?!Dialogue: 0,0:01:58.39,0:02:01.27,Main,Doflamingo,0,0,0,,Rahatsızlık verdiğim için bağışlayın.Dialogue: 0,0:02:03.22,0:02:07.44,Main,Doflamingo,0,0,0,,Bu gördüğünüz Shichibukai, korsan Trafalgar Law.Dialogue: 0,0:02:07.44,0:02:13.23,Main,Doflamingo,0,0,0,,Sabahki tahttan inme yalan haberinin ardında o varmış.Dialogue: 0,0:02:14.71,0:02:18.17,Main,Doflamingo,0,0,0,,Beni alaşağı etmeyi planlıyormuş.Dialogue: 0,0:02:19.37,0:02:22.62,Main,Doflamingo,0,0,0,,Ama endişelenmeyin, sorunu hallettim!Dialogue: 0,0:02:22.62,0:02:24.54,Main,Citizen,0,0,0,,Demek her şeyin suçlusu oymuş!Dialogue: 0,0:02:24.54,0:02:28.77,Main,Citizen,0,0,0,,Onun yüzünden Dressrosa mahvolacaktı!Dialogue: 0,0:02:29.55,0:02:30.80,Main,Citizen,0,0,0,,Şükürler olsun!Dialogue: 0,0:02:30.80,0:02:34.07,Main,Luffy,0,0,0,,Lan Mingo!Dialogue: 0,0:02:38.40,0:02:40.51,Main,Luffy,0,0,0,,Ne cüretle Trao'yu vurursun?!Dialogue: 0,0:02:44.62,0:02:50.61,Main,Doflamingo,0,0,0,,Hasır Şapka... Seni zerre ilgilendirmez.Dialogue: 0,0:02:50.61,0:02:53.86,Main,Doflamingo,0,0,0,,Law özünde benim adamımdı.Dialogue: 0,0:02:53.86,0:02:55.89,Main,Doflamingo,0,0,0,,Onunla ilgilenmek de bana düşer!Dialogue: 0,0:02:56.89,0:02:58.51,Main,Zoro,0,0,0,,Kin, Trao'yu al!Dialogue: 0,0:02:58.51,0:02:59.56,Main,Kin'emon,0,0,0,,Tamamdır!Dialogue: 0,0:03:01.53,0:03:04.75,Main,Marine,0,0,0,,Koramiral-dono,  Korsan Avcısı harekete geçti!Dialogue: 0,0:03:05.07,0:03:06.34,Main,Marine,0,0,0,,Yakalayalım mı?Dialogue: 0,0:03:07.92,0:03:08.57,Main,Bastille,0,0,0,,Olur.Dialogue: 0,0:03:08.57,0:03:10.40,Main,Fujitora,0,0,0,,Durun biraz!Dialogue: 0,0:03:10.40,0:03:12.66,Main,Chopper,0,0,0,,Bir şeyler söylesenize?!Dialogue: 0,0:03:12.66,0:03:13.97,Main,Chopper,0,0,0,,Ne oluyor orada?!Dialogue: 0,0:03:13.97,0:03:18.91,Main,Kin'emon,0,0,0,,Law-dono gözlerimizin önünde vuruldu!Dialogue: 0,0:03:20.74,0:03:22.60,Main,Usopp,0,0,0,,Duydun mu?Dialogue: 0,0:03:23.70,0:03:27.45,Main,Doflamingo,0,0,0,,Korsan Avcısı'yla Tilki Alevi Kin'emon...Dialogue: 0,0:03:27.84,0:03:31.97,Main,Doflamingo,0,0,0,,Demin gemide Momonosuke'ye benzeyen bir velet de görmüştüm!Dialogue: 0,0:03:33.24,0:03:34.70,Main,Zoro,0,0,0,,Dinleme onu!Dialogue: 0,0:03:34.70,0:03:36.20,Main,Zoro,0,0,0,,Momo'yu almasına müsaade etmeyiz!Dialogue: 0,0:03:36.20,0:03:37.75,Main,Kin'emon,0,0,0,,Elbette!Dialogue: 0,0:03:47.90,0:03:49.34,Thoughts,Zoro,0,0,0,,Bu...Dialogue: 0,0:03:51.68,0:03:59.00,Flashbacks,Fujitora,0,0,0,,Karşılıklı menfaatimiz için bunu sana söylemesem iyi ederim.Dialogue: 0,0:04:06.73,0:04:08.84,Main,Luffy,0,0,0,,Zoro!Dialogue: 0,0:04:09.85,0:04:11.53,Main,Kin'emon,0,0,0,,Zoro-dono.Dialogue: 0,0:04:11.53,0:04:14.71,Main,Usopp,0,0,0,,Zoro'ya ne oldu, Kin'emon?!Dialogue: 0,0:04:14.71,0:04:17.39,Main,Kin'emon,0,0,0,,Zoro-dono kayboldu!Dialogue: 0,0:04:23.86,0:04:24.68,Main,Luffy,0,0,0,,Kin'emon!Dialogue: 0,0:04:25.26,0:04:26.59,Main,Luffy,0,0,0,,Geliyorum!Dialogue: 0,0:04:29.48,0:04:32.92,Main,Luffy,0,0,0,,Kairouseki'ydi bunlar...Dialogue: 0,0:04:32.92,0:04:35.02,Main,Brook,0,0,0,,Kin'emon-san, iyi misiniz?!Dialogue: 0,0:04:35.02,0:04:39.09,Main,Brook,0,0,0,,Yoksa öldünüz mü?!Dialogue: 0,0:04:53.06,0:04:54.77,Main,Marine,0,0,0,,Koramiral-dono!Dialogue: 0,0:04:55.38,0:04:57.39,Main,Fujitora,0,0,0,,Uzaktan kılıcıyla saldırabiliyor demek?Dialogue: 0,0:04:57.39,0:04:59.41,Main,Fujitora,0,0,0,,Bu tehlikeli işte.Dialogue: 0,0:05:00.19,0:05:05.28,Main,Zoro,0,0,0,,Bizim ihtiyar kör kumarbaz Donanma amiraliymiş demek!Dialogue: 0,0:05:05.28,0:05:07.05,Main,Luffy,0,0,0,,Amiral mi?!Dialogue: 0,0:05:07.27,0:05:09.61,Main,Fujitora,0,0,0,,Önceki karşılaşmamızda yaşananlar için teşekkür ederim.Dialogue: 0,0:05:09.61,0:05:13.78,Main,Fujitora,0,0,0,,Bana o kadar iyi davranmıştınız, bense sanki...Dialogue: 0,0:05:13.78,0:05:16.43,Main,Fujitora,0,0,0,,...nankörlük ediyorum gibi biraz.Dialogue: 0,0:05:16.43,0:05:19.86,Main,Fujitora,0,0,0,,Hayat böyle zıtlıklarla dolu işte.Dialogue: 0,0:05:20.20,0:05:25.26,Main,Kin'emon,0,0,0,,İnanamıyorum! Doflamingo'dan yana olan adam...Dialogue: 0,0:05:25.26,0:05:28.04,Main,Kin'emon,0,0,0,,...donanma amiraliymiş!Dialogue: 0,0:05:32.10,0:05:35.45,Main,Franky,0,0,0,,Dressrosa'da donanma amirali mi varmış?!Dialogue: 0,0:05:36.01,0:05:39.98,Main,Robin,0,0,0,,Doflamingo donanmayı arkasına almış olabilir!Dialogue: 0,0:05:39.98,0:05:43.46,Main,Robin,0,0,0,,Ki durum buysa düşman sayısı da artacaktır!Dialogue: 0,0:05:47.63,0:05:50.25,Main,Kin'emon,0,0,0,,Law-dono! Law-dono!Dialogue: 0,0:05:50.25,0:05:52.33,Main,Zoro,0,0,0,,Nereye gidiyor bunlar!?Dialogue: 0,0:05:52.33,0:05:56.08,Main,Kin'emon,0,0,0,,İyi misin?! Cevap ver!Dialogue: 0,0:05:58.58,0:06:01.95,Main,Doflamingo,0,0,0,,Sarayda konuşalım, Fujitora!Dialogue: 0,0:06:01.95,0:06:06.76,Main,Doflamingo,0,0,0,,Benimle işbirliği edersen o veletleri yakalamana izin veririm.Dialogue: 0,0:06:06.76,0:06:11.04,Main,Fujitora,0,0,0,,Diyeceklerini dinleyeceğim, Gökçe Şeytan.Dialogue: 0,0:06:11.04,0:06:12.95,Main,Fujitora,0,0,0,,Kararımı ondan sonra vereceğim.Dialogue: 0,0:06:14.49,0:06:16.86,Main,Marines,0,0,0,,Roronoa Zoro'yu yakalayın!Dialogue: 0,0:06:20.86,0:06:22.56,Main,Zoro,0,0,0,,Kimliğimiz açığa çıktı gibi!Dialogue: 0,0:06:22.56,0:06:24.88,Main,Kin'emon,0,0,0,,Öyle görünüyor!Dialogue: 0,0:06:24.88,0:06:26.53,Main,Zoro,0,0,0,,Şimdilik çekilelim!Dialogue: 0,0:06:34.64,0:06:37.20,Main,Luffy,0,0,0,,Trao!Dialogue: 0,0:06:38.11,0:06:42.02,Main,Kin'emon,0,0,0,,Kin'emon konuşuyor! Law-dono kaçırıldı!Dialogue: 0,0:06:48.15,0:06:51.13,Main,Zoro,0,0,0,,Luffy, buradan çıkmanın bir yolunu bul!Dialogue: 0,0:06:51.13,0:06:53.97,Main,Zoro,0,0,0,,Biz seni beklerken civarda koşuyor olacağız!Dialogue: 0,0:06:53.97,0:06:55.75,Main,Luffy,0,0,0,,Tamamdır! Acele edelim!Dialogue: 0,0:06:55.75,0:06:58.25,Main,Luffy,0,0,0,,Trao vurulduktan sonra konuşmuştu!Dialogue: 0,0:07:00.20,0:07:01.50,Main,Luffy,0,0,0,,Brook'lar bunlar!Dialogue: 0,0:07:01.50,0:07:02.79,Main,Luffy,0,0,0,,Ne oldu?!Dialogue: 0,0:07:02.79,0:07:04.44,Main,Brook,0,0,0,,Bi-Bi-Biz...Dialogue: 0,0:07:04.44,0:07:06.10,Main,Luffy,0,0,0,,Sunny-go ne oluyor?!Dialogue: 0,0:07:06.10,0:07:07.97,Main,Marines,0,0,0,,Buradalar!Dialogue: 0,0:07:08.77,0:07:10.22,Main,Zoro,0,0,0,,Lanet olsun, buldular bizi!Dialogue: 0,0:07:10.22,0:07:12.61,Main,Brook,0,0,0,,Eyvah ki ne eyvah!Dialogue: 0,0:07:16.84,0:07:18.73,Main,Brook,0,0,0,,Big Mom'ın...Dialogue: 0,0:07:20.35,0:07:25.18,Main,Chopper,0,0,0,,Korsan gemisi bu!Dialogue: 0,0:07:27.81,0:07:30.78,Lyrics,Ship,0,0,0,,Gemi, gemi♪Dialogue: 0,0:07:33.14,0:07:36.65,Main,Brook,0,0,0,,Yonkou'nun gemisi burada ne arıyor?!Dialogue: 0,0:07:38.26,0:07:40.07,Main,Sanji,0,0,0,,Gemi başı süsü şarkı mı söylüyor?!Dialogue: 0,0:07:40.07,0:07:43.68,Main,Luffy,0,0,0,,Big Mom'ın gemisi olduğuna emin misiniz?!Dialogue: 0,0:07:43.68,0:07:45.04,Main,Chopper,0,0,0,,Öldük biz!Dialogue: 0,0:07:45.71,0:07:48.33,Main,Luffy,0,0,0,,Ne oluyor?! Big Mom da orada mı?!Dialogue: 0,0:07:48.99,0:07:52.52,Main,Sanji,0,0,0,,Bilmiyorum ama Balık Adam Adası'nda karşılaştığımız o ikisini görüyorum!Dialogue: 0,0:07:56.29,0:07:59.06,Main,Pekoms,0,0,0,,Anne, Caesar'ı görüyorum gao!Dialogue: 0,0:07:59.43,0:08:02.49,Main,Tamago,0,0,0,,Düşündüğümüz gibi yanlarında-bon!Dialogue: 0,0:08:02.97,0:08:07.60,Main,Tamago,0,0,0,,Gemilerini batırıp Caesar'ı alalım hemen-soir!Dialogue: 0,0:08:08.97,0:08:10.15,Main,Usopp,0,0,0,,Big Mom mı?!Dialogue: 0,0:08:10.15,0:08:11.71,Main,Usopp,0,0,0,,Şakası yok bu işin!Dialogue: 0,0:08:11.71,0:08:14.15,Main,Usopp,0,0,0,,Luffy, al işte diklenmenin cezası!Dialogue: 0,0:08:14.15,0:08:15.87,Main,Sanji,0,0,0,,Caesar'ın peşindeler sanırım!Dialogue: 0,0:08:17.75,0:08:21.27,Main,Sanji,0,0,0,,Bulunmaz hint kumaşı gibisin ha kötü bilim adamı seni!Dialogue: 0,0:08:21.27,0:08:23.15,Main,Sanji,0,0,0,,Onlar da seni kurtarmaya mı geldi?Dialogue: 0,0:08:26.57,0:08:28.85,Main,Caesar,0,0,0,,Yardım edin bana!Dialogue: 0,0:08:29.90,0:08:33.13,Main,Caesar,0,0,0,,Big Mom'ın esiri olmak istemiyorum!Dialogue: 0,0:08:33.13,0:08:35.10,Main,Caesar,0,0,0,,Çünkü ben...Dialogue: 0,0:08:36.59,0:08:40.16,Main,Caesar,0,0,0,,...araştırmalarım için parayı onlardan çarpmıştım!Dialogue: 0,0:08:40.16,0:08:41.30,Main,Sanji,0,0,0,,Ne dedin?Dialogue: 0,0:08:42.81,0:08:47.19,Main,Caesar,0,0,0,,Yani şimdi... Ayrıntıları boşver!Dialogue: 0,0:08:47.19,0:08:50.80,Main,Caesar,0,0,0,,Yakalayıp onlara yalan söylediğimi anlarlarsa gebertirler beni!Dialogue: 0,0:08:50.80,0:08:53.03,Main,Sanji,0,0,0,,Çok da umrumdaydı anasını!Dialogue: 0,0:08:53.03,0:08:57.02,Main,Sanji,0,0,0,,Seni kimselere veremeyiz o yüzden kapa çeneni!Dialogue: 0,0:08:58.01,0:09:00.18,Main,Brook,0,0,0,,Vuracaklar bizi!Dialogue: 0,0:09:05.90,0:09:11.80,Main,Sanji,0,0,0,,Lanet olsun, tam da zamanı hani! Dressrosa'dan giderek uzaklaşıyoruz!Dialogue: 0,0:09:12.36,0:09:13.43,Main,Sanji,0,0,0,,Ekebilir miyiz onları?!Dialogue: 0,0:09:13.43,0:09:15.14,Main,Franky,0,0,0,,İyi misiniz, Sanji?Dialogue: 0,0:09:15.14,0:09:19.74,Main,Franky,0,0,0,,Yalnız oha, Yonkou'yu adaya getirmeyin!Dialogue: 0,0:09:19.74,0:09:24.96,Main,Franky,0,0,0,,Ülkeyi ayağa kaldırıp  Oyuncak Asker'in tüm planını mahvedersiniz!Dialogue: 0,0:09:25.90,0:09:28.40,Main,Luffy,0,0,0,,Şimdi aklıma geldi de, Caesar niye gemideydi ki?Dialogue: 0,0:09:28.76,0:09:31.23,Main,Zoro,0,0,0,,Anlaşma yatmış sanırım!Dialogue: 0,0:09:31.23,0:09:33.52,Main,Zoro,0,0,0,,Aksi taktirde Trao niye o durumda olsun ki?!Dialogue: 0,0:09:33.81,0:09:37.82,Main,Sanji,0,0,0,,Law, Caesar'ı bir sonraki adaya götürmemizi söylemişti!Dialogue: 0,0:09:38.23,0:09:43.01,Main,Nami,0,0,0,,Sanji-kun, bence Dressrosa'ya dönmeyelim biz!Dialogue: 0,0:09:43.73,0:09:46.78,Main,Nami,0,0,0,,Adaya dönmeyelim demem korktuğumdan değil!Dialogue: 0,0:09:46.78,0:09:48.12,Main,Nami,0,0,0,,Luffy, dinle bak!Dialogue: 0,0:09:49.72,0:09:52.67,Main,Nami,0,0,0,,Doflamingo'yla aramızda üç koz var!Dialogue: 0,0:09:53.42,0:09:59.64,Main,Nami,0,0,0,,Caesar. GÜLÜCÜK fabrikası. Ve nedenini bilmiyorum ama Momonosuke.Dialogue: 0,0:09:59.64,0:10:04.08,Main,Nami,0,0,0,,GÜLÜCÜK fabrikasını henüz yok edemediğimizden o koz onun elinde.Dialogue: 0,0:10:05.79,0:10:10.29,Main,Nami,0,0,0,,Fakat diğer iki kozu elimizde tutuyoruz!Dialogue: 0,0:10:10.29,0:10:17.47,Main,Nami,0,0,0,,Trao bu iki kozu Doflamingo'dan uzaklaştırabilmek için çabalıyordu.Dialogue: 0,0:10:17.47,0:10:22.35,Main,Nami,0,0,0,,Belki fabrikayı yok edebilmeniz konusunda zaman kazandırmaya da çalışıyordu.Dialogue: 0,0:10:23.18,0:10:26.27,Main,Nami,0,0,0,,Yani diyorum ki Trao'nun canı pahasına korumaya çalıştığı...Dialogue: 0,0:10:26.60,0:10:30.29,Main,Nami,0,0,0,,...bu iki kozu oraya gelerek Doflamingo'nun kucağına atarsak...Dialogue: 0,0:10:32.01,0:10:35.23,Main,Nami,0,0,0,,...tüm yaptıkları boşa olmuş olur!Dialogue: 0,0:10:41.06,0:10:42.67,Main,Luffy,0,0,0,,Haklısın.Dialogue: 0,0:10:42.67,0:10:48.50,Main,Luffy,0,0,0,,Peki öyleyse. Trao'yu ne pahasına olursa olsun biz alırız!Dialogue: 0,0:10:50.38,0:10:52.46,Main,Luffy,0,0,0,,Bir sonraki adanın adı neydi?!Dialogue: 0,0:10:52.46,0:10:54.40,Main,Kin'emon,0,0,0,,Zou!Dialogue: 0,0:10:57.99,0:10:59.17,Main,Luffy,0,0,0,,Sanji.Dialogue: 0,0:11:00.02,0:11:01.10,Main,Luffy,0,0,0,,Nami.Dialogue: 0,0:11:01.73,0:11:03.04,Main,Luffy,0,0,0,,Chopper.Dialogue: 0,0:11:03.56,0:11:04.96,Main,Luffy,0,0,0,,Brook.Dialogue: 0,0:11:05.60,0:11:06.88,Main,Luffy,0,0,0,,Momo.Dialogue: 0,0:11:07.17,0:11:09.81,Main,Luffy,0,0,0,,Sizler Zou'ya gidin!Dialogue: 0,0:11:11.95,0:11:15.29,Main,Sanji,0,0,0,,Madem öyle, anlaşılmıştır Kaptan!Dialogue: 0,0:11:15.29,0:11:17.61,Main,Sanji,0,0,0,,Senden bir de izin istiyoruz!Dialogue: 0,0:11:18.16,0:11:19.09,Main,Luffy,0,0,0,,İzin mi?Dialogue: 0,0:11:19.63,0:11:21.29,Main,Sanji,0,0,0,,Big Mom'ın gemisine...Dialogue: 0,0:11:22.22,0:11:24.62,Main,Sanji,0,0,0,,...karşı saldırıda bulunma izni!Dialogue: 0,0:11:25.36,0:11:27.00,Main,Luffy,0,0,0,,Peki, izin verildi!Dialogue: 0,0:11:29.17,0:11:30.18,Main,Nami,0,0,0,,Olamaz!Dialogue: 0,0:11:33.26,0:11:34.98,Main,Luffy,0,0,0,,Olan olmuştu zaten!Dialogue: 0,0:11:35.61,0:11:36.49,Main,Sanji,0,0,0,,Aynen öyle!Dialogue: 0,0:11:36.49,0:11:37.63,Main,Brook,0,0,0,,Çok tehlikeli bu!Dialogue: 0,0:11:37.63,0:11:38.91,Main,Nami,0,0,0,,Yapmayın!Dialogue: 0,0:11:41.48,0:11:44.38,Main,Sanji,0,0,0,,Pekâlâ millet, sizi Zou'da bekleyeceğiz!Dialogue: 0,0:11:44.38,0:11:45.45,Main,Franky,0,0,0,,Tamamdır!Dialogue: 0,0:11:46.46,0:11:49.38,Main,Franky,0,0,0,,Fabrikayı yok etme işini bize bırakın!Dialogue: 0,0:11:55.91,0:11:57.66,Main,Luffy,0,0,0,,Kendinize iyi bakın!Dialogue: 0,0:11:59.10,0:12:01.50,Main,Luffy,0,0,0,,Biz de saraya gideceğiz!Dialogue: 0,0:12:03.36,0:12:05.74,Main,Luffy,0,0,0,,Doflamingo'nun canına okuyacağım!Dialogue: 0,0:12:14.34,0:12:16.11,Main,Bartolomeo,0,0,0,,Bariyer!Dialogue: 0,0:12:19.79,0:12:21.35,Main,Dellinger,0,0,0,,Amacın ne senin?Dialogue: 0,0:12:23.92,0:12:25.39,Main,Bellamy,0,0,0,,Bartolomeo?Dialogue: 0,0:12:25.39,0:12:27.54,Main,Dellinger,0,0,0,,Bu mesele seni ilgilendirmez!Dialogue: 0,0:12:27.54,0:12:32.52,Main,Bartolomeo,0,0,0,,Haklısın, ilgilendirmez! Canım bariyer yapmak istediği için yaptım zaten!Dialogue: 0,0:12:32.52,0:12:37.06,Main,Dellinger,0,0,0,,Aile meselemiz bu bizim! Karışacak olursan seni de öldürürüm!Dialogue: 0,0:12:39.55,0:12:44.32,Main,Bartolomeo,0,0,0,,Dene bakalım! Bariyerimi kimse kıramaz!Dialogue: 0,0:12:50.33,0:12:53.11,Main,Dellinger,0,0,0,,Ne var!? Meşgulüz şurada!Dialogue: 0,0:12:53.11,0:12:55.29,Main,Diamante,0,0,0,,Benim Dellinger.Dialogue: 0,0:12:55.29,0:12:59.33,Main,Diamante,0,0,0,,Anlaşılan Bellamy'i henüz öldürememişsin.Dialogue: 0,0:12:59.33,0:13:00.36,Main,Diamante,0,0,0,,Çok yavaşsın!Dialogue: 0,0:13:00.36,0:13:03.68,Main,Dellinger,0,0,0,,Kapa çeneni be! Araya başkaları girdi!Dialogue: 0,0:13:05.14,0:13:08.07,Main,Diamante,0,0,0,,Neyse ne, orasını sonra halledersin.Dialogue: 0,0:13:08.65,0:13:10.95,Main,Diamante,0,0,0,,Doffy'den başka emir geldi.Dialogue: 0,0:13:11.94,0:13:15.81,Main,Diamante,0,0,0,,Lao G.'lerle beraber Oyuncak Evi'ni koruyacaksın.Dialogue: 0,0:13:15.81,0:13:20.61,Main,Dellinger,0,0,0,,Dur biraz Diamante! Çok işim kalmadı burada!Dialogue: 0,0:13:20.61,0:13:23.84,Main,Diamante,0,0,0,,Kapa çeneni be! Doffy'e karşı mı geliyorsun?Dialogue: 0,0:13:30.73,0:13:33.33,Thoughts,Bellamy,0,0,0,,Başka emir mi?Dialogue: 0,0:13:33.33,0:13:34.93,Thoughts,Bellamy,0,0,0,,Yani gerçekten de...Dialogue: 0,0:13:35.41,0:13:37.33,Thoughts,Bellamy,0,0,0,,...beni...Dialogue: 0,0:13:38.13,0:13:39.86,Main,Dellinger,0,0,0,,Canları cehenneme!Dialogue: 0,0:13:43.47,0:13:44.70,Main,Dellinger,0,0,0,,Canın cehenneme!Dialogue: 0,0:13:47.79,0:13:49.57,Main,Dellinger,0,0,0,,Çekil önümden!Dialogue: 0,0:13:52.64,0:13:56.05,Main,Dellinger,0,0,0,,Bellamy'i geberteceğim!Dialogue: 0,0:13:56.50,0:13:59.05,Main,Dellinger,0,0,0,,Çekil ulan!Dialogue: 0,0:13:59.05,0:14:02.89,Main,Bartolomeo,0,0,0,,Hayatta olmaz. Bariyeri indirmem!Dialogue: 0,0:14:02.89,0:14:05.34,Main,Bartolomeo,0,0,0,,Acil çağırmadılar mı seni?Dialogue: 0,0:14:05.34,0:14:06.52,Main,Bartolomeo,0,0,0,,Kaybol hadi!Dialogue: 0,0:14:08.81,0:14:10.56,Main,Dellinger,0,0,0,,Bariyerci adi!Dialogue: 0,0:14:10.98,0:14:13.06,Main,Dellinger,0,0,0,,Bu burada kalmaz bilesiniz!Dialogue: 0,0:14:13.06,0:14:16.09,Main,Dellinger,0,0,0,,Dressrosa'dan sağ çıkmanıza izin vermeyeceğim!Dialogue: 0,0:14:18.89,0:14:20.82,Main,Bartolomeo,0,0,0,,Uza hadi boklu velet!Dialogue: 0,0:14:22.28,0:14:26.59,Thoughts,Bellamy,0,0,0,,Diamante'nin sesiydi o.Dialogue: 0,0:14:26.59,0:14:29.51,Thoughts,Bellamy,0,0,0,,Emri gerçekten de o mu verdi yani?Dialogue: 0,0:14:29.51,0:14:31.95,Thoughts,Bellamy,0,0,0,,Doflamingo gerçekten de...Dialogue: 0,0:14:31.95,0:14:35.49,Thoughts,Bellamy,0,0,0,,...beni öldürmelerini mi emretti?Dialogue: 0,0:14:35.49,0:14:40.19,Flashbacks,Bellamy,0,0,0,,Yarışmayı kazanırsam beni aile yöneticilerinden biri mi yapacaksın?Dialogue: 0,0:14:41.94,0:14:42.96,Flashbacks,Doflamingo,0,0,0,,Evet.Dialogue: 0,0:14:46.23,0:14:47.60,Flashbacks,Doflamingo,0,0,0,,İyi şanslar.Dialogue: 0,0:14:48.19,0:14:49.97,Flashbacks,Doflamingo,0,0,0,,Sana güveniyorum.Dialogue: 0,0:14:51.31,0:14:53.66,Main,Bartolomeo,0,0,0,,Seni tedavi bölümüne götüreyim.Dialogue: 0,0:14:54.36,0:14:56.71,Main,Bellamy,0,0,0,,Kendi işine bak sen!Dialogue: 0,0:14:57.03,0:15:01.59,Main,Bellamy,0,0,0,,Yaşama amacımı yitirmişim ben!Dialogue: 0,0:15:01.59,0:15:05.63,Main,Bellamy,0,0,0,,Neden beni kurtarmak istiyorsun ki?Dialogue: 0,0:15:05.63,0:15:08.05,Main,Bellamy,0,0,0,,Dövüş sırasında...Dialogue: 0,0:15:08.05,0:15:13.65,Main,Bellamy,0,0,0,,...hepinizi gebertmeye kararlı bir şekilde o arenaya çıkmıştım ben!Dialogue: 0,0:15:13.65,0:15:14.53,Main,Bartolomeo,0,0,0,,Biliyorum!Dialogue: 0,0:15:16.19,0:15:20.77,Main,Bartolomeo,0,0,0,,Fakat aynı arenayı paylaşan iki adam savaş kardeşi olur!Dialogue: 0,0:15:24.07,0:15:27.91,Main,Bartolomeo,0,0,0,,Kardeşime asla sırt çevirmem!Dialogue: 0,0:15:33.06,0:15:37.43,Captions,Caption,0,0,180,,Dressrosa "Çiçek Tarlası"Dialogue: 0,0:15:34.78,0:15:37.43,Main,Thunder Soldier,0,0,2,,Ülkenin geçmişi böyle.Dialogue: 0,0:15:38.86,0:15:43.66,Captions,,0,0,180,,Yeraltı - Riku Kraliyet Ordusu KarargahıDialogue: 0,0:15:38.85,0:15:43.65,Main,Thunder Soldier,0,0,4,,Ve karanlıktaki bu kişileri kurtarmak için hazırladığım plana da...Dialogue: 0,0:15:43.65,0:15:46.09,Main,Thunder Soldier,0,0,0,,...şöyle bir isim verdim!Dialogue: 0,0:15:46.09,0:15:50.09,Main,Thunder Soldier,0,0,0,,Dressrosa SOP Operasyonu!Dialogue: 0,0:15:52.40,0:15:56.27,Main,Franky,0,0,0,,SOP mu? Ne anlama geliyor peki bu?Dialogue: 0,0:15:56.27,0:16:00.73,Main,Thunder Soldier,0,0,0,,Ülkenin altında kimselerin bilmediği koca bir yeraltı dünyası uzanmakta!Dialogue: 0,0:16:01.59,0:16:07.59,Main,Thunder Soldier,0,0,0,,Ve burada karaborsa için kullanılan bir liman ve gizemli bir fabrika bulunuyor.Dialogue: 0,0:16:07.59,0:16:09.13,Main,Thunder Soldier,0,0,4,,Tontatta'lı dostlarımız...Dialogue: 0,0:16:09.04,0:16:16.54,Captions,,0,0,180,,Fabrika ve Yeraltı Ticaret LimanıDialogue: 0,0:16:09.13,0:16:11.32,Main,Thunder Soldier,0,0,4,,...ve oyuncak olmuş insanlar...Dialogue: 0,0:16:11.32,0:16:13.70,Main,Thunder Soldier,0,0,4,,...gece gündüz  burada çalışılmaya zorlanıyorlar!Dialogue: 0,0:16:13.70,0:16:17.17,Main,Franky,0,0,4,,Peki ya SOP ne demek!?Dialogue: 0,0:16:17.17,0:16:22.19,Main,Thunder Soldier,0,0,0,,Oraya bir yılda kazdığımız gizli yeraltı geçidinden ulaşacak...Dialogue: 0,0:16:19.99,0:16:24.20,Captions,,0,0,0,,Tünel aracılığıyla içeri sızmaDialogue: 0,0:16:22.19,0:16:24.20,Main,Thunder Soldier,0,0,0,,...ve herkesi kurtaracağız!Dialogue: 0,0:16:24.20,0:16:28.56,Main,Thunder Soldier,0,0,0,,Sonra da oradaki tüm tesisleri yok edecek, Doflamingo Ailesi'ni alaşağı edecek...Dialogue: 0,0:16:28.58,0:16:31.30,Main,Thunder Soldier,0,0,0,,...ve Dressrosa'yı Kral Riku  adına geri alacağız!Dialogue: 0,0:16:31.76,0:16:33.94,Main,Thunder Soldier,0,0,0,,Planımızın yegâne amacı budur!Dialogue: 0,0:16:33.94,0:16:35.54,Main,Usopp,0,0,0,,Söylemesi kolay da...Dialogue: 0,0:16:36.20,0:16:38.24,Main,Thunder Soldier,0,0,0,,Elbette her şeyin bu kadar kolay olmasını bekleyemeyiz!Dialogue: 0,0:16:39.13,0:16:44.95,Main,Thunder Soldier,0,0,0,,Keza önümüzdeki 10 dakika içinde bile Dressrosa'da neler olabileceğini kestirmek mümkün değil!Dialogue: 0,0:16:46.88,0:16:51.62,Main,Thunder Soldier,0,0,0,,O yüzden öncelikle yapılması gereken tek bir şey var!Dialogue: 0,0:16:53.12,0:16:59.04,Main,Thunder Soldier,0,0,0,,Bizi oyuncak yapan kişi Doflamingo'nun adamlarından biri.Dialogue: 0,0:16:59.04,0:17:02.23,Main,Thunder Soldier,0,0,0,,Hobi Hobi güç kullanıcısını bayıltmamız gerekiyor!Dialogue: 0,0:17:03.55,0:17:05.51,Main,Usopp,0,0,0,,Hobi Hobi meyvesi mi?Dialogue: 0,0:17:05.51,0:17:07.54,Main,Thunder Soldier,0,0,0,,Ondan sonra olacakları tahmin edebilirsiniz.Dialogue: 0,0:17:08.65,0:17:10.78,Main,Robin,0,0,0,,Büyü ortadan mı kalkacak yoksa?!Dialogue: 0,0:17:10.78,0:17:15.40,Main,Thunder Soldier,0,0,0,,Aynen öyle! Dressrosa'daki tüm oyuncaklar...Dialogue: 0,0:17:15.40,0:17:18.22,Main,Thunder Soldier,0,0,0,,...yeniden insan olacaklar!Dialogue: 0,0:17:18.95,0:17:24.17,Main,Thunder Soldier,0,0,0,,Ve anılarını kaybetmiş herkes onları geri kazanacak!Dialogue: 0,0:17:24.17,0:17:28.23,Main,Thunder Soldier,0,0,0,,Ondan sonra olacakları tahmin etmek mümkün değil!Dialogue: 0,0:17:28.53,0:17:32.00,Main,Thunder Soldier,0,0,0,,Kaç kişi bizimle birlik olacak?Dialogue: 0,0:17:32.03,0:17:37.07,Main,Thunder Soldier,0,0,0,,İnsanlar ne düşünecek, kimden yana olacaklar?Dialogue: 0,0:17:37.37,0:17:39.30,Main,Thunder Soldier,0,0,0,,Doflamingo ne yapacak?Dialogue: 0,0:17:39.30,0:17:41.87,Main,Thunder Soldier,0,0,0,,Donanma ne tür bir yol izleyecek?Dialogue: 0,0:17:41.87,0:17:43.22,Main,Thunder Soldier,0,0,0,,Kesin olan tek şey...Dialogue: 0,0:17:43.22,0:17:46.74,Main,Thunder Soldier,0,0,0,,...ülkenin kısa süreliğine büyük bir paniğe kapılacağıdır.Dialogue: 0,0:17:46.74,0:17:50.87,Main,Usopp,0,0,0,,Peki bu Hobi Hobi gücü kullanıcısı nerede şimdi?Dialogue: 0,0:17:50.87,0:17:54.05,Main,Usopp,0,0,0,,Acayip güçlüdür kesin!Dialogue: 0,0:17:54.74,0:17:56.75,Main,Thunder Soldier,0,0,0,,Tontatta keşif birliğinin raporuna göre...Dialogue: 0,0:17:57.55,0:18:00.47,Main,Thunder Soldier,0,0,0,,...şu anda yeraltı ticaret limanındaymış!Dialogue: 0,0:18:02.27,0:18:06.33,Main,Thunder Soldier,0,0,0,,Don Quixote Ailesi, Trebol Ordusu Özel Hizmetler Subayı...Dialogue: 0,0:18:07.03,0:18:08.40,Main,Thunder Soldier,0,0,0,,...Sugar!Dialogue: 0,0:18:10.91,0:18:14.81,Main,Thunder Soldier,0,0,0,,Yalnızca dokunarak istediği her şeyi oyuncağa dönüştürebilen bir kız!Dialogue: 0,0:18:15.76,0:18:23.15,Main,Thunder Soldier,0,0,0,,Çocuk gibi görünse de aslında bu meyveyi yiyen kişinin yaşlanması durur!Dialogue: 0,0:18:23.15,0:18:25.30,Main,Thunder Soldier,0,0,0,,Ailenin en önemli kişisi olduğundan...Dialogue: 0,0:18:25.30,0:18:29.02,Main,Thunder Soldier,0,0,0,,...ailede en yüksek rütbeye sahip Trebol tarafından korunmaktadır!Dialogue: 0,0:18:29.02,0:18:34.29,Main,Robin,0,0,0,,Yani o kızı bayıltabilirsek oyuncaklar normale dönecek öyle mi?!Dialogue: 0,0:18:34.29,0:18:35.97,Main,Thunder Soldier,0,0,0,,Aynen öyle!Dialogue: 0,0:18:35.97,0:18:39.18,Main,Thunder Soldier,0,0,0,,Sugar'ı bayılasıya korkutacağız!Dialogue: 0,0:18:39.18,0:18:40.11,Main,Thunder Soldier,0,0,0,,Bu yüzden de...Dialogue: 0,0:18:40.68,0:18:41.62,Main,Thunder Soldier,0,693,0,,Sugar'ın...Dialogue: 0,0:18:41.62,0:18:42.51,Main,Thunder Soldier,0,445,0,,Ödünü...Dialogue: 0,0:18:42.51,0:18:45.15,Main,Thunder Soldier,0,0,0,,...Patlatma operasyonu diyorum!Dialogue: 0,0:18:45.15,0:18:48.71,Main,Thunder Soldier,0,0,0,,SOP operasyonu bu anlama geliyor işte!Dialogue: 0,0:18:49.79,0:18:52.78,Main,Franky,0,0,0,,Harika bir isimmiş!Dialogue: 0,0:18:52.78,0:18:56.55,Main,Usopp,0,0,0,,Düşman küçük bir kızsa, takılın peşime!Dialogue: 0,0:18:58.65,0:19:01.59,Main,Franky,0,0,0,,İşte şimdi gaza geldim!Dialogue: 0,0:19:01.59,0:19:04.41,Main,Franky,0,0,0,,Franky Kuaförü!Dialogue: 0,0:19:05.57,0:19:07.83,Main,Franky,0,0,0,,Savaş Saç Modeli!Dialogue: 0,0:19:08.83,0:19:09.99,Main,Dwarf,0,0,0,,Fraland!Dialogue: 0,0:19:09.99,0:19:11.96,Main,Dwarf,0,0,0,,Usoland!Dialogue: 0,0:19:11.96,0:19:13.38,Main,Dwarf,0,0,0,,Güven dolduk!Dialogue: 0,0:19:13.38,0:19:16.10,Main,Usopp,0,0,0,,Ha şunu bileydiniz! Biz buradayken...Dialogue: 0,0:19:16.10,0:19:18.70,Main,Franky,0,0,0,,Kaybetmenize imkan yok!Dialogue: 0,0:19:19.96,0:19:24.07,Main,Franky,0,0,0,,Yeraltı geçidine götürün bizi, küçük insanlar!Dialogue: 0,0:19:24.07,0:19:28.08,Main,Dwarf,0,0,0,,Usolanders!Dialogue: 0,0:19:32.38,0:19:38.06,Main,Narrator,0,0,0,,Bu sırada Luffy ise Corrida Kolezyumu'nda bir çıkış kapısı aramaktaydı.Dialogue: 0,0:19:43.39,0:19:45.08,Main,Luffy,0,0,0,,Oha!Dialogue: 0,0:19:45.08,0:19:47.34,Main,Luffy,0,0,0,,Çıkışı geçtim...Dialogue: 0,0:19:47.34,0:19:48.67,Main,Luffy,0,0,0,,...nerede olduğumu bile bilmiyorum!Dialogue: 0,0:19:48.93,0:19:54.59,Main,Bartolomeo,0,0,0,,O yüzden bir gün Luffy-senpai'nin sağ kolu olacağım!Dialogue: 0,0:19:54.59,0:19:56.29,Main,Bartolomeo,0,0,0,,Hayalim bu benim.Dialogue: 0,0:19:59.47,0:20:01.38,Main,Voice,0,0,0,,Kapasana kapıyı be!Dialogue: 0,0:20:00.35,0:20:01.38,Secondary,Luffy,0,0,0,,Tuvaletmiş!Dialogue: 0,0:20:04.01,0:20:06.28,Main,Luffy,0,0,0,,Vay, Horoz Kafa!Dialogue: 0,0:20:06.94,0:20:08.17,Main,Luffy,0,0,0,,Seni gördüğüm iyi oldu!Dialogue: 0,0:20:10.03,0:20:13.20,Main,Bartolomeo,0,0,0,,L-L-Luffy-senpai!Dialogue: 0,0:20:16.58,0:20:18.90,Thoughts,Bartolomeo,0,0,0,,Olmaz!Dialogue: 0,0:20:19.80,0:20:21.97,Thoughts,Bartolomeo,0,0,0,,Bu sefer dayan, Bartolomeo!Dialogue: 0,0:20:21.97,0:20:26.27,Thoughts,Bartolomeo,0,0,0,,Korsanlar Kralı'yla konuşma şansını kaçıramazsın!Dialogue: 0,0:20:26.27,0:20:27.98,Main,Luffy,0,0,0,,Bellamy!Dialogue: 0,0:20:32.98,0:20:37.01,Main,Bartolomeo,0,0,0,,Lanet olsun göz kamaştırıcı biri resmen!Dialogue: 0,0:20:37.01,0:20:38.47,Main,Bartolomeo,0,0,0,,Luffy-senpai!Dialogue: 0,0:20:38.47,0:20:42.26,Main,Bartolomeo,0,0,0,,Zoro-senpai'yi gördünüz mü?!Dialogue: 0,0:20:42.26,0:20:44.50,Main,Luffy,0,0,0,,Evet buluştuk! Sağ ol.Dialogue: 0,0:20:44.50,0:20:46.42,Thoughts,Bartolomeo,0,0,0,,Lafı olmaz!Dialogue: 0,0:20:46.62,0:20:51.73,Main,Luffy,0,0,0,,Fakat şimdi bir yere gitmem lazım,  dışarı çıkmam gerekiyor ama çıkışı bulamadım.Dialogue: 0,0:20:52.11,0:20:55.60,Main,Bellamy,0,0,0,,Bu kolezyumun çıkışı yok.Dialogue: 0,0:20:55.60,0:20:56.78,Main,Luffy,0,0,0,,Ne?Dialogue: 0,0:20:56.78,0:21:01.07,Main,Luffy,0,0,0,,Daha da bir yaralanmışsın sen sanki?Dialogue: 0,0:21:01.07,0:21:07.03,Main,Bellamy,0,0,0,,Yarışmacı bir kez kolezyuma adımını attımı dışarı çıkamaz.Dialogue: 0,0:21:07.03,0:21:08.91,Main,Bellamy,0,0,0,,Çıkışı arayarak vaktini harcama!Dialogue: 0,0:21:08.91,0:21:11.15,Main,Luffy,0,0,0,,Ne?! Nasıl yani?Dialogue: 0,0:21:11.15,0:21:12.29,Main,Luffy,0,0,0,,Kesin mi bu?!Dialogue: 0,0:21:12.29,0:21:13.65,Main,Luffy,0,0,0,,Çıkış yok mu yani?!Dialogue: 0,0:21:13.65,0:21:17.18,Main,Luffy,0,0,0,,Doflamingo'nun adamı değil misin sen?!Dialogue: 0,0:21:17.18,0:21:19.09,Main,Luffy,0,0,0,,Bir çıkış kapısı falan bilmiyor musun?!Dialogue: 0,0:21:19.58,0:21:25.00,Thoughts,Bellamy,0,0,0,,Adamı mı? O bile olamadım!Dialogue: 0,0:21:25.00,0:21:27.30,Main,Luffy,0,0,0,,Lütfen! Dostumun başı dertte!Dialogue: 0,0:21:28.14,0:21:31.00,Main,Bellamy,0,0,0,,Dışarı çıkacağım şimdi.Dialogue: 0,0:21:31.00,0:21:36.17,Main,Bellamy,0,0,0,,Beni izlersen sen de belki dışarı çıkabilirsin.Dialogue: 0,0:21:36.17,0:21:38.02,Main,Luffy,0,0,0,,Hadi ya? Teşekkür ederim!Dialogue: 0,0:21:38.02,0:21:39.29,Main,Luffy,0,0,0,,Kesin eminsin değil mi?Dialogue: 0,0:21:39.29,0:21:43.71,Main,Bellamy,0,0,0,,Diyorum ki olur da beni takip edersen belki bir çıkış yoluna falan denk gelebilirsin.Dialogue: 0,0:21:45.74,0:21:49.72,Main,Bellamy,0,0,0,,Yoksa patronuma ihanet ettiğimi mi ima etmeye çalışıyorsun?Dialogue: 0,0:21:49.72,0:21:51.76,Main,Bellamy,0,0,0,,Ben...Dialogue: 0,0:21:51.76,0:21:54.37,Main,Bellamy,0,0,0,,Doflamingo'ya ihanet edemem!Dialogue: 0,0:21:54.37,0:21:57.73,Main,Bellamy,0,0,0,,Ona büyük saygı duyuyorum!Dialogue: 0,0:21:57.73,0:21:59.85,Main,Bartolomeo,0,0,0,,Dur bakalım biraz, daha az önce...Dialogue: 0,0:21:59.85,0:22:01.30,Main,Bellamy,0,0,0,,Kapa çeneni!Dialogue: 0,0:22:01.30,0:22:03.27,Main,Bellamy,0,0,0,,Hâlâ korumam gereken bazı prensiplerim var!Dialogue: 0,0:22:03.57,0:22:05.50,Main,Luffy,0,0,0,,Pekâlâ, takip edeyim o zaman!Dialogue: 0,0:22:07.46,0:22:09.35,Main,Bartolomeo,0,0,0,,Fakat, Luffy-senpai...Dialogue: 0,0:22:09.35,0:22:10.85,Main,Bartolomeo,0,0,0,,...Mera Mera Meyvesi ne olacak?Dialogue: 0,0:22:10.85,0:22:14.02,Main,Luffy,0,0,0,,Her ne kadar bazı kişilerin onu almasını istemesem de başka seçeneğim yok!Dialogue: 0,0:22:14.02,0:22:16.00,Main,Luffy,0,0,0,,Dostumun hayatını  meyve için tehlikeye atamam!Dialogue: 0,0:22:16.00,0:22:18.82,Main,Bartolomeo,0,0,0,,Öyleyse meyve konusunda bana güvenebilirsiniz!Dialogue: 0,0:22:18.82,0:22:26.13,Main,Bartolomeo,0,0,0,,Luffy-senpai, zaten amacım yarışmayı kazanıp Ace-sama'nın hatırasını sana getirmeyi planlıyordum!Dialogue: 0,0:22:26.13,0:22:27.77,Main,Luffy,0,0,0,,Ne? Bana mı vereceksin yani?!Dialogue: 0,0:22:27.77,0:22:31.61,Main,Bartolomeo,0,0,0,,Elbette! Senin zaten o!Dialogue: 0,0:22:31.61,0:22:34.70,Main,Luffy,0,0,0,,Gittikçe daha anlaşılmaz oluyorsun.Dialogue: 0,0:22:34.70,0:22:38.09,Main,Bartolomeo,0,0,0,,Mera Mera Meyvesi'ni kazanacağıma söz veriyorum!Dialogue: 0,0:22:38.09,0:22:40.81,Main,Bartolomeo,0,0,0,,Gözün arkada kalmadan dışarı çıkabilirsin!Dialogue: 0,0:22:40.81,0:22:42.82,Main,Bellamy,0,0,0,,Kiminle konuşuyorsun sen?Dialogue: 0,0:22:42.82,0:22:44.58,Main,Luffy,0,0,0,,Güzel öyleyse! Çok iyi oldu bu!Dialogue: 0,0:22:47.26,0:22:50.42,Main,Sabo,0,0,0,,Mera Mera Meyvesi'ni almana izin vermem.Dialogue: 0,0:22:50.42,0:22:53.40,Main,Sabo,0,0,0,,Hasır Şapkalı Luffy!Dialogue: 0,0:22:54.17,0:22:55.55,Main,Bartolomeo,0,0,0,,Sen de kimsin lan?!Dialogue: 0,0:22:57.39,0:23:02.06,Main,Bartolomeo,0,0,0,,Luffy-senpai'yle nasıl böyle hiçbir şeymiş gibi konuşabiliyorsun?!Dialogue: 0,0:23:02.06,0:23:07.16,Main,Bartolomeo,0,0,0,,Keza karşındaki kişi efsanevi korsan Ateş Yumruk Ace-sama'nın kardeşi...Dialogue: 0,0:23:07.16,0:23:10.80,Main,Bartolomeo,0,0,0,,...ve geleceğin Korsanlar Kralı, seni gerzek!Dialogue: 0,0:23:10.80,0:23:13.29,Main,Sabo,0,0,0,,Bunlar çok eskiden bildiğim şeyler.Dialogue: 0,0:23:23.91,0:23:25.63,Main,Acillia,0,0,0,,Büyük an geldi!Dialogue: 0,0:23:26.18,0:23:29.22,Main,Acillia,0,0,0,,Ne pahasına olursa olsun finallere çıkman lazım!Dialogue: 0,0:23:31.83,0:23:32.92,Main,Rebecca,0,0,0,,Evet!Dialogue: 0,0:23:48.00,0:23:52.61,Main,Bartolomeo,0,0,0,,Bu herif de neyin nesi böyle?! Luffy-senpai'yle sanki kankasıymış gibi konuşuyor!Dialogue: 0,0:23:52.61,0:23:55.26,Main,Bartolomeo,0,0,0,,Al işte! Senpai'yi kızdırdı!Dialogue: 0,0:24:11.05,0:24:17.08,Captions,,0,0,180,,Corrida Kolezyumu'nun DışıDialogue: 0,0:24:15.78,0:24:19.24,Main,Zoro,0,0,4,,Dışarı çıkabilmişsin işte, niye ağlıyorsun?!Dialogue: 0,0:24:20.00,0:24:22.36,Main,Marine,0,0,0,,Korsan Avcısı'nı nasıl kaybedersiniz?!Dialogue: 0,0:24:22.36,0:24:24.91,Main,Marine,0,0,0,,Dikkati elden bırakmayın diye elli kere söyledim size!Dialogue: 0,0:24:24.91,0:24:26.30,Main,Marine,0,0,0,,Koramirali çağırın!Dialogue: 0,0:24:26.30,0:24:27.77,Main,Marine,0,0,0,,Emredersiniz!Dialogue: 0,0:24:29.27,0:24:34.34,Main,Kin'emon,0,0,0,,Yalnız Donanma şehirdeki oyuncaklardan olduğumuza fena kandı!Dialogue: 0,0:24:34.34,0:24:36.25,Main,Zoro,0,0,0,,Zar zor!Dialogue: 0,0:24:36.25,0:24:39.52,Main,Zoro,0,0,0,,Seçtiğin hayvan kıyafetlerine baksana!Dialogue: 0,0:24:40.22,0:24:43.33,Main,Kin'emon,0,0,0,,Harikalar bence! Hele de koi!Dialogue: 0,0:24:47.05,0:24:50.31,Main,Zoro,0,0,0,,Ağlama sen de artık! Trao'yu kurtarmak istemiyor musun?!Dialogue: 0,0:24:51.27,0:24:55.49,Main,Luffy,0,0,0,,Trao'yu kurtaracağım, Mingo'nun canına okuyacağım!Dialogue: 0,0:24:55.49,0:24:58.67,Main,Luffy,0,0,0,,Ayrıca Mera Mera Meyvesi de artık emin ellerde!Dialogue: 0,0:24:58.67,0:24:59.88,Main,Zoro,0,0,0,,Emin ellerde mi?Dialogue: 0,0:25:00.22,0:25:03.57,Main,Koala,0,0,0,,Robin-san'ın da burada olduğunu duydum.Dialogue: 0,0:25:04.84,0:25:13.76,Captions,,0,0,250,,Koala - Devrim Ordusu Yardımcı Balık Adam Karate UstasıDialogue: 0,0:25:03.57,0:25:05.64,Main,Koala,0,0,4,,Umarım görüşebiliriz.Dialogue: 0,0:25:05.97,0:25:08.54,Main,Koala,0,0,4,,Senin adına da sevindim.Dialogue: 0,0:25:08.54,0:25:12.08,Main,Sabo,0,0,4,,Evet... Yumruklayacak sandım beni.Dialogue: 0,0:25:15.14,0:25:16.16,Main,Koala,0,0,0,,Ağlıyor musun yoksa?Dialogue: 0,0:25:17.26,0:25:18.96,Main,Sabo,0,0,0,,Ağlamam ben!Dialogue: 0,0:25:21.08,0:25:24.56,Main,Koala,0,0,0,,Sen de orada olsaydın bazı şeyler şimdi daha farklı olabilir miydi dersin?Dialogue: 0,0:25:26.50,0:25:28.87,Main,Koala,0,0,0,,Bunu kimseler bilemez.Dialogue: 0,0:25:29.19,0:25:30.34,Main,Sabo,0,0,0,,Evet.Dialogue: 0,0:25:30.34,0:25:33.78,Main,Sabo,0,0,0,,Yeraltıyla ilgili bir şeyler bulabilirsen derhal haber ver.Dialogue: 0,0:25:33.78,0:25:34.38,Main,Koala,0,0,0,,Peki.Dialogue: 0,0:25:37.25,0:25:42.20,Main,Sabo,0,0,0,,Bense Ace'in Mera Mera Meyvesi'ni kazanacağım!Dialogue: 0,0:25:42.80,0:25:46.84,Main,Sabo,0,0,0,,Dileğini bizler sürdüreceğiz!Dialogue: 0,0:25:49.85,0:25:52.67,Main,Luffy,0,0,0,,Öldü sanıyordum!Dialogue: 0,0:25:52.67,0:25:55.09,Main,Zoro,0,0,0,,Kimden bahsediyorsun arkadaş!Dialogue: 0,0:25:58.06,0:25:59.80,Main,Luffy,0,0,0,,O gün...Dialogue: 0,0:25:59.80,0:26:02.17,Main,Luffy,0,0,0,,...öldü...Dialogue: 0,0:26:02.17,0:26:04.30,Captions,,0,0,0,,#Hasır Şapkalar Döndü#Dialogue: 0,0:26:02.90,0:26:07.58,Main,Luffy,0,0,0,,...öldü sanmıştım!