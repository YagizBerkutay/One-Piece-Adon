Dialogue: 0,0:01:31.42,0:01:34.36,Main,Announcer,0,0,0,,Hepsi de arenaya çıktı!
Dialogue: 0,0:01:34.36,0:01:36.91,Main,Announcer,0,0,0,,Corrida Kolezyumu final mücadelesi!
Dialogue: 0,0:01:37.74,0:01:43.55,Main,Announcer,0,0,4,,İlk turun galipleri ve Bay Diamante...
Dialogue: 0,0:01:37.94,0:01:43.55,Captions,Caption,0,0,240,,{\fad(491,0)\fs(42)}Donquixote Ailesi Üst Düzey Yönetici\NDiamante {\fnA-OTF Jun Pro 201\fs42}♦{\fnroboto\fs42}
Dialogue: 0,0:01:43.55,0:01:47.49,Main,Announcer,0,0,0,,Bu mücadeleyi kazananı...
Dialogue: 0,0:01:47.49,0:01:54.19,Main,Announcer,0,0,0,,...en güçlü tür olan Logia türü Şeytan Meyvesi Mera Mera Meyvesi bekliyor olacak!
Dialogue: 0,0:01:47.87,0:01:54.19,Title,,0,0,440,,{\fad(2000,0)}Diamante ve Pica
Dialogue: 0,0:01:56.10,0:01:57.50,Main,Burgess,0,0,0,,Benim olacak o!
Dialogue: 0,0:02:00.37,0:02:03.25,Thoughts,,0,0,0,,{\i1}Kim bu?\NLucy olmadığına eminim.{\i0}
Dialogue: 0,0:02:03.25,0:02:05.04,Main,Participant,0,0,0,,Durun!
Dialogue: 0,0:02:06.52,0:02:08.76,Main,Participant,0,0,0,,Rebecca'yı indirin oradan!
Dialogue: 0,0:02:08.76,0:02:10.81,Main,Participant,0,0,0,,D Bloğu'nun maçı yeniden yapılsın!
Dialogue: 0,0:02:11.45,0:02:13.55,Main,Announcer,0,0,0,,Bir sorun var galiba?!
Dialogue: 0,0:02:14.43,0:02:19.68,Main,Participant,0,0,0,,Böyle şaibeli bir sonucu\Nkabul etmeyiz, Rebecca!
Dialogue: 0,0:02:19.68,0:02:23.44,Main,Participant,0,0,0,,Senin gibi bir yosmaya\Nyenilir miyiz be?!
Dialogue: 0,0:02:23.44,0:02:24.96,Main,Participant,0,0,0,,Şimdi asıl sonucu öğreniriz!
Dialogue: 0,0:02:25.74,0:02:27.89,Main,Audience,0,0,0,,Evet, haklayın şunu!
Dialogue: 0,0:02:30.95,0:02:32.50,Main,Participant,0,0,0,,Çekil önümüzden!
Dialogue: 0,0:02:35.97,0:02:38.74,Main,Diamante,0,0,0,,Yenilmenin de bir adabı var!
Dialogue: 0,0:02:38.74,0:02:40.97,Main,Diamante,0,0,0,,Kaybetmişseniz oturun oturduğunuz yerde!
Dialogue: 0,0:02:40.97,0:02:44.28,Main,Diamante,0,0,0,,Gösterimi mahvetmenize izin vermem!
Dialogue: 0,0:02:46.44,0:02:47.61,Main,Participant,0,0,0,,Ne oluyor anasını?!
Dialogue: 0,0:02:47.61,0:02:50.25,Main,Diamante,0,0,0,,Haydi, saldırın bakalım!
Dialogue: 0,0:02:50.25,0:02:51.21,Main,Participant,0,0,0,,Boğa güreşi mi lan bu?!
Dialogue: 0,0:02:51.21,0:02:52.48,Main,Participant,0,0,0,,Dalga mı geçiyorsun?
Dialogue: 0,0:03:05.42,0:03:10.62,Main,Diamante,0,0,0,,Böyle dalgalandığına bakmayın,\Npelerinim çeliktendir.
Dialogue: 0,0:03:10.62,0:03:14.36,Main,Diamante,0,0,0,,Dalga Dalga Meyvesi yemiş\Nbayrak insanım ben!
Dialogue: 0,0:03:14.36,0:03:20.35,Main,Diamante,0,0,0,,Dokunarak bedenim dahil her şeyi\Nrüzgarda dalgalandırabilirim!
Dialogue: 0,0:03:21.81,0:03:23.24,Main,Diamante,0,0,0,,{\fad(150,150)}Kilit.
Dialogue: 0,0:03:24.55,0:03:26.68,Main,Diamante,0,0,0,,{\fad(150,150)}Corrida Kılıcı!
Dialogue: 0,0:03:36.53,0:03:39.40,Main,Diamante,0,0,0,,Geldiğiniz yere dönseniz iyi edersiniz!
Dialogue: 0,0:03:39.40,0:03:44.57,Main,Diamante,0,0,0,,Finaller için suya da finallere uygun\Nözel Savaşçı Balıklar koyduk.
Dialogue: 0,0:03:46.65,0:03:51.84,Main,Diamante,0,0,0,,Kan kokusunu seven türden balıklar.
Dialogue: 0,0:04:08.62,0:04:09.11,Main,Participant,0,0,0,,Uçu{\fscx250}-{\r}
Dialogue: 0,0:04:26.16,0:04:30.88,Main,Diamante,0,0,0,,Savaşçı Balığın nasıl saldırdığını\Ngördünüz mü sevgili seyirciler?!
Dialogue: 0,0:04:33.83,0:04:39.60,Main,Diamante,0,0,0,,Yarışmacılara ringde bile saldıracaklar!\NHiçbir kurala uymayacak kadar kötüler!
Dialogue: 0,0:04:39.60,0:04:41.84,Main,Diamante,0,0,0,,Vahşilikte üstlerine yok!
Dialogue: 0,0:04:41.84,0:04:45.80,Main,Diamante,0,0,0,,İlk turda gördüğünüz\NSavaşçı Balıklardan çok ama çok farklılar!
Dialogue: 0,0:04:46.51,0:04:50.40,Main,Diamante,0,0,0,,Başka sürülerden alınmış\Nen ölümcül Savaşçı Balıklar bunlar!
Dialogue: 0,0:04:54.09,0:05:00.64,Main,Diamante,0,0,0,,Ve içlerinden biri sırtında\Nmüsabakanın ödülü olan...
Dialogue: 0,0:05:00.64,0:05:03.05,Main,Diamante,0,0,0,,...Mera Mera Meyvesi'ni taşıyor!
Dialogue: 0,0:05:06.15,0:05:08.70,Main,Diamante,0,0,0,,Kurallar basit!
Dialogue: 0,0:05:08.70,0:05:14.36,Main,Diamante,0,0,0,,Meyveyi alıp \Nringde sağ kalabilen kişi galip olacak!
Dialogue: 0,0:05:17.17,0:05:20.57,Main,Announcer,0,0,0,,Final oyunu başlamak üzere artık!
Dialogue: 0,0:05:20.57,0:05:25.24,Main,Announcer,0,0,0,,Kahraman Diamante de dahil\Nbeş kişilik bir serbest dövüş!
Dialogue: 0,0:05:25.24,0:05:27.14,Main,Announcer,0,0,0,,Şeytan Meyvesi için\Nverilen bir mücadele!
Dialogue: 0,0:05:27.14,0:05:29.14,Main,Announcer,0,0,0,,Savaşçı Balıkları da kapsayan\Nölüm kalım savaşı!
Dialogue: 0,0:05:29.73,0:05:34.78,Main,Announcer,0,0,0,,Mera Mera Meyvesi'ni\Nhangisi kazanacak acaba?!
Dialogue: 0,0:05:34.78,0:05:36.01,Main,Announcer,0,0,0,,Öyleyse,...
Dialogue: 0,0:05:36.01,0:05:37.15,Main,Announcer,0,0,0,,...Savaş...
Dialogue: 0,0:05:38.43,0:05:41.59,Main,Announcer,0,0,0,,...başlasın!
Dialogue: 0,0:05:54.03,0:05:55.55,Main,Luffy,0,0,0,,Final savaşı sonunda başladı!
Dialogue: 0,0:05:59.19,0:06:02.47,Main,Luffy,0,0,4,,Sarayın girişi burası mı?
Dialogue: 0,0:05:57.90,0:06:02.47,Captions,Caption,0,0,250,,{\fad(522,0)}Siper Kulesi'nin Önü\NKraliyet Sarayı'nın Altı
Dialogue: 0,0:06:02.47,0:06:04.97,Main,Violet,0,0,0,,Sarayın girişine var daha,...
Dialogue: 0,0:06:04.97,0:06:06.61,Main,Violet,0,0,0,,...burası sarayın altındaki \NSiper Kulesi'nin girişi.
Dialogue: 0,0:06:07.16,0:06:10.77,Main,Violet,0,0,0,,Siper Kulesi'nde de gizli bir giriş mevcut.\NGidelim.
Dialogue: 0,0:06:10.77,0:06:13.72,Main,Violet,0,0,0,,Muhafızlara gözükmeyin.
Dialogue: 0,0:06:13.72,0:06:18.40,Main,Violet,0,0,0,,Olay çıkartacak olursak aile yöneticilerini\Nçağırırlar, burada kısılı kalırız.
Dialogue: 0,0:06:18.40,0:06:23.34,Main,Violet,0,0,0,,Özellikle de Pica isimli adama\Nyakalanacak olursak Doflamingo'yu görmeyi unutun.
Dialogue: 0,0:06:25.21,0:06:27.07,Main,Kin'emon,0,0,0,,Luffy-dono nerede?
Dialogue: 0,0:06:27.07,0:06:29.13,Main,Wicca,0,0,0,,Şuraya bakın!
Dialogue: 0,0:06:32.44,0:06:35.81,Main,Luffy,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:06:36.46,0:06:39.18,Main,Guard,0,0,0,,Bu sazan ne yapıyor?!
Dialogue: 0,0:06:40.92,0:06:42.99,Main,Luffy,0,0,0,,{\fad(150,150)}...Dev...
Dialogue: 0,0:06:47.36,0:06:49.00,Main,Guard,0,0,0,,Bu sazan da neyin nesi?!
Dialogue: 0,0:06:49.00,0:06:49.75,Main,Guard,0,0,0,,Balon balığı falan mı?!
Dialogue: 0,0:06:49.75,0:06:53.61,Main,Luffy,0,0,0,,{\fad(150,150)}...Tabanca!
Dialogue: 0,0:07:01.41,0:07:04.67,Main,Zoro & Kin'emon,0,0,0,,Ne yapıyor bu be?!
Dialogue: 0,0:07:10.08,0:07:10.93,Main,Luffy,0,0,0,,Kapı açık.
Dialogue: 0,0:07:10.93,0:07:12.68,Main,Zoro,0,0,0,,Tek derdimiz oydu zaten!
Dialogue: 0,0:07:12.68,0:07:14.45,Main,Violet,0,0,0,,İnanamıyorum!
Dialogue: 0,0:07:15.06,0:07:16.58,Main,Wicca,0,0,0,,Balon kafalı mısın sen?!
Dialogue: 0,0:07:16.58,0:07:17.36,Main,Violet,0,0,0,,Başka seçeneğimiz yok!
Dialogue: 0,0:07:17.36,0:07:20.90,Main,Violet,0,0,0,,Gidelim. Hem olan oldu, \Ndaha hızlı varırız!
Dialogue: 0,0:07:20.90,0:07:22.82,Main,Luffy,0,0,0,,Bu şeyi çıkartabilir miyim artık?
Dialogue: 0,0:07:22.82,0:07:24.19,Main,Violet,0,0,0,,Ne halt edersen et!
Dialogue: 0,0:07:24.19,0:07:25.49,Main,Kin'emon,0,0,0,,Yapmayın şimdi böyle...
Dialogue: 0,0:07:26.34,0:07:27.63,Main,Grunt,0,0,0,,Bu...
Dialogue: 0,0:07:29.48,0:07:32.64,Main,Grunt,0,0,0,,{\i1}Siper Kulesi'nin\Ngirişinden sesleniyorum!{\i0}
Dialogue: 0,0:07:32.64,0:07:35.93,Main,Grunt,0,0,0,,{\i1}Hasır Şapkalı Luffy\Nkuleye giriş yaptı!{\i0}
Dialogue: 0,0:07:39.26,0:07:43.05,Main,Announcer,0,0,0,,{\i1}Savaşçı Balıklar saldırdıkça\NLucy kolayca sıyrılmasını biliyor!{\i0}
Dialogue: 0,0:07:43.05,0:07:45.51,Main,Announcer,0,0,0,,{\i1}Ne çeviklik ama!{\i0}
Dialogue: 0,0:07:48.53,0:07:50.60,Main,Doflamingo,0,0,0,,Ne diyor bu gerzek?
Dialogue: 0,0:07:51.84,0:07:53.62,Main,Baby 5,0,0,0,,O olduğuna emin misiniz?
Dialogue: 0,0:07:53.90,0:07:55.08,Main,Grunt,0,0,0,,{\i1}Evet!
Dialogue: 0,0:07:55.08,0:07:56.39,Main,Grunt,0,0,0,,{\i1}Kapıyı kırıp geçti...
Dialogue: 0,0:07:56.39,0:07:58.65,Main,Baby 5,0,0,0,,Tamam da\No olmasına imkan yok!
Dialogue: 0,0:07:58.65,0:08:02.86,Main,Baby 5,0,0,0,,Hasır Şapka şu anda Lucy ismiyle\Nkolezyumda savaşıyor!
Dialogue: 0,0:08:07.51,0:08:10.89,Main,Grunt,0,0,0,,{\i1}Siper Kulesi B-2 bölümü,\Nyemekhanenin önünden sesleniyorum!{\i0}
Dialogue: 0,0:08:11.54,0:08:16.05,Main,Grunt,0,0,0,,{\i1}Kuleye giriş yapan kişiler\Nhiç şüphesiz Hasır Şapkalı Luffy...{\i0}
Dialogue: 0,0:08:19.64,0:08:21.81,Main,Grunt,0,0,0,,{\i1}Korsan Avcısı Zoro...{\i0}
Dialogue: 0,0:08:22.17,0:08:25.45,Main,Grunt,0,0,0,,{\i1}Ve Vi-Violet-sama!{\i0}
Dialogue: 0,0:08:32.70,0:08:39.12,Main,Doflamingo,0,0,0,,O zaman kolezyumda savaşan\Nbu kişi de kim?!
Dialogue: 0,0:08:39.12,0:08:42.16,Main,Doflamingo,0,0,0,,Neler oluyor!?
Dialogue: 0,0:08:44.41,0:08:49.04,Captions,,0,0,0,,{\fad(1200,0)\pos(1023,486)}Ticaret Limanı ve\NKraliyet Sarayı arasındaki \Nasansör şu anda yukarı çıkıyor.
Dialogue: 0,0:08:43.43,0:08:49.04,Captions,,350,0,570,,Saray
Dialogue: 0,0:08:43.43,0:08:49.04,Captions,,0,500,350,,Ticaret Limanı
Dialogue: 0,0:09:05.86,0:09:06.99,Captions,Caption,0,0,360,,{\fad(480,0)}Doflamingo Ailesi\N({\fnA}♦{\r}Diamante Ordusu)\NLao G
Dialogue: 0,0:09:09.96,0:09:11.85,Main,Kabu,0,0,0,,Komutan!
Dialogue: 0,0:09:11.85,0:09:12.75,Main,Kabu,0,0,0,,Adi herif!
Dialogue: 0,0:09:15.10,0:09:16.03,Main,Baxcon,0,0,0,,Kabu-san!
Dialogue: 0,0:09:18.54,0:09:20.14,Main,Rampo,0,0,0,,Ne oldu öyle?!
Dialogue: 0,0:09:22.59,0:09:26.78,Main,Lao G,0,0,0,,Aptallar, bir de soruyor musunuz?!
Dialogue: 0,0:09:26.78,0:09:29.55,Main,Lao G,0,0,0,,Madem çok istiyorsunuz anlatayım!
Dialogue: 0,0:09:29.55,0:09:32.92,Main,Baxcom,0,0,0,,Yöneticilerden birinin\Nasansörde olmasını beklemiyordum!
Dialogue: 0,0:09:35.02,0:09:40.08,Main,Lao G,0,0,0,,Oyuncak Evi'nin girişinde\Nnöbet tutman istendiğinde...
Dialogue: 0,0:09:40.08,0:09:46.32,Main,Lao G,0,0,0,,...aşağı inen asansöre binip yeraltı limanının girişinde hazır bir vaziyette bekleyerekten...
Dialogue: 0,0:09:46.32,0:09:48.48,Main,Lao G,0,0,0,,...yeniden asansöre biniverdim.
Dialogue: 0,0:09:48.48,0:09:50.44,Main,Lao G,0,0,0,,Özetle ben...
Dialogue: 0,0:09:50.44,0:09:54.31,Main,Lao G,0,0,0,,...yanlış asansöre "G"iriverdim!
Dialogue: 0,0:09:54.31,0:09:58.01,Main,Lao G,0,0,0,,Saraya ayak basmanıza\Nmüsaade etmeyeceğim!
Dialogue: 0,0:09:58.67,0:10:02.19,Main,Thunder Soldier,0,0,0,,Bizi durduramazsın!\NOraya varacağız!
Dialogue: 0,0:10:03.51,0:10:10.39,Captions,,0,0,250,,{\fad(520,0)}Siper Kulesi B-1\NLuffy'nin Grubu
Dialogue: 0,0:10:05.02,0:10:09.13,Main,Grunt,0,0,4,,{\an8}Hasır Şapkalı Luffy,\NSiper Kulesi'nin B-1 bölümüne vardı!
Dialogue: 0,0:10:10.99,0:10:11.97,Main,Luffy,0,0,0,,Ne taraftan?!
Dialogue: 0,0:10:11.97,0:10:12.92,Main,Violet,0,0,0,,Sola!
Dialogue: 0,0:10:12.92,0:10:14.99,Main,Luffy,0,0,0,,Bomboşmuş!\NGeliyorum, Mingo!
Dialogue: 0,0:10:14.99,0:10:16.69,Main,Zoro,0,0,0,,Savunma epey gerimizde kaldı gibi!
Dialogue: 0,0:10:27.24,0:10:28.16,Main,Luffy,0,0,0,,Bu da ne böyle?
Dialogue: 0,0:10:33.08,0:10:34.25,Main,Zoro,0,0,0,,Taştan canavar falan mı bu?!
Dialogue: 0,0:10:34.25,0:10:35.88,Main,Violet,0,0,0,,Olamaz!\NPica bu!
Dialogue: 0,0:10:37.98,0:10:40.28,Main,Luffy,0,0,0,,Büyükmüş be!\NNe bu böyle?!
Dialogue: 0,0:10:40.28,0:10:43.10,Main,Violet,0,0,0,,Dikkatli olun!\NAilenin üst düzey yöneticilerinden biri o!
Dialogue: 0,0:10:43.10,0:10:44.89,Main,Zoro,0,0,0,,Bu taştan canavar mı yönetici?!
Dialogue: 0,0:10:44.89,0:10:49.96,Main,Violet,0,0,0,,Taş Taş Meyvesi yemiş\Ntaş özümleyebilen insan Pica!
Dialogue: 0,0:10:52.16,0:10:55.12,Main,Zoro,0,0,0,,Yalnızca taştan insan değil gibi.
Dialogue: 0,0:10:55.12,0:11:01.32,Main,Violet,0,0,0,,Taşlarla gönlünce birleşebilen biri\Nyani tüm bu yerin kontrolü...
Dialogue: 0,0:11:02.17,0:11:05.18,Main,Violet,0,0,0,,...onun elinde!
Dialogue: 0,0:11:18.15,0:11:18.96,Main,Luffy,0,0,0,,Duvarlar!
Dialogue: 0,0:11:29.00,0:11:31.72,Captions,,0,0,220,,{\fad(522,0)}Corrida Kolezyumu
Dialogue: 0,0:11:32.90,0:11:37.81,Main,Announcer,0,0,0,,Kana susamış savaşçı balıklar\Nbirbiri ardına dışarı fırlamaya başladı!
Dialogue: 0,0:11:37.81,0:11:40.36,Main,Announcer,0,0,0,,Bu seferki Burgess'i hedef seçmiş kendine!
Dialogue: 0,0:11:44.17,0:11:45.53,Main,Burgess,0,0,0,,{\fad(150,150)}Şok Darbesi...
Dialogue: 0,0:11:47.27,0:11:48.24,Main,Burgess,0,0,0,,{\fad(150,150)}...Dirseği!
Dialogue: 0,0:11:52.82,0:11:55.66,Main,Announcer,0,0,0,,Tüm kolezyum sallanıyor!
Dialogue: 0,0:11:58.06,0:12:01.79,Main,Announcer,0,0,0,,Seyircilerin olduğu bölgede\Ndevasa bir delik açtı!
Dialogue: 0,0:12:01.79,0:12:05.76,Main,Announcer,0,0,0,,Burgess'in dehşet verici\NŞok Darbesi Dirseği!
Dialogue: 0,0:12:05.76,0:12:12.42,Main,Announcer,0,0,0,,Birden üne kavuşan Karasakal ve \Nonu destekleyen on muazzam kaptandan biri olan...
Dialogue: 0,0:12:12.42,0:12:14.65,Main,Announcer,0,0,0,,...Jesus Burgess!
Dialogue: 0,0:12:14.65,0:12:15.76,Main,Audience,0,0,0,,Şerefsiz ya!
Dialogue: 0,0:12:15.76,0:12:17.25,Main,Audience,0,0,0,,Seyirciyi bu işe karıştırmayın!
Dialogue: 0,0:12:22.15,0:12:23.54,Thoughts,Rebecca,0,0,0,,{\i1}Ne yıkım gücü ama...{\i0}
Dialogue: 0,0:12:28.93,0:12:32.62,Main,Announcer,0,0,0,,Derken başka bir savaşçı balık\Nringe doğru yaklaşıyor!
Dialogue: 0,0:12:32.62,0:12:35.22,Main,Announcer,0,0,0,,Ve işte beklenen şey de göründü!
Dialogue: 0,0:12:35.22,0:12:36.17,Main,Announcer,0,0,0,,Bu...
Dialogue: 0,0:12:36.17,0:12:37.71,Main,Announcer,0,0,0,,Burada, burada, burada!
Dialogue: 0,0:12:37.71,0:12:42.14,Main,Announcer,0,0,0,,Bu gördüğünüz Şeytan Meyvesi'ni\Nsırtında taşıyan 01 numaralı savaşçı balık!
Dialogue: 0,0:12:42.79,0:12:43.71,Main,Sabo,0,0,0,,Bu işte!
Dialogue: 0,0:12:47.38,0:12:50.03,Main,Announcer,0,0,0,,Hedefi Bartolomeo mu acaba?!
Dialogue: 0,0:12:50.03,0:12:53.23,Main,Announcer,0,0,0,,Derken yönünü değiştirdi!
Dialogue: 0,0:12:53.23,0:12:55.15,Main,Announcer,0,0,0,,Kimi gözüne kestirdi acaba?!
Dialogue: 0,0:12:57.06,0:12:59.72,Main,Announcer,0,0,0,,01'in hedefindeki kişi kim?!
Dialogue: 0,0:13:00.27,0:13:03.41,Main,Announcer,0,0,0,,Amanın, Rebecca'ya doğru ilerliyor!
Dialogue: 0,0:13:08.50,0:13:10.19,Main,Rebecca,0,0,0,,En azından zincirleri kesmem lazım!
Dialogue: 0,0:13:15.66,0:13:17.46,Main,Sabo,0,0,0,,Tamamdır!\NYakaladım seni!
Dialogue: 0,0:13:17.46,0:13:19.64,Main,Diamante,0,0,0,,Kolay kolay alamazsın onu!
Dialogue: 0,0:13:20.27,0:13:21.20,Main,Sabo,0,0,0,,Savaşmak istiyor anlaşılan.
Dialogue: 0,0:13:21.20,0:13:24.82,Main,Announcer,0,0,0,,Ve işte!\NLucy'yle Diamante karşı karşıyalar!
Dialogue: 0,0:13:24.82,0:13:26.02,Main,Diamante,0,0,0,,Hasır Şapka!
Dialogue: 0,0:13:30.23,0:13:32.60,Main,Burgess,0,0,0,,Sırada ben varım!
Dialogue: 0,0:13:32.60,0:13:35.10,Main,Burgess,0,0,0,,Mera Mera Meyvesi benim olacak!
Dialogue: 0,0:13:36.87,0:13:39.01,Main,Burgess,0,0,0,,O balıkla beraber geberteceğim seni!
Dialogue: 0,0:13:39.01,0:13:41.83,Main,Announcer,0,0,0,,Burgess gene pozisyonunu aldı!
Dialogue: 0,0:13:41.83,0:13:42.96,Main,Audience,0,0,0,,Kaçın!
Dialogue: 0,0:13:42.96,0:13:44.52,Main,Audience,0,0,0,,Gene aynı şeyi yapacak!
Dialogue: 0,0:13:44.52,0:13:46.77,Main,Bartolomeo,0,0,0,,Akıllıya bak arkama saklanıyor!
Dialogue: 0,0:13:48.47,0:13:50.84,Main,Diamante,0,0,0,,Kaçmaya çalışmayacaksın demek ha, Lucy?
Dialogue: 0,0:13:52.55,0:13:53.77,Main,Burgess,0,0,0,,{\fad(150,150)}Şok Dalgası...
Dialogue: 0,0:13:54.76,0:13:56.55,Main,Sabo,0,0,0,,{\fad(150,150)}Ejderha Pençesi!
Dialogue: 0,0:14:15.39,0:14:17.50,Main,Audience,0,0,0,,Lucy!
Dialogue: 0,0:14:18.44,0:14:23.84,Main,Announcer,0,0,0,,Gözlerime inanamıyorum!\NBurgess'in zırhı paramparça oldu!
Dialogue: 0,0:14:25.15,0:14:28.75,Main,Bartolomeo,0,0,0,,Helal, büyük senpaim benim!
Dialogue: 0,0:14:28.75,0:14:33.15,Main,Sabo,0,0,0,,Mera Mera Meyvesi'ni\Nkolay kolay vermeyecekler anlaşılan.
Dialogue: 0,0:14:33.15,0:14:36.44,Main,Diamante,0,0,0,,Savaş stili değişti birden sanki?
Dialogue: 0,0:14:36.44,0:14:39.36,Main,Diamante,0,0,0,,Gerçekten de Hasır Şapka mı bu?
Dialogue: 0,0:14:41.61,0:14:44.35,Captions,,0,0,210,,{\fad(0,613)}Yer Altı Ticaret Limanı\NUsopp ve Diğerleri
Dialogue: 0,0:14:45.01,0:14:47.93,Captions,,0,800,60,,{\pos(239,386)}Şu anki Konum
Dialogue: 0,0:14:48.30,0:14:50.74,Main,Usopp,0,0,0,,Oyuncakların ardı arkası kesilmedi!
Dialogue: 0,0:14:50.74,0:14:55.31,Main,Leo,0,0,0,,Sugar'ın şu anda Yönetim Kulesi'nde\Nolduğunun kanıtı bu.
Dialogue: 0,0:14:55.97,0:14:58.08,Main,Usopp,0,0,0,,Şu dokunaç benzeri şeyler\Nneyin nesi peki?
Dialogue: 0,0:14:59.08,0:15:02.39,Main,Leo,0,0,0,,Merkezde yöneticiler için olan\Nbir asansör mevcut.
Dialogue: 0,0:15:03.79,0:15:06.12,Main,Leo,0,0,0,,Diğer borularsa...
Dialogue: 0,0:15:06.12,0:15:09.60,Main,Leo,0,0,0,,...Büyük İnsanlar'ın yahut\Nkırık oyuncakların düşmesi için.
Dialogue: 0,0:15:10.45,0:15:15.83,Main,Leo,0,0,0,,Dressrosa'nın dört bir yanında\Nhurdalığa uzanan kanallar vardır.
Dialogue: 0,0:15:15.83,0:15:17.61,Main,Leo,0,0,0,,Bu kanallardan atılan kişiler...
Dialogue: 0,0:15:17.61,0:15:21.68,Main,Leo,0,0,0,,...gözlerini Yönetim Kulesi'nin altındaki\Nhurdalıkta açarlar.
Dialogue: 0,0:15:26.77,0:15:30.84,Main,Cavendish,0,0,0,,Lanet olsun, berbat bir şey bu!\NÖnce çöplerin arasına düştük şimdi de bu?!
Dialogue: 0,0:15:30.84,0:15:33.11,Main,Cavendish,0,0,0,,Neler dönüyor burada?!
Dialogue: 0,0:15:33.11,0:15:35.32,Main,Cavendish,0,0,0,,Onu geçtim\Nbu sümük gibi şey de neyin nesi?!
Dialogue: 0,0:15:35.80,0:15:39.98,Main,Cavendish,0,0,0,,Hem zaten hiçbir şeyim yokken beni muayene etmeye çalışmaları epey tuhaf gelmişti!
Dialogue: 0,0:15:40.56,0:15:43.92,Main,Trébol,0,0,0,,Sümük gibi değil o,\Nyapış yapış bir şey!
Dialogue: 0,0:15:44.78,0:15:47.63,Main,Cavendish,0,0,0,,Oha içime girseydin?!\NSen de kimsin?!
Dialogue: 0,0:15:49.29,0:15:55.82,Captions,,0,0,180,,{\fad(520,613)}Yönetim Kulesi
Dialogue: 0,0:15:49.19,0:15:51.31,Main,Trébol,0,0,4,,Yönetim Kulesi'ndesin.
Dialogue: 0,0:15:51.31,0:15:55.99,Main,Trébol,0,0,4,,{\an8}Fakat nedense oyuncaklar birbiri\Nardına dünyaya gelmeye devam ediyor.
Dialogue: 0,0:15:56.02,0:15:58.76,Main,Trébol,0,0,4,,Bu fabrika misali oda...
Dialogue: 0,0:15:58.96,0:16:02.87,Main,Trébol,0,0,4,,...Yönetim Kulesi'nin yanısıra\Nbaşka bir isme de sahip.
Dialogue: 0,0:16:02.87,0:16:05.68,Main,Trébol,0,0,0,,Sugar, neydi öteki isim?
Dialogue: 0,0:16:06.09,0:16:06.93,Main,Sugar,0,0,0,,Yönetim Kulesi.
Dialogue: 0,0:16:06.93,0:16:08.97,Main,Trébol,0,0,0,,Hayır!
Dialogue: 0,0:16:10.45,0:16:14.22,Main,Trébol,0,0,0,,Bak sümüklerim aktı!\NSallanıyorlar!
Dialogue: 0,0:16:14.22,0:16:16.15,Main,Sugar,0,0,0,,İğrenç. Öl.
Dialogue: 0,0:16:16.15,0:16:21.88,Main,Trébol,0,0,4,,{\an8}Ölmeyeceğim! Senin gibi bir veletten\Nemir alacak değilim!
Dialogue: 0,0:16:17.45,0:16:22.96,Captions,,0,0,250,,{\fad(520,0)}Donquixote Ailesi Üst Düzey Yönetici\NTrebol {\fnA-OTF Jun Pro 201}♣{\r\fs35} (Yapışkan Meyvesi)
Dialogue: 0,0:16:22.96,0:16:28.10,Main,Cavendish,0,0,0,,Kıpırdayamıyorum çocuk!\NBu yapışkan sıvıdan kurtarsana beni...
Dialogue: 0,0:16:30.40,0:16:32.49,Main,Sugar,0,0,0,,Anlaşma şöyle...
Dialogue: 0,0:16:32.49,0:16:35.56,Main,Sugar,0,0,0,,İnsanlara zarar vermeyecek...
Dialogue: 0,0:16:35.56,0:16:38.78,Main,Sugar,0,0,0,,...ailenin emirlerinden çıkmayacaksın.
Dialogue: 0,0:16:40.09,0:16:42.14,Main,Cavendish,0,0,0,,Ne diyorsun sen?
Dialogue: 0,0:16:42.14,0:16:44.44,Main,Cavendish,0,0,0,,Bana ne olmuş böyle?!
Dialogue: 0,0:16:44.44,0:16:45.35,Main,Cavendish,0,0,0,,Çabucak...
Dialogue: 0,0:16:45.35,0:16:48.30,Main,Trébol,0,0,0,,Konuşmayı kes de işe koyul!
Dialogue: 0,0:16:49.69,0:16:51.79,Thoughts,Cavendish,0,0,0,,{\i1}Bu da nesi?!\NKonuşamıyorum!{\i0}
Dialogue: 0,0:16:51.79,0:16:54.01,Thoughts,Cavendish,0,0,0,,{\i1}Neden dediklerine karşı gelemiyorum!?{\i0}
Dialogue: 0,0:16:54.01,0:16:57.56,Flashbacks,Sugar,0,0,0,,{\fad(396,0)}Ailenin emirlerinden çıkmayacaksın.
Dialogue: 0,0:16:57.56,0:16:59.43,Thoughts,Cavendish,0,0,0,,{\i1}Anlaşma mı?!{\i0}
Dialogue: 0,0:17:01.11,0:17:04.46,Main,Trébol,0,0,0,,Seni kimse hatırlamıyor artık!
Dialogue: 0,0:17:04.46,0:17:07.81,Main,Trébol,0,0,0,,Ben bile kim olduğunu unuttum!
Dialogue: 0,0:17:07.81,0:17:13.10,Main,Trébol,0,0,0,,Doffy için ölene dek çalışıp\Nsavaşacaksın!
Dialogue: 0,0:17:15.45,0:17:18.96,Thoughts,Cavendish,0,0,0,,{\i1}Ne oluyor be,\Noyuncağa dönüştüm!{\i0}
Dialogue: 0,0:17:18.96,0:17:22.65,Main,Trébol,0,0,0,,O kapıdan çıkınca limana varacaksın!
Dialogue: 0,0:17:25.14,0:17:27.76,Main,Grunt,0,0,0,,Yeni biri ha?\NGel seni çalışacağın yere götüreyim.
Dialogue: 0,0:17:28.08,0:17:29.88,Thoughts,Cavendish,0,0,0,,{\i1}Neresi burası?!{\i0}
Dialogue: 0,0:17:30.73,0:17:32.68,Main,Grunt,0,0,0,,Kıpırdayın!
Dialogue: 0,0:17:32.68,0:17:35.05,Main,Grunt,0,0,0,,Geldik, çalış bakalım!
Dialogue: 0,0:17:37.63,0:17:42.24,Thoughts,Cavendish,0,0,0,,{\i1}Korsanım lan ben!?\NKabus falan bu herhâlde! Uyanmam lazım!
Dialogue: 0,0:17:43.70,0:17:46.21,Main,Grunt,0,0,0,,Daha ne duruyorsun?!
Dialogue: 0,0:17:46.21,0:17:48.24,Thoughts,Cavendish,0,0,0,,{\i1}Hayatımın sonuna kadar burada çalışamam!{\i0}
Dialogue: 0,0:17:48.24,0:17:54.06,Thoughts,Cavendish,0,0,0,,{\i1}Olamaz ya, bu hareketli tüyler ürperten\Noyuncaklarla beraber çalışmak istemiyorum!{\i0}
Dialogue: 0,0:17:56.44,0:17:59.60,Thoughts,Sai,0,0,0,,{\i1}Demek silahları buradan satıyorlar?!{\i0}
Dialogue: 0,0:17:59.60,0:18:03.39,Thoughts,Sai,0,0,0,,{\i1}Ama emirlerine karşı gelemiyorum!
Dialogue: 0,0:18:03.39,0:18:06.83,Thoughts,Hack,0,0,0,,{\i1}Yeraltında böyle bir liman olduğuna\Ninanamıyorum!{\i0}
Dialogue: 0,0:18:06.83,0:18:09.06,Thoughts,Hack,0,0,0,,{\i1}Bir telefon edebilseydim...{\i0}
Dialogue: 0,0:18:09.06,0:18:10.61,Thoughts,Hack,0,0,0,,{\i1}Koala aramamı bekliyor!{\i0}
Dialogue: 0,0:18:10.61,0:18:13.09,Thoughts,Hack,0,0,0,,{\i1}Bir şekilde\Nbedenime söz geçiremem mi acaba?!{\i0}
Dialogue: 0,0:18:13.40,0:18:17.18,Thoughts,Elizabello,0,0,0,,{\i1}Prodence'in kralıyım ben be,\Nlanet olası Doflamingo!{\i0}
Dialogue: 0,0:18:17.18,0:18:20.61,Thoughts,Elizabello,0,0,0,,{\i1}Ölene kadar böyle kalacakmışım!\NHayatta olmaz!{\i0}
Dialogue: 0,0:18:20.61,0:18:22.35,Thoughts,Elizabello,0,0,0,,{\i1}Birileri kurtarsın beni!
Dialogue: 0,0:18:30.35,0:18:32.56,Main,Robin,0,0,0,,Trebol'la Sugar olmalı bunlar.
Dialogue: 0,0:18:32.56,0:18:34.19,Main,Usopp,0,0,0,,Gerçekten de çocukmuş!
Dialogue: 0,0:18:34.19,0:18:35.59,Main,Leo,0,0,0,,Evet.
Dialogue: 0,0:18:35.59,0:18:39.33,Main,Leo,0,0,0,,Üzümleri çok sevdiğinden hep yer.
Dialogue: 0,0:18:39.33,0:18:41.00,Main,Usopp,0,0,0,,Eee?
Dialogue: 0,0:18:41.00,0:18:42.63,Main,Leo,0,0,0,,Planımız bunun üzerine kurulu.
Dialogue: 0,0:18:42.63,0:18:44.40,Main,Leo,0,0,0,,Bakın!
Dialogue: 0,0:18:45.02,0:18:49.20,Main,Leo,0,0,0,,Bu dünyanın en acı baharatı olan\NTatababasco sosu!
Dialogue: 0,0:18:49.20,0:18:51.45,Main,Leo,0,0,0,,Üzüme benzettik.
Dialogue: 0,0:18:52.64,0:18:54.95,Main,Usopp,0,0,0,,Bunu mu yedireceksiniz ona?
Dialogue: 0,0:18:55.36,0:18:57.92,Main,Leo,0,0,0,,Bunu o sepete koyacağım!
Dialogue: 0,0:18:57.92,0:19:01.72,Main,Leo,0,0,0,,Bunu Tontatta Kabilesi'ndeki\N50 kişi üzerinde denedik...
Dialogue: 0,0:19:01.72,0:19:05.87,Main,Leo,0,0,0,,...ve tamamı bayıldı,\N18'i neredeyse ölüyordu!
Dialogue: 0,0:19:08.20,0:19:09.49,Main,Usopp,0,0,0,,Denediniz bir de?!
Dialogue: 0,0:19:09.49,0:19:12.10,Main,Leo,0,0,0,,İşimizi şansa bırakmak istemedik!\NSugar'a yedireceğiz bunu!
Dialogue: 0,0:19:13.63,0:19:15.88,Main,Usopp,0,0,0,,Pekâlâ öyleyse! Leo, git haydi!
Dialogue: 0,0:19:15.88,0:19:17.80,Main,Usopp,0,0,0,,Gözüm üzerinde olacak!
Dialogue: 0,0:19:17.80,0:19:20.11,Main,Leo,0,0,0,,İçim rahatladı!
Dialogue: 0,0:19:20.11,0:19:22.56,Thoughts,Usopp,0,0,0,,{\i1}İşler ters giderse tüyerim.{\i0}
Dialogue: 0,0:19:23.51,0:19:24.87,Main,Inhel,0,0,0,,İyi şanslar, Leo!
Dialogue: 0,0:19:26.38,0:19:28.75,Main,Usopp,0,0,0,,Bağırmayın!
Dialogue: 0,0:19:28.75,0:19:30.82,Main,Bian,0,0,0,,Trebol'a dikkat et!
Dialogue: 0,0:19:30.82,0:19:31.98,Main,Dwarves,0,0,0,,{\i1}Dikkat et!
Dialogue: 0,0:19:31.98,0:19:34.08,Main,Usopp,0,0,0,,Bağırmayın diyorum!
Dialogue: 0,0:19:34.59,0:19:36.35,Main,Leo,0,0,0,,Hiç sorun değil!
Dialogue: 0,0:19:36.35,0:19:39.17,Main,Leo,0,0,0,,Hazırlanın!
Dialogue: 0,0:19:39.60,0:19:41.74,Main,Leo,0,0,0,,Sugar'ın çığlıklarını duyduğunuz vakit...
Dialogue: 0,0:19:42.29,0:19:47.25,Main,Leo,0,0,0,,İşte o zaman ülkedeki tüm oyuncaklar\Nnormale dönecekler!
Dialogue: 0,0:19:47.99,0:19:51.84,Main,Leo,0,0,0,,Ve unutulmuş tüm anılar\Ninsanlara geri dönecek!
Dialogue: 0,0:19:51.84,0:19:54.14,Main,Leo,0,0,0,,Yaptığı tüm şeytanlıklar\Nsu yüzüne çıkınca...
Dialogue: 0,0:19:54.66,0:19:56.16,Main,Leo,0,0,0,,...korsan Doflamingo...
Dialogue: 0,0:19:57.31,0:19:59.61,Main,Leo,0,0,0,,...gerçek yüzünü de gösterecek!
Dialogue: 0,0:19:59.61,0:20:03.09,Main,Leo,0,0,0,,Gidiyorum!\NDostlarımızı kurtaralım!
Dialogue: 0,0:20:04.96,0:20:07.28,Main,Usopp,0,0,0,,Bağırmasanıza ya!
Dialogue: 0,0:20:07.29,0:20:10.39,Main,Leo,0,0,0,,Kral Riku'nun krallığını geri alacağız!
Dialogue: 0,0:20:12.01,0:20:13.87,Main,Usopp,0,0,0,,Çok...
Dialogue: 0,0:20:13.87,0:20:17.71,Main,Usopp,0,0,0,,...bağırıyorsunuz be!
