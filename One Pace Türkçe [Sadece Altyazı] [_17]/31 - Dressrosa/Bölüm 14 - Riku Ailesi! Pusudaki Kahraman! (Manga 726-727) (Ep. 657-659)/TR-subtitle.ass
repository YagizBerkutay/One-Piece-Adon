Dialogue: 0,0:01:31.40,0:01:39.99,Title,,0,0,0,,{\fad(2000,2000)}Riku Ailesi!\NPusudaki Kahraman!
Dialogue: 0,0:01:42.93,0:01:44.98,Main,Sai,0,0,0,,Aşağı düşenlerin ardı kesilmedi!
Dialogue: 0,0:01:54.58,0:01:57.72,Main,Boo,0,0,0,,İhtiyar!\NAğabeyim de burada!
Dialogue: 0,0:01:58.50,0:01:59.20,Main,Boo,0,0,0,,İğrenç Kokuyor!
Dialogue: 0,0:01:59.50,0:02:01.17,Main,Chinjao,0,0,0,,Sen de düştün demek, Boo?
Dialogue: 0,0:02:03.86,0:02:05.58,Main,Boo,0,0,0,,Neredeyiz böyle?
Dialogue: 0,0:02:05.58,0:02:07.88,Main,Boo,0,0,0,,Oyuncak ve çöple dolu etraf...
Dialogue: 0,0:02:07.88,0:02:10.44,Main,Sai,0,0,0,,Biz de aynı şeyi merak ediyoruz.
Dialogue: 0,0:02:10.44,0:02:13.45,Main,Sai,0,0,0,,Oradan çekilsen iyi edersin,\Nyeni biri düştü düşecek.
Dialogue: 0,0:02:13.48,0:02:15.18,Gladiator,,0,0,0,,{\pos(374,562)\fad(100,0)}Eski Gladyatör Ricky
Dialogue: 0,0:02:15.55,0:02:19.82,Main,Ricky,0,0,0,,Krallığın altında böyle büyük bir çöp\Nyığınının olacağı kimin aklına gelirdi?
Dialogue: 0,0:02:23.05,0:02:25.73,Main,Tank,0,0,0,,Yanılıyorsam bağışla fakat...
Dialogue: 0,0:02:27.89,0:02:30.73,Gladiator,,0,0,180,,{\fad(100,0)}Dressrosa Ordusu Komutanı\NTank Lepanto
Dialogue: 0,0:02:27.89,0:02:30.73,Main,Tank,0,0,0,,{\an8}İçimden bir ses...
Dialogue: 0,0:02:32.46,0:02:34.54,Main,Tank,0,0,0,,...senin...
Dialogue: 0,0:02:34.54,0:02:36.64,Main,Tank,0,0,0,,Daha doğrusu siz...
Dialogue: 0,0:02:37.70,0:02:41.24,Main,Tank,0,0,0,,...Kral Riku-sama'sınız değil mi?
Dialogue: 0,0:02:42.92,0:02:44.91,Main,Guy,0,0,0,,Kral Riku mu?
Dialogue: 0,0:02:44.91,0:02:47.98,Main,Abdullah,0,0,0,,Kral Riku mu?\NSaçmalamasana!
Dialogue: 0,0:02:47.98,0:02:50.24,Main,Abdullah,0,0,0,,Ölmemiş miydi o?
Dialogue: 0,0:02:52.37,0:02:55.22,Main,Jeet,0,0,0,,Dressrosa'nın önceki kralının...
Dialogue: 0,0:02:55.22,0:02:59.16,Main,Jeet,0,0,0,,...büyük zalimlikler yapmasının ardından\Nöldürüldüğünü duymuştum!
Dialogue: 0,0:03:01.22,0:03:07.36,Main,Riku,0,0,0,,Bu kadar derinlere düştüm madem\Nkendimi gizlememe de gerek yok sanırım.
Dialogue: 0,0:03:10.34,0:03:12.50,Main,Riku,0,0,0,,Haklısın.
Dialogue: 0,0:03:12.50,0:03:17.44,Main,Riku,0,0,0,,Fakat bana artık kral diye seslenme,\NYüzbaşı Tank!
Dialogue: 0,0:03:20.81,0:03:24.03,Captions,,0,0,180,,{\fad(300,300)}Dressrosa Eski Kralı
Dialogue: 0,0:03:22.16,0:03:24.03,Main,Gladiator,0,0,5,,{\fad(0,300)}Kral Riku bu!
Dialogue: 0,0:03:24.01,0:03:27.67,Captions,,0,0,250,,{\fad(200,320)}Riku III. Doldo\N(Rebecca'nın Dedesi)
Dialogue: 0,0:03:25.50,0:03:28.05,Main,Gladiator,0,0,5,,Yaşıyormuş!
Dialogue: 0,0:03:30.72,0:03:34.09,Main,Tank,0,0,0,,Kral Riku-sama, sağ olmanıza\Nne kadar sevindim bilemezsiniz!
Dialogue: 0,0:03:34.09,0:03:37.62,Main,Riku,0,0,0,,Artık sıradan bir ihtiyarım.
Dialogue: 0,0:03:37.62,0:03:41.98,Main,Riku,0,0,0,,Kendi torununu bile kurtaramayan\Ngünahkar bir ihtiyar.
Dialogue: 0,0:03:41.98,0:03:44.02,Main,Tank,0,0,0,,Çok uzun zaman oldu efendim!
Dialogue: 0,0:03:44.96,0:03:47.51,Main,Tank,0,0,0,,Ben artık...
Dialogue: 0,0:03:47.51,0:03:49.21,Main,Tank,0,0,0,,...Doflamingo'nun...
Dialogue: 0,0:03:49.21,0:03:52.62,Main,Riku,0,0,0,,Söyleme! Biliyorum.
Dialogue: 0,0:03:53.76,0:03:56.75,Main,Riku,0,0,0,,Viola'ya göz kulak oluyordun.
Dialogue: 0,0:03:57.12,0:04:01.83,Main,Riku,0,0,0,,Senin gibi hürmetkâr birinden\Nnasıl şüphe duyarım?
Dialogue: 0,0:04:01.83,0:04:04.66,Main,Riku,0,0,0,,Eminim senin için de\Nhiç kolay olmamıştır.
Dialogue: 0,0:04:04.66,0:04:07.36,Main,Tank,0,0,0,,Hayır, sizin katlanmak zorunda \Nolduklarınızın yanında...
Dialogue: 0,0:04:07.74,0:04:10.90,Main,Elizabello,0,0,0,,Gözlerime inanamıyorum, Kral Riku!
Dialogue: 0,0:04:10.90,0:04:13.77,Main,Riku,0,0,0,,Prodence Kralı!
Dialogue: 0,0:04:15.68,0:04:17.30,Main,Elizabello,0,0,0,,Görüşmeyeli epey olmuştu!
Dialogue: 0,0:04:17.30,0:04:20.96,Main,Elizabello,0,0,0,,Başımız dertteyken\Npek çok kez ülkemi kurtarmıştın!
Dialogue: 0,0:04:20.96,0:04:22.44,Main,Elizabello,0,0,0,,Hayatta olmana çok sevindim!
Dialogue: 0,0:04:23.84,0:04:26.85,Main,Elizabello,0,0,0,,Sen gittikten sonra...
Dialogue: 0,0:04:26.85,0:04:31.53,Main,Elizabello,0,0,0,,...civardaki ülkeler arasında denge bozuldu\Nve savaşların ardı arkası kesilmez oldu!
Dialogue: 0,0:04:31.53,0:04:32.82,Main,Elizabello,0,0,0,,Bıktım usandım artık.
Dialogue: 0,0:04:32.82,0:04:35.02,Main,Sai,0,0,0,,Dur bakalım, Elizabello!
Dialogue: 0,0:04:35.76,0:04:40.93,Main,Sai,0,0,0,,Sen belki bıktın usandın ama kimileri ağlarken\Nkimileri de katıla katıla gülüyor buna!
Dialogue: 0,0:04:43.46,0:04:48.40,Main,Sai,0,0,0,,Keza ülkeleri savaşmaya tahrik edip\Nmilyonlar kazanan birisi var!
Dialogue: 0,0:04:48.64,0:04:52.30,Main,Boo,0,0,0,,Bunu da savaştaki ülkelere\Nsayısız silah satarak yapıyor o kişi!
Dialogue: 0,0:04:58.24,0:05:01.22,Main,Chinjao,0,0,0,,Joker denen şu simsar...
Dialogue: 0,0:05:01.22,0:05:04.29,Main,Chinjao,0,0,0,,Ki bu Doflamingo'nun takma adı.
Dialogue: 0,0:05:04.29,0:05:09.58,Main,Chinjao,0,0,0,,Fakat bu silahları nerede üretip\Nnerede depoladıklarını bilmiyoruz.
Dialogue: 0,0:05:09.58,0:05:12.54,Main,Chinjao,0,0,0,,Ülkemiz Kano Krallığı\Nbüyük bir savaşın içinde...
Dialogue: 0,0:05:12.56,0:05:16.75,Main,Chinjao,0,0,0,,...ve düşmanın sürekli silah alıp\Ngüçlenmesi bizim için hiç hoş olmuyor.
Dialogue: 0,0:05:17.12,0:05:20.63,Main,Sai,0,0,0,,Kolezyum turnuvasına katılmamız, \Naraştırmalarımızın yalnızca bir parçasıydı.
Dialogue: 0,0:05:21.28,0:05:28.61,Main,Sai,0,0,0,,Happo Donanması'nın asıl amacı kralımızın emriyle bu silah kaçakçılığı tezgahına bir son vermektir!
Dialogue: 0,0:05:28.61,0:05:33.37,Main,Sai,0,0,0,,Kral Riku, yaptığın aptalca şey sonunda\NDoflamingo'nun kral olması yüzünden...
Dialogue: 0,0:05:33.37,0:05:36.67,Main,Sai,0,0,0,,...civar ülkeler kan ağlıyor!
Dialogue: 0,0:05:36.67,0:05:39.21,Main,Dagama,0,0,0,,Aynen öyle, Elizabello-sama!
Dialogue: 0,0:05:40.43,0:05:44.94,Main,Dagama,0,0,0,,Geçmişte Dressrosa'nın bize\Nbüyük iyilikleri dokunmuş olabilir...
Dialogue: 0,0:05:44.94,0:05:48.60,Main,Dagama,0,0,0,,...fakat artık o adam\Nbizim için hiçbir şey!
Dialogue: 0,0:05:48.60,0:05:50.82,Main,Dagama,0,0,0,,Kral Riku adı artık...
Dialogue: 0,0:05:50.82,0:05:53.20,Main,Tank,0,0,0,,Kapa çeneni, Dagama!
Dialogue: 0,0:05:54.34,0:05:58.73,Main,Tank,0,0,0,,10 yıl önce gerçekte neler olduğunu \No gün yaşanan trajediyi hiçbiriniz bilmiyorsunuz!
Dialogue: 0,0:05:58.73,0:06:01.06,Main,Tank,0,0,0,,O yüzden kralımız konusunda\Natıp tutma hakkınız yok!
Dialogue: 0,0:06:01.06,0:06:03.31,Main,Riku,0,0,0,,Tank, boşver.\NArtık bir önemi yok!
Dialogue: 0,0:06:04.36,0:06:08.51,Main,Gladiator,0,0,0,,Kral Riku-sama, \Nben de ordunun bir askeriydim!
Dialogue: 0,0:06:08.51,0:06:10.27,Main,Gladiator,0,0,0,,Ben de!
Dialogue: 0,0:06:10.27,0:06:12.82,Main,Gladiator,0,0,0,,Ben de öyleydim, Kral Riku-sama!
Dialogue: 0,0:06:18.79,0:06:19.36,Main,Gladiator,0,0,0,,Ne oluyor?!
Dialogue: 0,0:06:19.70,0:06:22.25,Main,Gladiator,0,0,0,,Oyuncaklar hareket etmeye başladılar!
Dialogue: 0,0:06:22.25,0:06:25.40,Main,Gladiator,0,0,0,,Bozuk değil miymiş bunlar?!
Dialogue: 0,0:06:40.48,0:06:46.23,Main,Gladiator,0,0,0,,Dressrosa'nın eski askerlerini geçtim \Noyuncaklar bile önünde diz çöküyorlar!
Dialogue: 0,0:06:46.23,0:06:47.69,Main,Gladiator,0,0,0,,Neler oluyor?!
Dialogue: 0,0:06:47.69,0:06:50.91,Main,Gladiator,0,0,0,,Herkesin Kral Riku'dan\Nnefret ettiğini sanıyordum!
Dialogue: 0,0:06:57.09,0:07:00.77,Main,Hack,0,0,0,,Arenanın altında böyle devasa bir çukur varsa daha derinlerde kimbilir...
Dialogue: 0,0:07:00.77,0:07:03.29,Main,Hack,0,0,0,,{\i1}...daha ne tür sırlar gizlidir.{\i0}
Dialogue: 0,0:07:03.29,0:07:04.51,Main,Woman,0,0,0,,Anlaşılmıştır.
Dialogue: 0,0:07:04.51,0:07:06.20,Main,Woman,0,0,0,,Araştırmaya devam et.
Dialogue: 0,0:07:12.57,0:07:13.29,Main,Boo,0,0,0,,Ağabey!
Dialogue: 0,0:07:13.68,0:07:14.84,Main,Sai,0,0,0,,Ne oluyor ya?!
Dialogue: 0,0:07:14.84,0:07:16.88,Main,Sai,0,0,0,,Bu sefer ne oluyor?!
Dialogue: 0,0:07:23.59,0:07:25.07,Main,Chinjao,0,0,0,,Sai!
Dialogue: 0,0:07:25.07,0:07:26.09,Main,Boo,0,0,0,,Ağabey!
Dialogue: 0,0:07:36.14,0:07:38.20,Main,Trebol,0,0,0,,Hey, hey...
Dialogue: 0,0:07:38.20,0:07:40.44,Main,Trebol,0,0,0,,Bitti artık, gidebilirsin.
Dialogue: 0,0:07:41.17,0:07:47.23,Main,Trebol,0,0,0,,İnsanlara zarar verme ve \Nailenin emirlerine uy.
Dialogue: 0,0:07:48.28,0:07:50.38,Main,Trebol,0,0,0,,Anlaştık mı?
Dialogue: 0,0:07:50.79,0:07:56.41,Main,Trebol,0,0,0,,Şu kapıdan çıkar çıkmaz\Nfabrikaya ve limana varacaksın.
Dialogue: 0,0:07:56.41,0:07:57.66,Main,Trebol,0,0,0,,Git haydi.
Dialogue: 0,0:07:58.52,0:08:02.79,Main,Trebol,0,0,0,,Konuşmak yok!\NSağlam çalış!
Dialogue: 0,0:08:03.60,0:08:09.13,Thoughts,Trebol,0,0,0,,{\i1}Yarışmacıların hepsi de güçlüydü,\Nkolay kolay kırılmazlar!{\i0}
Dialogue: 0,0:08:09.13,0:08:11.29,Thoughts,Sai,0,0,0,,{\i1}Neler oluyor?!
Dialogue: 0,0:08:11.29,0:08:14.31,Thoughts,Sai,0,0,0,,{\i1}Vücudumu kontrol edemiyorum!
Dialogue: 0,0:08:14.31,0:08:16.84,Thoughts,Sai,0,0,0,,{\i1}Bana emrettiği şeyden başka\Nbir şey yapamıyorum!{\i0}
Dialogue: 0,0:08:17.15,0:08:22.65,Thoughts,Sai,0,0,0,,{\i1}Ne oluyor böyle bana?!{\i0}
Dialogue: 0,0:08:23.43,0:08:25.57,Main,Luffy,0,0,3,,Başardı!
Dialogue: 0,0:08:23.44,0:08:25.57,Captions,,0,0,220,,{\fad(200,0)}Kolezyum\NTutsak Gladyatör Hücreleri
Dialogue: 0,0:08:28.34,0:08:31.42,Main,Luffy,0,0,0,,Biri daha geliyor!\NHaydi Rebecca!
Dialogue: 0,0:08:32.42,0:08:35.42,Main,Luffy,0,0,0,,O değil de buradan izlemesi zor yahu.
Dialogue: 0,0:08:35.42,0:08:37.63,Main,Luffy,0,0,0,,Ben gidip daha yakından tezahürat edeyim!
Dialogue: 0,0:08:39.14,0:08:44.26,Main,Luffy,0,0,0,,Yalnız bu ülkede herkes\Nbana mutlu görünmüştü ama...
Dialogue: 0,0:08:44.26,0:08:46.58,Main,Luffy,0,0,0,,...şimdi sizi görünce\Npek de öyle olmadığını anlıyorum.
Dialogue: 0,0:08:46.58,0:08:51.11,Main,Prisoner,0,0,0,,Senin gördüğün kazananların yaşadığı\Nışıl ışıl dünyaydı.
Dialogue: 0,0:08:51.11,0:08:57.58,Main,Prisoner,0,0,0,,Doflamingo ona itaat edenleri "kazanan",\Netmeyenleri "kaybeden" olarak nitelendirir.
Dialogue: 0,0:08:58.75,0:09:02.48,Main,Prisoner,0,0,0,,Aynı Dünya Hükümeti gibi!
Dialogue: 0,0:09:03.51,0:09:07.42,Main,Prisoner,0,0,0,,Ve bu söz dinlemez kaybedenler de\Nçöp gibidirler.
Dialogue: 0,0:09:07.42,0:09:13.58,Main,Prisoner,0,0,0,,Çöpü karanlık bir yere saklarsan\Ndışarıdan her şey güzel görünür.
Dialogue: 0,0:09:15.91,0:09:18.45,Flashbacks,Man,0,0,0,,Hazine avı!
Dialogue: 0,0:09:23.82,0:09:27.48,Main,Luffy,0,0,0,,Büyüdüğüm ülkeyi andırıyor.
Dialogue: 0,0:09:27.48,0:09:32.12,Main,Prisoner,0,0,0,,Bir kere içine şüphe düştümü ülkede aslında pek çok tuhaf şeyin döndüğünü de görmeye başlarsın.
Dialogue: 0,0:09:32.12,0:09:35.75,Main,Prisoner,0,0,0,,Keza çok daha büyük bir karanlığın\Ngizli olduğunu düşünüyoruz.
Dialogue: 0,0:09:36.36,0:09:38.46,Main,Prisoner,0,0,0,,Dikkatli olsan iyi edersin.
Dialogue: 0,0:09:38.46,0:09:40.13,Main,Luffy,0,0,0,,Tamamdır! Görüşürüz!
Dialogue: 0,0:09:55.89,0:09:58.51,Main,Bartolomeo,0,0,0,,Luffy-senpai!
Dialogue: 0,0:10:01.40,0:10:08.50,Captions,,0,0,180,,{\fad(1000,1000)}Çiçek Bahçesi - Kral Riku Ordusu Karargahı
Dialogue: 0,0:10:01.71,0:10:06.85,Main,Gancho,0,0,0,,{\an8}Uzun zaman önce\NTontatta Kabilesi'nin üyeleri...
Dialogue: 0,0:10:06.85,0:10:12.00,Main,Gancho,0,0,0,,{\an8}...kendi ülkelerinde olmayan kaynakları\Naramak için denize açılmışlar.
Dialogue: 0,0:10:13.05,0:10:18.86,Main,Gancho,0,0,0,,Fakat orada Büyük İnsanlar tarafından keşfedilip \Nsoylarının tükenmesi tehdidiyle karşı karşıya kalmışlar.
Dialogue: 0,0:10:20.17,0:10:21.85,Flashbacks,Person,0,0,0,,Buldum onları!
Dialogue: 0,0:10:21.85,0:10:23.48,Flashbacks,Person,0,0,0,,Küçük İnsanlar burada!
Dialogue: 0,0:10:25.83,0:10:30.58,Main,Gancho,0,0,0,,Fakat günün birinde komşu ülkelerden\Nbiri olan Dressrosa'nın kralı...
Dialogue: 0,0:10:30.58,0:10:33.22,Main,Gancho,0,0,0,,...kendisi için biraz çalışmaları karşılığında...
Dialogue: 0,0:10:33.65,0:10:39.35,Main,Gancho,0,0,0,,...onlara kaynak ve güvenlik\Nsağlayacağı sözünü vermiş.
Dialogue: 0,0:10:40.55,0:10:45.06,Main,Gancho,0,0,0,,Bu kralın adı Don Quixote imiş!
Dialogue: 0,0:10:45.72,0:10:54.65,Main,Gancho,0,0,0,,Bu da 900 yıl öncesine kadar sürmüş olan\NTontatta Kabilesi'nin en kötü zamanlarına...
Dialogue: 0,0:10:55.33,0:10:58.58,Main,Gancho,0,0,0,,...kölelik çağına yol açmış.
Dialogue: 0,0:10:58.58,0:11:04.98,Main,Gancho,0,0,0,,Kraliyet ailesinin acımasızlığını belgeleyen\Ngünümüze kadar erişmiş evraklar mevcut.
Dialogue: 0,0:11:05.40,0:11:07.45,Main,Gancho,0,0,0,,Şeytandan farkları yok!
Dialogue: 0,0:11:11.08,0:11:16.46,Main,Gancho,0,0,0,,Atalarımız gözlerden uzak yeraltında\Nçalıştıkça çalışmaya zorlanırken...
Dialogue: 0,0:11:16.46,0:11:23.78,Main,Gancho,0,0,0,,...Büyük İnsanlar ise Tontatta Kabilesi'nin\Nsağladığı zenginlikle müsrif bir yaşam sürmüşler.
Dialogue: 0,0:11:27.80,0:11:33.77,Main,Gancho,0,0,0,,Takip eden Kayıp Asra ait kayıtlar\Nmevcut değil yani olanları bilmiyoruz...
Dialogue: 0,0:11:33.77,0:11:39.24,Main,Gancho,0,0,0,,...fakat 800 yıl önce\NDressrosa tahtına yeni bir kral geçmiş.
Dialogue: 0,0:11:39.24,0:11:41.51,Main,Dwarves,0,0,0,,{\i1}Kral Riku!{\i0}
Dialogue: 0,0:11:47.73,0:11:51.75,Main,Dwarves,0,0,0,,Asırlar boyunca Küçük\Nİnsanlar'ın yeraltında...
Dialogue: 0,0:11:51.77,0:11:56.68,Main,Dwarves,0,0,0,,...insanlardan çok aşağı bir şekilde\Nmuamele gördüğünü duyan Kral Riku...
Dialogue: 0,0:11:56.78,0:12:03.10,Main,Dwarves,0,0,0,,...gözyaşları eşliğinde\Nsonsuz özürler dilemiş.
Dialogue: 0,0:12:05.19,0:12:10.17,Main,Dwarves,0,0,0,,Sonra da tahta geçen bu yeni kral kabilenin yaşadıklarını telafi etmek için bir plan tasarlamış!
Dialogue: 0,0:12:12.54,0:12:19.44,Main,Dwarves,0,0,0,,Onlara bu ülkeden ihtiyaçları olan her şeyi alabileceklerini söylemiş.
Dialogue: 0,0:12:19.44,0:12:21.87,Main,Dwarves,0,0,0,,Çalışmalarına gerek kalmadan hem de!
Dialogue: 0,0:12:27.79,0:12:31.00,Main,Gancho,0,0,0,,Kral meydana gelen\Nolaylara perilerin işidir deyip...
Dialogue: 0,0:12:31.02,0:12:34.23,Main,Gancho,0,0,0,,...halkını bu olaylara gülüp\Ngeçmeye teşvik ederek...
Dialogue: 0,0:12:34.23,0:12:39.04,Main,Gancho,0,0,0,,...bu periler efsanesini\Nkrallığa başarılı bir şekilde yaymış.
Dialogue: 0,0:12:40.26,0:12:42.77,Main,Franky,0,0,0,,Shodai Kral Riku ne harika biriymiş!
Dialogue: 0,0:12:42.77,0:12:46.29,Main,Gancho,0,0,0,,Hoşgörülü Riku Ailesi\Ntarafından yönetilen ülke...
Dialogue: 0,0:12:46.31,0:12:50.01,Main,Gancho,0,0,0,,...başları dertte olduğunda komşu ülkelerden\Nyardımını hiçbir şekilde esirgememiş.
Dialogue: 0,0:12:50.41,0:12:53.54,Main,Gancho,0,0,0,,Ülkenin çok zengin olduğunu söyleyemem...
Dialogue: 0,0:12:53.54,0:12:57.39,Main,Gancho,0,0,0,,...fakat gülücüklerin hiç kesilmediği\Nülke olarak ün yapmış.
Dialogue: 0,0:12:58.00,0:13:02.31,Main,Gancho,0,0,0,,Atalarımız Kral Riku'nun\Nbu iyi niyetine hitaben...
Dialogue: 0,0:13:02.31,0:13:10.33,Main,Gancho,0,0,0,,...gönüllü bir biçimde bu ülkeyi\Nyeşiller ve çiçeklerle bezemişler.
Dialogue: 0,0:13:10.77,0:13:13.32,Main,Gancho,0,0,0,,Bu şekilde de Tontatta Krallığı ve...
Dialogue: 0,0:13:13.34,0:13:17.61,Main,Gancho,0,0,0,,...tahtı alan Riku Ailesi arasındaki\Nbağlar 800 yılda oldukça derinleşmiş.
Dialogue: 0,0:13:20.25,0:13:29.28,Main,Gancho,0,0,0,,Fakat 900 yılın ardından Don Quixote Ailesi varisi Doflamingo geri döndü...
Dialogue: 0,0:13:29.28,0:13:34.66,Main,Gancho,0,0,0,,...ve o korkunç geçmişi\Nbize yeniden yaşatmaya çalışıyor.
Dialogue: 0,0:13:37.28,0:13:45.27,Main,Gancho,0,0,0,,Kızım Mancherie ve 500 insanımız \No adamın eline düştü bile.
Dialogue: 0,0:13:46.97,0:13:50.41,Main,Gancho,0,0,0,,Aynı şeylerin yeniden yaşanmasına\Nmüsaade edemeyiz!
Dialogue: 0,0:13:51.77,0:13:52.78,Main,Leo,0,0,0,,Edemeyiz!
Dialogue: 0,0:13:53.14,0:13:54.31,Main,Leo,0,0,0,,Savaşacağız!
Dialogue: 0,0:13:54.68,0:13:59.31,Main,Soldier,0,0,0,,Aynen öyle! \NDressrosa için de, Tontatta için de...
Dialogue: 0,0:13:59.31,0:14:03.52,Main,Soldier,0,0,0,,...Don Quixote ailesinin geri dönmesi\Niyilikten çok kötülük sağlamakta!
Dialogue: 0,0:14:08.49,0:14:10.86,Main,Leo,0,0,0,,Kahramanlarla birlikte savaşacağız!
Dialogue: 0,0:14:10.86,0:14:13.10,Main,Inhel,0,0,0,,Usoland da yanımızdayken\Nçok daha güçlüyüz hem!
Dialogue: 0,0:14:13.10,0:14:21.50,Main,Dwarves,0,0,0,,{\i1}Usoland! Usoland! Usoland!{\i0}
Dialogue: 0,0:14:21.50,0:14:23.54,Main,Usopp,0,0,0,,Ben de öyle düşünüyordum zaten!
Dialogue: 0,0:14:23.54,0:14:24.98,Main,Leo,0,0,0,,Kahramanımız bizim!
Dialogue: 0,0:14:27.17,0:14:29.47,Main,Franky,0,0,0,,Kral Riku çok iyi biriymiş!
Dialogue: 0,0:14:29.47,0:14:33.18,Main,Franky,0,0,0,,Sizin gibi böceğe benzeyen insanlara bile\Nçok kibar davranmış!
Dialogue: 0,0:14:33.18,0:14:35.71,Main,Dwarves,0,0,0,,{\i1}Kime böcek diyorsun sen be?!{\i0}
Dialogue: 0,0:14:35.71,0:14:37.46,Main,Franky,0,0,0,,Kötü niyetle söylemedim!
Dialogue: 0,0:14:37.46,0:14:39.32,Main,Dwarves,0,0,0,,{\i1}O zaman bir sorun yok!{\i0}
Dialogue: 0,0:14:39.71,0:14:40.86,Main,Robin,0,0,0,,Komutan-san...
Dialogue: 0,0:14:41.92,0:14:47.47,Main,Robin,0,0,0,,Şu anda Kolezyum'da savaşan\Nkadın gladyatöre Kral Riku'nun torunu deyip...
Dialogue: 0,0:14:47.47,0:14:49.73,Main,Robin,0,0,0,,...onu kötü bir şekilde aşağılıyorlar.
Dialogue: 0,0:14:45.98,0:14:47.96,Secondary,Audience,0,0,0,,{\i1}Geber Rebecca!
Dialogue: 0,0:14:47.96,0:14:49.73,Secondary,Audience,0,0,0,,{\i1}Sen Dressrosa'nın ayıbısın!
Dialogue: 0,0:14:49.73,0:14:53.15,Main,Robin,0,0,0,,Ülkenin insanları\NKral Riku'dan nefret ediyor gibiler.
Dialogue: 0,0:14:53.15,0:14:55.42,Main,Usopp,0,0,0,,Ben de öyle düşünmüştüm!
Dialogue: 0,0:14:55.42,0:14:57.43,Main,Dwarves,0,0,0,,{\i1}Evet!{\i0}
Dialogue: 0,0:14:57.43,0:14:59.08,Main,Dwarves,0,0,0,,{\i1}Usoland! Usoland! Usoland!{\i0}
Dialogue: 0,0:14:59.08,0:15:00.95,Main,Soldier,0,0,0,,10 yıl önce o gün...
Dialogue: 0,0:14:59.08,0:15:00.95,Secondary,Dwarves,0,0,0,,{\i1}Usoland!{\i0}
Dialogue: 0,0:15:00.95,0:15:07.57,Main,Soldier,0,0,0,,...Kral Riku'nun bir gecede tüm insanlarının\Ngüvenini yitirmesine neden olan bir olay gerçekleşti.
Dialogue: 0,0:15:08.71,0:15:13.36,Main,Soldier,0,0,0,,Kral son ana değin\Nülkeyi korumaya çalışıyordu fakat...
Dialogue: 0,0:15:15.06,0:15:19.06,Main,Soldier,0,0,0,,Halk o gün\Ngerçekte yaşananlardan bihaber.
Dialogue: 0,0:15:22.88,0:15:28.29,Flashbacks,Soldier,0,0,0,,Bağışla! \NAnneni koruyamadım!
Dialogue: 0,0:15:29.04,0:15:34.66,Main,Soldier,0,0,0,,Doflamingo Riku Ailesinin\Ntüm üyelerini öldürmeye çalışmıştı fakat...
Dialogue: 0,0:15:34.66,0:15:42.00,Main,Soldier,0,0,0,,...ben Kral Riku'nun kanını taşıyan Rebecca'yı da yanıma alarak uzun süreler boyunca kaçtım.
Dialogue: 0,0:15:44.15,0:15:46.56,Main,Soldier,0,0,0,,Fakat Rebecca nihayetinde yakalanıp...
Dialogue: 0,0:15:47.05,0:15:50.83,Main,Soldier,0,0,0,,...Kolezyum'da halkın önünde\Nsergilenmeye başlandı.
Dialogue: 0,0:15:52.12,0:15:55.86,Main,Soldier,0,0,0,,İnsanların yeniden Kral Riku'ya güvenmesini sağlayıp Rebecca'nın hayatını kurtarabilirsem...
Dialogue: 0,0:15:55.88,0:15:59.97,Main,Soldier,0,0,0,,...kendi canımı seve seve vermeye razı olurum!
Dialogue: 0,0:16:00.52,0:16:04.42,Main,Soldier,0,0,0,,Bu savaşa her şeyimi vermeye hazırım!
Dialogue: 0,0:16:10.19,0:16:12.15,Main,Usopp,0,0,0,,Kimsin sen?!
Dialogue: 0,0:16:13.09,0:16:18.72,Main,Soldier,0,0,0,,Rebecca'nın annesini koruyamadım.
Dialogue: 0,0:16:23.16,0:16:27.30,Main,Soldier,0,0,0,,O gün olanları asla unutamam.
Dialogue: 0,0:16:29.47,0:16:34.02,Main,Soldier,0,0,0,,Oyuncağa dönüştüğüm için\No beni hatırlamıyor fakat...
Dialogue: 0,0:16:57.85,0:16:59.43,Main,Soldier,0,0,0,,...ben...
Dialogue: 0,0:17:06.95,0:17:11.37,Main,,0,0,0,,...Rebecca'nın babasıyım!
Dialogue: 0,0:17:14.75,0:17:16.61,Main,Warrior,0,0,0,,{\i1}Fırsat bu fırsat!{\i0}
Dialogue: 0,0:17:20.67,0:17:24.84,Main,Announcer,0,0,0,,Amanın, Rebecca rakibini savunmasız\Nyakalayınca koşmaya başladı!
Dialogue: 0,0:17:30.26,0:17:32.83,Main,Announcer,0,0,0,,Rebecca bir fare gibi kaçıyor!
Dialogue: 0,0:17:35.53,0:17:42.56,Main,Announcer,0,0,0,,Peşinde de diğer yarışmacıları\Neze eze gelen Rolling Logan var!
Dialogue: 0,0:17:42.56,0:17:44.98,Main,Audience,0,0,0,,Çok rezilsin Rebacca, savaşsana!
Dialogue: 0,0:17:44.98,0:17:46.84,Main,Audience,0,0,0,,Savaşın, kan gösterin bize!
Dialogue: 0,0:18:02.48,0:18:04.24,Main,Audience,0,0,0,,Riku ailesinin tohumu!
Dialogue: 0,0:18:04.24,0:18:06.63,Main,Audience,0,0,0,,Şeytan ailenin tohumu!
Dialogue: 0,0:18:07.73,0:18:11.61,Main,Usopp,0,0,0,,Babası sensen...
Dialogue: 0,0:18:11.61,0:18:13.17,Main,Usopp,0,0,0,,Eğer doğruyu söylüyorsan...
Dialogue: 0,0:18:13.62,0:18:15.97,Main,Usopp,0,0,0,,...ve o da Kral Riku'nun torunuysa...
Dialogue: 0,0:18:15.97,0:18:20.82,Main,Usopp,0,0,0,,Yoksa sen insanken...
Dialogue: 0,0:18:20.82,0:18:23.66,Main,Thunder Soldier,0,0,0,,Her şey o gece başladı.
Dialogue: 0,0:18:23.66,0:18:25.62,Main,Usopp,0,0,0,,Soruma cevap versene be!
Dialogue: 0,0:18:25.62,0:18:27.25,Main,Usopp,0,0,0,,Sen Kral Riku'nun...
Dialogue: 0,0:18:27.25,0:18:31.99,Main,Thunder Soldier,0,0,0,,Aslında belki de\Nçok daha önce başlamıştır.
Dialogue: 0,0:18:31.99,0:18:36.33,Main,Thunder Soldier,0,0,0,,Monet denen o kadının sarayda çalışmaya\Nbaşladığı günden itibaren...
Dialogue: 0,0:18:36.70,0:18:37.70,Main,Robin,0,0,0,,Monet mi?!
Dialogue: 0,0:18:40.95,0:18:43.47,Main,Usopp,0,0,0,,Punk Hazard'da karşılaştığımız\Nşu kuş kadından mı bahsediyor?
Dialogue: 0,0:18:43.47,0:18:48.05,Main,Thunder Soldier,0,0,0,,Geçtiğimiz on yılda bu ülke çok değişti.
Dialogue: 0,0:18:48.05,0:18:50.56,Main,Thunder Soldier,0,0,0,,{\fad(0,500)}Ülkenin görünüşü de, insanları da...
Dialogue: 0,0:18:50.40,0:18:52.51,Captions,,0,0,180,,{\fad(500,0)}Dressrosa - 10 Yıl Önce
Dialogue: 0,0:18:51.01,0:18:52.51,Main,Citizen,0,0,4,,Ne oldu?
Dialogue: 0,0:18:53.12,0:18:55.14,Main,Citizen,0,0,0,,Korsanların işi.
Dialogue: 0,0:18:55.14,0:18:58.55,Main,Citizen,0,0,0,,Ama Kral Riku Ordusu bizi savunduğundan\Nböyle küçük bir hasarla atlatabildik.
Dialogue: 0,0:19:03.79,0:19:07.37,Main,Citizen,0,0,0,,İki haftadır\Nbir damla yağmur yağmadı.
Dialogue: 0,0:19:07.37,0:19:11.26,Main,Citizen,0,0,0,,Öyle fakat bu kuraklığa rağmen\Nçiçekler solmadı.
Dialogue: 0,0:19:11.26,0:19:12.23,Main,Child,0,0,0,,Neden ki?
Dialogue: 0,0:19:12.55,0:19:14.59,Main,Citizen,0,0,0,,Periler sayesinde.
Dialogue: 0,0:19:14.59,0:19:17.77,Main,Citizen,0,0,0,,Periler çiçekleri korurlar.
Dialogue: 0,0:19:17.77,0:19:20.22,Main,Child,0,0,0,,Biraz daha yemek istiyorum!
Dialogue: 0,0:19:20.22,0:19:23.44,Main,Citizen,0,0,0,,Bu kadar bağırmaya gücün varsa\Nyeteri kadar yemişsindir zaten.
Dialogue: 0,0:19:23.44,0:19:28.68,Main,Citizen,0,0,0,,Böyle fakir de olsak\Nen azından ülkemiz savaşlarla boğuşmuyor.
Dialogue: 0,0:19:28.68,0:19:31.88,Main,Citizen,0,0,0,,Asıl önemli olan da bu değil mi?
Dialogue: 0,0:19:32.89,0:19:33.93,Main,Child,0,0,0,,Evet!
Dialogue: 0,0:19:35.42,0:19:38.53,Main,Thunder Soldier,0,0,0,,Riku Ailesi'nin idaresinde olduğu\N800 yıl boyunca...
Dialogue: 0,0:19:38.53,0:19:41.19,Main,Thunder Soldier,0,0,0,,...bu ülke bir kez olsun savaşmamıştır.
Dialogue: 0,0:19:41.19,0:19:43.46,Main,Robin,0,0,0,,Mükemmel bir şey bu.
Dialogue: 0,0:19:43.46,0:19:46.33,Main,Thunder Soldier,0,0,0,,Evet.\NBir ülke için mucizevi bir durum.
Dialogue: 0,0:19:46.33,0:19:49.85,Main,Thunder Soldier,0,0,0,,Dressrosa oldukça barışçıl bir ülkeydi...
Dialogue: 0,0:19:49.85,0:19:50.55,Main,Thunder Soldier,0,0,0,,...fakat...
Dialogue: 0,0:19:51.20,0:19:55.84,Main,Thunder Soldier,0,0,0,,Kabus sarayın üzerine\Nhiç beklenmedik bir anda, birden çöküverdi!
Dialogue: 0,0:19:57.08,0:19:58.14,Main,Riku,0,0,0,,Sen de kimsin?!
Dialogue: 0,0:20:00.08,0:20:03.28,Main,Doflamingo,0,0,0,,Bağırmaya, yardım çağırmaya çalışma.
Dialogue: 0,0:20:04.17,0:20:05.65,Main,Riku,0,0,0,,Sen...
Dialogue: 0,0:20:07.34,0:20:10.49,Main,Doflamingo,0,0,0,,Adım Don Quixote Doflamingo.
Dialogue: 0,0:20:11.52,0:20:16.26,Main,Riku,0,0,0,,Son günlerde Don Quixote isimli\Nbir korsan beni epey huzursuz etmekteydi.
Dialogue: 0,0:20:16.26,0:20:20.43,Main,Doflamingo,0,0,0,,Haklısın,\No huzursuzluk boşa değil.
Dialogue: 0,0:20:20.43,0:20:27.07,Main,Doflamingo,0,0,0,,Bir zamanlar bu ülkeyi yönetmiş\NDon Quixote Ailesi'nin varisiyim.
Dialogue: 0,0:20:29.11,0:20:35.65,Main,Doflamingo,0,0,0,,Bu ülkenin gerçek kralı benim!\NVe o kral geri döndü!
Dialogue: 0,0:20:36.78,0:20:43.39,Main,Riku,0,0,0,,Fakat senin pek çok ülkeden Tenryuubito'lara gönderilen Kutsal Haraç'ı taşıyan gemiyi soyduğunu...
Dialogue: 0,0:20:43.39,0:20:47.36,Main,Riku,0,0,0,,...ve Dünya Hükümeti'ne şantaj yaparak\NShichibukai olduğunu duymuştum.
Dialogue: 0,0:20:49.99,0:20:53.36,Main,Doflamingo,0,0,0,,Varlığım onlar için büyük sorun.
Dialogue: 0,0:20:53.36,0:20:57.87,Main,Doflamingo,0,0,0,,Tenryuubito'lardan korkmadığımdan\Nbenimle ne yapacaklarını bilmiyorlar.
Dialogue: 0,0:20:57.87,0:21:02.67,Main,Doflamingo,0,0,0,,Konumumu ve neler yapabileceğimi bildiğinden\Nlafı kısa keseceğim.
Dialogue: 0,0:21:03.37,0:21:07.68,Main,Doflamingo,0,0,0,,Ülkeyi sana 10 milyar beliye satacağım.
Dialogue: 0,0:21:07.68,0:21:10.41,Main,Riku,0,0,0,,Ülkeyi para karşılığı satacak mısın?!
Dialogue: 0,0:21:10.41,0:21:16.25,Main,Doflamingo,0,0,0,,Normalde sana böyle bir fırsat bile sunmadan\Nülkeyi elinden alabilirim.
Dialogue: 0,0:21:17.25,0:21:21.79,Main,Riku,0,0,0,,Eğer para savaşın önünü kesmeye yetecekse\Nbenim için de ala.
Dialogue: 0,0:21:21.79,0:21:25.33,Main,Riku,0,0,0,,Fakat 10 milyar beli çok fazla!\NBu kadar paramız...
Dialogue: 0,0:21:25.33,0:21:27.06,Main,Doflamingo,0,0,0,,Var!
Dialogue: 0,0:21:27.06,0:21:30.37,Main,Doflamingo,0,0,0,,Pek değer verdiğin halkından topla.
Dialogue: 0,0:21:30.37,0:21:35.08,Main,Doflamingo,0,0,0,,Başka ülkelerden yardım isteyemezsin.\NKral olarak değerini kanıtla bana.
Dialogue: 0,0:21:35.08,0:21:39.21,Main,Doflamingo,0,0,0,,Ayrıca halkına benden bahsedemezsin.
Dialogue: 0,0:21:39.21,0:21:41.72,Main,Doflamingo,0,0,0,,İki seçeneğin var.
Dialogue: 0,0:21:41.72,0:21:45.12,Main,Doflamingo,0,0,0,,Ya savaşı engellemek için parayı toplarsın...
Dialogue: 0,0:21:45.12,0:21:48.89,Main,Doflamingo,0,0,0,,...ya da benimle savaşır, halkını\Nkendi kanı içinde boğulurken izlersin.
Dialogue: 0,0:21:49.51,0:21:52.20,Main,Doflamingo,0,0,0,,İstediğini seçmekte özgürsün.
Dialogue: 0,0:21:57.19,0:22:00.56,Main,Tank,0,0,0,,Bu Doflamingo'yla savaşamaz mıyız, Kralım?!
Dialogue: 0,0:22:00.56,0:22:01.99,Main,Riku,0,0,0,,Olmaz!
Dialogue: 0,0:22:01.99,0:22:07.40,Main,Riku,0,0,0,,Savaş işin kolayı olabilir\Nama insanlar birbirlerine kıymamalılar!
Dialogue: 0,0:22:07.40,0:22:15.16,Main,Tank,0,0,0,,Fakat parayı toplamaya çalışsak bile\Nbu ülkede o kadar zengin insan yok!
Dialogue: 0,0:22:17.46,0:22:23.49,Main,Riku,0,0,0,,Dressrosa'nın 800 yıl boyunca savaşmamış olması canavar olmadığımızın kanıtıdır!
Dialogue: 0,0:22:23.49,0:22:26.16,Main,Riku,0,0,0,,Vahşileşmeyin! İnsan olun!
Dialogue: 0,0:22:26.16,0:22:29.19,Main,Riku,0,0,0,,Kimseyi öldürmenize müsaade etmem!
Dialogue: 0,0:22:29.19,0:22:30.73,Main,Riku,0,0,0,,Beni dinleyin, fazla zamanımız yok!
Dialogue: 0,0:22:30.73,0:22:33.13,Main,Riku,0,0,0,,Ayrılıp tüm şehirleri dolaşın!
Dialogue: 0,0:22:33.13,0:22:35.93,Main,Riku,0,0,0,,10 milyar beliyi\Ntüm ülkeden toplayacağız.
Dialogue: 0,0:22:35.93,0:22:40.44,Main,Riku,0,0,0,,Başaramazsak bu ülke\Nkorsanların eline geçecek.
Dialogue: 0,0:22:40.44,0:22:45.75,Main,Riku,0,0,0,,Paralarını aldığımız vakit insanların\Nbize olan güveni de sarsılacaktır...
Dialogue: 0,0:22:45.75,0:22:47.68,Main,Riku,0,0,0,,...fakat bunun kısa sürmesini umuyorum!
Dialogue: 0,0:22:48.20,0:22:51.75,Main,Riku,0,0,0,,Bu laneti başımızdan savar savmaz\Nkendimizi onlara affettireceğiz!
Dialogue: 0,0:22:51.75,0:22:55.35,Main,Riku,0,0,0,,Tek seçeneğimiz bu! Her şey geçtiğinde\Nonlara gerçeği anlatacağız!
Dialogue: 0,0:22:55.35,0:22:58.14,Main,Riku,0,0,0,,Mevcut zaman zarfında toplayabildiğiniz kadar para toplayın!
Dialogue: 0,0:22:58.16,0:23:00.43,Main,Riku,0,0,0,,Ülkenin hayatı söz konusu!
Dialogue: 0,0:23:07.52,0:23:08.61,Main,Citizen,0,0,0,,Ordu geliyor.
Dialogue: 0,0:23:08.61,0:23:10.07,Main,Citizen,0,0,0,,Bu saatte pek görülmedik bir şey.
Dialogue: 0,0:23:10.07,0:23:11.77,Main,Citizen,0,0,0,,Yüzbaşı Tank bu!
Dialogue: 0,0:23:14.67,0:23:17.03,Main,Tank,0,0,0,,Beni dinleyin!
Dialogue: 0,0:23:17.03,0:23:20.68,Main,Tank,0,0,0,,Şehirdeki tüm parayı buraya getirin!
Dialogue: 0,0:23:20.68,0:23:22.51,Main,Citizen,0,0,0,,Ne oluyor yahu?
Dialogue: 0,0:23:22.51,0:23:25.52,Main,Citizen,0,0,0,,Kralımız bunu duyarsa gazabından korkun!
Dialogue: 0,0:23:25.91,0:23:27.72,Main,Tank,0,0,0,,Bu kralımızın emridir!
Dialogue: 0,0:23:28.91,0:23:32.82,Main,Tank,0,0,0,,Acele edin!\NAçıklama yapacak vakit yok!
Dialogue: 0,0:23:32.82,0:23:37.90,Main,Tank,0,0,0,,Kral Riku-sama'ya güvenin!\NTüm paranızı buraya getirin!
Dialogue: 0,0:23:39.06,0:23:41.10,Main,Citizen,0,0,0,,Birden bu da nereden çıktı?
Dialogue: 0,0:23:41.63,0:23:45.10,Thoughts,Tank,0,0,0,,{\i1}İmkansız!\NKimse böyle bir isteğe boyun eğmez!{\i0}
Dialogue: 0,0:23:47.13,0:23:48.51,Main,Citizen,0,0,0,,Görüntülü Denden Mushi mi?
Dialogue: 0,0:23:49.00,0:23:50.61,Main,Riku,0,0,0,,{\i1}Dressrosa ulusu!{\i0}
Dialogue: 0,0:23:50.61,0:23:51.71,Main,Citizen,0,0,0,,Kral Riku-sama!
Dialogue: 0,0:23:51.71,0:23:53.04,Main,Citizen,0,0,0,,Kral Riku-sama bu!
Dialogue: 0,0:23:53.04,0:23:58.52,Main,Riku,0,0,0,,{\i1}İvedi ve oldukça mantıksız bir istek\Ngibi göründüğünün farkındayım.{\i0}
Dialogue: 0,0:23:59.14,0:24:05.25,Main,Riku,0,0,0,,{\i1}Fakat nedenini sormaksızın sahip olduğunuz\Ntüm parayı ödünç vermenizi...{\i0}
Dialogue: 0,0:24:05.25,0:24:07.83,Main,Riku,0,0,0,,{\i1}...sizlerden rica ediyorum!{\i0}
Dialogue: 0,0:24:09.42,0:24:10.99,Main,Citizen,0,0,0,,Kral başını eğiyor!
Dialogue: 0,0:24:10.99,0:24:12.43,Main,Tank,0,0,0,,Kral Riku-sama!
Dialogue: 0,0:24:12.86,0:24:15.35,Main,Citizen,0,0,0,,Neden yapıyor ki bunu?
Dialogue: 0,0:24:15.35,0:24:16.73,Main,Citizen,0,0,0,,Çok ani oldu!
Dialogue: 0,0:24:18.57,0:24:21.07,Main,Vassal,0,0,0,,Kralım ne yapıyorsunuz, kaldırın kafanızı!
Dialogue: 0,0:24:21.07,0:24:24.24,Main,Vassal,0,0,0,,Bunu yapamazsınız! \NKralsınız siz!
Dialogue: 0,0:24:24.24,0:24:25.65,Main,Vassal,0,0,0,,Yapmayın lütfen!
Dialogue: 0,0:24:25.65,0:24:27.53,Main,Vassal,0,0,0,,Kaldırın kafanızı!
Dialogue: 0,0:24:27.90,0:24:32.82,Main,Vassal,0,0,0,,{\i1}Gelecek krallar bu yaptığınızdan\Nbüyük utanç duyacaklar!{\i0}
Dialogue: 0,0:24:32.82,0:24:34.96,Main,Vassal,0,0,0,,{\i1}Kendinizi tüm dünyaya rezil ediyorsunuz!
Dialogue: 0,0:24:34.96,0:24:36.09,Main,Vassal,0,0,0,,{\i1}Derhal son verin şuna!
Dialogue: 0,0:24:36.67,0:24:40.97,Main,Riku,0,0,0,,Rica ediyorum!\NYaşananlar şaka değil!
Dialogue: 0,0:24:40.97,0:24:47.26,Main,Riku,0,0,0,,Kanıtlamak için\Nkolumu bacağımı bile kesebilirim!
Dialogue: 0,0:24:50.43,0:24:51.82,Flashbacks,Riku,0,0,0,,{\i1}Dinle Tank...{\i0}
Dialogue: 0,0:24:52.33,0:24:57.27,Flashbacks,Riku,0,0,0,,...işler istediğimiz gibi gitmezse\NDoflamingo'yu öldürmek zorunda kalabilirim.
Dialogue: 0,0:24:57.27,0:25:00.06,Flashbacks,Tank,0,0,0,,Kral Riku-sama, o...
Dialogue: 0,0:25:02.28,0:25:04.84,Flashbacks,Riku,0,0,0,,Gerisi sana emanet.
Dialogue: 0,0:25:08.05,0:25:11.22,Thoughts,Tank,0,0,0,,{\i1}Toplayabildiğim kadar para toplayacağım!{\i0}
Dialogue: 0,0:25:11.84,0:25:16.40,Main,Citizen,0,0,0,,Acele edin! Kral'ın istediği gibi\Nneyimiz var neyimiz yok dökelim ortaya!
Dialogue: 0,0:25:16.40,0:25:21.51,Main,Citizen,0,0,0,,Evet! Kral Riku gibi iyi kalpli birinin\Naklında kötü bir düşünce olamaz!
Dialogue: 0,0:25:21.51,0:25:23.53,Main,Citizen,0,0,0,,Aynen öyle! Eminim bunun\Nçok mantıklı bir nedeni vardır!
Dialogue: 0,0:25:23.53,0:25:25.82,Main,Citizen,0,0,0,,Tüm paranızı getirin!
Dialogue: 0,0:25:25.82,0:25:28.15,Main,Citizen,0,0,0,,{\i1}Tamamdır!{\i0}
Dialogue: 0,0:25:50.43,0:25:53.92,Main,Tank,0,0,0,,Bunu kralın erdemi mümkün kıldı!
Dialogue: 0,0:25:56.08,0:25:57.20,Main,Child,0,0,0,,Alın!
Dialogue: 0,0:25:57.53,0:25:58.60,Main,Soldier,0,0,0,,Teşekkür ederim!
Dialogue: 0,0:26:01.47,0:26:02.94,Thoughts,Tank,0,0,0,,Bağışlayın!
Dialogue: 0,0:26:02.94,0:26:07.61,Thoughts,Tank,0,0,0,,{\i1}Ve bunu 800 yıllık Riku Ailesi\Nyönetimine olan güvenden yapıyorlar.{\i0}
Dialogue: 0,0:26:07.61,0:26:10.25,Thoughts,Tank,0,0,0,,{\i1}Ne harika bir ülke bu!
Dialogue: 0,0:26:10.25,0:26:11.85,Thoughts,Tank,0,0,0,,{\i1}Kurtulacağına şüphe yok!
Dialogue: 0,0:26:12.68,0:26:14.38,Main,Tank,0,0,0,,Teşekkür ederim!
Dialogue: 0,0:26:15.52,0:26:18.09,Main,Tank,0,0,0,,Tüm parayı saraya taşıyın!
Dialogue: 0,0:26:18.09,0:26:19.58,Main,Tank,0,0,0,,Acele edin!
Dialogue: 0,0:26:19.58,0:26:20.99,Main,Soldier,0,0,0,,Yüzbaşı Tank!
Dialogue: 0,0:26:20.99,0:26:23.47,Main,Soldier,0,0,0,,Kralımız Sevio şehrinde!
Dialogue: 0,0:26:23.47,0:26:24.70,Main,Soldier,0,0,0,,Ekranda!
Dialogue: 0,0:26:24.70,0:26:26.37,Main,Tank,0,0,0,,Ne?!
Dialogue: 0,0:26:27.04,0:26:29.78,Captions,,0,0,180,,{\fad(500,400)}Güney Kasabası Sevio
Dialogue: 0,0:26:29.91,0:26:34.51,Main,Soldier,0,0,0,,Kralım, buraya kadar gelmenize\Ngerek yoktu. Biz...
Dialogue: 0,0:26:34.51,0:26:35.68,Main,Riku,0,0,0,,Kaçın!
Dialogue: 0,0:26:36.66,0:26:41.81,Main,Citizen,0,0,0,,Kral Riku-sama, neden bilmiyoruz\Nama size güveniyoruz...
Dialogue: 0,0:26:42.20,0:26:43.40,Main,Riku,0,0,0,,Kaçın!
Dialogue: 0,0:26:45.60,0:26:47.37,Main,Soldier,0,0,0,,Kral Riku-sama, ne yapıyorsunuz?!
Dialogue: 0,0:27:02.17,0:27:03.45,Main,Soldier,0,0,0,,Kral Riku-sama!
Dialogue: 0,0:27:10.81,0:27:13.14,Main,Tank,0,0,0,,Kral Riku-sama?
Dialogue: 0,0:27:17.88,0:27:20.75,Main,Riku,0,0,0,,Yapma!\NDurdur şunu lütfen!
Dialogue: 0,0:27:20.75,0:27:22.86,Main,Soldier,0,0,0,,Kral Riku-sama, durun lütfen!
Dialogue: 0,0:27:22.86,0:27:24.12,Main,Soldier,0,0,0,,Ne yapıyorsunuz?!
Dialogue: 0,0:27:24.12,0:27:26.45,Main,Riku,0,0,0,,Uzak durun!\NYaklaşmayın yanıma!
Dialogue: 0,0:27:26.45,0:27:28.66,Main,Riku,0,0,0,,Kaçın!
Dialogue: 0,0:27:30.98,0:27:32.45,Main,Citizen,0,0,0,,Askerleri de kesti...
Dialogue: 0,0:27:34.13,0:27:38.07,Main,Riku,0,0,0,,Bedenime söz geçiremiyorum!
Dialogue: 0,0:27:39.67,0:27:42.28,Main,Tank,0,0,0,,Ne yapıyorsunuz?
Dialogue: 0,0:27:42.28,0:27:43.97,Main,Tank,0,0,0,,Kral Riku-sama?!
Dialogue: 0,0:27:48.82,0:27:51.42,Main,Doflamingo,0,0,0,,Cidden yani...
Dialogue: 0,0:27:51.42,0:27:53.85,Main,Doflamingo,0,0,0,,Ne korkunç bir kral!
Dialogue: 0,0:27:53.85,0:27:56.79,Main,Doflamingo,0,0,0,,Gece daha yeni başlıyor.
Dialogue: 0,0:27:56.79,0:28:00.33,Main,Doflamingo,0,0,0,,Askerler! Siz de dansa katılın!
Dialogue: 0,0:28:03.47,0:28:04.99,Main,Doflamingo,0,0,0,,{\fad(150,150)}Parazit!
Dialogue: 0,0:28:07.78,0:28:10.18,Main,Citizen,0,0,0,,Ne oluyor?! Kolum kendi kendine\Nhareket etmeye başladı!
Dialogue: 0,0:28:11.00,0:28:12.25,Main,Citizen,0,0,0,,Yardım edin...
Dialogue: 0,0:28:13.73,0:28:15.44,Main,Citizen,0,0,0,,Yü-Yüzbaşı!
Dialogue: 0,0:28:15.44,0:28:17.74,Main,Citizen,0,0,0,,Kral Riku-sama, neden yapıyorsunuz bunu?!
Dialogue: 0,0:28:17.74,0:28:20.18,Main,Citizen,0,0,0,,Şu ana dek hiçbir yanlışınızı görmedik!
Dialogue: 0,0:28:22.28,0:28:24.31,Main,Citizen,0,0,0,,Biz mi yanlış bir şey yaptık yoksa?!
Dialogue: 0,0:28:24.93,0:28:28.23,Thoughts,Riku,0,0,0,,{\i1}Artık hiçbir şekilde kendimi aklayamam!{\i0}
Dialogue: 0,0:28:28.23,0:28:31.34,Thoughts,Riku,0,0,0,,{\i1}Ülkenin işi bitti!{\i0}
Dialogue: 0,0:28:31.77,0:28:35.34,Thoughts,Riku,0,0,0,,{\i1}Doflamingo'nun oyununa geldik!{\i0}
Dialogue: 0,0:28:35.34,0:28:38.31,Main,Citizen,0,0,0,,Krala ne olmuş?!
Dialogue: 0,0:28:38.31,0:28:39.80,Main,Citizen,0,0,0,,Yapmayın lütfen!
Dialogue: 0,0:28:40.31,0:28:44.37,Main,Trebol,0,0,0,,Artık başlayalım mı, Doffy?
Dialogue: 0,0:28:44.98,0:28:47.95,Main,Doflamingo,0,0,0,,Aptal şey, acele etme.
Dialogue: 0,0:28:49.56,0:28:53.76,Main,Doflamingo,0,0,0,,İnsanları biraz daha korkutup...
Dialogue: 0,0:28:53.76,0:28:57.08,Main,Doflamingo,0,0,0,,...Kral Riku'dan ölesiye\Nnefret etmelerini sağlayalım önce!
Dialogue: 0,0:28:57.78,0:29:01.48,Main,Doflamingo,0,0,0,,Sonra da kahramanlar ortaya çıkacak!
