1,0,1,2.2,0,7,10,10,10,1Style: OP12 Lyrics,FOT-Greco Std B,39,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,2.6,0,2,10,10,15,1Style: Romaji - OP18 Styleı,Designosaur,45,&H00E9FFFE,&H00E9FFFE,&H00AD0B00,&H00FFE700,0,0,0,0,100,100,1,0,1,1.5,0,8,22,22,12,1Style: Romaji - OP18 Style1_alt,Designosaur,45,&H00E9FFFE,&H00E9FFFE,&H00AD0B00,&H00FFE700,0,0,0,0,100,100,1,0,1,1.5,0,8,22,22,12,1Style: English - OP18,Designosaur,39,&H00FFFFFF,&H00FFFFFF,&H00030303,&H00000000,0,-1,0,0,110,100,1,0,1,2.25,0,2,22,22,18,1Style: Captions,Impress BT,45,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,2,0,2,10,10,10,1Style: Karaokefade,Impress BT,55,&H00FFFFFF,&HFF0000Eı,&H00000000,&HFF000000,0,0,0,0,100,100,0,0,1,1.8,1.5,2,120,120,18,1Style: Author,Impress BT,25,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1,1,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:02.49,0:00:04.79,English - OP18,,0,0,0,,~ Dövüş! ~ ♪ Çarpış ve yüksel yerinden ♪Dialogue: 0,0:00:04.79,0:00:08.00,English - OP18,,0,0,0,,♪ Aşmamız gereken zor günlerimiz bunlar ♪Dialogue: 0,0:00:08.00,0:00:12.84,English - OP18,,0,0,0,,♪ Keza sıradan günler yetmez sususluğumuzu dindirmeye ♪Dialogue: 0,0:00:12.84,0:00:15.09,English - OP18,,0,0,0,,~ İşte başlıyoruz! ~ ♪ Kaçmadan, hep ileriye ♪Dialogue: 0,0:00:15.09,0:00:19.17,English - OP18,,0,0,0,,♪ Ulu rüzgarlarda yaşayalım harabeye dönsek bile ♪Dialogue: 0,0:00:19.17,0:00:21.87,English - OP18,,0,0,0,,♪ Hedefse hâlâ çok uzakta ♪Dialogue: 0,0:00:21.87,0:00:26.69,English - OP18,,0,0,0,,♪ Aşmalı bu zor günleri ♪Dialogue: 0,0:00:28.53,0:00:31.61,English - OP18,,0,0,0,,♪ Yine yapalım, evet, kaç kez daha, bebeğim ♪Dialogue: 0,0:00:31.83,0:00:34.11,English - OP18,,0,0,0,,♪ Hayalimi gerçekleştirmek için doğrulmalı yerimden ♪Dialogue: 0,0:00:34.33,0:00:36.72,English - OP18,,0,0,0,,♪ Çünkü her gün sanki yeniden test ediliyor ♪Dialogue: 0,0:00:36.96,0:00:39.42,English - OP18,,0,0,0,,♪ İrade gücüm ♪Dialogue: 0,0:00:39.42,0:00:40.69,English - OP18,,0,0,0,,~ Haydi gidelim! ~Dialogue: 0,0:00:40.92,0:00:44.46,English - OP18,,0,0,0,,♪ İstemiyorum bahaneler üretip küçük başarılarla yetinmeyi ♪Dialogue: 0,0:00:44.67,0:00:45.96,English - OP18,,0,0,0,,~ Haydi gidelim! ~Dialogue: 0,0:00:46.18,0:00:49.66,English - OP18,,0,0,0,,♪ Vahşi ve kanunsuz içine düştüğüm şu dünyada ♪Dialogue: 0,0:00:49.89,0:00:54.18,English - OP18,,0,0,0,,♪ Gardımı indirmiş rüzgarla esip giderken  gerçeklik çalınıyor yüzüme ♪Dialogue: 0,0:00:54.18,0:00:59.47,English - OP18,,0,0,0,,♪ Acımasızca döv beni, vur bana ve  düşecek olursam da yine ♪Dialogue: 0,0:01:00.36,0:01:04.57,English - OP18,,0,0,0,,♪ Biliyorum yeniden doğrulup ileriye bakabilenler olacak ♪Dialogue: 0,0:01:04.57,0:01:07.82,English - OP18,,0,0,0,,♪ Son gülüp kazananlar ♪Dialogue: 0,0:01:07.82,0:01:10.12,English - OP18,,0,0,0,,~ Koşmalı şeref yolunda oraya varana kadar ~Dialogue: 0,0:01:10.30,0:01:12.54,English - OP18,,0,0,0,,~ Dövüş! ~ ♪ Kurtul kabuslarından, güçlü ol ♪Dialogue: 0,0:01:12.54,0:01:15.72,English - OP18,,0,0,0,,♪ Aşmamız gereken zor günlerimiz bunlar ♪Dialogue: 0,0:01:15.72,0:01:20.80,English - OP18,,0,0,0,,♪ Kolay yol? Yok öyle bir şey ♪Dialogue: 0,0:01:20.80,0:01:23.13,English - OP18,,0,0,0,,~ İşte başlıyoruz! ~ ♪ Hep en iyisi ol ♪Dialogue: 0,0:01:23.13,0:01:27.18,English - OP18,,0,0,0,,♪ Sorumluluklarını düşünmeden ilerle ♪Dialogue: 0,0:01:27.18,0:01:29.81,English - OP18,,0,0,0,,♪ Ve tüm dileklerimizi bir araya getirerek ♪Dialogue: 0,0:01:29.81,0:01:34.99,English - OP18,,0,0,0,,♪ Aşmalı bu zor günleri ♪Dialogue: 0,0:01:42.61,0:01:52.61,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gnsDialogue: 0,0:10:40.50,0:10:50.50,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gnsDialogue: 0,0:21:05.00,0:21:15.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gnsDialogue: 0,0:01:42.61,0:01:46.04,Title,,0,0,240,,Ope Ope MeyvesiDialogue: 0,0:01:46.24,0:01:48.44,Main,,0,0,0,,Alo dedim, dinliyor musun sen beni Sabo-kun?!Dialogue: 0,0:01:48.44,0:01:52.40,Captions,,900,0,650,,Saray Seviyelerinin ÖnüDialogue: 0,0:01:49.44,0:01:50.28,Main,,0,0,0,,Dinliyorum.Dialogue: 0,0:01:50.50,0:01:52.68,Main,,0,0,0,,Yalancı! Hiç de dinlediğin yok!Dialogue: 0,0:01:52.90,0:01:54.90,Main,,0,0,0,,Deminden beri aklım kim bilir nerelerde!Dialogue: 0,0:01:55.40,0:01:58.20,Main,,0,0,0,,Bana bak bana! Pozisyonunun farkında mısın sen?Dialogue: 0,0:01:58.80,0:02:02.28,Main,,0,0,0,,Öyle duygusala bağlayıp da Donanma amiralleriyle falan savaşamazsın!Dialogue: 0,0:02:02.96,0:02:05.32,Main,,0,0,0,,Devrim Ordusu'nu savaşa sürüklemek mi istiyorsun?!Dialogue: 0,0:02:05.88,0:02:07.84,Main,,0,0,0,,Küçük kardeşim tehlikede! Gerisi umrumda değil!Dialogue: 0,0:02:09.68,0:02:10.78,Main,,0,0,0,,Umrunda olmalı ama!Dialogue: 0,0:02:10.94,0:02:11.70,Main,,0,0,0,,Hayır!Dialogue: 0,0:02:11.86,0:02:14.60,Main,,0,0,0,,Senin düşüncesizliğin yüzünden saçma salak bir şeyin içine sürüklenmek istemiyorum!Dialogue: 0,0:02:14.76,0:02:15.50,Main,,0,0,0,,Kes şunu!Dialogue: 0,0:02:15.56,0:02:16.24,Main,,0,0,0,,Ne dedin?!Dialogue: 0,0:02:16.78,0:02:18.04,Main,,0,0,0,,Ayrıca o adam...Dialogue: 0,0:02:19.90,0:02:22.54,Main,,0,0,0,,İt ulur, birbirini bulur misali...Dialogue: 0,0:02:22.86,0:02:28.20,Main,,0,0,0,,Bizim Donanma'nın da, Doflamingo'nun da burada işi yok.Dialogue: 0,0:02:28.64,0:02:33.92,Main,,0,0,0,,Donanma bu ülkede asla kahraman olamaz.Dialogue: 0,0:02:34.28,0:02:36.74,Main,,0,0,0,,Böyle düşündüğünü öğrenirlerse...Dialogue: 0,0:02:36.86,0:02:37.46,Main,,0,0,0,,Bir şey olmaz.Dialogue: 0,0:02:38.04,0:02:41.08,Main,,0,0,0,,Sonuçta şu an beni burada alıkoyuyorsun.Dialogue: 0,0:02:44.40,0:02:45.94,Main,,0,0,0,,Büyük bir kumar bu.Dialogue: 0,0:02:47.70,0:02:49.60,Main,,0,0,0,,Şanslı adamımdır.Dialogue: 0,0:02:52.58,0:02:55.00,Main,,0,0,0,,Tamam mı?! Anladın mı? Duydun di' mi beni?!Dialogue: 0,0:02:56.52,0:02:59.96,Karaokefade,,0,0,0,,Sabo-kun?!Dialogue: 0,0:03:01.86,0:03:05.12,Main,,0,0,0,,Hack'la ikimiz de arkanı toplamak zorunda kalıyoruz sonra!Dialogue: 0,0:03:08.33,0:03:12.45,Captions,,60,0,380,,Eski Kral PlatosuDialogue: 0,0:03:08.40,0:03:12.34,Main,,0,0,660,,Elimizdeki suçluları kullanarak diğer suçluları da buraya çekeceğiz.Dialogue: 0,0:03:14.66,0:03:15.86,Main,,0,0,0,,Özür dilerim!Dialogue: 0,0:03:16.06,0:03:16.78,Main,,0,0,0,,Cidden bak!Dialogue: 0,0:03:16.88,0:03:17.82,Main,,0,0,0,,Yapma!  Kurtarın beni!Dialogue: 0,0:03:19.86,0:03:20.46,Main,,0,0,0,,Ne?Dialogue: 0,0:03:20.94,0:03:22.84,Main,,0,0,0,,Özgürüm!Dialogue: 0,0:03:23.30,0:03:26.66,Main,,0,0,0,,Bizi saldınız ama, emin misiniz?Dialogue: 0,0:03:27.16,0:03:30.16,Main,,0,0,0,,Sizi hiç yakalamamalıydık.Dialogue: 0,0:03:31.18,0:03:34.98,Main,,0,0,0,,Tam on yıldır, Doflamingo tarafından o gece kontrol edilen Kral Riku-sama'ya...Dialogue: 0,0:03:35.04,0:03:36.90,Main,,0,0,0,,...büyük kin güdüyorduk.Dialogue: 0,0:03:37.00,0:03:39.68,Main,,0,0,0,,Kral diye korsanın tekine şükredip,...Dialogue: 0,0:03:40.34,0:03:42.38,Main,,0,0,0,,...gerçeği öğrendikten sonra bile...Dialogue: 0,0:03:43.16,0:03:45.90,Main,,0,0,0,,Gerçeği öğrendikten sonra bile...Dialogue: 0,0:03:47.56,0:03:51.54,Main,,0,0,0,,...onun başlattığı bir oyunda kendimize bir çıkar yolu aramayı sürdürdük!Dialogue: 0,0:03:52.30,0:03:56.20,Main,,0,0,0,,Biz bile neyi neden yaptığımızı bilmiyoruz artık!Dialogue: 0,0:03:56.68,0:04:00.42,Main,,0,0,0,,Bize ne olacak? Bu ülkeye ne olacak? Kral Riku-sama...Dialogue: 0,0:04:01.28,0:04:02.80,Main,,0,0,0,,...kurtar bizi!Dialogue: 0,0:04:05.02,0:04:06.26,Main,,0,0,0,,Ne oluyor?!Dialogue: 0,0:04:06.44,0:04:07.62,Main,,0,0,0,,Hepsine ne oldu böyle?!Dialogue: 0,0:04:07.80,0:04:08.96,Main,,0,0,0,,Bu da nesi?!Dialogue: 0,0:04:11.34,0:04:14.86,Main,,0,0,0,,Kral Riku-sama, ne yapalım söyle bize!?Dialogue: 0,0:04:15.20,0:04:18.18,Main,,0,0,0,,Savaş dersen sarılırız silahlara!Dialogue: 0,0:04:18.36,0:04:19.40,Main,,0,0,0,,Kral Riku-sama!Dialogue: 0,0:04:19.64,0:04:21.42,Main,,0,0,0,,Nereye gidersen git peşindeyiz!Dialogue: 0,0:04:31.62,0:04:34.72,Main,,0,0,0,,Biraz daha bekleyelim öyleyse.Dialogue: 0,0:04:35.00,0:04:36.46,Main,,0,0,0,,Bekleyelim mi?Dialogue: 0,0:04:37.42,0:04:40.78,Main,,0,0,0,,Ölümü gerekirse sonra da seçeriz.Dialogue: 0,0:04:41.08,0:04:47.10,Main,,0,0,0,,Anlaşılan ben de Luffy'kunların kazanacağına ümit bağlamaya başladım.Dialogue: 0,0:04:59.56,0:05:03.24,Main,,0,0,0,,Bir zamanlar barışın simgesi olan Dressrosa'nın...Dialogue: 0,0:05:03.60,0:05:06.82,Main,,0,0,0,,...savaşa karışmasına müsaade etmeyeceğim.Dialogue: 0,0:05:07.14,0:05:10.20,Main,,0,0,0,,B-B-B-Bu neden burada?!Dialogue: 0,0:05:14.98,0:05:16.74,Main,,0,0,0,,Kral Riku beyim.Dialogue: 0,0:05:17.54,0:05:21.82,Main,,0,0,0,,Ben de seninle aynı bahse bel bağlamış durumdayım.Dialogue: 0,0:05:31.06,0:05:32.96,Main,,0,0,0,,Ya "Hasır" gelecek...Dialogue: 0,0:05:34.15,0:05:35.20,Captions,,0,0,305,,Saray SeviyeleriDialogue: 0,0:05:35.21,0:05:36.63,Captions,,0,0,305,,4. SeviyeDialogue: 0,0:05:36.65,0:05:37.87,Captions,,0,0,305,,Kraliyet Sarayının  En Üst KatıDialogue: 0,0:05:40.78,0:05:42.54,Main,,0,0,0,,Hoşuna gitti mi, şerefsiz?!Dialogue: 0,0:05:45.76,0:05:47.88,Main,,0,0,0,,Yaptın yapacağını!Dialogue: 0,0:05:48.08,0:05:50.84,Main,,0,0,0,,Gördün mü?! Hâlâ sapasağlam!Dialogue: 0,0:05:51.22,0:05:53.80,Main,,0,0,0,,Aynı numarayı bir daha yapamayacağız üstelik!Dialogue: 0,0:06:00.16,0:06:01.90,Main,,0,0,0,,Sahte-mingolarla işim yok!Dialogue: 0,0:06:05.36,0:06:09.82,Main,,0,0,0,,Law, gücünü en ince ayrıntısına kadar biliyorum!Dialogue: 0,0:06:10.80,0:06:15.90,Main,,0,0,0,,Ope Ope Meyvesi'nin gücü bir zamanlar arzuladığımız bir güçtü çünkü!Dialogue: 0,0:06:18.74,0:06:22.10,Main,,0,0,0,,Beni kessen bile yine normale dönerim!Dialogue: 0,0:06:22.76,0:06:24.80,Main,,0,0,0,,Şimdi göstereceğim sana!Dialogue: 0,0:06:25.16,0:06:25.72,Main,,0,0,0,,Ne?Dialogue: 0,0:06:28.84,0:06:33.26,Main,,0,0,0,,Işın Kılıcı her zamanki kesişlerimden farklı keser.Dialogue: 0,0:06:33.98,0:06:39.90,Main,,0,0,0,,Birkaç dakika boyunca, ne tür tedavi görürsen gör  ne yeteneğe sahip olursan ol...Dialogue: 0,0:06:40.06,0:06:41.58,Main,,0,0,0,,...bedenin toparlanamaz!Dialogue: 0,0:06:41.74,0:06:43.78,Main,,0,0,0,,Ne?! Başım büyük belada!Dialogue: 0,0:06:45.80,0:06:47.52,Main,,0,0,0,,Burnumun akışına engel olamıyorum!Dialogue: 0,0:06:49.20,0:06:51.78,Main,,0,0,0,,Bekle, bekle, bekle!Dialogue: 0,0:06:52.00,0:06:53.08,Main,,0,0,0,,Lanet olsun!Dialogue: 0,0:06:53.44,0:06:54.52,Main,,0,0,0,,Oda!Dialogue: 0,0:06:56.36,0:06:59.36,Main,,0,0,0,,Dur dedim, seni nankör!Dialogue: 0,0:07:00.16,0:07:01.18,Main,,0,0,0,,Enjeksiyon!Dialogue: 0,0:07:01.66,0:07:02.36,Main,,0,0,0,,Al sana!Dialogue: 0,0:07:02.48,0:07:05.16,Main,,0,0,0,,Sümük Kılıç Yakalayıcısı!Dialogue: 0,0:07:06.62,0:07:07.72,Main,,0,0,0,,Atış!Dialogue: 0,0:07:09.76,0:07:10.86,Main,,0,0,0,,Sonun geldi!Dialogue: 0,0:07:18.72,0:07:20.34,Main,,0,0,0,,Düşen Sicimler!Dialogue: 0,0:07:26.40,0:07:27.34,Main,,0,0,0,,Trao!Dialogue: 0,0:07:27.56,0:07:32.40,Main,,0,0,0,,En çok nefret ettiğim şeyi hatırlıyor musun, Law?Dialogue: 0,0:07:35.88,0:07:38.17,Main,,0,0,0,,Küçük görülmek!Dialogue: 0,0:07:38.60,0:07:39.50,Main,,0,0,0,,Trao!Dialogue: 0,0:08:02.26,0:08:04.08,Main,,0,0,0,,Kaç!Dialogue: 0,0:08:06.22,0:08:08.58,Main,,0,0,0,,Kaç, Hasır Şapka!Dialogue: 0,0:08:08.94,0:08:10.72,Main,,0,0,0,,Kurtar kendini!Dialogue: 0,0:08:10.78,0:08:11.46,Main,,0,0,0,,Bella...Dialogue: 0,0:08:11.46,0:08:13.00,Main,,0,0,0,,Lanet olsun!Dialogue: 0,0:08:14.31,0:08:15.12,Main,,0,0,0,,Hasır Şapka-ya!Dialogue: 0,0:08:20.40,0:08:23.98,Main,,0,0,0,,Beni yenebileceğinizi mi sandın?Dialogue: 0,0:08:25.20,0:08:27.92,Main,,0,0,0,,Sizin gibi dünkü veletlerin kendini bir şey sanıp da...Dialogue: 0,0:08:28.10,0:08:31.86,Main,,0,0,0,,...bir an olsun beni yenebileceğini düşünmesi...Dialogue: 0,0:08:32.34,0:08:34.76,Main,,0,0,0,,...dayanılmaz bir aşağılama benim için.Dialogue: 0,0:08:35.06,0:08:36.32,Main,,0,0,0,,Bana bak.Dialogue: 0,0:08:38.40,0:08:43.46,Main,,0,0,0,,Ben dünyanın en asil soyu olan...Dialogue: 0,0:08:44.92,0:08:46.80,Main,,0,0,0,,...Tenryuubito'dan gelmeyim!Dialogue: 0,0:08:47.30,0:08:47.94,Main,,0,0,0,,Ne?!Dialogue: 0,0:08:50.28,0:08:52.76,Main,,0,0,0,,Doğumumuz bile takdire şayan bir olay.Dialogue: 0,0:08:53.12,0:08:57.68,Main,,0,0,0,,Dünyadaki en nadir güce sahiptim.Dialogue: 0,0:08:58.42,0:08:59.80,Main,,0,0,0,,Fakat...Dialogue: 0,0:09:00.84,0:09:04.54,Main,,0,0,0,,...günün birinde babam, doğuştan sahip olduğumuz...Dialogue: 0,0:09:05.08,0:09:07.80,Main,,0,0,0,,...bu nadir güçten vazgeçince...Dialogue: 0,0:09:07.98,0:09:09.82,Main,,0,0,0,,...ailecek dört kişi...Dialogue: 0,0:09:10.74,0:09:15.32,Main,,0,0,0,,...bu pis dünyaya gelmek zorunda kaldık!Dialogue: 0,0:09:18.12,0:09:22.36,Main,,0,0,0,,Yemişim "insan gibi yaşamayı"!Dialogue: 0,0:09:24.64,0:09:26.66,Main,,0,0,0,,Babam aptalın tekiydi!Dialogue: 0,0:09:28.80,0:09:33.26,Flashbacks,,0,0,0,,Baba! Köleler nerede, ha? Gidip birkaç tane satın alsak mı, ha?Dialogue: 0,0:09:33.88,0:09:37.54,Flashbacks,,0,0,0,,Baba, neden önümüzde diz çökmüyorlar, ha?Dialogue: 0,0:09:38.24,0:09:41.28,Flashbacks,,0,0,0,,Baba! Neden peşimize düştüler, ha?Dialogue: 0,0:09:41.90,0:09:43.82,Flashbacks,,0,0,0,,Tenryuubito ailesi bu!Dialogue: 0,0:09:43.94,0:09:46.78,Flashbacks,,0,0,0,,Öldürmeyin! Hayatlarının sonlarına dek acı çektirin!Dialogue: 0,0:09:47.60,0:09:52.50,Main,,0,0,0,,On yaşıma gelmeden bu hayatta cenneti de cehennemi de görmüş oldum.Dialogue: 0,0:09:52.88,0:09:56.16,Main,,0,0,0,,Sonra da tüm bunların nedeni olan babamı öldürüp...Dialogue: 0,0:09:56.44,0:09:59.66,Main,,0,0,0,,...kafasıyla beraber Marijoa'ya geri döndüm!Dialogue: 0,0:10:01.38,0:10:02.64,Main,,0,0,0,,Ama...Dialogue: 0,0:10:03.10,0:10:10.30,Main,,0,0,0,,...cennetteki Tenryuubito'ların hain bir aileyi  bir daha aralarına almaları mümkün değildi!Dialogue: 0,0:10:11.10,0:10:14.26,Main,,0,0,0,,Benim için bu cehennemden bir kaçış yolu yoktu.Dialogue: 0,0:10:14.94,0:10:17.28,Main,,0,0,0,,İşte o gün yemin ettim.Dialogue: 0,0:10:17.48,0:10:21.34,Main,,0,0,0,,O lanet olasıcaların bu dünyada...Dialogue: 0,0:10:21.76,0:10:25.60,Main,,0,0,0,,...hakim oldukları her bir zerreyi yok edecektim!Dialogue: 0,0:10:26.14,0:10:31.36,Main,,0,0,0,,Yaşadığınız hayatlar, yaşadığım hayat yanında hiç kalır!Dialogue: 0,0:10:33.34,0:10:37.22,Main,,0,0,0,,Dünkü veletlerle oyun oynayacak...Dialogue: 0,0:10:37.68,0:10:39.56,Main,,0,0,0,,...zamanım yok!Dialogue: 0,0:10:40.74,0:10:46.97,Captions,,0,0,170,,Kuzeybatı Şehri - PrimulaDialogue: 0,0:10:47.04,0:10:49.36,Main,,0,0,0,,Yapma!  Sana yalvarıyorum!Dialogue: 0,0:10:49.46,0:10:51.26,Main,,0,0,0,,Lütfen!Dialogue: 0,0:10:52.26,0:10:55.44,Main,,0,0,0,,Bunu yapmayı ben de istemiyorum!Dialogue: 0,0:10:56.06,0:11:00.32,Main,,0,0,0,,Ama vücuduma söz geçiremiyorum!Dialogue: 0,0:11:01.14,0:11:04.08,Main,,0,0,0,,Özür dilerim! Özür dilerim! Bağışlayın beni!Dialogue: 0,0:11:07.66,0:11:10.80,Main,,0,0,0,,Bu kadar ganimetle gemimizi baştan yapabiliriz-yashi!Dialogue: 0,0:11:10.92,0:11:12.20,Main,,0,0,0,,Deshi, deshi!Dialogue: 0,0:11:12.28,0:11:13.78,Main,,0,0,0,,Bekleyin korsan bozuntuları!Dialogue: 0,0:11:13.94,0:11:16.20,Main,,0,0,0,,Ateş arkasına gizlenip ne yaptığınızı sanıyorsunuz?!Dialogue: 0,0:11:16.30,0:11:17.30,Main,,0,0,0,,İzin vermeyiz!Dialogue: 0,0:11:25.96,0:11:27.58,Main,,0,0,0,,Durdurmazsak ölecek!Dialogue: 0,0:11:28.60,0:11:31.28,Main,,0,0,0,,Bayıltıcı mermi kalmadı mı?!Dialogue: 0,0:11:36.02,0:11:40.20,Main,,0,0,0,,Asker sayısı da bayıltıcı mermi sayısı da yetersiz.Dialogue: 0,0:11:40.58,0:11:41.80,Main,,0,0,0,,Ne yapmalı?Dialogue: 0,0:11:43.70,0:11:44.84,Main,,0,0,0,,Bu gidişle...Dialogue: 0,0:11:45.70,0:11:47.08,Main,,0,0,0,,Koramiral Maynard!Dialogue: 0,0:11:47.58,0:11:48.70,Main,,0,0,0,,Ne var?!Dialogue: 0,0:11:49.14,0:11:53.10,Main,,0,0,0,,Devrim Ordusu'ndan Sabo'yla Issho-san'ın Acacia'daki mücadelesi...Dialogue: 0,0:11:53.48,0:11:55.32,Main,,0,0,0,,...yaşanan bir yaralanma yüzünden berabere sonuçlanmış!Dialogue: 0,0:11:55.38,0:11:57.84,Main,,0,0,0,,Ne?! İmkansız bu!Dialogue: 0,0:11:58.30,0:12:02.22,Main,,0,0,0,,Karargâh amiralleri Donanma'nın en güçlü insanlarıdır be!Dialogue: 0,0:12:04.08,0:12:05.70,Flashbacks,,0,0,0,,Neden Issho-san?!Dialogue: 0,0:12:09.60,0:12:11.58,Flashbacks,,0,0,0,,Dünya Hükümeti...Dialogue: 0,0:12:12.66,0:12:14.82,Flashbacks,,0,0,0,,...Tanrı mı?!Dialogue: 0,0:12:15.76,0:12:18.18,Main,,0,0,0,,Bu sözler kafama takılıp kaldı...Dialogue: 0,0:12:18.50,0:12:19.58,Main,,0,0,0,,Emriniz nedir?!Dialogue: 0,0:12:19.84,0:12:22.92,Main,,0,0,0,,Ama şimdi bunları düşünmenin sırası değil!Dialogue: 0,0:12:23.28,0:12:27.08,Main,,0,0,0,,Doflamingo'nın peşindeki korsanlarla sonra ilgileneceğiz!Dialogue: 0,0:12:27.30,0:12:30.84,Main,,0,0,0,,Tek işimiz ülke çapındaki bu karışıklığı kontrol altına almak olacak!Dialogue: 0,0:12:32.02,0:12:34.68,Main,,0,0,0,,Sivil halka yahut hayvanlara zarar vermemeye çalışın!Dialogue: 0,0:12:34.96,0:12:38.60,Main,,0,0,0,,Kontrolden çıkmış olanları bayıltıcı mermilerle uyutun!Dialogue: 0,0:12:45.74,0:12:46.68,Main,,0,0,0,,İyi misiniz?Dialogue: 0,0:12:57.80,0:13:00.08,Captions,,0,30,330,,Kraliyet SarayıDialogue: 0,0:13:01.36,0:13:03.04,Main,,0,0,0,,Durun, durun, durun, durun!Dialogue: 0,0:13:05.96,0:13:07.88,Main,,0,0,0,,Gomu Gomu no...Dialogue: 0,0:13:08.32,0:13:10.80,Main,,0,0,0,,...Ahtapot Zımbası!Dialogue: 0,0:13:16.50,0:13:17.64,Main,,0,0,0,,Gidiciydik!Dialogue: 0,0:13:18.08,0:13:19.00,Main,,0,0,0,,Arkanda!Dialogue: 0,0:13:21.08,0:13:23.72,Main,,0,0,0,,Hiçbir şey bilmiyorsunuz.Dialogue: 0,0:13:26.84,0:13:32.48,Main,,0,0,0,,Düşmüş bir Tenryuubito'ya insanların neler yapacağını aklınız alıyor mu?!Dialogue: 0,0:13:45.74,0:13:48.92,Main,,0,0,0,,İnsanlar...Dialogue: 0,0:13:49.42,0:13:51.08,Main,,0,0,0,,...acımasız.Dialogue: 0,0:13:51.40,0:13:53.74,Main,,0,0,0,,Ne diyorsun sen be, Sahte-mingo!?Dialogue: 0,0:13:59.58,0:14:03.12,Main,,0,0,0,,Pekâlâ öyleyse, idamlara başlayalım diyorum.Dialogue: 0,0:14:03.58,0:14:06.16,Main,,0,0,0,,Önce sen, Law...Dialogue: 0,0:14:10.72,0:14:12.80,Main,,0,0,0,,Anlayamadığım bir nokta var yalnız.Dialogue: 0,0:14:13.96,0:14:17.78,Main,,0,0,0,,Marijoa'dan sürülmüş eski bir Tenryuubito olmana rağmen...Dialogue: 0,0:14:18.04,0:14:19.78,Main,,0,0,0,,...neden hâlâ bir takım güçlere sahipsin!?Dialogue: 0,0:14:21.50,0:14:26.81,Main,,0,0,0,,Bu sabah doğrudan Dünya Hükümeti emrinde çalışan CP-0'ı harekete geçirmeyi başardın!Dialogue: 0,0:14:31.68,0:14:35.96,Main,,0,0,0,,Çok yakında ölecek olmana rağmen bunu merak ediyorsun demek?Dialogue: 0,0:14:36.68,0:14:41.36,Main,,0,0,0,,Sebebi Kutsal Topraklar Marijoa'da sakladıkları...Dialogue: 0,0:14:41.98,0:14:45.88,Main,,0,0,0,,...önemli ulusal hazineyi biliyor olmam!Dialogue: 0,0:14:48.08,0:14:50.22,Main,,0,0,0,,Mariijoa'da saklanan ulusal hazine mi?Dialogue: 0,0:14:50.54,0:14:51.52,Main,,0,0,0,,Evet.Dialogue: 0,0:14:51.74,0:14:55.54,Main,,0,0,0,,Varlığıyla bile dünyayı yerinden sarsmaya yetecek bir şey.Dialogue: 0,0:14:56.38,0:14:59.40,Main,,0,0,0,,Doflamingo'yu öldürün, ey!Dialogue: 0,0:14:59.56,0:15:02.64,Main,,0,0,0,,O çocuğun hayatta kalmasına izin veremeyiz, ey!Dialogue: 0,0:15:04.02,0:15:08.94,Main,,0,0,0,,Onların gözünde elinde çok tehlikeli bir koz bulunduran bir kaçaktım.Dialogue: 0,0:15:09.28,0:15:12.65,Main,,0,0,0,,Öldürmeye çalışmalarına rağmen ölmeyince Tenryuubito'lar...Dialogue: 0,0:15:12.68,0:15:15.68,Main,,0,0,0,,...birden işbirliği konusunda çok istekli oldular.Dialogue: 0,0:15:16.28,0:15:23.60,Main,,0,0,0,,Ayrıca Ope Ope meyvenin gücü  o gün elimde olsaydı...Dialogue: 0,0:15:24.06,0:15:30.28,Main,,0,0,0,,...Mariijoa'daki ulusal hazineyi kullanarak dünyanın kontrolünü elime alabilirdim!Dialogue: 0,0:15:33.38,0:15:37.88,Main,,0,0,0,,Böyle de değerli bir güce sahipsin işte.Dialogue: 0,0:15:38.64,0:15:43.20,Main,,0,0,0,,"Kişilik Aktarım Cerrahlığı" yanısıra başka bir faydası daha var!Dialogue: 0,0:15:43.46,0:15:45.74,Main,,0,0,0,,Biliyor musun?Dialogue: 0,0:15:46.14,0:15:49.48,Main,,0,0,0,,Akıllı biri Ope Ope meyvesini tam anlamıyla kullanmayı başarırsa...Dialogue: 0,0:15:49.51,0:15:53.22,Main,,0,0,0,,...insanların çok eski zamanlardan beri diledikleri şey gerçek olabilir.Dialogue: 0,0:15:53.66,0:15:59.08,Main,,0,0,0,,O yüzden de pek çok kişi bu meyveye Nihai Şeytan Meyvesi diyor.Dialogue: 0,0:16:00.02,0:16:02.44,Main,,0,0,0,,Evet, biliyorum...Dialogue: 0,0:16:02.94,0:16:04.90,Main,,0,0,0,,Ama umrumda değil.Dialogue: 0,0:16:05.28,0:16:11.04,Main,,0,0,0,,Bu meyvenin en büyük gücü başka bir insana sonsuz hayat bahşeden...Dialogue: 0,0:16:12.24,0:16:14.04,Main,,0,0,0,,"Daimi Gençlik Cerrahlığı!"Dialogue: 0,0:16:14.64,0:16:19.64,Main,,0,0,0,,Fakat bu yapıldığında, güç kullanıcısı hayatını yitirir.Dialogue: 0,0:16:21.84,0:16:22.96,Main,,0,0,0,,Aynen öyle!Dialogue: 0,0:16:23.14,0:16:25.66,Main,,0,0,0,,O yüzden de meyveyi sana yedirmeyecektim!Dialogue: 0,0:16:26.08,0:16:28.26,Main,,0,0,0,,İyiliğime nankörlükle karşılık vermeye nasıl cüret edersin?!Dialogue: 0,0:16:28.44,0:16:30.66,Main,,0,0,0,,Kusuruma bakma artık!Dialogue: 0,0:16:33.58,0:16:35.22,Main,,0,0,0,,Diamante'nin kılıç ustalığı!Dialogue: 0,0:16:36.32,0:16:37.44,Main,,0,0,0,,Sicim Mermisi!Dialogue: 0,0:16:42.36,0:16:44.22,Main,,0,0,0,,Lao G'nin taijutsusu!Dialogue: 0,0:16:44.28,0:16:45.16,Main,,0,0,0,,Oda!Dialogue: 0,0:16:45.30,0:16:46.62,Main,,0,0,0,,Enjeksiyon Atışı!Dialogue: 0,0:16:49.24,0:16:51.30,Main,,0,0,0,,Gladius'un silah ustalığı!Dialogue: 0,0:16:52.02,0:16:56.26,Main,,0,0,0,,Tüm savaş yeteneklerini bizden kazandın!Dialogue: 0,0:16:56.58,0:16:57.24,Main,,0,0,0,,Evet!Dialogue: 0,0:16:57.92,0:17:01.10,Main,,0,0,0,,Ve hâlâ burada olmamı da Cora-san'a borçluyum!Dialogue: 0,0:17:03.14,0:17:04.58,Main,,0,0,0,,Sağ olun.Dialogue: 0,0:17:05.12,0:17:08.20,Main,,0,0,0,,Bu güçler sayesinde sizi yenebilirim!Dialogue: 0,0:17:18.03,0:17:26.67,Captions,,0,0,235,,16 yıl önce North Blue'da Bir Liman ŞehriDialogue: 0,0:17:29.10,0:17:30.73,Main,,0,0,3,,Şaka mısın lan sen?Dialogue: 0,0:17:29.10,0:17:31.45,Captions,,0,0,240,,Donquixote Ailesi ♦ Yöneticileri ♣ Diamante ve TrebolDialogue: 0,0:17:30.73,0:17:32.90,Main,,0,0,3,,Gülmeyin! Çok ciddiyim!Dialogue: 0,0:17:35.46,0:17:38.14,Main,,0,0,0,,Gaza gelmen birilerini öldürmende yardımcı olmaz sana!Dialogue: 0,0:17:38.42,0:17:40.74,Main,,0,0,0,,Dedim size, patlayıcılarım var!Dialogue: 0,0:17:41.58,0:17:43.88,Main,,0,0,0,,Korsanları hafife alma!Dialogue: 0,0:17:55.15,0:17:56.53,Secondary,,0,0,3,,Bekle! Bekle! Bekle!Dialogue: 0,0:17:54.90,0:18:01.11,Captions,,0,0,170,,Atık İşleme TesisiDialogue: 0,0:17:56.65,0:17:58.23,Secondary,,0,0,3,,Olmaz-dasuyan!Dialogue: 0,0:17:58.55,0:18:00.24,Main,,0,0,3,,Kaptan nerede?Dialogue: 0,0:17:59.78,0:18:01.06,Secondary,,0,0,660,,Bekle!Dialogue: 0,0:18:01.33,0:18:05.49,Main,,0,0,0,,Kaptanımız Doffy'nin senin gibi bir velet için zamanı yok.Dialogue: 0,0:18:05.67,0:18:07.13,Main,,0,0,0,,Evet, evet!Dialogue: 0,0:18:07.43,0:18:11.39,Main,,0,0,0,,Çok ömrünün olmadığını, yakında öleceğini anladık.Dialogue: 0,0:18:12.91,0:18:16.95,Main,,0,0,0,,Ne zaman peki? Ha, ha? Ne zaman öleceksin?Dialogue: 0,0:18:17.05,0:18:19.11,Main,,0,0,0,,Üç yıl iki ay sonra.Dialogue: 0,0:18:19.21,0:18:21.19,Main,,0,0,0,,Doktor mu dedi bunu?Dialogue: 0,0:18:21.43,0:18:25.47,Main,,0,0,0,,Ölen babam doktordu. Tıbbi kayıtlarıma bakarak ben öğrendim.Dialogue: 0,0:18:27.41,0:18:28.93,Main,,0,0,0,,Ne zeki veletmiş.Dialogue: 0,0:18:29.41,0:18:32.34,Main,,0,0,0,,Bu üç yılda öldürebildiğim kadar öldürüp...Dialogue: 0,0:18:32.77,0:18:34.43,Main,,0,0,0,,...her şeyi yok etmek istiyorum!Dialogue: 0,0:18:36.59,0:18:39.09,Main,,0,0,0,,Kafasında tahta falan mı eksik bunun?Dialogue: 0,0:18:40.17,0:18:41.34,Main,,0,0,0,,Sümüklerimi akıtıyor!Dialogue: 0,0:18:41.69,0:18:44.91,Main,,0,0,0,,Biz çocukları da aramıza kabul ediyoruz.Dialogue: 0,0:18:45.65,0:18:48.93,Main,,0,0,0,,Fakat şimdiye kadar gelen yüz çocuktan...Dialogue: 0,0:18:49.09,0:18:53.43,Main,,0,0,0,,...çoğu daha ikinci gün ağlayarak kaçtı.Dialogue: 0,0:18:55.31,0:18:57.71,Main,,0,0,0,,Ne diyorsun, dayanabilecek misin?Dialogue: 0,0:18:57.87,0:19:00.57,Main,,0,0,0,,Nin! Trebol-sama!Dialogue: 0,0:19:00.67,0:19:02.53,Main,,0,0,0,,Diamante-sama!Dialogue: 0,0:19:03.29,0:19:06.29,Main,,0,0,0,,Gelen çocuklardan bir onlar kaldı.Dialogue: 0,0:19:07.03,0:19:09.37,Main,,0,0,0,,Ne var Buffalo, Baby 5?Dialogue: 0,0:19:09.57,0:19:11.55,Main,,0,0,0,,Cora-san döndü!Dialogue: 0,0:19:20.29,0:19:21.57,Main,,0,0,0,,Düştü!Dialogue: 0,0:19:21.69,0:19:24.03,Main,,0,0,0,,Düşeceğini biliyorduk-dasuyan!Dialogue: 0,0:19:29.13,0:19:30.79,Main,,0,0,0,,Düştün! Düştün!Dialogue: 0,0:19:29.13,0:19:30.79,Main,,0,0,0,,Dasuyan! Dasuyan!Dialogue: 0,0:19:34.51,0:19:36.17,Main,,0,0,0,,Dasuyan...Dialogue: 0,0:19:50.01,0:19:52.31,Main,,0,0,0,,Cora-san, çay getirdim.Dialogue: 0,0:19:53.09,0:19:54.11,Main,,0,0,0,,Sıcak.Dialogue: 0,0:20:03.51,0:20:06.63,Main,,0,0,0,,Corazon, işi bitirebildin mi?Dialogue: 0,0:20:07.83,0:20:13.57,Main,,0,0,0,,Öyleyse parayı görelim. Mesela para olunca açık olmalıyız.Dialogue: 0,0:20:14.15,0:20:15.81,Main,,0,0,0,,Adın Law'dı değil mi?Dialogue: 0,0:20:16.01,0:20:19.69,Main,,0,0,0,,Az önce dönen bu adam da  bizim gibi yönetici.Dialogue: 0,0:20:20.07,0:20:21.99,Main,,0,0,3,,Adı Corazon.Dialogue: 0,0:20:19.72,0:20:27.55,Captions,,0,0,230,,Donquixote Ailesi ♥ Yöneticisi CorazonDialogue: 0,0:20:22.35,0:20:24.69,Main,,0,0,3,,Dalgın aptalın tekidir ama...Dialogue: 0,0:20:24.91,0:20:27.19,Main,,0,0,3,,...kanı yüzünden belki de, epey güçlüdür.Dialogue: 0,0:20:27.67,0:20:30.45,Main,,0,0,0,,Kaptan Doffy'nin öz kardeşi.Dialogue: 0,0:20:30.93,0:20:34.83,Main,,0,0,0,,Geçmişte yaşadığı bir şok yüzünden konuşamıyormuş.Dialogue: 0,0:20:34.99,0:20:36.07,Main,,0,0,0,,Ayrıca...Dialogue: 0,0:20:38.03,0:20:40.11,Main,,0,0,0,,Çocukları hiç sevmez. Dikkatli ol.Dialogue: 0,0:20:42.03,0:20:42.75,Main,,0,0,0,,Ne olu...?!Dialogue: 0,0:20:47.89,0:20:49.19,Main,,0,0,0,,Öldü!Dialogue: 0,0:20:49.27,0:20:51.49,Main,,0,0,0,,Hurda yığınına çarptı-dasuyan!Dialogue: 0,0:21:00.11,0:21:03.79,Thoughts,,0,0,0,,Deli mi lan bu herif?!Dialogue: 0,0:21:07.15,0:21:09.39,Thoughts,,0,0,0,,Geberteceğim onu!Dialogue: 0,0:21:19.33,0:21:21.63,Main,,0,0,0,,Cora-san alev aldı!Dialogue: 0,0:21:19.28,0:21:22.30,OP11 Credits,,0,0,0,,Editing: Galaxy 9000  Timing: Datenshi  QC: Mr. Luffy  Soundtracking: Halee  TC/Infoboxes: Datenshi  Original Translation: Yibis