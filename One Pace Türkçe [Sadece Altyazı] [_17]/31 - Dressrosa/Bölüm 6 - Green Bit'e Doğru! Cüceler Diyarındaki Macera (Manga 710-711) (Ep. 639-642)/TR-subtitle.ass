Dialogue: 0,0:02:30.03,0:02:38.55,Title,,0,0,0,,{\fad(2000,2000)}Green Bit'e Doğru!\NCüceler Diyarındaki Macera
Dialogue: 0,0:02:39.20,0:02:40.50,Main,,0,0,0,,Kıpırda!
Dialogue: 0,0:02:40.50,0:02:41.27,Main,,0,0,0,,Ayak altındasın!
Dialogue: 0,0:02:48.51,0:02:49.68,Main,,0,0,0,,Sen...
Dialogue: 0,0:02:51.29,0:02:52.55,Main,,0,0,0,,Bellamy.
Dialogue: 0,0:02:52.55,0:02:55.62,Main,,0,0,0,,Neden benim için\Ntezahürat yapıyordun?
Dialogue: 0,0:02:57.97,0:02:59.99,Main,,0,0,0,,Ne rezilim!
Dialogue: 0,0:02:59.99,0:03:03.70,Main,,0,0,0,,Bir damla değişmemişim.
Dialogue: 0,0:03:04.62,0:03:06.60,Main,,0,0,0,,Değişmişsin, Bellamy.
Dialogue: 0,0:03:06.60,0:03:09.34,Main,,0,0,0,,Değişen kişi sensin.
Dialogue: 0,0:03:09.34,0:03:12.68,Main,,0,0,0,,Akıl almaz seviyede\Nbir Haki'ye sahipsin.
Dialogue: 0,0:03:12.68,0:03:14.74,Main,,0,0,0,,Sinirlerimi bozuyor bu!
Dialogue: 0,0:03:14.74,0:03:19.08,Main,,0,0,0,,Onurum yerle bir edildi!
Dialogue: 0,0:03:20.35,0:03:22.08,Main,,0,0,0,,Hasır Şapka!
Dialogue: 0,0:03:24.36,0:03:28.45,Main,,0,0,0,,Hasır Şapka mı dedin?!
Dialogue: 0,0:03:28.70,0:03:31.04,Captions,,0,0,210,,{\fad(350,400)}Teslimden 45 Dakika Önce
Dialogue: 0,0:03:31.09,0:03:33.14,Captions,,0,0,210,,{\fad(350,0)}Caesar Teslim Takımı
Dialogue: 0,0:03:35.86,0:03:40.03,Main,,0,0,0,,Sudan çıktı!
Dialogue: 0,0:03:40.73,0:03:44.34,Main,,0,0,0,,Savaşçı Balık deyince ben de \Nbalık sanmıştım.
Dialogue: 0,0:03:44.34,0:03:45.96,Main,,0,0,0,,Balık değil mi zaten?
Dialogue: 0,0:03:45.96,0:03:49.83,Main,,0,0,0,,Neresi balık bunun?!\NKaiju'dan farkı yok!
Dialogue: 0,0:03:49.83,0:03:50.51,Main,,0,0,0,,Bildiğin canavar!
Dialogue: 0,0:03:51.54,0:03:55.80,Main,,0,0,0,,Kafedeki adam köprüyü koruyabilmek için\Ndemirle güçlendirdiklerini söylemişti ama...
Dialogue: 0,0:03:55.80,0:03:59.04,Main,,0,0,0,,Dayanacak mı acaba?
Dialogue: 0,0:04:03.32,0:04:05.86,Main,,0,0,0,,Kağıttan farkı yok lan!
Dialogue: 0,0:04:07.37,0:04:08.99,Main,,0,0,0,,İyi olacağız!
Dialogue: 0,0:04:08.99,0:04:11.05,Main,,0,0,0,,Bu ikisi bir şekilde halledecek.
Dialogue: 0,0:04:11.05,0:04:13.49,Main,,0,0,0,,Kolaysa sen hallet, Shichibukai!
Dialogue: 0,0:04:13.49,0:04:16.50,Main,,0,0,0,,Ben şu an dövüşemem.
Dialogue: 0,0:04:18.24,0:04:19.64,Main,,0,0,0,,Geliyor!
Dialogue: 0,0:04:20.27,0:04:21.43,Main,,0,0,0,,{\fad(150,150)}Öldürücü Darbe...
Dialogue: 0,0:04:21.43,0:04:22.16,Main,,0,0,0,,{\fad(150,0)}Yeşil Yıld-...
Dialogue: 0,0:04:25.25,0:04:26.26,Main,,0,0,0,,İki taraftan da saldırıyorlar!
Dialogue: 0,0:04:26.26,0:04:28.38,Main,,0,0,0,,Ezecekler bizi!
Dialogue: 0,0:04:28.96,0:04:30.35,Main,,0,0,0,,{\fad(150,150)}Mille Fleur...
Dialogue: 0,0:04:28.96,0:04:30.35,Note,,0,0,0,,{\fad(150,150)}Bin Çiçek!
Dialogue: 0,0:04:30.35,0:04:31.94,Main,,0,0,0,,{\fad(150,150)}Gigantesco Mano
Dialogue: 0,0:04:30.35,0:04:31.94,Note,,0,0,0,,{\fad(150,150)}Devasa Kollar!
Dialogue: 0,0:04:32.67,0:04:33.44,Main,,0,0,0,,{\fad(150,150)}Şaplak!
Dialogue: 0,0:04:37.32,0:04:38.93,Main,,0,0,0,,{\fad(150,150)}Kurukafa Bombaçiçeği!
Dialogue: 0,0:04:47.60,0:04:49.14,Main,,0,0,0,,Harika gidiyorsunuz!
Dialogue: 0,0:04:49.14,0:04:52.17,Main,,0,0,0,,Nesi harika!\NKaç taneler görmüyor musun?!
Dialogue: 0,0:04:52.17,0:04:53.67,Main,,0,0,0,,Sürü resmen!
Dialogue: 0,0:04:53.67,0:04:56.97,Main,,0,0,0,,Kaçalım! \NSavaşarak sonunu getiremeyiz bunların!
Dialogue: 0,0:04:57.81,0:05:02.18,Main,,0,0,0,,Burun-ya, Ceasar'ın zincirlerini çöz!\NOnun da savaşmasını istiyorum!
Dialogue: 0,0:05:02.18,0:05:06.05,Main,,0,0,0,,Ne diyorsun sen be?!\NUçup kaçmasını mı istiyorsun!
Dialogue: 0,0:05:06.05,0:05:08.62,Main,,0,0,0,,Öyle bir şey yapmaya cüret edemez.
Dialogue: 0,0:05:10.51,0:05:12.06,Main,,0,0,0,,Kalbim!
Dialogue: 0,0:05:15.32,0:05:18.11,Main,,0,0,0,,Benim gibi harika bir bilim adamını\Nböyle elinde oynatıp da...
Dialogue: 0,0:05:18.85,0:05:22.19,Main,,0,0,0,,...acısız bir şekilde\Nölebileceğini sanma sakın!
Dialogue: 0,0:05:23.51,0:05:25.26,Main,,0,0,0,,{\fad(150,150)}Gaztil!
Dialogue: 0,0:05:28.93,0:05:30.97,Main,,0,0,0,,Güce bak!
Dialogue: 0,0:05:30.97,0:05:32.98,Main,,0,0,0,,300 milyonluk suçlu şanının\Nhakkını veriyor!
Dialogue: 0,0:05:33.13,0:05:34.71,Main,,0,0,0,,{\fad(150,150)}Gaztil!
Dialogue: 0,0:05:37.47,0:05:38.34,Main,,0,0,0,,Koşun!
Dialogue: 0,0:05:38.81,0:05:41.64,Main,,0,0,0,,Tamam da\Nsen niye savaşmıyorsun!?
Dialogue: 0,0:05:42.10,0:05:46.19,Main,,0,0,0,,Gücümü kullanmak\Nçok fazla enerjimi tüketiyor.
Dialogue: 0,0:05:46.19,0:05:49.90,Main,,0,0,0,,Geri dönüşte tüm enerjim gerekecek!
Dialogue: 0,0:05:49.90,0:05:50.83,Main,,0,0,0,,Anlıyor musunuz şimdi?!
Dialogue: 0,0:05:50.83,0:05:53.80,Main,,0,0,0,,Mümkün mertebe\Nenerjimi korumak istiyorum!
Dialogue: 0,0:05:53.80,0:05:56.38,Main,,0,0,0,,Doflamingo'yu karşımıza alacağız!
Dialogue: 0,0:05:58.21,0:06:01.94,Main,,0,0,0,,{\i1}Bu Law ciddi ciddi\NJoker'la savaşmaya mı hazırlanıyor?{\i0}
Dialogue: 0,0:06:04.21,0:06:06.98,Main,,0,0,0,,Hay aksi! Şimdi ne yapacağız?!
Dialogue: 0,0:06:06.98,0:06:09.58,Main,,0,0,0,,Köprü yıkılmış!
Dialogue: 0,0:06:09.58,0:06:13.15,Main,,0,0,0,,Üstelik sis yüzünden öteki tarafı da\Ndoğru düzgün göremiyorum!
Dialogue: 0,0:06:14.64,0:06:17.06,Main,,0,0,0,,Savaşçı Balıklardan biri\Nbize doğru geliyor!
Dialogue: 0,0:06:17.06,0:06:21.04,Main,,0,0,0,,Lanet olsun, köprüye daha fazla\Nzarar vermesine izin veremem!
Dialogue: 0,0:06:22.84,0:06:23.33,Main,,0,0,0,,{\fad(150,0)}Od...
Dialogue: 0,0:06:29.10,0:06:30.50,Main,,0,0,0,,Durdu.
Dialogue: 0,0:06:31.94,0:06:33.73,Main,,0,0,0,,Yakaladık!
Dialogue: 0,0:06:33.73,0:06:35.64,Main,,0,0,0,,Çekin!
Dialogue: 0,0:06:35.64,0:06:37.03,Main,,0,0,0,,Sağlam bir galibiyetti!
Dialogue: 0,0:06:37.03,0:06:39.66,Main,,0,0,0,,Savaşçı Balık güvecimizi yiyip\Ngücümüze güç katalım bugün!
Dialogue: 0,0:06:39.66,0:06:42.03,Main,,0,0,0,,Evet!
Dialogue: 0,0:06:42.03,0:06:43.77,Main,,0,0,0,,Kimin sesi bu?
Dialogue: 0,0:06:43.77,0:06:46.57,Main,,0,0,0,,Ada sakinlerinin mi?
Dialogue: 0,0:06:46.57,0:06:49.55,Main,,0,0,0,,Issız bir ada değil miydi orası?
Dialogue: 0,0:06:50.21,0:06:54.56,Main,,0,0,0,,Öte tarafta kim var?!
Dialogue: 0,0:06:54.56,0:06:58.40,Main,,0,0,0,,Biz de o tarafa geçmek istiyoruz!
Dialogue: 0,0:06:58.74,0:07:00.42,Main,,0,0,0,,Olamaz insanlar!
Dialogue: 0,0:07:00.42,0:07:02.13,Main,,0,0,0,,Acele edin, kaçalım!
Dialogue: 0,0:07:14.48,0:07:18.28,Main,,0,0,0,,Law! Lanet olası...\NBunun hesabını sorarım senden!
Dialogue: 0,0:07:18.28,0:07:21.96,Main,,0,0,0,,Manzaraya gel!
Dialogue: 0,0:07:21.96,0:07:25.13,Main,,0,0,0,,Aslında en başından\Nböyle yapmamız lazımmış.
Dialogue: 0,0:07:25.53,0:07:27.83,Main,,0,0,0,,Doğru dedin bak!
Dialogue: 0,0:07:27.83,0:07:29.57,Main,,0,0,0,,Hadi oradan be!
Dialogue: 0,0:07:29.57,0:07:33.84,Main,,0,0,0,,Üç kişiyi uçurmak için ne kadar gaz gücü kullanmam gerekiyor biliyor musunuz siz?!
Dialogue: 0,0:07:33.84,0:07:37.87,Main,,0,0,0,,Önemli bir rehineyim ben be!
Dialogue: 0,0:07:38.98,0:07:41.77,Main,,0,0,0,,Sürükledikleri balığın izi\Nburada son buluyor.
Dialogue: 0,0:07:42.30,0:07:45.24,Main,,0,0,0,,Henüz kimse gelmemiş gibi duruyor.
Dialogue: 0,0:07:45.24,0:07:50.08,Main,,0,0,0,,Deniz, balıkların batırdıkları gemilerle dolu.
Dialogue: 0,0:07:50.08,0:07:52.78,Main,,0,0,0,,Az önceki neydi peki?
Dialogue: 0,0:07:54.26,0:07:56.29,Main,,0,0,0,,Şu da ne?!
Dialogue: 0,0:08:00.84,0:08:05.80,Captions,,0,0,210,,{\fad(500,0)}Issız Ada Dressrosa'nın Kuzeyi \N"GREEN BIT"
Dialogue: 0,0:08:01.81,0:08:05.80,Main,,0,0,15,,{\an8}Balta girmemiş ormanın da böylesi!
Dialogue: 0,0:08:12.24,0:08:16.74,Main,,0,0,0,,Green Bit burası mı?!
Dialogue: 0,0:08:17.37,0:08:20.61,Main,,0,0,0,,Bu devasa bitkiler de\Nneyin nesi böyle?
Dialogue: 0,0:08:22.84,0:08:27.44,Main,,0,0,0,,Burada mısın Joker, ben geldim!\NAl hadi beni!
Dialogue: 0,0:08:28.24,0:08:29.42,Main,,0,0,0,,Acele etme.
Dialogue: 0,0:08:30.18,0:08:33.54,Main,,0,0,0,,Anlaştığımız güney sahili şu ileride.
Dialogue: 0,0:08:33.95,0:08:37.36,Main,,0,0,0,,Seni oraya saat üçte bırakacağız.
Dialogue: 0,0:08:38.76,0:08:40.82,Main,,0,0,0,,Arkamıza bakın!
Dialogue: 0,0:08:41.97,0:08:44.52,Main,,0,0,0,,Donanma gemisi değil mi bu?!
Dialogue: 0,0:08:46.22,0:08:50.85,Main,,0,0,0,,Adaya saplanmış resmen!\NHani karaya oturmanın da ötesinde!
Dialogue: 0,0:08:50.85,0:08:52.96,Main,,0,0,0,,Nasıl olur ki böyle bir şey?
Dialogue: 0,0:08:58.46,0:09:01.25,Main,,0,0,0,,Bitkilerdeki bu kesikler\Nyeni gibi duruyor.
Dialogue: 0,0:09:01.25,0:09:02.13,Main,,0,0,0,,Ne?
Dialogue: 0,0:09:02.13,0:09:06.12,Main,,0,0,0,,Tahminimce o gemi buraya \Ngeleli çok olmamış.
Dialogue: 0,0:09:06.56,0:09:10.11,Main,,0,0,0,,Gövdesi pek hasar da almamış.
Dialogue: 0,0:09:10.11,0:09:13.93,Main,,0,0,0,,Savaşçı Balık dolu sulardan mı\Ngeçip gelmişler?!
Dialogue: 0,0:09:15.22,0:09:19.57,Main,,0,0,0,,Donanma askerlerinin\Nburaya gelmesi an meselesi.
Dialogue: 0,0:09:19.57,0:09:23.01,Main,,0,0,0,,Ne?!\NTeslimat yapılacağını biliyorlar mı?!
Dialogue: 0,0:09:23.01,0:09:24.74,Main,,0,0,0,,Olur mu öyle şey ya?
Dialogue: 0,0:09:25.14,0:09:27.96,Main,,0,0,0,,Gerzek bilim adamı,\Nsesin çok çıkıyor!
Dialogue: 0,0:09:29.54,0:09:32.69,Main,,0,0,0,,Aranan biriyim ben be!
Dialogue: 0,0:09:32.69,0:09:36.15,Main,,0,0,0,,Üstelik patron dediğim adam Joker'ın Shichibukai'lıktan istifa ettiğini de düşünürsek...
Dialogue: 0,0:09:36.15,0:09:38.72,Main,,0,0,0,,...beni koruyan hiçbir kanun yok!
Dialogue: 0,0:09:38.72,0:09:43.71,Main,,0,0,0,,Donanma askerlerinin cirit attığı bir adada\Nböyle kelepçelerle bırakırsanız beni...
Dialogue: 0,0:09:43.71,0:09:46.72,Main,,0,0,0,,Sus dedik sana be!
Dialogue: 0,0:09:46.72,0:09:50.87,Main,,0,0,0,,Durun biraz,\NJoker da artık sıradan bir korsan!
Dialogue: 0,0:09:53.38,0:09:55.31,Main,,0,0,0,,Bir şeyler saklıyor gibisin.
Dialogue: 0,0:09:55.31,0:09:57.63,Main,,0,0,0,,Sana öyle gelmiştir.
Dialogue: 0,0:09:57.63,0:10:00.61,Main,,0,0,0,,Ayrıca neden\NDonanma'yı buraya getireyim ki?
Dialogue: 0,0:10:01.32,0:10:04.11,Flashbacks,,0,0,0,,Green Bit'e gitmeyi düşünüyorum.
Dialogue: 0,0:10:04.55,0:10:07.92,Main,,0,0,0,,Beni böyle bir yerde teslim etmeniz\Nhiç adil değil! Teslimatı iptal edin!
Dialogue: 0,0:10:08.16,0:10:15.46,Main,,0,0,0,,Donanma benim de düşmanım. Keza Hasır Şapka tayfasıyla ittifak halindeyim.
Dialogue: 0,0:10:15.46,0:10:18.88,Main,,0,0,0,,Beni oyuna falan getirmiyorsun değil mi?!
Dialogue: 0,0:10:19.71,0:10:21.40,Main,,0,0,0,,15 dakikamız kaldı.
Dialogue: 0,0:10:22.03,0:10:27.04,Main,,0,0,0,,Siz keskin nişancılık ve gözetlemeyle\Narkamı kollayacaksınız.
Dialogue: 0,0:10:27.59,0:10:31.87,Main,,0,0,0,,Saklananlar olabilir.\NOrmanı kontrol edin.
Dialogue: 0,0:10:31.87,0:10:34.35,Main,,0,0,0,,Bir şey bulacak olursanız\Nhemen haber verin.
Dialogue: 0,0:10:35.10,0:10:36.88,Main,,0,0,0,,Pekâlâ.
Dialogue: 0,0:10:36.88,0:10:38.53,Main,,0,0,0,,Dur bakalım biraz!
Dialogue: 0,0:10:38.53,0:10:41.58,Main,,0,0,0,,Donanmanın burada olacağı söylenmemişti bize!
Dialogue: 0,0:10:44.56,0:10:47.53,Captions,,0,0,210,,{\fad(500,0)}Green Bit Ormanı,\NTeslimata 14 Dakika Kaldı.
Dialogue: 0,0:10:51.55,0:10:53.60,Main,,0,0,0,,R-Robin!
Dialogue: 0,0:10:56.91,0:10:59.01,Main,,0,0,0,,Tehlikeli bir orman bu, bekle!
Dialogue: 0,0:11:00.20,0:11:01.74,Main,,0,0,0,,Benden fazla uzaklaşma!
Dialogue: 0,0:11:02.70,0:11:05.78,Main,,0,0,0,,Beni düşündüğün için\Nteşekkür ederim, Usopp.
Dialogue: 0,0:11:05.78,0:11:07.65,Main,,0,0,0,,Çok bağırıyorsun!
Dialogue: 0,0:11:10.77,0:11:12.91,Main,,0,0,0,,Yalvarıyorum geride bırakma beni!
Dialogue: 0,0:11:16.48,0:11:19.08,Main,,0,0,0,,Biraz daha yavaş yürüyemez misin?
Dialogue: 0,0:11:21.10,0:11:23.25,Main,,0,0,0,,Birden durmasana Robin...
Dialogue: 0,0:11:23.25,0:11:25.67,Main,,0,0,0,,Kim var orada?!\NHasır Şapkalar'dan biri mi?!
Dialogue: 0,0:11:26.22,0:11:27.53,Main,,0,0,0,,Buldular bizi!
Dialogue: 0,0:11:30.56,0:11:32.34,Main,,0,0,0,,Neredeler?\NNerede bunlar?!
Dialogue: 0,0:11:32.34,0:11:35.52,Main,,0,0,0,,Bilemediniz!\NBenim adım Leo!
Dialogue: 0,0:11:35.52,0:11:38.74,Main,,0,0,0,,Donanma askerleri...\NKiminle konuşuyorlar?
Dialogue: 0,0:11:38.74,0:11:42.61,Main,,0,0,0,,Anlaşılan bu adaya geleceğimizi biliyorlarmış.
Dialogue: 0,0:11:42.61,0:11:46.29,Main,,0,0,0,,İyi insanlar mısınız\Nyoksa kötü mü?
Dialogue: 0,0:11:47.28,0:11:50.13,Main,,0,0,0,,Donanma askerleriyiz biz!\NHalkı koruruz!
Dialogue: 0,0:11:50.13,0:11:52.01,Main,,0,0,0,,Anlayacağın üzere iyi insanlarız!
Dialogue: 0,0:11:52.79,0:11:54.82,Main,,0,0,0,,Öyleyse lütfen silahlarınızı verin!
Dialogue: 0,0:11:56.50,0:11:59.67,Main,,0,0,0,,Silahlarımızı veremeyiz!\NTamamlamamız gereken bir işimiz var!
Dialogue: 0,0:11:59.67,0:12:00.72,Main,,0,0,0,,Göster kendini!
Dialogue: 0,0:12:04.84,0:12:06.94,Main,,0,0,0,,Oha?!\NBu da ne?
Dialogue: 0,0:12:06.94,0:12:08.54,Main,,0,0,0,,Çok hızlı, göremiyorum.
Dialogue: 0,0:12:11.34,0:12:13.11,Main,,0,0,0,,Nasıl bir orman bu böyle?!
Dialogue: 0,0:12:13.11,0:12:14.09,Main,,0,0,0,,Lanet olsun!
Dialogue: 0,0:12:14.09,0:12:16.35,Main,,0,0,0,,Neyimiz var neyimiz yok aldılar!
Dialogue: 0,0:12:19.67,0:12:20.81,Main,,0,0,0,,{\fad(150,150)}Mille Fleur...
Dialogue: 0,0:12:19.67,0:12:20.81,Note,,0,0,0,,{\fad(150,150)}Bin Çiçek!
Dialogue: 0,0:12:21.20,0:12:22.69,Main,,0,0,0,,{\fad(150,150)}Campo de Flores!
Dialogue: 0,0:12:21.20,0:12:22.69,Note,,0,0,0,,{\fad(150,150)}Çiçek Sahası!
Dialogue: 0,0:12:26.17,0:12:27.29,Main,,0,0,0,,Yakaladım!
Dialogue: 0,0:12:27.29,0:12:28.96,Main,,0,0,0,,Ne yakaladın?!
Dialogue: 0,0:12:29.86,0:12:31.55,Main,,0,0,0,,Sanırım küçük bir insan!
Dialogue: 0,0:12:31.55,0:12:32.85,Main,,0,0,0,,Ne!?
Dialogue: 0,0:12:40.00,0:12:41.67,Main,,0,0,0,,Çantasında ne var?
Dialogue: 0,0:12:41.67,0:12:43.59,Main,,0,0,0,,Kitap, defter ve kıyafetler.
Dialogue: 0,0:12:43.59,0:12:44.80,Main,,0,0,0,,Şeker de var.
Dialogue: 0,0:12:44.80,0:12:46.37,Main,,0,0,0,,Bir de Den Den Mushi var.
Dialogue: 0,0:12:46.37,0:12:48.25,Main,,0,0,0,,Silahların hepsini alın.
Dialogue: 0,0:12:48.25,0:12:50.21,Main,,0,0,0,,Kıyafetlerinin altında bir şeyler olabilir!
Dialogue: 0,0:12:50.73,0:12:52.63,Main,,0,0,0,,Şu anda arıyoruz!
Dialogue: 0,0:12:56.76,0:12:58.43,Main,,0,0,0,,C Noktasında bir şey yok.
Dialogue: 0,0:12:58.43,0:12:59.22,Main,,0,0,0,,Anlaşılmıştır.
Dialogue: 0,0:12:59.73,0:13:01.61,Main,,0,0,0,,A Noktasında bir şey yok.
Dialogue: 0,0:13:01.61,0:13:02.99,Main,,0,0,0,,Anlaşılmıştır.
Dialogue: 0,0:13:06.93,0:13:10.33,Main,,0,0,0,,B noktasında da\Nhiçbir şey saklamıyor.
Dialogue: 0,0:13:15.68,0:13:19.18,Main,,0,0,0,,Büyük İnsan uyandı!
Dialogue: 0,0:13:19.68,0:13:21.40,Main,,0,0,0,,Savaş durumu!
Dialogue: 0,0:13:21.40,0:13:22.55,Main,,0,0,0,,Pekâlâ!
Dialogue: 0,0:13:23.92,0:13:27.35,Main,,0,0,0,,Kaçmaya çalışma, uslu dur!
Dialogue: 0,0:13:27.97,0:13:30.97,Main,,0,0,0,,Yere tutturulmuşum!
Dialogue: 0,0:13:30.97,0:13:33.93,Main,,0,0,0,,Boş yere hareket etmeye çalışma!
Dialogue: 0,0:13:34.38,0:13:37.00,Main,,0,0,0,,Dikiş Dikiş gücümü kullanarak...
Dialogue: 0,0:13:37.00,0:13:39.28,Main,,0,0,0,,...seni yere diktim!
Dialogue: 0,0:13:39.28,0:13:40.93,Main,,0,0,0,,Dikiş Dikiş gücü mü?
Dialogue: 0,0:13:40.93,0:13:46.39,Main,,0,0,0,,Evet!\NSeni bu iğneyle diktim!
Dialogue: 0,0:13:46.39,0:13:48.34,Main,,0,0,0,,Büyük kötü insanlardansın sen, değil mi?
Dialogue: 0,0:13:48.94,0:13:52.36,Main,,0,0,0,,Özür dilerim ama\Nbir yanlış anlaşılma var sanırım.
Dialogue: 0,0:13:52.36,0:13:54.21,Main,,0,0,0,,Güç kullanıcısı mısın?
Dialogue: 0,0:13:54.21,0:13:58.72,Main,,0,0,0,,{\an8}Tontatta Kabilesi savaşçısı\NLeo benim adım!
Dialogue: 0,0:13:54.71,0:13:58.72,Captions,,0,0,240,,{\fad(500,0)}Tontatta Kabilesi Üyesi (Cüce)\NSavaşçı Leo
Dialogue: 0,0:13:58.72,0:14:02.49,Main,,0,0,0,,Leo-san, neredeyim acaba?
Dialogue: 0,0:14:02.49,0:14:03.62,Main,,0,0,0,,Usopp nerede?
Dialogue: 0,0:14:03.62,0:14:07.79,Main,,0,0,0,,Yani şu öteki insanı diyorum,\Nburada değil mi acaba?
Dialogue: 0,0:14:08.89,0:14:10.01,Main,,0,0,0,,İyi mi?
Dialogue: 0,0:14:12.50,0:14:18.53,Main,,0,0,0,,Koca burunlu Büyük İnsan da krallığımızın kurallarına uygun bir biçimde yakalandı.
Dialogue: 0,0:14:18.53,0:14:21.74,Main,,0,0,0,,Öyleyse siz Küçük İnsanlar'ın\Nkrallığındayız şu anda doğru mu?
Dialogue: 0,0:14:21.74,0:14:28.53,Main,,0,0,0,,Evet, kabilemizin inşa ettiği ve ormanın altında bulunan Tontatta Krallığı'ndasın.
Dialogue: 0,0:14:28.53,0:14:31.74,Main,,0,0,0,,Ormanın altı derken,\NGreen Bit'i mi kastediyorsunuz?
Dialogue: 0,0:14:31.74,0:14:35.69,Main,,0,0,0,,O devasa bitkileri\Nsiz mi yetiştirdiniz?
Dialogue: 0,0:14:35.69,0:14:39.86,Main,,0,0,0,,Evet!\NYetiştiremeyeceğimiz bitki yoktur!
Dialogue: 0,0:14:39.86,0:14:41.82,Main,,0,0,0,,Millet, dikkatli olun!
Dialogue: 0,0:14:41.82,0:14:42.78,Main,,0,0,0,,Kabu-{\i0}san{\i0}!
Dialogue: 0,0:14:42.78,0:14:47.36,Main,,0,0,0,,Bu Büyük İnsan topraktan\Nçiçek benzeri eller çıkartabiliyor!
Dialogue: 0,0:14:47.36,0:14:48.75,Main,,0,0,0,,Çiçek benzeri eller mi!?
Dialogue: 0,0:14:48.75,0:14:52.27,Main,,0,0,0,,Biz hiç öyle\Nele benzeyen çiçek yetiştirmedik!
Dialogue: 0,0:14:52.27,0:14:56.64,Main,,0,0,0,,Evet, kesin büyü işi!\NHayatımda gördüğüm en tuhaf şeylerdi!
Dialogue: 0,0:14:56.64,0:14:59.87,Main,,0,0,0,,Kaçmama fırsat bırakmadan\Nyakalayıverdi beni!
Dialogue: 0,0:14:59.87,0:15:02.85,Flashbacks,,0,0,0,,Denicilerin kıyafetlerini mi çıkardınız?
Dialogue: 0,0:15:02.85,0:15:06.47,Flashbacks,,0,0,0,,Bir şekilde beni uyutup buraya taşımışlar.
Dialogue: 0,0:15:11.78,0:15:14.34,Thoughts,,0,0,0,,{\i1}Gücümü kullanarak bu durumdan \Nkurtulabilirim fakat...{\i0}
Dialogue: 0,0:15:14.37,0:15:16.93,Thoughts,,0,0,0,,{\i1}...daha büyük bir karışıklık\Nmeydana gelir muhtemelen.{\i0}
Dialogue: 0,0:15:21.50,0:15:24.64,Main,,0,0,0,,Büyük İnsan, neyin peşindesin?
Dialogue: 0,0:15:24.64,0:15:26.97,Main,,0,0,0,,Tontatta Krallığı'nı\Nyok etmeye mi geldin?!
Dialogue: 0,0:15:26.97,0:15:31.84,Main,,0,0,0,,Hayır! Özür dilerim! Onu sadece\Nmerak ettiğim için yakalamıştım!
Dialogue: 0,0:15:31.84,0:15:34.02,Main,,0,0,0,,Sebebi ne olursa olsun...
Dialogue: 0,0:15:34.02,0:15:39.68,Main,,0,0,0,,...Tontatta Kabilesi'ni gören kişilerin\Nburadan sağ kurtulmasına izin veremeyiz.
Dialogue: 0,0:15:39.68,0:15:43.64,Main,,0,0,0,,Nasıl olur?! Hiçbirinize\Nzarar vermek gibi bir niyetim yoktu.
Dialogue: 0,0:15:43.64,0:15:47.54,Main,,0,0,0,,...ve sizi gördüğümü de\Nkimselere söylemem!
Dialogue: 0,0:15:47.54,0:15:48.52,Main,,0,0,0,,Yalan söyleme!
Dialogue: 0,0:15:48.52,0:15:50.46,Main,,0,0,0,,Bahanelerini dinlemek istemiyorum!
Dialogue: 0,0:15:50.46,0:15:51.47,Main,,0,0,0,,Doğru söylüyorum!
Dialogue: 0,0:15:51.47,0:15:52.48,Main,,0,0,0,,Ne?
Dialogue: 0,0:15:53.58,0:15:55.38,Main,,0,0,0,,Peki öyleyse!
Dialogue: 0,0:15:56.65,0:15:58.27,Main,,0,0,0,,{\i1}Ne?!{\i0}
Dialogue: 0,0:15:58.27,0:16:00.39,Main,,0,0,0,,Şükürler olsun!
Dialogue: 0,0:16:00.39,0:16:02.05,Main,,0,0,0,,Kötü biri sanmıştım ben de.
Dialogue: 0,0:16:02.05,0:16:03.87,Main,,0,0,0,,Rahatladım!
Dialogue: 0,0:16:05.29,0:16:06.98,Thoughts,,0,0,0,,{\i1}İnandılar!{\i0}
Dialogue: 0,0:16:09.79,0:16:12.46,Thoughts,,0,0,0,,{\i1}Nasıl bir saflıktır bu?{\i0}
Dialogue: 0,0:16:12.46,0:16:14.22,Main,,0,0,0,,Özgürsün!
Dialogue: 0,0:16:15.00,0:16:17.64,Main,,0,0,0,,Gözlüklerini geri vereyim.
Dialogue: 0,0:16:17.64,0:16:19.12,Main,,0,0,0,,Teşekkür ederim.
Dialogue: 0,0:16:20.38,0:16:21.93,Main,,0,0,0,,Hey, Leo!
Dialogue: 0,0:16:21.93,0:16:23.16,Main,,0,0,0,,Tonta-şef-sama!
Dialogue: 0,0:16:23.16,0:16:25.47,Main,,0,0,0,,Ne yapıyorsun sen?
Dialogue: 0,0:16:25.47,0:16:28.54,Main,,0,0,0,,Tonta-şef-sama, bu insan iyi biriymiş!
Dialogue: 0,0:16:28.54,0:16:30.00,Main,,0,0,0,,Olur mu öyle şey?!
Dialogue: 0,0:16:30.59,0:16:32.62,Main,,0,0,0,,Ama kendisi söyledi.
Dialogue: 0,0:16:32.62,0:16:34.33,Main,,0,0,0,,Ne?!
Dialogue: 0,0:16:34.33,0:16:35.72,Main,,0,0,0,,Olur o zaman.
Dialogue: 0,0:16:35.72,0:16:39.28,Thoughts,,0,0,0,,{\i1}Gene inandılar!\NSaflıklarının sınırı yok mu?!{\i0}
Dialogue: 0,0:16:39.28,0:16:44.68,Main,,0,0,0,,Büyük İnsanlar'a böyle\Nyakından bakma fırsatı bulamayız pek.
Dialogue: 0,0:16:44.68,0:16:45.43,Main,,0,0,0,,Sen kimsin?
Dialogue: 0,0:16:45.43,0:16:51.39,Main,,0,0,0,,{\an8}Adım Gancho. Tontatta Krallı'ğının lideri, \NTonta-şef ben.
Dialogue: 0,0:16:48.93,0:16:53.79,Captions,,0,0,240,,{\fad(500,0)}Tontatta Krallığı Tonta Şefi (Kral)\N Gancho
Dialogue: 0,0:16:51.39,0:16:53.79,Main,,0,0,0,,{\an8}Burada istediğin kadar kalabilirsin.
Dialogue: 0,0:16:54.43,0:16:57.79,Main,,0,0,0,,Den Den Mushi'm nerede acaba?
Dialogue: 0,0:16:58.89,0:17:01.77,Main,,0,0,0,,Doğaya geri saldım!
Dialogue: 0,0:17:03.53,0:17:06.80,Main,,0,0,0,,Olamaz, saat neredeyse üç olmuş!
Dialogue: 0,0:17:06.80,0:17:09.01,Main,,0,0,0,,Law'ı aramam lazım!
Dialogue: 0,0:17:09.01,0:17:10.63,Main,,0,0,0,,Çıkış ne tarafta?
Dialogue: 0,0:17:10.63,0:17:11.57,Main,,0,0,0,,Gitmem gerekli.
Dialogue: 0,0:17:11.57,0:17:14.65,Main,,0,0,0,,Bekle bakalım!\NGidiyor musun?
Dialogue: 0,0:17:14.65,0:17:16.08,Main,,0,0,0,,İyi biri olduğunu sanmıştım!
Dialogue: 0,0:17:16.08,0:17:18.83,Main,,0,0,0,,İyi bir insansan silahını bize ver!
Dialogue: 0,0:17:18.83,0:17:19.98,Main,,0,0,0,,Kural böyle!
Dialogue: 0,0:17:19.98,0:17:22.52,Main,,0,0,0,,Vermezsen neyin var neyin yok soyarız!
Dialogue: 0,0:17:22.52,0:17:24.36,Main,,0,0,0,,Silahım yok ki benim!
Dialogue: 0,0:17:24.36,0:17:27.06,Main,,0,0,0,,Bize başka seçenek bırakmadın öyleyse.
Dialogue: 0,0:17:30.08,0:17:32.41,Main,,0,0,0,,Neyin var neyin yok soyacağız!
Dialogue: 0,0:17:33.66,0:17:35.52,Main,,0,0,0,,Her şeyini alın!
Dialogue: 0,0:17:38.20,0:17:41.71,Main,,0,0,0,,Yapmayın, bekleyin!
Dialogue: 0,0:17:41.71,0:17:42.85,Main,,0,0,0,,Ne oldu?
Dialogue: 0,0:17:47.19,0:17:49.15,Main,,0,0,0,,O Büyük İnsan...
Dialogue: 0,0:17:49.15,0:17:52.09,Main,,0,0,0,,...kahramanımızın ortağıymış!
Dialogue: 0,0:17:52.09,0:17:53.69,Main,,0,0,0,,Ne?!
Dialogue: 0,0:17:53.69,0:17:55.66,Main,,0,0,0,,Kahramanın mı?!
Dialogue: 0,0:17:55.66,0:17:56.82,Thoughts,,0,0,0,,{\i1}Usopp mu acaba?{\i0}
Dialogue: 0,0:17:57.15,0:17:59.62,Main,,0,0,0,,Bahsettiğin bu kahraman da kim?
Dialogue: 0,0:17:59.62,0:18:04.90,Main,,0,0,0,,Yakaladığımız öbür Büyük İnsan'dan\Nbahsediyorum!
Dialogue: 0,0:18:04.90,0:18:08.58,Main,,0,0,0,,O bizi kurtarmak için ortaya çıkmış...
Dialogue: 0,0:18:08.58,0:18:11.88,Main,,0,0,0,,efsanevi... efsanevi...
Dialogue: 0,0:18:11.88,0:18:15.51,Main,,0,0,0,,Efsanevi kahramanmış!
Dialogue: 0,0:18:16.35,0:18:18.11,Main,,0,0,0,,Bak buna sevindim işte!
Dialogue: 0,0:18:18.11,0:18:19.40,Main,,0,0,0,,Harika!
Dialogue: 0,0:18:19.40,0:18:21.16,Main,,0,0,0,,Onu görmek istiyorum!
Dialogue: 0,0:18:21.16,0:18:24.07,Thoughts,,0,0,0,,{\i1}Usopp...\NNe yalan söyledin acaba?{\i0}
Dialogue: 0,0:18:25.46,0:18:29.59,Captions,,0,0,250,,{\fad(1400,0)}Dressrosa\NLiman Şehri Acacia
Dialogue: 0,0:18:27.94,0:18:29.59,Main,,0,0,0,,{\an8}Sağa dön, sağ dedim!
Dialogue: 0,0:18:30.71,0:18:32.76,Main,,0,0,0,,Neden sola döndün?!
Dialogue: 0,0:18:32.76,0:18:36.59,Main,,0,0,0,,Kapa çeneni be!\NKonuşup duruyorsun dikkatim dağılıyor!
Dialogue: 0,0:18:36.59,0:18:39.43,Main,,0,0,0,,Anne, amca kendi kendine konuşuyor.
Dialogue: 0,0:18:39.43,0:18:41.40,Main,,0,0,0,,Gözlerine bakma!
Dialogue: 0,0:18:42.93,0:18:44.84,Main,,0,0,0,,Bizim de acelemiz var herhâlde!
Dialogue: 0,0:18:44.84,0:18:46.75,Main,,0,0,0,,Benim kadar olamaz!
Dialogue: 0,0:18:46.75,0:18:50.51,Main,,0,0,0,,Yetişemezsem senin suçun!
Dialogue: 0,0:18:50.51,0:18:52.21,Main,,0,0,0,,Çabuk Çiçek Bahçesi'ne götür beni!
Dialogue: 0,0:18:52.60,0:18:54.85,Main,,0,0,0,,Anladık be, bir sus!
Dialogue: 0,0:19:00.38,0:19:03.98,Flashbacks,,0,0,0,,Eyvah ki ne eyvah!
Dialogue: 0,0:19:03.98,0:19:06.37,Flashbacks,,0,0,0,,Ne aptalım ben!\Nİnsan görecek beni!
Dialogue: 0,0:19:07.97,0:19:10.19,Flashbacks,,0,0,0,,Kaçmam lazım yoksa görüneceğim!
Dialogue: 0,0:19:16.14,0:19:17.67,Flashbacks,,0,0,0,,Aptalım!
Dialogue: 0,0:19:17.67,0:19:20.04,Flashbacks,,0,0,0,,Aptalım, gerzeğim, odun beyinliyim!
Dialogue: 0,0:19:20.04,0:19:22.34,Flashbacks,,0,0,0,,Er ya da geç\Nböyle olacağını biliyordum!
Dialogue: 0,0:19:22.96,0:19:25.91,Flashbacks,,0,0,0,,Peri dedikleri şey bu mu?
Dialogue: 0,0:19:25.91,0:19:26.64,Flashbacks,,0,0,0,,Oyuncak mısın?
Dialogue: 0,0:19:26.71,0:19:32.07,Captions,,0,0,250,,{\fad(600,600)}Tontatta Krallığı Üyesi (Cüce)\N Keşif Birliği Üyesi: Wicca
Dialogue: 0,0:19:26.64,0:19:28.95,Flashbacks,,0,0,0,,{\an8}Oyuncak değilim ben!
Dialogue: 0,0:19:28.95,0:19:31.51,Flashbacks,,0,0,0,,{\an8}Tontatta Kabilesi'nden Wicka'yım!
Dialogue: 0,0:19:31.51,0:19:34.61,Flashbacks,,0,0,0,,{\an8}Lütfen beni gördüğünü kimseye söyleme!
Dialogue: 0,0:19:37.21,0:19:38.62,Flashbacks,,0,0,0,,Şimdi ne oldu?!
Dialogue: 0,0:19:38.62,0:19:43.87,Flashbacks,,0,0,0,,Yürüyemiyorum!\NAz önce ayağımı burktum sanırım!
Dialogue: 0,0:19:43.87,0:19:48.60,Flashbacks,,0,0,0,,Çok aptalım!\NAptal, aptal, aptal, aptal, aptal...
Dialogue: 0,0:19:49.18,0:19:52.24,Flashbacks,,0,0,0,,Nasıl bir güçtür bu?!\NZemini parçalıyorsun.
Dialogue: 0,0:19:52.84,0:19:54.21,Flashbacks,,0,0,0,,Yalvarıyorum!
Dialogue: 0,0:19:54.21,0:19:58.22,Flashbacks,,0,0,0,,Beni komutanımın olduğu yere götür!
Dialogue: 0,0:19:58.22,0:20:01.92,Flashbacks,,0,0,0,,Hem zaten bunun sorumlusu sensin!
Dialogue: 0,0:20:01.92,0:20:04.18,Flashbacks,,0,0,0,,Katanamı çalmasaydın böyle olmazdı!
Dialogue: 0,0:20:04.36,0:20:07.73,Flashbacks,,0,0,0,,Bizler bu toprakların\Nyeşilini idare ederiz!
Dialogue: 0,0:20:07.73,0:20:14.19,Flashbacks,,0,0,0,,Bu ülkenin Büyük İnsanları bize "periler" der ve pek çok şey verirler!
Dialogue: 0,0:20:14.19,0:20:17.54,Flashbacks,,0,0,0,,Acele etmeliyim!\NKeşif Birliğindenim ben!
Dialogue: 0,0:20:17.54,0:20:22.30,Flashbacks,,0,0,0,,Komutanıma Don Quixote Ailesi'nin\Nyerini bildirmeliyim!
Dialogue: 0,0:20:22.30,0:20:24.51,Flashbacks,,0,0,0,,Şimdi tam sırası!
Dialogue: 0,0:20:24.51,0:20:30.57,Flashbacks,,0,0,0,,Don Quixote Ailesi'ni Hasır Şapkalar'ın gemisine saldırmaya giderlerken gördüm!
Dialogue: 0,0:20:30.57,0:20:31.64,Flashbacks,,0,0,0,,Ne dedin?!
Dialogue: 0,0:20:33.73,0:20:37.16,Flashbacks,,0,0,0,,Aptal ben!\NHer şeyi söyledim resmen!
Dialogue: 0,0:20:37.16,0:20:41.89,Flashbacks,,0,0,0,,Doğru mu söylüyorsun?!\NBen o Hasır Şapkalar'dan biriyim!
Dialogue: 0,0:20:43.20,0:20:45.89,Flashbacks,,0,0,0,,Aptal!\NÇok aptalım, aptal!
Dialogue: 0,0:20:46.42,0:20:48.59,Flashbacks,,0,0,0,,Yavaş biraz!\NŞehri yıkma!
Dialogue: 0,0:20:48.92,0:20:50.77,Flashbacks,,0,0,0,,Sakin ol, peri!
Dialogue: 0,0:20:50.77,0:20:55.90,Flashbacks,,0,0,0,,Don Quixote Ailesi'nin Sunny-go'ya\Nsaldırmaya hazırlandığı doğru mu?!
Dialogue: 0,0:20:56.47,0:21:00.55,Flashbacks,,0,0,0,,Sır!\NAma gördüm onları!
Dialogue: 0,0:21:00.55,0:21:03.31,Flashbacks,,0,0,0,,Olamaz gene söyledim!
Dialogue: 0,0:21:05.46,0:21:07.22,Flashbacks,,0,0,0,,Den Den Mushi de yok üzerimde.
Dialogue: 0,0:21:07.22,0:21:09.55,Flashbacks,,0,0,0,,Bunu onlara hiçbir şekilde söyleyemem.
Dialogue: 0,0:21:10.08,0:21:11.70,Flashbacks,,0,0,0,,Hepsini geçtim...
Dialogue: 0,0:21:11.70,0:21:13.80,Flashbacks,,0,0,0,,...saldıracakları kişiler de onlar!
Dialogue: 0,0:21:15.84,0:21:18.56,Flashbacks,,0,0,0,,Pekâlâ, Sunny-go'ya\Ngideyim o zaman ben!
Dialogue: 0,0:21:19.28,0:21:20.26,Flashbacks,,0,0,0,,Bekle!
Dialogue: 0,0:21:20.62,0:21:24.15,Flashbacks,,0,0,0,,Lütfen önce beni\NÇiçek Bahçesi'ne götür!
Dialogue: 0,0:21:24.15,0:21:27.52,Flashbacks,,0,0,0,,Götürürsen ben de seni oradan\Nçabucak denize götürürüm.
Dialogue: 0,0:21:27.52,0:21:30.13,Flashbacks,,0,0,0,,Bana ne!\NBen denizi kendim bulurum!
Dialogue: 0,0:21:31.16,0:21:32.30,Flashbacks,,0,0,0,,Tamam da...
Dialogue: 0,0:21:32.30,0:21:34.32,Flashbacks,,0,0,0,,...tam tersi yönde gidiyorsun!
Dialogue: 0,0:21:36.76,0:21:39.71,Flashbacks,,0,0,0,,Nereye gideceğini bilmiyorsun değil mi?!
Dialogue: 0,0:21:42.70,0:21:43.68,Main,,0,0,0,,Özetle...
Dialogue: 0,0:21:43.85,0:21:48.99,Main,,0,0,0,,...Doflamingo'nun adamları\Nher hareketimizi gözlüyormuş demek?
Dialogue: 0,0:21:48.99,0:21:53.43,Main,,0,0,0,,Evet!\NBiz de onları izliyorduk.
Dialogue: 0,0:21:53.43,0:21:56.45,Main,,0,0,0,,Sizin de mi Doflamingo'yla\Nbir anlaşmazlığınız var?
Dialogue: 0,0:21:56.45,0:21:58.29,Main,,0,0,0,,Evet!\NAmanın!
Dialogue: 0,0:21:58.29,0:22:00.10,Main,,0,0,0,,Bunun bir sır olması gerekiyordu.
Dialogue: 0,0:22:00.10,0:22:05.28,Main,,0,0,0,,Lanet olsun! Tehlikede olan tek şey gemi de değil. Hepimiz tehlikedeyiz!
Dialogue: 0,0:22:05.28,0:22:07.40,Main,,0,0,0,,Çok var mı şu Çiçek Bahçesi'ne?
Dialogue: 0,0:22:07.84,0:22:10.14,Main,,0,0,0,,Merdivenlerden çık!
Dialogue: 0,0:22:10.84,0:22:12.84,Main,,0,0,0,,Merdivenlerden çık demiştim ama!
Dialogue: 0,0:22:14.81,0:22:17.46,Main,,0,0,0,,Tahtan falan mı eksik senin?
Dialogue: 0,0:22:17.46,0:22:18.43,Main,,0,0,0,,Kapa çeneni!
Dialogue: 0,0:22:20.35,0:22:23.45,Captions,,0,0,220,,{\fad(400,0)}Dressrosa\NCorrida Kolezyumu
Dialogue: 0,0:22:33.92,0:22:36.53,Main,,0,0,0,,Bekle Maymun-san!
Dialogue: 0,0:22:41.58,0:22:42.61,Main,,0,0,0,,Yakaladım!
Dialogue: 0,0:22:48.18,0:22:51.12,Main,,0,0,0,,Hangi Çiçek Bahçesi'nden\Nbahsediyorsun sen yahu?!
Dialogue: 0,0:22:51.12,0:22:53.85,Main,,0,0,0,,Kapa çeneni de koşmaya devam et.\NMeseleyi orada anlatacağım.
Dialogue: 0,0:22:55.54,0:22:57.10,Main,,0,0,0,,Polisler konusunda da dikkatli ol!
Dialogue: 0,0:22:57.10,0:22:58.54,Main,,0,0,0,,Asker değil misin sen?!
Dialogue: 0,0:22:59.62,0:23:00.62,Main,,0,0,0,,Asker-san!
Dialogue: 0,0:23:03.76,0:23:05.06,Main,,0,0,0,,Rebecca.
Dialogue: 0,0:23:07.20,0:23:09.60,Main,,0,0,0,,Katılımcı listesini görmüştüm.
Dialogue: 0,0:23:09.60,0:23:11.88,Main,,0,0,0,,Yarışmaya girmişsin.
Dialogue: 0,0:23:11.88,0:23:13.52,Main,,0,0,0,,Sana yapma demiştim!
Dialogue: 0,0:23:14.51,0:23:15.76,Main,,0,0,0,,Ben...
Dialogue: 0,0:23:16.41,0:23:19.18,Main,,0,0,0,,Yarışacak ve kazanacağım!
Dialogue: 0,0:23:19.18,0:23:20.68,Main,,0,0,0,,Asker-san!
Dialogue: 0,0:23:21.44,0:23:22.45,Main,,0,0,0,,Sonra da...
Dialogue: 0,0:23:22.45,0:23:27.65,Main,,0,0,0,,Sonra da birlikte yaşayalım!
Dialogue: 0,0:23:28.52,0:23:31.56,Main,,0,0,0,,Böyle kolay ağlayan bir savaşçı\Nyarışma falan kazanamaz!
Dialogue: 0,0:23:31.56,0:23:33.57,Main,,0,0,0,,Gidelim!
Dialogue: 0,0:23:33.57,0:23:35.43,Main,,0,0,0,,Emin misin?
Dialogue: 0,0:23:35.43,0:23:36.27,Main,,0,0,0,,Gidelim dedim.
Dialogue: 0,0:23:37.36,0:23:38.36,Main,,0,0,0,,Acele haydi!
Dialogue: 0,0:23:49.48,0:23:53.74,Main,,0,0,0,,Doğru şeyi yaptığımıza emin misin?\NKız ağlıyordu be!
Dialogue: 0,0:24:01.08,0:24:02.89,Main,,0,0,0,,O yüzden acele etmemiz lazım ya!
Dialogue: 0,0:24:11.60,0:24:15.67,Main,,0,0,0,,Oyuncak da olsam benim de\Nkorumak istediğim bir şey var!
Dialogue: 0,0:24:20.18,0:24:24.50,Main,,0,0,0,,Bu kurşun gözlerden\Ngözyaşı da akmıyor.
Dialogue: 0,0:24:33.78,0:24:38.64,Captions,,0,0,250,,{\fad(500,500)}Green Bit\NGüneydoğu Sahili
Dialogue: 0,0:24:41.26,0:24:44.36,Narrator,,0,0,0,,Ceasar'ın teslim saatine yalnızca...
Dialogue: 0,0:24:44.36,0:24:46.96,Narrator,,0,0,0,,...iki dakika var.
Dialogue: 0,0:24:51.34,0:24:53.40,Main,,0,0,0,,{\i1}Law, benim Sanji!{\i0}
Dialogue: 0,0:24:53.40,0:24:56.89,Main,,0,0,0,,Kara Bacak-ya,\Nfabrikayı bulabildiniz mi?
Dialogue: 0,0:24:56.89,0:24:58.49,Main,,0,0,0,,Onu boşver şimdi!
Dialogue: 0,0:24:58.49,0:24:59.89,Main,,0,0,0,,Beni dinle bak!
Dialogue: 0,0:24:59.89,0:25:01.81,Main,,0,0,0,,{\i1}Oradan derhal kaçmanız lazım!{\i0}
Dialogue: 0,0:25:02.56,0:25:04.07,Main,,0,0,0,,Ne diyorsun sen?
Dialogue: 0,0:25:04.07,0:25:06.34,Main,,0,0,0,,Az sonra Caesar'ı teslim etmem lazım!
Dialogue: 0,0:25:06.34,0:25:09.84,Main,,0,0,0,,Doflamingo\NShichibukai'lıktan falan ayrılmadı!
Dialogue: 0,0:25:12.66,0:25:17.28,Main,,0,0,0,,Caesar'ı ona teslim etsen bile\Nherhângi bir takas olmayacak!
Dialogue: 0,0:25:17.28,0:25:18.50,Main,,0,0,0,,Resmen...
Dialogue: 0,0:25:18.50,0:25:21.16,Main,,0,0,0,,...kandırıldık!
Dialogue: 0,0:25:21.96,0:25:23.88,Main,,0,0,0,,Hiç mantıklı değil.
Dialogue: 0,0:25:24.85,0:25:26.35,Main,,0,0,0,,Nasıl...
Dialogue: 0,0:25:27.18,0:25:30.04,Main,,0,0,0,,{\i1}Derhal kaçın o adadan!{\i0}
Dialogue: 0,0:25:36.22,0:25:39.59,Main,,0,0,0,,Doflamingo'yla ilgili haber\Nyalan mıymış?
Dialogue: 0,0:25:40.55,0:25:45.12,Main,,0,0,0,,Bu da ne demek böyle, Saka-san?
Dialogue: 0,0:25:45.12,0:25:48.96,Main,,0,0,0,,Donanma'nın da mı bu yalan haberle\Nkandırıldığını söylüyorsun bana?
Dialogue: 0,0:25:48.96,0:25:51.60,Main,,0,0,0,,{\i1}Evet, gerçekten de\Nsinir bozucu bir durum!{\i0}
Dialogue: 0,0:25:51.60,0:25:57.22,Main,,0,0,0,,{\i1}Şimdi Mariejois'deki Gorousei'yle\Nkonuşmaya gidiyorum.{\i0}
Dialogue: 0,0:25:57.22,0:25:59.30,Main,,0,0,0,,{\i1}Üzgünüm ama olan oldu artık.{\i0}
Dialogue: 0,0:25:59.86,0:26:06.28,Main,,0,0,0,,{\i1}Planını sekteye uğratmadan Trafalgar Law'la\NDoflamingo'nun yanına gitmeni istiyorum.{\i0}
Dialogue: 0,0:26:06.92,0:26:09.02,Main,,0,0,0,,Anlaşılmıştır.
Dialogue: 0,0:26:10.75,0:26:13.85,Main,,0,0,0,,Tüm birlikler,\Ngüneydoğu sahiline gidiyoruz!
Dialogue: 0,0:26:13.85,0:26:15.35,Main,,0,0,0,,{\i1}Acele edin!{\i0}
Dialogue: 0,0:26:15.35,0:26:17.86,Main,,0,0,0,,Aptal, artık çok geç.
