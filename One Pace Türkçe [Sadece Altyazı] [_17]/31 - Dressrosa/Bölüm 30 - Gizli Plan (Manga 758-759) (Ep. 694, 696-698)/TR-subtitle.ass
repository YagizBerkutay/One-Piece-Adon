Dialogue: 0,0:01:42.61,0:01:46.33,Title,,0,0,250,,{\fad(350,350)}Gizli Plan
Dialogue: 0,0:01:46.37,0:01:51.37,Captions,,935,0,238,,{\fad(300,300)}Sarayın Önü\N\N\N\N\N\N\N\N\N\N\N\N\N\N\N\N4. Seviye\NÇiçek Tarlası
Dialogue: 0,0:01:46.76,0:01:49.13,Main,,0,0,0,,Öyleyse burası sana emanet, Asker!
Dialogue: 0,0:01:49.13,0:01:50.10,Main,,0,0,0,,Pekâlâ!
Dialogue: 0,0:01:50.86,0:01:52.18,Main,,0,0,0,,Gidelim, Hasır Şapka-ya!
Dialogue: 0,0:01:56.55,0:01:57.86,Main,,0,0,0,,Sahi ya Rebecca!
Dialogue: 0,0:01:59.90,0:02:01.90,Main,,0,0,0,,Babanı gördüğüne sevinmişsindir!
Dialogue: 0,0:02:06.70,0:02:08.20,Main,,0,0,0,,Anahtar için teşekkür ederim!
Dialogue: 0,0:02:09.28,0:02:10.00,Main,,0,0,0,,Görüşürüz!
Dialogue: 0,0:02:11.44,0:02:12.86,Main,,0,0,0,,Hey, Lucy!
Dialogue: 0,0:02:13.95,0:02:16.52,Main,,0,0,0,,Gerçekten de Doflamingo'yu...
Dialogue: 0,0:02:18.22,0:02:21.49,Main,,0,0,0,,Doflamingo'yu yenecek misin?!
Dialogue: 0,0:02:27.00,0:02:28.46,Main,,0,0,0,,Lucy değilim ben.
Dialogue: 0,0:02:31.14,0:02:34.98,Main,,0,0,0,,Adım Luffy!\NKorsanlar Kralı olacak adam!
Dialogue: 0,0:02:38.68,0:02:40.22,Main,,0,0,0,,O yüzden endişelenme!
Dialogue: 0,0:02:48.48,0:02:50.55,Main,,0,0,0,,Korsanlar Kralı mı dedin?!
Dialogue: 0,0:02:50.55,0:02:53.65,Main,,0,0,0,,Senin kavgan benimle, Diamante!
Dialogue: 0,0:02:53.65,0:03:00.86,Main,,0,0,0,,Siz gerzeklerin\Nsaraya varmasına izin verecek değilim!
Dialogue: 0,0:03:02.94,0:03:07.27,Main,,0,0,0,,Seni koca aptal!\NSeni hain velet!
Dialogue: 0,0:03:08.82,0:03:09.80,Main,,0,0,0,,{\fad(150,150)}Oda!
Dialogue: 0,0:03:11.00,0:03:12.14,Main,,0,0,0,,{\fad(150,150)}Shambles!
Dialogue: 0,0:03:16.82,0:03:18.88,Main,,0,0,0,,Lanet olsun!
Dialogue: 0,0:03:22.45,0:03:28.15,Captions,,0,480,297,,{\fad(300,130)}Kraliyet Sarayı\N\N\N\N\N\N\N\N\N\N\N\N\N\N\N\NBahçe Havuzu
Dialogue: 0,0:03:24.82,0:03:26.59,Main,,0,0,0,,Saray burası mı şimdi?
Dialogue: 0,0:03:26.59,0:03:29.40,Main,,0,0,0,,Evet, geldik sonunda.
Dialogue: 0,0:03:29.40,0:03:31.16,Main,,0,0,0,,Çok faydalı gücün varmış ha!
Dialogue: 0,0:03:31.16,0:03:33.98,Main,,0,0,0,,Öyle ama enerjimi de tüketiyor.
Dialogue: 0,0:03:34.58,0:03:36.97,Main,,0,0,0,,Belki de kairousekiyle\Nkelepçelenmiş olmam...
Dialogue: 0,0:03:37.10,0:03:41.12,Main,,0,0,0,,...ve beni buraya taşıyarak getirmiş olman\Nbizim için daha iyi oldu.
Dialogue: 0,0:03:42.08,0:03:43.96,Main,,0,0,0,,Enerjimi korumuş oldum.
Dialogue: 0,0:03:46.16,0:03:46.94,Main,,0,0,0,,{\fad(150,150)}Neşter.
Dialogue: 0,0:03:51.46,0:03:52.44,Main,,0,0,0,,Ne oldu?!
Dialogue: 0,0:03:54.42,0:03:55.66,Main,,0,0,0,,Kendimi ameliyat ettim.
Dialogue: 0,0:04:00.32,0:04:04.36,Main,,0,0,0,,Şerefsiz kurşun mermi kullanmış!
Dialogue: 0,0:04:04.36,0:04:07.80,Main,,0,0,0,,Pekâlâ!\NMingo'nun canına okumaya gidelim!
Dialogue: 0,0:04:07.80,0:04:08.52,Main,,0,0,0,,Bekle!
Dialogue: 0,0:04:09.06,0:04:10.67,Main,,0,0,0,,Ne var ya!?
Dialogue: 0,0:04:10.67,0:04:13.86,Main,,0,0,0,,Doflamingo öyle gücüne kuvvet deyip\Nyenebileceğin biri değil.
Dialogue: 0,0:04:14.30,0:04:15.82,Main,,0,0,0,,Sakinleşmen lazım biraz.
Dialogue: 0,0:04:15.82,0:04:19.30,Main,,0,0,0,,Ne?! Buraya kadar gelmişiz,\Nnah sakinleşirim!
Dialogue: 0,0:04:19.30,0:04:22.90,Main,,0,0,0,,Sakinleşmezsen onu yenemezsin!
Dialogue: 0,0:04:22.90,0:04:25.50,Main,,0,0,0,,Rebecca'ya söz verdim be!
Dialogue: 0,0:04:25.50,0:04:28.60,Main,,0,0,0,,Burada beklemenin kime faydası var?!
Dialogue: 0,0:04:28.60,0:04:32.06,Main,,0,0,0,,Law'la Hasır Şapka,  havuz yakınlarında\Nbahçede göründüler.
Dialogue: 0,0:04:33.32,0:04:34.30,Main,,0,0,0,,Anlaşılmıştır.
Dialogue: 0,0:04:36.64,0:04:39.49,Main,,0,0,0,,On yıl... Tam on yıl.
Dialogue: 0,0:04:40.82,0:04:45.98,Main,,0,0,0,,Sayılarını birer birer arttırmak için\Ngünümü günüme kattım.
Dialogue: 0,0:04:48.16,0:04:50.44,Main,,0,0,0,,On binlerce oyuncaktan oluşan\Nköle ordum.
Dialogue: 0,0:04:52.68,0:04:55.44,Main,,0,0,0,,Hepsi o gerzek yüzünden...
Dialogue: 0,0:04:56.54,0:04:58.88,Main,,0,0,0,,...bir anda elimden kayıp gitti!
Dialogue: 0,0:05:03.64,0:05:05.65,Main,,0,0,0,,İntikam kolay olacak.
Dialogue: 0,0:05:06.62,0:05:08.58,Main,,0,0,0,,Bu elimle onlara dokunmam yeterli.
Dialogue: 0,0:05:09.64,0:05:11.42,Main,,0,0,0,,Hasır Şapka tayfası...
Dialogue: 0,0:05:12.36,0:05:14.26,Main,,0,0,0,,Sonunuz...
Dialogue: 0,0:05:15.08,0:05:16.04,Main,,0,0,0,,...benim elimden...
Dialogue: 0,0:05:16.66,0:05:19.60,Main,,0,0,0,,...olacak!
Dialogue: 0,0:05:21.72,0:05:24.14,Captions,,50,0,385,,{\fad(300,300)}Eski Kral Platosu
Dialogue: 0,0:05:24.14,0:05:25.83,Main,,0,0,0,,Ne berbat bir durum!
Dialogue: 0,0:05:25.83,0:05:29.17,Main,,0,0,0,,Usopp-dono, bu kadar ciddi bir şey mi bu?!
Dialogue: 0,0:05:29.74,0:05:35.95,Main,,0,0,0,,Robin'in bile oyuncağa dönüştürüldüğünü\Nhatırladığımda sırtımdan soğuk terler akmıştı.
Dialogue: 0,0:05:36.83,0:05:40.52,Main,,0,0,0,,Onu unuttuğumu bile fark edememiştim!
Dialogue: 0,0:05:40.85,0:05:45.48,Main,,0,0,0,,Sugar Luffy'e dokunacak olursa\Nşıp diye onu da unutacağız!
Dialogue: 0,0:05:45.98,0:05:49.66,Main,,0,0,0,,Dostun kaybolup gidecek ve sen\Nbunun farkında bile olamayacaksın!
Dialogue: 0,0:05:50.18,0:05:51.67,Main,,0,0,0,,İstemem böyle bir şey!
Dialogue: 0,0:05:52.20,0:05:54.63,Main,,0,0,0,,Bunun olmasına\Nasla müsaade etmeyeceğim!
Dialogue: 0,0:05:55.92,0:05:58.70,Main,,0,0,0,,Den Den Mushi'yle söyleyemez miyiz?
Dialogue: 0,0:05:59.46,0:06:02.07,Main,,0,0,0,,Deminden beri ulaşmaya çalışıyorum\Nama fark etmediler sanırım!
Dialogue: 0,0:06:02.07,0:06:04.72,Main,,0,0,0,,Başka seçeneğim kalmadı!
Dialogue: 0,0:06:05.08,0:06:07.32,Main,,0,0,0,,Onu buradan vuracağım!
Dialogue: 0,0:06:07.32,0:06:11.34,Main,,0,0,0,,Fakat Usopp-dono,\Nonu bu mesafeden vurmak...
Dialogue: 0,0:06:11.72,0:06:13.18,Main,,0,0,0,,...imkansızdır!
Dialogue: 0,0:06:14.29,0:06:18.99,Main,,0,0,0,,Sarayı bile zor görüyorum ben.
Dialogue: 0,0:06:19.34,0:06:22.59,Main,,0,0,0,,Ayrıca düşman duvarın arkasında,\Ngözlerden çok uzak!
Dialogue: 0,0:06:22.59,0:06:25.46,Main,,0,0,0,,Ne olursa olsun yapmam şart.
Dialogue: 0,0:06:26.24,0:06:28.23,Main,,0,0,0,,Biz de yardımcı oluruz!
Dialogue: 0,0:06:31.66,0:06:32.98,Main,,0,0,0,,Keskin nişancıyım ben!
Dialogue: 0,0:06:33.31,0:06:35.02,Main,,0,0,0,,İnsanları korumak benim işim!
Dialogue: 0,0:06:35.98,0:06:40.05,Main,,0,0,0,,Görünmeden düşmanımı vurur\Nve dostlarımı korurum!
Dialogue: 0,0:06:40.05,0:06:42.26,Main,,0,0,0,,Kaptan Tank, Hack!
Dialogue: 0,0:06:42.26,0:06:43.60,Main,,0,0,0,,Emredin, Kral Riku-sama!
Dialogue: 0,0:06:44.15,0:06:46.82,Main,,0,0,0,,Yardımcı olun! \NUsopp-kun'u koruyacağız!
Dialogue: 0,0:06:47.32,0:06:48.34,Main,,0,0,0,,Baba!
Dialogue: 0,0:06:49.88,0:06:52.56,Main,,0,0,0,,Tırmanan insanlar epey yaklaştılar.
Dialogue: 0,0:06:56.80,0:06:58.73,Main,,0,0,0,,Herkesin kafası karışmış durumda.
Dialogue: 0,0:06:59.53,0:07:01.27,Main,,0,0,0,,Benim bile peşime düşebilirler.
Dialogue: 0,0:07:01.49,0:07:04.27,Main,,0,0,0,,Ama birini bile incitmeyin!
Dialogue: 0,0:07:04.48,0:07:06.87,Main,,0,0,0,,Epey zor olacak.
Dialogue: 0,0:07:06.87,0:07:10.14,Main,,0,0,0,,Keskin nişancımıza zaman\Nkazandırabildiğimiz müddetçe âlâ.
Dialogue: 0,0:07:10.90,0:07:12.98,Main,,0,0,0,,İhtiyar kral, teşekkür ettim.
Dialogue: 0,0:07:12.98,0:07:13.98,Main,,0,0,0,,Usopp-kun.
Dialogue: 0,0:07:14.26,0:07:16.78,Main,,0,0,0,,Sugar gittikçe yaklaşıyor!
Dialogue: 0,0:07:18.02,0:07:19.96,Main,,0,0,0,,Onları görebileceği bir noktada!
Dialogue: 0,0:07:21.22,0:07:22.36,Main,,0,0,0,,Gözünü ondan ayırma!
Dialogue: 0,0:07:27.88,0:07:28.53,Main,,0,0,0,,Sonunda!
Dialogue: 0,0:07:28.53,0:07:29.49,Main,,0,0,0,,Oradalar!
Dialogue: 0,0:07:29.49,0:07:30.83,Main,,0,0,0,,Kral Riku!
Dialogue: 0,0:07:31.12,0:07:32.36,Main,,0,0,0,,Viola-sama!
Dialogue: 0,0:07:32.55,0:07:33.77,Main,,0,0,0,,Kin'emon!
Dialogue: 0,0:07:33.77,0:07:35.27,Main,,0,0,0,,Tanrı Usopp!
Dialogue: 0,0:07:36.87,0:07:41.27,Main,,0,0,0,,Hepsini yakalayıp\NDoflamingo'ya teslim edelim!
Dialogue: 0,0:07:41.27,0:07:43.01,Main,,0,0,0,,Biz de onları durdurmaya çalışalım!
Dialogue: 0,0:07:43.01,0:07:43.51,Main,,0,0,0,,Pekâlâ!
Dialogue: 0,0:07:51.26,0:07:52.02,Main,,0,0,0,,Bu da ne?!
Dialogue: 0,0:07:56.08,0:07:58.29,Main,,0,0,0,,Sugar bahçeye çıktı!
Dialogue: 0,0:07:58.53,0:07:59.50,Main,,0,0,0,,Sonunda ha!
Dialogue: 0,0:08:02.49,0:08:05.39,Main,,0,0,0,,Millet beni dinleyin!
Dialogue: 0,0:08:05.74,0:08:07.14,Main,,0,0,0,,Hiçbir yere kaçmayacağız, durun!
Dialogue: 0,0:08:07.14,0:08:07.87,Main,,0,0,0,,Baba!
Dialogue: 0,0:08:07.87,0:08:09.10,Main,,0,0,0,,Odaklan!
Dialogue: 0,0:08:09.46,0:08:10.64,Main,,0,0,0,,Özür dilerim!
Dialogue: 0,0:08:10.64,0:08:12.64,Main,,0,0,0,,Bahçenin tam olarak\Nnerede olduğunu söyle!
Dialogue: 0,0:08:16.24,0:08:17.91,Main,,0,0,0,,Millet, sakinleşin!
Dialogue: 0,0:08:18.66,0:08:21.68,Main,,0,0,0,,Siper Kulesi'nin üst kısmındaki\Npencereleri görüyor musun?
Dialogue: 0,0:08:24.64,0:08:25.38,Main,,0,0,0,,Evet.
Dialogue: 0,0:08:27.54,0:08:31.68,Main,,0,0,0,,Orta sağdaki pencereden\NHasır Şapkaları görebiliyorum.
Dialogue: 0,0:08:32.40,0:08:33.92,Main,,0,0,0,,Pencerede demir parmaklıklar var.
Dialogue: 0,0:08:35.52,0:08:37.83,Main,,0,0,0,,Kaç parmaklıktan bahsediyoruz?
Dialogue: 0,0:08:37.83,0:08:40.77,Main,,0,0,0,,Bir tane dikey,\Nüç tane de yatay.
Dialogue: 0,0:08:42.58,0:08:47.14,Main,,0,0,0,,Yerden pencerenin alt kısmına olan mesafe\N1.2 metre kadar.
Dialogue: 0,0:08:47.58,0:08:49.80,Main,,0,0,0,,Sugar'la aynı uzunlukta.
Dialogue: 0,0:08:52.02,0:08:54.61,Main,,0,0,0,,Pencerenin alt camları ne boyda?
Dialogue: 0,0:08:55.10,0:08:58.52,Main,,0,0,0,,Genişlik 50, yükseklik 40.
Dialogue: 0,0:09:01.30,0:09:04.26,Main,,0,0,0,,Sugar çok yakında\Nikisinin arasına girmiş olacak.
Dialogue: 0,0:09:04.26,0:09:06.22,Thoughts,,0,0,0,,{\i1}Hedef duvarın arkasında...{\i0}
Dialogue: 0,0:09:08.86,0:09:10.87,Thoughts,,0,0,0,,{\i1}Iskalarsam Luffy'i yitireceğiz!{\i0}
Dialogue: 0,0:09:19.60,0:09:21.06,Thoughts,,0,0,0,,{\i1}Bana bak Luffy!{\i0}
Dialogue: 0,0:09:21.57,0:09:25.52,Thoughts,,0,0,0,,{\i1}Sensiz denizler...\NGörmek bile istemeyeceğim bir şey bu!{\i0}
Dialogue: 0,0:09:26.30,0:09:28.12,Thoughts,,0,0,0,,{\i1}Bu ülkeyi kim kurtaracak?!{\i0}
Dialogue: 0,0:09:29.90,0:09:31.20,Thoughts,,0,0,0,,{\i1}Gör bak, Sugar!
Dialogue: 0,0:09:32.48,0:09:34.45,Thoughts,,0,0,0,,{\i1}İstediğini yapmana...
Dialogue: 0,0:09:34.94,0:09:36.46,Thoughts,,0,0,0,,{\i1}...müsaade etmeyeceğim!
Dialogue: 0,0:09:43.66,0:09:46.13,Thoughts,,0,0,0,,{\i1}Bu da ne?!{\i0}
Dialogue: 0,0:09:57.42,0:10:01.98,Thoughts,,0,0,0,,{\i1}Yerlerini görebiliyorum!{\i0}
Dialogue: 0,0:10:02.64,0:10:03.75,Thoughts,,0,0,0,,Luffy orada!
Dialogue: 0,0:10:06.10,0:10:07.51,Main,,0,0,0,,Geliyor!
Dialogue: 0,0:10:07.51,0:10:11.29,Main,,0,0,0,,{\fad(150,150)}Süper Büyümüş Kudretli Siyah Kabuto!
Dialogue: 0,0:10:12.08,0:10:15.99,Main,,0,0,0,,{\fad(150,150)}Özel Saldırı\NUzun Mesafe Bagworm!
Dialogue: 0,0:10:29.76,0:10:31.88,Thoughts,,0,0,0,,{\i1}Rüzgar batıdan doğuya esiyor...{\i0}
Dialogue: 0,0:10:35.12,0:10:36.82,Thoughts,,0,0,0,,{\i1}Rüzgar gücü 4.{\i0}
Dialogue: 0,0:10:37.08,0:10:38.62,Thoughts,,0,0,0,,{\i1}Hafiften pupa rüzgarı mevcut.{\i0}
Dialogue: 0,0:10:40.14,0:10:41.12,Secondary,,0,0,0,,Yakaladık!
Dialogue: 0,0:10:41.62,0:10:42.52,Thoughts,,0,0,0,,{\i1}İki...{\i0}
Dialogue: 0,0:10:42.69,0:10:43.34,Thoughts,,0,0,0,,{\i1}Bir...{\i0}
Dialogue: 0,0:10:45.42,0:10:47.87,Thoughts,,0,0,0,,{\i1}{\fad(150,150)}İlk güçlendirici, Patlayan Yıldız!
Dialogue: 0,0:10:47.87,0:10:50.80,Thoughts,,0,0,0,,{\i1}Hafif bir yükselmenin ardından\Narka bölümü bırakacak.{\i0}
Dialogue: 0,0:10:51.76,0:10:54.80,Thoughts,,0,0,0,,{\i1}İki saniye sonra da\Nikinci güçlendirici devreye girecek.{\i0}
Dialogue: 0,0:10:57.30,0:10:59.94,Thoughts,,0,0,0,,{\i1}Üst zırh salınır ve\Nmermi yatay gitmeye başlar.{\i0}
Dialogue: 0,0:11:00.38,0:11:03.94,Thoughts,,0,0,0,,{\i1}Siper Kulesi'deki pencerenin\Nsol panelinden girecek!{\i0}
Dialogue: 0,0:11:05.78,0:11:08.76,Thoughts,,0,0,0,,{\i1}Duvarı geçip doğrudan...{\i0}
Dialogue: 0,0:11:09.48,0:11:11.85,Thoughts,,0,0,0,,{\i1}Doğrudan hedefiyle buluşacak!{\i0}
Dialogue: 0,0:11:14.29,0:11:14.91,Main,,0,0,0,,Ne?
Dialogue: 0,0:11:15.30,0:11:18.66,Thoughts,,0,0,0,,{\i1}Biraz hız kaybetse de\Nözel mermi...{\i0}
Dialogue: 0,0:11:24.14,0:11:26.44,Thoughts,,0,0,0,,{\i1}...düşmanı yeniden\Nşoka sokmak için var!{\i0}
Dialogue: 0,0:11:31.84,0:11:34.71,Thoughts,,0,0,0,,{\i1}Luffy, bunu bilmesen de olur.{\i0}
Dialogue: 0,0:11:35.28,0:11:36.80,Thoughts,,0,0,0,,{\i1}İyi olduğun müddetçe...{\i0}
Dialogue: 0,0:11:38.78,0:11:40.28,Thoughts,,0,0,0,,{\i1}...her şeyi boşverip\Nilerlemene bak yeter!{\i0}
Dialogue: 0,0:11:45.12,0:11:49.97,Flashbacks,,0,0,0,,Fakat Usopp-dono,\Nbunu ne yapmayı planlıyorsun ki?
Dialogue: 0,0:11:49.97,0:11:52.67,Flashbacks,,0,0,0,,Bunu oyuncak falan gibi\Ngerçek bir şeye çevirebiliyor musun?
Dialogue: 0,0:11:52.67,0:11:53.63,Flashbacks,,0,0,0,,Oyuncak gibi mi?
Dialogue: 0,0:11:54.76,0:11:57.88,Flashbacks,,0,0,0,,Yap bakalım!\NMermi olarak bunu kullanacağım!
Dialogue: 0,0:12:01.92,0:12:03.50,Main,,0,0,0,,Sugar-sama!
Dialogue: 0,0:12:03.50,0:12:05.53,Main,,0,0,0,,Eyvahlar olmasın!\NGene bayıldı!
Dialogue: 0,0:12:09.67,0:12:15.02,Main,,0,0,0,,Harikasın Usopp-kun...\NNe harika birisin sen böyle!?
Dialogue: 0,0:12:16.74,0:12:17.86,Main,,0,0,0,,Viola-sama?
Dialogue: 0,0:12:19.35,0:12:21.95,Main,,0,0,0,,Başardın!\NSugar'ı yendin!
Dialogue: 0,0:12:22.11,0:12:24.56,Main,,0,0,0,,Gerçekten vurdu ha?! \Nİnanamıyorum!
Dialogue: 0,0:12:24.56,0:12:26.38,Main,,0,0,0,,Şoka uğradım resmen!
Dialogue: 0,0:12:26.38,0:12:28.16,Main,,0,0,0,,Gerçekten başardı ha?!
Dialogue: 0,0:12:30.78,0:12:31.90,Main,,0,0,0,,Ne güzel...
Dialogue: 0,0:12:33.63,0:12:34.65,Main,,0,0,0,,Onlar nasıl peki?
Dialogue: 0,0:12:36.02,0:12:38.20,Main,,0,0,0,,İkisi de iyi.
Dialogue: 0,0:12:44.12,0:12:46.24,Main,,0,0,0,,Vardılar!
Dialogue: 0,0:12:48.72,0:12:52.12,Main,,0,0,0,,Son savaşın yapılacağı yere,\Nsarayın zirvesine ulaştılar!
Dialogue: 0,0:12:52.74,0:12:53.79,Main,,0,0,0,,Öyle ha...
Dialogue: 0,0:12:55.30,0:12:57.62,Main,,0,0,0,,Başardın, Luffy!
Dialogue: 0,0:12:58.58,0:13:02.09,Main,,0,0,0,,Yanılıyorsam falan diye...
Dialogue: 0,0:13:03.56,0:13:05.60,Main,,0,0,0,,...emin olmak için sorayım ben.
Dialogue: 0,0:13:06.96,0:13:08.11,Main,,0,0,0,,Buraya...
Dialogue: 0,0:13:09.09,0:13:11.40,Main,,0,0,0,,...neden geldiniz?
Dialogue: 0,0:13:12.08,0:13:14.27,Main,,0,0,0,,Canına okumaya geldim!
Dialogue: 0,0:13:14.76,0:13:16.01,Main,,0,0,0,,Aynen öyle!
Dialogue: 0,0:13:19.48,0:13:21.72,Main,,0,0,0,,Hayal kırıklığına uğradım.
Dialogue: 0,0:13:22.11,0:13:24.88,Captions,,910,0,215,,{\fad(0,300)}3. Seviye\N\N\N\N\N\N\N\N\N\N\N\N\N\N\N\N\N\N\NYeni Kralın Platosu
Dialogue: 0,0:13:24.88,0:13:25.83,Main,,0,0,0,,Ne oluyor?!
Dialogue: 0,0:13:27.82,0:13:29.59,Main,,0,0,0,,Neden düşüyorlar?!
Dialogue: 0,0:13:29.59,0:13:30.49,Main,,0,0,0,,Oyuncaklar...
Dialogue: 0,0:13:35.92,0:13:37.96,Main,,0,0,0,,Devasa oyuncaklar diye düşünmüştüm ama...
Dialogue: 0,0:13:38.56,0:13:41.14,Main,,0,0,0,,...sekizer kişiden oluşan kuklalarmış.
Dialogue: 0,0:13:41.74,0:13:44.77,Main,,0,0,0,,Kendi adamlarını\Noyuncağa mı çevirmiş bunlar?!
Dialogue: 0,0:13:45.12,0:13:47.48,Main,,0,0,0,,Kendi dostlarına\Nne yaptıklarını sanıyorlar?!
Dialogue: 0,0:13:47.97,0:13:48.86,Main,,0,0,0,,Nasıl olur...
Dialogue: 0,0:13:49.64,0:13:51.12,Main,,0,0,0,,Sugar gene mi bayıldı?!
Dialogue: 0,0:13:51.56,0:13:52.88,Main,,0,0,0,,Sugar-sama!
Dialogue: 0,0:13:53.37,0:13:55.65,Main,,0,0,0,,Sugar-sama, kendinize gelin!
Dialogue: 0,0:13:55.65,0:13:57.45,Main,,0,0,0,,Sugar-sama!
Dialogue: 0,0:13:59.05,0:14:00.39,Main,,0,0,0,,Çok korktum!
Dialogue: 0,0:14:00.64,0:14:03.88,Main,,0,0,0,,Hayatımın sonuna dek\Noyuncak olarak kalacağım sandım!
Dialogue: 0,0:14:05.82,0:14:07.50,Main,,0,0,0,,Elbette öyle kalmayacaktınız.
Dialogue: 0,0:14:08.23,0:14:12.73,Main,,0,0,0,,Savaş bittiğinde\Npekâlâ sizi normale çevirecektik.
Dialogue: 0,0:14:12.73,0:14:14.57,Main,,0,0,0,,Çevirecektiniz değil mi?!
Dialogue: 0,0:14:14.92,0:14:16.12,Main,,0,0,0,,Şükürler olsun!
Dialogue: 0,0:14:16.12,0:14:17.32,Main,,0,0,0,,Çok rahatladım.
Dialogue: 0,0:14:19.50,0:14:24.08,Thoughts,,0,0,0,,{\i1}Tabii varlıklarından dahi\Nhaberdar değildik ya, neyse.{\i0}
Dialogue: 0,0:14:24.72,0:14:26.11,Main,,0,0,0,,Pekâlâ!
Dialogue: 0,0:14:26.36,0:14:29.35,Main,,0,0,0,,Bariyerim tastamam yenilendi!
Dialogue: 0,0:14:30.05,0:14:34.85,Main,,0,0,0,,Beni geçmenize müsaade etmeyeceğim!
Dialogue: 0,0:14:38.41,0:14:46.58,Captions,,0,0,0,,{\fad(750,0)}Kraliyet Sarayının En Üst Katı
Dialogue: 0,0:14:50.82,0:14:51.50,Main,,0,0,0,,Bellamy!
Dialogue: 0,0:14:51.50,0:14:53.17,Main,,0,0,0,,Endişelendin demek?
Dialogue: 0,0:14:53.17,0:14:58.14,Main,,0,0,0,,Mock Town'da dövüştünüz sanıyordum.
Dialogue: 0,0:15:03.23,0:15:06.18,Main,,0,0,0,,Ne ara dost oldunuz?
Dialogue: 0,0:15:09.62,0:15:12.22,Flashbacks,,0,0,0,,Ne hayalperest bir ahmaksın!
Dialogue: 0,0:15:12.82,0:15:19.16,Flashbacks,,0,0,0,,Dinle!\NKorsanların hayal kurma çağı sona erdi!
Dialogue: 0,0:15:20.62,0:15:22.48,Main,,0,0,0,,Geçmişte yaşananların bir önemi yok.
Dialogue: 0,0:15:23.17,0:15:24.83,Main,,0,0,0,,Bellamy'i serbest bırak!
Dialogue: 0,0:15:27.84,0:15:29.04,Main,,0,0,0,,O dediğine...
Dialogue: 0,0:15:29.92,0:15:33.08,Main,,0,0,0,,...kazanan karar verecek!
Dialogue: 0,0:15:35.81,0:15:40.19,Main,,0,0,0,,Kendini bana öldürtmeye geldi.
Dialogue: 0,0:15:40.62,0:15:47.16,Flashbacks,,0,0,0,,Er yada geç gelecek o koca dalgada yutulmamak için\NDoflamingo'nun gemisine bineceğim.
Dialogue: 0,0:15:48.02,0:15:50.76,Flashbacks,,0,0,0,,{\i1}Artık seninle uğraşmayacağım.{\i0}
Dialogue: 0,0:15:51.56,0:15:56.50,Flashbacks,,0,0,0,,Doflamingo küçüklüğümden beri\Nhayallerimdeki korsan figürü olmuştur.
Dialogue: 0,0:15:56.50,0:15:58.62,Flashbacks,,0,0,0,,Ona büyük saygı duyuyorum!
Dialogue: 0,0:16:03.24,0:16:08.11,Main,,0,0,0,,Sorumluluğu bu şekilde üstleniyorsun,\Ndeğil mi?
Dialogue: 0,0:16:08.11,0:16:09.08,Main,,0,0,0,,Bellamy.
Dialogue: 0,0:16:10.82,0:16:13.16,Main,,0,0,0,,Beni kendince kahramanlaştırıp...
Dialogue: 0,0:16:13.66,0:16:18.19,Main,,0,0,0,,...işler istediğin gibi gitmedim mi de\Numutsuzluğa kapıldın.
Dialogue: 0,0:16:18.47,0:16:21.92,Main,,0,0,0,,İnsanlar doğalarına karşı gelemezler.
Dialogue: 0,0:16:22.07,0:16:26.70,Main,,0,0,0,,Hayatta ne kadar ilerlersen ilerle\Nucuz bir serseriden başkası olamayacaksın...
Dialogue: 0,0:16:26.86,0:16:28.52,Main,,0,0,0,,Bellamy!
Dialogue: 0,0:16:33.27,0:16:36.74,Main,,0,0,0,,Ne diyorsun sen be!?\NBellamy pekâlâ değişti!
Dialogue: 0,0:16:37.35,0:16:38.80,Main,,0,0,0,,Yeter...
Dialogue: 0,0:16:38.97,0:16:40.14,Main,,0,0,0,,Öldür de...
Dialogue: 0,0:16:40.21,0:16:43.84,Main,,0,0,0,,...bitsin artık.
Dialogue: 0,0:16:46.47,0:16:48.07,Main,,0,0,0,,Hasır Şapka-ya!
Dialogue: 0,0:16:48.54,0:16:50.31,Main,,0,0,0,,Bellamy'i bırak!
Dialogue: 0,0:16:50.31,0:16:52.37,Main,,0,0,0,,Mingo!
Dialogue: 0,0:16:56.65,0:16:58.44,Main,,0,0,0,,Özür dilerim, Bellamy!
Dialogue: 0,0:16:58.62,0:17:00.82,Main,,0,0,0,,Ne anlaştık biz?!
Dialogue: 0,0:17:00.84,0:17:01.86,Main,,0,0,0,,Hasır Şapka-ya,...
Dialogue: 0,0:17:02.23,0:17:05.82,Main,,0,0,0,,...öfkeni yahut nefretini dışarı vuracak olursan \Ndüşmana istediğini vermiş olursun!
Dialogue: 0,0:17:06.07,0:17:07.13,Main,,0,0,0,,Sakinleş!
Dialogue: 0,0:17:07.67,0:17:11.16,Main,,0,0,0,,Duygularla oynamak en iyi yaptığı şeydir.
Dialogue: 0,0:17:11.20,0:17:15.21,Main,,0,0,0,,Sakinliğini koruyamazsan ölebilirsin bile.
Dialogue: 0,0:17:15.21,0:17:18.84,Main,,0,0,0,,Onunla ilk karşılaşmamda\Naynı bana olduğu gibi.
Dialogue: 0,0:17:18.85,0:17:22.22,Main,,0,0,0,,Doflamingo taş kalpli,\Nacımasız biridir.
Dialogue: 0,0:17:22.84,0:17:25.36,Main,,0,0,0,,Her daim seni haklayabileceği o anı kollar.
Dialogue: 0,0:17:30.34,0:17:33.10,Main,,0,0,0,,Ölmek üzere olan arkadaşını...
Dialogue: 0,0:17:35.92,0:17:40.01,Main,,0,0,0,,Tekmeledin!\NÖyle değil mi? Ha?
Dialogue: 0,0:17:40.42,0:17:43.02,Main,,0,0,0,,Tekmeledin resmen!
Dialogue: 0,0:17:43.02,0:17:44.82,Main,,0,0,0,,Öküz!
Dialogue: 0,0:17:47.44,0:17:48.60,Main,,0,0,0,,Ne dedin?!
Dialogue: 0,0:17:49.36,0:17:50.38,Main,,0,0,0,,Ona kulak asma!
Dialogue: 0,0:17:53.20,0:17:57.47,Main,,0,0,0,,Benim için ne hakla\Ntaş kalpli biri dersin?
Dialogue: 0,0:17:57.47,0:18:01.58,Main,,0,0,0,,Law, düşündüğün kadar\Ntaş kalpli değilim.
Dialogue: 0,0:18:01.58,0:18:04.33,Main,,0,0,0,,Şu anda mesela\Nyaptıklarınızı düşünüp...
Dialogue: 0,0:18:04.94,0:18:08.64,Main,,0,0,0,,...acayip sinirleniyorum!
Dialogue: 0,0:18:11.64,0:18:16.21,Main,,0,0,0,,Punk Hazard'daki SAD üretim makinasını\Nyok etmekle başladınız işe.
Dialogue: 0,0:18:16.64,0:18:20.13,Main,,0,0,0,,Sonra Vergo ve Monet'i ortadan kaldırıp...
Dialogue: 0,0:18:20.30,0:18:22.33,Main,,0,0,0,,...Caesar'ı kaçırdınız.
Dialogue: 0,0:18:22.82,0:18:28.06,Main,,0,0,0,,Ondan sonra da Dressrosa'da, tüm ülkedeki\Noyuncakları serbest bıraktınız.
Dialogue: 0,0:18:30.13,0:18:34.82,Main,,0,0,0,,Dostlarınızsa şimdi bile\NGÜLÜCÜK fabrikasını yok etmeye çalışıyor!
Dialogue: 0,0:18:34.99,0:18:37.16,Main,,0,0,0,,Burama kadar geldi artık!
Dialogue: 0,0:18:37.90,0:18:43.60,Main,,0,0,0,,Güldüğüme bakmayın,\Nhep sinirden bunlar.
Dialogue: 0,0:18:43.64,0:18:47.23,Main,,0,0,0,,Üstüne üstlük\Nkellemi alacağını söylüyorsun bana.
Dialogue: 0,0:18:47.61,0:18:50.46,Main,,0,0,0,,Siz ortaya çıktığınızdan beri\Nher şey tepetaklak gitmeye başladı.
Dialogue: 0,0:18:51.25,0:18:57.10,Main,,0,0,0,,13 yıl önceki çaresizliği\Ntekrar tekrar yaşıyormuşum gibi geliyor!
Dialogue: 0,0:18:59.49,0:19:06.16,Main,,0,0,0,,O olay yaşanmamış olsaydı\Nşimdi böyle karşında dikilmezdim!
Dialogue: 0,0:19:06.16,0:19:14.29,Main,,0,0,0,,O olay yaşanmamış olsaydı \Nüçüncü Corazon olarak burada oturuyor olacaktın!
Dialogue: 0,0:19:26.13,0:19:28.29,Main,,0,0,0,,{\fad(150,150)}Kara Şövalye!
Dialogue: 0,0:19:30.73,0:19:31.98,Main,,0,0,0,,Gene mi klon?!
Dialogue: 0,0:19:38.67,0:19:40.39,Main,,0,0,0,,Öyleyse ben de...
Dialogue: 0,0:19:40.73,0:19:42.98,Main,,0,0,0,,...gerçek olanla savaşırım!
Dialogue: 0,0:19:47.91,0:19:48.67,Main,,0,0,0,,Bellamy!
Dialogue: 0,0:19:51.03,0:19:53.18,Main,,0,0,0,,Ne yapıyorsun Bellamy?!
Dialogue: 0,0:19:53.53,0:19:55.45,Main,,0,0,0,,Özür dilemedik mi?
Dialogue: 0,0:19:57.27,0:19:58.35,Main,,0,0,0,,Hasır Şapka-ya!
Dialogue: 0,0:19:58.35,0:20:00.11,Main,,0,0,0,,Kukla gibi kullanılıyor!
Dialogue: 0,0:20:08.41,0:20:10.41,Main,,0,0,0,,Özür dilerim, Hasır Şapka...
Dialogue: 0,0:20:11.57,0:20:12.97,Main,,0,0,0,,Yalvarıyorum...
Dialogue: 0,0:20:13.77,0:20:16.13,Main,,0,0,0,,...durdur beni!
Dialogue: 0,0:20:19.29,0:20:21.58,Main,,0,0,0,,Onu nereden tanıyorsun\Nbilmem ama...
Dialogue: 0,0:20:22.07,0:20:25.17,Main,,0,0,0,,...durdurmak istiyorsan\Nvurarak bayıltmaya bak!
Dialogue: 0,0:20:25.17,0:20:28.57,Main,,0,0,0,,Dediğini yap, Hasır Şapka!
Dialogue: 0,0:20:30.03,0:20:31.39,Main,,0,0,0,,Yapamam!
Dialogue: 0,0:20:35.31,0:20:36.94,Main,,0,0,0,,Dostumsun sen benim!
Dialogue: 0,0:20:51.05,0:20:53.83,Main,,0,0,0,,Öleceksin...
Dialogue: 0,0:20:57.25,0:20:59.49,Main,,0,0,0,,Ölmek için\Nhiç de fena bir yol değil ha?
Dialogue: 0,0:21:00.15,0:21:03.36,Main,,0,0,0,,Sana ne demiştim hatırlıyor musun, Law?
Dialogue: 0,0:21:04.27,0:21:08.68,Main,,0,0,0,,Güçsüz kişiler\Nnasıl öleceklerini seçemezler!
Dialogue: 0,0:21:14.61,0:21:16.79,Main,,0,0,0,,Lanet olası!
Dialogue: 0,0:21:16.79,0:21:20.68,Main,,0,0,0,,Karşına gelip dikildik,\Nhâlâ kendin savaşmayacak mısın?!
Dialogue: 0,0:21:21.21,0:21:22.27,Main,,0,0,0,,Trao!
Dialogue: 0,0:21:22.27,0:21:23.95,Main,,0,0,0,,Artık yetti, canına okuyacağım!
Dialogue: 0,0:21:24.71,0:21:27.02,Main,,0,0,0,,Acayip sinirimi bozuyor!
Dialogue: 0,0:21:29.25,0:21:32.19,Main,,0,0,0,,Aptal! Savaş hilemiz demiştim sana!
Dialogue: 0,0:21:32.55,0:21:34.38,Main,,0,0,0,,Sakin ol demiştim!
Dialogue: 0,0:21:34.47,0:21:35.99,Main,,0,0,0,,Şimdi yapacağım!
Dialogue: 0,0:21:35.99,0:21:37.99,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:21:38.39,0:21:41.20,Main,,0,0,0,,Seninle sonra görüşeceğiz!
Dialogue: 0,0:21:43.85,0:21:46.27,Main,,0,0,0,,Law'a saldırıyor!
Dialogue: 0,0:21:46.27,0:21:48.87,Main,,0,0,0,,Kafayı mı sıyırdın, Hasır Şapka?!
Dialogue: 0,0:21:48.87,0:21:50.34,Main,,0,0,0,,Çok eğlenceli lan!
Dialogue: 0,0:21:52.31,0:21:53.70,Main,,0,0,0,,{\fad(150,150)}Oda!
Dialogue: 0,0:21:58.83,0:21:59.94,Main,,0,0,0,,{\fad(150,150)}Shambles!
Dialogue: 0,0:22:02.02,0:22:05.59,Main,,0,0,0,,{\fad(150,150)}Kızıl Şahin!
Dialogue: 0,0:22:11.73,0:22:13.66,Main,,0,0,0,,Doffy!
Dialogue: 0,0:22:20.87,0:22:22.56,Main,,0,0,0,,{\fad(150,150)}Işın Kılıcı.
Dialogue: 0,0:22:27.19,0:22:30.52,Main,,0,0,0,,Hasır Şapka-ya, iğrençsin!
Dialogue: 0,0:22:30.95,0:22:32.07,Main,,0,0,0,,Sen de...
Dialogue: 0,0:22:34.05,0:22:35.71,Main,,0,0,0,,...o nesildensin!
Dialogue: 0,0:22:39.24,0:22:41.40,OP11 Credits,,0,0,0,,Editing: Galaxy 9000\N\NTiming: Datenshi\N\NQC: Mr. Luffy, Sewil\N\NSoundtracking: Halee\N\NTC/Infoboxes: Datenshi
