Dialogue: 0,0:01:44.35,0:01:47.35,Title,,0,0,460,,Savaş Durumu
Dialogue: 0,0:01:47.65,0:01:51.94,Main,,0,0,0,,Kafası yok olunca\NPica-sama hareket etmeyi kesti!
Dialogue: 0,0:01:52.72,0:01:54.59,Main,,0,0,0,,Nasıl oldu peki?!
Dialogue: 0,0:01:55.58,0:01:57.18,Main,,0,0,0,,Fırsat bu fırsat demektir!
Dialogue: 0,0:01:57.18,0:01:59.50,Main,,0,0,0,,Doflamingo'yu ben alaşağı edeceğim!
Dialogue: 0,0:01:59.50,0:02:00.42,Main,,0,0,0,,Ben!
Dialogue: 0,0:02:00.42,0:02:01.90,Main,,0,0,0,,Hayır ben!
Dialogue: 0,0:02:04.96,0:02:07.18,Main,,0,0,0,,Gene geliyorlar!
Dialogue: 0,0:02:07.18,0:02:09.94,Main,,0,0,0,,Durdurun onları!\NSaraya girmelerine müsaade etmeyin!
Dialogue: 0,0:02:23.12,0:02:28.34,Main,,0,0,0,,İmkansız. Kolezyum savaşçılarını\Ndurdurmaya gücümüz yetmez.{\i0}
Dialogue: 0,0:02:28.63,0:02:31.77,Main,,0,0,0,,Ay ne güçlüler!
Dialogue: 0,0:02:31.77,0:02:34.74,Main,,0,0,0,,Böyle bir durumda\NGenç Bey'e karşı olmaları inanılmaz!
Dialogue: 0,0:02:34.74,0:02:36.80,Main,,0,0,0,,Kafasızlık-in!
Dialogue: 0,0:02:36.80,0:02:42.32,Main,,0,0,0,,Kesinlikle! Fujitora liderliğindeki donanma asker grupları sarayın önünde toplanıyorlar!
Dialogue: 0,0:02:42.32,0:02:45.31,Main,,0,0,0,,Grubun G'si!
Dialogue: 0,0:02:46.14,0:02:49.76,Main,,0,0,0,,Pica-sama'yı durduranların\NHasır Şapkalar olduğunu biliyordum.
Dialogue: 0,0:02:50.40,0:02:54.28,Main,,0,0,0,,Şu anda saraya\Ndört koldan yaklaşmaktalar.
Dialogue: 0,0:03:07.42,0:03:09.62,Main,,0,0,0,,Sonunda geldim!
Dialogue: 0,0:03:09.62,0:03:13.44,Main,,0,0,0,,Sapık!
Dialogue: 0,0:03:14.00,0:03:15.44,Main,,0,0,0,,GÜLÜCÜK fabrikası!
Dialogue: 0,0:03:19.21,0:03:23.32,Main,,0,0,0,,Uç git, fabrika kapısı!
Dialogue: 0,0:03:24.04,0:03:27.80,Main,,0,0,0,,{\fad(150,150)}Radikal Işı...
Dialogue: 0,0:03:27.80,0:03:32.36,Main,,0,0,0,,O rezil saldırının fabrikaya hiçbir şey\Nyapmayacağının farkındayım ama...
Dialogue: 0,0:03:33.20,0:03:36.03,Main,,0,0,0,,...seninle aramızdaki mevzuya\Nbir son vermeye geldim.
Dialogue: 0,0:03:42.97,0:03:44.64,Main,,0,0,0,,Bir bitmediniz arkadaş!
Dialogue: 0,0:03:45.44,0:03:48.60,Main,,0,0,0,,Erkekler böyledir, evlat.
Dialogue: 0,0:03:49.84,0:03:51.58,Main,,0,0,0,,{\i1}Ay Senyor!{\i}
Dialogue: 0,0:03:52.56,0:03:57.00,Main,,0,0,0,,Yalvarıyoruz Kyros!\NÇık dışarı ve teslim ol!
Dialogue: 0,0:03:57.00,0:03:59.70,Main,,0,0,0,,Sen çıkmayacaksın\Nbiz geleceğiz oraya!
Dialogue: 0,0:04:00.04,0:04:01.07,Main,,0,0,0,,Bunu para için yapmıyoruz!
Dialogue: 0,0:04:01.10,0:04:04.21,Main,,0,0,0,,Hiçbir şey yapılmazsa kimse kalmayana\Ndek birbirimizi öldürmeye devam edeceğiz!
Dialogue: 0,0:04:04.21,0:04:05.69,Main,,0,0,0,,Başka seçeneğimiz yok anlayacağın!
Dialogue: 0,0:04:05.82,0:04:08.79,Main,,0,0,0,,Bu kabusa olabildiğince\Nçabuk son vermek istiyoruz!
Dialogue: 0,0:04:15.56,0:04:18.67,Main,,0,0,0,,Bu savaşa\Nbir son vermek istiyorsunuz!
Dialogue: 0,0:04:18.98,0:04:21.26,Main,,0,0,0,,Bu kararınız için sizi suçlamıyorum.
Dialogue: 0,0:04:21.28,0:04:24.74,Main,,0,0,0,,Hatta daha da hızlanmam\Ngerektiğinin farkına vardım!
Dialogue: 0,0:04:26.98,0:04:29.06,Main,,0,0,0,,- Ateş edin!\N- Kaçmasına izin vermeyin!
Dialogue: 0,0:04:30.32,0:04:34.68,Main,,0,0,0,,Benim de yapmam gereken bir şey var!
Dialogue: 0,0:04:43.06,0:04:46.56,Main,,0,0,0,,Olamaz!\NLuffy-senpai burada değil!
Dialogue: 0,0:04:46.56,0:04:47.58,Main,,0,0,0,,Çok doğal.
Dialogue: 0,0:04:47.58,0:04:49.33,Main,,0,0,0,,Nasıl yani çok doğal?!
Dialogue: 0,0:04:49.33,0:04:53.12,Main,,0,0,0,,Luffy'i aynı yerde\Nbeş dakika bile tutamazsın.
Dialogue: 0,0:04:54.10,0:04:55.68,Main,,0,0,0,,Özgürlük işte!
Dialogue: 0,0:04:56.56,0:04:59.38,Main,,0,0,0,,Korsanlar Kralı dediğin böyle olur!
Dialogue: 0,0:05:00.20,0:05:02.68,Main,,0,0,0,,Robin-san, hâlâ peşimizdeler!
Dialogue: 0,0:05:02.68,0:05:05.62,Main,,0,0,0,,Zirveye varınca bizim olacaklar!
Dialogue: 0,0:05:05.62,0:05:08.55,Main,,0,0,0,,Ağla işimiz bitti.\NAyak altından kaldırmak lazım.
Dialogue: 0,0:05:13.59,0:05:14.56,Main,,0,0,0,,Evet!
Dialogue: 0,0:05:14.56,0:05:15.54,Main,,0,0,0,,Kusura bakmayın.
Dialogue: 0,0:05:15.54,0:05:17.23,Main,,0,0,0,,Ablam!
Dialogue: 0,0:05:28.26,0:05:31.56,Main,,0,0,0,,Şu taş canavar da neyin nesi,\NKral Riku-sama?
Dialogue: 0,0:05:39.82,0:05:42.26,Main,,0,0,0,,Ayrıca Kraliyet Sarayı neden orada?!
Dialogue: 0,0:05:44.54,0:05:45.90,Main,,0,0,0,,Buldum!
Dialogue: 0,0:05:46.58,0:05:48.25,Main,,0,0,0,,Viola-san!
Dialogue: 0,0:05:57.44,0:05:58.86,Main,,0,0,0,,Viola.
Dialogue: 0,0:05:58.86,0:06:00.92,Main,,0,0,0,,Buldum, baba!
Dialogue: 0,0:06:00.92,0:06:03.26,Main,,0,0,0,,Trafalgar Law'ın kelepçelerinin anahtarı!
Dialogue: 0,0:06:04.10,0:06:06.79,Main,,0,0,0,,Görü gücümle sonunda buldum onu!
Dialogue: 0,0:06:06.79,0:06:08.60,Main,,0,0,0,,Bir şekilde ona ulaştırmamız lazım!
Dialogue: 0,0:06:09.26,0:06:12.87,Main,,0,0,0,,Bekle, Viola!\NNeden bu kadar önem veriyorsun onlara?
Dialogue: 0,0:06:12.87,0:06:14.30,Main,,0,0,0,,Korsan değil mi onlar?!
Dialogue: 0,0:06:14.30,0:06:20.13,Main,,0,0,0,,Evet, bu ülkenin sahte mutluluğuna\Nson verecek kanunsuz kişiler!
Dialogue: 0,0:06:21.42,0:06:26.97,Main,,0,0,0,,Ben onlara, Hasır Şapka korsanlarına\Ngüvenmeye karar verdim!
Dialogue: 0,0:06:31.54,0:06:37.90,Main,,0,0,0,,Dünya Hükümeti'nin Shichibukai rütbesi verdiği ülkemizin başına bela olmuş Korsan Doflamingo...
Dialogue: 0,0:06:38.64,0:06:42.48,Main,,0,0,0,,...bize çok büyük acılar çektirdi!
Dialogue: 0,0:06:43.36,0:06:45.73,Main,,0,0,0,,Şu saatten sonra ne adalet\Niçin savaştığını söyleyen donanmanın...
Dialogue: 0,0:06:45.76,0:06:48.50,Main,,0,0,0,,...ne de hükümetin\Nbizi kurtarmasını istemiyorum!
Dialogue: 0,0:06:51.54,0:06:53.57,Main,,0,0,0,,Keza kulakları duymaz olmuş onların!
Dialogue: 0,0:06:54.00,0:06:57.03,Main,,0,0,0,,Onlar yüzünden kayıp giden\Nonca canın sesi...
Dialogue: 0,0:06:58.10,0:07:00.53,Main,,0,0,0,,...ülkeden yükselen nefret çığlıkları\Nduyulmaz olmuş!
Dialogue: 0,0:07:03.52,0:07:07.64,Main,,0,0,0,,Duydukları\Nduymak istedikleriyle sınırlı hale gelmiş!
Dialogue: 0,0:07:09.92,0:07:13.29,Main,,0,0,0,,En azından Hasır Şapkalar'ın\Nsözleri insancıl ve yaptıkları...
Dialogue: 0,0:07:13.31,0:07:16.68,Main,,0,0,0,,...her şeyi kalplerinden gelen\Nbüyük bir iyilikle yapıyorlar!
Dialogue: 0,0:07:19.62,0:07:23.25,Flashbacks,,0,0,0,,Doflamingo'nun canına okuyacağıma\Nsöz veriyorum!
Dialogue: 0,0:07:23.25,0:07:25.56,Flashbacks,,0,0,0,,Sen dostlarımın yanından ayrılma!
Dialogue: 0,0:07:29.66,0:07:32.52,Main,,0,0,0,,Kral Riku-sama!\NKral Riku-sama!
Dialogue: 0,0:07:33.08,0:07:35.05,Main,,0,0,0,,Ona bakın!
Dialogue: 0,0:07:36.80,0:07:39.82,Main,,0,0,0,,Sen beş yıldızlı olansın, değil mi?
Dialogue: 0,0:07:40.86,0:07:45.16,Main,,0,0,0,,Evet!\NTanrı Usopp, Usoland ismi!
Dialogue: 0,0:07:45.90,0:07:49.52,Main,,0,0,0,,Bu adam hayatı pahasına...
Dialogue: 0,0:07:49.52,0:07:54.29,Main,,0,0,0,,...on yıl boyunca bu ülkeye musallat olmuş oyuncak lanetini bozdu!
Dialogue: 0,0:07:56.18,0:07:58.06,Main,,0,0,0,,Kahramanımız bizim!
Dialogue: 0,0:07:58.22,0:08:00.10,Main,,0,0,0,,Usoland!
Dialogue: 0,0:08:00.99,0:08:05.26,Secondary,,0,0,0,,Usoland! Usoland!
Dialogue: 0,0:08:03.42,0:08:07.37,Main,,0,0,0,,Ve Luffyland da\Nböylesine bir süper kahramanın kaptanı!
Dialogue: 0,0:08:08.18,0:08:15.36,Main,,0,0,0,,Kral Riku-sama! Usolanders yani \NHasır Şapka tayfası Dressrosa'nın umut ışığı!
Dialogue: 0,0:08:16.28,0:08:20.76,Main,,0,0,0,,Korsan bile olsalar\Nonlara sonuna dek güveneceğiz!
Dialogue: 0,0:08:21.15,0:08:25.60,Main,,0,0,0,,Viola-san, o anahtarı Lucy'e\Nben götürmek istiyorum!
Dialogue: 0,0:08:25.60,0:08:26.22,Main,,0,0,0,,Rebecca!
Dialogue: 0,0:08:26.44,0:08:29.66,Main,,0,0,0,,Hiçbir şey yapmadan burada duramam!\NLütfen izin ver!
Dialogue: 0,0:08:29.66,0:08:30.82,Main,,0,0,0,,Rebecca...
Dialogue: 0,0:08:30.82,0:08:34.42,Main,,0,0,0,,Tamamdır, yapalım bu işi!\NGidip Luffy-senpai'yi görelim!
Dialogue: 0,0:08:34.42,0:08:37.44,Main,,0,0,0,,Tamamdır, yapalım bu işi!\NGidip Luffy-senpai'yi görelim!
Dialogue: 0,0:08:37.44,0:08:42.24,Main,,0,0,0,,Rebecca, Doflamingo'nun oyununda\Nsen de suçlulardan birisin!
Dialogue: 0,0:08:42.24,0:08:43.62,Main,,0,0,0,,Şehre inersen peşini bırakmazlar!
Dialogue: 0,0:08:43.62,0:08:45.02,Main,,0,0,0,,Şehre inersen peşini bırakmazlar!
Dialogue: 0,0:08:45.56,0:08:48.54,Main,,0,0,0,,Gitmeye kararlıysanız çatıları kullanalım!
Dialogue: 0,0:08:48.54,0:08:52.01,Main,,0,0,0,,Kabu-san'la ikimiz size eşlik edeceğiz!\Nİçiniz rahat olsun!
Dialogue: 0,0:08:52.90,0:08:54.34,Main,,0,0,0,,Çatıları mı?!
Dialogue: 0,0:08:54.34,0:08:58.36,Main,,0,0,0,,Evet!\NInhel, fabrikayı sana bırakabilir miyim?
Dialogue: 0,0:08:58.36,0:08:59.72,Main,,0,0,0,,Elbette!
Dialogue: 0,0:08:59.72,0:09:04.96,Main,,0,0,0,,Öncü birliğin söylediğine bakılırsa\NFraland Senyor Pink'le savaşıyormuş!
Dialogue: 0,0:09:05.54,0:09:11.38,Main,,0,0,0,,Fraland'la birlikte, tontattalar olarak \NPrenses Mancherie'yle dostlarımızı kurtaracağız!
Dialogue: 0,0:09:11.38,0:09:12.57,Main,,0,0,0,,Pekâlâ!
Dialogue: 0,0:09:12.57,0:09:14.23,Main,,0,0,0,,Görüşürüz öyleyse!
Dialogue: 0,0:09:14.43,0:09:21.02,Main,,0,0,0,,Millet! Çok zamanımız yok!\NKral Tepesi'nde yeniden buluşmak üzere!
Dialogue: 0,0:09:21.58,0:09:23.01,Main,,0,0,0,,Gidelim!
Dialogue: 0,0:09:28.30,0:09:33.08,Main,,0,0,0,,{\i1}Hasır Şapkalı Luffy...\NNe gizemli biri!{\i0}
Dialogue: 0,0:09:54.10,0:09:56.64,Main,,0,0,0,,Doflamingo!
Dialogue: 0,0:09:59.02,0:10:00.32,Main,,0,0,0,,Çok tuhaf!
Dialogue: 0,0:10:01.02,0:10:03.04,Main,,0,0,0,,Ay çok tuhaf!
Dialogue: 0,0:10:05.74,0:10:08.91,Main,,0,0,0,,Kolezyumdaki yarım kafalılar\Noraya kadar nasıl gelebildiler?!
Dialogue: 0,0:10:08.91,0:10:11.72,Main,,0,0,0,,Aşağıda binlerce\NDonanma askeri var sanıyordum!
Dialogue: 0,0:10:11.72,0:10:14.18,Main,,0,0,0,,Öyle olmalıydı-in!
Dialogue: 0,0:10:16.96,0:10:19.31,Main,,0,0,0,,Askerleri geçtim Koramiral Bastille ve...
Dialogue: 0,0:10:19.33,0:10:22.10,Main,,0,0,0,,...Donanma Karargâh Amirali Fujitora\Nda orada olmalıydı hatta!
Dialogue: 0,0:10:26.46,0:10:29.78,Main,,0,0,0,,Oraya kadar nasıl gelebildiler?!
Dialogue: 0,0:10:32.38,0:10:36.96,Main,,0,0,0,,Don Quixote Ailesi'nin askeri gücü\Nbu kadarcık mıymış?!
Dialogue: 0,0:10:36.96,0:10:39.70,Main,,0,0,0,,Patronlarının yanına göz açıp\Nkapayıncaya dek varacağız!
Dialogue: 0,0:10:41.01,0:10:42.56,Main,,0,0,0,,{\i1}Rapor veriyorum!{\i0}
Dialogue: 0,0:10:43.18,0:10:45.96,Main,,0,0,0,,{\i1}Hasır Şapkalı Luffy birinci kata ulaş-{\i0}
Dialogue: 0,0:10:47.53,0:10:52.31,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no Mitralyöz!
Dialogue: 0,0:10:52.96,0:10:54.87,Main,,0,0,0,,Çekilin yolumdan!
Dialogue: 0,0:10:59.60,0:11:04.22,Main,,0,0,0,,Onu durdurabilmemize imkan yok...
Dialogue: 0,0:11:07.00,0:11:08.28,Main,,0,0,0,,Hasır Şapka!
Dialogue: 0,0:11:09.66,0:11:11.66,Main,,0,0,0,,Ay yeniliyorlar!
Dialogue: 0,0:11:15.84,0:11:18.76,Main,,0,0,0,,Kolezyum grubu da\Naşağıdan hızla yaklaşıyor!
Dialogue: 0,0:11:22.96,0:11:24.59,Main,,0,0,0,,Hasır Şapka!
Dialogue: 0,0:11:28.74,0:11:30.40,Main,,0,0,0,,Buldum onları, Dellinger!
Dialogue: 0,0:11:31.41,0:11:34.54,Main,,0,0,0,,Tüm donanma askerleri alıkonulmuş!
Dialogue: 0,0:11:34.54,0:11:35.71,Main,,0,0,0,,Ne dedin?!
Dialogue: 0,0:11:41.52,0:11:46.42,Main,,0,0,0,,Ne kadar ısrar edersem edeyim\Nyoldan çekilmeyeceksin demek?
Dialogue: 0,0:11:47.20,0:11:48.69,Main,,0,0,0,,Aynen öyle.
Dialogue: 0,0:11:52.18,0:11:57.16,Main,,0,0,0,,Korsan Hasır Şapka Tayfası\Nve onları destekleyen savaşçılar.
Dialogue: 0,0:11:58.06,0:12:01.10,Main,,0,0,0,,Onlara zarar vermeye çalışan kimsenin...
Dialogue: 0,0:12:03.10,0:12:05.70,Main,,0,0,0,,...buradan ileri gitmesine\Nizin veremem!
Dialogue: 0,0:12:10.83,0:12:16.39,Main,,0,0,0,,Korsanların arkasını kollamak\NDevrim Ordusu'nun işi mi oldu?
Dialogue: 0,0:12:16.39,0:12:18.01,Main,,0,0,0,,Aynen öyle.
Dialogue: 0,0:12:18.01,0:12:21.22,Main,,0,0,0,,Devrim Ordusu'nun bir üyesi olarak\Nburadan geçmene müsaade etmeyeceğim.
Dialogue: 0,0:12:22.20,0:12:24.24,Main,,0,0,0,,Pek doğru olmadı bu aslında.
Dialogue: 0,0:12:24.24,0:12:26.39,Main,,0,0,0,,Onun ağabeyi olarak\Nbuna müsaade etmeyeceğim!
Dialogue: 0,0:12:28.94,0:12:30.55,Main,,0,0,0,,Bak sen...
Dialogue: 0,0:12:30.55,0:12:34.54,Main,,0,0,0,,Acaba hangisinin ağabeyisin?
Dialogue: 0,0:12:40.14,0:12:41.99,Main,,0,0,0,,Seni soysuz!
Dialogue: 0,0:12:53.14,0:12:54.45,Main,,0,0,0,,İşe yaramaz dedim.
Dialogue: 0,0:12:55.61,0:12:58.82,Main,,0,0,0,,Mera Mera Meyvesi'nin gücüne sahibim!
Dialogue: 0,0:12:59.72,0:13:00.89,Main,,0,0,0,,Amma can sıkmaya başladın!
Dialogue: 0,0:13:00.89,0:13:04.66,Main,,0,0,0,,Koca Donanma olarak tek bir\NDevrim Ordusu üyesine yenilemeyiz!
Dialogue: 0,0:13:04.66,0:13:06.33,Main,,0,0,0,,Bekleyin!\NYapmayın dedim size-dara!
Dialogue: 0,0:13:06.33,0:13:07.62,Main,,0,0,0,,Ateş edin!
Dialogue: 0,0:13:13.10,0:13:14.64,Main,,0,0,0,,Yapmayın dedim!
Dialogue: 0,0:13:20.82,0:13:24.55,Main,,0,0,0,,Çok güçlü parmakları var!
Dialogue: 0,0:13:27.39,0:13:29.14,Main,,0,0,0,,Pençe onlar!
Dialogue: 0,0:13:49.02,0:13:50.04,Main,,0,0,0,,Geri çekilin!
Dialogue: 0,0:13:50.20,0:13:53.54,Main,,0,0,0,,Siz onu yenemezsiniz-dara!
Dialogue: 0,0:13:58.84,0:14:00.62,Main,,0,0,0,,Parmaklarım...
Dialogue: 0,0:14:01.96,0:14:03.53,Main,,0,0,0,,...ejderha pençesidir!
Dialogue: 0,0:14:07.72,0:14:11.03,Main,,0,0,0,,Geri kafalı insanları\Ngüçten düşüren pençeler!
Dialogue: 0,0:14:23.32,0:14:26.20,Main,,0,0,0,,Koramiral Bastille'in\NKöpek Balığı Kesicisi...
Dialogue: 0,0:14:26.20,0:14:27.78,Main,,0,0,0,,Lanet olası!
Dialogue: 0,0:14:29.10,0:14:30.21,Main,,0,0,0,,Bu pençeler...
Dialogue: 0,0:14:31.15,0:14:36.68,Main,,0,0,0,,...insan kafatasını\Nyumurta gibi kırıp geçer!
Dialogue: 0,0:14:50.74,0:14:53.14,Main,,0,0,0,,Olmadı gibi.
Dialogue: 0,0:14:58.00,0:15:04.88,Main,,0,0,0,,Kuş Kafesi yüzünden meteorum\Nparamparça olacak sanırım?
Dialogue: 0,0:15:13.79,0:15:14.66,Main,,0,0,0,,Kaçın!
Dialogue: 0,0:15:14.66,0:15:16.52,Main,,0,0,0,,Göktaşı!
Dialogue: 0,0:15:29.38,0:15:33.32,Main,,0,0,0,,Tüh!\NOlmadı bu böyle!
Dialogue: 0,0:15:33.32,0:15:36.83,Main,,0,0,0,,Dört tarafa dağıldı ama...
Dialogue: 0,0:15:36.83,0:15:40.32,Main,,0,0,0,,Umarım halktan kimseye zarar gelmemiştir.
Dialogue: 0,0:15:40.32,0:15:44.15,Main,,0,0,0,,Göktaşı çağıracağınız zaman\Nhaberimiz olsun ama, Issho-san!
Dialogue: 0,0:15:44.15,0:15:47.04,Main,,0,0,0,,Kusura bakmayın!\NBir tane indirdim!
Dialogue: 0,0:15:47.04,0:15:48.62,Main,,0,0,0,,Onu önce söyleyecektiniz!
Dialogue: 0,0:15:54.98,0:15:59.07,Main,,0,0,0,,Nasıl bir durumda olduğunun\Nfarkında mısın?
Dialogue: 0,0:16:01.18,0:16:03.58,Main,,0,0,0,,Henüz gücüme\Ntam olarak alışamadığımdan...
Dialogue: 0,0:16:04.50,0:16:06.44,Main,,0,0,0,,...önceliği kendimi kurtarmaya verdim.
Dialogue: 0,0:16:09.92,0:16:11.48,Main,,0,0,0,,Koramiral Bastille!
Dialogue: 0,0:16:12.78,0:16:14.55,Main,,0,0,0,,Koramiral-dono!
Dialogue: 0,0:16:18.88,0:16:24.84,Main,,0,0,0,,Az önce "ağabeyi olarak yapmam gerek"\Ndiye bir şey söylemiştin...
Dialogue: 0,0:16:24.84,0:16:26.05,Main,,0,0,0,,Evet.
Dialogue: 0,0:16:26.05,0:16:29.49,Main,,0,0,0,,Senden önce bu Mera Mera\NMeyvesi'nin gücüne sahip kişi...
Dialogue: 0,0:16:29.51,0:16:33.38,Main,,0,0,0,,...En İyiler Savaşı'nda\Nölen Ateş Yumruk Ace de...
Dialogue: 0,0:16:33.38,0:16:37.68,Main,,0,0,0,,...Hasır Şapka'nın\Nüvey kardeşi olduğunu iddia etmişti.
Dialogue: 0,0:16:41.36,0:16:44.52,Main,,0,0,0,,Sen de mi öylesin?
Dialogue: 0,0:16:56.38,0:16:58.90,Main,,0,0,0,,Üçümüz sakemizi paylaştık.
Dialogue: 0,0:17:00.88,0:17:05.04,Main,,0,0,0,,Aramızda kimselerin kopartamayacağı\Nbir bağ mevcut.
Dialogue: 0,0:17:19.34,0:17:23.92,Main,,0,0,0,,Ne korkunç kardeşler ama...
Dialogue: 0,0:17:23.92,0:17:25.70,Main,,0,0,0,,Nasıl kardeş bunlar böyle?!
Dialogue: 0,0:17:26.01,0:17:27.93,Main,,0,0,0,,Hasır Şapka'nın ağabeyleri...
Dialogue: 0,0:17:29.38,0:17:32.20,Main,,0,0,0,,Biri Beyaz Sakal Korsanları'nın\Nkomutanıydı...
Dialogue: 0,0:17:33.64,0:17:37.90,Main,,0,0,0,,...öteki de Devrim Ordusu'nun\Niki numarası!
Dialogue: 0,0:17:38.57,0:17:40.21,Main,,0,0,0,,Şunu unutma.
Dialogue: 0,0:17:40.21,0:17:43.90,Main,,0,0,0,,Luffy yardımımı istesin...
Dialogue: 0,0:17:43.90,0:17:48.88,Main,,0,0,0,,...dünyanın öteki ucunda da olsam\Nrütbemi bir kenara atar gelirim!
Dialogue: 0,0:17:57.24,0:17:58.96,Main,,0,0,0,,Aynı acıyı...
Dialogue: 0,0:18:01.42,0:18:02.56,Note,,0,0,0,,Gazete Başlığı: Ace Öldü
Dialogue: 0,0:18:06.49,0:18:07.34,Flashbacks,,0,0,0,,Sabo-kun!
Dialogue: 0,0:18:07.34,0:18:08.56,Flashbacks,,0,0,0,,Sabo!
Dialogue: 0,0:18:13.56,0:18:15.47,Thoughts,,0,0,0,,{\i1}Bir daha yaşamak istemiyorum!{\i0}
Dialogue: 0,0:18:22.18,0:18:26.04,Main,,0,0,0,,Başka soru sormamın\Nbir manası yok.
Dialogue: 0,0:18:27.06,0:18:29.64,Main,,0,0,0,,Çok umrunda da değildi zaten, değil mi?
Dialogue: 0,0:18:30.00,0:18:33.92,Main,,0,0,0,,Hikayelerini dinlerken içebileceğim\Nbir bardak sakem yok maalesef.
Dialogue: 0,0:18:44.94,0:18:46.14,Main,,0,0,0,,{\i1}Luffy'yi...{\i0}
Dialogue: 0,0:18:47.08,0:18:48.76,Main,,0,0,0,,{\i1}...koruyacağım!{\i0}
Dialogue: 0,0:18:59.35,0:19:04.32,Captions,,250,0,550,,{\fad(1300,0)}Kraliyet Sarayı\NBirinci Seviye
Dialogue: 0,0:19:04.55,0:19:07.29,Main,,0,0,0,,Hadi, hadi, hadi!
Dialogue: 0,0:19:11.22,0:19:13.60,Main,,0,0,0,,Kolezyum'un Ölüm Meleği değil mi bu?!
Dialogue: 0,0:19:14.08,0:19:19.17,Main,,0,0,0,,Herkes boğayı hedef alsın!\NToplu bir şekilde saldırıp durduralım onu!
Dialogue: 0,0:19:22.26,0:19:24.86,Main,,0,0,0,,Moocy'i hafife almayın!
Dialogue: 0,0:19:33.75,0:19:36.96,Main,,0,0,0,,Moocy!\NHadi!
Dialogue: 0,0:19:37.92,0:19:40.94,Main,,0,0,0,,Ölüm Meleği duruyor karşınızda!\NSelam durun!
Dialogue: 0,0:19:40.94,0:19:42.90,Main,,0,0,0,,Çekilin yolumuzdan!
Dialogue: 0,0:19:42.90,0:19:45.70,Main,,0,0,0,,Saraya kadar dümdüz devam!
Dialogue: 0,0:19:53.24,0:19:54.77,Main,,0,0,0,,Kabak mı o?!
Dialogue: 0,0:20:01.60,0:20:04.90,Main,,0,0,0,,Hasır Şapka, ben önden kaçtım!
Dialogue: 0,0:20:09.18,0:20:12.66,Main,,0,0,0,,Lanet olsun!\NKestirmeden geldim sanıyordum ben de!
Dialogue: 0,0:20:12.66,0:20:15.16,Main,,0,0,0,,Daha da hızlan, Moocy!
Dialogue: 0,0:20:17.82,0:20:20.36,Main,,0,0,0,,Yok artık, herkes yetişmiş bize!
Dialogue: 0,0:20:21.24,0:20:22.64,Main,,0,0,0,,Hajrudin!
Dialogue: 0,0:20:26.50,0:20:29.36,Main,,0,0,0,,Çekilin yolumdan!\NPiyonlarla işim yok!
Dialogue: 0,0:20:29.36,0:20:31.18,Main,,0,0,0,,Acelem var!
Dialogue: 0,0:20:33.21,0:20:35.85,Main,,0,0,0,,Hiç iyi olmadı bu, geride kalacağım!
Dialogue: 0,0:20:35.85,0:20:37.51,Main,,0,0,0,,Ateş edin!
Dialogue: 0,0:20:37.51,0:20:39.25,Main,,0,0,0,,Gene geldiler!
Dialogue: 0,0:20:39.25,0:20:41.78,Main,,0,0,0,,Korkmayın!\NBoğayı vurun!
Dialogue: 0,0:20:42.36,0:20:44.29,Secondary,,0,0,0,,Düşeceğiz!
Dialogue: 0,0:20:46.84,0:20:52.10,Main,,0,0,0,,Hasır Şapkalı Luffy'e dokunmayın,\Nzırtapozlar sizi!
Dialogue: 0,0:20:52.10,0:20:53.82,Main,,0,0,0,,{\fad(150,150)}Ra-Ra-Ra-Rambo!
Dialogue: 0,0:20:59.12,0:21:00.20,Main,,0,0,0,,Bu da kim?
Dialogue: 0,0:21:02.78,0:21:05.48,Main,,0,0,0,,Alındım şimdi bak!
Dialogue: 0,0:21:05.48,0:21:09.06,Main,,0,0,1,,Biz de senin gibi C Bloğu yarışmacısıydık.
Dialogue: 0,0:21:06.98,0:21:12.06,Captions,,0,0,250,,{\fad(450,300)}Mogaro'nun Suikastçıları, Funk Kardeşler\NAbi: Kelly (Bobby ile Birleşik)
Dialogue: 0,0:21:09.06,0:21:10.84,Main,,0,0,1,,Kelly Funk!
Dialogue: 0,0:21:12.58,0:21:13.84,Main,,0,0,0,,Hadi ya?
Dialogue: 0,0:21:15.90,0:21:17.47,Main,,0,0,0,,Hey, hey, hey!
Dialogue: 0,0:21:17.47,0:21:21.34,Main,,0,0,0,,Biz de herkes gibi\NTanrı Usopp tarafından kurtarıldık!
Dialogue: 0,0:21:21.34,0:21:23.95,Main,,0,0,0,,Üst seviyelere erişmek için\Nkestirme bir yol buldum.
Dialogue: 0,0:21:23.95,0:21:28.27,Main,,0,0,0,,Doğrudan sarayın önündeki\NAyçiçeği Tarlası'na varabilirsiniz!
Dialogue: 0,0:21:28.27,0:21:30.13,Main,,0,0,0,,Ne? Sahiden mi?!
Dialogue: 0,0:21:30.34,0:21:32.30,Main,,0,0,0,,Size yardım etmek istiyorum!
Dialogue: 0,0:21:32.30,0:21:35.37,Main,,0,0,0,,Pekâlâ öyleyse! Kabak'ları\Nbir çırpıda arkamızda bırakacağız!
Dialogue: 0,0:21:38.50,0:21:40.34,Main,,0,0,0,,Hasır Şapka-ya!
Dialogue: 0,0:21:41.74,0:21:44.12,Main,,0,0,0,,Bu kelepçeleri nerede çıkartırız?
Dialogue: 0,0:21:44.44,0:21:50.28,Main,,0,0,0,,Kairousekili kelepçeler varken\NDoflamingo beni kolayca öldürür.
Dialogue: 0,0:21:50.28,0:21:53.68,Main,,0,0,0,,Bir şekilde hallolur yahu!\Nİlerlemeye bakalım biz!
Dialogue: 0,0:21:53.68,0:21:54.87,Main,,0,0,0,,Nasıl bu kadar emin olabiliyorsun?!
Dialogue: 0,0:21:54.87,0:21:57.46,Main,,0,0,0,,Anahtarı kaybettiğim tepeye\Ngeri dönelim o zaman!
Dialogue: 0,0:21:57.46,0:21:58.40,Main,,0,0,0,,Neden ki?
Dialogue: 0,0:21:58.56,0:22:00.10,Main,,0,0,0,,Anahtarı arayacağım da ondan!
Dialogue: 0,0:22:00.10,0:22:02.58,Main,,0,0,0,,Hayatımızı\Nortaya koyacağımız bir savaş olacak bu!
Dialogue: 0,0:22:02.92,0:22:05.47,Main,,0,0,0,,Gördünüz mü?\Nİşte kestirme!
Dialogue: 0,0:22:06.72,0:22:11.78,Main,,0,0,0,,Haydi, gir bakalım Hasır Şapka!\NGirişi biz koruruz!
Dialogue: 0,0:22:11.78,0:22:13.61,Main,,0,0,0,,Pekâlâ, teşekkür ettim!
Dialogue: 0,0:22:13.61,0:22:15.22,Main,,0,0,0,,Moocy, gidelim!
Dialogue: 0,0:22:18.56,0:22:20.04,Main,,0,0,0,,Dikkatli olun!
Dialogue: 0,0:22:20.04,0:22:22.70,Main,,0,0,0,,İyi iş, Kelly Funk!
Dialogue: 0,0:22:22.70,0:22:26.96,Main,,0,0,0,,Girişi iyi koru!\NTeşekkür ettik!
Dialogue: 0,0:22:33.68,0:22:37.62,Main,,0,0,0,,Düştüler...\NBu da neydi şimdi?!
Dialogue: 0,0:22:37.62,0:22:40.72,Main,,0,0,0,,Pekâlâ, hiçbir şeyi düşünmeden ilerle Moocy!
Dialogue: 0,0:22:42.58,0:22:44.64,Main,,0,0,0,,Doğrudan Ayçiçeği Tarlası'na!
Dialogue: 0,0:22:49.01,0:22:51.67,Main,,0,0,0,,Ha-Hasır Şapka-san...
Dialogue: 0,0:22:51.67,0:22:54.40,Main,,0,0,0,,Yolun açık olsun!
Dialogue: 0,0:22:58.46,0:23:00.22,Main,,0,0,0,,Denden Mushin...
Dialogue: 0,0:23:00.22,0:23:01.09,Main,,0,0,0,,Aç.
Dialogue: 0,0:23:01.64,0:23:02.60,Main,,0,0,0,,Alo?
Dialogue: 0,0:23:02.60,0:23:03.88,Main,,0,0,0,,Luffy'le görüşüyorsunuz!
Dialogue: 0,0:23:03.88,0:23:05.76,Main,,0,0,0,,Korsanlar Kralı olacak adamla!
Dialogue: 0,0:23:05.96,0:23:07.52,Main,,0,0,0,,Luffy, benim.
Dialogue: 0,0:23:07.52,0:23:08.90,Main,,0,0,0,,{\i1}Robin!{\i0}
Dialogue: 0,0:23:08.90,0:23:12.92,Main,,0,0,0,,Yola çıktığınız o tepedeyiz biz.
Dialogue: 0,0:23:12.92,0:23:13.80,Main,,0,0,0,,Siz neredesiniz?
Dialogue: 0,0:23:14.36,0:23:19.18,Main,,0,0,0,,Öbür tepenin birinci seviyesindeyiz ve \NAyçiçeği Tarlası diye bir yere doğru ilerliyoruz.
Dialogue: 0,0:23:19.58,0:23:21.99,Main,,0,0,0,,Ayçiçeği Tarlası dördüncü seviyede.
Dialogue: 0,0:23:21.99,0:23:25.80,Main,,0,0,0,,Viola Trao-kun'un kelepçelerinin\Nanahtarını buldu!
Dialogue: 0,0:23:25.80,0:23:26.94,Main,,0,0,0,,Sahiden mi?!
Dialogue: 0,0:23:26.94,0:23:29.08,Main,,0,0,0,,Nico-ya, çabucak getirmeniz lazım onu bana!
Dialogue: 0,0:23:29.08,0:23:30.22,Main,,0,0,0,,Nerede buluşabiliriz?!
Dialogue: 0,0:23:30.22,0:23:33.09,Main,,0,0,0,,Merhabalar, Tontatta Kabilesi'nden Leo ben.
Dialogue: 0,0:23:33.46,0:23:40.73,Main,,0,0,0,,Rebecca-sama'yla Horoz-Kafalı Büyük İnsan ve \NRobiland'ı jet hızında oraya ulaştıracağız!
Dialogue: 0,0:23:42.08,0:23:46.22,Main,,0,0,0,,Öyleyse dördüncü seviyedeki\NAyçiçeği Tarlası'nda buluşalım!
Dialogue: 0,0:23:46.72,0:23:49.41,Main,,0,0,0,,{\i1}Bize nasıl yetişeceksiniz ki?!{\i0}
Dialogue: 0,0:23:49.94,0:23:53.30,Main,,0,0,0,,Orasını sonra açıklarım!\NAyçiçeği Tarlası'nda görüşmek üzere!
Dialogue: 0,0:23:55.30,0:23:57.18,Main,,0,0,0,,Gördün mü?\NBir şekilde hallolur demiştim.
Dialogue: 0,0:23:57.39,0:23:58.92,Main,,0,0,0,,Tamamen şans eseri oldu!
Dialogue: 0,0:23:59.50,0:24:02.90,Main,,0,0,0,,Pekâlâ Moocy, koş!
Dialogue: 0,0:24:06.49,0:24:08.86,Main,,0,0,0,,Dur! Suyun içindeyiz!
Dialogue: 0,0:24:11.90,0:24:14.10,Main,,0,0,0,,Oha!\NYol sona erdi!
Dialogue: 0,0:24:14.10,0:24:15.43,Main,,0,0,0,,Geri dön, çabuk!
Dialogue: 0,0:24:16.16,0:24:18.56,Main,,0,0,0,,Moocy, panikleme!
Dialogue: 0,0:24:21.14,0:24:22.34,Main,,0,0,0,,Biri geliyor.
Dialogue: 0,0:24:29.74,0:24:32.69,Main,,0,0,0,,Burası sıradan bir eğik su kuyusu.
Dialogue: 0,0:24:32.69,0:24:35.12,Main,,0,0,0,,Kestirme falan yok burada.
Dialogue: 0,0:24:48.06,0:24:49.20,Main,,0,0,0,,Sen...
Dialogue: 0,0:24:50.04,0:24:51.60,Main,,0,0,1,,Doflamingo!
