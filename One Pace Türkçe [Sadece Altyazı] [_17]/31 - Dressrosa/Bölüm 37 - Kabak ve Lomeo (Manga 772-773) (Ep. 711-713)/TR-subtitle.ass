Dialogue: 0,0:01:49.07,0:01:53.78,Captions,,0,0,170,,{\fad(1000,0)}4. Seviye - Ayçiçeği Tarlası
Dialogue: 0,0:01:49.72,0:01:51.84,Main,,0,0,3,,Ee? Şimdi ne yapacaksın?
Dialogue: 0,0:01:51.92,0:01:53.70,Main,,0,0,3,,Ne yapacaksın?
Dialogue: 0,0:01:53.98,0:01:57.10,Main,,0,0,0,,Zemin bayrak gibi dalgalanıyor!
Dialogue: 0,0:01:57.36,0:02:02.90,Main,,0,0,0,,Ne zavallıca! \NPislik içinde sürüklen, Oyuncak Asker!
Dialogue: 0,0:02:03.43,0:02:08.67,Title,,0,0,240,,{\fad(800,800)}Kabak ve Lomeo
Dialogue: 0,0:02:06.16,0:02:08.80,Main,,0,0,0,,Şimdi anlıyorum!\NTüm noktalar birleşti!
Dialogue: 0,0:02:09.50,0:02:13.92,Main,,0,0,0,,O gün aptallar gibi ağlayıp bağıran\Noyuncak asker...
Dialogue: 0,0:02:14.10,0:02:16.36,Main,,0,0,0,,Sendin değil mi?!
Dialogue: 0,0:02:23.84,0:02:27.77,Flashbacks,,0,0,0,,Scarlet!
Dialogue: 0,0:02:30.16,0:02:36.44,Main,,0,0,0,,Ölen Scarlet'in kocası,\NRebecca'nın da babasısın.
Dialogue: 0,0:02:41.48,0:02:43.14,Main,,0,0,0,,Ne güzel, ne güzel!
Dialogue: 0,0:02:43.52,0:02:47.66,Main,,0,0,0,,Aramızda nefretten başka\Nbir şey yok, ha Kyros?!
Dialogue: 0,0:02:48.40,0:02:49.46,Main,,0,0,0,,Aynen öyle!
Dialogue: 0,0:02:49.99,0:02:51.58,Main,,0,0,0,,O yüzden buraya geldim!
Dialogue: 0,0:02:55.38,0:02:58.94,Main,,0,0,0,,Amanın... Güzel hareketti!
Dialogue: 0,0:02:59.10,0:03:01.64,Main,,0,0,0,,Ama pelerinim çeliktendir,\Ndikkatli olsan iyi edersin!
Dialogue: 0,0:03:04.94,0:03:07.10,Main,,0,0,0,,{\fad(150,150)}Vipera Glaive!
Dialogue: 0,0:03:04.94,0:03:07.10,Note,,0,0,0,,{\fad(150,150)}Yılan Kılıcı
Dialogue: 0,0:03:18.82,0:03:19.88,Main,,0,0,0,,Baba!
Dialogue: 0,0:03:22.02,0:03:24.34,Main,,0,0,0,,Baba, ben de savaşacağım!
Dialogue: 0,0:03:25.34,0:03:30.32,Main,,0,0,0,,Evet! Savaş Rebecca!\NSavaş ki seni de gebertebileyim!
Dialogue: 0,0:03:33.26,0:03:38.42,Main,,0,0,0,,Kyros'un karısının ardından\Nkızını da kaybedişini görmek istiyorum!
Dialogue: 0,0:03:38.76,0:03:39.98,Main,,0,0,0,,Hayır Rebecca!
Dialogue: 0,0:03:40.22,0:03:43.66,Main,,0,0,0,,İzin ver seni hem kendim\Nhem de Scarlet için koruyayım!
Dialogue: 0,0:03:45.94,0:03:50.68,Main,,0,0,0,,Sana savaşmayı öğretmemin\Nborcunu ödeyeyim!
Dialogue: 0,0:03:51.44,0:03:55.03,Main,,0,0,0,,Bugüne dek büyük bir pişmanlık\Nve utançla yaşadım!
Dialogue: 0,0:03:57.50,0:04:03.80,Main,,0,0,0,,Ama artık insanım! Kızımın bir daha\Nkılıç savurmasına izin vermem!
Dialogue: 0,0:04:16.48,0:04:18.64,Main,,0,0,0,,Eyvah!
Dialogue: 0,0:04:18.84,0:04:22.65,Captions,,0,0,170,,{\fad(500,0)}Kraliyet Sarayı Tepesi - 2. Seviye
Dialogue: 0,0:04:19.42,0:04:22.30,Main,,0,0,3,,Lao G-sama yenildi!
Dialogue: 0,0:04:23.26,0:04:25.66,Main,,0,0,0,,Ne yıkıcı güç ama...
Dialogue: 0,0:04:28.16,0:04:30.48,Main,,0,0,0,,Bu ismi daha önce de duymuştum.
Dialogue: 0,0:04:30.78,0:04:33.26,Main,,0,0,0,,Kano Krallığı'nın\NHapposui Ordusu...
Dialogue: 0,0:04:33.76,0:04:34.92,Main,,0,0,0,,Aklıma yazsam iyi ederim.
Dialogue: 0,0:04:35.10,0:04:37.60,Main,,0,0,0,,İleride kimin düşman olarak karşımıza dikileceği bilinmez.
Dialogue: 0,0:04:38.44,0:04:40.94,Main,,0,0,0,,İhtiyar!
Dialogue: 0,0:04:41.06,0:04:42.98,Main,,0,0,0,,Ölme sakın ihtiyar!
Dialogue: 0,0:04:43.28,0:04:47.04,Main,,0,0,0,,Öyleyse ben iki salon ayarlayayım, hayatım!
Dialogue: 0,0:04:47.38,0:04:49.36,Main,,0,0,0,,Salon mu?! Hayatım mı?!
Dialogue: 0,0:04:49.46,0:04:51.56,Main,,0,0,0,,Düğün için bir tane...
Dialogue: 0,0:04:51.74,0:04:53.06,Main,,0,0,0,,Cenaze için başka bir tane...
Dialogue: 0,0:04:53.20,0:04:54.40,Main,,0,0,0,,Hemen öldürmesene!
Dialogue: 0,0:04:55.58,0:04:58.36,Captions,,0,0,170,,{\fad(525,0)}Kraliyet Sarayı Tepesi - 3. Seviye
Dialogue: 0,0:04:58.62,0:05:02.04,Main,,0,0,0,,Deminden beri niye fısır fısır\Nyerlerde dolanıyorsun?
Dialogue: 0,0:05:02.36,0:05:04.68,Main,,0,0,0,,Haydi, savaş benimle Gladius!
Dialogue: 0,0:05:06.06,0:05:07.60,Main,,0,0,0,,Şansını zorlama!
Dialogue: 0,0:05:15.16,0:05:16.08,Main,,0,0,0,,Ne oluyor...
Dialogue: 0,0:05:18.36,0:05:20.98,Main,,0,0,0,,Eyvah!\NGladius-sama, yoksa...
Dialogue: 0,0:05:25.78,0:05:27.90,Main,,0,0,0,,Yer şişmeye başladı!
Dialogue: 0,0:05:29.55,0:05:31.42,Main,,0,0,0,,Neler olacağını kestirebiliyorsun, değil mi?
Dialogue: 0,0:05:31.89,0:05:34.44,Main,,0,0,0,,Demek bunları yerleştiriyordun?!
Dialogue: 0,0:05:38.20,0:05:40.08,Main,,0,0,0,,Burası tehlikeli!
Dialogue: 0,0:05:40.20,0:05:41.81,Main,,0,0,0,,Kaçın!
Dialogue: 0,0:05:43.80,0:05:46.72,Main,,0,0,0,,Bartolomeo, yerle beraber\Nher şey havaya uçacak!
Dialogue: 0,0:05:47.02,0:05:48.44,Main,,0,0,0,,Bariyerinin içine girmeme izin ver!
Dialogue: 0,0:05:48.58,0:05:49.57,Main,,0,0,0,,Olmaz!
Dialogue: 0,0:05:49.72,0:05:50.42,Main,,0,0,0,,Ne?!
Dialogue: 0,0:05:50.58,0:05:55.26,Main,,0,0,0,,Açarsam Robin-senpai'yle kendimi tehlikeye\Natmış olurum, hem düşmanlar da girer.
Dialogue: 0,0:05:55.50,0:05:58.50,Main,,0,0,0,,Açsana be!\NAynı tarafta değil miyiz?!
Dialogue: 0,0:05:58.66,0:06:01.44,Main,,0,0,0,,Gladius-sama, biz de arada kalacağız...
Dialogue: 0,0:06:01.56,0:06:04.62,Main,,0,0,0,,Bir şey olmaz. \NElit askerler değil misiniz sonuçta?
Dialogue: 0,0:06:05.40,0:06:07.02,Main,,0,0,0,,Açsana!
Dialogue: 0,0:06:07.80,0:06:09.20,Main,,0,0,0,,{\fad(150,150)}Patlayıcı Rock...
Dialogue: 0,0:06:09.87,0:06:10.83,Main,,0,0,0,,{\fad(150,150)}...Fest!
Dialogue: 0,0:06:28.55,0:06:30.56,Main,,0,0,0,,Elveda, Cavendish.
Dialogue: 0,0:06:37.70,0:06:40.74,Main,,0,0,0,,Şimdi dışarıda olsan anında ölmüştün.
Dialogue: 0,0:06:44.60,0:06:47.54,Main,,0,0,0,,Madem içeri alacaktın\Nyarım saattir ne oyalıyorsun?!
Dialogue: 0,0:06:47.60,0:06:48.92,Main,,0,0,0,,Öleceğim sandım be!
Dialogue: 0,0:06:49.86,0:06:51.24,Main,,0,0,0,,Ne biçim insansın sen!?
Dialogue: 0,0:06:51.50,0:06:54.26,Main,,0,0,0,,Hayatını kurtaran birine \Nböyle mi teşekkür ediyorsun?!
Dialogue: 0,0:06:54.34,0:06:57.64,Main,,0,0,0,,Ondan önce de ben seni koruyordum,\Nsenin teşekkür etmen lazım!
Dialogue: 0,0:06:59.58,0:07:01.44,Main,,0,0,0,,Yetti be!\NSavaşa dönüyorum ben!
Dialogue: 0,0:07:01.54,0:07:02.42,Main,,0,0,0,,Dışarı çıkart beni!
Dialogue: 0,0:07:02.52,0:07:03.62,Main,,0,0,0,,Ne?!
Dialogue: 0,0:07:03.74,0:07:06.84,Main,,0,0,0,,O kadar içeri aldım\Nşimdi de dışarı çıkmak mı istiyorsun?!
Dialogue: 0,0:07:06.96,0:07:10.90,Main,,0,0,0,,Hazır girmişken biraz daha\Nkalsana be bencil herif!
Dialogue: 0,0:07:11.02,0:07:12.22,Main,,0,0,0,,Han mı işletiyorsun?!
Dialogue: 0,0:07:12.32,0:07:14.98,Main,,0,0,0,,Savunmadan sonra\Ndoğal olarak saldırı gelir!
Dialogue: 0,0:07:17.64,0:07:19.36,Main,,0,0,0,,Bir daha içeri almayacağım!
Dialogue: 0,0:07:19.56,0:07:21.72,Main,,0,0,0,,Başım sıkıştığında gene içeri al!
Dialogue: 0,0:07:22.04,0:07:23.96,Main,,0,0,0,,Amma taş kafalı çıktın!
Dialogue: 0,0:07:25.74,0:07:27.36,Main,,0,0,0,,Gösteririm ben sana!
Dialogue: 0,0:07:28.18,0:07:29.89,Main,,0,0,0,,Sahi ya?! Robin-senpai!
Dialogue: 0,0:07:37.90,0:07:40.77,Main,,0,0,0,,Oh be, bir şeyi yok!
Dialogue: 0,0:07:40.94,0:07:43.61,Thoughts,,0,0,0,,{\i1}Geliyorum Rebecca, dayan!{\i0}
Dialogue: 0,0:07:46.22,0:07:48.96,Main,,0,0,0,,Ne kurnaz biriymişsin sen, Nico Robin!
Dialogue: 0,0:07:49.56,0:07:54.14,Main,,0,0,0,,Üst düzey yöneticilere daha fazla\Nayakbağı olmana izin vermem!
Dialogue: 0,0:07:54.54,0:07:56.30,Main,,0,0,0,,{\fad(150,150)}Mancınık Patlaması!
Dialogue: 0,0:08:01.42,0:08:04.18,Main,,0,0,0,,{\fad(150,150)}Bariyer-yetenek Raket!
Dialogue: 0,0:08:13.22,0:08:15.28,Main,,0,0,0,,Bu ahmak hâlâ yaşıyor muymuş?!
Dialogue: 0,0:08:15.42,0:08:18.54,Main,,0,0,0,,Git hadi Robin-senpai!
Dialogue: 0,0:08:18.72,0:08:19.64,Thoughts,,0,0,0,,{\i1}Horoz-kun!{\i0}
Dialogue: 0,0:08:20.60,0:08:21.43,Thoughts,,0,0,0,,{\i1}Teşekkür ederim!{\i0}
Dialogue: 0,0:08:21.58,0:08:25.06,Main,,0,0,0,,Gözüyle işaret yaptı,\Nyani bana göz kırptı!
Dialogue: 0,0:08:27.68,0:08:30.58,Main,,0,0,0,,Bugün ölsem gam yemem be!
Dialogue: 0,0:08:30.68,0:08:36.76,Main,,0,0,0,,{\i1}O göz kırpma "Horoz-kun, çok iyi iş çıkarttın!"\N"İstersen kölem olabilirsin." mi demekti acaba?!{\i0}
Dialogue: 0,0:08:36.84,0:08:41.94,Main,,0,0,0,,{\i1}Yok canım sen de, fazla hayal\Nkuruyorsun Bartolomeo! Çok şey istiyorsun!{\i0}
Dialogue: 0,0:08:42.16,0:08:43.34,Main,,0,0,0,,Ama!
Dialogue: 0,0:08:43.48,0:08:46.37,Main,,0,0,0,,Acayip gaza geldim!
Dialogue: 0,0:08:51.86,0:08:53.88,Main,,0,0,0,,Cavendish, bariyerin içinde miydin?!
Dialogue: 0,0:08:54.04,0:08:55.88,Main,,0,0,0,,Yazık oldu Gladius!
Dialogue: 0,0:08:56.14,0:08:57.63,Main,,0,0,0,,{\fad(150,150)}Güzellik Kılıcı, Mavi...
Dialogue: 0,0:08:57.63,0:08:58.74,Main,,0,0,0,,{\fad(150,150)}Brakiyum...
Dialogue: 0,0:08:58.93,0:09:01.03,Main,,0,0,0,,Gladius-sama!
Dialogue: 0,0:09:09.88,0:09:11.12,Main,,0,0,0,,Bartolomeo!
Dialogue: 0,0:09:12.60,0:09:15.28,Main,,0,0,0,,{\fad(150,150)}Bariyer Boğaları!
Dialogue: 0,0:09:16.52,0:09:18.64,Main,,0,0,0,,Bariyer bize doğru hücum etti!
Dialogue: 0,0:09:18.76,0:09:25.66,Main,,0,0,0,,Robin-senpai, göz jestin\Nuğruna can vermeye değer bir şey!
Dialogue: 0,0:09:31.50,0:09:35.02,Main,,0,0,0,,Durdur şunu Bartolomeo!\NBen de buradayım!
Dialogue: 0,0:09:35.14,0:09:38.50,Main,,0,0,0,,Kusura bakma Kabak!\NAma durmamı engelleyen bir şey var!
Dialogue: 0,0:09:38.62,0:09:39.76,Main,,0,0,0,,Neymiş o?!
Dialogue: 0,0:09:40.34,0:09:42.00,Main,,0,0,0,,Acayip... {\alpha&HFF&}gaza geldim!
Dialogue: 0,0:09:42.00,0:09:43.82,Main,,0,0,0,,Acayip... gaza geldim!
Dialogue: 0,0:09:43.96,0:09:45.00,Main,,0,0,0,,Bana ne lan?!
Dialogue: 0,0:09:45.08,0:09:47.30,Main,,0,0,0,,Ne diyorsun sen be, lanet olası!\NDerhal durdur şunu!
Dialogue: 0,0:09:47.38,0:09:48.66,Main,,0,0,0,,Yapamam!
Dialogue: 0,0:09:51.24,0:09:52.08,Main,,0,0,0,,Dellinger!
Dialogue: 0,0:09:53.12,0:09:55.34,Main,,0,0,0,,İkinci seviyeyi temizlemedin mi daha?!
Dialogue: 0,0:09:55.50,0:09:58.04,Main,,0,0,0,,Gladius! Ne yapıyorsun orada?
Dialogue: 0,0:09:58.34,0:10:00.26,Main,,0,0,0,,Burası bitmek üzere!
Dialogue: 0,0:10:00.52,0:10:02.24,Main,,0,0,0,,Üçüncü seviyeye yardıma gel!
Dialogue: 0,0:10:02.66,0:10:04.72,Main,,0,0,0,,Nico Robin yukarı tırmanmaya çalışıyor!
Dialogue: 0,0:10:05.19,0:10:07.52,Main,,0,0,0,,Ben bu ikisiyle meşgulüm!
Dialogue: 0,0:10:08.38,0:10:10.96,Main,,0,0,0,,Ay peki!\NÇok eğlenceli görünüyor!
Dialogue: 0,0:10:13.36,0:10:15.72,Main,,0,0,0,,Dikkatli ol...
Dialogue: 0,0:10:18.10,0:10:19.44,Main,,0,0,0,,...demiştim sana!
Dialogue: 0,0:10:19.62,0:10:22.54,Main,,0,0,0,,Öf yahu, amma inatçı çıktın Uzunkol!
Dialogue: 0,0:10:25.91,0:10:30.68,Main,,0,0,0,,Omuzlarının üstündeki o şeyler\Ndaha en başta tuhaf gelmişlerdi.
Dialogue: 0,0:10:31.62,0:10:34.56,Main,,0,0,0,,Fakat şimdi karnına bir de delik açıldı.
Dialogue: 0,0:10:34.70,0:10:37.40,Main,,0,0,0,,Geberip gitsen diyorum, Şampiyon Savaşçı.
Dialogue: 0,0:10:37.64,0:10:39.29,Main,,0,0,0,,Onu yapamam işte.
Dialogue: 0,0:10:39.68,0:10:42.26,Main,,0,0,0,,Görev anlayışı ve minnet\Nerkeğin dünyasının temelidir!
Dialogue: 0,0:10:42.73,0:10:45.58,Main,,0,0,0,,Aksi taktirde\Nbenden öncekilerin yüzüne bakamam!
Dialogue: 0,0:10:46.32,0:10:47.88,Main,,0,0,0,,Ay böyle şeyler ağzına hiç yakışmıyor!
Dialogue: 0,0:10:48.84,0:10:52.06,Main,,0,0,0,,Ölü numarası falan yapsan\Ncanını bağışlayacaktım oysaki.
Dialogue: 0,0:10:53.38,0:10:55.98,Main,,0,0,0,,Ayağa kalkmak ne işine yarayacak?!
Dialogue: 0,0:10:58.28,0:11:01.36,Main,,0,0,0,,Zaman kazandırabilirim.
Dialogue: 0,0:11:02.18,0:11:05.46,Main,,0,0,0,,Hasır Şapka Doflamingo'yu yenene dek...
Dialogue: 0,0:11:05.78,0:11:08.70,Main,,0,0,0,,...araya girmenize müsaade etmeyeceğiz!
Dialogue: 0,0:11:08.82,0:11:10.68,Main,,0,0,0,,Hepimiz ortağız bu işte!
Dialogue: 0,0:11:11.48,0:11:15.98,Main,,0,0,0,,Bu dünyada hiç kimse\Nkendi başına zafer kazanamaz velet!
Dialogue: 0,0:11:20.78,0:11:23.94,Main,,0,0,0,,Hayatlarınızı feda ederek\Nzaferi hedefliyorsunuz demek?
Dialogue: 0,0:11:27.02,0:11:28.90,Main,,0,0,0,,Tam da kaybedenlerin\Nyapacağı türden bir şey!
Dialogue: 0,0:11:29.82,0:11:32.48,Main,,0,0,0,,Güçlü kişilerin\Nherhângi bir yükümlülüğü yoktur!
Dialogue: 0,0:12:05.96,0:12:08.74,Main,,0,0,0,,Ben de normal bir insan değilim.
Dialogue: 0,0:12:10.40,0:12:14.82,Main,,0,0,0,,Savaşçı Balık kökenimi hafife alma!
Dialogue: 0,0:12:26.34,0:12:28.12,Captions,,900,0,260,,{\fad(300,300)}3. Seviye
Dialogue: 0,0:12:33.32,0:12:36.32,Main,,0,0,0,,Gladius, geldim!
Dialogue: 0,0:12:36.88,0:12:38.24,Main,,0,0,0,,Neredesin?!
Dialogue: 0,0:12:43.64,0:12:45.34,Main,,0,0,0,,Gladius!
Dialogue: 0,0:12:45.80,0:12:48.52,Main,,0,0,0,,Dellinger, aşağı seviyede bekle!\NBurası tehlikeli!
Dialogue: 0,0:12:49.40,0:12:50.98,Main,,0,0,0,,Can sıkıcı bir düşmanımız var!
Dialogue: 0,0:12:52.86,0:12:54.46,Main,,0,0,0,,Ay bunu senden duymayı hiç beklemezdim!
Dialogue: 0,0:12:54.58,0:12:58.18,Main,,0,0,0,,Gladius, ikimiz beraberken\Ncan sıkıcı düşman diye bir şey{\fscx250}-{\r}
Dialogue: 0,0:13:07.92,0:13:08.88,Main,,0,0,0,,Dellinger!
Dialogue: 0,0:13:27.10,0:13:29.48,Main,,0,0,0,,Lanet olsun!\NDellinger...
Dialogue: 0,0:13:32.60,0:13:33.76,Main,,0,0,0,,Nasıl...
Dialogue: 0,0:13:33.98,0:13:35.58,Main,,0,0,0,,Ne oldu orada öyle?!
Dialogue: 0,0:13:35.84,0:13:40.24,Main,,0,0,0,,Boynuzlu velet de,\Nöteki düşman askerleri de, hepsi...
Dialogue: 0,0:13:41.02,0:13:42.84,Main,,0,0,0,,Hepsi yenildi!
Dialogue: 0,0:13:47.40,0:13:50.88,Main,,0,0,0,,Bariyerin dışında korkunç biri var!
Dialogue: 0,0:13:55.62,0:13:58.16,Main,,0,0,0,,Kim bu herif?!
Dialogue: 0,0:13:59.42,0:14:04.40,Main,,0,0,0,,Görünüşü Kabak'a benziyor\Nama yüzü bambaşka!
Dialogue: 0,0:14:14.84,0:14:20.38,Main,,0,0,0,,Aynı şey Kolezyum'da\ND Blok mücadelesinde de olmuştu!
Dialogue: 0,0:14:20.84,0:14:25.48,Flashbacks,,0,0,0,,İnanamıyorum!\NHerkes devrildi!
Dialogue: 0,0:14:33.94,0:14:36.76,Main,,0,0,0,,O mu yapmış?!
Dialogue: 0,0:14:36.96,0:14:40.00,Main,,0,0,0,,{\i1}Kıyafetler neresinden bakarsan bak \NCavendish'in.{\i0}
Dialogue: 0,0:14:40.40,0:14:43.18,Main,,0,0,0,,{\i1}Ama yüzü kesinlikle başka-bir-dish!{\i0}
Dialogue: 0,0:14:43.34,0:14:46.54,Main,,0,0,0,,{\i1}Ne tür bir-vendish bu?!{\i0}
Dialogue: 0,0:14:50.54,0:14:52.72,Main,,0,0,0,,Ödümü patlattı be!
Dialogue: 0,0:14:52.90,0:14:54.84,Main,,0,0,0,,Acayip hızlıydı, göremedim bile!
Dialogue: 0,0:14:55.70,0:15:01.66,Main,,0,0,0,,Ne kadar hızlı olursan ol\Nyeteneğim karşısında bir şey yapamazsın!
Dialogue: 0,0:15:01.82,0:15:03.98,Main,,0,0,0,,Ne yapıyorsun sen be?!
Dialogue: 0,0:15:04.14,0:15:07.50,Main,,0,0,0,,Ne oldu sana?!\NŞakanın şeyini çıkartmaya başladın...
Dialogue: 0,0:15:14.48,0:15:17.64,Main,,0,0,0,,Kime öyle dik dik baktın sen?!
Dialogue: 0,0:15:17.76,0:15:21.04,Main,,0,0,0,,Aptalca bir şey yapayım deme sakın!\NKime diyorum!?
Dialogue: 0,0:15:26.42,0:15:29.52,Main,,0,0,0,,Yapma!
Dialogue: 0,0:15:32.26,0:15:36.00,Main,,0,0,0,,Robin-senpai'nin peşinden gitme!
Dialogue: 0,0:15:53.10,0:15:55.30,Main,,0,0,0,,Benim karşımda hızın bir değeri yoktur.
Dialogue: 0,0:15:56.30,0:15:58.68,Main,,0,0,0,,Son görüştüğümüzden beri\Nepey şeytani bir görünüm kazanmışsın...
Dialogue: 0,0:15:59.36,0:16:01.78,Main,,0,0,0,,Kabak-kun, bir şey mi istemiştin?
Dialogue: 0,0:16:08.56,0:16:12.80,Main,,0,0,0,,Rebecca için endişeleniyorum\No yüzden acelem var.
Dialogue: 0,0:16:16.32,0:16:20.28,Main,,0,0,0,,Vay canına be, durdurdu!
Dialogue: 0,0:16:20.43,0:16:23.92,Main,,0,0,0,,Dobin-senpai!
Dialogue: 0,0:16:25.06,0:16:31.46,Main,,0,0,0,,{\i1}Ben de kalkmış bu ezik halimle\Nseni koruduğumu falan sanıyorum!{\i0}
Dialogue: 0,0:16:45.14,0:16:46.74,Main,,0,0,0,,Bekle, Hakuba!
Dialogue: 0,0:16:50.96,0:16:54.96,Main,,0,0,0,,Ortaya çıkmana izin vermedim!
Dialogue: 0,0:16:59.12,0:17:01.58,Main,,0,0,0,,Özür dilerim, Nico Robin.
Dialogue: 0,0:17:01.82,0:17:03.60,Main,,0,0,0,,Seni neredeyse kesiyordum.
Dialogue: 0,0:17:03.76,0:17:06.20,Main,,0,0,0,,Az önceki halin\Nşu çok konuşulan Hakuba'ydı demek?
Dialogue: 0,0:17:06.86,0:17:08.14,Main,,0,0,0,,İkinci kişiliğin...
Dialogue: 0,0:17:09.92,0:17:10.96,Main,,0,0,0,,Evet.
Dialogue: 0,0:17:12.96,0:17:14.66,Main,,0,0,0,,Çok can sıkıcı biridir.
Dialogue: 0,0:17:14.86,0:17:17.24,Main,,0,0,0,,Rastgele birilerine saldırır{\fscx250}-
Dialogue: 0,0:17:22.44,0:17:24.30,Main,,0,0,0,,Kol bacakla da kalmayacak...
Dialogue: 0,0:17:24.99,0:17:29.60,Main,,0,0,0,,Seni paramparça edeceğim, Nico Robin!
Dialogue: 0,0:17:30.33,0:17:32.62,Main,,0,0,0,,Her şeyi keseceğim!
Dialogue: 0,0:17:37.66,0:17:41.02,Main,,0,0,0,,Ortaya çıkıp durma, Hakuba!\NKontrolü ele almana izin vermem!
Dialogue: 0,0:17:42.70,0:17:45.82,Main,,0,0,0,,Kapa çeneni!\NUyumana devam et, Cavendish!
Dialogue: 0,0:17:46.30,0:17:49.16,Main,,0,0,0,,Bu savaşın ne anlama geldiğini bilmiyorsun!
Dialogue: 0,0:17:49.30,0:17:50.52,Main,,0,0,0,,Ben savaşacağım!
Dialogue: 0,0:17:51.06,0:17:53.16,Main,,0,0,0,,Her şeyi paramparça edeceğim!
Dialogue: 0,0:17:53.26,0:17:55.30,Main,,0,0,0,,Ben yapmazsam bir anlamı olmuyor!
Dialogue: 0,0:17:55.40,0:17:58.01,Main,,0,0,0,,Çok da umrumdaydı!\NEtrafı kan gölüne çevireceğim!
Dialogue: 0,0:17:58.10,0:18:02.36,Main,,0,0,0,,Bambaşka iki kişi konuşuyormuş gibi aynı!\NÇift kişilikli falan mı bu?!
Dialogue: 0,0:18:02.42,0:18:03.14,Main,,0,0,0,,Ben yapacağım!
Dialogue: 0,0:18:03.32,0:18:04.20,Main,,0,0,0,,Ben yapacağım ulan!
Dialogue: 0,0:18:04.48,0:18:05.55,Main,,0,0,0,,Ben yapacağım dedim!
Dialogue: 0,0:18:05.55,0:18:06.55,Main,,0,0,0,,Ben yapacağım!
Dialogue: 0,0:18:06.55,0:18:07.38,Main,,0,0,0,,Ben!
Dialogue: 0,0:18:07.76,0:18:09.85,Main,,0,0,0,,Ben ulan ben, ben!
Dialogue: 0,0:18:09.85,0:18:11.97,Main,,0,0,0,,Ben, ben, ben işte!
Dialogue: 0,0:18:12.10,0:18:12.68,Main,,0,0,0,,Ben ulan!
Dialogue: 0,0:18:12.68,0:18:13.24,Main,,0,0,0,,Ben!
Dialogue: 0,0:18:13.48,0:18:13.94,Main,,0,0,0,,Ben ulan!
Dialogue: 0,0:18:13.96,0:18:14.52,Main,,0,0,0,,Ben!
Dialogue: 0,0:18:14.78,0:18:15.35,Main,,0,0,0,,Ben ulan!
Dialogue: 0,0:18:15.35,0:18:15.98,Main,,0,0,0,,Ben!
Dialogue: 0,0:18:16.22,0:18:17.02,Main,,0,0,0,,Ben ulan!
Dialogue: 0,0:18:18.12,0:18:19.06,Main,,0,0,0,,Ben!
Dialogue: 0,0:18:18.12,0:18:19.06,Main,,0,0,0,,Ben ulan!
Dialogue: 0,0:18:19.20,0:18:22.22,Main,,0,0,0,,Yarısı başka yarısı başka oldu!
Dialogue: 0,0:18:25.04,0:18:26.62,Main,,0,0,0,,Kapa çeneni, Hakuba!
Dialogue: 0,0:18:28.48,0:18:30.98,Main,,0,0,0,,Tek Cavendish benim!
Dialogue: 0,0:18:31.56,0:18:34.46,Main,,0,0,0,,Daha az önce\Ndiğer yarın başkasıydı be!?
Dialogue: 0,0:18:37.10,0:18:40.28,Main,,0,0,0,,Tamam, artık bırakabilirsin Nico Robin...
Dialogue: 0,0:18:40.60,0:18:42.62,Main,,0,0,0,,Niye bırakmıyorsun?
Dialogue: 0,0:18:42.88,0:18:45.54,Main,,0,0,0,,Tüm bu olanlardan sonra\Nsana güvenmemi mi bekliyorsun?!
Dialogue: 0,0:18:50.12,0:18:50.78,Main,,0,0,0,,Ne?!
Dialogue: 0,0:18:51.52,0:18:53.84,Main,,0,0,0,,Hazır siz meşgulken\Nşu işe bir son vereyim artık.
Dialogue: 0,0:18:58.66,0:19:01.12,Main,,0,0,0,,O duvarla birlikte\Nikinizi de patlatacağım!
Dialogue: 0,0:19:02.22,0:19:04.62,Main,,0,0,0,,Uçarak bile\Nhiçbir yere kaçamazsınız!
Dialogue: 0,0:19:04.93,0:19:07.14,Main,,0,0,0,,Bunun sonunda\Ntek parça kalacağınızı sanmayın!
Dialogue: 0,0:19:09.86,0:19:11.34,Main,,0,0,0,,Şerefsiz!
Dialogue: 0,0:19:11.48,0:19:13.24,Main,,0,0,0,,Duvarla beraber bizi de patlatacak!
Dialogue: 0,0:19:14.70,0:19:17.18,Main,,0,0,0,,Aşağı inmeye bakalım, Nico Robin!
Dialogue: 0,0:19:17.34,0:19:21.34,Main,,0,0,0,,Olmaz! Biz zaman kaybederken\NRebecca'nın başına bir şey gelirse...
Dialogue: 0,0:19:21.46,0:19:23.40,Main,,0,0,0,,Bana bırakın!
Dialogue: 0,0:19:24.56,0:19:28.30,Main,,0,0,0,,Robin-senpai'nin kılına bile zarar vermene\Nmüsaade etmem!
Dialogue: 0,0:19:28.50,0:19:29.72,Main,,0,0,0,,Çok iyi düşünmüşsün.
Dialogue: 0,0:19:30.22,0:19:34.42,Main,,0,0,0,,Evet, beni yenebilirsen\Nduvar patlamayacak.
Dialogue: 0,0:19:36.96,0:19:38.64,Main,,0,0,0,,{\fad(150,150)}Punk Saç!
Dialogue: 0,0:19:48.46,0:19:50.16,Main,,0,0,0,,Ne oluyor?!\NHer tarafım uyuştu!
Dialogue: 0,0:19:50.96,0:19:52.70,Main,,0,0,0,,O saçlar zehirli iğnelerdi.
Dialogue: 0,0:19:52.83,0:19:53.39,Main,,0,0,0,,Ne?!
Dialogue: 0,0:19:53.39,0:19:54.46,Main,,0,0,0,,Bartolomeo!
Dialogue: 0,0:19:54.84,0:19:57.24,Main,,0,0,0,,Ben Pamu Pamu güç kullanıcısıyım.
Dialogue: 0,0:20:02.20,0:20:05.54,Main,,0,0,0,,Diğer bir deyişle kafadan tırnağa\Npatlayabilen bir insanım.
Dialogue: 0,0:20:09.67,0:20:12.66,Main,,0,0,0,,Bana bir şey yapacak olursan\Nvücudum patlayacak...
Dialogue: 0,0:20:13.72,0:20:17.42,Main,,0,0,0,,...ve sana saplananlar gibi\Nbinlerce zehirli iğne...
Dialogue: 0,0:20:18.04,0:20:20.18,Main,,0,0,0,,...şu ikisini delip geçecek!
Dialogue: 0,0:20:23.72,0:20:28.00,Main,,0,0,0,,Fakat beni yenmezsen de\Nduvarın patlayışına engel olamayacaksın.
Dialogue: 0,0:20:28.36,0:20:29.90,Main,,0,0,0,,Ne yapacaksın bakalım?
Dialogue: 0,0:20:30.22,0:20:34.70,Main,,0,0,0,,Tabii vücudumun patlayışı da\Nkurtulamayacağın kadar güçlü olacak.
Dialogue: 0,0:20:35.00,0:20:39.64,Main,,0,0,0,,Her iki türlü de\NRobin-senpai zarar görecek yani?!
Dialogue: 0,0:20:39.86,0:20:42.86,Main,,0,0,0,,Epey çabuk öğreniyorsun, Bartolomeo.
Dialogue: 0,0:20:44.18,0:20:46.14,Thoughts,,0,0,0,,{\i1}Düşün, Bartolomeo!{\i0}
Dialogue: 0,0:20:46.25,0:20:50.08,Thoughts,,0,0,0,,{\i1}Şu an korumam gereken\Nen önemli şey ne?!{\i0}
Dialogue: 0,0:20:51.76,0:20:53.32,Thoughts,,0,0,0,,{\i1}Düşünmeye bile gerek yok bunu!{\i0}
Dialogue: 0,0:20:53.84,0:20:55.90,Thoughts,,0,0,0,,{\i1}Robin-senpai'nin bedeni...{\i0}
Dialogue: 0,0:20:56.38,0:20:58.84,Thoughts,,0,0,0,,{\i1}Duvarın patlamasını engellemek için...
Dialogue: 0,0:20:59.16,0:21:01.64,Thoughts,,0,0,0,,{\i1}...şu kirpinin işini bitirmem lazım ama...
Dialogue: 0,0:21:03.08,0:21:07.08,Thoughts,,0,0,0,,{\i1}...o zaman da binlerce zehirli iğne\NRobin-senpai'ye saplanacak!{\i0}
Dialogue: 0,0:21:08.90,0:21:12.04,Thoughts,,0,0,0,,{\i1}Ne yapmalı peki? Düşün!{\i0}
Dialogue: 0,0:21:12.68,0:21:14.86,Thoughts,,0,0,0,,{\i1}Düşün Bartolomeo!{\i0}
Dialogue: 0,0:21:18.02,0:21:19.10,Main,,0,0,0,,Sahi ya!
Dialogue: 0,0:21:19.40,0:21:23.76,Main,,0,0,0,,{\i1}Robin-senpai'nin yanında\Nölse de umrumda olmayacak biri var!{\i0}
Dialogue: 0,0:21:24.17,0:21:28.64,Main,,0,0,0,,Bana bak Kabak!\NBen bu kirpiyi yenince...
Dialogue: 0,0:21:28.80,0:21:33.89,Main,,0,0,0,,...sen de vücudunla kalkan olup\NRobin-senpai'yi zehirli iğnelerden koru!
Dialogue: 0,0:21:34.78,0:21:35.64,Main,,0,0,0,,Lan...
Dialogue: 0,0:21:35.76,0:21:36.56,Main,,0,0,0,,Hey, Kabak!
Dialogue: 0,0:21:36.66,0:21:38.38,Main,,0,0,0,,Kapa çeneni, Horoz Kafa!
Dialogue: 0,0:21:38.58,0:21:41.16,Main,,0,0,0,,Kötü olan belirdi!
Dialogue: 0,0:21:41.34,0:21:44.58,Main,,0,0,0,,Böyle kritik bir anda bile\Nne işe yaramaz biri çıktı herif!
Dialogue: 0,0:21:47.77,0:21:50.70,Main,,0,0,0,,Robin-senpai dört yandan tehlike içerisinde!
Dialogue: 0,0:21:50.93,0:21:52.52,Main,,0,0,0,,Ne yapmalı?! Ne yapmalı?!
Dialogue: 0,0:21:54.62,0:21:55.82,Main,,0,0,0,,Sahi ya!
Dialogue: 0,0:22:11.94,0:22:13.71,Main,,0,0,0,,Saldıracak mısın, Bartolomeo?!
Dialogue: 0,0:22:13.86,0:22:16.42,Thoughts,,0,0,0,,{\i1}Bir seferde\Ntek bir bariyer yapabiliyorum!{\i0}
Dialogue: 0,0:22:17.50,0:22:20.08,Thoughts,,0,0,0,,{\i1}Biraz sıkıntı çıkartacak\Nama önemi yok!{\i0}
Dialogue: 0,0:22:24.22,0:22:29.46,Thoughts,,0,0,0,,{\i1}Robin-senpai, seni kurtarabildiğim müddetçe\Nhiçbir şeyden çekinmem!{\i0}
Dialogue: 0,0:22:32.52,0:22:34.46,Main,,0,0,0,,{\fad(150,150)}Bariyer Topu!
Dialogue: 0,0:22:34.80,0:22:37.54,Main,,0,0,0,,İstediğin kadar patla!
Dialogue: 0,0:22:37.72,0:22:40.76,Main,,0,0,0,,Kırılmaz bariyerimin içindeyiz!
Dialogue: 0,0:22:40.88,0:22:41.60,Main,,0,0,0,,Lanet olası...
Dialogue: 0,0:22:48.26,0:22:50.80,Main,,0,0,0,,Horoz-kun, yoksa...
Dialogue: 0,0:22:53.64,0:22:57.62,Main,,0,0,0,,Canını feda etmeyi\Ngöze alıyorsun demek, lanet olası!
Dialogue: 0,0:22:58.82,0:23:00.50,Main,,0,0,0,,{\fad(150,150)}Moda Punk!
Dialogue: 0,0:23:06.50,0:23:07.70,Main,,0,0,0,,Horoz-kun!
Dialogue: 0,0:23:08.22,0:23:11.36,Thoughts,,0,0,0,,{\i1}Adamı işte böyle yaparlar, kirpi!{\i0}
Dialogue: 0,0:23:11.80,0:23:16.00,Thoughts,,0,0,0,,{\i1}Duvarın patlamasını engelledim!{\i0}
Dialogue: 0,0:23:17.92,0:23:19.48,Thoughts,,0,0,0,,{\i1}Başardım!
Dialogue: 0,0:23:19.84,0:23:23.30,Thoughts,,0,0,0,,{\i1}Robin-senpai'yi korudum...
Dialogue: 0,0:23:32.40,0:23:34.76,Main,,0,0,0,,İyi denemeydi aptal herif...
Dialogue: 0,0:23:37.62,0:23:39.62,Main,,0,0,0,,Birkaç santimetreyle kaçırdın.
Dialogue: 0,0:23:40.52,0:23:44.71,Main,,0,0,0,,Boğazım yerine omzumu bıçakladın.
Dialogue: 0,0:23:45.72,0:23:47.42,Thoughts,,0,0,0,,{\i1}Hayati noktayı ıskaladım mı?!{\i0}
Dialogue: 0,0:23:47.70,0:23:51.94,Thoughts,,0,0,0,,{\i1}Şişmişti ve omzu mu boğazı mı\Nbelli olmuyordu ama...{\i0}
Dialogue: 0,0:23:52.27,0:23:53.76,Thoughts,,0,0,0,,{\i1}Lanet olsun!{\i0}
Dialogue: 0,0:23:54.30,0:23:58.40,Main,,0,0,0,,Sen de güç kullanıcısısın\No yüzden farkındasındır.
Dialogue: 0,0:23:59.70,0:24:01.80,Main,,0,0,0,,Bilincim yerinde olduğu müddetçe...
Dialogue: 0,0:24:04.65,0:24:07.06,Main,,0,0,0,,...duvarın patlaması durdurulamayacak!
Dialogue: 0,0:24:08.58,0:24:12.78,Main,,0,0,0,,Dostlarının havaya uçuşunu izle!
Dialogue: 0,0:24:12.94,0:24:17.76,Thoughts,,0,0,0,,{\i1}Kahretsin neden bu kadar aptalım?!{\i0}
Dialogue: 0,0:24:21.04,0:24:22.96,Main,,0,0,0,,Nico Robin, özür dilerim!
Dialogue: 0,0:24:23.54,0:24:25.06,Main,,0,0,0,,Hakuba kontrol altında,...
Dialogue: 0,0:24:25.32,0:24:27.12,Main,,0,0,0,,...şu anda Cavendish'im!
Dialogue: 0,0:24:27.72,0:24:30.36,Main,,0,0,0,,Ama yarımı Hakuba'ya teslim ettim.
Dialogue: 0,0:24:30.82,0:24:34.04,Main,,0,0,0,,Bırak beni!\NSeni öldüreceğim!
Dialogue: 0,0:24:34.98,0:24:38.52,Main,,0,0,0,,Hakuba'nın hızıyla Ayçiçeği Bahçesi'ne\Nkaçmanı sağlayacağım!
Dialogue: 0,0:24:38.88,0:24:41.02,Main,,0,0,0,,Hakuba'nın gücünü kullanacağım!
Dialogue: 0,0:24:41.42,0:24:43.98,Main,,0,0,0,,Başka seçeneğimiz yok, bırak beni!
Dialogue: 0,0:24:44.22,0:24:45.81,Main,,0,0,0,,Güven bana!
Dialogue: 0,0:24:46.98,0:24:47.84,Thoughts,,0,0,0,,{\i1}İnanmalı mıyım?!{\i0}
Dialogue: 0,0:24:48.00,0:24:49.61,Main,,0,0,0,,Kaybedecek zaman yok!
Dialogue: 0,0:24:50.30,0:24:51.28,Main,,0,0,0,,Acele et!
Dialogue: 0,0:24:52.14,0:24:53.74,Main,,0,0,0,,Ya-Yapma!
Dialogue: 0,0:24:53.82,0:24:54.82,Main,,0,0,0,,{\fad(150,150)}Punk Rock...
Dialogue: 0,0:24:59.16,0:25:00.86,Main,,0,0,0,,{\fad(150,150)}...Süper Arena!
Dialogue: 0,0:25:05.08,0:25:08.16,Main,,0,0,0,,Robin-senpai!
Dialogue: 0,0:25:11.48,0:25:14.16,Main,,0,0,0,,Bu bariyer işini sevdim...
Dialogue: 0,0:25:23.12,0:25:24.41,Main,,0,0,0,,Bak.
Dialogue: 0,0:25:25.56,0:25:27.76,Main,,0,0,0,,İkisi de tek bir iz bile bırakmadan...
Dialogue: 0,0:25:28.00,0:25:28.74,Main,,0,0,0,,Ne?!
Dialogue: 0,0:25:33.26,0:25:34.76,Main,,0,0,0,,Beni neden engelledin?!
Dialogue: 0,0:25:35.04,0:25:36.96,Main,,0,0,0,,Kendi vücudun bu be!
Dialogue: 0,0:25:37.92,0:25:40.10,Main,,0,0,0,,Öyleyse ara sıra...
Dialogue: 0,0:25:40.52,0:25:43.08,Main,,0,0,0,,...sözümü dinle!
Dialogue: 0,0:25:45.82,0:25:48.64,Main,,0,0,0,,{\fad(150,150)}Cien Fleur! Spider Net!
Dialogue: 0,0:25:45.82,0:25:48.64,Note,,0,0,0,,{\fad(150,150)}Yüz Çiçek! Örümcek Ağı!
Dialogue: 0,0:25:55.00,0:25:58.74,Main,,0,0,0,,Hakuba'nın kılıcını\Nsen durdurdun değil mi, Kabak-kun?
Dialogue: 0,0:26:00.60,0:26:02.04,Main,,0,0,0,,Ne karmaşık biri.
Dialogue: 0,0:26:04.40,0:26:05.56,Main,,0,0,0,,İmkansız!
Dialogue: 0,0:26:05.86,0:26:08.18,Main,,0,0,0,,O patlamadan nasıl kaçarlar?!
Dialogue: 0,0:26:14.00,0:26:18.28,Thoughts,,0,0,0,,{\i1}Ona kıyasla şu halime bir bak!{\i0}
Dialogue: 0,0:26:19.82,0:26:21.60,Main,,0,0,0,,{\fad(150,150)}Kutsal Saygı Yumruğu!
Dialogue: 0,0:26:24.96,0:26:26.44,Thoughts,,0,0,0,,{\i1}Luffy-senpai...{\i0}
Dialogue: 0,0:26:26.76,0:26:32.39,Thoughts,,0,0,0,,{\i1}...güçlerim şu anda yeterli\Nolmasalar da daha da güçleneceğim ve...{\i0}
Dialogue: 0,0:26:32.86,0:26:35.04,Main,,0,0,0,,{\fad(150,150)}Bari Bari no...
Dialogue: 0,0:26:40.66,0:26:42.54,Thoughts,,0,0,0,,{\i1}...eminim günün birinde...{\i0}
Dialogue: 0,0:26:42.88,0:26:48.49,Thoughts,,0,0,0,,{\i1}...sana yardımı dokunabilecek\Nbir adam olacağım!{\i0}
Dialogue: 0,0:26:50.92,0:26:53.52,Main,,0,0,0,,{\fad(150,150)}...Tabanca!
Dialogue: 0,0:27:09.91,0:27:13.89,Main,,0,0,0,,Senpaimin gücüyle zor bela yendim...
Dialogue: 0,0:27:15.64,0:27:19.76,Main,,0,0,0,,Ama öyle baş belası bir adamla...
Dialogue: 0,0:27:19.96,0:27:22.12,Main,,0,0,0,,...bir daha asla takım olmam!
Dialogue: 0,0:27:24.62,0:27:28.00,Captions,,0,0,335,,{\fad(300,300)}4. Seviye\NAyçiçeği Tarlası
Dialogue: 0,0:27:30.40,0:27:32.74,Main,,0,0,0,,Aşağısı epey gürültülü!
Dialogue: 0,0:27:33.28,0:27:35.58,Main,,0,0,0,,Böylesine dengesiz bir savaş alanında...
Dialogue: 0,0:27:35.68,0:27:39.78,Main,,0,0,0,,...kolezyumun savaşçısı bile\Ndengesini koruyamaz düşer!
Dialogue: 0,0:27:40.06,0:27:42.16,Main,,0,0,0,,Değil mi Rebecca'cığım?!
Dialogue: 0,0:27:42.72,0:27:44.76,Main,,0,0,0,,{\fad(150,150)}Vipera Glaive!
Dialogue: 0,0:27:42.72,0:27:44.76,Note,,0,0,0,,{\fad(150,150)}Yılan Kılıcı
Dialogue: 0,0:27:44.92,0:27:48.74,Main,,0,0,0,,Yapma!\NKaç Rebecca! Ondan kendini koruyamazsın!
Dialogue: 0,0:27:50.14,0:27:52.10,Main,,0,0,0,,Saldırı yansıtıcı kelebek çiçekleri!
Dialogue: 0,0:27:52.22,0:27:53.26,Main,,0,0,0,,{\fad(150,150)}Mil Fleur!
Dialogue: 0,0:27:52.22,0:27:53.26,Note,,0,0,0,,{\fad(150,150)}Bin Çiçek!
Dialogue: 0,0:27:57.76,0:27:58.84,Main,,0,0,0,,{\fad(150,150)}Orkide Kelebekler!
Dialogue: 0,0:28:00.02,0:28:01.08,Main,,0,0,0,,Robin-san!
Dialogue: 0,0:28:02.26,0:28:03.14,Main,,0,0,0,,Bu kadın...
Dialogue: 0,0:28:03.30,0:28:04.30,Main,,0,0,0,,Robiland!
Dialogue: 0,0:28:04.88,0:28:08.26,Main,,0,0,0,,Görevin tamamlandı, Rebecca.
Dialogue: 0,0:28:09.64,0:28:11.86,Main,,0,0,0,,Anahtarı ulaştırdığın için\Nteşekkür ederim.
Dialogue: 0,0:28:12.26,0:28:14.62,Main,,0,0,0,,Bundan böyle\Nseni ben koruyacağım!
Dialogue: 0,0:28:15.95,0:28:20.00,OP11 Credits,,0,0,0,,Editing:\N Galaxy 9000\N\NTiming:\N Datenshi,\NSewil (Opening)\N\NQuality Assurance:\N Mr Luffy,\NGalaxy 9000,\NGrug,\NDatenshi\N\NSoundtracking:\N Halee\N\NTC/Infoboxes:\N Datenshi\N\NTranslation:\NYibis
