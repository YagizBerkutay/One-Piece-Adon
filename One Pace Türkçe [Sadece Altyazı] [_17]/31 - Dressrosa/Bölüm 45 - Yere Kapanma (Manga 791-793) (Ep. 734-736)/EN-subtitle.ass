69,0:01:31.37,Romaji - OP18 Styleı,,0,0,0,fx,kDialogue: 1,0:01:29.69,0:01:31.37,Romaji - OP18 Styleı,,0,0,0,fx,oDialogue: 1,0:01:29.71,0:01:31.37,Romaji - OP18 Styleı,,0,0,0,fx,nDialogue: 1,0:01:29.76,0:01:31.37,Romaji - OP18 Styleı,,0,0,0,fx,cDialogue: 1,0:01:29.77,0:01:31.37,Romaji - OP18 Styleı,,0,0,0,fx,Dialogue: 1,0:01:29.79,0:01:31.37,Romaji - OP18 Styleı,,0,0,0,fx,kDialogue: 1,0:01:29.84,0:01:31.67,Romaji - OP18 Styleı,,0,0,0,fx,dDialogue: 1,0:01:29.86,0:01:31.67,Romaji - OP18 Styleı,,0,0,0,fx,aDialogue: 1,0:01:29.86,0:01:31.67,Romaji - OP18 Styleı,,0,0,0,fx,yDialogue: 0,0:01:29.86,0:01:34.65,English - OP18,,0,0,0,,and keep on going through the hard knock days.Dialogue: 1,0:01:29.86,0:01:31.67,Romaji - OP18 Styleı,,0,0,0,fx,sDialogue: 2,0:01:30.06,0:01:30.40,Romaji - OP18 Styleı,,0,0,0,fx,suDialogue: 2,0:01:30.06,0:01:30.56,Romaji - OP18 Styleı,,0,0,0,fx,suDialogue: 2,0:01:30.31,0:01:30.65,Romaji - OP18 Styleı,,0,0,0,fx,muDialogue: 2,0:01:30.56,0:01:30.94,Romaji - OP18 Styleı,,0,0,0,fx,beDialogue: 2,0:01:30.65,0:01:31.19,Romaji - OP18 Styleı,,0,0,0,fx,kiDialogue: 2,0:01:30.94,0:01:31.67,Romaji - OP18 Styleı,,0,0,0,fx,hardDialogue: 2,0:01:31.37,0:01:31.98,Romaji - OP18 Styleı,,0,0,0,fx,knockDialogue: 2,0:01:31.67,0:01:34.65,Romaji - OP18 Styleı,,0,0,0,fx,daysDialogue: 0,0:01:52.40,0:01:57.26,Title,,0,0,240,,ProstrationDialogue: 0,0:03:27.25,0:03:28.14,Main,,0,0,0,,Room!Dialogue: 0,0:03:28.96,0:03:29.90,Main,,0,0,0,,Chambres!Dialogue: 0,0:03:33.03,0:03:35.10,Main,,0,0,0,,Oh! He's been saved!Dialogue: 0,0:03:36.04,0:03:37.02,Main,,0,0,0,,Lucy!Dialogue: 0,0:03:42.95,0:03:48.75,Captions,,0,0,340,,Underground Trading Port DockDialogue: 0,0:04:05.14,0:04:07.65,Main,,0,0,0,,Look! Nobody's up there now!Dialogue: 0,0:04:08.70,0:04:09.92,Main,,0,0,0,,How did it go?!Dialogue: 0,0:04:10.28,0:04:12.21,Main,,0,0,0,,What just happened?Dialogue: 0,0:04:12.21,0:04:14.12,Main,,0,0,0,,Tell us, Gatz!Dialogue: 0,0:04:17.10,0:04:18.14,Main,,0,0,0,,Gatz-san!Dialogue: 0,0:04:18.92,0:04:21.26,Main,,0,0,0,,You can't yell anymore!Dialogue: 0,0:04:21.62,0:04:22.94,Main,,0,0,0,,Don't push yourself!Dialogue: 0,0:04:23.68,0:04:24.82,Main,,0,0,0,,You fools!Dialogue: 0,0:04:27.18,0:04:31.58,Main,,0,0,0,,What kind of announcer am I if I can't announce the winner and the loser?Dialogue: 0,0:04:34.60,0:04:36.30,Main,,0,0,0,,Look, you two!Dialogue: 0,0:04:37.68,0:04:40.54,Main,,0,0,0,,Look to the sky, Dressrosa!Dialogue: 0,0:05:16.36,0:05:18.00,Main,,0,0,0,,Which is fading?Dialogue: 0,0:05:18.60,0:05:19.90,Main,,0,0,0,,The bird cage?Dialogue: 0,0:05:20.76,0:05:24.98,Main,,0,0,0,,Or Doflamingo's domination?Dialogue: 0,0:06:03.50,0:06:04.50,Main,,0,0,0,,The factory just...Dialogue: 0,0:06:23.82,0:06:25.48,Main,,0,0,0,,The bird cage is...Dialogue: 0,0:06:36.68,0:06:38.18,Main,,0,0,0,,The strings...Dialogue: 0,0:06:39.66,0:06:40.88,Main,,0,0,0,,Are gone!Dialogue: 0,0:06:46.50,0:06:48.87,Main,,0,0,0,,I can see the sky! The sky!Dialogue: 0,0:06:48.87,0:06:51.42,Main,,0,0,0,,The sky!Dialogue: 0,0:06:55.64,0:06:59.36,Main,,0,0,0,,I-Is the scenery outside of the cage...Dialogue: 0,0:07:00.02,0:07:02.84,Main,,0,0,0,,a town that's been carved into pieces?Dialogue: 0,0:07:03.22,0:07:04.76,Main,,0,0,0,,Or is it...Dialogue: 0,0:07:05.24,0:07:10.92,Main,,0,0,0,,a land where no one will manipulate us anymore - a land of freedom?Dialogue: 0,0:07:16.00,0:07:18.20,Main,,0,0,0,,The bird cage's gone!Dialogue: 0,0:07:19.72,0:07:21.30,Main,,0,0,0,,That means...Dialogue: 0,0:07:23.58,0:07:26.62,Main,,0,0,0,,The "Great Defense of Dressrosa"!Dialogue: 0,0:07:27.61,0:07:32.09,Main,,0,0,0,,The two thousand pirates of the Donquixote Family...Dialogue: 0,0:07:32.09,0:07:33.24,Main,,0,0,0,,versusDialogue: 0,0:07:34.10,0:07:38.48,Main,,0,0,0,,the fated warriors, here by coincidence!Dialogue: 0,0:07:53.80,0:07:56.40,Main,,0,0,0,,And the duel between their leaders!Dialogue: 0,0:07:56.88,0:08:01.58,Main,,0,0,0,,Royal Warlord of the Sea, Donquixote Doflamingo...Dialogue: 0,0:08:01.58,0:08:02.85,Main,,0,0,0,,versusDialogue: 0,0:08:02.85,0:08:06.76,Main,,0,0,0,,the gladiator, Lucy!Dialogue: 0,0:08:10.70,0:08:13.44,Main,,0,0,0,,Dah winnah...Dialogue: 0,0:08:16.02,0:08:17.22,Main,,0,0,0,,What?Dialogue: 0,0:08:17.22,0:08:19.24,Main,,0,0,0,,Dah winnah...Dialogue: 0,0:08:19.78,0:08:21.29,Main,,0,0,0,,What's he saying?Dialogue: 0,0:08:21.29,0:08:22.61,Main,,0,0,0,,It's "the winner"!Dialogue: 0,0:08:22.61,0:08:25.68,Main,,0,0,0,,Dah winnah ish...Dialogue: 0,0:08:25.68,0:08:28.14,Main,,0,0,0,,You can do it, Gatz-san!Dialogue: 0,0:08:29.81,0:08:31.77,Main,,0,0,0,,Dah winnah...Dialogue: 0,0:08:31.77,0:08:33.85,Main,,0,0,0,,Stay with us, Gatz!Dialogue: 0,0:08:38.10,0:08:39.58,Main,,0,0,0,,Who's there?!Dialogue: 0,0:08:40.94,0:08:44.28,Main,,0,0,0,,Don't shout. Don't call for anyone.Dialogue: 0,0:08:46.00,0:08:49.40,Main,,0,0,0,,I am Donquixote Doflamingo.Dialogue: 0,0:08:51.54,0:08:54.18,Main,,0,0,0,,I am the rightful king of this kingdom.Dialogue: 0,0:08:54.18,0:08:57.79,Main,,0,0,0,,The king has returned!Dialogue: 0,0:08:57.79,0:09:00.08,Main,,0,0,0,,Is it something we did?Dialogue: 0,0:09:00.96,0:09:03.83,Main,,0,0,0,,There is no excuse for this.Dialogue: 0,0:09:03.83,0:09:06.52,Main,,0,0,0,,The country is done for!Dialogue: 0,0:09:06.92,0:09:10.82,Main,,0,0,0,,This was Doflamingo's trap!Dialogue: 0,0:09:12.02,0:09:14.12,Main,,0,0,0,,Dah winnah...Dialogue: 0,0:09:14.12,0:09:15.79,Main,,0,0,0,,Get a grip already!Dialogue: 0,0:09:15.79,0:09:17.54,Main,,0,0,0,,Speak clearly!Dialogue: 0,0:09:27.08,0:09:28.44,Flashbacks,,0,0,0,,Listen, Rebecca.Dialogue: 0,0:09:28.76,0:09:30.06,Flashbacks,,0,0,0,,Don't cry yet.Dialogue: 0,0:09:30.44,0:09:32.07,Flashbacks,,0,0,0,,I won't let the soldier die.Dialogue: 0,0:09:32.07,0:09:33.44,Flashbacks,,0,0,0,,Make sure you stay safe.Dialogue: 0,0:09:33.94,0:09:37.58,Flashbacks,,0,0,0,,I'm gonna beat the crap outta Doflamingo!Dialogue: 0,0:09:40.14,0:09:41.84,Main,,0,0,0,,Lucy...Dialogue: 0,0:09:45.68,0:09:48.33,Main,,0,0,0,,The winner is...Dialogue: 0,0:09:51.48,0:09:54.78,Main,,0,0,0,,...Lucy!Dialogue: 0,0:09:58.16,0:09:59.82,Main,,0,0,0,,Lucy!Dialogue: 0,0:10:00.68,0:10:02.66,Main,,0,0,0,,Thank you, Lucy!Dialogue: 0,0:10:05.78,0:10:07.86,Main,,0,0,0,,This is the best!Dialogue: 0,0:10:07.86,0:10:10.01,Main,,0,0,0,,He did it!Dialogue: 0,0:10:10.01,0:10:11.92,Main,,0,0,0,,Super!Dialogue: 0,0:10:11.56,0:10:13.73,Main,,0,0,0,,Luffyland!Dialogue: 0,0:10:13.73,0:10:15.50,Main,,0,0,0,,Luffy!Dialogue: 0,0:10:22.24,0:10:24.15,Main,,0,0,0,,Robiland!Dialogue: 0,0:10:24.15,0:10:26.44,Main,,0,0,0,,Luffy!Dialogue: 0,0:10:26.44,0:10:29.29,Main,,0,0,0,,He finally did it!Dialogue: 0,0:10:40.14,0:10:41.91,Main,,0,0,0,,Well done, my boy!Dialogue: 0,0:10:41.91,0:10:43.61,Main,,0,0,0,,Truly incredible!Dialogue: 0,0:10:43.61,0:10:45.27,Main,,0,0,0,,Expect nothing less of Luffy-dono!Dialogue: 0,0:10:51.14,0:10:52.06,Main,,0,0,0,,Princess!Dialogue: 0,0:10:52.50,0:10:53.96,Main,,0,0,0,,I'm so glad!Dialogue: 0,0:10:54.36,0:10:57.00,Main,,0,0,0,,Fraland!Dialogue: 0,0:10:57.96,0:11:01.02,Main,,0,0,0,,All of you did great, too!Dialogue: 0,0:11:01.02,0:11:02.62,Main,,0,0,0,,You're hurting us!Dialogue: 0,0:11:05.82,0:11:09.93,Flashbacks,,0,0,0,,We toys were once human!Dialogue: 0,0:11:09.93,0:11:11.52,Flashbacks,,0,0,0,,Captain!Dialogue: 0,0:11:11.52,0:11:13.74,Flashbacks,,0,0,0,,They will fight alongside us.Dialogue: 0,0:11:14.24,0:11:16.71,Flashbacks,,0,0,0,,They are the dwarfs of the Tontatta Kingdom.Dialogue: 0,0:11:19.44,0:11:21.76,Flashbacks,,0,0,0,,Are you really sure about leaving her?Dialogue: 0,0:11:21.76,0:11:23.75,Flashbacks,,0,0,0,,She was crying!Dialogue: 0,0:11:23.75,0:11:27.44,Flashbacks,,0,0,0,,Even toys have something they want to protect!Dialogue: 0,0:11:27.98,0:11:32.00,Flashbacks,,0,0,0,,Although these tin eyes of mine cannot shed tears.Dialogue: 0,0:11:32.00,0:11:38.44,Flashbacks,,0,0,0,,That's why the captain has been fighting on his own for ten years.Dialogue: 0,0:11:51.44,0:11:55.42,Flashbacks,,0,0,0,,What have you done to this country and the king, pirate?!Dialogue: 0,0:11:56.30,0:11:59.86,Flashbacks,,0,0,0,,The king set the city ablaze. Didn't you see him?Dialogue: 0,0:11:59.86,0:12:01.96,Flashbacks,,0,0,0,,His Majesty would never do such a thing!Dialogue: 0,0:12:02.72,0:12:08.62,Flashbacks,,0,0,0,,This battle is to restore the honor of King Riku who was dethroned in shame ten years ago,Dialogue: 0,0:12:09.16,0:12:12.44,Flashbacks,,0,0,0,,and to regain our freedom!Dialogue: 0,0:12:25.58,0:12:28.94,Flashbacks,,0,0,0,,Soldier-san!Dialogue: 0,0:12:28.94,0:12:30.93,Flashbacks,,0,0,0,,I will not let you take...Dialogue: 0,0:12:30.93,0:12:33.34,Flashbacks,,0,0,0,,another member of my family from me!Dialogue: 0,0:12:48.96,0:12:53.26,Narrator,,0,0,0,,A country in ruins needn't necessarily be unhappy.Dialogue: 0,0:12:53.98,0:12:57.60,Narrator,,0,0,0,,On this day, amid piles of rubble, the people of this very country...Dialogue: 0,0:12:57.60,0:13:00.80,Narrator,,0,0,0,,cried out in joy.Dialogue: 0,0:13:08.00,0:13:09.32,Main,,0,0,0,,Hooray!Dialogue: 0,0:13:09.32,0:13:11.72,Main,,0,0,0,,Doflamingo was taken down!Dialogue: 0,0:13:11.72,0:13:13.99,Main,,0,0,0,,We're free from now on!Dialogue: 0,0:13:13.99,0:13:15.82,Main,,0,0,0,,Mom! Dad!Dialogue: 0,0:13:15.82,0:13:16.68,Main,,0,0,0,,Thank God!Dialogue: 0,0:13:21.76,0:13:23.08,Main,,0,0,0,,Gatz-san!Dialogue: 0,0:13:23.08,0:13:25.82,Main,,0,0,0,,Yeah, he did it!Dialogue: 0,0:13:37.20,0:13:40.55,Main,,0,0,0,,So aren't you gonna finish me off?Dialogue: 0,0:13:40.55,0:13:41.64,Main,,0,0,0,,Don't need to.Dialogue: 0,0:13:42.84,0:13:44.78,Main,,0,0,0,,Seems like it's all over.Dialogue: 0,0:13:49.40,0:13:52.68,Main,,0,0,0,,You brothers are too soft!Dialogue: 0,0:14:02.90,0:14:07.62,Main,,0,0,0,,After losing to our captain at Banaro Island,Dialogue: 0,0:14:07.62,0:14:11.04,Main,,0,0,0,,Ace had something to say before he was handed over to the Navy.Dialogue: 0,0:14:11.04,0:14:12.56,Main,,0,0,0,,Wanna hear it?Dialogue: 0,0:14:14.58,0:14:19.25,Captions,,970,0,295,,Underground PortDialogue: 0,0:14:15.46,0:14:19.20,Main,,0,0,0,,Hey, hurry up! The duel between Straw Hat and Doflamingo is over!Dialogue: 0,0:14:19.52,0:14:21.37,Main,,0,0,0,,The Navy'll be here soon!Dialogue: 0,0:14:21.37,0:14:22.62,Main,,0,0,0,,We know!Dialogue: 0,0:14:22.98,0:14:24.47,Main,,0,0,0,,You call the chief yet?Dialogue: 0,0:14:24.47,0:14:25.96,Main,,0,0,0,,We're trying!Dialogue: 0,0:14:27.86,0:14:29.66,Main,,0,0,0,,He's not picking up.Dialogue: 0,0:14:29.66,0:14:31.86,Main,,0,0,0,,He only answers when he feels like it.Dialogue: 0,0:14:35.64,0:14:38.12,Main,,0,0,0,,You'll get a kick outta hearin' it!Dialogue: 0,0:14:44.96,0:14:50.50,Main,,0,0,0,,He realized he was gonna be executed, so he said...Dialogue: 0,0:14:54.26,0:14:57.18,Thoughts,,0,0,0,,Don't tell my brother.Dialogue: 0,0:15:03.48,0:15:05.24,Main,,0,0,0,,Man, what an idiot!Dialogue: 0,0:15:05.24,0:15:08.42,Main,,0,0,0,,He had no idea how much he was worth!Dialogue: 0,0:15:10.04,0:15:15.83,Main,,0,0,0,,If Fire Fist Ace was captured by the Navy, the news would spread all over the world!Dialogue: 0,0:15:15.83,0:15:19.80,Main,,0,0,0,,The Navy would make 120% use of his pathetic life-Dialogue: 0,0:15:26.42,0:15:27.68,Main,,0,0,0,,That's quite enough.Dialogue: 0,0:15:29.20,0:15:30.58,Main,,0,0,0,,Stop talking.Dialogue: 0,0:15:34.48,0:15:38.38,Main,,0,0,0,,How he felt when he passed away...Dialogue: 0,0:15:39.53,0:15:40.18,Captions,,0,0,0,,Fire Fist Ace DiesDialogue: 0,0:15:43.10,0:15:47.46,Main,,0,0,0,,I've thought about it non-stop since that day, every single night.Dialogue: 0,0:15:49.58,0:15:52.79,Main,,0,0,0,,You don't have to tell me. I fully understand!Dialogue: 0,0:15:59.64,0:16:02.06,Main,,0,0,0,,Then let it sink in, fool!Dialogue: 0,0:16:02.55,0:16:05.85,Thoughts,,0,0,0,,As for that Devil Fruit you have...Dialogue: 0,0:16:05.85,0:16:10.20,Thoughts,,0,0,0,,If I can't steal it here, it'll damage my reputation as a hunter of Devil Fruit users.Dialogue: 0,0:16:10.60,0:16:13.90,Thoughts,,0,0,0,,You're not getting away from me, Flame Fruit!Dialogue: 0,0:16:14.36,0:16:17.26,Main,,0,0,0,,You're regretting it, aren't you?!Dialogue: 0,0:16:17.26,0:16:20.34,Main,,0,0,0,,Even though you had the title and the power,Dialogue: 0,0:16:20.34,0:16:23.22,Main,,0,0,0,,you still didn't try to save your brother!Dialogue: 0,0:16:23.22,0:16:26.62,Main,,0,0,0,,You weren't there at all, were you?!Dialogue: 0,0:16:26.62,0:16:29.26,Main,,0,0,0,,Were you taking a nap or something?Dialogue: 0,0:16:30.76,0:16:33.39,Main,,0,0,0,,You weren't there when he needed you most.Dialogue: 0,0:16:33.39,0:16:36.32,Main,,0,0,0,,And you call yourselves brothers!Dialogue: 0,0:16:41.16,0:16:43.70,Main,,0,0,0,,I'm done regretting it!Dialogue: 0,0:16:47.40,0:16:49.00,Main,,0,0,0,,Fire Fist!Dialogue: 0,0:16:49.36,0:16:50.54,Main,,0,0,0,,Dammit!Dialogue: 0,0:17:13.26,0:17:17.55,Main,,0,0,0,,I've made peace with it, but Ace is saying he can't forgive you.Dialogue: 0,0:17:26.10,0:17:28.15,Main,,0,0,0,,Oh! Hello, Sabo-kun?Dialogue: 0,0:17:28.15,0:17:30.14,Main,,0,0,0,,Where in the world are you?!Dialogue: 0,0:17:30.14,0:17:32.75,Main,,0,0,0,,I saw Burgess going after Luffy-kun earlier,Dialogue: 0,0:17:32.75,0:17:37.02,Main,,0,0,0,,so I frantically tried to contact you, but you weren't answering at all!Dialogue: 0,0:17:37.50,0:17:39.29,Main,,0,0,0,,That so? I wasn't paying attention.Dialogue: 0,0:17:39.29,0:17:40.19,Main,,0,0,0,,You weren't what?!Dialogue: 0,0:17:40.19,0:17:42.42,Main,,0,0,0,,Don't worry, I took care of it already.Dialogue: 0,0:17:44.08,0:17:47.03,Main,,0,0,0,,That aside, Koala, have you found the list?Dialogue: 0,0:17:47.03,0:17:48.59,Main,,0,0,0,,For crying out... Yes, I found it!Dialogue: 0,0:17:48.59,0:17:50.27,Main,,0,0,0,,Then just call the ship and-Dialogue: 0,0:17:50.27,0:17:51.26,Main,,0,0,0,,I called it!Dialogue: 0,0:17:51.26,0:17:53.83,Main,,0,0,0,,Well, let's meet up with Hack underground then.Dialogue: 0,0:17:53.83,0:17:56.34,Main,,0,0,0,,I'm with Hack and everyone else underground!Dialogue: 0,0:18:06.66,0:18:08.83,Main,,0,0,0,,Why did he hang up?! That selfish jerk!Dialogue: 0,0:18:08.83,0:18:11.16,Main,,0,0,0,,Stop taking it out on me, Koala-san!Dialogue: 0,0:18:22.51,0:18:23.38,Main,,0,0,0,,There he is!Dialogue: 0,0:18:27.06,0:18:28.53,Main,,0,0,0,,The Donquixote Family!Dialogue: 0,0:18:43.74,0:18:45.96,Main,,0,0,0,,Their eight commanders and...Dialogue: 0,0:18:52.78,0:18:55.18,Main,,0,0,0,,...three top commanders are all accounted for!Dialogue: 0,0:18:58.51,0:18:59.53,Main,,0,0,0,,Watch out!Dialogue: 0,0:19:00.52,0:19:03.06,Main,,0,0,0,,Most of the commanders are Devil Fruit users!Dialogue: 0,0:19:06.26,0:19:08.68,Main,,0,0,0,,Secure them with Sea Stone!Dialogue: 0,0:19:09.04,0:19:09.58,Main,,0,0,0,,Yes, sir!Dialogue: 0,0:19:17.10,0:19:19.06,Main,,0,0,0,,Just stay here with me.Dialogue: 0,0:19:19.82,0:19:20.40,Main,,0,0,0,,Yes.Dialogue: 0,0:19:22.76,0:19:25.06,Secondary,,0,0,0,,Whoa! Wh-What're you doing?!Dialogue: 0,0:19:23.56,0:19:25.37,Main,,0,0,0,,You said, "Stay here with me"!Dialogue: 0,0:19:25.37,0:19:27.38,Main,,0,0,0,,So we'll be together forever!Dialogue: 0,0:19:25.39,0:19:27.38,Secondary,,0,0,0,,Get off of me!Dialogue: 0,0:19:35.52,0:19:38.36,Main,,0,0,0,,Have we contacted Navy HQ yet?Dialogue: 0,0:19:38.70,0:19:40.42,Main,,0,0,0,,Well, actually...Dialogue: 0,0:19:41.14,0:19:44.34,Main,,0,0,0,,Isshou-san said, "Don't file a report yet."Dialogue: 0,0:19:50.54,0:19:54.42,Main,,0,0,0,,Vice Admiral Maynard! The Surveillance Snail is ready!Dialogue: 0,0:19:55.87,0:19:58.28,Main,,0,0,0,,Alright, I'll do the talking.Dialogue: 0,0:19:59.40,0:20:04.53,Main,,0,0,0,,Take another Surveillance Snail and follow Isshou-san, per orders!Dialogue: 0,0:20:04.53,0:20:05.20,Main,,0,0,0,,Yes, sir!Dialogue: 0,0:20:12.60,0:20:16.79,Captions,,0,0,175,,Applenine - A Neighboring CountryDialogue: 0,0:20:13.02,0:20:16.78,Narrator,,0,0,0,,This is Applenine Island, a country near Dressrosa.Dialogue: 0,0:20:21.00,0:20:21.82,Main,,0,0,0,,What the heck?Dialogue: 0,0:20:22.32,0:20:23.16,Main,,0,0,0,,What's wrong?Dialogue: 0,0:20:23.68,0:20:25.86,Main,,0,0,0,,I heard there'll be a broadcast from Dressrosa!Dialogue: 0,0:20:26.28,0:20:28.74,Main,,0,0,0,,Will it be a speech from King Doflamingo?Dialogue: 0,0:20:29.28,0:20:30.64,Main,,0,0,0,,Scary, isn't it?Dialogue: 0,0:20:31.00,0:20:33.64,Main,,0,0,0,,This is Dressrosa...Dialogue: 0,0:20:34.17,0:20:37.02,Captions,,0,0,175,,Another Neighboring CountryDialogue: 0,0:20:38.96,0:20:44.20,Main,,0,0,0,,We are broadcasting to the three neighboring island countries within range of the Surveillance Snail.Dialogue: 0,0:20:44.27,0:20:47.18,Captions,,0,0,175,,Yet Another Neighboring CountryDialogue: 0,0:20:54.68,0:20:58.85,Main,,0,0,0,,I am Navy HQ Vice Admiral Maynard!Dialogue: 0,0:20:58.85,0:20:59.82,Main,,0,0,0,,The Navy?Dialogue: 0,0:21:00.38,0:21:02.02,Main,,0,0,0,,This is Dressrosa.Dialogue: 0,0:21:02.44,0:21:07.80,Main,,0,0,0,,We are broadcasting to the three neighboring island countries within range of the Surveillance Snail.Dialogue: 0,0:21:07.80,0:21:08.87,Main,,0,0,0,,But why?Dialogue: 0,0:21:08.87,0:21:11.60,Main,,0,0,0,,I want you to take a look at these images!Dialogue: 0,0:21:14.84,0:21:17.70,Main,,0,0,0,,What's up with the piles of rubble?Dialogue: 0,0:21:17.70,0:21:21.28,Main,,0,0,0,,What you're seeing is the current state of Dressrosa!Dialogue: 0,0:21:22.82,0:21:23.82,Main,,0,0,0,,What does he mean?Dialogue: 0,0:21:24.28,0:21:26.45,Main,,0,0,0,,I ask you to keep calm as I tell you...Dialogue: 0,0:21:26.45,0:21:32.96,Main,,0,0,0,,all the details of what the Warlord, Donquixote Doflamingo, did today in this very country!Dialogue: 0,0:21:34.86,0:21:38.06,Thoughts,,0,0,0,,Isshou-san, I'll do as you asked.Dialogue: 0,0:21:43.64,0:21:45.81,Main,,0,0,0,,We're begging you, Your Majesty!Dialogue: 0,0:21:45.81,0:21:50.98,Main,,0,0,0,,So many of us citizens were turned into toys and couldn't speak out!Dialogue: 0,0:21:50.98,0:21:54.80,Main,,0,0,0,,No! Please... stop this.Dialogue: 0,0:21:59.84,0:22:04.56,Main,,0,0,0,,Even if the misunderstanding about me has cleared up, I cannot return as your king.Dialogue: 0,0:22:04.88,0:22:08.30,Main,,0,0,0,,No! You are this country's true king!Dialogue: 0,0:22:08.30,0:22:09.51,Main,,0,0,0,,That's right!Dialogue: 0,0:22:09.51,0:22:11.54,Main,,0,0,0,,We're sick and tired of violence!Dialogue: 0,0:22:11.54,0:22:12.58,Main,,0,0,0,,Your Majesty!Dialogue: 0,0:22:12.92,0:22:16.78,Main,,0,0,0,,What if everyone in the kingdom shared your values?Dialogue: 0,0:22:24.48,0:22:25.84,Main,,0,0,0,,Wait.Dialogue: 0,0:22:28.00,0:22:31.06,Main,,0,0,0,,The Riku Family's position falls apart when faced with turmoil.Dialogue: 0,0:22:31.54,0:22:34.28,Main,,0,0,0,,This event has proven that.Dialogue: 0,0:22:37.10,0:22:38.86,Main,,0,0,0,,We don't care if we fall to ruin!Dialogue: 0,0:22:39.80,0:22:43.26,Main,,0,0,0,,We'd gladly fall to ruin if there were any hope for peace together with you!Dialogue: 0,0:22:43.26,0:22:47.11,Main,,0,0,0,,We want you to renounce war, as our pacifist king!Dialogue: 0,0:22:47.11,0:22:48.31,Main,,0,0,0,,That's right!Dialogue: 0,0:22:48.31,0:22:52.18,Main,,0,0,0,,Even if it causes our country to fall, we're fine with that!Dialogue: 0,0:22:53.46,0:22:58.60,Main,,0,0,0,,We don't mind being poor! Just make Dressrosa a peaceful country again!Dialogue: 0,0:22:58.60,0:23:00.01,Main,,0,0,0,,Your Majesty!Dialogue: 0,0:23:00.01,0:23:02.22,Main,,0,0,0,,Your Majesty, we're begging you!Dialogue: 0,0:23:11.88,0:23:14.26,Main,,0,0,0,,As a fighting king, their words grate my ears!Dialogue: 0,0:23:15.90,0:23:17.10,Main,,0,0,0,,Elizabello!Dialogue: 0,0:23:19.18,0:23:22.34,Main,,0,0,0,,Your Majesty! You must return to the palace at once!Dialogue: 0,0:23:22.34,0:23:26.40,Main,,0,0,0,,Kings from neighboring countries keep calling us!Dialogue: 0,0:23:26.78,0:23:28.00,Main,,0,0,0,,What did you say?Dialogue: 0,0:23:30.50,0:23:33.91,Main,,0,0,0,,I had to tell them right away...Dialogue: 0,0:23:33.91,0:23:38.54,Main,,0,0,0,,that King Riku is coming back. They were all overjoyed to hear that!Dialogue: 0,0:23:38.92,0:23:40.36,Main,,0,0,0,,The King of Prodence!Dialogue: 0,0:23:43.14,0:23:46.12,Main,,0,0,0,,It's barely been a decade. How could you age so much?Dialogue: 0,0:23:46.60,0:23:52.84,Main,,0,0,0,,Where is the man who would stare down the world to avoid a war?Dialogue: 0,0:23:55.44,0:23:57.58,Main,,0,0,0,,Your people are waiting for you.Dialogue: 0,0:24:00.48,0:24:02.16,Main,,0,0,0,,Come home...Dialogue: 0,0:24:02.88,0:24:05.48,Main,,0,0,0,,Miracle King, Riku Dold!Dialogue: 0,0:24:07.46,0:24:10.68,Main,,0,0,0,,He is right, King Riku!Dialogue: 0,0:24:27.08,0:24:30.25,Main,,0,0,0,,All this trouble that Doflamingo caused...Dialogue: 0,0:24:30.25,0:24:35.08,Main,,0,0,0,,I would rather you not take responsibility for it.Dialogue: 0,0:24:35.92,0:24:43.74,Main,,0,0,0,,That vicious pirate was approved as king of a country under the Seven Warlords system,Dialogue: 0,0:24:43.74,0:24:47.78,Main,,0,0,0,,and thus permitted to reign over this island by none other than...Dialogue: 0,0:24:48.88,0:24:51.46,Main,,0,0,0,,the World Government!Dialogue: 0,0:24:55.24,0:24:58.16,Main,,0,0,0,,To all who inhabit this country...Dialogue: 0,0:24:58.66,0:25:01.32,Main,,0,0,0,,and to all members of its royal family...Dialogue: 0,0:25:11.74,0:25:14.54,Main,,0,0,0,,On behalf of the Government,Dialogue: 0,0:25:14.54,0:25:19.56,Main,,0,0,0,,I most humbly apologize!Dialogue: 0,0:25:46.26,0:25:50.58,Main,,0,0,0,,We most deeply regret what has been done!Dialogue: 0,0:25:52.88,0:25:54.48,Main,,0,0,0,,What are you...Dialogue: 0,0:26:05.64,0:26:08.60,Main,,0,0,0,,The Navy admiral has prostrated himself?Dialogue: 0,0:26:08.94,0:26:09.96,Main,,0,0,0,,You're kidding me...Dialogue: 0,0:26:13.86,0:26:15.84,Main,,0,0,0,,The Government controls the Navy!Dialogue: 0,0:26:15.84,0:26:19.48,Main,,0,0,0,,And one of the Navy admirals, the greatest of their military might...Dialogue: 0,0:26:19.48,0:26:22.97,Main,,0,0,0,,is bowing before King Riku and his nation in apology!Dialogue: 0,0:26:22.97,0:26:25.31,Main,,0,0,0,,What the heck is going on in Dressrosa?Dialogue: 0,0:26:24.89,0:26:29.29,Captions,,0,0,577,,Law - Straw Hat Pirate AllianceDialogue: 0,0:26:25.31,0:26:29.40,Main,,0,0,0,,That pirate alliance took down the Celestial Yaksha, Doflamingo?Dialogue: 0,0:26:30.24,0:26:32.54,Main,,0,0,0,,Take pictures! Put them in print already!Dialogue: 0,0:26:33.50,0:26:35.60,Main,,0,0,0,,This is completely unheard of!Dialogue: 0,0:26:38.36,0:26:43.88,Narrator,,0,0,0,,The false glory of the mighty country, Dressrosa, and the truth behind it.Dialogue: 0,0:26:44.70,0:26:51.06,Narrator,,0,0,0,,The downfall of the world's greatest underground broker, Doflamingo.Dialogue: 0,0:26:51.92,0:26:57.10,Narrator,,0,0,0,,And the prostration of Navy HQ Admiral Fujitora.Dialogue: 0,0:26:57.70,0:27:00.70,Narrator,,0,0,0,,The major incidents that were confined within the cage...Dialogue: 0,0:27:05.34,0:27:10.86,Narrator,,0,0,0,,have just been released to the entire world.Dialogue: 0,0:27:39.34,0:27:41.67,Main,,0,0,0,,An admiral from Navy HQ has prostrated himself?!Dialogue: 0,0:27:41.67,0:27:43.88,Main,,0,0,0,,The Surveillance Snail is running, too!Dialogue: 0,0:27:51.16,0:27:53.78,Main,,0,0,0,,Th-That's a Navy admiral, isn't it?Dialogue: 0,0:27:55.30,0:27:56.59,Main,,0,0,0,,Wh-What happened?Dialogue: 0,0:27:56.59,0:27:58.88,Main,,0,0,0,,Something's going on in Dressrosa!Dialogue: 0,0:28:01.66,0:28:04.50,Main,,0,0,0,,Raise your head, Fujitora.Dialogue: 0,0:28:08.34,0:28:12.46,Main,,0,0,0,,Fujitora, aren't you worried about the world seeing this?Dialogue: 0,0:28:17.51,0:28:18.72,Main,,0,0,0,,You couldn't possibly...Dialogue: 0,0:28:19.51,0:28:21.18,Main,,0,0,0,,Could it be...Dialogue: 0,0:28:22.32,0:28:25.50,Main,,0,0,0,,that you stayed away from Doflamingo so you could enact this?Dialogue: 0,0:28:29.70,0:28:30.97,Main,,0,0,0,,Fujitora!Dialogue: 0,0:28:30.97,0:28:33.64,Main,,0,0,0,,The world must know the truth!Dialogue: 0,0:28:34.34,0:28:39.86,Main,,0,0,0,,I left all the fighting to them. I made a wager on them.Dialogue: 0,0:28:40.34,0:28:44.02,Main,,0,0,0,,We are the ones who allowed the Warlords to do as they please.Dialogue: 0,0:28:44.02,0:28:47.64,Main,,0,0,0,,So who are we to point our swords at them,Dialogue: 0,0:28:47.64,0:28:51.78,Main,,0,0,0,,and yet preach about justice without bearing shame?Dialogue: 0,0:28:58.24,0:29:08.52,Main,,0,0,0,,This country earned its victory at the hands of pirates, warriors, and its citizens!Dialogue: 0,0:29:09.07,0:29:12.28,Main,,0,0,0,,Our long, hard battle is at last over.Dialogue: 0,0:29:12.66,0:29:13.92,Main,,0,0,0,,I am truly...Dialogue: 0,0:29:16.82,0:29:18.66,Main,,0,0,0,,I am truly grateful for your hard work.Dialogue: 0,0:29:20.18,0:29:23.66,Main,,0,0,0,,Little Army of King Riku, Special Anti-Doflamingo Forces!Dialogue: 0,0:29:23.66,0:29:26.14,Main,,0,0,0,,Yes, Commander!Dialogue: 0,0:29:26.88,0:29:28.74,Main,,0,0,0,,As of today, you are all...Dialogue: 0,0:29:32.68,0:29:33.76,Main,,0,0,0,,...dismissed!Dialogue: 0,0:29:35.34,0:29:40.60,Main,,0,0,0,,Commander!Dialogue: 0,0:29:41.17,0:29:41.94,Main,,0,0,0,,Tank!Dialogue: 0,0:29:42.76,0:29:44.94,Main,,0,0,0,,The Navy still has their position to consider.Dialogue: 0,0:29:44.94,0:29:48.86,Main,,0,0,0,,Hide the pirates and warriors who fought for us in the palace.Dialogue: 0,0:29:49.34,0:29:52.98,Main,,0,0,0,,Take those without shelter there as well. I hate to ask, but can I count on you?Dialogue: 0,0:29:52.98,0:29:55.44,Main,,0,0,0,,Of course, it would be my pleasure, Your Majesty!Dialogue: 0,0:30:04.66,0:30:12.15,Captions,,0,0,170,,The Red LineDialogue: 0,0:30:12.67,0:30:16.31,Captions,,0,0,175,,Holy Land, MariejoisDialogue: 0,0:30:14.70,0:30:15.80,Main,,0,0,3,,So...Dialogue: 0,0:30:16.54,0:30:20.14,Main,,0,0,0,,Reporting Doflamingo's resignation, and then revealing it as false...Dialogue: 0,0:30:20.60,0:30:25.10,Main,,0,0,3,,Was this all by order of those people above you?Dialogue: 0,0:30:24.52,0:30:30.16,Captions,,0,0,240,,World Government Supreme Authority The Five Elder StarsDialogue: 0,0:30:30.98,0:30:36.87,Captions,,0,0,240,,Navy Headquarters Fleet Admiral Sakazuki (Akainu)Dialogue: 0,0:30:31.44,0:30:34.16,Main,,0,0,3,,Why should the world be deceivedDialogue: 0,0:30:34.16,0:30:36.74,Main,,0,0,3,,for the sake of someone like Doflamingo?!Dialogue: 0,0:30:37.32,0:30:42.40,Main,,0,0,0,,If something like this ever happens again, it'll bring shame on me as fleet admiral!Dialogue: 0,0:30:42.96,0:30:45.08,Main,,0,0,0,,Don't ever do that again, under any circumstances!Dialogue: 0,0:30:45.88,0:30:49.27,Main,,0,0,0,,Don't give us any of your cheek, Sakazuki.Dialogue: 0,0:30:49.27,0:30:52.04,Main,,0,0,0,,Your honor is completely inconsequential.Dialogue: 0,0:30:52.82,0:30:56.54,Main,,0,0,0,,The Navy is merely the public face of the Government.Dialogue: 0,0:30:56.92,0:31:00.52,Main,,0,0,0,,We left this case entirely up to Cipher Pol.Dialogue: 0,0:31:00.92,0:31:03.10,Main,,0,0,0,,Hmph! Cipher Pol, huh?Dialogue: 0,0:31:04.44,0:31:06.02,Main,,0,0,0,,So simply put,Dialogue: 0,0:31:06.66,0:31:09.64,Main,,0,0,0,,they've gone over your heads.Dialogue: 0,0:31:10.02,0:31:12.19,Main,,0,0,0,,Those damn puppets of the Celestial Dragons!Dialogue: 0,0:31:12.19,0:31:14.34,Main,,0,0,0,,Watch your mouth, Sakazuki!Dialogue: 0,0:31:14.34,0:31:16.46,Main,,0,0,0,,And what of Kuzan's actions?Dialogue: 0,0:31:18.12,0:31:22.88,Main,,0,0,0,,I can hardly believe a powerful man like him sides with Blackbeard now.Dialogue: 0,0:31:24.02,0:31:26.66,Main,,0,0,0,,That is sure to bring dishonor to the Navy!Dialogue: 0,0:31:26.66,0:31:30.28,Main,,0,0,0,,That idiot resigned from the Navy!Dialogue: 0,0:31:30.28,0:31:34.42,Main,,0,0,0,,Where he is and what he's doing is not our responsibility!Dialogue: 0,0:31:34.98,0:31:37.00,Main,,0,0,0,,Five Elder Stars! Fleet Admiral Sakazuki!Dialogue: 0,0:31:43.52,0:31:44.90,Main,,0,0,0,,Reporting in!Dialogue: 0,0:31:44.90,0:31:52.00,Main,,0,0,0,,The Warlord, Donquixote Doflamingo, and his family were defeated by the Law - Straw Hat Pirate Alliance.Dialogue: 0,0:31:52.34,0:31:55.94,Main,,0,0,0,,And Dressrosa has been destroyed. There's nothing left of it!Dialogue: 0,0:31:56.92,0:31:58.16,Main,,0,0,0,,What'd you say?!Dialogue: 0,0:32:02.16,0:32:03.24,Main,,0,0,0,,Again...Dialogue: 0,0:32:03.24,0:32:04.80,Main,,0,0,0,,...with that brat?Dialogue: 0,0:32:08.00,0:32:10.46,Main,,0,0,0,,And there's one more thing...Dialogue: 0,0:32:25.13,0:32:29.62,Captions,,0,0,170,,Countries Across the New WorldDialogue: 0,0:32:25.47,0:32:30.98,Narrator,,0,0,0,,The video and story that were sent to Dressrosa's neighbors spread from one island to the next.Dialogue: 0,0:32:31.98,0:32:34.20,Main,,0,0,0,,Extra! Extra!Dialogue: 0,0:32:34.48,0:32:38.51,Narrator,,0,0,0,,The news spread like wildfire throughout the world, with dire repercussions.Dialogue: 0,0:32:35.50,0:32:37.43,Main,,0,0,0,,Doflamingo Falls!!Dialogue: 0,0:32:38.94,0:32:40.72,Main,,0,0,0,,Joker was defeated!Dialogue: 0,0:32:41.66,0:32:45.00,Main,,0,0,0,,Your Majesty! We have no other way to acquire weapons!Dialogue: 0,0:32:47.49,0:32:49.48,Main,,0,0,0,,Announce our surrender.Dialogue: 0,0:32:55.26,0:32:57.78,Main,,0,0,0,,The war is over!Dialogue: 0,0:32:59.76,0:33:03.48,Main,,0,0,0,,We've already paid! We had a deal!Dialogue: 0,0:33:03.48,0:33:05.28,Main,,0,0,0,,That bastard, Joker!Dialogue: 0,0:33:05.82,0:33:08.19,Main,,0,0,0,,I know they still have weapons in Dressrosa!Dialogue: 0,0:33:08.19,0:33:10.73,Main,,0,0,0,,Don't! There's still a Navy admiral over there!Dialogue: 0,0:33:10.73,0:33:13.19,Main,,0,0,0,,Our deal for the Devil Fruits!Dialogue: 0,0:33:13.19,0:33:15.89,Main,,0,0,0,,What'll happen to the Smiles deal now?!Dialogue: 0,0:33:15.89,0:33:17.96,Main,,0,0,0,,If only these fools weren't there!Dialogue: 0,0:33:24.50,0:33:28.57,Main,,0,0,0,,Come now, Tsuru-chan! You didn't need to tag along with us!Dialogue: 0,0:33:28.57,0:33:31.12,Main,,0,0,0,,I ought to be saying that, Inspector General!Dialogue: 0,0:33:31.60,0:33:35.68,Main,,0,0,0,,Well, they're the pirate group that you've been chasing after all this time, aren't they?Dialogue: 0,0:33:35.68,0:33:37.24,Main,,0,0,0,,Yes, under your orders.Dialogue: 0,0:33:37.74,0:33:39.32,Main,,0,0,0,,Want some rice crackers?Dialogue: 0,0:33:39.20,0:33:41.30,Captions,,1030,0,280,,In a Certain TownDialogue: 0,0:33:41.64,0:33:45.32,Main,,0,0,0,,How's this? This is today's special mixed pizza.Dialogue: 0,0:33:46.32,0:33:47.25,Main,,0,0,0,,Huh? Thief!Dialogue: 0,0:33:47.25,0:33:48.95,Main,,0,0,0,,Hey, old lady! Stop!Dialogue: 0,0:33:50.16,0:33:51.98,Main,,0,0,0,,Crap, where did she go?Dialogue: 0,0:33:56.66,0:33:59.51,Main,,0,0,0,,Tsk, just a little girl. Old lady, where'd you go?!Dialogue: 0,0:33:59.51,0:34:02.90,Main,,0,0,0,,Oh, they took down Doflamingo.Dialogue: 0,0:34:03.28,0:34:06.52,Main,,0,0,0,,Not bad. Makes me happy to be from the same generation.Dialogue: 0,0:34:07.50,0:34:11.37,Captions,,0,0,205,,From South Blue - Captain of the Bonney Pirates "The Glutton" Jewelry BonneyDialogue: 0,0:34:11.48,0:34:15.60,Captions,,0,0,175,,In a certain skyDialogue: 0,0:34:19.52,0:34:21.30,Main,,0,0,0,,High Priest Urouge!Dialogue: 0,0:34:22.88,0:34:24.48,Main,,0,0,0,,High Priest Urouge!Dialogue: 0,0:34:27.62,0:34:30.98,Main,,0,0,0,,Th-There's somebody here! High Priest!Dialogue: 0,0:34:31.38,0:34:37.50,Captions,,0,0,200,,From the Sky Islands - Captain of the Fallen Monk Pirates "Mad Monk" UrougeDialogue: 0,0:34:31.98,0:34:35.45,Main,,0,0,1,,Nonsense! We're on a Sky Island.Dialogue: 0,0:34:35.45,0:34:38.30,Main,,0,0,1,,It's an abandoned and isolated cloud island, at that.Dialogue: 0,0:34:38.64,0:34:40.22,Main,,0,0,0,,Nobody but us could possibly-Dialogue: 0,0:34:51.15,0:34:56.17,Captions,,0,0,170,,In a certain seaDialogue: 0,0:34:52.78,0:34:56.20,Main,,0,0,3,,Whoa, whoa, not bad, that pirate alliance.Dialogue: 0,0:34:56.84,0:35:00.08,Main,,0,0,1,,Looks like my fellow pirates ain't doing too shabby.Dialogue: 0,0:34:56.99,0:35:03.47,Captions,,0,0,205,,From West Blue - Captain of the Fire Tank Pirates Capone "Gang" BegeDialogue: 0,0:35:00.62,0:35:03.76,Main,,0,0,1,,Capture Caesar at any cost, boys!Dialogue: 0,0:35:03.76,0:35:05.58,Main,,0,0,0,,Yes, Father!Dialogue: 0,0:35:05.91,0:35:09.31,Captions,,0,0,170,,The Kid Pirates' HideoutDialogue: 0,0:35:09.84,0:35:12.36,Main,,0,0,0,,They made their move before we knew it.Dialogue: 0,0:35:12.68,0:35:14.79,Main,,0,0,0,,It's a huge victory!Dialogue: 0,0:35:14.79,0:35:17.89,Main,,0,0,0,,Doflamingo is connected to Kaidou behind the scenes, for sure.Dialogue: 0,0:35:17.89,0:35:20.16,Main,,0,0,0,,Well, that's gonna make Kaidou pretty mad, yeah?Dialogue: 0,0:35:20.09,0:35:24.12,Captions,,0,0,205,,From South Blue - Captain of the Kid Pirates Eustass "Captain" KidDialogue: 0,0:35:21.02,0:35:24.70,Main,,0,0,1,,If they planned this, their target must be...Dialogue: 0,0:35:24.30,0:35:28.37,Captions,,0,0,200,,From North Blue - Captain of the Hawkins Pirates "The Mage" Basil HawkinsDialogue: 0,0:35:26.91,0:35:28.72,Main,,0,0,1,,...one of the Four Emperors, as we thought.Dialogue: 0,0:35:28.52,0:35:32.75,Captions,,0,0,205,,From the Grand Line (Longarm Tribe) - Captain of the On-Air Pirates "Roaring Tide" Scratchmen ApooDialogue: 0,0:35:30.84,0:35:32.90,Main,,0,0,1,,"Beast King" Kaidou, eh?Dialogue: 0,0:35:32.90,0:35:37.30,Captions,,0,0,205,,From South Blue - Kid Pirates Combatant "Soldier of Slaughter" KillerDialogue: 0,0:35:34.91,0:35:37.86,Main,,0,0,1,,Good thing our target isn't theirs.Dialogue: 0,0:35:38.40,0:35:41.32,Main,,0,0,0,,We won't have to fight each other and waste our military might.Dialogue: 0,0:35:42.64,0:35:47.62,Main,,0,0,0,,Our target is one of the other Four Emperors, "Red Hair" Shanks!Dialogue: 0,0:35:48.94,0:35:52.89,Narrator,,0,0,0,,And now we shift attention to Drake, who once provoked a battle in Kaidou's territory...Dialogue: 0,0:35:52.59,0:35:54.90,Captions,,0,0,170,,A Certain IslandDialogue: 0,0:35:53.34,0:35:56.42,Main,,0,0,3,,Your father was killed? By Doflamingo?Dialogue: 0,0:36:04.10,0:36:06.90,Main,,0,0,1,,That was a long time ago. I bear no grudge.Dialogue: 0,0:36:04.85,0:36:10.87,Captions,,0,0,205,,From North Blue - Captain of the Drake Pirates "Red Flag" X-DrakeDialogue: 0,0:36:06.90,0:36:09.62,Main,,0,0,1,,What gives? That's pretty heartless of you.Dialogue: 0,0:36:09.62,0:36:11.14,Main,,0,0,1,,Hey, give us a hand here!Dialogue: 0,0:36:11.54,0:36:15.72,Main,,0,0,0,,This is an emergency! If we don't let him know right away, he'll snap!Dialogue: 0,0:36:16.56,0:36:19.55,Main,,0,0,0,,Kaidou-sama! Where are you?Dialogue: 0,0:36:19.55,0:36:22.36,Main,,0,0,0,,That idiot Joker screwed up big time!Dialogue: 0,0:36:22.36,0:36:25.00,Main,,0,0,0,,We won't be receiving Smiles anymore!Dialogue: 0,0:36:27.20,0:36:29.38,Main,,0,0,0,,Don't play dumb with me, Isshou!Dialogue: 0,0:36:29.30,0:36:31.69,Captions,,1000,0,320,,DressrosaDialogue: 0,0:36:32.12,0:36:37.24,Main,,0,0,0,,You know full well the gravity of a Navy admiral admitting to oversight!Dialogue: 0,0:36:38.00,0:36:40.80,Main,,0,0,0,,Why didn't you report to HQ first?!Dialogue: 0,0:36:42.74,0:36:48.82,Main,,0,0,0,,Had I reported in, surely you would have changed the details of the report yet again, would you not?Dialogue: 0,0:36:49.92,0:36:51.56,Main,,0,0,0,,What did you just say?!Dialogue: 0,0:36:56.84,0:37:00.60,Main,,0,0,0,,I also feel the Seven Warlord system must end.Dialogue: 0,0:37:05.10,0:37:10.44,Main,,0,0,0,,Two years ago, I was there when Crocodile showed his true nature.Dialogue: 0,0:37:11.76,0:37:14.28,Main,,0,0,0,,The Navy couldn't do anything!Dialogue: 0,0:37:19.18,0:37:21.63,Main,,0,0,0,,If it weren't for the Straw Hats,Dialogue: 0,0:37:21.63,0:37:26.56,Main,,0,0,0,,Alabasta would be another country governed by a pirate, just like Dressrosa.Dialogue: 0,0:37:27.10,0:37:31.58,Main,,0,0,0,,Yet the Government reported that it was the Navy's doing!Dialogue: 0,0:37:33.48,0:37:36.62,Main,,0,0,0,,If only I held higher rank then!Dialogue: 0,0:37:49.84,0:37:54.48,Main,,0,0,0,,I can't believe Fujitora really did it.Dialogue: 0,0:37:54.80,0:37:58.50,Main,,0,0,0,,It reminds me of the frustration I felt at Alabasta Kingdom two years ago.Dialogue: 0,0:37:59.86,0:38:03.56,Main,,0,0,0,,The Straw Hats' triumph was covered up then.Dialogue: 0,0:38:05.58,0:38:07.98,Main,,0,0,0,,It's like he paid them back for us.Dialogue: 0,0:38:08.50,0:38:12.44,Main,,0,0,0,,Even if I held the same rank as him, I couldn't have pulled that off.Dialogue: 0,0:38:12.98,0:38:14.56,Main,,0,0,0,,I could feast on this feeling for days.Dialogue: 0,0:38:15.46,0:38:18.10,Main,,0,0,0,,Oh, we have muffins! How about some coffee?Dialogue: 0,0:38:18.10,0:38:19.93,Main,,0,0,0,,That didn't mean I wanted to eat, you idiot!Dialogue: 0,0:38:21.44,0:38:23.29,Main,,0,0,0,,Hey lady, I'm hungry!Dialogue: 0,0:38:23.29,0:38:24.62,Main,,0,0,0,,We're hungry too!Dialogue: 0,0:38:25.10,0:38:27.48,Main,,0,0,0,,We have muffins! How about some coffee?Dialogue: 0,0:38:27.48,0:38:29.80,Main,,0,0,0,,You can't give kids coffee!Dialogue: 0,0:38:29.80,0:38:31.23,Main,,0,0,0,,I want a muffin!Dialogue: 0,0:38:31.23,0:38:32.90,Main,,0,0,0,,Are we at Megapants' yet?Dialogue: 0,0:38:32.90,0:38:34.06,Main,,0,0,0,,That's "Vegapunk".Dialogue: 0,0:38:34.50,0:38:38.22,Main,,0,0,0,,It'll be a few more days until we reach Dr. Vegapunk's lab.Dialogue: 0,0:38:40.08,0:38:43.18,Main,,0,0,0,,How lovely! Captain-chan's sweet to the kids!Dialogue: 0,0:38:43.18,0:38:44.97,Main,,0,0,0,,I wish I were a kid!Dialogue: 0,0:38:44.97,0:38:48.11,Main,,0,0,0,,Hey, you bunch! There's still tons of work to do!Dialogue: 0,0:38:48.11,0:38:49.29,Main,,0,0,0,,Aye aye, ma'am!Dialogue: 0,0:38:49.29,0:38:51.42,Main,,0,0,0,,Scold me more, Captain-chan!Dialogue: 0,0:39:09.08,0:39:11.74,Main,,0,0,0,,Cover-ups happen all the time!Dialogue: 0,0:39:12.08,0:39:16.24,Main,,0,0,0,,I would rather not be a hero forged upon lies.Dialogue: 0,0:39:16.56,0:39:24.93,Main,,0,0,0,,It was our employer, the World Government, that hired pirates to maintain balance in the world.Dialogue: 0,0:39:24.93,0:39:28.42,Main,,0,0,0,,This is a matter of the Navy's credibility and dignity!Dialogue: 0,0:39:28.48,0:39:31.38,Main,,0,0,0,,I-Isshou-san, y-you're talking to...Dialogue: 0,0:39:32.66,0:39:37.38,Main,,0,0,0,,Your selfish actions dishonor the very name of justice!Dialogue: 0,0:39:37.38,0:39:41.96,Main,,0,0,0,,If you value your justice so damn much, then keep a close eye on it!Dialogue: 0,0:39:41.96,0:39:47.64,Main,,0,0,0,,If we lose credibility just for admitting fault, we haven't any in the first place!Dialogue: 0,0:39:55.03,0:39:58.56,Main,,0,0,0,,Then you clean up after yourself, Fujitora!Dialogue: 0,0:39:59.74,0:40:04.60,Main,,0,0,0,,Straw Hat and Law... Until you bring me their heads,Dialogue: 0,0:40:05.00,0:40:09.18,Main,,0,0,0,,you are hereby barred from setting foot within any Navy base in the world!Dialogue: 0,0:40:10.68,0:40:14.68,Main,,0,0,0,,Good, that's exactly what I wanted to hear.Dialogue: 0,0:40:16.26,0:40:18.34,Main,,0,0,0,,Meat...Dialogue: 0,0:40:21.42,0:40:24.50,OP11 Credits,,0,0,0,,Editing:  Galaxy 9000  Timing:  Datenshi, Sewil (Opening)  Quality Assurance:  Datenshi, Feeso, Galaxy 9000, Grug, Mr. Luffy  Soundtracking:  Halee  Graphics:  Datenshi  Translation: Yibis