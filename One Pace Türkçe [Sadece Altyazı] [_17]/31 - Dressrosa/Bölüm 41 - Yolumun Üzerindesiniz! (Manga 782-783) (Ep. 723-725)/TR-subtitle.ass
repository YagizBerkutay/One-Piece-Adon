Dialogue: 0,0:01:42.72,0:01:45.23,Title,,0,0,240,,{\fad(800,800)}Yolumun Üzerindesiniz!
Dialogue: 0,0:01:45.70,0:01:47.52,Main,,0,0,0,,Beni neden durdurdun?!
Dialogue: 0,0:01:49.80,0:01:56.88,Main,,0,0,0,,Law'un kafasını ezecektim sadece!
Dialogue: 0,0:02:02.14,0:02:04.86,Main,,0,0,0,,Kral Hakileri\Narasında bir çarpışma bu!
Dialogue: 0,0:02:05.08,0:02:07.66,Main,,0,0,0,,O da mı sahipmiş?!
Dialogue: 0,0:02:20.92,0:02:22.94,Thoughts,,0,0,0,,{\i1}Hasır Şapka-ya...{\i0}
Dialogue: 0,0:02:23.98,0:02:26.98,Thoughts,,0,0,0,,{\i1}Düşündüğüm gibi\No da kullanabiliyor!{\i0}
Dialogue: 0,0:02:39.00,0:02:40.90,Main,,0,0,0,,Ne... Ne...
Dialogue: 0,0:02:41.14,0:02:43.02,Main,,0,0,0,,Ne?!
Dialogue: 0,0:02:43.44,0:02:46.96,Main,,0,0,0,,Herkes bayıldı mı dedin?!
Dialogue: 0,0:02:47.10,0:02:50.12,Main,,0,0,0,,Haki yüzünden olmalı!
Dialogue: 0,0:02:50.22,0:02:51.06,Main,,0,0,0,,Haki mi?
Dialogue: 0,0:02:51.16,0:02:54.96,Main,,0,0,0,,Üstüne üstlük Kral Hakisi bir de!
Dialogue: 0,0:02:56.38,0:03:00.06,Main,,0,0,0,,Kral olmaya layık biri olduğunun kanıtı bu.
Dialogue: 0,0:03:03.04,0:03:04.84,Main,,0,0,0,,Doflamingo!
Dialogue: 0,0:03:05.18,0:03:10.62,Main,,0,0,0,,Cennetin seçtiği adamsın!
Dialogue: 0,0:03:15.72,0:03:17.08,Main,,0,0,0,,E madem öyle...
Dialogue: 0,0:03:17.44,0:03:21.52,Main,,0,0,0,,...erkek gibi\Nkendini bir teste tabi tut.
Dialogue: 0,0:03:22.56,0:03:25.54,Main,,0,0,0,,Öldürmek istediğin kimseler var mı?
Dialogue: 0,0:03:26.08,0:03:30.92,Main,,0,0,0,,İntikam almanı sağlayacak\Ngüce kavuşmak ister misin?
Dialogue: 0,0:03:43.42,0:03:45.44,Main,,0,0,0,,Öldürmek istediğim...
Dialogue: 0,0:03:46.26,0:03:48.00,Main,,0,0,0,,Tonla kişi var!
Dialogue: 0,0:03:52.08,0:03:56.42,Main,,0,0,0,,Doffy başka, bambaşka biri!
Dialogue: 0,0:03:57.78,0:04:02.96,Main,,0,0,0,,Doğumuyla gelen deliliği, kaderinin\Nöfkesini körüklemesiyle perçinlendi!
Dialogue: 0,0:04:03.14,0:04:06.68,Main,,0,0,0,,Ve bu adam iblis savaşçıya...
Dialogue: 0,0:04:08.16,0:04:13.86,Main,,0,0,0,,...şeytanın ta kendisine dönüştü!
Dialogue: 0,0:04:18.28,0:04:21.45,Main,,0,0,0,,Ne olmuş yani?!
Dialogue: 0,0:04:41.74,0:04:43.71,Main,,0,0,0,,Mingo!
Dialogue: 0,0:05:04.62,0:05:06.00,Main,,0,0,0,,Geber!
Dialogue: 0,0:05:06.24,0:05:08.76,Main,,0,0,0,,Mingo!
Dialogue: 0,0:05:09.94,0:05:12.54,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:05:17.54,0:05:20.36,Thoughts,,0,0,0,,{\i1}Doffy'nin öfkesi...{\i0}
Dialogue: 0,0:05:20.76,0:05:25.02,Thoughts,,0,0,0,,{\i1}...her şeyi yok edecek!{\i0}
Dialogue: 0,0:05:30.40,0:05:31.80,Main,,0,0,0,,{\fad(150,150)}...Kartal...
Dialogue: 0,0:05:32.38,0:05:35.72,Main,,0,0,0,,{\fad(150,150)}...Bazuka!
Dialogue: 0,0:05:44.28,0:05:45.66,Main,,0,0,0,,{\fad(150,150)}Atlet!
Dialogue: 0,0:06:23.16,0:06:25.14,Main,,0,0,0,,{\fad(150,150)}Beta Betton!
Dialogue: 0,0:06:31.04,0:06:32.58,Main,,0,0,0,,Bu da ne!?
Dialogue: 0,0:06:35.50,0:06:40.54,Main,,0,0,0,,Aptal şey! Senin gibi bir eziğin\NDoffy'i yenebileceğini sanma!
Dialogue: 0,0:06:40.88,0:06:42.88,Main,,0,0,0,,Lanet olsun, bırak beni!
Dialogue: 0,0:06:44.22,0:06:48.24,Main,,0,0,0,,Haydi Doffy,\NHasır Şapka'yı ben tutuyorum.
Dialogue: 0,0:06:48.24,0:06:51.70,Main,,0,0,0,,Fırsatın varken\NLaw'un kafasını eziver.
Dialogue: 0,0:06:57.02,0:06:59.02,Main,,0,0,0,,Sakın yapma, Mingo!
Dialogue: 0,0:06:59.02,0:07:03.16,Main,,0,0,0,,Dövüş benimle! Trao yerinden\Nbir milim bile oynayamıyor!
Dialogue: 0,0:07:03.16,0:07:05.08,Main,,0,0,0,,Sıranı bekle dedim sana...
Dialogue: 0,0:07:05.08,0:07:07.65,Main,,0,0,0,,Kapa çeneni, sümük herif!
Dialogue: 0,0:07:07.65,0:07:08.94,Main,,0,0,0,,Yapışkanım ben!
Dialogue: 0,0:07:22.41,0:07:24.03,Main,,0,0,0,,Boşuna uğraşıyorsun!
Dialogue: 0,0:07:24.03,0:07:25.91,Main,,0,0,0,,Neden?!
Dialogue: 0,0:07:25.91,0:07:28.45,Main,,0,0,0,,Katı Silahlanma'yla Logia tipi kullanıcılara\Nzarar verebilirim sanıyordum!
Dialogue: 0,0:07:28.45,0:07:34.05,Main,,0,0,0,,Peki ama,\Nacaba Logia gücüne mi sahibim?!
Dialogue: 0,0:07:34.05,0:07:37.99,Main,,0,0,0,,Her halükârda katı silahlanma\Nbende işe yaramaz!
Dialogue: 0,0:07:38.43,0:07:40.05,Main,,0,0,0,,Aptal lastik seni!
Dialogue: 0,0:07:40.05,0:07:41.91,Main,,0,0,0,,Hasır Şapka-ya!
Dialogue: 0,0:07:43.45,0:07:48.25,Main,,0,0,0,,Evet, onun gibi bir kağıt hamurunda\Nsaldırıların işe yaramaz!
Dialogue: 0,0:07:50.16,0:07:54.15,Main,,0,0,0,,Kağıt hamuru mu dedin?!
Dialogue: 0,0:07:54.15,0:07:59.07,Main,,0,0,0,,En çok da\NKalp Tahtı'na oturup...
Dialogue: 0,0:07:59.07,0:08:03.53,Main,,0,0,0,,...bu aptallarla birlikte anılmayı\Nistemedim.
Dialogue: 0,0:08:03.61,0:08:06.13,Main,,0,0,0,,Hâlâ konuşabiliyorsun anlaşılan.
Dialogue: 0,0:08:06.13,0:08:09.29,Main,,0,0,0,,Ağzından çıkanlara dikkat et\Nseni bir ayağı çukurda gerzek!
Dialogue: 0,0:08:09.29,0:08:14.13,Main,,0,0,0,,Biz üst düzey yöneticiler\Nailenin temelini oluştururuz!
Dialogue: 0,0:08:14.13,0:08:17.91,Main,,0,0,0,,Bizimle dalga geçenleri\Nasla bağışlamam!
Dialogue: 0,0:08:18.79,0:08:20.67,Main,,0,0,0,,{\fad(150,150)}Beta Betton...
Dialogue: 0,0:08:21.83,0:08:23.79,Main,,0,0,0,,{\fad(150,150)}...Fırlatıcı!
Dialogue: 0,0:08:26.21,0:08:29.53,Main,,0,0,0,,Yapma! Trao kılını dahi\Nkıpırdatamıyor zaten!
Dialogue: 0,0:08:29.53,0:08:32.69,Main,,0,0,0,,Law, seni lanet herif!
Dialogue: 0,0:08:33.81,0:08:36.85,Main,,0,0,0,,Bu veledin dersini vermek lazım!
Dialogue: 0,0:08:36.85,0:08:38.68,Main,,0,0,0,,Çekil önümden, Doffy!
Dialogue: 0,0:08:39.39,0:08:41.57,Main,,0,0,0,,Bana bak, Law!
Dialogue: 0,0:08:42.01,0:08:47.61,Main,,0,0,0,,Doffy nihai kraldır, ona şüphe yok!
Dialogue: 0,0:08:48.47,0:08:50.33,Main,,0,0,0,,Ama...
Dialogue: 0,0:08:50.33,0:08:55.41,Main,,0,0,0,,...biz üst düzey yöneticiler de dahil\Nhepimiz eşitiz!
Dialogue: 0,0:08:55.41,0:08:56.81,Main,,0,0,0,,Çünkü...
Dialogue: 0,0:08:57.13,0:09:00.45,Main,,0,0,0,,...30 küsür yıl önce, o gün...
Dialogue: 0,0:09:01.00,0:09:07.27,Main,,0,0,0,,...cennetlerden düşmüş bu yakutu\Ndördümüz bulduk!
Dialogue: 0,0:09:07.51,0:09:14.27,Main,,0,0,0,,Ona kuvvet verip kötülüğün\Nbüyüleyici gücü yaptık onu!
Dialogue: 0,0:09:19.31,0:09:21.97,Main,,0,0,0,,Kutsal Topraklar Mariejoa'da\Nneredeyse canından mı oluyordun?!
Dialogue: 0,0:09:22.37,0:09:25.17,Main,,0,0,0,,Babanın kellesini\Ngötürmene rağmen mi?
Dialogue: 0,0:09:29.79,0:09:35.34,Main,,0,0,0,,Sağ salim geri dönebilmene sevindim!\NBüyük bir mucize bu!
Dialogue: 0,0:09:40.19,0:09:44.99,Main,,0,0,0,,Doffy, kral olacak vasıfa sahipsin.
Dialogue: 0,0:09:47.87,0:09:52.20,Main,,0,0,0,,Doffy, seni her şeyde destekleyeceğiz!
Dialogue: 0,0:09:53.59,0:09:59.55,Main,,0,0,0,,Doffy, karşılığında\Nbu rüyayı yaşamamıza izin ver!
Dialogue: 0,0:10:05.77,0:10:07.77,Main,,0,0,0,,Neyin var Doffy?
Dialogue: 0,0:10:10.00,0:10:12.26,Main,,0,0,0,,Başına ne oldu?
Dialogue: 0,0:10:12.61,0:10:16.91,Main,,0,0,0,,Serserinin biri yaptı.\NGeberip gider umarım.
Dialogue: 0,0:10:18.89,0:10:21.21,Main,,0,0,0,,Peki.\NAnlaşılmıştır.
Dialogue: 0,0:10:30.71,0:10:32.11,Main,,0,0,0,,Ne istiyorsun?
Dialogue: 0,0:10:32.71,0:10:38.21,Main,,0,0,0,,Doffy'i yaralayan sen miydin?
Dialogue: 0,0:10:38.21,0:10:42.33,Main,,0,0,0,,Şu veledi mi diyorsun?\NAzıcık seviverdim!
Dialogue: 0,0:10:44.35,0:10:47.61,Main,,0,0,0,,Ne oldu?\NGene mi birilerindan dayak yedin?
Dialogue: 0,0:10:47.61,0:10:50.79,Main,,0,0,0,,Yok, yol düzgün değildi, düştüm.
Dialogue: 0,0:10:50.79,0:10:53.73,Main,,0,0,0,,Düzgün mü değildi?\NHangi şehrin yolu bu?
Dialogue: 0,0:10:54.65,0:10:59.33,Main,,0,0,0,,Anlıyorum...\NOnarılması lazım ama bunun.
Dialogue: 0,0:11:21.09,0:11:23.31,Main,,0,0,0,,{\i1}Aç kulağını, Doffy.{\i0}
Dialogue: 0,0:11:23.97,0:11:26.09,Main,,0,0,0,,{\i1}Kralsın sen.{\i0}
Dialogue: 0,0:11:26.39,0:11:29.75,Main,,0,0,0,,{\i1}Hiç kimsenin\Nsana karşı gelmesine izin vermemeliyiz.{\i0}
Dialogue: 0,0:11:32.17,0:11:35.11,Main,,0,0,0,,{\i1}Günün birinde...{\i0}
Dialogue: 0,0:11:36.57,0:11:40.55,Main,,0,0,0,,{\i1}...bu denizlerin kralı olacak adamsın!{\i0}
Dialogue: 0,0:11:51.84,0:11:57.27,Main,,0,0,0,,Doffy'i kral yapıp emrimizdekiler karşısında\Nbüyük bir itibar yarattık!
Dialogue: 0,0:11:57.27,0:12:02.95,Main,,0,0,0,,Fakat aileye\Nbeşimiz de eşit değer verip...
Dialogue: 0,0:12:02.95,0:12:05.57,Main,,0,0,0,,...ailemizi bugünlere\Nberaber getirdik!
Dialogue: 0,0:12:05.57,0:12:08.31,Main,,0,0,0,,Aynı gerçek ailelerin yapacağı gibi!
Dialogue: 0,0:12:08.31,0:12:11.65,Main,,0,0,0,,Anlıyor musun, Law?
Dialogue: 0,0:12:13.69,0:12:19.17,Main,,0,0,0,,Beto Beto'mun yanıcı olduğunu\Nhatırlıyor musun?
Dialogue: 0,0:12:19.71,0:12:22.81,Main,,0,0,0,,O lanet ağzını\Nistediğim an temelli kapatabilirim...
Dialogue: 0,0:12:22.82,0:12:24.05,Main,,0,0,0,,Gerçek aile ha?
Dialogue: 0,0:12:25.61,0:12:30.05,Main,,0,0,0,,Böyle düşünenler\Nyalnızca siz, yöneticilersiniz, Trebol.
Dialogue: 0,0:12:31.11,0:12:35.56,Main,,0,0,0,,Onun için koca birer hiçsiniz!
Dialogue: 0,0:12:36.08,0:12:39.52,Main,,0,0,0,,Ne... Ne dedin?!
Dialogue: 0,0:12:39.52,0:12:41.73,Main,,0,0,0,,Çok zavallısın.
Dialogue: 0,0:12:41.73,0:12:46.62,Main,,0,0,0,,Herkesten sorumlu kişiymişsin\Ngibi davranan sen bile...
Dialogue: 0,0:12:46.64,0:12:50.71,Main,,0,0,0,,...onun ahmak kuklasından\Nbaşka bir şey değilsin!
Dialogue: 0,0:12:51.24,0:12:55.81,Main,,0,0,0,,Ahmak kukla mı?!
Dialogue: 0,0:12:56.65,0:12:58.39,Main,,0,0,0,,Gösteririm sana ben!
Dialogue: 0,0:12:58.65,0:13:00.83,Main,,0,0,0,,Oyuna gelme, Trebol!
Dialogue: 0,0:13:00.89,0:13:02.03,Main,,0,0,0,,{\fad(150,150)}Oda!
Dialogue: 0,0:13:03.69,0:13:05.03,Main,,0,0,0,,Oda'nın içindesin!
Dialogue: 0,0:13:05.57,0:13:10.79,Main,,0,0,0,,Nefes bile zar zor alıyordu zaten \NBeta Beta'yla hareket etmesini de engelledim!
Dialogue: 0,0:13:11.04,0:13:13.77,Main,,0,0,0,,Ne yapabilir ki?!
Dialogue: 0,0:13:14.30,0:13:17.40,Main,,0,0,0,,Aç ağzını!
Dialogue: 0,0:13:17.58,0:13:18.50,Main,,0,0,0,,Yapma!
Dialogue: 0,0:13:19.62,0:13:22.16,Main,,0,0,0,,Seni küstah velet!
Dialogue: 0,0:13:24.52,0:13:29.35,Main,,0,0,0,,Bunu ağzına sokup\Nboğazını deleceğim!
Dialogue: 0,0:13:29.35,0:13:30.72,Main,,0,0,0,,Yapma!
Dialogue: 0,0:13:32.12,0:13:35.44,Main,,0,0,0,,Ben de bir gemi kaptanıyım!
Dialogue: 0,0:13:35.84,0:13:40.30,Main,,0,0,0,,İkinizi de Hasır Şapka-ya'ya bırakırsam...
Dialogue: 0,0:13:41.06,0:13:42.76,Main,,0,0,0,,...itibarım yerlebir olur!
Dialogue: 0,0:13:42.76,0:13:46.60,Main,,0,0,0,,Hareket bile edemiyorsun,\Nne yapabilirsin ki?!
Dialogue: 0,0:13:46.60,0:13:48.14,Main,,0,0,0,,Pis böcek!
Dialogue: 0,0:13:48.21,0:13:50.26,Main,,0,0,0,,Geber!
Dialogue: 0,0:13:53.23,0:13:54.20,Main,,0,0,0,,{\fad(150,150)}Takt!
Dialogue: 0,0:13:55.82,0:13:57.23,Main,,0,0,0,,Bu da ne?!
Dialogue: 0,0:13:59.36,0:14:00.30,Main,,0,0,0,,Kol mu?!
Dialogue: 0,0:14:03.62,0:14:04.64,Main,,0,0,0,,{\fad(150,150)}Sterben!
Dialogue: 0,0:14:03.62,0:14:04.64,Note,,0,0,0,,{\fad(150,150)}Ölüm Kılıcı
Dialogue: 0,0:14:13.60,0:14:19.71,Captions,,950,0,260,,{\fad(250,250)}4. Seviye\NAyçiçeği Tarlası
Dialogue: 0,0:14:21.68,0:14:23.13,Main,,0,0,0,,Ne oldu, Leo?
Dialogue: 0,0:14:25.22,0:14:28.53,Captions,,0,0,175,,{\fad(600,0)}GÜLÜCÜK Fabrikası
Dialogue: 0,0:14:30.46,0:14:35.14,Main,,0,0,0,,Ne oldu? Hepiniz birden\Nşehre doğru döndünüz.
Dialogue: 0,0:14:36.75,0:14:39.92,Main,,0,0,0,,Ne-Neden bilmiyorum ama...
Dialogue: 0,0:14:40.66,0:14:44.34,Main,,0,0,0,,...omuzlarımdan\Nbüyük bir yük kalkmış gibi oldu.
Dialogue: 0,0:14:45.75,0:14:48.90,Main,,0,0,0,,Öyle saçmalıklar için\Nzamanımız yok!
Dialogue: 0,0:14:50.54,0:14:52.70,Main,,0,0,0,,Fabrikayı başarıyla yok ettik!
Dialogue: 0,0:14:52.70,0:14:55.58,Main,,0,0,0,,Yaklaşan şu kafesten uzaklaşalım!
Dialogue: 0,0:14:55.29,0:14:57.63,Captions,,980,0,310,,{\fad(350,350)}Kraliyet Sarayı
Dialogue: 0,0:15:14.57,0:15:15.65,Main,,0,0,0,,O da ne?!
Dialogue: 0,0:15:15.94,0:15:19.20,Main,,0,0,0,,Onca sümüğün içinden\Nincecik biri çıktı!
Dialogue: 0,0:15:24.06,0:15:27.42,Main,,0,0,0,,Yumruğum bu yüzden\Niçinden geçip gidiyormuş demek ki!
Dialogue: 0,0:15:46.74,0:15:49.88,Main,,0,0,0,,Kahrolası Law...
Dialogue: 0,0:15:57.75,0:15:59.26,Main,,0,0,0,,Aptal herif!
Dialogue: 0,0:16:07.58,0:16:09.02,Main,,0,0,0,,Law...
Dialogue: 0,0:16:09.94,0:16:12.66,Main,,0,0,0,,Sen de benimle beraber öleceksin!
Dialogue: 0,0:16:14.70,0:16:16.74,Main,,0,0,0,,Eyvah, ateşe verecek!
Dialogue: 0,0:16:16.88,0:16:20.32,Main,,0,0,0,,Yanımda götüreceğim seni!
Dialogue: 0,0:16:33.98,0:16:36.42,Main,,0,0,0,,Kraliyet Sarayı alev aldı!
Dialogue: 0,0:16:39.12,0:16:41.12,Main,,0,0,0,,Luffy! Doflamingo!
Dialogue: 0,0:16:43.26,0:16:44.51,Main,,0,0,0,,Luffyland!
Dialogue: 0,0:16:44.51,0:16:48.10,Main,,0,0,0,,Ne durumdalar acaba?\NBir şekilde yardım etmeliyiz!
Dialogue: 0,0:16:49.02,0:16:52.84,Main,,0,0,0,,Karışmasanız daha iyi. Açık konuşmak\Ngerekirse ayakbağı olabilirsiniz.
Dialogue: 0,0:16:53.44,0:17:00.04,Main,,0,0,0,,Bakın! Doflamingo gibi Shichibukai\Nrütbesine sahip Law'un durumu da...
Dialogue: 0,0:17:01.20,0:17:02.50,Main,,0,0,0,,...hiç iyi değil!
Dialogue: 0,0:17:03.20,0:17:04.18,Main,,0,0,0,,Lawland!
Dialogue: 0,0:17:04.64,0:17:05.48,Main,,0,0,0,,Luffy!
Dialogue: 0,0:17:06.60,0:17:09.16,Main,,0,0,0,,Luffy!\NTrao-kun'u buraya yolla!
Dialogue: 0,0:17:09.16,0:17:10.70,Main,,0,0,0,,Robin, çok sağ ol!
Dialogue: 0,0:17:11.06,0:17:14.52,Main,,0,0,0,,Size emanet! Trao Mingo'yu\Nyeteri kadar köşeye sıkıştırdı!
Dialogue: 0,0:17:15.66,0:17:17.06,Main,,0,0,0,,Olamaz!\NKolu...
Dialogue: 0,0:17:18.20,0:17:21.47,Main,,0,0,0,,{\fad(150,150)}Yüz Çiçek!\NÖrümcek Ağı!
Dialogue: 0,0:17:37.55,0:17:39.49,Main,,0,0,0,,Lawland'ın kolu...
Dialogue: 0,0:17:39.94,0:17:43.18,Main,,0,0,0,,Ne kötü!\NTrao-kun, dayan!
Dialogue: 0,0:17:43.84,0:17:45.46,Main,,0,0,0,,Nico Robin!
Dialogue: 0,0:17:46.48,0:17:48.28,Main,,0,0,0,,Üstüne vazife olmayan şeyler yapma!
Dialogue: 0,0:17:49.02,0:17:50.80,Main,,0,0,0,,Hâlâ nefes alıyor!
Dialogue: 0,0:17:52.36,0:17:53.98,Main,,0,0,0,,Onunla işim bitmedi!
Dialogue: 0,0:17:55.22,0:17:56.40,Main,,0,0,0,,Doflamingo!
Dialogue: 0,0:17:56.40,0:17:58.84,Main,,0,0,0,,Lanet olası, hâlâ Trao'nun peşinde!
Dialogue: 0,0:17:58.84,0:18:00.12,Main,,0,0,0,,Sonun geldi!
Dialogue: 0,0:18:00.74,0:18:03.90,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:18:04.74,0:18:05.94,Main,,0,0,0,,{\fad(150,150)}Sicim Mermi!
Dialogue: 0,0:18:06.44,0:18:08.40,Main,,0,0,0,,{\fad(150,150)}...Şahin Kamçısı!
Dialogue: 0,0:18:09.64,0:18:10.55,Main,,0,0,0,,Lanet olsun!
Dialogue: 0,0:18:13.72,0:18:14.68,Main,,0,0,0,,Robiland!
Dialogue: 0,0:18:17.88,0:18:20.26,Main,,0,0,0,,Trao!\NRobin!
Dialogue: 0,0:18:23.58,0:18:25.93,Main,,0,0,0,,{\fad(150,150)}Değerli Metal Balta!
Dialogue: 0,0:18:29.78,0:18:30.98,Main,,0,0,0,,Kabak-kun!
Dialogue: 0,0:18:30.98,0:18:33.93,Main,,0,0,0,,Özür dilerim, yeni uyanabildim.
Dialogue: 0,0:18:34.76,0:18:38.10,Main,,0,0,0,,İşleri hâlâ yoluna\Nkoyamadın mı, Hasır Şapka?!
Dialogue: 0,0:18:40.34,0:18:41.88,Main,,0,0,0,,Kabak!
Dialogue: 0,0:18:42.44,0:18:45.92,Main,,0,0,0,,Herkesi al ve platodan uzaklaşın!
Dialogue: 0,0:18:46.43,0:18:47.80,Main,,0,0,0,,Yok artık daha neler!?
Dialogue: 0,0:18:47.80,0:18:50.88,Main,,0,0,0,,Hazır Doflamingo'yu karşıma almışken...
Dialogue: 0,0:18:51.22,0:18:53.46,Main,,0,0,0,,...ben de şöyle bir tane\Nyerleştirmek istiyorum!
Dialogue: 0,0:18:54.38,0:18:56.22,Main,,0,0,0,,Herkes sana emanet!
Dialogue: 0,0:18:57.96,0:18:58.66,Main,,0,0,0,,Ba...
Dialogue: 0,0:18:58.69,0:19:00.82,Main,,0,0,0,,Bana mı emanet?!
Dialogue: 0,0:19:02.90,0:19:04.02,Main,,0,0,0,,Güven...
Dialogue: 0,0:19:06.08,0:19:07.08,Main,,0,0,0,,Saygı...
Dialogue: 0,0:19:08.02,0:19:09.64,Main,,0,0,0,,Ün!
Dialogue: 0,0:19:13.32,0:19:15.83,Main,,0,0,0,,Hasır Şapka hayranlarımdan biri!
Dialogue: 0,0:19:18.74,0:19:20.82,Main,,0,0,0,,Hayranım benden bir şey istiyor!
Dialogue: 0,0:19:22.52,0:19:24.28,Main,,0,0,0,,Olmaz diyemem!
Dialogue: 0,0:19:25.12,0:19:27.68,Main,,0,0,0,,Bartolomeo aşağı katlardaydı!
Dialogue: 0,0:19:28.00,0:19:30.42,Main,,0,0,0,,Onun gücünü kullanarak\Nderhal uzaklaşırız buradan!
Dialogue: 0,0:19:38.12,0:19:40.14,Main,,0,0,0,,İyileştiremez misin, Leo?!
Dialogue: 0,0:19:40.52,0:19:42.83,Main,,0,0,0,,Kesik yer çok hırpalanmış!
Dialogue: 0,0:19:43.22,0:19:45.64,Main,,0,0,0,,Bir şekilde dikmeyi başarabilirsem...
Dialogue: 0,0:19:46.08,0:19:47.40,Main,,0,0,0,,O zaman...
Dialogue: 0,0:19:47.70,0:19:51.86,Main,,0,0,0,,...ben de Sulama Kabı'mla\Nonu iyileştirebilirim.
Dialogue: 0,0:19:52.68,0:19:55.60,Main,,0,0,0,,Her halükârda\NLucy'nin dediği gibi aşağı inelim!
Dialogue: 0,0:19:56.84,0:19:58.46,Main,,0,0,0,,Hey, Bartolomeo!
Dialogue: 0,0:19:58.88,0:20:00.50,Main,,0,0,0,,Bariyerinle merdiven yap!
Dialogue: 0,0:20:00.90,0:20:03.42,Main,,0,0,0,,Zoro-senpai!
Dialogue: 0,0:20:03.64,0:20:06.12,Main,,0,0,0,,Sonsuza dek!
Dialogue: 0,0:20:06.68,0:20:09.22,Main,,0,0,0,,Kime diyorum lan ben?!
Dialogue: 0,0:20:26.58,0:20:28.90,Main,,0,0,0,,Yetti ama artık.
Dialogue: 0,0:20:29.36,0:20:31.04,Main,,0,0,0,,Hasır Şapka.
Dialogue: 0,0:20:32.62,0:20:36.32,Main,,0,0,0,,Law ölemediği için acı çekiyor.
Dialogue: 0,0:20:37.13,0:20:39.82,Main,,0,0,0,,Acısına son vermek\Nherkes için en iyisi.
Dialogue: 0,0:20:40.22,0:20:44.13,Main,,0,0,0,,Onu beni yendikten sonra yaparsın!
Dialogue: 0,0:20:47.56,0:20:52.12,Main,,0,0,0,,Üflesem yıkılacak gibi duruyorsun.
Dialogue: 0,0:20:52.22,0:20:53.76,Main,,0,0,0,,Sen de öylesin!
Dialogue: 0,0:20:54.16,0:20:58.72,Main,,0,0,0,,Trao'nun yıkıcı saldırılarının sana hiç\Nzarar vermemiş olmasına imkan yok!
Dialogue: 0,0:21:12.00,0:21:14.54,Main,,0,0,0,,{\fad(150,150)}Bazuka!
Dialogue: 0,0:21:24.02,0:21:26.37,Main,,0,0,0,,Hızlı olmasına hızlısın da...
Dialogue: 0,0:21:27.42,0:21:30.43,Main,,0,0,0,,...güç konusunda sıkıntı çekiyorsun!
Dialogue: 0,0:21:31.70,0:21:33.10,Main,,0,0,0,,{\fad(150,150)}Kızgın!
Dialogue: 0,0:21:39.37,0:21:41.12,Main,,0,0,0,,Anılarım canlandı resmen!
Dialogue: 0,0:21:42.62,0:21:45.06,Flashbacks,,0,0,0,,Crocodile yenilmiş mi?
Dialogue: 0,0:21:46.00,0:21:49.04,Flashbacks,,0,0,0,,Hem de Donanma'nın\Nbir kaptanına?
Dialogue: 0,0:21:49.44,0:21:52.36,Flashbacks,,0,0,0,,Yok artık daha neler!\NVardır işin içinde bir iş.
Dialogue: 0,0:21:53.78,0:21:56.02,Flashbacks,,0,0,0,,Bak, bu işte!
Dialogue: 0,0:21:56.52,0:21:58.98,Flashbacks,,0,0,0,,Ödülü artmış!
Dialogue: 0,0:21:59.56,0:22:02.88,Flashbacks,,0,0,0,,Bu korsan grubunu araştırın.\NAdlarını ilk kez duyuyorum.
Dialogue: 0,0:22:03.34,0:22:06.28,Flashbacks,,0,0,0,,Monkey... "D." mi?
Dialogue: 0,0:22:07.96,0:22:12.60,Main,,0,0,0,,Sonra da uçarak geldiğin Yüce Savaş!
Dialogue: 0,0:22:17.24,0:22:22.58,Main,,0,0,0,,Hepsinden sağ kurtulup da buraya kadar\Ngelebilmene ziyadesiyle şaşırdım!
Dialogue: 0,0:22:42.97,0:22:43.94,Main,,0,0,0,,Bekle!
Dialogue: 0,0:22:45.50,0:22:47.52,Main,,0,0,0,,Uyandın demek, Trafalgar?!
Dialogue: 0,0:22:49.34,0:22:52.22,Main,,0,0,0,,Beni burada bırak!
Dialogue: 0,0:22:54.46,0:22:55.99,Main,,0,0,0,,Ne diyorsun sen?!
Dialogue: 0,0:22:58.62,0:23:00.82,Main,,0,0,0,,Geçtiğimiz 13 yılı...
Dialogue: 0,0:23:01.56,0:23:05.28,Main,,0,0,0,,...yalnızca Doflamingo'yu\Nöldürebilmek için yaşadım!
Dialogue: 0,0:23:18.72,0:23:22.94,Main,,0,0,0,,Ama elimden gelen her şeyi yaptım!
Dialogue: 0,0:23:25.12,0:23:29.58,Main,,0,0,0,,Gerisini Hasır Şapka-ya'ya\Nbırakmaktan başka seçeneğim yok!
Dialogue: 0,0:23:32.00,0:23:34.74,Main,,0,0,0,,Yenecekse...
Dialogue: 0,0:23:35.42,0:23:37.62,Main,,0,0,0,,...bunu kendi gözlerimle görmek isterim.
Dialogue: 0,0:23:44.74,0:23:49.90,Main,,0,0,0,,Olur da yenilirse,\Nben de burada...
Dialogue: 0,0:23:50.50,0:23:53.46,Main,,0,0,0,,...onunla birlikte ölürüm!
Dialogue: 0,0:24:18.33,0:24:19.65,Main,,0,0,0,,Onu...
Dialogue: 0,0:24:20.30,0:24:23.54,Main,,0,0,0,,...bu savaşa ben sürükledim!
Dialogue: 0,0:24:27.62,0:24:32.00,Main,,0,0,0,,Sonunu da kendi gözlerimle görmem lazım!\NBırak beni!
Dialogue: 0,0:24:34.26,0:24:36.10,Main,,0,0,0,,Trafalgar...
Dialogue: 0,0:24:36.50,0:24:37.57,Main,,0,0,0,,Trao-kun...
Dialogue: 0,0:24:38.20,0:24:41.46,Main,,0,0,0,,İttifak korsan gruplarının kaptanları\Nher konuda eşittirler.
Dialogue: 0,0:24:43.36,0:24:46.99,Main,,0,0,0,,Luffy,\Nkendi isteği doğrultusunda burada.
Dialogue: 0,0:24:47.94,0:24:50.44,Main,,0,0,0,,İstemeden savaşacak biri değil.
Dialogue: 0,0:24:52.86,0:24:54.22,Main,,0,0,0,,Bırak beni!
Dialogue: 0,0:24:54.60,0:24:55.72,Main,,0,0,0,,Lütfen!
Dialogue: 0,0:25:08.14,0:25:10.34,Main,,0,0,0,,Vazgeçirmek imkansız olacak anlaşılan...
Dialogue: 0,0:25:10.92,0:25:13.02,Main,,0,0,0,,Nico Robin, sen git.
Dialogue: 0,0:25:16.08,0:25:17.10,Main,,0,0,0,,Kabak-kun!
Dialogue: 0,0:25:19.78,0:25:22.12,Main,,0,0,0,,Bu tarz intihara meyilli istekleri\Nkabul edemem.
Dialogue: 0,0:25:22.86,0:25:24.13,Main,,0,0,0,,Ben de burada kalacağım.
Dialogue: 0,0:25:25.76,0:25:27.38,Main,,0,0,0,,Kabullen bunu.
Dialogue: 0,0:25:28.30,0:25:30.12,Main,,0,0,0,,Öleceksen...
Dialogue: 0,0:25:31.24,0:25:32.84,Main,,0,0,0,,...benden sonra ölürsün.
Dialogue: 0,0:25:34.56,0:25:37.15,Main,,0,0,0,,Robin-senpai!
Dialogue: 0,0:25:37.88,0:25:38.64,Main,,0,0,0,,Robin-san!
Dialogue: 0,0:25:39.00,0:25:41.72,Main,,0,0,0,,Bartolomeo merdiven yaptı!
Dialogue: 0,0:25:42.12,0:25:42.92,Main,,0,0,0,,Git.
Dialogue: 0,0:25:44.24,0:25:45.95,Main,,0,0,0,,Giy bunu.
Dialogue: 0,0:25:50.34,0:25:52.78,Main,,0,0,0,,{\fad(150,150)}Üçüncü Düzen!
Dialogue: 0,0:25:53.90,0:25:56.68,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:25:57.45,0:26:02.45,Main,,0,0,0,,{\fad(150,150)}...Boz Magnum!
Dialogue: 0,0:26:06.08,0:26:07.50,Main,,0,0,0,,Resmen saldır diye yalvarıyorsun!
Dialogue: 0,0:26:19.96,0:26:24.10,Main,,0,0,0,,Law'un saldırısının\Nboşa gitmesini istemiyorsun demek?
Dialogue: 0,0:26:26.62,0:26:29.14,Main,,0,0,0,,Beni yenmen...
Dialogue: 0,0:26:29.47,0:26:31.66,Main,,0,0,0,,...ne kadar sürecek acaba?
Dialogue: 0,0:26:32.36,0:26:35.82,Main,,0,0,0,,Bir saatlik zaman sınırından bahsederken...
Dialogue: 0,0:26:36.00,0:26:39.84,Main,,0,0,0,,...Kuş Kafesi'nin tamamen kapanacağı\Nsüreyi söylemiştim.
Dialogue: 0,0:26:44.84,0:26:47.68,Main,,0,0,0,,Bacaklarında sorun olan insanlar\Nvardır eminim.
Dialogue: 0,0:26:47.74,0:26:51.75,Main,,0,0,0,,Yatalaklar, \Ndaha meme emen bebekler de keza.
Dialogue: 0,0:26:55.58,0:26:58.73,Main,,0,0,0,,İlk kurban kim olacak?
Dialogue: 0,0:26:59.82,0:27:04.28,Main,,0,0,0,,30 dakika sonunda\Nbir yerlerde insanlar ölmeye başlayacak.
Dialogue: 0,0:27:04.84,0:27:10.34,Main,,0,0,0,,40 dakika sonunda\Nçığlıkları buradan duyabiliyor olacağız.
Dialogue: 0,0:27:10.92,0:27:13.10,Main,,0,0,0,,50 dakika sonunda...
Dialogue: 0,0:27:13.40,0:27:18.71,Main,,0,0,0,,...ezilmiş domatesler misali\Ntüm ülke kızıla boyanacak.
Dialogue: 0,0:27:23.16,0:27:28.98,Main,,0,0,0,,Bir saatin sonundaysa\Nçıt çıkmıyor olacak.
Dialogue: 0,0:27:31.08,0:27:36.58,Main,,0,0,0,,Dressrosa'ya olacaklar\Nseni ilgilendirmiyor sonuçta...
Dialogue: 0,0:27:36.58,0:27:40.84,Main,,0,0,0,,...ama ölecek insanlar\Nsize kin güdecekler.
Dialogue: 0,0:27:42.18,0:27:47.94,Main,,0,0,0,,Siz gelene kadar\NDressrosa güllük gülistanlıktı!
Dialogue: 0,0:27:48.58,0:27:51.58,Main,,0,0,0,,Yalancı!\NGörünüşte öyleydi!
Dialogue: 0,0:28:02.62,0:28:05.96,Main,,0,0,0,,Şanssız insan arıyorsan\Nher yerde bulursun.
Dialogue: 0,0:28:06.20,0:28:08.48,Main,,0,0,0,,Her birini kurtarmaya ömrün yetmez.
Dialogue: 0,0:28:09.24,0:28:13.48,Main,,0,0,0,,Buradan gelip geçen korsanın tekisin,\Nkahraman olmaya mı çalışıyorsun?
Dialogue: 0,0:28:14.28,0:28:16.73,Main,,0,0,0,,Ne cüretle yoluma çıkarsın?!
Dialogue: 0,0:28:17.06,0:28:20.30,Main,,0,0,0,,Asıl sen benim yoluma çıktın!
Dialogue: 0,0:28:22.12,0:28:27.00,Main,,0,0,0,,Dostlarımı ağlattın, \Ntayfamı kızdırdın!
Dialogue: 0,0:28:32.26,0:28:34.74,Main,,0,0,0,,Buna rağmen hâlâ ayaktasın,...
Dialogue: 0,0:28:34.92,0:28:36.82,Main,,0,0,0,,...o yüzden her şeyi ben üstleniyorum!
Dialogue: 0,0:28:37.20,0:28:39.44,Main,,0,0,0,,Kimsenin ölmesine izin vermeyeceğim!
Dialogue: 0,0:28:44.30,0:28:47.66,Main,,0,0,0,,Sen ve şu Kuş Kafesi'n\Nönümde engelsiniz!
Dialogue: 0,0:28:51.06,0:28:52.08,Main,,0,0,0,,Dördüncü...
Dialogue: 0,0:28:52.57,0:28:55.60,OP11 Credits,,0,0,0,,Editing:\N Galaxy 9000\N\NTiming:\N Datenshi\NSewil (Opening)\N\NQuality Assurance:\N Feeso,\NGalaxy 9000,\NMr. Luffy,\NGrug,\NDatenshi\N\NSoundtracking:\N Halee\N\NTC/Infoboxes:\N Datenshi\N\NTranslation:\NYibis
Dialogue: 0,0:28:53.64,0:28:54.98,Main,,0,0,0,,...Düzen!
