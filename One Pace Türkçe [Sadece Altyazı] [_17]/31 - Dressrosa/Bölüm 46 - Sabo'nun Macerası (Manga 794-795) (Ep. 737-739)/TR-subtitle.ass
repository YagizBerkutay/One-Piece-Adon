Dialogue: 0,0:01:42.72,0:01:45.78,Title,,0,0,240,,{\fad(500,500)}Sabo'nun Macerası
Dialogue: 0,0:01:45.80,0:01:50.27,Captions,,0,0,240,,{\fad(800,0)}Dressrosa'nın Doğusundaki Şehir\NCarta'da Bir Tepe
Dialogue: 0,0:01:55.14,0:01:57.82,Captions,,0,0,175,,{\fad(500,0)}Kyros'un Evi
Dialogue: 0,0:02:01.88,0:02:04.25,Main,,0,0,0,,Devrim Ordusu'ndan\Ntanıyorsun demek?
Dialogue: 0,0:02:04.25,0:02:04.86,Main,,0,0,0,,Evet.
Dialogue: 0,0:02:05.60,0:02:06.17,Main,,0,0,0,,Luffy...
Dialogue: 0,0:02:06.17,0:02:08.70,Main,,0,0,0,,Robin, boşver uyandırma.
Dialogue: 0,0:02:09.26,0:02:11.92,Main,,0,0,0,,Gitmeden önce\Nyüzünü bir göreyim istedim.
Dialogue: 0,0:02:16.02,0:02:17.79,Main,,0,0,0,,Bu kadar erken mi ayrılıyorsunuz?
Dialogue: 0,0:02:17.79,0:02:21.75,Main,,0,0,0,,Evet. Can sıkıcı birileri\Nburaya geri dönüyor.
Dialogue: 0,0:02:21.75,0:02:23.08,Main,,0,0,0,,Kimmiş onlar?
Dialogue: 0,0:02:23.08,0:02:24.26,Main,,0,0,0,,CP-0.
Dialogue: 0,0:02:27.74,0:02:31.82,Main,,0,0,0,,Doflamingo'nun sahte istifasında da\Nonların parmağı vardı.
Dialogue: 0,0:02:49.94,0:02:52.80,Main,,0,0,0,,Hedefleri biziz.
Dialogue: 0,0:02:57.88,0:03:01.56,Main,,0,0,0,,Birkaç güne\NDressrosa epey kalabalıklaşacak.
Dialogue: 0,0:03:01.56,0:03:04.36,Main,,0,0,0,,Siz de en kısa zamanda\Nuzaklaşmaya bakın.
Dialogue: 0,0:03:05.32,0:03:07.14,Main,,0,0,0,,Uyardığın için çok sağ ol.
Dialogue: 0,0:03:07.70,0:03:11.68,Main,,0,0,0,,Onu geçtim de, Ace'den başka\Nağabeyi olduğunu bilmiyordum.
Dialogue: 0,0:03:11.68,0:03:14.37,Main,,0,0,0,,Al benden de o kadar,\Nilk defa duyuyorum.
Dialogue: 0,0:03:14.37,0:03:15.48,Main,,0,0,0,,Öyledir.
Dialogue: 0,0:03:16.46,0:03:18.76,Main,,0,0,0,,Eminim en çok şaşıran da\NLuffy olmuştur.
Dialogue: 0,0:03:20.34,0:03:22.50,Main,,0,0,0,,Nasıl yani?
Dialogue: 0,0:03:22.50,0:03:26.06,Main,,0,0,0,,Beni uzun bir süredir öldü biliyordu.
Dialogue: 0,0:03:27.80,0:03:32.90,Main,,0,0,0,,Luffy ve Ace'le\Nçocukken hep beraberdik.
Dialogue: 0,0:03:33.46,0:03:38.78,Main,,0,0,0,,Üçümüz ortalığı birbirine katar,\Nihtiyar Garp'ın sağlam sopasını yer...
Dialogue: 0,0:03:38.78,0:03:41.08,Main,,0,0,0,,...korsan olma hayalleri kurardık.
Dialogue: 0,0:03:55.44,0:03:59.30,Main,,0,0,0,,Üçümüz sakemizi paylaşıp\Nkardeş olduk.
Dialogue: 0,0:04:04.60,0:04:08.10,Main,,0,0,0,,Ama ben günün birinde\Nbir kazaya karıştım.
Dialogue: 0,0:04:08.10,0:04:10.47,Main,,0,0,0,,Kazadan ziyade\Nolay demek daha doğru olur.
Dialogue: 0,0:04:12.38,0:04:14.52,Thoughts,,0,0,0,,Ace! Luffy!
Dialogue: 0,0:04:14.52,0:04:17.60,Thoughts,,0,0,0,,{\i1}Bu şehirde tuhaf bir şeyler oluyor!\NHerkes kafayı üşütmüş!{\i0}
Dialogue: 0,0:04:18.32,0:04:23.63,Thoughts,,0,0,0,,{\i1}İnsanların öleceğini bilmelerine rağmen\Nhiçbir şey yokmuş gibi gülmeye devam ediyorlar!{\i0}
Dialogue: 0,0:04:23.63,0:04:25.81,Thoughts,,0,0,0,,{\i1}Böyle bir yerde yaşamak istemiyorum!
Dialogue: 0,0:04:25.81,0:04:27.66,Thoughts,,0,0,0,,{\i1}Hemen onlara haber vermem lazım!
Dialogue: 0,0:04:30.90,0:04:33.74,Main,,0,0,0,,Ace! Luffy!\NKaçın!
Dialogue: 0,0:04:42.76,0:04:44.84,Main,,0,0,0,,Ne oldu, genç?
Dialogue: 0,0:04:51.80,0:04:57.03,Main,,0,0,0,,Bu şehir Gri Terminal'den de\Niğrenç kokuyor.
Dialogue: 0,0:04:57.64,0:05:01.41,Main,,0,0,0,,Kokuşup giden insanların kokusu bu!
Dialogue: 0,0:05:03.16,0:05:08.16,Main,,0,0,0,,Burada kalırsam\Nasla özgür olamayacağım!
Dialogue: 0,0:05:17.62,0:05:20.16,Thoughts,,0,0,0,,Ace... Luffy...
Dialogue: 0,0:05:20.86,0:05:24.22,Thoughts,,0,0,0,,{\i1}Keşke yanınızda olabilsem.{\i0}
Dialogue: 0,0:05:25.72,0:05:27.88,Thoughts,,0,0,0,,{\i1}Bu yerin Kuş Kafesi'nden farkı yok!{\i0}
Dialogue: 0,0:05:28.66,0:05:34.52,Thoughts,,0,0,0,,{\i1}Bu bayatlamış şehre koca bir ömür\Nkatlanabileceğimi sanmıyorum.{\i0}
Dialogue: 0,0:05:40.38,0:05:42.90,Thoughts,,0,0,0,,{\i1}Özgürlük ne?{\i0}
Dialogue: 0,0:05:43.82,0:05:45.52,Thoughts,,0,0,0,,{\i1}Nerede bulurum onu?{\i0}
Dialogue: 0,0:05:57.94,0:06:00.60,Thoughts,,0,0,0,,{\i1}Ace... Luffy...{\i0}
Dialogue: 0,0:06:01.86,0:06:05.21,Thoughts,,0,0,0,,{\i1}Yardım edecek... kimse yok mu...{\i0}
Dialogue: 0,0:06:05.21,0:06:06.32,Thoughts,,0,0,0,,{\i1}Yardım...{\i0}
Dialogue: 0,0:06:25.48,0:06:27.76,Main,,0,0,0,,Geciktin be, Dragon!
Dialogue: 0,0:06:27.76,0:06:30.26,Main,,0,0,0,,Bizi daha ne kadar bekletmeyi planlıyordun?!
Dialogue: 0,0:06:30.26,0:06:31.24,Main,,0,0,0,,Kusura bakma.
Dialogue: 0,0:06:31.24,0:06:33.44,Main,,0,0,0,,O elindeki...
Dialogue: 0,0:06:36.28,0:06:38.23,Main,,0,0,0,,Çok kötü olmuş...
Dialogue: 0,0:06:38.23,0:06:41.31,Main,,0,0,0,,Hemen tedavi etmek lazım! \NÇok acil!
Dialogue: 0,0:06:41.31,0:06:43.03,Main,,0,0,0,,Doktoru çağırın! Acele!
Dialogue: 0,0:06:47.82,0:06:49.18,Main,,0,0,0,,Uyandı!
Dialogue: 0,0:06:50.62,0:06:52.31,Main,,0,0,0,,Korkutma çocuğu.
Dialogue: 0,0:06:52.31,0:06:54.75,Main,,0,0,0,,Amacım o değildi!
Dialogue: 0,0:06:54.75,0:06:56.60,Main,,0,0,0,,Öf ya, ne kabasın!
Dialogue: 0,0:07:00.96,0:07:01.81,Main,,0,0,0,,Ne?
Dialogue: 0,0:07:03.66,0:07:04.88,Main,,0,0,0,,Neredeyim?
Dialogue: 0,0:07:04.88,0:07:06.75,Main,,0,0,0,,Gemimizdesin.
Dialogue: 0,0:07:10.20,0:07:14.41,Main,,0,0,0,,Eşyalarında Sabo yazıyordu ama, \Nadın bu mu?
Dialogue: 0,0:07:14.98,0:07:16.13,Main,,0,0,0,,Sabo...
Dialogue: 0,0:07:17.68,0:07:18.61,Main,,0,0,0,,Bilmiyorum.
Dialogue: 0,0:07:18.61,0:07:22.40,Main,,0,0,0,,Bilmiyor musun?\NAdın ne peki?
Dialogue: 0,0:07:24.50,0:07:26.12,Main,,0,0,0,,Bilemiyorum...
Dialogue: 0,0:07:26.12,0:07:28.05,Main,,0,0,0,,Yoksa o...
Dialogue: 0,0:07:28.05,0:07:29.06,Main,,0,0,0,,Öyle gibi.
Dialogue: 0,0:07:32.18,0:07:34.80,Main,,0,0,0,,Hiçbir şey hatırlamıyor ha?
Dialogue: 0,0:07:34.80,0:07:37.29,Main,,0,0,0,,Evet, adını bile...
Dialogue: 0,0:07:37.29,0:07:42.79,Main,,0,0,0,,Onunla ilk defa Goa Krallığı'nın\NDağlık Bölgesi'nde karşılaşmıştım.
Dialogue: 0,0:07:42.79,0:07:46.21,Main,,0,0,0,,Oradaki asillerden biridir.
Dialogue: 0,0:07:46.21,0:07:49.72,Main,,0,0,0,,Öyleyse onu geri götürüp\Nailesini arayalım...
Dialogue: 0,0:07:52.68,0:07:53.67,Main,,0,0,0,,Hayır.
Dialogue: 0,0:07:53.67,0:07:55.27,Main,,0,0,0,,Geri dönmek istemiyorum!
Dialogue: 0,0:07:55.27,0:07:56.82,Main,,0,0,0,,Neden?!
Dialogue: 0,0:07:56.82,0:07:58.09,Main,,0,0,0,,Bilmiyorum!
Dialogue: 0,0:07:59.56,0:08:00.71,Main,,0,0,0,,Ama...
Dialogue: 0,0:08:00.71,0:08:04.25,Main,,0,0,0,,...geri dönmek istemediğime eminim!
Dialogue: 0,0:08:04.25,0:08:08.34,Main,,0,0,0,,İki yıl öncesine kadar\Nhiçbir şey hatırlamıyordun demek?
Dialogue: 0,0:08:08.34,0:08:09.22,Main,,0,0,0,,Evet...
Dialogue: 0,0:08:09.22,0:08:12.88,Main,,0,0,0,,Durum madem bu kadar ciddiydi,\Nnasıl oldu da hafızanı geri kazandın?
Dialogue: 0,0:08:13.60,0:08:15.58,Main,,0,0,0,,Ace yardımcı oldu.
Dialogue: 0,0:08:18.06,0:08:19.54,Main,,0,0,0,,En azından ben buna inanıyorum.
Dialogue: 0,0:08:19.42,0:08:20.37,Main,,0,0,0,,{\fad(0,300)\fs70\bord0\blur1.2\fsp3\c&H555156&\fscx105\frz326\pos(320,510)\t(344,792,\c&H060606&)}Ateş Yumruk Ace Öldü
Dialogue: 0,0:08:22.38,0:08:24.96,Main,,0,0,0,,Zamanlama daha kötü olamazdı belki...
Dialogue: 0,0:08:30.00,0:08:31.40,Main,,0,0,0,,...ama...
Dialogue: 0,0:08:31.99,0:08:34.38,Main,,0,0,0,,...hafızamı geti getiren\No oldu.
Dialogue: 0,0:08:43.41,0:08:47.10,Captions,,0,0,240,,{\fad(450,0)}Baltigo\NDevrim Ordusu Genel Karargâhı
Dialogue: 0,0:08:51.38,0:08:52.69,Main,,0,0,0,,Etraf epey hareketli.
Dialogue: 0,0:08:52.69,0:08:55.39,Main,,0,0,0,,Kurmay Başkanı,\Ntam zamanında geldiniz!
Dialogue: 0,0:08:55.39,0:08:57.21,Main,,0,0,0,,Derhal durum odasına gelin!
Dialogue: 0,0:08:57.21,0:09:01.80,Main,,0,0,0,,Donanma ve Beyazsakal Korsanları\Narasındaki Büyük Savaş sona ermiş!
Dialogue: 0,0:09:03.16,0:09:05.23,Main,,0,0,0,,Beyazsakal yenildi mi?!
Dialogue: 0,0:09:05.23,0:09:07.37,Main,,0,0,0,,Ivan-san peki? \NO iyi mi?!
Dialogue: 0,0:09:07.37,0:09:10.01,Main,,0,0,0,,Öldüğünü söylemiyor.
Dialogue: 0,0:09:10.01,0:09:12.05,Main,,0,0,0,,Savaşta ölenler...
Dialogue: 0,0:09:12.72,0:09:15.39,Main,,0,0,0,,...Yonkou Beyazsakal...
Dialogue: 0,0:09:15.39,0:09:16.89,Main,,0,0,0,,Ve...
Dialogue: 0,0:09:16.89,0:09:18.42,Main,,0,0,0,,...Ateş Yumruk Ace!
Dialogue: 0,0:09:25.04,0:09:28.14,Main,,0,0,0,,Şuna bir bak Dragon-san...
Dialogue: 0,0:09:28.14,0:09:32.76,Main,,0,0,0,,Gerçekten de Hasır Şapkalı Luffy\Nsenin oğlun mu?!
Dialogue: 0,0:09:33.70,0:09:34.76,Main,,0,0,0,,Evet.
Dialogue: 0,0:09:59.38,0:10:00.92,Flashbacks,,0,0,0,,Korsan olup...
Dialogue: 0,0:10:06.16,0:10:10.00,Flashbacks,,0,0,0,,...herkesleri yenecek\Nve dünyanın en ünlüsü olacağım!
Dialogue: 0,0:10:10.96,0:10:13.65,Flashbacks,,0,0,0,,Yaşadığımın kanıtı olacak bu!
Dialogue: 0,0:10:34.54,0:10:36.10,Main,,0,0,0,,Sabo-kun, ne oldu?!
Dialogue: 0,0:10:39.48,0:10:40.48,Main,,0,0,0,,Tuhaf davranıyorsun!
Dialogue: 0,0:10:51.46,0:10:53.05,Flashbacks,,0,0,0,,Biliyor muydunuz beyler?
Dialogue: 0,0:10:54.82,0:10:58.24,Main,,0,0,0,,Akainu yumruğuyla\NAce'in vücudunda delik açmış.
Dialogue: 0,0:11:05.02,0:11:07.82,Flashbacks,,0,0,0,,Sakelerimizi paylaşırsak kardeş olabiliriz!
Dialogue: 0,0:11:08.92,0:11:12.27,Flashbacks,,0,0,0,,Nereye gider, her ne yaparsanız yapın\Nkopmayacak bir bağ!
Dialogue: 0,0:11:15.82,0:11:17.98,Flashbacks,,0,0,0,,Bugünden öte...
Dialogue: 0,0:11:18.78,0:11:19.91,Flashbacks,,0,0,0,,...kardeşiz!
Dialogue: 0,0:11:26.36,0:11:27.86,Flashbacks,,0,0,0,,Evet!
Dialogue: 0,0:11:36.54,0:11:38.12,Main,,0,0,0,,İyi misin, Sabo?!
Dialogue: 0,0:11:51.94,0:11:52.77,Main,,0,0,0,,Sabo-kun!
Dialogue: 0,0:11:52.77,0:11:53.72,Main,,0,0,0,,Sabo!
Dialogue: 0,0:11:55.96,0:11:57.14,Thoughts,,0,0,0,,{\i1}Hatırlıyorum!{\i0}
Dialogue: 0,0:11:58.54,0:12:01.82,Thoughts,,0,0,0,,{\i1}Ölen kişi\Nfalanca bir korsan değil benim için...{\i0}
Dialogue: 0,0:12:06.78,0:12:11.98,Thoughts,,0,0,0,,{\i1}Korsan Çağı'nda ortadan\Nkaldırılması gereken bir tehdit değil...{\i0}
Dialogue: 0,0:12:15.38,0:12:18.33,Thoughts,,0,0,0,,{\i1}Ace benim...{\i0}
Dialogue: 0,0:12:19.20,0:12:21.18,Thoughts,,0,0,0,,{\i1}...kardeşimdi!{\i0}
Dialogue: 0,0:12:33.12,0:12:37.14,Flashbacks,,0,0,0,,Kimseden kaçmayacak,\Nkimseye de yenilmeyeceğim!
Dialogue: 0,0:12:45.20,0:12:47.17,Main,,0,0,0,,Şef uyandı!
Dialogue: 0,0:12:47.17,0:12:49.44,Main,,0,0,0,,Harbi mi?! \NŞükürler olsun!
Dialogue: 0,0:12:59.02,0:13:02.60,Main,,0,0,0,,Öleceksin sandım, Sabo-kun!
Dialogue: 0,0:13:04.20,0:13:06.42,Main,,0,0,0,,Cayır cayır yanıyordun, Sabo.
Dialogue: 0,0:13:07.06,0:13:09.65,Main,,0,0,0,,Üç gündür gözünü açmadın!
Dialogue: 0,0:13:09.65,0:13:12.42,Main,,0,0,0,,Çok endişelendim!
Dialogue: 0,0:13:17.74,0:13:19.98,Main,,0,0,0,,Hafızan geri mi geldi?!
Dialogue: 0,0:13:21.78,0:13:24.94,Main,,0,0,0,,Evet, her şeyi hatırlıyorum.
Dialogue: 0,0:13:24.94,0:13:30.72,Main,,0,0,0,,Kim olduğumu, neden evi terk edip\Ndenize yelken açtığımı da.
Dialogue: 0,0:13:33.66,0:13:35.80,Main,,0,0,0,,Anlıyorum, ne güzel.
Dialogue: 0,0:13:36.98,0:13:38.94,Main,,0,0,0,,Devrim Ordusu'nu bırakacak mısın peki?!
Dialogue: 0,0:13:42.94,0:13:44.66,Main,,0,0,0,,Hayır, bırakmayacağım.
Dialogue: 0,0:13:47.46,0:13:49.29,Main,,0,0,0,,Dragon-san hâlâ burada mı?
Dialogue: 0,0:13:49.29,0:13:49.92,Main,,0,0,0,,Evet.
Dialogue: 0,0:13:51.48,0:13:53.03,Main,,0,0,0,,Onunla konuşmam gereken bir şey var.
Dialogue: 0,0:14:08.86,0:14:12.44,Main,,0,0,0,,O an Ace'in bana\Nsanki şunları fısıldadığını hissettim...
Dialogue: 0,0:14:12.44,0:14:16.38,Main,,0,0,0,,"Adın Sabo.\NLuffy'le kardeşimizsin!"
Dialogue: 0,0:14:39.56,0:14:43.50,Main,,0,0,0,,Sonunda geldim, Ace.
Dialogue: 0,0:14:45.46,0:14:46.70,Main,,0,0,0,,Şuna bak!
Dialogue: 0,0:14:46.70,0:14:51.02,Main,,0,0,0,,Luffy Korsanlar Kralı\Nolma yolculuğuna yeniden başlamış.
Dialogue: 0,0:14:52.06,0:14:54.28,Main,,0,0,0,,Kimin kardeşi!
Dialogue: 0,0:14:53.74,0:14:55.58,Note,,0,0,0,,Başlık: Hasır Şapkalar Geri Döndü
Dialogue: 0,0:15:16.80,0:15:17.92,Main,,0,0,0,,{\i1}Sabo-kun?{\i0}
Dialogue: 0,0:15:17.92,0:15:20.31,Main,,0,0,0,,Tüm Devrim Ordusu'ndan\Nbir iyilik isteyeceğim.
Dialogue: 0,0:15:21.04,0:15:23.86,Main,,0,0,0,,Ne pahasına olursa olsun elde etmek\Nistediğim bir Şeytan Meyvesi mevcut.
Dialogue: 0,0:15:25.70,0:15:27.62,Main,,0,0,0,,Fakat Luffy-senpai,...
Dialogue: 0,0:15:23.93,0:15:27.50,Captions,,1000,0,320,,{\fad(250,250)}Dressrosa
Dialogue: 0,0:15:27.62,0:15:29.42,Main,,0,0,0,,...Mera Mera Meyvesi ne olacak?
Dialogue: 0,0:15:29.42,0:15:32.54,Main,,0,0,0,,Bazı kişilerin eline geçmesini\Nistemiyorum elbette ama yapacak bir şey yok!
Dialogue: 0,0:15:32.54,0:15:34.55,Main,,0,0,0,,Dostumun hayatı söz konusu!
Dialogue: 0,0:15:37.48,0:15:40.97,Main,,0,0,0,,Mera Mera Meyvesi'ni \Nmutlaka kazanacağıma söz veriyorum.
Dialogue: 0,0:15:40.97,0:15:43.55,Main,,0,0,0,,İçin rahat olsun!
Dialogue: 0,0:15:43.55,0:15:45.30,Main,,0,0,0,,Hadi ya!\NBak bu çok iyi oldu!
Dialogue: 0,0:15:51.92,0:15:54.56,Main,,0,0,0,,Mera Mera Meyvesi'ni\Nsana kaptırmam!
Dialogue: 0,0:15:57.90,0:16:00.01,Main,,0,0,0,,"Hasır Şapkalı Luffy!"
Dialogue: 0,0:16:01.40,0:16:03.97,Main,,0,0,0,,Hop hop!\NSen de kimsin?!
Dialogue: 0,0:16:03.97,0:16:07.32,Main,,0,0,0,,Luffy-senpai'yle\Nöyle nasıl konuşabiliyorsun?!
Dialogue: 0,0:16:07.32,0:16:12.67,Main,,0,0,0,,Konuştuğun kişi efsanevi korsan\NAteş Yumruk Ace-sama'nın kardeşi ve...
Dialogue: 0,0:16:12.67,0:16:16.77,Main,,0,0,0,,...gelecekteki Korsanlar Kralı olur,\Nduydun mu beni?!
Dialogue: 0,0:16:16.77,0:16:19.00,Main,,0,0,0,,Bunu uzun zamandır biliyorum.
Dialogue: 0,0:16:28.16,0:16:29.51,Main,,0,0,0,,Ne istiyorsun be?!
Dialogue: 0,0:16:29.51,0:16:32.73,Main,,0,0,0,,Birden öyle ortaya çıkıp da\NMera Mera'yı sana kaptırmam da ne demek?!
Dialogue: 0,0:16:41.48,0:16:43.44,Main,,0,0,0,,Benim, Luffy.
Dialogue: 0,0:16:46.00,0:16:47.63,Main,,0,0,0,,O da ne demek şimdi?!
Dialogue: 0,0:16:47.63,0:16:50.94,Main,,0,0,0,,Bana bak, Mera Mera Meyvesi\NAce'den bir yadigâr!
Dialogue: 0,0:16:50.94,0:16:52.20,Main,,0,0,0,,Amacın oysa\Ndüşmanımsın demektir!
Dialogue: 0,0:16:53.20,0:16:55.75,Main,,0,0,0,,Hem bana Luffy dedin ama...
Dialogue: 0,0:16:55.75,0:16:57.49,Main,,0,0,0,,...sakalımı görmüyor musun?!
Dialogue: 0,0:16:57.49,0:16:59.12,Main,,0,0,0,,Adım Lucy benim!
Dialogue: 0,0:16:59.12,0:17:03.30,Main,,0,0,0,,Kılık değiştirdi diye kardeşimin\Nyüzünü hatırlamayacak değilim ya!
Dialogue: 0,0:17:03.88,0:17:05.41,Main,,0,0,0,,"Kardeş mi"?
Dialogue: 0,0:17:05.41,0:17:08.15,Main,,0,0,0,,Bana kardeşim diyebilecek yegâne kişiler...
Dialogue: 0,0:17:08.15,0:17:09.57,Main,,0,0,0,,...ölen Ace ve...
Dialogue: 0,0:17:09.57,0:17:11.31,Main,,0,0,0,,...ondan çok önce ölmüş olan...
Dialogue: 0,0:17:27.00,0:17:29.66,Main,,0,0,0,,Sabo!
Dialogue: 0,0:17:34.32,0:17:35.50,Main,,0,0,0,,Yok artık!
Dialogue: 0,0:17:39.62,0:17:43.40,Main,,0,0,0,,Dadan'dan bir şişe sake çalıp da\Nbardak tokuşturmuştuk!
Dialogue: 0,0:17:48.98,0:17:51.38,Main,,0,0,0,,Sabo!
Dialogue: 0,0:18:00.88,0:18:04.77,Main,,0,0,0,,Bu ne şimdi ya...\NNerelerdeydin?!
Dialogue: 0,0:18:04.77,0:18:07.58,Main,,0,0,0,,Öldün sandım!
Dialogue: 0,0:18:11.68,0:18:13.62,Main,,0,0,0,,Teşekkür ederim, Luffy!
Dialogue: 0,0:18:15.00,0:18:17.54,Main,,0,0,0,,Hayatta olduğuna sevindim!
Dialogue: 0,0:18:23.84,0:18:26.72,Main,,0,0,0,,Ama Sabo, ben...
Dialogue: 0,0:18:26.72,0:18:30.10,Main,,0,0,0,,Ace'in gözlerimin önünde\Nöldürülmesine izin verdim...
Dialogue: 0,0:18:30.72,0:18:34.74,Main,,0,0,0,,Biliyorum!\NAce öldü ama en azından...
Dialogue: 0,0:18:35.98,0:18:37.74,Main,,0,0,0,,...sen hayattasın!
Dialogue: 0,0:18:38.80,0:18:42.86,Main,,0,0,0,,Farkında bile olmadan\Niki kardeşimi de yitiriyordum!
Dialogue: 0,0:18:44.22,0:18:48.58,Main,,0,0,0,,Sen de ölseydin\Nyapayalnız kalacaktım!
Dialogue: 0,0:19:06.12,0:19:07.43,Main,,0,0,0,,Teşekkür ederim!
Dialogue: 0,0:19:10.14,0:19:13.22,Main,,0,0,0,,Hayatta olduğun için\Nteşekkür ederim, Luffy!
Dialogue: 0,0:19:22.48,0:19:25.84,Main,,0,0,0,,Mera Mera Meyvesi'ni\Nben yiyebilir miyim?
Dialogue: 0,0:19:27.70,0:19:29.00,Main,,0,0,0,,Evet! Evet!
Dialogue: 0,0:19:30.60,0:19:34.07,Main,,0,0,0,,Harika olur!\NHatta başka türlüsü olmazdı!
Dialogue: 0,0:19:42.46,0:19:45.00,Main,,0,0,0,,Luffy hergelesi gülüyor...
Dialogue: 0,0:19:46.58,0:19:48.62,Main,,0,0,0,,Nasıl bir rüya görüyor kim bilir.
Dialogue: 0,0:19:52.50,0:19:53.39,Main,,0,0,0,,Kalkayım ben.
Dialogue: 0,0:19:53.39,0:19:54.36,Main,,0,0,0,,Bu kadarcık mıydı?
Dialogue: 0,0:19:54.36,0:19:55.95,Main,,0,0,0,,Onu gördüm sonuçta...
Dialogue: 0,0:19:55.95,0:19:59.04,Main,,0,0,0,,Luffy'nin Yaşam Kağıdı'nı yaptım.
Dialogue: 0,0:19:59.63,0:20:02.22,Main,,0,0,0,,Ne ara fırsat buldun?
Dialogue: 0,0:20:02.22,0:20:03.65,Main,,0,0,0,,Bir parça alıyorum.
Dialogue: 0,0:20:06.20,0:20:09.35,Main,,0,0,0,,Haydi öyleyse...\NLuffy baş etmesi zor biri olabilir...
Dialogue: 0,0:20:09.35,0:20:10.74,Main,,0,0,0,,...ama size emanet.
Dialogue: 0,0:20:13.42,0:20:15.44,Main,,0,0,0,,Tamamdır!\NBize güvenebilirsin!
Dialogue: 0,0:20:19.82,0:20:22.18,Main,,0,0,0,,Ace de aynı şeyleri söylemişti.
Dialogue: 0,0:20:28.50,0:20:30.71,Main,,0,0,0,,{\i1}Orada mısın Sabo?\NHack ben.{\i0}
Dialogue: 0,0:20:30.71,0:20:33.74,Main,,0,0,0,,Evet, tam da dışarı çıkmıştım.\NHemen geliyorum.
Dialogue: 0,0:20:33.74,0:20:35.02,Main,,0,0,0,,Pekâlâ.
Dialogue: 0,0:20:35.02,0:20:38.28,Main,,0,0,0,,Nasıldı peki?\NLuffy-kun epey...
Dialogue: 0,0:20:43.44,0:20:45.66,Main,,0,0,0,,Niye kapatıyorsun be bencil insan!?
Dialogue: 0,0:20:46.44,0:20:47.82,Main,,0,0,0,,Dikkat ol, Hack-san!
Dialogue: 0,0:21:02.64,0:21:04.37,Main,,0,0,0,,İstediğimiz an ayrılabilir miyiz?
Dialogue: 0,0:21:04.37,0:21:06.27,Main,,0,0,0,,Evet.
Dialogue: 0,0:21:06.27,0:21:07.38,Main,,0,0,0,,Pekâlâ öyleyse!
Dialogue: 0,0:21:07.38,0:21:11.60,Main,,0,0,0,,Baltigo'ya dönünce Dragon-san'a \NLuffy'le ilgili anlatacağım tonla şey olacak!
Dialogue: 0,0:21:13.56,0:21:15.16,Thoughts,,0,0,0,,Seni gördüğüme...
Dialogue: 0,0:21:15.16,0:21:17.22,Thoughts,,0,0,0,,...gerçekten çok sevindim!
Dialogue: 0,0:21:18.74,0:21:19.62,Main,,0,0,0,,Acele edelim!
Dialogue: 0,0:21:27.05,0:21:29.90,Captions,,50,0,340,,{\fad(250,250)}Dressrosa
Dialogue: 0,0:21:33.42,0:21:37.54,Main,,0,0,0,,Ne geldi?\NSöyler misin?
Dialogue: 0,0:21:37.54,0:21:38.48,Main,,0,0,0,,Bir...
Dialogue: 0,0:21:39.08,0:21:43.61,Main,,0,0,0,,Anlıyorum... Hasır Şapkalar'ın\Nlehine olacak dediğimiz yegâne yüz...
Dialogue: 0,0:21:43.61,0:21:45.46,Main,,0,0,0,,Böyle anlaşmıştık değil mi?
Dialogue: 0,0:21:45.46,0:21:47.12,Main,,0,0,0,,Anlaşmıştık da...
Dialogue: 0,0:21:47.12,0:21:50.62,Main,,0,0,0,,Bu sefer o kazandı öyleyse.
Dialogue: 0,0:21:51.98,0:21:54.19,Main,,0,0,0,,Onu bu gece tutuklamayacağız.
Dialogue: 0,0:21:54.19,0:21:56.96,Main,,0,0,0,,Böyle bir şeye\Nzar atarak karar veremezsiniz, Issho-san!
Dialogue: 0,0:21:56.96,0:22:01.19,Main,,0,0,0,,Ülkeyi karış karış arayıp\Nsonunda nerede olduğunu bulduk!
Dialogue: 0,0:22:01.19,0:22:04.27,Main,,0,0,0,,Filo Amirali Sakazuki'ye\Nöyle çıkıştıktan sonra...
Dialogue: 0,0:22:04.27,0:22:07.63,Main,,0,0,0,,Law'la Hasır Şapka'yı alt etmenin\Ntam zamanı işte!
Dialogue: 0,0:22:07.63,0:22:09.18,Main,,0,0,0,,Maynard-san!
Dialogue: 0,0:22:09.96,0:22:15.18,Main,,0,0,0,,Adam gibi adam\Natılan zarın ardından söylenmez.
Dialogue: 0,0:22:15.74,0:22:18.32,Main,,0,0,0,,Acınacak birisin.
Dialogue: 0,0:22:20.31,0:22:23.23,Captions,,0,0,180,,{\fad(500,0)}Kraliyet Sarayı
Dialogue: 0,0:22:23.52,0:22:26.66,Main,,0,0,0,,Lucy'i gören oldu mu?
Dialogue: 0,0:22:26.66,0:22:28.01,Main,,0,0,0,,Hayır, kimse görmemiş.
Dialogue: 0,0:22:28.01,0:22:29.56,Main,,0,0,0,,En azından bir teşekkür etmek isterdim!
Dialogue: 0,0:22:29.56,0:22:31.71,Main,,0,0,0,,Dışarısı epey hareketli.
Dialogue: 0,0:22:31.71,0:22:34.69,Main,,0,0,0,,Korsan da olsalar, suçlu da olsalar,...
Dialogue: 0,0:22:34.69,0:22:38.22,Main,,0,0,0,,...bizi kurtardıkları su götürmez bir gerçek.
Dialogue: 0,0:22:44.76,0:22:45.76,Main,,0,0,0,,Dede!
Dialogue: 0,0:22:47.18,0:22:48.60,Main,,0,0,0,,Rebecca.
Dialogue: 0,0:22:48.60,0:22:52.08,Main,,0,0,0,,Babam da, Lucy'ler de\Nsarayda değiller!
Dialogue: 0,0:22:52.08,0:22:57.30,Main,,0,0,0,,Evet, endişelenme.\NKyros'dan haber aldım.
Dialogue: 0,0:22:57.30,0:22:59.18,Main,,0,0,0,,Birliktelermiş.
Dialogue: 0,0:23:00.32,0:23:00.96,Main,,0,0,0,,Ne güzel.
Dialogue: 0,0:23:03.16,0:23:04.46,Main,,0,0,0,,Ondan ziyade...
Dialogue: 0,0:23:05.38,0:23:06.56,Main,,0,0,0,,Rebecca.
Dialogue: 0,0:23:09.32,0:23:12.24,Main,,0,0,0,,Yeniden kral olursam...
Dialogue: 0,0:23:12.88,0:23:15.56,Main,,0,0,0,,...sen de prenses olacaksın!
Dialogue: 0,0:23:17.94,0:23:23.00,Captions,,0,0,335,,{\fad(250,250)}Ertesi Gün\NYeni Dünya\N(Kıvırcık Kaş Korsanları)
Dialogue: 0,0:23:31.42,0:23:33.14,Main,,0,0,0,,Lanet olsun!
Dialogue: 0,0:23:33.72,0:23:37.56,Main,,0,0,0,,Big Mom'ın gemisinden kurtulacağız diye\Nverdiğimiz onca çabanın ardından...
Dialogue: 0,0:23:39.92,0:23:42.54,Main,,0,0,0,,...nasıl oldu da\Nkendimizi yine belanın içinde bulduk?!
Dialogue: 0,0:23:43.44,0:23:45.96,Main,,0,0,0,,Bu konuda seçme özgürlüğüne\Nsahip değilsin!
Dialogue: 0,0:23:45.96,0:23:46.75,Main,,0,0,0,,Acele et sen!
Dialogue: 0,0:23:46.75,0:23:49.14,Main,,0,0,0,,Sizi düşündüğüm için konuşuyorum!
Dialogue: 0,0:23:49.90,0:23:52.70,Main,,0,0,0,,Onların işlerine burnunuzu sokmayın!
Dialogue: 0,0:23:52.70,0:23:57.69,Main,,0,0,0,,Gemide usul usul bekleyecektik işte!\NÖnden gidinmiş, yesinler!
Dialogue: 0,0:23:57.69,0:24:00.15,Main,,0,0,0,,Kapa çeneni ve\Nsana söyleneni yap!
Dialogue: 0,0:24:00.15,0:24:01.16,Main,,0,0,0,,Anladın mı?!
Dialogue: 0,0:24:01.94,0:24:04.56,Main,,0,0,0,,Yoksa kalbini ezip\Npastırma mı yapayım?!
Dialogue: 0,0:24:10.20,0:24:12.79,Main,,0,0,0,,Tamam be!\NAma bu yanına kalmaz!
Dialogue: 0,0:24:14.28,0:24:16.65,Main,,0,0,0,,Karaya çıkmak doğru karardı!
Dialogue: 0,0:24:16.65,0:24:21.34,Main,,0,0,0,,Onları hâlâ kurtarabiliriz!\NYardımına ihtiyacımız var!
Dialogue: 0,0:24:22.38,0:24:25.79,Main,,0,0,0,,Bana biraz daha iyi davranın öyleyse...
Dialogue: 0,0:24:25.79,0:24:26.94,Main,,0,0,0,,Bi' şey mi dedin?!
Dialogue: 0,0:24:27.92,0:24:30.28,Main,,0,0,0,,Gözümün önüne sokup durma şunu!
Dialogue: 0,0:24:30.28,0:24:31.85,Main,,0,0,0,,Acele et, Caesar!
Dialogue: 0,0:24:31.85,0:24:35.34,Main,,0,0,0,,Emir vermeyin dedim size,\Nrakun bozuntusu seni!
Dialogue: 0,0:24:36.04,0:24:38.08,Main,,0,0,0,,Ren geyiğiyim ben!
Dialogue: 0,0:24:38.08,0:24:40.30,Main,,0,0,0,,Ne fark eder?!
Dialogue: 0,0:24:40.30,0:24:43.58,Main,,0,0,0,,Kapa çeneni!\NAcele et dedik!
Dialogue: 0,0:24:46.06,0:24:50.42,Main,,0,0,0,,Senin yüzünden ölürlerse\Ngösteririm ben sana!
Dialogue: 0,0:24:51.46,0:24:54.68,Main,,0,0,0,,Yardımın lazım!
Dialogue: 0,0:25:05.20,0:25:07.48,Main,,0,0,0,,Koşması ne zor bir zemin bu!
Dialogue: 0,0:25:07.48,0:25:10.90,Main,,0,0,0,,Sanji-san'lardan ayrı düştüğümüze\Ninanamıyorum...
Dialogue: 0,0:25:10.90,0:25:11.98,Main,,0,0,0,,Başımız dertte!
Dialogue: 0,0:25:12.54,0:25:15.26,Main,,0,0,0,,Gizemli kıza fazla ilgi gösterdik.
Dialogue: 0,0:25:17.54,0:25:20.34,Main,,0,0,0,,Dikkat et, Nami-san!
Dialogue: 0,0:25:21.90,0:25:23.92,Main,,0,0,0,,Dikkat et, kendim!
Dialogue: 0,0:25:25.92,0:25:28.16,Main,,0,0,0,,Ne?!
Dialogue: 0,0:25:32.22,0:25:34.02,Main,,0,0,0,,Onami! Geliyorlar!
Dialogue: 0,0:25:39.52,0:25:41.20,Main,,0,0,0,,Ne?!
Dialogue: 0,0:25:56.02,0:25:59.25,Main,,0,0,0,,Bu kadarcık mıydı,\Nistilacı bozuntuları?!
Dialogue: 0,0:25:59.25,0:26:02.36,Main,,0,0,0,,Öbür kızı nereye sakladınız?!
Dialogue: 0,0:26:03.38,0:26:06.08,Main,,0,0,0,,Adaya ayak basmayı\Nnasıl başardınız?!
Dialogue: 0,0:26:06.94,0:26:10.07,Main,,0,0,0,,Cevap verin!\NBu yer oldukça{\fscx250}-{\r}
Dialogue: 0,0:26:10.86,0:26:13.20,Main,,0,0,0,,Ne?! Ne oluyor?!
Dialogue: 0,0:26:13.20,0:26:14.80,Main,,0,0,0,,Bu sefer ne oluyor?!
Dialogue: 0,0:26:19.54,0:26:21.96,Main,,0,0,0,,Yağmur-Patlama geliyor!
Dialogue: 0,0:26:22.88,0:26:23.68,Main,,0,0,0,,Yine mi?!
Dialogue: 0,0:26:24.76,0:26:26.54,Main,,0,0,0,,Eğilin!
Dialogue: 0,0:26:29.40,0:26:31.23,Main,,0,0,0,,O da ne öyle?!
Dialogue: 0,0:26:31.23,0:26:32.56,Main,,0,0,0,,Yağmur mu?!
Dialogue: 0,0:26:32.56,0:26:34.84,Main,,0,0,0,,Hayır!\NTonla su fışkırdı!
Dialogue: 0,0:26:36.98,0:26:40.06,Main,,0,0,0,,Her ne olursa olsun\Nsizi koruyacağım!
Dialogue: 0,0:26:50.28,0:26:51.64,Main,,0,0,0,,Nami-san!
Dialogue: 0,0:26:52.38,0:26:54.34,Main,,0,0,0,,Momonosuke-san!
Dialogue: 0,0:26:55.12,0:26:58.54,Main,,0,0,0,,Yardım edin!
Dialogue: 0,0:26:59.32,0:27:01.05,Main,,0,0,0,,Bana da!
Dialogue: 0,0:27:01.05,0:27:04.42,Main,,0,0,0,,Siz güç kullanıcılarından\Ncanıma tak etti artık!
Dialogue: 0,0:27:04.42,0:27:08.08,Main,,0,0,0,,Sizi koruyamadığım için özür dilerim!
Dialogue: 0,0:27:11.24,0:27:15.36,Main,,0,0,0,,Kaçamayacaksınız\Nistilacı bozuntuları sizi!
Dialogue: 0,0:27:28.64,0:27:30.64,Main,,0,0,0,,Toparla kendini!
Dialogue: 0,0:27:31.60,0:27:33.67,Main,,0,0,0,,Teşekkür ederim...
Dialogue: 0,0:27:33.67,0:27:35.39,Main,,0,0,0,,Sen de öyle, Momo!
Dialogue: 0,0:27:35.39,0:27:36.74,Main,,0,0,0,,Borcun ödenmez...
Dialogue: 0,0:27:40.96,0:27:43.08,Main,,0,0,0,,Şüpheye düştüğünde...
Dialogue: 0,0:27:43.08,0:27:44.40,Main,,0,0,0,,Öldür gitsin!
Dialogue: 0,0:27:50.16,0:27:51.09,Main,,0,0,0,,Brook!
Dialogue: 0,0:27:51.09,0:27:52.10,Main,,0,0,0,,Kemikiçi!
Dialogue: 0,0:27:53.24,0:27:55.64,Main,,0,0,0,,Sonunda sizi korumayı başardım!
Dialogue: 0,0:27:59.20,0:28:00.98,Main,,0,0,0,,Bundan sonrası bende!
Dialogue: 0,0:28:01.78,0:28:04.21,Main,,0,0,0,,Kendini ne sanıyorsun sen?!
Dialogue: 0,0:28:04.21,0:28:06.82,Main,,0,0,0,,{\fad(150,150)}Koyun Boynuzu!
Dialogue: 0,0:28:09.80,0:28:11.23,Main,,0,0,0,,Ne?!
Dialogue: 0,0:28:11.23,0:28:12.66,Main,,0,0,0,,O kollar da neyin nesi?!
Dialogue: 0,0:28:12.66,0:28:13.84,Main,,0,0,0,,Kemikiçi!
Dialogue: 0,0:28:14.62,0:28:16.08,Main,,0,0,0,,Al sana!
Dialogue: 0,0:28:16.08,0:28:18.32,Main,,0,0,0,,{\fad(150,150)}Ruh Geçidi!
Dialogue: 0,0:28:23.78,0:28:25.44,Main,,0,0,0,,Vay canına, Kemikiçi harikaymış!
Dialogue: 0,0:28:28.04,0:28:30.40,Main,,0,0,0,,Ne tür bir güç bu?
Dialogue: 0,0:28:34.18,0:28:35.48,Main,,0,0,0,,Brook!
Dialogue: 0,0:28:35.48,0:28:37.12,Main,,0,0,0,,O şekilde tutmaya devam et!
Dialogue: 0,0:28:38.92,0:28:41.08,Main,,0,0,0,,{\fad(150,150)}Diable! Mouton...
Dialogue: 0,0:28:41.94,0:28:43.54,Main,,0,0,0,,{\fad(150,150)}...Shot!
Dialogue: 0,0:28:55.98,0:28:57.46,Main,,0,0,0,,Sheepshead-sama!
Dialogue: 0,0:28:59.48,0:29:00.41,Main,,0,0,0,,Sanji-kun!
Dialogue: 0,0:29:00.41,0:29:03.38,Main,,0,0,0,,Ha, Nami-swan!
Dialogue: 0,0:29:04.58,0:29:06.18,Main,,0,0,0,,Siz de kimin nesisiniz?!
Dialogue: 0,0:29:06.18,0:29:08.10,Main,,0,0,0,,Asıl siz kimsiniz?!
Dialogue: 0,0:29:10.16,0:29:11.62,Main,,0,0,0,,Ne baktın sapık!?
Dialogue: 0,0:29:12.64,0:29:14.18,Main,,0,0,0,,Gin-Rummy-sama!
Dialogue: 0,0:29:15.14,0:29:17.77,Main,,0,0,0,,Geri çekilin!
Dialogue: 0,0:29:17.77,0:29:19.77,Main,,0,0,0,,Sheepshead-sama yenildi!
Dialogue: 0,0:29:19.77,0:29:20.94,Main,,0,0,0,,Ne?!
Dialogue: 0,0:29:20.94,0:29:23.13,Main,,0,0,0,,Samurayı henüz bulamadık!
Dialogue: 0,0:29:23.13,0:29:26.27,Main,,0,0,0,,Onları bu denli köşeye\Nsıkıştırmamıza rağmen ortaya çıkmadı!
Dialogue: 0,0:29:26.27,0:29:29.14,Main,,0,0,0,,Samuray burada değil!\NOna böyle söyleyin!
Dialogue: 0,0:29:29.14,0:29:29.82,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:29:35.18,0:29:36.66,Main,,0,0,0,,Su geri çekiliyor...
Dialogue: 0,0:29:39.22,0:29:40.62,Main,,0,0,0,,Bu da neyin nesiydi ki böyle?
Dialogue: 0,0:29:41.26,0:29:43.87,Main,,0,0,0,,Tuhaf bir ada gerçekten.
Dialogue: 0,0:29:43.87,0:29:46.15,Main,,0,0,0,,Umarım o kıza bir şey olmamıştır.
Dialogue: 0,0:29:46.15,0:29:49.63,Main,,0,0,0,,Bizden de çevik biri,\Neminim bir şey olmamıştır.
Dialogue: 0,0:29:49.63,0:29:50.57,Main,,0,0,0,,Haklısın.
Dialogue: 0,0:29:58.92,0:30:01.08,Main,,0,0,0,,Millet!
Dialogue: 0,0:30:02.04,0:30:04.06,Main,,0,0,0,,Çabuk buraya gelin!
Dialogue: 0,0:30:04.82,0:30:08.08,Main,,0,0,0,,Choppermon'un sesi bu!\NOrmanın içinden geldi!
Dialogue: 0,0:30:08.08,0:30:10.14,Main,,0,0,0,,Acele edelim!\NKaybedecek zaman yok!
Dialogue: 0,0:30:18.24,0:30:20.89,Captions,,0,0,175,,{\fad(300,300)}Kid Korsanları Güvenli Yeri
Dialogue: 0,0:30:31.44,0:30:32.66,Main,,0,0,0,,Bu da neyin nesi?!
Dialogue: 0,0:30:37.66,0:30:39.02,Main,,0,0,0,,Ne oldu?!
Dialogue: 0,0:30:39.02,0:30:42.25,Main,,0,0,0,,Kaptan, devasa bir çukur açıldı!
Dialogue: 0,0:30:42.25,0:30:43.47,Main,,0,0,0,,Çukur mu?
Dialogue: 0,0:30:43.47,0:30:44.74,Main,,0,0,0,,Adaya bir şey düştü!
Dialogue: 0,0:30:46.22,0:30:47.59,Main,,0,0,0,,Silahlanın!
Dialogue: 0,0:30:47.59,0:30:49.77,Main,,0,0,0,,Evet!
Dialogue: 0,0:30:51.12,0:30:52.13,Main,,0,0,0,,Orada!
Dialogue: 0,0:31:08.61,0:31:10.78,Main,,0,0,0,,Büyükmüş.
Dialogue: 0,0:31:11.44,0:31:13.25,Main,,0,0,0,,Nereden düştü?
Dialogue: 0,0:31:13.25,0:31:15.72,Main,,0,0,0,,Kim yaptı bunu?!
Dialogue: 0,0:31:17.18,0:31:19.76,Main,,0,0,0,,Çukur insan şeklinde değil mi sanki?
Dialogue: 0,0:31:20.98,0:31:22.16,Main,,0,0,0,,Zamanında...
Dialogue: 0,0:31:22.76,0:31:27.64,Main,,0,0,0,,...bu civarlardaki\NGökyüzü Adası'nda...
Dialogue: 0,0:31:28.86,0:31:31.36,Main,,0,0,0,,...canavarların yaşadığına dair\Nbir efsane duymuştum sanki.
Dialogue: 0,0:31:32.50,0:31:35.96,Main,,0,0,0,,Gökyüzü Adası'ndan mı\Ndüştü diyorsun?!
Dialogue: 0,0:31:37.54,0:31:38.64,Main,,0,0,0,,Kaptan Kid!
Dialogue: 0,0:31:39.42,0:31:42.45,Main,,0,0,0,,Darbe yüzünden\Ngemilerimizden biri alabora oldu!
Dialogue: 0,0:31:42.45,0:31:43.62,Main,,0,0,0,,Ne dedin?!
Dialogue: 0,0:31:44.96,0:31:47.86,Main,,0,0,0,,Şaka mı lan bu?!\NKim yaptı bunu?!
Dialogue: 0,0:31:48.68,0:31:52.50,Narrator,,0,0,0,,{\i1}Güçlüler yaşar, zayıflar ölür.{\i0}
Dialogue: 0,0:31:53.46,0:31:56.64,Narrator,,0,0,0,,{\i1}Dünya bundan ibaret.{\i0}
Dialogue: 0,0:31:58.70,0:32:00.88,Narrator,,0,0,0,,{\i1}Birkaç dakika önce...{\i0}
Dialogue: 0,0:32:03.30,0:32:07.80,Captions,,0,0,175,,{\fad(450,0)}Bir Gökyüzü Adası\NMahvolmuş Şehir Balon Terminali
Dialogue: 0,0:32:14.90,0:32:17.06,Main,,0,0,0,,Ne yapıyorsun?
Dialogue: 0,0:32:17.06,0:32:19.29,Main,,0,0,0,,Hiç bulaşmayalım, Keşiş!
Dialogue: 0,0:32:19.29,0:32:20.98,Main,,0,0,0,,Kafayı üşütmüş bu!
Dialogue: 0,0:32:20.98,0:32:24.72,Main,,0,0,0,,On bin metre yükseklikteyiz...
Dialogue: 0,0:32:24.72,0:32:29.12,Narrator,,0,0,0,,{\i1}Adam ölecek bir yer arıyordu.{\i0}
Dialogue: 0,0:32:29.12,0:32:31.16,Main,,0,0,0,,Ciddiysen seni durdurmayacağız.
Dialogue: 0,0:32:33.22,0:32:35.58,Narrator,,0,0,0,,{\i1}Hayatı boyunca...{\i0}
Dialogue: 0,0:32:35.58,0:32:39.18,Narrator,,0,0,0,,{\i1}...bir korsan olarak\Nyedi kez yenilgiye uğramış...{\i0}
Dialogue: 0,0:32:40.72,0:32:44.62,Narrator,,0,0,0,,{\i1}...on sekiz kez de Donanma\Nyahut düşmanlarının eline geçmişti.{\i0}
Dialogue: 0,0:32:45.90,0:32:51.82,Narrator,,0,0,0,,{\i1}Defalarca işkenceye maruz kalmış,\Nhayatını suçlu biri olarak sürdürmekteydi.{\i0}
Dialogue: 0,0:33:00.86,0:33:03.91,Narrator,,0,0,0,,{\i1}Ve o,\Npek sıradan olmayan bir biçimde...{\i0}
Dialogue: 0,0:33:05.02,0:33:09.16,Narrator,,0,0,0,,{\i1}...Gökyüzü Adası'ndan atlayarak\Nintihar etmeye çalıştı.{\i0}
Dialogue: 0,0:33:13.50,0:33:16.37,Narrator,,0,0,0,,{\i1}Ve tekrar şu andayız.{\i0}
Dialogue: 0,0:33:19.13,0:33:20.96,Narrator,,0,0,0,,{\i1}Tekrarlamakta fayda var.{\i0}
Dialogue: 0,0:33:20.96,0:33:24.10,Narrator,,0,0,0,,{\i1}O tek başına Donanma'ya\Nve Yonkou'ya karşı gelmiş...{\i0}
Dialogue: 0,0:33:24.10,0:33:28.59,Narrator,,0,0,0,,{\i1}...18 kez yakalanıp\N40 kez idama mahkum edilmiş biri.{\i0}
Dialogue: 0,0:33:29.26,0:33:33.28,Narrator,,0,0,0,,{\i1}Asıldığında zincirler koptu.{\i0}
Dialogue: 0,0:33:33.94,0:33:37.98,Narrator,,0,0,0,,{\i1}Giyotine gönderildiğinde\Nbıçak parçalandı.{\i0}
Dialogue: 0,0:33:39.50,0:33:42.25,Narrator,,0,0,0,,{\i1}Kazığa geçirilmeye mahkum edildiğinde\Nmızrak kırıldı.{\i0}
Dialogue: 0,0:33:43.19,0:33:47.56,Narrator,,0,0,0,,{\i1}Neticede dokuz devasa\Nhapishane gemisi batırdı.{\i0}
Dialogue: 0,0:33:47.56,0:33:51.26,Narrator,,0,0,0,,{\i1}Özetle onu öldürmeyi\Nkimseler başaramadı.{\i0}
Dialogue: 0,0:33:52.28,0:33:55.83,Narrator,,0,0,0,,{\i1}Kendisi de buna dahil.{\i0}
Dialogue: 0,0:34:02.42,0:34:03.82,Main,,0,0,0,,Şimdi ne oluyor?!
Dialogue: 0,0:34:19.78,0:34:22.14,Main,,0,0,0,,Bu canavar da neyin nesi?!
Dialogue: 0,0:34:22.77,0:34:26.25,Main,,0,0,0,,Lanet olsun, başım ağrıyor!
Dialogue: 0,0:34:27.38,0:34:30.28,Main,,0,0,0,,Ölmek de amma zor şey!
Dialogue: 0,0:34:30.28,0:34:32.54,Main,,0,0,0,,Gene hayatta kaldım.
Dialogue: 0,0:34:36.70,0:34:39.37,Main,,0,0,0,,Bizim ihtiyar Beyazsakal...
Dialogue: 0,0:34:39.37,0:34:41.50,Main,,0,0,0,,...bir şekilde başardı...
Dialogue: 0,0:34:55.52,0:34:58.31,Narrator,,0,0,0,,{\i1}Ölecek yer arayan adamın adı,...{\i0}
Dialogue: 0,0:34:59.30,0:35:01.48,Narrator,,0,0,0,,...Canavarlar Kralı Kaido.
Dialogue: 0,0:35:07.62,0:35:13.40,Narrator,,0,0,0,,{\i1}"Birebir mücadelede,\NKaido hep yener." diyor insanlar.{\i0}
Dialogue: 0,0:35:14.54,0:35:24.29,Narrator,,0,0,0,,{\i1}Karada, denizde, havada yaşayan tüm varlıklar içinde \Nen güçlü yaratık olarak bilinen korsan.{\i0}
Dialogue: 0,0:35:28.52,0:35:31.71,Main,,0,0,0,,Başka seçeneğim kalmadı ha!
Dialogue: 0,0:35:44.20,0:35:46.10,Main,,0,0,0,,Lanet olası!
Dialogue: 0,0:35:47.70,0:35:49.91,Main,,0,0,0,,Acele et, Joker!
Dialogue: 0,0:35:49.91,0:35:54.86,Main,,0,0,0,,Nihai savaşın hazırlıklarını tamamla!
Dialogue: 0,0:35:57.10,0:36:00.24,Main,,0,0,0,,Bu sıkıcı dünya\Nyok olmuş umrumda değil!
Dialogue: 0,0:36:01.48,0:36:06.36,Main,,0,0,0,,Dünyanın en büyük savaşını başlatalım!
Dialogue: 0,0:36:06.46,0:36:09.50,OP11 Credits,,0,0,0,,Editing:\N Galaxy 9000\N\NTiming:\N Datenshi,\NSewil (Opening)\N\NQuality Assurance:\N Datenshi,\NFeeso,\NGalaxy 9000,\NGrug,\NMr. Luffy\N\NSoundtracking:\N Halee\N\NGraphics:\N Datenshi\N\NTranslation:\NYibis
