Dialogue: 0,0:02:30.03,0:02:38.53,Title,,0,0,0,,{\fad(2000,2000)}C Bloğunun Alevli Savaşı ve\NDressrosa'nın Unutulanları!
Dialogue: 0,0:02:38.97,0:02:40.22,Main,,0,0,0,,Ne güç ama!
Dialogue: 0,0:02:40.22,0:02:43.28,Main,,0,0,0,,Yarışmacılar kağıt gibi havada uçuyorlar!
Dialogue: 0,0:02:44.09,0:02:47.71,Main,,0,0,0,,Ve onları havaya uçuran kişiyse Kelly Funk!
Dialogue: 0,0:02:44.09,0:02:47.71,Secondary,,0,0,0,,Ku-Ku-Ku...
Dialogue: 0,0:02:47.71,0:02:49.28,Main,,0,0,0,,Ku-Ku-Ku Kural Tanımaz!
Dialogue: 0,0:02:49.66,0:02:53.85,Thoughts,,0,0,0,,{\i1}Gördüm ben! Olanları gördüm!\NO da neydi öyle?!{\i0}
Dialogue: 0,0:02:53.85,0:02:56.36,Thoughts,,0,0,0,,{\i1}İkisi bir oldular!
Dialogue: 0,0:02:56.36,0:03:00.78,Flashbacks,,0,0,0,,Acele et ve beni giy, Bobby!
Dialogue: 0,0:03:00.78,0:03:04.23,Flashbacks,,0,0,0,,{\fad(150,150)}Jake Jake\NBir Cekette İki Kişi!
Dialogue: 0,0:03:12.35,0:03:19.51,Flashbacks,,0,0,0,,{\i1}Böyle güçlü vücuda sahip olmasına rağmen Bobby'nin yumuşak mizacı ona büyük engel!{\i0}
Dialogue: 0,0:03:19.88,0:03:22.92,Flashbacks,,0,0,0,,{\i1}Fakat beni üstüne geçirince...{\i0}
Dialogue: 0,0:03:22.92,0:03:24.93,Flashbacks,,0,0,0,,{\i1}...kontrolü tamamıyla ele alıp...
Dialogue: 0,0:03:24.93,0:03:30.72,Flashbacks,,0,0,0,,{\i1}...savaş kabiliyetimi ve gücümü\Nbu bedende tam anlamıyla gösterebiliyorum!{\i0}
Dialogue: 0,0:03:33.60,0:03:37.61,Flashbacks,,0,0,0,,Jake Jake Meyvesi yemiş\Nceket insanım ben!
Dialogue: 0,0:03:37.61,0:03:39.65,Flashbacks,,0,0,0,,Hayvan olsun, canavar olsun...
Dialogue: 0,0:03:39.65,0:03:42.15,Flashbacks,,0,0,0,,...beni üzerine geçirdimi\Ntüm kontrolü ben alırım!
Dialogue: 0,0:03:49.20,0:03:52.41,Thoughts,,0,0,0,,{\i1}Karşılık verecek fırsatı bile olmadı!{\i0}
Dialogue: 0,0:03:53.78,0:03:58.78,Main,,0,0,0,,Ben de kim bu diye düşünüyordum ki\NKano Krallığı'nın ağabeyi gelmiş!
Dialogue: 0,0:03:58.78,0:04:03.08,Main,,0,0,0,,Kardeşinin işini saniyesinde bitirdim.
Dialogue: 0,0:04:03.08,0:04:08.03,Main,,0,0,0,,Biz iki kardeş birlikte insan öldürerek\Nhayatımızı kazanıyoruz!
Dialogue: 0,0:04:08.03,0:04:10.58,Main,,0,0,0,,Sense amma rezilmişsin var ya!
Dialogue: 0,0:04:10.58,0:04:12.53,Main,,0,0,0,,Kardeşini bile koruyamadın!
Dialogue: 0,0:04:13.12,0:04:16.50,Main,,0,0,0,,Kardeşim, eğitimi yetersiz geldiği için yenildi.
Dialogue: 0,0:04:16.50,0:04:18.41,Main,,0,0,0,,Bu kadar yüklenmemek lazım ama!
Dialogue: 0,0:04:19.51,0:04:21.04,Main,,0,0,0,,Ku-Ku-Ku Kural Tanımaz!
Dialogue: 0,0:04:25.52,0:04:28.59,Main,,0,0,0,,Kano Krallığı'nın savaş sanatları\Ngüçlü değil miydi?!
Dialogue: 0,0:04:28.59,0:04:29.79,Main,,0,0,0,,Söylesene!
Dialogue: 0,0:04:29.84,0:04:33.20,Main,,0,0,0,,Sekiz Darbeli Yumruk yolundan\Ngitmeye karar verdiğim an...
Dialogue: 0,0:04:33.20,0:04:35.91,Main,,0,0,0,,...kardeşime karşı olan\Ntüm duygularımdan arındım!
Dialogue: 0,0:04:38.82,0:04:39.88,Main,,0,0,0,,Fakat...
Dialogue: 0,0:04:46.63,0:04:52.10,Main,,0,0,0,,...Happo Donanması'nın 13. lideri olarak...
Dialogue: 0,0:04:52.10,0:04:57.34,Main,,0,0,0,,...adamımın öcünü alacağım!
Dialogue: 0,0:05:22.33,0:05:29.03,Main,,0,0,0,,Çok...
Dialogue: 0,0:05:29.03,0:05:31.24,Main,,0,0,0,,Çok güçlü!
Dialogue: 0,0:05:33.18,0:05:34.75,Main,,0,0,0,,Sekiz Darbeli Yumruk!
Dialogue: 0,0:05:34.75,0:05:37.05,Main,,0,0,0,,Sai, liderliğin anlamını hepimize gösterdi!
Dialogue: 0,0:05:37.05,0:05:41.69,Main,,0,0,0,,Kimselerin durduramadığı canavar Kelly'i\Ntek bir darbede indirdi!
Dialogue: 0,0:05:41.69,0:05:43.95,Main,,0,0,0,,Madem öyle miğferimi geri ver!
Dialogue: 0,0:05:43.95,0:05:45.71,Main,,0,0,0,,{\fad(150,150)}Hibe!
Dialogue: 0,0:05:48.29,0:05:52.56,Main,,0,0,0,,Geçtiğimiz iki yıl\Nsayende çok para kaldırdım!
Dialogue: 0,0:05:52.56,0:05:54.33,Main,,0,0,0,,Ne?! Sayemde mi?
Dialogue: 0,0:05:54.33,0:05:56.54,Main,,0,0,0,,Büyük hapishane\NImpel Down'dan kurtardığın...
Dialogue: 0,0:05:56.54,0:06:00.27,Main,,0,0,0,,...bir sürü suçluyu yakaladım!
Dialogue: 0,0:06:01.50,0:06:05.77,Main,,0,0,0,,Sen ve senin gibi diğer kaçakların\Nhepsini yakalamayı planlıyorum!
Dialogue: 0,0:06:06.61,0:06:08.94,Main,,0,0,0,,Yıldız Palyaço Buggy!
Dialogue: 0,0:06:09.48,0:06:11.25,Main,,0,0,0,,Denizin Şovalyesi Jimbei!
Dialogue: 0,0:06:11.91,0:06:14.38,Main,,0,0,0,,Sir Crocodile!
Dialogue: 0,0:06:14.78,0:06:17.35,Main,,0,0,0,,Okamaların Kralı Ivankov!
Dialogue: 0,0:06:17.35,0:06:19.89,Main,,0,0,0,,{\fad(0,548)}Yağmur Shiryu!
Dialogue: 0,0:06:19.89,0:06:23.59,Main,,0,0,0,,Hepsini avlayıp\Nadımı tüm dünyaya duyuracağım!
Dialogue: 0,0:06:23.59,0:06:26.09,Main,,0,0,0,,Jimbei'yle Iva-chan nasıllardır şimdi acaba?
Dialogue: 0,0:06:26.09,0:06:27.93,Main,,0,0,0,,Sadece bunlar da değil!
Dialogue: 0,0:06:27.93,0:06:30.17,Main,,0,0,0,,Dünyadan gizledikleri...
Dialogue: 0,0:06:30.17,0:06:33.55,Main,,0,0,0,,...acımasız seviye 6 kaçakları da var!
Dialogue: 0,0:06:33.55,0:06:35.15,Main,,0,0,0,,Seviye 6 mı?
Dialogue: 0,0:06:35.15,0:06:38.36,Main,,0,0,0,,Nerede olduklarını buldum!
Dialogue: 0,0:06:38.36,0:06:40.83,Main,,0,0,0,,Başka kaçanlar da olmuş demek?
Dialogue: 0,0:06:40.83,0:06:42.63,Main,,0,0,0,,Lanet olası, neden vuramıyorum!
Dialogue: 0,0:06:52.10,0:06:55.40,Main,,0,0,0,,Şimdi...
Dialogue: 0,0:06:57.53,0:06:59.30,Main,,0,0,0,,Bunu alayım.
Dialogue: 0,0:06:59.30,0:07:00.90,Main,,0,0,0,,Lanet olası...
Dialogue: 0,0:07:01.45,0:07:03.50,Main,,0,0,0,,Acıyor be!
Dialogue: 0,0:07:05.95,0:07:08.64,Main,,0,0,0,,Arenanın dışında!
Dialogue: 0,0:07:08.64,0:07:11.43,Main,,0,0,0,,Haydut Jean elendi!
Dialogue: 0,0:07:11.43,0:07:15.28,Main,,0,0,0,,Tek bir darbede bayıldı!
Dialogue: 0,0:07:15.45,0:07:20.36,Main,,0,0,0,,Efsanevi korsan Don Chinjao'nun attığı bu kafa...
Dialogue: 0,0:07:20.36,0:07:22.95,Main,,0,0,0,,...gücünden hiçbir şey\Nkaybetmediğinin bir kanıtı adeta!
Dialogue: 0,0:07:22.95,0:07:27.78,Main,,0,0,0,,Bu sırada eşit güce sahip iki yarışmacı\Narasında nefes kesici bir mücadele sürmekte!
Dialogue: 0,0:07:30.02,0:07:33.29,Main,,0,0,0,,Gerçekten de\Nçok iyi eşleşmişler!
Dialogue: 0,0:07:34.65,0:07:38.02,Main,,0,0,0,,Sanki kendi aralarında...
Dialogue: 0,0:07:38.02,0:07:41.27,Main,,0,0,0,,...en güçlüyü seçmeye çalıştıkları\Nölüm kalım savaşı gibi!
Dialogue: 0,0:07:41.50,0:07:44.41,Main,,0,0,0,,İkisi de öyle güçlü ki, karşılarına\Nbaşkası gelse hiçbir şansı olmayacakmış!
Dialogue: 0,0:07:44.41,0:07:46.58,Main,,0,0,0,,İkisi de yeteneklerinden emin!
Dialogue: 0,0:07:46.58,0:07:49.35,Main,,0,0,0,,Asıl dövüş bu!
Dialogue: 0,0:07:49.35,0:07:50.38,Main,,0,0,0,,İşte bu!
Dialogue: 0,0:07:50.38,0:07:52.10,Main,,0,0,0,,Dövüşün!
Dialogue: 0,0:07:52.10,0:07:56.01,Main,,0,0,0,,Heyecan dorukta!
Dialogue: 0,0:07:56.67,0:07:57.64,Main,,0,0,0,,Hadi!
Dialogue: 0,0:07:58.14,0:07:59.71,Main,,0,0,0,,Harika lan!
Dialogue: 0,0:07:59.71,0:08:01.05,Main,,0,0,0,,Ideo!
Dialogue: 0,0:08:01.05,0:08:02.48,Main,,0,0,0,,Sai!
Dialogue: 0,0:08:02.48,0:08:07.72,Main,,0,0,0,,Tüm Kolezyumun gözü\No ikisi arasındaki savaşta!
Dialogue: 0,0:08:07.72,0:08:10.07,Main,,0,0,0,,Artık kaçacak yerin kalmadı...
Dialogue: 0,0:08:10.99,0:08:13.74,Main,,0,0,0,,...Garp'ın torunu!
Dialogue: 0,0:08:13.74,0:08:18.04,Main,,0,0,0,,Dedenin yaptıklarının hesabını vereceksin!
Dialogue: 0,0:08:18.04,0:08:23.98,Main,,0,0,0,,Senin pis deden\Ntüm talihimi benden çaldı!
Dialogue: 0,0:08:23.98,0:08:29.59,Main,,0,0,0,,Gücümü de, tatlı gençlik anılarımı da her şeyimi aldı benden!
Dialogue: 0,0:08:29.59,0:08:32.76,Main,,0,0,0,,Diyorum ya sana,\Nbunları dedeme anlat!
Dialogue: 0,0:08:32.76,0:08:38.36,Main,,0,0,0,,Garp'ı öldürmek\Nonun için çok hafif bir ceza olur!
Dialogue: 0,0:08:38.36,0:08:43.73,Main,,0,0,0,,Canından bir parça olmadan yaşamanın\Nnasıl bir şey olduğunu göstereceğim ona!
Dialogue: 0,0:08:43.73,0:08:46.12,Main,,0,0,0,,Başka seçeneğim kalmadı öyleyse.
Dialogue: 0,0:08:46.12,0:08:47.57,Main,,0,0,0,,Başlayalım madem.
Dialogue: 0,0:08:49.28,0:08:54.48,Main,,0,0,0,,Kin gütmüşsün gütmemişsin fark etmez. Nasılsa seni yenmeden zafere ulaşamayacağım.
Dialogue: 0,0:08:54.48,0:08:57.72,Main,,0,0,0,,İşini şuracıkta bitireceğim!
Dialogue: 0,0:08:58.13,0:08:59.93,Main,,0,0,0,,Çekil önümden!
Dialogue: 0,0:08:59.93,0:09:01.60,Main,,0,0,0,,Kıpırda!
Dialogue: 0,0:09:30.10,0:09:32.52,Main,,0,0,0,,Kralların gücüne...
Dialogue: 0,0:09:33.40,0:09:36.72,Main,,0,0,0,,...Kralların Hakisi'ne\Nsahip olanların mücadelesi bu!
Dialogue: 0,0:09:43.36,0:09:47.00,Main,,0,0,0,,C Bloğu'nda...
Dialogue: 0,0:09:48.50,0:09:49.97,Main,,0,0,0,,...geriye yalnızca...
Dialogue: 0,0:09:50.88,0:09:53.57,Main,,0,0,0,,...iki kişi kaldı!
Dialogue: 0,0:09:57.81,0:10:02.51,Main,,0,0,0,,Birbirinden güçlü ünlü savaşçılar\No ikisi arasındaki çarpışmanın etkisiyle...
Dialogue: 0,0:10:02.51,0:10:06.72,Main,,0,0,0,,...bayılıp savaş dışı kaldılar!
Dialogue: 0,0:10:06.72,0:10:10.91,Main,,0,0,0,,Az önce neye şahit olduk öyle?!
Dialogue: 0,0:10:13.83,0:10:16.64,Main,,0,0,0,,Kralların Hakisi'ni kullanabildiğini bilmiyordum!
Dialogue: 0,0:10:16.64,0:10:19.23,Main,,0,0,0,,Ne tür bir kral olma hayalindesin?!
Dialogue: 0,0:10:20.55,0:10:21.93,Main,,0,0,0,,Korsanlar Kralı!
Dialogue: 0,0:10:21.93,0:10:23.50,Main,,0,0,0,,Hadi be oradan!
Dialogue: 0,0:10:24.09,0:10:29.70,Main,,0,0,0,,Denizin bu tarafında kralların gücünü\Nkullanabilen pek çok kişi mevcut!
Dialogue: 0,0:10:29.70,0:10:32.98,Main,,0,0,0,,Ve işte kazanan da\Nbunlar arasından belirlenecek!
Dialogue: 0,0:10:32.98,0:10:37.32,Main,,0,0,0,,Bütün kralların en kudretlisi!
Dialogue: 0,0:10:37.66,0:10:40.33,Main,,0,0,0,,Korsanlar Kralı olacak kişi o işte!
Dialogue: 0,0:10:47.18,0:10:50.46,Main,,0,0,0,,Haki kullanmayı sana kim öğretti?
Dialogue: 0,0:10:52.38,0:10:53.50,Main,,0,0,0,,Rayleigh!
Dialogue: 0,0:10:54.22,0:10:56.78,Main,,0,0,0,,Hâlâ yaşıyor demek?
Dialogue: 0,0:10:58.04,0:11:00.24,Main,,0,0,0,,Sinir bozucu!
Dialogue: 0,0:11:02.91,0:11:05.78,Main,,0,0,0,,Geçmişi hatırlamak bile istemiyorum!
Dialogue: 0,0:11:06.81,0:11:08.23,Main,,0,0,0,,Ne?
Dialogue: 0,0:11:08.23,0:11:09.51,Main,,0,0,0,,Yok artık!
Dialogue: 0,0:11:15.73,0:11:18.41,Main,,0,0,0,,Söylesene Hasır Şapka.
Dialogue: 0,0:11:18.96,0:11:22.05,Main,,0,0,0,,Unutmak istesem de hep gözümün önünde...
Dialogue: 0,0:11:22.05,0:11:25.65,Main,,0,0,0,,...elimi uzatıp kavrayamadığım hazinem...
Dialogue: 0,0:11:25.65,0:11:29.17,Main,,0,0,0,,Bundan daha beter bir şey\Ndüşünebiliyor musun?!
Dialogue: 0,0:11:32.64,0:11:37.44,Main,,0,0,0,,Ne oluyor öyle?! Efsanevi korsan...
Dialogue: 0,0:11:37.44,0:11:39.91,Main,,0,0,0,,...ağlıyor!
Dialogue: 0,0:11:44.51,0:11:48.69,Main,,0,0,0,,Ağabeyimin adını finale\Nyazdırması gerekiyordu, ihtiyar!
Dialogue: 0,0:11:49.36,0:11:51.51,Main,,0,0,0,,Benim de henüz\Naşmam gereken çok yol var.
Dialogue: 0,0:11:51.51,0:11:55.48,Main,,0,0,0,,Bu haldeyken\Nihtiyarı kimse durduramaz!
Dialogue: 0,0:11:56.32,0:11:58.42,Main,,0,0,0,,"Delgeç Chinjao."
Dialogue: 0,0:11:58.42,0:12:02.57,Main,,0,0,0,,Böyle derlerdi bana eskiden.
Dialogue: 0,0:12:03.66,0:12:05.38,Main,,0,0,0,,Söylesene!
Dialogue: 0,0:12:05.38,0:12:08.87,Main,,0,0,0,,Garp'ın bana ne yaptığını biliyor musun?!
Dialogue: 0,0:12:08.87,0:12:11.34,Main,,0,0,0,,Bilmiyorum dedim sana!
Dialogue: 0,0:12:15.98,0:12:19.49,Main,,0,0,0,,Haydi Lucy, şimdi tam zamanı!
Dialogue: 0,0:12:19.49,0:12:21.09,Main,,0,0,0,,Luffy-{\i0}dono{\i0}!
Dialogue: 0,0:12:21.09,0:12:27.02,Main,,0,0,0,,Sanji-dono, derhal Oyuncak Evi'ne varıp Kanjuro'yu kurtarmam lazım!
Dialogue: 0,0:12:27.02,0:12:30.03,Main,,0,0,0,,Ben de aynı şeyi istiyorum da\Nbiraz sabırlı olmamız lazım.
Dialogue: 0,0:12:30.03,0:12:32.26,Main,,0,0,0,,İlgilenmemiz gereken\Nbaşka bir mesele var önce.
Dialogue: 0,0:12:34.20,0:12:37.54,Main,,0,0,0,,Bak Kolezyumun çevresini\Nkaç asker kuşatmış.
Dialogue: 0,0:12:37.82,0:12:39.44,Main,,0,0,0,,Neden bu kadar çoklar acaba?
Dialogue: 0,0:12:39.44,0:12:43.35,Main,,0,0,0,,Korsan ve suçluların bu yarışmaya\Nözgürce katılabildiğini düşünüyorum.
Dialogue: 0,0:12:43.35,0:12:46.68,Main,,0,0,0,,Donanma da dışarı çıkarlarken\Nonları yakalamak için burada.
Dialogue: 0,0:12:46.68,0:12:50.43,Main,,0,0,0,,Suçluların yakalanmasından\Ndaha doğal ne var!
Dialogue: 0,0:12:51.52,0:12:54.94,Main,,0,0,0,,Buraya korsan gemisinde geldiğini\Nunuttun mu yoksa?!
Dialogue: 0,0:12:55.39,0:12:59.63,Main,,0,0,0,,Durumu bir şekilde\NLuffy'e iletmemiz lazım ama...
Dialogue: 0,0:12:59.63,0:13:03.21,Main,,0,0,0,,...yarışmacıların giriş yaptığı kısım\Ntamamıyla kapalı.
Dialogue: 0,0:13:04.20,0:13:07.17,Main,,0,0,0,,Neler oluyor-dara?
Dialogue: 0,0:13:12.34,0:13:16.75,Main,,0,0,0,,Kolezyum'dan hâlâ kimse çıkmadı mı-dara?
Dialogue: 0,0:13:16.75,0:13:17.74,Main,,0,0,0,,Henüz kimse çıkmadı.
Dialogue: 0,0:13:18.21,0:13:23.10,Main,,0,0,0,,A ve B Bloklarından kaybetmiş\Nonlarca kişi var-dara!
Dialogue: 0,0:13:23.10,0:13:25.56,Main,,0,0,0,,Neden hâlâ hiçbiri dışarı çıkmadı-dara?
Dialogue: 0,0:13:25.56,0:13:27.84,Main,,0,0,0,,Tuhaf.
Dialogue: 0,0:13:28.98,0:13:37.50,Captions,,0,0,250,,{\fad(1000,0)}Köpek Balığı Katili Bastille\NDonanma Koramirali
Dialogue: 0,0:13:27.84,0:13:31.49,Main,,0,0,11,,{\an8}Koramiral Maynard yarışmacı kılığında içeri girmişti ama...
Dialogue: 0,0:13:31.49,0:13:34.04,Main,,0,0,11,,...bir süredir onunla iletişime geçemedik.
Dialogue: 0,0:13:34.04,0:13:36.04,Main,,0,0,11,,Kimseye danışmadan\Nniye böyle bir şey yapmış...
Dialogue: 0,0:13:36.04,0:13:37.50,Main,,0,0,11,,...bu velet?
Dialogue: 0,0:13:38.88,0:13:40.77,Main,,0,0,0,,Kolezyum'un içinde...
Dialogue: 0,0:13:40.77,0:13:44.56,Main,,0,0,0,,...bir şeyler mi dönüyor acaba-dara?
Dialogue: 0,0:13:49.15,0:13:54.48,Main,,0,0,0,,Dressrosa'da on yıldır yani Doflamingo tahta geçtiğinden beri...
Dialogue: 0,0:13:54.48,0:13:57.11,Main,,0,0,0,,...herkesin mutlaka uymak zorunda olduğu iki kural vardır.
Dialogue: 0,0:13:57.48,0:14:00.80,Main,,0,0,0,,Birincisi, ışıklar gece yarısı\Nmutlaka sönecek...
Dialogue: 0,0:14:00.80,0:14:02.76,Main,,0,0,0,,...ve o saatten sonra\Nkimse dışarı çıkmayacak.
Dialogue: 0,0:14:02.76,0:14:05.39,Main,,0,0,0,,Yok artık!\NYetişkinler bile mi?
Dialogue: 0,0:14:06.51,0:14:08.56,Main,,0,0,0,,İnsanlar kendi evlerine...
Dialogue: 0,0:14:08.56,0:14:11.04,Main,,0,0,0,,...oyuncaklar da kendi oyuncak evlerine\Ndönmek zorundadırlar.
Dialogue: 0,0:14:11.04,0:14:13.80,Main,,0,0,0,,Gece yarısından sonra\Nkimsenin dışarı çıkma izin yok.
Dialogue: 0,0:14:13.80,0:14:16.05,Main,,0,0,0,,İki tek atmaya da mı\Ngidemiyor insanlar?!
Dialogue: 0,0:14:16.05,0:14:17.97,Main,,0,0,0,,Her taraf kapalı zaten.
Dialogue: 0,0:14:18.87,0:14:22.54,Main,,0,0,0,,İkinci olarak oyuncakların insanların evlerine...
Dialogue: 0,0:14:22.54,0:14:26.01,Main,,0,0,0,,...ve aynı şekilde insanların\Noyuncakların evlerine girmeleri yasaktır.
Dialogue: 0,0:14:26.01,0:14:27.85,Main,,0,0,0,,Ne?!
Dialogue: 0,0:14:27.85,0:14:30.46,Main,,0,0,0,,Çok da iyi geçiniyor gibiler ama...
Dialogue: 0,0:14:30.46,0:14:33.19,Main,,0,0,0,,...birbirlerinin evlerine girmeleri\Nyasak demek?
Dialogue: 0,0:14:34.29,0:14:41.81,Main,,0,0,0,,Gerçi, oyuncaklarla insanlar arasındaki o üzücü uçurum buysa açıkçası pek de elden bir şey gelmez gibi.
Dialogue: 0,0:14:41.81,0:14:47.00,Main,,0,0,0,,Zaten duruma epey alıştım gibi ama...
Dialogue: 0,0:14:47.00,0:14:50.61,Main,,0,0,0,,...nasıl oyuncaklarsınız siz böyle?
Dialogue: 0,0:14:50.61,0:14:52.85,Main,,0,0,0,,Düşünebiliyor, konuşabiliyorsunuz.
Dialogue: 0,0:14:52.85,0:14:55.87,Main,,0,0,0,,Sizi yapan kişi\NVegapunk gibi bir dahi falan olmalı.
Dialogue: 0,0:14:55.87,0:14:56.85,Main,,0,0,0,,Kim bu kişi?
Dialogue: 0,0:14:59.39,0:15:02.13,Main,,0,0,0,,Polis çağırın!
Dialogue: 0,0:15:02.13,0:15:03.52,Main,,0,0,0,,Ne oluyor?!
Dialogue: 0,0:15:03.52,0:15:04.69,Main,,0,0,0,,Bırak beni ya!
Dialogue: 0,0:15:04.69,0:15:06.16,Main,,0,0,0,,Esta, benim!
Dialogue: 0,0:15:06.16,0:15:08.96,Main,,0,0,0,,Bu oyuncak bozulmuş!\Nİnsanlık hastalığına yakalanmış!
Dialogue: 0,0:15:08.96,0:15:11.30,Main,,0,0,0,,Beni dinle bak, öyle değil!
Dialogue: 0,0:15:11.30,0:15:13.06,Main,,0,0,0,,Beni hatırlamıyor musun, Esta?
Dialogue: 0,0:15:13.06,0:15:13.87,Main,,0,0,0,,Beni, beni!
Dialogue: 0,0:15:13.87,0:15:15.99,Main,,0,0,0,,Uzak dur benden, iğrenç şey!
Dialogue: 0,0:15:15.99,0:15:17.85,Main,,0,0,0,,Ne oldu birden?!
Dialogue: 0,0:15:17.85,0:15:19.73,Main,,0,0,0,,Bugüne dek bu kızla hep\Niyi geçinmişsindir oysaki!
Dialogue: 0,0:15:20.27,0:15:21.56,Main,,0,0,0,,Yalvarıyorum sana hatırla lütfen!
Dialogue: 0,0:15:23.67,0:15:25.83,Main,,0,0,0,,Uzak dur kızdan!
Dialogue: 0,0:15:28.19,0:15:30.52,Main,,0,0,0,,Gel bakalım bizimle.
Dialogue: 0,0:15:31.25,0:15:32.75,Main,,0,0,0,,Lanet olsun!
Dialogue: 0,0:15:32.75,0:15:37.35,Main,,0,0,0,,Esta, erkek arkadaşınım ben!
Dialogue: 0,0:15:37.35,0:15:40.86,Main,,0,0,0,,Öyle işe yaramaz adamlardan uzak dur!
Dialogue: 0,0:15:40.86,0:15:43.13,Main,,0,0,0,,Hatırla lütfen!
Dialogue: 0,0:15:45.09,0:15:45.80,Main,,0,0,0,,Bırakın beni be lanet olasıcalar!
Dialogue: 0,0:15:45.80,0:15:47.77,Main,,0,0,0,,Uslu dur!
Dialogue: 0,0:15:47.77,0:15:49.64,Main,,0,0,0,,Yapmayın!
Dialogue: 0,0:15:49.64,0:15:52.37,Main,,0,0,0,,Yapmayın! Yapmayın!
Dialogue: 0,0:15:57.78,0:16:00.99,Main,,0,0,0,,İstemiyorum!\NBırakın beni adiler!
Dialogue: 0,0:16:00.99,0:16:04.46,Main,,0,0,0,,İnsanım ben!
Dialogue: 0,0:16:07.42,0:16:09.28,Main,,0,0,0,,Sırtına bineyim, Onepoko!
Dialogue: 0,0:16:09.28,0:16:11.80,Main,,0,0,0,,Olmaz-hav!\NArtık ağırsın-hav!
Dialogue: 0,0:16:11.80,0:16:14.29,Main,,0,0,0,,Onepoko!
Dialogue: 0,0:16:14.29,0:16:17.82,Main,,0,0,0,,Ağır değilim bir kere tamam mı, Onepoko!
Dialogue: 0,0:16:18.62,0:16:20.09,Main,,0,0,0,,Ben gidip onunla konuşayım.
Dialogue: 0,0:16:23.65,0:16:26.77,Main,,0,0,0,,Endişelenme, o da oyuncak.
Dialogue: 0,0:16:26.77,0:16:28.61,Main,,0,0,0,,Yarım öyle.
Dialogue: 0,0:16:28.61,0:16:31.90,Main,,0,0,0,,Onepoko olayı çaktı!
Dialogue: 0,0:16:32.72,0:16:33.84,Main,,0,0,0,,Kimsin sen?
Dialogue: 0,0:16:39.41,0:16:43.82,Main,,0,0,0,,O oğlanın babasıyım.\NO kadın da karım.
Dialogue: 0,0:16:43.82,0:16:46.42,Main,,0,0,0,,Adım Milo, Onepoko değil.
Dialogue: 0,0:16:49.61,0:16:51.96,Main,,0,0,0,,Genç, baban var mı?
Dialogue: 0,0:16:51.96,0:16:54.70,Main,,0,0,0,,Ne? Yok benim babam!
Dialogue: 0,0:16:54.70,0:16:56.53,Main,,0,0,0,,Senin kocan var mı peki?
Dialogue: 0,0:16:56.53,0:16:59.33,Main,,0,0,0,,Yok.\NEvlenmedim ki hiç.
Dialogue: 0,0:16:59.86,0:17:01.64,Main,,0,0,0,,Hep olmuyor mu böyle şeyler zaten canım!
Dialogue: 0,0:17:03.23,0:17:05.00,Main,,0,0,0,,Güle güle!
Dialogue: 0,0:17:09.41,0:17:15.35,Main,,0,0,0,,Asker, amacın ne?\NNe anlatmaya çalışıyorsun?
Dialogue: 0,0:17:17.40,0:17:19.95,Main,,0,0,0,,Sözün özü bu ülke...
Dialogue: 0,0:17:21.25,0:17:22.99,Main,,0,0,0,,...unutulanlar ve...
Dialogue: 0,0:17:23.93,0:17:26.19,Main,,0,0,0,,...unutanlarla dolu!
Dialogue: 0,0:17:27.55,0:17:31.66,Main,,0,0,0,,Biz tüm oyuncaklar\Nbir zamanlar insandık!
Dialogue: 0,0:17:32.13,0:17:33.06,Main,,0,0,0,,Ne?!
Dialogue: 0,0:17:34.58,0:17:39.44,Main,,0,0,0,,10 yıl önce Doflamingo'nun getirdiği\Nbir güç kullanıcısı...
Dialogue: 0,0:17:40.12,0:17:43.21,Main,,0,0,0,,...bizi oyuncağa dönüştürdü!
Dialogue: 0,0:17:43.21,0:17:46.39,Main,,0,0,0,,Yani şimdi sen de...
Dialogue: 0,0:17:47.22,0:17:47.80,Main,,0,0,0,,İşte bu!
Dialogue: 0,0:17:48.84,0:17:53.22,Main,,0,0,0,,Çiçek Bahçesi göründü,\Norada her şeyi anlatacağım!
Dialogue: 0,0:17:54.42,0:17:57.30,Captions,,0,0,190,,{\fad(500,0)}Green Bit
Dialogue: 0,0:18:03.94,0:18:05.64,Main,,0,0,0,,Hiç acıman yok!
Dialogue: 0,0:18:05.64,0:18:08.10,Main,,0,0,0,,Epey sakarım...
Dialogue: 0,0:18:15.25,0:18:17.63,Main,,0,0,0,,Nami-ya neden açmıyor?!
Dialogue: 0,0:18:17.63,0:18:19.85,Main,,0,0,0,,Doğru numara olduğuna eminim!
Dialogue: 0,0:18:23.36,0:18:27.38,Captions,,0,0,220,,{\fad(250,0)}Green Bit'in Altı\NTontatta Krallığı
Dialogue: 0,0:18:24.98,0:18:27.38,Main,,0,0,0,,{\an8}Usoland'ın Hakisi bu!
Dialogue: 0,0:18:27.88,0:18:30.82,Main,,0,0,0,,Raflara destek çubukları lazım, düşecekler.
Dialogue: 0,0:18:30.82,0:18:34.59,Main,,0,0,0,,Leo, hazırlıklar tamam mı?\NYemek çantası hazırlayayım mı?
Dialogue: 0,0:18:34.59,0:18:38.46,Main,,0,0,0,,Nine, karargahta yiyecek bir şeyler vardır kesin.
Dialogue: 0,0:18:38.46,0:18:39.49,Main,,0,0,0,,İyi madem!
Dialogue: 0,0:18:42.09,0:18:43.37,Main,,0,0,0,,Nine!
Dialogue: 0,0:18:43.37,0:18:47.20,Main,,0,0,0,,Sahi ya!\NDüşebilecek her şeyi dikeyim ben!
Dialogue: 0,0:18:55.29,0:18:57.08,Main,,0,0,0,,İşte şimdi tamamdır!
Dialogue: 0,0:18:58.13,0:19:01.69,Main,,0,0,0,,Kahramanın bu denli güçlü olması\Nne güzel değil mi!
Dialogue: 0,0:19:01.69,0:19:06.09,Main,,0,0,0,,Haki denen o şeyle\Ntüm krallığı sarsabiliyor!
Dialogue: 0,0:19:06.09,0:19:07.11,Main,,0,0,0,,Aynen öyle!
Dialogue: 0,0:19:07.11,0:19:09.96,Main,,0,0,0,,Usoland efsanevi bir kahraman!
Dialogue: 0,0:19:10.26,0:19:14.87,Main,,0,0,0,,Bir de Leo, ninen düşmesi gerektiği halde \Nnedense düşemiyor!
Dialogue: 0,0:19:19.97,0:19:22.17,Main,,0,0,0,,Tontatta Krallığı demek?
Dialogue: 0,0:19:22.17,0:19:27.05,Main,,0,0,0,,Shichibukai Doflamingo'yla\Nne alakaları var ki?
Dialogue: 0,0:19:27.05,0:19:31.05,Main,,0,0,0,,Neyse ne işte,\Nsavaşma konusunda kararlı gibiler.
Dialogue: 0,0:19:31.05,0:19:35.12,Main,,0,0,0,,Usoland'la Robiland, doydunuz mu?
Dialogue: 0,0:19:36.16,0:19:40.06,Main,,0,0,0,,Evet, tıkabasa...
Dialogue: 0,0:19:40.06,0:19:42.66,Main,,0,0,0,,Yani karnım tok, sırtım pek\Ngitmeye hazırım!
Dialogue: 0,0:19:44.96,0:19:51.01,Main,,0,0,0,,Bakın, deminden beri heyecandan\Nyeri göğü titretir oldum!
Dialogue: 0,0:19:51.92,0:19:53.50,Main,,0,0,0,,Harika!
Dialogue: 0,0:19:53.50,0:19:55.14,Main,,0,0,0,,Akla hayale sığmaz bir güç!
Dialogue: 0,0:19:57.31,0:20:03.48,Main,,0,0,0,,O değil de Leo, deminden beri\N"savaş savaş" diyorsunuz da...
Dialogue: 0,0:20:03.48,0:20:06.01,Main,,0,0,0,,...Doflamingo'yla\Nneden savaşmak istiyorsunuz peki?
Dialogue: 0,0:20:06.01,0:20:06.90,Main,,0,0,0,,Ne?
Dialogue: 0,0:20:09.89,0:20:12.51,Main,,0,0,0,,Kahramanın şakası da\Nayrı komik oluyor!
Dialogue: 0,0:20:12.51,0:20:15.57,Main,,0,0,0,,Dressrosa'nın o karanlık fabrikasında\Nçalışmaya zorlanan...
Dialogue: 0,0:20:15.57,0:20:19.80,Main,,0,0,0,,...500 dostumuzu kurtarmak için elbette!
Dialogue: 0,0:20:19.80,0:20:22.59,Main,,0,0,0,,Ne?!\NFabrika mı dedin?
Dialogue: 0,0:20:22.59,0:20:25.13,Main,,0,0,0,,Luffy'lerin yok etmek için\Ngittikleri fabrika mı?!
Dialogue: 0,0:20:25.13,0:20:28.48,Main,,0,0,0,,GÜLÜCÜK üreten fabrikadan\Nbahsediyorlar sanırım?
Dialogue: 0,0:20:29.81,0:20:32.90,Main,,0,0,0,,Ne yaptıklarını bilmiyorum ama...
Dialogue: 0,0:20:32.90,0:20:35.49,Main,,0,0,0,,...o fabrikada Tontatta Kabilesi'nin...
Dialogue: 0,0:20:35.49,0:20:41.93,Main,,0,0,0,,...kötü, bencil, acımasız, aksi, asabi prensesi Mancherie de tutsak.
Dialogue: 0,0:20:41.93,0:20:43.12,Main,,0,0,0,,Yani acele etmemiz lazım!
Dialogue: 0,0:20:43.90,0:20:46.75,Main,,0,0,0,,Prenses epey korkunç biri gibi duruyor!
Dialogue: 0,0:20:46.75,0:20:47.49,Main,,0,0,0,,Öyledir fakat...
Dialogue: 0,0:20:48.33,0:20:50.19,Main,,0,0,0,,...o da bizden biri!
Dialogue: 0,0:20:51.51,0:20:54.96,Main,,0,0,0,,Noland başı dertte olan herkesi\Nkurtarmaz mıydı hem?
Dialogue: 0,0:20:54.96,0:20:55.80,Main,,0,0,0,,Ne?!
Dialogue: 0,0:20:55.80,0:20:59.98,Main,,0,0,0,,Kurtarırdı tabii! Kahraman olmak demek\Nöyle bir şey zaten!
Dialogue: 0,0:20:59.98,0:21:02.81,Main,,0,0,0,,Ben de onun soyundan olduğuma göre\Nben de öyle biriyim!
Dialogue: 0,0:21:03.96,0:21:06.73,Main,,0,0,0,,Efsanevi kahramanımız bizim!
Dialogue: 0,0:21:08.01,0:21:09.45,Main,,0,0,0,,Leo!
Dialogue: 0,0:21:09.91,0:21:10.78,Main,,0,0,0,,Flapper!
Dialogue: 0,0:21:12.77,0:21:16.39,Main,,0,0,0,,Leo, Don Quixote Ailesi'nin\Nharekete geçtiğini duydum!
Dialogue: 0,0:21:17.05,0:21:19.06,Main,,0,0,0,,Sanırım Kolezyumun altına gidiyorlar!
Dialogue: 0,0:21:20.09,0:21:23.07,Main,,0,0,0,,Kabu-san'ın Sarı Yavrusu'yla\NBian'ın Pembe Arısı...
Dialogue: 0,0:21:23.07,0:21:24.70,Main,,0,0,0,,...uçmaya hazır!
Dialogue: 0,0:21:24.70,0:21:25.74,Main,,0,0,0,,Pekâlâ!
Dialogue: 0,0:21:28.89,0:21:31.10,Main,,0,0,0,,Gidelim! Usoland, Robiland!
Dialogue: 0,0:21:36.09,0:21:38.25,Main,,0,0,0,,Savaş yeri Dressrosa!
Dialogue: 0,0:21:38.25,0:21:39.78,Main,,0,0,0,,Kolezyumun altı!
Dialogue: 0,0:21:39.78,0:21:41.44,Main,,0,0,0,,Karanlıkların fabrikası!
Dialogue: 0,0:21:41.44,0:21:44.31,Main,,0,0,0,,Millet, gidelim!
Dialogue: 0,0:21:44.31,0:21:46.22,Main,,0,0,0,,Evet!
