Dialogue: 0,0:00:01.26,0:00:03.90,Wake up! lyrics,,0,0,0,,{\i1}♪ Gidelim tüm parıltımızla, koşar adım, sonsuza dek! ♪
Dialogue: 0,0:00:03.93,0:00:06.66,Wake up! lyrics,,0,0,0,,{\i1}♪ İlerlemeye devam edelim! ♪
Dialogue: 0,0:00:06.70,0:00:09.57,Wake up! lyrics,,0,0,0,,{\i1}♪ Değişmeyen bağlar mutlak aydınlatacak... ♪
Dialogue: 0,0:00:09.63,0:00:12.67,Wake up! lyrics,,0,0,0,,{\i1}♪ ...rüyamızın sonunu! ♪
Dialogue: 0,0:00:12.77,0:00:15.27,Wake up! lyrics,,0,0,0,,{\i1}♪ Uyan, uyan, uyan, uyan haydi kalbim! ♪
Dialogue: 0,0:00:15.34,0:00:18.18,Wake up! lyrics,,0,0,0,,{\i1}♪ Başaracağız! Durmaksızın devam! ♪
Dialogue: 0,0:00:23.72,0:00:28.07,Wake up! lyrics,,0,0,0,,{\i1}♪ Tek pusulamız özgürlüktür. En sıkı dostlarız. ♪
Dialogue: 0,0:00:28.15,0:00:34.59,Wake up! lyrics,,0,0,0,,{\i1}♪ Kendi rotamızı bundan sonra da yine kendimiz çizeceğiz. ♪
Dialogue: 0,0:00:34.66,0:00:39.00,Wake up! lyrics,,0,0,0,,{\i1}♪ Her gün tam hız ilerliyoruz. Doğuya git, batıya git. ♪
Dialogue: 0,0:00:39.06,0:00:45.44,Wake up! lyrics,,0,0,0,,{\i1}♪ Birbiri ardına yapmak istediğimiz şeyler buluyor ve yapıyoruz da hepsini. ♪
Dialogue: 0,0:00:45.50,0:00:50.99,Wake up! lyrics,,0,0,0,,{\i1}♪ Sabahları etmeye dayanamaz aceleci gönlümüz. (Bekleyemem!) ♪
Dialogue: 0,0:00:51.11,0:00:56.05,Wake up! lyrics,,0,0,0,,{\i1}♪ Neden alıp biz yapıştırmıyoruz güneşi göğe. ♪
Dialogue: 0,0:00:56.11,0:00:58.95,Wake up! lyrics,,0,0,0,,{\i1}♪ Zorla ve yola çıkmıyoruz! ♪
Dialogue: 0,0:00:59.95,0:01:02.65,Wake up! lyrics,,0,0,0,,{\i1}♪ Evet tüm parıltımızla, koşar adım, sonsuza dek! ♪
Dialogue: 0,0:01:02.72,0:01:06.59,Wake up! lyrics,,0,0,0,,{\i1}♪ Hayal kırıntılarımız birleştirerek. ♪
Dialogue: 0,0:01:06.66,0:01:10.75,Wake up! lyrics,,0,0,0,,{\i1}♪ Titretiyorsa eğer gönlünü var mı daha büyük hazine. ♪
Dialogue: 0,0:01:10.83,0:01:13.43,Wake up! lyrics,,0,0,0,,{\i1}♪ Gidelim tüm parıltımızla, koşar adım, sonsuza dek! ♪
Dialogue: 0,0:01:13.50,0:01:16.13,Wake up! lyrics,,0,0,0,,{\i1}♪ İlerlemeye devam edelim! ♪
Dialogue: 0,0:01:16.20,0:01:19.17,Wake up! lyrics,,0,0,0,,{\i1}♪ Değişmeyen bağlar mutlak aydınlatacak... ♪
Dialogue: 0,0:01:19.24,0:01:22.24,Wake up! lyrics,,0,0,0,,{\i1}♪ ...rüyamızın sonunu! ♪
Dialogue: 0,0:01:22.31,0:01:24.94,Wake up! lyrics,,0,0,0,,{\i1}♪ Uyan, uyan, uyan, uyan haydi kalbim ♪
Dialogue: 0,0:01:25.01,0:01:27.41,Wake up! lyrics,,0,0,0,,{\i1}♪ Başaracağız! Durmaksızın devam! ♪
Dialogue: 0,0:01:29.44,0:01:32.87,Main,,0,0,0,,Karanlığa kapıl, Hasır Şapka!
Dialogue: 0,0:01:33.41,0:01:34.79,Main,,0,0,0,,Yenilmeyeceğim!
Dialogue: 0,0:01:35.06,0:01:37.35,Main,,0,0,0,,One Piece'i bulacak ve...
Dialogue: 0,0:01:37.35,0:01:42.13,Main,,0,0,0,,...Korsanlar Kralı olacağım!
Dialogue: 0,0:01:44.16,0:01:49.43,Wake up! lyrics,,0,0,0,,{\i1}♪ Üstesinden geldiğimiz her zorluk arttırıyor olasılıkları. (Kalamam!) ♪
Dialogue: 0,0:01:49.60,0:01:54.67,Wake up! lyrics,,0,0,0,,{\i1}♪ Yarın da, öbürgün de... ♪
Dialogue: 0,0:01:54.69,0:01:58.68,Wake up! lyrics,,0,0,0,,{\i1}♪ Yaşayacağız o içimizi titreten yoğun heyecanı! ♪
Dialogue: 0,0:01:58.71,0:02:01.15,Wake up! lyrics,,0,0,0,,{\i1}♪ Evet tüm parıltımızla, koşar adım, sonsuza dek! ♪
Dialogue: 0,0:02:01.21,0:02:05.25,Wake up! lyrics,,0,0,0,,{\i1}♪ Merakının peşinden koşarken... ♪
Dialogue: 0,0:02:05.32,0:02:09.35,Wake up! lyrics,,0,0,0,,{\i1}♪ Git kaderinin götürdüğü yere keza budur macera dediğin. ♪
Dialogue: 0,0:02:09.39,0:02:12.06,Wake up! lyrics,,0,0,0,,{\i1}♪ Gidelim tüm parıltımızla, koşar adım, sonsuza dek! ♪
Dialogue: 0,0:02:12.09,0:02:14.76,Wake up! lyrics,,0,0,0,,{\i1}♪ Aç kalbinin rota haritasını... ♪
Dialogue: 0,0:02:14.79,0:02:17.80,Wake up! lyrics,,0,0,0,,{\i1}♪ Güçle olan o bağın ele geçirecek... ♪
Dialogue: 0,0:02:17.86,0:02:20.93,Wake up! lyrics,,0,0,0,,{\i1}♪ ...rüyanın sonunu! ♪
Dialogue: 0,0:02:20.97,0:02:23.50,Wake up! lyrics,,0,0,0,,{\i1}♪ Asla, asla, asla, asla engel olma! ♪
Dialogue: 0,0:02:23.57,0:02:26.34,Wake up! lyrics,,0,0,0,,{\i1}♪ Başaracağız! Durmaksızın devam! ♪
