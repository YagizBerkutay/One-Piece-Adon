Dialogue: 0,0:02:30.03,0:02:38.61,Title,,0,0,0,,{\fad(2000,2000)}Tontatta İsyanı ve \NC Blok Finali!
Dialogue: 0,0:02:40.05,0:02:44.29,Captions,,0,0,250,,{\fad(500,0)}Green Bit'in Altı\NTontatta Krallığı
Dialogue: 0,0:02:45.13,0:02:45.91,Main,,0,0,0,,Yeraltından mı?
Dialogue: 0,0:02:46.64,0:02:47.45,Main,,0,0,0,,Evet.
Dialogue: 0,0:02:47.98,0:02:52.92,Main,,0,0,0,,Green Bit'ten Dressrosa'ya uzanan\Ngizli bir yeraltı geçidi var.
Dialogue: 0,0:02:53.27,0:02:56.79,Main,,0,0,0,,Havaalanına geldik!
Dialogue: 0,0:02:59.48,0:03:01.58,Main,,0,0,8,,Böcek ordusu!
Dialogue: 0,0:03:00.81,0:03:03.93,Captions,,0,0,250,,{\fad(600,0)}Tontatta Havaalanı\NTontatta Hava Yolları
Dialogue: 0,0:03:01.58,0:03:03.93,Main,,0,0,8,,Çok şirinler!
Dialogue: 0,0:03:04.71,0:03:09.62,Captions,,0,0,220,,{\fad(500,800)}Sarı Yavru\N(Sarı Gergedan Böceği)
Dialogue: 0,0:03:03.93,0:03:08.05,Main,,0,0,0,,{\an8}Sarı Yavru 43 konuşuyor,\Nkalkışa hazırız!
Dialogue: 0,0:03:08.05,0:03:11.54,Main,,0,0,0,,{\an8\i1}43 numara kalkışa hazır.{\i0}
Dialogue: 0,0:03:14.12,0:03:18.84,Captions,,0,0,220,,{\fad(500,0)}Pembe Arı\N(Pembe Eşşek Arısı)
Dialogue: 0,0:03:13.90,0:03:17.04,Main,,0,0,0,,{\an8}Pembe Arı Takımı, gitmeye hazır!
Dialogue: 0,0:03:17.04,0:03:18.84,Main,,0,0,0,,{\an8\i1}Pembe Arı, anlaşılmıştır.{\i0}
Dialogue: 0,0:03:19.12,0:03:22.05,Main,,0,0,0,,{\i1}Tüm böcekler, yeni bir emir verilene değin\Nbeklemede kalın.{\i0}
Dialogue: 0,0:03:22.05,0:03:24.80,Main,,0,0,0,,{\i1}Usoland, oraya dikkat edin lütfen!{\i0}
Dialogue: 0,0:03:24.80,0:03:25.50,Main,,0,0,0,,Özür dilerim!
Dialogue: 0,0:03:25.50,0:03:27.63,Main,,0,0,0,,Kabu-{\i0}san{\i0}! Bian!
Dialogue: 0,0:03:28.65,0:03:31.26,Main,,0,0,8,,Leo, geciktin!
Dialogue: 0,0:03:29.46,0:03:32.44,Captions,,0,0,250,,{\fad(600,0)}Kabu - Sarı Yavru Takımı Lideri\N(Böcek Böcek Meyvesi - Gergedanböceği Modeli)
Dialogue: 0,0:03:34.26,0:03:37.53,Captions,,0,0,250,,{\fad(600,0)}Bian - Pembe Arı Takımı Lideri\N(Böcek Böcek Meyvesi - Eşekarısı Modeli)
Dialogue: 0,0:03:33.34,0:03:35.14,Main,,0,0,8,,Tüm hazırlıklar tamam!
Dialogue: 0,0:03:35.14,0:03:37.53,Main,,0,0,8,,Son hızda uçacağız!
Dialogue: 0,0:03:38.09,0:03:39.64,Main,,0,0,0,,Size güveniyoruz!
Dialogue: 0,0:03:39.64,0:03:40.73,Main,,0,0,0,,İçiniz rahat olsun!
Dialogue: 0,0:03:40.73,0:03:44.90,Main,,0,0,0,,Takım üyeleri bugün için\Ncanla başla çalıştılar!
Dialogue: 0,0:03:45.54,0:03:48.69,Main,,0,0,0,,Böylesini daha önce görmemiştim.
Dialogue: 0,0:03:48.69,0:03:50.11,Main,,0,0,0,,Luffy'e de göstermek istiyorum!
Dialogue: 0,0:03:50.11,0:03:52.40,Main,,0,0,0,,Usoland! Robiland!
Dialogue: 0,0:03:52.40,0:03:56.25,Main,,0,0,0,,Siz kocamansınız,\Nsizi 20 kişilik otobüslere bindireceğiz.
Dialogue: 0,0:03:58.68,0:04:01.15,Main,,0,0,0,,Gelin haydi, Çizgi Tilkiler!
Dialogue: 0,0:04:04.11,0:04:08.61,Captions,,0,0,250,,{\fad(200,500)}Çizgi Tilkiler - Yirmi Kişilik Otobüs\N(KON EKSPRES)
Dialogue: 0,0:04:12.18,0:04:15.46,Main,,0,0,0,,Harikaymış bu, kral koltuğu gibi resmen!
Dialogue: 0,0:04:15.46,0:04:16.90,Main,,0,0,0,,Çok hızlı koşarlar.
Dialogue: 0,0:04:16.90,0:04:19.67,Main,,0,0,0,,Tüyleri çok güzelmiş!
Dialogue: 0,0:04:28.01,0:04:30.09,Main,,0,0,0,,Pekâlâ millet, gidelim!
Dialogue: 0,0:04:30.09,0:04:33.25,Main,,0,0,0,,Kahramanımız Usoland'da bizimle!
Dialogue: 0,0:04:34.73,0:04:38.52,Main,,0,0,0,,Esir tutulan 500 dostumuzu\Nkurtarmaya gidelim!
Dialogue: 0,0:04:38.52,0:04:40.76,Main,,0,0,0,,Evet!
Dialogue: 0,0:04:42.93,0:04:45.74,Main,,0,0,0,,Bunu neden yaptığımızı...
Dialogue: 0,0:04:47.86,0:04:49.28,Main,,0,0,0,,...size anlatmanın\Nzamanı geldi sanırım.
Dialogue: 0,0:04:49.28,0:04:51.47,Main,,0,0,0,,Çıktığın yere bir bak ihtiyar!
Dialogue: 0,0:04:51.47,0:04:52.62,Main,,0,0,0,,Gancho-{\i0}san{\i0}!
Dialogue: 0,0:04:53.73,0:04:55.70,Main,,0,0,0,,Gümemeaydın!\NBendeniz Tonta Şef Gancho!
Dialogue: 0,0:04:55.70,0:04:58.64,Main,,0,0,0,,Bunu yaptığınız için\Nsize tüm içtenliğimle teşekkür ederim!
Dialogue: 0,0:05:02.08,0:05:05.44,Main,,0,0,0,,Bizim için savaşarak hayatlarınızı\Ntehlikeye atıyor olacaksınız...
Dialogue: 0,0:05:05.44,0:05:08.22,Main,,0,0,0,,...o yüzden bilmenizi istediğim\Nbir şey var.
Dialogue: 0,0:05:08.57,0:05:11.32,Thoughts,,0,0,0,,{\i1}Yok yahu,\No kadar ileri gitmeyi planlamıyorum...{\i0}
Dialogue: 0,0:05:11.32,0:05:17.43,Main,,0,0,0,,Don Quixote Doflamingo son zamanlarda\NTontatta Kabilesi'ne büyük acılar yaşattı.
Dialogue: 0,0:05:17.43,0:05:22.30,Main,,0,0,0,,Fakat onunla olan geçmişimiz aslında yalnızca 10 yılla sınırlı değil.
Dialogue: 0,0:05:22.30,0:05:27.62,Main,,0,0,0,,900 yıl öncesine uzanan\Nbir geçmişten söz ediyorum.
Dialogue: 0,0:05:28.06,0:05:30.41,Main,,0,0,0,,Ne?!
Dialogue: 0,0:05:32.22,0:05:37.68,Narrator,,0,0,0,,{\i1}Dressrosa'da göz alabildiğine uzanan\Nbir ayçiçeği bahçesi vardır.{\i0}
Dialogue: 0,0:05:39.22,0:05:45.44,Narrator,,0,0,0,,{\i1}Dört tarafı bezemiş ayçiçeklerinin olduğu bu bahçede kimselerin bilmediği falanca bir yerde...{\i0}
Dialogue: 0,0:05:45.44,0:05:48.43,Narrator,,0,0,0,,{\i1}...yeraltına uzanan\Ngizli bir geçit mevcuttur.{\i0}
Dialogue: 0,0:05:48.43,0:05:52.40,Narrator,,0,0,0,,{\i1}İndikçe...\Nİndikçe merdivenlerinden...{\i0}
Dialogue: 0,0:05:53.19,0:05:58.05,Narrator,,0,0,0,,{\i1}...enerjik sesler çalınmaya başlanır\Ninsanın kulağına.{\i0}
Dialogue: 0,0:05:58.05,0:06:00.17,Main,,0,0,0,,Tanıştırayım!
Dialogue: 0,0:06:00.17,0:06:02.21,Main,,0,0,0,,Komutan!
Dialogue: 0,0:06:02.21,0:06:04.68,Main,,0,0,0,,Komutanım, gözlerimiz yollarda kaldı!
Dialogue: 0,0:06:06.01,0:06:07.73,Main,,0,0,0,,Ellerinize sağlık!
Dialogue: 0,0:06:09.02,0:06:11.35,Captions,,0,0,250,,{\fad(600,0)}Anti Doflamingo Koalisyonu\N"Kral Riku Ordusu" Karargâhı
Dialogue: 0,0:06:11.35,0:06:14.26,Main,,0,0,0,,Acayip güçlü bir oyuncağa benziyor!
Dialogue: 0,0:06:14.26,0:06:17.46,Main,,0,0,0,,Nasıl bir büyük insandı acaba?!
Dialogue: 0,0:06:17.46,0:06:20.20,Main,,0,0,0,,Tam da savaş gününde\Nöyle birini aramızda görmek çok iyi oldu!
Dialogue: 0,0:06:20.20,0:06:23.23,Main,,0,0,0,,Bunlar yoldaşlarımız!
Dialogue: 0,0:06:23.23,0:06:25.63,Main,,0,0,0,,Tontatta Krallığı'nın Küçük İnsanları!
Dialogue: 0,0:06:25.63,0:06:26.94,Main,,0,0,0,,Küçük İnsanlar mı?
Dialogue: 0,0:06:26.94,0:06:29.50,Main,,0,0,0,,Güç konusunda senden aşağı kalmaz...
Dialogue: 0,0:06:29.50,0:06:32.46,Main,,0,0,0,,...gözle görülemeyecek derecede\Nhızlı hareket ederler.
Dialogue: 0,0:06:32.46,0:06:34.77,Main,,0,0,0,,Kasabada "peri" olarak bilinirler.
Dialogue: 0,0:06:35.68,0:06:39.89,Main,,0,0,0,,Yani Zoro'nun katanasını çalanlar...
Dialogue: 0,0:06:41.16,0:06:42.43,Main,,0,0,0,,Acele etsene!
Dialogue: 0,0:06:42.43,0:06:45.17,Main,,0,0,0,,Gemine gitmek istemiyor musun?!
Dialogue: 0,0:06:45.17,0:06:47.38,Main,,0,0,0,,Ne diye sana vurmasına\Nmüsaade ediyorsun Luffy?!
Dialogue: 0,0:06:47.38,0:06:50.16,Main,,0,0,0,,Ağabey, göremiyoruz ama!
Dialogue: 0,0:06:50.16,0:06:50.76,Main,,0,0,0,,Zoro!
Dialogue: 0,0:06:51.06,0:06:53.02,Main,,0,0,0,,Canı çıkasıca!
Dialogue: 0,0:06:53.02,0:06:55.89,Main,,0,0,0,,Böyle yarışma vardı da\Nbana niye haber vermedi?!
Dialogue: 0,0:06:56.11,0:06:57.78,Main,,0,0,0,,Katanalarımla yardırırdım orada!
Dialogue: 0,0:06:58.00,0:06:59.93,Main,,0,0,0,,Komutanım!
Dialogue: 0,0:06:59.93,0:07:01.77,Main,,0,0,0,,Franky!
Dialogue: 0,0:07:01.77,0:07:04.30,Main,,0,0,0,,Ne yapıyorsun burada?
Dialogue: 0,0:07:04.30,0:07:08.61,Main,,0,0,0,,Komutanım, gözcü birliğinden\Ngelen bilgiyi işledik!
Dialogue: 0,0:07:08.61,0:07:12.03,Main,,0,0,0,,Düşmanların ve Sugar'ın\Nnerede olacağını biliyoruz.
Dialogue: 0,0:07:12.03,0:07:16.55,Main,,0,0,0,,Ayrıca sıkı durun,\Nsavaş gelip çattı derken tam...
Dialogue: 0,0:07:16.55,0:07:17.67,Main,,0,0,0,,Evet!
Dialogue: 0,0:07:17.67,0:07:21.46,Main,,0,0,0,,Tontatta'da efsanevi bir kahraman belirmiş!
Dialogue: 0,0:07:21.46,0:07:23.86,Main,,0,0,0,,Adları Usoland'la Robiland'mış!
Dialogue: 0,0:07:23.86,0:07:27.06,Main,,0,0,0,,Şu anda buraya doğru geliyorlarmış!
Dialogue: 0,0:07:27.06,0:07:29.87,Main,,0,0,0,,Üstüne üstlük\Nonların kendi dostları da varmış...
Dialogue: 0,0:07:29.87,0:07:31.13,Main,,0,0,0,,...ve adları da...
Dialogue: 0,0:07:31.13,0:07:34.83,Main,,0,0,0,,Luffyland, Zoroland, Namiland, Sanland...
Dialogue: 0,0:07:34.83,0:07:38.22,Main,,0,0,0,,...Chopperland, Fraland ve Kemikland'mış!
Dialogue: 0,0:07:38.22,0:07:39.81,Thoughts,,0,0,0,,{\i1}Usopp'un işi kesin!{\i0}
Dialogue: 0,0:07:39.81,0:07:42.14,Thoughts,,0,0,0,,{\i1}Neden böyle bir yalan söylemiş ki?{\i0}
Dialogue: 0,0:07:42.14,0:07:46.05,Main,,0,0,0,,Sanırım o Zoroland benim.
Dialogue: 0,0:07:46.05,0:07:48.83,Main,,0,0,0,,Ben de Fraland, memnun oldum!
Dialogue: 0,0:07:48.83,0:07:51.05,Main,,0,0,0,,Ne?! Çok sevindik!
Dialogue: 0,0:07:51.05,0:07:53.62,Main,,0,0,0,,Oha, bunların sırası değil şimdi!
Dialogue: 0,0:07:53.62,0:07:56.67,Main,,0,0,0,,Derhal Sunny-go'ya gitmem lazım,\NNami'lerin başı dertte!
Dialogue: 0,0:07:56.67,0:08:00.06,Main,,0,0,0,,Deminden beri ne diyorum ben!?
Dialogue: 0,0:08:00.24,0:08:03.44,Captions,,0,0,220,,{\fad(200,400)}Dressrosa Açıkları
Dialogue: 0,0:08:02.69,0:08:04.76,Main,,0,0,0,,{\an8}Beyhude bunlar!
Dialogue: 0,0:08:05.31,0:08:08.70,Main,,0,0,0,,Sanatı kimseler durduramaz!
Dialogue: 0,0:08:10.35,0:08:12.84,Main,,0,0,0,,{\fad(150,150)}Darbeli Kung Fu...
Dialogue: 0,0:08:13.28,0:08:14.43,Main,,0,0,0,,{\fad(150,150)}...Sanatı!
Dialogue: 0,0:08:15.39,0:08:17.44,Main,,0,0,0,,Bildiğin duman bu be!
Dialogue: 0,0:08:17.44,0:08:21.33,Main,,0,0,0,,Haydi bakalım hava yumurtası, Weather Egg!
Dialogue: 0,0:08:21.33,0:08:23.86,Main,,0,0,0,,Çıkın ortaya Kar Bulutları!
Dialogue: 0,0:08:27.72,0:08:30.68,Main,,0,0,0,,Bu ne be, iğrenç!
Dialogue: 0,0:08:30.68,0:08:32.74,Main,,0,0,0,,İklim Takt'ımı oyuncağa çevirmiş!
Dialogue: 0,0:08:33.96,0:08:35.24,Main,,0,0,0,,Terbiyesizliğin lüzumu yok!
Dialogue: 0,0:08:35.24,0:08:37.37,Main,,0,0,0,,Bana mı süper model dedin?
Dialogue: 0,0:08:37.37,0:08:38.25,Main,,0,0,0,,Demedim öyle bir şey!
Dialogue: 0,0:08:38.25,0:08:42.88,Main,,0,0,0,,Ne demek oyuncağa çevirmiş?!\NOyuncak değil o bir kere!
Dialogue: 0,0:08:42.88,0:08:44.10,Main,,0,0,0,,Zevksiz kız!
Dialogue: 0,0:08:44.10,0:08:49.59,Main,,0,0,0,,Doğrudur, ailemizde insanları\Noyuncağa çevirebilen biri de var.
Dialogue: 0,0:08:49.59,0:08:53.23,Main,,0,0,0,,Fakat ben Sanat Sanat Meyvesi yemiş\Nsanatçı insanım!
Dialogue: 0,0:08:53.23,0:08:56.98,Main,,0,0,0,,Sizler de birer\Nsanat parçasına dönüştünüz!
Dialogue: 0,0:08:57.31,0:09:00.85,Main,,0,0,0,,Hay aksi şeytan, Nami de yenildi!
Dialogue: 0,0:09:00.85,0:09:04.90,Main,,0,0,0,,Boynuzlarım da toynaklarım da\Nişe yaramaz halde!
Dialogue: 0,0:09:06.78,0:09:10.26,Main,,0,0,0,,Kemik-kichi, o kadın benim peşimde!
Dialogue: 0,0:09:10.26,0:09:13.34,Main,,0,0,0,,Biliyorum!\Nİstediğini yapmasına izin vermem!
Dialogue: 0,0:09:13.34,0:09:14.77,Main,,0,0,0,,Ama baksana...
Dialogue: 0,0:09:14.77,0:09:17.97,Main,,0,0,0,,Soul Solid'im ne hale geldi!
Dialogue: 0,0:09:17.97,0:09:21.12,Main,,0,0,0,,Neden hepiniz de sanki\Nkurbanmışçasına inliyorsunuz?!
Dialogue: 0,0:09:21.12,0:09:24.28,Main,,0,0,0,,Sizleri sanatsal birer parçaya\Nçevirdiğime sevinmelisiniz!
Dialogue: 0,0:09:25.64,0:09:31.26,Main,,0,0,0,,Ondan ziyade bakın gemime, adamlarıma...
Dialogue: 0,0:09:31.26,0:09:33.39,Main,,0,0,0,,...ne yaptınız!
Dialogue: 0,0:09:33.39,0:09:36.09,Main,,0,0,0,,Onların öcünü almak için...
Dialogue: 0,0:09:37.73,0:09:41.85,Main,,0,0,0,,...ne tür sanatsal bir ölüm\Nbahşetsem size acaba?!
Dialogue: 0,0:09:45.27,0:09:47.70,Main,,0,0,0,,Alo? Benim! \NKimsin sen?!
Dialogue: 0,0:09:47.70,0:09:50.91,Main,,0,0,0,,Başımız büyük dertte, yardım edin!
Dialogue: 0,0:09:50.91,0:09:53.00,Main,,0,0,0,,Açabileceğini kim söyledi sana?!
Dialogue: 0,0:09:53.00,0:09:54.84,Main,,0,0,0,,{\i1}Sen misin Tony-ya?!{\i0}
Dialogue: 0,0:09:54.84,0:09:57.08,Main,,0,0,0,,{\i1}Orada ne olduğunun\Nbir önemi yok, beni iyi dinle!{\i0}
Dialogue: 0,0:09:57.08,0:09:58.88,Main,,0,0,0,,Trao mu bu?!
Dialogue: 0,0:09:59.92,0:10:01.38,Main,,0,0,0,,Law mu?
Dialogue: 0,0:10:04.78,0:10:08.60,Main,,0,0,0,,Ne yapıyorsun sen Trao!\NGemiye gel çabuk!
Dialogue: 0,0:10:08.60,0:10:12.36,Main,,0,0,0,,Sanat parçasına dönüştük, kurtar bizi!
Dialogue: 0,0:10:12.36,0:10:14.39,Main,,0,0,0,,Ben gayet iyiyim!
Dialogue: 0,0:10:14.39,0:10:16.70,Main,,0,0,0,,{\i1}Beni dinleyin, gemiyi...{\i0}
Dialogue: 0,0:10:16.70,0:10:19.06,Main,,0,0,0,,{\i1}...derhal Green Bit'e getirin!
Dialogue: 0,0:10:19.06,0:10:21.53,Main,,0,0,0,,Caesar'ı size teslim edeceğim!
Dialogue: 0,0:10:25.27,0:10:28.62,Main,,0,0,0,,Yok artık! İmkansızı isteyip\Ntelefonu yüzümüze kapattı!
Dialogue: 0,0:10:28.62,0:10:31.13,Main,,0,0,0,,Caesar-san'ı teslim etmiş olması\Ngerekmiyor muydu?!
Dialogue: 0,0:10:31.13,0:10:32.35,Main,,0,0,0,,Bu ne şimdi ya?!
Dialogue: 0,0:10:32.35,0:10:34.48,Main,,0,0,0,,Bizi dinlemeden\Ndiyeceğini deyip kapattı!
Dialogue: 0,0:10:34.48,0:10:35.92,Main,,0,0,0,,Adam Luffy sanki!
Dialogue: 0,0:10:41.99,0:10:46.22,Captions,,0,0,220,,{\fad(250,0)}Green Bit
Dialogue: 0,0:10:50.57,0:10:52.30,Main,,0,0,0,,Boşuna çabalıyorsun, Law!
Dialogue: 0,0:10:53.04,0:10:55.68,Main,,0,0,0,,Kimi aradın?
Dialogue: 0,0:10:58.54,0:11:01.11,Main,,0,0,0,,Caesar'ın kalbini ver haydi!
Dialogue: 0,0:11:02.71,0:11:06.37,Main,,0,0,0,,Burada bu şekilde çabalamanın\Nhiçbir faydası yok.
Dialogue: 0,0:11:09.86,0:11:16.42,Main,,0,0,0,,Ortağın Hasır Şapka kurduğum tuzağa tıpış tıpış düştü bile.
Dialogue: 0,0:11:20.52,0:11:26.50,Main,,0,0,0,,Şu anda Kolezyum'da\Ndövüş müsabakasında mücadele ediyor.
Dialogue: 0,0:11:27.56,0:11:33.66,Main,,0,0,0,,Tüm dünyadan yalnızca güçlü suçluların katılabildiği ölümcül bir yarışma.
Dialogue: 0,0:11:33.66,0:11:37.06,Main,,0,0,0,,Kaybedenin ödülü\Ncehenneme dönüşü olmayan bilet oluyor.
Dialogue: 0,0:11:37.99,0:11:42.95,Main,,0,0,0,,Kolezyumdan asla sağ çıkamayacak.
Dialogue: 0,0:11:51.30,0:11:53.76,Main,,0,0,0,,İttifağınızın sonu bu.
Dialogue: 0,0:11:55.25,0:11:56.49,Main,,0,0,0,,Law...
Dialogue: 0,0:11:58.76,0:12:01.07,Main,,0,0,0,,Vazgeç artık!
Dialogue: 0,0:12:07.94,0:12:12.58,Captions,,0,0,250,,{\fad(500,0))}Dressrosa\NSanji ve Kin'emon
Dialogue: 0,0:12:08.33,0:12:11.07,Main,,0,0,8,,Göster gününü, Luffy-dono!
Dialogue: 0,0:12:11.07,0:12:13.05,Main,,0,0,8,,Durduk yere ne diye tezahürata başladın?!
Dialogue: 0,0:12:13.05,0:12:17.01,Main,,0,0,0,,Fakat Sanji-dono, iş bu noktaya geldimi\Nerkek kimisi kazanmalıdır!
Dialogue: 0,0:12:27.71,0:12:28.89,Main,,0,0,0,,Burgess!
Dialogue: 0,0:12:28.89,0:12:32.06,Main,,0,0,0,,İşler epey ilginç bir hal almış\Ndiye duydum!
Dialogue: 0,0:12:32.60,0:12:35.69,Main,,0,0,0,,Şu bücür de kimin nesi?
Dialogue: 0,0:12:37.17,0:12:39.44,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:12:41.30,0:12:44.38,Main,,0,0,0,,{\fad(150,0)}...Şahin Tüfeği!
Dialogue: 0,0:12:44.38,0:12:46.54,Main,,0,0,0,,Lucy tüm gücüyle asılıyor!
Dialogue: 0,0:13:08.44,0:13:10.00,Main,,0,0,0,,Fena değilmişsin.
Dialogue: 0,0:13:10.32,0:13:12.94,Main,,0,0,0,,Burada yenilemem!
Dialogue: 0,0:13:14.52,0:13:18.08,Main,,0,0,0,,Güldürmesene beni be, imkansız o dediğin!
Dialogue: 0,0:13:19.94,0:13:22.70,Main,,0,0,0,,Size "Musibet Nesil" deyip\Ndikkatleri üzerinize çektiler...
Dialogue: 0,0:13:22.73,0:13:25.44,Main,,0,0,0,,...ki bu durum kendinizi bir\Nşey sanmanıza neden olmuş.
Dialogue: 0,0:13:25.44,0:13:30.22,Main,,0,0,0,,Fakat hiçbiriniz bizim cenk eylediğimiz o denizden geçebilecek kadar güçlü değilsiniz!
Dialogue: 0,0:13:30.22,0:13:34.66,Main,,0,0,0,,Beyazsakal'ın da ölümüyle geriye\Ndoğru dürüst kimse kalmadı sayılır.
Dialogue: 0,0:13:34.66,0:13:40.00,Main,,0,0,0,,Umut vaadeden\NKarasakal Teach var yalnızca!
Dialogue: 0,0:13:40.00,0:13:41.30,Main,,0,0,0,,Karasakal mı?
Dialogue: 0,0:13:41.30,0:13:45.83,Main,,0,0,0,,Birini seç deseler\Nonu seçerdim ki zaten...
Dialogue: 0,0:13:45.83,0:13:51.53,Main,,0,0,0,,...gücün anca şu anki halime yetiyorsa bil ki krallık konusunda zerre şansın yok!
Dialogue: 0,0:13:51.53,0:13:53.85,Main,,0,0,0,,Korsanlıktan falan vazgeç!
Dialogue: 0,0:13:55.75,0:14:03.16,Main,,0,0,0,,Fena sayılmazsın fakat Reyleigh gibi biri yeni neslin önderi olarak senin seviyende bir velet seçmişse...
Dialogue: 0,0:14:03.16,0:14:05.61,Main,,0,0,0,,...eski zekasından\Nbir eser kalmamış demektir!
Dialogue: 0,0:14:05.61,0:14:09.59,Main,,0,0,0,,İki yıl önceki savaşta damarlarında\Nşeytanın kanını taşıyan Ace'in...
Dialogue: 0,0:14:09.59,0:14:12.33,Main,,0,0,0,,...yani mevcut neslin en şeytani kişisinin\Nkafası ezildiğinde...
Dialogue: 0,0:14:12.33,0:14:14.42,Main,,0,0,0,,...Donanma aslında olaya\Nne kadar hakim olduğunu kanıtlamıştı.
Dialogue: 0,0:14:15.67,0:14:21.73,Main,,0,0,0,,Donanma amirallerini ve Yonkou'yu yenip \NRoger'ı geçebileceğini mi sanıyorsun?!
Dialogue: 0,0:14:21.73,0:14:25.36,Main,,0,0,0,,Böyle bir şeye imkan yok!
Dialogue: 0,0:14:26.58,0:14:28.53,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:14:28.53,0:14:30.85,Main,,0,0,0,,{\fad(150,150)}...Roket!
Dialogue: 0,0:14:30.85,0:14:33.35,Main,,0,0,0,,Lucy uçuyor!
Dialogue: 0,0:14:33.35,0:14:34.79,Main,,0,0,0,,Ne yüksek bir sıçrayış bu!
Dialogue: 0,0:14:38.22,0:14:41.03,Main,,0,0,0,,Gel haydi, gel de dersini vereyim sana!
Dialogue: 0,0:14:41.69,0:14:45.04,Main,,0,0,0,,Garp'a karşı olan 30 yıllık öfkemle...
Dialogue: 0,0:14:45.07,0:14:49.47,Main,,0,0,0,,...en sağlam darbemi indireceğim sana, \NHasır Şapkalı Luffy!
Dialogue: 0,0:14:58.78,0:15:01.81,Main,,0,0,0,,Bu buz da ne böyle be?!
Dialogue: 0,0:15:01.81,0:15:05.67,Main,,0,0,0,,Ateş işlemiyor, balta kesmiyor!
Dialogue: 0,0:15:06.42,0:15:11.56,Main,,0,0,0,,Bunca korsan hazinesi\Ngözümüzün önünde duruyor be!
Dialogue: 0,0:15:15.81,0:15:21.10,Main,,0,0,0,,Bu anakara "Kristal Buz Örtüsü"nden\Nyapılmıştır ve kırabilmek için...
Dialogue: 0,0:15:21.10,0:15:26.87,Main,,0,0,0,,...tek bir noktaya\Ndevasa bir basınç uygulamanız gerekir!
Dialogue: 0,0:15:28.31,0:15:30.21,Main,,0,0,0,,{\fad(150,150)}Delgeç Ejder Çivisi!
Dialogue: 0,0:15:35.87,0:15:37.98,Main,,0,0,0,,{\fad(150,150)}Açıl Chinjao!
Dialogue: 0,0:15:53.81,0:15:56.60,Main,,0,0,0,,Sevdiniz mi burayı,\Nhırsız bozuntuları sizi?
Dialogue: 0,0:15:59.27,0:16:04.51,Main,,0,0,0,,Hazine hırsızlarını bağlayıp\Ndenize fırlatın!
Dialogue: 0,0:16:04.51,0:16:06.81,Main,,0,0,0,,Emredersin patron!
Dialogue: 0,0:16:08.40,0:16:10.32,Main,,0,0,8,,Mutluluk bu işte!
Dialogue: 0,0:16:09.33,0:16:16.82,Captions,,0,0,250,,{\fad(800,800)}Delgeç Chinjao - Happo Donanması\NKorsan Grubunun 12. Lideri  {\fs30}(30 Yıl Önce)
Dialogue: 0,0:16:10.32,0:16:14.96,Main,,0,0,8,,Bu buzdan oda aradığımız her şeye sahip.
Dialogue: 0,0:16:14.96,0:16:16.56,Main,,0,0,8,,Geçmişin sevinci ve hüznü...
Dialogue: 0,0:16:16.56,0:16:18.39,Main,,0,0,0,,Gelecek umutları...
Dialogue: 0,0:16:18.39,0:16:22.15,Main,,0,0,0,,Aile hazinemin onlarca yıllık birikimi!
Dialogue: 0,0:16:22.15,0:16:27.15,Main,,0,0,0,,Ve bu odaya yegâne giriş anahtarıysa\Nbu gördüğünüz kafamdır.
Dialogue: 0,0:16:28.06,0:16:32.13,Main,,0,0,0,,Donanma bile gelse buraya giremez!
Dialogue: 0,0:16:34.97,0:16:40.20,Main,,0,0,0,,Chinjao, kafanı kırabilmek için...
Dialogue: 0,0:16:40.78,0:16:46.85,Main,,0,0,0,,...kum torbalarımmış gibi sekiz dağı yıkarak\Nkendimi eğittim de geldim buraya!
Dialogue: 0,0:16:47.93,0:16:50.05,Main,,0,0,0,,Boşa o kadar uğraşmışsın!
Dialogue: 0,0:16:50.05,0:16:53.71,Main,,0,0,0,,Bu dünyada\Nkafamdan daha sert bir şey yoktur!
Dialogue: 0,0:16:53.71,0:16:56.33,Main,,0,0,0,,Hazırlan, Chinjao!
Dialogue: 0,0:16:56.33,0:17:00.30,Main,,0,0,0,,Çok gurur duyduğun o yumruğunu\Nparçalayacağım, Garp!
Dialogue: 0,0:17:19.08,0:17:21.11,Main,,0,0,0,,Patron!
Dialogue: 0,0:17:21.44,0:17:24.78,Main,,0,0,0,,Başardı!
Dialogue: 0,0:17:25.96,0:17:27.40,Main,,0,0,0,,Denize açılın!
Dialogue: 0,0:17:27.40,0:17:30.00,Main,,0,0,0,,Tüm gemiler denize açılsın!
Dialogue: 0,0:17:33.57,0:17:35.13,Main,,0,0,0,,Patron!
Dialogue: 0,0:17:35.53,0:17:38.08,Main,,0,0,0,,Patron, iyisin!
Dialogue: 0,0:17:47.12,0:17:48.95,Main,,0,0,0,,{\fad(150,0)}Açıl Chinjao!
Dialogue: 0,0:17:51.21,0:17:52.42,Main,,0,0,0,,{\fad(150,0)}Delgeç Ejder Çivisi!
Dialogue: 0,0:17:53.78,0:17:55.08,Main,,0,0,0,,Patron!
Dialogue: 0,0:17:55.08,0:17:56.82,Main,,0,0,0,,Yeter artık patron!
Dialogue: 0,0:17:57.02,0:17:58.00,Main,,0,0,0,,Öleceksin!
Dialogue: 0,0:17:58.00,0:17:59.56,Main,,0,0,0,,Açıl!
Dialogue: 0,0:18:04.30,0:18:05.75,Main,,0,0,0,,Açılmıyor.
Dialogue: 0,0:18:06.72,0:18:10.57,Main,,0,0,0,,Ne yapmalı şimdi?!\NBenim hazinem bu!
Dialogue: 0,0:18:11.04,0:18:15.94,Main,,0,0,0,,Hayatımın anlamı\Ngözümün önünde yatıyor!
Dialogue: 0,0:18:16.59,0:18:18.65,Main,,0,0,0,,Talihim!
Dialogue: 0,0:18:19.89,0:18:23.21,Main,,0,0,0,,Lanet olası Garp!\NBunun hesabını soracağım senden!
Dialogue: 0,0:18:23.86,0:18:27.52,Main,,0,0,0,,Çocukların, torunların dahi\Nbu öfkeden nasiplerini alacak!
Dialogue: 0,0:18:27.52,0:18:29.49,Main,,0,0,0,,Sana olan...
Dialogue: 0,0:18:29.49,0:18:33.34,Main,,0,0,0,,...bu kinim asla tükenmeyecek!
Dialogue: 0,0:18:36.42,0:18:40.25,Main,,0,0,0,,Ondan kısa süre sonra da\Nkorsanlığı bıraktım.
Dialogue: 0,0:18:40.25,0:18:43.66,Main,,0,0,0,,Gücümü kaybetmiştim,\Nkalbim kırılmıştı.
Dialogue: 0,0:18:50.47,0:18:52.31,Main,,0,0,0,,Bu da ne böyle?!
Dialogue: 0,0:18:52.31,0:18:55.18,Main,,0,0,0,,Hayal mi görüyorum?!
Dialogue: 0,0:18:55.82,0:18:58.31,Main,,0,0,0,,Lucy'nin kolu kocaman gözüküyor!
Dialogue: 0,0:18:58.31,0:19:00.45,Main,,0,0,0,,Göreceksin Garp!
Dialogue: 0,0:19:00.45,0:19:04.59,Main,,0,0,0,,Değerli torununun canını alacağım!
Dialogue: 0,0:19:05.06,0:19:06.17,Main,,0,0,0,,Yapılanların hesabı ödenecek!
Dialogue: 0,0:19:06.17,0:19:11.86,Main,,0,0,0,,Her şeyimi benden çalan\Ndedenin yumruğu olmuştu!
Dialogue: 0,0:19:11.86,0:19:14.74,Main,,0,0,0,,Bir yumruk yemişsin altı üstü!
Dialogue: 0,0:19:14.74,0:19:18.60,Main,,0,0,0,,Dedemden ne kadar çok yumruk yediğimden\Nhaberin var mı senin?!
Dialogue: 0,0:19:18.60,0:19:22.47,Main,,0,0,0,,Kemiklerini kazıyacaklar yerden!
Dialogue: 0,0:19:22.47,0:19:24.25,Main,,0,0,0,,{\fad(150,150)}Sekiz Yumruklu Darbe Tekniği!
Dialogue: 0,0:19:27.24,0:19:29.18,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:19:29.55,0:19:31.06,Main,,0,0,0,,{\fad(150,150)}...Thor...
Dialogue: 0,0:19:32.48,0:19:33.72,Main,,0,0,0,,{\fad(150,150)}Delgeçsiz Ejder...
Dialogue: 0,0:19:35.27,0:19:37.93,Main,,0,0,0,,{\fad(150,0)}...Fil Tüfeği!
Dialogue: 0,0:19:37.93,0:19:39.50,Main,,0,0,0,,{\fad(150,150)}...Olmayan Çivi!
Dialogue: 0,0:19:48.20,0:19:50.77,Main,,0,0,0,,Yok artık!
Dialogue: 0,0:19:56.74,0:19:58.88,Main,,0,0,0,,Yok artık!?
Dialogue: 0,0:20:05.08,0:20:06.10,Main,,0,0,0,,İhtiyar!
Dialogue: 0,0:20:06.10,0:20:07.05,Main,,0,0,0,,Dede!
Dialogue: 0,0:20:07.59,0:20:09.79,Main,,0,0,0,,Ringin dışına çıktı!
Dialogue: 0,0:20:09.79,0:20:13.66,Main,,0,0,0,,Chinjao ring dışına çıkarak elendi!
Dialogue: 0,0:20:22.73,0:20:25.74,Main,,0,0,0,,Ne adam ama!
Dialogue: 0,0:20:25.74,0:20:32.08,Main,,0,0,0,,Efsaneyi yenip\NC Bloğu galibiyetini elde eden kişi...
Dialogue: 0,0:20:32.68,0:20:35.98,Main,,0,0,0,,...Gladyatör Lucy oldu!
Dialogue: 0,0:20:35.98,0:20:37.60,Main,,0,0,0,,Bu kadar işte!
Dialogue: 0,0:20:37.60,0:20:42.68,Main,,0,0,0,,Lucy! Lucy! Lucy!
Dialogue: 0,0:20:42.68,0:20:45.76,Main,,0,0,0,,Bu kadar ileri gidebileceğini\Ntahmin etmemiştim!
Dialogue: 0,0:20:45.76,0:20:49.96,Main,,0,0,0,,Gerçekten de\Nsürpriz bir son oldu bu!
Dialogue: 0,0:20:49.96,0:20:52.45,Main,,0,0,0,,Ben sizin Lucy'nize!
Dialogue: 0,0:20:52.45,0:20:54.18,Main,,0,0,0,,Bu bağrışlar acayip sinir bozuyor!
Dialogue: 0,0:20:54.18,0:20:56.93,Main,,0,0,0,,Sahte isimle bile tüm dikkatleri\Nüzerine toplamayı başardı!
Dialogue: 0,0:20:56.93,0:20:59.43,Main,,0,0,0,,Gel buraya da göstereyim ben sana!
Dialogue: 0,0:20:59.43,0:21:02.24,Main,,0,0,0,,Bu sefer elimden kurtulamayacaksın,\NHasır Şapka!
Dialogue: 0,0:21:02.24,0:21:04.41,Main,,0,0,0,,Duymadın mı beni?
Dialogue: 0,0:21:04.41,0:21:07.03,Main,,0,0,0,,Onu öldürmene izin vermem,...
Dialogue: 0,0:21:07.03,0:21:08.63,Main,,0,0,0,,...Cavendish!
Dialogue: 0,0:21:08.63,0:21:12.32,Main,,0,0,0,,Yoluma çıkacak olursan\Nseni de gebertirim, Bartolomeo!
Dialogue: 0,0:21:13.54,0:21:14.89,Main,,0,0,0,,Denemesi bedava!
Dialogue: 0,0:21:14.89,0:21:16.92,Main,,0,0,0,,Hasır Şapka'yı ben öldüreceğim!
Dialogue: 0,0:21:16.92,0:21:18.72,Thoughts,,0,0,0,,{\i1}Hasır Şapka mı?!{\i0}
Dialogue: 0,0:21:25.46,0:21:27.10,Main,,0,0,0,,Bak bu ilginç işte!
Dialogue: 0,0:21:27.10,0:21:31.13,Main,,0,0,0,,Demek durum buymuş!
