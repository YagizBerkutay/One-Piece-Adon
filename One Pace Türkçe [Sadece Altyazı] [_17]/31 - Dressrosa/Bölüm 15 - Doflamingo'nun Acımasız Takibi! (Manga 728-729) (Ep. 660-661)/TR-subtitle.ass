Dialogue: 0,0:01:37.98,0:01:40.96,Main,Vassal,0,0,0,,Kralımıza ne oldu?!
Dialogue: 0,0:01:40.96,0:01:42.55,Main,Vassal,0,0,0,,Ülkeye büyük kaos hakim!
Dialogue: 0,0:01:42.55,0:01:46.56,Main,Vassal,0,0,0,,Sarayı terk ederken\Npek normal görünmüyordu ama...
Dialogue: 0,0:01:46.56,0:01:48.75,Main,Vassal,0,0,0,,...böyle bir şey yapacağını\Ntahmin etmemiştim!
Dialogue: 0,0:01:48.75,0:01:52.80,Main,Vassal,0,0,0,,Ülke içinde halledemeyiz bunu artık,\NDonanma'yı çağırdım!
Dialogue: 0,0:01:52.80,0:01:55.61,Main,Vassal,0,0,0,,Yüzbaşı Vergo ilgileneceğini söyledi!
Dialogue: 0,0:01:57.13,0:01:58.60,Main,Violet,0,0,0,,Baba...
Dialogue: 0,0:01:59.62,0:02:03.02,Title,,0,0,0,,{\an2\fad(500,500)}Bölüm 15\NDoflamingo'nun Acımasız Takibi!
Dialogue: 0,0:02:03.90,0:02:05.44,Main,Violet,0,0,0,,Kar mı bu?
Dialogue: 0,0:02:15.36,0:02:18.88,Main,Violet,0,0,0,,Monet, ne yapıyorsun?!
Dialogue: 0,0:02:18.88,0:02:22.22,Main,Violet,0,0,0,,Saray kapısını niçin açıyorsun?!
Dialogue: 0,0:02:24.21,0:02:28.79,Main,Monet,0,0,0,,Prenses Viola görü yeteneğini kullanırsan...
Dialogue: 0,0:02:28.79,0:02:34.70,Main,Monet,0,0,0,,...şu anda bu ülkede olanları\Naçıkça görebilirsin!
Dialogue: 0,0:02:37.10,0:02:42.22,Main,Monet,0,0,0,,Yeni kraliyet ailesini\Nkarşılamak için buradayım.
Dialogue: 0,0:02:47.75,0:02:49.21,Main,Soldier,0,0,0,,Doğu kulesi bombalandı!
Dialogue: 0,0:02:49.48,0:02:51.05,Main,Soldier,0,0,0,,Korsanlar saraya girdiler!
Dialogue: 0,0:02:51.05,0:02:53.10,Main,Soldier,0,0,0,,Viola-sama yakalandı!
Dialogue: 0,0:02:53.63,0:02:56.07,Main,Pink,0,0,0,,İyi sayılabilecek bir saraymış.
Dialogue: 0,0:02:56.07,0:02:57.47,Main,Pink,0,0,0,,Hiç fena değil.
Dialogue: 0,0:02:57.47,0:02:59.63,Main,Buffalo,0,0,0,,Evet, çok sevdim-dasuyan!
Dialogue: 0,0:02:59.63,0:03:02.73,Main,Machvise,0,0,0,,Genç Bey'imize yakışır bir yer-in!
Dialogue: 0,0:03:02.91,0:03:04.51,Main,Soldier,0,0,0,,Durun lanet olasıcalar!
Dialogue: 0,0:03:04.51,0:03:06.11,Main,Soldier,0,0,0,,Doflamingo'nun adamları mısınız?!
Dialogue: 0,0:03:06.11,0:03:08.38,Main,Soldier,0,0,0,,Monet, Viola-sama'yı bırak!
Dialogue: 0,0:03:08.38,0:03:11.07,Main,Soldier,0,0,0,,Kral Riku-sama'ya\Nsiz mi bir şeyler yaptınız?!
Dialogue: 0,0:03:11.07,0:03:13.84,Main,Jiolla,0,0,0,,Yapacak çok işimiz var!
Dialogue: 0,0:03:14.31,0:03:16.94,Main,Lao,0,0,0,,Tüm sarayı elden geçirmemiz lazım!
Dialogue: 0,0:03:18.00,0:03:21.77,Main,Citizen,0,0,0,,Neden yapıyorsunuz bunu?!
Dialogue: 0,0:03:23.08,0:03:28.17,Main,Riku,0,0,0,,Yalvarıyorum durdur şunu!
Dialogue: 0,0:03:40.19,0:03:44.88,Main,Riku,0,0,0,,{\i1}Halkıma zarar vermenin\Nönüne geçemiyorsam...{\i0}
Dialogue: 0,0:03:48.17,0:03:51.96,Main,Riku,0,0,0,,{\i1}...ölmeyi yeğlerim!{\i0}
Dialogue: 0,0:03:51.96,0:03:57.34,Main,Riku,0,0,0,,{\i1}Yalvarıyorum birileri beni öldürsün!{\i0}
Dialogue: 0,0:04:04.90,0:04:06.86,Main,Citizen,0,0,0,,{\i1}Neden, Kral Riku-sama?{\i0}
Dialogue: 0,0:04:08.60,0:04:12.36,Main,Citizen,0,0,0,,{\i1}Yanlış bir şey mi yaptık?{\i0}
Dialogue: 0,0:04:15.57,0:04:17.91,Main,Citizen,0,0,0,,{\i1}Her daim adil...{\i0}
Dialogue: 0,0:04:19.56,0:04:20.87,Main,Citizen,0,0,0,,{\i1}...her daim...{\i0}
Dialogue: 0,0:04:21.84,0:04:24.53,Main,Citizen,0,0,0,,{\i1}...gurur duyduğumuz\Nbir kral olmuştunuz.{\i0}
Dialogue: 0,0:04:26.71,0:04:29.09,Main,Citizen,0,0,0,,{\i1}Tek bir sözünüzle...{\i0}
Dialogue: 0,0:04:31.58,0:04:34.32,Main,Citizen,0,0,0,,{\i1}...tüm paramızı önünüze yığdık.{\i0}
Dialogue: 0,0:04:36.71,0:04:43.09,Main,Citizen,0,0,0,,{\i1}Keza bizi her daim \Nher şeyden çok önemsemişsinizdir.{\i0}
Dialogue: 0,0:04:47.89,0:04:50.20,Main,Citizen,0,0,0,,{\i1}Gurur ve neşe kaynağımızdınız!{\i0}
Dialogue: 0,0:04:59.09,0:05:00.30,Main,Citizen,0,0,0,,Kral Riku...
Dialogue: 0,0:05:00.87,0:05:04.27,Main,Citizen,0,0,0,,Kral Riku duygularımızla oynadı!
Dialogue: 0,0:05:04.57,0:05:07.86,Main,Citizen,0,0,0,,Paramızı alıp\Nbizi öldürmeyi planlıyor!
Dialogue: 0,0:05:07.86,0:05:12.53,Main,Citizen,0,0,0,,Bencilce arzuları uğruna değersiz birer eşyaymışız gibi aradan çıkartacak bizi!
Dialogue: 0,0:05:12.53,0:05:14.57,Main,Citizen,0,0,0,,Lanet olası Kral Riku!
Dialogue: 0,0:05:14.57,0:05:16.39,Main,Citizen,0,0,0,,Senden nefret ediyorum!
Dialogue: 0,0:05:17.77,0:05:19.65,Main,Citizen,0,0,0,,Sen ki...
Dialogue: 0,0:05:20.27,0:05:24.10,Main,Citizen,0,0,0,,Sen ki insan bile\Nolamayacak kadar aşağılıksın!
Dialogue: 0,0:05:24.39,0:05:25.84,Main,Citizen,0,0,0,,Kral Riku Ordusu geliyor!
Dialogue: 0,0:05:25.84,0:05:28.41,Main,Citizen,0,0,0,,Çekil oradan!\NKaç çabuk!
Dialogue: 0,0:05:31.24,0:05:32.24,Main,Citizen,0,0,0,,Yardım edin!
Dialogue: 0,0:05:43.68,0:05:46.01,Main,Citizen,0,0,0,,Siz de kimsiniz?
Dialogue: 0,0:05:52.21,0:05:54.97,Main,Doflamingo,0,0,0,,Bu ülkeyi kurtarmak için geldik!
Dialogue: 0,0:05:54.97,0:05:59.34,Main,Doflamingo,0,0,0,,Adım Don Quixote Doflamingo!
Dialogue: 0,0:05:59.34,0:06:01.47,Main,Citizen,0,0,0,,Korsan bunlar!
Dialogue: 0,0:06:02.35,0:06:06.45,Main,Citizen,0,0,0,,Fakat bizi Kral Riku Ordusu'ndan\Nkurtardılar.
Dialogue: 0,0:06:17.52,0:06:20.73,Main,Doflamingo,0,0,0,,Dansına hayran kaldım, Kral Riku!
Dialogue: 0,0:06:32.34,0:06:40.31,Main,Doflamingo,0,0,0,,Trébol, Pica, Diamante. \NÜlkeyi tüm pisliklerinden arındırma vaktidir!
Dialogue: 0,0:06:43.57,0:06:44.68,Main,Citizen,0,0,0,,Şükürler olsun!
Dialogue: 0,0:06:44.68,0:06:46.26,Main,Citizen,0,0,0,,Kurtulduk!
Dialogue: 0,0:06:48.51,0:06:54.80,Main,Citizen,0,0,0,,{\i1}Doflamingo! Doflamingo! Doflamingo!{\i0}
Dialogue: 0,0:06:54.80,0:06:59.13,Main,Doflamingo,0,0,0,,Daha da alçal!\NŞiddeti kucakla!
Dialogue: 0,0:07:16.95,0:07:22.22,Main,Thunder Soldier,0,0,0,,Ülke tek bir gecede\NDoflamingo'nun eline geçti.
Dialogue: 0,0:07:22.22,0:07:25.16,Main,Usopp,0,0,0,,Ne korkunç bir olay!\NKabus resmen!
Dialogue: 0,0:07:25.55,0:07:27.01,Main,Robin,0,0,0,,Kurnaz adam!
Dialogue: 0,0:07:28.16,0:07:32.04,Main,Franky,0,0,0,,Doflamingo'yu asla affetmem!
Dialogue: 0,0:07:32.64,0:07:40.46,Main,Gancho,0,0,0,,O zamanlar biz de Kral Riku'nun delirdiğini düşünüp yeni kral Doflamingo'yla iletişim kurmaya çalıştık...
Dialogue: 0,0:07:40.46,0:07:42.23,Main,Gancho,0,0,0,,...fakat sonumuz bu oldu.
Dialogue: 0,0:07:42.62,0:07:46.07,Main,Gancho,0,0,0,,Kral Riku'dan şüphe duyduğum için\Nkendimden utanıyorum!
Dialogue: 0,0:07:46.07,0:07:49.33,Main,Usopp,0,0,0,,Anlıyorum...\NÇok kötü gerçekten.
Dialogue: 0,0:07:49.33,0:07:54.92,Main,Usopp,0,0,0,,O denli saygı duyduğunuz günahsız kralınızın\Nboş yere ölmesine müsaade ettiniz.
Dialogue: 0,0:07:54.92,0:07:57.77,Main,Thunder Soldier,0,0,0,,Hayır, kral hâlâ yaşıyor!
Dialogue: 0,0:07:58.78,0:08:03.83,Main,Thunder Soldier,0,0,0,,Doflamingo eski prenses Viola-sama'nın\Nözel yeteneğini çok beğendiğinden...
Dialogue: 0,0:08:04.77,0:08:07.73,Main,Thunder Soldier,0,0,0,,...onunla bir anlaşma yaptı.
Dialogue: 0,0:08:07.87,0:08:11.19,Flashbacks,Violet,0,0,0,,Babamı öldürmeyeceğine söz verirsen...
Dialogue: 0,0:08:12.00,0:08:15.21,Flashbacks,Violet,0,0,0,,...sana itaat ederim!
Dialogue: 0,0:08:15.58,0:08:20.02,Main,Thunder Soldier,0,0,0,,Viola da hâlâ sağ\Nve Doflamingo için çalışıyor!
Dialogue: 0,0:08:21.28,0:08:26.08,Main,Thunder Soldier,0,0,0,,Ailenin yetkililerinden biri \Nve adı da artık Violet!
Dialogue: 0,0:08:26.26,0:08:28.28,Main,Usopp,0,0,0,,Yetkili mi?!
Dialogue: 0,0:08:28.28,0:08:30.85,Main,Usopp,0,0,0,,Yani Kral Riku prenses sayesinde\Nhâlâ hayatta öyle mi?!
Dialogue: 0,0:08:30.85,0:08:36.31,Main,Thunder Soldier,0,0,0,,Evet, bu ülkede bir yerlerde\Nhâlâ hayatta olduğuna eminim!
Dialogue: 0,0:08:36.31,0:08:40.67,Main,Thunder Soldier,0,0,0,,Fakat geçtiğimiz on yılda ne büyük acılar çektiğini hayal dahi edemem!
Dialogue: 0,0:08:41.48,0:08:43.62,Main,Thunder Soldier,0,0,0,,Viola-sama'nın\Nne denli zorluklar yaşadığını da!
Dialogue: 0,0:08:44.11,0:08:47.66,Main,Thunder Soldier,0,0,0,,Korku, öfke, gözyaşı!
Dialogue: 0,0:08:48.74,0:08:50.98,Main,Thunder Soldier,0,0,0,,Bu on yılı nasıl geçirdi kim bilir!
Dialogue: 0,0:08:53.07,0:08:57.02,Main,Thunder Soldier,0,0,0,,Ayrıca o gecede\NKral Riku gibi kontrol edilip...
Dialogue: 0,0:08:57.02,0:09:02.52,Main,Thunder Soldier,0,0,0,,...gönülsüzce halkın canını almış askerler de\Neminim büyük acı içindedirler!
Dialogue: 0,0:09:03.58,0:09:06.56,Main,Usopp,0,0,0,,O gece hepsi de\Nöldürülmüşlerdir diye düşünüyordum!
Dialogue: 0,0:09:07.13,0:09:13.11,Main,Thunder Soldier,0,0,0,,Bazısı öldürüldü elbette fakat \Nbazılarıysa Doflamingo'ya teslim olup...
Dialogue: 0,0:09:13.11,0:09:16.07,Main,Thunder Soldier,0,0,0,,...korumaları olarak \Nyaşamaya devam ettiler!
Dialogue: 0,0:09:16.45,0:09:18.20,Main,Franky,0,0,0,,Ülkeyi sattılar demek?!
Dialogue: 0,0:09:18.57,0:09:23.42,Main,Thunder Soldier,0,0,0,,Onların da\Nçok acı bir seçim yaptığına eminim.
Dialogue: 0,0:09:23.42,0:09:25.31,Flashbacks,Citizen,0,0,0,,Hadi oradan be!
Dialogue: 0,0:09:25.31,0:09:29.17,Flashbacks,Doflamingo,0,0,0,,Deli kralın emirlerine uyuyorlardı yalnızca.
Dialogue: 0,0:09:29.17,0:09:33.58,Flashbacks,Doflamingo,0,0,0,,Benim için çalışmalarına\Nizin verdiğim için bağışlayın.
Dialogue: 0,0:09:33.58,0:09:36.79,Main,Franky,0,0,0,,Nasıl ağlamam ben buna?!
Dialogue: 0,0:09:36.79,0:09:39.25,Main,Franky,0,0,0,,Herkesin acısı birbirinden büyük!
Dialogue: 0,0:09:40.66,0:09:44.45,Main,Thunder Soldier,0,0,0,,Öldürülen askerler,\Nteslim olan askerler...
Dialogue: 0,0:09:44.45,0:09:48.83,Main,Thunder Soldier,0,0,0,,Fakat bu ikisini topladığında bile koca bir ülkenin ordusuna eş olamazlar!
Dialogue: 0,0:09:50.03,0:09:51.40,Main,Franky,0,0,0,,Nasıl yani?
Dialogue: 0,0:09:51.94,0:09:56.94,Main,Thunder Soldier,0,0,0,,Kimi anılarımı kaybettiğimi \Nsöylemeye çalışıyorum!
Dialogue: 0,0:09:57.66,0:10:01.25,Main,Thunder Soldier,0,0,0,,Fraland. Şehirde sana söylediğim \Nşeyi hatırlıyor musun?
Dialogue: 0,0:10:02.13,0:10:07.50,Main,Thunder Soldier,0,0,0,,Oyuncağa dönüştüğümüzde \Ninsan olduğumuz dönemle ilgili her şeyi hatırlarız...
Dialogue: 0,0:10:07.50,0:10:13.53,Main,Thunder Soldier,0,0,0,,...fakat etrafımızdaki insanlar,\Nailelerimiz dahi, varlığımızı unuturlar.
Dialogue: 0,0:10:14.36,0:10:17.75,Main,Thunder Soldier,0,0,0,,En değer verdikleri şeyi\Nyitirdiklerini bile fark edemezler.
Dialogue: 0,0:10:17.75,0:10:23.84,Main,Thunder Soldier,0,0,0,,Dressrosa'nın en büyük trajedisi budur! \NBiz oyuncaklar da aynı trajediden nasibimizi alırız!
Dialogue: 0,0:10:23.84,0:10:29.91,Main,Robin,0,0,0,,Yani şehirde dolaşan oyuncaklar da\Naslında dostların olabilir...
Dialogue: 0,0:10:29.91,0:10:34.47,Main,Robin,0,0,0,,...fakat hepsini unuttuğun için\Nonları hatırlayamıyorsun öyle mi?
Dialogue: 0,0:10:34.47,0:10:35.41,Main,Thunder Soldier,0,0,0,,Aynen öyle.
Dialogue: 0,0:10:35.41,0:10:41.89,Main,Thunder Soldier,0,0,0,,Üstelik kendilerini oyuncağa dönüştüren\NDoflamingo'ya karşı büyük nefret besliyor olmalılar.
Dialogue: 0,0:10:43.16,0:10:46.69,Main,Thunder Soldier,0,0,0,,Doflamingo muhalif herkesi\Ngöz önünden kaldırmaya çalıştı.
Dialogue: 0,0:10:46.69,0:10:52.20,Main,Thunder Soldier,0,0,0,,Fakat bu aynı zamanda ülkenin karanlıklarında \Npek çok muhalif kişinin var olduğu anlamına geliyor!
Dialogue: 0,0:10:53.26,0:10:59.40,Main,Thunder Soldier,0,0,0,,Sayısı belli olmayan bu insanlar\Nplanımızın kilit noktasını oluşturuyor!
Dialogue: 0,0:10:59.40,0:11:01.14,Main,Franky,0,0,0,,Anlıyorum!
Dialogue: 0,0:11:01.14,0:11:04.29,Main,Franky,0,0,0,,Demek bu yüzden\Nkazanabileceğinizi düşünüyorsunuz.
Dialogue: 0,0:11:04.29,0:11:09.31,Main,Franky,0,0,0,,Shichibukai'ın grubuna kafa tutmak\Naptalca gibi görünebilir...
Dialogue: 0,0:11:09.31,0:11:14.21,Main,Franky,0,0,0,,...fakat ülkenin tüm oyuncakları bu muhalif güçlerin bir parçasıysa yeterli güce de ulaşılır!
Dialogue: 0,0:11:14.21,0:11:16.71,Main,Usopp,0,0,0,,Dur bakalım biraz!
Dialogue: 0,0:11:16.71,0:11:20.37,Main,Usopp,0,0,0,,Ne diye Doflamingo'yu\Ntahtından etme hayalleri kuruyorsun?!
Dialogue: 0,0:11:20.37,0:11:23.16,Main,Usopp,0,0,0,,Biz buraya fabrikayı yok etmeye geldik!
Dialogue: 0,0:11:23.16,0:11:25.55,Main,Usopp,0,0,0,,İşimiz bittiğinde saniyesinde\Nbu ülkeye elveda edeceğiz!
Dialogue: 0,0:11:25.55,0:11:26.79,Main,Usopp,0,0,0,,Değil mi Robin?
Dialogue: 0,0:11:26.79,0:11:28.56,Main,Robin,0,0,0,,Doflamingo'yu asla affetmem!
Dialogue: 0,0:11:30.06,0:11:33.27,Main,Leo,0,0,0,,Bugün bu savaşı vermek\Nkaderimizde var!
Dialogue: 0,0:11:33.27,0:11:35.91,Main,Leo,0,0,0,,Bu sabah yaşananlar\Nbize karşı büyük bir gözdağıydı!
Dialogue: 0,0:11:36.28,0:11:40.42,Main,Leo,0,0,0,,Ayrıca Usoland'ın bugün ortaya çıkması da rastlantı değil!
Dialogue: 0,0:11:40.42,0:11:42.98,Main,Leo,0,0,0,,İlahi bir güç\Nbize savaşmamız gerektiğini söylüyor!
Dialogue: 0,0:11:43.91,0:11:45.47,Main,Usoland,0,0,0,,Ne oldu ki bu sabah?
Dialogue: 0,0:11:45.47,0:11:48.11,Main,Thunder Soldier,0,0,0,,Doflamingo'nun tahtı bırakması olayı.
Dialogue: 0,0:11:48.11,0:11:50.62,Main,Usopp,0,0,0,,İşin aslı onu biz...
Dialogue: 0,0:11:50.62,0:11:54.00,Main,Thunder Soldier,0,0,0,,O haberi duyduğumuzda\Nçok mutlu olmuştuk!
Dialogue: 0,0:11:54.00,0:11:56.06,Main,Thunder Soldier,0,0,0,,Bir mucize gerçekleşti sanmıştım!
Dialogue: 0,0:11:56.37,0:11:59.05,Main,Thunder Soldier,0,0,0,,Sonra yalan haber olduğunu duyunca...
Dialogue: 0,0:11:59.05,0:12:03.33,Main,Thunder Soldier,0,0,0,,...cennetin kıyılarından\Ncehenneme düşmüş gibi olduk!
Dialogue: 0,0:12:04.34,0:12:09.98,Main,Thunder Soldier,0,0,0,,Onunla savaşmak için\Nbundan daha iyi bir gün olabilir mi?!
Dialogue: 0,0:12:12.11,0:12:15.43,Thoughts,Usopp,0,0,0,,{\i1}Özür dileriz!{\i0}
Dialogue: 0,0:12:15.94,0:12:18.80,Captions,,0,0,220,,{\fad(250,150)}Dressrosa'nın Altı
Dialogue: 0,0:12:18.55,0:12:21.72,Main,Riku,0,0,0,,{\an8}Emekli olmana rağmen\Ngemiyi sen getirdin demek buraya?
Dialogue: 0,0:12:18.81,0:12:21.72,Captions,,0,0,220,,{\fad(150,0)}Hurdalık
Dialogue: 0,0:12:21.72,0:12:25.78,Main,Chinjao,0,0,0,,Happo Donanması'nı devralacak\Nbaşka kimse yok.
Dialogue: 0,0:12:25.78,0:12:28.36,Main,Chinjao,0,0,0,,Keşke bir torunum olsaydı.
Dialogue: 0,0:12:28.36,0:12:29.91,Main,Riku,0,0,0,,Anlıyorum.
Dialogue: 0,0:12:29.91,0:12:32.00,Main,Riku,0,0,0,,Korsanlık da kolay şey değil.
Dialogue: 0,0:12:32.47,0:12:34.06,Thoughts,Riku,0,0,0,,{\i1}Bana mı öyle geliyor bilmiyorum ama...
Dialogue: 0,0:12:34.06,0:12:37.47,Thoughts,Riku,0,0,0,,{\i1}...bir şeyleri unutmuşum gibi sanki.
Dialogue: 0,0:12:37.47,0:12:40.72,Thoughts,Riku,0,0,0,,{\i1}10 yıl önce de aynı şey olmuştu.
Dialogue: 0,0:12:41.87,0:12:45.28,Thoughts,Boo,0,0,0,,{\i1}Nereye gidiyorum?!{\i0}
Dialogue: 0,0:12:45.28,0:12:47.61,Thoughts,Boo,0,0,0,,{\i1}İhtiyar, yardım et!{\i0}
Dialogue: 0,0:12:47.61,0:12:51.75,Thoughts,Abdullah,0,0,0,,{\i1}Yalnız kurt Abdullah'a\Nne yaptınız siz?!{\i0}
Dialogue: 0,0:12:51.75,0:12:54.89,Thoughts,Jeet,0,0,0,,{\i1}Benim gibi başına buyruk bir savaşçıya \Nne yaptınız?!{\i0}
Dialogue: 0,0:12:55.31,0:12:57.49,Thoughts,All,0,0,0,,{\i1}Yardım edin!{\i0}
Dialogue: 0,0:12:59.22,0:13:01.99,Captions,,0,0,220,,{\fad(200,0)}Corrida Kolezyumu
Dialogue: 0,0:12:59.97,0:13:01.99,Main,Luffy,0,0,2,,Zoro!
Dialogue: 0,0:13:01.99,0:13:04.12,Main,Luffy,0,0,0,,Canı çıkası Horoz Kafa!
Dialogue: 0,0:13:04.12,0:13:07.32,Main,Luffy,0,0,0,,Yolu göstereceğim deyip bayılıverdi!
Dialogue: 0,0:13:07.32,0:13:09.12,Main,Luffy,0,0,0,,Zoro cidden burada mı acaba?
Dialogue: 0,0:13:11.97,0:13:16.51,Main,Luffy,0,0,0,,Hey, Zoro, Kin'emon!
Dialogue: 0,0:13:16.51,0:13:17.64,Main,Zoro,0,0,0,,Luffy!
Dialogue: 0,0:13:19.18,0:13:21.25,Main,Zoro,0,0,0,,Bağırmasana salak,\Nbulacaklar şimdi bizi!
Dialogue: 0,0:13:21.72,0:13:29.02,Main,Kin'emon,0,0,0,,Pek güvenememiştim aslında ama \No tuhaf konuşan genç verdiği sözü tutmuş.
Dialogue: 0,0:13:29.02,0:13:30.42,Main,Zoro,0,0,0,,Sahi o nerede?
Dialogue: 0,0:13:30.42,0:13:32.90,Main,Luffy,0,0,0,,Buraya gelirken yolda bayılıverdi.
Dialogue: 0,0:13:34.75,0:13:39.12,Main,Bellamy,0,0,0,,Buldum seni, Hasır Şapka!
Dialogue: 0,0:13:39.51,0:13:43.01,Flashbacks,Bellamy,0,0,0,,Joker Hasır Şapka'yı öldürmemi mi istiyor?!
Dialogue: 0,0:13:43.01,0:13:45.97,Flashbacks,Diamante,0,0,0,,Yarışma sona ermeden bitir işini.
Dialogue: 0,0:13:45.97,0:13:49.79,Flashbacks,Diamante,0,0,0,,Bu sayede sen de\Naile yöneticilerinden biri olacaksın.
Dialogue: 0,0:13:52.09,0:13:54.10,Thoughts,Bellamy,0,0,0,,{\i1}Kusura bakma Hasır Şapka...{\i0}
Dialogue: 0,0:14:07.10,0:14:09.65,Main,Dellinger,0,0,0,,Buldum seni Bellamy!
Dialogue: 0,0:14:10.26,0:14:12.87,Main,Dellinger,0,0,0,,Öldürme işini hallettin mi?
Dialogue: 0,0:14:14.16,0:14:15.99,Main,Dellinger,0,0,0,,Halledemedin daha değil mi?
Dialogue: 0,0:14:17.16,0:14:19.33,Main,Bellamy,0,0,0,,Ne istiyorsun, Dellinger?!
Dialogue: 0,0:14:20.77,0:14:27.39,Captions,,0,0,230,,{\fad(500,600)}Donquixote Ailesi ({\fnA-OTF Jun Pro 201\fs36}♦{\r\fs42}Diamante Ordusu)\NSavaşçı Dellinger
Dialogue: 0,0:14:21.04,0:14:27.40,Captions,,0,0,0,,{\pos(640,502)\fad(583,681)}
Dialogue: 0,0:14:20.98,0:14:23.72,Main,Dellinger,0,0,4,,{\an8}Yani sonuçta seni tanıyorum,...
Dialogue: 0,0:14:23.72,0:14:27.54,Main,Dellinger,0,0,4,,{\an8}...Hasır Şapka'yı öldürme işini\Nbaşaramayacağını biliyordum.
Dialogue: 0,0:14:28.51,0:14:29.85,Main,Bellamy,0,0,0,,Ne dedin?!
Dialogue: 0,0:14:29.85,0:14:33.84,Main,Dellinger,0,0,0,,Rakibin epey güçlü sonuçta,\Nelden ne gelir ki değil mi?
Dialogue: 0,0:14:33.84,0:14:39.43,Main,Dellinger,0,0,0,,Fakat başarıp başaramamanın\Npek bir önemi yoktu zaten.
Dialogue: 0,0:14:39.43,0:14:40.69,Main,Bellamy,0,0,0,,Bu da ne demek şimdi?!
Dialogue: 0,0:14:40.69,0:14:44.66,Main,Dellinger,0,0,0,,Hasır Şapka'nın öldürülme emri\No kadar da ciddi değildi.
Dialogue: 0,0:14:44.66,0:14:47.53,Main,Dellinger,0,0,0,,Genç Bey'imiz peşinde dolaşıp...
Dialogue: 0,0:14:47.53,0:14:50.65,Main,Dellinger,0,0,0,,...ayakbağı olmanı istemiyor o yüzden de...
Dialogue: 0,0:14:51.36,0:14:52.99,Main,Dellinger,0,0,0,,...burada işini bitirmemi emretti.
Dialogue: 0,0:14:53.76,0:14:55.62,Main,Bellamy,0,0,0,,Ne dedin...
Dialogue: 0,0:14:56.79,0:14:59.08,Main,Dellinger,0,0,0,,Amanın bunu söylememem lazımdı!
Dialogue: 0,0:14:59.48,0:15:01.13,Main,Dellinger,0,0,0,,Ay özür dilerim!
Dialogue: 0,0:15:02.74,0:15:05.02,Main,Bellamy,0,0,0,,Şaka mı lan bu?!
Dialogue: 0,0:15:05.02,0:15:07.45,Captions,,0,0,180,,Demir Köprü'nün Dressrosa Tarafları
Dialogue: 0,0:15:08.99,0:15:10.02,Main,Law,0,0,0,,{\fad(150,150)}Neşter!
Dialogue: 0,0:15:14.62,0:15:15.80,Main,Doflamingo,0,0,0,,{\fad(150,150)}Sicim Mermisi!
Dialogue: 0,0:15:24.95,0:15:27.94,Main,Doflamingo,0,0,0,,Şimdi ne yapacaksın, Law?
Dialogue: 0,0:15:29.21,0:15:32.71,Main,Doflamingo,0,0,0,,Dressrosa hemen şurada bak.
Dialogue: 0,0:15:34.13,0:15:35.41,Main,Diamante,0,0,0,,{\i1}Hey, Doffy.{\i0}
Dialogue: 0,0:15:40.86,0:15:44.04,Main,Diamante,0,0,0,,{\i1}Kusuruma bakma, meşgul müydün?{\i0}
Dialogue: 0,0:15:44.04,0:15:46.76,Main,Doflamingo,0,0,0,,Yok, önemli bir şey değil zaten.\NSöyle.
Dialogue: 0,0:15:46.76,0:15:49.79,Main,Diamante,0,0,0,,Violet bize ihanet etti.
Dialogue: 0,0:15:50.18,0:15:54.67,Main,Doflamingo,0,0,0,,Kara Bacak'ı burada görünce bir şeylerin\Nters gittiğini anlamıştım zaten.
Dialogue: 0,0:15:54.67,0:16:00.55,Main,Diamante,0,0,0,,{\i1}Giro Giro Meyvesi gücüyle Hasır Şapkalar'ın planını öğrenmemiz gerekiyordu.{\i0}
Dialogue: 0,0:16:00.55,0:16:02.89,Main,Diamante,0,0,0,,Fakat artık öyle bir ihtimal kalmadı.
Dialogue: 0,0:16:02.89,0:16:05.96,Main,Doflamingo,0,0,0,,{\i1}Mesele oysa takma kafana.{\i0}
Dialogue: 0,0:16:05.96,0:16:07.48,Main,Doflamingo,0,0,0,,{\i1}Diamante.{\i0}
Dialogue: 0,0:16:07.48,0:16:11.28,Main,Doflamingo,0,0,0,,Lao G.'nin takımını\NGÜLÜCÜK fabrikasına gönder.
Dialogue: 0,0:16:11.28,0:16:13.25,Main,Diamante,0,0,0,,{\i1}Olur mu öyle şey yahu!{\i0}
Dialogue: 0,0:16:13.25,0:16:18.14,Main,Diamante,0,0,0,,Finallerde savaşıp\Ninsanları eğlendirmeleri gerekiyordu.
Dialogue: 0,0:16:18.14,0:16:20.61,Main,Doflamingo,0,0,0,,{\i1}O işi tek başına halledebilirsin\Ndiye düşünüyorum.{\i0}
Dialogue: 0,0:16:20.61,0:16:23.01,Main,Diamante,0,0,0,,Yapma şimdi, bana sanki\Nbir dahiymişim gibi davranıyorsun.
Dialogue: 0,0:16:23.01,0:16:24.87,Main,Doflamingo,0,0,0,,{\i1}Senden başkası yapamaz bu işi.{\i0}
Dialogue: 0,0:16:24.87,0:16:27.40,Main,Diamante,0,0,0,,Öyle bir diyorsun ki sanki...
Dialogue: 0,0:16:27.40,0:16:29.70,Main,Doflamingo,0,0,0,,{\i1}Dahisin işte!{\i0}
Dialogue: 0,0:16:29.70,0:16:32.04,Main,Diamante,0,0,0,,Madem bu kadar ısrar ediyorsun\No iş bende!
Dialogue: 0,0:16:35.83,0:16:40.63,Main,Doflamingo,0,0,0,,Law. Sen burada \Ndikkatleri üzerinde tutarken...
Dialogue: 0,0:16:40.63,0:16:44.65,Main,Doflamingo,0,0,0,,...Hasır Şapkalar'ın diğer üyeleri\Nfabrikayı yıkmayı planlıyor.
Dialogue: 0,0:16:44.65,0:16:49.59,Main,Doflamingo,0,0,0,,Elbette fabrika yıkıldığı müddetçe\Nsen burada ölecek olsan bile...
Dialogue: 0,0:16:49.59,0:16:54.23,Main,Doflamingo,0,0,0,,...GÜLÜCÜK üretemediğimden\NKaidou işimi bitirecek.
Dialogue: 0,0:16:54.23,0:16:56.33,Main,Doflamingo,0,0,0,,Sen de bunun peşindesin, değil mi?
Dialogue: 0,0:16:57.90,0:17:02.60,Main,Doflamingo,0,0,0,,Fakat ne sen burada yeterli\Nzaman kazanabileceksin...
Dialogue: 0,0:17:02.60,0:17:05.17,Main,Doflamingo,0,0,0,,...ne de Hasır Şapkalar\Numduğun kadar başarılı olacaklar.
Dialogue: 0,0:17:08.49,0:17:11.70,Main,Doflamingo,0,0,0,,Onları kullandığını söylemiştin...
Dialogue: 0,0:17:11.70,0:17:17.37,Main,Doflamingo,0,0,0,,...ama onlara güvenmesen\Nböyle bir işi onlara emanet etmezdin.
Dialogue: 0,0:17:17.37,0:17:19.23,Main,Doflamingo,0,0,0,,Nasıl oluyor da...
Dialogue: 0,0:17:19.68,0:17:22.45,Main,Doflamingo,0,0,0,,...Hasır Şapka'ya\Nbu kadar güvenebiliyorsun?!
Dialogue: 0,0:17:25.93,0:17:27.82,Main,Law,0,0,0,,D'nin bir kez daha...
Dialogue: 0,0:17:27.82,0:17:31.20,Main,Law,0,0,0,,...fırtınalar kopartacağını biliyorum çünkü!
Dialogue: 0,0:17:31.20,0:17:33.50,Main,Luffy,0,0,0,,Ne istemiştin, Zoro?
Dialogue: 0,0:17:33.50,0:17:37.94,Main,Zoro,0,0,0,,Madem böyle bir yarışmaya katılacaktın,\Nbana niye haber vermedin?!
Dialogue: 0,0:17:38.78,0:17:39.94,Main,Luffy,0,0,0,,Kusura bakma!
Dialogue: 0,0:17:39.94,0:17:42.79,Captions,,0,0,220,,{\fad(0,600)}Dressrosa\NCorrida Kolezyum'u Dışı
Dialogue: 0,0:17:39.94,0:17:43.07,Main,Zoro,0,0,0,,{\an8}Sen burada eğlenirken\Nbense şehirde koşturuyordum!
Dialogue: 0,0:17:43.41,0:17:46.49,Main,Kin'emon,0,0,0,,Bunları konuşmaya gelmedik buraya!
Dialogue: 0,0:17:47.78,0:17:48.71,Main,Marine,0,0,0,,Koramiral Bastille!
Dialogue: 0,0:17:49.99,0:17:53.01,Main,Marine,0,0,0,,O adam tahmin ettiğim gibi\N"Korsan Avcısı" çıktı.
Dialogue: 0,0:17:53.01,0:17:57.39,Main,Marine,0,0,0,,Kolezyumdaki adam da\Nbüyük ihtimalle Hasır Şapkalı Luffy!
Dialogue: 0,0:17:57.42,0:18:01.89,Captions,,0,0,250,,{\fad(496,0)}Donanma Karargahı'nda Koramiral\NKöpekbalığı-Dilimleyici Bastille
Dialogue: 0,0:17:57.96,0:18:01.89,Main,Bastille,0,0,4,,{\an8}C Bloğu kazananı\NLucy'den bahsediyorsun demek?
Dialogue: 0,0:18:01.89,0:18:05.13,Main,Bastille,0,0,0,,O kadar güçlü olmasına\Nşaşırmamalı-dara!
Dialogue: 0,0:18:05.13,0:18:09.33,Main,Bastille,0,0,0,,Smoker'ın da dediği gibi\Nbu ülkeye gelmişler demek.
Dialogue: 0,0:18:09.33,0:18:11.28,Main,Marine,0,0,0,,Yakalayalım mı?
Dialogue: 0,0:18:11.28,0:18:14.41,Main,Bastille,0,0,0,,Hayır, şimdilik dokunmayalım onlara.
Dialogue: 0,0:18:14.41,0:18:16.57,Main,Bastille,0,0,0,,Kolezyum şu anda...
Dialogue: 0,0:18:16.57,0:18:24.68,Main,Bastille,0,0,0,,...Yeni Dünya'nın ünlü korsanları,\Nhazine avcıları ve paralı askerleriyle dolu-dara.
Dialogue: 0,0:18:24.68,0:18:28.82,Main,Bastille,0,0,0,,Hasır Şapkalar'ı yakalayacağız diye\Nortalığı velveleye verirsek şimdi...
Dialogue: 0,0:18:28.82,0:18:31.06,Main,Bastille,0,0,0,,...burada olduğumuzu da\Nbelli etmiş oluruz-dara.
Dialogue: 0,0:18:31.98,0:18:37.86,Main,Bastille,0,0,0,,Planımız onları kolezyumdan \Nçıkarlarken bir bir avlamak.
Dialogue: 0,0:18:37.86,0:18:42.03,Main,Bastille,0,0,0,,Hepsini de göz açıp kapayana dek\Nyakalayacağız-dara.
Dialogue: 0,0:18:42.03,0:18:47.23,Main,Marine,0,0,0,,Çoktan elenmiş isimler C Bloğu'ndan \NDon Chin Jao ve...
Dialogue: 0,0:18:48.25,0:18:50.81,Main,Marine,0,0,0,,Bilmediğim bir sürü\Nismi de yazmışım.
Dialogue: 0,0:18:51.89,0:18:54.48,Thoughts,Bastille,0,0,0,,{\i1}Kimi yakalamaya geldik ki biz buraya?{\i0}
Dialogue: 0,0:18:54.48,0:18:55.55,Thoughts,Bastille,0,0,0,,{\i1}Oha?{\i0}
Dialogue: 0,0:18:56.04,0:18:57.93,Main,Kin'emon,0,0,0,,Oldu mu acaba?
Dialogue: 0,0:18:57.93,0:18:59.52,Main,Zoro,0,0,0,,Ne yapıyorsun?
Dialogue: 0,0:18:59.52,0:19:02.73,Main,Kin'emon,0,0,0,,Sanji-dono Luffy-dono'ya ulaşır ulaşmaz\Narayın demişti.
Dialogue: 0,0:19:02.73,0:19:03.33,Main,Zoro,0,0,0,,Hadi ya?
Dialogue: 0,0:19:03.33,0:19:05.02,Main,Zoro,0,0,0,,Sahi ya Luffy...
Dialogue: 0,0:19:05.79,0:19:09.07,Main,Zoro,0,0,0,,Donanma kolezyumun çevresini sarmış durumda.
Dialogue: 0,0:19:10.17,0:19:12.63,Main,Kin'emon,0,0,0,,Zerre umursamadı!\NSırf onu söylemek için geldik biz be!
Dialogue: 0,0:19:12.76,0:19:17.08,Captions,,0,0,180,,{\fad(525,520)}Dressrosa Açıkları
Dialogue: 0,0:19:14.68,0:19:16.06,Main,Sanji,0,0,4,,Kin'emon olsa gerek.
Dialogue: 0,0:19:18.05,0:19:19.71,Main,Luffy,0,0,0,,{\i1}Sen misin Sanji?\NBenim!{\i0}
Dialogue: 0,0:19:19.71,0:19:20.83,Main,Nami,0,0,0,,Luffy?
Dialogue: 0,0:19:20.83,0:19:23.68,Main,Sanji,0,0,0,,Pekâlâ Chopper,\Noradan da Usopp'ları ara.
Dialogue: 0,0:19:23.68,0:19:24.76,Main,Chopper,0,0,0,,Tamamdır!
Dialogue: 0,0:19:25.97,0:19:27.65,Main,Usopp,0,0,0,,{\i1}Usopp'u aradınız!{\i0}
Dialogue: 0,0:19:27.97,0:19:30.35,Main,Sanji,0,0,0,,Böylece Law hariç\Nhepimiz bağlanmış olduk.
Dialogue: 0,0:19:30.35,0:19:32.46,Main,Sanji,0,0,0,,Durumunuz nedir?
Dialogue: 0,0:19:33.43,0:19:34.91,Main,Franky,0,0,0,,{\i1}Franky konuşuyor.{\i0}
Dialogue: 0,0:19:34.91,0:19:36.53,Main,Franky,0,0,0,,{\i1}Usopp ve Robin'le birlikteyim.{\i0}
Dialogue: 0,0:19:36.53,0:19:37.45,Main,Usopp,0,0,0,,{\i1}Ne yapıyorsun be?!{\i0}
Dialogue: 0,0:19:37.45,0:19:39.09,Main,Franky,0,0,0,,Dinleyin!
Dialogue: 0,0:19:39.09,0:19:43.60,Main,Franky,0,0,0,,Biz şu anda Doflamingo karşıtlarının oluşturduğu Kral Riku Ordusu'yla birlikteyiz.
Dialogue: 0,0:19:43.60,0:19:44.60,Main,Sanji,0,0,0,,{\i1}Ordu mu?{\i0}
Dialogue: 0,0:19:44.60,0:19:45.54,Main,Franky,0,0,0,,Küçük İnsanların...
Dialogue: 0,0:19:45.54,0:19:46.53,Main,Luffy,0,0,0,,{\i1}Küçük İnsanlar mı?{\i0}
Dialogue: 0,0:19:46.53,0:19:49.00,Main,Leo,0,0,0,,Usoland, ne yapıyorsunuz?
Dialogue: 0,0:19:49.86,0:19:52.24,Main,Usopp,0,0,0,,Kahramanlara özel bir toplantı!\NDinlemeyin sakın!
Dialogue: 0,0:19:53.38,0:19:54.42,Main,Leo,0,0,0,,Emredersiniz!
Dialogue: 0,0:19:54.42,0:19:56.91,Main,Dwarves,0,0,0,,{\i1}Bağışlayın!{\i0}
Dialogue: 0,0:19:58.00,0:19:58.94,Main,Franky,0,0,0,,Hey Luffy,...
Dialogue: 0,0:19:58.94,0:20:03.00,Main,Franky,0,0,0,,{\i1}...Kolezyumun önünde tuhaf bir oyuncak askerle tanışmıştık hani hatırladın mı?{\i0}
Dialogue: 0,0:20:03.00,0:20:04.98,Main,Luffy,0,0,0,,Evet!\NKüçük İnsanlar da neyin nesi?
Dialogue: 0,0:20:05.24,0:20:09.69,Main,Franky,0,0,0,,O asker meğer bu ordunun kumandanıymış.
Dialogue: 0,0:20:09.69,0:20:13.99,Main,Franky,0,0,0,,Ve bu kişiler meğer bugün \NDoflamingo'yu alaşağı etmeyi planlıyormuş!
Dialogue: 0,0:20:13.99,0:20:15.88,Main,Luffy,0,0,0,,Asker mi?
Dialogue: 0,0:20:16.28,0:20:20.66,Flashbacks,Rebecca,0,0,0,,Canı pahasına\Nbu krallığı yok etmeyi planlıyor!
Dialogue: 0,0:20:20.83,0:20:23.80,Main,Luffy,0,0,0,,Oha aynı oyuncak asker bu!
Dialogue: 0,0:20:23.80,0:20:26.46,Main,Luffy,0,0,0,,Rebecca onu durdurmak istiyordu!
Dialogue: 0,0:20:26.46,0:20:28.70,Main,Luffy,0,0,0,,Franky, o orduyu durdur!
Dialogue: 0,0:20:28.70,0:20:29.61,Main,Franky,0,0,0,,{\i1}Aptallaşmasana!{\i0}
Dialogue: 0,0:20:29.61,0:20:32.12,Main,Franky,0,0,0,,{\i1}Ben tam tersini düşünüyorum!{\i0}
Dialogue: 0,0:20:32.12,0:20:34.79,Main,Franky,0,0,0,,{\i1}Şu Rebecca'yla konuştun mu sen?{\i0}
Dialogue: 0,0:20:34.79,0:20:38.01,Main,Luffy,0,0,0,,{\i1}Evet!\NAcayip iyi biriydi!{\i0}
Dialogue: 0,0:20:38.01,0:20:40.62,Main,Luffy,0,0,0,,{\i1}Çok parası olmamasına rağmen\Nüç porsiyon yemek ısmarladı!{\i0}
Dialogue: 0,0:20:41.08,0:20:45.88,Main,Luffy,0,0,0,,{\i1}Buna rağmen arenaya çıkar çıkmaz\Nseyirciler onu yuhalamaya başladılar!{\i0}
Dialogue: 0,0:20:45.88,0:20:48.43,Main,Franky,0,0,0,,{\i1}O konuda sana katılıyorum!{\i0}
Dialogue: 0,0:20:51.76,0:20:54.36,Main,Franky,0,0,0,,{\i1}Luffy, ben...{\i0}
Dialogue: 0,0:20:55.48,0:20:58.14,Main,Franky,0,0,0,,{\i1}Trao'nun planına uyamam!{\i0}
Dialogue: 0,0:20:59.41,0:21:01.51,Main,Usopp,0,0,0,,{\i1}Franky, ne diyorsun sen yahu?!{\i0}
Dialogue: 0,0:21:01.51,0:21:04.68,Main,Franky,0,0,0,,Trao'nun planına göre...
Dialogue: 0,0:21:04.68,0:21:12.13,Main,Franky,0,0,0,,...GÜLÜCÜK fabrikasını yok ettikten sonra\NDoflamingo'yu sonrası için Kaido'ya bırakacaktık.
Dialogue: 0,0:21:12.13,0:21:14.72,Main,Franky,0,0,0,,Ama durum böyle olunca...
Dialogue: 0,0:21:14.72,0:21:18.22,Main,Franky,0,0,0,,...bugün Doflamingo'yu alaşağı etmek isteyen\Nbu insanlara ne olacak?!
Dialogue: 0,0:21:19.04,0:21:21.22,Main,Franky,0,0,0,,Bu Küçük İnsanlar'ı\Nbundan alıkoyamayız.
Dialogue: 0,0:21:21.22,0:21:23.98,Main,Franky,0,0,0,,Dışarıdan her ne kadar\Nhoş görünse de...
Dialogue: 0,0:21:23.98,0:21:26.60,Main,Franky,0,0,0,,...meğer bu ülkenin\Nçok karanlık bir yanı da varmış.
Dialogue: 0,0:21:27.18,0:21:34.37,Main,Franky,0,0,0,,Onlar şimdi bu karanlığı defedebilmek için\Nhayatları pahasına bir savaşa hazırlanıyor!
Dialogue: 0,0:21:35.71,0:21:38.94,Main,Franky,0,0,0,,Küçükler fakat hepsi de\Naslan gibi yüreğe sahip!
Dialogue: 0,0:21:40.00,0:21:45.68,Main,Franky,0,0,0,,Bu cesur küçük ordu, iğrenç ve devasa bir düşmanın karşısına dikilecek!
Dialogue: 0,0:21:45.68,0:21:49.52,Main,Franky,0,0,0,,Onları bu hususta...
Dialogue: 0,0:21:49.52,0:21:50.78,Main,Franky,0,0,0,,{\i1}...kaderlerine terk edemem!{\i0}
Dialogue: 0,0:21:53.56,0:21:59.13,Main,Franky,0,0,0,,Söylediğim bunca şeyden sonra hâlâ\NDoflamingo'nun bu savaşı kazanmasını mı istiyorsun?!
Dialogue: 0,0:22:01.69,0:22:06.12,Main,Franky,0,0,0,,Luffy. Ne dersen de...
Dialogue: 0,0:22:07.74,0:22:09.54,Main,Franky,0,0,0,,Onlarla birlikte savaşacağım!
Dialogue: 0,0:22:10.14,0:22:11.21,Main,Usopp,0,0,0,,Franky...
Dialogue: 0,0:22:13.15,0:22:16.18,Flashbacks,Rebecca,0,0,0,,Asker-san ölecek.
Dialogue: 0,0:22:17.96,0:22:19.48,Main,Luffy,0,0,0,,{\i1}Franky.{\i0}
Dialogue: 0,0:22:19.75,0:22:21.47,Main,Luffy,0,0,0,,Gönlünce dağıt ortalığı!
Dialogue: 0,0:22:22.75,0:22:24.91,Main,Luffy,0,0,0,,Biz de en kısa sürede sana katılacağız!
Dialogue: 0,0:22:27.79,0:22:29.49,Main,Franky,0,0,0,,Teşekkürler!
Dialogue: 0,0:22:29.76,0:22:32.70,Main,Sanji,0,0,0,,Pekâlâ öyleyse.\NDönelim biz de!
Dialogue: 0,0:22:32.70,0:22:34.20,Main,Chopper & Brook,0,0,0,,Nee?!
Dialogue: 0,0:22:34.20,0:22:35.83,Main,Nami,0,0,0,,Tahmin etmiştim!
Dialogue: 0,0:22:38.13,0:22:41.77,Captions,,0,0,220,,{\fad(300,0)}Dressrosa Kıyısı
Dialogue: 0,0:22:38.72,0:22:39.78,Main,Marine,0,0,4,,Bu da neydi?!
Dialogue: 0,0:22:39.78,0:22:41.77,Main,Marine,0,0,4,,Ne oluyor?!
Dialogue: 0,0:22:42.45,0:22:46.33,Main,Marine,0,0,0,,Issho-san, şehirde kavga var!
Dialogue: 0,0:22:46.33,0:22:47.68,Main,Fujitora,0,0,0,,Acele edelim!
Dialogue: 0,0:22:49.41,0:22:52.37,Main,Usopp,0,0,0,,{\i1}Ne oldu?\NOradan ses geldi sanki?!{\i0}
Dialogue: 0,0:22:56.09,0:22:58.39,Main,Kin'emon,0,0,0,,Ne oluyor böyle?! Şehir...
Dialogue: 0,0:22:58.39,0:22:59.69,Main,Zoro,0,0,0,,Buraya yaklaşıyor!
Dialogue: 0,0:23:01.02,0:23:03.59,Main,Luffy,0,0,0,,Bu da neydi?\NHiçbir şey göremiyorum!
Dialogue: 0,0:23:04.02,0:23:04.86,Main,Citizen,0,0,0,,Bu da nesi?!
Dialogue: 0,0:23:04.86,0:23:06.60,Main,Marine,0,0,0,,Koramiral Bastille!\NYoksa bu...
Dialogue: 0,0:23:12.67,0:23:14.27,Main,Luffy,0,0,0,,Doflamingo!
Dialogue: 0,0:23:15.07,0:23:16.05,Main,Luffy,0,0,0,,Trao!
Dialogue: 0,0:23:19.05,0:23:20.18,Main,Doflamingo,0,0,0,,Aptal velet!
Dialogue: 0,0:23:22.45,0:23:25.78,Main,Luffy,0,0,0,,Trao, neden Doflamingo'nun-
Dialogue: 0,0:23:31.40,0:23:33.69,Main,Doflamingo,0,0,0,,Şansını fazla zorladın!
Dialogue: 0,0:23:48.34,0:23:51.73,Thoughts,Law,0,0,0,,{\i1}Cora-san...{\i0}
Dialogue: 0,0:23:51.73,0:23:54.71,Main,Luffy,0,0,0,,{\i1}Trao!{\i0}
