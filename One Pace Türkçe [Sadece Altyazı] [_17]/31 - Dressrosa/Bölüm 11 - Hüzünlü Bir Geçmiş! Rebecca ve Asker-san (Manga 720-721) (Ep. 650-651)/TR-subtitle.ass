Dialogue: 0,0:02:30.03,0:02:38.62,Title,,0,0,0,,{\fad(2000,2000)}Hüzünlü Bir Geçmiş!\NRebecca ve Asker-san
Dialogue: 0,0:02:42.81,0:02:45.95,Main,Announcer,0,0,0,,Corrida Kolezyumundaki\Nserbest dövüş müsabakasında...
Dialogue: 0,0:02:45.95,0:02:51.93,Main,Announcer,0,0,0,,...üç yarışmacı Don Quixote Ailesi'ne\Nmeydan okumaya hak kazandı bile!
Dialogue: 0,0:02:54.80,0:03:01.41,Main,Announcer,0,0,0,,A Bloğu kazananı Karasakal Korsanları'ndan şampiyon Jesus Burges oldu!
Dialogue: 0,0:03:05.86,0:03:13.71,Main,Announcer,0,0,0,,B Bloğu'ndansa Barto Kulübü korsan grubu kaptanı, Yamyam Bartolomeo galip çıktı!
Dialogue: 0,0:03:17.43,0:03:20.01,Main,Announcer,0,0,0,,Ve C Bloğu'ndaysa...
Dialogue: 0,0:03:20.01,0:03:24.32,Main,Announcer,0,0,0,,...herkesin favorisi Lucy birinci oldu!
Dialogue: 0,0:03:28.07,0:03:31.66,Main,Announcer,0,0,0,,Şampiyonluk müsabakaları için\Ngeriye yalnızca bir savaşçı kaldı!
Dialogue: 0,0:03:32.30,0:03:35.01,Main,Announcer,0,0,0,,Fakat arenada meydana gelen\Nağır hasar yüzünden...
Dialogue: 0,0:03:35.01,0:03:39.45,Main,Announcer,0,0,0,,...D Bloğu savaşı 15 dakika geç başlayacak.
Dialogue: 0,0:03:39.45,0:03:41.60,Main,Audience,0,0,0,,Yedek arenanız yok mu sizin?!
Dialogue: 0,0:03:41.60,0:03:42.91,Main,Audience,0,0,0,,Onarın şunu hadi!
Dialogue: 0,0:03:42.91,0:03:47.47,Main,Announcer,0,0,0,,D Bloğu savaşı başlayana kadar\Nbiraz sabredin.
Dialogue: 0,0:03:51.24,0:03:53.06,Main,Cavendish,0,0,0,,Hasır Şapka!
Dialogue: 0,0:03:53.98,0:03:55.91,Main,Cavendish,0,0,0,,Bu sefer kaçamayacaksın!
Dialogue: 0,0:03:57.94,0:03:58.82,Main,Luffy,0,0,0,,Kabak!
Dialogue: 0,0:03:59.81,0:04:00.78,Main,Cavendish,0,0,0,,{\fad(150,150)}Durandal!
Dialogue: 0,0:04:05.69,0:04:08.26,Main,Guy,0,0,0,,Cavendish gene kavga çıkartmaya çalışıyor!
Dialogue: 0,0:04:10.10,0:04:11.86,Main,Bartolomeo,0,0,0,,Adi herif!
Dialogue: 0,0:04:11.86,0:04:13.07,Main,Warrior,0,0,0,,Neler oluyor?
Dialogue: 0,0:04:13.07,0:04:15.03,Main,Warrior,0,0,0,,Gene Hasır Şapka diye bağırıyor!
Dialogue: 0,0:04:15.03,0:04:18.10,Main,Warrior,0,0,0,,Hasır Şapka şu şey değil mi...
Dialogue: 0,0:04:18.10,0:04:21.97,Main,Warrior,0,0,0,,...hani En İyilerin Savaşı'nda ağabeyinin hayatını kurtaramayan velet?
Dialogue: 0,0:04:23.70,0:04:28.15,Main,Warrior,0,0,0,,Öyle olduktan sonra\Nonun yaptığını yapmaya ne gerek var ki?
Dialogue: 0,0:04:31.84,0:04:35.20,Main,Warrior,0,0,0,,Ne yapıyorsun be, kes şunu!
Dialogue: 0,0:04:35.20,0:04:38.77,Main,Warrior,0,0,0,,Doerena Krallığı'nın asillerindenim ben!
Dialogue: 0,0:04:40.40,0:04:41.49,Main,Warrior,0,0,0,,Dur!
Dialogue: 0,0:04:41.49,0:04:44.90,Main,Warrior,0,0,0,,Eziliyorum!
Dialogue: 0,0:04:44.90,0:04:48.67,Main,Bartolomeo,0,0,0,,Öyle gamsız gamsız\Nneye gülüyordun sen bakayım?
Dialogue: 0,0:04:53.91,0:05:00.51,Main,Bartolomeo,0,0,0,,Bana bak! Hasır Şapkalı Luffy-senpai \Ner ya da geç bu çağın lideri olacak kişi...
Dialogue: 0,0:05:00.51,0:05:03.25,Main,Bartolomeo,0,0,0,,...geleceğin Korsanlar Kralı'dır!
Dialogue: 0,0:05:06.30,0:05:08.25,Main,Bartolomeo,0,0,0,,Olanları kendi gözlerimle gördüm.
Dialogue: 0,0:05:09.61,0:05:12.24,Main,Bartolomeo,0,0,0,,İki yıl değil, çok daha öncesinde\Ngerçekleşmiş bir şey...
Dialogue: 0,0:05:13.70,0:05:17.10,Main,Bartolomeo,0,0,0,,East Blue'nun Loguetown şehrinde...
Dialogue: 0,0:05:17.10,0:05:21.92,Main,Bartolomeo,0,0,0,,...Korsanlar Kralı Roger'ın öldüğü\No efsanevi platformda...
Dialogue: 0,0:05:21.92,0:05:25.12,Main,Bartolomeo,0,0,0,,...hiçbir çıkar yolu olmayan\Nbir durumdayken şöyle bağırdı!
Dialogue: 0,0:05:25.12,0:05:29.24,Flashbacks,Luffy,0,0,0,,Korsanlar Kralı olacağım!
Dialogue: 0,0:05:32.64,0:05:35.30,Main,Bartolomeo,0,0,0,,Ve o anda cennetten...
Dialogue: 0,0:05:38.22,0:05:42.97,Main,Bartolomeo,0,0,0,,...hayatını kurtaran\No yıldırım iniverdi!
Dialogue: 0,0:05:44.24,0:05:47.19,Main,Bartolomeo,0,0,0,,Gördüğüm şeyin mucizeden başka\Nbir açıklaması yok.
Dialogue: 0,0:05:50.98,0:05:55.94,Main,Bartolomeo,0,0,0,,O günden sonra da hep Hasır Şapka\Ntayfasının maceralarını takip ettim.
Dialogue: 0,0:05:55.94,0:06:00.79,Main,Bartolomeo,0,0,0,,Alabasta, Enies Lobby, Impel Down...
Dialogue: 0,0:06:01.14,0:06:05.73,Main,Bartolomeo,0,0,0,,Ve can alıcı Marineford!
Dialogue: 0,0:06:05.73,0:06:07.65,Main,Bartolomeo,0,0,0,,Gerçekten de büyüleyiciydi!
Dialogue: 0,0:06:14.00,0:06:17.52,Flashbacks,Dude,0,0,0,,Patron, yendiğimiz düşman askerleri\Nne yapalım?
Dialogue: 0,0:06:17.52,0:06:19.52,Flashbacks,Bartolomeo,0,0,0,,Denize falan atın ne bileyim!
Dialogue: 0,0:06:20.11,0:06:26.75,Main,Bartolomeo,0,0,0,,O zamanlar 150 kasabayı kontrolü altına almış bir mafya grubunun lideriydim...
Dialogue: 0,0:06:26.75,0:06:29.07,Main,Bartolomeo,0,0,0,,...fakat Luffy-senpai'den feyz alıp...
Dialogue: 0,0:06:30.97,0:06:33.51,Main,Bartolomeo,0,0,0,,...denizlere açıldım!
Dialogue: 0,0:06:35.37,0:06:38.46,Main,Bartolomeo,0,0,0,,Şimdi kendi bir halt beceremeyip de...
Dialogue: 0,0:06:38.46,0:06:45.32,Main,Bartolomeo,0,0,0,,...Luffy-senpai'yi küçümsemekten geri kalmayan senden o dediklerini bir daha duyalım bakalım!
Dialogue: 0,0:06:45.32,0:06:50.00,Main,Bartolomeo,0,0,0,,Bir şey yapabileceğini mi sanıyorsun?!\NSeni işe yaramaz pislik!
Dialogue: 0,0:06:51.32,0:06:53.54,Main,Warrior,0,0,0,,Bartolomeo gene delirdi!
Dialogue: 0,0:07:02.02,0:07:04.37,Main,Cavendish,0,0,0,,Bırak!
Dialogue: 0,0:07:04.82,0:07:07.74,Main,Luffy,0,0,0,,Neden savaşıyoruz ki şimdi zaten!?
Dialogue: 0,0:07:07.74,0:07:09.46,Main,Luffy,0,0,0,,Yorgunum be!
Dialogue: 0,0:07:11.92,0:07:13.14,Main,Warrior,0,0,0,,Birileri durdursun şunları!
Dialogue: 0,0:07:13.14,0:07:16.03,Main,Warrior,0,0,0,,Yanlarına yaklaşamıyoruz ki, çok tehlikeli!
Dialogue: 0,0:07:17.10,0:07:19.46,Thoughts,Bartolomeo,0,0,0,,{\i1}Gerçekten de yanına yaklaşamıyorum.{\i0}
Dialogue: 0,0:07:19.46,0:07:21.41,Thoughts,Bartolomeo,0,0,0,,{\i1}Şu ana kadar hiçbir\Nfırsatı değerlendiremedim!{\i0}
Dialogue: 0,0:07:21.41,0:07:24.29,Thoughts,Bartolomeo,0,0,0,,{\i1}Heyecandan yanına yaklaşamıyorum ki!{\i0}
Dialogue: 0,0:07:24.29,0:07:27.92,Thoughts,Bartolomeo,0,0,0,,{\i1}Sol gözünün altındaki yara gerçekmiş!{\i0}
Dialogue: 0,0:07:27.92,0:07:30.23,Thoughts,Bartolomeo,0,0,0,,{\i1}Acayip havalı biri!{\i0}
Dialogue: 0,0:07:30.23,0:07:33.43,Thoughts,Bartolomeo,0,0,0,,{\i1}Amanın gözlerimin yaşından\Nher yer bulandı.{\i0}
Dialogue: 0,0:07:34.03,0:07:39.67,Thoughts,Bartolomeo,0,0,0,,{\i1}Canı çıkası kabak posası! \NCanına okuyup Luffy-senpai'yi kurtarmak istiyorum!{\i0}
Dialogue: 0,0:07:40.93,0:07:43.87,Main,Bartolomeo,0,0,0,,Lan Cavie... Caf...
Dialogue: 0,0:07:43.87,0:07:45.78,Thoughts,Bartolomeo,0,0,0,,{\i1}Nutkum tutuldu resmen!{\i0}
Dialogue: 0,0:07:48.05,0:07:50.03,Main,Sai,0,0,0,,Hasır Şapka!
Dialogue: 0,0:07:53.22,0:07:57.94,Main,Sai,0,0,0,,Şuraya bak az, bizim ihtiyar\Nsana bir şey söylemek istiyor!
Dialogue: 0,0:07:59.32,0:08:01.06,Main,Boo,0,0,0,,Dede, dayan!
Dialogue: 0,0:08:01.06,0:08:04.70,Main,Luffy,0,0,0,,Ne?! Düşün yakamdan bir ya,\Nkazandım bitti işte!
Dialogue: 0,0:08:07.54,0:08:09.78,Main,Chinjao,0,0,0,,Hayır!
Dialogue: 0,0:08:17.58,0:08:20.28,Thoughts,Chinjao,0,0,0,,{\i1}Artık Garp'a karşı kin tutmuyorum.{\i0}
Dialogue: 0,0:08:20.84,0:08:24.48,Thoughts,Chinjao,0,0,0,,{\i1}Minnettarlığımı göstermek istiyorum yalnızca.{\i0}
Dialogue: 0,0:08:25.67,0:08:28.87,Main,Chinjao,0,0,0,,Teşekkür etmeme izin ver...
Dialogue: 0,0:08:30.73,0:08:33.09,Main,Chinjao,0,0,0,,Bekle, Garp'ın torunu!
Dialogue: 0,0:08:33.09,0:08:34.63,Main,Cavendish,0,0,0,,Dur, Hasır Şapka!
Dialogue: 0,0:08:37.56,0:08:39.25,Main,Bartolomeo,0,0,0,,Yanımdan geçti lan!
Dialogue: 0,0:08:39.25,0:08:41.38,Main,Bartolomeo,0,0,0,,Şey, pardon...\NBekleyin!
Dialogue: 0,0:08:41.38,0:08:43.47,Main,Cavendish,0,0,0,,Kaçıyor musun?!
Dialogue: 0,0:08:45.30,0:08:47.71,Main,Bartolomeo,0,0,0,,Ay ne yapsam acaba şimdi?!
Dialogue: 0,0:08:47.71,0:08:51.43,Main,Bartolomeo,0,0,0,,Onunla konuşmak istiyorum\Nama nasıl cesaret ederim ki buna?!
Dialogue: 0,0:08:51.43,0:08:53.14,Main,Bartolomeo,0,0,0,,Bekle lütfen!
Dialogue: 0,0:08:53.56,0:08:56.66,Thoughts,Chinjao,0,0,0,,{\i1}Kafamı onarmana teşekkür minvalinde...{\i0}
Dialogue: 0,0:08:56.66,0:09:00.65,Thoughts,Chinjao,0,0,0,,{\i1}...torunumun Happo Donanması'nı\Nemrine vermek istiyorum!{\i0}
Dialogue: 0,0:09:02.02,0:09:04.02,Main,Chinjao,0,0,0,,Bekle!
Dialogue: 0,0:09:04.02,0:09:07.09,Main,Luffy,0,0,0,,Nesi var bunların ya?!\NAmma inatçı çıktılar!
Dialogue: 0,0:09:07.09,0:09:08.74,Main,Chinjao,0,0,0,,Bekle!
Dialogue: 0,0:09:07.96,0:09:11.03,Secondary,Cavendish,0,0,0,,Yakalayın!
Dialogue: 0,0:09:08.74,0:09:11.03,Main,Bartolomeo,0,0,0,,Lütfen bekleyin!
Dialogue: 0,0:09:15.08,0:09:18.31,Main,Luffy,0,0,0,,Cidden ya! Şöyle iki rahat nefes\Nalacak bir yer yok resmen.
Dialogue: 0,0:09:19.07,0:09:20.74,Main,Rebecca,0,0,0,,Bu taraftan, Lucy!
Dialogue: 0,0:09:21.98,0:09:24.44,Main,Luffy,0,0,0,,Sen... Şeydi...
Dialogue: 0,0:09:24.44,0:09:27.24,Main,Rebecca,0,0,0,,Rebecca. \NEpey düşmanın var gibi.
Dialogue: 0,0:09:27.24,0:09:28.01,Main,Rebecca,0,0,0,,Gel benimle!
Dialogue: 0,0:09:28.40,0:09:29.91,Main,Luffy,0,0,0,,Teşekkür ederim!
Dialogue: 0,0:09:33.20,0:09:36.15,Main,Blackbeard,0,0,0,,{\i1}Öyle düşünürsen\NShiryu'nun da bir farkı yok!{\i0}
Dialogue: 0,0:09:38.25,0:09:42.83,Main,Burgess,0,0,0,,Ben Aokiji'ye güvenemem!
Dialogue: 0,0:09:46.38,0:09:49.60,Main,Burgess,0,0,0,,Bekle biraz Kaptan.
Dialogue: 0,0:09:50.42,0:09:52.38,Main,Burgess,0,0,0,,Hasır Şapka burada.
Dialogue: 0,0:09:57.34,0:09:59.71,Main,Blackbeard,0,0,0,,{\i1}Orada mısın...{\i0}
Dialogue: 0,0:10:00.49,0:10:02.51,Main,Blackbeard,0,0,0,,{\i1}...Hasır Şapka?{\i0}
Dialogue: 0,0:10:07.01,0:10:08.37,Flashbacks,Luffy,0,0,0,,Karasakal...
Dialogue: 0,0:10:10.50,0:10:13.01,Flashbacks,Blackbeard,0,0,0,,Görüşmeyeli epey olmuştu, Hasır Şapka!
Dialogue: 0,0:10:13.68,0:10:19.63,Flashbacks,Blackbeard,0,0,0,,Komutanım Ace'in kardeşi olduğunu duyduğumda epey şaşırdım!
Dialogue: 0,0:10:20.25,0:10:23.92,Flashbacks,Blackbeard,0,0,0,,Ağabeyinin idamı başlamak üzere...
Dialogue: 0,0:10:23.92,0:10:27.18,Flashbacks,Blackbeard,0,0,0,,...ne yapıyorsun hâlâ burada?
Dialogue: 0,0:10:32.48,0:10:34.38,Main,Luffy,0,0,0,,Sensin demek?
Dialogue: 0,0:10:34.38,0:10:38.58,Main,Blackbeard,0,0,0,,{\i1}Aynen öyle!\NGörüşmeyeli epey oldu!{\i0}
Dialogue: 0,0:10:40.45,0:10:44.54,Main,Blackbeard,0,0,0,,{\i1}Yarışmaya katılmışsın diye duydum, Lucy!{\i0}
Dialogue: 0,0:10:45.37,0:10:50.19,Main,Blackbeard,0,0,0,,{\i1}Fakat Mera Mera Meyvesi\Nadamım Burgess'in olacak!{\i0}
Dialogue: 0,0:10:52.10,0:10:57.54,Main,Blackbeard,0,0,0,,{\i1}Çok mutluyum, Ace'i tayfama\Nkatmış kadar olacağım bu sayede!{\i0}
Dialogue: 0,0:10:57.54,0:11:01.68,Main,Blackbeard,0,0,0,,{\i1}Zamanında teklifimi geri çevirmişti!{\i0}
Dialogue: 0,0:11:06.34,0:11:11.42,Main,Luffy,0,0,0,,Ace'in gücünü sizin almanıza\Nasla izin veremem!
Dialogue: 0,0:11:21.26,0:11:23.90,Main,Burgess,0,0,0,,Seninle savaşmayı\Ndört gözle bekliyorum!
Dialogue: 0,0:11:30.90,0:11:33.48,Main,Rebecca,0,0,0,,O korsanı tanıyor musun?
Dialogue: 0,0:11:33.48,0:11:34.74,Main,Luffy,0,0,0,,Sayılır.
Dialogue: 0,0:11:34.74,0:11:37.34,Main,Luffy,0,0,0,,Onun kazanmasına izin veremem!
Dialogue: 0,0:11:39.11,0:11:41.65,Main,Luffy,0,0,0,,Teyze, tadımlık yok mu başka?
Dialogue: 0,0:11:41.65,0:11:44.81,Main,Woman,0,0,0,,Bir şey alacağın yok,\Ntadımlıklarla karnını doyuruyorsun!
Dialogue: 0,0:11:44.81,0:11:46.49,Main,Rebecca,0,0,0,,Dur biraz!
Dialogue: 0,0:11:48.03,0:11:50.20,Main,Rebecca,0,0,0,,Özür dilerim teyze!
Dialogue: 0,0:11:50.20,0:11:51.96,Main,Rebecca,0,0,0,,Hangini istiyorsun Lucy?
Dialogue: 0,0:11:52.77,0:11:54.92,Main,Luffy,0,0,0,,Sen mi ısmarlıyorsun?!
Dialogue: 0,0:11:54.92,0:11:58.08,Main,Woman,0,0,0,,Arkadaşın mı yoksa Rebecca?
Dialogue: 0,0:11:59.28,0:12:02.27,Main,Woman,0,0,0,,Teşekkür ettim!
Dialogue: 0,0:12:02.97,0:12:06.75,Main,Rebecca,0,0,0,,Kusura bakma, çok param yoktu.
Dialogue: 0,0:12:08.29,0:12:11.67,Main,Luffy,0,0,0,,Hiç önemli değil, yemek ısmarladığın için\Nteşekkür ederim Rebecca!
Dialogue: 0,0:12:13.11,0:12:14.41,Main,Luffy,0,0,0,,Neredeyiz?
Dialogue: 0,0:12:14.86,0:12:19.38,Main,Rebecca,0,0,0,,Kolezyum gladyatörlerinin odasındayız.
Dialogue: 0,0:12:20.61,0:12:23.02,Main,Rebecca,0,0,0,,Hapishane diyenler de var buraya.
Dialogue: 0,0:12:30.50,0:12:35.57,Main,Rebecca,0,0,0,,Misafir yarışmacılar buraya gelmezler,\Ndövüşün başlayana dek burada bekleyebilirsin.
Dialogue: 0,0:12:37.81,0:12:39.78,Main,Luffy,0,0,0,,Hadi ya!\NÇok iyi oldu bak!
Dialogue: 0,0:12:42.88,0:12:49.81,Captions,,0,0,240,,{\fad(1700,0)}Rebecca\NCorrida Kolezyumuna Bağlı Bir Gladyatör
Dialogue: 0,0:12:45.03,0:12:47.22,Main,Rebecca,0,0,4,,Dövüş mükemmeldi!
Dialogue: 0,0:12:47.22,0:12:49.81,Main,Rebecca,0,0,4,,O kadar güçlü olmana çok şaşırdım!
Dialogue: 0,0:12:54.06,0:12:55.39,Main,Rebecca,0,0,0,,Güzel mi?
Dialogue: 0,0:12:55.39,0:12:58.42,Main,Luffy,0,0,0,,Evet, kolezyum bentousu mükemmelmiş!
Dialogue: 0,0:13:00.18,0:13:02.08,Main,Luffy,0,0,0,,Sen aç değil misin?
Dialogue: 0,0:13:03.89,0:13:07.32,Flashbacks,Rebecca,0,0,0,,{\fad(0,1200)}Anne, acıktım.
Dialogue: 0,0:13:08.07,0:13:12.44,Main,Rebecca,0,0,0,,Acıkmam ben.
Dialogue: 0,0:13:13.34,0:13:16.62,Main,Luffy,0,0,0,,Hadi ya?\NSamuray falan gibisin yani?
Dialogue: 0,0:13:18.97,0:13:23.12,Main,Prisoner,0,0,0,,Yakaladım! \NRebecca, yapacaksan yap!
Dialogue: 0,0:13:23.12,0:13:24.05,Main,Luffy,0,0,0,,Ne oluyor?!
Dialogue: 0,0:13:24.05,0:13:26.09,Main,Prisoner,0,0,0,,Onu buraya bunun için getirmedin mi?!
Dialogue: 0,0:13:26.61,0:13:28.72,Main,Luffy,0,0,0,,Ne oluyor Rebecca?
Dialogue: 0,0:13:32.31,0:13:33.51,Main,Prisoner,0,0,0,,Acele et!
Dialogue: 0,0:13:36.69,0:13:39.88,Main,Luffy,0,0,0,,Yemeği döktüreceksiniz bana!
Dialogue: 0,0:13:39.88,0:13:40.86,Main,Prisoner,0,0,0,,Yap hadi!
Dialogue: 0,0:13:40.86,0:13:42.12,Main,Prisoner,0,0,0,,Ne bekliyorsun!
Dialogue: 0,0:13:42.12,0:13:45.57,Main,Prisoner,0,0,0,,Bunu yapmazsan amacına nasıl ulaşacaksın?!
Dialogue: 0,0:13:45.57,0:13:46.45,Main,Luffy,0,0,0,,Amaç mı?
Dialogue: 0,0:14:26.40,0:14:29.07,Main,Prisoner,0,0,0,,Rebecca yakalandı!
Dialogue: 0,0:14:29.07,0:14:31.08,Main,Prisoner,0,0,0,,Hız konusunda yenileceği\Naklımın ucundan geçmezdi!
Dialogue: 0,0:14:31.54,0:14:33.24,Main,Rebecca,0,0,0,,İstediğini yapmakta özgürsün.
Dialogue: 0,0:14:37.20,0:14:39.06,Main,Rebecca,0,0,0,,Bedelini ödemeye razıyım.
Dialogue: 0,0:14:39.74,0:14:43.23,Main,Luffy,0,0,0,,Bana yemek almış birine\Nbir şey yapacak değilim.
Dialogue: 0,0:14:43.52,0:14:45.50,Main,Rebecca,0,0,0,,Seni öldürmeye çalıştım!
Dialogue: 0,0:14:45.50,0:14:47.75,Main,Luffy,0,0,0,,Önemi yok, ölmedim sonuçta.
Dialogue: 0,0:14:48.39,0:14:51.60,Main,Luffy,0,0,0,,Ayrıca beni öldürmeyecektin.
Dialogue: 0,0:14:53.48,0:14:56.42,Main,Prisoner,0,0,0,,Böyle kolayca affedilmek...
Dialogue: 0,0:14:56.42,0:15:00.61,Main,Prisoner,0,0,0,,...gerçekten de ona karşı\Nhiçbir şansının olmadığını kanıtlıyor.
Dialogue: 0,0:15:01.18,0:15:07.49,Main,Prisoner,0,0,0,,Bir güç kullanıcısını yenebilseydik burada,\Nbiraz olsun umutlanacaktık.
Dialogue: 0,0:15:08.44,0:15:09.22,Main,Luffy,0,0,0,,Mumya?!
Dialogue: 0,0:15:09.22,0:15:10.17,Main,Prisoner,0,0,0,,Hayır be!
Dialogue: 0,0:15:11.48,0:15:15.04,Main,Prisoner,0,0,0,,Mahkum gladyatörleriz bizler!
Dialogue: 0,0:15:15.04,0:15:16.63,Main,Prisoner,0,0,0,,Rebecca da öyle.
Dialogue: 0,0:15:17.26,0:15:22.35,Main,Prisoner,0,0,0,,Sonsuza dek savaşacak ve günün birinde gösterinin bir parçası olarak arenada öldürüleceğiz!
Dialogue: 0,0:15:23.18,0:15:26.75,Main,Prisoner,0,0,0,,Tüm bunlar Doflamingo Ailesi'ne\Nbiraz olsun baş kaldırdığımız için oluyor.
Dialogue: 0,0:15:29.11,0:15:34.13,Main,Prisoner,0,0,0,,Bin maç kazanabilirsek\Nkral serbest kalacağımızı söylüyor.
Dialogue: 0,0:15:34.13,0:15:38.80,Main,Prisoner,0,0,0,,Fakat ne kadar güçlü de olsan ölümüne savaşacağın 100 dövüş sonunu getirir.
Dialogue: 0,0:15:38.80,0:15:43.02,Main,Prisoner,0,0,0,,Buradan kaçmaya çalışan herkes vuruldu.
Dialogue: 0,0:15:45.49,0:15:48.54,Main,Prisoner,0,0,0,,Kaçacak bir yerimiz yok.
Dialogue: 0,0:15:48.54,0:15:56.22,Main,Prisoner,0,0,0,,On yıl önce, Doflamingo kral olana dek\Ngladyatör dövüşleri ölümüne yapılmıyordu.
Dialogue: 0,0:15:57.50,0:16:03.41,Main,Prisoner,0,0,0,,Hükmettiği bu krallığın \Naydınlık ve karanlık olmak üzere iki yüzü var.
Dialogue: 0,0:16:10.38,0:16:11.35,Main,Rebecca,0,0,0,,Ben...
Dialogue: 0,0:16:12.74,0:16:17.93,Main,Rebecca,0,0,0,,...ne pahasına olursa olsun\Nbugünkü yarışmayı kazanıp...
Dialogue: 0,0:16:19.46,0:16:23.89,Main,Rebecca,0,0,0,,...Mera Mera Meyvesinin gücüyle\NDoflamingo'yu yeneceğim!
Dialogue: 0,0:16:28.90,0:16:35.14,Main,Rebecca,0,0,0,,Bugün Asker-san'ın yönettiği ordu\Nburadan kurtulabilmemiz için...
Dialogue: 0,0:16:38.90,0:16:41.96,Main,Rebecca,0,0,0,,...Doflamingo'ya meydan okumayı planlıyor.
Dialogue: 0,0:16:44.12,0:16:47.03,Main,Rebecca,0,0,0,,Bu krallığı yok edebilmek için...
Dialogue: 0,0:16:47.03,0:16:49.14,Main,Rebecca,0,0,0,,...kendi hayatını feda etmeyi planlıyor!
Dialogue: 0,0:16:50.22,0:16:51.36,Flashbacks,Thunder Soldier,0,0,0,,Hiç korkma!
Dialogue: 0,0:16:54.26,0:16:59.50,Flashbacks,Thunder Soldier,0,0,0,,Bu cesur asker hep yanında olacak!
Dialogue: 0,0:17:06.50,0:17:09.07,Main,Rebecca,0,0,0,,Bunu ondan önce\Nbenim yapmam lazım!
Dialogue: 0,0:17:12.69,0:17:15.84,Main,Rebecca,0,0,0,,Artık birilerinin beni korumasını istemiyorum!
Dialogue: 0,0:17:21.36,0:17:26.10,Main,Rebecca,0,0,0,,Bu sefer ben Asker-san'ı koruyacağım!
Dialogue: 0,0:17:32.50,0:17:35.73,Main,Rebecca,0,0,0,,Asker-san ölecek.
Dialogue: 0,0:17:35.73,0:17:37.50,Main,Luffy,0,0,0,,Asker derken?
Dialogue: 0,0:17:37.92,0:17:41.08,Main,Rebecca,0,0,0,,Tek bacaklı oyuncak bir asker.
Dialogue: 0,0:17:41.08,0:17:41.97,Main,Luffy,0,0,0,,Oyuncak mı?
Dialogue: 0,0:17:41.97,0:17:44.54,Flashbacks,Soldier,0,0,0,,Amanın, ihtiyar insanlar!
Dialogue: 0,0:17:44.54,0:17:47.94,Main,Luffy,0,0,0,,Kolezyumun önünde\Nöyle biriyle karşılaşmıştım.
Dialogue: 0,0:17:47.94,0:17:50.18,Main,Rebecca,0,0,0,,Evet, kesin odur.
Dialogue: 0,0:17:50.74,0:17:53.66,Main,Gladiator,0,0,0,,Kolezyumdan çıkmamıza izin yok.
Dialogue: 0,0:17:53.66,0:17:57.12,Main,Gladiator,0,0,0,,Dışarıda olanlara\Nhiçbir şekilde müdahale edemeyiz.
Dialogue: 0,0:17:57.12,0:18:00.42,Main,Luffy,0,0,0,,Oyuncak ölecek diye mi\Nbu kadar endişelisin?
Dialogue: 0,0:18:00.42,0:18:03.21,Main,Luffy,0,0,0,,Yaşayan oyuncak düşüncesi bile\Ntuhaf geliyor bana.
Dialogue: 0,0:18:04.98,0:18:08.47,Main,Rebecca,0,0,0,,Buralardan olmadığın için\Nanlamaman normal.
Dialogue: 0,0:18:10.22,0:18:12.57,Main,Rebecca,0,0,0,,Onların da insanlardan bir farkı yok.
Dialogue: 0,0:18:13.04,0:18:15.44,Main,Rebecca,0,0,0,,Dostu olmayana dost...
Dialogue: 0,0:18:16.14,0:18:18.08,Main,Rebecca,0,0,0,,...kardeşi olmayana kardeş...
Dialogue: 0,0:18:19.08,0:18:21.49,Main,Rebecca,0,0,0,,...bir sevdiceği olmayana da\Nsevdicek olurlar.
Dialogue: 0,0:18:22.11,0:18:25.36,Main,Rebecca,0,0,0,,Bizimle birlikte yaşamalarına\Nneden izin verilmiyor anlayamıyorum.
Dialogue: 0,0:18:26.70,0:18:34.16,Main,Rebecca,0,0,0,,Biricik ailemi, anneciğimi kaybettiğimden beri beni Asker-san büyüttü.
Dialogue: 0,0:18:35.39,0:18:39.71,Main,Rebecca,0,0,0,,Babamdır diyebileceğim biri o.
Dialogue: 0,0:18:41.27,0:18:43.99,Main,Luffy,0,0,0,,Hadi ya?
Dialogue: 0,0:18:45.52,0:18:47.28,Main,Announcer,0,0,0,,Beklediğiniz için teşekkür ederiz!
Dialogue: 0,0:18:47.28,0:18:48.94,Main,Announcer,0,0,0,,Arenanın onarımı tamamlandı!
Dialogue: 0,0:18:49.46,0:18:52.03,Main,Gladiator,0,0,0,,Rebecca, oyun başlamak üzere.
Dialogue: 0,0:18:53.41,0:18:56.18,Main,Rebecca,0,0,0,,Ne yapıyorsun, Lucy?
Dialogue: 0,0:18:56.18,0:18:59.79,Main,Luffy,0,0,0,,Deminki patırtıda\Nyemek kutularından ikisi yere düşmüştü.
Dialogue: 0,0:19:00.43,0:19:03.47,Main,Luffy,0,0,0,,Kusura bakma,\Nbunlar için tüm paranı harcamıştın.
Dialogue: 0,0:19:04.11,0:19:06.57,Main,Luffy,0,0,0,,Lezzetlerinden\Nbir şey kaybetmemişler yalnız!
Dialogue: 0,0:19:09.36,0:19:12.56,Main,Luffy,0,0,0,,Bana mahkum gibi görünmüyorsun.
Dialogue: 0,0:19:15.47,0:19:17.61,Main,Rebecca,0,0,0,,Finalde görüşürüz.
Dialogue: 0,0:19:20.02,0:19:21.96,Main,Staff,0,0,0,,Oyun başlamak üzere,...
Dialogue: 0,0:19:21.96,0:19:24.38,Main,Staff,0,0,0,,...D Blok yarışmacıları arenaya çıkın!
Dialogue: 0,0:19:25.08,0:19:27.11,Flashbacks,Rebecca,0,0,0,,{\i1}Anne!{\i0}
Dialogue: 0,0:19:27.50,0:19:30.30,Main,Rebecca,0,0,0,,Anne, bak ne çok çiçek topladım!
Dialogue: 0,0:19:30.30,0:19:31.92,Main,Scarlett,0,0,0,,Ne de güzeller öyle Rebecca!
Dialogue: 0,0:19:31.92,0:19:33.84,Main,Rebecca,0,0,0,,Bir tane sana da vereyim mi?
Dialogue: 0,0:19:33.84,0:19:36.45,Main,Scarlett,0,0,0,,Teşekkür ederim.\NAlayım bakayım.
Dialogue: 0,0:19:36.45,0:19:38.76,Main,Scarlett,0,0,0,,Bu da annenden sana!
Dialogue: 0,0:19:39.56,0:19:40.95,Main,Scarlett,0,0,0,,Haydi, gidelim.
Dialogue: 0,0:19:40.95,0:19:42.03,Main,Rebecca,0,0,0,,Peki!
Dialogue: 0,0:20:01.79,0:20:04.30,Main,Citizen,0,0,0,,Kral Riku Ordusu köyü yakıyor!
Dialogue: 0,0:20:04.30,0:20:05.96,Main,Citizen,0,0,0,,Lütfen yapmayın!
Dialogue: 0,0:20:05.96,0:20:08.65,Main,Citizen,0,0,0,,Kral neden böyle bir şey yapıyor?!
Dialogue: 0,0:20:13.09,0:20:15.93,Main,Scarlett,0,0,0,,Saray ateşler içinde!
Dialogue: 0,0:20:17.73,0:20:21.60,Main,Scarlett,0,0,0,,Neler oluyor bu ülkede?
Dialogue: 0,0:20:24.80,0:20:26.90,Main,Guard,0,0,0,,Kaçın, Scarlet-sama!
Dialogue: 0,0:20:44.32,0:20:45.81,Main,Grunt,0,0,0,,Kimsin lan sen?!\NÇekil önümüzden!
Dialogue: 0,0:20:46.38,0:20:49.08,Main,Soldier,0,0,0,,Koş!\NKoşabildiğin kadar uzaklara koş!
Dialogue: 0,0:21:05.86,0:21:09.12,Main,Rebecca,0,0,0,,Anne, çok açım.
Dialogue: 0,0:21:09.12,0:21:12.48,Main,Scarlett,0,0,0,,Biliyorum. İki gündür \Nboğazımızdan tek lokma geçmedi.
Dialogue: 0,0:21:12.96,0:21:16.68,Main,Rebecca,0,0,0,,Rebecca, burada birazcık\Nyalnız kalabilir misin?
Dialogue: 0,0:21:16.68,0:21:19.50,Main,Rebecca,0,0,0,,Buradan kıpırdamayacağına söz ver bana.
Dialogue: 0,0:21:20.36,0:21:22.49,Main,Rebecca,0,0,0,,Yiyecek bir şeyler alacağım.
Dialogue: 0,0:21:23.22,0:21:24.23,Main,Rebecca,0,0,0,,Peki!
Dialogue: 0,0:21:36.07,0:21:37.74,Main,Rebecca,0,0,0,,Anne!
Dialogue: 0,0:21:40.94,0:21:43.38,Main,Soldier,0,0,0,,Koruyamadın onu!
Dialogue: 0,0:21:44.24,0:21:49.98,Main,Soldier,0,0,0,,Bağışla beni!\NAnneni koruyamadım!
Dialogue: 0,0:21:51.54,0:21:53.66,Main,Soldier,0,0,0,,Bunları sana vermemi istedi.
Dialogue: 0,0:21:53.66,0:21:57.56,Main,Soldier,0,0,0,,Burada aç bir şekilde beklediğini söyledi.
Dialogue: 0,0:21:58.26,0:22:01.58,Flashbacks,Rebecca,0,0,0,,{\i1}Anne, çok açım.{\i0}
Dialogue: 0,0:22:03.70,0:22:05.44,Flashbacks,Scarlett,0,0,0,,{\i1}Yiyecek bir şeyler alacağım.{\i0}
Dialogue: 0,0:22:20.95,0:22:22.86,Main,Grunt,0,0,0,,Merdivenlerden çıkarken\Nkan izi gördüm!
Dialogue: 0,0:22:22.86,0:22:24.90,Main,Grunt,0,0,0,,Buralarda saklanıyorlardır!
Dialogue: 0,0:22:24.90,0:22:25.76,Main,Grunt,0,0,0,,Arayalım!
Dialogue: 0,0:22:29.79,0:22:36.40,Thoughts,Soldier,0,0,0,,{\i1}Özür dilerim, özür dilerim, özür dilerim.{\i0}
Dialogue: 0,0:22:43.19,0:22:48.21,Main,Soldier,0,0,0,,Annen önemli biriydi.
Dialogue: 0,0:22:49.52,0:22:53.78,Main,Soldier,0,0,0,,Ülkenin artık yeni bir kralı var...
Dialogue: 0,0:22:54.30,0:23:00.46,Main,Soldier,0,0,0,,...ve yeni kral bu tarz \Nönemli kişileri yakalamak istiyor.
Dialogue: 0,0:23:01.03,0:23:04.70,Main,Soldier,0,0,0,,Bu kişilere annenin kanını taşıdığın için \Nsen de dahilsin.
Dialogue: 0,0:23:07.46,0:23:14.27,Main,Soldier,0,0,0,,Anneni koruyamadım fakat \Nseni hayatım pahasına koruyacağım!
Dialogue: 0,0:23:14.81,0:23:21.18,Main,Soldier,0,0,0,,Sen mutluluğu bulana değin \Nhep yanında olacağım!
Dialogue: 0,0:23:24.86,0:23:28.09,Main,Rebecca,0,0,0,,Annemi istiyorum ben!
Dialogue: 0,0:23:30.94,0:23:35.60,Main,Rebecca,0,0,0,,Annemi koruyamadın,\Nsenden nefret ediyorum!
Dialogue: 0,0:23:37.17,0:23:40.65,Main,Soldier,0,0,0,,Nasılım?! Bu nasıl?
Dialogue: 0,0:23:41.68,0:23:43.43,Main,Soldier,0,0,0,,Peki ya böyle?!
Dialogue: 0,0:23:44.70,0:23:46.11,Main,Soldier,0,0,0,,Nereye gidiyorsun, Rebacca!
Dialogue: 0,0:23:46.11,0:23:48.52,Main,Rebecca,0,0,0,,Eve gidiyorum!
Dialogue: 0,0:23:48.52,0:23:49.47,Main,Soldier,0,0,0,,Gidemezsin!
Dialogue: 0,0:23:49.78,0:23:54.04,Main,Soldier,0,0,0,,Yeni kralın dostları evinde,\Ntüm şehirde seni arıyorlar!
Dialogue: 0,0:23:54.04,0:23:56.26,Main,Citizen,0,0,0,,Doflamingo-sama!
Dialogue: 0,0:23:56.26,0:24:00.38,Main,Citizen,0,0,0,,Doflamingo, Doflamingo!
Dialogue: 0,0:24:00.38,0:24:06.79,Main,Doflamingo,0,0,0,,Bu zavallı ülke asırlardır\NRiku ailesinin kontrolündeydi!
Dialogue: 0,0:24:06.79,0:24:12.68,Main,Doflamingo,0,0,0,,Öyle ki kendi halkından çalacak kadar\Nyüzsüz hale geldiler!
Dialogue: 0,0:24:12.68,0:24:16.12,Main,Doflamingo,0,0,0,,Bense bu ülkeyi zenginleştireceğim!
Dialogue: 0,0:24:24.37,0:24:27.14,Main,Worker,0,0,0,,Oyuncakların çalışabildiğini bilmiyordum.
Dialogue: 0,0:24:27.14,0:24:28.85,Main,Soldier,0,0,0,,Para lazım!
Dialogue: 0,0:24:33.62,0:24:35.04,Main,Soldier,0,0,0,,Rebecca!
Dialogue: 0,0:24:53.64,0:24:54.87,Main,Rebecca,0,0,0,,Aptal!
Dialogue: 0,0:24:54.87,0:24:57.04,Main,Soldier,0,0,0,,Bak, kırılmazım ben!
Dialogue: 0,0:24:57.04,0:24:59.56,Main,Soldier,0,0,0,,Kırılmaz ve güçlü süper oyuncak!
Dialogue: 0,0:25:12.51,0:25:17.75,Main,Soldier,0,0,0,,{\i1}Asker-san cesur mu cesur...{\i0}
Dialogue: 0,0:25:17.75,0:25:22.60,Main,Soldier,0,0,0,,{\i1}Asker-san cesur mu cesur...{\i0}
Dialogue: 0,0:25:23.47,0:25:25.09,Thoughts,Soldier,0,0,0,,{\i1}Üşüyor olmalı.{\i0}
Dialogue: 0,0:25:25.68,0:25:29.37,Thoughts,Soldier,0,0,0,,{\i1}Bu tenekeden bedenle\Nhiçbir şey hissedemiyorum.{\i0}
Dialogue: 0,0:25:34.32,0:25:35.28,Main,Rebecca,0,0,0,,Sıcak mı?
Dialogue: 0,0:25:35.28,0:25:37.68,Main,Soldier,0,0,0,,Evet, sıcacık oldu!
Dialogue: 0,0:25:41.85,0:25:46.38,Main,Soldier,0,0,0,,{\i1}Asker-san cesur mu cesur...{\i0}
Dialogue: 0,0:25:46.38,0:25:52.52,Main,Soldier,0,0,0,,{\i1}Olacak hep yanında...{\i0}
Dialogue: 0,0:25:53.20,0:25:54.92,Main,Soldier,0,0,0,,Kirası nedir buranın?
Dialogue: 0,0:25:54.92,0:25:57.62,Main,Old Man,0,0,0,,Terk edilmiş bir ev,\Ngönlünüzce kullanabilirsiniz.
Dialogue: 0,0:25:57.62,0:26:00.57,Main,Old Man,0,0,0,,Kral Riku Ordusu'nun\Ngazabına uğramış bir yer burası...
Dialogue: 0,0:26:00.57,0:26:02.51,Main,Old Man,0,0,0,,...sakinlerinin çoğu başka yerlere göçtü.
Dialogue: 0,0:26:03.99,0:26:05.85,Main,Rebecca,0,0,0,,İçerisi sıcacık!
Dialogue: 0,0:26:05.85,0:26:07.08,Main,Soldier,0,0,0,,Pencereyi kapat!
Dialogue: 0,0:26:07.08,0:26:07.61,Main,Rebecca,0,0,0,,Hayır!
Dialogue: 0,0:26:08.35,0:26:11.03,Main,Rebecca,0,0,0,,Başka oyuncaklar da var.
Dialogue: 0,0:26:11.03,0:26:13.88,Main,Soldier,0,0,0,,Başka çocuklar da var,\Noynayın beraber.
Dialogue: 0,0:26:14.66,0:26:18.22,Main,Soldier,0,0,0,,Köyde başkaları da olduğundan\Noyuncakların kanununa uymalıyız.
Dialogue: 0,0:26:19.24,0:26:22.02,Main,Soldier,0,0,0,,Sen uykuya dalınca ben de\Noyuncak evine döneceğim.
Dialogue: 0,0:26:22.04,0:26:25.10,Main,Soldier,0,0,0,,Fakat sen gözünü açmadan\Ndöneceğime emin olabilirsin!
Dialogue: 0,0:26:26.33,0:26:28.47,Main,Soldier,0,0,0,,Hep yanında olduğumun bir kanıtı olarak...
Dialogue: 0,0:26:28.47,0:26:33.50,Main,Soldier,0,0,0,,...her sabah penceredeki çatlaktan\Nyeni bir çiçek yaprağı bırakacağım.
Dialogue: 0,0:26:42.28,0:26:43.88,Main,Rebecca,0,0,0,,Günaydın, Asker-san!
Dialogue: 0,0:26:44.28,0:26:45.46,Main,Soldier,0,0,0,,Sana da günaydın!
Dialogue: 0,0:27:26.32,0:27:27.83,Main,Criminal,0,0,0,,Kimsesiz herhâlde!?
Dialogue: 0,0:27:27.83,0:27:29.98,Main,Criminal,0,0,0,,Ailesi falan yok,\Nkimsenin umrunda olmaz.
Dialogue: 0,0:27:35.63,0:27:36.90,Main,Soldier,0,0,0,,Rebecca!
Dialogue: 0,0:27:42.41,0:27:46.44,Main,Criminal,0,0,0,,Epey şirin de!\NBu kızdan bayağı para kaldırırız.
Dialogue: 0,0:27:46.44,0:27:48.01,Main,Soldier,0,0,0,,Rebecca!
Dialogue: 0,0:27:55.84,0:27:59.42,Main,Criminal,0,0,0,,Şu tuhaf oyuncak peşimizden geliyor.
Dialogue: 0,0:28:03.67,0:28:04.74,Main,Criminal,0,0,0,,Paramparça edeceğim seni!
Dialogue: 0,0:28:08.78,0:28:10.03,Main,Rebecca,0,0,0,,Asker-san!
Dialogue: 0,0:28:13.22,0:28:15.39,Main,Soldier,0,0,0,,Rebecca!
Dialogue: 0,0:28:21.82,0:28:25.00,Main,Soldier,0,0,0,,Özür dilerim.\NAranıyor listesine soktular beni.
Dialogue: 0,0:28:25.94,0:28:28.77,Main,Rebecca,0,0,0,,Ama beraberiz sonuçta,\Nbaşka bir ev bulalım kendimize!
Dialogue: 0,0:28:30.62,0:28:35.59,Main,Rebecca,0,0,0,,Bir gün seninle aynı evde\Nyaşamak istiyorum Asker-san.
Dialogue: 0,0:28:39.81,0:28:41.83,Main,Soldier,0,0,0,,Sana savaşmayı öğreteyim.
Dialogue: 0,0:28:41.83,0:28:44.44,Main,Rebecca,0,0,0,,Sen yanımdasın sonuçta, ne gerek var?
Dialogue: 0,0:28:44.44,0:28:46.44,Main,Soldier,0,0,0,,Bana bir şey olursa ne yapacaksın?
Dialogue: 0,0:28:46.44,0:28:49.57,Main,Rebecca,0,0,0,,Annem insanlara zarar vermemem\Ngerektiğini söylemişti!
Dialogue: 0,0:28:49.57,0:28:52.44,Main,Soldier,0,0,0,,Fakat ben sana\Nzarar görmemeyi öğreteceğim!
Dialogue: 0,0:28:53.84,0:28:54.98,Main,Soldier,0,0,0,,Haydi!
Dialogue: 0,0:29:08.88,0:29:13.60,Thoughts,Rebecca,0,0,0,,{\i1}Hep yanımdaydı,\Nher zaman beni korudu.{\i0}
Dialogue: 0,0:29:20.29,0:29:21.51,Main,Announcer,0,0,0,,Geliyor işte!
Dialogue: 0,0:29:22.24,0:29:25.08,Main,Announcer,0,0,0,,Hazır mısınız millet?!
Dialogue: 0,0:29:25.08,0:29:28.00,Main,Announcer,0,0,0,,Kolezyumun en güzel savaşçısı!
Dialogue: 0,0:29:28.00,0:29:30.47,Main,Announcer,0,0,0,,Hayalet Prenses!
Dialogue: 0,0:29:30.47,0:29:34.76,Main,Announcer,0,0,0,,Seyirciyi bu denli coşturabilen\Nbaşka bir savaşçı daha yok!
Dialogue: 0,0:29:35.62,0:29:38.19,Thoughts,Rebecca,0,0,0,,{\i1}Ölme sakın, Asker-san!{\i0}
Dialogue: 0,0:29:40.15,0:29:41.32,Thoughts,Rebecca,0,0,0,,{\i1}Keza asla...{\i0}
Dialogue: 0,0:29:44.12,0:29:45.98,Main,Audience,0,0,0,,Canın cehenneme Rebecca!
Dialogue: 0,0:29:45.98,0:29:47.85,Main,Audience,0,0,0,,Parça pinçik edin şunu!
Dialogue: 0,0:29:47.85,0:29:50.90,Main,Audience,0,0,0,,Riku ailesinin tohumu, geber!
Dialogue: 0,0:29:50.90,0:29:54.07,Main,Audience,0,0,0,,Sizi yozlaşmış adiler!
Dialogue: 0,0:29:54.07,0:29:55.46,Thoughts,Rebecca,0,0,0,,{\i1}...vazgeçmeyeceğim!{\i0}
Dialogue: 0,0:30:10.22,0:30:12.56,Main,Luffy,0,0,0,,Neden herkes ondan\Nbu kadar çok nefret ediyor?
Dialogue: 0,0:30:12.56,0:30:14.22,Main,Luffy,0,0,0,,Çok iyi biri o be...
Dialogue: 0,0:30:14.22,0:30:17.38,Main,Luffy,0,0,0,,...kafa mı buluyor bunlar?! \NYemek aldı ba-
Dialogue: 0,0:30:17.38,0:30:18.58,Main,Gladiator,0,0,0,,Biliyoruz!
Dialogue: 0,0:30:19.00,0:30:23.75,Main,Gladiator,0,0,0,,Fakat Rebecca'nın dedesi \Ntüm ülkenin nefret ettiği...
Dialogue: 0,0:30:23.75,0:30:25.90,Main,Gladiator,0,0,0,,...eski kraldır!
