Dialogue: 0,0:02:30.03,0:02:38.50,Title,,0,0,0,,{\fad(2000,2000)}C Bloktaki Savaş Alanı!\NLucy ve Ucy!
Dialogue: 0,0:02:39.26,0:02:41.74,Captions,,0,0,180,,{\fad(500,0)}Dressrosa Açıkları
Dialogue: 0,0:02:41.83,0:02:44.81,Captions,,0,0,180,,{\fad(500,0)}Thousand Sunny
Dialogue: 0,0:02:46.56,0:02:47.95,Main,,0,0,0,,Sen de kimsin?!
Dialogue: 0,0:02:47.95,0:02:49.28,Main,,0,0,0,,Kapa çeneni!
Dialogue: 0,0:02:51.30,0:02:53.49,Main,,0,0,0,,Deniz kızı mı\Ndediniz siz az önce bana?
Dialogue: 0,0:02:53.49,0:02:54.55,Main,,0,0,0,,Yok öyle bir şey!
Dialogue: 0,0:02:54.84,0:03:00.48,Main,,0,0,0,,Cidden yani! O tuhaf gücünü kullanmaya devam ederse Sunny-go mahvolacak!
Dialogue: 0,0:03:00.48,0:03:04.70,Main,,0,0,0,,Franky-san'ın kızacak olması bir yana normale dönebilecek miyiz acaba?
Dialogue: 0,0:03:04.70,0:03:08.53,Main,,0,0,0,,Bir zamanlar\Nerkeklerin yatak odası olan o oda...
Dialogue: 0,0:03:08.53,0:03:14.37,Main,,0,0,0,,Bilmiyorum fakat şimdilik Sunny-go'ya\Ndaha fazla zarar verdirmemeye çalışalım!
Dialogue: 0,0:03:14.37,0:03:18.01,Main,,0,0,0,,Saldırılarını bu yöne,\Ngemiden dışarı çevirirse...
Dialogue: 0,0:03:18.01,0:03:20.14,Main,,0,0,0,,...iyi olur.
Dialogue: 0,0:03:20.14,0:03:20.78,Main,,0,0,0,,Yuh!
Dialogue: 0,0:03:22.05,0:03:24.17,Main,,0,0,0,,Bana bakın!
Dialogue: 0,0:03:24.17,0:03:27.89,Main,,0,0,0,,Hemen peşlerine düşüp\NMomonosuke'yi alın onlardan!
Dialogue: 0,0:03:30.46,0:03:32.07,Main,,0,0,0,,Emredersiniz, Giolla-sama!
Dialogue: 0,0:03:36.01,0:03:40.56,Main,,0,0,0,,Ruhum şahlandı adeta!\NBir resim görüyorum!
Dialogue: 0,0:03:40.56,0:03:42.92,Main,,0,0,0,,Aklım volkan gibi patlamak üzere!
Dialogue: 0,0:03:44.04,0:03:46.37,Main,,0,0,0,,Gene aynı şeyi yapıyor!
Dialogue: 0,0:03:46.37,0:03:49.39,Main,,0,0,0,,Alo, buradayız biz ama?!
Dialogue: 0,0:03:49.39,0:03:50.93,Main,,0,0,0,,Bize saldırsana!
Dialogue: 0,0:03:50.93,0:03:53.66,Main,,0,0,0,,Gemiyle uğraşma şimdi,\Nbiz buradayız!
Dialogue: 0,0:03:55.76,0:03:59.76,Main,,0,0,0,,Özgürlük ve güzellik dolu\No resim patlayacak!
Dialogue: 0,0:04:01.05,0:04:03.55,Main,,0,0,0,,Olamaz!
Dialogue: 0,0:04:03.65,0:04:06.56,Main,,0,0,0,,Dünya özgür olmalı!
Dialogue: 0,0:04:06.56,0:04:08.92,Main,,0,0,0,,Haksız mıyım?!
Dialogue: 0,0:04:22.84,0:04:24.64,Main,,0,0,0,,Lanet olsun!
Dialogue: 0,0:04:24.64,0:04:28.08,Main,,0,0,0,,Çok fena bir şey yaptı!
Dialogue: 0,0:04:39.68,0:04:41.23,Main,,0,0,0,,Güzellik budur işte!
Dialogue: 0,0:04:41.23,0:04:44.13,Main,,0,0,0,,Olamaz ya!\NGemi falan değil artık o!
Dialogue: 0,0:04:46.13,0:04:48.75,Main,,0,0,0,,Aman ya, aman ya!
Dialogue: 0,0:04:49.57,0:04:52.14,Main,,0,0,0,,Numaralarınıza kanacak değilim!
Dialogue: 0,0:04:52.64,0:04:58.41,Main,,0,0,0,,Genç Bey'im benden Momonosuke'yi kaçırıp geminize el koymamı istedi!
Dialogue: 0,0:05:00.38,0:05:07.70,Main,,0,0,0,,Böylece Hasır Şapka'lar olarak Dressrosa'dan asla kaçamayacaksınız!
Dialogue: 0,0:05:18.50,0:05:21.48,Captions,,0,0,220,,{\fad(200,200)}Dressrosa
Dialogue: 0,0:05:21.60,0:05:23.49,Main,,0,0,0,,{\an8}Tedavi falan istemem!
Dialogue: 0,0:05:22.02,0:05:25.34,Captions,,0,0,220,,{\fad(200,0)}Corrida Kolezyumu
Dialogue: 0,0:05:23.49,0:05:25.34,Main,,0,0,0,,{\an8}Ben gidiyorum!
Dialogue: 0,0:05:25.34,0:05:28.54,Main,,0,0,0,,Savaşçı Ricky, buna izin veremeyiz!
Dialogue: 0,0:05:28.54,0:05:34.05,Main,,0,0,0,,Siz misafirlerimiz başta olmak üzere savaşçılarla ilgilenip ve tedavilerini yapmak görevimiz.
Dialogue: 0,0:05:34.05,0:05:36.57,Main,,0,0,0,,İnsanları seyirci önünde\Nbirbirine kırdırıp da...
Dialogue: 0,0:05:36.57,0:05:37.90,Main,,0,0,0,,...sonra ne tedavisinden\Nbahsediyorsunuz siz bana?!
Dialogue: 0,0:05:37.90,0:05:39.48,Main,,0,0,0,,Kafan kanıyor!
Dialogue: 0,0:05:39.48,0:05:41.94,Main,,0,0,0,,Maskeni çıkart da tedavini yapalım!
Dialogue: 0,0:05:41.94,0:05:43.79,Main,,0,0,0,,Maskeme dokunma!
Dialogue: 0,0:05:45.52,0:05:47.21,Main,,0,0,0,,Çıkış kapısını açın!
Dialogue: 0,0:05:47.21,0:05:49.93,Main,,0,0,0,,Hep birlikte yakalayalım onu!\NAğır yaralı!
Dialogue: 0,0:05:59.16,0:06:00.47,Main,,0,0,0,,Çok kötü yaralanmışsın.
Dialogue: 0,0:06:01.08,0:06:03.21,Main,,0,0,0,,Tedavi görsen iyi olur.
Dialogue: 0,0:06:04.70,0:06:05.58,Main,,0,0,0,,Haydi.
Dialogue: 0,0:06:08.29,0:06:11.17,Main,,0,0,0,,Çekilin önümden,\Nkendim yürüyebilirim!
Dialogue: 0,0:06:11.17,0:06:12.95,Main,,0,0,0,,Düz devam edip\Nbodruma giden merdivenlerden in.
Dialogue: 0,0:06:16.09,0:06:19.31,Thoughts,,0,0,0,,{\i1}Rebecca... Bağışla.{\i0}
Dialogue: 0,0:06:31.89,0:06:36.32,Captions,,0,0,250,,{\fad(1000,1500)}Don Quixote Ailesi'nin\NKolezyum'daki Bekleme Odası
Dialogue: 0,0:06:34.02,0:06:38.01,Main,,0,0,0,,{\an8}Hasır Şapka şu anda savaşıyor, Diamante.
Dialogue: 0,0:06:38.83,0:06:41.25,Main,,0,0,0,,Oyundan sonra da olur.
Dialogue: 0,0:06:44.85,0:06:48.15,Main,,0,0,0,,Joker, Hasır Şapka'yı öldürmemi mi istiyor?
Dialogue: 0,0:06:48.15,0:06:50.76,Main,,0,0,0,,Bizim Doffy\Nçok yumuşak kalpli biri gerçekten.
Dialogue: 0,0:06:50.76,0:06:55.53,Main,,0,0,0,,Yarışmayı kazanamamış bir adama\Nbir şans daha veriyor.
Dialogue: 0,0:06:55.53,0:06:59.38,Main,,0,0,0,,Ne güzel değil mi Bellamy?\NSuikâst kolay iş.
Dialogue: 0,0:06:59.38,0:07:02.42,Main,,0,0,0,,Yarışma tamamen sona ermeden önce bitir şu işi.
Dialogue: 0,0:07:02.65,0:07:05.87,Flashbacks,,0,0,0,,Bellamy, dayan!
Dialogue: 0,0:07:07.03,0:07:11.66,Main,,0,0,0,,Ondan sonra da ailenin yöneticilerinden\Nbiri yapılacaksın.
Dialogue: 0,0:07:23.30,0:07:27.81,Main,,0,0,0,,Lucy'i öldürmeye çalışıyormuşsun, Cavendish.
Dialogue: 0,0:07:27.81,0:07:31.82,Main,,0,0,0,,Bartolomeo'ydu değil mi?\NFinallere adını yazdırmışsın, kutlarım.
Dialogue: 0,0:07:31.82,0:07:34.17,Main,,0,0,0,,Lucy meselesiyse seni ilgilendirmez.
Dialogue: 0,0:07:34.59,0:07:37.77,Main,,0,0,0,,Hayır, o adamı...
Dialogue: 0,0:07:37.77,0:07:40.47,Main,,0,0,0,,...sana vermem!
Dialogue: 0,0:07:43.78,0:07:46.88,Main,,0,0,0,,Anlıyorum, demek sen de\Nonun peşindesin?
Dialogue: 0,0:07:47.91,0:07:50.34,Main,,0,0,0,,Tüm ışıklar onun üzerinde sonuçta...
Dialogue: 0,0:07:50.34,0:07:51.98,Main,,0,0,0,,Fakat o benim, kimselere vermem!
Dialogue: 0,0:07:53.90,0:07:57.30,Main,,0,0,0,,Bizim aramızdaki bağ çok daha güçlü.
Dialogue: 0,0:07:58.17,0:08:01.77,Main,,0,0,0,,Daha şimdiden\Nbir sürü yarışmacı elendi bile!
Dialogue: 0,0:08:01.77,0:08:05.00,Main,,0,0,0,,C Bloğu savaşı epey kızışıyor!
Dialogue: 0,0:08:05.00,0:08:09.21,Main,,0,0,0,,Elbette tüm yarışmacılar\Nbirbirinden güçlü de olsa...
Dialogue: 0,0:08:09.24,0:08:14.14,Main,,0,0,0,,...aralarında sivrilen devasa\Nbir yarışmacı çarpıyor göze!
Dialogue: 0,0:08:24.05,0:08:28.35,Main,,0,0,0,,Devler ülkesi Elbaf'ın\Nyeni neslinden bir savaşçı!
Dialogue: 0,0:08:28.35,0:08:31.51,Main,,0,0,0,,Güçlü mü güçlü "Paralı Korsan"...
Dialogue: 0,0:08:31.51,0:08:33.14,Main,,0,0,0,,...onun adı...
Dialogue: 0,0:08:33.14,0:08:36.39,Main,,0,0,0,,Hajrudin!
Dialogue: 0,0:08:36.39,0:08:38.36,Main,,0,0,0,,Çok büyük lan!
Dialogue: 0,0:08:39.81,0:08:43.57,Main,,0,0,0,,Logia türü meyve yemiş bir dev\Ngördünüz mü hiç?
Dialogue: 0,0:08:52.11,0:08:55.13,Main,,0,0,0,,Mera Mera Meyvesi'ni\Nben yiyince göreceksiniz!
Dialogue: 0,0:08:55.87,0:08:58.85,Main,,0,0,0,,Devlerin...
Dialogue: 0,0:08:58.85,0:09:00.72,Main,,0,0,0,,...kralı olacağım!
Dialogue: 0,0:09:00.72,0:09:04.21,Main,,0,0,0,,Tek bir yumruğu yıldırım gibi adeta!
Dialogue: 0,0:09:04.21,0:09:06.96,Main,,0,0,0,,Bu devi kim durdurabilir?!
Dialogue: 0,0:09:07.86,0:09:10.21,Main,,0,0,0,,Amanın, öte yanda...
Dialogue: 0,0:09:10.70,0:09:15.68,Main,,0,0,0,,...karşısındaki güçlü rakiplerine rağmen kontrolden çıkmış bir boğa görüyorum!
Dialogue: 0,0:09:17.10,0:09:20.70,Main,,0,0,0,,Yine bu kolezyumda ölüm\Ncezası almış 21 mahkumu...
Dialogue: 0,0:09:20.72,0:09:24.16,Main,,0,0,0,,...cehenneme yollamış\Nkatil bir boğa kendisi!
Dialogue: 0,0:09:25.14,0:09:26.82,Main,,0,0,0,,Kolezyumun ölüm meleği!
Dialogue: 0,0:09:26.82,0:09:31.10,Main,,0,0,0,,İnsanların deyimiyle acımasız\Nyani Brutal Boğa!
Dialogue: 0,0:09:31.10,0:09:35.86,Main,,0,0,0,,Ve gizemli bir biçimde bu ölüm meleğini\Nehlileştirmiş bu adam var!
Dialogue: 0,0:09:35.86,0:09:41.71,Main,,0,0,0,,Etkileyici bir giriş yaptıktan sonra çevikliği ve gücüyle anında seyircinin favorisi olmayı başardı!
Dialogue: 0,0:09:41.71,0:09:43.10,Main,,0,0,0,,Lucy!
Dialogue: 0,0:09:44.00,0:09:46.13,Main,,0,0,0,,Yardır Ucy!
Dialogue: 0,0:09:48.55,0:09:52.62,Main,,0,0,0,,Bu adamı ben de çok sevdim!
Dialogue: 0,0:09:52.62,0:09:55.01,Main,,0,0,0,,Gyats-san, tarafsız olmanız lazım sizin!
Dialogue: 0,0:09:56.87,0:10:01.48,Main,,0,0,0,,Aferim, böyle işte!\NFırlat hepsini!
Dialogue: 0,0:10:03.35,0:10:05.98,Main,,0,0,0,,Lucy!
Dialogue: 0,0:10:07.04,0:10:10.57,Main,,0,0,0,,Sahte isimle bile ünlendi eleman!\NLanet olası Hasır Şapka...
Dialogue: 0,0:10:13.15,0:10:14.59,Main,,0,0,0,,Çok komik biriymiş.
Dialogue: 0,0:10:16.03,0:10:18.24,Main,,0,0,0,,Yardır Ucy!
Dialogue: 0,0:10:26.18,0:10:28.74,Main,,0,0,0,,Eyvahlar olmasın,\NHajrudin'e kafa tutuyorlar!
Dialogue: 0,0:10:28.74,0:10:30.89,Main,,0,0,0,,Savaşmak istiyorsunuz demek?
Dialogue: 0,0:10:30.89,0:10:32.78,Main,,0,0,0,,Lanet olsun, kaç Ucy!
Dialogue: 0,0:10:32.78,0:10:33.85,Main,,0,0,0,,Ucy!
Dialogue: 0,0:10:37.60,0:10:38.32,Main,,0,0,0,,Boğa!
Dialogue: 0,0:10:53.40,0:10:54.83,Main,,0,0,0,,Boğa!
Dialogue: 0,0:10:54.83,0:10:57.30,Main,,0,0,0,,Lucy!
Dialogue: 0,0:10:57.93,0:11:01.05,Main,,0,0,0,,Ne büyük hayal kırıklığı ama!
Dialogue: 0,0:11:07.61,0:11:10.35,Main,,0,0,0,,Güçleri arasında\Nuçurum olduğu belliydi!
Dialogue: 0,0:11:10.35,0:11:14.09,Main,,0,0,0,,Elbaf'ın çaylağı karşısında...
Dialogue: 0,0:11:16.75,0:11:21.95,Main,,0,0,0,,...kolezyumun ölüm meleğiyle\Ngizemli gladyatör Lucy...
Dialogue: 0,0:11:21.95,0:11:23.19,Main,,0,0,0,,G-Gatz-{\i0}san{\i0}!
Dialogue: 0,0:11:23.19,0:11:24.90,Main,,0,0,0,,...güçsüz kaldılar.
Dialogue: 0,0:11:27.29,0:11:28.97,Main,,0,0,0,,Ne?
Dialogue: 0,0:12:04.84,0:12:09.17,Main,,0,0,0,,Dev düştü!
Dialogue: 0,0:12:18.08,0:12:20.69,Main,,0,0,0,,Harikaydı, Lucy!
Dialogue: 0,0:12:23.39,0:12:27.89,Main,,0,0,0,,Yarışma devam ettikçe\Nheyecan da giderek artıyor!
Dialogue: 0,0:12:28.71,0:12:32.30,Main,,0,0,0,,Fırtınanın merkezi haline gelen C Bloğu'nda...
Dialogue: 0,0:12:32.30,0:12:35.90,Main,,0,0,0,,...Lucy yine yapacağını yapıyor!
Dialogue: 0,0:12:39.07,0:12:42.07,Main,,0,0,0,,Arenanın kenarına taşıyayım seni, Ucy.
Dialogue: 0,0:12:45.91,0:12:49.66,Main,,0,0,0,,Bu adamda göreceğimiz\Ndaha çok şey var gibi!
Dialogue: 0,0:12:52.20,0:12:53.48,Main,,0,0,0,,Tabii var!
Dialogue: 0,0:12:56.39,0:13:00.66,Main,,0,0,0,,Bu denli güçlü olmasını beklemiyordum,\Nacayip şaşırdım.
Dialogue: 0,0:13:00.66,0:13:02.72,Main,,0,0,0,,Lucy!
Dialogue: 0,0:13:04.93,0:13:09.07,Main,,0,0,0,,Dev! Arena burası.
Dialogue: 0,0:13:10.07,0:13:13.07,Main,,0,0,0,,Uyumaya geldiysen çek git!
Dialogue: 0,0:13:21.61,0:13:26.73,Main,,0,0,0,,Hajrudin'in devasa bedeni\Npatlamadan sonra havaya uçtu!
Dialogue: 0,0:13:26.73,0:13:29.99,Main,,0,0,0,,Ne oldu orada öyle?!
Dialogue: 0,0:13:38.83,0:13:42.33,Main,,0,0,0,,Hayır, patlama değilmiş!
Dialogue: 0,0:13:42.33,0:13:46.91,Main,,0,0,0,,Hajrudin elenmiş olabilir fakat C Bloğu'nda hâlâ pek çok güçlü katılımcı var gibi!
Dialogue: 0,0:13:49.66,0:13:54.75,Main,,0,0,0,,Tuhaf görünümlü omuzlarıyla\Nattığı patlayıcı yumruğuyla...
Dialogue: 0,0:13:54.75,0:13:56.48,Main,,0,0,0,,Ideo!
Dialogue: 0,0:13:57.05,0:13:59.85,Main,,0,0,0,,{\an8}...devin kocaman bedenini havaya uçuran kişi...
Dialogue: 0,0:13:58.65,0:14:05.07,Captions,,0,0,250,,{\fad(1000,0)}XXX Seviye Boksör\NYok Edici Gülle Ideo
Dialogue: 0,0:13:59.85,0:14:05.07,Main,,0,0,0,,{\an8}...Yeni Dünya Merkezi Dövüş Turnuvasında\Niki kez birincilik elde etmiş...
Dialogue: 0,0:14:05.39,0:14:09.29,Main,,0,0,0,,Yok Edici Gülle\NIdeo'dan başkası değil!
Dialogue: 0,0:14:09.29,0:14:13.60,Main,,0,0,0,,Fakat dikkat kesilmeniz gereken\Ntek mücadele bu değil!
Dialogue: 0,0:14:14.00,0:14:16.57,Main,,0,0,0,,Seyirciler, onlara da bakın!
Dialogue: 0,0:14:16.57,0:14:20.31,Main,,0,0,0,,Uzak doğudaki Kano\NKrallığı'ndan gelen o üç kişilik...
Dialogue: 0,0:14:20.34,0:14:24.08,Main,,0,0,0,,...grup da diğerlerinden\Nbüyük bir farkla sıyrılıyor!
Dialogue: 0,0:14:32.42,0:14:34.19,Main,,0,0,0,,İşe yaramaz!
Dialogue: 0,0:14:38.22,0:14:40.08,Main,,0,0,0,,{\an8}Ve işte huzurlarınızda!
Dialogue: 0,0:14:40.08,0:14:41.48,Main,,0,0,0,,{\an8}Kendinizi onun gazabından koruyamazsınız!
Dialogue: 0,0:14:41.23,0:14:47.53,Captions,,0,0,250,,{\fad(500,0)}Sai - Happo Donanması'nın 13. Lideri -\NKano Krallığı'ndan Gelen Grup
Dialogue: 0,0:14:41.48,0:14:44.35,Main,,0,0,0,,{\an8}Herhangi bir darbeyi kontrol etmelerini\Nsağlayan Sekiz Darbeli yumruk!
Dialogue: 0,0:14:44.35,0:14:47.53,Main,,0,0,0,,{\an8}Onlara karşı kalkanlar da\Nzırhlar da işe yaramaz!
Dialogue: 0,0:14:56.12,0:15:01.34,Main,,0,0,0,,{\an8}Asırlar uzunluğundaki tarihleriyle Happo Donanması'nın gücüne...
Dialogue: 0,0:15:01.34,0:15:04.90,Main,,0,0,0,,{\an8}...kimseler karşı koyamaz!
Dialogue: 0,0:14:58.43,0:15:04.90,Captions,,0,0,250,,{\fad(500,0)}Boo - Happo Donanması'nın Yardımcı Lideri -\NKano Krallığı'ndan Gelen Grup
Dialogue: 0,0:15:10.83,0:15:12.42,Main,,0,0,0,,Seni öldürebilirsek...
Dialogue: 0,0:15:12.83,0:15:16.79,Main,,0,0,0,,...bu yarışmayı kazanmış kadar oluruz, Chinjao!
Dialogue: 0,0:15:16.79,0:15:18.76,Main,,0,0,0,,Amanın...
Dialogue: 0,0:15:21.41,0:15:24.00,Captions,,0,0,220,,{\fad(500,0)}Happo Donanması'nın 12. Lideri (Emekli) -\NKano Krallığı'ndan Gelen Grup
Dialogue: 0,0:15:25.15,0:15:28.16,Main,,0,0,0,,Onun için daha çok fırın ekmek\Nyemeniz lazım sizi işe yaramaz veletler!
Dialogue: 0,0:15:32.02,0:15:34.35,Captions,,0,0,220,,{\fad(500,0)}Don Chinjao
Dialogue: 0,0:15:38.48,0:15:40.80,Main,,0,0,0,,Kralların Hakisi bu!
Dialogue: 0,0:15:40.80,0:15:41.96,Main,,0,0,0,,Öyledir!
Dialogue: 0,0:15:41.96,0:15:44.89,Main,,0,0,0,,500 milyonluk efsanevi korsandan bahsediyoruz!
Dialogue: 0,0:15:44.89,0:15:49.19,Main,,0,0,0,,Savaşmak istediğim tek kişi var burada! \NYoluma çıkmayın sakın!
Dialogue: 0,0:15:53.05,0:15:57.30,Main,,0,0,0,,Teşekkür ettim, Chinjao!\NSayende bir sürü silahım oldu!
Dialogue: 0,0:15:57.97,0:16:00.24,Main,,0,0,0,,Amanın!
Dialogue: 0,0:16:00.24,0:16:03.11,Main,,0,0,0,,Don Chinjao'nun\NHakisi'nden etkilenmeksizin...
Dialogue: 0,0:16:03.30,0:16:05.42,Main,,0,0,0,,{\an8}...arenadaki silahları toplayan bu kişi...
Dialogue: 0,0:16:04.52,0:16:10.01,Captions,,0,0,240,,{\fad(500,0)}Jean Ango Namı Diğer Haydut\NÖdül Avcısı
Dialogue: 0,0:16:05.42,0:16:10.01,Main,,0,0,0,,{\an8}...yarışmanın kara atı Haydut Jean!
Dialogue: 0,0:16:10.38,0:16:17.20,Main,,0,0,0,,Yeni Dünya'daki bütün önemli korsanların nefretini kazanmış bir ödül avcısı o!
Dialogue: 0,0:16:17.20,0:16:19.32,Main,,0,0,0,,Bekle lanet olası!
Dialogue: 0,0:16:20.76,0:16:23.73,Main,,0,0,0,,Sonunda seni bulabildim!
Dialogue: 0,0:16:23.73,0:16:28.08,Main,,0,0,0,,Dostumu parmaklıklar ardına göndermenin\Ncezasını çekeceksin!
Dialogue: 0,0:16:29.13,0:16:31.88,Main,,0,0,0,,Topladığım bu silahlar mermim olacaklar.
Dialogue: 0,0:16:31.88,0:16:33.57,Main,,0,0,0,,Keskin nişancıyım nihayetinde!
Dialogue: 0,0:16:37.27,0:16:39.30,Main,,0,0,0,,Madem çok değerli bir dostundu...
Dialogue: 0,0:16:39.30,0:16:42.74,Main,,0,0,0,,...bu hırsını parmaklıklar altında tutulduğu\No yeri basarak ispatlamalıydın!
Dialogue: 0,0:16:42.74,0:16:45.66,Main,,0,0,0,,İki yıl önce böyle bir şey yapan\Nbir ahmak olmuştu.
Dialogue: 0,0:16:51.32,0:16:53.96,Main,,0,0,0,,Adam kendinden geçti be zaten!
Dialogue: 0,0:16:53.96,0:16:55.99,Main,,0,0,0,,Daha ne kadar vurmayı planlıyor bu?!
Dialogue: 0,0:16:58.93,0:17:02.86,Main,,0,0,0,,Yapma ağabey!\NKendinde değil artık o!
Dialogue: 0,0:17:02.86,0:17:04.00,Main,,0,0,0,,Dur artık!
Dialogue: 0,0:17:06.83,0:17:09.96,Main,,0,0,0,,Yanlış insanı tutmuşum.
Dialogue: 0,0:17:12.80,0:17:16.27,Main,,0,0,0,,Lanet olası bana bücür dedi!
Dialogue: 0,0:17:16.27,0:17:20.36,Main,,0,0,0,,{\an8}Bobby, bücür müyüm lan ben?!
Dialogue: 0,0:17:16.39,0:17:23.07,Captions,,0,0,250,,{\fad(500,550)}Funk Kardeşler\NMogaro Krallığı'ndan Gelen Suikastçiler
Dialogue: 0,0:17:20.36,0:17:24.75,Main,,0,0,0,,{\an8}Katiyen! Sen kocaman bir insansın ağabey!
Dialogue: 0,0:17:24.75,0:17:27.55,Main,,0,0,0,,Konuşsana lan ahtapot beyinli!
Dialogue: 0,0:17:27.55,0:17:30.51,Main,,0,0,0,,Ağabey, yeter!
Dialogue: 0,0:17:31.71,0:17:34.25,Main,,0,0,0,,Yanlış insanı tutmuşum.
Dialogue: 0,0:17:35.11,0:17:39.87,Captions,,0,0,250,,{\fad(500,0)}Kelly Funk\NKardeşlerin Büyüğü
Dialogue: 0,0:17:40.91,0:17:45.74,Captions,,0,0,250,,{\fad(500,0)}Bobby Funk\NKardeşlerin Küçüğü
Dialogue: 0,0:17:34.99,0:17:38.88,Main,,0,0,0,,{\an8}Bir daha bunu derken duyarsam\Ngözlerini oyarım!
Dialogue: 0,0:17:38.88,0:17:42.97,Main,,0,0,0,,{\an8}İkide bir beni durdurmaya çalışma, Bobby!
Dialogue: 0,0:17:42.97,0:17:45.74,Main,,0,0,0,,{\an8}Fakat yarışmadayız, ağabey.
Dialogue: 0,0:17:45.74,0:17:48.67,Main,,0,0,0,,Acımasız Funk Kardeşler!
Dialogue: 0,0:17:48.67,0:17:54.51,Main,,0,0,0,,Yeraltı dünyasında\Nadlarını duymayan yok bu ikilinin!
Dialogue: 0,0:17:54.51,0:18:00.09,Main,,0,0,0,,100 milyonun üstünde ödülü olan korsanları kolayca öldürebilecek kadar güçlü olduklarını duymuştum!
Dialogue: 0,0:18:00.09,0:18:03.76,Secondary,,0,0,76,,{\i1}Yarışmaymış değilmiş umrumda değil! \NBücür diyemez bana!{\i0}
Dialogue: 0,0:18:01.05,0:18:03.76,Main,,0,0,0,,Amma sinir bozdular ha!
Dialogue: 0,0:18:03.76,0:18:08.66,Main,,0,0,0,,Hiçbir profesyonel çalışması olmayan\Nsokak süprüntüleri...
Dialogue: 0,0:18:08.66,0:18:11.59,Main,,0,0,0,,...ne kadar güçlüymüş\Nbir görelim bakalım!
Dialogue: 0,0:18:11.59,0:18:13.10,Main,,0,0,0,,Lan bücür!
Dialogue: 0,0:18:18.14,0:18:19.41,Main,,0,0,0,,Ağabey!
Dialogue: 0,0:18:19.41,0:18:20.56,Main,,0,0,0,,Yok artık!
Dialogue: 0,0:18:20.56,0:18:23.01,Main,,0,0,0,,Çok güçsüzmüş!
Dialogue: 0,0:18:23.01,0:18:26.46,Main,,0,0,0,,Yani Happo Donanması bu kadar\Ngüçlü müymüş demek istemiştim!
Dialogue: 0,0:18:26.46,0:18:28.64,Main,,0,0,0,,Ne büyük hayal kırıklığı ama!
Dialogue: 0,0:18:28.64,0:18:32.83,Main,,0,0,0,,Yesinler sizin gücünüzü be, aptallar!\NGerzek herifler!
Dialogue: 0,0:18:32.83,0:18:34.16,Main,,0,0,0,,Gatz-{\i0}san{\i0}!
Dialogue: 0,0:18:34.59,0:18:37.46,Main,,0,0,0,,Sıra sende, küçük kardeş!
Dialogue: 0,0:18:37.46,0:18:40.91,Main,,0,0,0,,Bekle! Ben savaşmayacağım.
Dialogue: 0,0:18:42.38,0:18:45.55,Main,,0,0,0,,Hayatı boyunca savaşmamış biriyim ben!
Dialogue: 0,0:18:45.55,0:18:47.20,Main,,0,0,0,,Geber!
Dialogue: 0,0:18:51.08,0:18:56.21,Main,,0,0,0,,Sırtını döndü resmen!\NNe rezil kardeşmiş bunlar!
Dialogue: 0,0:18:56.21,0:18:58.65,Thoughts,,0,0,0,,{\i1}Balta kırıldı!{\i0}
Dialogue: 0,0:18:58.65,0:19:02.62,Thoughts,,0,0,0,,{\i1}Üstelik Silahlanma Haki'siyle\Ngüçlendirilmiş bir baltaydı bu be!{\i0}
Dialogue: 0,0:19:03.06,0:19:05.54,Thoughts,,0,0,0,,{\i1}Ne sağlam bir vücudu var bunun!{\i0}
Dialogue: 0,0:19:06.66,0:19:08.78,Main,,0,0,0,,Ağabey.
Dialogue: 0,0:19:08.78,0:19:12.73,Main,,0,0,0,,O şerefsiz bana bücür dedi.
Dialogue: 0,0:19:13.32,0:19:17.33,Main,,0,0,0,,Giy hadi, Bobby!
Dialogue: 0,0:19:26.04,0:19:29.16,Main,,0,0,0,,Neler oluyor böyle?!
Dialogue: 0,0:19:29.59,0:19:30.73,Main,,0,0,0,,Boo!
Dialogue: 0,0:19:33.82,0:19:37.21,Main,,0,0,0,,Kano Krallığı'ndan Boo\Nsağlam dayak yiyor!
Dialogue: 0,0:19:37.21,0:19:39.20,Main,,0,0,0,,Kendinden geçti bile!
Dialogue: 0,0:19:39.60,0:19:43.73,Main,,0,0,0,,Ve onu yumruklayan kişiyse\Nezik küçük kardeş Bobby sanırım!?
Dialogue: 0,0:19:43.73,0:19:47.08,Main,,0,0,0,,Yoksa güçsüz ağabey Kelly mi o?!
Dialogue: 0,0:19:47.08,0:19:49.38,Main,,0,0,0,,Sanırım ağabey olan bu!
Dialogue: 0,0:19:49.38,0:19:52.24,Main,,0,0,0,,Devasa bir hal aldı,\Nbambaşka biri gibi duruyor!
Dialogue: 0,0:19:53.95,0:19:57.71,Main,,0,0,0,,Kimmiş cüce?!\NBir daha söyle bakalım!
Dialogue: 0,0:19:57.71,0:20:01.25,Main,,0,0,0,,Söyle de boğazını kopartayım!
Dialogue: 0,0:20:04.71,0:20:08.99,Main,,0,0,0,,Vay canına, Lucy'nin miğferi düştü!
Dialogue: 0,0:20:08.99,0:20:10.66,Main,,0,0,0,,Ver şunu geri!
Dialogue: 0,0:20:10.66,0:20:14.09,Main,,0,0,0,,Çok ilginç bir hikaye duydum\Nbiliyor musun, Lucy!
Dialogue: 0,0:20:14.70,0:20:19.80,Main,,0,0,0,,Duydum ki 400 milyon ödüllü\NHasır Şapkalı Luffy de...
Dialogue: 0,0:20:20.17,0:20:22.43,Main,,0,0,0,,...gizlice bu yarışmaya katılmış.
Dialogue: 0,0:20:28.93,0:20:33.56,Main,,0,0,0,,Don Chinjao kötü bir amaçla\Nbirine doğru ilerliyor!
Dialogue: 0,0:20:33.56,0:20:36.55,Main,,0,0,0,,Garp, gör bak!
Dialogue: 0,0:20:36.55,0:20:38.98,Main,,0,0,0,,Torununu öldüreceğim!
Dialogue: 0,0:20:38.98,0:20:44.36,Main,,0,0,0,,C Bloğu'nda geriye\Naşağı yukarı 40 katılımcı kaldı!
Dialogue: 0,0:20:46.12,0:20:49.89,Main,,0,0,0,,Geriye yalnızca\Nen güçlüler kalmaya başladı!
Dialogue: 0,0:20:50.75,0:20:54.33,Main,,0,0,0,,Kazanan kim olacak?!
