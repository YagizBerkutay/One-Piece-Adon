0,100,1,0,1,2.25,0,8,22,22,18,1Style: Narrator,Impress BT,56,&H00FFFFFF,&H000000FF,&H00000000,&H78000000,0,-1,0,0,100,100,0,0,1,1.5,1.5,8,120,120,18,1Style: OP11 Credits,FOT-Greco Std B,34,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,95,100,1,0,1,2.2,0,7,10,10,10,1Style: OP11 Lyrics,FOT-Greco Std B,39,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,2.6,0,2,10,10,15,1Style: OP12 Credits,FOT-Greco Std B,42,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,95,100,1,0,1,2.2,0,7,10,10,10,1Style: OP12 Lyrics,FOT-Greco Std B,39,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,2.6,0,2,10,10,15,1Style: Romaji - OP18 Styleı,Designosaur,45,&H00E9FFFE,&H00E9FFFE,&H00AD0B00,&H00FFE700,0,0,0,0,100,100,1,0,1,1.5,0,8,22,22,12,1Style: Romaji - OP18 Style1_alt,Designosaur,45,&H00E9FFFE,&H00E9FFFE,&H00AD0B00,&H00FFE700,0,0,0,0,100,100,1,0,1,1.5,0,8,22,22,12,1Style: English - OP18,Designosaur,39,&H00FFFFFF,&H00FFFFFF,&H00030303,&H00000000,0,-1,0,0,110,100,0,0,1,2.25,0,2,22,22,18,1Style: Romaji-OP19_R,Aero Matics Display,50,&H00AA3438,&H00FFFFFF,&H00FFFFFF,&H000000FF,0,0,0,0,100,100,0,0,1,1.5,0,8,22,22,12,1Style: Romaji-OP19_P,Poneglyph,32,&H32AA3438,&H32FFFFFF,&H00FFFFFF,&H00FFE700,0,0,0,0,100,100,0,0,1,2,0,8,22,22,18,1Style: Author,Impress BT,25,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1,1,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:02.49,0:00:04.79,English - OP18,,0,0,0,,~ Dövüş! ~ ♪ Çarpış ve yüksel yerinden ♪Dialogue: 0,0:00:04.79,0:00:08.00,English - OP18,,0,0,0,,♪ Aşmamız gereken zor günlerimiz bunlar ♪Dialogue: 0,0:00:08.00,0:00:12.84,English - OP18,,0,0,0,,♪ Keza sıradan günler yetmez sususluğumuzu dindirmeye ♪Dialogue: 0,0:00:12.84,0:00:15.09,English - OP18,,0,0,0,,~ İşte başlıyoruz! ~ ♪ Kaçmadan, hep ileriye ♪Dialogue: 0,0:00:15.09,0:00:19.17,English - OP18,,0,0,0,,♪ Ulu rüzgarlarda yaşayalım harabeye dönsek bile ♪Dialogue: 0,0:00:19.17,0:00:21.87,English - OP18,,0,0,0,,♪ Hedefse hâlâ çok uzakta ♪Dialogue: 0,0:00:21.87,0:00:26.69,English - OP18,,0,0,0,,♪ Aşmalı bu zor günleri ♪Dialogue: 0,0:00:28.53,0:00:31.61,English - OP18,,0,0,0,,♪ Yine yapalım, evet, kaç kez daha, bebeğim ♪Dialogue: 0,0:00:31.83,0:00:34.11,English - OP18,,0,0,0,,♪ Hayalimi gerçekleştirmek için doğrulmalı yerimden ♪Dialogue: 0,0:00:34.33,0:00:36.72,English - OP18,,0,0,0,,♪ Çünkü her gün sanki yeniden test ediliyor ♪Dialogue: 0,0:00:36.96,0:00:39.42,English - OP18,,0,0,0,,♪ İrade gücüm ♪Dialogue: 0,0:00:39.42,0:00:40.69,English - OP18,,0,0,0,,~ Haydi gidelim! ~Dialogue: 0,0:00:40.92,0:00:44.46,English - OP18,,0,0,0,,♪ İstemiyorum bahaneler üretip küçük başarılarla yetinmeyi ♪Dialogue: 0,0:00:44.67,0:00:45.96,English - OP18,,0,0,0,,~ Haydi gidelim! ~Dialogue: 0,0:00:46.18,0:00:49.66,English - OP18,,0,0,0,,♪ Vahşi ve kanunsuz içine düştüğüm şu dünyada ♪Dialogue: 0,0:00:49.89,0:00:54.18,English - OP18,,0,0,0,,♪ Gardımı indirmiş rüzgarla esip giderken  gerçeklik çalınıyor yüzüme ♪Dialogue: 0,0:00:54.18,0:00:59.47,English - OP18,,0,0,0,,♪ Acımasızca döv beni, vur bana ve  düşecek olursam da yine ♪Dialogue: 0,0:01:00.36,0:01:04.57,English - OP18,,0,0,0,,♪ Biliyorum yeniden doğrulup ileriye bakabilenler olacak ♪Dialogue: 0,0:01:04.57,0:01:07.82,English - OP18,,0,0,0,,♪ Son gülüp kazananlar ♪Dialogue: 0,0:01:07.82,0:01:10.12,English - OP18,,0,0,0,,~ Koşmalı şeref yolunda oraya varana kadar ~Dialogue: 0,0:01:10.30,0:01:12.54,English - OP18,,0,0,0,,~ Dövüş! ~ ♪ Kurtul kabuslarından, güçlü ol ♪Dialogue: 0,0:01:12.54,0:01:15.72,English - OP18,,0,0,0,,♪ Aşmamız gereken zor günlerimiz bunlar ♪Dialogue: 0,0:01:15.72,0:01:20.80,English - OP18,,0,0,0,,♪ Kolay yol? Yok öyle bir şey ♪Dialogue: 0,0:01:20.80,0:01:23.13,English - OP18,,0,0,0,,~ İşte başlıyoruz! ~ ♪ Hep en iyisi ol ♪Dialogue: 0,0:01:23.13,0:01:27.18,English - OP18,,0,0,0,,♪ Sorumluluklarını düşünmeden ilerle ♪Dialogue: 0,0:01:27.18,0:01:29.81,English - OP18,,0,0,0,,♪ Ve tüm dileklerimizi bir araya getirerek ♪Dialogue: 0,0:01:29.81,0:01:34.99,English - OP18,,0,0,0,,♪ Aşmalı bu zor günleri ♪Dialogue: 0,0:01:42.61,0:01:52.61,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gnsDialogue: 0,0:20:45.00,0:20:55.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gnsDialogue: 0,0:42:10.00,0:42:20.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gnsDialogue: 0,0:42:34.84,0:42:37.64,Author,,0,0,0,,ZORO 💙Dialogue: 0,0:01:42.61,0:01:45.53,Title,,0,0,240,,Zoro, Pica'ya KarşıDialogue: 0,0:01:51.32,0:01:55.34,Captions,,970,0,290,,Dressrosa                GÜLÜCÜK FabrikasıDialogue: 0,0:02:01.40,0:02:04.04,Main,,0,0,0,,Pekâlâ serseriler!Dialogue: 0,0:02:04.52,0:02:07.08,Main,,0,0,0,,Hazır mısınız?!Dialogue: 0,0:02:07.22,0:02:09.68,Main,,0,0,0,,Evet!Dialogue: 0,0:02:10.28,0:02:16.40,Main,,0,0,0,,Size, Tontattalara büyük acılar çektirmiş bu lanet fabrikayı...Dialogue: 0,0:02:16.66,0:02:19.46,Main,,0,0,0,,...yok edin!Dialogue: 0,0:02:22.56,0:02:24.06,Main,,0,0,0,,Gidelim!Dialogue: 0,0:02:24.20,0:02:27.02,Main,,0,0,0,,Teşekkür ederiz, Fraland!Dialogue: 0,0:02:28.94,0:02:31.74,Thoughts,,0,0,0,,Tontattalar, iyi şanslar!Dialogue: 0,0:02:36.12,0:02:40.14,Thoughts,,0,0,0,,Bundan sonrası sana emanet...Dialogue: 0,0:02:40.90,0:02:41.88,Thoughts,,0,0,0,,Luffy...Dialogue: 0,0:02:57.00,0:03:00.48,Main,,0,0,0,,Önce yaralılarla ilgilenin! Kurtarma ekibini çağırın!Dialogue: 0,0:03:00.66,0:03:01.16,Main,,0,0,5,,Emredersiniz!Dialogue: 0,0:03:01.05,0:03:04.01,Captions,,0,0,175,,Kraliyet Sarayı TepesiDialogue: 0,0:03:07.85,0:03:10.47,Main,,0,0,0,,Gösteri zamanı!Dialogue: 0,0:03:14.07,0:03:18.25,Main,,0,0,0,,Yarım Ay...Dialogue: 0,0:03:18.45,0:03:19.71,Main,,0,0,0,,...Kılıcı!Dialogue: 0,0:03:21.95,0:03:24.00,Captions,,0,830,255,,4. Seviye                Ayçiçeği TarlasıDialogue: 0,0:03:24.45,0:03:25.73,Main,,0,0,0,,Kyros!Dialogue: 0,0:03:24.00,0:03:26.17,Captions,,0,830,170,,Kyros, Diamante'ye  KarşıDialogue: 0,0:03:26.83,0:03:32.87,Main,,0,0,0,,Az önce burnun havada öfkeliyim falan diyordun sanki?!Dialogue: 0,0:03:34.11,0:03:40.77,Main,,0,0,0,,Beni yalnızca bazı şeyleri dalgalandırabilen  dahi bir matador mu sanıyorsun?!Dialogue: 0,0:03:41.35,0:03:46.59,Main,,0,0,0,,Sonsuza dek Kolezyum tarihinin en iyisi olarak kalacağını falan sanma sakın!Dialogue: 0,0:03:47.01,0:03:49.93,Main,,0,0,0,,Ben de epey sağlamımdır!Dialogue: 0,0:03:49.93,0:03:56.97,Main,,0,0,0,,Kolezyum'un şu anki kahramanı ben hazretleriyim!Dialogue: 0,0:03:59.11,0:04:01.05,Main,,0,0,0,,Ne olduğun umrumda değil!Dialogue: 0,0:04:01.65,0:04:04.29,Main,,0,0,0,,Tabii bazı şeyleri dalgalandırabildiğim de doğru!Dialogue: 0,0:04:14.79,0:04:15.73,Main,,0,0,0,,Baba!Dialogue: 0,0:04:17.05,0:04:20.31,Main,,0,0,0,,İyi denemeydi, az daha haklıyordun beni!Dialogue: 0,0:04:25.13,0:04:26.97,Main,,0,0,0,,Düşeceksin tabii!Dialogue: 0,0:04:27.15,0:04:30.25,Main,,0,0,0,,Sabahtan beri oradan oraya koşup...Dialogue: 0,0:04:30.25,0:04:35.23,Main,,0,0,0,,...bu sallantılı yerde hem kızını korumaya çalışıyor hem de savaşıyorsun!Dialogue: 0,0:04:35.61,0:04:37.84,Main,,0,0,0,,O tek bacağınla...Dialogue: 0,0:04:37.95,0:04:41.07,Main,,0,0,0,,...normal bir insan olsan çoktan kılını bile kıpırdatamaz hale gelirdin!Dialogue: 0,0:04:41.59,0:04:45.65,Main,,0,0,0,,Bacak sayımı endişe etmene gerek yok!Dialogue: 0,0:04:47.75,0:04:51.73,Main,,0,0,0,,Durumumu mazeret olarak kullanacak olsaydım burada olmazdım!Dialogue: 0,0:04:52.29,0:04:57.35,Main,,0,0,0,,Kayıp bacağımı borçlu olduğum birine adadım ve bundan oldukça gurur duyuyorum!Dialogue: 0,0:04:57.63,0:05:01.47,Main,,0,0,0,,Öyleyse ben de zayıf noktana saldırmaya başlayabilirim demektir!Dialogue: 0,0:05:02.07,0:05:08.73,Main,,0,0,0,,Ayakta bile zor duruyorsun bu halde seni öldürmek epey sıkıcı olacak!Dialogue: 0,0:05:09.87,0:05:12.33,Main,,0,0,0,,O yüzden bir oyun oynayalım diyorum!Dialogue: 0,0:05:17.16,0:05:20.37,Main,,0,0,0,,Son gösterinin vakti geldi!Dialogue: 0,0:05:26.21,0:05:27.15,Main,,0,0,0,,Bunlar...Dialogue: 0,0:05:27.61,0:05:28.75,Main,,0,0,0,,Konfeti mi?Dialogue: 0,0:05:28.97,0:05:30.07,Main,,0,0,0,,Evet!Dialogue: 0,0:05:30.19,0:05:35.09,Main,,0,0,0,,Konfeti gibi görünen o şeyler aslında dalgalanmaları için yaptığım bir şeyler.Dialogue: 0,0:05:35.97,0:05:39.01,Main,,0,0,0,,Şimdi gücümü üstlerinden kaldıracağım.Dialogue: 0,0:05:40.03,0:05:41.82,Main,,0,0,0,,Dalga Salınımı!Dialogue: 0,0:05:44.27,0:05:45.77,Main,,0,0,0,,Dikenli demir toplar!Dialogue: 0,0:05:46.21,0:05:51.53,Main,,0,0,0,,Yıldıztozu misali ne harikalar değil mi?Dialogue: 0,0:05:52.01,0:05:52.97,Main,,0,0,0,,Robin-san!Dialogue: 0,0:05:53.09,0:05:54.71,Main,,0,0,0,,Saklanacak bir yer yok gibi.Dialogue: 0,0:05:54.89,0:05:57.15,Main,,0,0,0,,Robiland, lütfen Rebecca'yı koru!Dialogue: 0,0:05:57.69,0:05:59.87,Main,,0,0,0,,Komutan-san, senin de başın belada!Dialogue: 0,0:06:00.11,0:06:02.19,Main,,0,0,0,,Bana bir şey olmaz!Dialogue: 0,0:06:02.91,0:06:06.39,Main,,0,0,0,,Fena mors oldun gibi. Neler olacağını biliyorsun.Dialogue: 0,0:06:06.95,0:06:12.15,Main,,0,0,0,,Evet, onlar koca orduları bile kurutmaya yarayan yıldıztozları!Dialogue: 0,0:06:12.15,0:06:15.33,Main,,0,0,0,,Hayatta kalmak çok ama çok zor olacak!Dialogue: 0,0:06:15.51,0:06:17.74,Main,,0,0,0,,İyi ki Ayçiçeği Tarlası'ndayız!Dialogue: 0,0:06:18.03,0:06:19.24,Main,,0,0,0,,Mil Fleur!Dialogue: 0,0:06:18.03,0:06:19.24,Note,,0,0,0,,Bin Çiçek!Dialogue: 0,0:06:23.19,0:06:25.55,Main,,0,0,0,,Ne de güzel açıyordunuz, özür dilerim!Dialogue: 0,0:06:29.99,0:06:31.96,Main,,0,0,0,,İstediğiniz kadar direnin!Dialogue: 0,0:06:33.33,0:06:34.57,Main,,0,0,0,,Güle güle!Dialogue: 0,0:06:34.81,0:06:37.27,Main,,0,0,0,,Death Enjambre!Dialogue: 0,0:06:34.83,0:06:37.27,Note,,0,0,0,,Ölüm Kümesi!Dialogue: 0,0:06:44.63,0:06:45.77,Main,,0,0,0,,Çiçek Şemsiyesi!Dialogue: 0,0:06:48.13,0:06:49.22,Main,,0,0,0,,Ucuz kurtulduk!Dialogue: 0,0:06:49.67,0:06:52.09,Main,,0,0,0,,Vay canına, epey iyi üstesinden geliyor.Dialogue: 0,0:06:52.21,0:06:53.23,Main,,0,0,0,,Nereye bakıyorsun?!Dialogue: 0,0:06:56.59,0:06:58.93,Main,,0,0,0,,Kyros!Dialogue: 0,0:06:59.05,0:07:03.77,Main,,0,0,0,,Böyle bir saldırıyla yok olacak orduya ordu demem ben!Dialogue: 0,0:07:03.95,0:07:05.99,Main,,0,0,0,,Çılgınlık bu!Dialogue: 0,0:07:06.19,0:07:09.33,Main,,0,0,0,,Tüm dikenli demir toplarını savuşturuyor!Dialogue: 0,0:07:10.87,0:07:14.43,Main,,0,0,0,,Yağmurda da ıslanmadan mı yürüyor bu herif?!Dialogue: 0,0:07:14.53,0:07:15.33,Main,,0,0,0,,Lanet olsun!Dialogue: 0,0:07:26.89,0:07:29.09,Main,,0,0,0,,Baba!Dialogue: 0,0:07:31.35,0:07:33.93,Main,,0,0,0,,Bastığın yere dikkat et, Kyros!Dialogue: 0,0:07:34.19,0:07:38.65,Main,,0,0,0,,Böyle bir anda tökezlemek ne aptallık ama!Dialogue: 0,0:07:38.79,0:07:41.74,Main,,0,0,0,,Lanet olası Diamante! Bunun hesabını vereceksin!Dialogue: 0,0:07:41.85,0:07:43.84,Main,,0,0,0,,Olmaz Rebecca, dikenli demir topları var!Dialogue: 0,0:07:45.75,0:07:47.57,Main,,0,0,0,,Baba!Dialogue: 0,0:07:47.67,0:07:48.67,Main,,0,0,0,,Hesabını vereceksin!Dialogue: 0,0:07:49.27,0:07:52.01,Main,,0,0,0,,Bunun hesabını vereceksin, Diamante!Dialogue: 0,0:07:53.59,0:07:57.35,Main,,0,0,0,,İyi dedin Rebecca, kes hesabımı!Dialogue: 0,0:07:57.49,0:08:00.67,Main,,0,0,0,,Savaş hadi! Seni bizzat kendi ellerimle geberteceğim!Dialogue: 0,0:08:00.89,0:08:02.85,Main,,0,0,0,,Aynı anneni geberttiğim gibi!Dialogue: 0,0:08:02.97,0:08:06.81,Main,,0,0,0,,Bırak beni Robin-san! Onu öldüreceğim...Dialogue: 0,0:08:12.63,0:08:16.15,Thoughts,,0,0,0,,Bu daha ne kadar sürecek? Çiçek Şemsiyesi daha fazla dayanamayacak!Dialogue: 0,0:08:19.67,0:08:22.77,Main,,0,0,0,,Diamante!Dialogue: 0,0:08:36.27,0:08:39.43,Main,,0,0,0,,Bu benim savaşım, Rebecca!Dialogue: 0,0:08:39.63,0:08:40.81,Main,,0,0,0,,Kılıcını...Dialogue: 0,0:08:41.81,0:08:43.29,Main,,0,0,0,,...indir!Dialogue: 0,0:08:45.77,0:08:49.85,Main,,0,0,0,,On yıl boyunca...Dialogue: 0,0:08:49.95,0:08:53.35,Main,,0,0,0,,Baba, şemsiyenin altına gir! Öleceksin!Dialogue: 0,0:08:53.53,0:08:57.49,Main,,0,0,0,,...annenin dileğini korudun!Dialogue: 0,0:08:59.31,0:09:02.13,Flashbacks,,0,0,0,,Annem kimseye zarar vermemem gerektiğini söyledi!Dialogue: 0,0:09:02.29,0:09:04.95,Flashbacks,,0,0,0,,Sana zarar görmemeyi öğreteceğim!Dialogue: 0,0:09:06.50,0:09:08.95,Flashbacks,,0,0,0,,Kimsenin kılına bile zarar vermeden...Dialogue: 0,0:09:09.07,0:09:11.79,Flashbacks,,0,0,0,,...tüm rakiplerini ring dışına çıkartarak kazanan...Dialogue: 0,0:09:11.91,0:09:13.71,Flashbacks,,0,0,0,,...yenilmez kadın!Dialogue: 0,0:09:15.35,0:09:18.41,Flashbacks,,0,0,0,,Kılıcını rakibine saplamadan ne saçma galibiyet o öyle?!Dialogue: 0,0:09:18.47,0:09:20.01,Flashbacks,,0,0,0,,Kan akıt, Rebecca!Dialogue: 0,0:09:20.15,0:09:22.13,Flashbacks,,0,0,0,,Korkak!Dialogue: 0,0:09:22.77,0:09:27.90,Flashbacks,,0,0,0,,O rezil maçla gladyatörlerin adını lekeledin!Dialogue: 0,0:09:29.16,0:09:30.98,Flashbacks,,0,0,0,,Geber Rebecca!Dialogue: 0,0:09:31.09,0:09:33.03,Flashbacks,,0,0,0,,Bozuk ailenin tohumu!Dialogue: 0,0:09:33.19,0:09:35.29,Flashbacks,,0,0,0,,Kanı bozuk yosma!Dialogue: 0,0:09:39.33,0:09:43.82,Main,,0,0,0,,Kolezyum'da savaşmana rağmen kimseye zarar vermedin!Dialogue: 0,0:09:46.17,0:09:49.44,Main,,0,0,0,,Ellerin hâlâ temiz!Dialogue: 0,0:09:49.97,0:09:51.51,Main,,0,0,0,,Annen Scarlet'in ruhu...Dialogue: 0,0:09:53.85,0:09:56.63,Main,,0,0,0,,...o ellerde yaşıyor!Dialogue: 0,0:10:02.67,0:10:03.99,Thoughts,,0,0,0,,Anne...Dialogue: 0,0:10:05.75,0:10:11.39,Main,,0,0,0,,Bunca yıl dayandıktan sonra o elleri bu şeytanın kanıyla kirletmene gerek yok!Dialogue: 0,0:10:18.45,0:10:19.51,Main,,0,0,0,,Rebecca!Dialogue: 0,0:10:20.49,0:10:23.49,Main,,0,0,0,,Bir daha kılıç tutmana izin vermeyeceğim!Dialogue: 0,0:10:41.23,0:10:42.99,Main,,0,0,0,,Kyros!Dialogue: 0,0:10:43.43,0:10:47.19,Main,,0,0,0,,Vücudun demirden mi yapılma ha?!Dialogue: 0,0:10:51.50,0:10:56.54,Main,,0,0,0,,Hayır, çığlık attıracak kadar acı veriyor olmalılar...Dialogue: 0,0:11:03.65,0:11:04.79,Main,,0,0,0,,Çektiğim acı...Dialogue: 0,0:11:06.50,0:11:09.48,Main,,0,0,0,,Çektiğim acı insan olduğumun bir kanıtıdır!Dialogue: 0,0:11:09.90,0:11:12.70,Main,,0,0,0,,Sizin asla anlamayacağınız bir şey bu!Dialogue: 0,0:11:15.56,0:11:20.00,Main,,0,0,0,,Sevdiğin biri tarafından unutulmanın verdiği acıyı bilemezsiniz!Dialogue: 0,0:11:21.80,0:11:23.00,Flashbacks,,0,0,0,,Scarlet!Dialogue: 0,0:11:24.00,0:11:28.90,Flashbacks,,0,0,0,,Neden? Neden beni beklemedin?!Dialogue: 0,0:11:30.80,0:11:33.10,Flashbacks,,0,0,0,,Şimdi anlıyorum...Dialogue: 0,0:11:33.82,0:11:36.40,Flashbacks,,0,0,0,,Senin de aklından kaybolup gittim demek?!Dialogue: 0,0:11:37.34,0:11:40.94,Flashbacks,,0,0,0,,Verilen sözler, yaşananlar, hepsi!Dialogue: 0,0:11:44.34,0:11:46.70,Flashbacks,,0,0,0,,Kimsin bilmiyorum ama...Dialogue: 0,0:11:46.70,0:11:49.00,Flashbacks,,0,0,0,,Benim! Kyros!Dialogue: 0,0:11:49.48,0:11:51.17,Flashbacks,,0,0,0,,Lütfen...Dialogue: 0,0:11:55.60,0:12:01.72,Flashbacks,,0,0,0,,Bu lanet teneke kollarla son nefesini verirken sıcaklığını bile hissedemiyorum!Dialogue: 0,0:12:13.58,0:12:15.60,Main,,0,0,0,,Dokunduğun şeyi...Dialogue: 0,0:12:16.03,0:12:20.26,Main,,0,0,0,,...hissedememenin verdiği ıstırabı siz anlamazsınız!Dialogue: 0,0:12:20.38,0:12:25.16,Main,,0,0,0,,Dressrosa'nın yaşadığı felakete kıyasla bu çektiğim...Dialogue: 0,0:12:26.02,0:12:28.84,Main,,0,0,0,,...acıdan bile sayılmaz!Dialogue: 0,0:12:32.70,0:12:34.54,Main,,0,0,0,,Vücudun demirden mi diye sormuştun!Dialogue: 0,0:12:35.98,0:12:41.12,Main,,0,0,0,,Evet, bu ülkenin demirden nefreti olarak...Dialogue: 0,0:12:43.97,0:12:45.70,Main,,0,0,0,,...sizi yok edeceğim!Dialogue: 0,0:12:49.76,0:12:52.42,Thoughts,,0,0,0,,Nasıl bir güçtür bu?!Dialogue: 0,0:12:53.20,0:12:59.36,Thoughts,,0,0,0,,Şanın 20 yıl geride kaldı be!Dialogue: 0,0:13:02.12,0:13:06.02,Main,,0,0,0,,Kılıç kullanma yeteneklerimi hafife alma!Dialogue: 0,0:13:09.78,0:13:13.40,Main,,0,0,0,,Düşüp gebermemekte ısrar ediyorsun demek, canavar seni!Dialogue: 0,0:13:24.76,0:13:27.60,Main,,0,0,0,,Şansa demir toplar da durdu.Dialogue: 0,0:13:29.82,0:13:34.54,Main,,0,0,0,,Aynı o çok sevdiğiniz Scarlet gibi...Dialogue: 0,0:13:34.68,0:13:39.84,Main,,0,0,0,,...sonun doğrudan benim elimden olacak!Dialogue: 0,0:13:50.70,0:13:53.17,Main,,0,0,0,,Bu Diamante ne alçak biri!Dialogue: 0,0:13:53.74,0:13:55.60,Main,,0,0,0,,Yine ablamdan bahsediyor!Dialogue: 0,0:13:57.06,0:13:59.20,Main,,0,0,0,,Lanet olası Diamante!Dialogue: 0,0:14:01.54,0:14:04.08,Flashbacks,,0,0,0,,Bağışlayın, Kral Riku-sama!Dialogue: 0,0:14:04.62,0:14:09.56,Flashbacks,,0,0,0,,Arayışımız hüsranla sonuçlandı. Diamante denen adam bizden hızlı davranmış.Dialogue: 0,0:14:10.01,0:14:13.40,Flashbacks,,0,0,0,,Scarlet-sama'yı şehirde...Dialogue: 0,0:14:13.94,0:14:15.26,Flashbacks,,0,0,0,,...vurulmuş olarak bulduk!Dialogue: 0,0:14:19.52,0:14:20.90,Flashbacks,,0,0,0,,Ablamı sen mi öldürdün?!Dialogue: 0,0:14:21.12,0:14:24.36,Flashbacks,,0,0,0,,Evet, ablandı değil mi?!Dialogue: 0,0:14:24.76,0:14:28.30,Flashbacks,,0,0,0,,Marketten yiyecek bir şeyler alıyordu.Dialogue: 0,0:14:28.54,0:14:33.83,Flashbacks,,0,0,0,,Açlığına dayanabilseydi ölmek zorunda kalmayacaktı. Aptal şey işte!Dialogue: 0,0:14:35.18,0:14:37.02,Flashbacks,,0,0,0,,Bırak beni, Tank!Dialogue: 0,0:14:37.26,0:14:40.59,Flashbacks,,0,0,0,,Lütfen aceleci davranmayın!Dialogue: 0,0:14:40.68,0:14:42.72,Flashbacks,,0,0,0,,Dayanamayacağım artık!Dialogue: 0,0:14:42.86,0:14:45.56,Flashbacks,,0,0,0,,Biz de sarayda kalacak...Dialogue: 0,0:14:45.88,0:14:48.36,Flashbacks,,0,0,0,,...ve sizi koruyacağız!Dialogue: 0,0:15:04.82,0:15:06.74,Main,,0,0,0,,Diamante!Dialogue: 0,0:15:06.88,0:15:10.84,Main,,0,0,0,,Saldırım yeri yırtıp geçecek!Dialogue: 0,0:15:14.54,0:15:16.52,Main,,0,0,0,,Al sana! Al sana!Dialogue: 0,0:15:16.60,0:15:18.14,Main,,0,0,0,,Al sana!Dialogue: 0,0:15:20.04,0:15:22.08,Main,,0,0,0,,Umarım kalan yaralı son bacağınla...Dialogue: 0,0:15:22.18,0:15:24.52,Main,,0,0,0,,...bu saldırımdan kaçabilirsin!Dialogue: 0,0:15:26.26,0:15:28.44,Main,,0,0,0,,Kaçmak gibi bir niyetim yok!Dialogue: 0,0:15:28.80,0:15:33.22,Main,,0,0,0,,Kaçmayacaksan aptalın tekisin demektir!Dialogue: 0,0:15:33.38,0:15:35.30,Main,,0,0,0,,Barışı geri kazanacağım!Dialogue: 0,0:15:35.40,0:15:39.58,Main,,0,0,0,,Yarım Ay Kılıcı!Dialogue: 0,0:15:42.50,0:15:43.76,Main,,0,0,0,,Trueno...Dialogue: 0,0:15:42.50,0:15:43.76,Note,,0,0,0,,Yıkıcı...Dialogue: 0,0:15:46.24,0:15:48.28,Main,,0,0,0,,Bastardo!Dialogue: 0,0:15:46.24,0:15:48.28,Note,,0,0,0,,...Gök Gürültüsü Kılıcı!Dialogue: 0,0:16:38.63,0:16:41.76,Thoughts,,0,0,0,,Teşekkür ederim, Robiland!Dialogue: 0,0:17:09.38,0:17:10.60,Main,,0,0,0,,Baba!Dialogue: 0,0:17:14.12,0:17:16.48,Main,,0,0,0,,Baba, hemen tedavi görmen lazım!Dialogue: 0,0:17:23.60,0:17:29.48,Flashbacks,,0,0,0,,Anneni koruyamamış olsam bile seni hayatım pahasına koruyacağım!Dialogue: 0,0:17:30.44,0:17:36.66,Flashbacks,,0,0,0,,Mutlu olacağın o güne dek hep yanında olacağım!Dialogue: 0,0:17:57.85,0:18:00.22,Main,,0,0,0,,Diamante'yi yendi!Dialogue: 0,0:18:05.37,0:18:08.30,Main,,0,0,0,,Diamante'yi yendi ha?Dialogue: 0,0:18:18.44,0:18:20.98,Main,,0,0,0,,Gerçekten mi, Viola-sama?!Dialogue: 0,0:18:21.18,0:18:24.56,Main,,0,0,0,,Evet... Kyros ağabey kazandı!Dialogue: 0,0:18:24.90,0:18:26.34,Main,,0,0,0,,Rebecca da gayet iyi.Dialogue: 0,0:18:27.29,0:18:29.66,Main,,0,0,0,,Nico Robin onu korudu...Dialogue: 0,0:18:32.02,0:18:35.62,Main,,0,0,0,,Donquixote Ailesi'nin üst düzey yöneticisini yendiğine inanamıyorum!Dialogue: 0,0:18:36.17,0:18:38.92,Main,,0,0,0,,Kolezyum kahramanını yendi...Dialogue: 0,0:18:39.08,0:18:40.26,Main,,0,0,0,,Ne saçmalıyorsun sen?!Dialogue: 0,0:18:40.70,0:18:44.96,Main,,0,0,0,,Asıl yenilmez Kolezyum kahramanı Kyros'du!Dialogue: 0,0:18:47.56,0:18:50.60,Main,,0,0,0,,Kimselerin yenemeyeceğini düşündüğümüz Donquixote Ailesi...Dialogue: 0,0:18:50.96,0:18:52.88,Main,,0,0,0,,...bir bir yeniliyor!Dialogue: 0,0:18:59.62,0:19:00.73,Main,,0,0,0,,Kyros.Dialogue: 0,0:19:02.53,0:19:04.82,Main,,0,0,0,,Komutan Kyros!Dialogue: 0,0:19:13.54,0:19:16.31,Main,,0,0,0,,Fabrikadaki Senyor Pink'le başlayarak...Dialogue: 0,0:19:17.19,0:19:23.20,Main,,0,0,0,,...diğer yöneticiler de, Hasır Şapkalı Luffy'le birlik olmuş savaşçılar tarafından yenildiler.Dialogue: 0,0:19:25.24,0:19:29.03,Main,,0,0,0,,Donquixote Ailesi'nden geriye dört kişi kaldı!Dialogue: 0,0:19:29.97,0:19:31.88,Main,,0,0,0,,Sırtlan Bellamy ve...Dialogue: 0,0:19:32.30,0:19:36.10,Main,,0,0,0,,...iki üst düzey yönetici, Pica ve Trebol!Dialogue: 0,0:19:36.18,0:19:37.10,Main,,0,0,0,,Son olarak da...Dialogue: 0,0:19:38.32,0:19:42.58,Main,,0,0,0,,...mevcut kral, Shichibukai Doflamingo!Dialogue: 0,0:19:43.76,0:19:46.80,Main,,0,0,0,,Geriye yalnızca bu dördü kaldı!Dialogue: 0,0:19:51.00,0:19:52.94,Main,,0,0,0,,Durumu bu hale getirebileceklerini kim düşünürdü?!Dialogue: 0,0:19:53.22,0:19:55.38,Main,,0,0,0,,Hasır Şapka tayfası harika!Dialogue: 0,0:19:55.54,0:19:59.95,Main,,0,0,0,,Onları öldürmeye yeltenip kendimizi kurtarmaya çalıştığımıza inanamıyorum!Dialogue: 0,0:20:00.06,0:20:04.06,Main,,0,0,0,,Herkes hata yapar!Dialogue: 0,0:20:04.20,0:20:07.64,Main,,0,0,0,,Hatanızı anladığınız sürece sorun yok! Sizi affediyorum!Dialogue: 0,0:20:11.02,0:20:13.60,Main,,0,0,0,,İhtiyar Kral Riku, nereye gidiyorsun?Dialogue: 0,0:20:14.30,0:20:16.98,Main,,0,0,0,,Artık kimsenin beni öldürmeye çalışacağını sanmıyorum.Dialogue: 0,0:20:17.66,0:20:18.81,Main,,0,0,0,,Şehre iniyorum.Dialogue: 0,0:20:19.61,0:20:21.69,Main,,0,0,0,,Eminim yapabileceğim bir şeyler vardır.Dialogue: 0,0:20:22.96,0:20:24.76,Main,,0,0,0,,Ben de geliyorum!Dialogue: 0,0:20:25.13,0:20:28.09,Main,,0,0,0,,Hükümet yahut Donanma'ya güvenmek istemiyorum!Dialogue: 0,0:20:29.46,0:20:31.00,Main,,0,0,0,,Herkes umutsuz.Dialogue: 0,0:20:31.44,0:20:35.56,Main,,0,0,0,,Bu kuş kafesinden, bu ölüm oyunundan kaçamayacaklarını düşünüyorlar!Dialogue: 0,0:20:36.30,0:20:37.74,Main,,0,0,0,,Biz de gidelim!Dialogue: 0,0:20:39.38,0:20:43.02,Main,,0,0,0,,Şehirdeki herkese umudun tükenmediğini anlatalım!Dialogue: 0,0:20:47.94,0:20:51.36,Main,,0,0,0,,Rüzgar sonunda bizden yana esmeye başladı gibi.Dialogue: 0,0:20:55.06,0:20:58.40,Main,,0,0,0,,Şu donanma amirali nereye gitti?Dialogue: 0,0:20:58.66,0:21:00.72,Main,,0,0,0,,Fark etmedin mi?Dialogue: 0,0:21:01.02,0:21:03.74,Main,,0,0,0,,Bir süre önce aşağı indi.Dialogue: 0,0:21:04.30,0:21:08.70,Main,,0,0,0,,Tüm halkı savunması kolay...Dialogue: 0,0:21:09.26,0:21:13.86,Main,,0,0,0,,...bir yerde toplayın.Dialogue: 0,0:21:14.00,0:21:14.76,Main,,0,0,0,,Emredersiniz!Dialogue: 0,0:21:19.65,0:21:22.20,Captions,,0,0,290,,Kral TepesiDialogue: 0,0:21:19.15,0:21:20.30,Main,,0,0,650,,Orası...Dialogue: 0,0:21:23.25,0:21:24.69,Main,,0,0,0,,Adi!Dialogue: 0,0:21:27.22,0:21:30.85,Captions,,0,900,300,,4. Seviye                Ayçiçeği TarlasıDialogue: 0,0:21:28.80,0:21:31.03,Main,,0,0,0,,Baba, yer titriyor!Dialogue: 0,0:21:36.81,0:21:37.81,Main,,0,0,0,,Rebecca!Dialogue: 0,0:21:39.57,0:21:40.59,Main,,0,0,0,,Bu...Dialogue: 0,0:21:40.99,0:21:44.03,Main,,0,0,0,,Zoro'nun uzak tuttuğu Pica!Dialogue: 0,0:21:54.07,0:21:55.77,Main,,0,0,0,,Diamante...Dialogue: 0,0:21:56.25,0:22:00.57,Main,,0,0,0,,Ailenin üst düzey yöneticisine hiç yakışmayan bir haldesin!Dialogue: 0,0:22:11.91,0:22:12.83,Main,,0,0,0,,Baba!Dialogue: 0,0:22:14.89,0:22:16.16,Main,,0,0,0,,Biliyorum.Dialogue: 0,0:22:16.89,0:22:20.59,Main,,0,0,0,,Buraya birebir kozlarımızı paylaşmaya gelmedik.Dialogue: 0,0:22:21.34,0:22:24.13,Main,,0,0,0,,Düşman var olduğu müddetçe savaşın da sonu gelmeyecek!Dialogue: 0,0:22:26.47,0:22:28.94,Main,,0,0,0,,Zorlama kendini, baba! Hareket edecek halin kalmadı!Dialogue: 0,0:22:29.03,0:22:30.49,Main,,0,0,0,,Geri çekil, Rebecca!Dialogue: 0,0:22:31.47,0:22:32.59,Main,,0,0,0,,Şunu cevaplayın öyleyse.Dialogue: 0,0:22:33.41,0:22:36.75,Main,,0,0,0,,Kral Riku sizin için ne ifade ediyor?Dialogue: 0,0:22:37.07,0:22:42.39,Main,,0,0,0,,Rebecca... Onun yüzünden sana defalarca lanet okundu.Dialogue: 0,0:22:44.03,0:22:45.93,Main,,0,0,0,,O olmasaydı...Dialogue: 0,0:22:46.05,0:22:49.13,Main,,0,0,0,,Hadi oradan! Komplo kurdunuz ona!Dialogue: 0,0:22:49.72,0:22:53.23,Main,,0,0,0,,Kral Riku-sama benim için bir baba...Dialogue: 0,0:22:53.63,0:22:56.35,Main,,0,0,0,,...gençken kötü biri olan kendim için bir kurtarıcıdır!Dialogue: 0,0:22:57.55,0:23:03.39,Main,,0,0,0,,Kral Riku Ailesi tüm dünyada gerçek barışın anlamını bilen muhterem yegâne ailedir!Dialogue: 0,0:23:07.47,0:23:10.80,Main,,0,0,0,,Göğün alabildiğine mavi, çiçeklerin gurur içinde açtığı...Dialogue: 0,0:23:10.80,0:23:13.80,Main,,0,0,0,,...nazik kalplerle dolu bir ülke!Dialogue: 0,0:23:14.60,0:23:17.00,Main,,0,0,0,,Dressrosa böyle bir yerdi işte!Dialogue: 0,0:23:20.13,0:23:26.21,Main,,0,0,0,,Sizi defedip tahta onu oturtmak tüm ülkenin tek dileği!Dialogue: 0,0:23:27.66,0:23:28.98,Main,,0,0,0,,Anlaşılmıştır!Dialogue: 0,0:23:31.87,0:23:34.00,Main,,0,0,0,,Ne? Kayboldu...Dialogue: 0,0:23:35.92,0:23:37.49,Main,,0,0,0,,Çarliston!Dialogue: 0,0:23:41.30,0:23:44.02,Main,,0,0,0,,Bu neydi be, ödüm patladı!Dialogue: 0,0:23:44.36,0:23:46.14,Main,,0,0,0,,Üçüncü seviyeye indi!Dialogue: 0,0:23:46.04,0:23:51.70,Captions,,950,0,620,,2. SeviyeDialogue: 0,0:23:48.18,0:23:51.90,Main,,0,0,0,,Lanet olası, rakibi bendim!Dialogue: 0,0:23:52.02,0:23:53.36,Main,,0,0,0,,Savaşmak istemiyor mu?!Dialogue: 0,0:24:00.16,0:24:04.70,Main,,0,0,0,,Her halükarda, böyle hareket etmeye devam ederse ona asla ulaşamayacağım!Dialogue: 0,0:24:04.90,0:24:07.64,Main,,0,0,0,,Ulaşabileceğim bir yerlere geldiğinde ölmeye hazırlansan iyi edersin!Dialogue: 0,0:24:07.88,0:24:09.20,Main,,0,0,0,,Çarliston!Dialogue: 0,0:24:10.86,0:24:12.94,Main,,0,0,0,,Pica-sama, durun lütfen!Dialogue: 0,0:24:13.26,0:24:14.08,Main,,0,0,0,,Pica-sama!Dialogue: 0,0:24:14.18,0:24:15.28,Main,,0,0,0,,Kurtar bizi!Dialogue: 0,0:24:22.54,0:24:24.72,Main,,0,0,0,,Yaralılara zarar veriyor!Dialogue: 0,0:24:25.52,0:24:28.00,Main,,0,0,0,,Bize ihanet ettin, Baby 5!Dialogue: 0,0:24:28.14,0:24:29.08,Main,,0,0,0,,Taş Mengene!Dialogue: 0,0:24:29.24,0:24:30.26,Main,,0,0,0,,Dikkat et!Dialogue: 0,0:24:34.72,0:24:35.46,Main,,0,0,0,,Sai!Dialogue: 0,0:24:35.58,0:24:37.08,Main,,0,0,0,,Çarliston!Dialogue: 0,0:24:45.62,0:24:47.48,Main,,0,0,0,,Şerefsiz!Dialogue: 0,0:24:49.38,0:24:50.82,Main,,0,0,0,,Lanet olası taş bozuntusu!Dialogue: 0,0:24:51.00,0:24:54.74,Main,,0,0,0,,Yeter artık be! Yaralılara dokunma!Dialogue: 0,0:24:54.86,0:24:56.03,Main,,0,0,0,,Roronoa.Dialogue: 0,0:24:56.66,0:24:58.00,Main,,0,0,0,,Isırma Taşı!Dialogue: 0,0:24:58.08,0:25:00.50,Main,,0,0,0,,Tek-Kılıç Stili... Şeytan At!Dialogue: 0,0:25:01.60,0:25:03.86,Main,,0,0,0,,Roronoa Zoro...Dialogue: 0,0:25:04.06,0:25:07.88,Main,,0,0,0,,Kral Tepesinde kim var biliyor musun?Dialogue: 0,0:25:08.40,0:25:09.86,Main,,0,0,0,,Ülkenin kralı var!Dialogue: 0,0:25:10.02,0:25:11.00,Main,,0,0,0,,"Eski" kral!Dialogue: 0,0:25:11.62,0:25:13.40,Main,,0,0,0,,Ne demeye çalışıyorsun?!Dialogue: 0,0:25:15.70,0:25:17.91,Main,,0,0,0,,Kral Tepesi'nde...Dialogue: 0,0:25:18.02,0:25:21.21,Main,,0,0,0,,...ülkenin eski üst rütbeli görevlilerinin yanısıra...Dialogue: 0,0:25:21.34,0:25:24.36,Main,,0,0,0,,...samuraylar ve Tanrı Usopp da var.Dialogue: 0,0:25:24.92,0:25:30.30,Main,,0,0,0,,Tüm ülke Kral Riku'nun yeniden tahta gelmesini istiyormuş.Dialogue: 0,0:25:30.50,0:25:31.84,Main,,0,0,0,,Ne olmuş yani?!Dialogue: 0,0:25:32.12,0:25:36.74,Main,,0,0,0,,Bu durum sinirlerimi bozuyor. Doffy'den başka kral yok!Dialogue: 0,0:25:49.20,0:25:50.30,Main,,0,0,0,,Bu da ne?!Dialogue: 0,0:26:02.16,0:26:03.46,Main,,0,0,0,,Kahrolası...Dialogue: 0,0:26:19.56,0:26:21.70,Main,,0,0,0,,Gene hareket etmeye başladı!Dialogue: 0,0:26:21.80,0:26:23.62,Main,,0,0,0,,Ne yapmayı planlıyor?!Dialogue: 0,0:26:30.92,0:26:34.06,Main,,0,0,0,,Burası Donquixote'nin ülkesi!Dialogue: 0,0:26:38.53,0:26:39.78,Main,,0,0,0,,Yürüyor!Dialogue: 0,0:26:39.92,0:26:41.60,Main,,0,0,0,,Kaçın!Dialogue: 0,0:26:42.00,0:26:45.44,Main,,0,0,0,,Heykel kareket etmeye başladı! Kaçın! Kaçın!Dialogue: 0,0:26:58.52,0:27:00.02,Main,,0,0,0,,Yoksa o...Dialogue: 0,0:27:04.62,0:27:06.06,Main,,0,0,0,,Lanet olası...Dialogue: 0,0:27:06.74,0:27:08.50,Main,,0,0,0,,Kralı mı öldürecek?!Dialogue: 0,0:27:12.86,0:27:14.02,Main,,0,0,0,,Adi herif!Dialogue: 0,0:27:14.48,0:27:17.32,Main,,0,0,0,,Beni o yüzden bu kadar uzağa sürdü demek!Dialogue: 0,0:27:18.84,0:27:20.36,Main,,0,0,0,,Yetişemiyorum!Dialogue: 0,0:27:24.26,0:27:27.72,Main,,0,0,0,,Fena oyuna geldim! Durum hiç iyi görünmüyor.Dialogue: 0,0:27:29.82,0:27:33.54,Main,,0,0,0,,Kral Tepesi'ni yıkmak için tek bir yumruğu yeterli!Dialogue: 0,0:27:34.52,0:27:37.24,Main,,0,0,0,,Usopp da kral da ezilip tarihe karışacak!Dialogue: 0,0:27:37.38,0:27:39.08,Main,,0,0,0,,Bunu engellemenin bir yolu yok mu?!Dialogue: 0,0:27:39.08,0:27:40.50,Main,,0,0,0,,Korsan Avcısı!Dialogue: 0,0:27:40.90,0:27:43.50,Main,,0,0,0,,Pica-sama'nın yoluna çıkmana izin vermeyiz!Dialogue: 0,0:27:47.50,0:27:49.00,Main,,0,0,0,,Amma can sıktınız!Dialogue: 0,0:27:51.10,0:27:51.87,Main,,0,0,0,,Zoro!Dialogue: 0,0:27:52.12,0:27:53.14,Main,,0,0,0,,Eyvah!Dialogue: 0,0:27:54.52,0:27:56.22,Main,,0,0,0,,Gitmesine izin verirsek...Dialogue: 0,0:28:00.96,0:28:02.04,Main,,0,0,0,,Dede...Dialogue: 0,0:28:02.18,0:28:03.12,Main,,0,0,0,,Usopp!Dialogue: 0,0:28:07.08,0:28:09.12,Main,,0,0,0,,Oha şuna bak!Dialogue: 0,0:28:12.20,0:28:14.81,Captions,,0,0,0,,PLAN 1Dialogue: 0,0:28:13.66,0:28:15.02,Thoughts,,0,0,0,,Bir numaralı plan,...Dialogue: 0,0:28:14.81,0:28:14.85,Captions,,0,0,0,,PLAN 1Dialogue: 0,0:28:14.85,0:28:14.89,Captions,,0,0,0,,PLAN 1Dialogue: 0,0:28:14.89,0:28:14.93,Captions,,0,0,0,,PLAN 1Dialogue: 0,0:28:14.89,0:28:14.93,Captions,,0,0,0,,UZUN MESAFEDEN KESMEDialogue: 0,0:28:14.93,0:28:14.97,Captions,,0,0,0,,PLAN 1Dialogue: 0,0:28:14.93,0:28:14.97,Captions,,0,0,0,,UZUN MESAFEDEN KESMEDialogue: 0,0:28:14.97,0:28:15.01,Captions,,0,0,0,,PLAN 1Dialogue: 0,0:28:14.97,0:28:15.01,Captions,,0,0,0,,UZUN MESAFEDEN KESMEDialogue: 0,0:28:15.01,0:28:15.06,Captions,,0,0,0,,PLAN 1Dialogue: 0,0:28:15.01,0:28:15.06,Captions,,0,0,0,,UZUN MESAFEDEN KESMEDialogue: 0,0:28:15.06,0:28:15.10,Captions,,0,0,0,,PLAN 1Dialogue: 0,0:28:15.06,0:28:15.10,Captions,,0,0,0,,UZUN MESAFEDEN KESMEDialogue: 0,0:28:15.10,0:28:15.14,Captions,,0,0,0,,PLAN 1Dialogue: 0,0:2