Dialogue: 0,0:01:42.68,0:01:45.35,Title,,0,0,240,,{\fad(300,300)}Elbaf'ın Mızrağı ve Don Sai
Dialogue: 0,0:01:45.68,0:01:46.82,Main,,0,0,0,,Kes şunu Bellamy!
Dialogue: 0,0:01:46.92,0:01:48.26,Main,,0,0,0,,Kapa çeneni!
Dialogue: 0,0:01:48.40,0:01:49.34,Main,,0,0,0,,İşleri...
Dialogue: 0,0:01:49.54,0:01:52.40,Main,,0,0,0,,İşleri böyle yoluna koyarım ben!
Dialogue: 0,0:01:54.90,0:01:57.96,Main,,0,0,0,,Böyle bir savaşı kabul etmem için\Nbir neden yok!
Dialogue: 0,0:01:58.44,0:01:59.50,Main,,0,0,0,,Ama...
Dialogue: 0,0:02:00.18,0:02:03.00,Main,,0,0,0,,Savaşmak için nedeninin olmayışı da\Nuyar bana!
Dialogue: 0,0:02:03.32,0:02:05.42,Main,,0,0,0,,Kıpırdamadan dur orada!
Dialogue: 0,0:02:08.42,0:02:10.62,Main,,0,0,0,,Kararlılığımın...
Dialogue: 0,0:02:12.98,0:02:16.60,Main,,0,0,0,,...yetersiz olduğunu düşünüyorsan tabii!
Dialogue: 0,0:02:22.76,0:02:23.56,Main,,0,0,0,,Lanet olsun!
Dialogue: 0,0:02:23.96,0:02:26.13,Captions,,835,0,315,,{\fad(250,250)}Pica Heykeli
Dialogue: 0,0:02:38.64,0:02:40.26,Main,,0,0,0,,Öleceğim sandım!
Dialogue: 0,0:02:40.31,0:02:44.58,Captions,,0,0,170,,{\fad(523,0)}Kraliyet Sarayı Tepesi - 2. Seviye
Dialogue: 0,0:02:48.62,0:02:49.88,Main,,0,0,0,,Yaşıyor!
Dialogue: 0,0:02:50.36,0:02:51.76,Main,,0,0,0,,Pica-sama!
Dialogue: 0,0:02:53.94,0:02:56.58,Main,,0,0,0,,Epey inatçı bir taş çıktı!
Dialogue: 0,0:02:57.86,0:03:03.66,Main,,0,0,0,,Gücümü öğrendin diye\Nbeni yenebileceğini mi sanıyorsun?!
Dialogue: 0,0:03:04.00,0:03:07.06,Main,,0,0,0,,Ne aptalsın!
Dialogue: 0,0:03:09.14,0:03:09.96,Main,,0,0,0,,Bekle!
Dialogue: 0,0:03:11.06,0:03:12.30,Main,,0,0,0,,Öldürün!
Dialogue: 0,0:03:12.48,0:03:13.96,Main,,0,0,0,,Kıpırdama Korsan Avcısı!
Dialogue: 0,0:03:14.20,0:03:15.84,Main,,0,0,0,,Buradan öte geçemezsin!
Dialogue: 0,0:03:16.58,0:03:18.47,Main,,0,0,0,,Bir siz eksiktiniz!
Dialogue: 0,0:03:27.48,0:03:29.81,Main,,0,0,0,,{\fad(150,150)}Komodor Görkemi!
Dialogue: 0,0:03:33.10,0:03:35.23,Main,,0,0,0,,Haz'rol!
Dialogue: 0,0:03:38.38,0:03:40.58,Main,,0,0,0,,Yapma!
Dialogue: 0,0:03:41.44,0:03:45.70,Main,,0,0,0,,Yapma! Yapma!\NYapma lütfen!
Dialogue: 0,0:03:46.17,0:03:48.57,Main,,0,0,0,,Neden dizildik ki böyle?!
Dialogue: 0,0:03:49.18,0:03:53.14,Main,,0,0,0,,{\fad(150,150)}Öldürücü Bowling!
Dialogue: 0,0:04:00.46,0:04:01.50,Main,,0,0,0,,Hiç fena değil!
Dialogue: 0,0:04:01.60,0:04:02.50,Main,,0,0,0,,Devam edebilirsin!
Dialogue: 0,0:04:02.60,0:04:04.70,Main,,0,0,0,,Sağ ol! Kolezyumdandın değil mi sen?
Dialogue: 0,0:04:04.94,0:04:07.51,Main,,0,0,0,,Evet! Adım Orlumbus!
Dialogue: 0,0:04:07.68,0:04:13.60,Main,,0,0,0,,Denizde olsaydık filom Yontamaria'yla\Nsana destek olurdum.
Dialogue: 0,0:04:13.68,0:04:17.60,Main,,0,0,0,,Ama şu anda adam eksiğim var!\NO taş canavar sana emanet!
Dialogue: 0,0:04:17.70,0:04:18.38,Main,,0,0,0,,Tamamdır!
Dialogue: 0,0:04:19.94,0:04:21.94,Main,,0,0,0,,Nereye gitti bu!?
Dialogue: 0,0:04:24.44,0:04:25.76,Main,,0,0,0,,Duvarda yüz var!
Dialogue: 0,0:04:27.20,0:04:30.18,Main,,0,0,0,,Pica-sama tepeyi ele geçirdi!
Dialogue: 0,0:04:36.66,0:04:37.74,Main,,0,0,0,,Bakalım saldırılarımdan şimdi\Nnasıl kaçacaksın!?
Dialogue: 0,0:04:37.74,0:04:39.62,Secondary,,0,0,0,,Bakalım saldırılarımdan şimdi\Nnasıl kaçacaksın!?
Dialogue: 0,0:04:37.74,0:04:39.62,Main,,0,0,0,,Gülme sesi miydi o?!
Dialogue: 0,0:04:41.66,0:04:44.19,Main,,0,0,0,,Öyle gülüyorsam ne olmuş yani?!
Dialogue: 0,0:04:44.32,0:04:46.48,Main,,0,0,0,,Kulağa çok malca geldiğinden şaşırdım!
Dialogue: 0,0:04:47.48,0:04:49.42,Main,,0,0,0,,Asıl mal sensin, Korsan Avcısı!
Dialogue: 0,0:04:49.50,0:04:51.68,Main,,0,0,0,,Pica-sama'yı kızdırmasana!
Dialogue: 0,0:04:52.40,0:04:54.04,Main,,0,0,0,,{\fad(150,150)}Çarliston!
Dialogue: 0,0:05:10.98,0:05:13.26,Main,,0,0,0,,Böyle devasa olman hoşuma gitti!
Dialogue: 0,0:05:13.74,0:05:17.34,Main,,0,0,0,,Seni kesmek\Ndaha büyük bir zevk verecek!
Dialogue: 0,0:05:22.74,0:05:24.26,Main,,0,0,0,,Dikkat et, Pica!
Dialogue: 0,0:05:24.96,0:05:27.60,Main,,0,0,0,,Biz de savaşıyoruz burada herhâlde!
Dialogue: 0,0:05:27.78,0:05:29.26,Main,,0,0,0,,{\fad(150,150)}Yıkıcı Top!
Dialogue: 0,0:05:35.12,0:05:37.16,Main,,0,0,0,,Nereye bakıyorsun?!
Dialogue: 0,0:05:43.86,0:05:45.37,Main,,0,0,0,,Düşman olduğumuz için mi?!
Dialogue: 0,0:05:46.56,0:05:48.78,Main,,0,0,0,,Doğrudan söylesene!
Dialogue: 0,0:05:49.26,0:05:51.49,Main,,0,0,0,,Neden bahsediyorsun sen?!
Dialogue: 0,0:05:51.70,0:05:53.31,Main,,0,0,0,,Bilmiyormuş gibi yapma!
Dialogue: 0,0:05:56.62,0:06:00.14,Flashbacks,,0,0,0,,{\i1}Kalbini delip geçeceğim!{\i0}
Dialogue: 0,0:06:00.75,0:06:02.96,Main,,0,0,0,,Kalbimi gelip çalacağını söyledin...
Dialogue: 0,0:06:05.68,0:06:07.98,Flashbacks,,0,0,0,,{\i1}Bu eli asla bırakmam!{\i0}
Dialogue: 0,0:06:07.98,0:06:10.11,Main,,0,0,0,,Elini asla bırakmam dedin!
Dialogue: 0,0:06:10.80,0:06:13.10,Flashbacks,,0,0,0,,{\i1}Benimle aşık atabilir misin sen?!{\i0}
Dialogue: 0,0:06:13.91,0:06:15.78,Main,,0,0,0,,"Bana aşık olabilir misin" dedin...
Dialogue: 0,0:06:21.52,0:06:24.34,Main,,0,0,0,,Beni bu kadar çok istiyorsan...
Dialogue: 0,0:06:25.58,0:06:28.04,Main,,0,0,0,,...düşmanmışız değilmişiz\Numrumda olmaz!
Dialogue: 0,0:06:32.09,0:06:33.41,Main,,0,0,0,,Bana...
Dialogue: 0,0:06:34.98,0:06:36.94,Main,,0,0,0,,...ihtiyacın var, değil mi?!
Dialogue: 0,0:06:42.80,0:06:44.92,Main,,0,0,0,,Hiç acıması yok!
Dialogue: 0,0:06:45.04,0:06:48.60,Main,,0,0,0,,Vise-sama karşısında Elbaf'ın savaşçısı bile\Nbir şey yapamadı!
Dialogue: 0,0:06:51.66,0:06:55.34,Main,,0,0,0,,Güzelmiş bu-in!\NTam basmalık-in!
Dialogue: 0,0:06:56.28,0:07:02.30,Main,,0,0,0,,Dev Hajrudin'i yendim-in!\NBir sonraki hedefim...
Dialogue: 0,0:07:07.28,0:07:09.24,Main,,0,0,0,,Roronoa Zoro bu!
Dialogue: 0,0:07:12.06,0:07:14.30,Main,,0,0,0,,Çekil yolumuzdan dev!
Dialogue: 0,0:07:15.26,0:07:19.54,Thoughts,,0,0,0,,{\i1}Hayalim devler Kralı olmaktı.{\i0}
Dialogue: 0,0:07:21.00,0:07:22.92,Thoughts,,0,0,0,,{\i1}Şu halime bak!{\i0}
Dialogue: 0,0:07:25.16,0:07:27.06,Thoughts,,0,0,0,,{\i1}Yarışmayı kaybettim.{\i0}
Dialogue: 0,0:07:27.38,0:07:29.10,Thoughts,,0,0,0,,{\i1}Oyuncağa dönüştürüldüm.{\i0}
Dialogue: 0,0:07:29.82,0:07:33.71,Thoughts,,0,0,0,,{\i1}Kurtarıldım ama\Nhenüz bu borcumu ödeyemedim!{\i0}
Dialogue: 0,0:07:37.06,0:07:39.37,Thoughts,,0,0,0,,{\i1}Rezilim resmen!{\i0}
Dialogue: 0,0:07:41.04,0:07:44.56,Thoughts,,0,0,0,,{\i1}Borcumu canım pahasına\Nödeyecektim sözde...{\i0}
Dialogue: 0,0:07:45.16,0:07:50.17,Thoughts,,0,0,0,,{\i1}...fakat yenilmeme rağmen\Nneden hâlâ hayattayım peki?{\i0}
Dialogue: 0,0:07:52.65,0:07:54.06,Main,,0,0,0,,{\fad(150,150)}Ton-Ton!
Dialogue: 0,0:07:54.68,0:07:56.53,Thoughts,,0,0,0,,{\i1}Gönül borcum...{\i0}
Dialogue: 0,0:07:57.45,0:07:59.21,Thoughts,,0,0,0,,{\i1}...bu kadar basit miymiş?!{\i0}
Dialogue: 0,0:08:00.14,0:08:02.74,Main,,0,0,0,,Geliyorum, Roronoa!
Dialogue: 0,0:08:03.14,0:08:04.18,Main,,0,0,0,,Bu...
Dialogue: 0,0:08:04.48,0:08:07.70,Main,,0,0,0,,{\fad(150,150)}Yıkıcı 1000-Ton Vise!
Dialogue: 0,0:08:08.08,0:08:09.42,Thoughts,,0,0,0,,Ben...
Dialogue: 0,0:08:10.58,0:08:12.73,Main,,0,0,0,,Bu kadarlık adam değilim!
Dialogue: 0,0:08:14.56,0:08:15.94,Main,,0,0,0,,Kalktı!
Dialogue: 0,0:08:17.26,0:08:22.59,Main,,0,0,0,,Kusura bakma ama\Nonunla ben ilgileneceğim.
Dialogue: 0,0:08:24.38,0:08:26.66,Main,,0,0,0,,Hajrudin!
Dialogue: 0,0:08:27.14,0:08:31.88,Main,,0,0,0,,Hâlâ yaşıyor olmana inanamıyorum!
Dialogue: 0,0:08:32.88,0:08:36.26,Main,,0,0,0,,Öyleyse daha da ağırlaşırım-in!
Dialogue: 0,0:08:36.62,0:08:39.88,Main,,0,0,0,,{\fad(150,150)}Cehennemden Gelen 10000-Ton Vise!
Dialogue: 0,0:08:43.60,0:08:48.98,Main,,0,0,0,,Umarım kırılacak kemik kalmıştır-in!
Dialogue: 0,0:08:51.44,0:08:54.26,Thoughts,,0,0,0,,{\i1}Ölü adam\Nbir işe yaramaz fakat...{\i0}
Dialogue: 0,0:08:54.81,0:08:58.68,Thoughts,,0,0,0,,{\i1}...tek bir kolu bile kıpırdıyorsa \Ndüşman generalinin kellesini koparmaya yetecektir!{\i0}
Dialogue: 0,0:08:58.98,0:09:02.36,Thoughts,,0,0,0,,{\i1}Al sana!\NTüm varlığımla...{\i0}
Dialogue: 0,0:09:03.54,0:09:07.01,Main,,0,0,0,,{\fad(150,150)}Kahraman Mızrağı!
Dialogue: 0,0:09:24.98,0:09:28.66,Main,,0,0,0,,İşe yaramaz-in!\N10000 tondan bahsediyorum!
Dialogue: 0,0:09:34.48,0:09:37.02,Main,,0,0,0,,Ezil git, Hajrudin!
Dialogue: 0,0:09:37.62,0:09:41.74,Main,,0,0,0,,{\i1}Uç!\NTanrıların krallığına uç!{\i0}
Dialogue: 0,0:09:50.58,0:09:52.76,Main,,0,0,0,,Ne?!
Dialogue: 0,0:09:52.95,0:09:55.18,Main,,0,0,0,,Vise-sama!
Dialogue: 0,0:09:55.62,0:09:58.00,Main,,0,0,0,,Eyvah!\NGittiği yer...
Dialogue: 0,0:09:58.40,0:10:01.06,Main,,0,0,0,,Kuş Kafesi'ne çarpacak!
Dialogue: 0,0:10:01.28,0:10:03.96,Main,,0,0,0,,Vise-sama, dur!
Dialogue: 0,0:10:04.10,0:10:06.08,Main,,0,0,0,,Dilimlenecek!
Dialogue: 0,0:10:22.83,0:10:25.34,Main,,0,0,0,,Uçamayacak anlaşılan...
Dialogue: 0,0:10:25.86,0:10:27.90,Main,,0,0,0,,Kuş da değil zaten.
Dialogue: 0,0:10:30.40,0:10:32.32,Main,,0,0,0,,Vise-sama!
Dialogue: 0,0:10:43.76,0:10:45.36,Main,,0,0,0,,Uyumana bak.
Dialogue: 0,0:10:45.86,0:10:48.36,Main,,0,0,0,,Uyandığında kafes gitmiş olacak!
Dialogue: 0,0:10:57.28,0:10:58.56,Main,,0,0,0,,{\fad(150,150)}Çarliston!
Dialogue: 0,0:11:21.24,0:11:23.02,Main,,0,0,0,,Kime nişan alıyorsun?!
Dialogue: 0,0:11:30.44,0:11:32.14,Main,,0,0,0,,Kaçtı!
Dialogue: 0,0:11:34.00,0:11:35.66,Main,,0,0,0,,Hep aynı saldırı!
Dialogue: 0,0:11:42.28,0:11:44.02,Main,,0,0,0,,Hiç sevmedim bunu...
Dialogue: 0,0:11:46.32,0:11:48.90,Main,,0,0,0,,Yardım lazım mı, Korsan Avcısı?
Dialogue: 0,0:11:50.18,0:11:51.26,Main,,0,0,0,,Sen miydin?
Dialogue: 0,0:11:52.64,0:11:54.20,Main,,0,0,0,,Adım Elizabello.
Dialogue: 0,0:11:55.50,0:11:57.36,Main,,0,0,0,,Kral Riku eski dostumdur!
Dialogue: 0,0:11:58.14,0:12:00.04,Main,,0,0,0,,Dostumun ülkesi bu!
Dialogue: 0,0:12:01.20,0:12:05.53,Main,,0,0,0,,Kral Yumruğu saatte\Nbir kez kullanabildiğim saldırımdır.
Dialogue: 0,0:12:05.90,0:12:08.74,Main,,0,0,0,,Taş adamın gücünün sırrını çözebildin mi?
Dialogue: 0,0:12:09.10,0:12:10.76,Main,,0,0,0,,Evet, çoktan.
Dialogue: 0,0:12:11.06,0:12:13.32,Main,,0,0,0,,Öyleyse onu bana bırak.
Dialogue: 0,0:12:13.80,0:12:16.88,Main,,0,0,0,,Sağ ol ama\Nonunla ben ilgileneceğim.
Dialogue: 0,0:12:18.00,0:12:20.28,Main,,0,0,0,,İyisi mi saldırını sonraya sakla sen.
Dialogue: 0,0:12:21.30,0:12:23.42,Main,,0,0,0,,Başımıza daha neler gelecek bilinmez.
Dialogue: 0,0:12:27.66,0:12:29.76,Main,,0,0,0,,Dediğin gibi olsun madem!
Dialogue: 0,0:12:44.70,0:12:48.40,Main,,0,0,0,,Taş adisi neyin peşinde acaba?!
Dialogue: 0,0:13:10.30,0:13:12.39,Main,,0,0,0,,Sonunda! Lao G-sama'nın...
Dialogue: 0,0:13:12.52,0:13:14.44,Main,,0,0,0,,Bel Ağrısı Duruşu!
Dialogue: 0,0:13:14.66,0:13:16.44,Main,,0,0,0,,Canı çıkası...
Dialogue: 0,0:13:18.24,0:13:19.46,Main,,0,0,0,,Al bakalım!
Dialogue: 0,0:13:20.16,0:13:22.09,Main,,0,0,0,,{\fad(150,150)}Geo-Yumruk!
Dialogue: 0,0:13:23.10,0:13:24.95,Main,,0,0,0,,{\fad(150,150)}Göz Yorgunluğu!
Dialogue: 0,0:13:31.31,0:13:32.68,Main,,0,0,0,,{\fad(150,150)}Omuz Ağrısı!
Dialogue: 0,0:13:36.98,0:13:39.54,Main,,0,0,0,,{\fad(150,150)}Eklem Ağrısı!
Dialogue: 0,0:13:51.32,0:13:53.07,Main,,0,0,0,,Lao G-sama'ya helal olsun!
Dialogue: 0,0:13:53.18,0:13:56.34,Main,,0,0,0,,500 milyon ödüllü Don Chinjao'yla\Noyuncak gibi oynuyor!
Dialogue: 0,0:13:56.82,0:14:00.76,Main,,0,0,0,,Yaşlandıkça acıyı anlamaya başlarsın,\Nacı da şiddetini arttırmaya başlar!
Dialogue: 0,0:14:01.14,0:14:02.98,Main,,0,0,0,,Geo-Yumruğu
Dialogue: 0,0:14:03.14,0:14:04.04,Main,,0,0,0,,İşte sana...
Dialogue: 0,0:14:04.32,0:14:06.90,Main,,0,0,0,,..."G"!
Dialogue: 0,0:14:08.94,0:14:10.32,Main,,0,0,0,,O evlilik...
Dialogue: 0,0:14:10.42,0:14:12.08,Main,,0,0,0,,Onlarla mı konuşuyordun?!
Dialogue: 0,0:14:12.22,0:14:14.70,Main,,0,0,0,,Nerenle dinliyorsun moruk,\Nkimseyle evlenmiyorum!
Dialogue: 0,0:14:14.80,0:14:16.00,Main,,0,0,0,,Ne dedin?!
Dialogue: 0,0:14:16.12,0:14:18.76,Main,,0,0,0,,Niye şaşırıyorsun?!\NEvlenir miyim seninle be?!
Dialogue: 0,0:14:19.10,0:14:26.34,Main,,0,0,0,,Sai! Nihosui Ordu liderinin kızı\NOoklicia'yla evlenmen kararlaştırıldı!
Dialogue: 0,0:14:27.18,0:14:28.36,Flashbacks,,0,0,0,,{\i1}Sai!{\i0}
Dialogue: 0,0:14:29.64,0:14:33.92,Main,,0,0,0,,Biliyorum!\NKim olursa olsun evlenecek...
Dialogue: 0,0:14:34.34,0:14:35.85,Main,,0,0,0,,...bu politik evlilik aracılığıyla da...
Dialogue: 0,0:14:35.92,0:14:40.23,Main,,0,0,0,,Nihou'yla Happo'yu birleştirip Jupposui'yi falan kuracak,\Nartık ne istersen yapacağım.
Dialogue: 0,0:14:35.85,0:14:40.23,Note,,0,0,0,,Nihou: "İki Hazine", Happou: "Sekiz Hazine", Juppou: "On Hazine"
Dialogue: 0,0:14:40.63,0:14:43.77,Main,,0,0,0,,Eyvah ki ne eyvah!\NLao G-sama'yı görmezden geliyorlar!
Dialogue: 0,0:14:43.90,0:14:45.22,Main,,0,0,0,,Acayip sinirlenecek!
Dialogue: 0,0:14:52.34,0:14:53.03,Main,,0,0,0,,Ne?!
Dialogue: 0,0:14:53.14,0:14:55.48,Main,,0,0,0,,Hiçbir şey duymamış mı?!
Dialogue: 0,0:14:55.60,0:14:57.56,Main,,0,0,0,,Kızmış orası kesin!
Dialogue: 0,0:14:57.74,0:15:00.76,Main,,0,0,0,,Baksanıza! Kafasından resmen\Nöfke dumanları çıkıyor!
Dialogue: 0,0:15:02.04,0:15:03.72,Main,,0,0,0,,Oha öldü!
Dialogue: 0,0:15:05.18,0:15:07.34,Main,,0,0,0,,Eceliyle ölecek bugünü mü buldu?!
Dialogue: 0,0:15:07.46,0:15:10.26,Main,,0,0,0,,Bu savaş böyle bitemez!
Dialogue: 0,0:15:10.44,0:15:12.13,Main,,0,0,0,,Ne?! Şaka değil mi bu!?
Dialogue: 0,0:15:12.26,0:15:14.16,Main,,0,0,0,,Lao G, ölme!
Dialogue: 0,0:15:14.34,0:15:16.28,Main,,0,0,0,,Lao G-sama!
Dialogue: 0,0:15:16.36,0:15:17.94,Main,,0,0,0,,Geri dön!
Dialogue: 0,0:15:18.38,0:15:22.24,Secondary,,0,0,0,,Dön... Dön... Dön...
Dialogue: 0,0:15:22.26,0:15:22.85,Main,,0,0,0,,Ne?!
Dialogue: 0,0:15:25.12,0:15:25.89,Main,,0,0,0,,Ne?!
Dialogue: 0,0:15:26.30,0:15:29.42,Main,,0,0,0,,Doğru düzgün duyamamasına rağmen geri döndü!
Dialogue: 0,0:15:29.66,0:15:30.56,Main,,0,0,0,,Şükürler olsun!
Dialogue: 0,0:15:33.98,0:15:36.98,Main,,0,0,0,,Bizim ünlü Don Chinjao\Nepey güçten düşmüş ha!
Dialogue: 0,0:15:37.06,0:15:38.69,Main,,0,0,0,,Ne yapıyorsun sen, Sai?!
Dialogue: 0,0:15:38.80,0:15:40.62,Main,,0,0,0,,Hepsi ayrı telden çalıyor!
Dialogue: 0,0:15:40.70,0:15:41.18,Main,,0,0,0,,Ne?!
Dialogue: 0,0:15:41.26,0:15:43.22,Main,,0,0,0,,Resmen duyamıyor işte!
Dialogue: 0,0:15:43.54,0:15:45.22,Main,,0,0,0,,Ne mi yapıyorum?!
Dialogue: 0,0:15:45.52,0:15:47.03,Main,,0,0,0,,Kırışmış.
Dialogue: 0,0:15:47.14,0:15:50.58,Main,,0,0,0,,Yakamı niye düzeltiyorsun?!\NKarım mısın?!
Dialogue: 0,0:15:52.88,0:15:55.26,Main,,0,0,0,,Uzak dur benden, Donquixote Ailesi!
Dialogue: 0,0:15:55.44,0:15:58.33,Main,,0,0,0,,Ne tuhaf insansın sen!\NDüşman değil miyiz seninle?!
Dialogue: 0,0:15:58.52,0:16:01.32,Main,,0,0,0,,Birden evlilik falan da nereden çıktı?!
Dialogue: 0,0:16:01.50,0:16:04.11,Main,,0,0,0,,Ama nasıl olur?!\NBana ihtiyacın yok mu?!
Dialogue: 0,0:16:04.28,0:16:06.86,Main,,0,0,0,,Ne istiyorsun söyle!\Nİstediğini yapacağım!
Dialogue: 0,0:16:08.36,0:16:11.58,Main,,0,0,0,,Aptal mısın nesin?!\NMadem öyle...
Dialogue: 0,0:16:12.10,0:16:13.76,Main,,0,0,0,,Öldür kendini!
Dialogue: 0,0:16:16.90,0:16:21.31,Main,,0,0,0,,Gitmenize izin verirsek\NHasır Şapkalar'a ayakbağı olacaksınız...
Dialogue: 0,0:16:21.44,0:16:23.60,Main,,0,0,0,,Biz de borcumuzu\Nödeyememiş olacağız!
Dialogue: 0,0:16:24.18,0:16:29.02,Main,,0,0,0,,En azından yöneticileri\Ndurdurmamız lazım!
Dialogue: 0,0:16:29.34,0:16:30.72,Main,,0,0,0,,Buna hazırlansan iyi edersin!
Dialogue: 0,0:16:33.94,0:16:37.26,Main,,0,0,0,,Pekâlâ!\NKendimi seve seve öldürürüm!
Dialogue: 0,0:16:38.30,0:16:40.05,Main,,0,0,0,,Eğer bu şekilde işine yarayacaksam...
Dialogue: 0,0:16:40.18,0:16:42.10,Main,,0,0,0,,Ne?! Yo-Yok...
Dialogue: 0,0:16:42.30,0:16:46.60,Main,,0,0,0,,İnsanlara yardım etmek\Nbeni her şeyden çok mutlu eder!
Dialogue: 0,0:16:47.10,0:16:49.23,Main,,0,0,0,,Aptal, yapma!
Dialogue: 0,0:16:49.38,0:16:51.23,Main,,0,0,0,,Öylesine söyledim ben be!
Dialogue: 0,0:16:51.34,0:16:55.54,Main,,0,0,0,,Bu şekilde bir galibiyet\Nağzımda hiç hoş tat bırakmaz!
Dialogue: 0,0:16:55.98,0:16:57.32,Main,,0,0,0,,Boşver Sai!
Dialogue: 0,0:16:57.84,0:17:00.99,Main,,0,0,0,,Düşmanın kendini yok etmesini\Nniye engellemek istiyorsun?!
Dialogue: 0,0:17:01.14,0:17:03.26,Main,,0,0,0,,Aklını mı kaçırdın!?
Dialogue: 0,0:17:03.42,0:17:06.86,Main,,0,0,0,,Bir ordu lideri olarak\Ndaha acımasız olman lazım!
Dialogue: 0,0:17:07.18,0:17:08.77,Main,,0,0,0,,Kapa çeneni moruk!
Dialogue: 0,0:17:08.92,0:17:11.44,Main,,0,0,0,,Hâlâ efendimmişsin gibi emir buyurmayı kes!
Dialogue: 0,0:17:13.20,0:17:14.64,Main,,0,0,0,,Bana bak kadın!
Dialogue: 0,0:17:16.01,0:17:18.00,Thoughts,,0,0,0,,{\i1}Ne mutluyum böyle...{\i0}
Dialogue: 0,0:17:18.50,0:17:21.49,Thoughts,,0,0,0,,{\i1}Ölerek birilerinin işine\Nyarayabileceğim.{\i0}
Dialogue: 0,0:17:23.98,0:17:25.74,Main,,0,0,0,,Niye doğurdun?!
Dialogue: 0,0:17:26.14,0:17:29.99,Main,,0,0,0,,Çocuklar hiçbir işe yaramadıkları gibi\Ndoymak da bilmezler!
Dialogue: 0,0:17:30.12,0:17:34.46,Main,,0,0,0,,Besleyecek ağızları azaltmamız lazım!\NGit bir dağın tepesine bırak onu!
Dialogue: 0,0:17:36.46,0:17:38.79,Main,,0,0,0,,Anneciğim, nereye gidiyoruz?
Dialogue: 0,0:17:42.98,0:17:44.54,Main,,0,0,0,,Peşimden gelme.
Dialogue: 0,0:17:44.78,0:17:48.26,Main,,0,0,0,,Olmaz lütfen!\NSeninle gelmek istiyorum!
Dialogue: 0,0:17:50.64,0:17:52.94,Main,,0,0,0,,İşe yaramazsın.
Dialogue: 0,0:17:54.02,0:17:56.54,Main,,0,0,0,,Senin gibi işe yaramaz insanlara...
Dialogue: 0,0:17:57.46,0:18:00.16,Main,,0,0,0,,...kimsenin ihtiyacı yok!
Dialogue: 0,0:18:02.80,0:18:04.42,Main,,0,0,0,,{\i1}Senin bile mi?{\i0}
Dialogue: 0,0:18:05.70,0:18:08.86,Main,,0,0,0,,{\i1}Senin bile mi\Nihtiyacın yok anneciğim?{\i0}
Dialogue: 0,0:18:09.12,0:18:13.54,Thoughts,,0,0,0,,{\i1}Ben... Şu anda...\Nİhtiyaç duyuluyorum...{\i0}
Dialogue: 0,0:18:13.80,0:18:16.24,Main,,0,0,0,,Yapma dedim sana aptal kadın!
Dialogue: 0,0:18:16.60,0:18:18.46,Main,,0,0,0,,Asıl aptal sensin!
Dialogue: 0,0:18:18.83,0:18:19.78,Main,,0,0,0,,Moruk?!
Dialogue: 0,0:18:20.98,0:18:22.33,Main,,0,0,0,,Ne güç ama!
Dialogue: 0,0:18:23.61,0:18:24.71,Main,,0,0,0,,Bu...
Dialogue: 0,0:18:28.06,0:18:29.04,Main,,0,0,0,,Sai!
Dialogue: 0,0:18:29.38,0:18:32.64,Main,,0,0,0,,Happosui Ordusu'nun\Nyüzünü karartıyorsun!
Dialogue: 0,0:18:33.46,0:18:37.80,Main,,0,0,0,,Happosui Ordusu'nda\Nsenin gibilere ihtiyaç yok!
Dialogue: 0,0:18:39.36,0:18:43.88,Main,,0,0,0,,Bu mesele seni ilgilendirmez!\NKarışma!
Dialogue: 0,0:18:44.62,0:18:45.98,Main,,0,0,0,,Aptal!
Dialogue: 0,0:18:48.60,0:18:51.24,Main,,0,0,0,,{\fad(150,150)}Hasshoken Tekniği!
Dialogue: 0,0:18:51.30,0:18:54.98,Main,,0,0,0,,Buz kıtasını parçalayan\Nkafa atma tekniğini mi yapacak yoksa?!
Dialogue: 0,0:18:55.64,0:19:00.35,Main,,0,0,0,,İkinizi de delgi kafamla yere gömeceğim!
Dialogue: 0,0:19:00.62,0:19:02.56,Main,,0,0,0,,{\fad(150,150)}Delgi Ejder...
Dialogue: 0,0:19:02.70,0:19:04.50,Main,,0,0,0,,{\fad(150,150)}...Pençesi!
Dialogue: 0,0:19:06.04,0:19:07.98,Main,,0,0,0,,{\fad(150,150)}Wujiaogen!
Dialogue: 0,0:19:25.99,0:19:29.72,Thoughts,,0,0,0,,{\i1}Ben... Şu anda...\Nİhtiyaç duyuluyorum...{\i0}
Dialogue: 0,0:19:33.76,0:19:36.80,Main,,0,0,0,,Ne yaptığını sanıyorsun?!
Dialogue: 0,0:20:06.66,0:20:07.82,Main,,0,0,0,,Neden...
Dialogue: 0,0:20:08.54,0:20:10.27,Main,,0,0,0,,Neden durdurdun beni?!
Dialogue: 0,0:20:11.26,0:20:14.50,Main,,0,0,0,,Sana yardımcı olmaya\Nçalışıyordum oysaki!
Dialogue: 0,0:20:15.70,0:20:20.26,Main,,0,0,0,,Ölerek ihtiyaç duyulan biri olacaktım!
Dialogue: 0,0:20:20.82,0:20:25.07,Main,,0,0,0,,İnandığın şeyin yanlış olabileceğini...
Dialogue: 0,0:20:25.30,0:20:27.36,Main,,0,0,0,,...daha önce kimse\Nsöylemedi mi sana?!
Dialogue: 0,0:20:37.10,0:20:40.87,Main,,0,0,0,,Don Chinjao'nun delgi kafası yamulmuş!
Dialogue: 0,0:20:41.18,0:20:43.14,Main,,0,0,0,,İnanamıyorum!
Dialogue: 0,0:20:43.62,0:20:46.20,Main,,0,0,0,,Ben mi yaptım bunu?!
Dialogue: 0,0:20:47.02,0:20:52.84,Main,,0,0,0,,Sai! Delgi kafamı yamultmuş olmana\Ninanamıyorum!
Dialogue: 0,0:20:53.02,0:20:54.96,Main,,0,0,0,,Kendi aralarında mı savaşacaklar?!
Dialogue: 0,0:20:55.16,0:20:58.32,Main,,0,0,0,,Sonunda gücün uyandı!
Dialogue: 0,0:20:59.68,0:21:04.82,Main,,0,0,0,,Kan, ter ve gözyaşı dolu çalışman\Nsonunda meyvesini verdi!
Dialogue: 0,0:21:05.02,0:21:06.02,Main,,0,0,0,,İhtiyar?!
Dialogue: 0,0:21:06.36,0:21:07.86,Main,,0,0,0,,Başardın!
Dialogue: 0,0:21:08.18,0:21:11.65,Main,,0,0,0,,Hasshoken Tekniği yeni nesle devredildi!
Dialogue: 0,0:21:12.86,0:21:15.79,Main,,0,0,0,,Sai! Tekme saldırına...
Dialogue: 0,0:21:15.98,0:21:20.68,Main,,0,0,0,,...Delgi Ejder Pençesi adını veriyorum!
Dialogue: 0,0:21:22.82,0:21:28.70,Main,,0,0,0,,Eminim artık bacağın\Nbuz kıtasını kıracak güce sahip.
Dialogue: 0,0:21:29.72,0:21:34.28,Main,,0,0,0,,Happousui Ordusu\Ntamamen senin artık!
Dialogue: 0,0:21:34.90,0:21:37.14,Main,,0,0,0,,Anlaşmalı evliliğini de\Niptal edeceğim!
Dialogue: 0,0:21:37.85,0:21:40.38,Main,,0,0,0,,İstediğini yapmakta özgürsün!
Dialogue: 0,0:21:40.67,0:21:44.02,Main,,0,0,0,,İşin aslı,\NHasır Şapka'yla savaşımdan sonra...
Dialogue: 0,0:21:44.12,0:21:47.48,Main,,0,0,0,,...vücudumun ağrısı yüzünden\Nistediğim gibi savaşamadım.
Dialogue: 0,0:21:48.90,0:21:54.22,Main,,0,0,0,,Yaşlanıyorum.\NAma seni böyle...
Dialogue: 0,0:21:57.61,0:21:59.88,Main,,0,0,0,,{\fad(150,150)}G Mührü!
Dialogue: 0,0:22:04.40,0:22:05.72,Main,,0,0,0,,İhtiyar!
Dialogue: 0,0:22:05.84,0:22:06.96,Main,,0,0,0,,Lao G-sama!
Dialogue: 0,0:22:17.38,0:22:20.66,Main,,0,0,0,,Lao G-sama\NDon Chinjao'yu yendi!
Dialogue: 0,0:22:22.98,0:22:25.70,Main,,0,0,0,,Geo-Yumruk nihai tekniği!
Dialogue: 0,0:22:26.04,0:22:28.80,Main,,0,0,0,,{\fad(150,150)}Savaş Sigortası Yumruğu!
Dialogue: 0,0:22:29.76,0:22:34.16,Main,,0,0,0,,Yaşlanma, yaralanma\Nyahut hastalık durumları için...
Dialogue: 0,0:22:34.68,0:22:37.64,Main,,0,0,0,,...genç yaşlarda kas gücünü\Nbiriktirmeye başlayıp sakladığın...
Dialogue: 0,0:22:37.74,0:22:40.04,Main,,0,0,0,,...sigorta tekniği!
Dialogue: 0,0:22:40.26,0:22:44.62,Main,,0,0,0,,Teknik sayesinde olgun savaş yeteneklerine\Nve uç noktada güce sahip oluyorsun!
Dialogue: 0,0:22:45.14,0:22:50.78,Main,,0,0,0,,Bu haldeyken\Nbeni yenebilecek kimseler var mı acaba?!
Dialogue: 0,0:22:56.63,0:23:00.30,Main,,0,0,0,,Kano Ülkesi'nin maymunu,\Nbenden ne istiyorsun?!
Dialogue: 0,0:23:00.46,0:23:02.48,Main,,0,0,0,,İhtiyarın öcünü alacak...
Dialogue: 0,0:23:02.62,0:23:06.48,Main,,0,0,0,,...ve Hasır Şapkalar'a olan\Nborcumu ödeyeceğim!
Dialogue: 0,0:23:06.52,0:23:10.74,Main,,0,0,0,,Hasır Şapka'nın Genç Bey'i yenebileceğine\Ngerçekten inanıyor musun?!
Dialogue: 0,0:23:12.40,0:23:13.16,Main,,0,0,0,,Evet!
Dialogue: 0,0:23:17.14,0:23:17.90,Main,,0,0,0,,Şunu aklına sok!
Dialogue: 0,0:23:18.46,0:23:20.84,Main,,0,0,0,,Dressrosa Genç Bey'indir!
Dialogue: 0,0:23:21.10,0:23:23.40,Main,,0,0,0,,Ve ülkedeki herkes de...
Dialogue: 0,0:23:23.62,0:23:26.14,Main,,0,0,0,,...Genç Bey'in kölesidir!
Dialogue: 0,0:23:32.09,0:23:40.63,Main,,0,0,0,,Hasır Şapka'ya ne kadar güvensen de,\Nhayatınız boyunca bu kuş kafesinden çıkamayacaksınız!
Dialogue: 0,0:23:40.98,0:23:44.76,Main,,0,0,0,,Güvenin G'si!
Dialogue: 0,0:23:47.04,0:23:49.88,Main,,0,0,0,,Hızlıymışsın,\No konuda hakkını vermek lazım.
Dialogue: 0,0:23:51.31,0:23:55.22,Main,,0,0,0,,Ama Baby 5'ı...
Dialogue: 0,0:23:55.88,0:23:56.96,Main,,0,0,0,,...almana izin vermem!
Dialogue: 0,0:23:57.52,0:23:59.40,Main,,0,0,0,,Ne?! Lao G!
Dialogue: 0,0:23:59.52,0:24:01.50,Main,,0,0,0,,Bekle bak, Baby 5!
Dialogue: 0,0:24:01.70,0:24:07.61,Main,,0,0,0,,"Bu gerzeğin kanını akıtıp\Nseni kurtaracağım" ın G'si!
Dialogue: 0,0:24:07.74,0:24:11.45,Main,,0,0,0,,Ay ne yapsam ki?!\NBenim için kavga ediyorlar...
Dialogue: 0,0:24:11.58,0:24:13.26,Main,,0,0,0,,Tehlikeli burası, uzak dur!
Dialogue: 0,0:24:17.68,0:24:20.12,Main,,0,0,0,,Maymundan ne beklersin ki?!
Dialogue: 0,0:24:20.38,0:24:25.20,Main,,0,0,0,,Baby 5'ı kalkan olarak kullansan\Nbana karşı avantaj elde etmiş olacaktın!
Dialogue: 0,0:24:33.64,0:24:36.34,Main,,0,0,0,,Baby 5 bizim!
Dialogue: 0,0:24:36.86,0:24:40.20,Main,,0,0,0,,İhtiyaç duyulduğunda\Nkendi canını bile feda edebilecek biri!
Dialogue: 0,0:24:40.58,0:24:44.16,Main,,0,0,0,,Onun gibi faydalı bir kadını\Nbaşka nerede buluruz?!
Dialogue: 0,0:24:45.92,0:24:47.10,Thoughts,,0,0,0,,{\i1}Faydalı mı?{\i0}
Dialogue: 0,0:24:51.04,0:24:54.70,Main,,0,0,0,,Bu gizli tekniğimle\Nseni cehenneme yollayacağım!
Dialogue: 0,0:24:54.70,0:24:56.84,Main,,0,0,0,,Madem öyle...
Dialogue: 0,0:24:57.56,0:24:58.88,Main,,0,0,0,,Seni yenersem...
Dialogue: 0,0:24:59.86,0:25:03.86,Main,,0,0,0,,...o kadını karım olarak alacağım!
Dialogue: 0,0:25:05.96,0:25:06.71,Captions,,400,0,140,,{\fs80\fr22\c&H42FFFC&\3c&H000000&\3a&H96&\b1}Y\Nu\Nm\Nr\Nu\Nk{\b0}
Dialogue: 0,0:25:13.99,0:25:15.78,Main,,0,0,0,,{\fad(150,150)}Delgi Ejder...
Dialogue: 0,0:25:16.38,0:25:18.54,Main,,0,0,0,,{\fad(150,150)}...Pençesi!
Dialogue: 0,0:25:21.98,0:25:24.98,Main,,0,0,0,,Genç Bey'im... Bağışla!
Dialogue: 0,0:25:40.60,0:25:42.48,Main,,0,0,0,,Geberesice maymun seni!
Dialogue: 0,0:25:43.16,0:25:48.49,Main,,0,0,0,,Geberesicenin G'si!
Dialogue: 0,0:25:53.89,0:25:56.62,Main,,0,0,0,,Lider diyeceksin!
Dialogue: 0,0:25:57.88,0:26:02.36,Main,,0,0,0,,{\i1}Kraliyet Sarayı'nın bulunduğu tepenin ikinci\Nseviyesi, yöneticilere karşı olan savaşta...{\i0}
Dialogue: 0,0:26:02.89,0:26:04.64,Captions,,0,440,480,,{\fs162\c&H000000&\3c&HFFFFFF&\bord3}Lao G
Dialogue: 0,0:26:03.41,0:26:04.96,Main,,0,0,0,,{\a6\i1}Lao G...{\i0}
Dialogue: 0,0:26:05.14,0:26:06.36,Main,,0,0,0,,{\a6\i1}...yenildi.{\i0}
