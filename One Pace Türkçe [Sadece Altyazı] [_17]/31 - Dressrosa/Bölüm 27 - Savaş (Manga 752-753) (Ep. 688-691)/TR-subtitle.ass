Dialogue: 0,0:01:42.57,0:01:48.63,Title,,0,0,460,,{\fad(200,200)}Savaş
Dialogue: 0,0:01:48.90,0:01:51.22,Main,,0,0,0,,Doflamingo!
Dialogue: 0,0:01:53.76,0:01:57.37,Main,,0,0,0,,İki zavallı\Ngüçlerinizi birleştirdiniz demek?
Dialogue: 0,0:01:57.37,0:02:03.88,Main,,0,0,0,,Anlaşılan yakında\No kelepçelerden de kurtulacaksın Law?
Dialogue: 0,0:02:03.88,0:02:07.97,Main,,0,0,0,,Neden buradasın?!
Dialogue: 0,0:02:12.71,0:02:15.42,Main,,0,0,0,,Sizi kurtarmaya geldim.
Dialogue: 0,0:02:15.42,0:02:21.34,Main,,0,0,0,,Böyle salak bir tuzağa düşmenize\Ninanamıyorum! Yok kestirmeymiş de...
Dialogue: 0,0:02:21.34,0:02:22.72,Main,,0,0,0,,Hasır Şapka!
Dialogue: 0,0:02:27.34,0:02:29.22,Main,,0,0,0,,{\fad(150,150)}Sicim Mermisi!
Dialogue: 0,0:02:31.83,0:02:33.30,Main,,0,0,0,,Moocy!
Dialogue: 0,0:02:33.30,0:02:35.78,Main,,0,0,0,,Unut onu, Hasır Şapka-ya!
Dialogue: 0,0:02:38.28,0:02:40.22,Main,,0,0,0,,Moocy...
Dialogue: 0,0:02:44.61,0:02:47.81,Main,,0,0,0,,Böyle sıkışık bir anında bile...
Dialogue: 0,0:02:47.81,0:02:51.54,Main,,0,0,0,,Dayan... Moocy...
Dialogue: 0,0:02:52.38,0:02:54.40,Main,,0,0,0,,Ne zavallı biri!
Dialogue: 0,0:02:54.40,0:02:59.00,Main,,0,0,0,,Sizi bu şekilde kim olsa öldürür!
Dialogue: 0,0:03:02.58,0:03:07.98,Main,,0,0,0,,Dışarıda kellemi alacaklarını söyleyip \Nortalığı birbirine katan bir grup ahmak dolanıyor.
Dialogue: 0,0:03:09.58,0:03:14.58,Main,,0,0,0,,Bu durumdayken bile kendine\Nyandaş bulabilmen takdire şayan.
Dialogue: 0,0:03:14.58,0:03:20.79,Main,,0,0,0,,Sırf bu yeteneğin yüzünden \NEn İyiler Savaşı'ndan beri sana saygı duyuyordum.
Dialogue: 0,0:03:20.79,0:03:22.50,Main,,0,0,0,,Meğersem...
Dialogue: 0,0:03:23.34,0:03:27.29,Main,,0,0,0,,...bu tuzağa düşecek kadar salakmışsın!
Dialogue: 0,0:03:27.61,0:03:30.97,Main,,0,0,0,,Neden onu seçtin, Law?
Dialogue: 0,0:03:30.97,0:03:34.96,Main,,0,0,0,,Seni daha yetenekli biri sanırdım.
Dialogue: 0,0:03:34.96,0:03:38.27,Main,,0,0,0,,Çocukken bile çok daha acımasız...
Dialogue: 0,0:03:38.70,0:03:41.27,Main,,0,0,0,,...çok daha kurnazdın!
Dialogue: 0,0:03:41.45,0:03:43.25,Main,,0,0,0,,Haksız mıyım?
Dialogue: 0,0:03:45.61,0:03:50.30,Main,,0,0,0,,Seni böyle ödlek birine\Nkim dönüştürdü!?
Dialogue: 0,0:03:50.30,0:03:51.86,Main,,0,0,0,,Kapa çeneni!
Dialogue: 0,0:03:51.86,0:03:56.70,Main,,0,0,0,,Senin gibi olmayacağım!
Dialogue: 0,0:03:56.70,0:03:59.88,Main,,0,0,0,,Senin gibi olmaktan kurtarıldım!
Dialogue: 0,0:04:01.26,0:04:04.47,Main,,0,0,0,,Kardeşim Corazon'dan bahsediyorsun demek?
Dialogue: 0,0:04:05.38,0:04:08.08,Main,,0,0,0,,Madem ödlek değilsin...
Dialogue: 0,0:04:09.98,0:04:13.33,Main,,0,0,0,,...niye bu geri zekalıyla birlikte...
Dialogue: 0,0:04:13.33,0:04:15.33,Main,,0,0,0,,...boş yere ölme niyetindesin?
Dialogue: 0,0:04:15.57,0:04:19.57,Main,,0,0,0,,Yapma! Hasır Şapka-san'ın...
Dialogue: 0,0:04:19.57,0:04:22.14,Main,,0,0,0,,Kılına dokunamazsın!
Dialogue: 0,0:04:33.19,0:04:34.62,Main,,0,0,0,,Bu da ne anasını?
Dialogue: 0,0:04:34.62,0:04:36.31,Main,,0,0,0,,Ne oluyor?!
Dialogue: 0,0:04:36.31,0:04:38.52,Main,,0,0,0,,Düşündüğüm gibi klonuymuş.
Dialogue: 0,0:04:38.52,0:04:39.56,Main,,0,0,0,,Klon mu?
Dialogue: 0,0:04:39.56,0:04:41.98,Main,,0,0,0,,Sicim kuklası bu.
Dialogue: 0,0:04:48.08,0:04:49.17,Main,,0,0,0,,Siz...
Dialogue: 0,0:04:49.17,0:04:50.58,Main,,0,0,0,,Hasır Şapka-san!
Dialogue: 0,0:04:50.58,0:04:52.09,Main,,0,0,0,,Şükürler olsun iyisin!
Dialogue: 0,0:04:52.09,0:04:54.87,Main,,0,0,0,,Hasır Şapka-san'ı çıkartalım!
Dialogue: 0,0:04:55.93,0:04:59.08,Main,,0,0,0,,Kurtuldum...\NSağ olun!
Dialogue: 0,0:04:59.08,0:05:01.04,Main,,0,0,0,,Lafı olmaz!
Dialogue: 0,0:05:01.04,0:05:05.04,Main,,0,0,0,,Yalnız herifin bacakları burada kaldı!\NNe olacak acaba?!
Dialogue: 0,0:05:05.04,0:05:07.82,Main,,0,0,0,,Aile reisinin defterini\Ndürmüş mü olduk şimdi?!
Dialogue: 0,0:05:07.82,0:05:12.15,Main,,0,0,0,,Size ne dedim aptal!\NSahte o.
Dialogue: 0,0:05:12.15,0:05:16.59,Main,,0,0,0,,Bizi kızdırmak için\Nkalkıp kukla versiyonunu göndermiş.
Dialogue: 0,0:05:16.75,0:05:20.94,Main,,0,0,0,,Sahi ya!\Nİşin aslı şu Kelly Funk denen adam...
Dialogue: 0,0:05:20.94,0:05:24.87,Main,,0,0,0,,Adi kandırmış bizi!
Dialogue: 0,0:05:28.64,0:05:33.20,Main,,0,0,0,,Yalnız ne mal çıktı var ya!\NTuzağımıza tıpış tıpış kendi yürüdü.
Dialogue: 0,0:05:35.46,0:05:39.75,Main,,0,0,0,,Bunu duyup\Ntam onu engellemeye çalışalım derken...
Dialogue: 0,0:05:40.28,0:05:44.30,Main,,0,0,0,,Bir şeyler yapmamız lazım Abdullah!\NKalkabilecek gibi misin?
Dialogue: 0,0:05:53.38,0:05:57.86,Main,,0,0,0,,...katil Kelly\Nbir anda kendini yerde buldu.
Dialogue: 0,0:05:58.68,0:06:03.52,Main,,0,0,0,,O zaman sahiden de o adi tarafından\Nkurtarılmış mı olduk şimdi?!
Dialogue: 0,0:06:03.52,0:06:05.79,Main,,0,0,0,,Dalga geçiyor bizimle resmen!
Dialogue: 0,0:06:05.79,0:06:08.60,Main,,0,0,0,,Dışarısı nasıl?\NKabak'lar falan ne durumda?!
Dialogue: 0,0:06:08.60,0:06:10.52,Main,,0,0,0,,Acayip geride kaldık...
Dialogue: 0,0:06:10.76,0:06:14.38,Main,,0,0,0,,Eminim herkes çoktan\Nikinci seviyeye varmıştır bile!
Dialogue: 0,0:06:14.38,0:06:19.16,Main,,0,0,0,,Lanet olsun ya! \NNe güzel kestirme yoldan gidiyoruz sanmıştım!
Dialogue: 0,0:06:19.16,0:06:20.52,Main,,0,0,0,,Geri dönelim, çabuk!
Dialogue: 0,0:06:20.53,0:06:25.65,Captions,,0,0,175,,{\fad(1000,0}Kraliyet Sarayı Platosu - Seviye 1
Dialogue: 0,0:06:23.72,0:06:25.36,Main,,0,0,3,,Bu da ne?!
Dialogue: 0,0:06:27.60,0:06:31.10,Main,,0,0,0,,{\fad(150,150}Gomu Gomu no...
Dialogue: 0,0:06:32.70,0:06:37.48,Main,,0,0,3,,Ay! Hepsi de birinci seviyeyi geçti!
Dialogue: 0,0:06:32.52,0:06:36.95,Captions,,0,0,175,,{\fad(500,0)}Kraliyet Sarayı Platosu - Seviye 2
Dialogue: 0,0:06:37.48,0:06:39.28,Main,,0,0,0,,İnanamıyorum!
Dialogue: 0,0:06:39.51,0:06:42.65,Main,,0,0,0,,Adamlarımız onlarla boy ölçüşemiyor-in!
Dialogue: 0,0:06:42.65,0:06:45.52,Main,,0,0,0,,Hasır Şapka'nın grubu henüz gelmedi.
Dialogue: 0,0:06:45.52,0:06:48.55,Main,,0,0,0,,Bir bir işlerini bitirelim.
Dialogue: 0,0:06:48.86,0:06:53.26,Main,,0,0,0,,{\fad(150,150}Fil Tüfeği!
Dialogue: 0,0:06:57.96,0:06:59.20,Main,,0,0,0,,Bu da ne?!
Dialogue: 0,0:06:59.20,0:07:00.20,Main,,0,0,0,,Eyvah!
Dialogue: 0,0:07:00.20,0:07:02.18,Main,,0,0,0,,Bir tane daha geliyor!
Dialogue: 0,0:07:02.91,0:07:06.33,Main,,0,0,0,,Ne olduğunu bile bilmeden\Nneden bu kadar korkuyorsunuz!
Dialogue: 0,0:07:06.33,0:07:08.60,Main,,0,0,0,,Bana bakın!\NDüşmanı gözünüzden kaçırmayın!
Dialogue: 0,0:07:08.65,0:07:12.15,Captions,,0,0,320,,{\fad(200,200)}Kuyunun İçinde\NBirinci Seviye{\fad(200,200)}
Dialogue: 0,0:07:11.90,0:07:14.50,Main,,0,0,1,,Harbiden kestirme yol yarattı!
Dialogue: 0,0:07:14.89,0:07:17.58,Main,,0,0,0,,Millet, Moocy size emanet!
Dialogue: 0,0:07:17.58,0:07:18.80,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:07:20.02,0:07:22.06,Main,,0,0,0,,Bu kargaşayı sevdim!
Dialogue: 0,0:07:22.06,0:07:24.38,Main,,0,0,0,,Chin Jao'lar\Nüçüncü seviyeye doğru gidiyorlar!
Dialogue: 0,0:07:24.38,0:07:26.04,Main,,0,0,0,,Durdurun onları!
Dialogue: 0,0:07:26.04,0:07:27.64,Main,,0,0,0,,Bu delik...
Dialogue: 0,0:07:27.64,0:07:31.14,Main,,0,0,0,,Ne haltlar dönüyor acaba?
Dialogue: 0,0:07:36.72,0:07:38.04,Main,,0,0,0,,Bu da ne!?
Dialogue: 0,0:07:41.22,0:07:43.92,Main,,0,0,0,,Hasır Şapka'ymış!
Dialogue: 0,0:07:50.86,0:07:51.78,Main,,0,0,0,,Hasır Şapka!
Dialogue: 0,0:07:51.78,0:07:53.92,Main,,0,0,0,,Trafalgar Law!
Dialogue: 0,0:07:56.24,0:07:58.06,Main,,0,0,0,,Gidelim, Hasır Şapka-ya!
Dialogue: 0,0:07:58.06,0:07:59.24,Main,,0,0,0,,Evet.
Dialogue: 0,0:07:59.24,0:08:02.82,Main,,0,0,0,,Bekle beni, Mingo!
Dialogue: 0,0:08:04.18,0:08:06.00,Main,,0,0,0,,Şaka mı bu?!
Dialogue: 0,0:08:08.56,0:08:09.74,Main,,0,0,0,,Kesin şaka!
Dialogue: 0,0:08:09.74,0:08:11.57,Main,,0,0,0,,Çok ciddiyim ben!
Dialogue: 0,0:08:11.57,0:08:14.45,Main,,0,0,650,,Böceklerle insanları uçuramazsınız!
Dialogue: 0,0:08:11.57,0:08:16.50,Captions,,0,0,320,,{\fad(200,200)}Eski Kralın Platosu
Dialogue: 0,0:08:14.45,0:08:16.72,Main,,0,0,650,,Biz buradan koşa koşa gideriz!
Dialogue: 0,0:08:16.72,0:08:19.12,Main,,0,0,0,,Evet evet!\NBayıldım bu fikre!
Dialogue: 0,0:08:19.12,0:08:20.91,Main,,0,0,0,,Açıklıyorum öyleyse.
Dialogue: 0,0:08:20.91,0:08:23.50,Main,,0,0,0,,Dinlemiyor musun sen bizi, bücür?!
Dialogue: 0,0:08:23.15,0:08:28.10,Captions,,0,0,350,,{\fad(200,200)}Tontatta Havayolları\NSarı Kurtçuklar{\fad(200,200)}
Dialogue: 0,0:08:23.50,0:08:27.51,Main,,0,0,0,,Tontatta Havayolu Zıplama Servisi\Nduruyor karşınızda!
Dialogue: 0,0:08:27.51,0:08:30.36,Main,,0,0,0,,Büyük İnsanlar ağır olduğundan\Nböcekler sizi taşıyamazlar!
Dialogue: 0,0:08:30.36,0:08:32.09,Main,,0,0,0,,Ne dedik biz!
Dialogue: 0,0:08:32.09,0:08:34.16,Main,,0,0,0,,Fazla zamanımız yok!
Dialogue: 0,0:08:34.16,0:08:36.00,Main,,0,0,0,,...uçun!
Dialogue: 0,0:08:36.00,0:08:37.33,Main,,0,0,0,,Ne?!
Dialogue: 0,0:08:44.16,0:08:49.87,Main,,0,0,0,,Uçamayız dedik size!
Dialogue: 0,0:08:49.87,0:08:52.07,Main,,0,0,0,,Leo, şansınızı zorlamayın!
Dialogue: 0,0:08:52.07,0:08:53.71,Main,,0,0,0,,İyi misiniz?!
Dialogue: 0,0:08:53.88,0:08:58.16,Main,,0,0,0,,Lanet olası Küçük İnsanlar!\NBu burada kalmaz!
Dialogue: 0,0:09:01.90,0:09:04.79,Main,,0,0,0,,Uçuyor muyum?!
Dialogue: 0,0:09:04.79,0:09:08.53,Main,,0,0,0,,Sizi uçuramazlar ama\Ndüşerken yavaşlatabilirler!
Dialogue: 0,0:09:09.26,0:09:13.32,Main,,0,0,0,,Düşüyorum! Düşüyorum! Düşüyorum!
Dialogue: 0,0:09:12.06,0:09:13.53,Main,,0,0,0,,Rahatla!
Dialogue: 0,0:09:13.53,0:09:16.96,Main,,0,0,0,,Nasıl rahatlarım?!\NŞimdi çarpacağız bir şeylere!
Dialogue: 0,0:09:16.96,0:09:19.06,Main,,0,0,0,,Çatıyı hedefleyin!
Dialogue: 0,0:09:19.92,0:09:21.10,Main,,0,0,0,,Çatı mı?!
Dialogue: 0,0:09:21.10,0:09:25.38,Main,,0,0,0,,Evet!\NDüzgünce basmaya çalışın!
Dialogue: 0,0:09:30.64,0:09:32.48,Main,,0,0,0,,Zıplayın!
Dialogue: 0,0:09:42.60,0:09:44.08,Main,,0,0,0,,Uçuyorum!
Dialogue: 0,0:09:44.08,0:09:47.10,Main,,0,0,0,,Çatılardan zıplayarak havalanabilirsiniz!
Dialogue: 0,0:09:48.50,0:09:50.10,Main,,0,0,0,,Şimdi anlıyorum!
Dialogue: 0,0:09:50.62,0:09:53.14,Main,,0,0,0,,Bu şekilde Ayçiçeği Tarlası'na varabileceğiz!
Dialogue: 0,0:09:58.64,0:10:01.00,Main,,0,0,0,,Harika!\NHarikulade!
Dialogue: 0,0:10:05.44,0:10:08.30,Main,,0,0,0,,Balon gibi hissediyorum kendimi!
Dialogue: 0,0:10:09.74,0:10:11.86,Main,,0,0,0,,Yerden gelebilecek saldırılara karşı\Nhazırlıklı olun.
Dialogue: 0,0:10:12.04,0:10:16.19,Main,,0,0,0,,Hedefimiz dördüncü seviyedeki\NAyçiçeği Tarlası!
Dialogue: 0,0:10:11.87,0:10:16.19,Captions,,220,0,425,,Seviye 4\NAyçiçeği Tarlası
Dialogue: 0,0:10:16.42,0:10:17.20,Main,,0,0,0,,Anlaşılmıştır!
Dialogue: 0,0:10:17.20,0:10:18.36,Main,,0,0,0,,Anlaşılmıştır!
Dialogue: 0,0:10:18.36,0:10:19.60,Main,,0,0,0,,Tamamdır!
Dialogue: 0,0:10:31.54,0:10:34.22,Captions,,0,0,175,,GÜLÜCÜK  Fabrikasının Dışı
Dialogue: 0,0:10:31.56,0:10:34.21,Main,,0,0,3,,Fraland!
Dialogue: 0,0:10:34.21,0:10:37.46,Main,,0,0,0,,Fabrika kapısının kilidini açmak için\Nbir fikrimiz var!
Dialogue: 0,0:10:37.46,0:10:39.34,Main,,0,0,0,,Ne? Sahiden mi?!
Dialogue: 0,0:10:39.34,0:10:44.36,Main,,0,0,0,,Evet! \NSen Senyor'u oyalamaya devam et!
Dialogue: 0,0:10:45.90,0:10:48.11,Main,,0,0,0,,Tamamdır!
Dialogue: 0,0:10:48.11,0:10:51.90,Main,,0,0,0,,Bana bırakın siz onu!
Dialogue: 0,0:10:53.00,0:10:58.05,Captions,,0,0,330,,{\fad(200,200)}Pica \NHeykeli Tepesi{\fad(200,200)}
Dialogue: 0,0:11:06.82,0:11:10.45,Main,,0,0,0,,Lanet olası!\NNe cüretle kılıcıma basarsın?!
Dialogue: 0,0:11:11.20,0:11:13.58,Main,,0,0,0,,Basmışsam ne olmuş?!
Dialogue: 0,0:11:14.00,0:11:21.56,Captions,,0,40,310,,{\fad(200,200)}Şehrin İçi\N Sabo, Fujitora'ya karşı{\fad(200,200)}
Dialogue: 0,0:11:16.06,0:11:18.22,Main,,0,0,3,,Ne dövüş ama!
Dialogue: 0,0:11:30.73,0:11:35.75,Captions,,0,0,320,,{\fad(200,200)}Kraliyet Sarayı{\fad(200,200)}
Dialogue: 0,0:11:31.34,0:11:33.36,Main,,0,0,650,,Baksana baksana Doffy!
Dialogue: 0,0:11:33.36,0:11:37.59,Main,,0,0,650,,Sicim Joker'ı bir yerlere mi yolladın?
Dialogue: 0,0:11:37.59,0:11:42.30,Main,,0,0,0,,Bir şey iletmek istemiştim\Nama gerek kalmadı sanırım.
Dialogue: 0,0:11:42.30,0:11:44.23,Main,,0,0,0,,Acaba...
Dialogue: 0,0:11:44.23,0:11:50.24,Main,,0,0,0,,...Law'la tanıştığımız ilk günü\Nhatırlıyor musunuz?
Dialogue: 0,0:11:52.74,0:11:54.03,Main,,0,0,0,,Delirmiş gibiydi!
Dialogue: 0,0:11:54.03,0:11:56.18,Main,,0,0,0,,Gözleri fır fır dönüyordu...
Dialogue: 0,0:11:56.18,0:11:57.94,Main,,0,0,0,,Evet, evet!
Dialogue: 0,0:11:59.84,0:12:04.52,Main,,0,0,0,,Çocukkenki halime benziyordu.
Dialogue: 0,0:12:05.72,0:12:12.34,Main,,0,0,0,,10 yıla falan\Nsağ kolum olur diye sezmiştim.
Dialogue: 0,0:12:15.24,0:12:20.79,Main,,0,0,0,,Kendi ellerimle canını alacak olmam\Nçok yazık.
Dialogue: 0,0:12:22.20,0:12:24.31,Main,,0,0,0,,İçeri biri sızdı!
Dialogue: 0,0:12:24.31,0:12:27.94,Main,,0,0,0,,Dokunmayın ona!\NVücuduna bomba bağlamış!
Dialogue: 0,0:12:30.26,0:12:35.24,Main,,0,0,0,,Bu velet de neyin nesi?\NKim içeri aldı bunu?!
Dialogue: 0,0:12:35.24,0:12:38.24,Main,,0,0,0,,Korsan grubuna kat beni.
Dialogue: 0,0:12:38.46,0:12:41.81,Main,,0,0,0,,Gördüğüm her şeyi\Nyok etmek istiyorum!
Dialogue: 0,0:12:41.81,0:12:47.24,Main,,0,0,0,,Şehirleri, evleri, insanları...\NHepsini!
Dialogue: 0,0:12:47.24,0:12:49.10,Main,,0,0,0,,Ben...
Dialogue: 0,0:12:49.56,0:12:53.10,Main,,0,0,0,,...Beyaz Şehir Flevance'da büyüdüm.
Dialogue: 0,0:12:55.80,0:12:57.70,Main,,0,0,0,,Yaşayacak...
Dialogue: 0,0:12:59.10,0:13:01.76,Main,,0,0,0,,...uzun bir ömür yok önümde.
Dialogue: 0,0:13:04.95,0:13:08.08,Main,,0,0,0,,Mingo!
Dialogue: 0,0:13:08.10,0:13:13.07,Captions,,0,0,390,,{\fad(150,150)}Dressrosa\NKuş Kafesinin İçi{\fad(150,150)}
Dialogue: 0,0:13:21.45,0:13:26.33,Captions,,0,0,175,,{\fad(800,0)}Kraliyet Sarayı
Dialogue: 0,0:13:15.93,0:13:21.01,Main,,0,0,0,,Gözlerim yaşardı bak.
Dialogue: 0,0:13:24.21,0:13:26.62,Main,,0,0,1,,Neden geldin?
Dialogue: 0,0:13:27.40,0:13:32.33,Captions,,0,0,240,,{\fad(500,0)}Korsan "Sırtlan" Bellamy\NÖdül: 195 milyon beli
Dialogue: 0,0:13:28.03,0:13:32.32,Main,,0,0,3,,Hasır Şapkayı öldürdün mü yoksa, Bellamy?
Dialogue: 0,0:13:33.03,0:13:39.74,Main,,0,0,0,,Beni öldürmesi için Dellinger'ı niye yolladın?! \NGerçekten senin emrinle mi geldi?
Dialogue: 0,0:13:40.24,0:13:44.16,Main,,0,0,0,,Tüh... Bunu sormaya geldin demek?
Dialogue: 0,0:13:47.20,0:13:49.31,Main,,0,0,0,,Benim için...
Dialogue: 0,0:13:50.36,0:13:52.58,Main,,0,0,0,,...hiç umut kalmadı mı?!
Dialogue: 0,0:13:52.58,0:13:56.46,Main,,0,0,0,,Yüzüne söyletme bana bunu, Bellamy.
Dialogue: 0,0:13:57.10,0:14:02.48,Main,,0,0,0,,Hedeflerimiz ayrılalı çok oldu.
Dialogue: 0,0:14:03.45,0:14:07.60,Main,,0,0,0,,Sen hep korsan olarak kalmak istedin.
Dialogue: 0,0:14:08.00,0:14:10.58,Main,,0,0,0,,Bense öyle değilim.
Dialogue: 0,0:14:10.92,0:14:13.49,Main,,0,0,0,,Benim için her şey uygun.
Dialogue: 0,0:14:13.49,0:14:15.22,Main,,0,0,0,,Her şey mi?
Dialogue: 0,0:14:18.54,0:14:21.48,Main,,0,0,0,,Bu dünyayı...
Dialogue: 0,0:14:21.48,0:14:23.94,Main,,0,0,0,,...mahvedebildiğim müddetçe öyle!
Dialogue: 0,0:14:24.15,0:14:29.91,Captions,,0,0,15,,{\fad(600,0)}Kraliyet Sarayı Platosu - Seviye 2\N\N\N\N\N\N\N\N\NKolezyum Savaşçıları, Donquixote Ailesine Karşı
Dialogue: 0,0:14:31.20,0:14:33.99,Main,,0,0,0,,Çekil yolumdan, çocuk!
Dialogue: 0,0:14:33.99,0:14:36.13,Main,,0,0,0,,Acelem var!
Dialogue: 0,0:14:36.13,0:14:39.02,Main,,0,0,0,,Söylesene, neye benziyorum?
Dialogue: 0,0:14:39.60,0:14:43.58,Main,,0,0,0,,Söylesene Suleiman'cığım!
Dialogue: 0,0:14:48.92,0:14:51.86,Main,,0,0,0,,Savaş celladıydın, değil mi?
Dialogue: 0,0:14:51.86,0:14:54.46,Main,,0,0,0,,Ben de insanları idam etmeye bayılıyorum!
Dialogue: 0,0:14:54.46,0:14:55.94,Main,,0,0,0,,Yakaladım!
Dialogue: 0,0:15:10.38,0:15:15.60,Main,,0,0,0,,Tüh, yazık oldu.\NÇabucak bitiverdi.
Dialogue: 0,0:15:28.00,0:15:30.99,Main,,0,0,0,,Ailenin yöneticileri geldi!
Dialogue: 0,0:15:33.90,0:15:38.72,Main,,0,0,0,,Üçüncü seviyeye ilk ben varacağım öyleyse!
Dialogue: 0,0:15:41.24,0:15:43.86,Main,,0,0,0,,Bu çıkıntılar da neyin nesi?
Dialogue: 0,0:15:43.86,0:15:45.71,Main,,0,0,0,,Yanlış taşa bastın ihtiyar.
Dialogue: 0,0:15:45.71,0:15:47.74,Main,,0,0,0,,{\fad(150,150)}Mayın Patlaması!
Dialogue: 0,0:15:51.18,0:15:53.19,Main,,0,0,0,,Dede, hemen geliyorum!
Dialogue: 0,0:15:53.19,0:15:55.37,Main,,0,0,0,,Da-in!
Dialogue: 0,0:15:55.37,0:15:58.57,Main,,0,0,0,,Kuş gibi süzülüyorum.
Dialogue: 0,0:15:58.57,0:16:00.80,Main,,0,0,0,,{\fad(150,150)}On Ton Vise!
Dialogue: 0,0:16:07.68,0:16:09.12,Main,,0,0,0,,Gördünüz mü, gerzekler!
Dialogue: 0,0:16:09.12,0:16:12.76,Main,,0,0,0,,Ailenin yöneticileri böyle güçlüler işte!
Dialogue: 0,0:16:15.89,0:16:17.20,Main,,0,0,0,,Başardı!
Dialogue: 0,0:16:17.20,0:16:20.20,Main,,0,0,0,,Daha fazla ilerleyemezler!
Dialogue: 0,0:16:22.24,0:16:24.03,Main,,0,0,0,,Benimsin!
Dialogue: 0,0:16:24.03,0:16:26.09,Main,,0,0,0,,{\fad(150,150)}Silahdönüşümü!
Dialogue: 0,0:16:27.44,0:16:29.57,Main,,0,0,0,,{\fad(150,150)}Altıpatlar Bacak!
Dialogue: 0,0:16:31.64,0:16:37.39,Captions,,0,0,175,,{\fad(500,0)}Güneydeki Şehir - Sevio
Dialogue: 0,0:16:40.76,0:16:42.19,Main,,0,0,0,,Yakaladım!
Dialogue: 0,0:16:42.19,0:16:43.48,Main,,0,0,0,,İp getirin!
Dialogue: 0,0:16:43.48,0:16:45.78,Main,,0,0,0,,Vuruldu, yardım edin!
Dialogue: 0,0:16:47.28,0:16:49.00,Main,,0,0,0,,Siz de alevleri söndürün!
Dialogue: 0,0:16:49.00,0:16:50.28,Main,,0,0,0,,Tamamdır!
Dialogue: 0,0:16:50.28,0:16:54.31,Main,,0,0,0,,Özür dilerim... Özür dilerim...\NTeşekkür ederim!
Dialogue: 0,0:16:54.31,0:16:57.02,Main,,0,0,0,,Az kalsın ailemi öldürüyordum!
Dialogue: 0,0:16:57.02,0:17:00.46,Main,,0,0,0,,Köyü ateşe veren bendim!\NÖzür dilerim!
Dialogue: 0,0:17:00.46,0:17:03.19,Main,,0,0,0,,En iyi arkadaşımı kestim!
Dialogue: 0,0:17:03.19,0:17:05.57,Main,,0,0,0,,Ben de öyle!\NLanet olsun!
Dialogue: 0,0:17:05.81,0:17:07.71,Main,,0,0,0,,Sizin suçunuz değil.
Dialogue: 0,0:17:07.71,0:17:11.55,Main,,0,0,0,,Tüm bunların sorumlusu\NDoflamingo'dur.
Dialogue: 0,0:17:11.55,0:17:14.56,Main,,0,0,0,,Bu oyuna bir şekilde\Nson vermemiz lazım.
Dialogue: 0,0:17:14.56,0:17:16.38,Main,,0,0,0,,Hey!
Dialogue: 0,0:17:16.60,0:17:18.94,Main,,0,0,0,,Kral Riku'yu bulduk!
Dialogue: 0,0:17:18.94,0:17:22.16,Main,,0,0,0,,Beş yıldızlı Tanrı Usopp'la beraber!
Dialogue: 0,0:17:22.64,0:17:25.04,Main,,0,0,0,,Pekâlâ, yapalım şu işi öyleyse!
Dialogue: 0,0:17:25.04,0:17:27.50,Main,,0,0,0,,Sadece yakalayacağız!
Dialogue: 0,0:17:28.16,0:17:28.76,Main,,0,0,0,,Anlaşıldı mı?
Dialogue: 0,0:17:29.00,0:17:33.99,Main,,0,0,0,,Evet, yoksa bu oyun\Nhepimiz ölene dek sürecek!
Dialogue: 0,0:17:33.99,0:17:37.97,Main,,0,0,0,,Öncelikle Kral Riku'yla Tanrı Usopp'u\Nrehin alacağız!
Dialogue: 0,0:17:38.34,0:17:42.22,Main,,0,0,0,,Onları kullanarak da\Ndiğer suçluları kendimize çekeceğiz!
Dialogue: 0,0:17:43.92,0:17:46.02,Main,,0,0,0,,Ülkedeki herkese yayın bunu!
Dialogue: 0,0:17:49.48,0:17:51.75,Main,,0,0,0,,Eski Kral Platosu'na gitsinler!
Dialogue: 0,0:17:51.75,0:17:54.51,Main,,0,0,0,,Evet!
Dialogue: 0,0:17:54.51,0:17:58.15,Main,,0,0,0,,Evet!
Dialogue: 0,0:18:00.20,0:18:04.76,Captions,,0,0,175,,{\fad(450,0)}GÜLÜCÜK Fabrikası
Dialogue: 0,0:18:04.76,0:18:08.23,Captions,,0,0,350,,{\fad(200,200)}İç Kısım{\fad(200,200)}
Dialogue: 0,0:18:08.56,0:18:12.92,Main,,0,0,0,,SAD tankını siz mi devirdiniz?!
Dialogue: 0,0:18:12.92,0:18:15.39,Main,,0,0,0,,Kaldırın çabuk!
Dialogue: 0,0:18:15.39,0:18:16.58,Main,,0,0,0,,İyi misin?
Dialogue: 0,0:18:16.58,0:18:19.46,Main,,0,0,0,,Yapmayın lütfen! O ani deprem yüzünden...
Dialogue: 0,0:18:19.46,0:18:21.31,Main,,0,0,0,,...tank kendi kendine devrildi!
Dialogue: 0,0:18:21.31,0:18:22.44,Main,,0,0,0,,Öyle oldu!
Dialogue: 0,0:18:22.44,0:18:24.54,Main,,0,0,0,,Az önceki sarsıntı da neyin nesiydi öyle?
Dialogue: 0,0:18:24.54,0:18:27.40,Main,,0,0,0,,Kapa çeneni! Hem size ne bir kere?!
Dialogue: 0,0:18:27.40,0:18:28.20,Main,,0,0,0,,Ama...
Dialogue: 0,0:18:28.20,0:18:32.86,Main,,0,0,0,,Prenses Mancherie'nin hastalığını\Niyileştirmek istemiyor musunuz?!
Dialogue: 0,0:18:32.86,0:18:34.92,Main,,0,0,0,,İstiyorsunuz değil mi?
Dialogue: 0,0:18:34.92,0:18:39.16,Main,,0,0,0,,Elbette istiyoruz!\NPrenses şu anda nasıl acaba?!
Dialogue: 0,0:18:40.12,0:18:42.15,Main,,0,0,0,,Şey...
Dialogue: 0,0:18:42.15,0:18:45.60,Main,,0,0,0,,Maalesef prensesin hastalığı\Nhiç ama hiç iyileşmiyor!
Dialogue: 0,0:18:45.60,0:18:47.06,Main,,0,0,0,,İyileşmiyor!
Dialogue: 0,0:18:47.06,0:18:48.40,Main,,0,0,0,,Ne?!
Dialogue: 0,0:18:48.40,0:18:51.28,Main,,0,0,0,,Yalvarıyoruz, prensesi gösterin bize!
Dialogue: 0,0:18:51.28,0:18:53.58,Main,,0,0,0,,Amma can sıktınız be!
Dialogue: 0,0:18:54.74,0:18:56.90,Main,,0,0,0,,Çenenizi kapayıp\Nişinizin başına dönün!
Dialogue: 0,0:19:01.20,0:19:02.70,Main,,0,0,0,,{\i1}Bunlar...{\i0}
Dialogue: 0,0:19:03.52,0:19:08.32,Main,,0,0,0,,Dırdır etmeyi bırakın da\NGÜLÜCÜK yapmaya devam edin!
Dialogue: 0,0:19:09.02,0:19:12.29,Note,,0,0,0,,KAPININ KİLİDİNİ...
Dialogue: 0,0:19:17.17,0:19:18.42,Note,,0,0,0,,KAPININ KİLİDİNİ...
Dialogue: 0,0:19:13.54,0:19:17.72,Main,,0,0,0,,Ne yapıyorsunuz?!\Nİşinizin başına dönün dedik!
Dialogue: 0,0:19:17.72,0:19:21.12,Main,,0,0,0,,Bön bön bakmayı bırakın!\NDuymuyor musunuz beni?!
Dialogue: 0,0:19:21.81,0:19:22.97,Note,,0,0,0,,...İÇERİDEN AÇIN!
Dialogue: 0,0:19:23.13,0:19:24.24,Main,,0,0,0,,{\i1}Bu sözler...{\i0}
Dialogue: 0,0:19:24.24,0:19:28.59,Note,,0,0,0,,{\fad(0,500)}...İÇERİDEN AÇIN!
Dialogue: 0,0:19:34.49,0:19:36.52,Main,,0,0,0,,{\i1}Pembe arılar bunlar!{\i0}
Dialogue: 0,0:19:37.48,0:19:38.36,Main,,0,0,0,,{\i1}Bian!{\i0}
Dialogue: 0,0:19:40.50,0:19:42.10,Main,,0,0,0,,{\i1}Inhel! Wicka!{\i0}
Dialogue: 0,0:19:42.55,0:19:44.53,Main,,0,0,0,,Bizi gördüler, Bian!
Dialogue: 0,0:19:44.53,0:19:48.98,Main,,0,0,0,,Tamamdır!\NPembe Arılar, sıradaki mesajı iletin!
Dialogue: 0,0:19:55.50,0:19:57.61,Note,,0,0,0,,KANDIRILDIK!
Dialogue: 0,0:19:57.61,0:20:00.41,Main,,0,0,0,,{\i1}Ne?\NKandırıldık mı?{\i0}
Dialogue: 0,0:20:00.41,0:20:01.88,Main,,0,0,0,,{\i1}Nasıl yani?{\i0}
Dialogue: 0,0:20:02.13,0:20:05.91,Main,,0,0,0,,Kime diyorum ben,\Nkulaklarınız duymuyor mu?!
Dialogue: 0,0:20:05.91,0:20:09.80,Main,,0,0,0,,{\i1}Kandırıldık mı? Prensesin hastalığından mı\Nbahsediyorlar acaba?{\i0}
Dialogue: 0,0:20:09.80,0:20:13.54,Main,,0,0,0,,{\i1}Doflamingo bizi kandırmış.{\i0}
Dialogue: 0,0:20:15.57,0:20:17.17,Note,,0,0,0,,SAVAŞIN!!!
Dialogue: 0,0:20:17.96,0:20:21.54,Main,,0,0,0,,Anlaşılan kırbaç az geldi size.
Dialogue: 0,0:20:21.54,0:20:25.52,Main,,0,0,0,,{\i1}Tam olarak anlamasam da\Nkesin olan tek bir şey var...{\i0}
Dialogue: 0,0:20:27.04,0:20:29.38,Main,,0,0,0,,Dostlar yalan söylemez!
Dialogue: 0,0:20:31.98,0:20:32.68,Main,,0,0,0,,Kapa çeneni!
Dialogue: 0,0:20:32.68,0:20:34.25,Main,,0,0,0,,Sanshita!
Dialogue: 0,0:20:46.23,0:20:49.33,Captions,,0,0,180,,{\fad(600,0)}Kraliyet Sarayı Platosu - Seviye 2
Dialogue: 0,0:21:00.40,0:21:01.96,Main,,0,0,0,,Hasır Şapka!
Dialogue: 0,0:21:03.02,0:21:05.79,Main,,0,0,0,,Kabak, gene bana engel mi olacaksın?!
Dialogue: 0,0:21:05.79,0:21:07.46,Main,,0,0,0,,Hayır...
Dialogue: 0,0:21:08.60,0:21:09.60,Main,,0,0,0,,Atla.
Dialogue: 0,0:21:09.60,0:21:10.59,Main,,0,0,0,,Ne?
Dialogue: 0,0:21:10.59,0:21:13.54,Main,,0,0,0,,Mecburiyetten\Nseni de yanımda götüreceğim!
Dialogue: 0,0:21:13.54,0:21:14.83,Main,,0,0,0,,Emin misin?!
Dialogue: 0,0:21:14.83,0:21:17.42,Main,,0,0,0,,Çabucak Doflamingo'ya erişmek\Nistemiyor musun?
Dialogue: 0,0:21:17.42,0:21:18.86,Main,,0,0,0,,Pekâlâ öyleyse!
Dialogue: 0,0:21:18.86,0:21:20.70,Main,,0,0,0,,Hazırım, gidelim!
Dialogue: 0,0:21:20.70,0:21:23.18,Main,,0,0,0,,Teşekkür nedir bilmez misin sen be?!
Dialogue: 0,0:21:23.18,0:21:24.32,Main,,0,0,0,,Boşver onu şimdi, gidelim!
Dialogue: 0,0:21:24.32,0:21:26.15,Main,,0,0,0,,Emir vermesene!
Dialogue: 0,0:21:26.15,0:21:27.86,Main,,0,0,0,,Gidelim, Farul!
Dialogue: 0,0:21:28.52,0:21:32.12,Main,,0,0,0,,Yöneticilere yakalanacak olursak\Nburada zaman kaybederiz anlıyor musun?
Dialogue: 0,0:21:32.12,0:21:36.54,Main,,0,0,0,,Duvarı kesip bize yol açacağım, sen de\No sırada gördüğün herkesin canına oku!
Dialogue: 0,0:21:36.54,0:21:37.24,Main,,0,0,0,,Tamamdır!
Dialogue: 0,0:21:37.42,0:21:39.99,Main,,0,0,0,,Ondan sonra da doğrudan\Nüçüncü seviyeye varacağız...
Dialogue: 0,0:21:39.99,0:21:42.84,Main,,0,0,0,,De sen kimsin ulan?!
Dialogue: 0,0:21:42.84,0:21:44.08,Main,,0,0,0,,Asker!
Dialogue: 0,0:21:44.08,0:21:44.98,Main,,0,0,0,,Ne ara bindin?!
Dialogue: 0,0:21:44.98,0:21:45.84,Main,,0,0,0,,Az önce!
Dialogue: 0,0:21:45.84,0:21:48.75,Main,,0,0,0,,Luffyland'ın açtığı yolu takip ettim!
Dialogue: 0,0:21:49.12,0:21:50.34,Main,,0,0,0,,Fazla takip etmişsin!
Dialogue: 0,0:21:50.34,0:21:52.48,Main,,0,0,0,,Ne güzel işte, ben de seni arıyordum!
Dialogue: 0,0:21:52.48,0:21:55.42,Main,,0,0,0,,Arkadaşı bile olsan\Nfazla ağır olduk böyle, in!
Dialogue: 0,0:21:55.42,0:21:58.00,Main,,0,0,0,,Tepede Rebecca'yla buluşacağız!
Dialogue: 0,0:21:58.22,0:22:01.74,Main,,0,0,0,,Rebecca düşmanın avlusuna mı gelmiş?!\NNiye durdurmadın?
Dialogue: 0,0:22:01.74,0:22:03.26,Main,,0,0,0,,Beni dinleyen var mı?!
Dialogue: 0,0:22:03.26,0:22:06.44,Main,,0,0,0,,Dördüncü kattaki\NAyçiçeği Tarlası'nda buluşacağız.
Dialogue: 0,0:22:06.44,0:22:09.14,Main,,0,0,0,,O da suçlular listesinde!
Dialogue: 0,0:22:09.38,0:22:11.88,Main,,0,0,0,,Endişelenme!\NDostlarım onunla birlikteler!
Dialogue: 0,0:22:11.88,0:22:16.53,Main,,0,0,0,,Kime diyorum?! Biricik atım Farul\Ngüzel düsturunu bozmadan yalnızca iki kişi taşıyabilir.
Dialogue: 0,0:22:16.53,0:22:20.03,Thoughts,,0,0,0,,{\i1}Boğanın sırtında daha rahattık.{\i0}
Dialogue: 0,0:22:20.03,0:22:23.57,Main,,0,0,0,,O değil de ihtiyar,\Nniye tek başına çekip gittin?
Dialogue: 0,0:22:23.57,0:22:27.70,Main,,0,0,0,,Durum ne olursa olsun\Nyapmam gereken bir şey var!
Dialogue: 0,0:22:27.70,0:22:31.44,Main,,0,0,0,,Doflamingo'yu yenecek\Nve ülkeyi geri alacağım!
Dialogue: 0,0:22:31.76,0:22:33.78,Main,,0,0,0,,Ve bir şey daha...
Dialogue: 0,0:22:33.78,0:22:39.30,Main,,0,0,0,,Ailenin Üst Düzey Yöneticileri arasında ne pahasına olursa olsun canını almak istediğim biri var!
Dialogue: 0,0:22:40.24,0:22:43.03,Main,,0,0,0,,İhtiyar, ölmeyi planlamıyorsun değil mi?
Dialogue: 0,0:22:43.03,0:22:46.14,Main,,0,0,0,,Saçmalama! Bu insan bedeniyle\Nyenilmeme imkan yok!
Dialogue: 0,0:22:46.14,0:22:47.28,Main,,0,0,0,,Pekâlâ öyleyse!
Dialogue: 0,0:22:47.28,0:22:48.86,Main,,0,0,0,,Neresi iyi be, inin dedim!
Dialogue: 0,0:22:48.86,0:22:50.24,Main,,0,0,0,,Ne be, sen in asıl!
Dialogue: 0,0:22:50.24,0:22:52.62,Main,,0,0,0,,Ne saçmalıyorsun sen!?\Nİğrenç birisin!
Dialogue: 0,0:22:52.62,0:22:54.54,Main,,0,0,0,,Harbiden de Musibet Nesle yaraşır birisin!
Dialogue: 0,0:22:54.54,0:22:57.29,Main,,0,0,0,,Dikkat etsene biraz!\NÖnüne bak önüne!
Dialogue: 0,0:22:57.54,0:23:00.68,Main,,0,0,0,,Emir verme dedik sana!
Dialogue: 0,0:23:02.72,0:23:03.62,Main,,0,0,0,,Ne?!
Dialogue: 0,0:23:03.62,0:23:05.20,Main,,0,0,0,,Bu...
Dialogue: 0,0:23:06.98,0:23:10.37,Main,,0,0,0,,Devam et, Hasır Şapka!
Dialogue: 0,0:23:11.23,0:23:13.55,Main,,0,0,0,,Biz onlarla ilgileneceğiz!
Dialogue: 0,0:23:13.55,0:23:16.65,Main,,0,0,0,,Ne oldu-in?!\NBunlar birden...
Dialogue: 0,0:23:16.65,0:23:19.72,Main,,0,0,0,,Daha demine kadar\Nbirbirleriyle kavga ediyorlardı!
Dialogue: 0,0:23:19.72,0:23:23.19,Main,,0,0,0,,Ne oldu?\NNeden yapıyorsunuz bunu?
Dialogue: 0,0:23:24.53,0:23:28.15,Main,,0,0,0,,Ben askeri taktikçi Dagama\Nve şu an savaştayız!
Dialogue: 0,0:23:28.15,0:23:32.32,Main,,0,0,0,,Herkes körlemesine burnunun dikine giderse\Nzirveye kimse ulaşamaz!
Dialogue: 0,0:23:33.27,0:23:40.33,Main,,0,0,0,,Dagama'ya güvenmesem de, biz yöneticilerle ilgilenirken \NHasır Şapka'yı zirveye yollama fikrine katılıyorum!
Dialogue: 0,0:23:40.33,0:23:43.77,Main,,0,0,0,,Burasını bize bırak ve git!
Dialogue: 0,0:23:43.77,0:23:46.74,Main,,0,0,0,,Onu tepeye ulaştırdığına emin ol, Cavendish!
Dialogue: 0,0:23:46.90,0:23:49.73,Main,,0,0,0,,Toplu taşımacılık yapmıyoruz burada!
Dialogue: 0,0:23:49.73,0:23:53.96,Main,,0,0,0,,Bu savaşı kazanmalıyız!
Dialogue: 0,0:24:00.40,0:24:02.01,Main,,0,0,0,,Gitme zamanı!
Dialogue: 0,0:24:03.85,0:24:06.48,Main,,0,0,0,,Emirleri o veriyor anlaşılan.
Dialogue: 0,0:24:06.48,0:24:08.19,Main,,0,0,0,,Epey can sıkıcı biri!
Dialogue: 0,0:24:19.96,0:24:21.56,Main,,0,0,0,,{\i1}Daruma!{\i0}
Dialogue: 0,0:24:23.36,0:24:26.92,Main,,0,0,0,,Ne yapıyorsun...\NBırak beni lanet olası!
Dialogue: 0,0:24:29.07,0:24:33.94,Main,,0,0,0,,Zirveye ulaş, Hasır Şapka!
Dialogue: 0,0:24:35.98,0:24:37.70,Main,,0,0,0,,Vurun!
Dialogue: 0,0:24:37.70,0:24:40.24,Main,,0,0,0,,Ne pahasına olursa olsun uzak tutun!
Dialogue: 0,0:24:47.30,0:24:50.46,Main,,0,0,0,,{\fad(150,150)}Güzellik Kılıcı!\NSaint-Exupéry!
Dialogue: 0,0:24:56.24,0:25:01.20,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no\NJet Mitralyöz!
Dialogue: 0,0:25:12.30,0:25:15.99,Credits,,0,0,0,,Editing: Galaxy 9000\NTiming: Datenshi\NQC: Mr. Luffy, Sewil\NSoundtracking: Halee\NTC/Infoboxes: Datenshi
