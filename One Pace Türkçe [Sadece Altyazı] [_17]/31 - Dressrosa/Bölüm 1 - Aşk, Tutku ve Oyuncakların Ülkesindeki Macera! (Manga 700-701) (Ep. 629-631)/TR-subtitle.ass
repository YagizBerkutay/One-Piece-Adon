,0,0,0,100,100,0,0,1,1,1,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:23.75,0:00:28.07,Credits,,0,0,0,,Translation & initial timing CrunchyrollDialogue: 0,0:00:28.15,0:00:32.16,Credits,,0,0,0,,Timing Galaxy 9000  Time-checking SewilDialogue: 0,0:00:34.66,0:00:37.60,Credits,,0,0,0,,Quality-checking Sewil Galaxy 9000 FeesoDialogue: 0,0:00:39.03,0:00:42.63,Credits,,0,0,0,,Soundtracking HaleeDialogue: 0,0:00:45.50,0:00:48.17,Credits,,0,0,0,,Video editing SewilDialogue: 0,0:01:00.42,0:01:04.52,Credits,,0,0,0,,Raw provider CrunchyrollDialogue: 0,0:01:05.29,0:01:10.75,Credits,,0,0,0,,Scroll infobox artist sergiart.deviantart.comDialogue: 0,0:00:01.26,0:00:03.90,Wake up! lyrics,,0,0,0,,♪ Gidelim tüm parıltımızla, koşar adım, sonsuza dek! ♪Dialogue: 0,0:00:03.93,0:00:06.66,Wake up! lyrics,,0,0,0,,♪ İlerlemeye devam edelim! ♪Dialogue: 0,0:00:06.70,0:00:09.57,Wake up! lyrics,,0,0,0,,♪ Değişmeyen bağlar mutlak aydınlatacak... ♪Dialogue: 0,0:00:09.63,0:00:12.67,Wake up! lyrics,,0,0,0,,♪ ...rüyamızın sonunu! ♪Dialogue: 0,0:00:12.77,0:00:15.27,Wake up! lyrics,,0,0,0,,♪ Uyan, uyan, uyan, uyan haydi kalbim! ♪Dialogue: 0,0:00:15.34,0:00:18.18,Wake up! lyrics,,0,0,0,,♪ Başaracağız! Durmaksızın devam! ♪Dialogue: 0,0:00:23.72,0:00:28.07,Wake up! lyrics,,0,0,0,,♪ Tek pusulamız özgürlüktür. En sıkı dostlarız. ♪Dialogue: 0,0:00:28.15,0:00:34.59,Wake up! lyrics,,0,0,0,,♪ Kendi rotamızı bundan sonra da yine kendimiz çizeceğiz. ♪Dialogue: 0,0:00:34.66,0:00:39.00,Wake up! lyrics,,0,0,0,,♪ Her gün tam hız ilerliyoruz. Doğuya git, batıya git. ♪Dialogue: 0,0:00:39.06,0:00:45.44,Wake up! lyrics,,0,0,0,,♪ Birbiri ardına yapmak istediğimiz şeyler buluyor ve yapıyoruz da hepsini. ♪Dialogue: 0,0:00:45.50,0:00:50.99,Wake up! lyrics,,0,0,0,,♪ Sabahları etmeye dayanamaz aceleci gönlümüz. (Bekleyemem!) ♪Dialogue: 0,0:00:51.11,0:00:56.05,Wake up! lyrics,,0,0,0,,♪ Neden alıp biz yapıştırmıyoruz güneşi göğe. ♪Dialogue: 0,0:00:56.11,0:00:58.95,Wake up! lyrics,,0,0,0,,♪ Zorla ve yola çıkmıyoruz! ♪Dialogue: 0,0:00:59.95,0:01:02.65,Wake up! lyrics,,0,0,0,,♪ Evet tüm parıltımızla, koşar adım, sonsuza dek! ♪Dialogue: 0,0:01:02.72,0:01:06.59,Wake up! lyrics,,0,0,0,,♪ Hayal kırıntılarımız birleştirerek. ♪Dialogue: 0,0:01:06.66,0:01:10.75,Wake up! lyrics,,0,0,0,,♪ Titretiyorsa eğer gönlünü var mı daha büyük hazine. ♪Dialogue: 0,0:01:10.83,0:01:13.43,Wake up! lyrics,,0,0,0,,♪ Gidelim tüm parıltımızla, koşar adım, sonsuza dek! ♪Dialogue: 0,0:01:13.50,0:01:16.13,Wake up! lyrics,,0,0,0,,♪ İlerlemeye devam edelim! ♪Dialogue: 0,0:01:16.20,0:01:19.17,Wake up! lyrics,,0,0,0,,♪ Değişmeyen bağlar mutlak aydınlatacak... ♪Dialogue: 0,0:01:19.24,0:01:22.24,Wake up! lyrics,,0,0,0,,♪ ...rüyamızın sonunu! ♪Dialogue: 0,0:01:22.31,0:01:24.94,Wake up! lyrics,,0,0,0,,♪ Uyan, uyan, uyan, uyan haydi kalbim ♪Dialogue: 0,0:01:25.01,0:01:27.41,Wake up! lyrics,,0,0,0,,♪ Başaracağız! Durmaksızın devam! ♪Dialogue: 0,0:01:29.41,0:01:32.85,Main,,0,0,0,,Karanlığa kapıl, Hasır Şapka!Dialogue: 0,0:01:33.38,0:01:42.09,Main,,0,0,0,,Yenilmeyeceğim! One Piece'i bulacak ve Korsanlar Kralı olacağım!Dialogue: 0,0:01:44.16,0:01:49.43,Wake up! lyrics,,0,0,0,,♪ Üstesinden geldiğimiz her zorluk arttırıyor olasılıkları. (Kalamam!) ♪Dialogue: 0,0:01:49.60,0:01:54.67,Wake up! lyrics,,0,0,0,,♪ Yarın da, öbürgün de... ♪Dialogue: 0,0:01:54.69,0:01:58.68,Wake up! lyrics,,0,0,0,,♪ Yaşayacağız o içimizi titreten yoğun heyecanı! ♪Dialogue: 0,0:01:58.71,0:02:01.15,Wake up! lyrics,,0,0,0,,♪ Evet tüm parıltımızla, koşar adım, sonsuza dek! ♪Dialogue: 0,0:02:01.21,0:02:05.25,Wake up! lyrics,,0,0,0,,♪ Merakının peşinden koşarken... ♪Dialogue: 0,0:02:05.32,0:02:09.35,Wake up! lyrics,,0,0,0,,♪ Git kaderinin götürdüğü yere keza budur macera dediğin. ♪Dialogue: 0,0:02:09.39,0:02:12.06,Wake up! lyrics,,0,0,0,,♪ Gidelim tüm parıltımızla, koşar adım, sonsuza dek! ♪Dialogue: 0,0:02:12.09,0:02:14.76,Wake up! lyrics,,0,0,0,,♪ Aç kalbinin rota haritasını... ♪Dialogue: 0,0:02:14.79,0:02:17.80,Wake up! lyrics,,0,0,0,,♪ Güçle olan o bağın ele geçirecek... ♪Dialogue: 0,0:02:17.86,0:02:20.93,Wake up! lyrics,,0,0,0,,♪ ...rüyanın sonunu! ♪Dialogue: 0,0:02:20.97,0:02:23.50,Wake up! lyrics,,0,0,0,,♪ Asla, asla, asla, asla engel olma! ♪Dialogue: 0,0:02:23.57,0:02:26.34,Wake up! lyrics,,0,0,0,,♪ Başaracağız! Durmaksızın devam! ♪Dialogue: 0,0:02:30.03,0:02:40.03,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gnsDialogue: 0,0:16:00.00,0:16:10.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gnsDialogue: 0,0:29:30.00,0:29:40.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gnsDialogue: 0,0:02:30.03,0:02:35.83,Title,,0,0,0,,Aşk, Tutku ve Oyuncakların Ülkesindeki Macera!Dialogue: 0,0:02:36.36,0:02:38.57,Main,,0,0,0,,Bütün büyük dalgalar...Dialogue: 0,0:02:40.46,0:02:43.68,Main,,0,0,0,,...dikkate değmez o küçük dalgacıklarla başlar.Dialogue: 0,0:02:46.14,0:02:51.12,Main,,0,0,0,,Hey! Bizim Don Quixote ailesiyle olan silah anlaşmamıza ne olacak peki şimdi?!Dialogue: 0,0:02:54.32,0:02:58.41,Main,,0,0,0,,Ulaşmaya çalışıyorum fakat kimse açmıyor!Dialogue: 0,0:02:58.41,0:02:59.26,Main,,0,0,0,,Ne yapacağız şimdi?!Dialogue: 0,0:03:00.05,0:03:05.34,Main,,0,0,0,,Şaka mı bu be?! Silah olmazsa bu savaşı kazanamayız!Dialogue: 0,0:03:06.08,0:03:08.13,Main,,0,0,0,,Hey, hey, bu da ne böyle?!Dialogue: 0,0:03:08.13,0:03:11.80,Main,,0,0,0,,İki yıl öncesinin serseri çaylakları ittifak kurmuşlar!Dialogue: 0,0:03:14.41,0:03:16.64,Main,,0,0,0,,Kesin bir şeylerin peşindeler!Dialogue: 0,0:03:17.04,0:03:19.61,Main,,0,0,0,,Doflamingo Shichibukai'lıktan istifa etmiş!Dialogue: 0,0:03:19.61,0:03:23.32,Main,,0,0,0,,Neden yapmış peki? Başka hiçbir şey yazmıyor mu?Dialogue: 0,0:03:23.32,0:03:26.72,Main,,0,0,0,,Bizim ittifakı nereden öğrenmiş ki bunlar?!Dialogue: 0,0:03:26.72,0:03:29.99,Captions,,0,0,190,,Yeni Dünya: Kid Korsanlarının SığınağıDialogue: 0,0:03:26.72,0:03:29.99,Main,,0,0,0,,Absa isimli bağımsız yazar da kimin nesi?!Dialogue: 0,0:03:30.26,0:03:33.36,Main,,0,0,0,,Son günlerde bomba üstüne bomba patlatıyor!Dialogue: 0,0:03:33.36,0:03:37.20,Main,,0,0,0,,Bizimle ilgili haberi boşverin, asıl mesele öteki haber.Dialogue: 0,0:03:37.58,0:03:40.30,Main,,0,0,0,,Hasır Şapka'yla Trafalgar...Dialogue: 0,0:03:40.30,0:03:44.19,Main,,0,0,0,,Onların da bizim gibi Yonkou'lardan birinin peşinde olduğuna şüphe yok.Dialogue: 0,0:03:45.01,0:03:48.21,Main,,0,0,0,,Peki ama hangisinin peşindeler?Dialogue: 0,0:03:48.25,0:03:51.41,Captions,,0,0,190,,DressrosaDialogue: 0,0:03:48.21,0:03:50.02,Main,,0,0,0,,Majesteleri!Dialogue: 0,0:03:58.60,0:04:02.05,Main,,0,0,0,,Benim. Shichibukai'lıktan istifa ettim.Dialogue: 0,0:04:02.05,0:04:03.87,Main,,0,0,0,,- Açtı işte! - Açtı!Dialogue: 0,0:04:03.87,0:04:05.01,Main,,0,0,0,,Doflamingo!?Dialogue: 0,0:04:07.88,0:04:09.19,Main,,0,0,0,,Duyacak şimdi bizi!Dialogue: 0,0:04:09.43,0:04:12.00,Main,,0,0,0,,Alo, ben Monkey D. Luffy!Dialogue: 0,0:04:12.00,0:04:14.15,Main,,0,0,0,,Korsanlar kralı olacak adam!Dialogue: 0,0:04:14.78,0:04:16.40,Main,,0,0,0,,Kapa çeneni dedik sana!Dialogue: 0,0:04:16.40,0:04:17.70,Main,,0,0,0,,Hey, Mingo!Dialogue: 0,0:04:17.70,0:04:23.11,Main,,0,0,0,,Kahverengisakal'a ve çocuklara eziyet eden aptal Caesar'ın patronu sen misin?Dialogue: 0,0:04:23.11,0:04:28.18,Main,,0,0,0,,Caesar'ı söz verdiğimiz gibi iade edeceğiz ama gene öyle bir şey yapacak olursanız...Dialogue: 0,0:04:28.18,0:04:30.52,Main,,0,0,0,,...bu sefer gelir senin canına okurum!Dialogue: 0,0:04:31.01,0:04:32.80,Main,,0,0,0,,Hasır Şapkalı Luffy.Dialogue: 0,0:04:34.20,0:04:39.14,Main,,0,0,0,,Ağabeyinin ölümünden sonra iki yıl kayıplara karıştın.Dialogue: 0,0:04:39.14,0:04:40.98,Main,,0,0,0,,Neredeydin, neler yapıyordun?Dialogue: 0,0:04:41.35,0:04:44.36,Main,,0,0,0,,Bu konudan kimselere bahsedemem!Dialogue: 0,0:04:46.60,0:04:49.03,Main,,0,0,0,,Seninle görüşmek istemiştim.Dialogue: 0,0:04:49.03,0:04:50.34,Main,,0,0,0,,Ne?Dialogue: 0,0:04:50.57,0:04:56.27,Main,,0,0,0,,Çok isteyeceğin bir şey var elimde.Dialogue: 0,0:04:56.83,0:04:58.54,Main,,0,0,0,,H-Hey!Dialogue: 0,0:04:58.54,0:05:02.75,Main,,0,0,0,,Ne denli leziz bir etten bahsediyorsun?!Dialogue: 0,0:05:02.75,0:05:05.55,Main,,0,0,0,,Hasır Şapka-ya, kendini ona kaptırma!Dialogue: 0,0:05:05.80,0:05:08.78,Main,,0,0,0,,Bir parça et! İki parça et!Dialogue: 0,0:05:08.78,0:05:09.55,Main,,0,0,0,,Luffy!Dialogue: 0,0:05:09.55,0:05:11.29,Main,,0,0,0,,Kendine gel!Dialogue: 0,0:05:11.29,0:05:13.49,Main,,0,0,0,,Adamın özel saldırısı olan "Kaptırma" bu!Dialogue: 0,0:05:13.49,0:05:16.55,Main,,0,0,0,,Joker, gereksiz konuşmaları kes!Dialogue: 0,0:05:16.55,0:05:19.60,Main,,0,0,0,,Söz verdiğimiz gibi Caesar'ı geri vereceğiz.Dialogue: 0,0:05:19.60,0:05:22.57,Main,,0,0,0,,İyiliğiniz için böylesi daha iyi olur elbette.Dialogue: 0,0:05:22.57,0:05:24.70,Main,,0,0,0,,Onunla beraber kaçmaya çalışacak olursanız...Dialogue: 0,0:05:24.70,0:05:29.27,Main,,0,0,0,,...bu sefer başınıza neler geleceğini çok iyi biliyorsunuz.Dialogue: 0,0:05:31.05,0:05:37.24,Main,,0,0,0,,Şimdi her şeyden önce kıymetli iş ortağımın sesini duymak istiyorum.Dialogue: 0,0:05:38.69,0:05:40.76,Main,,0,0,0,,Joker, bağışla!Dialogue: 0,0:05:40.76,0:05:42.95,Main,,0,0,0,,Benim için Shichibukai'lıktan çekilmişsin!Dialogue: 0,0:05:43.63,0:05:45.62,Main,,0,0,0,,Şu andan itibaren sekiz saat sonra...Dialogue: 0,0:05:45.62,0:05:47.90,Main,,0,0,0,,...Dressrosa'nın kuzeyindeki...Dialogue: 0,0:05:47.90,0:05:50.90,Main,,0,0,0,,...ıssız ada Green Bit'in güney doğu kumsalı...Dialogue: 0,0:05:51.20,0:05:54.67,Main,,0,0,0,,Caesar'ı öğleden sonra saat üçte oraya bırakacağız.Dialogue: 0,0:05:54.67,0:05:59.00,Main,,0,0,0,,İstediğin gibi alırsın artık, işimiz o noktada bitmiş olacak.Dialogue: 0,0:06:00.63,0:06:05.14,Main,,0,0,0,,Yazık oldu, keşke şöyle karşılıklı birkaç kadeh yuvarlayabilseydik.Dialogue: 0,0:06:05.14,0:06:06.59,Main,,0,0,0,,Kapat artık!Dialogue: 0,0:06:10.17,0:06:11.55,Main,,0,0,0,,Gidiciydik az daha!Dialogue: 0,0:06:12.00,0:06:14.92,Main,,0,0,0,,Resmen adamın dediklerine kaptırdınız kendinizi.Dialogue: 0,0:06:14.92,0:06:16.49,Main,,0,0,0,,Gözlerin, gözlerin!Dialogue: 0,0:06:17.53,0:06:18.76,Main,,0,0,0,,Hey, durun biraz!!Dialogue: 0,0:06:18.76,0:06:20.79,Main,,0,0,0,,Yanında kaç adam getirebileceğini söylemedik ona!Dialogue: 0,0:06:21.69,0:06:23.34,Main,,0,0,0,,Kaç adam getirebileceğini mi?Dialogue: 0,0:06:23.34,0:06:27.90,Main,,0,0,0,,Tüm adamlarını peşine takıp gelirse ne yapacağız?Dialogue: 0,0:06:28.38,0:06:30.94,Main,,0,0,0,,Değişen bir şey olmayacak.Dialogue: 0,0:06:31.85,0:06:37.21,Main,,0,0,0,,Caesar'ı ona teslim etmek de onları o noktaya çekmek için planın bir parçası.Dialogue: 0,0:06:37.21,0:06:43.07,Main,,0,0,0,,Yani savunmasız bir haldeyken GÜLÜCÜK üretim tesisini yok etmeyi mi planlıyoruz diyorsun?Dialogue: 0,0:06:43.07,0:06:47.46,Main,,0,0,0,,Evet ama nerede olduğunu bilmiyoruz.Dialogue: 0,0:06:47.46,0:06:48.25,Main,,0,0,0,,Oldu mu şimdi!Dialogue: 0,0:06:49.89,0:06:51.42,Main,,0,0,0,,Endişelenmeyin!Dialogue: 0,0:06:51.42,0:06:56.53,Main,,0,0,0,,Fabrika dediğin büyük olur, görmeyip de ne yapacağız!Dialogue: 0,0:06:56.53,0:06:59.36,Main,,0,0,0,,Oraya varınca süper bir şekilde buluruz hemen!Dialogue: 0,0:06:59.70,0:07:02.57,Main,,0,0,0,,Işınımla yerlebir edeceğim orasını!Dialogue: 0,0:07:03.35,0:07:05.20,Main,,0,0,0,,Ağabey!Dialogue: 0,0:07:05.95,0:07:09.97,Main,,0,0,0,,Fabrika hariç her konuda bilgi toplamayı başarabildim.Dialogue: 0,0:07:09.97,0:07:11.76,Main,,0,0,0,,Şaşırmamak lazım.Dialogue: 0,0:07:11.76,0:07:13.61,Main,,0,0,0,,Düşman için önemli bir yapı sonuçta.Dialogue: 0,0:07:14.68,0:07:17.03,Main,,0,0,0,,Belki hatta bir tür gizem bile barındırıyordur.Dialogue: 0,0:07:17.31,0:07:18.37,Main,,0,0,0,,Law-dono!Dialogue: 0,0:07:18.37,0:07:23.62,Main,,0,0,0,,Az evvel Green Bit'e gittiğinizden bahsetmiştiniz!Dialogue: 0,0:07:23.62,0:07:27.46,Main,,0,0,0,,Gemiyi Dressrosa'ya demirleyeceğiz, içiniz rahat olsun.Dialogue: 0,0:07:27.46,0:07:31.51,Main,,0,0,0,,Trao, daha önce oraya gitmiş miydin hiç?Dialogue: 0,0:07:31.51,0:07:32.46,Main,,0,0,0,,Dress-roba!Dialogue: 0,0:07:33.10,0:07:35.23,Note,,0,0,0,,Roba: Yaşlı KadınDialogue: 0,0:07:35.23,0:07:36.84,Main,,0,0,0,,Rosa olacak o!Dialogue: 0,0:07:36.84,0:07:39.70,Main,,0,0,0,,Hiç gitmedim.Dialogue: 0,0:07:39.70,0:07:42.21,Main,,0,0,0,,O adi herifin krallığı orası.Dialogue: 0,0:07:42.21,0:07:45.42,Main,,0,0,0,,Madem öyle her şeyi yaşayarak öğreniriz biz de!Dialogue: 0,0:07:46.29,0:07:47.96,Main,,0,0,0,,Mükemmel bir macera olacak!Dialogue: 0,0:07:47.96,0:07:50.22,Main,,0,0,0,,Dressrosa'yı dört gözle bekliyorum!Dialogue: 0,0:07:50.77,0:07:53.45,Main,,0,0,0,,Yakın zamanda Wano Krallığı'na da gitmek istiyorum!Dialogue: 0,0:07:53.45,0:07:54.96,Main,,0,0,0,,Saçmalamasana!Dialogue: 0,0:07:54.96,0:07:56.82,Main,,0,0,0,,Öyle hiçbir plan yapmadan...Dialogue: 0,0:07:56.82,0:07:59.57,Main,,0,0,0,,Sanji, acıktım!Dialogue: 0,0:07:59.57,0:08:01.53,Main,,0,0,0,,Kahvaltıda ne var?Dialogue: 0,0:08:01.53,0:08:02.78,Main,,0,0,0,,Sandviç.Dialogue: 0,0:08:02.78,0:08:05.16,Main,,0,0,0,,Ben pamuk şekerli sandviç istiyorum!Dialogue: 0,0:08:05.16,0:08:07.47,Main,,0,0,0,,Ben bir fincan çay alayım sadece.Dialogue: 0,0:08:08.03,0:08:09.85,Main,,0,0,0,,Ekmek sevmem ben!Dialogue: 0,0:08:14.26,0:08:17.58,Main,,0,0,0,,Peşimizde neden birilerinin olduğunu size söyleyemem.Dialogue: 0,0:08:17.58,0:08:21.58,Main,,0,0,0,,Fakat aslen Zou denen bir yere doğru yelken açmıştık.Dialogue: 0,0:08:22.02,0:08:22.85,Main,,0,0,0,,Zou mu?Dialogue: 0,0:08:23.72,0:08:25.08,Main,,0,0,0,,O yeri biliyor musunuz?Dialogue: 0,0:08:25.08,0:08:27.40,Main,,0,0,0,,Rastlantı üzerine rastlantı.Dialogue: 0,0:08:27.40,0:08:31.60,Main,,0,0,0,,Caesar'ı geri verip, GÜLÜCÜK tesisini yok ettikten sonra...Dialogue: 0,0:08:31.60,0:08:34.06,Main,,0,0,0,,...Zou'ya yelken açmayı planlıyordum.Dialogue: 0,0:08:34.06,0:08:37.12,Main,,0,0,0,,Adamlarım oradalar.Dialogue: 0,0:08:40.06,0:08:44.98,Main,,0,0,0,,Ma-Madem öyle, oraya varana kadar sizinle kalabilir miyiz?Dialogue: 0,0:08:44.98,0:08:48.41,Main,,0,0,0,,Olur tabii! Önce oraya, oradan da Wano Krallığı'na gideriz!Dialogue: 0,0:08:48.41,0:08:49.39,Main,,0,0,0,,Hey!Dialogue: 0,0:08:50.34,0:08:53.02,Main,,0,0,0,,Diğer iki samuray ve Momonosuke'yle birlikte...Dialogue: 0,0:08:53.02,0:08:55.30,Main,,0,0,0,,...dört kişi olarak Zou'ya koyulmuştuk fakat...Dialogue: 0,0:08:55.30,0:09:00.97,Main,,0,0,0,,...gemimiz batınca diğerleri Momonosuke'yle birlikte Dressrosa'ya doğru sürüklendiler.Dialogue: 0,0:09:00.97,0:09:06.36,Main,,0,0,0,,Ama orada Doflamingo'lar tarafından kovalanınca...Dialogue: 0,0:09:06.36,0:09:09.74,Main,,0,0,0,,...rastgele bir gemiye biniverdim.Dialogue: 0,0:09:10.75,0:09:14.39,Main,,0,0,0,,Orada da tedavi edilmeyi bekleyen çocuklarla karşılaştım.Dialogue: 0,0:09:14.39,0:09:16.80,Main,,0,0,0,,Tam o sırada da gemi limandan ayrılıverdi...Dialogue: 0,0:09:16.80,0:09:19.84,Main,,0,0,0,,...ve birden kendimi o adaya doğru giderken buldum.Dialogue: 0,0:09:19.84,0:09:23.64,Flashbacks,,0,0,0,,- Baba! - Kahretsin! Momonosuke!Dialogue: 0,0:09:23.64,0:09:26.25,Main,,0,0,0,,Geminin peşinden gitmeye niyetlendim fakat...Dialogue: 0,0:09:26.25,0:09:29.96,Main,,0,0,0,,...samuray dostum Kanjuro beni korumaya çalışırken yakalandı.Dialogue: 0,0:09:29.96,0:09:34.27,Flashbacks,,0,0,0,,Momonosuke'nin peşine düş, beni düşünme!Dialogue: 0,0:09:37.02,0:09:40.83,Main,,0,0,0,,Ve denize açılmamı sağladı!Dialogue: 0,0:09:40.83,0:09:43.62,Main,,0,0,0,,Onu ne pahasına olursa olsun kurtarmalıyım!Dialogue: 0,0:09:43.62,0:09:45.95,Main,,0,0,0,,Ne pahasına olursa olsun geri dönmeliyim!Dialogue: 0,0:09:46.90,0:09:49.79,Main,,0,0,0,,Adamın hasıymış bu Kanjuro be!Dialogue: 0,0:09:49.79,0:09:51.20,Main,,0,0,0,,Kanjuro!Dialogue: 0,0:09:51.20,0:09:53.64,Main,,0,0,0,,Tamamdır, ben de onu kurtarmanıza yardım edeceğim!Dialogue: 0,0:09:53.64,0:09:56.87,Main,,0,0,0,,Bana bakın! Asıl amacımızı unutmayın!Dialogue: 0,0:10:04.59,0:10:08.59,Captions,,0,0,180,,Yeni DünyaDialogue: 0,0:10:13.22,0:10:17.01,Captions,,0,0,180,,Red Line YakınlarındaDialogue: 0,0:10:17.76,0:10:20.70,Captions,,0,0,180,,Donanma KarargahıDialogue: 0,0:10:21.12,0:10:25.27,Main,,0,0,0,,Dünyada yalnızca yedi adet Shichibukai mevcut!Dialogue: 0,0:10:25.61,0:10:27.73,Main,,0,0,0,,Dünya Hükümeti tarafından seçilip...Dialogue: 0,0:10:27.73,0:10:30.24,Main,,0,0,0,,...sualsiz güçleri ve kötü şöhretleri karşılığında...Dialogue: 0,0:10:30.65,0:10:36.21,Main,,0,0,0,,...hırsızlık için sınırsız özgürlük tanınmış korsanlar.Dialogue: 0,0:10:36.21,0:10:39.33,Main,,0,0,0,,Onların Hükümet tarafında yer alması da...Dialogue: 0,0:10:39.33,0:10:43.44,Main,,0,0,0,,...dünyadaki diğer tüm korsanlar için bir gözdağı anlamına geliyor.Dialogue: 0,0:10:43.44,0:10:45.66,Main,,0,0,0,,Dünyanın en iyi kılıç ustası...Dialogue: 0,0:10:47.26,0:10:50.16,Main,,0,0,0,,...Şahin Göz Dracule Mihawk!Dialogue: 0,0:10:50.16,0:10:53.94,Main,,0,0,0,,Dressrosa'nın kralı, karizmatik şeytan...Dialogue: 0,0:10:55.08,0:10:58.14,Main,,0,0,0,,...Eşsiz Şeytan Don Quixote Doflamingo!Dialogue: 0,0:10:58.61,0:11:00.70,Main,,0,0,0,,Kendisi şimdilerde Donanma'nın insani silahı...Dialogue: 0,0:11:01.94,0:11:04.64,Main,,0,0,0,,...Tiran Bartholomew Kuma!Dialogue: 0,0:11:05.96,0:11:07.98,Main,,0,0,0,,Amazon Lily'nin imparatoriçesi...Dialogue: 0,0:11:09.21,0:11:12.33,Main,,0,0,0,,...Korsan İmparatoriçe Boa Hancock!Dialogue: 0,0:11:12.33,0:11:16.40,Main,,0,0,0,,Musibet Nesil'den biri Rocky Limanı Olayı'nın arkasındaki kişi...Dialogue: 0,0:11:17.62,0:11:19.86,Main,,0,0,0,,...Ölüm Cerrahı Trafalgar Law!Dialogue: 0,0:11:19.86,0:11:24.21,Main,,0,0,0,,Bunların yanısıra geçtiğimiz iki yılda ani bir şekilde güçlenen bu adam...Dialogue: 0,0:11:25.16,0:11:27.85,Main,,0,0,0,,...Yıldız Palyaço Buggy!Dialogue: 0,0:11:28.67,0:11:34.62,Main,,0,0,0,,Ve size az önce bahsettiğim kişiyle yedi ediyorlar.Dialogue: 0,0:11:35.41,0:11:39.03,Main,,0,0,0,,Fakat her şey bu sabah allak bullak oldu.Dialogue: 0,0:11:39.03,0:11:42.00,Main,,0,0,0,,Doflamingo hiçbir neden olmaksızın istifa etti.Dialogue: 0,0:11:42.00,0:11:47.40,Main,,0,0,0,,Law'ı da peşinde olduğu şeye göre Shichibukai'lıktan kovmak zorunda kalabiliriz.Dialogue: 0,0:11:47.40,0:11:52.36,Main,,0,0,0,,Shichibukai'lar, Donanma ve Yonkou'larla Üç Büyük Güç faktöründen biri ve bu denge bozulmamalı.Dialogue: 0,0:11:52.36,0:11:56.11,Main,,0,0,0,,Evet, biliyorum Brandnew.Dialogue: 0,0:11:58.83,0:11:59.90,Main,,0,0,0,,Filo Amirali!Dialogue: 0,0:11:59.90,0:12:04.87,Main,,0,0,0,,Artık Law'ın da Hasır Şapka'nın da istediğini yapmasına izin verecek değilim.Dialogue: 0,0:12:04.87,0:12:10.73,Main,,0,0,0,,Dün G-5'in Koramirali Smoker'dan can sıkıcı bir telefon aldım.Dialogue: 0,0:12:10.73,0:12:13.48,Main,,0,0,0,,Bakalım işler bugünlük nasıl gidecek.Dialogue: 0,0:12:13.48,0:12:16.22,Main,,0,0,0,,Fujitora'yı yolladım!Dialogue: 0,0:12:13.48,0:12:16.22,Note,,0,0,0,,Fujitora: Wisteria KaplanıDialogue: 0,0:12:18.38,0:12:20.03,Main,,0,0,0,,Majesteleri!Dialogue: 0,0:12:18.66,0:12:22.29,Captions,,0,0,180,,DressrosaDialogue: 0,0:12:20.03,0:12:22.29,Main,,0,0,0,,Lütfen bizi bırakmayın!Dialogue: 0,0:12:22.29,0:12:25.92,Main,,0,0,0,,Trebol-sama, neredesin?!Dialogue: 0,0:12:27.42,0:12:29.37,Main,,0,0,0,,Trebol-sama'yı gördün mü?Dialogue: 0,0:12:29.37,0:12:30.29,Main,,0,0,0,,Görmedim.Dialogue: 0,0:12:31.45,0:12:34.34,Main,,0,0,0,,Acaba Genç Bey'imiz şimdi ne yapacak?Dialogue: 0,0:12:34.34,0:12:39.10,Main,,0,0,0,,Donanma saldıracaksa falan ben de savaşmak isterim!Dialogue: 0,0:12:39.10,0:12:42.47,Main,,0,0,0,,Genç Bey'imiz ne derse onu yapacağız.Dialogue: 0,0:12:42.47,0:12:45.61,Main,,0,0,0,,Baby 5!Dialogue: 0,0:12:48.52,0:12:50.01,Main,,0,0,0,,Orada ne işin var?!Dialogue: 0,0:12:50.01,0:12:53.55,Main,,0,0,0,,Şuna bak, krallık karmaşa içinde!Dialogue: 0,0:12:53.55,0:12:56.67,Main,,0,0,0,,Eminim tüm dünya yavaştan çalkalanmaya başlamıştır.Dialogue: 0,0:12:57.96,0:13:00.83,Main,,0,0,0,,Hey, hey!Dialogue: 0,0:13:00.83,0:13:05.98,Main,,0,0,0,,O değil de gene nişanlının ölümüne mi neden oldun?Dialogue: 0,0:13:09.15,0:13:10.12,Main,,0,0,0,,Çok yakın!Dialogue: 0,0:13:10.12,0:13:13.07,Main,,0,0,0,,Kaçıncıya soruyorsun aynı soruyu! Artık can sıkmaya başladın!Dialogue: 0,0:13:13.07,0:13:16.60,Main,,0,0,0,,Can sıkıyorum ama...Dialogue: 0,0:13:16.33,0:13:16.89,Secondary,,0,0,0,,- Çok yakın!Dialogue: 0,0:13:16.60,0:13:19.94,Main,,0,0,0,,Can sıkıyorum ama ne?Dialogue: 0,0:13:20.25,0:13:24.28,Main,,0,0,0,,Can sıkıyorum ama beni çok seviyorsun olabilir mi o?Dialogue: 0,0:13:24.28,0:13:27.49,Main,,0,0,0,,Yeter be, öf! Genç Bey'imiz çağırıyor!Dialogue: 0,0:13:28.03,0:13:30.47,Main,,0,0,0,,O şeyi getirmeni istedi.Dialogue: 0,0:13:30.47,0:13:32.27,Main,,0,0,0,,Yaklaşma! Bak kusacağım şimdi!Dialogue: 0,0:13:32.27,0:13:34.05,Main,,0,0,0,,Hey, hey, hey!Dialogue: 0,0:13:34.05,0:13:37.99,Main,,0,0,0,,İkide bir nişanlılarını öldürtüp duruyorsun Baby 5!Dialogue: 0,0:13:37.99,0:13:43.48,Main,,0,0,0,,Doffy'e kurban gidebilecek kişilerle nişanlanmayı bırak da benimle evlen!Dialogue: 0,0:13:45.19,0:13:47.31,Main,,0,0,0,,Şakaydı!Dialogue: 0,0:13:50.58,0:13:52.81,Main,,0,0,0,,Yoksa bana...Dialogue: 0,0:13:52.81,0:13:54.11,Main,,0,0,0,,...ihtiyacın mı var?Dialogue: 0,0:13:54.11,0:13:55.25,Main,,0,0,0,,Yeter!Dialogue: 0,0:13:58.12,0:14:02.35,Main,,0,0,0,,Kolezyum her daim tıklım tıklım.Dialogue: 0,0:14:02.35,0:14:05.66,Main,,0,0,0,,Bunu sana borçluyuz Diamante.Dialogue: 0,0:14:05.66,0:14:07.42,Main,,0,0,0,,O da ne demek yahu!Dialogue: 0,0:14:07.42,0:14:12.44,Main,,0,0,0,,Doffy, asıl teşekkürü böylesi karizmatik bir kral olan sana etmeliyiz.Dialogue: 0,0:14:12.44,0:14:13.80,Main,,0,0,0,,Hayır.Dialogue: 0,0:14:15.55,0:14:17.90,Main,,0,0,0,,Gücün sayesinde oluyor bunlar.Dialogue: 0,0:14:17.90,0:14:21.74,Main,,0,0,0,,Yapma şimdi! Kolezyumun kahramanıymışım gibi konuşuyorsun.Dialogue: 0,0:14:21.74,0:14:24.75,Main,,0,0,0,,Kolezyumun kahramanısın da ondan.Dialogue: 0,0:14:24.75,0:14:26.69,Main,,0,0,0,,Dur yahu, şımartıyorsun beni.Dialogue: 0,0:14:26.69,0:14:28.26,Main,,0,0,0,,İyi madem duralım.Dialogue: 0,0:14:28.26,0:14:30.85,Main,,0,0,0,,Madem o kadar ısrar ediyorsun kabul ediyorum!Dialogue: 0,0:14:30.85,0:14:35.19,Main,,0,0,0,,Evet, Kolezyumun kahramanıyım!Dialogue: 0,0:14:39.57,0:14:41.63,Main,,0,0,0,,Getirdim!Dialogue: 0,0:14:41.63,0:14:43.10,Main,,0,0,0,,Doffy, bu o şey mi?Dialogue: 0,0:14:43.10,0:14:44.73,Main,,0,0,0,,Çok yakınsın!Dialogue: 0,0:14:44.73,0:14:47.16,Main,,0,0,0,,Çok yakınım ama?Dialogue: 0,0:14:47.16,0:14:50.18,Main,,0,0,0,,Ama sevdim, otur.Dialogue: 0,0:14:54.83,0:14:58.74,Main,,0,0,0,,Hasır Şapkalı Luffy bunun varlığını öğrendiğinde...Dialogue: 0,0:14:58.74,0:15:01.44,Main,,0,0,0,,...mutlaka ele geçirmeye çalışacaktır.Dialogue: 0,0:15:01.44,0:15:06.15,Main,,0,0,0,,İttifak dediğin kimi kimi insana ayakbağı olur.Dialogue: 0,0:15:06.15,0:15:10.39,Main,,0,0,0,,Diamante, bunu sana emanet etmek istiyorum.Dialogue: 0,0:15:10.39,0:15:13.35,Main,,0,0,0,,Dur biraz Doffy, ben yapamam o işi.Dialogue: 0,0:15:13.35,0:15:16.39,Main,,0,0,0,,Hayır, sana emanet edeceğim.Dialogue: 0,0:15:16.39,0:15:18.88,Main,,0,0,0,,Yapma şimdi, sanki bir tür dahiymişim gibi konuşuyorsun.Dialogue: 0,0:15:18.88,0:15:22.87,Main,,0,0,0,,Bunu yalnızca senin gibi bir dahiye emanet edebilirim.Dialogue: 0,0:15:22.87,0:15:24.77,Main,,0,0,0,,Öyle deme şimdi!Dialogue: 0,0:15:24.77,0:15:26.72,Main,,0,0,0,,Peki madem, demeyeyim.Dialogue: 0,0:15:26.72,0:15:30.76,Main,,0,0,0,,Madem o kadar ısrar ediyorsun dahi olduğumu kabul etmekten başka seçeneğim kalmıyor!Dialogue: 0,0:15:30.76,0:15:36.30,Main,,0,0,0,,Evet, o gerzek Hasır Şapka'nın icabına elbette bakabilirim!Dialogue: 0,0:15:38.89,0:15:41.28,Main,,0,0,0,,Sana güveniyorum!Dialogue: 0,0:15:41.28,0:15:43.59,Main,,0,0,0,,Bunu görünce koşa koşa gelecek!Dialogue: 0,0:15:45.62,0:15:51.23,Main,,0,0,0,,Ağabeyi'nin gücü... Mera Mera Meyvesi.Dialogue: 0,0:15:51.23,0:15:55.00,Main,,0,0,0,,Başka kimselerin buna sahip olmasını istemez!Dialogue: 0,0:16:03.62,0:16:06.94,Main,,0,0,0,,Tayfa bir ada silüeti gördü.Dialogue: 0,0:16:08.31,0:16:11.07,Main,,0,0,0,,Bu taşlı ada da ne böyle?Dialogue: 0,0:16:13.60,0:16:15.72,Main,,0,0,0,,Dressrosa'ya vardık sonunda!Dialogue: 0,0:16:15.72,0:16:19.69,Main,,0,0,0,,Aptal bağırmasana! Doflamingo duyacak!Dialogue: 0,0:16:19.69,0:16:20.68,Main,,0,0,0,,Zor duyar!Dialogue: 0,0:16:20.68,0:16:24.99,Main,,0,0,0,,Seni kurtarmaya geliyoruz Kanjuro!Dialogue: 0,0:16:24.99,0:16:30.70,Main,,0,0,0,,Burası aşk ve tutku krallığı Dressrosa!Dialogue: 0,0:16:33.83,0:16:38.03,Captions,,0,0,180,,Dressrosa KıyılarıDialogue: 0,0:16:39.83,0:16:43.39,Main,,0,0,0,,Dressrosa'ya vardık sonunda!Dialogue: 0,0:16:43.39,0:16:48.46,Main,,0,0,0,,Sesin çok çıkıyor dedim sana Luffy! Düşman bölgesindeyiz yahu!Dialogue: 0,0:16:49.84,0:16:51.95,Main,,0,0,0,,Bu hafta ayrı bir...Dialogue: 0,0:16:51.95,0:16:53.94,Main,,0,0,0,,...süperim!Dialogue: 0,0:16:53.94,0:16:58.37,Main,,0,0,0,,Bir an önce o fabrikayı bulup sonra da bom!Dialogue: 0,0:16:59.27,0:17:01.54,Main,,0,0,0,,Hey! Aklıma çok iyi bir fikir geldi!Dialogue: 0,0:17:01.96,0:17:03.75,Main,,0,0,0,,Momo!Dialogue: 0,0:17:04.13,0:17:06.06,Main,,0,0,0,,Uç!Dialogue: 0,0:17:07.02,0:17:09.10,Main,,0,0,0,,Çok ağırsın! İn üstümden!Dialogue: 0,0:17:09.10,0:17:11.76,Main,,0,0,0,,Uçamam ben ayrıca adaya da girmiyorum!Dialogue: 0,0:17:11.76,0:17:14.11,Main,,0,0,0,,Babam adaya girmememi salık verdi!Dialogue: 0,0:17:14.11,0:17:16.33,Main,,0,0,0,,Uçamıyor musun? Ne diyorsun sen yahu?Dialogue: 0,0:17:17.03,0:17:20.04,Main,,0,0,0,,Basbayağı da uçabiliyordun işte!Dialogue: 0,0:17:20.04,0:17:23.15,Main,,0,0,0,,Bilmem ben! Uçamıyorum dediysem uçamıyorum!Dialogue: 0,0:17:23.15,0:17:26.10,Main,,0,0,0,,Uçarken gördüm ben bunu ya!Dialogue: 0,0:17:26.10,0:17:27.94,Main,,0,0,0,,Kanatları yok gerçi.Dialogue: 0,0:17:29.12,0:17:33.06,Main,,0,0,0,,Gördün mü! Uçtuğumu hatırlamıyorum ben!Dialogue: 0,0:17:33.47,0:17:37.00,Main,,0,0,0,,Ha-Hani uçmuşsam bile...Dialogue: 0,0:17:39.92,0:17:41.72,Flashbacks,,0,0,0,,Adın ne?Dialogue: 0,0:17:43.35,0:17:47.81,Main,,0,0,0,,Öyle korkunç bir şeyi bir daha asla yapmam!Dialogue: 0,0:17:48.60,0:17:53.31,Main,,0,0,0,,Gökyüzünde uçmam!Dialogue: 0,0:17:53.63,0:17:56.42,Main,,0,0,0,,Yükseklik korkun falan mı var yoksa?Dialogue: 0,0:17:56.86,0:17:58.32,Main,,0,0,0,,Seni...Dialogue: 0,0:18:00.11,0:18:01.48,Main,,0,0,0,,Ah!Dialogue: 0,0:18:01.48,0:18:03.19,Main,,0,0,0,,Saygısızlık yapma!Dialogue: 0,0:18:03.19,0:18:05.73,Main,,0,0,0,,Savaşçılar hiçbir şeyden korkmaz!Dialogue: 0,0:18:05.73,0:18:08.81,Main,,0,0,0,,Sen var ya...Dialogue: 0,0:18:08.81,0:18:11.87,Main,,0,0,0,,Dur be lanet olası!Dialogue: 0,0:18:12.15,0:18:14.55,Main,,0,0,0,,Luffy-san, karşınızda sekiz yaşında bir çocuk var.Dialogue: 0,0:18:14.55,0:18:16.37,Main,,0,0,0,,Savaşçıymış!Dialogue: 0,0:18:16.37,0:18:20.02,Main,,0,0,0,,Ben günün birinde Korsanlar Kralı olacak adamım be!Dialogue: 0,0:18:20.48,0:18:26.33,Main,,0,0,0,,Ben de günün birinde Wano Krallığı'nın Shogun'u olacak adamım!Dialogue: 0,0:18:27.33,0:18:29.13,Main,,0,0,0,,Ağzından çıkanı kulağın duysun yılanbalığı seni!Dialogue: 0,0:18:29.13,0:18:30.87,Main,,0,0,0,,Biraz kibarlık öğren maymun seni!Dialogue: 0,0:18:30.87,0:18:33.60,Main,,0,0,0,,Ne demek maymun! Maymunlara saygısızlık etme!Dialogue: 0,0:18:33.60,0:18:35.22,Main,,0,0,0,,Yeter bu kadar Momonosuke!Dialogue: 0,0:18:35.61,0:18:37.32,Main,,0,0,0,,Kurtarıcımız o bizim!Dialogue: 0,0:18:38.78,0:18:42.48,Main,,0,0,0,,Kusura bakma Luffy-dono. Bağışla.Dialogue: 0,0:18:42.48,0:18:45.84,Main,,0,0,0,,Her ne kadar çocuk yaşta da olsa Wano Krallığı'nın gururlu bir savaşçısıdır.Dialogue: 0,0:18:45.84,0:18:47.10,Main,,0,0,0,,Gerçi...Dialogue: 0,0:18:47.10,0:18:51.03,Main,,0,0,0,,...sekiz yaşında birini de bu denli ciddiye aldığınıza inanmakta güçlük çekiyorum!Dialogue: 0,0:18:51.03,0:18:54.03,Main,,0,0,0,,Korkaklardan nefret ederim! Aptal şey!Dialogue: 0,0:18:55.75,0:18:57.01,Main,,0,0,0,,Sen var ya...Dialogue: 0,0:18:59.30,0:19:00.76,Main,,0,0,0,,Lanet olsun ya!Dialogue: 0,0:19:00.76,0:19:04.35,Main,,0,0,0,,- Ah Nami! - Gel bakalım yamacıma Momo-chan!Dialogue: 0,0:19:04.63,0:19:07.29,Main,,0,0,0,,O maymun bozuntusu...Dialogue: 0,0:19:07.29,0:19:09.87,Main,,0,0,0,,Uzaklaş oradan!Dialogue: 0,0:19:09.87,0:19:10.92,Main,,0,0,0,,Nesi var bunların böyle?!Dialogue: 0,0:19:11.33,0:19:15.83,Main,,0,0,0,,Babasına çekmiş işte arkadaş!  Savaşçıların bu denli hasta olduğunu bilmezdim!Dialogue: 0,0:19:15.83,0:19:17.93,Main,,0,0,0,,Ne cüretle böyle bir şey dersiniz!Dialogue: 0,0:19:20.02,0:19:23.60,Main,,0,0,0,,Haydi Kin'emon, şehre doğru yola koyulalım artık!Dialogue: 0,0:19:23.60,0:19:25.74,Main,,0,0,0,,Kıyafetlerimizi nasıl seçsek de gizlesek kendimizi?Dialogue: 0,0:19:25.74,0:19:29.18,Main,,0,0,0,,Sahi ya!Dialogue: 0,0:19:29.62,0:19:33.46,Main,,0,0,0,,Dressrosa'da insanlar böyle giyiniyor!Dialogue: 0,0:19:33.83,0:19:38.90,Note,,0,0,0,,Erkekler için  yakalı gömleklerDialogue: 0,0:19:33.83,0:19:38.90,Note,,0,0,0,,Kadınlar için  hiçbir şeyDialogue: 0,0:19:34.45,0:19:38.90,Main,,0,0,0,,İzin verin de adaya çabucak uyum sağlayabilmemiz için sizi giydireyim!Dialogue: 0,0:19:38.90,0:19:41.70,Main,,0,0,0,,Dressrosa'ya şimdiden bayıldım!Dialogue: 0,0:19:41.70,0:19:42.67,Main,,0,0,0,,Öyle gerçekten de!Dialogue: 0,0:19:44.21,0:19:46.20,Main,,0,0,0,,Yalan söylemesene!Dialogue: 0,0:19:47.39,0:19:48.76,Main,,0,0,0,,Hey.Dialogue: 0,0:19:48.76,0:19:51.26,Main,,0,0,0,,Bunu almanızı istiyorum.Dialogue: 0,0:19:53.43,0:19:55.54,Main,,0,0,0,,Yaşam Kağıdı mı bu?Dialogue: 0,0:19:55.92,0:19:58.96,Main,,0,0,0,,Evet! Daha önce de bahsettiğim Zou adasını işaret ediyor.Dialogue: 0,0:20:01.09,0:20:04.42,Main,,0,0,0,,Bize bir şey olacak olursa oraya gidin.Dialogue: 0,0:20:05.95,0:20:09.67,Main,,0,0,0,,Ne demekmiş o "Bize bir şey olursa..."? Öylesine dedin bunu değil mi?Dialogue: 0,0:20:09.67,0:20:10.93,Main,,0,0,0,,Kim bilir?Dialogue: 0,0:20:10.93,0:20:12.82,Main,,0,0,0,,Dostlarımın çizdiği bir harita.Dialogue: 0,0:20:13.65,0:20:15.11,Main,,0,0,0,,Berbat çizilmiş!Dialogue: 0,0:20:15.83,0:20:19.58,Main,,0,0,0,,Şu an burada, Dressrosa'nın batı kıyısındayız.Dialogue: 0,0:20:20.79,0:20:24.10,Main,,0,0,0,,Biz yani Caesar Teslim Takımı da...Dialogue: 0,0:20:24.10,0:20:24.72,Captions,,0,0,0,,Mevcut KonumDialogue: 0,0:20:24.72,0:20:29.47,Main,,0,0,0,,...Dressrosa'nın öte ucuna ulaşacak ve kuzeye giden o uzun mu uzun köprüyü geçerek...Dialogue: 0,0:20:29.47,0:20:31.07,Main,,0,0,0,,...Green Bit'e varacağız.Dialogue: 0,0:20:31.07,0:20:34.15,Main,,0,0,0,,Neden Dressrosa'dan geçiyoruz ki?Dialogue: 0,0:20:34.15,0:20:36.53,Main,,0,0,0,,Gemiyi doğrudan, hep birlikte oraya götüremez miyiz?Dialogue: 0,0:20:36.53,0:20:38.19,Main,,0,0,0,,Gemiyle oraya varmanın imkansız olduğunu duydum.Dialogue: 0,0:20:38.19,0:20:40.26,Main,,0,0,0,,Bak bu kulağa eğlenceli geliyor işte.Dialogue: 0,0:20:40.26,0:20:42.66,Main,,0,0,0,,Oraya kadar size emanetim!Dialogue: 0,0:20:43.18,0:20:45.18,Main,,0,0,0,,# Caesar Teslim Takımı #Dialogue: 0,0:20:45.25,0:20:47.19,Main,,0,0,0,,Ve siz yani Gemi Güvenliği Takımı da...Dialogue: 0,0:20:47.19,0:20:49.57,Main,,0,0,0,,...düşman saldırısına karşı hazırlıklı olmalısınız.Dialogue: 0,0:20:49.57,0:20:52.03,Main,,0,0,0,,Gemiyi ele geçirmelerine izin vermeyin!Dialogue: 0,0:20:52.03,0:20:53.94,Main,,0,0,0,,O da neymiş? Ne demeye çalışıyorsun?!Dialogue: 0,0:20:54.16,0:21:07.76,Main,,0,0,0,,# Gemi Güvenliği Takımı #Dialogue: 0,0:20:56.04,0:20:58.48,Main,,0,0,0,,Kanjuro... Umarım iyisindir!Dialogue: 0,0:20:58.48,0:21:01.22,Main,,0,0,0,,Ne?! En güvenlisi bizim işimiz sanıyordum!Dialogue: 0,0:21:01.22,0:21:04.29,Main,,0,0,0,,Sonuçta düşmanın kucağındağız.Dialogue: 0,0:21:04.29,0:21:07.77,Main,,0,0,0,,Ama bizim takımda Sanji de var sonuçta...Dialogue: 0,0:21:07.77,0:21:10.11,Main,,0,0,0,,Amanın! Sanji yok!Dialogue: 0,0:21:10.50,0:21:12.64,Main,,0,0,0,,Luffy'ler de gitmişler!Dialogue: 0,0:21:13.35,0:21:16.07,Main,,0,0,0,,Bu planın kilit noktası onlar! Nereye kayboldular?!Dialogue: 0,0:21:16.07,0:21:20.47,Main,,0,0,0,,Bizi kim koruyacak şimdi?!Dialogue: 0,0:21:26.60,0:21:33.77,Main,,0,0,0,,Bu krallık birkaç yönüyle ziyaretçilerini kendisine hayran bırakmaktadır.Dialogue: 0,0:21:37.04,0:21:41.22,Main,,0,0,0,,Bunlardan ilki mis kokulu çiçekleri ve...Dialogue: 0,0:21:43.96,0:21:47.15,Main,,0,0,0,,...adaya has yemeklerin o enfes kokusu.Dialogue: 0,0:21:51.65,0:21:54.49,Main,,0,0,0,,Harika kokuyor!Dialogue: 0,0:21:58.47,0:21:59.99,Main,,0,0,0,,İkinci bir nedense...Dialogue: 0,0:21:59.99,0:22:04.51,Main,,0,0,0,,...yerli kadınların yorulmak bilmeksizin tutkulu bir şekilde ettikleri danslar.Dialogue: 0,0:22:05.96,0:22:07.82,Main,,0,0,0,,Leziz kokuyor!Dialogue: 0,0:22:10.17,0:22:12.61,Main,,0,0,0,,Ve diğer bir nedense...Dialogue: 0,0:22:14.01,0:22:16.54,Main,,0,0,0,,Dur ya! Geri ver onu bana!Dialogue: 0,0:22:17.25,0:22:20.13,Main,,0,0,0,,Bekle dedim Mario! Kime diyorum!Dialogue: 0,0:22:20.13,0:22:23.05,Main,,0,0,0,,Kolumu geri ver!Dialogue: 0,0:22:23.05,0:22:27.52,Main,,0,0,0,,Cidden yani! Kötü köpek seni! Pamukları çıkıyor!Dialogue: 0,0:22:28.07,0:22:30.41,Main,,0,0,0,,Bekle!Dialogue: 0,0:22:30.41,0:22:31.33,Main,,0,0,0,,Ay!Dialogue: 0,0:22:31.33,0:22:34.36,Main,,0,0,0,,Yan tarafıma sancı girdi! Gerçi içi pamuk sadece ama!Dialogue: 0,0:22:34.36,0:22:36.53,Main,,0,0,0,,Peluş oyuncaklar mı?!Dialogue: 0,0:22:36.53,0:22:41.92,Main,,0,0,0,,Tüm ziyaretçileri için şok edici bir sürpriz...Dialogue: 0,0:22:42.31,0:22:43.54,Main,,0,0,0,,Merhabalar!Dialogue: 0,0:22:44.72,0:22:46.40,Main,,0,0,0,,Bendeniz bir askerim!Dialogue: 0,0:22:46.92,0:22:50.71,Main,,0,0,0,,Daha önce hiç tanışmış mıydık sizlerle?Dialogue: 0,0:22:50.71,0:22:52.37,Main,,0,0,0,,Tanıdık geldiniz.Dialogue: 0,0:22:52.68,0:22:55.72,Main,,0,0,0,,Sahi ya buldum! Bu sabahki gazetede...Dialogue: 0,0:22:57.01,0:22:59.42,Main,,0,0,0,,Lanet olsun, ipler dolandı! Yardım edin!Dialogue: 0,0:22:59.42,0:23:01.79,Main,,0,0,0,,Bu da ne böyle?! Oyuncak mı?Dialogue: 0,0:23:07.93,0:23:09.92,Main,,0,0,0,,Bu şeyler...Dialogue: 0,0:23:09.92,0:23:12.77,Main,,0,0,0,,...şehre doğal bir şekilde adapte olmuş...Dialogue: 0,0:23:13.89,0:23:17.89,Main,,0,0,0,,...ve insanlarla birlikte hayatlarına devam eden...Dialogue: 0,0:23:19.11,0:23:23.17,Main,,0,0,0,,...canlı oyuncaklar.Dialogue: 0,0:23:27.52,0:23:31.42,Main,,0,0,0,,# Fabrika Yıkım ve Samuray Kurtarma Takımı #Dialogue: 0,0:23:27.62,0:23:31.52,Main,,0,0,0,,Burası aşk, tutku ve oyuncaklar krallığının...Dialogue: 0,0:23:32.04,0:23:35.36,Main,,0,0,0,,...liman şehri Acacia!Dialogue: 0,0:23:36.54,0:23:38.61,Main,,0,0,0,,Adam bıçaklandı!Dialogue: 0,0:23:39.69,0:23:41.96,Main,,0,0,0,,Yine mi ya?Dialogue: 0,0:23:41.96,0:23:43.65,Main,,0,0,0,,Ne demek yine mi?Dialogue: 0,0:23:43.65,0:23:45.84,Main,,0,0,0,,Seri katil falan mı var?Dialogue: 0,0:23:45.84,0:23:51.04,Main,,0,0,0,,Hayır. Bu ülkenin kadınları aşk konusunda oldukça tutkun ve kıskançtırlar.Dialogue: 0,0:23:51.04,0:23:54.11,Main,,0,0,0,,Yani ihanete uğradıklarında...Dialogue: 0,0:23:54.11,0:23:55.84,Main,,0,0,0,,...kolayca şiddete başvurabilirler.Dialogue: 0,0:23:55.84,0:23:56.91,Main,,0,0,0,,Korkunçmuş!Dialogue: 0,0:23:56.91,0:24:00.35,Main,,0,0,0,,Hele de güzel olanları bu konuda oldukça acımasız olabiliyorlar!Dialogue: 0,0:24:02.02,0:24:04.93,Main,,0,0,0,,Oyuncaklar hareket ediyorlar ama ne fark eder sanki!Dialogue: 0,0:24:04.93,0:24:07.62,Main,,0,0,0,,Haydi bir şeyler yiyelim!Dialogue: 0,0:24:12.89,0:24:17.44,Main,,0,0,0,,Burada kaybedecek zamanım yok benim!Dialogue: 0,0:24:17.44,0:24:20.70,Main,,0,0,0,,Derhal Kanjuro'yu bulmam lazım!Dialogue: 0,0:24:21.75,0:24:23.83,Main,,0,0,0,,Rahatla biraz yahu!Dialogue: 0,0:24:23.83,0:24:26.64,Main,,0,0,0,,Acele etmemiz gerektiğinin farkındayım ama öyle sağ sola...Dialogue: 0,0:24:26.66,0:24:29.78,Main,,0,0,0,,...koşturmaktansa önce biraz bilgi edinmemiz faydalı olabilir.Dialogue: 0,0:24:31.50,0:24:33.67,Main,,0,0,0,,Tuhaf değil mi sizce de?Dialogue: 0,0:24:34.05,0:24:38.89,Main,,0,0,0,,Daha bu sabah kralları tahtından oldu.Dialogue: 0,0:24:38.89,0:24:41.59,Main,,0,0,0,,Biraz daha panik halinde olurlar diyordum.Dialogue: 0,0:24:41.59,0:24:43.59,Main,,0,0,0,,Belki henüz bilmiyorlardır?Dialogue: 0,0:24:44.06,0:24:46.56,Main,,0,0,0,,İmkanı yok.Dialogue: 0,0:24:47.76,0:24:50.42,Main,,0,0,0,,Soralım o zaman! Baksana biraz ihtiyar!Dialogue: 0,0:24:50.80,0:24:51.26,Main,,0,0,0,,Yapma!Dialogue: 0,0:24:51.26,0:24:52.72,Main,,0,0,0,,Ne yapıyorsun ya?!Dialogue: 0,0:24:52.72,0:24:55.44,Main,,0,0,0,,Bu sabah gazetede çarşaf çarşaf fotoğrafların vardı!Dialogue: 0,0:24:57.56,0:24:59.29,Main,,0,0,0,,Siparişinizi getirdim.Dialogue: 0,0:24:59.70,0:25:01.16,Main,,0,0,0,,Beklediğiniz için teşekkürler...Dialogue: 0,0:25:01.83,0:25:04.18,Main,,0,0,0,,...yada değil!Dialogue: 0,0:25:04.18,0:25:06.71,Main,,0,0,0,,Geldi sonunda! Dört gözle bekliyordum!Dialogue: 0,0:25:06.71,0:25:09.22,Main,,0,0,0,,Dress Karides Paella!Dialogue: 0,0:25:09.22,0:25:12.49,Main,,0,0,0,,Rosa Kalamar Mürekkepli Makarna!Dialogue: 0,0:25:12.49,0:25:15.86,Main,,0,0,0,,Son olarak da Peri Balkabağı Gazpacho!Dialogue: 0,0:25:15.86,0:25:17.56,Main,,0,0,0,,Hepsi de leziz görünüyor!Dialogue: 0,0:25:17.56,0:25:20.15,Main,,0,0,0,,Yiyelim bakalım!Dialogue: 0,0:25:21.66,0:25:23.10,Main,,0,0,0,,Leziz!Dialogue: 0,0:25:24.04,0:25:26.57,Main,,0,0,0,,Peri Balkabağı da neyin nesi?Dialogue: 0,0:25:26.57,0:25:33.11,Main,,0,0,0,,Şimdi şöyle ki... Bu ülkede perilerle ilgili bir efsane dolaşır ve hâlâ inananları vardır.Dialogue: 0,0:25:33.82,0:25:35.23,Main,,0,0,0,,Kimileri de inanmaz!Dialogue: 0,0:25:36.04,0:25:39.41,Main,,0,0,0,,Kimileri perileri gördüğünü söyler! Kimileri görmez!Dialogue: 0,0:25:39.41,0:25:40.90,Main,,0,0,0,,Periler mi?Dialogue: 0,0:25:40.90,0:25:44.44,Main,,0,0,0,,Evet! İlginç değil mi?Dialogue: 0,0:25:45.20,0:25:46.57,Main,,0,0,0,,Asırlardan beri hem de!Dialogue: 0,0:25:47.37,0:25:49.96,Main,,0,0,0,,Çoğumuz onları görmemiş olsak bile var oldukları muhakkak.Dialogue: 0,0:25:50.93,0:25:53.85,Main,,0,0,0,,İnsanlar bu perilere...Dialogue: 0,0:25:54.88,0:25:59.30,Main,,0,0,0,,...Dressrosa'nın Muhafız Tanrıları derler...Dialogue: 0,0:25:59.30,0:26:00.71,Main,,0,0,0,,...yada demezler!Dialogue: 0,0:26:00.71,0:26:02.00,Main,,0,0,0,,Kapa çeneni be!Dialogue: 0,0:26:02.79,0:26:06.10,Main,,0,0,0,,Gene bildi! On dördüncü oluyor bu!Dialogue: 0,0:26:06.10,0:26:09.43,Main,,0,0,0,,Neler oluyor?  Pek bir gürültü olmaya başladı.Dialogue: 0,0:26:09.43,0:26:10.79,Main,,0,0,0,,Rulet.Dialogue: 0,0:26:15.38,0:26:17.08,Main,,0,0,0,,Haydi bakalım beyaz!Dialogue: 0,0:26:17.08,0:26:18.95,Main,,0,0,0,,Bakalım ne çıkacak.Dialogue: 0,0:26:20.68,0:26:23.49,Main,,0,0,0,,Sonuç nedir? Ne çıktı?Dialogue: 0,0:26:25.59,0:26:28.75,Main,,0,0,0,,Gene bilemedin! Siyah 20!Dialogue: 0,0:26:28.75,0:26:30.63,Main,,0,0,0,,Bu sefer beyaz gelecek!Dialogue: 0,0:26:34.56,0:26:36.37,Main,,0,0,0,,Gene siyah!Dialogue: 0,0:26:37.32,0:26:39.86,Main,,0,0,0,,Ne kötüler!Dialogue: 0,0:26:39.86,0:26:41.47,Main,,0,0,0,,Don Quixote adının yüz karaları!Dialogue: 0,0:26:41.97,0:26:46.72,Main,,0,0,0,,Şansım tükendi galiba, durum pek iyi görünmüyor.Dialogue: 0,0:26:46.72,0:26:49.72,Main,,0,0,0,,Ne yapacaksın? Bırakıyor musun?Dialogue: 0,0:26:49.72,0:26:53.42,Main,,0,0,0,,Buffalo-san buralarda değilken paranın dibine vurabiliriz.Dialogue: 0,0:26:54.47,0:26:55.84,Main,,0,0,0,,Hayır.Dialogue: 0,0:26:57.11,0:26:59.26,Main,,0,0,0,,Son bir kez daha.Dialogue: 0,0:26:59.26,0:27:01.19,Main,,0,0,0,,Her şeyi yatırıyorum.Dialogue: 0,0:27:02.51,0:27:03.86,Main,,0,0,0,,Harika!Dialogue: 0,0:27:03.86,0:27:08.22,Main,,0,0,0,,Öyleyse ben de her şeyimi seçmediğin renge yatıracağım.Dialogue: 0,0:27:08.22,0:27:11.32,Main,,0,0,0,,Adam dediğin böyle oynar işte!Dialogue: 0,0:27:11.32,0:27:13.34,Main,,0,0,0,,Her şeyini mi? Gerçekten mi?Dialogue: 0,0:27:13.34,0:27:15.21,Main,,0,0,0,,Evet.Dialogue: 0,0:27:15.72,0:27:17.58,Main,,0,0,0,,Başlayalım öyleyse.Dialogue: 0,0:27:19.36,0:27:20.75,Main,,0,0,0,,Neyi seçeceksin?Dialogue: 0,0:27:20.75,0:27:24.38,Main,,0,0,0,,Beyaz lütfen!Dialogue: 0,0:27:28.79,0:27:33.69,Main,,0,0,0,,Öyleyse bana da siyah kalıyor!Dialogue: 0,0:27:35.23,0:27:37.70,Main,,0,0,0,,Haydi beyaz!Dialogue: 0,0:27:43.83,0:27:45.91,Main,,0,0,0,,Ne geldi?Dialogue: 0,0:27:49.32,0:27:53.01,Main,,0,0,0,,Maalesef ihtiyar!Dialogue: 0,0:27:53.64,0:27:55.09,Main,,0,0,0,,- Si... - Beyaz!Dialogue: 0,0:27:58.00,0:27:59.92,Main,,0,0,0,,Sen de kimsin be?!Dialogue: 0,0:28:01.73,0:28:04.90,Main,,0,0,0,,İyi bak! Basbayağı siyah işte gerzek herif!Dialogue: 0,0:28:04.90,0:28:06.03,Main,,0,0,0,,Beyaz!Dialogue: 0,0:28:06.03,0:28:07.20,Main,,0,0,0,,İhtiyar kazandın!Dialogue: 0,0:28:07.20,0:28:07.93,Main,,0,0,0,,Ne?!Dialogue: 0,0:28:07.93,0:28:10.39,Main,,0,0,0,,Lanet olası, seni ilgilendirmeyen meselelere karışma!Dialogue: 0,0:28:10.39,0:28:11.43,Main,,0,0,0,,Aynen öyle!Dialogue: 0,0:28:11.43,0:28:13.10,Main,,0,0,0,,Dayak mı istiyor canın?!Dialogue: 0,0:28:15.10,0:28:16.39,Main,,0,0,0,,Bu da kim?Dialogue: 0,0:28:16.39,0:28:17.84,Main,,0,0,0,,Kime karşı geldiğinin farkında değil mi?!Dialogue: 0,0:28:18.38,0:28:20.31,Main,,0,0,0,,Al işte gene nelere karıştırdı bizi!Dialogue: 0,0:28:20.31,0:28:22.73,Main,,0,0,0,,Ge-Gerçekten kazandım mı?!Dialogue: 0,0:28:22.73,0:28:24.73,Main,,0,0,0,,Evet, sen kazandın ihtiyar.Dialogue: 0,0:28:24.73,0:28:29.12,Main,,0,0,0,,Kim olduğunuzu bilmiyorum ama yaptığınız bu iyilik için müteşekkirim!Dialogue: 0,0:28:29.67,0:28:32.80,Main,,0,0,0,,Lafı olmaz! Gördüğümü söyledim sadece.Dialogue: 0,0:28:32.80,0:28:34.05,Main,,0,0,0,,Kutlarım.Dialogue: 0,0:28:34.05,0:28:36.47,Main,,0,0,0,,Yalnız o değil de ihtiyar, pek bir güçlü görünmene rağmen...Dialogue: 0,0:28:36.47,0:28:39.66,Main,,0,0,0,,Bu yaptığın resmen beyinsizlik, velet!Dialogue: 0,0:28:39.66,0:28:42.55,Main,,0,0,0,,Biz siyah diyorsak siyahtır!Dialogue: 0,0:28:42.55,0:28:46.38,Main,,0,0,0,,Göremiyor zaten, gerisini kim takar?!Dialogue: 0,0:28:46.38,0:28:47.77,Main,,0,0,0,,İşimize engel oluyorsun!Dialogue: 0,0:28:47.77,0:28:49.04,Main,,0,0,0,,Geber!Dialogue: 0,0:28:49.04,0:28:53.25,Main,,0,0,0,,Genç, az kıpırdayabilir misin oradan?Dialogue: 0,0:28:53.25,0:28:57.73,Main,,0,0,0,,Bunları cehenneme doğru yollayacağım da.Dialogue: 0,0:29:03.20,0:29:05.99,Main,,0,0,0,,Ağır! Çok ağır...Dialogue: 0,0:29:05.99,0:29:09.39,Main,,0,0,0,,Ezileceğim!Dialogue: 0,0:29:21.64,0:29:24.11,Main,,0,0,0,,Oha! Nasıl bir heriftir bu?!Dialogue: 0,0:29:24.11,0:29:25.54,Main,,0,0,0,,Ne yaptı o öyle?Dialogue: 0,0:29:26.43,0:29:29.00,Main,,0,0,0,,Vay canına! Delik açıldı resmen!Dialogue: 0,0:29:31.35,0:29:35.05,Main,,0,0,0,,Kör olmanın da faydaları var aslında.Dialogue: 0,0:29:35.05,0:29:43.09,Main,,0,0,0,,Keza bu dünyada görülmeye değer olmayan pek çok şeyin varlığı yadsınamaz bir gerçek.