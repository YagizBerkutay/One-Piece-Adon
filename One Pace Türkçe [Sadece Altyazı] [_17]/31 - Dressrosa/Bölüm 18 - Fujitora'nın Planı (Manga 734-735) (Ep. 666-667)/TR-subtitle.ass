Dialogue: 0,0:02:10.00,0:02:12.50,Title,,0,0,0,,{\an2\fad(500,500)}Bölüm 18\NFujitora'nın Planı
Dialogue: 0,0:01:31.57,0:01:35.46,Main,Announcer,0,0,0,,Ne acayip bir son ama!
Dialogue: 0,0:01:36.45,0:01:42.88,Main,Announcer,0,0,0,,20 güçlü savaşçı aniden\Nbilinmeyen bir sebepten bayıldı!
Dialogue: 0,0:01:43.68,0:01:48.62,Main,Announcer,0,0,0,,Corrida Kolezyumu tarihinde\Nyaşanmamış bir şey bu!
Dialogue: 0,0:01:51.13,0:01:53.13,Main,Announcer,0,0,0,,Fakat ringin ortasında...
Dialogue: 0,0:01:53.78,0:01:57.60,Main,Announcer,0,0,0,,...ayağa kalkmaya çalışan birinin\Ngölgesini görebilirsiniz!
Dialogue: 0,0:01:58.29,0:02:00.97,Main,Announcer,0,0,0,,Kazanan kişi\Nkendisi mi olacak acaba?!
Dialogue: 0,0:02:01.32,0:02:04.60,Main,Announcer,0,0,0,,{\i1}Tüm bunları\No gölgenin sahibi mi yaptı acaba?!{\i0}
Dialogue: 0,0:02:12.44,0:02:13.43,Main,Announcer,0,0,0,,Amanın!
Dialogue: 0,0:02:21.13,0:02:25.46,Main,Announcer,0,0,0,,R-Rebecca mı?!
Dialogue: 0,0:02:25.46,0:02:29.04,Main,Announcer,0,0,0,,Ayağa kalkan kişi Rebecca!
Dialogue: 0,0:02:34.32,0:02:39.30,Main,Announcer,0,0,0,,D Bloğu'nu avcunda oynatacağı düşünülen\Ntüm savaşçılar...
Dialogue: 0,0:02:39.30,0:02:42.71,Main,Announcer,0,0,0,,...hâlâ baygın bir şekilde\Nyerde yatmaktalar!
Dialogue: 0,0:02:42.71,0:02:48.31,Main,Announcer,0,0,0,,Corrida Kolezyumu Dövüş Müsabakası\Nfinallerine adını yazdıran son kişi de...
Dialogue: 0,0:02:48.31,0:02:52.53,Main,Announcer,0,0,0,,...inanılması güç bir şekilde, mahkum\Ngladyatör ve Kral Riku'nun torunu...
Dialogue: 0,0:02:52.56,0:02:54.63,Main,Announcer,0,0,0,,...Dressrosa\Ntarihinin yüzkarası...
Dialogue: 0,0:02:54.63,0:02:57.62,Main,Announcer,0,0,0,,...Rebecca oluyor!
Dialogue: 0,0:02:58.66,0:03:00.10,Main,Audience,0,0,0,,Dalga geçmeyin bizimle!
Dialogue: 0,0:03:00.10,0:03:02.68,Main,Audience,0,0,0,,Ne numaralar çevirdin, Rebecca!?
Dialogue: 0,0:03:02.68,0:03:05.23,Main,Audience,0,0,0,,Üstünü arayın!
Dialogue: 0,0:03:06.07,0:03:08.80,Captions,,0,0,220,,{\fad(504,0)}Tutsak Gladyatör Hücreleri
Dialogue: 0,0:03:06.22,0:03:08.80,Main,Prisoner,0,0,4,,Başardın Rebecca!
Dialogue: 0,0:03:08.80,0:03:11.23,Main,Prisoner,0,0,0,,Ne oldu?
Dialogue: 0,0:03:11.23,0:03:13.89,Main,Prisoner,0,0,0,,Kimin umrunda be!
Dialogue: 0,0:03:13.89,0:03:16.27,Main,Prisoner,0,0,0,,Rebecca kazandı sonuçta işte!
Dialogue: 0,0:03:18.11,0:03:22.15,Main,Woman,0,0,0,,Bu ne be böyle?!\NO şıllık Cavendish-sama'ya ne yaptı?!
Dialogue: 0,0:03:22.15,0:03:26.69,Main,Man,0,0,0,,Amiral Orlumbus'un bu küçük yosmaya\Nyenildiğine inanamıyorum!
Dialogue: 0,0:03:30.21,0:03:32.17,Main,Marine,0,0,0,,Biçen Rüzgar mı?
Dialogue: 0,0:03:32.17,0:03:34.70,Main,Bastille,0,0,0,,Rommel'i Biçen Rüzgar!
Dialogue: 0,0:03:34.70,0:03:36.93,Main,Bastille,0,0,0,,Duymuşsundur diye düşünüyorum-dara.
Dialogue: 0,0:03:37.87,0:03:41.55,Main,Bastille,0,0,0,,Vakti zamanında Rommel Krallığı'nda\Nmeydana gelmiş gizemli bir olay.
Dialogue: 0,0:03:50.54,0:03:57.20,Main,Bastille,0,0,0,,Her gece insanları biçen bir rüzgarın peyda olduğu söylenen tuhaf bir olay-dara.
Dialogue: 0,0:03:57.20,0:04:00.74,Main,Bastille,0,0,0,,Bölgeye derhal\NDonanma askerleri gönderilmişti fakat...
Dialogue: 0,0:04:04.10,0:04:07.93,Main,Bastille,0,0,0,,...aynı rüzgar askerlerin de\Npek çoğunu öldürdü.
Dialogue: 0,0:04:12.12,0:04:15.54,Main,Bastille,0,0,0,,Sonuçta buldukları tek şey...
Dialogue: 0,0:04:17.00,0:04:23.45,Main,Bastille,0,0,0,,...rüzgarın aslında\NHakuba denen biri olduğuydu-dara.
Dialogue: 0,0:04:25.26,0:04:29.41,Main,Bastille,0,0,0,,Hâlâ yakalanamadı tabii.
Dialogue: 0,0:04:29.41,0:04:35.79,Main,Bastille,0,0,0,,Rommel Krallığı'ndan ayrıldıktan sonra da Hakuba çeşitli şehirlerde insanlara dehşet saçmaya devam etti.
Dialogue: 0,0:04:37.37,0:04:43.54,Main,Bastille,0,0,0,,Ve Hakuba'nın ortaya çıktığı tüm yerlerde\Nfalanca korsan da hep orada oluyordu-dara.
Dialogue: 0,0:04:43.54,0:04:44.26,Main,Marine,0,0,0,,Ne?
Dialogue: 0,0:04:59.52,0:05:02.73,Flashbacks,Suleiman,0,0,0,,Elimden kurtulamazsın\Nseni küçük yosma!
Dialogue: 0,0:05:11.53,0:05:12.71,Flashbacks,Suleiman,0,0,0,,Çekil yolumdan!
Dialogue: 0,0:05:19.33,0:05:21.23,Thoughts,Rebecca,0,0,0,,{\i1}Tuhaf davranıyor!{\i0}
Dialogue: 0,0:05:24.48,0:05:25.27,Thoughts,Rebecca,0,0,0,,Uyudu mu?!
Dialogue: 0,0:06:25.52,0:06:27.60,Main,Marine,0,0,0,,Uyurgezer miymiş?!
Dialogue: 0,0:06:27.60,0:06:29.20,Main,Bastille,0,0,0,,Evet-dara.
Dialogue: 0,0:06:29.20,0:06:36.21,Main,Bastille,0,0,0,,Hakuba aslında \NCavendish uyurken ortaya çıkan diğer kişiliği.
Dialogue: 0,0:06:36.21,0:06:39.22,Main,Bastille,0,0,0,,Hakuba suç işlediğinden...
Dialogue: 0,0:06:39.22,0:06:43.42,Main,Bastille,0,0,0,,...Cavendish de denizlere açılıp\Nkorsan oldu.
Dialogue: 0,0:06:43.42,0:06:45.74,Main,Marine,0,0,0,,Zavallı adam.
Dialogue: 0,0:06:45.74,0:06:47.65,Main,Bastille,0,0,0,,Üzülmeyin ona!
Dialogue: 0,0:06:47.65,0:06:51.00,Main,Bastille,0,0,0,,Bu durum Cavendish'in de hoşuna gidiyor!
Dialogue: 0,0:06:51.00,0:06:53.61,Main,Bastille,0,0,0,,Bu şekilde düşünmeniz onun işine yarar!
Dialogue: 0,0:06:54.42,0:06:57.88,Main,Bastille,0,0,0,,Kendisi halihazırda\Nusta bir kılıç kullanıcısı.
Dialogue: 0,0:06:57.88,0:07:01.72,Main,Bastille,0,0,0,,Fakat Hakuba ondan çok daha güçlü!
Dialogue: 0,0:07:01.72,0:07:06.66,Main,Bastille,0,0,0,,Tabii uyuduğunda diğer kişiliğinin\Nortaya çıkması durumu...
Dialogue: 0,0:07:06.66,0:07:11.63,Main,Bastille,0,0,0,,...serbest dövüş müsabakası için\Npek uygun bir durum değildi sanırım.
Dialogue: 0,0:07:15.41,0:07:17.73,Main,Audience,0,0,0,,Rebecca kazanamaz!
Dialogue: 0,0:07:17.73,0:07:20.15,Main,Audience,0,0,0,,Kesin tabanca falan kullanmıştır!
Dialogue: 0,0:07:22.75,0:07:26.66,Main,Bartolomeo,0,0,0,,Kimseye tek bir darbe indirmeden\Nkazandı resmen!
Dialogue: 0,0:07:26.66,0:07:28.69,Main,Sabo,0,0,0,,O da kazanma yollarından biri tabii.
Dialogue: 0,0:07:28.69,0:07:33.04,Main,Sabo,0,0,0,,Hakuba'nın saldırısını\Nsavuşturabilen tek kişi o oldu.
Dialogue: 0,0:07:33.04,0:07:34.98,Main,Sabo,0,0,0,,Sırf şansı yaver gitti diye düşünme.
Dialogue: 0,0:07:37.30,0:07:40.13,Main,Sabo,0,0,0,,Gerçi karşımda kim olursa olsun...
Dialogue: 0,0:07:40.13,0:07:42.67,Main,Sabo,0,0,0,,...Mera Mera Meyvesi'ni almasına \Nmüsaade etmem.
Dialogue: 0,0:07:45.18,0:07:49.34,Main,Burgess,0,0,0,,Sabırsızlanmaya başlamıştım!\NSonunda savaşabileceğim!
Dialogue: 0,0:07:52.57,0:07:57.46,Captions,,0,0,180,,{\fad(1000,0)}Dressrosa Kraliyet Sarayı
Dialogue: 0,0:07:59.58,0:08:01.36,Main,Doflamingo,0,0,0,,Gördün mü?
Dialogue: 0,0:08:01.90,0:08:06.20,Main,Doflamingo,0,0,0,,Torunun epey şanslı çıktı.
Dialogue: 0,0:08:07.93,0:08:12.92,Main,Doflamingo,0,0,0,,Yalnız torununla beraber\Nyarışmaya katılmanı beklemiyordum.
Dialogue: 0,0:08:13.73,0:08:16.37,Main,Doflamingo,0,0,0,,Kral Riku...
Dialogue: 0,0:08:16.37,0:08:20.92,Main,Doflamingo,0,0,0,,Eski kralın Şeytan Meyvesi için\Nmücadele verdiğine inanmak oldukça güç.
Dialogue: 0,0:08:20.94,0:08:22.88,Main,Doflamingo,0,0,0,,Çok çaresiz kaldın anlaşılan.
Dialogue: 0,0:08:26.70,0:08:28.86,Thoughts,Riku,0,0,0,,{\i1}Rebecca!{\i0}
Dialogue: 0,0:08:28.86,0:08:34.46,Main,Doflamingo,0,0,0,,Bir de bugün aile üyelerinin\Nhepsi birden coştular resmen.
Dialogue: 0,0:08:34.46,0:08:37.80,Main,Doflamingo,0,0,0,,Violet'in bana ihanet etmesi de \Nmesela öyle.
Dialogue: 0,0:08:37.80,0:08:40.13,Main,Doflamingo,0,0,0,,Tüm bunlar\Ntesadüf olamayacak kadar fazla.
Dialogue: 0,0:08:41.54,0:08:43.74,Main,Riku,0,0,0,,Farkında olmadığını biliyorum.
Dialogue: 0,0:08:45.68,0:08:48.19,Main,Riku,0,0,0,,Fakat bu sabah yaptığın şey...
Dialogue: 0,0:08:48.61,0:08:56.31,Flashbacks,CP-0,0,0,0,,Öncesinde tüm dünyaya yayılan Doflamingo'nun tahtı ve Shichibukai'lığı bırakacağı haberleri...
Dialogue: 0,0:08:56.81,0:08:58.65,Flashbacks,CP-0,0,0,0,,Yanlıştır.
Dialogue: 0,0:08:58.65,0:09:00.08,Flashbacks,CP-0,0,0,0,,Yalan haberdir.
Dialogue: 0,0:09:01.10,0:09:04.12,Main,Riku,0,0,0,,Sadece savaşma isteğim kabardı.
Dialogue: 0,0:09:04.12,0:09:05.52,Main,Riku,0,0,0,,Bu kadar.
Dialogue: 0,0:09:07.64,0:09:12.56,Main,Doflamingo,0,0,0,,Anlıyorum.\NBu yüzden harekete geçtin demek?
Dialogue: 0,0:09:12.56,0:09:15.70,Main,Doflamingo,0,0,0,,Fakat Viola'nın durumu farklı.
Dialogue: 0,0:09:15.70,0:09:20.45,Main,Doflamingo,0,0,0,,Senin aksine\No ilerisini düşünen bir kadındır.
Dialogue: 0,0:09:20.45,0:09:23.34,Main,Doflamingo,0,0,0,,Asla duyguları doğrultusunda\Nharekete geçmez.
Dialogue: 0,0:09:24.36,0:09:26.95,Main,Doflamingo,0,0,0,,Şu anda bir kumar oynuyor.
Dialogue: 0,0:09:26.95,0:09:31.18,Main,Doflamingo,0,0,0,,Bana meydan okumaya gelen\Ngüçlü bir çaylak var.
Dialogue: 0,0:09:31.18,0:09:36.22,Main,Doflamingo,0,0,0,,Shichibukai, Trafalgar Law.
Dialogue: 0,0:09:40.06,0:09:45.40,Main,Doflamingo,0,0,0,,Bir de damarlarında şeytani kan akan ve \Niki yıl önce dikkatleri üzerine çekmiş biri...
Dialogue: 0,0:09:45.66,0:09:47.98,Main,Doflamingo,0,0,0,,Monkey D. Luffy.
Dialogue: 0,0:09:47.98,0:09:54.14,Main,Doflamingo,0,0,0,,Viola da ittifak halindeki bu iki korsanın\Nbeni yeneceğini umuyor!
Dialogue: 0,0:09:56.11,0:10:00.14,Main,Doflamingo,0,0,0,,Fakat Law'ın halini görüyorsun.
Dialogue: 0,0:10:00.14,0:10:06.32,Main,Doflamingo,0,0,0,,Hasır Şapkalı Luffy de\NKolezyum'dan insan olarak çıkamayacak.
Dialogue: 0,0:10:06.76,0:10:11.02,Main,Doflamingo,0,0,0,,Şu an Hasır Şapka'nın\Ndiğer üyelerini düşünürsek...
Dialogue: 0,0:10:11.41,0:10:17.66,Main,Doflamingo,0,0,0,,Cyborg Franky tek başına\NOyuncak Evi'nin önünde.
Dialogue: 0,0:10:20.26,0:10:23.67,Main,Doflamingo,0,0,0,,Fakat yöneticilerimden birini\Nyenebilmesine imkan vermiyorum.
Dialogue: 0,0:10:29.17,0:10:31.12,Main,Doflamingo,0,0,0,,Onun dışında...
Dialogue: 0,0:10:31.12,0:10:39.64,Main,Doflamingo,0,0,0,,...Korsan Avcısı Zoro, Tilkialevi Kin'emon, Nico Robin\Nve Sogeking burada...
Dialogue: 0,0:10:40.98,0:10:45.93,Main,Doflamingo,0,0,0,,...fakat yeraltı katına \Nvarabileceklerini bile sanmıyorum.
Dialogue: 0,0:10:45.93,0:10:50.19,Main,Usopp,0,0,0,,Hiçbir şey bilmez bir vaziyette geldik,\Nyol gösterirseniz seviniriz.
Dialogue: 0,0:10:50.52,0:10:53.67,Captions,,0,0,180,,{\fad(256,0)}Kral Tepesi'nin Dibi
Dialogue: 0,0:10:56.80,0:10:58.80,Main,Wicca,0,0,0,,İleride asansör var!
Dialogue: 0,0:10:59.12,0:11:02.31,Captions,,0,0,0,,{\pos(927.2,451.6)}Luffy
Dialogue: 0,0:10:59.12,0:11:02.31,Captions,,0,0,0,,{\pos(923.2,605.6)}Sazan Kılığında
Dialogue: 0,0:11:02.74,0:11:05.94,Captions,,0,0,0,,{\pos(291.2,453.2)}Zoro
Dialogue: 0,0:11:02.74,0:11:05.94,Captions,,0,0,0,,{\pos(291.2,593.2)}Kedi Kılığında
Dialogue: 0,0:11:06.39,0:11:09.46,Captions,,0,0,0,,{\pos(382.4,173)}Kin'emon
Dialogue: 0,0:11:06.39,0:11:09.46,Captions,,0,0,0,,{\pos(204.4,277)}Kurbağa Kılığında
Dialogue: 0,0:11:10.04,0:11:11.82,Main,Wicca,0,0,0,,Beni dinleyin!
Dialogue: 0,0:11:12.34,0:11:15.52,Main,Wicca,0,0,0,,Doflamingo'nun da\Niçinde olduğu saray, Oyuncak Evi...
Dialogue: 0,0:11:15.52,0:11:20.76,Main,Wicca,0,0,0,,...ve GÜLÜCÜK fabrikasını da\Nbarındıran ticaret limanı birbirine bağlı.
Dialogue: 0,0:11:20.76,0:11:25.16,Main,Kin'emon,0,0,0,,Yani saraya girebilirsek Oyuncak Evi'ne de,\Nfabrikaya da gidebiliriz öyle mi?
Dialogue: 0,0:11:25.16,0:11:26.53,Main,Wicca,0,0,0,,Evet!
Dialogue: 0,0:11:26.97,0:11:32.69,Main,Wicca,0,0,0,,Fabrikaya varabilmek için ya \NOyuncak Evi'nden ya da saraydan geçmeniz gerekiyor.
Dialogue: 0,0:11:32.69,0:11:38.18,Main,Wicca,0,0,0,,Fakat dostlarım daha önce kazdığımız\Ngizli yeraltı geçidinden limana sızmışlardır artık.
Dialogue: 0,0:11:38.18,0:11:41.40,Main,Wicca,0,0,0,,Bizim hedefimiz öncelikle saraya ulaşmak!
Dialogue: 0,0:11:41.40,0:11:44.02,Main,Kin'emon,0,0,0,,Pekâlâ, anlaşılmıştır.
Dialogue: 0,0:11:44.02,0:11:49.17,Main,Kin'emon,0,0,0,,Fakat gözümle görmeme rağmen hâlâ bu denli\Nküçük insanların varlığı beni şaşırtıyor.
Dialogue: 0,0:11:49.17,0:11:52.22,Main,Luffy,0,0,0,,Evet, oyuncak gibi resmen!\NÇok hoş!
Dialogue: 0,0:11:52.22,0:11:57.80,Main,Wicca,0,0,0,,Normalde kendimizi yalnızca kraliyet\Nailesinin Büyük İnsanlarına gösteririz...
Dialogue: 0,0:11:57.80,0:12:01.44,Main,Wicca,0,0,0,,...fakat Hasır Şapka Tayfası yani\NUsolanders'a ayrıcalık tanıyoruz!
Dialogue: 0,0:12:01.44,0:12:03.17,Main,Kin'emon,0,0,0,,Usolanders mı?
Dialogue: 0,0:12:03.97,0:12:07.21,Main,Wicca,0,0,0,,SOP operasyonu başlamıştır bile!
Dialogue: 0,0:12:07.21,0:12:09.17,Main,Wicca,0,0,0,,Bakın, geldik sayılır!
Dialogue: 0,0:12:10.81,0:12:15.11,Main,Wicca,0,0,0,,Sarayın girişine yükselen asansör bu!
Dialogue: 0,0:12:15.11,0:12:19.77,Main,Wicca,0,0,0,,Asansörü kullanabilmek için güvenlik görevlisine\Ngeçiş kartı göstermemiz lazım ama...
Dialogue: 0,0:12:19.77,0:12:20.88,Main,Luffy,0,0,0,,Döver geçeriz!
Dialogue: 0,0:12:20.88,0:12:22.22,Main,Wicca,0,0,0,,Olmaz!
Dialogue: 0,0:12:22.62,0:12:26.39,Main,Wicca,0,0,0,,Öyle yaparsak patırtı kopar ve\Nçok daha fazla düşmanla karşılaşırız!
Dialogue: 0,0:12:28.57,0:12:30.46,Main,Luffy,0,0,0,,Biri var.
Dialogue: 0,0:12:31.00,0:12:32.03,Main,Luffy,0,0,0,,Sen de kimsin?
Dialogue: 0,0:12:32.03,0:12:34.00,Main,Violet,0,0,0,,Hasır Şapkalı Luffy'sin değil mi sen?
Dialogue: 0,0:12:34.00,0:12:35.18,Main,Luffy,0,0,0,,Evet, doğru bildin!
Dialogue: 0,0:12:35.18,0:12:36.13,Main,Zoro & Kin'emon,0,0,0,,{\i1}Kapa çeneni be!
Dialogue: 0,0:12:36.54,0:12:38.20,Main,Violet,0,0,0,,Seni bekliyordum.
Dialogue: 0,0:12:38.20,0:12:40.51,Main,Violet,0,0,0,,Saraya girmene yardım edeceğim!
Dialogue: 0,0:12:46.01,0:12:49.53,Main,Announcer,0,0,0,,Şimdi sırada finaller var!
Dialogue: 0,0:12:49.53,0:12:50.68,Main,Announcer,0,0,0,,Fakat...
Dialogue: 0,0:12:50.68,0:12:57.46,Main,Announcer,0,0,0,,Finallerde dövüşmesi planlanan\Ndört yöneticinin yarışmadan çekildiği açıklandı.
Dialogue: 0,0:13:00.86,0:13:03.80,Main,Announcer,0,0,0,,Fakat içiniz rahat olsun!
Dialogue: 0,0:13:03.80,0:13:06.93,Main,Announcer,0,0,0,,İster inanın ister inanmayın,\Nkolezyumun kahramanı...
Dialogue: 0,0:13:07.33,0:13:10.74,Main,Announcer,0,0,0,,...Bay Diamante...
Dialogue: 0,0:13:10.74,0:13:14.71,Main,Announcer,0,0,0,,...son dakika katılımıyla\Nyarışmada yer alacak!
Dialogue: 0,0:13:15.28,0:13:17.30,Main,Audience,0,0,0,,Diamante!
Dialogue: 0,0:13:17.30,0:13:19.33,Main,Audience,0,0,0,,Diamante-sama!
Dialogue: 0,0:13:24.50,0:13:25.50,Main,Doctor,0,0,0,,Revire!
Dialogue: 0,0:13:25.50,0:13:27.15,Main,Doctor,0,0,0,,Acele edin!
Dialogue: 0,0:13:34.33,0:13:35.76,Main,Rebecca,0,0,0,,Lucy!
Dialogue: 0,0:13:35.76,0:13:38.46,Main,Rebecca,0,0,0,,Ben de finallere...
Dialogue: 0,0:13:39.18,0:13:40.16,Main,Rebecca,0,0,0,,Lucy?
Dialogue: 0,0:13:41.37,0:13:43.07,Main,Rebecca,0,0,0,,Değilsin sen!
Dialogue: 0,0:13:43.07,0:13:44.15,Main,Bartolomeo,0,0,0,,Hanım hanım...
Dialogue: 0,0:13:44.15,0:13:46.44,Main,Bartolomeo,0,0,0,,Onunla böyle arkadaşınmış gibi konuşamazsın!
Dialogue: 0,0:13:48.76,0:13:50.58,Main,Sabo,0,0,0,,Rebecca'sın değil mi sen?
Dialogue: 0,0:13:51.74,0:13:54.61,Main,Sabo,0,0,0,,Geçmişini biliyorum.
Dialogue: 0,0:13:55.65,0:14:01.39,Main,Sabo,0,0,0,,İşler biraz karışacak belki ama\Nsana bir zararım dokunmayacak.
Dialogue: 0,0:14:08.09,0:14:11.43,Main,Sabo,0,0,0,,Her şeyin sahte bir gösterişten\Nibaret olduğunu biliyorum.
Dialogue: 0,0:14:12.41,0:14:14.80,Main,Sabo,0,0,0,,Bu ülke bana...
Dialogue: 0,0:14:14.80,0:14:18.10,Main,Sabo,0,0,0,,...küçüklüğümü geçirdiğim ülkeyi\Nhatırlatıyor.
Dialogue: 0,0:14:21.08,0:14:25.83,Captions,,0,0,180,,{\fad(680,0)}Kral Tepesi
Dialogue: 0,0:14:23.27,0:14:25.83,Main,Violet,0,0,4,,Bende geçiş kartı var.
Dialogue: 0,0:14:26.10,0:14:28.73,Captions,,0,0,180,,{\fad(357,357)}Saraya çıkan asansör girişi
Dialogue: 0,0:14:26.57,0:14:31.25,Main,Violet,0,0,4,,{\an8}Asansör sahiden de\Nsizi sarayın girişine kadar çıkartır...
Dialogue: 0,0:14:31.25,0:14:35.72,Main,Violet,0,0,0,,...fakat içinde kim olduğunu bilirlerse\Nher şey bitmiş olur.
Dialogue: 0,0:14:36.48,0:14:38.21,Main,Violet,0,0,0,,Daha önemlisi...
Dialogue: 0,0:14:38.21,0:14:39.41,Main,Kin'emon,0,0,0,,Daha önemlisi?
Dialogue: 0,0:14:41.38,0:14:42.57,Main,Violet,0,0,0,,Fazla şüpheli görünüyorsunuz!
Dialogue: 0,0:14:42.57,0:14:43.96,Main,Kin'emon,0,0,0,,Hiç de bile!
Dialogue: 0,0:14:43.96,0:14:46.80,Main,Zoro,0,0,0,,Sen bizim aşçıyı kaçıran kadınsın.
Dialogue: 0,0:14:46.80,0:14:47.75,Main,Luffy,0,0,0,,Sanji'yi mi?!
Dialogue: 0,0:14:48.18,0:14:49.10,Flashbacks,Violet,0,0,0,,Kara Bacak!
Dialogue: 0,0:14:50.65,0:14:53.01,Flashbacks,Sanji,0,0,0,,Cancağızım Violet-chan'ım!
Dialogue: 0,0:14:53.54,0:14:56.22,Main,Violet,0,0,0,,Geminizi kurtarabilmek için ayrıldı benden.
Dialogue: 0,0:14:56.22,0:14:58.38,Main,Zoro,0,0,0,,Olanları biliyoruz.
Dialogue: 0,0:14:58.38,0:15:01.05,Main,Zoro,0,0,0,,Sunny-go'nun başının dertte olduğunu\Nsen mi söyledin?
Dialogue: 0,0:15:01.05,0:15:05.81,Main,Kin'emon,0,0,0,,Sanji-dono bize verdiği haritayı da\Nsenden mi aldı yoksa?
Dialogue: 0,0:15:05.81,0:15:07.73,Main,Violet,0,0,0,,Evet, ben verdim.
Dialogue: 0,0:15:07.73,0:15:09.47,Main,Kin'emon,0,0,0,,Nereden buldun o haritayı peki?
Dialogue: 0,0:15:09.88,0:15:13.22,Main,Violet,0,0,0,,Doflamingo'nun çalışanlarından biriydim.
Dialogue: 0,0:15:13.22,0:15:15.30,Main,Luffy,0,0,0,,Ne?!\NMingo'nun çalışanı mı!?
Dialogue: 0,0:15:15.30,0:15:19.20,Main,Wicca,0,0,0,,Doflamingo için çalışıyormuş\Nnumarası yapıyordu yalnızca!
Dialogue: 0,0:15:22.48,0:15:23.67,Main,Violet,0,0,0,,Wicka!
Dialogue: 0,0:15:24.60,0:15:26.70,Main,Wicca,0,0,0,,Hatırladın mı beni?!
Dialogue: 0,0:15:27.06,0:15:29.54,Main,Violet,0,0,0,,Yeteneğimi unuttun mu yoksa?
Dialogue: 0,0:15:29.54,0:15:32.97,Main,Violet,0,0,0,,Yaptığınız her şeyi izliyordum.
Dialogue: 0,0:15:32.97,0:15:38.56,Main,Violet,0,0,0,,Ölen ablamın yerine Rebecca'yı yetiştiren\Ntek bacaklı Asker-san'la birlikte...
Dialogue: 0,0:15:38.56,0:15:42.00,Main,Violet,0,0,0,,...savaş hazırlığı yaptığınızı biliyordum!
Dialogue: 0,0:15:42.82,0:15:44.69,Main,Violet,0,0,0,,Her şeyi gördüm!
Dialogue: 0,0:15:45.91,0:15:48.83,Main,Violet,0,0,0,,Babama inandığınız için\Nteşekkür ederim!
Dialogue: 0,0:15:53.80,0:15:56.40,Main,Wicca,0,0,0,,Viola-sama!
Dialogue: 0,0:15:58.02,0:15:58.90,Main,Luffy,0,0,0,,Yok artık?!
Dialogue: 0,0:15:58.90,0:16:01.52,Main,Luffy,0,0,0,,Prenses miydin sen?!
Dialogue: 0,0:16:04.70,0:16:06.18,Main,Violet,0,0,0,,Hepsi geçmişte kaldı artık.
Dialogue: 0,0:16:07.12,0:16:10.50,Main,Luffy,0,0,0,,Rebecca kralın torunuysa,\Nsen de o zaman...
Dialogue: 0,0:16:10.50,0:16:11.42,Main,Luffy,0,0,0,,...onun annesi misin!?
Dialogue: 0,0:16:11.42,0:16:13.62,Main,Violet,0,0,0,,Rebecca yeğenim benim.
Dialogue: 0,0:16:16.72,0:16:20.39,Main,Violet,0,0,0,,Ablam Scarlet'in kızı.
Dialogue: 0,0:16:23.84,0:16:25.24,Main,Kin'emon,0,0,0,,Yoksa bu...
Dialogue: 0,0:16:25.24,0:16:27.50,Main,Zoro,0,0,0,,Gizli bir giriş mi?
Dialogue: 0,0:16:27.50,0:16:30.30,Main,Kin'emon,0,0,0,,Ninja olduğunu bilmiyordum!
Dialogue: 0,0:16:36.17,0:16:39.48,Main,Violet,0,0,0,,Buradan asansörü kullanmadan\Ngirişe kadar varabilirsiniz.
Dialogue: 0,0:16:40.06,0:16:42.68,Main,Violet,0,0,0,,Doflamingo'nun bile bilmediği bir yer.
Dialogue: 0,0:16:49.89,0:16:52.22,Main,Kin'emon,0,0,0,,Bu koca sepet de neyin nesi?
Dialogue: 0,0:16:52.56,0:16:55.33,Main,Violet,0,0,0,,Ağır yük kaldırmak için kullanılan\Nmakara sistemi. Bakın.
Dialogue: 0,0:16:56.21,0:16:59.80,Main,Zoro,0,0,0,,Epey yükseğe çıkıyor.
Dialogue: 0,0:17:00.24,0:17:02.17,Main,Kin'emon,0,0,0,,Merdiven de var.
Dialogue: 0,0:17:02.58,0:17:07.98,Main,Violet,0,0,0,,Merdivenleri kullanırsak sarayın girişinin bulunduğu Siper Kulesi'ne varırız.
Dialogue: 0,0:17:12.74,0:17:17.44,Main,Zoro,0,0,0,,Luffy, sen şu kayayı yüklenip\Ntepeye çıkıversene?
Dialogue: 0,0:17:17.44,0:17:20.05,Main,Kin'emon,0,0,0,,Harika fikirmiş!
Dialogue: 0,0:17:20.74,0:17:26.89,Main,Kin'emon,0,0,0,,Tepede zinciri yakalayıp\Naşağı atlarsan biz de yukarı çıkabiliriz.
Dialogue: 0,0:17:27.34,0:17:28.77,Main,Violet,0,0,0,,Delilik bu!
Dialogue: 0,0:17:37.33,0:17:38.18,Main,Luffy,0,0,0,,Pekâlâ!
Dialogue: 0,0:17:38.18,0:17:39.66,Main,Luffy,0,0,0,,Görüşürüz o zaman!
Dialogue: 0,0:17:41.29,0:17:42.86,Main,Zoro,0,0,0,,Acele et, Luffy!
Dialogue: 0,0:17:42.86,0:17:45.48,Main,Kin'emon,0,0,0,,Sen de atla şöyle, Kunoichi!
Dialogue: 0,0:17:45.48,0:17:47.65,Main,Violet,0,0,0,,Ne?!
Dialogue: 0,0:17:48.13,0:17:51.52,Captions,,0,0,180,,{\fad(405,0)}Oyuncak Evi
Dialogue: 0,0:17:52.54,0:17:54.90,Main,Franky,0,0,0,,Can sıkıcı serseriler!
Dialogue: 0,0:17:56.89,0:17:58.97,Main,Franky,0,0,0,,{\fad(150,150)}Franky...
Dialogue: 0,0:18:02.33,0:18:04.03,Main,Franky,0,0,0,,{\fad(150,150)}...Roket...
Dialogue: 0,0:18:05.38,0:18:06.21,Main,Franky,0,0,0,,{\fad(150,150)}Bekleyin.
Dialogue: 0,0:18:07.24,0:18:09.52,Main,Franky,0,0,0,,{\fad(150,150)}...Fırlatıcısı!
Dialogue: 0,0:18:13.10,0:18:14.60,Main,Grunt,0,0,0,,Kaçın!
Dialogue: 0,0:18:14.60,0:18:15.97,Main,Grunt,0,0,0,,Elemanın şakası yok!
Dialogue: 0,0:18:15.97,0:18:19.34,Main,Grunt,0,0,0,,Gerçi kafasındaki tüfekten\Nbir şey çıkmadı ama...
Dialogue: 0,0:18:27.05,0:18:29.48,Main,Grunt,0,0,0,,Senyor, kaçın lütfen!
Dialogue: 0,0:18:30.59,0:18:32.79,Main,Grunt,0,0,0,,Gücünüzü kullanıp yere saklanın!
Dialogue: 0,0:18:33.22,0:18:35.54,Main,Grunt,0,0,0,,Ayakkabı fırçasıyla\Ndiş fırçalamanın sırası mı?!
Dialogue: 0,0:18:35.54,0:18:37.03,Main,Woman,0,0,0,,{\i1}Ne?{\i0}
Dialogue: 0,0:18:37.03,0:18:38.45,Main,Woman,0,0,0,,Amanın!
Dialogue: 0,0:18:38.45,0:18:40.33,Main,Woman,0,0,0,,Ne erkeksi!
Dialogue: 0,0:18:41.77,0:18:43.76,Main,Grunt,0,0,0,,Senyor!
Dialogue: 0,0:18:43.76,0:18:45.92,Main,Grunt,0,0,0,,Olamaz ya!
Dialogue: 0,0:18:46.21,0:18:48.12,Main,Grunt,0,0,0,,{\i1}Senyor Pink!{\i0}
Dialogue: 0,0:18:48.12,0:18:50.11,Main,Women,0,0,0,,{\i1}Senyor!{\i0}
Dialogue: 0,0:18:50.11,0:18:52.41,Main,Grunt,0,0,0,,Neden gücünüzü kullanıp kaçmadınız?!
Dialogue: 0,0:18:53.56,0:18:57.55,Main,Pink,0,0,0,,Yanlış anlamanızı istemem, gençler.
Dialogue: 0,0:19:01.04,0:19:06.32,Main,Pink,0,0,0,,Duvarlarda olsun, yerde olsun gönlümce yüzmemi sağlayan Yüz Yüz Meyve'min gücü...
Dialogue: 0,0:19:08.64,0:19:12.61,Main,Pink,0,0,0,,...düşmanlarımdan kaçmak için değil.
Dialogue: 0,0:19:15.96,0:19:17.67,Main,Pink,0,0,0,,Ben yalnızca...
Dialogue: 0,0:19:22.13,0:19:25.49,Main,Pink,0,0,0,,...canım isteyince yüzerim!
Dialogue: 0,0:19:27.59,0:19:31.52,Main,Grunts,0,0,0,,{\i1}Ne özgür bir ruh!{\i0}
Dialogue: 0,0:19:32.73,0:19:33.92,Main,Grunts,0,0,0,,Konyak mı o?
Dialogue: 0,0:19:35.02,0:19:39.02,Main,Grunts,0,0,0,,- Vucüdu kan içinde!\N- Kesin kırık kemiği de vardır...
Dialogue: 0,0:19:39.02,0:19:41.43,Main,Women,0,0,0,,Konyakla kendini mi temizliyor yoksa?!
Dialogue: 0,0:19:41.43,0:19:43.33,Main,Grunt,0,0,0,,Hayır!
Dialogue: 0,0:19:43.94,0:19:49.73,Main,Grunt,0,0,0,,Senyor! Canınız pahasına\No darbeyi yemenizin nedeni...
Dialogue: 0,0:19:51.10,0:19:56.16,Main,Grunt,0,0,0,,...arkanızda hareket edemeyen bir dostunuzun\Nolduğunu bilmenizdi değil mi?!
Dialogue: 0,0:19:56.16,0:19:58.44,Main,Machvise,0,0,0,,Karnım-in!
Dialogue: 0,0:19:59.90,0:20:01.81,Main,Woman,0,0,0,,Senyor!
Dialogue: 0,0:20:01.81,0:20:03.78,Main,Woman,0,0,0,,Kalbim yerinden çıkacak şimdi!
Dialogue: 0,0:20:04.86,0:20:07.81,Main,Pink,0,0,0,,Olmuş bitmiş şeyler, unuttum bile.
Dialogue: 0,0:20:07.81,0:20:10.12,Main,Women,0,0,0,,{\i1}Kölen oluruz Senyor!{\i0}
Dialogue: 0,0:20:10.12,0:20:12.02,Main,Pink,0,0,0,,Vise, kalkabilecek misin?
Dialogue: 0,0:20:12.02,0:20:14.86,Main,Machvise,0,0,0,,İyiyim-in!
Dialogue: 0,0:20:14.86,0:20:17.33,Main,Franky,0,0,0,,Ne sert biri çıktı bu!
Dialogue: 0,0:20:20.83,0:20:21.68,Main,Machvise,0,0,0,,{\fad(150,150)}Ton-Ton!
Dialogue: 0,0:20:26.20,0:20:28.52,Main,Machvise,0,0,0,,Karnım-in!
Dialogue: 0,0:20:28.81,0:20:31.44,Main,Machvise,0,0,0,,{\an8}Gene ıskaladım-in!
Dialogue: 0,0:20:31.44,0:20:34.11,Main,Machvise,0,0,0,,{\an8}Fare gibi çevik çıktın!
Dialogue: 0,0:20:29.10,0:20:34.11,Captions,,0,0,220,,{\fad(519,0)}Machvise - Don Quixote Ailesi\NYöneticisi (Diamante Ordusu)
Dialogue: 0,0:20:34.11,0:20:37.10,Main,Franky,0,0,0,,Kapa çeneni be!\NSüper sen de kimsin?!
Dialogue: 0,0:20:37.10,0:20:38.73,Main,Marine,0,0,0,,Yolun sonu!
Dialogue: 0,0:20:39.77,0:20:43.05,Main,Marine,0,0,0,,Hasır Şapka Tayfası'ndan Sayborg Franky!
Dialogue: 0,0:20:47.74,0:20:51.13,Main,Marine,0,0,0,,Oyuncak Evi\Ndonanmanın kuşatması altındadır!
Dialogue: 0,0:20:51.13,0:20:53.74,Main,Franky,0,0,0,,Neden böyle bir şey yapıyorsunuz?
Dialogue: 0,0:20:53.74,0:20:56.93,Main,Machvise,0,0,0,,Ne oluyor?\NBiri açıklama yapsın-in!
Dialogue: 0,0:20:57.50,0:20:59.94,Main,Pink,0,0,0,,Al başına belayı.
Dialogue: 0,0:21:00.46,0:21:05.13,Captions,,0,0,190,,{\fad(657,0)}Kraliyet Sarayı
Dialogue: 0,0:21:02.14,0:21:05.13,Main,Doflamingo,0,0,4,,Donanma harekete geçti.
Dialogue: 0,0:21:05.13,0:21:10.95,Main,Doflamingo,0,0,4,,Doğru kararı vermene sevindim, Fujitora.
Dialogue: 0,0:21:08.29,0:21:10.95,Captions,,0,0,220,,{\fad(387,0)}Taht Odası
Dialogue: 0,0:21:13.95,0:21:18.97,Main,Fujitora,0,0,0,,Senden yana olduğumu göstermez bu.
Dialogue: 0,0:21:18.97,0:21:25.83,Main,Fujitora,0,0,0,,Hasır Şapkalar'ın yanısıra ülkede cirit atan\Nşüpheli başka bir grup daha mevcut.
Dialogue: 0,0:21:25.83,0:21:28.10,Main,Fujitora,0,0,0,,Yani bu hususta\Nbaşka seçeneğim yoktu.
Dialogue: 0,0:21:30.57,0:21:37.76,Main,Fujitora,0,0,0,,Donanma, sivillere yansıyacak hasarı\Nen aza indirgemek için savaşmalı.
Dialogue: 0,0:21:38.94,0:21:46.22,Main,Fujitora,0,0,0,,Keza Hasır Şapka'nın amacı seni öldürmekse bu uğurda büyük bir yıkıma da neden olacaktır.
Dialogue: 0,0:21:47.85,0:21:53.09,Main,Fujitora,0,0,0,,Bu noktada adalet anlayışım\Nonu durdurmayı gerektiriyor!
Dialogue: 0,0:21:53.09,0:21:57.43,Main,Fujitora,0,0,0,,Seninle ondan sonra ilgileneceğim!
Dialogue: 0,0:21:57.89,0:22:00.80,Main,Doflamingo,0,0,0,,Ne dedin, ne dedin?
Dialogue: 0,0:22:00.80,0:22:05.74,Main,Fujitora,0,0,0,,Ben Genel Askere Alma sırasında\Nseçilmiş yenilerden biriyim...
Dialogue: 0,0:22:05.74,0:22:11.59,Main,Fujitora,0,0,0,,...fakat Donanma Amirali olarak\Natanmış olmak beni bir hususta teşvik etti.
Dialogue: 0,0:22:11.59,0:22:17.68,Main,Fujitora,0,0,0,,Amacım Shichibukai sistemini\Nkökünden kazımak!
Dialogue: 0,0:22:18.24,0:22:23.20,Main,Fujitora,0,0,0,,Vakti zamanında ülkenin tekini\Nele geçirmeye çalışan bir korsan vardı.
Dialogue: 0,0:22:23.20,0:22:29.03,Main,Fujitora,0,0,0,,Ve bunu başarsaydı, bahsi geçen krallık da aynı bu ülke gibi şüpheli bir krallık haline dönüşecekti.
Dialogue: 0,0:22:29.03,0:22:31.93,Main,Doflamingo,0,0,0,,Güç dengesine ne olacak peki?!
Dialogue: 0,0:22:31.93,0:22:36.12,Main,Fujitora,0,0,0,,Kim bilir? Arı kovanına çomak sokmadan\Nboş mu dolu mu bilemezsin.
Dialogue: 0,0:22:36.12,0:22:37.40,Main,Fujitora,0,0,0,,O yüzden...
Dialogue: 0,0:22:37.86,0:22:40.22,Main,Fujitora,0,0,0,,Bu korku krallığını devam ettirirsen...
Dialogue: 0,0:22:47.46,0:22:51.88,Main,Fujitora,0,0,0,,...başındaki ödülü arttırırız,\NGökçe Şeytan.
Dialogue: 0,0:22:53.08,0:22:57.29,Main,Doflamingo,0,0,0,,"Beni öldür daha iyi olur."\Ndedin gibime geldi.
Dialogue: 0,0:22:57.29,0:23:02.36,Main,Fujitora,0,0,0,,Acele etme.\NŞimdilik iyi geçinmeye bakalım.
Dialogue: 0,0:23:04.53,0:23:07.53,Main,Fujitora,0,0,0,,Ülkeni koruyacağım.
Dialogue: 0,0:23:08.13,0:23:12.22,Main,Fujitora,0,0,0,,Ülkenin hangi "kabahatleri"\Nsu yüzüne çıkarsa çıksın...
Dialogue: 0,0:23:12.22,0:23:18.48,Main,Fujitora,0,0,0,,...kör bir adamım sonuçta.\NGörmeyeceğim, için rahat olsun.
Dialogue: 0,0:23:18.48,0:23:22.95,Main,Fujitora,0,0,0,,Bu yıl Dünya Konferansı,\NReverie yapılacak.
Dialogue: 0,0:23:26.34,0:23:30.24,Main,Fujitora,0,0,0,,Sevsen de sevmesen de\Ndünyada bir takım değişiklikler olacak.
Dialogue: 0,0:23:32.32,0:23:36.59,Main,Announcer,0,0,0,,Corrida kolezyumu dövüş müsabakası!
Dialogue: 0,0:23:37.44,0:23:40.58,Main,Announcer,0,0,0,,Finaller!
Dialogue: 0,0:23:49.05,0:23:50.84,Main,Koala,0,0,0,,Yetiştim!
Dialogue: 0,0:23:55.10,0:24:00.08,Main,Announcer,0,0,0,,Özel ring yerine yerleşirken\Ntüm ülkenin gözü üzerimizde!
Dialogue: 0,0:24:02.19,0:24:05.82,Main,Announcer,0,0,0,,Beş yarışmacı\Nyakında ringe adımını atacak!
Dialogue: 0,0:24:12.28,0:24:13.90,Main,Sabo,0,0,0,,Heyecanlanmaya başladım!
Dialogue: 0,0:24:14.69,0:24:17.88,Main,Sabo,0,0,0,,Pekâlâ, gidelim Marine Colosseo!
Dialogue: 0,0:24:17.88,0:24:21.24,Main,Bartolomeo,0,0,0,,Adım Bartolomeo yahu!\NO da neydi öyle?!
Dialogue: 0,0:24:23.87,0:24:27.24,Main,Announcer,0,0,0,,Haydi bakalım!\NSahaya ilk adım atacak kişi...
Dialogue: 0,0:24:32.62,0:24:34.25,Main,Announcer,0,0,0,,Ve işte geldi!
Dialogue: 0,0:24:34.64,0:24:41.02,Main,Announcer,0,0,0,,Bu yarışmada şöhret kazanmış adam!\NHepimizin favorisi Lucy geliyor!
Dialogue: 0,0:24:47.06,0:24:50.82,Thoughts,Sabo,0,0,0,,{\i1}İzle beni, Ace!{\i0}
