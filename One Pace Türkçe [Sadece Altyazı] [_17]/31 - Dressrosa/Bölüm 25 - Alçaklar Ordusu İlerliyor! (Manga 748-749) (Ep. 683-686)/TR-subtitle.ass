ress BT,25,&H00FFFFFF,&H0000FFFF,&HFF000000,&H20000000,0,0,0,0,100,100,0,0,1,1,1,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.91,0:00:02.37,Credits,,0,0,0,,Translation & initial timing YibisDialogue: 0,0:00:02.37,0:00:04.18,Credits,,0,0,0,,Timing and typesetting Halee  Galaxy 9000Dialogue: 0,0:00:04.18,0:00:05.66,Credits,,0,0,0,,Quality-checking Simon Galaxy 9000Dialogue: 0,0:00:05.66,0:00:07.48,Credits,,0,0,0,,Soundtracking HaleeDialogue: 0,0:00:07.48,0:00:09.13,Credits,,0,0,0,,Video editing Simon  Galaxy 9000Dialogue: 0,0:00:09.13,0:00:10.75,Credits,,0,0,0,,Raw provider GS-RawsDialogue: 0,0:00:10.75,0:00:12.42,Credits,,0,0,0,,Infoboxes & Title Cards SimonDialogue: 0,0:00:01.26,0:00:03.90,Lyrics,,0,0,0,,♪ Gidelim tüm parıltımızla, koşar adım, sonsuza dek! ♪Dialogue: 0,0:00:03.93,0:00:06.66,Lyrics,,0,0,0,,♪ İlerlemeye devam edelim! ♪Dialogue: 0,0:00:06.70,0:00:09.57,Lyrics,,0,0,0,,♪ Değişmeyen bağlar mutlak aydınlatacak... ♪Dialogue: 0,0:00:09.63,0:00:12.67,Lyrics,,0,0,0,,♪ ...rüyamızın sonunu! ♪Dialogue: 0,0:00:12.77,0:00:15.27,Lyrics,,0,0,0,,♪ Uyan, uyan, uyan, uyan haydi kalbim! ♪Dialogue: 0,0:00:15.34,0:00:18.18,Lyrics,,0,0,0,,♪ Başaracağız! Durmaksızın devam! ♪Dialogue: 0,0:00:23.72,0:00:28.07,Lyrics,,0,0,0,,♪ Tek pusulamız özgürlüktür. En sıkı dostlarız. ♪Dialogue: 0,0:00:28.15,0:00:34.59,Lyrics,,0,0,0,,♪ Kendi rotamızı bundan sonra da yine kendimiz çizeceğiz. ♪Dialogue: 0,0:00:34.66,0:00:39.00,Lyrics,,0,0,0,,♪ Her gün tam hız ilerliyoruz. Doğuya git, batıya git. ♪Dialogue: 0,0:00:39.06,0:00:45.44,Lyrics,,0,0,0,,♪ Birbiri ardına yapmak istediğimiz şeyler buluyor ve yapıyoruz da hepsini. ♪Dialogue: 0,0:00:45.50,0:00:50.99,Lyrics,,0,0,0,,♪ Sabahları etmeye dayanamaz aceleci gönlümüz. (Bekleyemem!) ♪Dialogue: 0,0:00:51.11,0:00:56.05,Lyrics,,0,0,0,,♪ Neden alıp biz yapıştırmıyoruz güneşi göğe. ♪Dialogue: 0,0:00:56.11,0:00:58.95,Lyrics,,0,0,0,,♪ Zorla ve yola çıkmıyoruz! ♪Dialogue: 0,0:00:59.95,0:01:02.65,Lyrics,,0,0,0,,♪ Evet tüm parıltımızla, koşar adım, sonsuza dek! ♪Dialogue: 0,0:01:02.72,0:01:06.59,Lyrics,,0,0,0,,♪ Hayal kırıntılarımız birleştirerek. ♪Dialogue: 0,0:01:06.66,0:01:10.75,Lyrics,,0,0,0,,♪ Titretiyorsa eğer gönlünü var mı daha büyük hazine. ♪Dialogue: 0,0:01:10.83,0:01:13.43,Lyrics,,0,0,0,,♪ Gidelim tüm parıltımızla, koşar adım, sonsuza dek! ♪Dialogue: 0,0:01:13.50,0:01:16.13,Lyrics,,0,0,0,,♪ İlerlemeye devam edelim! ♪Dialogue: 0,0:01:16.20,0:01:19.17,Lyrics,,0,0,0,,♪ Değişmeyen bağlar mutlak aydınlatacak... ♪Dialogue: 0,0:01:19.24,0:01:22.24,Lyrics,,0,0,0,,♪ ...rüyamızın sonunu! ♪Dialogue: 0,0:01:22.31,0:01:24.94,Lyrics,,0,0,0,,♪ Uyan, uyan, uyan, uyan haydi kalbim ♪Dialogue: 0,0:01:25.01,0:01:27.41,Lyrics,,0,0,0,,♪ Başaracağız! Durmaksızın devam! ♪Dialogue: 0,0:01:31.54,0:01:41.54,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gnsDialogue: 0,0:11:24.20,0:11:34.20,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gnsDialogue: 0,0:21:35.00,0:21:45.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gnsDialogue: 0,0:01:31.54,0:01:34.24,Title,,0,0,240,,Alçaklar Ordusu İlerliyor!Dialogue: 0,0:01:34.24,0:01:36.11,Main,Grunt,0,0,0,,Sus artık Hasır Şapka!Dialogue: 0,0:01:36.11,0:01:38.70,Main,Grunt,0,0,0,,Pica-sama tiz sesi konusunda çok hassastır!Dialogue: 0,0:01:38.70,0:01:41.05,Main,Grunt,0,0,0,,O devasa bedeniyle kendini kaybedecek olursa...Dialogue: 0,0:01:54.36,0:01:56.09,Main,Grunt,0,0,0,,Kaçın!Dialogue: 0,0:01:57.40,0:02:01.00,Main,Grunt,0,0,0,,Yumruk falan değil bu! Şehir üstümüze düşüyor!Dialogue: 0,0:02:01.00,0:02:04.04,Main,Fujitora,0,0,0,,Çok kötü bir şeyin olduğunu seziyorum!Dialogue: 0,0:02:04.04,0:02:07.31,Main,Marine,0,0,0,,Issho-san, kaçın! Dev bir taş adam...Dialogue: 0,0:02:08.67,0:02:11.88,Main,Zoro,0,0,0,,Luffy! Düşmanlarınla dalga geçmeyi bırakman lazım artık...Dialogue: 0,0:02:13.68,0:02:15.51,Main,Luffy,0,0,0,,Sen de kendine engel olamıyorsun işte!Dialogue: 0,0:02:15.51,0:02:16.92,Main,Law,0,0,0,,Siz var ya...Dialogue: 0,0:02:22.19,0:02:23.79,Main,Grunt,0,0,0,,Geliyor!Dialogue: 0,0:03:07.10,0:03:10.07,Captions,,0,0,0,,Kolezyum Dışındaki  MeydanDialogue: 0,0:03:07.07,0:03:09.23,Main,Luffy,0,0,0,,Neredeyiz acaba?Dialogue: 0,0:03:09.23,0:03:10.07,Main,Zoro,0,0,0,,Kim bilir?Dialogue: 0,0:03:10.44,0:03:13.31,Main,Law,0,0,0,,Kraliyet Sarayı'ndan epey uzağa uçtuk gibi.Dialogue: 0,0:03:14.97,0:03:18.48,Main,Zoro,0,0,0,,Lanet olası taş insan!Dialogue: 0,0:03:18.48,0:03:21.88,Main,Zoro,0,0,0,,Oz'dan bile büyük çıktı!Dialogue: 0,0:03:22.38,0:03:24.95,Main,Zoro,0,0,0,,Onu nasıl yeneceğimi bari bilseydim...Dialogue: 0,0:03:25.48,0:03:27.45,Main,Cavendish,0,0,0,,Hasır Şapka.Dialogue: 0,0:03:29.32,0:03:30.56,Main,Luffy,0,0,0,,Kabak!Dialogue: 0,0:03:33.93,0:03:36.80,Main,Cavendish,0,0,0,,Sen de Korsan Avcısı Zoro olmalısın.Dialogue: 0,0:03:36.80,0:03:39.80,Main,Cavendish,0,0,0,,Ve Trafalgar...Dialogue: 0,0:03:39.80,0:03:40.80,Main,Cavendish,0,0,0,,...Law!Dialogue: 0,0:03:43.00,0:03:45.84,Main,Cavendish,0,0,0,,Şanımı...Dialogue: 0,0:03:45.84,0:03:48.51,Main,Cavendish,0,0,0,,...bana geri verin sizi Musibet Neslin tohumları!Dialogue: 0,0:03:48.51,0:03:49.52,Main,Luffy,0,0,0,,Ne yapıyorsun be?!Dialogue: 0,0:03:49.52,0:03:51.44,Main,Luffy,0,0,0,,Benim dostum artık o!Dialogue: 0,0:03:51.44,0:03:52.64,Main,Law,0,0,0,,Yok daha neler!Dialogue: 0,0:03:52.64,0:03:55.68,Main,Luffy,0,0,0,,Bu ne şimdi?! Hâlâ bana kızgın mısın?!Dialogue: 0,0:03:58.28,0:04:02.72,Main,Cavendish,0,0,0,,Hayır, sizinle işim yok artık.Dialogue: 0,0:04:04.09,0:04:09.43,Main,Cavendish,0,0,0,,Keza dostlarınızdan biri, Tanrı Usopp, hayatımı kurtardı!Dialogue: 0,0:04:09.43,0:04:15.33,Main,Cavendish,0,0,0,,Kendi hayatı pahasına yüzlerce kişiyi kurtaran o cesur adamın görüntüsünü asla unutmayacağım!Dialogue: 0,0:04:15.33,0:04:16.94,Main,Cavendish,0,0,0,,Göremedim gerçi ya...Dialogue: 0,0:04:17.64,0:04:20.64,Main,Luffy,0,0,0,,Dostum hakkında böyle şeyler söylemen beni sevindirdi.Dialogue: 0,0:04:21.07,0:04:22.47,Main,Cavendish,0,0,0,,Sahi ya bak!Dialogue: 0,0:04:24.58,0:04:28.98,Main,Cavendish,0,0,0,,Trafalgar, bu senin şapkan değil mi?Dialogue: 0,0:04:28.98,0:04:31.22,Main,Cavendish,0,0,0,,Kolezyum'un önünde duruyordu.Dialogue: 0,0:04:31.22,0:04:33.42,Main,Cavendish,0,0,0,,Gel giydireyim.Dialogue: 0,0:04:33.42,0:04:35.79,Main,Cavendish,0,0,0,,Yaklaş biraz yaklaş!Dialogue: 0,0:04:35.79,0:04:38.02,Main,Law,0,0,0,,Sana güvenir miyim be?!Dialogue: 0,0:04:39.39,0:04:41.39,Main,Cavendish,0,0,0,,Neyse ne işte.Dialogue: 0,0:04:41.39,0:04:43.43,Main,Cavendish,0,0,0,,Şu anda biraz meşgulüm.Dialogue: 0,0:04:44.26,0:04:49.03,Main,Cavendish,0,0,0,,Size teşekkür babında Doflamingo'yu öldürmeye karar verdim!Dialogue: 0,0:04:49.90,0:04:50.94,Main,Luffy,0,0,0,,Ne?!Dialogue: 0,0:04:51.40,0:04:53.74,Main,Cavendish,0,0,0,,Yani bundan sonrasını ben hallederim.Dialogue: 0,0:04:53.74,0:04:55.34,Main,Cavendish,0,0,0,,Siz girin bir taşın altına saklan-Dialogue: 0,0:04:55.34,0:04:57.84,Main,Luffy,0,0,0,,İstemez sağ ol! Onun işini ben bitireceğim!Dialogue: 0,0:04:57.84,0:05:01.75,Main,Luffy,0,0,0,,Hem benim de bana yemek ısmarladığı için Rebecca'ya borcum var!Dialogue: 0,0:05:01.75,0:05:04.58,Main,Law,0,0,0,,Savaş nedenin yemek miydi yani?!Dialogue: 0,0:05:04.58,0:05:07.92,Main,Cavendish,0,0,0,,Hadi be oradan! Beni kandırmaya çalışıyorsun!Dialogue: 0,0:05:07.92,0:05:11.66,Main,Cavendish,0,0,0,,Amacın Doflamingo'yu öldürüp daha da fazla ünlenmek, değil mi?!Dialogue: 0,0:05:11.66,0:05:13.29,Main,Luffy,0,0,0,,Ne ünüymüş o?!Dialogue: 0,0:05:13.29,0:05:15.53,Main,Cavendish,0,0,0,,Düşünsene!Dialogue: 0,0:05:15.89,0:05:20.87,Main,Cavendish,0,0,0,,Doflamingo gibi kötü bir korsanı alt edebilirsen gazeteler peşini bırakmaz!Dialogue: 0,0:05:21.40,0:05:24.24,Main,Cavendish,0,0,0,,Hikayem sabahtan akşama tonla insana ulaşacak!Dialogue: 0,0:05:26.10,0:05:28.81,Main,Cavendish,0,0,0,,"Merhaba süperstar!"Dialogue: 0,0:05:29.47,0:05:33.23,Main,Cavendish,0,0,0,,Süperstar mı dediniz? Yapmayın yahu böyle!Dialogue: 0,0:05:33.46,0:05:34.81,Main,Cavendish,0,0,0,,"Bir şey mi istemiştiniz?"Dialogue: 0,0:05:34.81,0:05:38.88,Main,Cavendish,0,0,0,,"Cavendish-san, son yıllara ait korsan aktiviteleri hakkında ne düşünüyorsunuz?"Dialogue: 0,0:05:38.88,0:05:43.72,Main,Cavendish,0,0,0,,"Ne? Oradasınız değil mi, Cavendish-san?!"Dialogue: 0,0:05:43.72,0:05:47.63,Main,Cavendish,0,0,0,,Ne oldu? Önündeyim görmüyor musun?Dialogue: 0,0:05:47.63,0:05:48.73,Main,Cavendish,0,0,0,,"Sahiden mi?!"Dialogue: 0,0:05:48.73,0:05:51.73,Main,Cavendish,0,0,0,,"O kadar göz alıcısınız ki bakamıyoruz bile!"Dialogue: 0,0:05:51.73,0:05:56.60,Main,Cavendish,0,0,0,,Ah gözünüzü aldım demek, kusura bakmayın! Işıltıma engel olamıyorum!Dialogue: 0,0:05:56.60,0:05:59.07,Main,Cavendish,0,0,0,,"Ay harika! Gerçek bir yıldız gibisiniz!"Dialogue: 0,0:05:59.07,0:06:02.54,Main,Luffy,0,0,0,,Biz yavaştan gidelim....Dialogue: 0,0:06:03.68,0:06:09.68,Main,Cavendish,0,0,0,,Haydi bakalım, beni zihinlerinize kazıyın! Süperstarım ben!Dialogue: 0,0:06:17.02,0:06:18.02,Main,Grunts,0,0,0,,Şuraya da bakalım...Dialogue: 0,0:06:18.02,0:06:19.09,Main,Grunts,0,0,0,,Bulun onu!Dialogue: 0,0:06:21.96,0:06:24.53,Main,Grunts,0,0,0,,Hasır Şapka'nın cesedini göremiyorum!Dialogue: 0,0:06:24.53,0:06:28.23,Main,Grunts,0,0,0,,Tamamen paramparça mı oldu yoksa bir yerlere mi uçtu bilinmez.Dialogue: 0,0:06:38.98,0:06:40.98,Main,Pica,0,0,0,,Bulun onu!Dialogue: 0,0:06:40.98,0:06:43.92,Main,Pica,0,0,0,,Yaşıyorsa derhal haberim olsun!Dialogue: 0,0:06:44.45,0:06:47.79,Main,Pica,0,0,0,,Doffy'e ulaşmasına izin vermeyeceğim!Dialogue: 0,0:06:50.19,0:06:52.39,Main,Chinjao,0,0,0,,Buradasın demek, Hasır Şapka!Dialogue: 0,0:06:53.29,0:06:54.99,Main,Sai,0,0,0,,Çekilin yolumdan!Dialogue: 0,0:06:54.99,0:06:56.39,Main,Boo,0,0,0,,Önümüze çıkmayın!Dialogue: 0,0:06:57.66,0:06:59.32,Main,Chinjao,0,0,0,,Çekilin yolumdan!Dialogue: 0,0:06:59.32,0:07:00.63,Main,Luffy,0,0,0,,Bu ses...Dialogue: 0,0:07:03.00,0:07:06.64,Main,Chinjao,0,0,2,,Bekle Garp'ın torunu!Dialogue: 0,0:07:03.40,0:07:06.64,Captions,Caption,0,0,240,,Happo Donanması Don ChinjaoDialogue: 0,0:07:06.64,0:07:09.84,Main,Sai,0,0,2,,Seni arıyorduk adi herif!Dialogue: 0,0:07:06.70,0:07:09.84,Captions,Caption,0,0,240,,Happo Donanması Komutan, SaiDialogue: 0,0:07:10.34,0:07:13.08,Main,Boo,0,0,2,,Bu sefer kaçamayacaksın!Dialogue: 0,0:07:09.97,0:07:13.08,Captions,Caption,0,0,240,,Happo Donanması Komutan Yardımcısı, BooDialogue: 0,0:07:15.71,0:07:17.58,Main,Luffy,0,0,0,,Tahmin etmiştim...Dialogue: 0,0:07:17.58,0:07:19.95,Secondary,Chinjao,0,0,76,,Bekle!Dialogue: 0,0:07:18.42,0:07:21.15,Main,Luffy,0,0,0,,Eyvah, kaçalım!Dialogue: 0,0:07:21.15,0:07:22.92,Main,Zoro,0,0,0,,Ne? Ne oldu yahu!?Dialogue: 0,0:07:23.76,0:07:25.96,Main,Chinjao,0,0,0,,Neden kaçıyorsun?!Dialogue: 0,0:07:28.16,0:07:30.83,Main,Luffy,0,0,0,,Hepsi de amma inatçı çıktı!Dialogue: 0,0:07:30.83,0:07:32.22,Main,Chinjao and co,0,0,0,,Bekle!Dialogue: 0,0:07:32.22,0:07:33.67,Main,Luffy,0,0,0,,Vazgeçmeyi bilmez mi bunlar?!Dialogue: 0,0:07:33.67,0:07:35.37,Main,Chinjao,0,0,0,,Neden beklemiyorsun?!Dialogue: 0,0:07:35.37,0:07:37.67,Main,Chinjao,0,0,0,,Kafa Silahlanma!Dialogue: 0,0:07:42.01,0:07:47.81,Main,Chinjao,0,0,0,,Bekle dedim sana, Garp'ın torunu...Dialogue: 0,0:07:56.96,0:07:59.96,Main,Chinjao,0,0,0,,Yanlış anlamayasın, Garp'ın torunu.Dialogue: 0,0:07:59.96,0:08:04.33,Main,Chinjao,0,0,0,,Ailene karşı kin beslemiyorum artık.Dialogue: 0,0:08:05.06,0:08:05.93,Main,Luffy,0,0,0,,Sahiden mi?Dialogue: 0,0:08:05.93,0:08:11.47,Main,Sai,0,0,0,,Bu ülkeye özünde Doflamingo'nun işine bir son vermeye gelmiştik zaten.Dialogue: 0,0:08:11.47,0:08:13.87,Main,Sai,0,0,0,,Ödül falan umrumuzda değil!Dialogue: 0,0:08:13.87,0:08:17.94,Main,Sai,0,0,0,,O kadarcık paraya çalışmayız biz!Dialogue: 0,0:08:17.94,0:08:21.68,Main,Chinjao,0,0,0,,Bu nedenle de hem sana hem de Tanrı Usopp'a olan borcumu...Dialogue: 0,0:08:21.68,0:08:24.78,Main,Chinjao,0,0,0,,...Doflamingo'yu yenerek ödemeye karar verdim.Dialogue: 0,0:08:25.52,0:08:28.99,Main,Luffy,0,0,0,,Olmaz ya! Doflamingo'nun canına ben okuyacağım!Dialogue: 0,0:08:32.32,0:08:34.16,Main,Chinjao,0,0,0,,Ne dedin sen?!Dialogue: 0,0:08:34.16,0:08:37.36,Main,Chinjao,0,0,0,,İyiliğimin karşılığını böyle mi vereceksin?!Dialogue: 0,0:08:39.56,0:08:42.80,Captions,Caption,0,0,240,,Elbaf Savaşçısı HajrudinDialogue: 0,0:08:39.76,0:08:42.80,Main,Hairudin,0,0,2,,Buradasın demek, Hasır Şapkalı Luffy!Dialogue: 0,0:08:42.80,0:08:45.47,Main,Hairudin,0,0,0,,Arenada olanları unutalım!Dialogue: 0,0:08:45.47,0:08:51.21,Main,Hairudin,0,0,0,,Elbaf'ın gururlu bir savaşçısı olarak size olan borcumu Doflamingo'yu öldürerek ödeyeceğim!Dialogue: 0,0:08:51.21,0:08:56.41,Main,Elizabello,0,0,2,,Prodence Krallığı olarak Kral Riku'ya olan borcumuz büyüktür.Dialogue: 0,0:08:52.34,0:08:59.62,Captions,Caption,180,0,240,,Prodence Kralı 2. ElizabelloDialogue: 0,0:08:56.41,0:08:59.88,Main,Elizabello,0,0,2,,Doflamingo'nun sonu benim elimden olacak!Dialogue: 0,0:09:00.29,0:09:05.26,Captions,Caption,0,550,175,,Taktikçi, DagamaDialogue: 0,0:09:00.39,0:09:05.26,Main,Dagama,0,0,2,,Na-Nasıl diyorsa öyledir! Ödülde falan gözümüz yok!Dialogue: 0,0:09:05.62,0:09:09.23,Main,Jeet,0,0,0,,Durun bakalım, o adinin ölümü bizim elimizden olacak!Dialogue: 0,0:09:09.53,0:09:16.20,Captions,Caption,0,0,175,,Jeet ve AbdullahDialogue: 0,0:09:09.43,0:09:10.67,Main,Jeet,0,0,2,,Unutulması imkansız bir an!Dialogue: 0,0:09:10.67,0:09:13.93,Main,Jeet,0,0,2,,Cennetin ışıkları Tanrı'nın suretine yansıdı!Dialogue: 0,0:09:13.93,0:09:16.20,Main,Abdul,0,0,2,,Günah çıkartmak istiyorum!Dialogue: 0,0:09:16.20,0:09:21.31,Main,Orlumbus,0,0,2,,Durun bakalım! Doflamingo'yu yenecek biri varsa o da benim!Dialogue: 0,0:09:16.27,0:09:20.97,Captions,Caption,0,0,240,,Filo Komodoru OrlumbusDialogue: 0,0:09:21.31,0:09:23.81,Captions,Caption,0,0,175,,Yıkım Topu IdeoDialogue: 0,0:09:21.31,0:09:23.81,Main,Ideo,0,0,2,,Borcumu yıkımla öderim!Dialogue: 0,0:09:25.14,0:09:27.81,Captions,Caption,0,0,240,,Cellat SuleimanDialogue: 0,0:09:25.41,0:09:27.81,Main,Suleiman,0,0,2,,İdam etmek benim işim!Dialogue: 0,0:09:28.21,0:09:31.75,Captions,Caption,0,0,175,,Uzun Bacak Blue GillyDialogue: 0,0:09:28.01,0:09:31.75,Main,Blue Gilly,0,0,2,,Doflamingo'yu yenecek kişi benim!Dialogue: 0,0:09:32.55,0:09:35.05,Main,Zoro,0,0,0,,Nereden çıkıp duruyor bunlar?Dialogue: 0,0:09:35.05,0:09:37.16,Main,Cavendish,0,0,0,,Beni unutmayın!Dialogue: 0,0:09:39.92,0:09:42.16,Main,Zoro,0,0,0,,Can sıkıcı olan da geliyor işte.Dialogue: 0,0:09:50.30,0:09:52.20,Main,Zoro,0,0,0,,Savaşmayı bu kadar çok istiyorsunuz demek?Dialogue: 0,0:09:52.90,0:09:58.24,Main,Zoro,0,0,0,,Doflamingo'yu biz yenelim, siz de bize destek olun!Dialogue: 0,0:09:58.24,0:10:02.61,Main,Everyone,0,0,0,,Hadi be oradan! Doflamingo'yu ben yeneceğim!Dialogue: 0,0:10:03.15,0:10:06.28,Main,Everyone,0,0,0,,Benim işim o!Dialogue: 0,0:10:06.28,0:10:07.69,Main,Zoro,0,0,0,,Olacak gibi değil...Dialogue: 0,0:10:07.69,0:10:10.05,Main,Zoro,0,0,0,,Hepsinin de ego tavan yapmış.Dialogue: 0,0:10:10.05,0:10:11.99,Main,Luffy,0,0,0,,Siz var ya...Dialogue: 0,0:10:13.76,0:10:16.69,Main,Luffy,0,0,0,,Hepiniz de yettiniz be!Dialogue: 0,0:10:16.69,0:10:20.33,Main,Luffy,0,0,0,,Doflamingo'nun canına ben okuyacağım dedim size!Dialogue: 0,0:10:20.33,0:10:22.07,Main,Sai,0,0,0,,Ne dedin?!Dialogue: 0,0:10:22.07,0:10:25.07,Main,Sai,0,0,0,,Borcumuzu ödeyeceğiz dedik, kafan almıyor mu!?Dialogue: 0,0:10:25.07,0:10:29.51,Main,Sai,0,0,0,,Kapa çeneni yoksa gebertirim seni, beyinsiz kurtarıcı!Dialogue: 0,0:10:29.51,0:10:30.48,Main,Boo,0,0,0,,Aynen öyle!Dialogue: 0,0:10:30.68,0:10:32.01,Main,Chinjao,0,0,0,,Görevim!Dialogue: 0,0:10:32.01,0:10:33.28,Main,Cavendish,0,0,0,,Şanım!Dialogue: 0,0:10:33.28,0:10:34.48,Main,Hairudin,0,0,0,,Gururum!Dialogue: 0,0:10:34.48,0:10:35.78,Main,Elizabello,0,0,0,,Kral Riku!Dialogue: 0,0:10:35.78,0:10:37.78,Main,Abdullah & Jeet,0,0,0,,Tanrımız!Dialogue: 0,0:10:42.62,0:10:43.96,Main,Luffy,0,0,0,,Mızrak mı bu?!Dialogue: 0,0:10:44.62,0:10:46.56,Main,Pirates,0,0,0,,Bulduk sizi!Dialogue: 0,0:10:46.56,0:10:49.16,Main,Pirates,0,0,0,,Biz de yardım edelim size!Dialogue: 0,0:10:50.13,0:10:53.87,Main,Pirates,0,0,0,,Bir tane 200 milyon, iki tane de 300 milyonluk!Dialogue: 0,0:10:54.53,0:11:00.14,Main,Blue Gilly,0,0,0,,Bunlar bizimle beraber yeraltına hapsedilmiş eski oyuncaklar değil mi?Dialogue: 0,0:11:00.14,0:11:02.61,Main,Abdul,0,0,0,,Utanmaz şerefsizler!Dialogue: 0,0:11:02.61,0:11:04.54,Main,Pirates,0,0,0,,Yakalayın!Dialogue: 0,0:11:06.11,0:11:09.21,Main,Hairudin,0,0,0,,Geberin sizi nankör adiler!Dialogue: 0,0:11:11.35,0:11:12.45,Main,Zoro,0,0,0,,Gidelim!Dialogue: 0,0:11:12.45,0:11:13.52,Main,Luffy,0,0,0,,Olur.Dialogue: 0,0:11:16.52,0:11:18.39,Main,Luffy,0,0,0,,Moocy!Dialogue: 0,0:11:19.66,0:11:20.56,Main,Zoro,0,0,0,,Boğa mı?Dialogue: 0,0:11:21.33,0:11:22.79,Main,Luffy,0,0,0,,Aklıma bir fikir geldi!Dialogue: 0,0:11:30.77,0:11:33.20,Main,Grunt,0,0,0,,Dumanın ardında bir gölge görüyorum!Dialogue: 0,0:11:34.34,0:11:36.51,Main,Grunt,0,0,0,,Boğa mı bu?!Dialogue: 0,0:11:39.18,0:11:41.11,Main,Luffy,0,0,0,,Haydi!Dialogue: 0,0:11:41.11,0:11:42.31,Main,Grunt,0,0,0,,Geldiler!Dialogue: 0,0:11:42.31,0:11:44.17,Main,Grunt,0,0,0,,Pica-sama, bulduk onları!Dialogue: 0,0:11:44.17,0:11:45.92,Main,Grunt,0,0,0,,Hasır Şapkalar bunlar!Dialogue: 0,0:11:45.92,0:11:48.62,Main,Grunt,0,0,0,,Geri döndüler!Dialogue: 0,0:11:48.62,0:11:50.39,Main,Grunt,0,0,0,,Kaçırmayın elinizden!Dialogue: 0,0:11:50.39,0:11:53.62,Main,Grunt,0,0,0,,Az evvelki üçlü boğanın üzerinde!Dialogue: 0,0:11:55.06,0:12:01.07,Main,Grunt,0,0,0,,Ayrıca dört, beş, altı... yedi!Dialogue: 0,0:12:01.87,0:12:03.74,Main,Grunt,0,0,0,,Dur orada Hasır Şapka!Dialogue: 0,0:12:03.74,0:12:06.04,Main,Luffy,0,0,0,,Peşimden gelmeyin diye kime diyorum?!Dialogue: 0,0:12:06.60,0:12:11.84,Main,Grunt,0,0,0,,Sayıları... Giderek artıyor!Dialogue: 0,0:12:15.26,0:12:17.81,Main,Blue Gilly,0,0,0,,Doflamingo'yu ben alt edeceğim!Dialogue: 0,0:12:17.81,0:12:18.60,Main,Cavendish,0,0,0,,Sus be!Dialogue: 0,0:12:18.60,0:12:21.12,Main,Cavendish,0,0,0,,Doflamingo'yla aramıza girecek olursan seni de öldürürüm!Dialogue: 0,0:12:21.27,0:12:23.19,Main,Don't know Who,0,0,0,,Onu öldürecek olanlar biziz!Dialogue: 0,0:12:23.19,0:12:24.68,Main,Don't know Who,0,0,0,,Hadi be oradan! Benim o!Dialogue: 0,0:12:24.75,0:12:27.19,Main,Grunt,0,0,0,,Sayıları birden nasıl böyle arttı?!Dialogue: 0,0:12:27.19,0:12:28.18,Main,Grunt,0,0,0,,Ne bileyim ben?!Dialogue: 0,0:12:28.30,0:12:31.46,Main,Grunt,0,0,0,,Kolezyum'da savaşan yarışmacılar bunlar!Dialogue: 0,0:12:32.29,0:12:38.90,Main,Pica,0,0,0,,Üçmüş, üç yüzmüş fark etmez bana!Dialogue: 0,0:12:38.90,0:12:39.42,Main,Blue Gilly,0,0,0,,Geliyor!Dialogue: 0,0:12:39.74,0:12:41.36,Main,Chinjao,0,0,0,,Hasshouken Gizli Tekniği!Dialogue: 0,0:12:41.36,0:12:43.20,Main,,0,0,0,,Delgi Ejder...Dialogue: 0,0:12:45.47,0:12:47.76,Main,Elizabello,0,0,0,,Henüz tamamen şarj olmadım ama...Dialogue: 0,0:12:48.25,0:12:49.05,Main,Elizabello,0,0,0,,Hafif...Dialogue: 0,0:12:51.46,0:12:57.64,Main,Elizabello,0,0,0,,...Kral Yumruğu!Dialogue: 0,0:12:57.64,0:12:59.93,Main,Chinjao,0,0,0,,...Pençesi!Dialogue: 0,0:13:13.21,0:13:15.56,Main,Grunt,0,0,0,,Pica-sama'nın kolu...Dialogue: 0,0:13:15.53,0:13:20.40,Main,Sai,0,0,0,,Doflamingo'yu da aynen böyle geberteceğiz!Dialogue: 0,0:13:21.45,0:13:23.79,Main,Luffy,0,0,0,,Takibi bırakın dedim!Dialogue: 0,0:13:24.28,0:13:27.28,Main,Everyone,0,0,0,,Kapa çeneni aptal kurtarıcı!Dialogue: 0,0:13:27.28,0:13:29.67,Main,Luffy,0,0,0,,Ne dediniz siz?!Dialogue: 0,0:13:35.91,0:13:37.05,Main,Elizabello,0,0,0,,Koca pislik!Dialogue: 0,0:13:37.05,0:13:39.72,Main,Chinjao,0,0,0,,Kafamın kıramayacağı hiçbir şey yoktur!Dialogue: 0,0:13:42.35,0:13:43.57,Main,Luffy,0,0,0,,Az daha eziliyorduk!Dialogue: 0,0:13:43.57,0:13:46.12,Main,Luffy,0,0,0,,Haydi Moocy, saraya!Dialogue: 0,0:13:46.12,0:13:48.91,Main,Abdullah,0,0,0,,Düşen taşlara dikkat et! Sana güveniyoruz, Moocy!Dialogue: 0,0:13:48.91,0:13:51.79,Main,Luffy,0,0,0,,Peşimden gelmeyin dedim size!Dialogue: 0,0:13:51.79,0:13:53.01,Main,Luffy,0,0,0,,İnin Moocy'nin üstünden!Dialogue: 0,0:13:53.01,0:13:56.01,Main,Abdullah,0,0,0,,Öyle deme ama şimdi lütfen!Dialogue: 0,0:13:56.01,0:13:58.92,Main,Jeet,0,0,0,,Hasır Şapka-san, lütfen!Dialogue: 0,0:13:58.92,0:14:00.92,Main,Jeet,0,0,0,,Moocy, sana güveniyoruz!Dialogue: 0,0:14:06.05,0:14:07.88,Main,Grunt,0,0,0,,Geçmelerine izin vermeyin!Dialogue: 0,0:14:07.88,0:14:09.62,Main,Grunt,0,0,0,,Saraya gidiyorlar!Dialogue: 0,0:14:12.46,0:14:13.92,Main,Ideo,0,0,0,,Sizinle ben ilgileneceğim!Dialogue: 0,0:14:13.92,0:14:15.42,Main,Grunt,0,0,0,,Şampiyon savaşçı Ideo da onlarla!Dialogue: 0,0:14:17.59,0:14:19.42,Main,Grunt,0,0,0,,Hasır Şapka'nın kaçmasına müsaade etmeyin!Dialogue: 0,0:14:19.42,0:14:21.10,Main,Ideo,0,0,0,,Dikkatli olsanız iyi edersiniz!Dialogue: 0,0:14:21.35,0:14:22.38,Main,Ideo,0,0,0,,Yıkıcı Top!Dialogue: 0,0:14:24.68,0:14:28.10,Main,Ideo,0,0,0,,Beni durdurmak istiyorsanız daha güçlüleriniz geçsin karşıma!Dialogue: 0,0:14:28.35,0:14:30.41,Main,Grunt,0,0,0,,Ne biçim insan bunlar böyle?!Dialogue: 0,0:14:31.56,0:14:33.88,Main,Grunt,0,0,0,,Komodor Orlumbus!Dialogue: 0,0:14:33.88,0:14:36.28,Main,Orlumbus,0,0,0,,Yolumda duruyorsunuz!Dialogue: 0,0:14:36.28,0:14:37.84,Main,Orlumbus,0,0,0,,Komodor...Dialogue: 0,0:14:37.84,0:14:39.17,Main,Orlumbus,0,0,0,,...Sarılışı!Dialogue: 0,0:14:40.43,0:14:41.78,Main,Grunt,0,0,0,,Tam sırası! Ateş!Dialogue: 0,0:14:43.04,0:14:44.23,Main,Cavendish,0,0,0,,Güzellik Kılıcı!Dialogue: 0,0:14:44.23,0:14:45.54,Main,Cavendish,0,0,0,,Kuğu Gölü!Dialogue: 0,0:14:59.78,0:15:01.32,Main,Sai,0,0,0,,Yukarı bakın!Dialogue: 0,0:15:02.63,0:15:05.20,Main,Sai,0,0,0,,Bir yumruk daha geliyor!Dialogue: 0,0:15:07.18,0:15:08.28,Main,Chinjao,0,0,0,,Can sıkıcı şey!Dialogue: 0,0:15:08.28,0:15:09.16,Main,Elizabello,0,0,0,,Gerekirse-Dialogue: 0,0:15:09.16,0:15:10.89,Main,Zoro,0,0,0,,Boşuna uğraşmayın!Dialogue: 0,0:15:10.89,0:15:13.60,Main,Zoro,0,0,0,,Kolunu kırsanız bile yeniden onarabiliyor.Dialogue: 0,0:15:13.60,0:15:17.48,Main,Zoro,0,0,0,,Gücünün nasıl çalıştığını öğrenemediğiniz müddetçe boşa kürek çekmiş olacaksınız!Dialogue: 0,0:15:17.48,0:15:18.90,Main,Elizabello,0,0,0,,Ne yapmalı peki?Dialogue: 0,0:15:21.36,0:15:22.86,Main,Dagama,0,0,0,,Öyleyse...Dialogue: 0,0:15:22.86,0:15:24.48,Main,Dagama,0,0,0,,Kaçın!Dialogue: 0,0:15:24.82,0:15:27.92,Main,Boo,0,0,0,,Ne biçim taktikçisin sen be? Daha iyi plan bulamadın mı?Dialogue: 0,0:15:27.92,0:15:30.00,Main,Dagama,0,0,0,,Kesin sesinizi! Çok makul bir strateji bu!Dialogue: 0,0:15:30.00,0:15:31.62,Main,Dagama,0,0,0,,Kaçın hadi!Dialogue: 0,0:15:37.75,0:15:40.94,Main,Hairudin,0,0,0,,Onunla doğrudan yüzleşmek işe yaramayacak! Farklı bir yol falan mı arasak?!Dialogue: 0,0:15:41.44,0:15:43.42,Main,Cavendish,0,0,0,,Gerçekten de büyük engel oluşturuyor!Dialogue: 0,0:15:43.42,0:15:45.77,Main,Chinjao,0,0,0,,Onu durdurmadan saraya varamayız!Dialogue: 0,0:15:46.90,0:15:48.76,Main,Cavendish,0,0,0,,Hasır Şapka nereye gitti?!Dialogue: 0,0:15:48.76,0:15:50.37,Main,Chinjao,0,0,0,,Hiçbir yerde göremiyorum!Dialogue: 0,0:15:50.37,0:15:51.80,Main,Boo,0,0,0,,Boğayla birlikte ezildi mi acaba?!Dialogue: 0,0:15:54.03,0:15:55.30,Main,Hairudin,0,0,0,,Orada işte!Dialogue: 0,0:16:02.75,0:16:05.56,Main,Luffy,0,0,0,,Kestirmeden gidiyoruz! Harika!Dialogue: 0,0:16:06.85,0:16:08.70,Main,Luffy's unwanted army,0,0,0,,Koluna tırmanıyor!Dialogue: 0,0:16:08.81,0:16:12.32,Main,Luffy,0,0,0,,Yardır Moocy!Dialogue: 0,0:16:18.36,0:16:19.23,Main,Dagama,0,0,0,,Yok artık!Dialogue: 0,0:16:19.23,0:16:20.88,Main,Sai,0,0,0,,Deli mi bu?!Dialogue: 0,0:16:20.88,0:16:22.28,Main,Cavendish,0,0,0,,Benden daha çok dikkat çekiyor!Dialogue: 0,0:16:23.87,0:16:25.52,Main,Grunt,0,0,0,,İnanamıyorum!Dialogue: 0,0:16:27.54,0:16:31.06,Main,Luffy,0,0,0,,Saraya kadar varalım böyle!Dialogue: 0,0:16:31.66,0:16:35.05,Main,Abdullah & Jeet,0,0,0,,Aynen böyle! Haydi boğa!Dialogue: 0,0:16:39.29,0:16:39.93,Main,Luffy,0,0,0,,Siz...Dialogue: 0,0:16:40.71,0:16:41.41,Main,Jeet,0,0,0,,Evet?Dialogue: 0,0:16:41.41,0:16:43.76,Main,Luffy,0,0,0,,O da ne demek lan öyle?!Dialogue: 0,0:16:43.76,0:16:44.28,Main,Jeet,0,0,0,,Buyur?Dialogue: 0,0:16:44.28,0:16:46.47,Main,Luffy,0,0,0,,İnin! Moocy'nin yükü artıyor böyle!Dialogue: 0,0:16:46.47,0:16:47.22,Main,Jeet,0,0,0,,Evet...Dialogue: 0,0:16:47.22,0:16:50.16,Main,Jeet,0,0,0,,Geç tanışıklık için kusura bakma.  Bendeniz Jeet...Dialogue: 0,0:16:50.16,0:16:53.01,Main,Jeet,0,0,0,,...ve arkamdaki bu koca adam da...Dialogue: 0,0:16:53.01,0:16:54.32,Main,Abdullah,0,0,0,,Abdullah.Dialogue: 0,0:16:54.48,0:16:55.98,Main,Luffy,0,0,0,,Adınızı sorduk mu?!Dialogue: 0,0:16:58.00,0:16:59.29,Main,Pica,0,0,0,,Hasır Şapka!Dialogue: 0,0:16:59.29,0:17:00.93,Main,Jeet,0,0,0,,Pis kızdı!Dialogue: 0,0:17:00.93,0:17:03.16,Main,Pica,0,0,0,,Doffy'e yaklaşmana izin vermeyeceğim!Dialogue: 0,0:17:08.59,0:17:10.94,Main,Abdullah,0,0,0,,Kolu!Dialogue: 0,0:17:12.90,0:17:14.12,Main,Abdullah,0,0,0,,Hasır Şapka-san!Dialogue: 0,0:17:16.66,0:17:18.67,Main,Luffy,0,0,0,,Gomu Gomu no...Dialogue: 0,0:17:19.55,0:17:23.22,Main,Luffy,0,0,0,,...Boz Magnum!Dialogue: 0,0:17:25.47,0:17:27.47,Main,Luffy's unwanted army,0,0,0,,Yok artık!Dialogue: 0,0:17:27.47,0:17:28.88,Main,Ideo,0,0,0,,Paramparça oldu!Dialogue: 0,0:17:28.94,0:17:30.40,Main,Grunts,0,0,0,,Pica-sama!Dialogue: 0,0:17:35.43,0:17:37.76,Main,Abdullah & Jeet,0,0,0,,İşte bu kadar!Dialogue: 0,0:17:39.37,0:17:41.34,Main,Abdullah,0,0,0,,Bravo Hasır Şapka-san!Dialogue: 0,0:17:41.34,0:17:42.56,Main,Jeet,0,0,0,,Ellerine sağlık!Dialogue: 0,0:17:42.56,0:17:45.24,Main,Luffy,0,0,0,,Tamamdır! Şimdi doğrudan saraya!Dialogue: 0,0:17:45.24,0:17:50.08,Main,Zoro,0,0,0,,Luffy! Az önce parçaladığın kafa kaya parçasıydı sadece!Dialogue: 0,0:17:50.16,0:17:51.05,Main,Luffy; Abdullah & Jeet,0,0,0,,Ne?!Dialogue: 0,0:17:51.05,0:17:54.06,Main,Zoro,0,0,0,,Üzerinde koştuğumuz şey içi boş taştan bir kabuk.Dialogue: 0,0:17:54.06,0:17:55.80,Main,Luffy,0,0,0,,Gene mi kaybettik onu?!Dialogue: 0,0:17:56.56,0:17:58.08,Main,Zoro,0,0,0,,Bir şey var orada!Dialogue: 0,0:18:12.85,0:18:15.14,Main,Luffy,0,0,0,,Ne?! Taş adam bu mu?Dialogue: 0,0:18:15.35,0:18:18.46,Main,Zoro,0,0,0,,İnsan halini ilk defa görüyorum!Dialogue: 0,0:18:26.57,0:18:28.44,Main,Jeet,0,0,0,,Hayvan gibi katanası var!Dialogue: 0,0:18:30.73,0:18:32.51,Main,Jeet,0,0,0,,Geri dön!Dialogue: 0,0:18:35.44,0:18:37.19,Main,Jeet,0,0,0,,Dönemiyorsan dur!Dialogue: 0,0:18:41.15,0:18:42.82,Main,Abdullah & Jeet,0,0,0,,Çok geç!Dialogue: 0,0:18:49.95,0:18:52.42,Main,Abdullah & Jeet,0,0,0,,Boğa uçuyor!Dialogue: 0,0:18:55.71,0:18:57.50,Main,Luffy,0,0,0,,Sesi harbiden komik ya!Dialogue: 0,0:18:58.43,0:18:59.46,Main,Pica,0,0,0,,Hasır Şapka!Dialogue: 0,0:18:59.46,0:19:00.59,Main,Abdullah & Jeet,0,0,0,,Gene geliyor!Dialogue: 0,0:19:01.96,0:19:02.91,Main,Luffy,0,0,0,,Ben kaçtım!Dialogue: 0,0:19:02.91,0:19:03.47,Main,Jeet,0,0,0,,Ne?!Dialogue: 0,0:19:06.72,0:19:08.06,Main,Zoro,0,0,0,,Tamamdır, bana bırak!Dialogue: 0,0:19:09.08,0:19:10.56,Main,Abdullah & Jeet,0,0,0,,Harika be!Dialogue: 0,0:19:14.05,0:19:14.94,Main,Pica,0,0,0,,Çekil yolumdan!Dialogue: 0,0:19:17.65,0:19:19.69,Main,Abdullah,0,0,0,,Ancak Tanrı'mızın dostları yapabilirdi bunu zaten!Dialogue: 0,0:19:19.69,0:19:21.57,Main,Luffy,0,0,0,,Zoro, sana güveniyorum!Dialogue: 0,0:19:21.57,0:19:24.50,Main,Luffy,0,0,0,,Ben Doflamingo'nun canına okuyacağım!Dialogue: 0,0:19:25.24,0:19:27.40,Main,Zoro,0,0,0,,Anlaşılmıştır, Kaptan!Dialogue: 0,0:19:30.45,0:19:32.70,Main,Pica,0,0,0,,Benim işim Hasır Şapka'yla! Çekil yolumdan!Dialogue: 0,0:19:33.16,0:19:38.42,Main,Zoro,0,0,0,,Kaptanımızın senin gibi değersiz bir taş parçasıyla işi olmaz!Dialogue: 0,0:19:39.04,0:19:43.64,Main,Zoro,0,0,0,,Benimle idare edeceksin artık soprano sesli adi seni!Dialogue: 0,0:19:50.78,0:19:53.60,Main,Dagama,0,0,0,,Canavar hareket etmeyi kesti kesmesine de öldü mü acaba?Dialogue: 0,0:19:53.60,0:19:56.54,Main,Cavendish,0,0,0,,Hayır, öldüğünü sanmıyorum.Dialogue: 0,0:19:56.60,0:20:02.40,Main,Cavendish,0,0,0,,Her halükârda can sıkıcı yumrukları kesildiyse fırsat bu fırsat demektir!Dialogue: 0,0:20:02.40,0:20:04.92,Main,Cavendish,0,0,0,,Doflamingo'yu ben alaşağı edeceğim!Dialogue: 0,0:20:04.92,0:20:07.36,Main,The Broken Records,0,0,0,,- Ben! - Hayır ben!Dialogue: 0,0:20:15.98,0:20:18.98,Main,Luffy,0,0,0,,Aynen böyle, devam et Moocy!Dialogue: 0,0:20:19.27,0:20:20.96,Main,Abdullah,0,0,0,,Evet! Dayan boğa!Dialogue: 0,0:20:20.96,0:20:21.73,Main,Jeet,0,0,0,,Boğa!Dialogue: 0,0:20:22.23,0:20:25.82,Main,Luffy,0,0,0,,Daha ne kadar burada kalacaksınız?! İnin hadi!Dialogue: 0,0:20:25.82,0:20:28.46,Main,Abdullah & Jeet,0,0,0,,Yapma şimdi, Hasır Şapka-san!Dialogue: 0,0:20:31.35,0:20:33.20,Main,Law,0,0,0,,Hasır Şapka-ya.Dialogue: 0,0:20:35.05,0:20:38.53,Main,Law,0,0,0,,Artık hayatta kalmamızın tek yolunun onu öldürmek olduğunu biliyorum.Dialogue: 0,0:20:39.57,0:20:42.02,Main,Law,0,0,0,,Ben de kararımı verdim.Dialogue: 0,0:20:43.39,0:20:48.95,Main,Law,0,0,0,,Size önerdiğim plan Doflamingo'yu dolaylı olarak ortadan kaldırmak içindi.Dialogue: 0,0:20:49.64,0:20:55.05,Main,Law,0,0,0,,Ama işin aslı ben de ona kendi ellerimle acı çektirmek istiyorum!Dialogue: 0,0:20:55.05,0:20:57.88,Main,Law,0,0,0,,Bir kez yenildim zaten ama bu sefer buna izin vermeyeceğim!Dialogue: 0,0:21:05.20,0:21:09.34,Main,Law,0,0,0,,13 yıl önce çok sevdiğim biri...Dialogue: 0,0:21:10.50,0:21:13.01,Main,Law,0,0,0,,...Doflamingo tarafından öldürüldü!Dialogue: 0,0:21:18.51,0:21:20.41,Main,Law,0,0,0,,Öldürdüğü kişinin adı Corazon idi.Dialogue: 0,0:21:22.71,0:21:25.56,Main,Law,0,0,0,,Don Quixote Ailesinin eski üst düzey yöneticisi!Dialogue: 0,0:21:25.56,0:21:28.43,Main,Luffy,0,0,0,,Ne?! Onların dostu muydu yani?Dialogue: 0,0:21:28.95,0:21:32.93,Main,Law,0,0,0,,Öyleydi. Benim hayatımı kurtaran kişiydi ayrıca.Dialogue: 0,0:21:34.36,0:21:36.44,Main,Law,0,0,0,,Ve Doflamingo'nun da...Dialogue: 0,0:21:40.47,0:21:42.84,Main,Law,0,0,0,,...öz kardeşiydi!