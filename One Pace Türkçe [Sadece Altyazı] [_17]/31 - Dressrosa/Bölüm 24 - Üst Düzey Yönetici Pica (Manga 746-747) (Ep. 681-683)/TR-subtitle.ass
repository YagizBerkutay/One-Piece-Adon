Dialogue: 0,0:05:49.69,0:05:52.32,Main,Soldier,0,0,0,,Komutan Kyros mu?!
Dialogue: 0,0:05:52.32,0:05:55.67,Main,Soldier,0,0,0,,O ölümsüz gladyatörü\Ntamamen unutmuşum!
Dialogue: 0,0:05:55.67,0:05:57.44,Main,Pirate,0,0,0,,Korsanlar da var hem!
Dialogue: 0,0:05:57.44,0:05:58.67,Main,Pirate,0,0,0,,Hasır Şapka tayfası!
Dialogue: 0,0:05:58.67,0:06:03.21,Main,Dude,0,0,0,,Aile'nin yöneticilerinden Violet'in\NPrenses Viola olduğunu bilmiyordum!
Dialogue: 0,0:06:04.91,0:06:07.88,Main,Doflamingo,0,0,0,,{\i1}Ve her gurubun anahtar isimlerine de...{\i0}
Dialogue: 0,0:06:07.88,0:06:09.98,Main,Doflamingo,0,0,0,,{\i1}...üçer yıldız veriyorum!{\i0}
Dialogue: 0,0:06:09.98,0:06:12.62,Main,Pirates,0,0,0,,{\i1}300 milyon!{\i0}
Dialogue: 0,0:06:12.62,0:06:14.22,Main,Pirates,0,0,0,,Law'la Hasır Şapka...
Dialogue: 0,0:06:14.22,0:06:17.66,Main,Pirates,0,0,0,,İttifak haberleri\Ndaha yeni yeni dünyayı sarsmıştı!
Dialogue: 0,0:06:17.66,0:06:19.32,Main,Soldier,0,0,0,,Kral Riku!
Dialogue: 0,0:06:19.32,0:06:22.59,Main,Soldier,0,0,0,,Kral Riku-sama yaşıyormuş!
Dialogue: 0,0:06:22.59,0:06:25.00,Main,Pirate,0,0,0,,Devrim Ordusu'ndan sağlam biri de var!
Dialogue: 0,0:06:25.00,0:06:26.56,Main,Pirate,0,0,0,,Genel Kurmay Başkanı diyor!
Dialogue: 0,0:06:26.56,0:06:28.13,Main,Hack,0,0,0,,Çabuk bulmuşlar bizi!
Dialogue: 0,0:06:28.13,0:06:29.53,Main,Sabo,0,0,0,,Ben de mi varım?!
Dialogue: 0,0:06:29.53,0:06:33.77,Thoughts,Usopp,0,0,0,,{\i1}Şü-Şükürler olsun.\NBeni fark etmemişler.{\i0}
Dialogue: 0,0:06:34.71,0:06:40.88,Main,Doflamingo,0,0,0,,Ayrıca bugün canımı çok\Nsıkmış olan bir adam da var!
Dialogue: 0,0:06:40.88,0:06:46.99,Main,Doflamingo,0,0,0,,Bu denli kanlı bir\Noyun oynayacak olmanızın tek suçlusu!
Dialogue: 0,0:06:46.99,0:06:50.49,Main,Doflamingo,0,0,0,,Onu öldüren kişi...
Dialogue: 0,0:06:51.69,0:06:54.69,Main,Doflamingo,0,0,0,,...500 milyon beli alacak!
Dialogue: 0,0:06:56.15,0:06:59.08,Captions,,0,0,0,,{\pos(741.92,432.5)}Korsan\NHasır Şapka Tayfasından\N"Tanrı" Usopp
Dialogue: 0,0:07:01.43,0:07:03.23,Main,Pirates,0,0,0,,{\i1}500 milyon!{\i0}
Dialogue: 0,0:07:03.23,0:07:05.80,Main,Pirates,0,0,0,,Hayatımın sonuna kadar çalışmasam olur be!
Dialogue: 0,0:07:05.80,0:07:07.84,Main,Usopp,0,0,0,,Beş!
Dialogue: 0,0:07:08.91,0:07:12.08,Main,Leo,0,0,0,,Eyvah!\NUsoland...
Dialogue: 0,0:07:17.38,0:07:18.82,Main,Pirates,0,0,0,,Beş yıldız!
Dialogue: 0,0:07:18.82,0:07:22.22,Main,Pirates,0,0,0,,İki tek yıldızla\Nbir de üç yıldız da burada!
Dialogue: 0,0:07:22.22,0:07:23.99,Main,Koala,0,0,0,,Sabo-kun, ne yapacağız?
Dialogue: 0,0:07:25.22,0:07:26.83,Main,Sabo,0,0,0,,Yüzeye çıkalım!
Dialogue: 0,0:07:26.83,0:07:28.39,Main,Sabo,0,0,0,,Hep birlikte, acele!
Dialogue: 0,0:07:28.39,0:07:32.26,Main,Pirates,0,0,0,,Tanrı Usopp!\NÜzgünüm ama öleceksin!
Dialogue: 0,0:07:32.26,0:07:35.13,Main,Pirates,0,0,0,,Beş yıldız!\N500 milyon!
Dialogue: 0,0:07:35.13,0:07:39.87,Main,Usopp,0,0,0,,Daha az evvel tapıyorlardı bana be!
Dialogue: 0,0:07:39.87,0:07:42.87,Main,Usopp,0,0,0,,Lanet olsun, kaçalım lütfen!
Dialogue: 0,0:07:42.87,0:07:44.11,Main,Leo,0,0,0,,Anlaşılmıştır!
Dialogue: 0,0:07:46.98,0:07:48.98,Main,Pirates,0,0,0,,Biri burada!
Dialogue: 0,0:07:48.98,0:07:52.88,Main,Pirates,0,0,0,,Tek yıldızlı samuray,\N100 milyon beli!
Dialogue: 0,0:07:52.88,0:07:54.69,Main,Kin'emon,0,0,0,,Çok can sıkıcı oldu bu!
Dialogue: 0,0:07:57.02,0:08:01.07,Main,Kin'emon,0,0,0,,Küçük insan\Nburada hurdalık olduğunu söylemişti!
Dialogue: 0,0:08:01.07,0:08:04.36,Main,Kin'emon,0,0,0,,Orada mısın Kanjuro?!
Dialogue: 0,0:08:04.36,0:08:07.33,Main,Pirate,0,0,0,,100 milyon beli benim olacak!
Dialogue: 0,0:08:05.06,0:08:07.33,Secondary,Kin'emon,0,0,0,,Gidelim bakalım!
Dialogue: 0,0:08:07.33,0:08:08.27,Main,Pirate,0,0,0,,Düştü!
Dialogue: 0,0:08:08.27,0:08:10.64,Main,Pirate,0,0,0,,Samuray deliğe düştü be!
Dialogue: 0,0:08:15.81,0:08:18.81,Main,Doflamingo,0,0,0,,{\i1}Fazla düşünecek vaktiniz yok.{\i0}
Dialogue: 0,0:08:18.81,0:08:23.48,Main,Doflamingo,0,0,0,,{\i1}Anbean insanlar ölüyor,\Nşehirler yakılıyor!{\i0}
Dialogue: 0,0:08:23.48,0:08:24.88,Main,Citizen,0,0,0,,Ne yapmalı?
Dialogue: 0,0:08:24.88,0:08:28.79,Main,Citizen,0,0,0,,Kral Riku-sama'nın\Nsuçsuz olduğunu öğrendik!
Dialogue: 0,0:08:31.86,0:08:36.90,Main,Citizen,0,0,0,,Hepimiz bir olursak\Nbelki Doflamingo'yu alt edebiliriz...
Dialogue: 0,0:08:38.26,0:08:39.86,Main,Citizen,0,0,0,,Mesele sadece o değil ki!
Dialogue: 0,0:08:40.90,0:08:47.14,Main,Citizen,0,0,0,,Doflamingo'yu öldürebilmek için Don Quixote Ailesi'nin 2000 askeriyle savaşmamız gerekir!
Dialogue: 0,0:08:47.14,0:08:49.11,Main,Citizen,0,0,0,,Ne yapacağız o zaman peki?!
Dialogue: 0,0:08:49.11,0:08:52.68,Main,Citizen,0,0,0,,12 kişinin arasında Kral Riku da var!
Dialogue: 0,0:08:52.68,0:08:55.98,Main,Citizen,0,0,0,,Yine suçsuz kralımıza\Nihanet mi edeceğiz?!
Dialogue: 0,0:08:55.98,0:08:59.35,Main,Citizen,0,0,0,,Onları öldürmemiz gerekmiyor bence!\N12'sini gözaltına alabilirsek...
Dialogue: 0,0:08:59.35,0:09:00.79,Main,Citizen,0,0,0,,Başka seçeneğimiz yok!
Dialogue: 0,0:09:00.79,0:09:02.42,Main,Citizen,0,0,0,,Savaşalım!
Dialogue: 0,0:09:04.12,0:09:08.69,Main,Pink,0,0,0,,Yerde baygın yatan\NSayborg Franky nereye kayboldu?
Dialogue: 0,0:09:13.00,0:09:15.17,Main,Bartolomeo,0,0,0,,{\fad(150,150)}Bariyer!
Dialogue: 0,0:09:18.14,0:09:19.47,Main,Bartolomeo,0,0,0,,Takip etmeyin bizi!
Dialogue: 0,0:09:19.47,0:09:22.14,Main,Bartolomeo,0,0,0,,Yüzeye yardıralım!
Dialogue: 0,0:09:26.14,0:09:26.88,Main,Robin,0,0,0,,Zoro?
Dialogue: 0,0:09:26.88,0:09:27.81,Main,Zoro,0,0,0,,Evet...
Dialogue: 0,0:09:27.81,0:09:29.05,Main,Robin,0,0,0,,Neredesin?
Dialogue: 0,0:09:29.05,0:09:30.25,Main,Zoro,0,0,0,,Sen misin Robin?
Dialogue: 0,0:09:30.62,0:09:35.65,Main,Zoro,0,0,0,,Şu anda Luffy'lerle birlikte\NKral Tepesi denilen bir yerdeyim de...
Dialogue: 0,0:09:35.65,0:09:37.96,Main,Zoro,0,0,0,,...işler epey sarpa sardı, değil mi?
Dialogue: 0,0:09:37.96,0:09:40.89,Main,Luffy,0,0,0,,Sen misin Robin?!\NMingo adisinin...
Dialogue: 0,0:09:40.89,0:09:43.16,Main,Luffy,0,0,0,,...ne yaptığını gördün mü?!
Dialogue: 0,0:09:43.16,0:09:45.86,Main,Luffy,0,0,0,,Usopp olayı harikaydı yalnız!
Dialogue: 0,0:09:45.86,0:09:47.60,Main,Usopp,0,0,0,,{\i1}O da ne demek öyle, Luffy!{\i0}
Dialogue: 0,0:09:49.63,0:09:53.81,Main,Luffy,0,0,0,,{\i1}Rebecca da listedeydi de\Numarım bir şeyi yoktur.{\i0}
Dialogue: 0,0:09:53.81,0:09:54.77,Main,Robin,0,0,0,,Rebecca'yı soruyorsan...
Dialogue: 0,0:09:54.77,0:09:57.68,Main,Rebecca,0,0,0,,Buradayım Lucy!
Dialogue: 0,0:09:57.68,0:09:59.88,Main,Luffy,0,0,0,,Çok güzel oldu bu öyleyse!
Dialogue: 0,0:09:59.88,0:10:02.35,Main,Luffy,0,0,0,,Asker şu anda...
Dialogue: 0,0:10:04.02,0:10:05.75,Main,Luffy,0,0,0,,Asker nereye kayboldu?
Dialogue: 0,0:10:07.45,0:10:09.75,Main,Riku,0,0,0,,Yoksa...
Dialogue: 0,0:10:09.75,0:10:12.72,Main,Pirate,0,0,0,,Suçlu, öldürün!
Dialogue: 0,0:10:13.63,0:10:14.79,Main,Rebecca,0,0,0,,Asker-san...
Dialogue: 0,0:10:14.79,0:10:17.16,Main,Rebecca,0,0,0,,Asker-san da\Ninsana döndü değil mi?!
Dialogue: 0,0:10:17.16,0:10:20.03,Main,Rebecca,0,0,0,,{\i1}Nasıl biri Lucy, söylesene!{\i0}
Dialogue: 0,0:10:20.50,0:10:22.53,Main,Luffy,0,0,0,,Nasıl biri mi?
Dialogue: 0,0:10:22.53,0:10:24.00,Main,Luffy,0,0,0,,Ne diyorsun sen yahu!?
Dialogue: 0,0:10:25.00,0:10:27.14,Main,Luffy,0,0,0,,{\i1}O tek bacaklı asker...{\i0}
Dialogue: 0,0:10:29.94,0:10:32.48,Main,Luffy,0,0,0,,{\i1}...senin babandı!{\i0}
Dialogue: 0,0:10:34.75,0:10:37.62,Main,Luffy,0,0,0,,{\i1}Kolezyumdaki o ihtiyar heykelin aynısı!{\i0}
Dialogue: 0,0:10:43.42,0:10:46.16,Flashbacks,Thunder Soldier,0,0,0,,Koruyamadım onu!
Dialogue: 0,0:10:49.09,0:10:50.50,Main,Rebecca,0,0,0,,Biliyordum...
Dialogue: 0,0:10:50.50,0:10:55.10,Flashbacks,Thunder Soldier&Rebecca,0,0,0,,{\i1}Asker-san cesur mu cesur...{\i0}
Dialogue: 0,0:10:55.10,0:11:00.47,Flashbacks,Thunder Soldier&Rebecca,0,0,0,,{\i1}Olacak hep yanıbaşında...{\i0}
Dialogue: 0,0:11:03.71,0:11:04.81,Main,Luffy,0,0,0,,{\i1}Senin için çok sevindim!{\i0}
Dialogue: 0,0:11:04.81,0:11:07.85,Main,Luffy,0,0,0,,Asker şu an bir yerlere gitti sanırım\Nama beni dinle Rebecca...
Dialogue: 0,0:11:07.85,0:11:09.45,Main,Luffy,0,0,0,,{\i1}Ağlanacak vakit değil henüz!{\i0}
Dialogue: 0,0:11:09.45,0:11:11.18,Main,Luffy,0,0,0,,{\i1}Asker'in ölmesine izin vermeyeceğim!
Dialogue: 0,0:11:11.18,0:11:12.65,Main,Luffy,0,0,0,,{\i1}Sen de güvende kal!
Dialogue: 0,0:11:12.65,0:11:18.32,Main,Luffy,0,0,0,,Mera Mera Meyvesi'ni sana veremediğim için özür dilerim fakat...
Dialogue: 0,0:11:18.32,0:11:23.90,Main,Luffy,0,0,0,,...onun yerine sana Doflamingo'nun\Ncanına okuyacağıma dair söz veriyorum!
Dialogue: 0,0:11:23.90,0:11:26.16,Main,Luffy,0,0,0,,{\i1}Dostlarımın yanından ayrılma!{\i0}
Dialogue: 0,0:11:27.37,0:11:31.00,Main,Luffy,0,0,0,,{\i1}Bu oyuna\Nderhal bir son vereceğim!{\i0}
Dialogue: 0,0:11:31.00,0:11:32.24,Main,Luffy,0,0,0,,{\i1}Ne olursa olsun hayatta kal!
Dialogue: 0,0:11:32.24,0:11:33.97,Main,Luffy,0,0,0,,{\i1}Anladın mı?!
Dialogue: 0,0:11:33.97,0:11:35.71,Main,Rebecca,0,0,0,,Evet!
Dialogue: 0,0:11:35.71,0:11:38.78,Main,Robin,0,0,0,,Luffy, yanında kimler var?
Dialogue: 0,0:11:38.78,0:11:40.58,Main,Robin,0,0,0,,Burada da şu anda...
Dialogue: 0,0:11:43.58,0:11:46.22,Main,Law,0,0,0,,Ne yaptığının\Nfarkında mısın Hasır Şapka-ya?
Dialogue: 0,0:11:47.89,0:11:56.89,Main,Law,0,0,0,,Planımız GÜLÜCÜK fabrikasını yok edip \NDoflamingo'yla Kaidou arasında bir savaş çıkartmaktı.
Dialogue: 0,0:11:56.89,0:11:59.11,Main,Law,0,0,0,,Fakat Doflamingo'yu\Nşimdi öldürecek olursak...
Dialogue: 0,0:11:59.54,0:12:03.97,Main,Law,0,0,0,,...GÜLÜCÜK'ünü yitiren Kaidou\Ntüm hıncını bize çevirecek!
Dialogue: 0,0:12:06.44,0:12:11.21,Main,Law,0,0,0,,Ondan sonra da kızgın bir Yonkou'yla\Nsavaşmaktan başka bir seçeneğimiz kalmayacak!
Dialogue: 0,0:12:11.98,0:12:15.08,Main,Luffy,0,0,0,,Bu sonra konuşulacak bir mesele.
Dialogue: 0,0:12:16.28,0:12:21.22,Main,Luffy,0,0,0,,Şu ülkenin haline baksana!\NŞimdi şu noktada durursam ne olacak?!
Dialogue: 0,0:12:27.63,0:12:29.76,Main,Citizen,0,0,0,,Suçluları arayın!
Dialogue: 0,0:12:29.76,0:12:33.93,Main,Citizen,0,0,0,,Hayatta kalmamızın tek yolu\Nonları yakalamak!
Dialogue: 0,0:12:34.27,0:12:38.60,Main,Citizen,0,0,0,,Suçluları gördüğünüz an\Nherkese haber verin!
Dialogue: 0,0:12:39.90,0:12:41.77,Main,Citizen,0,0,0,,Birileri durdursun beni!
Dialogue: 0,0:12:45.04,0:12:47.91,Main,Marine,0,0,0,,Az kalmıştı!\NDikkatli ol!
Dialogue: 0,0:12:47.91,0:12:49.65,Main,Marine,0,0,0,,Yürümeye devam edin!
Dialogue: 0,0:12:52.68,0:12:57.19,Main,Bastille,0,0,0,,Issho-san, Doflamingo'yu\Nyakalamayacak mıyız?
Dialogue: 0,0:12:57.19,0:13:01.23,Main,Fujitora,0,0,0,,Kendini kontrol edemeyen\Ninsanları yakalayıp...
Dialogue: 0,0:13:01.23,0:13:05.53,Main,Fujitora,0,0,0,,...Hasır Şapka ve Law\Nkorsan ittifakına odaklanın!
Dialogue: 0,0:13:06.30,0:13:09.27,Main,Fujitora,0,0,0,,Tüm birliklere haber ver!
Dialogue: 0,0:13:09.27,0:13:11.97,Main,Law,0,0,0,,Bekle! Hâlâ kelepçeliyim!
Dialogue: 0,0:13:11.97,0:13:13.30,Main,Luffy,0,0,0,,Çıkar onlar kendiliğinden.
Dialogue: 0,0:13:13.30,0:13:15.11,Main,Law,0,0,0,,Nereye çıkıyor?!
Dialogue: 0,0:13:15.11,0:13:17.38,Main,Viola,0,0,0,,Anahtarı ben bulabilirim!
Dialogue: 0,0:13:17.38,0:13:19.38,Main,Viola,0,0,0,,Onu ne pahasına olursa olsun bulup{\fscx250}-{\r}
Dialogue: 0,0:13:22.68,0:13:24.48,Main,Zoro,0,0,0,,Ne taraftan gidelim?
Dialogue: 0,0:13:24.48,0:13:26.08,Main,Luffy,0,0,0,,Dümdüz!
Dialogue: 0,0:13:27.05,0:13:28.95,Main,Viola,0,0,0,,Zıplayacak mı?!
Dialogue: 0,0:13:28.95,0:13:33.16,Main,Luffy,0,0,0,,Bekle beni Doflamingo!
Dialogue: 0,0:13:43.07,0:13:46.17,Main,Marine,0,0,0,,Kolezyum'un altından\Nbir sürü insan çıkmaya başladı!
Dialogue: 0,0:13:46.17,0:13:50.21,Main,Marine,0,0,0,,Coğrafi yer değiştirme yüzünden\Nkolezyumun bodrumu yüzeye fırladı!
Dialogue: 0,0:13:50.21,0:13:55.35,Main,Marine,0,0,0,,Eminim bunlar da yer altı limanında\Nzorla çalıştırılan kişilerdir!
Dialogue: 0,0:13:55.85,0:13:57.11,Main,Marine,0,0,0,,Askerler!
Dialogue: 0,0:13:57.65,0:13:58.78,Main,Marine,0,0,0,,Hükümet görevlileri!
Dialogue: 0,0:13:59.28,0:14:00.62,Main,Marine,0,0,0,,Korsanlar!
Dialogue: 0,0:14:01.15,0:14:06.76,Main,Marine,0,0,0,,Bunca kişinin kimsenin ruhu bile duymadan\Nköleleştirildiğine inanmak güç!
Dialogue: 0,0:14:06.76,0:14:11.73,Main,Bastille,0,0,0,,Maynard, yarışmaya katılmanı \Nkim söyledi sana-dara!?
Dialogue: 0,0:14:11.73,0:14:14.00,Main,Bastille,0,0,0,,Haddini aştın!
Dialogue: 0,0:14:14.00,0:14:17.07,Main,Bastille,0,0,0,,Canından bile olabilirdin!
Dialogue: 0,0:14:18.37,0:14:20.14,Main,Maynard,0,0,0,,Fakat Bastille-san,...
Dialogue: 0,0:14:20.14,0:14:23.81,Main,Maynard,0,0,0,,...yarışmaya katılmam\Nsayesinde her şeyi gördüm!
Dialogue: 0,0:14:23.91,0:14:29.45,Captions,Caption,0,0,250,,{\fad(1000,0)}Donanma Kârargahı Koramirali\N"Takipçi" Maynard (Arena Gladyatörü)
Dialogue: 0,0:14:23.81,0:14:26.31,Main,Maynard,0,0,0,,{\an8}Doflamingo'yu gözaltına alabilirsek...
Dialogue: 0,0:14:26.31,0:14:29.45,Main,Maynard,0,0,0,,{\an8}...dünya çok daha\Niyi bir yere dönüşebilir!
Dialogue: 0,0:14:29.45,0:14:35.69,Captions,,0,0,0,,{\fad(500,2936)\pos(1063.272,111.667)}Yer Altı\NTicaret Limanı
Dialogue: 0,0:14:34.35,0:14:35.92,Main,Koala,0,0,0,,Bunlar...
Dialogue: 0,0:14:38.86,0:14:43.13,Main,Koala,0,0,0,,Korsan gemisi olarak gizlenmiş\NDoerena Krallığı'na ait ticaret gemisi bu.
Dialogue: 0,0:14:44.20,0:14:48.07,Main,Koala,0,0,0,,Pek çok ülkeye dair sırlar\Nbu limanda gizli anlaşılan.
Dialogue: 0,0:14:53.37,0:14:54.57,Main,Citizen,0,0,0,,Yapma lütfen!
Dialogue: 0,0:14:54.57,0:14:55.57,Main,Citizen,0,0,0,,Özür dilerim!
Dialogue: 0,0:14:55.57,0:14:56.57,Main,Citizen,0,0,0,,Hayatım!
Dialogue: 0,0:14:58.38,0:15:00.65,Main,Marine,0,0,0,,Uzaklaşın yanımdan!
Dialogue: 0,0:15:00.98,0:15:03.08,Main,Maynard,0,0,0,,Neden Issho-san?!
Dialogue: 0,0:15:05.22,0:15:08.82,Main,Maynard,0,0,0,,Doflamingo artık\NShichibukai'lık posizyonunu koruyamaz!
Dialogue: 0,0:15:08.82,0:15:10.62,Main,Maynard,0,0,0,,Onu yakalamanın tam zamanı!
Dialogue: 0,0:15:14.49,0:15:22.03,Main,Isshou-san,0,0,0,,Donanma\Naynı şeyi tekrarlayıp duruyor!
Dialogue: 0,0:15:22.03,0:15:27.41,Main,Isshou-san,0,0,0,,Uzun zamandır donanmanın bir parçasısın,\Ndeğil mi Koramiral-san?
Dialogue: 0,0:15:28.84,0:15:32.58,Main,Isshou-san,0,0,0,,Kulağını açıp da\Nbu öfke dolu çığlıkları...
Dialogue: 0,0:15:32.58,0:15:37.75,Main,Isshou-san,0,0,0,,...dinlemedin mi hiç?
Dialogue: 0,0:15:37.75,0:15:42.42,Main,Isshou-san,0,0,0,,Ağlama sesi değil bunlar, öfkeliler!
Dialogue: 0,0:15:46.89,0:15:50.06,Main,Isshou-san,0,0,0,,Dünya Hükümeti...
Dialogue: 0,0:15:50.06,0:15:53.10,Main,Isshou-san,0,0,0,,...kendini tanrı yerine mi koyuyor?!
Dialogue: 0,0:15:59.40,0:16:03.74,Main,Isshou-san,0,0,0,,Kararıma saygı göstermenizi istiyorum.
Dialogue: 0,0:16:05.91,0:16:08.71,Main,Diamante,0,0,0,,Law'ların hedefi GÜLÜCÜK değil mi?
Dialogue: 0,0:16:08.71,0:16:14.19,Main,Trébol,0,0,0,,{\an8}Baksana Doffy,\Nfabrikayı korumayalım mı?
Dialogue: 0,0:16:09.25,0:16:15.42,Captions,Caption,0,0,180,,{\fad(1000,1000)}Kraliyet Sarayının Olduğu Arazi (Ayçiçek Bahçesi)
Dialogue: 0,0:16:14.19,0:16:19.62,Main,Doflamingo,0,0,0,,{\an8}Kapılarını açamazlar.\NHepsi de Kairouseki'den yapılma.
Dialogue: 0,0:16:19.62,0:16:24.36,Main,Doflamingo,0,0,0,,Fabrikanın anahtarları da burada işte.
Dialogue: 0,0:16:25.60,0:16:26.60,Main,Baby-5,0,0,0,,Genç Bey'im!
Dialogue: 0,0:16:26.60,0:16:28.47,Main,Trébol,0,0,0,,Emin misiniz?!
Dialogue: 0,0:16:30.43,0:16:33.54,Main,Doflamingo,0,0,0,,Düşmanlarımıza umut vermeye gerek yok.
Dialogue: 0,0:16:33.80,0:16:40.01,Main,Lao G,0,0,0,,Ne zavallı birisin! Küçük bir kızı bile\Nkoruyamamış olmana şaşıyorum,...
Dialogue: 0,0:16:40.01,0:16:41.11,Main,Lao G,0,0,0,,...Trebol.
Dialogue: 0,0:16:41.11,0:16:45.38,Main,Trébol,0,0,0,,Kapa çeneni ihtiyar moruk!\NKüçük kız falan değil o!
Dialogue: 0,0:16:45.38,0:16:47.82,Main,Trébol,0,0,0,,Baksana baksana Doffy,...
Dialogue: 0,0:16:47.82,0:16:50.99,Main,Trébol,0,0,0,,...Sugar konusunda\Ngerçekten çok özür dilerim!
Dialogue: 0,0:16:51.62,0:16:58.03,Main,Trébol,0,0,0,,Elleri ayakları bağlı bir adamın\NSugar'ı bayıltabileceğini düşünmemiştim!
Dialogue: 0,0:16:58.03,0:17:00.06,Main,Trébol,0,0,0,,Nasıl düşünebilirdim ki?!
Dialogue: 0,0:17:00.06,0:17:02.13,Main,Diamante,0,0,0,,Mera Mera Meyvesi'yle de aynı şey oldu!
Dialogue: 0,0:17:02.40,0:17:07.87,Main,Diamante,0,0,0,,Devrim Ordusu'nun iki numaralı adamının\Nyarışmada savaştığını nereden bilebilirdim?!
Dialogue: 0,0:17:07.87,0:17:09.54,Main,Diamante,0,0,0,,İmkanı yoktu resmen!
Dialogue: 0,0:17:10.11,0:17:14.18,Main,Lao G,0,0,0,,Mazeret üretmeyin!\NSizi beceriksiz gerzekler!
Dialogue: 0,0:17:14.18,0:17:16.88,Main,Lao G,0,0,0,,Gerzek'in G'si!
Dialogue: 0,0:17:18.62,0:17:20.62,Main,Doflamingo,0,0,0,,Olan oldu.
Dialogue: 0,0:17:21.19,0:17:25.56,Main,Doflamingo,0,0,0,,Sizi suçlasam bile\Nzamanı geri çeviremeyiz.
Dialogue: 0,0:17:25.56,0:17:29.26,Main,Trébol,0,0,0,,Değil mi ama?!\NPatronumuz bizim!
Dialogue: 0,0:17:29.26,0:17:31.43,Main,Trébol,0,0,0,,Al sana Lao G!
Dialogue: 0,0:17:31.43,0:17:34.33,Main,Diamante,0,0,0,,Bu kadar ısrar ediyorsanız\Nbeni affetmenize izin vereceğim!
Dialogue: 0,0:17:34.33,0:17:39.20,Main,Diamante,0,0,0,,Fakat Doffy, bu noktada\Ndonanma bize engel olacaktır.
Dialogue: 0,0:17:39.20,0:17:40.84,Main,Diamante,0,0,0,,Fujitora'yı ne yapacağız?
Dialogue: 0,0:17:40.84,0:17:46.84,Main,Doffy,0,0,0,,Onunla çoktan konuştum.\NDonanma peşimize düşmeyecek.
Dialogue: 0,0:17:46.84,0:17:51.25,Main,Doffy,0,0,0,,Fakat Fujitora'yla işimiz bittiğinde...
Dialogue: 0,0:17:51.25,0:17:53.25,Main,Doffy,0,0,0,,...ortadan kaldırılması gerekecek.
Dialogue: 0,0:17:53.88,0:18:00.02,Flashbacks,Fujitora,0,0,0,,Amacım Shichibukai sistemini\Nkökünden kazımak!
Dialogue: 0,0:18:00.16,0:18:03.70,Main,Doflamingo,0,0,0,,Onu hayatta tutmanın\Nbize hiçbir faydası yok.
Dialogue: 0,0:18:03.70,0:18:07.00,Main,Doflamingo,0,0,0,,Canını almanın\Nkolay olacağını sanmıyorum gerçi.
Dialogue: 0,0:18:07.46,0:18:13.00,Main,Pica,0,0,0,,Ortalığı biraz dağıtmama izin verirseniz\NDonanmayı da, korsanları da...
Dialogue: 0,0:18:13.00,0:18:13.97,Thoughts,Grunt,0,0,0,,Bu ses...
Dialogue: 0,0:18:13.97,0:18:15.37,Thoughts,Grunt,0,0,0,,Sesi...
Dialogue: 0,0:18:15.91,0:18:19.38,Main,Pica,0,0,0,,...tek başıma haklarım!
Dialogue: 0,0:18:21.11,0:18:26.25,Captions,Caption,0,0,240,,{\fad(1000,0)}PICA - Don Quixote Ailesi\NÜst Düzey Yöneticisi {\fnA-OTF Jun Pro 201\fs28}♠{\fnroboto\fs28}
Dialogue: 0,0:18:26.25,0:18:28.42,Thoughts,Grunt,0,0,0,,{\i1}Bu ne tiz ses!{\i0}
Dialogue: 0,0:18:28.42,0:18:31.72,Thoughts,Grunt,0,0,0,,{\i1}Neresinden çıkıyor o ses?!{\i0}
Dialogue: 0,0:18:31.72,0:18:35.49,Thoughts,Grunt,0,0,0,,{\i1}Defalarca duymuş olmama rağmen\Nasla alışamayacağım buna!{\i0}
Dialogue: 0,0:18:35.49,0:18:39.36,Thoughts,Grunt,0,0,0,,{\i1}Ama şimdi gülersem\Nöldürür beni!{\i0}
Dialogue: 0,0:18:40.60,0:18:43.00,Main,Doflamingo,0,0,0,,Acelemiz yok.
Dialogue: 0,0:18:43.00,0:18:49.11,Main,Doflamingo,0,0,0,,Bu oyun krallarına karar verdikleri\Nbir tür seçim aslında.
Dialogue: 0,0:18:49.11,0:18:51.93,Main,Doflamingo,0,0,0,,Dressrosa halkına\Naslında şunu sordum....
Dialogue: 0,0:18:51.95,0:18:57.45,Main,Doflamingo,0,0,0,,...Kralınız olmaya Riku Ailesi mi yoksa\NDon Quixote Ailesi mi daha uygun?
Dialogue: 0,0:18:57.95,0:19:02.52,Main,Doflamingo,0,0,0,,Halk kralını seçer.\NBu en doğal hakları.
Dialogue: 0,0:19:02.52,0:19:09.86,Main,Doflamingo,0,0,0,,Biz üzerimize gelenleri engelleyip \Ngeri kalanların birbirlerini öldürmelerini izleyelim.
Dialogue: 0,0:19:09.86,0:19:11.36,Main,,0,0,0,,Can sıkıcı iş!
Dialogue: 0,0:19:11.36,0:19:13.03,Main,Pica,0,0,0,,Doffy, ben{\fscx250}-{\r}
Dialogue: 0,0:19:17.40,0:19:19.64,Main,Grunt,0,0,0,,Özür dilerim, Pica-sama!
Dialogue: 0,0:19:19.64,0:19:22.34,Main,Grunt,0,0,0,,Lütfen bağışlayın onu!\NYeni geldi.
Dialogue: 0,0:19:22.34,0:19:24.24,Main,Grunt,0,0,0,,Hazırlıksız yakalandı biraz...
Dialogue: 0,0:19:24.24,0:19:25.94,Main,Grunt,0,0,0,,Özür dilerim!\NÖzür dilerim!
Dialogue: 0,0:19:25.94,0:19:30.68,Main,Pica,0,0,0,,Canlı canlı gömeceğim seni!\NTaşlar arasında kalacaksın!
Dialogue: 0,0:19:31.53,0:19:32.52,Main,Baby-5,0,0,0,,Bekle Pica-sama!
Dialogue: 0,0:19:33.11,0:19:34.99,Main,Baby-5,0,0,0,,{\fad(150,150)}Mitralyöz Kız!
Dialogue: 0,0:19:41.76,0:19:44.96,Main,Baby-5,0,0,0,,Kendin halletmeye kalksaydın\Nbedeninden geriye parça kalmayacaktı!
Dialogue: 0,0:19:49.10,0:19:50.80,Main,Baby-5,0,0,0,,Ailesine gömecek bir mezar bile\Nteslim edemeyecektik.
Dialogue: 0,0:19:50.80,0:19:53.34,Main,Pica,0,0,0,,Teşekkür ederim, Baby 5!
Dialogue: 0,0:20:01.41,0:20:04.58,Main,Doflamingo,0,0,0,,8 yaşımdayken annemi yitirdim,...
Dialogue: 0,0:20:04.58,0:20:07.38,Main,Doflamingo,0,0,0,,...10 yaşımda da babamı öldürdüm.
Dialogue: 0,0:20:08.39,0:20:15.63,Main,Doflamingo,0,0,0,,Yönetici ve üstü herkes iyi günde kötü günde \Nyanımda olmuş yegâne ailemdir.
Dialogue: 0,0:20:16.73,0:20:19.53,Main,Doflamingo,0,0,0,,Onlardan başka kimsem yok!
Dialogue: 0,0:20:19.53,0:20:24.13,Main,Doflamingo,0,0,0,,Aileme gülen kimseyi affetmem!\NAnladınız mı?
Dialogue: 0,0:20:24.13,0:20:26.53,Main,Grunt,0,0,0,,Emredersiniz!
Dialogue: 0,0:20:34.65,0:20:38.45,Main,Marine,0,0,0,,Dinleyin! \NKontrolden çıkmış olanları bağlayacağız!
Dialogue: 0,0:20:38.45,0:20:41.95,Main,Marine,0,0,0,,Hasır Şapkalar'la Trafalgar Law'ı bulun!
Dialogue: 0,0:20:41.95,0:20:43.02,Main,Marine,0,0,0,,{\i1}Emredersiniz!
Dialogue: 0,0:20:43.59,0:20:48.52,Main,Machvise,0,0,0,,Donanma bizimle savaşmayacak gibi-in!
Dialogue: 0,0:20:48.52,0:20:52.46,Main,Pink,0,0,0,,Genç Bey'imize Shichibukai gibi\Ndavranmayı mı planlıyorlar?
Dialogue: 0,0:20:52.46,0:20:55.03,Main,Pink,0,0,0,,Biraz fazla iyi görünmüyor mu göze?
Dialogue: 0,0:20:56.10,0:20:59.40,Main,Dellinger,0,0,0,,Ay! Belki de\NKuş Kafesi'nden korkmuşlardır!
Dialogue: 0,0:20:59.40,0:21:05.74,Main,Pink,0,0,0,,Her şeyden öte o sapık herifin \Nkaçacak gücü kaldığına inanması güç.
Dialogue: 0,0:21:05.74,0:21:08.18,Main,Pink,0,0,0,,Nereye gitti acaba?!
Dialogue: 0,0:21:10.65,0:21:13.65,Main,Franky,0,0,0,,GÜLÜCÜK fabrikası şu kesin!
Dialogue: 0,0:21:13.65,0:21:18.76,Main,Franky,0,0,0,,Ne de savunmasız duruyor öyle!\NIşınla beni der gibi!
Dialogue: 0,0:21:24.33,0:21:27.16,Main,Machvise,0,0,0,,Gökten bir balon düşüyor-in!
Dialogue: 0,0:21:27.16,0:21:29.00,Main,Pink,0,0,0,,Balon mu?
Dialogue: 0,0:21:38.08,0:21:38.88,Main,,0,0,0,,Law!
Dialogue: 0,0:21:38.88,0:21:42.38,Main,Pink,0,0,0,,Yaralanmak istemiyorsanız\Ngeri durun yavrucaklar!
Dialogue: 0,0:21:42.38,0:21:45.35,Main,Dellinger,0,0,0,,Law ağabey mi?!\NOnu hayal meyal hatırlıyorum ama...
Dialogue: 0,0:21:48.32,0:21:50.29,Main,Grunt,0,0,0,,Hasır Şapkalı Luffy!
Dialogue: 0,0:21:51.12,0:21:53.06,Main,Grunt,0,0,0,,Trafalgar Law!
Dialogue: 0,0:21:53.96,0:21:55.99,Main,Grunt,0,0,0,,Korsan Avcısı!
Dialogue: 0,0:21:57.39,0:22:00.20,Main,Luffy,0,0,0,,Berbat bir yere konduk resmen!
Dialogue: 0,0:22:00.20,0:22:05.17,Main,Law,0,0,0,,Bana bak Hasır Şapka, bu kelepçeler\Nçıktığında ilk seni öldüreceğim!
Dialogue: 0,0:22:05.17,0:22:08.71,Main,Zoro,0,0,0,,Konacak iyi bir yer yok şu an\Ndemiştim sana.
Dialogue: 0,0:22:08.71,0:22:11.58,Main,Zoro,0,0,0,,Tüm ülke peşimizde!
Dialogue: 0,0:22:11.58,0:22:13.44,Main,Zoro,0,0,0,,Neyse, kaçalım!
Dialogue: 0,0:22:13.44,0:22:14.35,Main,Luffy,0,0,0,,Peki!
Dialogue: 0,0:22:14.75,0:22:16.45,Main,Grunt,0,0,0,,Peşlerine düşün!
Dialogue: 0,0:22:16.45,0:22:18.72,Main,Luffy,0,0,0,,Zoro, o taraftan dağil!
Dialogue: 0,0:22:18.72,0:22:21.15,Main,Law,0,0,0,,Hasır Şapka, bu taraftan da değil!
Dialogue: 0,0:22:21.15,0:22:23.29,Main,Citizen,0,0,0,,Suçluları bulduk!
Dialogue: 0,0:22:23.29,0:22:26.49,Main,Citizen,0,0,0,,İki üç, bir tane de iki yıldız!
Dialogue: 0,0:22:29.39,0:22:32.80,Main,Luffy,0,0,0,,Yakalandım!\NTuhaf herif yerden yüze yüze geldi!
Dialogue: 0,0:22:32.80,0:22:34.50,Main,Pink,0,0,0,,Yap haydi, Vise!
Dialogue: 0,0:22:36.33,0:22:39.57,Main,Law,0,0,0,,Kaç!\NSüper ağır insandır!
Dialogue: 0,0:22:40.34,0:22:42.57,Main,Luffy,0,0,0,,Ne?! Lanet olsun!\NBacaklarımı bırak!
Dialogue: 0,0:22:42.57,0:22:44.81,Main,Machvise,0,0,0,,{\fad(150,150)}Ton Ton!\NOn Ton Vise!
Dialogue: 0,0:22:49.31,0:22:52.18,Main,Luffy,0,0,0,,Çıkartamıyorum!\NAyaklarım sıkıştı!
Dialogue: 0,0:22:55.05,0:22:57.22,Main,Dellinger,0,0,0,,Bu sefer ıskalamayacağım!
Dialogue: 0,0:22:57.22,0:22:59.52,Main,Dellinger,0,0,0,,{\fad(150,150)}Topuklu Tabanca!
Dialogue: 0,0:23:04.19,0:23:06.00,Main,Dellinger,0,0,0,,Ağırmış!
Dialogue: 0,0:23:06.00,0:23:07.87,Main,Machvise,0,0,0,,Acıdı!
Dialogue: 0,0:23:09.17,0:23:10.90,Main,Luffy,0,0,0,,Güzel, bacaklarım serbest kaldı!
Dialogue: 0,0:23:10.90,0:23:12.84,Main,Zoro,0,0,0,,Dikkatli ol biraz!\NGidelim!
Dialogue: 0,0:23:13.74,0:23:16.74,Main,Pirate,0,0,0,,Başınızdaki 800 milyon bizim olacak!
Dialogue: 0,0:23:16.74,0:23:18.04,Main,Pirate,0,0,0,,Ölmeye hazırlanın!
Dialogue: 0,0:23:18.04,0:23:19.04,Main,Pirate,0,0,0,,Ateş!
Dialogue: 0,0:23:27.72,0:23:30.52,Main,Citizen,0,0,0,,İki ve üç yıldızlar!
Dialogue: 0,0:23:31.62,0:23:35.99,Main,Zoro,0,0,0,,Lanet olsun, ne can sıkıcı iş!\NDe kesebilir miyim bunları?!
Dialogue: 0,0:23:35.99,0:23:38.40,Main,Zoro,0,0,0,,Arada siviller de var!
Dialogue: 0,0:23:38.40,0:23:40.10,Main,Luffy,0,0,0,,Tamamdır, hakimle...
Dialogue: 0,0:23:40.73,0:23:41.90,Main,Fujitora,0,0,0,,Durun!
Dialogue: 0,0:23:44.10,0:23:49.04,Main,Fujitora,0,0,0,,Silahı çok konuşanın\Nşansı hep yaver gitmez.
Dialogue: 0,0:24:00.98,0:24:03.12,Main,Zoro,0,0,0,,Donanma amirali!
Dialogue: 0,0:24:04.89,0:24:06.42,Main,Luffy,0,0,0,,Kumarcı ihtiyar!
Dialogue: 0,0:24:12.80,0:24:15.60,Main,Citizen,0,0,0,,Beş yıldızlı Usopp Kolezyumda!
Dialogue: 0,0:24:15.60,0:24:17.50,Main,Citizen,0,0,0,,Şu tarafta!\NPeşine düşelim!
Dialogue: 0,0:24:18.17,0:24:20.07,Main,Citizen,0,0,0,,Öldürün!
Dialogue: 0,0:24:20.07,0:24:22.07,Main,Usopp,0,0,0,,Düşün yakamdan ya!
Dialogue: 0,0:24:22.81,0:24:28.11,Main,Robin,0,0,0,,Kolezyum'un dış duvarı yerin hareket etmesi\Nsayesinde tepeye bağlanmış durumda.
Dialogue: 0,0:24:28.11,0:24:31.15,Main,Robin,0,0,0,,Oradan tırmanırsak\Ndiğerleriyle buluşabiliriz!
Dialogue: 0,0:24:31.15,0:24:32.18,Main,Pirate,0,0,0,,Oradalar!
Dialogue: 0,0:24:33.82,0:24:35.62,Main,Robin,0,0,0,,Rebecca, sen önden git!
Dialogue: 0,0:24:35.62,0:24:36.62,Main,Rebecca,0,0,0,,Robin-san!
Dialogue: 0,0:24:36.62,0:24:38.29,Main,Pirate,0,0,0,,Bizimsiniz!
Dialogue: 0,0:24:43.46,0:24:44.50,Main,Robin,0,0,0,,Bartolomeo!
Dialogue: 0,0:24:45.70,0:24:50.03,Main,Bartolomeo,0,0,0,,Robin-senpai'nin adımı söylemesi\Nbeni acayip heyecanlandırdı!
Dialogue: 0,0:24:50.03,0:24:52.84,Main,Bartolomeo,0,0,0,,Be-Ben düşmanları burada tutarım.
Dialogue: 0,0:24:52.84,0:24:56.24,Main,Bartolomeo,0,0,0,,Siz Sogeking-senpai'yle birlikte buyrun!
Dialogue: 0,0:24:56.24,0:24:57.57,Main,Robin,0,0,0,,Teşekkür ederim!
Dialogue: 0,0:24:58.48,0:25:01.58,Main,Bartolomeo,0,0,0,,Robin-senpai teşekkür etti!
Dialogue: 0,0:25:01.58,0:25:06.32,Main,Bartolomeo,0,0,0,,Acayip gaza geldim!\NBir kişi bile geçemez buradan!
Dialogue: 0,0:25:11.08,0:25:12.92,Main,Riku,0,0,0,,Bu sefer ne oluyor?!
Dialogue: 0,0:25:17.19,0:25:19.63,Main,Citizen,0,0,0,,Gene aynı şey oluyor!
Dialogue: 0,0:25:25.97,0:25:27.50,Main,Kyros,0,0,0,,Ne oluyor?!
Dialogue: 0,0:25:50.99,0:25:52.26,Main,Citizen,0,0,0,,Bu...
Dialogue: 0,0:25:52.26,0:25:54.33,Main,Citizen,0,0,0,,Sonunda kendini gösterdi!
Dialogue: 0,0:25:56.07,0:25:58.90,Main,Citizen,0,0,0,,O ortaya çıktığında\Nher şey bitti demektir!
Dialogue: 0,0:25:58.90,0:26:01.07,Main,Citizen,0,0,0,,Kimse ona karşılık veremez!
Dialogue: 0,0:26:23.86,0:26:26.43,Main,Luffy,0,0,0,,Bu da ne be?!
Dialogue: 0,0:26:33.60,0:26:35.11,Main,Pirate,0,0,0,,Dev mi?
Dialogue: 0,0:26:35.11,0:26:36.94,Main,Pirate,0,0,0,,Devasa!
Dialogue: 0,0:26:37.57,0:26:38.98,Main,Zoro,0,0,0,,Bu...
Dialogue: 0,0:26:38.98,0:26:40.14,Main,Law,0,0,0,,Pica!
Dialogue: 0,0:26:41.18,0:26:43.57,Main,Grunt,0,0,0,,Pica-sama!
Dialogue: 0,0:26:44.55,0:26:49.62,Main,Pica,0,0,0,,Ailemize karşı gelenlerin...
Dialogue: 0,0:26:50.85,0:26:54.17,Main,Pica,0,0,0,,...karşısında ben varım!
Dialogue: 0,0:26:56.56,0:27:00.20,Main,Luffy,0,0,0,,Bu nasıl cırtlak bir sestir?!
Dialogue: 0,0:27:12.33,0:27:13.44,Main,Luffy,0,0,0,,Ah, hadi ama!
Dialogue: 0,0:27:13.44,0:27:16.15,Main,Luffy,0,0,0,,Cüssesine hiç uymuyor!
Dialogue: 0,0:27:19.82,0:27:21.82,Main,Luffy,0,0,0,,Ne komik sesi var!
Dialogue: 0,0:27:28.53,0:27:29.93,Main,Pica,0,0,0,,Hasır Şapka!
