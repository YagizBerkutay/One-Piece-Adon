Dialogue: 0,0:01:38.24,0:01:40.91,Main,Doflamingo,0,0,0,,{\i1}Yardımınıza kimse gelmeyecek.
Dialogue: 0,0:01:40.91,0:01:44.32,Main,Doflamingo,0,0,0,,{\i1}Bu kuş kafesinden kimse kaçamaz.
Dialogue: 0,0:01:44.32,0:01:45.98,Main,Government official,0,0,0,,Alo! Alo!
Dialogue: 0,0:01:46.49,0:01:49.55,Main,Doflamingo,0,0,0,,Dışarısıyla iletişim kuramazsınız.
Dialogue: 0,0:01:49.55,0:01:54.79,Main,Doflamingo,0,0,0,,Dışarıdaki kimsenin ruhu bile duymadan\Nhepiniz öleceksiniz.
Dialogue: 0,0:01:55.53,0:01:57.93,Main,Doflamingo,0,0,0,,Kendini kaybetmiş komşularınız...
Dialogue: 0,0:01:57.93,0:02:01.50,Main,Doflamingo,0,0,0,,...rastgele başkalarına\Nzarar vermeye devam edecekler.
Dialogue: 0,0:01:58.93,0:02:02.03,Secondary,Citizen,0,0,0,,Birileri lütfen beni durdursun!
Dialogue: 0,0:02:02.03,0:02:04.10,Main,Citizen,0,0,0,,Kendi çocuklarımı öldüreceğim yoksa!
Dialogue: 0,0:02:04.10,0:02:11.21,Main,Doflamingo,0,0,0,,{\i1}Aileleri olsun, en yakın dostları olsun,\Nkorumak için yemin ettikleri halk olsun fark etmez.{\i0}
Dialogue: 0,0:02:11.21,0:02:12.65,Main,Citizen,0,0,0,,Yapma lütfen!
Dialogue: 0,0:02:12.65,0:02:14.71,Main,Citizen,0,0,0,,Bedenimi kontrol edemiyorum!
Dialogue: 0,0:02:14.71,0:02:17.05,Main,Citizen,0,0,0,,Birileri lütfen beni durdursun!
Dialogue: 0,0:02:17.35,0:02:21.49,Main,Marine,0,0,0,,Uzaklaşın benden!
Dialogue: 0,0:02:23.96,0:02:24.92,Main,Marine,0,0,0,,Issho-san!
Dialogue: 0,0:02:29.66,0:02:32.80,Main,Doflamingo,0,0,0,,{\i1}Kaçsanız da saklansanız da...{\i0}
Dialogue: 0,0:02:32.80,0:02:36.33,Main,Doflamingo,0,0,0,,{\i1}...bu kafesin içinde\Ngüvenli bir yer bulamayacaksınız.{\i0}
Dialogue: 0,0:02:35.47,0:02:40.14,Title,,0,0,160,,{\fad(2000,0)}Üst Düzey Yönetici Pica
Dialogue: 0,0:02:36.33,0:02:40.14,Main,Doflamingo,0,0,0,,{\i1}Kuş kafesinin dehşeti günler sürecek.{\i0}
Dialogue: 0,0:02:40.14,0:02:47.18,Main,Doflamingo,0,0,0,,Acaba ölüm mü daha hızlı gelecek\Nyoksa ölmeden oyunu bitirebilecek misiniz?
Dialogue: 0,0:02:52.55,0:02:56.02,Main,Pirate,0,0,0,,Lanet olası Doflamingo!\NNe yapacağını kestirmek mümkün değil!
Dialogue: 0,0:02:56.02,0:03:00.46,Main,Pirate,0,0,0,,Fabrikanın böyle\Nyerinden yükselip gitmesine inanamıyorum!
Dialogue: 0,0:03:00.46,0:03:03.22,Main,Pirate,0,0,0,,Bizim için harika oldu bu ama!
Dialogue: 0,0:03:03.22,0:03:05.33,Main,Pirate,0,0,0,,Dışarı çıkabileceğiz!
Dialogue: 0,0:03:05.33,0:03:08.03,Main,Pirate,0,0,0,,Sonunda yeraltından kurtulacağız!
Dialogue: 0,0:03:08.03,0:03:10.67,Main,Pirate,0,0,0,,Teşekkür ederiz Tanrı Usopp!
Dialogue: 0,0:03:10.67,0:03:12.80,Main,Pirate,0,0,0,,İlerleyin!
Dialogue: 0,0:03:13.97,0:03:15.17,Main,Kin'emon,0,0,0,,Robin-dono!
Dialogue: 0,0:03:15.47,0:03:16.64,Main,Robin,0,0,0,,Kin'emon!
Dialogue: 0,0:03:18.51,0:03:20.81,Thoughts,Kin'emon,0,0,0,,De-Demirden meme bandı demek?
Dialogue: 0,0:03:20.81,0:03:22.65,Thoughts,Kin'emon,0,0,0,,Yabancı kültürler de bir başka oluyor!
Dialogue: 0,0:03:23.15,0:03:24.68,Thoughts,Kin'emon,0,0,0,,Çok sevdim!
Dialogue: 0,0:03:24.98,0:03:27.69,Main,Bartolomeo,0,0,0,,Ro-Robin-senpai, izin ver kölen olayım!
Dialogue: 0,0:03:27.69,0:03:30.96,Main,Bartolomeo,0,0,0,,Oha yanlış oldu,\Nbir şey sorabilir miyim diyecektim!
Dialogue: 0,0:03:31.52,0:03:34.16,Main,Bartolomeo,0,0,0,,Şu kişinin burnu...
Dialogue: 0,0:03:34.16,0:03:39.93,Main,Bartolomeo,0,0,0,,...Adalet Kulesi'ndeki bayrağı vurmasıyla bilinen \NSogeking-senpai'nin burnuna tıpatıp benziyor!
Dialogue: 0,0:03:39.93,0:03:43.40,Main,Robin,0,0,0,,Aynı kişiler.\NAdı Usopp.
Dialogue: 0,0:03:43.40,0:03:45.24,Main,Bartolomeo,0,0,0,,Vay canına be!
Dialogue: 0,0:03:45.24,0:03:49.21,Main,Bartolomeo,0,0,0,,Dostlarından biri için\Ndünyayı karşılarına alan tayfanın...
Dialogue: 0,0:03:49.21,0:03:53.41,Main,Bartolomeo,0,0,0,,...yaptıklarından etkilenen\NRobin-senpai'yle de tanıştım!
Dialogue: 0,0:03:53.41,0:03:56.72,Main,Bartolomeo,0,0,0,,Enies Lobby'nin en gözde ikilisi!
Dialogue: 0,0:03:56.72,0:03:58.22,Main,Bartolomeo,0,0,0,,\NBu işte be!
Dialogue: 0,0:03:58.22,0:04:02.19,Main,Sabo,0,0,0,,Ne diye böyle heyecanlandın şimdi\Nmanyak herif! Kapa çeneni az!
Dialogue: 0,0:04:02.19,0:04:05.09,Main,Hack,0,0,0,,Kolumu bu ahmak mı kırdı benim şimdi?
Dialogue: 0,0:04:05.86,0:04:08.33,Main,Kin'emon,0,0,0,,Öyleyse onları size emanet ediyorum.
Dialogue: 0,0:04:08.33,0:04:11.40,Main,Kin'emon,0,0,0,,Küçük olmalarına rağmen çok iyi savaşçılar.
Dialogue: 0,0:04:11.40,0:04:13.53,Main,Leo,0,0,0,,Teşekkür ederiz Topuzland.
Dialogue: 0,0:04:13.53,0:04:16.07,Main,Wicca,0,0,0,,Onları sarayda baygın halde bulduk!
Dialogue: 0,0:04:16.07,0:04:19.07,Main,Inhel,0,0,0,,Komutanımız uğruna\Ncanlarını ortaya koymuş olmalılar.
Dialogue: 0,0:04:19.07,0:04:22.04,Main,Inhel,0,0,0,,Kabu-san, Rampo!\NSizinle gurur duyuyorum!
Dialogue: 0,0:04:25.28,0:04:29.55,Main,Citizen,0,0,0,,Birileri lütfen beni durdursun!\NBedenime söz geçiremiyorum!
Dialogue: 0,0:04:31.85,0:04:37.19,Main,Citizen,0,0,0,,Bu aynı 10 yıl önceki o gece olanlar gibi!
Dialogue: 0,0:04:37.19,0:04:40.99,Main,Citizen,0,0,0,,Şimdi...\NAnlıyorum!
Dialogue: 0,0:04:41.43,0:04:45.83,Main,Citizen,0,0,0,,Kral Riku-sama da,\NKral Riku Ordusu da o gece...
Dialogue: 0,0:04:48.70,0:04:52.67,Main,Citizen,0,0,0,,...Doflamingo tarafından kontrol ediliyorlarmış!
Dialogue: 0,0:04:53.17,0:04:56.91,Main,Doflamingo,0,0,0,,Bağırın! Nefret edin! Acı çekin!
Dialogue: 0,0:04:56.91,0:05:01.08,Main,Doflamingo,0,0,0,,Sizler hiçbir günahı olmayan\Nkurbanlarsınız!
Dialogue: 0,0:05:01.08,0:05:02.15,Main,Citizen,0,0,0,,Yardım edin...
Dialogue: 0,0:05:14.93,0:05:19.26,Main,Riku,0,0,0,,Kes şunu...\NDoflamingo!
Dialogue: 0,0:05:20.03,0:05:22.10,Main,Doflamingo,0,0,0,,{\i1}Düşünün!{\i0}
Dialogue: 0,0:05:22.10,0:05:24.40,Main,Doflamingo,0,0,0,,Benim peşime mi düşeceksiniz yoksa...
Dialogue: 0,0:05:24.40,0:05:33.47,Main,Doflamingo,0,0,0,,...Don Quixote Ailesi'yle bir olup bana karşı ayaklanan 12 aptalı mı cezalandıracaksınız?
Dialogue: 0,0:05:33.47,0:05:37.65,Main,Doflamingo,0,0,0,,{\i1}Yanlış karar verirseniz\Noyun asla sona ermeyecek.{\i0}
Dialogue: 0,0:05:37.65,0:05:41.25,Main,Doflamingo,0,0,0,,{\i1}Her bir yıldız için\N100 milyon beli vereceğim!{\i0}
Dialogue: 0,0:05:41.25,0:05:42.85,Main,People,0,0,0,,{\i1}100 milyon beli mi?!
Dialogue: 0,0:05:42.85,0:05:46.86,Main,Doflamingo,0,0,0,,{\i1}Dressrosa'da bulunan suçlular bunlar işte!{\i0}
Dialogue: 0,0:05:49.28,0:05:53.63,Captions,,0,0,0,,{\fs15\pos(128.9,45)}REBECCA - Corrida Kolezyumu'nun Hükümlü\NGladyatörlerinden - Kral Riku'nun Torunu
