Dialogue: 0,0:00:02.49,0:00:04.79,English - OP18,,0,0,0,,~ Dövüş! ~\N♪ Çarpış ve yüksel yerinden ♪
Dialogue: 0,0:00:04.79,0:00:08.00,English - OP18,,0,0,0,,♪ Aşmamız gereken zor günlerimiz bunlar ♪
Dialogue: 0,0:00:08.00,0:00:12.84,English - OP18,,0,0,0,,♪ Keza sıradan günler yetmez sususluğumuzu dindirmeye ♪
Dialogue: 0,0:00:12.84,0:00:15.09,English - OP18,,0,0,0,,~ İşte başlıyoruz! ~\N♪ Kaçmadan, hep ileriye ♪
Dialogue: 0,0:00:15.09,0:00:19.17,English - OP18,,0,0,0,,♪ Ulu rüzgarlarda yaşayalım harabeye dönsek bile ♪
Dialogue: 0,0:00:19.17,0:00:21.87,English - OP18,,0,0,0,,♪ Hedefse hâlâ çok uzakta ♪
Dialogue: 0,0:00:21.87,0:00:26.69,English - OP18,,0,0,0,,♪ Aşmalı bu zor günleri ♪
Dialogue: 0,0:00:28.53,0:00:31.61,English - OP18,,0,0,0,,♪ Yine yapalım, evet, kaç kez daha, bebeğim ♪
Dialogue: 0,0:00:31.83,0:00:34.11,English - OP18,,0,0,0,,♪ Hayalimi gerçekleştirmek için doğrulmalı yerimden ♪
Dialogue: 0,0:00:34.33,0:00:36.72,English - OP18,,0,0,0,,♪ Çünkü her gün sanki yeniden test ediliyor ♪
Dialogue: 0,0:00:36.96,0:00:39.42,English - OP18,,0,0,0,,♪ İrade gücüm ♪
Dialogue: 0,0:00:39.42,0:00:40.69,English - OP18,,0,0,0,,~ Haydi gidelim! ~
Dialogue: 0,0:00:40.92,0:00:44.46,English - OP18,,0,0,0,,♪ İstemiyorum bahaneler üretip küçük başarılarla yetinmeyi ♪
Dialogue: 0,0:00:44.67,0:00:45.96,English - OP18,,0,0,0,,~ Haydi gidelim! ~
Dialogue: 0,0:00:46.18,0:00:49.66,English - OP18,,0,0,0,,♪ Vahşi ve kanunsuz içine düştüğüm şu dünyada ♪
Dialogue: 0,0:00:49.89,0:00:54.18,English - OP18,,0,0,0,,♪ Gardımı indirmiş rüzgarla esip giderken \Ngerçeklik çalınıyor yüzüme ♪
Dialogue: 0,0:00:54.18,0:00:59.47,English - OP18,,0,0,0,,♪ Acımasızca döv beni, vur bana ve \Ndüşecek olursam da yine ♪
Dialogue: 0,0:01:00.36,0:01:04.57,English - OP18,,0,0,0,,♪ Biliyorum yeniden doğrulup ileriye bakabilenler olacak ♪
Dialogue: 0,0:01:04.57,0:01:07.82,English - OP18,,0,0,0,,♪ Son gülüp kazananlar ♪
Dialogue: 0,0:01:07.82,0:01:10.12,English - OP18,,0,0,0,,~ Koşmalı şeref yolunda oraya varana kadar ~
Dialogue: 0,0:01:10.30,0:01:12.54,English - OP18,,0,0,0,,~ Dövüş! ~\N♪ Kurtul kabuslarından, güçlü ol ♪
Dialogue: 0,0:01:12.54,0:01:15.72,English - OP18,,0,0,0,,♪ Aşmamız gereken zor günlerimiz bunlar ♪
Dialogue: 0,0:01:15.72,0:01:20.80,English - OP18,,0,0,0,,♪ Kolay yol? Yok öyle bir şey ♪
Dialogue: 0,0:01:20.80,0:01:23.13,English - OP18,,0,0,0,,~ İşte başlıyoruz! ~\N♪ Hep en iyisi ol ♪
Dialogue: 0,0:01:23.13,0:01:27.18,English - OP18,,0,0,0,,♪ Sorumluluklarını düşünmeden ilerle ♪
Dialogue: 0,0:01:27.18,0:01:29.81,English - OP18,,0,0,0,,♪ Ve tüm dileklerimizi bir araya getirerek ♪
Dialogue: 0,0:01:29.81,0:01:34.99,English - OP18,,0,0,0,,♪ Aşmalı bu zor günleri ♪
Dialogue: 0,0:01:42.66,0:01:52.66,Author,,0,0,0,,{\fad(500,500)\fs18} Türkçeleştirme & Çevirmen  {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&} - {\c&H01BAFF&}{\b1}eray.gns{\b0}{\c&HFFFFFF&}
