Dialogue: 0,0:01:42.66,0:01:47.60,Title,,0,0,250,,{\fad(200,200)}Koz
Dialogue: 0,0:01:50.59,0:01:53.49,Main,,0,0,0,,{\i1}Prenses Mansherry, umarım iyisindir.{\i0}
Dialogue: 0,0:01:54.66,0:01:56.24,Main,,0,0,0,,Harikaymış var ya!
Dialogue: 0,0:01:56.24,0:01:58.27,Main,,0,0,0,,Buradan sarayın içini görebiliyor musun?
Dialogue: 0,0:01:58.27,0:02:01.97,Main,,0,0,0,,Evet, görü gücüm.\Nİstediğim her noktayı görebilirim.
Dialogue: 0,0:02:01.97,0:02:04.21,Main,,0,0,0,,Tam Sanji'nin isteyeceği türde bir yetenek.
Dialogue: 0,0:02:04.80,0:02:08.44,Main,,0,0,0,,Şu Prenses Mansherry nasıl biri acaba?
Dialogue: 0,0:02:08.44,0:02:14.25,Main,,0,0,0,,Leo çok kaprisli, bencil ve çabuk kızan biri\Nolduğunu söylemişti sanırım.
Dialogue: 0,0:02:14.67,0:02:16.77,Main,,0,0,0,,Kimsin sen?!
Dialogue: 0,0:02:16.77,0:02:18.42,Main,,0,0,0,,Yapmayın dedim!
Dialogue: 0,0:02:19.56,0:02:21.55,Main,,0,0,0,,K-Kin'emon!
Dialogue: 0,0:02:21.55,0:02:24.46,Main,,0,0,0,,- Usopp-dono!\N- Tanışıyor musunuz?!
Dialogue: 0,0:02:24.46,0:02:26.50,Main,,0,0,0,,Evet, bırakabilirsiniz...
Dialogue: 0,0:02:27.76,0:02:29.55,Main,,0,0,0,,Oha bu acayip herif de kim?!
Dialogue: 0,0:02:29.55,0:02:34.13,Main,,0,0,0,,Aradığım kişi, Kanjuro bu.
Dialogue: 0,0:02:34.13,0:02:37.86,Main,,0,0,0,,Her an ölecekmiş gibi duran\No zavallı yaratık da neyin nesi?
Dialogue: 0,0:02:42.42,0:02:45.88,Main,,0,0,0,,Yüzeye ulaştığımızda epey şaşırdık.
Dialogue: 0,0:02:45.88,0:02:50.78,Main,,0,0,0,,Bür sürü kişi bu tepeye doğru geliyordu,\Nnedenini merak ettik.
Dialogue: 0,0:02:50.78,0:02:52.76,Main,,0,0,0,,Sahi ya!
Dialogue: 0,0:02:52.76,0:02:56.06,Main,,0,0,0,,Buraya kadar tırmanabileceklerini\Nsanmıyorum ama...
Dialogue: 0,0:02:56.06,0:03:00.73,Main,,0,0,0,,Endişelenme, uzun burunlu gulyabani genç!\NTırmanmada zorlandıklarını görünce...
Dialogue: 0,0:03:00.73,0:03:03.36,Main,,0,0,0,,...onlar için bir ağ yaptım!
Dialogue: 0,0:03:03.36,0:03:04.35,Main,,0,0,0,,Ne?
Dialogue: 0,0:03:05.76,0:03:08.40,Main,,0,0,0,,Her an burada olurlar.
Dialogue: 0,0:03:08.72,0:03:11.96,Main,,0,0,0,,Kafana göre niye böyle şeyler\Nyapıyorsun ki lan?!
Dialogue: 0,0:03:11.96,0:03:13.97,Main,,0,0,0,,Tanrı Usopp'u yakalayın!
Dialogue: 0,0:03:14.41,0:03:16.47,Main,,0,0,0,,Ne dandik ip bu böyle?!
Dialogue: 0,0:03:16.47,0:03:21.25,Main,,0,0,0,,- Beni öldürmeye geliyorlar!\N- Tamamen gereksizdi yani?!
Dialogue: 0,0:03:21.25,0:03:23.25,Main,,0,0,0,,Ne aptalım...
Dialogue: 0,0:03:23.89,0:03:27.31,Main,,0,0,0,,Büyük çam devirdim!\NKurtarıcımı yüzüstü bıraktım!
Dialogue: 0,0:03:27.31,0:03:30.29,Main,,0,0,0,,Pişmanlığımı kanıtlamak için\Nharakiri yapacağım!
Dialogue: 0,0:03:30.29,0:03:31.93,Main,,0,0,0,,Yapma Kanjuro!
Dialogue: 0,0:03:31.93,0:03:32.83,Main,,0,0,0,,Tamam, yapmam.
Dialogue: 0,0:03:32.83,0:03:34.33,Main,,0,0,0,,Kapa çeneni ve kes kendini!
Dialogue: 0,0:03:34.33,0:03:36.31,Main,,0,0,0,,Buraya yaklaşan insanlar konusunda\Nne yapacaksın?!
Dialogue: 0,0:03:37.30,0:03:38.47,Thoughts,,0,0,0,,{\i1}Acaba?!{\i0}
Dialogue: 0,0:03:39.60,0:03:42.98,Thoughts,,0,0,0,,{\i1}O odaya bakmadım!{\i0}
Dialogue: 0,0:03:49.67,0:03:53.66,Captions,,700,0,560,,Şu anki Konum:\Nİkinci Seviye
Dialogue: 0,0:03:49.67,0:03:53.66,Captions,,0,900,630,,Rebecca - Robin Ekibi
Dialogue: 0,0:03:57.22,0:04:00.47,Main,,0,0,0,,- Leo, duyabiliyor musun beni?\N- Evet, Viola-sama!
Dialogue: 0,0:04:00.47,0:04:02.42,Main,,0,0,0,,Prenses Mansherry'i buldum!
Dialogue: 0,0:04:02.42,0:04:06.39,Main,,0,0,0,,Sarayda!\NPrenses Mansherry sarayda!
Dialogue: 0,0:04:06.39,0:04:09.13,Main,,0,0,0,,{\i1}Çok sevindim!\NSarayın neresinde?{\i0}
Dialogue: 0,0:04:09.13,0:04:12.70,Main,,0,0,0,,Tapınağın arkasındaki o küçük odada.
Dialogue: 0,0:04:12.70,0:04:13.65,Main,,0,0,0,,Hatırladınız mı?
Dialogue: 0,0:04:14.07,0:04:15.61,Main,,0,0,0,,Küçük...
Dialogue: 0,0:04:16.37,0:04:17.59,Main,,0,0,0,,...oda mı?
Dialogue: 0,0:04:17.59,0:04:19.30,Main,,0,0,0,,Ceza odası!
Dialogue: 0,0:04:19.30,0:04:20.74,Main,,0,0,0,,Evet, orası!
Dialogue: 0,0:04:21.44,0:04:24.08,Main,,0,0,0,,Scarlet-sama'yı hatırladım birden.
Dialogue: 0,0:04:24.08,0:04:25.51,Main,,0,0,0,,Annemi mi?
Dialogue: 0,0:04:25.51,0:04:26.65,Main,,0,0,0,,Evet...
Dialogue: 0,0:04:27.37,0:04:30.76,Main,,0,0,0,,Saraya gittiğimizde...
Dialogue: 0,0:04:30.76,0:04:36.38,Main,,0,0,0,,...Viola-sama'yla beraber yaramazlık yapar\Nsonra da Kral Riku-sama'dan azar işitirdik!
Dialogue: 0,0:04:38.19,0:04:40.86,Main,,0,0,0,,- Abla!\N- Scarlet-sama!
Dialogue: 0,0:04:42.49,0:04:46.26,Main,,0,0,0,,Gene mi azar işittiniz?\NHiç akıllanmayacaksınız.
Dialogue: 0,0:04:46.26,0:04:50.02,Main,,0,0,0,,Benim suçum değil ki ama!\NTabağı Leolar kırdı!
Dialogue: 0,0:04:50.02,0:04:52.97,Main,,0,0,0,,Bize kırabilirsiniz dedin ama Viola-sama!
Dialogue: 0,0:04:52.97,0:04:56.48,Main,,0,0,0,,Hayır bir kere!\NDokunabilirsiniz demiştim!
Dialogue: 0,0:04:56.48,0:04:57.84,Main,,0,0,0,,Ne?!
Dialogue: 0,0:05:02.42,0:05:04.85,Main,,0,0,0,,Sonra beraber gidip özür dileriz.
Dialogue: 0,0:05:04.85,0:05:05.88,Main,,0,0,0,,Gerçekten mi?!
Dialogue: 0,0:05:06.44,0:05:08.89,Main,,0,0,0,,Evet.\NHem acıkmadınız mı siz?
Dialogue: 0,0:05:09.80,0:05:11.83,Main,,0,0,0,,Acıktık!
Dialogue: 0,0:05:13.28,0:05:19.10,Main,,0,0,0,,Scarlet-sama'yı hepimiz çok severdik.
Dialogue: 0,0:05:19.10,0:05:23.57,Main,,0,0,0,,Evet! Bize karşı hep çok kibar,\Nçok şefkatliydi...
Dialogue: 0,0:05:32.28,0:05:36.04,Main,,0,0,0,,Ceza odasını hâlâ\Nher ayrıntısıyla hatırlıyorum!
Dialogue: 0,0:05:36.04,0:05:37.72,Main,,0,0,0,,Bilgi için teşekkür ederim!
Dialogue: 0,0:05:37.72,0:05:40.67,Main,,0,0,0,,Saray artık düşmanın karargâhı.
Dialogue: 0,0:05:40.67,0:05:42.45,Main,,0,0,0,,Dikkatli olun, Leo!
Dialogue: 0,0:05:42.45,0:05:45.65,Main,,0,0,0,,Anlaşılmıştır!\NPrensesi ne pahasına olursa olsun kurtaracağız!
Dialogue: 0,0:05:54.05,0:05:55.70,Main,,0,0,0,,Bunlar...
Dialogue: 0,0:06:03.07,0:06:06.36,Main,,0,0,0,,Üçüncü Seviye'den geçiyoruz, Rebecca!
Dialogue: 0,0:06:06.36,0:06:09.55,Main,,0,0,0,,Ever, Robin-san!\NBir sonraki seviye Çiçek Bahçesi!
Dialogue: 0,0:06:11.74,0:06:13.94,Main,,0,0,0,,Aşağıdan bir şey yaklaşıyor!
Dialogue: 0,0:06:14.94,0:06:20.56,Main,,0,0,0,,{\i1}Hasır Şapkalar gerçekte\Nhayallerimin de ötesindeler yemin ederim!{\i0}
Dialogue: 0,0:06:25.66,0:06:27.43,Main,,0,0,0,,Horoz-kun, dikkatli ol!
Dialogue: 0,0:06:29.70,0:06:31.34,Main,,0,0,0,,{\fad(150,150)}Kalpazan Patlama!
Dialogue: 0,0:06:37.01,0:06:38.21,Main,,0,0,0,,Horoz-kun!
Dialogue: 0,0:06:41.35,0:06:44.26,Main,,0,0,0,,Pamu Pamu Meyvesi'nin gücü bu!
Dialogue: 0,0:06:46.78,0:06:50.22,Main,,0,0,0,,Olamaz!\NSarı Yavrular'ım...
Dialogue: 0,0:06:53.93,0:06:54.93,Main,,0,0,0,,Robin-san!
Dialogue: 0,0:06:55.32,0:06:59.42,Main,,0,0,0,,Saraya bu şekilde ulaşmaya çalışanların\Nolduğuna inanamıyorum!
Dialogue: 0,0:06:59.80,0:07:00.93,Main,,0,0,0,,Gladius bu!
Dialogue: 0,0:07:01.15,0:07:02.27,Main,,0,0,0,,{\fad(150,150)}Patlama...
Dialogue: 0,0:07:02.27,0:07:04.35,Main,,0,0,0,,{\fad(150,150)}Diez Fleurs!
Dialogue: 0,0:07:02.27,0:07:04.35,Note,,0,0,0,,On Çiçek!
Dialogue: 0,0:07:08.71,0:07:12.39,Main,,0,0,0,,Rebecca, anahtarı Çiçek Bahçesi'ne götür!
Dialogue: 0,0:07:12.39,0:07:14.21,Main,,0,0,0,,Bana bir şey olmaz!
Dialogue: 0,0:07:14.21,0:07:15.28,Main,,0,0,0,,Robin-san!
Dialogue: 0,0:07:21.22,0:07:23.74,Main,,0,0,0,,O oyuncaklar... Yoksa...
Dialogue: 0,0:07:27.32,0:07:30.53,Captions,,0,0,350,,{\fad(200,200)}Eski Kralın Platosu
Dialogue: 0,0:07:29.00,0:07:30.53,Main,,0,0,1,,Bu konuda eşit sorumluluğa sahipsiniz.
Dialogue: 0,0:07:31.00,0:07:32.03,Main,,0,0,0,,Bu...
Dialogue: 0,0:07:32.23,0:07:36.62,Main,,0,0,0,,Ne oldu? \NHâlâ aradığın bir şeyler mi var, Viola?
Dialogue: 0,0:07:36.62,0:07:38.24,Main,,0,0,0,,Sugar uyanmış!
Dialogue: 0,0:07:38.24,0:07:39.80,Main,,0,0,0,,Ne?!
Dialogue: 0,0:07:40.06,0:07:42.67,Main,,0,0,0,,Neden bahsediyorsun sen?!\NSugar...
Dialogue: 0,0:07:43.21,0:07:47.64,Main,,0,0,0,,...Özel Kutudaki Öd Patlatan Yüz saldırımla\Ntamamen kendinden geçmiş...
Dialogue: 0,0:07:48.02,0:07:51.02,Main,,0,0,0,,...ve en az üç gün\Nkendine gelemez halde yere devrilmişti.
Dialogue: 0,0:07:51.88,0:07:55.62,Main,,0,0,0,,Hasır Şapkalar\Nonun varlığından bihaberler, değil mi?!
Dialogue: 0,0:07:56.32,0:07:57.41,Main,,0,0,0,,Gücünü de bilmiyorlar.
Dialogue: 0,0:07:57.82,0:08:01.39,Main,,0,0,0,,Sugar tamamıyla iyileşmiş!\NHasır Şapkalar'ın başı dertte!
Dialogue: 0,0:08:01.59,0:08:03.20,Main,,0,0,0,,Ne?!
Dialogue: 0,0:08:04.70,0:08:07.65,Captions,,100,0,355,,{\fad(200,200)}Kraliyet Saray
Dialogue: 0,0:08:10.34,0:08:11.40,Main,,0,0,0,,Ne?
Dialogue: 0,0:08:14.10,0:08:20.65,Main,,0,0,0,,Bu-Burnu uzun olan hiç kimse yanıma yaklaşmasın!\NBurnu uzun olan herkes ölsün!
Dialogue: 0,0:08:20.65,0:08:24.70,Main,,0,0,0,,Aç olacağınızı düşünüp\Nsize bunları getirmiştim.
Dialogue: 0,0:08:27.68,0:08:29.64,Main,,0,0,0,,Sosis bunlar yahu.
Dialogue: 0,0:08:29.64,0:08:31.65,Main,,0,0,0,,Bana öyle uzun şeyler getirmeyin!
Dialogue: 0,0:08:31.65,0:08:34.64,Main,,0,0,0,,Getirecekseniz üzüm getirin!\NAptal mısınız siz?!
Dialogue: 0,0:08:35.63,0:08:39.70,Main,,0,0,0,,Kafakıran Bebeklere dönüşüp savaşın!
Dialogue: 0,0:08:44.22,0:08:46.68,Main,,0,0,0,,Genç Bey'e çok mahçubum.
Dialogue: 0,0:08:47.62,0:08:53.14,Main,,0,0,0,,Bu ülkedeki herkesi\Nyeniden oyuncağa çevireceğim!
Dialogue: 0,0:08:53.14,0:08:57.65,Main,,0,0,0,,İşe de şu iğrenç uzun burun ve\Ndostlarından başlayacağım!
Dialogue: 0,0:08:57.65,0:08:59.67,Main,,0,0,0,,Hasır Şapka Tayfası!
Dialogue: 0,0:08:59.67,0:09:06.00,Captions,,0,0,170,,{\fad(300,300)}Yeni Kralın Platosu - 3. Seviye
Dialogue: 0,0:08:59.67,0:09:06.00,Captions,,600,0,635,,{\fad(200,200)}Luffy'nin Ekibi
Dialogue: 0,0:09:08.29,0:09:10.56,Main,,0,0,0,,Eğil, Farul!
Dialogue: 0,0:09:11.58,0:09:12.60,Main,,0,0,0,,At!
Dialogue: 0,0:09:12.77,0:09:14.43,Main,,0,0,0,,Seni şerefsiz!
Dialogue: 0,0:09:14.59,0:09:17.15,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no Jet Tabanca!
Dialogue: 0,0:09:17.15,0:09:18.08,Main,,0,0,0,,Farul!
Dialogue: 0,0:09:20.51,0:09:21.81,Main,,0,0,0,,Dayan!
Dialogue: 0,0:09:22.02,0:09:25.07,Main,,0,0,0,,Ne güçlü çenesi varmış!\NKafasını parçalamış resmen!
Dialogue: 0,0:09:25.07,0:09:27.06,Main,,0,0,0,,Farul, ölme sakın!
Dialogue: 0,0:09:34.79,0:09:37.51,Main,,0,0,0,,Karnına delik bile açtım bunun be!
Dialogue: 0,0:09:37.51,0:09:39.89,Main,,0,0,0,,Lanet olası yaratık,\Nne cüretle Farul'uma bunu yaparsın?!
Dialogue: 0,0:09:40.06,0:09:42.58,Main,,0,0,0,,{\fad(150,150)}Güzellik Kılıcı!\NYuvarlak Masa!
Dialogue: 0,0:09:54.86,0:09:55.68,Main,,0,0,0,,Ne?!
Dialogue: 0,0:10:12.75,0:10:15.27,Main,,0,0,0,,Ölümsüz mü bunlar?!
Dialogue: 0,0:10:15.53,0:10:17.24,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:10:17.24,0:10:19.60,Main,,0,0,0,,...UFO!
Dialogue: 0,0:10:58.83,0:11:03.51,Main,,0,0,0,,Lanet olsun! Kelepçelerin anahtarı \Nbende olsaydı hepsinin işini bitirebilirdim!
Dialogue: 0,0:11:06.94,0:11:08.68,Main,,0,0,0,,Ne? Bir şey düşüyor sanki?
Dialogue: 0,0:11:09.28,0:11:10.30,Main,,0,0,0,,Acıdı be!
Dialogue: 0,0:11:12.42,0:11:13.82,Main,,0,0,0,,Dikkatsiz davrandım...
Dialogue: 0,0:11:13.82,0:11:17.42,Main,,0,0,0,,- İbik Kafa!\N- Bu ses... Luffy-senpai!
Dialogue: 0,0:11:17.42,0:11:18.97,Main,,0,0,0,,Robin!
Dialogue: 0,0:11:18.97,0:11:21.61,Main,,0,0,0,,Luffy! Trao-kun...\NBurada mıydınız?!
Dialogue: 0,0:11:21.61,0:11:25.00,Main,,0,0,0,,Nico-ya, anahtarlar nerede!\NVer hemen!
Dialogue: 0,0:11:26.28,0:11:27.33,Main,,0,0,0,,Kaçtı.
Dialogue: 0,0:11:29.10,0:11:31.90,Main,,0,0,0,,Ufacık bir kızın...
Dialogue: 0,0:11:32.12,0:11:36.16,Main,,0,0,0,,...saraya varsa bile\Nhiçbir şey yapamayacağını biliyorum gerçi.
Dialogue: 0,0:11:37.71,0:11:39.59,Main,,0,0,0,,Onu sonra yakalayıp öldürürüm artık.
Dialogue: 0,0:11:39.59,0:11:41.91,Main,,0,0,0,,Adım Gladius.
Dialogue: 0,0:11:42.56,0:11:44.84,Main,,0,0,0,,Önce sizin işinizi bitireceğim.
Dialogue: 0,0:11:46.52,0:11:47.80,Main,,0,0,0,,Burasını bana bırakın.
Dialogue: 0,0:11:47.80,0:11:49.12,Main,,0,0,0,,Aynen.
Dialogue: 0,0:11:49.12,0:11:50.18,Main,,0,0,0,,Ne?
Dialogue: 0,0:11:50.77,0:11:53.78,Main,,0,0,0,,Luffy, Trao-kun, Asker-san...
Dialogue: 0,0:11:53.78,0:11:56.81,Main,,0,0,0,,Siz derhal dördüncü kattaki\NÇiçek Bahçesi'ne gidin!
Dialogue: 0,0:11:56.81,0:11:58.03,Main,,0,0,0,,Evet!
Dialogue: 0,0:11:58.03,0:11:58.95,Main,,0,0,0,,Robin?!
Dialogue: 0,0:12:00.40,0:12:02.56,Main,,0,0,0,,Rebecca bekliyor!\NAcele edin!
Dialogue: 0,0:12:02.56,0:12:07.55,Captions,,0,30,390,,{\fad(200,200)}Dördüncü Seviye\NÇiçek Tarlası
Dialogue: 0,0:12:07.88,0:12:09.84,Main,,0,0,0,,Dördüncü seviyedeyiz. Geldik.
Dialogue: 0,0:12:09.84,0:12:13.11,Main,,0,0,0,,Robin-sanlar iyiler midir acaba?
Dialogue: 0,0:12:13.11,0:12:17.32,Main,,0,0,0,,İyilerdir merak etme.\NUsoland'ın dostları güçlüdür!
Dialogue: 0,0:12:18.30,0:12:20.12,Main,,0,0,0,,Haklısın sanırım!
Dialogue: 0,0:12:20.55,0:12:24.53,Main,,0,0,0,,Rebecca-sama, bizim çabucak Prenses\NMansherry'i kurtarmaya gitmemiz lazım!
Dialogue: 0,0:12:24.53,0:12:25.54,Main,,0,0,0,,Peki!
Dialogue: 0,0:12:25.54,0:12:27.96,Main,,0,0,0,,Yalnız kalabilecek misin?
Dialogue: 0,0:12:27.96,0:12:31.02,Main,,0,0,0,,Kalırım elbet.\NHem Lucyler de yakında gelirler zaten!
Dialogue: 0,0:12:31.02,0:12:32.50,Main,,0,0,0,,Gidip kurtarın prensesinizi!
Dialogue: 0,0:12:32.64,0:12:35.40,Main,,0,0,0,,Peki! \NSen de kendine dikkat et, Rebecca-sama!
Dialogue: 0,0:12:35.74,0:12:36.74,Main,,0,0,0,,Peki!
Dialogue: 0,0:12:49.19,0:12:53.02,Thoughts,,0,0,0,,{\i1}Babam da\Nbu savaş alanında bir yerlerde.{\i0}
Dialogue: 0,0:13:09.63,0:13:11.80,Main,,0,0,0,,Birileri gelmiş ha?
Dialogue: 0,0:13:16.20,0:13:18.61,Main,,0,0,0,,Kimleri görüyorum böyle!?
Dialogue: 0,0:13:21.82,0:13:23.72,Captions2,,0,360,575,,Kraliyet Sarayının \NYerleştirildiği Plato\N3. Seviye
Dialogue: 0,0:13:25.05,0:13:26.42,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:13:26.42,0:13:29.72,Main,,0,0,0,,- Luffy-senpai, ben halledeyim!\N- İbik Kafa!
Dialogue: 0,0:13:29.72,0:13:30.82,Main,,0,0,0,,{\fad(150,150)}Bariyer!
Dialogue: 0,0:13:37.53,0:13:42.00,Main,,0,0,0,,Patlayan toplar bunlar!\NGeri sektiremeden patlarlar!
Dialogue: 0,0:13:42.00,0:13:43.96,Main,,0,0,0,,Vay canına, harikaymış!
Dialogue: 0,0:13:45.59,0:13:50.00,Main,,0,0,0,,Böyle övgülere\Nlayık değilim ki ben ya!
Dialogue: 0,0:13:50.62,0:13:51.88,Main,,0,0,0,,Bartolomeo...
Dialogue: 0,0:13:52.04,0:13:54.71,Main,,0,0,0,,{\fad(150,150)}Bariyetenek\NMerdivenler!
Dialogue: 0,0:14:15.91,0:14:18.90,Main,,0,0,0,,Süpermiş!\NAcayip işe yarayacak bu!
Dialogue: 0,0:14:18.90,0:14:21.40,Main,,0,0,0,,Çekinmeden kullanın, Luffy-senpai!
Dialogue: 0,0:14:21.40,0:14:23.38,Main,,0,0,0,,Öbür tarafa niye bakıyorsun?
Dialogue: 0,0:14:23.38,0:14:24.74,Main,,0,0,0,,Teşekkür ederim, İbik Kafa!
Dialogue: 0,0:14:31.61,0:14:34.05,Main,,0,0,0,,Lafı olmaz!
Dialogue: 0,0:14:34.05,0:14:38.93,Main,,0,0,0,,Asıl bu dünyaya geldiğim için\Nbenim size teşekkür etmem lazım!
Dialogue: 0,0:14:38.93,0:14:39.96,Main,,0,0,0,,Pekâlâ öyleyse!
Dialogue: 0,0:14:40.49,0:14:43.83,Main,,0,0,0,,Doğrudan dördüncü seviyeye ulaşabiliriz şimdi! Gidiyoruz, Trao!
Dialogue: 0,0:14:43.83,0:14:44.90,Main,,0,0,0,,Koş!
Dialogue: 0,0:15:00.74,0:15:01.66,Main,,0,0,0,,Asker!
Dialogue: 0,0:15:01.66,0:15:02.85,Main,,0,0,0,,Ben önden gidiyorum!
Dialogue: 0,0:15:03.88,0:15:05.48,Main,,0,0,0,,Bekle, asker!
Dialogue: 0,0:15:08.48,0:15:09.15,Main,,0,0,0,,Kabak!
Dialogue: 0,0:15:09.15,0:15:13.09,Main,,0,0,0,,Ben onları burada tutarım,\Nacele et Hasır Şapka!
Dialogue: 0,0:15:13.63,0:15:16.60,Main,,0,0,0,,Canım atım bu katta kaldı!
Dialogue: 0,0:15:18.56,0:15:22.70,Main,,0,0,0,,Öcünü almadan\Nbir adım daha ilerleyemem!
Dialogue: 0,0:15:24.68,0:15:27.15,Main,,0,0,0,,Luffy dikkat et, bombalar!
Dialogue: 0,0:15:27.15,0:15:30.04,Main,,0,0,0,,Bana bırakın!
Dialogue: 0,0:15:31.67,0:15:33.34,Main,,0,0,0,,Bariyer kullansana!
Dialogue: 0,0:15:39.37,0:15:40.86,Main,,0,0,0,,Hey, Bartolomeo!
Dialogue: 0,0:15:43.48,0:15:49.20,Main,,0,0,0,,Tek seferde yapabileceğim bariyer sınırlı.
Dialogue: 0,0:15:49.70,0:15:52.69,Main,,0,0,0,,Hepsini merdivenlerde kullandım!
Dialogue: 0,0:15:57.29,0:15:59.70,Main,,0,0,0,,Ama böylesi âlâ.
Dialogue: 0,0:16:00.27,0:16:03.56,Main,,0,0,0,,Luffy-senpai'ye yardımcı olacaksa...
Dialogue: 0,0:16:04.94,0:16:08.32,Main,,0,0,0,,...gerekirse seve seve ölürüm de!
Dialogue: 0,0:16:09.22,0:16:11.60,Main,,0,0,0,,Ne biçim insansın...
Dialogue: 0,0:16:11.60,0:16:15.59,Main,,0,0,0,,Bariyerini yeniden yapabilene kadar\Nyanında savaşacağım, kalk hadi!
Dialogue: 0,0:16:20.22,0:16:22.19,Main,,0,0,0,,Bu oyuncaklarda zerre zarafet yok!
Dialogue: 0,0:16:23.27,0:16:25.23,Main,,0,0,0,,{\fad(150,150)}Beş El! \NŞaplak!
Dialogue: 0,0:16:31.42,0:16:34.81,Main,,0,0,0,,Neler hissettiğini anlayabiliyorum...
Dialogue: 0,0:16:34.81,0:16:35.87,Main,,0,0,0,,...Horoz-kun.
Dialogue: 0,0:16:41.80,0:16:43.61,Main,,0,0,0,,Kaptanımız...
Dialogue: 0,0:16:46.25,0:16:47.51,Main,,0,0,0,,...uğruna kendi canımızı bile...
Dialogue: 0,0:16:48.60,0:16:50.03,Main,,0,0,0,,...tehlikeye atmaya değer biri!
Dialogue: 0,0:17:15.58,0:17:19.82,Main,,0,0,0,,Luffy bizi zafere götüren\Ngizli kozumuz oldu hep!
Dialogue: 0,0:17:23.89,0:17:27.64,Main,,0,0,0,,{\fad(150,150)}Bin Çiçek!\NDevasa Kollar!
Dialogue: 0,0:17:47.01,0:17:49.37,Main,,0,0,0,,Luffy'nin kılına dahi dokunmana\Nmüsaade etmeyeceğim!
Dialogue: 0,0:17:49.60,0:17:50.74,Main,,0,0,0,,Aynen öyle!
Dialogue: 0,0:17:50.84,0:17:55.85,Captions,,0,0,420,,{\fad(200,200)}Acacia Şehri\NSabo, Amiral Fujitora'ya Karşı
Dialogue: 0,0:17:56.86,0:17:58.47,Main,,0,0,0,,Tuhaf birisin.
Dialogue: 0,0:17:58.47,0:18:03.04,Main,,0,0,0,,Amacın Donanma'yı burada tutmak değil miydi?
Dialogue: 0,0:18:03.04,0:18:06.07,Main,,0,0,0,,Bu oyunu daha ne kadar sürdüreceksin?
Dialogue: 0,0:18:06.07,0:18:08.46,Main,,0,0,0,,Tüh...
Dialogue: 0,0:18:08.46,0:18:14.68,Main,,0,0,0,,Senin de görebileceğin gibi insanların bana\Nbiraz olsun taviz vermeleri gerekiyor...
Dialogue: 0,0:18:15.01,0:18:17.12,Main,,0,0,0,,Kimseye ayrıcalık yapmam.
Dialogue: 0,0:18:17.55,0:18:19.45,Main,,0,0,0,,Korkutuyorsun beni.
Dialogue: 0,0:18:19.45,0:18:23.68,Main,,0,0,0,,Boş yere Devrim Ordusu'nun\Niki numarası olarak anılmıyorsun anlaşılan.
Dialogue: 0,0:18:23.68,0:18:28.05,Main,,0,0,0,,Fakat ben de bunu yapmamı gerektiren\Nbir pozisyondayım.
Dialogue: 0,0:18:28.05,0:18:30.65,Main,,0,0,0,,Anla lütfen.
Dialogue: 0,0:18:31.39,0:18:32.76,Main,,0,0,0,,{\fad(150,150)}Yerçekimi Kılıcı!
Dialogue: 0,0:18:39.13,0:18:40.61,Main,,0,0,0,,{\fad(150,150)}Öfkeli Kaplan!
Dialogue: 0,0:18:53.24,0:18:55.22,Main,,0,0,0,,{\i1}Yatay yerçekimi mi?!{\i0}
Dialogue: 0,0:18:58.95,0:19:02.37,Main,,0,0,0,,Yapacak bir şey yok.\NBu kadarını beklemek lazımdı!
Dialogue: 0,0:19:04.04,0:19:06.92,Main,,0,0,0,,{\i1}Ne saklıyor?!{\i0}
Dialogue: 0,0:19:22.43,0:19:25.88,Main,,0,0,0,,Ya batacağım\Nya da çıkacağım bir kumar bu.
Dialogue: 0,0:19:25.88,0:19:30.51,Main,,0,0,0,,Bu uğurda kellemi ortaya koymaya\Nhazırım ben.
Dialogue: 0,0:19:31.26,0:19:31.98,Main,,0,0,0,,Fakat...
Dialogue: 0,0:19:32.88,0:19:38.98,Main,,0,0,0,,...daha zarları atamadan\Nonları kaybedersen oyun biter.
Dialogue: 0,0:19:39.75,0:19:43.60,Captions,,0,0,240,,{\fad(100,0)}Kraliyet Sarayı'nın Bulunduğu Plato\N4. Seviye\NÇiçek Tarlası
Dialogue: 0,0:19:48.69,0:19:51.07,Main,,0,0,0,,Rezilsin, Rebecca!
Dialogue: 0,0:19:51.60,0:19:54.21,Main,,0,0,0,,Ne oldu?!\NNeden kaçıyorsun?
Dialogue: 0,0:19:54.44,0:19:56.77,Main,,0,0,0,,Savaşsana!
Dialogue: 0,0:19:57.01,0:19:59.28,Main,,0,0,0,,Gladyatör değil misin sen?!
Dialogue: 0,0:19:59.28,0:20:02.78,Main,,0,0,0,,Beni öldürmeye gelmemiş miydin?!
Dialogue: 0,0:20:02.78,0:20:07.75,Main,,0,0,0,,Kolezyum'da sayende çok güzel\Ngösteriler sundum sunmasına ama...
Dialogue: 0,0:20:09.16,0:20:11.59,Main,,0,0,0,,...savaşmayacaksan...
Dialogue: 0,0:20:12.09,0:20:14.48,Main,,0,0,0,,...miadını doldurmuşsun demektir!
Dialogue: 0,0:20:39.70,0:20:43.70,Main,,0,0,0,,İşini bitireceğim.
Dialogue: 0,0:20:44.71,0:20:47.76,Main,,0,0,0,,Sahi bak!
Dialogue: 0,0:20:48.72,0:20:52.13,Main,,0,0,0,,Muhtemelen silah tercih edersin sen.
Dialogue: 0,0:20:52.70,0:20:55.15,Main,,0,0,0,,Scarlet de...
Dialogue: 0,0:20:56.93,0:20:59.40,Main,,0,0,0,,...silahla can vermişti!
Dialogue: 0,0:21:00.90,0:21:02.00,Main,,0,0,0,,{\i1}Yardım et!{\i0}
Dialogue: 0,0:21:03.69,0:21:06.74,Main,,0,0,0,,Asker-san!
Dialogue: 0,0:21:08.23,0:21:10.15,Main,,0,0,0,,Rebecca!!
Dialogue: 0,0:21:15.12,0:21:16.65,Main,,0,0,0,,Sen...
Dialogue: 0,0:21:18.82,0:21:19.82,Main,,0,0,0,,Kyros!
Dialogue: 0,0:21:22.69,0:21:24.76,Main,,0,0,0,,Ailemden başka birini daha...
Dialogue: 0,0:21:25.01,0:21:27.68,Main,,0,0,0,,...kopartıp almana izin vermem!
Dialogue: 0,0:21:29.78,0:21:32.90,Flashbacks,,0,0,0,,{\i1}Efsane biri o.{\i0}
Dialogue: 0,0:21:33.53,0:21:36.86,Flashbacks,,0,0,0,,Kolezyum tarihindeki en güçlü savaşçı.
Dialogue: 0,0:21:53.12,0:21:55.94,Flashbacks,,0,0,0,,Anneni koruyamadım belki fakat...
Dialogue: 0,0:21:55.94,0:21:59.63,Flashbacks,,0,0,0,,...hayatım pahasına da olsa\Nseni koruyacağım!
Dialogue: 0,0:22:00.43,0:22:01.90,Flashbacks,,0,0,0,,Nasıl savaşılacağını öğreteceğim.
Dialogue: 0,0:22:02.57,0:22:04.18,Flashbacks,,0,0,0,,Rebecca!
Dialogue: 0,0:22:10.75,0:22:12.34,Thoughts,,0,0,0,,{\i1}Baba...{\i0}
Dialogue: 0,0:22:12.34,0:22:14.80,Main,,0,0,0,,Özür dilerim, Rebecca.
Dialogue: 0,0:22:15.54,0:22:18.01,Main,,0,0,0,,Geleceği olmayan bir oyuncak olarak...
Dialogue: 0,0:22:18.61,0:22:21.52,Main,,0,0,0,,...elimden gelen tek şey\Nsana savaşmayı öğretmekti.
Dialogue: 0,0:22:22.35,0:22:26.06,Main,,0,0,0,,Annen gibi çok iyi kalpli\Nbiri olmana rağmen hem de!
Dialogue: 0,0:22:29.11,0:22:30.80,Main,,0,0,0,,Ama bitti artık!
Dialogue: 0,0:22:32.93,0:22:34.42,Main,,0,0,0,,Artık...
Dialogue: 0,0:22:35.03,0:22:37.41,Main,,0,0,0,,...savaşmana gerek yok.
Dialogue: 0,0:22:41.53,0:22:44.12,Main,,0,0,0,,Pe-Peki!\NPeki!
Dialogue: 0,0:22:44.12,0:22:45.51,Main,,0,0,0,,Peki!
Dialogue: 0,0:22:45.51,0:22:50.11,Main,,0,0,0,,O da ne demekmiş öyle, Kyros?!
Dialogue: 0,0:22:50.11,0:22:52.45,Main,,0,0,0,,Bugün hepinizin de...
Dialogue: 0,0:22:52.45,0:22:55.19,Main,,0,0,0,,...kökünü kazıyacağım demek!
Dialogue: 0,0:23:06.53,0:23:07.90,Main,,0,0,0,,Hayvan seni!
Dialogue: 0,0:23:13.56,0:23:15.94,Main,,0,0,0,,Rebecca!
Dialogue: 0,0:23:19.57,0:23:20.98,Main,,0,0,0,,Bu ses...
Dialogue: 0,0:23:28.42,0:23:31.13,Main,,0,0,0,,Rebecca!!
Dialogue: 0,0:23:31.81,0:23:33.96,Main,,0,0,0,,Lucy!
Dialogue: 0,0:23:38.93,0:23:41.50,Main,,0,0,0,,Rebecca!!
Dialogue: 0,0:23:42.98,0:23:44.57,Main,,0,0,0,,Anahtar!
Dialogue: 0,0:23:45.08,0:23:46.07,Main,,0,0,0,,Lucy!
Dialogue: 0,0:23:47.10,0:23:49.39,Main,,0,0,0,,Sonunda buluşabildik!
Dialogue: 0,0:24:00.54,0:24:01.99,Main,,0,0,0,,Anahtar dedim!
Dialogue: 0,0:24:02.39,0:24:04.79,Main,,0,0,0,,Çabuk!
Dialogue: 0,0:24:06.40,0:24:07.18,Main,,0,0,0,,Burada!
Dialogue: 0,0:24:11.80,0:24:12.76,Main,,0,0,0,,Acele et!
Dialogue: 0,0:24:13.17,0:24:15.24,Main,,0,0,0,,Rebecca!
Dialogue: 0,0:24:56.69,0:24:58.18,Main,,0,0,0,,Sizi adiler!
Dialogue: 0,0:25:00.48,0:25:02.38,Main,,0,0,0,,Sonunda yetiştik!
Dialogue: 0,0:25:02.38,0:25:04.84,Main,,0,0,0,,Sonunda özgürüm!
Dialogue: 0,0:25:07.43,0:25:10.83,Main,,0,0,0,,Mingo'nun bulunduğu dördüncü seviyeye vardık sonunda!
Dialogue: 0,0:25:10.83,0:25:13.17,Main,,0,0,0,,Orada oturuyor demek?
Dialogue: 0,0:25:13.17,0:25:14.39,Main,,0,0,0,,Evet.
Dialogue: 0,0:25:14.39,0:25:16.92,Main,,0,0,0,,Law! Hasır Şapka!
Dialogue: 0,0:25:16.92,0:25:18.13,Main,,0,0,0,,Diamante.
Dialogue: 0,0:25:24.31,0:25:29.11,Main,,0,0,0,,Kusura bakmayın...\NŞu anda bununla ellerim dolu.
Dialogue: 0,0:25:30.85,0:25:34.08,Main,,0,0,0,,Doflamingo'yu size bırakabilir miyim?!
Dialogue: 0,0:25:34.94,0:25:36.26,Main,,0,0,0,,Oldu bil!
