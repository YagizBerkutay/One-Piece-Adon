Dialogue: 0,0:01:44.25,0:01:51.76,Captions,,0,0,0,,{\fad(570,0)\pos(640,547)}Dressrosa'nın Güney Kıyısı
Dialogue: 0,0:01:45.23,0:01:50.93,Narrator,,0,0,0,,{\i1}Hasır Şapka Tayfası ve Donquixote Ailesi\Nsavaşının sonuçlanmasından üç gün sonra...{\i0}
Dialogue: 0,0:01:59.52,0:02:03.00,Main,,0,0,0,,Hasır Şapkalı Luffy\Nhâlâ bu ülkede mi?
Dialogue: 0,0:02:03.72,0:02:07.53,Main,,0,0,0,,Evet. Burada olduğunu onayladık.\NAğır yaralı.
Dialogue: 0,0:02:07.53,0:02:08.60,Main,,0,0,0,,Anlıyorum.
Dialogue: 0,0:02:10.19,0:02:14.30,Title,,0,0,250,,{\fad(800,800)}Asker-san'ın Kararı
Dialogue: 0,0:02:17.84,0:02:20.03,Main,,0,0,3,,Issho, diz çöküp özür dilemeni...
Dialogue: 0,0:02:18.07,0:02:22.41,Captions,,0,0,240,,{\fad(780,0)}Donanma Karargâhı Genel Müfettiş\N"Buda" Sengoku
Dialogue: 0,0:02:20.03,0:02:22.41,Main,,0,0,3,,...ve Sakazuki'yle yaşadıklarını duydum!
Dialogue: 0,0:02:24.05,0:02:26.45,Main,,0,0,0,,İyi ki artık\NFilo Amirali ben değilim!
Dialogue: 0,0:02:26.76,0:02:29.20,Main,,0,0,1,,Kes sesini, içi dışı pirinç krakeri moruk!
Dialogue: 0,0:02:28.38,0:02:32.19,Captions,,0,0,0,,{\fad(640,0)\pos(640,484)}Donanma Karargâhı Koramiral\N"Büyük Kurmay" Tsuru
Dialogue: 0,0:02:29.20,0:02:32.13,Main,,0,0,0,,{\an8}Müfettiş olmak ne hoş,\Nsorumluluktan eser yok!
Dialogue: 0,0:02:32.47,0:02:36.21,Main,,0,0,0,,Amiral Fujitora,\Nkorsanı neden yakalamıyorsun?
Dialogue: 0,0:02:36.70,0:02:39.26,Main,,0,0,0,,Hasır Şapka'nın yerini\Nbiliyorsun değil mi?
Dialogue: 0,0:02:41.52,0:02:45.10,Main,,0,0,0,,"Ülkeyi kurtarmış ağır yaralı korsan."
Dialogue: 0,0:02:45.10,0:02:48.64,Main,,0,0,0,,Onu düşman yerine mi koymalıyım?
Dialogue: 0,0:02:49.18,0:02:52.52,Main,,0,0,0,,Yoksa ülkenin kahramanıdır deyip\Ngitmesine izin mi vermeliyim?
Dialogue: 0,0:02:52.52,0:02:56.23,Main,,0,0,0,,Karar veremiyorum.
Dialogue: 0,0:02:59.88,0:03:01.17,Main,,0,0,0,,Zar mı o?!
Dialogue: 0,0:03:04.64,0:03:06.48,Main,,0,0,0,,Gülünecek bir şey yok!
Dialogue: 0,0:03:10.51,0:03:11.87,Main,,0,0,0,,Zar çıkardı...
Dialogue: 0,0:03:12.99,0:03:14.97,Main,,0,0,0,,Yeter dedim!
Dialogue: 0,0:03:14.97,0:03:16.30,Main,,0,0,0,,Korktum şimdi bak.
Dialogue: 0,0:03:16.75,0:03:17.99,Main,,0,0,0,,Cidden yani!
Dialogue: 0,0:03:17.99,0:03:20.51,Main,,0,0,0,,Peşine düşüp düşmeyeceğine\Nböyle mi karar veriyorsun?!
Dialogue: 0,0:03:20.86,0:03:23.14,Main,,0,0,0,,Fakat Tsuru-san...
Dialogue: 0,0:03:23.56,0:03:26.07,Main,,0,0,0,,Sıradan biri olsaydı...
Dialogue: 0,0:03:26.07,0:03:29.10,Main,,0,0,0,,...iki gün arkası arkasına\Nbu zar onun hayatını kurtarır mıydı?
Dialogue: 0,0:03:29.52,0:03:33.58,Main,,0,0,0,,Bugün üçüncü gün.\NHile yapmıyorum.
Dialogue: 0,0:03:38.44,0:03:40.80,Main,,0,0,0,,Bana da soba eriştesi getirin!
Dialogue: 0,0:03:40.80,0:03:42.61,Main,,0,0,0,,Emredersiniz!\NHemen getiriyorum!
Dialogue: 0,0:03:43.06,0:03:46.96,Main,,0,0,0,,Gökçe Şeytan'ın nakli hususundaki\Nyardımlarınız için teşekkür ederim.
Dialogue: 0,0:03:46.96,0:03:50.12,Main,,0,0,0,,Fakat burada yetki hâlâ bende.
Dialogue: 0,0:03:52.88,0:03:55.21,Main,,0,0,0,,İşleri kendi yolumla\Nhalletmek isterim.
Dialogue: 0,0:03:55.57,0:04:02.82,Main,,0,0,0,,Pekâlâ fakat Donanma olarak üzerinde ödül olan bir korsanı sonsuza dek görmezden gelemeyiz.
Dialogue: 0,0:04:02.82,0:04:05.05,Main,,0,0,0,,Karahindiba bağışçısı olun lütfen!
Dialogue: 0,0:04:05.34,0:04:09.18,Main,,0,0,0,,Donanma halkı!\NLütfen karahindiba bağışçısı olun!
Dialogue: 0,0:04:09.54,0:04:12.23,Main,,0,0,0,,Bugün de geldin demek?
Dialogue: 0,0:04:12.23,0:04:12.85,Main,,0,0,0,,Evet!
Dialogue: 0,0:04:13.21,0:04:15.58,Main,,0,0,0,,Ay ne şirin bir kız!
Dialogue: 0,0:04:19.73,0:04:21.46,Main,,0,0,0,,Küçük İnsanlar'dansın değil mi?
Dialogue: 0,0:04:23.24,0:04:26.75,Main,,0,0,0,,Tontatta Kabilesi'nden\NMansherry benim adım!
Dialogue: 0,0:04:27.98,0:04:29.62,Main,,0,0,0,,Çok şirin!
Dialogue: 0,0:04:32.70,0:04:34.37,Main,,0,0,0,,İşte bunu her gün görmüyor insan...
Dialogue: 0,0:04:35.67,0:04:38.13,Main,,0,0,0,,Ne oldu?!
Dialogue: 0,0:04:38.58,0:04:41.01,Main,,0,0,0,,Saygısızlık etmeyin!
Dialogue: 0,0:04:41.01,0:04:44.69,Main,,0,0,0,,Prenses Mansherry Şef Tonta'nın kızıdır!
Dialogue: 0,0:04:44.69,0:04:46.49,Main,,0,0,0,,Prenses olur kendisi!
Dialogue: 0,0:04:46.49,0:04:48.70,Main,,0,0,0,,Önünde başınızı eğin!
Dialogue: 0,0:04:48.70,0:04:50.60,Main,,0,0,0,,Önemli değil, Mauji.
Dialogue: 0,0:04:50.86,0:04:53.43,Main,,0,0,0,,Ne bağışlayıcı biri!
Dialogue: 0,0:04:53.83,0:04:57.31,Main,,0,0,0,,İşin aslı Dressrosa'da kendimizi...
Dialogue: 0,0:04:57.31,0:05:01.07,Main,,0,0,0,,...kraliyet ailesi harici\Nkimseye göstermememiz lazım.
Dialogue: 0,0:05:01.07,0:05:05.56,Main,,0,0,0,,Ben de kimselere görünmeden herkesin\Nyaralarını iyileştireyim demiştim...
Dialogue: 0,0:05:05.56,0:05:06.78,Main,,0,0,0,,Nasıl olacakmış o?
Dialogue: 0,0:05:10.93,0:05:17.56,Captions,,0,0,175,,{\fad(700,0)}Şehir Merkezi
Dialogue: 0,0:05:12.50,0:05:13.78,Main,,0,0,3,,Sonunda!
Dialogue: 0,0:05:13.78,0:05:16.36,Main,,0,0,3,,Evet, bu anın gelmesini bekliyordum!
Dialogue: 0,0:05:16.36,0:05:17.54,Main,,0,0,3,,Ben de öyle!
Dialogue: 0,0:05:17.92,0:05:20.24,Main,,0,0,0,,Hadi, Gyats!
Dialogue: 0,0:05:20.24,0:05:21.63,Main,,0,0,0,,Gyats!
Dialogue: 0,0:05:22.07,0:05:25.61,Main,,0,0,0,,Baylar bayanlar!
Dialogue: 0,0:05:25.61,0:05:28.89,Main,,0,0,0,,Hayallerimizin gerçekleşeceği gün\Nsonunda geldi çattı!
Dialogue: 0,0:05:31.14,0:05:36.14,Main,,0,0,0,,Bugün, sonunda, kral geri dönüyor!
Dialogue: 0,0:05:38.31,0:05:45.07,Main,,0,0,0,,Evet! On yılın ardından\NKral Riku-sama...
Dialogue: 0,0:05:45.07,0:05:47.61,Main,,0,0,0,,...tahta dönüşünü açıklayacak!
Dialogue: 0,0:05:51.56,0:06:06.01,Main,,0,0,0,,Kral Riku!!
Dialogue: 0,0:06:07.29,0:06:09.09,Main,,0,0,0,,Tüm ülke heyecanlı.
Dialogue: 0,0:06:09.44,0:06:13.39,Main,,0,0,0,,Korsanın teki tarafından kandırılıp,\Nkrallarına nefret beslediler...
Dialogue: 0,0:06:13.39,0:06:18.06,Main,,0,0,0,,...hatta bir noktada zenginlik\Nve şiddeti bile desteklediler...
Dialogue: 0,0:06:18.06,0:06:20.15,Main,,0,0,0,,...fakat yaşadıkları ölüm korkusu...
Dialogue: 0,0:06:20.54,0:06:23.86,Main,,0,0,0,,...hepsinin de canı pahasına\Nhuzur dolu bir ülke arzulamasını sağladı.
Dialogue: 0,0:06:26.87,0:06:30.05,Main,,0,0,0,,Gülemediğim bir şaka gibi adeta.
Dialogue: 0,0:06:30.05,0:06:35.31,Main,,0,0,0,,Kimse gülemez!\NHayatta kaldıklarına çok seviniyorum!
Dialogue: 0,0:06:37.73,0:06:42.46,Main,,0,0,0,,Onları mutlu edebilecek miyim?
Dialogue: 0,0:06:58.19,0:07:04.19,Main,,0,0,0,,Doğal afetleri bile savuşturabilecek\Ntanrı misali bir kral olmayı dilerdim...
Dialogue: 0,0:07:04.58,0:07:07.65,Main,,0,0,0,,Böyle tehlikeli şeyler söyleme!
Dialogue: 0,0:07:08.86,0:07:09.95,Main,,0,0,0,,Şaka yapıyorum.
Dialogue: 0,0:07:12.26,0:07:17.02,Main,,0,0,0,,Tüm gücümüzle çalışmaya devam edeceğiz...\NElimizden başka ne gelir ki?
Dialogue: 0,0:07:19.45,0:07:20.77,Main,,0,0,0,,Haklısın.
Dialogue: 0,0:07:22.49,0:07:27.51,Main,,0,0,0,,Rebecca tahtı devralana dek...
Dialogue: 0,0:07:34.33,0:07:37.47,Main,,0,0,0,,O konuda her şeyin\Nyolunda gideceğine emin misin?
Dialogue: 0,0:07:39.06,0:07:44.06,Main,,0,0,0,,Küçükken Scarlet'in ne kadar\Ninatçı olduğunu hatırlıyorum.
Dialogue: 0,0:07:45.03,0:07:47.70,Main,,0,0,0,,Rebecca'nın da annesi gibi yine...
Dialogue: 0,0:07:48.60,0:07:50.36,Main,,0,0,0,,Nasıl yani?!
Dialogue: 0,0:07:50.47,0:07:55.18,Captions,,980,0,275,,{\fad(250,250)}Sarayın İçi
Dialogue: 0,0:08:00.81,0:08:02.83,Main,,0,0,0,,İşte, hazırsın!
Dialogue: 0,0:08:02.83,0:08:04.77,Main,,0,0,0,,Ay ne şirin oldun!
Dialogue: 0,0:08:04.77,0:08:08.07,Main,,0,0,0,,Kız kimisine zırh değil\Nelbise daha çok yakışıyor elbet!
Dialogue: 0,0:08:08.07,0:08:09.46,Main,,0,0,0,,Öyle mi dersiniz?
Dialogue: 0,0:08:09.46,0:08:12.38,Main,,0,0,0,,Çok yakıştı Rebecca-sama!
Dialogue: 0,0:08:12.38,0:08:13.62,Main,,0,0,0,,Teşekkür ederim.
Dialogue: 0,0:08:13.62,0:08:18.10,Main,,0,0,0,,O elbiseyi giyince\Naynı Scarlet-sama gibi oldunuz!
Dialogue: 0,0:08:20.02,0:08:22.69,Main,,0,0,0,,Evet, babanı da duyduk bu arada!
Dialogue: 0,0:08:24.82,0:08:31.69,Main,,0,0,0,,Scarlet-sama uzak bir ülkenin\Nprensine kaçmış.
Dialogue: 0,0:08:31.69,0:08:37.28,Main,,0,0,0,,Ondan sonra da Kral Riku-sama'nın, \Nöldüğünü açıklamaktan başka seçeneği kalmamış.
Dialogue: 0,0:08:39.03,0:08:41.53,Main,,0,0,0,,Ay aynı aşk romanlarındaki gibi!
Dialogue: 0,0:08:41.53,0:08:43.10,Main,,0,0,0,,Ben de isterdim!
Dialogue: 0,0:08:49.63,0:08:51.65,Captions,,0,0,175,,{\fad(520,0)}Şehir Merkezi
Dialogue: 0,0:08:53.92,0:08:56.14,Main,,0,0,0,,Prens nereliymiş?
Dialogue: 0,0:08:56.46,0:09:01.43,Main,,0,0,0,,Çok güzel gölleri olan\Nbereketli bir ülkedenmiş.
Dialogue: 0,0:09:02.45,0:09:05.29,Main,,0,0,0,,Fakat ülke savaştaymış.
Dialogue: 0,0:09:06.43,0:09:11.28,Main,,0,0,0,,Yani aşık olmaması gereken bir kişiye\Naşık olup Rebecca'yı dünyaya getirmiş.
Dialogue: 0,0:09:11.28,0:09:12.56,Main,,0,0,0,,Hadi ya?
Dialogue: 0,0:09:13.68,0:09:18.50,Main,,0,0,0,,Fakat ne acıdır ki\Nprens savaşta ölünce...
Dialogue: 0,0:09:18.50,0:09:23.18,Main,,0,0,0,,...Scarlet-sama'ya Rebecca...\Nyani Rebecca-sama yalnız kalmışlar...
Dialogue: 0,0:09:23.18,0:09:25.66,Main,,0,0,0,,...ve sessizce\Nbu ülkede yaşıyorlarmış.
Dialogue: 0,0:09:25.94,0:09:30.22,Main,,0,0,0,,Anlıyorum.\NDamarlarında asil kan akıyor yani.
Dialogue: 0,0:09:31.53,0:09:33.78,Main,,0,0,0,,Ne tuhaf bir söylenti.
Dialogue: 0,0:09:33.78,0:09:37.07,Main,,0,0,0,,Rebecca-dono'nun babası\NKyros-dono değil miydi?
Dialogue: 0,0:09:37.07,0:09:40.37,Main,,0,0,0,,Bilmiyorum.\NMarul yer misin?
Dialogue: 0,0:09:40.37,0:09:41.22,Main,,0,0,0,,Yok sağ ol.
Dialogue: 0,0:09:44.67,0:09:49.86,Thoughts,,0,0,0,,{\i1}Asker-san cesur mu cesur...{\i0}
Dialogue: 0,0:09:49.86,0:09:54.99,Thoughts,,0,0,0,,{\i1}Olacak hep yanı başında...{\i0}
Dialogue: 0,0:10:03.45,0:10:05.08,Main,,0,0,0,,{\blur0.5\fax0.33\frx356\fry6\pos(965.953,649.618)\frz35.58}Asker-san
Dialogue: 0,0:10:05.08,0:10:05.21,Main,,0,0,0,,{\blur0.5\fax0.33\frx356\fry6\pos(965.953,649.618)\frz35.58\iclip(m 952 506 l 972 528 938 537 928 513)}Asker-san
Dialogue: 0,0:10:05.21,0:10:05.33,Main,,0,0,0,,{\blur0.5\fax0.33\frx356\fry6\pos(965.953,649.618)\frz35.58\iclip(m 952 506 l 974 530 950 547 921 557 901 532 928 519)}Asker-san
Dialogue: 0,0:10:05.33,0:10:05.83,Main,,0,0,0,,{\blur0.5\fax0.33\frx356\fry6\pos(965.953,649.618)\frz35.58\iclip(m 952 496 l 976 527 943 555 916 566 853 590 841 556)}Asker-san
Dialogue: 0,0:10:05.83,0:10:05.96,Main,,0,0,0,,{\blur0.5\fax0.33\frx356\fry6\frz35.58\iclip(m 952 496 l 976 527 943 555 916 566 853 590 841 556)\pos(964.81,653.047)}Asker-san
Dialogue: 0,0:10:05.96,0:10:06.08,Main,,0,0,0,,{\blur0.5\fax0.33\frx356\fry6\frz35.58\iclip(m 952 496 l 976 527 943 555 916 566 853 590 841 556)\pos(961.381,657.618)}Asker-san
Dialogue: 0,0:10:06.08,0:10:06.21,Main,,0,0,0,,{\blur0.5\fax0.33\frx356\fry6\frz35.58\iclip(m 952 496 l 976 527 943 555 916 566 853 590 841 556)\pos(960.238,658.761)}Asker-san
Dialogue: 0,0:10:06.21,0:10:06.33,Main,,0,0,0,,{\blur0.5\fax0.33\frx356\fry6\frz35.58\iclip(m 952 496 l 976 527 943 555 916 566 853 590 841 556)\pos(959.095,662.19)}Asker-san
Dialogue: 0,0:10:06.33,0:10:06.46,Main,,0,0,0,,{\blur0.5\fax0.33\frx356\fry6\frz35.58\iclip(m 952 496 l 976 527 943 555 916 566 853 590 841 556)\pos(957.952,665.619)}Asker-san
Dialogue: 0,0:10:06.46,0:10:07.29,Main,,0,0,0,,{\blur0.5\fax0.33\frx356\fry6\frz35.58\iclip(m 952 496 l 976 527 943 555 916 566 853 590 841 556)\pos(955.666,666.762)}Asker-san
Dialogue: 0,0:10:11.62,0:10:13.05,Main,,0,0,0,,Yaşasın!
Dialogue: 0,0:10:17.99,0:10:21.22,Main,,0,0,0,,Mansherry-dono'nun\Niyileştirici çiçeklerini dağıtıyorlar!
Dialogue: 0,0:10:21.62,0:10:24.89,Main,,0,0,0,,O şeyler harika! Bugün de\Ninsanlara yardım edecekler!
Dialogue: 0,0:10:25.55,0:10:27.79,Main,,0,0,0,,Sıraya girin.
Dialogue: 0,0:10:27.79,0:10:28.98,Main,,0,0,0,,Herkese bir tane.
Dialogue: 0,0:10:29.32,0:10:30.45,Main,,0,0,0,,Teşekkür ederim.
Dialogue: 0,0:10:30.45,0:10:34.80,Main,,0,0,0,,Bu ilaç çok işe yarıyor.\NYaraları hemencecik iyileştiriyor!
Dialogue: 0,0:10:37.03,0:10:38.43,Main,,0,0,0,,Al bakalım.
Dialogue: 0,0:10:38.43,0:10:39.36,Main,,0,0,0,,Teşekkür ederim!
Dialogue: 0,0:10:41.03,0:10:43.66,Main,,0,0,0,,Baba, getirdim!
Dialogue: 0,0:10:43.66,0:10:46.09,Main,,0,0,0,,Kafamdaki yarayı\Niyileştirmek için kullanayım bunu.
Dialogue: 0,0:10:53.19,0:10:55.23,Main,,0,0,0,,Vay canına! Hemencecik iyileşti!
Dialogue: 0,0:10:55.23,0:10:56.42,Main,,0,0,0,,Büyü gibi!
Dialogue: 0,0:10:57.59,0:10:59.28,Main,,0,0,0,,Harika bir ilaç!
Dialogue: 0,0:11:04.47,0:11:07.16,Captions,,0,0,180,,{\fad(520,0)}Donanma Kampı
Dialogue: 0,0:11:23.26,0:11:24.30,Main,,0,0,0,,Al.
Dialogue: 0,0:11:24.30,0:11:24.95,Main,,0,0,0,,Tamamdır.
Dialogue: 0,0:11:28.01,0:11:29.21,Main,,0,0,0,,Teşekkür ederim!
Dialogue: 0,0:11:29.49,0:11:30.75,Main,,0,0,0,,Çok şirin ya!
Dialogue: 0,0:11:30.75,0:11:35.59,Main,,0,0,0,,Aynı kan bağışlar gibi iyileşme özelliğimizi\Nbağışlayabiliyoruz demek.
Dialogue: 0,0:11:35.59,0:11:38.71,Main,,0,0,0,,Chiyu Chiyu Meyvesi'nin gücü\Nne harika şeymiş!
Dialogue: 0,0:11:39.20,0:11:42.05,Main,,0,0,0,,Pekâlâ, benden de al bakalım.
Dialogue: 0,0:11:42.05,0:11:45.14,Main,,0,0,0,,En az on ağır yaralı kişiyi\Niyileştirecek malzeme çıkar benden!
Dialogue: 0,0:11:45.42,0:11:47.64,Main,,0,0,0,,Ne harikasınız!
Dialogue: 0,0:11:48.06,0:11:50.39,Main,,0,0,0,,Ben 15 kişilik\Nbağışlayacağım o zaman!
Dialogue: 0,0:11:50.39,0:11:51.64,Main,,0,0,0,,Ne dedin?!
Dialogue: 0,0:11:51.64,0:11:54.05,Main,,0,0,0,,Benden 20 kişilik al o zaman!
Dialogue: 0,0:11:54.05,0:11:56.41,Main,,0,0,0,,Ben 25 kişilik bağışlayacağım!
Dialogue: 0,0:11:56.41,0:11:58.78,Main,,0,0,0,,Ne?\N100 kişilik al o zaman!
Dialogue: 0,0:12:00.03,0:12:02.66,Main,,0,0,0,,Sağ olun ama bunun\Nmümkün olduğunu sanmıyorum.
Dialogue: 0,0:12:07.66,0:12:09.54,Main,,0,0,0,,Tsuru-san.
Dialogue: 0,0:12:10.66,0:12:14.14,Main,,0,0,0,,Buyrun, bugünün zarını siz atın.
Dialogue: 0,0:12:18.24,0:12:24.86,Main,,0,0,0,,"Bir" hariç bir sayı gelirse\Nderhal Hasır Şapka'yla Law'un peşine düşeceğiz.
Dialogue: 0,0:12:31.21,0:12:33.33,Captions,,1000,0,300,,{\fad(250,250)}Kyros'un Evi
Dialogue: 0,0:12:31.63,0:12:33.35,Main,,0,0,0,,Beklettiğimiz için kusura bakmayın!
Dialogue: 0,0:12:38.44,0:12:39.98,Main,,0,0,0,,Yemek?!
Dialogue: 0,0:12:45.91,0:12:51.25,Main,,0,0,0,,Milletin ağzında Rebecca-dono'nun\Nbabasının nasıl da...
Dialogue: 0,0:12:51.25,0:12:54.05,Main,,0,0,0,,...falanca yerin prensi olduğundan\Nbaşka bir şey yoktu!
Dialogue: 0,0:12:54.05,0:12:54.91,Main,,0,0,0,,Değil mi?
Dialogue: 0,0:12:54.91,0:12:56.04,Main,,0,0,0,,Evet.
Dialogue: 0,0:12:58.09,0:13:01.34,Main,,0,0,0,,{\blur0.4\pos(550,178)\t(2627,3003,\alpha&HFF&)}O da ne demekmiş öyle?!
Dialogue: 0,0:12:58.09,0:13:01.34,Main,,0,0,0,,{\blur0.4\pos(748,605)\t(2627,3003,\alpha&HFF&)}Çok tuhaf!
Dialogue: 0,0:13:02.09,0:13:04.99,Main,,0,0,0,,{\blur0.4\pos(580,171)}Sabo gittiği için
Dialogue: 0,0:13:02.09,0:13:04.99,Main,,0,0,0,,{\blur0.4\pos(698,695)}çok üzüldüm!
Dialogue: 0,0:13:07.01,0:13:09.71,Main,,0,0,0,,{\blur0.4\pos(632,593.429)\t(2252,2502,\alpha&HFF&)}Derhal
Dialogue: 0,0:13:09.71,0:13:12.64,Main,,0,0,0,,{\blur0.4\pos(454,178)\t(2377,2878,\alpha&HFF&)}Sanji'lere
Dialogue: 0,0:13:09.72,0:13:12.64,Main,,0,0,0,,{\blur0.4\pos(798.222,572.222)\t(2377,2878,\alpha&HFF&)}yetişmemiz de lazım!
Dialogue: 0,0:13:15.19,0:13:19.48,Main,,0,0,0,,Kızıyor musun, ağlıyor musun,\Nacele mi ediyorsun, yiyor musun karar ver!
Dialogue: 0,0:13:19.48,0:13:20.40,Main,,0,0,0,,Amma kararsızsın!
Dialogue: 0,0:13:21.54,0:13:24.88,Main,,0,0,0,,Rebecca'nın babası asker amca{\fscx250}-
Dialogue: 0,0:13:25.45,0:13:28.12,Main,,0,0,0,,Henüz tamamen iyileşmedin!
Dialogue: 0,0:13:28.12,0:13:29.83,Main,,0,0,0,,Aç gözlülük etme de uyumana geri dön!
Dialogue: 0,0:13:30.91,0:13:34.96,Main,,0,0,0,,{\alpha&HFF&\blur0.4\pos(495,197)\t(0,167,\alpha&H00&)}Hay bin kunduz!
Dialogue: 0,0:13:30.91,0:13:34.96,Main,,0,0,0,,{\alpha&HFF&\blur0.4\pos(642,617)\t(0,167,\alpha&H00&)}Kim uydurmuş bu yalanı?!
Dialogue: 0,0:13:37.40,0:13:40.34,Main,,0,0,0,,Yutması zor bir durum.
Dialogue: 0,0:13:45.24,0:13:50.03,Main,,0,0,0,,Rebecca'nın doğumunu\Nyalnızca kraliyet ailesi...
Dialogue: 0,0:13:50.03,0:13:52.52,Main,,0,0,0,,...ve Donquixote Ailesi'nden\Naraştıran birkaç kişi biliyor.
Dialogue: 0,0:13:53.47,0:13:57.04,Main,,0,0,0,,Ülkenin onun hakkında bildiği\Ntek şeyse annesi.
Dialogue: 0,0:14:01.65,0:14:05.74,Main,,0,0,0,,Onlar babası olduğumu anlamaden önce\Nböyle bir söylenti başlattım.
Dialogue: 0,0:14:07.34,0:14:08.11,Main,,0,0,0,,Neden?
Dialogue: 0,0:14:10.98,0:14:13.12,Main,,0,0,0,,Suçlu bir geçmişim var çünkü.
Dialogue: 0,0:14:13.98,0:14:15.62,Main,,0,0,0,,Ailem de meçhul.
Dialogue: 0,0:14:16.31,0:14:19.44,Main,,0,0,0,,Kraliyet ailesinden biriyle evlenmem\Nsöz konusu bile olamazdı.
Dialogue: 0,0:14:20.46,0:14:21.74,Main,,0,0,0,,O yüzden de...
Dialogue: 0,0:14:24.24,0:14:25.30,Main,,0,0,0,,...böylesi herkes için daha iyi.
Dialogue: 0,0:14:26.77,0:14:27.93,Main,,0,0,0,,Neresi iyiymiş?!
Dialogue: 0,0:14:28.43,0:14:30.74,Main,,0,0,0,,Bu kararından\NRebecca'nın haberi var mı peki?
Dialogue: 0,0:14:33.12,0:14:35.18,Main,,0,0,0,,Mektubumu almış olması lazım.
Dialogue: 0,0:14:35.78,0:14:39.56,Main,,0,0,0,,Hayatıma dair her şeyi\Ntüm gerçekliğiyle anlattım.
Dialogue: 0,0:14:40.36,0:14:44.46,Main,,0,0,0,,Ona şimdiye dek\Nyeterince acı çektirdim.
Dialogue: 0,0:14:45.38,0:14:48.54,Main,,0,0,0,,Bundan sonra\Nbenim gibi biriyle olan bağını kesip...
Dialogue: 0,0:14:48.54,0:14:52.07,Main,,0,0,0,,...mutlu ve aydınlık bir gelecek\Nyaşamasını istiyorum.
Dialogue: 0,0:14:52.42,0:14:55.95,Main,,0,0,0,,Babası olarak ona kendimi\Nancak bu şekilde affettirebilirim.
Dialogue: 0,0:14:57.06,0:15:01.50,Main,,0,0,0,,Sizinle beraber ben de\Nbu ülkeden ayrılmayı planlıyorum.
Dialogue: 0,0:15:02.92,0:15:05.00,Main,,0,0,0,,Rebecca çocuk daha.
Dialogue: 0,0:15:05.00,0:15:09.02,Main,,0,0,0,,Anın heyecanına kapılıp mutlu olma şansını\Nelinden almak istemiyorum!
Dialogue: 0,0:15:10.07,0:15:12.66,Main,,0,0,0,,Kral Riku-sama'yı ikna ettim!
Dialogue: 0,0:15:21.42,0:15:23.81,Main,,0,0,0,,{\i1}Zerre yemiyor.{\i0}
Dialogue: 0,0:15:33.75,0:15:34.58,Main,,0,0,0,,Ne oluyor?
Dialogue: 0,0:15:36.69,0:15:39.71,Main,,0,0,0,,{\i1}Komutanım, yani şey...\NKyros-sama, Leo ben!{\i0}
Dialogue: 0,0:15:40.68,0:15:41.62,Main,,0,0,0,,Zoro-senpai!
Dialogue: 0,0:15:43.02,0:15:46.94,Main,,0,0,0,,Luffy-senpai, uyanmışsın!
Dialogue: 0,0:15:46.94,0:15:49.17,Main,,0,0,0,,Günaydın!
Dialogue: 0,0:15:56.51,0:15:58.93,Main,,0,0,0,,Hasır Şapka Tayfası'ndan\Nbeş kişi bir aradayken...
Dialogue: 0,0:15:59.21,0:16:01.55,Main,,0,0,0,,...bakılamayacak kadar\Nparlak oluyorlar!
Dialogue: 0,0:16:01.55,0:16:04.50,Main,,0,0,0,,Mükemmellikten oluşan\Nbir lazer ışını sanki!
Dialogue: 0,0:16:05.30,0:16:10.09,Main,,0,0,0,,Olur da Hasır Şapkalar'ın\Nhepsini bir arada görürsem...
Dialogue: 0,0:16:10.12,0:16:12.15,Main,,0,0,0,,...erir giderim ben be!
Dialogue: 0,0:16:12.48,0:16:14.45,Main,,0,0,0,,Çıkar ağzındaki baklayı artık!
Dialogue: 0,0:16:14.89,0:16:15.99,Main,,0,0,0,,Sahi ya!
Dialogue: 0,0:16:16.49,0:16:19.26,Main,,0,0,0,,Donanma kampı epey hareketlendi!
Dialogue: 0,0:16:19.26,0:16:21.34,Main,,0,0,0,,Her an buraya gelebilirler!
Dialogue: 0,0:16:21.94,0:16:26.58,Main,,0,0,0,,Yüce Danışman Koramiral Tsuru'yla\Neski filo amirali Sengoku geldi!
Dialogue: 0,0:16:26.58,0:16:28.09,Main,,0,0,0,,Tsuru'yla Sengoku mu?!
Dialogue: 0,0:16:28.48,0:16:31.51,Main,,0,0,0,,O kadar önemli kişilerin\Nburada ne işi var ya?! Çekin gidin!
Dialogue: 0,0:16:32.40,0:16:33.76,Thoughts,,0,0,0,,{\i1}Sengoku...{\i0}
Dialogue: 0,0:16:34.12,0:16:36.35,Main,,0,0,0,,Leo, sen niye aramıştın?
Dialogue: 0,0:16:36.67,0:16:39.35,Main,,0,0,0,,O kişi harekete geçti!
Dialogue: 0,0:16:44.30,0:16:46.36,Main,,0,0,0,,Altı.
Dialogue: 0,0:16:47.04,0:16:48.67,Main,,0,0,0,,Cennetten emir geldi!
Dialogue: 0,0:16:49.28,0:16:54.97,Main,,0,0,0,,Tüm Donanma birlikleri!\NHasır Şapka Tayfası'yla Trafalgar Law'u...
Dialogue: 0,0:16:54.97,0:16:59.91,Main,,0,0,0,,...ve buna ek olarak sarayda saklanan\Nsuçluları bir çırpıda yakalayın!
Dialogue: 0,0:16:59.91,0:17:01.33,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:17:07.50,0:17:10.80,Main,,0,0,0,,Amiral-dono,\Nsaraya girme iznimiz var mı?!
Dialogue: 0,0:17:11.11,0:17:15.18,Main,,0,0,0,,{\i1}Endişe etmeyin,\Ntüm sorumluluk bende!{\i0}
Dialogue: 0,0:17:15.57,0:17:16.30,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:17:46.68,0:17:49.13,Main,,0,0,0,,Donanma geliyor!\NDerhal hazırlanın!
Dialogue: 0,0:17:50.83,0:17:52.71,Main,,0,0,0,,Sonunda geliyorlar!
Dialogue: 0,0:17:52.71,0:17:54.27,Main,,0,0,0,,Bunu bize söylemene gerek yok.
Dialogue: 0,0:17:54.27,0:17:56.95,Main,,0,0,0,,Her an kaçabilmek için\Nhazırlanmıştık zaten.
Dialogue: 0,0:17:56.95,0:17:59.69,Main,,0,0,0,,Luffy-dono'nun uyanmasını bekliyorduk.
Dialogue: 0,0:17:59.69,0:18:05.17,Main,,0,0,0,,Evet, asıl bu zamana kadar\Npeşimize düşmemiş olmaları tuhaf.
Dialogue: 0,0:18:05.17,0:18:08.41,Main,,0,0,0,,Fakat bir sorunumuz var!\NGemimiz yok!
Dialogue: 0,0:18:08.41,0:18:10.67,Main,,0,0,0,,Tamamen unutmuşum!
Dialogue: 0,0:18:10.67,0:18:13.27,Main,,0,0,0,,Kaçacağız diyoruz da\Ngemisiz nasıl olacak o iş?!
Dialogue: 0,0:18:13.27,0:18:15.44,Main,,0,0,0,,Leo, senden istediğim şeyi yaptın mı?
Dialogue: 0,0:18:16.41,0:18:19.03,Main,,0,0,0,,Evet! Her şeyi söylediğiniz gibi yaptım!
Dialogue: 0,0:18:19.87,0:18:22.65,Main,,0,0,0,,Burası tehlikeli!\NYolu temizleyin!
Dialogue: 0,0:18:22.65,0:18:24.54,Main,,0,0,0,,Korsanları yakalayacağız!
Dialogue: 0,0:18:25.12,0:18:26.87,Main,,0,0,0,,Yolu temizleyin!
Dialogue: 0,0:18:27.25,0:18:29.21,Main,,0,0,0,,Ne?! Lucy'i de mi yakalayacaklar?
Dialogue: 0,0:18:29.21,0:18:30.08,Main,,0,0,0,,Nasıl olur?!
Dialogue: 0,0:18:31.15,0:18:34.17,Main,,0,0,0,,Horoz Kafa-san,\Nsaraya doğru gelenler de var!
Dialogue: 0,0:18:34.17,0:18:36.20,Main,,0,0,0,,Savaşçıların da başı dertte!
Dialogue: 0,0:18:36.20,0:18:39.50,Main,,0,0,0,,Sağ olasın! Bizi düşündüğün için\Nteşekkürler, küçük!
Dialogue: 0,0:18:39.50,0:18:43.66,Main,,0,0,0,,Bizim gözümüz de\Ndonanmanın üzerindeydi!
Dialogue: 0,0:18:43.66,0:18:46.68,Main,,0,0,0,,Luffy-senpai'lerim...\NBeni izleyin!
Dialogue: 0,0:18:46.68,0:18:49.90,Main,,0,0,0,,Doğrudan doğu limanına koşacağız!
Dialogue: 0,0:18:50.24,0:18:51.99,Main,,0,0,0,,Endişelenmeyin!
Dialogue: 0,0:18:51.99,0:18:56.81,Main,,0,0,0,,Uyanır uyanmaz bu ülkeden\Nkaçmanıza yardımcı olabilmek için...
Dialogue: 0,0:18:56.81,0:19:01.49,Main,,0,0,0,,...dostlarımız stratejik noktalardaki\Nyerlerini almışlardı bile!
Dialogue: 0,0:19:01.49,0:19:03.96,Main,,0,0,0,,Sizin için yolu açacağız!
Dialogue: 0,0:19:06.38,0:19:09.28,Main,,0,0,0,,Doğu limanında geminizi de hazırladık!
Dialogue: 0,0:19:10.18,0:19:11.56,Main,,0,0,0,,Çok sağ olasınız!
Dialogue: 0,0:19:12.30,0:19:15.71,Main,,0,0,0,,Sunny-go'yu Nami'lere vermiştik,\Ngemi konusunda biraz endişeliydik doğrusu!
Dialogue: 0,0:19:16.82,0:19:18.78,Main,,0,0,0,,Lafı bile olmaz!
Dialogue: 0,0:19:21.46,0:19:24.01,Main,,0,0,0,,Hepimiz bir takım olarak savaştık!
Dialogue: 0,0:19:24.01,0:19:27.78,Main,,0,0,0,,Şu saatten sonra kalkıp da "kralımızı"\Nyakalamalarına müsaade edecek değiliz!
Dialogue: 0,0:19:33.26,0:19:35.64,Main,,0,0,0,,Bellamy, ayağa kalkabilecek misin?
Dialogue: 0,0:19:35.64,0:19:39.32,Main,,0,0,0,,Evet.\NKoşarım bile.
Dialogue: 0,0:19:39.32,0:19:40.70,Main,,0,0,0,,İyi madem, sevindim.
Dialogue: 0,0:19:43.36,0:19:47.22,Main,,0,0,0,,Trafalgar, beni neden\Nkaderime bırakmadın?
Dialogue: 0,0:19:48.14,0:19:50.97,Main,,0,0,0,,Öleceğim yerdi orası!
Dialogue: 0,0:19:50.97,0:19:54.96,Main,,0,0,0,,Hasır Şapka-ya senden dostum diye bahsetmişti, \Nne olur ne olmaz getirdim.
Dialogue: 0,0:19:54.96,0:19:56.55,Main,,0,0,0,,Ölmek istiyorsan\Ndurduğun yerde ölüver!
Dialogue: 0,0:19:56.88,0:20:01.20,Main,,0,0,0,,O Küçük İnsan sayesinde\Naptallar gibi tamamen iyileştim!
Dialogue: 0,0:20:01.20,0:20:04.68,Main,,0,0,0,,Donanma'ya karşı savaşırken ölmem\Nsöz konusu bile olamaz!
Dialogue: 0,0:20:05.04,0:20:07.90,Main,,0,0,0,,Çok istiyorsan\Nbir yolunu bul ve öl, aptal.
Dialogue: 0,0:20:07.90,0:20:09.35,Main,,0,0,0,,Ne dedin?!
Dialogue: 0,0:20:09.35,0:20:11.66,Main,,0,0,0,,Teşekkür etmesini bile\Nbilmez mi insan?!
Dialogue: 0,0:20:17.92,0:20:20.94,Main,,0,0,0,,Düşünecek zamanımız yok!
Dialogue: 0,0:20:20.94,0:20:22.86,Main,,0,0,0,,Koşalım, savaş arkadaşlarım!
Dialogue: 0,0:20:23.49,0:20:25.88,Main,,0,0,0,,Haydi gidelim!
Dialogue: 0,0:20:25.88,0:20:26.99,Main,,0,0,0,,Çıktılar!
Dialogue: 0,0:20:26.99,0:20:29.24,Main,,0,0,0,,Bir kişinin bile kaçmasına izin vermeyin!
Dialogue: 0,0:20:29.24,0:20:30.40,Main,,0,0,0,,Ateş!
Dialogue: 0,0:20:36.68,0:20:38.81,Main,,0,0,0,,Amanın! Bunu ben hallederim!
Dialogue: 0,0:20:38.81,0:20:39.92,Main,,0,0,0,,{\fad(150,150)}Bariyer!
Dialogue: 0,0:20:42.14,0:20:45.21,Main,,0,0,0,,Durmayın!\NAteş, ateş, ateş!
Dialogue: 0,0:20:45.21,0:20:47.47,Main,,0,0,0,,Bu taraftan millet!
Dialogue: 0,0:20:49.38,0:20:52.12,Main,,0,0,0,,Fujitora'ya denk gelirsek\Nyandığımızın resmidir!
Dialogue: 0,0:20:52.12,0:20:54.70,Main,,0,0,0,,Ne yaparsanız yapın ayrılmayın!
Dialogue: 0,0:21:06.56,0:21:08.33,Main,,0,0,0,,Ne?! Luffy-senpai?!
Dialogue: 0,0:21:10.62,0:21:13.33,Main,,0,0,0,,Yapmam gereken bir şey var, gidin siz!
Dialogue: 0,0:21:13.33,0:21:14.36,Main,,0,0,0,,Ne?!
Dialogue: 0,0:21:14.36,0:21:16.55,Main,,0,0,0,,Luffy, fazla zamanımız yok!
Dialogue: 0,0:21:16.55,0:21:19.05,Main,,0,0,0,,Ne yapacaksan acele yap!
Dialogue: 0,0:21:19.05,0:21:20.75,Main,,0,0,0,,Doğu limanında bekleyeceğiz!
Dialogue: 0,0:21:20.75,0:21:21.79,Main,,0,0,0,,Tamamdır!
Dialogue: 0,0:21:21.79,0:21:22.77,Main,,0,0,0,,Gidelim!
Dialogue: 0,0:21:22.77,0:21:25.63,Main,,0,0,0,,Zoro-senpai, o taraf güney!
Dialogue: 0,0:21:25.63,0:21:28.05,Main,,0,0,0,,Ama bu özelliğin de\Nacayip havalı!
Dialogue: 0,0:21:28.47,0:21:29.93,Main,,0,0,0,,Ne?! Lucy mi?!
Dialogue: 0,0:21:29.93,0:21:33.48,Main,,0,0,0,,Donanma askerleri peşinde.\NYakında ülkeden ayrılacak sanırım.
Dialogue: 0,0:21:33.79,0:21:38.24,Main,,0,0,0,,Nasıl olur?! Daha doğru düzgün\Nteşekkür bile edemedim!
Dialogue: 0,0:21:44.02,0:21:47.53,Main,,0,0,0,,Şansının tükenip tükenmediğini...
Dialogue: 0,0:21:51.58,0:21:54.26,Main,,0,0,0,,...tüm gücümle...
Dialogue: 0,0:21:55.07,0:21:56.71,Main,,0,0,0,,...test edelim bakalım!
Dialogue: 0,0:22:04.80,0:22:09.40,Captions,,600,0,90,,{\fad(250,250)}Donanma Kampı\NDressrosa Merkezi
Dialogue: 0,0:21:59.89,0:22:02.46,Main,,0,0,0,,{\a6}Şu andan itibaren Issho-san adına...
Dialogue: 0,0:22:02.46,0:22:04.80,Main,,0,0,0,,...tüm birliklerin komutası bende!
Dialogue: 0,0:22:05.10,0:22:09.81,Main,,0,0,600,,Saray'da saklanan suçluların\Npeşini bırakmayın-dara!
Dialogue: 0,0:22:09.81,0:22:10.22,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:22:11.08,0:22:14.56,Main,,0,0,0,,Carta'daki tepeden kaçan\NHasır Şapkalar'ın durumu ne-dara?!
Dialogue: 0,0:22:15.12,0:22:17.23,Main,,0,0,0,,Bu taraftan millet!
Dialogue: 0,0:22:23.64,0:22:25.49,Main,,0,0,0,,Sogeking-senpai!
Dialogue: 0,0:22:25.49,0:22:27.56,Main,,0,0,0,,Düşünce bile bir ayrı havalı oluyorsun!
Dialogue: 0,0:22:30.55,0:22:33.41,Main,,0,0,0,,Şehrin ortasında böyle koşmak\Nciddi ciddi güvenli mi?!
Dialogue: 0,0:22:33.77,0:22:36.96,Main,,0,0,0,,Endişelenmeyin!\NAcele edelim biz!
Dialogue: 0,0:22:37.72,0:22:39.77,Main,,0,0,0,,Şu anda korsanların peşindeyiz!
Dialogue: 0,0:22:39.77,0:22:42.82,Main,,0,0,0,,Görünüşe bakılırsa\Ndoğu limanına doğru gidiyorlar!
Dialogue: 0,0:22:42.82,0:22:45.96,Main,,0,0,0,,Pekâlâ, doğu limanına bağlayın beni!
Dialogue: 0,0:22:46.70,0:22:51.18,Main,,0,0,0,,Doğu limanı Donanma gözcü birliğiyle\Nkonuşuyorsunuz, tamam!
Dialogue: 0,0:22:53.68,0:22:56.18,Main,,0,0,0,,Asayiş berkemal, tamam!
Dialogue: 0,0:22:58.70,0:23:00.54,Main,,0,0,0,,Asayiş berkemal mi?!
Dialogue: 0,0:23:00.54,0:23:03.46,Main,,0,0,0,,Nasıl bu kadar rahat olabiliyorsun?
Dialogue: 0,0:23:03.46,0:23:06.35,Main,,0,0,0,,Korsanlar size doğru geliyor!
Dialogue: 0,0:23:06.35,0:23:10.19,Main,,0,0,0,,Hiç endişelenmeyin,\Nburada her şey yolunda.
Dialogue: 0,0:23:06.02,0:23:09.92,Captions,,1010,0,300,,{\fad(250,250)}Doğu Limanı
Dialogue: 0,0:23:10.19,0:23:13.33,Main,,0,0,0,,Desteğe ihtiyacımız yok, tamam!
Dialogue: 0,0:23:13.33,0:23:14.68,Main,,0,0,0,,Aptal herif...
Dialogue: 0,0:23:15.16,0:23:17.75,Main,,0,0,0,,Donanma Kodu'nu söyle.
Dialogue: 0,0:23:18.14,0:23:19.72,Main,,0,0,0,,{\i1}Buyur?{\i0}
Dialogue: 0,0:23:19.72,0:23:22.00,Main,,0,0,0,,{\i1}Şey...{\i0}
Dialogue: 0,0:23:22.98,0:23:24.84,Main,,0,0,0,,Kahretsin-dara!
Dialogue: 0,0:23:30.96,0:23:32.73,Captions,,0,970,350,,{\fad(250,250)}Bartolomeolar
Dialogue: 0,0:23:24.84,0:23:29.34,Main,,0,0,0,,Doğu limanı ele geçirilmiş!\NDerhal destek birlikleri yollayın!
Dialogue: 0,0:23:29.34,0:23:30.02,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:23:33.70,0:23:36.18,Main,,0,0,0,,Gidin!\NDoğrudan limana!
Dialogue: 0,0:23:36.66,0:23:37.60,Main,,0,0,0,,Sağ olasın!
Dialogue: 0,0:23:40.48,0:23:42.56,Main,,0,0,0,,Teşekkür falan ederek\Nzaman kaybetmeyin!
Dialogue: 0,0:23:46.20,0:23:50.24,Main,,0,0,0,,Borç yiğidin kamçısıdır!\NSize borcumuz büyük!
Dialogue: 0,0:23:50.57,0:23:52.82,Main,,0,0,0,,Yol tıkalı!
Dialogue: 0,0:24:02.62,0:24:03.35,Main,,0,0,0,,Gidin!
Dialogue: 0,0:24:03.35,0:24:04.83,Main,,0,0,0,,Teşekkür ederiz!
Dialogue: 0,0:24:16.92,0:24:19.72,Main,,0,0,0,,Saray'da olması gereken suçlular...
Dialogue: 0,0:24:19.72,0:24:22.09,Main,,0,0,0,,...doğu şehrindeki yıkıntılarda belirdiler!
Dialogue: 0,0:24:22.09,0:24:22.56,Main,,0,0,0,,{\i1}Ne dedin?!{\i0}
Dialogue: 0,0:24:22.94,0:24:25.48,Main,,0,0,0,,Saray boş mu yani?!
Dialogue: 0,0:24:28.52,0:24:30.19,Main,,0,0,0,,Sarayın önünden arıyorum!
Dialogue: 0,0:24:32.58,0:24:34.50,Main,,0,0,0,,Ha-Hasır Şapka...
Dialogue: 0,0:24:35.60,0:24:37.91,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:24:38.76,0:24:40.40,Main,,0,0,0,,{\fad(150,150)}...Havai Fişek!
Dialogue: 0,0:24:53.62,0:24:56.82,Captions,,965,0,290,,{\fad(250,250)}Ayçiçeği Bahçesi\NSarayın Dışı
Dialogue: 0,0:24:55.16,0:24:57.40,Main,,0,0,0,,Rebecca!
Dialogue: 0,0:24:57.40,0:25:00.27,Main,,0,0,0,,Rebecca, neredesin?!
Dialogue: 0,0:25:04.10,0:25:06.90,Main,,0,0,0,,Hasır Şapka sarayın önünde\Nne arıyor-dara?!
Dialogue: 0,0:25:08.40,0:25:10.34,Main,,0,0,0,,Kaçmasına kesinlikle izin vermeyin!
Dialogue: 0,0:25:10.34,0:25:10.69,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:25:10.69,0:25:13.70,Main,,0,0,0,,Rebecca!
Dialogue: 0,0:25:15.14,0:25:19.37,Main,,0,0,0,,Hey, Rebecca!
Dialogue: 0,0:25:20.90,0:25:22.62,Main,,0,0,0,,Biri bana sesleniyor!
Dialogue: 0,0:25:25.78,0:25:27.30,Main,,0,0,0,,Lucy?!
Dialogue: 0,0:25:27.30,0:25:30.42,Main,,0,0,0,,Lucy! Buradayım!
Dialogue: 0,0:25:30.85,0:25:33.00,Main,,0,0,0,,Lucy!
Dialogue: 0,0:25:41.35,0:25:42.76,Captions,,980,0,280,,{\fad(250,250)}Saray\NAvlu
Dialogue: 0,0:25:35.06,0:25:38.73,Main,,0,0,0,,Olmaz Rebecca-sama!\NKorsan biriyle konuşamazsınız!
Dialogue: 0,0:25:38.73,0:25:40.14,Main,,0,0,0,,İşte oradasın!
Dialogue: 0,0:25:41.90,0:25:42.77,Main,,0,0,0,,Tank.
Dialogue: 0,0:25:43.42,0:25:46.54,Main,,0,0,0,,Viola'yla Rebecca'yı çağırabilir misin?
Dialogue: 0,0:25:46.54,0:25:47.32,Main,,0,0,0,,Emredersiniz.
Dialogue: 0,0:25:48.14,0:25:49.86,Main,,0,0,0,,Şehre inelim.
Dialogue: 0,0:25:50.42,0:25:54.96,Main,,0,0,0,,Kral Riku Ailesi'nin yeniden tahta geçişini\Nülkeye duyuracağız.
Dialogue: 0,0:25:56.14,0:25:57.63,Main,,0,0,0,,Emredersiniz!\NDerhal çağırıyorum!
Dialogue: 0,0:25:57.63,0:26:00.34,Main,,0,0,0,,Bu anı dört gözle bekliyordum!
Dialogue: 0,0:26:00.34,0:26:03.20,Main,,0,0,0,,Rebecca!
Dialogue: 0,0:26:04.52,0:26:05.98,Main,,0,0,0,,Lucy!
Dialogue: 0,0:26:07.88,0:26:08.84,Main,,0,0,0,,Lucy!
Dialogue: 0,0:26:08.84,0:26:10.65,Main,,0,0,0,,Hasır Şapka!\NNiye geldin?!
Dialogue: 0,0:26:21.58,0:26:23.30,Main,,0,0,0,,Geri çekilin, Rebecca-sama!
Dialogue: 0,0:26:24.26,0:26:25.23,Main,,0,0,0,,Lucy!
Dialogue: 0,0:26:25.57,0:26:28.98,Main,,0,0,0,,İyi ki geldin!\NSana teşekkür etmek istiyordum...
Dialogue: 0,0:26:29.32,0:26:30.24,Main,,0,0,0,,Kapa çeneni!
Dialogue: 0,0:26:31.30,0:26:33.20,Main,,0,0,0,,Onun için gelmedim!
Dialogue: 0,0:26:34.20,0:26:36.12,Main,,0,0,0,,Bu halinden memnun musun?!
Dialogue: 0,0:26:37.06,0:26:38.24,Main,,0,0,0,,Asker'i diyorum!
Dialogue: 0,0:26:39.28,0:26:41.28,Main,,0,0,0,,Onu bir daha hiç göremeyeceksin!
Dialogue: 0,0:26:44.22,0:26:48.81,Main,,0,0,0,,Lucy...\NOndan bir mektup aldım.
Dialogue: 0,0:26:52.88,0:26:58.48,Main,,0,0,0,,Asker-san kendini benden uzaklaştırmak için\Nelinden geleni yapıyor.
Dialogue: 0,0:27:03.32,0:27:06.58,Main,,0,0,0,,Beni kendine yabancılaştırmaya çalışıyor.
Dialogue: 0,0:27:07.90,0:27:11.02,Flashbacks,,0,0,0,,Sana ne!\NNe anamsın ne babam!
Dialogue: 0,0:27:14.84,0:27:15.78,Main,,0,0,0,,Neden?
Dialogue: 0,0:27:16.96,0:27:18.62,Main,,0,0,0,,O kötü şeyleri söyledim diye mi?
Dialogue: 0,0:27:20.40,0:27:22.95,Flashbacks,,0,0,0,,Doflamingo'yu yenmene imkan yok!
Dialogue: 0,0:27:23.34,0:27:27.25,Flashbacks,,0,0,0,,Haline baksana!\NTek bacaklı bir oyuncaksın!
Dialogue: 0,0:27:36.02,0:27:39.44,Main,,0,0,0,,Benimle yaşamak\Nistemiyor mu dersin?!
Dialogue: 0,0:27:44.96,0:27:46.60,Main,,0,0,0,,Onu rahatsız mı ediyorum?!
Dialogue: 0,0:27:46.60,0:27:49.18,Main,,0,0,0,,Ne bileyim!\NKendin düşün bunları!
Dialogue: 0,0:27:49.18,0:27:51.88,Main,,0,0,0,,Ülkeden gidiyorum!
Dialogue: 0,0:27:52.52,0:27:55.88,Main,,0,0,0,,Sana yalnızca "Bu halinden memnun musun?" \Ndiye sormaya geldim!
Dialogue: 0,0:27:57.86,0:27:59.15,Main,,0,0,0,,Değilim!
Dialogue: 0,0:27:59.47,0:28:01.78,Main,,0,0,0,,Hiç değilim hem de!
Dialogue: 0,0:28:02.24,0:28:03.62,Main,,0,0,0,,Benimle gel o zaman!
Dialogue: 0,0:28:04.44,0:28:06.30,Main,,0,0,0,,Peki!\NGeleceğim!
Dialogue: 0,0:28:07.44,0:28:09.45,Main,,0,0,0,,- Ne?!\N- Rebecca-sama!
Dialogue: 0,0:28:09.86,0:28:11.96,Main,,0,0,0,,Rebecca, Hasır Şapka!\NBekleyin biraz!
Dialogue: 0,0:28:13.08,0:28:14.22,Main,,0,0,0,,Viola-san!
Dialogue: 0,0:28:15.20,0:28:16.36,Main,,0,0,0,,Senden bir şey isteyeceğim!
Dialogue: 0,0:28:18.46,0:28:19.46,Main,,0,0,0,,Gidelim!
Dialogue: 0,0:28:26.64,0:28:28.80,Main,,0,0,0,,Sıkı tutun!
Dialogue: 0,0:28:28.80,0:28:29.68,Main,,0,0,0,,Tamam!
Dialogue: 0,0:28:30.64,0:28:31.60,Main,,0,0,0,,Kaçıyor!
Dialogue: 0,0:28:31.98,0:28:33.80,Main,,0,0,0,,Kral Riku-sama!
Dialogue: 0,0:28:34.94,0:28:35.86,Main,,0,0,0,,Ne oldu?!
Dialogue: 0,0:28:36.18,0:28:40.22,Main,,0,0,0,,Korsanın teki\NRebecca-sama'yı kaçırdı!
Dialogue: 0,0:28:40.22,0:28:42.13,Main,,0,0,0,,Ne dedin?!
Dialogue: 0,0:28:42.13,0:28:45.42,Main,,0,0,0,,Nerenin korsanıymış o?!\NNeye benziyordu?!
Dialogue: 0,0:28:45.42,0:28:47.96,Main,,0,0,0,,Kolezyum yarışmacılarından biri mi?!
Dialogue: 0,0:28:47.96,0:28:51.25,Main,,0,0,0,,H... Has... Hasır...
Dialogue: 0,0:28:51.25,0:28:52.91,Main,,0,0,0,,Hasır Şapkalı Luffy!
Dialogue: 0,0:28:55.12,0:28:59.19,Main,,0,0,0,,Rebecca-sama saraydan kaçırıldı!
Dialogue: 0,0:28:59.19,0:29:01.67,Main,,0,0,0,,Hasır Şapkalı Luffy yapmış!
Dialogue: 0,0:29:01.67,0:29:03.07,Main,,0,0,0,,Ne dedin?!
Dialogue: 0,0:29:03.07,0:29:05.32,Main,,0,0,0,,Kesin fidye için kaçırdılar!
Dialogue: 0,0:29:07.13,0:29:09.86,Main,,0,0,0,,Lucy mi yapmış?!
Dialogue: 0,0:29:09.86,0:29:11.93,Main,,0,0,0,,Bu ne cüret?!
Dialogue: 0,0:29:12.28,0:29:14.62,Main,,0,0,0,,Ama seni...
Dialogue: 0,0:29:14.62,0:29:15.94,Main,,0,0,0,,...yine de...
Dialogue: 0,0:29:17.08,0:29:19.91,Main,,0,0,0,,...seviyorum be!
Dialogue: 0,0:29:19.91,0:29:21.53,Main,,0,0,0,,Ne diyorsun sen, Gyats?!
Dialogue: 0,0:29:22.02,0:29:26.49,Main,,0,0,0,,Gördünüz mü?! Korsanlara güvenip\Nkalmalarına izin verince işte bu oluyor!
Dialogue: 0,0:29:26.49,0:29:30.50,Main,,0,0,0,,Derhal Hasır Şapka'yı yakalayıp\NPrenses Rebecca'yı kurtarın!
Dialogue: 0,0:29:40.74,0:29:41.48,Main,,0,0,0,,Orada!
Dialogue: 0,0:29:42.32,0:29:45.14,Main,,0,0,0,,Özel keskin nişancı birliği!\NDikkatlice nişan alıp vurun onu!
Dialogue: 0,0:30:04.42,0:30:06.46,Captions,,1000,0,340,,{\fad(250,250)}Donanma Kampı
Dialogue: 0,0:30:02.26,0:30:04.32,Main,,0,0,0,,Donanma askerleri birden...
Dialogue: 0,0:30:04.94,0:30:06.49,Main,,0,0,0,,Askerler bayıldı mı dedin?!
Dialogue: 0,0:30:06.89,0:30:08.41,Main,,0,0,0,,Kralların Hakisi yüzünden mi?!
Dialogue: 0,0:30:08.41,0:30:10.82,Main,,0,0,0,,{\i1}Hayır, bilinçleri yerinde gibi...{\i0}
Dialogue: 0,0:30:11.58,0:30:15.25,Main,,0,0,0,,Neyse ne,\Ndoğu limanından kaçacaklar-dara!
Dialogue: 0,0:30:15.72,0:30:20.64,Main,,0,0,0,,Savaş gemilerini de yollayın!\NTüm birlikler doğudaki Carta'ya-dara!
Dialogue: 0,0:30:20.64,0:30:21.25,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:30:23.30,0:30:24.92,Main,,0,0,0,,Orada!
Dialogue: 0,0:30:25.66,0:30:26.96,Main,,0,0,0,,Bekle!
Dialogue: 0,0:30:33.94,0:30:36.06,Main,,0,0,0,,Lucy'i yakalayın!
Dialogue: 0,0:30:39.44,0:30:41.36,Main,,0,0,0,,Deneyin de görelim!
Dialogue: 0,0:30:54.11,0:30:55.83,Main,,0,0,0,,Ne oldu?!
Dialogue: 0,0:30:55.83,0:30:57.03,Main,,0,0,0,,Lucy mi bu?!
Dialogue: 0,0:30:57.03,0:30:58.33,Main,,0,0,0,,Benim etim o!
Dialogue: 0,0:30:58.33,0:30:58.87,Main,,0,0,0,,Özür dilerim!
Dialogue: 0,0:31:03.90,0:31:04.54,Main,,0,0,0,,Rebecca!
Dialogue: 0,0:31:06.23,0:31:09.30,Main,,0,0,0,,Seni tepenin ardına bırakıp\Nonları senden uzaklaştıracağım!
Dialogue: 0,0:31:10.02,0:31:11.01,Main,,0,0,0,,Oradan sonrasını kendin git!
Dialogue: 0,0:31:11.80,0:31:14.03,Main,,0,0,0,,Tüm ülke\Nseni korumaya çalışıyor!
Dialogue: 0,0:31:14.03,0:31:16.39,Main,,0,0,0,,Yakalanacak olursak\Nseni saraya geri götürürler!
Dialogue: 0,0:31:19.54,0:31:21.28,Main,,0,0,0,,Peki, anladım!
Dialogue: 0,0:31:22.08,0:31:25.32,Main,,0,0,0,,Acele etmen lazım\Nyoksa yetişemeyeceksin.
Dialogue: 0,0:31:25.32,0:31:26.61,Main,,0,0,0,,Teşekkür ederim!
Dialogue: 0,0:31:26.92,0:31:29.36,Main,,0,0,0,,Gerçekten çok teşekkür ederim, Lucy!
Dialogue: 0,0:31:31.60,0:31:33.28,Main,,0,0,0,,Lafı olmaz!
Dialogue: 0,0:31:56.34,0:31:58.66,Flashbacks,,0,0,0,,Ne şirinsin sen...
Dialogue: 0,0:31:59.84,0:32:01.46,Flashbacks,,0,0,0,,Gene gözlerin yaşardı!
Dialogue: 0,0:32:11.56,0:32:12.66,Thoughts,,0,0,0,,{\i1}Scarlet...{\i0}
Dialogue: 0,0:32:13.88,0:32:15.76,Thoughts,,0,0,0,,{\i1}Görevim burada sonra erdi.{\i0}
Dialogue: 0,0:32:16.98,0:32:20.36,Thoughts,,0,0,0,,{\i1}Kocan konusunda\Nyalan söylediğim için bağışla beni.{\i0}
Dialogue: 0,0:32:22.10,0:32:26.22,Thoughts,,0,0,0,,{\i1}Her şeyi\NRebecca'nın mutluluğu için yaptım.{\i0}
Dialogue: 0,0:32:52.30,0:32:54.16,Flashbacks,,0,0,0,,Sana savaşmayı öğreteceğim!
Dialogue: 0,0:32:54.82,0:32:57.83,Flashbacks,,0,0,0,,Annem kimsenin canını\Nyakmamamı söylemişti!
Dialogue: 0,0:32:58.70,0:33:01.91,Flashbacks,,0,0,0,,Sana kendi canını\Nnasıl koruyacağını öğreteceğim!
Dialogue: 0,0:33:04.17,0:33:05.88,Flashbacks,,0,0,0,,Ayağa kalk, Rebecca!
Dialogue: 0,0:33:05.88,0:33:06.88,Flashbacks,,0,0,0,,Güçlen!
Dialogue: 0,0:33:07.62,0:33:13.20,Thoughts,,0,0,0,,{\i1}Kraliyet ailesinden olduğun için kaçtığın, \Naşağılandığın koca bir on sene...{\i0}
Dialogue: 0,0:33:13.87,0:33:16.32,Thoughts,,0,0,0,,{\i1}O yüzden bu sefer...{\i0}
Dialogue: 0,0:33:17.24,0:33:21.36,Thoughts,,0,0,0,,{\i1}...kraliyet ailesinin bir parçası olarak\Nmutlu yaşamanı istiyorum.{\i0}
Dialogue: 0,0:33:24.92,0:33:27.64,Thoughts,,0,0,0,,{\i1}Ben de burada kalamam.{\i0}
Dialogue: 0,0:33:33.94,0:33:34.70,Main,,0,0,0,,Rebecca!
Dialogue: 0,0:33:39.78,0:33:41.87,Main,,0,0,0,,Yalan söyleme!
Dialogue: 0,0:33:45.36,0:33:47.34,Main,,0,0,0,,Mektuptan mı bahsediyorsun?
Dialogue: 0,0:33:48.35,0:33:49.47,Main,,0,0,0,,Yalan söylemiyordum!
Dialogue: 0,0:33:50.06,0:33:55.58,Main,,0,0,0,,Eskiden gerçekten de kavgadan başka bir şey\Nbilmeyen serserinin tekiydim.
Dialogue: 0,0:33:56.77,0:33:58.45,Main,,0,0,0,,Ve sebebi ne olursa olsun...
Dialogue: 0,0:33:59.82,0:34:02.22,Main,,0,0,0,,...birilerinin canını da aldım.
Dialogue: 0,0:34:02.77,0:34:03.98,Main,,0,0,0,,O yüzden...
Dialogue: 0,0:34:08.35,0:34:11.73,Main,,0,0,0,,Falanca prensin kızı değilim ben!
Dialogue: 0,0:34:13.30,0:34:15.22,Main,,0,0,0,,Öyle birini tanımıyorum!
Dialogue: 0,0:34:19.76,0:34:24.72,Main,,0,0,0,,Yüzlerce kişi öldürmüş de olsa,\Nelleri kapkara da olsa...
Dialogue: 0,0:34:25.88,0:34:28.08,Main,,0,0,0,,...tek bir babam var benim!
Dialogue: 0,0:34:29.66,0:34:32.82,Main,,0,0,0,,Kyros'un kızıyım ben!
Dialogue: 0,0:34:42.28,0:34:44.36,Main,,0,0,0,,Yalan söyleme!
Dialogue: 0,0:34:47.18,0:34:50.76,Flashbacks,,0,0,0,,Mutlu olduğun güne dek...
Dialogue: 0,0:34:51.58,0:34:53.58,Flashbacks,,0,0,0,,{\i1}...hep yanında olacağım!{\i0}
Dialogue: 0,0:35:02.36,0:35:05.44,Main,,0,0,0,,Söz verdiğin gibi\Nyanımda kal, Asker-san!
Dialogue: 0,0:35:14.12,0:35:18.17,Main,,0,0,0,,Be-Beni gerçekten\Nbaban olarak istiyor musun?!
Dialogue: 0,0:35:19.68,0:35:23.98,Main,,0,0,0,,Evet!\NBirlikte yaşayalım!
Dialogue: 0,0:35:25.11,0:35:26.60,Main,,0,0,0,,Baba!
Dialogue: 0,0:35:27.38,0:35:29.40,Main,,0,0,0,,Peki... Peki...
Dialogue: 0,0:35:40.14,0:35:43.58,Main,,0,0,0,,Rebecca saraya bir daha\Ngeri dönmeyecek baba.
Dialogue: 0,0:35:44.50,0:35:47.08,Main,,0,0,0,,Viola... Tahmin etmiştim.
Dialogue: 0,0:35:47.44,0:35:50.87,Main,,0,0,0,,Evet, onun dileği bu.
Dialogue: 0,0:35:51.28,0:35:54.71,Flashbacks,,0,0,0,,Özür dilerim, Viola-san!\NYerime prenses sen ol!
Dialogue: 0,0:35:58.80,0:36:01.92,Flashbacks,,0,0,0,,Özür dilerim, Viola!\NYerime prenses sen ol!
Dialogue: 0,0:36:01.92,0:36:03.10,Flashbacks,,0,0,0,,Abla?!
Dialogue: 0,0:36:04.44,0:36:08.74,Main,,0,0,0,,İkinci kez böyle tuhaf bir\Nistekte bulunuluyor.
Dialogue: 0,0:36:08.74,0:36:11.39,Main,,0,0,0,,Anlıyorum... Kan çekiyor işte.
Dialogue: 0,0:36:12.28,0:36:13.62,Main,,0,0,0,,Luffy daha gelmedi mi?!
Dialogue: 0,0:36:14.44,0:36:17.00,Main,,0,0,3,,Trafalgar Law da yok!
Dialogue: 0,0:36:15.41,0:36:19.79,Captions,,0,0,175,,{\fad(530,0)}Orman Kasabası Harabeleri, Carta, Doğu Limanı
Dialogue: 0,0:36:17.00,0:36:19.78,Main,,0,0,3,,Bizim patronlar nerede yahu?!
Dialogue: 0,0:36:20.12,0:36:24.66,Main,,0,0,0,,Bizim bile durduramayacağımız\Ndüşmanlar mevcut...
Dialogue: 0,0:36:26.30,0:36:27.20,Main,,0,0,0,,Bu...
Dialogue: 0,0:36:32.54,0:36:34.00,Main,,0,0,0,,Fuji{\alpha&HFF&}tora!
Dialogue: 0,0:36:34.00,0:36:35.46,Main,,0,0,0,,Fujitora!
Dialogue: 0,0:36:35.46,0:36:38.05,Main,,0,0,0,,Aklımıza gelen başımıza da geldi!
Dialogue: 0,0:36:38.05,0:36:41.01,Main,,0,0,0,,Luffy-senpai, acele ediver!
Dialogue: 0,0:36:49.10,0:36:51.62,Main,,0,0,0,,Şimdi ne yapacağız?!
Dialogue: 0,0:36:51.62,0:36:53.02,Main,,0,0,0,,Çok belli değil mi?!
Dialogue: 0,0:36:59.85,0:37:02.60,OP11 Credits,,0,0,0,,Editing:\N Galaxy 9000\N\NTiming:\N Datenshi,\NSewil (Opening)\N\NQuality Assurance:\N Datenshi,\NFeeso,\NGalaxy 9000,\NGrug,\NMr. Luffy\N\NSoundtracking:\N Halee\N\NGraphics:\N Datenshi\N\NTranslation:\NYibis
