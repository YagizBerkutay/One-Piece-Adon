Dialogue: 0,0:01:42.61,0:01:44.67,Title,,0,0,240,,{\fad(300,300}Bir Erkeğin Dünyası
Dialogue: 0,0:01:48.64,0:01:53.68,Captions,,0,0,170,,{\fad(1000,0)}Kin'emon
Dialogue: 0,0:01:50.15,0:01:53.68,Captions,,350,0,550,,{\fr(1)\fad(250,0)}Yönetim Kulesi
Dialogue: 0,0:01:50.15,0:01:53.68,Captions,,580,0,338,,{\fr(2)\fad(250,0)}Hurdalık
Dialogue: 0,0:01:53.66,0:01:55.39,Main,,0,0,0,,Duvarın içinde biri mi varmış?!
Dialogue: 0,0:01:55.39,0:01:57.36,Main,,0,0,0,,Şükürler olsun iyisin!
Dialogue: 0,0:01:57.36,0:01:59.31,Main,,0,0,0,,Kanjuro!
Dialogue: 0,0:02:02.88,0:02:05.14,Main,,0,0,0,,Vay, Kin'emon!
Dialogue: 0,0:02:05.14,0:02:06.92,Main,,0,0,0,,Şükürler olsun!
Dialogue: 0,0:02:07.96,0:02:09.78,Main,,0,0,0,,Gerçekten!
Dialogue: 0,0:02:09.78,0:02:13.60,Main,,0,0,0,,Kusura bakma.\NKendimi biraz arattım sanırım.
Dialogue: 0,0:02:15.02,0:02:18.64,Main,,0,0,0,,Tonla tuhaf şey birden gerçekleşince...
Dialogue: 0,0:02:18.64,0:02:22.36,Main,,0,0,3,,{\an8}...ben de bir süre duvarın içinde\Nsaklanmayı uygun görmüştüm ama...
Dialogue: 0,0:02:19.03,0:02:25.54,Captions,,0,0,235,,{\fad(500,0)}Wano Krallığı'ndan Bir Samuray\NAni Yağmur Kanjuro
Dialogue: 0,0:02:22.36,0:02:25.29,Main,,0,0,3,,...uyuyakalmışım.
Dialogue: 0,0:02:25.80,0:02:30.26,Main,,0,0,0,,O değil de Kin'emon,\Ngeri dönmüş olmana çok şaşırdım!
Dialogue: 0,0:02:30.48,0:02:33.54,Main,,0,0,0,,Bu kadar beklettiğim için\Nözür dilerim!
Dialogue: 0,0:02:35.56,0:02:40.03,Main,,0,0,0,,Sana olan güvenim sayesinde\Nbeklemek zor gelmedi bana.
Dialogue: 0,0:02:40.25,0:02:41.71,Main,,0,0,0,,Bu kadar mahcup\Ndavranmana gerek yok.
Dialogue: 0,0:02:43.81,0:02:49.62,Main,,0,0,0,,Hem sihrim sayesinde yemek bulmakta\Nhiçbir sıkıntı çekmedim.
Dialogue: 0,0:02:53.76,0:02:58.18,Main,,0,0,0,,Şu anda tabii aç olduğumdan değil ama...
Dialogue: 0,0:02:58.18,0:02:59.72,Main,,0,0,0,,Marul yer misin?
Dialogue: 0,0:02:59.72,0:03:01.24,Main,,0,0,0,,Hayır, istemez.
Dialogue: 0,0:03:01.24,0:03:03.76,Main,,0,0,0,,Senin yemeklerin mideme iyi gelmiyor.
Dialogue: 0,0:03:06.40,0:03:10.88,Main,,0,0,0,,Momonosuke'yle ikiniz\Niyi olduğunuz müddetçe gerisi teferruat.
Dialogue: 0,0:03:11.38,0:03:13.86,Main,,0,0,0,,Senin sayende iyiyiz!
Dialogue: 0,0:03:13.86,0:03:17.71,Main,,0,0,0,,Öyle ha? Momonosuke'yi de görmeyi\Nçok istiyorum!
Dialogue: 0,0:03:17.92,0:03:22.66,Main,,0,0,0,,Evet, Momonosuke de\Nseninle görüşmeyi çok istiyor!
Dialogue: 0,0:03:22.66,0:03:28.47,Main,,0,0,0,,Seninle son görüştüğümüzden bu yana \Nayaküstü anlatılmayacak tonla şey yaşadık!
Dialogue: 0,0:03:28.47,0:03:32.06,Main,,0,0,0,,Daha sonra her şeyi\Ntüm ayrıntısıyla anlatacağım!
Dialogue: 0,0:03:32.24,0:03:35.20,Main,,0,0,0,,Pekâlâ öyleyse, çıkalım buradan!
Dialogue: 0,0:03:35.92,0:03:36.78,Thoughts,,0,0,0,,{\i1}Çıkmak mı?
Dialogue: 0,0:03:36.78,0:03:39.06,Thoughts,,0,0,0,,{\i1}Buradan çıkmanın bir yolu var mı ki?
Dialogue: 0,0:03:46.04,0:03:47.36,Main,,0,0,0,,O da ne?!
Dialogue: 0,0:03:47.36,0:03:49.44,Main,,0,0,0,,Bir şey mi çiziyor?
Dialogue: 0,0:03:55.91,0:03:57.42,Main,,0,0,0,,Göster kendini!
Dialogue: 0,0:04:01.29,0:04:03.09,Main,,0,0,0,,Bahar Serçesi!
Dialogue: 0,0:04:06.89,0:04:08.02,Main,,0,0,0,,Ne?!
Dialogue: 0,0:04:08.02,0:04:09.32,Main,,0,0,0,,Yok artık!
Dialogue: 0,0:04:11.60,0:04:13.80,Main,,0,0,0,,Çizimi hareket etmeye başladı!
Dialogue: 0,0:04:13.80,0:04:15.32,Main,,0,0,0,,Güç kullanıcısı mı yoksa?!
Dialogue: 0,0:04:23.92,0:04:27.01,Main,,0,0,0,,Kuş resmi canlandı!
Dialogue: 0,0:04:27.48,0:04:30.82,Thoughts,,0,0,0,,{\i1}Yalnız berbat çiziyor.{\i0}
Dialogue: 0,0:04:30.82,0:04:32.52,Main,,0,0,0,,{\i1}Harika bir güce sahip olsa da...{\i0}
Dialogue: 0,0:04:32.52,0:04:36.86,Main,,0,0,0,,{\b1}...dandik çizimi yüzünden uçma \Nkonusunda kendine bile hayrı olmayan bir kuş belirdi.
Dialogue: 0,0:04:40.68,0:04:43.40,Main,,0,0,0,,Haydi Kin'emon, gidelim!
Dialogue: 0,0:04:43.40,0:04:44.70,Main,,0,0,0,,Tamamdır!
Dialogue: 0,0:04:46.70,0:04:48.48,Main,,0,0,0,,Bekle biraz!
Dialogue: 0,0:04:49.62,0:04:55.06,Main,,0,0,0,,Bizler oyuncağa dönüştürülmüş\Neski Kral Riku Ordusu askerleriyiz!
Dialogue: 0,0:04:55.06,0:05:00.10,Main,,0,0,0,,Neler oluyor bilmiyor ama\NKral Riku-sama iyi mi?!
Dialogue: 0,0:05:00.88,0:05:03.76,Main,,0,0,0,,Ailelerimiz şehirdeydi!
Dialogue: 0,0:05:03.76,0:05:06.38,Main,,0,0,0,,Yalvarırım bizi de yanınızda götürün!
Dialogue: 0,0:05:06.43,0:05:10.36,Captions,,200,0,20,,Kolezyum Savaşçıları
Dialogue: 0,0:05:06.43,0:05:10.36,Captions,,1070,0,650,,Kral. Sarayı
Dialogue: 0,0:05:06.43,0:05:10.36,Captions,,1180,0,510,,4. Seviye
Dialogue: 0,0:05:06.43,0:05:10.36,Captions,,1180,0,416,,3. Seviye
Dialogue: 0,0:05:06.43,0:05:10.36,Captions,,1180,0,322,,2. Seviye
Dialogue: 0,0:05:06.43,0:05:10.36,Captions,,1180,0,228,,1. Seviye
Dialogue: 0,0:05:14.03,0:05:16.91,Main,,0,0,0,,Hasır Şapkalar'ı durdurun!
Dialogue: 0,0:05:17.60,0:05:20.08,Main,,0,0,0,,Bize ateş etsenize!
Dialogue: 0,0:05:23.54,0:05:25.88,Main,,0,0,0,,{\fad(150,150)}Giyotin Topuklu!
Dialogue: 0,0:05:30.24,0:05:32.92,Main,,0,0,0,,Uzunbacak yenildi!
Dialogue: 0,0:05:32.92,0:05:35.41,Main,,0,0,0,,Orasını boşver şimdi, Hasır Şapka!
Dialogue: 0,0:05:35.41,0:05:39.55,Main,,0,0,0,,Ne pahasına olursa olsun\NDoflamingo'nun yanına ulaşmalıyız!
Dialogue: 0,0:05:39.86,0:05:44.66,Main,,0,0,0,,Doflamingo'nun konuşmasını\Nduyduğum anda anlamıştım.
Dialogue: 0,0:05:45.56,0:05:48.89,Flashbacks,,0,0,0,,{\i1}Beni öldürme oyunu bu.{\i0}
Dialogue: 0,0:05:48.89,0:05:51.80,Flashbacks,,0,0,0,,Ölün ya da öldürün.
Dialogue: 0,0:05:53.98,0:05:57.90,Flashbacks,,0,0,0,,Ülkedeki herkes avcıya dönüşecek.
Dialogue: 0,0:05:58.11,0:06:01.70,Flashbacks,,0,0,0,,Hayatta kalmanızın tek yolu...
Dialogue: 0,0:06:01.70,0:06:05.90,Flashbacks,,0,0,0,,...birilerini öldürmeniz!
Dialogue: 0,0:06:08.22,0:06:11.48,Main,,0,0,0,,Bu Kuş Kafesi isimli oyun\Nyalandan ibaret!
Dialogue: 0,0:06:19.56,0:06:23.96,Main,,0,0,0,,Silah kaçakçılığı ve oyuncaklara dair\Nsırlar açığa çıktığı anda...
Dialogue: 0,0:06:23.96,0:06:28.84,Main,,0,0,0,,...ülkedeki herkesin ortadan kaldırılacağı\Nkesinleşmişti zaten.
Dialogue: 0,0:06:29.26,0:06:33.29,Main,,0,0,0,,Doflamingo bu bilgilerin\Nülke dışına çıkmasına izin vermez.
Dialogue: 0,0:06:33.29,0:06:36.94,Main,,0,0,0,,O yüzden de Kuş Kafesi'yle\Ntüm adayı kapattı.
Dialogue: 0,0:06:37.31,0:06:40.55,Main,,0,0,0,,Yani Dressrosa şimdi...
Dialogue: 0,0:06:40.55,0:06:44.28,Main,,0,0,0,,...dünyayla ilişiği kesilmiş\Nmünferit bir ada!
Dialogue: 0,0:06:44.53,0:06:50.32,Main,,0,0,0,,Mucizelerden medet umup\Noyunun sonlanmasını beklemek hepimizin sonu olacak!
Dialogue: 0,0:06:52.34,0:06:58.93,Main,,0,0,0,,Bu adadan kurtulmanın tek yolu ardımıza bakmadan \NDoflamingo'nun canını almaktan geçiyor!
Dialogue: 0,0:06:59.26,0:07:02.45,Main,,0,0,0,,Ülke pek çok sorun yaşıyor.
Dialogue: 0,0:07:02.45,0:07:05.24,Main,,0,0,0,,Etrafında bunca beklenmedik şey\Nyaşanmasına rağmen...
Dialogue: 0,0:07:05.24,0:07:08.66,Main,,0,0,0,,...Doflamingo'ysa bu olanlardan\Nzevk alıyor gibi görünüyor.
Dialogue: 0,0:07:14.44,0:07:18.94,Main,,0,0,0,,Doflamingo kadar kurnaz birini\Ngörmedim ben.
Dialogue: 0,0:07:20.00,0:07:28.13,Main,,0,0,0,,Fakat olacak her şeye hazırlıklı,\Nherkesten daha kurnaz Doflamingo tek bir hata yaptı.
Dialogue: 0,0:07:28.13,0:07:31.70,Main,,0,0,0,,O hatası da yapılan Kolezyum\Nmüsabakasına dünyanın dört...
Dialogue: 0,0:07:31.73,0:07:35.30,Main,,0,0,0,,...bir yanından onlarca güçlü\Nsavaşçıyı çağırması oldu.
Dialogue: 0,0:07:35.30,0:07:37.90,Main,,0,0,0,,Yenilmeyeceğiz!
Dialogue: 0,0:07:38.24,0:07:43.67,Main,,0,0,0,,Çünkü öyle ya da böyle\NDoflamingo'nun canını alacağım!
Dialogue: 0,0:07:43.67,0:07:48.26,Main,,0,0,0,,Ne diyorsun sen be?!\NMingo'nun kıçına tekmeyi ben basacağım!
Dialogue: 0,0:07:48.26,0:07:51.15,Main,,0,0,0,,Benim o demiştim, Hasır Şapka-ya!
Dialogue: 0,0:07:51.15,0:07:53.78,Main,,0,0,0,,Neler hissettiğinizi anlıyorum ama\No benim olacak!
Dialogue: 0,0:07:53.78,0:07:58.18,Main,,0,0,0,,Asker, sen daha demin yöneticilerden\Nbirini öldürmek istiyorum demedin mi?!
Dialogue: 0,0:07:58.18,0:08:04.04,Main,,0,0,0,,Yönetici özel bir mesele! Kral Riku'nun\Nülkesini geri almaksa mutlak görevim!
Dialogue: 0,0:08:04.04,0:08:08.30,Main,,0,0,0,,10 yıl önce başlamış o trajediye\Nson vermeliyim!
Dialogue: 0,0:08:08.54,0:08:11.50,Main,,0,0,0,,Ona bakarsan benimkisi\N13 sene öncesinden gelen bir garez!
Dialogue: 0,0:08:11.72,0:08:14.00,Main,,0,0,0,,O zaman benimki de\N30 sene öncesinden geliyor!
Dialogue: 0,0:08:14.00,0:08:18.82,Main,,0,0,0,,Yalan söyleme be!\NBenden yaşlı olmana imkan yok!
Dialogue: 0,0:08:20.10,0:08:21.60,Main,,0,0,0,,İnin attan!
Dialogue: 0,0:08:21.60,0:08:22.82,Main,,0,0,0,,Asıl sen in!
Dialogue: 0,0:08:22.82,0:08:24.56,Main,,0,0,0,,Yol bitiyor!
Dialogue: 0,0:08:30.78,0:08:32.72,Main,,0,0,0,,Üçüncü kata vardık sayılır!
Dialogue: 0,0:08:32.90,0:08:36.50,Main,,0,0,0,,Tamamdır! Aynen böyle\Ndördüncü kata yardıralım...
Dialogue: 0,0:08:36.50,0:08:38.53,Main,,0,0,0,,...at!
Dialogue: 0,0:08:51.68,0:08:54.32,Main,,0,0,0,,Bu koca oyuncak bebekler de\Nneyin nesi?!
Dialogue: 0,0:08:54.35,0:08:56.57,Captions,,0,980,250,,{\fad(300,300)}Pica Heykeli \NTepesi
Dialogue: 0,0:08:56.63,0:08:58.40,Captions,,0,0,330,,{\fad(300,300)}Zoro, Pica'ya Karşı
Dialogue: 0,0:09:07.94,0:09:12.50,Main,,0,0,0,,Bu halinle Hasır Şapkalar'ı yenebileceğini\Ndüşünmen büyük cesaret doğrusu!
Dialogue: 0,0:09:15.57,0:09:17.96,Main,,0,0,0,,Lanet olası!
Dialogue: 0,0:09:26.66,0:09:27.75,Main,,0,0,0,,Kahretsin!
Dialogue: 0,0:09:34.89,0:09:36.42,Main,,0,0,0,,Kaçtı!
Dialogue: 0,0:09:43.68,0:09:45.76,Main,,0,0,0,,{\fad(150,150)}Pulpotaşı!
Dialogue: 0,0:09:45.76,0:09:46.74,Main,,0,0,0,,Ne?!
Dialogue: 0,0:09:48.08,0:09:50.23,Main,,0,0,0,,Neden uçuyorsunuz?!
Dialogue: 0,0:09:50.23,0:09:50.88,Main,,0,0,0,,Zo-!
Dialogue: 0,0:09:50.88,0:09:53.14,Main,,0,0,0,,Z-Z-Z-Z-Zoro-senpai bu!
Dialogue: 0,0:09:53.14,0:09:58.12,Main,,0,0,0,,İmzalı resminizi vereceğinizi\Nhatırlıyorsunuz değil mi?!
Dialogue: 0,0:09:58.52,0:10:00.38,Main,,0,0,0,,Bu... Pica!
Dialogue: 0,0:10:00.96,0:10:02.22,Main,,0,0,0,,Rebecca!
Dialogue: 0,0:10:02.22,0:10:03.53,Main,,0,0,0,,O da kim?
Dialogue: 0,0:10:03.53,0:10:08.52,Main,,0,0,0,,Trebol ve Diamante'yle birlikte \NDon Quixote Ailesi'nin üst düzey yöneticilerinden biri!
Dialogue: 0,0:10:09.12,0:10:11.66,Main,,0,0,0,,Zoro, düşmanı aşağıda tut lütfen!
Dialogue: 0,0:10:12.08,0:10:16.12,Main,,0,0,0,,Bu taş figürün\Nötesine geçmemiz lazım!
Dialogue: 0,0:10:12.75,0:10:17.08,Captions,,0,0,0,,{\move(-250,65,810,65,0,880)\fad(500,0)}Ayçiçeği Tarlası
Dialogue: 0,0:10:12.75,0:10:17.08,Captions,,0,0,0,,{\move(-715,190,345,190,0,880)\fad(500,0)}Şu anki Konum
Dialogue: 0,0:10:18.02,0:10:19.76,Main,,0,0,0,,Tutarım tutmasına da...
Dialogue: 0,0:10:19.76,0:10:23.12,Main,,0,0,0,,...siz niye uçuyorsunuz,\Nonu deyin!
Dialogue: 0,0:10:24.20,0:10:26.83,Main,,0,0,0,,Aha! Düşman kaçtı!
Dialogue: 0,0:10:27.46,0:10:29.88,Main,,0,0,0,,Hayır, kaçmamış lan!
Dialogue: 0,0:10:29.88,0:10:31.94,Main,,0,0,0,,Saraya ulaşmanıza müsaade etmem!
Dialogue: 0,0:10:39.54,0:10:41.16,Main,,0,0,0,,Orada demek?
Dialogue: 0,0:10:42.70,0:10:44.46,Main,,0,0,0,,Yok artık!
Dialogue: 0,0:10:44.46,0:10:47.82,Main,,0,0,0,,Bizi hedef alıyor!
Dialogue: 0,0:10:47.82,0:10:48.84,Main,,0,0,0,,Bariyer yapsana!
Dialogue: 0,0:10:48.84,0:10:52.33,Main,,0,0,0,,Bu devasa yumruğa\Ndayanabilecek bir bariyer yapamam!
Dialogue: 0,0:10:52.33,0:10:55.40,Main,,0,0,0,,Olamaz!\NBu gidişle...
Dialogue: 0,0:10:55.40,0:10:58.82,Main,,0,0,0,,...yumruğu yiyeceğiz!
Dialogue: 0,0:11:02.72,0:11:04.36,Main,,0,0,0,,{\fad(150,150)}3 Kılıç Stili!
Dialogue: 0,0:11:04.36,0:11:07.88,Main,,0,0,0,,{\fad(150,150)}Bin Seksen Libre Anka Kuşu!
Dialogue: 0,0:11:26.16,0:11:28.50,Main,,0,0,0,,Gücünün nasıl çalıştığını\Nanlamaya başladım!
Dialogue: 0,0:11:33.80,0:11:36.96,Main,,0,0,0,,Sana söylemeyi unuttuğum\Nbir şey var.
Dialogue: 0,0:11:37.84,0:11:40.32,Main,,0,0,0,,Hasır Şapka tayfası yalnızca...
Dialogue: 0,0:11:40.32,0:11:43.88,Main,,0,0,0,,...Hasır Şapkalı Luffy ve\NTanrı Usopp'dan oluşmuyor.
Dialogue: 0,0:11:44.66,0:11:46.18,Main,,0,0,0,,Unutma bunu!
Dialogue: 0,0:11:46.18,0:11:50.44,Main,,0,0,0,,Günün birinde dünyadaki en büyük\Nkılıç ustası olacak adamım ben!
Dialogue: 0,0:11:54.94,0:11:59.80,Main,,0,0,0,,Doro-tenpai!
Dialogue: 0,0:11:59.83,0:12:06.55,Captions,,0,880,610,,{\fad(250,0)}Ticaret Limanı \NAltı
Dialogue: 0,0:12:00.82,0:12:06.53,Captions,,0,0,0,,{\move(820,760,820,400,1750,0)\fr(1)}Yönetim Kulesi
Dialogue: 0,0:12:02.09,0:12:06.53,Captions,,0,0,0,,{\move(940,780,940,658,500,0)\fr(1)}Hurdalık
Dialogue: 0,0:12:08.08,0:12:09.44,Main,,0,0,0,,Harika be!
Dialogue: 0,0:12:09.44,0:12:11.06,Main,,0,0,0,,Çok teşekkür ederiz, Samuray!
Dialogue: 0,0:12:11.06,0:12:13.82,Main,,0,0,0,,Sonunda buradan kurtulabileceğiz!
Dialogue: 0,0:12:13.82,0:12:15.56,Main,,0,0,0,,Sırayla tırmanın!
Dialogue: 0,0:12:15.56,0:12:18.24,Main,,0,0,0,,Çizgi merdiven sonuçta, çabuk kırılırlar!
Dialogue: 0,0:12:18.80,0:12:21.14,Main,,0,0,0,,Çizgiler düzgün değil,\Ntırmanmak bir ölüm resmen!
Dialogue: 0,0:12:21.14,0:12:23.90,Main,,0,0,0,,Şikayet etme, nankör!
Dialogue: 0,0:12:27.07,0:12:31.98,Captions,,0,0,0,,{\fad(300,300)}GÜLÜCÜK Fabrikasının İçi
Dialogue: 0,0:12:32.06,0:12:34.40,Main,,0,0,0,,Küçük insanlar çıldırdı!
Dialogue: 0,0:12:34.40,0:12:36.12,Main,,0,0,0,,Kontrol altına alın!
Dialogue: 0,0:12:43.82,0:12:46.18,Main,,0,0,0,,Olmayacak böyle,\Nonları kontrol altına alamıyoruz!
Dialogue: 0,0:12:46.18,0:12:48.72,Main,,0,0,0,,Vazgeçme!\NAteşe devam!
Dialogue: 0,0:12:53.20,0:12:56.82,Main,,0,0,0,,Kötü insanların mermilerine hedef olmayız!
Dialogue: 0,0:13:09.32,0:13:12.90,Main,,0,0,0,,Bekleyin!\NPrenses Mansherry'yi hiç mi düşünmüyorsunuz?!
Dialogue: 0,0:13:13.10,0:13:14.35,Main,,0,0,0,,Ne?
Dialogue: 0,0:13:14.35,0:13:20.82,Main,,0,0,0,,Buradan giderseniz\NPrenses Mansherry hiç iyileşemez!
Dialogue: 0,0:13:20.82,0:13:23.29,Main,,0,0,0,,Bu-Bunu istemeyiz elbette!
Dialogue: 0,0:13:23.68,0:13:26.96,Main,,0,0,0,,Olmaz!\NKulaklarını tıka, Chao!
Dialogue: 0,0:13:27.75,0:13:32.47,Main,,0,0,0,,Pekâlâ, anladıysanız usul usul\Nsavaşmayı bırakıp sözümüzü...
Dialogue: 0,0:13:32.47,0:13:33.26,Main,,0,0,0,,Ne?!
Dialogue: 0,0:13:33.26,0:13:37.40,Main,,0,0,0,,Kulak tıkacım sayesinde\Naptal yalanlarınızı duymuyorum artık!
Dialogue: 0,0:13:38.20,0:13:41.30,Main,,0,0,0,,{\fad(150,150)}Tontatta Çevirişi!
Dialogue: 0,0:13:47.60,0:13:49.04,Main,,0,0,0,,Genç Bey'e haber yolla!
Dialogue: 0,0:13:49.04,0:13:50.29,Main,,0,0,0,,Tamamdır!
Dialogue: 0,0:13:51.21,0:13:53.36,Main,,0,0,0,,İzin vermeyiz!
Dialogue: 0,0:13:54.08,0:13:56.28,Main,,0,0,0,,{\fad(150,150)}Tontatta Kuyruğu...
Dialogue: 0,0:13:56.28,0:13:58.78,Main,,0,0,0,,{\fad(150,150)}...Dörtlü Çekiç!
Dialogue: 0,0:14:01.32,0:14:07.98,Main,,0,0,0,,Millet, onlar destek çağırmadan önce\Ntüm Den Den Mushileri serbest bırakın!
Dialogue: 0,0:14:09.14,0:14:10.80,Main,,0,0,0,,Beni dinliyor musunuz siz?!
Dialogue: 0,0:14:10.80,0:14:11.96,Main,,0,0,0,,Ne?
Dialogue: 0,0:14:12.54,0:14:14.30,Main,,0,0,0,,Tıkaçları çıkarın!
Dialogue: 0,0:14:14.33,0:14:19.21,Captions,,0,0,320,,{\fad(300,200)}Prensesin Yaveri\NMouji
Dialogue: 0,0:14:15.26,0:14:17.60,Main,,0,0,0,,Hastalığının yalandan olmasına sevindim!
Dialogue: 0,0:14:17.60,0:14:21.00,Main,,0,0,0,,Fakat prenses bunca zamandır\Nfabrikanın bir köşesinde tek başınaydı!
Dialogue: 0,0:14:21.58,0:14:23.65,Main,,0,0,0,,Yalnızlığı bilirim!
Dialogue: 0,0:14:23.65,0:14:26.74,Main,,0,0,0,,Yalnızlığın... Yalnızlığın nasıl bir şey\Nolduğunu çok iyi bilirim!
Dialogue: 0,0:14:25.52,0:14:26.74,Secondary,,0,0,0,,Bekle!
Dialogue: 0,0:14:26.94,0:14:29.68,Main,,0,0,0,,Prensesin ağlayışlarını duyabiliyorum adeta!
Dialogue: 0,0:14:29.68,0:14:32.35,Main,,0,0,0,,Adımı haykırarak ağlıyor!
Dialogue: 0,0:14:33.34,0:14:34.36,Main,,0,0,0,,Mouji!
Dialogue: 0,0:14:34.36,0:14:38.34,Main,,0,0,0,,Tecrit koğuşu bu!\NPrenses Mansherry orada olmalı!
Dialogue: 0,0:14:39.76,0:14:41.89,Main,,0,0,0,,Seni kurtarmaya geliyorum!
Dialogue: 0,0:14:42.10,0:14:43.88,Main,,0,0,0,,Bekle lütfen!
Dialogue: 0,0:14:43.88,0:14:45.24,Main,,0,0,0,,Nedenmiş o?!
Dialogue: 0,0:14:45.24,0:14:47.46,Main,,0,0,0,,Kapıda yazana bakın!
Dialogue: 0,0:14:49.18,0:14:52.46,Main,,0,0,0,,"İçeri Girme!" yazıyor.\NGiremeyiz!
Dialogue: 0,0:14:52.46,0:14:57.62,Main,,0,0,0,,Ney?! \NBunu daha önce söylemeliydiniz!
Dialogue: 0,0:14:57.62,0:15:01.54,Main,,0,0,0,,Yavaşlayamam artık!
Dialogue: 0,0:15:02.38,0:15:05.62,Main,,0,0,0,,Mouji kapısında "İçeri Girme!" yazan\Nkapıyı kırdı!
Dialogue: 0,0:15:05.86,0:15:07.96,Main,,0,0,0,,Büyük hayal kırıklığına uğrattın beni!
Dialogue: 0,0:15:07.96,0:15:11.04,Main,,0,0,0,,O uyarıyı kafana göre içeri gireme diye\Nkoyuyorlar oraya herhâlde!
Dialogue: 0,0:15:11.04,0:15:12.86,Main,,0,0,0,,Özür dilerim...
Dialogue: 0,0:15:13.35,0:15:16.83,Main,,0,0,0,,Kimse yok burada!\NBildiğin depo burası.
Dialogue: 0,0:15:18.42,0:15:20.76,Main,,0,0,0,,Hazır mısınız?!
Dialogue: 0,0:15:20.76,0:15:22.72,Main,,0,0,0,,Bir iki!
Dialogue: 0,0:15:23.78,0:15:25.44,Main,,0,0,0,,Acele edin!
Dialogue: 0,0:15:29.56,0:15:33.53,Captions,,0,0,175,,{\fad(1000,0)}GÜLÜCÜK Fabrikasının Önü
Dialogue: 0,0:15:29.76,0:15:33.83,Main,,0,0,3,,Ay çok acımasızsın, Senyor!
Dialogue: 0,0:15:36.10,0:15:38.08,Main,,0,0,0,,Neredeyse oldu!
Dialogue: 0,0:15:41.40,0:15:42.90,Captions,,550,0,500,,{\ko12}F{\ko12}ra{\ko16}n{\ko8}k{\ko24}y {\ko16}Kula{\ko316}ğı
Dialogue: 0,0:15:41.38,0:15:42.90,Narrator,,0,0,0,,Franky Kulağı.
Dialogue: 0,0:15:42.90,0:15:45.81,Narrator,,0,0,0,,{\i1}Franky'nin kulağı\Ndoğal olarak çok iyi işitir.{\i0}
Dialogue: 0,0:15:46.66,0:15:49.94,Main,,0,0,0,,Yüzücü dostum...
Dialogue: 0,0:15:50.92,0:15:54.56,Main,,0,0,0,,Seni belki ilgilendirmez ama...
Dialogue: 0,0:15:54.56,0:15:56.06,Main,,0,0,0,,...az evvel...
Dialogue: 0,0:15:57.96,0:16:05.88,Main,,0,0,0,,...şu sağdaki sokakta yaşlı zayıf bir ninenin başının\Ndertte olduğunu gördüm!
Dialogue: 0,0:16:07.01,0:16:10.93,Main,,0,0,0,,Hadi ya?\NÜzüldüm.
Dialogue: 0,0:16:12.66,0:16:15.68,Main,,0,0,0,,Çarkı çevirip kapıyı açın!
Dialogue: 0,0:16:16.62,0:16:20.14,Main,,0,0,0,,Bekleyin bakalım, bamyalar sizi!
Dialogue: 0,0:16:21.74,0:16:30.36,Captions,,0,0,240,,{\fad(500,0)}KUWEEN (20 Yaşında, Kadın)\NGülücük Fabrikası Fabrika Yöneticisi
Dialogue: 0,0:16:25.52,0:16:28.04,Main,,0,0,3,,Şansınızı fazla zorlamayın!
Dialogue: 0,0:16:28.04,0:16:30.66,Main,,0,0,3,,Dışarı çıkmanıza izin vermeyeceğim!
Dialogue: 0,0:16:31.90,0:16:34.67,Main,,0,0,0,,Eyvah, fabrika yöneticisi bu!
Dialogue: 0,0:16:35.30,0:16:41.26,Main,,0,0,0,,Siz en başından beri GÜLÜCÜK üretmek için\Nkullandığımız kölelerdiniz!
Dialogue: 0,0:16:41.26,0:16:45.84,Main,,0,0,0,,Bunu yeni yeni fark edip de\Nortalığı galeyana getirmenize gerek yok!
Dialogue: 0,0:16:50.14,0:16:53.05,Main,,0,0,0,,Hepimizi oraya çekip\Nbizi yeniden yakalama niyetinde!
Dialogue: 0,0:16:53.05,0:16:55.59,Main,,0,0,0,,Çabuk kapıyı açın!
Dialogue: 0,0:17:12.74,0:17:15.20,Main,,0,0,0,,Ellerinize sağlık,\Nbeyler bayanlar!
Dialogue: 0,0:17:16.15,0:17:18.43,Main,,0,0,0,,Robot bu!
Dialogue: 0,0:17:18.43,0:17:22.02,Main,,0,0,0,,Robot bizi kurtarmaya gelmiş!
Dialogue: 0,0:17:22.02,0:17:23.46,Main,,0,0,0,,Teşekkür ederiz!
Dialogue: 0,0:17:23.46,0:17:24.58,Main,,0,0,0,,Robot!
Dialogue: 0,0:17:24.58,0:17:26.02,Main,,0,0,0,,Dehşet bir şey!
Dialogue: 0,0:17:26.02,0:17:27.84,Main,,0,0,0,,Herkes iyi mi?
Dialogue: 0,0:17:28.58,0:17:29.90,Main,,0,0,0,,Nasılsınız?!
Dialogue: 0,0:17:29.90,0:17:32.04,Main,,0,0,0,,Sizi kurtarmaya geldik!
Dialogue: 0,0:17:33.52,0:17:36.24,Main,,0,0,0,,Bizi kurtarmaya mı geldiniz?
Dialogue: 0,0:17:41.86,0:17:44.74,Main,,0,0,0,,Ne sevindim var ya!
Dialogue: 0,0:17:44.74,0:17:46.36,Main,,0,0,0,,Teşekkür ederiz Robot-san!
Dialogue: 0,0:17:46.36,0:17:48.41,Main,,0,0,0,,Adı Robot değil onun!
Dialogue: 0,0:17:48.41,0:17:51.94,Main,,0,0,0,,Kurtarıcımız, büyük insan Fraland!
Dialogue: 0,0:17:51.94,0:17:53.56,Main,,0,0,0,,Büyük insan mı?!
Dialogue: 0,0:17:54.50,0:17:57.20,Main,,0,0,0,,Şu Prenses Mansherry nasıl biri ki?
Dialogue: 0,0:17:57.20,0:17:58.82,Main,,0,0,0,,Prenses Mansherry...
Dialogue: 0,0:18:00.32,0:18:01.70,Main,,0,0,0,,Bana baksanıza siz,...
Dialogue: 0,0:18:01.70,0:18:05.44,Main,,0,0,0,,...unuttunuz beni burada resmen!
Dialogue: 0,0:18:07.20,0:18:08.16,Main,,0,0,0,,Bu fabrika...
Dialogue: 0,0:18:08.16,0:18:08.87,Main,,0,0,0,,...benim...
Dialogue: 0,0:18:08.87,0:18:10.16,Main,,0,0,0,,...hayatım!
Dialogue: 0,0:18:10.16,0:18:15.30,Main,,0,0,0,,Fabrika müdürüyüm.\NFabrikadaki en yetkili kişi benim!
Dialogue: 0,0:18:23.00,0:18:26.96,Main,,0,0,0,,Sen de Hasır Şapka tayfasından\NSayborg Franky olmalısın.
Dialogue: 0,0:18:26.96,0:18:31.76,Main,,0,0,0,,Kafandaki tek yıldızlık ödüle rağmen\Nburaya kadar sağ salim gelebilmene şaşırdım.
Dialogue: 0,0:18:32.09,0:18:34.75,Main,,0,0,0,,Pink-sama'ya ne yaptın?!
Dialogue: 0,0:18:34.75,0:18:36.47,Main,,0,0,0,,O ahmağı mı soruyorsun?
Dialogue: 0,0:18:36.47,0:18:40.46,Main,,0,0,0,,Bu fabrikada gönlünüzce at koşturmanıza\Nmüsaade etmeyeceğim!
Dialogue: 0,0:18:40.46,0:18:43.26,Main,,0,0,0,,Ellerimde can vereceksin!
Dialogue: 0,0:18:43.26,0:18:45.54,Main,,0,0,0,,Dikkat et!\NKaç Fraland!
Dialogue: 0,0:18:52.59,0:18:57.18,Main,,0,0,0,,Fraland fabrika müdürüne sarıldı!
Dialogue: 0,0:18:57.96,0:19:01.84,Main,,0,0,0,,Ne yapıyorsun sen be?!\NAmacın ne? Bırak beni!
Dialogue: 0,0:19:01.84,0:19:05.44,Main,,0,0,0,,Fraland müdüre aşık mı oldu acaba?!
Dialogue: 0,0:19:06.00,0:19:10.02,Main,,0,0,0,,O sayborg adisi\Nbeni kandırdı anlaşılan.
Dialogue: 0,0:19:10.38,0:19:13.88,Main,,0,0,0,,Başı dertte ihtiyar falan\Nyok burada.
Dialogue: 0,0:19:15.15,0:19:18.31,Main,,0,0,0,,Gerçi olmaması içimi rahatlattı.
Dialogue: 0,0:19:18.31,0:19:20.90,Main,,0,0,0,,Ay ne erkeksi!
Dialogue: 0,0:19:20.90,0:19:25.78,Main,,0,0,0,,Senyor Pink, ben hazırım!\Nİstediğin an saldırabilirsin!
Dialogue: 0,0:19:25.78,0:19:29.98,Main,,0,0,0,,Fabrikanın ahlakını bozmayın!
Dialogue: 0,0:19:29.98,0:19:35.02,Main,,0,0,0,,O adi herif supleksleriyle\Noradan oraya savurdu beni!
Dialogue: 0,0:19:35.64,0:19:41.20,Main,,0,0,0,,Kafamın arka tarafıyla doğal kaynak kuyusu falan mı kazmaya çalışıyordu dersin?!
Dialogue: 0,0:19:41.96,0:19:44.00,Main,,0,0,0,,Ne diyorsun sen be?!
Dialogue: 0,0:19:44.00,0:19:45.52,Main,,0,0,0,,Geber!
Dialogue: 0,0:19:45.52,0:19:48.04,Main,,0,0,0,,{\fad(150,150)}Kedi Kulağı Yumruğu!
Dialogue: 0,0:19:48.04,0:19:52.12,Main,,0,0,0,,{\fad(150,150)}Franky Güney Supleksi!
Dialogue: 0,0:20:15.98,0:20:17.96,Main,,0,0,0,,Eyvah!\NMüdür...
Dialogue: 0,0:20:17.96,0:20:22.52,Main,,0,0,0,,Acıdı be lanet olası!\NKafamı ne cüretle çekiç gibi kullanırsın?!
Dialogue: 0,0:20:22.52,0:20:25.14,Main,,0,0,0,,Hangi cüretle\Nbana böyle kaba davranırsın?!
Dialogue: 0,0:20:25.14,0:20:29.45,Main,,0,0,0,,Fabrikanın müdürüyüm,\Nburadaki en yetkili kişiyim ben be!
Dialogue: 0,0:20:29.45,0:20:33.68,Main,,0,0,0,,Bir kere kızdım mı\Nonu kimse durduramaz!
Dialogue: 0,0:20:33.68,0:20:35.45,Main,,0,0,0,,Kaç lütfen, Fraland!
Dialogue: 0,0:20:35.45,0:20:41.55,Main,,0,0,0,,Seni küçük parçalara ayırıp süpürgemle bağırsaklarını çektikten sonra onları vura vura kıymaya çevireceğim!
Dialogue: 0,0:20:41.80,0:20:45.24,Main,,0,0,0,,Ağlamaya başlasan iyi edersin, seni...
Dialogue: 0,0:20:47.26,0:20:51.96,Main,,0,0,0,,Fraland fabrika müdürünü öptü!
Dialogue: 0,0:21:03.82,0:21:07.12,Main,,0,0,0,,{\i1}Öpücüğüm...{\i0}
Dialogue: 0,0:21:07.52,0:21:11.54,Main,,0,0,0,,{\i1}Öpücüğümü çaldı.{\i0}
Dialogue: 0,0:21:13.90,0:21:16.14,Main,,0,0,0,,Kalk bakalım, yüzücü hergele!
Dialogue: 0,0:21:16.14,0:21:17.58,Main,,0,0,0,,H-Hey!
Dialogue: 0,0:21:17.58,0:21:20.96,Main,,0,0,0,,Dur bakalım!\NNe yaptığını sanıyorsun sen?!
Dialogue: 0,0:21:20.96,0:21:23.42,Main,,0,0,0,,Neden yaptın bunu şimdi?
Dialogue: 0,0:21:23.42,0:21:26.94,Main,,0,0,0,,Şimdi sorumluluğu üstlen\Nve sevgilim ol!
Dialogue: 0,0:21:26.94,0:21:29.31,Main,,0,0,0,,Aptal şey seni!
Dialogue: 0,0:21:29.31,0:21:32.80,Main,,0,0,0,,{\i1}Müdür biraz daha\Nkadınsı davranmaya başladı.{\i0}
Dialogue: 0,0:21:33.76,0:21:36.94,Main,,0,0,0,,Suç onda değil, müdür hanım.
Dialogue: 0,0:21:36.94,0:21:38.35,Main,,0,0,0,,Ne?
Dialogue: 0,0:21:38.35,0:21:40.22,Main,,0,0,0,,Bu işe karışarak sen hata ettin.
Dialogue: 0,0:21:40.22,0:21:42.10,Main,,0,0,0,,Pink-sama, fakat...
Dialogue: 0,0:21:42.70,0:21:45.28,Main,,0,0,0,,Erkek erkeğe bir kavgaya...
Dialogue: 0,0:21:45.28,0:21:52.14,Main,,0,0,0,,...maydanoz olan kadının ağzını\Nbaşka nasıl kapatabiliriz ki?
Dialogue: 0,0:21:53.44,0:21:59.62,Main,,0,0,0,,Birkaç öpücüğe moral bozman\Ndünya görmemiş bir kız olduğunu gösterir.
Dialogue: 0,0:21:59.62,0:22:02.80,Main,,0,0,0,,Aşktan, ilişkilerden falan bahsetmek için\Nçok toysun daha!
Dialogue: 0,0:22:02.80,0:22:04.86,Main,,0,0,0,,Ha şunu bileydin.
Dialogue: 0,0:22:05.20,0:22:07.80,Main,,0,0,0,,Böyle dünya görmemiş bir kızla\Naşk yaşamak...
Dialogue: 0,0:22:08.57,0:22:11.11,Main,,0,0,0,,İstemez kalsın!
Dialogue: 0,0:22:16.84,0:22:19.65,Main,,0,0,0,,Ay ne erkeksi!
Dialogue: 0,0:22:19.84,0:22:22.30,Main,,0,0,0,,Senyor, Franky!
Dialogue: 0,0:22:22.30,0:22:25.32,Main,,0,0,0,,İkiniz de çok erkeksisiniz!
Dialogue: 0,0:22:25.32,0:22:28.63,Main,,0,0,0,,Fabrikayı yok etmene\Nmüsaade etmeyeceğim!
Dialogue: 0,0:22:29.28,0:22:32.53,Main,,0,0,0,,Erkeksen yumruklarınla kanıtlarsın sözünü!
Dialogue: 0,0:22:32.53,0:22:35.60,Main,,0,0,0,,Erkeklerin savaşı başlayacak!
Dialogue: 0,0:22:38.67,0:22:41.41,Main,,0,0,0,,{\fad(150,150)}Bebek Bezi Bombası!
Dialogue: 0,0:22:42.76,0:22:45.78,Main,,0,0,0,,{\fad(150,150)}Meme Ucu Işını Özel!
Dialogue: 0,0:22:50.53,0:22:56.90,Captions,,0,0,235,,{\fad(1000,0)}Kraliyet Sarayı Platosu\NPica Heykeli
Dialogue: 0,0:22:52.92,0:22:56.28,Main,,0,0,3,,{\an8}Taşlarla birleşme zırvalığına\Nson verdin demek?
Dialogue: 0,0:22:59.60,0:23:02.78,Main,,0,0,0,,Rebeccalar'ın kaçmasına\Nnasıl izin verirsin?!
Dialogue: 0,0:23:02.78,0:23:06.00,Main,,0,0,0,,Çok sağ ol.\NSen olmasan yapamazdım.
Dialogue: 0,0:23:06.22,0:23:10.12,Main,,0,0,0,,Sizin gibi gerizekalıların\Nbu ülkeden kaçabileceklerini sanma!
Dialogue: 0,0:23:10.12,0:23:14.43,Main,,0,0,0,,İkinci seviyeye vardık sayılır!\NZıplayacağınız noktaya dikkat edin!
Dialogue: 0,0:23:18.44,0:23:20.18,Main,,0,0,0,,Alo, Leo konuşuyor.
Dialogue: 0,0:23:20.18,0:23:21.24,Main,,0,0,0,,Mouji!
Dialogue: 0,0:23:21.24,0:23:23.07,Main,,0,0,0,,Mouji, şükürler olsun!
Dialogue: 0,0:23:23.07,0:23:25.62,Main,,0,0,0,,Dostlarımızın\Nserbest kaldığı anlamına geliyor bu!
Dialogue: 0,0:23:25.62,0:23:28.70,Main,,0,0,0,,{\i1}Fakat Leo, büyük bir sorunumuz var!{\i0}
Dialogue: 0,0:23:28.70,0:23:30.25,Main,,0,0,0,,Ne oldu?
Dialogue: 0,0:23:30.25,0:23:33.02,Main,,0,0,0,,Prenses...\NPrenses Mansherry...
Dialogue: 0,0:23:33.26,0:23:36.02,Main,,0,0,0,,...fabrikanın hiçbir yerinde yok!
Dialogue: 0,0:23:36.02,0:23:36.64,Main,,0,0,0,,Ne?!
Dialogue: 0,0:23:36.64,0:23:37.85,Main,,0,0,0,,{\i1}Zavallıcık.{\i0}
Dialogue: 0,0:23:37.85,0:23:43.27,Main,,0,0,0,,{\i1}Kapatıldığı yerlerde "Mouji! Mouji!" diye\Nağlıyordur şimdi!{\i0}
Dialogue: 0,0:23:43.27,0:23:45.16,Main,,0,0,0,,Nasıl olur?!
Dialogue: 0,0:23:45.62,0:23:48.03,Main,,0,0,0,,Kral Tepesi'ne gidelim!
Dialogue: 0,0:23:48.03,0:23:51.11,Main,,0,0,0,,Evet!
Dialogue: 0,0:23:51.28,0:23:54.58,Secondary,,0,0,3,,{\an8}Kral Riku'yla\NTanrı Usopp'u yakalayalım!
Dialogue: 0,0:23:51.36,0:23:54.29,Captions,,0,0,180,,{\fad(500,0)}Eski Kralın Platosu
Dialogue: 0,0:23:54.58,0:24:00.51,Main,,0,0,0,,Korkacak bir şey yok.\NBuraya o kadar kolay tırmanamazlar.
Dialogue: 0,0:24:00.51,0:24:03.20,Main,,0,0,0,,Tanrı Usopp'u öldürün!
Dialogue: 0,0:24:04.34,0:24:07.54,Main,,0,0,0,,Baba, fabrikadaki tontattalardan\Nhaber geldi!
Dialogue: 0,0:24:07.54,0:24:09.26,Main,,0,0,0,,İyiler demek?
Dialogue: 0,0:24:09.26,0:24:10.26,Main,,0,0,0,,Evet.
Dialogue: 0,0:24:10.86,0:24:14.03,Main,,0,0,0,,Fakat Prenses Mansherry'i\Nhiçbir yerde bulamamışlar.
Dialogue: 0,0:24:14.03,0:24:15.24,Main,,0,0,0,,Ne?!
Dialogue: 0,0:24:15.24,0:24:17.44,Main,,0,0,0,,Ne konuşuyorsunuz siz orada?!
Dialogue: 0,0:24:17.44,0:24:19.74,Main,,0,0,0,,Ülkedeki herkes bizim peşimizde be!
Dialogue: 0,0:24:19.74,0:24:21.34,Main,,0,0,0,,Kaçalım hemen!
Dialogue: 0,0:24:21.34,0:24:25.88,Main,,0,0,0,,Ülkedeki herkes peşindeyken\Nnereye kaçmayı planlıyorsun acaba?
Dialogue: 0,0:24:27.01,0:24:28.44,Main,,0,0,0,,Endişelenmene gerek yok.
Dialogue: 0,0:24:28.44,0:24:31.76,Main,,0,0,0,,Ülkedekiler artık geçmişle ilgili\Ngerçeği biliyorlar.
Dialogue: 0,0:24:31.76,0:24:34.35,Main,,0,0,0,,Babama zarar verecek\Nhiçbir şey yapmazlar.
Dialogue: 0,0:24:34.35,0:24:35.72,Main,,0,0,0,,Bana ne olacak peki?
Dialogue: 0,0:24:35.72,0:24:40.32,Main,,0,0,0,,Prenses Mansherry'i saklıyorlarsa\Nsarayda saklıyorlardır.
Dialogue: 0,0:24:40.54,0:24:44.30,Main,,0,0,0,,Eminim orada bir yerlerdedir.\NUcu bucağı ara.
Dialogue: 0,0:24:44.87,0:24:48.34,Main,,0,0,0,,Doflamingo'nun Mansherry'i öldürdüğünü\Nsanmıyorum.
Dialogue: 0,0:24:48.90,0:24:52.04,Main,,0,0,0,,Kızın yeteneğine\Nihtiyacı olduğunu biliyorum.
Dialogue: 0,0:24:53.36,0:24:58.30,Main,,0,0,0,,Gerçi şimdi o güce\Nbizim daha çok ihtiyacımız olabilir.
Dialogue: 0,0:24:57.92,0:25:07.24,Captions,,0,0,175,,{\fad(1000,0)}Kraliyet Sarayı
Dialogue: 0,0:25:12.95,0:25:16.82,Captions,,0,0,230,,{\fad(0,0)}Bir Oda
Dialogue: 0,0:25:18.86,0:25:20.88,Main,,0,0,0,,Yemeğini getirdim.
Dialogue: 0,0:25:27.37,0:25:30.62,Main,,0,0,0,,Green Bit'e dönmek istiyorum.
Dialogue: 0,0:25:31.02,0:25:35.11,Main,,0,0,0,,Gel ve kurtar beni artık...
Dialogue: 0,0:25:36.95,0:25:39.15,Main,,0,0,0,,Leo!
Dialogue: 0,0:25:39.15,0:25:40.68,Credits,,0,0,0,,Editing: Galaxy 9000\NTiming: Datenshi\NQC: Mr. Luffy, Sewil\NSoundtracking: Halee\NTC/Infoboxes: Datenshi
