,0,1,1,1,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:23.75,0:00:28.07,Credits,,0,0,0,,Translation & initial timing YibisDialogue: 0,0:00:28.16,0:00:32.16,Credits,,0,0,0,,Timing HaleeDialogue: 0,0:00:34.66,0:00:37.60,Credits,,0,0,0,,Quality-checking Sewil Galaxy 9000 HaleeDialogue: 0,0:00:39.02,0:00:42.64,Credits,,0,0,0,,Soundtracking HaleeDialogue: 0,0:00:45.87,0:00:48.56,Credits,,0,0,0,,Video editing SewilDialogue: 0,0:00:45.87,0:00:48.56,Credits,,0,0,0,,Raw provider GS-RawsDialogue: 0,0:00:01.26,0:00:03.90,Lyrics,,0,0,0,,♪ Gidelim tüm parıltımızla, koşar adım, sonsuza dek! ♪Dialogue: 0,0:00:03.93,0:00:06.66,Lyrics,,0,0,0,,♪ İlerlemeye devam edelim! ♪Dialogue: 0,0:00:06.70,0:00:09.57,Lyrics,,0,0,0,,♪ Değişmeyen bağlar mutlak aydınlatacak... ♪Dialogue: 0,0:00:09.63,0:00:12.67,Lyrics,,0,0,0,,♪ ...rüyamızın sonunu! ♪Dialogue: 0,0:00:12.77,0:00:15.27,Lyrics,,0,0,0,,♪ Uyan, uyan, uyan, uyan haydi kalbim! ♪Dialogue: 0,0:00:15.34,0:00:18.18,Lyrics,,0,0,0,,♪ Başaracağız! Durmaksızın devam! ♪Dialogue: 0,0:00:23.72,0:00:28.07,Lyrics,,0,0,0,,♪ Tek pusulamız özgürlüktür. En sıkı dostlarız. ♪Dialogue: 0,0:00:28.15,0:00:34.59,Lyrics,,0,0,0,,♪ Kendi rotamızı bundan sonra da yine kendimiz çizeceğiz. ♪Dialogue: 0,0:00:34.66,0:00:39.00,Lyrics,,0,0,0,,♪ Her gün tam hız ilerliyoruz. Doğuya git, batıya git. ♪Dialogue: 0,0:00:39.06,0:00:45.44,Lyrics,,0,0,0,,♪ Birbiri ardına yapmak istediğimiz şeyler buluyor ve yapıyoruz da hepsini. ♪Dialogue: 0,0:00:45.50,0:00:50.99,Lyrics,,0,0,0,,♪ Sabahları etmeye dayanamaz aceleci gönlümüz. (Bekleyemem!) ♪Dialogue: 0,0:00:51.11,0:00:56.05,Lyrics,,0,0,0,,♪ Neden alıp biz yapıştırmıyoruz güneşi göğe. ♪Dialogue: 0,0:00:56.11,0:00:58.95,Lyrics,,0,0,0,,♪ Zorla ve yola çıkmıyoruz! ♪Dialogue: 0,0:00:59.95,0:01:02.65,Lyrics,,0,0,0,,♪ Evet tüm parıltımızla, koşar adım, sonsuza dek! ♪Dialogue: 0,0:01:02.72,0:01:06.59,Lyrics,,0,0,0,,♪ Hayal kırıntılarımız birleştirerek. ♪Dialogue: 0,0:01:06.66,0:01:10.75,Lyrics,,0,0,0,,♪ Titretiyorsa eğer gönlünü var mı daha büyük hazine. ♪Dialogue: 0,0:01:10.83,0:01:13.43,Lyrics,,0,0,0,,♪ Gidelim tüm parıltımızla, koşar adım, sonsuza dek! ♪Dialogue: 0,0:01:13.50,0:01:16.13,Lyrics,,0,0,0,,♪ İlerlemeye devam edelim! ♪Dialogue: 0,0:01:16.20,0:01:19.17,Lyrics,,0,0,0,,♪ Değişmeyen bağlar mutlak aydınlatacak... ♪Dialogue: 0,0:01:19.24,0:01:22.24,Lyrics,,0,0,0,,♪ ...rüyamızın sonunu! ♪Dialogue: 0,0:01:22.31,0:01:24.94,Lyrics,,0,0,0,,♪ Uyan, uyan, uyan, uyan haydi kalbim ♪Dialogue: 0,0:01:25.01,0:01:27.41,Lyrics,,0,0,0,,♪ Başaracağız! Durmaksızın devam! ♪Dialogue: 0,0:01:34.31,0:01:44.31,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gnsDialogue: 0,0:15:52.00,0:16:02.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gnsDialogue: 0,0:27:40.00,0:27:50.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gnsDialogue: 0,0:01:34.31,0:01:36.78,Title,,0,0,240,,Kuş KafesiDialogue: 0,0:01:34.31,0:01:36.78,Main,Announcer,0,0,0,,Ring tamamıyla çöktü!Dialogue: 0,0:01:36.78,0:01:40.11,Main,Announcer,0,0,0,,Su seviyesi de azalmaya başladı!Dialogue: 0,0:01:40.11,0:01:43.58,Main,Announcer,0,0,0,,Artık Kolezyum'un güvenliği konusunda hiçbir garanti veremeyiz!Dialogue: 0,0:01:43.58,0:01:46.62,Main,Announcer,0,0,0,,Millet, derhal bölgeyi boşaltın!Dialogue: 0,0:01:50.29,0:01:51.54,Main,Bartolomeo,0,0,0,,Vazgeç bu işten!Dialogue: 0,0:01:51.54,0:01:54.43,Main,Bartolomeo,0,0,0,,Nereye tutunduğuna bak, boğuyorsun beni!Dialogue: 0,0:01:56.83,0:01:57.76,Main,Diamante,0,0,0,,Su!Dialogue: 0,0:02:00.00,0:02:01.87,Main,Diamante,0,0,0,,Gücüm...Dialogue: 0,0:02:01.87,0:02:02.97,Main,Diamante,0,0,0,,Yapma!Dialogue: 0,0:02:02.97,0:02:06.41,Main,Diamante,0,0,0,,O ödülü kimseye vermeyecektik biz!Dialogue: 0,0:02:23.46,0:02:27.26,Main,Sabo,0,0,0,,Arenanın dışındakiler! Ben kazandım!Dialogue: 0,0:02:27.96,0:02:30.50,Main,Sabo,0,0,0,,Bunu almayı başaran kazanacak demiştin, değil mi?Dialogue: 0,0:02:31.20,0:02:32.80,Main,Announcer,0,0,0,,Mera Mera Meyvesi...Dialogue: 0,0:02:33.30,0:02:35.10,Main,Sabo,0,0,0,,Benim yani değil mi?Dialogue: 0,0:02:37.67,0:02:41.74,Main,Announcer,0,0,0,,Şampiyon! Bir şampiyonumuz var!Dialogue: 0,0:02:41.74,0:02:43.38,Main,Announcer,0,0,0,,Zamanı değil belki ama...Dialogue: 0,0:02:43.38,0:02:48.51,Main,Announcer,0,0,0,,...bu karışıklığı fırsat bilip Mera Mera Meyvesi'ni alan kişi...Dialogue: 0,0:02:48.51,0:02:53.85,Main,Announcer,0,0,0,,...yarışmanın sürpriz atı Lucy oluyor!Dialogue: 0,0:02:53.85,0:02:56.96,Main,Announcer,0,0,0,,Şampiyonumuz!Dialogue: 0,0:02:58.79,0:02:59.96,Main,Sabo,0,0,0,,İğrenç!Dialogue: 0,0:02:59.96,0:03:04.83,Main,Bartolomeo,0,0,0,,Tükendim...Dialogue: 0,0:03:10.60,0:03:13.44,Main,Bartolomeo,0,0,0,,Büyük Senpai, beni de kurtarıversene!Dialogue: 0,0:03:13.44,0:03:17.44,Main,Sabo,0,0,0,,Erkek kimisi başının çaresine bakmasını bilir!Dialogue: 0,0:03:17.98,0:03:20.98,Main,Bartolomeo,0,0,0,,Böyle diyeceğini biliyordum...Dialogue: 0,0:03:21.36,0:03:23.62,Main,Sabo,0,0,0,,Bir kere daha saldıracağım, dikkatli ol!Dialogue: 0,0:03:23.62,0:03:25.12,Main,Bartolomeo,0,0,0,,Ne?!Dialogue: 0,0:03:30.86,0:03:33.89,Main,Burgess,0,0,0,,Lanet olsun! Mera Mera'yı yedi!Dialogue: 0,0:03:34.89,0:03:37.60,Main,Diamante,0,0,0,,Devrim Ordusu'ndaki eleman değil mi bu?!Dialogue: 0,0:03:41.33,0:03:44.04,Main,Sabo,0,0,0,,Yandım! Harbiden de oldu!Dialogue: 0,0:03:44.04,0:03:46.47,Main,Koala,0,0,0,,Kıyafetleri bendeydi!Dialogue: 0,0:03:48.77,0:03:51.31,Main,Sabo,0,0,0,,Bana öyle geldi sanırım! Hiç de sıcak değil!Dialogue: 0,0:03:51.31,0:03:53.45,Main,Sabo,0,0,0,,Kendim aleve dönüştüm!Dialogue: 0,0:03:54.11,0:03:55.38,Main,Sabo,0,0,0,,Ace!Dialogue: 0,0:03:56.15,0:03:58.62,Main,Sabo,0,0,0,,Yeteneğini ben devralıyorum!Dialogue: 0,0:04:00.85,0:04:02.62,Main,Sabo,0,0,0,,Ateş Yumruk!Dialogue: 0,0:04:24.48,0:04:27.71,Captions,,0,0,175,,Yer Altı Ticaret LimanıDialogue: 0,0:04:27.71,0:04:31.83,Main,Trébol,0,0,0,,Lanet olası Hasır Şapka Tayfası!Dialogue: 0,0:04:31.85,0:04:33.39,Main,Trébol,0,0,0,,Tontattalar!Dialogue: 0,0:04:34.76,0:04:38.79,Main,Trébol,0,0,0,,Buradan dışarı adım atamayacaksınız!Dialogue: 0,0:04:38.79,0:04:40.46,Main,Robin,0,0,0,,Millet, Usopp size emanet!Dialogue: 0,0:04:41.36,0:04:42.83,Main,Gnomes,0,0,0,,Pekâlâ!Dialogue: 0,0:04:42.83,0:04:43.80,Main,Leo,0,0,0,,Kaçalım!Dialogue: 0,0:04:43.80,0:04:46.60,Main,Leo,0,0,0,,Usoland'ın kılına dokunmasına izin vermeyin!Dialogue: 0,0:04:49.97,0:04:54.21,Main,Trébol,0,0,0,,GÜLÜCÜK fabrikamızın peşindesiniz!Dialogue: 0,0:04:54.21,0:04:57.58,Main,Trébol,0,0,0,,Öyle değil mi, Nico Robin?!Dialogue: 0,0:04:58.94,0:05:01.28,Main,Trébol,0,0,0,,Beta Beta Zincir!Dialogue: 0,0:05:06.52,0:05:08.15,Main,Hairudin,0,0,0,,Dur bakalım!Dialogue: 0,0:05:13.59,0:05:15.36,Main,Robin,0,0,0,,Dev!Dialogue: 0,0:05:20.00,0:05:24.34,Main,Hairudin,0,0,0,,Küçük İnsanlar... Onu biraz ödünç alayım ben.Dialogue: 0,0:05:25.77,0:05:27.94,Main,Leo,0,0,0,,U-Usoland!Dialogue: 0,0:05:35.55,0:05:39.62,Main,Hairudin,0,0,0,,Bizi kurtarmak için bu denli yaralanmayı göze almış...Dialogue: 0,0:05:40.22,0:05:47.09,Main,Hairudin,0,0,0,,Aranızda on yıldır oyuncak olarak çalışanların olduğunu biliyorum.Dialogue: 0,0:05:47.09,0:05:49.60,Main,Hairudin,0,0,0,,Eminim çok acı vermiştir.Dialogue: 0,0:05:53.33,0:06:01.11,Main,Usopp's subtitles,0,0,0,,(Böyle) (yap)arak canımı acıtıyorsunDialogue: 0,0:06:01.11,0:06:06.58,Main,Hairudin,0,0,0,,Sen olmasaydın sonsuza dek oyuncak olarak kalacaktık!Dialogue: 0,0:06:06.58,0:06:11.25,Main,Hairudin,0,0,0,,Onların kölesi olarak yaşayacaktık! Hayatlarımız bağışlandı adeta!Dialogue: 0,0:06:13.12,0:06:15.95,Main,Hairudin,0,0,0,,Şuna bakın ey savaşçılar!Dialogue: 0,0:06:15.95,0:06:17.59,Main,Hairudin,0,0,0,,Bu adam...Dialogue: 0,0:06:17.59,0:06:21.46,Main,Hairudin,0,0,0,,...üzerimizdeki laneti kaldıran kahramanın ta kendisi!Dialogue: 0,0:06:21.86,0:06:23.46,Main,Hairudin,0,0,0,,Adı da...Dialogue: 0,0:06:23.86,0:06:28.40,Main,Hairudin,0,0,0,,Kaptan Usopp!Dialogue: 0,0:06:31.24,0:06:34.37,Main,Usopp's latest crew of followers,0,0,0,,Teşekkür ederiz!Dialogue: 0,0:06:42.98,0:06:43.96,Main,Man,0,0,0,,Ne oldu?!Dialogue: 0,0:06:43.96,0:06:46.35,Main,Man,0,0,0,,Tavan çöktü!Dialogue: 0,0:06:57.60,0:06:59.63,Main,Man,0,0,0,,Cennetin ışığı...Dialogue: 0,0:07:01.23,0:07:03.70,Main,Man,0,0,0,,Yoksa bu adam...Dialogue: 0,0:07:03.70,0:07:06.34,Main,Man,0,0,0,,...cennetten gelen bir haberci falan mı?!Dialogue: 0,0:07:17.35,0:07:20.85,Main,Usopp's latest crew of followers,0,0,0,,Yoksa şu anda...Dialogue: 0,0:07:20.85,0:07:24.62,Main,Usopp's latest crew of followers,0,0,0,,...bir mucizeye mi tanık oluyoruz?!Dialogue: 0,0:07:34.30,0:07:37.94,Main,Jeet,0,0,0,,Ne kudretli! Sanırsın tanrının ta kendisi!Dialogue: 0,0:07:43.33,0:07:46.76,Main,Usopp,0,0,0,,#(Siz)in gibi#Dialogue: 0,0:07:46.76,0:07:51.50,Main,Usopp,0,0,0,, #beyinsiz(lere) lanet olsun!#Dialogue: 0,0:07:51.50,0:07:56.03,Main,Usopp,0,0,0,,#(Ben)i (reh)ine gibi (ber)bat halde tutmayı bırakın#Dialogue: 0,0:07:56.03,0:08:02.04,Main,Usopp,0,0,0,,#Yüzüm gözüm kan (ol)du, b(a)yıla(cağım) şimdi!#Dialogue: 0,0:08:05.23,0:08:08.60,Main,Man,0,0,0,,(Siz)(lere) (ben) (reh)(ber) (ol)(a)(cağım)Dialogue: 0,0:08:08.60,0:08:12.97,Main,Man,0,0,0,,"Sizlere ben rehber olacağım" mı?!Dialogue: 0,0:08:15.87,0:08:18.71,Main,Man,0,0,0,,Sen gerçekten de...Dialogue: 0,0:08:19.21,0:08:25.02,Main,Man,0,0,0,,...kurtarıcımız olmak için cennetten yollanmışsın!Dialogue: 0,0:08:27.72,0:08:29.55,Main,Usopp's latest crew of followers,0,0,0,,Tanrı Usopp! Tanrı Usopp! Tanrı Usopp!Dialogue: 0,0:08:29.55,0:08:31.82,Main,Man,0,0,0,,Rehber ol bize, Tanrı Usopp!Dialogue: 0,0:08:29.55,0:08:32.79,Secondary,Usopp's latest crew of followers,0,0,0,,God Usopp! God Usopp! God Usopp!Dialogue: 0,0:08:31.82,0:08:34.89,Main,Man,0,0,0,,Yapmamız gerekenleri söyle!Dialogue: 0,0:08:41.33,0:08:47.04,Main,Usopp,0,0,0,,O zaman arkamdaki fabrikayı yok edip...Dialogue: 0,0:08:47.04,0:08:51.04,Main,Usopp,0,0,0,,...içindeki küçük insanları kurtarmaya ne dersiniz?Dialogue: 0,0:08:53.98,0:08:55.88,Main,Abdullah & Jeet,0,0,0,,Emredersin!Dialogue: 0,0:09:05.79,0:09:07.33,Main,Robin,0,0,0,,Usopp...Dialogue: 0,0:09:07.33,0:09:12.20,Main,Gnomes,0,0,0,,Usoland! Usoland! Usoland!Dialogue: 0,0:09:27.38,0:09:28.88,Main,Burgess,0,0,0,,Lanet olsun!Dialogue: 0,0:09:29.51,0:09:32.42,Main,Burgess,0,0,0,,O adam Hasır Şapka değilmiş!Dialogue: 0,0:09:32.42,0:09:35.62,Main,Burgess,0,0,0,,Mera Mera Meyvemi ne cüretle yer?!Dialogue: 0,0:09:36.86,0:09:40.86,Main,Diamante,0,0,0,,Lanet olsun! Bu durumu Doffy'e nasıl açıklarım ben?!Dialogue: 0,0:09:45.40,0:09:47.60,Main,Diamante,0,0,0,,Bu kendini bilmezler de kim?!Dialogue: 0,0:09:47.90,0:09:49.90,Main,Pirates,0,0,0,,Bizi oyuncağa dönüştürürsünüz ha?!Dialogue: 0,0:09:49.90,0:09:53.24,Main,Pirates,0,0,0,,Fabrikayla beraber onu da mahvedin!Dialogue: 0,0:09:53.24,0:09:55.81,Main,Diamante,0,0,0,,Tabii ya! Yeraltındaki oyuncaklar bunlar!Dialogue: 0,0:10:04.02,0:10:05.62,Main,Sabo,0,0,0,,Korkuttu!Dialogue: 0,0:10:06.22,0:10:07.85,Main,Sabo,0,0,0,,Birden alev aldı!Dialogue: 0,0:10:07.85,0:10:09.99,Main,Sabo,0,0,0,,Kontrolü epey zormuş!Dialogue: 0,0:10:10.82,0:10:11.72,Main,Rebecca,0,0,0,,Şey...Dialogue: 0,0:10:11.72,0:10:15.99,Main,Bartolomeo,0,0,0,,Durun bakalım, beni nasıl arkanızda bırakabildiniz? Çok kötüsün Büyük Senpai!Dialogue: 0,0:10:15.99,0:10:20.60,Main,Bartolomeo,0,0,0,,Erkeğim sonuçta tamam, bariyer de yapabiliyorum ama...Dialogue: 0,0:10:21.73,0:10:22.90,Main,Hack,0,0,0,,Bu adam...Dialogue: 0,0:10:24.30,0:10:27.74,Main,Rebecca,0,0,0,,Kimsin sen?Dialogue: 0,0:10:28.77,0:10:30.01,Main,Sabo,0,0,0,,Ben mi?Dialogue: 0,0:10:34.31,0:10:36.52,Main,Sabo,0,0,0,,Adım Sabo.Dialogue: 0,0:10:37.95,0:10:46.73,Captions,Caption Middle,0,450,70,,Devrim Ordusu Genel Kurmal Başkanı  SaboDialogue: 0,0:10:37.95,0:10:46.73,Captions,Caption Right,790,0,290,,Devrim Ordusu HackDialogue: 0,0:10:42.65,0:10:45.96,Main,Sabo,0,0,0,,Devrim Ordusu'nun askerleriyiz.Dialogue: 0,0:10:47.83,0:10:49.90,Main,Rebecca,0,0,0,,İlk Lucy de mi...Dialogue: 0,0:10:50.22,0:10:56.17,Main,Sabo,0,0,0,,İlk Lucy'nin kafasında 400 milyonluk ödül var. Günün birinde Korsanlar Kralı olacak olan adam o!Dialogue: 0,0:10:56.17,0:10:58.00,Main,Sabo,0,0,0,,Hasır Şapkalı Luffy!Dialogue: 0,0:10:58.50,0:11:00.21,Main,Rebecca,0,0,0,,Korsan mı?!Dialogue: 0,0:11:00.21,0:11:02.94,Main,Sabo,0,0,0,,Evet, kardeşim olur.Dialogue: 0,0:11:02.94,0:11:03.98,Main,Sabo,0,0,0,,İyi bak ona.Dialogue: 0,0:11:05.98,0:11:09.51,Main,Sabo,0,0,0,,Luffy çok iyi biri, değil mi?Dialogue: 0,0:11:12.32,0:11:15.42,Main,Sabo,0,0,0,,Çılgınlığıyla falan, hep aynı.Dialogue: 0,0:11:15.42,0:11:18.32,Main,Koala,0,0,0,,Sabo-kun, senin de ondan aşağı kalır yanın yok hani!Dialogue: 0,0:11:18.32,0:11:19.62,Main,Sabo,0,0,0,,Hadi ya?Dialogue: 0,0:11:20.73,0:11:24.73,Main,Rebecca,0,0,0,,Peki ama siz Devrimcileri bu ülkeye getiren nedir?Dialogue: 0,0:11:33.04,0:11:34.21,Main,Rebecca,0,0,0,,Bunlar...Dialogue: 0,0:11:34.61,0:11:39.71,Main,Sabo,0,0,0,,Bu limandan dağıtılan silahlar dünyadaki savaşları körüklüyor.Dialogue: 0,0:11:41.41,0:11:45.58,Main,Sabo,0,0,0,,Bu duruma bir son vermek için geldik!Dialogue: 0,0:11:47.65,0:11:52.89,Main,Koala,0,0,0,,Devrim Ordusu bu ülkeye daha önce pek çok kez asker gönderdi fakat...Dialogue: 0,0:11:53.48,0:12:00.03,Main,Koala,0,0,0,,...hepsi de oyuncağa dönüştürüldüğünden yeraltında dönen kara borsa işlerinden haberimiz olamadı.Dialogue: 0,0:12:04.90,0:12:07.04,Main,Grunt,0,0,0,,Şu adam başa bela!Dialogue: 0,0:12:07.04,0:12:09.16,Main,Grunt,0,0,0,,Sabo değil mi o?!Dialogue: 0,0:12:09.16,0:12:12.64,Main,Grunt,0,0,0,,Devrim Ordusu'nun iki numarasının burada işi ne?!Dialogue: 0,0:12:12.64,0:12:14.48,Main,Grunt,0,0,0,,Genç Bey'e haber vermeliyiz!Dialogue: 0,0:12:16.05,0:12:19.92,Main,Sabo,0,0,0,,Ama anlaşılan silahları başka bir yerde üretiyorlar.Dialogue: 0,0:12:22.10,0:12:26.09,Main,Sabo,0,0,0,,Acaba nereden geliyor?Dialogue: 0,0:12:29.22,0:12:35.10,Main,Sabo,0,0,0,,Bunu bulabilirsek Dragon-san'a hoş bir sürpriz olacak.Dialogue: 0,0:12:57.06,0:13:00.43,Captions,Caption,0,0,175,,Kraliyet SarayıDialogue: 0,0:13:03.70,0:13:08.43,Main,Buffalo,0,0,0,,Seni lanet olası! Genç Bey'imizi ne cüretle öldürürsün!Dialogue: 0,0:13:09.30,0:13:12.30,Main,Buffalo,0,0,0,,Uçmaya hazırla kendini!Dialogue: 0,0:13:27.05,0:13:28.05,Main,Baby 5,0,0,0,,Buffalo!Dialogue: 0,0:13:37.30,0:13:40.00,Main,Luffy,0,0,0,,Trao!Dialogue: 0,0:13:40.87,0:13:43.17,Main,Luffy,0,0,0,,Seni kurtarmaya geldim!Dialogue: 0,0:13:43.17,0:13:44.07,Main,Baby 5,0,0,0,,Hasır Şapka?!Dialogue: 0,0:13:44.07,0:13:45.87,Main,Luffy,0,0,0,,Hayatta olmana çok sevindim!Dialogue: 0,0:13:45.87,0:13:49.07,Main,Law,0,0,0,,Senin burada bir işin yok, Hasır Şapka!Dialogue: 0,0:13:49.07,0:13:50.54,Main,Law,0,0,0,,Fabrikaya ne oldu?!Dialogue: 0,0:13:50.54,0:13:51.48,Main,Law,0,0,0,,Yok ettiniz mi?!Dialogue: 0,0:13:51.48,0:13:53.61,Main,Violet,0,0,0,,Kelepçelerinin anahtarı!Dialogue: 0,0:13:53.61,0:13:55.85,Main,Luffy,0,0,0,,Her şeye de hazırlıklısın!Dialogue: 0,0:13:55.85,0:13:58.68,Main,Gladius,0,0,0,,Bekle Hasır Şapka, Violet!Dialogue: 0,0:13:58.68,0:14:00.39,Main,Gladius,0,0,0,,Genç Bey'in kılına-Dialogue: 0,0:14:04.59,0:14:05.60,Main,Gladius,0,0,0,,Genç Beyim?Dialogue: 0,0:14:08.73,0:14:11.50,Main,Kyros,0,0,0,,Kral Riku-sama, beklettiğim için bağışlayın!Dialogue: 0,0:14:12.40,0:14:14.90,Main,Luffy,0,0,0,,Dur az, hemen kurtaracağım seni!Dialogue: 0,0:14:15.95,0:14:20.64,Main,Law,0,0,0,,Sağ ol ama ittifakımız sona erdi!Dialogue: 0,0:14:21.44,0:14:23.01,Main,Law,0,0,0,,Git buradan!Dialogue: 0,0:14:23.01,0:14:28.18,Main,Luffy,0,0,0,,Ne bencilsin var ya! Öyle kararları ancak ben verebilirim, sen sus!Dialogue: 0,0:14:28.18,0:14:30.08,Main,Law,0,0,0,,Hangimiz benciliz acaba?!Dialogue: 0,0:14:30.08,0:14:31.45,Main,Violet,0,0,0,,Çöz hadi!Dialogue: 0,0:14:31.45,0:14:32.42,Main,Luffy,0,0,0,,Sahi ya...Dialogue: 0,0:14:36.55,0:14:39.66,Main,Law,0,0,0,,İttifakın olmaması demek düşman olduğumuz anlamına geliyor!Dialogue: 0,0:14:39.66,0:14:42.43,Main,Law,0,0,0,,Beni serbest bırakırsan seni öldürürüm!Dialogue: 0,0:14:42.43,0:14:43.76,Main,Luffy,0,0,0,,Kıpırdama be!Dialogue: 0,0:14:44.06,0:14:48.20,Main,Luffy,0,0,0,,Kairouseki'ye dokunamıyorum, anahtarı deliğe sokmak acayip zor böyle!Dialogue: 0,0:14:48.20,0:14:49.02,Main,Violet,0,0,0,,Başarabilirsin!Dialogue: 0,0:14:49.02,0:14:51.90,Main,Law,0,0,0,,Beni dinlemiyor musunuz siz?!Dialogue: 0,0:14:56.37,0:14:57.40,Main,Luffy,0,0,0,,Taş herif!Dialogue: 0,0:14:57.40,0:14:58.21,Main,Violet,0,0,0,,Pica!Dialogue: 0,0:15:05.12,0:15:08.62,Main,Doflamingo,0,0,0,,Böyle bir şeyin olmasını beklemiyordum.Dialogue: 0,0:15:09.49,0:15:11.36,Main,Luffy,0,0,0,,Mingo yaşıyor!Dialogue: 0,0:15:11.36,0:15:12.32,Main,Baby 5,0,0,0,,Genç Beyim!Dialogue: 0,0:15:12.32,0:15:13.29,Main,Gladius,0,0,0,,Genç Beyim!Dialogue: 0,0:15:15.53,0:15:17.13,Main,Riku,0,0,0,,Nasıl hâlâ hayatta olabiliyor?!Dialogue: 0,0:15:17.96,0:15:23.70,Main,Doflamingo,0,0,0,,Oyuncaklar normale dönünce tüm ülke kaosa teslim oldu.Dialogue: 0,0:15:25.70,0:15:31.34,Main,Doflamingo,0,0,0,,Ve neden bilmiyorum ama Devrim Ordusu da gizlice ülkeye sızmış.Dialogue: 0,0:15:35.45,0:15:38.35,Main,Doflamingo,0,0,0,,Çok zor bir durum.Dialogue: 0,0:15:38.35,0:15:41.55,Main,Doflamingo,0,0,0,,"Kuş Kafesi" ni kullanmaktan başka bir seçeneğim kalmıyor.Dialogue: 0,0:15:42.89,0:15:44.79,Main,Law,0,0,0,,Kuş Kafesi mi?!Dialogue: 0,0:15:46.59,0:15:49.73,Main,Doflamingo,0,0,0,,Öyle değil mi, Law?Dialogue: 0,0:15:52.06,0:15:55.57,Captions,Caption,0,0,175,,GÜLÜCÜK FabrikasıDialogue: 0,0:15:55.37,0:15:59.34,Main,Grunt,0,0,0,,Ne yapacağız?!  Eski oyuncaklar...Dialogue: 0,0:15:59.34,0:16:01.51,Main,Grunt,0,0,0,,...fabrikaya hücum etmiş durumdalar!Dialogue: 0,0:16:02.97,0:16:04.61,Main,Grunt,0,0,0,,Endişelenecek bir şey yok...Dialogue: 0,0:16:05.18,0:16:10.52,Main,Grunt,0,0,0,,Anahtarları olmadan buraya kimse giremez!Dialogue: 0,0:16:15.05,0:16:19.12,Main,Grunt,0,0,0,,Bu fabrika Genç Bey'imiz için çok değerli sonuçta!Dialogue: 0,0:16:19.56,0:16:24.46,Main,Grunt,0,0,0,,Tavan çökse bile bir çizik bile olmaz binalar hep kairousekiden çünkü!Dialogue: 0,0:16:24.46,0:16:27.23,Main,Grunt,0,0,0,,Ayrıca hepsinden öte...Dialogue: 0,0:16:32.70,0:16:36.24,Main,Grunt,0,0,0,,Şu anda o iki yüksek rütbeli yönetici fabrikayı koruyor!Dialogue: 0,0:16:43.58,0:16:47.05,Main,Grunt,0,0,0,,O ikisini kimseler yenemez!Dialogue: 0,0:16:47.05,0:16:51.79,Main,Grunt,0,0,0,,Bu fabrika savunma katmanı üzerine savunma katmanına sahip!Dialogue: 0,0:16:52.59,0:16:55.76,Captions,,0,0,0,,Ticaret LimanıDialogue: 0,0:16:53.63,0:16:54.79,Main,Robin,0,0,0,,Koala!Dialogue: 0,0:16:56.66,0:16:58.00,Main,Koala,0,0,0,,Robin-san!Dialogue: 0,0:16:58.83,0:17:00.52,Main,Robin,0,0,0,,Doğru tahmin etmişim!Dialogue: 0,0:17:00.52,0:17:02.07,Main,Robin,0,0,0,,Nasılsın bakalım?!Dialogue: 0,0:17:02.07,0:17:02.93,Main,Koala,0,0,0,,Harika!Dialogue: 0,0:17:03.87,0:17:06.77,Main,Robin,0,0,0,,Sabo, Hack... Siz de hiç değişmemişsiniz!Dialogue: 0,0:17:07.44,0:17:08.07,Main,Sabo,0,0,0,,Selam!Dialogue: 0,0:17:08.87,0:17:10.34,Main,Robin,0,0,0,,Luffy'i gördün mü?Dialogue: 0,0:17:10.34,0:17:11.48,Main,Sabo,0,0,0,,Evet.Dialogue: 0,0:17:13.21,0:17:14.41,Main,Sabo,0,0,0,,Kafasına bastığım adam!Dialogue: 0,0:17:15.35,0:17:18.68,Main,Robin,0,0,0,,Tayfadan, Usopp!Dialogue: 0,0:17:21.25,0:17:23.69,Main,Sabo,0,0,0,,Hiç rahatsız etmeseydin...Dialogue: 0,0:17:23.72,0:17:25.49,Captions,,0,0,0,,AsansörDialogue: 0,0:17:25.79,0:17:27.66,Main,Pirate,0,0,0,,Doflamingo!Dialogue: 0,0:17:27.66,0:17:30.80,Main,Kin'emon,0,0,0,,Kusura bakmayın! Yolu açın!Dialogue: 0,0:17:36.77,0:17:41.27,Captions,Caption,0,0,240,,Kral Tepesi Siper Kulesi'nin ÖnüDialogue: 0,0:17:48.28,0:17:50.18,Main,Zoro,0,0,0,,Ortalık epey karışık gibi.Dialogue: 0,0:17:50.18,0:17:52.22,Main,Zoro,0,0,0,,Neler oluyor acaba?Dialogue: 0,0:17:53.75,0:17:58.92,Main,Zoro,0,0,0,,O değil de, şu taş adam nereye kayboldu?!Dialogue: 0,0:18:00.22,0:18:03.19,Captions,,0,0,0,,Kraliyet SarayıDialogue: 0,0:18:04.15,0:18:07.37,Main,Doflamingo,0,0,0,,Acilen bir şeyler yapmak gerek.Dialogue: 0,0:18:07.37,0:18:09.07,Main,Kyros,0,0,0,,İğrenç herif!Dialogue: 0,0:18:12.07,0:18:16.41,Main,Kyros,0,0,0,,Nasıl hâlâ hayatta olabiliyorsun, Doflamingo?!Dialogue: 0,0:18:18.04,0:18:23.18,Main,Doflamingo,0,0,0,,Birini nasıl öldüreceğini göstermemi ister misin?Dialogue: 0,0:18:23.18,0:18:24.15,Main,Luffy,0,0,0,,Asker!Dialogue: 0,0:18:24.15,0:18:25.15,Main,Violet,0,0,0,,Kyros ağabey!Dialogue: 0,0:18:27.42,0:18:29.45,Main,Doflamingo,0,0,0,,Böyle yapılıyor işte.Dialogue: 0,0:18:31.59,0:18:32.69,Main,Riku,0,0,0,,Kyros!Dialogue: 0,0:18:39.90,0:18:41.17,Main,Doflamingo,0,0,0,,Hasır Şapka!Dialogue: 0,0:18:47.24,0:18:48.71,Main,Baby 5,0,0,0,,İki tane Genç Bey var!Dialogue: 0,0:18:53.31,0:18:55.21,Main,Kyros,0,0,0,,Sağ ol! Gardımı düşürmüştüm!Dialogue: 0,0:18:55.21,0:18:57.72,Main,Luffy,0,0,0,,Gomu Gomu no...Dialogue: 0,0:18:59.12,0:19:00.55,Main,Doflamingo,0,0,0,,Silahlanma!Dialogue: 0,0:19:04.09,0:19:08.66,Main,Luffy,0,0,0,,...Jet Mitralyöz!Dialogue: 0,0:19:36.19,0:19:37.09,Main,Kyros,0,0,0,,Luffyland!Dialogue: 0,0:19:39.62,0:19:41.63,Main,Kyros,0,0,0,,Bu klon da neyin nesi?!Dialogue: 0,0:19:44.50,0:19:45.60,Main,Luffy,0,0,0,,Acıdı!Dialogue: 0,0:19:48.50,0:19:51.24,Main,Violet,0,0,0,,Sicimlerden oluşturulmuş kukla misali!Dialogue: 0,0:19:51.24,0:19:54.17,Main,Violet,0,0,0,,Böyle bir tekniği ilk kez görüyorum!Dialogue: 0,0:19:55.57,0:19:57.31,Main,Doflamingo,0,0,0,,Kral Riku.Dialogue: 0,0:19:57.74,0:20:03.72,Main,Doflamingo,0,0,0,,On yıl önce o gece hissettiklerini hatırlıyor musun?Dialogue: 0,0:20:04.28,0:20:10.76,Main,Doflamingo,0,0,0,,Çok sevdiğin insanlarını biçip, barışçıl kasabaları ateşe verdiğin o geceyi...Dialogue: 0,0:20:10.76,0:20:15.53,Flashbacks,Riku,0,0,0,,Birileri lütfen öldürsün beni!Dialogue: 0,0:20:17.95,0:20:20.95,Main,Riku,0,0,0,,Hâlâ her gece kabuslarıma giriyor!Dialogue: 0,0:20:20.95,0:20:24.10,Main,Riku,0,0,0,,Hatırlıyorum, ne olmuş yani!?Dialogue: 0,0:20:24.10,0:20:29.37,Main,Doflamingo,0,0,0,,Bugün gerçekleşecek trajedi o günkü gibi küçük çaplı olmayacak.Dialogue: 0,0:20:34.05,0:20:37.17,Main,Riku,0,0,0,,Ne diyorsun sen be?! Neyin peşindesin?!Dialogue: 0,0:20:37.17,0:20:38.62,Main,Riku,0,0,0,,Öyle bir şeyi görmek bile-Dialogue: 0,0:20:38.62,0:20:41.69,Main,Doflamingo,0,0,0,,Sizi bırakma zamanı.Dialogue: 0,0:20:41.69,0:20:42.85,Main,Doflamingo,0,0,0,,Pica.Dialogue: 0,0:20:46.82,0:20:49.73,Main,Doflamingo,0,0,0,,Bu baş belalarını dışarı fırlat!Dialogue: 0,0:21:16.32,0:21:17.76,Main,Riku,0,0,0,,Doflamingo!Dialogue: 0,0:21:18.76,0:21:20.49,Main,Riku,0,0,0,,Lütfen,...Dialogue: 0,0:21:20.49,0:21:22.43,Main,Riku,0,0,0,,...bu ülkeye daha fazla...Dialogue: 0,0:21:31.77,0:21:34.97,Main,Riku,0,0,0,,...zarar verme!Dialogue: 0,0:21:34.97,0:21:36.71,Main,Luffy,0,0,0,,Gomu Gomu no...Dialogue: 0,0:21:36.71,0:21:38.31,Main,Luffy,0,0,0,,Balon!Dialogue: 0,0:22:07.51,0:22:09.81,Main,Luffy,0,0,0,,Siper kulesinin bahçesine fırlattı bizi!Dialogue: 0,0:22:09.81,0:22:13.88,Main,Violet,0,0,0,,Pica orada olduğu müddetçe Doflamingo'nun yanına yaklaşamayız!Dialogue: 0,0:22:16.41,0:22:17.95,Main,Law,0,0,0,,Başladı!Dialogue: 0,0:22:19.35,0:22:20.75,Main,Law,0,0,0,,Kuş Kafesi bu!Dialogue: 0,0:22:39.44,0:22:41.84,Main,Pirate,0,0,0,,Kaptan, o da nesi?!Dialogue: 0,0:22:43.98,0:22:47.68,Main,Captain,0,0,0,,Ne bileyim ben be!? Derhal defolup gidiyoruz bu adadan!Dialogue: 0,0:22:47.68,0:22:52.32,Main,Captain,0,0,0,,Burada kalıp nefretimizi Doflamingo'dan çıkarmaya çalışsak bile böcek gibi eziliriz!Dialogue: 0,0:22:52.32,0:22:54.62,Main,Pirate,0,0,0,,Kaptan, dikkat! Önümüzde bir şey var!Dialogue: 0,0:22:57.69,0:22:58.99,Main,Captain,0,0,0,,Acıdı be!Dialogue: 0,0:23:00.02,0:23:01.69,Main,Pirate,0,0,0,,Bıçak mı bunlar?Dialogue: 0,0:23:01.69,0:23:03.79,Main,Pirate,0,0,0,,Bu parmaklıklar da neyin nesi!?Dialogue: 0,0:23:06.50,0:23:09.80,Main,Law,0,0,0,,Adanın ardında yatan gerçek açığa çıkmadan önce...Dialogue: 0,0:23:09.80,0:23:12.27,Main,Law,0,0,0,,...Doflamingo bu adadaki herkesi...Dialogue: 0,0:23:13.94,0:23:16.47,Main,Law,0,0,0,,...öldürmeyi planlıyor!Dialogue: 0,0:23:19.74,0:23:22.61,Main,Pirate,0,0,0,,Bu parmaklıklardan her tarafta var!Dialogue: 0,0:23:24.28,0:23:31.16,Main,Captain,0,0,0,,Çıkış yok mu buradan?!Dialogue: 0,0:23:35.36,0:23:37.36,Main,Bastille,0,0,0,,O da neyin nesi-dara?!Dialogue: 0,0:23:37.36,0:23:41.27,Main,Marine,0,0,0,,Koramiral Bastille!  Karargâha ulaşamıyorum!Dialogue: 0,0:23:42.37,0:23:46.04,Main,Marine,0,0,0,,Ben de öyle!  Merkezle bağlantı kuramıyorum!Dialogue: 0,0:23:46.04,0:23:48.21,Main,Marine,0,0,0,,Daha hiçbir raporda bulunmamıştık!Dialogue: 0,0:23:59.25,0:24:02.42,Main,Marine,0,0,0,,Hey! Elalemin evine niye ateş açtın be?!Dialogue: 0,0:24:02.42,0:24:06.86,Main,Marine,0,0,0,,İsteyerek yapmadım! Vücuduma söz geçiremiyorum!Dialogue: 0,0:24:07.73,0:24:09.56,Main,Marine,0,0,0,,Hey, dur!Dialogue: 0,0:24:14.77,0:24:16.77,Main,Marine,0,0,0,,Bu da ne böyle?! Vücudum...Dialogue: 0,0:24:21.21,0:24:23.34,Main,Child,0,0,0,,Baba!Dialogue: 0,0:24:24.34,0:24:29.21,Main,Citizen,0,0,0,,Durdurun beni! Eğilin lütfen!Dialogue: 0,0:24:33.52,0:24:35.19,Main,Doflamingo,0,0,0,,Parazit!Dialogue: 0,0:24:37.49,0:24:38.89,Main,Marine,0,0,0,,Durum bildiriyorum!Dialogue: 0,0:24:39.56,0:24:44.93,Main,Marine,0,0,0,,Tüm Dressrosa'da insanlar birbirlerine zarar vermeye başladılar!Dialogue: 0,0:24:48.23,0:24:52.64,Main,Marine,0,0,0,,Donanma askerleri arasında da kendini kaybedenler mevcut!Dialogue: 0,0:24:52.64,0:24:55.67,Main,Marine,0,0,0,,Hiçbir şey yapılmazsa pek çok sivil ölecek!Dialogue: 0,0:24:57.78,0:24:59.11,Main,Marine,0,0,0,,Şimdi ne oluyor?!Dialogue: 0,0:25:04.10,0:25:08.25,Main,Citizen,0,0,0,,Kral Tepesi çöküyor!Dialogue: 0,0:25:12.79,0:25:16.83,Main,Luffy,0,0,0,,Zemin çökmeye başladı! Ne oluyor?!Dialogue: 0,0:25:16.83,0:25:18.00,Main,Law,0,0,0,,Pica'nın işi bu!Dialogue: 0,0:25:21.10,0:25:23.97,Main,Law,0,0,0,,Taşlarla bir olabildiğinden toprağın yapısını da değiştirebilir!Dialogue: 0,0:25:26.70,0:25:29.01,Main,Luffy,0,0,0,,Kraliyet Sarayı bir yerlere gidiyor!Dialogue: 0,0:25:29.67,0:25:32.14,Main,Luffy,0,0,0,,Bekle Kraliyet Sarayı!Dialogue: 0,0:25:41.95,0:25:44.56,Main,Pirate,0,0,0,,Fabrika yükseliyor!Dialogue: 0,0:25:44.56,0:25:47.19,Main,Pirate,0,0,0,,Ne oluyor burada böyle?!Dialogue: 0,0:25:50.26,0:25:52.03,Main,Citizen,0,0,0,,Birileri...Dialogue: 0,0:25:53.70,0:25:56.73,Main,Citizen,0,0,0,,Beni durdurun lütfen!Dialogue: 0,0:26:00.24,0:26:02.44,Main,Citizen,0,0,0,,Çiçek Bahçesi platosu...Dialogue: 0,0:26:02.87,0:26:07.75,Main,Citizen,0,0,0,,...şehri de beraberinde ççekerek yükseliyor!Dialogue: 0,0:26:20.19,0:26:23.59,Captions,,0,0,0,,Kraliyet SarayıDialogue: 0,0:26:24.73,0:26:30.17,Main,Doflamingo,0,0,0,,Dressrosa halkı ve misafirlerimiz.Dialogue: 0,0:26:31.34,0:26:37.74,Main,Doflamingo,0,0,0,,Sizi ta en başından büyük korku salarak yönetebilirdim.Dialogue: 0,0:26:39.74,0:26:47.69,Main,Doflamingo,0,0,0,,Eminim gerçeği öğrendikten sonra  pek çoğunuz beni öldürmek istiyorsunuzdur.Dialogue: 0,0:26:48.09,0:26:51.19,Main,Doflamingo,0,0,0,,O yüzden de sizin için bir oyun hazırladım.Dialogue: 0,0:26:54.89,0:26:58.20,Main,Doflamingo,0,0,0,,Beni öldürme oyunu.Dialogue: 0,0:26:58.70,0:27:01.37,Main,Doflamingo,0,0,0,,Kraliyet Sarayı'ndayım.Dialogue: 0,0:27:01.37,0:27:03.83,Main,Doflamingo,0,0,0,,Ne kaçacak ne de saklanacağım.Dialogue: 0,0:27:03.83,0:27:10.47,Main,Doflamingo,0,0,0,,Canımı alabilirseniz oyun orada son bulacak elbette.Dialogue: 0,0:27:10.90,0:27:16.55,Main,Doflamingo,0,0,0,,Fakat oyunu bitirmenin başka bir yolu da var.Dialogue: 0,0:27:16.55,0:27:24.86,Main,Doflamingo,0,0,0,,Adlarını sayacağım kişilerin hepsini öldürmeniz lazım.Dialogue: 0,0:27:24.86,0:27:31.33,Main,Doflamingo,0,0,0,,Üstelik hepsinin de başına büyük para ödülleri koydum.Dialogue: 0,0:27:32.33,0:27:35.03,Main,Doflamingo,0,0,0,,Ölün ya da öldürün.Dialogue: 0,0:27:40.07,0:27:44.11,Main,Doflamingo,0,0,0,,Ülkedeki herkes avcı olacak!Dialogue: 0,0:27:44.88,0:27:52.62,Main,Doflamingo,0,0,0,,Hayatta kalmanızın tek yoluysa birilerini öldürmeniz!