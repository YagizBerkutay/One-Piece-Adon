Dialogue: 0,0:01:42.72,0:01:47.45,Title,,0,0,240,,{\fad(800,800)}Dördüncü Düzen
Dialogue: 0,0:02:07.82,0:02:10.02,Main,,0,0,0,,Koşun! Koşun!
Dialogue: 0,0:02:14.66,0:02:17.96,Main,,0,0,0,,Adanın merkezine koşun!
Dialogue: 0,0:02:38.52,0:02:41.46,Main,,0,0,0,,Kesilemeyen binalar...
Dialogue: 0,0:02:43.68,0:02:46.89,Main,,0,0,0,,...kafesle birlikte\Nüzerimize sürükleniyor!
Dialogue: 0,0:02:48.70,0:02:51.78,Main,,0,0,0,,Ülke küçülmeye başladı!
Dialogue: 0,0:02:56.86,0:03:01.13,Captions,,0,0,0,,{\pos(640,542)\fad(525,0)}Kraliyet Sarayı Platosu - 2. Seviye
Dialogue: 0,0:03:04.45,0:03:06.90,Main,,0,0,0,,Kuş Kafesi küçülmeye mi başlamış?!
Dialogue: 0,0:03:06.90,0:03:09.30,Main,,0,0,0,,Keşmekeşin nedeni bu demek!
Dialogue: 0,0:03:09.86,0:03:14.00,Main,,0,0,0,,Kuş Kafesi'nin\Ngerçek tehlikesi bu işte, aşkım.
Dialogue: 0,0:03:15.40,0:03:19.30,Main,,0,0,0,,Gözlerime inanamıyorum!\NBöyle şey olur mu be?!
Dialogue: 0,0:03:20.12,0:03:23.87,Main,,0,0,0,,{\i1}Ay gene aşkım dedim!{\i0}
Dialogue: 0,0:03:23.87,0:03:28.13,Main,,0,0,0,,Burada durup da ölümün boynuma\Nsarılmasını bekleyemem ben arkadaş!
Dialogue: 0,0:03:28.13,0:03:31.26,Main,,0,0,0,,Düşmüş yoldaşlarınızı da\Nderhal kaldıralım!
Dialogue: 0,0:03:31.26,0:03:32.39,Main,,0,0,0,,Tamamdır!
Dialogue: 0,0:03:33.05,0:03:37.92,Captions,,950,0,260,,{\fad(300,300)}Eski Kralın Platosu
Dialogue: 0,0:03:33.98,0:03:38.21,Main,,0,0,0,,Savaş uzun sürerse\Nbu plato da paramparça olacak.
Dialogue: 0,0:03:38.21,0:03:43.35,Main,,0,0,0,,Ne? Ülkenin merkezi burası sanıyordum,\Nen güvenli yer olması lazım değil mi?
Dialogue: 0,0:03:43.35,0:03:44.48,Main,,0,0,0,,Göğe bak!
Dialogue: 0,0:03:45.16,0:03:48.06,Main,,0,0,0,,Kuş Kafesinin merkezi\Nağır ağır yaklaşıyor.
Dialogue: 0,0:03:50.44,0:03:56.85,Main,,0,0,0,,Merkez noktası muhtemelen\NDoflamingo'nun bulunduğu platodur.
Dialogue: 0,0:03:56.78,0:04:01.45,Captions,,470,0,420,,{\fad(1000,0)}Kraliyet Sarayı
Dialogue: 0,0:03:56.78,0:04:01.45,Captions,,0,405,170,,{\fad(1000,0)}Şuanki Konum
Dialogue: 0,0:03:58.56,0:04:01.64,Main,,0,0,0,,Yeni anlayacağın\Ner ya da geç burası da...
Dialogue: 0,0:04:05.70,0:04:09.76,Main,,0,0,0,,Acele et, Hack!\NAcele et lütfen!
Dialogue: 0,0:04:07.94,0:04:09.26,Secondary,,0,0,0,,Kıpırdama!
Dialogue: 0,0:04:14.52,0:04:18.76,Main,,0,0,0,,Şimdi bakıyorum da\Naşağısı epey karışıkmış.
Dialogue: 0,0:04:19.36,0:04:20.46,Main,,0,0,0,,O taraftan!
Dialogue: 0,0:04:21.02,0:04:22.14,Main,,0,0,0,,Zoro-dono!
Dialogue: 0,0:04:23.33,0:04:26.55,Main,,0,0,0,,Nereye gidiyorsun?!
Dialogue: 0,0:04:26.55,0:04:28.74,Main,,0,0,0,,Belli değil mi?!
Dialogue: 0,0:04:29.72,0:04:32.33,Main,,0,0,0,,Şu şeyi durdurmaya elbette!
Dialogue: 0,0:04:32.90,0:04:34.20,Main,,0,0,0,,Şu şeyi!
Dialogue: 0,0:04:34.20,0:04:35.16,Main,,0,0,0,,Şu şeyi mi!?
Dialogue: 0,0:04:41.29,0:04:44.27,Captions,,0,983,258,,{\fad(300,300)}Sarayın Dışı\N\N\N\N\N\N\N\N\N\N\N\N\N\N\N\NAyçiçeği Tarlası
Dialogue: 0,0:04:46.90,0:04:48.76,Main,,0,0,0,,Şaşırdım açıkçası.
Dialogue: 0,0:04:48.76,0:04:51.80,Main,,0,0,0,,Dressrosa'da cücelerin yaşadığını bilmiyordum.
Dialogue: 0,0:04:51.80,0:04:54.38,Main,,0,0,0,,Kolun eskisi gibi olur umarım.
Dialogue: 0,0:04:54.90,0:04:57.74,Main,,0,0,0,,Damarlarına kan akmaya başlayınca\Niyileşmiş olacakmış.
Dialogue: 0,0:04:58.54,0:05:01.74,Main,,0,0,0,,Biliyorum, doktorum.
Dialogue: 0,0:05:02.52,0:05:06.38,Main,,0,0,0,,Yeraltındaki ticaret limanını\Ngördükten sonra anladım ki...
Dialogue: 0,0:05:10.90,0:05:12.71,Main,,0,0,0,,Bu savaş,...
Dialogue: 0,0:05:12.71,0:05:17.38,Main,,0,0,0,,...Doflamingo'yu yensek bile bitmeyecek.
Dialogue: 0,0:05:19.38,0:05:22.02,Main,,0,0,0,,Dünyada devasa dalgalara neden olacak.
Dialogue: 0,0:05:23.48,0:05:26.58,Main,,0,0,0,,Ve sizler de fırtınanın göbeğindeki\Nisimler olacaksınız.
Dialogue: 0,0:05:28.48,0:05:29.76,Main,,0,0,0,,Evet...
Dialogue: 0,0:05:30.34,0:05:31.99,Main,,0,0,0,,Amacımız da o zaten.
Dialogue: 0,0:05:50.58,0:05:53.00,Main,,0,0,0,,Dördüncü Düzen mi?
Dialogue: 0,0:05:53.00,0:05:54.06,Main,,0,0,0,,Aynen öyle!
Dialogue: 0,0:06:13.78,0:06:15.60,Main,,0,0,0,,{\fad(150,150)}Kas Balonu!
Dialogue: 0,0:06:45.18,0:06:46.70,Main,,0,0,0,,{\fad(150,150)}Dördüncü...
Dialogue: 0,0:06:46.70,0:06:49.66,Main,,0,0,0,,{\fad(150,150)}...Düzen!
Dialogue: 0,0:06:56.62,0:06:59.46,Main,,0,0,0,,{\fad(150,150)}Seken-Adam!
Dialogue: 0,0:07:09.06,0:07:12.33,Main,,0,0,0,,Güldürmesene beni!\NBu ne şimdi?!
Dialogue: 0,0:07:12.33,0:07:15.66,Main,,0,0,0,,Büyüdün büyümesine de...
Dialogue: 0,0:07:15.66,0:07:19.30,Main,,0,0,0,,Gizli bir tür kozun falan var\Nsandım ben de...
Dialogue: 0,0:07:19.30,0:07:23.87,Main,,0,0,0,,Lastik balon gibi olduğundan\Nyerinde bile duramıyorsun.
Dialogue: 0,0:07:23.87,0:07:27.72,Main,,0,0,0,,Bu halinle\Nnasıl canıma okuyacaksın?
Dialogue: 0,0:07:29.76,0:07:31.78,Main,,0,0,0,,İki yıl boyunca...
Dialogue: 0,0:07:31.78,0:07:36.98,Main,,0,0,0,,...aklın almayacağı boyutlarda\Nvahşi yaratıklarla savaştım!
Dialogue: 0,0:07:47.68,0:07:50.07,Main,,0,0,0,,Onları alt edebilmek için de...
Dialogue: 0,0:07:50.07,0:07:53.80,Main,,0,0,0,,...bu devasa ve sıçrayan bedene\Nihtiyacım oldu!
Dialogue: 0,0:07:59.82,0:08:02.14,Main,,0,0,0,,Böyle sıçramanın\Nne faydası var ki?!
Dialogue: 0,0:08:06.76,0:08:07.96,Main,,0,0,0,,Kapa çeneni!
Dialogue: 0,0:08:11.64,0:08:12.92,Main,,0,0,0,,Artık...
Dialogue: 0,0:08:14.96,0:08:17.28,Main,,0,0,0,,...hiçbir şey yapamayacaksın!
Dialogue: 0,0:08:22.78,0:08:25.20,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:08:26.52,0:08:29.97,Main,,0,0,0,,{\fad(150,150)}...Kong...
Dialogue: 0,0:08:32.42,0:08:34.28,Main,,0,0,0,,{\fad(150,150)}...Silahı!
Dialogue: 0,0:09:02.06,0:09:04.19,Main,,0,0,0,,Doflamingo bu!
Dialogue: 0,0:09:04.19,0:09:05.24,Main,,0,0,0,,Neden burada?!
Dialogue: 0,0:09:21.00,0:09:22.47,Main,,0,0,0,,Geri çekilin!
Dialogue: 0,0:09:23.30,0:09:26.58,Main,,0,0,0,,Neden buradasın\Nlanet olası Doflamingo!?
Dialogue: 0,0:09:27.12,0:09:29.64,Main,,0,0,0,,Onu ben de merak ediyorum.
Dialogue: 0,0:09:34.42,0:09:36.91,Main,,0,0,0,,Kaçın!\NÖldürecek bizi!
Dialogue: 0,0:09:37.62,0:09:41.38,Main,,0,0,0,,Kaçacak bir yer yok ki!\NO tarafta da Kuş Kafesi var!
Dialogue: 0,0:09:46.38,0:09:48.79,Main,,0,0,0,,Şehir merkezindeyim ha?
Dialogue: 0,0:09:48.79,0:09:50.74,Main,,0,0,0,,Ne uçmuşum...
Dialogue: 0,0:10:02.10,0:10:04.78,Main,,0,0,0,,Elastik gücünü kullanarak uçuyor!
Dialogue: 0,0:10:10.24,0:10:12.71,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:10:14.90,0:10:17.04,Main,,0,0,0,,{\fad(150,150)}...Gergedan Havantopu!
Dialogue: 0,0:10:26.22,0:10:27.94,Main,,0,0,0,,Biri daha geliyor!
Dialogue: 0,0:10:27.94,0:10:30.90,Main,,0,0,0,,Kocaman!\NDoflamingo'yu uzağa tekmeledi!
Dialogue: 0,0:10:39.66,0:10:42.52,Main,,0,0,0,,Şu top gibi sıçrayan\Neleman da kimin nesi?!
Dialogue: 0,0:10:53.20,0:10:54.91,Thoughts,,0,0,0,,Lanet olsun!
Dialogue: 0,0:10:54.91,0:11:01.83,Thoughts,,0,0,0,,{\i1}Derisini katı silahlanmayla\Nsertleştirip gerginliğini katlıyor!{\i0}
Dialogue: 0,0:11:06.96,0:11:11.26,Main,,0,0,0,,Top görünüşlü adi\Nlastikten başka bir şey değil!
Dialogue: 0,0:11:21.58,0:11:26.74,Main,,0,0,0,,Dördüncü Düzen karşısında\Nhiçbir şey yapamayacaksın demiştim!
Dialogue: 0,0:11:47.70,0:11:51.12,Main,,0,0,0,,{\fad(150,150)}  Gomu Gomu no...
Dialogue: 0,0:11:55.42,0:11:57.36,Main,,0,0,0,,{\fad(150,150)}...Misket Topu!
Dialogue: 0,0:12:01.71,0:12:02.82,Main,,0,0,0,,{\fad(150,150)}Atlet!
Dialogue: 0,0:12:10.04,0:12:12.78,Thoughts,,0,0,0,,{\i1}Katı silahlanmış olmasına rağmen\Nnasıl lastikten olabiliyor?!{\i0}
Dialogue: 0,0:12:13.50,0:12:15.57,Main,,0,0,0,,Öyle bir saldırı...
Dialogue: 0,0:12:16.74,0:12:19.08,Main,,0,0,0,,...işe yaramaz!
Dialogue: 0,0:12:21.18,0:12:22.71,Main,,0,0,0,,Nasıl olur?!
Dialogue: 0,0:12:22.71,0:12:24.77,Main,,0,0,0,,Elimden kurtulamazsın Mingo!
Dialogue: 0,0:12:24.77,0:12:26.62,Main,,0,0,0,,Canına okuyacağım!
Dialogue: 0,0:12:30.00,0:12:32.74,Thoughts,,0,0,0,,{\i1}Nasıl!?\NBu sefer de uzuyor!{\i0}
Dialogue: 0,0:12:35.92,0:12:38.36,Main,,0,0,0,,Peşinden git, Piton!
Dialogue: 0,0:12:38.36,0:12:40.26,Main,,0,0,0,,Yeter! Düş artık!
Dialogue: 0,0:12:41.53,0:12:43.85,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:12:50.88,0:12:54.65,Main,,0,0,0,,{\fad(150,150)}...Misket Topu!
Dialogue: 0,0:13:36.79,0:13:38.08,Main,,0,0,0,,Lastik top...
Dialogue: 0,0:13:38.08,0:13:39.46,Main,,0,0,0,,Doflamingo'yu...
Dialogue: 0,0:13:39.46,0:13:40.97,Main,,0,0,0,,...elinde oynatıyor!
Dialogue: 0,0:14:02.47,0:14:04.16,Main,,0,0,0,,Kim bu herif?!
Dialogue: 0,0:14:04.16,0:14:05.73,Main,,0,0,0,,Ne fark eder!?
Dialogue: 0,0:14:05.73,0:14:06.90,Main,,0,0,0,,Göster gününü!
Dialogue: 0,0:14:06.90,0:14:08.07,Main,,0,0,0,,Başarabilirsin!
Dialogue: 0,0:14:11.98,0:14:16.52,Captions,,0,0,0,,{\fad(525,0)\pos(640,545)}Kraliyet Sarayı Platosu
Dialogue: 0,0:14:14.33,0:14:15.68,Main,,0,0,3,,Gördün mü?!
Dialogue: 0,0:14:15.68,0:14:16.75,Main,,0,0,3,,Evet...
Dialogue: 0,0:14:16.75,0:14:21.99,Main,,0,0,0,,Acayip farklı olmuş!\NCiddi ciddi Hasır Şapka mı bu?!
Dialogue: 0,0:14:22.62,0:14:27.70,Main,,0,0,0,,Doflamingo'yu elinde oynatıyor,\Nacayip güçlü olmalı!
Dialogue: 0,0:14:27.70,0:14:30.85,Main,,0,0,0,,Fakat Haki'yi fazla kullanıyor.
Dialogue: 0,0:14:32.31,0:14:34.53,Main,,0,0,0,,Haki'yi fazla mı kullanıyor?
Dialogue: 0,0:14:40.21,0:14:42.27,Main,,0,0,0,,Oraya mı gitmiş?!
Dialogue: 0,0:14:42.27,0:14:44.98,Main,,0,0,0,,Partiyi başka yere taşımış.
Dialogue: 0,0:14:44.98,0:14:48.84,Main,,0,0,0,,Buraya geleceğim diye\No kadar da uğraştım!
Dialogue: 0,0:14:48.84,0:14:53.32,Thoughts,,0,0,0,,{\i1}Karasakal Korsanları,\Nbirinci gemi kaptanı Jesus Burgess.{\i0}
Dialogue: 0,0:14:53.32,0:14:54.54,Thoughts,,0,0,0,,{\i1}Burada ortaya çıktı.{\i0}
Dialogue: 0,0:14:55.61,0:14:58.28,Main,,0,0,0,,Peşlerinden mi gitmeli, beklemeli mi?
Dialogue: 0,0:14:58.28,0:15:00.88,Main,,0,0,0,,İki türlü de elimden kurtulamayacaklar!
Dialogue: 0,0:15:00.88,0:15:03.23,Main,,0,0,0,,Almaya geldiğim şeyi alacağım!
Dialogue: 0,0:15:06.57,0:15:09.33,Thoughts,,0,0,0,,{\i1}Tahmin ettiğim gibi\NLuffy-kun'ların peşinde...{\i0}
Dialogue: 0,0:15:09.33,0:15:10.69,Thoughts,,0,0,0,,{\i1}Ama onlardan ne istiyor?!{\i0}
Dialogue: 0,0:15:11.02,0:15:16.79,Captions,,0,0,0,,{\fad(865,0)\pos(640,545)}Corrida Kolezyumu
Dialogue: 0,0:15:15.79,0:15:17.14,Main,,0,0,3,,{\i1}Viola.{\i0}
Dialogue: 0,0:15:17.14,0:15:20.51,Main,,0,0,0,,{\i1}Geriye yalnızca her şeye karar verecek\NLuffy-kun'un savaşı kalıyor.{\i0}
Dialogue: 0,0:15:20.51,0:15:22.70,Main,,0,0,0,,Evet, aynen öyle baba.
Dialogue: 0,0:15:22.70,0:15:27.31,Main,,0,0,0,,Yönetici ve üstü\NDoflamingo'dan başka kimse kalmadı.
Dialogue: 0,0:15:27.20,0:15:31.54,Captions,,0,0,0,,{\fad(525,0)\pos(615,545)}GÜLÜCÜK Fabrikası
Dialogue: 0,0:15:27.31,0:15:30.11,Main,,0,0,3,,Fabrikadan uzaklaşalım, Tontattalar!
Dialogue: 0,0:15:32.41,0:15:33.45,Main,,0,0,0,,Peki!
Dialogue: 0,0:15:33.45,0:15:37.88,Main,,0,0,0,,Gitmemiz lazım, süper acele edin!
Dialogue: 0,0:15:45.93,0:15:49.87,Main,,0,0,0,,Fabrikada esir tutulan dostlarımızı\Nbaşarıyla kurtardık!
Dialogue: 0,0:15:50.96,0:15:51.97,Main,,0,0,0,,Güzel!
Dialogue: 0,0:15:57.77,0:16:00.13,Main,,0,0,0,,Fabrika eğiliyor!
Dialogue: 0,0:16:01.33,0:16:05.26,Main,,0,0,0,,Fraland! Neden GÜLÜCÜK fabrikası da\Ndiğer her şey gibi kesilmiyor?!
Dialogue: 0,0:16:06.17,0:16:07.41,Main,,0,0,0,,Kesilmiyor mu?!
Dialogue: 0,0:16:08.29,0:16:10.61,Main,,0,0,0,,Tabii ya, Kairouseki!
Dialogue: 0,0:16:10.61,0:16:11.89,Main,,0,0,0,,Kairouseki mi?
Dialogue: 0,0:16:11.89,0:16:17.14,Main,,0,0,0,,Evet, fabrikanın dış duvarları\NKairouseki'den yapılma.
Dialogue: 0,0:16:17.14,0:16:22.36,Main,,0,0,0,,O yüzden de Şeytan Meyvesi'yle\Nyaratılan sicimler onu kesemiyor fakat...
Dialogue: 0,0:16:22.36,0:16:23.96,Main,,0,0,0,,Fakat bakın!
Dialogue: 0,0:16:31.97,0:16:33.61,Main,,0,0,0,,Sicimlerle beraber sürükleniyor!
Dialogue: 0,0:16:35.21,0:16:36.56,Main,,0,0,0,,O şey...
Dialogue: 0,0:16:36.56,0:16:37.76,Main,,0,0,0,,Franky!
Dialogue: 0,0:16:37.76,0:16:39.71,Main,,0,0,0,,Robot-dono!
Dialogue: 0,0:16:44.16,0:16:46.92,Main,,0,0,0,,Zoroland! Topuzland!
Dialogue: 0,0:16:46.92,0:16:48.78,Main,,0,0,0,,Hey, Zoro, Kin'emon!
Dialogue: 0,0:16:48.78,0:16:52.33,Main,,0,0,0,,Ülkenin merkezi az önce geldiğiniz yöndedir.
Dialogue: 0,0:16:52.33,0:16:54.19,Main,,0,0,0,,Kaçmak istiyorsanız\Nöteki tarafa gitmeniz lazım!
Dialogue: 0,0:16:55.75,0:16:58.94,Main,,0,0,0,,Ne?! Hiçbir yere kaçtığımız yok,\Nsicimleri durduracağız!
Dialogue: 0,0:16:58.94,0:17:02.53,Main,,0,0,0,,Durduracak mısınız?\NHiç aklıma gelmedi ha!
Dialogue: 0,0:17:02.53,0:17:05.61,Main,,0,0,0,,Vay canına!
Dialogue: 0,0:17:06.31,0:17:10.09,Main,,0,0,0,,Luffy bu işe bir son verene dek\Nona zaman kazandırmamız lazım!
Dialogue: 0,0:17:13.49,0:17:14.53,Main,,0,0,0,,Sahi ya!
Dialogue: 0,0:17:14.64,0:17:20.24,Captions,,0,0,0,,{\fad(1000,0)\pos(640,480)}Şehir Merkezi\NLuffy, Doflamingo'ya Karşı
Dialogue: 0,0:17:34.45,0:17:39.51,Thoughts,,0,0,0,,{\i1}Haki'yle lastiğin şişip büzülme özelliğini\Ngönlünce kontrol ediyor.{\i0}
Dialogue: 0,0:17:43.99,0:17:47.15,Thoughts,,0,0,0,,{\i1}Katı silahlanma ve lastik özelliğini\Nharmanlıyor...{\i0}
Dialogue: 0,0:17:57.61,0:17:59.91,Main,,0,0,0,,Bu iş fazla uzun sürerse\NDördüncü Düzen...
Dialogue: 0,0:18:02.27,0:18:08.63,Main,,0,0,0,,Yeteneğini epey iyi kullanıyormuşsun\Nama kendine fazla yükleniyorsun gibi.
Dialogue: 0,0:18:09.21,0:18:11.48,Main,,0,0,0,,Eminim bunun\Nbir takım riskleri de vardır.
Dialogue: 0,0:18:11.48,0:18:14.15,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:18:14.15,0:18:18.04,Main,,0,0,0,,Hasır Şapka, kaç saniye daha\Nböyle dayanabileceksin?
Dialogue: 0,0:18:18.04,0:18:19.01,Main,,0,0,0,,{\fad(150,150)}...Çifte...
Dialogue: 0,0:18:21.19,0:18:25.34,Main,,0,0,0,,Benim sicimleriminse sonu yok!
Dialogue: 0,0:18:25.34,0:18:27.06,Main,,0,0,0,,{\fad(150,150)}...Misket Topu!
Dialogue: 0,0:18:27.06,0:18:28.39,Main,,0,0,0,,{\fad(150,150)}Kirli Beyaz!
Dialogue: 0,0:18:32.26,0:18:34.99,Main,,0,0,0,,Sicimler yerden nasıl çıktılar?!
Dialogue: 0,0:18:35.67,0:18:38.25,Main,,0,0,0,,Bu şehre ne yaptın sen?!
Dialogue: 0,0:18:39.95,0:18:42.17,Main,,0,0,0,,Beni dinle, yeni yetme!
Dialogue: 0,0:18:44.13,0:18:51.98,Main,,0,0,0,,Şeytan Meyveleri \N"uyanış" denen ikinci bir aşamaya sahiptirler!
Dialogue: 0,0:19:00.67,0:19:02.54,Main,,0,0,0,,Binalar da sicime dönüştü!
Dialogue: 0,0:19:04.29,0:19:06.73,Main,,0,0,0,,Çok nadir olarak\Ngüç kişide uyanır...
Dialogue: 0,0:19:06.76,0:19:10.43,Main,,0,0,0,,...ve kişinin vücudu dışında\Nşeyleri de etkilemeye başlar!
Dialogue: 0,0:19:12.55,0:19:16.75,Main,,0,0,0,,Bir sürü şey sicime dönüştü,\NParamecia gücüne benzemiyor!
Dialogue: 0,0:19:16.75,0:19:20.55,Main,,0,0,0,,Beni çevreleyen her şey sicime dönüşür!
Dialogue: 0,0:19:22.43,0:19:25.97,Main,,0,0,0,,Yanıma yaklaşamayacaksın bile!
Dialogue: 0,0:19:34.87,0:19:40.75,Main,,0,0,0,,Senin gücün tükendiğinde,\Nbenim vücudumsa...
Dialogue: 0,0:20:06.97,0:20:12.19,Main,,0,0,0,,Haki'n suyunu çektiğinde\Nsana son darbeyi ben vuracağım!
Dialogue: 0,0:20:14.70,0:20:18.80,Captions,,980,0,280,,{\fad(300,300)}20 Dakika\NSonra
Dialogue: 0,0:20:16.33,0:20:18.75,Main,,0,0,0,,Kesileceğiz!\NKaçın!
Dialogue: 0,0:20:30.11,0:20:31.62,Main,,0,0,0,,Nine!
Dialogue: 0,0:20:33.11,0:20:35.63,Main,,0,0,0,,Nine, kalk hadi!\NKesileceksin!
Dialogue: 0,0:20:37.13,0:20:38.37,Main,,0,0,0,,İmkansız...
Dialogue: 0,0:20:39.71,0:20:41.81,Main,,0,0,0,,Koşacak gücüm kalmadı.
Dialogue: 0,0:20:45.45,0:20:47.75,Main,,0,0,0,,Bırak beni, git sen!
Dialogue: 0,0:20:47.75,0:20:50.83,Main,,0,0,0,,Olmaz, olmaz işte!\NYapamam!
Dialogue: 0,0:20:52.51,0:20:56.00,Main,,0,0,0,,Öyle ya da böyle\Nkurtulmam mümkün değil zaten!
Dialogue: 0,0:20:56.00,0:20:57.82,Main,,0,0,0,,Kalk lütfen!
Dialogue: 0,0:20:57.82,0:21:03.35,Main,,0,0,0,,Kalksam bile\Nşehir merkezine kadar koşamam!
Dialogue: 0,0:21:07.47,0:21:10.30,Main,,0,0,0,,Yardım edecek kimse yok mu?
Dialogue: 0,0:21:10.30,0:21:13.02,Main,,0,0,0,,Hastanede hâlâ hastalar var!
Dialogue: 0,0:21:13.02,0:21:15.37,Main,,0,0,0,,Hepsini taşıyamıyoruz, yardımcı olun!
Dialogue: 0,0:21:17.81,0:21:21.50,Main,,0,0,0,,Oğlumu bulamıyorum!\NOnu gören oldu mu?!
Dialogue: 0,0:21:21.50,0:21:24.99,Main,,0,0,0,,Kuma resimli bluz giyiyor!\NBeş yaşında!
Dialogue: 0,0:21:24.99,0:21:27.97,Main,,0,0,0,,Oğlumu gördünüz mü?!
Dialogue: 0,0:21:33.59,0:21:36.17,Thoughts,,0,0,0,,Hepimiz öleceğiz zaten...
Dialogue: 0,0:21:37.27,0:21:38.53,Thoughts,,0,0,0,,Niye uğraşıyoruz ki?!
Dialogue: 0,0:21:40.75,0:21:43.55,Thoughts,,0,0,0,,Ne kadar kaçarsak kaçalım\Nkafesin içindeyiz.
Dialogue: 0,0:21:43.55,0:21:45.75,Thoughts,,0,0,0,,Doflamingo öyle ya da böyle\Nhepimizi öldürecek.
Dialogue: 0,0:21:46.63,0:21:48.01,Thoughts,,0,0,0,,Oysa şimdi vazgeçmek...
Dialogue: 0,0:21:49.40,0:21:50.87,Thoughts,,0,0,0,,...çok daha kolay.
Dialogue: 0,0:22:11.29,0:22:13.51,Main,,0,0,0,,Millet, beni dinleyin.
Dialogue: 0,0:22:14.10,0:22:15.79,Main,,0,0,0,,{\i1}Ben...{\i0}
Dialogue: 0,0:22:15.79,0:22:20.20,Main,,0,0,0,,{\i1}...Dressrosa'nın eski kralı\NRiku 3. Doldo!{\i0}
Dialogue: 0,0:22:23.26,0:22:24.65,Main,,0,0,0,,Bu da ne?!
Dialogue: 0,0:22:25.27,0:22:27.09,Main,,0,0,0,,Kral Riku-sama...
Dialogue: 0,0:22:29.09,0:22:35.63,Main,,0,0,0,,Ülke şu anda, mevcut kral Doflamingo'nun\Nbaşlattığı bir oyun yüzünden...
Dialogue: 0,0:22:35.63,0:22:39.07,Main,,0,0,0,,...içinden kaçamayacağımız\Nbir Kuş Kafesi'ne hapsolmuş durumda.
Dialogue: 0,0:22:39.71,0:22:47.07,Main,,0,0,0,,{\i1}Üstüne üstlük bu kafes giderek küçülmekte \Nküçüldükçe de şehri kesip geçmektedir.{\i0}
Dialogue: 0,0:22:51.75,0:22:53.56,Main,,0,0,0,,Kral Riku-sama...
Dialogue: 0,0:22:53.56,0:22:56.31,Main,,0,0,0,,Aniden yüzünüze çalınan\Ngerçekler karşısında...
Dialogue: 0,0:22:57.39,0:23:00.37,Main,,0,0,0,,...neler hissedeceğinizi bilmiyor...
Dialogue: 0,0:23:01.07,0:23:05.85,Main,,0,0,0,,...ve yalnızca hayatınızı, hayatları\Nkurtarmaya çalışıyor olabilirsiniz!
Dialogue: 0,0:23:07.97,0:23:10.85,Main,,0,0,0,,{\i1}Fakat hayal görmüyorsunuz!{\i0}
Dialogue: 0,0:23:11.45,0:23:14.45,Main,,0,0,0,,{\i1}Bugün başlamış\Nbir kabus da değil bu!{\i0}
Dialogue: 0,0:23:15.31,0:23:17.68,Main,,0,0,0,,On yıl boyunca...
Dialogue: 0,0:23:17.68,0:23:22.49,Main,,0,0,0,,...korsanların hüküm sürdüğü,\NDressrosa denen...
Dialogue: 0,0:23:22.49,0:23:24.89,Main,,0,0,0,,...bir kafesin içindeydik!
Dialogue: 0,0:23:30.65,0:23:37.81,Main,,0,0,0,,On yıl boyunca ellerinde istedikleri gibi\Noynattıkları kuklalarıydık.
Dialogue: 0,0:23:38.85,0:23:41.01,Main,,0,0,0,,{\i1}Gerçek budur!{\i0}
Dialogue: 0,0:23:41.93,0:23:44.39,Main,,0,0,0,,{\i1}Fakat çok uzun sürmeyecek!{\i0}
Dialogue: 0,0:23:45.40,0:23:50.42,Main,,0,0,0,,Kimsenin gücünün yetmeyeceğini\Ndüşündüğümüz Donquixote Ailesi'nin...
Dialogue: 0,0:23:50.42,0:23:55.15,Main,,0,0,0,,...şans eseri ülkeye ayak basmış\Ngüçlü savaşçılar tarafından...
Dialogue: 0,0:23:55.15,0:23:57.47,Main,,0,0,0,,...hemen hemen kökü kazındı!
Dialogue: 0,0:23:57.47,0:24:00.44,Main,,0,0,0,,Tüm aile yöneticileri yenildi!
Dialogue: 0,0:24:00.44,0:24:01.48,Main,,0,0,0,,Sahi mi?!
Dialogue: 0,0:24:01.48,0:24:03.67,Main,,0,0,0,,O yöneticiler...
Dialogue: 0,0:24:03.67,0:24:05.65,Main,,0,0,0,,Yenildiler ha?!
Dialogue: 0,0:24:05.65,0:24:08.43,Main,,0,0,0,,{\i1}Geriye alt edilecek tek kişi...{\i0}
Dialogue: 0,0:24:08.43,0:24:12.89,Main,,0,0,0,,...mevcut Dressrosa kralı\NDoflamingo kaldı!
Dialogue: 0,0:24:23.85,0:24:28.21,Main,,0,0,0,,Onunla mücadele eden kişiyse\Nkorsan Hasır Şapkalı Luffy!
Dialogue: 0,0:24:28.91,0:24:33.61,Main,,0,0,0,,Onun Kuş Kafesi'ni bizim için\Nyok edecek adam olduğuna eminim!
Dialogue: 0,0:24:34.95,0:24:39.29,Main,,0,0,0,,Yense de yenilse de\Nartık sona fazla vakit kalmadı!
Dialogue: 0,0:24:39.29,0:24:42.99,Main,,0,0,0,,O zamana dek\Nelinizden geleni yapın ve sağ kalın!
Dialogue: 0,0:24:43.79,0:24:49.43,Main,,0,0,0,,{\i1}Kimsenin küçülen şehir altında\Nezilmesini istemiyorum!{\i0}
Dialogue: 0,0:24:49.43,0:24:51.61,Main,,0,0,0,,{\i1}Koşun!{\i0}
Dialogue: 0,0:24:52.11,0:24:56.19,Main,,0,0,0,,{\i1}Nefesiniz kesilse de,\Nbacaklarınız kırılsa da...{\i0}
Dialogue: 0,0:24:56.19,0:25:00.27,Main,,0,0,0,,{\i1}...birazcık daha\Nhayatta kalmaya çalışın!{\i0}
Dialogue: 0,0:25:07.81,0:25:10.08,Main,,0,0,0,,Umutlar tamamen tükenmiş değil!
Dialogue: 0,0:25:10.08,0:25:12.81,Main,,0,0,0,,Yalvarırım vazgeçmeyin!
Dialogue: 0,0:25:20.78,0:25:22.84,Main,,0,0,0,,Sadece biz ile olsak\Nelimizden geleni yapalım!
Dialogue: 0,0:25:23.75,0:25:24.62,Main,,0,0,0,,Evet!
Dialogue: 0,0:25:24.62,0:25:27.13,Main,,0,0,0,,Pekâlâ, koşuyoruz torun!
Dialogue: 0,0:25:33.61,0:25:35.55,Main,,0,0,0,,Peki nine!
Dialogue: 0,0:25:36.09,0:25:37.13,Main,,0,0,0,,Ben de!
Dialogue: 0,0:25:38.28,0:25:40.40,Main,,0,0,0,,Kral Riku-sama'nın dediği gibi...
Dialogue: 0,0:25:40.40,0:25:43.39,Main,,0,0,0,,Vazgeçmeksizin şehir merkezine koşacağız!
Dialogue: 0,0:25:43.39,0:25:44.95,Main,,0,0,0,,Hastaları taşıyın!
Dialogue: 0,0:25:44.95,0:25:46.05,Main,,0,0,0,,Yatakları itin!
Dialogue: 0,0:25:57.85,0:25:59.77,Main,,0,0,0,,Anne!
Dialogue: 0,0:26:03.71,0:26:07.21,Main,,0,0,0,,Savaş sonuçlanana kadar yaşayalım!
Dialogue: 0,0:26:07.21,0:26:11.78,Main,,0,0,0,,Hasır Şapkalı Luffy,\NDoflamingo'yu bizim için yen!
Dialogue: 0,0:26:11.78,0:26:12.46,Main,,0,0,0,,Evet!
Dialogue: 0,0:26:18.27,0:26:20.09,Main,,0,0,0,,Mingo!
Dialogue: 0,0:26:25.27,0:26:27.53,Main,,0,0,0,,Geberme zamanın geldi!
Dialogue: 0,0:26:30.11,0:26:31.80,Main,,0,0,0,,Zamanım tükeniyor!
Dialogue: 0,0:26:31.80,0:26:33.45,Main,,0,0,0,,Tüm şehir sicime dönüşüyor!
Dialogue: 0,0:26:34.65,0:26:36.57,Main,,0,0,0,,{\fad(150,150)}Kabaran Beyaz Sicimler!
Dialogue: 0,0:26:47.21,0:26:49.69,Main,,0,0,0,,Mingo!
