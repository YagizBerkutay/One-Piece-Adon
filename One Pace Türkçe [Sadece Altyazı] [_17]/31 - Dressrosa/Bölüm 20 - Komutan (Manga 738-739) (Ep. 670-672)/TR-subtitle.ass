FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1,1,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:23.75,0:00:28.07,Credits,,0,0,0,,Translation & initial timing YibisDialogue: 0,0:00:28.16,0:00:32.16,Credits,,0,0,0,,Timing SewilDialogue: 0,0:00:34.66,0:00:37.60,Credits,,0,0,0,,Quality-checking Sewil Galaxy 9000 HaleeDialogue: 0,0:00:39.02,0:00:42.64,Credits,,0,0,0,,Soundtracking HaleeDialogue: 0,0:00:45.87,0:00:48.56,Credits,,0,0,0,,Video editing         SewilDialogue: 0,0:00:45.87,0:00:48.56,Credits,,0,0,0,,Raw provider      GS-RawsDialogue: 0,0:00:01.26,0:00:03.90,Lyrics,,0,0,0,,♪ Gidelim tüm parıltımızla, koşar adım, sonsuza dek! ♪Dialogue: 0,0:00:03.93,0:00:06.66,Lyrics,,0,0,0,,♪ İlerlemeye devam edelim! ♪Dialogue: 0,0:00:06.70,0:00:09.57,Lyrics,,0,0,0,,♪ Değişmeyen bağlar mutlak aydınlatacak... ♪Dialogue: 0,0:00:09.63,0:00:12.67,Lyrics,,0,0,0,,♪ ...rüyamızın sonunu! ♪Dialogue: 0,0:00:12.77,0:00:15.27,Lyrics,,0,0,0,,♪ Uyan, uyan, uyan, uyan haydi kalbim! ♪Dialogue: 0,0:00:15.34,0:00:18.18,Lyrics,,0,0,0,,♪ Başaracağız! Durmaksızın devam! ♪Dialogue: 0,0:00:23.72,0:00:28.07,Lyrics,,0,0,0,,♪ Tek pusulamız özgürlüktür. En sıkı dostlarız. ♪Dialogue: 0,0:00:28.15,0:00:34.59,Lyrics,,0,0,0,,♪ Kendi rotamızı bundan sonra da yine kendimiz çizeceğiz. ♪Dialogue: 0,0:00:34.66,0:00:39.00,Lyrics,,0,0,0,,♪ Her gün tam hız ilerliyoruz. Doğuya git, batıya git. ♪Dialogue: 0,0:00:39.06,0:00:45.44,Lyrics,,0,0,0,,♪ Birbiri ardına yapmak istediğimiz şeyler buluyor ve yapıyoruz da hepsini. ♪Dialogue: 0,0:00:45.50,0:00:50.99,Lyrics,,0,0,0,,♪ Sabahları etmeye dayanamaz aceleci gönlümüz. (Bekleyemem!) ♪Dialogue: 0,0:00:51.11,0:00:56.05,Lyrics,,0,0,0,,♪ Neden alıp biz yapıştırmıyoruz güneşi göğe. ♪Dialogue: 0,0:00:56.11,0:00:58.95,Lyrics,,0,0,0,,♪ Zorla ve yola çıkmıyoruz! ♪Dialogue: 0,0:00:59.95,0:01:02.65,Lyrics,,0,0,0,,♪ Evet tüm parıltımızla, koşar adım, sonsuza dek! ♪Dialogue: 0,0:01:02.72,0:01:06.59,Lyrics,,0,0,0,,♪ Hayal kırıntılarımız birleştirerek. ♪Dialogue: 0,0:01:06.66,0:01:10.75,Lyrics,,0,0,0,,♪ Titretiyorsa eğer gönlünü var mı daha büyük hazine. ♪Dialogue: 0,0:01:10.83,0:01:13.43,Lyrics,,0,0,0,,♪ Gidelim tüm parıltımızla, koşar adım, sonsuza dek! ♪Dialogue: 0,0:01:13.50,0:01:16.13,Lyrics,,0,0,0,,♪ İlerlemeye devam edelim! ♪Dialogue: 0,0:01:16.20,0:01:19.17,Lyrics,,0,0,0,,♪ Değişmeyen bağlar mutlak aydınlatacak... ♪Dialogue: 0,0:01:19.24,0:01:22.24,Lyrics,,0,0,0,,♪ ...rüyamızın sonunu! ♪Dialogue: 0,0:01:22.31,0:01:24.94,Lyrics,,0,0,0,,♪ Uyan, uyan, uyan, uyan haydi kalbim ♪Dialogue: 0,0:01:25.01,0:01:27.41,Lyrics,,0,0,0,,♪ Başaracağız! Durmaksızın devam! ♪Dialogue: 0,0:01:34.54,0:01:38.61,Captions,,0,0,0,,Yer Altı Ticaret Limanı Yönetim Kulesi ÖnüDialogue: 0,0:01:39.36,0:01:45.65,Thoughts,Leo,0,0,0,,Bu Tatababasco'dan yapılan dünyanın en acı üzümüyle Sugar'ı bayıltacağım!Dialogue: 0,0:01:55.69,0:02:05.69,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gnsDialogue: 0,0:13:04.00,0:13:14.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gnsDialogue: 0,0:24:23.00,0:24:33.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gnsDialogue: 0,0:01:55.69,0:01:59.73,Title,,0,0,240,,KomutanDialogue: 0,0:01:56.02,0:01:58.18,Main,Sugar,0,0,0,,Ne oldu?Dialogue: 0,0:02:02.66,0:02:03.50,Main,Robin,0,0,0,,Bu...Dialogue: 0,0:02:04.05,0:02:05.80,Main,Trébol,0,0,0,,Sinek vardı.Dialogue: 0,0:02:08.44,0:02:10.01,Main,Gnome,0,0,0,,Uçan sineği mi vurdu?!Dialogue: 0,0:02:10.01,0:02:14.28,Main,Leo,0,0,0,,SOP Operasyonu mutlaka başarıyla sonuçlanacak!Dialogue: 0,0:02:17.08,0:02:19.58,Thoughts,Leo,0,0,0,,Sineği vurmuş olsa bile beni vuramaz çünkü ben...Dialogue: 0,0:02:19.58,0:02:21.13,Thoughts,Leo,0,0,0,,...çok daha hızlıyım!Dialogue: 0,0:02:23.76,0:02:25.88,Thoughts,,0,0,0,,Uçtu resmen, göremiyorum bile!Dialogue: 0,0:02:25.88,0:02:27.39,Thoughts,,0,0,0,,Belki bu şekilde başarabilir.Dialogue: 0,0:02:29.19,0:02:32.63,Thoughts,Leo,0,0,0,,Tutsak dostlarımızı kurtaracağız!Dialogue: 0,0:02:32.63,0:02:34.52,Thoughts,Gnomes,0,0,0,,- Haydi! - Leo!Dialogue: 0,0:02:34.52,0:02:35.94,Thoughts,Gnomes,0,0,0,,Yapabilirsin!Dialogue: 0,0:02:35.94,0:02:38.24,Thoughts,Usopp,0,0,0,,Başar şu işi be!Dialogue: 0,0:02:42.47,0:02:43.41,Thoughts,Robin,0,0,0,,Bekle, Leo!Dialogue: 0,0:02:45.89,0:02:47.38,Thoughts,Leo,0,0,0,,Robiland?!Dialogue: 0,0:02:47.38,0:02:50.35,Captions,,0,0,180,,Yer Altı Ticaret LimanındaDialogue: 0,0:02:51.24,0:02:55.05,Main,Grunt,0,0,0,,Bir yıldır yeni kimseyi yollamadılar ha.Dialogue: 0,0:03:00.23,0:03:01.72,Main,Grunt,0,0,2,,Evet...Dialogue: 0,0:03:00.36,0:03:05.43,Captions,,0,0,240,,Işıldayan Çiçekler  "Hoş Ayçiçekleri"Dialogue: 0,0:03:01.72,0:03:04.29,Main,Grunt,0,0,2,,Saraya da hiç gitmiyorlarmış.Dialogue: 0,0:03:05.76,0:03:08.76,Main,Grunt,0,0,2,,Aylaklık mı ediyorsunuz?!Dialogue: 0,0:03:06.21,0:03:11.64,Captions,,0,0,240,,İnsan Yapımı Şeytan Meyvesi GÜLÜCÜK Üretim FabrikasıDialogue: 0,0:03:08.76,0:03:11.64,Main,Gnome,0,0,2,,Aylaklık etmiyoruz!Dialogue: 0,0:03:18.91,0:03:24.38,Main,Grunt,0,0,0,,Kabilesinden 500 kişi geri dönmeyince insan bir durup düşünür be!Dialogue: 0,0:03:26.54,0:03:29.64,Main,Grunt,0,0,0,,Ama birilerinin onlara kötülük yapabileceğini dahi kestiremiyorlar.Dialogue: 0,0:03:29.66,0:03:31.68,Main,Grunt,0,0,0,,Bu yüzden de Tontattalar bu kadar salak...Dialogue: 0,0:03:31.68,0:03:35.00,Main,Grunt,0,0,0,,Yani saflar ya.Dialogue: 0,0:03:36.30,0:03:38.48,Main,Grunt,0,0,0,,Buraya niye gelmiyorlar artık peki?Dialogue: 0,0:03:38.48,0:03:40.17,Main,Grunt,0,0,0,,Kim bilir?Dialogue: 0,0:03:43.05,0:03:48.67,Main,Grunt,0,0,0,,Keyifleri bilir sonuçta, biz de elimizdeki 500'ünü canları çıkasıya çalıştırırız!Dialogue: 0,0:03:48.67,0:03:51.33,Main,Grunt,0,0,0,,Hızlanın biraz!  Aşk Kamçısı!Dialogue: 0,0:04:12.88,0:04:14.18,Main,Sanshita,0,0,0,,Hey!Dialogue: 0,0:04:14.18,0:04:16.39,Main,Sanshita,0,0,0,,Ham lan bu GÜLÜCÜKler!Dialogue: 0,0:04:19.86,0:04:20.86,Main,Gnome,0,0,0,,İyi misin?Dialogue: 0,0:04:21.80,0:04:25.71,Main,Sanshita,0,0,0,,Her tür bitkiyi yetiştirebilen Tontatta Kabilesi'nden değil misiniz siz?!Dialogue: 0,0:04:25.71,0:04:30.72,Main,Gnome,0,0,0,,Öyle... Fakat GÜLÜCÜKler hiç de doğal olmayan meyveler.Dialogue: 0,0:04:30.72,0:04:32.12,Main,Sanshita,0,0,0,,Bana bahane üretmeyin!Dialogue: 0,0:04:33.05,0:04:36.50,Main,Gnome,0,0,0,,Lütfen izin verin kardeşim biraz dinlensin!Dialogue: 0,0:04:36.50,0:04:39.14,Main,Gnome,0,0,0,,Bugün dağıtılan yemek biraz bozuktu, o yüzden...Dialogue: 0,0:04:39.14,0:04:41.03,Main,Sanshita,0,0,0,,Ha şimdi bir de yemekten şikayet eder oldunuz?Dialogue: 0,0:04:41.03,0:04:46.00,Main,Sanshita,0,0,0,,Prensesiniz Mancherie'nin hastalığını iyileştirmek istemiyor musunuz?!Dialogue: 0,0:04:46.00,0:04:48.48,Main,Gnome,0,0,0,,İstiyoruz!Dialogue: 0,0:04:48.48,0:04:51.44,Main,Sanshita,0,0,0,,O zaman çok daha fazla GÜLÜCÜK yapın!Dialogue: 0,0:04:51.44,0:04:55.44,Main,Sanshita,0,0,0,,Prensesin hastalığını iyileştirecek tek ilaç o!Dialogue: 0,0:04:56.02,0:05:01.25,Main,Sanshita,0,0,0,,Hâlâ bir mevsimde ürettiğiniz on meyveden dokuzu çöpe gidiyor!Dialogue: 0,0:05:01.25,0:05:03.75,Main,Sanshita,0,0,0,,Kafanızı çalıştırıp üretim kalitesini arttıracak bir yol bulun!Dialogue: 0,0:05:03.75,0:05:07.25,Main,Gnome,0,0,0,,Prenses Mancherie'yi gösterir misiniz bize?Dialogue: 0,0:05:09.44,0:05:10.06,Main,Sanshita,0,0,0,,Olmaz!Dialogue: 0,0:05:10.06,0:05:11.36,Main,Gnomes,0,0,0,,Neden peki?Dialogue: 0,0:05:14.65,0:05:17.86,Main,Sanshita,0,0,0,,Çünkü prensesin hastalığı size de bulaşacak olursa...Dialogue: 0,0:05:18.97,0:05:21.58,Main,Sanshita,0,0,0,,...kahroluruz!Dialogue: 0,0:05:21.58,0:05:25.57,Main,Sanshita,0,0,0,,Tontatta Kabilesi bizim için çok önemli bir iş ortağıdır!Dialogue: 0,0:05:29.54,0:05:32.48,Main,Gnome,0,0,0,,Sanshita-san!Dialogue: 0,0:05:32.48,0:05:35.24,Main,Gnome,0,0,0,,Elimizden geleni yapacağız!Dialogue: 0,0:05:35.24,0:05:38.97,Main,Gnome,0,0,0,,Lütfen prensese iyi bakın!Dialogue: 0,0:05:38.97,0:05:41.46,Main,Sanshita,0,0,0,,Elbette!Dialogue: 0,0:05:41.46,0:05:44.59,Thoughts,Sanshita,0,0,0,,Böyle bariz bir yalana nasıl inandılar anlamak güç!Dialogue: 0,0:05:45.64,0:05:48.66,Main,Leo,0,0,0,,Ne yapıyorsun, Robiland?!Dialogue: 0,0:05:48.66,0:05:54.16,Main,Robin,0,0,0,,Özür dilerim.  Ama seni durdurmasaydım vurulacaktın.Dialogue: 0,0:05:55.16,0:05:56.69,Main,Robin,0,0,0,,O vurulan sinek...Dialogue: 0,0:05:59.10,0:06:03.50,Main,Robin,0,0,0,,Küçücük olmasına rağmen tam iki gözünün ortasından vurulmuştu.Dialogue: 0,0:06:03.50,0:06:07.35,Main,Robin,0,0,0,,Trebol'un dinamik görüşü ve yeteneği nadir bulunur cinsten.Dialogue: 0,0:06:07.92,0:06:12.64,Main,Robin,0,0,0,,O Sugar'ın yakınlarındayken Sugar'a yaklaşmaya çalışmak çok tehlikeli!Dialogue: 0,0:06:14.82,0:06:18.12,Main,Usopp,0,0,0,,Ne yapacağız peki, Robiland?Dialogue: 0,0:06:21.02,0:06:21.96,Main,,0,0,0,,Oraya koyun.Dialogue: 0,0:06:25.43,0:06:27.81,Main,Grunt,0,0,0,,Bu kargo da neyin nesi?!Dialogue: 0,0:06:27.81,0:06:30.90,Main,Grunt,0,0,0,,Pembe eşekarısı kolonisi bu!Dialogue: 0,0:06:35.02,0:06:36.78,Main,Robin,0,0,0,,Acil bir durum bildirmek için rahatsız ettim, Trebol-sama!Dialogue: 0,0:06:39.06,0:06:44.18,Main,Robin,0,0,0,,Dördüncü liman bölgesinde Kaptan Ibbs'in tayfasıyla bir problem yaşıyoruz!Dialogue: 0,0:06:44.66,0:06:48.65,Main,Robin,0,0,0,,Yönetici ile para meselesini konuşmak istediklerini söyleyip ortalığı birbirine katmaya başladılar!Dialogue: 0,0:06:50.96,0:06:56.60,Main,Trébol,0,0,0,,Joker'dan da mı korkmuyor bunlar yahu? Cesarete bakar mısın!?Dialogue: 0,0:06:59.82,0:07:03.54,Main,Trébol,0,0,0,,O değil de sanki daha önce başkası haber veriyordu böyle şeyleri?Dialogue: 0,0:07:06.27,0:07:08.47,Main,Robin,0,0,0,,Kendisi yemek molasına çıktı!Dialogue: 0,0:07:09.44,0:07:10.54,Main,Robin,0,0,0,,Acil durum olduğundan ben geldim!Dialogue: 0,0:07:10.54,0:07:13.04,Main,Robin,0,0,0,,Adamlarımızdan yaralananlar oldu!Dialogue: 0,0:07:13.04,0:07:14.21,Main,Robin,0,0,0,,Lütfen yardım edin!Dialogue: 0,0:07:14.21,0:07:19.52,Main,Trébol,0,0,0,,Yaralananlar mı oldu dedin?! Geliyorum o zaman!Dialogue: 0,0:07:25.14,0:07:26.69,Main,Trébol,0,0,0,,Hey, hey!Dialogue: 0,0:07:27.57,0:07:29.38,Main,Grunt,0,0,0,,Trebol-sama, bir yere mi gidiyordunuz?Dialogue: 0,0:07:29.38,0:07:32.89,Main,Trébol,0,0,0,,Yönetim Kulesi'nin dört girişindeki savunmayı güçlendirin.Dialogue: 0,0:07:32.89,0:07:33.89,Main,Grunt,0,0,0,,Emredersiniz!Dialogue: 0,0:07:35.43,0:07:38.34,Main,Trébol,0,0,0,,Herhângi bir şey olursa hemen bana haber verin!Dialogue: 0,0:07:38.34,0:07:39.35,Main,Grunt,0,0,0,,Emredersiniz!Dialogue: 0,0:07:44.74,0:07:45.80,Main,Grunt,0,0,0,,Trébol-sama!Dialogue: 0,0:07:45.80,0:07:47.31,Main,Grunt,0,0,0,,Başımızda olmanıza müteşekkiriz!Dialogue: 0,0:07:47.31,0:07:48.98,Main,Trébol,0,0,0,,Hey, hey!Dialogue: 0,0:07:49.96,0:07:52.36,Main,Trébol,0,0,0,,Hani hani... Savaş nerede?Dialogue: 0,0:07:52.36,0:07:53.29,Main,Robin,0,0,0,,Dördüncü bölgede.Dialogue: 0,0:07:53.65,0:07:56.82,Main,Leo,0,0,0,,Sen savaşmayacak mısın Usoland?Dialogue: 0,0:07:57.53,0:07:59.69,Main,Usopp,0,0,0,,Benim için çocuk oyuncağı bu...Dialogue: 0,0:08:00.60,0:08:03.43,Thoughts,Usopp,0,0,0,,Hiçbir şey yapmamam daha iyi olur.Dialogue: 0,0:08:03.43,0:08:07.60,Main,Usopp,0,0,0,,...ama kendinize olan güveni arttırabilin diye geride kalacağım!Dialogue: 0,0:08:07.60,0:08:09.17,Main,Leo,0,0,0,,Kendimize olan güveni mi?Dialogue: 0,0:08:09.17,0:08:13.64,Main,Usopp,0,0,0,,Endişelenmeyin! İşler ters gidecek olursa hemen devreye gireceğim!Dialogue: 0,0:08:14.30,0:08:15.54,Main,Leo,0,0,0,,İçimizi rahatlattın!Dialogue: 0,0:08:18.28,0:08:19.34,Main,Sugar,0,0,0,,Sen de kimsin?Dialogue: 0,0:08:26.37,0:08:28.27,Main,Leo,0,0,0,,Karşı koymaya çalışma, Sugar!Dialogue: 0,0:08:28.82,0:08:33.09,Main,Leo,0,0,0,,Fabrikada köle gibi çalışan dostlarımızı kurtarmaya geldik!Dialogue: 0,0:08:33.96,0:08:37.06,Main,Leo,0,0,0,,Bir de seni bayıltacağız!Dialogue: 0,0:08:37.06,0:08:38.93,Main,Sugar,0,0,0,,Bayıltacak mısınız?Dialogue: 0,0:08:40.24,0:08:43.54,Main,Sugar,0,0,0,,Dostlarınızla ilgili bir şey bilmiyorum ki ben.Dialogue: 0,0:08:43.54,0:08:44.21,Main,Gnomes,0,0,0,,Ne?!Dialogue: 0,0:08:44.21,0:08:45.44,Main,Leo,0,0,0,,Sahi mi?Dialogue: 0,0:08:45.44,0:08:47.09,Main,Gnomes,0,0,0,,Yok artık!Dialogue: 0,0:08:47.09,0:08:47.76,Main,Sugar,0,0,0,,Evet.Dialogue: 0,0:08:47.76,0:08:48.91,Main,Leo,0,0,0,,İyi öyleyse!Dialogue: 0,0:08:48.91,0:08:50.98,Main,Usopp,0,0,0,,Neresi iyi be, kandırıyor sizi işte!Dialogue: 0,0:08:50.98,0:08:54.38,Main,Leo,0,0,0,,Az daha inanıyorduk! Dostlarımızı serbest bırak!Dialogue: 0,0:08:56.42,0:08:58.00,Main,Sugar,0,0,0,,Arkanızda kim var sizin?Dialogue: 0,0:08:58.03,0:09:02.40,Main,Sugar,0,0,0,,Siz ahmakların kandırıldığınızı bir başınıza anlamanıza imkan yok.Dialogue: 0,0:09:03.82,0:09:09.13,Main,Sugar,0,0,0,,Tontatta Kabilesi'nin geçtiğimiz bir yıl boyunca saraya ayak basmamasına bakılırsa...Dialogue: 0,0:09:11.03,0:09:14.03,Main,Sugar,0,0,0,,...birisi sizin gözünüzü açmış.Dialogue: 0,0:09:15.47,0:09:16.84,Main,Gnomes,0,0,0,,Saldırın!Dialogue: 0,0:09:16.84,0:09:19.00,Main,Gnomes,0,0,0,,Tutun kolunu bacağını, ağzını açtırın!Dialogue: 0,0:09:19.44,0:09:23.34,Main,Sugar,0,0,0,,Hiç hoşuma gitmedi bu. Beni güçsüz sanıyor bunlar.Dialogue: 0,0:09:32.70,0:09:34.69,Main,Sugar,0,0,0,,Küçük Siyah Ayıcıklar!Dialogue: 0,0:09:41.36,0:09:42.49,Main,Sugar,0,0,0,,Anlaşma şöyle...Dialogue: 0,0:09:43.37,0:09:45.30,Thoughts,Flapper,0,0,0,,Eyvah oyuncağa çevirdi bizi!Dialogue: 0,0:09:46.41,0:09:51.20,Main,Sugar,0,0,0,,Ölene dek emirlerime uyacaksınız!Dialogue: 0,0:09:51.20,0:09:54.41,Thoughts,Flapper,0,0,0,,Bizi unuttular mı şimdi?!Dialogue: 0,0:09:54.41,0:09:55.76,Main,Leo,0,0,0,,Amanın!Dialogue: 0,0:09:55.76,0:09:58.22,Main,Bomba,0,0,0,,Birden oyuncaklar belirdi!Dialogue: 0,0:09:58.22,0:10:00.40,Main,Cotton,0,0,0,,Ne yapıyorduk ki biz?Dialogue: 0,0:10:01.02,0:10:04.65,Main,Sugar,0,0,0,,Yönetim Kulesi'ndeki herkesi öldürün!Dialogue: 0,0:10:04.65,0:10:06.95,Thoughts,Flapper,0,0,0,,Emre karşı gelemiyorum!Dialogue: 0,0:10:06.95,0:10:10.16,Thoughts,Usopp,0,0,0,,Herkesi öldürün mü?! Ben de kuledeyim lan!Dialogue: 0,0:10:14.34,0:10:17.03,Thoughts,Gnome,0,0,0,,Yapma lütfen! Savaşmak istemiyorum!Dialogue: 0,0:10:17.03,0:10:19.86,Main,Bomba,0,0,0,,Sugar'ın adamları olmalılar!Dialogue: 0,0:10:19.86,0:10:23.50,Main,Cotton,0,0,0,,Trebol'dan başka da korumaları olduğunu bilmiyordum!Dialogue: 0,0:10:23.50,0:10:26.61,Main,Flapper,0,0,0,,Leo benim ben, Flapper!Dialogue: 0,0:10:26.61,0:10:29.07,Main,Leo,0,0,0,,Düşmanın işini bitirin!Dialogue: 0,0:10:32.04,0:10:34.90,Thoughts,Flapper,0,0,0,,Olamaz! Olamaz! Olamaz!Dialogue: 0,0:10:34.90,0:10:37.65,Thoughts,Flapper,0,0,0,,Olamaz!Dialogue: 0,0:10:38.92,0:10:42.22,Main,Sugar,0,0,0,,Trebol, geri dön çabuk! Tuzakmış!Dialogue: 0,0:10:43.08,0:10:45.00,Main,Sugar,0,0,0,,Trebol!Dialogue: 0,0:10:46.09,0:10:47.63,Main,Trébol,0,0,0,,Tuzak mı?Dialogue: 0,0:10:49.01,0:10:50.33,Main,Trébol,0,0,0,,Dur bakalım!Dialogue: 0,0:10:50.33,0:10:52.83,Main,Robin,0,0,0,,Şuna bakın Trebol-sama!Dialogue: 0,0:10:53.40,0:10:56.13,Main,Robin,0,0,0,,Korsanlar ortalığı birbirine katıyorlar, elimizden bir şey gelmiyor!Dialogue: 0,0:11:00.06,0:11:02.64,Main,Trébol,0,0,0,,Baksanıza bana biraz!Dialogue: 0,0:11:03.29,0:11:04.94,Main,Trébol,0,0,0,,Sorun nedir?Dialogue: 0,0:11:04.94,0:11:06.61,Main,Pirate,0,0,0,,Trébol-sama!Dialogue: 0,0:11:06.61,0:11:08.28,Main,Trébol,0,0,0,,Ne oluyor?Dialogue: 0,0:11:08.28,0:11:13.95,Main,Pirate,0,0,0,,Sorundan ziyade kargoda arı kümesi varmış da...Dialogue: 0,0:11:14.53,0:11:17.46,Main,Pirate,0,0,0,,Anlaşmayla ilgili bir sorun yok yani.Dialogue: 0,0:11:18.38,0:11:20.29,Main,Trébol,0,0,0,,Seni yosma!Dialogue: 0,0:11:25.30,0:11:27.86,Main,Trébol,0,0,0,,Dur biraz! Bekle bakalım!Dialogue: 0,0:11:27.86,0:11:29.37,Main,Trébol,0,0,0,,Lanet olası!Dialogue: 0,0:11:29.37,0:11:32.97,Main,Trébol,0,0,0,,Söyle bakalım kimsin, kimin nesisin, söyle!Dialogue: 0,0:11:36.62,0:11:42.05,Main,Trébol,0,0,0,,Kayboldu! Ama ya, ama ya!Dialogue: 0,0:11:42.62,0:11:45.04,Main,Trébol,0,0,0,,O yüz...Dialogue: 0,0:11:47.99,0:11:50.77,Main,Trébol,0,0,0,,Hasır Şapkalar'dan biri miydi o yoksa?!Dialogue: 0,0:11:50.77,0:11:52.41,Main,Trébol,0,0,0,,Buraya nasıl geldi peki?!Dialogue: 0,0:11:52.41,0:11:54.69,Main,Sugar,0,0,0,,Trebol!Dialogue: 0,0:11:54.69,0:11:56.60,Main,Sugar,0,0,0,,Neden Sugar'ın peşindeler?Dialogue: 0,0:11:56.60,0:11:59.66,Main,Sugar,0,0,0,,Geri dön çabuk, kandırdılar seni!Dialogue: 0,0:11:59.66,0:12:00.82,Main,Sugar,0,0,0,,Aptal, öl!Dialogue: 0,0:12:01.88,0:12:03.90,Main,Trébol,0,0,0,,Şimdi çok kızdım!Dialogue: 0,0:12:07.82,0:12:09.74,Main,Trébol,0,0,0,,Beta Beta Zincir!Dialogue: 0,0:12:16.41,0:12:18.13,Main,Trébol,0,0,0,,Beta Betta...Dialogue: 0,0:12:23.71,0:12:25.55,Main,Trébol,0,0,0,,Meteora!Dialogue: 0,0:12:40.33,0:12:43.38,Main,Pirate,0,0,0,,T-Trebol-sama delirdi!Dialogue: 0,0:12:47.50,0:12:49.95,Main,Pirate,0,0,0,,Yönetim Kulesi yerle bir oldu!Dialogue: 0,0:13:17.52,0:13:21.72,Main,Robin,0,0,0,,Usopp, Usopp, kendine gel!Dialogue: 0,0:13:26.12,0:13:27.35,Main,Robin,0,0,0,,Şükürler olsun!Dialogue: 0,0:13:27.35,0:13:28.86,Main,Usopp,0,0,0,,Rob-Dialogue: 0,0:13:30.78,0:13:32.36,Main,Usopp,0,0,0,,Ne oldu öyle?Dialogue: 0,0:13:32.36,0:13:33.79,Main,Usopp,0,0,0,,Tavandan koca bir ördek dalıverdi içeri...Dialogue: 0,0:13:34.30,0:13:36.13,Main,Robin,0,0,0,,Leo'lar yakalandılar!Dialogue: 0,0:13:37.03,0:13:39.45,Main,Trébol,0,0,0,,Size yardım eden başka biri daha var değil mi?Dialogue: 0,0:13:39.81,0:13:41.17,Main,Trébol,0,0,0,,Değil mi? Değil mi?Dialogue: 0,0:13:41.17,0:13:42.57,Main,Trébol,0,0,0,,Adı ne?Dialogue: 0,0:13:42.57,0:13:44.90,Main,Leo,0,0,0,,Asla söylemeyeceğim!Dialogue: 0,0:13:44.90,0:13:48.65,Main,Usopp,0,0,0,,Ha şöyle! Sakın söyleme!Dialogue: 0,0:13:48.65,0:13:50.84,Main,Usopp,0,0,0,,Fırsatımız varken kaçalım, Robin!Dialogue: 0,0:13:51.44,0:13:54.45,Main,Trébol,0,0,0,,O kişi benim arkadaşım ama...Dialogue: 0,0:13:55.89,0:13:58.15,Main,Trébol,0,0,0,,Adı şeydi sanırım...Dialogue: 0,0:13:58.15,0:13:59.72,Main,Leo,0,0,0,,Usoland'ı mı diyorsun?Dialogue: 0,0:13:59.72,0:14:01.65,Main,Usopp,0,0,0,,Lan!Dialogue: 0,0:14:01.65,0:14:05.83,Main,Trébol,0,0,0,,Aptal şey seni! Arkadaşım falan değil benim!Dialogue: 0,0:14:05.83,0:14:08.39,Main,Leo,0,0,0,,Olamaz! Oyuna geldim!Dialogue: 0,0:14:08.39,0:14:11.00,Main,Sugar,0,0,0,,Tek bacaklı asker de sizinle birlikte mi?Dialogue: 0,0:14:11.00,0:14:13.52,Main,Leo,0,0,0,,Söylemeyeceğim!Dialogue: 0,0:14:13.52,0:14:15.17,Main,Sugar,0,0,0,,Zaten bildiğim bir şeydi!Dialogue: 0,0:14:15.17,0:14:18.65,Main,Leo,0,0,0,,Madem biliyorsun elden bir şey gelmez o zaman, evet o da bizimle!Dialogue: 0,0:14:18.65,0:14:20.39,Main,Sugar,0,0,0,,Tahmin etmiştim!Dialogue: 0,0:14:20.39,0:14:21.47,Main,Leo,0,0,0,,Olamaz!Dialogue: 0,0:14:21.47,0:14:25.94,Main,Trébol,0,0,0,,İşin aslı ortaya çıkıyor yavaş yavaş!Dialogue: 0,0:14:27.45,0:14:30.95,Main,Leo,0,0,0,,Bunları bilmeniz bir şey değiştirmiyor! Her halükârda işiniz bitti!Dialogue: 0,0:14:32.67,0:14:35.93,Main,Leo,0,0,0,,Arkadaşlarımızı geri alacağız!Dialogue: 0,0:14:39.91,0:14:43.16,Main,Trébol,0,0,0,,O yapışkan şey epey yanıcıdır!Dialogue: 0,0:14:56.60,0:14:58.89,Main,Pirate,0,0,0,,Bu sefer ne oluyor?!Dialogue: 0,0:14:58.89,0:15:00.75,Main,Pirate,0,0,0,,Trebol-sama!Dialogue: 0,0:15:09.49,0:15:11.62,Main,Usopp,0,0,0,,Leo, Leo!Dialogue: 0,0:15:14.54,0:15:16.01,Main,Usopp,0,0,0,,Kaçmalı...Dialogue: 0,0:15:16.01,0:15:17.96,Main,Usopp,0,0,0,,Daha doğrusu, kaçalım!Dialogue: 0,0:15:18.57,0:15:22.67,Main,Usopp,0,0,0,,Elinizden bir şey gelmez artık, Trebol'u yenemezsiniz!Dialogue: 0,0:15:26.08,0:15:30.11,Main,Leo,0,0,0,,Kaçmak gibi bir seçeneğimiz yok!Dialogue: 0,0:15:32.34,0:15:35.69,Main,Leo,0,0,0,,SOP Operasyonu'nu derhal...Dialogue: 0,0:15:35.72,0:15:37.70,Main,Leo,0,0,0,,...başarıyla...Dialogue: 0,0:15:37.72,0:15:40.52,Main,Leo,0,0,0,,...sonuçlandırmalıyız.Dialogue: 0,0:15:40.52,0:15:45.99,Main,Leo,0,0,0,,O zaman eminim  komutan da Doflamingo'yu...Dialogue: 0,0:15:48.91,0:15:51.00,Main,Leo,0,0,0,,...yenecektir!Dialogue: 0,0:15:54.40,0:15:56.26,Main,Leo,0,0,0,,Komutan...Dialogue: 0,0:15:56.28,0:15:59.44,Main,Leo,0,0,0,,...bizi bekliyor!Dialogue: 0,0:16:01.28,0:16:03.01,Main,Leo,0,0,0,,Acele etmeliyiz!Dialogue: 0,0:16:10.52,0:16:13.65,Captions,,0,0,0,,Kraliyet Sarayı, 1. Kat (Asansör)Dialogue: 0,0:16:21.03,0:16:22.43,Main,,0,0,0,,Komutan!Dialogue: 0,0:16:29.58,0:16:32.60,Captions,,0,0,0,,Dressrosa Bu SabahDialogue: 0,0:16:29.91,0:16:32.60,Main,Citizen,0,0,0,,Doflamingo-sama Shichibukai'lıktan ayrılıyor muymuş?!Dialogue: 0,0:16:32.60,0:16:37.04,Main,Citizen,0,0,0,,Dressrosa tahtını bırakacak mıymış?!Dialogue: 0,0:16:42.35,0:16:46.00,Main,Prisoner,0,0,0,,Sıradan korsanın teki oldu artık!Dialogue: 0,0:16:46.00,0:16:48.96,Main,Prisoner,0,0,0,,Donanma onun da peşine düşecek!Dialogue: 0,0:16:48.96,0:16:50.92,Main,Prisoner,0,0,0,,Serbest kalacağız!Dialogue: 0,0:16:50.92,0:16:53.53,Main,Gnomes,0,0,0,,Komutan, gazeteyi gördün mü?!Dialogue: 0,0:16:53.53,0:16:56.26,Main,Inhel,0,0,0,,Dostlarımız geri gelecek demek değil mi bu?Dialogue: 0,0:16:56.26,0:16:58.78,Main,Leo,0,0,0,,Doflamingo'yla savaşmamıza gerek kalmadı!Dialogue: 0,0:16:58.78,0:16:59.41,Main,Leo,0,0,0,,Şükürler ols-Dialogue: 0,0:17:01.60,0:17:04.80,Main,Thunder Soldier,0,0,0,,Hayır, sahte haberdi o.Dialogue: 0,0:17:06.54,0:17:08.64,Main,Leo,0,0,0,,Nasıl olur!?Dialogue: 0,0:17:11.68,0:17:13.38,Main,Citizen,0,0,0,,Yanlış habermiş, içim rahatladı!Dialogue: 0,0:17:14.08,0:17:18.57,Main,Citizen,0,0,0,,Onun gibi mükemmel birinin tahttan çekilmesine imkan yoktu zaten!Dialogue: 0,0:17:18.57,0:17:20.19,Main,Citizen,0,0,0,,Doflamingo-sama!Dialogue: 0,0:17:20.19,0:17:23.82,Main,Rebecca,0,0,0,,Bugünkü yarışmaya katılıp Mera Mera Meyvesi'ni kazanacak...Dialogue: 0,0:17:23.82,0:17:27.13,Main,Rebecca,0,0,0,,...sonra da Doflamingo'yu yeneceğim!Dialogue: 0,0:17:27.13,0:17:29.89,Main,Thunder Soldier,0,0,0,,Rebecca, kendine gel!Dialogue: 0,0:17:31.43,0:17:33.13,Main,Thunder Soldier,0,0,0,,Öfkeli olmanı anlayabiliyorum!Dialogue: 0,0:17:33.13,0:17:35.05,Main,Thunder Soldier,0,0,0,,Ben de kızgınım...Dialogue: 0,0:17:35.05,0:17:37.04,Main,Thunder Soldier,0,0,0,,...ama fevri kararlar alma!Dialogue: 0,0:17:37.04,0:17:40.81,Main,Thunder Soldier,0,0,0,,Harekete geçecek taraf biziz, her şey hazır artık!Dialogue: 0,0:17:41.45,0:17:43.68,Main,Rebecca,0,0,0,,Hayır! Daha fazla beklemeyeceğim!Dialogue: 0,0:17:44.61,0:17:47.51,Main,Rebecca,0,0,0,,Hiç kimsede bir damla umuttan eser kalmadı.Dialogue: 0,0:17:47.51,0:17:50.78,Main,Rebecca,0,0,0,,Buradaki insanların dayanacak güçleri yok artık, ruhen tükenmek üzereler!Dialogue: 0,0:17:54.99,0:17:59.18,Flashbacks,Prisoner,0,0,0,,Artık idam edileceğimiz günü beklemek kalıyor.Dialogue: 0,0:18:01.33,0:18:05.17,Main,Rebecca,0,0,0,,Bin mücadele kazanırsak serbest kalacakmışmışız.Dialogue: 0,0:18:05.17,0:18:07.33,Main,Rebecca,0,0,0,,Böyle umut mu olur be?!Dialogue: 0,0:18:07.33,0:18:08.72,Main,Rebecca,0,0,0,,Çaresizliğin diğer adı!Dialogue: 0,0:18:09.21,0:18:13.16,Main,Rebecca,0,0,0,,Sözde Kyros 3000 mücadelenin hepsini de kazanmış!Dialogue: 0,0:18:13.16,0:18:16.64,Main,Rebecca,0,0,0,,O heykelin uydurma olduğunu herkes biliyor be!Dialogue: 0,0:18:16.64,0:18:20.98,Main,Rebecca,0,0,0,,Ölmek üzere olan mahkumların uydurduğu ideal savaşçı Kyros...Dialogue: 0,0:18:21.57,0:18:25.68,Main,Rebecca,0,0,0,,Kendilerini yerine koyup özgür kaldıklarını hayal ettikleri bir arzunun ürünü!Dialogue: 0,0:18:27.65,0:18:29.98,Main,Rebecca,0,0,0,,Böyle imkansız hayaller kurmaktansa...Dialogue: 0,0:18:29.98,0:18:35.29,Main,Rebecca,0,0,0,,...şansımı bugünkü yarışmada denerim daha iyi! O yüzden de katılacağım!Dialogue: 0,0:18:35.29,0:18:36.69,Main,Thunder Soldier,0,0,0,,Ne şansından bahsediyorsun sen?!Dialogue: 0,0:18:37.15,0:18:40.10,Main,Thunder Soldier,0,0,0,,Katılıp da kazanabileceğin bir yarışma değil o!Dialogue: 0,0:18:40.10,0:18:43.71,Main,Thunder Soldier,0,0,0,,Öleceksin be! Katılmanı yasaklıyorum!Dialogue: 0,0:18:43.71,0:18:45.37,Main,Thunder Soldier,0,0,0,,Düzgün düşünemiyorsun!Dialogue: 0,0:18:45.37,0:18:47.44,Main,Thunder Soldier,0,0,0,,16 yaşına girdin diye...Dialogue: 0,0:18:47.44,0:18:50.46,Main,Thunder Soldier,0,0,0,,...kendini yetişkin biri olarak mı görmeye başladın, Rebecca?!Dialogue: 0,0:18:50.46,0:18:52.80,Main,Thunder Soldier,0,0,0,,Çocuksun hâlâ!Dialogue: 0,0:18:52.80,0:18:54.38,Main,Thunder Soldier,0,0,0,,Ne dersem onu yapacaksın!Dialogue: 0,0:18:57.15,0:19:00.18,Main,Rebecca,0,0,0,,Oh daha neler! Ne anamsın ne babam!Dialogue: 0,0:19:01.05,0:19:04.07,Main,Rebecca,0,0,0,,Burada düzgün düşünemeyen kişi sensin asıl!Dialogue: 0,0:19:04.07,0:19:05.62,Main,Rebecca,0,0,0,,Yok planmış da...Dialogue: 0,0:19:05.62,0:19:08.58,Main,Rebecca,0,0,0,,Doflamingo'yu yenmene imkan yok senin!Dialogue: 0,0:19:08.58,0:19:13.06,Main,Rebecca,0,0,0,,Baksana kendine! Tek bacaklı oyuncağın tekisin be!Dialogue: 0,0:19:17.24,0:19:18.56,Main,Thunder Soldier,0,0,0,,Evet...Dialogue: 0,0:19:19.81,0:19:21.56,Main,Thunder Soldier,0,0,0,,Çok haklısın!Dialogue: 0,0:19:23.41,0:19:24.61,Main,Rebecca,0,0,0,,Öyle demek istemedim!Dialogue: 0,0:19:25.79,0:19:28.14,Main,Thunder Soldier,0,0,0,,Rahatsız ettiysem kusura bakma...Dialogue: 0,0:19:28.14,0:19:31.28,Main,Thunder Soldier,0,0,0,,...ama yine de umarım  yarışmaya katılmaktan vazgeçersin.Dialogue: 0,0:19:31.28,0:19:35.48,Main,Rebecca,0,0,0,,Öyle demek istemedim Asker-san!Dialogue: 0,0:19:35.48,0:19:38.92,Main,Rebecca,0,0,0,,Bekle lütfen Asker-san!Dialogue: 0,0:19:38.92,0:19:43.95,Main,Rebecca,0,0,0,,Kendi canından olacaksın diye korktuğum için öyle dedim!Dialogue: 0,0:19:43.95,0:19:46.01,Main,Rebecca,0,0,0,,Özür dilerim!Dialogue: 0,0:19:46.01,0:19:48.38,Main,Rebecca,0,0,0,,Gitme, Asker-san!Dialogue: 0,0:19:48.38,0:19:52.41,Main,Rebecca,0,0,0,,Asker-san!Dialogue: 0,0:20:07.12,0:20:08.45,Main,Announcer,0,0,0,,Amanın!Dialogue: 0,0:20:10.92,0:20:16.09,Main,Announcer,0,0,0,,Daha önce hiçbir saldırıda bulunmayan Rebecca sessizliğini bozdu!Dialogue: 0,0:20:16.58,0:20:18.96,Main,Diamante,0,0,0,,O kılıç da ne öyle?Dialogue: 0,0:20:19.53,0:20:22.50,Main,Diamante,0,0,0,,Bildiğin normal bir kılıç.Dialogue: 0,0:20:22.50,0:20:25.07,Main,Diamante,0,0,0,,Ring insanların öldürüldüğü yerdir.Dialogue: 0,0:20:25.47,0:20:28.91,Main,Diamante,0,0,0,,Kimseyi kesemiyorsan bil ki senin kanın akacak!Dialogue: 0,0:20:29.27,0:20:32.57,Main,Diamante,0,0,0,,İnsanların görmek istedikleri şey bu!Dialogue: 0,0:20:32.57,0:20:33.59,Main,Diamante,0,0,0,,Kilit!Dialogue: 0,0:20:45.13,0:20:47.19,Main,Announcer,0,0,0,,Doğrudan bir darbe!Dialogue: 0,0:20:47.60,0:20:51.10,Main,Announcer,0,0,0,,Yenilmez kadın kılını dahi kıpırdatamadı!Dialogue: 0,0:20:51.60,0:20:53.97,Main,Audience,0,0,0,,Diamante!Dialogue: 0,0:20:54.71,0:20:55.40,Main,Sabo,0,0,0,,Lanet olsun!Dialogue: 0,0:20:55.40,0:20:57.71,Main,Sabo,0,0,0,,Bak az Musclemelon!Dialogue: 0,0:20:57.71,0:20:59.52,Main,Bartolomeo,0,0,0,,Bartolomeo adım...Dialogue: 0,0:20:59.52,0:21:01.04,Main,Sabo,0,0,0,,O kızı koru!Dialogue: 0,0:21:02.91,0:21:09.05,Main,Diamante,0,0,0,,Rebecca, annen Scarlet'in nasıl öldüğünü biliyor musun?Dialogue: 0,0:21:11.92,0:21:15.22,Flashbacks,Scarlett,0,0,0,,Yiyecek bir şeyler alacağım.Dialogue: 0,0:21:17.25,0:21:22.66,Main,Diamante,0,0,0,,Oyuncak Asker bebek gibi ağlamıştı. Rezillik resmen.Dialogue: 0,0:21:24.48,0:21:26.35,Flashbacks,Thunder Soldier,0,0,0,,Özür dilerim.Dialogue: 0,0:21:26.35,0:21:30.44,Flashbacks,Thunder Soldier,0,0,0,,Anneni koruyamadım!Dialogue: 0,0:21:33.84,0:21:36.64,Captions,,0,0,0,,Kraliyet Sarayı 1. Kat Asansörün ÖnüDialogue: 0,0:21:39.20,0:21:40.74,Main,Lao G,0,0,0,,Bu sarsıntı...Dialogue: 0,0:21:42.24,0:21:44.39,Main,Lao G,0,0,0,,Pica'nın işi olsa gerek!Dialogue: 0,0:21:44.39,0:21:46.18,Main,Lao G,0,0,0,,Ne diye bu kadar azıttı acaba?Dialogue: 0,0:21:50.16,0:21:51.41,Main,Gnome,0,0,0,,Peşinden gitmene müsaade etmeyiz!Dialogue: 0,0:21:51.99,0:21:53.78,Main,Kabu,0,0,0,,İyi misin, Komutan?Dialogue: 0,0:21:53.78,0:21:55.29,Main,Thunder Soldier,0,0,0,,Teşekkür ederim!Dialogue: 0,0:21:55.29,0:21:56.56,Main,Kabu,0,0,0,,Gidelim!Dialogue: 0,0:21:56.56,0:21:59.10,Main,Thunder Soldier,0,0,0,,Durun! Onların hiçbir şansı yok!Dialogue: 0,0:21:59.10,0:22:02.20,Main,Lao G,0,0,0,,Bırakın beni be küçük serseriler sizi!Dialogue: 0,0:22:02.20,0:22:05.15,Main,Kabu,0,0,0,,Ardına bakmaktan vazgeç, Komutan!Dialogue: 0,0:22:06.39,0:22:09.28,Main,Kabu,0,0,0,,Biz bunun için buradayız!Dialogue: 0,0:22:09.28,0:22:10.37,Main,Thunder Soldier,0,0,0,,Saçmalamayın!Dialogue: 0,0:22:10.37,0:22:12.68,Main,Kabu,0,0,0,,Burada kalırsan eline ne geçecek?!Dialogue: 0,0:22:14.72,0:22:18.66,Main,Kabu,0,0,0,,Leo'lar SOP Operasyonu'nu başarıyla tamamlasalar dahi...Dialogue: 0,0:22:18.68,0:22:23.55,Main,Kabu,0,0,0,,...Doflamingo'yu elimizden kaçırırsak yine her şeyi eski haline çevirir!Dialogue: 0,0:22:23.55,0:22:28.49,Main,Rampo,0,0,0,,Doflamingo'yu yenebilecek bir tek sen varsın, Komutan!Dialogue: 0,0:22:28.50,0:22:34.87,Captions,,0,0,0,,Yer Altı Ticaret Limanı Yönetim KulesiDialogue: 0,0:22:28.99,0:22:31.76,Main,Usopp,0,0,0,,Komutanına neden bu kadar önem veriyorsun Leo?Dialogue: 0,0:22:31.76,0:22:34.87,Main,Usopp,0,0,0,,Neden ona bu kadar çok güveniyorsunuz?Dialogue: 0,0:22:37.00,0:22:40.07,Main,Usopp,0,0,0,,Tek bacaklı oyuncağın teki o be!Dialogue: 0,0:22:40.47,0:22:45.66,Main,Leo,0,0,0,,Normalde oyuncağa dönüştürülenler anlaşmayla bağlanırlar...Dialogue: 0,0:22:45.69,0:22:50.88,Main,Leo,0,0,0,,...ve asla emirlere karşı gelemeyen çalışanlar olup çıkarlar.Dialogue: 0,0:22:51.41,0:22:56.41,Main,Leo,0,0,0,,Komutan bu ülkede oyuncağa dönüştürülen ilk kişiydi...Dialogue: 0,0:22:56.41,0:23:04.18,Main,Leo,0,0,0,,...fakat Sugar onunla anlaşma yapmayı unutmak gibi bir hataya düştü.Dialogue: 0,0:23:04.18,0:23:09.98,Main,Leo,0,0,0,,On yıl önce yapılan o tek hatanın ürünü olan Komutan...Dialogue: 0,0:23:10.00,0:23:17.20,Main,Leo,0,0,0,,...bu ülkede Don Quixote Ailesi'ne karşı gelebilecek tek oyuncaktır.Dialogue: 0,0:23:19.58,0:23:27.42,Main,Leo,0,0,0,,O yüzden de Komutan on yıldır  tek başına bir savaş vermekteydi.Dialogue: 0,0:23:27.42,0:23:35.09,Main,Leo,0,0,0,,O olmasaydı oyuncakların kaderlerini kabullenmekten başka seçenekleri kalmayacaktı.Dialogue: 0,0:23:35.88,0:23:40.06,Main,Leo,0,0,0,,Tontatta Kabilesi olarak habersiz biçimde...Dialogue: 0,0:23:40.06,0:23:45.84,Main,Leo,0,0,0,,...onların köleleri olarak hayatlarımızı sürdürecektik.Dialogue: 0,0:23:50.76,0:23:57.28,Main,Leo,0,0,0,,Eğer onun birlik çağrısını görmezden gelecek olursak bu ülkeyi bir daha hiçbir şekilde kurtaramayız!Dialogue: 0,0:24:02.14,0:24:06.19,Main,Leo,0,0,0,,Tüm umutları bağlamaya değer biri o!Dialogue: 0,0:24:09.88,0:24:13.11,Main,Leo,0,0,0,,Onu artık kimse hatırlamıyor belki...Dialogue: 0,0:24:13.11,0:24:16.62,Main,Leo,0,0,0,,...fakat bir zamanlar herkesin bildiği biriydi!Dialogue: 0,0:24:16.62,0:24:20.30,Main,Leo,0,0,0,,Büyük İnsanken onun adı...Dialogue: 0,0:24:20.30,0:24:22.51,Main,Leo,0,0,0,,...Kyros'tu!Dialogue: 0,0:24:23.17,0:24:27.52,Main,Leo,0,0,0,,Kolezyum tarihinin en güçlü savaşçısı!Dialogue: 0,0:24:29.18,0:24:33.55,Main,Leo,0,0,0,,Komutanımız o işte!