8,23,23,23,1Style: Lyrics-furigana,Duality,36,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,2.95,0,2,23,23,34,1Style: Lyrics,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,2,23,23,34,1Style: Karaoke,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,23,1Style: Kanji,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,146,1Style: Roger-Monologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1Style: Romaji ED,Josefin Sans,82,&H00FFFFFF,&H003592BE,&H00000000,&H64000000,0,0,0,0,100,100,0,0,1,0,4,8,10,10,20,1Style: Translation ED,Josefin Sans,82,&H00FFFFFF,&H000000FF,&H00FFFFFF,&H64000000,0,0,0,0,100,100,0,0,1,0,4,2,10,10,20,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:49.96,0:01:59.95,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 50,0:02:12.63,0:02:13.99,Main-207-,,0,0,0,,O-Onu yendi...Dialogue: 50,0:02:14.66,0:02:16.87,Main-207-,,0,0,0,,K-Kaptan Kuro'yu yendi.Dialogue: 50,0:02:17.53,0:02:21.08,Main-207-,,0,0,0,,Denizciler bile "Bin Planlı Kuro"ya bir şey yapamadı.Dialogue: 50,0:02:21.08,0:02:22.71,Main-207-,,0,0,0,,Ama o başardı!Dialogue: 50,0:02:22.71,0:02:24.92,Main-207-,,0,0,0,,Sen de kimsin?!Dialogue: 50,0:02:25.25,0:02:27.09,Main-207-,,0,0,0,,Monkey D. Luffy.Dialogue: 50,0:02:27.54,0:02:33.13,Main-207-,,0,0,0,,Adını silip denizden kaçan bir korsana asla yenilmem.Dialogue: 50,0:02:33.13,0:02:37.10,Main-207-,,0,0,0,,Gerçek bir korsan,  öleceği güne dek adını terketmez.Dialogue: 50,0:02:37.55,0:02:40.93,Main-207-,,0,0,0,,Luffy mi? Hiç duymadım...Dialogue: 50,0:02:40.93,0:02:44.44,Main-207-,,0,0,0,,Hayatın boyunca adımı unutma!Dialogue: 50,0:02:44.44,0:02:47.15,Main-207-,,0,0,0,,Ben, Korsanlar Kralı olacağım!Dialogue: 50,0:02:49.40,0:02:50.59,Main-207-,,0,0,0,,O herif...Dialogue: 50,0:02:52.53,0:02:55.45,Main-207-,,0,0,0,,Alın şunu da defolun!Dialogue: 50,0:02:57.07,0:02:59.20,Main-207-,,0,0,0,,Bir daha sakın gelmeyin!Dialogue: 50,0:03:01.29,0:03:03.41,Main-207-,,0,0,0,,Kaçın!Dialogue: 50,0:03:10.13,0:03:12.26,Main-207-,,0,0,0,,İyi iş çıkardın.Dialogue: 50,0:03:12.26,0:03:15.22,Main-207-,,0,0,0,,Demir alın! Çabuk!Dialogue: 50,0:03:15.55,0:03:19.80,Main-207-,,0,0,0,,Bunca şeyden sonra senin de bitkin düşmen normal sanırım.Dialogue: 50,0:03:19.80,0:03:20.64,Main-207-,,0,0,0,,Söyle...Dialogue: 50,0:03:22.06,0:03:23.89,Main-207-,,0,0,0,,Az önce neye sinirlendin?Dialogue: 50,0:03:24.23,0:03:26.48,Main-207-,,0,0,0,,Onlardan hoşlanmıyorum.Dialogue: 50,0:03:26.48,0:03:28.35,Main-207-,,0,0,0,,Yanılıyorlar.Dialogue: 50,0:03:29.56,0:03:32.23,Main-207-,,0,0,0,,Arkadaşlara o gözle bakılmamalı.Dialogue: 50,0:03:32.57,0:03:34.40,Main-207-,,0,0,0,,Neden bahsediyorsun?Dialogue: 50,0:03:34.40,0:03:35.99,Main-207-,,0,0,0,,Hep böyledir işte.Dialogue: 50,0:03:35.99,0:03:40.03,Main-207-,,0,0,0,,Korsanlar, düşündüğün kadar asil değiller.Dialogue: 50,0:03:40.41,0:03:41.78,Main-207-,,0,0,0,,Et istiyorum.Dialogue: 50,0:03:41.78,0:03:44.50,Main-207-,,0,0,0,,İnanılmazsın!Dialogue: 50,0:03:51.54,0:03:55.51,Main-207-,,0,0,0,,Olan biten her şeyi gizli tutabilir misiniz?Dialogue: 50,0:03:55.51,0:03:57.18,Main-207-,,0,0,0,,Ne?! Gizli mi?!Dialogue: 50,0:03:57.18,0:03:59.09,Main-207-,,0,0,0,,Niye böyle bir şey yapalım?!Dialogue: 50,0:03:59.09,0:04:03.10,Main-207-,,0,0,0,,Evet! Köyü korumak için hayatımız pahasına savaştık.Dialogue: 50,0:04:03.10,0:04:05.98,Main-207-,,0,0,0,,Bu, insanların sana bakış açısını değiştirecek!Dialogue: 50,0:04:05.98,0:04:08.48,Main-207-,,0,0,0,,Köyümüzün kahramanı olacaksın!Dialogue: 50,0:04:08.48,0:04:10.35,Main-207-,,0,0,0,,– Evet! – Evet!Dialogue: 50,0:04:10.35,0:04:13.57,Main-207-,,0,0,0,,Usopp-san, herkesle tüm bu yanlış anlaşılmaları düzeltmelisin.Dialogue: 50,0:04:14.69,0:04:15.99,Main-207-,,0,0,0,,Ne yanlış anlaması?Dialogue: 50,0:04:15.99,0:04:19.49,Main-207-,,0,0,0,,Sadece her zamanki gibi yalan söylediğimi düşünecekler.Dialogue: 50,0:04:20.49,0:04:25.12,Main-207-,,0,0,0,,Her şey bitmişken neden herkesi korkutalım?Dialogue: 50,0:04:27.08,0:04:29.58,Main-207-,,0,0,0,,Bu, tek seferlik bir şeydi.Dialogue: 50,0:04:29.58,0:04:34.42,Main-207-,,0,0,0,,Hiçbir korsan, böyle ücra bir köye bir daha saldırmaz.Dialogue: 50,0:04:35.55,0:04:38.63,Main-207-,,0,0,0,,Hiçbir şey olmamış gibi davranacağım.Dialogue: 50,0:04:39.13,0:04:42.68,Main-207-,,0,0,0,,Hepsi bir yalandı.Dialogue: 50,0:04:46.43,0:04:47.89,Main-207-,,0,0,0,,Sizi zorlamayacağım, ama...Dialogue: 50,0:04:47.89,0:04:49.48,Main-207-,,0,0,0,,Hayır, bunu yapabiliriz!Dialogue: 50,0:04:49.48,0:04:52.15,Main-207-,,0,0,0,,Köyün iyiliği içinse...!Dialogue: 50,0:04:52.15,0:04:52.90,Main-207-,,0,0,0,,Katılıyorum!Dialogue: 50,0:04:52.90,0:04:55.61,Main-207-,,0,0,0,,Ben de! Tek kelime etmeyeceğim, asla!Dialogue: 50,0:04:56.86,0:04:58.32,Main-207-,,0,0,0,,Kaya...Dialogue: 50,0:04:58.86,0:05:00.78,Main-207-,,0,0,0,,Sen şeytana uyacak mısın?Dialogue: 50,0:05:04.99,0:05:05.99,Main-207-,,0,0,0,,Hayır.Dialogue: 50,0:05:09.25,0:05:12.96,Main-207-,,0,0,0,,Usopp-kun niye bu sabah ortalıkta yok?Dialogue: 50,0:05:13.58,0:05:17.46,Main-207-,,0,0,0,,Bir şeyler doğru hissettirmiyor. Motive olamıyorum.Dialogue: 50,0:05:18.09,0:05:20.05,Main-207-,,0,0,0,,Anneciğim...Dialogue: 50,0:05:20.05,0:05:23.26,Main-207-,,0,0,0,,Bay Yalancı bugün gelmeyecek mi?Dialogue: 50,0:05:23.68,0:05:25.64,Main-207-,,0,0,0,,Seni küçük yalancı...Dialogue: 50,0:05:25.97,0:05:27.89,Main-207-,,0,0,0,,neden geciktin?!Dialogue: 50,0:05:28.60,0:05:31.85,Main-207-,,0,0,0,,Acaba dün biraz fazla mı sert davrandım?Dialogue: 50,0:05:31.85,0:05:35.11,Main-207-,,0,0,0,,Yarın eski hâline dönecektir.Dialogue: 50,0:05:35.48,0:05:36.73,Main-207-,,0,0,0,,Eminim...Dialogue: 50,0:05:41.53,0:05:42.70,Main-207-,,0,0,0,,Teşekkürler.Dialogue: 50,0:05:42.70,0:05:46.03,Main-207-,,0,0,0,,Siz olmadan bu köyü koruyamazdım!Dialogue: 50,0:05:46.58,0:05:48.58,Main-207-,,0,0,0,,Ne saçmalıyorsun sen?Dialogue: 50,0:05:48.58,0:05:51.87,Main-207-,,0,0,0,,Eğer hayatını riske atmasaydın, ben hiçbir şey yapmazdım!Dialogue: 50,0:05:52.33,0:05:53.75,Main-207-,,0,0,0,,Ben de!Dialogue: 50,0:05:53.75,0:05:57.00,Main-207-,,0,0,0,,Kimin umurunda?Dialogue: 50,0:05:57.00,0:05:59.21,Main-207-,,0,0,0,,Biraz hazine buldum!Dialogue: 50,0:06:03.97,0:06:06.18,Main-207-,,0,0,0,,Bu olay sayesinde,Dialogue: 50,0:06:06.18,0:06:08.31,Main-207-,,0,0,0,,bir karara vardım.Dialogue: 50,0:06:15.10,0:06:18.73,Main-207-,,0,0,0,,Kaptan Usopp! Bizimle ne konuşmak istemiştiniz?Dialogue: 50,0:06:18.73,0:06:24.11,Main-207-,,0,0,0,,Sizler, o Kara Kedi Korsanlarıyla iyi savaştınız!Dialogue: 50,0:06:24.11,0:06:27.70,Main-207-,,0,0,0,,Kaptanınız olarak, sizinle gurur duyuyorum!Dialogue: 50,0:06:28.91,0:06:32.79,Main-207-,,0,0,0,,Kuruluşumuzdan beri en büyük ve en zor savaşımızı kazandık.Dialogue: 50,0:06:32.79,0:06:37.42,Main-207-,,0,0,0,,Beş yıl önce siz dört yaşındayken, Usopp Korsanları şekillendi.Dialogue: 50,0:06:37.42,0:06:38.29,Main-207-,,0,0,0,,– Evet! – Evet!Dialogue: 50,0:06:38.29,0:06:39.75,Main-207-,,0,0,0,,Biliyorum, bu ani oldu...Dialogue: 50,0:06:40.84,0:06:43.67,Main-207-,,0,0,0,,ama tek başıma denize açılmaya karar verdim!Dialogue: 50,0:06:46.34,0:06:49.22,Main-207-,,0,0,0,,Gerçek bir korsan olmak istiyorum!Dialogue: 50,0:06:54.56,0:06:58.86,Main-207-,,0,0,0,,Burada kalıp kalmamam konusunda hep kararsızdım...Dialogue: 50,0:06:58.86,0:07:02.57,Main-207-,,0,0,0,,Ama... Onlarla tanıştıktan sonra, kararımı verdim!Dialogue: 50,0:07:02.57,0:07:07.03,Main-207-,,0,0,0,,Bir erkek olarak, şu engin denizi kucaklamalıyım!Dialogue: 50,0:07:07.03,0:07:07.91,Main-207-,,0,0,0,,Bu yüzden...Dialogue: 50,0:07:07.91,0:07:09.99,Main-207-,,0,0,0,,Bu köyden ayrılıyorum!Dialogue: 50,0:07:12.75,0:07:19.42,Main-207-,,0,0,0,,Korsan bayrağı beni çağırıyor! Başka ne sebep istersin ki?!Dialogue: 50,0:07:21.96,0:07:24.17,Main-207-,,0,0,0,,Kaptan! Yalan söylüyorsun, değil mi?!Dialogue: 50,0:07:25.80,0:07:27.93,Main-207-,,0,0,0,,Başka bir yalan daha, değil mi?!Dialogue: 50,0:07:27.93,0:07:29.93,Main-207-,,0,0,0,,Bu çok ani oldu!Dialogue: 50,0:07:29.93,0:07:32.81,Main-207-,,0,0,0,,Bu köyü sevmiyor musun, Kaptan?Dialogue: 50,0:07:32.81,0:07:35.69,Main-207-,,0,0,0,,Usopp Korsanları'na ne olacak?!Dialogue: 50,0:07:37.85,0:07:40.48,Main-207-,,0,0,0,,Benim için bir şey yapmanızı istiyorum.Dialogue: 50,0:07:40.98,0:07:43.99,Main-207-,,0,0,0,,Köylülere söylemeden ayrılmayı planlıyorum.Dialogue: 50,0:07:43.99,0:07:45.99,Main-207-,,0,0,0,,Onlara selamlarımı iletin.Dialogue: 50,0:07:45.99,0:07:47.24,Main-207-,,0,0,0,,Olmaz...Dialogue: 50,0:07:47.24,0:07:49.12,Main-207-,,0,0,0,,İstemiyorum!Dialogue: 50,0:07:49.12,0:07:50.99,Main-207-,,0,0,0,,Gitme, Kaptan!Dialogue: 50,0:07:52.95,0:07:55.96,Main-207-,,0,0,0,,Burayı hatırlıyor musunuz?Dialogue: 50,0:07:57.00,0:08:00.58,Main-207-,,0,0,0,,İlk burada tanışmıştık.Dialogue: 50,0:08:08.13,0:08:09.18,Flashbacks-207-,,0,0,0,,Tamamdır!Dialogue: 50,0:08:09.18,0:08:10.89,Flashbacks-207-,,0,0,0,,Bay Yalancı!Dialogue: 50,0:08:11.93,0:08:14.60,Flashbacks-207-,,0,0,0,,Siz kimsiniz?! Bana, dostmuşuz gibi davranmayın!Dialogue: 50,0:08:14.60,0:08:16.39,Flashbacks-207-,,0,0,0,,Çünkü sen ünlüsün!Dialogue: 50,0:08:16.39,0:08:18.31,Flashbacks-207-,,0,0,0,,Evet, sen ünlü birisin.Dialogue: 50,0:08:19.15,0:08:20.23,Flashbacks-207-,,0,0,0,,Anlıyorum!Dialogue: 50,0:08:20.23,0:08:24.53,Flashbacks-207-,,0,0,0,,Demek, herkes bana Kaptan Usopp diyerek saygı duyuyor!Dialogue: 50,0:08:25.19,0:08:27.86,Flashbacks-207-,,0,0,0,,Herkes ona Yalancı Usopp diyor!Dialogue: 50,0:08:29.91,0:08:33.53,Flashbacks-207-,,0,0,0,,Tamam! Bugünden itibaren siz de Usopp Korsanları'nın birer parçasısınız!Dialogue: 50,0:08:33.91,0:08:37.00,Flashbacks-207-,,0,0,0,,— Ne? — Ne?Dialogue: 50,0:08:34.95,0:08:37.00,Flashbacks-207-,,0,0,0,,Bana "ne" çekmeyin!Dialogue: 50,0:08:39.00,0:08:40.96,Main-207-,,0,0,0,,Çok şey yaşadık, ha?Dialogue: 50,0:08:41.96,0:08:43.21,Flashbacks-207-,,0,0,0,,Bu, Kerberus!Dialogue: 50,0:08:43.21,0:08:44.88,Flashbacks-207-,,0,0,0,,Korkutup kaçırın!Dialogue: 50,0:08:45.80,0:08:47.34,Flashbacks-207-,,0,0,0,,Bir ejderha!Dialogue: 50,0:08:47.34,0:08:49.88,Flashbacks-207-,,0,0,0,,Hadi yakalayalım!Dialogue: 50,0:08:49.88,0:08:51.18,Flashbacks-207-,,0,0,0,,Un Yıldızı!Dialogue: 50,0:08:51.97,0:08:53.93,Flashbacks-207-,,0,0,0,,Harikasınız, Kaptan!Dialogue: 50,0:08:54.26,0:08:55.89,Flashbacks-207-,,0,0,0,,Elbette öyleyim!Dialogue: 50,0:08:55.89,0:08:58.68,Flashbacks-207-,,0,0,0,,Sonuçta denizin cesur savaşçısıyım!Dialogue: 50,0:08:59.56,0:09:02.86,Main-207-,,0,0,0,,Geçmişten bahsedişini duymak istemiyoruz!Dialogue: 50,0:09:02.86,0:09:04.98,Main-207-,,0,0,0,,Evet! Bunu duymak istemiyoruz!Dialogue: 50,0:09:04.98,0:09:06.98,Main-207-,,0,0,0,,Kendin gibi davranmıyorsun, Kaptan!Dialogue: 50,0:09:06.98,0:09:10.07,Main-207-,,0,0,0,,Neden şimdi bunları söylüyorsun?!Dialogue: 50,0:09:10.40,0:09:13.03,Main-207-,,0,0,0,,Bu... sanki...Dialogue: 50,0:09:13.57,0:09:15.66,Main-207-,,0,0,0,,"Aptal Kaptan" gibi!Dialogue: 50,0:09:15.66,0:09:17.66,Main-207-,,0,0,0,,Aptal!Dialogue: 50,0:09:25.67,0:09:27.34,Main-207-,,0,0,0,,Hayattaki hedefleriniz ne?!Dialogue: 50,0:09:27.84,0:09:30.47,Main-207-,,0,0,0,,Bar işletmek!Dialogue: 50,0:09:30.47,0:09:33.22,Main-207-,,0,0,0,,Usta bir marangoz olmak!Dialogue: 50,0:09:33.22,0:09:35.39,Main-207-,,0,0,0,,Roman yazarı olmak!Dialogue: 50,0:09:36.39,0:09:39.73,Main-207-,,0,0,0,,Hayallerinizin ateşinin sönmesine asla izin vermeyin!Dialogue: 50,0:09:40.39,0:09:45.31,Main-207-,,0,0,0,,Azimle kendi yolunuzda yürüyeceğinize yemin etmelisiniz!Dialogue: 50,0:09:46.48,0:09:47.98,Main-207-,,0,0,0,,Bugünden itibaren...Dialogue: 50,0:09:48.98,0:09:52.74,Main-207-,,0,0,0,,Usopp Korsanları...Dialogue: 50,0:09:58.12,0:09:59.75,Main-207-,,0,0,0,,dağılmıştır!Dialogue: 50,0:10:07.55,0:10:10.30,Main-207-,,0,0,0,,Yemeğimizi yedik. Sanırım gitme vakti.Dialogue: 50,0:10:10.30,0:10:11.22,Main-207-,,0,0,0,,Evet...Dialogue: 50,0:10:13.01,0:10:14.51,Main-207-,,0,0,0,,İşte buradasınız!Dialogue: 50,0:10:14.51,0:10:15.89,Main-207-,,0,0,0,,Selam, hanımefendi!Dialogue: 50,0:10:15.89,0:10:17.51,Main-207-,,0,0,0,,Dışarıda olmanız uygun mu?Dialogue: 50,0:10:17.51,0:10:18.22,Main-207-,,0,0,0,,Evet...Dialogue: 50,0:10:19.97,0:10:22.31,Main-207-,,0,0,0,,Geçen yılki hastalığım,Dialogue: 50,0:10:22.38,0:10:26.54,Main-207-,,0,0,0,,ailemin ölümünden sonra depresyona girmemden kaynaklanıyordu.Dialogue: 50,0:10:27.02,0:10:30.15,Main-207-,,0,0,0,,Usopp-san beni neşelendirmek için çok çaba harcadı.Dialogue: 50,0:10:30.82,0:10:32.78,Main-207-,,0,0,0,,Artık korunarak yaşayamam!Dialogue: 50,0:10:34.95,0:10:40.20,Main-207-,,0,0,0,,Size minnettarlığımın bir göstergesi olarak ufak bir şey hazırladım!Dialogue: 50,0:10:41.08,0:10:43.58,Main-207-,,0,0,0,,Lütfen kabul edin!Dialogue: 50,0:10:48.54,0:10:49.67,Main-207-,,0,0,0,,Bitirdim.Dialogue: 50,0:10:50.75,0:10:54.09,Main-207-,,0,0,0,,Az sonra bu eve de veda edeceğim.Dialogue: 50,0:10:58.80,0:11:02.73,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:11:05.85,0:11:09.06,Main-207-,,0,0,0,,Ne...? Çıkamıyorum!Dialogue: 50,0:11:10.82,0:11:12.53,Main-207-,,0,0,0,,Kahretsin!Dialogue: 50,0:11:31.34,0:11:32.96,Main-207-,,0,0,0,,"Karavel" bu!Dialogue: 50,0:11:34.34,0:11:37.26,Main-207-,,0,0,0,,Bu gerçekten bizim için mi?!Dialogue: 50,0:11:37.26,0:11:39.22,Main-207-,,0,0,0,,Evet, lütfen kullanın!Dialogue: 50,0:11:41.26,0:11:45.60,Main-207-,,0,0,0,,Biraz eski moda da olsa, bunu tasarlayan benim.Dialogue: 50,0:11:46.19,0:11:52.27,Main-207-,,0,0,0,,Karvel yapım, üçgen yelkenli ve kıçta merkez dümenli bir karavel:Dialogue: 50,0:11:53.19,0:11:56.03,Main-207-,,0,0,0,,Going Merry'yle tanışın!Dialogue: 50,0:11:57.03,0:11:58.95,Main-207-,,0,0,0,,Donanımını açıklayayım.Dialogue: 50,0:11:58.95,0:12:02.03,Main-207-,,0,0,0,,Öncelikle iskota ve seren ayarından bahsedelim—Dialogue: 50,0:12:02.03,0:12:03.29,Main-207-,,0,0,0,,Ah, hayır, hayır!Dialogue: 50,0:12:03.29,0:12:05.41,Main-207-,,0,0,0,,Gemi işlerini sadece bana anlatın!Dialogue: 50,0:12:06.08,0:12:08.29,Main-207-,,0,0,0,,Harika bir gemi!Dialogue: 50,0:12:08.29,0:12:11.71,Main-207-,,0,0,0,,Özellikle de ön taraf, çok havalı!Dialogue: 50,0:12:11.71,0:12:15.84,Main-207-,,0,0,0,,İhtiyacınız olan her şey gemiye yüklendi.Dialogue: 50,0:12:15.84,0:12:18.63,Main-207-,,0,0,0,,Teşekkür ederim, gerçekten çok minnettarsınız!Dialogue: 50,0:12:18.63,0:12:20.72,Main-207-,,0,0,0,,"Çok düşüncelisiniz" olacak, salak!Dialogue: 50,0:12:24.64,0:12:25.60,Main-207-,,0,0,0,,Durdurun şunu!Dialogue: 50,0:12:25.60,0:12:26.89,Main-207-,,0,0,0,,Usopp-san!Dialogue: 50,0:12:28.35,0:12:30.73,Main-207-,,0,0,0,,Ne yapıyor o?Dialogue: 50,0:12:30.73,0:12:32.61,Main-207-,,0,0,0,,Neyse, durduralım onu.Dialogue: 50,0:12:32.61,0:12:34.78,Main-207-,,0,0,0,,Doğruca gemiye gidiyor.Dialogue: 50,0:12:38.86,0:12:40.86,Main-207-,,0,0,0,,T-Tetekküller...Dialogue: 50,0:12:40.86,0:12:41.82,Main-207-,,0,0,0,,Rica.Dialogue: 50,0:12:42.70,0:12:46.79,Main-207-,,0,0,0,,Demek, gerçekten denize açılıyorsun, Usopp-san?Dialogue: 50,0:12:47.20,0:12:48.12,Main-207-,,0,0,0,,Evet.Dialogue: 50,0:12:48.12,0:12:51.38,Main-207-,,0,0,0,,Cesaretimi yitirmeden ayrılsam iyi olacak.Dialogue: 50,0:12:52.50,0:12:53.79,Main-207-,,0,0,0,,Beni durdurma.Dialogue: 50,0:12:53.79,0:12:55.00,Main-207-,,0,0,0,,Durdurmayacağım.Dialogue: 50,0:12:55.00,0:12:56.46,Main-207-,,0,0,0,,Bunu hissetmiştim.Dialogue: 50,0:12:56.46,0:12:58.92,Main-207-,,0,0,0,,Biraz hayal kırıklığı oldu!Dialogue: 50,0:12:59.51,0:13:01.76,Main-207-,,0,0,0,,Geri döndüğümde,Dialogue: 50,0:13:01.76,0:13:05.35,Main-207-,,0,0,0,,tamamen doğru olan daha abartılı hikâyeler anlatacağım!Dialogue: 50,0:13:06.81,0:13:09.14,Main-207-,,0,0,0,,Güzel! İple çekiyorum!Dialogue: 50,0:13:09.64,0:13:11.69,Main-207-,,0,0,0,,Siz de kendinize iyi bakın!Dialogue: 50,0:13:11.69,0:13:13.73,Main-207-,,0,0,0,,Bir ara tekrar görüşelim!Dialogue: 50,0:13:13.73,0:13:14.52,Main-207-,,0,0,0,,Niye?Dialogue: 50,0:13:14.52,0:13:16.90,Main-207-,,0,0,0,,Ha? "Niye mi?"Dialogue: 50,0:13:16.90,0:13:19.28,Main-207-,,0,0,0,,Biraz kibar olsan ölür müsün?Dialogue: 50,0:13:19.28,0:13:23.45,Main-207-,,0,0,0,,Korsan olduğumuzdan bir gün yollarımız kesişebilir.Dialogue: 50,0:13:23.82,0:13:26.45,Main-207-,,0,0,0,,Ne saçmalıyorsun? Bin hadi.Dialogue: 50,0:13:26.45,0:13:27.33,Main-207-,,0,0,0,,Ne?Dialogue: 50,0:13:27.33,0:13:29.79,Main-207-,,0,0,0,,Biz bir ekibiz, değil mi?Dialogue: 50,0:13:33.08,0:13:35.13,Main-207-,,0,0,0,,K-Kaptan...Dialogue: 50,0:13:36.00,0:13:38.13,Main-207-,,0,0,0,,Kaptan olacağım, değil mi?!Dialogue: 50,0:13:38.13,0:13:39.17,Main-207-,,0,0,0,,Aptal olma!Dialogue: 50,0:13:39.17,0:13:40.76,Main-207-,,0,0,0,,Kaptan benim!Dialogue: 50,0:14:02.40,0:14:04.62,Main-207-,,0,0,0,,Kaptan gidiyor.Dialogue: 50,0:14:04.62,0:14:05.45,Main-207-,,0,0,0,,Evet.Dialogue: 50,0:14:05.45,0:14:08.83,Main-207-,,0,0,0,,Evet ama onlarla gittiği için endişelenmiyorum.Dialogue: 50,0:14:08.83,0:14:10.08,Main-207-,,0,0,0,,Haklısın.Dialogue: 50,0:14:10.08,0:14:12.41,Main-207-,,0,0,0,,Onlardan daha güçlüsünü görmedim.Dialogue: 50,0:14:12.92,0:14:14.17,Main-207-,,0,0,0,,Buraya kadar.Dialogue: 50,0:14:14.17,0:14:16.79,Main-207-,,0,0,0,,Hep korsan olmak istediğini söylerdi.Dialogue: 50,0:14:16.79,0:14:19.67,Main-207-,,0,0,0,,Ama köylüler bunu duyunca mutlu olmayacaklar...Dialogue: 50,0:14:19.67,0:14:25.39,Main-207-,,0,0,0,,Hızlı oldu. Kaptan varken her şey çok canlı ve renkliydi.Dialogue: 50,0:14:28.14,0:14:30.43,Main-207-,,0,0,0,,Bir fikrim var!Dialogue: 50,0:14:30.43,0:14:31.93,Main-207-,,0,0,0,,– Nedir? – Nedir?Dialogue: 50,0:14:33.56,0:14:34.52,Main-207-,,0,0,0,,Merry...Dialogue: 50,0:14:34.52,0:14:35.56,Main-207-,,0,0,0,,Evet?Dialogue: 50,0:14:36.31,0:14:39.23,Main-207-,,0,0,0,,Yalan söylemek zormuş...Dialogue: 50,0:14:39.23,0:14:41.82,Main-207-,,0,0,0,,Klahadore'u mu kastediyorsunuz?Dialogue: 50,0:14:41.82,0:14:42.78,Main-207-,,0,0,0,,Hayır...Dialogue: 50,0:14:43.53,0:14:48.08,Main-207-,,0,0,0,,Öyleyse Usopp-kun'un gitmesini gerçekten istemediniz, değil mi?Dialogue: 50,0:14:51.62,0:14:52.91,Main-207-,,0,0,0,,Hanımefendi,Dialogue: 50,0:14:53.46,0:14:58.71,Main-207-,,0,0,0,,köylüler, onun çocukluğuna dair bana bir hikâye anlatmışlardı.Dialogue: 50,0:15:00.21,0:15:04.22,Main-207-,,0,0,0,,Usopp-kun'un babası köyden ayrıldıktan kısa süre sonra,Dialogue: 50,0:15:04.22,0:15:07.26,Main-207-,,0,0,0,,annesi vefat etmiş.Dialogue: 50,0:15:10.01,0:15:14.14,Flashbacks-207-,,0,0,0,,Korsanlar geliyor!Dialogue: 50,0:15:14.56,0:15:15.89,Flashbacks-207-,,0,0,0,,Korsanlar geliyor!Dialogue: 50,0:15:16.85,0:15:19.48,Flashbacks-207-,,0,0,0,,Babamın korsan gemisi burada!Dialogue: 50,0:15:17.98,0:15:19.48,Flashbacks-207-,,0,0,0,,S-Sakin ol, Usopp!Dialogue: 50,0:15:19.48,0:15:21.11,Flashbacks-207-,,0,0,0,,Bağırmamalısın!Dialogue: 50,0:15:22.19,0:15:24.82,Flashbacks-207-,,0,0,0,,Babam bizi almaya geldi!Dialogue: 50,0:15:25.49,0:15:30.95,Flashbacks-207-,,0,0,0,,S-Saçmalamayı bırak, Usopp.Dialogue: 50,0:15:30.95,0:15:36.42,Flashbacks-207-,,0,0,0,,Ama sen iyileştiğinde bizi de götüreceğini söylemişti, anne!Dialogue: 50,0:15:37.25,0:15:40.88,Flashbacks-207-,,0,0,0,,Baban geri dönmeyecek.Dialogue: 50,0:15:41.42,0:15:48.01,Flashbacks-207-,,0,0,0,,Yine de... Onunla evlendiğim için gururluyum.Dialogue: 50,0:15:48.64,0:15:50.64,Flashbacks-207-,,0,0,0,,Dışarıda mucizevi bir ilaç var!Dialogue: 50,0:15:50.64,0:15:52.93,Flashbacks-207-,,0,0,0,,Her hastalığı iyileştirebilir!Dialogue: 50,0:15:52.93,0:15:54.77,Flashbacks-207-,,0,0,0,,Çok safsın...Dialogue: 50,0:15:54.77,0:15:57.02,Flashbacks-207-,,0,0,0,,Fazla hayal kuruyorsun...Dialogue: 50,0:15:57.02,0:15:58.90,Flashbacks-207-,,0,0,0,,Safsam ne olmuş?!Dialogue: 50,0:15:58.90,0:16:00.77,Flashbacks-207-,,0,0,0,,Tabii ki hayal kuruyorum!Dialogue: 50,0:16:00.77,0:16:04.99,Flashbacks-207-,,0,0,0,,Çünkü ben bir korsanın oğluyum!Dialogue: 50,0:16:05.40,0:16:10.70,Flashbacks-207-,,0,0,0,,Büyüdüğünde baban gibi cesur bir adam ol.Dialogue: 50,0:16:17.16,0:16:22.00,Flashbacks-207-,,0,0,0,,Korsanlar geliyor!!!Dialogue: 50,0:16:22.00,0:16:23.88,Main-207-,,0,0,0,,Belki de çaresizlikten,Dialogue: 50,0:16:23.88,0:16:27.51,Main-207-,,0,0,0,,annesinin ölümünden sonra da böyle bağırmaya devam etti.Dialogue: 50,0:16:27.51,0:16:33.72,Main-207-,,0,0,0,,Bir gün, içinde babasının bulunduğu bir geminin kıyıda belirip...Dialogue: 50,0:16:33.72,0:16:36.77,Main-207-,,0,0,0,,onu almaya geleceğini umdu...!Dialogue: 50,0:16:40.15,0:16:46.07,Main-207-,,0,0,0,,Köylüler, o yalanın içinde onun arzusu olduğunu da söylüyor.Dialogue: 50,0:16:46.07,0:16:49.28,Flashbacks-207-,,0,0,0,,Korsanlar!!!Dialogue: 50,0:16:49.70,0:16:53.20,Main-207-,,0,0,0,,Ailesini kaybetmiş biri olarak,Dialogue: 50,0:16:53.20,0:16:58.00,Main-207-,,0,0,0,,sizin de aynı acıyı yaşadığınızı görünce, sessiz kalamaması anlaşılır.Dialogue: 50,0:16:58.54,0:17:02.63,Main-207-,,0,0,0,,Şu andan itibaren, daha güçlü olmalısınız.Dialogue: 50,0:17:03.17,0:17:06.88,Main-207-,,0,0,0,,Bugüne kadar sizin için yaptıklarına layık olmanız için...!Dialogue: 50,0:17:09.01,0:17:09.97,Main-207-,,0,0,0,,Olur!Dialogue: 50,0:17:14.51,0:17:16.64,Main-207-,,0,0,0,,Yeni gemimize ve yoldaşımıza!Dialogue: 50,0:17:16.64,0:17:19.10,Main-207-,,0,0,0,,– Şerefe! – Şerefe!Dialogue: 50,0:17:22.31,0:17:27.82,Main-207-,,0,0,0,,Bana ölmek için değil, yaşamak için dövüştüklerini söylediler.Dialogue: 50,0:17:28.69,0:17:33.32,Main-207-,,0,0,0,,Usopp-san'ın yalanları, her zaman yaşama sevinciyle doluydu.Dialogue: 50,0:17:33.32,0:17:35.62,Main-207-,,0,0,0,,Bana yaşama cesareti veriyordu.Dialogue: 50,0:17:35.99,0:17:37.41,Main-207-,,0,0,0,,Aynen öyle.Dialogue: 50,0:17:38.33,0:17:39.58,Main-207-,,0,0,0,,Başlıyoruz!Dialogue: 50,0:17:39.58,0:17:41.58,Main-207-,,0,0,0,,Bunu gerçekten yapacak mıyız?!Dialogue: 50,0:17:41.58,0:17:44.84,Main-207-,,0,0,0,,Elbette! Kaptanımızın coşkusunu sürdürmeliyiz!Dialogue: 50,0:17:47.80,0:18:06.44,Main-207-,,0,0,0,,– Korsanlar geliyor!!! – Korsanlar geliyor!!!Dialogue: 50,0:17:54.55,0:17:56.05,Main-207-,,0,0,0,,Hey, Merry?Dialogue: 50,0:17:56.60,0:17:58.93,Main-207-,,0,0,0,,Ben, doktor olmak istiyorum!Dialogue: 50,0:18:00.39,0:18:03.35,Main-207-,,0,0,0,,Bu harika bir hedef!Dialogue: 0,0:02:00.35,0:02:04.31,Title-207-,,0,0,0,,Denize DoğruDialogue: 1,0:02:00.35,0:02:04.31,Title-207-,,0,0,0,,Denize DoğruDialogue: 0,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 1,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 0,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Feeso Galaxy 9000Dialogue: 1,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Feeso Galaxy 9000Dialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,MüzikDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,MüzikDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,HaleeDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,HaleeDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,GrafikDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,GrafikDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,DatenshiDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,DatenshiDialogue: 0,0:00:06.78,0:00:10.78,Credits-207-,,0,0,0,,Kalite KontrolDialogue: 1,0:00:06.78,0:00:10.78,Credits-207-,,0,0,0,,Kalite KontrolDialogue: 0,0:00:06.78,0:00:10.78,Credits-207-,,0,0,0,,Gab Galaxy 9000 Grug Mr. Luffy Pepperjack ZenefDialogue: 1,0:00:06.78,0:00:10.78,Credits-207-,,0,0,0,,Gab Galaxy 9000 Grug Mr. Luffy Pepperjack ZenefDialogue: 0,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,KaraokeDialogue: 1,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,KaraokeDialogue: 0,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,KaitouYahikoDialogue: 1,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,KaitouYahikoDialogue: 0,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,ZamanlamaDialogue: 1,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,ZamanlamaDialogue: 0,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,GabDialogue: 1,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,GabDialogue: 0,0:00:13.28,0:00:16.79,Credits-207-,,0,0,0,,Altyazı Düzenleme [TR]Dialogue: 1,0:00:13.28,0:00:16.79,Credits-207-,,0,0,0,,Altyazı Düzenleme [TR]Dialogue: 0,0:00:13.28,0:00:16.79,Credits-207-,,0,0,0,,Jack Cohle -onepacetr.net-Dialogue: 1,0:00:13.28,0:00:16.79,Credits-207-,,0,0,0,,Jack Cohle -onepacetr.net-Dialogue: 0,0:00:16.79,0:00:19.25,Credits-207-,,0,0,0,,RawsDialogue: 1,0:00:16.79,0:00:19.25,Credits-207-,,0,0,0,,RawsDialogue: 0,0:00:16.79,0:00:19.25,Credits-207-,,0,0,0,,Neo-RawsDialogue: 1,0:00:16.79,0:00:19.25,Credits-207-,,0,0,0,,Neo-RawsDialogue: 0,0:00:16.79,0:00:19.25,Credits-207-,,0,0,0,,Çevirmenler [TR]Dialogue: 1,0:00:16.79,0:00:19.25,Credits-207-,,0,0,0,,Çevirmenler [TR]Dialogue: 0,0:00:16.79,0:00:19.25,Credits-207-,,0,0,0,,Jack Cohle Kazasker -onepacetr.net-Dialogue: 1,0:00:16.79,0:00:19.25,Credits-207-,,0,0,0,,Jack Cohle Kazasker -onepacetr.net-Dialogue: 0,0:00:01.52,0:00:03.65,Roger-Monologue,,0,0,0,,Zenginlik, şöhret, güç...Dialogue: 0,0:00:03.65,0:00:07.82,Roger-Monologue,,0,0,0,,Dünyanın sunabileceği her şeyi elde eden adam, Korsanlar Kralı, Gold Roger.Dialogue: 0,0:00:07.82,0:00:11.66,Roger-Monologue,,0,0,0,,Son sözleri dünyanın her yerinden maceracıları denize çekti.Dialogue: 0,0:00:11.66,0:00:13.66,Roger-Monologue,,0,0,0,,Hazinem mi?Dialogue: 0,0:00:13.66,0:00:15.45,Roger-Monologue,,0,0,0,,İstiyorsanız, alabilirsiniz.Dialogue: 0,0:00:15.45,0:00:16.66,Roger-Monologue,,0,0,0,,Arayıp bulun!Dialogue: 0,0:00:16.66,0:00:19.25,Roger-Monologue,,0,0,0,,Bu dünyanın sunabileceği her şeyi orada bıraktım!Dialogue: 0,0:00:21.67,0:00:26.38,Roger-Monologue,,0,0,0,,Artık herkes, hayallerinin peşinde Grand Line’a yelken açıyor!Dialogue: 0,0