2,10,10,10,1Style: Secondary,Impress BT,52.0,&H00D6D6D6,&H00FFFFFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,1.5,1.5,2,120,120,18,1Style: Eyecatch,Kozuka Gothic Pro B,52.0,&H00FFFFFF,&H00FFFFFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,1.5,1.5,2,120,120,18,1Style: Sign,Futura Md BT,35.0,&H00FFFFFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.5,1.5,8,120,120,18,1Style: Attack,Duality,33.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.0,1.0,7,12,12,12,1Style: Author,Impress BT,19.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.5,0.5,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:10.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Knaryaa thx to onepace.netDialogue: 0,0:14:45.00,0:14:55.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Knaryaa thx to onepace.netDialogue: 0,0:28:21.20,0:28:24.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Knaryaa thx to onepace.netDialogue: 0,0:02:29.87,0:02:38.27,Narrator,Narrator,0,0,0,,Balık Adam Adası'ndan ayrılan gemi nihayet Yeni Dünya'ya doğru yükseliyor.Dialogue: 0,0:02:38.53,0:02:40.30,Main,Luffy,0,0,0,,Her şey iyi gidiyor!Dialogue: 0,0:02:40.30,0:02:42.51,Main,Usopp,0,0,0,,O kadar iyi gidiyor ki neredeyse korkutucu!Dialogue: 0,0:02:51.69,0:02:54.11,Main,Nami,0,0,0,,Bu harika.Dialogue: 0,0:02:54.86,0:02:57.69,Main,Nami,0,0,0,,Shower Tempom hakkında ne düşünüyorsun?Dialogue: 0,0:02:57.69,0:02:59.28,Main,Nami,0,0,0,,Katılmak ister misin?Dialogue: 0,0:02:59.28,0:03:01.20,Main,Chopper,0,0,0,,Kim, ben mi?Dialogue: 0,0:03:01.20,0:03:04.53,Main,Chopper,0,0,0,,İstemiyorum, iki gün önce yıkandım.Dialogue: 0,0:03:05.20,0:03:09.37,Main,Chopper,0,0,0,,Pamuk şekere benzeyen bulut daha çok ilgimi çekiyor. Leziz görünüyor!Dialogue: 0,0:03:09.37,0:03:11.21,Main,Nami,0,0,0,,Yenilebilir değil.Dialogue: 0,0:03:11.21,0:03:13.96,Main,Chopper,0,0,0,,Gerçekten mi? Yani tatlı pamuk şeker, değil mi?Dialogue: 0,0:03:13.96,0:03:17.96,Main,Brook,0,0,0,,Ne? Banyo odasında tatlı ve lezzetli bir şey mi var?Dialogue: 0,0:03:17.96,0:03:20.80,Main,Sanji,0,0,0,,Bu doğru. Gerçekten de tatlı ve leziz görünüyor!Dialogue: 0,0:03:21.63,0:03:23.55,Main,Sanji,0,0,0,,Lütfen, Nami-san!Dialogue: 0,0:03:23.55,0:03:24.89,Main,Sanji,0,0,0,,Bu tarafa bak!Dialogue: 0,0:03:26.43,0:03:29.10,Main,Nami,0,0,0,,Chopper, o buluta daha fazla yaklaşma.Dialogue: 0,0:03:35.52,0:03:38.65,Main,Chopper,0,0,0,,Korkunç! Artık o bulutu yemek istemiyorum!Dialogue: 0,0:03:41.53,0:03:46.74,Main,Nami,0,0,0,,Bu çok rahatlatıcı...   Son iki yıldır Sunny'de banyo yapmayı özlemişim!Dialogue: 0,0:03:50.33,0:03:53.92,Main,Nami,0,0,0,,Banyo yaparken gece gökyüzüne bakar gibi, denizin derinliklerine bakmak...Dialogue: 0,0:03:53.92,0:03:56.09,Main,Nami,0,0,0,,İşte hayat bu!Dialogue: 0,0:03:56.09,0:03:58.51,Main,Chopper,0,0,0,,Güvertede sen yokken iyi olacaklar mı?Dialogue: 0,0:03:58.51,0:04:03.13,Main,Nami,0,0,0,,Yükselen akıntılara girmeden önce banyodan çıkacağım, yani sorun olmayacak.Dialogue: 0,0:04:03.80,0:04:06.92,Main,Nami,0,0,0,,Eğer deniz canavarları gelirse, eminim halledebilirler.Dialogue: 0,0:04:06.92,0:04:08.93,Main,Luffy,0,0,0,,Acele et, Usopp!Dialogue: 0,0:04:08.93,0:04:11.18,Main,Usopp,0,0,0,,Birazcık daha bekle!Dialogue: 0,0:04:11.18,0:04:14.47,Main,Usopp,0,0,0,,Dev balıklarla karşı karşıyayız! Zayıf bir ip onları tutamaz!Dialogue: 0,0:04:16.06,0:04:18.12,Main,Robin,0,0,0,,Eğleniyor gibi görünüyorsunuz.Dialogue: 0,0:04:19.61,0:04:23.53,Main,Luffy,0,0,0,,Aşağı inerken Balık Adam Adası'na gittiğimiz için heyecandan bunu düşünmemiştim,Dialogue: 0,0:04:23.53,0:04:26.32,Main,Luffy,0,0,0,, ama eğer derin deniz balıklarını yakalarsak yüzeye çıktığımızda,Dialogue: 0,0:04:26.37,0:04:28.63,Main,Luffy,0,0,0,,Sanji bizim için onları pişirebilir, değil mi?Dialogue: 0,0:04:28.99,0:04:31.45,Main,Franky,0,0,0,,Umarım kola ile beraber iyi gider!Dialogue: 0,0:04:31.45,0:04:34.25,Main,Zoro,0,0,0,,Yemek pişirmek, ha? Harika fikir!Dialogue: 0,0:04:34.25,0:04:37.66,Main,Zoro,0,0,0,,Yeni Dünya'ya girişimizi kutlamak için bir içki içmeyi sabırsızlıkla bekliyorum.Dialogue: 0,0:04:38.17,0:04:41.26,Main,Usopp,0,0,0,,Bakalım, acaba hangisini yakalasak?Dialogue: 0,0:04:41.26,0:04:42.58,Main,Luffy,0,0,0,,En leziz görüneni istiyorum.Dialogue: 0,0:04:43.34,0:04:46.27,Main,Zoro,0,0,0,,Belki de şunu kızartıp tuzlayıp yemeliyiz?Dialogue: 0,0:04:46.27,0:04:49.69,Main,Luffy,0,0,0,,Tuzlu kızarmış balık, ha? Kulağa harika geliyor!Dialogue: 0,0:04:50.10,0:04:52.59,Main,Usopp,0,0,0,,Şuradaki soya sosuyla ızgaralanırsa güzel olur gibi.Dialogue: 0,0:04:52.59,0:04:55.02,Main,Luffy,0,0,0,,Izgara balık, ha?Dialogue: 0,0:04:55.02,0:04:57.06,Main,Luffy,0,0,0,,Ooh!  Bu da güzel duruyor!Dialogue: 0,0:04:57.06,0:04:59.48,Main,Luffy,0,0,0,,Eğer üstüne mayonez eklersek kesinlikle tadı güzel olur!Dialogue: 0,0:04:59.48,0:05:01.77,Main,Usopp,0,0,0,,Ha? Hangisi?Dialogue: 0,0:05:03.82,0:05:06.00,Main,Usopp & Zoro,0,0,0,,Hayır, imkanı yok.Dialogue: 0,0:05:06.00,0:05:09.49,Main,Usopp,0,0,0,,Onu nasıl pişirirsen pişir tadı kötü olur.Dialogue: 0,0:05:09.49,0:05:12.37,Main,Luffy,0,0,0,,Gerçekten mi? Benim için farketmez.Dialogue: 0,0:05:16.33,0:05:19.96,Main,Luffy,0,0,0,,Sanji her şeyi pişirebilir ve lezzetli hala getirebilir!Dialogue: 0,0:05:24.92,0:05:28.22,Main,Usopp,0,0,0,,Yine de onu yemek istiyor musun?!Dialogue: 0,0:05:28.22,0:05:30.39,Main,Usopp,0,0,0,,Bekle, sence de biraz büyük değil mi?!Dialogue: 0,0:05:30.39,0:05:33.02,Main,Luffy,0,0,0,,Hemen! Yakalayın!Dialogue: 0,0:05:33.31,0:05:35.60,Attack,TL Note,0,0,0,,Ölümcül Yakalama YıldızıDialogue: 0,0:05:38.60,0:05:40.02,Main,Usopp,0,0,0,,Tamamdır!Dialogue: 0,0:05:40.02,0:05:42.32,Main,Luffy,0,0,0,,Kendimize derin deniz balığı yakaladık!Dialogue: 0,0:05:42.32,0:05:44.78,Main,Luffy,0,0,0,,Hemen yemek istiyorum!Dialogue: 0,0:05:44.78,0:05:47.78,Main,Usopp,0,0,0,,Gerçekten bu balık mı?Dialogue: 0,0:05:47.78,0:05:49.20,Main,Usopp,0,0,0,,Belki de yaşlı bir adamdır?Dialogue: 0,0:05:49.20,0:05:50.20,Main,Luffy,0,0,0,,Yaşlı adam mı?Dialogue: 0,0:05:53.12,0:05:54.87,Main,Usopp,0,0,0,,Yeme dönüştü!Dialogue: 0,0:05:57.37,0:05:59.42,Main,Usopp,0,0,0,,Tekrardan mı?!Dialogue: 0,0:05:59.42,0:06:01.29,Main,Usopp,0,0,0,,Hala gelmeye devam ediyorlar!Dialogue: 0,0:06:01.29,0:06:03.71,Main,Luffy,0,0,0,,Acele et ve çek şunu, Usopp!Dialogue: 0,0:06:03.71,0:06:05.09,Main,Usopp,0,0,0,,Ha?! İmkanı yok!Dialogue: 0,0:06:05.09,0:06:06.75,Main,Usopp,0,0,0,,Gemi alabora olacak!Dialogue: 0,0:06:06.75,0:06:09.35,Main,Zoro,0,0,0,,Balıklar gelmeye devam ediyor! Sanki matruşka oyuncağı gibi!Dialogue: 0,0:06:09.35,0:06:12.51,Main,Chopper,0,0,0,,Bir şey mi oldu? Gemi sallanıyor.Dialogue: 0,0:06:12.51,0:06:14.14,Main,Chopper,0,0,0,,Ve güverteden bir sürü gürültü geliyor.Dialogue: 0,0:06:14.72,0:06:18.02,Main,Nami,0,0,0,,Galiba onları yalnız bırakmak kötü bir fikirdi.Dialogue: 0,0:06:18.06,0:06:19.40,Attack,TL Note,0,0,0,,Tek Kılıç StiliDialogue: 0,0:06:19.81,0:06:21.90,Attack,TL Note,0,0,0,,360 Poundluk TopDialogue: 0,0:06:24.48,0:06:26.57,Main,Luffy,0,0,0,,Harikaydın, Zoro!Dialogue: 0,0:06:27.32,0:06:28.86,Main,Sanji,0,0,0,,Bütün bu yaygara da ne?Dialogue: 0,0:06:30.11,0:06:32.24,Main,Luffy,0,0,0,,Sanji! Şuna bak!Dialogue: 0,0:06:32.95,0:06:35.62,Main,Sanji,0,0,0,,Anladım, harika fikir!Dialogue: 0,0:06:35.62,0:06:38.91,Main,Sanji,0,0,0,,Derin deniz balığı pişirmek, ha?  Denemek için can atıyorum.Dialogue: 0,0:06:38.91,0:06:41.71,Main,Usopp,0,0,0,,Daha önemlisi... sen neden piştin?Dialogue: 0,0:06:43.04,0:06:46.09,Main,Luffy,0,0,0,,Ve daha da heyecanlı olmalısınız!Dialogue: 0,0:06:46.09,0:06:48.63,Main,Luffy,0,0,0,,Çünkü içinde iki tane daha balık var!Dialogue: 0,0:06:49.01,0:06:52.34,Main,Usopp,0,0,0,,Neyse, hala yüzeye doğru ilerliyor muyuz?Dialogue: 0,0:06:52.34,0:06:55.06,Main,Usopp,0,0,0,,İçimde kötü bir his var, sanki batıyoruz.Dialogue: 0,0:06:55.06,0:06:56.34,Main,Luffy,0,0,0,,Muhtemelen sana öyle geliyordur.Dialogue: 0,0:06:57.56,0:06:58.64,Main,Luffy,0,0,0,,O-o da neydi?Dialogue: 0,0:07:01.73,0:07:03.73,Main,Usopp,0,0,0,,Dev deniz yılanı!Dialogue: 0,0:07:04.90,0:07:07.82,Main,Luffy,0,0,0,,Tamamdır! Yakınlaşın! Onu da yiyeceğiz!Dialogue: 0,0:07:07.82,0:07:10.24,Main,Usopp,0,0,0,,Ona gemiyle yaklaşamayız!Dialogue: 0,0:07:10.49,0:07:13.44,Main,Robin,0,0,0,,Bekle! Yoksa o...Dialogue: 0,0:07:14.74,0:07:16.54,Main,Robin,0,0,0,,Whitestorm?!Dialogue: 0,0:07:17.34,0:07:22.83,Main,Robin,0,0,0,,Tıpkı canlı bir ejderha gibi su altında birdenbire ortaya çıkan dev beyaz bir girdap?Dialogue: 0,0:07:23.46,0:07:24.67,Main,Usopp,0,0,0,,Ne?!Dialogue: 0,0:07:25.89,0:07:28.01,Main,Luffy,0,0,0,,Deniz altı girdapı mı?!Dialogue: 0,0:07:30.26,0:07:32.92,Main,Nami,0,0,0,,Bazen gerçekten...Dialogue: 0,0:07:32.92,0:07:36.01,Main,Nami,0,0,0,,Ne?! Bu çok kötü! O Whitestorm mu?!Dialogue: 0,0:07:36.89,0:07:39.60,Main,Robin,0,0,0,,Duyduğuma göre, bu girdaba yakalanan herhangi bir gemi,Dialogue: 0,0:07:39.60,0:07:43.52,Main,Robin,0,0,0,,günler sonra inanılmaz uzak bir denizde, tayfasından hiçbir iz olmadan yeniden ortaya çıkıyor!Dialogue: 0,0:07:44.90,0:07:47.82,Main,Usopp,0,0,0,,Bu herkesin öldüğü anlamına geliyor olmalı!Dialogue: 0,0:07:47.82,0:07:50.07,Main,Usopp,0,0,0,,Yani gerçektende çok kötü! Hadi burayı terk edelim!Dialogue: 0,0:07:50.74,0:07:53.95,Main,Luffy,0,0,0,,Gemiyi inanılmaz uzak denizlere mi götürüyor?Dialogue: 0,0:07:55.37,0:07:58.41,Main,Luffy,0,0,0,,Yani... bu süper havalı solucan deliklerinden biri gibi mi?!Dialogue: 0,0:07:58.41,0:07:59.33,Main,Usopp,0,0,0,,Hayır, seni aptal!Dialogue: 0,0:08:00.25,0:08:03.50,Main,Nami,0,0,0,,Millet! Hemen o girdaptan uzaklaşın!Dialogue: 0,0:08:04.12,0:08:06.92,Main,Usopp,0,0,0,,Rotacımız geldi!Dialogue: 0,0:08:06.92,0:08:08.05,Main,Usopp,0,0,0,,Burayı terk ediyoruz, sizi aptallar!Dialogue: 0,0:08:09.74,0:08:11.58,Main,Nami,0,0,0,,Bu balık da ne?!Dialogue: 0,0:08:11.58,0:08:13.22,Main,Luffy,0,0,0,,Onu biz yakaladık!Dialogue: 0,0:08:13.22,0:08:15.22,Main,Nami,0,0,0,,Ne yapıyorsunuz?!Dialogue: 0,0:08:15.22,0:08:18.14,Main,Nami,0,0,0,,O şey gemiye bağlı olduğu sürece hareket edemeyiz!Dialogue: 0,0:08:18.14,0:08:20.56,Main,Nami,0,0,0,,Gördünüz mü? Balık girdap tarfından çekiliyor!Dialogue: 0,0:08:20.81,0:08:22.73,Main,Luffy,0,0,0,,Olamaz! Hemen çıkartın!Dialogue: 0,0:08:22.73,0:08:23.44,Main,Usopp; Sanji & Zoro,0,0,0,,Anlaşıldı!Dialogue: 0,0:08:23.44,0:08:25.65,Main,Nami,0,0,0,,Hayır! İpi kesin!Dialogue: 0,0:08:25.65,0:08:28.77,Main,Them,0,0,0,,Nee?! Ama ya pişmiş derin deniz balığına ne olacak?!Dialogue: 0,0:08:28.77,0:08:31.94,Main,Nami,0,0,0,,Hangisi daha önemli, balık mı hayatımız mı?!Dialogue: 0,0:08:31.94,0:08:37.07,Main,Nami,0,0,0,,Sizi sadece on dakika yalnız bıraktım! Bizi nasıl bu kadar sıkıntıya sokabiliyorsunuz?!Dialogue: 0,0:08:37.07,0:08:39.24,Main,Nami,0,0,0,,Franky! Coup de Burst kullan!Dialogue: 0,0:08:39.24,0:08:41.75,Main,Franky,0,0,0,,Hayır, çoktan süper geciktik!Dialogue: 0,0:08:42.41,0:08:42.91,Main,Franky,0,0,0,,Değil mi?Dialogue: 0,0:08:42.91,0:08:44.45,Main,Nami,0,0,0,,Sana kullanmanı söyledim!Dialogue: 0,0:08:45.00,0:08:48.54,Main,Usopp,0,0,0,,Girdap tarafından çekiliyoruz!Dialogue: 0,0:08:49.45,0:08:50.88,Main,Brook,0,0,0,,Oldukça zor bir durumdayız!Dialogue: 0,0:08:51.88,0:08:53.17,Main,Luffy,0,0,0,,Bu harika!Dialogue: 0,0:08:53.17,0:08:55.51,Main,Nami,0,0,0,,Hayııır! İşimiz bitti!Dialogue: 0,0:08:55.51,0:08:57.51,Main,Chopper,0,0,0,,Ölmek istemiyorum!Dialogue: 0,0:08:57.51,0:08:59.76,Main,Luffy,0,0,0,,Gemiye tutunun!Dialogue: 0,0:09:30.12,0:09:31.71,Main,Luffy,0,0,0,,Durduk!Dialogue: 0,0:09:33.17,0:09:36.46,Main,Luffy,0,0,0,,Bu siyah duvar da ne?Dialogue: 0,0:09:40.39,0:09:42.64,Main,Nami,0,0,0,,Bu bağırış... Yoksa o...Dialogue: 0,0:10:03.04,0:10:04.91,Main,Luffy,0,0,0,,O yara!Dialogue: 0,0:10:07.96,0:10:09.99,Flashbacks,Luffy,0,0,0,,Tekrar seni görmek için geleceğim!Dialogue: 0,0:10:09.99,0:10:12.59,Flashbacks,Luffy,0,0,0,,Ve geldiğim zaman, tekrar savaşalım!Dialogue: 0,0:10:17.09,0:10:18.97,Main,Luffy,0,0,0,,Laboon?!Dialogue: 0,0:10:29.98,0:10:31.40,Flashbacks,Rumbar Pirates,0,0,0,,Laboon!Dialogue: 0,0:10:31.40,0:10:36.36,Flashbacks,Rumbar Pirates,0,0,0,,Kesinlikle dünyanın etrafında dolaşacağız ve buraya tekrar geleceğiz!Dialogue: 0,0:10:36.36,0:10:37.74,Flashbacks,Rumbar Pirates,0,0,0,,Bizi bekle!Dialogue: 0,0:10:40.03,0:10:44.33,Main,Brook,0,0,0,,Laboon! Bu kadar büyüdün mü?!Dialogue: 0,0:10:44.33,0:10:49.54,Main,Usopp,0,0,0,,Saçmalama! Laboon Grand Line'ın ilk yarısında!Dialogue: 0,0:10:49.54,0:10:52.13,Main,Usopp,0,0,0,,O çok büyük, Red Line'daki delikten bile giremez!Dialogue: 0,0:10:52.13,0:10:53.88,Main,Chopper,0,0,0,,Muhteşem!Dialogue: 0,0:10:53.88,0:10:58.35,Main,Robin,0,0,0,,Bir mucize gibi. Hiç balina sürüsü göreceğimizi hayal etmezdim.Dialogue: 0,0:10:58.35,0:11:02.64,Main,Zoro,0,0,0,,Şuradakinin kafasında Laboon'unkine benzeyen yarası var.Dialogue: 0,0:11:02.64,0:11:05.56,Main,Luffy,0,0,0,,Evet! Yarası tamamen aynı!Dialogue: 0,0:11:05.56,0:11:08.10,Main,Luffy,0,0,0,,Şaşırtıcı! Gerçekten Laboon değil mi?Dialogue: 0,0:11:08.10,0:11:12.14,Main,Brook,0,0,0,,Bink'in sakesini teslim edeceğiz...Dialogue: 0,0:11:12.14,0:11:15.57,Main,Brook,0,0,0,,Laboon! Dur!Dialogue: 0,0:11:15.57,0:11:17.07,Main,Brook,0,0,0,,Beni dinle!Dialogue: 0,0:11:17.07,0:11:20.49,Main,Brook,0,0,0,,Benim! Rumbar Korsanlarının bir parçasıydım!Dialogue: 0,0:11:20.49,0:11:22.03,Main,Brook,0,0,0,,Benim, Brook!Dialogue: 0,0:11:22.03,0:11:26.08,Main,Usopp,0,0,0,,Kendine gel! Sana söyledim, o başka bir balina!Dialogue: 0,0:11:26.08,0:11:27.33,Main,Brook,0,0,0,,Laboon!Dialogue: 0,0:11:27.33,0:11:29.20,Main,Sanji,0,0,0,,Sakince onlara hayran kalmanın zamanı değil!Dialogue: 0,0:11:30.08,0:11:32.21,Main,Sanji,0,0,0,,Girdaptan çıkmış olsak bile, hala tehlikedeyiz!Dialogue: 0,0:11:32.21,0:11:36.08,Main,Sanji,0,0,0,,İlk olarak, sayım yapmalıyız ki kimsenin girdapta güverteden düşmediğine emin olalım!Dialogue: 0,0:11:36.59,0:11:37.34,Main,Sanji,0,0,0,,Nami-san!Dialogue: 0,0:11:37.34,0:11:38.26,Main,Nami,0,0,0,,Evet!Dialogue: 0,0:11:38.26,0:11:39.30,Main,Sanji,0,0,0,,Robin-chan!Dialogue: 0,0:11:39.30,0:11:40.01,Main,Robin,0,0,0,,Buradayım.Dialogue: 0,0:11:40.01,0:11:43.18,Main,Sanji,0,0,0,,Tamam. Hemen buradan çıkmalıyız!Dialogue: 0,0:11:43.18,0:11:46.42,Main,Sanji,0,0,0,,Eğer devasa balinalara çarparsak, gemi ağır hasar alır!Dialogue: 0,0:11:46.42,0:11:48.39,Main,Chopper,0,0,0,,Bizi de say!Dialogue: 0,0:11:48.39,0:11:52.48,Main,Usopp,0,0,0,,Sanji-kun! Utançla kabul ediyorum ki diğer altı tayfa üyesi henüz onurlu bir şekilde ölmedi!Dialogue: 0,0:11:52.73,0:11:54.03,Main,Sanji,0,0,0,,Nami-san, emirlerin nedir?!Dialogue: 0,0:11:54.90,0:11:56.15,Main,Nami,0,0,0,,Olduğumuz yerde durabiliriz.Dialogue: 0,0:11:56.15,0:11:59.07,Main,Sanji,0,0,0,,Bu doğru, iyi durumdayız, aptallar!Dialogue: 0,0:11:59.07,0:12:00.74,Main,Sanji,0,0,0,,Balinaları izlemeye derhal devam edin!Dialogue: 0,0:12:00.74,0:12:01.99,Main,Usopp & Chopper,0,0,0,,Bu da ne?!Dialogue: 0,0:12:02.74,0:12:06.11,Main,Nami,0,0,0,,Devasa balina sürüsü kendi deniz akıntısını oluşturuyor.Dialogue: 0,0:12:06.87,0:12:09.16,Main,Nami,0,0,0,,Karşı koymaya çalışmamız daha tehlikeli olur.Dialogue: 0,0:12:09.16,0:12:11.00,Main,Nami,0,0,0,,Yelkenlerin açık olduğuna emin olun!Dialogue: 0,0:12:11.00,0:12:13.71,Main,Nami,0,0,0,,Gemiyi balinaların hareket ettiği yöne çevirin!Dialogue: 0,0:12:13.96,0:12:15.04,Main,Straw Hats,0,0,0,,Anlaşıldı!Dialogue: 0,0:12:17.38,0:12:20.59,Main,Brook,0,0,0,,Tabii ki de... Burası Laboon'un memleketi olmalı.Dialogue: 0,0:12:20.59,0:12:23.68,Main,Brook,0,0,0,,Acaba burada akrabası var mı?!Dialogue: 0,0:12:23.68,0:12:24.89,Main,Robin,0,0,0,,Bu tehlikeli, Brook!Dialogue: 0,0:12:24.89,0:12:29.31,Main,Brook,0,0,0,,Eğer aranızdan biri sürüden elli yıl önce ayrılan küçük bir balina arıyorsa...Dialogue: 0,0:12:29.31,0:12:35.39,Main,Brook,0,0,0,,Endişelenmeyin! Dünyanın öbür ucundaki denizde iyi durumda!Dialogue: 0,0:12:35.39,0:12:41.07,Main,Brook,0,0,0,,Luffy-san'a göre, güçlenmiş ve kocaman olmuş!Dialogue: 0,0:12:41.07,0:12:43.32,Main,Brook,0,0,0,,Lütfen, endişelenmeyin!Dialogue: 0,0:12:47.07,0:12:48.58,Main,Nami,0,0,0,,Deniz akıntısını takip edin!Dialogue: 0,0:12:48.58,0:12:49.28,Main,Luffy,0,0,0,,Tamamdır!Dialogue: 0,0:13:11.80,0:13:16.23,Sign,Song,0,0,0,,♪ Bink'in sakesini teslim edeceğiz,Dialogue: 0,0:13:16.23,0:13:20.15,Sign,Song,0,0,0,,kendimizi okyanus melteminin ve dalgalarının kaprislerine emanet ediyoruz. ♪Dialogue: 0,0:13:20.15,0:13:24.82,Sign,Song,0,0,0,,♪ Gelgitlerin ötesinde akşam güneşi bile neşeli. ♪Dialogue: 0,0:13:24.82,0:13:28.95,Sign,Song,0,0,0,,♪ Kuşların şarkısı gökyüzünde daireler çiziyor. ♪Dialogue: 0,0:13:28.95,0:13:33.40,Sign,Song,0,0,0,,♪ Limana, eski memlekete veda. ♪Dialogue: 0,0:13:33.40,0:13:37.67,Sign,Song,0,0,0,,♪ Hadi DON ile bir şarkı söyleyelim, ayrılışımız için bir şarkı! ♪Dialogue: 0,0:13:37.67,0:13:41.92,Sign,Song,0,0,0,,♪ Deniz kenarına doğru yola çıktığımızda,Dialogue: 0,0:13:41.92,0:13:45.92,Sign,Song,0,0,0,,altın ve gümüş dalgaları su sıçramalarına dönüşüyor! ♪Dialogue: 0,0:13:45.92,0:13:50.35,Sign,Song,0,0,0,,♪ Bink'in sakesini teslim edeceğiz. ♪Dialogue: 0,0:13:50.35,0:13:54.55,Sign,Song,0,0,0,,♪ Biz denizleri aşan korsanlarız. ♪Dialogue: 0,0:13:54.55,0:13:58.93,Sign,Song,0,0,0,,♪ Deniz yastığımız, gemi ise yatağımızdır. ♪Dialogue: 0,0:13:58.93,0:14:03.36,Sign,Song,0,0,0,,♪ Kafatası yelkenimize ve bayrağımıza işlenmiştir. ♪Dialogue: 0,0:14:03.36,0:14:07.45,Sign,Song,0,0,0,,♪ Uzak göklerden bir fırtına geliyor. ♪Dialogue: 0,0:14:07.45,0:14:12.03,Sign,Song,0,0,0,,♪ Dalgalar dans ediyor, davullar çalıyor! ♪Dialogue: 0,0:14:12.03,0:14:16.29,Sign,Song,0,0,0,,♪ Eğer hain bir rüzgara yakalanırsan bu son olabilir,Dialogue: 0,0:14:16.29,0:14:20.71,Sign,Song,0,0,0,,ama güneş her sabah daima doğacak! ♪Dialogue: 0,0:14:08.11,0:14:10.53,Main,Luffy,0,0,0,,Seni sürmemize izin veriyorsun!Dialogue: 0,0:14:10.87,0:14:14.04,Main,Nami,0,0,0,,Bizi böyle taşımalarına izin verebiliriz.Dialogue: 0,0:14:14.04,0:14:16.50,Main,Nami,0,0,0,,Görünüşe göre hepimiz aynı yükselen akıntıyı takip ediyoruzDialogue: 0,0:14:40.85,0:14:41.65,Main,Robin,0,0,0,,Luffy?Dialogue: 0,0:14:52.42,0:14:54.37,Main,Luffy,0,0,0,,Gördüm!Dialogue: 0,0:14:54.78,0:14:57.45,Main,Luffy,0,0,0,,Hadi gidelim, millet!Dialogue: 0,0:14:57.45,0:14:58.46,Main,Straw Hats,0,0,0,,On!Dialogue: 0,0:14:58.46,0:14:59.46,Main,Straw Hats,0,0,0,,Dokuz!Dialogue: 0,0:14:59.46,0:15:00.41,Main,Straw Hats,0,0,0,,Sekiz!Dialogue: 0,0:15:00.41,0:15:01.33,Main,Straw Hats,0,0,0,,Yedi!Dialogue: 0,0:15:01.33,0:15:02.33,Main,Straw Hats,0,0,0,,Altı!Dialogue: 0,0:15:02.33,0:15:03.51,Main,Straw Hats,0,0,0,,Beş!Dialogue: 0,0:15:03.51,0:15:04.29,Main,Straw Hats,0,0,0,,Dört!Dialogue: 0,0:15:04.29,0:15:05.21,Main,Straw Hats,0,0,0,,Üç!Dialogue: 0,0:15:05.21,0:15:06.16,Main,Straw Hats,0,0,0,,İki!Dialogue: 0,0:15:06.16,0:15:07.30,Main,Straw Hats,0,0,0,,Bir!Dialogue: 0,0:15:15.85,0:15:17.52,Main,Luffy,0,0,0,,Geldik!Dialogue: 0,0:15:17.52,0:15:19.27,Main,Straw Hats,0,0,0,,Yeni Dünya'dayız!Dialogue: 0,0:15:19.27,0:15:21.06,Main,Luffy,0,0,0,,Başardık!Dialogue: 0,0:15:21.06,0:15:23.31,Main,Franky,0,0,0,,Sonunda geldik!Dialogue: 0,0:15:24.23,0:15:26.18,Main,Usopp,0,0,0,,Hava durumu berbat!Dialogue: 0,0:15:27.32,0:15:28.49,Main,Brook,0,0,0,,Gökyüzünde fırtına bulutları!Dialogue: 0,0:15:29.11,0:15:30.50,Main,Robin,0,0,0,,Rüzgâr şiddetle esiyor!Dialogue: 0,0:15:30.50,0:15:32.20,Main,Franky,0,0,0,,Deniz kızgın!Dialogue: 0,0:15:32.91,0:15:34.16,Main,Nami,0,0,0,,Pusulanın iğneleri kontrolden çıktı!Dialogue: 0,0:15:34.41,0:15:36.24,Main,Luffy,0,0,0,,Gidelim!Dialogue: 0,0:15:42.46,0:15:43.42,Main,Zoro,0,0,0,,O da ne?Dialogue: 0,0:15:43.42,0:15:45.34,Main,Nami,0,0,0,,Ne?! İmkansız!Dialogue: 0,0:15:47.84,0:15:49.13,Main,Robin,0,0,0,,Kırmızı deniz mi?Dialogue: 0,0:15:50.72,0:15:53.18,Main,Luffy,0,0,0,,Bakın! Volkanik patlama!Dialogue: 0,0:15:53.18,0:15:55.39,Main,Nami,0,0,0,,Dinle, Luffy!Dialogue: 0,0:15:55.39,0:15:59.27,Main,Nami,0,0,0,,Pusulanın üç iğnesi de o adayı göstermiyor!Dialogue: 0,0:15:59.27,0:16:01.98,Main,Nami,0,0,0,,Bu anormal bir durum, Yeni Dünya için bile anormal!Dialogue: 0,0:16:03.28,0:16:04.85,Main,Luffy,0,0,0,,Başka bir patlama!Dialogue: 0,0:16:04.85,0:16:06.98,Main,Luffy,0,0,0,,Buradan görebiliyoruz!Dialogue: 0,0:16:06.98,0:16:08.78,Main,Luffy,0,0,0,,İğneler kimin umrunda?Dialogue: 0,0:16:08.78,0:16:11.44,Main,Luffy,0,0,0,,Ne dersen de, demir atıyoruz!Dialogue: 0,0:16:11.44,0:16:14.20,Main,Nami,0,0,0,,Mümkün değil! Bundan daha fazla yaklaşamayız!Dialogue: 0,0:16:14.20,0:16:16.87,Main,Nami,0,0,0,,Yani bu bir alev denizi!Dialogue: 0,0:16:18.54,0:16:20.25,Main,Nami,0,0,0,,Seni anlamıyorum!Dialogue: 0,0:16:21.29,0:16:22.29,Main,Robin,0,0,0,,Alev...Dialogue: 0,0:16:22.29,0:16:24.04,Main,Usopp,0,0,0,,Geminin alev alması an meselesi!Dialogue: 0,0:16:24.04,0:16:25.08,Main,Franky,0,0,0,,Hayır!Dialogue: 0,0:16:25.50,0:16:27.84,Main,Franky,0,0,0,,Sunny süper yanmaz!Dialogue: 0,0:16:27.84,0:16:30.63,Main,Nami,0,0,0,,Yanmasa bile, bu denizde bir sorun var!Dialogue: 0,0:16:30.63,0:16:33.38,Main,Nami,0,0,0,,Bak, balıkların sadece kemikleri kalmış! Kemikler! Kemikler!Dialogue: 0,0:16:33.38,0:16:36.05,Main,Brook,0,0,0,,Ne? Beni mi çağırdın?Dialogue: 0,0:16:42.84,0:16:44.85,Main,Luffy,0,0,0,,Bu da ne?Dialogue: 0,0:16:44.85,0:16:46.60,Main,Luffy,0,0,0,,Den Den Mushi ağlıyor.Dialogue: 0,0:16:46.60,0:16:49.27,Main,Luffy,0,0,0,,Sorun ne?! Karnın mı ağrıyor?Dialogue: 0,0:16:49.27,0:16:51.86,Main,Sanji,0,0,0,,Aptal, bu bir acil yardım sinyali.Dialogue: 0,0:16:51.86,0:16:54.03,Main,Sanji,0,0,0,,Birisi yardım için arıyor.Dialogue: 0,0:16:54.03,0:16:55.90,Main,Luffy,0,0,0,,Yani, eğer telefonu açarsam, onlarla iletişim kurabilir miyiz?Dialogue: 0,0:16:55.90,0:17:00.69,Main,Robin,0,0,0,,Bekle, Luffy! Acil durum sinyallerinin yüzde ellisinden azı gerçektir!Dialogue: 0,0:17:00.69,0:17:04.66,Main,Robin,0,0,0,,Denizciler genelde bu tarz tuzak kurarlar,  yani bu onun gibi bir şeydir!Dialogue: 0,0:17:04.66,0:17:08.99,Main,Robin,0,0,0,,Eğer açarsan ve konuşma dinleniyorsa, bizim burada olduğumuzu öğrenirler!Dialogue: 0,0:17:08.99,0:17:11.05,Main,Usopp,0,0,0,,İyi bir nokta, Robin!Dialogue: 0,0:17:11.05,0:17:14.76,Main,Usopp,0,0,0,,Dinle, Luffy, Bunu iyice düşünüp kar-Dialogue: 0,0:17:14.76,0:17:17.59,Main,Luffy,0,0,0,,Merhaba? Ben Monkey D. Luffy!Dialogue: 0,0:17:17.59,0:17:19.71,Main,Luffy,0,0,0,,Korsanlar Kralı olacak olan adamım!Dialogue: 0,0:17:19.71,0:17:21.26,Main,Usopp,0,0,0,,Çok erken cevap verdin ve çok fazla şey söylüyorsun!Dialogue: 0,0:17:22.76,0:17:24.18,Main,Voice,0,0,0,,Lütfen, yardım edin!Dialogue: 0,0:17:24.64,0:17:25.34,Main,Luffy,0,0,0,,Ne oldu?!Dialogue: 0,0:17:26.35,0:17:28.69,Main,Voice,0,0,0,,Donuyoruz... Patron, sen misin?Dialogue: 0,0:17:28.69,0:17:30.65,Main,Luffy,0,0,0,,Hayır, ben patronunuz değilim.Dialogue: 0,0:17:30.65,0:17:31.86,Main,Luffy,0,0,0,,Soğuk mu dedin?Dialogue: 0,0:17:32.40,0:17:36.65,Main,Voice,0,0,0,,Arkadaşlarım kesilmeye devam ediyor.Dialogue: 0,0:17:36.65,0:17:39.41,Main,Voice,0,0,0,,Samuray hepimizi öldürecek!Dialogue: 0,0:17:39.41,0:17:40.49,Main,Zoro,0,0,0,,Samuray mı?Dialogue: 0,0:17:40.49,0:17:42.87,Main,Luffy,0,0,0,,Senin adın ne?! Dialogue: 0,0:17:42.91,0:17:43.70,Main,Luffy,0,0,0,,Neredesin?!Dialogue: 0,0:17:44.75,0:17:47.50,Main,Voice,0,0,0,,Benim kim olduğumun bir önemi yok kurtarın beni.Dialogue: 0,0:17:47.50,0:17:48.46,Main,Voice,0,0,0,,Bulunduğum yer...Dialogue: 0,0:17:49.08,0:17:51.29,Main,Voice,0,0,0,,Punk Hazard! Dialogue: 0,0:17:57.93,0:17:58.93,Main,Usopp & Chopper,0,0,0,,Öldürüldü!Dialogue: 0,0:17:58.93,0:17:59.94,Main,Brook,0,0,0,,Y-yoksa bu...Dialogue: 0,0:18:07.39,0:18:09.43,Main,Luffy,0,0,0,,Tuzak olduğunu düşünüyorum.Dialogue: 0,0:18:09.43,0:18:13.48,Main,Usopp,0,0,0,,Tabii ki tuzak! Az önce öldürüldü!Dialogue: 0,0:18:14.44,0:18:15.64,Main,Chopper,0,0,0,,Yeni Dünya korkutucu!Dialogue: 0,0:18:15.64,0:18:18.45,Main,Robin,0,0,0,,Rol yapıyor, hala tuzak olabilir.Dialogue: 0,0:18:18.45,0:18:21.12,Main,Brook,0,0,0,,Sakinliğini koruyor!Dialogue: 0,0:18:21.12,0:18:23.03,Main,Brook,0,0,0,,Hadi, Robin-san!Dialogue: 0,0:18:24.03,0:18:27.08,Main,Zoro,0,0,0,,Samuray dedi, Brook.Dialogue: 0,0:18:28.13,0:18:30.63,Main,Zoro,0,0,0,,Evet, o samuraylardan biri olmalı...Dialogue: 0,0:18:30.63,0:18:33.80,Main,Zoro,0,0,0,,Wano Krallığının kılıç ustalarının adı olmalı.Dialogue: 0,0:18:33.80,0:18:38.93,Main,Brook,0,0,0,,Wano Krallığını izole edilmiş bir krallık, yani dışarıdan olanların girmesine izin verilmez.Dialogue: 0,0:18:38.93,0:18:41.39,Main,Brook,0,0,0,,Dünya Hükümetiyle hiç bir bağlantısı bile yok.Dialogue: 0,0:18:41.72,0:18:46.85,Main,Brook,0,0,0,,Görünüşe göre samuray denen kılıç ustaları aşırı güçlü oldukları için Denizciler bile onlara yaklaşamıyor.Dialogue: 0,0:18:50.27,0:18:55.98,Flashbacks,Ryuuma,0,0,0,,Shuusui isimli kılıç bir zamanlar efsanevi bir samuray tarafından taşınıyordu.Dialogue: 0,0:18:55.98,0:19:00.86,Flashbacks,Ryuuma,0,0,0,,Eğer onun efendisi olursan kılıç tatmin olacaktır.Dialogue: 0,0:19:11.00,0:19:18.67,Flashbacks,Ryuuma,0,0,0,,Bu samurayın bedeninin düşmesi çok sinir bozucu.Dialogue: 0,0:19:22.97,0:19:25.09,Main,Usopp,0,0,0,,Öyle bir krallık gerçekten var mı?Dialogue: 0,0:19:25.09,0:19:29.10,Main,Franky,0,0,0,,Ama Wano Krallığı değil Punk Hazard olduğunu söyledi.Dialogue: 0,0:19:29.10,0:19:30.77,Main,Franky,0,0,0,,Alevlerle kaplı adayı mı demek istedi?Dialogue: 0,0:19:31.81,0:19:33.98,Main,Robin,0,0,0,,Eğer Bebek Den Den Mushi kullanıyorsa,Dialogue: 0,0:19:33.98,0:19:37.35,Main,Robin,0,0,0,,o zaman menzil içindeki tek ada o olmalı.Dialogue: 0,0:19:37.35,0:19:40.52,Main,Luffy,0,0,0,,Tamamdır! Gidip o adamı kurtaralım!Dialogue: 0,0:19:40.52,0:19:41.57,Main,Nami,0,0,0,,Hayır!Dialogue: 0,0:19:41.57,0:19:43.28,Main,Usopp,0,0,0,,Luffy, biraz düşün!Dialogue: 0,0:19:43.28,0:19:44.57,Main,Usopp,0,0,0,,Çoktan geç kalmış olma ihtimalimiz var!Dialogue: 0,0:19:44.57,0:19:46.45,Main,Chopper,0,0,0,,Samuraylar korkutucu!Dialogue: 0,0:19:46.78,0:19:48.29,Main,Brook,0,0,0,,Ben de korkuyorum!Dialogue: 0,0:19:54.50,0:19:57.17,Main,Voice,0,0,0,,Kim olduğumun önemi yok kurtarın beni.Dialogue: 0,0:19:57.17,0:19:58.84,Main,Voice,0,0,0,,Bulunduğum ada...Dialogue: 0,0:19:58.84,0:20:00.42,Main,Voice,0,0,0,,Punk Hazard! Dialogue: 0,0:20:03.80,0:20:05.25,Main,Tashigi,0,0,0,,Smoker-san, yoksa o...Dialogue: 0,0:20:05.25,0:20:10.06,Main,Smoker,0,0,0,,Kahrolsun! Hangi rotayı izliyorlar?!Dialogue: 0,0:20:11.14,0:20:14.52,Main,Smoker,0,0,0,,İlk önce Balık Adam Adasındaki olay şimdi bu kargaşa...Dialogue: 0,0:20:15.11,0:20:19.02,Main,Smoker,0,0,0,,ve eğer onların rotasını hesaplayacak olursak...Dialogue: 0,0:20:19.61,0:20:23.36,Main,Smoker,0,0,0,,Punk Hazard, ha? Mantıklı.Dialogue: 0,0:20:23.36,0:20:25.65,Main,Pirate,0,0,0,,L-lütfen dur! Her şeyi yaparım!Dialogue: 0,0:20:25.65,0:20:28.54,Main,Pirate,0,0,0,,İstediğin her şeyi yaparım!Dialogue: 0,0:20:29.04,0:20:31.00,Main,Marine,0,0,0,,Yanmanı istiyoruz!Dialogue: 0,0:20:33.54,0:20:34.84,Main,Pirate,0,0,0,,Sıcak!Dialogue: 0,0:20:34.84,0:20:37.79,Main,Tashigi,0,0,0,,Durun, sizi vahşiler! Korsanlara işkence etmeyi bırakın!Dialogue: 0,0:20:38.33,0:20:40.88,Main,Smoker,0,0,0,,Tashigi! Punk Hazard'a doğru ilerliyoruz.Dialogue: 0,0:20:41.21,0:20:43.59,Main,Tashigi,0,0,0,,Ama Smoker-san, Punk Hazard...Dialogue: 0,0:20:44.09,0:20:47.60,Main,Tashigi,0,0,0,,Dört yıl önceki olaydan sonra mühürlendiğinden beri yerleşim yeri yok!Dialogue: 0,0:20:47.96,0:20:49.81,Main,Tashigi,0,0,0,,Orada insanların olması çok mantıksız!Dialogue: 0,0:20:50.77,0:20:56.61,Main,Smoker,0,0,0,,Doğru, herhangi bir varlığın orada yaşaması imkansız olmalı.Dialogue: 0,0:20:56.61,0:20:58.52,Main,Smoker,0,0,0,,Ama ne olursa olsun bakmaya değer.Dialogue: 0,0:20:59.32,0:21:02.74,Main,Smoker,0,0,0,,Punk Hazard'a yelken açıyoruz!Dialogue: 0,0:21:02.74,0:21:05.15,Main,Marine,0,0,0,,Ama Koramiral Smoker...Dialogue: 0,0:21:05.49,0:21:08.07,Main,Marine,0,0,0,,Orası yasak bölge, bunu bilmiyor muydunuz?Dialogue: 0,0:21:08.07,0:21:12.07,Main,Smoker,0,0,0,,Bana kuralları öğretme, pislik!Dialogue: 0,0:21:12.07,0:21:15.00,Main,Marine,0,0,0,,Emredersiniz!Dialogue: 0,0:21:21.25,0:21:23.12,Main,Sanji,0,0,0,,Bu sorunu çözer. Oraya gidecek olanlar...Dialogue: 0,0:21:23.12,0:21:24.55,Main,Zoro,0,0,0,,biziz.Dialogue: 0,0:21:25.47,0:21:27.05,Main,Robin,0,0,0,,Ne kadar heyecan verici.Dialogue: 0,0:21:27.05,0:21:27.50,Main,Usopp,0,0,0,,Ne kadar iç karartıcı.Dialogue: 0,0:21:27.50,0:21:29.85,Main,Sanji,0,0,0,,Kazandın mı? Şanslısın!Dialogue: 0,0:21:29.85,0:21:36.02,Main,Usopp,0,0,0,,Hayır, kaybettim! Biri benimle değiştirsin!Dialogue: 0,0:21:36.02,0:21:39.11,Main,Sanji,0,0,0,,İşte, özel dev kabuklu balık beslenme çantamı al.Dialogue: 0,0:21:40.65,0:21:42.02,Main,Luffy,0,0,0,,Tatmak için sabırsızlanıyorum!Dialogue: 0,0:21:53.16,0:21:56.28,Main,Luffy,0,0,0,,Harika! Buluttan bir yol yaptı!Dialogue: 0,0:21:56.28,0:21:59.46,Main,Luffy,0,0,0,,Sky Island'da kullandıkları şeyleri yapmayı öğrendin mi?Dialogue: 0,0:22:00.59,0:22:03.13,Main,Nami,0,0,0,,Sadece bulut, yani sabitken geçseniz iyi olur.Dialogue: 0,0:22:03.13,0:22:04.26,Main,Luffy,0,0,0,,Anlaşıldı!Dialogue: 0,0:22:10.85,0:22:11.43,Main,Luffy,0,0,0,,Tamamdır!Dialogue: 0,0:22:12.64,0:22:14.52,Main,Luffy,0,0,0,,İşte keşif partisi başlıyor!!Dialogue: 0,0:22:14.52,0:22:15.93,Main,Luffy,0,0,0,,Sana güveniyoruz, Mini Merry!Dialogue: 0,0:22:15.93,0:22:18.77,Main,Chopper,0,0,0,,Hepiniz kendinize iyi bakın!Dialogue: 0,0:22:18.77,0:22:21.06,Main,Franky,0,0,0,,Çubuk çekme konusunda çok şanslısınız!Dialogue: 0,0:22:21.06,0:22:23.19,Main,Sanji,0,0,0,,Daha sonra biz de gidebiliriz.Dialogue: 0,0:22:24.48,0:22:25.36,Main,Brook,0,0,0,,Dikkat edin!Dialogue: 0,0:22:25.36,0:22:27.15,Main,Nami,0,0,0,,Usopp, iyi şanslar!Dialogue: 0,0:22:27.15,0:22:31.07,Main,Usopp,0,0,0,,Benimle yer değişin!Dialogue: 0,0:22:31.07,0:22:32.95,Main,Luffy,0,0,0,,Dev kabuk balığı leziz!Dialogue: 0,0:22:32.95,0:22:35.29,Main,Usopp,0,0,0,,Neden şimdiden yemeye başladın?!Dialogue: 0,0:22:35.29,0:22:39.82,Main,Luffy,0,0,0,,Alevlerin üstüne tırmandık! Eğlenceli!Dialogue: 0,0:22:39.82,0:22:42.00,Main,Luffy,0,0,0,,Şimdi alev denizini geçebiliriz!Dialogue: 0,0:22:42.00,0:22:44.59,Main,Usopp,0,0,0,,Bulutlar biz geri dönene kadar böyle kalabilirler mi?Dialogue: 0,0:22:44.59,0:22:47.04,Main,Luffy,0,0,0,,Yağmurun durması güzel oldu.Dialogue: 0,0:22:47.04,0:22:48.72,Main,Robin,0,0,0,,Keşif için mükemmel hava.Dialogue: 0,0:22:48.72,0:22:49.71,Main,Usopp,0,0,0,,Ama çok sıcak!Dialogue: 0,0:22:49.71,0:22:53.93,Main,Brook,0,0,0,,Nami-san, o bulut adaya kadar ulaşıyor mu?Dialogue: 0,0:22:53.93,0:22:55.60,Main,Nami,0,0,0,,Bilmiyorum.Dialogue: 0,0:22:56.64,0:23:00.27,Main,Chopper,0,0,0,,Luffy'e eşlik etmediğim için çok mutluyum.Dialogue: 0,0:23:00.27,0:23:01.85,Main,Chopper,0,0,0,,Sıcağa dayanamam!Dialogue: 0,0:23:01.85,0:23:05.07,Main,Nami,0,0,0,,Sonuçta onun yalnız gitmesine izin veremezdim..Dialogue: 0,0:23:05.07,0:23:07.99,Main,Nami,0,0,0,,Orada hiçbir şey olmadığını gördüklerinde geri gelecekler!Dialogue: 0,0:23:07.99,0:23:10.61,Main,Franky,0,0,0,,Bunu iyice düşündün, öyle değil mi?Dialogue: 0,0:23:10.61,0:23:15.62,Main,Sanji,0,0,0,,Şimdi nazik Nami-san'ımız için dev kabuklu balıktan soğuk bir tatlı yapacağım!Dialogue: 0,0:23:15.62,0:23:17.24,Main,Franky & Brook,0,0,0,,Oley!Dialogue: 0,0:23:17.24,0:23:20.50,Main,Luffy,0,0,0,,Gördün mü? Girişi kesinlikle burası!Dialogue: 0,0:23:20.50,0:23:24.59,Main,Usopp,0,0,0,,Şimdi dinleyin, daha önce insanlar burada yaşıyor olabilir...Dialogue: 0,0:23:24.59,0:23:26.96,Main,Usopp,0,0,0,,ama artık burada yaşıyor olma ihtimali yok!Dialogue: 0,0:23:26.96,0:23:31.55,Main,Usopp,0,0,0,,Den Den Mushi uzak bir adadan sinyal almış olmalı!Dialogue: 0,0:23:31.55,0:23:33.01,Main,Usopp,0,0,0,,Öyle değil mi, Robin?Dialogue: 0,0:23:33.26,0:23:36.06,Main,Robin,0,0,0,,Güzel gözükmüyor ama şaşırtıcı derecede leziz.Dialogue: 0,0:23:36.06,0:23:38.89,Main,Usopp,0,0,0,,Sen de mi?! Neden şimdi yiyorsun?!Dialogue: 0,0:23:38.89,0:23:40.31,Main,Zoro,0,0,0,,Sen yemeyecek misin?Dialogue: 0,0:23:40.31,0:23:41.93,Main,Usopp,0,0,0,,Şu an hiçbir şey yutamam!Dialogue: 0,0:23:41.93,0:23:47.64,Main,Usopp,0,0,0,,İki yıl önceki hastalığım beklenmedik bir şekilde nüksetmeye başladı!Dialogue: 0,0:23:47.64,0:23:52.32,Main,Usopp,0,0,0,,Aslında... Gerçekten, "O adaya giremem" hastalığına yakalandım!Dialogue: 0,0:23:52.32,0:23:54.82,Main,Zoro & Robin & Luffy,0,0,0,,Biliyorum.Dialogue: 0,0:23:58.04,0:24:01.96,Main,Robin,0,0,0,,Buna hiç şüphe yok. Burası doğru yer.Dialogue: 0,0:24:01.96,0:24:04.63,Main,Usopp,0,0,0,,Yani burası Punk Hazard mı?Dialogue: 0,0:24:06.09,0:24:08.76,Main,Luffy,0,0,0,,Hadi Merry'i adaya yaklaştıralım.Dialogue: 0,0:24:09.55,0:24:13.46,Main,Zoro,0,0,0,,Yani acil durum sinyali buradan mı geldi?Dialogue: 0,0:24:13.46,0:24:17.17,Main,Robin,0,0,0,,Görünüşe göre bu adaya girmek yasak.Dialogue: 0,0:24:17.17,0:24:19.10,Main,Usopp,0,0,0,,Luffy, şuna bak!Dialogue: 0,0:24:20.85,0:24:24.36,Main,Luffy,0,0,0,,Tehlikeli... Uzak durun?Dialogue: 0,0:24:24.36,0:24:28.40,Main,Usopp,0,0,0,,Gördün mü? Dünya Hükümetinin ve Denizcilerin işareti var!Dialogue: 0,0:24:28.65,0:24:32.53,Main,Usopp,0,0,0,,Yani, içeride birisi olsa bile, Hükümetin tarafında olacaktır!Dialogue: 0,0:24:32.53,0:24:35.20,Main,Usopp,0,0,0,,Bu zaman kaybıydı. Hadi geri dönelim!Dialogue: 0,0:24:39.08,0:24:42.75,Main,Luffy,0,0,0,,Çok sıcak.Dialogue: 0,0:24:45.03,0:24:49.13,Main,Usopp,0,0,0,,Millet! Bildiğiniz üzere izinsiz girmek suçtur!Dialogue: 0,0:24:49.38,0:24:53.22,Main,Usopp,0,0,0,,Doğru, korsanlar suçludur.Dialogue: 0,0:24:53.22,0:24:57.18,Main,Usopp,0,0,0,,Dünya Hükümetiyle savaşa girerseniz beni suçlamayın!Dialogue: 0,0:24:57.18,0:24:58.85,Main,Usopp,0,0,0,,Doğru, bunu çoktan yaptık.Dialogue: 0,0:25:00.85,0:25:03.27,Main,Usopp,0,0,0,,B-bekleyin!Dialogue: 0,0:25:03.98,0:25:08.40,Main,Luffy,0,0,0,,Çok sıcak... Aman, neyse...Dialogue: 0,0:25:09.82,0:25:11.73,Main,Zoro,0,0,0,,Bütün bu yer alev içinde.Dialogue: 0,0:25:12.53,0:25:15.95,Main,Robin,0,0,0,,Her zaman alevlerle kaplı bir ada gibi gözükmüyor.Dialogue: 0,0:25:16.70,0:25:19.07,Main,Robin,0,0,0,,Bir tür felaket mi oldu? Yoksa bir kaza mı?Dialogue: 0,0:25:19.41,0:25:22.04,Main,Usopp,0,0,0,,Luffy!Dialogue: 0,0:25:30.63,0:25:33.55,Main,Robin,0,0,0,,Bunlar muhtemelen insanların evleri değildi.Dialogue: 0,0:25:34.42,0:25:37.55,Main,Robin,0,0,0,,Burası eskiden bir devlet tesisi olmalı.Dialogue: 0,0:25:39.30,0:25:44.06,Main,Zoro,0,0,0,,Peki burası alev alıp çok tehlikeli hale geldikten sonra mı kapatıldı?Dialogue: 0,0:25:45.02,0:25:48.69,Main,Zoro,0,0,0,,Yoksa başlangıçta tehlikeli bir tesis miydi?Dialogue: 0,0:25:48.69,0:25:53.61,Main,Robin,0,0,0,,Seyir Pusulasının bu adaya işaret etmemesi beni rahatsız ediyor.Dialogue: 0,0:25:53.61,0:25:55.81,Main,Luffy,0,0,0,,Dialogue: 0,0:25:55.81,0:25:58.69,Main,Luffy,0,0,0,,Önceki adam, burada mısın?!Dialogue: 0,0:25:59.16,0:26:02.58,Main,Luffy,0,0,0,,Seni kurtarmak için geldik!Dialogue: 0,0:26:07.45,0:26:09.38,Main,Luffy,0,0,0,,Dialogue: 0,0:26:09.38,0:26:11.54,Main,Luffy,0,0,0,,Dışarıya çık!Dialogue: 0,0:26:11.54,0:26:13.63,Main,Luffy,0,0,0,,Samuray!Dialogue: 0,0:26:13.63,0:26:15.05,Main,Usopp,0,0,0,,Katili çağırma!Dialogue: 0,0:26:15.92,0:26:17.43,Main,Zoro,0,0,0,,İştahın geri geldi mi?Dialogue: 0,0:26:17.43,0:26:18.59,Main,Usopp,0,0,0,,Kapa çeneni! Acılarımı boğuyorum!Dialogue: 0,0:26:24.10,0:26:26.05,Main,Usopp,0,0,0,,Bu bir süredir beni rahatsız ediyor...Dialogue: 0,0:26:26.35,0:26:30.02,Main,Usopp,0,0,0,,Den Den Mushi'deki adam donduğunu söyledi, değil mi?Dialogue: 0,0:26:31.19,0:26:33.47,Flashbacks,Voice,0,0,0,,Donuyorum... patron sen misin?Dialogue: 0,0:26:33.47,0:26:37.74,Main,Luffy,0,0,0,,İyi bir noktaya değindin. Burası çok sıcak ama o soğuk olduğunu söylüyordu.Dialogue: 0,0:26:37.74,0:26:39.61,Main,Luffy,0,0,0,,Belki de aptaldır?Dialogue: 0,0:26:39.61,0:26:40.57,Main,Usopp,0,0,0,,Bu ne tür bir sebep?!Dialogue: 0,0:26:41.32,0:26:44.24,Main,Robin,0,0,0,,Bu alevlerle kaplı olan adada soğuk bir yer olabilir mi?Dialogue: 0,0:26:44.24,0:26:47.50,Main,Robin,0,0,0,,Yoksa çok korktuğu için üşüdüğünü mü kastetmişti?Dialogue: 0,0:26:47.50,0:26:49.37,Main,Franky,0,0,0,,Nami, kötü bir şey mi oldu?Dialogue: 0,0:26:51.13,0:26:53.21,Main,Nami,0,0,0,,Yani, bulutlar...Dialogue: 0,0:26:56.01,0:26:59.43,Main,Nami,0,0,0,,Şimdi daha yakından baktığımda bu adanın üzerindeki gökyüzü gerçekten tuhaf görünüyor.Dialogue: 0,0:26:59.43,0:27:02.35,Main,Nami,0,0,0,,Uzak tarafta neredeyse arktik görünüyor.Dialogue: 0,0:27:03.97,0:27:05.14,Main,Franky,0,0,0,,Bu imkansız!Dialogue: 0,0:27:10.27,0:27:11.44,Main,Usopp,0,0,0,,Dev!Dialogue: 0,0:27:11.44,0:27:13.11,Main,Luffy,0,0,0,,Hayır.Dialogue: 0,0:27:13.48,0:27:15.40,Main,Luffy,0,0,0,,Bu devden çok daha büyük!Dialogue: 0,0:27:21.91,0:27:23.28,Main,Robin,0,0,0,,Yoksa bu...Dialogue: 0,0:27:32.79,0:27:36.71,Main,Luffy,0,0,0,,N-ne?! B-bunlar gerçekten var mı?!Dialogue: 0,0:27:37.41,0:27:43.43,Main,Zoro,0,0,0,,Hayır, onlar hayali yaratıklar! Nasıl gerçekten var olabilirler?!Dialogue: 0,0:27:43.43,0:27:45.51,Main,Robin,0,0,0,,Ama şuna bak!Dialogue: 0,0:27:46.66,0:27:48.43,Main,Robin,0,0,0,,Buna başka ne diyebilirsin?Dialogue: 0,0:28:13.96,0:28:15.16,Main,Group,0,0,0,,Ejderha mı?!