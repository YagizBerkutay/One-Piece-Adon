Dialogue: 0,0:02:29.90,0:02:38.66,Title,,0,0,0,,{\fad(2000,2000)}G-5'in Fedakarlığı ve\NKoramiralin İhaneti!
Dialogue: 0,0:02:41.85,0:02:43.40,Main,Caesar,0,0,0,,Ne olmuş böyle?
Dialogue: 0,0:02:43.40,0:02:45.86,Main,Caesar,0,0,0,,Ne anlama geliyor bu?
Dialogue: 0,0:02:45.86,0:02:49.19,Main,Caesar,0,0,0,,Girişte neden hiç\NG-5 askeri göremiyorum?
Dialogue: 0,0:02:49.67,0:02:53.31,Main,Caesar,0,0,0,,Neden hiç katılaşmış ceset yok?
Dialogue: 0,0:02:53.31,0:02:56.89,Main,Caesar,0,0,0,,Onlar olmazsa\NShinokuni'nin gücünü kanıtlayamam ki!
Dialogue: 0,0:02:57.38,0:03:01.83,Main,Caesar,0,0,0,,Hasır Şapka'lar, Law ve Smoker\Ngerçekten öldüler mi acaba?!
Dialogue: 0,0:03:01.83,0:03:03.48,Main,Monet,0,0,0,,Ne düşünüyorsun Vergo?
Dialogue: 0,0:03:03.73,0:03:05.75,Main,Vergo,0,0,0,,Kesin olan tek bir şey var.
Dialogue: 0,0:03:05.75,0:03:09.45,Main,Vergo,0,0,0,,Artık kafesin içinde değiller.
Dialogue: 0,0:03:09.45,0:03:13.13,Main,Vergo,0,0,0,,G-5 denizcilerimin hepsi bir\Ngrup şiddet yanlısı aptal.
Dialogue: 0,0:03:13.13,0:03:19.15,Main,Vergo,0,0,0,,Kendi başlarına\No gazdan kaçabilecek kadar zeki değiller.
Dialogue: 0,0:03:19.61,0:03:26.03,Main,Vergo,0,0,0,,Yani Hasır Şapka'lar kafesten kaçıp G-5\Naskerlerine kaçmaları için yardım ettiler.
Dialogue: 0,0:03:26.28,0:03:28.23,Main,Caesar,0,0,0,,Ne dedin?!
Dialogue: 0,0:03:31.37,0:03:32.57,Main,Soldier,0,0,0,,Master!
Dialogue: 0,0:03:35.28,0:03:36.38,Main,Caesar,0,0,0,,Ne oldu?
Dialogue: 0,0:03:36.96,0:03:40.49,Main,Soldier,0,0,0,,Korsan Hasır Şapka'nın liderliğinde,\Nbütün düşmanlar...
Dialogue: 0,0:03:40.49,0:03:47.18,Main,Soldier,0,0,0,,...A binasının salonuna giriş yaptılar\Nve daha da içeriye doğru ilerliyorlar!
Dialogue: 0,0:03:47.18,0:03:51.39,Main,Caesar,0,0,0,,Ne?! İçeri mi girdiler?!
Dialogue: 0,0:03:51.68,0:03:55.50,Main,Caesar,0,0,0,,O taş gibi kepenkten nasıl geçebildiler!?
Dialogue: 0,0:03:55.50,0:03:57.44,Main,Caesar,0,0,0,,Kafesten nasıl kaçtılar?!
Dialogue: 0,0:03:57.44,0:03:59.49,Main,Soldier,0,0,0,,Henüz bilmiyoruz!
Dialogue: 0,0:03:59.49,0:04:03.32,Main,Vergo,0,0,0,,Her halükarda Law'ın\Nserbest dolaşmasına izin veremeyiz.
Dialogue: 0,0:04:04.02,0:04:08.59,Main,Vergo,0,0,0,,Buradaki amacına bağlı olarak\Nonu kendim öldürmek zorunda kalabilirim.
Dialogue: 0,0:04:08.80,0:04:15.66,Main,Soldier,0,0,0,,Görünüşe göre hem Hasır Şapka mürettebatı\Nhem de denizciler kaçış geçidine doğru gidiyor!
Dialogue: 0,0:04:15.66,0:04:17.27,Main,Caesar,0,0,0,,Ne yapmalıyım!?
Dialogue: 0,0:04:18.56,0:04:21.40,Thoughts,Chopper,0,0,0,,Herkes iyi gibi!\NŞükürler olsun!
Dialogue: 0,0:04:23.18,0:04:25.56,Thoughts,Chopper,0,0,0,,Bu kağıdı bana\Nkim yolladı bilmiyorum ama...
Dialogue: 0,0:04:25.56,0:04:30.57,Thoughts,Chopper,0,0,0,,...acaba bu kağıt Luffy'lerin kafesten\Nkaçabileceği anlamına mı geliyordu?!
Dialogue: 0,0:04:30.57,0:04:34.46,Thoughts,Chopper,0,0,0,,İlacın içeriğini öğrendim ve\Nartık sakinleştiricilerim de var.
Dialogue: 0,0:04:35.44,0:04:38.34,Thoughts,Chopper,0,0,0,,İyi güzel de,\Nne taraftan gideceğim?!
Dialogue: 0,0:04:39.43,0:04:41.42,Main,Caesar,0,0,0,,Askerlerim ne yapıyorlar?
Dialogue: 0,0:04:41.42,0:04:44.75,Main,Soldier,0,0,0,,A Binasındakiler saldırıya\Nkarşılık veriyor!
Dialogue: 0,0:04:44.75,0:04:49.84,Main,Soldier,0,0,0,,Ana birlik, Bina-B'nin arka tarafında\Nsavaş hazırlıkları yapıyor!
Dialogue: 0,0:04:49.84,0:04:53.80,Main,Caesar,0,0,0,,Amaçlarının adadan kaçmak olduğuna\Nkalıbımı basarım.
Dialogue: 0,0:04:53.80,0:05:00.36,Main,Caesar,0,0,0,,Bu durumda R Binası 66 numaralı\Nkapıya doğru düz bir yol izleyeceklerdir!
Dialogue: 0,0:05:01.69,0:05:08.11,Main,Caesar,0,0,0,,İşte buna izin vermem!\NA ve B binaları arasındaki geçidi kapatın!
Dialogue: 0,0:05:08.87,0:05:12.05,Main,Caesar,0,0,0,,Böylece A binasını\Ntamamen izole etmiş olacağız!
Dialogue: 0,0:05:14.48,0:05:20.81,Main,Caesar,0,0,0,,Sonra da A binasını yok edip\Ngerisini Shinokuni'ye bırakın!
Dialogue: 0,0:05:20.81,0:05:24.96,Main,Soldier,0,0,0,,Ama böyle bir şey yapacak olursanız\Nmuhafızlarımız da onlarla birlikte...
Dialogue: 0,0:05:24.96,0:05:27.03,Main,Caesar,0,0,0,,Orasını boşver, sadece dediğimi yap!
Dialogue: 0,0:05:27.03,0:05:29.68,Main,Caesar,0,0,0,,Gözetleme Den Den Mushisi\Nkoymayı da unutmayın!
Dialogue: 0,0:05:29.68,0:05:32.54,Main,Soldier,0,0,0,,Ama Master...
Dialogue: 0,0:05:32.54,0:05:37.02,Main,Caesar,0,0,0,,Simsarlarımızın deneyi doğru şekilde görebilmesi\Niçin deneyin yeni bir başlangıca ihtiyacı var.
Dialogue: 0,0:05:37.02,0:05:40.98,Main,Caesar,0,0,0,,Henüz bilimsel dehamın\Ngerçek boyutunu görmediler!
Dialogue: 0,0:05:42.77,0:05:45.35,Main,Caesar,0,0,0,,Ne yapacaksın Vergo?
Dialogue: 0,0:05:45.70,0:05:49.74,Main,Vergo,0,0,0,,Böyle bir tuzağa\Nyalnızca aptallar düşer.
Dialogue: 0,0:05:49.74,0:05:55.64,Main,Vergo,0,0,0,,Law ve Smoker yakalanmazsa kaybedecek\Nbir şeyi olan tek kişi sen değilsin Caesar.
Dialogue: 0,0:05:55.64,0:06:00.54,Main,Vergo,0,0,0,,Bu işi sadece sana bırakamam.\NHer birini keseceğim.
Dialogue: 0,0:06:01.06,0:06:04.30,Main,Vergo,0,0,0,,Tuhaf, kılıcımı bulamıyorum.
Dialogue: 0,0:06:04.30,0:06:07.21,Main,Monet,0,0,0,,Sen bir kılıç ustası değilsin, değil mi?
Dialogue: 0,0:06:07.57,0:06:10.72,Main,Vergo,0,0,0,,Sahi ya, kılıç ustası değildim.
Dialogue: 0,0:06:10.72,0:06:14.49,Main,Vergo,0,0,0,,O zaman gidip o küçük piçleri ezeceğim.
Dialogue: 0,0:06:14.49,0:06:18.00,Captions,Sign,0,0,180,,Laboratuvar A Binası
Dialogue: 0,0:06:15.88,0:06:18.56,Main,Run,0,0,0,,{\an8}Buradan geçemezsin Hasır Şapka!
Dialogue: 0,0:06:21.88,0:06:27.45,Main,Run,0,0,0,,B binası muhafızı,\Neski korsan Machete Run'um ben!
Dialogue: 0,0:06:27.45,0:06:30.84,Main,Run,0,0,0,,Aşk bilimcisi\NMaster Caesar adına!
Dialogue: 0,0:06:30.84,0:06:34.63,Main,Luffy,0,0,0,,Hayvan bacakların yok senin!\NZerre ilgimi çekmedin!
Dialogue: 0,0:06:35.66,0:06:37.86,Main,Luffy,0,0,0,,Ne tür bir sentorsun sen?!
Dialogue: 0,0:06:38.27,0:06:41.85,Main,Run,0,0,0,,Örümceğim.
Dialogue: 0,0:06:44.31,0:06:46.36,Main,Luffy,0,0,0,,Çekilin yolumdan!
Dialogue: 0,0:06:50.09,0:06:52.65,Captions,Sign,0,0,180,,{\fad(500,0)}A ve B Binaları Arasındaki Geçit
Dialogue: 0,0:06:50.09,0:06:52.65,Main,Luffy,0,0,0,,{\an8}Amma devasa bir tünelmiş!
Dialogue: 0,0:06:56.94,0:07:00.13,Main,Smoker,0,0,0,,Law, bu alarm ne için çalıyor?
Dialogue: 0,0:07:00.13,0:07:06.83,Main,Law,0,0,0,,Bu binadaki kapının kapanacağını haber\Nveriyor ve B binasına giden tek yol da o.
Dialogue: 0,0:07:06.83,0:07:08.00,Main,Smoker,0,0,0,,Ne dedin?!
Dialogue: 0,0:07:08.25,0:07:10.71,Main,Law,0,0,0,,Bizi uzak tutmaya çalışıyor.
Dialogue: 0,0:07:10.71,0:07:14.22,Main,Law,0,0,0,,Adamlarına acele etmelerini söylesen\Niyi edersin.
Dialogue: 0,0:07:15.11,0:07:19.70,Main,Marine,0,0,0,,Trafalgar Law "iki saat veriyorum" derken\Nne kastetti bilmiyoruz...
Dialogue: 0,0:07:19.70,0:07:24.41,Main,Marine,0,0,0,,...ama öylece kaçmanıza da\Nizin veremeyiz Hasır Şapka tayfası!
Dialogue: 0,0:07:24.41,0:07:25.78,Main,Zoro,0,0,0,,Denemeyin bile!
Dialogue: 0,0:07:25.78,0:07:27.35,Main,Zoro,0,0,0,,Yolumuzdan çekilin!
Dialogue: 0,0:07:29.62,0:07:30.84,Main,Marine,0,0,0,,Yandım!
Dialogue: 0,0:07:32.28,0:07:33.13,Main,Marine,0,0,0,,Dondum!
Dialogue: 0,0:07:36.67,0:07:39.10,Main,Usopp,0,0,0,,Güzel! Üç güvenilir kılıç ustası!
Dialogue: 0,0:07:41.45,0:07:43.97,Main,Sanji,0,0,0,,Kusurumuza bakma Kahverengisakal,\Nkendimizi sana taşıtıyoruz.
Dialogue: 0,0:07:44.42,0:07:50.45,Main,Brownbeard,0,0,0,,Lafı olmaz da \Nsiz ejderhayı niye getirdiniz?
Dialogue: 0,0:07:50.45,0:07:54.52,Main,Sanji,0,0,0,,Onu yakalarsak gazdan uçarak\Nkaçarız diye düşünmüştük...
Dialogue: 0,0:07:55.26,0:07:57.46,Main,Sanji,0,0,0,,...ama bir metre bile havalanamadı.
Dialogue: 0,0:07:57.46,0:08:02.31,Main,Brownbeard,0,0,0,,Sakinleştiricilerin etkisinde olduğundan\Nuçamıyor.
Dialogue: 0,0:08:02.31,0:08:08.28,Main,Brownbeard,0,0,0,,Ancak onu laboratuvarın içine almak\Npek mantıklı bir karar olmayabilir.
Dialogue: 0,0:08:08.28,0:08:11.71,Main,Nami,0,0,0,,Tehlikeli mi ki?\NPek de şirin görünüyor.
Dialogue: 0,0:08:15.71,0:08:19.98,Main,Marine,0,0,0,,Böyle şans elimize bir daha geçmez!\NYakalayın onları!
Dialogue: 0,0:08:19.98,0:08:22.06,Main,Marine,0,0,0,,Tüm övgüyü biz alacağız!
Dialogue: 0,0:08:22.06,0:08:24.84,Main,Zoro,0,0,0,,Sizi bu konuda uyardığıma eminim!
Dialogue: 0,0:08:26.19,0:08:28.01,Main,Marine,0,0,0,,Albay-chan!?
Dialogue: 0,0:08:28.01,0:08:32.13,Main,Zoro,0,0,0,,Albay oldun demek,\Ntaklitçi kadın seni!?
Dialogue: 0,0:08:32.13,0:08:34.54,Main,Zoro,0,0,0,,Gerçi dövüşmeye niyetin\Nyok gibi görünüyor.
Dialogue: 0,0:08:37.20,0:08:39.28,Main,Tashigi,0,0,0,,Aynen, önden gidin.
Dialogue: 0,0:08:40.53,0:08:46.77,Main,Tashigi,0,0,0,,G-5! Şimdi savaşacak vakit değil!\NHemen arka taraftaki geçide gidin!
Dialogue: 0,0:08:47.94,0:08:57.42,Main,Tashigi,0,0,0,,Bu binadaki tek kapıyı kapatıyorlar.\NCaesar bizi buraya hapsetmeye çalışıyor.
Dialogue: 0,0:08:57.59,0:09:03.71,Main,Tashigi,0,0,0,,Kapının öte yanına geçemezsek\NPunk Hazard'dan kaçamayacağız! Gidin hadi!
Dialogue: 0,0:09:03.71,0:09:09.15,Main,Marine,0,0,0,,İş-İşte bu fena oldu! Acele edin beyler!\NTashigi-chan'ı duydunuz!
Dialogue: 0,0:09:09.15,0:09:10.76,Main,Marine,0,0,0,,Yaralıları sırtlanın!
Dialogue: 0,0:09:10.76,0:09:13.98,Main,Marine,0,0,0,,Dümdüz doğruca kapıya!
Dialogue: 0,0:09:16.88,0:09:18.24,Main,Robin,0,0,0,,Ne kadar korkunç bir şey.
Dialogue: 0,0:09:19.76,0:09:21.46,Main,Usopp,0,0,0,,Robin, sen nerelerdeydin?
Dialogue: 0,0:09:21.46,0:09:22.85,Main,Sanji,0,0,0,,Robin-chan!
Dialogue: 0,0:09:24.31,0:09:26.52,Main,Robin,0,0,0,,Luffy benden ufak\Nbir şey istemişti.
Dialogue: 0,0:09:26.88,0:09:33.21,Main,Nami,0,0,0,,Neyse işte, donanmadaki kızın dediğini duydunuz\Ndeğil mi? Acele et Kahverengisakal! Daha hızlı!
Dialogue: 0,0:09:33.55,0:09:37.36,Main,Brownbeard,0,0,0,,İmkansız, bu zaten benim en hızlı halim!
Dialogue: 0,0:09:38.06,0:09:40.23,Main,Kin'emon,0,0,0,,Koşmaktan o kadar sıkıldım ki...
Dialogue: 0,0:09:40.23,0:09:41.82,Main,Zoro,0,0,0,,Ne oldu, söylenmeye mi başladın?
Dialogue: 0,0:09:41.82,0:09:42.59,Main,Kin'emon,0,0,0,,Asla!
Dialogue: 0,0:09:43.02,0:09:46.51,Main,Brook,0,0,0,,Ben samuray değilim,\No yüzden söyleyeceğim!
Dialogue: 0,0:09:46.51,0:09:48.56,Main,Brook,0,0,0,,Yetti ama artık ya!
Dialogue: 0,0:09:49.26,0:09:53.00,Main,Soldier,0,0,0,,Kahverengisakal neden\Nkorsanlarla birlikte?!
Dialogue: 0,0:09:53.00,0:09:56.61,Main,Soldier,0,0,0,,Adi herif Master'a ihanet mi ediyor?!
Dialogue: 0,0:09:56.61,0:09:58.68,Main,Soldier,0,0,0,,Büyük kurtarıcımıza!
Dialogue: 0,0:09:58.68,0:10:02.51,Main,Soldier,0,0,0,,Acele edin siz!\NBizim de başımız dertte!
Dialogue: 0,0:10:02.51,0:10:04.42,Main,Marine,0,0,0,,G-5, acele et!
Dialogue: 0,0:10:04.76,0:10:06.70,Main,Marine,0,0,0,,Gerçekten kapanmak üzere!
Dialogue: 0,0:10:06.70,0:10:08.82,Main,Marine,0,0,0,,Acele edin, acele edin!
Dialogue: 0,0:10:09.32,0:10:11.62,Main,Soldier,0,0,0,,Deney topu, beklemede!
Dialogue: 0,0:10:12.49,0:10:15.05,Captions,Sign,0,0,180,,{\fad(500,0)}Laboratuvarın Dışı
Dialogue: 0,0:10:15.40,0:10:19.33,Main,Soldier,0,0,0,,Hedef, Üçüncü Laboratuvar A Binasının\Ndış duvarı olarak belirlendi!
Dialogue: 0,0:10:24.33,0:10:26.29,Main,Marine,0,0,0,,Duvar mı yıkıldı!?
Dialogue: 0,0:10:26.29,0:10:28.49,Main,Marine,0,0,0,,Cidden mi!?
Dialogue: 0,0:10:31.10,0:10:32.96,Main,Marine,0,0,0,,Şaka mı bu?!
Dialogue: 0,0:10:36.50,0:10:38.42,Main,Marine,0,0,0,,Kaçın! Kaçın!
Dialogue: 0,0:10:42.78,0:10:44.29,Main,Zoro,0,0,0,,Kapayın çenenizi!
Dialogue: 0,0:10:48.63,0:10:49.54,Main,Marine,0,0,0,,Yardım et!
Dialogue: 0,0:10:49.54,0:10:50.13,Main,Marine,0,0,0,,
Dialogue: 0,0:10:57.33,0:10:59.00,Main,Marine,0,0,0,,İçeri girin!
Dialogue: 0,0:10:59.30,0:11:02.33,Main,Marine,0,0,0,,Yetişemezseniz öleceksiniz!
Dialogue: 0,0:11:15.80,0:11:17.53,Main,Brownbeard,0,0,0,,Tamamdır, başardık!
Dialogue: 0,0:11:17.74,0:11:19.75,Main,Kin'emon,0,0,0,,Başardık!
Dialogue: 0,0:11:19.75,0:11:20.94,Main,Brook,0,0,0,,Ucu ucuna!
Dialogue: 0,0:11:24.16,0:11:27.12,Main,Marine,0,0,0,,Ne!? Albay-chan uçarak geldi!
Dialogue: 0,0:11:27.12,0:11:30.38,Main,Marine,0,0,0,,Şükürler olsun da nasıl uçtu o öyle...
Dialogue: 0,0:11:30.38,0:11:34.15,Main,Tashigi,0,0,0,,Çekilin önümden!\NDışarıda hâlâ askerlerimiz var!
Dialogue: 0,0:11:34.15,0:11:36.06,Main,Marine,0,0,0,,Olmaz! Öbür taraf çoktan gazla doldu bile!
Dialogue: 0,0:11:36.06,0:11:39.34,Main,Tashigi,0,0,0,,Çekilin! Acele etmezsek kapı...
Dialogue: 0,0:11:36.76,0:11:38.33,Secondary,Marine,0,0,0,,Yapmamalısınız!
Dialogue: 0,0:11:39.34,0:11:45.72,Main,Tashigi,0,0,0,,Bırakın beni! Hâlâ oradalar!\NGitmeme izin verin!
Dialogue: 0,0:11:42.25,0:11:45.72,Secondary,Marine,0,0,0,,Kapı neredeyse kapandı bile!
Dialogue: 0,0:11:45.72,0:11:50.88,Main,Tashigi,0,0,0,,Smoker-san onları bana emanet etti!\NHepsini koruyacağım!
Dialogue: 0,0:11:50.88,0:11:52.84,Main,Tashigi,0,0,0,,Şimdi lütfen kenara çekilin!
Dialogue: 0,0:11:52.84,0:11:56.87,Main,Marine,0,0,0,,Olmaz Albay-chan, artık çok geç!
Dialogue: 0,0:11:57.15,0:12:04.33,Main,Marine,0,0,0,,Aferin çocuklar! Değerli albayımızı\Nsağ salim bu tarafa aldık!
Dialogue: 0,0:12:25.94,0:12:30.35,Main,Caesar,0,0,0,,Beş para etmezler!\NÇoğu hayatta kalmış gibi görünüyor!
Dialogue: 0,0:12:30.35,0:12:34.69,Main,Caesar,0,0,0,,Ama elbette hiçbirinin\Nkaçmasına izin vermeyeceğim!
Dialogue: 0,0:12:38.20,0:12:42.29,Captions,,0,0,180,,{\fad(500,0)}A ve B Binaları Arasındaki Geçit
Dialogue: 0,0:12:43.08,0:12:46.99,Main,Robin,0,0,0,,Gazın içeri girmesi için kendi\Nlaboratuvarını feda ettiğine inanamıyorum.
Dialogue: 0,0:12:49.39,0:12:51.40,Main,Zoro,0,0,0,,Biraz daha hızlı gitsene!
Dialogue: 0,0:12:51.40,0:12:57.82,Main,Brownbeard,0,0,0,,Siz çocuklar ne ara üzerime atladınız?\NResmen taş taşıyorum!
Dialogue: 0,0:12:58.51,0:13:03.44,Main,Zoro,0,0,0,,Gerçekten üzgünüm ama dayanmak\Nzorundasın. Başka şansımız yok.
Dialogue: 0,0:13:05.63,0:13:07.32,Main,Zoro,0,0,0,,Biz...
Dialogue: 0,0:13:07.32,0:13:10.18,Main,Zoro,0,0,0,,...çok yorulduk\Nve koşmak istemiyoruz!
Dialogue: 0,0:13:10.18,0:13:13.74,Main,Brownbeard,0,0,0,,Böyle neden mi olurmuş be?!\Nİnin üstümden!
Dialogue: 0,0:13:13.99,0:13:16.81,Main,Kin'emon,0,0,0,,Adınız Kahverengisakal-dono idi, değil mi?
Dialogue: 0,0:13:18.52,0:13:25.34,Main,Kin'emon,0,0,0,,Özür dilerim ama en kısa sürede\Noğlum Momonosuke'yi kurtarmak istiyorum!
Dialogue: 0,0:13:25.34,0:13:30.61,Main,Kin'emon,0,0,0,,Ancak bugün çok koştuğumdan,\Nkoşmak ölüm gibi geliyor artık!
Dialogue: 0,0:13:30.61,0:13:32.85,Main,Brownbeard,0,0,0,,İnin üstümden be aptallar!
Dialogue: 0,0:13:33.19,0:13:36.58,Main,Zoro,0,0,0,,İçerisi mont giymek için\Nçok sıcak.
Dialogue: 0,0:13:36.90,0:13:38.51,Main,Usopp,0,0,0,,Şuraya asabilirsin.
Dialogue: 0,0:13:38.51,0:13:43.99,Main,Brownbeard,0,0,0,,Sırtımda kendinizi evinizdeymiş gibi hissetmeyin!\NYaralı değilseniz kendiniz koşun!
Dialogue: 0,0:13:44.29,0:13:46.44,Main,Brook,0,0,0,,Biraz acıktığımı hissediyorum.
Dialogue: 0,0:13:46.44,0:13:49.52,Main,Kin'emon,0,0,0,,Bir samuray olarak acıkmam ben.
Dialogue: 0,0:13:49.52,0:13:52.89,Main,Brook,0,0,0,,Kahverengisakal-san,\Nyiyecek bir şeyleriniz var mı?
Dialogue: 0,0:13:52.89,0:13:59.82,Main,Brownbeard,0,0,0,,Kapayın çenenizi! Askerlerin nöbet yerine\Nvardığımızda hepinizi fırlatıp atacağım üzerimden!
Dialogue: 0,0:14:00.48,0:14:02.35,Captions,,0,0,180,,{\fad(500,0)}A ve B Binaları Arasındaki Geçit
Dialogue: 0,0:14:02.35,0:14:04.51,Main,Marine,0,0,0,,Albay-chan, gitmemiz lazım!
Dialogue: 0,0:14:04.51,0:14:09.00,Main,Marine,0,0,0,,Punk Hazard'ın kapatıldığını sanıyorduk ama\Nburada bir kitle imha silahı yapıyormuş!
Dialogue: 0,0:14:09.00,0:14:11.31,Main,Marine,0,0,0,,Bu konuda bir şeyler yapılmazsa\Ntüm dünya zarar görecek!
Dialogue: 0,0:14:11.50,0:14:14.21,Main,Marine,0,0,0,,Bu adadan kurtulup donanma karargâhına\Nhaber vermemiz lazım!
Dialogue: 0,0:14:14.34,0:14:20.65,Main,Marine,0,0,0,,Ana birliğe canlı olarak geri dönemeyeceksek\Nadamlarımız neden hayatlarını feda etti!?
Dialogue: 0,0:14:21.39,0:14:21.98,Main,Tashigi,0,0,0,,Özür dilerim.
Dialogue: 0,0:14:22.68,0:14:23.38,Main,Tashigi,0,0,0,,Gidelim!
Dialogue: 0,0:14:23.38,0:14:24.41,Main,Marine,0,0,0,,Durun biraz.
Dialogue: 0,0:14:24.41,0:14:26.43,Main,Marine,0,0,0,,Bu ses de neyin nesi?
Dialogue: 0,0:14:30.70,0:14:33.18,Main,Marine,0,0,0,,Bu yaratık da neyin nesi?!
Dialogue: 0,0:14:33.18,0:14:36.65,Main,Marine,0,0,0,,Hasır Şapka tayfasıyla\Nbirlikte gelen şey bu!
Dialogue: 0,0:14:36.65,0:14:39.02,Main,Marine,0,0,0,,Kertenkele falan mı bu acaba?
Dialogue: 0,0:14:39.02,0:14:44.04,Main,Tashigi,0,0,0,,Punk Hazard'da gerçek\Nejderhalar olduğunu duymuştum!
Dialogue: 0,0:14:48.57,0:14:54.12,Main,Tashigi,0,0,0,,Adayı koruması için Dr. Vegapunk\Ntarafından yaratılmış efsanevi yaratık.
Dialogue: 0,0:14:54.12,0:14:57.80,Main,Marine,0,0,0,,Az öncesine kadar\No denli korkunç görünmüyordu.
Dialogue: 0,0:15:00.56,0:15:01.60,Main,Marine,0,0,0,,Atlattı mı?
Dialogue: 0,0:15:03.72,0:15:05.56,Main,Marine,0,0,0,,O çelikti!
Dialogue: 0,0:15:07.31,0:15:09.45,Main,Marine,0,0,0,,O dişleriyle bize ne\Nyapacağını bir düşünün...
Dialogue: 0,0:15:09.45,0:15:11.55,Main,Tashigi,0,0,0,,Millet, B binasına doğru gidelim!
Dialogue: 0,0:15:13.49,0:15:16.42,Main,Marine,0,0,0,,Uçuyor, alev püskürtüyor,\Ndemiri kemiriyor!
Dialogue: 0,0:15:16.42,0:15:18.64,Main,Marine,0,0,0,,Ne tür bir yaratık bu böyle?!
Dialogue: 0,0:15:22.00,0:15:23.11,Main,Marine,0,0,0,,Ne oldu?
Dialogue: 0,0:15:23.11,0:15:24.22,Main,Marine,0,0,0,,Gitti.
Dialogue: 0,0:15:24.22,0:15:25.16,Main,Marine,0,0,0,,Bir şeyden mi kaçıyor?
Dialogue: 0,0:15:25.16,0:15:27.15,Main,Marine,0,0,0,,Bir şey onu korkuttu.
Dialogue: 0,0:15:33.72,0:15:36.32,Main,Marine,0,0,0,,Albay Tashigi, yaşasın!
Dialogue: 0,0:15:36.32,0:15:39.09,Main,Marine,0,0,0,,En güçlü desteğimiz Punk Hazard'da!
Dialogue: 0,0:15:39.28,0:15:41.61,Main,Marine,0,0,0,,Koramiral bizi kurtarmaya geldi!
Dialogue: 0,0:15:50.48,0:15:51.60,Main,Tashigi,0,0,0,,Vergo!
Dialogue: 0,0:16:00.72,0:16:07.53,Main,Marine,0,0,0,,Koramiral Smo-yan ve Koramiral Vergo! \NG-5'in zirvesindeki adamların ikisi de burada!
Dialogue: 0,0:16:07.90,0:16:09.69,Main,Marine,0,0,0,,Kimseler dokunamaz bize artık!
Dialogue: 0,0:16:10.47,0:16:11.24,Main,Marine,0,0,0,,Hayır!
Dialogue: 0,0:16:11.24,0:16:14.01,Main,Marine,0,0,0,,Yaşasın!\NKurtulduk!
Dialogue: 0,0:16:15.13,0:16:18.63,Main,Tashigi,0,0,0,,Kaçın! Hepiniz kaçın!
Dialogue: 0,0:16:23.31,0:16:26.89,Main,Marine,0,0,0,,Koramiral Vergo, yanlış\Nbir şey mi yaptılar?
Dialogue: 0,0:16:26.89,0:16:31.18,Main,Marine,0,0,0,,Bir şekilde cezayı hak etmiş olsalar bile\NShigan'ınız onları öldürebilir...
Dialogue: 0,0:16:31.99,0:16:32.90,Flashbacks,Vergo,0,0,0,,Hoş geldiniz.
Dialogue: 0,0:16:35.77,0:16:40.27,Flashbacks,Vergo,0,0,0,,Adınızı duymuştum Tuğamiral Smoker,\Nsizinle tanışmak büyük şeref.
Dialogue: 0,0:16:40.90,0:16:45.11,Flashbacks,Vergo,0,0,0,,G-5'imizin askerleri kabadırlar ve kafaları pek\Nçalışmaz ama onları bir kez tanıyınca aslında...
Dialogue: 0,0:16:45.11,0:16:48.74,Flashbacks,Vergo,0,0,0,,...söylentilerdeki kadar\Nkötü olmadıklarını anlıyorsunuz.
Dialogue: 0,0:16:51.76,0:16:55.45,Flashbacks,Vergo,0,0,0,,Çok yakında ne denli sadık\Nbirer asker olduklarını göreceksiniz.
Dialogue: 0,0:16:59.41,0:17:00.97,Flashbacks,Tashigi,0,0,0,,Koramiral Vergo nerede?
Dialogue: 0,0:17:00.97,0:17:05.04,Flashbacks,Marine,0,0,0,,Boşver sen şimdi onu. \NKoramiral Vergo böyle ara ara ansızın evine döner.
Dialogue: 0,0:17:05.04,0:17:07.54,Flashbacks,Marine,0,0,0,,Çok hasta bir kız kardeşi varmış.
Dialogue: 0,0:17:07.54,0:17:10.40,Main,Citizen,0,0,0,,Kendinize nasıl Donanma askeri\Ndiyebiliyorsunuz siz?!
Dialogue: 0,0:17:11.37,0:17:12.98,Flashbacks,Vergo,0,0,0,,Bağışlayın.
Dialogue: 0,0:17:12.98,0:17:16.05,Flashbacks,Vergo,0,0,0,,Adamlarımın yaptıklarının sorumlusu benim.
Dialogue: 0,0:17:16.05,0:17:20.60,Flashbacks,Citizen,0,0,0,,Bak sen?! Bu yaptıklarının hesabını\Nversen iyi edersin o zaman!
Dialogue: 0,0:17:20.60,0:17:21.57,Flashbacks,Marine,0,0,0,,Sen var ya...
Dialogue: 0,0:17:21.57,0:17:23.36,Flashbacks,Marine,0,0,0,,Kendini hemen bir şey sanma!
Dialogue: 0,0:17:24.29,0:17:29.24,Flashbacks,Vergo,0,0,0,,Anlıyorum. Sizi mutlu etmek için\Nelimizden geleni yapacağız.
Dialogue: 0,0:17:29.57,0:17:35.45,Flashbacks,Tashigi,0,0,0,,Koramiral Vergo, kaçırılan\Nçocuklarla ilgili raporu...
Dialogue: 0,0:17:35.45,0:17:42.43,Flashbacks,Vergo,0,0,0,,Evet, onu inceledim ama bunlar denizdeki\Nkazalar gibi görünüyor. Yani raporlar yanlış.
Dialogue: 0,0:17:42.67,0:17:44.44,Flashbacks,Tashigi,0,0,0,,Yanlış mı?
Dialogue: 0,0:17:44.44,0:17:49.10,Flashbacks,Vergo,0,0,0,,Çocuğunun ölümünü kabullenmek\Nher ana baba için zordur.
Dialogue: 0,0:17:49.10,0:17:53.61,Flashbacks,Vergo,0,0,0,,Onlar da kaçırıldı diyerek\Numutlarını canlı tutmaya çalışıyorlar.
Dialogue: 0,0:17:55.39,0:17:59.59,Flashbacks,Vergo,0,0,0,,Bir gün anne olduğunda\Nsen de anlayacaksın.
Dialogue: 0,0:18:00.64,0:18:02.13,Flashbacks,Tashigi,0,0,0,,Öyle demek?
Dialogue: 0,0:18:03.33,0:18:05.07,Flashbacks,Vergo,0,0,0,,Evet, öyle.
Dialogue: 0,0:18:07.61,0:18:12.12,Main,Tashigi,0,0,0,,Millet, geri çekilin!\NSizin tanıdığınız adam değil o!
Dialogue: 0,0:18:13.88,0:18:16.61,Main,Tashigi,0,0,0,,Bu adam ta en başından beri...
Dialogue: 0,0:18:18.64,0:18:19.34,Main,Marine,0,0,0,,Albay-chan!
Dialogue: 0,0:18:22.30,0:18:22.94,Main,Marine,0,0,0,,Albay-chan!
Dialogue: 0,0:18:25.37,0:18:27.39,Main,Marine,0,0,0,,Bu adam bir sahtekâr!
Dialogue: 0,0:18:27.39,0:18:30.41,Main,Marine,0,0,0,,Vergo-san albayımıza asla\Nböyle bir şey yapmazdı!
Dialogue: 0,0:18:32.04,0:18:35.30,Main,Marine,0,0,0,,Öyle! Kılık mı değiştirdin yoksa\Nşeytan meyvesinin bir özelliği mi?!
Dialogue: 0,0:18:35.30,0:18:38.82,Main,Marine,0,0,0,,Adi herif, Koramiral Vergo'yu taklit\Netmeye nasıl cesaret edersin!?
Dialogue: 0,0:18:41.25,0:18:49.47,Main,Marine,0,0,0,,Koramiral Vergo bizim gibi serseri denizcileri\Nbile kanatları altına aldı, o bir insanlık ve adalet temsili!
Dialogue: 0,0:18:50.09,0:18:51.40,Main,Marine,0,0,0,,Onu taklit etmekten vazgeç!
Dialogue: 0,0:18:51.40,0:18:54.34,Main,Marine,0,0,0,,Geberteceğiz seni, adi sahtekâr!
Dialogue: 0,0:18:58.70,0:19:01.31,Thoughts,Tashigi,0,0,0,,Konuşamıyorum bile!
Dialogue: 0,0:19:01.31,0:19:03.28,Thoughts,Tashigi,0,0,0,,Yapmayın artık!
Dialogue: 0,0:19:03.28,0:19:06.60,Thoughts,Tashigi,0,0,0,,Yardım et, Smoker-san!
Dialogue: 0,0:19:06.60,0:19:08.44,Main,Sanji,0,0,0,,Bir hanım...
Dialogue: 0,0:19:08.44,0:19:08.87,Main,Vergo,0,0,0,,Bu da kim?
Dialogue: 0,0:19:11.24,0:19:13.63,Main,Sanji,0,0,0,,...beni çağırıyor!
Dialogue: 0,0:19:20.77,0:19:22.38,Main,Marine,0,0,0,,Hasır Şapka'lardan biri!
Dialogue: 0,0:19:22.38,0:19:23.58,Main,Marine,0,0,0,,Neden korsanın teki\Nbize yardım ediyor?
Dialogue: 0,0:19:25.34,0:19:29.76,Main,Sanji,0,0,0,,Bir kadının yanaklarından süzülen\Ngözyaşları çağırdı beni buraya.
Dialogue: 0,0:19:31.54,0:19:32.98,Captions,Sign,0,0,180,,B Binasının İçi
Dialogue: 0,0:19:36.27,0:19:39.40,Main,Usopp,0,0,0,,Sanji'nin ifadesi değişti\Nve ardından uçup gitti!
Dialogue: 0,0:19:39.40,0:19:43.89,Main,Zoro,0,0,0,,Ben de tuhaf bir şey sezdim ardımızda.\NUnut gitsin.
Dialogue: 0,0:19:46.77,0:19:47.74,Main,Usopp,0,0,0,,Bu...
Dialogue: 0,0:19:47.74,0:19:50.07,Main,Brook,0,0,0,,Bizim ejderha!
Dialogue: 0,0:19:50.07,0:19:52.65,Main,Nami,0,0,0,,Hayır, biraz farklı görünüyor.
Dialogue: 0,0:19:54.54,0:19:55.78,Main,Nami,0,0,0,,Gözleri...
Dialogue: 0,0:19:55.78,0:19:59.15,Main,Brownbeard,0,0,0,,Düşündüğüm gibi\Nsakinleştiricilerin etkisi geçmiş.
Dialogue: 0,0:19:59.15,0:20:02.60,Main,Brownbeard,0,0,0,,Ayrıca bu, daha gelişmiş şekilde\Nüretilen en son küçük modellerden.
Dialogue: 0,0:20:02.60,0:20:05.08,Main,Brownbeard,0,0,0,,Daha hızlı\Nve çok daha dayanıklı!
Dialogue: 0,0:20:05.08,0:20:07.71,Captions,Sign,0,0,180,,{\fad(500,0)}B Binası Merkez Merdivenleri
Dialogue: 0,0:20:05.89,0:20:07.71,Main,Luffy,0,0,0,,{\an8}Caesar'ı yakalayacağım!
Dialogue: 0,0:20:07.71,0:20:08.72,Main,Luffy,0,0,0,,Ya sen?
Dialogue: 0,0:20:08.72,0:20:10.63,Main,Smoker,0,0,0,,Vergo'yla hesaplaşacağım!
Dialogue: 0,0:20:10.63,0:20:13.15,Main,Luffy,0,0,0,,Caesar'ın yanında mı o?
Dialogue: 0,0:20:13.15,0:20:15.94,Main,Smoker,0,0,0,,Muhtemelen.\NYoluma çıkma sakın!
Dialogue: 0,0:20:16.40,0:20:19.18,Main,Luffy,0,0,0,,Bekle beni, adi!
Dialogue: 0,0:20:21.48,0:20:25.54,Captions,Sign,0,0,180,,{\fad(500,0)}Caesar'ın Laboratuvarı
Dialogue: 0,0:20:25.54,0:20:28.88,Main,Caesar,0,0,0,,Bu Vergo adisi ne yaptığını sanıyor?!
Dialogue: 0,0:20:28.88,0:20:32.50,Main,Caesar,0,0,0,,G-5 askerleri deneklerimdi benim!
Dialogue: 0,0:20:32.50,0:20:36.65,Main,Caesar,0,0,0,,Shinokuni'yle öldürmezsem onları\Nbir anlamı olmaz ki! Aptal herif ya!
Dialogue: 0,0:20:37.31,0:20:45.10,Main,Caesar,0,0,0,,Madem öyle, varmaya çalıştıkları geçidi kapatıp\Narkalarındaki kapıdan da içeri gaz veririm.
Dialogue: 0,0:20:46.29,0:20:49.42,Main,Monet,0,0,0,,Ama Vergo da hâlâ orada.
Dialogue: 0,0:20:49.42,0:20:53.97,Main,Caesar,0,0,0,,O mal herif ölmüş ölmemiş kim takar!\NYap sen dediğimi!
Dialogue: 0,0:20:53.96,0:20:57.42,Captions,Sign,400,0,260,,{\fad(500,0)}B Binası 3. Kat\NBisküvi Odası Yanı
Dialogue: 0,0:21:02.36,0:21:04.94,Main,Child,0,0,0,,Bisküvi odası hemen ileride!
Dialogue: 0,0:21:04.94,0:21:05.90,Main,Chopper,0,0,0,,Acele edelim!
Dialogue: 0,0:21:12.10,0:21:13.55,Main,Smoker,0,0,0,,Hazır mısın?
Dialogue: 0,0:21:13.55,0:21:17.28,Main,Luffy,0,0,0,,Hiç de bile!\NDur az!
Dialogue: 0,0:21:17.28,0:21:21.09,Main,Luffy,0,0,0,,Öyle bir koştum ki\Nbeton alev aldı be!
Dialogue: 0,0:21:22.14,0:21:28.42,Main,Luffy,0,0,0,,Ama sen o kabarık duman bulutunun üzerinde\Nhavada uçuyorsun, bu hile sayılmalı!
Dialogue: 0,0:21:28.78,0:21:30.02,Main,Smoker,0,0,0,,Şimdi hazır mısın?
Dialogue: 0,0:21:30.02,0:21:32.45,Main,Luffy,0,0,0,,Biraz bekle! Sana bir dakika bekle\Ndemedim mi zaten?
Dialogue: 0,0:21:32.45,0:21:35.18,Main,Luffy,0,0,0,,"Hadi gidelim" dediğimde gideceğiz.
Dialogue: 0,0:21:36.96,0:21:39.46,Main,Luffy,0,0,0,,Kendimi toparlamam lazım.
Dialogue: 0,0:21:39.96,0:21:43.65,Main,Luffy,0,0,0,,"Hadi gidelim" demedim ama daha!
Dialogue: 0,0:21:44.39,0:21:47.15,Main,Smoker,0,0,0,,Bak anlaşalım, Vergo benim!
Dialogue: 0,0:21:47.15,0:21:53.96,Main,Luffy,0,0,0,,Biliyorum! Ben Caesar'ı istiyorum zaten!\NOna dokunayım deme!
Dialogue: 0,0:21:58.77,0:22:01.04,Main,Luffy,0,0,0,,Benimki burada!
Dialogue: 0,0:22:02.39,0:22:09.84,Main,Luffy,0,0,0,,Bu sefer kaçamayacaksın, Caesar!
