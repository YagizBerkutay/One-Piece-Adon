F,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.5,0.5,9,10,10,10,1Style: Hands Up lyrics,Futura Md BT,35,&H00FF762C,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2.0,0,8,10,10,30,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:02:29.82,0:02:36.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:10:45.00,0:10:55.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:21:33.40,0:21:36.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:02:29.82,0:02:36.00,Title,,0,0,0,,Momonosuke Adlı Ejderha ve Tehditkar Kar Meyvesi Kullanıcısı!Dialogue: 0,0:02:38.79,0:02:43.44,Captions,Location,0,0,240,,C Binası - Yeraltı ÇöplüğüDialogue: 0,0:02:37.91,0:02:39.44,Main,Luffy,0,0,0,,Momonosuke mi?Dialogue: 0,0:02:39.44,0:02:41.55,Main,Momonosuke,0,0,0,,Ta kendisi.Dialogue: 0,0:02:43.43,0:02:46.09,Main,Luffy,0,0,0,,Bu ismi daha önce bir yerlerde duymuştum...Dialogue: 0,0:02:46.09,0:02:47.55,Main,Luffy,0,0,0,,...ama nerede duymuştum acaba?Dialogue: 0,0:02:47.55,0:02:49.88,Main,Momonosuke,0,0,0,,Ben nereden bileyim? Muhtemelen beni başka biriyle karıştırdın.Dialogue: 0,0:02:49.88,0:02:52.10,Main,Momonosuke,0,0,0,,O değil de...Dialogue: 0,0:02:55.04,0:02:57.06,Main,Momonosuke,0,0,0,,...yiyecekmiş gibi bakmayı kes!Dialogue: 0,0:02:57.06,0:03:00.21,Main,Momonosuke,0,0,0,,Beni yiyemezsin!Dialogue: 0,0:03:00.21,0:03:02.88,Main,Momonosuke,0,0,0,,Beni yemeye çalışırsan önce ben seni yerim!Dialogue: 0,0:03:02.88,0:03:05.01,Main,Momonosuke,0,0,0,,Kendine hakim ol!Dialogue: 0,0:03:03.38,0:03:06.52,Captions,Sign,0,0,180,,Momonosuke (Ejderha)Dialogue: 0,0:03:06.52,0:03:11.92,Main,Luffy,0,0,0,,Belki de Momonosuke bu ejderhanın vücuduna yapışmış ve osuruğuyla falan konuşuyordur?Dialogue: 0,0:03:11.92,0:03:14.02,Main,Luffy,0,0,0,,Neredesin?!Dialogue: 0,0:03:14.02,0:03:16.16,Main,Momonosuke,0,0,0,,N-Ne yaptığınızı sanıyorsun?Dialogue: 0,0:03:16.16,0:03:20.28,Main,Luffy,0,0,0,,Oha!? Yılan balığı benimle konuşuyor resmen!Dialogue: 0,0:03:21.48,0:03:24.65,Main,Momonosuke,0,0,0,,Salyalarını akıtmayı kes! Yılan balığı falan değilim ben!Dialogue: 0,0:03:27.69,0:03:30.48,Main,Luffy,0,0,0,,Sen de açsın değil mi?Dialogue: 0,0:03:30.83,0:03:32.86,Main,Momonosuke,0,0,0,,Saçmalama!Dialogue: 0,0:03:32.86,0:03:38.07,Main,Momonosuke,0,0,0,,Sadece on gün aç kalmak bir savaşçının midesinin guruldamasına neden olmaz.Dialogue: 0,0:03:38.07,0:03:39.24,Main,Luffy,0,0,0,,On gün mü?Dialogue: 0,0:03:39.24,0:03:42.93,Main,Momonosuke,0,0,0,,Kimsin sen ve burada ne yapıyorsun?Dialogue: 0,0:03:42.93,0:03:46.90,Main,Luffy,0,0,0,,Ben Luffy, korsanlar kralı olacak adamım!Dialogue: 0,0:03:46.90,0:03:50.13,Main,Momonosuke,0,0,0,,Kor-Kor-Kor...Dialogue: 0,0:03:51.63,0:03:53.03,Main,Momonosuke,0,0,0,,Yalan söylemeyi kes.Dialogue: 0,0:03:53.03,0:03:56.90,Main,Momonosuke,0,0,0,,Bir korsan daha büyük ve en az 300 kg ağırlığında olur.Dialogue: 0,0:03:56.90,0:04:00.21,Main,Momonosuke,0,0,0,,Ayrıca çok daha güçlü ve vahşi olur.Dialogue: 0,0:04:00.21,0:04:03.25,Main,Luffy,0,0,0,,Gerçekten umurumda değil, yılan balığı.Dialogue: 0,0:04:03.25,0:04:04.18,Main,Luffy,0,0,0,,Nasıl-Dialogue: 0,0:04:04.18,0:04:05.50,Main,Momonosuke,0,0,0,,Adım Momonosuke benim!Dialogue: 0,0:04:07.35,0:04:10.48,Main,Momonosuke,0,0,0,,Anlıyorum, demek sen de bir yabancısın.Dialogue: 0,0:04:10.48,0:04:15.13,Main,Momonosuke,0,0,0,,Tek bildiğim burada pek çok hasta çocuk olduğu.Dialogue: 0,0:04:16.96,0:04:22.86,Main,Momonosuke,0,0,0,,Burasının ne tür bir ada olduğunu yahut başıma neler geldiğini bilmiyorum.Dialogue: 0,0:04:24.07,0:04:28.81,Main,Momonosuke,0,0,0,,Her şey kaçak olarak bir gemiye binmemle başladı.Dialogue: 0,0:04:30.35,0:04:38.32,Main,Momonosuke,0,0,0,,Soğuk davranmama rağmen diğer çocuklar bana karşı çok iyiydiler.Dialogue: 0,0:04:40.42,0:04:43.34,Flashbacks,Random girl,0,0,0,,Yemek dağıtıyorlar, aç değil misin?Dialogue: 0,0:04:44.20,0:04:49.08,Flashbacks,Momonosuke,0,0,0,,Ben bir samurayım, başkalarından sadaka kabul etmem.Dialogue: 0,0:04:51.58,0:04:55.48,Main,Momonosuke,0,0,0,,Bana karşı çok nazik olmalarına rağmen çok gergindim.Dialogue: 0,0:04:55.48,0:04:57.80,Flashbacks,Random boy,0,0,0,,Yemeğini getirdim.Dialogue: 0,0:04:58.10,0:05:00.67,Flashbacks,Momonosuke,0,0,0,,İstemiyorum dedim size!Dialogue: 0,0:05:01.43,0:05:05.51,Flashbacks,Random boy,0,0,0,,Bir şeyler yemen lazım! Hepimiz ebeveynlerimizden ayrı düştük.Dialogue: 0,0:05:05.51,0:05:09.09,Flashbacks,Momonosuke,0,0,0,,Neler hissettiğimi kimse anlayamaz!Dialogue: 0,0:05:05.65,0:05:06.61,Secondary,Random girl,0,0,0,,Yalnız kal-Dialogue: 0,0:05:10.98,0:05:13.98,Flashbacks,Caesar,0,0,0,,Bendeniz Master Caesar!Dialogue: 0,0:05:13.98,0:05:16.08,Flashbacks,Caesar,0,0,0,,Gelin hadi!Dialogue: 0,0:05:16.08,0:05:19.70,Flashbacks,Caesar,0,0,0,,Bundan böyle burada oynayacaksınız!Dialogue: 0,0:05:21.55,0:05:23.90,Flashbacks,Konbu,0,0,0,,Adın ne?Dialogue: 0,0:05:24.59,0:05:27.37,Flashbacks,Momonosuke,0,0,0,,Adım falan yok benim!Dialogue: 0,0:05:29.22,0:05:30.57,Flashbacks,Mocha,0,0,0,,İşte biraz atıştırmalık.Dialogue: 0,0:05:30.57,0:05:33.05,Flashbacks,Mocha,0,0,0,,Al hadi.Dialogue: 0,0:05:33.05,0:05:34.02,Flashbacks,Momonosuke,0,0,0,,Onlara ihtiyacım yok!Dialogue: 0,0:05:34.53,0:05:35.38,Flashbacks,Mocha,0,0,0,,Biraz şekere ne dersin?Dialogue: 0,0:05:35.38,0:05:36.56,Flashbacks,Momonosuke,0,0,0,,İstemez!Dialogue: 0,0:05:38.24,0:05:41.22,Flashbacks,Yellow suit guy,0,0,0,,Ne? Çocuklardan biri kaçtı mı?Dialogue: 0,0:05:41.22,0:05:45.28,Flashbacks,Yellow suit guy 2,0,0,0,,Evet ama gemide ismi kayıtlı herkes burada.Dialogue: 0,0:05:45.28,0:05:46.19,Flashbacks,Yellow guy 3,0,0,0,,Tuhaf.Dialogue: 0,0:06:14.90,0:06:16.31,Flashbacks,Random girl,0,0,0,,Baksana...Dialogue: 0,0:06:20.56,0:06:24.41,Flashbacks,Random girl,0,0,0,,Demek Momonosuke-kun'sun sen!Dialogue: 0,0:06:24.41,0:06:27.85,Flashbacks,Random girl,0,0,0,,Kimselerin girmesine izin verilmeyen "gizli oda" burası.Dialogue: 0,0:06:27.85,0:06:31.99,Flashbacks,Momonosuke,0,0,0,,İşime engel oluyorsun! Bana bulaşma!Dialogue: 0,0:06:31.99,0:06:34.88,Flashbacks,Momonosuke,0,0,0,,Buradan bir çıkış yolu arıyorum.Dialogue: 0,0:06:34.88,0:06:38.16,Flashbacks,Momonosuke,0,0,0,,Buradan çıkacağım! Yapmam gereken bir şey var.Dialogue: 0,0:06:38.16,0:06:42.81,Flashbacks,Random girl,0,0,0,,Zor biliyorum ama buradaki tüm çocuklar için geçerli bu.Dialogue: 0,0:06:44.56,0:06:48.97,Flashbacks,Random girl,0,0,0,,Hepsi bir an önce evlerine, ailelerinin yanına dönmek istiyor.Dialogue: 0,0:06:50.88,0:06:56.33,Flashbacks,Random girl,0,0,0,,Herkes farklı adalardan tedavi olmak için geldi buraya ama hepimiz aynı hisleri paylaşıyoruz.Dialogue: 0,0:06:57.61,0:07:02.32,Flashbacks,Random girl,0,0,0,,Benim de eve gittiğimde yapmak istediğim pek çok şey var.Dialogue: 0,0:07:02.32,0:07:06.84,Flashbacks,Random girl,0,0,0,,Bisküvi Odası'nda herkes birbiriyle iyi geçinir ve çok eğlenir.Dialogue: 0,0:07:06.84,0:07:08.74,Flashbacks,Random girl,0,0,0,,Tüm acıları ardımızda bırakabiliriz.Dialogue: 0,0:07:08.74,0:07:12.83,Flashbacks,Random girl,0,0,0,,Gerçekten bir şeyler yemelisin, Momonosuke!Dialogue: 0,0:07:12.83,0:07:14.26,Flashbacks,Momonosuke,0,0,0,,Ama ben...Dialogue: 0,0:07:14.26,0:07:16.89,Flashbacks,Random Yellow suit,0,0,0,,Gizli odanın kapısı açık!Dialogue: 0,0:07:16.89,0:07:20.79,Flashbacks,Random girl,0,0,0,,Olamaz, birileri geliyor! Gidelim, Momonosuke-kun!Dialogue: 0,0:07:25.72,0:07:27.19,Flashbacks,Random Yellow suit,0,0,0,,İçeride biri mi var?Dialogue: 0,0:07:28.60,0:07:29.88,Flashbacks,Random Yellow suit 2,0,0,0,,Neler oluyor?Dialogue: 0,0:07:29.88,0:07:30.47,Flashbacks,Random Yellow suit,0,0,0,,Kim o?Dialogue: 0,0:07:40.60,0:07:42.07,Flashbacks,2 Random yellow suits,0,0,0,,Ej-Ejderha mı?!Dialogue: 0,0:07:45.43,0:07:47.03,Flashbacks,2 Random yellow suits,0,0,0,,Neler oluyor?!Dialogue: 0,0:07:47.03,0:07:50.16,Flashbacks,Random girl,0,0,0,,Mo-Momonosuke-kun...Dialogue: 0,0:07:50.93,0:07:52.05,Flashbacks,Random Yellow suit,0,0,0,,Bak!Dialogue: 0,0:07:52.05,0:07:56.64,Flashbacks,Random Yellow suit,0,0,0,,Yanılmıyorsam burada Vegapunk'ın yarattığı yapay bir şeytan meyvesi vardı!Dialogue: 0,0:07:57.15,0:07:59.42,Flashbacks,Random Yellow suit 2,0,0,0,,Bu başarısız bir deney değil miydi?Dialogue: 0,0:07:59.42,0:08:01.45,Flashbacks,Random yellow suit,0,0,0,,Evet, ben de öyle duymuştum.Dialogue: 0,0:08:10.10,0:08:13.85,Main,Momonosuke,0,0,0,,Başka bir deyişle, ben insanım.Dialogue: 0,0:08:13.85,0:08:16.59,Main,Luffy,0,0,0,,Şeytan meyvesi yedin demek?Dialogue: 0,0:08:16.59,0:08:17.78,Main,Luffy,0,0,0,,Yani şimdi yılan balığı adam falan mısın?Dialogue: 0,0:08:17.78,0:08:21.46,Main,Luffy,0,0,0,,Neden insan haline dönmüyorsun peki?Dialogue: 0,0:08:21.46,0:08:27.47,Main,Momonosuke,0,0,0,,Ne?! Eski halime dönebilir miyim ki?! Nasıl?!Dialogue: 0,0:08:27.47,0:08:31.40,Main,Luffy,0,0,0,,Bilmem. Zoan türü değilim ben.Dialogue: 0,0:08:31.90,0:08:35.22,Main,Luffy,0,0,0,,Onu geçtim de buranın tavanı ne kadar yüksekte acaba?Dialogue: 0,0:08:35.22,0:08:37.37,Main,Luffy,0,0,0,,Düştüğüm deliği bile göremiyorum.Dialogue: 0,0:08:38.05,0:08:43.59,Main,Momonosuke,0,0,0,,Ben de buradan çıkıp o çocuklara gerçeği anlatmak istiyorum!Dialogue: 0,0:08:43.59,0:08:45.17,Main,Momonosuke,0,0,0,,Caesar denen adamın...Dialogue: 0,0:08:45.17,0:08:48.88,Main,Momonosuke,0,0,0,,...gerçekte ne planladığını duydum.Dialogue: 0,0:08:57.83,0:09:01.22,Flashbacks,Caesar,0,0,0,,Bu seferkiler itaatkar çocuklar çıktılar.Dialogue: 0,0:09:04.36,0:09:08.32,Flashbacks,Caesar,0,0,0,,Diğer çocuklar da güzel bir biçimde büyümeye devam ediyorlar.Dialogue: 0,0:09:08.32,0:09:12.73,Flashbacks,Caesar,0,0,0,,Gerçi bu ilacın doz limitlerini belirlemek için yapılan bir deney.Dialogue: 0,0:09:12.73,0:09:15.12,Flashbacks,Caesar,0,0,0,,Pek dayanabileceklerini sanmıyorum.Dialogue: 0,0:09:16.37,0:09:21.20,Flashbacks,Caesar,0,0,0,,Muhtemelen beş yıl içerisinde hepsi de ölmüş olacak.Dialogue: 0,0:09:23.26,0:09:26.39,Flashbacks,Caesar,0,0,0,,Yani yeni çocuklar bulmamız gerekecek.Dialogue: 0,0:09:26.80,0:09:29.61,Flashbacks,Caesar,0,0,0,,Ne yapalım, her deney başarılı olacak diye bir şart yok.Dialogue: 0,0:09:29.61,0:09:31.63,Flashbacks,Caesar,0,0,0,,Bazı fedakârlıklar olacak.Dialogue: 0,0:09:31.63,0:09:34.88,Main,Momonosuke,0,0,0,,O adamı doktor sanıyordum...Dialogue: 0,0:09:34.88,0:09:39.19,Main,Momonosuke,0,0,0,,...ama aslında çocukların ölümüne neden olacak kötü biriymiş.Dialogue: 0,0:09:39.19,0:09:44.24,Main,Momonosuke,0,0,0,,Tam çocuklara gerçekleri söylemeye giderken çöp kutusunun içine saklanınca buraya düşüverdim.Dialogue: 0,0:09:46.27,0:09:48.78,Main,Luffy,0,0,0,,Caesar!Dialogue: 0,0:09:49.87,0:09:52.01,Main,Luffy,0,0,0,,Tamamdır Momo!Dialogue: 0,0:09:52.01,0:09:55.38,Main,Luffy,0,0,0,,Buradan çıkacağım ve  seni de yanımda götürüyorum.Dialogue: 0,0:09:55.38,0:09:58.03,Main,Momonosuke,0,0,0,,Ama oraya kadar nasıl gideceksin?Dialogue: 0,0:09:59.23,0:10:02.49,Main,Luffy,0,0,0,,Duvarı tırmanacağım! Tutun bana!Dialogue: 0,0:10:03.79,0:10:06.44,Main,Luffy,0,0,0,,Çocuklar için endişelenme!Dialogue: 0,0:10:07.51,0:10:09.74,Main,Luffy,0,0,0,,Tayfam zaten onları kurtarmaya gidiyordu.Dialogue: 0,0:10:10.40,0:10:11.80,Main,Momonosuke,0,0,0,,Gerçekten mi?!Dialogue: 0,0:10:11.80,0:10:14.99,Main,Luffy,0,0,0,,Akıllarına koydukları şeyi yaparlar.Dialogue: 0,0:10:14.99,0:10:17.22,Main,Luffy,0,0,0,,O yüzden hiç endişelenme!Dialogue: 0,0:10:17.76,0:10:25.98,Main,Momonosuke,0,0,0,,Biliyordum, bir korsan olmadığını...Dialogue: 0,0:10:25.98,0:10:28.21,Main,Momonosuke,0,0,0,,se... nin.Dialogue: 0,0:10:28.21,0:10:29.35,Main,Luffy,0,0,0,,Ne oldu?!Dialogue: 0,0:10:31.15,0:10:33.44,Main,Luffy,0,0,0,,Çok mu açsın?!Dialogue: 0,0:10:33.44,0:10:34.70,Main,Luffy,0,0,0,,Kendine gel!Dialogue: 0,0:10:34.70,0:10:35.60,Main,Luffy,0,0,0,,Kendine gel!Dialogue: 0,0:10:35.60,0:10:40.47,Thoughts,Momonosuke,0,0,0,,Kendine gel!Dialogue: 0,0:10:47.59,0:10:50.05,Main,Luffy,0,0,0,,Uçuyoruz!Dialogue: 0,0:10:57.08,0:10:59.40,Captions,Location,0,0,180,,B Binası, 2. Kat - İç Alan, Muayene Odası KoridoruDialogue: 0,0:10:59.40,0:11:03.16,Main,Usopp,0,0,0,,Acaba Nami'ler bensiz idare edebiliyorlar mıdır?!Dialogue: 0,0:11:03.16,0:11:05.90,Main,Usopp,0,0,0,,Gerçi Zoro da onlarla, iyilerdir herhalde!Dialogue: 0,0:11:05.90,0:11:10.82,Main,Usopp,0,0,0,,Brook, Robin'in bulmamızı istediği deniz taşı kelepçelerinden görürsen haber ver!Dialogue: 0,0:11:10.82,0:11:16.08,Main,Kin'emon,0,0,0,,Bağışla ceset-dono, senin sihirbazlığına muhtacım!Dialogue: 0,0:11:16.08,0:11:18.41,Main,Brook,0,0,0,,Bana güvenebilirsiniz!Dialogue: 0,0:11:18.52,0:11:21.23,Captions,Location,0,0,180,,D Binası - SAD Üretim OdasıDialogue: 0,0:11:31.26,0:11:32.54,Captions,Location,0,0,180,,B Binası - Bisküvi Odası YakınlarıDialogue: 0,0:11:32.54,0:11:37.09,Main,Tashigi,0,0,0,,Millet bu taraftan! Çocukların olduğu bisküvi odasına!Dialogue: 0,0:11:39.59,0:11:41.72,Main,Random Soldier,0,0,0,,Acıdı be abi!Dialogue: 0,0:11:41.72,0:11:43.04,Main,Sanji,0,0,0,,Mızmızlanmayı kesin!Dialogue: 0,0:11:43.04,0:11:44.36,Main,Random Soldier,0,0,0,,Kafayı yemiş!Dialogue: 0,0:11:45.00,0:11:50.76,Main,Sanji,0,0,0,,Çocukları kurtarmak istiyorsanız derhâl Bisküvi Odası'na!Dialogue: 0,0:11:50.83,0:11:53.72,Captions,Location,0,0,180,,B Binası, 3. Kat - Bisküvi OdasıDialogue: 0,0:11:53.72,0:11:56.59,Main,Nami,0,0,0,,Çok soğuk! Odayı kar fırtınası teslim aldı resmen!Dialogue: 0,0:11:56.59,0:11:59.72,Main,Nami,0,0,0,,Tam da üstümdekileri çıkarmışken  Kar Kar Meyvesi de ne şimdi?!Dialogue: 0,0:11:59.72,0:12:01.50,Main,Nami,0,0,0,,Canı çıkası kar kadın!Dialogue: 0,0:12:01.50,0:12:05.51,Main,Chopper,0,0,0,,Millet durun!  Şekeri ne pahasına olursa olsun yememelisiniz!Dialogue: 0,0:12:05.51,0:12:07.32,Main,Chopper,0,0,0,,Mocha, kaç!Dialogue: 0,0:12:07.32,0:12:11.09,Main,Random giant boy,0,0,0,,Bekle Mocha! Şekeri bize ver!Dialogue: 0,0:12:11.09,0:12:13.21,Main,Mocha,0,0,0,,Olmaz! Kendinize gelin!Dialogue: 0,0:12:14.10,0:12:16.07,Main,Sind,0,0,0,,Hepsini kendine saklama!Dialogue: 0,0:12:16.07,0:12:17.37,Main,Random giant boy,0,0,0,,Kaçma!Dialogue: 0,0:12:18.44,0:12:20.37,Main,Robin,0,0,0,,Biraz da olsa onları durdurmaya çalışacağım!Dialogue: 0,0:12:22.58,0:12:24.18,Main,Monet,0,0,0,,Karışmak yok.Dialogue: 0,0:12:25.29,0:12:25.97,Main,Nami,0,0,0,,Robin!Dialogue: 0,0:12:34.48,0:12:36.92,Main,Zoro,0,0,0,,Siz çocukları durdurmaya bakın!Dialogue: 0,0:12:38.08,0:12:40.37,Main,Zoro,0,0,0,,Düşmanımız Logia türü.Dialogue: 0,0:12:40.37,0:12:43.12,Main,Zoro,0,0,0,,Onunla ben ilgileneceğim!Dialogue: 0,0:12:45.72,0:12:47.93,Main,Chopper/Nami,0,0,0,,İyi misin, Robin?Dialogue: 0,0:12:47.93,0:12:50.43,Main,Robin,0,0,0,,Ben iyiyim, sadece bir sıyrık.Dialogue: 0,0:12:50.43,0:12:52.70,Main,Robin,0,0,0,,Derhâl çocukları durdurmalıyız.Dialogue: 0,0:12:52.70,0:12:54.01,Main,Nami,0,0,0,,Peki!Dialogue: 0,0:12:54.01,0:12:57.46,Main,Chopper,0,0,0,,Nami, çocuklar odadan çıkmak üzereler!Dialogue: 0,0:12:57.46,0:12:58.74,Main,Children,0,0,0,,Bekle Mocha!Dialogue: 0,0:12:58.74,0:13:06.14,Main,Chopper,0,0,0,,Onları durduracağım diye söz vermiştim ama durduramadım, üstelik Mocha'nın başını belaya soktum!Dialogue: 0,0:13:06.14,0:13:07.82,Main,Children,0,0,0,,Dur!Dialogue: 0,0:13:07.82,0:13:09.84,Main,Children,0,0,0,,Şekeri ver!Dialogue: 0,0:13:09.84,0:13:10.96,Main,Mocha,0,0,0,,Vermem!Dialogue: 0,0:13:10.96,0:13:15.47,Main,Mocha,0,0,0,,Bu şekerlerin nasıl şekerler olduğunu Chopper-chan söyledi bana!Dialogue: 0,0:13:15.47,0:13:18.62,Main,Mocha,0,0,0,,Bu şekerleri yememelisiniz!Dialogue: 0,0:13:18.62,0:13:21.25,Main,Mocha,0,0,0,,Lütfen normal hâlinize geri dönün!Dialogue: 0,0:13:25.01,0:13:28.36,Flashbacks,Sind,0,0,0,,Mocha, elimizden bir şey gelmez.Dialogue: 0,0:13:28.36,0:13:30.14,Flashbacks,Sind,0,0,0,,Hastayız biz.Dialogue: 0,0:13:30.97,0:13:35.79,Flashbacks,Sind,0,0,0,,Yetişkinler bizim hastalığımıza yakalanırlarsa öleceklermiş.Dialogue: 0,0:13:35.79,0:13:41.01,Flashbacks,Sind,0,0,0,,Anne babanın ölmesini istemezsin, değil mi?Dialogue: 0,0:13:42.37,0:13:46.31,Flashbacks,Sind,0,0,0,,Bizi bir yıl içinde tedavi edip iyileştireceklerini söylediler.Dialogue: 0,0:13:47.73,0:13:51.57,Flashbacks,Caesar,0,0,0,,Tanıştığımıza memnun oldum. Ben Caesar Clown.Dialogue: 0,0:13:51.57,0:13:53.84,Flashbacks,Caesar,0,0,0,,Bana Master deyin lütfen.Dialogue: 0,0:13:53.84,0:13:59.06,Flashbacks,Caesar,0,0,0,,Sizler benim ilk nesil hastalarımsınız.  Sizinle çalışmaktan mutluluk duyuyorum.Dialogue: 0,0:14:00.88,0:14:07.11,Flashbacks,Caesar,0,0,0,,Biricik oğlumu bu hastalık yüzünden kaybettim.Dialogue: 0,0:14:07.11,0:14:11.57,Flashbacks,Caesar,0,0,0,,Başka hiçbir çocuğun bu hastalıktan zarar görmesini istemiyorum.Dialogue: 0,0:14:14.77,0:14:20.02,Flashbacks,Caesar,0,0,0,,Çocuklarını kaybettikleri için yas tutan bir ebeveyn görmek de istemiyorum.Dialogue: 0,0:14:22.19,0:14:27.65,Flashbacks,Caesar,0,0,0,,Özür dilerim. Ne utanç verici bir durum, karşınızda göz yaşlarımı tutamadım.Dialogue: 0,0:14:27.65,0:14:30.40,Flashbacks,Mocha,0,0,0,,İyi misiniz, Master-san?Dialogue: 0,0:14:30.40,0:14:33.63,Flashbacks,Caesar,0,0,0,,Teşekkür ederim. Çok düşüncelisiniz.Dialogue: 0,0:14:33.63,0:14:40.58,Flashbacks,Caesar,0,0,0,,Sahi ya, sizi hâlâ diğer adalardan gelen hasta çocuklarla tanıştırmadım.Dialogue: 0,0:14:41.38,0:14:43.56,Flashbacks,Uzu,0,0,0,,Ben Uzu, tanıştığımıza memnun oldum.Dialogue: 0,0:14:44.50,0:14:46.99,Main,Uzu,0,0,0,,Şeker...!Dialogue: 0,0:14:47.71,0:14:49.24,Flashbacks,Doran,0,0,0,,Ben de Doran.Dialogue: 0,0:14:49.53,0:14:52.71,Main,Doran,0,0,0,,Bekle, Mocha!Dialogue: 0,0:14:53.40,0:14:54.85,Flashbacks,Konbu,0,0,0,,Benim adım Konbu.Dialogue: 0,0:14:55.12,0:14:58.24,Main,Konbu,0,0,0,,Bana biraz şeker ver!Dialogue: 0,0:15:00.78,0:15:04.29,Flashbacks,Monet,0,0,0,,Bugün bazı yeni arkadaşlar geldi.Dialogue: 0,0:15:04.91,0:15:07.63,Flashbacks,Monet,0,0,0,,Hepiniz iyi geçinin, tamam mı?Dialogue: 0,0:15:07.63,0:15:10.01,Flashbacks,Monet,0,0,0,,Eğer bir şey olursa bana haber verin.Dialogue: 0,0:15:10.01,0:15:11.84,Flashbacks,Children,0,0,0,,Peki, Monet-san!Dialogue: 0,0:15:13.27,0:15:16.48,Main,Mocha,0,0,0,,O nazik Monet-san da yalan söylüyormuş!Dialogue: 0,0:15:17.67,0:15:20.27,Main,Mocha,0,0,0,,Hepsi yalanmış!Dialogue: 0,0:15:20.27,0:15:23.87,Flashbacks,Monet,0,0,0,,Tedavi konusunda çok çalıştığınız için size bir ödül bu.Dialogue: 0,0:15:23.87,0:15:27.01,Flashbacks,Monet,0,0,0,,Master yolladı bu şekeri size.Dialogue: 0,0:15:27.01,0:15:32.83,Main,Mocha,0,0,0,,Hepimiz buradan kaçalım, yalvarıyorum kendinize gelin!Dialogue: 0,0:15:36.75,0:15:39.07,Main,Nami,0,0,0,,Çocuklara yetişmemiz lazım!Dialogue: 0,0:15:39.07,0:15:40.00,Main,Chopper,0,0,0,,Size güveniyorum.Dialogue: 0,0:15:42.11,0:15:43.85,Main,Zoro,0,0,0,,Seni adi kadın!Dialogue: 0,0:15:43.85,0:15:45.61,Main,Zoro,0,0,0,,Ne haltlar karıştırıyorsun?!Dialogue: 0,0:15:45.61,0:15:49.41,Main,Nami,0,0,0,,Bekle bir saniye! Neden buraya geliyorsun?!Dialogue: 0,0:15:49.41,0:15:51.12,Main,Chopper,0,0,0,,Bekle, Nami! Dur!Dialogue: 0,0:15:51.46,0:15:53.44,Main,Chopper,0,0,0,,Beni kalkan olarak kullanma!Dialogue: 0,0:15:57.46,0:15:58.69,Main,Monet,0,0,0,,Tüh, kaçırdım.Dialogue: 0,0:15:59.47,0:16:01.48,Main,Zoro,0,0,0,,Neden güçsüzleri hedef alıyorsun?Dialogue: 0,0:16:07.13,0:16:08.72,Main,Nami,0,0,0,,Çekil, Zoro!Dialogue: 0,0:16:11.26,0:16:12.63,Main,Nami,0,0,0,,Heat Egg! Dialogue: 0,0:16:11.26,0:16:12.63,Attack,Nami,0,0,0,,Isı YumurtasıDialogue: 0,0:16:16.28,0:16:18.22,Main,Nami,0,0,0,,Düşündüğüm gibi ısı işe yarıyormuş!Dialogue: 0,0:16:18.82,0:16:20.89,Main,Nami,0,0,0,,Peşimizden gelmeye kalkma sakın!Dialogue: 0,0:16:20.89,0:16:25.09,Main,Monet,0,0,0,,16 milyon beli ödülü olan Hırsız Kedi.Dialogue: 0,0:16:26.45,0:16:28.03,Main,Zoro,0,0,0,,Kahretsin, yine kara saklandı!Dialogue: 0,0:16:28.03,0:16:31.00,Main,Zoro,0,0,0,,Savaşmak istemiyor musun sen be, Kar Kadın?!Dialogue: 0,0:16:32.32,0:16:33.20,Main,Nami,0,0,0,,Çıkış!Dialogue: 0,0:16:33.20,0:16:34.24,Main,Robin,0,0,0,,Olamaz!Dialogue: 0,0:16:37.33,0:16:38.37,Main,Monet,0,0,0,,Yuki Gaki! Dialogue: 0,0:16:37.33,0:16:38.37,Attack,Monet,0,0,0,,Kar DuvarıDialogue: 0,0:16:39.85,0:16:40.56,Main,Monet,0,0,0,,Mannen Yuki! Dialogue: 0,0:16:39.85,0:16:40.56,Attack,Monet,0,0,0,,Daimi KarDialogue: 0,0:16:40.56,0:16:41.70,Main,Robin,0,0,0,,Nami!Dialogue: 0,0:16:41.70,0:16:42.94,Main,Nami,0,0,0,,Kar...Dialogue: 0,0:16:42.94,0:16:45.59,Main,Nami,0,0,0,,Çok soğuk! Hareket edemiyorum!Dialogue: 0,0:16:50.36,0:16:51.83,Main,Zoro,0,0,0,,Yine peşlerinden gitti!Dialogue: 0,0:16:51.83,0:16:53.17,Main,Nami,0,0,0,,Dikkat et, Chopper!Dialogue: 0,0:16:57.57,0:16:58.83,Main,Robin,0,0,0,,Cuatro Mano!Dialogue: 0,0:16:57.57,0:16:58.83,Attack,Robin,0,0,0,,Dört El!Dialogue: 0,0:16:59.58,0:17:00.60,Main,Robin,0,0,0,,Spank!Dialogue: 0,0:16:59.58,0:17:00.60,Attack,Robin,0,0,0,,Şaplak!Dialogue: 0,0:17:06.92,0:17:07.42,Main,Robin,0,0,0,,Nami!Dialogue: 0,0:17:09.67,0:17:11.40,Main,Chopper,0,0,0,,Korkunçtu.Dialogue: 0,0:17:12.01,0:17:13.16,Main,Monet,0,0,0,,Ne zahmetliymiş.Dialogue: 0,0:17:14.59,0:17:18.19,Main,Monet,0,0,0,,O çocuklar Master'ın çok değerli kobayları...Dialogue: 0,0:17:18.86,0:17:23.95,Main,Monet,0,0,0,,...ve benim görevim Caesar'ı ve deneyini korumak.Dialogue: 0,0:17:24.36,0:17:27.64,Main,Monet,0,0,0,,Mocha'yı bize karşı doldurup isyan ettiren kimdi?Dialogue: 0,0:17:27.64,0:17:28.60,Main,Chopper,0,0,0,,Ne dedin?Dialogue: 0,0:17:28.61,0:17:31.33,Main,Chopper,0,0,0,,Çocukların kendileri bizden onları kurtarmamızı istedi!Dialogue: 0,0:17:31.33,0:17:33.64,Main,Zoro,0,0,0,,Çekilin oradan!Dialogue: 0,0:17:37.17,0:17:38.41,Main,Zoro,0,0,0,,Gidin hadi!Dialogue: 0,0:17:39.97,0:17:41.22,Main,Robin,0,0,0,,Acele etmeliyiz!Dialogue: 0,0:17:41.22,0:17:41.92,Main,Nami,0,0,0,,Evet!Dialogue: 0,0:17:41.92,0:17:44.51,Main,Chopper,0,0,0,,Mocha, biraz daha dayan!Dialogue: 0,0:17:46.55,0:17:48.50,Main,Monet,0,0,0,,Bu ne terbiyesizlik!Dialogue: 0,0:17:48.50,0:17:53.27,Main,Monet,0,0,0,,Biz her gün büyük bir şefkatle...Dialogue: 0,0:17:53.27,0:17:56.80,Main,Monet,0,0,0,,...rahat içinde yaşamaları için çabalarken...Dialogue: 0,0:17:58.11,0:18:03.27,Main,Monet,0,0,0,,...sizlerse biz koruyucu ailelerinden o değerli hazineleri almaya çalışıyorsunuz.Dialogue: 0,0:18:05.36,0:18:07.26,Main,Monet,0,0,0,,Sizler tıpkı korsanlar gibisiniz.Dialogue: 0,0:18:08.11,0:18:11.06,Main,Zoro,0,0,0,,Aynı fikirdeymişiz gibi görünüyor.Dialogue: 0,0:18:11.06,0:18:13.15,Main,Monet,0,0,0,,Sana bunun terbiyesizlik olduğunu söylemiştim.Dialogue: 0,0:18:13.49,0:18:15.51,Main,Monet,0,0,0,,İşime karışmayı kes.Dialogue: 0,0:18:16.77,0:18:17.88,Main,Monet,0,0,0,,Tabira Yuki! Dialogue: 0,0:18:16.77,0:18:17.88,Attack,Monet,0,0,0,,Kar KılıcıDialogue: 0,0:18:19.54,0:18:20.68,Main,Monet,0,0,0,,Hada Gatana! Dialogue: 0,0:18:19.54,0:18:20.68,Attack,Monet,0,0,0,,Deri KılıcıDialogue: 0,0:18:26.15,0:18:30.02,Main,Monet,0,0,0,,Sadece saldırılarımı engelliyorsun.Dialogue: 0,0:18:30.02,0:18:33.28,Main,Monet,0,0,0,,Neden saldırmıyorsun?Dialogue: 0,0:18:33.28,0:18:36.44,Main,Monet,0,0,0,,Dürüst olmak gerekirse seni yenebileceğimi düşünmemiştim...Dialogue: 0,0:18:36.99,0:18:39.33,Main,Monet,0,0,0,,...ama belki de mümkündür.Dialogue: 0,0:18:40.00,0:18:41.67,Main,Marines,0,0,0,,Arka tarafta başka bir oda daha var!Dialogue: 0,0:18:41.67,0:18:44.74,Main,Marines,0,0,0,,Çocukları bulup çıkartın onları buradan!Dialogue: 0,0:18:44.74,0:18:46.43,Main,Marines,0,0,0,,Burası biraz soğuk değil mi?!Dialogue: 0,0:18:46.43,0:18:47.66,Main,Zoro,0,0,0,,Donanma mı?!Dialogue: 0,0:18:47.66,0:18:50.17,Main,Sanji,0,0,0,,Şuradaki kapıdan geçelim!Dialogue: 0,0:18:50.17,0:18:54.14,Main,Monet,0,0,0,,Herkes de çocukları kaçırmaya çalışıyor.Dialogue: 0,0:18:54.14,0:18:55.22,Main,Monet,0,0,0,,Kimsenin onları almasına izin vermeyeceğim.Dialogue: 0,0:18:55.22,0:18:56.92,Main,Sanji,0,0,0,,Tam gaz ileri!Dialogue: 0,0:18:58.20,0:19:00.56,Main,Zoro,0,0,0,,Neden başlarında sen varsın be?!Dialogue: 0,0:19:01.02,0:19:04.80,Main,Marine,0,0,0,,Abi, çocuklar burada değil ama Korsan Avcısı Zoro burada!Dialogue: 0,0:19:05.96,0:19:07.87,Main,Sanji,0,0,0,,Kibirli pisliğin tekidir.Dialogue: 0,0:19:09.28,0:19:11.12,Main,Sanji,0,0,0,,Pekâlâ millet!Dialogue: 0,0:19:11.12,0:19:14.19,Main,Sanji,0,0,0,,Alt dudağınızı çekip onunla dalga geçin!Dialogue: 0,0:19:17.15,0:19:21.11,Main,Zoro,0,0,0,,Umarım hepsi karda kayıp, kafalarını vurup ölürler.Dialogue: 0,0:19:22.79,0:19:25.89,Main,Zoro,0,0,0,,Nami'yle Robin önden gittiler.Dialogue: 0,0:19:25.89,0:19:27.61,Main,Zoro,0,0,0,,İşime engel oluyorsunuz, hadi çabucak uzayın.Dialogue: 0,0:19:27.61,0:19:31.78,Main,Sanji,0,0,0,,Aptalın teki olmana rağmen güzel bir bilgiydi bu!Dialogue: 0,0:19:31.78,0:19:33.87,Main,Sanji,0,0,0,,Pekâlâ, gidelim mil-Dialogue: 0,0:19:34.54,0:19:37.80,Main,Sanji,0,0,0,,Arkasındaki seksi güzel kız da kim?Dialogue: 0,0:19:37.80,0:19:39.74,Main,Marines,0,0,0,,Gerçekten mi?!Dialogue: 0,0:19:37.80,0:19:39.74,Secondary,Marines,0,0,0,,Acayip şirinmiş!Dialogue: 0,0:19:39.74,0:19:43.37,Main,Zoro,0,0,0,,Çok sinir bozucusunuz! Hadi defolun şuradan!Dialogue: 0,0:19:44.63,0:19:49.19,Main,Marine,0,0,0,,Şuna bakın. İnsana benzemiyor.Dialogue: 0,0:19:49.19,0:19:50.62,Main,Marine,0,0,0,,İnsan yüzlü bir kuş mu?Dialogue: 0,0:19:50.62,0:19:52.13,Main,Marine,0,0,0,,Harpia bu!Dialogue: 0,0:19:53.27,0:19:54.94,Main,Marine,0,0,0,,A-Ama...Dialogue: 0,0:19:54.94,0:19:57.70,Main,Marine,0,0,0,,...yine de çok şirin!Dialogue: 0,0:19:57.70,0:19:59.57,Main,Marine,0,0,0,,Aslında bu onu daha da sevimli yapıyor.Dialogue: 0,0:19:59.57,0:20:01.52,Main,Marine,0,0,0,,Çok seksi!Dialogue: 0,0:20:02.41,0:20:06.06,Main,Zoro,0,0,0,,İltifatlara karşı zaafın mı var?!Dialogue: 0,0:20:06.06,0:20:09.29,Main,Marine,0,0,0,,O değil de neden kar yağıyor burada?Dialogue: 0,0:20:10.26,0:20:16.96,Main,Monet,0,0,0,,Kim olursa olsun,  kimsenin çocukları almasına izin vermeyeceğim.Dialogue: 0,0:20:33.95,0:20:35.99,Main,Marine,0,0,0,,Omzuma ne oldu?!Dialogue: 0,0:20:36.44,0:20:38.21,Main,Marine,0,0,0,,Seni şıllık!Dialogue: 0,0:20:47.45,0:20:48.93,Main,Marine,0,0,0,,O bir Logia!Dialogue: 0,0:20:50.33,0:20:52.00,Main,Zoro,0,0,0,,Lanet olası kadın.Dialogue: 0,0:20:59.61,0:21:01.29,Main,Monet,0,0,0,,Haki kullanan bir kılıç ustası mı?!Dialogue: 0,0:21:04.39,0:21:06.51,Main,Marines,0,0,0,,Albay-chan!Dialogue: 0,0:21:06.51,0:21:09.98,Main,Tashigi,0,0,0,,Gazın bu odaya girmesini şimdilik engelledik.Dialogue: 0,0:21:12.06,0:21:16.66,Main,Tashigi,0,0,0,,Ama yine sızdırmaya başlamayacağının bir garantisi yok.Dialogue: 0,0:21:16.66,0:21:21.39,Main,Tashigi,0,0,0,,Fazla vaktimiz yok. Herkes çocukların peşinden gitsin!Dialogue: 0,0:21:22.21,0:21:23.41,Main,Marine,0,0,0,,Sen ne yapacaksın?Dialogue: 0,0:21:24.81,0:21:27.11,Main,Tashigi,0,0,0,,Ben burada kalıyorum!Dialogue: 0,0:21:28.28,0:21:31.27,Main,Tashigo,0,0,0,,Burada bana ihtiyaç olduğunu hissettim.Dialogue: 0,0:21:31.64,0:21:33.41,Main,Zoro,0,0,0,,Ha?!Dialogue: 0,0:00:24.14,0:00:27.40,Credits,,0,0,0,,Translation & initial syncing Yibis FansubsDialogue: 0,0:00:27.61,0:00:30.69,Credits,,0,0,0,,Syncing Galaxy 9000  Sync-checking SewilDialogue: 0,0:00:31.16,0:00:34.27,Credits,,0,0,0,,Quality-checking SewilDialogue: 0,0:00:34.82,0:00:38.39,Credits,,0,0,0,,Soundtracking HaleeDialogue: 0,0:00:41.42,0:00:43.62,Credits,,0,0,0,,Video editing SewilDialogue: 0,0:00:00.20,0:00:05.07,Hands Up lyrics,,0,0,0,,♪ Kaldır ellerini daha da yukarıya, hayallerini dök şarkılara. ♪Dialogue: 0,0:00:05.14,0:00:08.72,Hands Up lyrics,,0,0,0,,♪ Yıkılma hiçbir zaman, sarsılmaz bayrağını kaldır göklere. ♪Dialogue: 0,0:00:08.80,0:00:12.27,Hands Up lyrics,,0,0,0,,♪ Buralara kadar gelebilmek için pek çok duvarı yıkıp geçtik! ♪Dialogue: 0,0:00:12.34,0:00:17.68,Hands Up lyrics,,0,0,0,,♪ Hedef gelecek, haydi eller havaya!! ♪Dialogue: 0,0:00:23.31,0:00:30.66,Hands Up lyrics,,0,0,0,,♪ Uzansam biraz daha erişeceğim hemen cevaba. ♪Dialogue: 0,0:00:30.73,0:00:38.37,Hands Up lyrics,,0,0,0,,♪ İnanarak buna açılıyorum yeni dünyaya. ♪Dialogue: 0,0:00:38.40,0:00:45.86,Hands Up lyrics,,0,0,0,,♪ Aynen öyle, yapboz gibi birleşti hayal kırıntılarımız. ♪Dialogue: 0,0:00:45.91,0:00:50.41,Hands Up lyrics,,0,0,0,,♪ Aramızda hiç kopmayacak bağlar yaratarak,...Dialogue: 0,0:00:51.18,0:00:53.51,Hands Up lyrics,,0,0,0,,...daha aydınlık bir geleceğe. ♪Dialogue: 0,0:00:54.00,0:00:58.55,Hands Up lyrics,,0,0,0,,♪ Kaldır ellerini daha da yukarıya, hayallerini dök şarkılara. ♪Dialogue: 0,0:00:58.62,0:01:02.42,Hands Up lyrics,,0,0,0,,♪ Yıkılma hiçbir zaman, sarsılmaz bayrağını kaldır göklere. ♪Dialogue: 0,0:01:02.43,0:01:05.78,Hands Up lyrics,,0,0,0,,♪ Buralara kadar gelebilmek için pek çok duvarı yıkıp geçtik! ♪Dialogue: 0,0:01:05.83,0:01:09.80,Hands Up lyrics,,0,0,0,,♪ Hedefimiz gelecek! ♪Dialogue: 0,0:01:09.87,0:01:11.30,Hands Up lyrics,,0,0,0,,♪ Daha da yukarıya bak! ♪Dialogue: 0,0:01:11.34,0:01:13.48,Hands Up lyrics,,0,0,0,,♪ Sırtın hep dik olsun! ♪Dialogue: 0,0:01:13.53,0:01:14.94,Hands Up lyrics,,0,0,0,,♪ Bir an olsun durma! ♪Dialogue: 0,0:01:14.99,0:01:16.82,Hands Up lyrics,,0,0,0,,♪ Dalgaları aşa aşa! ♪Dialogue: 0,0:01:16.86,0:01:20.41,Hands Up lyrics,,0,0,0,,♪ Arzularımız birleşiyor yavaşça. ♪Dialogue: 0,0:01:20.44,0:01:24.65,Hands Up lyrics,,0,0,0,,♪ Haydi ilerisini hedef seçelim kendimize! ♪Dialogue: 0,0:01:24.91,0:01:31.06,Hands Up lyrics,,0,0,0,,♪ Dalgaları sürerek, akıyoruz ileriye. ♪Dialogue: 0,0:01:31.09,0:01:35.34,Hands Up lyrics,,0,0,0,,♪ İnsanlarla tanışıyor, elvedalar ediyoruz,...Dialogue: 0,0:01:35.36,0:01:39.09,Hands Up lyrics,,0,0,0,,...bir kez daha bu bayrağın altında. ♪Dialogue: 0,0:01:41.26,0:01:45.04,Hands Up lyrics,,0,0,0,,♪ Unutmak istemediğim acıları...Dialogue: 0,0:01:45.06,0:01:48.08,Hands Up lyrics,,0,0,0,,...o gün yüreğime gömdüm, saklıyorum orada. ♪Dialogue: 0,0:01:48.27,0:01:52.34,Hands Up lyrics,,0,0,0,,♪ Kimselere yenilmeyecek bir özgürlük bizimkisi,...Dialogue: 0,0:01:52.46,0:01:54.75,Hands Up lyrics,,0,0,0,,...sıkıca kavrayıp yoluma atıldığım. ♪Dialogue: 0,0:01:54.77,0:01:59.69,Hands Up lyrics,,0,0,0,,♪ Kaldır ellerini daha da yukarıya, hayallerini dök şarkılara. ♪Dialogue: 0,0:01:59.72,0:02:03.37,Hands Up lyrics,,0,0,0,,♪ Yıkılma hiçbir zaman, sarsılmaz bayrağını kaldır göklere. ♪Dialogue: 0,0:02:03.41,0:02:06.66,Hands Up lyrics,,0,0,0,,♪ Buralara kadar gelebilmek için pek çok duvarı yıkıp geçtik! ♪Dialogue: 0,0:02:06.69,0:02:10.83,Hands Up lyrics,,0,0,0,,♪ Hedefimiz gelecek! ♪Dialogue: 0,0:02:10.88,0:02:12.20,Hands Up lyrics,,0,0,0,,♪ Daha da yukarıya bak! ♪Dialogue: 0,0:02:12.25,0:02:14.53,Hands Up lyrics,,0,0,0,,♪ Sırtın hep dik olsun! ♪Dialogue: 0,0:02:14.53,0:02:15.90,Hands Up lyrics,,0,0,0,,♪ Bir an olsun durma! ♪Dialogue: 0,0:02:15.95,0:02:17.72,Hands Up lyrics,,0,0,0,,♪ Dalgaları aşa aşa! ♪Dialogue: 0,0:02:17.76,0:02:21.43,Hands Up lyrics,,0,0,0,,♪ Arzularımız birleşiyor yavaşça. ♪Dialogue: 0,0:02:21.50,0:02:24.97,Hands Up lyrics,,0,0,0,,♪ Haydi ilerisini hedef seçelim kendimize! ♪Dialogue: 0,0:02:24.99,0:02:29.79,Hands Up lyrics,,0,0,0,,♪ Eller havaya!! ♪