Dialogue: 0,0:02:30.27,0:02:36.01,captions_soft,Caption,0,0,0,,{\fad(600,700)\pos(640,443)\fs45}Punk Hazard Adası   Merkez Göl
Dialogue: 0,0:02:30.27,0:02:36.01,captions_soft,Caption,0,0,0,,{\fad(600,700)\pos(640,483)\fs45}‒ Zoro'nun Grubu ‒
Dialogue: 0,0:02:33.82,0:02:37.82,Main,Brook,0,0,0,,Acaba bu bir Slime olabilir mi?
Dialogue: 0,0:02:37.82,0:02:39.05,Main,Sanji,0,0,0,,Slime mı?
Dialogue: 0,0:02:39.05,0:02:42.72,Main,Brook,0,0,0,,Evet. Okuduğum bir kitapta...
Dialogue: 0,0:02:43.23,0:02:48.35,Main,Brook,0,0,0,,...ismi "Slime" olan aynı böyle\Nbir yaratıktan bahsediyordu.
Dialogue: 0,0:02:50.01,0:02:52.75,Main,Brook,0,0,0,,Müptelası olmuştum kitabın.
Dialogue: 0,0:02:52.75,0:02:56.65,Main,Brook,0,0,0,,Şu slime denen yaratıklar\Nsadece kadınlara saldırıyor...
Dialogue: 0,0:02:56.65,0:03:02.93,Main,Brook,0,0,0,,...ve vücut sıvıları aracılığıyla kıyafetlerini\Neritiyordu! Çok sapık bu canavarlar!
Dialogue: 0,0:03:06.31,0:03:09.03,Main,Sanji,0,0,0,,Böyle gülünç derecede kullanışlı\Nbir canavarı kim uydurabilir ki?!
Dialogue: 0,0:03:09.03,0:03:11.50,Main,Sanji,0,0,0,,Bi-Bir ara\No kitabı ödünç verirsin değil mi?!
Dialogue: 0,0:03:11.50,0:03:12.54,Main,Kinemon,0,0,0,,Ben de istiyorum!
Dialogue: 0,0:03:12.54,0:03:14.72,Main,Zoro,0,0,0,,Aptal herifler, iyice bakın!
Dialogue: 0,0:03:14.72,0:03:16.36,Main,Brook & Sanji,0,0,0,,Söz mü?!
Dialogue: 0,0:03:16.36,0:03:21.05,Main,Zoro,0,0,0,,Kıyafetlerinizi mi eritir artık ne yapar bilmiyorum ama\Nbu şeye dokunmak isteyeceğinizi sanmıyorum.
Dialogue: 0,0:03:21.58,0:03:24.84,Main,Zoro,0,0,0,,Göle düşen vücut sıvıları\Nnedeniyle balıklar ölüyor.
Dialogue: 0,0:03:27.18,0:03:30.23,Main,Zoro,0,0,0,,Anlaşılan zehirli bir şey bu.
Dialogue: 0,0:03:30.23,0:03:32.44,Main,Zoro,0,0,0,,Bir şey yapmazsak zehir tüm göle yayılacak.
Dialogue: 0,0:03:32.91,0:03:34.14,Main,Sanji,0,0,0,,Zehir mi?
Dialogue: 0,0:03:34.14,0:03:37.34,Main,Brook,0,0,0,,Öyleyse Samuray-san'ın gövdesi de...
Dialogue: 0,0:03:45.81,0:03:49.30,Main,Brook,0,0,0,,Sakın bana... onun peşinden\Ngideceğini söyleme Sanji-san!
Dialogue: 0,0:03:49.30,0:03:53.10,Main,Sanji,0,0,0,,Başka bir seçeneğim mi var!\NYapmam gereken bir şey bu!
Dialogue: 0,0:03:54.44,0:03:58.25,Main,Sanji,0,0,0,,Bir erkek olarak yapmam gereken bir şey bu!
Dialogue: 0,0:03:58.90,0:04:00.88,Main,Brook,0,0,0,,Sanji-san!
Dialogue: 0,0:04:00.88,0:04:03.61,Main,Sanji,0,0,0,,Siz ardınızdaki Slimelar'la ilgilenin.
Dialogue: 0,0:04:03.61,0:04:05.48,Main,Brook,0,0,0,,Ne?\NArdımızdaki mi?
Dialogue: 0,0:04:07.55,0:04:11.79,Main,Brook,0,0,0,,Slime kopyaları!\NNe ara geldiler buraya?!
Dialogue: 0,0:04:11.79,0:04:16.39,Main,Sanji,0,0,0,,Bağışla beni, Nami-san.\NYüzme konusunda herkesten daha iyiyim.
Dialogue: 0,0:04:16.90,0:04:20.17,Main,Sanji,0,0,0,,Güzel vücuduna bir zarar gelmeden önce\Nsudan çıkmış olacağım!
Dialogue: 0,0:04:21.98,0:04:24.16,Main,Brook,0,0,0,,Dikkatli olun!
Dialogue: 0,0:04:25.40,0:04:29.34,Thoughts,Sanji,0,0,0,,So-Soğuk kelimesi\Nyetersiz kalıyor resmen!
Dialogue: 0,0:04:29.34,0:04:31.10,Thoughts,Sanji,0,0,0,,Gövdesi nerede bunun?!
Dialogue: 0,0:04:38.97,0:04:40.32,Thoughts,Law,0,0,0,,Monet buradaki tek kişi.
Dialogue: 0,0:04:40.87,0:04:42.53,Thoughts,Law,0,0,0,,Fırsat bu fırsat.
Dialogue: 0,0:04:42.53,0:04:44.53,Main,Monet,0,0,0,,Master'ı arıyorsan o burada değil.
Dialogue: 0,0:04:44.86,0:04:46.84,Main,Law,0,0,0,,Öyle demek, nereye gitti?
Dialogue: 0,0:04:46.84,0:04:52.25,Main,Monet,0,0,0,,Kim bilir? Nasıl sapkın biri olduğunu düşününce\Nmuhtemelen bir yerlerde savaşı izliyordur derim.
Dialogue: 0,0:04:55.21,0:05:00.00,Main,Law,0,0,0,,Bu adada aradığım her şeyi buldum...
Dialogue: 0,0:05:00.00,0:05:03.31,Main,Law,0,0,0,,...bu yüzden yakında ayrılmayı planlıyorum.
Dialogue: 0,0:05:03.31,0:05:05.77,Main,Monet,0,0,0,,Sensiz çok tenha olacak.
Dialogue: 0,0:05:06.63,0:05:09.05,Main,Law,0,0,0,,Yeteneğinin faydalı olabileceği\Nbir konuda yardımını isteyecektim.
Dialogue: 0,0:05:09.05,0:05:10.57,Main,Law,0,0,0,,Benimle gelebilir misin?
Dialogue: 0,0:05:11.14,0:05:13.71,Main,Monet,0,0,0,,Randevu mu yoksa bu? Ne kadar sevimli.
Dialogue: 0,0:05:17.38,0:05:19.53,Main,Monet,0,0,0,,Görüyorum ki her zamanki gibi soğuksun.
Dialogue: 0,0:05:19.53,0:05:20.39,Main,Monet,0,0,0,,Ne lazımdı?
Dialogue: 0,0:05:20.39,0:05:21.88,Main,Law,0,0,0,,Oraya vardığımızda göreceksin.
Dialogue: 0,0:05:21.88,0:05:24.38,Main,Monet,0,0,0,,İyi bakalım!\NSıkılmıştım zaten.
Dialogue: 0,0:05:28.41,0:05:32.21,Thoughts,Chopper,0,0,0,,Usopp'un bahsettiği kuş kadın\Nbu mu acaba?!
Dialogue: 0,0:05:36.53,0:05:40.04,captions_soft,Caption,0,0,0,,{\pos(640,436)\fad(555,0)\fs45}Caesar'ın Laboratuvar   Ana giriş
Dialogue: 0,0:05:36.53,0:05:40.04,captions_soft,Caption,0,0,0,,{\pos(640,477)\fad(555,0)\fs45}‒ Luffy'nin Grubu ‒
Dialogue: 0,0:05:37.35,0:05:40.03,Main,Man,0,0,0,,H-Hasır Şapka Master'ı yakaladı!
Dialogue: 0,0:05:40.03,0:05:41.99,Main,Franky,0,0,0,,Helal Luffy!
Dialogue: 0,0:05:41.99,0:05:44.00,Main,Centaur,0,0,0,,Lanet olsun!\NAdi herif!
Dialogue: 0,0:05:44.00,0:05:45.33,Main,Smoker,0,0,0,,Hasır Şapka!
Dialogue: 0,0:05:46.23,0:05:48.00,Main,Caesar,0,0,0,,Bırak beni pislik!
Dialogue: 0,0:05:48.00,0:05:48.57,Main,Luffy,0,0,0,,Hayatta olmaz!
Dialogue: 0,0:05:49.02,0:05:50.75,Main,Franky,0,0,0,,Demek Haki böyle bir şey?
Dialogue: 0,0:05:50.75,0:05:52.92,Main,Franky,0,0,0,,Bizim Luffy harika gerçekten.
Dialogue: 0,0:05:52.92,0:05:55.55,Main,Franky,0,0,0,,Logia türü birini kavradı resmen.
Dialogue: 0,0:05:55.55,0:05:58.89,Main,Centaur,0,0,0,,Hasır Şapka!\NMaster'dan uzaklaş!
Dialogue: 0,0:05:58.89,0:06:00.80,Main,Centaur,0,0,0,,Master'ı kurtarmalıyız!
Dialogue: 0,0:06:00.80,0:06:04.76,Main,Franky,0,0,0,,Sizinle ben ilgileneceğim!
Dialogue: 0,0:06:04.77,0:06:05.75,Main,Robin,0,0,0,,{\fad(150,150)}Clutch!
Dialogue: 0,0:06:04.77,0:06:05.75,Attack,Robin,0,0,0,,{\fad(150,150)}Kavrama!
Dialogue: 0,0:06:06.89,0:06:07.97,Main,Smoker,0,0,0,,Çekilin yolumdan!
Dialogue: 0,0:06:10.45,0:06:13.06,Main,Franky,0,0,0,,Luffy şimdiki haliyle\No herifi kolayca yener!
Dialogue: 0,0:06:13.78,0:06:16.17,Main,Robin,0,0,0,,Orası henüz belli olmaz.
Dialogue: 0,0:06:16.97,0:06:23.56,Main,Robin,0,0,0,,Silahlanma hakisiyle normalde dokunamayacağın\NLogia türü kişilere saldırmak mümkün...
Dialogue: 0,0:06:24.25,0:06:30.35,Main,Robin,0,0,0,,...ama deniz veya deniz taşı gibi\Nkişi gücünü kaybetmiyor.
Dialogue: 0,0:06:31.15,0:06:36.82,Main,Robin,0,0,0,,Gaz Gaz Meyvesi'nin\Nnelere kadir olduğunu henüz bilmiyoruz.
Dialogue: 0,0:06:40.15,0:06:43.29,Main,Caesar,0,0,0,,Hemen havalara girme!
Dialogue: 0,0:06:44.32,0:06:46.11,Main,Luffy,0,0,0,,{\fad(150,150)}Silahlanma Hakisi!
Dialogue: 0,0:06:47.62,0:06:48.84,Main,Luffy,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:06:49.37,0:06:50.43,Main,Luffy,0,0,0,,{\fad(150,150)}...Kane! {Çan}
Dialogue: 0,0:06:49.37,0:06:50.43,Attack,Luffy,0,0,0,,{\fad(150,150)}...Çan
Dialogue: 0,0:06:51.84,0:06:53.11,Main,,0,0,0,,{\fad(150,150)}Gas Robe! {Gaz Elbisesi}
Dialogue: 0,0:06:51.84,0:06:53.11,Attack,,0,0,0,,{\fad(150,150)}Gaz Elbisesi
Dialogue: 0,0:06:54.85,0:06:56.47,Main,Luffy,0,0,0,,Bu ne?
Dialogue: 0,0:06:56.47,0:06:58.11,Main,Luffy,0,0,0,,Etrafımı sarıyor! Çıkaramıyorum!
Dialogue: 0,0:06:59.44,0:07:02.27,Main,Caesar,0,0,0,,Nefesini daha ne kadar\Ntutabileceğini sanıyorsun?!
Dialogue: 0,0:07:03.82,0:07:07.94,Main,Caesar,0,0,0,,Derin bir nefes al ve geber!
Dialogue: 0,0:07:07.94,0:07:08.83,Main,Robin,0,0,0,,Luffy!
Dialogue: 0,0:07:08.83,0:07:09.61,Main,Franky,0,0,0,,Kahretsin!
Dialogue: 0,0:07:09.61,0:07:16.95,Main,Caesar,0,0,0,,Sayısız deneyin ardından nihayetinde\Nen ölümcül gazı bulmayı başardım!
Dialogue: 0,0:07:23.06,0:07:24.67,Main,Centaur,0,0,0,,Delirdi mi bu?!
Dialogue: 0,0:07:24.67,0:07:27.66,Main,Centaur,0,0,0,,Master'ın zehirli gazını\Nbile bile içine çekiyor!
Dialogue: 0,0:07:30.72,0:07:32.13,Main,Centaur,0,0,0,,Hepsini içine çekti!
Dialogue: 0,0:07:32.13,0:07:33.25,Main,Centaur,0,0,0,,Ölmesi an meselesi!
Dialogue: 0,0:07:45.36,0:07:48.54,Main,Luffy,0,0,0,,Sanırım zehir artık beni pek etkilemiyor.
Dialogue: 0,0:07:49.28,0:07:51.02,Main,Luffy,0,0,0,,Magellan sağ olsun.
Dialogue: 0,0:07:53.44,0:07:55.26,Main,Caesar,0,0,0,,Magellan mı?!
Dialogue: 0,0:07:55.26,0:07:57.74,Main,Caesar,0,0,0,,Impel Down'daki\Nzehir adamı mı diyorsun?!
Dialogue: 0,0:07:57.74,0:08:00.64,Main,Caesar,0,0,0,,Beni öyle Paramecia tipi biriyle\Naynı kefeye koyma!
Dialogue: 0,0:08:00.64,0:08:02.32,Main,Luffy,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:08:04.39,0:08:06.75,Main,,0,0,0,,{\fad(150,150)}...Jet Mace! {Jet Topuz}
Dialogue: 0,0:08:04.39,0:08:06.75,Attack,,0,0,0,,{\fad(150,150)}...Jet Topuz
Dialogue: 0,0:08:12.69,0:08:14.01,Main,Centaur,0,0,0,,{\i1}Master!
Dialogue: 0,0:08:14.02,0:08:17.01,Main,Centaur,0,0,0,,Adi herif!\NMaster'ımıza ne yapıyor öyle?!
Dialogue: 0,0:08:19.29,0:08:21.56,Main,Caesar,0,0,0,,Karışayım demeyin, ezik herifler!
Dialogue: 0,0:08:21.56,0:08:24.31,Main,Centaur,0,0,0,,Ez-Ezik herifler mi?!
Dialogue: 0,0:08:31.70,0:08:34.63,Main,Centaur,0,0,0,,Bize ezik herifler mi dedi?!
Dialogue: 0,0:08:34.63,0:08:35.67,Main,Centaur,0,0,0,,Yanlış duymuş olmalısın!
Dialogue: 0,0:08:35.99,0:08:37.41,Main,Luffy,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:08:37.75,0:08:38.74,Main,Caesar,0,0,0,,Gel bakalım!
Dialogue: 0,0:08:38.94,0:08:41.12,Main,Luffy,0,0,0,,{\fad(150,150)}Gatling! {Mitralyöz}
Dialogue: 0,0:08:38.94,0:08:41.12,Attack,Luffy,0,0,0,,{\fad(150,150)}Mitralyöz
Dialogue: 0,0:08:41.12,0:08:43.16,Main,Caesar,0,0,0,,{\fad(150,150)}Gastanet! {Gaz Kastanyeti}
Dialogue: 0,0:08:41.12,0:08:43.16,Attack,Caesar,0,0,0,,{\fad(150,150)}Gaz Kastanyeti
Dialogue: 0,0:09:02.89,0:09:04.11,Main,Robin & Franky,0,0,0,,Luffy!
Dialogue: 0,0:09:04.11,0:09:05.56,Main,Centaur,0,0,0,,Helal Master!
Dialogue: 0,0:09:06.12,0:09:09.19,Main,Caesar,0,0,0,,Artık işini bitirmenin zamanı geldi.
Dialogue: 0,0:09:09.19,0:09:12.31,Main,Caesar,0,0,0,,Smileyler, uyanın!
Dialogue: 0,0:09:12.32,0:09:13.92,Main,Tashigi,0,0,0,,Smileyler mi?
Dialogue: 0,0:09:20.62,0:09:23.09,Main,Franky,0,0,0,,Ne?!\NBirden hareket etmeye başladılar!
Dialogue: 0,0:09:23.09,0:09:27.49,Main,Caesar,0,0,0,,Smileyler, Hasır Şapka'ya yapışın!
Dialogue: 0,0:09:27.49,0:09:29.03,Main,Caesar,0,0,0,,Sıçrayın hadi!
Dialogue: 0,0:09:33.55,0:09:35.66,Main,Centaur,0,0,0,,Bu şeyler neden Master'a\Nitaat ediyorlar?!
Dialogue: 0,0:09:40.11,0:09:43.63,Main,Franky,0,0,0,,Luffy, dikkat et!\NPatlıyorlar!
Dialogue: 0,0:09:46.29,0:09:47.13,Main,Robin,0,0,0,,Luffy!
Dialogue: 0,0:09:47.13,0:09:49.18,Main,Caesar,0,0,0,,Onu parçalara ayır!
Dialogue: 0,0:09:49.43,0:09:51.70,Main,Caesar,0,0,0,,{\fad(150,150)}Gastanet! {Gaz Kastanyeti}
Dialogue: 0,0:09:49.43,0:09:51.70,Attack,Caesar,0,0,0,,{\fad(150,150)}Gaz Kastanyeti
Dialogue: 0,0:10:04.47,0:10:06.06,Main,Franky,0,0,0,,Luffy!
Dialogue: 0,0:10:34.17,0:10:36.52,Main,Luffy,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:10:39.43,0:10:41.24,Main,Luffy,0,0,0,,{\fad(150,150)}Jet Stamp! {Jet Damgası}
Dialogue: 0,0:10:39.43,0:10:41.24,Attack,Luffy,0,0,0,,{\fad(150,150)}Jet Damgası
Dialogue: 0,0:10:48.31,0:10:51.31,Main,Centaur,0,0,0,,{\i1}M-Master!
Dialogue: 0,0:10:52.47,0:10:55.84,Main,Luffy,0,0,0,,Ne patlamaydı ama var ya!
Dialogue: 0,0:10:55.84,0:11:00.87,Main,Franky,0,0,0,,O patlamadan kaçabilmiş demek?! \NNe hızdır bu böyle!
Dialogue: 0,0:11:01.33,0:11:02.31,Main,Robin,0,0,0,,Şükürler olsun.
Dialogue: 0,0:11:02.31,0:11:04.15,Main,Marine,0,0,0,,Ha-Hasır Şapka mı?!
Dialogue: 0,0:11:04.15,0:11:05.68,Main,Marine,0,0,0,,Ölümsüz mü bu herif?!
Dialogue: 0,0:11:06.73,0:11:07.73,Main,Luffy,0,0,0,,Hadi bakalım!
Dialogue: 0,0:11:09.03,0:11:10.36,Main,Centaur,0,0,0,,Master'ımıza ne cüretle vurursun?!
Dialogue: 0,0:11:10.36,0:11:11.90,Main,Luffy,0,0,0,,Çekilin yolumdan!
Dialogue: 0,0:11:16.83,0:11:20.46,Main,Luffy,0,0,0,,Tamamdır, bu sefer cidden yakaladım!
Dialogue: 0,0:11:20.46,0:11:22.01,Main,Centaur,0,0,0,,{\i1}Master!
Dialogue: 0,0:11:22.01,0:11:25.75,Main,Luffy,0,0,0,,Robin, Franky! Bu adamı içine\Nkoyabileceğimiz bir şeyler var mı?
Dialogue: 0,0:11:26.20,0:11:28.18,Main,Luffy,0,0,0,,Logia türü olduğundan\Nbağlasak durmayacak şimdi.
Dialogue: 0,0:11:28.18,0:11:31.04,Main,Franky,0,0,0,,Fıçı falan var mıdır acaba buralarda?
Dialogue: 0,0:11:31.04,0:11:33.46,Main,Marine,0,0,0,,Dur bakalım Hasır Şapka!
Dialogue: 0,0:11:33.46,0:11:38.30,Main,Marine,0,0,0,,Biz Donanma G-5'i olarak o adamı\Ngöz altına alacak, sizi de tutuklayacağız!
Dialogue: 0,0:11:38.76,0:11:41.28,Main,Marine,0,0,0,,Kendinizi hazırlayın!
Dialogue: 0,0:11:41.28,0:11:44.53,Main,Tashigi,0,0,0,,Smoker-san,\NHasır Şapkalar Caesar'ı yakaladı!
Dialogue: 0,0:11:49.74,0:11:50.23,Main,Smoker,0,0,0,,Hasır Şapka?
Dialogue: 0,0:11:55.67,0:11:56.64,Main,Robin,0,0,0,,Luffy?
Dialogue: 0,0:12:11.78,0:12:13.55,Main,Caesar,0,0,0,,Beni hafife almayacaktın!
Dialogue: 0,0:12:37.40,0:12:40.62,captions_soft,Caption,0,0,0,,{\pos(640,441)\fad(555,0)\fs45}Laboratuvarın İçi
Dialogue: 0,0:12:37.40,0:12:40.62,captions_soft,Caption,0,0,0,,{\pos(640,483)\fad(555,0)\fs45}‒ Law'un Grubu ‒
Dialogue: 0,0:12:39.11,0:12:40.06,Main,Monet,0,0,0,,Law?
Dialogue: 0,0:12:42.74,0:12:43.87,Main,Law,0,0,0,,Kim var orada?
Dialogue: 0,0:12:43.87,0:12:45.33,Main,Monet,0,0,0,,Sorun nedir?
Dialogue: 0,0:12:46.40,0:12:49.73,Main,Monet,0,0,0,,Acı çekiyor gibisin.
Dialogue: 0,0:12:55.25,0:12:58.43,Main,Law,0,0,0,,Kim var orada dedim?!
Dialogue: 0,0:12:59.55,0:13:00.31,Main,Vergo,0,0,0,,Benim.
Dialogue: 0,0:13:05.14,0:13:07.36,Main,Law,0,0,0,,Burada...
Dialogue: 0,0:13:08.89,0:13:10.94,Main,Law,0,0,0,,...ne yapıyorsun?!?!
Dialogue: 0,0:13:17.67,0:13:19.76,Main,Vergo,0,0,0,,Kaç yıl oldu?
Dialogue: 0,0:13:21.06,0:13:24.90,Main,Vergo,0,0,0,,Büyümüşsün, Law.
Dialogue: 0,0:13:40.28,0:13:44.57,Main,Vergo,0,0,0,,Gerçekten onun neyin peşinde\Nolduğunu bilmediğini mi düşündün?
Dialogue: 0,0:13:48.23,0:13:51.64,Main,Vergo,0,0,0,,Caesar'a biz de güvenmiyoruz.
Dialogue: 0,0:13:51.64,0:13:56.82,Main,Vergo,0,0,0,,Bu yüzden de\Ntedbir olarak gizli bir ajan...
Dialogue: 0,0:13:56.82,0:13:58.31,Main,Vergo,0,0,0,,...yani Monet'i gönderdi.
Dialogue: 0,0:14:00.58,0:14:03.16,Main,Vergo,0,0,0,,Artık Shichibukailer'den biri\Nolduğunu duydum.
Dialogue: 0,0:14:03.96,0:14:05.73,Main,Vergo,0,0,0,,Ne kadar kudretli oldun.
Dialogue: 0,0:14:08.72,0:14:10.60,Main,Law,0,0,0,,Ne zaman geldin...
Dialogue: 0,0:14:11.91,0:14:12.64,Main,Law,0,0,0,,...Vergo?!
Dialogue: 0,0:14:12.95,0:14:15.22,Main,Vergo,0,0,0,,Az önce geldim.
Dialogue: 0,0:14:15.22,0:14:18.10,Main,Vergo,0,0,0,,Şansıma Dressrosa'daydım.
Dialogue: 0,0:14:18.10,0:14:21.63,Main,Vergo,0,0,0,,Ayrılmak üzere olan bir S.A.D. tankerinde\Nkendime yer bulabildim.
Dialogue: 0,0:14:22.50,0:14:24.56,Main,Vergo,0,0,0,,Çok da iyi yapmışım.
Dialogue: 0,0:14:24.56,0:14:26.95,Main,Law,0,0,0,,Neymiş çok iyi olan!?
Dialogue: 0,0:14:27.70,0:14:30.95,Main,Law,0,0,0,,Size kötü bir şey mi yaptım!?
Dialogue: 0,0:14:30.95,0:14:35.40,Main,Vergo,0,0,0,,Yapmış olsaydın zaten\Nşimdi yaşıyor olmazdın.
Dialogue: 0,0:14:35.40,0:14:39.86,Main,Vergo,0,0,0,,Büyüklerini kolay kolay kandıramazsın, Law.
Dialogue: 0,0:14:41.37,0:14:46.27,Main,Law,0,0,0,,Madem öyle seni kesmekten başka\Nbir seçeneğim kalmıyor!
Dialogue: 0,0:14:47.05,0:14:50.04,Main,Vergo,0,0,0,,Sahi, bir şeyi söylemeyi unuttum.
Dialogue: 0,0:14:53.08,0:14:55.00,Main,Vergo,0,0,0,,Bana seslenirken...
Dialogue: 0,0:15:00.73,0:15:02.77,Main,Vergo,0,0,0,,...Vergo-san diyeceksin.
Dialogue: 0,0:15:08.26,0:15:12.41,captions_soft,Caption,0,0,0,,{\fad(650,00)\pos(640,545)\fs45}Laboratuvarın Önü - Luffy'nin Grubu
Dialogue: 0,0:15:24.15,0:15:26.35,Main,Marine,0,0,0,,Ne oldu öyle!?
Dialogue: 0,0:15:26.35,0:15:28.21,Main,Marine,0,0,0,,Hiçbir fikrim yok.
Dialogue: 0,0:15:28.21,0:15:29.74,Main,Marine,0,0,0,,Ne yapacağız peki?!
Dialogue: 0,0:15:32.76,0:15:34.74,Main,Marine,0,0,0,,Tashigi-chan!
Dialogue: 0,0:15:34.74,0:15:36.25,Main,Marine,0,0,0,,Koramiral Smoker o!
Dialogue: 0,0:15:42.26,0:15:46.44,Main,Marine,0,0,0,,O adamın aynı gün içinde iki kez\Ndevrildiğini göreceğim aklıma gelmezdi!
Dialogue: 0,0:15:46.99,0:15:51.05,Main,Marine,0,0,0,,Hasır Şapkalar'ın üçü de aynı şekilde!
Dialogue: 0,0:15:51.05,0:15:53.49,Main,Marine,0,0,0,,Fatihin Hakisi miydi acaba?!
Dialogue: 0,0:15:53.49,0:15:56.96,Main,Marine,0,0,0,,Saçmalamasana! Güçleri arasında\No denli fark olmasına imkan yok!
Dialogue: 0,0:15:56.96,0:16:01.50,Main,Marine,0,0,0,,Neydi o zaman? \NAdam kılını bile kıpırdatmadan hepsini hakladı!
Dialogue: 0,0:16:08.21,0:16:10.16,Main,Centaur,0,0,0,,Hak ettiğinizi buldunuz işte\Ndonanma bozuntuları!
Dialogue: 0,0:16:10.16,0:16:14.38,Main,Centaur,0,0,0,,Kurtarıcımız Master'ın\Ngücüne tanık oldunuz!
Dialogue: 0,0:16:14.38,0:16:21.71,Main,Centaur,0,0,0,,{\i1}Master! Master! Master!
Dialogue: 0,0:16:23.65,0:16:26.59,Main,Caesar,0,0,0,,Güçlü askerlerim!
Dialogue: 0,0:16:26.59,0:16:29.19,Main,Caesar,0,0,0,,Bu beşliyi bağlayın!
Dialogue: 0,0:16:29.70,0:16:32.93,Main,Caesar,0,0,0,,Şeytan Meyvesi yemişleri\Ndeniz taşıyla elbette!
Dialogue: 0,0:16:32.93,0:16:38.12,Main,Caesar,0,0,0,,Denizcileri boşverip\Nhepiniz laboratuvara çekilin.
Dialogue: 0,0:16:38.12,0:16:39.34,Main,Caesar,0,0,0,,Burası tehlikeli.
Dialogue: 0,0:16:44.69,0:16:48.76,Main,Caesar,0,0,0,,Tuhaf şeyler üzerimize yağmaya başladı\Nama endişelenmeyin.
Dialogue: 0,0:16:48.76,0:16:51.45,Main,Caesar,0,0,0,,Yerimizin güvende kalmasını sağlayacağım!
Dialogue: 0,0:16:51.45,0:16:53.49,Main,Centaur,0,0,0,,{\i1}Emredersiniz, Master!
Dialogue: 0,0:16:53.90,0:16:57.20,Main,Caesar,0,0,0,,Havalı Kardeşler\Nişi ellerine yüzlerine bulaştırdı gibi.
Dialogue: 0,0:16:58.92,0:17:01.37,Main,Caesar,0,0,0,,Ama ne yapalım artık!?
Dialogue: 0,0:17:01.87,0:17:06.40,Main,Caesar,0,0,0,,Hasır Şapka ve Law'ı karşılarına almak\Nbiraz fazla gelmiş olabilir.
Dialogue: 0,0:17:08.97,0:17:12.53,captions_soft,Caption,0,0,0,,{\fad(480,00)\pos(640,545)\fs45}Merkez Göl - Zoro'nun Grubu
Dialogue: 0,0:17:16.96,0:17:19.19,Main,Brook,0,0,0,,Yetti ama artık!
Dialogue: 0,0:17:20.34,0:17:23.48,Main,Brook,0,0,0,,Ze-Zehirli gaz bu!
Dialogue: 0,0:17:23.48,0:17:25.32,Main,Brook,0,0,0,,Gözlerim, gözlerim!
Dialogue: 0,0:17:25.32,0:17:28.07,Main,Brook,0,0,0,,Gözlerim yoktu benim ya!
Dialogue: 0,0:17:28.48,0:17:30.98,Main,Brook,0,0,0,,Ne istiyorsun be bizden?!
Dialogue: 0,0:17:30.98,0:17:34.09,Main,Brook,0,0,0,,Sen sadece vücut yerine\Njöle kullanan bir ucubesin!
Dialogue: 0,0:17:35.25,0:17:36.74,Main,Brook,0,0,0,,Daha çok zehirli gaz saldı!
Dialogue: 0,0:17:37.25,0:17:40.44,Main,Brook,0,0,0,,Ne yapacağız şimdi Zoro-san?!\NZehirli gaz salıyor bu!
Dialogue: 0,0:17:40.44,0:17:44.33,Main,Zoro,0,0,0,,Az önce görmemiş miydik saldığını zaten!?\Nİzleyip biraz ders çıkart yaşananlardan, iskelet!
Dialogue: 0,0:17:44.33,0:17:46.62,Main,Brook,0,0,0,,Ben de sizi\Nşansı yaver gitmedi diye düşünmüştüm.
Dialogue: 0,0:17:48.29,0:17:50.75,Main,Zoro,0,0,0,,Sahi ya, bunlar jöle değil miydi?
Dialogue: 0,0:17:50.75,0:17:52.40,Main,Zoro,0,0,0,,Hepsini ye gitsin işte!
Dialogue: 0,0:17:52.40,0:17:54.11,Main,Brook,0,0,0,,Olmaz!
Dialogue: 0,0:17:54.11,0:17:57.20,Main,Brook,0,0,0,,Bana böyle zorbalık yapmayı bırak!
Dialogue: 0,0:17:57.20,0:17:59.11,Main,Brook,0,0,0,,Sizden 70 yaş büyüğüm ben!
Dialogue: 0,0:18:00.08,0:18:02.30,Main,Zoro,0,0,0,,Özür dilerim dedeciğim!
Dialogue: 0,0:18:02.30,0:18:04.83,Main,Brook,0,0,0,,Kimmiş dede?!
Dialogue: 0,0:18:04.83,0:18:07.20,Main,Brook,0,0,0,,Ben körpecik bir iskele--
Dialogue: 0,0:18:09.61,0:18:10.58,Main,Zoro,0,0,0,,Ne oldu?!
Dialogue: 0,0:18:11.70,0:18:14.74,Thoughts,Sanji,0,0,0,,Dondum! Özür dilerim Nami-san.
Dialogue: 0,0:18:17.33,0:18:20.75,Thoughts,Sanji,0,0,0,,Bu şey yoksa\Nşu Slime'ın zehri mi?!
Dialogue: 0,0:18:20.75,0:18:22.24,Thoughts,Sanji,0,0,0,,Hadi, şimdi!
Dialogue: 0,0:18:22.24,0:18:25.36,Thoughts,Sanji,0,0,0,,Umarım samurayın gövdesi\Nzehirler arasında kalmamıştır!
Dialogue: 0,0:18:25.36,0:18:31.11,Thoughts,Sanji,0,0,0,,Deminden beri Gözlem Hakisi'ni kullanmama\Nrağmen acaba gövde güçten düştüğü için mi...
Dialogue: 0,0:18:31.11,0:18:35.83,Thoughts,Sanji,0,0,0,,...yaşam enerjisini\Nbalıklarınkinden ayıramıyorum?!
Dialogue: 0,0:18:36.40,0:18:37.18,Thoughts,Sanji,0,0,0,,Köpek balığı mı?!
Dialogue: 0,0:18:42.02,0:18:43.68,Thoughts,Sanji,0,0,0,,Yok artık?!
Dialogue: 0,0:18:54.51,0:18:56.52,Main,Brook,0,0,0,,İyi misiniz?
Dialogue: 0,0:18:56.52,0:18:59.10,Main,Zoro,0,0,0,,Ne oldu? Neler oluyor?!
Dialogue: 0,0:19:01.79,0:19:04.43,Thoughts,Sanji,0,0,0,,Orada dur, lanet balık!
Dialogue: 0,0:19:14.77,0:19:16.91,Thoughts,Sanji,0,0,0,,Çiğnemeyi bırak\Nlanet olası köpek balığı!
Dialogue: 0,0:19:17.94,0:19:20.96,Main,Kinemon,0,0,0,,Hiç de acımıyor bir kere!\NKaşınıyor!
Dialogue: 0,0:19:21.55,0:19:24.02,Main,Zoro,0,0,0,,Nesi var bunun?!
Dialogue: 0,0:19:24.02,0:19:25.87,Main,Brook,0,0,0,,Belli ki acı çekiyor.
Dialogue: 0,0:19:27.66,0:19:29.45,Main,Kinemon,0,0,0,,Acı-- mıyor!
Dialogue: 0,0:19:29.45,0:19:32.01,Main,Brook,0,0,0,,Ya Sanji-san'a bir şey olursa?!
Dialogue: 0,0:19:33.49,0:19:35.89,Thoughts,Sanji,0,0,0,,Lanet olası bırak dedim!
Dialogue: 0,0:19:44.05,0:19:44.57,Thoughts,Sanji,0,0,0,,Şimdi!
Dialogue: 0,0:19:45.51,0:19:48.04,Thoughts,,0,0,0,,{\fad(150,150)}Cuisseau Shoot
Dialogue: 0,0:19:45.51,0:19:48.04,Attack,,0,0,0,,{\fad(150,150)}Uyluk Vuruşu
Dialogue: 0,0:19:56.78,0:19:59.96,Thoughts,Sanji,0,0,0,,Tamamdır, son parçayı da\Nsağ salim kurtardık!
Dialogue: 0,0:19:59.96,0:20:02.11,Thoughts,Sanji,0,0,0,,Samuray yapbozu böylece tamamlandı!
Dialogue: 0,0:20:02.72,0:20:07.32,Thoughts,Sanji,0,0,0,,Hemen geri dönmem lazım yoksa\Nyol kapanacak!
Dialogue: 0,0:20:10.59,0:20:12.19,Thoughts,Sanji,0,0,0,,Kahretsin!
Dialogue: 0,0:20:23.99,0:20:25.88,Thoughts,Sanji,0,0,0,,Zehir buraya kadar geldi mi?!
Dialogue: 0,0:20:25.88,0:20:28.40,Thoughts,Sanji,0,0,0,,Lanet olsun!\NFarkında olmadan mahsur kaldım!
Dialogue: 0,0:20:31.41,0:20:33.66,Thoughts,Sanji,0,0,0,,Nami-san'ın gücü yeterli olacak mı acaba?
Dialogue: 0,0:20:33.66,0:20:35.73,Thoughts,Sanji,0,0,0,,Bu daha sonra başına bela açacak ama...
Dialogue: 0,0:20:37.15,0:20:38.89,Main,Brook,0,0,0,,İşler hiç iyi değil!
Dialogue: 0,0:20:39.39,0:20:41.58,Main,Brook,0,0,0,,Tüm göl zehir rengine dönmeye başladı!
Dialogue: 0,0:20:41.58,0:20:43.26,Main,Brook,0,0,0,,Sanji-san acele et!
Dialogue: 0,0:20:48.23,0:20:49.63,Thoughts,Sanji,0,0,0,,{\fad(150,150)}Blue Walk! {Deniz Yürüyüşü}
Dialogue: 0,0:20:48.23,0:20:49.63,Attack,Sanji,0,0,0,,{\fad(150,150)}Deniz Yürüyüşü
Dialogue: 0,0:20:50.54,0:20:54.24,Thoughts,Sanji,0,0,0,,Kapanma! Kapanma! Kapanma!
Dialogue: 0,0:20:58.77,0:21:00.06,Main,Brook,0,0,0,,Sanji-san!
Dialogue: 0,0:21:00.54,0:21:03.18,Main,Zoro,0,0,0,,Almış getirmiş bakın!
Dialogue: 0,0:21:07.05,0:21:08.57,Main,Kinemon,0,0,0,,Gerçekten de öyle!
Dialogue: 0,0:21:12.07,0:21:13.61,Main,Kinemon,0,0,0,,Sözcüklere dökülemez bir şey!
Dialogue: 0,0:21:14.45,0:21:20.54,Main,Kinemon,0,0,0,,Bedenime sahip olduğum için bu kadar\Nsevineceğim aklımın ucundan geçmezdi!
Dialogue: 0,0:21:25.36,0:21:29.02,captions_soft,Caption,0,0,0,,{\pos(640,440)\fad(555,0)\fs45}Wano Krallığı Samurayı
Dialogue: 0,0:21:25.36,0:21:29.02,captions_soft,Caption,0,0,0,,{\pos(640,483)\fad(555,0)\fs45}Tilki Ateşi Kin'emon
Dialogue: 0,0:21:29.02,0:21:33.24,Main,Brook,0,0,0,,Saygıdeğer samuray-san, siz meğer epey\Nuzunmuşsunuz!
Dialogue: 0,0:21:33.24,0:21:35.19,Main,Brook,0,0,0,,Benim kadarsınız resmen!
Dialogue: 0,0:21:35.19,0:21:38.46,Main,Kinemon,0,0,0,,Sahi ya, kendimi daha önce\Ntanıtmadığım için bağışlayın!
Dialogue: 0,0:21:39.38,0:21:42.09,Main,Kinemon,0,0,0,,Adım Kin'emon!
Dialogue: 0,0:21:42.54,0:21:46.61,Main,Kinemon,0,0,0,,Wano Krallığı'nın\NKuri Köyü'nde doğdum!
Dialogue: 0,0:21:46.61,0:21:49.06,Main,Sanji,0,0,0,,Yap ne yapacaksan hadi be!
Dialogue: 0,0:21:49.06,0:21:50.99,Main,Sanji,0,0,0,,Donduk burada!
Dialogue: 0,0:21:50.99,0:21:53.28,Main,Kinemon,0,0,0,,Emredersiniz, özür dilerim!
Dialogue: 0,0:21:53.79,0:21:54.95,Main,Kinemon,0,0,0,,{\fad(150,150)}Doron! {Bir çeşit sihirbazlık sesi, puf gibi}
Dialogue: 0,0:21:53.79,0:21:54.95,Note,Kinemon,0,0,0,,{\fad(150,150)}Ç.N.: Bir çeşit sihirbazlık sesi, puf gibi
Dialogue: 0,0:21:58.96,0:22:00.13,Main,Sanji,0,0,0,,Hâlâ donuyorum!
Dialogue: 0,0:22:00.13,0:22:03.55,Main,Brook,0,0,0,,Çıkartırsa üzerindeki kaybolacak değil mi?
Dialogue: 0,0:22:03.55,0:22:07.61,Main,Kinemon,0,0,0,,Tuhaf kaşlı beyim,\Nadınızı bahşeder misiniz?
Dialogue: 0,0:22:10.23,0:22:11.31,Main,Sanji,0,0,0,,Sanji'yim ben be!
Dialogue: 0,0:22:11.76,0:22:13.81,Main,Sanji,0,0,0,,Bey falan ne oluyor?!
Dialogue: 0,0:22:13.81,0:22:17.12,Main,Sanji,0,0,0,,Bedenini geri alınca\Ndavranışın da değişti!
Dialogue: 0,0:22:17.12,0:22:20.08,Main,Sanji,0,0,0,,Eksik parçaların varken...
Dialogue: 0,0:22:20.08,0:22:25.53,Main,Sanji,0,0,0,,...etmediğin hakaret kalmamıştı be!?\NUmarım dediklerini unutmamışsındır!
Dialogue: 0,0:22:28.74,0:22:30.60,Flashbacks,Kinemon,0,0,0,,Siz korsan mısınız?!
Dialogue: 0,0:22:32.04,0:22:34.38,Flashbacks,Kinemon,0,0,0,,Böyle barbar olmanıza şaşırmamalı!
Dialogue: 0,0:22:34.38,0:22:37.68,Flashbacks,Kinemon,0,0,0,,Korsanlardan nefret ediyorum!\NMidemi bulandırıyorsunuz!
Dialogue: 0,0:22:39.96,0:22:42.06,Flashbacks,Sanji,0,0,0,,Ne sinir bozucu birisi çıktın!?
Dialogue: 0,0:22:42.06,0:22:45.11,Flashbacks,Sanji,0,0,0,,Adam gibi bedenini bulmamızı\Nistediğini söylesene yüzüme!?
Dialogue: 0,0:22:45.68,0:22:49.48,Flashbacks,Kinemon,0,0,0,,Korsanlara borçlu kalmak istemem!\NÖlsem de böyle bir şey istemeyeceğim!
Dialogue: 0,0:22:50.04,0:22:55.68,Flashbacks,Kinemon,0,0,0,,Ne yazık ki beni burada bırakırsan\Nsavunmasız kalırım ama beni de yanında...
Dialogue: 0,0:22:55.68,0:22:57.35,Flashbacks,Kinemon,0,0,0,,...götürmek istersen şikayet etmem.
Dialogue: 0,0:23:05.75,0:23:07.48,Main,Kinemon,0,0,0,,Nasıl unutabilirim?!
Dialogue: 0,0:23:08.92,0:23:10.10,Main,Kinemon,0,0,0,,Asla!
Dialogue: 0,0:23:11.62,0:23:15.16,Main,Kinemon,0,0,0,,Bu iyiliğinizi hayatımın sonuna değin\Nunutmayacağım!
Dialogue: 0,0:23:15.68,0:23:17.42,Main,Kinemon,0,0,0,,Hakkınız ödenmez!
Dialogue: 0,0:23:17.42,0:23:23.41,Main,Kinemon,0,0,0,,Ayrıca bedenimi geri alana değin size\Nşüpheci yaklaştığım için...
Dialogue: 0,0:23:23.41,0:23:26.08,Main,Kinemon,0,0,0,,..lütfen beni bağışlayın!
Dialogue: 0,0:23:26.08,0:23:32.76,Main,Kinemon,0,0,0,,Bağışlayın! Bağışlayın!
Dialogue: 0,0:23:32.76,0:23:35.55,Main,Sanji,0,0,0,,Kes şunu be aptal!\NKaldır kafanı!
Dialogue: 0,0:23:35.97,0:23:38.98,Main,Sanji,0,0,0,,Erkek adam\Nbu kadar kolay diz çökmemeli!
Dialogue: 0,0:23:38.98,0:23:44.36,Main,Kinemon,0,0,0,,Ancak beyim,\Nsiz olmasaydınız ben muhtemelen...
Dialogue: 0,0:23:45.28,0:23:50.11,Main,Brook,0,0,0,,Şey, böldüğüm için\Nkusura bakmayın ama Sanji-san...
Dialogue: 0,0:23:51.10,0:23:54.96,Main,Brook,0,0,0,,Umutsuz bir krizin\Nortasında gibi görünüyoruz.
Dialogue: 0,0:23:56.75,0:23:58.73,Main,Brook,0,0,0,,Bakın, gördünüz mü?
Dialogue: 0,0:24:01.66,0:24:04.03,Main,Brook,0,0,0,,Kaçacak hiçbir yerimiz kalmadı!
Dialogue: 0,0:24:07.51,0:24:11.90,Main,Sanji,0,0,0,,Baksanıza bana! \NBunlarla ilgilenin dememiş miydim ben size?!
Dialogue: 0,0:24:12.56,0:24:15.76,Main,Zoro,0,0,0,,Elimizden bir şey gelmedi,\Nbiz n'apalım?
Dialogue: 0,0:24:15.76,0:24:17.43,Main,Brook,0,0,0,,Öyle gerçekten!
Dialogue: 0,0:24:17.43,0:24:20.28,Main,Sanji,0,0,0,,Çocuklaşmasanıza be mal herifler!
Dialogue: 0,0:24:20.28,0:24:24.46,Main,Sanji,0,0,0,,Nami-san'ımın bedenine\Nzarar gelmesine izin veremem!
Dialogue: 0,0:24:24.46,0:24:25.45,Main,Sanji,0,0,0,,Bu beden...
Dialogue: 0,0:24:26.27,0:24:29.21,Main,Sanji,0,0,0,,Bu...\NBu beden olmaz işte...
Dialogue: 0,0:24:30.64,0:24:33.33,Main,Zoro,0,0,0,,Geri vermeyi düşünmüyorsun sanırım?
Dialogue: 0,0:24:33.33,0:24:34.13,Main,Sanji,0,0,0,,Her hâlde!
Dialogue: 0,0:24:35.54,0:24:38.43,Main,Kinemon,0,0,0,,Neden yakmıyoruz peki biz bunları?
Dialogue: 0,0:24:39.99,0:24:43.32,Main,Kinemon,0,0,0,,Tilki Ateşi Kin'emon diye bilinirim.
Dialogue: 0,0:24:43.32,0:24:46.39,Main,Kinemon,0,0,0,,Kılıcımla düşmanı kesip yakabilirim.
Dialogue: 0,0:24:46.39,0:24:49.81,Main,Kinemon,0,0,0,,Hepsini yakıp bize bir yol açmama\Nmüsaade edin!
Dialogue: 0,0:24:51.27,0:24:55.65,Main,Sanji,0,0,0,,Düşmanı kesip yakabilir miyim dedin?!\NKulağa bir tür büyü gibi geliyor!
Dialogue: 0,0:25:44.07,0:25:46.30,Main,Zoro,0,0,0,,Ateşi kesti!
Dialogue: 0,0:25:47.24,0:25:49.13,Main,Kinemon,0,0,0,,Yolumuz açıldı.
Dialogue: 0,0:25:49.13,0:25:51.09,Main,Kinemon,0,0,0,,Bekle beni, Momonosuke!
Dialogue: 0,0:25:51.09,0:25:53.77,Main,Brook,0,0,0,,Anam?! Zarar görmedik!
Dialogue: 0,0:25:53.77,0:25:58.27,Main,Brook,0,0,0,,Patlama yüzünden oluşan\Nateşler arasında kaldık sanmıştım?!
Dialogue: 0,0:25:58.27,0:26:03.05,Main,Brook,0,0,0,,Ki-Ki-Kin'emon-san, ne oldu öyle?
Dialogue: 0,0:26:03.86,0:26:07.15,Main,Kinemon,0,0,0,,Patlamayı kestim.
Dialogue: 0,0:26:07.15,0:26:08.06,Main,Brook,0,0,0,,Patlamayı mı?!
Dialogue: 0,0:26:08.06,0:26:12.59,Main,Kinemon,0,0,0,,Tilki ateşi stilim bir şeyi\Nateşler aracılığıyla kesmemi...
Dialogue: 0,0:26:12.59,0:26:15.93,Main,Kinemon,0,0,0,,...ve alevleri kesmemi sağlıyor.
Dialogue: 0,0:26:16.62,0:26:19.71,Main,Kinemon,0,0,0,,Kesemeyeceğim bir ateş yoktur!
Dialogue: 0,0:26:21.07,0:26:25.58,Main,Kinemon,0,0,0,,Şimdi izninizle Momonosuke'yi kurtarmak\Niçin laboratuvara gidiyorum ben!
Dialogue: 0,0:26:27.42,0:26:28.43,Main,Kinemon,0,0,0,,İzninizle!
Dialogue: 0,0:26:35.41,0:26:36.40,Main,Zoro,0,0,0,,Bekle!
Dialogue: 0,0:26:38.19,0:26:41.29,Main,Zoro,0,0,0,,Samuray dövüş stilin ilgimi çekti.
Dialogue: 0,0:26:41.29,0:26:44.24,Main,Zoro,0,0,0,,Oğlunu kurtarmaya ben de geliyorum!
