Dialogue: 0,0:00:00.20,0:00:05.07,lyrics english,,0,0,0,,♪ Kaldır ellerini daha da yukarıya, hayallerini dök şarkılara. ♪
Dialogue: 0,0:00:05.14,0:00:08.72,lyrics english,,0,0,0,,♪ Yıkılma hiçbir zaman, sarsılmaz bayrağını kaldır göklere. ♪
Dialogue: 0,0:00:08.80,0:00:12.27,lyrics english,,0,0,0,,♪ Buralara kadar gelebilmek için pek çok duvarı yıkıp geçtik! ♪
Dialogue: 0,0:00:12.34,0:00:17.68,lyrics english,,0,0,0,,♪ Hedef gelecek, haydi eller havaya!! ♪
Dialogue: 0,0:00:23.31,0:00:30.66,lyrics english,,0,0,0,,♪ Uzansam biraz daha erişeceğim hemen cevaba. ♪
Dialogue: 0,0:00:30.73,0:00:38.37,lyrics english,,0,0,0,,♪ İnanarak buna açılıyorum yeni dünyaya. ♪
Dialogue: 0,0:00:38.40,0:00:45.86,lyrics english,,0,0,0,,♪ Aynen öyle, yapboz gibi birleşti hayal kırıntılarımız. ♪
Dialogue: 0,0:00:45.91,0:00:50.41,lyrics english,,0,0,0,,♪ Aramızda hiç kopmayacak bağlar yaratarak,...
Dialogue: 0,0:00:51.18,0:00:53.51,lyrics english,,0,0,0,,...daha aydınlık bir geleceğe. ♪
Dialogue: 0,0:00:54.00,0:00:58.55,lyrics english,,0,0,0,,♪ Kaldır ellerini daha da yukarıya, hayallerini dök şarkılara. ♪
Dialogue: 0,0:00:58.62,0:01:02.42,lyrics english,,0,0,0,,♪ Yıkılma hiçbir zaman, sarsılmaz bayrağını kaldır göklere. ♪
Dialogue: 0,0:01:02.43,0:01:05.78,lyrics english,,0,0,0,,♪ Buralara kadar gelebilmek için pek çok duvarı yıkıp geçtik! ♪
Dialogue: 0,0:01:05.83,0:01:09.80,lyrics english,,0,0,0,,♪ Hedefimiz gelecek! ♪
Dialogue: 0,0:01:09.87,0:01:11.30,lyrics english,,0,0,0,,♪ Daha da yukarıya bak! ♪
Dialogue: 0,0:01:11.34,0:01:13.48,lyrics english,,0,0,0,,♪ Sırtın hep dik olsun! ♪
Dialogue: 0,0:01:13.53,0:01:14.94,lyrics english,,0,0,0,,♪ Bir an olsun durma! ♪
Dialogue: 0,0:01:14.99,0:01:16.82,lyrics english,,0,0,0,,♪ Dalgaları aşa aşa! ♪
Dialogue: 0,0:01:16.86,0:01:20.41,lyrics english,,0,0,0,,♪ Arzularımız birleşiyor yavaşça. ♪
Dialogue: 0,0:01:20.44,0:01:24.65,lyrics english,,0,0,0,,♪ Haydi ilerisini hedef seçelim kendimize! ♪
Dialogue: 0,0:01:24.91,0:01:31.06,lyrics english,,0,0,0,,♪ Dalgaları sürerek, akıyoruz ileriye. ♪
Dialogue: 0,0:01:31.09,0:01:35.34,lyrics english,,0,0,0,,♪ İnsanlarla tanışıyor, elvedalar ediyoruz,...
Dialogue: 0,0:01:35.36,0:01:39.09,lyrics english,,0,0,0,,...bir kez daha bu bayrağın altında. ♪
Dialogue: 0,0:01:41.26,0:01:45.04,lyrics english,,0,0,0,,♪ Unutmak istemediğim acıları...
Dialogue: 0,0:01:45.06,0:01:48.08,lyrics english,,0,0,0,,...o gün yüreğime gömdüm, saklıyorum orada. ♪
Dialogue: 0,0:01:48.27,0:01:52.34,lyrics english,,0,0,0,,♪ Kimselere yenilmeyecek bir özgürlük bizimkisi,...
Dialogue: 0,0:01:52.46,0:01:54.75,lyrics english,,0,0,0,,...sıkıca kavrayıp yoluma atıldığım. ♪
Dialogue: 0,0:01:54.77,0:01:59.69,lyrics english,,0,0,0,,♪ Kaldır ellerini daha da yukarıya, hayallerini dök şarkılara. ♪
Dialogue: 0,0:01:59.72,0:02:03.37,lyrics english,,0,0,0,,♪ Yıkılma hiçbir zaman, sarsılmaz bayrağını kaldır göklere. ♪
Dialogue: 0,0:02:03.41,0:02:06.66,lyrics english,,0,0,0,,♪ Buralara kadar gelebilmek için pek çok duvarı yıkıp geçtik! ♪
Dialogue: 0,0:02:06.69,0:02:10.83,lyrics english,,0,0,0,,♪ Hedefimiz gelecek! ♪
Dialogue: 0,0:02:10.88,0:02:12.20,lyrics english,,0,0,0,,♪ Daha da yukarıya bak! ♪
Dialogue: 0,0:02:12.25,0:02:14.53,lyrics english,,0,0,0,,♪ Sırtın hep dik olsun! ♪
Dialogue: 0,0:02:14.53,0:02:15.90,lyrics english,,0,0,0,,♪ Bir an olsun durma! ♪
Dialogue: 0,0:02:15.95,0:02:17.72,lyrics english,,0,0,0,,♪ Dalgaları aşa aşa! ♪
Dialogue: 0,0:02:17.76,0:02:21.43,lyrics english,,0,0,0,,♪ Arzularımız birleşiyor yavaşça. ♪
Dialogue: 0,0:02:21.50,0:02:24.97,lyrics english,,0,0,0,,♪ Haydi ilerisini hedef seçelim kendimize! ♪
