press BT,52.0,&H00D6D6D6,&H00FFFFFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,1.5,1.5,2,120,120,18,1Style: Eyecatch,Kozuka Gothic Pro B,52.0,&H00FFFFFF,&H00FFFFFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,1.5,1.5,2,120,120,18,1Style: Sign,Futura Md BT,35.0,&H00FFFFFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.5,1.5,8,120,120,18,1Style: Attack,Duality,30.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.0,1.0,7,12,12,12,1Style: Author,Impress BT,19.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.5,0.5,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:10.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:13:52.00,0:14:02.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:27:47.85,0:27:50.65,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:02:29.86,0:02:34.39,Main,Zoro,0,0,0,,Sanırım... Düşerken kafamı çarpmış olmalıyım.Dialogue: 0,0:02:35.82,0:02:39.18,Main,Brook,0,0,0,,Ben de, başım acayip ağrıyor.Dialogue: 0,0:02:39.18,0:02:43.28,Main,Sanji,0,0,0,,Onu kaybettiğimize inanamıyorum. Acaba samuray hâlâ iyi mi?Dialogue: 0,0:02:43.28,0:02:46.05,Main,Zoro,0,0,0,,Bunu bizi dolambaçlı yoldan çıkaran adam söylüyor.Dialogue: 0,0:02:46.05,0:02:48.91,Main,Sanji,0,0,0,,Birlikte karar verdik sanıyordum!Dialogue: 0,0:02:48.91,0:02:52.59,Main,Brook,0,0,0,,Maalesef o iğrenç kardan adamı aramamıza rağmen bulamadık.Dialogue: 0,0:02:52.59,0:02:56.12,Main,Brook,0,0,0,,Ama gördüğümüz o gölgeleri asla unutmayacağım!Dialogue: 0,0:02:56.12,0:02:59.10,Main,Zoro,0,0,0,,Başka bir şeydi o, kandırma kendini.Dialogue: 0,0:02:59.10,0:03:00.98,Main,Zoro,0,0,0,,Bütün bunların sadece bir pusu olduğunu dememiş miydin?Dialogue: 0,0:03:00.98,0:03:02.43,Main,Brook,0,0,0,,Dememiştim.Dialogue: 0,0:03:02.98,0:03:04.55,Main,Zoro,0,0,0,,Kardan Adamı'nın varlığına inanmıyorum.Dialogue: 0,0:03:05.61,0:03:06.75,Main,Sanji,0,0,0,,Bence var.Dialogue: 0,0:03:07.21,0:03:11.63,Main,Brook,0,0,0,,Karar vermeden önce daha fazla kanıta ihtiyacım olduğuna inanıyorum.Dialogue: 0,0:03:13.35,0:03:16.05,Main,Sanji,0,0,0,,Etkilendim bak,...Dialogue: 0,0:03:16.05,0:03:18.04,Main,Sanji,0,0,0,,...olgun biri gibi konuştun!Dialogue: 0,0:03:18.04,0:03:20.73,Main,Brook,0,0,0,,Yıllardır hayattayım ve ölüyüm.Dialogue: 0,0:03:20.73,0:03:23.81,Main,Zoro,0,0,0,,Kararsızlık zayıflığın işaretidir.Dialogue: 0,0:03:23.81,0:03:24.69,Main,Brook,0,0,0,,Dialogue: 0,0:03:25.65,0:03:32.32,Flashbacks,Brook,0,0,0,,Hey! Samurai-san! Neredesin?Dialogue: 0,0:03:32.32,0:03:33.90,Flashbacks,Sanji,0,0,0,,Adi herif! Nami-san'ın bedeni konusunda daha dikkatli ol!Dialogue: 0,0:03:34.55,0:03:38.13,Flashbacks,Brook,0,0,0,,Millet, şuna bir bakın!Dialogue: 0,0:03:38.13,0:03:40.22,Flashbacks,Brook,0,0,0,,Ayak izleri!Dialogue: 0,0:03:41.09,0:03:43.73,Flashbacks,Brook,0,0,0,,Bu...Dialogue: 0,0:03:44.82,0:03:49.42,Flashbacks,Brook,0,0,0,,Şunlara bakın! Efsanevi iğrenç  Kardan Adam'ın ayak izleri değil mi bunlar?!Dialogue: 0,0:03:51.16,0:03:54.90,Flashbacks,Zoro+Sanji,0,0,0,,Nasıl bu kadar aptalca bir şey söyleyebilirsin?Dialogue: 0,0:03:56.86,0:04:01.14,Flashbacks,Sanji,0,0,0,,Vay gerçekten mi?! Karla kaplı dağdaki gizemli ayak izleri mi?Dialogue: 0,0:04:01.14,0:04:04.87,Flashbacks,Brook,0,0,0,,Çok büyükler, değil mi? İnanamıyorum!Dialogue: 0,0:04:04.87,0:04:06.61,Flashbacks,Brook,0,0,0,,Ve çok yeni bu izler!Dialogue: 0,0:04:07.64,0:04:10.46,Flashbacks,Brook,0,0,0,,Eğer onları takip edersek...Dialogue: 0,0:04:16.06,0:04:18.53,Flashbacks,Group,0,0,0,,...bu gizemi çözmüş oluruz!Dialogue: 0,0:04:37.53,0:04:39.32,Flashbacks,Sanji,0,0,0,,Çıkmaz yol mu?Dialogue: 0,0:04:44.38,0:04:47.65,Flashbacks,Brook,0,0,0,,Onlar ne? Arkamızda dev gölgeler var!Dialogue: 0,0:04:48.78,0:04:51.07,Flashbacks,Sanji,0,0,0,,Sakın bu gölgeler Kardan Adam'lara...Dialogue: 0,0:04:56.99,0:04:58.69,Flashbacks,Zoro,0,0,0,,Bu gaz da neyin nesi?!Dialogue: 0,0:04:58.69,0:05:05.56,Flashbacks,Sanji,0,0,0,,Sanki sarhoşmuşum gibi... Aniden dilimin ağırlaştığını hissettim ve uykum geldi...Dialogue: 0,0:05:05.56,0:05:08.32,Flashbacks,Brook,0,0,0,,B-B-Bu bir pusu olabilir mi?Dialogue: 0,0:05:09.15,0:05:13.19,Flashbacks,Rock,0,0,0,,KYP gazı ne denli alkolik olursanız olun...Dialogue: 0,0:05:13.19,0:05:16.10,Flashbacks,Rock,0,0,0,,...kişiyi yine de sarhoş ve dengesiz yapacak seviyededir.Dialogue: 0,0:05:16.67,0:05:22.75,Flashbacks,Scotch,0,0,0,,Ve uçurumun dibinde buzdan dikenlerle kaplı F-16 bölgesi var.Dialogue: 0,0:05:26.63,0:05:28.62,Flashbacks,Rock,0,0,0,,Yani ilk önce bu üçü düşecek.Dialogue: 0,0:05:37.63,0:05:38.50,Flashbacks,Zoro,0,0,0,,Dikenler mi!?Dialogue: 0,0:05:40.57,0:05:42.27,Flashbacks,Zoro,0,0,0,,Millet!Dialogue: 0,0:05:56.20,0:05:58.22,Flashbacks,Zoro,0,0,0,,B-Bu çok yakındı.Dialogue: 0,0:06:07.11,0:06:12.08,Flashbacks,Gasmask,0,0,0,,F-16 bölgesine ulaştık. 3 Hasır Şapka korsanını tam olarak rapor edilen yerde bulduk.Dialogue: 0,0:06:12.08,0:06:13.48,Flashbacks,Gasmask,0,0,0,,Şimdi cesetleri ortadan kaldıracağız.Dialogue: 0,0:06:15.21,0:06:16.73,Flashbacks,Sanji,0,0,0,,Kimmiş ceset?!Dialogue: 0,0:06:17.73,0:06:19.94,Flashbacks,Gasmask,0,0,0,,- Ne?! - Yaşıyor muymuş?!Dialogue: 0,0:06:19.94,0:06:22.11,Flashbacks,Gas2,0,0,0,,Kız başına bize ne yapabilir ki?!Dialogue: 0,0:06:22.11,0:06:24.26,Flashbacks,Sanji,0,0,0,,Yüz kişi olmuşsunuz kaç yazar?!Dialogue: 0,0:06:24.26,0:06:25.83,Flashbacks,Sanji,0,0,0,,Hepsi benim için aynı!Dialogue: 0,0:06:31.76,0:06:33.87,Flashbacks,Sanji,0,0,0,,Dikkatli olmam lazım.Dialogue: 0,0:06:33.87,0:06:37.28,Flashbacks,Sanji,0,0,0,,Nihayetinde Nami-san'ımın hassas bedeni.Dialogue: 0,0:06:38.27,0:06:40.96,Flashbacks,Sanji,0,0,0,,Üzerinde herhangi bir yara izi bırakmak suç olur.Dialogue: 0,0:06:44.93,0:06:47.56,Flashbacks,Sanji,0,0,0,,Affet beni Nami-san. Sadece bir sigara.Dialogue: 0,0:06:47.56,0:06:48.69,Flashbacks,Sanji,0,0,0,,Şimdi...Dialogue: 0,0:06:49.97,0:06:52.05,Flashbacks,Sanji,0,0,0,,Uyanın be aptal herifler!Dialogue: 0,0:06:58.85,0:07:01.75,Main,Sanji,0,0,0,,Neyse, bilinmeyen gizemlerin peşinde koşma faslı bitti!Dialogue: 0,0:07:01.75,0:07:03.37,Main,Sanji,0,0,0,,Peki burası samurayın gittiği bölge mi?Dialogue: 0,0:07:03.37,0:07:04.65,Main,Brook,0,0,0,,Evet.Dialogue: 0,0:07:04.65,0:07:09.65,Main,Brook,0,0,0,,Muhtemelen gölün çevresinde bir yerde gövdesini arıyordur.Dialogue: 0,0:07:09.65,0:07:11.68,Main,Sanji,0,0,0,,Göle vardık sayılır.Dialogue: 0,0:07:12.44,0:07:14.79,Main,Brook,0,0,0,,Samuray-san!Dialogue: 0,0:07:14.79,0:07:17.66,Main,Sanji,0,0,0,,Hey! Samuray!Dialogue: 0,0:07:18.49,0:07:21.43,Main,Sanji,0,0,0,,Dışarı çık Samuray!Dialogue: 0,0:07:23.68,0:07:25.29,Main,Sanji,0,0,0,,Samuray!Dialogue: 0,0:07:25.92,0:07:28.46,Main,Sanji,0,0,0,,Savaşta mı öldürüldün?Dialogue: 0,0:07:31.35,0:07:33.36,Main,Sanji,0,0,0,,Göster kendini hadi! İyi misin?Dialogue: 0,0:07:33.36,0:07:34.87,Main,Sanji,0,0,0,,Samuray!Dialogue: 0,0:07:35.61,0:07:37.65,Main,Brook,0,0,0,,Beni duyuyor musun Samuray-san?!Dialogue: 0,0:07:39.36,0:07:42.02,Main,Brook,0,0,0,,Nereye gittiğini gerçekten merak ediyorum.Dialogue: 0,0:07:44.08,0:07:48.76,Main,Zoro,0,0,0,,Sence gövdesini alıp o çocuğunu bulmaya mı gitti?Dialogue: 0,0:07:48.76,0:07:49.33,Main,Zoro,0,0,0,,Dialogue: 0,0:07:51.88,0:07:53.93,Main,Zoro,0,0,0,,Samuray değil mi bu!?Dialogue: 0,0:07:55.16,0:07:57.56,Main,Zoro,0,0,0,,Ne olmuş böyle, donmuş herif!Dialogue: 0,0:07:58.52,0:07:59.80,Main,Sanji,0,0,0,,Hey, hey!Dialogue: 0,0:08:06.16,0:08:07.11,Main,Kinemon,0,0,0,,Soğuk!Dialogue: 0,0:08:11.11,0:08:13.86,Main,Sanji,0,0,0,,Hey! iyi misin?Dialogue: 0,0:08:13.86,0:08:15.41,Main,Sanji,0,0,0,,Sana birisi mi saldırdı?Dialogue: 0,0:08:19.77,0:08:23.65,Main,Kinemon,0,0,0,,Bilinmeyen bir nedenden dolayı donmuştum ve ölümümün eşiğindeydim!Dialogue: 0,0:08:23.65,0:08:26.45,Main,Sanji,0,0,0,,Kar fırtınasına yakalanıp donduğunu mu söylüyorsun?Dialogue: 0,0:08:27.92,0:08:31.16,Main,Kinemon,0,0,0,,Hayır! Hiç de bile ü-ü-üşümüyorum...Dialogue: 0,0:08:33.69,0:08:35.34,Main,Sanji,0,0,0,,Lanet olsun çok inatçısın!Dialogue: 0,0:08:35.34,0:08:38.71,Main,Kinemon,0,0,0,,Bir savaşçı üşümez!Dialogue: 0,0:08:39.66,0:08:41.74,Main,Zoro,0,0,0,,Dostum, bu adam tam bir baş belası.Dialogue: 0,0:08:41.74,0:08:43.50,Main,Zoro,0,0,0,,Üzerine bir şeyler giy!Dialogue: 0,0:08:43.50,0:08:45.17,Main,Zoro,0,0,0,,Senin gücün kıyafet yaratma değil mi?Dialogue: 0,0:08:50.80,0:08:57.65,Main,Kinemon,0,0,0,,A-Aslında o büyü yüzünden zayıf bir noktam var.Dialogue: 0,0:08:57.65,0:09:02.21,Main,Kinemon,0,0,0,,Güçlü bir yüzücü olduğumu iddia edemem...Dialogue: 0,0:09:02.21,0:09:03.88,Main,Sanji,0,0,0,,Batarsın! Bunu herkes biliyor!Dialogue: 0,0:09:03.88,0:09:09.69,Main,Kinemon,0,0,0,,Ö-Öyle görünüyor ki gövdem...Dialogue: 0,0:09:09.69,0:09:14.31,Main,Kinemon,0,0,0,,...s-suya düşmüş.Dialogue: 0,0:09:14.31,0:09:15.24,Main,Sanji,0,0,0,,Suda mı?Dialogue: 0,0:09:15.24,0:09:17.43,Main,Kinemon,0,0,0,,E-Eminim!Dialogue: 0,0:09:17.43,0:09:20.36,Main,Kinemon,0,0,0,,Gövdemin suyun altında olduğunu hissedebiliyorum...Dialogue: 0,0:09:21.91,0:09:26.57,Main,Sanji,0,0,0,,Anlıyorum. Demek bu yüzden burada donarak yatıyordun.Dialogue: 0,0:09:26.57,0:09:29.93,Main,Sanji,0,0,0,,Bedenin suyun içindeyken yeteneğini kullanamıyorsun.Dialogue: 0,0:09:29.93,0:09:34.95,Main,Zoro,0,0,0,,Eğer suyun içindeyse sence o göle düşmüş olabilir mi, Brook?Dialogue: 0,0:09:34.95,0:09:38.92,Main,Brook,0,0,0,,Ben de öyle düşünüyorum. Gölün teknik olarak okyanusun bir parçası olduğunu duydum.Dialogue: 0,0:09:38.92,0:09:41.77,Main,Zoro,0,0,0,,Eğer hâlâ hayattaysa...Dialogue: 0,0:09:41.77,0:09:44.74,Main,Zoro,0,0,0,,...bu, köpek balıklarının henüz onu almadığı anlamına gelir.Dialogue: 0,0:09:44.74,0:09:47.85,Main,Zoro,0,0,0,,Ama gölün içinde neler var bilemeyiz.Dialogue: 0,0:09:47.85,0:09:49.87,Main,Zoro,0,0,0,,Hemen oradan çıkartsak iyi olacak.Dialogue: 0,0:09:49.87,0:09:52.18,Main,Brook,0,0,0,,Evet, acele edelim.Dialogue: 0,0:09:52.18,0:09:58.06,Main,Kinemon,0,0,0,,E-Eğer göldeyse...  o zaman dalmam gerekecek...Dialogue: 0,0:09:58.06,0:10:01.30,Main,Sanji,0,0,0,,Anladık! Çekiç gibi batıyorsun, değil mi?Dialogue: 0,0:10:01.30,0:10:02.46,Main,Sanji,0,0,0,,Beceriksiz samuray.Dialogue: 0,0:10:03.76,0:10:05.88,Main,Kinemon,0,0,0,,Siz korsansınız, değil mi?Dialogue: 0,0:10:05.88,0:10:10.91,Main,Kinemon,0,0,0,,Benim gibi hiç tanımadığınız biri için neden bu kadar çok fedakârlıkta bulunuyorsunuz?Dialogue: 0,0:10:16.13,0:10:19.57,Main,Sanji,0,0,0,,Sana söyledim, doğruyla yanlış arasındaki farkı biliyorum!Dialogue: 0,0:10:20.50,0:10:23.51,Main,Sanji,0,0,0,,Seni tekrar bir araya getirdikten sonra dövüşümüzü bitirmek istiyorum!Dialogue: 0,0:10:23.51,0:10:25.57,Main,Sanji,0,0,0,,Seni döveceğim.Dialogue: 0,0:10:26.99,0:10:31.17,Main,Kinemon,0,0,0,,A-affet beni.Dialogue: 0,0:10:41.61,0:10:43.59,Main,Kinemon,0,0,0,,Sana borçluyum.Dialogue: 0,0:10:43.59,0:10:47.70,Main,Sanji,0,0,0,,Ah, görüyorum ki minnettarlığı nasıl ifade edeceğini öğrenmişsin.Dialogue: 0,0:10:47.70,0:10:49.89,Main,Sanji,0,0,0,,Soğuk insanları kibarlaştırıyor herhâlde?Dialogue: 0,0:10:53.38,0:10:54.60,Main,Sanji,0,0,0,,Bu da nesi?Dialogue: 0,0:10:55.00,0:10:58.11,Main,Brook,0,0,0,,Bu da nesi acep böyle?Dialogue: 0,0:10:58.11,0:11:00.22,Main,Brook,0,0,0,,Bunlar...Dialogue: 0,0:11:00.66,0:11:05.25,Main,Brook,0,0,0,,...soyduğumuz şu Kahverengisakal-san'ın emrindeki sentorlar!Dialogue: 0,0:11:05.25,0:11:07.99,Main,Centaurı,0,0,0,,Dayanın! Koşmaya devam!Dialogue: 0,0:11:07.99,0:11:09.42,Main,Centaur2,0,0,0,,Gölden uzaklaşın!Dialogue: 0,0:11:09.82,0:11:12.32,Main,Centaurı,0,0,0,,Öbür tarafta bir canavar belirdi!Dialogue: 0,0:11:12.32,0:11:14.15,Main,Centaur2,0,0,0,,Master'a haber vermeliyiz!Dialogue: 0,0:11:14.15,0:11:17.10,Main,Centaur2,0,0,0,,Şimdiye dek adanın neresinde saklanıyormuş bu şey?!Dialogue: 0,0:11:17.10,0:11:20.91,Main,Centaurı,0,0,0,,Koşmaya devam! Peşimizden geliyor!Dialogue: 0,0:11:20.91,0:11:24.73,Main,Zoro,0,0,0,,Ne, canavar mı? Kendilerinden mi bahsediyorlar acaba?Dialogue: 0,0:11:26.39,0:11:28.71,Main,Centaurı,0,0,0,,Bunlar bizi soyan korsanlar!Dialogue: 0,0:11:28.71,0:11:31.17,Main,Centaur2,0,0,0,,Kahretsin, o benim montum!Dialogue: 0,0:11:31.17,0:11:34.21,Main,Centaurı,0,0,0,,Boş ver montu falan, koş! Laboratuvara kaç!Dialogue: 0,0:11:34.21,0:11:36.84,Main,Centaur2,0,0,0,,Patronu kaçırdılar bunlar!Dialogue: 0,0:11:36.84,0:11:39.70,Main,Centaurs,0,0,0,,Hesabını soracağız!Dialogue: 0,0:11:42.51,0:11:44.27,Main,Sanji,0,0,0,,Neler oluyor acaba?Dialogue: 0,0:11:44.27,0:11:45.92,Main,Brook,0,0,0,,Hiçbir fikrim yok.Dialogue: 0,0:11:47.51,0:11:52.50,Main,Zoro,0,0,0,,Baksana Brook, gölün oradan geliyorlardı değil mi bunlar?Dialogue: 0,0:11:52.50,0:11:56.13,Main,Brook,0,0,0,,Vay! Bu doğru! Aslında doğru anladın!Dialogue: 0,0:11:56.13,0:11:58.31,Main,Brook,0,0,0,,Bu inanılmaz, Zoro-san!Dialogue: 0,0:11:58.31,0:11:59.68,Main,Brook,0,0,0,,Ama neden böyle görünüyorsun?Dialogue: 0,0:12:00.06,0:12:02.01,Main,Zoro,0,0,0,,Şey, tam hatırlamıyorum...Dialogue: 0,0:12:02.54,0:12:04.97,Main,Zoro,0,0,0,,...orada bir dağ var.Dialogue: 0,0:12:06.65,0:12:09.12,Main,Brook,0,0,0,,Hmm... bir dağ mı?Dialogue: 0,0:12:10.50,0:12:13.03,Main,Brook,0,0,0,,O şey de ne?!Dialogue: 0,0:12:22.56,0:12:29.88,Main,Caesar,0,0,0,,Smiley, dört yıl önce Punk Hazard'ı yok eden yaşayan bir kimyasal silahtır!Dialogue: 0,0:12:32.78,0:12:36.13,Main,Caesar,0,0,0,,Gerçekten adadaki tüm gazı yok edeceğime mi inanıyorlardı?Dialogue: 0,0:12:36.13,0:12:37.52,Main,Caesar,0,0,0,,Hayır!Dialogue: 0,0:12:37.52,0:12:40.10,Main,Caesar,0,0,0,,Bu kadar değerli bir şeyi kim israf eder ki?Dialogue: 0,0:12:40.71,0:12:44.40,Main,Caesar,0,0,0,,Onu sıkıştırıp bir canavara dönüştürdüm!Dialogue: 0,0:12:44.96,0:12:48.50,Main,Caesar,0,0,0,,Smiley adında bir canavar!Dialogue: 0,0:12:49.27,0:12:54.64,Main,Caesar,0,0,0,,Bir zamanlar bu ada üzerinde kimselerin yaşayamayacağı ölü bir dünyaydı adeta!Dialogue: 0,0:12:54.64,0:12:57.90,Main,Caesar,0,0,0,,İnsanlar yaşanan acıları hemen unuturlar...Dialogue: 0,0:12:57.90,0:13:00.61,Main,Caesar,0,0,0,,...ama bu hiç ortadan kaybolmadı!Dialogue: 0,0:13:00.61,0:13:03.64,Main,Caesar,0,0,0,,Şu ana dek bende duruyordu!Dialogue: 0,0:13:06.74,0:13:09.14,Main,Marine,0,0,0,,Gemiyi ele geçirdiler!Dialogue: 0,0:13:09.14,0:13:11.15,Main,Marine2,0,0,0,,Gemiyi durdurun!Dialogue: 0,0:13:12.23,0:13:14.86,Main,Smoker,0,0,0,,Boş boş durmayın, bitirin işlerini!Dialogue: 0,0:13:16.15,0:13:18.78,Main,Tashigi,0,0,0,,Smoker-san, nasıl eski halime döneceğim?!Dialogue: 0,0:13:18.78,0:13:21.91,Main,Smoker,0,0,0,,Bize de engel oluyorsun, dur durduğun yerde Tashigi!Dialogue: 0,0:13:29.54,0:13:31.96,Main,Smoker,0,0,0,,Kapı hâlâ açılmadı mı?!Dialogue: 0,0:13:33.98,0:13:36.45,Main,Smoker,0,0,0,,Düşman laboratuvarın içinde!Dialogue: 0,0:13:36.45,0:13:38.74,Main,Smoker,0,0,0,,Ölene kadar burada vakit kaybedemeyiz!Dialogue: 0,0:13:39.17,0:13:43.09,Main,Soldier,0,0,0,,İşe yaramıyor! Kapı taş gibi, yerinden kıpırdamıyor Smo-san!Dialogue: 0,0:13:44.19,0:13:45.77,Main,Smoker,0,0,0,,Ne acınası!Dialogue: 0,0:13:45.77,0:13:51.35,Main,Smoker,0,0,0,,Kendi bedenimde olsaydım içeri kolayca sızabilirdim!Dialogue: 0,0:14:12.68,0:14:15.63,Main,Chopper,0,0,0,,Gücün oldukça kullanışlıymış var ya!Dialogue: 0,0:14:15.63,0:14:17.23,Main,Chopper,0,0,0,,Işınlanma falan mıydı bu?!Dialogue: 0,0:14:17.23,0:14:19.62,Main,Law,0,0,0,,Kapa çeneni de torbanın içinde bekle!Dialogue: 0,0:14:19.62,0:14:21.91,Main,Law,0,0,0,,Laboratuarın arka girişindeyiz zaten.Dialogue: 0,0:14:21.91,0:14:27.08,Main,Law,0,0,0,,Caesar ve şu kadın muhtemelen ana deney odasındadır.Dialogue: 0,0:14:28.08,0:14:31.17,Main,Law,0,0,0,,İkisini bir şekilde o odadan çıkartmaya çalışacağım.Dialogue: 0,0:14:31.17,0:14:33.93,Main,Law,0,0,0,,Bu olduğunda ilaçları araştırırsın.Dialogue: 0,0:14:34.46,0:14:40.68,Main,Chopper,0,0,0,,Ama sen çok güçlüsün ve Master'a kolaylıkla yaklaşabilirsin.Dialogue: 0,0:14:40.68,0:14:43.62,Main,Chopper,0,0,0,,Neden onu kendin yakalamıyorsun?Dialogue: 0,0:14:43.62,0:14:47.11,Main,Chopper,0,0,0,,Ondan sonra ilaçları istediğimiz kadar araştırırız.Dialogue: 0,0:14:47.11,0:14:52.84,Main,Chopper,0,0,0,,Bunu yapmamak için nedenlerim var. Bu yüzden senin gücüne ihtiyacım var.Dialogue: 0,0:14:54.30,0:14:59.00,Main,Chopper,0,0,0,,Neyse, Caesar'ı ne kadar hızlı kaçırırsanız o kadar iyi.Dialogue: 0,0:14:59.36,0:15:01.12,Main,Chopper,0,0,0,,Gerisini ben halledeceğim.Dialogue: 0,0:15:05.41,0:15:07.37,Main,Marine,0,0,0,,Hey! Şuna bakın!Dialogue: 0,0:15:10.32,0:15:12.21,Main,Marine,0,0,0,,Bir şey bize doğru uçuyor!Dialogue: 0,0:15:12.21,0:15:13.99,Main,Marine2,0,0,0,,Bu dev bir bomba!Dialogue: 0,0:15:14.84,0:15:16.01,Main,Marine,0,0,0,,Hayır, bu başka bir şey!Dialogue: 0,0:15:25.52,0:15:27.12,Attack,,0,0,0,,Yüz Çiçek!Dialogue: 0,0:15:28.14,0:15:29.14,Attack,,0,0,0,,Kanat!Dialogue: 0,0:15:31.48,0:15:33.84,Main,Luffy,0,0,0,,Bom!Dialogue: 0,0:15:39.13,0:15:41.35,Main,Marine,0,0,0,,"Bom!"? İnsan mı bu?!Dialogue: 0,0:15:54.12,0:15:55.43,Main,Franky,0,0,0,,Lanet olsun!Dialogue: 0,0:16:01.38,0:16:03.00,Main,Franky,0,0,0,,Harika bir kestirmeymiş bu!Dialogue: 0,0:16:05.24,0:16:08.03,Main,Luffy,0,0,0,,Master, göster kendini!Dialogue: 0,0:16:08.03,0:16:12.52,Main,Luffy,0,0,0,,Önce canına okuyup sonra da kaçıracağız!Dialogue: 0,0:16:12.52,0:16:15.10,Main,Robin,0,0,0,,Luffy, onun sır olarak kalması lazımdı.Dialogue: 0,0:16:15.10,0:16:16.33,Main,Smoker,0,0,0,,Hasır Şapka?!Dialogue: 0,0:16:17.25,0:16:18.86,Main,Marine,0,0,0,,Hasır Şapka korsanları bunlar!Dialogue: 0,0:16:20.06,0:16:21.99,Main,Chopper,0,0,0,,Göster gücünü, Luffy!Dialogue: 0,0:16:21.99,0:16:23.91,Main,Law,0,0,0,,Aptal!Dialogue: 0,0:16:24.45,0:16:26.42,Main,Law,0,0,0,,Bütün donanmayı karşılamasını kim söyledi ona?Dialogue: 0,0:16:26.93,0:16:30.79,Main,Luffy,0,0,0,,Neredesin Master?!  Çık ortaya!Dialogue: 0,0:16:35.14,0:16:39.06,Main,Brook,0,0,0,,Bu muhteşem! Gözlerime inanamıyorum.Dialogue: 0,0:16:39.06,0:16:44.34,Main,Brook,0,0,0,,Gerçi gözüm de yoktu zaten...Dialogue: 0,0:16:48.93,0:16:53.37,captionsşsoft,Text,0,0,0,,Caesar'ın Laboratuvarı - Ana GirişDialogue: 0,0:17:00.18,0:17:04.82,Main,Guyı,0,0,0,,O adi herif Master'ımızın canına okuyup sonra da kaçıracağını mı söyledi?!Dialogue: 0,0:17:04.82,0:17:08.72,Main,Guy2,0,0,0,,Saçma salak zırvalar işte! Hasır Şapkalar'ı gebertin!Dialogue: 0,0:17:12.94,0:17:16.94,Attack,,0,0,0,,Güçlü Sağ!Dialogue: 0,0:17:27.99,0:17:31.65,Main,Luffy,0,0,0,,Buraya geldik tamam güzel de Master nerede ki?Dialogue: 0,0:17:31.65,0:17:34.11,Main,Robin,0,0,0,,Dışarıda olduğunu sanmıyorum.Dialogue: 0,0:17:35.10,0:17:36.49,Main,Luffy,0,0,0,,Nerede peki o zaman?Dialogue: 0,0:17:37.03,0:17:38.71,Main,Franky,0,0,0,,Muhtemelen laboratuvardadır.Dialogue: 0,0:17:39.10,0:17:42.58,Main,Luffy,0,0,0,,Anlıyorum... Öyleyse giriş de şu koca kapıdandır.Dialogue: 0,0:17:42.58,0:17:43.47,Main,Robin,0,0,0,,Gidelim.Dialogue: 0,0:17:43.47,0:17:45.47,Main,Tashigi,0,0,0,,Hasır Şapkalı Luffy!Dialogue: 0,0:17:45.47,0:17:47.87,Main,Tashigi,0,0,0,,Bu adada ne arıyorsunuz?!Dialogue: 0,0:17:47.87,0:17:51.70,Main,Luffy,0,0,0,,Duman, iyi olmana çok sevindim!Dialogue: 0,0:17:51.70,0:17:54.59,Main,Luffy,0,0,0,,Sabah öyle yenilince endişelendirdin beni!Dialogue: 0,0:17:54.59,0:17:56.05,Main,Tashigi,0,0,0,,Dalga geçme benimle!Dialogue: 0,0:17:58.88,0:18:02.85,Main,Luffy,0,0,0,,Ne oldu, karnın falan mı ağrıyor? Kabız mı oldun?Dialogue: 0,0:18:06.59,0:18:07.22,Main,Tashigi,0,0,0,,Uçtu!Dialogue: 0,0:18:13.63,0:18:17.42,Main,Luffy,0,0,0,,Neyin var Duman? Çok güçsüzleşmişsin.Dialogue: 0,0:18:17.42,0:18:20.16,Main,Tashigi,0,0,0,,Hiç de bile! Ben...Dialogue: 0,0:18:20.16,0:18:24.62,Main,Luffy,0,0,0,,Ayrıca deminden beri bir tuhaf konuşuyorsun.Dialogue: 0,0:18:24.62,0:18:27.41,Main,Smoker,0,0,0,,Hey, bana biraz rahat ver!Dialogue: 0,0:18:27.41,0:18:31.47,Main,Smoker,0,0,0,,Benim bedenimdeyken ona yenilme sakın!Dialogue: 0,0:18:38.47,0:18:40.17,Main,Luffy,0,0,0,,Ne, o silah...Dialogue: 0,0:18:40.17,0:18:44.28,Main,Smoker,0,0,0,,Denizlere geri döndün demek, Hasır Şapka?Dialogue: 0,0:18:44.28,0:18:48.02,Main,Smoker,0,0,0,,Ama canının istediğini yapmana izin vermeyeceğim!Dialogue: 0,0:18:58.64,0:19:00.29,Main,Luffy,0,0,0,,Darbe aldım.Dialogue: 0,0:19:02.58,0:19:04.89,Main,Luffy,0,0,0,,Doğru... O şeyin içinde deniz taşı vardı!Dialogue: 0,0:19:05.35,0:19:08.80,Main,Luffy,0,0,0,,Dört göz bu kadar güçlenmiş demek?Dialogue: 0,0:19:08.80,0:19:10.59,Main,Luffy,0,0,0,,Adın neydi senin?Dialogue: 0,0:19:16.42,0:19:18.64,Main,Smoker,0,0,0,,Smoker!Dialogue: 0,0:19:21.74,0:19:24.58,Main,Robin,0,0,0,,Luffy, eminim Law yapmıştır bunu.Dialogue: 0,0:19:24.58,0:19:28.73,Main,Luffy,0,0,0,,Ne? Şu "değiştirme" olayını diyorsun? Anlıyorum.Dialogue: 0,0:19:29.44,0:19:31.60,Main,Luffy,0,0,0,,Demek bu yüzden o güçsüz...Dialogue: 0,0:19:32.57,0:19:33.92,Main,Luffy,0,0,0,,Yani...Dialogue: 0,0:19:37.51,0:19:38.64,Main,Luffy,0,0,0,,...sen...Dialogue: 0,0:19:39.87,0:19:41.08,Main,Luffy,0,0,0,,...duman mısın?!Dialogue: 0,0:19:43.53,0:19:45.70,Main,Smoker,0,0,0,,Komik olan ne?!Dialogue: 0,0:19:47.94,0:19:50.29,Main,Smoker,0,0,0,,Dövüş benimle, Hasır Şapka!Dialogue: 0,0:19:50.51,0:19:51.51,Attack,,0,0,0,,İkinci Düzen!Dialogue: 0,0:19:55.46,0:19:56.93,Main,Smoker,0,0,0,,Çok hızlı!Dialogue: 0,0:20:02.79,0:20:04.50,Main,Luffy,0,0,0,,Dövüşü başka bir ara tamamlarız!Dialogue: 0,0:20:04.50,0:20:05.47,Main,Smoker,0,0,0,,Ne dedin?!Dialogue: 0,0:20:05.47,0:20:09.54,Main,Luffy,0,0,0,,Böyle gerçek gücünü kullanamayan birine karşı dövüşmenin bir manası yok!Dialogue: 0,0:20:09.54,0:20:12.12,Main,Smoker,0,0,0,,Kendini beğenmiş piç!Dialogue: 0,0:20:13.55,0:20:15.84,Main,Luffy,0,0,0,,Görüşürüz, Duman!Dialogue: 0,0:20:15.86,0:20:18.76,Attack,,0,0,0,,Radikal IşınDialogue: 0,0:20:27.67,0:20:29.32,Main,Centaur,0,0,0,,Kapıda delik açtı!Dialogue: 0,0:20:29.32,0:20:31.52,Main,Centaur,0,0,0,,Kim o adam?Dialogue: 0,0:20:31.52,0:20:32.76,Main,Centaur2,0,0,0,,Lazer miydi o?!Dialogue: 0,0:20:34.83,0:20:40.49,Main,Franky,0,0,0,,Luffy, Robin! Kapıyı açtım! Hadi içeriye girelim!Dialogue: 0,0:20:42.04,0:20:44.49,Main,Luffy,0,0,0,,Elin de pek hızlıymış, Franky!Dialogue: 0,0:20:45.66,0:20:46.82,Main,Marine,0,0,0,,Smo-yan?!Dialogue: 0,0:20:47.97,0:20:50.14,Main,Marine,0,0,0,,Tuhaf bir şey bize doğru yaklaşıyor!Dialogue: 0,0:20:50.81,0:20:51.67,Main,Tashigi,0,0,0,,Şu tarafta!Dialogue: 0,0:20:51.67,0:20:52.57,Main,Smoker,0,0,0,,Bu da ne?!Dialogue: 0,0:21:03.68,0:21:04.81,Main,Smoker,0,0,0,,Bu şey de...Dialogue: 0,0:21:05.17,0:21:05.97,Main,Tashigi,0,0,0,,...ne?Dialogue: 0,0:21:20.94,0:21:23.74,Main,Robin,0,0,0,,Luffy, Franky bekleyin!Dialogue: 0,0:21:24.56,0:21:26.47,Main,Marine2,0,0,0,,Bu şey de ne?!Dialogue: 0,0:21:26.47,0:21:29.27,Main,Marine,0,0,0,,Zehirli gaz bu! Geri çekilin!Dialogue: 0,0:21:29.27,0:21:33.16,Main,Marine2,0,0,0,,Kesilip vurulduğunda zehirli gaz salmaya başladı!Dialogue: 0,0:21:33.16,0:21:36.45,Main,Marine,0,0,0,,Gaz maskelerinizi takın! Çabuk!Dialogue: 0,0:21:40.87,0:21:43.53,Main,Luffy,0,0,0,,Bu şey de ne böyle?!Dialogue: 0,0:21:43.53,0:21:45.57,Main,Franky,0,0,0,,Canlı mı acaba?Dialogue: 0,0:21:45.57,0:21:48.59,Main,Robin,0,0,0,,Zerre fikrim yok. Ne acaba?Dialogue: 0,0:21:50.46,0:21:53.30,Main,Smoker,0,0,0,,Bak şuraya, bu şey de ne?!Dialogue: 0,0:21:53.30,0:21:57.46,Main,Marine,0,0,0,,Bil-Bilmiyorum! Böyle bir şeyi ilk defa görüyorum!Dialogue: 0,0:21:57.46,0:22:00.41,Main,Marine2,0,0,0,,Gökyüzünden düştü değil mi?Dialogue: 0,0:22:00.41,0:22:03.01,Main,Marine,0,0,0,,Evet ama hareket ediyor gibi!Dialogue: 0,0:22:03.01,0:22:04.82,Main,Marine2,0,0,0,,Tüyler ürpertici bir şey!Dialogue: 0,0:22:10.24,0:22:12.27,Main,Marine,0,0,0,,Canlı mı bu şey?Dialogue: 0,0:22:13.90,0:22:14.60,Main,Marine2,0,0,0,,Şuna bakın!Dialogue: 0,0:22:16.45,0:22:19.83,Main,Marine,0,0,0,,Birleşip büyüdüler!Dialogue: 0,0:22:28.13,0:22:31.71,Main,Marine2,0,0,0,,Onu nehre doğru itmeliyiz.Dialogue: 0,0:22:31.71,0:22:33.49,Main,Marine,0,0,0,,Dur, yapma!Dialogue: 0,0:22:42.21,0:22:43.89,Main,Marine2,0,0,0,,Gene zehirli gaz saldı!Dialogue: 0,0:22:43.89,0:22:45.64,Main,Marine,0,0,0,,Çıkartalım!Dialogue: 0,0:22:47.01,0:22:48.80,Main,Marines,0,0,0,,Çek!Dialogue: 0,0:22:50.46,0:22:53.01,Main,Marine2,0,0,0,,Bu şey...Dialogue: 0,0:22:55.20,0:22:59.20,Main,Marine,0,0,0,,Cildim! Acıyor! Bir şey yapın! Herhangi biri!Dialogue: 0,0:22:59.20,0:23:01.49,Main,Marine2,0,0,0,,Bir parça bez bir şey getirin!Dialogue: 0,0:23:01.49,0:23:03.83,Main,Marine,0,0,0,,Dokunmamamız gerektiğini biliyordum!Dialogue: 0,0:23:03.83,0:23:05.17,Main,Marine2,0,0,0,,Ne yapacağız şimdi?!Dialogue: 0,0:23:05.17,0:23:06.77,Main,Marine,0,0,0,,Bilmiyorum!Dialogue: 0,0:23:07.26,0:23:09.72,Main,Marine2,0,0,0,,Geri çekilin, millet!Dialogue: 0,0:23:12.24,0:23:16.26,Main,Marine,0,0,0,,Ateşe karşı pek dayanıklı değil gibi!Dialogue: 0,0:23:16.26,0:23:18.07,Main,Marine,0,0,0,,Yakalım şunu!Dialogue: 0,0:23:18.07,0:23:18.91,Main,Marines,0,0,0,,Dialogue: 0,0:23:19.88,0:23:21.42,Main,Marine,0,0,0,,Al bakalım!Dialogue: 0,0:23:24.03,0:23:27.22,Main,Marine2,0,0,0,,Ateşten korkmayan hiçbir canlı yoktur!Dialogue: 0,0:23:27.22,0:23:29.49,Main,Marine,0,0,0,,Akıllı çıktın!Dialogue: 0,0:23:29.49,0:23:31.08,Main,Marine2,0,0,0,,Yak gitsin!Dialogue: 0,0:23:34.93,0:23:38.53,Main,Marine,0,0,0,,Gördünüz mü, ateşe karşı zayıf işte! Geber!Dialogue: 0,0:23:38.53,0:23:42.13,Main,Marine2,0,0,0,,Yanmaya başlıyor! Bu hiç hoşuna gitmiyor!Dialogue: 0,0:24:02.34,0:24:06.39,Main,Smoker,0,0,0,,Adamlarım!Dialogue: 0,0:24:14.08,0:24:16.70,Main,Sheepman,0,0,0,,Ne oldu öyle?Dialogue: 0,0:24:16.70,0:24:19.23,Main,Gasmask,0,0,0,,Bilmiyorum!  Böyle bir şeyi ilk defa görüyorum!Dialogue: 0,0:24:19.23,0:24:22.61,Main,Gasmask,0,0,0,,Dokunulduğunda zehir salıyor, yakıldığındaysa patlıyor!Dialogue: 0,0:24:22.61,0:24:26.51,Main,Gasmask,0,0,0,,Canlı bir şey mi onu bile bilmiyoruz daha.Dialogue: 0,0:24:26.52,0:24:29.59,Main,Centaur,0,0,0,,Kim takar? Öldü artık.Dialogue: 0,0:24:29.59,0:24:32.09,Main,Centaur2,0,0,0,,Sahi, haklısın.Dialogue: 0,0:24:32.09,0:24:37.79,Main,Centaur,0,0,0,,Üstelik gemiyi çalan denizcileri de öldürdü!Dialogue: 0,0:24:37.79,0:24:39.72,Main,Centaur,0,0,0,,Bizim için oldukça iyi sonuç verdi!Dialogue: 0,0:24:48.67,0:24:51.80,Main,Centaurs,0,0,0,,Geri geldi!Dialogue: 0,0:24:52.58,0:24:54.88,Main,Luffy,0,0,0,,Gökyüzüne bak!Dialogue: 0,0:24:54.88,0:24:57.26,Main,Franky,0,0,0,,Az öncekine benziyor bunlar.Dialogue: 0,0:24:57.26,0:24:58.68,Main,Robin,0,0,0,,Bunlardan çok fazla var.Dialogue: 0,0:25:02.08,0:25:04.21,Main,Marine,0,0,0,,Yağmur gibi yağıyorlar!Dialogue: 0,0:25:08.45,0:25:10.50,Main,Marine2,0,0,0,,Kaçın! Sakın dokunmayın!Dialogue: 0,0:25:13.66,0:25:17.11,Main,Tashigi,0,0,0,,Smoker-san. Burada kalmak çok tehlikeli.Dialogue: 0,0:25:17.11,0:25:18.73,Main,Tashigi,0,0,0,,Sığınacak bir yer bulmalıyız.Dialogue: 0,0:25:28.06,0:25:32.58,Main,Caesar,0,0,0,,Aferin oğluma! Seni üç yıl boyunca kapalı tuttuğum için kusuruma bakma!Dialogue: 0,0:25:35.01,0:25:36.70,Main,Sheep,0,0,0,,Master!Dialogue: 0,0:25:36.70,0:25:39.46,Main,Goat,0,0,0,,Neden buradasınız?! Burası çok tehlikeli!Dialogue: 0,0:25:48.17,0:25:50.13,Main,Smoker,0,0,0,,Biliyordum!Dialogue: 0,0:25:50.13,0:25:53.11,Main,Smoker,0,0,0,,Sen Caesar Clown'sun değil mi?!Dialogue: 0,0:25:53.48,0:25:56.84,Main,Luffy,0,0,0,,Sen misin be şu Master denen kişi?!Dialogue: 0,0:25:58.67,0:26:00.66,Main,Caesar,0,0,0,,Aynen öyle, benim!Dialogue: 0,0:26:00.66,0:26:05.37,Main,Caesar,0,0,0,,Bana iyi bakın, Hasır Şapka Korsanları tayfası ve donanmanın G-5 bölümü.Dialogue: 0,0:26:05.37,0:26:08.88,Main,Caesar,0,0,0,,Ben dünyanın bir numaralı bilim adamıyım!Dialogue: 0,0:26:12.20,0:26:15.64,Main,Caesar,0,0,0,,"Master" Caesar Clown!Dialogue: 0,0:26:21.89,0:26:24.66,Main,Caesar,0,0,0,,Çok uzun sürmeyecek.Dialogue: 0,0:26:27.53,0:26:30.54,Main,Caesar,0,0,0,,Suya karşı güçsüz olduğundan...Dialogue: 0,0:26:30.54,0:26:38.67,Main,Caesar,0,0,0,,...gölü geçebilmek için yavaş yavaş parçalarını bu tarafa fırlatıyor!Dialogue: 0,0:26:41.07,0:26:46.05,Main,Caesar,0,0,0,,Yanan Topraklar'dan, Buzdan Topraklar'a!Dialogue: 0,0:26:46.05,0:26:50.71,Main,Caesar,0,0,0,,Tüm parçaları bu tarafa erişmeyi başardığında...Dialogue: 0,0:26:53.31,0:26:56.20,Main,Caesar,0,0,0,,...hepiniz dört yıl önce...Dialogue: 0,0:26:57.16,0:27:02.67,Main,Caesar,0,0,0,,...Punk Hazard'ı yok eden canlı bir kimyasal silahın tadına bakacaksınız!Dialogue: 0,0:27:03.67,0:27:07.83,Main,Caesar,0,0,0,,Bu adayı hiçbir şeyin hayatta kalamayacağı bir ölüm coğrafyasına dönüştürecek!Dialogue: 0,0:27:12.04,0:27:14.29,Main,Zoro,0,0,0,,O şey canlı mı?Dialogue: 0,0:27:14.29,0:27:17.06,Main,Sanji,0,0,0,,Hiçbir fikrim yok. Hiç böyle bir şey görmemiştim.Dialogue: 0,0:27:17.89,0:27:20.60,Main,Sanji,0,0,0,,Gizemli şeyler...Dialogue: 0,0:27:20.60,0:27:22.92,Main,Zoro,0,0,0,,...yapan gizemli bir şey.Dialogue: 0,0:27:42.00,0:27:44.19,Main,Luffy,0,0,0,,Yakaladım!