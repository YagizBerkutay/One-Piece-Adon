,2,0,2,10,10,10,1Style: Secondary,Impress BT,52.0,&H00D6D6D6,&H00FFFFFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,1.5,1.5,2,120,120,18,1Style: Eyecatch,Kozuka Gothic Pro B,52.0,&H00FFFFFF,&H00FFFFFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,1.5,1.5,2,120,120,18,1Style: Sign,Futura Md BT,35.0,&H00FFFFFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.5,1.5,8,120,120,18,1Style: Attack,Duality,33.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.0,1.0,7,12,12,12,1Style: Author,Impress BT,19.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.5,0.5,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:10.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Knaryaa thx to onepace.netDialogue: 0,0:13:41.00,0:13:51.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Knaryaa thx to onepace.netDialogue: 0,0:29:43.95,0:29:46.85,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Knaryaa thx to onepace.netDialogue: 0,0:02:31.00,0:02:32.16,Main,Usopp,0,0,0,,Dialogue: 0,0:02:32.16,0:02:36.58,Main,Usopp,0,0,0,,Gerçekten bu gölü geçmeyi düşünüyor musun, Luffy?!Dialogue: 0,0:02:32.68,0:02:36.58,captionsşsoft,Caption,0,0,0,,Yanan TopraklarDialogue: 0,0:02:32.68,0:02:36.58,captionsşsoft,Caption,0,0,0,,- Luffy'nin Tarafı -Dialogue: 0,0:02:36.58,0:02:37.29,Main,Luffy,0,0,0,,Evet.Dialogue: 0,0:02:37.29,0:02:41.09,Main,Usopp,0,0,0,,Peki bu gölü nasıl geçmeyi planlıyorsun?!Dialogue: 0,0:02:41.09,0:02:43.84,Main,Usopp,0,0,0,,Bir tarafı yanıyor, diğer tarafı ise donmuş!Dialogue: 0,0:02:43.84,0:02:47.57,Main,Zoro,0,0,0,,O zaman suyun sıcaklığı iyi olabilir.  Ben de terlemiştim...Dialogue: 0,0:02:47.57,0:02:48.34,Main,Zoro,0,0,0,,Karşıya yüzelim mi?Dialogue: 0,0:02:48.34,0:02:49.22,Main,Usopp,0,0,0,,Saçmalama!Dialogue: 0,0:02:49.22,0:02:52.16,Main,Luffy,0,0,0,,Ben ve Robin yüzemeyiz.Dialogue: 0,0:02:56.10,0:02:58.61,Main,Usopp,0,0,0,,Karşıya kadar üzerimize binmek istiyorsunuz, değil mi?!Dialogue: 0,0:02:58.61,0:03:00.73,Main,Usopp,0,0,0,,Yani ne düşünürsem düşüneyim...Dialogue: 0,0:03:00.73,0:03:03.86,Main,Usopp,0,0,0,,Eğer gölü geçmezsek, yolumuzdan sapacağız.Dialogue: 0,0:03:03.86,0:03:06.79,Main,Usopp,0,0,0,,Galiba başka şansımız yok. Ben hallederim!Dialogue: 0,0:03:06.79,0:03:09.41,Main,Usopp,0,0,0,,Tamamdır, hadi yapalım!Dialogue: 0,0:03:09.79,0:03:12.41,Attack,Usopp,0,0,0,,Yeşil YıldızDialogue: 0,0:03:13.36,0:03:15.16,Attack,TL Note,0,0,0,,Yelpaze OtuDialogue: 0,0:03:16.42,0:03:17.80,Main,Luffy,0,0,0,,Bu ot da ne?Dialogue: 0,0:03:18.00,0:03:19.38,Attack,Luffy,0,0,0,,Muz BotuDialogue: 0,0:03:23.65,0:03:26.76,Main,Luffy,0,0,0,,Bu bir bot! Harikasın, Usopp!Dialogue: 0,0:03:26.76,0:03:29.81,Main,Usopp,0,0,0,,Ve bu yelpaze otunu kürek olarak kullanabiliriz!Dialogue: 0,0:03:29.81,0:03:32.30,Main,Robin,0,0,0,,Görüyorum ki her çeşit tohumun var.Dialogue: 0,0:03:32.30,0:03:33.71,Main,Robin,0,0,0,,Ne kadar harika.Dialogue: 0,0:03:33.71,0:03:38.60,Main,Usopp,0,0,0,,Sonuçta Boyn Adaları tuhaf bitkilerden oluşan bir hazineydi!Dialogue: 0,0:03:38.60,0:03:43.20,Main,Usopp,0,0,0,,Ne zaman tehlikeli bir bölgeye girsem,  uygun bitkileri bulmayı başardım!Dialogue: 0,0:03:43.73,0:03:45.54,Main,Usopp,0,0,0,,O adada iki yıl boyunca hayatta kalmayı başardım,Dialogue: 0,0:03:45.54,0:03:49.37,Main,Usopp,0,0,0,,yani yapamayacağım hiçbir şey yok diyebilir-Dialogue: 0,0:03:49.37,0:03:51.01,Main,Luffy,0,0,0,,Bin hadi, Usopp!Dialogue: 0,0:03:51.01,0:03:52.00,Main,Zoro,0,0,0,,Geride kalacaksın.Dialogue: 0,0:03:52.00,0:03:55.25,Main,Usopp,0,0,0,,Onu yapan bendim!Dialogue: 0,0:03:55.25,0:03:57.13,Main,Luffy,0,0,0,,Tamamdır!Dialogue: 0,0:03:57.13,0:03:59.00,Main,Luffy,0,0,0,,Gidelim!Dialogue: 0,0:03:59.00,0:04:00.91,Main,Luffy,0,0,0,,Tıraşlanmış buz diyarına!Dialogue: 0,0:04:00.91,0:04:02.36,Main,Usopp,0,0,0,,Küreklere asıl!Dialogue: 0,0:04:03.84,0:04:05.64,Main,Luffy,0,0,0,,Rüzgar aşırı güçlü!Dialogue: 0,0:04:05.64,0:04:07.40,Main,Usopp,0,0,0,,Ve rüzgara karşı gidiyoruz!Dialogue: 0,0:04:07.40,0:04:08.68,Main,Robin,0,0,0,,Tabii ki.Dialogue: 0,0:04:08.68,0:04:13.52,Main,Robin,0,0,0,,Adadaki aşırı sıcaklık farkı  rüzgarın esmesine neden oluyor.Dialogue: 0,0:04:13.52,0:04:15.19,Main,Zoro,0,0,0,,Burada su kaynıyor.Dialogue: 0,0:04:15.19,0:04:19.12,Main,Usopp,0,0,0,,Eğer yüzmeye çalışsaydık, bu bir felaket olurdu.Dialogue: 0,0:04:19.12,0:04:20.91,Main,Luffy,0,0,0,,Pek ilerleme kaydetmiyoruz.Dialogue: 0,0:04:20.91,0:04:23.02,Main,Usopp,0,0,0,,Sen de kürek çekmelisin!Dialogue: 0,0:04:24.38,0:04:25.49,Main,Centaur,0,0,0,,Kaçamayacaksınız.Dialogue: 0,0:04:26.00,0:04:28.27,Main,Centaur,0,0,0,,Bekleyin, kahrolasılar!Dialogue: 0,0:04:28.27,0:04:29.45,Main,Usopp,0,0,0,,Dikkat edin!Dialogue: 0,0:04:30.27,0:04:31.87,Main,Zoro,0,0,0,,Önceki Sentor!Dialogue: 0,0:04:31.87,0:04:36.11,Main,Luffy,0,0,0,,Sonunda tayfama katılmaya karar verdin mi?Dialogue: 0,0:04:36.11,0:04:38.38,Main,Zoro,0,0,0,,Cidden onu tekrar mı davet ettin?!Dialogue: 0,0:04:38.38,0:04:41.93,Main,Usopp,0,0,0,,Karşılaştığımız her ucubeden bize katılmasını istemeyi bırakacak mısın?Dialogue: 0,0:04:45.43,0:04:46.88,Main,Robin,0,0,0,,Boru mu?Dialogue: 0,0:04:46.88,0:04:49.09,Main,Centaur,0,0,0,,Patron!Dialogue: 0,0:04:49.09,0:04:49.93,Main,Zoro,0,0,0,,Patron mu?Dialogue: 0,0:04:49.93,0:04:51.51,Main,Usopp,0,0,0,,Bu bana,Dialogue: 0,0:04:51.51,0:04:53.70,Main,Usopp,0,0,0,,Den Den Mushi'deki sesi hatırlattı...Dialogue: 0,0:04:53.70,0:04:57.12,Flashbacks,Voice,0,0,0,,Donuyorum... Patron sen misin?Dialogue: 0,0:04:57.12,0:05:02.39,Main,Centaur,0,0,0,,Davetsiz misafirler sana doğru geliyor! Lütfen onların icabına bak!Dialogue: 0,0:05:04.80,0:05:08.57,Main,Robin,0,0,0,,Kıyıda bir şey belirdi.Dialogue: 0,0:05:17.36,0:05:20.18,Main,Zoro,0,0,0,,Bu onun patronu mu?Dialogue: 0,0:05:20.18,0:05:24.75,Main,Usopp,0,0,0,,Yani acil durum mesajı ondan mı geldi?Dialogue: 0,0:05:24.75,0:05:28.86,Main,Usopp,0,0,0,,O zaman, bize saldırmaya çalışması saçma olur!Dialogue: 0,0:05:33.45,0:05:35.96,Main,Boss,0,0,0,,İçlerinden biri kılıç taşıyor.Dialogue: 0,0:05:36.89,0:05:39.16,Main,Boss,0,0,0,,Yoldaşlarımızı kesen...Dialogue: 0,0:05:40.34,0:05:42.14,Main,Boss,0,0,0,,...samuray bu mu?Dialogue: 0,0:05:44.69,0:05:46.23,Main,Marine,0,0,0,,Volkanik patlama mı?!Dialogue: 0,0:05:46.23,0:05:48.27,Main,Marine,0,0,0,,Bu adayı ziyaret etmek...Dialogue: 0,0:05:48.27,0:05:51.87,Main,Marine,0,0,0,,bana Akainu ve Aokiji'nin bana dik dik baktığını hissettiriyor!Dialogue: 0,0:05:53.12,0:05:54.79,Main,Marine,0,0,0,,Korkunç!Dialogue: 0,0:05:54.79,0:05:55.87,Main,Marine,0,0,0,,Hadi burayı terk edelim!Dialogue: 0,0:05:55.87,0:05:57.12,Main,Tashigi,0,0,0,,Lütfen, ateş edin.Dialogue: 0,0:06:12.30,0:06:14.01,Main,Marine,0,0,0,,Bir nehir!Dialogue: 0,0:06:14.01,0:06:16.04,Main,Marine,0,0,0,,Bu harikaydı, Smo-ya!Dialogue: 0,0:06:16.04,0:06:20.53,Main,Marine,0,0,0,,İnanılmaz! Buzun arkasında bir nehir olduğunu nasıl bildin Smo-ya?!Dialogue: 0,0:06:20.53,0:06:22.40,Main,Marine,0,0,0,,Harika birisin, Smo-ya!Dialogue: 0,0:06:22.40,0:06:24.99,Main,Marine,0,0,0,,Hiçbir şey fark etmedim, Smo-ya!Dialogue: 0,0:06:30.76,0:06:33.56,Main,Smoker,0,0,0,,Su akıntılarını izleyen herkes fark ederdi!Dialogue: 0,0:06:33.56,0:06:35.70,Main,Smoker,0,0,0,,Temel gözlemden yoksunsunuz.Dialogue: 0,0:06:35.70,0:06:38.67,Main,Smoker,0,0,0,,Ayrıca, bu kadar şımarmayın!Dialogue: 0,0:06:39.12,0:06:40.54,Main,Tashigi,0,0,0,,Ancak bu akla bir soru işareti bırakıyor.Dialogue: 0,0:06:41.08,0:06:42.08,Main,Smoker,0,0,0,,Evet.Dialogue: 0,0:06:44.09,0:06:48.08,Main,Smoker,0,0,0,,Sorun burada bir nehrin olması değil...Dialogue: 0,0:06:48.08,0:06:51.88,Main,Smoker,0,0,0,,Şunu sormamız gerekiyor, buz bu doğal akışı engelliyor muydu...Dialogue: 0,0:06:51.88,0:06:54.88,Main,Smoker,0,0,0,,yoksa bilerek mi yerleştirildi?Dialogue: 0,0:06:55.27,0:06:56.89,Main,Marine,0,0,0,,Birisinin bunu...Dialogue: 0,0:06:56.89,0:07:00.20,Main,Marine,0,0,0,,bilerek saklamış olabileceğini mi demek istiyorsun?Dialogue: 0,0:07:00.20,0:07:04.41,Main,Marine,0,0,0,,Bu adada, bu gaz bulutunda birisinin yaşayabileceğini mi söylüyorsun?Dialogue: 0,0:07:04.41,0:07:07.60,Main,Marine,0,0,0,,İmkansız! Her zaman maske takmaları gerekirdi!Dialogue: 0,0:07:07.60,0:07:11.30,Main,Tashigi,0,0,0,,Yayında duyduğumuz ses kesinlikle bu adanın adını söylüyordu.Dialogue: 0,0:07:11.30,0:07:13.84,Main,Marine,0,0,0,,Yanlış duymuş olmalıyız, Tashigi-chan!Dialogue: 0,0:07:13.84,0:07:16.55,Main,Marine,0,0,0,,Böyle bir yerde Den Den Mushi'ler bile ölür!Dialogue: 0,0:07:18.12,0:07:19.58,Main,Marine,0,0,0,,Haklısın!Dialogue: 0,0:07:21.45,0:07:24.71,Main,Tashigi,0,0,0,,Eğer gülmek için zamanınız varsa, o zaman diğer buzdan duvarı da temizlemek için zamanınız var.Dialogue: 0,0:07:30.31,0:07:31.54,Main,Marine,0,0,0,,Bu da ne böyle?!Dialogue: 0,0:07:31.54,0:07:33.89,Main,Marine,0,0,0,,Buzdan bir duvar!Dialogue: 0,0:07:33.89,0:07:37.46,Main,Tashigi,0,0,0,,Eğer ona çarparsak, gemi tamamiyle batar!Dialogue: 0,0:07:37.46,0:07:38.42,Main,Marine,0,0,0,,Bu hiç iyi değil!Dialogue: 0,0:07:38.42,0:07:39.69,Main,Marine,0,0,0,,Parçalayın!Dialogue: 0,0:07:40.25,0:07:41.40,Main,Marine,0,0,0,,Ateş!Dialogue: 0,0:07:44.53,0:07:48.66,captionsşsoft,Caption,0,0,0,,Donmuş Topraklar - Gizemli tesisin içindeDialogue: 0,0:07:44.53,0:07:48.66,captionsşsoft,Caption,0,0,0,,- Nami'nin Grubu -Dialogue: 0,0:07:56.04,0:07:58.18,Main,Chopper,0,0,0,,Çocuklar, bu tarafa!Dialogue: 0,0:07:58.18,0:07:59.55,Main,Chopper,0,0,0,,Eğer çıkmak istiyorsanız koşmalısınız!Dialogue: 0,0:08:00.21,0:08:01.92,Main,Nami,0,0,0,,Kesinlikle gaza gelmişsin, Chopper!Dialogue: 0,0:08:01.92,0:08:04.49,Main,Chopper,0,0,0,,Tabii ki! Sanji bana görev verdi...Dialogue: 0,0:08:04.49,0:08:07.98,Main,Chopper,0,0,0,,Çocukları koruma ve güvenli bir şekilde bu binadan çıkarma!Dialogue: 0,0:08:07.98,0:08:10.39,Main,Chopper,0,0,0,,Ve öyle yapacağım!Dialogue: 0,0:08:10.39,0:08:14.87,Main,Chopper,0,0,0,,Görevimi yerine getireceğim!Dialogue: 0,0:08:23.53,0:08:26.81,Main,Chopper,0,0,0,,Burada ki tek erkek olarak, elimden geleni yapmalıyım!Dialogue: 0,0:08:28.32,0:08:30.75,Main,Nami,0,0,0,,Ama nereye gitmeliyiz?Dialogue: 0,0:08:30.75,0:08:32.92,Main,Chopper,0,0,0,,Bunu sen düşünmelisin!Dialogue: 0,0:08:34.00,0:08:35.32,Main,Nami,0,0,0,,Bilmiyorum ki!Dialogue: 0,0:08:35.32,0:08:37.78,Main,Mocha,0,0,0,,Abla, iyi misin?Dialogue: 0,0:08:38.80,0:08:40.07,Main,Nami,0,0,0,,Tabii ki!Dialogue: 0,0:08:40.07,0:08:43.83,Main,Nami,0,0,0,,Bundan daha çılgın durumlarla kaç kez karşılaştığımı sayamıyorum bile!Dialogue: 0,0:08:43.83,0:08:45.58,Main,Nami,0,0,0,,Beni takip edin ve dert etmeyin.Dialogue: 0,0:08:46.54,0:08:47.25,Main,Mocha,0,0,0,,Tamam!Dialogue: 0,0:08:54.85,0:08:59.56,captionsşsoft,Caption,0,0,0,,Gizemli tesisin içinde - Bisküvi OdasıDialogue: 0,0:08:54.85,0:08:59.56,captionsşsoft,Caption,0,0,0,,- Sanji'nin Grubu -Dialogue: 0,0:09:01.65,0:09:04.35,Attack,Franky,0,0,0,,Sol SilahlarDialogue: 0,0:09:11.90,0:09:14.11,Main,Franky,0,0,0,,Süper!Dialogue: 0,0:09:14.11,0:09:17.11,Main,Man,0,0,0,,V-Vücudunun her yerine silah yerleştirmiş!Dialogue: 0,0:09:17.11,0:09:20.01,Main,Man,0,0,0,,Bu o olmalı! Odanın kapısını yok eden adam!Dialogue: 0,0:09:21.17,0:09:23.87,Main,Franky,0,0,0,,Silahlarım ilginizi çekmiş görünüyor.Dialogue: 0,0:09:23.87,0:09:27.51,Main,Franky,0,0,0,,Tamamdır! Bunları size istediğiniz kadar göstereceğim!Dialogue: 0,0:09:27.51,0:09:29.14,Main,Man,0,0,0,,Silahlarınızı zehirli gaz mermileriyle doldurun!Dialogue: 0,0:09:29.14,0:09:31.04,Main,Man,0,0,0,,Artık odada hiç çocuk kalmadı!Dialogue: 0,0:09:32.13,0:09:34.09,Main,Man,0,0,0,,Kendinizi tutmayın, onları kurşunlarla delik deşik edin!Dialogue: 0,0:09:40.13,0:09:44.64,Main,Sanji,0,0,0,,Öyleyse, maskelerinizi çıkartın da  zehirli gazı beraber soluyalım!Dialogue: 0,0:09:44.64,0:09:45.51,Main,Man,0,0,0,,Kahrolası!Dialogue: 0,0:09:45.94,0:09:48.60,Main,Sanji,0,0,0,,Bu kadar kaygılı olmayın.Dialogue: 0,0:09:58.65,0:10:00.27,Main,Man,0,0,0,,Maskelerimizi çıkardı!Dialogue: 0,0:10:00.27,0:10:01.78,Main,Man,0,0,0,,Hava tüplerini de patlattı!Dialogue: 0,0:10:01.78,0:10:03.53,Main,Man,0,0,0,,Gaz mermilerini ateşlemeyin!Dialogue: 0,0:10:05.41,0:10:06.95,Main,Sanji,0,0,0,,Onlar ne?!Dialogue: 0,0:10:07.49,0:10:08.75,Main,Sanji,0,0,0,,Koyun mu?!Dialogue: 0,0:10:14.92,0:10:16.90,Main,Franky,0,0,0,,Ne yapıyorsun?Dialogue: 0,0:10:18.37,0:10:20.69,Main,Kinemon,0,0,0,,Bu daha önce karşılaştığım hiçbir insana benzemiyor!Dialogue: 0,0:10:20.69,0:10:23.17,Main,Kinemon,0,0,0,,Bu kim olabilir?!Dialogue: 0,0:10:23.17,0:10:24.55,Main,Kinemon,0,0,0,,Onu yenemiyorum!Dialogue: 0,0:10:24.55,0:10:26.97,Main,Franky,0,0,0,,Cidden, neden bahsediyorsun?Dialogue: 0,0:10:26.97,0:10:30.97,Main,Kinemon,0,0,0,,Bedenimden bahsediyorum!Dialogue: 0,0:10:30.97,0:10:31.88,Main,Franky,0,0,0,,Ha?Dialogue: 0,0:10:33.48,0:10:37.23,captionsşsoft,Caption,0,0,0,,Gizemli tesis - Ön GirişDialogue: 0,0:10:33.48,0:10:37.23,captionsşsoft,Caption,0,0,0,,- Brook -Dialogue: 0,0:10:40.62,0:10:43.96,Main,Brook,0,0,0,,Bekle bir saniye! Bu da ne?!Dialogue: 0,0:10:44.35,0:10:46.74,Main,Brook,0,0,0,,K-K-Kimsiniz, bayım?!Dialogue: 0,0:10:48.87,0:10:51.10,Main,Brook,0,0,0,,Bacaklarına ve kafana ne oldu?!Dialogue: 0,0:10:55.54,0:10:59.26,Main,Brook,0,0,0,,Korkunç! Lütfen bir şey söyle!Dialogue: 0,0:11:05.59,0:11:07.26,Main,Marine,0,0,0,,Ateş! Ateş!Dialogue: 0,0:11:27.93,0:11:29.95,Main,Smoker,0,0,0,,Yakında bu nehrinden çıkacağız.Dialogue: 0,0:11:32.02,0:11:35.08,Main,Marine,0,0,0,,İleride ne var?Dialogue: 0,0:11:36.26,0:11:38.43,Main,Smoker,0,0,0,,Bir tahminim var.Dialogue: 0,0:11:46.30,0:11:49.81,Main,Brook,0,0,0,,Acaba... bir ihtimal... hayalet olabilir mi?!Dialogue: 0,0:11:49.81,0:11:52.91,Main,Brook,0,0,0,,Eğer durum buysa, bu uygunsuz değil mi?!Dialogue: 0,0:11:52.91,0:11:54.95,Main,Brook,0,0,0,,Gün ortasındayız!Dialogue: 0,0:11:54.95,0:11:58.30,Main,Brook,0,0,0,,Her zaman iyi biri olmadım mı?Dialogue: 0,0:11:58.30,0:12:01.62,Main,Brook,0,0,0,,Kardan adam yapmak için karaya çıkmıştım!Dialogue: 0,0:12:01.62,0:12:05.49,Main,Brook,0,0,0,,Eğer istersen birlikte yapalım mı?Dialogue: 0,0:12:05.49,0:12:07.92,Main,Brook,0,0,0,,Eğer beraber yaparsak, hatta kardan heykel bile yapabil-Dialogue: 0,0:12:10.56,0:12:13.05,Main,Brook,0,0,0,,Şaka yapıyordum!Dialogue: 0,0:12:13.05,0:12:15.89,Main,Brook,0,0,0,,Burada neler oluyor böyle?!Dialogue: 0,0:12:15.89,0:12:20.73,Main,Brook,0,0,0,,Adamın gözleri yok, peki nasıl bu kadar isabetli bir şekilde saldırabiliyor?!Dialogue: 0,0:12:23.91,0:12:28.11,Main,Brook,0,0,0,,Ama düşününce benim de gözlerim yok!Dialogue: 0,0:12:36.75,0:12:39.59,Main,Brook,0,0,0,,Korkunç! Güçlü! Korkunç!Dialogue: 0,0:12:49.23,0:12:51.66,Main,Brook,0,0,0,,Sana ne oldu böyle?!Dialogue: 0,0:12:51.66,0:12:54.30,Main,Brook,0,0,0,,En azından bana neden saldırdığını söyle!Dialogue: 0,0:12:55.60,0:12:58.24,Attack,Brook,0,0,0,,Şafak Şarkısı: Sağ El VuruşuDialogue: 0,0:13:04.39,0:13:05.85,Main,Brook,0,0,0,,Nitouryuu?!Dialogue: 0,0:13:04.39,0:13:05.85,Note,TL Note,0,0,0,,İki-Kılıç StiliDialogue: 0,0:13:07.39,0:13:10.46,Main,Brook,0,0,0,,Lütfen, dur artık!Dialogue: 0,0:13:10.46,0:13:12.45,Main,Brook,0,0,0,,Korkunç! Korkunç!Dialogue: 0,0:13:12.45,0:13:14.16,Main,Brook,0,0,0,,Ürkütücü!Dialogue: 0,0:13:30.21,0:13:31.49,Main,Man,0,0,0,,Master.Dialogue: 0,0:13:32.21,0:13:34.84,Main,Ceasar,0,0,0,,Kaçan firarileri yakaladınız mı?Dialogue: 0,0:13:35.35,0:13:38.43,Main,Man,0,0,0,,Hayır, G-5 gemisi hakkında rapor vermek için geldim.Dialogue: 0,0:13:38.43,0:13:40.68,Main,Ceasar,0,0,0,,Onlar mı?Dialogue: 0,0:13:41.13,0:13:43.80,Main,Man,0,0,0,,Zehirli gaz bulutu onları durdurmadı...Dialogue: 0,0:13:45.87,0:13:49.68,Main,Man,0,0,0,,ve şu anda savaş gemisi buz duvarlarını yok etmek için toplarını kullanıyor,Dialogue: 0,0:13:49.68,0:13:51.51,Main,Man,0,0,0,,ve yavaş yavaş iç bölgelere doğru ilerliyorlar.Dialogue: 0,0:13:52.70,0:13:56.72,Main,Man,0,0,0,,Çok geçmeden, bu laboratuvara ulaşacaklar!Dialogue: 0,0:13:57.28,0:14:02.07,Main,Ceasar,0,0,0,,Neden? Bu adaya çıkmak için neden bu kadar ileri gidiyorlar?Dialogue: 0,0:14:02.64,0:14:06.00,Main,Ceasar,0,0,0,,Bir şekilde ihbar mı aldılar?Dialogue: 0,0:14:06.00,0:14:07.89,Main,Ceasar,0,0,0,,Gemiyi kim komuta ediyor?Dialogue: 0,0:14:08.34,0:14:09.81,Main,Man,0,0,0,,Koramiral Smoker.Dialogue: 0,0:14:10.26,0:14:12.42,Main,Ceasar,0,0,0,,Smoker mı?!Dialogue: 0,0:14:14.12,0:14:18.32,Main,Ceasar,0,0,0,,O kadar insan içinde... Ne belalı bir adam!Dialogue: 0,0:14:19.09,0:14:22.21,Main,Ceasar,0,0,0,,Ana girişe yanaşan gemileri gizleyin!Dialogue: 0,0:14:22.21,0:14:24.14,Main,Man,0,0,0,,Onlarla ilgilenelim mi?Dialogue: 0,0:14:24.14,0:14:27.14,Main,Ceasar,0,0,0,,Kimsenin burada olmasına izin verilmiyor,Dialogue: 0,0:14:27.14,0:14:30.18,Main,Ceasar,0,0,0,,o yüzden sizi görmediklerinden emin olun!Dialogue: 0,0:14:30.18,0:14:31.67,Main,Man,0,0,0,,Peki ya siz, Master?Dialogue: 0,0:14:31.67,0:14:35.25,Main,Ceasar,0,0,0,,Saçmalamayın! Oraya çıkmamın imkanı yok!Dialogue: 0,0:14:35.70,0:14:39.01,Main,Man,0,0,0,,Ama bu bize onları durdurmanın hiçbir yolunu bırakmıyor!Dialogue: 0,0:14:40.29,0:14:41.97,Main,Law,0,0,0,,Gitmemi ister misin?Dialogue: 0,0:14:51.00,0:14:52.14,Main,Tashigi,0,0,0,,Burada gaz yok.Dialogue: 0,0:14:56.41,0:14:59.42,Main,Marine,0,0,0,,Bu doğru! İnanamıyorum!Dialogue: 0,0:14:59.42,0:15:02.69,Main,Marine,0,0,0,,O halde neden daha önce bu kadar gaz vardı?Dialogue: 0,0:15:03.10,0:15:06.60,Main,Smoker,0,0,0,,Bizi burada istemeyen birinin işi olmalı.Dialogue: 0,0:15:06.60,0:15:09.12,Main,Marine,0,0,0,,Burada gerçekten birisi var mı?Dialogue: 0,0:15:09.59,0:15:12.55,Main,Smoker,0,0,0,,Doktor Vegapunk'ın araştırma tesisi.Dialogue: 0,0:15:13.33,0:15:15.40,Main,Smoker,0,0,0,,Daha doğrusu eskiden öyleydi.Dialogue: 0,0:15:16.06,0:15:20.31,Main,Smoker,0,0,0,,İnsan ve ekipmandan yoksun, boş bir bina olarak terk edilmesi gerekiyordu.Dialogue: 0,0:15:23.12,0:15:25.32,Main,Marine,0,0,0,,Burada kim yaşıyor?Dialogue: 0,0:15:25.83,0:15:27.65,Main,Marine,0,0,0,,Dışarı çık!Dialogue: 0,0:15:27.65,0:15:31.56,Main,Marine,0,0,0,,Sorun ne?! Bizden korkuyor musun?Dialogue: 0,0:15:31.56,0:15:35.08,Main,Marine,0,0,0,,Kibar davranıp kapı zilini çalmanıza gerek yok!Dialogue: 0,0:15:35.08,0:15:38.92,Main,Marine,0,0,0,,Geminin toplarıyla patlatırsak kapıyı anında açabiliriz, Smo-ya...Dialogue: 0,0:15:39.46,0:15:40.87,Main,Marine,0,0,0,,Smoker-san.Dialogue: 0,0:15:40.87,0:15:42.60,Main,Marine,0,0,0,,Cevap ver!Dialogue: 0,0:15:42.60,0:15:44.22,Main,Marine,0,0,0,,Kapıyı aç!Dialogue: 0,0:15:44.68,0:15:48.73,Main,Marine,0,0,0,,Dinliyor musun?! Bu ada yasak bölge!Dialogue: 0,0:15:48.73,0:15:51.12,Main,Marine,0,0,0,,Her kimsen, tutuklusun, salak!Dialogue: 0,0:15:56.40,0:15:57.72,Main,Marine,0,0,0,,Açılıyor!Dialogue: 0,0:15:57.72,0:16:00.14,Main,Marine,0,0,0,,Sonunda durumunu anladın mı? Biz denizciyiz!Dialogue: 0,0:16:13.76,0:16:17.20,Main,Law,0,0,0,,Tatil evimde ne işiniz var...Dialogue: 0,0:16:17.97,0:16:19.37,Main,Law,0,0,0,,Beyaz Avcı?Dialogue: 0,0:16:20.75,0:16:22.67,Main,Marine,0,0,0,,Bu imkansız!Dialogue: 0,0:16:22.67,0:16:23.68,Main,Marine,0,0,0,,O adam...Dialogue: 0,0:16:24.17,0:16:28.25,Main,Tashigi,0,0,0,,Eskiden 440 milyon beli ödülü olan bir çaylaktı...Dialogue: 0,0:16:28.25,0:16:29.67,Main,Tashigi,0,0,0,,ama şimdi...Dialogue: 0,0:16:29.67,0:16:32.31,Main,Tashigi,0,0,0,,Şahin-Göz Mihawk'la birlikte...Dialogue: 0,0:16:32.31,0:16:35.43,Main,Tashigi,0,0,0,,Korsan İmparatoriçe, Boa Hancock...Dialogue: 0,0:16:35.43,0:16:38.57,Main,Tashigi,0,0,0,,Donquixote Doflamingo ve diğerleri...Dialogue: 0,0:16:38.57,0:16:42.48,Main,Tashigi,0,0,0,,O, Hükümet tarafından yetkilendirilen Shichibukai'lerden biri!Dialogue: 0,0:16:46.05,0:16:48.44,Main,Smoker,0,0,0,,Trafalgar Law.Dialogue: 0,0:16:55.36,0:16:57.41,Main,Marine,0,0,0,,Hadi buradan gidelim, Smoker-san!Dialogue: 0,0:16:57.41,0:17:00.04,Main,Marine,0,0,0,,O adamla hiçbir şey yapmak istemiyorum!Dialogue: 0,0:17:00.48,0:17:02.80,Main,Marine,0,0,0,,Biliyorsun, değil mi?Dialogue: 0,0:17:04.50,0:17:07.59,Main,Marine,0,0,0,,Shichibukai olabilmek için...Dialogue: 0,0:17:17.91,0:17:22.11,Main,Marine,0,0,0,,yüz korsanın kalbini Denizci Karargahına verdi!Dialogue: 0,0:17:22.11,0:17:23.94,Main,Marine,0,0,0,,O tamamen dengesiz biri!Dialogue: 0,0:17:24.65,0:17:26.73,Main,Marine,0,0,0,,Beni ürkütüyor!Dialogue: 0,0:17:29.15,0:17:32.20,Main,Smoker,0,0,0,,Neden buradasın?Dialogue: 0,0:17:32.20,0:17:39.37,Main,Smoker,0,0,0,,Bu ada hem korsanlara hem de Hükümete yasaktır, Law!Dialogue: 0,0:17:41.29,0:17:44.83,Main,Law,0,0,0,,Ben de sana aynı şeyi sorabilirim.Dialogue: 0,0:17:45.46,0:17:50.10,captionsşsoft,Caption,0,0,0,,Dr. Vegapunk'ın eski laboratuvarının içiDialogue: 0,0:17:45.46,0:17:50.10,captionsşsoft,Caption,0,0,0,,- Nami'nin Grubu -Dialogue: 0,0:17:45.96,0:17:49.44,Main,Child,0,0,0,,Baba! Anne!Dialogue: 0,0:17:55.01,0:17:59.46,Main,Chopper,0,0,0,,Artık hasta olmadığınızı söylemiştin, değil mi?Dialogue: 0,0:18:00.11,0:18:00.64,Main,Biyo,0,0,0,,Evet.Dialogue: 0,0:18:01.52,0:18:03.18,Main,Chopper,0,0,0,,Ne tür bir hastalığa yakalandınız?Dialogue: 0,0:18:03.99,0:18:06.41,Main,Chopper,0,0,0,,Hiçbiriniz herhangi bir belirti göstermiyorsunuz.Dialogue: 0,0:18:06.41,0:18:13.39,Main,Biyo,0,0,0,,Bilmiyorum. "Senin bir hastalığın var" ve "Bir yıl sonra iyi olacaksın" dediler.Dialogue: 0,0:18:16.94,0:18:19.46,Main,Chopper,0,0,0,,Bir yıl sonra geçen bir hastalık mı?Dialogue: 0,0:18:19.46,0:18:20.82,Main,Biyo,0,0,0,,Evet.Dialogue: 0,0:18:21.99,0:18:29.84,Main,Biyo,0,0,0,,Annem ve babam bazı insanlardan beni iyileştirmelerini istediler ve sonra o insanlar beni buraya getirdiler.Dialogue: 0,0:18:29.84,0:18:33.41,Main,Nami,0,0,0,,Yani ailen sana buraya gelmeni mi söyledi?Dialogue: 0,0:18:33.41,0:18:34.63,Main,Biyo,0,0,0,,Hayır.Dialogue: 0,0:18:34.63,0:18:38.24,Main,Biyo,0,0,0,,O insanlardı, tüm bunları bana evimin dışında anlattılar,Dialogue: 0,0:18:38.24,0:18:40.06,Main,Biyo,0,0,0,,ve sonra buraya getirildim.Dialogue: 0,0:18:40.06,0:18:44.69,Main,Biyo,0,0,0,,Anneme ve babama hastalığı bulaştırabileceğimi söylediler.Dialogue: 0,0:18:44.69,0:18:46.49,Main,Biyo,0,0,0,,Onlara hoşçakal bile diyemedim.Dialogue: 0,0:18:46.49,0:18:48.18,Main,Nami,0,0,0,,Geri kalanınız için de böyle miydi?Dialogue: 0,0:18:48.18,0:18:48.79,Main,Child,0,0,0,,Evet.Dialogue: 0,0:18:48.79,0:18:49.36,Main,Child,0,0,0,,Benim de.Dialogue: 0,0:18:49.86,0:18:53.50,Thoughts,Nami,0,0,0,,Bu doğruysa! Kesinlikle kaçırılmışlar!Dialogue: 0,0:18:53.50,0:18:57.90,Main,Chopper,0,0,0,,Yani buraya yabancılar tarafından getirildin ve ilk önce ailenle konuşmadın mı?Dialogue: 0,0:18:58.62,0:19:00.75,Main,Chopper,0,0,0,,Bu neye benziyor biliyor musun?Dialogue: 0,0:19:00.75,0:19:02.47,Main,Chopper,0,0,0,,İnanılmaz korkunç bir hastalığa yakalanmışsın!Dialogue: 0,0:19:02.47,0:19:04.24,Main,Nami,0,0,0,,Sen salak mısın?Dialogue: 0,0:19:04.91,0:19:06.89,Main,Chopper,0,0,0,,Bütün bunlar sizin için çok mu fazla?Dialogue: 0,0:19:06.89,0:19:09.26,Main,Chopper,0,0,0,,Yorulmuş herkesi taşıyacağım.Dialogue: 0,0:19:10.12,0:19:13.99,Main,Nami,0,0,0,,Ama zaten bir yıldan fazladır buradasınız, değil mi?Dialogue: 0,0:19:13.99,0:19:17.08,Main,Nami,0,0,0,,Chopper, bundan sonra onlara bir bak.  O zaman kesin olarak anlarız.Dialogue: 0,0:19:17.08,0:19:19.63,Main,Chopper,0,0,0,,Tamam. Bakarım.Dialogue: 0,0:19:25.47,0:19:26.31,Main,Chopper,0,0,0,,Nami!Dialogue: 0,0:19:26.31,0:19:27.77,Main,Chopper,0,0,0,,Önümden çekil!Dialogue: 0,0:19:30.10,0:19:31.94,Main,Chopper,0,0,0,,Bir kez daha!Dialogue: 0,0:19:33.86,0:19:35.61,Main,Chopper,0,0,0,,Açıldı.Dialogue: 0,0:19:37.58,0:19:39.32,Main,Nami,0,0,0,,Çok güçlenmişsin.Dialogue: 0,0:19:37.58,0:19:39.32,Secondary,Child,0,0,0,,Harika!Dialogue: 0,0:19:39.32,0:19:41.55,Main,Mocha,0,0,0,,Çok havalı, Rakun Köpek-chan!Dialogue: 0,0:19:42.49,0:19:44.25,Main,Chopper,0,0,0,,Hayır, ben rakun köpek değilim!Dialogue: 0,0:19:44.25,0:19:46.20,Main,Nami,0,0,0,,Ama öyle gibi davrandın.Dialogue: 0,0:19:46.20,0:19:46.95,Main,Chopper,0,0,0,,Haklısın!Dialogue: 0,0:19:48.07,0:19:49.73,Main,Nami,0,0,0,,Donuyorum!Dialogue: 0,0:19:49.73,0:19:51.99,Main,Nami,0,0,0,,Chopper, kürkünü bana ödünç ver!Dialogue: 0,0:19:51.99,0:19:53.60,Main,Chopper,0,0,0,,Olur...Dialogue: 0,0:19:53.60,0:19:54.79,Main,Chopper,0,0,0,,Hayır, onu çıkaramam!Dialogue: 0,0:19:54.79,0:19:57.75,Main,Nami,0,0,0,,Burası neresi? Dışarıda mıyız?Dialogue: 0,0:19:57.75,0:19:59.46,Main,Nami,0,0,0,,Ya da belki bir dondurucu mu?Dialogue: 0,0:19:59.46,0:20:01.85,Main,Nami,0,0,0,,O kadar karanlık ki anlamıyorum...Dialogue: 0,0:20:02.71,0:20:04.64,Main,Chopper,0,0,0,,Bu hava benim için mükemmel!Dialogue: 0,0:20:04.64,0:20:06.34,Main,Nami,0,0,0,,O kadar karanlık ki hiçbir şey...Dialogue: 0,0:20:06.34,0:20:07.73,Main,Nami,0,0,0,,Şimdi görüyorum!Dialogue: 0,0:20:07.73,0:20:08.98,Main,Nami,0,0,0,,Diğer tarafta bir kapı var!Dialogue: 0,0:20:08.98,0:20:10.06,Main,Chopper,0,0,0,,Haklısın!Dialogue: 0,0:20:10.06,0:20:12.55,Main,Nami,0,0,0,,Hadi gidelim! Burası çıkmaz sokak değil!Dialogue: 0,0:20:12.56,0:20:13.68,Main,Chopper,0,0,0,,Tamamdır!Dialogue: 0,0:20:13.68,0:20:16.77,Main,Mocha,0,0,0,,Abla! Oraya girmek istemiyorum! Korkuyorum!Dialogue: 0,0:20:16.77,0:20:17.57,Main,Nami,0,0,0,,Ne?!Dialogue: 0,0:20:19.52,0:20:21.28,Main,Nami,0,0,0,,Ne oldu, çocuklar?Dialogue: 0,0:20:21.28,0:20:23.06,Main,Chopper,0,0,0,,Acele edin! Hala peşimizdeler!Dialogue: 0,0:20:23.06,0:20:26.88,Main,Mocha,0,0,0,,Bu adaya ilk geldiğimde beni buraya getirmişlerdi!Dialogue: 0,0:20:26.88,0:20:30.29,Main,Nami,0,0,0,,Gerçekten mi? O zaman çıkışa yol olmalı!Dialogue: 0,0:20:30.29,0:20:33.31,Main,Nami,0,0,0,,Hava oldukça soğuk ama hepiniz buna katlanmaya çalışın!Dialogue: 0,0:20:33.31,0:20:34.03,Main,Nami,0,0,0,,Acele edin!Dialogue: 0,0:20:34.03,0:20:35.48,Main,Mocha,0,0,0,,Sorun bu değil!Dialogue: 0,0:20:37.41,0:20:38.67,Main,Mocha,0,0,0,,Demek istediğim...Dialogue: 0,0:20:44.67,0:20:46.55,Main,Mocha,0,0,0,,etrafımız...Dialogue: 0,0:20:51.57,0:20:52.64,Main,Nami,0,0,0,,Etrafımız mı?Dialogue: 0,0:20:55.22,0:20:57.56,Main,Nami,0,0,0,,Duvarların içinde...Dialogue: 0,0:20:57.56,0:20:59.03,Main,Nami,0,0,0,,bir şey var.Dialogue: 0,0:21:10.07,0:21:14.19,Main,Mocha,0,0,0,,Buradan korkuyorum çünkü burada donmuş insanlar var!Dialogue: 0,0:21:14.19,0:21:16.40,Main,Chopper,0,0,0,,Ha?! Bunlar da ne böyle?!Dialogue: 0,0:21:16.40,0:21:19.08,Main,Nami,0,0,0,,Donmuş... cesetler mi?!Dialogue: 0,0:21:19.08,0:21:22.12,Main,Nami,0,0,0,,Üstümüzdeler!Dialogue: 0,0:21:23.03,0:21:24.04,Main,Chopper,0,0,0,,Ve altımızda!Dialogue: 0,0:21:28.87,0:21:30.59,Main,Chopper,0,0,0,,Olamaaaz!Dialogue: 0,0:21:30.59,0:21:34.10,Main,Mocha,0,0,0,,Lütfen bekleyin! Bizi bırakmayın!Dialogue: 0,0:21:34.81,0:21:36.99,Main,Franky,0,0,0,,Böylece halletmiş oluyoruz.Dialogue: 0,0:21:36.21,0:21:40.15,captionsşsoft,Caption,0,0,0,,Laboratuvarın içinde ・ Bisküvi OdasıDialogue: 0,0:21:36.21,0:21:40.15,captionsşsoft,Caption,0,0,0,,- Sanji'nin Grubu -Dialogue: 0,0:21:37.55,0:21:38.40,Main,Sanji,0,0,0,,Hey!Dialogue: 0,0:21:38.40,0:21:40.15,Main,Sanji,0,0,0,,Yollarını kapattın. Bu kadar yeter.Dialogue: 0,0:21:41.04,0:21:41.85,Main,Sanji,0,0,0,,Hadi ilerleyelim!Dialogue: 0,0:21:41.85,0:21:45.11,Main,Sanji,0,0,0,,Nami-san'ın kalbinde bir duygu patlaması hissettim!Dialogue: 0,0:21:45.11,0:21:47.74,Main,Sanji,0,0,0,,Bana karşı olan hislerinin farkına varmış olabilir!Dialogue: 0,0:21:48.07,0:21:50.53,Main,Franky,0,0,0,,Yine de bu adamlar neyin nesi böyle?!Dialogue: 0,0:21:50.53,0:21:53.02,Main,Franky,0,0,0,,Koyun bacakları var!Dialogue: 0,0:21:53.02,0:21:55.97,Main,Franky,0,0,0,,Böyle efsanevi bir yaratık var mı?Dialogue: 0,0:21:55.97,0:21:59.14,Main,Sanji,0,0,0,,Artık onlar için endişelenmenin bir anlamı yok.Dialogue: 0,0:21:59.14,0:22:01.24,Main,Sanji,0,0,0,,Burada neler olduğunu öğrenene kadar beklemeleri gerekecek!Dialogue: 0,0:22:01.45,0:22:02.50,Main,Kinemon,0,0,0,,Bekle!Dialogue: 0,0:22:02.50,0:22:05.05,Main,Kinemon,0,0,0,,Beni bırakın! Burada kalacağım!Dialogue: 0,0:22:05.05,0:22:08.76,Main,Kinemon,0,0,0,,Kaçmasına yardım ettiğin çocukların arasında oğlumdan hiçbir iz görmedim!Dialogue: 0,0:22:08.76,0:22:11.66,Main,Kinemon,0,0,0,,Başka odalar da olmalı! Kalmalı ve aramaya-Dialogue: 0,0:22:11.66,0:22:14.41,Main,Sanji,0,0,0,,Peki nasıl hareket etmeyi planlıyorsun?!Dialogue: 0,0:22:14.41,0:22:18.65,Main,Sanji,0,0,0,,Seni geride bırakmak ölüme terk etmekle aynı şey olur!Dialogue: 0,0:22:18.65,0:22:20.36,Main,Sanji,0,0,0,,Bu ağzımda korkunç bir tat bırakır!Dialogue: 0,0:22:20.36,0:22:23.81,Main,Kinemon,0,0,0,,Ama buraya oğlumu kurtarmak için geldim!Dialogue: 0,0:22:25.40,0:22:27.55,Main,Sanji,0,0,0,,Çok sinir bozucu bir şerefsizsin!Dialogue: 0,0:22:27.55,0:22:30.86,Main,Sanji,0,0,0,,Sadece sor! "Lütfen vücudumu arayın" diye!Dialogue: 0,0:22:30.86,0:22:32.74,Main,Sanji,0,0,0,,Bu arada vücudun nerede?Dialogue: 0,0:22:32.74,0:22:36.91,Main,Kinemon,0,0,0,,Bir korsana borçlu olmayı reddediyorum!  Yardımını istemektense ölmeyi tercih ederim!Dialogue: 0,0:22:37.12,0:22:38.98,Main,Kinemon,0,0,0,,A-Ancak...Dialogue: 0,0:22:38.98,0:22:43.34,Main,Kinemon,0,0,0,,Eğer vücudumu arayacak olursan...Dialogue: 0,0:22:44.01,0:22:46.34,Main,Kinemon,0,0,0,,şikayet etmem.Dialogue: 0,0:22:46.34,0:22:47.83,Main,Sanji,0,0,0,,Kahrolası adam!Dialogue: 0,0:22:47.83,0:22:50.01,Main,Sanji,0,0,0,,Neden kopmuş bir kafa benden daha üstünmüş gibi davranıyor?Dialogue: 0,0:22:50.01,0:22:51.87,Main,Kinemon,0,0,0,,Şiddete mi başvuruyorsun?!Dialogue: 0,0:22:51.87,0:22:53.67,Main,Kinemon,0,0,0,,P-Pişman değilim!Dialogue: 0,0:22:53.67,0:22:56.43,Main,Kinemon,0,0,0,,Kötü adamlara hayatım için yalvarmayacağım!Dialogue: 0,0:22:56.43,0:22:58.03,Main,Franky,0,0,0,,Biraz sakinleş!Dialogue: 0,0:22:58.03,0:23:01.52,Main,Franky,0,0,0,,Savunmasız bir kafayı ezmek kendini daha iyi hissettirecek mi?Dialogue: 0,0:23:03.07,0:23:07.25,Main,Franky,0,0,0,,Onu hücreden çıkardığın an da  çoktan kaybetmiştin Sanji.Dialogue: 0,0:23:07.25,0:23:08.19,Main,Sanji,0,0,0,,Ama...Dialogue: 0,0:23:11.19,0:23:14.04,Main,Sanji,0,0,0,,Bu adam gerçekten sinirlerimi bozuyor!Dialogue: 0,0:23:14.04,0:23:17.27,Main,Sanji,0,0,0,,Bir an için bile olsa onun kararlılığına hayran olmak aptallıktı!Dialogue: 0,0:23:17.27,0:23:18.62,Main,Sanji,0,0,0,,Artık ona yardım etmek istemiyorum!Dialogue: 0,0:23:18.62,0:23:24.24,Main,Kinemon,0,0,0,,Ne yazık ki beni burada bırakırsan savunmasız kalırım  ama beni de yanında götürmek istersen...Dialogue: 0,0:23:24.24,0:23:26.24,Main,Kinemon,0,0,0,,şikayet etmem.Dialogue: 0,0:23:30.61,0:23:34.15,Main,Sanji,0,0,0,,Lanet olsun... Vücudunu geri aldıktan sonra bunun hesabını vereceksin!Dialogue: 0,0:23:35.71,0:23:38.52,Main,Kinemon,0,0,0,,Kopmuş bir kafaya bile merhamet göstermiyorsun.Dialogue: 0,0:23:38.52,0:23:40.94,Main,Kinemon,0,0,0,,Evet. Söylediklerime dikkat etmeliyim.Dialogue: 0,0:23:40.94,0:23:43.96,Main,Franky,0,0,0,,Acaba Nami ve diğerleri bir çıkış yolu buldular mı? Onların peşinden gidelim!Dialogue: 0,0:23:43.96,0:23:45.94,Main,Kinemon,0,0,0,,Lanet olsun, kaşınıyor!Dialogue: 0,0:23:49.87,0:23:53.48,captionsşsoft,Caption,0,0,0,,Laboratuvarın ana girişiDialogue: 0,0:23:56.16,0:23:59.00,Flashbacks,Luffy,0,0,0,,Merhaba? Ben Monkey D. Luffy!Dialogue: 0,0:23:59.00,0:24:01.03,Flashbacks,Luffy,0,0,0,,Korsanlar Kralı olacak adamım!Dialogue: 0,0:24:01.03,0:24:02.86,Flashbacks,Usopp,0,0,0,,Çok erken cevap verdin ve çok fazla şey söylüyorsun!Dialogue: 0,0:24:04.11,0:24:05.86,Flashbacks,Voice,0,0,0,,Lütfen, yardım edin!Dialogue: 0,0:24:05.86,0:24:06.68,Flashbacks,Luffy,0,0,0,,Ne oldu?!Dialogue: 0,0:24:06.68,0:24:10.15,Flashbacks,Voice,0,0,0,,Donuyorum... Patron, sen misin?Dialogue: 0,0:24:10.15,0:24:11.78,Flashbacks,Luffy,0,0,0,,Hayır, ben patronun değilim.Dialogue: 0,0:24:11.78,0:24:16.47,Flashbacks,Voice,0,0,0,,Arkadaşlarım kesilmeye devam ediyor.Dialogue: 0,0:24:16.47,0:24:18.62,Flashbacks,Voice,0,0,0,,Samuray hepimizi öldürecek!Dialogue: 0,0:24:18.62,0:24:20.12,Flashbacks,Luffy,0,0,0,,Neredesin?!Dialogue: 0,0:24:20.90,0:24:23.52,Flashbacks,Voice,0,0,0,,Lütfen biri beni kurtarsın, kim olduğu umurumda değil.Dialogue: 0,0:24:23.52,0:24:25.12,Flashbacks,Voice,0,0,0,,Ben...Dialogue: 0,0:24:25.12,0:24:27.34,Flashbacks,Voice,0,0,0,, Punk Hazard'dayım!Dialogue: 0,0:24:30.17,0:24:33.90,Main,Tashigi,0,0,0,,Adanın adı ve ayrıca soğuk iklimden bahsediliyor.Dialogue: 0,0:24:33.90,0:24:38.85,Main,Tashigi,0,0,0,,Bu çağrının bu adadan gönderildiğine hiç şüphe yok.Dialogue: 0,0:24:41.19,0:24:44.03,Main,Smoker,0,0,0,,Hasır Şapkalı Luffy'yi tanıyorsun, değil mi?Dialogue: 0,0:24:45.40,0:24:48.11,Flashbacks,Luffy,0,0,0,,Gomu Gomu no...Dialogue: 0,0:24:48.11,0:24:49.61,Flashbacks,Luffy,0,0,0,,Fuusen!Dialogue: 0,0:24:48.11,0:24:49.61,Attack,Luffy,0,0,0,,BalonDialogue: 0,0:24:49.61,0:24:50.91,Flashbacks,Kid,0,0,0,,Repel!Dialogue: 0,0:24:49.61,0:24:50.91,Attack,Kid,0,0,0,,PüskürtDialogue: 0,0:24:52.16,0:24:53.49,Flashbacks,Law,0,0,0,,Room...Dialogue: 0,0:24:52.16,0:24:53.49,Attack,Law,0,0,0,,Oda...Dialogue: 0,0:24:54.20,0:24:55.37,Flashbacks,Law,0,0,0,,Shambles!Dialogue: 0,0:24:54.20,0:24:55.37,Attack,Law,0,0,0,,Karmaşa!Dialogue: 0,0:24:57.92,0:24:59.97,Flashbacks,Marine,0,0,0,,Beni yakaladı!Dialogue: 0,0:25:00.96,0:25:06.78,Main,Smoker,0,0,0,,İki yıl önce, Roswald Hanesi'ndeki Kutsal Ejderlerle yaşanan olay sırasında,Dialogue: 0,0:25:06.78,0:25:09.94,Main,Smoker,0,0,0,,sen, Kid ve Luffy birlikte çalıştınız.Dialogue: 0,0:25:10.39,0:25:13.05,Main,Smoker,0,0,0,,Üstelik büyük savaş sırasında...Dialogue: 0,0:25:14.32,0:25:16.43,Flashbacks,Law,0,0,0,,Hasır Şapkalı'yı buraya getirin!Dialogue: 0,0:25:16.43,0:25:19.14,Flashbacks,Law,0,0,0,,Onu buradan uzaklaştıracağım!Dialogue: 0,0:25:19.14,0:25:21.15,Flashbacks,Law,0,0,0,,Şimdilik onunla ilgilenmeme izin ver!Dialogue: 0,0:25:22.64,0:25:25.96,Main,Smoker,0,0,0,,Akainu tarafından takip edilirken, Hasır Şapka'nın...Dialogue: 0,0:25:25.96,0:25:27.58,Main,Smoker,0,0,0,,kaçmasına yardım ettin.Dialogue: 0,0:25:32.62,0:25:35.16,Main,Law,0,0,0,,Benimle ne işin var?Dialogue: 0,0:25:35.70,0:25:40.36,Main,Law,0,0,0,,Yanlış yardım çağrıları sizin uzmanlık alanınız, değil mi?Dialogue: 0,0:25:41.35,0:25:45.54,Main,Smoker,0,0,0,,Ne yazık ki bu iletişim bizim tuzaklarımızdan biri değildi.Dialogue: 0,0:25:45.54,0:25:49.42,Main,Law,0,0,0,,Oldukça gizemli. Ama hiçbir şey bilmiyorum. Bu yüzden bu konuşma burada biter.Dialogue: 0,0:25:49.42,0:25:53.94,Main,Smoker,0,0,0,,Saçmalamayı kes. Bırak laboratuvara girelim!Dialogue: 0,0:25:53.94,0:25:57.53,Main,Law,0,0,0,,Artık burası benim tatil evim. Reddediyorum!Dialogue: 0,0:25:57.53,0:26:02.24,Main,Law,0,0,0,,Benim gibi bir korsanın sizin terk ettiğiniz bir adada kalması yanlış mı?Dialogue: 0,0:26:02.24,0:26:04.63,Main,Law,0,0,0,,Burada ki tek kişi benim.Dialogue: 0,0:26:04.63,0:26:09.20,Main,Law,0,0,0,,Hasır Şapka ortaya çıkarsa kellesini alabilirsiniz.Dialogue: 0,0:26:09.20,0:26:11.99,Main,Law,0,0,0,,Eğer tek istediğiniz buysa, gidin!Dialogue: 0,0:26:17.01,0:26:20.45,Main,Mocha,0,0,0,,Donmuş insanlar çok korkutucuydu!Dialogue: 0,0:26:20.45,0:26:22.92,Main,Chopper,0,0,0,,Bu yerden bıktım artık!Dialogue: 0,0:26:22.92,0:26:24.91,Main,Nami,0,0,0,,Bakın! İleride kapı var!Dialogue: 0,0:26:24.91,0:26:25.88,Main,Nami,0,0,0,,Buradan çıkabiliriz!Dialogue: 0,0:26:25.88,0:26:27.40,Main,Child,0,0,0,,Yaşasın!Dialogue: 0,0:26:31.65,0:26:34.27,Main,Marine,0,0,0,,İçeride birisi var!Dialogue: 0,0:26:36.89,0:26:38.82,Main,Chopper,0,0,0,,Dışarıdayım!Dialogue: 0,0:26:38.82,0:26:40.65,Main,Nami,0,0,0,,Dışarıdayız! Dondurucu!Dialogue: 0,0:26:42.32,0:26:46.43,Main,Sind,0,0,0,,Binanın dışındayız! Eve gidebiliriz!Dialogue: 0,0:26:46.43,0:26:48.46,Main,Child,0,0,0,,Babamı ve annemi tekrar görebilirim!Dialogue: 0,0:26:48.46,0:26:50.08,Main,Child,0,0,0,,Çok soğuk!Dialogue: 0,0:26:51.22,0:26:52.54,Main,Franky,0,0,0,,Franky...Dialogue: 0,0:26:54.25,0:26:55.44,Main,Franky,0,0,0,,Tank burada!Dialogue: 0,0:26:55.44,0:26:58.67,Main,Franky,0,0,0,,Yoldan çekilin! Yoldan çekilin! Yoldan-Süper çekilin!Dialogue: 0,0:26:58.67,0:27:01.82,Main,Franky,0,0,0,,Yoluma çıkan herkesi ezeceğim!Dialogue: 0,0:27:02.42,0:27:05.12,Main,Franky,0,0,0,,Ama çiçekleri ezmekten kaçınacağım!Dialogue: 0,0:27:05.12,0:27:08.93,Main,Franky,0,0,0,,Biraz iyi kalpli Franky Tank'ı!Dialogue: 0,0:27:08.93,0:27:12.70,Main,Crowd,0,0,0,,Süper!Dialogue: 0,0:27:15.64,0:27:19.15,Thoughts,Marine,0,0,0,,En tuhafının ne olduğunu söyleyemem!Dialogue: 0,0:27:19.15,0:27:24.63,Thoughts,Marine,0,0,0,,Dev bir rakun köpeği, kışlık bikini, dev çocuklar, bir robot ya da kopmuş bir kafa...Dialogue: 0,0:27:24.63,0:27:26.36,Thoughts,Marine,0,0,0,,Hayal mi görüyorum?Dialogue: 0,0:27:27.62,0:27:29.23,Main,Nami,0,0,0,,Seni daha önce görmüştüm!Dialogue: 0,0:27:29.23,0:27:31.62,Main,Chopper,0,0,0,,Evet! Sabaody'deki adam!Dialogue: 0,0:27:31.62,0:27:34.58,Main,Nami,0,0,0,,Bu çocukları hapseden sen miydin?Dialogue: 0,0:27:34.58,0:27:37.84,Main,Nami,0,0,0,,Seni pislik! Onları sana geri vermiyoruz!Dialogue: 0,0:27:39.50,0:27:40.25,Main,Sanji,0,0,0,,Ve sen!Dialogue: 0,0:27:40.25,0:27:44.13,Main,Sanji,0,0,0,,Karşılaşılacak onca iğrenç iblis arasında...  bu kişi Smoker!Dialogue: 0,0:27:44.13,0:27:46.93,Main,Sanji,0,0,0,,Ve yanında her zamanki gibi tatlış-swaaan var!Dialogue: 0,0:27:46.93,0:27:49.85,Main,Sanji,0,0,0,,Bu hiç iyi değil! Denizcilerle karşılaştık!Dialogue: 0,0:27:49.85,0:27:52.47,Main,Sanji,0,0,0,,Bu şekilde gidemeyiz! Başka bir çıkış bulmamız gerekecek!Dialogue: 0,0:27:52.47,0:27:53.73,Main,Sanji,0,0,0,,Çabuk içeri girin!Dialogue: 0,0:27:56.19,0:27:59.21,Main,Sanji,0,0,0,,Çabuk olun çocuklar! Diğer tarafa!Dialogue: 0,0:27:59.21,0:28:00.55,Main,Sanji,0,0,0,,Bir arka kapı olmalı!Dialogue: 0,0:28:00.55,0:28:03.27,Main,Nami,0,0,0,,Denizcilerin burada ne işi var?Dialogue: 0,0:28:03.27,0:28:05.26,Main,Franky,0,0,0,,Ne bileyim ben?! Neyse, koşun!Dialogue: 0,0:28:06.15,0:28:09.21,Main,Biyo,0,0,0,,Ha? Denizcilerin iyi olması gerekmiyor muydu?Dialogue: 0,0:28:09.21,0:28:10.43,Main,Sanji,0,0,0,,Sanırım. Onlarla gidebilirsiniz!Dialogue: 0,0:28:10.43,0:28:13.66,Main,Biyo,0,0,0,,Mümkün değil! Gangsterlere benziyorlar!Dialogue: 0,0:28:15.42,0:28:18.21,Main,Smoker,0,0,0,,Buradalar, değil mi? Yalnızmış, külahıma anlat!Dialogue: 0,0:28:18.21,0:28:22.08,Main,Law,0,0,0,,Gerçekten buradaydılar... beni şaşırttı.Dialogue: 0,0:28:23.00,0:28:26.00,Main,Tashigi,0,0,0,,Askerler! Hasır Şapkaları ele geçireceğiz!Dialogue: 0,0:28:26.96,0:28:30.04,Main,Marine,0,0,0,,Tamam, hadi gidelim! Kaptan-chan'ı takip edin!Dialogue: 0,0:28:31.09,0:28:32.17,Main,Smoker,0,0,0,,Bekleyin!Dialogue: 0,0:28:32.41,0:28:33.49,Attack,Smoker,0,0,0,,OdaDialogue: 0,0:28:41.13,0:28:42.57,Main,Marine,0,0,0,,Herkes iyi mi?!Dialogue: 0,0:28:47.17,0:28:50.75,Main,Law,0,0,0,,İşleri çok daha karmaşık hale getirdiler.Dialogue: 0,0:28:51.00,0:28:52.90,Attack,Law,0,0,0,,TaktDialogue: 0,0:29:06.34,0:29:09.73,Main,Marine,0,0,0,,Savaş gemisi uçuyor!Dialogue: 0,0:29:09.73,0:29:12.03,Main,Marine,0,0,0,,Nehir bile onunla birlikte yüzüyor!Dialogue: 0,0:29:12.03,0:29:14.80,Main,Marine,0,0,0,,Neler oluyor?!Dialogue: 0,0:29:15.25,0:29:19.10,Main,Law,0,0,0,,Artık bu adadan ayrılmanıza izin veremem.Dialogue: 0,0:29:19.75,0:29:22.71,Main,Law,0,0,0,,Burada kimsenin olmadığını söylediğim için özür dilerim.Dialogue: 0,0:29:23.72,0:29:26.14,Main,Marine,0,0,0,,Bu adam sıkıntılı!Dialogue: 0,0:29:26.14,0:29:28.01,Main,Smoker,0,0,0,,Geri çekilin.Dialogue: 0,0:29:29.61,0:29:33.75,Main,Smoker,0,0,0,,Ona parmağınızı bile süremezsiniz... parmağınızı koparır!Dialogue: 0,0:29:37.50,0:29:39.69,Main,Marine,0,0,0,,Yakalayın onu!Dialogue: 0,0:29:39.69,0:29:42.20,Main,Marine,0,0,0,,G-5'in gücünü gösterin!