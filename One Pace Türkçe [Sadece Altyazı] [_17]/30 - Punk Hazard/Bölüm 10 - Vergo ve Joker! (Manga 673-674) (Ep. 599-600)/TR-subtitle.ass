BT,19.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.5,0.5,9,10,10,10,1Style: Hands Up lyrics,Futura Md BT,35,&H00FF762C,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2.0,0,8,10,10,30,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.20,0:00:05.07,Hands Up lyrics,,0,0,0,,♪ Kaldır ellerini daha da yukarıya, hayallerini dök şarkılara. ♪Dialogue: 0,0:00:05.14,0:00:08.72,Hands Up lyrics,,0,0,0,,♪ Yıkılma hiçbir zaman, sarsılmaz bayrağını kaldır göklere. ♪Dialogue: 0,0:00:08.80,0:00:12.27,Hands Up lyrics,,0,0,0,,♪ Buralara kadar gelebilmek için pek çok duvarı yıkıp geçtik! ♪Dialogue: 0,0:00:12.34,0:00:17.68,Hands Up lyrics,,0,0,0,,♪ Hedef gelecek, haydi eller havaya!! ♪Dialogue: 0,0:00:23.31,0:00:30.66,Hands Up lyrics,,0,0,0,,♪ Uzansam biraz daha erişeceğim hemen cevaba. ♪Dialogue: 0,0:00:30.73,0:00:38.37,Hands Up lyrics,,0,0,0,,♪ İnanarak buna açılıyorum yeni dünyaya. ♪Dialogue: 0,0:00:38.40,0:00:45.86,Hands Up lyrics,,0,0,0,,♪ Aynen öyle, yapboz gibi birleşti hayal kırıntılarımız. ♪Dialogue: 0,0:00:45.91,0:00:50.41,Hands Up lyrics,,0,0,0,,♪ Aramızda hiç kopmayacak bağlar yaratarak,...Dialogue: 0,0:00:51.18,0:00:53.51,Hands Up lyrics,,0,0,0,,...daha aydınlık bir geleceğe. ♪Dialogue: 0,0:00:54.00,0:00:58.55,Hands Up lyrics,,0,0,0,,♪ Kaldır ellerini daha da yukarıya, hayallerini dök şarkılara. ♪Dialogue: 0,0:00:58.62,0:01:02.42,Hands Up lyrics,,0,0,0,,♪ Yıkılma hiçbir zaman, sarsılmaz bayrağını kaldır göklere. ♪Dialogue: 0,0:01:02.43,0:01:05.78,Hands Up lyrics,,0,0,0,,♪ Buralara kadar gelebilmek için pek çok duvarı yıkıp geçtik! ♪Dialogue: 0,0:01:05.83,0:01:09.80,Hands Up lyrics,,0,0,0,,♪ Hedefimiz gelecek! ♪Dialogue: 0,0:01:09.87,0:01:11.30,Hands Up lyrics,,0,0,0,,♪ Daha da yukarıya bak! ♪Dialogue: 0,0:01:11.34,0:01:13.48,Hands Up lyrics,,0,0,0,,♪ Sırtın hep dik olsun! ♪Dialogue: 0,0:01:13.53,0:01:14.94,Hands Up lyrics,,0,0,0,,♪ Bir an olsun durma! ♪Dialogue: 0,0:01:14.99,0:01:16.82,Hands Up lyrics,,0,0,0,,♪ Dalgaları aşa aşa! ♪Dialogue: 0,0:01:16.86,0:01:20.41,Hands Up lyrics,,0,0,0,,♪ Arzularımız birleşiyor yavaşça. ♪Dialogue: 0,0:01:20.44,0:01:24.65,Hands Up lyrics,,0,0,0,,♪ Haydi ilerisini hedef seçelim kendimize! ♪Dialogue: 0,0:01:24.91,0:01:31.06,Hands Up lyrics,,0,0,0,,♪ Dalgaları sürerek, akıyoruz ileriye. ♪Dialogue: 0,0:01:31.09,0:01:35.34,Hands Up lyrics,,0,0,0,,♪ İnsanlarla tanışıyor, elvedalar ediyoruz,...Dialogue: 0,0:01:35.36,0:01:39.09,Hands Up lyrics,,0,0,0,,...bir kez daha bu bayrağın altında. ♪Dialogue: 0,0:01:41.26,0:01:45.04,Hands Up lyrics,,0,0,0,,♪ Unutmak istemediğim acıları...Dialogue: 0,0:01:45.06,0:01:48.08,Hands Up lyrics,,0,0,0,,...o gün yüreğime gömdüm, saklıyorum orada. ♪Dialogue: 0,0:01:48.27,0:01:52.34,Hands Up lyrics,,0,0,0,,♪ Kimselere yenilmeyecek bir özgürlük bizimkisi,...Dialogue: 0,0:01:52.46,0:01:54.75,Hands Up lyrics,,0,0,0,,...sıkıca kavrayıp yoluma atıldığım. ♪Dialogue: 0,0:01:54.77,0:01:59.69,Hands Up lyrics,,0,0,0,,♪ Kaldır ellerini daha da yukarıya, hayallerini dök şarkılara. ♪Dialogue: 0,0:01:59.72,0:02:03.37,Hands Up lyrics,,0,0,0,,♪ Yıkılma hiçbir zaman, sarsılmaz bayrağını kaldır göklere. ♪Dialogue: 0,0:02:03.41,0:02:06.66,Hands Up lyrics,,0,0,0,,♪ Buralara kadar gelebilmek için pek çok duvarı yıkıp geçtik! ♪Dialogue: 0,0:02:06.69,0:02:10.83,Hands Up lyrics,,0,0,0,,♪ Hedefimiz gelecek! ♪Dialogue: 0,0:02:10.88,0:02:12.20,Hands Up lyrics,,0,0,0,,♪ Daha da yukarıya bak! ♪Dialogue: 0,0:02:12.25,0:02:14.53,Hands Up lyrics,,0,0,0,,♪ Sırtın hep dik olsun! ♪Dialogue: 0,0:02:14.53,0:02:15.90,Hands Up lyrics,,0,0,0,,♪ Bir an olsun durma! ♪Dialogue: 0,0:02:15.95,0:02:17.72,Hands Up lyrics,,0,0,0,,♪ Dalgaları aşa aşa! ♪Dialogue: 0,0:02:17.76,0:02:21.43,Hands Up lyrics,,0,0,0,,♪ Arzularımız birleşiyor yavaşça. ♪Dialogue: 0,0:02:21.50,0:02:24.97,Hands Up lyrics,,0,0,0,,♪ Haydi ilerisini hedef seçelim kendimize! ♪Dialogue: 0,0:02:24.99,0:02:29.89,Hands Up lyrics,,0,0,0,,♪ Eller havaya!! ♪Dialogue: 0,0:02:30.02,0:02:38.76,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:15:57.95,0:16:07.95,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:27:20.60,0:27:23.50,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:02:30.02,0:02:38.76,Title,,0,0,0,,Vergo ve Joker! Caesar'ın Ana Planının Başlangıcı!Dialogue: 0,0:02:40.88,0:02:44.09,Captions,,0,0,0,,Yeni Dünya'da Belirli Bir AdaDialogue: 0,0:02:42.86,0:02:44.09,Main,Cind's father,0,0,0,,Denizciler!Dialogue: 0,0:02:44.09,0:02:47.24,Main,Cind's father,0,0,0,,Lütfen isteğime kulak verin... Lütfen çocuklarımızı bulun!Dialogue: 0,0:02:47.24,0:02:52.14,Main,Cind,0,0,0,,Üç yıl önce çocuklarımızın kaybolduğu bir olay gerçekleşmişti!Dialogue: 0,0:02:53.54,0:02:55.40,Main,Doran's father,0,0,0,,Lütfen bir kez daha arayın!Dialogue: 0,0:02:55.40,0:03:01.01,Main,Mocha's mother,0,0,0,,Civarda oynarken bir tür gemi kazasına karıştıklarını söylemişlerdi o zaman!Dialogue: 0,0:03:01.01,0:03:02.95,Main,Uzu's mother,0,0,0,,Ama inanılması çok güç bir şey bu!Dialogue: 0,0:03:02.95,0:03:06.25,Main,Uzu's mother,0,0,0,,Lütfen! Bir kez daha arayın!Dialogue: 0,0:03:06.25,0:03:07.47,Main,Uzu's mother,0,0,0,,Soruşturmayı yeniden başlatın!Dialogue: 0,0:03:08.27,0:03:12.25,Main,Cind's father,0,0,0,,En azından lütfen hikayemizi Albay Tashigi'ye anlatın!Dialogue: 0,0:03:12.25,0:03:16.79,Main,Cind's father,0,0,0,,Hikayemizi dinleyebilecek nazik bir insan olduğunu duyduk!Dialogue: 0,0:03:25.37,0:03:26.62,Main,Yarisugi,0,0,0,,Yeter bu kadar saçmaladığınız!Dialogue: 0,0:03:27.34,0:03:29.00,Main,Yarisugi,0,0,0,,Bize hakaret etmeye mi çalışıyorsun?Dialogue: 0,0:03:29.00,0:03:32.68,Main,Yarisugi,0,0,0,,Bizim de G-5 denizcileri olduğumuzu bilmenizi isterim!Dialogue: 0,0:03:32.68,0:03:36.18,Main,Yarisugi,0,0,0,,Her şeyden önce Donanma'nın raporlarından şüphe duyuyor...Dialogue: 0,0:03:36.18,0:03:40.64,Main,Yarisugi,0,0,0,,...üstelik bölgeden sorumlu bizlerden şikayet ediyorsunuz öyle mi?!Dialogue: 0,0:03:40.64,0:03:42.96,Main,Yarisugi,0,0,0,,Sizce de biraz abartmıyor musunuz!?Dialogue: 0,0:03:42.96,0:03:44.31,Main,Cind's father,0,0,0,,Öy-Öyle bir niyetimiz yoktu!Dialogue: 0,0:03:44.31,0:03:46.55,Main,Yarisugi,0,0,0,,Bu anlamsız. Fazlasıyla anlamsız!Dialogue: 0,0:03:46.55,0:03:49.69,Main,Yarisugi,0,0,0,,Kabul edin artık! Çok fazla delil var!Dialogue: 0,0:03:49.69,0:03:52.49,Main,Yarisugi,0,0,0,,Çocuklarınız denizde öldü!Dialogue: 0,0:03:57.32,0:03:59.37,Main,Marine,0,0,0,,Tuğamiral, biraz fazla abartıyorsunuz!Dialogue: 0,0:04:00.05,0:04:05.11,Captions,,0,0,130,,Donanma G-5 Filosu 06 Tuğamiral YarisugiDialogue: 0,0:04:01.33,0:04:07.50,Main,Marine,0,0,0,,Bunu G-5'in başındaki Koramiral Vergo ile pek çok kez teyit ettik.Dialogue: 0,0:04:07.50,0:04:10.17,Main,Marine,0,0,0,,On bin kere araştırdık!Dialogue: 0,0:04:10.17,0:04:10.84,Main,Byo's father,0,0,0,,Ancak...Dialogue: 0,0:04:11.89,0:04:13.76,Main,Yarisugi,0,0,0,,Bu saçmalığa devam edecek olursanız...Dialogue: 0,0:04:13.76,0:04:19.66,Main,Yarisugi,0,0,0,,...işimize engel olduğunuz gerekçesiyle sizi gebertir, köyünüzü de yerlebir ederim!Dialogue: 0,0:04:21.21,0:04:23.42,Main,Marine,0,0,0,,Tuğamiral, biraz fazla abartıyorsunuz!Dialogue: 0,0:04:25.18,0:04:27.85,Main,Yarisugi,0,0,0,,Tashigi-chan'la görüşmek istiyorsunuz, öyle mi!?Dialogue: 0,0:04:27.85,0:04:29.93,Main,Yarisugi,0,0,0,,Şansınızı fazla zorlamayın!Dialogue: 0,0:04:29.93,0:04:32.62,Main,Yarisugi,0,0,0,,Yine de bazen keşke benim emrim altında olsaydı diyorum.Dialogue: 0,0:04:32.62,0:04:34.66,Main,Yarisugi,0,0,0,,Bu fazlasıyla muhteşem olurdu!Dialogue: 0,0:04:36.75,0:04:38.25,Main,Marines,0,0,0,,Fazla hayal kuruyorsunuz!Dialogue: 0,0:04:38.66,0:04:42.15,Main,Yarisugi,0,0,0,,Ancak ne yazık ki 01 filosunda...Dialogue: 0,0:04:42.15,0:04:44.75,Main,Yarisugi,0,0,0,,...Koramiral Smoker'ın sağ kolu olarak görev yapmakta!Dialogue: 0,0:04:44.75,0:04:46.78,Main,Yarisugi,0,0,0,,Büyük bir istekle hem de!Dialogue: 0,0:04:52.82,0:04:58.12,Main,Yarisugi,0,0,0,,Üç yıl önce yaşanan bir olayla ilgili soruşturmaları yeniden açacak vaktimiz yok.Dialogue: 0,0:04:58.12,0:04:59.75,Main,Yarisugi,0,0,0,,Boş zamanımız çok kısıtlı!Dialogue: 0,0:04:59.75,0:05:01.36,Main,Marines,0,0,0,,Çok sınırlı!Dialogue: 0,0:05:01.36,0:05:02.56,Main,Yarisugi,0,0,0,,Bok herifler!Dialogue: 0,0:05:03.18,0:05:05.00,Main,Soldiers,0,0,0,,Çok fazla şey söyledin!Dialogue: 0,0:05:05.78,0:05:10.45,Main,Soldiers,0,0,0,,Gerçekten başlarındaki Koramiral Vergo ile konuştuklarını mı düşünüyorsun?Dialogue: 0,0:05:10.45,0:05:15.48,Main,Soldiers,0,0,0,,Bir keresinde gerçekten de bu adayı korsanlardan kurtarmıştı.Dialogue: 0,0:05:15.48,0:05:20.46,Main,Soldiers,0,0,0,,Mükemmel bir beyefendiydi. Onun G-5 gibi bir grup kabadayının üyesi olduğunu hayal etmek zor.Dialogue: 0,0:05:20.46,0:05:23.76,Main,Soldiers,0,0,0,,Gerçekten bunun sadece bir gemi kazası olduğunu mu söyledi?Dialogue: 0,0:05:25.34,0:05:26.75,Main,Mother,0,0,0,,Onlar yaşıyor!Dialogue: 0,0:05:32.99,0:05:36.52,Main,Mother,0,0,0,,Hayatta olmaları gerekiyor!Dialogue: 0,0:05:38.33,0:05:40.99,Main,Mother,0,0,0,,Oralarda bir yerlerde olmalılar!Dialogue: 0,0:05:38.98,0:05:42.04,Captions,,0,0,0,,Punk HazardDialogue: 0,0:05:42.44,0:05:45.66,Captions,,0,0,0,,Laboratuvar Bir ve İki'nin HarabeleriDialogue: 0,0:05:42.44,0:05:45.66,Captions,,0,0,0,,Nami ve Usopp'un GrubuDialogue: 0,0:05:50.03,0:05:51.58,Main,Byo,0,0,0,,Başım çatlayacak!Dialogue: 0,0:05:51.58,0:05:53.87,Main,Nami,0,0,0,,Usopp uyut hemen şunları!Dialogue: 0,0:05:53.87,0:05:57.20,Main,Usopp,0,0,0,,Deniyorum! Ancak her seferinde daha az etkili oluyor!Dialogue: 0,0:05:58.05,0:06:01.33,Main,Kid,0,0,0,,Bu zincirleri çıkarın!Dialogue: 0,0:06:02.47,0:06:06.87,Main,Usopp,0,0,0,,Yoksunluk belirtileri bu sefer çok güçlü olmalı!Dialogue: 0,0:06:06.87,0:06:08.07,Main,Nami,0,0,0,,Ne yapacağız peki o zaman?!Dialogue: 0,0:06:12.84,0:06:15.41,Main,Usopp,0,0,0,,Onları tutmanın bir yolunu bulmalıyız.Dialogue: 0,0:06:15.41,0:06:16.42,Main,Usopp,0,0,0,,Sana güveniyorum, Sanji!Dialogue: 0,0:06:16.86,0:06:17.89,Main,Nami,0,0,0,,Nami'yim ben be!Dialogue: 0,0:06:17.89,0:06:19.14,Main,Usopp,0,0,0,,Oh, unuttum.Dialogue: 0,0:06:19.14,0:06:22.32,Main,Usopp,0,0,0,,Lanet olsun. Dışarıdan çok güçlü görünüyorsun.Dialogue: 0,0:06:22.32,0:06:23.28,Main,Nami,0,0,0,,Kusuruma bakma!Dialogue: 0,0:06:24.46,0:06:26.27,Main,Kid,0,0,0,,Abilerim!Dialogue: 0,0:06:26.27,0:06:28.34,Main,Kid,0,0,0,,Şeker! Şeker verin bize!Dialogue: 0,0:06:28.73,0:06:30.94,Main,Kid,0,0,0,,Şeker! Şeker!Dialogue: 0,0:06:30.94,0:06:32.92,Main,Kid,0,0,0,,Kafam ağrıyor!Dialogue: 0,0:06:35.91,0:06:37.07,Main,Kid,0,0,0,,Ağrı!Dialogue: 0,0:06:37.07,0:06:39.98,Main,Mocha,0,0,0,,Bize biraz şeker verin... bu her şeyi daha iyi hale getirecek.Dialogue: 0,0:06:40.45,0:06:42.11,Main,Kids,0,0,0,,Şeker.Dialogue: 0,0:06:43.83,0:06:44.76,Main,Kid,0,0,0,,Şeker.Dialogue: 0,0:06:44.76,0:06:45.74,Main,Kid,0,0,0,,Şeker.Dialogue: 0,0:06:45.74,0:06:47.08,Main,Kid,0,0,0,,Şeker.Dialogue: 0,0:06:47.74,0:06:49.42,Main,Kid,0,0,0,,Şeker verin bize!Dialogue: 0,0:06:49.42,0:06:50.97,Main,Usopp,0,0,0,,Geliyorlar!Dialogue: 0,0:06:50.97,0:06:53.62,Main,Usopp,0,0,0,,Sa-Saldırabilir miyim artık?!Dialogue: 0,0:06:53.62,0:06:55.12,Main,Usopp,0,0,0,,Canavara döndüler!Dialogue: 0,0:06:55.12,0:06:55.97,Main,Nami,0,0,0,,Olmaz!Dialogue: 0,0:06:56.51,0:06:57.96,Main,Nami,0,0,0,,Saçmalamasana ya, çocuk onlar!Dialogue: 0,0:07:01.30,0:07:04.48,Main,Usopp,0,0,0,,Tamam da sonsuza dek böyle kaçamayız ki!Dialogue: 0,0:07:23.58,0:07:25.14,Main,Kids,0,0,0,,Master!Dialogue: 0,0:07:27.55,0:07:30.11,Main,Caesar,0,0,0,,İyi misiniz evlatlarım?Dialogue: 0,0:07:30.11,0:07:33.29,Main,Caesar,0,0,0,,Haydi laboratuvarımıza geri dönelim!Dialogue: 0,0:07:33.29,0:07:35.48,Main,Caesar,0,0,0,,Burası çok tehlikeli.Dialogue: 0,0:07:35.48,0:07:42.62,Main,Kids,0,0,0,,Master!Dialogue: 0,0:07:37.33,0:07:39.20,Secondary,Nami,0,0,0,,Master?!Dialogue: 0,0:07:42.92,0:07:46.92,Captions,,0,0,0,,Merkez GölDialogue: 0,0:07:46.92,0:07:48.75,Main,Brook,0,0,0,,Slime sinirleniyor!Dialogue: 0,0:07:48.75,0:07:50.49,Main,Sanji,0,0,0,,Neden şimdi birdenbire?Dialogue: 0,0:07:50.49,0:07:55.74,Main,Zoro,0,0,0,,Mini slime'ları patlattığımız için olabilir mi?Dialogue: 0,0:07:55.74,0:07:59.03,Main,Kinemon,0,0,0,,Belki onlar da onun çocukları gibidirler? Ama başka seçeneğimiz yoktu.Dialogue: 0,0:08:06.96,0:08:09.40,Main,Sanji,0,0,0,,Hah, şekil değiştiriyor!Dialogue: 0,0:08:14.73,0:08:16.98,Main,Kinemon,0,0,0,,Neye dönüşüyor olabilir?Dialogue: 0,0:08:27.51,0:08:29.67,Main,Sanji,0,0,0,,Ne bu, kurbağa mı?Dialogue: 0,0:08:29.67,0:08:31.07,Main,Zoro,0,0,0,,Kertenkeleye benziyor.Dialogue: 0,0:08:43.34,0:08:44.15,Main,Sanji,0,0,0,,Koşun!Dialogue: 0,0:08:56.81,0:08:59.78,Main,Kinemon,0,0,0,,Kendini istediği kadar kopyalayabiliyor mu acaba?!Dialogue: 0,0:08:59.78,0:09:04.15,Main,Brook,0,0,0,,Hayır, öteki taraftaki de küçülüyor gibi görünüyor.Dialogue: 0,0:09:04.15,0:09:08.23,Main,Sanji,0,0,0,,Yani nihayetinde öteki taraftaki yok olacak öyle mi?!Dialogue: 0,0:09:08.81,0:09:12.45,Main,Sanji,0,0,0,,Yoksa gölü geçmek için kendini parça parça bu tarafa mı fırlatıyor?!Dialogue: 0,0:09:17.59,0:09:21.16,Main,Sanji,0,0,0,,Öyle bir canavarın bu tarafta cirit atmasını istemeyiz!Dialogue: 0,0:09:21.16,0:09:24.85,Main,Zoro,0,0,0,,Aynen öyle! Kesince gaz salıyor, yakınca patlıyor.Dialogue: 0,0:09:24.85,0:09:26.32,Main,Zoro,0,0,0,,Hem öncekilerden çok daha büyük bu!Dialogue: 0,0:09:29.04,0:09:31.00,Main,Zoro,0,0,0,,Laboratuvar da tehlikede olabilir.Dialogue: 0,0:09:31.00,0:09:33.24,Main,Kinemon,0,0,0,,Ne? Öyleyse acele edelim!Dialogue: 0,0:09:33.24,0:09:34.98,Main,Kinemon,0,0,0,,Momonosuke!Dialogue: 0,0:09:34.98,0:09:38.49,Main,Zoro,0,0,0,,Siz ne yapacaksınız? Ben laboratuvara gidiyorum!Dialogue: 0,0:09:38.49,0:09:41.58,Main,Sanji,0,0,0,,Biz de geleceğiz o zaman herhâlde, aptal herif!Dialogue: 0,0:09:41.58,0:09:43.23,Main,Zoro,0,0,0,,Kimmiş aptal be?!Dialogue: 0,0:09:43.23,0:09:44.81,Main,Sanji,0,0,0,,Fazla güvenilmezsin!Dialogue: 0,0:09:44.81,0:09:48.01,Main,Sanji,0,0,0,,Kin'emon'dan ayrı düşer ve kafana göre dolanmaya başlarsan...Dialogue: 0,0:09:48.01,0:09:50.58,Main,Sanji,0,0,0,,...bir de seni arama derdi çıkar başımıza!Dialogue: 0,0:09:50.58,0:09:53.52,Main,Brook,0,0,0,,Böyle bir zamanda Zoro-san, Sanji-san yapmayın yahu!Dialogue: 0,0:09:57.65,0:10:00.45,Main,Brook,0,0,0,,Ayrıca ben de onun kılıç kullanışına şahit olmak istiyorum!Dialogue: 0,0:10:00.45,0:10:03.29,Main,Brook,0,0,0,,Laboratuvara gidelim!Dialogue: 0,0:10:05.53,0:10:08.49,Main,Marine,0,0,0,,Smo-ya'yı bize geri ver, Caesar!Dialogue: 0,0:10:06.48,0:10:11.21,Captions,,0,0,0,,Caesar'ın Laboratuvarı ÖnüDialogue: 0,0:10:08.49,0:10:11.21,Main,Marine,0,0,0,,Tashigi-chan'ı geri ver!Dialogue: 0,0:10:15.52,0:10:18.20,Main,Marine,0,0,0,,Bu kepenkler de neyin nesi, acayip sağlamlar!Dialogue: 0,0:10:18.23,0:10:20.14,Main,Marine,0,0,0,,Bazuka bile işe yaramıyor mu?!Dialogue: 0,0:10:20.14,0:10:21.98,Main,Marine,0,0,0,,Belki bir arka kapı vardır.Dialogue: 0,0:10:21.98,0:10:25.07,Main,Marine2,0,0,0,,Bu iyi değil. Bu kepenkleri her tarafa indirdiler.Dialogue: 0,0:10:25.07,0:10:28.06,Main,Marine2,0,0,0,,Kahrolası gaz!Dialogue: 0,0:10:28.06,0:10:32.95,Main,Marine,0,0,0,,Tuzağa falan düşürülmüş olmayalım biz?!Dialogue: 0,0:10:33.36,0:10:35.32,Main,Marine2,0,0,0,,Saçmalamasana!Dialogue: 0,0:10:35.32,0:10:40.25,Main,Marine,0,0,0,,Tamam da her ne kadar gökten düşmeyi bıraksalar da...Dialogue: 0,0:10:40.97,0:10:44.63,Main,Marine,0,0,0,,...şu jöleler birleşip yavaş yavaş büyümeye başladılar!Dialogue: 0,0:10:49.92,0:10:52.98,Main,Marine2,0,0,0,,Başka gemi de çalamayız! Tüm yollar kesildi!Dialogue: 0,0:10:53.34,0:10:56.05,Main,Marine,0,0,0,,Den Den Mushilerimizi de aldılar, kimseleri de arayamıyoruz.Dialogue: 0,0:10:56.05,0:10:58.43,Main,Marine2,0,0,0,,Ne yapmalıyız?!Dialogue: 0,0:11:02.70,0:11:04.87,Main,Vergo,0,0,0,,Caesar neyin peşinde?Dialogue: 0,0:11:04.87,0:11:08.37,Main,Monet,0,0,0,,Kim bilir? Bana her şeyi anlatmıyor.Dialogue: 0,0:11:08.37,0:11:15.23,Main,Monet,0,0,0,,Ancak evcil hayvanı Smiley'i uyandırdığına göre aklında bir deney olabilir.Dialogue: 0,0:11:15.75,0:11:17.57,Main,Monet,0,0,0,,O değil de Vergo...Dialogue: 0,0:11:17.57,0:11:20.87,Main,Monet,0,0,0,,...kahvaltıda hamburger mi yedin?Dialogue: 0,0:11:21.38,0:11:23.78,Main,Vergo,0,0,0,,Nasıl bildin? Favori yiyeceğimdir.Dialogue: 0,0:11:23.78,0:11:26.79,Main,Monet,0,0,0,,Ağzının yanında bir parça kalmış.Dialogue: 0,0:11:26.79,0:11:31.40,Main,Vergo,0,0,0,,Bu deneyi görmeyi gerçekten çok isterim.Dialogue: 0,0:11:31.40,0:11:33.60,Main,Vergo,0,0,0,,Dışarıdaki herkes ölecek mi?Dialogue: 0,0:11:33.81,0:11:37.33,Main,Monet,0,0,0,,Muhtemelen ama laboratuvarın içinde güvende olacaksın!Dialogue: 0,0:11:37.33,0:11:38.61,Main,Smoker,0,0,0,,Bak bana Vergo!Dialogue: 0,0:11:38.61,0:11:43.98,Main,Smoker,0,0,0,,Dışarıdaki herkes G-5 askeri, altında çalışan adamların!Dialogue: 0,0:11:43.98,0:11:45.48,Main,Smoker,0,0,0,,Öylece ölmelerine izin mi vereceksin?!Dialogue: 0,0:11:46.05,0:11:47.97,Main,Vergo,0,0,0,,Evet, vereceğim.Dialogue: 0,0:11:48.86,0:11:50.14,Main,Tashigi,0,0,0,,Ne?!Dialogue: 0,0:11:51.31,0:11:56.69,Main,Vergo,0,0,0,,O değil de tek bir kafeste kapalı bunca büyük ismi bir arada görmek tuhaf geldi.Dialogue: 0,0:11:56.69,0:11:57.99,Main,Vergo,0,0,0,,Manzara hoşuma gitti.Dialogue: 0,0:11:57.99,0:12:02.70,Main,Robin,0,0,0,,Sizi böyle aynı kafeste görünce anıları canlanıyor insanın!Dialogue: 0,0:12:02.70,0:12:08.54,Main,Luffy,0,0,0,,Sahi sahi! Duman adamla birlikte Arabasta'da size yakalanmıştık değil mi?!Dialogue: 0,0:12:08.54,0:12:10.21,Main,Smoker,0,0,0,,Kapayın çenenizi be!Dialogue: 0,0:12:10.93,0:12:14.63,Main,Smoker,0,0,0,,Nasıl bir durumda olduğunuzu hiç idrak edemiyorsunuz!Dialogue: 0,0:12:14.63,0:12:19.76,Main,Tashigi,0,0,0,,Smoker-san, şu anda hislerimi nasıl yansıtmalıyım bilemiyorum!Dialogue: 0,0:12:20.21,0:12:24.04,Main,Smoker,0,0,0,,Aynen dediğin gibi çıktı ve olabilecek en kötü durumun içerisindeyiz.Dialogue: 0,0:12:24.63,0:12:32.90,Flashbacks,Smoker,0,0,0,,Gazetelerde yayınlanan o yazılar yalandı, yani G-5'ten birileri bu çocuk kaçırma vakalarını örtbas ediyordu.Dialogue: 0,0:12:33.90,0:12:41.94,Main,Smoker,0,0,0,,Özetle Ceasar çocukları kaçırırken Vergo da durumu gemi kazası deyip kurtarıyordu.Dialogue: 0,0:12:42.92,0:12:47.06,Main,Smoker,0,0,0,,Bir başka ifadeyle yolsuzluk G-5'in en tepesinden geliyor.Dialogue: 0,0:12:47.77,0:12:52.15,Main,Smoker,0,0,0,,Her ne kadar G-5'den beklenecek bir şey olsa da donanmaya karşı yapılan bir onursuzluktur bu!Dialogue: 0,0:12:54.22,0:12:55.84,Main,Tashigi,0,0,0,,Ne cüretle böyle bir şey yaparsın?!Dialogue: 0,0:12:56.47,0:12:59.93,Main,Luffy,0,0,0,,Ne? Kötü biri mi o?Dialogue: 0,0:12:59.93,0:13:01.64,Main,Robin,0,0,0,,Öyle görünüyor.Dialogue: 0,0:13:01.64,0:13:05.12,Main,Law,0,0,0,,Fark etmemiş olmanıza şaşırmamalı.Dialogue: 0,0:13:05.86,0:13:09.66,Main,Law,0,0,0,,Sonuçta Vergo için denizcileri satıyor diyemeyiz.Dialogue: 0,0:13:11.46,0:13:14.99,Main,Law,0,0,0,,Adam özünde korsandı.Dialogue: 0,0:13:14.99,0:13:17.40,Main,Tashigi,0,0,0,,Korsan mıydı?!Dialogue: 0,0:13:17.90,0:13:23.17,Main,Law,0,0,0,,Aynen öyle! Sükse yapmadan önce Joker'ın emriyle Donanma'ya katıldı...Dialogue: 0,0:13:23.17,0:13:27.53,Main,Law,0,0,0,,...ve on beş yılını ta en dipten başlayarak zirveye tırmanmaya adadı.Dialogue: 0,0:13:28.01,0:13:32.68,Main,Law,0,0,0,,Joker için denizcilerde bu kişiden daha güvenilir biri yoktur.Dialogue: 0,0:13:32.68,0:13:37.51,Main,Law,0,0,0,,Vergo ta en başından beri Joker için çalışıyordu.Dialogue: 0,0:13:37.51,0:13:38.93,Main,Tashigi,0,0,0,,Nasıl olabilir...Dialogue: 0,0:13:38.93,0:13:44.42,Main,Smoker,0,0,0,,Yanılmıyorsam Joker yeraltı dünyasından bir simsardı.Dialogue: 0,0:13:44.42,0:13:49.15,Main,Smoker,0,0,0,,Kendime acıyorum resmen! Burnumun dibinde gerçekleşen bu olayı nasıl fark edemedim!Dialogue: 0,0:13:50.01,0:13:52.96,Main,Vergo,0,0,0,,Kendine bu kadar yüklenme.Dialogue: 0,0:13:52.96,0:13:59.99,Main,Vergo,0,0,0,,Kudretli "Beyaz Avcı"yı kandırmayı başaran bu kişiyi neden kutlamıyorsun, Smoker-kun.Dialogue: 0,0:13:59.99,0:14:06.05,Main,Vergo,0,0,0,,Karargâhtan geldiğin günden beri çok titiz davranıyordum.Dialogue: 0,0:14:06.60,0:14:10.59,Main,Vergo,0,0,0,,Öylesi bir baskıdan kurtulduğum için mutluyum.Dialogue: 0,0:14:11.63,0:14:18.63,Main,Vergo,0,0,0,,Ayrıca gerçekleri açığa çıksa bile bununla başa çıkacak bir planım var.Dialogue: 0,0:14:19.43,0:14:24.82,Main,Vergo,0,0,0,,Neden bahsettiğimi biliyorsundur sanırım?Dialogue: 0,0:14:27.89,0:14:30.73,Main,Vergo,0,0,0,,Koramiral Smoker ve Albay Tashigi.Dialogue: 0,0:14:33.81,0:14:39.89,Main,Vergo,0,0,0,,Burada öleceksiniz ki o ağızlarınız sonsuza dek kapalı kalabilsin.Dialogue: 0,0:14:40.53,0:14:43.86,Main,Vergo,0,0,0,,Dışarıdaki askerlerle de Ceasar ilgilenecek.Dialogue: 0,0:14:44.44,0:14:49.25,Main,Vergo,0,0,0,,Elden bir şey gelmez. Joker'in çok değer verdiği bir bölge burası.Dialogue: 0,0:14:49.25,0:14:53.63,Main,Vergo,0,0,0,,Kimliğini öğrenen kişilerin öylece çekip gitmesine izin veremem.Dialogue: 0,0:14:54.42,0:14:59.43,Main,Vergo,0,0,0,,Endişelenmeyin! Olaya her zamanki gibi kaza süsü vereceğim.Dialogue: 0,0:14:59.43,0:15:01.18,Main,Smoker,0,0,0,,Vergo!Dialogue: 0,0:15:02.50,0:15:05.17,Main,Luffy,0,0,0,,Baksana Tra-o, şu Joker de kim?Dialogue: 0,0:15:09.62,0:15:13.84,Main,Law,0,0,0,,Bir zamanlar ben de onun tayfasındaydım.Dialogue: 0,0:15:14.46,0:15:17.05,Main,Law,0,0,0,,O yüzden Vergo'yu tanıyorum.Dialogue: 0,0:15:17.65,0:15:22.34,Main,Law,0,0,0,,Joker yeraltı simsarlığında kullandığı takma bir ad.Dialogue: 0,0:15:22.77,0:15:27.53,Main,Law,0,0,0,,Sizin de çok yakından tanıdığınız biri.Dialogue: 0,0:15:27.53,0:15:28.96,Main,Robin,0,0,0,,Nasıl yani?Dialogue: 0,0:15:28.96,0:15:32.21,Main,Law,0,0,0,,Dünyanın en azılı yedi korsanından biri.Dialogue: 0,0:15:33.59,0:15:37.64,Main,Law,0,0,0,,Dünya Hükümeti tarafından seçilmiş Shichibukai'den biri.Dialogue: 0,0:15:46.54,0:15:49.72,Main,Law,0,0,0,,Donquixote Doflamingo.Dialogue: 0,0:16:03.89,0:16:05.15,Main,Child,0,0,0,,Master!Dialogue: 0,0:16:05.15,0:16:06.00,Main,Nami,0,0,0,,Yani...Dialogue: 0,0:16:06.67,0:16:09.36,Main,Nami,0,0,0,,...şimdi bu çocukları kaçıran kişi sensin öyle mi?!Dialogue: 0,0:16:10.53,0:16:14.96,Main,Usopp,0,0,0,,Neden burada? Luffy'lerle karşılaşamadılar mı acaba?Dialogue: 0,0:16:14.96,0:16:19.48,Main,Caesar,0,0,0,,Böyle korkunç bir şeyi nasıl yapabildiniz?Dialogue: 0,0:16:19.48,0:16:20.70,Main,Nami,0,0,0,,Korkunç mu dedin?Dialogue: 0,0:16:20.70,0:16:22.73,Main,Caesar,0,0,0,,Neden kaçırdınız onları?Dialogue: 0,0:16:22.73,0:16:25.32,Main,Caesar,0,0,0,,Çocukların acı çektiğini görmüyor musun?Dialogue: 0,0:16:25.32,0:16:26.20,Main,Nami,0,0,0,,Ne dedin sen?!Dialogue: 0,0:16:26.20,0:16:29.60,Main,Usopp,0,0,0,,Dur be salak! Sakin ol, Nami!Dialogue: 0,0:16:29.60,0:16:31.58,Main,Nami,0,0,0,,Bu çocuklara acı çektiren kim peki?!Dialogue: 0,0:16:31.58,0:16:37.79,Main,Usopp,0,0,0,,Dur! Law, elemanın Logia tipi ve 300 milyon beli ödüllü biri olduğunu söylemişti.Dialogue: 0,0:16:38.26,0:16:42.31,Main,Nami,0,0,0,,Bu küçücük çocuklara ne verdin?!Dialogue: 0,0:16:42.31,0:16:47.49,Main,Nami,0,0,0,,Hepsi de evlerine gitmek istiyorlardı! Eminim aileleri de onları arıyordur.Dialogue: 0,0:16:47.49,0:16:51.26,Main,Nami,0,0,0,,Ne pahasına olursa olsun onları buradan götüreceğiz!Dialogue: 0,0:16:55.65,0:16:58.07,Main,Caesar,0,0,0,,Hani neredeymiş o eve gitmek isteyen çocuklar?Dialogue: 0,0:16:58.07,0:17:00.10,Main,Child,0,0,0,,Master!Dialogue: 0,0:17:00.10,0:17:00.75,Main,Nami,0,0,0,,Durun!Dialogue: 0,0:17:00.75,0:17:01.78,Main,Child,0,0,0,,Master!Dialogue: 0,0:17:01.78,0:17:02.82,Main,Usopp,0,0,0,,Durun yahu!Dialogue: 0,0:17:02.82,0:17:07.02,Main,Usopp,0,0,0,,Gitmeyin! Gene laboratuvara mı kapatılmak istiyorsunuz!?Dialogue: 0,0:17:10.67,0:17:12.93,Main,Child,0,0,0,,Çekil önümden!Dialogue: 0,0:17:14.28,0:17:14.91,Main,Nami,0,0,0,,Usopp!Dialogue: 0,0:17:18.01,0:17:22.39,Main,Caesar,0,0,0,,Böyle işte! Bana geri dönün çocuklarım.Dialogue: 0,0:17:22.39,0:17:24.58,Main,Nami,0,0,0,,Bekleyin dedim!Dialogue: 0,0:17:24.58,0:17:26.99,Main,Nami,0,0,0,,Onun yanına gitmeyin!Dialogue: 0,0:17:26.99,0:17:28.65,Main,Nami,0,0,0,,Eve gitmek istemiyor musunuz?!Dialogue: 0,0:17:30.56,0:17:32.04,Main,Biyo,0,0,0,,Dokunma!Dialogue: 0,0:17:32.75,0:17:34.16,Main,Biyo,0,0,0,,Hamamböceği!Dialogue: 0,0:17:38.47,0:17:41.19,Main,Biyo,0,0,0,,Çekil şuradan, hamamböceği!Dialogue: 0,0:17:46.90,0:17:49.19,Main,Usopp,0,0,0,,Nami, iyi misin?!Dialogue: 0,0:17:49.19,0:17:50.30,Main,Nami,0,0,0,,E-Evet!Dialogue: 0,0:17:50.30,0:17:52.30,Main,Usopp,0,0,0,,Seni boklu velet, şansını fazla zorlama!Dialogue: 0,0:17:52.30,0:17:53.73,Main,Nami,0,0,0,,Yapma, Usopp!Dialogue: 0,0:17:53.73,0:17:57.61,Main,Usopp,0,0,0,,Bırak beni! Güç kullanarak durdurmaktan başka bir seçeneğimiz yok!Dialogue: 0,0:17:57.61,0:18:01.88,Main,Usopp,0,0,0,,Halüsinasyon görmeye falan başladı kesin! Sana hamamböceği dedi be!Dialogue: 0,0:18:01.88,0:18:03.13,Main,Nami,0,0,0,,Ama...Dialogue: 0,0:18:05.14,0:18:08.73,Main,Nami,0,0,0,,...bu çocukların hiçbir suçu yok, hepsi de bu durumun kurbanılar!Dialogue: 0,0:18:09.68,0:18:12.45,Main,Child,0,0,0,,Çözün zincirlerimi!Dialogue: 0,0:18:14.98,0:18:17.47,Main,Child,0,0,0,,Acıyor!Dialogue: 0,0:18:18.90,0:18:23.72,Main,Usopp,0,0,0,,Ama onlar canımıza okumadan önce bir şeyler yapmalıyız!Dialogue: 0,0:18:23.72,0:18:26.07,Main,Nami,0,0,0,,Öyleyse bu nefretini...Dialogue: 0,0:18:26.07,0:18:27.51,Main,Nami,0,0,0,,...şu herife yönelt!Dialogue: 0,0:18:29.65,0:18:30.91,Main,Child,0,0,0,,Çözün beni!Dialogue: 0,0:18:30.91,0:18:32.87,Main,Child,0,0,0,,Zincirlerimi sökün!Dialogue: 0,0:18:36.12,0:18:37.46,Main,Usopp,0,0,0,,Yok artık!Dialogue: 0,0:18:37.46,0:18:38.78,Main,Nami,0,0,0,,Zincirleri mi kırdılar?!Dialogue: 0,0:18:41.88,0:18:46.23,Main,Caesar,0,0,0,,Harikulade! Oldukça güçlenmişsiniz!Dialogue: 0,0:18:46.81,0:18:47.63,Main,Nami,0,0,0,,O küçük...Dialogue: 0,0:18:47.63,0:18:49.07,Main,Konbu,0,0,0,,Şeker...Dialogue: 0,0:18:49.07,0:18:50.70,Main,Doran,0,0,0,,Master.Dialogue: 0,0:18:50.70,0:18:52.54,Main,Uzu,0,0,0,,Lütfen...Dialogue: 0,0:18:53.10,0:18:54.96,Main,Usopp,0,0,0,,Sen bekle, lanet adi gaz!Dialogue: 0,0:18:57.37,0:18:59.54,Main,Usopp,0,0,0,,Gaza karşı en etkili...Dialogue: 0,0:18:59.90,0:19:00.82,Main,Usopp,0,0,0,,Hissatsu...Dialogue: 0,0:18:59.90,0:19:00.82,Attack,Usopp,0,0,0,,Öldürücü Darbe...Dialogue: 0,0:19:01.65,0:19:04.64,Main,Usopp,0,0,0,,Fire Bird Star! Dialogue: 0,0:19:01.65,0:19:04.64,Attack,Usopp,0,0,0,,Alev Kuşu YıldızıDialogue: 0,0:19:05.64,0:19:07.66,Main,Usopp,0,0,0,,Çocuklar, çekilin!Dialogue: 0,0:19:13.14,0:19:15.34,Main,Caesar,0,0,0,,Tutuşup patlayacağımı mı sandın?Dialogue: 0,0:19:15.76,0:19:18.54,Main,Caesar,0,0,0,,Güçlerimin gaz temelli olduğunu biliyordun, değil mi?Dialogue: 0,0:19:18.54,0:19:22.50,Main,Caesar,0,0,0,,Ama beyhude... Ateş bana ulaşamadan söndürebilirim.Dialogue: 0,0:19:23.15,0:19:25.87,Main,Caesar,0,0,0,,Zehirli gaz var olan tek gaz türü değildir.Dialogue: 0,0:19:27.04,0:19:29.83,Main,Caesar,0,0,0,,Etrafımızdaki hava da gaz!Dialogue: 0,0:19:29.83,0:19:34.99,Main,Caesar,0,0,0,,Yani belirli bir alandaki havayı kontrol edebildiğim anlamına geliyor bu.Dialogue: 0,0:19:34.99,0:19:38.11,Main,Caesar,0,0,0,,Havadan oksijeni çıkarttın mı ateş yanmaz.Dialogue: 0,0:19:38.11,0:19:40.86,Main,Caesar,0,0,0,,Sizler nefes bile alamazsınız.Dialogue: 0,0:19:46.61,0:19:48.08,Main,Master,0,0,0,,Aynen böyle!Dialogue: 0,0:19:58.07,0:19:59.22,Main,Nami,0,0,0,,Usopp!Dialogue: 0,0:20:00.66,0:20:02.33,Main,Nami,0,0,0,,Black Ball... Dialogue: 0,0:20:00.66,0:20:02.33,Attack,Nami,0,0,0,,Kara TopDialogue: 0,0:20:06.15,0:20:06.84,Main,Nami,0,0,0,,Raiun... Dialogue: 0,0:20:06.15,0:20:06.84,Attack,Nami,0,0,0,,Fırtına BulutuDialogue: 0,0:20:16.20,0:20:18.31,Main,Sind,0,0,0,,Master.Dialogue: 0,0:20:21.73,0:20:24.30,Main,Sind,0,0,0,,Ş-Şeker...Dialogue: 0,0:20:24.30,0:20:25.08,Main,Ally,0,0,0,,Şeker...Dialogue: 0,0:20:27.68,0:20:32.19,Main,Caesar,0,0,0,,Hasır Şapkalar'la karşılaşamadığımı mı düşünüyordunuz?Dialogue: 0,0:20:33.42,0:20:38.21,Main,Caesar,0,0,0,,Karşılaştık elbette.Dialogue: 0,0:20:38.52,0:20:41.78,Main,Caesar,0,0,0,,Onları da boğdum!Dialogue: 0,0:20:42.56,0:20:45.23,Main,Sind,0,0,0,,Şeker!Dialogue: 0,0:20:45.23,0:20:47.08,Main,Child,0,0,0,,Şimdi!Dialogue: 0,0:20:47.08,0:20:48.00,Main,Child,0,0,0,,Master!Dialogue: 0,0:20:53.62,0:20:56.21,Main,Sind,0,0,0,,Şeker ver, şeker ver!Dialogue: 0,0:20:58.12,0:21:04.07,Main,Caesar,0,0,0,,Çocuklarım. Şekeri yalnızca laboratuvara geri dönen uslu çocuklara vereceğim!Dialogue: 0,0:21:05.24,0:21:08.09,Main,Mocha,0,0,0,,Uslu olacağız! Uslu çocuk olacağız!Dialogue: 0,0:21:08.09,0:21:10.44,Main,Caesar,0,0,0,,O zaman birazcık daha bekleyebilirsiniz, değil mi?Dialogue: 0,0:21:11.71,0:21:15.91,Main,Caesar,0,0,0,,Peki, peki. Gidelim madem ama önce...Dialogue: 0,0:21:16.43,0:21:20.57,Main,Caesar,0,0,0,,...sizleri kaçırıp acınızı katlayan bu şeytanları öldürmeniz lazım!Dialogue: 0,0:21:20.57,0:21:23.63,Main,Caesar,0,0,0,,Öldürmeliyiz...Dialogue: 0,0:21:30.47,0:21:35.36,Main,Caesar,0,0,0,,Şu devasa boruyla kafalarını parçalayın!Dialogue: 0,0:21:36.19,0:21:37.27,Main,Child,0,0,0,,Evet...Dialogue: 0,0:21:42.89,0:21:44.73,Main,Nami,0,0,0,,Yapmayın!Dialogue: 0,0:21:44.73,0:21:48.07,Main,Usopp,0,0,0,,Başım dönüyor...Dialogue: 0,0:21:56.37,0:21:59.04,Main,Brownbeard,0,0,0,,Caesar!Dialogue: 0,0:22:14.92,0:22:15.97,Main,Nami,0,0,0,,Kahverengi!Dialogue: 0,0:22:15.97,0:22:16.94,Main,Usopp,0,0,0,,Kahverengisakal olacak o!Dialogue: 0,0:22:16.94,0:22:18.58,Main,Brownbeard,0,0,0,,Hasır Şapka Tayfası!Dialogue: 0,0:22:19.86,0:22:21.72,Main,Brownbeard,0,0,0,,Aklım başıma geldi artık!Dialogue: 0,0:22:26.39,0:22:28.25,Main,Caesar,0,0,0,,Bu da kimdi böyle?!Dialogue: 0,0:22:30.22,0:22:34.99,Main,Caesar,0,0,0,,Sahi ya, itaatkâr uşağım Kahverengisakal'dın sen!Dialogue: 0,0:22:34.99,0:22:38.50,Main,Brownbeard,0,0,0,,Adi herif, hemen silip attın mı beni?!Dialogue: 0,0:22:42.00,0:22:43.97,Main,Caesar,0,0,0,,Elbette yok öyle bir şey.Dialogue: 0,0:22:44.43,0:22:45.84,Main,Caesar,0,0,0,,Ne oldu sana böyle?Dialogue: 0,0:22:45.84,0:22:48.64,Main,Caesar,0,0,0,,Görünüşe göre çok kötü yanmışsın. Sadece sana bakmak bile acı veriyor.Dialogue: 0,0:22:50.35,0:22:53.71,Main,Brownbeard,0,0,0,,Ölümümü emrettiğin için öyle oldu!Dialogue: 0,0:22:55.39,0:22:56.75,Flashbacks,Scotch,0,0,0,,Kahverengisakal'sın sen, değil mi?Dialogue: 0,0:22:57.98,0:23:02.53,Flashbacks,Scotch,0,0,0,,Adın da öldürülecekler listemiz dahilinde.Dialogue: 0,0:23:02.53,0:23:06.56,Flashbacks,Caesar,0,0,0,,Aptal olduğundan elde oynatması kolay biriydi ama artık ayakbağı oluyor.Dialogue: 0,0:23:06.56,0:23:07.42,Flashbacks,Caesar,0,0,0,,İhtiyacımız kalmadı ona.Dialogue: 0,0:23:08.82,0:23:10.64,Flashbacks,Caesar,0,0,0,,Öldürün.Dialogue: 0,0:23:12.10,0:23:14.41,Main,Caesar,0,0,0,,Fiyakalı Kardeşler, değil mi?Dialogue: 0,0:23:17.42,0:23:19.96,Main,Caesar,0,0,0,,Demek bu yüzden yandın!Dialogue: 0,0:23:22.05,0:23:24.17,Main,Brownbeard,0,0,0,,Sana güvenmiştim.Dialogue: 0,0:23:25.82,0:23:27.78,Main,Caesar,0,0,0,,Öyle kızma şimdi!Dialogue: 0,0:23:29.59,0:23:34.44,Main,Caesar,0,0,0,,Fiyakalı Kardeşler'in saldırısının ardından bile hayattasın.Dialogue: 0,0:23:34.44,0:23:36.94,Main,Caesar,0,0,0,,Çok da şanslıymışsın!Dialogue: 0,0:23:36.94,0:23:38.49,Main,Brownbeard,0,0,0,,Kapa çeneni!Dialogue: 0,0:23:41.44,0:23:42.76,Main,Brownbeard,0,0,0,,Caesar!Dialogue: 0,0:23:48.08,0:23:50.87,Main,Caesar,0,0,0,,Çocuklarım, burası tehlikeli!Dialogue: 0,0:23:51.84,0:23:54.87,Main,Caesar,0,0,0,,Dışarıdaki uçan gaz balona binin hemen.Dialogue: 0,0:23:55.35,0:23:57.47,Main,Caesar,0,0,0,,Hemen kaçalım buradan!Dialogue: 0,0:24:00.24,0:24:02.67,Main,Nami,0,0,0,,Bekleyin millet! Gidemezsiniz!Dialogue: 0,0:24:05.64,0:24:06.87,Main,Brownbeard,0,0,0,,Caesar!Dialogue: 0,0:24:09.97,0:24:12.62,Main,Brownbeard,0,0,0,,Beni kandırmış olman umrumda değil.Dialogue: 0,0:24:13.99,0:24:17.39,Main,Brownbeard,0,0,0,,Umrumda değil.Dialogue: 0,0:24:18.73,0:24:21.44,Main,Brownbeard,0,0,0,,Ama tayfamı bana geri vereceksin!Dialogue: 0,0:24:21.44,0:24:25.47,Main,Brownbeard,0,0,0,,Yaşadığım cehennemi onların da yaşamasını istemiyorum!Dialogue: 0,0:24:31.86,0:24:35.44,Main,Caesar,0,0,0,,Embesil! Artık tayfan mayfan yok senin!Dialogue: 0,0:24:36.16,0:24:40.15,Main,Caesar,0,0,0,,Sen de dahil tüm tayfan benim adamlarım olmuştunuz!Dialogue: 0,0:24:40.15,0:24:42.82,Main,Caesar,0,0,0,,Kaptan gibi davranmayı bırak artık!Dialogue: 0,0:24:42.82,0:24:45.66,Main,Caesar,0,0,0,,Yeni Dünya'da tutunamamış dandik korsan seni!Dialogue: 0,0:24:47.37,0:24:50.04,Main,Usopp,0,0,0,,Haydi Nami, çocukların peşinden gidelim!Dialogue: 0,0:24:50.04,0:24:50.75,Main,Nami,0,0,0,,Peki!Dialogue: 0,0:24:51.33,0:24:57.10,Main,Caesar,0,0,0,,Kurtarıcıları olduğumu düşünerek peşimden gelmeye devam edecekler!Dialogue: 0,0:24:57.10,0:24:59.63,Main,Caesar,0,0,0,,O kadar aptallar ki gerçeği fark edemiyorlar.Dialogue: 0,0:24:59.63,0:25:03.68,Main,Caesar,0,0,0,,Hepsini deney faresi olarak yanımda tuttuğumu göremiyorlar!Dialogue: 0,0:25:03.68,0:25:05.39,Main,Brownbeard,0,0,0,,Seni pislik!Dialogue: 0,0:25:10.27,0:25:11.72,Main,Caesar,0,0,0,,Gastanet. Dialogue: 0,0:25:10.27,0:25:11.72,Attack,Caesar,0,0,0,,Gaz KastanyetiDialogue: 0,0:25:19.44,0:25:20.63,Main,Usopp,0,0,0,,Kahverengisakal?!Dialogue: 0,0:25:20.63,0:25:21.83,Main,Nami,0,0,0,,Ne oldu?!Dialogue: 0,0:25:31.34,0:25:32.60,Main,Caesar,0,0,0,,Gastanet. Dialogue: 0,0:25:31.34,0:25:32.60,Attack,Caesar,0,0,0,,Gaz KastanyetiDialogue: 0,0:25:37.93,0:25:39.58,Main,Child,0,0,0,,Master.Dialogue: 0,0:25:39.58,0:25:41.75,Main,Child,0,0,0,,Master nereye gitti?Dialogue: 0,0:25:44.26,0:25:45.84,Main,Caesar,0,0,0,,Caesar konuşuyor.Dialogue: 0,0:25:45.84,0:25:48.18,Main,Caesar,0,0,0,,Çocukları sağ salim geri alabildim.Dialogue: 0,0:25:48.78,0:25:50.90,Main,Caesar,0,0,0,,Smiley'in maması hazır mı?Dialogue: 0,0:25:51.31,0:25:55.79,Main,Monet,0,0,0,,Yapmamı emrettiğiniz her şey hazır, Master.Dialogue: 0,0:25:57.50,0:26:00.76,Main,Monet,0,0,0,,Gözlem Den Den Mushi'leri de dışarıda hazırlar.Dialogue: 0,0:26:00.76,0:26:08.36,Main,Caesar,0,0,0,,Öyleyse Smiley oraya varır varmaz eğlenceli deneyimizi herkese izletebileceğiz, öyle mi?Dialogue: 0,0:26:08.36,0:26:09.46,Main,Monet,0,0,0,,Elbette.Dialogue: 0,0:26:11.16,0:26:14.57,Main,Caesar,0,0,0,,Harika! Beni tüm alıcılara bağlamanı istiyorum.Dialogue: 0,0:26:14.57,0:26:15.36,Main,Monet,0,0,0,,Emredersiniz.Dialogue: 0,0:26:18.16,0:26:20.59,Main,Caesar,0,0,0,,Tüm hukuk tanımaz simsar beylere sesleniyorum.Dialogue: 0,0:26:21.76,0:26:24.13,Main,Caesar,0,0,0,,Böyle apar topar olduğu için özür diliyorum ancak...Dialogue: 0,0:26:24.13,0:26:27.74,Main,Caesar,0,0,0,,...böyle bir şeye tanık olabileceğiniz için oldukça şanslısınız.Dialogue: 0,0:26:27.74,0:26:30.80,Main,Caesar,0,0,0,,Göreceğiniz şey zehirli gaz silahının uygulanışıdır.Dialogue: 0,0:26:30.80,0:26:34.03,Main,Caesar,0,0,0,,Dört yıl öncekine yeni bir özellik ekledim.Dialogue: 0,0:26:34.51,0:26:39.41,Main,Caesar,0,0,0,,Bu eklediğim şey alçak Dünya Hükümeti'nin hayal bile edemeyeceği bir şey.Dialogue: 0,0:26:40.17,0:26:44.70,Main,Caesar,0,0,0,,Bugün adamızda bir takım davetsiz misafirlerimiz bize eşlik ediyor...Dialogue: 0,0:26:45.10,0:26:48.16,Main,Caesar,0,0,0,,...ve bu deneyi onlar üzerinde yapacağım.Dialogue: 0,0:26:52.83,0:26:56.75,Main,Caesar,0,0,0,,Fetih, savaş, hakimiyet!Dialogue: 0,0:26:57.45,0:26:59.77,Main,Caesar,0,0,0,,Bu silahın birçok olası kullanımı vardır.Dialogue: 0,0:26:59.77,0:27:04.71,Main,Caesar,0,0,0,,Eğer hoşunuza giderse iş konuşmaya geçebiliriz.Dialogue: 0,0:27:10.48,0:27:13.00,Main,Killer,0,0,0,,Kitle imha silahıyla mı ilgileniyorsun?Dialogue: 0,0:27:13.00,0:27:14.52,Main,Kid,0,0,0,,Hayır.Dialogue: 0,0:27:15.30,0:27:20.54,Main,Kid,0,0,0,,Ancak fazla bilgi göz çıkartmaz, haksız mıyım?Dialogue: 0,0:00:24.13,0:00:27.39,Credits,,0,0,0,,Translation bobthemilkman @ Yibis FansubsDialogue: 0,0:00:27.55,0:00:30.64,Credits,,0,0,0,,Translation check Lord Starfish @ Yibis FansubsDialogue: 0,0:00:31.11,0:00:34.25,Credits,,0,0,0,,Initial timing FAbian101 @ Yibis FansubsDialogue: 0,0:00:34.80,0:00:38.38,Credits,,0,0,0,,Timing Galaxy 9000Dialogue: 0,0:00:41.33,0:00:43.61,Credits,,0,0,0,,Quality checking SewilDialogue: 0,0:00:43.61,0:00:45.87,Credits,,0,0,0,,Soundtracking MaideV and HaleeDialogue: 0,0:00:45.95,0:00:48.13,Credits,,0,0,0,,Raw providing OPC-RawsDialogue: 0,0:00:49.52,0:00:52.98,Credits,,0,0,0,,Editing Sewil