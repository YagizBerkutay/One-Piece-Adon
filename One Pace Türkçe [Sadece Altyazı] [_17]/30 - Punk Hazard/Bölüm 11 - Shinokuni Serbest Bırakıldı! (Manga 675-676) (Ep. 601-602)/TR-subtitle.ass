Dialogue: 0,0:02:29.95,0:02:38.16,Title,,0,0,0,,{\fad(2000,2000)}Deney Başlıyor! \NShinokuni Serbest Bırakıldı!
Dialogue: 0,0:02:39.30,0:02:42.82,Captions,Caption,0,0,0,,{\pos(640,547)\fad(500,0)\fs45}Caesar'ın Laboratuvarı - Ana Giriş
Dialogue: 0,0:02:39.78,0:02:40.85,Main,Soldier,0,0,0,,Aç şunu!
Dialogue: 0,0:02:42.98,0:02:45.16,Main,Soldier,0,0,0,,Aç kapıları!
Dialogue: 0,0:02:45.16,0:02:47.49,Main,Soldier,0,0,0,,Smo-ya ve Tashigi-chan'ı geri verin!
Dialogue: 0,0:02:48.08,0:02:50.59,Main,Soldier,0,0,0,,Bu da ne? Hava taşıtı mı?!
Dialogue: 0,0:02:58.61,0:03:00.50,Main,Caesar,0,0,0,,Haydi, gelin bakalım çocuklarım!
Dialogue: 0,0:03:01.25,0:03:03.32,Main,Caesar,0,0,0,,Sizin eviniz burası!
Dialogue: 0,0:03:04.38,0:03:07.08,Main,Caesar,0,0,0,,Bir daha öyle alıp başınızı\Ngitmeyin tamam mı?
Dialogue: 0,0:03:07.42,0:03:09.70,Main,Sind,0,0,0,,Master, teşekkür ederim!
Dialogue: 0,0:03:10.83,0:03:14.24,Main,Child,0,0,0,,Koyun-san, şeker ver lütfen.
Dialogue: 0,0:03:15.62,0:03:18.69,Main,Sind,0,0,0,,Master!\NÇabuk şeker ver bize lütfen!
Dialogue: 0,0:03:18.69,0:03:23.05,Main,Doran,0,0,0,,Başım ağrıyor!\NMaster, şeker ver bize!
Dialogue: 0,0:03:23.05,0:03:25.56,Main,Caesar,0,0,0,,Elbette, az sonra vereceğim.
Dialogue: 0,0:03:27.23,0:03:32.34,Main,Caesar,0,0,0,,Şimdi hepiniz hemencecik\NBisküvi Odası'na dönün bakalım.
Dialogue: 0,0:03:32.34,0:03:35.93,Main,Caesar,0,0,0,,Oraya bir sürü şeker bıraktım.
Dialogue: 0,0:03:35.93,0:03:40.13,Main,Caesar,0,0,0,,Benim artık araştırma odama\Ngeri dönmem lazım.
Dialogue: 0,0:03:40.54,0:03:43.55,Main,Caesar,0,0,0,,İyice yerleşip\Nşekerlerinizi afiyetle yiyin!
Dialogue: 0,0:03:43.55,0:03:46.63,Main,Caesar,0,0,0,,Çok ama çok leziz\Nşekerlerinizi!
Dialogue: 0,0:03:49.26,0:03:53.10,Main,Doran,0,0,0,,Hadi gidelim!\NYolu göster bize, Koyun amca!
Dialogue: 0,0:03:53.10,0:03:55.15,Main,Soldier,0,0,0,,Bu taraftan çocuklar!
Dialogue: 0,0:03:56.65,0:03:58.16,Main,Konbu,0,0,0,,Bisküvi Odası!
Dialogue: 0,0:03:58.16,0:03:59.67,Main,Ally,0,0,0,,Şeker istiyorum!
Dialogue: 0,0:04:01.30,0:04:03.24,Main,Caesar,0,0,0,,Ne yapacağını biliyorsun değil mi?
Dialogue: 0,0:04:03.24,0:04:09.40,Main,Caesar,0,0,0,,Hepsi içeri girdikten sonra kapıyı kilitle\Nve bir daha oradan çıkmalarına izin verme.
Dialogue: 0,0:04:09.40,0:04:10.44,Main,Soldier,0,0,0,,Emredersiniz.
Dialogue: 0,0:04:13.63,0:04:15.57,Main,Mocha,0,0,0,,Burası çok korkunç!
Dialogue: 0,0:04:15.57,0:04:18.20,Main,Soldier,0,0,0,,Ne oldu, seni pis kokulu velet--
Dialogue: 0,0:04:18.20,0:04:20.36,Main,Soldier,0,0,0,,Aa şey yani güzel kız?
Dialogue: 0,0:04:20.51,0:04:27.01,Main,Soldier,0,0,0,,Sen de arkadaşlarınla odaya dönüp\Ntatlı mı tatlı şekerini yesene!
Dialogue: 0,0:04:30.41,0:04:31.78,Main,Soldier,0,0,0,,Ne?\NNe oldu?!
Dialogue: 0,0:04:35.75,0:04:39.76,Flashbacks,Usopp,0,0,0,,Laboratuvara geri dönmek\Nistemiyorsun, değil mi?
Dialogue: 0,0:04:39.76,0:04:42.05,Flashbacks,Child,0,0,0,,Çekil yolumdan!
Dialogue: 0,0:04:43.47,0:04:44.22,Flashbacks,Nami,0,0,0,,Usopp!
Dialogue: 0,0:04:44.54,0:04:46.91,Flashbacks,Child,0,0,0,,Master, lütfen şeker ver!
Dialogue: 0,0:04:49.52,0:04:53.93,Flashbacks,Caesar,0,0,0,,Dönün bana, çocuklarım!
Dialogue: 0,0:04:53.93,0:04:58.30,Flashbacks,Nami,0,0,0,,Bekleyin!\NOnunla gidemezsiniz!
Dialogue: 0,0:04:58.30,0:05:00.74,Flashbacks,Nami,0,0,0,,Evinize dönmek istemiyor musunuz?!
Dialogue: 0,0:05:01.20,0:05:03.23,Main,Soldiers,0,0,0,,Haydi bakalım...
Dialogue: 0,0:05:06.10,0:05:08.54,Main,Mocha,0,0,0,,Hayır!\NBen buradan çıkmak istiyorum!
Dialogue: 0,0:05:09.60,0:05:11.12,Main,Soldier,0,0,0,,Ne diyorsun sen yahu?
Dialogue: 0,0:05:11.12,0:05:14.04,Main,Soldier,0,0,0,,Dışarısı soğuk!\NHem kaçıncı kattasın biliyor musun?
Dialogue: 0,0:05:14.04,0:05:15.49,Main,Soldier,0,0,0,,Haydi, odaya gir bakalım.
Dialogue: 0,0:05:15.49,0:05:18.31,Main,Mocha,0,0,0,,Hayır işte!\NKurtar beni abla!
Dialogue: 0,0:05:19.19,0:05:20.43,Main,Uzu,0,0,0,,Mocha?
Dialogue: 0,0:05:20.43,0:05:22.89,Main,Child,0,0,0,,Haydi gidip yiyelim şu şekerleri!
Dialogue: 0,0:05:23.99,0:05:24.94,Main,Mocha,0,0,0,,Tabii ya!
Dialogue: 0,0:05:24.94,0:05:27.45,Main,Mocha,0,0,0,,Sizi dinlemediğim için\Nözür dilerim!
Dialogue: 0,0:05:27.45,0:05:30.79,Main,Mocha,0,0,0,,Abi, abla, yardım edin!
Dialogue: 0,0:05:30.79,0:05:33.00,Main,Soldier,0,0,0,,Kapıdan uzaklaş!
Dialogue: 0,0:05:33.00,0:05:35.57,Main,Soldier,0,0,0,,Lanet olası! Ne baş belası çıktın!
Dialogue: 0,0:05:35.57,0:05:38.30,Main,Mocha,0,0,0,,Kurtarın beni, abla!
Dialogue: 0,0:05:40.33,0:05:43.51,Main,Mocha,0,0,0,,{\i1}Abla!
Dialogue: 0,0:05:48.98,0:05:51.27,Captions,Caption,0,0,0,,{\pos(640,547)\fad(500,0)}Birinci ve İkinci Laboratuvar Harabeleri
Dialogue: 0,0:05:52.05,0:05:55.16,Main,Nami,0,0,0,,Sanji-kun'un vücudu fazla hasar aldı...
Dialogue: 0,0:05:55.80,0:05:57.47,Main,Nami,0,0,0,,...ama çok sağlammış.
Dialogue: 0,0:06:00.58,0:06:01.33,Main,Nami,0,0,0,,Usopp!
Dialogue: 0,0:06:05.71,0:06:08.22,Main,Nami,0,0,0,,Dayan, Usopp!
Dialogue: 0,0:06:10.43,0:06:13.94,Main,Usopp,0,0,0,,Beni kurtarmaya mı geldin, Sanji?
Dialogue: 0,0:06:13.94,0:06:15.54,Main,Nami,0,0,0,,Nami'yim ben!
Dialogue: 0,0:06:16.60,0:06:19.14,Main,Nami,0,0,0,,Neden bu kadar hayal kırıklığına\Nuğramış gibi davranıyorsun?
Dialogue: 0,0:06:22.04,0:06:24.09,Main,Caesar,0,0,0,,Beklettiğim için kusura bakma, Vergo!
Dialogue: 0,0:06:24.59,0:06:28.26,Main,Vergo,0,0,0,,Önemli değil.\NKahve ve kurabiye keyfi yapıyordum.
Dialogue: 0,0:06:29.64,0:06:32.46,Main,Vergo,0,0,0,,Tuhaf, kurabiyeler gitmiş.
Dialogue: 0,0:06:32.46,0:06:34.56,Main,Monet,0,0,0,,Kurabiye ikram etmemiştim ki.
Dialogue: 0,0:06:34.56,0:06:38.39,Main,Vergo,0,0,0,,Sahi ya, kurabiye yemiyordum ben, değil mi?
Dialogue: 0,0:06:38.39,0:06:41.52,Main,Vergo,0,0,0,,Deney ne zaman başlayacak, Caesar?
Dialogue: 0,0:06:41.52,0:06:44.77,Main,Caesar,0,0,0,,Yakında. Monet, videoyu aç.
Dialogue: 0,0:06:44.77,0:06:45.44,Main,Monet,0,0,0,,Emredersiniz.
Dialogue: 0,0:06:47.44,0:06:53.70,Main,Caesar,0,0,0,,O değil de keşke adamlarını daha düzgün\Nkontrol edebilmiş olsaydın, Vergo.
Dialogue: 0,0:06:53.98,0:06:58.40,Main,Caesar,0,0,0,,Smoker'ı burada görür görmez\Nsırtımdan terler boşaldı.
Dialogue: 0,0:06:58.40,0:07:02.32,Main,Vergo,0,0,0,,Haklısın, adam vahşi köpekler gibi.
Dialogue: 0,0:07:03.48,0:07:07.59,Main,Caesar,0,0,0,,Tabii tüm bunları\Nyakında ardımızda bırakacağız.
Dialogue: 0,0:07:08.52,0:07:12.32,Main,Caesar,0,0,0,,Şu haline bir bak, Law.
Dialogue: 0,0:07:14.83,0:07:19.18,Main,Caesar,0,0,0,,Vergo'ya karşı parmağını bile\Nkaldıramamışsındır kesin, ha?
Dialogue: 0,0:07:19.90,0:07:23.38,Main,Caesar,0,0,0,,Yaptığımız anlaşma\Nbenim işime geldi!
Dialogue: 0,0:07:25.13,0:07:31.06,Flashbacks,Caesar,0,0,0,,Burada kalmana izin verirsem\Nadamlarıma bacaklar vereceksin, öyle mi?
Dialogue: 0,0:07:31.66,0:07:33.59,Flashbacks,Caesar,0,0,0,,Bu hoşuma giderdi elbette.
Dialogue: 0,0:07:33.88,0:07:34.82,Flashbacks,Caesar,0,0,0,,Yine de...
Dialogue: 0,0:07:35.54,0:07:41.09,Flashbacks,Caesar,0,0,0,,...benden daha güçlüsün ama\Nadanın patronu ben olduğumdan...
Dialogue: 0,0:07:41.09,0:07:45.16,Flashbacks,Caesar,0,0,0,,...burada kalmak istiyorsan\Nufak bir sigortaya ihtiyacım olacak.
Dialogue: 0,0:07:45.16,0:07:47.82,Flashbacks,Law,0,0,0,,Sana hiçbir zarar vermeyeceğim.
Dialogue: 0,0:07:47.82,0:07:49.29,Flashbacks,Law,0,0,0,,Kendini güvende hissetmen\Niçin ne yapmalıyım?
Dialogue: 0,0:07:49.52,0:07:52.76,Flashbacks,Caesar,0,0,0,,Küçük bir anlaşma, Trafalgar Law.
Dialogue: 0,0:07:53.48,0:07:59.68,Flashbacks,Caesar,0,0,0,,Çok sevdiğim sekreterim,\NMonet'in kalbini sana vereceğim!
Dialogue: 0,0:08:01.05,0:08:02.97,Flashbacks,Caesar,0,0,0,,Olur değil mi, Monet?
Dialogue: 0,0:08:03.26,0:08:05.92,Flashbacks,Monet,0,0,0,,Evet, olur elbette.
Dialogue: 0,0:08:06.43,0:08:11.63,Flashbacks,Caesar,0,0,0,,Karşılığında da\Nkalbini istiyorum!
Dialogue: 0,0:08:11.63,0:08:13.96,Flashbacks,Caesar,0,0,0,,Anlaşmamız böyle!
Dialogue: 0,0:08:15.00,0:08:20.43,Flashbacks,Caesar,0,0,0,,Karşılıklı olarak can yakacak kozları\Nelimizde bulundurursak bir şey yapamazsın.
Dialogue: 0,0:08:20.43,0:08:21.88,Flashbacks,Caesar,0,0,0,,Böylece güvende hissedebilirim.
Dialogue: 0,0:08:26.30,0:08:29.56,Main,Caesar,0,0,0,,Her zaman kimseye\Ngüvenilmeyeceğine inandım.
Dialogue: 0,0:08:29.56,0:08:31.98,Main,Caesar,0,0,0,,Ne ekersen onu biçersin, dedikleri gibi.
Dialogue: 0,0:08:31.98,0:08:33.87,Main,Caesar,0,0,0,,Sanıyorum artık dersini almışsındır...
Dialogue: 0,0:08:34.18,0:08:37.99,Main,Caesar,0,0,0,,...keza kalbin Vergo'da.
Dialogue: 0,0:08:42.79,0:08:43.47,Main,Luffy,0,0,0,,Ne oldu!?
Dialogue: 0,0:08:44.93,0:08:49.57,Main,Caesar,0,0,0,,Senin gibi yetenekli biri için bile\Nfark etmesi imkansız olsa da...
Dialogue: 0,0:08:49.57,0:08:54.99,Main,Caesar,0,0,0,,...Monet taktiksel bir biçimde\Ngörünüşünü değiştirip seni izledi.
Dialogue: 0,0:08:58.15,0:09:00.79,Main,Luffy,0,0,0,,İyi misin, Tra-o?
Dialogue: 0,0:09:00.79,0:09:03.29,Main,Caesar,0,0,0,,Neyin peşinde olduğunuzu biliyorum.
Dialogue: 0,0:09:03.62,0:09:06.31,Main,Caesar,0,0,0,,Yazık oldu, Law'cığım.
Dialogue: 0,0:09:06.31,0:09:10.39,Main,Caesar,0,0,0,,İyi birer arkadaş olduğumuzu\Ndüşünmeye başlamıştım oysa ki.
Dialogue: 0,0:09:13.27,0:09:19.55,Main,Law,0,0,0,,Çalışkan sekreterin tarafından kurtarıldın demek?\NMonet konusunda daha dikkatli olmalıydım.
Dialogue: 0,0:09:20.14,0:09:24.22,Main,Law,0,0,0,,Master o kadar salaktı ki\Npek umursamadım.
Dialogue: 0,0:09:28.04,0:09:30.63,Main,Caesar,0,0,0,,Ağzından çıkanlara dikkat et, velet!
Dialogue: 0,0:09:31.04,0:09:35.02,Main,Luffy,0,0,0,,Vay canına! Kalbini çıkartmalarına rağmen\Nhâlâ yaşıyorsun öyle mi?
Dialogue: 0,0:09:35.76,0:09:39.97,Main,Smoker,0,0,0,,Kendi yeteneğini kullandırtacak kadar\Nnasıl aptal olabilir bir insan?!
Dialogue: 0,0:09:39.97,0:09:42.26,Main,Smoker,0,0,0,,Benimki nerede peki?
Dialogue: 0,0:09:44.52,0:09:49.97,Main,Caesar,0,0,0,,Burada! Smo{\fscx250}-{\r}
Dialogue: 0,0:09:49.97,0:09:54.04,Main,Monet,0,0,0,,Master, yayını başlatmaya hazırız.
Dialogue: 0,0:09:54.04,0:09:55.24,Main,Caesar,0,0,0,,Öyle demek?
Dialogue: 0,0:09:56.45,0:09:57.70,Main,Caesar,0,0,0,,Ölümden kurtuldun şimdilik!
Dialogue: 0,0:10:04.47,0:10:06.42,Main,Caesar,0,0,0,,Hadi bakalım, başlat.
Dialogue: 0,0:10:07.95,0:10:09.69,Main,Soldier,0,0,0,,Ekranda bir şey belirdi!
Dialogue: 0,0:10:09.69,0:10:12.80,Main,Soldier,0,0,0,,Bu da ne?\NNerede ki?! O şey...
Dialogue: 0,0:10:12.80,0:10:15.09,Main,Soldier,0,0,0,,...şeker mi? Kocaman bir tanesi hem de!
Dialogue: 0,0:10:15.57,0:10:25.21,Captions,Caption,0,0,0,,{\pos(640,547)\fad(500,0)}Yeni Dünya'da Çeşitli Lokasyonlar - Yeraltı Dünyası Simsarları
Dialogue: 0,0:10:15.42,0:10:20.00,Main,Caesar,0,0,0,,{\an8}Yanan taraftan bu tarafa geçmeyi başaran küçük Smileyler...
Dialogue: 0,0:10:20.00,0:10:25.21,Main,Caesar,0,0,0,,{\an8}...çok yakında Donmuş Topraklar'ın\Nmerkezine varacaklar.
Dialogue: 0,0:10:25.21,0:10:33.22,Main,Caesar,0,0,0,,Orada birleşip bir kez daha koca bir\NSmiley haline geldiklerinde...
Dialogue: 0,0:10:33.91,0:10:35.90,Main,Caesar,0,0,0,,...deney başlayacak.
Dialogue: 0,0:10:47.21,0:10:57.94,Main,Caesar,0,0,0,,Dört yıl önce bu adadaki herkesi öldürmüş\Nzehirli H2S gaz bombasının ta kendisi,...
Dialogue: 0,0:10:57.94,0:10:59.41,Main,Caesar,0,0,0,,...yani Smiley.
Dialogue: 0,0:11:01.93,0:11:03.86,Main,Caesar,0,0,0,,Geçen sefer bir sorun yaşamıştık.
Dialogue: 0,0:11:10.48,0:11:19.21,Main,Caesar,0,0,0,,Zehirden etkilenen kişiler yavaş yavaş güçsüz\Ndüşmelerine rağmen sığınacak güvenli yerler bulabildiler.
Dialogue: 0,0:11:19.87,0:11:27.05,Main,Caesar,0,0,0,,Bu yüzden dört yıl önceki silah Smiley'e\Nbüyük bir güçlendirme yapmayı planlıyorum.
Dialogue: 0,0:11:27.92,0:11:35.31,Main,Caesar,0,0,0,,Bu güçlendirme zehirli gazı kusursuz\Nbir kitle imha silahına dönüştürecek.
Dialogue: 0,0:11:36.24,0:11:38.56,Main,Caesar,0,0,0,,Görkemine bugün şahit olacağınız...
Dialogue: 0,0:11:38.56,0:11:39.78,Main,Caesar,0,0,0,,...bu yeni silahın adı...
Dialogue: 0,0:11:40.82,0:11:42.46,Main,Caesar,0,0,0,,Shinokuni!
Dialogue: 0,0:11:40.82,0:11:42.46,Note,Caesar,0,0,0,,{\fad(100,0)}Ölüm Diyarı
Dialogue: 0,0:11:42.88,0:11:46.90,Captions,Caption,0,0,0,,{\pos(640,547)\fad(560,0)}Donmuş Topraklar - Merkez Bölgesi
Dialogue: 0,0:11:50.92,0:11:52.89,Main,Zoro,0,0,0,,Geliyorlar!
Dialogue: 0,0:11:53.86,0:11:56.11,Main,Zoro,0,0,0,,Ondan kaçamaz mıyız?
Dialogue: 0,0:12:03.75,0:12:07.52,Main,Sanji,0,0,0,,Tek parça haline geldi bile!
Dialogue: 0,0:12:07.52,0:12:11.05,Main,Kin'emon,0,0,0,,Her şeyi geçtim,\Nne ki bu şey?!
Dialogue: 0,0:12:11.05,0:12:13.94,Main,Zoro,0,0,0,,Şu saatten sonra ne konuşuyoruz, kaçın!
Dialogue: 0,0:12:15.58,0:12:18.97,Main,Brook,0,0,0,,Kusura bakmayın millet.\NÖnümüzde büyük bir top var gibi görünüyor!
Dialogue: 0,0:12:19.55,0:12:21.24,Main,Zoro,0,0,0,,Bu da ne?!
Dialogue: 0,0:12:21.24,0:12:24.30,Main,Sanji,0,0,0,,Şekere benziyor sanki?!
Dialogue: 0,0:12:24.30,0:12:26.35,Main,Zoro,0,0,0,,Yanında birileri var.
Dialogue: 0,0:12:28.22,0:12:31.72,Captions,Caption,0,0,0,,{\pos(640,547)\fad(500,0)}Vegapunk'ın Ejderhası (Minyatür)
Dialogue: 0,0:12:32.25,0:12:36.06,Main,Soldier,0,0,0,,Master, devasa jöle\Nbenzeri bir yaratık yaklaşıyor.
Dialogue: 0,0:12:36.06,0:12:38.29,Main,Soldier,0,0,0,,Sanıyoruz Smiley bu.
Dialogue: 0,0:12:39.39,0:12:43.74,Main,Soldier,0,0,0,,O halde planladığımız gibi ilerleyeceğiz ve\NMaster'ın yayınını sisin üzerine yansıtacağız.
Dialogue: 0,0:12:43.74,0:12:45.05,Main,Caesar,0,0,0,,Güzel.
Dialogue: 0,0:12:45.05,0:12:50.61,Main,Caesar,0,0,0,,İşi bitirdikten sonra kaçmanız gerekiyor\Nyoksa tehlikeyle karşı karşıya kalacaksınız.
Dialogue: 0,0:12:50.61,0:12:53.28,Main,Caesar,0,0,0,,Ejderha kızağını çabucak{\fscx250}-{\r}
Dialogue: 0,0:12:53.28,0:12:54.16,Main,Caesar,0,0,0,,Ne oldu?
Dialogue: 0,0:12:54.86,0:12:56.15,Main,Soldier,0,0,0,,Bu şey...
Dialogue: 0,0:12:56.15,0:12:59.55,Main,Soldier,0,0,0,,Bir sorunumuz var!\NKızak eriyor!
Dialogue: 0,0:12:59.55,0:13:02.49,Main,Soldier,0,0,0,,Kullanılamaz bir hâle geldi!
Dialogue: 0,0:13:07.06,0:13:08.75,Main,Soldier,0,0,0,,Nasıl oldu bu?!
Dialogue: 0,0:13:08.75,0:13:12.59,Main,Soldier,0,0,0,,Bir tür kimyasal reaksiyon mu?!\NBunu kıpırdatamayız artık!
Dialogue: 0,0:13:13.49,0:13:15.32,Main,Soldier,0,0,0,,Ejderha kaçıyor!
Dialogue: 0,0:13:15.32,0:13:17.90,Main,Soldier,0,0,0,,Ne oluyor ya!\NHer şey birbiri ardına...
Dialogue: 0,0:13:17.90,0:13:20.83,Main,Caesar,0,0,0,,Ne dediniz?!
Dialogue: 0,0:13:20.83,0:13:24.16,Main,Caesar,0,0,0,,Çok vahim bir durum bu!
Dialogue: 0,0:13:25.77,0:13:27.09,Main,Monet,0,0,0,,Biraz abartı oldu.
Dialogue: 0,0:13:27.09,0:13:29.97,Main,Caesar,0,0,0,,Kaçın oradan hemen!
Dialogue: 0,0:13:29.97,0:13:32.22,Main,Caesar,0,0,0,,Koruyucu kıyafetleriniz de\Nartık işe yaramaz!
Dialogue: 0,0:13:32.66,0:13:36.77,Main,Caesar,0,0,0,,Hemen üstünüzdekileri çıkartıp\Nlaboratuvara doğru koşun!
Dialogue: 0,0:13:36.77,0:13:38.87,Main,Soldier,0,0,0,,A-Anlaşıldı.
Dialogue: 0,0:13:38.87,0:13:40.42,Main,Soldier,0,0,0,,Üstümüzdekini çıkartalım mı?!
Dialogue: 0,0:13:40.42,0:13:43.76,Main,Soldier,0,0,0,,Master her zaman haklı çıkar! \NEminim bir şeyler düşünmüştür!
Dialogue: 0,0:13:43.76,0:13:45.73,Main,Soldier,0,0,0,,Ne diyorsa yap!
Dialogue: 0,0:13:48.64,0:13:50.58,Main,Soldier,0,0,0,,Acele edin!
Dialogue: 0,0:13:54.57,0:13:57.53,Main,Soldier,0,0,0,,Açıl, lanet olası!
Dialogue: 0,0:13:59.56,0:14:04.57,Main,Brook,0,0,0,,Ne? Şimdi de birinin sureti\Nhavaya yansıtılmaya başlandı!
Dialogue: 0,0:14:04.57,0:14:08.16,Main,Sanji,0,0,0,,Boş şeyler bunlar, boş!\NKoşmana bak sen!
Dialogue: 0,0:14:10.56,0:14:15.12,Main,Caesar,0,0,0,,Smiley, seni ne kadar özledim bir bilsen!
Dialogue: 0,0:14:15.80,0:14:17.54,Main,Caesar,0,0,0,,Görüşmeyeli üç yıl oldu!
Dialogue: 0,0:14:20.72,0:14:25.03,Main,Caesar,0,0,0,,Öyle demek, Smiley!
Dialogue: 0,0:14:25.03,0:14:29.83,Main,Caesar,0,0,0,,Anılarım canlandı adeta!\NSenin için çok güzel bir şey hazırladım!
Dialogue: 0,0:14:30.57,0:14:33.01,Main,Caesar,0,0,0,,Bekle!\NBekle, Smiley!
Dialogue: 0,0:14:33.67,0:14:35.74,Main,Caesar,0,0,0,,Birazcık daha beklemen lazım!
Dialogue: 0,0:14:37.69,0:14:40.32,Main,Caesar,0,0,0,,Efendinin sözü mutlaktır!
Dialogue: 0,0:14:40.32,0:14:42.04,Main,Caesar,0,0,0,,Öyle öğretmedim mi ben sana!?
Dialogue: 0,0:14:42.04,0:14:44.31,Main,Caesar,0,0,0,,Bekle!\NBekle dedim!
Dialogue: 0,0:14:45.07,0:14:49.98,Main,Caesar,0,0,0,,Seninle konuşmak istediğim o kadar\Nçok şey var ki! Hatırlıyor musun?
Dialogue: 0,0:14:49.98,0:14:53.25,Main,Caesar,0,0,0,,Her şey dört yıl önce başladı...
Dialogue: 0,0:14:58.85,0:15:00.22,Main,Caesar,0,0,0,,Pe-Pekâlâ.
Dialogue: 0,0:15:00.99,0:15:04.00,Main,Caesar,0,0,0,,Pekâlâ, yiyebilirsin.\NAferin.
Dialogue: 0,0:15:04.66,0:15:07.28,Main,Monet,0,0,0,,Seni dinlemiyor.
Dialogue: 0,0:15:12.23,0:15:13.60,Main,Caesar,0,0,0,,Yedi!
Dialogue: 0,0:15:13.60,0:15:16.37,Main,Caesar,0,0,0,,Yedi!\NŞekeri yedi!
Dialogue: 0,0:15:17.83,0:15:21.95,Main,Caesar,0,0,0,,Yedin harbiden, Smiley!
Dialogue: 0,0:15:30.26,0:15:32.47,Main,Caesar,0,0,0,,Yeniden doğ şimdi!
Dialogue: 0,0:15:36.13,0:15:38.97,Main,Franky,0,0,0,,Yani daha da korkunç bir şeye mi dönüşecek?
Dialogue: 0,0:15:39.44,0:15:42.46,Main,Robin,0,0,0,,Mükemmel bir kitle imha silahı.
Dialogue: 0,0:15:42.46,0:15:44.72,Main,Luffy,0,0,0,,Amma büyük bir kurbağaymış ha!
Dialogue: 0,0:15:54.26,0:15:56.53,Main,Centaur,0,0,0,,Başlıyor. Bir şeyler olmaya başlıyor!
Dialogue: 0,0:15:56.53,0:15:58.24,Main,Centaur2,0,0,0,,Peki tam olarak ne olacak?
Dialogue: 0,0:15:58.24,0:16:00.74,Main,Centaur,0,0,0,,Nereden bileyim ben!\NAma iyi bir şeyin olmayacağı belli!
Dialogue: 0,0:16:00.74,0:16:04.44,Main,Centaur2,0,0,0,,Neyse, Master'ın dediği gibi\Nlaboratuvara doğru koşalım!
Dialogue: 0,0:16:04.44,0:16:08.44,Main,Centaur,0,0,0,,Kahretsin! Kızak neden\Nşimdi kırılmak zorundaydı ki?
Dialogue: 0,0:16:08.44,0:16:10.92,Main,Centaur,0,0,0,,Master!
Dialogue: 0,0:16:10.92,0:16:13.69,Main,Sanji,0,0,0,,Şekeri yediğinden beri\Ntuhaf davranıyor!
Dialogue: 0,0:16:13.69,0:16:16.65,Main,Brook,0,0,0,,Acaba şu şeker\No kadar mı lezzetliydi?!
Dialogue: 0,0:16:16.65,0:16:18.41,Main,Kinemon,0,0,0,,Acele etmeliyiz!
Dialogue: 0,0:16:18.41,0:16:20.95,Main,Kinemon,0,0,0,,Adanın kendi askerleri\Nbile arkalarına bakmaksızın kaçıyorlar!
Dialogue: 0,0:16:20.95,0:16:23.08,Main,Kinemon,0,0,0,,Hiç iyiye işaret değil bu durum.
Dialogue: 0,0:16:23.08,0:16:24.74,Main,Zoro,0,0,0,,Bence de.
Dialogue: 0,0:16:32.58,0:16:34.94,Main,Caesar,0,0,0,,Aferin, Smiley.
Dialogue: 0,0:16:35.33,0:16:36.98,Main,Caesar,0,0,0,,Görüşmek üzere!
Dialogue: 0,0:17:01.56,0:17:04.39,Main,Caesar,0,0,0,,Yeni doğmuşa selamlar...
Dialogue: 0,0:17:05.14,0:17:08.55,Main,Caesar,0,0,0,,Kitle imha silahı Shinokuni!
Dialogue: 0,0:17:09.50,0:17:12.60,Main,Caesar,0,0,0,,Adayı kökten değiştir!
Dialogue: 0,0:17:36.90,0:17:38.07,Main,Sheep,0,0,0,,Bekleyin be{\fscx250}-{\r}
Dialogue: 0,0:17:40.95,0:17:42.68,Main,Sheep,0,0,0,,Bacaklarım!
Dialogue: 0,0:17:43.23,0:17:44.79,Main,Sheep,0,0,0,,Bu da ne böyle?!
Dialogue: 0,0:17:50.17,0:17:51.49,Main,Sheep,0,0,0,,Yardım edin...
Dialogue: 0,0:18:00.98,0:18:02.36,Main,Sheep2,0,0,0,,Ne oldu ona?!
Dialogue: 0,0:18:02.36,0:18:04.55,Main,Sheep,0,0,0,,Bunun ne önemi var?! Sadece koş!
Dialogue: 0,0:18:11.22,0:18:12.41,Main,Sheep2,0,0,0,,Vücudum...
Dialogue: 0,0:18:13.69,0:18:15.03,Main,Sheep2,0,0,0,,...hareket etmiy...
Dialogue: 0,0:18:18.68,0:18:20.77,Main,Sheep,0,0,0,,Koşun!\NKoşmaya devam!
Dialogue: 0,0:18:20.77,0:18:22.98,Main,Sheepies,0,0,0,,Master!
Dialogue: 0,0:18:28.04,0:18:30.53,Main,Caesar,0,0,0,,Bu kadar işte, bu iş tamam!
Dialogue: 0,0:18:30.53,0:18:33.15,Main,Caesar,0,0,0,,Bu sefer kimseler kaçamayacak!
Dialogue: 0,0:18:33.15,0:18:34.94,Main,Caesar,0,0,0,,Olay budur!
Dialogue: 0,0:18:35.67,0:18:40.02,Main,Caesar,0,0,0,,Geçen deneyin asıl sorunu\Ngeride sağ kalanlar olmasıydı.
Dialogue: 0,0:18:41.06,0:18:44.15,Main,Caesar,0,0,0,,Zehir işe yarıyordu ama yine de biraz da olsa\Nhareket edebildikleri için kaçmayı başarmışlardı.
Dialogue: 0,0:18:44.15,0:18:45.66,Main,Caesar,0,0,0,,Ama!
Dialogue: 0,0:18:46.12,0:18:48.92,Main,Caesar,0,0,0,,Eğer onları durdurabilseydim\Nçok daha iyi sonuç verirdi!
Dialogue: 0,0:18:48.92,0:18:52.33,Main,Caesar,0,0,0,,Bu gaz aynı kül gibi\Ninsanın vücuduna yapışıyor.
Dialogue: 0,0:18:53.64,0:18:57.36,Main,Caesar,0,0,0,,Derilerinden içeri işleyip\Ntüm vücudu anında felç ediyor!
Dialogue: 0,0:19:01.16,0:19:05.09,Main,Caesar,0,0,0,,Karşınızda mükemmel kitle\Nimha silahım Shinokuni!
Dialogue: 0,0:19:05.68,0:19:10.46,Main,Caesar,0,0,0,,Bana daha fazlasını göster!\NBana nihai cehennem manzarasını göster!
Dialogue: 0,0:19:24.04,0:19:25.78,Main,Smoker,0,0,0,,Bu da ne?
Dialogue: 0,0:19:26.31,0:19:27.87,Main,Luffy,0,0,0,,İnsanlar...
Dialogue: 0,0:19:31.08,0:19:33.06,Main,Sheep,0,0,0,,Yardım edin!
Dialogue: 0,0:19:35.12,0:19:36.90,Main,Luffy,0,0,0,,...katılaşıyor!
Dialogue: 0,0:19:44.65,0:19:46.73,Main,Soldier,0,0,0,,Bu da ne böyle?!
Dialogue: 0,0:19:46.73,0:19:49.10,Main,Soldier,0,0,0,,Korku filmleri gibi aynı!
Dialogue: 0,0:19:49.10,0:19:52.95,Main,Soldier2,0,0,0,,Az önce ölenler\NCaesar'ın kendi adamlarına benziyordu...
Dialogue: 0,0:19:52.95,0:19:55.39,Main,Soldier,0,0,0,,Şu mor duman da\Nneyin nesiydi?
Dialogue: 0,0:19:57.19,0:20:00.91,Main,Soldier2,0,0,0,,Her şeyi geçtim de\Nnerede çekiyorlar bu görüntüleri böyle?
Dialogue: 0,0:20:00.91,0:20:03.72,Main,Soldier,0,0,0,,Arkanıza bakmasanız iyi olur.
Dialogue: 0,0:20:14.37,0:20:16.88,Main,Soldier,0,0,0,,Yok artık!\NBu adada mı oluyormuş?!
Dialogue: 0,0:20:17.33,0:20:19.25,Flashbacks,Sheep,0,0,0,,Master!
Dialogue: 0,0:20:22.48,0:20:26.05,Main,Soldier,0,0,0,,Sıçtık! Eğer kaçamazsak\Nsonumuz onlar gibi olur!
Dialogue: 0,0:20:26.05,0:20:30.33,Main,Soldier2,0,0,0,,Fark etmeyecek, bu adada\Nkaçabileceğimiz hiçbir yer yok!
Dialogue: 0,0:20:30.33,0:20:34.77,Main,Soldier,0,0,0,,Şimdi anlıyorum! Gaz içeri girmesin diye\Nlaboratuvarı kapattılar!
Dialogue: 0,0:20:37.75,0:20:40.20,Main,Soldier2,0,0,0,,Aç kapıyı, Caesar! Kahretsin!
Dialogue: 0,0:20:40.20,0:20:42.46,Main,Soldier2,0,0,0,,Burada bu şekilde ölmeyeceğim!
Dialogue: 0,0:20:42.46,0:20:44.81,Main,Soldier2,0,0,0,,Kahretsin! Kahretsin!\NŞakası yok bu işin!
Dialogue: 0,0:20:44.81,0:20:46.72,Main,Soldier2,0,0,0,,Aç şu kapıyı!
Dialogue: 0,0:20:58.61,0:21:01.05,Main,All,0,0,0,,Kaçın!
Dialogue: 0,0:21:04.59,0:21:06.98,Main,Sanji,0,0,0,,İşler pek iyi görünmüyor!
Dialogue: 0,0:21:09.29,0:21:11.06,Main,Zoro,0,0,0,,Millet, tüm gücünüzle koşun!
Dialogue: 0,0:21:11.06,0:21:12.74,Main,Zoro,0,0,0,,Yakalanacak olursanız durup kurtarmayız!
Dialogue: 0,0:21:19.26,0:21:22.02,Main,Brook,0,0,0,,Zoro-san, bu gidişle biz...
Dialogue: 0,0:21:27.31,0:21:29.54,Main,Brooke,0,0,0,,Saat 12 yönünde kimliği\Ntanımlanamayan nesne görüldü!
Dialogue: 0,0:21:29.54,0:21:31.43,Main,Sanji,0,0,0,,Bu da ne böyle?!
Dialogue: 0,0:21:31.43,0:21:32.78,Main,Zoro,0,0,0,,Bu şey...
Dialogue: 0,0:21:36.77,0:21:38.15,Main,Zoro,0,0,0,,...bir ejderha!
Dialogue: 0,0:21:38.15,0:21:39.47,Main,Brook+Sanji,0,0,0,,Ejderha mı?!
Dialogue: 0,0:21:39.47,0:21:40.79,Main,Kinemon,0,0,0,,Ejderha mı?!
Dialogue: 0,0:21:40.79,0:21:43.53,Main,Sanji,0,0,0,,Hadi oradan! Ejderhalar gerçek değildir!
Dialogue: 0,0:21:43.53,0:21:45.17,Main,Zoro,0,0,0,,Bu adada varlar işte!
Dialogue: 0,0:21:45.17,0:21:47.59,Main,Zoro,0,0,0,,Ama bu daha önce\Ngördüğümüzden çok daha küçük!
Dialogue: 0,0:21:47.59,0:21:50.91,Main,Zoro,0,0,0,,Belki onu yakalayıp uçup gidebiliriz!
Dialogue: 0,0:21:50.91,0:21:52.44,Main,Brook,0,0,0,,Harika bir fikir!
Dialogue: 0,0:21:52.44,0:21:54.52,Main,Sanji,0,0,0,,Pekâlâ öyleyse! \NSonsuza kadar koşamayız!
Dialogue: 0,0:21:54.52,0:21:55.80,Main,Sanji,0,0,0,,Yakalayalım şunu!
Dialogue: 0,0:21:55.80,0:21:59.02,Main,Sanji,0,0,0,,Bekle bakalım, ejderha!
Dialogue: 0,0:22:04.73,0:22:07.70,Main,Luffy,0,0,0,,Bunlar benim mürettebatım!\NDuman peşlerinde!
Dialogue: 0,0:22:07.70,0:22:10.61,Main,Sanji,0,0,0,,Ejderha!
Dialogue: 0,0:22:10.89,0:22:13.73,Main,Frankie,0,0,0,,Orada ne yapıyor bunlar?
Dialogue: 0,0:22:13.73,0:22:16.47,Main,Frankie,0,0,0,,Peki buna ne tür bir koşu diyorlar?
Dialogue: 0,0:22:16.47,0:22:19.11,Main,Robin,0,0,0,,Samuray-san sonunda\Ntek parça haline gelmiş.
Dialogue: 0,0:22:19.11,0:22:21.36,Main,Luffy,0,0,0,,Sahiden de öyle!
Dialogue: 0,0:22:21.36,0:22:23.80,Main,Luffy,0,0,0,,Artık öldürsen o bacakları vermez bana.
Dialogue: 0,0:22:23.80,0:22:26.17,Main,Luffy,0,0,0,,O değil de Robin,\Nasıl mevzu o değil şimdi!
Dialogue: 0,0:22:27.38,0:22:30.18,Main,Luffy,0,0,0,,Millet, o duman çok tehlikeli!
Dialogue: 0,0:22:30.18,0:22:32.05,Main,Luffy,0,0,0,,Kaçı...
Dialogue: 0,0:22:34.63,0:22:37.55,Main,Luffy,0,0,0,,Bu imkansız. Eğer bağırmaya çalışırsam...
Dialogue: 0,0:22:37.55,0:22:40.39,Main,Luffy,0,0,0,,Lanet olası deniz taşı.
Dialogue: 0,0:22:41.28,0:22:44.57,Main,Caesar,0,0,0,,Bunlar senin\Narkadaşların mı, Hasır Şapkalı Luffy?
Dialogue: 0,0:22:46.86,0:22:50.33,Main,Caesar,0,0,0,,Büyük Hasır Şapka Korsanları'ndan\Nbeklediğim gibi oldukça sağlamlar.
Dialogue: 0,0:22:52.41,0:22:56.35,Main,Caesar,0,0,0,,Ama gaz yüzünden ölmelerine\Nsadece birkaç saniye kaldı.
Dialogue: 0,0:22:59.50,0:23:01.90,Main,Caesar,0,0,0,,Ve bu adada hiçbir şey...
Dialogue: 0,0:23:01.90,0:23:05.23,Main,Caesar,0,0,0,,...yaşayamayacak hale gelene kadar\Nyayılmaya devam edecek. Bir ölüm adası!
Dialogue: 0,0:23:07.52,0:23:14.06,Main,Caesar,0,0,0,,Laboravurarın dışındaki hiç kimse\Nsağ kalmayacak.
Dialogue: 0,0:23:17.77,0:23:19.12,Main,Caesar,0,0,0,,Tabii...
Dialogue: 0,0:23:20.13,0:23:21.93,Main,Caesar,0,0,0,,...sizler de aynı şekilde!
Dialogue: 0,0:23:24.03,0:23:25.29,Main,Luffy,0,0,0,,Ne?!
Dialogue: 0,0:23:39.24,0:23:42.79,Main,Caesar,0,0,0,,Haydi, dünyaya gösterin bakalım!
Dialogue: 0,0:23:42.79,0:23:46.39,Main,Caesar,0,0,0,,Kitle imha silahı\NShinokuni'nin karşısında...
Dialogue: 0,0:23:46.76,0:23:48.96,Main,Caesar,0,0,0,,...400 milyonluk korsanın,...
Dialogue: 0,0:23:49.53,0:23:51.78,Main,Caesar,0,0,0,,...donanma koramiralinin...
Dialogue: 0,0:23:52.63,0:23:55.07,Main,Caesar,0,0,0,,...ve hatta bir Shichibukai'nin...
Dialogue: 0,0:23:56.23,0:24:01.89,Main,Caesar,0,0,0,,...bile hiçbir şansı yok, hepsi ölecek!
Dialogue: 0,0:24:10.57,0:24:12.69,Thoughts,Chopper,0,0,0,,Ne yapmalı?! Ne yapmalı şimdi?!
Dialogue: 0,0:24:12.69,0:24:14.41,Thoughts,Chopper,0,0,0,,Luffyler'e kötü şeyler olacak!
Dialogue: 0,0:24:14.41,0:24:16.00,Thoughts,Chopper,0,0,0,,Ne yapmalıyım?
Dialogue: 0,0:24:16.38,0:24:20.91,Thoughts,Chopper,0,0,0,,Yardım etmek istiyorum ama\Nbu yaralı halimle hemen yakalanırım!
Dialogue: 0,0:24:20.91,0:24:28.04,Thoughts,Chopper,0,0,0,,Yakalanırsam da ilacı araştırmak ve sakinleştiricileri\Nalmak için gösterdiğim tüm çaba boşa gidecek.
Dialogue: 0,0:24:28.04,0:24:31.60,Thoughts,Chopper,0,0,0,,Ne yapmalı?\NNe yapmalıyım?!
Dialogue: 0,0:24:39.29,0:24:41.24,Main,Chopper,0,0,0,,Az daha yakalanıyordum!
Dialogue: 0,0:24:41.24,0:24:42.75,Main,Chopper,0,0,0,,Ne? Kağıt mı?
Dialogue: 0,0:24:45.36,0:24:47.10,Main,Chopper,0,0,0,,"Hiçbir şey yapma!"
Dialogue: 0,0:24:47.84,0:24:48.88,Main,Chopper,0,0,0,,Bunu kim attı?
Dialogue: 0,0:24:52.33,0:24:54.00,Main,Soldier,0,0,0,,Yoksa bu...
Dialogue: 0,0:24:54.32,0:24:55.54,Main,Soldiers,0,0,0,,Smo-yan!
Dialogue: 0,0:24:55.54,0:24:56.54,Main,Soldiers,0,0,0,,Tashigi-chan!
Dialogue: 0,0:24:56.54,0:24:58.87,Main,Soldiers,0,0,0,,Şükürler olsun, iyisiniz!
Dialogue: 0,0:24:58.87,0:25:01.85,Main,Soldier,0,0,0,,Olamaz! Hepsi hâlâ esir!
Dialogue: 0,0:25:01.85,0:25:04.23,Main,Soldier2,0,0,0,,Lanet olsun, hepimiz öleceğiz!
Dialogue: 0,0:25:04.23,0:25:06.33,Main,Soldier,0,0,0,,Smo-yan!\NTashigi-chan!
Dialogue: 0,0:25:07.19,0:25:08.26,Main,Tashigi,0,0,0,,Millet?
Dialogue: 0,0:25:10.90,0:25:12.99,Main,Franky,0,0,0,,O değil de...
Dialogue: 0,0:25:15.31,0:25:18.85,Main,Franky,0,0,0,,...burası gerçekten\Niyi donanımlı bir laboratuvar.
Dialogue: 0,0:25:19.84,0:25:20.83,Main,Robin,0,0,0,,Öyle gerçekten de.
Dialogue: 0,0:25:22.16,0:25:25.92,Main,Robin,0,0,0,,Bu şeyle\Nçok devasa ekipmanlar taşınabilir.
Dialogue: 0,0:25:25.92,0:25:28.15,Main,Tashigi,0,0,0,,Böyle bir zamanda neden\Nböyle şeyleri konuşuyorsunuz?
Dialogue: 0,0:25:28.15,0:25:32.42,Main,Luffy,0,0,0,,Ne olursa olsun burada sıkışıp kaldık.
Dialogue: 0,0:25:33.66,0:25:36.67,Main,Law,0,0,0,,Vergo'yu burada görmeyi beklemiyordum.
Dialogue: 0,0:25:36.67,0:25:37.98,Main,Law,0,0,0,,Hasır Şapka,...
Dialogue: 0,0:25:39.55,0:25:43.80,Main,Law,0,0,0,,...burada oyalanacak zamanımız yok.
Dialogue: 0,0:25:44.09,0:25:46.19,Main,Law,0,0,0,,Plan hâlâ işliyor.
Dialogue: 0,0:25:46.19,0:25:48.27,Main,Law,0,0,0,,Şu andan itibaren işleri\Nberbat etmediğinizden emin olun.
Dialogue: 0,0:25:50.52,0:25:52.32,Main,Law,0,0,0,,Karşılık verme zamanımız geldi.
