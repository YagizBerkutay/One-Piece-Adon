.5,1.5,2,120,120,18,1Style: Sign,Futura Md BT,35.0,&H00FFFFFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.5,1.5,8,120,120,18,1Style: Attack,Duality,33.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.0,1.0,7,12,12,12,1Style: Author,Impress BT,19.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.5,0.5,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:10.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Knaryaa thx to onepace.netDialogue: 0,0:16:20.50,0:16:30.50,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Knaryaa thx to onepace.netDialogue: 0,0:29:14.80,0:29:17.60,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Knaryaa thx to onepace.netDialogue: 0,0:02:30.03,0:02:33.86,captionsşsoft,Text,0,0,0,,1 ve 2 Numaralı Laboratuvar HarabeleriDialogue: 0,0:02:29.87,0:02:33.86,Main,Chopper+Brook+Franky,0,0,0,,Master!Dialogue: 0,0:02:33.86,0:02:35.46,Main,Franky,0,0,0,,Her tarafımdan bir şeyler çıkıyor!Dialogue: 0,0:02:35.46,0:02:36.48,Main,Luffy,0,0,0,,Tüy yumağı!Dialogue: 0,0:02:36.48,0:02:38.25,Main,Chopper,0,0,0,,Bu Guard Point!Dialogue: 0,0:02:36.48,0:02:38.25,Note,Chopper,0,0,0,,Guard Point: Koruma NoktasıDialogue: 0,0:02:38.25,0:02:40.64,Main,Chopper,0,0,0,,Sadece aklında canlandırarak altı farklı form arasında özgürce geçiş yapabilirsin.Dialogue: 0,0:02:40.64,0:02:42.34,Main,Franky,0,0,0,,Bu beden pek stabil değil!Dialogue: 0,0:02:42.34,0:02:42.93,Main,Chopper,0,0,0,,Pratik yapman lazım!Dialogue: 0,0:02:42.93,0:02:46.02,Main,Franky,0,0,0,,Benimle oynamayın!Dialogue: 0,0:02:50.00,0:02:52.65,Main,Sanji,0,0,0,,Ne dedin?! Samuray gitti mi?!Dialogue: 0,0:02:52.65,0:02:53.47,Main,Brook,0,0,0,,Evet.Dialogue: 0,0:02:53.47,0:02:56.79,Main,Sanji,0,0,0,,Kahretsin! Ben de buranın neden bu kadar sessiz olduğunu düşünüyordum!Dialogue: 0,0:02:56.79,0:03:01.70,Main,Brook,0,0,0,,Kısa bir süre önce ona tanıştığım, gövdeden başka bir şey olmayan bir adamdan bahsettim.Dialogue: 0,0:03:01.70,0:03:03.93,Main,Brook,0,0,0,,Onunla nerede tanıştığımı bilmek istiyordu...Dialogue: 0,0:03:04.41,0:03:07.40,Main,Brook,0,0,0,,ve ona gölün yakınında yollarımızı ayırdığımızı söyledim.Dialogue: 0,0:03:07.40,0:03:08.61,Main,Brook,0,0,0,,Daha sonra koşmaya başladı.Dialogue: 0,0:03:09.54,0:03:13.91,Main,Sanji,0,0,0,,Nami-san'ın muhteşem vücudu dikkatimi dağıttı, bu yüzden gardımı indirdim!Dialogue: 0,0:03:13.91,0:03:15.64,Main,Brook,0,0,0,,Senin için sakıncalı olmasına rağmen mi?Dialogue: 0,0:03:17.64,0:03:21.28,Main,Sanji,0,0,0,,Hareket edemeyen bir kafa iken onu dışarı çıkaran...Dialogue: 0,0:03:22.23,0:03:23.46,Main,Sanji,0,0,0,,bendim.Dialogue: 0,0:03:24.97,0:03:27.66,Main,Sanji,0,0,0,,Gereksiz olabilirdi ama yapmam gereken buydu.Dialogue: 0,0:03:28.78,0:03:32.23,Main,Sanji,0,0,0,,Eğer ölürse bu benim suçum olur.Dialogue: 0,0:03:32.23,0:03:33.64,Main,Brook,0,0,0,,Anlıyorum.Dialogue: 0,0:03:33.64,0:03:39.05,Main,Brook,0,0,0,,Bir samuray olmasına rağmen kılıç tutacak bir gövdesi olmadığı için yapabileceği tek şey savaştan kaçmak.Dialogue: 0,0:03:41.68,0:03:44.47,Main,Brook,0,0,0,,Peki o zaman gidip yapmamız gerekeni yapalım mı?Dialogue: 0,0:03:44.47,0:03:47.22,Main,Sanji,0,0,0,,Kahrolası pislik.Dialogue: 0,0:03:47.76,0:03:50.67,Main,Sanji,0,0,0,,Luffy! Biraz dışarı çıkacağım, tamam mı??Dialogue: 0,0:03:50.67,0:03:51.88,Main,Luffy,0,0,0,,Tamam olur.Dialogue: 0,0:03:51.88,0:03:54.51,Main,Brook,0,0,0,,Tamamdır sana yolu göstereyim...Dialogue: 0,0:03:54.51,0:03:56.34,Main,Brook,0,0,0,,ama külotunu görebilir miyim?Dialogue: 0,0:03:56.34,0:03:57.85,Main,Sanji,0,0,0,,Tabii ki!Dialogue: 0,0:03:57.85,0:03:59.85,Main,Sanji,0,0,0,,Unutmadan! Böyle bir fırsatımız varken kameraya ihtiyacımız var!Dialogue: 0,0:03:59.85,0:04:01.88,Main,Nami,0,0,0,,Orada durun bakalım!Dialogue: 0,0:04:04.83,0:04:06.93,Main,Nami,0,0,0,,Zoro, sen de gidiyorsun.Dialogue: 0,0:04:06.93,0:04:07.64,Main,Zoro,0,0,0,,Ha?Dialogue: 0,0:04:08.78,0:04:13.93,Thoughts,Nami,0,0,0,,Eğer Zoro orada olursa, Sanji-kun sürekli savaş modunda olur!Dialogue: 0,0:04:13.93,0:04:21.25,Main,Zoro,0,0,0,,Sırf aptalsın diye neden o osuran samurayı aramam gerekiyor? Sapık herif!Dialogue: 0,0:04:21.25,0:04:23.40,Main,Sanji,0,0,0,,Zaten kimse seni burada istemiyor!Dialogue: 0,0:04:23.40,0:04:27.78,Main,Sanji,0,0,0,,Bu mutluluğu bile paylaşamadığım bir aptalla sıkışıp kaldığıma inanamıyorum!Dialogue: 0,0:04:28.70,0:04:32.78,Main,Brook,0,0,0,,Acımasızca vuruldum.  Kemiklerim kırılmış olabilir mi?Dialogue: 0,0:04:32.78,0:04:36.52,Main,Brook,0,0,0,,Hayır, kırılan tek şey o külotu görme hayalim.Dialogue: 0,0:04:36.52,0:04:37.02,Main,Sanji,0,0,0,,Aptal!Dialogue: 0,0:04:37.02,0:04:38.12,Main,Zoro,0,0,0,,Sapık!Dialogue: 0,0:04:39.29,0:04:42.62,Main,Usopp,0,0,0,,Peki bedenleriniz konusunda ne yapmalıyız?Dialogue: 0,0:04:42.62,0:04:46.18,Main,Nami,0,0,0,,Şimdi yapmamız gereken en önemli şey bedenlerimizi geri almak.Dialogue: 0,0:04:46.18,0:04:48.47,Main,Nami,0,0,0,,Bir milisaniye daha sapık olmak istemiyorum!Dialogue: 0,0:04:48.47,0:04:51.31,Main,Franky,0,0,0,,Övgüyle beni öldürmeye mi çalışıyorsun?Dialogue: 0,0:04:52.32,0:04:54.69,Main,Robin,0,0,0,,Lütfen Chopper'ın vücudunda öyle bir surat yapma.Dialogue: 0,0:04:55.35,0:04:56.23,Main,Robin,0,0,0,,Asla.Dialogue: 0,0:04:56.23,0:05:02.07,Main,Franky,0,0,0,,Asıl sorun o lanet çocuklar. Gerçekten baş belasılar.Dialogue: 0,0:05:02.83,0:05:07.72,Main,Robin,0,0,0,,Franky, o yüzle konuşmasan çok memnun olurum.Dialogue: 0,0:05:08.33,0:05:09.63,Main,Robin,0,0,0,,Asla.Dialogue: 0,0:05:09.63,0:05:11.37,Main,Sind,0,0,0,,Hayır!Dialogue: 0,0:05:14.38,0:05:16.48,Main,Sind,0,0,0,,İstediğim şey bu değil!Dialogue: 0,0:05:16.48,0:05:18.67,Main,Sind,0,0,0,,Rakun Köpeği-chan, nasıl görünüyor?Dialogue: 0,0:05:18.67,0:05:20.50,Main,Chopper,0,0,0,,Birazdan öğreneceğiz.Dialogue: 0,0:05:24.50,0:05:27.25,Thoughts,Chopper,0,0,0,,Ha! Bu demek oluyor ki...Dialogue: 0,0:05:28.98,0:05:32.61,Main,Kid,0,0,0,,Ne oldu, Sind? Canın mı yanıyor?Dialogue: 0,0:05:34.80,0:05:36.66,Main,Luffy,0,0,0,,İyi misin?Dialogue: 0,0:05:36.66,0:05:38.09,Main,Franky,0,0,0,,Ne oldu?!Dialogue: 0,0:05:40.22,0:05:42.15,Main,Sind,0,0,0,,Acıyor...Dialogue: 0,0:05:42.15,0:05:45.53,Main,Luffy,0,0,0,,Chopper. Acıdığını söylüyor.Dialogue: 0,0:05:45.53,0:05:47.04,Main,Luffy,0,0,0,,Onu iyileştir.Dialogue: 0,0:05:47.40,0:05:48.51,Main,Nami,0,0,0,,Mocha!Dialogue: 0,0:05:50.03,0:05:51.95,Main,Nami,0,0,0,,Hepinize neler oluyor böyle?Dialogue: 0,0:05:54.18,0:05:55.13,Main,Kid,0,0,0,,Doran da mı?Dialogue: 0,0:05:55.13,0:05:58.13,Main,Franky,0,0,0,,Bütün büyük çocuklar devriliyor!Dialogue: 0,0:05:58.13,0:05:59.00,Main,Luffy,0,0,0,,Ne oldu?Dialogue: 0,0:05:59.00,0:06:03.54,Main,Nami,0,0,0,,Chopper, neler oluyor? Çocuklar gerçekten hasta mı?Dialogue: 0,0:06:04.66,0:06:05.56,Main,Chopper,0,0,0,,Hayır.Dialogue: 0,0:06:06.31,0:06:09.10,Main,Chopper,0,0,0,,Sind, şu anda istediğin bir şey var mı?Dialogue: 0,0:06:10.32,0:06:12.57,Main,Chopper,0,0,0,,Genel olarak bu saatlerde ne yapardınız?Dialogue: 0,0:06:14.06,0:06:15.40,Main,Sind,0,0,0,,Genelde mi?Dialogue: 0,0:06:16.17,0:06:20.65,Main,Sind,0,0,0,,Kontrolden... sonra...Dialogue: 0,0:06:20.65,0:06:22.34,Main,Chopper,0,0,0,,Sonra ne?Dialogue: 0,0:06:24.23,0:06:26.90,Main,Sind,0,0,0,,Bize şeker verirler.Dialogue: 0,0:06:27.63,0:06:28.76,Main,Chopper,0,0,0,,Şeker mi?Dialogue: 0,0:06:28.76,0:06:30.51,Main,Kid,0,0,0,,Leziz.Dialogue: 0,0:06:30.51,0:06:33.49,Main,Kid2,0,0,0,,Herkes şekere bayılır.Dialogue: 0,0:06:33.49,0:06:36.79,Main,Kid,0,0,0,,Gerçekten çok iyi.Dialogue: 0,0:06:36.79,0:06:40.06,Main,Biyo,0,0,0,,Tatlı ve ağıza atınca gaz çıkıyor.Dialogue: 0,0:06:42.33,0:06:45.92,Main,Sind,0,0,0,,Bu doğru... Yedikten...Dialogue: 0,0:06:47.99,0:06:50.72,Main,Sind,0,0,0,,Yedikten sonra...Dialogue: 0,0:06:50.72,0:06:53.93,Main,Sind,0,0,0,,hepimiz mutlu oluyoruz.Dialogue: 0,0:06:55.28,0:06:56.94,Main,Sind,0,0,0,,Belki bu beni daha iyi hissettirebilir.Dialogue: 0,0:07:00.43,0:07:02.31,Main,Chopper,0,0,0,,Kahverengisakal değil mi?Dialogue: 0,0:07:03.09,0:07:05.10,Main,Chopper,0,0,0,,Bunun hakkında ne biliyorsun?Dialogue: 0,0:07:05.78,0:07:08.59,Main,Chopper,0,0,0,,Bu çocuklar hasta değil!Dialogue: 0,0:07:08.59,0:07:15.67,Main,Brownbeard,0,0,0,,Ne demek istiyorsun? Dışarıda devriye geziyorum, bu yüzden laboratuvarda neler olup bittiğini bilmiyorum...Dialogue: 0,0:07:15.67,0:07:18.68,Main,Brownbeard,0,0,0,,ama bu çocukların ciddi bir hastalığı var!Dialogue: 0,0:07:18.68,0:07:20.99,Main,Usopp,0,0,0,,Dayanın çocuklar.Dialogue: 0,0:07:20.99,0:07:22.35,Main,Franky,0,0,0,,Chopper.Dialogue: 0,0:07:22.35,0:07:24.96,Main,Franky,0,0,0,,Küçük olanların bile canları yanmaya başlamış gibi görünüyor.Dialogue: 0,0:07:24.96,0:07:29.49,Main,Brownbeard,0,0,0,,Her zaman şefkatli olan Master, bu çocukları bir araya getirmek için elinden geleni yaptı.Dialogue: 0,0:07:29.49,0:07:33.28,Main,Brownbeard,0,0,0,,ve tıbbi bilgisini onları tedavi etmek için kullanıyor.Dialogue: 0,0:07:33.28,0:07:35.38,Main,Brownbeard,0,0,0,,O, yufka yürekli bir bilim adamı!Dialogue: 0,0:07:35.38,0:07:36.65,Main,Ally,0,0,0,,Acıyor...Dialogue: 0,0:07:36.65,0:07:37.74,Main,Kid,0,0,0,,Ally?Dialogue: 0,0:07:39.34,0:07:40.51,Main,Brownbeard,0,0,0,,Bak işte bu kanıtı!Dialogue: 0,0:07:40.51,0:07:47.29,Main,Brownbeard,0,0,0,,Tek bir günlük tedaviyi kaçırdıktan sonra bu çocuklar çoktan acıdan bayılmaya başladılar.Dialogue: 0,0:07:47.29,0:07:48.37,Main,Chopper,0,0,0,,Hayır!Dialogue: 0,0:07:48.37,0:07:50.94,Main,Nami,0,0,0,,Chopper, ne öğrendin?Dialogue: 0,0:07:52.07,0:07:56.58,Main,Chopper,0,0,0,,NHC-10. Bu çocukların vücudunda bulduğum madde.Dialogue: 0,0:07:58.09,0:08:00.66,Main,Chopper,0,0,0,,Sadece hafif izler vardı ama...Dialogue: 0,0:08:01.91,0:08:04.10,Main,Chopper,0,0,0,,bir uyuşturucu!Dialogue: 0,0:08:05.32,0:08:06.75,Main,Nami,0,0,0,,Uyuşturucu mu?!Dialogue: 0,0:08:06.75,0:08:12.27,Main,Chopper,0,0,0,,Dünya çapında, seçilmiş ülkelerde yalnızca birkaç bilim insanının buna sahip olmasına izin veriliyor.Dialogue: 0,0:08:12.71,0:08:15.66,Main,Chopper,0,0,0,,Doctorine bunu kullandığı için biliyorum.Dialogue: 0,0:08:15.66,0:08:19.39,Main,Chopper,0,0,0,,İlacın bazı meşru kullanımları vardır, ancak yalnızca çok küçük miktarlarda.Dialogue: 0,0:08:19.39,0:08:23.14,Main,Chopper,0,0,0,,Çok fazla alınırsa son derece bağımlılık yapar.Dialogue: 0,0:08:24.24,0:08:30.38,Main,Chopper,0,0,0,,Çocuklar uzun süredir her gün bu ilacı kullanıyordu.Dialogue: 0,0:08:30.38,0:08:32.56,Main,Chopper,0,0,0,,Kronik olarak buna bağımlı hale geldiler.Dialogue: 0,0:08:33.28,0:08:38.32,Main,Chopper,0,0,0,,Acıyı durdurmak için vücutları bir sonraki dozu istiyor.Dialogue: 0,0:08:39.90,0:08:43.92,Main,Chopper,0,0,0,,Neden?! Neden bunu sistemlerinde bulundursunlar ki?Dialogue: 0,0:08:45.24,0:08:48.06,Main,Chopper,0,0,0,,Laboratuvardan kaçamasınlar diye öyle değil mi?!Dialogue: 0,0:08:48.06,0:08:54.61,Main,Chopper,0,0,0,,Sizin bu "kurtarıcı tanrınız" bu çocuklara ne yapıyor?Dialogue: 0,0:08:54.79,0:08:58.18,Main,Brownbeard,0,0,0,,Eğer Master hakkında kötü konuşursan,  bunun bedelini ödersin!Dialogue: 0,0:08:58.18,0:09:01.15,Main,Luffy,0,0,0,,Chopper, ne yapacağız? Hepsi birer birer yıkılıyor!Dialogue: 0,0:09:02.17,0:09:05.29,Main,Sind,0,0,0,,Şeker! Şeker!Dialogue: 0,0:09:05.29,0:09:09.17,Main,Luffy,0,0,0,,Şekere mi ihtiyacınız var? Binadan biraz almalı mıyım?Dialogue: 0,0:09:09.17,0:09:10.23,Main,Chopper,0,0,0,,Olmaz!Dialogue: 0,0:09:10.23,0:09:13.70,Main,Chopper,0,0,0,,Bir daha asla o şekeri yememeliler!Dialogue: 0,0:09:13.70,0:09:18.92,Main,Chopper,0,0,0,,Çocuklara bilmeden ilaç vermek için kullanıyorlar!Dialogue: 0,0:09:19.37,0:09:21.26,Main,Sind,0,0,0,,Hasır Şapkalı adam.Dialogue: 0,0:09:21.89,0:09:25.36,Main,Sind,0,0,0,,Bana şeker getirir misin?Dialogue: 0,0:09:25.36,0:09:29.01,Main,Luffy,0,0,0,,Yapamam. Chopper olamayacağını söylüyorsa, o zaman alamazsınız.Dialogue: 0,0:09:29.01,0:09:32.47,Main,Luffy,0,0,0,,O bizim doktorumuz. Ona güvenin!Dialogue: 0,0:09:32.47,0:09:34.10,Main,Sind,0,0,0,,Neden?Dialogue: 0,0:09:34.92,0:09:38.72,Main,Sind,0,0,0,,Neden? Neden?Dialogue: 0,0:09:41.31,0:09:42.97,Main,Kid,0,0,0,,Sind, ne oldu?Dialogue: 0,0:09:42.97,0:09:43.58,Main,Kid2,0,0,0,,Korkuyorum.Dialogue: 0,0:09:45.84,0:09:51.20,Main,Sind,0,0,0,,Bana biraz getireceğini söylemiştin!Dialogue: 0,0:09:55.63,0:10:02.43,Main,Sind,0,0,0,,Değil mi!? Bana biraz  getireceğini söylememiş miydin?!Dialogue: 0,0:10:06.04,0:10:07.93,Main,Robin,0,0,0,,Bu ne güç!Dialogue: 0,0:10:09.96,0:10:11.88,Main,Kid,0,0,0,,Dur, Sind!Dialogue: 0,0:10:11.88,0:10:14.78,Main,Kid2,0,0,0,,Sind'i daha önce hiç böyle görmemiştim.Dialogue: 0,0:10:18.69,0:10:20.05,Main,Franky,0,0,0,,Ne kadar güçlü!Dialogue: 0,0:10:20.61,0:10:23.70,Main,Usopp,0,0,0,,Devler oldukça güçlü, sanırım çocukları da öyle.Dialogue: 0,0:10:23.70,0:10:24.77,Main,Franky,0,0,0,,Gücü bu kadar mı?Dialogue: 0,0:10:24.77,0:10:26.82,Main,Sind,0,0,0,,Neden bana şeker vermiyorsunuz?!Dialogue: 0,0:10:27.99,0:10:31.15,Main,Ally,0,0,0,,Sind dev değil!Dialogue: 0,0:10:31.15,0:10:35.81,Main,Kid,0,0,0,,Bu adaya geldiğimizde hepimiz normal büyüklükteydik.Dialogue: 0,0:10:35.81,0:10:38.67,Main,Kid,0,0,0,,Hastalığın bizi büyüttüğünü sanıyordum.Dialogue: 0,0:10:38.67,0:10:41.06,Main,Kid,0,0,0,,Başka bir sorunumuz yok.Dialogue: 0,0:10:41.64,0:10:46.55,Main,Chopper,0,0,0,,Normal insanları devlere dönüştüren hiçbir hastalık yok.Dialogue: 0,0:10:46.55,0:10:48.72,Main,Chopper,0,0,0,,Devler en başından beri devdir.Dialogue: 0,0:10:48.72,0:10:53.74,Main,Kid,0,0,0,,Bir çocuk burada ne kadar uzun süre kalırsa, o kadar büyüyor.Dialogue: 0,0:10:55.36,0:10:56.20,Main,Chopper,0,0,0,,Bu demek oluyor ki...Dialogue: 0,0:10:57.34,0:11:02.54,Main,Chopper,0,0,0,,hipofiz bezleri anormal miktarda büyüme hormonu üretmeye başladı.Dialogue: 0,0:10:57.34,0:11:02.54,Note,Chopper,0,0,0,,Hipofiz Bezi: Beynin alt kısmında yer alan vücudun hormonlarını yöneten bezlerdir.Dialogue: 0,0:11:03.36,0:11:05.73,Main,Kids,0,0,0,,Şeker!Dialogue: 0,0:11:06.54,0:11:08.17,Main,Chopper,0,0,0,,Bu çocukların...Dialogue: 0,0:11:09.91,0:11:11.68,Main,Chopper,0,0,0,,üzerinde deneyler yapılıyor!Dialogue: 0,0:11:11.68,0:11:13.29,Main,Ally,0,0,0,,Şeker!Dialogue: 0,0:11:15.11,0:11:16.93,Main,Chopper,0,0,0,,Kendine gel, Ally!Dialogue: 0,0:11:16.93,0:11:18.52,Main,Ally,0,0,0,,Şeker istiyorum!Dialogue: 0,0:11:23.58,0:11:27.49,Main,Chopper,0,0,0,,Bu kadar küçük çocuklara,Dialogue: 0,0:11:27.49,0:11:31.43,Main,Chopper,0,0,0,,uyuşturucu veren bu "Master" ne düşünüyor?!Dialogue: 0,0:11:31.43,0:11:32.52,Main,Kids,0,0,0,,Şeker!Dialogue: 0,0:11:33.39,0:11:35.39,Main,Franky,0,0,0,,Diğer çocuklar da çıldırmaya başlıyor!Dialogue: 0,0:11:38.10,0:11:42.40,Main,Kids,0,0,0,,Şeker! Şeker! Şeker!Dialogue: 0,0:11:42.40,0:11:44.45,Main,Robin,0,0,0,,Yapabileceğimiz bir şey yok.Dialogue: 0,0:11:48.59,0:11:49.77,Main,Usopp+Franky,0,0,0,,Nami!Dialogue: 0,0:11:52.79,0:11:54.83,Main,Chopper,0,0,0,,Sind! Yeter artık!Dialogue: 0,0:11:54.83,0:11:56.08,Main,Luffy,0,0,0,,Onlarla savaşmalı mıyım?Dialogue: 0,0:11:56.08,0:11:59.04,Main,Usopp,0,0,0,,Hayır! Önümden çekil, Luffy!Dialogue: 0,0:11:59.04,0:12:00.92,Main,Nami,0,0,0,,Usopp! Onlara zarar verme!Dialogue: 0,0:12:00.92,0:12:03.87,Main,Usopp,0,0,0,,Aptal! Tabii ki biliyorum!Dialogue: 0,0:12:04.20,0:12:06.60,Attack,Usopp,0,0,0,,Patlama Uyku YıldızıDialogue: 0,0:12:19.77,0:12:23.64,Main,Nami,0,0,0,,Kaçırılmış olduklarını biliyordum.Dialogue: 0,0:12:23.65,0:12:25.90,Flashbacks,Nami,0,0,0,,Bizi buradan kurtarın!Dialogue: 0,0:12:25.90,0:12:29.65,Flashbacks,Nami,0,0,0,,Annemi ve Babamı görmek istiyorum!Dialogue: 0,0:12:32.65,0:12:33.30,Main,Chopper,0,0,0,,Luffy.Dialogue: 0,0:12:35.12,0:12:43.73,Main,Chopper,0,0,0,,Bu trajik. Manipüle edildiklerinin farkında bile değiller.Dialogue: 0,0:12:43.73,0:12:47.19,Main,Chopper,0,0,0,,Eve gitmek istiyorlar! Ebeveynlerinin yanında olmak istiyorlar!Dialogue: 0,0:12:47.19,0:12:48.94,Main,Chopper,0,0,0,,Onlara yardım etmemiz gerek!Dialogue: 0,0:12:48.94,0:12:53.02,Main,Nami,0,0,0,,Luffy, ben de onları kurtarmak istiyorum.Dialogue: 0,0:12:53.02,0:12:57.32,Main,Luffy,0,0,0,,O halde sanırım hepsini eve götüreceğiz.Dialogue: 0,0:12:57.32,0:13:01.53,Main,Franky,0,0,0,,Aptal, o kadar kolay değil. Bir sürü sorunumuz var!Dialogue: 0,0:13:01.53,0:13:06.14,Main,Robin,0,0,0,,Bu doğru. Üstelik bunların hepsi bizim düşüncemiz.Dialogue: 0,0:13:06.14,0:13:09.75,Main,Robin,0,0,0,,Doğrudan elebaşlarına sormazsak bunların hiçbirini kesin olarak bilemeyeceğiz.Dialogue: 0,0:13:09.75,0:13:11.84,Main,Luffy,0,0,0,,Master dedikleri adam değil mi?Dialogue: 0,0:13:12.57,0:13:17.64,Main,Luffy,0,0,0,,Ama Zoro, Sanji ve Brook samurayı aramaya gittiler.Dialogue: 0,0:13:17.64,0:13:21.13,Main,Luffy,0,0,0,,Her neyse.Dialogue: 0,0:13:21.13,0:13:25.25,Main,Luffy,0,0,0,,Tamamdır! Master'ı bulmak için...Dialogue: 0,0:13:25.25,0:13:26.47,Main,Luffy,0,0,0,,laboratuvara geri dönelim.Dialogue: 0,0:13:27.09,0:13:28.93,Main,Chopper,0,0,0,,Burada kalmalıyım.Dialogue: 0,0:13:29.50,0:13:34.49,Main,Chopper,0,0,0,,Master'ı asla affedemem...Dialogue: 0,0:13:34.49,0:13:36.38,Main,Chopper,0,0,0,,ve onu pataklamak istiyorum...Dialogue: 0,0:13:37.84,0:13:41.14,Main,Chopper,0,0,0,,ama çocuklar için endişeliyim.Dialogue: 0,0:13:41.14,0:13:42.22,Main,Chopper,0,0,0,,Onlara bakmalıyım.Dialogue: 0,0:13:42.22,0:13:45.35,Main,Nami,0,0,0,,E-Evet! Bu doğru! Benim de kalmam gerekecek!Dialogue: 0,0:13:45.35,0:13:48.31,Main,Usopp,0,0,0,,Nami! Bu kirli bir numara! Sadece korktun!Dialogue: 0,0:13:48.31,0:13:52.94,Main,Luffy,0,0,0,,Ama eğer çocuklar tekrar şiddete başvurursa çok kötü olur.Dialogue: 0,0:13:56.97,0:13:59.60,Main,Luffy,0,0,0,,Büyükleri bu şekilde bağlayacağız.Dialogue: 0,0:13:59.60,0:14:01.43,Main,Nami,0,0,0,,Bu hoşuma gitmedi ama...Dialogue: 0,0:14:01.43,0:14:04.54,Main,Franky,0,0,0,,Yapacak bir şey yok. Şiddete başvurduklarında zorluk çıkartırlar.Dialogue: 0,0:14:04.54,0:14:07.32,Main,Usopp,0,0,0,,Ve ne zaman uyanacaklarını bilmiyoruz.Dialogue: 0,0:14:07.32,0:14:09.94,Main,Franky,0,0,0,,Peki kim nereye gidecek?Dialogue: 0,0:14:09.94,0:14:16.09,Main,Franky,0,0,0,,Dördümüz bir araya gelip Trafalgar'la buluşmalıyız.Dialogue: 0,0:14:16.09,0:14:17.77,Main,Franky,0,0,0,,yoksa bedenlerimize geri dönemeyiz.Dialogue: 0,0:14:17.77,0:14:19.97,Main,Luffy,0,0,0,,Ama bu haliyle gayet iyi!Dialogue: 0,0:14:19.97,0:14:22.75,Main,Nami,0,0,0,,Bu kesinlikle iyi değil! Ciddiye al!Dialogue: 0,0:14:34.33,0:14:39.36,Main,Caesar,0,0,0,,Denizci Birimi G-5 Koramirali Smoker'ın kalbi.Dialogue: 0,0:14:40.03,0:14:43.49,Main,Caesar,0,0,0,,Ne kadar düşünceli bir hediye, Law.Dialogue: 0,0:14:44.12,0:14:46.45,Main,Caesar,0,0,0,,Bu savaşı kimin kazandığına hiç şüphe yok.Dialogue: 0,0:14:55.29,0:15:02.16,Main,Caesar,0,0,0,,Olanları bildirmek isteyecekler ve gemilerini kaybettikleri için bizimkilerden birini almaya gelecekler.Dialogue: 0,0:15:02.16,0:15:05.06,Main,Caesar,0,0,0,,Tabii ki, çoktan ayarlamaları yaptım.Dialogue: 0,0:15:08.09,0:15:10.27,Main,Law,0,0,0,,Peki ya Hasır Şapka-ya?Dialogue: 0,0:15:10.27,0:15:12.14,Main,Caesar,0,0,0,,O da sorun değil.Dialogue: 0,0:15:12.14,0:15:16.02,Main,Caesar,0,0,0,,Tayfayla ilgileniliyor ve çocuklar geri getirilecek.Dialogue: 0,0:15:16.02,0:15:23.49,Main,Caesar,0,0,0,,Çocuklar yalnız kalsalar bile eninde sonunda geri gelmek isteyeceklerdir.Dialogue: 0,0:15:24.86,0:15:29.82,Main,Caesar,0,0,0,,Monet, Hasır Şapka Korsanları'yla uğraşırken dikkatli olmamız gerektiğini söylüyor.Dialogue: 0,0:15:30.50,0:15:34.51,Main,Caesar,0,0,0,,Bu yüzden ikiliyi onların peşinden göndermeyi seçtim.Dialogue: 0,0:15:34.86,0:15:38.05,Main,Caesar,0,0,0,,Hedeflerini asla kaçırmayan ikili.Dialogue: 0,0:15:38.86,0:15:41.14,Main,Caesar,0,0,0,,Dağın kiralık katilleri.Dialogue: 0,0:15:44.00,0:15:49.57,Main,Caesar,0,0,0,,Havalı Yeti Kardeşler.Dialogue: 0,0:15:51.72,0:15:53.57,Main,Rock,0,0,0,,Son altı kaldı.Dialogue: 0,0:15:54.75,0:15:58.26,Main,Scotch,0,0,0,,Başımıza daha fazla bela açacaklarını düşünmüştüm...Dialogue: 0,0:15:59.00,0:16:01.41,Main,Scotch,0,0,0,,ama bunu bir an önce bitirmek muhtemelen en iyisi olur.Dialogue: 0,0:16:03.24,0:16:06.85,Main,Scotch,0,0,0,,Tıpkı bu üçü gibi...Dialogue: 0,0:16:08.81,0:16:10.76,Main,Scotch,0,0,0,,Havalı bir şekilde.Dialogue: 0,0:16:28.17,0:16:32.67,Main,Rock,0,0,0,,Benim. Şimdiden üçünün icabına baktık.Dialogue: 0,0:16:34.07,0:16:36.35,Main,Rock,0,0,0,,Korsan Avcısı Zoro.Dialogue: 0,0:16:36.35,0:16:38.27,Main,Rock,0,0,0,,Kedi Hırsız.Dialogue: 0,0:16:38.87,0:16:41.20,Main,Rock,0,0,0,,Ruh Kralı.Dialogue: 0,0:16:41.20,0:16:46.24,Main,Rock,0,0,0,,Cesetlerini F-16 bölgesindeki bir uçurumun dibinde bulacaksınız.Dialogue: 0,0:16:46.24,0:16:47.85,Main,Rock,0,0,0,,Temizliği size bırakıyoruz.Dialogue: 0,0:16:47.85,0:16:49.81,Main,Voice,0,0,0,,Onları öldürdünüz mü?Dialogue: 0,0:16:49.81,0:16:51.28,Main,Scotch,0,0,0,,O yüzden burada değil miyiz?Dialogue: 0,0:16:51.28,0:16:53.03,Main,Voice,0,0,0,,Şey... sanırım...Dialogue: 0,0:16:53.03,0:16:57.20,Main,Scotch,0,0,0,,İnsanların ölmesini istemiyorsanız  o zaman bizi aramayın!Dialogue: 0,0:16:57.20,0:17:00.73,Main,Voice,0,0,0,,Üzgünüm! Master her iki sonuca da olur dedi...Dialogue: 0,0:17:00.73,0:17:03.85,Main,Rock,0,0,0,,Tamam tamam! Hemen karalara bağlama!Dialogue: 0,0:17:03.85,0:17:06.60,Main,Scotch,0,0,0,,Ups, kaydım.Dialogue: 0,0:17:07.89,0:17:10.06,Main,Rock,0,0,0,,Hadi havalı bir şekilde gidelim.Dialogue: 0,0:17:10.06,0:17:11.99,Main,Voice,0,0,0,,Lütfen sözleşmeye devam edin.Dialogue: 0,0:17:12.90,0:17:16.92,captionsşsoft,Text,0,0,0,,Caesar Clown'nın LaboratuvarıDialogue: 0,0:17:18.67,0:17:22.76,Main,Caesar,0,0,0,,Bunu duydun mu? Çoktan öldüler, Monet.Dialogue: 0,0:17:22.76,0:17:23.73,Main,Monet,0,0,0,,Anlıyorum.Dialogue: 0,0:17:24.41,0:17:25.84,Main,Monet,0,0,0,,Ne kadar beklenmedik.Dialogue: 0,0:17:26.51,0:17:31.29,Main,Monet,0,0,0,,Hasır Şapka Korsanları da Law gibi En Kötü Nesil'in üyeleridir.Dialogue: 0,0:17:31.29,0:17:34.76,Main,Monet,0,0,0,,Hükümet Karasakal'ı olduğu kadar onları da yakından izliyor.Dialogue: 0,0:17:34.76,0:17:39.53,Main,Monet,0,0,0,,Gazeteler tamamen iyileştiklerine dair büyük iddialarda bulundu,Dialogue: 0,0:17:39.53,0:17:42.38,Main,Monet,0,0,0,,bu yüzden daha etkileyici olacaklarını düşündüm.Dialogue: 0,0:17:42.38,0:17:43.45,Main,Monet,0,0,0,,Değil mi Law?Dialogue: 0,0:17:44.59,0:17:46.42,Main,Monet,0,0,0,,Onları tanıyorsun, değil mi?Dialogue: 0,0:17:47.32,0:17:52.03,Main,Monet,0,0,0,,İki yıl önce Sabaody'de ve yine Marineford'da...Dialogue: 0,0:17:52.03,0:17:55.75,Main,Monet,0,0,0,,Hasır Şapka'yla iki kez karşılaştın.Dialogue: 0,0:17:55.75,0:17:57.00,Main,Caesar,0,0,0,,Ne?Dialogue: 0,0:18:03.12,0:18:06.29,Main,Caesar,0,0,0,,Bu onları buraya çağırdığınız anlamına mı geliyor?Dialogue: 0,0:18:06.29,0:18:08.88,Main,Law,0,0,0,,Bunu sana zaten söylememiş miydim?Dialogue: 0,0:18:08.88,0:18:13.67,Main,Law,0,0,0,,Girişte yollarımız kesişene kadar onları laboratuvara kilitlediğinizden haberim yoktu.Dialogue: 0,0:18:14.60,0:18:17.93,Main,Law,0,0,0,,Bilseydim seni uyarırdım.Dialogue: 0,0:18:17.93,0:18:20.45,Main,Law,0,0,0,,Onları bir odaya kilitlediğiniz için gardınızı düşürmeyin diye.Dialogue: 0,0:18:23.24,0:18:28.88,Main,Law,0,0,0,,Senin saflığın yüzünden Denizcilerin gitmesi için blöf yapamadım.Dialogue: 0,0:18:28.88,0:18:33.40,Main,Law,0,0,0,,Burada olup bitenlerin dışarı sızmasını senin kadar ben de istemiyorum.Dialogue: 0,0:18:35.03,0:18:36.18,Flashbacks,Gasmask,0,0,0,,Master!Dialogue: 0,0:18:36.18,0:18:38.37,Flashbacks,Caesar,0,0,0,,Bir deney yapıyorum. Sonra ara.Dialogue: 0,0:18:38.37,0:18:40.25,Flashbacks,Gasmask,0,0,0,,Ama bir Shichibukai burada!Dialogue: 0,0:18:42.51,0:18:43.86,Flashbacks,Caesar,0,0,0,,Ne?Dialogue: 0,0:18:45.18,0:18:47.69,Flashbacks,Caesar,0,0,0,,Punk Hazard'da mı kalacaksın?Dialogue: 0,0:18:47.69,0:18:51.35,Flashbacks,Law,0,0,0,,Bu adaya pusula ile ulaşılamadığı için çok fazla çaba gerektirdi.Dialogue: 0,0:18:51.35,0:18:54.05,Flashbacks,Law,0,0,0,,Hükümet'in gizli bir tesisi olduğu için buraya geldim.Dialogue: 0,0:18:54.05,0:18:56.18,Flashbacks,Caesar,0,0,0,,Amacın ne?Dialogue: 0,0:18:56.18,0:19:00.04,Flashbacks,Law,0,0,0,,Dr. Vegapunk daha önce bu laboratuvarı kullandığından,Dialogue: 0,0:19:00.04,0:19:03.24,Flashbacks,Law,0,0,0,,Dünya Hükümeti'nin neyin peşinde olduğuna dair bir kanıt olmalı.Dialogue: 0,0:19:03.66,0:19:08.24,Flashbacks,Law,0,0,0,,Yani bugün üzerinde çalıştıkları projelerin burada başlaması gerekiyordu.Dialogue: 0,0:19:08.24,0:19:14.00,Flashbacks,Law,0,0,0,,Yani, adada ve laboratuvarda özgürce dolaşabildiğim sürece bu yeterli olacaktır.Dialogue: 0,0:19:15.69,0:19:18.79,Flashbacks,Law,0,0,0,,Ben de sana bu konuda yardımcı olabilirim.Dialogue: 0,0:19:18.79,0:19:24.73,Flashbacks,Law,0,0,0,,Hiçbirimizin diğerinin işine karışmasına gerek yok.  Tabii ki burada olduğumu kimseye söyleme.Dialogue: 0,0:19:25.76,0:19:27.59,Flashbacks,Law,0,0,0,,Joker'a bile.Dialogue: 0,0:19:30.72,0:19:34.22,Flashbacks,Caesar,0,0,0,,Çok iyi bilgilendirilmiş görünüyorsun! Onun hakkında ne biliyorsun?Dialogue: 0,0:19:34.22,0:19:38.99,Flashbacks,Law,0,0,0,,Ne yaptığını bilmeyen cahil bir aptal olmamı mı tercih ederdin?Dialogue: 0,0:19:41.20,0:19:44.65,Flashbacks,Caesar,0,0,0,,Anladım, ikimiz de aynı değil miyiz?Dialogue: 0,0:19:44.65,0:19:47.79,Flashbacks,Caesar,0,0,0,,Birbirimize güvenemeyiz ama teklifin zararsız görünüyor.Dialogue: 0,0:19:47.79,0:19:49.37,Flashbacks,Caesar,0,0,0,,Öyle değil mi, Monet?Dialogue: 0,0:19:51.60,0:19:55.33,Flashbacks,Monet,0,0,0,,Kuzey Mavi'nin Ölüm Cerrahı.Dialogue: 0,0:19:55.93,0:19:59.76,Flashbacks,Monet,0,0,0,,Ope Ope Meyvesinin yeteneğine sahipsin.  Doktor olduğunu görüyorum.Dialogue: 0,0:20:00.80,0:20:06.58,Flashbacks,Monet,0,0,0,,Bu adada zehirli gaz yüzünden bacaklarını kaybetmiş çok sayıda eski mahkum var.Dialogue: 0,0:20:07.79,0:20:09.09,Flashbacks,Monet,0,0,0,,Onlara yardım edebilir misin?Dialogue: 0,0:20:13.25,0:20:18.47,Main,Caesar,0,0,0,,Eğer gerçekten yardım isteseydin sanırım bu konuda daha akıllı olurdun.Dialogue: 0,0:20:18.47,0:20:23.92,Main,Caesar,0,0,0,,Kendini Hükümet'e sevdirmek ve bir Shichibukai olmak için tüm çabayı gösterdin.Dialogue: 0,0:20:23.92,0:20:28.03,Main,Caesar,0,0,0,,yani sanırım bu adayı açığa çıkarmaya çalışmazsın.Dialogue: 0,0:20:28.03,0:20:29.87,Main,Caesar,0,0,0,,Özür dilerim.Dialogue: 0,0:20:29.87,0:20:30.78,Main,Law,0,0,0,,Biraz önce...Dialogue: 0,0:20:31.32,0:20:36.54,Main,Law,0,0,0,,Çocuklar yalnız kaldığında  Bisküvi Odası'na geri geleceklerini söylemiştin.Dialogue: 0,0:20:36.54,0:20:38.15,Main,Law,0,0,0,,Bununla ne demek istedin?Dialogue: 0,0:20:40.56,0:20:44.21,Main,Caesar,0,0,0,,Her gün onlara uyuşturucu katılmış şeker veriyorum.Dialogue: 0,0:20:44.21,0:20:48.15,Main,Caesar,0,0,0,,Tadı tatlıdır veDialogue: 0,0:20:48.15,0:20:50.82,Main,Caesar,0,0,0,,ağza sarhoş edici bir gaz salar.Dialogue: 0,0:20:51.62,0:20:53.80,Main,Caesar,0,0,0,,Hepsi buna bağımlı.Dialogue: 0,0:20:53.80,0:20:57.84,Main,Caesar,0,0,0,,Sonuçta onların eve dönmelerine izin veremem.Dialogue: 0,0:20:58.67,0:21:02.39,Main,Law,0,0,0,,Sen tam bir çılgınsın. Bana birini hatırlatıyorsun.Dialogue: 0,0:21:05.81,0:21:08.89,Main,Monet,0,0,0,,Denizcilerle savaşa katılmayacak mısın?Dialogue: 0,0:21:08.89,0:21:10.71,Main,Law,0,0,0,,Bana ihtiyacın olursa ara beni.Dialogue: 0,0:21:11.63,0:21:13.49,Main,Law,0,0,0,,İhtiyacın olduğunda herkesin kafasını keserim.Dialogue: 0,0:21:13.82,0:21:17.44,Main,Caesar,0,0,0,,Bu kadar zeki insanlarla baş etmek zor.Dialogue: 0,0:21:21.74,0:21:24.15,Main,Nami,0,0,0,,İşte yine oluyor! Neler oluyor?!Dialogue: 0,0:21:24.15,0:21:27.01,Main,Chopper,0,0,0,,Bu bir deprem değil.Dialogue: 0,0:21:27.01,0:21:29.15,Main,Chopper,0,0,0,,Saldırı altında mıyız? Bu bir düşman!Dialogue: 0,0:21:38.56,0:21:40.44,Main,Usopp,0,0,0,,Bu bir patlama mıydı?Dialogue: 0,0:21:40.44,0:21:43.00,Main,Robin,0,0,0,,Geldiğimiz yönde.Dialogue: 0,0:21:43.00,0:21:45.97,Main,Franky,0,0,0,,Bu ayak izini yapan kişiyle bir ilgisi olabilir mi?Dialogue: 0,0:21:49.25,0:21:51.62,Main,Luffy,0,0,0,,Dışarıda kesin bir şey var.Dialogue: 0,0:21:51.62,0:21:53.98,Main,Luffy,0,0,0,,Canavar gibi hissettiriyorlar. İki kişiler!Dialogue: 0,0:21:53.98,0:21:56.47,Main,Luffy,0,0,0,,Hadi geri dönelim! Nami ve Chopper'ın başı dertte!Dialogue: 0,0:21:56.47,0:21:57.53,Main,Usopp,0,0,0,,O-Olur!Dialogue: 0,0:22:02.50,0:22:07.01,Main,Chopper,0,0,0,,Hayır! Eğer burası çökerse çocuklar...Dialogue: 0,0:22:07.01,0:22:10.32,Main,Nami,0,0,0,,Luffy! Geri gel!Dialogue: 0,0:22:10.32,0:22:13.75,Main,Chopper,0,0,0,,Asla zamanında yetişemeyecekler! Bu konuyla ikimiz ilgilenmeliyiz!Dialogue: 0,0:22:24.50,0:22:26.44,Main,Nami,0,0,0,,Onları görebiliyor musun, Chopper?Dialogue: 0,0:22:26.44,0:22:28.55,Main,Nami,0,0,0,,Kaç düşman var? Neye benziyorlar?Dialogue: 0,0:22:29.29,0:22:30.23,Main,Chopper,0,0,0,,Burada...Dialogue: 0,0:22:34.56,0:22:36.89,Main,Chopper,0,0,0,,kimse yok!Dialogue: 0,0:22:36.89,0:22:38.31,Main,Nami,0,0,0,,Bu mümkün değil.Dialogue: 0,0:22:39.60,0:22:41.35,Main,Brownbeard,0,0,0,,Acıdı, acıdı...Dialogue: 0,0:22:41.35,0:22:43.24,Main,Brownbeard,0,0,0,,Yorgun hissediyorum.Dialogue: 0,0:22:44.41,0:22:49.50,Main,Brownbeard,0,0,0,,Dışarısı gürültülü olmaya başladı. Beni kurtaracak biri mi var burada?Dialogue: 0,0:22:49.50,0:22:52.25,Main,Brownbeard,0,0,0,,Law? Master?Dialogue: 0,0:22:52.25,0:22:54.39,Main,Brownbeard,0,0,0,,Hayır, burası karlı dağ...Dialogue: 0,0:22:54.39,0:22:55.85,Main,Brownbeard,0,0,0,,yani onlar olmalı!Dialogue: 0,0:22:56.80,0:23:01.32,Main,Nami,0,0,0,,Baksana Kahve! Bir şey biliyorsun.Dialogue: 0,0:23:01.32,0:23:02.83,Main,Nami,0,0,0,,Kim geliyor?Dialogue: 0,0:23:02.83,0:23:04.71,Main,Nami,0,0,0,,Cevap versen iyi olur, yoksa bunu yapacağım!Dialogue: 0,0:23:05.93,0:23:06.97,Main,Nami,0,0,0,,Lazer!Dialogue: 0,0:23:07.83,0:23:09.36,Main,Nami,0,0,0,,Lazer! Lazer! Lazer! Lazer!Dialogue: 0,0:23:09.36,0:23:10.74,Main,Nami,0,0,0,,Lazer! Lazer! Lazer! Lazer!Dialogue: 0,0:23:10.74,0:23:11.86,Main,Nami,0,0,0,,Lazer! Lazer! Lazer! Lazer!Dialogue: 0,0:23:11.86,0:23:12.80,Main,Nami,0,0,0,,Lazer! Lazer! Lazer! Lazer!Dialogue: 0,0:23:12.80,0:23:15.32,Main,Chopper,0,0,0,,Lazere saygısızlık ediyorsun!Dialogue: 0,0:23:16.15,0:23:20.95,Main,Brownbeard,0,0,0,,Onları aramak anlamsız. Asla kendilerini göstermezler.Dialogue: 0,0:23:20.95,0:23:23.30,Main,Brownbeard,0,0,0,,Yüzlerinin neye benzediğini biz bile bilmiyoruz.Dialogue: 0,0:23:24.28,0:23:30.09,Main,Brownbeard,0,0,0,,Ama onları bir kez işe alıp paralarını verdiğinizde, her zaman işi bitirirler.Dialogue: 0,0:23:30.96,0:23:36.92,Main,Brownbeard,0,0,0,,Onlar hakkında bildiğimiz tek şey ayaklarının kocaman olduğu ama seslerinin sessiz olduğu.Dialogue: 0,0:23:36.92,0:23:44.56,Main,Brownbeard,0,0,0,,Bildiğimiz başka bir şey de onların kürkle kaplı dev canavar adamlar olduğu!Dialogue: 0,0:23:44.56,0:23:50.02,Main,Brownbeard,0,0,0,,Onlar dağda kar fırtınasında ortaya çıkan tetikçi ikilisi.Dialogue: 0,0:23:50.02,0:23:54.87,Main,Brownbeard,0,0,0,,Ah evet, isimlerini de biliyoruz, Rock ve Scotch.Dialogue: 0,0:23:54.87,0:23:55.90,Main,Brownbeard,0,0,0,,İnsanlar onlara...Dialogue: 0,0:23:55.90,0:23:58.50,Main,Brownbeard,0,0,0,,Havalı Yeti Kardeşler der!Dialogue: 0,0:23:58.50,0:24:01.69,Main,Brownbeard,0,0,0,,Adı açıklanmayan karlı bir ülkede doğmuşlar ve yaşları-Dialogue: 0,0:24:01.69,0:24:03.91,Main,Nami,0,0,0,,Onlar hakkında bir sürü şey biliyorsun!Dialogue: 0,0:24:03.91,0:24:06.62,Main,Brownbeard,0,0,0,,Ama kimse neye benzediklerini bilmiyor.Dialogue: 0,0:24:06.62,0:24:08.58,Main,Brownbeard,0,0,0,,İkisi de devasa ve güçlüler!Dialogue: 0,0:24:09.11,0:24:11.18,Main,Brownbeard,0,0,0,,Beni kurtarmak için geldiler.Dialogue: 0,0:24:11.18,0:24:15.26,Main,Brownbeard,0,0,0,,Siz çoktan onların listesindesiniz.Dialogue: 0,0:24:20.07,0:24:22.00,Main,Scotch,0,0,0,,Kahverengisakal mı?Dialogue: 0,0:24:22.00,0:24:26.52,Main,Scotch,0,0,0,,Sen de hedef listesindesin.Dialogue: 0,0:24:29.57,0:24:31.07,Main,Chopper,0,0,0,,Bu adam neyin nesi?Dialogue: 0,0:24:31.07,0:24:34.05,Main,Chopper,0,0,0,,Çok büyük ama onu hiç duymadım!Dialogue: 0,0:24:34.05,0:24:36.22,Main,Brownbeard,0,0,0,,Ne?! Sen Rock mısın?Dialogue: 0,0:24:36.22,0:24:37.37,Main,Scotch,0,0,0,,Ben Scotch.Dialogue: 0,0:24:37.37,0:24:38.93,Main,Brownbeard,0,0,0,,Acayip bir şey söylediğini sandım.Dialogue: 0,0:24:40.54,0:24:41.88,Main,Brownbeard,0,0,0,,Seni yanlış duymuş olmalıyım.Dialogue: 0,0:24:41.88,0:24:44.43,Main,Brownbeard,0,0,0,,Az kalsın kalp krizi geçiriyordumDialogue: 0,0:24:44.43,0:24:47.45,Main,Brownbeard,0,0,0,,Master beni kurtarmak için  seninle anlaşma yapmış olmalı?Dialogue: 0,0:24:47.45,0:24:51.52,Main,Brownbeard,0,0,0,,O yüzden acele et ve beni bu zincirlerden kurtar ve ardından Hasır Şapkayı öldür-Dialogue: 0,0:24:51.95,0:24:56.35,Main,Scotch,0,0,0,,Beni yanlış duymadın. Master sana ihanet etti.Dialogue: 0,0:24:56.35,0:24:58.29,Main,Brownbeard,0,0,0,,Hayatta olmaz!Dialogue: 0,0:24:58.29,0:24:59.99,Main,Scotch,0,0,0,,Şunu dinle.Dialogue: 0,0:25:00.55,0:25:04.28,Main,Caesar,0,0,0,,Ah, ve o adam... Adı neydi?Dialogue: 0,0:25:04.28,0:25:05.46,Main,Brownbeard,0,0,0,,Bu ses!Dialogue: 0,0:25:05.46,0:25:07.22,Main,Caesar,0,0,0,,Gidip kendini esir aldırdı.Dialogue: 0,0:25:07.22,0:25:11.30,Main,Caesar,0,0,0,,O aptal, kıllı suratlı adam... Aptal olmasıyla ünlüydü.Dialogue: 0,0:25:11.30,0:25:13.62,Main,Caesar,0,0,0,,Ahh doğru, Kahverengisakal.Dialogue: 0,0:25:13.62,0:25:14.89,Main,Brownbeard,0,0,0,,Ne, Master?!Dialogue: 0,0:25:15.69,0:25:16.46,Main,Chopper,0,0,0,,Bu o?Dialogue: 0,0:25:16.46,0:25:20.98,Main,Caesar,0,0,0,,O bir aptal olduğundan kullanımı kolay ama bir yük haline geldi.Dialogue: 0,0:25:20.98,0:25:22.11,Main,Caesar,0,0,0,,Artık ona ihtiyacım yok.Dialogue: 0,0:25:22.82,0:25:23.96,Main,Caesar,0,0,0,,Öldürün onu.Dialogue: 0,0:25:29.11,0:25:32.42,Main,Usopp,0,0,0,,Bakın! Duman var!Dialogue: 0,0:25:34.98,0:25:38.78,Main,Luffy,0,0,0,,Nami! Chopper! İyi misiniz?!Dialogue: 0,0:25:38.79,0:25:41.50,Main,Scotch,0,0,0,,Sen Kahverengisakalsın öyle değil mi?Dialogue: 0,0:25:41.50,0:25:44.13,Flashbacks,Caesar,0,0,0,,Buraya kadar gelmekle iyi iş çıkardın.Dialogue: 0,0:25:44.13,0:25:47.24,Flashbacks,Caesar,0,0,0,,Artık daha iyisin. Rahatlayabilirsin.Dialogue: 0,0:25:47.24,0:25:48.46,Flashbacks,Caesar,0,0,0,,İyi iş çıkardın.Dialogue: 0,0:25:48.89,0:25:52.97,Flashbacks,Brownbeard,0,0,0,,Master! Bugün her zamanki gibi sessizdi!Dialogue: 0,0:25:52.97,0:25:57.71,Flashbacks,Caesar,0,0,0,,Anladım. Kahverengisakal, sen çok güvenilir bir muhafızsın.Dialogue: 0,0:25:59.88,0:26:01.10,Flashbacks,Brownbeard,0,0,0,,Hiç de değil.Dialogue: 0,0:26:04.35,0:26:05.76,Main,Brownbeard,0,0,0,,Yalan olmalı.Dialogue: 0,0:26:07.91,0:26:09.27,Main,Brownbeard,0,0,0,,Yalan olmalı.Dialogue: 0,0:26:14.06,0:26:15.98,Main,Brownbeard,0,0,0,,Yalan olmalı.Dialogue: 0,0:26:15.98,0:26:19.69,Main,Brownbeard,0,0,0,,Master!Dialogue: 0,0:26:24.13,0:26:27.86,Main,Scotch,0,0,0,,Bu kadar heyecanlanma. Havalı bir şekilde öl.Dialogue: 0,0:26:37.16,0:26:39.19,Main,Rock,0,0,0,,Scotch.Dialogue: 0,0:26:39.69,0:26:41.21,Main,Chopper,0,0,0,,Bir tane daha var!Dialogue: 0,0:26:41.21,0:26:44.84,Main,Rock,0,0,0,,Ateş etmeyi kes. Burayı yıkıp çocukları öldüreceksin.Dialogue: 0,0:26:44.84,0:26:48.26,Main,Scotch,0,0,0,,Bu hiç havalı olmaz.Dialogue: 0,0:26:49.91,0:26:51.18,Main,Chopper,0,0,0,,Kahverengisakal!Dialogue: 0,0:26:51.18,0:26:52.94,Main,Nami,0,0,0,,Ne kadar korkunç! Kendi dostları!Dialogue: 0,0:26:53.42,0:26:56.77,Main,Rock,0,0,0,,Şuraya bak, kaptanları geri geldi.Dialogue: 0,0:26:57.53,0:26:59.33,Main,Rock,0,0,0,,Onların işini bitirmek her şeyden önce gelir.Dialogue: 0,0:27:05.15,0:27:07.71,Main,Usopp,0,0,0,,Bu da ne? Çok büyükler!Dialogue: 0,0:27:07.71,0:27:08.79,Main,Franky,0,0,0,,Dev mi bunlar?Dialogue: 0,0:27:08.79,0:27:10.66,Main,Robin,0,0,0,,Hayır, biraz farklı görünüyorlar.Dialogue: 0,0:27:10.66,0:27:14.59,Main,Luffy,0,0,0,,Tayfama zarar vermesen iyi olur!Dialogue: 0,0:27:27.77,0:27:29.35,Main,Luffy,0,0,0,,Ne... Kayboldu!Dialogue: 0,0:27:44.97,0:27:46.52,Main,Chopper,0,0,0,,Luffy!Dialogue: 0,0:27:46.52,0:27:47.12,Main,Luffy,0,0,0,,İyi misin?!Dialogue: 0,0:27:48.01,0:27:51.29,Main,Chopper,0,0,0,,Özür dilerim! Nami'yi kaçırdılar!Dialogue: 0,0:28:01.27,0:28:03.86,Main,Scotch,0,0,0,,Canlı olarak yakalamamız gereken tek kişi bu.Dialogue: 0,0:28:03.86,0:28:06.46,Main,Rock,0,0,0,,Vegapunk'un lazerine sahip bir robot, öyle mi?Dialogue: 0,0:28:06.46,0:28:08.72,Main,Scotch,0,0,0,,Artık herkesi öldürebiliriz.Dialogue: 0,0:28:08.72,0:28:12.93,Main,Rock,0,0,0,,Tamamdır. Mümkün olduğu kadar avın tadını çıkaralım.Dialogue: 0,0:28:12.93,0:28:14.62,Main,Scotch,0,0,0,,Havalı bir şekilde.Dialogue: 0,0:28:16.55,0:28:22.42,captionsşsoft,Text,0,0,0,,Laboratuvar - Arka KapıDialogue: 0,0:28:27.46,0:28:28.74,Main,Gasmask,0,0,0,,Ha?Dialogue: 0,0:28:28.74,0:28:30.10,Main,Gasmask2,0,0,0,,Law-san, nereye gidiyorsun?Dialogue: 0,0:28:32.88,0:28:36.19,Main,Gasmask,0,0,0,,Yakında bir yerde Denizcilere rastladık!Dialogue: 0,0:28:36.50,0:28:37.80,Attack,Gasmask,0,0,0,,OdaDialogue: 0,0:29:01.41,0:29:02.73,Main,Law,0,0,0,,Umurumda değil.Dialogue: 0,0:29:04.80,0:29:09.20,Main,Law,0,0,0,,Nereye gideceğim... beni ilgilendirir.