Dialogue: 0,0:02:30.07,0:02:38.76,Title,,0,0,0,,{\fad(2000,2000)}Karşı Saldırı Başlıyor!
Dialogue: 0,0:02:42.40,0:02:46.35,Main,Pirate,0,0,0,,Shichibukai, Trafalgar Law.
Dialogue: 0,0:02:48.14,0:02:53.72,Main,Pirate,0,0,0,,Çarpıcı bir geri dönüş yapıp manşetlere\Nkonu olmuş, Hasır Şapkalı Luffy.
Dialogue: 0,0:02:55.40,0:02:59.07,Main,Pirate,0,0,0,,Ve tayfasından\NŞeytan Çocuk Nico Robin.
Dialogue: 0,0:03:00.52,0:03:05.69,Main,Pirate,0,0,0,,{\fad(0,1500)}Donanma'nın delişmenlerinden\NBeyaz Avcı Smoker.
Dialogue: 0,0:03:05.69,0:03:10.05,Main,Pirate,0,0,1,,{\an8}Böylesi büyük adamlar\Nnasıl oldu da Caesar'a yakalandılar?
Dialogue: 0,0:03:07.62,0:03:12.55,Captions,Sign,0,0,180,,{\fad(700,0)}Yeni Dünya'dan Çeşitli Yerler
Dialogue: 0,0:03:14.94,0:03:16.09,Main,Killer,0,0,0,,Bunlar onlar!
Dialogue: 0,0:03:20.23,0:03:24.21,Main,Kid,0,0,1,,Sonunda hareket etmeye başladın, Hasır Şapka.
Dialogue: 0,0:03:20.24,0:03:24.21,Captions,Sign,0,0,180,,{\fad(700,0)}Eustass "Kaptan" Kid
Dialogue: 0,0:03:24.34,0:03:28.08,Captions,Sign,0,0,240,,{\fad(260,700)}Kid Korsanları Kaptanı\NÖdülü: 470 milyon beli
Dialogue: 0,0:03:24.76,0:03:26.87,Main,Kid,0,0,0,,{\an8}İzlemenin bize bir faydası yok.
Dialogue: 0,0:03:26.87,0:03:32.30,Main,Kid,0,0,0,,{\an8}Hem sen de silah tüccarı rolünü oynamayı\Nsevecek biri değilsin, değil mi Killer?
Dialogue: 0,0:03:30.09,0:03:32.30,Captions,Sign,0,0,180,,{\fad(260,0)}Killer
Dialogue: 0,0:03:34.09,0:03:36.11,Captions,Sign,0,0,240,,{\fad(260,0)}Kid Korsanları Savaşçısı\NÖdülü: 200 milyon beli
Dialogue: 0,0:03:36.11,0:03:41.03,Main,Kid,0,0,0,,Trafalgar adisi hükümetin köpeği olduğunda\Naklını falan oynattı sanmıştım...
Dialogue: 0,0:03:41.03,0:03:45.24,Main,Kid,0,0,0,,...ama boşuna değilmiş,\Nbaşka planları varmış.
Dialogue: 0,0:03:45.24,0:03:47.21,Main,Killer,0,0,0,,Acaba neyin peşinde?
Dialogue: 0,0:03:47.76,0:03:51.89,Main,Kid,0,0,0,,Geride kalmak istemeyiz!\NBiz de acele edelim!
Dialogue: 0,0:03:52.61,0:03:54.89,Main,Killer,0,0,0,,Kid yalvarıyorum, sakince hallet şu işi.
Dialogue: 0,0:03:54.89,0:03:56.63,Main,Kid,0,0,0,,Biliyoruz!\NKapa çeneni sen!
Dialogue: 0,0:04:01.00,0:04:04.00,Captions,Sign,0,0,180,,{\fad(360,0)}Scratchmen Apoo
Dialogue: 0,0:04:01.06,0:04:04.00,Main,Apoo,0,0,1,,Selam, Kaptan Kid!
Dialogue: 0,0:04:05.02,0:04:07.90,Captions,Sign,0,0,180,,{\fad(360,0)}Basil Hawkins
Dialogue: 0,0:04:08.43,0:04:12.05,Main,Apoo,0,0,0,,Her zamanki gibi\Nacayip can sıkıcı görünüyorsun!
Dialogue: 0,0:04:13.14,0:04:15.91,Main,Kid,0,0,0,,Scratchmen!\NNeyin peşindesin?!
Dialogue: 0,0:04:16.39,0:04:19.50,Main,Kid,0,0,0,,Başkalarının saklandığı yerleri\Nbu şekilde yerle bir edemezsin!
Dialogue: 0,0:04:19.50,0:04:22.22,Main,Pirate,0,0,0,,Kusura bakma Kaptan, durduramadık!
Dialogue: 0,0:04:22.83,0:04:27.16,Main,Apoo,0,0,0,,{\an8}Etrafta keskin nişancın falan\Nvar mı diye kontrol ettim.
Dialogue: 0,0:04:26.09,0:04:31.60,Captions,Sign,0,0,240,,{\fad(300,0)}Canlı Yayın Korsanları Kaptanı\NÖdülü: 350 milyon beli
Dialogue: 0,0:04:27.16,0:04:31.60,Main,Apoo,0,0,0,,{\an8}Düşmanı tarafından çağrılan herkesin\Nyapacağı bir şey bence.
Dialogue: 0,0:04:31.60,0:04:37.22,Main,Kid,0,0,0,,Gördün mü, Killer?! O yüzden bu herifleri\Nçağırma demiştim sana!
Dialogue: 0,0:04:37.22,0:04:41.03,Main,killer,0,0,0,,Hadi ama sakin ol, onlar güçlü adamlar.
Dialogue: 0,0:04:42.93,0:04:45.58,Main,Kid,0,0,0,,Sizi var ya...
Dialogue: 0,0:04:45.58,0:04:48.70,Main,Kid,0,0,0,,...şuracıkta geberteceğim!
Dialogue: 0,0:04:48.70,0:04:52.90,Main,Apoo,0,0,0,,Amacının bu olduğunu biliyordum!\NHazırlıklı geldim!
Dialogue: 0,0:04:52.90,0:04:54.56,Main,Apoo,0,0,0,,Gel haydi, gününü göreceksin!
Dialogue: 0,0:04:54.56,0:04:57.94,Captions,Sign,0,0,240,,Hawkins Korsanları Kaptanı\NÖdülü: 320 milyon beli
Dialogue: 0,0:04:55.01,0:04:57.94,Main,Hawkins,0,0,1,,Saçmalık bu! Gidiyorum.
Dialogue: 0,0:04:57.94,0:05:00.78,Main,Killer,0,0,0,,Bekle Hawkins, bu kadar çabuk pes etme!
Dialogue: 0,0:05:02.77,0:05:05.31,Main,Killer,0,0,0,,Yeter bu kadar be!
Dialogue: 0,0:05:06.46,0:05:11.15,Main,Killer,0,0,0,,Sizlerle bir ittifak kurma konusunu\Nkonuşmak istiyorduk!
Dialogue: 0,0:05:13.69,0:05:17.20,Main,Killer,0,0,0,,İki laf etmeyi dahi\Nbilmez misiniz siz?!
Dialogue: 0,0:05:18.14,0:05:19.67,Main,Kota,0,0,0,,Karşılık mı vereceğiz?
Dialogue: 0,0:05:19.67,0:05:22.67,Main,Law,0,0,0,,Burada vakit kaybetmenin\Nkimseye faydası yok.
Dialogue: 0,0:05:22.67,0:05:24.50,Main,Law,0,0,0,,Hadi bu işi çabuk bitirelim!
Dialogue: 0,0:05:24.50,0:05:29.35,Main,Law,0,0,0,,İçimizde bir şeyler yakabilen biri var mı?\NYoksa da sorun değil gerçi.
Dialogue: 0,0:05:29.35,0:05:32.42,Main,Luffy,0,0,0,,Ateş arıyorsan Franky'e gideceksin!\NIşın bile fırlatabiliyor!
Dialogue: 0,0:05:32.42,0:05:36.28,Main,Luffy,0,0,0,,Neden ışınınla\Nzincirleri eritmiyorsun?
Dialogue: 0,0:05:36.28,0:05:40.78,Main,Franky,0,0,0,,Radikal Işın'ım için\Niki elimi birden kullanmam lazım.
Dialogue: 0,0:05:40.78,0:05:42.76,Main,Franky,0,0,0,,Şu anda tek ateşleyebileceğim şey...
Dialogue: 0,0:05:42.76,0:05:45.24,Main,Franky,0,0,0,,...popomdan çıkan Coup de Boo!
Dialogue: 0,0:05:45.56,0:05:48.04,Main,Law,0,0,0,,Sağ taraftaki donanma gemisini\Nateşe verebilir misin?!
Dialogue: 0,0:05:48.27,0:05:53.36,Main,Franky,0,0,0,,Tereyağından kıl çekmemi istedin genç,\Nbana bırak sen o işi!
Dialogue: 0,0:05:53.59,0:05:56.02,Main,Franky,0,0,0,,{\fad(150,150)}Franky...
Dialogue: 0,0:05:58.76,0:06:02.70,Main,Franky,0,0,0,,{\fad(150,150)}Fireball! {Ateş Topu}
Dialogue: 0,0:05:58.76,0:06:02.70,Attack,Franky,0,0,0,,{\fad(150,150)}Ateş Topu
Dialogue: 0,0:06:09.42,0:06:11.19,Main,Marine,0,0,0,,Gemi alev aldı!
Dialogue: 0,0:06:11.19,0:06:12.01,Main,Marine,0,0,0,,Kaçın!
Dialogue: 0,0:06:15.59,0:06:21.37,Main,Caesar,0,0,0,,Bu Pacifista piçi ne yapıyor?\NDeli mi yoksa sadece çaresiz mi?
Dialogue: 0,0:06:23.50,0:06:25.13,Main,Caesar,0,0,0,,Bir işlerine yaramaz!
Dialogue: 0,0:06:25.13,0:06:31.74,Main,Caesar,0,0,0,,Deney sonunda vücudunu parçalara ayırıp\Nher zerresini değerlendireceğim.
Dialogue: 0,0:06:31.97,0:06:33.95,Main,Marine,0,0,0,,Duman yüzünden kafesi göremiyorum!
Dialogue: 0,0:06:33.95,0:06:35.82,Main,Marine,0,0,0,,Kaptan-chan, iyi misin?!
Dialogue: 0,0:06:36.25,0:06:38.38,Main,Marine,0,0,0,,Smo-yan, duman rahatsız ediyor mu!?
Dialogue: 0,0:06:38.38,0:06:41.59,Main,Marine,0,0,0,,Aptal, herif kökten duman zaten!
Dialogue: 0,0:06:44.80,0:06:48.99,Main,Franky,0,0,0,,Lanet olsun Trafalgar,\Nduman bu tarafa geliyor!
Dialogue: 0,0:06:48.99,0:06:50.86,Main,Law,0,0,0,,Senin suçun.
Dialogue: 0,0:06:51.13,0:06:52.98,Main,Franky,0,0,0,,Sen yap demedin mi?!
Dialogue: 0,0:06:55.16,0:06:56.79,Main,Luffy,0,0,0,,Ne yapıyorsun yahu?!
Dialogue: 0,0:06:57.13,0:06:58.08,Main,Law,0,0,0,,Şimdi...
Dialogue: 0,0:07:01.97,0:07:08.59,Main,Law,0,0,0,,Caesar'ın Video Aktarım Den Den Mushi'leri\Nbizi göremeyecekler.
Dialogue: 0,0:07:08.59,0:07:10.91,Main,Law,0,0,0,,Burada olmadığımızı\Nhemen anlayamayacaklar.
Dialogue: 0,0:07:10.91,0:07:15.23,Main,Luffy,0,0,0,,Vay canına!\NDeniz taşı kelepçelerini nasıl çözdün?!
Dialogue: 0,0:07:15.49,0:07:19.16,Main,Law,0,0,0,,Benimkisi ta en başından beri\Nnormal kelepçeydi.
Dialogue: 0,0:07:19.16,0:07:19.79,Main,Luffy,0,0,0,,Ne?!
Dialogue: 0,0:07:19.79,0:07:22.32,Main,Law,0,0,0,,Yani gücümü kullanarak\Nkendimi kolayca çözdüm.
Dialogue: 0,0:07:23.96,0:07:28.11,Main,Law,0,0,0,,Burada kaç ay geçirdim\Nsenin haberin var mı?
Dialogue: 0,0:07:28.11,0:07:35.57,Main,Law,0,0,0,,Her ihtimale karşı laboratuvar boyunca çeşitli\Nyerlere normal kelepçeler yerleştirdim.
Dialogue: 0,0:07:35.57,0:07:41.16,Main,Law,0,0,0,,Böylece yakalanırsam onları değiştirip,\Ndeniz taşı olanlardan kaçınabilirdim.
Dialogue: 0,0:07:52.20,0:07:54.07,Main,Luffy,0,0,0,,Özgürüm!
Dialogue: 0,0:07:54.52,0:07:55.48,Main,Luffy,0,0,0,,
Dialogue: 0,0:07:55.48,0:07:56.83,Main,Law,0,0,0,,Bağırma, seni aptal!
Dialogue: 0,0:07:56.83,0:07:59.92,Main,Luffy,0,0,0,,Yaşasın, yaşasın! Özgürüm!
Dialogue: 0,0:07:59.92,0:08:04.46,Main,Law,0,0,0,,Şimdi size ne yapsak?
Dialogue: 0,0:08:06.22,0:08:08.88,Main,Law,0,0,0,,Biraz fazla şey öğrendiniz.
Dialogue: 0,0:08:09.51,0:08:13.37,Main,Law,0,0,0,,Kaderlerinizi avuçlarımda tutuyorum.
Dialogue: 0,0:08:13.37,0:08:19.04,Main,Smoker,0,0,0,,Kararını vermişsin belli ki!\NNe yapacaksan yap hemen!
Dialogue: 0,0:08:25.94,0:08:29.58,Main,Smoker,0,0,0,,Sen yetişkinsin, yeni yetme kızlar gibi\Nniye cıyaklıyorsun be!?
Dialogue: 0,0:08:30.56,0:08:34.83,Main,Tashigi,0,0,0,,Hemen çöz bizi lütfen!\NNe istersen yaparım!
Dialogue: 0,0:08:34.83,0:08:39.54,Main,Smoker,0,0,0,,Kes saçmalamayı Tashigi! Korsanların önünde\Ndiz çökmektense ölmeyi yeğlemez misin?!
Dialogue: 0,0:08:40.00,0:08:44.44,Main,Tashigi,0,0,0,,Şu anda sağ kalmak için\Nyapmamız gereken buysa yapmalıyız!
Dialogue: 0,0:08:44.44,0:08:49.22,Main,Tashigi,0,0,0,,Çünkü burada ölecek olursak\Nadamlarımızı kurtaramayacağız!
Dialogue: 0,0:08:49.22,0:08:50.58,Main,Tashigi,0,0,0,,Ayrıca Koramiral Vergo...
Dialogue: 0,0:08:51.26,0:08:57.35,Main,Tashigi,0,0,0,,Vergo'nun istediğini yapmasına\Nizin verirsek daha çok çocuk...
Dialogue: 0,0:08:59.99,0:09:02.72,Main,Law,0,0,0,,Kadın senden daha akıllı çıktı.
Dialogue: 0,0:09:03.18,0:09:07.58,Main,Law,0,0,0,,Küçük Beyaz Avcı, seni kurtarmak gibi\Nbir mecburiyetim yok...
Dialogue: 0,0:09:07.58,0:09:13.44,Main,Law,0,0,0,,...ama eğer sizi kurtarmam Vergo'yu kötü\Nduruma sokacaksa bu benim yararıma olur.
Dialogue: 0,0:09:14.16,0:09:19.82,Main,Law,0,0,0,,Ancak ben ve Joker hakkında\Nduyduğun her şeyi unutsan iyi olur.
Dialogue: 0,0:09:20.02,0:09:27.94,Main,Law,0,0,0,,Rica etmiyorum. \NHayatın karşılığında şart koşuyorum.
Dialogue: 0,0:09:31.07,0:09:33.77,Main,Luffy,0,0,0,,Dışarıda neler oluyor acaba?
Dialogue: 0,0:09:35.69,0:09:38.76,Main,Luffy,0,0,0,,İşte bu!\NSonunda dışarıdayım!
Dialogue: 0,0:09:39.31,0:09:41.26,Main,Law,0,0,0,,Ne yapıyorsun!?
Dialogue: 0,0:09:41.26,0:09:42.64,Main,Law,0,0,0,,Bekle!
Dialogue: 0,0:09:43.40,0:09:45.87,Main,Law,0,0,0,,Kafesten çıkarsa istediğini yapacak!
Dialogue: 0,0:09:45.87,0:09:48.43,Main,Franky,0,0,0,,Tel örgüler deniz\Ntaşından değilmiş sanırım.
Dialogue: 0,0:09:50.16,0:09:52.24,Main,Luffy,0,0,0,,Trao!
Dialogue: 0,0:09:54.92,0:09:57.06,Main,Luffy,0,0,0,,İçeri nasıl girerim?
Dialogue: 0,0:09:58.52,0:10:04.16,Main,Franky,0,0,0,,Hey kardeşim, gidip Sunny'yi\Nalmayı tercih ederim.
Dialogue: 0,0:10:04.16,0:10:05.25,Main,Law,0,0,0,,Nasıl istersen öyle yap.
Dialogue: 0,0:10:11.30,0:10:12.87,Main,Smoker,0,0,0,,Neden öyle bakıyorsun bana?
Dialogue: 0,0:10:16.86,0:10:20.04,Main,All,0,0,0,,{\i1}Kaçın!
Dialogue: 0,0:10:22.19,0:10:26.14,Main,Kin'emon,0,0,0,,Böyle hızlı koşabiliriz\Nama yine de yetişecek bize!
Dialogue: 0,0:10:26.14,0:10:29.71,Main,Brook,0,0,0,,Ejderha aldı başını gitti bile!
Dialogue: 0,0:10:29.71,0:10:32.81,Main,Zoro,0,0,0,,Hemen şunu yakalayıp\Nuçalım buradan!
Dialogue: 0,0:10:32.81,0:10:33.98,Main,Sanji,0,0,0,,Ben artık...
Dialogue: 0,0:10:33.98,0:10:35.55,Main,Brook,0,0,0,,Sanji-san, dayanın!
Dialogue: 0,0:10:35.55,0:10:41.63,Main,Sanji,0,0,0,,Bittim! Nami-san'ımın bedensel sınırlarına\Nerişmiş durumdayım!
Dialogue: 0,0:10:41.63,0:10:44.16,Main,Sanji,0,0,0,,Göğsüm sıkışıyor!
Dialogue: 0,0:10:44.16,0:10:44.91,Main,Sanji,0,0,0,,Göğsüm...
Dialogue: 0,0:10:49.29,0:10:50.48,Main,Sanji,0,0,0,,Yakaladım!
Dialogue: 0,0:10:50.48,0:10:53.46,Main,Zoro,0,0,0,,Bu ne tuhaf bir güç artışıydı!
Dialogue: 0,0:10:53.46,0:10:55.68,Main,Nami,0,0,0,,Duman yetişti bile!
Dialogue: 0,0:10:55.68,0:11:00.65,Main,Usopp,0,0,0,,Bu kadar tüyler ürpertici bir renk,\Neminim deli gibi zehirlidir!
Dialogue: 0,0:11:00.98,0:11:05.59,Main,Nami,0,0,0,,Ağır yaralanıp bir de bizi taşımak zorunda\Nkaldığın için özür dilerim Kahverengisakal.
Dialogue: 0,0:11:07.35,0:11:13.21,Main,Brownbeard,0,0,0,,Koymaz bana! Tüy kadarsınız zaten.\NAdamlarımı kurtarmam lazım benim!
Dialogue: 0,0:11:13.68,0:11:18.75,Main,Usopp,0,0,0,,Bizim de o çocukları!\NUmarım şekerlerini henüz yememişlerdir.
Dialogue: 0,0:11:18.75,0:11:20.99,Main,Nami,0,0,0,,Baksanıza, şu ne acaba?
Dialogue: 0,0:11:21.57,0:11:24.44,Main,Nami,0,0,0,,Bakın!\NBirileri gazdan kaçıyor!
Dialogue: 0,0:11:25.08,0:11:26.34,Main,Usopp,0,0,0,,Ejderha mı?!
Dialogue: 0,0:11:35.74,0:11:38.57,Main,Marine,0,0,0,,Kepenkler açıldı!
Dialogue: 0,0:11:39.01,0:11:40.60,Main,Soldier,0,0,0,,Acil durum!
Dialogue: 0,0:11:40.60,0:11:41.98,Main,Soldier,0,0,0,,Kepenkler açıldı!
Dialogue: 0,0:11:42.31,0:11:44.30,Main,Soldier,0,0,0,,Kola kim dokundu!?
Dialogue: 0,0:11:44.30,0:11:47.21,Main,Soldier,0,0,0,,Kahretsin! G-5 askerleri yoğun bir biçimde\Niçeri girmeye başladılar!
Dialogue: 0,0:11:47.21,0:11:48.50,Main,Soldier,0,0,0,,Şuraya bakın!
Dialogue: 0,0:11:50.39,0:11:54.03,Main,Marine,0,0,0,,Donanma G-5 Koramirali Smoker!
Dialogue: 0,0:11:54.98,0:11:58.64,Main,Marine,0,0,0,,Shichibukai, Trafalgar Law!
Dialogue: 0,0:11:59.73,0:12:03.78,Main,Marine,0,0,0,,Korsan Hasır Şapkalı Luffy!
Dialogue: 0,0:12:04.56,0:12:08.45,Main,Marine,0,0,0,,Master tarafından yakalandılar\Ndiye biliyordum!
Dialogue: 0,0:12:09.63,0:12:12.33,Main,Tashigi,0,0,0,,Güzel!\NHerkes içeride!
Dialogue: 0,0:12:13.14,0:12:16.14,Main,Law,0,0,0,,Peki şimdi kalbim\Nkonusunda ne yapmalıyım?
Dialogue: 0,0:12:18.40,0:12:20.09,Main,Luffy,0,0,0,,Bu harika olacak!
Dialogue: 0,0:12:20.09,0:12:23.18,Main,Smoker,0,0,0,,Yakınınızdayken kendimi\Nzavallı gibi hissediyorum beyler.
Dialogue: 0,0:12:23.18,0:12:25.53,Main,Marine,0,0,0,,Şu da ne?!
Dialogue: 0,0:12:27.84,0:12:30.67,Main,Brownbeard,0,0,0,,
Dialogue: 0,0:12:37.25,0:12:39.50,Main,Usopp,0,0,0,,Durun bir dakika! Durun! Bekleyin!
Dialogue: 0,0:12:41.03,0:12:43.34,Main,Usopp,0,0,0,,Kepenk kapanıyor!
Dialogue: 0,0:12:43.34,0:12:45.39,Main,Brownbeard,0,0,0,,Kahretsin, buraya kadar da geldik!
Dialogue: 0,0:12:45.39,0:12:48.63,Main,Nami,0,0,0,,Açın!\NBizi de içeri alın!
Dialogue: 0,0:12:48.63,0:12:53.19,Main,Usopp,0,0,0,,Olamaz! Bizi kaderimize terk ediyorlar!\NGazın kurbanı olacağız!
Dialogue: 0,0:12:55.48,0:12:59.15,Main,Brook,0,0,0,,Çok geç değil, henüz ölmedik!
Dialogue: 0,0:13:00.80,0:13:03.79,Main,Zoro,0,0,0,,Bak az Kin'emon, demiri kesebilir misin?
Dialogue: 0,0:13:05.26,0:13:07.62,Main,Kin'emon,0,0,0,,Hiçbir şey kılıcıma engel olamaz!
Dialogue: 0,0:13:07.94,0:13:10.22,Main,Zoro,0,0,0,,Kahverengisakal, aynen böyle devam et!
Dialogue: 0,0:13:25.26,0:13:28.08,Main,Marines,0,0,0,,{\i1}Kepengi kestiler!{\i0}
Dialogue: 0,0:13:28.08,0:13:30.24,Main,Luffy,0,0,0,,Hepiniz de gelmişsiniz!
Dialogue: 0,0:13:31.68,0:13:32.68,Main,Sanji,0,0,0,,Luffy!
Dialogue: 0,0:13:34.91,0:13:36.53,Main,Luffy,0,0,0,,Şimdi tamamız!
Dialogue: 0,0:13:37.94,0:13:42.15,Main,Luffy,0,0,0,,Hadi bakalım!\NOrtalığı birbirine katma zamanı!
Dialogue: 0,0:13:50.10,0:13:53.13,Main,Marine,0,0,0,,Ne yaptığınızı sanıyorsunuz siz?!
Dialogue: 0,0:13:53.13,0:13:55.72,Main,Usopp,0,0,0,,Olamaz!
Dialogue: 0,0:13:55.72,0:13:59.10,Main,Usopp,0,0,0,,İçeri girebildik güzel de\Ngaz da hemen peşimizden girecek!
Dialogue: 0,0:13:59.10,0:14:02.55,Main,Marine,0,0,0,,Siz ciddi misiniz!? Kendinizle birlikte\Nbizi de öldürmeye mi çalışıyorsun!?
Dialogue: 0,0:14:02.55,0:14:05.39,Main,Marine,0,0,0,,Millet, kapamaya çalışın şu deliği!
Dialogue: 0,0:14:05.39,0:14:07.90,Main,Marine,0,0,0,,Aksi halde işimiz biter!
Dialogue: 0,0:14:45.09,0:14:48.08,Main,Caesar,0,0,0,,Bu kadar işte!
Dialogue: 0,0:14:48.72,0:14:53.44,Main,Caesar,0,0,0,,Punk Hazard'da yaşanabilecek\Ntek bir toprak parçası kalmadı!
Dialogue: 0,0:14:55.35,0:14:58.12,Main,Brook,0,0,0,,Her yerde hâlâ büyük bulutlar var.
Dialogue: 0,0:14:58.12,0:15:02.24,Main,Brook,0,0,0,,Dışarı bir adım atmak\Nanında ölüm demek.
Dialogue: 0,0:15:02.73,0:15:03.99,Main,Usopp,0,0,0,,Durum nasıl, Brook?
Dialogue: 0,0:15:03.99,0:15:07.04,Main,Brook,0,0,0,,Ölüler diyarı gibi dışarısı.
Dialogue: 0,0:15:07.04,0:15:09.81,Main,Brook,0,0,0,,Ya o deliği kapatamasaydık diye düşününce...
Dialogue: 0,0:15:10.97,0:15:12.54,Main,Brook,0,0,0,,...ödüm patlıyor.
Dialogue: 0,0:15:12.54,0:15:14.05,Main,Marines,0,0,0,,{\i1}Asıl sen ödümüzü patlıyorsun!!{\i0}
Dialogue: 0,0:15:14.05,0:15:16.67,Main,Zoro,0,0,0,,Güzel!
Dialogue: 0,0:15:16.67,0:15:21.33,Main,Marine,0,0,0,,Güzel falan değil!\NSizin yüzünüzden hepimiz ölecektik!
Dialogue: 0,0:15:21.33,0:15:23.09,Main,Marine,0,0,0,,Deliği kapatanlar da bizleriz!
Dialogue: 0,0:15:23.64,0:15:26.39,Main,Marine,0,0,0,,Siz korsanlar insanların\Nsöylediğinden çok daha kötüsünüz!
Dialogue: 0,0:15:26.39,0:15:30.56,Main,Marine,0,0,0,,Teslim olun Hasır Şapka korsanları!\NSen de Kahverengisakal!
Dialogue: 0,0:15:30.56,0:15:35.06,Main,Usopp,0,0,0,,Bu ne şimdi, köşeye sıkıştırılmış\Ngibi olduk?! Kaçacak yer de yok!
Dialogue: 0,0:15:37.73,0:15:39.51,Main,Zoro,0,0,0,,Gerek var mı ki?
Dialogue: 0,0:15:41.03,0:15:43.25,Main,Nami,0,0,0,,Böyle olması çok normal tabii...
Dialogue: 0,0:15:47.82,0:15:49.54,Main,Sanji,0,0,0,,Hiç başlamadan vazgeçmeleri\Nonların lehine olur.
Dialogue: 0,0:15:52.21,0:15:55.40,Main,Brownbeard,0,0,0,,Ad-Adımı biliyorlar!
Dialogue: 0,0:15:55.40,0:15:58.50,Main,Luffy,0,0,0,,Aşağısı kaynamaya başladı!
Dialogue: 0,0:15:59.77,0:16:05.13,Main,Law,0,0,0,,Ne benim ne de bunların\Nyoluna çıkmayacaksınız, anladınız mı?
Dialogue: 0,0:16:05.13,0:16:06.24,Main,Smoker,0,0,0,,Anladık!
Dialogue: 0,0:16:07.19,0:16:10.27,Main,Nami,0,0,0,,Trao, bak bakayım sen bana!
Dialogue: 0,0:16:10.27,0:16:11.77,Main,Nami,0,0,0,,Buraya, buraya!
Dialogue: 0,0:16:11.77,0:16:15.78,Main,Nami,0,0,0,,Acele et! Bizi normale çevir!
Dialogue: 0,0:16:15.78,0:16:18.07,Main,Sanji,0,0,0,,Çevirmesen de olur bak!
Dialogue: 0,0:16:21.76,0:16:24.24,Main,Sanji,0,0,0,,Lanet olsun ya!\NRüya sona erdi!
Dialogue: 0,0:16:24.52,0:16:28.46,Main,Nami,0,0,0,,Kendimdeyim de...
Dialogue: 0,0:16:31.16,0:16:32.79,Main,Nami,0,0,0,,Sanji-kun!?
Dialogue: 0,0:16:34.67,0:16:38.08,Main,Nami,0,0,0,,Neden paltom değişmiş?!\NBeni soydun, di mi?!
Dialogue: 0,0:16:38.08,0:16:40.01,Main,Sanji,0,0,0,,Açıklayabilirim...
Dialogue: 0,0:16:44.81,0:16:47.34,Main,Sanji,0,0,0,,Tuhaf?\NBedenim...
Dialogue: 0,0:16:47.34,0:16:51.12,Main,Sanji,0,0,0,,Az önceki yediğim yumruktan\Nolmadı bu hasar.
Dialogue: 0,0:16:51.12,0:16:55.61,Main,Usopp,0,0,0,,Nami senin bedenindeyken\NCaesar tarafından epey hırpalanmıştı.
Dialogue: 0,0:16:55.61,0:16:56.63,Main,Sanji,0,0,0,,Ne!?
Dialogue: 0,0:16:57.14,0:17:01.39,Main,Sanji,0,0,0,,Şükürler olsun!\Nİyi ki hırpalanan benim bedenim olmuş!
Dialogue: 0,0:17:01.39,0:17:05.69,Main,Usopp,0,0,0,,Bu ne mertliktir arkadaş!?\NÇok yüce gönüllüsün!
Dialogue: 0,0:17:05.69,0:17:08.44,Main,Law,0,0,0,,Herkes beni dinlesin!
Dialogue: 0,0:17:09.23,0:17:10.49,Main,Marine,0,0,0,,Law!
Dialogue: 0,0:17:10.49,0:17:13.76,Main,Law,0,0,0,,Laboratuvar tamamen\Nzehirli gazla çevrili...
Dialogue: 0,0:17:13.76,0:17:18.16,Main,Law,0,0,0,,ama dışarıdaki havayla temas etmeksizin\Ndeniz çıkan bir yol var.
Dialogue: 0,0:17:18.48,0:17:25.74,Main,Law,0,0,0,,Üzerinde "R-66" yazan\Ndenize açılan büyük bir kapı var.
Dialogue: 0,0:17:26.01,0:17:30.97,Main,Law,0,0,0,,Burada bir kıyım olsun istemem\Nama size en fazla iki saat verebilirim.
Dialogue: 0,0:17:30.97,0:17:36.30,Main,Law,0,0,0,,Bu süreden fazla burada kalan kişilerin\Nsağ kalacaklarına dair bir garanti veremem.
Dialogue: 0,0:17:38.69,0:17:41.31,Main,Luffy,0,0,0,,Laboratuvara bir şey mi olacak ki?
Dialogue: 0,0:17:42.06,0:17:47.14,Main,Law,0,0,0,,İşlerin gidişatına bağlı. Şimdilik\Nyapmam gereken şeye odaklanmalıyım.
Dialogue: 0,0:17:47.14,0:17:48.61,Main,Luffy,0,0,0,,Anladım.
Dialogue: 0,0:17:49.95,0:17:52.14,Main,Luffy,0,0,0,,Robin, senden bir iyilik isteyeceğim.
Dialogue: 0,0:17:53.00,0:17:53.78,Main,Robin,0,0,0,,Nedir?
Dialogue: 0,0:17:55.20,0:17:57.08,Main,Smoker,0,0,0,,G-5!
Dialogue: 0,0:17:58.08,0:17:58.91,Main,Marine,0,0,0,,Smo-yan!
Dialogue: 0,0:17:59.53,0:18:04.65,Main,Smoker,0,0,0,,Laboratuvarda iki yıl önce kaçırılmış\Nçocuklar tutuluyor!
Dialogue: 0,0:18:04.65,0:18:09.35,Main,Smoker,0,0,0,,Onları da alıp\N"R-66" kapısına doğru yola çıkın!
Dialogue: 0,0:18:09.83,0:18:13.86,Main,Smoker,0,0,0,,Eğer dedikleri doğruysa\Norada bir liman bulacaksınız.
Dialogue: 0,0:18:13.86,0:18:16.81,Main,Smoker,0,0,0,,Bir gemi çalıp \NPunk Hazard'dan kaçacağız!
Dialogue: 0,0:18:17.86,0:18:19.09,Main,Marine,0,0,0,,Evet! Hadi gidelim!
Dialogue: 0,0:18:19.09,0:18:20.84,Main,Marine,0,0,0,,Veda vakti gelmişti zaten bu adaya!
Dialogue: 0,0:18:21.59,0:18:22.38,Main,Nami,0,0,0,,Çocuklar...
Dialogue: 0,0:18:22.80,0:18:25.45,Main,Nami,0,0,0,,Millet, ayrılıp çocukları bulalım...
Dialogue: 0,0:18:25.45,0:18:29.49,Main,Nami,0,0,0,,...ve onları R-66 geçidine götürelim!
Dialogue: 0,0:18:30.80,0:18:32.75,Main,Nami,0,0,0,,Zoro, sana yalnız dolaşmayı yasaklıyorum!
Dialogue: 0,0:18:35.27,0:18:39.83,Main,Kin'emon,0,0,0,,Bekle beni Momonosuke!\NNe pahasına olursa olsun seni kurtaracağım!
Dialogue: 0,0:18:39.83,0:18:42.82,Main,Robin,0,0,0,,Durum bu demek.\NAnlaşılmıştır.
Dialogue: 0,0:18:42.82,0:18:45.13,Main,Luffy,0,0,0,,Zahmet olacak.\NHadi görüşürüz.
Dialogue: 0,0:18:48.17,0:18:52.71,Main,Luffy,0,0,0,,Bekle beni Caesar!\NBu sefer beni boğamayacaksın!
Dialogue: 0,0:18:54.85,0:18:57.75,Main,Luffy,0,0,0,,Önce bir güzel canına okuyup\Nsonra da kaçıracağım seni!
Dialogue: 0,0:19:02.55,0:19:07.12,Main,Smoker,0,0,0,,Tashigi, G-5 aptallarına\Nliderlik etmeni istiyorum.
Dialogue: 0,0:19:07.12,0:19:10.01,Main,Tashigi,0,0,0,,Siz nereye gidiyorsunuz, Smoker-san?
Dialogue: 0,0:19:11.94,0:19:12.77,Main,Tashigi,0,0,0,,Vergo'nun peşine mi düşeceksiniz yoksa?!
Dialogue: 0,0:19:13.94,0:19:15.62,Main,Smoker,0,0,0,,Hesabını verecek bunların!
Dialogue: 0,0:19:16.25,0:19:20.49,Main,Smoker,0,0,0,,Bu meseleler hakla hukukla\Nçözülecek şeyler değil, Tashigi!
Dialogue: 0,0:19:22.17,0:19:25.89,Main,Smoker,0,0,0,,Kendim halletmeliyim!\NDonanmayla resmen dalga geçiyormuş!
Dialogue: 0,0:19:26.90,0:19:28.90,Main,Tashigi,0,0,0,,Beni de yanınızda götürün öyleyse!
Dialogue: 0,0:19:30.27,0:19:33.72,Main,Tashigi,0,0,0,,Vergo gerçekten çok güçlü biri!
Dialogue: 0,0:19:34.21,0:19:35.82,Main,Tashigi,0,0,0,,Ya size bir şey olursa!?
Dialogue: 0,0:19:35.82,0:19:42.17,Main,Smoker,0,0,0,,Adamlarımızı kim koruyacak? O aptallara\Nve çocuklara kaçmalarında yardım et!
Dialogue: 0,0:19:42.81,0:19:44.68,Main,Tashigi,0,0,0,,Smoker-san...
Dialogue: 0,0:19:50.27,0:19:55.77,Main,Zoro,0,0,0,,Doğru mu?!\NLuffy, Caesar'a yenildi mi?!
Dialogue: 0,0:19:55.77,0:20:00.59,Main,Usopp,0,0,0,,Evet... Biz de hazırlıksız yakalanıp\Nhavasız kaldık.
Dialogue: 0,0:20:00.59,0:20:06.14,Main,Usopp,0,0,0,,Tam bir baş belası adi herif! Gazdan\Nyapıldığı için havadaki oksijeni emebiliyor!
Dialogue: 0,0:20:06.61,0:20:09.46,Main,Zoro,0,0,0,,Biz de kardan adamlar tarafından\Nhaklandık.
Dialogue: 0,0:20:10.88,0:20:12.58,Main,Zoro,0,0,0,,Bu iş yürümez böyle!
Dialogue: 0,0:20:12.58,0:20:13.22,Main,Usopp,0,0,0,,
Dialogue: 0,0:20:14.82,0:20:16.81,Main,Zoro,0,0,0,,Olmaz bu böyle!
Dialogue: 0,0:20:17.31,0:20:20.04,Main,Zoro,0,0,0,,Koca iki yılı\Nne için harcadık biz?!
Dialogue: 0,0:20:20.04,0:20:23.06,Main,Usopp,0,0,0,,Aman neyse şimdi,\Nyaşıyoruz sonuçta...
Dialogue: 0,0:20:23.06,0:20:25.08,Main,Zoro,0,0,0,,Dalga mı geçiyorsun sen?!
Dialogue: 0,0:20:26.22,0:20:30.77,Main,Zoro,0,0,0,,Hazırlıksız yakalanmak şu noktadan sonra\Naffedilir bir yanlış olmayacak!
Dialogue: 0,0:20:39.90,0:20:41.45,Main,Zoro,0,0,0,,Luffy!
Dialogue: 0,0:20:44.91,0:20:45.52,Main,Luffy,0,0,0,,Zoro?
Dialogue: 0,0:20:49.23,0:20:53.95,Main,Zoro,0,0,0,,Kendine gel artık! \NYeni Dünya şu noktadan itibaren başlıyor!
Dialogue: 0,0:21:07.82,0:21:10.45,Main,Sanji,0,0,0,,Kendine çok sert davranıyor.
Dialogue: 0,0:21:12.75,0:21:15.95,Main,Luffy,0,0,0,,Evet, kusuruma bakma!\NArtık hazırlıksız yakalanmak yok!
Dialogue: 0,0:21:16.95,0:21:18.37,Main,Soldier,0,0,0,,Hasır Şapka bu!
Dialogue: 0,0:21:18.37,0:21:20.96,Main,Soldier,0,0,0,,Neyin peşinde bilmiyorum ama öldürün şunu!
Dialogue: 0,0:21:33.57,0:21:35.16,Main,Luffy,0,0,0,,{\fad(150,150}Gomu Gomu no...
Dialogue: 0,0:21:43.44,0:21:44.71,Main,Luffy,0,0,0,,{\fad(150,150)}...UFO!
Dialogue: 0,0:21:48.46,0:21:49.39,Main,Luffy,0,0,0,,Ben önden kaçtım!
Dialogue: 0,0:21:50.56,0:21:52.32,Main,Zoro,0,0,0,,Biraz daha ciddi diyorum!
Dialogue: 0,0:21:57.40,0:21:59.20,Main,Luffy,0,0,0,,Çekilin yolumdan!
Dialogue: 0,0:22:09.31,0:22:10.54,Main,Luffy,0,0,0,,Gidelim!
Dialogue: 0,0:00:24.22,0:00:27.49,Credits,,0,0,0,,{\pos(206,574)}Translation\N{\fs40}Hattori
Dialogue: 0,0:00:27.63,0:00:30.76,Credits,,0,0,0,,{\pos(762,370)}Initial timing\N{\fs40}Hattori
Dialogue: 0,0:00:31.19,0:00:34.35,Credits,,0,0,0,,{\pos(226,424)}Timing\N{\fs40}Galaxy 9000
Dialogue: 0,0:00:34.86,0:00:38.43,Credits,,0,0,0,,{\pos(792,492)}Quality checking\N{\fs40}Sewil
Dialogue: 0,0:00:41.43,0:00:43.68,Credits,,0,0,0,,{\pos(200,500)}Soundtracking\N{\fs40}MaideV and Halee
Dialogue: 0,0:00:43.73,0:00:45.96,Credits,,0,0,0,,{\pos(198,488)}Raw providing\N{\fs40}OPC-Raws
Dialogue: 0,0:00:46.00,0:00:48.22,Credits,,0,0,0,,{\an5\pos(858,345)}Editing\N{\fs40}Sewil
Dialogue: 0,0:00:00.20,0:00:05.07,Hands Up lyrics,,0,0,0,,♪ Kaldır ellerini daha da yukarıya, hayallerini dök şarkılara. ♪
Dialogue: 0,0:00:05.14,0:00:08.72,Hands Up lyrics,,0,0,0,,♪ Yıkılma hiçbir zaman, sarsılmaz bayrağını kaldır göklere. ♪
Dialogue: 0,0:00:08.80,0:00:12.27,Hands Up lyrics,,0,0,0,,♪ Buralara kadar gelebilmek için pek çok duvarı yıkıp geçtik! ♪
Dialogue: 0,0:00:12.34,0:00:17.68,Hands Up lyrics,,0,0,0,,♪ Hedef gelecek, haydi eller havaya!! ♪
Dialogue: 0,0:00:23.31,0:00:30.66,Hands Up lyrics,,0,0,0,,♪ Uzansam biraz daha erişeceğim hemen cevaba. ♪
Dialogue: 0,0:00:30.73,0:00:38.37,Hands Up lyrics,,0,0,0,,♪ İnanarak buna açılıyorum yeni dünyaya. ♪
Dialogue: 0,0:00:38.40,0:00:45.86,Hands Up lyrics,,0,0,0,,♪ Aynen öyle, yapboz gibi birleşti hayal kırıntılarımız. ♪
Dialogue: 0,0:00:45.91,0:00:50.41,Hands Up lyrics,,0,0,0,,♪ Aramızda hiç kopmayacak bağlar yaratarak,...
Dialogue: 0,0:00:51.18,0:00:53.51,Hands Up lyrics,,0,0,0,,...daha aydınlık bir geleceğe. ♪
Dialogue: 0,0:00:54.00,0:00:58.55,Hands Up lyrics,,0,0,0,,♪ Kaldır ellerini daha da yukarıya, hayallerini dök şarkılara. ♪
Dialogue: 0,0:00:58.62,0:01:02.42,Hands Up lyrics,,0,0,0,,♪ Yıkılma hiçbir zaman, sarsılmaz bayrağını kaldır göklere. ♪
Dialogue: 0,0:01:02.43,0:01:05.78,Hands Up lyrics,,0,0,0,,♪ Buralara kadar gelebilmek için pek çok duvarı yıkıp geçtik! ♪
Dialogue: 0,0:01:05.83,0:01:09.80,Hands Up lyrics,,0,0,0,,♪ Hedefimiz gelecek! ♪
Dialogue: 0,0:01:09.87,0:01:11.30,Hands Up lyrics,,0,0,0,,♪ Daha da yukarıya bak! ♪
Dialogue: 0,0:01:11.34,0:01:13.48,Hands Up lyrics,,0,0,0,,♪ Sırtın hep dik olsun! ♪
Dialogue: 0,0:01:13.53,0:01:14.94,Hands Up lyrics,,0,0,0,,♪ Bir an olsun durma! ♪
Dialogue: 0,0:01:14.99,0:01:16.82,Hands Up lyrics,,0,0,0,,♪ Dalgaları aşa aşa! ♪
Dialogue: 0,0:01:16.86,0:01:20.41,Hands Up lyrics,,0,0,0,,♪ Arzularımız birleşiyor yavaşça. ♪
Dialogue: 0,0:01:20.44,0:01:24.65,Hands Up lyrics,,0,0,0,,♪ Haydi ilerisini hedef seçelim kendimize! ♪
Dialogue: 0,0:01:24.91,0:01:31.06,Hands Up lyrics,,0,0,0,,♪ Dalgaları sürerek, akıyoruz ileriye. ♪
Dialogue: 0,0:01:31.09,0:01:35.34,Hands Up lyrics,,0,0,0,,♪ İnsanlarla tanışıyor, elvedalar ediyoruz,...
Dialogue: 0,0:01:35.36,0:01:39.09,Hands Up lyrics,,0,0,0,,...bir kez daha bu bayrağın altında. ♪
Dialogue: 0,0:01:41.26,0:01:45.04,Hands Up lyrics,,0,0,0,,♪ Unutmak istemediğim acıları...
Dialogue: 0,0:01:45.06,0:01:48.08,Hands Up lyrics,,0,0,0,,...o gün yüreğime gömdüm, saklıyorum orada. ♪
Dialogue: 0,0:01:48.27,0:01:52.34,Hands Up lyrics,,0,0,0,,♪ Kimselere yenilmeyecek bir özgürlük bizimkisi,...
Dialogue: 0,0:01:52.46,0:01:54.75,Hands Up lyrics,,0,0,0,,...sıkıca kavrayıp yoluma atıldığım. ♪
Dialogue: 0,0:01:54.77,0:01:59.69,Hands Up lyrics,,0,0,0,,♪ Kaldır ellerini daha da yukarıya, hayallerini dök şarkılara. ♪
Dialogue: 0,0:01:59.72,0:02:03.37,Hands Up lyrics,,0,0,0,,♪ Yıkılma hiçbir zaman, sarsılmaz bayrağını kaldır göklere. ♪
Dialogue: 0,0:02:03.41,0:02:06.66,Hands Up lyrics,,0,0,0,,♪ Buralara kadar gelebilmek için pek çok duvarı yıkıp geçtik! ♪
Dialogue: 0,0:02:06.69,0:02:10.83,Hands Up lyrics,,0,0,0,,♪ Hedefimiz gelecek! ♪
Dialogue: 0,0:02:10.88,0:02:12.20,Hands Up lyrics,,0,0,0,,♪ Daha da yukarıya bak! ♪
Dialogue: 0,0:02:12.25,0:02:14.53,Hands Up lyrics,,0,0,0,,♪ Sırtın hep dik olsun! ♪
Dialogue: 0,0:02:14.53,0:02:15.90,Hands Up lyrics,,0,0,0,,♪ Bir an olsun durma! ♪
Dialogue: 0,0:02:15.95,0:02:17.72,Hands Up lyrics,,0,0,0,,♪ Dalgaları aşa aşa! ♪
Dialogue: 0,0:02:17.76,0:02:21.43,Hands Up lyrics,,0,0,0,,♪ Arzularımız birleşiyor yavaşça. ♪
Dialogue: 0,0:02:21.50,0:02:24.97,Hands Up lyrics,,0,0,0,,♪ Haydi ilerisini hedef seçelim kendimize! ♪
Dialogue: 0,0:02:24.99,0:02:29.89,Hands Up lyrics,,0,0,0,,♪ Eller havaya!! ♪
