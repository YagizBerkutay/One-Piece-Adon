s BT,20.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.5,0.5,9,10,10,10,1Style: Hands Up lyrics,Futura Md BT,35,&H00FF762C,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2.0,0,8,10,10,30,1Style: Land of Death,Kozuka Gothic Pr6N B,85,&H00611B54,&H00FFFFFF,&H00CB69AE,&H00000000,0,0,0,0,100,100,0,0,1,2,0,2,120,120,18,1Style: Land of Death 2,Kozuka Gothic Pr6N B,35,&H00611B54,&H00FFFFFF,&H00CB69AE,&H00000000,0,0,0,0,100,100,0,0,1,2,0,2,120,120,18,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:02:29.94,0:02:33.83,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:12:53.80,0:13:03.80,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:21:33.50,0:21:36.41,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:02:29.94,0:02:33.83,Title,,0,0,0,,Dressrosa'dan Suikastçılar!Dialogue: 0,0:02:33.83,0:02:38.50,Narrator,Narrator,0,0,0,,Ölümcül gaz Shinokuni'nin binayı doldurmasına beş dakika kala...Dialogue: 0,0:02:38.50,0:02:45.49,Narrator,Narrator,0,0,0,,...sağ kalanlar, tek kaçış yolu olan R binasının R-66 kapısına doğru ilerlemekteydiler fakat...Dialogue: 0,0:02:50.57,0:02:52.25,Main,Sanji,0,0,0,,Tavan kalktı!Dialogue: 0,0:02:53.61,0:02:56.19,Main,Robin,0,0,0,,Gaz çatlaklardan sızmaya başladı!Dialogue: 0,0:02:56.19,0:02:57.54,Main,Nami,0,0,0,,Durum hiç iyi değil!Dialogue: 0,0:02:57.54,0:02:58.81,Main,Nami,0,0,0,,Koşun!Dialogue: 0,0:02:58.81,0:03:00.84,Main,Ally,0,0,0,,Korkuyorum abla!Dialogue: 0,0:03:02.07,0:03:05.03,Main,Sanji,0,0,0,,Korkudan donup kalacak zaman değil veletler!Dialogue: 0,0:03:05.03,0:03:06.28,Main,Sanji,0,0,0,,Kalkıp koşmaya başlayın hemen!Dialogue: 0,0:03:07.65,0:03:09.25,Main,Marine,0,0,0,,Biricik Kaptanımız!Dialogue: 0,0:03:09.25,0:03:10.62,Main,Marine,0,0,0,,İyi olmana çok sevindim!Dialogue: 0,0:03:10.62,0:03:12.63,Main,Marine,0,0,0,,Kuş kadını yendiniz demek?!Dialogue: 0,0:03:12.63,0:03:15.70,Main,Marine,0,0,0,,Neden o taraftan geliyorlar ki?Dialogue: 0,0:03:15.70,0:03:18.23,Main,Marine,0,0,0,,Kaçabilelim diye arkada kalmamışlar mıydı onlar?Dialogue: 0,0:03:18.61,0:03:20.67,Main,Tashigi,0,0,0,,G-5 bize doğru geliyor!Dialogue: 0,0:03:20.67,0:03:23.10,Main,Tashigi,0,0,0,,Yanlış tarafa gidiyorsun demiştim sana!Dialogue: 0,0:03:23.10,0:03:23.80,Main,Zoro,0,0,0,,Ha?!Dialogue: 0,0:03:23.80,0:03:26.90,Main,Tashigi,0,0,0,,Ondan ziyade indir beni yahu, utandırıyorsun beni!Dialogue: 0,0:03:26.90,0:03:31.96,Main,Sanji,0,0,0,,Lan! Tashigi-chan'ı omzuna alabileceğini kim söyledi sana?!Dialogue: 0,0:03:31.96,0:03:33.31,Main,Nami,0,0,0,,Zoro, öteki tarafa!Dialogue: 0,0:03:36.04,0:03:37.25,Main,Robin,0,0,0,,Millet, acele edin!Dialogue: 0,0:03:37.25,0:03:38.66,Main,Nami,0,0,0,,Bu taraftan!Dialogue: 0,0:03:39.13,0:03:43.97,Captions,Caption,0,0,160,,B Binası, 2. kat - LaboratuvarDialogue: 0,0:03:39.33,0:03:40.82,Main,Marine,0,0,0,,Tavan çöktü çökecek!Dialogue: 0,0:03:41.15,0:03:43.97,Main,Marine,0,0,0,,Chopper-yan, burada kalamayız!Dialogue: 0,0:03:43.97,0:03:47.17,Main,Chopper,0,0,0,,Haklısınız! Şimdilik yapabileceğim her şeyi yaptım!Dialogue: 0,0:03:47.17,0:03:48.89,Main,Chopper,0,0,0,,Haydi, R binasına gidelim!Dialogue: 0,0:03:51.88,0:03:54.98,Main,Chopper,0,0,0,,Mocha, dayan! Kaçacağız buradan!Dialogue: 0,0:03:57.62,0:03:59.79,Main,Vergo,0,0,0,,Lanet olsun!Dialogue: 0,0:03:59.79,0:04:02.32,Main,Vergo,0,0,0,,Yarın nasıl kahvaltı edeceğim şimdi?Dialogue: 0,0:04:02.96,0:04:05.52,Main,Vergo,0,0,0,,İşler nasıl da değişti böyle birden.Dialogue: 0,0:04:06.22,0:04:08.99,Main,Vergo,0,0,0,,Pek bir cüretkâr olmuşsun, Law.Dialogue: 0,0:04:09.89,0:04:12.36,Main,Vergo,0,0,0,,Zerre keyif kalmadı.Dialogue: 0,0:04:12.94,0:04:15.50,Main,Vergo,0,0,0,,Ama pişman olacağına kalıbımı basarım.Dialogue: 0,0:04:16.21,0:04:18.10,Main,Vergo,0,0,0,,Bunu aklından çıkarma.Dialogue: 0,0:04:18.83,0:04:22.79,Main,Vergo,0,0,0,,Joker'ın geçmişini bilmiyorsun.Dialogue: 0,0:04:22.79,0:04:25.09,Main,Vergo,0,0,0,,Ve bu hayatına mâl olacak.Dialogue: 0,0:04:28.05,0:04:31.13,Main,Vergo,0,0,0,,Senin gibi azıcık ünlenen sonradan görmeler...Dialogue: 0,0:04:31.13,0:04:35.18,Main,Vergo,0,0,0,,...dünyayı ele geçirme hayalleri kuramazlar.  Dünya o denli hoşgörülü bir yer değil!Dialogue: 0,0:04:35.18,0:04:37.87,Main,Vergo,0,0,0,,Anlat şuna, Smoker.Dialogue: 0,0:04:39.42,0:04:43.21,Main,Vergo,0,0,0,,Sizin gibi veletlerin derdi kaynayan kanları. Ama dünya-Dialogue: 0,0:04:44.03,0:04:48.77,Main,Law,0,0,0,,Beni dert etmene gerek yok, kendini düşün sen.Dialogue: 0,0:04:52.05,0:04:54.67,Main,Law,0,0,0,,Oda havaya uçacak.Dialogue: 0,0:04:55.33,0:04:58.49,Main,Law,0,0,0,,Güle güle, korsan Vergo!Dialogue: 0,0:05:00.08,0:05:01.83,Captions,Caption,0,0,160,,R Binası 1. KatDialogue: 0,0:05:03.82,0:05:05.92,Main,Caesar,0,0,0,,Böyle bir şeyi yapabilecek tek kişi...Dialogue: 0,0:05:07.32,0:05:09.22,Main,Caesar,0,0,0,,...Law'dır!Dialogue: 0,0:05:10.37,0:05:12.29,Main,Caesar,0,0,0,,Ne yapıyor bu Vergo?!Dialogue: 0,0:05:12.29,0:05:14.44,Main,Gasmask soldier,0,0,0,,Master, neler oluyor?!Dialogue: 0,0:05:14.44,0:05:16.78,Main,Gasmask soldier,0,0,0,,Yıkıntı altında kalanlarımız var!Dialogue: 0,0:05:16.78,0:05:18.26,Main,Gasmask soldier,0,0,0,,Master!Dialogue: 0,0:05:18.26,0:05:20.62,Main,Caesar,0,0,0,,Kahretsin ya!Dialogue: 0,0:05:20.62,0:05:25.20,Main,Caesar,0,0,0,,Cennet bahçemin içine ettiniz!Dialogue: 0,0:05:25.80,0:05:28.14,Main,Luffy,0,0,0,,Bizimkiler iyiler midir acaba?Dialogue: 0,0:05:29.17,0:05:31.94,Main,Caesar,0,0,0,,R Binası 2. Kat, duyuyor musunuz?Dialogue: 0,0:05:32.70,0:05:35.48,Main,Caesar,0,0,0,,Gizli oda, cevap ver!Dialogue: 0,0:05:35.48,0:05:38.08,Main,Gasmask soldier,0,0,0,,Evet Master! Az önce ne oldu öyle?!Dialogue: 0,0:05:38.08,0:05:40.32,Main,Caesar,0,0,0,,Hava türbünlerini derhal çalıştırın!Dialogue: 0,0:05:41.77,0:05:46.68,Main,Caesar,0,0,0,,Shinokuni'yi bu odaya doldurun!Dialogue: 0,0:05:46.68,0:05:48.71,Main,Gasmask soldier,0,0,0,,Fa-Fakat öyle...Dialogue: 0,0:05:48.71,0:05:51.66,Main,Caesar,0,0,0,,Gazım ben, ölmeyeceğim!Dialogue: 0,0:05:52.07,0:05:53.90,Main,Gasmask soldier,0,0,0,,Em-Emredersiniz!Dialogue: 0,0:05:53.90,0:05:56.06,Main,Gasmask soldier,0,0,0,,Ama önce ilk kattaki askerlerimizi ikinci kata ala-Dialogue: 0,0:05:56.06,0:05:57.52,Main,Caesar,0,0,0,,Derhal dedim!Dialogue: 0,0:05:58.30,0:06:01.11,Main,Caesar,0,0,0,,Derhal yapın dedim size!Dialogue: 0,0:06:01.67,0:06:04.66,Main,Caesar,0,0,0,,Söylenmeyi bırakıp dediğimi yapın!Dialogue: 0,0:06:04.66,0:06:08.08,Main,Gasmask soldier,0,0,0,,Fakat orada hâlâ yüz askerimiz var!Dialogue: 0,0:06:08.08,0:06:10.06,Main,Caesar,0,0,0,,Umrumda değil, aptal herif!Dialogue: 0,0:06:10.06,0:06:15.85,Main,Caesar,0,0,0,,Deney farelerisiniz siz, birkaç yüzünüz ölmüş kimin umrunda!Dialogue: 0,0:06:15.85,0:06:17.69,Main,Caesar,0,0,0,,Toplumun yüz karaları sizi!Dialogue: 0,0:06:19.66,0:06:22.78,Main,Caesar,0,0,0,,Ne bekliyorsunuz, sesim gelmiyor mu?Dialogue: 0,0:06:22.78,0:06:26.77,Main,Caesar,0,0,0,,Siz aptalların yerine yenilerini koymak çok kolay!Dialogue: 0,0:06:33.24,0:06:36.59,Thoughts,Usopp,0,0,0,,Şimdi Caesar'ın gerçekte nasıl biri olduğunu biliyorlar.Dialogue: 0,0:06:38.13,0:06:38.88,Thoughts,Usopp,0,0,0,,Zorolar bunlar!Dialogue: 0,0:06:41.05,0:06:43.96,Thoughts,Usopp,0,0,0,,Başları dertte gibi!Dialogue: 0,0:06:44.82,0:06:48.15,Thoughts,Usopp,0,0,0,,Acaba kapıları buradan kontrol etmek mümkün mü?Dialogue: 0,0:06:50.86,0:06:54.39,Main,Caesar,0,0,0,,Ne oldu? Neden öyle bakıyorsunuz bana?Dialogue: 0,0:06:54.39,0:06:57.31,Main,Gasmask soldier,0,0,0,,Ne? Yo-Yok bir şey...Dialogue: 0,0:07:00.27,0:07:01.90,Main,Gasmask soldier,0,0,0,,Anladım ben ya!Dialogue: 0,0:07:02.81,0:07:05.80,Main,Gasmask soldier,0,0,0,,Master, düşmanları kandırmaya çalışıyor!Dialogue: 0,0:07:07.52,0:07:09.51,Main,Gasmask soldier,0,0,0,,Tabii ya, öyledir kesin!Dialogue: 0,0:07:09.51,0:07:15.25,Main,Gasmask soldier,0,0,0,,Zehirli gazla ilgili de kesin bir planı vardır!  Adamlarının ölmesine izin verecek değil ya!Dialogue: 0,0:07:15.25,0:07:16.79,Main,Gasmask soldier,0,0,0,,Kesin öyledir!Dialogue: 0,0:07:16.79,0:07:20.75,Main,Gasmask soldier,0,0,0,,İyi kalpli Master'ımız, ondan şüphelendiğimizi duyarsa çok üzülür.Dialogue: 0,0:07:21.95,0:07:24.82,Main,Gasmask soldier,0,0,0,,Master, hava türbünlerini çalıştırdım!Dialogue: 0,0:07:29.89,0:07:31.36,Main,Gasmask soldier,0,0,0,,Zehirli gaz!Dialogue: 0,0:07:31.36,0:07:32.40,Main,Gasmask soldier,0,0,0,,İçeri doluyor!Dialogue: 0,0:07:32.40,0:07:35.98,Main,Caesar,0,0,0,,Evet, dediğim anda yapacaktınız bunu!Dialogue: 0,0:07:35.98,0:07:37.85,Main,Caesar,0,0,0,,Sizin gibi işe yaramazların düşünmesine gerek yok!Dialogue: 0,0:07:38.30,0:07:42.97,Main,Caesar,0,0,0,,Haydi, gücüme güç kat Shinokuni!Dialogue: 0,0:07:53.97,0:07:55.50,Land of Death,,0,0,0,,Ölüm DiyarıDialogue: 0,0:07:55.50,0:07:55.67,Land of Death,,0,0,0,,Ölüm DiyarıDialogue: 0,0:07:55.67,0:07:55.77,Land of Death,,0,0,0,,Ölüm DiyarıDialogue: 0,0:07:55.77,0:07:55.94,Land of Death,,0,0,0,,Ölüm DiyarıDialogue: 0,0:07:55.94,0:07:56.04,Land of Death,,0,0,0,,Ölüm DiyarıDialogue: 0,0:07:56.04,0:07:56.14,Land of Death,,0,0,0,,Ölüm DiyarıDialogue: 0,0:07:56.14,0:07:56.30,Land of Death,,0,0,0,,Ölüm DiyarıDialogue: 0,0:07:56.30,0:07:56.40,Land of Death,,0,0,0,,Ölüm DiyarıDialogue: 0,0:07:56.40,0:07:56.47,Land of Death,,0,0,0,,Ölüm DiyarıDialogue: 0,0:07:59.44,0:08:07.98,Land of Death 2,,0,0,0,,Ölüm DiyarıDialogue: 0,0:08:03.78,0:08:07.98,Main,Caesar,0,0,0,,Bilim gücüm bu işte benim!Dialogue: 0,0:08:08.98,0:08:10.37,Main,Caesar,0,0,0,,Hissediyorum!Dialogue: 0,0:08:13.41,0:08:21.16,Main,Caesar,0,0,0,,Bu deney sayesinde iki ülke çoktan Shinokuni'ye ilgi duyduğunu belirtti bile!Dialogue: 0,0:08:21.16,0:08:23.26,Main,Caesar,0,0,0,,İkisi de çok barışsever ülkeler.Dialogue: 0,0:08:24.21,0:08:29.02,Main,Caesar,0,0,0,,Fakat insanlar kendilerini savunma konusunu ciddiye almaya başlayınca...Dialogue: 0,0:08:29.02,0:08:31.98,Main,Caesar,0,0,0,,...düşmanlarını ortadan kaldırabilecekleri her fırsatı kullanacaklardır!Dialogue: 0,0:08:32.76,0:08:36.58,Main,Caesar,0,0,0,,Herkesin bana ihtiyacı var!Dialogue: 0,0:08:36.58,0:08:39.31,Main,Caesar,0,0,0,,Tüm dünyaya silahlar satıp...Dialogue: 0,0:08:39.31,0:08:42.98,Main,Caesar,0,0,0,,...ölüm diyarımın kralı olacağım!Dialogue: 0,0:08:46.47,0:08:47.37,Main,Caesar,0,0,0,,Bak!Dialogue: 0,0:08:52.42,0:08:54.25,Main,Gasmask soldier,0,0,0,,Yapmayın...Dialogue: 0,0:09:01.49,0:09:02.84,Main,Gasmask soldier,0,0,0,,Kendi askerlerini öldürdü!Dialogue: 0,0:09:02.84,0:09:04.02,Main,Gasmask soldier,0,0,0,,Neler oluyor?!Dialogue: 0,0:09:04.02,0:09:05.34,Main,Gasmask soldier,0,0,0,,Master!Dialogue: 0,0:09:06.74,0:09:10.23,Main,Gasmask soldier,0,0,0,,Bizi gerçekten de birer deney faresi olarak mı görüyor?Dialogue: 0,0:09:12.69,0:09:16.14,Main,Caesar,0,0,0,,Bana kalırsa harika bir şey bu!Dialogue: 0,0:09:16.14,0:09:21.16,Main,Caesar,0,0,0,,Sinirlerine bu denli çabuk nüfuz edişi sanırsın sanat!Dialogue: 0,0:09:24.10,0:09:27.44,Main,Momonosuke,0,0,0,,Bu da neydi böyle?!Dialogue: 0,0:09:27.44,0:09:28.95,Main,Momonosuke,0,0,0,,İnsanlar...Dialogue: 0,0:09:31.13,0:09:32.94,Main,Luffy,0,0,0,,Momo, Kahverengisakal sana emanet.Dialogue: 0,0:09:32.94,0:09:33.92,Main,Momonosuke,0,0,0,,Ne? Peki!Dialogue: 0,0:09:34.90,0:09:38.79,Main,Caesar,0,0,0,,Nereye gidiyorsun, Hasır Şapkalı Luffy!Dialogue: 0,0:09:39.47,0:09:43.43,Main,Caesar,0,0,0,,Korkup kaçmaya mı başladın!? Rezil herif seni!Dialogue: 0,0:09:45.16,0:09:50.27,Main,Caesar,0,0,0,,Fakat gittiğin yöndeki B binası da çoktan zehirli gazla doldu bile!Dialogue: 0,0:09:51.14,0:09:55.44,Main,Caesar,0,0,0,,Adada kaçabileceğin hiçbir yer kalmadı!Dialogue: 0,0:09:55.44,0:10:00.06,Main,Usopp,0,0,0,,Epey üzgünsünüz biliyorum fakat müsaade ederseniz kontrolü ben ele alayım.Dialogue: 0,0:10:01.77,0:10:04.18,Main,Usopp,0,0,0,,Dostlarımı gazdan kurtarmak istiyorum!Dialogue: 0,0:10:04.18,0:10:07.44,Main,Gasmask soldier,0,0,0,,Adi, her şeyi gördün değil mi?!Dialogue: 0,0:10:07.44,0:10:08.59,Main,Gasmask soldier,0,0,0,,Lanet olası!Dialogue: 0,0:10:08.59,0:10:11.06,Main,Usopp,0,0,0,,Dur! Benim izlediklerimi siz de izlediniz.Dialogue: 0,0:10:11.06,0:10:15.73,Main,Gasmask soldier,0,0,0,,Evet, haklısın. Çok büyük ihanete uğradık.Dialogue: 0,0:10:15.73,0:10:19.60,Main,Gasmask soldier,0,0,0,,İşimiz bitti! O adamın düşmanımız olduğunu biliyoruz artık ama...Dialogue: 0,0:10:20.64,0:10:22.93,Main,Gasmask soldier,0,0,0,,...kaçacak bir yerimiz yok!Dialogue: 0,0:10:22.93,0:10:25.68,Main,Gasmask soldier,0,0,0,,Sizin durumunuz sanki çok farklı?!Dialogue: 0,0:10:25.68,0:10:30.16,Main,Gasmask soldier,0,0,0,,Kaptanının Caesar karşısında nasıl kaçtığını görmedin mi?!Dialogue: 0,0:10:30.16,0:10:34.80,Main,Gasmask soldier,0,0,0,,Hak ettiğinizi buldunuz işte! Sizi arkada bırakıp çekip gitti!Dialogue: 0,0:10:34.80,0:10:40.35,Main,Usopp,0,0,0,,Hey hey, gözümün önünde kaptanım hakkında nasıl böyle konuşabiliyorsunuz!?Dialogue: 0,0:10:41.74,0:10:46.29,Main,Usopp,0,0,0,,Bize ihanet edip kaçacak bir adam olsaydı...Dialogue: 0,0:10:46.29,0:10:48.93,Main,Usopp,0,0,0,,...işim çok kolaylaşırdı.Dialogue: 0,0:10:49.29,0:10:52.40,Main,Usopp,0,0,0,,Ben de kuyruğumu kıstırır kaçar giderdim.Dialogue: 0,0:10:54.37,0:10:57.85,Main,Usopp,0,0,0,,Ama hiçbir sınır bilmeksizin...Dialogue: 0,0:10:57.85,0:11:01.89,Main,Usopp,0,0,0,,...sonuna kadar bize güvendi.Dialogue: 0,0:11:02.71,0:11:05.56,Main,Usopp,0,0,0,,Yani onu desteklemekten başka seçenek bırakmazdı bize!Dialogue: 0,0:11:06.37,0:11:09.50,Main,Usopp,0,0,0,,Bu güveni son nefesimize değin boşa çıkartmak istemeyiz!Dialogue: 0,0:11:14.35,0:11:20.04,Main,Usopp,0,0,0,,Caesar, Luffy'nin nefret ettiği tipte  insanlardan biri.Dialogue: 0,0:11:21.26,0:11:24.20,Main,Usopp,0,0,0,,Luffy bu yaptıklarını Caesar'ın yanına bırakmaz.Dialogue: 0,0:11:26.06,0:11:30.64,Main,Luffy,0,0,0,,Caesar!Dialogue: 0,0:11:30.64,0:11:33.62,Main,Luffy,0,0,0,,Yüzünü bir daha asla görmek istemiyorum!Dialogue: 0,0:11:34.01,0:11:36.46,Main,Luffy,0,0,0,,Gomu Gomu no...Dialogue: 0,0:11:40.56,0:11:43.31,Main,Caesar,0,0,0,,Bak ne diyeceğim, Hasır Şapka!Dialogue: 0,0:11:43.31,0:11:46.53,Main,Caesar,0,0,0,,Benim için çalışmana izin verebilir-Dialogue: 0,0:11:46.53,0:11:49.24,Main,Luffy,0,0,0,,Grizzly Magnum!Dialogue: 0,0:11:46.53,0:11:49.24,Attack,Luffy,0,0,0,,Bozayı Magnum!Dialogue: 0,0:12:22.52,0:12:24.86,Captions,Caption,0,0,180,,Yeni Dünya'dan Çeşitli YerlerDialogue: 0,0:12:23.12,0:12:24.86,Main,Unknown Pirate,0,0,0,,Neler oluyor?Dialogue: 0,0:12:25.96,0:12:28.48,Main,Unknown Pirate,0,0,0,,Nasıl bir şaka be bu?!Dialogue: 0,0:12:28.48,0:12:30.33,Main,Unknown Pirate,0,0,0,,Halka açık deney dedikleri şey bu mu?!Dialogue: 0,0:12:30.33,0:12:32.93,Main,Unknown Pirate,0,0,0,,Caesar'ı yendi!Dialogue: 0,0:12:32.93,0:12:35.32,Main,Tamago,0,0,0,,Mama'ya haber vermeliyiz-bon!Dialogue: 0,0:12:36.58,0:12:38.80,Main,Unknown Pirate,0,0,0,,Joker, harekete geçecek.Dialogue: 0,0:12:39.21,0:12:41.31,Main,Unknown Pirate,0,0,0,,Jack'e haber verin.Dialogue: 0,0:12:41.31,0:12:43.94,Main,Unknown Pirate,0,0,0,,Emin misin? Sonu pek iyi olmayacak onun.Dialogue: 0,0:12:43.94,0:12:46.04,Main,Unknown Pirate,0,0,0,,Muhtemelen ittifak kurmuşlar.Dialogue: 0,0:12:46.04,0:12:50.38,Main,Unknown Pirate,0,0,0,,Dünya bunu bilmeli. Sadece yeraltı dünyasının sorunu olmaktan çıktı bu iş.Dialogue: 0,0:12:53.90,0:12:54.99,Captions,Caption,0,0,180,,B Binası 2. KatDialogue: 0,0:12:55.28,0:12:57.12,Main,Marines,0,0,0,,Acele edin, acele edin, acele edin!Dialogue: 0,0:12:57.70,0:12:59.32,Main,Chopper,0,0,0,,Mocha, dayan!Dialogue: 0,0:13:00.46,0:13:02.16,Main,Usopp,0,0,0,,Chopper, duyuyor musun?Dialogue: 0,0:13:03.05,0:13:04.66,Main,Chopper,0,0,0,,Usopp'un sesi mi bu?!Dialogue: 0,0:13:04.66,0:13:07.97,Main,Usopp,0,0,0,,Dümdüz devam edip  merdivenlerden aşağı inin!Dialogue: 0,0:13:07.97,0:13:10.67,Main,Usopp,0,0,0,,R binasına en kestirme yol o!Dialogue: 0,0:13:10.74,0:13:13.70,Captions,Caption,0,0,180,,R Binası, 2. Kat - Gizli OdaDialogue: 0,0:13:10.67,0:13:13.70,Main,Usopp,0,0,0,,Gaz içeri girmesin diye R binasının kapısını kapatacağım!Dialogue: 0,0:13:13.98,0:13:15.57,Main,Usopp,0,0,0,,O yüzden acele edin!Dialogue: 0,0:13:16.31,0:13:18.07,Main,Chopper,0,0,0,,Tamamdır anladım, sağ ol!Dialogue: 0,0:13:19.46,0:13:21.56,Main,Brook,0,0,0,,Chopper-san!Dialogue: 0,0:13:21.56,0:13:23.31,Main,Chopper,0,0,0,,Ne? Brook?Dialogue: 0,0:13:23.31,0:13:26.33,Main,Brook,0,0,0,,Çok ciddi! Kin'emon-san-Dialogue: 0,0:13:26.33,0:13:28.85,Main,Brook,0,0,0,,Kin'emon-san gaza maruz kalıp...Dialogue: 0,0:13:28.85,0:13:31.07,Main,Brook,0,0,0,,...öldü!Dialogue: 0,0:13:33.46,0:13:37.30,Main,Brook,0,0,0,,Muayene odasındaki çocuklara kaçmalarında yardımcı olup...Dialogue: 0,0:13:37.89,0:13:43.28,Main,Brook,0,0,0,,...Kin'emon-san'ın oğlunu ararken bir kız çocuğu gördük.Dialogue: 0,0:13:43.28,0:13:44.78,Main,Brook,0,0,0,,Ve o kız dedi ki...Dialogue: 0,0:13:45.52,0:13:49.87,Flashbacks,Kin'emon,0,0,0,,Ne?! Momonosuke, küçük bir ejderhaya mı dönüştü?!Dialogue: 0,0:13:49.87,0:13:52.94,Flashbacks,Ginko,0,0,0,,Evet! Sır kalması lazımdı bunun ama doğruyu söylüyorum.Dialogue: 0,0:13:53.86,0:13:57.50,Flashbacks,Kin'emon,0,0,0,,Ceset-dono, az evvel kestiğim o ejderha yoksa..Dialogue: 0,0:14:04.09,0:14:05.94,Flashbacks,Kin'emon,0,0,0,,Momonosuke!Dialogue: 0,0:14:05.94,0:14:08.48,Flashbacks,Kin'emon,0,0,0,,Ne kötü bir şey yaptım ben!Dialogue: 0,0:14:08.48,0:14:11.41,Flashbacks,Brook,0,0,0,,Kin'emon-san, geri dönemezsiniz!Dialogue: 0,0:14:12.83,0:14:15.88,Flashbacks,Brook,0,0,0,,Orası çoktan gazla dolmuştur...Dialogue: 0,0:14:16.25,0:14:20.57,Flashbacks,Kin'emon,0,0,0,,Ateş olmuş gaz olmuş, ruhum her şeye göğüs germesini bilir!Dialogue: 0,0:14:20.57,0:14:22.25,Flashbacks,Kin'emon,0,0,0,,Momonosuke!Dialogue: 0,0:14:22.25,0:14:25.19,Flashbacks,Brook,0,0,0,,İmkansız, Kin'emon-san!Dialogue: 0,0:14:26.39,0:14:28.68,Main,Brook,0,0,0,,Ve sonucu bu oldu.Dialogue: 0,0:14:29.01,0:14:30.48,Main,Chopper,0,0,0,,Ne çılgınlık!Dialogue: 0,0:14:30.59,0:14:31.92,Captions,Caption,0,0,0,,R binası 1. KatDialogue: 0,0:14:32.59,0:14:33.65,Main,Nami,0,0,0,,Luffy!Dialogue: 0,0:14:34.41,0:14:35.55,Main,Luffy,0,0,0,,Vay, Nami!Dialogue: 0,0:14:35.55,0:14:37.97,Main,Nami,0,0,0,,Harika! Bizden önce geldin demek?!Dialogue: 0,0:14:37.97,0:14:39.96,Main,Nami,0,0,0,,Kahverengisakal-cchi yerde!Dialogue: 0,0:14:40.41,0:14:41.68,Main,Nami,0,0,0,,Bir şeyi yok ya?!Dialogue: 0,0:14:41.68,0:14:43.58,Main,Luffy,0,0,0,,Bir şeyi yok.Dialogue: 0,0:14:43.58,0:14:45.33,Main,Luffy,0,0,0,,Tam öyle de diyemeyiz sanki ama...Dialogue: 0,0:14:46.36,0:14:49.17,Main,Momonosuke,0,0,0,,Çocuklar!Dialogue: 0,0:14:50.02,0:14:51.30,Main,Luffy,0,0,0,,Gördün mü Momo?Dialogue: 0,0:14:51.30,0:14:54.09,Flashbacks,Luffy,0,0,0,,Çocukları düşünme sen.Dialogue: 0,0:14:54.09,0:14:55.94,Flashbacks,Luffy,0,0,0,,Dostlarım onlara yardım etmeye gittiler.Dialogue: 0,0:14:56.60,0:14:59.39,Flashbacks,Luffy,0,0,0,,Yapacağız dedikleri şeyi yaparlar.Dialogue: 0,0:14:59.39,0:15:01.52,Flashbacks,Luffy,0,0,0,,O yüzden hiç takma kafana!Dialogue: 0,0:15:04.92,0:15:07.75,Main,Sanji,0,0,0,,Acele edin! Nami-sanlar'ın yanına koşun!Dialogue: 0,0:15:08.37,0:15:10.29,Main,Zoro,0,0,0,,Chopperlar hâlâ gelmemişler mi?!Dialogue: 0,0:15:11.31,0:15:14.79,Main,Robin,0,0,0,,O kıza ilk yardım uyguluyordu, yetişebilecekler mi acaba?Dialogue: 0,0:15:21.24,0:15:24.80,Captions,Caption,0,0,180,,R ve D binaları arasındaki geçitDialogue: 0,0:15:25.39,0:15:27.91,Main,Smoker,0,0,0,,Bunu yapmamız şart mı?Dialogue: 0,0:15:27.91,0:15:31.34,Main,Law,0,0,0,,SAD tanklarını taşımak için kullandıkları bir kamyon bu.Dialogue: 0,0:15:31.76,0:15:34.48,Main,Law,0,0,0,,Milleti buna bindireceğiz.Dialogue: 0,0:15:34.48,0:15:38.08,Main,Law,0,0,0,,En kısa sürede kaçmamız lazım.Dialogue: 0,0:15:39.23,0:15:40.18,Main,Law,0,0,0,,Hasır Şapka-ya!Dialogue: 0,0:15:41.07,0:15:43.00,Main,Luffy,0,0,0,,Tra-o, Duman!Dialogue: 0,0:15:43.00,0:15:44.39,Main,Luffy,0,0,0,,O taraftan gelmenizi beklemiyordum!Dialogue: 0,0:15:44.39,0:15:47.57,Main,Marines,0,0,0,,Hey, Smo-yan bu!Dialogue: 0,0:15:47.57,0:15:49.16,Main,Marines,0,0,0,,Ha? Smo-yan!Dialogue: 0,0:15:49.56,0:15:50.43,Main,Marines,0,0,0,,Gerçekten de o!Dialogue: 0,0:15:53.71,0:15:55.08,Main,Marines,0,0,0,,İyi olmana çok sevindim!Dialogue: 0,0:15:55.08,0:15:59.34,Main,Marines,0,0,0,,Smo-yan, şükürler olsun! Anlatacak o kadar çok şeyimiz var ki!Dialogue: 0,0:15:59.34,0:16:01.24,Main,Smoker,0,0,0,,Kesin bağırmayı!Dialogue: 0,0:16:05.26,0:16:08.88,Main,Law,0,0,0,,Hasır Şapka-ya, Caesar nerede?Dialogue: 0,0:16:08.88,0:16:12.78,Main,Luffy,0,0,0,,Canına okuyup şu kapıdan uçurdum!Dialogue: 0,0:16:12.78,0:16:14.22,Main,Luffy,0,0,0,,Acaba ne kadar uçmuştur?Dialogue: 0,0:16:14.22,0:16:17.10,Main,Law,0,0,0,,Ne yaptığını sanıyorsun sen?! Planımız onu kaçırmaktı!Dialogue: 0,0:16:17.68,0:16:20.86,Main,Luffy,0,0,0,,Tamam da o adiyi yakalamak falan istemiyorum ben artık!Dialogue: 0,0:16:20.86,0:16:23.51,Main,Law,0,0,0,,Sevsen de sevmesen de planımız buydu!Dialogue: 0,0:16:23.51,0:16:25.96,Main,Law,0,0,0,,Kaçacak olsa ne yapacaksın?!Dialogue: 0,0:16:25.96,0:16:28.27,Main,Luffy,0,0,0,,Kaçarsa kaçsın yahu, kimin umrunda!Dialogue: 0,0:16:28.27,0:16:31.37,Main,Law,0,0,0,,Canının istediği gibi planı değiştirebileceğini sanma!Dialogue: 0,0:16:31.37,0:16:33.94,Main,Law,0,0,0,,Sana güvenmemeliydim!Dialogue: 0,0:16:33.94,0:16:35.04,Main,Law,0,0,0,,Derhal bulalım şunu!Dialogue: 0,0:16:38.04,0:16:40.82,Narrator,Narrator,0,0,0,,Şimdi zamanda biraz geriye gidelim.Dialogue: 0,0:16:42.30,0:16:45.48,Narrator,Narrator,0,0,0,,Punk Hazard yakınları...Dialogue: 0,0:16:46.36,0:16:52.36,Captions,Caption,0,0,240,,Donquixote Korsanları Hizmetçi/Suikastçı, Bebek 5Dialogue: 0,0:16:50.14,0:16:52.36,Captions,Caption,0,0,240,,Buki Buki(Silah) Meyvesi, Silah-Vücutlu İnsanDialogue: 0,0:16:46.14,0:16:48.90,Main,Baby 5,0,0,0,,Görev biter bitmez aşk da bitecek.Dialogue: 0,0:16:48.90,0:16:52.36,Main,Baby 5,0,0,0,,Geri döner dönmez onun işini bitireceğim!Dialogue: 0,0:16:52.36,0:16:54.61,Main,Baby 5,0,0,0,,İşe yaramaz Joker bozuntusu!Dialogue: 0,0:16:54.61,0:17:00.58,Main,Baby 5,0,0,0,,Pek sevgili nişanlımı köyüyle birlikte ortadan kaldırdı!Dialogue: 0,0:17:00.58,0:17:02.13,Main,Baby 5,0,0,0,,Onu affetmeyeceğim!Dialogue: 0,0:17:02.13,0:17:04.61,Main,Baby 5,0,0,0,,Üstelik bu sekizinci!Dialogue: 0,0:17:04.64,0:17:10.21,Main,Baby 5,0,0,0,,Çok sevdiğim sekiz adamı öldürüp, antlar içip, sekiz kasaba yakıp yıktı.Dialogue: 0,0:17:10.86,0:17:14.36,Main,Baby 5,0,0,0,,Neden mutluluğuma mâni olmaya çalışıyor?!Dialogue: 0,0:17:15.19,0:17:17.26,Main,Buffalo,0,0,0,,Genç Bey'imiz sevgisini böyle gösteriyor!Dialogue: 0,0:17:17.26,0:17:21.77,Main,Buffalo,0,0,0,,Seni kardeşi gibi sevdiği için...Dialogue: 0,0:17:21.77,0:17:25.16,Main,Buffalo,0,0,0,,...birkaç köyü yok etmeyi göze alabiliyor!Dialogue: 0,0:17:16.49,0:17:25.16,Captions,Caption,0,0,240,,Donquixote Korsanları Savaşçı, BuffaloDialogue: 0,0:17:19.27,0:17:25.16,Captions,Caption,0,0,240,,Guru Guru(Dön) Meyvesi, Dönen İnsanDialogue: 0,0:17:26.48,0:17:30.14,Main,Caption,0,0,0,,"Hayır" demeyi öğrenmen lazım!Dialogue: 0,0:17:30.71,0:17:35.92,Main,Baby 5,0,0,0,,Ne kötülüğü oldu ki nişanlımın?! Bana ihtiyacı vardı!Dialogue: 0,0:17:38.02,0:17:41.06,Flashbacks,Ugly man,0,0,0,,İlk görüşte aşık oldum, evlenelim lütfen!Dialogue: 0,0:17:47.78,0:17:53.07,Main,Buffalo,0,0,0,,Biri bir şey istediğinde hayır diyemiyorsun! Bu konuda bir şeyler yapman lazım!Dialogue: 0,0:17:53.07,0:17:57.07,Main,Buffalo,0,0,0,,50 ayrı gazeteye üye olman çok tuhaf!Dialogue: 0,0:17:57.07,0:18:01.74,Main,Buffalo,0,0,0,,Çok fazla borç veriyorsun, istemediğin çok fazla şeyi alıyorsun!Dialogue: 0,0:18:01.74,0:18:03.79,Main,Buffalo,0,0,0,,Ne kadar borcun olduğunu söyle bana!Dialogue: 0,0:18:04.34,0:18:08.52,Main,Baby 5,0,0,0,,Sana ne be! 98 milyon beli!Dialogue: 0,0:18:08.52,0:18:12.36,Main,Baby 5,0,0,0,,Hayat benim hayatım! Karışmayın!Dialogue: 0,0:18:13.25,0:18:17.14,Main,Buffalo,0,0,0,,Bak aklıma geldi de 2 milyon beli ödünç alabilir miyim?Dialogue: 0,0:18:18.70,0:18:21.77,Thoughts,Baby 5,0,0,0,,Bana ihtiyacı var!Dialogue: 0,0:18:22.54,0:18:26.13,Main,Baby 5,0,0,0,,Şey, ne zaman vereyim?Dialogue: 0,0:18:27.41,0:18:30.09,Main,Buffalo,0,0,0,,Döndüğümde kumarhanelere akmak istiyorum!Dialogue: 0,0:18:30.09,0:18:35.41,Main,Baby 5,0,0,0,,Öyleyse görevimiz biter bitmez paranı hazır edeceğim.Dialogue: 0,0:18:37.96,0:18:43.60,Main,Baby 5,0,0,0,,İstediği için bu görevi yerine getireceğim fakat onu öldürmeyeceğim demek değil bu!Dialogue: 0,0:18:45.49,0:18:46.67,Main,Buffalo,0,0,0,,Geldik!Dialogue: 0,0:18:47.05,0:18:49.94,Main,Buffalo,0,0,0,,Punk Hazard-dasuyan!Dialogue: 0,0:18:51.61,0:18:54.18,Main,Baby 5,0,0,0,,Ada, Caesar'ın gazıyla kaplanmış.Dialogue: 0,0:18:54.67,0:18:57.25,Main,Baby 5,0,0,0,,Bunu ateşlersem dağılır mı acaba?Dialogue: 0,0:18:58.64,0:19:03.15,Main,Buffalo,0,0,0,,Sen bana bırak bu işi! Az üstümden inebilir misin, Baby 5?Dialogue: 0,0:19:10.83,0:19:15.63,Main,Buffalo,0,0,0,,Fırtına misali gücüme tanıklık edin!Dialogue: 0,0:19:18.17,0:19:22.31,Main,Buffalo,0,0,0,,Bora: Matasaburo!Dialogue: 0,0:19:29.36,0:19:33.82,Main,Baby 5,0,0,0,,Caesar, Monet ve Vergo gelene dek bekleyelim orada.Dialogue: 0,0:19:36.00,0:19:39.40,Main,Buffalo,0,0,0,,Hemen geri dönüp kumarhanede rulet oynamak istiyorum-dasuyan!Dialogue: 0,0:19:47.70,0:19:49.68,Main,Baby 5,0,0,0,,Tanker mi patladı?!Dialogue: 0,0:19:49.68,0:19:52.67,Main,Buffalo,0,0,0,,Hayır! Bir şey çarptı-dasuyan!Dialogue: 0,0:19:56.48,0:19:58.24,Main,Baby 5,0,0,0,,İnsan bu! Şurada!Dialogue: 0,0:20:00.01,0:20:01.85,Main,Baby 5,0,0,0,,Caesar Clown bu!Dialogue: 0,0:20:03.08,0:20:06.80,Captions,Caption,0,0,180,,DressrosaDialogue: 0,0:20:08.38,0:20:12.22,Main,Buffalo,0,0,0,,Joker, Punk Hazard'dan Buffalo ben!Dialogue: 0,0:20:12.22,0:20:15.96,Main,Buffalo,0,0,0,,Az önce Punk Hazard'a  ayak bastık-dasuyan!Dialogue: 0,0:20:16.32,0:20:23.77,Main,Buffalo,0,0,0,,Neler oluyor bilmiyoruz fakat Master Caesar'ın berbat bir halde binadan uçtuğunu gördük-dasuyan!Dialogue: 0,0:20:24.45,0:20:26.27,Main,Doflamingo,0,0,0,,Ne dedin?!Dialogue: 0,0:20:30.91,0:20:36.98,Main,Doflamingo,0,0,0,,Derhal Caesar'ı alıp Dressrosa'ya geri dönün!Dialogue: 0,0:20:38.08,0:20:39.48,Main,Buffalo,0,0,0,,Monet'le Vergo peki?Dialogue: 0,0:20:40.37,0:20:43.79,Main,Baby 5,0,0,0,,Bir bildiği vardır onun. Ne diyorsa onu yapalım biz.Dialogue: 0,0:20:43.79,0:20:46.52,Main,Buffalo,0,0,0,,Anlaşılmıştır, Joker!Dialogue: 0,0:20:52.01,0:20:53.92,Thoughts,Doflamingo,0,0,0,,Aptallar.Dialogue: 0,0:20:53.92,0:20:59.44,Thoughts,Doflamingo,0,0,0,,Ahmak gençler, şans benden yana!Dialogue: 0,0:20:59.44,0:21:05.91,Thoughts,Doflamingo,0,0,0,,Caesar bende olduğu müddetçe SAD'ı gene üretirim.Dialogue: 0,0:21:10.40,0:21:13.42,Main,Baby 5,0,0,0,,Ne? Tankerin güvertesinde biri mi var öyle?!Dialogue: 0,0:21:13.42,0:21:18.12,Main,Buffalo,0,0,0,,Hayır, kimselerin o gazdan sağ kurtulabileceğini sanmıyorum.Dialogue: 0,0:21:23.86,0:21:25.16,Main,Baby 5,0,0,0,,Robot mu?!Dialogue: 0,0:21:30.10,0:21:33.50,Main,Franky,0,0,0,,Nasıl bir kuş bu böyle?Dialogue: 0,0:00:24.19,0:00:27.47,Credits,,0,0,0,,Translation & initial syncing Yibis FansubsDialogue: 0,0:00:27.62,0:00:30.74,Credits,,0,0,0,,Syncing Galaxy 9000  Sync-checking SewilDialogue: 0,0:00:31.19,0:00:34.31,Credits,,0,0,0,,Quality-checking Sewil Galaxy 9000 FeesoDialogue: 0,0:00:34.86,0:00:38.42,Credits,,0,0,0,,Soundtracking HaleeDialogue: 0,0:00:41.44,0:00:43.69,Credits,,0,0,0,,Video editing SewilDialogue: 0,0:00:43.74,0:00:45.92,Credits,,0,0,0,,Raw provider SOFCJ-RawsDialogue: 0,0:00:00.20,0:00:05.07,Hands Up lyrics,,0,0,0,,♪ Kaldır ellerini daha da yukarıya, hayallerini dök şarkılara. ♪Dialogue: 0,0:00:05.14,0:00:08.72,Hands Up lyrics,,0,0,0,,♪ Yıkılma hiçbir zaman, sarsılmaz bayrağını kaldır göklere. ♪Dialogue: 0,0:00:08.80,0:00:12.27,Hands Up lyrics,,0,0,0,,♪ Buralara kadar gelebilmek için pek çok duvarı yıkıp geçtik! ♪Dialogue: 0,0:00:12.34,0:00:17.68,Hands Up lyrics,,0,0,0,,♪ Hedef gelecek, haydi eller havaya!! ♪Dialogue: 0,0:00:23.31,0:00:30.66,Hands Up lyrics,,0,0,0,,♪ Uzansam biraz daha erişeceğim hemen cevaba. ♪Dialogue: 0,0:00:30.73,0:00:38.37,Hands Up lyrics,,0,0,0,,♪ İnanarak buna açılıyorum yeni dünyaya. ♪Dialogue: 0,0:00:38.40,0:00:45.86,Hands Up lyrics,,0,0,0,,♪ Aynen öyle, yapboz gibi birleşti hayal kırıntılarımız. ♪Dialogue: 0,0:00:45.91,0:00:50.41,Hands Up lyrics,,0,0,0,,♪ Aramızda hiç kopmayacak bağlar yaratarak,...Dialogue: 0,0:00:51.18,0:00:53.51,Hands Up lyrics,,0,0,0,,...daha aydınlık bir geleceğe. ♪Dialogue: 0,0:00:54.00,0:00:58.55,Hands Up lyrics,,0,0,0,,♪ Kaldır ellerini daha da yukarıya, hayallerini dök şarkılara. ♪Dialogue: 0,0:00:58.62,0:01:02.42,Hands Up lyrics,,0,0,0,,♪ Yıkılma hiçbir zaman, sarsılmaz bayrağını kaldır göklere. ♪Dialogue: 0,0:01:02.43,0:01:05.78,Hands Up lyrics,,0,0,0,,♪ Buralara kadar gelebilmek için pek çok duvarı yıkıp geçtik! ♪Dialogue: 0,0:01:05.83,0:01:09.80,Hands Up lyrics,,0,0,0,,♪ Hedefimiz gelecek! ♪Dialogue: 0,0:01:09.87,0:01:11.30,Hands Up lyrics,,0,0,0,,♪ Daha da yukarıya bak! ♪Dialogue: 0,0:01:11.34,0:01:13.48,Hands Up lyrics,,0,0,0,,♪ Sırtın hep dik olsun! ♪Dialogue: 0,0:01:13.53,0:01:14.94,Hands Up lyrics,,0,0,0,,♪ Bir an olsun durma! ♪Dialogue: 0,0:01:14.99,0:01:16.82,Hands Up lyrics,,0,0,0,,♪ Dalgaları aşa aşa! ♪Dialogue: 0,0:01:16.86,0:01:20.41,Hands Up lyrics,,0,0,0,,♪ Arzularımız birleşiyor yavaşça. ♪Dialogue: 0,0:01:20.44,0:01:24.65,Hands Up lyrics,,0,0,0,,♪ Haydi ilerisini hedef seçelim kendimize! ♪Dialogue: 0,0:01:24.91,0:01:31.06,Hands Up lyrics,,0,0,0,,♪ Dalgaları sürerek, akıyoruz ileriye. ♪Dialogue: 0,0:01:31.09,0:01:35.34,Hands Up lyrics,,0,0,0,,♪ İnsanlarla tanışıyor, elvedalar ediyoruz,...Dialogue: 0,0:01:35.36,0:01:39.09,Hands Up lyrics,,0,0,0,,...bir kez daha bu bayrağın altında. ♪Dialogue: 0,0:01:41.26,0:01:45.04,Hands Up lyrics,,0,0,0,,♪ Unutmak istemediğim acıları...Dialogue: 0,0:01:45.06,0:01:48.08,Hands Up lyrics,,0,0,0,,...o gün yüreğime gömdüm, saklıyorum orada. ♪Dialogue: 0,0:01:48.27,0:01:52.34,Hands Up lyrics,,0,0,0,,♪ Kimselere yenilmeyecek bir özgürlük bizimkisi,...Dialogue: 0,0:01:52.46,0:01:54.75,Hands Up lyrics,,0,0,0,,...sıkıca kavrayıp yoluma atıldığım. ♪Dialogue: 0,0:01:54.77,0:01:59.69,Hands Up lyrics,,0,0,0,,♪ Kaldır ellerini daha da yukarıya, hayallerini dök şarkılara. ♪Dialogue: 0,0:01:59.72,0:02:03.37,Hands Up lyrics,,0,0,0,,♪ Yıkılma hiçbir zaman, sarsılmaz bayrağını kaldır göklere. ♪Dialogue: 0,0:02:03.41,0:02:06.66,Hands Up lyrics,,0,0,0,,♪ Buralara kadar gelebilmek için pek çok duvarı yıkıp geçtik! ♪Dialogue: 0,0:02:06.69,0:02:10.83,Hands Up lyrics,,0,0,0,,♪ Hedefimiz gelecek! ♪Dialogue: 0,0:02:10.88,0:02:12.20,Hands Up lyrics,,0,0,0,,♪ Daha da yukarıya bak! ♪Dialogue: 0,0:02:12.25,0:02:14.53,Hands Up lyrics,,0,0,0,,♪ Sırtın hep dik olsun! ♪Dialogue: 0,0:02:14.53,0:02:15.90,Hands Up lyrics,,0,0,0,,♪ Bir an olsun durma! ♪Dialogue: 0,0:02:15.95,0:02:17.72,Hands Up lyrics,,0,0,0,,♪ Dalgaları aşa aşa! ♪Dialogue: 0,0:02:17.76,0:02:21.43,Hands Up lyrics,,0,0,0,,♪ Arzularımız birleşiyor yavaşça. ♪Dialogue: 0,0:02:21.50,0:02:24.97,Hands Up lyrics,,0,0,0,,♪ Haydi ilerisini hedef seçelim kendimize! ♪Dialogue: 0,0:02:24.99,0:02:29.89,Hands Up lyrics,,0,0,0,,♪ Eller havaya!! ♪