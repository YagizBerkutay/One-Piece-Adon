T,19.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.5,0.5,9,10,10,10,1Style: Hands Up lyrics,Futura Md BT,35,&H00FF762C,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2.0,0,8,10,10,30,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:02:29.97,0:02:35.66,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:19:07.40,0:19:10.40,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:02:29.97,0:02:35.66,Title,,0,0,0,,Gölgelerdeki Deha ve Gaz ile Lastiğin Savaşı!Dialogue: 0,0:02:47.88,0:02:53.63,Flashbacks,Law,0,0,0,,Beyaz Avcı, şimdilik ellerini Caesar'dan uzak tutman gerekecek.Dialogue: 0,0:02:53.63,0:02:57.63,Flashbacks,Law,0,0,0,,Eğer kalplerimizi ezmeye başlarlarsa çok dezavantajlı durumda kalırız.Dialogue: 0,0:02:58.33,0:03:03.93,Flashbacks,Law,0,0,0,,O yüzden kalbimi Vergo'dan alana değin aklına eseni yapmana izin veremem.Dialogue: 0,0:03:03.93,0:03:10.03,Flashbacks,Law,0,0,0,,Bu adada olduğun müddetçe emirlerim doğrultusunda hareket etmeni istiyorum. Anlaşıldı mı?Dialogue: 0,0:03:12.64,0:03:18.33,Thoughts,Smoker,0,0,0,,Olabildiğince hızlı bir şekilde en kısa yoldan geldim.Dialogue: 0,0:03:19.64,0:03:22.32,Thoughts,Smoker,0,0,0,,Neredesin Vergo?!Dialogue: 0,0:03:23.67,0:03:25.14,Main,Caesar,0,0,0,,Seni inatçı piç!Dialogue: 0,0:03:25.14,0:03:26.87,Main,Luffy,0,0,0,,Yakaladım!Dialogue: 0,0:03:30.19,0:03:31.03,Main,Caesar,0,0,0,,Hayır, yapamadın!Dialogue: 0,0:03:33.05,0:03:34.30,Main,Caesar,0,0,0,,Nenshokei! Dialogue: 0,0:03:33.05,0:03:34.30,Attack,Caesar,0,0,0,,Yanma SistemiDialogue: 0,0:03:40.37,0:03:41.67,Main,Caesar,0,0,0,,Miok Gas! Dialogue: 0,0:03:40.37,0:03:41.67,Attack,Caesar,0,0,0,,Miok GazıDialogue: 0,0:03:48.59,0:03:49.66,Main,Caesar,0,0,0,,Hasır Şapka!Dialogue: 0,0:03:50.25,0:03:53.44,Main,Caesar,0,0,0,,Bana saldırarak ne kazanmayı umuyorsun?Dialogue: 0,0:03:53.44,0:03:58.96,Main,Luffy,0,0,0,,Henüz bilmiyorum! Ama seni kaçırırsam çok enteresan şeyler olacak dediler bana.Dialogue: 0,0:03:58.96,0:04:04.34,Main,Caesar,0,0,0,,Yani bir ittifak mı kurdunuz?  Law mu önerdi bunu? O adama asla güvenemezsin!Dialogue: 0,0:04:04.34,0:04:07.11,Main,Caesar,0,0,0,,Kesinlikle sana ihanet edecektir! Yol yakınken vazgeç.Dialogue: 0,0:04:07.11,0:04:11.58,Main,Luffy,0,0,0,,Buna ben karar veririm!Dialogue: 0,0:04:11.58,0:04:13.76,Main,Caesar,0,0,0,,Aldığın ceza yetmedi mi seni adi lastik!?Dialogue: 0,0:04:15.11,0:04:16.45,Main,Caesar,0,0,0,,Karakuni! Dialogue: 0,0:04:15.11,0:04:16.45,Attack,Caesar,0,0,0,,Havasız DünyaDialogue: 0,0:04:20.73,0:04:22.71,Main,Luffy,0,0,0,,Nefes alamıyorum!Dialogue: 0,0:04:22.71,0:04:23.87,Main,Caesar,0,0,0,,Aynen öyle!Dialogue: 0,0:04:36.92,0:04:38.36,Main,Luffy,0,0,0,,Burada güvendeyim!Dialogue: 0,0:04:39.53,0:04:43.11,Main,Caesar,0,0,0,,Aynen, sadece belirli bir alanda nefes alamıyorsun!!Dialogue: 0,0:04:43.11,0:04:46.71,Main,Caesar,0,0,0,,Peki sonsuza kadar bu mesafeyi koruyabilir misin?Dialogue: 0,0:04:49.36,0:04:50.58,Main,Luffy,0,0,0,,Gomu gomu no...Dialogue: 0,0:04:52.53,0:04:54.65,Main,Luffy,0,0,0,,Jet Pistol! Dialogue: 0,0:04:52.53,0:04:54.65,Attack,Luffy,0,0,0,,Jet TabancaDialogue: 0,0:04:56.45,0:04:58.09,Main,Caesar,0,0,0,,Kahretsin, acıttı!Dialogue: 0,0:04:58.49,0:05:01.63,Main,Caesar,0,0,0,,Ancak daha fazla yaklaşırsan boğulursun!Dialogue: 0,0:05:03.00,0:05:03.99,Main,Luffy,0,0,0,,Tekrar olmaz!Dialogue: 0,0:05:03.99,0:05:08.02,Main,Caesar,0,0,0,,Canın yanıyor değil mi? Bak, oksijen hemen şuracıkta!Dialogue: 0,0:05:10.81,0:05:12.47,Main,Caesar,0,0,0,,Blue Sword! Dialogue: 0,0:05:10.81,0:05:12.47,Attack,Caesar,0,0,0,,Mavi KılıçDialogue: 0,0:05:15.00,0:05:15.54,Main,Luffy,0,0,0,,Yine!Dialogue: 0,0:05:15.54,0:05:17.40,Main,Caesar,0,0,0,,İzle bunu! Yanıp kül olacaksın!Dialogue: 0,0:05:21.83,0:05:29.47,Main,Caesar,0,0,0,,Bütün gazları kontrol edebilirim! Zehirli gaz işe yaramıyorsa sana birçok farklı şekilde saldırabilirim!Dialogue: 0,0:05:42.64,0:05:44.09,Main,Luffy,0,0,0,,Silahlanma Hakisi!Dialogue: 0,0:05:50.09,0:05:50.72,Main,Caesar,0,0,0,,Ne—Dialogue: 0,0:05:56.41,0:05:57.90,Main,Luffy,0,0,0,,Gomu Gomu no...Dialogue: 0,0:05:58.33,0:06:00.20,Main,Luffy,0,0,0,,Jet Gatling! Dialogue: 0,0:05:58.33,0:06:00.20,Attack,Luffy,0,0,0,,Jet MitralyözDialogue: 0,0:06:03.63,0:06:05.66,Main,Luffy,0,0,0,,Bu da ne?! Duvar mı?!Dialogue: 0,0:06:05.66,0:06:06.75,Main,Monet,0,0,0,,Kamakura. Dialogue: 0,0:06:05.66,0:06:06.75,Attack,Monet,0,0,0,,Kar KulübesiDialogue: 0,0:06:06.75,0:06:11.11,Main,Monet,0,0,0,,Etkilendim doğrusu.  Ortalama bir korsan bu duvarı kıramazdı.Dialogue: 0,0:06:14.71,0:06:16.60,Main,Luffy,0,0,0,,Şeytan meyvesi kullanıcısı mısın?Dialogue: 0,0:06:18.23,0:06:22.56,Main,Monet,0,0,0,,Master, gitmelisiniz. Anlamsız bir mücadele bu.Dialogue: 0,0:06:22.56,0:06:23.96,Main,Caesar,0,0,0,,Doğru dedin.Dialogue: 0,0:06:23.96,0:06:24.73,Main,Luffy,0,0,0,,Kaçıyor musun?!Dialogue: 0,0:06:24.73,0:06:28.52,Main,Caesar,0,0,0,,Güle güle Hasır Şapka! Gönlünce dağıt burayı!Dialogue: 0,0:06:28.52,0:06:33.51,Main,Caesar,0,0,0,,Sizi başarılı bir şekilde nasıl deney malzemem hâline getireceğimi biliyorum ben!Dialogue: 0,0:06:33.51,0:06:35.20,Main,Caesar,0,0,0,,Dört gözle bekleyin!Dialogue: 0,0:06:37.63,0:06:38.30,Main,Luffy,0,0,0,,Bekle!Dialogue: 0,0:06:39.34,0:06:41.84,Main,Monet,0,0,0,,Arkasından gitmene izin veremem.Dialogue: 0,0:06:41.84,0:06:44.87,Main,Monet,0,0,0,,Master'a bir şey olacak olursa...Dialogue: 0,0:06:45.94,0:06:48.41,Main,Monet,0,0,0,,...Joker beni öldürür.Dialogue: 0,0:06:49.65,0:06:53.92,Main,Luffy,0,0,0,,Savaşta gördüğüm şu kuş adam değil mi o? Kimin nesi ki o herif?!Dialogue: 0,0:06:54.12,0:06:58.62,Captions,Sign,0,0,180,,A ve B Binaları için Bağlantı GeçidiDialogue: 0,0:06:55.79,0:06:58.13,Main,Marine,0,0,0,,Acele edin! Kapı kapanıyor!Dialogue: 0,0:06:58.13,0:06:59.65,Main,Marine,0,0,0,,Koşun!Dialogue: 0,0:06:59.65,0:07:01.75,Main,Marine,0,0,0,,Hasır Şapka tayfasından Kara Bacak mı bu?!Dialogue: 0,0:07:01.75,0:07:04.40,Main,Marine,0,0,0,,Bize neden yardım ediyor ki?Dialogue: 0,0:07:04.40,0:07:07.25,Main,Sanji,0,0,0,,Flanchet... Dialogue: 0,0:07:04.40,0:07:07.25,Attack,Sanji,0,0,0,,PançetaDialogue: 0,0:07:04.40,0:07:07.25,Note,Sanji,0,0,0,,Son kaburga ile kalça arasındaki etDialogue: 0,0:07:07.25,0:07:08.52,Main,Sanji,0,0,0,,...Strike! Dialogue: 0,0:07:07.25,0:07:08.52,Attack,Sanji,0,0,0,,VuruşuDialogue: 0,0:07:11.33,0:07:12.72,Main,Marine,0,0,0,,Çok güçlü!Dialogue: 0,0:07:15.19,0:07:20.11,Main,Marine,0,0,0,,Hasır Şapka'ların Kara Bacak'ı sahte Vergo'yla dövüşüyor!Dialogue: 0,0:07:20.11,0:07:21.38,Main,Marine,0,0,0,,Ona destek olmamız lazım!Dialogue: 0,0:07:21.74,0:07:24.02,Main,Sanji,0,0,0,,Ne yapıyorsunuz siz burada hâlâ?! Kaçın gidin hadi!Dialogue: 0,0:07:24.59,0:07:27.83,Main,Sanji,0,0,0,,Burası kilitlendiğinde burayı zehirli gazla dolduracaklar!Dialogue: 0,0:07:31.14,0:07:32.03,Main,Sanji,0,0,0,,Gördünüz mü size söylemiştim!Dialogue: 0,0:07:32.75,0:07:36.04,Main,Marine,0,0,0,,Ölümcül gaz geliyor! Kaçın!Dialogue: 0,0:07:41.44,0:07:48.89,Main,Sanji,0,0,0,,Anlıyorum. Demek demirden falan yapılmış bu herif.Dialogue: 0,0:07:49.73,0:07:54.62,Main,Vergo,0,0,0,,Bu işe karşıma. Bu benimle onların arasında.Dialogue: 0,0:07:55.09,0:07:58.85,Main,Sanji,0,0,0,,Kaptanımızın en çok nefret ettiği pislik türüsün.Dialogue: 0,0:08:06.97,0:08:08.08,Thoughts,Sanji,0,0,0,,Bu adam...!Dialogue: 0,0:08:13.56,0:08:15.93,Main,Marine,0,0,0,,Kara Bacak abi!Dialogue: 0,0:08:15.93,0:08:18.98,Main,Marine,0,0,0,,Kapı kapanmak üzere! Gel hadi bu tarafa!Dialogue: 0,0:08:20.13,0:08:23.96,Main,Marine,0,0,0,,Zehirli gaz hemen ardında! Acele et!Dialogue: 0,0:08:29.49,0:08:31.84,Main,Soldier,0,0,0,,D binasından sesleniyorum! D binasından sesleniyorum!Dialogue: 0,0:08:31.84,0:08:34.69,Main,Soldier,0,0,0,,Üçüncü laboratuvarın tüm binalarına yapılan acil durum mesajıdır bu!Dialogue: 0,0:08:34.69,0:08:36.24,Main,Caesar,0,0,0,,Bu da nesi?!Dialogue: 0,0:08:36.24,0:08:40.98,Main,Soldier,0,0,0,,D binasından sesleniyorum! Üçüncü laboratuvarın tüm binalarına yapılan acil durum mesajıdır bu!Dialogue: 0,0:08:40.98,0:08:50.06,Main,Soldier,0,0,0,,Kısa süre önce Shichibukai Trafalgar Law SAD üretim odasına giriş yaptı!Dialogue: 0,0:08:53.86,0:08:57.23,Main,Caesar,0,0,0,,Neler oluyor?! Aklını mı kaçırmış bu adi herif?!Dialogue: 0,0:08:57.68,0:09:03.48,Main,Caesar,0,0,0,,Eğer gerçekten ona müdahale ederse çok pişman olacak!Dialogue: 0,0:09:05.66,0:09:07.17,Main,Vergo,0,0,0,,Amacı buymuş demek ki!Dialogue: 0,0:09:07.77,0:09:09.29,Main,Sanji,0,0,0,,Ne oldu?!Dialogue: 0,0:09:10.34,0:09:13.85,Main,Monet,0,0,0,,Master'ı kaçırmak sonra da SAD'in...Dialogue: 0,0:09:13.85,0:09:16.61,Main,Monet,0,0,0,,Şimdi neyin peşinde olduğunuzu görebiliyorum.Dialogue: 0,0:09:26.05,0:09:31.06,Main,Vergo,0,0,0,,Law karşı saldırı yapmak için Hasır Şapka'yla ittifak kurdu!Dialogue: 0,0:09:31.06,0:09:35.24,Main,Vergo,0,0,0,,Sırf o odaya girebilmek için de Shichibukai olmuş!Dialogue: 0,0:09:35.65,0:09:39.02,Captions,Sign,0,0,180,,SAD Üretim OdasıDialogue: 0,0:09:37.04,0:09:39.02,Main,Vergo,0,0,0,,Lanet olası velet!Dialogue: 0,0:09:40.56,0:09:45.16,Main,Vergo,0,0,0,,Olabilecek en kötü senaryoyu planlıyor olmalı!Dialogue: 0,0:09:47.02,0:09:48.72,Main,Vergo,0,0,0,,Yeni Dünya'nın...Dialogue: 0,0:09:50.75,0:09:52.61,Main,Vergo,0,0,0,,...dengesini tamamen bozmaya mı niyetli?Dialogue: 0,0:09:57.78,0:10:00.81,Captions,Sign,0,0,180,,A ve B Binaları için Bağlantı GeçidiDialogue: 0,0:09:57.78,0:10:00.81,Main,Soldier,0,0,0,,Hain Trafalgar Law...Dialogue: 0,0:10:00.81,0:10:03.43,Main,Marine,0,0,0,,Bekle! Kapıyı kapatmayın!Dialogue: 0,0:10:03.43,0:10:06.38,Main,Marine,0,0,0,,Sahte Vergo ve "Kara Bacak" abi hâlâ oradalar!Dialogue: 0,0:10:07.88,0:10:09.78,Main,Marine,0,0,0,,Kapandı!Dialogue: 0,0:10:09.78,0:10:14.20,Main,Marine,0,0,0,,Çok geç! Öteki taraf ölümcül gazla doldu bile!Dialogue: 0,0:10:14.20,0:10:15.31,Main,Marine,0,0,0,,Kara Bacak!Dialogue: 0,0:10:15.68,0:10:17.24,Main,Marine,0,0,0,,Abi!Dialogue: 0,0:10:17.24,0:10:19.69,Main,Marine,0,0,0,,Kara Bacak abi!Dialogue: 0,0:10:20.93,0:10:23.81,Main,Sanji,0,0,0,,İyi misin!? Donanmanın...Dialogue: 0,0:10:23.81,0:10:24.41,Main,Marine,0,0,0,,Bu...Dialogue: 0,0:10:24.99,0:10:27.20,Main,Sanji,0,0,0,,...gelmiş geçmiş en tatlı kız!Dialogue: 0,0:10:27.20,0:10:28.19,Main,Marine,0,0,0,,Kara Bacak!Dialogue: 0,0:10:28.19,0:10:30.99,Main,Marine,0,0,0,,Kara Bacak abi!Dialogue: 0,0:10:30.99,0:10:32.64,Main,Marine,0,0,0,,Hayatta olmana çok sevindim var ya!Dialogue: 0,0:10:32.64,0:10:34.05,Main,Marine,0,0,0,,Çok minnettarız!Dialogue: 0,0:10:34.05,0:10:40.02,Main,Sanji,0,0,0,,Kapayın çenenizi be lanet herifler! Bakın, yalnızca güzel kadınların övgülerini kabul ederim!Dialogue: 0,0:10:41.27,0:10:44.66,Main,Marine,0,0,0,,Kara Bacak, yaralanmadığına gerçekten çok sevindik!Dialogue: 0,0:10:44.66,0:10:48.65,Main,Sanji,0,0,0,,Kes be! Sadece güzel kadınların ilgisini ve sempatisini kabul ederim!Dialogue: 0,0:10:49.50,0:10:52.49,Thoughts,Sanji,0,0,0,,Ucuz atlattım. Onunla dövüşmeye devam etseydim...Dialogue: 0,0:10:52.49,0:10:56.39,Main,Sanji,0,0,0,,O değil de nesi var o herifin? Sizin komutanınız falan değil miydi?Dialogue: 0,0:10:56.39,0:10:57.60,Main,Marine,0,0,0,,Saçmalamasana!Dialogue: 0,0:10:57.60,0:11:00.40,Main,Marine,0,0,0,,Koramiral Vergo olmasına imkan yok onun!Dialogue: 0,0:11:00.40,0:11:01.69,Main,Marine,0,0,0,,Sahtekârın tekiydi işte!Dialogue: 0,0:11:01.69,0:11:03.39,Main,Marine,0,0,0,,Değil mi, Albay-chan?Dialogue: 0,0:11:04.34,0:11:10.90,Main,Tashigi,0,0,0,,Hiç şüphesiz! Gerçek Vergo size bunu yapmaz, o sizin babanız gibidir!Dialogue: 0,0:11:10.90,0:11:12.71,Main,Tashigi,0,0,0,,Asla böyle bir şey yapmaz.Dialogue: 0,0:11:12.71,0:11:17.77,Main,Sanji,0,0,0,,Sahtekar ya da değil,  rengi atıp aniden ortadan kayboldu.Dialogue: 0,0:11:17.77,0:11:19.20,Main,Tashigi,0,0,0,,Biz de acele etmeliyiz!Dialogue: 0,0:11:19.20,0:11:21.93,Main,Tashigi,0,0,0,,Çocukları kurtarıp buradan kaçmalıyız!Dialogue: 0,0:11:21.93,0:11:23.20,Main,Marine,0,0,0,,Evet!Dialogue: 0,0:11:23.20,0:11:25.45,Main,Marine,0,0,0,,Tam arkanızdayız Albay-chan!Dialogue: 0,0:11:25.63,0:11:27.17,Captions,Sign,0,0,180,,B Binasının İçiDialogue: 0,0:11:28.48,0:11:30.78,Main,Doflamingo,0,0,0,,Law, SAD'ın peşinde demek?Dialogue: 0,0:11:30.78,0:11:34.45,Main,Vergo,0,0,0,,Evet, böylece Law'ın ihaneti kesinleşmiş oldu.Dialogue: 0,0:11:41.17,0:11:43.82,Main,Doflamingo,0,0,0,,Tıpkı düşündüğüm gibi!Dialogue: 0,0:11:40.90,0:11:45.09,Captions,Sign,0,0,180,,Yeni Dünya, DressrosaDialogue: 0,0:11:45.18,0:11:48.64,Main,Doflamingo,0,0,0,,Ona kardeşim gibi davranıp...Dialogue: 0,0:11:46.60,0:11:52.29,Captions,Sign,0,0,240,,Shichibukai Donquixote Doflamingo (Yeraltı Simsarı: Joker)Dialogue: 0,0:11:48.64,0:11:52.29,Main,Doflamingo,0,0,0,,...elimde büyüttüm sayılır.Dialogue: 0,0:11:52.80,0:11:54.24,Main,Doflamingo,0,0,0,,Çok yazık.Dialogue: 0,0:11:55.01,0:11:56.45,Main,Vergo,0,0,0,,Anlayabiliyorum.Dialogue: 0,0:11:56.45,0:11:59.37,Main,Doflamingo,0,0,0,,SAD üretim odasında demek?Dialogue: 0,0:12:03.44,0:12:10.34,Main,Doflamingo,0,0,0,,Onun yerinde olsam önce o odayı yok ederdim.Dialogue: 0,0:12:17.22,0:12:19.89,Main,Doflamingo,0,0,0,,Sonra da Caesar'ı kaçırırdım sanırım.Dialogue: 0,0:12:20.69,0:12:23.86,Main,Doflamingo,0,0,0,,Gerçi yok, ben olsam öldürürdüm onu.Dialogue: 0,0:12:23.86,0:12:29.20,Main,Doflamingo,0,0,0,,Çünkü Caesar dünyada...Dialogue: 0,0:12:30.74,0:12:34.67,Main,Doflamingo,0,0,0,,...SAD üretmeyi bilen yegâne kişi.Dialogue: 0,0:12:34.67,0:12:40.83,Main,Doflamingo,0,0,0,,Tabii bunu yaparsa başım büyük belaya girer, Vergo.Dialogue: 0,0:12:43.45,0:12:50.41,Main,Doflamingo,0,0,0,,Caesar öldürülecek olursa hiç kimse o gazı üretemez. Tabii doğal olarak yaptığım iş etkilenir.Dialogue: 0,0:12:50.73,0:12:56.12,Main,Buffalo,0,0,0,,Biraz sakinleş-in, Bebek 5!  Genç efendi ile ne alıp veremediğin var-in?Dialogue: 0,0:12:56.12,0:13:02.10,Main,Baby-Five,0,0,0,,Bu sefer onu bağışlamayacağım! Adi herifi geberteceğim!Dialogue: 0,0:13:02.10,0:13:05.07,Main,Doflamingo,0,0,0,,Ama şimdi sen böyle yaparsan, sonra ne olacak peki?Dialogue: 0,0:13:05.07,0:13:06.23,Main,Machvise,0,0,0,,Dialogue: 0,0:13:06.81,0:13:09.07,Main,Doflamingo,0,0,0,,Ondan sonra...Dialogue: 0,0:13:10.39,0:13:12.66,Main,Doflamingo,0,0,0,,...talihsizlikler bir bir bizi bulur!Dialogue: 0,0:13:13.35,0:13:19.49,Main,Jora,0,0,0,,Şirin Law-chan'a ne yapmayı düşünüyorsun Genç Efendi?Dialogue: 0,0:13:19.49,0:13:25.05,Main,Lao G,0,0,0,,Yapacağı şey belli! Law bize karşı geldi. Haksız mıyım, Genç Efendi?Dialogue: 0,0:13:25.05,0:13:30.56,Main,Doflamingo,0,0,0,,Bunu yapmak zorunda kalmak senin zor olacak ama Law'dan kurtalman gerekiyor.Dialogue: 0,0:13:30.56,0:13:37.50,Main,Doflamingo,0,0,0,,Onu doğduğuna pişman olacak kadar acınası bir şekilde öldür!Dialogue: 0,0:13:38.38,0:13:40.08,Main,Vergo,0,0,0,,Anlaşıldı.Dialogue: 0,0:13:40.08,0:13:44.17,Main,Vergo,0,0,0,,Görmen için cesedin fotoğrafını sana yollayacağım, Doffy.Dialogue: 0,0:13:46.28,0:13:49.52,Main,Vergo,0,0,0,,Dressrosa'da aldığım kamerayı kullanacağım.Dialogue: 0,0:13:49.52,0:13:53.36,Main,Doflamingo,0,0,0,,Kamera falan almadın ki sen.Dialogue: 0,0:13:53.36,0:13:57.33,Main,Vergo,0,0,0,,Doğru, hiç kamera satın almamıştımDialogue: 0,0:13:57.33,0:13:59.60,Main,Vergo,0,0,0,,Öyleyse kulaklarından birini getireceğim.Dialogue: 0,0:14:00.99,0:14:02.91,Main,Doflamingo,0,0,0,,Dört gözle bekliyorum.Dialogue: 0,0:14:04.34,0:14:06.92,Main,Doflamingo,0,0,0,,Caesar, Monet, beni duyuyor musunuz?Dialogue: 0,0:14:06.92,0:14:08.71,Main,Monet,0,0,0,,Evet, Joker.Dialogue: 0,0:14:08.71,0:14:10.62,Main,Caesar,0,0,0,,Ah, Joker!Dialogue: 0,0:14:10.94,0:14:18.53,Main,Doflamingo,0,0,0,,Law'a karşı elbette dikkatli olacaksınız da Hasır Şapka'yı da hafife almayın. Kralın Hakisi var o çocukta.Dialogue: 0,0:14:18.53,0:14:21.02,Main,Doflamingo,0,0,0,,Law'dan bile bir gömlek üstün olabilir.Dialogue: 0,0:14:23.30,0:14:27.19,Main,Doflamingo,0,0,0,,Burada kanı kaynayan bir hatun var.Dialogue: 0,0:14:27.19,0:14:30.85,Main,Doflamingo,0,0,0,,Bebek 5'le Bufalo'yu oraya göndereceğim.Dialogue: 0,0:14:30.85,0:14:34.78,Main,Doflamingo,0,0,0,,Orasını halledince hepinizin Dressrosa'ya gelmenizi istiyorum.Dialogue: 0,0:14:34.78,0:14:35.90,Main,Monet,0,0,0,,Elbette.Dialogue: 0,0:14:35.90,0:14:37.12,Main,Caesar,0,0,0,,Emredersiniz.Dialogue: 0,0:14:40.24,0:14:42.66,Captions,Sign,0,0,180,,B Binasının İçi - Kahverengisakal Otobüsü ve YolcularıDialogue: 0,0:14:46.67,0:14:52.47,Main,Zoro,0,0,0,,Bu ejderha şu öteki büyük olandan daha baş belası çıktı. Çok çevik.Dialogue: 0,0:14:52.47,0:14:56.07,Main,Brownbeard,0,0,0,,Ne diye uzandın öyle? Durdursana şu ejderhayı!Dialogue: 0,0:14:57.69,0:14:59.81,Main,Robin,0,0,0,,B binası çoktan alev denizine dönüştü bile.Dialogue: 0,0:15:01.14,0:15:05.62,Main,Usopp,0,0,0,,Onu durdurmazsak şu tanklardan biri alev alıp patlayabilir.Dialogue: 0,0:15:05.62,0:15:10.41,Main,Brownbeard,0,0,0,,Dış duvar yıkılır ve ölümcül gaz buraya dolmaya başlar!Dialogue: 0,0:15:10.41,0:15:14.49,Main,Brownbeard,0,0,0,,Böyle bir şeyin olmasına izin verirsek kimse sağ kurtulamaz!Dialogue: 0,0:15:14.90,0:15:16.87,Main,Kin'emon,0,0,0,,Bekleyin bakalım ahali!Dialogue: 0,0:15:17.75,0:15:22.00,Main,Kin'emon,0,0,0,,İş ejderhalara gelince bir şey yapmadan duramam!Dialogue: 0,0:15:23.59,0:15:26.32,Main,Kin'emon,0,0,0,,Hepsinden nefret ediyorum!Dialogue: 0,0:15:26.32,0:15:28.59,Main,Kin'emon,0,0,0,,İki elime yemin ederim ki...—Dialogue: 0,0:15:28.59,0:15:34.02,Main,Brook,0,0,0,,Hayır, hayır, O ejderhayı asıl ben asla affedemem!Dialogue: 0,0:15:34.80,0:15:37.76,Main,Brook,0,0,0,,Hepiniz az önce bana nasıl davrandığını gördünüz, değil mi?Dialogue: 0,0:15:38.85,0:15:41.47,Main,Brook,0,0,0,,Tam beni yemeğe hazırlanıyordu ki...Dialogue: 0,0:15:41.47,0:15:44.75,Main,Brook,0,0,0,,...gözlerimin önünde bana hayal kırıklığı dolu bir bakış attı!Dialogue: 0,0:15:44.75,0:15:46.96,Main,Usopp,0,0,0,,Yenecek etin yok ki.Dialogue: 0,0:15:47.26,0:15:50.30,Main,Brook,0,0,0,,Kemikler de oldukça besleyicidir!Dialogue: 0,0:15:50.30,0:15:51.86,Main,Usopp,0,0,0,,Peki! Aklımda tutmaya çalışırım.Dialogue: 0,0:15:51.86,0:15:55.57,Main,Brook,0,0,0,,Kin'emon-san, izin verin bununla ben ilgileneyim!Dialogue: 0,0:15:55.57,0:15:58.57,Main,Kin'emon,0,0,0,,Ne diyorsun sen yahu! Geri çekil!Dialogue: 0,0:15:58.57,0:15:59.83,Main,Brook,0,0,0,,Hayır, ben yapacağım!Dialogue: 0,0:15:59.83,0:16:00.70,Main,Kin'emon,0,0,0,,Ben yapacağım!Dialogue: 0,0:16:00.70,0:16:01.64,Main,Brook,0,0,0,,Ben!Dialogue: 0,0:16:01.64,0:16:02.44,Main,Kin'emon,0,0,0,,Ben yapacağım!Dialogue: 0,0:16:02.44,0:16:03.47,Main,Brook,0,0,0,,Ben!Dialogue: 0,0:16:03.47,0:16:07.29,Main,Nami,0,0,0,,Gel bakalım, gel bakalım! Nin, nin, nin!Dialogue: 0,0:16:07.29,0:16:08.94,Main,Brownbeard,0,0,0,,Ne yapıyorsun sen?Dialogue: 0,0:16:08.94,0:16:10.08,Main,Nami,0,0,0,,Samuray numarası yapıyorum.Dialogue: 0,0:16:10.08,0:16:11.55,Main,Usopp,0,0,0,,Ninja mı demek istedin?Dialogue: 0,0:16:12.98,0:16:13.62,Main,Nami,0,0,0,,Geliyor!Dialogue: 0,0:16:13.62,0:16:14.96,Main,Nami,0,0,0,,Thunder Trap! Dialogue: 0,0:16:13.62,0:16:14.96,Attack,Nami,0,0,0,,Yıldırım TuzağıDialogue: 0,0:16:18.00,0:16:20.10,Main,Brook,0,0,0,,Benim olacaktı o!Dialogue: 0,0:16:20.10,0:16:23.90,Main,Kin'emon,0,0,0,,Ninjutsu mu kullanabiliyorsun meme bantlı kız?Dialogue: 0,0:16:24.28,0:16:25.77,Main,Nami,0,0,0,,Bana öyle seslenme!Dialogue: 0,0:16:26.39,0:16:29.08,Main,Usopp,0,0,0,,Dünyadaki en iğrenç kokulu çiçeği kokla bakalım!Dialogue: 0,0:16:29.08,0:16:32.14,Main,Usopp,0,0,0,,Hisatsu Midori Boshi: Rafflesia! Dialogue: 0,0:16:29.08,0:16:32.14,Attack,Usopp,0,0,0,,Ölümcül Yeşil Yıldız: RaflesyaDialogue: 0,0:16:36.93,0:16:41.16,Main,Kin'emon,0,0,0,,Vay canına! Koca burunlu youkai, büyü kullanabiliyor! Dialogue: 0,0:16:36.93,0:16:41.16,Note,Kin'emon,0,0,0,,Youkai: Japon folklorunda doğaüstü canavarlar, ruhlar ve iblislerdir.Dialogue: 0,0:16:41.16,0:16:42.42,Main,Usopp,0,0,0,,Kime youkai diyorsun sen be?!Dialogue: 0,0:16:42.84,0:16:46.03,Main,Robin,0,0,0,,Cuarenta Fleur! Cuatro Mano! Dialogue: 0,0:16:42.84,0:16:46.03,Attack,Robin,0,0,0,,40 Çiçek, 4 El!Dialogue: 0,0:16:49.31,0:16:50.13,Main,Kin'emon,0,0,0,,Hold! Dialogue: 0,0:16:49.31,0:16:50.13,Attack,Kin'emon,0,0,0,,Zapt etDialogue: 0,0:16:50.94,0:16:52.77,Main,Kin'emon,0,0,0,,Metres bile ninjutsu kullanıyor!Dialogue: 0,0:16:55.11,0:16:58.07,Main,Brook,0,0,0,,Düşüyor! İşini bitireceğim!Dialogue: 0,0:16:58.07,0:17:00.22,Main,Kin'emon,0,0,0,,Hayır, bana bırak!Dialogue: 0,0:17:06.04,0:17:09.15,Main,Kin'emon,0,0,0,,Beni izle, Ceset-dono!Dialogue: 0,0:17:10.97,0:17:15.68,Main,Kin'emon,0,0,0,,Kitsunebi-Ryu! Homura Saki! Dialogue: 0,0:17:10.97,0:17:15.68,Attack,Kin'emon,0,0,0,,Tilki Ateşi Stili: Alev BölünmesiDialogue: 0,0:17:16.60,0:17:17.93,Main,Zoro,0,0,0,,Yine ateşi kesti!Dialogue: 0,0:17:17.93,0:17:18.89,Main,Brook,0,0,0,,İyi iş!Dialogue: 0,0:17:19.19,0:17:20.33,Main,Kin'emon,0,0,0,,Bu hiçbir şey.Dialogue: 0,0:17:22.24,0:17:24.13,Main,Brook,0,0,0,,Gavotte Bond en Avant!Dialogue: 0,0:17:22.24,0:17:24.13,Attack,Brook,0,0,0,,Gavot Öne SıçrayışDialogue: 0,0:17:24.94,0:17:26.30,Main,Kin'emon,0,0,0,,Karyu Issen! Dialogue: 0,0:17:24.94,0:17:26.30,Attack,Kin'emon,0,0,0,,Havai Fişek PatlamasıDialogue: 0,0:17:35.52,0:17:36.92,Main,Brook,0,0,0,,Kime ceset diyorsun sen?!Dialogue: 0,0:17:37.46,0:17:39.22,Main,Brook,0,0,0,,Sahi, cesedim yahu ben.Dialogue: 0,0:17:40.91,0:17:42.09,Main,Usopp,0,0,0,,Yaşasın!Dialogue: 0,0:17:42.09,0:17:43.51,Main,Robin,0,0,0,,Başardık!Dialogue: 0,0:17:43.51,0:17:45.31,Main,Usopp,0,0,0,,Mutlak galibiyet bu!Dialogue: 0,0:17:46.81,0:17:48.79,Main,Brook,0,0,0,,"Kemikler çok lezzetlidir." de bakayım!Dialogue: 0,0:17:48.79,0:17:52.16,Main,Kin'emon,0,0,0,,Seni sinir bozucu ejderha bozuntusu!Dialogue: 0,0:17:52.16,0:17:53.38,Main,Kin'emon,0,0,0,,Pislik, pislik!Dialogue: 0,0:17:54.18,0:18:01.45,Main,Brook,0,0,0,,Hadi kendimi anlıyorum da Kin'emon-san neden ailenize kıymış gibi ejderhayı tekmeliyorsunuz ki?Dialogue: 0,0:18:04.35,0:18:07.53,Main,Kin'emon,0,0,0,,Ailemin öldürülmesinden bir farkı yok!Dialogue: 0,0:18:08.47,0:18:10.00,Main,Brook,0,0,0,,Şimdi yani...Dialogue: 0,0:18:10.00,0:18:13.18,Main,Nami,0,0,0,,İkiniz de hemen atlayın yoksa sizi geride bırakırız!Dialogue: 0,0:18:13.18,0:18:16.28,Main,Brook,0,0,0,,Bizi bekleyin lütfen!Dialogue: 0,0:18:16.91,0:18:19.59,Main,Nami,0,0,0,,Durun biraz! Şuna bakın!Dialogue: 0,0:18:22.53,0:18:24.05,Main,Robin,0,0,0,,Bu ses...Dialogue: 0,0:18:30.34,0:18:32.70,Main,Nami,0,0,0,,Chopper canavara dönüşmüş!Dialogue: 0,0:18:33.97,0:18:36.05,Main,Zoro,0,0,0,,Ne yapıyor bu?Dialogue: 0,0:18:36.20,0:18:38.33,Captions,Sign,0,0,180,,B Binası 2. Kat - Muayene OdasıDialogue: 0,0:18:39.30,0:18:42.11,Main,Soldier,0,0,0,,Bir sıkıntı yok gibi.Dialogue: 0,0:18:43.81,0:18:45.44,Main,Soldier,0,0,0,,Bisküvi odasına dönebilirsin.Dialogue: 0,0:18:45.44,0:18:46.33,Main,Child,0,0,0,,Gerçekten mi?Dialogue: 0,0:18:46.33,0:18:47.47,Main,Soldier,0,0,0,,Orada senin için şeker var.Dialogue: 0,0:18:47.47,0:18:48.75,Main,Child,0,0,0,,Yaşasın!Dialogue: 0,0:18:50.75,0:18:54.25,Main,Child,0,0,0,,Baksanıza, aklıma gelmişken... Diğer çocuk nereye gitti?Dialogue: 0,0:18:55.53,0:18:56.36,Main,Soldier,0,0,0,,Diğer çocuk mu?Dialogue: 0,0:18:56.36,0:18:57.47,Main,Child,0,0,0,,Evet.Dialogue: 0,0:18:58.84,0:19:01.44,Main,Child,0,0,0,,Kimsenin girmesine izin verilmeyen "gizli oda" ya girmiş ve...Dialogue: 0,0:19:01.91,0:19:04.99,Main,Child,0,0,0,,...küçük bir ejderhaya dönüşmüştü.Dialogue: 0,0:19:04.99,0:19:07.39,Main,Child,0,0,0,,Momonosuke isimli çocuğu diyorum.Dialogue: 0,0:00:24.22,0:00:27.46,Credits,,0,0,0,,Translation & initial syncing Kousei FansubsDialogue: 0,0:00:27.62,0:00:30.71,Credits,,0,0,0,,Syncing Galaxy 9000  Sync-checking SewilDialogue: 0,0:00:31.19,0:00:34.32,Credits,,0,0,0,,Quality-checking SewilDialogue: 0,0:00:34.86,0:00:38.44,Credits,,0,0,0,,Soundtracking HaleeDialogue: 0,0:00:41.41,0:00:43.68,Credits,,0,0,0,,Video editing SewilDialogue: 0,0:00:43.73,0:00:45.96,Credits,,0,0,0,,Title card artist lucas2265Dialogue: 0,0:00:00.20,0:00:05.07,Hands Up lyrics,,0,0,0,,♪ Kaldır ellerini daha da yukarıya, hayallerini dök şarkılara. ♪Dialogue: 0,0:00:05.14,0:00:08.72,Hands Up lyrics,,0,0,0,,♪ Yıkılma hiçbir zaman, sarsılmaz bayrağını kaldır göklere. ♪Dialogue: 0,0:00:08.80,0:00:12.27,Hands Up lyrics,,0,0,0,,♪ Buralara kadar gelebilmek için pek çok duvarı yıkıp geçtik! ♪Dialogue: 0,0:00:12.34,0:00:17.68,Hands Up lyrics,,0,0,0,,♪ Hedef gelecek, haydi eller havaya!! ♪Dialogue: 0,0:00:23.31,0:00:30.66,Hands Up lyrics,,0,0,0,,♪ Uzansam biraz daha erişeceğim hemen cevaba. ♪Dialogue: 0,0:00:30.73,0:00:38.37,Hands Up lyrics,,0,0,0,,♪ İnanarak buna açılıyorum yeni dünyaya. ♪Dialogue: 0,0:00:38.40,0:00:45.86,Hands Up lyrics,,0,0,0,,♪ Aynen öyle, yapboz gibi birleşti hayal kırıntılarımız. ♪Dialogue: 0,0:00:45.91,0:00:50.41,Hands Up lyrics,,0,0,0,,♪ Aramızda hiç kopmayacak bağlar yaratarak,...Dialogue: 0,0:00:51.18,0:00:53.51,Hands Up lyrics,,0,0,0,,...daha aydınlık bir geleceğe. ♪Dialogue: 0,0:00:54.00,0:00:58.55,Hands Up lyrics,,0,0,0,,♪ Kaldır ellerini daha da yukarıya, hayallerini dök şarkılara. ♪Dialogue: 0,0:00:58.62,0:01:02.42,Hands Up lyrics,,0,0,0,,♪ Yıkılma hiçbir zaman, sarsılmaz bayrağını kaldır göklere. ♪Dialogue: 0,0:01:02.43,0:01:05.78,Hands Up lyrics,,0,0,0,,♪ Buralara kadar gelebilmek için pek çok duvarı yıkıp geçtik! ♪Dialogue: 0,0:01:05.83,0:01:09.80,Hands Up lyrics,,0,0,0,,♪ Hedefimiz gelecek! ♪Dialogue: 0,0:01:09.87,0:01:11.30,Hands Up lyrics,,0,0,0,,♪ Daha da yukarıya bak! ♪Dialogue: 0,0:01:11.34,0:01:13.48,Hands Up lyrics,,0,0,0,,♪ Sırtın hep dik olsun! ♪Dialogue: 0,0:01:13.53,0:01:14.94,Hands Up lyrics,,0,0,0,,♪ Bir an olsun durma! ♪Dialogue: 0,0:01:14.99,0:01:16.82,Hands Up lyrics,,0,0,0,,♪ Dalgaları aşa aşa! ♪Dialogue: 0,0:01:16.86,0:01:20.41,Hands Up lyrics,,0,0,0,,♪ Arzularımız birleşiyor yavaşça. ♪Dialogue: 0,0:01:20.44,0:01:24.65,Hands Up lyrics,,0,0,0,,♪ Haydi ilerisini hedef seçelim kendimize! ♪Dialogue: 0,0:01:24.91,0:01:31.06,Hands Up lyrics,,0,0,0,,♪ Dalgaları sürerek, akıyoruz ileriye. ♪Dialogue: 0,0:01:31.09,0:01:35.34,Hands Up lyrics,,0,0,0,,♪ İnsanlarla tanışıyor, elvedalar ediyoruz,...Dialogue: 0,0:01:35.36,0:01:39.09,Hands Up lyrics,,0,0,0,,...bir kez daha bu bayrağın altında. ♪Dialogue: 0,0:01:41.26,0:01:45.04,Hands Up lyrics,,0,0,0,,♪ Unutmak istemediğim acıları...Dialogue: 0,0:01:45.06,0:01:48.08,Hands Up lyrics,,0,0,0,,...o gün yüreğime gömdüm, saklıyorum orada. ♪Dialogue: 0,0:01:48.27,0:01:52.34,Hands Up lyrics,,0,0,0,,♪ Kimselere yenilmeyecek bir özgürlük bizimkisi,...Dialogue: 0,0:01:52.46,0:01:54.75,Hands Up lyrics,,0,0,0,,...sıkıca kavrayıp yoluma atıldığım. ♪Dialogue: 0,0:01:54.77,0:01:59.69,Hands Up lyrics,,0,0,0,,♪ Kaldır ellerini daha da yukarıya, hayallerini dök şarkılara. ♪Dialogue: 0,0:01:59.72,0:02:03.37,Hands Up lyrics,,0,0,0,,♪ Yıkılma hiçbir zaman, sarsılmaz bayrağını kaldır göklere. ♪Dialogue: 0,0:02:03.41,0:02:06.66,Hands Up lyrics,,0,0,0,,♪ Buralara kadar gelebilmek için pek çok duvarı yıkıp geçtik! ♪Dialogue: 0,0:02:06.69,0:02:10.83,Hands Up lyrics,,0,0,0,,♪ Hedefimiz gelecek! ♪Dialogue: 0,0:02:10.88,0:02:12.20,Hands Up lyrics,,0,0,0,,♪ Daha da yukarıya bak! ♪Dialogue: 0,0:02:12.25,0:02:14.53,Hands Up lyrics,,0,0,0,,♪ Sırtın hep dik olsun! ♪Dialogue: 0,0:02:14.53,0:02:15.90,Hands Up lyrics,,0,0,0,,♪ Bir an olsun durma! ♪Dialogue: 0,0:02:15.95,0:02:17.72,Hands Up lyrics,,0,0,0,,♪ Dalgaları aşa aşa! ♪Dialogue: 0,0:02:17.76,0:02:21.43,Hands Up lyrics,,0,0,0,,♪ Arzularımız birleşiyor yavaşça. ♪Dialogue: 0,0:02:21.50,0:02:24.97,Hands Up lyrics,,0,0,0,,♪ Haydi ilerisini hedef seçelim kendimize! ♪Dialogue: 0,0:02:24.99,0:02:29.89,Hands Up lyrics,,0,0,0,,♪ Eller havaya!! ♪