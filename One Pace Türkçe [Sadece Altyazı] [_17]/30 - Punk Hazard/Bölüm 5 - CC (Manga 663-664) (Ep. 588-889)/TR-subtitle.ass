Dialogue: 0,0:35:39.00,0:35:41.80,Author,,0,0,0,,{\fad(0,50)\fs17} Türkçeleştirme & Çevirmen  {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&} - {\c&H01BAFF&}{\b1}Knaryaa{\b0}{\c&HFFFFFF&}\N{\fs16}thx to onepace.net
Dialogue: 0,0:02:32.52,0:02:34.79,Main,Usopp,0,0,0,,Bu bir savaş gemisi mi?
Dialogue: 0,0:02:34.79,0:02:37.14,Main,Luffy,0,0,0,,Denizciler burada mı demek oluyor?
Dialogue: 0,0:02:37.14,0:02:40.11,Main,Brook,0,0,0,,Ne?! Öncesinde burada bir şey yoktu!
Dialogue: 0,0:02:40.12,0:02:42.57,Main,Usopp,0,0,0,,Orada biri var!
Dialogue: 0,0:02:43.40,0:02:45.91,Main,Luffy,0,0,0,,Ha? Yoksa o...
Dialogue: 0,0:02:45.91,0:02:48.57,Main,Luffy,0,0,0,,{Hey!  Hey!}
Dialogue: 0,0:02:48.57,0:02:51.76,Main,Luffy,0,0,0,,Tekrar karşılaştık! Benim ben!
Dialogue: 0,0:02:51.76,0:02:54.13,Main,Luffy,0,0,0,,Benim için yaptığın her şey için teşekkür ederim!
Dialogue: 0,0:02:55.42,0:02:56.44,Main,Law,0,0,0,,Hasır-Şapkalı...
Dialogue: 0,0:02:57.14,0:02:58.28,Main,Zoro,0,0,0,,O...
Dialogue: 0,0:02:59.29,0:03:02.66,Main,Zoro,0,0,0,,Sabaody'de İnsan Müzayede Evi'nde karşılaştığım çocuk.
Dialogue: 0,0:03:02.66,0:03:05.72,Main,Robin,0,0,0,,Trafalgar Law. Ama şu an o...
Dialogue: 0,0:03:05.72,0:03:07.93,Main,Luffy,0,0,0,,Doğru, Trafal... Tra-o!
Dialogue: 0,0:03:08.97,0:03:13.88,Main,Luffy,0,0,0,,O adam Beyazsakal'ın olduğu savaş sırasında kaçmama yardım etti.
Dialogue: 0,0:03:13.88,0:03:15.78,Main,Luffy,0,0,0,,Yaralarımı bile tedavi etti!
Dialogue: 0,0:03:15.78,0:03:16.66,Main,Robin,0,0,0,,Öyle mi yaptı?
Dialogue: 0,0:03:16.66,0:03:17.63,Main,Luffy,0,0,0,,Bu doğru!
Dialogue: 0,0:03:17.63,0:03:21.77,Main,Luffy,0,0,0,,Jinbe gibi hayatımı kurtardı!
Dialogue: 0,0:03:21.77,0:03:23.44,Main,Luffy,0,0,0,,{Hey!}
Dialogue: 0,0:03:26.88,0:03:29.54,Main,Luffy,0,0,0,,Seni burada göreceğimi hiç düşünmezdim!
Dialogue: 0,0:03:29.54,0:03:33.02,Main,Luffy,0,0,0,,Gerçekten öncesi için teşekkür ederim!
Dialogue: 0,0:03:33.02,0:03:33.88,Main,Luffy,0,0,0,,Ha?
Dialogue: 0,0:03:34.90,0:03:36.85,Main,Luffy,0,0,0,,Konuşan ayı ve diğerleri nerede?
Dialogue: 0,0:03:39.44,0:03:41.57,Flashbacks,Law,0,0,0,,Hasır-Şapkalı'yı buraya getir!
Dialogue: 0,0:03:41.57,0:03:44.16,Flashbacks,Law,0,0,0,,Onu buradan uzağa götüreceğim!
Dialogue: 0,0:03:44.16,0:03:45.87,Flashbacks,Law,0,0,0,,Şimdilik ona bakmama izin ver!
Dialogue: 0,0:03:45.87,0:03:48.29,Flashbacks,Law,0,0,0,,Ben doktorum!
Dialogue: 0,0:03:48.29,0:03:53.24,Flashbacks,Luffy,0,0,0,,Ace nerede?!
Dialogue: 0,0:03:53.24,0:03:55.42,Flashbacks,Jinbe,0,0,0,,Onu kendi haline bırakırsak ne olur?
Dialogue: 0,0:03:56.22,0:03:59.16,Flashbacks,Jinbe,0,0,0,,Yani, açıkça söylemek gerekirse...
Dialogue: 0,0:03:59.16,0:04:01.31,Flashbacks,Jinbe,0,0,0,,Bu adaya geldiğimizde söylediğim gibi,
Dialogue: 0,0:04:01.31,0:04:04.93,Flashbacks,Jinbe,0,0,0,,yaraları yeniden açılırsa muhtemelen ölecek.
Dialogue: 0,0:04:04.93,0:04:09.42,Flashbacks,Law,0,0,0,,Hasır Şapkalı'nın iki hafta daha tamamen dinlenmesi gerek.
Dialogue: 0,0:04:09.42,0:04:12.33,Flashbacks,Rayleigh,0,0,0,,Anladım. Bizim için yaptığın her şey için teşekkürler.
Dialogue: 0,0:04:14.65,0:04:18.03,Main,Law,0,0,0,,Hayatta kaldığın için etkilendim, Hasır Şapkalı.
Dialogue: 0,0:04:18.03,0:04:22.43,Main,Law,0,0,0,,Ama o zaman seni kurtardığım için bana borçlu hissetmene gerek yok.
Dialogue: 0,0:04:23.53,0:04:26.30,Main,Law,0,0,0,,Sadece bir hevesle hareket ediyordum.
Dialogue: 0,0:04:26.87,0:04:30.65,Main,Law,0,0,0,,İkimiz de korsanız. Bunu unutma.
Dialogue: 0,0:04:31.73,0:04:32.87,Main,Luffy,0,0,0,,Galiba haklısın.
Dialogue: 0,0:04:32.87,0:04:35.42,Main,Luffy,0,0,0,,Eğer ikimiz de One Piece'i arıyorsak bu bizi düşman yapar...
Dialogue: 0,0:04:35.42,0:04:38.97,Main,Luffy,0,0,0,,ama iki yıl önce olanlardan sonra hâlâ birçok insana borcum var.
Dialogue: 0,0:04:38.97,0:04:42.77,Main,Luffy,0,0,0,,Jinbe ile tanıştıktan hemen sonra seninle tanışabildiğim için çok şanslıyım!
Dialogue: 0,0:04:42.77,0:04:43.78,Main,Luffy,0,0,0,,Gerçekten teşekkür ederim!
Dialogue: 0,0:04:44.21,0:04:47.17,Main,Usopp,0,0,0,,Orada yerde yatan bir denizci var!
Dialogue: 0,0:04:51.20,0:04:54.28,Main,Usopp,0,0,0,,Yoksa... o...
Dialogue: 0,0:04:54.28,0:04:57.32,Main,Brownbeard,0,0,0,,Lütfen kurtar beni, Trafalgar!
Dialogue: 0,0:04:58.89,0:05:00.85,Main,Tashigi,0,0,0,,Smoker-san!
Dialogue: 0,0:05:06.26,0:05:06.83,Main,Tashigi,0,0,0,,Sakın...
Dialogue: 0,0:05:09.07,0:05:10.46,Main,Tashigi,0,0,0,,Smoker-san?!
Dialogue: 0,0:05:10.46,0:05:12.30,Main,Marine,0,0,0,,{\i1}Smo-ya!
Dialogue: 0,0:05:12.30,0:05:14.24,Main,Luffy,0,0,0,,Denizciler mi?!
Dialogue: 0,0:05:14.24,0:05:16.57,Main,Luffy,0,0,0,,N-Ne? Yoksa o...
Dialogue: 0,0:05:18.79,0:05:21.90,Main,Usopp,0,0,0,,Bu hiç iyi değil, Luffy! Denizciler geldi!
Dialogue: 0,0:05:21.90,0:05:22.54,Main,Luffy,0,0,0,,D-Doğru!
Dialogue: 0,0:05:24.21,0:05:26.11,Main,Marine,0,0,0,,Kaptan-chan, ne oldu?
Dialogue: 0,0:05:26.11,0:05:28.27,Main,Marine,0,0,0,,Smo-ya, iyi misin?!
Dialogue: 0,0:05:32.61,0:05:34.15,Main,Tashigi,0,0,0,,Smoker-san!
Dialogue: 0,0:05:36.34,0:05:40.43,Main,Luffy,0,0,0,,Biliyordum, Yaşlı Smoker ve grubu!\NGörüşmeyeli uzun zaman oldu!
Dialogue: 0,0:05:45.10,0:05:47.19,Thoughts,Tashigi,0,0,0,,Göğüsünde... bir delik...
Dialogue: 0,0:05:47.19,0:05:49.95,Thoughts,Tashigi,0,0,0,,Smoker-san!
Dialogue: 0,0:05:50.71,0:05:54.30,Flashbacks,Marine,0,0,0,,Shichibukai olmak için...
Dialogue: 0,0:05:54.30,0:05:58.50,Flashbacks,Marine,0,0,0,,yüz korsanın kalbini Denizci Karargah'ına götürdü!
Dialogue: 0,0:05:58.50,0:06:00.18,Flashbacks,Marine,0,0,0,,Tamamiyle çılgın birisi!
Dialogue: 0,0:06:12.60,0:06:13.81,Main,Tashigi,0,0,0,,Nasıl yaparsın?!
Dialogue: 0,0:06:13.81,0:06:16.27,Main,Tashigi,0,0,0,,Nasıl yaparsın?! Nasıl yaparsın?!
Dialogue: 0,0:06:17.67,0:06:20.27,Main,Tashigi,0,0,0,,{\i1}Nasıl yaparsın?!
Dialogue: 0,0:06:22.49,0:06:24.49,Main,Law,0,0,0,,Dur artık.
Dialogue: 0,0:06:24.49,0:06:27.50,Main,Law,0,0,0,,Bu kadar kabalığa... dayanamıyorum.
Dialogue: 0,0:06:29.60,0:06:31.20,Attack,Law,0,0,0,,{\fad(100,100)}ODA
Dialogue: 0,0:06:39.15,0:06:42.06,Main,Marine,0,0,0,,Tashigi-chan!
Dialogue: 0,0:06:43.30,0:06:44.80,Attack,Marine,0,0,0,,{\fad(100,100)}Karmaşa
Dialogue: 0,0:06:50.49,0:06:52.44,Main,Marine,0,0,0,,Kahretsin! Yine onu yendi!
Dialogue: 0,0:06:52.44,0:06:54.34,Main,Marine,0,0,0,,Smo-san bile yerde!
Dialogue: 0,0:06:54.34,0:06:56.49,Main,Zoro,0,0,0,,Biraz önce ne yaptı?!
Dialogue: 0,0:06:56.49,0:06:58.70,Main,Law,0,0,0,,Hiç öğrenmiyorsun, değil mi?
Dialogue: 0,0:06:58.70,0:07:01.16,Main,Law,0,0,0,,Bu kadar ciddi olma.
Dialogue: 0,0:07:01.16,0:07:03.14,Main,Marine,0,0,0,,{\i1}Tashigi-chan!
Dialogue: 0,0:07:03.14,0:07:05.70,Main,Usopp,0,0,0,,Luffy, acele et! Burada tehlikedeyiz!
Dialogue: 0,0:07:06.94,0:07:08.21,Main,Luffy,0,0,0,,Doğru!
Dialogue: 0,0:07:08.21,0:07:10.88,Main,Luffy,0,0,0,,Hey, Tra-o! Sormak istediğim...
Dialogue: 0,0:07:12.87,0:07:15.51,Main,Law,0,0,0,,Laboratuvarın arkasına gidin.
Dialogue: 0,0:07:15.51,0:07:18.98,Main,Law,0,0,0,,Aradığını orada bulacaksın.
Dialogue: 0,0:07:18.98,0:07:23.05,Main,Law,0,0,0,,Eminim tekrar karşılaşacağız.\Nİkimizinde geri almak istediği bir şey var.
Dialogue: 0,0:07:29.00,0:07:31.70,Thoughts,Brownbeard,0,0,0,,Tanrıya şükür, benden bahsediyordu.
Dialogue: 0,0:07:31.70,0:07:34.64,Thoughts,Brownbeard,0,0,0,,Bu tehlikeli! Ben de eski korsanım!
Dialogue: 0,0:07:35.17,0:07:37.54,Main,Usopp,0,0,0,,Tamamdır, Luffy! Denizcilerden uzaklaşmamız lazım!
Dialogue: 0,0:07:44.83,0:07:47.18,Main,Luffy,0,0,0,,Acaba Smoker ve grubu iyi olacak mı?
Dialogue: 0,0:07:47.18,0:07:48.68,Main,Luffy,0,0,0,,Tra-o tarafından yenildiler mi?
Dialogue: 0,0:07:51.39,0:07:53.96,Main,Marine,0,0,0,,Bu Hasır Şapkalı Luffy!
Dialogue: 0,0:07:53.96,0:07:55.03,Main,Marine,0,0,0,,Ateş!
Dialogue: 0,0:07:58.19,0:08:00.56,Main,Marine,0,0,0,,Durun, şimdi zamanı değil!
Dialogue: 0,0:08:00.56,0:08:02.22,Main,Marine,0,0,0,,Smo-san ve Kaptan-chan...
Dialogue: 0,0:08:07.80,0:08:10.88,captions_soft,Caption,0,0,0,,{\fad(900,0)\pos(640,437)}Laboratuvarın Arka Kapısının Dışındaki Dağ
Dialogue: 0,0:08:07.80,0:08:10.88,captions_soft,Caption,0,0,0,,{\fad(900,0)\pos(640,476)}- Sanji'nin Grubu -
Dialogue: 0,0:08:07.65,0:08:09.68,Main,Sanji,0,0,0,,Ölümcül derecede soğuk olsa bile...
Dialogue: 0,0:08:09.68,0:08:10.88,Main,Sanji,0,0,0,,Umursamıyorum!
Dialogue: 0,0:08:11.45,0:08:14.74,Main,Sanji,0,0,0,,Samuray ya da çocukları da umursamıyorum!
Dialogue: 0,0:08:14.74,0:08:15.65,Main,Child,0,0,0,,{\i1}Neee?!
Dialogue: 0,0:08:16.14,0:08:18.80,Main,Sanji,0,0,0,,Burada bir yerde kamera yok mu?!
Dialogue: 0,0:08:18.80,0:08:21.56,Main,Sanji,0,0,0,,Kendi halime geri dönmeden önce bir kaç fotoğraf çekmem gerek!
Dialogue: 0,0:08:21.56,0:08:23.32,Main,Nami,0,0,0,,Ne tarz fotoğraflar?!
Dialogue: 0,0:08:23.32,0:08:25.92,Main,Nami,0,0,0,,Ayrıca başka birinin vücudundayken burnun kanamasın!
Dialogue: 0,0:08:25.92,0:08:27.66,Main,Franky,0,0,0,,Onu boş ver, Nami!
Dialogue: 0,0:08:27.66,0:08:30.69,Main,Franky,0,0,0,,Hawaii gömleğimin düğmelerini iliklememelisin!
Dialogue: 0,0:08:30.69,0:08:32.93,Main,Chopper,0,0,0,,İyi misiniz?
Dialogue: 0,0:08:32.93,0:08:35.39,Main,Chopper,0,0,0,,Donuyorsunuz değil mi?\NBiraz daha dayanın!
Dialogue: 0,0:08:35.39,0:08:39.03,Main,Child,0,0,0,,Kıvırcık abi o kadar iyi davranıyor ki, bu beni korkutuyor!
Dialogue: 0,0:08:39.03,0:08:42.52,Main,Child,0,0,0,,Neler oluyor?\NBilinciniz mi değişti?
Dialogue: 0,0:08:42.52,0:08:45.96,Main,Chopper,0,0,0,,İnsan vücudunda bu kadar soğuk olacağını düşünmezdim.
Dialogue: 0,0:08:49.48,0:08:51.60,Main,Child,0,0,0,,Herkes dursun!
Dialogue: 0,0:08:54.37,0:08:56.71,Main,Child,0,0,0,,Donuyorum...
Dialogue: 0,0:08:56.71,0:09:00.25,Main,Child,0,0,0,,Umudum yok... Daha fazla ilerleyemem...
Dialogue: 0,0:09:00.25,0:09:01.18,Main,Child,0,0,0,,Ben de!
Dialogue: 0,0:09:01.18,0:09:02.47,Main,Child,0,0,0,,Donarak öleceğim!
Dialogue: 0,0:09:02.47,0:09:07.73,Main,Franky,0,0,0,,Kahretsin! Onları planımız olmadan buraya getirmek kötü bir fikirdi!
Dialogue: 0,0:09:07.73,0:09:10.87,Main,Franky,0,0,0,,Yine de bu bedende hiç üşümüyorum.
Dialogue: 0,0:09:10.87,0:09:13.35,Main,Franky,0,0,0,,Tamamdır, kürkümü kesip onlara vereceğim.
Dialogue: 0,0:09:13.35,0:09:15.37,Main,Chopper,0,0,0,,Dur! O benim vücudum!
Dialogue: 0,0:09:15.37,0:09:19.95,Main,Franky,0,0,0,,Öyle diyorsun ama burada başka kalın palto yok.
Dialogue: 0,0:09:19.95,0:09:22.79,Main,Franky,0,0,0,,Acaba yakınlarda bir dağ kulübesi var mı?
Dialogue: 0,0:09:22.91,0:09:26.48,Main,Sanji,0,0,0,,Ah, kamera, ayna...
Dialogue: 0,0:09:26.48,0:09:28.63,Main,Sanji,0,0,0,,ve b-banyo! Dağ kulübesinde bunlar vardır!
Dialogue: 0,0:09:28.63,0:09:30.71,Main,Nami,0,0,0,,Seni bağlayacağım!
Dialogue: 0,0:09:30.71,0:09:34.26,Main,Kinemon,0,0,0,,Başka seçeneğim olmadığını görüyorum!
Dialogue: 0,0:09:34.26,0:09:36.66,Main,Kinemon,0,0,0,,Başınıza birer tane yaprak koyun!
Dialogue: 0,0:09:37.16,0:09:40.27,Main,Franky,0,0,0,,Ha?! Şimdi saçmalığın sırası değil!
Dialogue: 0,0:09:40.27,0:09:42.77,Main,Franky,0,0,0,,Çocuklar soğuktan yere düşmek üzere!
Dialogue: 0,0:09:42.77,0:09:46.32,Main,Chopper,0,0,0,,Ayrıca bu adada bir tane bile bitki yok!
Dialogue: 0,0:09:46.32,0:09:47.27,Main,Chopper,0,0,0,,Yani hiç yaprak yok!
Dialogue: 0,0:09:47.27,0:09:51.24,Main,Kinemon,0,0,0,,O zaman taş veya başka bir şey de olur.
Dialogue: 0,0:09:51.24,0:09:51.96,Main,Kinemon,0,0,0,,Çabuk olun!
Dialogue: 0,0:09:53.11,0:09:57.58,Main,Franky,0,0,0,,Tamam... Görünüşe göre bir planın var.
Dialogue: 0,0:09:57.58,0:09:59.27,Main,Franky,0,0,0,,Çocuklar için taş bulacağım!
Dialogue: 0,0:10:06.16,0:10:08.26,Main,Sanji,0,0,0,,Dediğini yaptık. Şimdi, ne olacak?
Dialogue: 0,0:10:08.26,0:10:12.59,Main,Franky,0,0,0,,Eğer bu soğuğu ortadan kaldırmaya yönelik aptalca bir batıl inançsa,
Dialogue: 0,0:10:12.59,0:10:13.64,Main,Franky,0,0,0,,seni dümdüz ederim!
Dialogue: 0,0:10:13.64,0:10:14.56,Main,Kinemon,0,0,0,,Tamamdır!
Dialogue: 0,0:10:22.14,0:10:23.13,Main,Kinemon,0,0,0,,Doron!
Dialogue: 0,0:10:25.08,0:10:26.87,Main,Everyone,0,0,0,,{\i1}Neee?!
Dialogue: 0,0:10:26.87,0:10:29.14,Main,Everyone,0,0,0,,{\i1}Neler oluyor?!
Dialogue: 0,0:10:38.05,0:10:40.50,Main,Chopper,0,0,0,,Paltolarımız var! Ve ayakkabılarımız!
Dialogue: 0,0:10:40.50,0:10:42.35,Main,Nami,0,0,0,,Nasıl?! Ne yaptı?!
Dialogue: 0,0:10:43.53,0:10:44.78,Main,Mocha,0,0,0,,Eldivenler!
Dialogue: 0,0:10:44.78,0:10:46.29,Main,Child,0,0,0,,Sıcacık!
Dialogue: 0,0:10:46.29,0:10:47.51,Main,Child,0,0,0,,Çok sıcak!
Dialogue: 0,0:10:47.51,0:10:51.85,Main,Kinemon,0,0,0,,Doğrusu, nadir bir meyve yedim,
Dialogue: 0,0:10:51.85,0:10:56.49,Main,Kinemon,0,0,0,,ve o zamandan beri, herhangi bir nesneyi...
Dialogue: 0,0:10:56.49,0:10:59.99,Main,Kinemon,0,0,0,,kıyafete değiştirerek büyü yapabiliyorum!
Dialogue: 0,0:10:59.99,0:11:03.43,Main,Kinemon,0,0,0,,Yabancı ülkelerin kıyafetlerine aşina değilim ama bunlar işe yarar mı?
Dialogue: 0,0:11:04.00,0:11:08.08,Main,Kinemon,0,0,0,,Gerçi bunun bir sihir olduğu konusunda sizi uyarmalıyım, yani çıkarırsanız kıyafetler kaybolur.
Dialogue: 0,0:11:08.08,0:11:11.26,Main,Child,0,0,0,,{\i1}Teşekkür ederim!
Dialogue: 0,0:11:12.40,0:11:14.54,Main,Sanji,0,0,0,,Abartmayın!
Dialogue: 0,0:11:14.54,0:11:16.83,Main,Nami,0,0,0,,Şeytan Meyvesi güçlerin mi var?
Dialogue: 0,0:11:16.83,0:11:19.13,Main,Franky,0,0,0,,Madem öyle...
Dialogue: 0,0:11:20.84,0:11:22.69,Main,Franky,0,0,0,,Eğer bunu yapabiliyorsan...
Dialogue: 0,0:11:23.10,0:11:25.25,Main,Franky,0,0,0,,{\i1}Neden daha önce yapmadın?!
Dialogue: 0,0:11:27.92,0:11:33.19,Main,Kinemon,0,0,0,,Ama... o göğüsleri saklamak büyük bir israf olurdu.
Dialogue: 0,0:11:33.96,0:11:35.67,Main,Nami,0,0,0,,Aptal!
Dialogue: 0,0:11:40.94,0:11:43.04,Main,Kinemon,0,0,0,,B-Bu kaşındırdı...
Dialogue: 0,0:11:43.04,0:11:44.22,Main,Kinemon,0,0,0,,Bu sadece kaşındırdı!
Dialogue: 0,0:11:46.62,0:11:50.76,Main,Chopper,0,0,0,,Yaralandığını ya da havanın soğuk olduğunu söyleyemiyorsun, değil mi?
Dialogue: 0,0:11:51.35,0:11:52.97,Main,Kinemon,0,0,0,,Çünkü ben bir savaşçıyım.
Dialogue: 0,0:11:52.97,0:11:54.87,Main,Luffy,0,0,0,,İşte buradalar! Merhaba millet!
Dialogue: 0,0:11:56.43,0:11:59.13,Main,They,0,0,0,,{\i1}Selammm!
Dialogue: 0,0:11:59.13,0:12:02.38,Main,Luffy,0,0,0,,Selamm! Selamm!
Dialogue: 0,0:12:03.94,0:12:05.21,Main,Nami,0,0,0,,Burada ne işiniz var?
Dialogue: 0,0:12:05.21,0:12:07.50,Main,Brook,0,0,0,,Millet iyi misiniz?
Dialogue: 0,0:12:10.70,0:12:12.42,Main,Franky,0,0,0,,Bu onlar!
Dialogue: 0,0:12:12.42,0:12:15.81,Main,Chopper,0,0,0,,Luffy'nin grubu! Zoro! Usopp!
Dialogue: 0,0:12:15.81,0:12:17.97,Main,Chopper,0,0,0,,Robin! Brook!
Dialogue: 0,0:12:17.97,0:12:19.30,Main,Chopper,0,0,0,,Burada olduğunuza sevindik!
Dialogue: 0,0:12:19.30,0:12:22.93,Main,Zoro,0,0,0,,Bu aptal aşçı neden bu kadar hevesli??
Dialogue: 0,0:12:22.93,0:12:24.41,Main,Zoro,0,0,0,,Isınmaya mı çalışıyor?
Dialogue: 0,0:12:27.88,0:12:31.69,Main,Usopp,0,0,0,,Bu da ne? Devden çocuklar gibi görünüyor ama...
Dialogue: 0,0:12:35.46,0:12:37.03,Main,Luffy,0,0,0,,Ha?!
Dialogue: 0,0:12:37.03,0:12:39.29,Main,Luffy,0,0,0,,Ne yapıyorsun?! Kes şunu, Franky!
Dialogue: 0,0:12:44.50,0:12:46.72,Main,Usopp,0,0,0,,Sonunda geldik! Burası idare eder.
Dialogue: 0,0:12:43.71,0:12:48.89,captions_soft,Caption,0,0,0,,{\fad(500,500)\pos(640,540)}Hasır Şapka'ların Saklanma Yeri
Dialogue: 0,0:12:46.72,0:12:50.16,Main,Franky,0,0,0,,Bu ekipmanlar laboratuvardaki eşyalara benziyor.
Dialogue: 0,0:12:50.16,0:12:53.98,Main,Robin,0,0,0,,Ama hepsi parça parça.\NBelki büyük bir patlama olmuştur.
Dialogue: 0,0:12:53.98,0:12:56.71,Main,Franky,0,0,0,,Bizi kar fırtınasından korudukları sürece önemli değil.
Dialogue: 0,0:12:56.71,0:12:59.50,Main,Franky,0,0,0,,Şimdi nereden başlasak?
Dialogue: 0,0:12:59.50,0:13:03.32,Main,Nami,0,0,0,,Bu kırılgan vücudumda bir yara izi bırakacak!
Dialogue: 0,0:13:03.32,0:13:05.55,Main,Chopper,0,0,0,,Seninle hemen ilgileneceğim!
Dialogue: 0,0:13:07.08,0:13:09.80,Main,Nami,0,0,0,,Bekle, Sanji-kun! Benim vücudumla ne yapıyorsun?!
Dialogue: 0,0:13:10.20,0:13:12.10,Main,Chopper,0,0,0,,Ben Chopper!
Dialogue: 0,0:13:17.98,0:13:20.87,Main,Kinemon,0,0,0,,Bedenimin alt tarafı bana geri döndü!
Dialogue: 0,0:13:22.68,0:13:26.62,Main,Luffy,0,0,0,,Bacakcık... Arka ayaklarım...
Dialogue: 0,0:13:31.61,0:13:34.58,Main,Usopp,0,0,0,,Sana söylemiştim, öyle bir yaratık yok!
Dialogue: 0,0:13:34.58,0:13:36.71,Main,Robin,0,0,0,,Bu oldukça olağanüstü.
Dialogue: 0,0:13:42.24,0:13:44.02,Main,Brook,0,0,0,,Ne tuhaf bir adam.
Dialogue: 0,0:13:44.02,0:13:45.42,Main,Mocha,0,0,0,,İskelet...
Dialogue: 0,0:13:45.42,0:13:46.47,Main,Sind,0,0,0,,konuşuyor!
Dialogue: 0,0:13:50.01,0:13:51.81,Main,Child,0,0,0,,Tank'a dönüş!
Dialogue: 0,0:13:51.81,0:13:53.17,Main,Child,0,0,0,,Bir tane daha lazer atabilir misin?
Dialogue: 0,0:13:53.17,0:13:55.54,Main,Child,0,0,0,,Hadi!
Dialogue: 0,0:13:57.59,0:13:58.71,Main,Nami,0,0,0,,Sessiz olun!
Dialogue: 0,0:14:00.13,0:14:02.31,Main,Child,0,0,0,,İçerideki kim?
Dialogue: 0,0:14:06.22,0:14:07.89,Main,Sanji,0,0,0,,Ha? Emin misin?
Dialogue: 0,0:14:07.89,0:14:09.79,Main,Nami,0,0,0,,Bununla baş etmekte zorlanıyorsun, değil mi?
Dialogue: 0,0:14:09.79,0:14:13.72,Main,Nami,0,0,0,,Hadi sakinleşelim ve bu konuyu konuşalım millet.
Dialogue: 0,0:14:13.72,0:14:16.85,Main,Luffy,0,0,0,,Tamamdır! Şimdi kim kimin içine girdi?
Dialogue: 0,0:14:17.76,0:14:20.62,Main,Franky,0,0,0,,İlk olarak, ben Franky!
Dialogue: 0,0:14:20.62,0:14:23.03,Main,Franky,0,0,0,,Eğer yaralanırsanız bana gelmeyin!
Dialogue: 0,0:14:23.03,0:14:25.11,Main,Chopper,0,0,0,,Ben Chopper!
Dialogue: 0,0:14:25.89,0:14:28.07,Main,Chopper,0,0,0,,Eğer yaralanırsanız, yaralarınızla ilgileneceğim!
Dialogue: 0,0:14:28.98,0:14:30.70,Main,Nami,0,0,0,,Ben Nami.
Dialogue: 0,0:14:30.70,0:14:32.91,Main,Nami,0,0,0,,Lazer atmaktansa ölmeyi tercih ederim!
Dialogue: 0,0:14:36.27,0:14:38.17,Main,Sanji,0,0,0,,Ve... Biz...
Dialogue: 0,0:14:38.71,0:14:40.88,Main,Sanji,0,0,0,,{\i1}Nami-san'ız!
Dialogue: 0,0:14:40.88,0:14:43.21,Main,Usopp & Brook,0,0,0,,{\i1}Bunu bekliyordum!
Dialogue: 0,0:14:43.61,0:14:46.86,Main,Nami,0,0,0,,Nami'nin çok kaba davrandığını düşünüyorum.
Dialogue: 0,0:14:46.86,0:14:52.32,Main,Sanji,0,0,0,,Bir daha bunu yapmayacağım!\NLütfen, daha fazla Nami-san'ı incitme!
Dialogue: 0,0:14:52.32,0:14:54.84,Main,Chopper,0,0,0,,Yeter artık Nami! Nami ölecek!
Dialogue: 0,0:14:56.30,0:14:59.66,Main,Nami,0,0,0,,Eğer vücuduma dokunursan, sana 200 bin beli'ye mâl olur!
Dialogue: 0,0:14:59.66,0:15:01.24,Main,Nami,0,0,0,,Bakmak 100 bin beli!
Dialogue: 0,0:15:01.24,0:15:02.48,Main,Sanji,0,0,0,,Nasıl hayatta kalacağım?!
Dialogue: 0,0:15:04.55,0:15:07.24,Main,Nami,0,0,0,,Daha ne kadar gülmeye devam edeceksin? \NBu seni ilgilendirmiyormuş gibi davranmayı bırak!
Dialogue: 0,0:15:10.24,0:15:13.53,Main,Usopp,0,0,0,,Şimdi olayları başa alırsak...
Dialogue: 0,0:15:13.53,0:15:16.58,Main,Usopp,0,0,0,,Bu duyduğumuz Wano Krallığından samuray.
Dialogue: 0,0:15:16.99,0:15:21.67,Main,Usopp,0,0,0,,Aldığımız imdat çağrısı, Patron adını verdikleri Timsahtor'a yönelikti.
Dialogue: 0,0:15:21.67,0:15:24.50,Main,Usopp,0,0,0,,Astlarından birinden geldi.
Dialogue: 0,0:15:24.50,0:15:29.56,Main,Usopp,0,0,0,,Bunun nedeni samurayın amansızca Sentor'lara saldırmasıydı.
Dialogue: 0,0:15:31.13,0:15:36.41,Main,Kinemon,0,0,0,,Ancak ben sadece kayıp oğlum Momonosuke'yi bulup kurtarmaya çalışıyordum.
Dialogue: 0,0:15:36.41,0:15:39.67,Main,Kinemon,0,0,0,,Sadece yoluma çıkanları kestim.
Dialogue: 0,0:15:39.67,0:15:40.74,Main,Kinemon,0,0,0,,Ve işte!
Dialogue: 0,0:15:40.74,0:15:44.33,Main,Kinemon,0,0,0,,Bu çocukların hepsi o tesiste hapisti.
Dialogue: 0,0:15:44.33,0:15:46.51,Main,Kinemon,0,0,0,,Momonosuke de orada bir yerlerde olmalı!
Dialogue: 0,0:15:46.51,0:15:50.29,Main,Child,0,0,0,,Evet, içerideki tek çocuklar biz değildik.
Dialogue: 0,0:15:50.29,0:15:53.85,Main,Biyo,0,0,0,,Henüz yeni çocukların isimlerini bile öğrenememiştik.
Dialogue: 0,0:15:54.62,0:15:59.02,Main,Zoro,0,0,0,,Ama şimdi soru şu: İmdat çağrısını gönderdikten sonra ne oldu?
Dialogue: 0,0:15:59.62,0:16:02.00,Main,Kinemon,0,0,0,,Az önceki adamdı bu.
Dialogue: 0,0:16:02.55,0:16:06.28,Main,Kinemon,0,0,0,,Ona Shichibukai olarak hitap ettiler!
Dialogue: 0,0:16:08.09,0:16:09.59,Main,Luffy,0,0,0,,Ne?!
Dialogue: 0,0:16:10.67,0:16:13.62,Main,Luffy,0,0,0,,Tra-o... Shichibukai'lerden biri mi?!
Dialogue: 0,0:16:13.62,0:16:17.27,Main,Robin,0,0,0,,Öyle.\Nİki yıldan sonra o da onlardan birisi oldu.
Dialogue: 0,0:16:17.27,0:16:20.67,Main,Kinemon,0,0,0,,Daha farkına bile varamadan üç parçaya bölündüm...
Dialogue: 0,0:16:23.33,0:16:25.47,Main,Kinemon,0,0,0,,Kafam tesisin içine hapsedildi
Dialogue: 0,0:16:26.32,0:16:27.72,Main,Kinemon,0,0,0,,Gövdem öylece terk edilmişti.
Dialogue: 0,0:16:28.74,0:16:31.72,Main,Kinemon,0,0,0,,Bacaklarım canavar yemi olarak kullanılmış gibi görünüyor.
Dialogue: 0,0:16:32.43,0:16:36.86,Main,Kinemon,0,0,0,,Duyularıma güvenerek ortalıkta koşuyordum ki \Nbir şeye takılıp kalmış olmalıyım.
Dialogue: 0,0:16:37.56,0:16:40.24,Main,Usopp,0,0,0,,Ejderhanın kafasının arkasıydı.
Dialogue: 0,0:16:41.65,0:16:45.19,Main,Luffy,0,0,0,,Bir düşününce, daha önce o \N"Kahrolası Shichibukai"den bahsediyordunuz, değil mi?
Dialogue: 0,0:16:45.19,0:16:49.09,Main,Nami,0,0,0,,Ne? Sadece bir çift bacaktı, değil mi? Nasıl konuşabilirdi?
Dialogue: 0,0:16:49.77,0:16:51.25,Main,Zoro,0,0,0,,Güzel soru.
Dialogue: 0,0:16:52.37,0:16:53.99,Main,Kinemon,0,0,0,,O...
Dialogue: 0,0:16:54.37,0:16:55.41,Main,Kinemon,0,0,0,,benim gaz çıkartmamdı.
Dialogue: 0,0:16:57.15,0:17:00.00,Main,Kinemon,0,0,0,,Bu uzun zamandır sahip olduğum bir yetenek.
Dialogue: 0,0:17:00.92,0:17:03.17,Main,Usopp,0,0,0,,{\i1}Osuruyor muydun?{\i0} İğrenç!
Dialogue: 0,0:17:03.17,0:17:05.50,Main,Kinemon,0,0,0,,Aynen öyle...
Dialogue: 0,0:17:05.50,0:17:07.50,Main,Luffy,0,0,0,,Ortalık kokmaya başladı!
Dialogue: 0,0:17:08.56,0:17:11.78,Main,Brook,0,0,0,,Her halükarda, sadece bacak ve kafadan ibaret olman oldukça komik!
Dialogue: 0,0:17:12.35,0:17:16.83,Main,Brook,0,0,0,,Öte yandan ben sadece bir gövdeden ibaret olan biriyle karşılaştım!
Dialogue: 0,0:17:16.83,0:17:19.68,Main,Zoro,0,0,0,,O kesinlikle bu adamın gövdesi olmalı!
Dialogue: 0,0:17:20.42,0:17:21.52,Main,Brook,0,0,0,,Ah, haklısın!
Dialogue: 0,0:17:21.52,0:17:24.19,Main,Kinemon,0,0,0,,Gördün mü?! Nerede?!
Dialogue: 0,0:17:24.19,0:17:26.86,Main,Kinemon,0,0,0,,Benim gövdemle nerede karşılaştın?!
Dialogue: 0,0:17:29.33,0:17:33.87,Main,Marine,0,0,0,,İyi misin...\Nkalbin olmadan... Tashigi-chan?
Dialogue: 0,0:17:33.87,0:17:35.59,Main,Tashigi,0,0,0,,Evet, yeterince tuhaf.
Dialogue: 0,0:17:35.59,0:17:37.77,Main,Marine,0,0,0,,Gerçekten utangaç davranıyor.
Dialogue: 0,0:17:37.77,0:17:40.85,Main,Smoker,0,0,0,,Laboratuvarın yakınında saklanan gemilerin üzerinde...
Dialogue: 0,0:17:40.85,0:17:43.42,Main,Smoker,0,0,0,,"CC" yazıyordu.
Dialogue: 0,0:17:43.42,0:17:47.24,Main,Marine,0,0,0,,Ha? Gerçekten mi, Koramiral Smoker?
Dialogue: 0,0:17:47.24,0:17:51.27,Main,Smoker,0,0,0,,Evet. Geçmişte burada kullanılan gemilerle aynı olsaydı,
Dialogue: 0,0:17:51.27,0:17:55.10,Main,Smoker,0,0,0,,Punk Hazard için "PH" demeliydiler.
Dialogue: 0,0:17:55.98,0:18:03.17,Main,Smoker,0,0,0,,Eğer Law'ın iplerini üstündeki birinin elinde tuttuğunu ve "CC" baş harfleri olduğunu varsayarsak...
Dialogue: 0,0:18:03.89,0:18:06.62,Main,Smoker,0,0,0,,o zaman onun kim olabileceğine dair bir fikrim var.
Dialogue: 0,0:18:07.77,0:18:12.39,Main,Smoker,0,0,0,,Eğer {\i1}o{\i0} bu adadaysa...
Dialogue: 0,0:18:14.70,0:18:17.46,Main,Smoker,0,0,0,,o zaman pek çok şeyi açıklayacaktır.
Dialogue: 0,0:18:26.50,0:18:28.90,Main,Smoker,0,0,0,,Doktor Vegapunk'un eski ortağı...
Dialogue: 0,0:18:30.05,0:18:32.01,Main,Smoker,0,0,0,,bilim adamı...
Dialogue: 0,0:18:32.01,0:18:33.94,Main,Smoker,0,0,0,,Caesar Clown.
Dialogue: 0,0:18:37.18,0:18:40.35,Main,Ceasar,0,0,0,,Ne yaptığını sanıyorsun, Law?!
Dialogue: 0,0:18:44.86,0:18:47.77,Main,Law,0,0,0,,Şikayet edecek kişi ben olmalıyım...
Dialogue: 0,0:18:48.66,0:18:50.03,Main,Law,0,0,0,,Caesar!
Dialogue: 0,0:19:03.50,0:19:06.75,Main,Tashigi,0,0,0,,Bir şey beni rahatsız ediyor.
Dialogue: 0,0:19:06.75,0:19:08.08,Main,Smoker,0,0,0,,Neymiş?
Dialogue: 0,0:19:09.80,0:19:11.94,Main,Tashigi,0,0,0,,Eğer hafızam beni doğru yanıltmıyorsa...
Dialogue: 0,0:19:11.94,0:19:17.32,Main,Tashigi,0,0,0,,Son birkaç yılda bu bölgede çok sayıda çocuk kaçırıldı.
Dialogue: 0,0:19:17.32,0:19:19.92,Main,Marine,0,0,0,,Kaçırma mı?
Dialogue: 0,0:19:19.92,0:19:20.56,Main,Tashigi,0,0,0,,Evet.
Dialogue: 0,0:19:24.68,0:19:29.02,Main,Marine,0,0,0,,Ama daha önemlisi,\Nbu yeni Kaptan-chan'a alışamıyorum!
Dialogue: 0,0:19:29.02,0:19:31.66,Main,Tashigi,0,0,0,,Elimde değil. Lütfen bununla baş etmeye çalışın!
Dialogue: 0,0:19:31.66,0:19:34.68,Main,Smoker,0,0,0,,Tashigi! Neyden bahsediyorsun?
Dialogue: 0,0:19:34.68,0:19:37.85,Main,Smoker,0,0,0,,Çocukların kaçırıldığına dair tek bir şey duymadım.
Dialogue: 0,0:19:38.36,0:19:40.29,Main,Tashigi,0,0,0,,Lütfen gömleğin düğmelerini ilikle, Smoker-san!
Dialogue: 0,0:19:40.29,0:19:45.25,Main,Marine,0,0,0,,Bu "açık" Kaptan-chan harika görünüyor ama içeriden dehşet verici!
Dialogue: 0,0:19:45.25,0:19:46.67,Main,Smoker,0,0,0,,Kapayın çenenizi!
Dialogue: 0,0:19:48.00,0:19:52.62,Main,Smoker,0,0,0,,Ara sıra yaşanan gemi kazaları dışında bu bölgeden herhangi bir haber gelmedi.
Dialogue: 0,0:19:53.15,0:19:57.52,Main,Smoker,0,0,0,,Ama şimdi siz söyleyince bu denizde bir sürü çocuk ölüyor gibi görünüyor.
Dialogue: 0,0:19:57.52,0:20:00.45,Main,Marine,0,0,0,,Evet bu doğru, değil mi?
Dialogue: 0,0:20:00.45,0:20:01.11,Main,Marine,0,0,0,,Doğru!
Dialogue: 0,0:20:01.11,0:20:03.98,Main,Tashigi,0,0,0,,İletişim bölümüne göre...
Dialogue: 0,0:20:03.98,0:20:06.22,Main,Tashigi,0,0,0,,Gözlüğüm yanımda değil.
Dialogue: 0,0:20:06.22,0:20:09.28,Main,Tashigi,0,0,0,,...kaçırılan çocuklara ilişkin birçok rapor G-5'e iletildi.
Dialogue: 0,0:20:10.31,0:20:17.63,Main,Tashigi,0,0,0,,Ama gazetede bunların hepsi gemi kazası, korsanlık ya da kayıp kişiler olarak duyuruldu.
Dialogue: 0,0:20:17.63,0:20:22.92,Main,Tashigi,0,0,0,,Elbette raporların başlangıçta yanlış olması ve daha sonra düzeltilmiş olması mümkün.
Dialogue: 0,0:20:22.92,0:20:27.68,Main,Tashigi,0,0,0,,Ama... Ama şu da mümkün...
Dialogue: 0,0:20:31.91,0:20:34.39,Main,Smoker,0,0,0,,Görünüşe göre tereddüt ediyorsun Tashigi.
Dialogue: 0,0:20:37.34,0:20:40.37,Main,Smoker,0,0,0,,Bir fikrin varsa açıkça söyle!
Dialogue: 0,0:20:41.50,0:20:44.24,Main,Smoker,0,0,0,,Az önce gördüğümüz çocuk sayısına göre...
Dialogue: 0,0:20:45.95,0:20:50.27,Main,Smoker,0,0,0,,Kaçırılma raporlarının doğru olduğunu mu düşünüyorsun?
Dialogue: 0,0:20:50.95,0:20:53.96,Main,Smoker,0,0,0,,Kaçıran da bu adada olabilir, değil mi?
Dialogue: 0,0:20:58.08,0:21:01.45,Main,Smoker,0,0,0,,Ama bunun doğru olabilmesi için...
Dialogue: 0,0:21:05.41,0:21:13.58,Main,Smoker,0,0,0,,G-5'in bir üyesinin medyaya yalan söyleyerek kaçırma olaylarını örtbas etmesi gerekir.
Dialogue: 0,0:21:14.23,0:21:18.35,Main,Marine2,0,0,0,,Yani bu, G-5'in içinden birinin suçluya yardım ettiği anlamına mı geliyor?
Dialogue: 0,0:21:18.61,0:21:22.48,Main,Soldier2,0,0,0,,Smo-san! Bizden şüphe ettiğine inanamıyorum!
Dialogue: 0,0:21:22.48,0:21:25.24,Main,Soldier2,0,0,0,,Donanmanın dışlanmışları olabiliriz,
Dialogue: 0,0:21:25.24,0:21:28.08,Main,Soldier2,0,0,0,,ama Denizciler olarak hâlâ gururumuz var!
Dialogue: 0,0:21:28.08,0:21:29.52,Main,Smoker,0,0,0,,{\i1}Kapayın çenenizi!
Dialogue: 0,0:21:29.52,0:21:30.98,Main,Marine,0,0,0,,Korkunç!
Dialogue: 0,0:21:30.98,0:21:35.13,Main,Smoker,0,0,0,,Sizin gibi aptallar şüphelenmeye bile değmez!
Dialogue: 0,0:21:35.13,0:21:36.33,Main,Marine,0,0,0,,Ne?
Dialogue: 0,0:21:36.32,0:21:40.70,Main,Smoker,0,0,0,,Ancak Denizciler hakkında da yanlış düşüncelere kapılmayın.
Dialogue: 0,0:21:41.93,0:21:44.22,Main,Smoker,0,0,0,,Tüm organizasyonlarda birden fazla kişi bulunur,
Dialogue: 0,0:21:44.22,0:21:47.27,Main,Smoker,0,0,0,,yani hiçbiri mükemmel olamaz!
Dialogue: 0,0:21:47.84,0:21:52.43,Main,Smoker,0,0,0,,Denizcilerin mükemmel olduğunu düşünürseniz düşmanları gözden kaçırırsınız! Görünüşe aldanmayın!
Dialogue: 0,0:22:03.48,0:22:05.86,Main,Soldiers,0,0,0,,Emredersiniz, Kaptan-chan!
Dialogue: 0,0:22:06.93,0:22:09.22,Main,Smoker,0,0,0,,Sizler... Neyse.
Dialogue: 0,0:22:09.22,0:22:11.19,Main,Tashigi,0,0,0,,K-Kaptan benim!
Dialogue: 0,0:22:11.19,0:22:14.48,Main,Soldiers,0,0,0,,Bu doğru! Görünüşe aldandık!
Dialogue: 0,0:22:14.79,0:22:18.71,Main,Tashigi,0,0,0,,Ama Smoker-san, ben hala ikna olmadım.
Dialogue: 0,0:22:18.71,0:22:23.11,Main,Smoker,0,0,0,,Endişelenme. Bu sadece aklımızda bulundurmamız gereken bir olasılık.
Dialogue: 0,0:22:23.11,0:22:27.52,Main,Smoker,0,0,0,,Ne olursa olsun, benim vücudum ve kalbim Law tarafından ele geçirildi.
Dialogue: 0,0:22:27.52,0:22:30.25,Main,Smoker,0,0,0,,Bu adayı terk edemeyiz.
Dialogue: 0,0:22:30.25,0:22:34.05,Main,Smoker,0,0,0,,Üçte biriniz gemiye gidip bunu rapor edecek.
Dialogue: 0,0:22:34.05,0:22:36.31,Main,Marine,0,0,0,,Koramiral, neyden bahsediyorsunuz?
Dialogue: 0,0:22:36.31,0:22:39.14,Main,Marine,0,0,0,,Gemi parçalara ayrıldı.
Dialogue: 0,0:22:39.14,0:22:41.59,Main,Smoker,0,0,0,,Size başka gemiler olduğunu söylemiştim, değil mi?
Dialogue: 0,0:22:41.59,0:22:42.38,Main,Smoker,0,0,0,,Gidin ve çalın.
Dialogue: 0,0:22:42.38,0:22:45.29,Main,Marine,0,0,0,,Demek plan buydu! Çok kötüsün!
Dialogue: 0,0:22:45.29,0:22:47.33,Main,Smoker,0,0,0,,Dikkatli olun.
Dialogue: 0,0:22:47.33,0:22:52.57,Main,Smoker,0,0,0,,Durum daha da kötüleşmeden önce,\Nkalbimi ve bedenimi geri alacağım...
Dialogue: 0,0:22:52.57,0:22:55.65,Main,Smoker,0,0,0,,sonra da bu adadaki ipleri elinde tutan kişiyi ifşa edeceğim!
Dialogue: 0,0:22:55.81,0:23:00.31,captions_soft,,0,0,0,,{\fad(570,0)\pos(643,438)}Eski Vegapunk Laboratuvarı
Dialogue: 0,0:22:55.81,0:23:00.31,captions_soft,,0,0,0,,{\fad(570,0)\pos(643,480)}Laboratuvar #3
Dialogue: 0,0:23:00.88,0:23:03.74,Main,Caesar,0,0,0,,Sonunda ona ulaştım.
Dialogue: 0,0:23:04.94,0:23:07.10,Main,Caesar,0,0,0,,Hepsini öldürmek için iznimiz var.
Dialogue: 0,0:23:07.51,0:23:13.07,Main,Caesar,0,0,0,,Hasır Şapka Korsanları, G-5 ve Tilki Ateşi Kin'emon.
Dialogue: 0,0:23:13.07,0:23:19.00,Main,Caesar,0,0,0,,Bu adada kim ölürse ölsün,\NJoker, olayı denizdeki bir kaza gibi gösterebilir.
Dialogue: 0,0:23:19.45,0:23:22.00,Main,Caesar,0,0,0,,Yakalayabildiğinizi yakalayın!
Dialogue: 0,0:23:22.00,0:23:24.12,Main,Caesar,0,0,0,,Ne kadar çok test deneğimiz olursa o kadar iyi.
Dialogue: 0,0:23:24.12,0:23:25.33,Main,Gasmask,0,0,0,,Emredersiniz, Master.
Dialogue: 0,0:23:26.02,0:23:30.80,Main,Caesar,0,0,0,,Ama eğer size sorun çıkarırlarsa,\No zaman onları gazla öldürmekten çekinmeyin.
Dialogue: 0,0:23:30.80,0:23:32.26,Main,Caesar,0,0,0,,Law nerede?
Dialogue: 0,0:23:32.26,0:23:34.29,Main,Gasmask,0,0,0,,Bir süre önce odayı terk etti.
Dialogue: 0,0:23:34.87,0:23:36.40,Main,Caesar,0,0,0,,Önemi yok.
Dialogue: 0,0:23:36.50,0:23:38.91,Main,Caesar,0,0,0,,Bir tanesinin 400 milyonluk ödülü varmış gibi görünüyor.
Dialogue: 0,0:23:38.91,0:23:40.67,Main,Caesar,0,0,0,,Kendinizi çok fazla zorlamayın.
Dialogue: 0,0:23:40.67,0:23:44.61,Main,Monet,0,0,0,,Ayrıca tayfanın 120 milyondan elli beliye kadar ödülleri var.
Dialogue: 0,0:23:44.61,0:23:48.99,Main,Monet,0,0,0,,Hasır Şapka Tayfasının toplam ödülü\N800 milyon elli beli.
Dialogue: 0,0:23:49.46,0:23:53.55,Main,Monet,0,0,0,,Ama iki yıldır ortalıktan kayboldular.
Dialogue: 0,0:23:53.55,0:23:55.42,Main,Monet,0,0,0,,Bunca zaman boyunca ödülleri değişmedi.
Dialogue: 0,0:23:55.98,0:23:58.90,Main,Monet,0,0,0,,Gerçek güçleri rakamların gösterdiğinden daha yüksek olabilir.
Dialogue: 0,0:23:58.90,0:24:01.51,Main,Caesar,0,0,0,,Araştırmanda her zaman titizsin Monet.
Dialogue: 0,0:24:03.37,0:24:04.63,Main,Centaur,0,0,0,,Master!
Dialogue: 0,0:24:08.47,0:24:12.57,Main,Caesar,0,0,0,,Sana ne oldu?\NDondurucu soğukta montsuz mu kaldın?
Dialogue: 0,0:24:12.57,0:24:14.63,Main,Centaur,0,0,0,,Korsanlar tarafından çalındı.
Dialogue: 0,0:24:14.63,0:24:18.15,Main,Centaur,0,0,0,,Daha önemlisi, Patron Kahverengisakal'ı kaçırdılar!
Dialogue: 0,0:24:18.15,0:24:20.56,Main,Centaur,0,0,0,,Lütfen onu kurtarın!
Dialogue: 0,0:24:20.56,0:24:22.61,Main,Caesar,0,0,0,,Ne yazık.
Dialogue: 0,0:24:23.98,0:24:28.57,Main,Caesar,0,0,0,,Kahverengisakal için endişelenme. Onu kesinlikle geri getireceğim.
Dialogue: 0,0:24:28.57,0:24:30.36,Main,Caesar,0,0,0,,Şimdi acele et ve içeriye gir.
Dialogue: 0,0:24:31.03,0:24:35.50,Main,Caesar,0,0,0,,Çok şanslısın. Yeni bir ilaç bitirdim.
Dialogue: 0,0:24:35.50,0:24:39.35,Main,Caesar,0,0,0,,Vücudunu ısıtacak ve yaralarınızı iyileştirecek bir şey.
Dialogue: 0,0:24:39.35,0:24:43.38,Main,Centaur,0,0,0,,Gerçekten mi? Beni kurtardın. Lütfen diğerlerine de yardım et!
Dialogue: 0,0:24:44.81,0:24:48.53,Main,Caesar,0,0,0,,Tabii ki. Ama önce kendini kurtar.
Dialogue: 0,0:24:48.53,0:24:52.67,Main,Centaur,0,0,0,,Çok teşekkür ederim! Çok teşekkür ederim!
Dialogue: 0,0:24:54.82,0:24:57.31,Main,Sanji,0,0,0,,Bu da ne, Usopp?!
Dialogue: 0,0:24:57.31,0:25:00.00,Main,Franky,0,0,0,,Bu çok süper!
Dialogue: 0,0:25:00.57,0:25:02.36,Main,Nami,0,0,0,,Pes ediyorum.
Dialogue: 0,0:25:02.36,0:25:04.74,Main,Chopper,0,0,0,,Teşekkürler, Usopp!
Dialogue: 0,0:25:05.18,0:25:07.73,Main,Sanji,0,0,0,,Bu şey Nami'nin güzelliğini gölgeliyor!
Dialogue: 0,0:25:07.73,0:25:12.45,Main,Usopp,0,0,0,,Şikayet etmeyi bırak!\NBunlar olmadan kafamız karışır!
Dialogue: 0,0:25:12.45,0:25:14.09,Main,Luffy,0,0,0,,Kahverengisakal mı?
Dialogue: 0,0:25:14.91,0:25:17.69,Main,Brownbeard,0,0,0,,Doğru. Bu adı duydunuz mu?
Dialogue: 0,0:25:17.69,0:25:19.68,Main,Brownbeard,0,0,0,,Bütün dünya beni bu isimle tanırdı!
Dialogue: 0,0:25:19.68,0:25:20.87,Main,Luffy,0,0,0,,Seni hiç duymadım.
Dialogue: 0,0:25:20.87,0:25:22.05,Main,Brownbeard,0,0,0,,Bu da ne demek?!
Dialogue: 0,0:25:22.39,0:25:26.90,Main,Zoro,0,0,0,,Ne oldu? Yakın zamana kadar ağzını açmaya gönüllü değildin...
Dialogue: 0,0:25:26.90,0:25:28.65,Main,Zoro,0,0,0,,ama şimdi seni susturamıyoruz.
Dialogue: 0,0:25:30.31,0:25:33.03,Main,Brownbeard,0,0,0,,Çünkü yakında öleceksiniz.
Dialogue: 0,0:25:33.03,0:25:35.63,Main,Brownbeard,0,0,0,,Law gelip beni kurtaracak.
Dialogue: 0,0:25:36.09,0:25:41.27,Main,Brownbeard,0,0,0,,Sizin neslinizdeki tüm korsanlardan nefret ediyorum ama Law farklı.
Dialogue: 0,0:25:41.27,0:25:44.27,Main,Luffy,0,0,0,,"Bizim nesil" derken neyi kastediyorsunuz?
Dialogue: 0,0:25:44.27,0:25:46.63,Main,Brownbeard,0,0,0,,Bilmiyor musun? Aptal.
Dialogue: 0,0:25:47.65,0:25:51.05,Main,Brownbeard,0,0,0,,İki yıl önce Sabaody Takımadaları'nda karşılaşan,
Dialogue: 0,0:25:51.05,0:25:55.47,Main,Brownbeard,0,0,0,,ve ödülü 100 milyon beli'yi aşan on bir çaylak ve Karasakal.
Dialogue: 0,0:25:55.47,0:25:59.67,Main,Brownbeard,0,0,0,,İnsanlar size "En Kötü Nesil" diyor.
Dialogue: 0,0:25:59.67,0:26:06.15,Main,Brownbeard,0,0,0,,Siz iki çağ arasındaki boşlukta doğmuş ve bunun getirdiği kaos içinde yaşamaya zorlanmış sorunlu çocuklarsınız.
Dialogue: 0,0:26:06.88,0:26:12.40,Main,Brownbeard,0,0,0,,Beyazsakal'ın ölümünden sonra Yeni Dünya'ya hücum ettiniz ve denizlerde hasara yol açtınız.
Dialogue: 0,0:26:12.40,0:26:18.38,Main,Brownbeard,0,0,0,,Ne zaman büyük bir olay olsa, bu her zaman sizin neslinizden biri oluyor.
Dialogue: 0,0:26:18.38,0:26:23.92,Main,Brownbeard,0,0,0,,Karasakal, Kid, Law, Drake, Hawkins.
Dialogue: 0,0:26:23.92,0:26:29.19,Main,Brownbeard,0,0,0,,Benim Kahverengisakal korsan tayfam Basil Hawkins tarafından yok edildi!
Dialogue: 0,0:26:29.87,0:26:34.88,Main,Brownbeard,0,0,0,,Onun yüzünden bacaklarımı kaybettim ve korsanlıktan vazgeçmek zorunda kaldım.
Dialogue: 0,0:26:34.88,0:26:42.65,Main,Brownbeard,0,0,0,,Canımızı kurtarıp Punk Hazard'a zar zor gelebildik.
Dialogue: 0,0:26:43.67,0:26:46.67,Main,Brownbeard,0,0,0,,Buranın ne olduğunu bilmiyor musunuz?
Dialogue: 0,0:26:46.67,0:26:47.58,Main,Usopp,0,0,0,,Hı?
Dialogue: 0,0:26:50.06,0:26:53.61,Main,Brownbeard,0,0,0,,Bu yer... bu ada...
Dialogue: 0,0:26:54.64,0:26:59.71,Main,Brownbeard,0,0,0,,hayat dolu, yemyeşil ormanlarla doluydu.
Dialogue: 0,0:26:59.71,0:27:01.03,Main,Luffy,0,0,0,,Burası mı?
Dialogue: 0,0:27:01.03,0:27:02.78,Main,Zoro,0,0,0,,Hayal bile edemiyorum.
Dialogue: 0,0:27:02.78,0:27:07.67,Main,Brownbeard,0,0,0,,Hükümetin bilim adamı Vegapunk deneylerini burada yapıyordu.
Dialogue: 0,0:27:07.67,0:27:12.04,Main,Brownbeard,0,0,0,,Burada silahlarla ve ilaçlarla ilgili birçok deney yaptı.
Dialogue: 0,0:27:17.14,0:27:22.11,Main,Brownbeard,0,0,0,,Buradaki mahkumların hiç hapse girmediklerini söylüyorlar.
Dialogue: 0,0:27:22.11,0:27:25.54,Main,Brownbeard,0,0,0,,Bunun yerine bu adaya getirilip insan kobay olarak kullanıldılar.
Dialogue: 0,0:27:27.09,0:27:32.05,Main,Brownbeard,0,0,0,,Sonra, dört yıl önce Vegapunk'un kimyasal silah deneylerinden biri ters gitti.
Dialogue: 0,0:27:55.70,0:27:59.48,Main,Brownbeard,0,0,0,,Üç laboratuvardan ikisi havaya uçtu.
Dialogue: 0,0:27:59.95,0:28:02.92,Main,Brownbeard,0,0,0,,Burası o laboratuvarların birinden kalanlar.
Dialogue: 0,0:28:10.02,0:28:13.54,Main,Usopp,0,0,0,,Anladım, patlama çok büyük olmalı.
Dialogue: 0,0:28:14.15,0:28:16.20,Main,Usopp,0,0,0,,Her şeyin parçalanmış olmasına şaşmamalı.
Dialogue: 0,0:28:16.40,0:28:20.07,Main,Brownbeard,0,0,0,,Patlama, tüm adaya zehir yayan bir yakıcı ısı dalgası saldı.
Dialogue: 0,0:28:20.07,0:28:23.79,Main,Brownbeard,0,0,0,,Tüm doğal yaşamı yok etti.
Dialogue: 0,0:28:23.79,0:28:29.62,Main,Brownbeard,0,0,0,,Bu gerçekleştiğinde Hükümet,\Ndenek olarak kullanılan mahkumları terk etti.
Dialogue: 0,0:28:30.29,0:28:35.13,Main,Brownbeard,0,0,0,,Adadan kaçarken adayı arkalarından mühürlediler!
Dialogue: 0,0:28:36.91,0:28:42.72,Main,Brownbeard,0,0,0,,Terk edilmiş mahkumlar kendilerini sağlam kalan tek laboratuvar olan Laboratuvar Üç'e kapattılar.
Dialogue: 0,0:28:42.72,0:28:47.67,Main,Brownbeard,0,0,0,,Adayı saran zehirli gazdan kaçabilmelerinin tek yolu buydu.
Dialogue: 0,0:28:47.67,0:28:54.47,Main,Brownbeard,0,0,0,,Sinir gazı nedeniyle ölmeyenler,\Nbacaklarını hareket ettirme yeteneğini kaybediyordu.
Dialogue: 0,0:28:54.47,0:28:57.28,Main,Brownbeard,0,0,0,,Artık tüm umutlarını kaybetmişlerdi.
Dialogue: 0,0:28:57.91,0:29:06.41,Main,Brownbeard,0,0,0,,Ama bir yıl sonra cömert Master bu adaya geldi!
Dialogue: 0,0:29:07.96,0:29:11.41,Main,Brownbeard,0,0,0,,Özel gücüyle adadaki gazı temizledi.
Dialogue: 0,0:29:12.28,0:29:20.61,Main,Brownbeard,0,0,0,,Yürüyemeyen mahkumlara yardım etmek için bilimi kullandı ve onları emrine aldı!
Dialogue: 0,0:29:21.75,0:29:24.59,Main,Franky,0,0,0,,Master!
Dialogue: 0,0:29:24.59,0:29:26.12,Main,Chopper,0,0,0,,Master!
Dialogue: 0,0:29:26.12,0:29:28.46,Main,Brook,0,0,0,,Master-san!
Dialogue: 0,0:29:28.46,0:29:35.34,Main,Brownbeard,0,0,0,,Ben adaya ondan bir yıl sonra, yani iki yıl önce geldim.
Dialogue: 0,0:29:47.88,0:29:51.25,Main,Brownbeard,0,0,0,,Zehirli gazın hâlâ bir miktar kalıntısı kalmıştı.
Dialogue: 0,0:29:51.25,0:29:53.77,Main,Brownbeard,0,0,0,,Onu solumak midenizi bulandırıyordu.
Dialogue: 0,0:29:53.78,0:29:57.67,Main,Brownbeard,0,0,0,,Yaşayacak gücüm yoktu.
Dialogue: 0,0:29:57.67,0:30:01.35,Main,Brownbeard,0,0,0,,Sonumun geldiğini düşünerek pes etmiştim.
Dialogue: 0,0:30:06.14,0:30:13.19,Main,Brownbeard,0,0,0,,İşte o zaman onları, benim gibi bacaklarını kaybetmiş eski mahkumları ve Master'ı gördüm.
Dialogue: 0,0:30:15.73,0:30:21.05,Main,Brownbeard,0,0,0,,Ve tıpkı onlar gibi benim hayatım da Master'ın nezaketi sayesinde kurtuldu.
Dialogue: 0,0:30:22.19,0:30:25.73,Main,Brownbeard,0,0,0,,Yoldaşlarımın bacaklarını çalan Vegapunk bir şeytansa,
Dialogue: 0,0:30:26.89,0:30:29.89,Main,Brownbeard,0,0,0,,o zaman Master de iyi kalpli bir kurtarıcı melektir.
Dialogue: 0,0:30:31.35,0:30:34.47,Main,Brownbeard,0,0,0,,Ve birkaç ay önce,
Dialogue: 0,0:30:34.47,0:30:41.22,Main,Brownbeard,0,0,0,,bir başka kurtarıcı melek olan Shichibukai'lerin yeni üyesi Trafalgar Law bu adaya geldi.
Dialogue: 0,0:30:42.09,0:30:47.87,Main,Brownbeard,0,0,0,,Yeteneğiyle yürüyemeyen arkadaşlarımıza bacak verdi.
Dialogue: 0,0:30:47.87,0:30:50.61,Main,Brownbeard,0,0,0,,Hayvanların bacaklarını!
Dialogue: 0,0:30:56.84,0:31:02.60,Main,Brownbeard,0,0,0,,Bir daha yürüyemeyeceğimizi düşünen bizler sevinç gözyaşları döktük.
Dialogue: 0,0:31:02.60,0:31:05.73,Main,ChopperandFranky,0,0,0,,Ne harika bir hikaye!
Dialogue: 0,0:31:05.73,0:31:08.47,Main,Luffy,0,0,0,,Tra-o'nun iyi biri olduğunu biliyordum!
Dialogue: 0,0:31:08.47,0:31:10.99,Main,Luffy,0,0,0,,Beni de kurtardı!
Dialogue: 0,0:31:10.99,0:31:13.57,Main,Nami,0,0,0,,Vegapunk'ın bu kadar acımasız bir adam olduğunu bilmiyordum.
Dialogue: 0,0:31:13.57,0:31:17.74,Main,Sanji,0,0,0,,Yani laboratuvarda gördüğümüz koyun insanlar Law'un güçleri tarafından yaratılmıştı.
Dialogue: 0,0:31:17.74,0:31:21.34,Main,Usopp,0,0,0,,Sanırım bu Sentor'ları ve kuş kadını da açıklıyor.
Dialogue: 0,0:31:21.34,0:31:23.66,Main,Usopp,0,0,0,,Ama durun, ejderhaya ne demeli?
Dialogue: 0,0:31:23.66,0:31:26.50,Main,Brownbeard,0,0,0,,Ejderhayı gördünüz mü?
Dialogue: 0,0:31:26.50,0:31:32.22,Main,Brownbeard,0,0,0,,O Vegapunk'un adayı korumak için yarattığı yapay bir yaratık.
Dialogue: 0,0:31:32.22,0:31:34.50,Main,Brownbeard,0,0,0,,Her ortama uyum sağlayabilir.
Dialogue: 0,0:31:35.25,0:31:40.00,Main,Brownbeard,0,0,0,,Kutsal Ejderlerden biri ondan hoşlandı ve ona bir isim verdi,
Dialogue: 0,0:31:40.00,0:31:41.07,Main,Brownbeard,0,0,0,,ama unuttum.
Dialogue: 0,0:31:41.07,0:31:44.80,Main,Brownbeard,0,0,0,,Eğer tekrar görürseniz, kaçın. Çok vahşidir.
Dialogue: 0,0:31:44.80,0:31:45.93,Main,Zoro,0,0,0,,Anlaşıldı.
Dialogue: 0,0:31:45.93,0:31:47.02,Thoughts,Zoro,0,0,0,,Gerçi onu çoktan yedim.
Dialogue: 0,0:31:47.02,0:31:51.17,Main,Brownbeard,0,0,0,,Neyse, adanın kimin kontrolünde olduğunu anlıyor musun?
Dialogue: 0,0:31:51.17,0:31:53.45,Main,Brownbeard,0,0,0,,Başka kimsenin işgal etmesine izin vermeyeceğiz.
Dialogue: 0,0:31:53.45,0:31:57.32,Main,Brownbeard,0,0,0,,Bu ada, Punk Hazard, Master'a aittir.
Dialogue: 0,0:31:59.60,0:32:00.99,Main,Brownbeard,0,0,0,,Sevinin!
Dialogue: 0,0:32:00.99,0:32:05.68,Main,Brownbeard,0,0,0,,Master şu anda bile insanlığın geleceği yararına araştırmalarına devam ediyor.
Dialogue: 0,0:32:05.68,0:32:10.31,Main,Brownbeard,0,0,0,,Onun yalnızca birkaç insan test deneğine ihtiyacı var ve siz de o denekler olacaksınız!
Dialogue: 0,0:32:10.31,0:32:12.58,Main,Brownbeard,0,0,0,,Kaçamazsınız!
Dialogue: 0,0:32:16.92,0:32:19.49,Main,Caesar,0,0,0,,Neler oluyor?
Dialogue: 0,0:32:19.49,0:32:20.77,Main,Centaur,0,0,0,,Master!
Dialogue: 0,0:32:20.77,0:32:21.99,Main,Centaur,0,0,0,,Master!
Dialogue: 0,0:32:21.99,0:32:23.42,Main,Centaur,0,0,0,,Acıyor...
Dialogue: 0,0:32:23.42,0:32:24.55,Main,Centaur,0,0,0,,Ne...
Dialogue: 0,0:32:26.00,0:32:27.37,Main,Centaur,0,0,0,,Bu ne tür bir ilaç?
Dialogue: 0,0:32:28.95,0:32:30.55,Main,Centaur,0,0,0,,Master!
Dialogue: 0,0:32:31.66,0:32:32.80,Main,Centaur,0,0,0,,Master!
Dialogue: 0,0:32:35.85,0:32:38.11,Main,Centaur,0,0,0,,Beni buradan çıkarın!
Dialogue: 0,0:32:39.67,0:32:41.76,Main,Caesar,0,0,0,,Bir süre daha buna dayanmaya çalış.
Dialogue: 0,0:32:42.30,0:32:44.06,Main,Caesar,0,0,0,,Şimdi nasıl hissediyorsun?
Dialogue: 0,0:32:46.84,0:32:51.62,Main,Caesar,0,0,0,,Mide bulantısı? Öksürük? Bu iyi. Başın ağrıyor mu?
Dialogue: 0,0:32:51.62,0:32:54.86,Main,Centaur,0,0,0,,Kafam! İkiye bölünecek!
Dialogue: 0,0:32:54.86,0:32:56.26,Main,Caesar,0,0,0,,Anladım.
Dialogue: 0,0:32:59.15,0:33:01.81,Main,Marine,0,0,0,,Ha?! Vegapunk değil mi?
Dialogue: 0,0:33:01.81,0:33:03.51,Main,Marine,0,0,0,,O zaman o kimdi, Smo-san?
Dialogue: 0,0:33:03.51,0:33:06.56,Main,Marine,0,0,0,,Dev patlamanın arkasında aslında kim vardı?
Dialogue: 0,0:33:06.56,0:33:11.26,Main,Smoker,0,0,0,,Silahı yapan ve onu havaya uçuran kişi,
Dialogue: 0,0:33:11.26,0:33:12.78,Main,Smoker,0,0,0,,Caesar Clown'du.
Dialogue: 0,0:33:15.78,0:33:20.95,Main,Smoker,0,0,0,,O zamanlar bilim bölümünün iki numarasıydı.
Dialogue: 0,0:33:20.95,0:33:26.50,Main,Smoker,0,0,0,,ancak yöntemleri insanlık dışıydı ve her zaman Vegapunk'a meydan okuyordu.
Dialogue: 0,0:33:27.55,0:33:30.06,Main,Centaur,0,0,0,,M-Master!
Dialogue: 0,0:33:32.01,0:33:34.70,Main,Centaur,0,0,0,,K-Kurtarın beni!
Dialogue: 0,0:33:37.41,0:33:38.89,Main,Caesar,0,0,0,,Ne görüyorsun?
Dialogue: 0,0:33:38.89,0:33:40.82,Main,Caesar,0,0,0,,Herhangi bir halüsinasyon görüyor musun??
Dialogue: 0,0:33:43.93,0:33:46.56,Main,Centaur,0,0,0,,B-Burada dev bir yılan var!
Dialogue: 0,0:33:50.93,0:33:52.37,Main,Caesar,0,0,0,,Tabii ki yok!
Dialogue: 0,0:33:52.37,0:33:55.51,Main,Caesar,0,0,0,,Sanırım bu kadarı yeterli. Acına son verme vakti.
Dialogue: 0,0:34:02.19,0:34:08.00,Main,Smoker,0,0,0,,Vegapunk kazanın suçunu üstlendi\Nancak bunun nedeni sadece onun sorumlu kişi olmasıydı.
Dialogue: 0,0:34:08.58,0:34:15.40,Main,Smoker,0,0,0,,Bir adayı zehirli gazla kaplayacak bir kitle imha silahı geliştirmek elbette suçtur.
Dialogue: 0,0:34:15.40,0:34:19.51,Main,Smoker,0,0,0,,Kazanın nedenini anladığımızda Ceaser'ı yakaladık.
Dialogue: 0,0:34:20.25,0:34:25.59,Main,Smoker,0,0,0,,Ancak gücünün çok güçlü olduğu ortaya çıktı ve mahkum nakliye gemisinden kaçtı.
Dialogue: 0,0:34:25.59,0:34:27.85,Main,Smoker,0,0,0,,O zamandan beri saklanıyor.
Dialogue: 0,0:34:28.68,0:34:36.04,Main,Smoker,0,0,0,,Eğer araştırmasına gerçekten bu adada devam ediyorsa onu hemen durdurmalıyız.
Dialogue: 0,0:34:36.65,0:34:39.75,Main,Smoker,0,0,0,,Başka bir iğrenç suç işlemeden önce!
Dialogue: 0,0:34:41.12,0:34:42.49,Main,Caesar,0,0,0,,Tekrar denemem gerekecek.
Dialogue: 0,0:34:47.40,0:34:48.90,Main,Monet,0,0,0,,Başka bir başarısızlık mı?
Dialogue: 0,0:34:50.43,0:34:53.63,Main,Caesar,0,0,0,,Başarısızlık mı?! Ağzından çıkanlara dikkat et!
Dialogue: 0,0:34:54.10,0:35:04.02,captions_soft,,0,0,0,,{\fad(489,0)\pos(400,438)}Hükümet'in Eski Bilim Adamı
Dialogue: 0,0:34:54.10,0:35:04.02,captions_soft,,0,0,0,,{\fad(489,0)\pos(922,438)}Ödül: 300 milyon beli
Dialogue: 0,0:34:54.10,0:35:04.02,captions_soft,,0,0,240,,{\fad(489,0)}"Master" Caesar Clown
Dialogue: 0,0:34:54.45,0:34:57.28,Main,Caesar,0,0,0,,Denemelerim asla başarısız olmaz.
Dialogue: 0,0:34:57.28,0:34:59.74,Main,Caesar,0,0,0,,Dört yıl önceki olay da başarısızlık değildi.
Dialogue: 0,0:34:59.74,0:35:03.78,Main,Caesar,0,0,0,,Dünya Hükümeti böyle saçmalıklar söyledi!
Dialogue: 0,0:35:03.78,0:35:05.61,Main,Caesar,0,0,0,,Başarısız bir deney mi?
Dialogue: 0,0:35:05.61,0:35:08.97,Main,Caesar,0,0,0,,Silahımın kocaman bir adayı nasıl öldürebileceğini gösterdim!
Dialogue: 0,0:35:08.97,0:35:11.26,Main,Caesar,0,0,0,,Başarısızlık bunun neresinde?
Dialogue: 0,0:35:12.27,0:35:15.72,Main,Caesar,0,0,0,,Konu düşmanları öldürmeye gelince, ben dünyanın en iyisiyim.
Dialogue: 0,0:35:17.33,0:35:22.26,Main,Caesar,0,0,0,,Ayrıca hayatta kalanların her birinin ilerleyişini de eksiksiz olarak takip ettim!
Dialogue: 0,0:35:22.26,0:35:28.68,Main,Caesar,0,0,0,,Sadece izle! Onlara dünyadaki bir numaralı bilim adamının kim olduğunu göstereceğim!
