Dialogue: 0,0:02:29.87,0:02:31.33,Thoughts,Kinemon,0,0,0,,Orada kim var?
Dialogue: 0,0:02:32.12,0:02:32.91,Main,Luffy,0,0,0,,{Hey!}
Dialogue: 0,0:02:32.91,0:02:35.71,Main,Luffy,0,0,0,,Bu şey konuştu!
Dialogue: 0,0:02:35.71,0:02:38.76,Main,Usopp,0,0,0,,S-S-Saçmalama! Hayal görüyor olmalısın!
Dialogue: 0,0:02:38.76,0:02:39.84,Main,Luffy,0,0,0,,Gerçekten mi?
Dialogue: 0,0:02:43.39,0:02:48.10,Main,Usopp,0,0,0,,Bunun aslında bir ejderha olduğuna inanmak çok zor!
Dialogue: 0,0:02:48.10,0:02:50.52,Main,Zoro,0,0,0,,Bu gerçekten ejderha mı?
Dialogue: 0,0:02:51.02,0:02:53.69,Main,Robin,0,0,0,,Evet, inanması ne kadar güç olursa olsun.
Dialogue: 0,0:02:54.23,0:02:56.90,Main,Robin,0,0,0,,Dev kanatlı ve kertenkele gövdeli...
Dialogue: 0,0:02:56.90,0:03:00.78,Main,Robin,0,0,0,,Nereden bakarsan bak, aynı efsanelerde anlatıldığı gibi!
Dialogue: 0,0:03:08.54,0:03:09.50,Main,Zoro,0,0,0,,Yoksa...
Dialogue: 0,0:03:17.75,0:03:20.84,Main,Usopp,0,0,0,,A-A-A-
Dialogue: 0,0:03:20.84,0:03:23.81,Main,Usopp,0,0,0,,{\i1}Alev püskürttü!
Dialogue: 0,0:03:27.93,0:03:30.23,Main,Usopp,0,0,0,,Böyle bir yaratık nasıl var olabilir?!
Dialogue: 0,0:03:30.23,0:03:31.60,Main,Usopp,0,0,0,,Hayal mi görüyorum?!
Dialogue: 0,0:03:34.36,0:03:35.48,Main,Zoro,0,0,0,,Heyecan verici!
Dialogue: 0,0:03:38.75,0:03:40.35,Attack,Zoro,0,0,0,,{\fad(100,100)}Lastik Lastik
Dialogue: 0,0:03:43.10,0:03:45.90,Attack,Zoro,0,0,0,,{\fad(100,100)}Jet Mermisi
Dialogue: 0,0:03:51.71,0:03:53.08,Main,Robin,0,0,0,,Etki etmedi mi?!
Dialogue: 0,0:03:54.12,0:03:55.63,Main,Luffy,0,0,0,,Kesinlikle zorlu!
Dialogue: 0,0:03:58.84,0:04:00.01,Main,Zoro,0,0,0,,Arkanda!
Dialogue: 0,0:04:08.93,0:04:10.06,Main,Usopp,0,0,0,,Luffy!
Dialogue: 0,0:04:18.27,0:04:20.53,Main,Usopp,0,0,0,,{\i1}Bize bakıyor!
Dialogue: 0,0:04:20.53,0:04:22.24,Main,Zoro,0,0,0,,Gel bakalım!
Dialogue: 0,0:04:23.02,0:04:23.99,Main,Usopp,0,0,0,,Seni duyabiliyor!
Dialogue: 0,0:04:31.54,0:04:33.96,Thoughts,Kinemon,0,0,0,,Varlığını hissedebiliyorum!
Dialogue: 0,0:04:41.92,0:04:46.96,Main,Zoro,0,0,0,,Yani bu doğru. Ejderha gerçekten bir şeyler söyledi!
Dialogue: 0,0:04:49.95,0:04:51.75,Attack,Zoro,0,0,0,,{\fad(100,100)}Üç-Kılıç Stili
Dialogue: 0,0:04:51.77,0:04:54.23,Attack,TL Note,0,0,0,,{\fad(100,100)}Nihai Kaplan Avı!
Dialogue: 0,0:05:19.54,0:05:24.21,Main,Zoro,0,0,0,,Kahretsin! Nasıl bu kadar güçlü ve dayanıklı olabilir?!
Dialogue: 0,0:05:28.80,0:05:31.97,Main,Luffy,0,0,0,,Şerefsiz!
Dialogue: 0,0:05:40.64,0:05:41.40,Main,Zoro,0,0,0,,Luffy!
Dialogue: 0,0:05:41.40,0:05:42.32,Main,Luffy,0,0,0,,Efendim?
Dialogue: 0,0:05:43.07,0:05:45.07,Main,Zoro,0,0,0,,Konuştu.
Dialogue: 0,0:05:45.40,0:05:46.65,Main,Luffy,0,0,0,,Söylemiştim!
Dialogue: 0,0:05:46.65,0:05:49.24,Main,Usopp,0,0,0,,Ben de duydum! Neden?!
Dialogue: 0,0:06:04.46,0:06:06.17,Main,Usopp,0,0,0,,Uçuyor!
Dialogue: 0,0:06:08.72,0:06:13.28,Thoughts,Kinemon,0,0,0,,Sizler o Shichibukai'nin dostu musunuz?!
Dialogue: 0,0:06:26.90,0:06:28.15,Main,Usopp,0,0,0,,Sıcak!
Dialogue: 0,0:06:28.15,0:06:33.33,Main,Usopp,0,0,0,,Çok sıcak... ve o ejderha tekrar konuştu!
Dialogue: 0,0:06:39.96,0:06:42.54,Main,Robin,0,0,0,,"Shichibukai" dedi, değil mi?
Dialogue: 0,0:06:42.54,0:06:44.25,Main,Robin,0,0,0,,Acaba Shichibukai'lere karşı kin mi besliyor?
Dialogue: 0,0:06:53.85,0:06:55.05,Main,Zoro,0,0,0,,Luffy.
Dialogue: 0,0:06:55.05,0:06:57.10,Main,Zoro,0,0,0,,Onu bana bırak.
Dialogue: 0,0:06:59.19,0:07:01.31,Main,Zoro,0,0,0,,Bu sefer onu ikiye ayıracağım!
Dialogue: 0,0:07:01.31,0:07:03.76,Main,Luffy,0,0,0,,Tamam, hallederim!
Dialogue: 0,0:07:04.15,0:07:05.20,Main,Luffy,0,0,0,,Öyleyse...
Dialogue: 0,0:07:06.35,0:07:07.28,Main,Luffy,0,0,0,,{\i1}Sıcak! Sıcak! Sıcak!
Dialogue: 0,0:07:08.69,0:07:10.78,Main,Luffy,0,0,0,,Onu yere düşüreceğim!
Dialogue: 0,0:07:20.16,0:07:22.28,Main,Luffy,0,0,0,,{\i1}Sıcak! Sıcak! Sıcak!
Dialogue: 0,0:07:26.17,0:07:28.59,Main,Luffy,0,0,0,,Vücudu bile sıcak!
Dialogue: 0,0:07:40.81,0:07:44.90,Main,Kinemon,0,0,0,,Söylemeliyim ki, bu oldukça hoş!
Dialogue: 0,0:07:47.44,0:07:49.86,Main,Kinemon,0,0,0,,Alevler oldukça canlandırıcı!
Dialogue: 0,0:07:52.45,0:07:53.66,Main,Kinemon,0,0,0,,Dur yapma...
Dialogue: 0,0:07:53.66,0:07:55.87,Main,Kinemon,0,0,0,,Gıdıklanıyorum!
Dialogue: 0,0:07:59.25,0:08:01.00,Main,Kinemon,0,0,0,,Kes şunu!
Dialogue: 0,0:08:01.00,0:08:03.42,Main,Kinemon,0,0,0,,Sana durmanı emrediyorum!
Dialogue: 0,0:08:04.42,0:08:05.92,Main,Luffy,0,0,0,,Biliyordum!
Dialogue: 0,0:08:05.92,0:08:09.13,Main,Luffy,0,0,0,,Hey! Bu inanılmaz!
Dialogue: 0,0:08:09.13,0:08:13.17,Main,Luffy,0,0,0,,Ejderhanın sırtından bir insan çıkıyor!
Dialogue: 0,0:08:13.17,0:08:15.89,Main,Usopp,0,0,0,,Ha?! Neler oluyor?!
Dialogue: 0,0:08:16.60,0:08:18.31,Main,Robin,0,0,0,,Yani öncesinde konuşan...
Dialogue: 0,0:08:25.93,0:08:28.02,Main,Luffy,0,0,0,,Şerefsiz!
Dialogue: 0,0:08:30.65,0:08:32.53,Main,Luffy,0,0,0,,Neden kanadını yemiyorsun!
Dialogue: 0,0:08:51.64,0:08:52.83,Main,Luffy,0,0,0,,Aptal!
Dialogue: 0,0:08:59.97,0:09:03.68,Main,Luffy,0,0,0,,Zoro! Sana doğru düşüyor!
Dialogue: 0,0:09:09.56,0:09:11.32,Main,Zoro,0,0,0,,Usopp!
Dialogue: 0,0:09:12.44,0:09:14.40,Main,Usopp,0,0,0,,Tamamdır!
Dialogue: 0,0:09:14.27,0:09:16.86,Attack,TL-Note,0,0,0,, {\fad(100,100)}Ölümcül Yeşil Yıldız
Dialogue: 0,0:09:20.40,0:09:21.50,Attack,TL-Note,0,0,0,, {\fad(100,100)}Trambolin
Dialogue: 0,0:09:35.93,0:09:37.33,Attack,TL Note,0,0,0,,{\fad(100,100)}Tek-Kılıç Stili
Dialogue: 0,0:09:44.39,0:09:46.01,Attack,TL Note,0,0,0,,{\fad(100,100)}Çekme-ve-Koyma Tekniği
Dialogue: 0,0:09:52.86,0:09:55.39,Attack,TL Note,0,0,0,,{\fad(100,100)}Ölüm Aslanı Şarkısı
Dialogue: 0,0:10:06.41,0:10:07.92,Main,Usopp,0,0,0,,İnanılmaz!
Dialogue: 0,0:10:15.01,0:10:17.42,Main,Luffy,0,0,0,,Ejderha leziz görünüyor!
Dialogue: 0,0:10:17.42,0:10:19.84,Main,Zoro,0,0,0,,Adanın alevleriyle mangal yapabiliriz!
Dialogue: 0,0:10:19.84,0:10:22.00,Main,Luffy,0,0,0,,Harika fikir!
Dialogue: 0,0:10:24.50,0:10:26.10,Attack,Luffy,0,0,0,,{\fad(100,100)}Yüz Çiçek
Dialogue: 0,0:10:39.10,0:10:41.61,Main,Sanji,0,0,0,,Nami-swan!
Dialogue: 0,0:10:42.87,0:10:46.70,Main,Sanji,0,0,0,,Bu sefer bize soğuk kabuklu balık krepi yaptım!
Dialogue: 0,0:10:46.70,0:10:49.00,Main,Sanji,0,0,0,,Biraz şampanyayla birlikte!
Dialogue: 0,0:10:51.83,0:10:55.21,Main,Sanji,0,0,0,,Ha? Uyuyor musunuz?
Dialogue: 0,0:10:59.93,0:11:01.05,Main,Sanji,0,0,0,,Sis mi?
Dialogue: 0,0:11:06.89,0:11:07.77,Main,Sanji,0,0,0,,Hayır...
Dialogue: 0,0:11:09.85,0:11:13.02,Thoughts,Sanji,0,0,0,,Kahretsin! Çoktan fazlasıyla içime çektim!
Dialogue: 0,0:11:13.48,0:11:15.77,Thoughts,Sanji,0,0,0,,Hepsi gazdan bayıldı!
Dialogue: 0,0:11:15.77,0:11:18.65,Thoughts,Sanji,0,0,0,,Bu Yeni Dünya'ya özgü doğal bir gaz mı?
Dialogue: 0,0:11:19.57,0:11:22.61,Thoughts,Sanji,0,0,0,,Yoksa biri gemiye mi bindi?
Dialogue: 0,0:11:24.52,0:11:27.49,Thoughts,Sanji,0,0,0,,Umarım o adadaki dördün...
Dialogue: 0,0:11:27.49,0:11:30.62,Thoughts,Sanji,0,0,0,,Bebek Den Den Mushi'si vardır.
Dialogue: 0,0:11:35.25,0:11:39.47,Thoughts,Sanji,0,0,0,,Onlara... söylemeliyim...
Dialogue: 0,0:12:13.45,0:12:15.79,Main,Man,0,0,0,,İki insan.
Dialogue: 0,0:12:15.79,0:12:18.96,Main,Man,0,0,0,,Bir demir adam.
Dialogue: 0,0:12:19.46,0:12:22.38,Main,Man,0,0,0,,Bir evcil hayvan.
Dialogue: 0,0:12:24.32,0:12:26.30,Main,Man,0,0,0,,Hepsini bağlayın!
Dialogue: 0,0:12:26.30,0:12:27.30,Main,Man,0,0,0,,{\i1}Emredersiniz efendim!
Dialogue: 0,0:12:28.27,0:12:31.89,Main,Man,0,0,0,,Korsanlar amaçlarımız için idealler.
Dialogue: 0,0:12:32.48,0:12:37.89,Main,Man,0,0,0,,Kaybolsalar bile kimsenin umurunda olmaz.
Dialogue: 0,0:12:52.57,0:12:56.88,Main,Man,0,0,0,,Onları doğrudan Master'a götürelim.
Dialogue: 0,0:12:52.57,0:12:56.88,Note,Man,0,0,0,,Master: Efendi
Dialogue: 0,0:12:58.29,0:13:00.80,Captions,Caption,0,0,0,,{\fad(600,0)\pos(640,544)}Punk Hazard Adası
Dialogue: 0,0:13:01.96,0:13:04.50,Captions,Caption,0,0,0,,{\fad(600,0)\pos(640,544)}Yanan Topraklar
Dialogue: 0,0:13:05.43,0:13:07.43,Main,Luffy,0,0,0,,Hadi onu çıkartalım!
Dialogue: 0,0:13:08.01,0:13:11.06,Main,Kinemon,0,0,0,,Sana kim olduğunu soruyorum?! Ellerini çek!
Dialogue: 0,0:13:11.06,0:13:12.98,Main,Luffy,0,0,0,,Seni oradan çıkartacağım!
Dialogue: 0,0:13:12.98,0:13:14.38,Main,Luffy,0,0,0,,Düzgün dur!
Dialogue: 0,0:13:14.38,0:13:16.52,Main,Luffy,0,0,0,,Kalk!
Dialogue: 0,0:13:22.35,0:13:24.86,Main,Luffy,0,0,0,,{\i1}Onu ikiye ayırdım! Üzgünüm!
Dialogue: 0,0:13:24.86,0:13:28.78,Main,Usopp,0,0,0,,{\i1}Aptal, özür dilemen bunu düzeltir mi?!\NOnu öldürdün!
Dialogue: 0,0:13:33.33,0:13:35.29,Main,Kinemon,0,0,0,,Şimdi özgür müyüm?
Dialogue: 0,0:13:38.67,0:13:41.93,Main,Luffy,0,0,0,,Bacaklar konuşuyor! Neler oluyor?!
Dialogue: 0,0:13:41.93,0:13:46.55,Main,Usopp,0,0,0,,{\i1}Zombi! Canavar!
Dialogue: 0,0:13:46.59,0:13:47.89,Main,Robin,0,0,0,,Bekleyin.
Dialogue: 0,0:13:48.55,0:13:52.96,Main,Robin,0,0,0,,Bu ne demek olabilir?\NVücudunun ikiye ayrıldığına dair bir iz yok.
Dialogue: 0,0:13:54.34,0:13:56.56,Main,Zoro,0,0,0,,Bu ne demek oluyor?
Dialogue: 0,0:13:56.56,0:13:59.73,Main,Usopp,0,0,0,,Yani... bu onun başından beri sadece bir çift bacak olduğu anlamına mı geliyor?
Dialogue: 0,0:14:00.98,0:14:02.44,Main,Luffy,0,0,0,,Tuhaf!
Dialogue: 0,0:14:04.69,0:14:07.11,Main,Usopp,0,0,0,,Bayağı uzun.
Dialogue: 0,0:14:09.32,0:14:12.95,Main,Kinemon,0,0,0,,Kim var orada? Ne yapıyorsun?
Dialogue: 0,0:14:12.95,0:14:16.58,Main,Kinemon,0,0,0,,Varlığını hissediyorum,\Nama gözüm ya da kulağım yok.
Dialogue: 0,0:14:16.58,0:14:19.04,Main,Luffy,0,0,0,,Kesinlikle eşsizsin!
Dialogue: 0,0:14:19.04,0:14:23.34,Main,Kinemon,0,0,0,,Kim olduğunu bilmesem de geçmeme izin vereceksin!
Dialogue: 0,0:14:23.34,0:14:24.38,Main,Luffy,0,0,0,,Ne?
Dialogue: 0,0:14:24.38,0:14:28.63,Main,Kinemon,0,0,0,,Burada ölmeyeceğim!
Dialogue: 0,0:14:28.63,0:14:29.47,Main,Luffy,0,0,0,,Kaçıyor!
Dialogue: 0,0:14:29.47,0:14:35.38,Main,Kinemon,0,0,0,,Bunu yanına bırakmayacağım! Aptal Shichibukai!
Dialogue: 0,0:14:37.78,0:14:40.98,Main,Luffy,0,0,0,,Bekle! Tayfama ka{\fscx250}-{\r}
Dialogue: 0,0:14:40.98,0:14:42.41,Main,Usopp,0,0,0,,Yeter bu kadar, Luffy!
Dialogue: 0,0:14:44.02,0:14:46.99,Main,Usopp,0,0,0,,Ve... böyle mi oldu?
Dialogue: 0,0:14:46.99,0:14:49.15,Main,Luffy,0,0,0,,Evet, bu doğru!
Dialogue: 0,0:14:51.16,0:14:53.33,Main,Luffy,0,0,0,,Ejderha eti leziz!
Dialogue: 0,0:14:54.08,0:14:56.49,Main,Luffy,0,0,0,,Bunlara ne deniyor, Usopp?
Dialogue: 0,0:14:58.16,0:14:59.37,Main,Usopp,0,0,0,,Ha?
Dialogue: 0,0:15:00.37,0:15:01.83,Main,Usopp,0,0,0,,Sanırım...
Dialogue: 0,0:15:03.17,0:15:05.10,Main,Usopp,0,0,0,,Sentor, değil mi? {Sentor için çeviri notu eklenebilir}
Dialogue: 0,0:15:06.84,0:15:09.21,Main,Luffy,0,0,0,,Ben Sentor'um!
Dialogue: 0,0:15:09.21,0:15:11.30,Main,Luffy,0,0,0,,Bu harika!
Dialogue: 0,0:15:12.80,0:15:15.35,Main,Usopp,0,0,0,,İlk başta ejderhaya yapışmıştı, ve şimdi ise Luffy'e mi yapıştı?
Dialogue: 0,0:15:15.35,0:15:17.47,Main,Usopp,0,0,0,,Bu adamın olayı ne?!
Dialogue: 0,0:15:18.64,0:15:19.81,Main,Luffy,0,0,0,,Pes ettin mi?
Dialogue: 0,0:15:20.57,0:15:23.23,Main,Kinemon,0,0,0,,Kahretsin!\NYine bir şeye yapıştım!
Dialogue: 0,0:15:23.23,0:15:25.94,Main,Kinemon,0,0,0,,Ben sadece... Bırak gideyim!
Dialogue: 0,0:15:26.36,0:15:28.61,Main,Robin,0,0,0,,Bu hiç nazik değil, Luffy.
Dialogue: 0,0:15:29.30,0:15:30.32,Main,Luffy,0,0,0,,Gerçekten mi?
Dialogue: 0,0:15:31.32,0:15:32.24,Main,Luffy,0,0,0,,Şimdi ne oldu?
Dialogue: 0,0:15:34.58,0:15:36.87,Main,Usopp,0,0,0,,Gördün mü? Tabii ki öylece senin bir parçan olmayacak!
Dialogue: 0,0:15:36.87,0:15:39.04,Main,Usopp,0,0,0,,Kimse bu kadar itaatkar olamaz!
Dialogue: 0,0:15:39.04,0:15:41.54,Main,Usopp,0,0,0,,Üst yarısının başı bir yerlerde belada olmalı!
Dialogue: 0,0:15:41.54,0:15:42.79,Main,Usopp,0,0,0,,O bacakları sahibine geri ver!
Dialogue: 0,0:15:45.50,0:15:48.59,Main,Luffy,0,0,0,,Hiç hayal gücün yok mu, Usopp?
Dialogue: 0,0:15:48.59,0:15:51.34,Main,Luffy,0,0,0,,Her şey olduğu gibi. Gördün mü?
Dialogue: 0,0:15:51.34,0:15:53.27,Main,Usopp,0,0,0,,Anladım, yani o Bacak Adam mı olmalı?
Dialogue: 0,0:15:53.27,0:15:54.76,Main,Usopp,0,0,0,,Sanki bu kabul edilebilir de!
Dialogue: 0,0:15:54.76,0:15:56.51,Main,Luffy,0,0,0,,Adın ne?
Dialogue: 0,0:15:56.51,0:15:58.86,Main,Usopp,0,0,0,,Ve bu ejderha eti hakkında...
Dialogue: 0,0:15:58.86,0:16:03.02,Main,Usopp,0,0,0,,Zaten çoğunu sen yiyeceksin,\No yüzden sen taşı!
Dialogue: 0,0:16:08.22,0:16:10.90,Main,Zoro,0,0,0,,Millet! Buraya gelin!
Dialogue: 0,0:16:10.90,0:16:12.82,Main,Luffy,0,0,0,,Zoro! Onları buldun mu?
Dialogue: 0,0:16:12.82,0:16:14.66,Main,Luffy,0,0,0,,Samuray ve öldürülen adam mı?
Dialogue: 0,0:16:16.70,0:16:17.83,Main,Zoro,0,0,0,,Bakın.
Dialogue: 0,0:16:19.66,0:16:21.09,Main,Usopp,0,0,0,,Ha? Bu da ne?
Dialogue: 0,0:16:23.75,0:16:28.42,Main,Usopp,0,0,0,,{\i1}K-Karla kaplı dağ mı?!
Dialogue: 0,0:16:28.96,0:16:32.37,Main,Usopp,0,0,0,,Hayır... buzla kaplı bir dağ?!
Dialogue: 0,0:16:32.80,0:16:37.89,Main,Usopp,0,0,0,,Gölü geçince adanın diğer yarısında karla kaplı dağlar var!
Dialogue: 0,0:16:37.89,0:16:41.43,Main,Usopp,0,0,0,,Ancak bu taraf kavurucu sıcakla ve aktif volkanlarla kaplı!
Dialogue: 0,0:16:41.43,0:16:43.56,Main,Usopp,0,0,0,,Bu adanın olayı ne?!
Dialogue: 0,0:16:43.56,0:16:45.77,Main,Robin,0,0,0,,Bu bir gizemi çözüyor.
Dialogue: 0,0:16:45.77,0:16:47.23,Main,Usopp,0,0,0,,Gizem mi?
Dialogue: 0,0:16:47.23,0:16:48.73,Main,Usopp,0,0,0,,Doğru!
Dialogue: 0,0:16:48.73,0:16:50.61,Main,Usopp,0,0,0,,Den Den Mushi'den gelen ses soğuk olduğunu söylemişti!
Dialogue: 0,0:16:50.93,0:16:53.14,Flashbacks,Voice,0,0,0,,Lütfen yardım edin!
Dialogue: 0,0:16:53.65,0:16:54.95,Flashbacks,Luffy,0,0,0,,Ne oldu?!
Dialogue: 0,0:16:55.57,0:16:57.99,Flashbacks,Voice,0,0,0,,Donuyoruz... Patron, sen misin?
Dialogue: 0,0:16:57.99,0:17:02.16,Flashbacks,Voice,0,0,0,,Arkadaşlarım kesilmeye devam ediyor.
Dialogue: 0,0:17:02.16,0:17:04.71,Flashbacks,Voice,0,0,0,,Samuray hepimizi öldürecek!
Dialogue: 0,0:17:04.71,0:17:10.46,Main,Usopp,0,0,0,,Yani katil samuray ve kurbanları orada.
Dialogue: 0,0:17:13.67,0:17:17.82,Main,Luffy,0,0,0,,Bu ada çok enteresan!\NO dağda kar yağıyor, değil mi?!
Dialogue: 0,0:17:17.82,0:17:20.72,Main,Luffy,0,0,0,,Ve burası çok sıcak... Kardan külah yemek istiyorum!
Dialogue: 0,0:17:20.74,0:17:22.43,Main,Usopp,0,0,0,,Aptal, gerçekten oraya gidecek misin?!
Dialogue: 0,0:17:22.43,0:17:24.06,Main,Usopp,0,0,0,,Orası çok soğuk olacak!
Dialogue: 0,0:17:24.06,0:17:26.56,Main,Usopp,0,0,0,,Ayrıca, orası çok uzakta!\NHadi artık gemiye dönelim.
Dialogue: 0,0:17:27.02,0:17:29.20,Main,Robin,0,0,0,,Ne kadar rahatsız edici. Oldukça soğuk görünüyor.
Dialogue: 0,0:17:29.20,0:17:32.36,Main,Zoro,0,0,0,,Orada hayvanlar varsa kürklerini alabiliriz.
Dialogue: 0,0:17:32.36,0:17:33.86,Main,Zoro,0,0,0,,Bir şekilde idare ederiz.
Dialogue: 0,0:17:33.86,0:17:37.50,Main,Usopp,0,0,0,,{\i1}Hayır idare edemeyiz! Neden gitmeye karar verdiniz?!
Dialogue: 0,0:17:37.50,0:17:38.99,Main,Luffy,0,0,0,,Kardan külah!
Dialogue: 0,0:17:38.99,0:17:40.91,Main,Usopp,0,0,0,,Bekle, Luffy!
Dialogue: 0,0:18:01.17,0:18:03.68,Main,Zoro,0,0,0,,Ne yapıyorsun{\fscx250}-{\r}
Dialogue: 0,0:18:03.68,0:18:04.93,Main,Usopp,0,0,0,,Gördüm! Gördüm! Gördüm!
Dialogue: 0,0:18:04.93,0:18:06.86,Main,Usopp,0,0,0,,Kuş! Hayır, insan! Ha?!
Dialogue: 0,0:18:06.86,0:18:07.69,Main,Usopp,0,0,0,,Bir insandı ama kuştu!
Dialogue: 0,0:18:07.69,0:18:08.52,Main,Usopp,0,0,0,,Kuş mu? İnsan mı? Hangisiydi?!
Dialogue: 0,0:18:08.57,0:18:09.65,Secondary,Usopp,0,0,0,,Kuş mu? İnsan mı? Hangisiydi?!
Dialogue: 0,0:18:08.52,0:18:11.48,Main,Zoro,0,0,0,,Ha? Neyden bahsediyorsun?
Dialogue: 0,0:18:09.65,0:18:12.77,Secondary,Usopp,0,0,0,,Ha?! Kuş muydu insan mıydı?! Zoro?
Dialogue: 0,0:18:11.48,0:18:12.77,Main,Zoro,0,0,0,,Orada kimse yok.
Dialogue: 0,0:18:26.62,0:18:29.71,Main,Franky,0,0,0,,Sanji, ne yapmaya çalışıyorsun?
Dialogue: 0,0:18:29.71,0:18:30.54,Main,Sanji,0,0,0,,Sonunda uyandın mı?
Dialogue: 0,0:18:31.50,0:18:33.61,Main,Nami,0,0,0,,Etrafa bakarsan sen de anlayacaksın.
Dialogue: 0,0:18:33.61,0:18:38.78,Main,Chopper,0,0,0,,Bu korkunç, Franky! Hapsedildik!
Dialogue: 0,0:18:42.55,0:18:45.54,Main,Franky,0,0,0,,Burası da neresi?!
Dialogue: 0,0:18:45.54,0:18:47.21,Main,Franky,0,0,0,,Neredeyiz?!
Dialogue: 0,0:18:47.96,0:18:52.80,Main,Franky,0,0,0,,Güvertede dev kabuklu balık tatlısını yiyordum,\Nve sonrasını... hatırlayamıyorum!
Dialogue: 0,0:18:54.05,0:18:57.89,Main,Nami,0,0,0,,Bu sadace bir tahmin,\Nama görünüşe göre birisi uyku gazı kullandı...
Dialogue: 0,0:18:57.89,0:19:00.73,Main,Nami,0,0,0,,ve bizi baygın haldeyken yakaladılar!
Dialogue: 0,0:19:01.24,0:19:02.95,Main,Franky,0,0,0,,Ne?!
Dialogue: 0,0:19:02.95,0:19:06.24,Main,Sanji,0,0,0,,Hiç şüphesiz gemiyi gazladılar.
Dialogue: 0,0:19:06.24,0:19:09.53,Main,Sanji,0,0,0,,Özür dilerim. Eğer daha önce fark etmiş olsaydım...
Dialogue: 0,0:19:22.68,0:19:25.43,Main,Franky,0,0,0,,Bu iyi değil.
Dialogue: 0,0:19:25.43,0:19:29.55,Main,Chopper,0,0,0,,Bizi satacaklar mı?\NOnlar insan kaçakçıları mı?
Dialogue: 0,0:19:29.55,0:19:33.30,Main,Franky,0,0,0,,Ama eğer gemideki herkesi yakaladıysalar, Brook nerede?
Dialogue: 0,0:19:33.30,0:19:37.02,Main,Nami,0,0,0,,Bilmiyorum. Burada olanlar sadece biziz.
Dialogue: 0,0:19:37.02,0:19:41.66,Main,Chopper,0,0,0,,Onlar insan kaçakçıları,\Nyani iskeletle uğraşmazlar, değil mi?
Dialogue: 0,0:19:41.66,0:19:43.95,Main,Franky,0,0,0,,Sen de pek insan sayılmazsın.
Dialogue: 0,0:19:43.95,0:19:45.33,Main,Sanji,0,0,0,,Sen de sayılmazsın!
Dialogue: 0,0:19:45.33,0:19:45.88,Main,Sanji,0,0,0,,Neyse!
Dialogue: 0,0:19:46.79,0:19:48.03,Main,Kinemon,0,0,0,,Oradakiler.
Dialogue: 0,0:19:49.54,0:19:51.00,Main,Nami,0,0,0,,Birisi... bir şey mi söyledi?
Dialogue: 0,0:19:52.42,0:19:55.29,Main,Franky,0,0,0,,Hayır, biz değildik.
Dialogue: 0,0:19:56.49,0:20:00.59,Main,Kinemon,0,0,0,,Oradakiler, meydan okumalardan hoşlanıyor musun??
Dialogue: 0,0:20:00.59,0:20:02.25,Main,Kinemon,0,0,0,,Özellikle bir bulmaca!
Dialogue: 0,0:20:05.94,0:20:07.63,Main,Chopper,0,0,0,,Bu şey daha demin konuştu mu?
Dialogue: 0,0:20:10.27,0:20:11.85,Main,Chopper,0,0,0,,Bu da ne?
Dialogue: 0,0:20:13.10,0:20:14.15,Main,Kinemon,0,0,0,,Bu mu? Küstah!
Dialogue: 0,0:20:18.53,0:20:19.32,Main,Sanji,0,0,0,,Bu ne?
Dialogue: 0,0:20:19.32,0:20:21.24,Main,Nami,0,0,0,,Ha? Böcek mi?
Dialogue: 0,0:20:21.65,0:20:23.84,Main,Franky,0,0,0,,Yeni bir çeşit Den Den Mushi mi?
Dialogue: 0,0:20:23.84,0:20:27.03,Main,Chopper,0,0,0,,Onlardan sekiz tane var! Farketmemiştim!
Dialogue: 0,0:20:27.03,0:20:29.45,Main,Kinemon,0,0,0,,Ben zavallı bir böcek değilim!
Dialogue: 0,0:20:29.45,0:20:33.78,Main,Kinemon,0,0,0,,Kötü birine benzemiyorsunuz...
Dialogue: 0,0:20:33.78,0:20:37.08,Main,Kinemon,0,0,0,,Bunların hepsi yüzümün parçaları.
Dialogue: 0,0:20:37.65,0:20:40.79,Main,Kinemon,0,0,0,,Afedersiniz,\Nama benim için onları tekrar bir araya getirebilir misin?
Dialogue: 0,0:20:40.79,0:20:43.63,Main,Franky,0,0,0,,Yüzün mü? Şimdi diyince...
Dialogue: 0,0:20:43.63,0:20:46.65,Main,Franky,0,0,0,,Bu bir ağız ve bu bir göz.
Dialogue: 0,0:20:46.65,0:20:47.80,Main,Franky,0,0,0,,Böyle mi?
Dialogue: 0,0:20:49.47,0:20:50.72,Main,Franky,0,0,0,,Böyle oldu mu?!
Dialogue: 0,0:20:50.72,0:20:52.56,Main,Chopper,0,0,0,,Bu doğru! Yüz oldu!
Dialogue: 0,0:20:52.56,0:20:56.02,Main,Kinemon,0,0,0,,Hayır, geriye bir kaç parça kaldı!
Dialogue: 0,0:20:57.36,0:20:59.19,Main,Nami,0,0,0,,Böyle değil mi?
Dialogue: 0,0:20:59.87,0:21:00.82,Main,Nami,0,0,0,,Nasıl oldu?
Dialogue: 0,0:21:01.48,0:21:02.65,Main,Kinemon,0,0,0,,Tamamiyle yanlış!
Dialogue: 0,0:21:02.65,0:21:05.74,Main,Sanji,0,0,0,,Hayır hayır... Böyle olmalı.
Dialogue: 0,0:21:07.53,0:21:08.87,Main,Franky,0,0,0,,İlerleme kaydediyoruz!
Dialogue: 0,0:21:08.87,0:21:10.79,Main,Kinemon,0,0,0,,Yanlış! Yanlış!
Dialogue: 0,0:21:10.79,0:21:12.51,Main,Chopper,0,0,0,,Ben de denemek istiyorum!
Dialogue: 0,0:21:12.51,0:21:14.21,Main,Kinemon,0,0,0,,Sizler...
Dialogue: 0,0:21:14.21,0:21:18.05,Main,Kinemon,0,0,0,,insanların yüzleriyle oynamamalısınız!
Dialogue: 0,0:21:18.71,0:21:19.38,Main,Franky,0,0,0,,Bitti!
Dialogue: 0,0:21:20.80,0:21:22.80,Main,Franky,0,0,0,,Düzgün bir yüz haline geldi!
Dialogue: 0,0:21:24.26,0:21:28.01,Main,Kinemon,0,0,0,,Çenemde ve alnımda hafif bir rahatsızlık hissediyorum...
Dialogue: 0,0:21:28.01,0:21:29.83,Main,Kinemon,0,0,0,,ama, olsun.
Dialogue: 0,0:21:29.83,0:21:30.68,Main,Kinemon,0,0,0,,Teşekkür ediyorum!
Dialogue: 0,0:21:32.27,0:21:33.88,Main,Straw Hats,0,0,0,,{\i1}Gövdesinden ayrılmış bir kafa konuşuyor!
Dialogue: 0,0:21:33.88,0:21:34.64,Main,Kinemon,0,0,0,,{\i1}Şimdi{\i0} mi farkettiniz?!
Dialogue: 0,0:21:35.39,0:21:37.85,Main,Chopper,0,0,0,,Nasıl hayatta olabiliyorsun?! Kötü bir ruh musun?!
Dialogue: 0,0:21:38.98,0:21:41.15,Main,Kinemon,0,0,0,,Ben de anlamadım.
Dialogue: 0,0:21:41.15,0:21:43.56,Main,Kinemon,0,0,0,,Kendi isteğimle kafa olarak kalmadım.
Dialogue: 0,0:21:44.77,0:21:48.99,Main,Kinemon,0,0,0,,O adam tuhaf bir teknik kullandı.
Dialogue: 0,0:21:48.99,0:21:53.49,Main,Kinemon,0,0,0,,Parçalara ayrılınca öleceğimi sanıyordum ama kendimi bu halde buldum.
Dialogue: 0,0:21:53.87,0:21:58.07,Main,Kinemon,0,0,0,,Düşman tarafından parçalara ayrılmak ama yine de hayatta kalmak...
Dialogue: 0,0:21:59.09,0:22:01.35,Main,Kinemon,0,0,0,,bir savaşçı için utanç verici bir durumdur!
Dialogue: 0,0:22:08.01,0:22:10.56,Main,Man,0,0,0,,Bir. İki.
Dialogue: 0,0:22:11.97,0:22:12.85,Main,Man,0,0,0,,Üç.
Dialogue: 0,0:22:13.97,0:22:15.85,Main,Man,0,0,0,,Ve dört.
Dialogue: 0,0:22:22.08,0:22:24.19,Main,Monet,0,0,0,,Merhaba? Onları buldun mu?
Dialogue: 0,0:22:25.06,0:22:28.86,Main,Man,0,0,0,,Evet, buldum. Onları yakalamak üzereyim.
Dialogue: 0,0:22:29.43,0:22:32.03,Main,Man,0,0,0,,Dört davetsiz misafir.
Dialogue: 0,0:22:32.87,0:22:33.66,Main,Monet,0,0,0,,Anladım.
Dialogue: 0,0:22:35.79,0:22:37.87,Main,Monet,0,0,0,,Ne kadar heyecan verici.
Dialogue: 0,0:22:37.87,0:22:40.38,Main,Monet,0,0,0,,Şimdi dikkatli ol.
Dialogue: 0,0:22:40.38,0:22:41.63,Main,Man,0,0,0,,Anlaşıldı.
Dialogue: 0,0:22:57.89,0:22:59.81,Main,Sanji,0,0,0,,Düşman tarafından kesildin,
Dialogue: 0,0:22:59.81,0:23:02.35,Main,Chopper,0,0,0,,ve hala hayattasın, sadace bir kafa olsa bile mi?
Dialogue: 0,0:23:02.35,0:23:04.48,Main,Chopper,0,0,0,,Nasıl?! Anlamadım!
Dialogue: 0,0:23:05.07,0:23:07.24,Main,Nami,0,0,0,,Buggy gibi! Ne kadar acayip.
Dialogue: 0,0:23:08.64,0:23:12.91,Main,Kinemon,0,0,0,,Keşke karnımı kesip vücudumun çürümesine izin verebilseydim,
Dialogue: 0,0:23:12.91,0:23:17.36,Main,Kinemon,0,0,0,,ama en büyük başarısızlığımın bilinmesi gerekse bile yapmam gereken şeyler var!
Dialogue: 0,0:23:24.83,0:23:28.54,Main,Nami,0,0,0,,Bu arada sen... Nerede olduğumuzu biliyor musun?
Dialogue: 0,0:23:29.22,0:23:30.89,Main,Kinemon,0,0,0,,"Sen" mi?!
Dialogue: 0,0:23:30.89,0:23:35.39,Main,Kinemon,0,0,0,,Bir kadın bana, bir savaşçıya resmi olmayan bir şekilde hitap etmeye nasıl cüret eder?!
Dialogue: 0,0:23:35.39,0:23:42.69,Main,Kinemon,0,0,0,,Kadınlar erkeklerin üç adım gerisinden yürümeli ve onlara mütevazı bir zarafetle hitap etmeli!
Dialogue: 0,0:23:45.48,0:23:47.51,Main,Nami,0,0,0,,O ne demek, şerefsiz?
Dialogue: 0,0:23:47.51,0:23:49.71,Main,Nami,0,0,0,,Kesik bir kafaya göre cesaretin var!
Dialogue: 0,0:23:49.71,0:23:52.32,Main,Nami,0,0,0,,Kafanı birleştirenlerle konuşuyorsun!
Dialogue: 0,0:23:52.32,0:23:54.07,Main,Kinemon,0,0,0,,B-Bu şiddete son verin!
Dialogue: 0,0:23:54.07,0:23:56.12,Main,Nami,0,0,0,,Hala konuşuyor musun?!
Dialogue: 0,0:23:56.99,0:23:59.66,Main,Kinemon,0,0,0,,Kes şunu kadın!
Dialogue: 0,0:24:02.86,0:24:05.46,Main,Kinemon,0,0,0,,Böyle kadınlar nasıl bir ülkeden geliyor?
Dialogue: 0,0:24:05.46,0:24:07.96,Main,Kinemon,0,0,0,,O kadar kaba ve egoist ki...
Dialogue: 0,0:24:07.96,0:24:09.80,Main,Kinemon,0,0,0,,Ama,
Dialogue: 0,0:24:09.80,0:24:12.63,Main,Kinemon,0,0,0,,iç çamaşırlarınıza kadar soyulduğunuz için çok üzülmüş olmalısınız.
Dialogue: 0,0:24:12.63,0:24:14.09,Main,Kinemon,0,0,0,,Taziyelerimi sunuyorum.
Dialogue: 0,0:24:14.47,0:24:17.03,Main,Nami,0,0,0,,Ben soyulmadım!
Dialogue: 0,0:24:17.03,0:24:17.51,Main,Kinemon,0,0,0,,Ne?!
Dialogue: 0,0:24:17.51,0:24:19.72,Main,Nami,0,0,0,,Bu sadece moda!
Dialogue: 0,0:24:19.72,0:24:23.31,Main,Kinemon,0,0,0,,Ne kadar ahlaksızca! \NBu göğüs bandından başka bir şey değil, değil mi?
Dialogue: 0,0:24:23.31,0:24:25.76,Main,Nami,0,0,0,,Ne beğenmedin mi?
Dialogue: 0,0:24:25.76,0:24:27.36,Main,Kinemon,0,0,0,,Beğenmez olur muyum?
Dialogue: 0,0:24:27.36,0:24:28.86,Main,Sanji,0,0,0,,Sen ne yaptığını...
Dialogue: 0,0:24:34.77,0:24:36.15,Main,Sanji,0,0,0,,O şehvetli gözler!
Dialogue: 0,0:24:48.79,0:24:50.16,Main,Kinemon,0,0,0,,Bu bir tuzak!
Dialogue: 0,0:24:50.16,0:24:53.93,Main,Chopper,0,0,0,,Sanırım kafatası çatlamış! Acıyor mu?
Dialogue: 0,0:24:53.93,0:24:57.68,Main,Kinemon,0,0,0,,Acıyor... Acıy... Acımıyor!
Dialogue: 0,0:24:57.68,0:25:00.55,Main,Kinemon,0,0,0,,Sadece... biraz kaşınıyor!
Dialogue: 0,0:25:00.55,0:25:05.14,Main,Kinemon,0,0,0,,Anladım, yani diğer ülkedeki kadınlar sadece göğüs bandı mı giyiyor?
Dialogue: 0,0:25:05.14,0:25:06.01,Main,Kinemon,0,0,0,,Öyleyse, beğendim.
Dialogue: 0,0:25:06.52,0:25:10.28,Main,Kinemon,0,0,0,,Bu arada, siz kimsiniz?
Dialogue: 0,0:25:10.28,0:25:13.57,Main,Kinemon,0,0,0,,Geminizden buraya sürüklendiğinizi duydum.
Dialogue: 0,0:25:14.47,0:25:16.49,Main,Sanji,0,0,0,,Biz korsanız.
Dialogue: 0,0:25:18.22,0:25:19.86,Main,Kinemon,0,0,0,,Korsan mısınız?!
Dialogue: 0,0:25:21.12,0:25:23.07,Main,Kinemon,0,0,0,,Sizler korsan mısınız?!
Dialogue: 0,0:25:25.00,0:25:27.12,Main,Kinemon,0,0,0,,Bu vahşiliğinizi açıklıyor!
Dialogue: 0,0:25:27.12,0:25:30.67,Main,Kinemon,0,0,0,,Korsanlardan nefret ediyorum. Midemi bulandırıyorlar!
Dialogue: 0,0:25:35.54,0:25:40.56,Main,Kinemon,0,0,0,,Belki de bizi bu buz adasına aynı anda getirenin kader olduğunu,
Dialogue: 0,0:25:40.56,0:25:42.84,Main,Kinemon,0,0,0,,ve belki birlikte kaçabileceğimizi düşündüm.
Dialogue: 0,0:25:43.72,0:25:46.52,Main,Kinemon,0,0,0,,Ama ne yazık ki siz korsan olduğunuz için,...
Dialogue: 0,0:25:47.81,0:25:51.29,Main,Franky,0,0,0,,Dur bir dakika.\N"Buz adası" derken ne demek istiyorsun?
Dialogue: 0,0:25:51.29,0:25:53.99,Main,Franky,0,0,0,,Burası yanan bir ada, değil mi?
Dialogue: 0,0:25:53.99,0:25:58.30,Main,Chopper,0,0,0,,Evet bu doğru! Okyanusun bile yandığı kavurucu sıcak bir ada!
Dialogue: 0,0:25:58.30,0:26:00.24,Main,Nami,0,0,0,,Hayır, belki de...
Dialogue: 0,0:26:03.01,0:26:03.79,Main,Nami,0,0,0,,Sen...
Dialogue: 0,0:26:06.62,0:26:09.13,Main,Nami,0,0,0,,bunun bir buz adası olduğunu söyledin, değil mi?
Dialogue: 0,0:26:09.13,0:26:12.08,Main,Nami,0,0,0,,Volkanik patlamaları duymadın mı?
Dialogue: 0,0:26:13.34,0:26:16.37,Main,Kinemon,0,0,0,,Zaman zaman patlama sesleri duydum,
Dialogue: 0,0:26:16.37,0:26:19.59,Main,Kinemon,0,0,0,,ama bu adaya buz kütlelerinden oluşan bir deniz yoluyla geldim.
Dialogue: 0,0:26:20.85,0:26:24.60,Main,Kinemon,0,0,0,,Benimle konuşmayı bırakın, iğrenç korsanlar!
Dialogue: 0,0:26:25.10,0:26:28.74,Main,Nami,0,0,0,,Yani gemiden gördüğüm dondurucu hava...
Dialogue: 0,0:26:28.74,0:26:30.39,Main,Nami,0,0,0,,gerçekti.
Dialogue: 0,0:26:31.36,0:26:35.86,Main,Nami,0,0,0,,Luffy ve diğerlerinin gittiği yanan taraf, diğer taraf ise kutup adası.
Dialogue: 0,0:26:35.86,0:26:40.48,Main,Nami,0,0,0,,Görünüşe göre kutup tarafına götürüldük!
Dialogue: 0,0:26:41.57,0:26:44.08,Main,Nami,0,0,0,,Ancak bizi buraya kimin ve neden getirdiğini bilmek istiyorsak,
Dialogue: 0,0:26:44.08,0:26:46.20,Main,Nami,0,0,0,,Bu odadan çıkıp kendi gözümüzle görmemiz gerekecek.
Dialogue: 0,0:26:46.97,0:26:50.36,Main,Sanji,0,0,0,,Ama Nami-san, kapı aşırı sert.  \NÇıkabilecekmişiz gibi görünmü...
Dialogue: 0,0:26:51.01,0:26:52.63,Main,Franky,0,0,0,,Önümden çekilin!
Dialogue: 0,0:26:53.09,0:26:55.63,Main,Franky,0,0,0,,Bir depo dolusu kolam var!
Dialogue: 0,0:27:03.96,0:27:06.47,Main,Sanji,0,0,0,,Bekle bir saniye!
Dialogue: 0,0:27:08.10,0:27:12.20,Attack,Sanji,0,0,0,, {\fad(100,100)}Franky Radikal Işın
Dialogue: 0,0:27:30.52,0:27:32.11,Main,Franky,0,0,0,,Açıldı. Hadi çıkalım.
Dialogue: 0,0:27:32.11,0:27:34.70,Main,Sanji,0,0,0,,O tuhaf vücudun sadece gösteri amaçlı değilmiş.
Dialogue: 0,0:27:34.70,0:27:37.46,Main,Chopper,0,0,0,,Ben de lazer ateş etmek istiyorum!
Dialogue: 0,0:27:46.51,0:27:48.10,Main,Sanji,0,0,0,,Peki sen ne yapacaksın?
Dialogue: 0,0:27:50.52,0:27:54.61,Main,Sanji,0,0,0,,Korsan olmasaydık bizimle kaçmak isterdin, değil mi?
Dialogue: 0,0:27:56.52,0:27:58.94,Main,Kinemon,0,0,0,,Sessiz ol! Kendi yoluna git, korsan!
Dialogue: 0,0:27:58.94,0:28:03.16,Main,Sanji,0,0,0,,Vücudun olmadan tek başına kaçman mümkün değil.
Dialogue: 0,0:28:04.34,0:28:05.57,Main,Kinemon,0,0,0,,Ne yapıyorsun?!
Dialogue: 0,0:28:06.91,0:28:09.33,Main,Sanji,0,0,0,,Haklı mıyım, Wano Krallığının samurayı?!
Dialogue: 0,0:28:11.38,0:28:13.37,Main,Chopper,0,0,0,,Samuray mı?!
Dialogue: 0,0:28:13.86,0:28:17.13,Main,Sanji,0,0,0,,Bu topuz Wano Krallığına özgü bir saç modelidir.
Dialogue: 0,0:28:19.33,0:28:24.76,Main,Chopper,0,0,0,,Den Den Mushi'de bahsettiği cani samurayın o olduğu anlamına mı geliyor?!
Dialogue: 0,0:28:24.76,0:28:25.76,Main,Chopper,0,0,0,,Korkunç!
Dialogue: 0,0:28:26.34,0:28:27.81,Main,Man,0,0,0,,Buradan bir patlama sesi duydum!
Dialogue: 0,0:28:27.81,0:28:28.64,Main,Man,0,0,0,,Acele edin!
Dialogue: 0,0:28:28.64,0:28:30.73,Main,Man,0,0,0,,Yakaladığımız korsanlar olabilir mi?
Dialogue: 0,0:28:30.73,0:28:33.06,Main,Nami,0,0,0,,Sanji-kun, acele et! Peşimizden geliyorlar!
Dialogue: 0,0:28:36.89,0:28:44.82,Main,Sanji,0,0,0,,Saldırdığın birinden acil durum sinyali aldıktan sonra buraya geldik, samuray!
Dialogue: 0,0:28:44.82,0:28:46.72,Main,Chopper,0,0,0,,Sanji, hadi acele et!
Dialogue: 0,0:28:46.72,0:28:48.62,Main,Chopper,0,0,0,,Korkunç samurayı arkada bırak!
Dialogue: 0,0:28:49.87,0:28:54.62,Main,Kinemon,0,0,0,,Cinayet işleyerek asla kendi onuruma ihanet etmeyeceğim!
Dialogue: 0,0:28:57.90,0:29:01.30,Main,Kinemon,0,0,0,,Bu adaya oğlumu kurtarmak için geldim!
Dialogue: 0,0:29:01.30,0:29:05.01,Main,Kinemon,0,0,0,,Yoluma çıkan herkesi öldüreceğim!
Dialogue: 0,0:29:13.43,0:29:14.12,Main,Man,0,0,0,,İşte oradalar!
Dialogue: 0,0:29:14.12,0:29:15.60,Main,Man,0,0,0,,Ateş! Kaçmalarına izin vermeyin!
Dialogue: 0,0:29:21.53,0:29:23.99,Main,Franky,0,0,0,,Durun bakalım! Sizinle ben ilgileneceğim!
Dialogue: 0,0:29:24.60,0:29:27.06,Attack,Franky,0,0,0,,{\fad(100,100)}Sol Silahlar
Dialogue: 0,0:29:30.12,0:29:33.41,Main,Man,0,0,0,,Nasıl dışarı çıktılar?!
Dialogue: 0,0:29:33.97,0:29:36.91,Main,Man,0,0,0,,Master ile hemen iletişime geçin!
Dialogue: 0,0:29:38.17,0:29:40.17,Main,Sanji,0,0,0,,Bunlar da kim?!
Dialogue: 0,0:29:40.17,0:29:41.09,Main,Nami,0,0,0,,Sanji-kun!
Dialogue: 0,0:29:41.09,0:29:42.74,Main,Chopper,0,0,0,,Onu da mı yanında getirdin?!
Dialogue: 0,0:29:42.74,0:29:45.17,Main,Chopper,0,0,0,,O tehlikeli biri!
Dialogue: 0,0:29:45.17,0:29:47.43,Main,Sanji,0,0,0,,Eğer bir şey olursa beni suçlayabilirsiniz!
Dialogue: 0,0:29:51.72,0:29:52.72,Main,Sanji,0,0,0,,Bir kapı var!
Dialogue: 0,0:30:00.39,0:30:01.65,Main,Mocha,0,0,0,,Siz kimsiniz?
Dialogue: 0,0:30:02.78,0:30:04.64,Main,Chopper,0,0,0,,Ne?!
Dialogue: 0,0:30:05.73,0:30:07.99,Main,Sanji,0,0,0,,Devasa... çocuklar?
Dialogue: 0,0:30:07.99,0:30:10.44,Main,Kinemon,0,0,0,,Ç-Çocuklar mı?!
Dialogue: 0,0:30:10.44,0:30:12.62,Main,Nami,0,0,0,,Burada neler oluyor?!
Dialogue: 0,0:30:15.00,0:30:17.96,Main,Sanji,0,0,0,,Bu çocuklar da kim?
Dialogue: 0,0:30:17.96,0:30:21.94,Main,Nami,0,0,0,,Belki burası bir çeşit bakım odasıdır?
Dialogue: 0,0:30:21.94,0:30:25.67,Main,Franky,0,0,0,,Aşırı büyükler. Onlar dev mi?
Dialogue: 0,0:30:25.67,0:30:28.33,Main,Franky,0,0,0,,Devlerin adasına mı demir attık?
Dialogue: 0,0:30:28.33,0:30:31.60,Main,Nami,0,0,0,,Ama küçük çocuklar da var...
Dialogue: 0,0:30:31.60,0:30:34.97,Main,Sanji,0,0,0,,O halde belki bu tesis ırklar arasında ayrım yapmıyordur?
Dialogue: 0,0:30:34.97,0:30:37.23,Main,Nami,0,0,0,,Ama hiç yetişkin görmüyorum.
Dialogue: 0,0:30:38.98,0:30:41.05,Main,Sind,0,0,0,,Siz kimsiniz?
Dialogue: 0,0:30:41.05,0:30:43.07,Main,Mocha,0,0,0,,Onları tanımıyorum...
Dialogue: 0,0:30:43.07,0:30:46.24,Main,Mocha,0,0,0,,Donmuş insanlar olabilir misiniz?
Dialogue: 0,0:30:46.24,0:30:47.15,Main,Mocha,0,0,0,,Çıkmayı başardınız mı?!
Dialogue: 0,0:30:47.15,0:30:48.40,Main,Nami,0,0,0,,Donmuş mu?
Dialogue: 0,0:30:48.40,0:30:49.82,Main,Sanji,0,0,0,,Neyden bahsediyor?
Dialogue: 0,0:30:52.66,0:30:55.74,Main,Kid,0,0,0,,{\i1}Sen robotsun!
Dialogue: 0,0:30:55.74,0:30:56.86,Main,Nami,0,0,0,,N-Ne?!
Dialogue: 0,0:30:56.86,0:30:58.16,Main,Kid,0,0,0,,Robot!
Dialogue: 0,0:30:58.16,0:30:59.67,Main,Kid,0,0,0,,Çok havalı!
Dialogue: 0,0:30:59.67,0:31:01.43,Main,Kid,0,0,0,,Robotları severim!
Dialogue: 0,0:31:01.43,0:31:02.59,Main,Kid,0,0,0,,Onlar en iyisi!
Dialogue: 0,0:31:02.59,0:31:04.13,Main,Nami,0,0,0,,En iyisi derken ne demek istedin?
Dialogue: 0,0:31:06.09,0:31:06.84,Main,Nami,0,0,0,,Sanji-kun?!
Dialogue: 0,0:31:06.84,0:31:12.13,Main,Kid,0,0,0,,{\i1}Robot! Robot! Robot!
Dialogue: 0,0:31:12.13,0:31:15.89,Main,Franky,0,0,0,,Yoksa, sizler...
Dialogue: 0,0:31:15.91,0:31:18.98,Main,Franky,0,0,0,,{\i1}zırhlı{\i0} beni çok mu sevdiniz?!
Dialogue: 0,0:31:20.06,0:31:22.56,Main,Nami,0,0,0,,Donmuş insanlar diyerek ne demek istedi?
Dialogue: 0,0:31:22.56,0:31:25.07,Main,Kid,0,0,0,,Bakın! Doldurulmuş hayvan!
Dialogue: 0,0:31:25.07,0:31:25.52,Main,Nami,0,0,0,,Ne?
Dialogue: 0,0:31:25.52,0:31:27.49,Main,Kid,0,0,0,,Doldurulmuş bir {\i1}rakun köpeği!
Dialogue: 0,0:31:27.49,0:31:28.96,Main,Chopper,0,0,0,,Ben bir {\i1}ren geyiğiyim!
Dialogue: 0,0:31:28.96,0:31:30.40,Main,Kid,0,0,0,,Ne kadar şirin!
Dialogue: 0,0:31:31.58,0:31:32.28,Main,Chopper,0,0,0,,Yardım edin!
Dialogue: 0,0:31:32.28,0:31:32.78,Main,Kid,0,0,0,,Bir tane istiyorum!
Dialogue: 0,0:31:34.42,0:31:37.79,Main,Sanji,0,0,0,,Franky bu çocuklar arasında aşırı derecede popüler!
Dialogue: 0,0:31:40.29,0:31:41.96,Main,Kid,0,0,0,,Kıvırcık kaşlı!
Dialogue: 0,0:31:41.96,0:31:44.04,Main,Sanji,0,0,0,,Kapa çeneni, velet!
Dialogue: 0,0:31:44.04,0:31:45.79,Main,Kid,0,0,0,,Haklısın!
Dialogue: 0,0:31:45.79,0:31:47.79,Main,Kinemon,0,0,0,,Hepinize sesleniyorum!
Dialogue: 0,0:31:48.56,0:31:50.58,Main,Kinemon,0,0,0,,Momonosuke adında bir çocuk tanıyor musunuz?!
Dialogue: 0,0:31:51.51,0:31:53.59,Main,Kinemon,0,0,0,,Genç biridir!
Dialogue: 0,0:31:55.21,0:31:56.76,Main,Kid,0,0,0,,Korkunç!
Dialogue: 0,0:31:56.76,0:31:58.80,Main,Kid,0,0,0,,Kafa konuştu!
Dialogue: 0,0:31:58.80,0:32:00.76,Main,Kid,0,0,0,,Kaçın!
Dialogue: 0,0:32:00.76,0:32:03.60,Main,Sanji,0,0,0,,Bakar mısınız? Bize bilgi verebilir{\fscx250}-{\r}
Dialogue: 0,0:32:03.60,0:32:05.47,Main,Kinemon,0,0,0,,{\i1}Bekleyin!
Dialogue: 0,0:32:05.47,0:32:09.23,Main,Sanji,0,0,0,,Kapa çeneni, aptal! Onlara hiç bir şey soramayız!
Dialogue: 0,0:32:09.23,0:32:11.07,Main,Nami,0,0,0,,Konuştuğun zaman onları korkutuyorsun!
Dialogue: 0,0:32:13.12,0:32:14.99,Main,Man,0,0,0,,Bisküvi Odasının kapısı açık!
Dialogue: 0,0:32:14.99,0:32:16.54,Main,Franky,0,0,0,,İşte geliyorlar!
Dialogue: 0,0:32:16.54,0:32:18.79,Main,Franky,0,0,0,,Neyse, hadi odanın diğer köşesine geçelim!
Dialogue: 0,0:32:18.79,0:32:21.08,Main,Man,0,0,0,,Önceki korsanlar olmalı.
Dialogue: 0,0:32:21.08,0:32:22.54,Main,Man,0,0,0,,Kaçmalarına izin vermeyin!
Dialogue: 0,0:32:30.16,0:32:32.68,Main,Sanji,0,0,0,,Burası ne tür bir tesis?
Dialogue: 0,0:32:32.68,0:32:33.68,Main,Sanji,0,0,0,,Lütfen söyleyin!
Dialogue: 0,0:32:33.68,0:32:36.17,Main,Kinemon,0,0,0,,Momonosuke adında bir çocuğu arıyorum!
Dialogue: 0,0:32:38.26,0:32:39.85,Main,Nami,0,0,0,,Artık konuşmayı bırak!
Dialogue: 0,0:32:39.85,0:32:42.10,Main,Kinemon,0,0,0,,Bir kadın bana elini kaldırdı!
Dialogue: 0,0:32:42.10,0:32:43.64,Main,Kinemon,0,0,0,,Bu bir savaşçı için utanç verici bir durum!
Dialogue: 0,0:32:43.64,0:32:44.98,Main,Kinemon,0,0,0,,Karnımı kesip açmak istiyorum!
Dialogue: 0,0:32:44.98,0:32:48.15,Main,Nami,0,0,0,,Kes şunu artık! Sinirlerimi bozuyorsun,\Nseni aşağılık pislik!
Dialogue: 0,0:32:48.15,0:32:49.32,Main,Man,0,0,0,,Lanet olası kaçaklar!
Dialogue: 0,0:32:49.32,0:32:50.48,Main,Man,0,0,0,,Buradan çıkamayacaksınız!
Dialogue: 0,0:32:53.81,0:32:55.11,Main,Man,0,0,0,,Bekle!
Dialogue: 0,0:32:55.11,0:32:58.66,Main,Man,0,0,0,,Sakin ol. Silahlar ve patlayıcılar burada yasak.
Dialogue: 0,0:32:58.66,0:33:00.62,Main,Man,0,0,0,,Gas mermilerden daha güçlü bir şeyi burada kullanamayız.
Dialogue: 0,0:33:03.01,0:33:06.42,Main,Man,0,0,0,,Eğer çocukları vurursak, Master'a hesap vermemiz gerekir!
Dialogue: 0,0:33:13.76,0:33:17.13,Main,Man,0,0,0,,Tamamdır, çocuklar, önümüzden çekilin.
Dialogue: 0,0:33:17.13,0:33:19.21,Main,Man,0,0,0,,Yolu açın!
Dialogue: 0,0:33:19.21,0:33:20.67,Main,Man,0,0,0,,Bu tehlikeli!
Dialogue: 0,0:33:20.67,0:33:23.81,Main,Sind,0,0,0,,Robot-san.\NBu adadan değilsiniz, öyle değil mi?
Dialogue: 0,0:33:23.81,0:33:28.14,Main,Franky,0,0,0,,Tabii ki hayır. Ama, çocuk... Ben bir cyborg'um{\fscx250}-{\r}
Dialogue: 0,0:33:28.14,0:33:29.39,Main,Sind,0,0,0,,Geminiz var mı?
Dialogue: 0,0:33:29.39,0:33:32.99,Main,Franky,0,0,0,,Tabii ki var! Bizim Sunny'miz dünyanın{\fscx250}-{\r}
Dialogue: 0,0:33:32.99,0:33:34.19,Main,Sind,0,0,0,,Kurtarın bizi!
Dialogue: 0,0:33:35.56,0:33:37.53,Main,Nami,0,0,0,,Ne demek istiyor?
Dialogue: 0,0:33:37.53,0:33:39.48,Main,Sind,0,0,0,,Lütfen, kurtarın bizi!
Dialogue: 0,0:33:39.48,0:33:41.79,Main,Sanji,0,0,0,,Kurtarın derken ne demek istiyorsun?
Dialogue: 0,0:33:41.79,0:33:43.74,Main,Chopper,0,0,0,,Burası bakım odası değil mi?!
Dialogue: 0,0:33:45.96,0:33:48.97,Main,Biyo,0,0,0,,Biz artık hasta değiliz!
Dialogue: 0,0:33:48.97,0:33:50.58,Main,Biyo,0,0,0,,Hepimiz daha iyiyiz!
Dialogue: 0,0:33:50.58,0:33:53.04,Main,Chopper,0,0,0,,Hasta mı? Ne hastalığı?
Dialogue: 0,0:34:02.86,0:34:04.60,Main,Man,0,0,0,,Şu kahrolası veletler!
Dialogue: 0,0:34:04.60,0:34:06.69,Main,Sind,0,0,0,,Lütfen, bekleyin!
Dialogue: 0,0:34:06.69,0:34:08.81,Main,Sind,0,0,0,,Bizi buradan çıkarın!
Dialogue: 0,0:34:08.81,0:34:11.19,Main,Mocha,0,0,0,,Lütfen abla! Bize yardım et!
Dialogue: 0,0:34:11.65,0:34:14.48,Main,Man,0,0,0,,Şimdi, bekleyin, çocuklar!
Dialogue: 0,0:34:15.99,0:34:18.95,Main,Nami,0,0,0,,Üzgünüm... bizi kovalıyorlar, yani...
Dialogue: 0,0:34:32.16,0:34:33.47,Main,Chopper,0,0,0,,Neler oluyor?!
Dialogue: 0,0:34:33.47,0:34:35.13,Main,Chopper,0,0,0,,Onları yanımıza alalım!
Dialogue: 0,0:34:35.13,0:34:38.71,Main,Franky,0,0,0,,Aptal! Nereye gideceğimizi bile bilmiyoruz!
Dialogue: 0,0:34:38.71,0:34:42.47,Main,Franky,0,0,0,,Bu kadar çocuğu yanımızda getirmenin ne faydası olacak ki?
Dialogue: 0,0:34:43.89,0:34:45.07,Main,Franky,0,0,0,,Ama neden...
Dialogue: 0,0:34:45.07,0:34:46.77,Main,Franky,0,0,0,,kendimi kötü hissediyorum?!
Dialogue: 0,0:35:03.99,0:35:05.07,Main,Mocha,0,0,0,,O zaman...
Dialogue: 0,0:35:05.82,0:35:08.00,Main,Mocha,0,0,0,,{\i1}bizi sonra kurtarın!
Dialogue: 0,0:35:12.08,0:35:16.51,Main,Mocha,0,0,0,,Binanın dışına çıkmamış olmama rağmen biliyorum!
Dialogue: 0,0:35:17.15,0:35:19.84,Main,Mocha,0,0,0,,Bu ada boş, değil mi?!
Dialogue: 0,0:35:19.84,0:35:23.80,Main,Mocha,0,0,0,,Burada hiçbir şehir ya da insan yok!
Dialogue: 0,0:35:23.80,0:35:26.31,Main,Mocha,0,0,0,,Bu yüzden kimse bize yardım etmeye gelmedi!
Dialogue: 0,0:35:26.31,0:35:29.51,Main,Mocha,0,0,0,,Annemi ve babamı görmek istiyorum!
Dialogue: 0,0:35:30.39,0:35:34.55,Main,Mocha,0,0,0,,Abla! Lütfen geri gel!
Dialogue: 0,0:35:34.55,0:35:37.18,Main,Mocha,0,0,0,,Bizi kurtarmak için geri gelin!
Dialogue: 0,0:35:38.89,0:35:41.98,Main,Nami,0,0,0,,Hadi bu çocuklara yardım edelim!
Dialogue: 0,0:35:42.72,0:35:45.58,Main,Sanji,0,0,0,,Ne diyorsun, Nami-san?! Bunu yapmak için hiçbir nedenimiz yok!
Dialogue: 0,0:35:46.99,0:35:50.53,Main,Sanji,0,0,0,,Hasta olduklarını bile söylediler! Burası hastane olabilir!
Dialogue: 0,0:35:51.21,0:35:55.16,Main,Sanji,0,0,0,,Onlarla daha yeni tanıştık, \Nve burada ne olduğunu bilmiyoruz!
Dialogue: 0,0:35:55.16,0:35:57.38,Main,Sanji,0,0,0,,Biz çocukları kurtaran bir hayır kurumu değiliz!
Dialogue: 0,0:35:59.19,0:36:03.68,Main,Nami,0,0,0,,Sence bunu bilmediğimi mi sanıyorsun?
Dialogue: 0,0:36:04.46,0:36:08.11,Main,Nami,0,0,0,,Ama çocuklar onları kurtarmam için ağladığı zaman...
Dialogue: 0,0:36:08.11,0:36:10.63,Main,Nami,0,0,0,,onlara nasıl arkamı dönebilirim?!
Dialogue: 0,0:36:12.02,0:36:13.80,Main,Mocha,0,0,0,,Abla!
Dialogue: 0,0:36:13.80,0:36:15.86,Main,Man,0,0,0,,Çabuk, kaçıyorlar!
Dialogue: 0,0:36:15.86,0:36:17.44,Main,Man,0,0,0,,Çocuklar önümüze çıkıyor!
Dialogue: 0,0:36:17.44,0:36:19.36,Main,Man,0,0,0,,Kimin umurunda?! Onları da öldürün!
Dialogue: 0,0:36:19.36,0:36:20.61,Main,Man,0,0,0,,Ama Master...
Dialogue: 0,0:36:20.61,0:36:22.36,Main,Man,0,0,0,,Yine de onların kaçmasına izin vermekten daha iyidir!
Dialogue: 0,0:36:29.24,0:36:30.41,Main,Nami,0,0,0,,Sanji-kun!
Dialogue: 0,0:36:30.41,0:36:31.95,Main,Kid,0,0,0,,Kıvırcık abi!
Dialogue: 0,0:36:32.36,0:36:34.01,Attack,Kid,0,0,0,,{\fad(100,100)}Şeytan Bacak
Dialogue: 0,0:36:34.75,0:36:39.45,Attack,Kid,0,0,0,,{\fad(100,100)}Boyun Saldırısı
Dialogue: 0,0:36:40.84,0:36:42.17,Main,Kid,0,0,0,,Harika!
Dialogue: 0,0:36:42.17,0:36:43.94,Main,Kinemon,0,0,0,,O adam...
Dialogue: 0,0:36:43.94,0:36:46.04,Main,Kinemon,0,0,0,,inanılmaz yetenekli!
Dialogue: 0,0:36:46.04,0:36:46.89,Main,Man,0,0,0,,Kahretsin!
Dialogue: 0,0:36:49.80,0:36:51.70,Attack,Man,0,0,0,,{\fad(100,100)}Kung Fu Noktası
Dialogue: 0,0:36:57.61,0:36:58.97,Main,Kid,0,0,0,,Rakun Köpek-chan!
Dialogue: 0,0:37:01.60,0:37:05.30,Attack,Kid,0,0,0,,{\fad(100,100)}Güçlü Sağ
Dialogue: 0,0:37:11.95,0:37:13.49,Main,Kid,0,0,0,,{\i1}Roket yumruğu!
Dialogue: 0,0:37:17.21,0:37:18.91,Main,Man,0,0,0,,O-Onlar...
Dialogue: 0,0:37:20.84,0:37:22.92,Main,Man,0,0,0,,daha fazla kaçmıyorlar!
Dialogue: 0,0:37:24.76,0:37:27.51,Main,Sanji,0,0,0,,Nami-san nazik olduğu zaman...{\alpha&HFF&} (sadece çocuklara)...
Dialogue: 0,0:37:27.51,0:37:29.43,Main,Sanji,0,0,0,,Nami-san nazik olduğu zaman... (sadece çocuklara)...
Dialogue: 0,0:37:29.43,0:37:32.38,Main,Sanji,0,0,0,,gerçekten harika!
Dialogue: 0,0:37:32.38,0:37:34.23,Main,Sanji,0,0,0,,Ona tekrar aşık oluyorum!
Dialogue: 0,0:37:39.48,0:37:43.35,Main,Sanji,0,0,0,,Chopper. Nami-san ile beraber önden git.
Dialogue: 0,0:37:43.35,0:37:45.17,Main,Chopper,0,0,0,,Tamam, bana bırak!
Dialogue: 0,0:37:46.70,0:37:51.24,Main,Sanji,0,0,0,,Çocuklar! Güzel ablanızı ve \NKung Fu rakun köpeği takip edin!
Dialogue: 0,0:37:52.08,0:37:54.50,Main,Sanji,0,0,0,,Peşimizdekileri geri tutacağım!
Dialogue: 0,0:37:56.08,0:37:57.55,Main,Sanji,0,0,0,,Ama yanlış fikre kapılmayın!
Dialogue: 0,0:37:58.78,0:38:03.82,Main,Sanji,0,0,0,,Ben sadece Nami-san'ın kalbindeki sizi kurtarma isteğine yanıt veriyorum.
Dialogue: 0,0:38:04.67,0:38:09.34,Main,Sanji,0,0,0,,Nami-san'ın sevgisini çaldığınız için sizden nefret ediyorum!
Dialogue: 0,0:38:09.34,0:38:11.05,Main,Kid,0,0,0,,Teşekkürler, kıvırcık abi!
Dialogue: 0,0:38:11.05,0:38:13.06,Main,Sanji,0,0,0,,Kapayın çenenizi, kahrolası veletler!
Dialogue: 0,0:38:14.09,0:38:16.27,Main,Franky,0,0,0,,Şimdi, gelin bakalım!
Dialogue: 0,0:38:23.02,0:38:28.36,Main,Ceasar,0,0,0,,Anladım. Bu kapı her darbeye karşı dayanıklı, ancak...
Dialogue: 0,0:38:28.36,0:38:29.11,Main,Man,0,0,0,,Master!
Dialogue: 0,0:38:31.70,0:38:33.16,Main,Ceasar,0,0,0,,...bunlar yanık izleri.
Dialogue: 0,0:38:34.45,0:38:36.79,Main,Ceasar,0,0,0,,Bu insanlar kim böyle?
Dialogue: 0,0:38:36.79,0:38:41.79,Main,Ceasar,0,0,0,,Lazer yapabilecek teknolojiye sahip tek kişinin {\i1}o{\i0} olduğunu sanıyordum.
Dialogue: 0,0:38:41.79,0:38:46.92,Main,Ceasar,0,0,0,,Bu bana o aşağılık Vegapunk'un Pacifista'sını hatırlattı!
Dialogue: 0,0:38:47.41,0:38:51.35,Main,Ceasar,0,0,0,,Hala firarileri yakalayamadınız mı?
Dialogue: 0,0:38:51.35,0:38:54.18,Main,Man,0,0,0,,Onları şimdiye kadar Bisküvi Odası'nda köşeye sıkıştırmış olmalılar.
Dialogue: 0,0:38:54.18,0:38:56.31,Main,Ceasar,0,0,0,,Bisküvi Odası mı?
Dialogue: 0,0:38:57.93,0:38:59.94,Main,Man,0,0,0,,Master, orada mısınız?!
Dialogue: 0,0:39:00.64,0:39:02.27,Main,Ceasar,0,0,0,,Evet, buradayım.
Dialogue: 0,0:39:03.15,0:39:08.27,Main,Man,0,0,0,,G-5'ten bir savaş gemisi adanın Kuzeybatı tarafına yaklaşıyor!
Dialogue: 0,0:39:08.27,0:39:11.49,Main,Ceasar,0,0,0,,Savaş gemisi mi?! Ne pahasına olursa olsun onu uzaklaştır!
Dialogue: 0,0:39:12.41,0:39:14.53,Main,Ceasar,0,0,0,,Büyük miktarda zehirli gaz salın!
Dialogue: 0,0:39:15.54,0:39:19.92,Main,Ceasar,0,0,0,,Ancak onları öldürmeyin. Eğer öldürürseniz, Hükümet bir şeyler yaptığımızı fark edebilir.
Dialogue: 0,0:39:19.92,0:39:20.79,Main,Man,0,0,0,,Emredersiniz!
Dialogue: 0,0:39:22.63,0:39:25.13,Captions,Caption,0,0,0,,{\pos(640,548)\fad(500,0)}Punk Hazard Adası, Yanan Topraklar
Dialogue: 0,0:39:22.58,0:39:25.13,Main,Usopp,0,0,0,,Ne?! Nami ve diğerleri gittiler mi?!
Dialogue: 0,0:39:25.13,0:39:27.21,Main,Usopp,0,0,0,,Yalnız olduğunu mu söylüyorsun?
Dialogue: 0,0:39:27.21,0:39:30.51,Main,Usopp,0,0,0,,Uyandığında etrafın kar ve buzla mı kaplıydı?
Dialogue: 0,0:39:31.37,0:39:33.35,Main,Brook,0,0,0,,Aynen!
Dialogue: 0,0:39:33.35,0:39:37.39,Main,Brook,0,0,0,,Fırtınada mahsur kalmış kemik gibi çok şaşırdım! {kelime oyunu var}\N{The phrase he uses is literally "like my bones were hit by a pigeon-bullet". I looked it up, and it appears to be a play on the Japanese proverb 鳩が豆鉄砲を食ったよう, (literally "Like a pigeon being shot by a bean-bullet") which is apparently an expression of being extremely surprised, and it says that the English equivalent of this term is "Like a duck in a thunderstorm".} {Gil: Oh god...}
Dialogue: 0,0:39:38.81,0:39:39.60,Main,Brook,0,0,0,,Ha?
Dialogue: 0,0:39:39.60,0:39:42.40,Main,Brook,0,0,0,,Hayır bekle, ördekte mahsur kalmış fırtına gibi...
Dialogue: 0,0:39:42.40,0:39:45.28,Main,Brook,0,0,0,,Hayır, kemikte mahsur kalmış ördek gibi mi? {Knaryaa: Çevirirken acı çektim}
Dialogue: 0,0:39:45.28,0:39:46.36,Main,Brook,0,0,0,,Aman neyse!
Dialogue: 0,0:39:48.91,0:39:50.20,Main,Brook,0,0,0,,Afedersiniz!
Dialogue: 0,0:39:50.20,0:39:54.95,Main,Usopp,0,0,0,,Sunny'deki kargoyu çalmaya mı\N çalışıyorlardı? Onlar kimdi?
Dialogue: 0,0:40:03.08,0:40:05.91,Main,Brook,0,0,0,,Açıkçası soracak fırsatım...
Dialogue: 0,0:40:09.30,0:40:10.97,Flashbacks,Brook,0,0,0,,Bu arada,
Dialogue: 0,0:40:10.97,0:40:12.97,Flashbacks,Brook,0,0,0,,siz kimsiniz?
Dialogue: 0,0:40:14.72,0:40:17.17,Main,Brook,0,0,0,,Sormaya fırsat bulamadan onları yendim.
Dialogue: 0,0:40:18.01,0:40:21.30,Main,Brook,0,0,0,,Hepsi bir çeşit gaz maskesi takıyor gibi görünüyor.
Dialogue: 0,0:40:21.30,0:40:27.23,Main,Robin,0,0,0,,Gas maskeleri mi? Belki bir çeşit uyku gazı kullanmışlardır?
Dialogue: 0,0:40:27.23,0:40:31.32,Main,Robin,0,0,0,,Daha sonra bu insanlar Sunny'yi adanın diğer tarafına götürmüşlerdir.
Dialogue: 0,0:40:31.60,0:40:33.44,Main,Luffy,0,0,0,,Kahretsin, kaybettim!
Dialogue: 0,0:40:35.53,0:40:36.99,Main,Luffy,0,0,0,,Oldukça hızlısın!
Dialogue: 0,0:40:38.70,0:40:42.44,Main,Centaur,0,0,0,,Sen de fena değildin!
Dialogue: 0,0:40:42.44,0:40:45.08,Main,Luffy,0,0,0,,Tamam, tekrar deneyelim!
Dialogue: 0,0:40:45.08,0:40:47.46,Main,Centaur,0,0,0,,Ne kadar denersen dene{\fscx250}-{\r}
Dialogue: 0,0:40:48.11,0:40:49.08,Main,Centaur,0,0,0,,Merhaba?
Dialogue: 0,0:40:49.08,0:40:50.92,Main,Centaur,0,0,0,,Ne diye ortalıkta boş boş dolaşıyorsun?
Dialogue: 0,0:40:50.92,0:40:53.93,Main,Centaur,0,0,0,,Onları bulamıyorum.
Dialogue: 0,0:40:53.93,0:40:57.05,Main,Centaur,0,0,0,,Burada gerçekten davetsiz misafirler var mı?!
Dialogue: 0,0:40:57.05,0:41:00.85,Main,Centaur,0,0,0,,Tek bulduğum arka ayakları konuşan komik bir adam ve grubu.
Dialogue: 0,0:41:00.85,0:41:02.72,Main,Centaur,0,0,0,,Onlar davetsiz misafir!
Dialogue: 0,0:41:03.89,0:41:06.68,Main,Luffy,0,0,0,,Hadi! Devam edelim!
Dialogue: 0,0:41:08.56,0:41:12.05,Main,Brook,0,0,0,,Nami-san ve diğerleri nerede?
Dialogue: 0,0:41:12.05,0:41:16.36,Main,Robin,0,0,0,,Arkalarında mesaj bırakmadıklarına göre bir yere götürülmüş olmaları muhtemel görünüyor.
Dialogue: 0,0:41:16.36,0:41:21.45,Main,Usopp,0,0,0,,Olayı çözdüm! İskelet olduğun için,\Nseni ceset sanmış olmalılar!
Dialogue: 0,0:41:21.45,0:41:25.41,Main,Brook,0,0,0,,Anladım, yani bu yüzden geride bırakıldım! Ne kadar şanslıyım!
Dialogue: 0,0:41:25.41,0:41:30.87,Main,Robin,0,0,0,,Düşman hepimizin yakalandığını düşünüyor.\NEtrafta binalar ya da insanların izleri var mı?
Dialogue: 0,0:41:30.87,0:41:35.00,Main,Brook,0,0,0,,Robin-san, çok mantıklı soru. Sanki her şeyi görebiliyorsun!
Dialogue: 0,0:41:35.68,0:41:36.98,Main,Brook,0,0,0,,Burada...
Dialogue: 0,0:41:37.97,0:41:39.26,Main,Brook,0,0,0,,bir bina var.
Dialogue: 0,0:41:40.98,0:41:43.27,Main,Brook,0,0,0,,Devasa bir tane!
Dialogue: 0,0:41:43.97,0:41:46.47,Main,Brook,0,0,0,,Restoranta benzemiyor.
Dialogue: 0,0:41:46.47,0:41:49.56,Main,Robin,0,0,0,,Brook, bizi bekle, hemen oraya geliyoruz.
Dialogue: 0,0:41:49.56,0:41:50.62,Main,Brook,0,0,0,,Robin-san?
Dialogue: 0,0:41:50.62,0:41:54.15,Main,Brook,0,0,0,,Buraya geldiğin zaman, acaba senin{\fscx250}-{\r}
Dialogue: 0,0:41:55.49,0:41:57.57,Main,Zoro,0,0,0,,Düşman Hükümet'ten biri mi?
Dialogue: 0,0:41:57.57,0:42:01.16,Main,Usopp,0,0,0,,Kim bilir? En azından insan olduğunu umuyorum.
Dialogue: 0,0:42:01.16,0:42:03.02,Main,Usopp,0,0,0,,Demek istediğim şimdiye kadar gördüklerimiz...
Dialogue: 0,0:42:04.29,0:42:06.37,Main,Usopp,0,0,0,,ateş üfleyen bir ejderha,
Dialogue: 0,0:42:06.82,0:42:08.46,Main,Usopp,0,0,0,,yarı-adam,
Dialogue: 0,0:42:09.29,0:42:11.00,Main,Usopp,0,0,0,,ve bir kuş-kadın!
Dialogue: 0,0:42:12.96,0:42:17.80,Main,Usopp,0,0,0,,Ve hemen şuradaki Luffy'nin yanındaki Sen{\fscx250}-{\r}
Dialogue: 0,0:42:18.92,0:42:20.72,Main,Centaur,0,0,0,,Şimdi beni dinle!
Dialogue: 0,0:42:20.72,0:42:22.30,Main,Luffy,0,0,0,,Ne?! Sana ne oldu böyle?!
Dialogue: 0,0:42:23.43,0:42:24.67,Main,Luffy,0,0,0,,Sizler...
Dialogue: 0,0:42:28.30,0:42:30.85,Main,Centaur,0,0,0,,Gardımı indirdim. Benim tarafımda olduğunu sanıyordum.
Dialogue: 0,0:42:33.36,0:42:38.61,Main,Luffy,0,0,0,,Neden senin tarafında olamam?\NÇoktan arkadaş olduk, o yüzden bana saldırma!
Dialogue: 0,0:42:40.32,0:42:42.49,Main,Centaur,0,0,0,,Öl, pislik! {davetsiz misafir}
Dialogue: 0,0:42:42.49,0:42:43.79,Main,Robin,0,0,0,,Başka biri daha var!
Dialogue: 0,0:42:45.50,0:42:46.76,Attack,TL Note,0,0,0,,{\fad(100,100)}Yüz Çiçek
Dialogue: 0,0:42:51.63,0:42:52.79,Attack,TL Note,0,0,0,,{\fad(100,100)}Çan Çiçeği
Dialogue: 0,0:43:03.76,0:43:05.99,Main,Zoro,0,0,0,,Bir leopar ve bir zürafa, ha? {Gil: What is this? Enies Lobby?}
Dialogue: 0,0:43:07.68,0:43:10.85,Main,Luffy,0,0,0,,Görünüşe göre her türlü Sentor'lar var. Ne kadar eğlenceli!
Dialogue: 0,0:43:11.31,0:43:15.31,Main,Usopp,0,0,0,,Onlar hayali atlar!\NOnların varlığı tuhaf!
Dialogue: 0,0:43:18.32,0:43:22.07,Main,Usopp,0,0,0,,Şu Bebek Den Den Mushi'ye bakın! \NÜzerinde "CC" yazıyor!
Dialogue: 0,0:43:22.66,0:43:25.83,Main,Usopp,0,0,0,,Bunlar vahşi Sentor'lar değiller
Dialogue: 0,0:43:25.83,0:43:27.91,Main,Usopp,0,0,0,,Bir tür organizasyon olsa gerek!
Dialogue: 0,0:43:27.91,0:43:32.56,Main,Usopp,0,0,0,,Her durumda, ateşli okyanusa dönsek bile Sunny orada olmayacak.
Dialogue: 0,0:43:32.56,0:43:36.17,Main,Usopp,0,0,0,,Arktik topraklara gitmekten başka seçeneğimiz yok.
Dialogue: 0,0:43:36.17,0:43:40.54,Main,Usopp,0,0,0,,Nami, Sanji, Franky ve Chopper hepsi kayıp!
Dialogue: 0,0:43:40.54,0:43:44.68,Main,Robin,0,0,0,,Büyük ihtimalle kaçırıldılar.
Dialogue: 0,0:43:44.68,0:43:48.06,Main,Robin,0,0,0,,Umarım çoktan tüfeklerle delik deşik olmamışlardır.
Dialogue: 0,0:43:48.06,0:43:50.09,Main,Usopp,0,0,0,,{\i1}Kes şunu!{\i0}
Dialogue: 0,0:43:50.09,0:43:54.60,Main,Zoro,0,0,0,,Adanın diğer tarafına demir atsaydık daha hızlı olurdu!
Dialogue: 0,0:43:54.60,0:43:59.44,Main,Luffy,0,0,0,,Ama o zaman o ejderha etini yiyemez veya Bacakcık'la tanışamazdık!
Dialogue: 0,0:43:59.44,0:44:00.78,Main,Zoro,0,0,0,,Bacakcık da kim?
Dialogue: 0,0:44:00.78,0:44:03.65,Main,Luffy,0,0,0,,O benim arkamdaki bacağın adı!
Dialogue: 0,0:44:03.65,0:44:06.94,Main,Usopp,0,0,0,,Tamamdır, hadi gidelim! Hedefimizi değiştiriyoruz!
Dialogue: 0,0:44:06.94,0:44:09.91,Main,Usopp,0,0,0,,Tayfamızı kurtarmak için donmuş topraklara doğru yola çıkalım!
Dialogue: 0,0:44:09.91,0:44:13.38,Main,Robin,0,0,0,,{\fad(0,592)}Yol üzerinde kışlık kıyafet satan biri var mıdır acaba.
Dialogue: 0,0:44:14.87,0:44:17.42,Main,Usopp,0,0,0,,Oraya böyle giyinerek gidersek kesinlikle ölürüz.
Dialogue: 0,0:44:17.42,0:44:19.21,Main,Usopp,0,0,0,,Ne yapmalıyız?
Dialogue: 0,0:44:19.51,0:44:21.38,Main,Tashigi,0,0,0,,Koramiral Smoker! İmkansız!
Dialogue: 0,0:44:20.05,0:44:25.34,Captions,Caption,0,0,0,,{\pos(640,546)\fad(500,0)}Kuzeybatı Kıyısı
Dialogue: 0,0:44:21.38,0:44:23.55,Main,Marine,0,0,0,,N-Nefes alamıyorum!
Dialogue: 0,0:44:23.55,0:44:25.34,Main,Marine,0,0,0,,Gaz hâlâ dışarı sızıyor!
Dialogue: 0,0:44:25.34,0:44:30.35,Main,Marine,0,0,0,,O lanet Vegapunk'un silah deneyleri dört yıl önce başarısızlıkla sonuçlandığından beri...
Dialogue: 0,0:44:30.35,0:44:32.85,Main,Marine,0,0,0,,bütün ada çürümüş durumda!
Dialogue: 0,0:44:33.19,0:44:37.37,Main,Marine,0,0,0,,Daha da önemlisi Hasır Şapka Luffy'nin korsan gemisini hiçbir yerde göremiyorum!
Dialogue: 0,0:44:37.37,0:44:42.86,Main,Marine,0,0,0,,Etrafta bu kadar zehirli gaz varken kimsenin karaya çıkması mümkün değil.
Dialogue: 0,0:44:44.16,0:44:45.57,Main,Smoker,0,0,0,,Bu doğru değil.
Dialogue: 0,0:44:46.29,0:44:49.76,Main,Smoker,0,0,0,,Bu kadar gazın olması doğal değil.
Dialogue: 0,0:44:49.76,0:44:51.70,Main,Tashigi,0,0,0,,Ne demek istiyorsunuz?
Dialogue: 0,0:44:51.70,0:44:57.18,Main,Smoker,0,0,0,,İki yıl önce burası üzerinde ateş \Nya da buz bulunmayan ıssız bir adaydı.
Dialogue: 0,0:44:58.45,0:45:03.03,Main,Smoker,0,0,0,,Şaşırtıcı bir şekilde zehirli maddelerin çoğu o zamana kadar dağılmıştı.
Dialogue: 0,0:45:04.01,0:45:07.85,Main,Smoker,0,0,0,,Bu yüzden Akainu ve Aokiji...
Dialogue: 0,0:45:07.85,0:45:09.80,Main,Smoker,0,0,0,,Punk Hazard'ı...
Dialogue: 0,0:45:09.80,0:45:12.55,Main,Smoker,0,0,0,,düellolarının yeri olarak seçti.
Dialogue: 0,0:45:28.19,0:45:33.41,Main,Smoker,0,0,0,,İklimi değiştirecek kadar şiddetli bir savaş!
