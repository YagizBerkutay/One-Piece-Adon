ss BT,20.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.5,0.5,9,10,10,10,1Style: Hands Up lyrics,Futura Md BT,35,&H00FF762C,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2.0,0,8,10,10,30,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:02:29.97,0:02:35.73,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:11:32.10,0:11:42.10,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:20:26.00,0:20:28.71,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:02:29.97,0:02:35.73,Title,,0,0,0,,Yeni Çağın Devralınması!Dialogue: 0,0:02:36.25,0:02:39.30,Main,Brownbeard,0,0,0,,Punk Hazard'ın askerleri, bana kulak verin!Dialogue: 0,0:02:40.04,0:02:42.00,Main,Brownbeard,0,0,0,,Beni bir yerlerden izlediğinizi biliyorum!Dialogue: 0,0:02:42.00,0:02:44.57,Main,Brownbeard,0,0,0,,Hepiniz de kandırılıyorsunuz.Dialogue: 0,0:02:44.57,0:02:50.12,Main,Brownbeard,0,0,0,,Caesar'ın söylediği her şey bir yalan! Burada kalırsanız hepiniz öleceksiniz.Dialogue: 0,0:02:50.12,0:02:52.24,Main,Gasmask soldier,0,0,0,,Ne diyor bu?Dialogue: 0,0:02:52.24,0:02:55.43,Main,Gasmask soldier,0,0,0,,Hasır Şapkalar'ın eline düştükten sonra aklını falan mı yitirdi acaba?Dialogue: 0,0:02:55.43,0:02:59.24,Main,Gasmask soldier,0,0,0,,Kahverengisakal hemen altımızda,  R Binası'nda.Dialogue: 0,0:02:59.24,0:03:05.37,Main,Gasmask soldier,0,0,0,,Planınıza göre yakında Hasır Şapkalar ve Donanma da orada toplanacak.Dialogue: 0,0:03:05.37,0:03:07.61,Main,Gasmask soldier,0,0,0,,Kahverengisakal'ı yukarı çağırsak mı?Dialogue: 0,0:03:08.56,0:03:11.36,Main,Brownbeard,0,0,0,,Size Caesar'la ilgili gerçekleri anlatacağım!Dialogue: 0,0:03:11.36,0:03:14.58,Main,Caesar,0,0,0,,Hayır, ben ineceğim oraya.Dialogue: 0,0:03:14.58,0:03:16.14,Main,Gasmask soldier,0,0,0,,Biz de geliyoruz öyleyse!Dialogue: 0,0:03:18.87,0:03:20.21,Main,Brownbeard,0,0,0,,Caesar!Dialogue: 0,0:03:20.21,0:03:24.77,Main,Caesar,0,0,0,,Pek değerli askerim, Kahverengisakal!Dialogue: 0,0:03:25.67,0:03:28.00,Main,Caesar,0,0,0,,Ne kadar da hırpalanmışsın böyle!Dialogue: 0,0:03:30.04,0:03:31.19,Main,Caesar,0,0,0,,Ne oldu?Dialogue: 0,0:03:31.55,0:03:33.63,Main,Brownbeard,0,0,0,,Adamlarımı geri istiyorum!Dialogue: 0,0:03:34.15,0:03:38.50,Main,Brownbeard,0,0,0,,Adanın ortasında soyulmuş olabiliriz ama ölmediklerine eminim!Dialogue: 0,0:03:38.50,0:03:40.17,Main,Brownbeard,0,0,0,,Çoktan geri dönmüşlerdir!Dialogue: 0,0:03:40.18,0:03:43.59,Main,Gasmask soldier,0,0,0,,Master'a bağırıyor herif!Dialogue: 0,0:03:43.59,0:03:47.55,Flashbacks,Caesar,0,0,0,,Ne oldu? Sahi, sizler Kahverengisakal'ın adamlarıydınız değil mi?Dialogue: 0,0:03:47.55,0:03:52.68,Flashbacks,Centaur,0,0,0,,Master! Donanma Askerleri girişteler ve kapı da kapalı!Dialogue: 0,0:03:54.01,0:03:55.73,Flashbacks,Centaur,0,0,0,,İçeri giremiyoruz!Dialogue: 0,0:03:55.73,0:03:56.95,Flashbacks,Centaur,0,0,0,,Lütfen bir yol gösterin bize!Dialogue: 0,0:03:56.95,0:04:01.72,Flashbacks,Caesar,0,0,0,,Öyle demek, amanın! Derhal bir yol bulacağım! Bekleyin orada!Dialogue: 0,0:04:02.25,0:04:05.58,Flashbacks,Monet,0,0,0,,Master, nasıl içeri alacaksınız onları?Dialogue: 0,0:04:09.79,0:04:14.38,Flashbacks,Caesar,0,0,0,,Unut gitsin! Çok yakında Shinokuni dışarısını teslim alacak zaten.Dialogue: 0,0:04:14.38,0:04:17.36,Main,Caesar,0,0,0,,Acaba ne oldu onlara?Dialogue: 0,0:04:17.36,0:04:19.25,Main,Caesar,0,0,0,,Beni aramayı da bıraktılar.Dialogue: 0,0:04:20.94,0:04:24.27,Main,Brownbeard,0,0,0,,Burada değillerse, dışarıda çoktan...Dialogue: 0,0:04:24.27,0:04:27.30,Main,Caesar,0,0,0,,Endişelendin mi? Eminim endişelenmişsindir!Dialogue: 0,0:04:27.30,0:04:30.55,Main,Caesar,0,0,0,,Dışarıda kalmışlarsa kesin Shinokuni yüzünden ölmüşlerdir.Dialogue: 0,0:04:31.46,0:04:35.15,Main,Brownbeard,0,0,0,,Artık söylediğin hiçbir şeye inanmıyorum!Dialogue: 0,0:04:35.15,0:04:37.30,Main,Gasmask soldier,0,0,0,,Ne olmuş buna böyle?!Dialogue: 0,0:04:37.30,0:04:39.41,Main,Gasmask soldier,0,0,0,,Master'a ne yapıyor bu?!Dialogue: 0,0:04:39.41,0:04:43.74,Main,Brownbeard,0,0,0,,Sizinle geçirdiğim iki yılın hatrına size de söyleyeceğim.Dialogue: 0,0:04:43.74,0:04:45.78,Main,Brownbeard,0,0,0,,Derhal bu adayı terk edin!Dialogue: 0,0:04:45.78,0:04:51.14,Main,Brownbeard,0,0,0,,Bu herifin arkanızdan nasıl konuştuğunu bilmek istiyor musunuz?!Dialogue: 0,0:04:51.94,0:04:54.10,Main,Brownbeard,0,0,0,,Size...Dialogue: 0,0:04:54.10,0:04:55.86,Main,Brownbeard,0,0,0,,...demek fayeleri dedi!Dialogue: 0,0:04:57.47,0:04:58.96,Main,Brownbeard,0,0,0,,Desek payeleri!Dialogue: 0,0:05:01.25,0:05:03.68,Main,Brownbeard,0,0,0,,Demek... Desek...Dialogue: 0,0:05:06.09,0:05:07.90,Main,Gasmask soldier,0,0,0,,Ne diyorsun sen be Kahverengisakal!?Dialogue: 0,0:05:08.30,0:05:10.24,Main,Gasmask soldier,0,0,0,,Adam gibi söyle!Dialogue: 0,0:05:10.24,0:05:11.71,Main,Gasmask soldier,0,0,0,,Adını mı heceliyorsun?Dialogue: 0,0:05:11.71,0:05:13.48,Main,Gasmask soldier,0,0,0,,Gel de gülme bu herife!Dialogue: 0,0:05:14.19,0:05:15.71,Main,Brownbeard,0,0,0,,Demek...Dialogue: 0,0:05:15.71,0:05:21.34,Flashbacks,Caesar,0,0,0,,Beni kurtarıcıları olarak görüp peşimden gelmeye devam edecekler!Dialogue: 0,0:05:21.34,0:05:25.47,Flashbacks,Caesar,0,0,0,,Sırf denek farelerim oldukları için onları hayatta tuttuğumu bilmiyorlar!Dialogue: 0,0:05:25.88,0:05:27.56,Thoughts,Brownbeard,0,0,0,,Denek fareleri!Dialogue: 0,0:05:30.52,0:05:33.07,Thoughts,Brownbeard,0,0,0,,Ne oluyor?! Ağzımı hareket ettiremiyorum!Dialogue: 0,0:05:33.68,0:05:35.89,Thoughts,Brownbeard,0,0,0,,Bir şeyler yaptın değil mi, Caesar?!Dialogue: 0,0:05:46.86,0:05:48.35,Main,Gasmask soldier,0,0,0,,Şimdi ne var?!Dialogue: 0,0:05:48.64,0:05:50.24,Main,Gasmask soldier,0,0,0,,Nasıl bir gösteri bu?!Dialogue: 0,0:05:51.35,0:05:53.83,Main,Caesar,0,0,0,,Kas gevşetici.Dialogue: 0,0:05:53.83,0:05:56.77,Main,Caesar,0,0,0,,Ne ağzında ne başka bir yerinde mecal kalmadı değil mi?Dialogue: 0,0:05:59.52,0:06:02.73,Main,Caesar,0,0,0,,Bak şimdi hatırladım, Kahverengisakal.Dialogue: 0,0:06:02.73,0:06:06.44,Main,Caesar,0,0,0,,Adamlarını, sahi ya...Dialogue: 0,0:06:06.44,0:06:07.82,Main,Caesar,0,0,0,,...ölüme terk etmiştim!Dialogue: 0,0:06:11.65,0:06:15.12,Thoughts,Brownbeard,0,0,0,,Seni adi herif!Dialogue: 0,0:06:16.88,0:06:20.74,Thoughts,Brownbeard,0,0,0,,Ne cüretle!? Ne cüretle adamlarımı öldürürsün!?Dialogue: 0,0:06:25.40,0:06:30.84,Main,Caesar,0,0,0,,Bak bir şey daha paylaşayım seninle.Dialogue: 0,0:06:31.19,0:06:37.37,Main,Caesar,0,0,0,,Dört yıl önceki, adadaki neredeyse her askeri öldüren o patlama var ya?Dialogue: 0,0:06:37.37,0:06:40.47,Main,Caesar,0,0,0,,Ona da ben neden olmuştum.Dialogue: 0,0:06:41.60,0:06:44.60,Thoughts,Brownbeard,0,0,0,,Vegapunk değil miydi ona neden olan?!Dialogue: 0,0:06:44.60,0:06:48.64,Thoughts,Brownbeard,0,0,0,,Bu adi herkese önce zarar verip sonra da kurtarmış gibi mi yaptı yani?!Dialogue: 0,0:06:55.87,0:06:58.54,Main,Caesar,0,0,0,,Yapma! Yapma lütfen!Dialogue: 0,0:06:58.54,0:07:02.70,Main,Caesar,0,0,0,,Yardım edin! Kahverengisakal çıldırmış!Dialogue: 0,0:07:05.40,0:07:10.76,Thoughts,Brownbeard,0,0,0,,Kaçın millet! Bu adada meydana gelen her şey Caesar tarafından planlanmış.Dialogue: 0,0:07:10.76,0:07:15.94,Thoughts,Brownbeard,0,0,0,,Kaçın millet! İnsan kılığına girmiş bir şeytan duruyor karşınızda!Dialogue: 0,0:07:15.94,0:07:17.50,Main,Gasmask soldier,0,0,0,,Hey, Kahverengisakal!Dialogue: 0,0:07:17.50,0:07:19.55,Main,Gasmask soldier,0,0,0,,Canını kurtarmış kişiye nasıl böyle bir şey yaparsın?Dialogue: 0,0:07:19.55,0:07:22.95,Main,Caesar,0,0,0,,Olamaz! Kahverengisakal'ın durumu çok ciddi!Dialogue: 0,0:07:22.95,0:07:27.33,Main,Caesar,0,0,0,,Çok geç! Korkarım  Hasır Şapkalar ona bir şey yapmışlar!Dialogue: 0,0:07:27.94,0:07:29.85,Main,Caesar,0,0,0,,Ateş edin!Dialogue: 0,0:07:40.45,0:07:43.26,Main,Caesar,0,0,0,,Bitirelim şunun işini.Dialogue: 0,0:07:44.10,0:07:45.44,Main,Caesar,0,0,0,,Gastan-Dialogue: 0,0:07:52.31,0:07:53.29,Main,Gasmask soldier,0,0,0,,Master!Dialogue: 0,0:07:54.22,0:07:56.67,Main,Caesar,0,0,0,,Gidiciydik var ya!Dialogue: 0,0:07:56.67,0:07:57.84,Main,Caesar,0,0,0,,Sıyırdı!Dialogue: 0,0:07:59.02,0:08:00.69,Main,Caesar,0,0,0,,Lanet olası! Kimsin sen?!Dialogue: 0,0:08:06.11,0:08:11.49,Main,Gasmask soldiers,0,0,0,,Hasır Şapkalı Luffy!Dialogue: 0,0:08:19.78,0:08:26.53,Flashbacks,Brownbeard,0,0,0,,Şefkati diğerleri gibi benim de hayatımı kurtardı.Dialogue: 0,0:08:26.53,0:08:30.33,Flashbacks,Brownbeard,0,0,0,,Master iyi kalpli kurtarıcımızdı bizim!Dialogue: 0,0:08:31.79,0:08:34.39,Main,Caesar,0,0,0,,Herkes ikinci kata geri dönsün!Dialogue: 0,0:08:34.39,0:08:37.71,Main,Caesar,0,0,0,,Hasır Şapkalar ve Donanma çok yakında burada olur.Dialogue: 0,0:08:37.71,0:08:38.95,Main,Caesar,0,0,0,,Deneye hazırlanın!Dialogue: 0,0:08:38.95,0:08:39.71,Main,Gasmask soldier,0,0,0,,Emredersiniz!Dialogue: 0,0:08:39.71,0:08:42.44,Main,Gasmask soldier,0,0,0,,Görüntüler canlı olarak simsarlara aktarılsın!Dialogue: 0,0:08:42.44,0:08:47.54,Flashbacks,Caesar,0,0,0,,Hepsi de beş yıl içinde ölecekler.Dialogue: 0,0:08:50.01,0:08:52.52,Main,Momonosuke,0,0,0,,Luffy, bu adamdı işte!Dialogue: 0,0:08:52.52,0:08:55.40,Main,Momonosuke,0,0,0,,O iyi kalpli çocuklar hakkında...Dialogue: 0,0:08:56.24,0:08:57.67,Main,Momonosuke,0,0,0,,Çocuklar hakkında...Dialogue: 0,0:08:58.19,0:08:59.26,Main,Luffy,0,0,0,,Biliyorum.Dialogue: 0,0:09:00.25,0:09:03.12,Main,Luffy,0,0,0,,Herkes kandırıldığı için bu adada değil mi?Dialogue: 0,0:09:03.12,0:09:05.82,Main,Luffy,0,0,0,,Bu ada neyin nesi?!Dialogue: 0,0:09:07.84,0:09:09.13,Main,Caesar,0,0,0,,Haklısın.Dialogue: 0,0:09:09.96,0:09:14.62,Main,Caesar,0,0,0,,Bu ada gaz gibi, hava gibi bir şey.Dialogue: 0,0:09:15.34,0:09:17.75,Main,Caesar,0,0,0,,Var olmayan bir ada.Dialogue: 0,0:09:17.75,0:09:21.28,Main,Caesar,0,0,0,,O yüzden de yeraltı dünyası çalışmaları için biçilmiş kaftan!Dialogue: 0,0:09:22.21,0:09:24.75,Main,Caesar,0,0,0,,Şeytani bilimin merkezi.Dialogue: 0,0:09:24.75,0:09:31.43,Main,Caesar,0,0,0,,Kanunlara aykırı deneyler yapabilir istediğimiz kadar illegal denek kullanabiliriz.Dialogue: 0,0:09:31.43,0:09:36.67,Main,Caesar,0,0,0,,Bizi destekleyen güç sahibi kişiler mevcut ve kimsenin haberi olmasın diye...Dialogue: 0,0:09:36.67,0:09:39.31,Main,Caesar,0,0,0,,...bu kişiler her şeyi örtbas etmeye hazırlar.Dialogue: 0,0:09:39.31,0:09:45.23,Main,Caesar,0,0,0,,Ne kadar ağlasanız da, ne kadar bağırsanız da kimse sizi kurtarmaya gelmeyecek.Dialogue: 0,0:09:45.23,0:09:50.20,Main,Caesar,0,0,0,,Bu adayla ilgili hiçbir şeyden haberiniz yok, Hasır Şapka!Dialogue: 0,0:09:50.20,0:09:55.45,Main,Caesar,0,0,0,,Eğer ciddiye almazsanız ölüp gideceksiniz!Dialogue: 0,0:09:55.45,0:09:57.92,Main,Caesar,0,0,0,,Law'la ittifak kurmak mesela kötü bir fikirdi.Dialogue: 0,0:09:58.52,0:10:01.61,Main,Caesar,0,0,0,,SAD'ı kurcalamayı planlıyor.Dialogue: 0,0:10:01.61,0:10:07.45,Main,Caesar,0,0,0,,SAD üretebilen tek kişi benim diye beni kaçırmak için sizi kullanıyor.Dialogue: 0,0:10:07.45,0:10:14.20,Main,Caesar,0,0,0,,Shichibukai diye bilinen o tehlikeli adam  Donquixote Doflamingo'ya ait olan bu tesiste üretilen...Dialogue: 0,0:10:14.20,0:10:17.73,Main,Caesar,0,0,0,,...ve "Gülücük" isimli meyveye  dönüştürülen bir madde.Dialogue: 0,0:10:20.51,0:10:24.87,Main,Caesar,0,0,0,,Gülücük Zoan türü, insan yapımı bir Şeytan Meyvesi.Dialogue: 0,0:10:24.87,0:10:28.21,Main,Caesar,0,0,0,,Güç peşinde olanların  elde etmeye çalıştığı şey.Dialogue: 0,0:10:28.21,0:10:33.98,Main,Caesar,0,0,0,,Doflamingo bu "Gülücük"leri Yeni Dünya'daki kodamanlara satıyor.Dialogue: 0,0:10:33.98,0:10:40.98,Main,Caesar,0,0,0,,Yonko'lardan birinin bu Gülücük'lerle yüzlerce kişilik bir ordu kurmaya başladığının haberlerini aldım bile.Dialogue: 0,0:10:40.98,0:10:44.19,Main,Caesar,0,0,0,,İnsanın içini titretiyor değil mi?Dialogue: 0,0:10:44.74,0:10:48.01,Main,Caesar,0,0,0,,Neyle karşı karşıya olduğunu şimdi anlıyor musun?Dialogue: 0,0:10:48.77,0:10:55.36,Main,Caesar,0,0,0,,Doflamingo'nun işine çomak sokarak pek çok kodamanı kızdırmış olacaksın.Dialogue: 0,0:10:56.03,0:11:00.01,Main,Caesar,0,0,0,,Bu kodamanlar harekete geçtiğinde de tüm dünya yerinden oynayacak.Dialogue: 0,0:11:00.01,0:11:04.22,Main,Caesar,0,0,0,,Law da bunun peşinde. Aptal herif!Dialogue: 0,0:11:04.22,0:11:07.66,Main,Caesar,0,0,0,,Siz onların kılı bile olamayacak güçtesiniz!Dialogue: 0,0:11:09.66,0:11:12.66,Main,Caesar,0,0,0,,Hadi şimdi yakala beni de görelim! Arkam sağlam benim!Dialogue: 0,0:11:12.66,0:11:15.66,Main,Caesar,0,0,0,,Doflamingo, Yonko!Dialogue: 0,0:11:15.66,0:11:19.27,Main,Caesar,0,0,0,,Onlara karşı gelmeyi göze alacak cesaret var mı sizde!?Dialogue: 0,0:11:27.00,0:11:31.90,Main,Luffy,0,0,0,,O dediğin şeyi istemediğin kadar çok yaptım!Dialogue: 0,0:11:31.90,0:11:35.37,Main,Gasmask Soldier,0,0,0,,M-Master!Dialogue: 0,0:11:43.06,0:11:44.99,Main,Caesar,0,0,0,,Bu ne cüret, lanet olası!?Dialogue: 0,0:11:48.01,0:11:51.61,Main,Caesar,0,0,0,,Sen ne dediğimi duymadın mı?!Dialogue: 0,0:11:51.61,0:11:54.68,Main,Caesar,0,0,0,,Bunun yanına kâr kalacağını sanma!Dialogue: 0,0:11:55.37,0:11:59.70,Main,Caesar,0,0,0,,Benim arkamda o manyak korsan...Dialogue: 0,0:12:00.17,0:12:05.25,Main,Caesar,0,0,0,,...Shichibukai Donquixote Doflamingo var be!Dialogue: 0,0:12:05.25,0:12:10.40,Main,Caesar,0,0,0,,Yeni Dünya'yı perdeler arkasından elinde oynatan adam o!Dialogue: 0,0:12:10.40,0:12:16.75,Main,Caesar,0,0,0,,Silahlar, kitle imha silahları, uyuşturucu... Her tür tehlikeli şeyde adı geçiyor!Dialogue: 0,0:12:18.88,0:12:21.59,Main,Caesar,0,0,0,,Anlayacağın yeraltı dünyasının akıl adamı kendisi!Dialogue: 0,0:12:21.59,0:12:24.87,Main,Caesar,0,0,0,,Aklının bile almayacağı karanlık kişileri tanıyor!Dialogue: 0,0:12:28.73,0:12:33.98,Main,Caesar,0,0,0,,Ama hayatlarınızı hâlâ bağışlayabilirim. Özür dilersen hemen...Dialogue: 0,0:12:35.32,0:12:42.28,Main,Caesar,0,0,0,,Bana bir şey yapacak olursan kızdıracağın tüm o canavarları düşün!Dialogue: 0,0:12:45.03,0:12:46.64,Main,Caesar,0,0,0,,Gastille!Dialogue: 0,0:12:45.03,0:12:46.64,Attack,Caesar,0,0,0,,GaztilDialogue: 0,0:12:51.71,0:12:53.35,Main,Caesar,0,0,0,,Böyle olur işte!Dialogue: 0,0:12:53.35,0:12:54.70,Main,Gasmask Soldier,0,0,0,,İşte bu!Dialogue: 0,0:12:54.70,0:12:56.72,Main,Gasmask Soldier,0,0,0,,Demiri bile eriten gaz yakıcı.Dialogue: 0,0:12:57.20,0:13:01.58,Main,Caesar,0,0,0,,Eriyip gitti mi? Yoksa küle mi dönüştü?Dialogue: 0,0:13:05.25,0:13:07.70,Main,Caesar,0,0,0,,Değil mi ama?!Dialogue: 0,0:13:07.70,0:13:09.29,Main,Caesar,0,0,0,,İnsana gerçek gibi gelmiyor!Dialogue: 0,0:13:09.32,0:13:13.15,Main,Caesar,0,0,0,,Yeni Dünya'ya yeni ayak basmış bir çaylak için çok uçuk bir hikaye!Dialogue: 0,0:13:13.15,0:13:16.06,Main,Caesar,0,0,0,,Fakat o canavarlardan biri bu laboratuvarın içinde!Dialogue: 0,0:13:16.06,0:13:21.13,Main,Caesar,0,0,0,,Vergo'yu diyorum! Silahlanma Hakisi'nin  karşısında kimseler duramaz!Dialogue: 0,0:13:21.13,0:13:23.96,Main,Caesar,0,0,0,,Smoker da Law da ölecek!Dialogue: 0,0:13:24.45,0:13:26.51,Main,Caesar,0,0,0,,Buna tüm tayfan da dahil!Dialogue: 0,0:13:29.20,0:13:32.03,Main,Luffy,0,0,0,,Umrumda değil!Dialogue: 0,0:13:36.19,0:13:40.71,Narrator,Narrator,0,0,0,,İnsanları taşlaştırıp, canlarını alan, ölümcül gaz Shinokuni.Dialogue: 0,0:13:41.61,0:13:45.68,Narrator,Narrator,0,0,0,,Ve şu anda bu gaz laboratuvarın içine sızmakta.Dialogue: 0,0:13:46.23,0:13:48.10,Main,Tashigi,0,0,0,,Ne yapıyorsun sen?!Dialogue: 0,0:13:48.10,0:13:51.72,Main,Tashigi,0,0,0,,Dümdüz gitseydin çoktan çocuklara yetişmiştik!Dialogue: 0,0:13:51.72,0:13:53.10,Main,Zoro,0,0,0,,Kapa çeneni be!Dialogue: 0,0:13:55.65,0:13:57.89,Main,Nami,0,0,0,,Acele edin çocuklar! Koşun!Dialogue: 0,0:13:58.15,0:14:01.69,Main,Sind,0,0,0,,Başım dönüyor! Uykudan uyanmış gibiyim!Dialogue: 0,0:14:01.69,0:14:05.52,Main,Robin,0,0,0,,Sakinleştiriciler yüzünden öyle. Bir zararı yok ama içiniz rahat olsun.Dialogue: 0,0:14:06.70,0:14:11.11,Narrator,Narrator,0,0,0,,Sağ kalanlar adadan son çıkış noktası olan...Dialogue: 0,0:14:11.11,0:14:15.48,Narrator,Narrator,0,0,0,,...Luffy ve Caesar'ın savaştığı R binasının birinci katına doğru ilerlemekteler.Dialogue: 0,0:14:16.15,0:14:19.87,Narrator,Narrator,0,0,0,,Bu sırada oğlu Momonosuke'yi aramakta olan Kin'emon ise...Dialogue: 0,0:14:20.60,0:14:24.26,Main,Kin'emon,0,0,0,,Ne yaptım ben!? Momonosuke?!Dialogue: 0,0:14:24.26,0:14:29.03,Flashbacks,Kin'emon,0,0,0,,Ne?! Momonosuke küçük bir ejderhaya mı dönüştü?Dialogue: 0,0:14:30.12,0:14:35.70,Main,Kin'emon,0,0,0,,Yoksa ben, Momonosuke'yi mi kestim?!Dialogue: 0,0:14:35.70,0:14:37.57,Main,Kin'emon,0,0,0,,Momonosuke!Dialogue: 0,0:14:37.82,0:14:40.36,Main,Kin'emon,0,0,0,,Çok kötü bir şey yaptım!Dialogue: 0,0:14:40.36,0:14:43.33,Main,Brook,0,0,0,,Kin'emon-san, geri dönemezsiniz!Dialogue: 0,0:14:43.33,0:14:45.43,Main,Brook,0,0,0,,Orası çoktan gazla dolmuştur!Dialogue: 0,0:14:54.27,0:14:55.86,Main,Gasmask Soldier,0,0,0,,Düşman bu!Dialogue: 0,0:14:56.81,0:14:59.35,Main,Usopp,0,0,0,,Neden hep benim başıma geliyor bunlar?!Dialogue: 0,0:15:11.82,0:15:13.50,Main,Vergo,0,0,0,,Ne yapıyorsun?Dialogue: 0,0:15:15.87,0:15:21.22,Main,Vergo,0,0,0,,Kendinden daha iyi bir Haki kullanıcısı karşısında böyle incecik bir dumana dönüşmemelisin.Dialogue: 0,0:15:25.13,0:15:26.84,Main,Vergo,0,0,0,,Sana vurmamı kolaylaştırıyorsun!Dialogue: 0,0:15:31.95,0:15:34.71,Main,Vergo,0,0,0,,Hem neden Şeytan Meyvesi güçlerini kullanıyorsun ki?Dialogue: 0,0:15:34.71,0:15:36.58,Main,Vergo,0,0,0,,Doğru düzgün düşünemiyor musun artık?Dialogue: 0,0:15:37.51,0:15:41.64,Main,Vergo,0,0,0,,Hiç senden bekleyeceğim bir şey değildi bu, Smoker-kun.Dialogue: 0,0:15:50.24,0:15:51.37,Main,Vergo,0,0,0,,Oni Take!Dialogue: 0,0:15:50.24,0:15:51.37,Attack,Vergo,0,0,0,,Şeytan BambusuDialogue: 0,0:16:04.65,0:16:07.86,Main,Vergo,0,0,0,,Donanma'yı suistimal ettiğim için beni öldürmek istediğini biliyorum.Dialogue: 0,0:16:08.20,0:16:11.45,Main,Vergo,0,0,0,,Ama insanda bunu yapacak güç de olmalı, Smoker.Dialogue: 0,0:16:11.45,0:16:14.41,Main,Vergo,0,0,0,,Desteksiz cesaretle adamlarının gözüne giremezsin.Dialogue: 0,0:16:22.52,0:16:28.77,Main,Law,0,0,0,,Smoker, kalbimi geri kazandığın için teşekkür ederim!Dialogue: 0,0:16:32.22,0:16:33.91,Main,Vergo,0,0,0,,Demek mesele buymuş, lanet olası!Dialogue: 0,0:16:37.41,0:16:40.25,Main,Smoker,0,0,0,,Ödeşmiş olduk.Dialogue: 0,0:16:40.25,0:16:42.12,Main,Smoker,0,0,0,,Bitir şunun işini hadi!Dialogue: 0,0:16:43.30,0:16:46.63,Main,Law,0,0,0,,Bir korsana borçlu kalmak istemiyorsun demek?Dialogue: 0,0:16:47.88,0:16:50.18,Main,Smoker,0,0,0,,Donanma'nın yüz karasıyım!Dialogue: 0,0:16:50.18,0:16:52.34,Main,Smoker,0,0,0,,Adamlarıma gösterecek yüzüm yok.Dialogue: 0,0:16:52.67,0:16:58.17,Main,Law,0,0,0,,Fakat sayende kurtulduğum da  diğer bir gerçek.Dialogue: 0,0:16:58.17,0:17:00.57,Main,Law,0,0,0,,Sonun geldi...Dialogue: 0,0:17:00.57,0:17:03.46,Main,Law,0,0,0,,...Vergo-san.Dialogue: 0,0:17:03.46,0:17:05.57,Main,Vergo,0,0,0,,Lanet velet,...Dialogue: 0,0:17:05.57,0:17:08.74,Main,Vergo,0,0,0,,...sonunda senden daha iyi olduğum  aklına geldi demek?Dialogue: 0,0:17:08.74,0:17:11.91,Main,Law,0,0,0,,Şimdilik böyle düşünmeni istiyorum.Dialogue: 0,0:17:11.91,0:17:16.99,Main,Law,0,0,0,,Ama sonsuza dek o tahtta kalacağını da sanma! Size diyorum!Dialogue: 0,0:17:17.71,0:17:20.45,Main,Law,0,0,0,,Dinlediğini biliyorum, Joker!Dialogue: 0,0:17:29.29,0:17:31.45,Main,Law,0,0,0,,Vergo'nun işi bitti.Dialogue: 0,0:17:31.45,0:17:34.48,Main,Law,0,0,0,,Sağ kolunu kaybetmek üzeresin.Dialogue: 0,0:17:34.48,0:17:37.50,Main,Law,0,0,0,,Ceasar'ın işini de Hasır Şapka halledecek.Dialogue: 0,0:17:37.50,0:17:41.37,Main,Law,0,0,0,,Yani SAD'ı da kaybedeceksin.Dialogue: 0,0:17:41.67,0:17:46.71,Main,Law,0,0,0,,Kendine olan aşırı güvenin yüzünden bunların olacağını kestiremedin.Dialogue: 0,0:17:47.42,0:17:51.86,Main,Law,0,0,0,,Her zamanki gibi sırıtıp bir sonraki adımını düşünmeye başla hadi!Dialogue: 0,0:17:52.42,0:17:56.85,Main,Law,0,0,0,,Fakat bizler aklına bile gelmeyecek olanı yapıp...Dialogue: 0,0:17:58.15,0:18:00.36,Main,Law,0,0,0,,...o gülüşüne bir son vereceğiz.Dialogue: 0,0:18:04.38,0:18:08.93,Main,Joker,0,0,0,,Böyle güçlü ayakları falan güzel, velet.Dialogue: 0,0:18:08.93,0:18:12.97,Main,Joker,0,0,0,,Fakat kurtulacağına emin misin?Dialogue: 0,0:18:12.97,0:18:15.85,Main,Joker,0,0,0,,Gözünün önünde duran Vergo'ya bir bak.Dialogue: 0,0:18:15.85,0:18:18.89,Main,Joker,0,0,0,,Kızdırdın sanki onu?Dialogue: 0,0:18:19.88,0:18:24.13,Main,Joker,0,0,0,,En son böyle bir şey yaşandığında neler olduğunu hatırlıyor musun?Dialogue: 0,0:18:24.13,0:18:29.85,Main,Joker,0,0,0,,Hatırladın mı? Vergo'yu kızdırdıktan sonra ne olmuştu?Dialogue: 0,0:18:32.03,0:18:35.46,Main,Joker,0,0,0,,Eminim şok edici gelmiş, unutmuşsundur.Dialogue: 0,0:18:35.77,0:18:38.31,Main,Joker,0,0,0,,Vergo'ya karşı olan o büyük korku.Dialogue: 0,0:18:40.04,0:18:42.77,Main,Joker,0,0,0,,Eşi olmayan kılıç ustalığına rağmen...Dialogue: 0,0:18:43.36,0:18:46.77,Main,Joker,0,0,0,,...Haki'si her şeyi engelleyecek.Dialogue: 0,0:18:46.77,0:18:54.60,Main,Joker,0,0,0,,Konum olarak da güç olarak da Vergo'nun kılı bile olamazsın!Dialogue: 0,0:19:19.27,0:19:22.52,Main,Law,0,0,0,,En İyilerin Savaşı'nın üzerinden iki yıl geçti.Dialogue: 0,0:19:25.64,0:19:29.29,Main,Law,0,0,0,,Bu sürede kim ne elde etti?Dialogue: 0,0:19:30.29,0:19:33.06,Main,Law,0,0,0,,Hepiniz pusup kaldınız.Dialogue: 0,0:19:34.24,0:19:38.04,Main,Law,0,0,0,,Beyazsakal'ın tek yaptığı bir çağa son vermek oldu.Dialogue: 0,0:19:39.39,0:19:43.05,Main,Law,0,0,0,,Donanma Karargahı yeni güçler topladı.Dialogue: 0,0:19:44.12,0:19:46.74,Main,Law,0,0,0,,Kodamanlarsa hiçbir şey yapmadılar!Dialogue: 0,0:19:47.91,0:19:52.01,Main,Law,0,0,0,,Sanki bir şeylere hazırlanıyorlarmışçasına...Dialogue: 0,0:19:52.01,0:19:55.18,Main,Law,0,0,0,,...o savaş sadece bir başlangıç oldu.Dialogue: 0,0:19:57.13,0:20:07.90,Main,Law,0,0,0,,Bana hep derdin ki gözüpek kişilerin çağı, durdurulamaz bir dalgayla birlikte yaklaşmakta!Dialogue: 0,0:20:09.70,0:20:13.31,Main,Law,0,0,0,,Fitili ateşledim.Dialogue: 0,0:20:16.62,0:20:22.57,Main,Law,0,0,0,,Artık geri dönüş yok!Dialogue: 0,0:00:24.22,0:00:27.47,Credits,,0,0,0,,Translation & initial syncing Yibis FansubsDialogue: 0,0:00:27.64,0:00:30.73,Credits,,0,0,0,,Syncing Galaxy 9000  Sync-checking SewilDialogue: 0,0:00:31.17,0:00:34.35,Credits,,0,0,0,,Quality-checking Sewil and Galaxy 9000Dialogue: 0,0:00:34.87,0:00:38.42,Credits,,0,0,0,,Soundtracking HaleeDialogue: 0,0:00:41.42,0:00:43.69,Credits,,0,0,0,,Video editing SewilDialogue: 0,0:00:00.20,0:00:05.07,Hands Up lyrics,,0,0,0,,♪ Kaldır ellerini daha da yukarıya, hayallerini dök şarkılara. ♪Dialogue: 0,0:00:05.14,0:00:08.72,Hands Up lyrics,,0,0,0,,♪ Yıkılma hiçbir zaman, sarsılmaz bayrağını kaldır göklere. ♪Dialogue: 0,0:00:08.80,0:00:12.27,Hands Up lyrics,,0,0,0,,♪ Buralara kadar gelebilmek için pek çok duvarı yıkıp geçtik! ♪Dialogue: 0,0:00:12.34,0:00:17.68,Hands Up lyrics,,0,0,0,,♪ Hedef gelecek, haydi eller havaya!! ♪Dialogue: 0,0:00:23.31,0:00:30.66,Hands Up lyrics,,0,0,0,,♪ Uzansam biraz daha erişeceğim hemen cevaba. ♪Dialogue: 0,0:00:30.73,0:00:38.37,Hands Up lyrics,,0,0,0,,♪ İnanarak buna açılıyorum yeni dünyaya. ♪Dialogue: 0,0:00:38.40,0:00:45.86,Hands Up lyrics,,0,0,0,,♪ Aynen öyle, yapboz gibi birleşti hayal kırıntılarımız. ♪Dialogue: 0,0:00:45.91,0:00:50.41,Hands Up lyrics,,0,0,0,,♪ Aramızda hiç kopmayacak bağlar yaratarak,...Dialogue: 0,0:00:51.18,0:00:53.51,Hands Up lyrics,,0,0,0,,...daha aydınlık bir geleceğe. ♪Dialogue: 0,0:00:54.00,0:00:58.55,Hands Up lyrics,,0,0,0,,♪ Kaldır ellerini daha da yukarıya, hayallerini dök şarkılara. ♪Dialogue: 0,0:00:58.62,0:01:02.42,Hands Up lyrics,,0,0,0,,♪ Yıkılma hiçbir zaman, sarsılmaz bayrağını kaldır göklere. ♪Dialogue: 0,0:01:02.43,0:01:05.78,Hands Up lyrics,,0,0,0,,♪ Buralara kadar gelebilmek için pek çok duvarı yıkıp geçtik! ♪Dialogue: 0,0:01:05.83,0:01:09.80,Hands Up lyrics,,0,0,0,,♪ Hedefimiz gelecek! ♪Dialogue: 0,0:01:09.87,0:01:11.30,Hands Up lyrics,,0,0,0,,♪ Daha da yukarıya bak! ♪Dialogue: 0,0:01:11.34,0:01:13.48,Hands Up lyrics,,0,0,0,,♪ Sırtın hep dik olsun! ♪Dialogue: 0,0:01:13.53,0:01:14.94,Hands Up lyrics,,0,0,0,,♪ Bir an olsun durma! ♪Dialogue: 0,0:01:14.99,0:01:16.82,Hands Up lyrics,,0,0,0,,♪ Dalgaları aşa aşa! ♪Dialogue: 0,0:01:16.86,0:01:20.41,Hands Up lyrics,,0,0,0,,♪ Arzularımız birleşiyor yavaşça. ♪Dialogue: 0,0:01:20.44,0:01:24.65,Hands Up lyrics,,0,0,0,,♪ Haydi ilerisini hedef seçelim kendimize! ♪Dialogue: 0,0:01:24.91,0:01:31.06,Hands Up lyrics,,0,0,0,,♪ Dalgaları sürerek, akıyoruz ileriye. ♪Dialogue: 0,0:01:31.09,0:01:35.34,Hands Up lyrics,,0,0,0,,♪ İnsanlarla tanışıyor, elvedalar ediyoruz,...Dialogue: 0,0:01:35.36,0:01:39.09,Hands Up lyrics,,0,0,0,,...bir kez daha bu bayrağın altında. ♪Dialogue: 0,0:01:41.26,0:01:45.04,Hands Up lyrics,,0,0,0,,♪ Unutmak istemediğim acıları...Dialogue: 0,0:01:45.06,0:01:48.08,Hands Up lyrics,,0,0,0,,...o gün yüreğime gömdüm, saklıyorum orada. ♪Dialogue: 0,0:01:48.27,0:01:52.34,Hands Up lyrics,,0,0,0,,♪ Kimselere yenilmeyecek bir özgürlük bizimkisi,...Dialogue: 0,0:01:52.46,0:01:54.75,Hands Up lyrics,,0,0,0,,...sıkıca kavrayıp yoluma atıldığım. ♪Dialogue: 0,0:01:54.77,0:01:59.69,Hands Up lyrics,,0,0,0,,♪ Kaldır ellerini daha da yukarıya, hayallerini dök şarkılara. ♪Dialogue: 0,0:01:59.72,0:02:03.37,Hands Up lyrics,,0,0,0,,♪ Yıkılma hiçbir zaman, sarsılmaz bayrağını kaldır göklere. ♪Dialogue: 0,0:02:03.41,0:02:06.66,Hands Up lyrics,,0,0,0,,♪ Buralara kadar gelebilmek için pek çok duvarı yıkıp geçtik! ♪Dialogue: 0,0:02:06.69,0:02:10.83,Hands Up lyrics,,0,0,0,,♪ Hedefimiz gelecek! ♪Dialogue: 0,0:02:10.88,0:02:12.20,Hands Up lyrics,,0,0,0,,♪ Daha da yukarıya bak! ♪Dialogue: 0,0:02:12.25,0:02:14.53,Hands Up lyrics,,0,0,0,,♪ Sırtın hep dik olsun! ♪Dialogue: 0,0:02:14.53,0:02:15.90,Hands Up lyrics,,0,0,0,,♪ Bir an olsun durma! ♪Dialogue: 0,0:02:15.95,0:02:17.72,Hands Up lyrics,,0,0,0,,♪ Dalgaları aşa aşa! ♪Dialogue: 0,0:02:17.76,0:02:21.43,Hands Up lyrics,,0,0,0,,♪ Arzularımız birleşiyor yavaşça. ♪Dialogue: 0,0:02:21.50,0:02:24.97,Hands Up lyrics,,0,0,0,,♪ Haydi ilerisini hedef seçelim kendimize! ♪Dialogue: 0,0:02:24.99,0:02:29.89,Hands Up lyrics,,0,0,0,,♪ Eller havaya!! ♪