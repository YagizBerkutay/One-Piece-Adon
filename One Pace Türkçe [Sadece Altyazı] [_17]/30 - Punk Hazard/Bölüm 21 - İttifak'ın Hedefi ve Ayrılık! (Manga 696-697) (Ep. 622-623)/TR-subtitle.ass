Dialogue: 0,0:02:29.76,0:02:34.07,Title,Title,0,0,0,,{\fad(2000,0)}İttifak'ın Hedefi ve Ayrılık!
Dialogue: 0,0:02:36.25,0:02:38.08,Main,Marine,0,0,0,,Duydunuz mu beni,\Nkorsan bozuntuları sizi!
Dialogue: 0,0:02:38.08,0:02:40.75,Main,Marine,0,0,0,,Tanker sizin!
Dialogue: 0,0:02:41.17,0:02:43.81,Main,Marine,0,0,0,,Bu da iyiyle kötüyü ayıran çizgi!
Dialogue: 0,0:02:43.98,0:02:46.69,Main,Marine,0,0,0,,Sakın bu tarafa geleyim demeyin!
Dialogue: 0,0:02:46.69,0:02:48.93,Main,Marine,0,0,0,,Anladınız mı, Hasır Şapka tayfası?!
Dialogue: 0,0:02:52.65,0:02:55.48,Main,Smoker,0,0,0,,Böyle çocukça şeyler yapmanızı\Nkim istedi sizden?
Dialogue: 0,0:02:56.53,0:02:59.96,Main,Smoker,0,0,0,,Size korsanlarla içli dışlı olmayın\Ndedim sadece.
Dialogue: 0,0:02:59.96,0:03:03.51,Main,Marine,0,0,0,,Bir iş yapacaksak elimizden gelen en iyi şekilde yapmamız lazım değil mi ama Koramiral Smo!?
Dialogue: 0,0:03:03.51,0:03:06.23,Main,Marine,0,0,0,,Tabii bu durum sıhhiye için geçerli değil!
Dialogue: 0,0:03:06.58,0:03:09.23,Main,Smoker,0,0,0,,G-5 karargâhıyla bağlantıya geçtim.
Dialogue: 0,0:03:09.23,0:03:11.80,Main,Smoker,0,0,0,,Bizi buradan alacaklar!
Dialogue: 0,0:03:11.80,0:03:13.07,Main,Marines,0,0,0,,Emredersiniz!
Dialogue: 0,0:03:13.65,0:03:17.48,Main,Luffy,0,0,0,,Ne?!\NTeslim mi olacaksın Kahverengisakal?!
Dialogue: 0,0:03:17.66,0:03:20.01,Main,Luffy,0,0,0,,Tam da dost olduk derken.
Dialogue: 0,0:03:22.23,0:03:26.22,Main,Brownbeard,0,0,0,,Görünüşe bakılırsa bizim üzerimizde de\Nzehir deneyleri yapılmış.
Dialogue: 0,0:03:26.22,0:03:29.59,Main,Brownbeard,0,0,0,,Teslim olursam\Nbeni tedavi edeceklerini söylediler.
Dialogue: 0,0:03:29.59,0:03:31.39,Main,Luffy,0,0,0,,Anlıyorum.
Dialogue: 0,0:03:31.39,0:03:33.23,Main,Marine,0,0,0,,Lan, lan Hasır Şapka!
Dialogue: 0,0:03:33.23,0:03:36.14,Main,Marine,0,0,0,,Daha az önce çizgiyi geçme dedik!
Dialogue: 0,0:03:36.14,0:03:37.51,Main,Marine,0,0,0,,Duymuyor musun?!
Dialogue: 0,0:03:37.51,0:03:38.94,Main,Luffy,0,0,0,,Yesinler çizginizi!
Dialogue: 0,0:03:38.94,0:03:40.53,Main,Luffy,0,0,0,,Kendi kafanızdan uydurduğunuz bir şey o!
Dialogue: 0,0:03:41.11,0:03:47.27,Main,Brownbeard,0,0,0,,Sonuçta Caesar'ın bize istediğini yapmasına izin vermektense hapishane yeğdir.
Dialogue: 0,0:03:47.27,0:03:49.99,Main,Brownbeard,0,0,0,,Zaten adamlarım da yok artık...
Dialogue: 0,0:03:49.99,0:03:53.25,Main,Brownbeard,0,0,0,,Caesar'ı patakladığını görmek çok hoştu!
Dialogue: 0,0:03:53.68,0:03:55.48,Main,Brownbeard,0,0,0,,Teşekkür ederim!
Dialogue: 0,0:03:55.48,0:03:57.55,Main,Franky,0,0,0,,Haydi bakalım!
Dialogue: 0,0:04:00.10,0:04:01.59,Main,Usopp,0,0,0,,Çekin!
Dialogue: 0,0:04:01.59,0:04:05.09,Main,Franky,0,0,0,,Cidden yani! Madem bu tankeri kullanacaktık\Nneden daha önce söylemediniz?!
Dialogue: 0,0:04:05.09,0:04:09.72,Main,Franky,0,0,0,,Sonra onarmam gerekeceğini bilsem\Nkalkıp da burada dövüşmezdim!
Dialogue: 0,0:04:16.79,0:04:17.97,Main,Franky,0,0,0,,Bu gürültü de nesi?!
Dialogue: 0,0:04:17.97,0:04:19.04,Main,Franky,0,0,0,,Ne oldu?
Dialogue: 0,0:04:19.89,0:04:21.27,Main,Chopper,0,0,0,,Luffy!
Dialogue: 0,0:04:21.87,0:04:24.19,Main,Chopper,0,0,0,,Durdur şunu!
Dialogue: 0,0:04:24.19,0:04:28.35,Main,Chopper,0,0,0,,Adam öldürüyorlar!
Dialogue: 0,0:04:28.98,0:04:30.55,Main,Brook,0,0,0,,Adam mı öldürüyorlar?!
Dialogue: 0,0:04:31.72,0:04:34.17,Main,Luffy,0,0,0,,Kimmiş o adam öldüren?
Dialogue: 0,0:04:34.17,0:04:35.32,Main,Chopper,0,0,0,,Law!
Dialogue: 0,0:04:35.64,0:04:36.89,Main,Luffy,0,0,0,,Trao mu?
Dialogue: 0,0:04:38.79,0:04:40.39,Main,Luffy,0,0,0,,Size ne oluyor?
Dialogue: 0,0:04:40.84,0:04:43.15,Main,Brook,0,0,0,,Be-Ben de birini öldürdüm!
Dialogue: 0,0:04:43.15,0:04:46.56,Main,Brook,0,0,0,,Yani Kin'emon-san zaten ölüydü ama...
Dialogue: 0,0:04:47.55,0:04:49.53,Main,Brook,0,0,0,,...üstüne bir de kırıldı!
Dialogue: 0,0:04:51.50,0:04:53.51,Main,Sanji,0,0,0,,Ölüydü\Nbir de paramparça mı oldu şimdi?!
Dialogue: 0,0:04:53.51,0:04:54.40,Main,Luffy,0,0,0,,Ölü ve paramparça mı?!
Dialogue: 0,0:04:54.40,0:04:56.80,Main,Brook,0,0,0,,Ne yapayım şimdi ben?!
Dialogue: 0,0:04:56.80,0:04:58.28,Main,Luffy,0,0,0,,Yapıştırsak falan olur mu ki öyle?!
Dialogue: 0,0:04:58.28,0:05:00.91,Main,Sanji,0,0,0,,Aptal mısın be! Olur mu öyle?!
Dialogue: 0,0:05:01.56,0:05:03.06,Main,Kin'emon,0,0,0,,Momonosuke!
Dialogue: 0,0:05:04.63,0:05:06.72,Main,Sanji,0,0,0,,Neden hayattasın sen be?!
Dialogue: 0,0:05:07.78,0:05:09.92,Main,Brook,0,0,0,,Ne yapıyorsunuz siz yahu, Sanji-san!?
Dialogue: 0,0:05:09.92,0:05:11.36,Main,Sanji,0,0,0,,Ne bileyim ben be!
Dialogue: 0,0:05:11.36,0:05:13.79,Main,Sanji,0,0,0,,Adam öldü dedin\Nbal gibi de yaşıyormuş!
Dialogue: 0,0:05:13.79,0:05:15.64,Main,Marine,0,0,0,,Hey, şuna bakın!
Dialogue: 0,0:05:15.64,0:05:18.03,Main,Marine,0,0,0,,Gaz tarafından öldürüldü\Ndiye bildiğimiz adam yaşıyormuş!
Dialogue: 0,0:05:20.00,0:05:24.77,Main,Brook,0,0,0,,Şükürler olsun Kin'emon-san!\NBen sizin...
Dialogue: 0,0:05:24.77,0:05:26.20,Main,Momonosuke,0,0,0,,Baba!
Dialogue: 0,0:05:27.43,0:05:30.58,Main,Kin'emon,0,0,0,,Mo-Momonosuke?
Dialogue: 0,0:05:31.76,0:05:34.13,Main,Momonosuke,0,0,0,,Baba!
Dialogue: 0,0:05:34.13,0:05:36.40,Main,Kin'emon,0,0,0,,Momonosuke!
Dialogue: 0,0:05:40.74,0:05:43.19,Main,Kin'emon,0,0,0,,Yaşıyorsun demek?!
Dialogue: 0,0:05:43.19,0:05:44.92,Main,Momonosuke,0,0,0,,B-Baba!
Dialogue: 0,0:05:47.96,0:05:49.18,Main,Luffy,0,0,0,,Momonosuke mi?
Dialogue: 0,0:05:49.78,0:05:53.04,Main,Luffy,0,0,0,,Sahi ya,\Neskiden insan olduğundan bahsetmişti.
Dialogue: 0,0:05:53.88,0:05:56.08,Main,Kin'emon,0,0,0,,Çıplaksın!
Dialogue: 0,0:05:59.57,0:06:00.54,Main,Kin'emon,0,0,0,,{\fad(150,150)}Doron!
Dialogue: 0,0:05:59.57,0:06:00.54,Note,Kin'emon,0,0,0,,{\fad(150,150)}Dönüşüm
Dialogue: 0,0:06:04.79,0:06:08.78,Captions,Caption,0,0,180,,{\fad(550,0)}Wano Ülkesinin Çocuğu (Kin'emon'un Oğlu) Momonosuke
Dialogue: 0,0:06:06.66,0:06:08.78,Main,Kin'emon,0,0,0,,{\an8}İşte Wano Krallığı'nın çocuğuna\Nyakışır bir giysi bu!
Dialogue: 0,0:06:08.78,0:06:10.84,Main,Kin'emon,0,0,0,,Kimono sana yakışıyor!
Dialogue: 0,0:06:12.31,0:06:14.99,Main,Momonosuke,0,0,0,,Fakat baba\Nburada olduğumu nasıl bild--
Dialogue: 0,0:06:19.25,0:06:20.26,Main,Kin'emon,0,0,0,,Momonosuke!
Dialogue: 0,0:06:20.74,0:06:21.63,Main,Chopper,0,0,0,,Law!
Dialogue: 0,0:06:21.63,0:06:23.59,Main,Chopper,0,0,0,,Çık ortaya, Law!
Dialogue: 0,0:06:24.50,0:06:25.81,Main,Chopper,0,0,0,,Sen...
Dialogue: 0,0:06:25.81,0:06:28.08,Main,Chopper,0,0,0,,Çocuklara ne yaptın?!
Dialogue: 0,0:06:28.08,0:06:30.40,Main,Chopper,0,0,0,,Onlara herhangi bir şekilde\Nzarar verecek olursan...
Dialogue: 0,0:06:30.99,0:06:35.91,Main,Law,0,0,0,,O yüzden içeri bakma dedim sana. \NO çocukları...
Dialogue: 0,0:06:36.17,0:06:37.57,Main,Law,0,0,0,,...kestim.
Dialogue: 0,0:06:38.14,0:06:42.71,Main,Law,0,0,0,,Uyuşturucu yüzünden. Hâlâ uzun ve acı verici bir tedaviden geçmeleri gerekiyor.
Dialogue: 0,0:06:44.12,0:06:45.55,Main,Child,0,0,0,,Rakun-chan!
Dialogue: 0,0:06:45.55,0:06:46.82,Main,Sind,0,0,0,,Rakun-kun!
Dialogue: 0,0:06:46.82,0:06:48.81,Main,Chopper,0,0,0,,Herkes iyi mi?!
Dialogue: 0,0:06:50.32,0:06:53.13,Main,Konbu,0,0,0,,Kürk kafalı abi...
Dialogue: 0,0:06:53.13,0:06:56.43,Main,Biyo,0,0,0,,Vücutlarımızdaki kötü kısımları\Nkesip attı!
Dialogue: 0,0:06:56.43,0:06:58.13,Main,Chopper,0,0,0,,Ne?!
Dialogue: 0,0:06:58.13,0:07:00.74,Main,Doran,0,0,0,,Çok korkmuştum ama\Nşimdi çok iyi hissediyorum!
Dialogue: 0,0:07:00.74,0:07:03.75,Main,Sind,0,0,0,,Böyle paramparça falan olduk,\Nçok eğlenceliydi!
Dialogue: 0,0:07:03.75,0:07:05.49,Main,Konbu,0,0,0,,Acıktım ben!
Dialogue: 0,0:07:06.02,0:07:07.61,Main,Chopper,0,0,0,,Anlıyorum.
Dialogue: 0,0:07:07.61,0:07:10.58,Main,Child,0,0,0,,Mocha hâlâ uyanmadı.
Dialogue: 0,0:07:10.58,0:07:13.98,Main,Child,0,0,0,,Bizim için savaştı o!
Dialogue: 0,0:07:13.98,0:07:17.78,Main,Child,0,0,0,,Master'ın öyle kötü biri olduğunu\Nbilmiyordum.
Dialogue: 0,0:07:17.78,0:07:22.42,Main,Child,0,0,0,,Pek net değil ama Mocha'nın kan kusup yere yığıldığını hatırlıyorum.
Dialogue: 0,0:07:22.42,0:07:23.73,Main,Child,0,0,0,,Baksana, Rakun-kun...
Dialogue: 0,0:07:23.73,0:07:25.04,Main,Chopper,0,0,0,,Geyiğim ben gerçi ama...
Dialogue: 0,0:07:25.04,0:07:26.83,Main,Child,0,0,0,,Mocha iyileşecek değil mi?
Dialogue: 0,0:07:27.14,0:07:30.46,Main,Child,0,0,0,,Onunla birlikte evlerimize dönebileceğiz\Ndeğil mi, Rakun-kun?!
Dialogue: 0,0:07:30.46,0:07:32.16,Main,Chopper,0,0,0,,Elbette!
Dialogue: 0,0:07:32.16,0:07:35.23,Main,Chopper,0,0,0,,Bu kabus gibi dünyadan uzaklaşacağız!
Dialogue: 0,0:07:35.89,0:07:38.00,Main,Child,0,0,0,,Turuncu saçlı abla nereye gitti?
Dialogue: 0,0:07:38.00,0:07:40.57,Main,Child,0,0,0,,Bizi evlerimize götüreceğini söylemişti.
Dialogue: 0,0:07:40.57,0:07:44.03,Main,Child,0,0,0,,Ona teşekkür etmek istiyoruz!
Dialogue: 0,0:07:44.93,0:07:47.13,Flashbacks,Nami,0,0,0,,Bu çocuklara yardım edelim!
Dialogue: 0,0:07:47.80,0:07:54.22,Flashbacks,Nami,0,0,0,,Gözyaşları içinde yardım dileyen çocuklara\Nnasıl sırt çevirebiliz?!
Dialogue: 0,0:07:54.22,0:07:55.39,Main,Tashigi,0,0,0,,Merhabalar!
Dialogue: 0,0:07:57.63,0:08:02.16,Main,Tashigi,0,0,0,,Bundan sonra sizinle\NDonanma olarak biz ilgileneceğiz!
Dialogue: 0,0:08:03.21,0:08:05.03,Main,Children,0,0,0,,Ne?! İstemeyiz!
Dialogue: 0,0:08:05.31,0:08:06.46,Main,Sind,0,0,0,,Robot'a ne olacak?!
Dialogue: 0,0:08:06.46,0:08:07.73,Main,Konbu,0,0,0,,Lastik adama?
Dialogue: 0,0:08:07.73,0:08:09.12,Main,Doran,0,0,0,,Kıvırcık kaşlı abiye?
Dialogue: 0,0:08:10.94,0:08:12.74,Main,Usopp,0,0,0,,Dehşet güzel koktu!
Dialogue: 0,0:08:12.74,0:08:14.71,Main,Usopp,0,0,0,,Sanji ne pişiriyor acaba?!
Dialogue: 0,0:08:14.71,0:08:16.56,Main,Usopp,0,0,0,,Hemen pişse de görsek!
Dialogue: 0,0:08:18.18,0:08:19.01,Main,Usopp,0,0,0,,Nami?
Dialogue: 0,0:08:22.56,0:08:24.96,Main,Usopp,0,0,0,,Donanma'yla anlaşabildin mi?
Dialogue: 0,0:08:24.96,0:08:26.28,Main,Nami,0,0,0,,Evet.
Dialogue: 0,0:08:26.88,0:08:29.60,Main,Nami,0,0,0,,Çocukları onlara bırakacağım.
Dialogue: 0,0:08:29.60,0:08:31.61,Main,Nami,0,0,0,,Her ne kadar kendimi bu işe adasam da...
Dialogue: 0,0:08:31.61,0:08:35.29,Main,Nami,0,0,0,,...sonuçta korsanız,\Nçocuklar için sıkıntılı olabilir bu durum.
Dialogue: 0,0:08:36.98,0:08:42.25,Main,Usopp,0,0,0,,Muhtemelen her zaman olduğu gibi\Nonları kaçırmışız gibi düşünürler.
Dialogue: 0,0:08:42.25,0:08:44.63,Main,Usopp,0,0,0,,Adaletin kollarında\Ndaha güvende olacaklardır.
Dialogue: 0,0:08:44.63,0:08:45.59,Main,Nami,0,0,0,,Doğru dedin.
Dialogue: 0,0:08:46.49,0:08:48.09,Main,Nami,0,0,0,,Ayrıca...
Dialogue: 0,0:08:48.77,0:08:53.95,Flashbacks,Tashigi,0,0,0,,Yalvarıyorum...\NÇocuklarla ilgilenmeme izin verin!
Dialogue: 0,0:08:54.72,0:08:59.28,Main,Nami,0,0,0,,...kadın Donanma erlerine karşı\Nzaafım var.
Dialogue: 0,0:08:59.28,0:09:00.65,Main,Usopp,0,0,0,,Kadın Donanma erleri mi?
Dialogue: 0,0:09:01.70,0:09:02.85,Main,Nami,0,0,0,,Evet.
Dialogue: 0,0:09:03.80,0:09:05.15,Main,Nami,0,0,0,,Bana güven veriyorlar.
Dialogue: 0,0:09:05.66,0:09:10.62,Main,Usopp,0,0,0,,Sahi ya!\NAnnen de Donanma eriydi değil mi?
Dialogue: 0,0:09:11.38,0:09:15.82,Main,Nami,0,0,0,,İş birilerini kurtarmaksa güçlü ve yumuşak kalpli kadın erlere her daim güvenebilirsin!
Dialogue: 0,0:09:17.13,0:09:18.25,Main,Usopp,0,0,0,,Doğru dedin!
Dialogue: 0,0:09:18.25,0:09:19.46,Main,Nami,0,0,0,,Senin bu konuda söz hakkın yok!
Dialogue: 0,0:09:22.40,0:09:24.53,Main,Usopp,0,0,0,,Kendin dedin be.
Dialogue: 0,0:09:24.53,0:09:30.11,Main,Sanji,0,0,0,,{\fad(150,150)}New Kama Kempo Ougi, 99 Hayati Tarife!
Dialogue: 0,0:09:30.11,0:09:33.50,Main,Sanji,0,0,0,,Üşümüz ve yorgun bedenlerinize güç katacak!
Dialogue: 0,0:09:35.21,0:09:38.07,Main,Sanji,0,0,0,,Deniz mahsüllü hormon çorbası!
Dialogue: 0,0:09:38.07,0:09:40.21,Main,Sanji,0,0,0,,Günlerdir bir şey yemediğinizi düşünürsek...
Dialogue: 0,0:09:40.93,0:09:43.44,Main,Sanji,0,0,0,,...işe çorbayla başlayıp\Nsindire sindire yiyin derim.
Dialogue: 0,0:09:44.81,0:09:46.13,Main,Luffy,0,0,0,,Leziz görünüyor!
Dialogue: 0,0:09:51.66,0:09:53.36,Main,Luffy,0,0,0,,Sen de çok açsın değil mi?
Dialogue: 0,0:09:53.36,0:09:56.59,Main,Luffy,0,0,0,,Momo, Sanji'nin aşçılığının eşi yoktur!
Dialogue: 0,0:09:59.96,0:10:01.46,Main,Momonosuke,0,0,0,,İstemiyorum!
Dialogue: 0,0:10:01.46,0:10:03.86,Main,Momonosuke,0,0,0,,Karnım falan aç değil benim!
Dialogue: 0,0:10:03.86,0:10:05.67,Main,Sanji,0,0,0,,Hey, bekle velet!
Dialogue: 0,0:10:05.67,0:10:07.72,Main,Sanji,0,0,0,,Öyle havaya kaldırdın da\Nne yapacaksın o kaseye?!
Dialogue: 0,0:10:07.72,0:10:11.71,Main,Sanji,0,0,0,,Yemeği ziyan edecek olursan\Nçocuk mocuk dinlemem bak!
Dialogue: 0,0:10:11.71,0:10:13.11,Main,Kin'emon,0,0,0,,Ellerinize sağlık!
Dialogue: 0,0:10:17.41,0:10:18.28,Main,Sanji,0,0,0,,H-Hey.
Dialogue: 0,0:10:18.28,0:10:19.16,Main,Kin'emon,0,0,0,,Leziz!
Dialogue: 0,0:10:19.56,0:10:20.52,Main,Kin'emon,0,0,0,,Bu da nesi?!
Dialogue: 0,0:10:20.52,0:10:22.57,Main,Kin'emon,0,0,0,,Gücüm geri geliyor!
Dialogue: 0,0:10:22.96,0:10:25.86,Main,Kin'emon,0,0,0,,Ne leziz bir yemektir bu böyle!
Dialogue: 0,0:10:25.86,0:10:26.52,Main,Kin'emon,0,0,0,,Leziz!
Dialogue: 0,0:10:26.52,0:10:27.71,Main,Momonosuke,0,0,0,,Baba...
Dialogue: 0,0:10:28.86,0:10:31.78,Main,Kin'emon,0,0,0,,Bu iyiliği elimizin tersiyle itmeyelim!
Dialogue: 0,0:10:32.63,0:10:36.48,Main,Kin'emon,0,0,0,,Ayrıca benim hayatımı da kurtardılar!
Dialogue: 0,0:10:37.67,0:10:40.34,Main,Kin'emon,0,0,0,,Onlara güvenebilirsin!
Dialogue: 0,0:10:40.34,0:10:44.96,Main,Kin'emon,0,0,0,,Bugüne dek\Nhiçbir şey yemedin demek!?
Dialogue: 0,0:10:44.96,0:10:46.18,Main,Kin'emon,0,0,0,,Oğlum benim!
Dialogue: 0,0:10:47.46,0:10:48.63,Main,Kin'emon,0,0,0,,Çok zorlu günler geçirmişsin!
Dialogue: 0,0:10:50.93,0:10:54.80,Main,Kin'emon,0,0,0,,Fakat artık her şey yolunda!
Dialogue: 0,0:10:55.92,0:10:59.27,Main,Kin'emon,0,0,0,,Diğerlerinin de iyiliğini umalım!
Dialogue: 0,0:11:00.41,0:11:05.91,Main,Kin'emon,0,0,0,,Haydi yaşamaya devam, Momonosuke!
Dialogue: 0,0:11:07.79,0:11:08.78,Main,Momonosuke,0,0,0,,Tamam.
Dialogue: 0,0:11:18.42,0:11:21.64,Main,Luffy,0,0,0,,Ne o? Göz yaşartacak kadar mı\Nleziz olmuş yemekler?!
Dialogue: 0,0:11:21.64,0:11:24.65,Main,Sanji,0,0,0,,Aptal! Başlarından \Nciddi bir şeyler geçmiş anlaşılan.
Dialogue: 0,0:11:24.65,0:11:26.26,Main,Sanji,0,0,0,,Acaba ne olmuş bunlara?
Dialogue: 0,0:11:28.05,0:11:28.47,Main,Brook,0,0,0,,İlginç?
Dialogue: 0,0:11:31.95,0:11:35.96,Main,Sanji,0,0,0,,Sizi var ya...\Nİyiyle kötü arasındaki çizgiye ne oldu!?
Dialogue: 0,0:11:35.96,0:11:37.82,Main,Marines,0,0,0,,Ateşkes ilan ettik, abi!
Dialogue: 0,0:11:39.14,0:11:42.39,Main,Zoro,0,0,0,,Madem öyle hadi bir koşu\Ntankerden sake getirin.
Dialogue: 0,0:11:42.39,0:11:43.25,Main,Marine,0,0,0,,Zevkle!
Dialogue: 0,0:11:43.25,0:11:44.22,Main,Child,0,0,0,,Meyve suyu da getirin!
Dialogue: 0,0:11:44.62,0:11:46.05,Main,Law,0,0,0,,Bak bana, Hasır Şapka-ya!
Dialogue: 0,0:11:46.39,0:11:48.74,Main,Law,0,0,0,,Buradan derhal ayrılmamız lazım.
Dialogue: 0,0:11:48.74,0:11:51.90,Main,Law,0,0,0,,Burada yayıla yayıla yemek yiyecek vaktimiz yok, peşimizden gelen var.
Dialogue: 0,0:11:51.90,0:11:53.24,Main,Luffy,0,0,0,,Gerçekten mi?!
Dialogue: 0,0:11:53.24,0:11:55.21,Main,Law,0,0,0,,Adamlarına söyle.
Dialogue: 0,0:11:55.21,0:11:56.48,Main,Luffy,0,0,0,,Tamamdır.
Dialogue: 0,0:11:57.60,0:12:00.48,Main,Luffy,0,0,0,,Ziyafet başlasın!
Dialogue: 0,0:12:05.10,0:12:06.67,Main,Zoro/Luffy/Usopp,0,0,0,,Şerefe!
Dialogue: 0,0:12:08.74,0:12:09.77,Main,Momonosuke,0,0,0,,Baba.
Dialogue: 0,0:12:11.10,0:12:14.21,Main,Momonosuke,0,0,0,,Savaşçılar gözyaşlarını\Nkimselere göstermemeli!
Dialogue: 0,0:12:17.46,0:12:19.28,Main,Momonosuke,0,0,0,,Ne oldu yahu, Luffy?
Dialogue: 0,0:12:21.92,0:12:23.50,Main,Marine,0,0,0,,Şerefe abi!
Dialogue: 0,0:12:26.78,0:12:28.30,Main,Usopp,0,0,0,,Bakın şimdi...
Dialogue: 0,0:12:28.30,0:12:31.25,Main,Usopp,0,0,0,,Bir, iki, üç...
Dialogue: 0,0:12:33.66,0:12:34.41,Main,Child,0,0,0,,Buyrun.
Dialogue: 0,0:12:34.41,0:12:35.43,Main,Tashigi,0,0,0,,Teşekkür ederim!
Dialogue: 0,0:12:44.07,0:12:45.67,Main,Chopper,0,0,0,,Mocha!
Dialogue: 0,0:12:53.40,0:12:55.52,Main,Marine,0,0,0,,Koramiral Smo-yan!
Dialogue: 0,0:12:57.05,0:13:00.04,Main,Marine,0,0,0,,Adaya geri dönüyoruz!
Dialogue: 0,0:13:00.04,0:13:00.99,Main,Smoker,0,0,0,,Ne oldu?!
Dialogue: 0,0:13:00.99,0:13:04.22,Main,Marine,0,0,0,,Caesar bize zehirli gazın zaafını söyledi!
Dialogue: 0,0:13:04.22,0:13:08.15,Main,Marine,0,0,0,,Dostlarımız hâlâ yaşıyorlar!\NOnları kurtarabiliriz!
Dialogue: 0,0:13:08.15,0:13:12.57,Main,Caesar,0,0,0,,Smoker neden hâlâ hayatta?!
Dialogue: 0,0:13:18.54,0:13:20.28,Main,Smoker,0,0,0,,Law...
Dialogue: 0,0:13:20.28,0:13:26.12,Main,Smoker,0,0,0,,Senin gibi bir korsana olan sözümü\Ntutmayacağımı düşündüğünü biliyorum.
Dialogue: 0,0:13:26.45,0:13:31.26,Main,Smoker,0,0,0,,Fakat beni kesmek isteseydin\Nbunu gerçekleştirebileceğin pek çok fırsatın vardı.
Dialogue: 0,0:13:32.81,0:13:36.26,Main,Smoker,0,0,0,,Hasır Şapkalar'ı da kullanarak\Nne yapmaya çalışıyorsun?
Dialogue: 0,0:13:36.26,0:13:38.01,Main,Law,0,0,0,,Onları kullanıyorum demek?
Dialogue: 0,0:13:38.01,0:13:40.95,Main,Law,0,0,0,,Kim kimi kullanıyor acaba?
Dialogue: 0,0:13:41.60,0:13:44.78,Flashbacks,Luffy,0,0,0,,Hangi Yonko'dan bahsediyorsun?
Dialogue: 0,0:13:44.78,0:13:46.85,Flashbacks,Law,0,0,0,,Bahsettiğim kişinin adı...
Dialogue: 0,0:13:47.29,0:13:49.91,Flashbacks,Law,0,0,0,,...Canavarlar Kralı Kaido!
Dialogue: 0,0:13:51.53,0:13:54.91,Flashbacks,Luffy,0,0,0,,İlk karşımıza alacağımız kişi\NShanks olmadıkça bana uyar.
Dialogue: 0,0:13:55.83,0:14:00.08,Flashbacks,Luffy,0,0,0,,Çünkü, tüm Yonko'yu\Nyenmeyi planlıyorum ben!
Dialogue: 0,0:14:00.85,0:14:03.50,Flashbacks,Law,0,0,0,,Tüm Yonko'yu\Nyenmeyi mi planlıyorsun?
Dialogue: 0,0:14:03.50,0:14:06.39,Flashbacks,Law,0,0,0,,Amaçlarımız her ne kadar aynı olsa da\Nonları çok hafife alıyorsun.
Dialogue: 0,0:14:07.06,0:14:13.12,Flashbacks,Law,0,0,0,,Beyazsakal'a bile bölgelerini genişletmek için kafa tutmuş denizin imparatorlarından bahsediyoruz.
Dialogue: 0,0:14:13.12,0:14:19.37,Flashbacks,Law,0,0,0,,Hepsinden öte Canavarların Kralı dedikleri Kaido bu dünyadaki en güçlü yaratık olarak anılıyor.
Dialogue: 0,0:14:19.37,0:14:21.91,Flashbacks,Nami,0,0,0,,Ne? Nasıl yani?\Nİnsan bile değil mi?
Dialogue: 0,0:14:23.71,0:14:27.86,Flashbacks,Law,0,0,0,,İttifakımız Kaido'yu öldürene değin sürecek.
Dialogue: 0,0:14:27.86,0:14:30.31,Flashbacks,Law,0,0,0,,Ve başarı şansımız da...
Dialogue: 0,0:14:30.31,0:14:33.60,Flashbacks,Law,0,0,0,,Ben çok az diyeyim,\Ngerisini siz düşünün.
Dialogue: 0,0:14:33.60,0:14:34.80,Flashbacks,Nami,0,0,0,,Bu ne şimdi ya?!
Dialogue: 0,0:14:34.80,0:14:37.12,Flashbacks,Nami,0,0,0,,Böyle bir şeyi kabul edemeyiz, Luffy!
Dialogue: 0,0:14:37.34,0:14:38.62,Flashbacks,Luffy,0,0,0,,Anlıyorum.
Dialogue: 0,0:14:39.99,0:14:41.98,Flashbacks,Luffy,0,0,0,,İyi madem, yapalım!
Dialogue: 0,0:14:44.14,0:14:47.08,Flashbacks,Nami,0,0,0,,Dur biraz ya!
Dialogue: 0,0:14:49.09,0:14:54.11,Main,Law,0,0,0,,Seni öldürmememin\Nözel bir nedeni yok, Beyaz Avcı-ya.
Dialogue: 0,0:14:54.11,0:15:00.01,Main,Law,0,0,0,,O değil de\NGreen Bit'e gitmeyi planlıyorum.
Dialogue: 0,0:15:00.01,0:15:04.90,Main,Law,0,0,0,,Acaba Hasır Şapka tayfasını\Nidare edebilecek miyim?
Dialogue: 0,0:15:07.92,0:15:09.51,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:15:09.64,0:15:10.86,Main,,0,0,0,,{\fad(150,150)}...Büyük Yiyici!
Dialogue: 0,0:15:12.66,0:15:15.13,Main,Child,0,0,0,,Luffy abi, harikasın!
Dialogue: 0,0:15:15.55,0:15:16.45,Main,Child,0,0,0,,Uzuyor!
Dialogue: 0,0:15:16.45,0:15:17.70,Main,Child,0,0,0,,Mükemmel!
Dialogue: 0,0:15:17.70,0:15:20.20,Main,Marine,0,0,0,,Donanma'nın G-5'iyiz biz!
Dialogue: 0,0:15:31.82,0:15:34.40,Main,Smoker,0,0,0,,Tankeri siz alacaksınız sanıyordum.
Dialogue: 0,0:15:34.40,0:15:36.57,Main,Luffy,0,0,0,,Öyle olmadı çünkü...
Dialogue: 0,0:15:36.57,0:15:43.49,Main,Luffy,0,0,0,,...Nami'yle Chopper çocukları uğurlamadan\Nşuradan şuraya kıpırdamayız diye tutturdular.
Dialogue: 0,0:15:44.44,0:15:50.03,Main,Luffy,0,0,0,,Şimdi sizi gelip almalarını beklemek de\Nistemiyorum, o yüzden şunu alıp gidin siz.
Dialogue: 0,0:15:50.36,0:15:52.88,Main,Marine,0,0,0,,Gemiye çocuklar!
Dialogue: 0,0:15:52.88,0:15:55.30,Main,Marine,0,0,0,,Sizi evlerinize götüreceğiz!
Dialogue: 0,0:15:55.80,0:15:58.56,Main,Marine,0,0,0,,Lan, lan Hasır Şapka tayfası!
Dialogue: 0,0:15:58.56,0:16:00.99,Main,Marine,0,0,0,,Tanker bizimse madem...
Dialogue: 0,0:16:01.64,0:16:03.34,Main,Marine,0,0,0,,...çizgi de bu!
Dialogue: 0,0:16:03.34,0:16:05.80,Main,Marine,0,0,0,,Sakın bu tarafa geleyim demeyin!
Dialogue: 0,0:16:05.80,0:16:08.11,Main,Marine,0,0,0,,İyi ve kötüyü ayıran çizgi bu!
Dialogue: 0,0:16:08.11,0:16:10.30,Main,Marine,0,0,0,,Tamam mı?! Uzak durun!
Dialogue: 0,0:16:10.30,0:16:11.66,Main,Luffy,0,0,0,,Yine mi ya?!
Dialogue: 0,0:16:11.66,0:16:13.87,Main,Luffy,0,0,0,,Daha az önce ziyafette eğleniyorduk.
Dialogue: 0,0:16:13.87,0:16:16.30,Main,Marine,0,0,0,,Aptal!\NAptal şey seni!
Dialogue: 0,0:16:16.30,0:16:20.64,Main,Luffy,0,0,0,,O konuda gerçekten de müteşekkiriz!
Dialogue: 0,0:16:20.64,0:16:23.07,Main,Luffy,0,0,0,,Fakat korsansınız siz!
Dialogue: 0,0:16:23.07,0:16:24.50,Main,Luffy,0,0,0,,İnsanlığın yüz karaları!
Dialogue: 0,0:16:24.50,0:16:26.01,Main,Marines,0,0,0,,Haydi bakalım!
Dialogue: 0,0:16:30.77,0:16:31.97,Main,Luffy,0,0,0,,Ne? Bu da ne?
Dialogue: 0,0:16:31.97,0:16:33.80,Main,Child,0,0,0,,Nami abla!
Dialogue: 0,0:16:33.80,0:16:35.57,Main,Child,0,0,0,,Chopper-chan?
Dialogue: 0,0:16:35.57,0:16:36.68,Main,Child,0,0,0,,Robot nerede?
Dialogue: 0,0:16:36.68,0:16:39.74,Main,Child,0,0,0,,Korsan abiler nerede?
Dialogue: 0,0:16:39.74,0:16:42.75,Main,Sanji,0,0,0,,İndirin şunu be!\NSinir bozucu...
Dialogue: 0,0:16:42.75,0:16:44.00,Main,Marine,0,0,0,,Bariyer!
Dialogue: 0,0:16:44.00,0:16:46.00,Main,Marine,0,0,0,,Korsanlara bakmak bile gözlere zarar!
Dialogue: 0,0:16:46.00,0:16:49.58,Main,Franky,0,0,0,,Siz sanki bizden çok farklısınız, G-5!
Dialogue: 0,0:16:49.58,0:16:52.29,Main,Nami,0,0,0,,Fakat sağ salim gemiye bindiler.
Dialogue: 0,0:16:53.11,0:16:55.26,Main,Marine,0,0,0,,Adaletin şampiyonlarıyız biz!
Dialogue: 0,0:16:55.26,0:16:58.81,Main,Marine,0,0,0,,Halka eziyet eden korsanların\Nkökünü kazıyacağız!
Dialogue: 0,0:17:05.72,0:17:08.37,Main,Marine,0,0,0,,Korsanlar bu dünyanın\Nen adi yaratıklarıdır!
Dialogue: 0,0:17:08.37,0:17:12.59,Main,Marine,0,0,0,,Bizler de adalet olarak\Nçocukların onları görmesine engel olacağız!
Dialogue: 0,0:17:12.99,0:17:14.33,Flashbacks,Sanji,0,0,0,,Kaçın!
Dialogue: 0,0:17:14.33,0:17:16.61,Flashbacks,Sanji,0,0,0,,Ölmek istemiyorsanız kaçın!
Dialogue: 0,0:17:16.61,0:17:20.75,Main,Nami,0,0,0,,O kız şeker tedavilerinde\NVegapunk'dan yardım isteyeceğini söyledi.
Dialogue: 0,0:17:20.75,0:17:21.80,Main,Choppr,0,0,0,,Gerçekten mi?!
Dialogue: 0,0:17:21.80,0:17:22.79,Main,Choppr,0,0,0,,Şükürler olsun!
Dialogue: 0,0:17:22.79,0:17:24.92,Main,Doran,0,0,0,,Kıvırcık kaşlı abi!
Dialogue: 0,0:17:24.92,0:17:26.51,Main,Sind,0,0,0,,Donanma sizi görmemizi engelliyor!
Dialogue: 0,0:17:26.51,0:17:27.39,Main,Mocha,0,0,0,,Çekilin!
Dialogue: 0,0:17:30.70,0:17:34.07,Main,Marine,0,0,0,,Korsanlara veda etmek istiyorsanız\Nbilin ki kötü birer çocuksunuz!
Dialogue: 0,0:17:34.07,0:17:38.07,Main,Marine,0,0,0,,Teşekkür falan ederseniz\Nsizi tankerden indirir adada bırakırız!
Dialogue: 0,0:17:38.90,0:17:39.87,Main,Marine,0,0,0,,Dinleyin beni!
Dialogue: 0,0:17:39.87,0:17:43.57,Main,Marine,0,0,0,,Korsanlar kötü, Donanma ise adalettir!
Dialogue: 0,0:17:44.48,0:17:46.07,Main,Marine,0,0,0,,{\i1}Korsanları asla affetmeyeceğiz!
Dialogue: 0,0:17:46.07,0:17:47.75,Main,Marine,0,0,0,,{\i1}Korsanları affetmeyiz!
Dialogue: 0,0:17:47.75,0:17:51.32,Main,Mocha,0,0,0,,Fakat onlardan yardım istediğimizde...
Dialogue: 0,0:17:52.11,0:17:54.55,Main,Mocha,0,0,0,,...bize yardım ettiler.
Dialogue: 0,0:17:56.06,0:17:59.32,Main,Mocha,0,0,0,,Daha bize ne olduğunu\Nhiç bilmeden hem de...
Dialogue: 0,0:17:59.64,0:18:05.18,Main,Mocha,0,0,0,,...bu denli büyük olmamıza rağmen, \Nonlara engel olacağımızı bilerek yanlarına aldılar!
Dialogue: 0,0:18:05.58,0:18:07.62,Flashbacks,Mocha,0,0,0,,Eve dönmek istiyorum!
Dialogue: 0,0:18:07.62,0:18:09.16,Flashbacks,Sind,0,0,0,,Yakında döneceğiz!
Dialogue: 0,0:18:09.16,0:18:10.10,Flashbacks,Sind,0,0,0,,Biraz daha dayan!
Dialogue: 0,0:18:10.60,0:18:14.60,Main,Sind,0,0,0,,Adada ne bir damla hayat vardı\Nne de kimse yardımımıza geldi!
Dialogue: 0,0:18:14.60,0:18:15.94,Main,Doyo,0,0,0,,Onlar hariç!
Dialogue: 0,0:18:18.58,0:18:19.88,Flashbacks,Chopper,0,0,0,,Özür dilerim!
Dialogue: 0,0:18:21.46,0:18:25.48,Flashbacks,Chopper,0,0,0,,Sizi daha erken bulamadığımız için\Nözür dilerim!
Dialogue: 0,0:18:26.27,0:18:29.15,Main,Marine,0,0,0,,Korsanlar iğrenç, aşağılık yaratıklar!
Dialogue: 0,0:18:29.82,0:18:31.53,Main,Marine,0,0,0,,Donanma ise...
Dialogue: 0,0:18:31.53,0:18:34.69,Main,Doyo,0,0,0,,Eğer onlara teşekkür etmemize\Nizin vermiyorlarsa...
Dialogue: 0,0:18:36.37,0:18:38.33,Main,Doyo,0,0,0,,...öyleyse Donanma...
Dialogue: 0,0:18:38.64,0:18:40.30,Main,Tashigi,0,0,0,,Bekleyin!\NÖzür dilerim!
Dialogue: 0,0:18:40.30,0:18:42.11,Main,Marine,0,0,0,,Korsan istemeyiz!
Dialogue: 0,0:18:42.11,0:18:43.50,Main,Marine,0,0,0,,Yaşasın Donanma!
Dialogue: 0,0:18:43.50,0:18:49.52,Main,Marine,0,0,0,,Fakat öte yanda Donanma\Nçok cesur ve doğrucu{\fscx250}-{\r}
Dialogue: 0,0:18:49.52,0:18:51.79,Main,Tashigi,0,0,0,,Kesin şunu!
Dialogue: 0,0:18:51.79,0:18:54.04,Main,Tashigi,0,0,0,,Utanın be!
Dialogue: 0,0:19:00.84,0:19:06.36,Main,Marine,0,0,0,,Fakat Tashigi-chan,\NBöyle şeyler söylemezsek...
Dialogue: 0,0:19:08.26,0:19:12.85,Main,Marine,0,0,0,,...bizler de bu haydutları...
Dialogue: 0,0:19:13.28,0:19:17.75,Main,Marine,0,0,0,,...sevmeye başlayacağız!
Dialogue: 0,0:19:19.40,0:19:22.91,Main,Marine,0,0,0,,Ko-Korsan olmalarına rağmen!
Dialogue: 0,0:19:38.79,0:19:40.37,Main,Luffy,0,0,0,,Tuhaf askerler!
Dialogue: 0,0:19:41.33,0:19:44.15,Main,Doran,0,0,0,,Korsan abiler, ablalar!
Dialogue: 0,0:19:44.15,0:19:46.16,Main,Sind,0,0,0,,Bizi kurtardığınız için teşekkür ederiz!
Dialogue: 0,0:19:46.56,0:19:49.57,Main,Sind,0,0,0,,Büyüdüğümüzde kesinlikle...
Dialogue: 0,0:19:49.57,0:19:51.49,Main,Children,0,0,0,,Korsan olacağız!
Dialogue: 0,0:19:51.49,0:19:53.74,Main,Marines,0,0,0,,Olmaz!
Dialogue: 0,0:20:00.08,0:20:02.95,Main,Luffy,0,0,0,,Haydi madem, biz de gidelim.
Dialogue: 0,0:20:02.95,0:20:06.16,Main,Zoro,0,0,0,,Hey, o da mı bizimle geliyor?
Dialogue: 0,0:20:06.16,0:20:09.32,Main,Usopp,0,0,0,,Sahi ya, size ittifaktan bahsetmemiştik.
Dialogue: 0,0:20:09.32,0:20:13.42,Main,Marine,0,0,0,,Hasır Şapkalar! \NBir dahaki karşılaşmamız için hazırlıklı olun!
Dialogue: 0,0:20:13.60,0:20:15.46,Main,Marine,0,0,0,,Bir dahaki sefer düşman olacağız!
Dialogue: 0,0:20:17.95,0:20:19.27,Main,Luffy,0,0,0,,Görüşürüz!
Dialogue: 0,0:20:19.27,0:20:22.44,Main,Marine,0,0,0,,Sizi ne pahasına olursa olsun yakalayacağız!
Dialogue: 0,0:20:30.80,0:20:34.89,Main,Doflamingo,0,0,0,,Yeni yetmeler çok şanslı çıktı!
Dialogue: 0,0:20:36.39,0:20:39.49,Main,Doflamingo,0,0,0,,Gökyüzü Yolu'nun\Norada son bulduğuna inanamıyorum.
Dialogue: 0,0:20:50.73,0:20:51.77,Main,Buffalo,0,0,0,,Genç Bey'im!
Dialogue: 0,0:20:51.77,0:20:53.18,Main,Baby 5,0,0,0,,Lanet olsun ya!
Dialogue: 0,0:20:53.18,0:20:56.37,Main,Baby 5,0,0,0,,Law adisi ciddi ciddi ihanet etmiş bize!
Dialogue: 0,0:20:56.37,0:20:58.24,Main,Buffalo,0,0,0,,Bağışla-dasuyan!
Dialogue: 0,0:20:58.24,0:20:59.68,Main,Buffalo,0,0,0,,Başarısızlığım karşılığında\Ncanımı vermeye razıyım!
Dialogue: 0,0:20:59.68,0:21:04.51,Main,Baby 5,0,0,0,,Bana ihtiyacın vardı\Nama bir şey yapamadım!
Dialogue: 0,0:21:05.68,0:21:09.21,Main,Doflamingo,0,0,0,,Tankerimizdeki filikalardan biri bu.
Dialogue: 0,0:21:09.21,0:21:10.97,Main,Buffalo,0,0,0,,Çok utanıyorum-dasuyan!
Dialogue: 0,0:21:10.97,0:21:12.94,Main,Buffalo,0,0,0,,Elimizden gelen her şeyi yaptık.
Dialogue: 0,0:21:13.82,0:21:16.68,Main,Doflamingo,0,0,0,,Boş verin.\NAçıklamanıza gerek yok.
Dialogue: 0,0:21:16.68,0:21:19.82,Main,Doflamingo,0,0,0,,Emirlere itaat ediyordunuz sadece.
Dialogue: 0,0:21:20.64,0:21:22.09,Main,Law,0,0,0,,{\i1}Şaşırdım bak.{\i0}
Dialogue: 0,0:21:22.81,0:21:26.20,Main,Law,0,0,0,,{\i1}Patronun bizzat yüzünü göstermesini\Nbeklemiyordum.{\i0}
Dialogue: 0,0:21:26.20,0:21:28.98,Main,Doflamingo,0,0,0,,Sen misin bu Law?\NGörüşmeyeli epey olmuştu.
Dialogue: 0,0:21:28.98,0:21:31.47,Main,Doflamingo,0,0,0,,Burada olmaman çok yazık.
Dialogue: 0,0:21:31.47,0:21:35.79,Main,Law,0,0,0,,Caesar'ı arıyorsan yanımda.
Dialogue: 0,0:21:35.79,0:21:40.08,Main,Caesar,0,0,0,,Jo-Joker, kurtar beni!
Dialogue: 0,0:21:40.08,0:21:44.48,Main,Doflamingo,0,0,0,,Baby 5'la Buffalo'nun bedenleri nerede?
Dialogue: 0,0:21:44.48,0:21:45.72,Main,Law,0,0,0,,Kim bilir?
Dialogue: 0,0:21:45.72,0:21:48.19,Main,Law,0,0,0,,Böyle boş şeyler sorma bana.
Dialogue: 0,0:21:48.19,0:21:49.92,Main,Law,0,0,0,,Gel seninle bir anlaşma yapalım.
Dialogue: 0,0:21:56.98,0:21:59.82,Main,Doflamingo,0,0,0,,Bana bak Law, kendine gel.
Dialogue: 0,0:21:59.82,0:22:03.03,Main,Doflamingo,0,0,0,,Senin gibi yeni yetmeler\Nbüyüklerini taklit etmemeli.
Dialogue: 0,0:22:03.53,0:22:05.77,Main,Doflamingo,0,0,0,,Neredesin?
Dialogue: 0,0:22:05.77,0:22:08.54,Main,Doflamingo,0,0,0,,Söyle bak kızdırma beni.
Dialogue: 0,0:22:08.54,0:22:10.16,Main,Law,0,0,0,,Seni kızdırmayayım mı?
Dialogue: 0,0:22:10.16,0:22:13.65,Main,Law,0,0,0,,Şu anda en büyük müşterin...
Dialogue: 0,0:22:13.65,0:22:19.32,Main,Law,0,0,0,,...bir Yonko. \NBüyük Korsan, Canavarlar Kralı Kaido.
Dialogue: 0,0:22:19.32,0:22:24.59,Main,Law,0,0,0,,Ve bu adamı hiçbir şekilde\Nkızdırmaman gerektiğini biliyorum.
Dialogue: 0,0:22:26.69,0:22:31.88,Main,Law,0,0,0,,Peki ama artık GÜLÜCÜK\Nüretemediğini duysa ne olur dersin?
Dialogue: 0,0:22:32.72,0:22:37.55,Main,Law,0,0,0,,Anlaşma yapacak biri olmadığını biliyorum\Nyani haşin bir savaş baş gösterecek.
Dialogue: 0,0:22:37.55,0:22:40.06,Main,Buffalo,0,0,0,,Genç Bey'im, renginiz attı.
Dialogue: 0,0:22:40.67,0:22:43.27,Main,Law,0,0,0,,Seni yok edecek.
Dialogue: 0,0:22:43.27,0:22:46.90,Main,Doflamingo,0,0,0,,Şakayı fazla uzattın, Law.
Dialogue: 0,0:22:46.90,0:22:49.15,Main,Doflamingo,0,0,0,,Caesar'a karşılık ne istiyorsun?
Dialogue: 0,0:22:49.15,0:22:50.91,Main,Doflamingo,0,0,0,,Duyalım bakalım.
Dialogue: 0,0:22:51.54,0:22:54.79,Main,Law,0,0,0,,Shichibukai'lıktan istifa et.
Dialogue: 0,0:22:56.62,0:22:59.00,Main,Buffalo,0,0,0,,Ne diyor bu yeni yetme-dasuyan!?
Dialogue: 0,0:22:59.00,0:23:01.57,Main,Baby 5,0,0,0,,Öyle olursa Dressrosa'da kalamaz!
Dialogue: 0,0:23:01.57,0:23:08.73,Main,Law,0,0,0,,Tek istediğim 10 yılda elde ettiğin her şeyi geride bırakıp tekrardan sıradan bir korsan olman.
Dialogue: 0,0:23:08.73,0:23:15.11,Main,Law,0,0,0,,Fakat böyle olunca bu sefer de\NDonanma Amiralleri yakanı bırakmayacaklar!
Dialogue: 0,0:23:16.90,0:23:19.78,Main,Law,0,0,0,,Kararını yarın sabah gazeteden öğreneceğim.
Dialogue: 0,0:23:19.78,0:23:27.72,Main,Law,0,0,0,,Eğer Shichibukai'lıktan istifa ettiğin \Nhaberini alırsam gazeteden seni arayacağım.
Dialogue: 0,0:23:28.85,0:23:32.62,Main,Law,0,0,0,,Tabii gazetede bir şey yoksa,\Nanlaşmayı da unutabilirsin.
Dialogue: 0,0:23:33.89,0:23:35.13,Main,Law,0,0,0,,Elveda.
Dialogue: 0,0:23:37.10,0:23:38.90,Main,Doflamngo,0,0,0,,Bekle, Law!
Dialogue: 0,0:23:42.60,0:23:43.93,Main,Baby 5,0,0,0,,Genç Bey'im!
