Dialogue: 0,0:22:01.23,0:22:04.84,Main,Caesar,0,0,0,,Hey, Buffalo! Beni koruman lazım!
Dialogue: 0,0:22:04.84,0:22:06.47,Main,Caesar,0,0,0,,Hareket edemiyorum!
Dialogue: 0,0:22:06.47,0:22:09.71,Main,Buffalo,0,0,0,,El-Elbette! Hafife alma beni!
Dialogue: 0,0:22:09.71,0:22:12.94,Main,Buffalo,0,0,0,,Don Quixote ailesindenim ben!
Dialogue: 0,0:22:12.94,0:22:14.70,Main,Buffalo,0,0,0,,Görevimi yerine getireceğim...
Dialogue: 0,0:22:20.57,0:22:22.85,Main,Caesar,0,0,0,,Aptal, işe yaramaz herif!
Dialogue: 0,0:22:23.32,0:22:27.34,Main,Caesar,0,0,0,,Aptal şey, gazım ben!
Dialogue: 0,0:22:29.13,0:22:33.40,Main,Caesar,0,0,0,,Tek başıma da olsa\NDressrosa'ya varmalıyım!
Dialogue: 0,0:22:34.45,0:22:35.52,Main,Usopp,0,0,0,,Kaçamazsın!
Dialogue: 0,0:22:35.52,0:22:36.38,Main,Usopp,0,0,0,,Son mermimse...
Dialogue: 0,0:22:38.06,0:22:39.14,Main,Caesar,0,0,0,,Bu da nesi?!
Dialogue: 0,0:22:40.62,0:22:42.16,Main,Usopp,0,0,0,,...deniz taşından kelepçeler!
Dialogue: 0,0:22:44.84,0:22:47.08,Main,Usopp,0,0,0,,Tamamdır, yakaladım!
Dialogue: 0,0:22:49.05,0:22:51.05,Main,Gasmask and Marine,0,0,0,,Hak ettiğini buldun işte, Caesar!
Dialogue: 0,0:22:51.70,0:22:54.92,Main,Usopp,0,0,0,,Düşman bir kere arkasını döndü mü{\fscx250}-{\r}
Dialogue: 0,0:22:54.92,0:22:56.55,Main,Zoro,0,0,0,,Anladık!
Dialogue: 0,0:23:03.04,0:23:06.77,Main,Law,0,0,0,,Tamamdır!\NBöylece ilk adımı atmış olduk.
Dialogue: 0,0:23:07.38,0:23:08.15,Main,Luffy,0,0,0,,Gördün mü?
Dialogue: 0,0:23:08.15,0:23:09.74,Main,Luffy,0,0,0,,Güçlülermiş değil mi?
Dialogue: 0,0:23:28.43,0:23:30.99,Main,Aokiji,0,0,0,,Uyuyakalmışım.
Dialogue: 0,0:23:31.51,0:23:34.76,Main,Aokiji,0,0,0,,Punk Hazard ne taraftaydı bakalım?
