Dialogue: 0,0:02:29.76,0:02:38.60,Title,,0,0,0,,{\fad(2000,2000)}Benim İçin Öl!
Dialogue: 0,0:02:43.51,0:02:46.70,Main,Franky,0,0,0,,{\fad(150,150)}General Left!
Dialogue: 0,0:02:43.51,0:02:46.70,Attack,Franky,0,0,0,,{\fad(150,150)}General Sol!
Dialogue: 0,0:02:52.39,0:02:53.88,Main,Baby 5,0,0,0,,İyi misin Buffalo?
Dialogue: 0,0:02:53.88,0:02:55.68,Main,Buffalo,0,0,0,,Bu da ne-dasuyan?
Dialogue: 0,0:02:55.68,0:02:57.14,Main,Baby 5,0,0,0,,Nereden bileyim ben?!
Dialogue: 0,0:02:57.14,0:02:59.51,Main,Baby 5,0,0,0,,Durduk yere saldırılır mı öyle ya!
Dialogue: 0,0:03:01.63,0:03:04.57,Main,Baby 5,0,0,0,,Bu da ne böyle? Pacifista mı?
Dialogue: 0,0:03:04.57,0:03:08.62,Main,Baby 5,0,0,0,,Olamaz!\NCaesar insani silahlarla ilgilenmiyordu!
Dialogue: 0,0:03:08.62,0:03:09.74,Main,Baby 5,0,0,0,,Buffalo!
Dialogue: 0,0:03:09.74,0:03:11.90,Main,Buffalo,0,0,0,,Dasuyaniiiiin!
Dialogue: 0,0:03:11.90,0:03:14.52,Main,Baby 5,0,0,0,,İyi madem!\NNesin bilmiyorum ama...
Dialogue: 0,0:03:14.52,0:03:16.91,Main,Baby 5,0,0,0,,...savaşmak istiyorsan istediğini alacaksın!
Dialogue: 0,0:03:29.62,0:03:32.23,Main,Franky,0,0,0,,{\fad(150,150)}General Ben-İyiyim!
Dialogue: 0,0:03:32.62,0:03:34.43,Main,Baby 5,0,0,0,,Çizik bile yok!
Dialogue: 0,0:03:34.43,0:03:36.40,Main,Franky,0,0,0,,Alın bakalım, fırsat bu fırsat!
Dialogue: 0,0:03:36.80,0:03:37.63,Main,Franky,0,0,0,,{\fad(150,150)}General...
Dialogue: 0,0:03:39.00,0:03:39.84,Main,Franky,0,0,0,,{\fad(150,150)}Shield!
Dialogue: 0,0:03:39.00,0:03:39.84,Attack,Franky,0,0,0,,{\fad(150,150)}Kalkan
Dialogue: 0,0:03:39.84,0:03:41.63,Main,Baby 5,0,0,0,,Hem çok geç kaldın\Nhem de çok küçük!
Dialogue: 0,0:03:41.63,0:03:43.95,Main,Franky,0,0,0,,{\fad(150,150)}General Shield...
Dialogue: 0,0:03:41.63,0:03:43.95,Attack,Franky,0,0,0,,{\fad(150,150)}General Kalkan...
Dialogue: 0,0:03:44.34,0:03:45.16,Main,Franky,0,0,0,,{\fad(150,150)}Boomerang!
Dialogue: 0,0:03:44.34,0:03:45.16,Attack,Franky,0,0,0,,{\fad(150,150)}Bumerang
Dialogue: 0,0:03:45.16,0:03:46.37,Main,Buffalo,0,0,0,,Kalkanını fırlattı!
Dialogue: 0,0:03:46.37,0:03:47.42,Main,Baby 5,0,0,0,,Bu kadar mı umutsuz!?
Dialogue: 0,0:03:50.26,0:03:54.26,Main,Baby 5,0,0,0,,Az önceki oyuncağım\Nsana yeterli gelmedi sanırım?
Dialogue: 0,0:03:54.26,0:03:57.49,Main,Baby 5,0,0,0,,İyi madem, Caesar'ı almamıza\Nengel olmaya çalışıyorsan...
Dialogue: 0,0:03:57.51,0:03:59.88,Main,Baby 5,0,0,0,,...bu düşmanımız olduğun anlamına gelir.
Dialogue: 0,0:03:59.88,0:04:01.25,Main,Baby 5,0,0,0,,{\fad(150,150)}Bukimorphose...
Dialogue: 0,0:03:59.88,0:04:01.25,Attack,Baby 5,0,0,0,,{\fad(150,150)}Silah Dönüşümü...
Dialogue: 0,0:04:10.40,0:04:12.00,Main,Baby 5,0,0,0,,{\fad(150,150)}Espada Girl!
Dialogue: 0,0:04:10.40,0:04:12.00,Attack,Baby 5,0,0,0,,{\fad(150,150)}Kılıç Kız
Dialogue: 0,0:04:14.45,0:04:22.29,Main,Buffalo,0,0,0,,Dasuyan!
Dialogue: 0,0:04:23.94,0:04:24.66,Main,Baby 5,0,0,0,,Bu hiç gelir!
Dialogue: 0,0:04:24.82,0:04:26.14,Main,Franky,0,0,0,,{\fad(150,150)}General Left!
Dialogue: 0,0:04:24.82,0:04:26.14,Attack,Franky,0,0,0,,{\fad(150,150)}General Sol
Dialogue: 0,0:04:27.18,0:04:29.91,Main,Buffalo,0,0,0,,Genç Bey "derhal" dedi-dasuyan!
Dialogue: 0,0:04:33.53,0:04:35.33,Main,Baby 5,0,0,0,,{\fad(150,150)}Missile Girl!
Dialogue: 0,0:04:33.53,0:04:35.33,Attack,Baby 5,0,0,0,,{\fad(150,150)}Füze Kız
Dialogue: 0,0:04:35.75,0:04:37.08,Main,Buffalo,0,0,0,,Hazır mısın-dasuyan?!
Dialogue: 0,0:04:37.08,0:04:38.19,Main,Baby 5,0,0,0,,Başlayalım!
Dialogue: 0,0:04:38.19,0:04:40.23,Main,Buffalo,0,0,0,,Dasuyan...
Dialogue: 0,0:04:40.23,0:04:41.83,Main,Buffalo,0,0,0,,{\fad(150,150)}Guru Guru Tousha Hou!
Dialogue: 0,0:04:40.23,0:04:41.83,Attack,Buffalo,0,0,0,,{\fad(150,150)}Dön Dön: Füze Güllesi
Dialogue: 0,0:04:42.49,0:04:44.23,Main,Baby 5,0,0,0,,Caesar'ı alacağız!
Dialogue: 0,0:04:44.23,0:04:47.12,Main,Franky,0,0,0,,Ne diyorsunuz siz be?!\NNe olmuş Caesar'a?
Dialogue: 0,0:05:05.63,0:05:08.04,Thoughts,Caesar,0,0,0,,Neredeyim böyle?
Dialogue: 0,0:05:08.62,0:05:14.00,Thoughts,Caesar,0,0,0,,Hareket edemiyorum.\NLanet olsun! Bu kadarmış demek?
Dialogue: 0,0:05:17.60,0:05:23.50,Flashbacks,Caesar,0,0,0,,Donanma G-5 Koramirali\NSmoker'ın kalbi!
Dialogue: 0,0:05:23.50,0:05:26.97,Flashbacks,Caesar,0,0,0,,Çok harika bir hediye bu, Law.
Dialogue: 0,0:05:29.90,0:05:33.87,Main,Caesar,0,0,0,,Smoker, en azından seni...
Dialogue: 0,0:05:33.87,0:05:35.98,Main,Caesar,0,0,0,,...benimle beraber\Ncehenneme götürebileceğim!
Dialogue: 0,0:05:39.27,0:05:42.55,Captions,Caption,0,0,180,,{\fad(550,0)}Laboratuvar 3 - R Binası
Dialogue: 0,0:05:43.37,0:05:45.79,Main,Law,0,0,0,,Ne yapıyorsunuz siz, Hasır Şapkalar?!
Dialogue: 0,0:05:46.13,0:05:47.90,Main,Law,0,0,0,,Atlayın haydi!
Dialogue: 0,0:05:47.90,0:05:52.40,Main,Law,0,0,0,,Caesar'ın kaçmasına müsaade edersek\Nplanımız suya düşecek!
Dialogue: 0,0:05:52.40,0:05:53.47,Main,Luffy,0,0,0,,Ne diyorsun sen be?!
Dialogue: 0,0:05:53.69,0:05:56.00,Main,Luffy,0,0,0,,"Biz" hepimiz burada değiliz henüz!
Dialogue: 0,0:05:59.70,0:06:03.76,Captions,Caption,0,0,180,,{\fad(500,0)}B ve R Binası Arasındaki Koridor
Dialogue: 0,0:06:02.14,0:06:03.76,Main,Usopp,0,0,0,,{\an8}Acele edin Chopper, Brook!
Dialogue: 0,0:06:03.76,0:06:05.57,Main,Chopper,0,0,0,,Tamamdır, olacağız Usopp!
Dialogue: 0,0:06:05.57,0:06:07.71,Main,Marine,0,0,0,,{\i1}Koşanlar biziz yalnız burada!
Dialogue: 0,0:06:07.71,0:06:09.91,Main,Usopp,0,0,0,,Bir şekilde atlatın şu gazı!
Dialogue: 0,0:06:10.07,0:06:15.10,Captions,Caption,0,0,180,,{\fad(350,650)}R Binası, 2. Kat - Gizli Oda
Dialogue: 0,0:06:09.91,0:06:12.80,Main,Usopp,0,0,0,,{\an8}Acele edin! Elli metre kaldı!
Dialogue: 0,0:06:12.80,0:06:15.45,Main,Usopp,0,0,0,,{\an8}Kapı kapanıyor! Girin içeri!
Dialogue: 0,0:06:15.45,0:06:16.49,Main,Gasmask soldier,0,0,0,,Bu bina da çökecek!
Dialogue: 0,0:06:16.49,0:06:17.79,Main,Usopp,0,0,0,,Benim de gitmem lazım!
Dialogue: 0,0:06:18.15,0:06:19.69,Main,Chopper,0,0,0,,Kapı kapanıyor!
Dialogue: 0,0:06:20.41,0:06:22.99,Main,Chopper,0,0,0,,Luffy!
Dialogue: 0,0:06:22.99,0:06:24.10,Main,Luffy,0,0,0,,Geldiler!
Dialogue: 0,0:06:27.57,0:06:29.43,Main,Chopper,0,0,0,,Yetiştik!
Dialogue: 0,0:06:29.43,0:06:30.82,Main,Luffy,0,0,0,,Tamamdır, hepimiz buradayız!
Dialogue: 0,0:06:30.82,0:06:32.90,Main,Nami,0,0,0,,Endişelendirdiniz bizi ya!
Dialogue: 0,0:06:32.90,0:06:34.43,Main,Usopp,0,0,0,,Yetişebilmenize sevindim!
Dialogue: 0,0:06:34.43,0:06:36.31,Main,Chopper,0,0,0,,Evet, sayende oldu, Usopp!
Dialogue: 0,0:06:36.31,0:06:39.15,Main,Marine,0,0,0,,Deliler gibi koşan bizdik!
Dialogue: 0,0:06:39.84,0:06:43.39,Main,Luffy,0,0,0,,Herkes atlasın!\NBurası çökecek!
Dialogue: 0,0:06:44.33,0:06:45.65,Main,Luffy,0,0,0,,Acele edin!
Dialogue: 0,0:06:45.65,0:06:48.00,Main,Luffy,0,0,0,,Kaçıp gidelim buradan millet!
Dialogue: 0,0:06:48.00,0:06:50.67,Main,All,0,0,0,,Evet!
Dialogue: 0,0:06:50.67,0:06:52.47,Main,Brook,0,0,0,,Ben ne yapayım şimdi?
Dialogue: 0,0:06:52.47,0:06:54.43,Main,Brook,0,0,0,,Kin'emon-san'a neler yapayım?!
Dialogue: 0,0:06:54.43,0:06:56.88,Main,Momonosuke,0,0,0,,Ne?! Kin'emon mu?
Dialogue: 0,0:06:56.88,0:06:59.11,Main,Zoro,0,0,0,,Ne mi yapalım? Herif çoktan...
Dialogue: 0,0:07:00.27,0:07:04.40,Main,Momonosuke,0,0,0,,Ki... Kin'emon mu?!
Dialogue: 0,0:07:08.36,0:07:09.84,Main,Monet,0,0,0,,Joker,...
Dialogue: 0,0:07:09.84,0:07:11.18,Main,Monet,0,0,0,,...duyuyor musun?
Dialogue: 0,0:07:11.64,0:07:13.01,Main,Monet,0,0,0,,Ben...
Dialogue: 0,0:07:13.46,0:07:14.88,Main,Monet,0,0,0,,...Monet.
Dialogue: 0,0:07:15.17,0:07:18.62,Main,Doflamingo,0,0,0,,Monet, hayattaydın demek?
Dialogue: 0,0:07:18.62,0:07:22.62,Main,Doflamingo,0,0,0,,Vergo yenildi. Caesar da.
Dialogue: 0,0:07:22.62,0:07:27.37,Main,Doflamingo,0,0,0,,Fakat Baby 5 ve Buffalo\Nmuhtemelen onu almak üzerelerdir.
Dialogue: 0,0:07:27.37,0:07:29.33,Main,Doflamingo,0,0,0,,İşi yanlış değerlendirmem yüzünden\Nbu raddeye geldi.
Dialogue: 0,0:07:29.71,0:07:32.63,Main,Doflamingo,0,0,0,,Adınıza çok üzülüyorum.
Dialogue: 0,0:07:33.33,0:07:37.70,Main,Doflamingo,0,0,0,,Fakat oradaki ahmakların hepsini\Nortadan kaldırmak istiyorum.
Dialogue: 0,0:07:37.70,0:07:39.54,Main,Doflamingo,0,0,0,,Üçüncü Laboratuvar'da...
Dialogue: 0,0:07:39.56,0:07:45.39,Main,Doflamingo,0,0,0,,...dört yıl önce Birinci ve \Nİkinci Lavoratuvar'ların yıkımına yol açan...
Dialogue: 0,0:07:45.41,0:07:47.71,Main,Doflamingo,0,0,0,,...başka bir silah daha yatıyor.
Dialogue: 0,0:07:48.35,0:07:51.30,Main,Doflamingo,0,0,0,,Ateşleme düğmesine basılır basılmaz...
Dialogue: 0,0:07:51.30,0:07:54.99,Main,Doflamingo,0,0,0,,...o adada sağ kalacak tek şey...
Dialogue: 0,0:07:54.99,0:07:57.94,Main,Doflamingo,0,0,0,,...o zehirli gazdan\Nkurtulabilecek tek kişi...
Dialogue: 0,0:07:59.07,0:08:01.16,Main,Doflamingo,0,0,0,,...Caesar olacak!
Dialogue: 0,0:08:01.71,0:08:03.16,Main,Doflamingo,0,0,0,,Bu ateşleme düğmesiyse{\fscx250}-{\r}
Dialogue: 0,0:08:03.16,0:08:06.18,Main,Monet,0,0,0,,Devamını söylemene bile gerek yok, Joker.
Dialogue: 0,0:08:06.18,0:08:08.30,Main,Monet,0,0,0,,En başından beri planım buydu zaten.
Dialogue: 0,0:08:09.70,0:08:13.09,Main,Monet,0,0,0,,Ateşleme aletinin önündeyim şu an.
Dialogue: 0,0:08:13.09,0:08:16.93,Main,Monet,0,0,0,,Patlama, kaçmaya çalıştıkları \Ntankeri mahvedecek.
Dialogue: 0,0:08:16.93,0:08:19.44,Main,Monet,0,0,0,,Tankerlerinden birini yitirmiş\Nolacaksın ama bir şey olmaz değil mi?
Dialogue: 0,0:08:19.85,0:08:20.95,Main,Doflamingo,0,0,0,,Bağışla.
Dialogue: 0,0:08:20.95,0:08:24.65,Main,Doflamingo,0,0,0,,Her şeyle birlikte\Nölmeni istiyorum senden.
Dialogue: 0,0:08:27.62,0:08:29.15,Main,Monet,0,0,0,,Anlaşılmıştır...
Dialogue: 0,0:08:29.15,0:08:31.29,Main,Monet,0,0,0,,...Genç Bey'im.
Dialogue: 0,0:08:42.76,0:08:45.00,Thoughts,Caesar,0,0,0,,Geber, Smoker!
Dialogue: 0,0:08:47.08,0:08:49.56,Main,Doflamingo,0,0,0,,Bağışla beni ortak.
Dialogue: 0,0:08:49.56,0:08:52.14,Main,Doflamingo,0,0,0,,Seni diğerlerinden \Ndaha uzun süredir tanıyorum.
Dialogue: 0,0:08:53.65,0:08:57.02,Main,Doflamingo,0,0,0,,Bugüne kadar iyi iş çıkardın.
Dialogue: 0,0:09:24.01,0:09:27.56,Main,Baby 5,0,0,0,,Füze Kız'ın aşk alevini...
Dialogue: 0,0:09:29.29,0:09:30.90,Main,Baby 5,0,0,0,,...beğendin mi?
Dialogue: 0,0:09:32.26,0:09:34.85,Main,Buffalo,0,0,0,,Hey, Baby 5!
Dialogue: 0,0:09:34.85,0:09:39.75,Main,Buffalo,0,0,0,,Bu silah lazım mı sana?\NGerçi sen kendin silahsın ya...
Dialogue: 0,0:09:39.75,0:09:42.18,Main,Baby 5,0,0,0,,Alıp getirdiğin için sağ ol, Buffalo!
Dialogue: 0,0:09:42.71,0:09:45.15,Main,Baby 5,0,0,0,,Şans tılsımım o benim!
Dialogue: 0,0:09:45.15,0:09:48.13,Flashbacks,Ugly guy,0,0,0,,Bu silaha sahip olanlar\Nher daim mutlu olacaklardır.
Dialogue: 0,0:09:48.13,0:09:51.54,Flashbacks,Ugly guy,0,0,0,,Hem bunu alırsan\Nbeni de mutlu etmiş olacaksın.
Dialogue: 0,0:09:52.58,0:09:54.09,Flashbacks,Baby 5,0,0,0,,Bana...
Dialogue: 0,0:09:54.09,0:09:56.94,Flashbacks,Baby 5,0,0,0,,...ihtiyacı var!
Dialogue: 0,0:09:56.94,0:09:59.19,Main,Buffalo,0,0,0,,Bariz kandırılmışsın!
Dialogue: 0,0:09:59.19,0:10:01.81,Main,Buffalo,0,0,0,,Arkanda-dasuyan!
Dialogue: 0,0:10:03.52,0:10:06.75,Main,Franky,0,0,0,,Kimsiniz, nesiniz bilmiyorum ama...
Dialogue: 0,0:10:06.75,0:10:17.06,Main,Franky,0,0,10,,...ben Yenilmez Demir Korsan'ım! ♪\N♪ Denizlerde refah için savaşmam! ♪
Dialogue: 0,0:10:17.06,0:10:18.42,Main,Franky,0,0,10,,♪ Demir Korsan! ♪
Dialogue: 0,0:10:18.42,0:10:19.66,Main,Baby 5,0,0,0,,Ne can sıkıcı!
Dialogue: 0,0:10:20.17,0:10:21.32,Main,Baby 5,0,0,0,,{\fad(150,150)}Bukimorphose!
Dialogue: 0,0:10:20.17,0:10:21.32,Attack,Baby 5,0,0,0,,{\fad(150,150)}Silah Dönüşümü
Dialogue: 0,0:10:22.04,0:10:23.74,Main,Baby 5,0,0,0,,{\fad(150,150)}Revolver Girl!
Dialogue: 0,0:10:22.04,0:10:23.74,Attack,Baby 5,0,0,0,,{\fad(150,150)}Tabanca Kız
Dialogue: 0,0:10:26.99,0:10:28.11,Main,Franky,0,0,0,,İşe yaramaz!
Dialogue: 0,0:10:38.47,0:10:39.85,Main,Luffy,0,0,0,,Hızlıymış!
Dialogue: 0,0:10:43.22,0:10:44.89,Main,Nami,0,0,0,,Neden bir ejderha bizimle birlikte geliyor?
Dialogue: 0,0:10:44.89,0:10:46.49,Main,Momonosuke,0,0,0,,Ba-
Dialogue: 0,0:10:46.49,0:10:49.51,Main,Brook,0,0,0,,Nesi var bunun böyle ya?!
Dialogue: 0,0:10:49.51,0:10:52.27,Main,Momonosuke,0,0,0,,Baba!
Dialogue: 0,0:10:52.27,0:10:55.23,Main,Brook,0,0,0,,Yılan balığı bana saldırıyor!
Dialogue: 0,0:10:57.56,0:10:58.80,Main,Luffy,0,0,0,,Hey, Momo!
Dialogue: 0,0:11:08.45,0:11:10.72,Thoughts,Monet,0,0,0,,Elveda Genç Bey'im.
Dialogue: 0,0:11:13.41,0:11:16.09,Thoughts,Monet,0,0,0,,Korsanlar Kralı...
Dialogue: 0,0:11:17.48,0:11:22.06,Thoughts,Monet,0,0,0,,...olacak adam!
Dialogue: 0,0:11:34.80,0:11:36.40,Main,Chopper,0,0,0,,İyi misin?
Dialogue: 0,0:11:36.40,0:11:37.41,Main,Child,0,0,0,,Evet.
Dialogue: 0,0:11:39.56,0:11:41.51,Main,Nami,0,0,0,,Bir yerlerde patlama oldu gibi!
Dialogue: 0,0:11:41.51,0:11:43.78,Main,Law,0,0,0,,Muhtemelen D binasında olmuştur.
Dialogue: 0,0:11:44.37,0:11:47.57,Main,Law,0,0,0,,Benim geldiğim\No SAD Üretim Odası'nda.
Dialogue: 0,0:11:58.73,0:12:00.65,Main,Doflamingo,0,0,0,,Monet?
Dialogue: 0,0:12:01.22,0:12:03.38,Main,Doflamingo,0,0,0,,Ne oldu, Monet?
Dialogue: 0,0:12:06.93,0:12:09.16,Main,Smoker,0,0,0,,Bak az, Law.
Dialogue: 0,0:12:09.16,0:12:13.14,Main,Smoker,0,0,0,,Kalbimin Caesar'da olduğunu sanıyordum.
Dialogue: 0,0:12:13.95,0:12:16.48,Main,Smoker,0,0,0,,Nasıl oldu da\Ngene ellerinde bitiverdi?
Dialogue: 0,0:12:17.33,0:12:19.40,Main,Law,0,0,0,,O öyle sanıyordu.
Dialogue: 0,0:12:19.40,0:12:22.39,Flashbacks,Caesar,0,0,0,,Kalbini bana ver!
Dialogue: 0,0:12:24.13,0:12:26.87,Flashbacks,Caesar,0,0,0,,Anlaşma bu!
Dialogue: 0,0:12:26.87,0:12:31.20,Main,Law,0,0,0,,Sonra da laboratuvara gelmenin ardından\Nsenin kalbini aldım.
Dialogue: 0,0:12:39.57,0:12:45.14,Flashbacks,Caesar,0,0,0,,Donanma G-5 Koramirali Smoker'ın kalbi!
Dialogue: 0,0:12:45.14,0:12:49.28,Flashbacks,Caesar,0,0,0,,Çok güzel bir hediye bu, Law.
Dialogue: 0,0:12:51.02,0:12:57.36,Main,Law,0,0,0,,Ben de iyilik edip\Nsekreteri Monet'in kalbini ona geri verdim.
Dialogue: 0,0:12:59.97,0:13:01.63,Main,Doflamingo,0,0,0,,Cevap ver.
Dialogue: 0,0:13:02.90,0:13:07.53,Main,Law,0,0,0,,Aynı dedikleri gibi \Niyilik yapan...
Dialogue: 0,0:13:08.48,0:13:11.24,Main,Law,0,0,0,,...iyilik bulur.
Dialogue: 0,0:13:16.21,0:13:19.28,Main,Usopp,0,0,0,,Durum vahim, çok hızlı çökmeye başladı!
Dialogue: 0,0:13:20.67,0:13:21.90,Main,Luffy,0,0,0,,Dikkat edin!
Dialogue: 0,0:13:22.81,0:13:24.02,Main,Nami,0,0,0,,Geçit çökecek!
Dialogue: 0,0:13:26.18,0:13:29.09,Main,Law,0,0,0,,Dağın altındaki bir tüneldeyiz.
Dialogue: 0,0:13:29.09,0:13:30.79,Main,Law,0,0,0,,Çökecek olursa canlı canlı gömülürüz burada.
Dialogue: 0,0:13:30.79,0:13:32.76,Main,Usopp,0,0,0,,Böyle rahat rahat konuşmasana ya!
Dialogue: 0,0:13:36.71,0:13:38.86,Main,Marine,0,0,0,,Olamaz, yıkıntı yolumuzu tıkadı!
Dialogue: 0,0:13:38.86,0:13:39.92,Main,Marine,0,0,0,,Frenler nerede?!
Dialogue: 0,0:13:53.54,0:13:56.15,Main,Marine,0,0,0,,Vay canına, kurtulduk!
Dialogue: 0,0:13:56.15,0:13:58.40,Main,Marine,0,0,0,,Bu herifin düşmanım olmasını istemezdim!
Dialogue: 0,0:13:58.40,0:13:59.38,Main,Marine,0,0,0,,Gerçi düşmanım zaten ya!
Dialogue: 0,0:14:01.77,0:14:04.36,Main,Law,0,0,0,,Çıkış da gazla kaplı olacak muhtemelen.
Dialogue: 0,0:14:05.42,0:14:08.67,Main,Law,0,0,0,,İçinizde rüzgar yaratabilen\Nbirileri var mı?!
Dialogue: 0,0:14:08.67,0:14:12.55,Main,Gasmask Soldier,0,0,0,,Öyle bir yeteneği olan birini bulmak\Nkolay mı sanıyorsun?!
Dialogue: 0,0:14:13.35,0:14:15.55,Main,Nami,0,0,0,,Ben yapabilirim.
Dialogue: 0,0:14:15.55,0:14:16.98,Main,Gasmask Soldier,0,0,0,,Yok artık!
Dialogue: 0,0:14:18.13,0:14:19.67,Main,Usopp,0,0,0,,Çıkış göründü!
Dialogue: 0,0:14:21.79,0:14:23.84,Main,Luffy,0,0,0,,Tamamdır, çok az kaldı!
Dialogue: 0,0:14:24.33,0:14:26.03,Main,Luffy,0,0,0,,Hızlanın!
Dialogue: 0,0:14:33.44,0:14:36.02,Main,Random girl,0,0,0,,Genç Beyim!
Dialogue: 0,0:14:37.46,0:14:39.22,Main,Random girl,0,0,0,,Genç Bey'imiz hiçbir yerde yok.
Dialogue: 0,0:14:39.22,0:14:41.56,Main,Lao G,0,0,0,,Dördüncü kattaki odadadır.
Dialogue: 0,0:14:42.96,0:14:45.80,Main,Random girl,0,0,0,,Hayır, orada değildi.
Dialogue: 0,0:14:45.80,0:14:47.93,Main,Random girl,0,0,0,,Pencere açıktı.
Dialogue: 0,0:14:47.93,0:14:50.64,Main,Lao G,0,0,0,,Öyle demek.
Dialogue: 0,0:14:51.93,0:14:53.70,Main,Lao G,0,0,0,,O zaman nerededir kim bilir.
Dialogue: 0,0:15:00.36,0:15:03.06,Main,Lao G,0,0,0,,Gene almış başını gitmiş.
Dialogue: 0,0:15:03.61,0:15:08.99,Main,Buffalo,0,0,0,,{\an8}Bi-Bir tür demir muhafız tarafından\Nyolumuz kesildi!
Dialogue: 0,0:15:05.07,0:15:10.04,Captions,Sign,0,0,180,,{\fad(500,0)}Deniz
Dialogue: 0,0:15:10.34,0:15:15.65,Main,Doflamingo,0,0,0,,Yani ada da o ahmaklar da\Nortadan kalkmadılar demek oluyor bu.
Dialogue: 0,0:15:17.32,0:15:22.43,Main,Doflamingo,0,0,0,,Siz o muhafızla ilgilenin.
Dialogue: 0,0:15:25.32,0:15:27.04,Main,Doflamingo,0,0,0,,Oraya geliyorum!
Dialogue: 0,0:15:27.85,0:15:31.34,Captions,Sign,0,0,180,,{\fad(486,0)}Punk Hazard - Kıyı Şeridi
Dialogue: 0,0:15:31.34,0:15:34.30,Main,Buffalo,0,0,0,,Neyin nesi bu demir asker?!
Dialogue: 0,0:15:34.30,0:15:36.01,Main,Buffalo,0,0,0,,Hiçbir şey üzerinde işe yaramıyor!
Dialogue: 0,0:15:37.97,0:15:41.05,Main,Franky,0,0,0,,Kolamı çalmaya çalışıyorsunuz çünkü!
Dialogue: 0,0:15:41.05,0:15:42.12,Main,Buffalo,0,0,0,,Kola mı!?
Dialogue: 0,0:15:42.12,0:15:43.82,Main,Buffalo,0,0,0,,Ne diyor bu?
Dialogue: 0,0:15:44.62,0:15:50.16,Main,Franky,0,0,0,,Haydi,\NPervane Adam ve Silah Kız!
Dialogue: 0,0:15:50.16,0:15:52.21,Main,Buffalo,0,0,0,,Bizi çok oyaladı!
Dialogue: 0,0:15:52.21,0:15:54.08,Main,Buffalo,0,0,0,,Gidelim, Baby 5!
Dialogue: 0,0:15:54.08,0:15:57.79,Main,Buffalo,0,0,0,,Şimdiye dek kimseler\Nbu saldırıdan kurtulamadı!
Dialogue: 0,0:15:58.23,0:16:03.11,Main,Franky,0,0,0,,Ne denerseniz deneyin süper beyhude!
Dialogue: 0,0:16:03.11,0:16:04.94,Main,Buffalo,0,0,0,,Seni kesip biçeceğiz!
Dialogue: 0,0:16:09.69,0:16:11.75,Main,Buffalo,0,0,0,,Döndürdüğüm silaha bak da\Ngözün silah görsün!
Dialogue: 0,0:16:11.75,0:16:12.92,Main,Franky,0,0,0,,Ha?
Dialogue: 0,0:16:13.40,0:16:14.73,Main,Baby 5,0,0,0,,{\fad(150,150)}Sickle Girl!
Dialogue: 0,0:16:13.40,0:16:14.73,Attack,Baby 5,0,0,0,,{\fad(150,150)}Orak Kız
Dialogue: 0,0:16:24.90,0:16:27.08,Main,Franky,0,0,0,,Tamam, şimdi takdirimi kazandınız işte...
Dialogue: 0,0:16:27.08,0:16:31.44,Main,Franky,0,0,0,,General vücudumu delmeyi başardınız.
Dialogue: 0,0:16:31.44,0:16:36.47,Main,Franky,0,0,0,,Fakat bu yaptığınızın\Nfile çatalla dalmaktan farkı yok.
Dialogue: 0,0:16:38.94,0:16:43.34,Main,Franky,0,0,0,,Bir gün tüm okyanusları fethedecek olan\NThousand Sunny-go'nun...
Dialogue: 0,0:16:43.34,0:16:49.40,Main,Franky,0,0,0,,...saklı nihai saldırısını sizlere\Nher ne kadar hak etmeseniz de göstereceğim!
Dialogue: 0,0:16:53.09,0:16:56.86,Main,Franky,0,0,0,,Gaon Topu'nun karasal versiyonu!
Dialogue: 0,0:16:58.33,0:17:01.95,Main,Franky,0,0,0,,Adı da...
Dialogue: 0,0:17:09.11,0:17:11.71,Main,Franky,0,0,0,,{\fad(150,150)}General Cannon!
Dialogue: 0,0:17:09.11,0:17:11.71,Attack,Franky,0,0,0,,{\fad(150,150)}General Topu
Dialogue: 0,0:17:14.45,0:17:16.95,Main,Buffalo,0,0,0,,Kim bu herif-dasuyan?!
Dialogue: 0,0:17:16.95,0:17:21.39,Main,Baby 5,0,0,0,,Neden Caesar'ı almamıza engel oluyor?!
Dialogue: 0,0:17:28.99,0:17:33.07,Main,Franky,0,0,0,,Şu yerde yatan kişi\NCaesar değil mi?
Dialogue: 0,0:17:33.07,0:17:35.85,Main,Franky,0,0,0,,Nasıl geldi ki buraya?
Dialogue: 0,0:17:38.45,0:17:43.57,Main,Buffalo,0,0,0,,Başarısız olma lüksümüz yok! \NKimin için çalışıyor olduğun bizim için önemsiz!
Dialogue: 0,0:17:43.57,0:17:45.89,Main,Franky,0,0,0,,Vay arkadaş, gözlerime inanamıyorum!
Dialogue: 0,0:17:45.89,0:17:48.18,Main,Franky,0,0,0,,Kolay kolay devrilmiyorsunuz.
Dialogue: 0,0:17:48.18,0:17:53.07,Main,Buffalo,0,0,0,,Bizi sakın sıradan süprüntülerle\Naynı kefeye koyma!
Dialogue: 0,0:17:53.50,0:17:55.37,Main,Buffalo,0,0,0,,Joker adına...
Dialogue: 0,0:17:55.80,0:17:59.19,Main,Baby 5,0,0,0,,Ne pahasına olursa olsun\NCaesar'ı alacağız.
Dialogue: 0,0:17:59.64,0:18:03.06,Main,Franky,0,0,0,,Yani şimdi peşinde olduğunuz şey...
Dialogue: 0,0:18:03.06,0:18:05.80,Main,Franky,0,0,0,,...şurada duran Caesar öyle mi?
Dialogue: 0,0:18:05.80,0:18:07.51,Main,Luffy,0,0,0,,Neredeyse çıkışa vardık!
Dialogue: 0,0:18:10.23,0:18:13.04,Main,Usopp,0,0,0,,Rüzgarı bir an olsun kesme, Nami!
Dialogue: 0,0:18:13.04,0:18:15.46,Main,Usopp,0,0,0,,Muhtemelen dışarısı da tamamıyla gazla dolu.
Dialogue: 0,0:18:19.23,0:18:22.88,Main,Luffy,0,0,0,,Çıktık!
Dialogue: 0,0:18:28.05,0:18:29.94,Main,Franky,0,0,0,,Sonunda gelebildiniz demek?
Dialogue: 0,0:18:29.94,0:18:31.84,Main,Franky,0,0,0,,Sıkılmaya başlamıştım!
Dialogue: 0,0:18:31.84,0:18:33.68,Main,Luffy,0,0,0,,Vay canına, şuna bakın!
Dialogue: 0,0:18:34.78,0:18:36.11,Main,Usopp,0,0,0,,General bu!
Dialogue: 0,0:18:38.64,0:18:40.93,Main,Franky,0,0,0,,Süper!
Dialogue: 0,0:18:40.93,0:18:42.52,Main,Children,0,0,0,,Robot bu!
Dialogue: 0,0:18:42.52,0:18:44.24,Main,Marine,0,0,0,,Dehşet bir tanesi hem de!
Dialogue: 0,0:18:46.77,0:18:50.31,Main,Law,0,0,0,,Buffalo? Ve Baby 5!
Dialogue: 0,0:18:50.31,0:18:54.90,Main,Baby 5,0,0,0,,Law, ciddi ciddi\NJoker'a karşı mı geliyorsun?!
Dialogue: 0,0:18:54.90,0:18:56.90,Main,Buffalo,0,0,0,,Seni hain!
Dialogue: 0,0:18:56.90,0:19:01.42,Main,Buffalo,0,0,0,,Joker "Kupa Mevki"ni hâlâ \Nsenin için saklıyor!
Dialogue: 0,0:19:01.42,0:19:02.30,Main,Luffy,0,0,0,,Bunlar da kim?
Dialogue: 0,0:19:02.30,0:19:04.01,Main,Luffy,0,0,0,,Arkadaşların mı?
Dialogue: 0,0:19:05.38,0:19:06.02,Main,Law,0,0,0,,Hayır.
Dialogue: 0,0:19:07.02,0:19:08.14,Main,Law,0,0,0,,Düşmanlarımız!
Dialogue: 0,0:19:15.68,0:19:21.24,Main,Buffalo,0,0,0,,Tüm Hasır Şapka tayfası ve Donanma G-5'i,\Ndurum bizim aleyhimize.
Dialogue: 0,0:19:22.27,0:19:25.18,Main,Caesar,0,0,0,,Neler oluyor, Baby 5?
Dialogue: 0,0:19:25.54,0:19:28.50,Main,Baby 5,0,0,0,,Her halükarda\NCaesar'ı beyimize götürmeliyiz!
Dialogue: 0,0:19:28.76,0:19:31.02,Main,Usopp,0,0,0,,Caesar'ı alıp kaçtılar!
Dialogue: 0,0:19:31.02,0:19:32.77,Main,Usopp,0,0,0,,Tamamdır, bana bırakın!
Dialogue: 0,0:19:32.77,0:19:34.99,Main,Usopp,0,0,0,,Uçan düşmanlar keskin nişancıların işidir!
Dialogue: 0,0:19:35.52,0:19:36.73,Main,Law,0,0,0,,Adiler!
Dialogue: 0,0:19:36.73,0:19:37.56,Main,Luffy,0,0,0,,Dur bakalım yahu!
Dialogue: 0,0:19:38.69,0:19:41.32,Main,Luffy,0,0,0,,Usopp ona bırakmamızı söyledi.
Dialogue: 0,0:19:41.32,0:19:46.24,Main,Zoro,0,0,0,,Keskin nişancımızı sakın küçümseme.\NAynı burnu gibi.
Dialogue: 0,0:19:46.24,0:19:47.68,Main,Law,0,0,0,,Saçmalamayın!
Dialogue: 0,0:19:47.68,0:19:50.43,Main,Law,0,0,0,,Kaçmalarına izin verirsek planımız...
Dialogue: 0,0:19:50.43,0:19:52.93,Main,Nami,0,0,0,,Bizimle bile bile ittifak kurdun.
Dialogue: 0,0:19:52.93,0:19:56.79,Main,Nami,0,0,0,,Az önce ne yaptığımı gördün.\NBiraz olsun güven bize.
Dialogue: 0,0:19:56.79,0:19:58.81,Main,Zoro,0,0,0,,İttifak derken, olay nedir?
Dialogue: 0,0:19:58.81,0:20:01.65,Main,Nami,0,0,0,,Ben de onca koşuşturmanın ardından...
Dialogue: 0,0:20:03.44,0:20:05.12,Main,Nami,0,0,0,,...bir iki şey\Nyapabilirmişim gibi hissediyorum!
Dialogue: 0,0:20:06.77,0:20:11.27,Main,Nami,0,0,0,,Düşman kimisi benden uzak oldukça\Nsavaşmaktan asla korkmam!
Dialogue: 0,0:20:12.91,0:20:16.91,Main,Usopp,0,0,0,,Hele de yaralı bir şekilde kaçıyorlarsa\No noktada işi bize bırakacaksınız!
Dialogue: 0,0:20:21.05,0:20:22.73,Main,Zoro,0,0,0,,Neyse ne, yapın yapacağınızı hadi!
Dialogue: 0,0:20:23.18,0:20:25.34,Main,Usopp,0,0,0,,Şimdi önce biraz sulandıralım ortamı.
Dialogue: 0,0:20:27.40,0:20:29.18,Main,Usopp,0,0,0,,Haydi bakalım!
Dialogue: 0,0:20:29.97,0:20:31.44,Main,Usopp,0,0,0,,{\fad(150,150)}Büyü!
Dialogue: 0,0:20:32.84,0:20:34.85,Main,Usopp,0,0,0,,{\fad(150,150)}Kara Kabuto: Yiyen Bitki!
Dialogue: 0,0:20:36.34,0:20:39.27,Main,Usopp,0,0,0,,Haydi ye bakalım, doyur kendini!
Dialogue: 0,0:20:42.37,0:20:45.39,Main,Baby 5,0,0,0,,Dikkatli ol Buffalo,\Nbir şey yapacak gibiler!
Dialogue: 0,0:20:45.39,0:20:48.58,Main,Buffalo,0,0,0,,Arkam sana emanet Baby 5!
Dialogue: 0,0:20:48.58,0:20:50.06,Main,Buffalo,0,0,0,,Uçabilen tek kişi benim!
Dialogue: 0,0:20:50.06,0:20:51.56,Main,Buffalo,0,0,0,,Görevi ne pahasına olursa olsun tamamlamalıyız!
Dialogue: 0,0:20:53.51,0:20:54.68,Main,Baby 5,0,0,0,,Tamamdır!
Dialogue: 0,0:20:54.68,0:20:56.57,Main,Baby 5,0,0,0,,Bana ihtiyacın var değil mi?
Dialogue: 0,0:20:57.85,0:21:00.92,Main,Baby 5,0,0,0,,Hayatım pahasına seni koruyacağım!
Dialogue: 0,0:21:01.15,0:21:02.41,Main,Nami,0,0,0,,Git bakalım!
Dialogue: 0,0:21:02.91,0:21:04.32,Main,Nami,0,0,0,,{\fad(150,150)}Weather Egg!
Dialogue: 0,0:21:02.91,0:21:04.32,Attack,Nami,0,0,0,,{\fad(150,150)}Hava Yumurtası
Dialogue: 0,0:21:05.88,0:21:07.88,Main,Buffalo,0,0,0,,Bir şey yaklaşıyor!
Dialogue: 0,0:21:07.88,0:21:10.43,Main,Nami,0,0,0,,Haydi kır yumurtanı, şimşek-chan!
Dialogue: 0,0:21:18.18,0:21:19.09,Main,Baby 5,0,0,0,,Fırtına bulutu mu bu?!
Dialogue: 0,0:21:19.09,0:21:21.39,Main,Baby 5,0,0,0,,Buffalo, hiç hoşuma gitmiyor bu!
Dialogue: 0,0:21:21.39,0:21:23.33,Main,Buffalo,0,0,0,,Bundan hızlı uçamıyorum!
Dialogue: 0,0:21:23.33,0:21:25.23,Main,Nami,0,0,0,,Kaçamazsınız!
Dialogue: 0,0:21:27.66,0:21:29.25,Main,Nami,0,0,0,,Hava Bilimi!
Dialogue: 0,0:21:29.88,0:21:31.47,Main,Nami,0,0,0,,{\fad(150,150)}Thunder Breed...
Dialogue: 0,0:21:29.88,0:21:31.47,Attack,Nami,0,0,0,,{\fad(150,150)}Fırtına Doğuran...
Dialogue: 0,0:21:34.78,0:21:35.52,Main,Baby 5,0,0,0,,Yok artık!
Dialogue: 0,0:21:35.52,0:21:36.16,Main,Nami,0,0,0,,{\fad(150,150)}Tempo!
Dialogue: 0,0:21:42.05,0:21:43.84,Main,Buffalo,0,0,0,,Baby 5!
Dialogue: 0,0:21:43.84,0:21:46.20,Main,Buffalo,0,0,0,,Lanet olsun, kendinde değil!
Dialogue: 0,0:21:50.42,0:21:51.57,Main,Usopp,0,0,0,,Bu da son darbe!
Dialogue: 0,0:21:51.57,0:21:53.96,Main,Usopp,0,0,0,,Git haydi, Yiyen Bitki!
