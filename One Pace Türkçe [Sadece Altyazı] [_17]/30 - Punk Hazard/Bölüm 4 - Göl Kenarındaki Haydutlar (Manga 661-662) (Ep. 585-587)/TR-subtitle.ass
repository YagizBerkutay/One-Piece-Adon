Dialogue: 0,0:02:30.45,0:02:32.16,captions_soft,Caption,0,0,0,,{\fad(500,0)\pos(640,441)}Punk Hazard Adası, Merkez'de ki Göl
Dialogue: 0,0:02:30.45,0:02:32.16,captions_soft,Caption,0,0,0,,{\fad(500,0)\pos(640,480)}- Luffy'nin Grubu -
Dialogue: 0,0:02:29.87,0:02:32.16,Main,Brownbeard,0,0,0,,Pes etmeyin! Ateş!
Dialogue: 0,0:02:34.63,0:02:36.33,Main,Usopp,0,0,0,,Bizi dinlemiyorlar!
Dialogue: 0,0:02:36.60,0:02:38.00,Attack,Usopp,0,0,0,,{\fad(100,100)}Lastik Lastik
Dialogue: 0,0:02:38.00,0:02:39.45,Attack,Usopp,0,0,0,,{\fad(100,100)}Ashimaro Balonu {Ashimaro için not eklenebilir kinemonun alt vücuduna verilen ad}
Dialogue: 0,0:02:39.46,0:02:41.08,Main,Kinemon,0,0,0,,Şimdi ne yapıyorsun?!
Dialogue: 0,0:02:41.08,0:02:42.50,Main,Usopp,0,0,0,,Bacakcık hiç yardımcı olmuyor!
Dialogue: 0,0:02:46.81,0:02:48.06,Main,Brownbeard,0,0,0,,Şeytan Meyvesi kullanıcısı, öyle mi?
Dialogue: 0,0:02:50.20,0:02:52.15,Main,Brownbeard,0,0,0,,Bu işleri kolaylaştırır!
Dialogue: 0,0:02:53.96,0:02:55.51,Main,Brownbeard,0,0,0,,Ateş!
Dialogue: 0,0:03:09.38,0:03:11.79,Main,Brownbeard,0,0,0,,Doğrudan teknelerinin altına nişan alın!
Dialogue: 0,0:03:11.79,0:03:13.64,Main,Usopp,0,0,0,,H-Hemen geri çekilmeliyiz!
Dialogue: 0,0:03:13.64,0:03:16.03,Main,Luffy,0,0,0,,Neyden bahsediyorsun, Usopp?!
Dialogue: 0,0:03:17.60,0:03:19.63,Main,Luffy,0,0,0,,İleri!
Dialogue: 0,0:03:19.63,0:03:22.89,Main,Usopp,0,0,0,,Durumu hiç anlamıyorsun, değil mi?
Dialogue: 0,0:03:23.68,0:03:29.01,Main,Usopp,0,0,0,,Bu adamlar bizi göle batırmaya çalışıyor!
Dialogue: 0,0:03:30.96,0:03:34.44,Main,Brownbeard-sama,0,0,0,,Benden Kahverengisakal-sama'dan kaçamazsınız!
Dialogue: 0,0:03:34.44,0:03:38.14,Main,Brownbeard,0,0,0,,Ben ödülü 80,060,000 beli olan eski bir korsanım!
Dialogue: 0,0:03:42.17,0:03:45.07,Main,Brownbeard,0,0,0,,Öfkeli saldırımın tadına bak!
Dialogue: 0,0:03:49.49,0:03:51.28,Main,Luffy,0,0,0,,Kahretsin! Onlar...
Dialogue: 0,0:03:51.28,0:03:53.16,Main,Usopp,0,0,0,,Düşüyoruz!
Dialogue: 0,0:03:54.97,0:03:55.68,Main,Robin,0,0,0,,Olamaz!
Dialogue: 0,0:03:58.59,0:04:00.83,Main,Centaur,0,0,0,,Tamamdır! Başardık!
Dialogue: 0,0:04:00.83,0:04:02.03,Main,Centaur,0,0,0,,İşte patronumuz!
Dialogue: 0,0:04:02.59,0:04:05.34,Main,Centaur,0,0,0,,Teknelerini batırdı!
Dialogue: 0,0:04:08.91,0:04:10.47,Main,Brownbeard,0,0,0,,Dersinizi aldınız mı?
Dialogue: 0,0:04:10.47,0:04:15.69,Main,Brownbeard,0,0,0,,Artık okyanusun dibine batana kadar dilediğiniz gibi mücadele edebilirsiniz!
Dialogue: 0,0:04:18.34,0:04:20.85,Main,Usopp,0,0,0,,Aaaah! Çok soğuk!
Dialogue: 0,0:04:20.85,0:04:23.49,Main,Usopp,0,0,0,,Burada birkaç dakikadan fazla kalırsak buz kütlelerine dönüşeceğiz!
Dialogue: 0,0:04:23.80,0:04:27.44,Main,Usopp,0,0,0,,Karşı koymak için bolca vaktin vardı Luffy!
Dialogue: 0,0:04:28.18,0:04:31.96,Main,Usopp,0,0,0,,Ama sen aptalca şeyler söylemeye devam ettin.
Dialogue: 0,0:04:33.09,0:04:36.58,Main,Usopp,0,0,0,,O yüzden... ne olursa olsun daha dikkatli olmalısın...
Dialogue: 0,0:04:36.58,0:04:41.46,Main,Luffy,0,0,0,,Özür... Anladım...\NOnlarla daha fazla arkadaş olmak istemiyorum...
Dialogue: 0,0:04:41.46,0:04:43.47,Main,Brownbeard,0,0,0,,Tamamdır, işlerini bitirin!
Dialogue: 0,0:04:45.83,0:04:48.01,Main,Zoro,0,0,0,,Usopp!
Dialogue: 0,0:04:48.01,0:04:50.65,Main,Zoro,0,0,0,,İkisini de benim için taşı!
Dialogue: 0,0:04:50.65,0:04:53.35,Main,Zoro,0,0,0,,Onları keseceğim!
Dialogue: 0,0:04:53.35,0:04:58.15,Main,Usopp,0,0,0,,A-Acele et... Donmak...
Dialogue: 0,0:04:58.15,0:05:00.14,Main,Zoro,0,0,0,,İşlerini çabucak bitireceğim!
Dialogue: 0,0:05:01.56,0:05:03.32,Main,Usopp,0,0,0,,Ne oldu, Zoro?!
Dialogue: 0,0:05:10.51,0:05:14.25,Main,Usopp,0,0,0,,{\i1}Köpek balıkları! Neden gölde köpek balıkları var?!
Dialogue: 0,0:05:16.06,0:05:20.20,Main,Brownbeard,0,0,0,,Aptal! Burası teknik olarak okyanus sayılır!
Dialogue: 0,0:05:20.20,0:05:25.07,Main,Brownbeard,0,0,0,,Bu çukur Aokiji ve Akainu'nun savaşa başladıkları ​​noktaydı.
Dialogue: 0,0:05:25.07,0:05:30.75,Main,Brownbeard,0,0,0,,Çatlaklar adada boşluk oluşturdu, böylece deniz suyu içeri girdi ve bu gölü oluşturdu!
Dialogue: 0,0:05:30.75,0:05:33.27,Main,Brownbeard,0,0,0,,Elbette burada okyanus canlıları olacak!
Dialogue: 0,0:05:38.24,0:05:39.92,Main,Usopp,0,0,0,,Zoro!
Dialogue: 0,0:05:39.92,0:05:42.04,Main,Usopp,0,0,0,,Köpek balıkları! Korkunç! Köpek balıkları!
Dialogue: 0,0:05:42.04,0:05:44.06,Main,Usopp,0,0,0,,Zoro köpek balıkları tarafından yendi!
Dialogue: 0,0:05:46.45,0:05:50.04,Main,Brownbeard,0,0,0,,Dikkatli nişan alın! Şimdi hiçbir şey yapamazlar!
Dialogue: 0,0:05:50.04,0:05:52.74,Main,Usopp,0,0,0,,Her yerdeler! İşimiz bitti!
Dialogue: 0,0:05:52.74,0:05:55.20,Main,Brownbeard,0,0,0,,Onları paramparça edin!
Dialogue: 0,0:05:55.20,0:05:59.61,Main,Usopp,0,0,0,,Neden?! Asla hayatımın böyle biteceğini hayal etmiyordum!
Dialogue: 0,0:06:05.17,0:06:07.01,Main,Brownbeard,0,0,0,,Sonunuz geldi!
Dialogue: 0,0:06:09.54,0:06:10.50,Main,Brownbeard,0,0,0,,Fire!
Dialogue: 0,0:06:17.22,0:06:19.35,Main,Brownbeard,0,0,0,,Ne?! Ne oldu?!
Dialogue: 0,0:06:22.10,0:06:23.21,Main,Usopp,0,0,0,,Brook!
Dialogue: 0,0:06:27.69,0:06:30.23,Main,Brook,0,0,0,,Rüzgarların çoğu soğuktur,
Dialogue: 0,0:06:30.23,0:06:33.16,Main,Brook,0,0,0,,buzdan daha soğuktur.
Dialogue: 0,0:06:33.97,0:06:35.92,Main,Brook,0,0,0,,Yeraltı dünyasının gücüne tanık olun.
Dialogue: 0,0:06:37.76,0:06:40.50,Main,Brownbeard,0,0,0,,Kahrolası pislik!
Dialogue: 0,0:06:44.01,0:06:46.94,Main,Brook,0,0,0,,Sizi uyarmaya zamanım olmadı.
Dialogue: 0,0:06:46.94,0:06:49.97,Main,Brook,0,0,0,,Silah namlularını dondurdum...
Dialogue: 0,0:06:51.08,0:06:53.58,Main,Brook,0,0,0,,yani ateş ederseniz, yüzünüzde patlayacaklar!
Dialogue: 0,0:06:53.58,0:06:57.42,Main,Brownbeard,0,0,0,,Sen de kimsin, iskelet-maskeli adam?!
Dialogue: 0,0:06:57.42,0:06:59.76,Main,Brook,0,0,0,,Adımı duymaya layık değilsin.
Dialogue: 0,0:06:59.76,0:07:00.87,Main,Brook,0,0,0,,Adım Brook.
Dialogue: 0,0:07:00.87,0:07:02.19,Main,Brownbeard,0,0,0,,Yine de bana söyledin mi?
Dialogue: 0,0:07:02.67,0:07:05.25,Main,Brownbeard,0,0,0,,Yeraltı dünyasından geri geldim,
Dialogue: 0,0:07:05.25,0:07:10.20,Main,Brownbeard,0,0,0,,ve ikinci hayatımı hasır şapkalı kaptanıma adadım!
Dialogue: 0,0:07:12.74,0:07:15.82,Main,Brownbeard,0,0,0,,Ben Ruh Kralı olarak bilinirim!
Dialogue: 0,0:07:16.65,0:07:19.18,Main,Centaur,0,0,0,,Bu numarayı bizim silahlarımıza ne zaman yaptı?
Dialogue: 0,0:07:20.22,0:07:21.84,Main,Centaur,0,0,0,,Bunu yanına bırakmayacağız, kahrolası{\fscx250}-{\r}
Dialogue: 0,0:07:21.84,0:07:23.25,Main,Brook,0,0,0,,"Bunun yanına kalmasına izin vermeyeceğim"
Dialogue: 0,0:07:23.25,0:07:24.99,Main,Brook,0,0,0,,{\i1}Benim{\i0} lafım!
Dialogue: 0,0:07:27.95,0:07:28.83,Main,Centaur,0,0,0,,Kahretsin!
Dialogue: 0,0:07:28.83,0:07:30.15,Main,Centaur,0,0,0,,Nasıl yaparsın?!
Dialogue: 0,0:07:32.46,0:07:36.17,Main,Brook,0,0,0,,Tayfamı ikinci kez kaybetmeyeceğim!
Dialogue: 0,0:07:37.09,0:07:39.17,Main,Brook,0,0,0,,Sadece Buz! {saldırı adı olarak yazılmamış}
Dialogue: 0,0:07:41.94,0:07:44.81,Main,Centaur,0,0,0,,Kahretsin çok hızlı! Aşırı güçlü!
Dialogue: 0,0:07:47.04,0:07:49.52,Main,Brownbeard,0,0,0,,Köpek balıkların hepsi öldürülmüş!
Dialogue: 0,0:07:49.52,0:07:53.03,Main,Brownbeard,0,0,0,,Nereye gittiler?!
Dialogue: 0,0:07:57.03,0:07:58.37,Main,Luffy,0,0,0,,Buradayız!
Dialogue: 0,0:07:59.86,0:08:02.53,Main,Robin,0,0,0,,Mükemmel zamanda geldin, Brook.
Dialogue: 0,0:08:04.22,0:08:06.04,Main,Brook,0,0,0,,İyi olduğunuza sevindim!
Dialogue: 0,0:08:06.39,0:08:12.25,Main,Brook,0,0,0,,Tesadüfen burada garip bir adam tarafından kovalandım...
Dialogue: 0,0:08:12.25,0:08:16.45,Main,Zoro,0,0,0,,Artık haddinizi aştınız, yarı insan yarı canavar ucubeler!
Dialogue: 0,0:08:16.45,0:08:19.90,Main,Zoro,0,0,0,,Yaptığım onca eğitim köpekbalıkları gibi önemsiz...
Dialogue: 0,0:08:19.90,0:08:21.77,Main,Zoro,0,0,0,,bir şey yüzünden öleceğim kadar zayıf mı?
Dialogue: 0,0:08:26.81,0:08:31.79,Main,Zoro,0,0,0,,Ama... insan vücudu... soğuğa karşı eğitilemez...
Dialogue: 0,0:08:31.79,0:08:34.70,Main,Luffy,0,0,0,,Donuyorum... buza dönüşüyorum!
Dialogue: 0,0:08:34.70,0:08:36.88,Main,Usopp's subtitles,0,0,0,,Size söylemiştim... millet...
Dialogue: 0,0:08:36.88,0:08:38.70,Main,Usopp's subtitles,0,0,0,,donmuş toprakları geçmeye çalışmak...
Dialogue: 0,0:08:38.70,0:08:40.44,Main,Usopp's subtitles,0,0,0,,bu kıyafetlerle...
Dialogue: 0,0:08:40.88,0:08:44.95,Main,Robin,0,0,0,,Ama bakın... şanslıyız.
Dialogue: 0,0:08:44.95,0:08:49.65,Main,Robin,0,0,0,,Onlarla karşılaştığımız için... şükretmeliyiz.
Dialogue: 0,0:08:49.65,0:08:52.09,Main,Centaur,0,0,0,,Patron! Bir adım daha atmalarına izin vermeyeceğiz!
Dialogue: 0,0:08:53.82,0:08:56.52,Main,Brownbeard,0,0,0,,Bekleyin! Bunlarda tanıdık bir şeyler var!
Dialogue: 0,0:08:57.64,0:08:59.40,Main,Zoro,0,0,0,,Şurada ki uygun...
Dialogue: 0,0:08:59.76,0:09:03.23,Main,Zoro,0,0,0,,Sağdan dördüncüyü ben alıyorum!
Dialogue: 0,0:09:03.23,0:09:07.43,Main,Luffy,0,0,0,,Ben de karar verdim... Hemen yanındakini alacağım!
Dialogue: 0,0:09:07.43,0:09:09.31,Main,Robin,0,0,0,,Ben de...
Dialogue: 0,0:09:09.65,0:09:12.73,Main,Robin,0,0,0,,En soldaki kızın üstündekileri alacağım...
Dialogue: 0,0:09:13.68,0:09:15.13,Main,Centaur,0,0,0,,Neyden bahsediyorlar?
Dialogue: 0,0:09:22.81,0:09:24.94,Main,Luffy; Robin and Zoro,0,0,0,,Kıyafetleri çok sıcak görünüyor!
Dialogue: 0,0:09:24.94,0:09:26.79,Main,Usopp's subtitles,0,0,0,,Tamamdır gidelim!
Dialogue: 0,0:09:27.45,0:09:29.63,Main,Usopp's subtitles,0,0,0,,Benim için de bir tane alın!
Dialogue: 0,0:09:30.57,0:09:33.84,Main,Centaur,0,0,0,,Onlar... kıyafetlerimiz için mi geliyor?!
Dialogue: 0,0:09:33.84,0:09:36.13,Main,Centaur,0,0,0,,Ne kadar kaba! Onlar haydut mu?
Dialogue: 0,0:09:38.73,0:09:41.99,Main,Brownbeard,0,0,0,,Şimdi hatırladım! O şapka!
Dialogue: 0,0:09:46.43,0:09:51.11,Main,Brownbeard,0,0,0,,O iki yıl önceki En Kötü Nesil'in çaylaklarından biri!
Dialogue: 0,0:09:51.94,0:09:56.58,Main,Brownbeard,0,0,0,,Bu doğru... Ateş-Yumruğun küçük kardeşi
Dialogue: 0,0:09:58.44,0:10:02.82,Main,Brownbeard,0,0,0,,Dört yüz milyon ödüle sahip korsan, Hasır Şapka Luffy!
Dialogue: 0,0:10:04.70,0:10:07.49,Main,Centaur,0,0,0,,{\i1}D-Dört yüz milyon mu?!
Dialogue: 0,0:10:09.37,0:10:11.59,Main,Brownbeard,0,0,0,,Yardım edin!
Dialogue: 0,0:10:16.67,0:10:17.51,Main,Chopper,0,0,0,,Acele edin!
Dialogue: 0,0:10:18.48,0:10:20.68,Main,Chopper,0,0,0,,Çocuklar bu tarafa!
Dialogue: 0,0:10:21.05,0:10:22.64,Main,Sanji,0,0,0,,Arka çıkış kapısını bulmalıyız!
Dialogue: 0,0:10:22.64,0:10:24.26,Main,Kinemon,0,0,0,,Bekleyin!
Dialogue: 0,0:10:24.26,0:10:25.43,Main,Kinemon,0,0,0,,Geri dönün!
Dialogue: 0,0:10:25.43,0:10:28.68,Main,Kinemon,0,0,0,,O adamdı! Beni kesen adam oydu!
Dialogue: 0,0:10:28.68,0:10:30.62,Main,Chopper,0,0,0,,Ne? Gerçekten mi?!
Dialogue: 0,0:10:30.62,0:10:33.52,Main,Chopper,0,0,0,,Yani vücudun onda mı?
Dialogue: 0,0:10:33.52,0:10:36.61,Main,Kinemon,0,0,0,,Hayır... büyük ihtimalle onda değil, ancak...
Dialogue: 0,0:10:36.93,0:10:38.63,Main,Sanji,0,0,0,,O zaman acelesi yok!
Dialogue: 0,0:10:38.63,0:10:41.78,Main,Kinemon,0,0,0,,Lütfen bekle! Belki bir şey biliyor olabilir!
Dialogue: 0,0:10:41.78,0:10:46.20,Main,Sanji,0,0,0,,İlk önceliğimiz arka kapıyı bulmak!\NDenizciler ile tekrar karşılaşmak için geri dönmeyeceğiz!
Dialogue: 0,0:10:52.16,0:10:53.63,Main,Law,0,0,0,,Samuray onlarlaydı.
Dialogue: 0,0:10:53.63,0:10:56.05,Main,Chopper,0,0,0,,Acele edin!
Dialogue: 0,0:10:56.58,0:11:01.32,Main,Law,0,0,0,,Hasır Şapkaların da kaçmasına izin veremem.
Dialogue: 0,0:11:01.90,0:11:02.60,Attack,Law,0,0,0,,{\fad(100,100)}Oda
Dialogue: 0,0:11:07.06,0:11:08.20,Main,Franky,0,0,0,,Bu da ne?!
Dialogue: 0,0:11:08.20,0:11:09.85,Main,Franky,0,0,0,,Bir çeşit ince film gibi bir şey.
Dialogue: 0,0:11:15.80,0:11:17.35,Attack,Franky,0,0,0,,{\fad(100,100)}Karmaşa
Dialogue: 0,0:11:35.45,0:11:37.68,Main,Sanji,0,0,0,,Bu da ne? Garip hissediyor...
Dialogue: 0,0:11:38.68,0:11:40.88,Main,Sanji,0,0,0,,Şu an önemli olan bu değil!
Dialogue: 0,0:11:40.88,0:11:44.02,Main,Sanji,0,0,0,,Acele edin ve koşun kahrolası veletler!
Dialogue: 0,0:11:44.64,0:11:46.68,Main,Sanji,0,0,0,,Ha? Sigaramı mı düşürdüm?
Dialogue: 0,0:11:49.02,0:11:51.64,Main,Chopper,0,0,0,,Beni takip edin!
Dialogue: 0,0:11:51.64,0:11:55.65,Main,Nami,0,0,0,,Şimdi ne yapıyorsun, Sanji-kun?!
Dialogue: 0,0:11:55.65,0:12:01.74,Main,Franky,0,0,0,,Özellikle bu hafta ayrıca bir süperim! Arka kapıyı bulmamız kolay olacak!
Dialogue: 0,0:12:02.99,0:12:04.41,Main,Child,0,0,0,,Abi?
Dialogue: 0,0:12:04.41,0:12:08.98,Main,Marine,0,0,0,,Koramiralim geri çekilin!\NGüçleri fazlasıyla ürpertici!
Dialogue: 0,0:12:08.98,0:12:11.28,Main,Marine,0,0,0,,Bu adamla savaşamayız!
Dialogue: 0,0:12:11.28,0:12:15.16,Main,Law,0,0,0,,Birinizin bile kaçmasına izin veremem.
Dialogue: 0,0:12:24.93,0:12:27.68,Main,Marine,0,0,0,,Onu adanın ana kayasına bağladı?!
Dialogue: 0,0:12:27.68,0:12:29.55,Main,Marine,0,0,0,,Gemiyi tuhaf bir nesneye dönüştürdü!
Dialogue: 0,0:12:30.04,0:12:33.85,Main,Sherlock Holmes,0,0,0,,Kahretsin! Gemimiz olmadan, üsse geri dönemeyiz!
Dialogue: 0,0:12:33.85,0:12:36.36,Main,Marine,0,0,0,,Shichibukai'ler Hükümete rapor veriyor!
Dialogue: 0,0:12:36.36,0:12:39.96,Main,Marine,0,0,0,,Bize saldırmanın kurallara aykırı olduğunu biliyorsun!
Dialogue: 0,0:12:39.96,0:12:41.11,Main,Marine,0,0,0,,Trafalgar!
Dialogue: 0,0:12:41.11,0:12:42.90,Main,Marine,0,0,0,,Bunu karargaha rapor edeceğim!
Dialogue: 0,0:12:42.90,0:12:44.61,Main,Marine,0,0,0,,Görevinden alınacaksın!
Dialogue: 0,0:12:49.30,0:12:50.50,Attack,Marine,0,0,0,,{\fad(100,100)}Tarama
Dialogue: 0,0:12:46.21,0:12:47.91,Main,Law,0,0,0,,Endişelenmene gerek yok.
Dialogue: 0,0:12:51.83,0:12:54.89,Main,Marine,0,0,0,,Bu da ne?! Kesin şunu!
Dialogue: 0,0:12:58.36,0:13:00.71,Main,Marine,0,0,0,,Ha? Den Den Mushi mi?
Dialogue: 0,0:13:00.71,0:13:02.64,Main,Marine,0,0,0,,Ne? Gitmiş!
Dialogue: 0,0:13:02.64,0:13:04.80,Main,Marine,0,0,0,,Olamaz... Benimki de?!
Dialogue: 0,0:13:04.80,0:13:07.31,Main,Sherlock Holmes,0,0,0,,Onlar bizim!
Dialogue: 0,0:13:07.31,0:13:09.68,Main,Sherlock Holmes,0,0,0,,Den Den Mushi'lerimizi aldı!
Dialogue: 0,0:13:10.03,0:13:16.19,Main,Law,0,0,0,,Bu adada gördüğünüz herhangi bir şeyi Hükümete veya Karargaha bildirmenize izin veremem!
Dialogue: 0,0:13:24.04,0:13:26.96,Main,Smoker,0,0,0,,Her zaman olduğun korsan gibi davranmana izin vereceğimizi mi sanıyorsun?
Dialogue: 0,0:13:28.89,0:13:30.53,Main,Marine,0,0,0,,{\i1}Smo-ya!
Dialogue: 0,0:13:33.03,0:13:36.10,Main,Smoker,0,0,0,,Ope Ope Meyvesi yiyen ve her şeyi ameliyat edebilen bir cerrah olsan bile!
Dialogue: 0,0:13:40.12,0:13:42.62,Main,Smoker,0,0,0,,Onun saldırılarından kaçının beyler!
Dialogue: 0,0:13:45.96,0:13:48.34,Main,Marine,0,0,0,,Beni kesti!
Dialogue: 0,0:13:49.63,0:13:51.55,Main,Marine,0,0,0,,Ha? Hayattayım...
Dialogue: 0,0:13:52.81,0:13:55.65,Main,Smoker,0,0,0,,Engel oluyorsunuz! Çemberin dışına çıkın!
Dialogue: 0,0:13:55.65,0:13:57.53,Main,Marine,0,0,0,,Çember mi?!
Dialogue: 0,0:13:57.53,0:13:59.88,Main,Marine,0,0,0,,Law'ın oluşturduğu çemberin içinde olduğunuz sürece,
Dialogue: 0,0:13:59.88,0:14:01.82,Main,Marine,0,0,0,,ameliyat masasına bağlanan hastalar gibisiniz!
Dialogue: 0,0:14:03.06,0:14:04.94,Main,Marine,0,0,0,,Burası onun ameliyat odası.
Dialogue: 0,0:14:04.94,0:14:08.50,Main,Marine,0,0,0,,Bu alandaki her şeyi özgürce kontrol edebilir ve üzerinde operasyon yapabilir.
Dialogue: 0,0:14:08.50,0:14:10.16,Main,Marine,0,0,0,,O Ölüm Cerrahıdır!
Dialogue: 0,0:14:13.28,0:14:14.79,Main,Tashigi,0,0,0,,Trafalgar!
Dialogue: 0,0:14:15.87,0:14:17.37,Main,Tashigi,0,0,0,,Eğer denemeye çalıştığın şey buysa...
Dialogue: 0,0:14:17.83,0:14:19.00,Main,Smoker,0,0,0,,Dur, Tashigi!
Dialogue: 0,0:14:19.51,0:14:21.29,Main,Smoker,0,0,0,,Haki'n ona rakip olamaz!
Dialogue: 0,0:14:27.63,0:14:29.14,Main,Marine,0,0,0,,{\i1}Kaptan-chan!
Dialogue: 0,0:14:34.51,0:14:38.19,Main,Marine,0,0,0,,K-Kaptan-chan ikiye ayrıldı!
Dialogue: 0,0:14:41.98,0:14:45.78,Main,Marine,0,0,0,,Hala hayattasın değil mi, Tashigi-chan?!
Dialogue: 0,0:14:56.84,0:14:57.97,Main,Tashigi,0,0,0,,Ne...
Dialogue: 0,0:14:57.97,0:14:59.82,Main,Tashigi,0,0,0,,Ne rezalet!
Dialogue: 0,0:14:59.82,0:15:02.50,Main,Tashigi,0,0,0,,Ölümüne dövüşmeden kılıç dövüşünü kaybetmek.
Dialogue: 0,0:15:06.32,0:15:08.72,Main,Tashigi,0,0,0,,Eğer beni keseceksen, beni öldür, Trafalgar!
Dialogue: 0,0:15:14.55,0:15:17.65,Main,Law,0,0,0,,En azından bir kılıç ustasının tavrına sahipsin.
Dialogue: 0,0:15:18.98,0:15:21.60,Main,Law,0,0,0,,Bunu hatırla, denizci kadın!
Dialogue: 0,0:15:24.23,0:15:28.12,Main,Law,0,0,0,,Zayıflar hiçbir şeye, hatta nasıl öleceklerine bile karar veremezler.
Dialogue: 0,0:15:30.95,0:15:31.62,Main,Tashigi,0,0,0,,Kahrolası!
Dialogue: 0,0:15:31.62,0:15:34.22,Main,Law,0,0,0,,O kılıç...
Dialogue: 0,0:15:34.22,0:15:35.62,Main,Law,0,0,0,,bana ulaşamaz bile.
Dialogue: 0,0:15:43.06,0:15:45.97,Main,Law,0,0,0,,Ama eğer istediğin buysa seni memnuniyetle tekrar keserim.
Dialogue: 0,0:15:50.59,0:15:54.87,Main,Marine,0,0,0,,Şerefsiz! Kaptan-chan'ı küçük düşürme!
Dialogue: 0,0:15:54.87,0:15:56.55,Main,Marine,0,0,0,,Kaptan-chan, bunu bize bırak!
Dialogue: 0,0:15:56.55,0:15:59.52,Main,Marine,0,0,0,,O adi pislik delik deşik olacak!
Dialogue: 0,0:16:05.70,0:16:06.55,Main,Marine,0,0,0,,Mermiler mi?!
Dialogue: 0,0:16:08.10,0:16:11.00,Main,Marine,0,0,0,,O mermiler nereden geldi?!
Dialogue: 0,0:16:11.00,0:16:12.96,Main,Marine,0,0,0,,Bizim mermilerimiz nereye gitti?!
Dialogue: 0,0:16:12.96,0:16:15.65,Main,Law,0,0,0,,Onlar ateşlediğiniz mermilerdi.
Dialogue: 0,0:16:15.65,0:16:18.46,Main,Law,0,0,0,,Onları şuradaki kar taneleriyle yer değiştirdim.
Dialogue: 0,0:16:19.49,0:16:21.49,Main,Marine,0,0,0,,O dokunulmaz biri mi?!
Dialogue: 0,0:16:23.00,0:16:25.94,Main,Marine,0,0,0,,Eğilin! Bizi tekrar kesmeyi planlıyor!
Dialogue: 0,0:16:25.94,0:16:28.96,Main,Marine,0,0,0,,Onun saldırılarını engellemenin imkanı yok!
Dialogue: 0,0:16:30.01,0:16:31.35,Main,Marine,0,0,0,,Şerefsiz!
Dialogue: 0,0:16:31.35,0:16:33.38,Main,Marine,0,0,0,,Kaptan-chan, kaç!
Dialogue: 0,0:16:37.06,0:16:38.42,Main,Marine,0,0,0,,{\i1}Kaptan-chan!
Dialogue: 0,0:16:49.15,0:16:50.85,Main,Marine,0,0,0,,{\i1}Smo-ya!
Dialogue: 0,0:16:53.61,0:16:57.11,Main,Smoker,0,0,0,,Ölüm Cerrahı... Trafalgar Law!
Dialogue: 0,0:17:09.41,0:17:11.54,Main,Law,0,0,0,,Kötü bir enerji hissedebiliyorum.
Dialogue: 0,0:17:11.54,0:17:15.38,Main,Law,0,0,0,,Onun ucu Deniz Taşından yapılmış değil mi?
Dialogue: 0,0:17:23.64,0:17:26.42,Main,Marine,0,0,0,,Dikkat edin! Yaptığı şey çılgınca...
Dialogue: 0,0:17:27.20,0:17:29.56,Main,Marine,0,0,0,,Gemi düşüyor!
Dialogue: 0,0:17:29.56,0:17:33.02,Main,Marine,0,0,0,,Hadi çabucak buradan çıkalım!\NSadece engel oluyoruz!
Dialogue: 0,0:17:35.90,0:17:38.16,Main,Rapist,0,0,0,,Kaptan-chan, buradan çıkmalıyız!
Dialogue: 0,0:17:38.16,0:17:39.03,Main,Tashigi,0,0,0,,Ama...
Dialogue: 0,0:17:39.03,0:17:40.83,Main,Marine,0,0,0,,Bizim seviyemizin çok üstündeler!
Dialogue: 0,0:17:41.10,0:17:43.30,Attack,Marine,0,0,0,,{\fad(100,100)}Beyaz Darbe
Dialogue: 0,0:17:45.99,0:17:48.98,Main,Marine,0,0,0,,Kaçın! Çemberden dışarı çıkın!
Dialogue: 0,0:17:55.09,0:17:57.26,captions_soft,Caption,0,0,0,,{\fad(500,0)\pos(640,439)}Donmuş topraklar
Dialogue: 0,0:17:55.09,0:17:57.26,captions_soft,Caption,0,0,0,,{\fad(500,0)\pos(640,478)}- Luffy'nin Grubu -
Dialogue: 0,0:17:57.26,0:18:00.30,Main,Luffy,0,0,0,,Bu çok gürültülüydü. Belki Sanji ve diğerleridir?
Dialogue: 0,0:18:02.63,0:18:07.10,Main,Luffy,0,0,0,,Timsahtor!\NArkadaşlarım hakkında hiçbir şey bilmediğine emin misin?
Dialogue: 0,0:18:07.10,0:18:10.68,Main,Brownbeard,0,0,0,,Kapa çeneni! Sana hiçbir şey söylemeyeceğim!
Dialogue: 0,0:18:10.68,0:18:13.19,Main,Luffy,0,0,0,,Olur! O zaman daha hızlı koş!
Dialogue: 0,0:18:13.19,0:18:16.18,Main,Brownbeard,0,0,0,,Ne kadar aşağılayıcı, o sadece bir çocuk,
Dialogue: 0,0:18:17.78,0:18:22.44,Main,Brownbeard,0,0,0,,ve zalimce astlarımın paltolarını çaldılar!\NKahrolası hırsızlar!
Dialogue: 0,0:18:22.44,0:18:26.21,Main,Zoro,0,0,0,,Bu timsah adam yaptıklarından hiç de pişman görünmüyor.
Dialogue: 0,0:18:26.21,0:18:31.51,Main,Usopp,0,0,0,,O değil de Brook...\NCildin olmadığı için senin için soğuk olmuyor, değil mi?
Dialogue: 0,0:18:31.51,0:18:33.92,Main,Usopp,0,0,0,,Neden sen de bir palto aldın?
Dialogue: 0,0:18:33.92,0:18:35.01,Main,Brook,0,0,0,,Benim de duygularım var.
Dialogue: 0,0:18:35.01,0:18:39.59,Main,Robin,0,0,0,,Nami ve diğerleri için üzülüyorum. \NKaçırılmadan önce kıyafetlerini değiştiremediler.
Dialogue: 0,0:18:39.59,0:18:42.21,Main,Robin,0,0,0,,Umarım kolları ve bacakları soğuktan düşmemiştir.
Dialogue: 0,0:18:42.21,0:18:46.44,Main,Usopp,0,0,0,,Yeter artık, Robin! Bu kadar zalimce endişelenme!
Dialogue: 0,0:18:49.00,0:18:50.98,Main,Man,0,0,0,,Master, şimdi ne yapacağız?
Dialogue: 0,0:18:50.98,0:18:54.23,Main,Man,0,0,0,,Law bey ve Smoker büyük bir savaş veriyor.
Dialogue: 0,0:18:57.35,0:18:59.80,Main,Ceasar,0,0,0,,Law ne düşünüyor?
Dialogue: 0,0:18:59.80,0:19:02.03,Main,Ceasar,0,0,0,,Plan sadece onları kovmaktı.
Dialogue: 0,0:19:02.03,0:19:05.30,Main,Man,0,0,0,,Öncesinde kaçan korsanlar...
Dialogue: 0,0:19:05.30,0:19:10.20,Main,Man,0,0,0,,çocukları Bisküvi Odası'ndan aldı...\Nve girişte Law ve Smoker'la karşılaştı!
Dialogue: 0,0:19:10.21,0:19:13.25,Main,Ceasar,0,0,0,,Denizciler çocukları gördü mü?!
Dialogue: 0,0:19:13.25,0:19:14.62,Main,Man,0,0,0,,Evet.
Dialogue: 0,0:19:14.62,0:19:17.65,Main,Ceasar,0,0,0,,Yani en kötü şey oldu.
Dialogue: 0,0:19:17.65,0:19:21.02,Main,Ceasar,0,0,0,,Bu, adanın araştırılacağı anlamına geliyor!
Dialogue: 0,0:19:23.46,0:19:29.16,Main,Ceasar,0,0,0,,Şimdi Smoker'ı yok etsek bile,\NDenizciler kesinlikle şüphelenir!
Dialogue: 0,0:19:29.16,0:19:31.10,Main,Monet,0,0,0,,Sonuçta o korsanlar burada.
Dialogue: 0,0:19:31.56,0:19:34.75,Main,Ceasar,0,0,0,,Neden bu kadar erken döndün, Monet?
Dialogue: 0,0:19:35.86,0:19:37.74,Main,Monet,0,0,0,,Bu onlar, buna hiç şüphe yok.
Dialogue: 0,0:19:39.96,0:19:42.69,Main,Monet,0,0,0,,Belki daha dikkatli olmalıydık?
Dialogue: 0,0:19:43.87,0:19:46.82,Main,Monet,0,0,0,,Doğru, söylemeyi unuttum...
Dialogue: 0,0:19:46.82,0:19:51.45,Main,Monet,0,0,0,,Vegapunk'un ejderhası ve Kahverengisakal'ın Sentor takımı yenildi.
Dialogue: 0,0:19:51.46,0:19:52.95,Main,Ceasar,0,0,0,,Ne?!
Dialogue: 0,0:19:52.95,0:19:53.91,Main,Man,0,0,0,,İmkansız!
Dialogue: 0,0:19:53.91,0:19:59.04,Main,Monet,0,0,0,,Başka bir deyişle, kaçırdığınız tayfanın...
Dialogue: 0,0:19:59.04,0:20:02.05,Main,Monet,0,0,0,,yanan topraklara giren başka üyeleri de vardı.
Dialogue: 0,0:20:02.56,0:20:07.72,Main,Monet,0,0,0,,Şimdi gölü geçtiler ve buraya gelmek üzereler.
Dialogue: 0,0:20:08.98,0:20:11.86,Main,Monet,0,0,0,,Tuhaf bir şekilde güçlü göründüklerini düşündüm ve biliyorsun...
Dialogue: 0,0:20:13.40,0:20:15.73,Main,Monet,0,0,0,,Gerçekten onlar, değil mi?
Dialogue: 0,0:20:10.97,0:20:15.73,Note,Newspaper headline,0,0,0,,{\fad(350,0)}Gazete: Hasır Şapka Korsanları Tam Gücüyle Geri Dönüyor
Dialogue: 0,0:20:15.73,0:20:19.36,Main,Ceasar,0,0,0,,Hasır Şapka... Korsanları mı?
Dialogue: 0,0:20:24.35,0:20:26.37,Main,Marine,0,0,0,,Gemi yaprak gibi uçuyor!
Dialogue: 0,0:20:26.37,0:20:28.75,Main,Marine,0,0,0,,Kaptan-chan, vücudun nasıl?
Dialogue: 0,0:20:28.75,0:20:30.12,Main,Marine,0,0,0,,Düzgün bir şekilde yeniden birleştirmeyi başardık mı??
Dialogue: 0,0:20:30.12,0:20:33.48,Main,Marine,0,0,0,,Şu sağ kolun... Benim sağ bacağım!
Dialogue: 0,0:20:33.88,0:20:37.78,Main,Marine,0,0,0,,Bu kolumdakiler kimin ayağı?!
Dialogue: 0,0:20:37.80,0:20:39.96,Main,Marine,0,0,0,,Bu berbat!
Dialogue: 0,0:20:39.96,0:20:42.80,Main,Marine,0,0,0,,Karargahla irtibata geçemiyoruz ve gemimiz yok!
Dialogue: 0,0:20:42.80,0:20:46.47,Main,Marine,0,0,0,,Shichibukai'lerin dostumuz olduğunu düşünüyordum!
Dialogue: 0,0:20:48.86,0:20:51.98,Flashbacks,Smoker,0,0,0,,Tashigi, bunu unutma.
Dialogue: 0,0:20:52.55,0:20:56.37,Flashbacks,Smoker,0,0,0,,Ne olursa olsun, korsanlar her zaman korsandır.
Dialogue: 0,0:21:00.36,0:21:02.70,Main,Tashigi,0,0,0,,Korsanlar... her zaman korsandır.
Dialogue: 0,0:21:10.91,0:21:15.37,Main,Smoker,0,0,0,,En başından beri Shichibukai'lere asla güvenmiyordum.
Dialogue: 0,0:21:18.61,0:21:20.34,Main,Law,0,0,0,,Akıllıca bir karar.
Dialogue: 0,0:21:45.55,0:21:46.78,Main,Smoker,0,0,0,,Law!
Dialogue: 0,0:21:47.91,0:21:50.62,Main,Smoker,0,0,0,,Burası senin için önemli bir yer mi?!
Dialogue: 0,0:21:53.06,0:21:54.58,Main,Smoker,0,0,0,,Birinden emir alıyor olmalısın!
Dialogue: 0,0:21:56.04,0:21:59.42,Main,Smoker,0,0,0,,Bu adada... ne işler çeviriyorsun?!
Dialogue: 0,0:22:07.47,0:22:10.22,Main,Law,0,0,0,,İlk önce bana cevap ver!
Dialogue: 0,0:22:15.56,0:22:18.18,Main,Law,0,0,0,,Senin {\i1}amacın{\i0} ne?!
Dialogue: 0,0:22:38.38,0:22:42.08,Main,Law,0,0,0,,Dışarıdan bakmadan resmin tamamını göremezsin.
Dialogue: 0,0:22:42.08,0:22:43.42,Main,Law,0,0,0,,Smoker!
Dialogue: 0,0:22:46.50,0:22:47.80,Attack,Law,0,0,0,,Neşter
Dialogue: 0,0:23:07.58,0:23:09.28,Main,Smoker,0,0,0,,Kalbim...
Dialogue: 0,0:23:23.81,0:23:27.94,Main,Law,0,0,0,,Sana hiçbir şey söylemek zorunda değilim.
