ss BT,19.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.5,0.5,9,10,10,10,1Style: Hands Up lyrics,Futura Md BT,35,&H00FF762C,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2.0,0,8,10,10,30,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:02:29.97,0:02:38.72,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:11:32.10,0:11:42.10,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:21:46.15,0:21:48.24,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:02:29.87,0:02:38.62,Title,,0,0,0,,Vahşi HayvanDialogue: 0,0:02:38.89,0:02:41.36,Main,Marine,0,0,0,,Haydi bakalım, gidelim G-5!Dialogue: 0,0:02:41.36,0:02:44.87,Main,Marine,0,0,0,,Biricik Kaptanımızın dediği gibi derhal çocukları kurtaralım!Dialogue: 0,0:02:44.87,0:02:47.80,Main,Marine,0,0,0,,Burada Ceasar'dan başka Logia türü birinin daha olduğuna inanamıyorum!Dialogue: 0,0:02:47.80,0:02:50.17,Main,Marine,0,0,0,,Onunla aşık atamayız biz!Dialogue: 0,0:02:50.17,0:02:56.11,Main,Marine,0,0,0,,Kara Bacak Abi! Az önce o kadın bize saldırırken neden yardım etmedin?!Dialogue: 0,0:02:56.11,0:03:00.13,Main,Sanji,0,0,0,,Çocuklaşmayın be! Kadınlara tekme atmam ben!Dialogue: 0,0:03:00.80,0:03:04.41,Main,Marine,0,0,0,,Peki ya işin ucunda hayatının olduğu bir savaş olsaydı?Dialogue: 0,0:03:04.41,0:03:05.77,Main,Sanji,0,0,0,,Ölümü seçerdim.Dialogue: 0,0:03:06.74,0:03:08.38,Main,Marine,0,0,0,,Öyle saçmalık mı olurmuş!Dialogue: 0,0:03:08.88,0:03:12.56,Main,Marine,0,0,0,,Aynı tayfadan olmalarına rağmen hepsi de farklı farklı.Dialogue: 0,0:03:12.56,0:03:18.39,Main,Marine,0,0,0,,Az evvelki Korsan Avcısı abi önüne geleni kesebilecekmiş gibi duruyordu.Dialogue: 0,0:03:18.84,0:03:23.10,Main,Sanji,0,0,0,,Onun da kendince yumuşak yönleri vardır ama bir yolunu bulup halleder işini!Dialogue: 0,0:03:23.10,0:03:24.67,Main,Sanji,0,0,0,,Ona güvenebilirsiniz!Dialogue: 0,0:03:24.67,0:03:26.93,Main,Sanji,0,0,0,,Tashigi-chan konusunda da endişelenmeyin!Dialogue: 0,0:03:26.93,0:03:28.77,Main,Sanji,0,0,0,,Bizim amacımız şimdi...Dialogue: 0,0:03:28.77,0:03:32.89,Main,Sanji,0,0,0,,...Nami-san'la Robin-chan ve Tashigi-chan'ın gözüne girebilmek için...Dialogue: 0,0:03:32.89,0:03:34.82,Main,Sanji,0,0,0,,...o boklu veletleri kurtarmak!Dialogue: 0,0:03:34.82,0:03:36.45,Main,Marines,0,0,0,,Tamamdır!Dialogue: 0,0:03:38.12,0:03:42.47,Captions,Caption,0,0,240,,Bisküvi Odası Çıkışın ÖnüDialogue: 0,0:03:38.39,0:03:39.80,Main,Zoro,0,0,0,,Sen de git.Dialogue: 0,0:03:39.80,0:03:41.32,Main,Tashigi,0,0,0,,İstediğimi yapmakta özgürüm!Dialogue: 0,0:03:41.32,0:03:43.01,Main,Zoro,0,0,0,, Ayakbağı olacaksın!Dialogue: 0,0:03:43.01,0:03:44.82,Main,Tashigi,0,0,0,,Sen de istediğini düşünmekte özgürsün!Dialogue: 0,0:03:45.17,0:03:46.62,Main,Zoro,0,0,0,,Madem öyle...Dialogue: 0,0:03:46.62,0:03:51.03,Main,Zoro,0,0,0,,...korsan olmamdan mütevellit, senin canını ilk önce alma konusunda da...Dialogue: 0,0:03:51.06,0:03:52.89,Main,Zoro,0,0,0,,...özgür müyüm Donanma kızı?Dialogue: 0,0:03:53.59,0:03:54.55,Main,Tashigi,0,0,0,,Yapamazsın.Dialogue: 0,0:03:55.68,0:03:57.90,Main,Tashigi,0,0,0,,Aynı beni kesemeyeceğin gibi...Dialogue: 0,0:03:57.90,0:03:59.85,Main,Tashigi,0,0,0,,...bu kadını da kesemezsin!Dialogue: 0,0:03:59.85,0:04:02.07,Main,Zoro,0,0,0,,Hemen nasıl böyle bir karara varabiliyorsun?!Dialogue: 0,0:04:04.14,0:04:06.82,Main,Monet,0,0,0,,Ben de öyle düşünmüştüm.Dialogue: 0,0:04:06.82,0:04:07.97,Main,Monet,0,0,0,,Haklıymışım.Dialogue: 0,0:04:08.66,0:04:09.74,Flashbacks,Tashigi,0,0,0,,Neden beni kesmiyorsun?!Dialogue: 0,0:04:10.83,0:04:14.28,Flashbacks,Tashigi,0,0,0,,Kadınım diye mi?!Dialogue: 0,0:04:14.60,0:04:17.14,Flashbacks,Zoro,0,0,0,,Senin varlığın hiç hoşuma gitmiyor!Dialogue: 0,0:04:18.38,0:04:24.25,Flashbacks,Zoro,0,0,0,,Dinle bak! Şu yüzün var ya, uzun zaman önce ölmüş bir arkadaşımınkiyle aynı yüz!Dialogue: 0,0:04:24.25,0:04:28.69,Flashbacks,Zoro,0,0,0,,Üstelik şimdi de onunla aynı şeyleri söylüyorsun!Dialogue: 0,0:04:28.69,0:04:31.99,Flashbacks,Zoro,0,0,0,,Onu taklit etmekten vazgeç, seni sahtekar kadın!Dialogue: 0,0:04:32.79,0:04:34.93,Flashbacks,Tashigi,0,0,0,,Bu ne şimdi, çocuk musun sen?!Dialogue: 0,0:04:39.59,0:04:43.24,Main,Tashigi,0,0,0,,Kadınları kendinden aşağı görüyor, bize karşı gerçekten mücadele etmiyorsun!Dialogue: 0,0:04:43.26,0:04:44.65,Main,Tashigi,0,0,0,,Bize zarar vermeyeceksin!Dialogue: 0,0:04:44.65,0:04:46.83,Main,Tashigi,0,0,0,,Her ne kadar yenilmeyecek olsan da yenemeyeceksin de!Dialogue: 0,0:04:47.05,0:04:50.08,Main,Tashigi,0,0,0,,O yüzden burada kalmam gerekliydi!Dialogue: 0,0:04:51.17,0:04:56.79,Main,Tashigi,0,0,0,,Eğer bu Logia türü kadını adamlarımın peşinden gönderecek olursam katliam olur!Dialogue: 0,0:04:57.92,0:05:00.37,Main,Zoro,0,0,0,,Sen sanki beni küçümsüyorsun biraz?!Dialogue: 0,0:05:00.37,0:05:01.12,Main,Tashigi,0,0,0,,Öyle!Dialogue: 0,0:05:05.09,0:05:06.64,Main,Zoro,0,0,0,,İstediğini yap öyleyse.Dialogue: 0,0:05:07.28,0:05:11.73,Main,Zoro,0,0,0,,Benim görevim de onun dostlarımın peşine takılmasını engellemekti.Dialogue: 0,0:05:11.73,0:05:14.20,Main,Zoro,0,0,0,,Buradan geçmesini engellediğim müddetçe gerisinin bir önemi yok.Dialogue: 0,0:05:14.20,0:05:16.15,Main,Tashigi,0,0,0,,Nasıl bu kadar rahat olabiliyorsun?!Dialogue: 0,0:05:16.15,0:05:19.27,Main,Tashigi,0,0,0,,Zamanımızın olmadığının farkındasın! Sen de kaçsan iyi edersin!Dialogue: 0,0:05:20.79,0:05:22.28,Main,Zoro,0,0,0,,Dikkati elden bırakmayasın!Dialogue: 0,0:05:22.28,0:05:24.12,Main,Zoro,0,0,0,,Öldürme konusunda ciddi.Dialogue: 0,0:05:24.12,0:05:25.55,Main,Monet,0,0,0,,Aynen öyle!Dialogue: 0,0:05:25.55,0:05:28.40,Main,Monet,0,0,0,,Adamın zaafını benimle paylaştığın için teşekkür ederim!Dialogue: 0,0:05:29.02,0:05:33.78,Main,Monet,0,0,0,,Haki kullanabiliyor olsan da seni ısırıp öldürmem hiç zor olmayacak!Dialogue: 0,0:05:39.72,0:05:41.25,Main,Monet,0,0,0,,Ne sinir bozucu!Dialogue: 0,0:05:41.25,0:05:45.43,Main,Monet,0,0,0,,Fakat Haki, Şeytan Meyvesi yemiş kişinin gerçek formunu algılamana yardımcı olsa dahi...Dialogue: 0,0:05:45.64,0:05:50.28,Main,Monet,0,0,0,,...hızıma ayak uyduramadıkça beni yakalayamazsın!Dialogue: 0,0:05:51.22,0:05:53.10,Main,Monet,0,0,0,,Haksız mıyım?!Dialogue: 0,0:05:54.97,0:05:57.27,Main,Monet,0,0,0,,Çok soğuk bir adamsın.Dialogue: 0,0:05:57.27,0:05:59.71,Main,Zoro,0,0,0,,Kardan kadının tekinden böyle şeyler duymak istemiyorum.Dialogue: 0,0:06:00.43,0:06:01.40,Main,Tashigi,0,0,0,,Başka yerlere bakma!Dialogue: 0,0:06:03.75,0:06:05.24,Main,Monet,0,0,0,,Kar topu savaşlarını sever misin?Dialogue: 0,0:06:05.85,0:06:06.64,Main,Monet,0,0,0,,Yuki Rabbit!Dialogue: 0,0:06:05.85,0:06:06.64,Attack,Monet,0,0,0,,Kardan TavşanDialogue: 0,0:06:07.80,0:06:08.33,Main,Tashigi,0,0,0,,Soru!Dialogue: 0,0:06:07.80,0:06:08.33,Attack,Tashigi,0,0,0,,KazıDialogue: 0,0:06:12.56,0:06:14.48,Main,Monet,0,0,0,,Smoker'ın sağ kolusun...Dialogue: 0,0:06:14.48,0:06:16.66,Main,Monet,0,0,0,,Belki de seni biraz hafife almışımdır.Dialogue: 0,0:06:16.66,0:06:17.63,Main,Monet,0,0,0,,Fubuki!Dialogue: 0,0:06:16.66,0:06:17.63,Attack,Monet,0,0,0,,Kar FırtınasıDialogue: 0,0:06:21.35,0:06:22.30,Main,Zoro,0,0,0,,Hey, hey.Dialogue: 0,0:06:22.30,0:06:26.22,Main,Monet,0,0,0,,Adamlarına selamını iletirim.Dialogue: 0,0:06:26.22,0:06:28.95,Main,Monet,0,0,0,,"Ölümü çok trajik oldu." mesajıyla birlikte.Dialogue: 0,0:06:41.69,0:06:44.33,Flashbacks,Marine,0,0,0,,Omzuma ne oldu?!Dialogue: 0,0:06:48.50,0:06:51.96,Main,Monet,0,0,0,,Ne yapıyorsun be, bırak beni!Dialogue: 0,0:06:52.67,0:06:55.23,Thoughts,Tashigi,0,0,0,,Onu bırakırsam omzumu kopartacak!Dialogue: 0,0:06:55.62,0:06:59.74,Main,Monet,0,0,0,,Bu şekilde parçalara da ayırabilirim istiyorsan!Dialogue: 0,0:07:08.53,0:07:12.25,Main,Zoro,0,0,0,,Büyük konuşuyorsun ama çok yavaşsın.Dialogue: 0,0:07:13.16,0:07:15.61,Main,Zoro,0,0,0,,Vakit doldu.Dialogue: 0,0:07:15.61,0:07:18.57,Main,Zoro,0,0,0,,Artık yavaştan gitmem lazım.Dialogue: 0,0:07:18.57,0:07:22.17,Thoughts,Monet,0,0,0,,Kadına el kaldırmıyor sanıyordum.Dialogue: 0,0:07:22.17,0:07:26.65,Thoughts,Monet,0,0,0,,Ama bu adam beni kesmeye çalıştı!Dialogue: 0,0:07:28.06,0:07:30.97,Main,Zoro,0,0,0,,Beni çok hafife aldın, Kar Kadın.Dialogue: 0,0:07:30.97,0:07:34.54,Main,Zoro,0,0,0,,Beni yenemeyeceğini düşündüğün o an...Dialogue: 0,0:07:34.85,0:07:37.36,Main,Zoro,0,0,0,,...kaçıp gitmeliydin.Dialogue: 0,0:07:38.52,0:07:41.98,Main,Zoro,0,0,0,,Elbette kesmek istemediğim şeyler de var.Dialogue: 0,0:07:43.28,0:07:44.24,Main,Zoro,0,0,0,,Ama...Dialogue: 0,0:07:46.09,0:07:48.02,Main,Zoro,0,0,0,,...şuna cevap ver.Dialogue: 0,0:07:48.05,0:07:53.86,Main,Zoro,0,0,0,,Hiç ısırmayacak diye emin olabildiğin vahşi bir hayvanla karşılaştın mı hiç?Dialogue: 0,0:07:56.40,0:07:58.41,Main,Zoro,0,0,0,,Ben karşılaşmadım.Dialogue: 0,0:08:00.29,0:08:01.86,Thoughts,Monet,0,0,0,,Bu da ne?!Dialogue: 0,0:08:02.37,0:08:04.46,Thoughts,Monet,0,0,0,,Hareket edemiyorum!Dialogue: 0,0:08:04.78,0:08:06.04,Main,Zoro,0,0,0,,Ittoryu!Dialogue: 0,0:08:04.78,0:08:06.04,Attack,Zoro,0,0,0,,Tek Kılıç StiliDialogue: 0,0:08:06.91,0:08:07.77,Thoughts,Monet,0,0,0,,Kesecek beni!Dialogue: 0,0:08:13.59,0:08:14.85,Main,Zoro,0,0,0,,Daishinkan!Dialogue: 0,0:08:13.59,0:08:14.85,Attack,Zoro,0,0,0,,Büyük Ejderha ŞokuDialogue: 0,0:08:24.28,0:08:26.60,Main,Zoro,0,0,0,,İstediğinizi aldınız mı şimdi?Dialogue: 0,0:08:26.97,0:08:28.40,Thoughts,Tashigi,0,0,0,,Kesti!Dialogue: 0,0:08:34.90,0:08:39.07,Main,Monet,0,0,0,,Dalga geçiyor!Dialogue: 0,0:08:41.58,0:08:42.99,Main,Tashigi,0,0,0,,Hâlâ yaşıyor!Dialogue: 0,0:08:48.13,0:08:51.44,Main,Tashigi,0,0,0,,Haki kullanmadı mı yoksa?!Dialogue: 0,0:09:04.18,0:09:06.44,Thoughts,Tashigi,0,0,0,,Bedenine söz geçiremiyor.Dialogue: 0,0:09:07.43,0:09:12.68,Thoughts,Tashigi,0,0,0,,Haki kullansaydı ölmüş olacağı gerçeği ve sahip olduğu devasa güç karşısında korkmuş oluşu...Dialogue: 0,0:09:14.09,0:09:16.47,Thoughts,Tashigi,0,0,0,,Böyle bir galibiyete hiç şahit olmamıştım!Dialogue: 0,0:09:17.09,0:09:22.38,Thoughts,Tashigi,0,0,0,,Hasır Şapkalar iki yıl önce ortadan kaybolduklarından beri acaba nerelerde, neler yapıyorlardı?Dialogue: 0,0:09:23.20,0:09:27.18,Thoughts,Tashigi,0,0,0,,Ne kadar güçlenmiş olabilir bu insanlar?!Dialogue: 0,0:09:28.02,0:09:29.78,Main,Monet,0,0,0,,Kaçamayacaksın!Dialogue: 0,0:09:31.05,0:09:32.07,Main,Tashigi,0,0,0,,Kiri Shigure!Dialogue: 0,0:09:31.05,0:09:32.07,Attack,Tashigi,0,0,0,,Güz Yağmuru KesimiDialogue: 0,0:09:36.45,0:09:39.40,Main,Tashigi,0,0,0,,Kaybettin.Dialogue: 0,0:09:53.51,0:09:55.19,Main,Tashigi,0,0,0,,Bu da neydi şimdi?!Dialogue: 0,0:09:55.19,0:09:58.34,Main,Tashigi,0,0,0,,Sonuçta öldürmedin onu işte!Dialogue: 0,0:09:58.61,0:10:02.16,Main,Tashigi,0,0,0,,Aynı dediğim gibi işte sen-Dialogue: 0,0:10:02.16,0:10:05.47,Main,Zoro,0,0,0,,Araya atlamanı ben istemedim, o yüzden saçma salak konuşma.Dialogue: 0,0:10:05.47,0:10:09.02,Main,Zoro,0,0,0,,Sen öldürmeseydin ben öldürecektim.Dialogue: 0,0:10:09.75,0:10:13.79,Main,Tashigi,0,0,0,,Yalan söyleme! Hiç adil değil bu! Ben kestim onu işte!Dialogue: 0,0:10:13.79,0:10:15.58,Main,Zoro,0,0,0,,Hiç gerek yoktu.Dialogue: 0,0:10:16.82,0:10:18.49,Main,Zoro,0,0,0,,Ama...Dialogue: 0,0:10:19.76,0:10:25.22,Main,Zoro,0,0,0,,...aferin, Kaptan Gözlük. İnsanların peşine takılmasını engellemiş oldun.Dialogue: 0,0:10:25.99,0:10:28.15,Main,Zoro,0,0,0,,Övgüler senin olsun.Dialogue: 0,0:10:29.59,0:10:32.66,Main,Tashigi,0,0,0,,Neden hep böyle üstümmüş gibi konuşuyorsun ya?!Dialogue: 0,0:10:32.66,0:10:34.50,Main,Zoro,0,0,0,,Öyleyim de ondan.Dialogue: 0,0:10:37.06,0:10:40.74,Main,Children,0,0,0,,Mocha! Şekeri ver!Dialogue: 0,0:10:43.56,0:10:44.88,Main,Mocha,0,0,0,,Abla!Dialogue: 0,0:10:44.88,0:10:45.81,Main,Nami,0,0,0,,Haydi, acele et!Dialogue: 0,0:10:49.12,0:10:51.84,Main,Child,0,0,0,,Bırak beni, ne yapıyorsun!Dialogue: 0,0:10:51.84,0:10:53.89,Main,Chopper,0,0,0,,Uslu dur, sakinleştirici bu!Dialogue: 0,0:10:57.85,0:10:59.87,Main,Child,0,0,0,,Neredeyim ben?Dialogue: 0,0:11:00.10,0:11:01.30,Main,Sind,0,0,0,,Bu bizi durduramaz!Dialogue: 0,0:11:01.65,0:11:03.65,Main,Chopper,0,0,0,,Olamaz, çocukların peşinden gidelim!Dialogue: 0,0:11:03.65,0:11:04.42,Main,Robin,0,0,0,,Peki!Dialogue: 0,0:11:04.42,0:11:06.22,Main,Children,0,0,0,,Ver şekeri!Dialogue: 0,0:11:07.91,0:11:08.59,Main,Sind,0,0,0,,Bekle!Dialogue: 0,0:11:09.65,0:11:10.93,Main,Nami,0,0,0,,Milky Ball!Dialogue: 0,0:11:09.65,0:11:10.93,Attack,Nami,0,0,0,,Bulut TopuDialogue: 0,0:11:13.13,0:11:13.70,Main,Doran,0,0,0,,Yine aynı şey!Dialogue: 0,0:11:13.70,0:11:15.96,Main,Nami,0,0,0,,Böyle bir yere varamıyoruz!Dialogue: 0,0:11:15.96,0:11:17.76,Main,Nami,0,0,0,,Daha ne kadar koşacak bu kız!?Dialogue: 0,0:11:23.27,0:11:24.26,Main,Mocha,0,0,0,,Burası neresi?Dialogue: 0,0:11:24.58,0:11:28.87,Main,Mocha,0,0,0,,Artık ne tarafa gideceğimi bilmiyorum!Dialogue: 0,0:11:30.35,0:11:33.07,Captions,,0,0,180,,Bisküvi OdasıDialogue: 0,0:11:30.35,0:11:33.07,Captions,,0,0,180,,Kazanan: Zoro Shinokuni'nin B binasını doldurmasına 10 dakika kaldı.Dialogue: 0,0:11:38.54,0:11:41.47,Main,Tashigi,0,0,0,,Ölümcül gaz Bisküvi Odasına mı doluyor?!Dialogue: 0,0:11:42.40,0:11:43.41,Main,Zoro,0,0,0,,Ne oldu şimdi?!Dialogue: 0,0:11:43.41,0:11:44.90,Main,Tashigi,0,0,0,,Çıkış o tarafta değil!Dialogue: 0,0:11:45.29,0:11:47.75,Main,Tashigi,0,0,0,,Adamlarıma yetişmeden önce indir beni!Dialogue: 0,0:11:47.75,0:11:48.97,Main,Zoro,0,0,0,,Bu nasıl bir gurur arkadaş!Dialogue: 0,0:11:49.56,0:11:52.24,Main,Zoro,0,0,0,,Çok istiyorsan hemen omzumdan atıvereyim!Dialogue: 0,0:11:52.24,0:11:53.24,Main,Zoro,0,0,0,,Ne oldu?!Dialogue: 0,0:11:53.24,0:11:56.45,Main,Tashigi,0,0,0,,Bu gerçekten de efsanevi Meitou Shuusui mi?!Dialogue: 0,0:11:53.24,0:11:56.45,Note,,0,0,0,,Shuusui: Saf Güz SuyuDialogue: 0,0:11:56.45,0:11:59.59,Main,Zoro,0,0,0,,Dokunma! Kapa çeneni de tutunmaya bak seni katana manyağı!Dialogue: 0,0:12:02.17,0:12:04.53,Main,Mocha,0,0,0,,Olmaz!Dialogue: 0,0:12:04.53,0:12:05.32,Main,Chopper,0,0,0,,Mocha?Dialogue: 0,0:12:05.32,0:12:08.27,Main,Mocha,0,0,0,,Konbu, Biyo yapmayın! Beni dinleyin lütfen!Dialogue: 0,0:12:08.99,0:12:09.51,Main,Chopper,0,0,0,,Mocha!Dialogue: 0,0:12:09.51,0:12:12.58,Main,Nami,0,0,0,,Olamaz! Kimisi başka yerden dolanmış!Dialogue: 0,0:12:13.23,0:12:16.87,Main,Chopper,0,0,0,,Olamaz! Şekeri yiyecek olurlarsa en başa döneceğiz!Dialogue: 0,0:12:16.87,0:12:19.10,Main,Chopper,0,0,0,,Mocha'yı çocuklardan ayırmamız lazım!Dialogue: 0,0:12:19.65,0:12:22.44,Main,Mocha,0,0,0,,Ben evime dönmek istiyorum!Dialogue: 0,0:12:28.95,0:12:31.46,Main,Biyo,0,0,0,,Hepsini yedi!Dialogue: 0,0:12:31.46,0:12:32.35,Main,Nami,0,0,0,,Mocha!Dialogue: 0,0:12:32.35,0:12:33.68,Main,Robin,0,0,0,,Ne yapıyor bu kız!?Dialogue: 0,0:12:33.68,0:12:35.25,Main,Sind,0,0,0,,Ver onları, Mocha!Dialogue: 0,0:12:35.25,0:12:36.73,Main,Doran,0,0,0,,Lanet olası!Dialogue: 0,0:12:36.73,0:12:38.60,Main,Konbu,0,0,0,,Ne cüretle hepsini kendin yersin, aptal!Dialogue: 0,0:12:41.26,0:12:46.24,Main,Chopper,0,0,0,,Mocha!Dialogue: 0,0:12:47.75,0:12:49.91,Main,Chopper,0,0,0,,Olmaz, tükür onları!Dialogue: 0,0:12:49.91,0:12:51.20,Main,Chopper,0,0,0,,Mocha, duyuyor musun beni?!Dialogue: 0,0:12:51.20,0:12:53.38,Main,Chopper,0,0,0,,Mocha!Dialogue: 0,0:12:55.97,0:12:58.53,Main,Chopper,0,0,0,,Onların nasıl birer uyuşturucu olduğunu söyledim sana!Dialogue: 0,0:13:00.69,0:13:01.87,Thoughts,Mocha,0,0,0,,Chopper-chan.Dialogue: 0,0:13:03.45,0:13:06.03,Thoughts,Mocha,0,0,0,,Onlar benim...Dialogue: 0,0:13:07.44,0:13:09.35,Thoughts,Mocha,0,0,0,,...arkadaşlarım!Dialogue: 0,0:13:11.45,0:13:13.99,Main,Chopper,0,0,0,,Yapma!Dialogue: 0,0:13:15.01,0:13:16.36,Flashbacks,Mocha,0,0,0,,Söz!Dialogue: 0,0:13:23.12,0:13:26.05,Flashbacks,Sind,0,0,0,,Büyüyünce...Dialogue: 0,0:13:27.67,0:13:30.55,Flashbacks,Sind,0,0,0,,Hepimiz büyüyünce denizlere açılalım!Dialogue: 0,0:13:30.55,0:13:32.69,Flashbacks,Children,0,0,0,,Denizlere mi?!Dialogue: 0,0:13:32.69,0:13:34.03,Flashbacks,Biyo,0,0,0,,Balık tutmaya mı?Dialogue: 0,0:13:34.03,0:13:37.40,Flashbacks,Sind,0,0,0,,Amma aptalsın var ya, maceralara atılmak için elbette!Dialogue: 0,0:13:37.40,0:13:40.18,Flashbacks,Sind,0,0,0,,Altından adalar misali şeylerin peşine düşeceğiz!Dialogue: 0,0:13:40.18,0:13:42.05,Flashbacks,Doran,0,0,0,,Kulağa eğlenceli geliyor!Dialogue: 0,0:13:42.05,0:13:47.54,Flashbacks,Sind,0,0,0,,İyileşip evlerimize döndüğümüzde, birbirimizden kopmayacak mıyız?Dialogue: 0,0:13:47.54,0:13:51.03,Flashbacks,Sind,0,0,0,,Büyüdüğümüzde denizlere açılırsak eminim yine karşılaşırız!Dialogue: 0,0:13:51.03,0:13:56.07,Flashbacks,Konbu,0,0,0,,Anlıyorum! Ne güzel! En sevdiğim arkadaşlarımsınız artık!Dialogue: 0,0:13:58.93,0:14:01.37,Flashbacks,Biyo,0,0,0,,Denizlere ne zaman açılacağız peki?Dialogue: 0,0:14:03.34,0:14:06.43,Flashbacks,Sind,0,0,0,,Bir düşüneyim...Dialogue: 0,0:14:07.70,0:14:09.63,Flashbacks,Sind,0,0,0,,Yirmi yaşımıza bastığımızda!Dialogue: 0,0:14:09.63,0:14:11.59,Flashbacks,Konbu,0,0,0,,Amma da çok varmış yahu!Dialogue: 0,0:14:11.59,0:14:15.55,Flashbacks,Sind,0,0,0,,İşin heyecanı da orada ya zaten!Dialogue: 0,0:14:15.55,0:14:16.48,Flashbacks,Doran,0,0,0,,Doğru gerçekten de!Dialogue: 0,0:14:16.48,0:14:19.71,Flashbacks,Sind,0,0,0,,Haydi söz verelim öyleyse!Dialogue: 0,0:14:23.52,0:14:26.31,Flashbacks,Mocha,0,0,0,,Yani Master kötü biri mi?!Dialogue: 0,0:14:26.31,0:14:28.88,Flashbacks,Chopper,0,0,0,,Evet, çok kötü birisi.Dialogue: 0,0:14:28.88,0:14:31.14,Flashbacks,Mocha,0,0,0,,O nazik adam mı?!Dialogue: 0,0:14:31.14,0:14:35.01,Flashbacks,Mocha,0,0,0,,Bize her gün leziz mi leziz şekerler veren adam mı?!Dialogue: 0,0:14:35.92,0:14:37.15,Flashbacks,Chopper,0,0,0,,Kandırıyor sizi.Dialogue: 0,0:14:37.15,0:14:39.83,Flashbacks,Mocha,0,0,0,,Ne? Yalan! Böyle bir şey...Dialogue: 0,0:14:41.26,0:14:44.52,Flashbacks,Chopper,0,0,0,,Sizler onun için birer deneksiniz!Dialogue: 0,0:14:44.52,0:14:46.57,Flashbacks,Mocha,0,0,0,,De-Denek miyiz?!Dialogue: 0,0:14:46.57,0:14:48.59,Flashbacks,Sind,0,0,0,,Mocha, aç şu kapıyı!Dialogue: 0,0:14:48.59,0:14:51.51,Flashbacks,Sind,0,0,0,,Bisküvi Odası'na gideceğiz!Dialogue: 0,0:14:54.53,0:14:58.05,Flashbacks,Chopper,0,0,0,,Siz aslında hiç hasta olmadınız.Dialogue: 0,0:14:58.05,0:14:59.36,Flashbacks,Mocha,0,0,0,,Ol-Olamaz!Dialogue: 0,0:14:59.36,0:15:01.69,Flashbacks,Chopper,0,0,0,,Bu devasa vücudun da bunun kanıtı!Dialogue: 0,0:15:02.43,0:15:05.51,Flashbacks,Chopper,0,0,0,,İnsanların devleştirilmesinin...Dialogue: 0,0:15:05.51,0:15:09.43,Flashbacks,Chopper,0,0,0,,...tüm dünyada asırlardır erişilmeye çalışılan bir şey olduğunu duymuştum.Dialogue: 0,0:15:09.43,0:15:15.41,Flashbacks,Chopper,0,0,0,,Yani anlayacağın bu asırlardır sürmekte olan ve hiçbir şekilde başarı sağlanamamış bir deney.Dialogue: 0,0:15:15.96,0:15:18.64,Flashbacks,Chopper,0,0,0,,Bunu duymak zor gelebilir ama...Dialogue: 0,0:15:21.82,0:15:23.51,Flashbacks,Chopper,0,0,0,,...bu deney de...Dialogue: 0,0:15:25.02,0:15:26.58,Flashbacks,Chopper,0,0,0,,...başarısız olmaya mahkum!Dialogue: 0,0:15:28.18,0:15:30.51,Flashbacks,Chopper,0,0,0,,Caesar da bunun farkında.Dialogue: 0,0:15:30.74,0:15:34.36,Flashbacks,Chopper,0,0,0,,Aklıma bir sonraki deneyi için veri toplamaya çalıştığından başka bir şey gelmiyor.Dialogue: 0,0:15:36.11,0:15:39.43,Flashbacks,Mocha,0,0,0,,Peki bize ne olacak?Dialogue: 0,0:15:39.43,0:15:43.60,Flashbacks,Chopper,0,0,0,,Öleceksiniz. Hiçbiriniz evlerinize dönemeyeceksiniz.Dialogue: 0,0:15:44.45,0:15:47.12,Flashbacks,Chopper,0,0,0,,O leziz şekerler çok tehlikeli birer zehir!Dialogue: 0,0:15:47.12,0:15:50.71,Flashbacks,Chopper,0,0,0,,Farkına bile varamadan vücudununu mahvedecek.Dialogue: 0,0:15:50.71,0:15:54.04,Flashbacks,Chopper,0,0,0,,Buna rağmen bir yedin mi bir daha yemek isteyeceksiniz.Dialogue: 0,0:15:54.04,0:15:57.73,Flashbacks,Chopper,0,0,0,,Yedikçe Caesar'dan uzaklaşmanız da zorlaşacak!Dialogue: 0,0:15:58.37,0:16:02.54,Flashbacks,Chopper,0,0,0,,Kapının öte yanındaki çocukların halini görünce durumun vehametini anlayabiliyorsun değil mi?Dialogue: 0,0:16:10.52,0:16:16.40,Flashbacks,Chopper,0,0,0,,Sana sakinleştirici verdim ama şeker ve deneyin bir yan etkisi olarak...Dialogue: 0,0:16:16.40,0:16:17.24,Flashbacks,Chopper,0,0,0,,...büyük bir ihtimalle...Dialogue: 0,0:16:18.28,0:16:23.15,Flashbacks,Chopper,0,0,0,,...yetişkin olamadan evvel öleceksin.Dialogue: 0,0:16:27.75,0:16:29.94,Main,Chopper,0,0,0,,Mocha!Dialogue: 0,0:16:30.97,0:16:34.78,Flashbacks,Mocha,0,0,0,,Yetişkin birer kişi bile olamayacak mıyız biz?Dialogue: 0,0:16:35.80,0:16:39.75,Flashbacks,Mocha,0,0,0,,Anne babalarımızı göremeyecek miyiz?Dialogue: 0,0:16:40.90,0:16:43.06,Flashbacks,Chopper,0,0,0,,Derhal buradan kaçmazsanız evet.Dialogue: 0,0:16:43.87,0:16:48.06,Flashbacks,Mocha,0,0,0,,Böyle bir şey aklımın ucundan bile geçmedi.Dialogue: 0,0:16:48.06,0:16:52.18,Flashbacks,Mocha,0,0,0,,Evlerimize gitmek istediğimiz için sizden yardım istedik!Dialogue: 0,0:16:52.18,0:16:53.85,Flashbacks,Mocha,0,0,0,,Hastalığımızı bile bilemeden...Dialogue: 0,0:16:53.88,0:16:57.23,Flashbacks,Mocha,0,0,0,,...bir yıl daha burada kalacaksın diyecekler diye çok korktuk!Dialogue: 0,0:17:00.41,0:17:01.33,Flashbacks,Mocha,0,0,0,,Ama...Dialogue: 0,0:17:04.58,0:17:08.12,Flashbacks,Mocha,0,0,0,,Öleceğimiz aklımızın ucundan bile geçmedi.Dialogue: 0,0:17:09.47,0:17:12.08,Flashbacks,Mocha,0,0,0,,Er ya da geç birer yetişkin olacağız diye düşünmüştük!Dialogue: 0,0:17:12.08,0:17:14.20,Flashbacks,Mocha,0,0,0,,Bize böyle söylemediler!Dialogue: 0,0:17:14.90,0:17:17.49,Flashbacks,Mocha,0,0,0,,Şekeri verdikleri için yedik!Dialogue: 0,0:17:17.49,0:17:19.76,Flashbacks,Mocha,0,0,0,,Hiçbirimiz öleceğimizi düşünmedik!Dialogue: 0,0:17:19.76,0:17:23.52,Flashbacks,Chopper,0,0,0,,Biliyorum! Sizin hiçbir suçunuz yok!Dialogue: 0,0:17:23.52,0:17:27.19,Flashbacks,Chopper,0,0,0,,O yüzden de Caesar'ı affedemeyiz!Dialogue: 0,0:17:27.92,0:17:29.03,Flashbacks,Chopper,0,0,0,,Onu affetmeyeceğiz!Dialogue: 0,0:17:32.53,0:17:33.64,Flashbacks,Chopper,0,0,0,,Özür dilerim!Dialogue: 0,0:17:36.11,0:17:40.46,Flashbacks,Chopper,0,0,0,,Sizi daha erken bulamadığımız için bağışla!Dialogue: 0,0:17:40.95,0:17:44.26,Flashbacks,Mocha,0,0,0,,Chopper-chan, biz...Dialogue: 0,0:17:44.26,0:17:46.68,Flashbacks,Mocha,0,0,0,,...ölmek istemiyoruz!Dialogue: 0,0:17:46.68,0:17:48.25,Flashbacks,Chopper,0,0,0,,Ölmeyeceksiniz!Dialogue: 0,0:17:48.25,0:17:49.74,Flashbacks,Chopper,0,0,0,,Sizi ne pahasına olursa olsun kurtaracağız!Dialogue: 0,0:17:52.44,0:17:58.07,Flashbacks,Chopper,0,0,0,,Caesar çok güçlü, çok korkunç, kötü bir adam.Dialogue: 0,0:17:58.07,0:17:59.81,Flashbacks,Chopper,0,0,0,,Ama, fakat...Dialogue: 0,0:18:00.58,0:18:04.45,Flashbacks,Chopper,0,0,0,,Kaptanımız ondan çok daha güçlüdür!Dialogue: 0,0:18:04.45,0:18:07.78,Flashbacks,Chopper,0,0,0,,Bir gün bu denizlerin kralı olacak adam o!Dialogue: 0,0:18:07.99,0:18:12.14,Flashbacks,Chopper,0,0,0,,Caesar, Luffy'den cezasını mutlaka çekecek!Dialogue: 0,0:18:14.31,0:18:19.16,Flashbacks,Chopper,0,0,0,,O yüzden dinle beni. Mocha'ydı değil mi adın?Dialogue: 0,0:18:19.16,0:18:23.39,Flashbacks,Chopper,0,0,0,,Diğerlerinin daha fazla şeker yemesine izin veremeyiz!Dialogue: 0,0:18:25.56,0:18:29.87,Flashbacks,Chopper,0,0,0,,Ben burada onlara sakinleştirici vermeye çalışacağım!Dialogue: 0,0:18:31.27,0:18:35.97,Flashbacks,Chopper,0,0,0,,O yüzden de Mocha, Bisküvi Odası'ndaki şekerleri senin korumanı istiyorum.Dialogue: 0,0:18:37.00,0:18:37.77,Flashbacks,Mocha,0,0,0,,Peki.Dialogue: 0,0:18:38.28,0:18:42.26,Flashbacks,Mocha,0,0,0,,Anladım! Kimsenin şeker yemesine izin vermeyeceğim!Dialogue: 0,0:18:42.26,0:18:44.59,Flashbacks,Mocha,0,0,0,,Hep birlikte evimize dönmek istiyorum!Dialogue: 0,0:18:44.59,0:18:45.33,Flashbacks,Chopper,0,0,0,,Aynen öyle!Dialogue: 0,0:18:50.08,0:18:52.09,Main,Konbu,0,0,0,,Mocha kan kustu!Dialogue: 0,0:18:52.09,0:18:54.50,Main,Biyo,0,0,0,,Leziz mi leziz şekerler niye böyle yaptı?Dialogue: 0,0:18:57.58,0:18:58.99,Main,Nami,0,0,0,,İnanamıyorum!Dialogue: 0,0:18:58.99,0:19:00.51,Main,Robin,0,0,0,,Çocuklar duruldular!Dialogue: 0,0:19:02.89,0:19:04.96,Main,Child,0,0,0,,Aç gözlülük yaparsan böyle olur!Dialogue: 0,0:19:07.33,0:19:08.18,Main,Child,0,0,0,,Neden?Dialogue: 0,0:19:08.57,0:19:11.86,Main,Chopper,0,0,0,,Şeker size işte bunu yapıyor!Dialogue: 0,0:19:12.11,0:19:15.57,Main,Chopper,0,0,0,,Mocha sizi kurtarabilmek için...Dialogue: 0,0:19:15.57,0:19:18.63,Main,Chopper,0,0,0,,...kendini feda etti!Dialogue: 0,0:19:18.63,0:19:22.35,Main,Nami,0,0,0,,Chopper, sakinleştiriciyi vereceksen şimdi tam zamanı!Dialogue: 0,0:19:22.35,0:19:24.79,Main,Chopper,0,0,0,,Ama önce onu tedavi etmem lazım!Dialogue: 0,0:19:24.79,0:19:26.05,Main,Robin,0,0,0,,Fazla zamanımız yok!Dialogue: 0,0:19:26.05,0:19:28.42,Main,Sanji,0,0,0,,Çocuklar hareketsizler!Dialogue: 0,0:19:29.90,0:19:31.61,Main,Sanji,0,0,0,,Yardırın!Dialogue: 0,0:19:36.78,0:19:40.59,Main,Sanji,0,0,0,,Kibar olun ahali!Dialogue: 0,0:19:40.59,0:19:42.56,Main,Marine,0,0,0,,Tamamdır!Dialogue: 0,0:19:42.56,0:19:45.06,Main,Sanji,0,0,0,,Sayıya sayıyla karşılık verin!Dialogue: 0,0:19:47.26,0:19:49.44,Main,Sanji,0,0,0,,Kontrol altına alın şunları!Dialogue: 0,0:19:50.22,0:19:52.23,Main,Marine,0,0,0,,Tamamdır!Dialogue: 0,0:19:52.23,0:19:53.36,Main,Nami,0,0,0,,Sanji-kun?!Dialogue: 0,0:19:53.36,0:19:54.07,Main,Robin,0,0,0,,Donanma mı?Dialogue: 0,0:19:54.07,0:19:57.04,Main,Marine,0,0,0,,Abi, incilerden yakalasak kaba kuvvet kullanmış olur muyuz?Dialogue: 0,0:19:59.16,0:20:00.37,Main,Sanji,0,0,0,,Ucu ucuna evet.Dialogue: 0,0:20:00.37,0:20:01.37,Main,Marine,0,0,0,,Tamam öyleyse!Dialogue: 0,0:20:01.37,0:20:02.85,Main,Sanji,0,0,0,,Tıbbi ekip, sıra sizde!Dialogue: 0,0:20:02.85,0:20:04.50,Main,Marine,0,0,0,,Emredersiniz!Dialogue: 0,0:20:04.50,0:20:06.34,Main,Sanji,0,0,0,,Chopper, bunların eti senin kemiği benim!Dialogue: 0,0:20:06.34,0:20:07.66,Main,Sanji,0,0,0,,İğne vurmayı biliyorlar!Dialogue: 0,0:20:08.73,0:20:09.41,Main,Chopper,0,0,0,,Tamamdır!Dialogue: 0,0:20:09.41,0:20:12.15,Main,Marine,0,0,0,,Haydi bakalım, sakinleşin çocuklar!Dialogue: 0,0:20:12.15,0:20:13.69,Main,Marine,0,0,0,,İleri!Dialogue: 0,0:20:13.69,0:20:17.22,Main,Chopper,0,0,0,,Yanılmıyorsam buralarda bir muayene odası vardı!Dialogue: 0,0:20:17.22,0:20:19.32,Main,Chopper,0,0,0,,Oraya götürelim!Dialogue: 0,0:20:19.32,0:20:22.04,Main,Marine,0,0,0,,Zamanımız yok! Farkındasın değil mi, rakun?!Dialogue: 0,0:20:22.04,0:20:23.08,Main,Chopper,0,0,0,,Evet, biliyorum!Dialogue: 0,0:20:24.26,0:20:25.34,Thoughts,Nami,0,0,0,,Mocha...Dialogue: 0,0:20:25.83,0:20:29.10,Thoughts,Chopper,0,0,0,,Kahretsin, benim yüzümden!Dialogue: 0,0:20:30.96,0:20:32.33,Main,Mocha,0,0,0,,Chopper-chan...Dialogue: 0,0:20:33.17,0:20:34.74,Main,Chopper,0,0,0,,Mocha, iyi misin?Dialogue: 0,0:20:34.74,0:20:35.62,Main,Mocha,0,0,0,,Ben...Dialogue: 0,0:20:38.95,0:20:42.29,Main,Mocha,0,0,0,,...şekerleri vermedim.Dialogue: 0,0:20:43.59,0:20:47.43,Main,Chopper,0,0,0,,Evet! Arkadaşlarını korudun değil mi?Dialogue: 0,0:20:47.43,0:20:48.54,Main,Chopper,0,0,0,,Teşekkür ederim.Dialogue: 0,0:20:48.54,0:20:49.95,Main,Chopper,0,0,0,,Teşekkür ederim!Dialogue: 0,0:20:50.77,0:20:53.91,Main,Chopper,0,0,0,,Sayende hepsi de evlerine dönebilecekler!Dialogue: 0,0:20:54.94,0:20:58.16,Main,Chopper,0,0,0,,Mocha, ne pahasına olursa olsun seni de kurtaracağım!Dialogue: 0,0:20:59.19,0:21:00.63,Main,Chopper,0,0,0,,Sana söz veriyorum...Dialogue: 0,0:21:03.17,0:21:05.30,Main,Chopper,0,0,0,,...daha çok yaşayacaksın!Dialogue: 0,0:21:10.31,0:21:13.08,Captions,,0,0,180,,C Binası 1. Kat, ÇöplükDialogue: 0,0:21:12.36,0:21:13.08,Main,Gasmask soldier,0,0,0,,Ne oldu?!Dialogue: 0,0:21:20.63,0:21:22.45,Main,Gasmask soldier,0,0,0,,Hasır Şapkalı Luffy!Dialogue: 0,0:21:33.84,0:21:35.67,Main,Luffy,0,0,0,,Caesar nerede?Dialogue: 0,0:21:36.46,0:21:40.25,Main,Gasmask soldier,0,0,0,,Buradan dümdüz devam et, R binasında!Dialogue: 0,0:21:41.92,0:21:43.32,Main,Luffy,0,0,0,,Öyle demek?Dialogue: 0,0:21:44.16,0:21:46.11,Main,Luffy,0,0,0,,Anlaşılmıştır.Dialogue: 0,0:00:24.16,0:00:27.42,Credits,,0,0,0,,Translation & initial syncing Yibis FansubsDialogue: 0,0:00:27.62,0:00:30.69,Credits,,0,0,0,,Syncing Galaxy 9000  Sync-checking SewilDialogue: 0,0:00:31.15,0:00:34.30,Credits,,0,0,0,,Quality-checking SewilDialogue: 0,0:00:34.80,0:00:38.39,Credits,,0,0,0,,Soundtracking HaleeDialogue: 0,0:00:41.38,0:00:43.65,Credits,,0,0,0,,Video editing SewilDialogue: 0,0:00:00.20,0:00:05.07,Hands Up lyrics,,0,0,0,,♪ Kaldır ellerini daha da yukarıya, hayallerini dök şarkılara. ♪Dialogue: 0,0:00:05.14,0:00:08.72,Hands Up lyrics,,0,0,0,,♪ Yıkılma hiçbir zaman, sarsılmaz bayrağını kaldır göklere. ♪Dialogue: 0,0:00:08.80,0:00:12.27,Hands Up lyrics,,0,0,0,,♪ Buralara kadar gelebilmek için pek çok duvarı yıkıp geçtik! ♪Dialogue: 0,0:00:12.34,0:00:17.68,Hands Up lyrics,,0,0,0,,♪ Hedef gelecek, haydi eller havaya!! ♪Dialogue: 0,0:00:23.31,0:00:30.66,Hands Up lyrics,,0,0,0,,♪ Uzansam biraz daha erişeceğim hemen cevaba. ♪Dialogue: 0,0:00:30.73,0:00:38.37,Hands Up lyrics,,0,0,0,,♪ İnanarak buna açılıyorum yeni dünyaya. ♪Dialogue: 0,0:00:38.40,0:00:45.86,Hands Up lyrics,,0,0,0,,♪ Aynen öyle, yapboz gibi birleşti hayal kırıntılarımız. ♪Dialogue: 0,0:00:45.91,0:00:50.41,Hands Up lyrics,,0,0,0,,♪ Aramızda hiç kopmayacak bağlar yaratarak,...Dialogue: 0,0:00:51.18,0:00:53.51,Hands Up lyrics,,0,0,0,,...daha aydınlık bir geleceğe. ♪Dialogue: 0,0:00:54.00,0:00:58.55,Hands Up lyrics,,0,0,0,,♪ Kaldır ellerini daha da yukarıya, hayallerini dök şarkılara. ♪Dialogue: 0,0:00:58.62,0:01:02.42,Hands Up lyrics,,0,0,0,,♪ Yıkılma hiçbir zaman, sarsılmaz bayrağını kaldır göklere. ♪Dialogue: 0,0:01:02.43,0:01:05.78,Hands Up lyrics,,0,0,0,,♪ Buralara kadar gelebilmek için pek çok duvarı yıkıp geçtik! ♪Dialogue: 0,0:01:05.83,0:01:09.80,Hands Up lyrics,,0,0,0,,♪ Hedefimiz gelecek! ♪Dialogue: 0,0:01:09.87,0:01:11.30,Hands Up lyrics,,0,0,0,,♪ Daha da yukarıya bak! ♪Dialogue: 0,0:01:11.34,0:01:13.48,Hands Up lyrics,,0,0,0,,♪ Sırtın hep dik olsun! ♪Dialogue: 0,0:01:13.53,0:01:14.94,Hands Up lyrics,,0,0,0,,♪ Bir an olsun durma! ♪Dialogue: 0,0:01:14.99,0:01:16.82,Hands Up lyrics,,0,0,0,,♪ Dalgaları aşa aşa! ♪Dialogue: 0,0:01:16.86,0:01:20.41,Hands Up lyrics,,0,0,0,,♪ Arzularımız birleşiyor yavaşça. ♪Dialogue: 0,0:01:20.44,0:01:24.65,Hands Up lyrics,,0,0,0,,♪ Haydi ilerisini hedef seçelim kendimize! ♪Dialogue: 0,0:01:24.91,0:01:31.06,Hands Up lyrics,,0,0,0,,♪ Dalgaları sürerek, akıyoruz ileriye. ♪Dialogue: 0,0:01:31.09,0:01:35.34,Hands Up lyrics,,0,0,0,,♪ İnsanlarla tanışıyor, elvedalar ediyoruz,...Dialogue: 0,0:01:35.36,0:01:39.09,Hands Up lyrics,,0,0,0,,...bir kez daha bu bayrağın altında. ♪Dialogue: 0,0:01:41.26,0:01:45.04,Hands Up lyrics,,0,0,0,,♪ Unutmak istemediğim acıları...Dialogue: 0,0:01:45.06,0:01:48.08,Hands Up lyrics,,0,0,0,,...o gün yüreğime gömdüm, saklıyorum orada. ♪Dialogue: 0,0:01:48.27,0:01:52.34,Hands Up lyrics,,0,0,0,,♪ Kimselere yenilmeyecek bir özgürlük bizimkisi,...Dialogue: 0,0:01:52.46,0:01:54.75,Hands Up lyrics,,0,0,0,,...sıkıca kavrayıp yoluma atıldığım. ♪Dialogue: 0,0:01:54.77,0:01:59.69,Hands Up lyrics,,0,0,0,,♪ Kaldır ellerini daha da yukarıya, hayallerini dök şarkılara. ♪Dialogue: 0,0:01:59.72,0:02:03.37,Hands Up lyrics,,0,0,0,,♪ Yıkılma hiçbir zaman, sarsılmaz bayrağını kaldır göklere. ♪Dialogue: 0,0:02:03.41,0:02:06.66,Hands Up lyrics,,0,0,0,,♪ Buralara kadar gelebilmek için pek çok duvarı yıkıp geçtik! ♪Dialogue: 0,0:02:06.69,0:02:10.83,Hands Up lyrics,,0,0,0,,♪ Hedefimiz gelecek! ♪Dialogue: 0,0:02:10.88,0:02:12.20,Hands Up lyrics,,0,0,0,,♪ Daha da yukarıya bak! ♪Dialogue: 0,0:02:12.25,0:02:14.53,Hands Up lyrics,,0,0,0,,♪ Sırtın hep dik olsun! ♪Dialogue: 0,0:02:14.53,0:02:15.90,Hands Up lyrics,,0,0,0,,♪ Bir an olsun durma! ♪Dialogue: 0,0:02:15.95,0:02:17.72,Hands Up lyrics,,0,0,0,,♪ Dalgaları aşa aşa! ♪Dialogue: 0,0:02:17.76,0:02:21.43,Hands Up lyrics,,0,0,0,,♪ Arzularımız birleşiyor yavaşça. ♪Dialogue: 0,0:02:21.50,0:02:24.97,Hands Up lyrics,,0,0,0,,♪ Haydi ilerisini hedef seçelim kendimize! ♪Dialogue: 0,0:02:24.99,0:02:29.89,Hands Up lyrics,,0,0,0,,♪ Eller havaya!! ♪