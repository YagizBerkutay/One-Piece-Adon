2,180,180,27,1Style: RogerMonologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1Style: Karaoke,Duality,68,&H00292CC7,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,4,0,1,6.8,0,8,23,23,23,1Style: Translation,Duality,68,&H00292CC7,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,4,0,1,6.8,0,2,23,23,34,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:59.99,0:02:09.98,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 50,0:01:53.99,0:01:55.86,Main-207-,,0,0,0,,Olamaz!Dialogue: 50,0:01:55.86,0:01:57.07,Flashbacks-207-,,0,0,0,,Unutma Nami,Dialogue: 50,0:01:57.07,0:02:00.97,Flashbacks-207-,,0,0,0,,İklim Asası,  gücünü senin zekândan alır.Dialogue: 50,0:02:00.97,0:02:02.81,Flashbacks-207-,,0,0,0,,Hayatta kalmak için aklını kullan!Dialogue: 50,0:02:03.17,0:02:05.36,Flashbacks-207-,,0,0,0,,Sonuçta bizim asıl silahımız bu.Dialogue: 50,0:02:07.52,0:02:09.19,Thoughts-207-,,0,0,0,,Isı ve soğuk kabarcıklarını...Dialogue: 50,0:02:09.19,0:02:12.04,Thoughts-207-,,0,0,0,,birleştirerek özelliklerinden tam yararlanabilirim!Dialogue: 50,0:02:12.04,0:02:13.53,Thoughts-207-,,0,0,0,,İklim Asası'nın gücü bu!Dialogue: 50,0:02:26.28,0:02:27.38,Flashbacks-207-,,0,0,0,,Ve son olarak,Dialogue: 50,0:02:27.38,0:02:31.40,Flashbacks-207-,,0,0,0,,Hortum Tempo! Bu silahın imza hareketi!Dialogue: 50,0:02:31.40,0:02:33.57,Main-207-,,0,0,0,,Hortum Tempo...Dialogue: 50,0:02:33.57,0:02:39.35,Flashbacks-207-,,0,0,0,,Karşındaki insan olduğu müddetçe, bu saldırıyı yedikten sonra ayakta duramaz!Dialogue: 50,0:02:39.35,0:02:42.16,Flashbacks-207-,,0,0,0,,Ama sadece tek hakkın var, bu yüzden dikkat et!Dialogue: 50,0:02:42.16,0:02:44.22,Flashbacks-207-,,0,0,0,,Kaçırırsan, her şey biter!Dialogue: 50,0:02:44.22,0:02:46.35,Main-207-,,0,0,0,,Kaçırırsam, her şey biter.Dialogue: 50,0:02:46.88,0:02:48.48,Main-207-,,0,0,0,,Dikkatini ver.Dialogue: 50,0:02:52.44,0:02:54.80,Main-207-,,0,0,0,,Epey ilginç bir silahın var.Dialogue: 50,0:02:54.80,0:02:59.99,Main-207-,,0,0,0,,Ama dövüşürken sana yardımcı olmazsa,  oyuncaktan farkı yoktur, değil mi?Dialogue: 50,0:03:00.63,0:03:06.00,Main-207-,,0,0,0,,Asıl amacı ne olursa olsun, insan öldürmek  için kullanılabilecek her şey bir silahtır.Dialogue: 50,0:03:14.05,0:03:15.84,Main-207-,,0,0,0,,Yüz bile...Dialogue: 50,0:03:16.16,0:03:18.38,Main-207-,,0,0,0,,Böyle oyalanıp durursam öleceğim!Dialogue: 50,0:03:18.38,0:03:22.10,Main-207-,,0,0,0,,Son ve en güçlü teknik... Hortum Tempo... Hızlı olmalıyım!Dialogue: 50,0:03:25.19,0:03:26.06,Main-207-,,0,0,0,,G-Geri ver!Dialogue: 50,0:03:27.50,0:03:30.40,Main-207-,,0,0,0,,Bu küçük oyuncak tarafından öldürülemem.Dialogue: 50,0:03:31.58,0:03:34.53,Main-207-,,0,0,0,,Bahse varım yün kazak bundan daha fazla elektrik üretirdi.Dialogue: 50,0:03:34.92,0:03:37.94,Main-207-,,0,0,0,,Ben yapana dek bilemezsin!Dialogue: 50,0:03:37.94,0:03:39.62,Main-207-,,0,0,0,,Ver şunu!Dialogue: 50,0:03:43.63,0:03:45.08,Thoughts-207-,,0,0,0,,Düşünmeliyim.Dialogue: 50,0:03:45.80,0:03:50.33,Thoughts-207-,,0,0,0,,Gardını düşürürsem, tek atışlık saldırı olan Hortum Tempo'dan kaçamaz!Dialogue: 50,0:03:50.33,0:03:51.04,Thoughts-207-,,0,0,0,,Sanırım...!Dialogue: 50,0:03:51.96,0:03:53.42,Thoughts-207-,,0,0,0,,Üç çeşit baloncuğu ve...Dialogue: 50,0:03:53.42,0:03:57.61,Thoughts-207-,,0,0,0,,bu ülkenin kuru iklimini birleştirerek ne yapabilirim?Dialogue: 50,0:03:57.61,0:04:00.67,Thoughts-207-,,0,0,0,,Havada birazcık daha nem olsaydı...Dialogue: 50,0:04:00.67,0:04:04.52,Thoughts-207-,,0,0,0,,Nem... Tabii ya! Yağmur tekniği vardı!Dialogue: 50,0:04:07.56,0:04:12.19,Main-207-,,0,0,0,,Yağmur Tempo!Dialogue: 50,0:04:12.68,0:04:13.90,Main-207-,,0,0,0,,Su numaraları, ha?Dialogue: 50,0:04:14.44,0:04:16.74,Main-207-,,0,0,0,,Fıskiye!Dialogue: 50,0:04:17.16,0:04:18.20,Main-207-,,0,0,0,,Umutsuz vakasın.Dialogue: 50,0:04:18.48,0:04:21.21,Main-207-,,0,0,0,,Hayır, lanet olası! Bir planım var!Dialogue: 50,0:04:21.21,0:04:23.91,Main-207-,,0,0,0,,Yeter artık. Bu gösteri işi eskidi.Dialogue: 50,0:04:27.21,0:04:29.87,Main-207-,,0,0,0,,Perdeyi kapama zamanı geldi!Dialogue: 50,0:04:30.33,0:04:30.92,Main-207-,,0,0,0,,Deniz kestanesi mi?!Dialogue: 50,0:04:31.65,0:04:34.09,Main-207-,,0,0,0,,Deniz Kestanesi Dikeni!Dialogue: 50,0:04:39.57,0:04:41.26,Main-207-,,0,0,0,,Seni delik deşik edeceğim!Dialogue: 50,0:04:50.91,0:04:53.77,Main-207-,,0,0,0,,Delik açmakla kalmadı... Duvarı yakıp kül etti!Dialogue: 50,0:04:55.64,0:04:59.65,Main-207-,,0,0,0,,Önceki performansın harikaydı, şimdi ben de karşılık vereyim.Dialogue: 50,0:05:01.63,0:05:02.40,Thoughts-207-,,0,0,0,,İşte fırsat!Dialogue: 50,0:05:02.40,0:05:03.49,Thoughts-207-,,0,0,0,,Isı Kabarcığı!Dialogue: 50,0:05:12.56,0:05:15.20,Thoughts-207-,,0,0,0,,Nemli sıcak hava yükselip...Dialogue: 50,0:05:15.20,0:05:19.80,Thoughts-207-,,0,0,0,,alçalan soğuk havayla çarçabuk soğuduğunda, içindeki nem yoğunlaşacak.Dialogue: 50,0:05:21.34,0:05:22.40,Thoughts-207-,,0,0,0,,Sonra da...Dialogue: 50,0:05:23.74,0:05:26.51,Main-207-,,0,0,0,,Diken-Diken Doping!Dialogue: 50,0:05:29.12,0:05:31.56,Main-207-,,0,0,0,,Dikkatini ver, dememiş miydim?Dialogue: 50,0:05:31.56,0:05:33.56,Main-207-,,0,0,0,,Dikenli Topuz!Dialogue: 50,0:05:51.78,0:05:56.35,Main-207-,,0,0,0,,Cidden, iyi olduğun tek şey kaçmak gibi duruyor tatlım.Dialogue: 50,0:05:58.80,0:06:00.76,Thoughts-207-,,0,0,0,,Tabii ya! Baloncuklar!Dialogue: 50,0:06:08.46,0:06:09.51,Main-207-,,0,0,0,,Oluşmuş!Dialogue: 50,0:06:09.51,0:06:11.76,Main-207-,,0,0,0,,Biraz küçük ama bulut yaptım!Dialogue: 50,0:06:12.16,0:06:13.52,Main-207-,,0,0,0,,Neden bahsediyorsun?Dialogue: 50,0:06:14.35,0:06:17.44,Main-207-,,0,0,0,,Yetmez. Daha büyük yapmalıyım!Dialogue: 50,0:06:18.11,0:06:19.65,Main-207-,,0,0,0,,Soğuk Kabarcığı!Dialogue: 50,0:06:20.23,0:06:21.28,Main-207-,,0,0,0,,Isı Kabarcığı!Dialogue: 50,0:06:24.30,0:06:25.78,Main-207-,,0,0,0,,Yeter artık!Dialogue: 50,0:06:27.79,0:06:29.04,Main-207-,,0,0,0,,Ulan...!Dialogue: 50,0:06:31.83,0:06:34.00,Main-207-,,0,0,0,,Dikenli Topuz!Dialogue: 50,0:06:38.87,0:06:41.13,Main-207-,,0,0,0,,Ee? Ölmeye hazır mısın?Dialogue: 50,0:06:42.41,0:06:43.76,Main-207-,,0,0,0,,Peki ya sen?Dialogue: 50,0:06:44.74,0:06:46.40,Main-207-,,0,0,0,,Blöfünü görüyorum.Dialogue: 50,0:06:55.00,0:06:55.85,Main-207-,,0,0,0,,Yakaladım.Dialogue: 50,0:07:17.80,0:07:19.21,Main-207-,,0,0,0,,Affedilemez!Dialogue: 50,0:07:26.52,0:07:27.89,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:07:28.36,0:07:29.72,Main-207-,,0,0,0,,Bugünkü hava durumunda...Dialogue: 50,0:07:29.72,0:07:32.03,Main-207-,,0,0,0,,rüzgâr ve nem dengeli,Dialogue: 50,0:07:32.03,0:07:35.89,Main-207-,,0,0,0,,güzel, güneşli bir gün için yüksek basınç hakim.Dialogue: 50,0:07:36.26,0:07:42.63,Main-207-,,0,0,0,,Ancak belli bir bölgede, seraplar ve kasırgalar görebilirsiniz.Dialogue: 50,0:07:45.14,0:07:47.71,Main-207-,,0,0,0,,Hortumlara dikkat edin!Dialogue: 50,0:07:49.76,0:07:53.11,Flashbacks-207-,,0,0,0,,Hortum Tempo! Bu silahın imza hareketi!Dialogue: 50,0:07:53.11,0:07:55.86,Flashbacks-207-,,0,0,0,,Ama sadece tek hakkın var, bu yüzden dikkat et!Dialogue: 50,0:07:55.86,0:07:57.75,Flashbacks-207-,,0,0,0,,Kaçırırsan, her şey biter!Dialogue: 50,0:07:58.96,0:08:01.04,Thoughts-207-,,0,0,0,,Kaçırırsam... her şey biter.Dialogue: 50,0:08:02.22,0:08:03.87,Main-207-,,0,0,0,,Hortumlara dikkat!Dialogue: 50,0:08:07.65,0:08:09.22,Main-207-,,0,0,0,,İyi misin?Dialogue: 50,0:08:12.72,0:08:15.65,Main-207-,,0,0,0,,Sol bacağın sana epey acı çektiriyor.Dialogue: 50,0:08:16.89,0:08:19.55,Main-207-,,0,0,0,,Daha fazla ayakta duramayacaksın.Dialogue: 50,0:08:23.61,0:08:25.32,Main-207-,,0,0,0,,Deniz Kestanesi Dikeni!Dialogue: 50,0:08:39.27,0:08:41.96,Main-207-,,0,0,0,,Bu... hiçbir şey!Dialogue: 50,0:08:43.13,0:08:45.58,Main-207-,,0,0,0,,Hiç acımıyor!Dialogue: 50,0:08:45.58,0:08:48.11,Main-207-,,0,0,0,,Onun neler çektiğini biliyor musun?!Dialogue: 50,0:08:49.65,0:08:52.09,Main-207-,,0,0,0,,Onunla karşılaştırıldığında,Dialogue: 50,0:08:54.75,0:08:58.98,Main-207-,,0,0,0,,bir, iki veya üç bacağı feda etmek,Dialogue: 50,0:08:59.65,0:09:00.77,Main-207-,,0,0,0,,hiç önemli değil!!!Dialogue: 50,0:09:03.85,0:09:05.31,Main-207-,,0,0,0,,Al bunu.Dialogue: 50,0:09:05.90,0:09:08.11,Main-207-,,0,0,0,,Hortum Tempo!Dialogue: 50,0:09:29.25,0:09:30.22,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:09:36.54,0:09:39.18,Main-207-,,0,0,0,,N...? Ne? N-Ne oluyor be?!Dialogue: 50,0:09:39.18,0:09:41.19,Main-207-,,0,0,0,,Güvercinler bana dolandı!Dialogue: 50,0:09:58.50,0:09:59.64,Main-207-,,0,0,0,,Ah...Dialogue: 50,0:10:53.41,0:10:57.51,Main-207-,,0,0,0,,Başardım... Ben başardım! Usopp... Vivi...!Dialogue: 50,0:11:10.81,0:11:16.07,Thoughts-207-,,0,0,0,,Neden bahsediyor? Pluton nedir? Ne planlıyor...?Dialogue: 50,0:11:16.36,0:11:22.18,Main-207-,,0,0,0,,Duyduğum kadarıyla, Pluton'un tek atışıyla bir ada yok olabilirmiş.Dialogue: 50,0:11:29.17,0:11:32.66,Main-207-,,0,0,0,,Tanrı adını taşıyan, dünyadaki en korkunç antik silah.Dialogue: 50,0:11:32.66,0:11:36.30,Main-207-,,0,0,0,,Ve bu ülkede bir yerde sessizce uyuyor.Dialogue: 50,0:11:38.49,0:11:42.07,Main-207-,,0,0,0,,Antik bir silah mı? Bu ülkede mi?Dialogue: 50,0:11:42.87,0:11:44.27,Main-207-,,0,0,0,,Babam biliyor muydu?Dialogue: 50,0:11:44.65,0:11:47.44,Main-207-,,0,0,0,,Kraliyet ailesinde nesilden nesile geçen sır.Dialogue: 50,0:11:47.77,0:11:50.98,Main-207-,,0,0,0,,Başından beri amacım buydu.Dialogue: 50,0:11:50.98,0:11:55.61,Main-207-,,0,0,0,,Bunu kullanarak, burada en korkutucu orduya sahip bir devlet kuracağım.Dialogue: 50,0:11:56.23,0:11:59.20,Main-207-,,0,0,0,,Öyleyse yaptığın her şey bu amaç için miydi?!Dialogue: 50,0:12:00.49,0:12:02.94,Main-207-,,0,0,0,,Bu ülkenin kralı olduğum zaman,Dialogue: 50,0:12:02.94,0:12:07.46,Main-207-,,0,0,0,,bölgedeki korsanları kolayca kontrolüm altına alabilirim.Dialogue: 50,0:12:07.70,0:12:12.75,Main-207-,,0,0,0,,Güç kazanırken, Dünya Hükûmeti'nden bile üstün olacağım.Dialogue: 50,0:12:12.75,0:12:14.76,Main-207-,,0,0,0,,Burası hayaller ülkesi olacak!Dialogue: 50,0:12:15.28,0:12:18.58,Main-207-,,0,0,0,,İmkânsız! Dünya Hükûmeti buna izin vermez!Dialogue: 50,0:12:18.58,0:12:23.72,Main-207-,,0,0,0,,Biliyorum, bu yüzden Pluton'a ihtiyacım var.Dialogue: 50,0:12:24.10,0:12:27.63,Main-207-,,0,0,0,,O ismi nereden duyduğunu bilmiyorum ama,Dialogue: 50,0:12:27.63,0:12:29.56,Main-207-,,0,0,0,,nerede olduğu hakkında bir fikrim yok.Dialogue: 50,0:12:30.16,0:12:35.53,Main-207-,,0,0,0,,Hatta bu krallıkta böyle bir şey var mı emin değilim!Dialogue: 50,0:12:35.90,0:12:38.91,Main-207-,,0,0,0,,Anlıyorum. Durumun böyle olacağını düşünmüştüm.Dialogue: 50,0:12:40.37,0:12:43.40,Main-207-,,0,0,0,,Bu olasılığı zaten hesaplamıştım.Dialogue: 50,0:12:43.40,0:12:49.50,Main-207-,,0,0,0,,Varlığının belirsizliği, benim tarafımdan bile reddedilemez.Dialogue: 50,0:12:56.96,0:12:59.30,Main-207-,,0,0,0,,Ne gürültücü sinekler...Dialogue: 50,0:13:00.34,0:13:03.56,Main-207-,,0,0,0,,Crocodile, Cobra-sama'yı içeride rehin tutuyor!Dialogue: 50,0:13:03.56,0:13:05.15,Main-207-,,0,0,0,,Cobra-sama'yı kurtarmalıyız!Dialogue: 50,0:13:05.15,0:13:08.10,Main-207-,,0,0,0,,Ne olursa olsun bir yol bulup içeri girmeliyiz!Dialogue: 50,0:13:08.47,0:13:11.94,Main-207-,,0,0,0,,Ama kapıdan çıkmış o eller varken, kırıp giremiyoruz!Dialogue: 50,0:13:12.41,0:13:14.95,Main-207-,,0,0,0,,Onları halletmeden ilerleyemeyiz!Dialogue: 50,0:13:16.76,0:13:18.51,Main-207-,,0,0,0,,Her şey plana göre giderse,Dialogue: 50,0:13:18.51,0:13:24.43,Main-207-,,0,0,0,,İsyan Ordusu 20 dakika içinde meydana ulaşacak ve savaş başlayacak.Dialogue: 50,0:13:25.91,0:13:30.04,Main-207-,,0,0,0,,Yarım saat sonra, tam olarak 4:30'da,Dialogue: 50,0:13:32.98,0:13:37.54,Main-207-,,0,0,0,,meydana doğru çok güçlü bir top ateşlenecek.Dialogue: 50,0:13:44.37,0:13:45.80,Main-207-,,0,0,0,,Delirdin mi sen?!Dialogue: 50,0:13:46.51,0:13:49.58,Main-207-,,0,0,0,,Top, beş kilometre çapında bir patlama oluşturacak.Dialogue: 50,0:13:49.58,0:13:51.77,Main-207-,,0,0,0,,Güzel manzaranız tamamen değişecek.Dialogue: 50,0:13:52.36,0:13:53.73,Main-207-,,0,0,0,,Bunu yaparsan...!Dialogue: 50,0:13:54.81,0:13:58.51,Main-207-,,0,0,0,,Hem Kraliyet Ordusu hem de İsyan Ordusu yok edilecek.Dialogue: 50,0:13:58.51,0:14:01.74,Main-207-,,0,0,0,,Düşecekler ve savaşları sonsuza dek bitmiş olacak.Dialogue: 50,0:14:03.48,0:14:08.83,Main-207-,,0,0,0,,Mutlu olmalısın. Bu isyanın sona erişini görmek için çok çalıştın.Dialogue: 50,0:14:10.04,0:14:14.12,Main-207-,,0,0,0,,Sarayı yok etmek dolaylı bir yoldu.Dialogue: 50,0:14:14.42,0:14:19.17,Main-207-,,0,0,0,,Bir çırpıda herkesi yok etmek,  çok daha verimli.Dialogue: 50,0:14:19.45,0:14:22.22,Main-207-,,0,0,0,,Bunu nasıl yapabilirsin?!Dialogue: 50,0:14:22.22,0:14:25.59,Main-207-,,0,0,0,,Bu kaderi hak edecek ne yapmış olabilirler?!Dialogue: 50,0:14:25.59,0:14:28.03,Main-207-,,0,0,0,,Sen... Sen...Dialogue: 50,0:14:28.03,0:14:28.51,Main-207-,,0,0,0,,Vivi-sama!Dialogue: 50,0:14:28.95,0:14:30.14,Main-207-,,0,0,0,,Onlar değersiz.Dialogue: 50,0:14:31.13,0:14:33.79,Main-207-,,0,0,0,,Kes şunu! Bunu yaparak ne elde edebilirsin ki?Dialogue: 50,0:14:33.79,0:14:34.90,Main-207-,,0,0,0,,Vivi-sama!Dialogue: 50,0:14:34.90,0:14:38.11,Main-207-,,0,0,0,,Şimdi, Bay Cobra. Başka bir soru soracağım.Dialogue: 50,0:14:42.29,0:14:45.70,Main-207-,,0,0,0,,Poneglif nerede?Dialogue: 50,0:14:45.97,0:14:48.66,Main-207-,,0,0,0,,Poneglif... Neden ihtiyacın olsun ki...?Dialogue: 50,0:14:50.52,0:14:52.96,Main-207-,,0,0,0,,Nerede olduğunu söylersem...Dialogue: 50,0:14:55.35,0:14:59.71,Main-207-,,0,0,0,,Hayır... Seni oraya götüreceğim.Dialogue: 50,0:15:00.73,0:15:01.67,Main-207-,,0,0,0,,Baba...Dialogue: 50,0:15:04.06,0:15:07.39,Main-207-,,0,0,0,,Bilge hükümdar Cobra'dan da bu beklenirdi. Akıllı bir adamsın.Dialogue: 50,0:15:09.30,0:15:09.85,Main-207-,,0,0,0,,Vivi-sama.Dialogue: 50,0:15:11.13,0:15:14.80,Main-207-,,0,0,0,,Artık buna dayanamıyorum!Dialogue: 50,0:15:39.10,0:15:44.11,Main-207-,,0,0,0,,Sana kılıçlarımız arasındaki gurur farkını...Dialogue: 50,0:15:45.96,0:15:47.91,Main-207-,,0,0,0,,göstereceğim!Dialogue: 50,0:15:47.91,0:15:49.39,Main-207-,,0,0,0,,Üç Kılıç Stili...Dialogue: 50,0:15:51.32,0:15:53.01,Main-207-,,0,0,0,,Boğa...Dialogue: 50,0:15:53.01,0:15:54.39,Main-207-,,0,0,0,,Boynuzu!Dialogue: 50,0:15:56.21,0:15:57.44,Main-207-,,0,0,0,,Demir Gard...Dialogue: 50,0:16:18.20,0:16:21.43,Main-207-,,0,0,0,,Demek bedenin çelik kadar sert.Dialogue: 50,0:16:21.43,0:16:24.38,Main-207-,,0,0,0,,Çeliği kesemezsem, seni de kesemem.Dialogue: 50,0:16:24.97,0:16:27.03,Main-207-,,0,0,0,,Dediğin gibi.Dialogue: 50,0:16:27.57,0:16:30.09,Main-207-,,0,0,0,,Vurma ve kesme saldırıları beni etkilemeyecek.Dialogue: 50,0:16:32.42,0:16:34.52,Main-207-,,0,0,0,,Anlıyorum. Bu çok can sıkıcı.Dialogue: 50,0:16:34.52,0:16:38.14,Main-207-,,0,0,0,,Çeliği kesemediğime göre, seni yenemem.Dialogue: 50,0:16:39.44,0:16:41.23,Main-207-,,0,0,0,,Peki, ne yapacaksın?Dialogue: 50,0:16:41.23,0:16:43.65,Main-207-,,0,0,0,,Basit. Senin adına üzüldüm.Dialogue: 50,0:16:43.65,0:16:44.82,Main-207-,,0,0,0,,Ne?Dialogue: 50,0:16:46.68,0:16:49.43,Main-207-,,0,0,0,,Böyle zor bir durum, tam da ihtiyacım olan şeydi.Dialogue: 50,0:16:50.08,0:16:54.12,Main-207-,,0,0,0,,Bir adım daha güçlenmek için fırsat arıyordum.Dialogue: 50,0:16:55.39,0:16:57.89,Main-207-,,0,0,0,,Seni yendiğim zaman,Dialogue: 50,0:16:57.89,0:17:01.59,Main-207-,,0,0,0,,çeliği kesebilen bir adam olacağım.Dialogue: 50,0:17:17.68,0:17:21.14,Main-207-,,0,0,0,,Beni yendiğin zaman mı?Dialogue: 50,0:17:21.14,0:17:23.71,Main-207-,,0,0,0,,Heyecanını biraz frenlesen iyi olur.Dialogue: 50,0:17:24.44,0:17:28.10,Main-207-,,0,0,0,,Bil ki, Kesme Meyvesi yediğimden beri,Dialogue: 50,0:17:28.10,0:17:31.76,Main-207-,,0,0,0,,hiçbir sözde kılıç ustası bana tek bir çizik bile atamadı.Dialogue: 50,0:17:32.65,0:17:36.57,Main-207-,,0,0,0,,Bir kılıç ustası olarak, beni yenemezsin.Dialogue: 50,0:17:36.57,0:17:39.10,Main-207-,,0,0,0,,Evet, ne dediğini anlıyorum,Dialogue: 50,0:17:39.10,0:17:42.98,Main-207-,,0,0,0,,ama o güzel anıları albümün için saklamalısın.Dialogue: 50,0:17:42.98,0:17:46.92,Main-207-,,0,0,0,,Geçmişte kaç tane kılıç ustasıyla dövüştüğün önemli değil.Dialogue: 50,0:17:47.65,0:17:50.63,Main-207-,,0,0,0,,Benimle hiç karşılaşmadın.Dialogue: 50,0:17:53.64,0:17:55.93,Main-207-,,0,0,0,,En azından dilin keskin.Dialogue: 50,0:17:57.47,0:17:59.31,Main-207-,,0,0,0,,Teşekkürler, keltoş.Dialogue: 50,0:18:04.26,0:18:06.02,Main-207-,,0,0,0,,Bakalım ne kadar dayanacaksın.Dialogue: 50,0:18:06.47,0:18:07.52,Main-207-,,0,0,0,,Sana bağlı.Dialogue: 50,0:18:50.63,0:18:51.49,Main-207-,,0,0,0,,İblis...Dialogue: 50,0:18:53.53,0:18:54.94,Main-207-,,0,0,0,,Kesişi!Dialogue: 50,0:18:59.45,0:19:00.95,Main-207-,,0,0,0,,Kaplan...Dialogue: 50,0:19:00.95,0:19:01.70,Main-207-,,0,0,0,,Avı!Dialogue: 50,0:19:34.43,0:19:36.03,Main-207-,,0,0,0,,Sana söylemiştim, değil mi?Dialogue: 50,0:19:39.74,0:19:43.95,Main-207-,,0,0,0,,Tek bir çizik bile yok. Moral bozucu.Dialogue: 50,0:19:44.33,0:19:49.68,Main-207-,,0,0,0,,Bu kadar güç kullanmamın ardından, ilk kez birinin ayağa kalktığını görüyorum.Dialogue: 50,0:19:50.36,0:19:51.96,Main-207-,,0,0,0,,Elbette.Dialogue: 50,0:19:52.32,0:19:56.13,Main-207-,,0,0,0,,Daha önce benimle hiç karşılaşmadın.Dialogue: 50,0:20:06.01,0:20:07.39,Main-207-,,0,0,0,,Doğru!Dialogue: 50,0:20:08.12,0:20:10.70,Thoughts-207-,,0,0,0,,Bu herif kılıç adam.Dialogue: 50,0:20:10.70,0:20:13.48,Thoughts-207-,,0,0,0,,Vücudunun her bir parçası keskin.Dialogue: 50,0:20:17.74,0:20:19.87,Main-207-,,0,0,0,,Papatya Bıçağı!Dialogue: 50,0:20:26.71,0:20:29.42,Thoughts-207-,,0,0,0,,B-Bu adam...Dialogue: 50,0:20:30.19,0:20:31.25,Main-207-,,0,0,0,,Uçup git.Dialogue: 50,0:21:01.29,0:21:04.01,Thoughts-207-,,0,0,0,,Kendimi herkesten fazla zorladım.Dialogue: 50,0:21:07.43,0:21:11.97,Thoughts-207-,,0,0,0,,Defalarca kez ölümün eşiğine geldim.Dialogue: 50,0:21:14.08,0:21:16.79,Thoughts-207-,,0,0,0,,Bende eksik olan şey ne?!Dialogue: 50,0:21:19.15,0:21:22.11,Flashbacks-207-,,0,0,0,,Sensei...! Sensei!Dialogue: 50,0:21:23.05,0:21:24.35,Flashbacks-207-,,0,0,0,,Hmm?Dialogue: 50,0:21:25.27,0:21:28.89,Flashbacks-207-,,0,0,0,,Dünyada çeliği bile kesebilen adamlar olduğunu duydum!Dialogue: 50,0:21:28.89,0:21:29.81,Flashbacks-207-,,0,0,0,,Bu doğru mu?!Dialogue: 50,0:21:32.60,0:21:34.93,Flashbacks-207-,,0,0,0,,Evet, doğru.Dialogue: 50,0:21:36.58,0:21:40.28,Flashbacks-207-,,0,0,0,,Hazır mısın? Kağıdı dikkatle izle, Zoro.Dialogue: 50,0:21:46.68,0:21:48.75,Flashbacks-207-,,0,0,0,,Sensei, kağıt hâlâ tek parça.Dialogue: 50,0:21:49.11,0:21:50.66,Flashbacks-207-,,0,0,0,,İyi dinle, Zoro.Dialogue: 50,0:21:50.66,0:21:56.38,Flashbacks-207-,,0,0,0,,Yaşadığımız dünyada, hiçbir şeyi kesemeyen kılıç ustaları vardır.Dialogue: 50,0:21:58.51,0:22:04.72,Flashbacks-207-,,0,0,0,,Ve aynı kılıç ustaları, aynı kılıçla çeliği veya istedikleri her şeyi kesebilir.Dialogue: 50,0:22:05.85,0:22:10.00,Flashbacks-207-,,0,0,0,,Kılıç ustalığının zirvesi, korumak istediğini koruma...Dialogue: 50,0:22:10.00,0:22:12.28,Flashbacks-207-,,0,0,0,,kesmek istediğini kesme gücüdür.Dialogue: 50,0:22:13.31,0:22:15.98,Flashbacks-207-,,0,0,0,,Dokunduğu her şeye zarar veren bir kılıç,Dialogue: 50,0:22:15.98,0:22:19.44,Flashbacks-207-,,0,0,0,,bana göre, gerçek bir kılıç değildir.Dialogue: 50,0:22:20.00,0:22:21.30,Flashbacks-207-,,0,0,0,,Anlıyor musun?Dialogue: 50,0:22:32.83,0:22:36.35,Flashbacks-207-,,0,0,0,,Sensei, her şeyi kesebilen bir kılıç ustası olacağım!Dialogue: 50,0:22:37.30,0:22:40.76,Flashbacks-207-,,0,0,0,,Zoro, söylediklerimi duymadın mı?Dialogue: 50,0:22:51.14,0:22:54.38,Main-207-,,0,0,0,,Beni kesmeyi denemelisin.Dialogue: 50,0:22:55.06,0:22:58.60,Main-207-,,0,0,0,,Sadece saldırılarımı karşılamak, bedenimi çizmeyecek.Dialogue: 50,0:22:59.77,0:23:06.32,Main-207-,,0,0,0,,Ne yazık ki, çeliği kararlılıkla kesişimi asla göremeyeceksin…Dialogue: 50,0:23:10.68,0:23:15.42,Main-207-,,0,0,0,,Çünkü çeliği kestiğim an, ayak ucumda yattığın an olacak.Dialogue: 50,0:23:17.04,0:23:18.38,Main-207-,,0,0,0,,Mantıklı...Dialogue: 50,0:23:27.25,0:23:31.01,Main-207-,,0,0,0,,Öyleyse, buradaki her şeyi atomlarına dek keseceğim!Dialogue: 50,0:23:33.35,0:23:37.80,Thoughts-207-,,0,0,0,,"Hiçbir şeyi kesmeyen kılıç," ha?Dialogue: 50,0:23:40.77,0:23:44.37,Thoughts-207-,,0,0,0,,Hiçbir şeyi kesmeyen... Çeliği kesen...Dialogue: 50,0:23:44.37,0:23:46.78,Thoughts-207-,,0,0,0,,Bunun ne anlama gelmesi gerekiyor?!Dialogue: 50,0:23:47.95,0:23:51.70,Main-207-,,0,0,0,,Tüm gücünle zorla! Güçlü bir kılıcın özü budur!Dialogue: 50,0:23:52.28,0:23:54.35,Main-207-,,0,0,0,,Atom Kesici!Dialogue: 50,0:23:56.81,0:23:58.58,Main-207-,,0,0,0,,Seni doğrayacağım!Dialogue: 50,0:24:27.11,0:24:29.74,Main-207-,,0,0,0,,Yengeç Kapışı!Dialogue: 50,0:24:51.19,0:24:53.30,Main-207-,,0,0,0,,Sinir bozucu birisin.Dialogue: 50,0:24:54.79,0:24:56.31,Main-207-,,0,0,0,,Sen de öylesin.Dialogue: 50,0:24:57.25,0:25:00.90,Main-207-,,0,0,0,,Bir tavsiye. Beni bir kılıç ustası olarak görme.Dialogue: 50,0:25:02.02,0:25:06.31,Main-207-,,0,0,0,,Bedenini parçalama kapasitesine sahip çok sayıda silahım var.Dialogue: 50,0:25:12.25,0:25:13.49,Main-207-,,0,0,0,,Sarmal Testere!Dialogue: 50,0:25:18.41,0:25:20.87,Main-207-,,0,0,0,,Kılıç ustası değilsen, belki de kazıcısındır.Dialogue: 50,0:25:21.86,0:25:23.33,Main-207-,,0,0,0,,Suikastçıyım.Dialogue: 50,0:25:26.84,0:25:30.34,Thoughts-207-,,0,0,0,,Kıvılcım mı?! Ne kadar hızlı dönüyorlar?!Dialogue: 50,0:25:32.97,0:25:33.93,Thoughts-207-,,0,0,0,,Tutamıyorum...Dialogue: 50,0:25:36.47,0:25:41.73,Main-207-,,0,0,0,,Kazma işi benim için imkânsız. Dokunduğum her şeyi un ufak ederim.Dialogue: 50,0:25:43.16,0:25:43.94,Main-207-,,0,0,0,,Kahretsin!Dialogue: 50,0:25:59.49,0:26:02.32,Main-207-,,0,0,0,,Anlık yanlış hesaplama, ölüme...Dialogue: 50,0:26:04.00,0:26:04.58,Main-207-,,0,0,0,,yol açar!Dialogue: 50,0:26:26.58,0:26:28.37,Main-207-,,0,0,0,,Hâlâ nefes alıyorsun...Dialogue: 50,0:26:33.75,0:26:36.39,Thoughts-207-,,0,0,0,,Ona sırtımı dönemem!Dialogue: 50,0:26:38.61,0:26:41.00,Main-207-,,0,0,0,,Çıplak ellerinle nasıl mücadele edeceksin?Dialogue: 50,0:26:44.81,0:26:47.21,Main-207-,,0,0,0,,Kule Parçalayıcı!Dialogue: 50,0:27:05.20,0:27:06.94,Main-207-,,0,0,0,,Huzur içinde öl.Dialogue: 50,0:27:09.97,0:27:11.52,Thoughts-207-,,0,0,0,,Bugün...Dialogue: 50,0:27:11.52,0:27:14.62,Thoughts-207-,,0,0,0,,taşlardan yana şansım kötü.Dialogue: 50,0:27:33.04,0:27:36.47,Thoughts-207-,,0,0,0,,Diğerleri iyi mi... merak ediyorum.Dialogue: 50,0:27:52.37,0:27:56.43,Main-207-,,0,0,0,,Hâlâ nasıl ayakta durabilirsin? Seni lime lime ettim.Dialogue: 50,0:27:56.97,0:27:59.47,Main-207-,,0,0,0,,Düşen taşları nasıl savuşturabildin?Dialogue: 50,0:28:05.63,0:28:08.72,Thoughts-207-,,0,0,0,,Taşları... savuşturdum mu?Dialogue: 50,0:28:09.23,0:28:10.63,Thoughts-207-,,0,0,0,,Hayır, öyle olmadı.Dialogue: 50,0:28:11.15,0:28:15.63,Thoughts-207-,,0,0,0,,Taşların düşmeyeceği yeri biliyordum.Dialogue: 50,0:28:20.48,0:28:22.06,Thoughts-207-,,0,0,0,,Kılıçlarımdan biri...Dialogue: 50,0:28:22.55,0:28:24.42,Thoughts-207-,,0,0,0,,o taşın altında.Dialogue: 50,0:28:25.35,0:28:26.40,Thoughts-207-,,0,0,0,,Biliyorum.Dialogue: 50,0:28:30.04,0:28:31.23,Main-207-,,0,0,0,,Ne yapıyor bu?Dialogue: 50,0:28:40.49,0:28:43.06,Thoughts-207-,,0,0,0,,Daha önce de böyle hissetmiştim.Dialogue: 50,0:28:47.21,0:28:49.12,Thoughts-207-,,0,0,0,,Etrafımda her şey sessizleşiyor.Dialogue: 50,0:28:50.85,0:28:54.13,Thoughts-207-,,0,0,0,,Kulaklarımda yankılanan kalp atışımı duyabiliyorum.Dialogue: 50,0:28:57.15,0:29:00.64,Thoughts-207-,,0,0,0,,Cehennemin kapılarında duruyormuşum gibi.Dialogue: 50,0:29:03.57,0:29:09.52,Thoughts-207-,,0,0,0,,Düşen taşların varlığını canlı şeylermiş gibi hissettim.Dialogue: 50,0:29:11.21,0:29:14.67,Thoughts-207-,,0,0,0,,Ama varlık olarak değil daha başka bir şekilde.Dialogue: 50,0:29:15.52,0:29:16.72,Thoughts-207-,,0,0,0,,Nefes...Dialogue: 50,0:29:18.35,0:29:20.70,Thoughts-207-,,0,0,0,,Nefes alan taşlar...Dialogue: 50,0:29:21.64,0:29:23.68,Thoughts-207-,,0,0,0,,Nefes alan ağaçlar...Dialogue: 50,0:29:24.81,0:29:29.16,Thoughts-207-,,0,0,0,,Nefes alan yeryüzü... Bu mu?Dialogue: 50,0:29:30.55,0:29:31.83,Flashbacks-207-,,0,0,0,,İyi dinle.Dialogue: 50,0:29:31.83,0:29:36.93,Flashbacks-207-,,0,0,0,,Yaşadığımız dünyada, hiçbir şeyi kesemeyen kılıç ustaları vardır.Dialogue: 50,0:29:39.20,0:29:41.00,Thoughts-207-,,0,0,0,,Hiçbir şeyi kesememek,Dialogue: 50,0:29:41.92,0:29:44.51,Thoughts-207-,,0,0,0,,o nefesi duymak mıdır?Dialogue: 50,0:29:45.64,0:29:49.64,Thoughts-207-,,0,0,0,,Bu... çeliği kesme gücü mü?Dialogue: 50,0:29:51.11,0:29:54.55,Main-207-,,0,0,0,,Lanet olası... Ne yaptın sen?!Dialogue: 50,0:29:54.55,0:29:59.11,Main-207-,,0,0,0,,O yaraları aldıktan sonra,  o kadar kan kaybettikten sonra,Dialogue: 50,0:29:59.11,0:30:01.66,Main-207-,,0,0,0,,yaşıyor olamazsın!Dialogue: 50,0:30:01.66,0:30:06.45,Thoughts-207-,,0,0,0,,Onu duyabiliyorum. Çeliğinin nefesini.Dialogue: 50,0:30:07.33,0:30:09.91,Thoughts-207-,,0,0,0,,Kılıcım, irademin bir uzantısıdır.Dialogue: 50,0:30:25.49,0:30:30.31,Main-207-,,0,0,0,,Peki öyleyse. Hayatına tamamen son vereceğim!Dialogue: 50,0:30:32.70,0:30:33.87,Thoughts-207-,,0,0,0,,Geriye,Dialogue: 50,0:30:34.91,0:30:39.67,Thoughts-207-,,0,0,0,,çeliği kesecek güce sahip olup olmadığımı görmek kaldı.Dialogue: 50,0:30:42.30,0:30:45.32,Main-207-,,0,0,0,,Saldırılarımı tek bir kılıçla karşılayamazsın.Dialogue: 50,0:30:47.51,0:30:51.12,Main-207-,,0,0,0,,Sorun değil. Artık onları karşılamayacağım.Dialogue: 50,0:30:51.88,0:30:54.46,Main-207-,,0,0,0,,Demek kendini hazırladın. Bana uyar.Dialogue: 50,0:30:57.61,0:31:00.38,Main-207-,,0,0,0,,Tek Kılıç Stili!Dialogue: 50,0:31:00.38,0:31:02.17,Main-207-,,0,0,0,,Aslan Şarkısı!Dialogue: 50,0:31:02.60,0:31:04.18,Main-207-,,0,0,0,,Atom Kesici!Dialogue: 50,0:31:24.88,0:31:26.11,Main-207-,,0,0,0,,Minnettarım.Dialogue: 50,0:31:28.24,0:31:30.77,Thoughts-207-,,0,0,0,,Hâlâ daha güçlü olabilirim!Dialogue: 50,0:31:35.56,0:31:42.09,Thoughts-207-,,0,0,0,,Gerçekten, bu dövüş içerisinde kendi sınırını aştı.Dialogue: 50,0:31:46.29,0:31:47.60,Main-207-,,0,0,0,,Sırada...Dialogue: 50,0:31:49.66,0:31:52.68,Main-207-,,0,0,0,,elmas kesmek mi var?Dialogue: 50,0:31:55.00,0:31:56.81,Main-207-,,0,0,0,,Zaman kaybı olurdu.Dialogue: 50,0:31:59.44,0:32:01.25,Main-207-,,0,0,0,,Canıma okudun.Dialogue: 0,0:01:49.96,0:01:55.05,Title-207-,,0,0,0,,Çeliği KesmeDialogue: 1,0:01:49.96,0:01:55.05,Title-207-,,0,0,0,,Çeliği KesmeDialogue: 0,0:10:59.51,0:10:59.64,Captions-207-,,0,0,0,,Alubarna Kuzey BloğuDialogue: 0,0:10:59.64,0:10:59.76,Captions-207-,,0,0,0,,Alubarna Kuzey BloğuDialogue: 0,0:10:59.76,0:10:59.89,Captions-207-,,0,0,0,,Alubarna Kuzey BloğuDialogue: 0,0:10:59.89,0:11:00.01,Captions-207-,,0,0,0,,Alubarna Kuzey BloğuDialogue: 0,0:11:00.01,0:11:00.51,Captions-207-,,0,0,0,,Alubarna Kuzey BloğuDialogue: 0,0:11:00.51,0:11:00.76,Captions-207-,,0,0,0,,Alubarna Kuzey BloğuDialogue: 0,0:11:00.76,0:11:00.93,Captions-207-,,0,0,0,,Alubarna Kuzey BloğuDialogue: 0,0:11:00.93,0:11:01.06,Captions-207-,,0,0,0,,Alubarna Kuzey BloğuDialogue: 0,0:11:01.06,0:11:01.22,Captions-207-,,0,0,0,,Alubarna Kuzey BloğuDialogue: 0,0:11:01.22,0:11:08.65,Captions-207-,,0,0,0,,Alubarna Kuzey BloğuDialogue: 0,0:11:01.77,0:11:01.93,Captions-207-,,0,0,0,,Medi Toplantı Salonunun Arka Caddesindeki DövüşDialogue: 0,0:11:01.93,0:11:02.06,Captions-207-,,0,0,0,,Medi Toplantı Salonunun Arka Caddesindeki DövüşDialogue: 0,0:11:02.06,0:11:02.27,Captions-207-,,0,0,0,,Medi Toplantı Salonunun Arka Caddesindeki DövüşDialogue: 0,0:11:02.27,0:11:02.52,Captions-207-,,0,0,0,,Medi Toplantı Salonunun Arka Caddesindeki DövüşDialogue: 0,0:11:02.52,0:11:02.77,Captions-207-,,0,0,0,,Medi Toplantı Salonunun Arka Caddesindeki DövüşDialogue: 0,0:11:02.77,0:11:03.27,Captions-207-,,0,0,0,,Medi Toplantı Salonun