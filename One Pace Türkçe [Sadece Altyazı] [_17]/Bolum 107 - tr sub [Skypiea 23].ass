&H00000000,0,0,0,0,100,100,0,0,1,1.5,0,8,10,10,30,1Style: Karaoke,Duality,65,&H009E375F,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,8,10,10,30,1Style: Translation,Duality,65,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,3,0,2,10,10,30,1Style: Luffy Monologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1Style: KaraokeED,Duality,70,&H00FFFFFF,&H000000FF,&H00DB7A3A,&H00000000,0,0,0,0,100,100,2,0,1,3,0,7,30,8,15,1Style: TranslationED,Duality,70,&H00FFFFFF,&H000000FF,&H00DB7A3A,&H00000000,0,0,0,0,100,100,2,0,1,3,0,1,30,100,15,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:50.05,0:02:00.04,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 50,0:02:11.36,0:02:16.32,Main-207-,,0,0,0,,Duyabiliyor musunuz?! Kestane kafalı ihtiyar! Maymunlar!Dialogue: 50,0:02:23.12,0:02:25.25,Main-207-,,0,0,0,,Altın Şehir...Dialogue: 50,0:02:25.63,0:02:33.30,Main-207-,,0,0,0,,burada!!!Dialogue: 50,0:02:38.97,0:02:42.35,Main-207-,,0,0,0,,Lanet olası, gerçekten başardı!Dialogue: 50,0:02:43.23,0:02:45.31,Main-207-,,0,0,0,,Ne güzel...Dialogue: 50,0:02:45.69,0:02:47.61,Main-207-,,0,0,0,,Ne güzel bir ses!Dialogue: 50,0:02:47.61,0:02:49.77,Main-207-,,0,0,0,,Nedir bu, nedir?!Dialogue: 50,0:02:52.99,0:02:57.70,Main-207-,,0,0,0,,Hep bugünün geleceğine inandım.Dialogue: 50,0:02:58.53,0:03:04.04,Main-207-,,0,0,0,,Demek bu Noland'ın duyduğu çan sesi.Dialogue: 50,0:03:09.04,0:03:10.67,Main-207-,,0,0,0,,Suu...Dialogue: 50,0:03:10.67,0:03:11.71,Main-207-,,0,0,0,,bu...Dialogue: 50,0:03:12.42,0:03:14.80,Main-207-,,0,0,0,,vearth'ün şarkısı mı?Dialogue: 50,0:03:19.93,0:03:21.31,Main-207-,,0,0,0,,Tanrılar...Dialogue: 50,0:03:22.14,0:03:23.93,Main-207-,,0,0,0,,gerçekten var mı?Dialogue: 50,0:03:24.43,0:03:26.56,Main-207-,,0,0,0,,Ne mucize ama!Dialogue: 100,0:03:26.56,0:03:28.85,Main-207-,,0,0,0,,400 yıllık sessizliğin ardından...Dialogue: 100,0:03:28.88,0:03:34.43,Main-207-,,0,0,0,,yeniden çalacağını duyacağımdan neredeyse ümidimi kesmiştim.Dialogue: 50,0:03:35.03,0:03:37.07,Main-207-,,0,0,0,,Şanlı Savaşçı Kalgara...Dialogue: 50,0:03:37.86,0:03:39.49,Main-207-,,0,0,0,,Shandora'nın Işığı'nın...Dialogue: 50,0:03:40.70,0:03:43.79,Main-207-,,0,0,0,,yankısını duyabiliyor musun?Dialogue: 50,0:03:50.42,0:03:53.46,Main-207-,,0,0,0,,Bu ülkede neler oluyor?Dialogue: 50,0:03:54.42,0:03:56.63,Main-207-,,0,0,0,,Bu ses de ne?Dialogue: 50,0:03:56.63,0:03:58.18,Main-207-,,0,0,0,,Yoksa bu...Dialogue: 50,0:03:58.18,0:04:00.43,Main-207-,,0,0,0,,efsanevi ses mi?Dialogue: 50,0:04:06.68,0:04:08.35,Main-207-,,0,0,0,,Duyabiliyor musun,Dialogue: 50,0:04:09.02,0:04:11.02,Main-207-,,0,0,0,,Mont Blanc Noland?Dialogue: 50,0:04:11.61,0:04:13.90,Main-207-,,0,0,0,,Bu kadar beklettiğimiz için üzgünüm.Dialogue: 50,0:04:14.78,0:04:16.28,Main-207-,,0,0,0,,Umarım torunun...Dialogue: 50,0:04:16.94,0:04:18.78,Main-207-,,0,0,0,,duyabiliyordur.Dialogue: 50,0:04:26.95,0:04:30.67,Flashbacks-207-,,0,0,0,,Bu çanın sesini sen de seviyorsun, ha?Dialogue: 50,0:04:45.93,0:04:48.27,Main-207-,,0,0,0,,Patron! B-Bu ses...Dialogue: 50,0:04:49.10,0:04:50.31,Main-207-,,0,0,0,,Evet!Dialogue: 50,0:04:50.31,0:04:51.85,Main-207-,,0,0,0,,Hiç şüphe yok.Dialogue: 50,0:04:51.85,0:04:55.90,Main-207-,,0,0,0,,Dünyada sesi bu kadar uzağa yankılanan tek bir çan var!Dialogue: 50,0:04:56.40,0:04:58.82,Main-207-,,0,0,0,,İşte romantizm budur.Dialogue: 50,0:05:02.41,0:05:03.28,Main-207-,,0,0,0,,Gökyüzünde...Dialogue: 50,0:05:03.28,0:05:05.16,Main-207-,,0,0,0,,Şimdi iyice heyecanlandım...Dialogue: 50,0:05:05.16,0:05:09.04,Main-207-,,0,0,0,,İmparator kümülüsle birlikte ortaya çıkan canavarlar hakkında...Dialogue: 50,0:05:09.04,0:05:11.37,Main-207-,,0,0,0,,bir efsane var.Dialogue: 50,0:05:11.75,0:05:17.00,Main-207-,,0,0,0,,Gökyüzünde yoğun güneş ışığına maruz kalan insanların gölgesi,Dialogue: 50,0:05:17.00,0:05:20.76,Main-207-,,0,0,0,,bulutların aşağısına ve sise yansıyıp...Dialogue: 50,0:05:20.76,0:05:25.76,Main-207-,,0,0,0,,dev bir canavar gibi görünür.Dialogue: 50,0:05:26.18,0:05:30.23,Main-207-,,0,0,0,,Öyleyse o canavarlar gökyüzündeki insanlar mı?!Dialogue: 50,0:05:30.23,0:05:36.40,Main-207-,,0,0,0,,Yani orada insanların yaşadığını sonunda kanıtladık mı?!Dialogue: 50,0:05:36.40,0:05:37.61,Main-207-,,0,0,0,,Evet.Dialogue: 50,0:05:37.61,0:05:42.41,Main-207-,,0,0,0,,Bu hikayeyi sadece anlamsız bir fantazi olarak görmüştüm...Dialogue: 50,0:05:42.41,0:05:45.24,Main-207-,,0,0,0,,ama sanırım hepsi doğruymuş.Dialogue: 50,0:05:46.70,0:05:50.83,Main-207-,,0,0,0,,Büyük altın çanın sesini duyabiliyoruz.Dialogue: 50,0:05:54.88,0:05:59.01,Main-207-,,0,0,0,,Altın Şehir gerçekten var ve gökyüzünde!Dialogue: 50,0:05:59.80,0:06:05.72,Main-207-,,0,0,0,,Atam Noland, bir yalancı değildi!Dialogue: 50,0:06:07.47,0:06:11.98,Main-207-,,0,0,0,,Bunu gökyüzünden bana söyleyen sensin,Dialogue: 50,0:06:12.81,0:06:14.94,Main-207-,,0,0,0,,değil mi, çocuk?Dialogue: 50,0:06:14.94,0:06:16.73,Main-207-,,0,0,0,,Minnettarım!Dialogue: 50,0:06:35.67,0:06:36.92,Main-207-,,0,0,0,,Patron?!Dialogue: 50,0:06:36.92,0:06:38.21,Main-207-,,0,0,0,,Ne oldu?Dialogue: 50,0:06:38.21,0:06:40.00,Main-207-,,0,0,0,,Hasta mısın?!Dialogue: 50,0:06:40.67,0:06:44.93,Main-207-,,0,0,0,,O çocukların güvende olmasına sevindim...!Dialogue: 50,0:06:46.97,0:06:50.77,Main-207-,,0,0,0,,Çok... endişelenmiştim...Dialogue: 50,0:07:09.08,0:07:10.74,Main-207-,,0,0,0,,Bakın! O...Dialogue: 50,0:07:12.75,0:07:14.62,Main-207-,,0,0,0,,Tanrı'nın gemisi...Dialogue: 50,0:07:19.79,0:07:21.38,Main-207-,,0,0,0,,ve kendisi!Dialogue: 50,0:07:25.42,0:07:26.59,Main-207-,,0,0,0,,Batıyorlar.Dialogue: 50,0:07:28.43,0:07:31.31,Main-207-,,0,0,0,,Tanrı Enel ve gemisi...Dialogue: 50,0:07:31.76,0:07:33.77,Main-207-,,0,0,0,,batıyor.Dialogue: 50,0:07:39.23,0:07:41.07,Main-207-,,0,0,0,,Çanın sesi...Dialogue: 50,0:07:41.48,0:07:46.36,Main-207-,,0,0,0,,"Shandora'nın Işığı" olarak kayıp şehrin görkemini haykırıyordu.Dialogue: 50,0:07:50.87,0:07:56.58,Main-207-,,0,0,0,,"Adanın şarkısı" savaşın sona erdiğini bildirdi.Dialogue: 50,0:07:58.04,0:08:03.30,Main-207-,,0,0,0,,400 yıllık sessizliğin ardından altın çan sözünü tuttu.Dialogue: 50,0:08:15.35,0:08:18.39,Narrator-207-,,0,0,0,,Uyuklayan yüzen adanın yolculuğu çok uzundu ama...Dialogue: 50,0:08:18.39,0:08:20.94,Narrator-207-,,0,0,0,,uzak geçmişteki anıları unutmak çok zordu.Dialogue: 50,0:08:21.81,0:08:25.99,Narrator-207-,,0,0,0,,Adanın insanları bir zamanlar o çanın sesine bir mesaj emanet etmişti,Dialogue: 50,0:08:31.74,0:08:37.96,Narrator-207-,,0,0,0,,böylece gururlu sözleri engin denizlere yayılacaktı.Dialogue: 50,0:08:42.13,0:08:43.88,Main-207-,,0,0,0,,Yoldaşlarım...!Dialogue: 50,0:08:49.55,0:08:51.30,Main-207-,,0,0,0,,Çaldı...Dialogue: 50,0:08:51.76,0:08:52.68,Main-207-,,0,0,0,,Evet.Dialogue: 50,0:08:54.10,0:08:56.68,Main-207-,,0,0,0,,Acaba ihtiyar ve yanındakiler duydu mu?Dialogue: 50,0:08:57.02,0:08:59.48,Main-207-,,0,0,0,,Evet, duyduklarına eminim.Dialogue: 50,0:09:08.82,0:09:11.49,Flashbacks-207-,,0,0,0,,Biz buradayız!Dialogue: 50,0:09:17.16,0:09:21.00,Main-207-,,0,0,0,,İpleri sağlam olan ağaçlara bağlayın!Dialogue: 50,0:09:52.86,0:09:53.99,Main-207-,,0,0,0,,Aisa...Dialogue: 50,0:09:54.62,0:09:56.12,Main-207-,,0,0,0,,Endişelendin mi?Dialogue: 50,0:09:56.58,0:09:59.54,Main-207-,,0,0,0,,İşte... hazinen!Dialogue: 50,0:09:59.95,0:10:02.41,Main-207-,,0,0,0,,Umurumda değil artık!Dialogue: 50,0:10:04.25,0:10:05.63,Main-207-,,0,0,0,,Raki...Dialogue: 50,0:10:15.47,0:10:16.14,Main-207-,,0,0,0,,Diğerleri...Dialogue: 50,0:10:16.14,0:10:17.18,Main-207-,,0,0,0,,İyiler!Dialogue: 50,0:10:17.18,0:10:18.76,Main-207-,,0,0,0,,Enerjini sakla...Dialogue: 50,0:10:19.39,0:10:20.64,Main-207-,,0,0,0,,Orada biri var!Dialogue: 50,0:10:21.77,0:10:24.73,Thoughts-207-,,0,0,0,,Yaşıyor muyum?Dialogue: 50,0:10:24.73,0:10:27.57,Main-207-,,0,0,0,,Hayır, tedaviye ihtiyacın var!Dialogue: 50,0:10:27.94,0:10:29.48,Main-207-,,0,0,0,,Bekleyebilirim.Dialogue: 50,0:10:29.48,0:10:30.53,Main-207-,,0,0,0,,Ha?!Dialogue: 50,0:10:30.53,0:10:34.95,Main-207-,,0,0,0,,İyi olacağım. Önce ona yardım etmelisin.Dialogue: 50,0:10:34.95,0:10:36.41,Main-207-,,0,0,0,,Zar zor hayatta.Dialogue: 50,0:10:46.29,0:10:48.75,Main-207-,,0,0,0,,Haklısın! Kemikleri bile kırılmış!Dialogue: 50,0:10:48.75,0:10:50.13,Main-207-,,0,0,0,,Hiç iyi değil!Dialogue: 50,0:10:50.13,0:10:53.01,Main-207-,,0,0,0,,Hey, o gerilla değil mi?Dialogue: 50,0:10:53.01,0:10:54.51,Main-207-,,0,0,0,,Ona borçlu değiliz.Dialogue: 50,0:10:54.51,0:10:55.76,Main-207-,,0,0,0,,Evet.Dialogue: 50,0:10:55.76,0:10:57.97,Main-207-,,0,0,0,,Tam olarak anlamıyorum...Dialogue: 50,0:10:58.30,0:11:00.68,Main-207-,,0,0,0,,ama hayatını riske attı, o yüzden...Dialogue: 50,0:11:00.68,0:11:01.68,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:11:01.68,0:11:04.52,Main-207-,,0,0,0,,Ne oluyor be? Sempati mi duyuyorsun?Dialogue: 50,0:11:04.94,0:11:05.98,Main-207-,,0,0,0,,Kim bilir...?Dialogue: 50,0:11:07.81,0:11:08.90,Main-207-,,0,0,0,,Şey...Dialogue: 50,0:11:09.52,0:11:11.65,Main-207-,,0,0,0,,İyileşecek mi, Tanuki-chan?Dialogue: 50,0:11:11.65,0:11:14.40,Main-207-,,0,0,0,,Ben ren geyiğiyim! Bak, boynuzlarım var!Dialogue: 50,0:11:15.36,0:11:17.95,Main-207-,,0,0,0,,Endişelenme. Hayatta kalacaktır.Dialogue: 50,0:11:18.95,0:11:20.12,Main-207-,,0,0,0,,Teşekkür ederim!Dialogue: 50,0:11:23.91,0:11:28.25,Main-207-,,0,0,0,,Pierre, git ve Mavi Deniz sakinleriyle birlikte dinlen.Dialogue: 50,0:11:33.55,0:11:37.13,Main-207-,,0,0,0,,Pierre, çabuk. Git ve askerlerin ailelerini buraya getir.Dialogue: 50,0:11:40.64,0:11:46.10,Main-207-,,0,0,0,,Sonuçta altın çan ve Enel'in altın gemisi...Dialogue: 50,0:11:46.94,0:11:48.81,Main-207-,,0,0,0,,İkisi de düştüler, değil mi?Dialogue: 50,0:11:50.23,0:11:53.69,Main-207-,,0,0,0,,Sanırım artık sadece ismen Altın Şehir, ha?Dialogue: 50,0:11:54.19,0:11:57.66,Main-207-,,0,0,0,,Meteliksiz yolculuğumuz devam ediyor.Dialogue: 50,0:11:58.41,0:12:00.78,Main-207-,,0,0,0,,Altından çok dial istiyorum.Dialogue: 50,0:12:00.78,0:12:03.45,Main-207-,,0,0,0,,Mavi Deniz'de onlardan hiç bulamayacağız.Dialogue: 50,0:12:03.45,0:12:07.08,Main-207-,,0,0,0,,Umarım Nami-san iyidir...Dialogue: 50,0:12:07.08,0:12:09.38,Main-207-,,0,0,0,,Ve Conis-chan nerede, merak ediyorum.Dialogue: 50,0:12:14.38,0:12:17.47,Main-207-,,0,0,0,,Wyper'ı Mavi Denizlilere bırakmakta bir sakınca var mı?Dialogue: 50,0:12:17.47,0:12:18.72,Main-207-,,0,0,0,,Sorun yok.Dialogue: 50,0:12:18.72,0:12:21.39,Main-207-,,0,0,0,,Aisa onlarla arkadaş olmuş gibi görünüyor.Dialogue: 50,0:12:21.39,0:12:23.31,Main-207-,,0,0,0,,Her hâlükârda, acele etmeliyiz!Dialogue: 50,0:12:23.31,0:12:25.54,Main-207-,,0,0,0,,Düşmanlarımız uyanırsa her şey boşa gidecek!Dialogue: 50,0:12:25.54,0:12:26.89,Main-207-,,0,0,0,,İyi olanlar hazırlansın!Dialogue: 50,0:12:27.52,0:12:29.65,Main-207-,,0,0,0,,Rahipleri akıntı bulutuna atacağız.Dialogue: 50,0:12:29.65,0:12:31.02,Main-207-,,0,0,0,,– Tamam! – Tamam!Dialogue: 50,0:12:32.98,0:12:34.86,Main-207-,,0,0,0,,Onunla işin bitti mi?Dialogue: 50,0:12:34.86,0:12:37.15,Main-207-,,0,0,0,,Evet, tek yapması gereken dinlenmek.Dialogue: 50,0:12:37.15,0:12:41.95,Main-207-,,0,0,0,,Heey!Dialogue: 50,0:12:39.61,0:12:40.70,Secondary-207-,,0,0,0,,Luffy!Dialogue: 50,0:12:47.20,0:12:49.16,Main-207-,,0,0,0,,Nami-swan!Dialogue: 50,0:12:49.50,0:12:50.96,Main-207-,,0,0,0,,Conis-chwan!Dialogue: 50,0:12:50.96,0:12:52.79,Main-207-,,0,0,0,,Luffy!Dialogue: 50,0:12:57.63,0:12:59.26,Main-207-,,0,0,0,,Hepinizin...Dialogue: 50,0:12:59.26,0:13:01.47,Main-207-,,0,0,0,,iyi olmasına sevindim!Dialogue: 50,0:13:03.18,0:13:05.81,Main-207-,,0,0,0,,Çok endişelendim ama hiçbir şey yapamadım.Dialogue: 50,0:13:05.81,0:13:09.18,Main-207-,,0,0,0,,Conis-chan, benim için mi endişelendin?!Dialogue: 50,0:13:08.06,0:13:09.18,Main-207-,,0,0,0,,Bundan emin değilim.Dialogue: 50,0:13:09.56,0:13:11.44,Main-207-,,0,0,0,,O yiyecek mi?Dialogue: 50,0:13:11.44,0:13:12.44,Main-207-,,0,0,0,,Nereden buldun?Dialogue: 50,0:13:12.44,0:13:16.15,Main-207-,,0,0,0,,Ormandan geri dönerken rahiplerin yiyecek stoğunu bulduk.Dialogue: 50,0:13:16.15,0:13:17.44,Main-207-,,0,0,0,,Daha fazlası vardı!Dialogue: 50,0:13:17.44,0:13:20.15,Main-207-,,0,0,0,,Ama o kadar yüksekten nasıl indiniz?Dialogue: 50,0:13:20.15,0:13:22.11,Main-207-,,0,0,0,,Lastik-Lastik Balon ile.Dialogue: 50,0:13:22.99,0:13:24.87,Main-207-,,0,0,0,,Sahi Conis, baban nerede?Dialogue: 50,0:13:24.87,0:13:25.58,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:13:26.58,0:13:29.08,Main-207-,,0,0,0,,Şey, o...Dialogue: 50,0:13:29.08,0:13:30.54,Main-207-,,0,0,0,,beni korudu...Dialogue: 50,0:13:31.12,0:13:31.92,Main-207-,,0,0,0,,ve Enel...Dialogue: 50,0:13:37.42,0:13:38.67,Main-207-,,0,0,0,,Yoksa...Dialogue: 50,0:13:42.55,0:13:44.22,Main-207-,,0,0,0,,Conis-chan...Dialogue: 50,0:13:44.22,0:13:46.10,Main-207-,,0,0,0,,Conis-san...Dialogue: 50,0:13:46.60,0:13:48.06,Main-207-,,0,0,0,,Conis...Dialogue: 50,0:13:50.02,0:13:52.14,Main-207-,,0,0,0,,– Hey, senden bahsediyoruz! – Hey, senden bahsediyoruz!Dialogue: 50,0:13:52.14,0:13:54.06,Main-207-,,0,0,0,,Üzgünüm ama hâlâ hayattayım!Dialogue: 50,0:13:54.98,0:13:56.40,Main-207-,,0,0,0,,Baba!Dialogue: 50,0:13:58.94,0:14:00.44,Main-207-,,0,0,0,,Aşağıdaki Beyaz Deniz mi?Dialogue: 50,0:14:00.44,0:14:04.28,Main-207-,,0,0,0,,Evet, kendime geldiğimde oradaydım.Dialogue: 50,0:14:04.28,0:14:08.70,Main-207-,,0,0,0,,Bulutun Sonu'na gitmek için aşağı inen insanlar, restore ettikleri...Dialogue: 50,0:14:08.70,0:14:13.50,Main-207-,,0,0,0,,süt yollarını kullanarak tek tek Beyaz-Beyaz Deniz'e geri dönüyorlar.Dialogue: 50,0:14:13.50,0:14:17.63,Main-207-,,0,0,0,,Ama artık dönebilecekleri bir Melek Adası yok.Dialogue: 50,0:14:17.63,0:14:21.34,Main-207-,,0,0,0,,Bu yüzden herkes Yukarı Bahçe'ye geliyor.Dialogue: 50,0:14:35.40,0:14:37.90,Main-207-,,0,0,0,,– Teşekkür ederim! – Teşekkür ederim, Tanrı'm!Dialogue: 50,0:14:38.65,0:14:41.36,Main-207-,,0,0,0,,Artık öyle biri değilim.Dialogue: 50,0:14:41.86,0:14:45.53,Main-207-,,0,0,0,,Böylesi bir yerde 6 yıl boyunca çalışmaya zorlandığınızı düşünmek...Dialogue: 50,0:14:45.53,0:14:47.45,Main-207-,,0,0,0,,Lütfen beni bağışlayın.Dialogue: 50,0:14:48.95,0:14:52.70,Main-207-,,0,0,0,,Artık dönecek bir evimiz yok.Dialogue: 50,0:14:52.70,0:14:56.25,Main-207-,,0,0,0,,Shandialılar da köylerini kaybetti.Dialogue: 50,0:14:56.58,0:14:59.96,Main-207-,,0,0,0,,Savaş gerçekten bitti mi?Dialogue: 50,0:15:06.55,0:15:08.97,Main-207-,,0,0,0,,Tanrı'nın Ordusu gitti ama...Dialogue: 50,0:15:08.97,0:15:14.02,Main-207-,,0,0,0,,Şef, gerçekten 400 yıllık bir yarayı bu kadar kolay onarabilir miyiz?Dialogue: 50,0:15:17.98,0:15:19.31,Main-207-,,0,0,0,,Tıka basa doydum!Dialogue: 50,0:15:19.31,0:15:20.69,Main-207-,,0,0,0,,Çoktan gece oldu.Dialogue: 50,0:15:20.69,0:15:22.15,Main-207-,,0,0,0,,Gemiye mi dönsek?Dialogue: 50,0:15:22.15,0:15:24.53,Main-207-,,0,0,0,,Nami, ne diyorsun sen?!Dialogue: 50,0:15:24.53,0:15:25.86,Main-207-,,0,0,0,,Ne demişim?!Dialogue: 50,0:15:25.86,0:15:28.07,Main-207-,,0,0,0,,Usopp, dediğini duydun mu?Dialogue: 50,0:15:28.07,0:15:30.20,Main-207-,,0,0,0,,Evet, hayal kırıklığı!Dialogue: 50,0:15:30.20,0:15:32.20,Main-207-,,0,0,0,,Bunca olaydan sonra,Dialogue: 50,0:15:32.20,0:15:34.79,Main-207-,,0,0,0,,korsan olarak sınıfta kaldın, hayır, insan olarak!Dialogue: 50,0:15:34.79,0:15:38.21,Main-207-,,0,0,0,,Ne saçmalıyorsunuz siz?!Dialogue: 50,0:15:44.63,0:15:49.30,Main-207-,,0,0,0,,Tanrı'nın ait olduğu yere döneceğim!Dialogue: 50,0:15:49.72,0:15:55.43,Main-207-,,0,0,0,,Gökyüzünde görüş alanımı engelleyen hiçbir şey olmamalı.Dialogue: 50,0:15:56.23,0:15:59.31,Main-207-,,0,0,0,,O insanlar yolumun üzerindeydi.Dialogue: 50,0:16:01.94,0:16:06.07,Main-207-,,0,0,0,,Benim olanı kimseye vermem. Sadece bana yakışıyor!Dialogue: 50,0:16:06.82,0:16:10.20,Main-207-,,0,0,0,,Hayallerimdeki engin, sonsuz dünya.Dialogue: 50,0:16:11.28,0:16:15.83,Main-207-,,0,0,0,,Pekâlâ, gidelim, Maxim...Dialogue: 50,0:16:15.83,0:16:20.29,Main-207-,,0,0,0,,Gece gökyüzünde ışıl ışıl süzülen tanrıların diyarına...Dialogue: 50,0:16:20.29,0:16:22.46,Main-207-,,0,0,0,,Sınırsız topraklara...Dialogue: 50,0:16:22.46,0:16:24.96,Main-207-,,0,0,0,,Sonsuz Vearth'e!Dialogue: 50,0:16:35.31,0:16:36.73,Main-207-,,0,0,0,,Neredeyim ben?Dialogue: 50,0:16:36.73,0:16:39.60,Main-207-,,0,0,0,,Shandora kalıntılarında.Dialogue: 50,0:16:40.60,0:16:42.23,Main-207-,,0,0,0,,Gan Fall!Dialogue: 50,0:16:42.23,0:16:44.36,Main-207-,,0,0,0,,Oh, hareket etmemelisin!Dialogue: 50,0:16:44.36,0:16:46.61,Main-207-,,0,0,0,,Sen adalılardansın!Dialogue: 50,0:16:47.95,0:16:49.86,Main-207-,,0,0,0,,Dinlenmelisin.Dialogue: 50,0:16:50.57,0:16:51.70,Main-207-,,0,0,0,,Şef!Dialogue: 50,0:16:51.70,0:16:55.83,Main-207-,,0,0,0,,Savaşta yaralanan herkese aynı muamele yapılacaktır.Dialogue: 50,0:16:55.83,0:16:57.62,Main-207-,,0,0,0,,Ama altın çan...Dialogue: 50,0:16:57.62,0:17:00.87,Main-207-,,0,0,0,,Onu korumak hâlâ görevimiz!Dialogue: 50,0:17:02.96,0:17:04.46,Main-207-,,0,0,0,,Bu...Dialogue: 50,0:17:05.17,0:17:07.42,Main-207-,,0,0,0,,savaş davullarının sesi!Dialogue: 50,0:17:08.13,0:17:09.88,Main-207-,,0,0,0,,Harabeyi de ateş sarmış!Dialogue: 50,0:17:10.59,0:17:12.26,Main-207-,,0,0,0,,Sakin ol, Wyper.Dialogue: 50,0:17:12.26,0:17:14.76,Main-207-,,0,0,0,,Sabırlı ol ve olayları akışına bırak.Dialogue: 50,0:17:14.76,0:17:19.43,Main-207-,,0,0,0,,Uzak geçmişte savaşma sebeplerimiz ne olursa olsun...Dialogue: 50,0:17:19.43,0:17:23.94,Main-207-,,0,0,0,,gökyüzü, şu an hayatta olan bizlerin evi.Dialogue: 50,0:17:23.94,0:17:27.61,Main-207-,,0,0,0,,En azından toprak kimseyi reddetmiyor.Dialogue: 50,0:17:27.61,0:17:28.74,Main-207-,,0,0,0,,Aynen öyle.Dialogue: 50,0:17:28.74,0:17:31.82,Main-207-