000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,2.95,0,8,23,23,146,1Style: Karaoke-furigana,Duality,36,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,2.95,0,8,23,23,23,1Style: Lyrics-furigana,Duality,36,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,2.95,0,2,23,23,34,1Style: Lyrics,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,2,23,23,34,1Style: Karaoke,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,23,1Style: Kanji,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,146,1Style: Roger-Monologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1Style: Romaji ED,Josefin Sans,80,&H00D0740C,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,8,10,10,20,1Style: Translation ED,Josefin Sans,82,&H00D0740C,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,2,10,10,20,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:50.01,0:02:00.01,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:57.01,0:01:59.14,Flashbacks-207-,,0,0,0,,Asla öğrenmiyorsun, değil mi?!Dialogue: 0,0:01:59.14,0:02:01.81,Flashbacks-207-,,0,0,0,,Bırak beni! Sonra ödeyeceğim!Dialogue: 0,0:02:02.19,0:02:02.94,Flashbacks-207-,,0,0,0,,Vücudumla!Dialogue: 0,0:02:02.94,0:02:03.65,Flashbacks-207-,,0,0,0,,Sen de mi?!Dialogue: 0,0:02:04.02,0:02:05.61,Flashbacks-207-,,0,0,0,,Yine mi çocukları ağlattınız?!Dialogue: 0,0:02:05.61,0:02:07.57,Flashbacks-207-,,0,0,0,,Bizi çıldırttılar!Dialogue: 0,0:02:07.57,0:02:09.65,Flashbacks-207-,,0,0,0,,Sorun değil. Çocuklar işte.Dialogue: 0,0:02:09.65,0:02:11.74,Flashbacks-207-,,0,0,0,,Mandalinalarına bok gibi dediler!Dialogue: 0,0:02:11.74,0:02:12.57,Flashbacks-207-,,0,0,0,,Öyle mi?!Dialogue: 0,0:02:12.57,0:02:13.53,Flashbacks-207-,,0,0,0,,Bell-mère!Dialogue: 0,0:02:14.74,0:02:16.45,Flashbacks-207-,,0,0,0,,Kimseye kendinizi ezdirmeyin.Dialogue: 0,0:02:17.70,0:02:21.41,Flashbacks-207-,,0,0,0,,Kızların bile güçlü olması gerekir.Dialogue: 0,0:02:21.41,0:02:23.29,Flashbacks-207-,,0,0,0,,İnsanların sizi övmemesi önemsiz!Dialogue: 0,0:02:24.37,0:02:26.71,Flashbacks-207-,,0,0,0,,Doğduğunuz çağa lanet okumayın.Dialogue: 0,0:02:30.38,0:02:34.47,Flashbacks-207-,,0,0,0,,Ne olursa olsun gülümsemeyi unutmayın.Dialogue: 0,0:02:37.64,0:02:43.64,Flashbacks-207-,,0,0,0,,– Bell-mère-san! – Bell-mère-san!Dialogue: 0,0:02:46.56,0:02:49.57,Main-207-,,0,0,0,,Benim yönetimimde, parası olmayan ölür!Dialogue: 0,0:02:49.57,0:02:52.28,Main-207-,,0,0,0,,Anladınız mı, sizi solucanlar?!Dialogue: 0,0:02:55.45,0:02:56.28,Main-207-,,0,0,0,,Bu da ne?Dialogue: 0,0:02:57.41,0:02:58.41,Main-207-,,0,0,0,,Deniz haritası mı?Dialogue: 0,0:02:58.41,0:02:59.37,Main-207-,,0,0,0,,Dokunma!Dialogue: 0,0:02:59.78,0:03:01.87,Main-207-,,0,0,0,,Onu ben çizdim! Benim için önemli!Dialogue: 0,0:03:01.87,0:03:03.37,Main-207-,,0,0,0,,Geri ver!Dialogue: 0,0:03:03.37,0:03:04.83,Main-207-,,0,0,0,,Sen mi çizdin?Dialogue: 0,0:03:04.83,0:03:06.97,Main-207-,,0,0,0,,Geri ver!Dialogue: 0,0:03:05.46,0:03:06.97,Secondary-207-,,0,0,0,,Nami! Yapma!Dialogue: 0,0:03:07.54,0:03:08.67,Main-207-,,0,0,0,,Öyle mi?Dialogue: 0,0:03:09.17,0:03:11.00,Main-207-,,0,0,0,,Oldukça etkileyici.Dialogue: 0,0:03:11.96,0:03:14.59,Main-207-,,0,0,0,,İşe yarar bu ufaklık! Getirin şunu!Dialogue: 0,0:03:14.59,0:03:15.72,Main-207-,,0,0,0,,Anlaşıldı!Dialogue: 0,0:03:15.72,0:03:17.26,Main-207-,,0,0,0,,Hayır!Dialogue: 0,0:03:17.26,0:03:19.76,Main-207-,,0,0,0,,Bırakın! Bırakın! Hayır!Dialogue: 0,0:03:20.14,0:03:22.22,Main-207-,,0,0,0,,Nami'yi bırak! Bıraksana!Dialogue: 0,0:03:21.01,0:03:22.22,Secondary-207-,,0,0,0,,Dur!Dialogue: 0,0:03:22.64,0:03:24.48,Main-207-,,0,0,0,,Paranızı aldınız!Dialogue: 0,0:03:24.48,0:03:26.48,Main-207-,,0,0,0,,Ona dokunmayacağına söz vermiştin!Dialogue: 0,0:03:26.48,0:03:29.69,Main-207-,,0,0,0,,Sözüm söz. Sadece onu ödünç alacağım.Dialogue: 0,0:03:29.69,0:03:31.44,Main-207-,,0,0,0,,Gen-san ! Yardım et!Dialogue: 0,0:03:31.44,0:03:33.11,Main-207-,,0,0,0,,Elinizi çocuklardan çekin!Dialogue: 0,0:03:33.48,0:03:34.11,Main-207-,,0,0,0,,Kuroobi.Dialogue: 0,0:03:39.07,0:03:39.91,Main-207-,,0,0,0,,Gen-san !Dialogue: 0,0:03:40.70,0:03:42.29,Main-207-,,0,0,0,,Gen-san ! Gen-san !Dialogue: 0,0:03:42.83,0:03:44.25,Main-207-,,0,0,0,,Gen-san !Dialogue: 0,0:03:50.13,0:03:52.84,Main-207-,,0,0,0,,Seni kurtaracağım, Nami...Dialogue: 0,0:03:53.38,0:03:55.30,Main-207-,,0,0,0,,Geçmenize izin vermem!Dialogue: 0,0:03:55.30,0:03:58.80,Main-207-,,0,0,0,,Hayır! Yapma! Beni kurtarmana gerek yok!Dialogue: 0,0:03:59.43,0:04:00.09,Main-207-,,0,0,0,,Lütfen!Dialogue: 0,0:04:00.09,0:04:00.89,Main-207-,,0,0,0,,Yetti be.Dialogue: 0,0:04:00.89,0:04:02.35,Main-207-,,0,0,0,,Seni... kurtar–Dialogue: 0,0:04:05.64,0:04:09.40,Main-207-,,0,0,0,,Başka ölüm istemiyorum!Dialogue: 0,0:04:17.95,0:04:22.07,Main-207-,,0,0,0,,Köyün bütün gemilerini batırdılar.Dialogue: 0,0:04:22.07,0:04:26.54,Main-207-,,0,0,0,,Nojiko ve Nami'yi denize kaçırma planımız,Dialogue: 0,0:04:26.54,0:04:28.00,Main-207-,,0,0,0,,aptalcaydı.Dialogue: 0,0:04:28.75,0:04:31.50,Main-207-,,0,0,0,,Korktuğum gibi, Denizciler bize yardım etmeyecek.Dialogue: 0,0:04:31.50,0:04:33.38,Main-207-,,0,0,0,,Burası artık onun adası.Dialogue: 0,0:04:33.38,0:04:35.88,Main-207-,,0,0,0,,Bell-mère biliyordu!Dialogue: 0,0:04:36.38,0:04:40.72,Main-207-,,0,0,0,,Korsanların ne bok olduğunu denizciyken öğrenmişti!Dialogue: 0,0:04:41.26,0:04:44.35,Main-207-,,0,0,0,,Bir kişinin bile bu adadan kaçamayacağını biliyordu.Dialogue: 0,0:04:48.94,0:04:51.15,Main-207-,,0,0,0,,Nami'yi alıp götürdüler.Dialogue: 0,0:04:51.60,0:04:53.06,Main-207-,,0,0,0,,Şimdi...Dialogue: 0,0:04:53.06,0:04:55.07,Main-207-,,0,0,0,,ne yapacağım,...Dialogue: 0,0:04:55.69,0:04:57.32,Main-207-,,0,0,0,,Bell-mère-san?Dialogue: 0,0:04:59.86,0:05:02.53,Main-207-,,0,0,0,,Arlong Korsanları'nın yerini bulduk!Dialogue: 0,0:05:02.53,0:05:05.62,Main-207-,,0,0,0,,Anlaşılan bu adaya yerleşmeye niyetliler!Dialogue: 0,0:05:06.08,0:05:07.41,Main-207-,,0,0,0,,Karar vermenin vaktidir!Dialogue: 0,0:05:07.79,0:05:09.66,Main-207-,,0,0,0,,Şimdi sonuna kadar savaşacak mıyız?!Dialogue: 0,0:05:09.66,0:05:12.92,Main-207-,,0,0,0,,Yoksa canımızı cellada emanet edip...Dialogue: 0,0:05:12.92,0:05:15.55,Main-207-,,0,0,0,,hükümetten medet mi umacağız?!Dialogue: 0,0:05:15.55,0:05:16.75,Main-207-,,0,0,0,,Seçiminizi yapın!Dialogue: 0,0:05:17.42,0:05:20.47,Main-207-,,0,0,0,,Sadece Denizci Karargâhı'nın onlara karşı şansı olur!Dialogue: 0,0:05:20.84,0:05:23.97,Main-207-,,0,0,0,,Ama karargâhın eli Grand Line'la dolu.Dialogue: 0,0:05:23.97,0:05:28.10,Main-207-,,0,0,0,,Onların buraya kadar gelme ihtimali neredeyse sıfır!Dialogue: 0,0:05:28.10,0:05:31.48,Main-207-,,0,0,0,,Ama Nami'yi terkedemem!Dialogue: 0,0:05:31.98,0:05:32.81,Main-207-,,0,0,0,,Savaşacağım!Dialogue: 0,0:05:35.57,0:05:36.94,Main-207-,,0,0,0,,Ben de!Dialogue: 0,0:05:36.94,0:05:40.03,Main-207-,,0,0,0,,Bir çocuğu terk edip yaşayabileceğimi sanmıyorum!Dialogue: 0,0:05:40.36,0:05:42.53,Main-207-,,0,0,0,,Hepimiz bir aileyiz!Dialogue: 0,0:05:42.53,0:05:45.62,Main-207-,,0,0,0,,Canım pahasına da olsa, Nacchan'ı kurtaracağım!Dialogue: 0,0:05:45.62,0:05:47.99,Main-207-,,0,0,0,,Bell-mère, o çocuklar için hayatını verdi!Dialogue: 0,0:05:48.41,0:05:49.87,Main-207-,,0,0,0,,Bu defa onları yeneceğiz!Dialogue: 0,0:05:49.87,0:05:52.58,Main-207-,,0,0,0,,Zaten birimiz bile karşı koyarsa, hepimiz suçlanırız!Dialogue: 0,0:06:00.38,0:06:01.34,Main-207-,,0,0,0,,Nami!Dialogue: 0,0:06:02.80,0:06:03.55,Main-207-,,0,0,0,,Nami!Dialogue: 0,0:06:03.55,0:06:04.43,Main-207-,,0,0,0,,Nacchan!Dialogue: 0,0:06:04.43,0:06:05.34,Main-207-,,0,0,0,,İyi misin?!Dialogue: 0,0:06:05.93,0:06:07.51,Main-207-,,0,0,0,,Nami! Nami!Dialogue: 0,0:06:08.39,0:06:11.73,Main-207-,,0,0,0,,İyi misin? Yaralandın mı? Sana bir şey yaptılar mı?Dialogue: 0,0:06:14.52,0:06:15.27,Main-207-,,0,0,0,,Nami?Dialogue: 0,0:06:15.27,0:06:18.32,Main-207-,,0,0,0,,Ben... onlara...Dialogue: 0,0:06:18.32,0:06:19.15,Main-207-,,0,0,0,,Ne?Dialogue: 0,0:06:19.94,0:06:21.53,Main-207-,,0,0,0,,Ben...Dialogue: 0,0:06:21.53,0:06:23.74,Main-207-,,0,0,0,,Arlong korsanlarına katılacağım...Dialogue: 0,0:06:24.61,0:06:26.95,Main-207-,,0,0,0,,ve onlara deniz haritaları çizeceğim!Dialogue: 0,0:06:31.95,0:06:34.04,Main-207-,,0,0,0,,Ne diyorsun, Nami?Dialogue: 0,0:06:34.79,0:06:36.54,Main-207-,,0,0,0,,Aklını mı kaçırdın?Dialogue: 0,0:06:36.54,0:06:39.25,Main-207-,,0,0,0,,Sana korkunç bir şey mi yaptılar?Dialogue: 0,0:06:39.25,0:06:40.84,Main-207-,,0,0,0,,Söyle, ha?Dialogue: 0,0:06:40.84,0:06:41.51,Main-207-,,0,0,0,,Hayır.Dialogue: 0,0:06:41.51,0:06:42.88,Main-207-,,0,0,0,,Seni tehdit ettiler,Dialogue: 0,0:06:42.88,0:06:43.88,Main-207-,,0,0,0,,değil mi?!Dialogue: 0,0:06:43.88,0:06:44.30,Main-207-,,0,0,0,,Söyle!Dialogue: 0,0:06:42.88,0:06:43.84,Secondary-207-,,0,0,0,,Hayır!Dialogue: 0,0:06:44.30,0:06:46.34,Main-207-,,0,0,0,,Bırak beni!Dialogue: 0,0:06:46.34,0:06:47.39,Main-207-,,0,0,0,,Nami...!Dialogue: 0,0:06:47.89,0:06:48.80,Main-207-,,0,0,0,,Nami!Dialogue: 0,0:06:52.64,0:06:55.31,Main-207-,,0,0,0,,O... O Arlong'un dövmesi.Dialogue: 0,0:06:56.44,0:06:57.19,Main-207-,,0,0,0,,Sen...Dialogue: 0,0:06:57.86,0:06:58.98,Main-207-,,0,0,0,,Nami...Dialogue: 0,0:07:00.23,0:07:01.86,Main-207-,,0,0,0,,Şuna bakın...Dialogue: 0,0:07:01.86,0:07:04.36,Main-207-,,0,0,0,,Bana bir sürü para verdiler,...Dialogue: 0,0:07:07.37,0:07:10.45,Main-207-,,0,0,0,,istediğim her şeyi de alacaklarını söylediler.Dialogue: 0,0:07:10.45,0:07:11.74,Main-207-,,0,0,0,,Nami!Dialogue: 0,0:07:13.29,0:07:14.87,Main-207-,,0,0,0,,Affedilemez! Rezilsin!Dialogue: 0,0:07:14.87,0:07:17.58,Main-207-,,0,0,0,,Onlara katılırsan seni asla affetmem!Dialogue: 0,0:07:17.58,0:07:19.46,Main-207-,,0,0,0,,Onlara değil! Hayatta olmaz!Dialogue: 0,0:07:19.46,0:07:21.80,Main-207-,,0,0,0,,Onların kim olduğunu anlamadın mı?!Dialogue: 0,0:07:22.21,0:07:23.34,Main-207-,,0,0,0,,Kimin umurunda?!Dialogue: 0,0:07:23.34,0:07:26.43,Main-207-,,0,0,0,,Onurlu yaşamak beni Bell-mère-san gibi öldürtecekse,Dialogue: 0,0:07:26.43,0:07:29.43,Main-207-,,0,0,0,,öyle yaşam, yerin dibine batsın!Dialogue: 0,0:07:31.56,0:07:32.97,Main-207-,,0,0,0,,Sana inanamıyorum.Dialogue: 0,0:07:33.43,0:07:35.10,Main-207-,,0,0,0,,Bell-mère-san...Dialogue: 0,0:07:36.19,0:07:39.27,Main-207-,,0,0,0,,Bell-mère-san bizim için öldü!Dialogue: 0,0:07:39.27,0:07:40.11,Main-207-,,0,0,0,,Nasıl–Dialogue: 0,0:07:40.11,0:07:41.90,Main-207-,,0,0,0,,Bu kadar yeter, Nojiko.Dialogue: 0,0:07:42.57,0:07:43.86,Main-207-,,0,0,0,,Defol, Nami!Dialogue: 0,0:07:43.86,0:07:46.70,Main-207-,,0,0,0,,Bu köye bir daha adımını atma!Dialogue: 0,0:07:54.16,0:07:55.33,Main-207-,,0,0,0,,Nami!Dialogue: 0,0:07:59.92,0:08:01.84,Thoughts-207-,,0,0,0,,Nasıl bu kadar kör olabilir?Dialogue: 0,0:08:02.67,0:08:08.09,Thoughts-207-,,0,0,0,,Bell-mère'yi annesi olarak görmüyor muydu?!Dialogue: 0,0:08:18.39,0:08:19.73,Thoughts-207-,,0,0,0,,Öyle değil...Dialogue: 0,0:08:20.86,0:08:23.57,Thoughts-207-,,0,0,0,,Nami, Bell-mère-san'ı seviyordu.Dialogue: 0,0:08:30.82,0:08:31.87,Main-207-,,0,0,0,,Hey...Dialogue: 0,0:08:32.49,0:08:34.87,Main-207-,,0,0,0,,Bell-mère-san, eğer...Dialogue: 0,0:08:36.00,0:08:37.37,Main-207-,,0,0,0,,hayatta kalırsak...Dialogue: 0,0:08:37.91,0:08:40.75,Main-207-,,0,0,0,,bir gün güzel şeyler olacağını söylemedi mi?Dialogue: 0,0:08:41.33,0:08:43.09,Main-207-,,0,0,0,,Çok mutlu olacağımızı söyledi.Dialogue: 0,0:08:45.25,0:08:46.01,Main-207-,,0,0,0,,Evet.Dialogue: 0,0:08:46.55,0:08:48.97,Main-207-,,0,0,0,,Arlong beni götürdükten sonra,Dialogue: 0,0:08:48.97,0:08:51.89,Main-207-,,0,0,0,,beş Denizci gemisi onu yakalamaya geldi...Dialogue: 0,0:08:51.89,0:08:54.39,Main-207-,,0,0,0,,ama Arlong onları kolayca batırdı.Dialogue: 0,0:08:54.93,0:08:57.93,Main-207-,,0,0,0,,Daha fazla yardım göndereceklerini sanmıyorum.Dialogue: 0,0:08:57.93,0:09:01.27,Main-207-,,0,0,0,,Bu yüzden bir şey yapmam gerektiğine karar verdim.Dialogue: 0,0:09:02.35,0:09:04.02,Main-207-,,0,0,0,,Arlong ile anlaştım...Dialogue: 0,0:09:04.48,0:09:06.65,Main-207-,,0,0,0,,Cocoyashi Köyü'nü satın almak için.Dialogue: 0,0:09:06.65,0:09:08.40,Main-207-,,0,0,0,,Tüm köyü mü?Dialogue: 0,0:09:08.40,0:09:10.15,Main-207-,,0,0,0,,100 milyon beliye karşılık.Dialogue: 0,0:09:12.28,0:09:15.37,Main-207-,,0,0,0,,Eğer köyü alırsam, özgür olabiliriz.Dialogue: 0,0:09:15.37,0:09:17.91,Main-207-,,0,0,0,,Kimsenin ölmesine gerek kalmaz.Dialogue: 0,0:09:17.91,0:09:21.12,Main-207-,,0,0,0,,Karşılığında, onlara katılıp deniz haritaları çizeceğim.Dialogue: 0,0:09:21.12,0:09:23.63,Main-207-,,0,0,0,,Ama yüz milyon beli, ya?!Dialogue: 0,0:09:23.63,0:09:25.42,Main-207-,,0,0,0,,O kadar parayı bulmak imkan-Dialogue: 0,0:09:25.42,0:09:27.17,Main-207-,,0,0,0,,Bulacağım!Dialogue: 0,0:09:27.17,0:09:28.51,Main-207-,,0,0,0,,Ne olursa olsun!Dialogue: 0,0:09:28.96,0:09:33.22,Main-207-,,0,0,0,,Herkes haraçlarını toplamakla meşgulken, bunu yalnız yapmalıyım.Dialogue: 0,0:09:33.97,0:09:37.77,Main-207-,,0,0,0,,Eğer birinden yardım istersem, daha fazla kişi acı çeker.Dialogue: 0,0:09:44.11,0:09:45.61,Main-207-,,0,0,0,,Kolay olmayacak ama...Dialogue: 0,0:09:45.61,0:09:46.40,Main-207-,,0,0,0,,Biliyorum.Dialogue: 0,0:09:47.27,0:09:51.53,Main-207-,,0,0,0,,Bell-mère-san'ı öldürenlerle olmak canını yakacak.Dialogue: 0,0:09:52.11,0:09:53.53,Main-207-,,0,0,0,,İyi olacağım.Dialogue: 0,0:09:53.53,0:09:56.66,Main-207-,,0,0,0,,Onun yüzüne bakarken bile gülümseyeceğim!Dialogue: 0,0:09:56.66,0:09:58.58,Main-207-,,0,0,0,,Artık ağlamamaya karar verdim.Dialogue: 0,0:10:01.16,0:10:03.62,Main-207-,,0,0,0,,Bundan sonra tek başıma savaşacağım!Dialogue: 0,0:10:21.35,0:10:23.60,Main-207-,,0,0,0,,Henüz on yaşındaydı.Dialogue: 0,0:10:23.60,0:10:26.69,Main-207-,,0,0,0,,Kendi başına savaşıp hayatta kalmanın,Dialogue: 0,0:10:26.69,0:10:28.82,Main-207-,,0,0,0,,zorluğunu hayal edebiliyor musunuz?Dialogue: 0,0:10:29.65,0:10:33.36,Main-207-,,0,0,0,,Köyü uğruna o anlaşmayı yaptı...Dialogue: 0,0:10:33.36,0:10:34.11,Main-207-,,0,0,0,,O...Dialogue: 0,0:10:34.99,0:10:38.08,Main-207-,,0,0,0,,O piçlere Nami-san'ın acısını ödeteceği–Dialogue: 0,0:10:39.03,0:10:41.00,Main-207-,,0,0,0,,N-Neden, abla?Dialogue: 0,0:10:41.62,0:10:42.79,Main-207-,,0,0,0,,Size söyledim!Dialogue: 0,0:10:42.79,0:10:45.37,Main-207-,,0,0,0,,Bunları uzak durun diye anlattım!Dialogue: 0,0:10:45.37,0:10:47.75,Main-207-,,0,0,0,,Onun arkadaşı olduğunu söyleyip durursan,Dialogue: 0,0:10:47.75,0:10:49.50,Main-207-,,0,0,0,,Arlong şüpheye düşecek.Dialogue: 0,0:10:49.92,0:10:52.67,Main-207-,,0,0,0,,Sekiz yıllık çabasını hiç edeceksiniz.Dialogue: 0,0:10:53.38,0:10:55.55,Main-207-,,0,0,0,,Yeterince acı çekti.Dialogue: 0,0:10:56.34,0:10:59.31,Main-207-,,0,0,0,,Savaşı tek başına verirken,...Dialogue: 0,0:10:59.31,0:11:02.81,Main-207-,,0,0,0,,birilerinin sana arkadaş demesi en acı şeydir!Dialogue: 0,0:11:16.95,0:11:19.62,FlashbacksSecondary-207-,,0,0,0,,Buraya gel! Lanet velet!Dialogue: 0,0:11:19.62,0:11:22.12,FlashbacksSecondary-207-,,0,0,0,,Ne cüretle hazinemizi çalarsın?!Dialogue: 0,0:11:22.54,0:11:24.33,Flashbacks-207-,,0,0,0,,Korsanlardan çalmak mı?!Dialogue: 0,0:11:24.75,0:11:26.12,Flashbacks-207-,,0,0,0,,Evet!Dialogue: 0,0:11:26.12,0:11:29.59,Flashbacks-207-,,0,0,0,,Bu çağdaki korsanları kendi çıkarlarım uğruna kullanacağım!Dialogue: 0,0:11:29.92,0:11:31.88,Flashbacks-207-,,0,0,0,,Bunu hakediyorlar!Dialogue: 0,0:11:31.88,0:11:34.22,Flashbacks-207-,,0,0,0,,Ama her yerin haşat olmuş!Dialogue: 0,0:11:34.22,0:11:38.18,Flashbacks-207-,,0,0,0,,Evet. Biraz batırdım. Ama şuna bak! Bir milyon beli!Dialogue: 0,0:11:38.18,0:11:40.85,Flashbacks-207-,,0,0,0,,Kimin umurunda?! Hemen yaralarını tedavi etmeliyiz!Dialogue: 0,0:11:40.85,0:11:42.77,Flashbacks-207-,,0,0,0,,Ben iyiyim! Bu hiçbir şey!Dialogue: 0,0:11:43.64,0:11:46.10,Flashbacks-207-,,0,0,0,,Kimse burada bulamaz!Dialogue: 0,0:11:46.10,0:11:48.81,Flashbacks-207-,,0,0,0,,Paramı azar azar burada biriktireceğim,Dialogue: 0,0:11:48.81,0:11:51.32,Flashbacks-207-,,0,0,0,,ve dolduğunda 100 milyon beli olacak!Dialogue: 0,0:11:55.24,0:11:56.82,Flashbacks-207-,,0,0,0,,İşim çok...Dialogue: 0,0:11:58.32,0:12:00.03,Thoughts-207-,,0,0,0,,100 milyon beli.Dialogue: 0,0:12:02.66,0:12:06.62,Thoughts-207-,,0,0,0,,Çok uzun sürdü... ama sadece yedi milyon eksiğim kaldı.Dialogue: 0,0:12:06.62,0:12:09.83,Thoughts-207-,,0,0,0,,Bugünlerde, tek seferde o kadar para kazanabiliyorum!Dialogue: 0,0:12:10.54,0:12:11.75,Thoughts-207-,,0,0,0,,Sadece...Dialogue: 0,0:12:11.75,0:12:14.80,Thoughts-207-,,0,0,0,,bir yolculuk daha ve her şey bitecek.Dialogue: 0,0:12:15.67,0:12:20.89,Thoughts-207-,,0,0,0,,Cocoyashi Köyü ve ben, hepimiz Arlong’dan sonunda kurtulacağız!Dialogue: 0,0:12:20.89,0:12:22.51,Thoughts-207-,,0,0,0,,Sonra...Dialogue: 0,0:12:22.93,0:12:25.02,Thoughts-207-,,0,0,0,,Ve sonra, sanırım...Dialogue: 0,0:12:25.56,0:12:28.73,Thoughts-207-,,0,0,0,,içtenlikle gülümseyebileceğim.Dialogue: 0,0:12:31.65,0:12:33.27,Thoughts-207-,,0,0,0,,Bell-mère-san.Dialogue: 0,0:12:49.92,0:12:52.92,Main-207-,,0,0,0,,Denizciler'in Nami'yle ne işi var?Dialogue: 0,0:12:53.29,0:12:56.63,Main-207-,,0,0,0,,Sadece sessiz ol ve yolu göstermeye devam et.Dialogue: 0,0:12:59.30,0:13:03.18,Main-207-,,0,0,0,,Neden o yaşlı adamın kafasında rüzgar gülü var?Dialogue: 0,0:13:03.85,0:13:05.26,Main-207-,,0,0,0,,Çok havalı!Dialogue: 0,0:13:12.60,0:13:15.32,Main-207-,,0,0,0,,Son soygunuma girişeyim artık!Dialogue: 0,0:13:20.57,0:13:21.70,Main-207-,,0,0,0,,Gen-san?Dialogue: 0,0:13:21.70,0:13:23.20,Main-207-,,0,0,0,,Ve Denizciler mi?Dialogue: 0,0:13:27.91,0:13:30.41,Main-207-,,0,0,0,,Nami dedikleri hırsız sen misin?Dialogue: 0,0:13:32.37,0:13:37.34,Main-207-,,0,0,0,,Korsanlardan çalınan hazineyi burada sakladığına dair bir ihbar aldık.Dialogue: 0,0:13:38.34,0:13:43.72,Main-207-,,0,0,0,,Hükümet, çaldığın tüm mallara el koyuyor!Dialogue: 0,0:13:45.76,0:13:47.81,Main-207-,,0,0,0,,Seni uyarıyorum.Dialogue: 0,0:13:47.81,0:13:50.06,Main-207-,,0,0,0,,Arlong Korsanları'nda yetkili olduğumu bil.Dialogue: 0,0:13:50.06,0:13:53.15,Main-207-,,0,0,0,,Bana bulaşırsanız, Arlong'u başınıza bela edersiniz.Dialogue: 0,0:13:54.40,0:13:55.90,Main-207-,,0,0,0,,Zavallı kız.Dialogue: 0,0:13:55.90,0:13:59.65,Main-207-,,0,0,0,,Benimle denk olduğunu mu zannediyorsun?Dialogue: 0,0:13:59.65,0:14:01.20,Main-207-,,0,0,0,,Çalınan malları bulun!Dialogue: 0,0:14:03.20,0:14:04.11,Main-207-,,0,0,0,,Bekleyin!Dialogue: 0,0:14:09.62,0:14:12.12,Main-207-,,0,0,0,,Durun!Dialogue: 0,0:14:16.96,0:14:19.96,Main-207-,,0,0,0,,Şu an Denizciler'in yapması gereken şey bu mu?!Dialogue: 0,0:14:19.96,0:14:23.84,Main-207-,,0,0,0,,Arlong Korsanları insanları öldürdü ve şehirleri yok etti!Dialogue: 0,0:14:23.84,0:14:25.05,Main-207-,,0,0,0,,Bunu biliyorsunuz!Dialogue: 0,0:14:25.55,0:14:29.26,Main-207-,,0,0,0,,Bu adayı demir yumrukla yönetiyor, insanların hayatlarını çiğniyor!Dialogue: 0,0:14:29.26,0:14:31.06,Main-207-,,0,0,0,,Hükümet böyle mi çalışıyor?!Dialogue: 0,0:14:31.06,0:14:34.60,Main-207-,,0,0,0,,Küçük hırsızlarla uğraşırken bunları görmezden mi geliyorsunuz?!Dialogue: 0,0:14:36.19,0:14:38.36,Main-207-,,0,0,0,,Diline dikkat et.Dialogue: 0,0:14:38.36,0:14:39.53,Main-207-,,0,0,0,,Aramaya devam!Dialogue: 0,0:14:39.94,0:14:44.53,Main-207-,,0,0,0,,Bu ada halkı uzun zamandır sizden yardım bekliyordu!Dialogue: 0,0:14:44.91,0:14:48.03,Main-207-,,0,0,0,,Onları görmezden gelip nasıl buraya gelirsiniz?!Dialogue: 0,0:14:48.41,0:14:51.20,Main-207-,,0,0,0,,Albay! Bu mandalina bahçesi şüpheli görünüyor!Dialogue: 0,0:14:51.20,0:14:52.00,Main-207-,,0,0,0,,Kazın!Dialogue: 0,0:14:55.87,0:14:59.50,Main-207-,,0,0,0,,Pis ellerini Bell-mère-san’ın mandalina bahçesinden uzak tut!Dialogue: 0,0:15:02.46,0:15:04.22,Main-207-,,0,0,0,,Parayı alamayacaksınız!Dialogue: 0,0:15:04.22,0:15:06.47,Main-207-,,0,0,0,,O para benim... benim...Dialogue: 0,0:15:08.72,0:15:12.72,Main-207-,,0,0,0,,Onun parası Cocoyashi Köyü'nü kurtaracak!Dialogue: 0,0:15:12.72,0:15:16.94,Main-207-,,0,0,0,,Ondan alma hakkını sana kim veriyor, denizci?!Dialogue: 0,0:15:18.94,0:15:20.32,Main-207-,,0,0,0,,Öyle mi?Dialogue: 0,0:15:20.32,0:15:23.90,Main-207-,,0,0,0,,Cahil bir köy muhtarı, Denizci albayına karşı mı çıkıyor?Dialogue: 0,0:15:24.90,0:15:26.28,Main-207-,,0,0,0,,Gen-san...Dialogue: 0,0:15:26.28,0:15:28.24,Main-207-,,0,0,0,,Bunu nasıl biliyorsun?Dialogue: 0,0:15:32.12,0:15:34.08,Main-207-,,0,0,0,,Başından beri, Nami.Dialogue: 0,0:15:36.46,0:15:41.84,Main-207-,,0,0,0,,Yaptığın şeye inanmayınca Nojiko’yla konuştum.Dialogue: 0,0:15:41.84,0:15:44.26,Main-207-,,0,0,0,,O zamandan beri köydeki herkes,Dialogue: 0,0:15:44.26,0:15:48.80,Main-207-,,0,0,0,,köyü kurtarmak için Arlong Korsanları'na katıldığını biliyor.Dialogue: 0,0:15:49.18,0:15:52.18,Main-207-,,0,0,0,,Ama bilmiyormuş gibi davrandık.Dialogue: 0,0:15:52.18,0:15:55.06,Main-207-,,0,0,0,,Kararını değiştirirsen, umutlarımızın,Dialogue: 0,0:15:55.06,0:15:58.27,Main-207-,,0,0,0,,seni Arlong'tan kaçmaktan alıkoyacağını düşündük.Dialogue: 0,0:15:58.81,0:16:00.52,Main-207-,,0,0,0,,Ciddi olamazsınız.Dialogue: 0,0:16:02.98,0:16:05.90,Main-207-,,0,0,0,,Siz neden bahsediyorsunuz?Dialogue: 0,0:16:05.90,0:16:10.32,Main-207-,,0,0,0,,Yani tüm köylüleri hırsız ilan edip...Dialogue: 0,0:16:10.32,0:16:11.70,Main-207-,,0,0,0,,tutuklamamız mı gerekiyor?Dialogue: 0,0:16:11.70,0:16:16.29,Main-207-,,0,0,0,,Burada her birimizin yaşamak için mücadele verdiğini söylüyor!Dialogue: 0,0:16:16.71,0:16:20.67,Main-207-,,0,0,0,,Çünkü hiçbir hükümet çalışanına bel bağlamayacağız!Dialogue: 0,0:16:21.00,0:16:24.71,Main-207-,,0,0,0,,Eğer bu köyü kurtarmayacaksan, buradan defol git!Dialogue: 0,0:16:25.26,0:16:28.59,Main-207-,,0,0,0,,Etrafta dolanırsan Arlong senin gemini de batırır!Dialogue: 0,0:16:28.59,0:16:30.47,Main-207-,,0,0,0,,Arlong mu?Dialogue: 0,0:16:30.47,0:16:32.30,Main-207-,,0,0,0,,O kadar emin olma.Dialogue: 0,0:16:34.60,0:16:36.18,Main-207-,,0,0,0,,Hâlâ bulamadınız mı?!Dialogue: 0,0:16:36.18,0:16:39.48,Main-207-,,0,0,0,,100 milyon beli bu! Pirinç tanesi değil!Dialogue: 0,0:16:40.85,0:16:42.31,Main-207-,,0,0,0,,Sen, baksana!Dialogue: 0,0:16:42.31,0:16:43.94,Main-207-,,0,0,0,,Miktarı nasıl biliyorsun?!Dialogue: 0,0:16:45.78,0:16:47.95,Main-207-,,0,0,0,,Ah, 100 milyon mu?Dialogue: 0,0:16:47.95,0:16:51.32,Main-207-,,0,0,0,,Buna sadece bir önsezi diyelim.Dialogue: 0,0:17:02.21,0:17:03.42,Main-207-,,0,0,0,,Yoksa...Dialogue: 0,0:17:09.01,0:17:12.01,Main-207-,,0,0,0,,Yoksa seni Arlong mu gönderdi?!Dialogue: 0,0:17:13.51,0:17:15.39,Main-207-,,0,0,0,,Kim bilir?Dialogue: 0,0:17:15.39,0:17:21.56,Main-207-,,0,0,0,,Herhangi bir hükümet çalışanının yaptığı gibi hırsızlıkla uğraşıyoruz.Dialogue: 0,0:17:21.56,0:17:23.98,Main-207-,,0,0,0,,Çürümüş pislik!Dialogue: 0,0:17:23.98,0:17:26.94,Main-207-,,0,0,0,,Denizciler nasıl olur da korsanların uşağı olur?!Dialogue: 0,0:17:29.24,0:17:30.74,Thoughts-207-,,0,0,0,,Arlong!Dialogue: 0,0:17:31.11,0:17:32.49,Main-207-,,0,0,0,,Buldum!Dialogue: 0,0:17:40.79,0:17:42.75,Main-207-,,0,0,0,,İnanılmaz!Dialogue: 0,0:17:42.75,0:17:45.96,Main-207-,,0,0,0,,Senin gibi bir kızın bunları toplaması şaşırtıcı!Dialogue: 0,0:17:45.96,0:17:48.26,Main-207-,,0,0,0,,Hepsi yırtık pırtık ve kan içinde.Dialogue: 0,0:17:48.26,0:17:50.42,Main-207-,,0,0,0,,Ne olursa olsun! Para paradır!Dialogue: 0,0:17:53.55,0:17:56.35,Thoughts-207-,,0,0,0,,Bunların yüzde otuzu benim!Dialogue: 0,0:17:56.35,0:17:58.27,Main-207-,,0,0,0,,Dokunma.Dialogue: 0,0:17:58.77,0:18:02.02,Main-207-,,0,0,0,,Dokunma... Dokunma...Dialogue: 0,0:18:02.60,0:18:04.35,Main-207-,,0,0,0,,Nami...!Dialogue: 0,0:18:04.35,0:18:06.94,Main-207-,,0,0,0,,Dokunma...! Dokunma...!Dialogue: 0,0:18:06.94,0:18:08.57,Main-207-,,0,0,0,,Dokunma!Dialogue: 0,0:18:24.29,0:18:25.63,Main-207-,,0,0,0,,Nami...!Dialogue: 0,0:18:31.13,0:18:31.76,Main-207-,,0,0,0,,Nojiko?!Dialogue: 0,0:18:32.67,0:18:33.97,Main-207-,,0,0,0,,Nojiko!Dialogue: 0,0:18:39.35,0:18:41.81,Main-207-,,0,0,0,,Doktor! Doktor!Dialogue: 0,0:18:42.81,0:18:44.69,Main-207-,,0,0,0,,Ne oldu, Gen-san?!Dialogue: 0,0:18:44.69,0:18:46.10,Main-207-,,0,0,0,,– Nojiko vuruldu!Dialogue: 0,0:18:46.10,0:18:47.31,Main-207-,,0,0,0,,Kim vurdu?!Dialogue: 0,0:18:47.31,0:18:48.44,Main-207-,,0,0,0,,Denizciler!Dialogue: 0,0:18:48.44,0:18:49.27,Main-207-,,0,0,0,,Denizciler mi?Dialogue: 0,0:18:54.61,0:18:55.57,Main-207-,,0,0,0,,Nami...Dialogue: 0,0:18:56.16,0:18:57.91,Main-207-,,0,0,0,,Hey, Nami!Dialogue: 0,0:18:57.91,0:19:00.24,Main-207-,,0,0,0,,Naber? Yardıma ihtiyacın var mı?Dialogue: 0,0:19:02.58,0:19:04.00,Main-207-,,0,0,0,,Hâlâ burada mısın?!Dialogue: 0,0:19:05.00,0:19:08.75,Main-207-,,0,0,0,,Bu seni ilgilendirmez! Çabuk defol bu adadan!Dialogue: 0,0:19:15.68,0:19:17.22,Thoughts-207-,,0,0,0,,Arlong!Dialogue: 0,0:19:17.22,0:19:20.14,Flashbacks-207-,,0,0,0,,Köyünü kurtarmayı bu kadar çok mu istiyorsun?Dialogue: 0,0:19:20.51,0:19:22.18,Thoughts-207-,,0,0,0,,Arlong!Dialogue: 0,0:19:22.18,0:19:25.19,Flashbacks-207-,,0,0,0,,100 milyon beli toplayıp bana getir.Dialogue: 0,0:19:25.19,0:19:28.98,Flashbacks-207-,,0,0,0,,Eğer bunu yaparsan, seni ve köyü bırakırım.Dialogue: 0,0:19:29.40,0:19:30.73,Thoughts-207-,,0,0,0,,Arlong!Dialogue: 0,0:19:30.73,0:19:34.99,Flashbacks-207-,,0,0,0,,Para konusunda sözümü çiğnemektense ölürüm.Dialogue: 0,0:19:34.99,0:19:37.11,Flashbacks-207-,,0,0,0,,Kaç yıl sürdüğü önemli değil.Dialogue: 0,0:19:37.11,0:19:38.78,Flashbacks-207-,,0,0,0,,Anlaşmamıza saygı duyacağım.Dialogue: 0,0:19:39.62,0:19:41.12,Main-207-,,0,0,0,,Arlong!Dialogue: 0,0:19:45.75,0:19:47.71,Main-207-,,0,0,0,,Onun sorunu ne?Dialogue: 0,0:19:49.84,0:19:51.38,Main-207-,,0,0,0,,Arlong!Dialogue: 0,0:19:53.42,0:19:54.42,Main-207-,,0,0,0,,Ya?Dialogue: 0,0:19:54.42,0:19:58.01,Main-207-,,0,0,0,,Sorun ne, yetenekli haritacımız?Dialogue: 0,0:19:58.01,0:20:00.26,Main-207-,,0,0,0,,Bu çatık kaşlar da ne?Dialogue: 0,0:20:00.85,0:20:04.77,Main-207-,,0,0,0,,Emrindeki denizciler tüm paramı çaldı!Dialogue: 0,0:20:05.52,0:20:09.77,Main-207-,,0,0,0,,Para konusunda sözünü çiğnemektense ölmeyi yeğlersin sanırdım!Dialogue: 0,0:20:09.77,0:20:11.27,Main-207-,,0,0,0,,Neden?!Dialogue: 0,0:20:11.27,0:20:13.48,Main-207-,,0,0,0,,Ne zaman sözümü bozdum?Dialogue: 0,0:20:13.90,0:20:16.32,Main-207-,,0,0,0,,Aptalı oynama! Senin şu denizciler–Dialogue: 0,0:20:18.53,0:20:21.16,Main-207-,,0,0,0,,Dediğim gibi, sözümüzü ne zaman bozdum?Dialogue: 0,0:20:21.16,0:20:22.20,Main-207-,,0,0,0,,Söyle!Dialogue: 0,0:20:30.29,0:20:32.17,Thoughts-207-,,0,0,0,,Lanet olsun sana.Dialogue: 0,0:20:32.17,0:20:34.25,Thoughts-207-,,0,0,0,,Lanet olsun! Lanet olsun!Dialogue: 0,0:20:36.21,0:20:37.34,Main-207-,,0,0,0,,Anladım!Dialogue: 0,0:20:37.34,0:20:39.18,Main-207-,,0,0,0,,Yani paran çalındı?Dialogue: 0,0:20:39.18,0:20:41.72,Main-207-,,0,0,0,,Çok yazık.Dialogue: 0,0:20:41.72,0:20:44.06,Main-207-,,0,0,0,,Ama anlaşma anlaşmadır.Dialogue: 0,0:20:44.06,0:20:47.06,Main-207-,,0,0,0,,Bana 100 milyon beli getiremezsen,Dialogue: 0,0:20:47.06,0:20:51.23,Main-207-,,0,0,0,,korkarım sana köyü geri veremem.Dialogue: 0,0:20:52.65,0:20:53.69,Main-207-,,0,0,0,,Seni pislik!Dialogue: 0,0:20:56.78,0:20:58.95,Main-207-,,0,0,0,,Altı üstü 100 milyon beli!Dialogue: 0,0:20:58.95,0:21:01.66,Main-207-,,0,0,0,,Tekrar biriktirirsin!Dialogue: 0,0:21:04.70,0:21:07.50,Main-207-,,0,0,0,,Yoksa benden kaçacak mısın?Dialogue: 0,0:21:08.96,0:21:13.92,Main-207-,,0,0,0,,Ama benden kaçarsan, Cocoyashi Köyü'ndeki herkesi öldürürüm.Dialogue: 0,0:21:17.67,0:21:18.92,Flashbacks-207-,,0,0,0,,Nami...Dialogue: 0,0:21:18.92,0:21:21.68,Flashbacks-207-,,0,0,0,,Bilmiyormuş gibi davrandık.Dialogue: 0,0:21:21.68,0:21:24.93,Flashbacks-207-,,0,0,0,,Kararını değiştirirsen, umutlarımızın,Dialogue: 0,0:21:24.93,0:21:28.73,Flashbacks-207-,,0,0,0,,seni Arlong'tan kaçmaktan alıkoyacağını düşündük.Dialogue: 0,0:21:33.65,0:21:34.65,Main-207-,,0,0,0,,Vay...Dialogue: 0,0:21:34.65,0:21:36.78,Main-207-,,0,0,0,,Sonunda kaçıyorsun, ha?Dialogue: 0,0:21:39.86,0:21:41.70,Main-207-,,0,0,0,,Peşinden gidelim mi?Dialogue: 0,0:21:41.70,0:21:43.82,Main-207-,,0,0,0,,Peşinden mi? Ne için?Dialogue: 0,0:21:44.32,0:21:46.83,Main-207-,,0,0,0,,Kaçmasının imkanı yok.Dialogue: 0,0:21:46.83,0:21:51.33,Main-207-,,0,0,0,,Köylülerin hayatlarını asla terk etmez.Dialogue: 0,0:21:52.33,0:21:55.21,Main-207-,,0,0,0,,Kirli oyunları ustalıkla oynuyorsun.Dialogue: 0,0:21:55.21,0:21:59.42,Main-207-,,0,0,0,,Nami gibi mükemmel bir haritacının kolayca gitmesine izin vermem.Dialogue: 0,0:21:59.42,0:22:02.68,Main-207-,,0,0,0,,Ama kalpsiz bir şeytan da değilim.Dialogue: 0,0:22:04.18,0:22:07.26,Main-207-,,0,0,0,,Dünyadaki bütün denizlerin haritasını çıkardığında,Dialogue: 0,0:22:07.26,0:22:09.27,Main-207-,,0,0,0,,ona istediği özgürlüğü vereceğim!Dialogue: 0,0:22:11.77,0:22:15.40,Main-207-,,0,0,0,,Bu onlarca yıl sürer!Dialogue: 0,0:22:15.40,0:22:18.19,Main-207-,,0,0,0,,Yüzlerce yıl bile yetmez!Dialogue: 0,0:22:26.91,0:22:28.74,Main-207-,,0,0,0,,Yetti artık! Silahlanın!Dialogue: 0,0:22:28.74,0:22:29.83,Main-207-,,0,0,0,,Savaşacağız!Dialogue: 0,0:22:34.25,0:22:38.75,Thoughts-207-,,0,0,0,,Gen-san ! Millet!  Lütfen! Acele etmeyin!Dialogue: 0,0:22:38.75,0:22:41.42,Thoughts-207-,,0,0,0,,Ölemezsiniz! Her şey biter!Dialogue: 0,0:22:42.01,0:22:45.14,Thoughts-207-,,0,0,0,,Hayatta kalmalısınız, yoksa her şey boşa gider!Dialogue: 0,0:22:45.14,0:22:47.18,Main-207-,,0,0,0,,Sekiz yıl önce...Dialogue: 0,0:22:47.51,0:22:50.68,Main-207-,,0,0,0,,hayatlarımızı bir kenara atmamaya söz verdik!Dialogue: 0,0:22:50.68,0:22:53.18,Main-207-,,0,0,0,,Kuralları ne kadar aşağılayıcı olsa da,Dialogue: 0,0:22:53.85,0:22:58.65,Main-207-,,0,0,0,,Nami güldüğü sürece sabırla katlanacağımıza yemin ettik!Dialogue: 0,0:22:58.65,0:23:01.36,Main-207-,,0,0,0,,Ama onlar yüzümüze tükürdü!Dialogue: 0,0:23:01.74,0:23:06.32,Main-207-,,0,0,0,,Artık köyümüzün özgürlük şansı kalmadı, umutlar tükendi!Dialogue: 0,0:23:06.32,0:23:07.24,Main-207-,,0,0,0,,Dahası,Dialogue: 0,0:23:07.78,0:23:12.20,Main-207-,,0,0,0,,o kızın kalbini kırmalarının bedelini, balıkadamlara ödetmeliyiz!Dialogue: 0,0:23:12.20,0:23:13.00,Main-207-,,0,0,0,,İtirazı olan?!Dialogue: 0,0:23:13.66,0:23:15.25,Main-207-,,0,0,0,,Elbette yok! Hadi gidelim!Dialogue: 0,0:23:15.25,0:23:19.04,Main-207-,,0,0,0,,Biz her zaman savaşmak için hazırdık!Dialogue: 0,0:23:19.46,0:23:22.17,Main-207-,,0,0,0,,Bir gün daha onların kölesi olursam kahrolurum!Dialogue: 0,0:23:24.13,0:23:26.22,Main-207-,,0,0,0,,Millet, bekleyin!Dialogue: 0,0:23:27.76,0:23:29.05,Main-207-,,0,0,0,,Nami!Dialogue: 0,0:23:32.35,0:23:33.85,Main-207-,,0,0,0,,Biraz daha!Dialogue: 0,0:23:33.85,0:23:35.48,Main-207-,,0,0,0,,Az daha sabredin!Dialogue: 0,0:23:35.48,0:23:37.73,Main-207-,,0,0,0,,Çok çalışmaya devam edeceğim!Dialogue: 0,0:23:37.73,0:23:39.77,Main-207-,,0,0,0,,Parayı yine biriktiririm!Dialogue: 0,0:23:40.27,0:23:41.90,Main-207-,,0,0,0,,Bu kez kolay olacak!Dialogue: 0,0:23:41.90,0:23:46.15,Main-207-,,0,0,0,,Artık alıştım! İyi olacağım! Endişelenmenize gerek yok!Dialogue: 0,0:23:47.07,0:23:49.57,Main-207-,,0,0,0,,Eskisiyle kıyaslanamaz bile!Dialogue: 0,0:23:51.83,0:23:53.79,Flashbacks-207-,,0,0,0,,Başka ölüm istemiyorum!Dialogue: 0,0:23:54.20,0:23:55.41,Main-207-,,0,0,0,,Millet!Dialogue: 0,0:23:55.41,0:23:58.04,Main-207-,,0,0,0,,Ben cidden iyiyim! Çok daha iyi olacağım!Dialogue: 0,0:24:03.96,0:24:05.59,Main-207-,,0,0,0,,Bu kadar yeter.Dialogue: 0,0:24:05.59,0:24:07.68,Main-207-,,0,0,0,,Sen bile bittiğini anlamalısın.Dialogue: 0,0:24:08.55,0:24:13.01,Main-207-,,0,0,0,,Bunca zaman bizim hayatımızı sırtlayarak iyi mücadele ettin.Dialogue: 0,0:24:13.01,0:24:16.39,Main-207-,,0,0,0,,Onlara katılmak, senin için kalbini parçalamaktan,Dialogue: 0,0:24:16.39,0:24:18.98,Main-207-,,0,0,0,,daha acı verici olmalı.Dialogue: 0,0:24:19.98,0:24:22.36,Main-207-,,0,0,0,,Çok iyi iş çıkardın.Dialogue: 0,0:24:23.86,0:24:25.15,Main-207-,,0,0,0,,Gen-san.Dialogue: 0,0:24:31.28,0:24:33.41,Main-207-,,0,0,0,,Şimdi köyü terk et.Dialogue: 0,0:24:35.08,0:24:35.83,Main-207-,,0,0,0,,Gen-san?!Dialogue: 0,0:24:36.87,0:24:38.33,Main-207-,,0,0,0,,Git, Nami.Dialogue: 0,0:24:38.33,0:24:39.71,Main-207-,,0,0,0,,N-Ne?!Dialogue: 0,0:24:40.46,0:24:41.46,Main-207-,,0,0,0,,Nacchan.Dialogue: 0,0:24:41.46,0:24:42.54,Main-207-,,0,0,0,,Nami...Dialogue: 0,0:24:43.67,0:24:46.92,Main-207-,,0,0,0,,Beceriklisin ve bir hayalin var.Dialogue: 0,0:24:46.92,0:24:48.68,Main-207-,,0,0,0,,Nojiko! Millet!Dialogue: 0,0:24:50.18,0:24:51.51,Main-207-,,0,0,0,,Gitmenize izin vermem!Dialogue: 0,0:24:52.68,0:24:54.18,Main-207-,,0,0,0,,Hepiniz durun!Dialogue: 0,0:24:54.18,0:24:57.06,Main-207-,,0,0,0,,Başka kimsenin incinmesini izleyemem!Dialogue: 0,0:24:59.69,0:25:00.81,Main-207-,,0,0,0,,Sizi öldürürler!Dialogue: 0,0:25:01.81,0:25:03.15,Main-207-,,0,0,0,,Biliyoruz.Dialogue: 0,0:25:08.99,0:25:12.32,Main-207-,,0,0,0,,Bu işe yaramaz! Kararımızı verdik!Dialogue: 0,0:25:16.04,0:25:17.62,Main-207-,,0,0,0,,Yolumuzdan çekil, Nami!Dialogue: 0,0:25:19.62,0:25:21.17,Main-207-,,0,0,0,,Gidelim, millet!Dialogue: 0,0:25:21.17,0:25:24.46,Main-207-,,0,0,0,,Kazanamasak bile, onlara cehennemi yaşatacağız!Dialogue: 0,0:26:00.58,0:26:03.00,Main-207-,,0,0,0,,Arlong...!Dialogue: 0,0:26:04.71,0:26:07.34,Main-207-,,0,0,0,,Arlong! Arlong!Dialogue: 0,0:26:09.59,0:26:10.34,Main-207-,,0,0,0,,Arlong!Dialogue: 0,0:26:10.34,0:26:14.89,Main-207-,,0,0,0,,Arlong! Arlong! Arlong! Arlong!Dialogue: 0,0:26:14.89,0:26:15.47,Main-207-,,0,0,0,,Ar–Dialogue: 0,0:26:21.10,0:26:22.44,Main-207-,,0,0,0,,Luffy...Dialogue: 0,0:26:26.19,0:26:27.65,Main-207-,,0,0,0,,Ne istiyorsun?Dialogue: 0,0:26:27.65,0:26:29.78,Main-207-,,0,0,0,,Hiçbir şey bilmiyorsun!Dialogue: 0,0:26:29.78,0:26:33.57,Main-207-,,0,0,0,,Burada geçen sekiz yılda neler olduğunu hiç bilmiyorsun!Dialogue: 0,0:26:33.57,0:26:35.32,Main-207-,,0,0,0,,Evet, bilmiyorum.Dialogue: 0,0:26:36.12,0:26:37.70,Main-207-,,0,0,0,,Seni ilgilendirmiyor!Dialogue: 0,0:26:38.54,0:26:41.16,Main-207-,,0,0,0,,Sana defolmanı söylemiştim!Dialogue: 0,0:26:41.16,0:26:43.16,Main-207-,,0,0,0,,Evet, söylemiştin.Dialogue: 0,0:26:43.16,0:26:44.42,Main-207-,,0,0,0,,O zaman, defol!Dialogue: 0,0:26:44.42,0:26:45.79,Main-207-,,0,0,0,,Sana ihtiyacım yok!Dialogue: 0,0:26:45.79,0:26:48.13,Main-207-,,0,0,0,,Kaybol! Git! Defol!Dialogue: 0,0:26:48.13,0:26:49.38,Main-207-,,0,0,0,,Git buradan!Dialogue: 0,0:26:49.38,0:26:52.88,Main-207-,,0,0,0,,Çek git! Buradan defol! Hadi!Dialogue: 0,0:26:52.88,0:26:54.43,Main-207-,,0,0,0,,Git...!Dialogue: 0,0:27:07.81,0:27:08.98,Main-207-,,0,0,0,,Luffy...Dialogue: 0,0:27:10.48,0:27:11.86,Main-207-,,0,0,0,,Yardım et...Dialogue: 0,0:27:24.12,0:27:26.67,Main-207-,,0,0,0,,Elbette ederim!Dialogue: 0,0:27:29.54,0:27:31.71,Flashbacks-207-,,0,0,0,,Hazineme dokunma!Dialogue: 0,0:27:33.88,0:27:35.22,Main-207-,,0,0,0,,Luffy...Dialogue: 0,0:27:41.68,0:27:42.39,Main-207-,,0,0,0,,Gidelim.Dialogue: 0,0:27:44.18,0:27:45.14,Main-207-,,0,0,0,,Anlaşıldı!Dialogue: 0,0:27:44.18,0:27:45.14,Main-207-,,0,0,0,,Anlaşıldı!Dialogue: 0,0:27:44.18,0:27:45.14,Main-207-,,0,0,0,,Anlaşıldı!Dialogue: 0,0:27:49.52,0:27:50.57,Main-207-,,0,0,0,,Hey!Dialogue: 0,0:27:50.57,0:27:52.36,Main-207-,,0,0,0,,Siz iyi misiniz?!Dialogue: 0,0:27:52.36,0:27:54.32,Main-207-,,0,0,0,,Bunu size Arlong mu yaptı?!Dialogue: 0,0:27:55.86,0:27:57.07,Main-207-,,0,0,0,,Kenara çekilin.Dialogue: 0,0:27:57.95,0:28:00.58,Main-207-,,0,0,0,,Balıkadamlarla görülecek bir işimiz var.Dialogue: 0,0:28:01.33,0:28:03.83,Main-207-,,0,0,0,,Nami ablayla ilgili gerçeği öğrenip...Dialogue: 0,0:28:03.83,0:28:07.83,Main-207-,,0,0,0,,yapabileceğimiz tek şeyin Arlong'u yenmek olduğunu düşündük.Dialogue: 0,0:28:07.83,0:28:10.34,Main-207-,,0,0,0,,O yüzden ona meydan okuduk.Dialogue: 0,0:28:10.34,0:28:12.96,Main-207-,,0,0,0,,Ama kıl payı kaybettik.Dialogue: 0,0:28:14.80,0:28:19.05,Main-207-,,0,0,0,,Üzgünüz ama geçmeniz yasak! Hiç şansınız yok!Dialogue: 0,0:28:19.05,0:28:20.01,Main-207-,,0,0,0,,Ne?!Dialogue: 0,0:28:20.35,0:28:24.43,Main-207-,,0,0,0,,Şey, beklediğimiz bir tayfa var da!Dialogue: 0,0:28:25.06,0:28:26.52,Main-207-,,0,0,0,,Tayfa mı?Dialogue: 0,0:28:26.98,0:28:28.60,Main-207-,,0,0,0,,Hayatımı ortaya koyarım.Dialogue: 0,0:28:29.10,0:28:31.61,Main-207-,,0,0,0,,Gelecekler!Dialogue: 0,0:28:46.70,0:28:47.46,Main-207-,,0,0,0,,– İşte! – İşte!Dialogue: 0,0:29:03.47,0:29:04.56,Main-207-,,0,0,0,,Onlar mı?Dialogue: 0,0:29:04.56,0:29:07.60,Main-207-,,0,0,0,,Onlar da kim?Dialogue: 0,0:29:08.06,0:29:10.69,Main-207-,,0,0,0,,Bu adanın tek umudu.Dialogue: 0,0:29:10.69,0:29:15.53,Main-207-,,0,0,0,,Eğer onlar başaramazsa, bu ada, hatta tüm Doğu Mavi bitti demektir!Dialogue: 0,0:29:16.23,0:29:19.61,Main-207-,,0,0,0,,O dört adam kaderimizi değiştirmek için buradalar.Dialogue: 0,0:29:19.61,0:29:23.12,Main-207-,,0,0,0,,Yüzlerini zihninize kazıyın!Dialogue: 0,0:29:32.04,0:29:33.17,Main-207-,,0,0,0,,Kenara çekilin.Dialogue: 0,0:29:40.22,0:29:45.05,Main-207-,,0,0,0,,Sizce o iki palyaço Zoro'nun arkadaşları mıydı?Dialogue: 0,0:29:45.43,0:29:48.18,Main-207-,,0,0,0,,Zoro'nun mu? Onun için çok güçsüzlerdi.Dialogue: 0,0:29:48.18,0:29:49.85,Main-207-,,0,0,0,,Öldürmeye bile değmezler.Dialogue: 0,0:29:49.85,0:29:51.64,Main-207-,,0,0,0,,İyi dedin!Dialogue: 0,0:30:05.20,0:30:06.53,Main-207-,,0,0,0,,Ne oluyor?!Dialogue: 0,0:30:09.25,0:30:11.37,Main-207-,,0,0,0,,Hanginiz Arlong?Dialogue: 0,0:02:37.51,0:02:43.64,Title-207-,,0,0,0,,Yaşamak İçinDialogue: 1,0:02:37.51,0:02:43.64,Title-207-,,0,0,0,,Yaşamak İçinDialogue: 0,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 1,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 0,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Gigglebot ZenefDialogue: 1,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Gigglebot ZenefDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,MüzikDialogue: 1,0:00:04.28,0:00:06.78,Cred