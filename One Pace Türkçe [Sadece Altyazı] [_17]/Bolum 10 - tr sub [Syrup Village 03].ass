8,23,23,23,1Style: Lyrics-furigana,Duality,36,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,2.95,0,2,23,23,34,1Style: Lyrics,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,2,23,23,34,1Style: Karaoke,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,23,1Style: Kanji,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,146,1Style: Roger-Monologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1Style: Romaji ED,Josefin Sans,82,&H00FFFFFF,&H003592BE,&H00000000,&H64000000,0,0,0,0,100,100,0,0,1,0,4,8,10,10,20,1Style: Translation ED,Josefin Sans,82,&H00FFFFFF,&H000000FF,&H00FFFFFF,&H64000000,0,0,0,0,100,100,0,0,1,0,4,2,10,10,20,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:50.01,0:02:00.00,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 50,0:01:53.34,0:01:53.97,Main-207-,,0,0,0,,Dinleyin.Dialogue: 50,0:01:54.51,0:01:57.85,Main-207-,,0,0,0,,Şafakta bu kıyıdan saldıracaklarını...Dialogue: 50,0:01:58.81,0:02:03.35,Main-207-,,0,0,0,,ve köye giden tek yolun bu yokuş olduğunu biliyoruz.Dialogue: 50,0:02:03.35,0:02:06.94,Main-207-,,0,0,0,,Geri kalan her yer uçurum gibi.Dialogue: 50,0:02:06.94,0:02:10.36,Main-207-,,0,0,0,,Diğer bir deyişle, bu yokuşu sıkı bir şekilde tutarsak...Dialogue: 50,0:02:10.36,0:02:12.74,Main-207-,,0,0,0,,köy saldırıya uğramayacak!Dialogue: 50,0:02:12.74,0:02:14.78,Main-207-,,0,0,0,,Anladım! Çocuk oyuncağı!Dialogue: 50,0:02:14.78,0:02:17.95,Main-207-,,0,0,0,,Söylemesi kolay, gerisi gücümüze bağlı!Dialogue: 50,0:02:17.95,0:02:19.37,Main-207-,,0,0,0,,Siz ne yapabilirsiniz?Dialogue: 50,0:02:19.37,0:02:20.24,Main-207-,,0,0,0,,Keserim.Dialogue: 50,0:02:20.24,0:02:21.16,Main-207-,,0,0,0,,Uzarım.Dialogue: 50,0:02:21.16,0:02:22.29,Main-207-,,0,0,0,,Çalarım.Dialogue: 50,0:02:22.46,0:02:23.50,Main-207-,,0,0,0,,Ben de saklanırım.Dialogue: 50,0:02:23.50,0:02:25.38,Main-207-,,0,0,0,,– Sen de dövüşeceksin! – Sen de dövüşeceksin!Dialogue: 50,0:02:25.88,0:02:28.67,Main-207-,,0,0,0,,Şaka yaptım! Aman be!Dialogue: 50,0:02:30.46,0:02:32.22,Main-207-,,0,0,0,,Oh, Klahadore-san!Dialogue: 50,0:02:32.22,0:02:33.34,Main-207-,,0,0,0,,Hoş geldiniz!Dialogue: 50,0:02:33.34,0:02:34.63,Main-207-,,0,0,0,,Hanımefendi nerede?Dialogue: 50,0:02:34.63,0:02:36.18,Main-207-,,0,0,0,,Dinleniyor.Dialogue: 50,0:02:36.18,0:02:38.72,Main-207-,,0,0,0,,Bütün bu olanlar onu çok yıprattı...Dialogue: 50,0:02:39.47,0:02:43.89,Main-207-,,0,0,0,,Yine de, ben yokken böyle bir şeyin olacağını hiç düşünmemiştim.Dialogue: 50,0:02:44.52,0:02:47.52,Main-207-,,0,0,0,,Usopp adındaki genç, gerçekten baş belası.Dialogue: 50,0:02:47.52,0:02:48.73,Main-207-,,0,0,0,,Hatta...Dialogue: 50,0:02:48.73,0:02:52.61,Main-207-,,0,0,0,,Senin korsan olduğunu bile söyledi...Dialogue: 50,0:02:53.07,0:02:55.03,Main-207-,,0,0,0,,Gördüğüm en kötü yalan!Dialogue: 50,0:02:59.49,0:03:01.74,Main-207-,,0,0,0,,Demek öyle...?Dialogue: 50,0:03:04.16,0:03:05.54,Main-207-,,0,0,0,,Bu ne?Dialogue: 50,0:03:05.54,0:03:09.04,Main-207-,,0,0,0,,Oh, sana hanımefendiden bir hediye.Dialogue: 50,0:03:09.75,0:03:13.59,Main-207-,,0,0,0,,Bu malikânenin bir parçası olduğundan beri 3 yıl geçti.Dialogue: 50,0:03:13.59,0:03:15.80,Main-207-,,0,0,0,,Bir yıl dönümü hediyesi.Dialogue: 50,0:03:15.80,0:03:17.43,Main-207-,,0,0,0,,Yıl dönümü...Dialogue: 50,0:03:17.43,0:03:20.93,Main-207-,,0,0,0,,Gözlüklerin sürekli kaydığı için...Dialogue: 50,0:03:20.93,0:03:23.43,Main-207-,,0,0,0,,hanımefendi sana özel sipariş verdi!Dialogue: 50,0:03:23.43,0:03:26.69,Main-207-,,0,0,0,,O kadar hoş, düşünceli bir insan ki!Dialogue: 50,0:03:29.56,0:03:31.48,Main-207-,,0,0,0,,Yıl dönümünden bahsetmişken...Dialogue: 50,0:03:31.48,0:03:34.44,Main-207-,,0,0,0,,Yarın unutulmayacak kadar özel bir gün olacak.Dialogue: 50,0:03:35.11,0:03:35.82,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:03:40.28,0:03:43.37,Main-207-,,0,0,0,,Bu gece ay, hilal şeklinde.Dialogue: 50,0:03:43.37,0:03:44.70,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:03:44.70,0:03:49.38,Main-207-,,0,0,0,,Böyle bir gece, kalbimin daha hızlı çarpmasına ve...Dialogue: 50,0:03:49.38,0:03:52.63,Main-207-,,0,0,0,,kanımın heyecandan kaynamasına neden oluyor.Dialogue: 50,0:03:55.01,0:03:57.01,Main-207-,,0,0,0,,K-Klahadore-san!Dialogue: 50,0:03:57.01,0:04:00.51,Main-207-,,0,0,0,,Hanımefendinin hediyesini neden kırdın?!Dialogue: 50,0:04:01.26,0:04:03.72,Main-207-,,0,0,0,,Hediye ha? Kabul ettim, gitti.Dialogue: 50,0:04:04.31,0:04:06.60,Main-207-,,0,0,0,,Ama sadece hediyeyi değil,Dialogue: 50,0:04:06.60,0:04:08.69,Main-207-,,0,0,0,,bu malikânenin tamamını!Dialogue: 50,0:04:09.77,0:04:12.02,Main-207-,,0,0,0,,N-Neden bahsediyorsunuz?Dialogue: 50,0:04:12.02,0:04:14.94,Main-207-,,0,0,0,,Bu rolü daha fazla sürdürmeme gerek yok.Dialogue: 50,0:04:15.61,0:04:19.95,Main-207-,,0,0,0,,Birkaç saat içinde, beklenmedik bir kaza meydana gelecek.Dialogue: 50,0:04:24.62,0:04:27.54,Main-207-,,0,0,0,,Bu 3 yıl fazlasıyla uzundu!Dialogue: 50,0:04:27.54,0:04:29.42,Main-207-,,0,0,0,,Hanımefendi! Kaçın!Dialogue: 50,0:04:48.02,0:04:50.02,Main-207-,,0,0,0,,Kaptan Jango!Dialogue: 50,0:04:51.35,0:04:54.77,Main-207-,,0,0,0,,Neredeyse şafak söktü. Lütfen uyanın, Kaptan Jango!Dialogue: 50,0:04:56.73,0:04:58.36,Main-207-,,0,0,0,,Günaydın, Kaptan!Dialogue: 50,0:04:58.36,0:04:59.20,Main-207-,,0,0,0,,Günaydın!Dialogue: 50,0:05:00.82,0:05:02.07,Main-207-,,0,0,0,,Sizi aptalllar!Dialogue: 50,0:05:02.07,0:05:06.16,Main-207-,,0,0,0,,"Günaydın" kelimesi benim kitabımda sadece sabahları söylenmeli!Dialogue: 50,0:05:06.54,0:05:08.04,Main-207-,,0,0,0,,Morali bozuk gibi.Dialogue: 50,0:05:08.04,0:05:09.66,Main-207-,,0,0,0,,Yeni uyandı be...Dialogue: 50,0:05:10.00,0:05:11.58,Main-207-,,0,0,0,,Bakın!Dialogue: 50,0:05:11.58,0:05:14.21,Main-207-,,0,0,0,,Ay hâlâ gökyüzünde ve gece yarısı.Dialogue: 50,0:05:14.21,0:05:16.21,Main-207-,,0,0,0,,Nasıl bağırırsınız?!Dialogue: 50,0:05:16.21,0:05:18.51,Main-207-,,0,0,0,,– Hatalıydık! Üzgünüz, efendim! – Hatalıydık! Üzgünüz, efendim!Dialogue: 50,0:05:23.09,0:05:24.72,Main-207-,,0,0,0,,Sorun değil, günaydın!Dialogue: 50,0:05:24.72,0:05:27.93,Main-207-,,0,0,0,,Günaydın mı? Galiba ağzından çıkanı kulağı duymuyor.Dialogue: 50,0:05:27.93,0:05:31.89,Main-207-,,0,0,0,,Sersem! Sadece morali düzeldi, hepsi bu!Dialogue: 50,0:05:32.10,0:05:32.98,Main-207-,,0,0,0,,Yoldaşlar!Dialogue: 50,0:05:34.52,0:05:35.52,Main-207-,,0,0,0,,Yelkenler fora!Dialogue: 50,0:05:35.52,0:05:37.23,Main-207-,,0,0,8,,– Başüstüne! – Başüstüne!Dialogue: 50,0:05:42.24,0:05:43.95,Main-207-,,0,0,0,,Tamam! Mükemmel!Dialogue: 50,0:05:44.70,0:05:48.12,Main-207-,,0,0,0,,Artık bu yokuşu tırmanamayacaklar.Dialogue: 50,0:05:48.12,0:05:51.41,Main-207-,,0,0,0,,Her yeri kaplayan yağ işimizi görecek.Dialogue: 50,0:05:51.79,0:05:57.38,Main-207-,,0,0,0,,Onlar kayıp düşerken biz saldıracağız!Dialogue: 50,0:05:57.71,0:05:59.71,Main-207-,,0,0,0,,Yağ, ha...?Dialogue: 50,0:05:59.71,0:06:02.93,Main-207-,,0,0,0,,Ne pahasına olursa olsun bu yokuşu savunacağız!Dialogue: 50,0:06:02.93,0:06:06.18,Main-207-,,0,0,0,,Dikkat edin de kendimiz düşmeyelim.Dialogue: 50,0:06:06.18,0:06:08.93,Main-207-,,0,0,0,,Kazdığımız çukura düşmek bayağı aptalca olurdu.Dialogue: 50,0:06:08.93,0:06:12.85,Main-207-,,0,0,0,,Plan yapma konusunda epey akıllısın!Dialogue: 50,0:06:12.85,0:06:14.27,Main-207-,,0,0,0,,E-Elbette!Dialogue: 50,0:06:14.27,0:06:19.15,Main-207-,,0,0,0,,Sapanım ve gözü kara fikirlerime güvenim tam!Dialogue: 50,0:06:24.28,0:06:25.70,Main-207-,,0,0,0,,Şafak söktü sökecek.Dialogue: 50,0:06:26.53,0:06:27.49,Main-207-,,0,0,0,,Her an...Dialogue: 50,0:06:44.38,0:06:46.22,Main-207-,,0,0,0,,Vardık!Dialogue: 50,0:06:47.55,0:06:48.93,Main-207-,,0,0,0,,Pekâlâ!Dialogue: 50,0:06:48.93,0:06:52.52,Main-207-,,0,0,0,,Beyler, kıyıya çıkın! Köyü yağmaladıktan sonra hedefimiz malikâne!Dialogue: 50,0:06:52.52,0:06:53.89,Main-207-,,0,0,0,,– Evet! – Evet!Dialogue: 50,0:06:53.89,0:06:56.65,Main-207-,,0,0,0,,Kaptan! Buraya tuhaf tekneler yanaşmış!Dialogue: 50,0:06:56.65,0:06:58.06,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:06:58.65,0:07:00.32,Main-207-,,0,0,0,,Araştıralım mı?Dialogue: 50,0:07:00.32,0:07:01.69,Main-207-,,0,0,0,,Boş verin.Dialogue: 50,0:07:01.69,0:07:03.19,Main-207-,,0,0,0,,Hazine var gibi durmuyor.Dialogue: 50,0:07:06.41,0:07:10.45,Main-207-,,0,0,0,,Nerede kaldılar? Gökyüzü de aydınlandı.Dialogue: 50,0:07:10.45,0:07:12.12,Main-207-,,0,0,0,,Ne olmuş olabilir?Dialogue: 50,0:07:12.12,0:07:14.12,Main-207-,,0,0,0,,Belki de uyuyakalmışlardır?Dialogue: 50,0:07:17.67,0:07:19.96,Main-207-,,0,0,0,,Sanki...Dialogue: 50,0:07:20.00,0:07:21.55,Main-207-,,0,0,0,,Bana öyle geliyor olabilir,Dialogue: 50,0:07:21.55,0:07:24.55,Main-207-,,0,0,0,,ama bir yerden bağırışlar duyuyorum…Dialogue: 50,0:07:29.14,0:07:31.64,Main-207-,,0,0,0,,Evet, kesinlikle duyuyorum!Dialogue: 50,0:07:32.26,0:07:33.98,Main-207-,,0,0,0,,S-Sahi...Dialogue: 50,0:07:33.98,0:07:35.64,Main-207-,,0,0,0,,Hey! Ne oldu?!Dialogue: 50,0:07:35.64,0:07:37.81,Main-207-,,0,0,0,,Kuzey'de de buna benzer bir yokuş var!Dialogue: 50,0:07:38.77,0:07:40.56,Main-207-,,0,0,0,,Yoksa...Dialogue: 50,0:07:40.56,0:07:43.32,Main-207-,,0,0,0,,Belki de yanlış kıyıdayız?!Dialogue: 50,0:07:43.32,0:07:47.61,Main-207-,,0,0,0,,Bu kıyıda buluştukları için bu taraftan geleceklerini sanmıştım.Dialogue: 50,0:07:48.28,0:07:51.83,Main-207-,,0,0,0,,Hey, çabuk olmalıyız! Köye varmak üzereler! Diğer kıyı nerede?!Dialogue: 50,0:07:52.20,0:07:55.91,Main-207-,,0,0,0,,Buradan doğruca kuzeye git, 3 dakikaya varırsın.Dialogue: 50,0:07:55.91,0:08:00.25,Main-207-,,0,0,0,,Buraya çok benziyor. Sadece yokuşu çıkmalarını engellemeliyiz.Dialogue: 50,0:08:00.25,0:08:01.13,Main-207-,,0,0,0,,Lan...Dialogue: 50,0:08:01.13,0:08:03.25,Main-207-,,0,0,0,,Olamaz!Dialogue: 50,0:08:03.25,0:08:07.26,Main-207-,,0,0,0,,Bahsettiğiniz kıyı teknemizi demirlediğimiz yer!Dialogue: 50,0:08:07.26,0:08:08.59,Main-207-,,0,0,0,,Tüm hazinemi alacaklar!Dialogue: 50,0:08:08.59,0:08:10.68,Main-207-,,0,0,0,,Yirmi saniyede orada olurum!Dialogue: 50,0:08:10.68,0:08:11.80,Main-207-,,0,0,0,,Kahretsin!Dialogue: 50,0:08:11.80,0:08:15.14,Main-207-,,0,0,0,,Mükemmel yağ tuzağım tamamen boşa gitti!Dialogue: 50,0:08:15.14,0:08:16.98,Main-207-,,0,0,0,,Hazinem...Dialogue: 50,0:08:16.98,0:08:17.98,Main-207-,,0,0,0,,Hey!Dialogue: 50,0:08:17.98,0:08:19.35,Main-207-,,0,0,0,,Ne yapıyorsun? Gidelim!Dialogue: 50,0:08:19.35,0:08:20.98,Main-207-,,0,0,0,,Evet! Acele etmeliy–Dialogue: 50,0:08:24.03,0:08:26.44,Main-207-,,0,0,0,,Yardım et! Kayıyorum!Dialogue: 50,0:08:27.03,0:08:28.40,Main-207-,,0,0,0,,Bıraksana, aptal!Dialogue: 50,0:08:28.40,0:08:28.99,Main-207-,,0,0,0,,Üzgünüm!Dialogue: 50,0:08:30.03,0:08:30.87,Main-207-,,0,0,0,,Harika!Dialogue: 50,0:08:31.49,0:08:32.91,Main-207-,,0,0,0,,Sağ ol, Zoro!Dialogue: 50,0:08:38.04,0:08:40.37,Main-207-,,0,0,0,,Üzgünüm! Hazine tehlikede!Dialogue: 50,0:08:40.37,0:08:42.59,Main-207-,,0,0,0,,Kendi başının çaresine bak!Dialogue: 50,0:08:43.84,0:08:45.25,Main-207-,,0,0,0,,Bedelini ödeyecek!Dialogue: 50,0:08:50.93,0:08:53.10,Main-207-,,0,0,0,,Köyü ele geçirmelerine izin veremem!Dialogue: 50,0:08:53.80,0:08:56.89,Main-207-,,0,0,0,,Ama Luffy gerçekten hızlıymış!Dialogue: 50,0:08:56.89,0:08:58.52,Main-207-,,0,0,0,,Gözden kayboldu!Dialogue: 50,0:08:59.31,0:09:02.52,Main-207-,,0,0,0,,Doğruca kuzeye! Doğruca kuzeye! Doğruca kuzeye!Dialogue: 50,0:09:04.19,0:09:07.49,Main-207-,,0,0,0,,Hazineme dokunanın sonu feci olur!Dialogue: 50,0:09:15.95,0:09:17.70,Main-207-,,0,0,0,,Orada biri var!Dialogue: 50,0:09:20.37,0:09:21.12,Main-207-,,0,0,0,,Sen!Dialogue: 50,0:09:33.34,0:09:35.85,Main-207-,,0,0,0,,Benim adım, Kaptan Usopp!Dialogue: 50,0:09:35.85,0:09:38.18,Main-207-,,0,0,0,,Bunca zamandır sizi bekliyordum!Dialogue: 50,0:09:43.10,0:09:46.27,Thoughts-207-,,0,0,0,,N-Ne...? Niye buraya ilk gelen benim?!Dialogue: 50,0:09:46.27,0:09:50.36,Thoughts-207-,,0,0,0,,Ama o, benden çok önde koşuyordu!Dialogue: 50,0:09:52.53,0:09:54.16,Main-207-,,0,0,0,,Kahretsin!Dialogue: 50,0:09:54.74,0:09:56.24,Main-207-,,0,0,0,,Ne yapacağım?!Dialogue: 50,0:09:56.24,0:09:58.49,Main-207-,,0,0,0,,Bunu geçemiyorum!Dialogue: 50,0:10:02.58,0:10:04.04,Main-207-,,0,0,0,,Şimdi köydeyim!Dialogue: 50,0:10:04.04,0:10:05.42,Main-207-,,0,0,0,,Çok tuhaf!Dialogue: 50,0:10:05.42,0:10:08.42,Main-207-,,0,0,0,,Kuzey dediği için en soğuk yere doğru koştum.Dialogue: 50,0:10:13.76,0:10:19.43,Main-207-,,0,0,0,,Sen o planımızı duyan çocuksun. Şimdi ne yapacaksın?Dialogue: 50,0:10:19.43,0:10:21.06,Main-207-,,0,0,0,,S-Sizi uyarıyorum!Dialogue: 50,0:10:21.06,0:10:22.69,Main-207-,,0,0,0,,Yapabiliyorken geri dönün!Dialogue: 50,0:10:23.10,0:10:27.86,Main-207-,,0,0,0,,Yoksa 100 milyon adamım sizi perişan eder!Dialogue: 50,0:10:29.86,0:10:31.19,Main-207-,,0,0,0,,100 milyon mu?Dialogue: 50,0:10:31.19,0:10:33.24,Main-207-,,0,0,0,,Hey, kimse buna inanmaz!Dialogue: 50,0:10:33.24,0:10:34.36,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:10:34.36,0:10:36.53,Main-207-,,0,0,0,,100 milyon mu?! S-Süper!Dialogue: 50,0:10:36.53,0:10:38.41,Main-207-,,0,0,0,,Açıkça yalan söylüyor, Kaptan!Dialogue: 50,0:10:38.41,0:10:39.95,Main-207-,,0,0,0,,O kadar saf ki...Dialogue: 50,0:10:40.33,0:10:41.75,Thoughts-207-,,0,0,0,,Anladılar mı?Dialogue: 50,0:10:41.75,0:10:44.62,Main-207-,,0,0,0,,Gerçekten yutacağımızı düşünmüş.Dialogue: 50,0:10:44.62,0:10:45.71,Main-207-,,0,0,0,,Seni pislik...!Dialogue: 50,0:10:45.71,0:10:47.92,Main-207-,,0,0,0,,Ne cüretle beni kandırırsın!Dialogue: 50,0:10:47.92,0:10:49.55,Main-207-,,0,0,0,,Kaptan Jango! Haberlerim var!Dialogue: 50,0:10:49.55,0:10:50.84,Main-207-,,0,0,0,,Gerçekten mi?! Kötü mü?!Dialogue: 50,0:10:50.84,0:10:52.01,Main-207-,,0,0,0,,Hayır! Kötü değil!Dialogue: 50,0:10:52.63,0:10:54.84,Main-207-,,0,0,0,,O garip teknelerde hazine bulduk!Dialogue: 50,0:10:55.22,0:10:56.30,Main-207-,,0,0,0,,Hem de çok!Dialogue: 50,0:10:56.30,0:10:58.64,Main-207-,,0,0,0,,Belki 4— hayır, 5 milyon beli!Dialogue: 50,0:10:58.64,0:10:59.35,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:10:59.35,0:11:02.68,Main-207-,,0,0,0,,5 milyon beli mi?!Dialogue: 50,0:11:02.68,0:11:05.94,Main-207-,,0,0,0,,O adamlarda bu kadar para neden var?Dialogue: 50,0:11:07.61,0:11:09.77,Main-207-,,0,0,0,,O hazine benim!Dialogue: 50,0:11:10.36,0:11:11.40,Main-207-,,0,0,0,,Size vereceğim!Dialogue: 50,0:11:11.40,0:11:13.49,Main-207-,,0,0,0,,Ne?! Bize mi veriyorsun?!Dialogue: 50,0:11:13.49,0:11:14.36,Main-207-,,0,0,0,,Doğru!Dialogue: 50,0:11:15.70,0:11:19.58,Main-207-,,0,0,0,,Karşılığında sizden tek ricam derhal gitmeniz.Dialogue: 50,0:11:19.58,0:11:20.58,Main-207-,,0,0,0,,N...?!Dialogue: 50,0:11:20.58,0:11:22.83,Main-207-,,0,0,0,,Şimdi de bizi satın almaya mı çalışıyor?Dialogue: 50,0:11:22.83,0:11:25.71,Main-207-,,0,0,0,,Ne rezil bir herif!Dialogue: 50,0:11:26.33,0:11:27.58,Main-207-,,0,0,0,,Seni aptal...Dialogue: 50,0:11:27.58,0:11:29.21,Main-207-,,0,0,0,,Biz korsanız.Dialogue: 50,0:11:29.21,0:11:32.38,Main-207-,,0,0,0,,Elbette bu hazineleri kabul edeceğiz!Dialogue: 50,0:11:33.09,0:11:36.38,Main-207-,,0,0,0,,Ancak, gitmemizi gerektirecek bir şey yok.Dialogue: 50,0:11:37.76,0:11:39.85,Main-207-,,0,0,0,,H-Haklısın...Dialogue: 50,0:11:41.89,0:11:46.39,Main-207-,,0,0,0,,"Bir, iki, Jango!" dedikten sonra yoldan çekileceksin.Dialogue: 50,0:11:47.56,0:11:49.40,Main-207-,,0,0,0,,Önceden kullandığı silah!Dialogue: 50,0:11:49.90,0:11:51.69,Main-207-,,0,0,0,,Bir, iki...Dialogue: 50,0:11:52.15,0:11:52.69,Main-207-,,0,0,0,,Ja–Dialogue: 50,0:11:53.03,0:11:55.86,Main-207-,,0,0,0,,Saçmalamayı bırak!Dialogue: 50,0:11:58.95,0:12:01.24,Main-207-,,0,0,0,,Ah!Dialogue: 50,0:12:01.62,0:12:03.16,Main-207-,,0,0,0,,K-Kim o?!Dialogue: 50,0:12:03.16,0:12:07.75,Main-207-,,0,0,0,,Kaptan! Bu hipnotize olup kendi yolundan çekilecek zaman değil.Dialogue: 50,0:12:08.08,0:12:10.29,Main-207-,,0,0,0,,O teknedeki hazinenin hepsi benim!Dialogue: 50,0:12:10.29,0:12:11.79,Main-207-,,0,0,0,,Tekine bile dokunamazsınız!Dialogue: 50,0:12:11.79,0:12:15.26,Main-207-,,0,0,0,,Onlara iyi bakın, çünkü gelip alacağım!Dialogue: 50,0:12:15.26,0:12:16.42,Main-207-,,0,0,0,,Acıyor!Dialogue: 50,0:12:16.42,0:12:19.13,Main-207-,,0,0,0,,Hazinemi dağıtmana kim izin verdi?!Dialogue: 50,0:12:19.13,0:12:23.14,Main-207-,,0,0,0,,Bana vurmadan söyleyebilirdin!Dialogue: 50,0:12:23.14,0:12:25.52,Main-207-,,0,0,0,,Minettar olmalısın! Az önce seni kurtardım!Dialogue: 50,0:12:25.85,0:12:26.64,Main-207-,,0,0,0,,Ne?Dialogue: 50,0:12:26.64,0:12:30.44,Main-207-,,0,0,0,,Sana söylemeyi unuttum, o halkaya asla bakmamalısın!Dialogue: 50,0:12:30.85,0:12:33.40,Main-207-,,0,0,0,,O bir hipnotizmacı!Dialogue: 50,0:12:34.02,0:12:35.65,Main-207-,,0,0,0,,H-Hipnotizmacı?Dialogue: 50,0:12:35.65,0:12:37.53,Main-207-,,0,0,0,,Peki Luffy nerede?Dialogue: 50,0:12:37.53,0:12:39.66,Main-207-,,0,0,0,,İlk gelen o değil miydi?Dialogue: 50,0:12:39.66,0:12:40.91,Main-207-,,0,0,0,,Bilmiyorum!Dialogue: 50,0:12:40.91,0:12:43.62,Main-207-,,0,0,0,,Ya korkup kaçtı ya da kayboldu!Dialogue: 50,0:12:44.58,0:12:46.58,Main-207-,,0,0,0,,Öyleyse kaybolmuştur.Dialogue: 50,0:12:46.58,0:12:49.62,Main-207-,,0,0,0,,Aman ya! Tam da ona ihtiyacımız varken!Dialogue: 50,0:12:49.62,0:12:51.50,Main-207-,,0,0,0,,Tamam, komutayı devralıyorum.Dialogue: 50,0:12:51.50,0:12:53.46,Main-207-,,0,0,0,,Git kıçlarını tekmele! Ben seni korurum!Dialogue: 50,0:12:53.46,0:12:55.96,Main-207-,,0,0,0,,Ne?! Dur biraz, neden ben?!Dialogue: 50,0:12:55.96,0:12:58.34,Main-207-,,0,0,0,,O devasa orduyla başa çıkmamın imkânı yok!Dialogue: 50,0:12:58.34,0:12:59.72,Main-207-,,0,0,0,,Pek savaşçı sayılmam!Dialogue: 50,0:12:59.72,0:13:01.59,Main-207-,,0,0,0,,Erkek olduğum için aldanma!Dialogue: 50,0:13:01.59,0:13:05.18,Main-207-,,0,0,0,,Korkudan bacaklarım titriyor! Görmüyor musun?!Dialogue: 50,0:13:05.18,0:13:06.97,Main-207-,,0,0,0,,O da bir şey mi?!Dialogue: 50,0:13:06.97,0:13:09.94,Main-207-,,0,0,0,,Korkudan her an ağlamaya başlayabilirim!Dialogue: 50,0:13:09.94,0:13:12.02,Main-207-,,0,0,0,,Gözlerin kesinlikle kupkuru!Dialogue: 50,0:13:12.02,0:13:14.86,Main-207-,,0,0,0,,Yalan söyleyeceksen, yenilir yutulur cinsten olsun.Dialogue: 50,0:13:14.86,0:13:16.98,Main-207-,,0,0,0,,Söyleyene bak!Dialogue: 50,0:13:16.98,0:13:20.28,Main-207-,,0,0,0,,Onlarla uğraşarak  kaybedecek vaktimiz yok.Dialogue: 50,0:13:20.28,0:13:23.82,Main-207-,,0,0,0,,Ezin geçin hepsini! Hedefimiz köy, beyler!Dialogue: 50,0:13:28.12,0:13:29.62,Main-207-,,0,0,0,,G-Geliyorlar!Dialogue: 50,0:13:29.62,0:13:30.62,Main-207-,,0,0,0,,Oh, evet!Dialogue: 50,0:13:30.62,0:13:31.83,Main-207-,,0,0,0,,Demirdikenlerim vardı!Dialogue: 50,0:13:32.33,0:13:34.04,Main-207-,,0,0,0,,Demek işe yarar şeylerin var!Dialogue: 50,0:13:34.04,0:13:35.42,Main-207-,,0,0,0,,Bana da, bana da ver!Dialogue: 50,0:13:38.76,0:13:40.26,Main-207-,,0,0,0,,Alın bakalım!Dialogue: 50,0:13:40.26,0:13:42.30,Main-207-,,0,0,0,,Demirdiken Cehennemi!Dialogue: 50,0:13:52.73,0:13:55.15,Main-207-,,0,0,0,,Lanet olası, Nami!Dialogue: 50,0:13:55.15,0:13:56.77,Main-207-,,0,0,0,,Bunu ödeyeceksin!Dialogue: 50,0:14:04.32,0:14:07.53,Main-207-,,0,0,0,,Başardım!Dialogue: 50,0:14:12.79,0:14:16.50,Main-207-,,0,0,0,,Ş-Şimdi, şu kuzey kıyısı nerdeydi?!Dialogue: 50,0:14:17.75,0:14:20.76,Main-207-,,0,0,0,,Doğruca kuzeye! Doğruca kuzeye! Doğruca kuzeye!Dialogue: 50,0:14:27.30,0:14:28.81,Main-207-,,0,0,0,,Ne taraf kuzey?!Dialogue: 50,0:14:28.81,0:14:30.43,Main-207-,,0,0,0,,Ah!Dialogue: 50,0:14:33.10,0:14:34.40,Main-207-,,0,0,0,,Harika! Onları hakladık!Dialogue: 50,0:14:34.40,0:14:35.40,Main-207-,,0,0,0,,Şimdi...!Dialogue: 50,0:14:35.40,0:14:38.52,Main-207-,,0,0,0,,Ölümcül Kurşun Yıldızı!Dialogue: 50,0:14:41.15,0:14:42.32,Main-207-,,0,0,0,,Şerefsiz!Dialogue: 50,0:14:42.69,0:14:43.82,Main-207-,,0,0,0,,Fena değil!Dialogue: 50,0:14:43.82,0:14:45.57,Main-207-,,0,0,0,,Böyle devam et!Dialogue: 50,0:14:45.57,0:14:47.45,Main-207-,,0,0,0,,Ben biraz ara vereceğim.Dialogue: 50,0:14:47.45,0:14:49.91,Main-207-,,0,0,0,,Hey, daha kimseyle dövüşmedin!Dialogue: 50,0:14:49.91,0:14:50.87,Main-207-,,0,0,0,,S-Sorun nedir?!Dialogue: 50,0:14:51.62,0:14:53.58,Main-207-,,0,0,0,,Burada da demirdikenler var.Dialogue: 50,0:14:53.58,0:14:54.62,Main-207-,,0,0,0,,Aptal mısın sen?!Dialogue: 50,0:14:54.62,0:14:56.38,Main-207-,,0,0,0,,Onları oraya sen düşürdün!Dialogue: 50,0:14:57.84,0:14:59.59,Main-207-,,0,0,0,,Yoluma çıkıyorsun!Dialogue: 50,0:15:08.43,0:15:11.52,Main-207-,,0,0,0,,Gerçekten bizi durdurabileceğinizi mi düşündünüz?Dialogue: 50,0:15:14.48,0:15:15.73,Main-207-,,0,0,0,,Gidelim, millet!Dialogue: 50,0:15:15.73,0:15:17.60,Main-207-,,0,0,0,,Kaptan Kuro bekliyor!Dialogue: 50,0:15:17.60,0:15:19.44,Main-207-,,0,0,0,,– Evet! – Evet!Dialogue: 50,0:15:23.03,0:15:24.28,Main-207-,,0,0,0,,N-Ne oluyor...?!Dialogue: 50,0:15:24.28,0:15:27.24,Main-207-,,0,0,0,,Bırak, seni piç! Lanet olası bıraksana!Dialogue: 50,0:15:27.57,0:15:28.74,Main-207-,,0,0,0,,Seni pislik!Dialogue: 50,0:15:28.74,0:15:30.49,Main-207-,,0,0,0,,Al sana! Piç herif!Dialogue: 50,0:15:30.49,0:15:33.25,Main-207-,,0,0,0,,Bu... yokuşu...Dialogue: 50,0:15:34.12,0:15:36.58,Main-207-,,0,0,0,,geçmenize izin veremem.Dialogue: 50,0:15:37.96,0:15:42.21,Main-207-,,0,0,0,,Burada yaşananlar bir yalan olarak kalacak...Dialogue: 50,0:15:43.05,0:15:47.72,Main-207-,,0,0,0,,dolayısıyla köy için sıradan bir gün olacak.Dialogue: 50,0:15:47.72,0:15:50.97,Main-207-,,0,0,0,,Geçmenize kesinlikle izin vermeyeceğim!Dialogue: 50,0:15:50.97,0:15:52.18,Main-207-,,0,0,0,,Lanet velet! Kes sesini!Dialogue: 50,0:15:55.48,0:15:56.94,Main-207-,,0,0,0,,Sürtük!Dialogue: 50,0:16:00.36,0:16:01.94,Main-207-,,0,0,0,,Ah!Dialogue: 50,0:16:02.77,0:16:03.86,Main-207-,,0,0,0,,Sen...?!Dialogue: 50,0:16:04.86,0:16:07.49,Main-207-,,0,0,0,,Bu kadar yeter!Dialogue: 50,0:16:09.82,0:16:11.45,Main-207-,,0,0,0,,Hey, siz!Dialogue: 50,0:16:11.45,0:16:15.08,Main-207-,,0,0,0,,Boş verin onları, bir an önce yola koyulun!Dialogue: 50,0:16:15.08,0:16:17.92,Main-207-,,0,0,0,,Yoksa Kaptan Kuro'nun planını unuttunuz mu?!Dialogue: 50,0:16:17.92,0:16:19.79,Main-207-,,0,0,0,,Eğer bir terslik olursa,Dialogue: 50,0:16:20.29,0:16:22.75,Main-207-,,0,0,0,,hepimiz öldürülürüz!Dialogue: 50,0:16:22.75,0:16:25.59,Main-207-,,0,0,0,,Anladınız mı, sizi embesil sürüsü?!Dialogue: 50,0:16:25.59,0:16:26.72,Main-207-,,0,0,0,,P-Peki...Dialogue: 50,0:16:26.72,0:16:28.72,Main-207-,,0,0,0,,Evet, bir an önce köye gidelim!Dialogue: 50,0:16:33.60,0:16:34.85,Main-207-,,0,0,0,,Durun...Dialogue: 50,0:16:34.85,0:16:36.27,Main-207-,,0,0,0,,Kahretsin...Dialogue: 50,0:16:37.10,0:16:38.31,Main-207-,,0,0,0,,Durun!Dialogue: 50,0:16:38.94,0:16:40.94,Main-207-,,0,0,0,,Durun... Köye gitmeyin!Dialogue: 50,0:16:40.94,0:16:42.02,Main-207-,,0,0,0,,Kapa' çeneni!Dialogue: 50,0:16:50.28,0:16:51.95,Thoughts-207-,,0,0,0,,Durun!Dialogue: 50,0:16:51.95,0:16:53.70,Thoughts-207-,,0,0,0,,Lütfen...!Dialogue: 50,0:16:53.70,0:16:56.45,Thoughts-207-,,0,0,0,,Lütfen onları öldürmeyin!Dialogue: 50,0:16:56.45,0:16:58.29,Thoughts-207-,,0,0,0,,Bu köyü seviyorum!Dialogue: 50,0:16:59.29,0:17:01.42,Thoughts-207-,,0,0,0,,Herkesi korumak istiyorum!Dialogue: 50,0:17:16.77,0:17:19.31,Main-207-,,0,0,0,,T-Tüm bunlar da ne, Kaptan Jango?!Dialogue: 50,0:17:19.31,0:17:21.90,Main-207-,,0,0,0,,Köyde böyle adamlar olduğunu hiç duymamıştım!Dialogue: 50,0:17:22.94,0:17:24.40,Main-207-,,0,0,0,,Sonunda be...Dialogue: 50,0:17:28.03,0:17:30.53,Main-207-,,0,0,0,,Tüm bu karmaşa da ne?Dialogue: 50,0:17:30.53,0:17:31.53,Main-207-,,0,0,0,,Nereden bileyim?Dialogue: 50,0:17:31.53,0:17:33.24,Main-207-,,0,0,0,,Ama hâlâ kızgınım!Dialogue: 50,0:17:34.20,0:17:37.58,Main-207-,,0,0,0,,Nami! Beni ayaklarınla çiğnemeye nasıl cüret edersin?!Dialogue: 50,0:17:37.58,0:17:39.41,Main-207-,,0,0,0,,Usopp, seni pislik!Dialogue: 50,0:17:39.41,0:17:42.04,Main-207-,,0,0,0,,Bana hangi tarafın kuzey olduğunu söylemedin!Dialogue: 50,0:17:44.04,0:17:45.67,Main-207-,,0,0,0,,Bunlar da kim?Dialogue: 50,0:17:52.34,0:17:54.26,Main-207-,,0,0,0,,Geciktiler...Dialogue: 50,0:17:54.26,0:18:02.44,Main-207-,,0,0,0,,Planlarımı bozanlara ne olduğunu çok iyi bildiklerini sanıyordum.Dialogue: 50,0:18:08.78,0:18:11.40,Main-207-,,0,0,0,,Yine de gevşek davranıyorlar.Dialogue: 50,0:18:11.40,0:18:14.91,Main-207-,,0,0,0,,Eğer bunu unuttularsa...Dialogue: 50,0:18:16.91,0:18:18.74,Main-207-,,0,0,0,,hepsini katledeceğim!Dialogue: 50,0:18:31.76,0:18:34.43,Main-207-,,0,0,0,,S-Siz o kadar güçlü müsünüz?Dialogue: 50,0:18:37.39,0:18:40.39,Main-207-,,0,0,0,,Niye bu kadar uzun sürdü?Dialogue: 50,0:18:41.39,0:18:44.35,Main-207-,,0,0,0,,Beni o yağın içine sürüklediğin için!Dialogue: 50,0:18:44.35,0:18:47.36,Main-207-,,0,0,0,,Bile isteye yapmadım, başka çarem yoktu!Dialogue: 50,0:18:47.36,0:18:51.36,Main-207-,,0,0,0,,İkimizin de kaymasındansa birimizin kurtulması daha iyi.Dialogue: 50,0:18:51.36,0:18:53.11,Main-207-,,0,0,0,,Peki niye sen?Dialogue: 50,0:18:53.78,0:18:55.03,Main-207-,,0,0,0,,Cidden!Dialogue: 50,0:18:55.03,0:18:59.53,Main-207-,,0,0,0,,Kuzeyin nerede olduğunu nasıl bilebilirim ki?!Dialogue: 50,0:18:59.53,0:19:00.66,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:19:00.66,0:19:03.29,Main-207-,,0,0,0,,Kendine güvenerek koşan sendin!Dialogue: 50,0:19:04.29,0:19:07.17,Main-207-,,0,0,0,,Sadece yardım etmeye çalışıyordum.Dialogue: 50,0:19:07.17,0:19:09.38,Main-207-,,0,0,0,,Güneş doğalı epey oldu...Dialogue: 50,0:19:09.71,0:19:13.30,Main-207-,,0,0,0,,Kaptan Kuro çok sabırsız biridir.Dialogue: 50,0:19:14.76,0:19:16.22,Main-207-,,0,0,0,,Hey, beyler!Dialogue: 50,0:19:16.22,0:19:20.47,Main-207-,,0,0,0,,Sakın bana iki veletle başa çıkamadığınızı söylemeyin!Dialogue: 50,0:19:25.23,0:19:26.52,Main-207-,,0,0,0,,Dinleyin!Dialogue: 50,0:19:26.52,0:19:29.61,Main-207-,,0,0,0,,Oyalanacak vaktimiz yok!Dialogue: 50,0:19:30.19,0:19:33.57,Main-207-,,0,0,0,,Onlar güçlüyse, biz daha da güçlü olmalıyız!Dialogue: 50,0:19:33.57,0:19:36.57,Main-207-,,0,0,0,,Şimdi bu halkaya bakın!Dialogue: 50,0:19:36.57,0:19:39.45,Main-207-,,0,0,0,,"Bir, iki, Jango" dediğimde, güçleneceksiniz.Dialogue: 50,0:19:39.45,0:19:43.75,Main-207-,,0,0,0,,Yaralarınız tamamen iyileşecek, ve çok daha güçlü olacaksınız!Dialogue: 50,0:19:43.75,0:19:46.46,Main-207-,,0,0,0,,Ne yapmaya çalışıyor?Dialogue: 50,0:19:46.46,0:19:48.21,Main-207-,,0,0,0,,Hipnoz.Dialogue: 50,0:19:48.21,0:19:50.59,Main-207-,,0,0,0,,Onları güçlü olduklarına inandıracak!Dialogue: 50,0:19:50.59,0:19:51.84,Main-207-,,0,0,0,,Çok saçma!Dialogue: 50,0:19:51.84,0:19:53.17,Main-207-,,0,0,0,,Bir!Dialogue: 50,0:19:53.17,0:19:54.59,Main-207-,,0,0,0,,İki!Dialogue: 50,0:19:55.09,0:19:56.84,Main-207-,,0,0,0,,Jango!Dialogue: 50,0:20:00.22,0:20:01.14,Main-207-,,0,0,0,,Olamaz!Dialogue: 50,0:20:14.48,0:20:17.15,Main-207-,,0,0,0,,K-Kayalık parçalara ayrıldı!Dialogue: 50,0:20:17.15,0:20:19.24,Main-207-,,0,0,0,,Ne güç ama!Dialogue: 50,0:20:19.99,0:20:22.70,Main-207-,,0,0,0,,Gerçekten hipnotize oldular.Dialogue: 50,0:20:22.70,0:20:26.20,Main-207-,,0,0,0,,Böylesine güçlü bir orduyla...Dialogue: 50,0:20:28.54,0:20:29.79,Main-207-,,0,0,0,,Gidin!Dialogue: 50,0:20:29.79,0:20:32.21,Main-207-,,0,0,0,,Yolunuza çıkan herkesi ezin!Dialogue: 50,0:20:43.68,0:20:45.56,Main-207-,,0,0,0,,İkiniz, yoldan çekilin!Dialogue: 50,0:20:46.02,0:20:48.27,Main-207-,,0,0,0,,Buradan itibaren biz devralacağız!Dialogue: 50,0:20:51.94,0:20:53.02,Main-207-,,0,0,0,,Hey, Luffy!Dialogue: 50,0:20:57.15,0:20:58.24,Main-207-,,0,0,0,,Luffy?!Dialogue: 50,0:21:03.16,0:21:05.66,Main-207-,,0,0,0,,Sen de mi hipnotize oldun?!Dialogue: 50,0:21:12.88,0:21:15.80,Main-207-,,0,0,0,,Ne ahmak ama!Dialogue: 50,0:21:19.05,0:21:21.55,Main-207-,,0,0,0,,Lastik-Lastik...Dialogue: 50,0:21:21.55,0:21:26.06,Main-207-,,0,0,0,,Mitralyöz!Dialogue: 50,0:21:35.65,0:21:37.40,Main-207-,,0,0,0,,Lanet, Kaptan Kuro...Dialogue: 50,0:21:37.40,0:21:39.74,Main-207-,,0,0,0,,Hiçbir etkisi olmayacağını sanman hataydı!Dialogue: 50,0:21:40.28,0:21:42.86,Main-207-,,0,0,0,,Onlar sıradan veletler değil!Dialogue: 50,0:22:02.55,0:22:04.55,Main-207-,,0,0,0,,Nereye gidiyor bu?!Dialogue: 50,0:22:07.56,0:22:09.47,Main-207-,,0,0,0,,Ne yapıyor?!Dialogue: 50,0:22:19.11,0:22:21.90,Main-207-,,0,0,0,,Saldır, Luffy!Dialogue: 50,0:22:23.74,0:22:25.62,Main-207-,,0,0,0,,Gemiyi yok ediyor!Dialogue: 50,0:22:34.96,0:22:35.71,Main-207-,,0,0,0,,Hayır!Dialogue: 50,0:22:35.71,0:22:39.59,Main-207-,,0,0,0,,Bizi onunla pataklamak istiyor!Dialogue: 50,0:22:40.84,0:22:43.26,Main-207-,,0,0,0,,Çabuk bir şeyler yapın, Kaptan!Dialogue: 50,0:22:46.76,0:22:48.76,Main-207-,,0,0,0,,"Bir, iki, Jango!" dediğimde, uyuyacaksın.Dialogue: 50,0:22:51.27,0:22:52.02,Main-207-,,0,0,0,,Bir!Dialogue: 50,0:22:52.60,0:22:53.35,Main-207-,,0,0,0,,İki!Dialogue: 50,0:22:54.10,0:22:55.65,Main-207-,,0,0,0,,Jango!Dialogue: 50,0:23:29.55,0:23:32.18,Main-207-,,0,0,0,,Sanırım neredeyse tamamı oyun dışı kaldı!Dialogue: 50,0:23:32.18,0:23:33.22,Main-207-,,0,0,0,,Öyle gibi.Dialogue: 50,0:23:33.22,0:23:34.73,Main-207-,,0,0,0,,Hey!Dialogue: 50,0:23:34.73,0:23:37.60,Main-207-,,0,0,0,,Onu boş verin de Luffy ezildi!Dialogue: 50,0:23:38.19,0:23:39.69,Main-207-,,0,0,0,,Ölmeyecektir.Dialogue: 50,0:23:39.69,0:23:43.36,Main-207-,,0,0,0,,Kendi yaraların için daha fazla endişelenmelisin.Dialogue: 50,0:23:46.07,0:23:48.45,Main-207-,,0,0,0,,Lanet olası velet!Dialogue: 50,0:23:48.45,0:23:50.66,Main-207-,,0,0,0,,Artık plan tamamen mahvoldu!Dialogue: 50,0:23:50.66,0:23:52.83,Main-207-,,0,0,0,,Kaptan Kuro bunu görürse,Dialogue: 50,0:23:53.33,0:23:55.58,Main-207-,,0,0,0,,hepimizi katleder!Dialogue: 50,0:23:56.83,0:23:58.12,Main-207-,,0,0,0,,Hey, Buchi!Dialogue: 50,0:23:58.12,0:24:00.38,Main-207-,,0,0,0,,Gel de şu karmaşaya bak!Dialogue: 50,0:24:00.38,0:24:02.88,Main-207-,,0,0,0,,Bu da ne böyle?!Dialogue: 50,0:24:03.25,0:24:05.09,Main-207-,,0,0,0,,Hâlâ elimizde bir koz var!Dialogue: 50,0:24:05.51,0:24:08.89,Main-207-,,0,0,0,,Öne çıkın, Miyavban Kardeşler!Dialogue: 50,0:24:21.06,0:24:23.82,Main-207-,,0,0,0,,Bu, malikânedeki Klahadore!Dialogue: 50,0:24:23.82,0:24:27.40,Main-207-,,0,0,0,,Niye bu kadar erken saatte kıyıya doğru gidiyor?!Dialogue: 0,0:02:04.10,0:02:07.07,Title-207-,,0,0,0,,YokuşDialogue: 1,0:02:04.10,0:02:07.07,Title-207-,,0,0,0,,YokuşDialogue: 0,0:05:32.98,0:05:35.90,Captions-207-,,0,0,0,,"Bir-İki" Jango Kara Kedi Korsanları'nın Kaptan VekiliDialogue: 1,0:05:32.98,0:05:35.90,Captions-207-,,0,0,0,,"Bir-İki" Jango Kara Kedi Korsanları'nın Kaptan VekiliDialogue: 2,0:05:32.98,0:05:35.90,Captions-207-,,0,0,0,,"Bir-İki" Jango Kara Kedi Korsanları'nın Kaptan VekiliDialogue: 0,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 1,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 0,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Feeso Galaxy 9000Dialogue: 1,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Feeso Galaxy 9000Dialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,MüzikDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,MüzikDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,HaleeDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,HaleeDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,GrafikDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,GrafikDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,DatenshiDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,DatenshiDialogue: 0,0:00:06.78,0:00:10.78,Credits-207-,,0,0,0,,Kalite KontrolDialogue: 1,0:00:06.78,0:00:10.78,Credits-207-,,0,0,0,,Kalite KontrolDialogue: 0,0:00:06.78,0:00:10.78,Credits-207-,,0,0,0,,Gab Galaxy 9000 Gol D. Rocks Grug Mr. Luffy Pepperjack Westfal ZenefDialogue: 1,0:00:06.78,0:00:10.78,Credits-207-,,0,0,0,,Gab Galaxy 9000 Gol D. Rocks Grug Mr. Luffy Pepperjack Westfal ZenefDialogue: 0,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,KaraokeDialogue: 1,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,KaraokeDialogue: 0,0:00:10.78,0:00:13.28,Credits-207-,