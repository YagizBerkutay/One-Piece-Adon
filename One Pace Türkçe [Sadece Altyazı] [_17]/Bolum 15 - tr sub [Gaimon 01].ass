100,3,0,1,2.95,0,8,23,23,146,1Style: Karaoke-furigana,Duality,36,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,2.95,0,8,23,23,23,1Style: Lyrics-furigana,Duality,36,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,2.95,0,2,23,23,34,1Style: Lyrics,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,2,23,23,34,1Style: Karaoke,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,23,1Style: Kanji,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,146,1Style: Roger-Monologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1Style: Romaji ED,Josefin Sans,82,&H00FFFFFF,&H003592BE,&H00000000,&H64000000,0,0,0,0,100,100,0,0,1,0,4,8,10,10,20,1Style: Translation ED,Josefin Sans,82,&H00FFFFFF,&H000000FF,&H00FFFFFF,&H64000000,0,0,0,0,100,100,0,0,1,0,4,2,10,10,20,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Your media player does not support the subtitle format used in this episode. Subtitles will likely not function properly. Please use one of the recommended video players, preferably mpv: https://mpv.ioDialogue: 0,0:01:50.01,0:02:00.00,Warning,,0,0,0,,Your media player does not support the subtitle format used in this episode. Subtitles will likely not function properly. Please use one of the recommended video players, preferably mpv: https://mpv.ioDialogue: 50,0:02:03.81,0:02:06.27,Main-207-,,0,0,0,,Sizi aptal korsanlar.Dialogue: 50,0:02:07.27,0:02:10.74,Main-207-,,0,0,0,,Kaptan Usopp ve yenilmez korsan filosunun komutasındaki...Dialogue: 50,0:02:10.74,0:02:14.24,Main-207-,,0,0,0,,Going Merry'ye saldırmaya cüret mi ediyorsunuz?!Dialogue: 50,0:02:15.49,0:02:18.33,Main-207-,,0,0,0,,Herkes güverteye! Savaşa hazırlanın!Dialogue: 50,0:02:22.79,0:02:26.92,Main-207-,,0,0,0,,Hadi ama... Birazcık oynasanız ölür müsünüz?Dialogue: 50,0:02:26.92,0:02:28.46,Main-207-,,0,0,0,,Bitti!Dialogue: 50,0:02:29.84,0:02:31.71,Main-207-,,0,0,0,,Bakın! Korsan bayrağımız!Dialogue: 50,0:02:31.71,0:02:34.97,Main-207-,,0,0,0,,Usopp da katıldığına göre tayfamız dört kişi oldu.Dialogue: 50,0:02:34.97,0:02:37.05,Main-207-,,0,0,0,,Kendi sembolümüzü belirleme vakti geldi!Dialogue: 50,0:02:38.05,0:02:41.02,Main-207-,,0,0,0,,Bu şimdi... bizim sembolümüz mü olacak?Dialogue: 50,0:02:41.77,0:02:43.98,Main-207-,,0,0,0,,Nasıl ama? Güzel mi?Dialogue: 50,0:02:43.98,0:02:48.02,Main-207-,,0,0,0,,Korsan bayrağı korkutucu olmalı, ölümün simgesi sonuçta.Dialogue: 50,0:02:48.02,0:02:51.86,Main-207-,,0,0,0,,Korkuyorum aslında— senin sanatın beni korkutuyor.Dialogue: 50,0:02:53.36,0:02:55.49,Main-207-,,0,0,0,,Bana söyleseydiniz ya.Dialogue: 50,0:02:55.99,0:02:59.03,Main-207-,,0,0,0,,Benim sanatsal yeteneğimle ünlü olduğumu unutmayın.Dialogue: 50,0:02:59.58,0:03:00.79,Main-207-,,0,0,0,,Sanatsal yetenek mi?Dialogue: 50,0:03:01.66,0:03:03.91,Main-207-,,0,0,0,,Resim söz konusu olduğunda...Dialogue: 50,0:03:03.91,0:03:07.21,Main-207-,,0,0,0,,duvarlara grafiti yaparak geçirdiğim 50 yılı kimse geçemez.Dialogue: 50,0:03:09.79,0:03:12.92,Main-207-,,0,0,0,,Şimdi, sanatsal şaheserime iyice bakın!Dialogue: 50,0:03:12.92,0:03:14.42,Main-207-,,0,0,0,,Ta-Da!Dialogue: 50,0:03:14.42,0:03:16.51,Main-207-,,0,0,0,,Kim sana bayrağı kendine benzet dedi?!Dialogue: 50,0:03:20.22,0:03:22.01,Main-207-,,0,0,0,,Belki böyle bir şey?Dialogue: 50,0:03:22.01,0:03:24.14,Main-207-,,0,0,0,,Vay, bu baya iyi oldu!Dialogue: 50,0:03:24.14,0:03:26.14,Main-207-,,0,0,0,,Evet, güzel gözüküyor. Beğendim!Dialogue: 50,0:03:26.94,0:03:29.44,Main-207-,,0,0,0,,Demek bu bizim sembolümüz olacak?Dialogue: 50,0:03:29.44,0:03:32.69,Main-207-,,0,0,0,,Aferin, Usopp! Hadi yelkene de çizelim!Dialogue: 50,0:03:32.69,0:03:33.65,Main-207-,,0,0,0,,Hay hay!Dialogue: 50,0:03:36.61,0:03:38.74,Main-207-,,0,0,0,,Tamamdır! Bitti!Dialogue: 50,0:03:39.95,0:03:43.54,Main-207-,,0,0,0,,Korsan gemimiz, Going Merry, sonunda hazır!Dialogue: 50,0:03:45.75,0:03:47.83,Main-207-,,0,0,0,,Öff! Canım çıktı!Dialogue: 50,0:03:52.71,0:03:54.42,Main-207-,,0,0,0,,Bu yöne gitmesek mi?Dialogue: 50,0:03:54.42,0:03:56.38,Main-207-,,0,0,0,,Sorun olacak gibi gözüküyor.Dialogue: 50,0:03:56.76,0:03:57.88,Main-207-,,0,0,0,,Sorun mu?Dialogue: 50,0:03:57.88,0:03:59.34,Main-207-,,0,0,0,,Bekleyin.Dialogue: 50,0:04:01.10,0:04:02.60,Main-207-,,0,0,0,,O olmalı...Dialogue: 50,0:04:02.60,0:04:04.60,Main-207-,,0,0,0,,Bu o! Hiç şüphesiz.Dialogue: 50,0:04:04.60,0:04:07.06,Main-207-,,0,0,0,,İlginç bir şey mi gördün?Dialogue: 50,0:04:07.94,0:04:09.73,Main-207-,,0,0,0,,Efsanevi hazine adası.Dialogue: 50,0:04:09.73,0:04:11.61,Main-207-,,0,0,0,,"Efsanevi hazine adası" mı?Dialogue: 50,0:04:11.61,0:04:13.07,Main-207-,,0,0,0,,Duymuştum!Dialogue: 50,0:04:13.07,0:04:16.82,Main-207-,,0,0,0,,Doğru. Bu ada korsanlar arasında ünlüdür.Dialogue: 50,0:04:16.82,0:04:18.57,Main-207-,,0,0,0,,Hakkında tuhaf söylentiler var.Dialogue: 50,0:04:18.91,0:04:20.49,Main-207-,,0,0,0,,Tuhaf söylentiler mi?Dialogue: 50,0:04:20.82,0:04:25.95,Main-207-,,0,0,0,,"Bu adaya kim yaklaşırsa, tanrıların gazabına uğrar" gibi.Dialogue: 50,0:04:30.75,0:04:32.75,Main-207-,,0,0,0,,O zaman söylentiler doğru mu?!Dialogue: 50,0:04:32.75,0:04:34.21,Main-207-,,0,0,0,,Bu tanrıların gazabı mı?!Dialogue: 50,0:04:34.21,0:04:35.88,Main-207-,,0,0,0,,Kulağa eğlenceli geliyor!Dialogue: 50,0:04:35.88,0:04:37.84,Main-207-,,0,0,0,,Luffy, yapma...Dialogue: 50,0:04:37.84,0:04:39.51,Main-207-,,0,0,0,,Yaptı bile!Dialogue: 50,0:04:44.64,0:04:47.02,Main-207-,,0,0,0,,Hazine adasına gidelim!Dialogue: 50,0:04:47.02,0:04:48.68,Main-207-,,0,0,0,,Ve çekin!Dialogue: 50,0:05:29.35,0:05:32.02,Main-207-,,0,0,0,,Karnım kazındı.Dialogue: 50,0:05:32.02,0:05:33.94,Main-207-,,0,0,0,,Ben yatıyorum.Dialogue: 50,0:05:35.77,0:05:38.65,Main-207-,,0,0,0,,Böyle ürkütücü bir yerde uyuyabildiğine inanamıyorum.Dialogue: 50,0:05:38.65,0:05:40.95,Main-207-,,0,0,0,,Gerçekten! Sinirleri neyden yapılmış bunun?Dialogue: 50,0:05:48.83,0:05:50.91,Main-207-,,0,0,0,,Ne oldu? Korkutma beni öyle!Dialogue: 50,0:05:50.91,0:05:54.67,Main-207-,,0,0,0,,Ah... aslında... biraz dans edip neşelenelim istedim!Dialogue: 50,0:05:54.67,0:05:57.55,Main-207-,,0,0,0,,Bak, böyle.Dialogue: 50,0:06:00.42,0:06:02.22,Main-207-,,0,0,0,,Kes şunu, Luffy...Dialogue: 50,0:06:10.73,0:06:12.69,Main-207-,,0,0,0,,B-Bu...Dialogue: 50,0:06:16.48,0:06:19.11,Main-207-,,0,0,0,,Burayı terk edin.Dialogue: 50,0:06:19.11,0:06:19.86,Main-207-,,0,0,0,,Kim o?!Dialogue: 50,0:06:20.36,0:06:22.45,Main-207-,,0,0,0,,Burayı terk edin!Dialogue: 50,0:06:22.45,0:06:24.49,Main-207-,,0,0,0,,O ses nereden geliyor?Dialogue: 50,0:06:24.86,0:06:27.49,Main-207-,,0,0,0,,Ben, bu adanın koruyucu tanrısıyım.Dialogue: 50,0:06:27.49,0:06:30.83,Main-207-,,0,0,0,,Hayatlarınıza değer veriyorsanız, derhal bu adayı terkedin.Dialogue: 50,0:06:30.83,0:06:32.58,Main-207-,,0,0,0,,Koruyucu tanrı mı?Dialogue: 50,0:06:32.58,0:06:34.96,Main-207-,,0,0,0,,Siz korsansınız, değil mi?Dialogue: 50,0:06:34.96,0:06:35.67,Main-207-,,0,0,0,,Öyleyiz.Dialogue: 50,0:06:35.67,0:06:37.84,Main-207-,,0,0,0,,Düşündüğüm gibi, korsanlar.Dialogue: 50,0:06:37.84,0:06:40.55,Main-207-,,0,0,0,,Bir tanrı neden böyle bir şey ister?Dialogue: 50,0:06:40.55,0:06:44.30,Main-207-,,0,0,0,,İyi dinleyin. Bu ormana adım attığınız an,Dialogue: 50,0:06:44.30,0:06:50.64,Main-207-,,0,0,0,,tanrının yargısına katlanıp kesin bir sonla karşılaşacaksınız, değil mi?Dialogue: 50,0:06:50.64,0:06:52.93,Main-207-,,0,0,0,,Ben nereden bileyim? Bana niye soruyorsun?Dialogue: 50,0:06:52.93,0:06:54.27,Main-207-,,0,0,0,,Ne oluyor ya?Dialogue: 50,0:06:54.27,0:06:55.90,Main-207-,,0,0,0,,Bu adam biraz tuhaf.Dialogue: 50,0:06:55.90,0:06:58.90,Main-207-,,0,0,0,,Ne dedin sen, hasır şapkalı çocuk?!Dialogue: 50,0:07:05.20,0:07:07.03,Main-207-,,0,0,0,,Burası ne böyle?Dialogue: 50,0:07:07.03,0:07:12.83,Main-207-,,0,0,0,,Buraya hazine aramaya gelen insanlara bunu yaptım.Dialogue: 50,0:07:14.04,0:07:16.75,Main-207-,,0,0,0,,O zaman sen gerçekten bir tanrı mısın?!Dialogue: 50,0:07:17.08,0:07:19.38,Main-207-,,0,0,0,,Çoğu oldukça tuhaf görünüyor.Dialogue: 50,0:07:19.88,0:07:21.25,Main-207-,,0,0,0,,Bu bir aslan mı?Dialogue: 50,0:07:21.25,0:07:22.92,Main-207-,,0,0,0,,Domuz değil mi?Dialogue: 50,0:07:24.63,0:07:26.38,Main-207-,,0,0,0,,Ah! Ah! Ah! Ah!Dialogue: 50,0:07:27.01,0:07:29.51,Main-207-,,0,0,0,,N-Ne tür bir varlıksın sen?!Dialogue: 50,0:07:29.51,0:07:31.26,Main-207-,,0,0,0,,Ben lastik adamım!Dialogue: 50,0:07:31.26,0:07:32.72,Main-207-,,0,0,0,,Şeytan meyvesi yedim.Dialogue: 50,0:07:32.72,0:07:34.14,Main-207-,,0,0,0,,Şeytan meyvesi mi?Dialogue: 50,0:07:34.14,0:07:35.43,Main-207-,,0,0,0,,Saçmalık!Dialogue: 50,0:07:35.43,0:07:38.02,Main-207-,,0,0,0,,Korsanken onları duymuştum, ama—Dialogue: 50,0:07:38.02,0:07:39.77,Main-207-,,0,0,0,,Korsanken mi?Dialogue: 50,0:07:39.77,0:07:43.23,Main-207-,,0,0,0,,H-Hayır! O günleri sıkça hatırladığım yok yani!Dialogue: 50,0:07:43.23,0:07:46.11,Main-207-,,0,0,0,,Neyse, geçmişi deşmeyi bırakalım.Dialogue: 50,0:07:46.11,0:07:47.32,Main-207-,,0,0,0,,Ne alaka?Dialogue: 50,0:07:47.32,0:07:48.66,Main-207-,,0,0,0,,Geçmişten bahseden sensin.Dialogue: 50,0:07:48.66,0:07:50.95,Main-207-,,0,0,0,,Sen, gerçekten tanrı mısın?Dialogue: 50,0:07:50.95,0:07:54.66,Main-207-,,0,0,0,,Sessizlik! Şimdi defolun ya da tanrıların yargısıyla yüzleşin!Dialogue: 50,0:08:03.75,0:08:05.26,Main-207-,,0,0,0,,Fena değil, tanrıcık.Dialogue: 50,0:08:05.26,0:08:07.17,Main-207-,,0,0,0,,N-Nasıl hâlâ ayaktasın?Dialogue: 50,0:08:07.17,0:08:08.05,Main-207-,,0,0,0,,Oh, orada mı?Dialogue: 50,0:08:08.05,0:08:08.84,Main-207-,,0,0,0,,Kıpırdama!Dialogue: 50,0:08:09.93,0:08:11.35,Main-207-,,0,0,0,,Kıpırdama dedim!Dialogue: 50,0:08:15.43,0:08:17.85,Main-207-,,0,0,0,,N... Ne?! Hiç adil değil!Dialogue: 50,0:08:17.85,0:08:19.60,Main-207-,,0,0,0,,Tanrı ya da her ne isen,Dialogue: 50,0:08:19.60,0:08:21.86,Main-207-,,0,0,0,,bu adama tabancayla bile zarar veremezsin.Dialogue: 50,0:08:21.86,0:08:23.82,Main-207-,,0,0,0,,Yine de beni böyle ürkütme.Dialogue: 50,0:08:23.82,0:08:26.57,Main-207-,,0,0,0,,C-Canavar!Dialogue: 50,0:08:26.57,0:08:28.07,Main-207-,,0,0,0,,Hey! Orada!Dialogue: 50,0:08:28.74,0:08:30.87,Main-207-,,0,0,0,,Cidden tabancaymış.Dialogue: 50,0:08:35.49,0:08:36.87,Main-207-,,0,0,0,,Nereye gitti?Dialogue: 50,0:08:41.46,0:08:42.88,Main-207-,,0,0,0,,Bu ne?Dialogue: 50,0:08:42.88,0:08:45.25,Main-207-,,0,0,0,,Bu... tanrı mı?Dialogue: 50,0:08:46.67,0:08:47.76,Main-207-,,0,0,0,,Hareket etti!Dialogue: 50,0:08:58.06,0:09:00.52,Main-207-,,0,0,0,,Ne bekliyorsunuz?! Kaldırsanıza beni!Dialogue: 50,0:09:00.52,0:09:01.81,Main-207-,,0,0,0,,Bu bir insan.Dialogue: 50,0:09:01.81,0:09:03.86,Main-207-,,0,0,0,,Çok enteresan! Sünger mi bu?Dialogue: 50,0:09:03.86,0:09:07.94,Main-207-,,0,0,0,,Seni... Hangi tanrı böyle ucuz numaralara başvurur?Dialogue: 50,0:09:07.94,0:09:10.49,Main-207-,,0,0,0,,Çeneni kapa da beni kaldırın dedim!Dialogue: 50,0:09:10.49,0:09:12.49,Main-207-,,0,0,0,,Bu kadar atarlanma.Dialogue: 50,0:09:14.83,0:09:16.95,Main-207-,,0,0,0,,Tamam, bu işini görmeli.Dialogue: 50,0:09:21.71,0:09:24.13,Main-207-,,0,0,0,,Burada oldukça popülersin, tanrıcık.Dialogue: 50,0:09:24.13,0:09:29.47,Main-207-,,0,0,0,,Demek bu hayvanları, adaya girenleri uzaklaştırmak için kullanıyorsun.Dialogue: 50,0:09:29.92,0:09:33.01,Main-207-,,0,0,0,,Ama, hiç hazine sandığında yaşayan birini görmemiştim.Dialogue: 50,0:09:33.01,0:09:35.26,Main-207-,,0,0,0,,Ailen seni o kadar mı değerli görüyordu?Dialogue: 50,0:09:35.26,0:09:38.68,Main-207-,,0,0,0,,Evet. Küçüklüğümden beri bana olan sevgilerini...Dialogue: 50,0:09:38.68,0:09:40.43,Main-207-,,0,0,0,,Ne alakası var be!Dialogue: 50,0:09:40.43,0:09:43.27,Main-207-,,0,0,0,,Bu kutudan çıkamıyorum! Sıkıştım!Dialogue: 50,0:09:43.27,0:09:48.11,Main-207-,,0,0,0,,Yirmi yıldır yapayalnız bu adadayım ve bu sandığa tıkılıp kaldım!Dialogue: 50,0:09:48.61,0:09:49.82,Main-207-,,0,0,0,,Yirmi yıl mı?!Dialogue: 50,0:09:57.66,0:10:00.66,Main-207-,,0,0,0,,Yirmi yıldır yalnız başına bu adada mısın?Dialogue: 50,0:10:00.66,0:10:04.63,Main-207-,,0,0,0,,Saçıma sakalıma bakın! Kaşlarım bile birleşti.Dialogue: 50,0:10:05.08,0:10:08.30,Main-207-,,0,0,0,,Yirmi yıldır ilk kez biriyle konuşuyorum.Dialogue: 50,0:10:08.63,0:10:11.05,Main-207-,,0,0,0,,Ne kadar yalnız olduğumu anlıyor musunuz?Dialogue: 50,0:10:12.17,0:10:13.01,Main-207-,,0,0,0,,Çok aptalca.Dialogue: 50,0:10:13.01,0:10:14.22,Main-207-,,0,0,0,,Ne demek aptalca?!Dialogue: 50,0:10:16.72,0:10:18.85,Main-207-,,0,0,0,,Oh, demek buradaydınız.Dialogue: 50,0:10:18.85,0:10:22.23,Main-207-,,0,0,0,,Bütün o kargaşaya rağmen uyudun mu?Dialogue: 50,0:10:31.53,0:10:33.49,Main-207-,,0,0,0,,Ha?! Bu da ne böyle?!Dialogue: 50,0:10:33.49,0:10:35.11,Main-207-,,0,0,0,,Yeni mi fark ettin?Dialogue: 50,0:10:35.11,0:10:37.20,Main-207-,,0,0,0,,Hazine sandığına sıkışmış bir adam.Dialogue: 50,0:10:37.20,0:10:39.45,Main-207-,,0,0,0,,Ne?! Ailesi o kadar mı değerli görüyordu?Dialogue: 50,0:10:39.45,0:10:42.91,Main-207-,,0,0,0,,Evet. Küçüklüğümden beri bana olan sevgilerini...Dialogue: 50,0:10:42.91,0:10:44.29,Main-207-,,0,0,0,,Saçmalamayın!Dialogue: 50,0:10:44.29,0:10:46.29,Main-207-,,0,0,0,,Aynı salak şakayı tekrarlamayın!Dialogue: 50,0:10:46.29,0:10:47.59,Main-207-,,0,0,0,,Zoro, bir el at.Dialogue: 50,0:10:47.59,0:10:50.25,Main-207-,,0,0,0,,Ah! Ah! Ne yapıyorsunuz?!Dialogue: 50,0:10:50.25,0:10:53.84,Main-207-,,0,0,0,,Kesin şunu! Kafamı kopartacaksınız!Dialogue: 50,0:10:53.84,0:10:56.26,Main-207-,,0,0,0,,Peh... Gerçekten çıkamıyormuş!Dialogue: 50,0:10:56.26,0:10:57.64,Main-207-,,0,0,0,,Ne bekliyordun?!Dialogue: 50,0:10:57.64,0:11:00.26,Main-207-,,0,0,0,,Yıllardır hiç egzersiz yapmadım.Dialogue: 50,0:11:00.26,0:11:03.10,Main-207-,,0,0,0,,Vücudum kutu şeklini aldı.Dialogue: 50,0:11:03.10,0:11:06.06,Main-207-,,0,0,0,,Bu kutu, vücudumu bir arada tutan tek şey!Dialogue: 50,0:11:06.06,0:11:07.90,Main-207-,,0,0,0,,Amma konuşkanmış.Dialogue: 50,0:11:09.06,0:11:11.82,Main-207-,,0,0,0,,Neyse, senin küçük tayfanın olayı nedir?Dialogue: 50,0:11:11.82,0:11:15.36,Main-207-,,0,0,0,,Buraya gelen diğer korsanlarla alakanız yok.Dialogue: 50,0:11:16.49,0:11:17.49,Main-207-,,0,0,0,,Ben Luffy!Dialogue: 50,0:11:17.49,0:11:21.12,Main-207-,,0,0,0,,One Piece'i bulup Korsanlar Kralı olacağım!Dialogue: 50,0:11:21.12,0:11:22.79,Main-207-,,0,0,0,,One Piece mi?!Dialogue: 50,0:11:22.79,0:11:26.50,Main-207-,,0,0,0,,Gerçekten Grand Line'a girmeyi planlamıyorsun, değil mi?!Dialogue: 50,0:11:26.50,0:11:28.13,Main-207-,,0,0,0,,Onun için haritamız bile var!Dialogue: 50,0:11:29.00,0:11:31.00,Main-207-,,0,0,0,,Orayı hafife alma!Dialogue: 50,0:11:31.00,0:11:33.38,Main-207-,,0,0,0,,O yer, cehennemin ortasında bir mezarlık gibi!Dialogue: 50,0:11:33.38,0:11:38.39,Main-207-,,0,0,0,,Uzun zaman önce, Grand Line'dan dönen, bir korsan tayfası gördüm.Dialogue: 50,0:11:38.39,0:11:42.01,Main-207-,,0,0,0,,Yürüyen cesetler gibiydiler, tamamen ruhsuz.Dialogue: 50,0:11:42.01,0:11:46.48,Main-207-,,0,0,0,,Karşılaştıkları her neyse, korkunç olmalı.Dialogue: 50,0:11:46.48,0:11:49.06,Main-207-,,0,0,0,,Hiçbiri tek kelime bile etmedi.Dialogue: 50,0:11:50.15,0:11:53.48,Main-207-,,0,0,0,,Onun dışında, One Piece ile ilgili çok fazla söylenti varken...Dialogue: 50,0:11:53.48,0:11:55.86,Main-207-,,0,0,0,,neye inanacağını bilmenin hiç yolu yok.Dialogue: 50,0:11:56.20,0:11:59.41,Main-207-,,0,0,0,,Büyük Korsan Çağı başlayalı yirmi yıldan fazla geçti.Dialogue: 50,0:11:59.41,0:12:03.83,Main-207-,,0,0,0,,One Piece artık efsaneden de öte, hayal içinde bir hayal.Dialogue: 50,0:12:06.75,0:12:09.38,Main-207-,,0,0,0,,Peki, o haritada Grand Line nerede?Dialogue: 50,0:12:09.38,0:12:10.25,Main-207-,,0,0,0,,Bilmiyorum ki.Dialogue: 50,0:12:10.25,0:12:12.13,Main-207-,,0,0,0,,Sen bilmiyor musun, sünger adam?Dialogue: 50,0:12:12.13,0:12:14.34,Main-207-,,0,0,0,,Ben bu deniz haritalarından hiç anlamam.Dialogue: 50,0:12:14.34,0:12:16.13,Main-207-,,0,0,0,,Hadi ya, demek aynıyız.Dialogue: 50,0:12:17.47,0:12:19.93,Main-207-,,0,0,0,,Hiç korsan gibi davranmıyorsunuz.Dialogue: 50,0:12:20.34,0:12:23.22,Main-207-,,0,0,0,,Her halükârda, Grand Line'a girsek bile,Dialogue: 50,0:12:23.22,0:12:26.85,Main-207-,,0,0,0,,en iyisi, bulabildiğimiz tüm hazineyi toplayıp kaçmak.Dialogue: 50,0:12:26.85,0:12:29.81,Main-207-,,0,0,0,,One Piece'i bulacağım, çünkü şansım iyidir.Dialogue: 50,0:12:30.40,0:12:32.65,Main-207-,,0,0,0,,Nasıl bu kadar özgüvenlisin, merak ediyorum?Dialogue: 50,0:12:32.98,0:12:35.61,Main-207-,,0,0,0,,Kesinlikle bulacağım, sadece izle!Dialogue: 50,0:12:35.61,0:12:37.19,Main-207-,,0,0,0,,Sen bilirsin...Dialogue: 50,0:12:39.45,0:12:40.53,Main-207-,,0,0,0,,O bakış...Dialogue: 50,0:12:41.45,0:12:45.41,Main-207-,,0,0,0,,Yüzün tıpkı benimki gibi. Sanki ikizmişiz gibi.Dialogue: 50,0:12:45.41,0:12:47.58,Main-207-,,0,0,0,,Neresi benziyor?!Dialogue: 50,0:12:48.08,0:12:49.46,Main-207-,,0,0,0,,Hislerini anlıyorum!Dialogue: 50,0:12:49.46,0:12:51.46,Main-207-,,0,0,0,,Bir gün hayallerimize ulaşacaktık.Dialogue: 50,0:12:51.46,0:12:53.84,Main-207-,,0,0,0,,Biz hep buna inandık!Dialogue: 50,0:12:54.46,0:12:55.67,Main-207-,,0,0,0,,"Biz"?Dialogue: 50,0:12:55.67,0:12:59.05,Main-207-,,0,0,0,,Hazine uğruna canımızı hiçe saymaya hazırdık!Dialogue: 50,0:12:59.05,0:13:02.89,Main-207-,,0,0,0,,O ateşli tutku, hayatımı alt üst etti.Dialogue: 50,0:13:02.89,0:13:04.39,Main-207-,,0,0,0,,B-Bekle, sen ne–Dialogue: 50,0:13:04.39,0:13:07.56,Main-207-,,0,0,0,,Her şey yirmi yıl önce başladı.Dialogue: 50,0:13:07.56,0:13:10.81,Main-207-,,0,0,0,,Tayfam ve ben, bu adaya ayak bastık.Dialogue: 50,0:13:12.23,0:13:15.73,Main-207-,,0,0,0,,Burada gizli olduğu söylenen hazineyi arıyorduk.Dialogue: 50,0:13:19.28,0:13:23.24,Flashbacks-207-,,0,0,0,,200 kişi bu adayı tam bir ay boyunca aradık,Dialogue: 50,0:13:23.87,0:13:26.83,Flashbacks-207-,,0,0,0,,ama bu boş sandık bulduğumuz tek şeydi!Dialogue: 50,0:13:27.29,0:13:28.83,Flashbacks-207-,,0,0,0,,Hazırlanın beyler, gidiyoruz!Dialogue: 50,0:13:28.83,0:13:29.83,Flashbacks-207-,,0,0,0,,– Evet! – Anlaşıldı!Dialogue: 50,0:13:32.42,0:13:34.84,Flashbacks-207-,,0,0,0,,Ne bekliyorsun, Gaimon? Ayrılıyoruz.Dialogue: 50,0:13:34.84,0:13:36.00,Flashbacks-207-,,0,0,0,,Tamam.Dialogue: 50,0:13:38.84,0:13:41.97,FlashbackThoughts-207-,,0,0,0,,Yukarısını kimse aradı mı acaba?Dialogue: 50,0:13:41.97,0:13:44.85,FlashbackThoughts-207-,,0,0,0,,Kaptan buraları bir ay aradı ama...Dialogue: 50,0:13:47.60,0:13:49.60,FlashbackThoughts-207-,,0,0,0,,yine de emin olmak lazım.Dialogue: 50,0:13:56.02,0:13:58.57,Main-207-,,0,0,0,,Gözlerime inanamadım.Dialogue: 50,0:13:59.03,0:14:01.70,Flashbacks-207-,,0,0,0,,B-Buldum! Buradaymış!Dialogue: 50,0:14:01.70,0:14:04.49,Flashbacks-207-,,0,0,0,,Hey! Millet!Dialogue: 50,0:14:14.29,0:14:16.75,Main-207-,,0,0,0,,İşte o an bu kutuya sıkışıp kaldım.Dialogue: 50,0:14:17.92,0:14:21.38,Main-207-,,0,0,0,,Kendime geldiğimde, arkadaşlarım çoktan yelken açmıştı.Dialogue: 50,0:14:22.97,0:14:24.55,Flashbacks-207-,,0,0,0,,Her şeyi batırdım!Dialogue: 50,0:14:25.84,0:14:27.22,Flashbacks-207-,,0,0,0,,Dur bir dakika.Dialogue: 50,0:14:27.22,0:14:30.56,Flashbacks-207-,,0,0,0,,Bu, bütün hazine bana kaldı demek, değil mi?Dialogue: 50,0:14:32.06,0:14:34.06,Flashbacks-207-,,0,0,0,,Ah! Bu şekilde tırmanamam!Dialogue: 50,0:14:34.06,0:14:37.31,Flashbacks-207-,,0,0,0,,Çıkamıyorum! Sıkıştım, kahretsin!Dialogue: 50,0:14:39.23,0:14:43.18,Flashbacks-207-,,0,0,0,,Hey! Geri dönün!Dialogue: 50,0:14:43.20,0:14:44.74,Main-207-,,0,0,0,,O günden beri,Dialogue: 50,0:14:44.74,0:14:49.91,Main-207-,,0,0,0,,hazineyi bir an bile aklımdan çıkaramadım.Dialogue: 50,0:14:49.91,0:14:53.79,Main-207-,,0,0,0,,Sayısız korsan bu adaya zenginlik bulmaya geldi,Dialogue: 50,0:14:53.79,0:14:56.67,Main-207-,,0,0,0,,ama hayvan dostlarımın da yardımıyla hepsini kovdum.Dialogue: 50,0:14:56.67,0:15:02.01,Main-207-,,0,0,0,,Yirmi yıl boyunca, bu şekilde hazineyi korudum.Dialogue: 50,0:15:02.59,0:15:03.92,Main-207-,,0,0,0,,O bana ait!Dialogue: 50,0:15:03.92,0:15:05.68,Main-207-,,0,0,0,,Evet, hiç şüphesiz.Dialogue: 50,0:15:05.68,0:15:07.14,Main-207-,,0,0,0,,O hazine senin.Dialogue: 50,0:15:07.14,0:15:08.97,Main-207-,,0,0,0,,Bunu bize bırak, Gaimon-san.Dialogue: 50,0:15:08.97,0:15:12.35,Main-207-,,0,0,0,,O hazineyi senin için alacağız.Dialogue: 50,0:15:13.18,0:15:14.56,Main-207-,,0,0,0,,G-Gerçekten mi?!Dialogue: 50,0:15:13.68,0:15:14.56,Secondary-207-,,0,0,0,,Tabii.Dialogue: 50,0:15:14.89,0:15:15.81,Main-207-,,0,0,0,,Yoksa...Dialogue: 50,0:15:16.19,0:15:19.11,Main-207-,,0,0,0,,Sen korsanlardan çalan bir hırsız değil misin?Dialogue: 50,0:15:19.11,0:15:20.27,Main-207-,,0,0,0,,Kabalık etme!Dialogue: 50,0:15:20.90,0:15:23.28,Main-207-,,0,0,0,,Sonuçta, benim de hislerim var.Dialogue: 50,0:15:47.55,0:15:48.76,Main-207-,,0,0,0,,Burası, ha?Dialogue: 50,0:15:48.76,0:15:51.68,Main-207-,,0,0,0,,Ben de uzun süredir buraya gelmedim.Dialogue: 50,0:15:55.39,0:15:57.77,Main-207-,,0,0,0,,Sonunda vakti geldi.Dialogue: 50,0:15:57.77,0:15:58.94,Main-207-,,0,0,0,,Bugün harika bir gün!Dialogue: 50,0:15:58.94,0:16:00.44,Main-207-,,0,0,0,,Sana güveniyorum, Hasır Şapka!Dialogue: 50,0:16:00.44,0:16:01.06,Main-207-,,0,0,0,,Peki!Dialogue: 50,0:16:01.06,0:16:02.52,Main-207-,,0,0,0,,Lastik-Lastik...Dialogue: 50,0:16:06.15,0:16:09.28,Main-207-,,0,0,0,,Roket!Dialogue: 50,0:16:09.87,0:16:12.12,Main-207-,,0,0,0,,Huh-huu!Dialogue: 50,0:16:18.29,0:16:20.13,Main-207-,,0,0,0,,Eee? Orada mı?Dialogue: 50,0:16:25.63,0:16:28.09,Main-207-,,0,0,0,,Burada! Beş hazine sandığı!Dialogue: 50,0:16:28.09,0:16:29.84,Main-207-,,0,0,0,,B-Başardım!Dialogue: 50,0:16:32.43,0:16:36.18,Main-207-,,0,0,0,,Nihayet hazinemi aldım! Başardım!Dialogue: 50,0:16:36.18,0:16:37.85,Main-207-,,0,0,0,,Onları aşağı fırlatabilir misin?Dialogue: 50,0:16:37.85,0:16:40.94,Main-207-,,0,0,0,,Hazinemi bana at! Çabuk!Dialogue: 50,0:16:40.94,0:16:41.69,Main-207-,,0,0,0,,Hayır.Dialogue: 50,0:16:41.69,0:16:42.98,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:16:44.32,0:16:47.03,Main-207-,,0,0,0,,Vermek istemiyorum.Dialogue: 50,0:16:47.03,0:16:48.82,Main-207-,,0,0,0,,Ne saçmalıyorsun sen?Dialogue: 50,0:16:48.82,0:16:50.36,Main-207-,,0,0,0,,Kes şakayı.Dialogue: 50,0:16:55.45,0:16:57.41,Main-207-,,0,0,0,,Kes şunu, Luffy!Dialogue: 50,0:16:57.41,0:16:58.79,Main-207-,,0,0,0,,Sorun değil.Dialogue: 50,0:16:59.96,0:17:01.12,Main-207-,,0,0,0,,Artık önemi yok.Dialogue: 50,0:17:01.12,0:17:02.21,Main-207-,,0,0,0,,Nasıl yok ya?!Dialogue: 50,0:17:02.21,0:17:06.42,Main-207-,,0,0,0,,Doğru, senin yirmi yıldır koruduğun hazine bu!Dialogue: 50,0:17:07.84,0:17:10.05,Main-207-,,0,0,0,,Hasır Şapka, sen...Dialogue: 50,0:17:10.05,0:17:12.39,Main-207-,,0,0,0,,çok iyi bir insansın.Dialogue: 50,0:17:13.18,0:17:14.60,Main-207-,,0,0,0,,Ne demek istiyorsun?Dialogue: 50,0:17:15.43,0:17:19.77,Main-207-,,0,0,0,,Aklımın bir köşesinde hep bu küçük şüphe vardı.Dialogue: 50,0:17:19.77,0:17:22.94,Main-207-,,0,0,0,,Ama onu düşünmemek için çabaladım.Dialogue: 50,0:17:24.27,0:17:26.32,Main-207-,,0,0,0,,Boşlar, değil mi?Dialogue: 50,0:17:28.61,0:17:29.82,Main-207-,,0,0,0,,Evet.Dialogue: 50,0:17:29.82,0:17:31.41,Main-207-,,0,0,0,,Hepsi boş.Dialogue: 50,0:17:31.41,0:17:32.57,Main-207-,,0,0,0,,Çok kötü...Dialogue: 50,0:17:32.57,0:17:36.99,Main-207-,,0,0,0,,Yirmi yıl boyunca koruduğun hazine sadece birkaç boş kutudan ibaretmiş.Dialogue: 50,0:17:36.99,0:17:41.71,Main-207-,,0,0,0,,Hazine haritasında bulunan her hazinede böyle şeyler olur.Dialogue: 50,0:17:42.08,0:17:45.17,Main-207-,,0,0,0,,Haritayı takip edersin, ama ganimet çoktan gitmiştir.Dialogue: 50,0:17:45.17,0:17:48.92,Main-207-,,0,0,0,,Hazine avcılığını korsanlar için bu kadar acımasız yapan da budur.Dialogue: 50,0:17:49.42,0:17:53.76,Main-207-,,0,0,0,,Ömür boyu beklersin, hatta ölürsün, ama yine de ulaşamazsın.Dialogue: 50,0:17:53.76,0:17:56.18,Main-207-,,0,0,0,,Sayısız korsan bu kaderi yaşadı.Dialogue: 50,0:17:58.89,0:18:01.39,Main-207-,,0,0,0,,İyi tarafından bak, ihtiyar.Dialogue: 50,0:18:01.39,0:18:03.65,Main-207-,,0,0,0,,Şanslısın ki, yirmi yıl sonra geldik.Dialogue: 50,0:18:03.98,0:18:06.94,Main-207-,,0,0,0,,Bir otuz yıl daha bekleseydin, ölebilirdin.Dialogue: 50,0:18:07.98,0:18:09.32,Main-207-,,0,0,0,,Hasır Şapka...Dialogue: 50,0:18:09.32,0:18:10.24,Main-207-,,0,0,0,,Luffy...Dialogue: 50,0:18:10.24,0:18:11.32,Main-207-,,0,0,0,,O...Dialogue: 50,0:18:11.32,0:18:13.45,Main-207-,,0,0,0,,Böyle bir başarısızlığın ardından,Dialogue: 50,0:18:13.45,0:18:15.78,Main-207-,,0,0,0,,One Piece'in peşinden gitmekten zarar gelmez.Dialogue: 50,0:18:15.78,0:18:18.41,Main-207-,,0,0,0,,Bizimle gel ve tekrar bir korsan ol!Dialogue: 50,0:18:18.41,0:18:22.54,Main-207-,,0,0,0,,Beni gerçekten davet mi ediyorsun?Dialogue: 50,0:18:23.42,0:18:25.38,Main-207-,,0,0,0,,Bütün bu olanlardan sonra...Dialogue: 50,0:18:25.38,0:18:28.38,Main-207-,,0,0,0,,kimse benimle konuşmayı bırak, bana ikinci kez bile bakmazdı.Dialogue: 50,0:18:29.05,0:18:32.34,Main-207-,,0,0,0,,Birine güvenmeyeli ne kadar zaman oldu?Dialogue: 50,0:18:38.81,0:18:40.68,Main-207-,,0,0,0,,Teşekkür ederim!Dialogue: 50,0:18:51.82,0:18:54.82,Main-207-,,0,0,0,,Gerçekten bu adada mı kalacaksın, ihtiyar?Dialogue: 50,0:18:54.82,0:18:56.16,Main-207-,,0,0,0,,Evet, Hasır Şapka.Dialogue: 50,0:18:56.16,0:19:00.12,Main-207-,,0,0,0,,Hazine burada olmasa bile, korumak istediğim kıymetli şeyler var.Dialogue: 50,0:19:00.12,0:19:01.24,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:19:01.24,0:19:02.62,Main-207-,,0,0,0,,Kıymetli şeyler mi?Dialogue: 50,0:19:04.54,0:19:08.59,Main-207-,,0,0,0,,Yirmi yıl boyunca iyi günde de kötü günde de onlarla yaşadım.Dialogue: 50,0:19:08.59,0:19:10.84,Main-207-,,0,0,0,,Şimdi onları terk edip gidemem.Dialogue: 50,0:19:18.51,0:19:23.18,Main-207-,,0,0,0,,Hazine olmadığını biliyorum artık, sonunda kendimi özgür hissediyorum.Dialogue: 50,0:19:23.18,0:19:26.56,Main-207-,,0,0,0,,Bundan sonra, özgürce hayatımı yaşayabilirim.Dialogue: 50,0:19:26.56,0:19:29.52,Main-207-,,0,0,0,,Aslında, kutuda yaşamaya alıştım diyebilirim.Dialogue: 50,0:19:29.52,0:19:31.53,Main-207-,,0,0,0,,Anlıyorum! Yazık oldu.Dialogue: 50,0:19:31.53,0:19:33.28,Main-207-,,0,0,0,,Çok havalısın.Dialogue: 50,0:19:33.28,0:19:35.53,Main-207-,,0,0,0,,Yani bu tuhaf hayvanlar, dostların mı?Dialogue: 50,0:19:36.07,0:19:38.28,Main-207-,,0,0,0,,Ama sen, hepsinden daha tuhaf bir hayvansın!Dialogue: 50,0:19:38.28,0:19:39.45,Main-207-,,0,0,0,,Ne dedin?!Dialogue: 50,0:19:49.21,0:19:50.59,Main-207-,,0,0,0,,Görüşürüz!Dialogue: 50,0:19:50.59,0:19:52.67,Main-207-,,0,0,0,,Kendine iyi bak!Dialogue: 50,0:19:52.67,0:19:54.51,Main-207-,,0,0,0,,Elveda!Dialogue: 50,0:19:57.34,0:19:58.84,Main-207-,,0,0,0,,Hasır Şapka...Dialogue: 50,0:19:58.84,0:20:02.35,Main-207-,,0,0,0,,Hayallerine ulaşmak için elinden geleni yap. Benim için de.Dialogue: 50,0:20:02.76,0:20:05.35,Main-207-,,0,0,0,,Eminim bulacaksın.Dialogue: 50,0:20:05.85,0:20:08.19,Main-207-,,0,0,0,,Efsanevi hazine, One Piece'i!Dialogue: 50,0:20:10.23,0:20:15.90,Main-207-,,0,0,0,,Ve sonra, dünyanın sahibi ol!Dialogue: 0,0:01:50.05,0:01:54.68,Title-207-,,0,0,0,,Sen Tuhaf Bir HayvansınDialogue: 1,0:01:50.05,0:01:54.68,Title-207-,,0,0,0,,Sen Tuhaf Bir HayvansınDialogue: 0,0:09:16.99,0:09:20.66,Captions-207-,,0,0,0,,Gaimon Ada SakiniDialogue: 1,0:09:16.99,0:09:20.66,Captions-207-,,0,0,0,,Gaimon Ada SakiniDialogue: 2,0:09:16.99,0:09:20.66,Captions-207-,,0,0,0,,Gaimon Ada SakiniDialogue: 0,0:13:34.88,0:13:36.96,Captions-207-,,0,0,0,,Gaimon (20 Yıl Önce)Dialogue: 1,0:13:34.88,0:13:36.96,Captions-207-,,0,0,0,,Gaimon (20 Yıl Önce)Dialogue: 2,0:13:34.88,0:13:36.96,Captions-207-,,0,0,0,,Gaimon (20 Yıl Önce)Dialogue: 0,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 1,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 0,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Feeso Galaxy 9000 ZenefDialogue: 1,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Feeso Galaxy 9000 ZenefDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,MüzikDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,MüzikDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,HaleeDialogue: 1,0:00:04.28,0:00:06.78,Credits-207