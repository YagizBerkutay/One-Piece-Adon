,0,2,23,23,34,1Style: Lyrics,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,2,23,23,34,1Style: Karaoke,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,23,1Style: Kanji,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,146,1Style: Roger-Monologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1Style: Romaji ED,Josefin Sans,82,&H00FFFFFF,&H003592BE,&H00000000,&H64000000,0,0,0,0,100,100,0,0,1,0,4,8,10,10,20,1Style: Translation ED,Josefin Sans,82,&H00FFFFFF,&H000000FF,&H00FFFFFF,&H64000000,0,0,0,0,100,100,0,0,1,0,4,2,10,10,20,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Default,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:49.96,0:01:59.95,Default,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 50,0:01:56.93,0:02:00.64,Main-207-,,0,0,0,,Böyle doğrudan Grand Line'a gitmek pervasızlık olur!Dialogue: 50,0:02:04.02,0:02:06.77,Main-207-,,0,0,0,,Evet, önce biraz et yemeliyiz.Dialogue: 50,0:02:07.73,0:02:10.44,Main-207-,,0,0,0,,Tüm yediğimiz meyve...Dialogue: 50,0:02:10.44,0:02:11.94,Main-207-,,0,0,0,,Sake de iyi olurdu!Dialogue: 50,0:02:12.70,0:02:14.53,Main-207-,,0,0,0,,Ne diyorsunuz be?!Dialogue: 50,0:02:16.53,0:02:17.66,Main-207-,,0,0,0,,Onu demiyorum!Dialogue: 50,0:02:17.66,0:02:21.62,Main-207-,,0,0,0,,Grand Line'ın dünyadaki en tehlikeli yer olduğunu söylüyorum.Dialogue: 50,0:02:21.62,0:02:25.92,Main-207-,,0,0,0,,Orası, One Piece'in peşinde olan azılı korsanlarla dolu!Dialogue: 50,0:02:25.92,0:02:28.17,Main-207-,,0,0,0,,Ve kesinlikle güçlü gemileri vardır.Dialogue: 50,0:02:28.17,0:02:29.59,Main-207-,,0,0,0,,Yeni yoldaşlar da lazım.Dialogue: 50,0:02:29.96,0:02:33.93,Main-207-,,0,0,0,,Sadece insan gücü eksiğimiz yok, apaçık gemimiz de donanımlı değil.Dialogue: 50,0:02:33.93,0:02:36.30,Main-207-,,0,0,0,,Oraya güvenle varamayız.Dialogue: 50,0:02:36.84,0:02:38.68,Main-207-,,0,0,0,,Evet, bize bir aşçı lazım.Dialogue: 50,0:02:38.68,0:02:39.89,Main-207-,,0,0,0,,Ve bir müzisyen.Dialogue: 50,0:02:40.26,0:02:41.27,Main-207-,,0,0,0,,Müzisyen mi?!Dialogue: 50,0:02:42.89,0:02:44.73,Main-207-,,0,0,0,,Tam bir salaksın...Dialogue: 50,0:02:46.23,0:02:50.23,Main-207-,,0,0,0,,Eğer güneye doğru gidersek, iskan edilmiş küçük bir ada var.Dialogue: 50,0:02:50.23,0:02:54.78,Main-207-,,0,0,0,,Orada iyi bir gemi bulabilirsek çok iyi olur.Dialogue: 50,0:02:55.15,0:02:57.24,Main-207-,,0,0,0,,Pekâlâ! Et alma zamanı!Dialogue: 50,0:03:01.54,0:03:05.67,Main-207-,,0,0,0,,Hey millet! Korkunç bir şey oldu!Dialogue: 50,0:03:05.67,0:03:08.25,Main-207-,,0,0,0,,Korsanlar geliyor!Dialogue: 50,0:03:08.25,0:03:10.71,Main-207-,,0,0,0,,Korsanlar! Korsanlar!Dialogue: 50,0:03:10.71,0:03:13.67,Main-207-,,0,0,0,,Korsanlar geliyor!Dialogue: 50,0:03:13.67,0:03:16.34,Main-207-,,0,0,0,,Herkes kaçsın!Dialogue: 50,0:03:16.34,0:03:18.72,Main-207-,,0,0,0,,Korsanlar!Dialogue: 50,0:03:18.72,0:03:22.18,Main-207-,,0,0,0,,Herkes kaçsın!Dialogue: 50,0:03:22.18,0:03:24.06,Main-207-,,0,0,0,,Mahvolduk!Dialogue: 50,0:03:26.98,0:03:28.60,Main-207-,,0,0,0,,Korsanlar...!Dialogue: 50,0:03:30.90,0:03:33.11,Main-207-,,0,0,0,,Korsanlarla ilgili söylediklerim...Dialogue: 50,0:03:33.82,0:03:35.11,Main-207-,,0,0,15,,şakaydı!Dialogue: 50,0:03:37.70,0:03:40.45,Main-207-,,0,0,0,,Ah...Dialogue: 50,0:03:41.08,0:03:42.49,Main-207-,,0,0,0,,Seni yalancı velet!Dialogue: 50,0:03:42.49,0:03:44.37,Main-207-,,0,0,0,,Bugün haddini bildireceğim!Dialogue: 50,0:03:47.81,0:03:51.21,Main-207-,,0,0,0,,İşte geliyorlar! Geliyorlar! Geliyorlar! Geliyorlar!Dialogue: 50,0:03:51.21,0:03:53.30,Main-207-,,0,0,0,,Buraya gel, seni küçük serseri!Dialogue: 50,0:03:55.05,0:03:57.26,Main-207-,,0,0,0,,Yakalayabilirseniz yakalayın!Dialogue: 50,0:03:58.43,0:04:00.51,Main-207-,,0,0,0,,Gelip beni yakalayın!Dialogue: 50,0:04:05.43,0:04:08.27,Main-207-,,0,0,0,,Kahretsin! Yine kaçtı!Dialogue: 50,0:04:09.02,0:04:11.52,Main-207-,,0,0,0,,Tam bir baş belası!Dialogue: 50,0:04:11.52,0:04:13.65,Main-207-,,0,0,0,,Eğer onu yakalarsam...Dialogue: 50,0:04:14.03,0:04:16.40,Main-207-,,0,0,0,,Nereye gitti bu?!Dialogue: 50,0:04:26.20,0:04:28.08,Main-207-,,0,0,0,,Harika bir işti!Dialogue: 50,0:04:28.08,0:04:32.21,Main-207-,,0,0,0,,Bu sıkıcı köye biraz hayat verdim!Dialogue: 50,0:04:32.96,0:04:34.09,Main-207-,,0,0,0,,Ah, orada işte!Dialogue: 50,0:04:35.80,0:04:37.22,Main-207-,,0,0,0,,Oh, sizsiniz!Dialogue: 50,0:04:37.76,0:04:40.05,Main-207-,,0,0,0,,Günaydın, Kaptan Usopp!Dialogue: 50,0:04:40.30,0:04:43.43,Main-207-,,0,0,1,,Usopp Korsanları vardı!Dialogue: 50,0:04:45.56,0:04:46.81,Main-207-,,0,0,0,,Piiman! Ninjin!Dialogue: 50,0:04:46.81,0:04:49.44,Main-207-,,0,0,0,,Sadece siz mi varsınız? Tamanegi nerede?Dialogue: 50,0:04:53.06,0:04:56.65,Main-207-,,0,0,0,,Korkunç! Mahvolduk!Dialogue: 50,0:04:56.65,0:04:57.40,Main-207-,,0,0,0,,Ah!Dialogue: 50,0:04:58.82,0:04:59.99,Main-207-,,0,0,0,,Korkunç!Dialogue: 50,0:05:00.53,0:05:01.78,Main-207-,,0,0,0,,Tamanegi...Dialogue: 50,0:05:01.78,0:05:03.87,Main-207-,,0,0,0,,Ne diye bu kadar telaşlı?Dialogue: 50,0:05:03.87,0:05:06.20,Main-207-,,0,0,0,,Korkunç! Çok kötü!Dialogue: 50,0:05:06.20,0:05:07.54,Main-207-,,0,0,0,,Ayvayı yedik!Dialogue: 50,0:05:07.54,0:05:09.12,Main-207-,,0,0,0,,K-Korsanlar geliyor!Dialogue: 50,0:05:09.12,0:05:12.71,Main-207-,,0,0,0,,Kuzey kıyısında kuru kafa işareti olan bir tekne var!Dialogue: 50,0:05:12.71,0:05:13.75,Main-207-,,0,0,0,,Yalan!Dialogue: 50,0:05:15.92,0:05:17.51,Main-207-,,0,0,0,,Doğru!Dialogue: 50,0:05:17.51,0:05:19.76,Main-207-,,0,0,0,,D-Doğru mu?Dialogue: 50,0:05:20.09,0:05:22.26,Main-207-,,0,0,0,,Doğru! Çok kötü!Dialogue: 50,0:05:23.01,0:05:24.51,Main-207-,,0,0,0,,Tüh!Dialogue: 50,0:05:24.51,0:05:26.35,Main-207-,,0,0,0,,Atıştırma vakti!Dialogue: 50,0:05:26.35,0:05:27.31,Main-207-,,0,0,0,,– Kaçma! – Kaçma!Dialogue: 50,0:05:28.52,0:05:33.56,Main-207-,,0,0,0,,Aslında, "Atıştırmalık yemezsem ölürüm" hastalığım nüksetti!Dialogue: 50,0:05:34.73,0:05:36.19,Main-207-,,0,0,0,,– Yalancı! – Yalancı!Dialogue: 50,0:05:36.82,0:05:40.78,Main-207-,,0,0,0,,Kaptan, gerçek bir korsan olmak istemiyor muydun?!Dialogue: 50,0:05:41.32,0:05:44.45,Main-207-,,0,0,0,,Korsanlardan korkan bir korsan ne işe yarar ki?!Dialogue: 50,0:05:44.91,0:05:48.16,Main-207-,,0,0,0,,Palyaço Buggy'nin işaretini gördüm!Dialogue: 50,0:05:48.16,0:05:52.42,Main-207-,,0,0,0,,P-P-Palyaço Buggy mi?!Dialogue: 50,0:05:53.67,0:05:56.00,Main-207-,,0,0,0,,En iyisi...Dialogue: 50,0:05:56.00,0:05:58.71,Main-207-,,0,0,0,,Ama sadece 2 küçük tekne vardı!Dialogue: 50,0:05:59.71,0:06:02.80,Main-207-,,0,0,0,,3 kişi sayabildim...Dialogue: 50,0:06:02.80,0:06:08.39,Main-207-,,0,0,0,,Pekâlâ, hazırlanalım, Usopp Korsanları! Huzurlu köyümüzü koruyacağız!Dialogue: 50,0:06:08.39,0:06:10.85,Main-207-,,0,0,0,,Gidelim! Beni takip edin!Dialogue: 50,0:06:08.22,0:06:09.14,Secondary-207-,,0,0,0,,– Ha? – Ha?Dialogue: 50,0:06:11.85,0:06:13.64,Main-207-,,0,0,0,,– B-Başüstüne! – B-Başüstüne!Dialogue: 50,0:06:21.82,0:06:24.82,Main-207-,,0,0,0,,Sonunda tekrar karaya çıktık.Dialogue: 50,0:06:26.03,0:06:27.87,Main-207-,,0,0,0,,Köy o tarafta mı?Dialogue: 50,0:06:27.87,0:06:28.91,Main-207-,,0,0,0,,Evet.Dialogue: 50,0:06:28.91,0:06:31.16,Main-207-,,0,0,0,,Küçük bir köy gibi görünüyor...Dialogue: 50,0:06:31.16,0:06:31.79,Main-207-,,0,0,0,,Oh!Dialogue: 50,0:06:31.79,0:06:34.42,Main-207-,,0,0,0,,Bu et var demek! Et, et, et!Dialogue: 50,0:06:34.42,0:06:36.29,Main-207-,,0,0,0,,Yiyecekleri var, değil mi?!Dialogue: 50,0:06:36.29,0:06:38.38,Main-207-,,0,0,0,,Et ile derdin ne senin?!Dialogue: 50,0:06:41.05,0:06:42.55,Main-207-,,0,0,0,,Dikkatli olun!Dialogue: 50,0:06:42.88,0:06:44.59,Main-207-,,0,0,0,,Misafirimiz var.Dialogue: 50,0:06:43.80,0:06:44.59,Secondary-207-,,0,0,0,,Ha?!Dialogue: 50,0:06:44.59,0:06:46.39,Main-207-,,0,0,0,,Nerede?! Nerede?! Nerede?!Dialogue: 50,0:06:46.97,0:06:48.43,Main-207-,,0,0,0,,Dikkat et!Dialogue: 50,0:06:59.11,0:07:02.69,Main-207-,,0,0,0,,Harika!Dialogue: 50,0:07:00.44,0:07:02.69,Secondary-207-,,0,0,0,,Etkilenmenin zamanı mı?!Dialogue: 50,0:07:05.32,0:07:09.70,Main-207-,,0,0,0,,Ben, bu köyde hüküm süren büyük korsanların lideri, Usopp'um!Dialogue: 50,0:07:09.70,0:07:12.91,Main-207-,,0,0,0,,Herkes beni överken ve bana hitap ederken...Dialogue: 50,0:07:13.29,0:07:15.41,Main-207-,,0,0,0,,Kaptan Usopp der!Dialogue: 50,0:07:17.83,0:07:21.34,Main-207-,,0,0,0,,Eğer bu köye saldırmayı düşünüyorsanız, vazgeçin!Dialogue: 50,0:07:21.34,0:07:26.55,Main-207-,,0,0,0,,Yoksa, 80 milyon astım sessizce durmayacak!Dialogue: 50,0:07:26.55,0:07:31.01,Main-207-,,0,0,0,,İnanılmaz!!!Dialogue: 50,0:07:32.39,0:07:33.93,Main-207-,,0,0,0,,Yalancısın, değil mi?Dialogue: 50,0:07:34.85,0:07:35.98,Main-207-,,0,0,0,,Anladı!Dialogue: 50,0:07:35.98,0:07:38.73,Main-207-,,0,0,0,,Ah, demek kabul ediyorsun.Dialogue: 50,0:07:40.06,0:07:43.69,Main-207-,,0,0,0,,Ona itiraf ettim!Dialogue: 50,0:07:45.90,0:07:48.24,Main-207-,,0,0,0,,Ne?! Yalan mıydı?!Dialogue: 50,0:07:48.24,0:07:49.70,Main-207-,,0,0,0,,Seni uyanık...!Dialogue: 50,0:07:50.32,0:07:54.66,Main-207-,,0,0,0,,80 milyon belki abartı ama adamlarım oldukça güçlüdür!Dialogue: 50,0:08:01.42,0:08:03.80,Main-207-,,0,0,0,,Sadece üçü mü?Dialogue: 50,0:08:05.21,0:08:07.26,Main-207-,,0,0,0,,– Öğrendi! – Öğrendi!Dialogue: 50,0:08:07.26,0:08:09.97,Main-207-,,0,0,0,,T-Topuklayın!Dialogue: 50,0:08:09.97,0:08:11.97,Main-207-,,0,0,0,,H-Hey, siz!Dialogue: 50,0:08:11.97,0:08:14.22,Main-207-,,0,0,0,,Kaçmayın!Dialogue: 50,0:08:15.89,0:08:17.94,Main-207-,,0,0,0,,Çok komiksin!Dialogue: 50,0:08:18.98,0:08:20.40,Main-207-,,0,0,0,,Hey, sen!Dialogue: 50,0:08:20.40,0:08:21.90,Main-207-,,0,0,0,,Beni aşağılama!Dialogue: 50,0:08:21.90,0:08:24.73,Main-207-,,0,0,0,,Ben çok gururlu biriyimdir!Dialogue: 50,0:08:25.44,0:08:28.74,Main-207-,,0,0,0,,Sahip olduğum gurur yüzünden, herkes bana...Dialogue: 50,0:08:29.49,0:08:32.20,Main-207-,,0,0,0,,"Gururlu Usopp" der!Dialogue: 50,0:08:33.37,0:08:35.08,Main-207-,,0,0,0,,Az önce şahit oldun!Dialogue: 50,0:08:35.45,0:08:40.92,Main-207-,,0,0,0,,Sapan becerim, sıradan bir tabancadan çok daha üstün!Dialogue: 50,0:08:47.80,0:08:50.80,Main-207-,,0,0,0,,Silahını çektiğine göre...Dialogue: 50,0:08:50.80,0:08:52.43,Main-207-,,0,0,0,,hayatını riske atıyorsun.Dialogue: 50,0:08:54.64,0:08:58.39,Main-207-,,0,0,0,,Onlar insanları tehdit etmek için kullanılmaz.Dialogue: 50,0:09:14.70,0:09:20.25,Main-207-,,0,0,0,,Düşündüğüm gibi, gerçek korsanların sözleri çok daha korkutucu...Dialogue: 50,0:09:20.25,0:09:21.62,Main-207-,,0,0,0,,İnanılmaz...Dialogue: 50,0:09:27.67,0:09:28.76,Main-207-,,0,0,0,,Alıntı yaptım!Dialogue: 50,0:09:29.88,0:09:33.22,Main-207-,,0,0,0,,Hayran olduğum bir korsan olan, Shanks'tan.Dialogue: 50,0:09:33.72,0:09:35.97,Main-207-,,0,0,0,,S-Shanks mı dedin?!Dialogue: 50,0:09:35.97,0:09:39.73,Main-207-,,0,0,0,,Ünlü korsan Kızıl Saçlı Shanks'ı tanıyor musun?!Dialogue: 50,0:09:40.06,0:09:41.23,Main-207-,,0,0,0,,Evet!Dialogue: 50,0:09:41.23,0:09:44.15,Main-207-,,0,0,0,, Babanın adı, Yasopp, değil mi?Dialogue: 50,0:09:44.15,0:09:46.15,Main-207-,,0,0,0,,N-Ne?!Dialogue: 50,0:09:51.70,0:09:52.78,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:09:53.16,0:09:57.91,Main-207-,,0,0,0,,Babamın adı Yasopp, doğru...Dialogue: 50,0:09:59.75,0:10:01.79,Main-207-,,0,0,0,,Ama nasıl biliyorsun?Dialogue: 50,0:10:11.38,0:10:12.80,Main-207-,,0,0,0,,Güzel, ha?Dialogue: 50,0:10:14.47,0:10:16.85,Main-207-,,0,0,0,,Çocukken babanla tanışmıştım.Dialogue: 50,0:10:16.85,0:10:19.56,Main-207-,,0,0,0,,Yani babam, Shanks'ın gemisinde mi?Dialogue: 50,0:10:19.56,0:10:24.56,Main-207-,,0,0,0,,Evet! Ona çok benziyorsun, görür görmez oğlu olduğunu düşündüm.Dialogue: 50,0:10:24.56,0:10:25.56,Main-207-,,0,0,0,,Sahi mi?!Dialogue: 50,0:10:26.31,0:10:29.57,Main-207-,,0,0,0,,Demek babam harika bir gemide, öyle mi?!Dialogue: 50,0:10:29.94,0:10:33.32,Main-207-,,0,0,0,,Emin değilim ama sanırım hâlâ gemide.Dialogue: 50,0:10:34.20,0:10:38.28,Main-207-,,0,0,0,,Ne de olsa baban, harika bir keskin nişancı!Dialogue: 50,0:10:54.18,0:10:56.64,Flashbacks-207-,,0,0,0,,Vay, inanılmaz!Dialogue: 50,0:10:56.64,0:10:57.64,Flashbacks-207-,,0,0,0,,Bu hiçbir şey.Dialogue: 50,0:10:57.64,0:11:01.14,Flashbacks-207-,,0,0,0,,Bir karıncayı tam gözlerinin arasından vurabilirim!Dialogue: 50,0:11:05.60,0:11:07.35,Flashbacks-207-,,0,0,0,,Biliyor musun, Luffy...?Dialogue: 50,0:11:07.35,0:11:11.23,Flashbacks-207-,,0,0,0,,Benim de Usopp adında, tam senin yaşlarında bir oğlum var!Dialogue: 50,0:11:11.23,0:11:13.74,Flashbacks-207-,,0,0,0,,Bunu bir milyon kez anlattın! Bıktım artık!Dialogue: 50,0:11:13.74,0:11:14.95,Flashbacks-207-,,0,0,0,,Ne dedin?!Dialogue: 50,0:11:16.70,0:11:19.91,Flashbacks-207-,,0,0,0,,Anlatmaya devam edeceğim!Dialogue: 50,0:11:20.66,0:11:24.62,Flashbacks-207-,,0,0,0,,Ayrılmak kalbimi kırdı ama başka seçeneğim yoktu.Dialogue: 50,0:11:24.62,0:11:29.63,Flashbacks-207-,,0,0,0,,Korsan bayrağı beni çağırıyordu! Başka ne sebep istersin ki?!Dialogue: 50,0:11:29.63,0:11:31.34,Flashbacks-207-,,0,0,0,,– Evet! – Evet!Dialogue: 50,0:11:35.17,0:11:38.30,Flashbacks-207-,,0,0,0,,Sıkıştı! Çıkmıyor!Dialogue: 50,0:11:39.93,0:11:45.06,Main-207-,,0,0,0,,Usopp, hakkında o kadar çok şey duydum ki anlatamam.Dialogue: 50,0:11:45.06,0:11:47.27,Main-207-,,0,0,0,,Yasopp harika bir korsan!Dialogue: 50,0:11:47.27,0:11:48.60,Main-207-,,0,0,0,,Öyle, ha?!Dialogue: 50,0:11:49.56,0:11:55.07,Main-207-,,0,0,0,,Kendi hayatını hiçe sayarak, engin ve sonsuz denize açılıyor...Dialogue: 50,0:11:55.07,0:11:57.78,Main-207-,,0,0,0,,Onunla daha fazla gurur duyamazdım!Dialogue: 50,0:11:57.78,0:11:59.78,Main-207-,,0,0,0,,O zaman bu işimizi kolaylaştırır!Dialogue: 50,0:12:00.37,0:12:03.58,Main-207-,,0,0,0,,Hey, bu köyde yelkenli ya da büyük bir gemi alabileceğimiz...Dialogue: 50,0:12:03.58,0:12:05.70,Main-207-,,0,0,0,,biri var mı?Dialogue: 50,0:12:06.91,0:12:09.67,Main-207-,,0,0,0,,Gördüğünüz gibi, bu köy oldukça küçük.Dialogue: 50,0:12:09.67,0:12:12.80,Main-207-,,0,0,0,,Üzgünüm ama isteğinizi karşılayamayız.Dialogue: 50,0:12:12.80,0:12:14.51,Main-207-,,0,0,0,,Tepenin üstünde...Dialogue: 50,0:12:14.51,0:12:16.97,Main-207-,,0,0,0,,büyük bir malikâne vardı.Dialogue: 50,0:12:16.97,0:12:19.34,Main-207-,,0,0,0,,Söyle! Onları tanıyor musun, Usopp?!Dialogue: 50,0:12:19.34,0:12:22.22,Main-207-,,0,0,0,,Bize finansal destek vermelerini isteyebilir miyiz?Dialogue: 50,0:12:22.22,0:12:23.85,Main-207-,,0,0,0,,O-Oraya gidemezsiniz!Dialogue: 50,0:12:26.10,0:12:29.56,Main-207-,,0,0,0,,Ş-Şimdi hatırladım da yapmam gereken bir şey var.Dialogue: 50,0:12:29.56,0:12:32.36,Main-207-,,0,0,0,,Bu dükkanın sahibini iyi tanıyorum,Dialogue: 50,0:12:32.36,0:12:35.07,Main-207-,,0,0,0,,istediğiniz gibi yiyip içebilirsiniz!Dialogue: 50,0:12:35.07,0:12:37.53,Main-207-,,0,0,0,,Pekâlâ! Sonra görüşürüz!Dialogue: 50,0:12:39.78,0:12:42.45,Main-207-,,0,0,0,,Neden bu kadar acele ediyordu?Dialogue: 50,0:12:47.25,0:12:48.71,Main-207-,,0,0,0,,Gerçekten burası mı?!Dialogue: 50,0:12:48.71,0:12:50.87,Main-207-,,0,0,0,,Evet, korsanlar onu içeri sürüklediler!Dialogue: 50,0:12:50.87,0:12:52.33,Main-207-,,0,0,0,,Onu kurtarmalıyız!Dialogue: 50,0:12:52.33,0:12:55.46,Main-207-,,0,0,0,,Ama onlar gerçek korsan! Onu ızgara yapıp yemiş olabilirler!Dialogue: 50,0:12:55.46,0:12:58.09,Main-207-,,0,0,0,,Aptal! İnsanları yiyen onibaba'dır.Dialogue: 50,0:12:55.46,0:12:58.09,Note-207-,,0,0,0,,"Onibaba": Japon folklorunda yaşlı kadın iblis/canavar.Dialogue: 50,0:12:59.01,0:13:04.31,Main-207-,,0,0,0,,Bu, Usopp Korsanları'nın kuruluşundan beri görülen en destansı savaş olacak!Dialogue: 50,0:13:04.31,0:13:05.56,Main-207-,,0,0,0,,– Evet! – Evet!Dialogue: 50,0:13:06.81,0:13:09.31,Main-207-,,0,0,0,,– Usopp Korsanları vardı! – Usopp Korsanları vardı!Dialogue: 50,0:13:09.77,0:13:10.77,Main-207-,,0,0,0,,Onlar da kim?Dialogue: 50,0:13:10.77,0:13:12.56,Main-207-,,0,0,0,,K-Kaptan yok!Dialogue: 50,0:13:12.56,0:13:13.65,Main-207-,,0,0,0,,Yoksa...Dialogue: 50,0:13:14.32,0:13:15.94,Main-207-,,0,0,0,,H-Hey, korsanlar!Dialogue: 50,0:13:15.94,0:13:18.65,Main-207-,,0,0,0,,Kaptan Usopp'a ne yaptınız?!Dialogue: 50,0:13:18.65,0:13:19.61,Main-207-,,0,0,0,,– Ne yaptınız? – Ne yaptınız?Dialogue: 50,0:13:20.11,0:13:22.57,Main-207-,,0,0,0,,Et çok lezzetliydi!Dialogue: 50,0:13:23.57,0:13:24.45,Main-207-,,0,0,0,,Et mi?!Dialogue: 50,0:13:24.45,0:13:26.04,Main-207-,,0,0,0,,Yoksa, kaptanı...Dialogue: 50,0:13:27.66,0:13:30.66,Main-207-,,0,0,0,,N-Ne?! Ne yaptınız?Dialogue: 50,0:13:30.66,0:13:33.13,Main-207-,,0,0,0,,Kaptanınızı arıyorsanız...Dialogue: 50,0:13:34.79,0:13:36.09,Main-207-,,0,0,0,,onu yedik.Dialogue: 50,0:13:39.42,0:13:42.76,Main-207-,,0,0,0,,– Onibaba! – Onibaba!Dialogue: 50,0:13:40.55,0:13:42.76,Main-207-,,0,0,0,,Niye bana bakıyorsunuz?!Dialogue: 50,0:13:44.72,0:13:47.10,Main-207-,,0,0,0,,Hepsi sizin aptallığınız yüzünden!Dialogue: 50,0:13:58.48,0:14:00.86,Main-207-,,0,0,0,,Usopp'u mu görmek istiyorsunuz?Dialogue: 50,0:14:01.57,0:14:03.45,Main-207-,,0,0,0,,Yine mi?Dialogue: 50,0:14:03.86,0:14:04.99,Main-207-,,0,0,15,,Görebilir miyim?Dialogue: 50,0:14:04.99,0:14:06.49,Main-207-,,0,0,15,,Onunla konuşmak istiyorum.Dialogue: 50,0:14:07.99,0:14:09.24,Main-207-,,0,0,15,,Olmaz.Dialogue: 50,0:14:09.24,0:14:11.79,Main-207-,,0,0,15,,O adam, köydeki bir numaralı yalancı.Dialogue: 50,0:14:12.33,0:14:14.29,Main-207-,,0,0,0,,Sizin durumunuzda,Dialogue: 50,0:14:14.29,0:14:17.46,Main-207-,,0,0,0,,Usopp'un saçma hikayeleri ihtiyacınız olan son şey!Dialogue: 50,0:14:17.46,0:14:21.88,Main-207-,,0,0,0,,Merhum anne ve babanız bana, elimden gelen en iyi şekilde...Dialogue: 50,0:14:21.88,0:14:25.22,Main-207-,,0,0,0,,sizinle ilgilenmem için güvendiler, Kaya hanımefendi.Dialogue: 50,0:14:25.89,0:14:28.56,Main-207-,,0,0,0,,Şimdi, ilacınızı buraya bırakıyorum.Dialogue: 50,0:14:28.56,0:14:30.14,Main-207-,,0,0,0,,Lütfen ihmal etmeyin.Dialogue: 50,0:14:34.69,0:14:36.02,Main-207-,,0,0,0,,Pinti.Dialogue: 50,0:14:36.02,0:14:38.19,Main-207-,,0,0,0,,İstediğiniz kadar "pinti" deyin.Dialogue: 50,0:14:38.19,0:14:40.03,Main-207-,,0,0,0,,Hayır, hayır demektir.Dialogue: 50,0:14:50.16,0:14:51.62,Main-207-,,0,0,0,,Usopp-san!Dialogue: 50,0:14:51.62,0:14:54.62,Main-207-,,0,0,0,,Selam! Her zamanki gibi moralsiz görünüyorsun!Dialogue: 50,0:14:55.12,0:14:56.50,Main-207-,,0,0,0,,Üzgünüm!Dialogue: 50,0:14:56.50,0:14:59.88,Main-207-,,0,0,0,,Seni gerçek bir misafir gibi içeri davet etmek isterdim...Dialogue: 50,0:15:00.63,0:15:04.01,Main-207-,,0,0,0,,ama ne olursa olsun, Klahadore buna izin vermiyor.Dialogue: 50,0:15:04.01,0:15:05.76,Main-207-,,0,0,0,,Yine de kötü biri değil o.Dialogue: 50,0:15:05.76,0:15:07.18,Main-207-,,0,0,0,,Dert etme!Dialogue: 50,0:15:07.18,0:15:10.68,Main-207-,,0,0,0,,Zaten ben, denizin cesur savaşçısıyım.Dialogue: 50,0:15:11.06,0:15:15.19,Main-207-,,0,0,0,,Boğucu bir malikânede rahat etmezdim.Dialogue: 50,0:15:15.44,0:15:18.44,Main-207-,,0,0,0,,Bugün bana hangi maceranı anlatacaksın?Dialogue: 50,0:15:18.44,0:15:21.19,Main-207-,,0,0,0,,Ehhh, bir bakalım...Dialogue: 50,0:15:21.19,0:15:22.48,Main-207-,,0,0,0,,Peki!Dialogue: 50,0:15:22.48,0:15:23.99,Main-207-,,0,0,0,,Beş yaşımdayken,Dialogue: 50,0:15:23.99,0:15:27.07,Main-207-,,0,0,0,,güney denizlerinde yaşayan dev bir japon balığıyla savaştım.Dialogue: 50,0:15:27.07,0:15:28.16,Main-207-,,0,0,0,,Japon balığı mı?!Dialogue: 50,0:15:28.41,0:15:29.45,Main-207-,,0,0,0,,Evet!Dialogue: 50,0:15:29.45,0:15:31.62,Main-207-,,0,0,0,,Beni en çok şaşırtan şey,Dialogue: 50,0:15:31.62,0:15:33.29,Main-207-,,0,0,0,,dışkılarının büyüklüğüydü!Dialogue: 50,0:15:33.29,0:15:37.37,Main-207-,,0,0,0,,O kadar büyüktü ki ada sanıp demir atmıştım.Dialogue: 50,0:15:52.39,0:15:55.52,Main-207-,,0,0,0,,Vay be! Kocaman!Dialogue: 50,0:15:55.52,0:15:58.81,Main-207-,,0,0,0,,Kaptan bu saatlerde kayboluyorsa, büyük ihtimalle burdadır.Dialogue: 50,0:15:58.81,0:16:01.77,Main-207-,,0,0,0,,Şey? Buraya niçin geliyor?Dialogue: 50,0:16:01.77,0:16:03.40,Main-207-,,0,0,0,,Yalan söylemek için!Dialogue: 50,0:16:03.40,0:16:05.07,Main-207-,,0,0,0,,Bu kötü bir şey!Dialogue: 50,0:16:05.07,0:16:07.78,Main-207-,,0,0,0,,O kötü değil! Harika biri! Değil mi?!Dialogue: 50,0:16:07.78,0:16:09.16,Main-207-,,0,0,0,,Evet! O harika biri!Dialogue: 50,0:16:09.53,0:16:11.41,Main-207-,,0,0,0,,Nasıl oluyor?Dialogue: 50,0:16:12.37,0:16:15.95,Main-207-,,0,0,0,,Kaya hanımefendi, o malikânede yaşıyor ve çok hasta.Dialogue: 50,0:16:15.95,0:16:20.88,Main-207-,,0,0,0,,Bir sene önce, ailesi bir hastalık yüzünden öldü ve o zamandan beri depresyonda.Dialogue: 50,0:16:21.42,0:16:25.71,Main-207-,,0,0,0,,Onca parasına rağmen, onu neşelendirebilecek hiçbir şey yoktu.Dialogue: 50,0:16:13.33,0:16:15.04,Secondary-207-,,0,0,0,,Bir japon balığı...Dialogue: 50,0:16:15.04,0:16:19.67,Secondary-207-,,0,0,0,,geminin önünü kesti ve o gemide dağdan daha uzun bir korsan vardı!Dialogue: 50,0:16:19.67,0:16:22.17,Secondary-207-,,0,0,0,,Suratı çok komikti!Dialogue: 50,0:16:26.63,0:16:30.59,Main-207-,,0,0,0,,Kaptanımız, onu güldüren abartılı hikâyeler anlatmakta harikadır.Dialogue: 50,0:16:30.93,0:16:34.06,Main-207-,,0,0,0,,Yalan söylemede üstüne yok!Dialogue: 50,0:16:34.06,0:16:36.98,Secondary-207-,,0,0,0,,Böyle bir yüze sahip korsanı hiç duymadın, değil mi?Dialogue: 50,0:16:37.52,0:16:39.48,Main-207-,,0,0,0,,Yani o iyi biri mi?Dialogue: 50,0:16:39.48,0:16:40.69,Main-207-,,0,0,0,,– Evet! – Evet!Dialogue: 50,0:16:40.69,0:16:44.44,Main-207-,,0,0,0,,Kaptanı seviyorum çünkü meraklı!Dialogue: 50,0:16:44.44,0:16:46.94,Main-207-,,0,0,0,,Patronluk taslamasını seviyorum!Dialogue: 50,0:16:46.94,0:16:49.03,Main-207-,,0,0,0,,Böbürlenmesini seviyorum!Dialogue: 50,0:16:49.40,0:16:52.41,Main-207-,,0,0,0,,Ve bu onun daha iyi hissetmesini mi sağlıyor?Dialogue: 50,0:16:52.41,0:16:54.03,Main-207-,,0,0,0,,Evet, çok daha iyi!Dialogue: 50,0:16:54.03,0:16:55.29,Main-207-,,0,0,0,,Güzel!Dialogue: 50,0:16:55.29,0:16:57.87,Main-207-,,0,0,0,,Öyleyse gidip ondan gemi isteyelim!Dialogue: 50,0:16:58.33,0:17:00.46,Main-207-,,0,0,0,,Sadece içeri girmek bile imkansız!Dialogue: 50,0:17:00.46,0:17:02.75,Main-207-,,0,0,0,,Kapı muhafızları gerçekten çok güçlü!Dialogue: 50,0:17:03.34,0:17:04.04,Main-207-,,0,0,0,,– Ha? – Ha?Dialogue: 50,0:17:04.04,0:17:05.05,Main-207-,,0,0,0,,Luffy nerede?Dialogue: 50,0:17:05.05,0:17:06.59,Main-207-,,0,0,0,,Gidip soracağım!Dialogue: 50,0:17:07.26,0:17:08.38,Main-207-,,0,0,0,,Yoksa sen...?Dialogue: 50,0:17:08.38,0:17:11.13,Main-207-,,0,0,0,,Lastik-Lastik...Dialogue: 50,0:17:12.93,0:17:16.39,Main-207-,,0,0,0,,İçeri daldığım için...Dialogue: 50,0:17:13.85,0:17:14.76,Secondary-207-,,0,0,0,,Hey!Dialogue: 50,0:17:16.39,0:17:20.14,Main-207-,,0,0,0,,...üzgünüm!!!Dialogue: 50,0:17:21.23,0:17:27.82,Main-207-,,0,0,0,,Sonra dev bir sapan kullanarak gökyüzüne kaçtık!Dialogue: 50,0:17:28.53,0:17:30.07,Main-207-,,0,0,0,,O...?Dialogue: 50,0:17:31.49,0:17:33.32,Main-207-,,0,0,0,,Yaşasın!Dialogue: 50,0:17:39.29,0:17:41.08,Main-207-,,0,0,0,,Giriş başarılı!Dialogue: 50,0:17:41.08,0:17:43.29,Main-207-,,0,0,0,,İ-İyi misiniz?Dialogue: 50,0:17:43.29,0:17:45.92,Main-207-,,0,0,0,,Evet! Onlar iyi! Endişelenme!Dialogue: 50,0:17:45.92,0:17:49.17,Main-207-,,0,0,0,,Namımı duydular ve Usopp Korsanları'na katılmak için...Dialogue: 50,0:17:49.17,0:17:51.76,Main-207-,,0,0,0,,onca yolu katettiler!Dialogue: 50,0:17:52.13,0:17:54.76,Main-207-,,0,0,0,,Ha? Hayır, öyle değil.Dialogue: 50,0:17:55.14,0:17:56.93,Main-207-,,0,0,0,,Bir iyilik istemek için geldik!Dialogue: 50,0:17:56.93,0:17:58.56,Main-207-,,0,0,0,,İyilik? Benden mi?Dialogue: 50,0:17:58.56,0:17:59.39,Main-207-,,0,0,0,,Evet!Dialogue: 50,0:17:59.77,0:18:02.89,Main-207-,,0,0,0,,Büyük bir gemi istiyoruz...Dialogue: 50,0:18:01.27,0:18:02.89,Main-207-,,0,0,0,,Hey, siz!Dialogue: 50,0:18:03.98,0:18:06.11,Main-207-,,0,0,0,,Burada ne yapıyorsunuz?Dialogue: 50,0:18:07.61,0:18:09.86,Main-207-,,0,0,0,,Klahadore...Dialogue: 50,0:18:11.11,0:18:12.86,Main-207-,,0,0,0,,İzinsiz şekilde...Dialogue: 50,0:18:13.86,0:18:16.33,Main-207-,,0,0,0,,buraya girmenizi hoş karşılamıyorum!Dialogue: 50,0:18:20.66,0:18:22.79,Main-207-,,0,0,0,,Bu insanlar–Dialogue: 50,0:18:21.71,0:18:22.79,Secondary-207-,,0,0,0,,Sırası değil.Dialogue: 50,0:18:24.25,0:18:27.88,Main-207-,,0,0,0,,Bahanenizi sonra dinlerim.Dialogue: 50,0:18:27.88,0:18:29.88,Main-207-,,0,0,0,,Şimdi hepiniz gidin!Dialogue: 50,0:18:29.88,0:18:32.34,Main-207-,,0,0,0,,Yoksa söyleyecek bir şeyiniz mi var?Dialogue: 50,0:18:32.72,0:18:35.18,Main-207-,,0,0,0,,Şey, aslında bir gemi istiyoruz!Dialogue: 50,0:18:35.18,0:18:36.30,Main-207-,,0,0,0,,Kesinlikle olmaz!Dialogue: 50,0:18:38.10,0:18:39.51,Main-207-,,0,0,0,,Usopp-kun!Dialogue: 50,0:18:39.51,0:18:40.31,Main-207-,,0,0,0,,Eyvah!Dialogue: 50,0:18:40.31,0:18:43.10,Main-207-,,0,0,0,,Hakkında her şeyi duydum.Dialogue: 50,0:18:43.10,0:18:45.15,Main-207-,,0,0,0,,Köyde kötü bir şöhretin var.Dialogue: 50,0:18:46.27,0:18:47.98,Main-207-,,0,0,0,,Yaşına göre oldukça etkileyici.Dialogue: 50,0:18:47.98,0:18:51.49,Main-207-,,0,0,0,,Bana Kaptan Usopp diye hitap edebilirsin.Dialogue: 50,0:18:51.49,0:18:53.40,Main-207-,,0,0,0,,Gerçi yalakalığa gerek yok.Dialogue: 50,0:18:54.40,0:18:56.95,Main-207-,,0,0,0,,Baban hakkında da hikâyeler duydum.Dialogue: 50,0:18:56.95,0:18:57.70,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:18:58.03,0:19:01.37,Main-207-,,0,0,0,,Sen, iğrenç bir korsanın oğlundan başka bir şey değilsin!Dialogue: 50,0:19:02.12,0:19:04.83,Main-207-,,0,0,0,,Senden her şeyi beklerim,Dialogue: 50,0:19:05.17,0:19:09.54,Main-207-,,0,0,0,,bu yüzden lütfen bu evin hanımefendisinden uzak dur!Dialogue: 50,0:19:10.55,0:19:12.63,Main-207-,,0,0,0,,İ-İğrenç korsan mı...?!Dialogue: 50,0:19:13.05,0:19:16.84,Main-207-,,0,0,0,,Sen ve hanımefendi tamamen farklı dünyalara aitsiniz!Dialogue: 50,0:19:16.84,0:19:18.85,Main-207-,,0,0,0,,Para mı istiyorsun? Ne kadar istiyorsun?Dialogue: 50,0:19:19.26,0:19:22.06,Main-207-,,0,0,0,,Bu kadarı yeter, Klahadore! Usopp-san'dan özür dile!Dialogue: 50,0:19:23.27,0:19:24.52,Main-207-,,0,0,0,,Hey, Kaya! Dikkatli ol!Dialogue: 50,0:19:25.02,0:19:29.48,Main-207-,,0,0,0,,Niye böyle barbar bir adamdan özür dileyeyim, hanımefendi?Dialogue: 50,0:19:30.36,0:19:33.32,Main-207-,,0,0,0,,Sadece gerçeği konuşuyorum.Dialogue: 50,0:19:34.19,0:19:36.15,Main-207-,,0,0,0,,Seni anlıyorum.Dialogue: 50,0:19:36.15,0:19:39.91,Main-207-,,0,0,0,,Bir korsan olarak hazine aramak için seni ve anneni...Dialogue: 50,0:19:39.91,0:19:42.91,Main-207-,,0,0,0,,terkeden aptal babandan nefret ediyor olmalısın!Dialogue: 50,0:19:43.45,0:19:44.79,Main-207-,,0,0,0,,Klahadore!Dialogue: 50,0:19:45.41,0:19:48.04,Main-207-,,0,0,0,,Seni pislik, babama hakaret etmeyi kessen iyi olur!Dialogue: 50,0:19:49.67,0:19:51.29,Main-207-,,0,0,0,,Usopp-san!Dialogue: 50,0:19:59.85,0:20:02.39,Main-207-,,0,0,0,,Neden bu kadar sinirleniyorsun?Dialogue: 50,0:20:02.39,0:20:05.31,Main-207-,,0,0,0,,Neden o abartılı yalanlarından birini daha anlatmıyorsun?Dialogue: 50,0:20:05.93,0:20:08.77,Main-207-,,0,0,0,,Bize aslında gezgin bir tüccar olduğunu...Dialogue: 50,0:20:08.77,0:20:11.31,Main-207-,,0,0,0,,ya da onun gerçek baban bile olmadığını söyle.Dialogue: 50,0:20:11.31,0:20:12.86,Main-207-,,0,0,0,,Kapa' çeneni!Dialogue: 50,0:20:22.62,0:20:23.83,Main-207-,,0,0,0,,– Kaptan! – Kaptan!Dialogue: 50,0:20:25.16,0:20:28.58,Main-207-,,0,0,0,,G-Gördün mü? Hemen şiddete başvuruyor.Dialogue: 50,0:20:28.58,0:20:31.42,Main-207-,,0,0,0,,"Babasının Oğlu" demelerine şaşmamalı.Dialogue: 50,0:20:31.42,0:20:33.13,Main-207-,,0,0,0,,Kapa' çeneni!Dialogue: 50,0:20:33.59,0:20:37.09,Main-207-,,0,0,0,,Babam korsan olduğu için gurur duyuyorum!Dialogue: 50,0:20:37.09,0:20:40.84,Main-207-,,0,0,0,,Denizin cesur savaşçısı olduğu için onunla gurur duyuyorum!Dialogue: 50,0:20:40.84,0:20:43.89,Main-207-,,0,0,0,,Haklısın, ben bir yalancıyım!Dialogue: 50,0:20:43.89,0:20:48.73,Main-207-,,0,0,0,,Ama ailem hakkında yalan konuşmam! Korsan kanımla gurur duyuyorum!Dialogue: 50,0:20:49.10,0:20:51.48,Main-207-,,0,0,0,,Ben bir korsanın oğluyum!Dialogue: 50,0:20:55.61,0:20:56.86,Main-207-,,0,0,0,,Kaptan...Dialogue: 50,0:20:59.15,0:21:02.37,Main-207-,,0,0,0,,Bir korsan, denizin cesur savaşçısı mı?Dialogue: 50,0:21:02.37,0:21:05.41,Main-207-,,0,0,0,,Gerçeği çarpıtmanın her yolunu bulursun...Dialogue: 50,0:21:06.83,0:21:10.67,Main-207-,,0,0,0,,Ama bu, barbar kanının damarlarında aktığını kanıtlıyor.Dialogue: 50,0:21:10.67,0:21:14.80,Main-207-,,0,0,0,,Yalanlar saçıp, sinirlendiğinde hemen saldırıyorsun!Dialogue: 50,0:21:14.80,0:21:18.63,Main-207-,,0,0,0,,En kötüsü de evin hanımına yanaşıp servetini çalmaya çalışman!Dialogue: 50,0:21:18.63,0:21:20.30,Main-207-,,0,0,0,,Ne diyorsun?! Ben sadece–Dialogue: 50,0:21:20.30,0:21:22.80,Main-207-,,0,0,0,,Babanın bir korsan olması...Dialogue: 50,0:21:22.80,0:21:26.10,Main-207-,,0,0,0,,bir şeyler planladığının yeterli kanıtıdır!Dialogue: 50,0:21:26.52,0:21:27.85,Main-207-,,0,0,0,,Pislik, yine mi hakaret?!Dialogue: 50,0:21:27.85,0:21:29.31,Main-207-,,0,0,0,,Yapma, Usopp-san!Dialogue: 50,0:21:30.60,0:21:33.02,Main-207-,,0,0,0,,Lütfen, daha fazla şiddet olmasın!Dialogue: 50,0:21:34.44,0:21:37.07,Main-207-,,0,0,0,,Klahadore kötü biri değil.Dialogue: 50,0:21:37.65,0:21:38.61,Main-207-,,0,0,0,,O sadece...Dialogue: 50,0:21:39.36,0:21:43.16,Main-207-,,0,0,0,,O sadece benim için en iyi olanı yapmaya çalışıyor!Dialogue: 50,0:21:45.99,0:21:47.41,Main-207-,,0,0,0,,Defol buradan!Dialogue: 50,0:21:47.87,0:21:50.83,Main-207-,,0,0,0,,Bir daha bu malikâneye asla yaklaşma!Dialogue: 50,0:21:51.21,0:21:53.04,Main-207-,,0,0,0,,Peki, anladım.Dialogue: 50,0:21:53.04,0:21:55.67,Main-207-,,0,0,0,,Sen söylemeseydin de giderdim.Dialogue: 50,0:21:57.17,0:21:59.71,Main-207-,,0,0,0,,Bir daha asla geri gelmeyeceğim!Dialogue: 50,0:22:01.09,0:22:02.59,Main-207-,,0,0,0,,Usopp-san...Dialogue: 50,0:22:04.22,0:22:06.18,Main-207-,,0,0,0,,Aptal, kokuşmuş uşak!Dialogue: 50,0:22:06.18,0:22:08.22,Main-207-,,0,0,0,,Kaptanımız öyle biri değil!Dialogue: 50,0:22:08.22,0:22:09.72,Main-207-,,0,0,0,,Evet! Aptal!Dialogue: 50,0:22:09.72,0:22:10.77,Main-207-,,0,0,0,,Aptal!Dialogue: 50,0:22:11.10,0:22:12.89,Main-207-,,0,0,0,,Aptal!!!Dialogue: 50,0:22:12.89,0:22:15.11,Main-207-,,0,0,0,,Sen niye karışıyorsun?Dialogue: 50,0:22:17.94,0:22:22.28,Main-207-,,0,0,0,,Senin derdin ne?! Erkeksen benimle dövüş!Dialogue: 50,0:22:18.90,0:22:19.94,Secondary-207-,,0,0,0,,Sakin ol!Dialogue: 50,0:22:23.15,0:22:25.91,Main-207-,,0,0,0,,Geri kalanınız da defolun buradan!Dialogue: 50,0:22:38.00,0:22:40.46,Main-207-,,0,0,0,,Yemeğiniz, hanımefendi.Dialogue: 50,0:22:40.46,0:22:42.26,Main-207-,,0,0,0,,İstemiyorum.Dialogue: 50,0:22:42.26,0:22:43.63,Main-207-,,0,0,0,,İştahım kaçtı.Dialogue: 50,0:22:47.22,0:22:50.35,Main-207-,,0,0,0,,Böyle söyleyerek şefin kalbini kıracaksınız.Dialogue: 50,0:22:50.35,0:22:55.81,Main-207-,,0,0,0,,İhtiyaçlarınıza uygun yemekler bulmak için elinden geleni yapıyor.Dialogue: 50,0:23:00.82,0:23:02.78,Main-207-,,0,0,0,,Neden onunla öyle konuştun?Dialogue: 50,0:23:03.65,0:23:10.20,Main-207-,,0,0,0,,Senden habersiz Usopp-san ile görüşmemin yanlış olduğunu biliyorum.Dialogue: 50,0:23:10.20,0:23:13.16,Main-207-,,0,0,0,,Ama onu o şekilde kovmana gerek yoktu.Dialogue: 50,0:23:17.71,0:23:19.50,Main-207-,,0,0,0,,Oturabilir miyim?Dialogue: 50,0:23:19.50,0:23:20.34,Main-207-,,0,0,0,,Otur.Dialogue: 50,0:23:22.09,0:23:25.47,Main-207-,,0,0,0,,Bu malikâneye geldiğim günden beri...Dialogue: 50,0:23:26.47,0:23:29.97,Main-207-,,0,0,0,,neredeyse üç yıl geçti.Dialogue: 50,0:23:30.68,0:23:34.27,Main-207-,,0,0,0,,O gün olanları hâlâ unutmadım.Dialogue: 50,0:23:43.23,0:23:49.53,Main-207-,,0,0,0,,Yaptığım bir hata yüzünden çalıştığım gemiden kovuldum.Dialogue: 50,0:23:49.53,0:23:54.45,Main-207-,,0,0,0,,İşsiz ve beş parasız bir şekilde, bir dilenci gibi ölmenin eşiğindeydim.Dialogue: 50,0:24:07.51,0:24:12.97,Main-207-,,0,0,0,,Benim gözümde, hayatımı merhum anne babanıza borçluyum...Dialogue: 50,0:24:13.43,0:24:18.31,Main-207-,,0,0,0,,Ve size, onların kızına.Dialogue: 50,0:24:19.69,0:24:27.03,Main-207-,,0,0,0,,Arkadaş seçiminize karışmak haddim değil, bunu biliyorum.Dialogue: 50,0:24:27.82,0:24:32.99,Main-207-,,0,0,0,,Ama Usopp, dürüst karakteriyle pek tanınmıyor!Dialogue: 50,0:24:32.99,0:24:37.62,Main-207-,,0,0,0,,Eğer... eğer size bir şey olsaydı...Dialogue: 50,0:24:37.62,0:24:41.46,Main-207-,,0,0,0,,iyi kalpli ebeveynleriniz beni asla affetmezdi!Dialogue: 50,0:24:42.50,0:24:46.46,Main-207-,,0,0,0,,Demin olanlar için hâlâ bana kızgın mısınız?Dialogue: 50,0:24:46.46,0:24:48.84,Main-207-,,0,0,0,,Hayır, hiç de bile!Dialogue: 50,0:24:48.84,0:24:51.72,Main-207-,,0,0,0,,Sana sahip olduğum için minnettarım, Klahadore!Dialogue: 50,0:24:51.72,0:24:53.39,Main-207-,,0,0,0,,Ama yanlış anlama.Dialogue: 50,0:24:54.22,0:24:56.68,Main-207-,,0,0,0,,Usopp-san gerçekten çok iyi bir insan.Dialogue: 50,0:24:56.68,0:24:59.98,Main-207-,,0,0,0,,Yine de iyi olup olmaması önemli değil!Dialogue: 50,0:24:59.98,0:25:01.60,Main-207-,,0,0,0,,Klahadore!Dialogue: 50,0:25:01.60,0:25:03.31,Main-207-,,0,0,0,,Mankafanın tekisin!Dialogue: 50,0:25:03.31,0:25:05.15,Main-207-,,0,0,0,,"Mankafa" olmak sorun değil.Dialogue: 50,0:25:09.36,0:25:10.66,Main-207-,,0,0,0,,Luffy nereye gitti?Dialogue: 50,0:25:11.16,0:25:12.28,Main-207-,,0,0,0,,Kim bilir?Dialogue: 50,0:25:12.28,0:25:14.58,Main-207-,,0,0,0,,"Kaptan"ın peşinden gitmiş olabilir?Dialogue: 50,0:25:15.16,0:25:16.83,Main-207-,,0,0,0,,Kaptan orada olmalı.Dialogue: 50,0:25:16.83,0:25:18.54,Main-207-,,0,0,0,,Evet, kıyıda.Dialogue: 50,0:25:18.54,0:25:21.67,Main-207-,,0,0,0,,Canı sıkkın olduğu zaman oraya gider.Dialogue: 50,0:25:21.67,0:25:24.63,Main-207-,,0,0,0,,Hazır bahsetmişken, sizden de biri eksik değil mi?Dialogue: 50,0:25:24.63,0:25:26.76,Main-207-,,0,0,0,,– Evet, Tamanegi! – Evet, Tamanegi!Dialogue: 50,0:25:26.76,0:25:29.51,Main-207-,,0,0,0,,Hep aniden ortaya çıkar!Dialogue: 50,0:25:29.51,0:25:32.84,Main-207-,,0,0,0,,Evet. Aniden bağırarak ortaya çıkar.Dialogue: 50,0:25:34.85,0:25:36.31,Main-207-,,0,0,0,,Korkunç!Dialogue: 50,0:25:36.31,0:25:37.68,Main-207-,,0,0,0,,Gördünüz mü?Dialogue: 50,0:25:37.68,0:25:40.14,Main-207-,,0,0,0,,Geri geri yürüyen bir adam var!Dialogue: 50,0:25:40.60,0:25:43.10,Main-207-,,0,0,0,,Geri geri yürüyen tuhaf biri buraya doğru geliyor!Dialogue: 50,0:25:43.10,0:25:44.23,Main-207-,,0,0,0,,– Yalancı! – Yalancı!Dialogue: 50,0:25:44.23,0:25:45.77,Main-207-,,0,0,0,,Doğru!Dialogue: 50,0:25:45.77,0:25:47.61,Main-207-,,0,0,0,,Bakın!Dialogue: 50,0:25:56.62,0:25:59.58,Main-207-,,0,0,0,,Hey! Kimdi o bana tuhaf diyen?!Dialogue: 50,0:26:02.83,0:26:04.63,Main-207-,,0,0,15,,Tuhaf değilim.Dialogue: 50,0:26:05.79,0:26:07.84,Main-207-,,0,0,0,,Bana oldukça tuhaf göründün.Dialogue: 50,0:26:07.84,0:26:09.17,Main-207-,,0,0,0,,Aptallaşma!Dialogue: 50,0:26:09.17,0:26:11.55,Main-207-,,0,0,0,,Ben sadece gezgin bir hipnotizmacıyım.Dialogue: 50,0:26:11.55,0:26:14.18,Main-207-,,0,0,0,,H-Hipnotizmacı mı?! Harika!Dialogue: 50,0:26:14.18,0:26:15.80,Main-207-,,0,0,0,,Bize bir şeyler göster!Dialogue: 50,0:26:15.80,0:26:17.43,Main-207-,,0,0,0,,Evet! Göster!Dialogue: 50,0:26:18.06,0:26:19.02,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:26:20.27,0:26:22.27,Main-207-,,0,0,0,,Güldürmeyin beni!Dialogue: 50,0:26:22.27,0:26:26.98,Main-207-,,0,0,0,,Neden tekniklerimi bir grup yabancıya göstereyim ki?!Dialogue: 50,0:26:27.73,0:26:29.98,Main-207-,,0,0,0,,Peki. Bu halkaya dikkatlice bakın.Dialogue: 50,0:26:29.98,0:26:30.99,Main-207-,,0,0,0,,Gösteriyorsun?!Dialogue: 50,0:26:31.32,0:26:34.74,Main-207-,,0,0,0,,"Bir, İki, Jango" dedikten sonra uyuyacaksınız.Dialogue: 50,0:26:34.74,0:26:35.95,Main-207-,,0,0,0,,Pekâlâ, başlıyoruz!Dialogue: 50,0:26:37.08,0:26:38.08,Main-207-,,0,0,0,,Bir...Dialogue: 50,0:26:38.08,0:26:39.20,Main-207-,,0,0,0,,İki...Dialogue: 50,0:26:39.20,0:26:39.87,Main-207-,,0,0,0,,Jango!Dialogue: 50,0:26:43.75,0:26:45.88,Main-207-,,0,0,0,,Hey! Bu adamın sorunu ne?!Dialogue: 50,0:26:50.63,0:26:51.34,Main-207-,,0,0,0,,Selam!Dialogue: 50,0:26:52.30,0:26:53.55,Main-207-,,0,0,0,,Demek buradaydın!Dialogue: 50,0:26:53.55,0:26:56.51,Main-207-,,0,0,0,,Oh, sensin! Böyle sinsice yaklaşma!Dialogue: 50,0:26:57.10,0:26:59.43,Main-207-,,0,0,0,,Ne var? Ne istiyorsun?Dialogue: 50,0:26:59.43,0:27:00.56,Main-207-,,0,0,0,,Hiçbir şey.Dialogue: 50,0:27:04.64,0:27:06.48,Main-207-,,0,0,0,,Ah...Dialogue: 50,0:27:12.53,0:27:14.40,Main-207-,,0,0,0,,O lanet uşağın,Dialogue: 50,0:27:14.40,0:27:16.61,Main-207-,,0,0,0,,babama öyle hakaretler etmesi...Dialogue: 50,0:27:16.61,0:27:19.24,Main-207-,,0,0,0,,Evet, ben de ondan nefret ediyorum!Dialogue: 50,0:27:19.24,0:27:22.16,Main-207-,,0,0,0,,Kim ne derse desin, Yasopp harika bir korsandır!Dialogue: 50,0:27:22.54,0:27:24.00,Main-207-,,0,0,0,,Öyle, ha?!Dialogue: 50,0:27:24.37,0:27:27.79,Main-207-,,0,0,0,,Korsanların her yerde olduğu bu çağda,Dialogue: 50,0:27:27.79,0:27:31.67,Main-207-,,0,0,0,,hayatını denizde riske atan babamla gurur duyuyorum.Dialogue: 50,0:27:31.67,0:27:35.26,Main-207-,,0,0,0,,Yine de o herif gururumu ayaklar altına aldı!Dialogue: 50,0:27:35.26,0:27:37.14,Main-207-,,0,0,0,,Bunun bedelini ödeyecek!Dialogue: 50,0:27:37.14,0:27:40.14,Main-207-,,0,0,0,,Yani artık o kızı görmeyecek misin?Dialogue: 50,0:27:41.22,0:27:44.10,Main-207-,,0,0,0,,Ş-Şey, bilmiyorum...Dialogue: 50,0:27:44.10,0:27:47.98,Main-207-,,0,0,0,,Eğer o uşak benden özür dilerse, düşünebilirim.Dialogue: 50,0:27:47.98,0:27:49.73,Main-207-,,0,0,0,,Şu uşak mı?Dialogue: 50,0:27:49.73,0:27:50.48,Main-207-,,0,0,0,,Evet...Dialogue: 50,0:27:50.82,0:27:52.57,Main-207-,,0,0,0,,O uşağı... o...Dialogue: 50,0:27:52.57,0:27:54.65,Main-207-,,0,0,0,,O uşağın burada ne işi var?!Dialogue: 50,0:27:54.65,0:27:56.53,Main-207-,,0,0,0,,H-Hey! Acıyor, ah!Dialogue: 50,0:27:57.32,0:27:58.57,Main-207-,,0,0,0,,Hey, Jango.Dialogue: 50,0:27:58.57,0:28:02.08,Main-207-,,0,0,0,,Sana bu köyde dikkat çekme demiştim.Dialogue: 50,0:28:02.08,0:28:04.37,Main-207-,,0,0,0,,Ve sen de gidip yolun ortasında uyuyorsun.Dialogue: 50,0:28:04.37,0:28:05.79,Main-207-,,0,0,0,,Aptallaşma.Dialogue: 50,0:28:05.79,0:28:07.75,Main-207-,,0,0,0,,Hiç de dikkat çekmiyorum.Dialogue: 50,0:28:07.75,0:28:09.08,Main-207-,,0,0,0,,Üstelik tuhaf da değilim.Dialogue: 50,0:28:09.46,0:28:12.09,Main-207-,,0,0,0,,Yanında başka biri daha var. Tuhaf biri...Dialogue: 50,0:28:12.09,0:28:13.71,Main-207-,,0,0,0,,Daha önce hiç görmedim.Dialogue: 50,0:28:13.71,0:28:14.84,Main-207-,,0,0,0,,Kim acaba?Dialogue: 50,0:28:14.84,0:28:19.05,Main-207-,,0,0,0,,Yani planı uygulamak için her şey hazır mı?Dialogue: 50,0:28:19.05,0:28:20.72,Main-207-,,0,0,0,,Hazır.Dialogue: 50,0:28:24.35,0:28:26.56,Main-207-,,0,0,0,,Her an başlayabiliriz...Dialogue: 50,0:28:26.94,0:28:29.35,Main-207-,,0,0,0,,"Hanımefendiye Suikast Planı"na!Dialogue: 50,0:28:32.40,0:28:36.24,Main-207-,,0,0,0,,S-Suikast mi?!Dialogue: 0,0:01:50.01,0:01:54.93,Title-207-,,0,0,0,,Kaptan UsoppDialogue: 1,0:01:50.01,0:01:54.93,Title-207-,,0,0,0,,Kaptan UsoppDialogue: 0,0:03:33.61,0:03:37.36,Captions-207-,,0,0,0,,Usopp Köydeki Bir GençDialogue: 1,0:03:33.61,0:03:37.36,Captions-207-,,0,0,0,,Usopp Köydeki Bir GençDialogue: 2,0:03:33.61,0:03:37.36,Captions-207-,,0,0,0,,Usopp Köydeki Bir GençDialogue: 0,0:04:40.09,0:04:43.43,Captions-207-,,0,0,0,,Ninjin (Havuç) ve Piiman (Yeşil Biber) Köy ÇocuklarıDialogue: 1,0:04:40.09,0:04:43.43,Captions-207-,,0,0,0,,Ninjin (Havuç) ve Piiman (Yeşil Biber) Köy ÇocuklarıDialogue: 2,0:04:40.09,0:04:43.43,Captions-207-,,0,0,0,,Ninjin (Havuç) ve Piiman (Yeşil Biber) Köy ÇocuklarıDialogue: 0,0:05:03.91,0:05:09.83,Captions-207-,,0,0,0,,Tamanegi (Soğan) Köydeki Bir ÇocukDialogue: 1,0:05:03.91,0:05:09.83,Captions-207-,,0,0,0,,Tamanegi (Soğan) Köydeki Bir ÇocukDialogue: 2,0:05:03.91,0:05:09.83,Captions-207-,,0,0,0,,Tamanegi (Soğan) Köydeki Bir ÇocukDialogue: 0,0:10:02.41,0:10:06.34,Captions-207-,,0,0,0,,Köy RestoranıDialogue: 1,0:10:02.41,0:10:06.34,Captions-207-,,0,0,0,,Köy RestoranıDialogue: 2,0:10:02.41,0:10:06.34,Captions-