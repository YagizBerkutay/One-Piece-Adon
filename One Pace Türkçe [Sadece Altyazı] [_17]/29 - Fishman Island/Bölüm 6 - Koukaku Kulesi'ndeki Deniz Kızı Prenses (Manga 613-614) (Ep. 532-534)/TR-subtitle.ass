Dialogue: 0,0:02:30.00,0:02:38.84,Title,Title,0,0,0,,{\fad(2000,2000)}Koukaku Kulesi'ndeki Deniz Kızı Prenses
Dialogue: 0,0:02:39.69,0:02:44.19,Captions,Character Box,0,0,220,,{\fad(600,600)}Uçan Korsanlar Üyesi\NBüyük Keşiş Wadatsumi {\fs28}(Dev Balon Balığı Balık Adam)
Dialogue: 0,0:02:41.26,0:02:43.31,Main,Decken,0,0,0,,{\an8}Wadatsumi.
Dialogue: 0,0:02:45.49,0:02:48.35,Main,Decken,0,0,0,,Daha yanıt yok mu?
Dialogue: 0,0:02:48.35,0:02:51.67,Main,Decken,0,0,0,,Prenses Shirahoshi hâlâ\Nmektubuma cevap göndermedi mi?
Dialogue: 0,0:02:51.87,0:02:56.17,Main,Wadatsumi,0,0,0,,Hayır, daha göndermedi, Kaptan Decken.
Dialogue: 0,0:02:56.17,0:03:00.13,Main,Decken,0,0,0,,Ah, kaç yıldır bekliyorum?
Dialogue: 0,0:03:00.63,0:03:04.26,Main,Wadatsumi,0,0,0,,On yıl kadar, değil mi?\NMuhtemelen cevap vermeyecek.
Dialogue: 0,0:03:05.78,0:03:10.32,Main,Decken,0,0,0,,Kısacası, hepsi rezil Neptune'un hatası!
Dialogue: 0,0:03:11.22,0:03:15.11,Main,Decken,0,0,0,,Onu politik bir evliliğe zorlamak istiyor.
Dialogue: 0,0:03:15.82,0:03:17.61,Main,Decken,0,0,0,,Öyle tahmin ediyorum!
Dialogue: 0,0:03:18.23,0:03:25.02,Main,Decken,0,0,0,,On yıldır onu çelik kuleye\Nhapsetmiş olması bunu kanıtlıyor!
Dialogue: 0,0:03:25.02,0:03:28.16,Main,Decken,0,0,0,,Oh, ne kadar trajik!
Dialogue: 0,0:03:28.16,0:03:32.12,Main,Decken,0,0,0,,Birbirimize aşık olmamıza rağmen.
Dialogue: 0,0:03:34.25,0:03:37.85,Main,Decken,0,0,0,,{\an8}Öyle tahmin ediyorum!
Dialogue: 0,0:03:35.03,0:03:39.43,Captions,Character Box,0,0,240,,{\fad(600,0)}Uçan Korsanlar'ın Kaptanı\N9. Vander Decken
Dialogue: 0,0:03:35.03,0:03:39.43,Captions,Fish Type,0,0,0,,{\fad(600,0)\pos(216,170)}Boğa Başlı Köpek Balığı
Dialogue: 0,0:03:37.85,0:03:40.04,Main,Decken,0,0,0,,{\an8}Prenses Shirahoshi!
Dialogue: 0,0:03:40.04,0:03:47.64,Main,Decken,0,0,0,,Denizlerde ne kadar dolaşsam da asla senin kadar\Nmüthiş ya da güzel bir kadın bulamayacağım!
Dialogue: 0,0:03:48.01,0:03:50.60,Main,Decken,0,0,0,,Aşkımız karşılıklıysa, her şey yolunda demektir.
Dialogue: 0,0:03:50.90,0:03:57.00,Main,Decken,0,0,0,,Ancak, başka bir erkekle yaşamana izin veremem.
Dialogue: 0,0:03:57.00,0:04:02.23,Main,Decken,0,0,0,,Yaşarsan, ölmelisin, Shirahoshi!
Dialogue: 0,0:04:02.84,0:04:07.09,Main,Decken,0,0,0,,Senin için "Ya ölüm ya da evlilik" var!
Dialogue: 0,0:04:07.74,0:04:12.53,Main,Decken,0,0,0,,Bugün bir kez daha, sana üzerinde\Ntek bir gül olan balta göndereceğim.
Dialogue: 0,0:04:12.53,0:04:19.57,Main,Decken,0,0,0,,Kabul et, Shirahoshi! \NBu, evliliğimizin sembolü!
Dialogue: 0,0:04:19.84,0:04:22.46,Main,Pirate,0,0,0,,Kaptan. Hedefi tamamen ıskaladın.
Dialogue: 0,0:04:22.46,0:04:26.80,Main,Decken,0,0,0,,Embesil! Hedefimi asla ıskalamam.
Dialogue: 0,0:04:28.21,0:04:29.26,Main,Decken,0,0,0,,Öyle tahmin ediyorum!
Dialogue: 0,0:04:30.44,0:04:31.19,Main,Pirate,0,0,0,,Geri döndü!
Dialogue: 0,0:04:32.56,0:04:34.48,Main,Pirate,0,0,0,,Doğruca Ryugu Sarayı'na uçuyor!
Dialogue: 0,0:04:38.60,0:04:42.04,Captions,Sign,0,0,260,,{\fad(600,0)}Ryugu Krallığı'nın Kraliyet Sarayı\NRyugu Sarayı
Dialogue: 0,0:04:44.97,0:04:47.53,Main,Luffy,0,0,0,,H-Hey! Sorun nedir?!
Dialogue: 0,0:04:47.53,0:04:50.39,Main,Luffy,0,0,0,,Ben sadece biraz yiyecek\Nalmaya gelen bir korsanım!
Dialogue: 0,0:04:51.77,0:04:52.92,Main,Luffy,0,0,0,,Hadi ama!
Dialogue: 0,0:04:54.64,0:04:56.23,Main,Luffy,0,0,0,,Hey!
Dialogue: 0,0:04:56.82,0:05:00.36,Main,Luffy,0,0,0,,Oh, kapa çeneni... Ne kadar can sıkıcı.
Dialogue: 0,0:05:00.36,0:05:02.41,Main,Guard,0,0,0,,Prenses Shirahoshi ağlıyor!
Dialogue: 0,0:05:02.41,0:05:04.30,Main,Guard,0,0,0,,Koukaku Kulesi'nden geliyor!
Dialogue: 0,0:05:02.41,0:05:04.30,Note,Guard,0,0,0,,Koukaku: Sert Kabuk
Dialogue: 0,0:05:04.30,0:05:06.23,Main,Guard,0,0,0,,Kule muhafızlarına ne oldu?!
Dialogue: 0,0:05:06.48,0:05:09.09,Main,Right Minister,0,0,0,,Ne?! Neden onun yanında kimse yok?!
Dialogue: 0,0:05:09.09,0:05:12.56,Main,Guard,0,0,0,,Üzgünüz efendim! Devriyelerde karışıklık olmuş.
Dialogue: 0,0:05:12.56,0:05:17.32,Main,Shirahoshi,0,0,0,,Bir insan canımı almaya geldi...
Dialogue: 0,0:05:17.32,0:05:20.42,Main,Shirahoshi,0,0,0,,...ve odama girdi!
Dialogue: 0,0:05:20.42,0:05:21.80,Main,Luffy,0,0,0,,Ha? Hayır!
Dialogue: 0,0:05:21.80,0:05:23.81,Main,Luffy,0,0,0,,Hey, öyle değil!
Dialogue: 0,0:05:23.81,0:05:27.79,Main,Luffy,0,0,0,,Ben sadece acıkmıştım ve \Nbunun senin yemeğin olduğunu bilmiyordum!
Dialogue: 0,0:05:51.85,0:05:55.60,Main,Luffy,0,0,0,,Balta? Nereden geldi bu?
Dialogue: 0,0:05:56.08,0:05:57.30,Main,Right Minister,0,0,0,,İyi misiniz?
Dialogue: 0,0:05:57.30,0:05:58.70,Main,Right Minister,0,0,0,,Yaralanmadınız, değil mi?!
Dialogue: 0,0:05:58.70,0:06:02.64,Main,Guard,0,0,0,,Her zamankinden daha fazla\Nbağırdığınız için endişelendik.
Dialogue: 0,0:06:02.64,0:06:04.61,Main,Luffy,0,0,0,,Ne yapıyors-
Dialogue: 0,0:06:04.61,0:06:06.48,Main,Right Minister,0,0,0,,Kapıyı kim açtı?!
Dialogue: 0,0:06:06.71,0:06:12.40,Main,Shirahoshi,0,0,0,,S-Sizi endişelendirdiğim için üzgünüm.\NKâbus görmüş olmalıyım.
Dialogue: 0,0:06:12.40,0:06:14.49,Main,Right Minister,0,0,0,,Bir ses duyduğuma yemin edebilirim.
Dialogue: 0,0:06:14.49,0:06:15.72,Main,Shirahoshi,0,0,0,,Oh, şey...
Dialogue: 0,0:06:15.72,0:06:21.43,Main,Right Minister,0,0,0,,Ah, sahi, size söylemem gereken bir şey var.
Dialogue: 0,0:06:21.93,0:06:27.45,Main,Right Minister,0,0,0,,Megalo'yu kurtaran Hasır Şapkalı Luffy hakkında.
Dialogue: 0,0:06:29.05,0:06:32.79,Main,Right Minister,0,0,0,,Bazı deniz kızları kayıp ve onun\Nkaçırdığından şüpheleniyoruz.
Dialogue: 0,0:06:33.13,0:06:40.37,Main,Right Minister,0,0,0,,Ayrıca Madam Shyarly'nin kehaneti dolayısıyla\NHasır Şapkalar'ı zindana atmaya karar verdik.
Dialogue: 0,0:06:40.57,0:06:44.65,Main,Right Minister,0,0,0,,Çünkü ileride sorun çıkarma ihtimalleri yüksek.
Dialogue: 0,0:06:45.46,0:06:48.14,Main,Right Minister,0,0,0,,Bir süre önce \NRyugu Sarayı'na gelen kılıç ustası...
Dialogue: 0,0:06:48.14,0:06:51.32,Main,Right Minister,0,0,0,,...fazlasıyla içtikten sonra sızdı\Nve onu çoktan tutukladık.
Dialogue: 0,0:06:54.68,0:07:00.86,Main,Right Minister,0,0,0,,Demin gelen Hasır Şapka tayfasından\Nüç kişi de muhtemelen yakalanmıştır.
Dialogue: 0,0:07:00.86,0:07:06.41,Main,Right Minister,0,0,0,,Ancak, onlarla birlikte gelen kaptanları\NHasır Şapka, olan biteni anlamış olmalı...
Dialogue: 0,0:07:06.41,0:07:08.65,Main,Right Minister,0,0,0,,...ve nasılsa ortadan kayboldu.
Dialogue: 0,0:07:08.65,0:07:13.76,Main,Right Minister,0,0,0,,Gizlice kalede dolaştığına inanıyoruz,\Nbu yüzden dikkatli olun.
Dialogue: 0,0:07:13.76,0:07:17.91,Main,Right Minister,0,0,0,,Tayfasının adada kalanlarını da\Nmutlaka yakalayacağız.
Dialogue: 0,0:07:17.91,0:07:21.65,Main,Right Minister,0,0,0,,Ülkenin huzurunu her pahasına koruyacağız!
Dialogue: 0,0:07:23.07,0:07:30.56,Main,Right Minister,0,0,0,,Yine de Megalo'nun kurtarıcılarını\Ntutuklamak zorunda kalmamız çok kötü oldu.
Dialogue: 0,0:07:30.56,0:07:33.67,Main,Right Minister,0,0,0,,Ah, evet. Beş dakika olmuş bile.
Dialogue: 0,0:07:33.67,0:07:35.90,Main,Right Minister,0,0,0,,Şimdi gidiyoruz.
Dialogue: 0,0:07:37.84,0:07:40.84,Main,Shirahoshi,0,0,0,,Çok teşekkür ederim.
Dialogue: 0,0:07:40.84,0:07:43.84,Main,Shirahoshi,0,0,0,,Demin sana çok büyük kabalık ettim.
Dialogue: 0,0:07:43.84,0:07:45.91,Main,Shirahoshi,0,0,0,,Lütfen beni affet.
Dialogue: 0,0:07:45.91,0:07:50.65,Main,Shirahoshi,0,0,0,,Megalo'nun hayatını senin\Nkurtardığını bilmiyordum.
Dialogue: 0,0:07:52.17,0:07:55.45,Main,Shirahoshi,0,0,0,,Sana Luffy-sama diyebilir miyim?
Dialogue: 0,0:07:55.45,0:07:56.22,Main,Luffy,0,0,0,,Tabii.
Dialogue: 0,0:07:56.46,0:07:59.64,Main,Shirahoshi,0,0,0,,Luffy-sama, korsan olman...
Dialogue: 0,0:07:59.64,0:08:01.88,Main,Shirahoshi,0,0,0,,...kötü biri olduğun anlamına mı geliyor?
Dialogue: 0,0:08:04.04,0:08:06.98,Main,Luffy,0,0,0,,Bilmem. Buna kendin karar ver.
Dialogue: 0,0:08:07.74,0:08:12.86,Main,Shirahoshi,0,0,0,,A-Ama tayfan ne olacak?\NMuhafızlarımız tarafından yakalanmışlar.
Dialogue: 0,0:08:12.86,0:08:18.07,Main,Luffy,0,0,0,,Ah, sorun değil. \NOnları gerçekten yakalayabilmeniz mümkün değil.
Dialogue: 0,0:08:18.07,0:08:19.51,Main,Shirahoshi,0,0,0,,Öyle mi?
Dialogue: 0,0:08:19.51,0:08:24.62,Main,Luffy,0,0,0,,Neyse, bunu boşver. O balta neydi öyle?
Dialogue: 0,0:08:25.26,0:08:28.45,Main,Luffy,0,0,0,,Onu nasıl bir insan ve nereden atmış olabilir?
Dialogue: 0,0:08:28.45,0:08:32.32,Main,Shirahoshi,0,0,0,,Kimin attığını biliyorum.
Dialogue: 0,0:08:32.32,0:08:35.19,Main,Shirahoshi,0,0,0,,Vander Decken-sama adında bir adam.
Dialogue: 0,0:08:35.19,0:08:40.42,Main,Shirahoshi,0,0,0,,Onunla evlenmeyi reddettiğimden,\Nintikam almak için fırlattı.
Dialogue: 0,0:08:41.14,0:08:43.31,Main,Shirahoshi,0,0,0,,O adam...
Dialogue: 0,0:08:43.99,0:08:47.35,Main,Shirahoshi,0,0,0,,Şeytan, ona "Mato Mato" lanetini yapmış.
Dialogue: 0,0:08:43.99,0:08:47.35,Note,Shirahoshi,0,0,0,,Mato: Hedef
Dialogue: 0,0:08:48.07,0:08:51.22,Main,Shirahoshi,0,0,0,,Bu yüzden, beni hedef olarak seçtiği için,...
Dialogue: 0,0:08:51.22,0:08:56.20,Main,Shirahoshi,0,0,0,,...istediği zaman istediği yerden\Ncanıma kastetme imkânı var.
Dialogue: 0,0:08:56.20,0:08:58.85,Main,Shirahoshi,0,0,0,,Bu yüzden dışarı çıkmam tehlikeli.
Dialogue: 0,0:08:58.85,0:09:03.44,Main,Shirahoshi,0,0,0,,Koukaku Kulesi'nin dışına\Nadım atmama bile izin yok.
Dialogue: 0,0:09:07.62,0:09:09.96,Main,Shirahoshi,0,0,0,,On yıldır bunu yapıyor.
Dialogue: 0,0:09:09.96,0:09:11.63,Main,Luffy,0,0,0,,On yıl mı?!
Dialogue: 0,0:09:11.63,0:09:13.52,Main,Luffy,0,0,0,,Gerçekten sıkıcı olmalı.
Dialogue: 0,0:09:13.52,0:09:18.02,Main,Shirahoshi,0,0,0,,Üstelik babam, muhafızların burada sadece...
Dialogue: 0,0:09:18.02,0:09:21.29,Main,Shirahoshi,0,0,0,,...beş dakika durabileceğine karar verdi.
Dialogue: 0,0:09:21.85,0:09:23.20,Main,Luffy,0,0,0,,Gerçekten mi?
Dialogue: 0,0:09:23.20,0:09:27.21,Main,Shirahoshi,0,0,0,,Bu yüzden konuşabileceğim sadece Megalo var.
Dialogue: 0,0:09:28.06,0:09:30.35,Main,Shirahoshi,0,0,0,,Çok değerli arkadaşım.
Dialogue: 0,0:09:30.35,0:09:34.10,Main,Luffy,0,0,0,,Demek bu yüzden sırf onu kurtardık\Ndiye ziyafet vermek istediler.
Dialogue: 0,0:09:36.62,0:09:38.86,Main,Luffy,0,0,0,,Gerçi olmadı ama.
Dialogue: 0,0:09:41.59,0:09:48.80,Main,Shirahoshi,0,0,0,,Yine de siz insanlar,\Nboyutunuza göre çok yiyorsunuz.
Dialogue: 0,0:09:48.80,0:09:50.81,Main,Luffy,0,0,0,,Kıllı ihtiyar...
Dialogue: 0,0:09:51.24,0:09:54.33,Main,Luffy,0,0,0,,...ziyafet çekeceğimizi söyledi,...
Dialogue: 0,0:09:54.93,0:09:57.49,Main,Luffy,0,0,0,,...ama uzun bir süre azarlanıp durdu.
Dialogue: 0,0:09:58.21,0:09:59.88,Main,Luffy,0,0,0,,Daha fazla bekleyemedim,...
Dialogue: 0,0:09:59.88,0:10:01.82,Main,Luffy,0,0,0,,...bu yüzden kokunun peşinden buraya geldim.
Dialogue: 0,0:10:02.38,0:10:04.92,Main,Luffy,0,0,0,,Bu arada, sana "Prenses" dediler, değil mi?
Dialogue: 0,0:10:04.92,0:10:06.18,Main,Shirahoshi,0,0,0,,Evet.
Dialogue: 0,0:10:06.18,0:10:07.99,Main,Luffy,0,0,0,,Yani sen Deniz Kızı Prensesi misin?
Dialogue: 0,0:10:07.99,0:10:11.85,Main,Shirahoshi,0,0,0,,Evet. Ben Kral Neptune'un kızıyım.
Dialogue: 0,0:10:11.85,0:10:13.42,Main,Shirahoshi,0,0,0,,Adım Shirahoshi.
Dialogue: 0,0:10:13.42,0:10:15.47,Main,Luffy,0,0,0,,Ha? Shirasu?
Dialogue: 0,0:10:15.47,0:10:16.93,Main,Shirahoshi,0,0,0,,Hayır, Shirahoshi.
Dialogue: 0,0:10:16.93,0:10:19.51,Main,Luffy,0,0,0,,Ha. Söylemesi çok zor.
Dialogue: 0,0:10:19.51,0:10:21.30,Main,Luffy,0,0,0,,Ah! Onun da tadına bakmak istiyorum!
Dialogue: 0,0:10:21.94,0:10:27.34,Main,Shirahoshi,0,0,0,,Bana hiç de kötü biri gibi gelmedin.
Dialogue: 0,0:10:27.34,0:10:31.16,Main,Shirahoshi,0,0,0,,Korsan olduğuna göre, \Nmaceralara falan çıktın mı?
Dialogue: 0,0:10:31.16,0:10:32.04,Main,Luffy,0,0,0,,Evet!
Dialogue: 0,0:10:32.04,0:10:36.91,Main,Shirahoshi,0,0,0,,Ah, sahi. Güneşi gördün mü?
Dialogue: 0,0:10:36.91,0:10:40.77,Main,Shirahoshi,0,0,0,,Gece çökerken, bir kimse gökyüzündeki\Nyıldızları görebilir, değil mi?
Dialogue: 0,0:10:40.77,0:10:46.64,Main,Shirahoshi,0,0,0,,Çok çeşitli çiçekler ve vücutları\Nkürkle kaplı hayvanlar var.
Dialogue: 0,0:10:46.64,0:10:51.66,Main,Shirahoshi,0,0,0,,Hiç "orman" denen yeşil yerde bulundun mu?
Dialogue: 0,0:10:51.66,0:10:55.88,Main,Luffy,0,0,0,,Dur, dur! Çok fazla soru soruyorsun! Dur biraz!
Dialogue: 0,0:10:55.88,0:10:56.64,Main,Shirahoshi,0,0,0,,Tamam.
Dialogue: 0,0:10:57.43,0:10:59.77,Main,Shirahoshi,0,0,0,,Ah, ne büyük yanakların var.
Dialogue: 0,0:11:02.43,0:11:04.59,Main,Luffy,0,0,0,,Ne yapıyorsun?! Kes şunu!
Dialogue: 0,0:11:06.06,0:11:09.45,Main,Shirahoshi,0,0,0,,O-O-Olamaz.
Dialogue: 0,0:11:09.75,0:11:12.90,Main,Shirahoshi,0,0,0,,Lütfen bana bu kadar yüksek sesle bağırma.
Dialogue: 0,0:11:13.40,0:11:17.82,Main,Shirahoshi,0,0,0,,Sen gerçekten korkunçmuşsun, Luffy-sama.
Dialogue: 0,0:11:22.21,0:11:25.76,Main,Luffy,0,0,0,,Hey! Niye ağlıyorsun? Kes şunu!
Dialogue: 0,0:11:26.14,0:11:31.86,Main,Shirahoshi,0,0,0,,Daha önce hiç beni azarlayan olmamıştı.
Dialogue: 0,0:11:33.81,0:11:37.34,Main,Luffy,0,0,0,,Bu kadar büyük olmana rağmen,\Ngüçsüzün ve sulu gözün tekisin, değil mi?
Dialogue: 0,0:11:37.97,0:11:40.34,Main,Luffy,0,0,0,,Senden hoşlanmadım!
Dialogue: 0,0:11:44.95,0:11:46.77,Main,Shirahoshi,0,0,0,,Ne kötü bir şey dedin.
Dialogue: 0,0:11:46.77,0:11:49.45,Main,Shirahoshi,0,0,0,,Hiç kimse bana öyle bir şey dememişti.
Dialogue: 0,0:11:49.45,0:11:54.54,Main,Shirahoshi,0,0,0,,Çok kötüsün... Lütfen git.
Dialogue: 0,0:11:54.54,0:11:55.63,Main,Shirahoshi,0,0,0,,Ben...
Dialogue: 0,0:11:56.80,0:11:58.46,Main,Shirahoshi,0,0,0,,...artık buna katlanamıyorum!
Dialogue: 0,0:11:59.51,0:12:01.34,Main,Luffy,0,0,0,,Doydum!
Dialogue: 0,0:12:01.34,0:12:02.63,Main,Luffy,0,0,0,,Yemek için sağol!
Dialogue: 0,0:12:02.63,0:12:06.42,Main,Luffy,0,0,0,,On yıldır buradasın, ha? \NBen olsam hasta olurdum.
Dialogue: 0,0:12:06.42,0:12:09.49,Main,Shirahoshi,0,0,0,,Luffy-sama... Lütfen artık git.
Dialogue: 0,0:12:09.49,0:12:10.22,Main,Luffy,0,0,0,,Söylesene.
Dialogue: 0,0:12:10.22,0:12:13.18,Main,Luffy,0,0,0,,Gitmek istediğin bir yer var mı?
Dialogue: 0,0:12:14.14,0:12:19.50,Main,Shirahoshi,0,0,0,,Elbette... Bir sürü yer var.
Dialogue: 0,0:12:19.50,0:12:21.09,Main,Luffy,0,0,0,,Eminim vardır.
Dialogue: 0,0:12:21.09,0:12:23.21,Main,Luffy,0,0,0,,O zaman buradan çıkalım!
Dialogue: 0,0:12:23.21,0:12:24.16,Main,Shirahoshi,0,0,0,,Ne?!
Dialogue: 0,0:12:24.16,0:12:25.71,Main,Luffy,0,0,0,,Yürüyüşe çıkalım!
Dialogue: 0,0:12:26.31,0:12:28.93,Main,Shirahoshi,0,0,0,,Hayır, dur! Bunu yapamam.
Dialogue: 0,0:12:28.93,0:12:31.46,Main,Luffy,0,0,0,,Neyin var senin? Gidelim!
Dialogue: 0,0:12:33.03,0:12:35.23,Main,Luffy,0,0,0,,Sorun olmayacak!
Dialogue: 0,0:12:35.23,0:12:40.44,Main,Luffy,0,0,0,,Sana uçarak gelen bir şey\Ndaha olursa, ben hallederim!
Dialogue: 0,0:12:40.44,0:12:41.87,Main,Shirahoshi,0,0,0,,Ne?!
Dialogue: 0,0:12:44.79,0:12:47.85,Main,Caimie,0,0,0,,{\an8}Usopp-chin! Nami-chin! Brook-chin!
Dialogue: 0,0:12:44.82,0:12:47.85,Captions,Sign,0,0,220,,{\fad(200,0)}Ryugu Sarayı\NAna Giriş
Dialogue: 0,0:12:48.59,0:12:50.91,Main,Left Minister,0,0,0,,Onları tutuklamayı bile beceremiyor musunuz?!
Dialogue: 0,0:12:50.91,0:12:53.89,Main,Left Minister,0,0,0,,Onlar sadece üç insan!
Dialogue: 0,0:12:53.89,0:12:55.44,Main,Pappagg,0,0,0,,Hey, ne yapıyorsun?!
Dialogue: 0,0:12:55.44,0:13:00.05,Main,Caimie,0,0,0,,Arkadaşlar, onlarla dövüşmeye devam ederseniz,\Ngerçekten suçlu olarak görüleceksiniz!
Dialogue: 0,0:13:00.05,0:13:04.72,Main,Brook,0,0,0,,Öyle olabilir ama sessizce bunu kabullenmek\Niçin de iyi bir sebebimiz yok, Caimie-san.
Dialogue: 0,0:13:04.72,0:13:08.60,Main,Nami,0,0,0,,Ryugu Sarayı'ndaki ziyafeti\Ndört gözle bekliyordum.
Dialogue: 0,0:13:08.60,0:13:11.44,Main,Usopp,0,0,0,,Karşılık vermezsek, yakalanacağız.
Dialogue: 0,0:13:11.44,0:13:15.55,Main,Usopp,0,0,0,,Akıl almaz bir sebepten dolayı\Nkendileri bize sırt çevirdi!
Dialogue: 0,0:13:16.41,0:13:20.11,Main,Brook,0,0,0,,Bu kadar istiyorsanız, \Nistediğiniz kadarınıza karşı koyabilirim.
Dialogue: 0,0:13:21.98,0:13:23.82,Main,Guard,0,0,0,,Kaptanları yokken bile bu kadar güçlüler!
Dialogue: 0,0:13:23.82,0:13:25.32,Main,Guard,0,0,0,,Ç-Çok güçlüler!
Dialogue: 0,0:13:25.32,0:13:29.22,Main,Usopp,0,0,0,,İleride yapacağımız ya da\Nyapmayacağımız şeyden dolayı...
Dialogue: 0,0:13:29.22,0:13:34.13,Main,Usopp,0,0,0,,...gerçekten bizi tutuklamanıza izin\Nvereceğimizi mi sanıyorsunuz?!
Dialogue: 0,0:13:34.13,0:13:37.53,Main,Pappagg,0,0,0,,Burunlu adam hep bu kadar güvenilir miydi?!
Dialogue: 0,0:13:37.81,0:13:41.83,Main,Left Minister,0,0,0,,Gördünüz mü?! Bu sadece kehanette\Nbelirtilen geleceğin başlangıcı!
Dialogue: 0,0:13:41.83,0:13:43.44,Main,Usopp,0,0,0,,Şu konuşana bak!
Dialogue: 0,0:13:43.44,0:13:47.96,Main,Usopp,0,0,0,,Bize saldırmasaydınız, \Nsizinle dövüşmek için sebebimiz yoktu!
Dialogue: 0,0:13:49.84,0:13:56.06,Main,Usopp,0,0,0,,Gerçi bu adamlar, Boin Takımadaları'ndaki\Ndev böceklerin yanından bile geçmez!
Dialogue: 0,0:13:59.74,0:14:04.14,Main,Usopp,0,0,0,,Yeni silahım Siyah Kabuto'nun gücünü seyredin!
Dialogue: 0,0:14:04.14,0:14:06.22,Main,Usopp,0,0,0,,Bana istediğiniz yerden gelin!
Dialogue: 0,0:14:07.11,0:14:10.60,Main,Left Minister,0,0,0,,Neptune-sama, lütfen bize yardım et!
Dialogue: 0,0:14:11.94,0:14:16.70,Main,Neptune,0,0,0,,Sırf kehanet nedeniyle birini\Ntutuklamak gerçekten doğru mu?
Dialogue: 0,0:14:17.91,0:14:22.53,Main,Neptune,0,0,0,,Bunu düşünmek için biraz zaman istiyorum-jamon!
Dialogue: 0,0:14:22.53,0:14:28.11,Main,Neptune,0,0,0,,Bu nedenle şimdilik yakalanmanıza\Nizin vermenizi istiyorum!
Dialogue: 0,0:14:29.25,0:14:30.73,Main,Brook,0,0,0,,Epey heybetli bir hasım!
Dialogue: 0,0:14:38.54,0:14:39.89,Main,Nami,0,0,0,,Zoro?!
Dialogue: 0,0:14:39.89,0:14:42.09,Main,Usopp,0,0,0,,Hücrede olduğunu sanıyordum?!
Dialogue: 0,0:14:42.09,0:14:45.49,Main,Zoro,0,0,0,,Festival müziği duydum...
Dialogue: 0,0:14:45.49,0:14:47.50,Main,Zoro,0,0,0,,...ve geldim!
Dialogue: 0,0:14:47.50,0:14:50.12,Main,Decken,0,0,0,,{\an8}Burada bekle, Wadatsumi.
Dialogue: 0,0:14:49.48,0:14:52.72,Captions,Sign,0,0,180,,{\fad(500,0)}Balık Adam Bölgesi, "Noah"
Dialogue: 0,0:14:50.12,0:14:52.72,Main,Wadatsumi,0,0,0,,{\an8}Tamam, anlaşıldı.
Dialogue: 0,0:14:54.84,0:14:57.78,Main,Fishman,0,0,0,,Vander Decken-sama geldi!
Dialogue: 0,0:15:00.68,0:15:02.40,Main,Fishman,0,0,0,,Bu taraftan.
Dialogue: 0,0:15:02.40,0:15:04.70,Main,Decken,0,0,0,,Gecikme için kusura bakmayın.
Dialogue: 0,0:15:04.70,0:15:07.82,Main,Decken,0,0,0,,Gelirken volkan patlamasına denk geldim.
Dialogue: 0,0:15:07.82,0:15:13.06,Main,Decken,0,0,0,,Buranın sahibi sen misin? \NKötü şöhretli Hody,...
Dialogue: 0,0:15:13.06,0:15:15.09,Main,Decken,0,0,0,,Öyle tahmin ediyorum.
Dialogue: 0,0:15:15.09,0:15:18.20,Main,Hody,0,0,0,,En az senin kadar kötü şöhretli.
Dialogue: 0,0:15:18.20,0:15:22.03,Main,Hody,0,0,0,,Deli Vander Decken.
Dialogue: 0,0:15:23.76,0:15:25.16,Main,Hody,0,0,0,,Seninle çalışmak güzel.
Dialogue: 0,0:15:25.16,0:15:27.24,Main,Decken,0,0,0,,Oh, tokalaşmak mı?
Dialogue: 0,0:15:27.24,0:15:31.01,Main,Decken,0,0,0,,Bu sorun olur. Dur biraz.
Dialogue: 0,0:15:33.33,0:15:34.58,Main,Decken,0,0,0,,Şimdi olur.
Dialogue: 0,0:15:36.28,0:15:37.76,Main,Decken,0,0,0,,Oh, dert etme!
Dialogue: 0,0:15:37.76,0:15:39.42,Main,Decken,0,0,0,,O keyif bana ait.
Dialogue: 0,0:15:40.54,0:15:44.26,Main,Decken,0,0,0,,Tanıştığıma sevindim, Hody Jones.
Dialogue: 0,0:15:47.46,0:15:50.34,Main,Zeo,0,0,0,,Artık okyanus tabanındaki\Nhiç kimse bize karşı koyamaz.
Dialogue: 0,0:15:50.34,0:15:53.46,Main,Daruma,0,0,0,,Tüm tehlikeli adamlar burada toplandı!
Dialogue: 0,0:15:53.46,0:15:55.64,Main,Fishmen,0,0,0,,{\i1}Decken! Decken!
Dialogue: 0,0:15:55.64,0:15:57.67,Main,Fishmen,0,0,0,,{\i1}Hody! Hody!
Dialogue: 0,0:15:59.17,0:16:04.34,Main,Hody,0,0,0,,Neptune ikimiz için de baş belası.
Dialogue: 0,0:16:04.34,0:16:07.41,Main,Decken,0,0,0,,İkimiz de aynı amacı paylaşıyoruz.
Dialogue: 0,0:16:07.41,0:16:13.55,Main,Hody,0,0,0,,Ne deniz halkının ne de deniz adamlarının onuruna\Nsahip olmayan Neptune Ordusu'nu ezmek için,...
Dialogue: 0,0:16:13.55,0:16:17.60,Main,Decken,0,0,0,,...Deniz Tanrısı Neptune'un başını almak için...
Dialogue: 0,0:16:17.60,0:16:19.32,Main,Hody,0,0,0,,...ve...
Dialogue: 0,0:16:19.32,0:16:21.66,Main,Decken,0,0,0,,...Ryugu Krallığı'nı...
Dialogue: 0,0:16:21.66,0:16:24.32,Main,Both,0,0,0,,{\i1}...mahvetmek için!
Dialogue: 0,0:16:34.77,0:16:38.07,Main,Pappagg,0,0,0,,Sen ne yaptın?!
Dialogue: 0,0:16:38.07,0:16:40.13,Main,Usopp,0,0,0,,Gerçekten,...
Dialogue: 0,0:16:40.13,0:16:41.48,Main,Usopp,0,0,0,,...biraz fazla ileri gittin!
Dialogue: 0,0:16:41.48,0:16:44.28,Main,Brook,0,0,0,,Kesinlikle! Yaptıkların için özür dile!
Dialogue: 0,0:16:44.28,0:16:48.65,Main,Zoro,0,0,0,,Bu dövüşü başlatan sizdiniz!\NBu işte birlikteyiz, aptallar!
Dialogue: 0,0:16:48.65,0:16:52.15,Main,Usopp,0,0,0,,Biz sadece onları tehdit\Nedip kaçmak istedik!
Dialogue: 0,0:16:53.39,0:16:57.21,Main,Nami,0,0,0,,Bense sadece gezintiye çıkıp\Nalışveriş yapmak istemiştim.
Dialogue: 0,0:16:57.21,0:17:00.35,Main,Zoro,0,0,0,,Evet, artık olan oldu, şimdi ne yapabiliriz?
Dialogue: 0,0:17:00.35,0:17:01.39,Main,Zoro,0,0,0,,Sızlanmayı kesin!
Dialogue: 0,0:17:01.39,0:17:04.07,Main,Usopp,0,0,0,,"Şimdi ne yapabiliriz" mi?!\NSence bu yeterince iyi mi?!
Dialogue: 0,0:17:04.07,0:17:06.98,Main,Usopp,0,0,0,,Geçerken Balık Adam Adası'na uğramak ve\Ngelişigüzel Ryugu Sarayı'nı işgal etmek...
Dialogue: 0,0:17:06.98,0:17:09.69,Main,Usopp,0,0,0,,Daha ne kadar acımasız olabilirsin?!
Dialogue: 0,0:17:09.69,0:17:11.44,Main,Neptune,0,0,0,,Ah...
Dialogue: 0,0:17:11.44,0:17:13.48,Main,Zoro,0,0,0,,O zaman bizi tutuklamalarına izin mi verseydik?!
Dialogue: 0,0:17:13.48,0:17:16.75,Main,Usopp,0,0,0,,Dediğim gibi, onları tehdit edip kaçmalıydık!
Dialogue: 0,0:17:16.75,0:17:20.25,Main,Zoro,0,0,0,,Öncelikle nasıl kaçabileceğimizi bilmiyoruz. \Nİkincisi, Luffy burada değil!
Dialogue: 0,0:17:20.25,0:17:22.87,Main,Usopp,0,0,0,,Evet, doğru, Luffy yok!
Dialogue: 0,0:17:22.87,0:17:24.20,Main,Usopp,0,0,0,,Nereye gitti bu?
Dialogue: 0,0:17:24.20,0:17:25.59,Main,Brook,0,0,0,,Gerçekten nereye gitti?
Dialogue: 0,0:17:26.09,0:17:29.61,Main,Nami,0,0,0,,Gerçekten acelemiz var.\NBu yüzden inadı bırakıp söyleyin.
Dialogue: 0,0:17:29.61,0:17:32.03,Main,Usopp,0,0,0,,Evet, Luffy'yi bulmalıyız!
Dialogue: 0,0:17:32.24,0:17:33.66,Main,Nami,0,0,0,,Hazine odası nerede?
Dialogue: 0,0:17:33.66,0:17:34.83,Main,Usopp,0,0,0,,Kes şunu!
Dialogue: 0,0:17:35.24,0:17:36.91,Main,Nami,0,0,0,,Ne? Niye?
Dialogue: 0,0:17:36.91,0:17:40.34,Main,Usopp,0,0,0,,Neden masum numarası yapıyorsun?!\Nİçinde bulunduğumuz durumu düşün!
Dialogue: 0,0:17:42.14,0:17:43.94,Main,Brook,0,0,0,,Pekâlâ, millet!
Dialogue: 0,0:17:43.94,0:17:46.72,Main,Brook,0,0,0,,Bu zor zamanda, şarkı söyleyip mutlu olalım!
Dialogue: 0,0:17:46.72,0:17:48.09,Main,Brook,0,0,0,,Hadi!
Dialogue: 0,0:17:48.64,0:17:52.01,We Go lyrics,Brook,0,0,0,,♪ İşler nasılsa yoluna girer, nasılsa yoluna girer. ♪
Dialogue: 0,0:17:52.01,0:17:55.40,We Go lyrics,Brook,0,0,0,,♪ Girmese bile, zaten bir gün öleceğiz! ♪
Dialogue: 0,0:17:55.40,0:17:56.15,Main,Brook,0,0,0,,Evet!
Dialogue: 0,0:17:56.15,0:17:58.52,Main,Usopp,0,0,0,,Sen çeneni kapa, Soul Kralı!
Dialogue: 0,0:17:58.52,0:18:01.33,Main,Right Minister,0,0,0,,Neptune-sama, iyi misiniz?!
Dialogue: 0,0:18:01.33,0:18:05.54,Main,Right Minister,0,0,0,,Denizin şampiyonu Neptune-sama'nın\Nbu hâle gelmesine inanamıyorum.
Dialogue: 0,0:18:06.82,0:18:10.47,Main,Neptune,0,0,0,,Aniden kalçama ağrı saplandı,\Nbu yüzden dövüşemedim.
Dialogue: 0,0:18:10.47,0:18:12.74,Main,Neptune,0,0,0,,G-Gerçekten yaşlanmışım.
Dialogue: 0,0:18:12.74,0:18:14.14,Main,Neptune,0,0,0,,Büyük bir hata-jamon!
Dialogue: 0,0:18:14.14,0:18:15.44,Main,Neptune,0,0,0,,Üzgünüm!
Dialogue: 0,0:18:16.28,0:18:21.62,Main,Right Minister,0,0,0,,Elimizi çabuk tutup kabarcıklarını patlatmalı\Nve bunu su altı mücadelesinne çevirmeliydik.
Dialogue: 0,0:18:21.62,0:18:24.54,Main,Right Minister,0,0,0,,Ama sudan tamamen kurtulmayı başardılar!
Dialogue: 0,0:18:24.54,0:18:26.27,Main,Right Minister,0,0,0,,Dinleyin pislikler!
Dialogue: 0,0:18:26.27,0:18:28.34,Main,Right Minister,0,0,0,,Neptune Ordusu'nun üç kardeşi\NPrens Fukaboshi, Prens Ryuuboshi...
Dialogue: 0,0:18:28.34,0:18:32.18,Main,Right Minister,0,0,0,,...ve Prens Manboshi dönünce,...
Dialogue: 0,0:18:32.18,0:18:35.46,Main,Right Minister,0,0,0,,...buna pişman olacaksınız!
Dialogue: 0,0:18:39.13,0:18:42.92,Main,Zoro,0,0,0,,Yine de artık Balık Adam Adası'nda kalamayız.
Dialogue: 0,0:18:42.92,0:18:47.13,Main,Zoro,0,0,0,,Sunny nerede? \NHerkesi toplayıp yola çıkmalıyız.
Dialogue: 0,0:18:47.13,0:18:52.04,Main,Usopp,0,0,0,,Ama adaya girerken Sunny'nin\Nkaplaması parçalanmıştı.
Dialogue: 0,0:18:52.42,0:18:54.88,Main,Nami,0,0,0,,Seyir Pusulası da tuhaf davranıyor.
Dialogue: 0,0:18:55.10,0:18:58.68,Main,Nami,0,0,0,,Buraya geldiğimizden beri, \Nhiç sabitlenme belirtisi göstermedi.
Dialogue: 0,0:18:58.68,0:19:04.24,Main,Left Minister,0,0,0,,İşe yaramaz. Yeni Dünya'da öylesine\Nbasit bir Pusula ile yol alamazsınız.
Dialogue: 0,0:19:04.24,0:19:06.32,Main,Left Minister,0,0,0,,Sizi cahil korsanlar.
Dialogue: 0,0:19:06.32,0:19:08.52,Main,Nami,0,0,0,,Ha? Bu işe yaramaz mı?
Dialogue: 0,0:19:08.52,0:19:09.70,Main,Nami,0,0,0,,Ne demek istiyorsun?
Dialogue: 0,0:19:09.70,0:19:13.26,Main,Left Minister,0,0,0,,Beni çözerseniz söylerim.
Dialogue: 0,0:19:16.23,0:19:18.10,Main,Right Minister,0,0,0,,Prens Fukaboshi olmalı!
Dialogue: 0,0:19:23.41,0:19:28.48,Secondary,Manboshi,0,0,0,,{\an8}Akkamanbo! Yaşasın! Yaşasın!
Dialogue: 0,0:19:24.00,0:19:26.12,Main,Fukaboshi,0,0,0,,Hmm? Çok tuhaf.
Dialogue: 0,0:19:26.12,0:19:28.47,Main,Fukaboshi,0,0,0,,Muhafızlar ne yapıyor olabilir?
Dialogue: 0,0:19:29.75,0:19:31.68,Main,Zoro,0,0,0,,Evet, kimsin?
Dialogue: 0,0:19:32.82,0:19:34.12,Main,Usopp,0,0,0,,Hey! Neden cevap veriyorsun?!
Dialogue: 0,0:19:34.12,0:19:36.14,Main,Right Minister,0,0,0,,Prens Fukaboshi!
Dialogue: 0,0:19:36.14,0:19:37.44,Main,Left Minister,0,0,0,,Bize yardım edin!
Dialogue: 0,0:19:37.44,0:19:39.02,Main,Zoro,0,0,0,,Sessiz olun!
Dialogue: 0,0:19:39.02,0:19:40.61,Main,Guards,0,0,0,,Prens Ryuuboshi!
Dialogue: 0,0:19:40.61,0:19:42.83,Main,Guards,0,0,0,,Prens Manboshi!
Dialogue: 0,0:19:42.83,0:19:47.55,Main,Ryuuboshi,0,0,0,,Ah! Bir şey olmuş olmalı-la-si-do!
Dialogue: 0,0:19:47.55,0:19:51.32,Main,Manboshi,0,0,0,,Bence de! Babam ve Shirahoshi iyi mi?!
Dialogue: 0,0:19:51.32,0:19:56.21,Main,Fukaboshi,0,0,0,,Benim, Fukaboshi. Orada neler oluyor?
Dialogue: 0,0:19:56.66,0:20:01.31,Main,Fukaboshi,0,0,0,,Bağlantı kanalını hemen indirin ve \Nbizi içeri alın.
Dialogue: 0,0:20:01.31,0:20:02.81,Main,Zoro,0,0,0,,Bunu yaparsak ne olacak?
Dialogue: 0,0:20:03.65,0:20:05.15,Main,Zoro,0,0,0,,Yapamayız!
Dialogue: 0,0:20:05.15,0:20:07.84,Main,Usopp,0,0,0,,H-Hey! Ne diyorsun?!
Dialogue: 0,0:20:07.84,0:20:09.64,Main,Usopp,0,0,0,,Durumu onlara izah et!
Dialogue: 0,0:20:10.21,0:20:13.14,Main,Pappagg,0,0,0,,Evet! O zaman beni ve Caimie'yi de bağlayın!
Dialogue: 0,0:20:13.14,0:20:14.35,Main,Pappagg,0,0,0,,Suç ortağınız olarak görülmek istemiyoruz!
Dialogue: 0,0:20:14.35,0:20:16.74,Main,Caimie,0,0,0,,Zoro-chin, beni korkutuyorsun!
Dialogue: 0,0:20:17.84,0:20:20.77,Main,Fukaboshi,0,0,0,,Yoksa sen, \NHasır Şapka'nın arkadaşlarından biri misin?
Dialogue: 0,0:20:20.77,0:20:24.82,Main,Neptune,0,0,0,,Fukaboshi! O, Hasır Şapka Tayfası'ndan \Nüç kılıçlı kılıç ustası.
Dialogue: 0,0:20:24.82,0:20:26.61,Main,Neptune,0,0,0,,Korsan Avcısı Zori!
Dialogue: 0,0:20:26.61,0:20:27.57,Main,Zoro,0,0,0,,Zoro!
Dialogue: 0,0:20:27.57,0:20:28.84,Main,Fukaboshi,0,0,0,,Baba?!
Dialogue: 0,0:20:28.84,0:20:34.58,Main,Zoro,0,0,0,,Duyuyor musun? Neptune de dahil\Nolmak üzere bir sürü rehinemiz var!
Dialogue: 0,0:20:35.04,0:20:40.15,Main,Zoro,0,0,0,,Yaşamalarını istiyorsan, \Nyola çıkmamız için hazırlık yapmaya başla!
Dialogue: 0,0:20:40.15,0:20:45.01,Main,Zoro,0,0,0,,İhtiyacımız olan şey, \Ngemimiz Sunny'nin yeniden kaplanması.
Dialogue: 0,0:20:45.01,0:20:49.02,Main,Zoro,0,0,0,,Nerede olduğunu bilmiyoruz,\Nbu yüzden gidip bulun.
Dialogue: 0,0:20:49.02,0:20:50.84,Main,Zoro,0,0,0,,Bir de tayfamızın geri kalanı.
Dialogue: 0,0:20:50.84,0:20:53.68,Main,Zoro,0,0,0,,Kasvetli bir kadın. Bir robot.
Dialogue: 0,0:20:53.68,0:20:56.67,Main,Zoro,0,0,0,,Rakun köpek ve sapık su şeytanı.
Dialogue: 0,0:20:56.67,0:20:59.00,Main,Nami,0,0,0,,Oh, Zoro! Bir de bir milyar beli.
Dialogue: 0,0:20:59.00,0:21:00.71,Main,Usopp,0,0,0,,Kes şunu, lanet olsun!
Dialogue: 0,0:21:00.71,0:21:02.94,Main,Brook,0,0,0,,Sapık su şeytanı! Ne kadar uygun!
Dialogue: 0,0:21:02.94,0:21:04.62,Main,Brook,0,0,0,,Bu ona tam uyuyor!
Dialogue: 0,0:21:04.62,0:21:06.44,Main,Usopp,0,0,0,,Gülecek zaman değil!
Dialogue: 0,0:21:06.44,0:21:07.76,Main,Brook,0,0,0,,Sapık su şeytanı!
Dialogue: 0,0:21:07.76,0:21:10.05,Main,Usopp,0,0,0,,Hadi ama! En azından \N"kasvetli kadın" yorumuyla da uğraş.
Dialogue: 0,0:21:10.05,0:21:12.35,Main,Fukaboshi,0,0,0,,Şartlarınızı anlıyorum.
Dialogue: 0,0:21:12.35,0:21:18.46,Main,Fukaboshi,0,0,0,,Senin ve tayfanın krallıktan sağ salim\Nayrılabilmesi için gereken düzenlemeleri yapacağım.
Dialogue: 0,0:21:18.46,0:21:23.76,Main,Fukaboshi,0,0,0,,Ancak tüm rehineleri zarar\Nvermeden iade etmelisin!
Dialogue: 0,0:21:23.76,0:21:24.88,Main,Ryuuboshi & Manboshi,0,0,0,,Abi!
Dialogue: 0,0:21:24.88,0:21:26.72,Main,Fukaboshi,0,0,0,,Başka çaremiz yok.
Dialogue: 0,0:21:26.72,0:21:32.81,Main,Fukaboshi,0,0,0,,Ryugu Sarayı'na girmenin\Ntek yolu bağlantı kanalları.
Dialogue: 0,0:21:32.81,0:21:39.14,Main,Fukaboshi,0,0,0,,Diğer her yer, yarıp geçemeyeceğimiz\Nkalın kabarcık katmanıyla korunuyor.
Dialogue: 0,0:21:39.14,0:21:40.98,Main,Fukaboshi,0,0,0,,Bir şey daha söyleyebilir miyim, Zoro-kun?
Dialogue: 0,0:21:41.91,0:21:46.52,Main,Fukaboshi,0,0,0,,Bu durumda söylememeyi tercih ederdim,...
Dialogue: 0,0:21:46.52,0:21:49.85,Main,Fukaboshi,0,0,0,,...ama Jinbe'ye olan borcuma leke süremem.
Dialogue: 0,0:21:49.85,0:21:55.53,Main,Fukaboshi,0,0,0,,Eski Shichibukai Deniz Şövalyesi Jinbe'den, \NHasır Şapkalı Luffy'ye.
Dialogue: 0,0:21:55.53,0:21:59.60,Main,Fukaboshi,0,0,0,,Bu adaya geldiğinizde size şunu söylememiz istedi.
Dialogue: 0,0:21:59.60,0:22:02.03,Main,Fukaboshi,0,0,0,,İki mesaj ileteceğim.
Dialogue: 0,0:22:02.03,0:22:03.47,Main,Neptune,0,0,0,,Jinbe, ha?
Dialogue: 0,0:22:03.47,0:22:04.87,Main,Left Minister,0,0,0,,Jinbe?!
Dialogue: 0,0:22:04.87,0:22:06.47,Main,Guard,0,0,0,,Patron Jinbe.
Dialogue: 0,0:22:08.25,0:22:12.28,Main,Usopp,0,0,0,,Sahi, Jinbe'nin arkadaşı olduğunu söylemişti.
Dialogue: 0,0:22:12.28,0:22:16.45,Main,Caimie,0,0,0,,Korsan olmasına rağmen, \Nadadaki herkesin güvendiği müthiş biridir.
Dialogue: 0,0:22:16.45,0:22:21.91,Main,Zoro,0,0,0,,Luffy şu anda burada değil ama \Nmesajı kendisine ileteceğim.
Dialogue: 0,0:22:21.91,0:22:22.69,Main,Zoro,0,0,0,,Söyle.
Dialogue: 0,0:22:23.64,0:22:25.64,Main,Fukaboshi,0,0,0,,İlk mesaj,...
Dialogue: 0,0:22:25.64,0:22:28.53,Main,Fukaboshi,0,0,0,,..."Hody'yle dövüşme."
Dialogue: 0,0:22:28.53,0:22:30.94,Main,Fukaboshi,0,0,0,,İkincisi,...
Dialogue: 0,0:22:30.94,0:22:33.50,Main,Fukaboshi,0,0,0,,..."Deniz Ormanı'nda seni bekliyor olacağım."
Dialogue: 0,0:22:33.86,0:22:36.17,Main,Fukaboshi,0,0,0,,Hepsi bu.
Dialogue: 0,0:22:36.54,0:22:41.31,Main,Zoro,0,0,0,,Deniz Ormanı... Hody...
Dialogue: 0,0:22:44.21,0:22:49.20,Captions,Sign,0,0,220,,{\fad(700,400)}Mercan Tepesi\NBalık Adam Adası
Dialogue: 0,0:22:46.42,0:22:47.79,Main,Fishman,0,0,0,,{\an8}Gerçekten yapmışlar!
Dialogue: 0,0:22:47.79,0:22:51.48,Main,Fishman,0,0,0,,{\an8}Görünüşe bakılırsa, Hasır Şapka Korsanları\NRyugu Sarayı'nı istila etmiş!
Dialogue: 0,0:22:51.48,0:22:52.32,Main,Fishman,0,0,0,,{\an8}Ne?!
Dialogue: 0,0:22:52.32,0:22:54.60,Main,Fishman,0,0,0,,{\an8}Amaçları neymiş?!
Dialogue: 0,0:22:54.60,0:22:58.50,Main,Mermaid,0,0,0,,Olamaz! Çok iyi insanlara benziyorlardı.
Dialogue: 0,0:22:58.50,0:23:00.69,Main,Mermaid,0,0,0,,Nasıl yapabilirler?
Dialogue: 0,0:23:01.24,0:23:05.05,Main,Fishman,0,0,0,,Koydaki kızların kaçırılması ve kehanetteki\Ngelecek göz önünde bulundurulursa,...
Dialogue: 0,0:23:05.05,0:23:08.89,Main,Fishman,0,0,0,,...onlar olmalı! Olaylar o yönde ilerliyor!
Dialogue: 0,0:23:08.89,0:23:11.55,Main,Fishman,0,0,0,,Sonunda asıl benliklerini gösterdiler!
Dialogue: 0,0:23:11.55,0:23:15.51,Main,Fishman,0,0,0,,Galiba Hasır Şapka'nın arkadaşlarından\Nikisi Deniz Kızı Kafe'nin arka odasındalarmış.
Dialogue: 0,0:23:15.51,0:23:17.80,Main,Fishman,0,0,0,,Muhafızlar onları yakalamaya gitti.
Dialogue: 0,0:23:23.08,0:23:24.98,Main,Chopper,0,0,0,,{\fad(150,150)}Kung Fu Point!
Dialogue: 0,0:23:23.08,0:23:24.98,Attack,Chopper,0,0,0,,{\fad(150,150)}Kung Fu Noktası
Dialogue: 0,0:23:30.41,0:23:33.35,Main,Chopper,0,0,0,,Sanji daha iyileşiyor! Ona dokunmayın!
Dialogue: 0,0:23:36.60,0:23:41.61,Main,Chopper,0,0,0,,"Ryugu Sarayı'na gelin" de ne demek oluyor?!\NBizi tutuklamak istiyorsunuz, değil mi?!
Dialogue: 0,0:23:42.07,0:23:44.34,Main,Sanji,0,0,0,,Hey... siz...
Dialogue: 0,0:23:45.04,0:23:48.11,Main,Chopper,0,0,0,,Sanji! Hareket etmemen lazım!
Dialogue: 0,0:23:48.11,0:23:52.90,Main,Sanji,0,0,0,,Yani, Ryugu Sarayı denen yerde var mı?
Dialogue: 0,0:23:53.58,0:23:56.18,Main,Sanji,0,0,0,,Deniz Kızı Prenses işte!
Dialogue: 0,0:23:56.18,0:23:58.72,Main,Ammo Knight,0,0,0,,Orada! N'olmuş yani?!
Dialogue: 0,0:23:58.72,0:24:00.50,Main,Sanji,0,0,0,,Hayatıma mâl olsa da gideceğim.
Dialogue: 0,0:24:00.50,0:24:02.76,Main,Chopper,0,0,0,,Gidecek misin?! Hiç akıllanmayacaksın.
Dialogue: 0,0:24:02.76,0:24:05.32,Main,Chopper,0,0,0,,Güzel birisiyse, ölürsün!
Dialogue: 0,0:24:05.39,0:24:09.54,Captions,,0,0,220,,{\fad(350,350)}Ryugu Sarayı\N"Koukaku Kulesi"
Dialogue: 0,0:24:06.36,0:24:09.20,Main,Luffy,0,0,0,,{\an8}Hey! Daha düşünmeyi bitirmedin mi?
Dialogue: 0,0:24:09.20,0:24:10.76,Main,Luffy,0,0,0,,{\an8}Dışarı çıkalım!
Dialogue: 0,0:24:10.76,0:24:13.20,Main,Shirahoshi,0,0,0,,Gerçekten yapamam.
Dialogue: 0,0:24:13.20,0:24:17.06,Main,Luffy,0,0,0,,Niye olmasın?! Gitmek istediğin\Nyerler olduğunu söyledin, değil mi?
Dialogue: 0,0:24:17.06,0:24:21.26,Main,Shirahoshi,0,0,0,,Ama bu kadar bencilce şeyler yaparsam,...
Dialogue: 0,0:24:21.26,0:24:24.66,Main,Shirahoshi,0,0,0,,...kaledeki herkesin başına iş açacağım.
Dialogue: 0,0:24:24.66,0:24:29.95,Main,Luffy,0,0,0,,On yıl boyunca buraya kapatılsaydım, delirirdim.
Dialogue: 0,0:24:29.95,0:24:31.66,Main,Luffy,0,0,0,,Yemeğe karşılık teşekkür olarak gör.
Dialogue: 0,0:24:31.66,0:24:34.80,Main,Luffy,0,0,0,,Yanında olacağım, peki nereye gitmek istiyorsun?
Dialogue: 0,0:24:37.74,0:24:38.69,Main,Shirahoshi,0,0,0,,Ah... şey...
Dialogue: 0,0:24:40.46,0:24:42.56,Main,Shirahoshi,0,0,0,,Deniz Ormanı'na!
Dialogue: 0,0:24:43.84,0:24:45.94,Main,Shirahoshi,0,0,0,,Hayır, ama...
Dialogue: 0,0:24:45.94,0:24:47.70,Main,Shirahoshi,0,0,0,,...bu sadece bir hayal.
Dialogue: 0,0:24:47.70,0:24:52.28,Main,Shirahoshi,0,0,0,,Buradan çıkmak kadar bencilce\Nbir şey yapmam mümkün değil.
Dialogue: 0,0:24:52.28,0:24:56.07,Main,Luffy,0,0,0,,Sırf gitmek istediğin yeri söyleyerek\Nneden ağlamaya başlıyorsun?!
Dialogue: 0,0:24:57.02,0:24:58.82,Main,Shirahoshi,0,0,0,,Ü-Üzgünüm.
Dialogue: 0,0:24:58.82,0:25:01.62,Main,Shirahoshi,0,0,0,,Sırf bunu söylemek için bile\Nçok cesaret toplamam gerekti.
Dialogue: 0,0:25:01.62,0:25:05.15,Main,Shirahoshi,0,0,0,,Lütfen bana kızma!
Dialogue: 0,0:25:05.15,0:25:06.98,Main,Shirahoshi,0,0,0,,Korkunçsun, Luffy-sama!
Dialogue: 0,0:25:06.98,0:25:08.62,Main,Luffy,0,0,0,,Çok can sıkıcısın!
Dialogue: 0,0:25:09.78,0:25:12.09,Main,Luffy,0,0,0,,Ne?! O gürültü de neydi?!
Dialogue: 0,0:25:12.68,0:25:15.26,Main,Luffy,0,0,0,,Yine mi bize bir şey fırlatıyor?
Dialogue: 0,0:25:15.26,0:25:17.06,Main,Luffy,0,0,0,,Ne kaba adam.
Dialogue: 0,0:25:21.84,0:25:22.97,Main,Usopp,0,0,0,,O da ne?
Dialogue: 0,0:25:22.97,0:25:24.85,Main,Neptune,0,0,0,,O ses de ne-jamon?
Dialogue: 0,0:25:24.85,0:25:27.12,Main,Neptune,0,0,0,,Yoksa Decken'in işi mi?!
Dialogue: 0,0:25:27.12,0:25:30.70,Main,Neptune,0,0,0,,Koukaku Kulesi'nden geliyor-jamon!\NShirahoshi tehlikede!
Dialogue: 0,0:25:30.70,0:25:33.38,Main,Neptune,0,0,0,,Muhafızlar onun yanında mı?!
Dialogue: 0,0:25:33.38,0:25:36.08,Main,Right Minister,0,0,0,,Hayır, hepsi burada bağlı vaziyette!
Dialogue: 0,0:25:36.08,0:25:37.80,Main,Neptune,0,0,0,,Hey, korsanlar!
Dialogue: 0,0:25:37.80,0:25:41.46,Main,Neptune,0,0,0,,Muhafızların yerine gidip\Nprensesin güvenliğini sağlayın!
Dialogue: 0,0:25:41.46,0:25:43.46,Main,Zoro,0,0,0,,Ha? Neden bahsediyorsun?
Dialogue: 0,0:25:43.46,0:25:47.00,Main,Guard,0,0,0,,Ama Neptune-sama! Bu, prenses konusunda\Nbilgi sahibi olmalarına izin vermek anlamına gelir!
Dialogue: 0,0:25:47.00,0:25:49.86,Main,Neptune,0,0,0,,Başka çaremiz mi var?!
Dialogue: 0,0:25:49.86,0:25:53.38,Main,Neptune,0,0,0,,Koukaku Kulesi, sarayın kuzeydoğusunda!
Dialogue: 0,0:25:53.38,0:25:55.96,Main,Neptune,0,0,0,,Hepiniz oraya gidin!
Dialogue: 0,0:25:55.96,0:25:59.07,Main,Zoro,0,0,0,,Neden rehinemizden emir almak zorundayız?
Dialogue: 0,0:25:59.07,0:26:02.84,Main,Neptune,0,0,0,,Sessizlik! Shirahoshi benim tek kızım!
Dialogue: 0,0:26:02.84,0:26:06.38,Main,Neptune,0,0,0,,Bu nedenle sürekli hedef alınıyor!
Dialogue: 0,0:26:06.38,0:26:12.62,Main,Neptune,0,0,0,,Kızıma bir şey olursa, \Nsize derin denizin dibini boylatırım!
Dialogue: 0,0:26:12.62,0:26:18.24,Main,Brook,0,0,0,,Yani kısacası Deniz Kızı Prensesi? Haklı mıyım?
Dialogue: 0,0:26:18.24,0:26:22.36,Main,Brook,0,0,0,,Öyleyse en kısa sürede kendisine gideceğim!
Dialogue: 0,0:26:22.36,0:26:23.11,Main,Brook,0,0,0,,Sonra da...
Dialogue: 0,0:26:24.51,0:26:28.03,Main,Brook,0,0,0,,Acaba bana külotunu gösterir mi?
Dialogue: 0,0:26:28.60,0:26:30.50,Main,Usopp,0,0,0,,Hey, dur, Brook!
Dialogue: 0,0:26:30.50,0:26:36.66,Main,Left Minister,0,0,0,,Oh, ne yapacağız?! \NEdepsiz amaçlarla alıp başını gitti!
Dialogue: 0,0:26:36.66,0:26:39.00,Main,Left Minister,0,0,0,,Şimdi prenses tamamen farklı\Nbir sebepten tehlike içinde!
Dialogue: 0,0:26:39.00,0:26:40.72,Main,Right Minister,0,0,0,,Dur, iskelet!
Dialogue: 0,0:26:40.72,0:26:44.33,Main,Right Minister,0,0,0,,Bağlarımı çözmeyebilirsin ama \Nlütfen beni de götür!
Dialogue: 0,0:26:44.33,0:26:46.40,Main,Right Minister,0,0,0,,Koukaku Kulesi benim yetki alanımda.
Dialogue: 0,0:26:46.40,0:26:50.95,Main,Right Minister,0,0,0,,Prensese bir şey olursa, asla huzur bulamayacağım. Öldüğüm zaman bile!
Dialogue: 0,0:26:54.22,0:26:56.49,Main,Brook,0,0,0,,Sen...
Dialogue: 0,0:26:56.49,0:26:59.23,Main,Brook,0,0,0,,...onu...
Dialogue: 0,0:26:59.23,0:27:00.72,Main,Brook,0,0,0,,...gerçekten seviyorsun, değil mi?
Dialogue: 0,0:27:00.72,0:27:02.12,Main,Right Minister,0,0,0,,Saçmalama!
Dialogue: 0,0:27:02.12,0:27:03.28,Main,Left Minister,0,0,0,,Bu ne utanmazlık!
Dialogue: 0,0:27:03.28,0:27:05.04,Main,Right Minister,0,0,0,,Hayır!
Dialogue: 0,0:27:05.04,0:27:08.06,Main,Brook,0,0,0,,Sanji-san, kusura bakmazsan\Noraya ilk ben gideceğim!
Dialogue: 0,0:27:13.06,0:27:18.02,Main,Shirahoshi,0,0,0,,Hep Deniz Ormanı'na gitmek istedim.
Dialogue: 0,0:27:18.02,0:27:20.94,Main,Shirahoshi,0,0,0,,Bunca zamandır, on yıl boyunca.
Dialogue: 0,0:27:20.94,0:27:26.56,Main,Shirahoshi,0,0,0,,Ama... herkes kuleden ayrılmanın çok\Ntehlikeli olduğu konusunda beni uyarıyor.
Dialogue: 0,0:27:26.56,0:27:30.53,Main,Shirahoshi,0,0,0,,Bu yüzden dışarı çıkmaktan korkuyorum.
Dialogue: 0,0:27:30.53,0:27:36.16,Main,Shirahoshi,0,0,0,,Luffy-sama, gerçekten beni oraya götürecek misin?
Dialogue: 0,0:27:36.16,0:27:37.26,Main,Luffy,0,0,0,,Tabii.
Dialogue: 0,0:27:37.26,0:27:40.85,Main,Shirahoshi,0,0,0,,Gerçekten beni koruyacak mısın?
Dialogue: 0,0:27:40.85,0:27:43.71,Main,Luffy,0,0,0,,Bana bırak! Bir şey olmayacak!
Dialogue: 0,0:27:49.41,0:27:52.88,Main,Luffy,0,0,0,,Hey! Ağlayacaksan, \Nseni hiçbir yere götürmeyeceğim!
Dialogue: 0,0:27:52.88,0:27:56.68,Main,Luffy,0,0,0,,Üstelik, aslında sen beni\Noraya götürüyor olacaksın.
Dialogue: 0,0:27:56.68,0:27:58.52,Main,Luffy,0,0,0,,Sonuçta ben yüzemiyorum.
Dialogue: 0,0:27:58.52,0:28:02.89,Main,Shirahoshi,0,0,0,,Ç-Çok üzgünüm. Ben çok mutluyum.
Dialogue: 0,0:28:02.89,0:28:04.98,Main,Luffy,0,0,0,,Gerçekten sulugözsün, ha?
Dialogue: 0,0:28:04.98,0:28:06.13,Main,Luffy,0,0,0,,Hem de güçsüz.
Dialogue: 0,0:28:06.60,0:28:10.94,Main,Luffy,0,0,0,,Ama dışarı çıkarsak, çok göze\Nbatacağın için hemen farkedilirsin.
Dialogue: 0,0:28:10.94,0:28:12.97,Main,Shirahoshi,0,0,0,,Evet... Çok üzgünüm.
Dialogue: 0,0:28:12.97,0:28:16.14,Main,Luffy,0,0,0,,Bu yüzden bunu çözecek bir fikrim var!
Dialogue: 0,0:28:17.44,0:28:21.45,Main,Brook,0,0,0,,Deniz Kızı Prensesi! İyi misin?
Dialogue: 0,0:28:21.45,0:28:24.50,Main,Right Minister,0,0,0,,Hey, iskelet! Kulenin yanına bak!
Dialogue: 0,0:28:24.50,0:28:25.20,Main,Brook,0,0,0,,Ha?
Dialogue: 0,0:28:28.06,0:28:33.26,Main,Right Minister,0,0,0,,Bu delilik! Bunlar her zaman uçarak\Ngelen bıçaklar ya da baltalar değil!
Dialogue: 0,0:28:33.26,0:28:38.06,Main,Right Minister,0,0,0,,O ses, insan korsanların kuleye çarpma sesiymiş!
Dialogue: 0,0:28:38.06,0:28:39.70,Main,Right Minister,0,0,0,,Ne kadar acayip!
Dialogue: 0,0:28:39.70,0:28:43.16,Main,Right Minister,0,0,0,,Vander Decken delinin teki!
Dialogue: 0,0:28:43.16,0:28:46.14,Main,Brook,0,0,0,,Ne?! V-Vander Decken?!
Dialogue: 0,0:28:47.44,0:28:50.94,Main,Right Minister,0,0,0,,Bu hiç iyi değil! Ayağa kalkıyorlar!
Dialogue: 0,0:28:50.94,0:28:58.82,Main,Right Minister,0,0,0,,Bunun anlamı... Düşman askerleri, \Nsavunması aşılmaz Ryugu Sarayı'na girdi!
Dialogue: 0,0:28:58.82,0:29:03.14,Main,Right Minister,0,0,0,,Bu sinsi saldırı! Kral tehlikede!
Dialogue: 0,0:29:03.58,0:29:06.67,Main,Right Minister,0,0,0,,Prenses tehlikede!
Dialogue: 0,0:29:07.08,0:29:09.89,Main,Luffy,0,0,0,,Saldırı sesleri durdu, değil mi?
Dialogue: 0,0:29:09.89,0:29:11.76,Main,Luffy,0,0,0,,Gidelim, güçsüz!
Dialogue: 0,0:29:11.76,0:29:13.03,Main,Shirahoshi,0,0,0,,T-Tamam!
Dialogue: 0,0:29:13.03,0:29:15.02,Main,Shirahoshi,0,0,0,,Sana güveniyorum, Megalo!
Dialogue: 0,0:29:28.21,0:29:30.75,Main,Luffy,0,0,0,,Git, köpekbalığı!
Dialogue: 0,0:29:32.25,0:29:33.76,Main,Right Minister,0,0,0,,Megalo!
Dialogue: 0,0:29:33.76,0:29:35.02,Main,Brook,0,0,0,,Luffy-san!
Dialogue: 0,0:29:36.82,0:29:39.79,Main,Luffy,0,0,0,,Deniz Ormanı'na!
