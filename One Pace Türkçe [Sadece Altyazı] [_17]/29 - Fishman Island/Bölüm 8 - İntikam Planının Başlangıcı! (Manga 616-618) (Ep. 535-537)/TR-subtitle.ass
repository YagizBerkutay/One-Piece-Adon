Dialogue: 0,0:00:02.99,0:00:08.38,Main,,0,0,0,,Dünyanın sunabileceği her şeyi elde eden adam, Korsanlar Kralı Gold Roger.
Dialogue: 0,0:00:08.38,0:00:13.00,Main,,0,0,0,,Son sözleri dünyanın her yerinden\Nmaceracıları denize çekti.
Dialogue: 0,0:00:13.00,0:00:14.68,Main,,0,0,0,,"Hazinem mi?"
Dialogue: 0,0:00:14.68,0:00:16.22,Main,,0,0,0,,"İstiyorsanız, size vereceğim!"
Dialogue: 0,0:00:16.22,0:00:17.42,Main,,0,0,0,,"Arayın ve bulun!"
Dialogue: 0,0:00:17.42,0:00:19.87,Main,,0,0,0,,"Bu dünyanın sunabileceği her şeyi orada bıraktım!"
Dialogue: 0,0:00:19.87,0:00:22.69,Main,,0,0,0,,Korsanlar hayallerinin peşinden yola çıktılar!
Dialogue: 0,0:00:22.69,0:00:25.35,Main,,0,0,0,,Dünya, Büyük Korsan Çağı'na girdi!
Dialogue: 0,0:02:36.89,0:02:38.65,Main,Luffy,0,0,0,,Buraya doğru uçan bir şey var.
Dialogue: 0,0:02:40.62,0:02:43.52,Main,Luffy,0,0,0,,Çok uzak, pek iyi göremiyorum.
Dialogue: 0,0:02:43.52,0:02:46.39,Main,Shirahoshi,0,0,0,,Luffy-sama? Nedir o?
Dialogue: 0,0:02:46.51,0:02:49.31,Captions,,0,0,0,,{\an8\fad(300,0)}Ryugu Krallığı\NKoy kenarındaki şehir - Mercan Tepesi
Dialogue: 0,0:02:49.21,0:02:51.18,Main,Child,0,0,0,,Anne, o da ne?
Dialogue: 0,0:03:02.01,0:03:04.17,Main,Child,0,0,0,,Hey, şuna bak!
Dialogue: 0,0:03:04.17,0:03:05.54,Main,Fishman,0,0,0,,O da ne?
Dialogue: 0,0:03:09.62,0:03:11.85,Main,Guard,0,0,0,,Ryugu Sarayı! Ryugu Sarayı!
Dialogue: 0,0:03:10.08,0:03:13.63,Captions,,0,0,0,,{\an8\fad(300,0)}Kale kapıları\NSınır Polis Karargâhı
Dialogue: 0,0:03:11.87,0:03:15.09,Main,Guard,0,0,0,,Lütfen yanıt verin! Ryugu Sarayı!
Dialogue: 0,0:03:15.09,0:03:17.17,Main,Guard,0,0,0,,Burası sınır polisi!
Dialogue: 0,0:03:17.46,0:03:20.01,Main,Guard,0,0,0,,Alo? Alo?!
Dialogue: 0,0:03:20.01,0:03:21.51,Main,Guard,0,0,0,,Çok tuhaf.
Dialogue: 0,0:03:22.59,0:03:24.59,Main,Guard,0,0,0,,Neden onlarla bağlantı kuramıyoruz?
Dialogue: 0,0:03:25.15,0:03:27.09,Main,Guard,0,0,0,,Den Den Mushi hasta falan mı oldu acaba?
Dialogue: 0,0:03:28.12,0:03:33.30,Main,Guard,0,0,0,,Neden Balık Adam Adası'na şu\Nheriflerden bir sürü geliyor?
Dialogue: 0,0:03:33.64,0:03:35.30,Main,Guard,0,0,0,,Kim bilir?
Dialogue: 0,0:03:35.30,0:03:40.10,Main,Guard,0,0,0,,Balık Adam Bölgesi'ndeki tehlikeli adamların "Hadi\Nbirlikte alışverişe gidelim!" dediklerini de sanmıyorum.
Dialogue: 0,0:03:42.54,0:03:50.82,Author,,0,0,0,,{\fad(2000,0)\fs19} Türkçeleştirme & Çevirmen  {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&} - {\c&H01BAFF&}{\b1}Kazasker{\b0}{\c&HFFFFFF&}\N{\fs19}thx to onepace.net
Dialogue: 0,0:25:26.10,0:25:36.10,Author,,0,0,0,,{\fad(500,500)\fs19} Türkçeleştirme & Çevirmen  {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&} - {\c&H01BAFF&}{\b1}Kazasker{\b0}{\c&HFFFFFF&}\N{\fs19}thx to onepace.net
Dialogue: 0,0:44:36.50,0:44:39.50,Author,,0,0,0,,{\fad(0,0)\fs19} Türkçeleştirme & Çevirmen  {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&} - {\c&H01BAFF&}{\b1}Kazasker{\b0}{\c&HFFFFFF&}\N{\fs19}thx to onepace.net
Dialogue: 0,0:03:42.54,0:03:50.82,Title,,0,0,0,,{\fad(2000,0)}İntikam Planının Başlangıcı!
Dialogue: 0,0:04:00.08,0:04:02.29,Main,Hody,0,0,0,,Dinleyin beyler!
Dialogue: 0,0:04:02.29,0:04:04.33,Main,Hody,0,0,0,,Gün bugündür.
Dialogue: 0,0:04:04.33,0:04:07.84,Main,Hody,0,0,0,,Bugün, Balık Adam Adası'nın tek bayrak\Naltında birleştiği gün olarak tarihe geçecek!
Dialogue: 0,0:04:08.15,0:04:14.48,Main,Hody,0,0,0,,Deniz halkıyla balık adamlar aynı fikirde\Nolmadığı sürece, asla ilerleme kaydedemeyiz.
Dialogue: 0,0:04:15.03,0:04:20.69,Main,Hody,0,0,0,,Su altında nefes bile alamayan insanlar,\Ndeğersiz türler oldukları gibi...
Dialogue: 0,0:04:20.69,0:04:23.10,Main,Hody,0,0,0,,...bizim yönetimimiz altında olmalı.
Dialogue: 0,0:04:23.10,0:04:26.59,Main,Pirates,0,0,0,,Evet!
Dialogue: 0,0:04:28.73,0:04:33.32,Main,Hody,0,0,0,,Şimdi, tarihin hatalarını düzeltme zamanı!
Dialogue: 0,0:04:33.42,0:04:36.47,Main,Pirates,0,0,0,,Evet!
Dialogue: 0,0:04:38.13,0:04:42.71,Main,Hody,0,0,0,,Bugün nişanımızın yıl dönümü olacak, Shirahoshi!
Dialogue: 0,0:04:42.71,0:04:44.37,Main,Hody,0,0,0,,İşleri aceleye getirmeye gerek yok!
Dialogue: 0,0:04:44.37,0:04:47.18,Main,Hody,0,0,0,,Düğün yarına kadar bekleyebilir.
Dialogue: 0,0:04:47.48,0:04:51.05,Main,Dosun,0,0,0,,Güneş Korsanları'nın bize baş belası olan kısmı,...
Dialogue: 0,0:04:51.06,0:04:53.82,Main,Dosun,0,0,0,,...Jinbe'nin grubu, artık burada değil -dosun!
Dialogue: 0,0:04:53.82,0:04:59.32,Main,Zeo,0,0,0,,Deniz Tanrısı Neptune ve üç kardeş\NFukaboshi, Ryuuboshi ve Manboshi.
Dialogue: 0,0:04:59.66,0:05:05.14,Main,Ikaros,0,0,0,,Muhi, bu dördünün işini bitirirsek, \NNeptune Ordusu'nu yok etmek hiç zor olmayacak-hi!
Dialogue: 0,0:05:07.11,0:05:10.21,Main,Daruma,0,0,0,,Hepsini parçalayacağım!
Dialogue: 0,0:05:11.23,0:05:14.33,Main,Hyouzou,0,0,0,,Tek sözünle hepsini doğrarım.
Dialogue: 0,0:05:16.09,0:05:17.51,Main,Hody,0,0,0,,Başlayalım.
Dialogue: 0,0:05:17.51,0:05:20.72,Main,Hody,0,0,0,,Hepiniz, gidip size verilen\Nyerin kontrolünü ele geçirin!
Dialogue: 0,0:05:21.08,0:05:24.39,Main,Hody,0,0,0,,Bugün, Ryugu Krallığı düşecek...
Dialogue: 0,0:05:24.39,0:05:27.85,Main,Hody,0,0,0,,...ve okyanus tabanının haklı\Nhükümdarları biz olacağız!
Dialogue: 0,0:05:27.85,0:05:32.19,Main,Pirates,0,0,0,,Evet!
Dialogue: 0,0:05:41.00,0:05:43.36,Main,Guard,0,0,0,,H-Haber gönderin.
Dialogue: 0,0:05:43.36,0:05:46.15,Main,Guard,0,0,0,,Kaçtı.
Dialogue: 0,0:05:52.57,0:05:54.98,Thoughts,Robin,0,0,0,,Sonuçta biraz bilgi edindim.
Dialogue: 0,0:05:54.98,0:05:57.42,Thoughts,Robin,0,0,0,,Burada bir Poneglif var.
Dialogue: 0,0:05:58.79,0:06:03.36,Thoughts,Robin,0,0,0,,Bu krallık, kayıp yüzyılın gizemine\Ndair yaşamsal bir ipucuna sahip!
Dialogue: 0,0:06:04.32,0:06:06.72,Captions,,0,0,0,,{\fad(300,0)}Ryugu Sarayı
Dialogue: 0,0:06:08.32,0:06:11.28,Main,Zoro,0,0,0,,Sanki onları eğlence olsun diye\Nkesmişim gibi konuşmayı bırak!
Dialogue: 0,0:06:11.42,0:06:14.31,Main,Left Minister,0,0,0,,Şey, dövüş sırasında eğleniyor gibiydin.
Dialogue: 0,0:06:14.31,0:06:16.65,Main,Left Minister,0,0,0,,Sen doğuştan katil gibisin!
Dialogue: 0,0:06:17.07,0:06:20.60,Main,Zoro,0,0,0,,Peki kılıçlarını sallayarak bir\Ngrup korsan üstünüze gelseydi,...
Dialogue: 0,0:06:20.61,0:06:22.86,Main,Zoro,0,0,0,,...onlara bir fincan çay mı ikram ederdiniz?!
Dialogue: 0,0:06:22.89,0:06:26.33,Main,Left Minister,0,0,0,,Evet, onlara bir fincan çay ikram edip\Nfarklılıklarımıza çözüm bulurduk.
Dialogue: 0,0:06:26.70,0:06:28.25,Main,Zoro,0,0,0,,Bu heriflerde işe yaramazdı!
Dialogue: 0,0:06:28.70,0:06:34.63,Main,Left Minister,0,0,0,,Yine de hepsinin işini bitirdiğin için, neyin\Npeşinde olduklarını öğrenmemiz mümkün değil!
Dialogue: 0,0:06:35.29,0:06:38.88,Main,Zoro,0,0,0,,Neden umursayayım ki? Bu sizin sorununuz.
Dialogue: 0,0:06:39.21,0:06:42.72,Main,Usopp,0,0,0,,Olaylar kötüden felakete doğru gidiyor gibi.
Dialogue: 0,0:06:42.72,0:06:47.45,Main,Nami,0,0,0,,Neden tayfamız onun gibilerle dolu?
Dialogue: 0,0:06:47.98,0:06:50.40,Main,Usopp,0,0,0,,Ah, kaptana bak...
Dialogue: 0,0:06:50.40,0:06:53.29,Main,Nami,0,0,0,,Evet. Bunu düşünmenin faydası yok.
Dialogue: 0,0:06:54.77,0:06:58.74,Main,Brook,0,0,0,,Acaba Luffy-san, \NDeniz Kızı Prensesi'yle tanıştı mı?
Dialogue: 0,0:06:58.74,0:07:01.96,Main,Brook,0,0,0,,Ben de onunla tanışmak istiyorum.
Dialogue: 0,0:07:01.96,0:07:04.91,Main,Neptune,0,0,0,,Öyle demeyin, beni bu zincirlerden kurtarın!
Dialogue: 0,0:07:04.91,0:07:07.20,Main,Neptune,0,0,0,,Shirahoshi'yi geri verin-jamon!
Dialogue: 0,0:07:07.20,0:07:11.83,Main,Usopp,0,0,0,,Dediğim gibi, biz neden \NDeniz Kızı Prensesi'ni kaçıralım ki?
Dialogue: 0,0:07:11.83,0:07:16.83,Main,Neptune,0,0,0,,Suçlu, Hasır Şapkalı Luffy-jamon! Shirahoshi!
Dialogue: 0,0:07:16.83,0:07:21.85,Main,Brook,0,0,0,,Ama Luffy-san'ın ve köpek balığının odadan\Nçıktığını kesinlikle görmeme rağmen,...
Dialogue: 0,0:07:21.85,0:07:25.17,Main,Brook,0,0,0,,...Deniz Kızı Prensesi'ni andıran kimseyi görmedim.
Dialogue: 0,0:07:25.17,0:07:29.01,Main,Neptune,0,0,0,,Ama kaleyi asla tek başına terketmezdi-jamon!
Dialogue: 0,0:07:29.29,0:07:32.83,Main,Neptune,0,0,0,,Shirahoshi benim kadar büyüktür-jamon.
Dialogue: 0,0:07:32.83,0:07:35.56,Main,Neptune,0,0,0,,Görülmeden çıkmış olması mümkün değil!
Dialogue: 0,0:07:35.86,0:07:38.42,Main,Brook,0,0,0,,Ne?! Deniz Kızı Prensesi büyük mü?!
Dialogue: 0,0:07:39.27,0:07:40.70,Thoughts,Brook's Imagination,0,0,0,,Ben prensesim-jamon!
Dialogue: 0,0:07:42.37,0:07:43.69,Main,Brook,0,0,0,,Bu saçmalık.
Dialogue: 0,0:07:44.62,0:07:51.14,Main,Neptune,0,0,0,,Ah, biliyorum-jamon! Shirahoshi'yi Megalo'nun\Nağzına tıkmış ve zorla götürmüş olmalı!
Dialogue: 0,0:07:55.21,0:07:59.64,Main,Guard,0,0,0,,Bu sıkıntılı durumda şaka yapmayın, Majesteleri.
Dialogue: 0,0:07:59.64,0:08:04.07,Main,Guard,0,0,0,,Bu fikir aklına gelmiş olsa bile, \Nonu bunu yapmaya nasıl ikna edebilir?
Dialogue: 0,0:08:04.44,0:08:08.83,Main,Nami,0,0,0,,Bu arada, kaptanımız asla kimseyi kaçırmaz!
Dialogue: 0,0:08:08.83,0:08:10.44,Main,Nami,0,0,0,,Birinden şüpheleneceksen, başka birini seç!
Dialogue: 0,0:08:10.47,0:08:12.73,Main,Neptune,0,0,0,,Hayır, başka birini düşünemiyorum.
Dialogue: 0,0:08:12.73,0:08:18.27,Main,Neptune,0,0,0,,Shirahoshi'yi zarar görmeden bana vermezseniz,\Nben de geminizi ya da tayfanızı vermeyeceğim.
Dialogue: 0,0:08:18.27,0:08:19.98,Main,Neptune,0,0,0,,Bunu aklınızdan çıkarmayın-jamon!
Dialogue: 0,0:08:19.98,0:08:22.49,Main,Nami,0,0,0,,Olamaz! Neden o kadar ileri gidiyorsun?!
Dialogue: 0,0:08:29.77,0:08:31.54,Main,Pirate,0,0,0,,B-Başardım!
Dialogue: 0,0:08:37.32,0:08:41.67,Main,Hody,0,0,0,,Görünüşe göre insan korsanlar başardı.
Dialogue: 0,0:08:48.44,0:08:50.68,Main,Franky,0,0,0,,Sunny! İyisin!
Dialogue: 0,0:08:50.68,0:08:54.80,Main,Franky,0,0,0,,Gerçekten çok süper-mucizevi bir gemisin!
Dialogue: 0,0:08:56.27,0:08:58.88,Main,Den,0,0,0,,Buraya gemi mezarlığı denir.
Dialogue: 0,0:08:59.91,0:09:03.81,Main,Den,0,0,0,,Gemi enkazları, \Nokyanus akıntıları tarafından buraya taşınır.
Dialogue: 0,0:09:03.81,0:09:05.33,Main,Den,0,0,0,,İronik, değil mi?
Dialogue: 0,0:09:05.85,0:09:10.18,Main,Den,0,0,0,,Böyle bir yerin Güneş Işığı Ağacı Eve'in \Nnimetinden faydalanması...
Dialogue: 0,0:09:10.18,0:09:15.13,Main,Den,0,0,0,,...ve balıklarla balinaları kendine çeken\Nen güzel mercanların burada büyüyor olması.
Dialogue: 0,0:09:15.13,0:09:17.10,Main,Franky,0,0,0,,Müthiş.
Dialogue: 0,0:09:17.10,0:09:22.15,Main,Franky,0,0,0,,Burada Sunny'den binlerce kat\Nbüyük sürüyle balina var!
Dialogue: 0,0:09:22.15,0:09:27.28,Main,Den,0,0,0,,Balinalar, en verimli denizlerin nerede\Nolduğunu bilebilirler ve oralarda toplanırlar.
Dialogue: 0,0:09:30.29,0:09:32.29,Main,Franky,0,0,0,,Ne mükemmel bir deniz!
Dialogue: 0,0:09:34.99,0:09:41.40,Main,Den,0,0,0,,Ben, bu gizemli Deniz Ormanı'nı\Naraştırarak hayatımı kazanıyorum.
Dialogue: 0,0:09:41.40,0:09:46.09,Main,Franky,0,0,0,,Buranın derin deniz olduğuna inanmak zor.
Dialogue: 0,0:09:46.09,0:09:48.30,Main,Franky,0,0,0,,Aynısı Balık Adam Adası için de söylenebilir.
Dialogue: 0,0:09:51.75,0:09:54.96,Main,Den,0,0,0,,Hazine Ağacı Adam'dan kereste\Nelde edebilmen beni etkiledi.
Dialogue: 0,0:09:54.96,0:09:57.25,Main,Den,0,0,0,,Bu güzel bir gemi, \Nyapıldığı malzemeyi hak ediyor!
Dialogue: 0,0:09:57.25,0:10:02.43,Main,Franky,0,0,0,,Değil mi? Malzemeler, Tom-san'ın Korsanlar Kralı'nın gemisini yapmak için kullandığı malzemelerin aynısı!
Dialogue: 0,0:10:02.43,0:10:05.16,Main,Franky,0,0,0,,Planları ise benim en büyük şaheserim!
Dialogue: 0,0:10:06.98,0:10:11.25,Main,Den,0,0,0,,Geminin kaplamasını bana bırak. Don'la yapacağım!
Dialogue: 0,0:10:11.94,0:10:17.26,Main,Franky,0,0,0,,Bunun gerçekten faydası olur, ah..\NAdım ne demiştin?
Dialogue: 0,0:10:17.26,0:10:18.71,Main,Den,0,0,0,,Den.
Dialogue: 0,0:10:18.71,0:10:20.06,Main,Franky,0,0,0,,Den-san!
Dialogue: 0,0:10:20.06,0:10:22.22,Main,Franky,0,0,0,,Yine de ona hiç benzemiyorsun.
Dialogue: 0,0:10:22.22,0:10:24.66,Main,Franky,0,0,0,,Deniz adamısın, balon balığı da değilsin.
Dialogue: 0,0:10:24.67,0:10:27.10,Main,Franky,0,0,0,,Tom-san'ın küçük kardeşi olduğun için,...
Dialogue: 0,0:10:27.10,0:10:29.80,Main,Franky,0,0,0,,...ona biraz daha benzersin diye düşünmüştüm.
Dialogue: 0,0:10:27.86,0:10:33.57,Captions,,0,0,0,,{\an8\fad(300,0)}Gemi Marangozu ve Deniz Ormanı Araştırmacısı\NDen (Tom'un küçük kardeşi)
Dialogue: 0,0:10:31.39,0:10:33.42,Main,Den,0,0,0,,Çok insansı bir düşünme şekli.
Dialogue: 0,0:10:33.99,0:10:39.08,Main,Den,0,0,0,,Sonuçta siz yüzey sakinleri, \Ngenelde aile üyelerinize benzersiniz.
Dialogue: 0,0:10:39.08,0:10:41.78,Main,Den,0,0,0,,Ama balık adamlarda durum böyle değildir.
Dialogue: 0,0:10:41.78,0:10:48.98,Main,Den,0,0,0,,Balık adamların ve deniz halkının genleri,\Nuzak atalarının anılarını taşır.
Dialogue: 0,0:10:48.20,0:10:53.89,Captions,,0,0,0,,{\an8\fad(300,0)}Ebeveyn ve Çocuk
Dialogue: 0,0:10:48.98,0:10:52.99,Main,Den,0,0,0,,Bir ahtapot, köpek balığı deniz adamı doğurursa,...
Dialogue: 0,0:10:52.99,0:10:59.11,Main,Den,0,0,0,,...deniz kızının soyunda bir köpek balığı\Ndeniz adamı olduğu anlamına gelir.
Dialogue: 0,0:10:59.71,0:11:05.88,Main,Den,0,0,0,,Bir kimse ne tür çocuk doğurursa doğursun,\NBalık Adam Adası'ndaki hiç kimse bunu yadırgamaz.
Dialogue: 0,0:11:06.21,0:11:08.05,Main,Den,0,0,0,,Bu yüzden,...
Dialogue: 0,0:11:08.05,0:11:16.32,Main,Den,0,0,0,,...siz insanların neden herkesi\Ngörünüşüne göre ayırdığını anlayamıyoruz.
Dialogue: 0,0:11:19.86,0:11:23.73,Main,Den,0,0,0,,Bu arada, atalarının içinde robot var mıydı?
Dialogue: 0,0:11:23.73,0:11:25.24,Main,Franky,0,0,0,,Ben insanım!
Dialogue: 0,0:11:25.24,0:11:26.53,Main,Den,0,0,0,,İnsan mı?
Dialogue: 0,0:11:26.53,0:11:29.57,Main,Den,0,0,0,,Oh, demek ataların insansı robotlardı.
Dialogue: 0,0:11:29.57,0:11:31.29,Main,Franky,0,0,0,,Ben sadece normal insanım!
Dialogue: 0,0:11:31.29,0:11:32.19,Main,Den,0,0,0,,Neyse, önemli değil.
Dialogue: 0,0:11:32.19,0:11:34.72,Main,Franky,0,0,0,,Evet, önemli!
Dialogue: 0,0:11:34.72,0:11:40.59,Main,Den,0,0,0,,Ah, sahi. Bir mektupta seninle ve\NIceberg-kun'la ilgili bir şeyler okumuştum.
Dialogue: 0,0:11:40.59,0:11:44.09,Main,Franky,0,0,0,,Oh, demek yaşlı Kokoro sana mesaj yazıyordu.
Dialogue: 0,0:11:44.30,0:11:47.75,Main,Den,0,0,0,,Bu yüzden olan bitenin farkındayım.
Dialogue: 0,0:11:48.82,0:11:53.82,Main,Den,0,0,0,,Abim son âna kadar Don'la\Nkendi tarzında yaşam sürmüş!
Dialogue: 0,0:11:54.36,0:11:58.24,Main,Den,0,0,0,,Sen bunu bana şahsen söylemeye geldin.
Dialogue: 0,0:11:58.34,0:12:01.07,Main,Den,0,0,0,,İyi bir çırağı varmış.
Dialogue: 0,0:12:02.47,0:12:04.68,Main,Franky,0,0,0,,Yüzümü kızartıyorsun.
Dialogue: 0,0:12:05.73,0:12:06.98,Main,Den,0,0,0,,Oh, demek gerçekten robotsun!
Dialogue: 0,0:12:07.49,0:12:11.19,Main,Franky,0,0,0,,Şey, sadece doğanın çarpıklığı olduğumu\Nsöyleyelim ve bu konuyu kapatalım.
Dialogue: 0,0:12:11.62,0:12:17.42,Main,Franky,0,0,0,,Ah, bir süredir birinin orada\Noturduğunu farkettim.
Dialogue: 0,0:12:19.01,0:12:23.03,Main,Den,0,0,0,,Ah, o Patron Jinbe.
Dialogue: 0,0:12:23.03,0:12:24.06,Main,Franky,0,0,0,,Patron mu?
Dialogue: 0,0:12:24.45,0:12:27.03,Main,Den,0,0,0,,Görünüşe göre birini bekliyor.
Dialogue: 0,0:12:27.56,0:12:30.96,Main,Den,0,0,0,,Aranan biri olduğu için krallığa giremez.
Dialogue: 0,0:12:33.94,0:12:36.54,Captions,,0,0,0,,{\fad(300,0)}Ryugu Krallığı'nın Girişi
Dialogue: 0,0:12:36.76,0:12:38.61,Captions,,0,0,0,,{\fad(300,0)}Bağlantı kanalı
Dialogue: 0,0:12:43.45,0:12:45.25,Captions,,0,0,0,,{\fad(300,0)}Ana kapı
Dialogue: 0,0:12:47.06,0:12:49.06,Captions,,0,0,0,,{\an8\fad(300,0)}Saray kapısı
Dialogue: 0,0:12:48.84,0:12:50.88,Main,Guard,0,0,0,,Davetsiz misafirler!
Dialogue: 0,0:12:50.88,0:12:54.89,Main,Right Minister,0,0,0,,Buraya kadar nasıl geldiniz?!
Dialogue: 0,0:12:56.40,0:12:58.47,Main,Decken,0,0,0,,Buna inanamıyorum!
Dialogue: 0,0:12:58.47,0:13:05.23,Main,Decken,0,0,0,,Buraya girerken dövüşeceğimizi sanmıştık\Nama Neptune ve tüm askerler zaten bağlanmış!
Dialogue: 0,0:13:08.35,0:13:12.52,Main,Hody,0,0,0,,Böyle bir hediyenin bizi bekliyor\Nolabileceği hiç aklıma gelmemişti!
Dialogue: 0,0:13:13.03,0:13:14.44,Main,Hody,0,0,0,,Büyük sürpriz.
Dialogue: 0,0:13:18.00,0:13:19.29,Main,Left Minister,0,0,0,,O yüz!
Dialogue: 0,0:13:19.98,0:13:21.34,Main,Guard,0,0,0,,Onun burada ne işi var?!
Dialogue: 0,0:13:22.01,0:13:26.75,Main,Left Minister,0,0,0,,Demek sonunda kendini gösteriyorsun,\Nrezil Vander decken!
Dialogue: 0,0:13:27.05,0:13:28.99,Main,Right Minister,0,0,0,,O...
Dialogue: 0,0:13:31.06,0:13:33.99,Main,Right Minister,0,0,0,,...Balık Adam Bölgesi'nden Hody Jones!
Dialogue: 0,0:13:34.92,0:13:37.43,Main,Right Minister,0,0,0,,Neden buraya geri döndü?
Dialogue: 0,0:13:37.76,0:13:40.62,Main,Neptune,0,0,0,,Hody? O...
Dialogue: 0,0:13:42.31,0:13:47.56,Main,Right Minister,0,0,0,,Eskiden ordumuzda epey yetenekli bir askerdi.
Dialogue: 0,0:13:54.57,0:13:58.36,Main,Hody,0,0,0,,Bu bir tür tuzak mı? \NGerçek olmayacak kadar güzel görünüyor!
Dialogue: 0,0:13:58.82,0:14:01.60,Main,Zoro,0,0,0,,Gittikçe daha fazla misafirimiz oluyor.
Dialogue: 0,0:14:03.99,0:14:05.95,Main,Zoro,0,0,0,,Ne hareketli bir saray.
Dialogue: 0,0:14:05.95,0:14:08.69,Main,Left Minister,0,0,0,,Onlarla müttefik olmalısınız, öyle değil mi?!
Dialogue: 0,0:14:08.69,0:14:09.21,Main,Usoopp,0,0,0,,Ha?!
Dialogue: 0,0:14:09.21,0:14:11.59,Main,Left Minister,0,0,0,,Onları buraya davet ettiniz, değil mi?!
Dialogue: 0,0:14:11.59,0:14:17.80,Main,Usopp,0,0,0,,Hey! Siz bizi buraya getirmeseydiniz,\Nbiz zaten burada olmayacaktık!
Dialogue: 0,0:14:17.80,0:14:21.56,Main,Usopp,0,0,0,,Bu sert görünüşlü adamlar da kim?!
Dialogue: 0,0:14:21.76,0:14:24.63,Main,Guard,0,0,0,,Hey! En azından bize silahlarımızı geri verin!
Dialogue: 0,0:14:24.64,0:14:26.81,Main,Guard,0,0,0,,Lütfen! Bırakın dövüşelim!
Dialogue: 0,0:14:27.34,0:14:32.82,Main,Neptune,0,0,0,,Vander Decken! Burada olduğuna\Ngöre artık şüphem kalmadı!
Dialogue: 0,0:14:33.13,0:14:36.49,Main,Neptune,0,0,0,,Suçlu sensin! Kızımı bana geri ver!
Dialogue: 0,0:14:38.88,0:14:44.49,Main,Decken,0,0,0,,Daha onunla evlenmemişken sana geri\Nvermek mi? Haddini aşıyorsun, baba.
Dialogue: 0,0:14:44.84,0:14:46.66,Main,Neptune,0,0,0,,Bana baba deme!
Dialogue: 0,0:14:47.10,0:14:50.71,Main,Neptune,0,0,0,,Shirahoshi'yi nereye götürdün?!\NGüvende olsa iyi olur!
Dialogue: 0,0:14:51.04,0:14:56.34,Main,Decken,0,0,0,,O tavır da ne? Sanki prenses\Nburada değilmiş gibi konuşuyorsun.
Dialogue: 0,0:14:56.71,0:14:58.09,Main,Neptune,0,0,0,,Bana numara yapma!
Dialogue: 0,0:14:58.09,0:15:01.72,Main,Neptune,0,0,0,,Prensesin birden odasından\Nkaybolmasından başka kim sorumlu olabilir?!
Dialogue: 0,0:15:03.45,0:15:07.27,Main,Decken,0,0,0,,Shirahoshi'm kayboldu mu?!
Dialogue: 0,0:15:07.39,0:15:10.57,Main,Neptune,0,0,0,,O benim! Benim kızım-jamon!
Dialogue: 0,0:15:10.88,0:15:15.92,Main,Right Minister,0,0,0,,Neptune-sama, bu adamın saçmalıkları\Nyüzünden bu kadar strese girmeyin.
Dialogue: 0,0:15:20.61,0:15:23.25,Main,Hody,0,0,0,,Sakin ol, Decken.
Dialogue: 0,0:15:23.62,0:15:29.86,Main,Hody,0,0,0,,Bak. Deniz Kızı Prensesi'ni hedef\Nalarak fırlattığın insanlar buraya gelmiş.
Dialogue: 0,0:15:29.86,0:15:35.04,Main,Hody,0,0,0,,En azından, onları attığın sırada\NPrenses Shirahoshi hâlâ buradaymış.
Dialogue: 0,0:15:35.04,0:15:36.14,Main,Pirate,0,0,0,,Yardım edin.
Dialogue: 0,0:15:36.43,0:15:40.78,Main,Hody,0,0,0,,Ayrıca söyledikleri şey\Ndoğru olsun ya da olmasın,...
Dialogue: 0,0:15:40.78,0:15:45.92,Main,Hody,0,0,0,,...nerede olduğunu bulmak için bir yöntemin var.
Dialogue: 0,0:15:49.80,0:15:51.61,Main,Nami,0,0,0,,Nerede olduğunu öğrenmek mi?
Dialogue: 0,0:15:51.86,0:15:56.83,Main,Decken,0,0,0,,Kesinlikle! Hody, epey akıllısın.
Dialogue: 0,0:15:56.83,0:15:58.16,Main,Decken,0,0,0,,Öyle tahmin ediyorum!
Dialogue: 0,0:15:59.04,0:16:00.11,Main,Zoro,0,0,0,,Gidiyor mu?
Dialogue: 0,0:16:00.86,0:16:02.25,Main,Usopp,0,0,0,,Ne yapmayı planlıyor?
Dialogue: 0,0:16:08.90,0:16:13.43,Main,Decken,0,0,0,,Hadi, mercan! Shirahoshi'ye doğru uç!
Dialogue: 0,0:16:17.83,0:16:19.73,Main,Decken,0,0,0,,Koukaku Kulesi'ne doğru uçmuyor!
Dialogue: 0,0:16:23.49,0:16:27.57,Main,Decken,0,0,0,,On yıllık aşkımızın önünde\Ndurmaya çalışan her kimse,...
Dialogue: 0,0:16:28.02,0:16:30.28,Main,Decken,0,0,0,,...ölmeli!
Dialogue: 0,0:16:30.77,0:16:34.15,Main,Luffy,0,0,0,,Öyle olunca koca bir osuruk koyverdi!
Dialogue: 0,0:16:36.69,0:16:39.87,Main,Shirahoshi,0,0,0,,Luffy-sama, böyle edepsiz\Nkelimeler kullanmamalısın.
Dialogue: 0,0:16:40.29,0:16:41.27,Main,Luffy,0,0,0,,Öyle mi?
Dialogue: 0,0:16:44.91,0:16:47.54,Main,Decken,0,0,0,,Başka biri seni kendinin yapmaya çalışıyorsa,...
Dialogue: 0,0:16:47.82,0:16:50.21,Main,Decken,0,0,0,,...çok yakında kendi kanına bulanmış\Nşekilde senin öldüğünü göreceğim!
Dialogue: 0,0:16:50.54,0:16:53.28,Main,Decken,0,0,0,,Shirahoshi!
Dialogue: 0,0:16:57.34,0:17:01.33,Main,Neptune,0,0,0,,Vander Decken, Shirahoshi'nin peşinden gitti!
Dialogue: 0,0:17:03.33,0:17:06.19,Main,Left Minister,0,0,0,,Neptune-sama!
Dialogue: 0,0:17:06.40,0:17:11.25,Main,Neptune,0,0,0,,Yalvarırım-jamon! Ne isterseniz veririm!
Dialogue: 0,0:17:11.25,0:17:13.51,Main,Neptune,0,0,0,,Bırakın Decken'in peşinden gideyim!
Dialogue: 0,0:17:16.30,0:17:18.10,Main,Neptune,0,0,0,,Hazinemizin hepsini size vereceğim.
Dialogue: 0,0:17:18.51,0:17:22.35,Main,Neptune,0,0,0,,İsterseniz askerlerimin canını bile alabilirsiniz!
Dialogue: 0,0:17:22.35,0:17:23.93,Main,Ministers,0,0,0,,Hey, Majesteleri!
Dialogue: 0,0:17:25.57,0:17:28.54,Main,Neptune,0,0,0,,Shirahoshi'yi yakalayacak!
Dialogue: 0,0:17:28.54,0:17:31.99,Main,Neptune,0,0,0,,Canım Shirahoshi'm!
Dialogue: 0,0:17:33.28,0:17:35.61,Main,Hody,0,0,0,,Ne kadar acıklı, Neptune.
Dialogue: 0,0:17:35.86,0:17:39.49,Main,Hody,0,0,0,,Yazgımdaki düşmanlarım \NHasır Şapka Korsanları'nın,...
Dialogue: 0,0:17:39.49,0:17:43.62,Main,Hody,0,0,0,,...Ryugu Sarayı'nı yıkmamıza yardım\Nedeceğini hiç düşünmemiştim.
Dialogue: 0,0:17:43.62,0:17:44.61,Thoughts,Nami,0,0,0,,Yazgımdaki düşmanlar?
Dialogue: 0,0:17:54.84,0:17:57.72,Thoughts,Nami,0,0,0,,O Arlong'un işareti!
Dialogue: 0,0:18:01.01,0:18:05.98,Main,Right Minister,0,0,0,,Jinbe, Balık Adam Bölgesi'nde\Nhuzursuzluk olduğundan bahsetmişti.
Dialogue: 0,0:18:05.98,0:18:10.40,Main,Right Minister,0,0,0,,Ama bunun arkasında senin, Neptune Ordusu'nun\Neski üyesinin olabileceği hiç aklıma gelmemişti.
Dialogue: 0,0:18:10.40,0:18:12.52,Main,Right Minister,0,0,0,,Kendinden utanmalısın, Hody!
Dialogue: 0,0:18:16.04,0:18:17.15,Main,Hody,0,0,0,,Utanmak mı?
Dialogue: 0,0:18:20.24,0:18:26.48,Main,Hody,0,0,0,,Neptune Ordusu'nun bir parçası olmaktan\Ngurur duymuş olsaydım, dediğin mantıklı olurdu.
Dialogue: 0,0:18:27.09,0:18:35.34,Main,Hody,0,0,0,,Ama asker olarak emrinizde çalışmamın tek\Nnedeni, dövüş deneyimi kazanmaktı. Hepsi bu.
Dialogue: 0,0:18:35.34,0:18:36.81,Main,Right Minister,0,0,0,,Pislik!
Dialogue: 0,0:18:36.81,0:18:39.30,Main,Hody,0,0,0,,İşe yaradı. Güçlendim.
Dialogue: 0,0:18:39.30,0:18:40.30,Main,Right Minister,0,0,0,,Ne?!
Dialogue: 0,0:18:40.40,0:18:46.16,Main,Hody,0,0,0,,Balık Adam Adası'nın her bölümünü\Nkoruma zahmetine girmiş değilsiniz.
Dialogue: 0,0:18:48.37,0:18:51.20,Main,Hody,0,0,0,,Çocukluğumdan beri,...
Dialogue: 0,0:18:51.20,0:18:56.43,Main,Hody,0,0,0,,...balık adamların insanlar\Ntarafından ezildiğini gördüm.
Dialogue: 0,0:18:56.49,0:18:58.65,Flashbacks,Arlong,0,0,0,,Sizin yüzünüzden kusasım geliyor!
Dialogue: 0,0:19:02.43,0:19:05.30,Flashbacks,Arlong,0,0,0,,Kaçınızı halletsek de,...
Dialogue: 0,0:19:05.30,0:19:09.43,Flashbacks,Arlong,0,0,0,,...su altında nefes bile alamayan siz\Nzavallı insanlar sürekli gelip duruyorsunuz!
Dialogue: 0,0:19:17.94,0:19:25.11,Main,Hody,0,0,0,,Arlong'un, insanların burnunu sürtüp\Nonlara ders verme amacını örnek aldım!
Dialogue: 0,0:19:27.56,0:19:30.87,Main,Hody,0,0,0,,Onun planını devam ettirecek olan biziz.
Dialogue: 0,0:19:31.92,0:19:34.84,Main,Hody,0,0,0,,Yeni Balık Adam Korsanları!
Dialogue: 0,0:19:37.39,0:19:43.80,Main,Hody,0,0,0,,Arlong, dünyayı fethetmek için\NDoğu Mavi'ye gittiğinden beri,...
Dialogue: 0,0:19:43.80,0:19:48.43,Main,Hody,0,0,0,,...onun sağ kolu olmak için çalışıyordum.
Dialogue: 0,0:19:48.79,0:19:54.52,Main,Hody,0,0,0,,Ama bir grup insan yüzünden bu hiç olmadı.
Dialogue: 0,0:19:59.02,0:20:02.69,Main,Usopp,0,0,0,,Bu balık adamlar Arlong'un planını\Ngerçekleştirmeye mi çalışıyor?!
Dialogue: 0,0:20:07.41,0:20:09.90,Main,Brook,0,0,0,,Ne?! Arlong mu?!
Dialogue: 0,0:20:09.90,0:20:15.69,Main,Brook,0,0,0,,Sadece şakaydı. \NDaha önce hiç Arlong yemedim.
Dialogue: 0,0:20:19.61,0:20:23.70,Main,Brook,0,0,0,,Acıdı! Usopp-san, neden bana vurdun?
Dialogue: 0,0:20:24.93,0:20:29.39,Main,Hody,0,0,0,,Bu kadar konuşma yeter. İşe koyulalım.
Dialogue: 0,0:20:29.39,0:20:30.48,Main,Hody,0,0,0,,Çekilin!
Dialogue: 0,0:20:32.73,0:20:34.02,Main,Usopp,0,0,0,,N-Ne?
Dialogue: 0,0:20:34.02,0:20:35.58,Attack,TL Note,0,0,0,,{\fad(100,100)}Kaba Köpek Balığı
Dialogue: 0,0:20:44.39,0:20:48.11,Main,Usopp,0,0,0,,Ne biçim bir güç! Ne yapıyor bu?!
Dialogue: 0,0:20:51.95,0:20:55.62,Main,Pappagg,0,0,0,,Durum kötü! Çok, çok kötü!
Dialogue: 0,0:20:57.58,0:20:58.32,Main,Caimie,0,0,0,,Nami-chin?
Dialogue: 0,0:20:59.02,0:21:01.39,Main,Nami,0,0,0,,Caimie, senden bir iyilik isteyeceğim.
Dialogue: 0,0:21:08.09,0:21:09.41,Main,Fishman,0,0,0,,Bu onun doğal gücü, değil mi?
Dialogue: 0,0:21:09.41,0:21:13.54,Main,Fishman,0,0,0,,Evet. Henüz hiç Enerji Hapı almadı.
Dialogue: 0,0:21:16.58,0:21:19.03,Main,Fishman,0,0,0,,Duvarı yıktı!
Dialogue: 0,0:21:28.89,0:21:31.35,Main,Zoro,0,0,0,,Kahretsin! Sarayı yine su basacak!
Dialogue: 0,0:21:36.92,0:21:40.19,Main,Brook,0,0,0,,Bu çok kötü! Özellikle de benim için!
Dialogue: 0,0:21:37.87,0:21:40.19,Secondary,Usopp,0,0,0,,Boğulacağız!
Dialogue: 0,0:21:50.82,0:21:52.55,Main,Fishman,0,0,0,,Olamaz, su damlaları!
Dialogue: 0,0:21:52.55,0:21:55.45,Main,Fishman,0,0,0,,Geri çekilin! Onu kullanmak üzere!
Dialogue: 0,0:22:01.46,0:22:03.22,Attack,TL Note,0,0,0,,{\fad(0,100)}Köpek Balığı Okçuluğu
Dialogue: 0,0:22:06.92,0:22:08.22,Main,Zoro,0,0,0,,Su damlaları oklara dönüştü!
Dialogue: 0,0:22:20.04,0:22:25.91,Main,Neptune,0,0,0,,Pislik! Rastgele adamlarıma saldırıyorsun!
Dialogue: 0,0:22:26.51,0:22:31.01,Main,Neptune,0,0,0,,Buna hemen son ver, seni ahmak!
Dialogue: 0,0:22:32.36,0:22:34.95,Main,Guard,0,0,0,,Majesteleri! Yapmayın!
Dialogue: 0,0:22:34.95,0:22:38.66,Main,Neptune,0,0,0,,Asla-jamon! Siz benim tebaamsınız-jamon!
Dialogue: 0,0:22:38.66,0:22:40.23,Main,Guards,0,0,0,,Neptune-sama!
Dialogue: 0,0:22:40.23,0:22:44.56,Main,Hody,0,0,0,,Ahmak herif! \NKral, adamlarına kalkan mı oluyor?
Dialogue: 0,0:22:44.56,0:22:47.77,Main,Hody,0,0,0,,Gerçekten kral olmaya layık değilsin!
Dialogue: 0,0:22:47.77,0:22:49.48,Main,Left Minister,0,0,0,,Majesteleri!
Dialogue: 0,0:22:49.48,0:22:50.84,Main,Right Minister,0,0,0,,Lanet olası, Hody!
Dialogue: 0,0:22:51.13,0:22:53.91,Main,Usopp,0,0,0,,Durum berbat! Karşı bile koyamıyorlar!
Dialogue: 0,0:22:53.91,0:22:57.35,Main,Usopp,0,0,0,,Bu adam Arlong'dan çok daha farklı seviyede!
Dialogue: 0,0:23:04.88,0:23:07.58,Attack,,0,0,0,,Tek Kılıç Stili: Felaket Barındıran Kuş
Dialogue: 0,0:23:11.13,0:23:13.36,Main,Fishman,0,0,0,,H-Hayır! Dur, Patron Hody! Yapma-
Dialogue: 0,0:23:28.28,0:23:31.70,Main,Usopp,0,0,0,,Adamını kalkan olarak kullandı! Berbat biri!
Dialogue: 0,0:23:31.70,0:23:35.27,Main,Zoro,0,0,0,,Hey, siz. Askerleri çözün.
Dialogue: 0,0:23:37.33,0:23:40.69,Main,Zoro,0,0,0,,Bu ülkeyle olan görüşmelerimiz bozuldu.
Dialogue: 0,0:23:40.69,0:23:46.50,Main,Zoro,0,0,0,,Tüm rehineleri zarar görmeden teslim edeceğimizi söyledik ama sözümüzü tutamadık.
Dialogue: 0,0:23:46.50,0:23:48.37,Main,Left Minister,0,0,0,,Sorumluluk sahibi.
Dialogue: 0,0:23:48.47,0:23:50.19,Main,Usopp,0,0,0,,Tamam, anlaşıldı.
Dialogue: 0,0:23:50.19,0:23:52.28,Main,Brook,0,0,0,,Olamaz, ayağım!
Dialogue: 0,0:23:52.28,0:23:56.27,Main,Brook,0,0,0,,Gücüm tükeniyor! Yardım et, Nami-san!
Dialogue: 0,0:23:56.27,0:23:58.27,Main,Brook,0,0,0,,Ne? Nami-san nerede?
Dialogue: 0,0:23:58.58,0:24:00.27,Main,Usopp,0,0,0,,Ha? Nami?
Dialogue: 0,0:24:01.10,0:24:04.78,Main,Pappagg,0,0,0,,Nereye gittiler? Caimie de burada değil.
Dialogue: 0,0:24:08.84,0:24:12.14,Main,Usopp,0,0,0,,Üfff... Önce Luffy ortadan\Nkayboluyor, şimdiyse Nami mi?
Dialogue: 0,0:24:12.14,0:24:14.38,Main,Usopp,0,0,0,,Ama şu anda bu adamları\Nserbest bırakmak daha önemli.
Dialogue: 0,0:24:14.38,0:24:16.50,Main,Usopp,0,0,0,,Biraz daha dayan, Brook!
Dialogue: 0,0:24:16.50,0:24:19.13,Main,Brook,0,0,0,,Bu iş kemiklerimi çok zorluyor.
Dialogue: 0,0:24:19.13,0:24:20.88,Main,Brook,0,0,0,,Lütfen hemen kaçın.
Dialogue: 0,0:24:22.32,0:24:26.55,Main,Brook,0,0,0,,Geri kalanını çözme işini sana\Nbırakıyorum. Hiç gücüm kalmadı.
Dialogue: 0,0:24:26.55,0:24:29.46,Main,Guard,0,0,0,,Çözün onları! Silahlarınızı alın!
Dialogue: 0,0:24:29.46,0:24:31.51,Main,Hody,0,0,0,,Aptalca bir numara yapmalarına izin vermeyin!
Dialogue: 0,0:24:31.72,0:24:36.02,Main,Hody,0,0,0,,Neptune Ordusu'nu ve \NHasır Şapka Korsanları'nı ezin!
Dialogue: 0,0:24:38.28,0:24:41.38,Attack,,0,0,0,,Öldürücü Yeşil Yıldız: Rafflesia
Dialogue: 0,0:24:45.34,0:24:47.23,Main,Fishman,0,0,0,,Yüzey çiçeği açtı!
Dialogue: 0,0:24:47.23,0:24:48.57,Main,Fishman,0,0,0,,O çiçeği daha önce hiç görmedim!
Dialogue: 0,0:24:48.82,0:24:49.70,Main,Usopp,0,0,0,,Alın bakalım.
Dialogue: 0,0:24:51.84,0:24:53.62,Main,Fishmen,0,0,0,,Bu koku da ne?!
Dialogue: 0,0:24:53.87,0:24:56.54,Main,Hody,0,0,0,,Ahmak. Ne kadar saçma.
Dialogue: 0,0:24:57.11,0:24:58.36,Main,Brook,0,0,0,,Artık dayanamıyorum.
Dialogue: 0,0:24:58.36,0:25:00.38,Main,Usopp,0,0,0,,Zoro! Bu yeri su basmak üzere!
Dialogue: 0,0:25:04.22,0:25:07.57,Main,Zoro,0,0,0,,Lütfen o ikisinin kaleden kaçmasına izin ver!
Dialogue: 0,0:25:08.75,0:25:09.76,Main,Neptune,0,0,0,,Ya sen?
Dialogue: 0,0:25:10.28,0:25:14.33,Main,Zoro,0,0,0,,Peşinizden gelirse, kimse kaçamayacak!
Dialogue: 0,0:25:20.88,0:25:24.58,Main,Hody,0,0,0,,Bana engel olma. Bu ülke benim olacak.
Dialogue: 0,0:25:27.12,0:25:30.12,Captions,,0,0,0,,{\fad(300,0)}Mercan Tepesi Kıyısı
Dialogue: 0,0:25:30.28,0:25:33.37,Main,Chopper,0,0,0,,Dayan! İyi olacaksın!
Dialogue: 0,0:25:34.58,0:25:37.06,Main,Hachi,0,0,0,,Adadan gitmelisiniz!
Dialogue: 0,0:25:37.06,0:25:39.73,Main,Chopper,0,0,0,,Bizim için endişelenecek zaman değil!
Dialogue: 0,0:25:39.73,0:25:41.82,Main,Chopper,0,0,0,,Şu anda sadece kendi yaralarına odaklan.
Dialogue: 0,0:25:42.76,0:25:44.38,Main,Sanji,0,0,0,,Siz de kimsiniz?
Dialogue: 0,0:25:44.38,0:25:46.03,Main,Fishman,0,0,0,,Deniz kızlarını geri verin!
Dialogue: 0,0:25:46.03,0:25:49.24,Main,Fishman,0,0,0,,Lanet olası insanlar, \Nbizi sadece araç olarak görüyorsunuz!
Dialogue: 0,0:25:49.24,0:25:51.27,Main,Sanji,0,0,0,,Ha? Neden bahsediyorsunuz?
Dialogue: 0,0:25:51.27,0:25:53.25,Main,Fishman,0,0,0,,Aptal numarası yapmayan, korsanlar!
Dialogue: 0,0:25:53.38,0:25:58.80,Main,Fishman,0,0,0,,Kısa süre önce güney kıyısından\Nüç genç deniz kızı kayboldu!
Dialogue: 0,0:25:59.12,0:26:01.14,Main,Mermaid,0,0,0,,Kızlar nerede?!
Dialogue: 0,0:26:01.14,0:26:03.30,Main,Sanji,0,0,0,,Anlamıyorum.
Dialogue: 0,0:26:04.35,0:26:07.37,Main,Sanji,0,0,0,,Neden bizim suçlu olduğumuzu düşünüyorsunuz?!
Dialogue: 0,0:26:07.88,0:26:09.31,Main,Sanji,0,0,0,,Aslında...
Dialogue: 0,0:26:09.31,0:26:13.82,Main,Sanji,0,0,0,,...deniz kızlarını çok sevdiğim için birkaç\Ntanesini kaçırmak istediğim doğru,...
Dialogue: 0,0:26:14.24,0:26:16.82,Main,Sanji,0,0,0,,...ama gerçekte bunu asla yapmam!
Dialogue: 0,0:26:17.26,0:26:19.70,Main,Merman,0,0,0,,Gördünüz mü?! \NOnları kaçırmak istediğini söyledi!
Dialogue: 0,0:26:20.13,0:26:23.48,Main,Chopper,0,0,0,,Bunu neden onlara söyledin?! \NÇeneni kapalı tut!
Dialogue: 0,0:26:23.48,0:26:25.46,Main,Fishman,0,0,0,,İnsanların işi olmalı!
Dialogue: 0,0:26:25.46,0:26:26.73,Main,Mermaid,0,0,0,,Gidin buradan!
Dialogue: 0,0:26:31.79,0:26:34.80,Main,Sanji,0,0,0,,Bunun içinde daha var! Ziyan etmeyin!
Dialogue: 0,0:26:35.07,0:26:36.55,Main,Fishman,0,0,0,,Sessiz ol, insan!
Dialogue: 0,0:26:36.55,0:26:39.34,Main,Luffy,0,0,0,,Ha? Sanji, Chopper!
Dialogue: 0,0:26:39.73,0:26:42.83,Main,Luffy,0,0,0,,Hey, Sanji! \NBurun kanaman geçti mi?
Dialogue: 0,0:26:43.06,0:26:44.47,Main,Chopper,0,0,0,,Luffy, bu sen misin?
Dialogue: 0,0:26:44.47,0:26:45.53,Main,Chopper,0,0,0,,O balon balığı da ne?
Dialogue: 0,0:26:48.42,0:26:51.75,Main,Shirahoshi,0,0,0,,Onlar arkadaşların mı, Luffy-sama?
Dialogue: 0,0:26:51.75,0:26:54.51,Main,Luffy,0,0,0,,Tayfam!
Dialogue: 0,0:26:54.51,0:26:56.55,Main,Shirahoshi,0,0,0,,O insanlar...
Dialogue: 0,0:26:56.69,0:26:59.46,Main,Mermaid,0,0,0,,Bakın! Kaptanları geldi!
Dialogue: 0,0:26:59.46,0:27:03.29,Main,Fishman,0,0,0,,Lanet olası Hasır Şapka!\NDeniz kızı kaçıranların lideri!
Dialogue: 0,0:27:06.80,0:27:11.30,Main,Shirahoshi,0,0,0,,Görülmemeliyim! \NMegalo, ağzını biraz daha kapat!
Dialogue: 0,0:27:16.99,0:27:18.85,Main,Luffy,0,0,0,,Ben biraz aşağı iniyorum.
Dialogue: 0,0:27:19.21,0:27:20.11,Main,Shirahoshi,0,0,0,,Ne?
Dialogue: 0,0:27:24.11,0:27:25.31,Main,Fishman,0,0,0,,Atladı!
Dialogue: 0,0:27:26.45,0:27:28.32,Main,Luffy,0,0,0,,Hachi! Bu gerçekten sen misin?
Dialogue: 0,0:27:29.90,0:27:31.28,Main,Hachi,0,0,0,,Hasır Şapka.
Dialogue: 0,0:27:31.28,0:27:33.30,Main,Luffy,0,0,0,,Ne oldu sana?!
Dialogue: 0,0:27:33.30,0:27:34.59,Main,Luffy,0,0,0,,Bunu sana kim yaptı?!
Dialogue: 0,0:27:34.59,0:27:37.28,Main,Chopper,0,0,0,,Söylemiyor.
Dialogue: 0,0:27:37.28,0:27:39.68,Main,Hachi,0,0,0,,Adadan... gitmelisiniz.
Dialogue: 0,0:27:40.88,0:27:42.79,Main,Chopper,0,0,0,,Bunu yapmamız gerektiği konusunda ısrarcı.
Dialogue: 0,0:27:43.36,0:27:48.09,Main,Fishman,0,0,0,,Ama Hasır Şapka'nın, Ryugu Sarayı'nı\Nkuşatma altına aldığını duymuştum.
Dialogue: 0,0:27:48.48,0:27:51.51,Main,Mermaid,0,0,0,,Onlar deniz kızlarını kaçıranlar!
Dialogue: 0,0:27:51.51,0:27:55.11,Main,Mermaid,0,0,0,,Adamlarını kalede bırakıp, \Ndaha fazlasını kaçırmaya gelmiştir!
Dialogue: 0,0:27:55.09,0:27:58.97,Main,Fishman,0,0,0,,Asıl amacı Prenses Shirahoshi'yi kaçırmak olmalı!
Dialogue: 0,0:27:59.34,0:28:02.79,Main,Fishman,0,0,0,,Saçmalık. Bunu yapabilmesi mümkün değil.
Dialogue: 0,0:28:02.79,0:28:05.48,Main,Fishman,0,0,0,,Prenses dev Big Kiss Deniz Kızı'dır.
Dialogue: 0,0:28:02.79,0:28:05.48,Note,Fishman,0,0,0,,Big Kiss: Koca Öpücük anlamında. \NÖzel bir anlamı var mı yok mu bilemedik.
Dialogue: 0,0:28:05.48,0:28:08.44,Main,Fishman,0,0,0,,Deniz Tanrısı Neptune'un tek kızı\Nolduğundan bahsetmiyorum bile.
Dialogue: 0,0:28:08.46,0:28:12.90,Main,Fishman,0,0,0,,Onu kaçırmak istese bile, kim bunu\Ndeneyecek kadar çılgın olabilir ki?
Dialogue: 0,0:28:13.38,0:28:15.66,Main,Fishman,0,0,0,,Bu balon balığı da ne?
Dialogue: 0,0:28:21.82,0:28:22.91,Main,Shirahoshi,0,0,0,,Hayır!
Dialogue: 0,0:28:52.23,0:28:55.45,Main,Crowd,0,0,0,,Ne?!!
Dialogue: 0,0:29:04.41,0:29:04.87,Main,Chopper,0,0,0,,Ha?!
Dialogue: 0,0:29:12.84,0:29:15.67,Main,Crowd,0,0,0,,Prenses Shirahoshi?!
Dialogue: 0,0:29:15.99,0:29:19.72,Main,Shirahoshi,0,0,0,,Ah... Şey.. Ben...
Dialogue: 0,0:29:21.28,0:29:23.01,Main,Shirahoshi,0,0,0,,Beni buldunuz!
Dialogue: 0,0:29:23.01,0:29:26.44,Main,Chopper,0,0,0,,Çok büyük! "Prenses" derken, yoksa...
Dialogue: 0,0:29:26.98,0:29:28.54,Thoughts,Chopper,0,0,0,,Deniz Kızı Prensesi mi?!
Dialogue: 0,0:29:29.21,0:29:31.03,Main,Sanji,0,0,0,,Ha? Ne oldu?
Dialogue: 0,0:29:31.03,0:29:32.44,Main,Sanji,0,0,0,,Arkamda biri mi var?
Dialogue: 0,0:29:32.44,0:29:36.54,Main,Chopper,0,0,0,,Yapma, Sanji! \NNe yaparsan yap, sakın arkanı dönme!
Dialogue: 0,0:29:37.14,0:29:38.70,Main,Sanji,0,0,0,,Neden bahsediyorsun?
Dialogue: 0,0:29:38.70,0:29:42.24,Main,Chopper,0,0,0,,Arkanı dönersen, öleceksin, Sanji!
Dialogue: 0,0:29:42.61,0:29:44.20,Main,Luffy,0,0,0,,Öf...
Dialogue: 0,0:29:51.33,0:29:56.48,Main,Crowd,0,0,0,,Deniz Kızı Prensesi kaçırılmış!
Dialogue: 0,0:30:05.52,0:30:08.86,Main,Crowd,0,0,0,,P-Prenses Shirahoshi!
Dialogue: 0,0:30:09.58,0:30:17.13,Main,Crowd,0,0,0,,Gerçekten kaçırılmış!
Dialogue: 0,0:30:17.49,0:30:20.95,Main,Luffy,0,0,0,,Hey, pısırık! Neden köpek balığından çıktın?
Dialogue: 0,0:30:24.24,0:30:26.50,Main,Shirahoshi,0,0,0,,Ü-Üzgünüm!
Dialogue: 0,0:30:26.50,0:30:29.50,Main,Shirahoshi,0,0,0,,Luffy-sama, lütfen bana o kadar kızma.
Dialogue: 0,0:30:34.04,0:30:38.05,Main,Merman,0,0,0,,O pislik, prensesi ağlattı!\NCidden rezil korsanın teki!
Dialogue: 0,0:30:38.05,0:30:40.82,Main,Merman,0,0,0,,Zavallı Prenses Shirahoshi'miz!
Dialogue: 0,0:30:46.84,0:30:47.49,Main,Sanji,0,0,0,,Prenses?
Dialogue: 0,0:30:50.87,0:30:53.10,Main,Sanji,0,0,0,,Dur biraz. Prenses.
Dialogue: 0,0:30:53.10,0:30:54.03,Main,Sanji,0,0,0,,Yoksa...
Dialogue: 0,0:30:54.03,0:30:56.44,Main,Chopper,0,0,0,,Yapma, Sanji!
Dialogue: 0,0:30:56.44,0:30:59.28,Main,Chopper,0,0,0,,Kesinlikle arkanı dönmemelisin!
Dialogue: 0,0:31:00.09,0:31:01.00,Main,Sanji,0,0,0,,Dur...
Dialogue: 0,0:31:01.82,0:31:05.22,Main,Sanji,0,0,0,,Yani arkama dönüp bakarsam,...
Dialogue: 0,0:31:06.24,0:31:09.04,Main,Sanji,0,0,0,,...Deniz Kızı Prensesi orada mı olacak?
Dialogue: 0,0:31:09.75,0:31:12.24,Main,Chopper,0,0,0,,Evet! O burada!
Dialogue: 0,0:31:12.24,0:31:14.67,Main,Chopper,0,0,0,,Bu yüzden kesinlikle \Narkanı dönmemelisin, Sanji!
Dialogue: 0,0:31:14.67,0:31:17.42,Main,Chopper,0,0,0,,Sıradan deniz kızlarını görünce\Nbile neredeyse ölüyordun.
Dialogue: 0,0:31:19.51,0:31:21.55,Main,Chopper,0,0,0,,Eğer Deniz Kızı Prensesi'ni görürsen,...
Dialogue: 0,0:31:22.58,0:31:27.44,Main,Chopper,0,0,0,,...kesinlikle son damlasına kadar\Nvücudundaki kanı yitireceksin.
Dialogue: 0,0:31:27.44,0:31:29.69,Main,Chopper,0,0,0,,Yolun sonuna gelmiş olacaksın!
Dialogue: 0,0:31:36.01,0:31:40.34,Thoughts,Sanji,0,0,0,,Deniz Kızı Prensesi. \NDünyadaki en güzel kadın.
Dialogue: 0,0:31:40.34,0:31:43.66,Thoughts,Sanji,0,0,0,,Korsan İmparatoriçesi Boa Hancock'un\Nbile onunla kıyaslanamayacağı söylenir.
Dialogue: 0,0:31:44.39,0:31:47.36,Thoughts,Sanji,0,0,0,,Tüm deniz kızlarının üstünde tutulan kadın,...
Dialogue: 0,0:31:47.36,0:31:49.71,Thoughts,Sanji,0,0,0,,...şu anda arkamda mı?
Dialogue: 0,0:31:49.71,0:31:54.49,Main,Chopper,0,0,0,,Unut gitsin! Yalvarırım... \NLütfen arkana bakma!
Dialogue: 0,0:31:59.81,0:32:01.10,Main,Sanji,0,0,0,,Chopper.
Dialogue: 0,0:32:02.14,0:32:07.54,Main,Sanji,0,0,0,,Avcumun içindeki hayali gerçekleştiremeden\Nyaşamaya devam etmek yerine,...
Dialogue: 0,0:32:09.74,0:32:11.84,Main,Sanji,0,0,0,,...o hayali gerçekleştirmeyi...
Dialogue: 0,0:32:13.20,0:32:14.86,Main,Sanji,0,0,0,,...ve ölmeyi seçiyorum!
Dialogue: 0,0:32:14.86,0:32:19.55,Main,Chopper,0,0,0,,Ne?!! Hayalinin All Blue olması \Ngerekmiyor muydu?!
Dialogue: 0,0:32:27.13,0:32:28.97,Main,Chopper,0,0,0,,Dur!
Dialogue: 0,0:32:29.88,0:32:32.42,Main,Chopper,0,0,0,,{\fad(0,2500)}{\i1}Sanji!
Dialogue: 0,0:32:37.88,0:32:43.05,Thoughts,Sanji,0,0,0,,Ha? B-B-Bu...
Dialogue: 0,0:32:44.47,0:32:48.39,Thoughts,Sanji,0,0,0,,Bununla kıyaslandığında, \Nhayallerim bile acınacak duruma düşer.
Dialogue: 0,0:32:49.85,0:32:55.31,Thoughts,Sanji,0,0,0,,Bu zarafet timsali. O gerçekten...
Dialogue: 0,0:32:58.17,0:33:01.82,Thoughts,Sanji,0,0,0,,...mutlak güzelliğin vücut bulmuş hâli.
Dialogue: 0,0:33:03.11,0:33:05.13,Main,Chopper,0,0,0,,Taşa döndü!
Dialogue: 0,0:33:06.19,0:33:08.93,Main,Chopper,0,0,0,,Burun kanamasından öleceğini sanmıştım.
Dialogue: 0,0:33:08.93,0:33:12.31,Main,Chopper,0,0,0,,Taşlaşma? Bu yeni bir belirti.
Dialogue: 0,0:33:13.63,0:33:17.31,Main,Chopper,0,0,0,,Yoksa Okama kan naklinin yan etkisi mi?
Dialogue: 0,0:33:18.08,0:33:22.11,Main,Shirahoshi,0,0,0,,Nasıl açıklayabilirim? Luffy-sama sadece...
Dialogue: 0,0:33:25.65,0:33:27.69,Main,Luffy,0,0,0,,Hey, iyi misin?!
Dialogue: 0,0:33:28.10,0:33:31.77,Main,Luffy,0,0,0,,Bunu sana kimin yaptığını söylemelisin.
Dialogue: 0,0:33:38.82,0:33:40.55,Main,Luffy,0,0,0,,Hey, ne yapıyorsunuz siz?
Dialogue: 0,0:33:41.87,0:33:43.62,Main,Crowd,0,0,0,,Yakaladık!
Dialogue: 0,0:33:43.62,0:33:46.39,Main,Crowd,0,0,0,,Hasır Şapka Korsanları'nı yakaladık!
Dialogue: 0,0:33:46.39,0:33:51.98,Main,Crowd,0,0,0,,Biz balıkçıyız! Deniz Kralları'yla mücadele\Nederken her gün canımızı riske atarız!
Dialogue: 0,0:33:51.99,0:33:53.82,Main,Crowd,0,0,0,,Korsanların lafı bile olmaz!
Dialogue: 0,0:33:53.82,0:33:56.53,Main,Crowd,0,0,0,,Balık Adam Adası balıkçılarıyla\Nkavga etmeye çalışmayın!
Dialogue: 0,0:33:56.53,0:33:58.89,Main,Crowd,0,0,0,,Balıkçılar onları yakaladı!
Dialogue: 0,0:33:58.89,0:33:59.82,Main,Crowd,0,0,0,,İyi iş!
Dialogue: 0,0:33:59.82,0:34:03.24,Main,Chopper,0,0,0,,Siz balıkçı mısınız? \NBalık olmadığımızı biliyorsunuz!
Dialogue: 0,0:34:03.24,0:34:06.04,Main,Fishman,0,0,0,,Hey! Seni hatırlıyorum!
Dialogue: 0,0:34:06.04,0:34:09.17,Main,Fishman,0,0,0,,Uzun zaman önce Arlong'la \Nbirlikteydin, değil mi? Sen hainsin!
Dialogue: 0,0:34:09.83,0:34:12.38,Main,Fishman,0,0,0,,Artık iyi olacaksın, Prenses!
Dialogue: 0,0:34:12.38,0:34:17.09,Main,Fishman,0,0,0,,Onları Ammo Şövalyeleri'ne vereceğiz\Nve kafalarını koparacaklar!
Dialogue: 0,0:34:17.09,0:34:21.43,Main,Shirahoshi,0,0,0,,Ama... tam olarak böyle olmadı...\NŞey, Luffy-sama sadece...
Dialogue: 0,0:34:23.22,0:34:26.41,Main,Luffy,0,0,0,,Hey! Buraya doğru uçarak gelen bir şey var!
Dialogue: 0,0:34:26.41,0:34:27.14,Main,Luffy,0,0,0,,Orada!
Dialogue: 0,0:34:27.68,0:34:31.48,Main,Merman,0,0,0,,Ne?! Aptalca şeyler söyleme! \NBizi kandıramazsın!
Dialogue: 0,0:34:32.85,0:34:35.09,Main,Fishman,0,0,0,,Orada! Hey!
Dialogue: 0,0:34:35.09,0:34:36.71,Main,Fishman,0,0,0,,Gerçekten bu tarafa doğru bir şey uçuyor!
Dialogue: 0,0:34:36.71,0:34:37.41,Main,Merman,0,0,0,,Ha?!
Dialogue: 0,0:34:39.08,0:34:41.15,Main,Merman,0,0,0,,Yoksa o...
Dialogue: 0,0:34:41.91,0:34:43.64,Main,Merman,0,0,0,,...Vander Decken!
Dialogue: 0,0:34:44.18,0:34:48.92,Main,Decken,0,0,0,,Seni buldum, öyle tahmin ediyorum!
Dialogue: 0,0:34:50.49,0:34:51.90,Main,Decken,0,0,0,,Shirahoshi!
Dialogue: 0,0:34:53.98,0:34:56.09,Main,Shirahoshi,0,0,0,,Vander Decken-sama.
Dialogue: 0,0:34:56.75,0:35:01.27,Main,Merman,0,0,0,,Bu kadar uzun süre saklandıktan\Nsonra, sonunda adada ortaya çıktı!
Dialogue: 0,0:35:01.27,0:35:04.27,Main,Mermen,0,0,0,,Prenses! Lütfen kaçın! Biz onu oyalarız!
Dialogue: 0,0:35:05.08,0:35:07.60,Main,Decken,0,0,0,,Bana cevap ver, Shirahoshi!
Dialogue: 0,0:35:07.60,0:35:10.49,Main,Decken,0,0,0,,Evet dersen, ölmen gerekmez!
Dialogue: 0,0:35:14.26,0:35:16.42,Main,Decken,0,0,0,,Biz...
Dialogue: 0,0:35:19.69,0:35:23.74,Main,Decken,0,0,0,,...evlenecek miyiz?!
Dialogue: 0,0:35:25.62,0:35:30.97,Main,Merman,0,0,0,,Yani on yıldan beri prensese\Nsilah fırlatan adam,...
Dialogue: 0,0:35:30.97,0:35:33.30,Main,Merman,0,0,0,,...onu sadece evlilik\Nteklifleriyle taciz mi ediyordu?!
Dialogue: 0,0:35:33.30,0:35:37.22,Main,Merman,0,0,0,,Çılgınlığın da bir sınırı vardır, Vander Decken!
Dialogue: 0,0:35:37.22,0:35:42.64,Main,Merman,0,0,0,,Senin yüzünden prenses, \Non yılını can tehlikesinden korkarak geçirdi!
Dialogue: 0,0:35:42.64,0:35:44.81,Main,Merman,0,0,0,,Sen buna nasıl...
Dialogue: 0,0:35:45.72,0:35:47.60,Main,Decken,0,0,0,,Bana cevap ver! Shirahoshi!
Dialogue: 0,0:35:47.60,0:35:49.62,Main,Decken,0,0,0,,Evet diyeceksin, öyle tahmin ediyorum!
Dialogue: 0,0:36:02.95,0:36:03.95,Main,Shirahoshi,0,0,0,,Şey,...
Dialogue: 0,0:36:03.95,0:36:06.66,Main,Decken,0,0,0,,Ne? Evet mi?
Dialogue: 0,0:36:10.09,0:36:11.41,Main,Shirahoshi,0,0,0,,Tipim değilsin.
Dialogue: 0,0:36:12.75,0:36:13.48,Main,Decken,0,0,0,,Ha?
Dialogue: 0,0:36:15.86,0:36:21.66,Main,Mermen,0,0,0,,Ha? Sebebi bu mu?!
Dialogue: 0,0:36:21.65,0:36:23.44,Main,Decken,0,0,0,,Pislik...
Dialogue: 0,0:36:23.50,0:36:29.21,Main,Decken,0,0,0,,On yıldır beni kandırıyordun!\NKiminle evlenmeyi planlıyorsun?!
Dialogue: 0,0:36:29.21,0:36:34.22,Main,Decken,0,0,0,,Benim olmayacaksan, \Nseni canlı görmek beni yaralıyor!
Dialogue: 0,0:36:34.22,0:36:36.72,Main,Decken,0,0,0,,Geber, Shirahoshi!
Dialogue: 0,0:36:36.72,0:36:38.97,Main,Decken,0,0,0,,Lütfen, Prenses Shirahoshi,\Nkaçmanız için yalvarıyoruz!
Dialogue: 0,0:36:38.97,0:36:41.69,Main,Merman,0,0,0,,Çabuk! Canımızı feda etmemiz gerekse bile,...
Dialogue: 0,0:36:42.35,0:36:45.51,Main,Luffy,0,0,0,,Kaçma! Orada dur, Pısırık!
Dialogue: 0,0:36:46.18,0:36:50.43,Main,Merman,0,0,0,,Ne diyorsun?! \NBir korsana güvenir mi sanıyorsun?!
Dialogue: 0,0:36:50.43,0:36:52.73,Main,Merman,0,0,0,,Evet, Decken'le birlikte çalışıyorsun, değil mi?
Dialogue: 0,0:36:52.75,0:36:54.48,Main,Merman,0,0,0,,Prensese ölmeyi emredebileceğini mi sanıyorsun?
Dialogue: 0,0:36:54.78,0:36:57.31,Main,Luffy,0,0,0,,Benden çok uzaklaşırsan, seni koruyamayacağım!
Dialogue: 0,0:36:59.30,0:37:00.79,Main,Shirahoshi,0,0,0,,T-Tamam! Burada kalacağım!
Dialogue: 0,0:37:00.79,0:37:01.71,Main,Merman,0,0,0,,Prenses!
Dialogue: 0,0:37:03.41,0:37:06.22,Main,Merman,0,0,0,,Gerçekten prensesi öyle tehdit\Nedebileceğini mi sanıyorsun?!
Dialogue: 0,0:37:06.22,0:37:07.84,Main,Merman,0,0,0,,Seni pis korsan!
Dialogue: 0,0:37:08.25,0:37:12.13,Main,Luffy,0,0,0,,Üzgünüm beyler, bu kişisel değil, ama...
Dialogue: 0,0:37:12.13,0:37:13.57,Main,Luffy,0,0,0,,...bana engel oluyorsunuz!
Dialogue: 0,0:37:20.60,0:37:22.00,Note,,0,0,0,,{\fad(100,100)}İkinci Vites
Dialogue: 0,0:37:23.73,0:37:24.73,Main,Chopper,0,0,0,,Luffy!
Dialogue: 0,0:37:31.61,0:37:33.90,Main,Merman,0,0,0,,Bunu bağlıyken bile yapabiliyor mu?!
Dialogue: 0,0:37:33.90,0:37:39.67,Main,Decken,0,0,0,,Bu benimle sevgili Shirahoshi'm arasında.\NNeden karışmak zorundasın?
Dialogue: 0,0:37:39.67,0:37:42.42,Main,Decken,0,0,0,,Onu alan sen olmalısın.
Dialogue: 0,0:37:45.72,0:37:47.68,Main,Luffy,0,0,0,,Demek o sendin!
Dialogue: 0,0:37:48.76,0:37:51.76,Main,Luffy,0,0,0,,Pısırığa o şeyleri atan sensin!
Dialogue: 0,0:37:53.09,0:37:58.53,Main,Decken,0,0,0,,O zaman ikinizin de canını alacağım!\Nİkinizi bir araya getirip dörde böleceğim!
Dialogue: 0,0:37:59.71,0:38:01.10,Main,Luffy,0,0,0,,Dene bakalım!
Dialogue: 0,0:38:02.38,0:38:04.61,Main,Decken,0,0,0,,B-Bırak beni!
Dialogue: 0,0:38:12.76,0:38:15.16,Attack,,0,0,0,,{\fad(100,100)}Çekiç
Dialogue: 0,0:38:32.49,0:38:37.60,Main,Merman,0,0,0,,Vander Decken'i hakladı mı?!
Dialogue: 0,0:38:43.56,0:38:46.88,Main,Merman,0,0,0,,Hâlâ hareket ediyor. \NŞimdi onu yakalayabiliriz!
Dialogue: 0,0:38:52.36,0:38:54.77,Main,Luffy,0,0,0,,Köpek balığı! Uyan!
Dialogue: 0,0:38:56.65,0:38:58.11,Main,Luffy,0,0,0,,Sanji!
Dialogue: 0,0:38:58.11,0:38:59.57,Main,Luffy,0,0,0,,İyi misin?
Dialogue: 0,0:39:00.36,0:39:05.76,Main,Chopper,0,0,0,,Demin taşa dönmüştü, ama şimdi çok\Nmutlu görünüyor. Kendine geldi.
Dialogue: 0,0:39:05.76,0:39:07.63,Main,Luffy,0,0,0,,Öyle mi? Anladım!
Dialogue: 0,0:39:09.50,0:39:11.39,Main,Sanji,0,0,0,,Deniz Kızı Prensesi.
Dialogue: 0,0:39:11.39,0:39:14.05,Main,Sanji,0,0,0,,Burası cennet mi?
Dialogue: 0,0:39:14.05,0:39:18.13,Main,Sanji,0,0,0,,Hayalim gerçekleşti. \NMutlu bir adam olarak ölebilirim.
Dialogue: 0,0:39:18.13,0:39:21.73,Main,Chopper,0,0,0,,Ama hayalin All Blue değil miydi?
Dialogue: 0,0:39:24.31,0:39:25.90,Main,Luffy,0,0,0,,Acele et, Pısırık!
Dialogue: 0,0:39:25.90,0:39:27.82,Main,Shirahoshi,0,0,0,,T-T-Tamam!
Dialogue: 0,0:39:27.85,0:39:32.85,Main,Shirahoshi,0,0,0,,A-A-Ama... seni çok sıkıntıya sokmayacaksa,\Nsesini o kadar yükseltmesen olur mu?
Dialogue: 0,0:39:32.85,0:39:34.39,Main,Shirahoshi,0,0,0,,Beni gerçekten tedirgin ediyor.
Dialogue: 0,0:39:34.41,0:39:37.81,Main,Luffy,0,0,0,,Neden bilmiyorum ama sanırım\Nartık bu adada hoş karşılanmıyoruz.
Dialogue: 0,0:39:38.49,0:39:40.78,Main,Luffy,0,0,0,,Hemen buradan gitmeliyiz.
Dialogue: 0,0:39:42.61,0:39:44.83,Main,Luffy,0,0,0,,Sağol, Pısırık!
Dialogue: 0,0:39:44.83,0:39:45.74,Main,Luffy,0,0,0,,Gidelim!
Dialogue: 0,0:39:45.74,0:39:47.12,Main,Shirahoshi,0,0,0,,T-Tamam!
Dialogue: 0,0:39:49.35,0:39:52.34,Main,Merman,0,0,0,,Prenses! Neden ipleri çözdünüz?
Dialogue: 0,0:39:52.34,0:39:55.87,Main,Merman,0,0,0,,O pis korsan... \Nprensesi yine tehdit ediyor!
Dialogue: 0,0:39:55.87,0:40:00.13,Main,Shirahoshi,0,0,0,,Gerçekten çok üzgünüm. Ama akşam\Nyemeği vaktine kadar döneceğim!
Dialogue: 0,0:40:00.13,0:40:01.30,Main,Merman,0,0,0,,Ha?!
Dialogue: 0,0:40:01.30,0:40:03.94,Main,Luffy,0,0,0,,Köpek balığı, ileri!
Dialogue: 0,0:40:14.06,0:40:15.45,Main,Decken,0,0,0,,Çekilin, pislikler!
Dialogue: 0,0:40:19.18,0:40:21.07,Main,Decken,0,0,0,,O kadar kolay kaçmanıza izin vermiyorum!
Dialogue: 0,0:40:21.07,0:40:23.19,Main,Decken,0,0,0,,Wadatsumi!
Dialogue: 0,0:40:37.61,0:40:39.87,Main,Luffy,0,0,0,,Onu daha önce gördüm.
Dialogue: 0,0:40:39.87,0:40:43.24,Main,Chopper,0,0,0,,Sunny'ye saldıran Umibouzu!\NDecken'in adamlarından biri!
Dialogue: 0,0:40:43.92,0:40:45.63,Main,Merman,0,0,0,,Büyük Keşiş!
Dialogue: 0,0:40:45.63,0:40:46.39,Main,Merman,0,0,0,,Wadatsumi!
Dialogue: 0,0:40:46.39,0:40:49.31,Main,Decken,0,0,0,,Onları gökyüzünün dışına fırlat!
Dialogue: 0,0:40:49.73,0:40:53.24,Main,Wadatsumi,0,0,0,,Anlaşıldı!
Dialogue: 0,0:40:54.04,0:40:55.74,Note,,0,0,0,,{\fad(100,100)}İkinci Vites
Dialogue: 0,0:41:08.44,0:41:09.94,Attack,,0,0,0,,{\fad(100,100)}Tabanca
Dialogue: 0,0:41:14.19,0:41:21.43,Main,Wadatsumi,0,0,0,,Dişim! Ön dişim! Kırıldı!
Dialogue: 0,0:41:24.76,0:41:27.32,Main,Wadatsumi,0,0,0,,Ah! Ah!
Dialogue: 0,0:41:28.44,0:41:30.86,Main,Decken,0,0,0,,Seni aşırı gelişmiş velet!
Dialogue: 0,0:41:32.24,0:41:33.20,Main,Luffy,0,0,0,,Tamamdır!
Dialogue: 0,0:41:34.33,0:41:36.17,Main,Luffy,0,0,0,,Gidiyoruz, Pısırık!
Dialogue: 0,0:41:36.17,0:41:37.33,Main,Luffy,0,0,0,,Deniz Ormanı'na!
Dialogue: 0,0:41:37.33,0:41:38.05,Main,Shirahoshi,0,0,0,,Tamam!
Dialogue: 0,0:41:40.15,0:41:46.30,Main,Underling,0,0,0,,Patron Hody! İki kadın, bir korsan ve\Nbir deniz kızı Ryugu Sarayı'ndan kaçtı!
Dialogue: 0,0:41:46.70,0:41:48.09,Main,Hody,0,0,0,,Bırakın gitsinler.
Dialogue: 0,0:41:48.38,0:41:52.12,Main,Caimie,0,0,0,,Nami-chin, bu gerçekten doğru mu?\NZoro-chinler'i o şekilde bırakmak...
Dialogue: 0,0:41:52.12,0:41:55.13,Main,Nami,0,0,0,,Herkesi taşıyabilecek değilsin ya.
Dialogue: 0,0:41:55.13,0:41:56.68,Main,Caimie,0,0,0,,O da doğru, ama...
Dialogue: 0,0:41:57.05,0:41:58.67,Main,Nami,0,0,0,,Dert etme!
Dialogue: 0,0:41:58.67,0:42:01.52,Main,Nami,0,0,0,,Endişelenmenin faydası olmaz!
Dialogue: 0,0:42:02.54,0:42:04.93,Main,Caimie,0,0,0,,Herkesin güçlü olduğunu biliyorum, ama...
Dialogue: 0,0:42:06.97,0:42:12.84,Main,Caimie,0,0,0,,Hody sadece güçlü değil. Fikirleri de\Nçok tehlikeli ya da Hacchin öyle diyor.
Dialogue: 0,0:42:15.74,0:42:20.98,Main,Nami,0,0,0,,İki yıldır, öncekinden çok daha fazla güçlendik.
Dialogue: 0,0:42:20.98,0:42:24.62,Main,Nami,0,0,0,,Ama asıl önemlisi, \Neski Shichibukai Jinbe nasıl biri?
Dialogue: 0,0:42:24.62,0:42:25.50,Main,Caimie,0,0,0,,Ha?
Dialogue: 0,0:42:27.41,0:42:30.24,Main,Caimie,0,0,0,,Evet, Patron Jinbe. Bir korsan, ama...
Dialogue: 0,0:42:30.24,0:42:33.46,Main,Caimie,0,0,0,,...o kadar sevilir ki, \Nistediği gibi Ryugu Sarayı'na gelip giderdi.
Dialogue: 0,0:42:33.46,0:42:38.74,Main,Nami,0,0,0,,Evet. Ama Arlong'la aynı tayfadaydı, değil mi?
Dialogue: 0,0:42:38.74,0:42:42.64,Main,Nami,0,0,0,,Hody, Arlong'un bıraktığı\Nyerden devralacağını söyledi.
Dialogue: 0,0:42:43.52,0:42:47.98,Main,Nami,0,0,0,,Jinbe, Luffy için bir mesaj bırakmış: \N"Hody'le dövüşme".
Dialogue: 0,0:42:47.98,0:42:50.70,Main,Nami,0,0,0,,Sanırım ne demek istediğini anlıyorum.
Dialogue: 0,0:42:50.70,0:42:53.36,Main,Caimie,0,0,0,,Ha? Tehlikeli olacağını kastettiğini düşünmüyorsun, değil mi?
Dialogue: 0,0:42:53.36,0:42:57.90,Main,Nami,0,0,0,,Umarım Zorolar, bizi bu olaya daha fazla\Nsürükleyecek şekilde Hody'yi kızdırmaz.
Dialogue: 0,0:42:57.90,0:43:01.99,Main,Nami,0,0,0,,Yine de Jinbe'yi görmek istiyorum.
Dialogue: 0,0:43:01.99,0:43:05.03,Main,Nami,0,0,0,,"Seni Deniz Ormanı'nda bekliyor olacağım" demiş.
Dialogue: 0,0:43:05.03,0:43:07.12,Main,Nami,0,0,0,,Bu olay krallığa büyük bir darbe vuracak.
Dialogue: 0,0:43:07.65,0:43:12.10,Main,Nami,0,0,0,,Krallığı iliklerine kadar sarsacak büyüklükte\Nayaklanmalar olma ihtimali bile var.
Dialogue: 0,0:43:12.65,0:43:15.37,Main,Nami,0,0,0,,Bence o her şeyi biliyor.
Dialogue: 0,0:43:15.37,0:43:16.94,Main,Caimie,0,0,0,,Patron Jinbe bunu biliyor mu?
Dialogue: 0,0:43:16.94,0:43:17.80,Main,Nami,0,0,0,,Caimie.
Dialogue: 0,0:43:19.80,0:43:21.80,Main,Nami,0,0,0,,Beni Deniz Ormanı'na götür!
Dialogue: 0,0:43:22.39,0:43:23.16,Main,Caimie,0,0,0,,Tamam!
Dialogue: 0,0:43:34.60,0:43:36.73,Main,Neptune,0,0,0,,Herkes dinlesin!
Dialogue: 0,0:43:36.73,0:43:40.97,Main,Guards,0,0,0,,Emredersiniz! Hody ve tayfasını\Nhemen buradan çıkaracağız.
Dialogue: 0,0:43:40.97,0:43:42.02,Main,Neptune,0,0,0,,Olmaz-jamon!
Dialogue: 0,0:43:42.02,0:43:42.82,Main,Guards,0,0,0,,Ha?!
Dialogue: 0,0:43:42.82,0:43:45.29,Main,Neptune,0,0,0,,Ben düzgün dövüşemiyorum.
Dialogue: 0,0:43:45.29,0:43:48.28,Main,Neptune,0,0,0,,Şu durumda hepiniz yok yere ölürsünüz.
Dialogue: 0,0:43:48.88,0:43:51.76,Main,Neptune,0,0,0,,Sarayı hemen onlara teslim edeceksiniz.
Dialogue: 0,0:43:51.76,0:43:55.54,Main,Neptune,0,0,0,,Fukaboshi'ye katılacağız ve sonra sarayı\Nyeniden ele geçirmek için plan hazırlayacağız.
Dialogue: 0,0:43:56.21,0:44:00.58,Main,Guards,0,0,0,,Sarayı teslim etmek mi?!\NCiddi misiniz, Neptune-sama?!
Dialogue: 0,0:44:00.58,0:44:05.18,Main,Usopp,0,0,0,,Ah, şu Zoro... Bir balık adama karşı\Nsu altında ne yapabileceğini sanıyorsun?!
Dialogue: 0,0:44:06.17,0:44:12.24,Main,Brook,0,0,0,,Usopp-san, gücüm tükeniyor.\NHer an boğulup ölebilecekmişim gibi.
Dialogue: 0,0:44:12.24,0:44:14.37,Main,Usopp,0,0,0,,Sen zaten ölüsün.
Dialogue: 0,0:44:17.51,0:44:18.44,Main,Brook,0,0,0,,Doğru.
Dialogue: 0,0:44:26.62,0:44:27.97,Main,Usopp,0,0,0,,Zoro!
