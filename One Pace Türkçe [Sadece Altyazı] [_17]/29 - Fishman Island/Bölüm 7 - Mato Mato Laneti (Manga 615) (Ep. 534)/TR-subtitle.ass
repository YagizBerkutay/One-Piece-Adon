Dialogue: 0,0:00:02.99,0:00:08.38,Main,,0,0,0,,Dünyanın sunabileceği her şeyi elde eden adam, Korsanlar Kralı Gold Roger.
Dialogue: 0,0:00:08.38,0:00:13.00,Main,,0,0,0,,Son sözleri dünyanın her yerinden\Nmaceracıları denize çekti.
Dialogue: 0,0:00:13.00,0:00:14.68,Main,,0,0,0,,"Hazinem mi?"
Dialogue: 0,0:00:14.68,0:00:16.22,Main,,0,0,0,,"İstiyorsanız, size vereceğim!"
Dialogue: 0,0:00:16.22,0:00:17.42,Main,,0,0,0,,"Arayın ve bulun!"
Dialogue: 0,0:00:17.42,0:00:19.87,Main,,0,0,0,,"Bu dünyanın sunabileceği her şeyi orada bıraktım!"
Dialogue: 0,0:00:19.87,0:00:22.69,Main,,0,0,0,,Korsanlar hayallerinin peşinden yola çıktılar!
Dialogue: 0,0:00:22.69,0:00:25.35,Main,,0,0,0,,Dünya, Büyük Korsan Çağı'na girdi!
Dialogue: 0,0:00:25.35,0:00:29.31,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪
Dialogue: 0,0:00:29.31,0:00:33.81,We Go lyrics,,0,0,0,,♪ Şafak vakti gelmedi bile ve ben bekleyemiyorum! ♪
Dialogue: 0,0:00:33.81,0:00:37.48,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı, dört... Gidelim! ♪
Dialogue: 0,0:00:38.97,0:00:43.05,We Go lyrics,,0,0,0,,♪ Bayrağımızı dalgalandıralım, macera şafağının doğuşuna. ♪
Dialogue: 0,0:00:44.41,0:00:49.74,We Go lyrics,,0,0,0,,♪ Dalgalar yapalım, bizi uykumuzdan kaldırsınlar. ♪
Dialogue: 0,0:00:49.74,0:00:54.28,We Go lyrics,,0,0,0,,♪ Eğer inanılmaz bir dünyaya gitmek istiyorsan,
Dialogue: 0,0:00:54.28,0:00:58.79,We Go lyrics,,0,0,0,, gerekli olan şey senin dayanıklılığın. ♪
Dialogue: 0,0:00:59.11,0:01:01.73,We Go lyrics,,0,0,0,,♪ Fazla dikkat çekmek, bu bir suç mu? ♪
Dialogue: 0,0:01:01.73,0:01:04.62,We Go lyrics,,0,0,0,,♪ Aranıyor → Kazanan demektir! ♪
Dialogue: 0,0:01:04.62,0:01:10.50,We Go lyrics,,0,0,0,,♪ Özgür olmak bizim tek kuralımız! ♪
Dialogue: 0,0:01:10.50,0:01:15.99,We Go lyrics,,0,0,0,,♪ Endişelerinizi unutun, bırakın rüzgar essin. ♪
Dialogue: 0,0:01:15.99,0:01:18.53,We Go lyrics,,0,0,0,,♪ Ne pahasına olursa olsun, One Piece'i ilk biz bulacağız! ♪
Dialogue: 0,0:01:18.53,0:01:22.66,We Go lyrics,,0,0,0,,♪ Hayal kuran kalplerimiz, çok büyük... ♪
Dialogue: 0,0:01:22.66,0:01:26.93,We Go lyrics,,0,0,0,,♪ Onları uyandırmamak önemli. ♪
Dialogue: 0,0:01:26.93,0:01:29.57,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪
Dialogue: 0,0:01:29.57,0:01:33.54,We Go lyrics,,0,0,0,,♪ Şafak vakti gelmedi bile ve ben bekleyemiyorum! ♪
Dialogue: 0,0:01:33.54,0:01:37.33,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı, dört... Gidelim! ♪
Dialogue: 0,0:01:38.76,0:01:44.72,We Go lyrics,,0,0,0,,♪ Biz... buralara kadar geldik. ♪
Dialogue: 0,0:01:44.72,0:01:47.62,We Go lyrics,,0,0,0,,♪ Gideceğiz... hayallerimizin olduğu yere,
Dialogue: 0,0:01:47.62,0:01:52.70,We Go lyrics,,0,0,0,, ve kimseyi arkada bırakmayacağız. ♪
Dialogue: 0,0:01:52.70,0:01:55.30,We Go lyrics,,0,0,0,,♪ Hep devam edeceğiz, bu bir söz. ♪
Dialogue: 0,0:01:55.30,0:01:59.47,We Go lyrics,,0,0,0,,♪ Hayallerimizin başladığı o günden beri,
Dialogue: 0,0:01:59.47,0:02:03.72,We Go lyrics,,0,0,0,, belirlediğimiz gelecek, değişmedi! ♪
Dialogue: 0,0:02:03.72,0:02:06.24,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪
Dialogue: 0,0:02:06.24,0:02:10.61,We Go lyrics,,0,0,0,,♪ Kalbimdeki güneş, asla batmayacak! ♪
Dialogue: 0,0:02:10.61,0:02:13.38,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... ♪
Dialogue: 0,0:02:14.78,0:02:17.57,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... ♪
Dialogue: 0,0:02:18.75,0:02:24.82,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... dört... Gidelim! ♪
Dialogue: 0,0:02:27.27,0:02:29.44,We Go lyrics,,0,0,0,,♪ Gidelim! ♪
Dialogue: 0,0:02:32.40,0:02:34.41,Main,Brook,0,0,0,,D-D-Dur! Luffy-san?!
Dialogue: 0,0:02:34.41,0:02:36.61,Main,Right Minister,0,0,0,,Hey! Dur, Megalo!
Dialogue: 0,0:02:36.61,0:02:38.57,Main,Right Minister,0,0,0,,Nereye gidiyorsun?!
Dialogue: 0,0:02:39.48,0:02:43.04,Thoughts,Shirahoshi,0,0,0,,Baba, abilerim ve kaledeki herkes.
Dialogue: 0,0:02:43.04,0:02:44.35,Thoughts,Shirahoshi,0,0,0,,Lütfen beni affedin!
Dialogue: 0,0:02:44.95,0:02:46.98,Thoughts,Shirahoshi,0,0,0,,İzin almadan gidiyorum!
Dialogue: 0,0:02:51.37,0:02:53.54,Thoughts,Shirahoshi,0,0,0,,Akşam yemeği vaktine kadar döneceğim!
Dialogue: 0,0:02:56.58,0:02:57.84,Main,Luffy,0,0,0,,Yürüyüşe çıkalım!
Dialogue: 0,0:02:57.86,0:03:05.86,Author,,0,0,0,,{\fad(600,0)\fs19} Türkçeleştirme & Çevirmen  {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&} - {\c&H01BAFF&}{\b1}Kazasker{\b0}{\c&HFFFFFF&}\N{\fs19}thx to onepace.net
Dialogue: 0,0:18:22.25,0:18:25.25,Author,,0,0,0,,{\fad(0,0)\fs19} Türkçeleştirme & Çevirmen  {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&} - {\c&H01BAFF&}{\b1}Kazasker{\b0}{\c&HFFFFFF&}\N{\fs19}thx to onepace.net
Dialogue: 0,0:02:57.86,0:03:05.86,Title,,0,0,0,,{\fad(600,0)}Mato Mato Laneti
Dialogue: 0,0:03:00.03,0:03:02.22,Main,Right Minister,0,0,0,,Ne yapıyorsun, Megalo?!
Dialogue: 0,0:03:03.25,0:03:06.50,Main,Right Minister,0,0,0,,Koukaku Kulesi'nin kapısını\Nardına kadar açık bıraktın.
Dialogue: 0,0:03:06.50,0:03:08.06,Main,Right Minister,0,0,0,,Prensese bir şey olursa ne olacak?!
Dialogue: 0,0:03:08.90,0:03:12.54,Main,Right Minister,0,0,0,,Korsan! Hemen prenses güvende mi bakalım!
Dialogue: 0,0:03:12.54,0:03:15.48,Main,Brook,0,0,0,,Kemiklerimi çok zorluyorsun.
Dialogue: 0,0:03:21.22,0:03:25.12,Main,Right Minister,0,0,0,,Gitmiş! Prenses Shirahoshi gitmiş!
Dialogue: 0,0:03:25.12,0:03:28.84,Main,Brook,0,0,0,,Ne?! Deniz Kızı Prensesi burada değil mi?!
Dialogue: 0,0:03:28.84,0:03:31.54,Main,Right Minister,0,0,0,,Durum kötü! Ulusal bir kriz!
Dialogue: 0,0:03:31.54,0:03:34.46,Main,Right Minister,0,0,0,,Bu ne zaman oldu? Kim yapmış olabilir?!
Dialogue: 0,0:03:34.46,0:03:36.63,Main,Right Minister,0,0,0,,Kaçırılmış!
Dialogue: 0,0:03:36.63,0:03:37.90,Main,Brook,0,0,0,,Kaçırılmış mı?!
Dialogue: 0,0:03:37.90,0:03:41.05,Main,Right Minister,0,0,0,,Prenses!
Dialogue: 0,0:03:41.05,0:03:43.28,Main,Right Minister,0,0,0,,Oh, prenses.
Dialogue: 0,0:03:43.28,0:03:44.97,Main,Brook,0,0,0,,Kaçırılmış, yoksa-
Dialogue: 0,0:03:46.43,0:03:48.72,Main,Brook,0,0,0,,Hey! Ne yapıyorsun?!
Dialogue: 0,0:03:53.27,0:03:56.85,Main,Pirate,0,0,0,,Ryugu Sarayı'nı \NBalık Adam Adası'na bağlayan kanalın...
Dialogue: 0,0:03:56.85,0:03:59.38,Main,Pirate,0,0,0,,...açma düğmesi nerede?!
Dialogue: 0,0:03:59.38,0:04:01.24,Main,Brook,0,0,0,,Ne? Düğme mi?
Dialogue: 0,0:04:01.24,0:04:04.32,Main,Right Minister,0,0,0,,Yine de hemen Neptune-sama'ya dönmeliyiz, İskelet!
Dialogue: 0,0:04:04.76,0:04:07.91,Main,Right Minister,0,0,0,,Bunu hemen ona bildirmeliyiz!
Dialogue: 0,0:04:07.91,0:04:10.58,Main,Pirate,0,0,0,,Başka çaremiz yok.
Dialogue: 0,0:04:10.58,0:04:16.58,Main,Pirate,0,0,0,,Hayatta kalmak için tek şansımız\Nonların emirlerine uymak.
Dialogue: 0,0:04:18.18,0:04:19.80,Main,Pirate,0,0,0,,Söyleyin artık!
Dialogue: 0,0:04:20.35,0:04:21.52,Main,Brook,0,0,0,,"Onlar" kim?
Dialogue: 0,0:04:21.52,0:04:24.55,Main,Pirate,0,0,0,,Söylemezseniz, bizi öldürecekler!
Dialogue: 0,0:04:24.55,0:04:25.55,Main,Brook,0,0,0,,Öldürmek mi?!
Dialogue: 0,0:04:28.05,0:04:30.52,Main,Brook,0,0,0,,Neden bahsediyorsunuz?!
Dialogue: 0,0:04:30.54,0:04:33.89,Captions,,0,0,0,,{\fad(300,0)}Birkaç Saat Önce - Balık Adam Bölgesi, "Noah"
Dialogue: 0,0:04:39.63,0:04:42.98,Main,Decken,0,0,0,,Hody Jones için çalışan korsanlar, dinleyin!
Dialogue: 0,0:04:43.81,0:04:50.33,Main,Decken,0,0,0,,Şanslısınız! \NBu tarihi olayın bir parçası olmalısınız!
Dialogue: 0,0:04:50.33,0:04:54.81,Main,Pirate,0,0,0,,Vander Decken. \NUçan Hollandalı'nın kaptanı değil mi o?
Dialogue: 0,0:04:54.81,0:04:57.87,Main,Pirate,0,0,0,,Lanetli hayalet geminin kaptanı mı?
Dialogue: 0,0:04:59.16,0:05:01.53,Main,Decken,0,0,0,,Endişelenmeyin, ben sadece onun torunuyum.
Dialogue: 0,0:05:01.53,0:05:03.36,Main,Decken,0,0,0,,Hayalet değilim.
Dialogue: 0,0:05:03.36,0:05:06.25,Main,Decken,0,0,0,,Ama ben de lanetlendim.
Dialogue: 0,0:05:06.25,0:05:08.28,Main,Decken,0,0,0,,Balık adamım ama yine de yüzemiyorum.
Dialogue: 0,0:05:08.28,0:05:14.89,Main,Decken,0,0,0,,Mato Mato lanetiyle elde ettiğim\Nşeytanın gücünü size göstereyim!
Dialogue: 0,0:05:17.10,0:05:21.25,Main,Decken,0,0,0,,Tamam, sen iş görürsün. İnsan, öne çık.
Dialogue: 0,0:05:23.36,0:05:25.86,Main,Hachi,0,0,0,,{\i1}Hody!
Dialogue: 0,0:05:32.47,0:05:34.37,Main,Hachi,0,0,0,,Bunu gerçekten yapacak mısın?!
Dialogue: 0,0:05:34.77,0:05:36.99,Main,Hachi,0,0,0,,Bu çılgınlığı durdur!
Dialogue: 0,0:05:36.99,0:05:39.08,Main,Crowd,0,0,0,,Bu o! Hachi-san!
Dialogue: 0,0:05:39.08,0:05:40.04,Main,Fishman,0,0,0,,Hachi-san!
Dialogue: 0,0:05:40.04,0:05:41.17,Main,Fishman,0,0,0,,Hacchan-san!
Dialogue: 0,0:05:42.59,0:05:43.54,Main,Hody,0,0,0,,Hachi-san.
Dialogue: 0,0:05:43.86,0:05:48.13,Main,Hachi,0,0,0,,Enerji Steroidi sadece bedenini yok eden bir hap!
Dialogue: 0,0:05:48.13,0:05:51.09,Main,Hachi,0,0,0,,Balık adamlar neden \NBalık Adam Adası'nı yok etmeye çalışıyor?!
Dialogue: 0,0:05:51.09,0:05:53.89,Main,Hachi,0,0,0,,Denizin şampiyonu Neptune'u hafife almayın!
Dialogue: 0,0:05:53.89,0:05:57.93,Main,Hody,0,0,0,,Hachi-san, yeter artık.
Dialogue: 0,0:05:57.93,0:06:00.93,Main,Hody,0,0,0,,Senin görüşün ilgimi çekmiyor.
Dialogue: 0,0:06:00.93,0:06:04.90,Main,Hody,0,0,0,,Bir zamanlar saygı duyduğum tayfanın bir\Nüyesi olduğuna bile zor inanıyorum.
Dialogue: 0,0:06:05.26,0:06:07.51,Main,Hody,0,0,0,,Güçten düşmüşsün.
Dialogue: 0,0:06:07.51,0:06:10.20,Main,Hody,0,0,0,,Senin dönemin kapandı.
Dialogue: 0,0:06:12.08,0:06:19.36,Main,Hody,0,0,0,,İnsanlara ve bana engel olan Neptune'e bir ders\Nvereceksem, Balık Adam Adası'na ihtiyacım var.
Dialogue: 0,0:06:19.36,0:06:23.75,Main,Hody,0,0,0,,Bize üstün türler olduğumuzu öğreten sizdiniz.
Dialogue: 0,0:06:24.18,0:06:26.62,Main,Hachi,0,0,0,,Ama Arlong-san yenildi!
Dialogue: 0,0:06:27.40,0:06:30.92,Main,Hachi,0,0,0,,Decken! Hyouzou! Neden ondan yana oluyorsunuz?!
Dialogue: 0,0:06:30.92,0:06:38.25,Main,Hachi,0,0,0,,O zamanlar Arlong-san'ın teklifini geri çevirmiştiniz, \Nşimdi neden bu genç ahmaklara yardım ediyorsunuz?!
Dialogue: 0,0:06:39.67,0:06:44.22,Main,Hyouzou,0,0,0,,Yardım mı? Ben sadece ödeme\Nyaptığı için burada çalışıyorum.
Dialogue: 0,0:06:45.49,0:06:50.79,Main,Hyouzou,0,0,0,,Arlong parasını paylaşmak\Nistemediği için beni kiralayamadı.
Dialogue: 0,0:06:50.79,0:06:56.29,Main,Hyouzou,0,0,0,,Arlong'un, kapasitesi senin kadar bir\Nkılıç ustasına sahip olmuş olması çok yazık.
Dialogue: 0,0:06:57.08,0:07:01.15,Main,Decken,0,0,0,,Demek sen Arlong'un tayfasından\NHachi'sin, ha? Anılarım canlandı!
Dialogue: 0,0:07:01.15,0:07:06.71,Main,Decken,0,0,0,,Kaptanın bir zamanlar beni de\Nemri altına almak istedi.
Dialogue: 0,0:07:06.71,0:07:08.83,Main,Decken,0,0,0,,Ama bunu kabul edemezdim.
Dialogue: 0,0:07:08.83,0:07:12.78,Main,Decken,0,0,0,,Birinin bana patronluk\Ntaslamasına asla izin veremezdim.
Dialogue: 0,0:07:12.78,0:07:14.89,Main,Decken,0,0,0,,Hody bunu anlıyor.
Dialogue: 0,0:07:16.18,0:07:20.68,Main,Hody,0,0,0,,Arlong-san'ın amacı ve harekete\Ngeçme yeteneği takdire değerdi.
Dialogue: 0,0:07:26.61,0:07:31.23,Main,Hody,0,0,0,,Onda beyin namına bir şey yoktu,\Nsadece kas yığınından ibaretti.
Dialogue: 0,0:07:31.23,0:07:38.44,Main,Hody,0,0,0,,İsteseydik bile, sizin denizlerde estiğiniz\Nzamanlar korsan olmak için çok küçüktük.
Dialogue: 0,0:07:38.81,0:07:41.74,Main,Hody,0,0,0,,Şimdiyse o günlerde büyüyen\Nherkes burada toplandı.
Dialogue: 0,0:07:41.74,0:07:45.87,Main,Hody,0,0,0,,Kararlılığımız sağlam ve\Natalarımızın hatalarından ders aldık.
Dialogue: 0,0:07:47.08,0:07:51.20,Main,Hody,0,0,0,,Ben, Arlong'un arzusunu gerçekleştirecek kişiyim.
Dialogue: 0,0:07:51.20,0:07:56.72,Main,Hody,0,0,0,,Sen, saygı duyduğum tayfanın eski üyesi,\Nplanımı onaylamadığını mı söylüyorsun?
Dialogue: 0,0:07:56.72,0:08:00.35,Main,Hody,0,0,0,,Bu gerçekten cesaret kırıcı, Hachi-san!
Dialogue: 0,0:08:00.35,0:08:06.79,Main,Hody,0,0,0,,Biz bu meseleyi konuşurken, Hasır Şapkalı Luffy geldi. \NHayallerinizi yıkan kişinin ta kendisi.
Dialogue: 0,0:08:06.79,0:08:09.61,Main,Hody,0,0,0,,Bunu da mı umursamıyorsun?!
Dialogue: 0,0:08:10.14,0:08:14.77,Main,Hachi,0,0,0,,Eskiden Arlong'un tayfasından olmama\Nrağmen, bana "arkadaşım" dedi!
Dialogue: 0,0:08:15.07,0:08:18.41,Flashbacks,Luffy,0,0,0,,Üçünüz arkadaşımsınız!
Dialogue: 0,0:08:19.18,0:08:22.67,Main,Hachi,0,0,0,,Hasır Şapkalı Luffy'ye canımı borçluyum!
Dialogue: 0,0:08:22.67,0:08:24.29,Main,Hachi,0,0,0,,Hemen onu görmeye giderdim,...
Dialogue: 0,0:08:27.21,0:08:32.70,Main,Hachi,0,0,0,,...ama Arlong'un arzusu yaşadığı sürece,\Nonun karşına çıkmaya yüzüm yok!
Dialogue: 0,0:08:33.45,0:08:37.66,Main,Hody,0,0,0,,İnsanlar arkadaşın mı?! Seni pislik!
Dialogue: 0,0:08:37.66,0:08:40.22,Main,Hody,0,0,0,,Beni büyük hayalkırıklığına uğrattın!
Dialogue: 0,0:08:41.71,0:08:43.93,Main,Decken,0,0,0,,Sana kilitlendim, Hachi.
Dialogue: 0,0:08:46.94,0:08:49.73,Main,Decken,0,0,0,,Korsanların işleri nasıl yürüttüğünü unuttun mu?
Dialogue: 0,0:08:50.17,0:08:55.30,Main,Decken,0,0,0,,Biriyle sorunun varsa,\Nşiddet kullanarak çözmelisin.
Dialogue: 0,0:08:55.30,0:08:56.49,Main,Decken,0,0,0,,Öyle tahmin ediyorum!
Dialogue: 0,0:08:58.75,0:09:00.54,Main,Fishman,0,0,0,,Onu nereye attı?
Dialogue: 0,0:09:00.54,0:09:06.03,Main,Decken,0,0,0,,Demin sana dokunduğumda, hedefim oldun.
Dialogue: 0,0:09:06.35,0:09:09.29,Main,Decken,0,0,0,,Ne atarsam atayım, nereye atarsam atayım,...
Dialogue: 0,0:09:09.29,0:09:12.45,Main,Decken,0,0,0,,...avcı kuşu gibi yönünü değiştirecek...
Dialogue: 0,0:09:12.45,0:09:17.29,Main,Decken,0,0,0,,...ve doğruca hedefine, sana gidecek!
Dialogue: 0,0:09:18.34,0:09:21.69,Main,Pirate,0,0,0,,Bıçağı rastgele fırlatmış gibiydi,...
Dialogue: 0,0:09:21.69,0:09:22.76,Main,Pirate,0,0,0,,...ama doğrudan ahtapot balık adama vurdu!
Dialogue: 0,0:09:24.33,0:09:26.27,Main,Hachi,0,0,0,,Mato Mato laneti...
Dialogue: 0,0:09:26.82,0:09:30.88,Main,Decken,0,0,0,,Elbette bunu durdurmanın birkaç yolu var.
Dialogue: 0,0:09:31.86,0:09:33.15,Main,Decken,0,0,0,,Neden denemiyoruz?
Dialogue: 0,0:09:34.55,0:09:36.28,Main,Hachi,0,0,0,,Dur! Okların hepsini atma.
Dialogue: 0,0:09:36.70,0:09:39.65,Main,Hachi,0,0,0,,Yeteneğinle ilgili söylentiler duydum.
Dialogue: 0,0:09:39.65,0:09:42.45,Main,Hachi,0,0,0,,Hey, Hody, böyle giderse beni öldürecek!
Dialogue: 0,0:09:42.45,0:09:45.05,Main,Hachi,0,0,0,,Lütfen, dur Decken!
Dialogue: 0,0:09:45.05,0:09:47.47,Main,Hody,0,0,0,,Demin sana söylemedi mi, Hachi-san?
Dialogue: 0,0:09:47.47,0:09:50.94,Main,Hody,0,0,0,,Vander Decken benim emrimde değil.
Dialogue: 0,0:09:50.94,0:09:53.95,Main,Hody,0,0,0,,Biz, eşit şartlarda ittifak yapmış iki korsanız.
Dialogue: 0,0:09:53.95,0:09:58.86,Main,Hody,0,0,0,,Üstelik, sen sadece baş belasısın.
Dialogue: 0,0:09:58.86,0:10:00.30,Main,Hody,0,0,0,,Seni lanet korkak!
Dialogue: 0,0:10:00.91,0:10:01.64,Main,Hachi,0,0,0,,Kahretsin!
Dialogue: 0,0:10:02.72,0:10:06.48,Main,Decken,0,0,0,,Başlıyoruz!
Dialogue: 0,0:10:10.93,0:10:13.98,Main,Decken,0,0,0,,İyi! Kaç, kaç!
Dialogue: 0,0:10:13.98,0:10:15.45,Main,Decken,0,0,0,,Ama nereye gidersen git,...
Dialogue: 0,0:10:16.09,0:10:19.36,Main,Decken,0,0,0,,Nereye gidersen git,...
Dialogue: 0,0:10:19.36,0:10:22.16,Main,Decken,0,0,0,,Nereye gidersen git,... peşinden gelecekler!
Dialogue: 0,0:10:24.13,0:10:25.95,Main,Hachi,0,0,0,,Dışarı çıkabilirsem,...
Dialogue: 0,0:10:31.19,0:10:33.29,Main,Hachi,0,0,0,,Tamam, artık kaçabilirim!
Dialogue: 0,0:10:33.29,0:10:34.97,Main,Hachi,0,0,0,,Oklar beni suda takip edemez.
Dialogue: 0,0:10:37.89,0:10:40.63,Main,Hachi,0,0,0,,Kahretsin! Demek suda olup\Nolmamalarının önemi yok.
Dialogue: 0,0:10:41.21,0:10:42.21,Main,Hachi,0,0,0,,Uzak durun!
Dialogue: 0,0:11:00.32,0:11:04.61,Main,Decken,0,0,0,,Hafızamda tutabildiğim hedeflerin\Nsayısı, ellerimin sayısı kadar.
Dialogue: 0,0:11:04.61,0:11:05.49,Main,Decken,0,0,0,,İki tane.
Dialogue: 0,0:11:06.37,0:11:10.09,Main,Decken,0,0,0,,On yıldır yıkamadığım sağ elim,...
Dialogue: 0,0:11:10.09,0:11:16.41,Main,Decken,0,0,0,,...Ryugu Sarayı prensesine dokunduğum\Nzamanın anısına sahip. Shirahoshi'nin anısına!
Dialogue: 0,0:11:16.41,0:11:20.42,Main,Decken,0,0,0,,Anlıyor musunuz?!\NFırlattığım tüm aşk ve silahlar...
Dialogue: 0,0:11:20.81,0:11:24.21,Main,Decken,0,0,0,,...Cehennem'in derinliklerine kadar\Nbile hedefimin peşinden gidecek!
Dialogue: 0,0:11:24.21,0:11:26.21,Main,Decken,0,0,0,,Benim gücüm bu!
Dialogue: 0,0:11:26.56,0:11:27.17,Main,Fishman,0,0,0,,Müthiş!
Dialogue: 0,0:11:27.80,0:11:32.01,Main,Fishman,0,0,0,,Demek Neptune Ordusu tarafından\Ngörülmeden ya da yakalanmadan...
Dialogue: 0,0:11:32.01,0:11:35.52,Main,Fishman,0,0,0,,...sinsi tacizci aşkınızı bu\Nşekilde muhafaza edebildiniz!
Dialogue: 0,0:11:35.52,0:11:36.97,Main,Decken,0,0,0,,Kesinlikle!
Dialogue: 0,0:11:36.97,0:11:38.82,Main,Pirate,0,0,0,,Ne kurnaz bir adam!
Dialogue: 0,0:11:38.82,0:11:43.86,Secondary,Crowd,0,0,0,,{\i1\an8\fs40}Kurnaz! Kurnaz!
Dialogue: 0,0:11:41.12,0:11:43.86,Main,Hody,0,0,0,,Pekâlâ, insan korsanlar.
Dialogue: 0,0:11:43.86,0:11:47.48,Main,Hody,0,0,0,,Decken'in yeteneğini artık anlıyorsunuz, değil mi?
Dialogue: 0,0:11:47.48,0:11:50.87,Main,Hody,0,0,0,,Şimdiyse planımızın bir\Naşamasına başlama vakti geldi.
Dialogue: 0,0:11:54.95,0:11:58.47,Main,Hody,0,0,0,,Ryugu Sarayı'na girmenin\Nimkânsız olduğunu söylerler.
Dialogue: 0,0:12:00.92,0:12:06.12,Main,Hody,0,0,0,,Ama bir adam on yıl boyunca\Noraya bir şeyler atabildi.
Dialogue: 0,0:12:06.22,0:12:08.57,Main,Hody,0,0,0,,Adı Vander Decken.
Dialogue: 0,0:12:12.28,0:12:18.56,Main,Hody,0,0,0,,Yani bu plan, sizin Decken\Ntarafından atılacak nesneler olmanızı...
Dialogue: 0,0:12:20.37,0:12:23.28,Main,Hody,0,0,0,,...ve doğruca Ryugu Sarayı'ndaki\NDeniz Kızı Prensesi'ne uçmanızı kapsıyor.
Dialogue: 0,0:12:24.25,0:12:29.27,Main,Hody,0,0,0,,Ama aslında kulenin sert duvarlarına çarpacaksınız.
Dialogue: 0,0:12:31.98,0:12:36.08,Main,Hody,0,0,0,,Ryugu Sarayı'na vardığınızda,\Nkapıları içeriden açacaksınız...
Dialogue: 0,0:12:36.08,0:12:39.99,Main,Hody,0,0,0,,...ve girmemizi sağlayacaksınız. Göreviniz bu.
Dialogue: 0,0:12:40.68,0:12:43.22,Main,Pirate,0,0,0,,Olamaz! Bunu yaparsan,...
Dialogue: 0,0:12:43.22,0:12:46.07,Main,Pirate,0,0,0,,Duvarlara çarpıp öleceğiz!
Dialogue: 0,0:12:46.71,0:12:47.72,Main,Hody,0,0,0,,Kesinlikle öyle.
Dialogue: 0,0:12:48.30,0:12:52.31,Main,Hody,0,0,0,,Bu yüzden siz değersiz\Ninsanların canlarını kullanıyoruz!
Dialogue: 0,0:12:53.48,0:12:57.17,Main,Hody,0,0,0,,Burada, değeriniz kölelerinkinden bile az!
Dialogue: 0,0:12:57.17,0:13:00.79,Main,Hody,0,0,0,,Çarpmadan sağ kurtulanlar,\Ngörevi yerine getirecek!
Dialogue: 0,0:13:01.30,0:13:04.16,Main,Hody,0,0,0,,İşler yolunda giderse, sizi özgür bırakacağım.
Dialogue: 0,0:13:04.16,0:13:05.99,Main,Hody,0,0,0,,Görevi kabul etmezseniz, o zaman...
Dialogue: 0,0:13:05.99,0:13:11.05,Main,Hody,0,0,0,,...sizi hemen kabarcığın dışına\Natacağım, aşağılık türler!
Dialogue: 0,0:13:11.05,0:13:15.84,Main,Pirate,0,0,0,,O-Olamaz! Bunu yaparsan, boğuluruz!
Dialogue: 0,0:13:15.84,0:13:21.60,Main,Decken,0,0,0,,O zaman, şansınızı küçük de olsa hayatta kalma\Nihtimali olan seçenekten yana kullanmalısınız!
Dialogue: 0,0:13:22.32,0:13:23.66,Main,Decken,0,0,0,,Git!
Dialogue: 0,0:13:30.43,0:13:31.94,Main,Hody,0,0,0,,Bugün,...
Dialogue: 0,0:13:31.94,0:13:35.86,Main,Hody,0,0,0,,...biz balık adamların tarihindeki\Nyeni bir bölümün başlangıcı!
Dialogue: 0,0:13:37.75,0:13:41.20,Main,Hody,0,0,0,,Ryugu Krallığı'nı fethettiğimizde başlıyor!
Dialogue: 0,0:13:41.20,0:13:43.02,Main,Fishmen,0,0,0,,Evet!
Dialogue: 0,0:13:45.00,0:13:47.88,Main,Decken,0,0,0,,Şimdi geliyorum, Shirahoshi!
Dialogue: 0,0:13:52.87,0:13:57.17,Captions,,0,0,0,,{\fad(200,500)}Ryugu Sarayı'nın Kuzeybatı Tarafı - Koukaku Kulesi'ne Bağlanan Koridor
Dialogue: 0,0:13:53.89,0:13:56.53,Narrator,Narrator,0,0,0,,Şimdiki zamana dönüyoruz.
Dialogue: 0,0:13:57.61,0:13:59.02,Main,Pirate,0,0,0,,Dur!
Dialogue: 0,0:13:59.02,0:14:00.10,Main,Brook,0,0,0,,Durmayacağım!
Dialogue: 0,0:14:00.10,0:14:03.00,Main,Right Minister,0,0,0,,Çabuk, İskelet! Krala!
Dialogue: 0,0:14:04.25,0:14:06.74,Main,Pirate,0,0,0,,Dur! Yolu açmak zorundayız.
Dialogue: 0,0:14:06.74,0:14:10.39,Main,Pirate,0,0,0,,Yoksa Hody bizi öldürecek!
Dialogue: 0,0:14:10.39,0:14:11.59,Main,Chopper,0,0,0,,Hey, Sanji!
Dialogue: 0,0:14:13.60,0:14:16.01,Main,Chopper,0,0,0,,Bütün askerleri...
Dialogue: 0,0:14:16.01,0:14:18.31,Main,Chopper,0,0,0,,...dövdü.
Dialogue: 0,0:14:18.31,0:14:20.94,Main,Chopper,0,0,0,,Biz yanlış bir şey yapmadık!
Dialogue: 0,0:14:22.29,0:14:25.64,Main,Sanji,0,0,0,,Bana kelepçe takmak istediler!
Dialogue: 0,0:14:25.67,0:14:29.24,Main,Chopper,0,0,0,,Bak! Herkes bize soğuk davranıyor!
Dialogue: 0,0:14:29.24,0:14:31.28,Main,Chopper,0,0,0,,Gözleri aynı derin deniz balığı gibi!
Dialogue: 0,0:14:31.28,0:14:35.45,Main,Sanji,0,0,0,,Ah, sızlanmayı bırak. Artık çok geç.
Dialogue: 0,0:14:35.45,0:14:37.72,Main,Chopper,0,0,0,,Onları dövmeden önce bunu düşünmeliydin!
Dialogue: 0,0:14:37.72,0:14:41.04,Main,Sanji,0,0,0,,Sen de onların yarısını hallettin! Kung Fu'yla!
Dialogue: 0,0:14:41.04,0:14:43.44,Main,Sanji,0,0,0,,Epey güçlüydün.
Dialogue: 0,0:14:43.44,0:14:47.57,Main,Chopper,0,0,0,,Ö-Öyle desen bile hiç mutlu değilim, pislik!
Dialogue: 0,0:14:49.50,0:14:51.45,Main,Sanji,0,0,0,,Bir kadın sesi!
Dialogue: 0,0:14:51.45,0:14:54.04,Main,Persons,0,0,0,,Kanlar içinde biri kıyıya vurmuş!
Dialogue: 0,0:14:54.04,0:14:56.97,Main,Persons,0,0,0,,Sen Balık Adam Bölgesi'nden değil misin?!
Dialogue: 0,0:14:56.97,0:14:57.83,Main,Persons,0,0,0,,Ne oldu?!
Dialogue: 0,0:14:57.83,0:14:59.76,Main,Persons,0,0,0,,Biri doktor bulsun!
Dialogue: 0,0:15:00.69,0:15:02.50,Main,Chopper,0,0,0,,Ben doktorum!
Dialogue: 0,0:15:05.21,0:15:05.97,Main,Sanji,0,0,0,,Hachi?!
Dialogue: 0,0:15:06.67,0:15:08.29,Main,Sanji,0,0,0,,Sana ne oldu?!
Dialogue: 0,0:15:10.53,0:15:12.78,Main,Chopper,0,0,0,,Hey, Hachi, biziz!
Dialogue: 0,0:15:12.78,0:15:15.15,Main,Chopper,0,0,0,,Bu yaralar nasıl oldu?!
Dialogue: 0,0:15:15.15,0:15:16.49,Main,Chopper,0,0,0,,Ne oldu?!
Dialogue: 0,0:15:17.94,0:15:19.33,Main,Hachi,0,0,0,,Siz misiniz?
Dialogue: 0,0:15:20.21,0:15:22.92,Main,Hachi,0,0,0,,Sizi bulduğuma sevindim. Hasır Şapka burada mı?
Dialogue: 0,0:15:22.92,0:15:27.96,Main,Chopper,0,0,0,,Burada değil. Dur, sana yardım edeceğim.
Dialogue: 0,0:15:27.96,0:15:32.84,Main,Hachi,0,0,0,,Tayfanızı toplayın. Çabuk!
Dialogue: 0,0:15:33.24,0:15:34.41,Main,Hachi,0,0,0,,Bu adanın...
Dialogue: 0,0:15:34.41,0:15:39.10,Main,Hachi,0,0,0,,...işlerine daha fazla karışmazsanız, \Niyi edersiniz.
Dialogue: 0,0:15:39.10,0:15:41.22,Main,Hachi,0,0,0,,Balık Adam Adası'nı terkedin.
Dialogue: 0,0:15:41.22,0:15:47.26,Main,Hachi,0,0,0,,Yeni Balık Adam Korsanları bu adaya saldıracak!
Dialogue: 0,0:15:47.73,0:15:51.76,Main,Hachi,0,0,0,,Ryugu Krallığı yok olacak!
Dialogue: 0,0:15:54.45,0:15:56.28,Main,Right Minister,0,0,0,,Neptune-sama!
Dialogue: 0,0:15:56.28,0:16:01.71,Main,Right Minister,0,0,0,,Kaçırılmış! Prenses biri ya da\Nbirileri tarafından götürülmüş!
Dialogue: 0,0:16:01.71,0:16:05.06,Main,Brook,0,0,0,,Ayrıca, bir grup korsan yağmur gibi kuleye yağdı.
Dialogue: 0,0:16:05.06,0:16:09.58,Main,Brook,0,0,0,,Neyse, saldırı altındayız! Saldırı altında!
Dialogue: 0,0:16:09.59,0:16:15.83,Main,Neptune,0,0,0,,Kaçırılmış mı?! \NShirahoshi'yi kim götürmüş olabilir?!
Dialogue: 0,0:16:17.68,0:16:20.23,Main,Zoro,0,0,0,,Bu kez de düşman saldırısı mı?
Dialogue: 0,0:16:20.23,0:16:21.79,Main,Zoro,0,0,0,,Ne yapacağız?
Dialogue: 0,0:16:21.79,0:16:26.68,Main,Usopp,0,0,0,,Neden şimdi?! Zaten saraya kendimiz saldırıyorduk!
Dialogue: 0,0:16:26.68,0:16:28.02,Main,Usopp,0,0,0,,N-Ne yapacağız?!
Dialogue: 0,0:16:29.17,0:16:31.99,Main,Usopp,0,0,0,,Düşündüm de, buna cevap verme!
Dialogue: 0,0:16:31.99,0:16:32.69,Main,Zoro,0,0,0,,Hepsini keseceğiz.
Dialogue: 0,0:16:32.69,0:16:34.99,Main,Usopp,0,0,0,,Cevap verme dedim!
Dialogue: 0,0:16:36.58,0:16:38.56,Main,Pirate,0,0,0,,Hayatta kalacaksak,...
Dialogue: 0,0:16:39.37,0:16:42.08,Main,Pirate,0,0,0,,...sarayın kapısını açmalıyız!
Dialogue: 0,0:16:42.08,0:16:43.96,Main,Usopp,0,0,0,,G-Geliyorlar!
Dialogue: 0,0:16:45.74,0:16:48.18,Main,Luffy,0,0,0,,Artık köpek balığının içinden çıkmayacak mısın?
Dialogue: 0,0:16:48.18,0:16:51.75,Main,Shirahoshi,0,0,0,,H-Hayır, içeride kalmayı tercih ederim.
Dialogue: 0,0:16:53.37,0:16:56.69,Main,Luffy,0,0,0,,On yıldır ilk defa dışarıda olmak nasıl bir duygu?
Dialogue: 0,0:16:56.69,0:16:58.47,Main,Shirahoshi,0,0,0,,Kalbim çok hızlı çarpıyor.
Dialogue: 0,0:16:58.47,0:17:00.38,Main,Shirahoshi,0,0,0,,Çok kötü bir şey yaptım.
Dialogue: 0,0:17:00.96,0:17:04.21,Main,Luffy,0,0,0,,Sadece dışarı çıkmak kötü bir şey değil!
Dialogue: 0,0:17:04.63,0:17:07.24,Main,Luffy,0,0,0,,Çok tuhafsın.
Dialogue: 0,0:17:09.01,0:17:10.51,Main,Shirahoshi,0,0,0,,Bu...
Dialogue: 0,0:17:16.31,0:17:18.85,Main,Shirahoshi,0,0,0,,..."macera" dedikleri şey mi?
Dialogue: 0,0:17:21.29,0:17:23.46,Main,Luffy,0,0,0,,Tabii tabii.
Dialogue: 0,0:17:23.81,0:17:27.37,Main,Luffy,0,0,0,,Bu kadar heyecanlandıysan, macera olsun bakalım!
Dialogue: 0,0:17:27.37,0:17:30.46,Main,Luffy,0,0,0,,Deniz Ormanı'yla ilgili bir şey demiştin, değil mi?
Dialogue: 0,0:17:30.46,0:17:33.07,Main,Luffy,0,0,0,,Nedir o? Eğlenceli bir yer mi?
Dialogue: 0,0:17:33.26,0:17:34.20,Main,Shirahoshi,0,0,0,,Bir mezar.
Dialogue: 0,0:17:35.52,0:17:40.11,Main,Shirahoshi,0,0,0,,Orada, yapıldığından beri hiç\Nziyaret etmediğim bir mezar var.
Dialogue: 0,0:17:41.43,0:17:44.64,Main,Shirahoshi,0,0,0,,On yıldır bir kez bile gitmedim.
Dialogue: 0,0:17:44.64,0:17:47.56,Main,Shirahoshi,0,0,0,,Gitmeyi en çok istediğim tek yer!
Dialogue: 0,0:17:49.80,0:17:54.30,Captions,,0,0,0,,{\fad(500,500)}Derin Deniz, Deniz Ormanı
Dialogue: 0,0:17:54.26,0:17:56.73,Main,Jinbe,0,0,0,,Gerçekten on yıl oldu mu?
Dialogue: 0,0:17:56.73,0:18:02.28,Main,Jinbe,0,0,0,,Balık Adam Adası'nı kaosa sürükleyen suikastin\Ngüpegündüz gerçekleşmesinden bu yana?
Dialogue: 0,0:18:02.79,0:18:05.04,Main,Jinbe,0,0,0,,Zaman nasıl da geçiyor.
Dialogue: 0,0:18:05.92,0:18:11.05,Main,Jinbe,0,0,0,,Prensler iyi savaşçılar oldular...
Dialogue: 0,0:18:11.98,0:18:15.52,Main,Jinbe,0,0,0,,...ve Prenses Shirahoshi hâlâ o kulede.
Dialogue: 0,0:18:16.55,0:18:22.06,Main,Jinbe,0,0,0,,Ama kimse ideallerini unutmadı,...
Dialogue: 0,0:18:22.95,0:18:25.60,Main,Jinbe,0,0,0,,...Kraliçe Otohime.
