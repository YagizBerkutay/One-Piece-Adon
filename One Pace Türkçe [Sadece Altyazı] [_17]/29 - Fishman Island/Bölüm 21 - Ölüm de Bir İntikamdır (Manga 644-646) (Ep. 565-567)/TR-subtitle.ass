Dialogue: 0,0:02:42.14,0:02:44.56,Main,Brook,0,0,0,,Ha? Ne?
Dialogue: 0,0:02:45.22,0:02:47.39,Main,Brook,0,0,0,,Gözden kaybettim.
Dialogue: 0,0:02:47.99,0:02:50.31,Main,Brook,0,0,0,,Şu çizgili giysisi olanı.
Dialogue: 0,0:02:52.34,0:02:54.80,Thoughts,Zeo,0,0,0,,Budala! Buradayım!
Dialogue: 0,0:02:55.90,0:02:58.54,Thoughts,Zeo,0,0,0,,Fark etmeden gebermiş olacaksın!
Dialogue: 0,0:02:59.12,0:02:59.94,Thoughts,Zeo,0,0,0,,Al bunu!
Dialogue: 0,0:03:04.32,0:03:07.03,Main,Brook,0,0,0,,Buradan bir ses geldi!
Dialogue: 0,0:03:11.40,0:03:13.21,Main,Pirate,0,0,0,,Z-Zeo-san'ı...
Dialogue: 0,0:03:13.21,0:03:14.89,Main,Pirate,0,0,0,,...deşti!
Dialogue: 0,0:03:18.57,0:03:20.48,Main,Zeo,0,0,0,,Nasılmış iskelet?
Dialogue: 0,0:03:21.81,0:03:26.29,Main,Zeo,0,0,0,,Silah yok etme tekniğim olan\NBedensel Kılıç Ezişi ile...
Dialogue: 0,0:03:26.29,0:03:28.53,Main,Zeo,0,0,0,,...kılıcının ucu...
Dialogue: 0,0:03:28.53,0:03:30.25,Main,Zeo,0,0,0,,...harap old{\fscx250}-{\r}
Dialogue: 0,0:03:30.25,0:03:31.28,Main,Brook,0,0,0,,Deştim seni.
Dialogue: 0,0:03:31.28,0:03:33.08,Main,Pirate,0,0,0,,Ne kadar da gururuna düşkün!
Dialogue: 0,0:03:33.08,0:03:36.06,Main,Zeo,0,0,0,,Sırf bunu düşünerek bile yenece{\fscx250}-{\r}
Dialogue: 0,0:03:36.06,0:03:37.82,Main,Zeo,0,0,0,,...yenilirsin.
Dialogue: 0,0:03:38.34,0:03:39.88,Main,Zeo,0,0,0,,Seni beyinsiz!
Dialogue: 0,0:03:42.23,0:03:43.92,Main,Brook,0,0,0,,Ha?! Nasıl?!
Dialogue: 0,0:03:43.92,0:03:46.37,Main,Brook,0,0,0,,Yine gözden kaybettim!\NNereye kayboldu acaba?
Dialogue: 0,0:03:56.23,0:03:58.02,Attack,TL Note,0,0,0,,{\fad(100,900)}Gizli Döven...
Dialogue: 0,0:04:01.11,0:04:02.95,Attack,TL Note,0,0,0,,{\fad(100,900)}...66 Gerdan
Dialogue: 0,0:04:21.87,0:04:25.40,Thoughts,Brook,0,0,0,,Geçtiğimiz 2 yılda...
Dialogue: 0,0:04:26.65,0:04:32.23,Thoughts,Brook,0,0,0,,...Diril Diril Meyvesi'nin gerçek gücünün\Nne olduğunu öğrendim.
Dialogue: 0,0:04:40.24,0:04:46.26,Thoughts,Brook,0,0,0,,İnsanlar öldükleri vakit ruhları\Nmutlak surette öteki dünyaya göçer.
Dialogue: 0,0:04:47.50,0:04:53.61,Thoughts,Brook,0,0,0,,Lakin ruhum bu dünyada kalabilmek için...
Dialogue: 0,0:04:53.61,0:04:59.05,Thoughts,Brook,0,0,0,,...sanki cismani bir şeymiş gibi\Netrafına enerji saçıyor.
Dialogue: 0,0:05:00.63,0:05:06.46,Thoughts,Brook,0,0,0,,Bu sayede bir şeyler çaldığımda kimsenin yapamayacağı \Nşekilde büyük bir kalabalığı coşturabiliyorum.
Dialogue: 0,0:05:06.46,0:05:12.09,Thoughts,Brook,0,0,0,,Onları kendi dünyama çekip yanılsamalara\Nkapılmalarını sağlayabiliyorum.
Dialogue: 0,0:05:13.89,0:05:18.63,Thoughts,Brook,0,0,0,,Hatta ruhum bedenimden ayrıldığında\Nrahatlıkla görülebiliyor.
Dialogue: 0,0:05:18.63,0:05:22.34,Thoughts,Brook,0,0,0,,Gerçekten de bu dünyanın bir parçasıyım.
Dialogue: 0,0:05:29.90,0:05:31.46,Main,Zeo,0,0,0,,Başardım!
Dialogue: 0,0:05:32.26,0:05:36.63,Main,Zeo,0,0,0,,Hasır Şapkalar'dan birini alt ettim!
Dialogue: 0,0:05:36.63,0:05:37.51,Main,Brook,0,0,0,,Edemedin!
Dialogue: 0,0:05:41.99,0:05:46.80,Main,Brook,0,0,0,,Beni bu dünyaya bağlayan\Nşey ne organlarım...
Dialogue: 0,0:05:46.80,0:05:48.86,Main,Brook,0,0,0,,...ne de kaslarım.
Dialogue: 0,0:05:49.52,0:05:50.66,Main,Brook,0,0,0,,Bunu yapan...
Dialogue: 0,0:05:52.64,0:05:54.88,Main,Brook,0,0,0,,...ruhum!
Dialogue: 0,0:05:58.30,0:06:00.53,Main,Pirate,0,0,0,,Neeee?!
Dialogue: 0,0:06:04.12,0:06:06.47,Main,Zeo,0,0,0,,Acayip gaza geldim!
Dialogue: 0,0:06:06.47,0:06:07.87,Main,Zeo,0,0,0,,İşte böyle!
Dialogue: 0,0:06:08.38,0:06:10.66,Main,Pirate,0,0,0,,Şaşırmamış gibi yapıyor!
Dialogue: 0,0:06:12.21,0:06:14.41,Main,Brook,0,0,0,,Şimdi anladın mı?
Dialogue: 0,0:06:15.14,0:06:19.48,Main,Brook,0,0,0,,Diğer bir deyişle kemiklerim\Nzarar görmediği müddetçe...
Dialogue: 0,0:06:19.48,0:06:22.97,Main,Brook,0,0,0,,...canımı kemiklerimden sıyıramazsın.
Dialogue: 0,0:06:27.23,0:06:28.70,Main,Brook,0,0,0,,Ayrıca...
Dialogue: 0,0:06:29.40,0:06:35.13,Main,Brook,0,0,0,,...Uzun Kol Kabilesi'ndekiler benim için\Nbu Shikomizue'yu bilediler.
Dialogue: 0,0:06:29.40,0:06:35.13,Note,TL Note,0,0,0,,{\fad(100,100)}Shikomizue: Baston Kılıç {...Yeah, apparently this is actually a thing. Wikipedia refers to it by the Japanese name and everything.}
Dialogue: 0,0:06:35.69,0:06:39.74,Main,Brook,0,0,0,,Bunun adı Yekpare Ruh!
Dialogue: 0,0:06:45.77,0:06:52.01,Main,Brook,0,0,0,,Bu ruhani kesiş sana ölüler diyarının\Ndondurucu soğuğunu hissettirecek.
Dialogue: 0,0:06:55.27,0:06:57.12,Main,Brook,0,0,0,,Buna...
Dialogue: 0,0:06:58.15,0:07:00.50,Main,Brook,0,0,0,,...Dondurucu Kılıç deniyor.
Dialogue: 0,0:07:01.55,0:07:04.39,Main,Usopp,0,0,0,,Müthişsin ya Brook!
Dialogue: 0,0:07:09.39,0:07:11.15,Main,Usopp,0,0,0,,Benim de işime bakmam lazım!
Dialogue: 0,0:07:11.88,0:07:16.37,Main,Usopp,0,0,0,,Herkes Yeni Dünya'da dayanmak için\Nyeni kabiliyetler geliştirmiş!
Dialogue: 0,0:07:18.24,0:07:20.92,Main,Daruma,0,0,0,,Arkadaşların için mi tasalanıyorsun?
Dialogue: 0,0:07:21.51,0:07:26.14,Main,Daruma,0,0,0,,Endişelenme! Denizin dibinde boğulmanızı\Ngaranti edeceğim!
Dialogue: 0,0:07:27.67,0:07:29.74,Attack,TL Note,0,0,0,,{\fad(100,100)}Ateş Topu Keskisi
Dialogue: 0,0:07:34.77,0:07:35.73,Main,Usopp,0,0,0,,Yandım! Yandım!
Dialogue: 0,0:07:46.31,0:07:47.56,Main,Usopp,0,0,0,,Şerefsiz herif!
Dialogue: 0,0:07:50.57,0:07:54.24,Main,Daruma,0,0,0,,Anlaşılan Hasır Şapkalar'a yük oluyorsun!
Dialogue: 0,0:07:55.53,0:07:58.69,Main,Daruma,0,0,0,,Beni bir kere bile vuramadın!
Dialogue: 0,0:07:58.69,0:08:00.74,Main,Usopp,0,0,0,,Hemen sonuç çıkartma kör sıçan köpekbalığı.
Dialogue: 0,0:08:00.74,0:08:03.02,Main,Daruma,0,0,0,,Ben kurabiye dişli köpekbalığıyım.
Dialogue: 0,0:08:03.02,0:08:04.60,Main,Usopp,0,0,0,,Az önce...
Dialogue: 0,0:08:05.41,0:08:08.13,Main,Usopp,0,0,0,,...tuzağı kurma faslını tamamladım!
Dialogue: 0,0:08:08.13,0:08:10.23,Main,Luffy,0,0,0,,Tek seferde bu işi bitireceğim!
Dialogue: 0,0:08:10.23,0:08:12.17,Main,Hody,0,0,0,,Hiçbir şeyi bitiremezsin!
Dialogue: 0,0:08:12.83,0:08:14.48,Main,Hody,0,0,0,,Geber!
Dialogue: 0,0:08:19.04,0:08:20.18,Note,TL Note,0,0,0,,{\fad(100,100)}Silahlanma
Dialogue: 0,0:08:30.65,0:08:33.26,Main,Hody,0,0,0,,O kolunu kopartacağım!
Dialogue: 0,0:09:09.55,0:09:10.65,Main,Shirahoshi,0,0,0,,Luffy-sama!
Dialogue: 0,0:09:15.20,0:09:18.00,Main,Luffy,0,0,0,,Zayıf-hoshi! Beni Noah'ya götür!
Dialogue: 0,0:09:18.00,0:09:19.25,Main,Shirahoshi,0,0,0,,Peki!
Dialogue: 0,0:09:21.12,0:09:22.41,Main,Luffy,0,0,0,,Son sürat!
Dialogue: 0,0:09:22.41,0:09:23.36,Main,Shirahoshi,0,0,0,,Peki!
Dialogue: 0,0:09:25.20,0:09:26.41,Main,Citizen who has the right idea,0,0,0,,Ne oldu?
Dialogue: 0,0:09:26.41,0:09:28.69,Main,Citizen who is an idiot,0,0,0,,Kaçmayacağım ben!
Dialogue: 0,0:09:28.69,0:09:31.04,Main,Citizen who has the right idea,0,0,0,,Aptallık etmesene, Noah'yı görmüyor musun?!
Dialogue: 0,0:09:31.04,0:09:34.38,Main,Citizen who is an idiot,0,0,0,,Görüyorum, görüyorum elbette ama...
Dialogue: 0,0:09:34.38,0:09:39.27,Main,Citizen who is an idiot,0,0,0,,...Hasır Şapkalar'ın yaptıklarını görünce\Nbazı şeyleri de hatırlamaya başlıyorum.
Dialogue: 0,0:09:39.27,0:09:42.69,Main,Citizen who is an idiot,0,0,0,,20 yıl evvel çocukken\Nyaşadıklarım aklıma geliyor!
Dialogue: 0,0:09:44.89,0:09:50.99,Main,Citizen who is an idiot,0,0,0,,Bu krallığın insanlarının gönülden minnetini kazanmış o yegâne kişi canlanıyor gözümün önünde!
Dialogue: 0,0:09:59.44,0:10:00.92,Flashbacks,Pirate,0,0,0,,Ganimete bak anasını!
Dialogue: 0,0:10:01.93,0:10:02.44,Flashbacks,Pirate,0,0,0,,Bekle bakalım!
Dialogue: 0,0:10:02.44,0:10:03.60,Flashbacks,Mermaid,0,0,0,,Yapmayın!
Dialogue: 0,0:10:06.97,0:10:09.39,Flashbacks,Pirate,0,0,0,,Kimsin lan sen, canına mı susadın?!
Dialogue: 0,0:10:10.83,0:10:12.15,Flashbacks,Pirate,0,0,0,,Ha?!
Dialogue: 0,0:10:12.15,0:10:13.62,Flashbacks,Pirate,0,0,0,,Lan, şaka değil mi bu!?
Dialogue: 0,0:10:13.62,0:10:14.82,Flashbacks,Pirate,0,0,0,,Bu herif niye burada?!
Dialogue: 0,0:10:16.52,0:10:18.95,Flashbacks,Pirate,0,0,0,,Ve niye balık adamlardan yana?!
Dialogue: 0,0:10:21.04,0:10:24.64,Flashbacks,Whitebeard,0,0,0,,Gençken Neptune'ün bana\Nbüyük yardımı dokunmuştu...
Dialogue: 0,0:10:24.64,0:10:27.28,Flashbacks,Whitebeard,0,0,0,,...dostluk yeminleri babında\Nsakelerimizi paylaştık onunla!
Dialogue: 0,0:10:29.16,0:10:31.18,Flashbacks,Pirate,0,0,0,,Bağışla bizi,...
Dialogue: 0,0:10:31.18,0:10:35.00,Flashbacks,Pirate,0,0,0,,...bir daha ne balık adamlara\Nne de deniz kızlarına el sürmeyiz!
Dialogue: 0,0:10:35.59,0:10:40.40,Flashbacks,Whitebeard,0,0,0,,Dostumun ülkesine bulaşayım demeyin!
Dialogue: 0,0:10:40.40,0:10:43.23,Flashbacks,Whitebeard,0,0,0,,Sizi sümüklü veletler!
Dialogue: 0,0:10:49.43,0:10:51.90,Flashbacks,Whitebeard,0,0,0,,Bu ada bundan böyle...
Dialogue: 0,0:10:51.90,0:10:54.69,Flashbacks,Whitebeard,0,0,0,,...benim korumam altında!
Dialogue: 0,0:10:58.99,0:11:00.84,Main,Citizen who has the right idea,0,0,0,,Beyazsakal'dan mı bahsediyorsun?!
Dialogue: 0,0:11:00.86,0:11:05.45,Main,Citizen who has the right idea,0,0,0,,Aynı o ulu Korsan'a güvendiğin gibi\Nbunlara da güvendiğini mi ima ediyorsun?!
Dialogue: 0,0:11:05.45,0:11:10.01,Main,Citizen who is an idiot,0,0,0,,Bilirsin, insanlardan günahım kadar hoşlanmamama rağmen...
Dialogue: 0,0:11:10.01,0:11:13.39,Main,Citizen who is an idiot,0,0,0,,...şu anda Balık Adam Krallığı'nda\Nolmamıza rağmen onlar...
Dialogue: 0,0:11:14.27,0:11:18.46,Flashbacks,Luffy,0,0,0,,Şehir meydanına vardığımızda\NJinbe'yle birlikte...
Dialogue: 0,0:11:18.46,0:11:22.40,Flashbacks,Luffy,0,0,0,,...kimselere adaya el\Nsürdürmeyeceğimize dair yeminler içmiştik.
Dialogue: 0,0:11:22.40,0:11:24.34,Flashbacks,Luffy,0,0,0,,O yüzden her şeyi bize bırak, Abi-hoshi!
Dialogue: 0,0:11:25.11,0:11:26.87,Flashbacks,Luffy,0,0,0,,Arkadaşız sonuçta!
Dialogue: 0,0:11:28.12,0:11:31.72,Main,Citizen who's an idiot,0,0,0,,Öyle bir şey söyleyip, hayatı pahasına...
Dialogue: 0,0:11:54.90,0:11:56.55,Main,Luffy,0,0,0,,Sonunda hava!
Dialogue: 0,0:12:24.55,0:12:27.05,Main,Luffy,0,0,0,,Dayanıklılığı elit ödülleri olanlar kadar var.
Dialogue: 0,0:12:27.23,0:12:29.95,Main,Hody,0,0,0,,Dişlerim sadece gösteriş için değil!
Dialogue: 0,0:12:37.48,0:12:41.96,Main,Hody,0,0,0,,Siz insanların bu kadar güçsüz olduğunuz\Nhalde ne kadar küstah...
Dialogue: 0,0:12:42.84,0:12:47.40,Main,Hody,0,0,0,,...olduğunuzu anlamanız için\Nölmeniz gerekiyor sanırım!
Dialogue: 0,0:12:47.87,0:12:51.77,Main,Hody,0,0,0,,Madem öyle,\Nbunu anlamanı sağlayacağım!
Dialogue: 0,0:12:56.62,0:12:58.38,Main,Luffy,0,0,0,,Vaktim kısıtlı!
Dialogue: 0,0:12:58.38,0:13:00.44,Main,Luffy,0,0,0,,Haydi bitirelim şu işi!
Dialogue: 0,0:13:00.44,0:13:04.19,Main,Hody,0,0,0,,Bitir de görelim!
Dialogue: 0,0:13:06.87,0:13:09.03,Main,Luffy,0,0,0,,Zayıf-hoshi, uzak dur!
Dialogue: 0,0:13:09.03,0:13:10.58,Main,Shirahoshi,0,0,0,,Peki!
Dialogue: 0,0:13:10.75,0:13:12.97,Attack,TL Note,0,0,0,,{\fad(100,100)}Balık Adam Karatesi
Dialogue: 0,0:13:13.09,0:13:14.61,Attack,TL Note,0,0,0,,{\fad(100,100)}Su Kalbi
Dialogue: 0,0:13:16.08,0:13:18.48,Attack,TL Note,0,0,0,,{\fad(100,100)}Köpekbalığı Sürüsü
Dialogue: 0,0:13:28.17,0:13:29.97,Main,Hody,0,0,0,,Kaçamazsın!
Dialogue: 0,0:13:30.97,0:13:33.96,Main,Hody,0,0,0,,Geber!
Dialogue: 0,0:13:45.44,0:13:49.15,Main,Hody,0,0,0,,Pes et ve öl artık!
Dialogue: 0,0:14:15.71,0:14:19.27,Main,Hody,0,0,0,,Düşmeye devam et, Noah!
Dialogue: 0,0:14:20.71,0:14:25.30,Main,Hody,0,0,0,,Gururunu yitirmiş balık adamların...
Dialogue: 0,0:14:25.30,0:14:27.98,Main,Hody,0,0,0,,...hepsini öldür!
Dialogue: 0,0:15:00.20,0:15:01.55,Main,Guard,0,0,0,,Baş...
Dialogue: 0,0:15:01.55,0:15:04.02,Main,Guard,0,0,0,,Başardı!
Dialogue: 0,0:15:04.61,0:15:06.96,Main,Guard,0,0,0,,Bu sefer kesin olarak Hody'yi...
Dialogue: 0,0:15:07.73,0:15:10.67,Main,Guard,0,0,0,,...hakladı!
Dialogue: 0,0:15:13.68,0:15:17.98,Main,Pirate,0,0,0,,Bittik! Ada da bitti, biz de bittik!
Dialogue: 0,0:15:17.98,0:15:19.89,Main,Pirate,0,0,0,,Kaçın!
Dialogue: 0,0:15:31.60,0:15:34.36,Main,Pirate,0,0,0,,Zeo-san, yalvarırım!
Dialogue: 0,0:15:34.36,0:15:35.76,Main,Pirate,0,0,0,,Bu gidişle ada...
Dialogue: 0,0:15:38.18,0:15:39.87,Main,Zeo,0,0,0,,Aptallaşmayın!
Dialogue: 0,0:15:40.42,0:15:44.83,Main,Zeo,0,0,0,,Kaptan Hody, cennet tarafından seçildi!
Dialogue: 0,0:15:44.83,0:15:47.84,Main,Zeo,0,0,0,,Beş para etmez bir insan\Nonu asla yenemez!
Dialogue: 0,0:15:49.46,0:15:53.32,Main,Pirate,0,0,0,,İyi de Noah adayı yok ederse\Nhavamızı alırız!
Dialogue: 0,0:15:55.08,0:15:57.61,Main,Zeo,0,0,0,,Ölüm de bir intikamdır.
Dialogue: 0,0:15:58.27,0:16:01.14,Main,Zeo,0,0,0,,Ölürken bile insanlardan nefret edin!
Dialogue: 0,0:16:01.14,0:16:04.30,Main,Zeo,0,0,0,,Facialar etimiz ve kemiğimiz olacak.
Dialogue: 0,0:16:04.30,0:16:06.66,Main,Zeo,0,0,0,,Kinimiz asla dinmeyecek.
Dialogue: 0,0:16:06.66,0:16:11.68,Main,Zeo,0,0,0,,Birileri bunu miras alıp\Nintikamımızı alacak!
Dialogue: 0,0:16:14.77,0:16:16.68,Main,Brook,0,0,0,,İşte orada.
Dialogue: 0,0:16:16.68,0:16:20.98,Main,Pirate,0,0,0,,Kaptan Hody de rütbelileri de\Nakıllarını kaçırmış.
Dialogue: 0,0:16:24.76,0:16:28.68,Main,Dosun,0,0,0,,İnsanlar yüzünden kaçırdık!
Dialogue: 0,0:16:28.68,0:16:30.35,Main,Dosun,0,0,0,,Kaçmayın!
Dialogue: 0,0:16:33.21,0:16:37.51,Main,Dosun,0,0,0,,Nefretinizi insanlara yöneltin-bogon!
Dialogue: 0,0:16:38.06,0:16:45.85,Main,Dosun,0,0,0,,Balık adamların başına açılan tüm belaların\Nsorumlusu insanlardır-zugan!
Dialogue: 0,0:16:47.87,0:16:51.25,Main,Citizen,0,0,0,,İnsanlar o kadar korkunç mu da?
Dialogue: 0,0:16:52.64,0:16:54.22,Main,Citizen,0,0,0,,Saçmalama!
Dialogue: 0,0:16:54.22,0:16:59.66,Main,Citizen,0,0,0,,Tamam yani tarihe bakınca insanlar\Nbalık adamlara korkunç şeyler yapmış da...
Dialogue: 0,0:16:59.66,0:17:00.69,Main,Shyarly,0,0,0,,Kes şunu!
Dialogue: 0,0:17:02.60,0:17:04.33,Main,Citizen,0,0,0,,Madam Sharley!
Dialogue: 0,0:17:04.33,0:17:06.60,Main,Shyarly,0,0,0,,Kendi gözlerinle gör!
Dialogue: 0,0:17:08.77,0:17:13.14,Main,Shyarly,0,0,0,,Meydanda ve yukarıda insanlar,...
Dialogue: 0,0:17:13.14,0:17:17.29,Main,Shyarly,0,0,0,,...Balık Adam Bölgesi'nden\Ngelen korsanlara karşı savaşıyor!
Dialogue: 0,0:17:23.87,0:17:27.21,Main,Citizen,0,0,0,,O da mı insan?
Dialogue: 0,0:17:27.21,0:17:29.34,Main,Shyarly,0,0,0,,Bazıları tuhaf tipler ama...
Dialogue: 0,0:17:30.23,0:17:32.17,Main,Shyarly,0,0,0,,...bunu kendi gözlerinle görmelisin!
Dialogue: 0,0:17:33.05,0:17:37.28,Main,Shyarly,0,0,0,,Aksi halde söz söylemeye hakkın\Nyok demektir!
Dialogue: 0,0:17:39.30,0:17:41.87,Main,Shyarly,0,0,0,,Ne olursa olsun...
Dialogue: 0,0:17:41.87,0:17:44.81,Main,Shyarly,0,0,0,,...her şeye tarafsız\Nbir gözle bakabilmelisiniz.
Dialogue: 0,0:17:50.31,0:17:53.11,Main,Zeo,0,0,0,,Ölümüne dövüşmeyenlerinizin ölümü...
Dialogue: 0,0:17:53.11,0:17:56.52,Main,Zeo,0,0,0,,...nefretinizi insanlara yöneltmek\Niçin elimden olacak!
Dialogue: 0,0:18:02.58,0:18:05.67,Main,Brook,0,0,0,,Bunu kendi adamlarına yapamazsın!
Dialogue: 0,0:18:06.99,0:18:09.93,Main,Pirate,0,0,0,,Ucuz kurtardık!\NTeşekkürler, iskelet maskeli adam!
Dialogue: 0,0:18:11.91,0:18:13.60,Main,Zeo,0,0,0,,Yine mi sen?
Dialogue: 0,0:18:15.18,0:18:19.30,Main,Brook,0,0,0,,Ölmediğin halde ölümden anlıyormuş\Ngibi konuşup durma!
Dialogue: 0,0:18:19.30,0:18:22.61,Main,Brook,0,0,0,,Ölünce nefretin arkanda mı kalacak?\NBu resmen saçmalık!
Dialogue: 0,0:18:22.84,0:18:25.04,Main,Brook,0,0,0,,Öldüğün zaman geride hiçbir şey kalmaz!
Dialogue: 0,0:18:25.04,0:18:27.79,Main,Brook,0,0,0,,Kala kala kemiklerin kalır!
Dialogue: 0,0:18:28.60,0:18:30.59,Main,Franky,0,0,0,,Çok ikna ediciydi!
Dialogue: 0,0:18:30.59,0:18:31.91,Main,Brook,0,0,0,,Çok naziksin!
Dialogue: 0,0:18:32.28,0:18:36.61,Main,Brook,0,0,0,,Başkalarının canına değer vermeyenleri\Nhiç sevmem!
Dialogue: 0,0:18:36.61,0:18:38.74,Main,Brook,0,0,0,,Kokularına bile katlanamam!
Dialogue: 0,0:18:38.74,0:18:41.39,Main,Brook,0,0,0,,Her ne kadar burnum olmasa da!
Dialogue: 0,0:18:46.20,0:18:49.92,Main,Zeo,0,0,0,,Canına değer vermeyen sizsiniz!
Dialogue: 0,0:18:50.39,0:18:54.28,Main,Zeo,0,0,0,,Hiçbirinizin kaçmaya çalışmaması\Nşaşılacak şey.
Dialogue: 0,0:18:54.28,0:18:59.13,Main,Zeo,0,0,0,,Siz insanlar, Noah adaya çarpmadan\Nönce ölmüş olacaksınız!
Dialogue: 0,0:18:59.13,0:19:01.78,Main,Zeo,0,0,0,,Gerçi insan olup olmadığına\Ndair bir şey diyemem de!
Dialogue: 0,0:19:03.06,0:19:08.35,Main,Brook,0,0,0,,Kaptanımız Luffy \Nbir gün Korsanlar Kralı olacak.
Dialogue: 0,0:19:08.35,0:19:11.33,Main,Brook,0,0,0,,Bunu açıkça ifade etti.
Dialogue: 0,0:19:11.55,0:19:16.69,Main,Brook,0,0,0,,Bu adadan kimsenin zarar görmesine\Nizin vermez, bu konuda ona güvenimiz tam!
Dialogue: 0,0:19:17.24,0:19:21.83,Main,Brook,0,0,0,,Ona güveniyorum, \No yüzden kaygılanacak bir şey yok.
Dialogue: 0,0:19:21.83,0:19:25.80,Main,Brook,0,0,0,,Şimdi sıra üstüme düşeni yapmakta.
Dialogue: 0,0:19:25.80,0:19:29.92,Main,Brook,0,0,0,,Gözümün önünden bir kez daha kaybolmana\Nmüsaade etmeyeceğim!
Dialogue: 0,0:19:29.92,0:19:32.63,Main,Brook,0,0,0,,Her ne kadar gözlerim olmasa da!
Dialogue: 0,0:19:38.70,0:19:40.41,Main,Wadatsumi,0,0,0,,Nasıl ama?
Dialogue: 0,0:19:40.41,0:19:41.86,Main,Wadatsumi,0,0,0,,Şaşırdın mı?
Dialogue: 0,0:19:41.86,0:19:46.48,Main,Sanji,0,0,0,,Evet, bu kadarı yeter.\NŞaşkınlığa uğradım!
Dialogue: 0,0:19:48.76,0:19:50.01,Main,Wadatsumi,0,0,0,,Öyle mi?
Dialogue: 0,0:19:50.45,0:19:55.45,Main,Sanji,0,0,0,,Bu işi bitirelim mi, Jinbe?
Dialogue: 0,0:19:55.45,0:19:58.75,Main,Jinbe,0,0,0,,Evet, haydi yapalım!
Dialogue: 0,0:20:00.52,0:20:05.26,Main,Hyouzou,0,0,0,,Hey, dur biraz! Kılıçlarım kırıldı!
Dialogue: 0,0:20:06.43,0:20:09.52,Main,Hyouzou,0,0,0,,Şimdi nasıl dövüşeceğim?
Dialogue: 0,0:20:11.28,0:20:13.34,Main,Zoro,0,0,0,,Bana sorma.
Dialogue: 0,0:20:27.56,0:20:29.17,Main,Franky,0,0,0,,Ne kadar da sinir bozucu!
Dialogue: 0,0:20:29.17,0:20:33.62,Main,Franky,0,0,0,,Bu dövüşü cüretkar\Nbir teknikle hemen bitireceğim!
Dialogue: 0,0:20:33.62,0:20:36.26,Main,Usopp,0,0,0,,1, 2,...
Dialogue: 0,0:20:36.26,0:20:41.07,Main,Usopp,0,0,0,,3. adımını attığında benim tarafımdan\Nvurulacaksın ve bu iş bitmiş olacak!
Dialogue: 0,0:20:42.40,0:20:44.60,Main,Daruma,0,0,0,,Saçma sapan konuşma!
Dialogue: 0,0:20:44.89,0:20:48.64,Main,Daruma,0,0,0,,Hayal görmeyi bırak artık seni güçsüz şey!
Dialogue: 0,0:20:48.64,0:20:50.49,Main,Daruma,0,0,0,,Kimi kandırıyorsun?
Dialogue: 0,0:20:50.49,0:20:54.04,Main,Usopp,0,0,0,,Vay be yeteneğim köreliyor.
Dialogue: 0,0:20:54.04,0:20:57.57,Main,Usopp,0,0,0,,Önceden daha iyi blöf yapardım.
Dialogue: 0,0:20:58.71,0:21:00.84,Main,Usopp,0,0,0,,Artık uydurduklarımı gerçekleştirebiliyorum.
Dialogue: 0,0:21:02.93,0:21:04.81,Main,Pirate,0,0,0,,Bu canavar da neyin nesi böyle?
Dialogue: 0,0:21:06.20,0:21:07.63,Main,Daruma,0,0,0,,Önceden burada mıydı?
Dialogue: 0,0:21:07.63,0:21:09.07,Main,Usopp,0,0,0,,Bu...
Dialogue: 0,0:21:14.58,0:21:15.61,Main,Usopp,0,0,0,,Chopper?!
Dialogue: 0,0:21:16.05,0:21:20.23,Main,Dosun,0,0,0,,Ufacık tefecik eleman\Nbirden kocaman olmuş!
Dialogue: 0,0:21:20.23,0:21:23.06,Main,Usopp,0,0,0,,Hey! Hey, hey!
Dialogue: 0,0:21:30.56,0:21:33.83,Main,Usopp,0,0,0,,Kendini kaybetmene gerek yoktu!
Dialogue: 0,0:21:43.01,0:21:46.86,Main,Chopper,0,0,0,,Bir şeyim yok, Usopp.
Dialogue: 0,0:21:50.84,0:21:53.51,Main,Usopp,0,0,0,,Chopper, bir şeyim yok demekle\Nneyi kastediyorsun?
Dialogue: 0,0:21:53.51,0:22:00.57,Main,Chopper,0,0,0,,Artık Gümbürtü Topu ile\Nbu şekilde 3 dakika savaşabiliyorum.
Dialogue: 0,0:22:00.57,0:22:04.10,Main,Chopper,0,0,0,,Artık eskisi gibi değilim.
Dialogue: 0,0:22:04.10,0:22:07.99,Main,Chopper,0,0,0,,Artık başınıza bela olmayacağım.
Dialogue: 0,0:22:07.99,0:22:09.49,Main,Usopp,0,0,0,,İnanamıyorum!
Dialogue: 0,0:22:09.72,0:22:15.49,Main,Usopp,0,0,0,,O gücü kontrol edebiliyorsan\Nartık sana bel bağlayabiliriz demektir!
Dialogue: 0,0:22:15.49,0:22:16.48,Main,Chopper,0,0,0,,G-
Dialogue: 0,0:22:16.48,0:22:22.36,Main,Chopper,0,0,0,,Güzel şeyler söylemen beni hiç de\Nmutlu etmez seni şerefsiz!
Dialogue: 0,0:22:23.46,0:22:24.30,Main,Usopp,0,0,0,,Bu çok ürkütücü!
Dialogue: 0,0:22:26.51,0:22:29.45,Main,Dosun,0,0,0,,Tepemi attırıyorsun-dosun!
Dialogue: 0,0:22:29.45,0:22:35.62,Main,Dosun,0,0,0,,Ne kadar büyük olursan ol seni\Ndenizin dibine yollayacağım-gogyan!
Dialogue: 0,0:22:36.43,0:22:41.42,Main,Chopper,0,0,0,,Hiçbir yere yollanmayacağım.
Dialogue: 0,0:22:41.42,0:22:44.32,Main,Chopper,0,0,0,,Elinden geleni yap!
Dialogue: 0,0:22:44.32,0:22:46.16,Main,Usopp,0,0,0,,Chopper!
Dialogue: 0,0:22:46.90,0:22:52.74,Main,Daruma,0,0,0,,Dövüş sırasında bıdı bıdı mı ediyorsun?\NHaddini bil!
Dialogue: 0,0:22:52.74,0:22:57.07,Main,Daruma,0,0,0,,Hasır Şapkalar'a yük olmaktan\Nbaşka bir şey yapmıyorsun!
Dialogue: 0,0:22:57.07,0:23:01.32,Main,Daruma,0,0,0,,İcabına bakacağım!
Dialogue: 0,0:23:02.40,0:23:06.48,Main,Usopp,0,0,0,,Sana düzeneği kurduğumu söylemiştim.
Dialogue: 0,0:23:06.48,0:23:11.47,Main,Usopp,0,0,0,,Durma gel haydi! \NSana göz alıcı bir gösteri sergileyeceğim!
Dialogue: 0,0:23:11.47,0:23:15.81,Main,Ikaros,0,0,0,,Ne kadar da komik! Tek seferde\Nbu işi bitireceğini mi söyledin?
Dialogue: 0,0:23:16.25,0:23:19.22,Main,Ikaros,0,0,0,,Kalamar Mızrağı işe yaramamış olabilir...
Dialogue: 0,0:23:21.21,0:23:25.57,Main,Ikaros,0,0,0,,...fakat elimde seni delip\Ngeçecek başka bir şey daha var!
Dialogue: 0,0:23:28.30,0:23:29.03,Main,Ikaros,0,0,0,,Işık yay!
Dialogue: 0,0:23:29.00,0:23:30.87,Attack,TL Note,0,0,0,,{\fad(100,100)}Apaydınlık Mızrak
Dialogue: 0,0:23:32.78,0:23:35.98,Main,Ikaros,0,0,0,,Tek seferde işi bitirecek olan benim-hi!
Dialogue: 0,0:23:35.98,0:23:41.16,Main,Ikaros,0,0,0,,Kokpitinde delik açacağım-hi!
Dialogue: 0,0:23:42.41,0:23:44.25,Main,Franky,0,0,0,,Karizmatik görünüyor da...
Dialogue: 0,0:23:44.94,0:23:46.15,Main,Franky,0,0,0,,...işe yaramayacak!
Dialogue: 0,0:23:46.15,0:23:50.01,Main,Franky,0,0,0,,Sıradan bir kalamar bile değilsin...
Dialogue: 0,0:23:50.01,0:23:52.47,Main,Franky,0,0,0,,...nihai silahımın karşısında!
Dialogue: 0,0:23:54.20,0:23:59.45,Main,Hyouzou,0,0,0,,Çıplak ellerimle dövüşemem ki.\NNe yapsam ki?
Dialogue: 0,0:24:00.22,0:24:02.73,Main,Zoro,0,0,0,,Dövüşmeye niyeti olmayanla işim olmaz!
Dialogue: 0,0:24:02.73,0:24:04.74,Main,Zoro,0,0,0,,Bas git, kurbağa kılıklı!
Dialogue: 0,0:24:04.74,0:24:06.15,Thoughts,Hyouzou,0,0,0,,Kurbağa mı?
Dialogue: 0,0:24:06.14,0:24:10.76,Main,Wadatsumi,0,0,0,,Bitirmek mi? Onu ben söyleyecektim.
Dialogue: 0,0:24:10.76,0:24:15.65,Main,Wadatsumi,0,0,0,,Dayak yediğim için kendimi şişirdiğimi\Nfalan sanmayın şapşallar!
Dialogue: 0,0:24:16.61,0:24:23.07,Main,Wadatsumi,0,0,0,,Şimdi etrafta yuvarlanıp\Narkadaşlarınızı ezeceğim!
Dialogue: 0,0:24:26.74,0:24:30.90,Main,Zeo,0,0,0,,Burası benim çöplüğüm iskelet adam!
Dialogue: 0,0:24:30.90,0:24:36.71,Main,Zeo,0,0,0,,Yaklaşırsan kemiklerini kırarım!
Dialogue: 0,0:24:37.81,0:24:39.50,Main,Zeo,0,0,0,,Ne yapacaksın bakalım?
Dialogue: 0,0:24:53.64,0:24:55.95,Main,Brook,0,0,0,,Affedersin ama...
Dialogue: 0,0:24:55.95,0:24:59.60,Main,Brook,0,0,0,,...yaklaştım ve seni çoktan kestim.
Dialogue: 0,0:25:00.06,0:25:03.64,Main,Brook,0,0,0,,Buz kesileceksin. Kendine iyi bak.
Dialogue: 0,0:25:04.74,0:25:06.75,Main,Zeo,0,0,0,,Ne zaman yaklaştın-?
Dialogue: 0,0:25:06.79,0:25:08.59,Attack,TL Note,0,0,0,,{\fad(100,100)}Anlık Bakış Şarkısı
Dialogue: 0,0:25:08.66,0:25:10.35,Attack,TL Note,0,0,0,,{\fad(100,100)}Kar Fırtınası Kesişi
Dialogue: 0,0:25:15.78,0:25:18.47,Main,Brook,0,0,0,,Bir şiir okuyayım izninle.
Dialogue: 0,0:25:18.91,0:25:21.04,Main,Brook,0,0,0,,Uzaklardaki ölüler diyarından gelen...
Dialogue: 0,0:25:21.04,0:25:22.95,Main,Brook,0,0,0,,...kan dondurucu rüzgar...
Dialogue: 0,0:25:23.80,0:25:26.88,Main,Brook,0,0,0,,...ne olur es de birkaç\Neteği havalandır!
Dialogue: 0,0:25:28.46,0:25:29.42,Main,Daruma,0,0,0,,Geber!
Dialogue: 0,0:25:34.74,0:25:35.66,Main,Daruma,0,0,0,,Bunlar da ne?
Dialogue: 0,0:25:41.14,0:25:46.86,Main,Usopp,0,0,0,,Bu şeyin uçan cisimlere saldıran\Ninsan görünümünde kökleri var.
Dialogue: 0,0:25:46.86,0:25:48.78,Main,Usopp,0,0,0,,Ve etrafını sardılar!
Dialogue: 0,0:25:49.73,0:25:51.64,Main,Daruma,0,0,0,,Şimdi ne var?
Dialogue: 0,0:25:55.76,0:25:57.34,Main,Usopp,0,0,0,,Gelen düşmanları uçurur!
Dialogue: 0,0:25:57.89,0:26:03.10,Main,Usopp,0,0,0,,Sonunda havadasın. Kaçamazsın artık!
Dialogue: 0,0:26:12.94,0:26:17.10,Main,Daruma,0,0,0,,Canavar mı gönderdin?\NIsırıp parçalayacağım!
Dialogue: 0,0:26:17.10,0:26:20.48,Main,Usopp,0,0,0,,Yapmasan iyi edersin. \NBurnundaki soğandan...
Dialogue: 0,0:26:20.48,0:26:26.39,Main,Usopp,0,0,0,,...3 metrelik çapın içine şok dalgası yayıyor.
Dialogue: 0,0:26:34.29,0:26:38.04,Main,Dosun,0,0,0,,Dosun! Dogan! Bogan!
Dialogue: 0,0:26:38.04,0:26:40.54,Main,Dosun,0,0,0,,Dünyanın öteki ucuna yollan şimdi!
Dialogue: 0,0:26:40.54,0:26:43.84,Main,Dosun,0,0,0,,Gadon! Megagon!
Dialogue: 0,0:26:46.86,0:26:49.94,Attack,TL Note,0,0,0,,{\fad(100,100)}Ayrık Toynak
Dialogue: 0,0:26:50.42,0:26:52.84,Main,Dosun,0,0,0,,Dogyan!
Dialogue: 0,0:26:56.74,0:26:59.75,Main,Dosun,0,0,0,,Pi... Pikon...
Dialogue: 0,0:26:59.75,0:27:01.96,Main,Ikaros,0,0,0,,Kalamar! Kalamar! Kalamar!
Dialogue: 0,0:27:01.96,0:27:06.51,Main,Ikaros,0,0,0,,Al bunu! Deniz altındaki dağı\Nbile delip geçecek bu mızrak!
Dialogue: 0,0:27:08.27,0:27:10.18,Main,Ikaros,0,0,0,,Kalamar! Kalamar! Kalamar!
Dialogue: 0,0:27:16.69,0:27:18.93,Main,Ikaros,0,0,0,,Kuru kalamar!
Dialogue: 0,0:27:21.05,0:27:24.89,Main,Usopp,0,0,0,,Lazer ışını?!
Dialogue: 0,0:27:25.50,0:27:29.21,Attack,TL Note,0,0,0,,{\fad(100,100)}Balık Adam Karatesi: Gizli Tekniği
Dialogue: 0,0:27:30.02,0:27:32.41,Attack,TL Note,0,0,0,,{\fad(100,100)}Avare Matkabı
Dialogue: 0,0:27:40.05,0:27:41.45,Main,Pirate,0,0,0,,Neee?
Dialogue: 0,0:27:41.45,0:27:45.01,Main,Pirate,0,0,0,,Su, bedenini deldi geçti!
Dialogue: 0,0:27:45.01,0:27:47.55,Main,Wadatsumi,0,0,0,,Hava sızacak...
Dialogue: 0,0:27:51.22,0:27:53.83,Main,Sanji,0,0,0,,Nasıl buldun buraları, balon balığı?
Dialogue: 0,0:27:54.93,0:27:56.29,Main,Wadatsumi,0,0,0,,Bu insan uçuyor!
Dialogue: 0,0:27:56.29,0:27:58.57,Main,Wadatsumi,0,0,0,,Ödümü koparttın!
Dialogue: 0,0:28:00.66,0:28:03.64,Thoughts,Sanji,0,0,0,,Geçtiğimiz 2 yılda olanlarını unutma...
Dialogue: 0,0:28:04.15,0:28:06.39,Flashbacks,Oh god no,0,0,0,,{\i1}Sanji-kyuuun!
Dialogue: 0,0:28:06.39,0:28:10.87,Main,Sanji,0,0,0,,Neden böyle bir cehenneme\Nkatlanmak zorunda kaldım lan ben?
Dialogue: 0,0:28:10.87,0:28:12.60,Main,Wadatsumi,0,0,0,,Alev aldı!
Dialogue: 0,0:28:12.60,0:28:15.10,Main,Sanji,0,0,0,,O anıları yakmak istiyorum!
Dialogue: 0,0:28:21.86,0:28:26.33,Main,Sanji,0,0,0,,Ödün mü koptu? \NBeni uğraşmaktan kurtarmışsın işte.
Dialogue: 0,0:28:27.22,0:28:31.15,Main,Sanji,0,0,0,,Balon balığı pişireceğim zaman\Nzehirli kısımları dikkatle kesmem gerekir.
Dialogue: 0,0:28:33.02,0:28:35.45,Main,Hyouzou,0,0,0,,Şu zehre bulanmış kılıçların\Ntadına bak bakalım!
Dialogue: 0,0:28:35.71,0:28:37.87,Main,Zoro,0,0,0,,Kes şunu kurbağa kılıklı!
Dialogue: 0,0:28:37.87,0:28:40.67,Main,Hyouzou,0,0,0,,Kurbağa değilim ben!
Dialogue: 0,0:28:40.67,0:28:46.18,Main,Hyouzou,0,0,0,,Balık Adam Adası'nda \NHattouryuu'da en usta ahtapot, Hyouzaou'yum ben!
Dialogue: 0,0:28:40.67,0:28:46.18,Note,TL Note,0,0,0,,{\fad(100,100)}Hattouryuu: 8 Kılıç Stili
Dialogue: 0,0:28:46.18,0:28:48.09,Main,Hyouzou,0,0,0,,Unutma sakın!
Dialogue: 0,0:28:48.42,0:28:52.60,Attack,TL Note,0,0,0,,{\fad(100,100)}Araf İblis Kesişi
Dialogue: 0,0:28:54.92,0:28:56.20,Main,Zoro,0,0,0,,Özür dilerim.
Dialogue: 0,0:28:56.65,0:29:00.98,Main,Zoro,0,0,0,,Seni kurbağa sanmıştım.\NKüçük denizin önemsiz kurbağası.
Dialogue: 0,0:00:02.99,0:00:08.38,Main,,0,0,0,,Dünyanın sunabileceği her şeyi elde eden adam, Korsanlar Kralı Gold Roger.
Dialogue: 0,0:00:08.38,0:00:13.00,Main,,0,0,0,,Son sözleri dünyanın her yerinden\Nmaceracıları denize çekti.
Dialogue: 0,0:00:13.00,0:00:14.68,Main,,0,0,0,,"Hazinem mi?"
Dialogue: 0,0:00:14.68,0:00:16.22,Main,,0,0,0,,"İstiyorsanız, size vereceğim!"
Dialogue: 0,0:00:16.22,0:00:17.42,Main,,0,0,0,,"Arayın ve bulun!"
Dialogue: 0,0:00:17.42,0:00:19.87,Main,,0,0,0,,"Bu dünyanın sunabileceği her şeyi orada bıraktım!"
Dialogue: 0,0:00:19.87,0:00:22.69,Main,,0,0,0,,Korsanlar hayallerinin peşinden yola çıktılar!
Dialogue: 0,0:00:22.69,0:00:25.35,Main,,0,0,0,,Dünya, Büyük Korsan Çağı'na girdi!
Dialogue: 0,0:00:25.35,0:00:29.31,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪
Dialogue: 0,0:00:29.31,0:00:33.81,We Go lyrics,,0,0,0,,♪ Şafak vakti gelmedi bile ve ben bekleyemiyorum! ♪
Dialogue: 0,0:00:33.81,0:00:37.48,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı, dört... Gidelim! ♪
Dialogue: 0,0:00:38.97,0:00:43.05,We Go lyrics,,0,0,0,,♪ Bayrağımızı dalgalandıralım, macera şafağının doğuşuna. ♪
Dialogue: 0,0:00:44.41,0:00:49.74,We Go lyrics,,0,0,0,,♪ Dalgalar yapalım, bizi uykumuzdan kaldırsınlar. ♪
Dialogue: 0,0:00:49.74,0:00:54.28,We Go lyrics,,0,0,0,,♪ Eğer inanılmaz bir dünyaya gitmek istiyorsan,
Dialogue: 0,0:00:54.28,0:00:58.79,We Go lyrics,,0,0,0,, gerekli olan şey senin dayanıklılığın. ♪
Dialogue: 0,0:00:59.11,0:01:01.73,We Go lyrics,,0,0,0,,♪ Fazla dikkat çekmek, bu bir suç mu? ♪
Dialogue: 0,0:01:01.73,0:01:04.62,We Go lyrics,,0,0,0,,♪ Aranıyor → Kazanan demektir! ♪
Dialogue: 0,0:01:04.62,0:01:10.50,We Go lyrics,,0,0,0,,♪ Özgür olmak bizim tek kuralımız! ♪
Dialogue: 0,0:01:10.50,0:01:15.99,We Go lyrics,,0,0,0,,♪ Endişelerinizi unutun, bırakın rüzgar essin. ♪
Dialogue: 0,0:01:15.99,0:01:18.53,We Go lyrics,,0,0,0,,♪ Ne pahasına olursa olsun, One Piece'i ilk biz bulacağız! ♪
Dialogue: 0,0:01:18.53,0:01:22.66,We Go lyrics,,0,0,0,,♪ Hayal kuran kalplerimiz, çok büyük... ♪
Dialogue: 0,0:01:22.66,0:01:26.93,We Go lyrics,,0,0,0,,♪ Onları uyandırmamak önemli. ♪
Dialogue: 0,0:01:26.93,0:01:29.57,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪
Dialogue: 0,0:01:29.57,0:01:33.54,We Go lyrics,,0,0,0,,♪ Şafak vakti gelmedi bile ve ben bekleyemiyorum! ♪
Dialogue: 0,0:01:33.54,0:01:37.33,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı, dört... Gidelim! ♪
Dialogue: 0,0:01:38.76,0:01:44.72,We Go lyrics,,0,0,0,,♪ Biz... buralara kadar geldik. ♪
Dialogue: 0,0:01:44.72,0:01:47.62,We Go lyrics,,0,0,0,,♪ Gideceğiz... hayallerimizin olduğu yere,
Dialogue: 0,0:01:47.62,0:01:52.70,We Go lyrics,,0,0,0,, ve kimseyi arkada bırakmayacağız. ♪
Dialogue: 0,0:01:52.70,0:01:55.30,We Go lyrics,,0,0,0,,♪ Hep devam edeceğiz, bu bir söz. ♪
Dialogue: 0,0:01:55.30,0:01:59.47,We Go lyrics,,0,0,0,,♪ Hayallerimizin başladığı o günden beri,
Dialogue: 0,0:01:59.47,0:02:03.72,We Go lyrics,,0,0,0,, belirlediğimiz gelecek, değişmedi! ♪
Dialogue: 0,0:02:03.72,0:02:06.24,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪
Dialogue: 0,0:02:06.24,0:02:10.61,We Go lyrics,,0,0,0,,♪ Kalbimdeki güneş, asla batmayacak! ♪
Dialogue: 0,0:02:10.61,0:02:13.38,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... ♪
Dialogue: 0,0:02:14.78,0:02:17.57,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... ♪
Dialogue: 0,0:02:18.75,0:02:24.82,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... dört... Gidelim! ♪
Dialogue: 0,0:02:27.27,0:02:29.67,We Go lyrics,,0,0,0,,♪ Gidelim! ♪
