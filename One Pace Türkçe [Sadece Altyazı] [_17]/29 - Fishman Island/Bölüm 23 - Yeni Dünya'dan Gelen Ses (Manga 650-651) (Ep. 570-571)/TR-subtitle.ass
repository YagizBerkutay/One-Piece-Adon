Dialogue: 0,0:31:26.09,0:31:28.98,Author,,0,0,0,,{\fad(0,0)\fs19} Türkçeleştirme & Çevirmen  {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&} - {\c&H01BAFF&}{\b1}eray.gns{\b0}{\c&HFFFFFF&}\N{\fs19}thx to onepace.net
Dialogue: 0,0:02:43.19,0:02:45.00,Main,Neptune,0,0,0,,Ne için bilmiyorum...
Dialogue: 0,0:02:45.61,0:02:51.21,Main,Neptune,0,0,0,,...ama çok eski zamanlarda, \Ndünyayı yok edebilecek seviyede güçler varmış.
Dialogue: 0,0:02:53.52,0:02:57.34,Main,Neptune,0,0,0,,Tanrının adlarının verildiği\Nüç antik silah...
Dialogue: 0,0:02:57.34,0:03:01.97,Main,Neptune,0,0,0,,Pluton, Uranüs ve Poseidon.
Dialogue: 0,0:03:03.00,0:03:05.52,Main,Robin,0,0,0,,Ve kızınız da onlardan biri.
Dialogue: 0,0:03:06.59,0:03:07.73,Main,Neptune,0,0,0,,Maalesef.
Dialogue: 0,0:03:09.81,0:03:13.40,Main,Robin,0,0,0,,Bu bilgi kimselerin kulağına gitmemeli.
Dialogue: 0,0:03:14.49,0:03:18.57,Main,Robin,0,0,0,,Dünyada sözü geçen tüm gruplar \NPrenses Shirahoshi'nin gücünün peşine düşecektir.
Dialogue: 0,0:03:19.37,0:03:21.70,Main,Robin,0,0,0,,Hükümet olsun, korsanlar olsun...
Dialogue: 0,0:03:24.28,0:03:29.15,Main,Caribou,0,0,0,,Antik silah mı!?\NDünyayı yok edebilecek güç mü?!
Dialogue: 0,0:03:33.85,0:03:37.34,Main,Caribou,0,0,0,,Ganimetimi kaldırmış tam da\Nadayı terk edeceğim diyordum ki...
Dialogue: 0,0:03:37.34,0:03:41.26,Main,Caribou,0,0,0,,...çok daha dehşetli\Nbir şeyler duydum ya!
Dialogue: 0,0:03:42.76,0:03:46.04,Main,Caribou,0,0,0,,Şu işe bakın!? Demek o\NDeniz Kızı Prenses öyle bir şeymiş!?
Dialogue: 0,0:03:53.99,0:03:56.14,Main,Jinbe,0,0,0,,Aklıma gelmişken sorayım, Luffy.
Dialogue: 0,0:03:56.14,0:03:59.83,Main,Jinbe,0,0,0,,Dünyanın şu anki hali için\Nne düşünüyorsun?
Dialogue: 0,0:04:00.99,0:04:02.83,Main,Luffy,0,0,0,,Ne? Bu da nereden çıktı böyle birden?
Dialogue: 0,0:04:02.83,0:04:05.44,Main,Jinbe,0,0,0,,Anlaşılan hiçbir şeyden haberiniz yok!
Dialogue: 0,0:04:05.44,0:04:08.06,Main,Jinbe,0,0,0,,Böyle olan bitenle ilgili bilgisiz\Nolmanız hiç iyi değil ama...
Dialogue: 0,0:04:08.06,0:04:09.36,Main,Luffy,0,0,0,,Öyle mi?
Dialogue: 0,0:04:11.55,0:04:13.32,Main,Citizen,0,0,0,,Beklettiğimiz için özür dileriz!
Dialogue: 0,0:04:13.32,0:04:15.40,Main,Jinbe,0,0,0,,Gel sakin bir yerde konuşalım seninle.
Dialogue: 0,0:04:15.40,0:04:17.16,Main,Luffy,0,0,0,,Olur! Bekle biraz!
Dialogue: 0,0:04:20.01,0:04:22.21,Main,Luffy,0,0,0,,Yanıma yiyecek bir şeyler alayım.
Dialogue: 0,0:04:23.04,0:04:26.54,Main,Luffy,0,0,0,,Olaya gel,\Nsiz de mi buradaydınız?
Dialogue: 0,0:04:28.65,0:04:31.38,Main,Nami,0,0,0,,İpin ucunu kaçırmışım içerken!\NAyılmaya çalışıyorum.
Dialogue: 0,0:04:31.69,0:04:33.27,Main,Usopp,0,0,0,,Ben de sindirmeye çalışıyorum.
Dialogue: 0,0:04:33.58,0:04:35.84,Main,Chopper,0,0,0,,Sanji de unutmaya çalışıyor.
Dialogue: 0,0:04:35.84,0:04:40.22,Main,Sanji,0,0,0,,Süper gerçekten!\NDeniz Kızı Adası!
Dialogue: 0,0:04:40.22,0:04:43.83,Main,Luffy,0,0,0,,Ne?! Akainu'yla Aokiji\Nbüyük bir kavga mı ettiler?
Dialogue: 0,0:04:44.18,0:04:49.90,Main,Jinbe,0,0,0,,Biliyordum! Sizin o büyük olaydan\Nhaberiniz yok, değil mi?
Dialogue: 0,0:04:49.90,0:04:52.48,Main,Luffy,0,0,0,,Çalışmalarım sırasında hiçbir şey duymadım.
Dialogue: 0,0:04:52.48,0:04:54.51,Main,Jinbe,0,0,0,,Rayleigh amma katıymış!
Dialogue: 0,0:04:54.51,0:04:57.43,Main,Chopper,0,0,0,,Ben onu biliyordum!\NBiliyorum yani!
Dialogue: 0,0:04:57.43,0:04:58.59,Main,Usopp,0,0,0,,Harbi misin?!
Dialogue: 0,0:04:58.59,0:05:01.77,Main,Jinbe,0,0,0,,İki yıl önceki savaşın hemen ardından,...
Dialogue: 0,0:05:01.77,0:05:05.04,Main,Jinbe,0,0,0,,...Filo Amirali Sengoku istifa etti.
Dialogue: 0,0:05:06.50,0:05:12.73,Main,Jinbe,0,0,0,,Sengoku, yerine adamları arasında\Nepey tutulan Aokiji'yi önerdi lakin...
Dialogue: 0,0:05:12.73,0:05:16.48,Main,Jinbe,0,0,0,,...yüksek rütbeli pek çok kişi\NAkainu'nun tarafını tutunca...
Dialogue: 0,0:05:16.48,0:05:19.49,Main,Jinbe,0,0,0,,...o da bu konuda büyük\Nbir rakip haline geldi.
Dialogue: 0,0:05:21.91,0:05:25.52,Main,Jinbe,0,0,0,,Aokiji normalde pek\Nne istediğini belli etmez ama...
Dialogue: 0,0:05:25.52,0:05:30.13,Main,Jinbe,0,0,0,,...Akainu'nun Filo Amirali olması\Nkonusuna şiddetle karşı çıktı.
Dialogue: 0,0:05:30.94,0:05:36.21,Main,Jinbe,0,0,0,,Bu tutumları Amiraller arasında\Nilk kez bir düşmanlığa yol açtı ve...
Dialogue: 0,0:05:36.21,0:05:39.73,Main,Jinbe,0,0,0,,...adanın birinde savaşa kadar ilerledi iş.
Dialogue: 0,0:05:41.89,0:05:44.12,Main,Jinbe,0,0,0,,Ölüler konuşamaz\Ndemeleri gibi yenilen kişi...
Dialogue: 0,0:05:44.12,0:05:47.26,Main,Jinbe,0,0,0,,...tek bir söz söylemeksizin\Nadaylığını çekecekti.
Dialogue: 0,0:05:47.26,0:05:52.23,Main,Jinbe,0,0,0,,Kazanansa donanmayı yönetecek kişi olacaktı.
Dialogue: 0,0:05:53.87,0:05:58.76,Main,Jinbe,0,0,0,,Tek bildiğimiz ölümüne\Nmücadelelerinin on gün sürdüğü.
Dialogue: 0,0:05:58.76,0:06:04.06,Main,Jinbe,0,0,0,,Güç bakımından ikisi de birbirine eşti ama\Nelbette bir nihayeti de vardı bu savaşın.
Dialogue: 0,0:06:04.83,0:06:10.20,Main,Jinbe,0,0,0,,Kazanan Akainu'ydu!\NYeni Filo Amirali Sakazuki oldu.
Dialogue: 0,0:06:11.90,0:06:13.59,Main,Luffy,0,0,0,,Akainu!
Dialogue: 0,0:06:13.86,0:06:16.10,Flashbacks,Gendo Ikari,0,0,0,,Benimsin!
Dialogue: 0,0:06:23.47,0:06:24.88,Main,Luffy,0,0,0,,Aokiji öldü mü?
Dialogue: 0,0:06:24.88,0:06:27.77,Main,Jinbe,0,0,0,,İkisi de ağır biçimde yaralanmışlar...
Dialogue: 0,0:06:27.77,0:06:31.39,Main,Jinbe,0,0,0,,...ama gözleri önünde ayağa bile\Nkalkmaktan aciz olan eski yoldaşına...
Dialogue: 0,0:06:31.39,0:06:34.30,Main,Jinbe,0,0,0,,...taş yürekli Akainu bile\Nmerhamet göstermiş.
Dialogue: 0,0:06:34.65,0:06:37.42,Main,Jinbe,0,0,0,,Tabii Akainu'nun boyunduruğunda\Ngörev yapmayı reddeden Aokiji...
Dialogue: 0,0:06:37.42,0:06:39.11,Main,Jinbe,0,0,0,,...sonuç olarak donanmayı terk etti.
Dialogue: 0,0:06:39.57,0:06:42.18,Main,Luffy,0,0,0,,O zaman Aokiji donanmadan\Ndeğil mi artık yani?
Dialogue: 0,0:06:42.18,0:06:47.34,Main,Jinbe,0,0,0,,Aynen öyle... Şimdi ne tür düşüncelerle\Nnerelerdedir kim bilir...
Dialogue: 0,0:06:47.34,0:06:51.14,Main,Jinbe,0,0,0,,Hükümet için de büyük bir kayıp oldu.
Dialogue: 0,0:06:51.14,0:06:57.09,Main,Jinbe,0,0,0,,Ama Hükümetin bu kaybı\Ntelafi etmek için yaptığı şey...
Dialogue: 0,0:06:57.09,0:06:59.86,Main,Jinbe,0,0,0,,...donanmaya hiç beklenmedik\Nbir güç kattı.
Dialogue: 0,0:06:59.86,0:07:05.16,Main,Jinbe,0,0,0,,Bakın beni dinleyin! Geçtiğimiz iki yılda\NYeni Dünya'da meydana gelmiş...
Dialogue: 0,0:07:05.16,0:07:07.97,Main,Jinbe,0,0,0,,...ve bilmeniz gereken\Niki önemli değişiklik oldu.
Dialogue: 0,0:07:09.12,0:07:12.96,Main,Jinbe,0,0,0,,Birincisi Sakazuki liderliğindeki\NDonanma Karargâhı...
Dialogue: 0,0:07:12.96,0:07:17.34,Main,Jinbe,0,0,0,,...adalet adına çalışan çok daha\Nbüyük bir güç haline dönüştü.
Dialogue: 0,0:07:17.34,0:07:19.57,Main,Jinbe,0,0,0,,İkincisiyse...
Dialogue: 0,0:07:19.57,0:07:22.72,Main,Jinbe,0,0,0,,...Karasakal Korsanları denizlere\Nbüyük bir hakimiyet kurdular.
Dialogue: 0,0:07:23.64,0:07:25.57,Main,Usopp,0,0,0,,Karasakal mı?
Dialogue: 0,0:07:25.57,0:07:27.76,Main,Nami,0,0,0,,Mock Town'da karşılaştığımız kişiler, değil mi?
Dialogue: 0,0:07:27.76,0:07:29.79,Main,Chopper,0,0,0,,Memleketimi yok etmişlerdi bir kez...
Dialogue: 0,0:07:33.48,0:07:36.17,Flashbacks,Blackbeard,0,0,0,,Görüşmeyeli epey oldu, Hasır Şapka!
Dialogue: 0,0:07:37.75,0:07:41.79,Main,Jinbe,0,0,0,,Kendisi bir aralar\NBeyazsakal Korsanları'nın bir üyesiydi.
Dialogue: 0,0:07:41.79,0:07:46.09,Main,Jinbe,0,0,0,,Yani Beyazsakal'ın bölgelerini\Nçok iyi biliyordu...
Dialogue: 0,0:07:46.09,0:07:49.62,Main,Jinbe,0,0,0,,...ve iyi yürekli ihtiyar ölür ölmez de\Nilk işi ihtiyardan aldığı...
Dialogue: 0,0:07:50.78,0:07:55.12,Main,Jinbe,0,0,0,,...Gura Gura Meyvesinin gücünü kullanarak\Nbu yerleri fethetmek oldu.
Dialogue: 0,0:07:56.19,0:07:58.07,Main,Jinbe,0,0,0,,Dünya onu çoktan...
Dialogue: 0,0:07:58.07,0:07:59.77,Main,Jinbe,0,0,0,,...Kızıl Saç,...
Dialogue: 0,0:07:59.77,0:08:01.96,Main,Jinbe,0,0,0,,...Kaido...
Dialogue: 0,0:08:01.96,0:08:04.42,Main,Jinbe,0,0,0,,...ve Big Mom'la birlikte...
Dialogue: 0,0:08:04.42,0:08:07.84,Main,Jinbe,0,0,0,,...Yonko olarak görmeye başladı bile.
Dialogue: 0,0:08:07.84,0:08:11.25,Main,Nami,0,0,0,,Yani gelip Beyazsakal'ın tahtına\Nkuruldu öyle mi?
Dialogue: 0,0:08:11.25,0:08:12.25,Main,Nami,0,0,0,,Ne sinsi bir illet!
Dialogue: 0,0:08:12.95,0:08:15.74,Main,Jinbe,0,0,0,,Gerçekten de sinir bozucu bir genç.
Dialogue: 0,0:08:15.74,0:08:21.05,Main,Jinbe,0,0,0,,Söylentilere göre şimdilerde Şeytan Meyvesi\Nyemiş kişilerin peşindelermiş.
Dialogue: 0,0:08:21.05,0:08:28.66,Main,Jinbe,0,0,0,,Bir şekilde Şeytan Meyvesi yemiş kişiyi\Nöldürdükten sonra gücünü alabiliyorlarmış.
Dialogue: 0,0:08:28.66,0:08:33.58,Main,Jinbe,0,0,0,,Karasakallar'ın hedefi çok daha güçlü\NŞeytan Meyvesi yeteneği barındıran kişiler.
Dialogue: 0,0:08:33.58,0:08:34.58,Main,Jinbe,0,0,0,,Dikkatli olun!
Dialogue: 0,0:08:36.96,0:08:38.88,Main,Chopper,0,0,0,,Ben yandım o zaman!
Dialogue: 0,0:08:38.88,0:08:40.84,Main,Usopp,0,0,0,,Hito Hito Meyveni n'apsınlar senin?
Dialogue: 0,0:08:40.84,0:08:41.42,Main,Chopper,0,0,0,,Ne dedin?
Dialogue: 0,0:08:41.54,0:08:43.03,Main,Jinbe,0,0,0,,Özellikle de sen Luffy-kun.
Dialogue: 0,0:08:45.23,0:08:48.95,Main,Jinbe,0,0,0,,Karasakal Teach'le aranızda\Nbüyük bir düşmanlık söz konusu.
Dialogue: 0,0:08:48.95,0:08:50.07,Main,Jinbe,0,0,0,,O yüzden de...
Dialogue: 0,0:08:52.27,0:08:54.25,Main,Jinbe,0,0,0,,Luffy!
Dialogue: 0,0:08:54.25,0:08:55.48,Main,Jinbe,0,0,0,,Dinliyor musun sen beni?!
Dialogue: 0,0:08:56.44,0:08:59.06,Main,Jinbe,0,0,0,,Kaptan değil misin sen be?!
Dialogue: 0,0:08:59.06,0:09:02.21,Main,Jinbe,0,0,0,,Az da olsa birkaç bir şeyi\Nsok şu kafana!
Dialogue: 0,0:09:02.21,0:09:06.08,Main,Sanji,0,0,0,,Boşver sen onu, Jinbe.\NBiz dinliyoruz yeter.
Dialogue: 0,0:09:06.08,0:09:10.35,Main,Chopper,0,0,0,,Ne! Kaptan dedikleri\Nkimseleri dinlemeyen kişiler değil miydi?!
Dialogue: 0,0:09:10.35,0:09:15.77,Main,Jinbe,0,0,0,,Kaptanlar tayfalarının güvenliğinden\Nsorumludur, haksız mıyım Luffy!?
Dialogue: 0,0:09:16.27,0:09:18.89,Main,Luffy,0,0,0,,Aman Jinbe, kasma bu kadar.
Dialogue: 0,0:09:18.89,0:09:20.74,Main,Luffy,0,0,0,,İşi şansa bırakmayı severim.
Dialogue: 0,0:09:22.23,0:09:24.92,Main,Jinbe,0,0,0,,Sizin işiniz zor gerçekten.
Dialogue: 0,0:09:24.92,0:09:26.72,Main,Crew,0,0,0,,Ha şunu bileydin.
Dialogue: 0,0:09:26.72,0:09:28.18,Main,Luffy,0,0,0,,Oh, Camie!
Dialogue: 0,0:09:28.18,0:09:30.91,Main,Luffy,0,0,0,,O değil de bizim Zayıf-hoshi'yi\Nhiçbir yerde göremiyorum.
Dialogue: 0,0:09:30.91,0:09:35.29,Main,Caimie,0,0,0,,Prenses-sama yorulmuş o yüzden de\Naz önce odasına dinlenmeye çekildi.
Dialogue: 0,0:09:40.67,0:09:42.36,Main,Luffy,0,0,0,,Bak az, Zoro!
Dialogue: 0,0:09:42.36,0:09:43.36,Main,Luffy,0,0,0,,Sanji!
Dialogue: 0,0:09:44.82,0:09:48.16,Main,Luffy,0,0,0,,Bu yerde vahşi hayvan kokusu\Nalıyorum sanki...
Dialogue: 0,0:09:49.63,0:09:50.97,Main,Zoro,0,0,0,,Öyle gerçekten.
Dialogue: 0,0:09:50.97,0:09:52.92,Main,Sanji,0,0,0,,Ben de hissettim.
Dialogue: 0,0:09:58.00,0:09:59.96,Main,Shirahoshi,0,0,0,,Yardım edin!
Dialogue: 0,0:10:02.23,0:10:04.15,Main,Shirahoshi,0,0,0,,Yapmayın lütfen!
Dialogue: 0,0:10:04.15,0:10:06.57,Main,Shirahoshi,0,0,0,,Siz kimsiniz?!
Dialogue: 0,0:10:10.22,0:10:13.67,Main,Shirahoshi,0,0,0,,Birileri yardım etsin!
Dialogue: 0,0:10:15.60,0:10:21.01,Main,Caribou,0,0,0,,Böyle kızgın kızgın\Nbakma ama Prenses-san!
Dialogue: 0,0:10:21.01,0:10:25.39,Main,Caribou,0,0,0,,Hiç korkma! Canını yakıp\Nacı çektirme niyetinde değilim!
Dialogue: 0,0:10:25.39,0:10:30.01,Main,Caribou,0,0,0,,Hazineyi almak yetecekti, Deniz Kızlarını\Nsatma külfetinden yırtıyordum...
Dialogue: 0,0:10:30.01,0:10:33.66,Main,Caribou,0,0,0,,...ama sen çok özelsin.
Dialogue: 0,0:10:33.66,0:10:38.54,Main,Caribou,0,0,0,,Bir süre baygın kalacaksın sadece!
Dialogue: 0,0:10:38.54,0:10:43.46,Main,Caribou,0,0,0,,Adanın limanlarından birine yanaşmış\Nkardeşim ve adamlarından haber aldım!
Dialogue: 0,0:10:43.46,0:10:47.30,Main,Caribou,0,0,0,,Bizimle Yeni Dünya'ya geleceksin!
Dialogue: 0,0:10:47.84,0:10:48.80,Main,Luffy,0,0,0,,Baksana!
Dialogue: 0,0:10:48.80,0:10:51.49,Main,Caribou,0,0,0,,Hadisene! Gülsene!
Dialogue: 0,0:10:55.60,0:10:56.25,Main,Luffy,0,0,0,,Lan!
Dialogue: 0,0:10:56.25,0:10:58.02,Main,Caribou,0,0,0,,Hasır Şapka!?
Dialogue: 0,0:10:58.02,0:10:59.10,Main,Shirahoshi,0,0,0,,Luffy-sama!
Dialogue: 0,0:11:08.13,0:11:10.13,Main,Luffy,0,0,0,,Hâlâ buralarda mıymış o ya?
Dialogue: 0,0:11:10.13,0:11:11.64,Main,Shirahoshi,0,0,0,,Luffy-sama!
Dialogue: 0,0:11:13.17,0:11:16.05,Main,Shirahoshi,0,0,0,,Çok korktum!
Dialogue: 0,0:11:16.05,0:11:18.61,Main,Sanji,0,0,0,,Dünya sana güzel şimdi Luffy!
Dialogue: 0,0:11:18.61,0:11:20.93,Main,Sanji,0,0,0,,Keşke ben basaydım tekmeyi, kahretmesin!
Dialogue: 0,0:11:20.93,0:11:24.34,Main,Right Minister,0,0,0,,Ucuz atlattık!\NSonsuz teşekkürlerimi sunuyorum!
Dialogue: 0,0:11:24.34,0:11:25.62,Main,Luffy,0,0,0,,Takma kafana ya!
Dialogue: 0,0:11:26.00,0:11:30.23,Main,Right Minister,0,0,0,,Hazine hırsızının hâlâ buralarda\Nolduğuna inanamıyorum.
Dialogue: 0,0:11:30.23,0:11:34.07,Main,Right Minister,0,0,0,,Normalde saraya habersiz\Nhamsi bile giremez...
Dialogue: 0,0:11:34.07,0:11:37.57,Main,Right Minister,0,0,0,,...ama savaş sırasında\Nkapılar ardına kadar açıktı tabii!
Dialogue: 0,0:11:37.57,0:11:41.41,Main,Right Minister,0,0,0,,Bakın mesela!\NŞu kulenin yarısını resmen kesmişler!
Dialogue: 0,0:11:41.41,0:11:44.87,Main,Right Minister,0,0,0,,Sanıyorum bunu biz yokken\No hırsız yaptı!
Dialogue: 0,0:11:45.87,0:11:48.94,Main,Pappagg,0,0,0,,Hayır, o kuleyi bu herif kesti!
Dialogue: 0,0:11:48.94,0:11:53.74,Main,Pappagg,0,0,0,,Kafesten kurtulur kurtulmaz önüne çıkan parmaklıklar olsun duvarlar olsun, ne varsa kesti geçti!
Dialogue: 0,0:11:53.74,0:11:56.36,Main,Zoro,0,0,0,,Parasını ödetmeseler bari şimdi,\Nsalak denizyıldızı seni!
Dialogue: 0,0:11:56.36,0:11:59.78,Main,Pappagg,0,0,0,,Ne vuruyo'n ya!? Ha yalan söylemişsin\Nha bir şey çalmışsın, ne fark var!?
Dialogue: 0,0:12:00.62,0:12:03.20,Main,Nami,0,0,0,,Dur bakalım az,\NSağ Bakan-chan...
Dialogue: 0,0:12:03.89,0:12:04.46,Main,Right Minister,0,0,0,,Chan mı?
Dialogue: 0,0:12:04.46,0:12:06.57,Main,Nami,0,0,0,,Hazine hırsızı dedin, değil mi?
Dialogue: 0,0:12:06.57,0:12:11.42,Main,Right Minister,0,0,0,,Evet senin de anlayacağın gibi,\No adam saraydaki tüm hazineyi çalmış.
Dialogue: 0,0:12:11.42,0:12:13.30,Main,Nami,0,0,0,,Ne?! Hazineyi mi çalmış!?
Dialogue: 0,0:12:13.30,0:12:15.34,Main,Luffy & Zoro,0,0,0,,Gidişatı hiç sevmedim!
Dialogue: 0,0:12:15.34,0:12:17.95,Main,Nami,0,0,0,,Ülkenize ait değil mi o hazine?\NPeşine düşmeyecek misiniz?
Dialogue: 0,0:12:17.95,0:12:22.97,Main,Neptune,0,0,0,,İnsanlarımın hayatlarının kurtarılışına şahit olduktan sonra hazine falan gözümde değil artık.
Dialogue: 0,0:12:22.97,0:12:23.90,Main,Nami,0,0,0,,Nasıl olmaz be?!
Dialogue: 0,0:12:24.87,0:12:27.06,Main,Nami,0,0,0,,Peki ya o hazineyi geri getirecek olsak?!
Dialogue: 0,0:12:27.06,0:12:32.21,Main,Neptune,0,0,0,,Hepsi sizin olabilir! Ülkemizi kurtarmış kişilere gitmesi çok daha iyi olur-jamon.
Dialogue: 0,0:12:32.21,0:12:34.59,Main,Nami,0,0,0,,Gerçekten mi?!
Dialogue: 0,0:12:35.74,0:12:38.43,Main,Nami,0,0,0,,Bana baksanıza siz!\NNeden adamı uzaya fırlattınız?!
Dialogue: 0,0:12:38.43,0:12:41.12,Main,Nami,0,0,0,,Şuracıkta dişlerini döküp, bağlayamadınız mı?
Dialogue: 0,0:12:41.58,0:12:43.17,Main,Sanji,0,0,0,,Kızınca Nami-san{\fscx250}-{\r}
Dialogue: 0,0:12:44.62,0:12:46.31,Main,Nami,0,0,0,,Gidin bulun şunu hemen!
Dialogue: 0,0:12:51.76,0:12:54.11,Main,Guard,0,0,0,,Kral-sama!
Dialogue: 0,0:12:54.11,0:12:57.06,Main,Guard,0,0,0,,Hodyler'de bir tuhaflık var!\NKelepçelerden kurtulmuşlar!
Dialogue: 0,0:12:57.06,0:12:58.91,Main,Neptune,0,0,0,,Ne olmuş?!
Dialogue: 0,0:13:04.99,0:13:09.33,Main,Hody,0,0,0,,Lanet olası insanlar!\NSize karşı olan kinimiz asla bitmeyecek!
Dialogue: 0,0:13:09.33,0:13:12.25,Main,Hody,0,0,0,,İntikamımızı alacağımız gün\Nelbet yine gelecek...
Dialogue: 0,0:13:14.62,0:13:18.97,Main,Hody,0,0,0,,Hasır Şapka'yı getirin bana!\NGeberteceğim onu!
Dialogue: 0,0:13:37.11,0:13:41.68,Main,Hyouzou,0,0,0,,Sarhoş muyum acaba?\NEklem yerlerim ağrıyor!
Dialogue: 0,0:13:44.30,0:13:46.29,Main,Zeo,0,0,0,,Ben bilerek böyle oldum!
Dialogue: 0,0:13:46.29,0:13:50.79,Main,Dosun,0,0,0,,Hasır Şapkalar'a bunun hesabını\Nsoracağım-fosun!
Dialogue: 0,0:13:56.75,0:14:00.24,Main,Ikaros,0,0,0,,İnsanların ölüm melekleri olacağız!
Dialogue: 0,0:14:00.24,0:14:01.82,Main,Jinbe,0,0,0,,Bu da ne ola ki böyle?!
Dialogue: 0,0:14:01.82,0:14:05.04,Main,Ryuuboshi,0,0,0,,Hodyler mi bunlar gerçekten?
Dialogue: 0,0:14:05.04,0:14:09.93,Main,Hody,0,0,0,,Beni parmaklıklar ardında tutabileceğinizi\Nsanmayın, aptal kraliyet ailesi sizi!
Dialogue: 0,0:14:11.73,0:14:13.54,Main,Hody,0,0,0,,Bu parmaklıkları ben...
Dialogue: 0,0:14:19.23,0:14:20.92,Main,Ikaros,0,0,0,,Kaptan Hody!
Dialogue: 0,0:14:23.51,0:14:25.75,Main,Fukaboshi,0,0,0,,Neler oluyor böyle?!
Dialogue: 0,0:14:25.75,0:14:30.56,Main,Right Minister,0,0,0,,Böyle olacağı belliydi!\Nİçtiğiniz o Enerji Steroidleri...
Dialogue: 0,0:14:30.56,0:14:34.47,Main,Right Minister,0,0,0,,...Tamate Kutusu'nun içinde tutulan\No efsanevi ilaçtandı, değil mi?
Dialogue: 0,0:14:34.75,0:14:36.44,Main,Nami,0,0,0,,Tamate Kutusu mu?
Dialogue: 0,0:14:36.44,0:14:40.12,Main,Neptune,0,0,0,,Nesilden nesile aktarılmış\Nulusal hazinemiz-jamon.
Dialogue: 0,0:14:40.32,0:14:42.55,Main,Right Minister,0,0,0,,İşin aslı 10 yıl önce,...
Dialogue: 0,0:14:42.55,0:14:47.51,Main,Right Minister,0,0,0,,...Tamate Kutusu'nun\Niçindekilerin çalındığı bir olay yaşanmıştı.
Dialogue: 0,0:14:47.51,0:14:54.00,Main,Right Minister,0,0,0,,Kimin yaptığını bulamamıştık ve Kral'ın emriyle iş çok büyümeden davayı kapatmak durumunda kalmıştık.
Dialogue: 0,0:14:54.00,0:14:55.73,Main,Right Minister,0,0,0,,Şimdi düşünüyorum da...
Dialogue: 0,0:14:55.73,0:14:59.73,Main,Right Minister,0,0,0,,...sen de orduyu o aralar terk etmiştin, Hody.
Dialogue: 0,0:15:04.18,0:15:08.45,Main,Hody,0,0,0,,Aynen öyle!\NBen çalmıştım!
Dialogue: 0,0:15:08.45,0:15:10.03,Main,Hody,0,0,0,,Beyinsizler sizi!
Dialogue: 0,0:15:10.76,0:15:15.21,Main,Neptune,0,0,0,,O efsanevi ilacın etkileri\Ntam olarak bilinmiyordu.
Dialogue: 0,0:15:15.21,0:15:19.06,Main,Neptune,0,0,0,,Kimilerine göre devasa bir\Ngüce kavuşturuyordu...
Dialogue: 0,0:15:19.06,0:15:23.74,Main,Neptune,0,0,0,,...kimilerine göreyse\Nkişiyi yaşlandıran bir ilaçtı.
Dialogue: 0,0:15:23.74,0:15:27.25,Main,Neptune,0,0,0,,Tuhaf bir ulusal hazineydi diyebiliriz.
Dialogue: 0,0:15:27.25,0:15:35.19,Main,Neptune,0,0,0,,Sanıyorum ilacı böylesine yakından korumalarının nedeni\Ndoğabilecek tehlikeleri engelleyebilmekti-jamon.
Dialogue: 0,0:15:35.19,0:15:38.38,Main,Neptune,0,0,0,,Sizler açılmaması gereken kutuyu açtınız...
Dialogue: 0,0:15:38.38,0:15:42.76,Main,Neptune,0,0,0,,...ve güç kazanmayı umduğunuz\Naptalca bir hayale tutuldunuz.
Dialogue: 0,0:15:44.72,0:15:46.76,Main,Hody,0,0,0,,Kapa çeneni, Neptune!
Dialogue: 0,0:15:50.60,0:15:54.87,Main,Neptune,0,0,0,,Bu şekilde intikam peşinde de\Nkoşamayacaklar.
Dialogue: 0,0:15:55.87,0:15:57.56,Main,Hody,0,0,0,,Kapa çeneni!
Dialogue: 0,0:15:57.56,0:16:01.71,Main,Hody,0,0,0,,Bizler seçilmiş intikamcılarız!
Dialogue: 0,0:16:01.71,0:16:05.63,Main,Hody,0,0,0,,Muhakkak tüm insanları, sizinle birlikte...
Dialogue: 0,0:16:05.63,0:16:09.01,Main,Hody,0,0,0,,...geberteceğiz!
Dialogue: 0,0:16:09.78,0:16:14.77,Main,Neptune,0,0,0,,Bu hallerine acıyorum.\NVe merhamet gösterme üzerine düşüneceğim.
Dialogue: 0,0:16:16.35,0:16:19.77,Main,Hody,0,0,0,,Fukaboshi, ırkımızın yüz karasısın!
Dialogue: 0,0:16:19.77,0:16:23.68,Main,Fukaboshi,0,0,0,,Annemi öldürmüş olsan da\Nsana karşı kin gütmeyeceğim.
Dialogue: 0,0:16:23.68,0:16:28.25,Main,Fukaboshi,0,0,0,,O yüzden yalvarıyorum, sus artık!
Dialogue: 0,0:16:29.41,0:16:32.87,Main,Fukaboshi,0,0,0,,Adadaki çocukların seni duymasını istemem.
Dialogue: 0,0:16:34.02,0:16:35.64,Main,Guard,0,0,0,,Sol Bakan'ım!
Dialogue: 0,0:16:37.25,0:16:41.44,Main,Guard,0,0,0,,Şeker fabrikasına Bay Pekoms'la\NBaron Tamago geldiler!
Dialogue: 0,0:16:42.32,0:16:46.35,Main,Left Minster,0,0,0,,Big Mom'ın adamları!\NGeldiler öyle mi!?
Dialogue: 0,0:16:46.35,0:16:49.28,Main,Guard,0,0,0,,Bu ay onlara verebileceğimiz\Nhiç şekerimiz kalmadı!
Dialogue: 0,0:16:49.28,0:16:52.28,Main,Guard,0,0,0,,Fabrikayı Hodyler yok ettiler...
Dialogue: 0,0:16:52.28,0:16:56.62,Main,Guard,0,0,0,,...eldeki hasar almamış şekerlemeleri de\N herkesin ortak isteğiyle...
Dialogue: 0,0:16:56.62,0:16:58.39,Main,Guard,0,0,0,,...Hasır Şapkalar'ın ziyafetine yollamıştık!
Dialogue: 0,0:17:03.04,0:17:04.84,Main,Left Minister,0,0,0,,Durumumuzu anlarlar mı ki?
Dialogue: 0,0:17:04.84,0:17:08.53,Main,Left Minister,0,0,0,,Şekerleme için koca bir ülkeyi\Nyakıp yıkabilecek bir yaratık...
Dialogue: 0,0:17:09.65,0:17:12.18,Main,Left Minister,0,0,0,,...Yonko...
Dialogue: 0,0:17:12.18,0:17:14.52,Main,Left Minister,0,0,0,,Big Mom!
Dialogue: 0,0:17:14.52,0:17:19.14,Narrator,Narrator,0,0,0,,En şatafatlı dakikalarının ardından\Nziyafet nihayetinde sona ermişti.
Dialogue: 0,0:17:19.14,0:17:22.90,Main,Usopp,0,0,0,,Ne?! Hazineyi bize mi verecekler?!
Dialogue: 0,0:17:22.90,0:17:24.25,Main,Chopper,0,0,0,,Vay canına!
Dialogue: 0,0:17:24.25,0:17:26.71,Main,Franky,0,0,0,,Çok iyi oldu bu bak!
Dialogue: 0,0:17:26.71,0:17:30.74,Main,Shirahoshi,0,0,0,,Luffy-samalar iyiler midir acaba,\NNami-chin-sama?
Dialogue: 0,0:17:30.74,0:17:31.89,Main,Nami,0,0,0,,Aman, bir şey olmaz onlara.
Dialogue: 0,0:17:31.89,0:17:34.82,Main,Franky,0,0,0,,Sonunda zengin korsanlar\Nolacağız demek?
Dialogue: 0,0:17:35.58,0:17:39.08,Main,Brook,0,0,0,,Hayat her zaman\Nbu kadar kolay olmuyor tabii...
Dialogue: 0,0:17:39.54,0:17:43.15,Main,Chopper,0,0,0,,Baksana Usopp,\Nbiz de gidip hırsızı arayalım mı?
Dialogue: 0,0:17:43.15,0:17:45.73,Main,Usopp,0,0,0,,Hiç bulaşmayalım bence!\NHem ben araştırdım.
Dialogue: 0,0:17:45.73,0:17:48.41,Main,Usopp,0,0,0,,Başına konan ödül 200 milyondan fazlaymış.
Dialogue: 0,0:17:48.41,0:17:51.11,Main,Chopper,0,0,0,,Ne?! Benimkisi 50 belicikken...
Dialogue: 0,0:17:52.07,0:17:54.11,Main,Luffy,0,0,0,,Şuraya bakın! Zoro, Sanji!
Dialogue: 0,0:17:54.11,0:17:56.83,Main,Luffy,0,0,0,,Bulduk adamı, acayip kolay oldu hem de!
Dialogue: 0,0:17:56.83,0:18:01.25,Main,Zoro,0,0,0,,Senin yumruk, dünyasını şaşırtmaya yetmiş zaten! \Nİki eğlenirdik diyordum!
Dialogue: 0,0:18:01.60,0:18:04.83,Main,Sanji,0,0,0,,Yalnız amma çok\Nganimet dağılmış etrafa!
Dialogue: 0,0:18:05.10,0:18:09.82,Main,Sanji,0,0,0,,Şu kıllı kral cidden hepsini\Nbize mi verecek şimdi?
Dialogue: 0,0:18:09.82,0:18:12.97,Main,Luffy,0,0,0,,İşte bu!\NBir sürü et alabiliriz!
Dialogue: 0,0:18:12.97,0:18:18.01,Main,Zoro,0,0,0,,Herif bunların hepsini o bataklık benzeri\Nvücuduna mı saklamış şimdi?!
Dialogue: 0,0:18:23.35,0:18:26.19,Main,All three,0,0,0,,Haydi bakalım, kaldıralım!
Dialogue: 0,0:18:28.61,0:18:30.19,Main,Luffy,0,0,0,,Tamamdır, Ryugu Sarayı'na yardıralım!
Dialogue: 0,0:18:30.19,0:18:31.53,Main,Zoro,0,0,0,,Nasıl yapacağız peki onu?
Dialogue: 0,0:18:31.53,0:18:32.87,Main,Sanji,0,0,0,,Uçan balık lazım bize.
Dialogue: 0,0:18:32.87,0:18:35.14,Main,Luffy,0,0,0,,Şehir hangi tarafta kalıyordu, Zoro?
Dialogue: 0,0:18:35.14,0:18:36.29,Main,Zoro,0,0,0,,Şu tarafta.
Dialogue: 0,0:18:36.29,0:18:37.99,Main,Sanji,0,0,0,,Peki öyleyse, tam tersi tarafa gidelim.
Dialogue: 0,0:18:37.99,0:18:38.95,Main,Zoro,0,0,0,,Lan!
Dialogue: 0,0:18:41.94,0:18:44.37,Main,Pekoms,0,0,0,,Anlıyorsun değil mi, Sol Bakanı?
Dialogue: 0,0:18:44.37,0:18:47.03,Main,Left Minister,0,0,0,,Lütfen biraz olsun merhamet edin!
Dialogue: 0,0:18:47.03,0:18:51.48,Main,Left Minister,0,0,0,,Hiç planda olmayan bir durum sonucu\NHody tayfası fabrikayı yıkınca...
Dialogue: 0,0:18:51.48,0:18:55.43,Main,Pekoms,0,0,0,,Böyle mazeretler\Nbizi zerre ilgilendirmiyor-gao!
Dialogue: 0,0:18:55.43,0:19:00.04,Main,Pekoms,0,0,0,,Biraz kendime de ayırırım diye planlamıştım \No yüzden zaten çok açım!
Dialogue: 0,0:19:00.04,0:19:02.89,Main,Pekoms,0,0,0,,Ayda bir hazırlayacağınız\Nşekerlemeler karşılık...
Dialogue: 0,0:19:02.89,0:19:06.12,Main,Pekoms,0,0,0,,...Mama'nın ismini kullanacaktınız.
Dialogue: 0,0:19:06.12,0:19:08.81,Main,Pekoms,0,0,0,,Anlaşmamız böyle değil miydi-gao?!
Dialogue: 0,0:19:10.80,0:19:15.18,Main,Pekoms,0,0,0,,İş ortakları olduğumuzdan böyle bir şeyi\Nsöylemek istemezdim size ama...
Dialogue: 0,0:19:15.18,0:19:17.33,Main,Pekoms,0,0,0,,...Mama'nın ne kadar korkutucu\Nolabileceğini biliyorsunuzdur!
Dialogue: 0,0:19:17.33,0:19:20.03,Main,Pekoms,0,0,0,,Kızdıracak olursanız hepinizi...
Dialogue: 0,0:19:21.06,0:19:23.02,Main,Pekoms,0,0,0,,...yok eder!
Dialogue: 0,0:19:23.02,0:19:25.41,Thoughts,Citizen,0,0,0,,Böyle yapınca acayip şirin oluyor!
Dialogue: 0,0:19:25.41,0:19:27.68,Main,Pekoms,0,0,0,,Ne yapacaksınız peki şimdi-gao!?
Dialogue: 0,0:19:28.36,0:19:29.82,Main,Luffy,0,0,0,,Millet toplanmış.
Dialogue: 0,0:19:33.66,0:19:36.43,Main,Luffy,0,0,0,,Aha, şeker fabrikasıydı burası!\NPappag söylemişti.
Dialogue: 0,0:19:36.43,0:19:39.77,Main,Zoro,0,0,0,,Öyle mi?\NUçan balık bulabilirsek iyi olur.
Dialogue: 0,0:19:39.77,0:19:43.47,Main,Luffy,0,0,0,,Dün yediğim o leziz şekerlemeleri\Nburada yapıyorlar desene!
Dialogue: 0,0:19:43.47,0:19:45.93,Main,Luffy,0,0,0,,Selam şeker fabrikası!
Dialogue: 0,0:19:46.92,0:19:49.58,Main,Citizen,0,0,0,,Hasır Şapkalı Luffy bu!
Dialogue: 0,0:19:49.58,0:19:53.20,Main,Citizen,0,0,0,,Luffy-san, ziyafeti bitirdiniz mi?!
Dialogue: 0,0:19:53.20,0:19:55.65,Main,Left Minister,0,0,0,,Luffy-kun, burada ne arıyorsunuz?
Dialogue: 0,0:19:55.65,0:19:58.57,Main,Luffy,0,0,0,,Evet, ölesiye yedim!
Dialogue: 0,0:19:58.57,0:20:03.79,Main,Luffy,0,0,0,,Etler mükemmeldi ama Balık Adam Adası\Nşekerlemelerinin üstüne tanımam!
Dialogue: 0,0:20:06.94,0:20:08.37,Main,Pekoms,0,0,0,,Ne?!
Dialogue: 0,0:20:09.83,0:20:11.98,Main,Citizen,0,0,0,,Aman o konuya, Hasır Şapka-san...
Dialogue: 0,0:20:11.98,0:20:13.51,Thoughts,Citizen,0,0,0,,Hiç girmeyin!
Dialogue: 0,0:20:13.51,0:20:17.20,Main,Luffy,0,0,0,,Sen de mi buradaydın\NYayın Balığı amca?!
Dialogue: 0,0:20:17.20,0:20:20.82,Main,Pekoms,0,0,0,,Şekerleme mi dedi o?!\NKim bunlar!?
Dialogue: 0,0:20:25.04,0:20:28.69,Main,Pekoms,0,0,0,,Tabii ya, Hasır Şapkalı Luffy bu!\NHiç şüphe yok!
Dialogue: 0,0:20:28.69,0:20:32.00,Main,Pekoms,0,0,0,,Ün salmış bu korsan ne arar burada?
Dialogue: 0,0:20:32.00,0:20:33.23,Main,Left Minister,0,0,0,,Şey, o konuda...
Dialogue: 0,0:20:33.23,0:20:37.38,Main,Pekoms,0,0,0,,Bana bak velet!\NNe şekerlemesiymiş onlar öyle?!
Dialogue: 0,0:20:37.38,0:20:39.60,Main,Left Minister,0,0,0,,Şey, Pekoms-shii, izin verirseniz...
Dialogue: 0,0:20:39.60,0:20:42.60,Main,Luffy,0,0,0,,Sen de kimsin be?! \NBalık adam değilsin, değil mi?
Dialogue: 0,0:20:42.60,0:20:44.21,Main,Luffy,0,0,0,,Şekerleme almaya mı geldin?
Dialogue: 0,0:20:44.21,0:20:47.82,Main,Luffy,0,0,0,,Daha dün akşam kusana kadar\Nyemiştim ben onlardan!
Dialogue: 0,0:20:47.82,0:20:49.33,Main,Pekoms,0,0,0,,Ne dedin sen?!
Dialogue: 0,0:20:49.33,0:20:53.59,Main,Pekoms,0,0,0,,Bu da ne demek böyle?!\NŞekerlemeleri yedim diyor bu!
Dialogue: 0,0:20:55.05,0:20:58.13,Main,Left Minister,0,0,0,,Şe-Şe-Şey...\NO konuyu açıklayabilirim...
Dialogue: 0,0:20:58.13,0:21:01.05,Main,Luffy,0,0,0,,Yok artık, aslan konuşuyor resmen!
Dialogue: 0,0:21:01.05,0:21:04.42,Main,Luffy,0,0,0,,Neyse gerçi,\Nbizde de benzer bir şey vardı.
Dialogue: 0,0:21:05.51,0:21:06.77,Main,Tamago,0,0,0,,Pekoms.
Dialogue: 0,0:21:06.77,0:21:12.05,Main,Tamago,0,0,0,,Böyle tehditkâr ifadelerin şekerlemeleri\Nalmada bize hiçbir faydası dokunmaz.
Dialogue: 0,0:21:16.65,0:21:19.19,Main,Tamago,0,0,0,,İşi barışçıl şekilde çözelim istiyorum-soir.
Dialogue: 0,0:21:19.19,0:21:21.64,Main,Tamago,0,0,0,,Çay partimize daha dört gün var-bon.
Dialogue: 0,0:21:21.64,0:21:25.91,Main,Tamago,0,0,0,,Yani yarın sabah dahi yola çıksak,\Npartiye yetişebiliriz-jour.
Dialogue: 0,0:21:26.10,0:21:29.14,Main,Luffy,0,0,0,,Al tuhaf biri daha! Sen kimsin?
Dialogue: 0,0:21:31.75,0:21:35.66,Main,Tamago,0,0,0,,Tanıştığımıza mem-bon oldum,\Naz pişmiş korsan ahalisi!
Dialogue: 0,0:21:35.66,0:21:40.16,Main,Tamago,0,0,0,,Bendeniz Baron Tamago-soir!
Dialogue: 0,0:21:35.66,0:21:40.16,Note,Tamago,0,0,0,,{\fad(100,100)}Tamago: Yumurta
Dialogue: 0,0:21:40.16,0:21:41.70,Main,Luffy,0,0,0,,Yumurta mı?
Dialogue: 0,0:21:44.66,0:21:48.81,Main,Tamago,0,0,0,,İsmimi unutmamanızı öneririm-s'il vous plait!
Dialogue: 0,0:21:52.96,0:21:55.38,Main,Tamago,0,0,0,,O değil de...
Dialogue: 0,0:21:57.15,0:22:03.22,Main,Tamago,0,0,0,,...az önce bu fabrikanın şekerlemelerini yediğinizi söylemiştiniz, değil mi-c'est si bon?
Dialogue: 0,0:22:03.22,0:22:04.41,Main,Zoro,0,0,0,,Adam pusulaya benziyor!
Dialogue: 0,0:22:04.41,0:22:08.10,Main,Luffy,0,0,0,,Yedik harbiden!\NVarsa daha da yemek isterim hatta!
Dialogue: 0,0:22:08.56,0:22:12.52,Main,Tamago,0,0,0,,Yokmuş ki böyle bir çıkmazdayız-bon!
Dialogue: 0,0:22:14.98,0:22:23.32,Main,Tamago,0,0,0,,Fabrikanın önünde asılı bu koca şekil patronumuzun yani büyük korsan Charlotte Linlin'in korsan bayrağıdır-soir.
Dialogue: 0,0:22:23.32,0:22:28.65,Main,Tamago,0,0,0,,O bayrak bölgenin, Yonko Big Mom'ın \Nbölgesi olduğuna işaret ediyor.
Dialogue: 0,0:22:28.65,0:22:35.23,Main,Tamago,0,0,0,,Ki bu da demektir ki, Balık Adam Adası\NBig Mom'ın adıyla korunmakta-bon!
Dialogue: 0,0:22:35.23,0:22:39.11,Main,Luffy,0,0,0,,Amma iyi birisiymiş o zaman! \NTanışmak isterdim onunla!
Dialogue: 0,0:22:39.11,0:22:40.08,Main,Luffy,0,0,0,,Big Mom demek?
Dialogue: 0,0:22:41.03,0:22:44.80,Main,Tamago,0,0,0,,Yanlış anlaşılmak istemem,\Nticaretten bahsediyorum burada.
Dialogue: 0,0:22:45.99,0:22:49.10,Main,Tamago,0,0,0,,Aylık 10 ton şekerleme karşılığında...
Dialogue: 0,0:22:49.10,0:22:53.05,Main,Tamago,0,0,0,,...o bayrağı oraya koymalarına\Nizin veriyoruz-bon.
Dialogue: 0,0:22:53.52,0:22:54.56,Main,Luffy,0,0,0,,10 ton mu?
Dialogue: 0,0:22:54.56,0:23:01.32,Main,Tamago,0,0,0,,Aynen öyle! Mama tatlı şekerlemeleri\Nher şeylerden çok sever-soir.
Dialogue: 0,0:23:01.32,0:23:05.70,Main,Tamago,0,0,0,,Balık Adam Adasının şekerlemeleriyse\Nözellikle en sevdikleridir.
Dialogue: 0,0:23:06.24,0:23:09.39,Main,Tamago,0,0,0,,O yüzden de\Nyarın sabaha kadar bekleyeceğiz!
Dialogue: 0,0:23:09.39,0:23:15.46,Main,Left Minister,0,0,0,,Şey, Baron'um... İzah etmeye çalıştığım gibi fabrikanın büyük pişirme aletleri hasar almış vaziyette...
Dialogue: 0,0:23:15.46,0:23:20.16,Main,Left Minister,0,0,0,,...ve onları onarmak için de en azından\Niki haftaya ihtiyacımız var.
Dialogue: 0,0:23:20.16,0:23:21.80,Main,Tamago,0,0,0,,Öyle bir şey mümkün değil-soir.
Dialogue: 0,0:23:21.80,0:23:25.72,Main,Sanji,0,0,0,,Baksana bana Yumurta!\NBekleseniz ölür müsünüz?!
Dialogue: 0,0:23:25.72,0:23:30.90,Main,Zoro,0,0,0,,Patronunuzun beyni incileriyle yarışır küçüklükte falan mı? Şu Yonko dediğiniz korsan herif!
Dialogue: 0,0:23:30.90,0:23:36.72,Main,Tamago,0,0,0,,Herif değil o!\NMama büyük bir kadın korsandır-vous plait!
Dialogue: 0,0:23:36.72,0:23:39.40,Main,Tamago,0,0,0,,İncileri olduğunu sanmıyorum-jour.
Dialogue: 0,0:23:39.40,0:23:41.94,Main,Sanji,0,0,0,,Hadi ya, hanımefendi öyle mi?
Dialogue: 0,0:23:43.09,0:23:48.97,Thoughts,Sanji's imagination is not a very good actor,0,0,0,,Şekerlemeleri çok severim!\NVe şekerleme yapabildiğin için de seni!
Dialogue: 0,0:23:51.62,0:23:54.81,Main,Sanji,0,0,0,,Zamanında götüremezseniz ne olacak peki?
Dialogue: 0,0:23:55.81,0:23:57.19,Main,Tamago,0,0,0,,Öyle bir durumda...
Dialogue: 0,0:24:00.23,0:24:02.65,Main,Tamago,0,0,0,,...anlaşma bozulmuş olur!
Dialogue: 0,0:24:02.65,0:24:11.26,Main,Tamago,0,0,0,,Acımasız Big Mom korsanları Balık Adam Adasını \Nsaniyesinde yerle bir ederler-vous plait!
Dialogue: 0,0:24:12.18,0:24:14.49,Main,Luffy,0,0,0,,Yerle bir mi ederler dedin?!
Dialogue: 0,0:24:14.49,0:24:18.60,Main,Luffy,0,0,0,,Aptal mısınız be siz?\NŞeker vermediler diye ülke mi yıkılırmış!
Dialogue: 0,0:24:18.60,0:24:21.25,Main,Luffy,0,0,0,,Daha yeni kurtardık be bu adayı!
Dialogue: 0,0:24:42.54,0:24:44.73,Main,Pirate,0,0,0,,Mutluluğuna diyecek yok gibi, Mama?
Dialogue: 0,0:24:46.19,0:24:51.72,Main,Big Mam,0,0,0,,{\an8}Dört gün sonraki çay partisini\Ndört gözle bekliyorum da ondan...
Dialogue: 0,0:24:55.87,0:25:02.25,Main,Big Mam,0,0,0,,Gene o leziz mi leziz Balık Adam Adası\Nşekerlemelerinden yiyeceğim!
Dialogue: 0,0:25:02.25,0:25:06.13,Main,Big Mam,0,0,0,,Öyle bir bekleme ki bu, midem şimdiden\Nsindirime hazırlanmaya başladı bile!
Dialogue: 0,0:25:06.13,0:25:09.59,Main,Pirate,0,0,0,,Bekleme! Bekleme!\NBalık Adam Adasından şekerleme!
Dialogue: 0,0:25:09.59,0:25:12.24,Main,Big Mam,0,0,0,,Siz de mi dört gözle bekliyorsunuz?
Dialogue: 0,0:25:12.24,0:25:15.93,Main,Pirate,0,0,0,,Elbette bekliyoruz!\NAcayipler çünkü!
Dialogue: 0,0:25:15.93,0:25:20.78,Main,Big Mam,0,0,0,,Öyleyse beklemenize\Nmidemin içinde devam edin!
Dialogue: 0,0:25:50.40,0:25:51.67,Main,Bobbin,0,0,0,,Mama!
Dialogue: 0,0:25:52.59,0:25:54.55,Main,Bobbin,0,0,0,,Ben geldim, boyoyoyon!
Dialogue: 0,0:25:55.55,0:25:59.47,Main,Big Mam,0,0,0,,Nasıl gitti peki, Bobbin?
Dialogue: 0,0:25:59.47,0:26:00.93,Main,Bobbin,0,0,0,,Hepsini paçavraya çevirip,\Nmekanı da yakıp yıktım!
Dialogue: 0,0:26:00.93,0:26:08.00,Main,Big Mam,0,0,0,,Ne güzel de yapmışsın!\NO ülkenin fırın işçiliği mükemmeldi!
Dialogue: 0,0:26:08.00,0:26:12.07,Main,Big Mam,0,0,0,,Ülkeleri yanarken aynı mükemmellikte\Nkokmuştur kesin!
Dialogue: 0,0:26:12.61,0:26:14.84,Main,Big Mam,0,0,0,,Yazık oldu ama\Nbize başka seçenek bırakmamışlardı.
Dialogue: 0,0:26:14.84,0:26:18.72,Main,Big Mam,0,0,0,,Söz verdikleri miktarı\Nzamanında toparlayamamışlardı!
Dialogue: 0,0:26:19.72,0:26:21.83,Main,Bobbin,0,0,0,,Atıştırmalık bir şeyler var mı?
Dialogue: 0,0:26:21.83,0:26:25.87,Main,Big Mam,0,0,0,,Bize şekerleme vermezlerse\Nonları da öldürmemiz gerekecek!
Dialogue: 0,0:26:25.87,0:26:29.49,Main,Big Mam,0,0,0,,Söz verip de sözünü tutmayan\Ninsanlardan nefret ederim!
Dialogue: 0,0:26:29.49,0:26:33.67,Main,Big Mam,0,0,0,,Aynı acı şekerlerden nefret ettiğim gibi!
Dialogue: 0,0:26:33.67,0:26:34.90,Main,Bobbin,0,0,0,,Bir de sanırım...
Dialogue: 0,0:26:34.90,0:26:38.05,Main,Bobbin,0,0,0,,...Balık Adam Adası\Nbu ayki şekerlemeleri yollayamayabilirmiş.
Dialogue: 0,0:26:41.80,0:26:44.20,Main,Bobbin,0,0,0,,Az önce Pekoms aramıştı da...
Dialogue: 0,0:26:44.20,0:26:46.50,Main,Bobbin,0,0,0,,Balık Adam adasını da yakayım mı?
Dialogue: 0,0:26:53.72,0:26:58.61,Main,Big Mam,0,0,0,,Balık Adam Adasının şekerlemelerinden\Nyiyemeyecek miyim?!
Dialogue: 0,0:26:58.61,0:27:01.83,Main,Big Mam,0,0,0,,Derhal Den Den Mushi'yle\Nbağla şunları bana!
Dialogue: 0,0:27:04.71,0:27:07.10,Main,Pekoms,0,0,0,,Mama bu kesin-gao!
Dialogue: 0,0:27:07.10,0:27:09.17,Main,Pekoms,0,0,0,,Az önce durumu bildirmiştim!
Dialogue: 0,0:27:10.33,0:27:12.32,Main,Citizen,0,0,0,,Bi-Big Mom mı arıyor?!
Dialogue: 0,0:27:23.41,0:27:25.54,Main,Tamago,0,0,0,,Açsana, Pekoms!
Dialogue: 0,0:27:26.96,0:27:31.42,Main,Pekoms,0,0,0,,Sen neden açmıyorsun-gao?\NLaf yemek istemiyorum şimdi!
Dialogue: 0,0:27:33.72,0:27:34.88,Main,Luffy,0,0,0,,Alo?
Dialogue: 0,0:27:34.88,0:27:35.92,Main,Tamago & Pekoms,0,0,0,,Lan?!
Dialogue: 0,0:27:37.11,0:27:39.84,Main,Citizen,0,0,0,,{\i1}Neee?!
Dialogue: 0,0:27:40.99,0:27:43.72,Main,Luffy,0,0,0,,Big Mom mısın sen?
Dialogue: 0,0:27:43.72,0:27:46.06,Main,Tamago & Pekoms,0,0,0,,{\i1}Hey, hey, hey, hey!
Dialogue: 0,0:27:46.06,0:27:49.44,Main,Big Mam,0,0,0,,Tamago değilsin sen, değil mi?\NPekoms da değilsin.
Dialogue: 0,0:27:50.52,0:27:51.40,Main,Big Mam,0,0,0,,Kimsin sen?
Dialogue: 0,0:27:51.40,0:27:56.01,Main,Luffy,0,0,0,,Ben Monkey D. Luffy,\NKorsanlar Kralı olacak adamım!
Dialogue: 0,0:27:56.01,0:27:57.24,Main,Tamago & Pekoms,0,0,0,,Lan, lan, lan, lan, lan, lan!
Dialogue: 0,0:27:58.51,0:28:00.43,Main,Left Minister,0,0,0,,Luffy-kun!
Dialogue: 0,0:28:00.43,0:28:02.16,Main,Citizen,0,0,0,,Hasır Şapka-san...
Dialogue: 0,0:28:02.16,0:28:06.31,Main,Big Mam,0,0,0,,Monkey D. mi?
Dialogue: 0,0:28:07.04,0:28:12.40,Main,Big Mam,0,0,0,,Garp'ın torunu olan, değil mi!?
Dialogue: 0,0:28:12.40,0:28:14.24,Main,Big Mam,0,0,0,,Hatırladım bak şimdi!
Dialogue: 0,0:28:15.22,0:28:20.40,Main,Big Mam,0,0,0,,İki yıl önceki savaşa karışmış\Nveletsin sen, değil mi?
Dialogue: 0,0:28:20.40,0:28:22.14,Main,Luffy,0,0,0,,Şeker meker yok!
Dialogue: 0,0:28:22.14,0:28:24.03,Main,Luffy,0,0,0,,Hepsini ben yedim!
Dialogue: 0,0:28:24.03,0:28:28.63,Main,Big Mam,0,0,0,,Gerçekten yok öyle mi!?\N10 ton hazırlamaları lazımdı ama!
Dialogue: 0,0:28:28.63,0:28:31.14,Main,Luffy,0,0,0,,10 tonun hepsini de ben yedim!
Dialogue: 0,0:28:35.43,0:28:38.13,Main,Citizen,0,0,0,,Hasır Şapka-san,\Nbu kadar abartmanıza gerek yok!
Dialogue: 0,0:28:38.13,0:28:40.63,Main,Tamago,0,0,0,,Ne yapmaya çalışıyor bu?!
Dialogue: 0,0:28:45.24,0:28:49.74,Main,Big Mam,0,0,0,,Aptallaşmasana!\NYalan konuşma bana!
Dialogue: 0,0:28:49.74,0:28:53.46,Main,Big Mom,0,0,0,,Balık Adamları korumaya çalışıyorsun, değil mi?
Dialogue: 0,0:28:53.46,0:28:55.61,Main,Luffy,0,0,0,,Yediğim doğrudur!
Dialogue: 0,0:28:55.61,0:28:58.03,Main,Luffy,0,0,0,,Sana ayırdıklarını bilmiyordum!
Dialogue: 0,0:28:58.26,0:29:00.80,Main,Luffy,0,0,0,,Yanımızda büyük bir hazine taşıyoruz.
Dialogue: 0,0:29:01.80,0:29:05.83,Main,Luffy,0,0,0,,Hepsini sana vereyim,\Nbu ay şekerlemelerini unut!
Dialogue: 0,0:29:05.83,0:29:07.23,Main,Pekoms & Tamago,0,0,0,,Hazine mi?!
Dialogue: 0,0:29:07.23,0:29:11.33,Main,Big Mam,0,0,0,,Ha?! Hazine yenir mi be?!
Dialogue: 0,0:29:11.33,0:29:14.02,Main,Big Mam,0,0,0,,Tatlı şekerlerden yemek istiyorum ben!
Dialogue: 0,0:29:14.97,0:29:18.44,Main,Tamago,0,0,0,,Durun biraz,\Nhepsi hazine mi onların?
Dialogue: 0,0:29:18.44,0:29:19.36,Main,Luffy,0,0,0,,Evet, öyle.
Dialogue: 0,0:29:22.86,0:29:25.97,Main,Tamago,0,0,0,,Mama, Tamago konuşuyor!\NBiraz düşünelim bunu!
Dialogue: 0,0:29:25.97,0:29:33.69,Main,Tamago,0,0,0,,İki gün önce Kaptan Kid denen velet müttefiklerimizin iki gemisini batırmıştı-bon!
Dialogue: 0,0:29:33.69,0:29:40.07,Main,Tamago,0,0,0,,Kaybımız büyüktü ve açık konuşmak gerekirse \Nson zamanlarda paraya olan ihtiyacımız da arttı-bon.
Dialogue: 0,0:29:40.32,0:29:44.49,Main,Tamago,0,0,0,,Bu nedenle de şekerleme keyfini\Nbirkaç haftalığına askıya alsak da...
Dialogue: 0,0:29:44.49,0:29:51.13,Main,Tamago,0,0,0,,...şimdilik hazineyi alarak onları affetme\Nşeklinde bir şey yapsak nasıl olur-jour?
Dialogue: 0,0:29:51.13,0:29:57.21,Main,Tamago,0,0,0,,Şekerleme istiyorsanız madem, \Ngelirken yolda tatlı bir şeyler alırız onun yerine.
Dialogue: 0,0:29:58.01,0:30:01.40,Main,Big Mam,0,0,0,,Hadi oradan be, Tamago!
Dialogue: 0,0:30:01.40,0:30:04.44,Main,Big Mam,0,0,0,,Böyle rezil bir şeyi nasıl söylersin?!
Dialogue: 0,0:30:04.44,0:30:07.85,Main,Big Mam,0,0,0,,Korsanların istediği şeylerden\Ntaviz verdiği nerede görülmüş?!
Dialogue: 0,0:30:07.85,0:30:09.85,Main,Tamago,0,0,0,,Özür dilerim-soir.
Dialogue: 0,0:30:12.16,0:30:13.20,Main,Big Mam,0,0,0,,Demiş olsam da...
Dialogue: 0,0:30:16.88,0:30:21.57,Main,Big Mam,0,0,0,,...bana diklenen o velet\Nepey ilgimi çekti.
Dialogue: 0,0:30:22.34,0:30:26.72,Main,Big Mam,0,0,0,,Öyle olsun madem, bu seferki hıncımı...
Dialogue: 0,0:30:26.72,0:30:30.64,Main,Big Mam,0,0,0,,...Balık Adam Adası yerine sizlerden alacağım!
Dialogue: 0,0:30:33.37,0:30:36.83,Main,Big Mam,0,0,0,,Monkey D. Luffy...
Dialogue: 0,0:30:36.83,0:30:39.29,Main,Big Mam,0,0,0,,Bu ismi unutmayacağım.
Dialogue: 0,0:30:39.67,0:30:42.85,Main,Big Mam,0,0,0,,Yeni Dünya'da bekliyorum!
Dialogue: 0,0:30:47.16,0:30:48.96,Main,Left Minister,0,0,0,,Luffy-kun!
Dialogue: 0,0:30:53.01,0:30:55.04,Main,Luffy,0,0,0,,Elbette, bekle tabii!
Dialogue: 0,0:30:55.77,0:30:58.03,Main,Luffy,0,0,0,,Benim de seninle sorulacak\Nbir hesabım var artık.
Dialogue: 0,0:30:58.03,0:31:00.04,Main,Big Mam,0,0,0,,Ha?
Dialogue: 0,0:31:01.81,0:31:05.76,Main,Luffy,0,0,0,,Sana emanet etmek\Nçok tehlikeli olacak orası belli!
Dialogue: 0,0:31:08.71,0:31:12.63,Main,Luffy,0,0,0,,Yeni Dünya'da canına okuyup...
Dialogue: 0,0:31:18.02,0:31:21.67,Main,Luffy,0,0,0,,...Balık Adam Adasını kendi bölgem yapacağım!
Dialogue: 0,0:00:02.99,0:00:08.38,Main,,0,0,0,,Dünyanın sunabileceği her şeyi elde eden adam, Korsanlar Kralı Gold Roger.
Dialogue: 0,0:00:08.38,0:00:13.00,Main,,0,0,0,,Son sözleri dünyanın her yerinden\Nmaceracıları denize çekti.
Dialogue: 0,0:00:13.00,0:00:14.68,Main,,0,0,0,,"Hazinem mi?"
Dialogue: 0,0:00:14.68,0:00:16.22,Main,,0,0,0,,"İstiyorsanız, size vereceğim!"
Dialogue: 0,0:00:16.22,0:00:17.42,Main,,0,0,0,,"Arayın ve bulun!"
Dialogue: 0,0:00:17.42,0:00:19.87,Main,,0,0,0,,"Bu dünyanın sunabileceği her şeyi orada bıraktım!"
Dialogue: 0,0:00:19.87,0:00:22.69,Main,,0,0,0,,Korsanlar hayallerinin peşinden yola çıktılar!
Dialogue: 0,0:00:22.69,0:00:25.35,Main,,0,0,0,,Dünya, Büyük Korsan Çağı'na girdi!
Dialogue: 0,0:00:25.35,0:00:29.31,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪
Dialogue: 0,0:00:29.31,0:00:33.81,We Go lyrics,,0,0,0,,♪ Şafak vakti gelmedi bile ve ben bekleyemiyorum! ♪
Dialogue: 0,0:00:33.81,0:00:37.48,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı, dört... Gidelim! ♪
Dialogue: 0,0:00:38.97,0:00:43.05,We Go lyrics,,0,0,0,,♪ Bayrağımızı dalgalandıralım, macera şafağının doğuşuna. ♪
Dialogue: 0,0:00:44.41,0:00:49.74,We Go lyrics,,0,0,0,,♪ Dalgalar yapalım, bizi uykumuzdan kaldırsınlar. ♪
Dialogue: 0,0:00:49.74,0:00:54.28,We Go lyrics,,0,0,0,,♪ Eğer inanılmaz bir dünyaya gitmek istiyorsan,
Dialogue: 0,0:00:54.28,0:00:58.79,We Go lyrics,,0,0,0,, gerekli olan şey senin dayanıklılığın. ♪
Dialogue: 0,0:00:59.11,0:01:01.73,We Go lyrics,,0,0,0,,♪ Fazla dikkat çekmek, bu bir suç mu? ♪
Dialogue: 0,0:01:01.73,0:01:04.62,We Go lyrics,,0,0,0,,♪ Aranıyor → Kazanan demektir! ♪
Dialogue: 0,0:01:04.62,0:01:10.50,We Go lyrics,,0,0,0,,♪ Özgür olmak bizim tek kuralımız! ♪
Dialogue: 0,0:01:10.50,0:01:15.99,We Go lyrics,,0,0,0,,♪ Endişelerinizi unutun, bırakın rüzgar essin. ♪
Dialogue: 0,0:01:15.99,0:01:18.53,We Go lyrics,,0,0,0,,♪ Ne pahasına olursa olsun, One Piece'i ilk biz bulacağız! ♪
Dialogue: 0,0:01:18.53,0:01:22.66,We Go lyrics,,0,0,0,,♪ Hayal kuran kalplerimiz, çok büyük... ♪
Dialogue: 0,0:01:22.66,0:01:26.93,We Go lyrics,,0,0,0,,♪ Onları uyandırmamak önemli. ♪
Dialogue: 0,0:01:26.93,0:01:29.57,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪
Dialogue: 0,0:01:29.57,0:01:33.54,We Go lyrics,,0,0,0,,♪ Şafak vakti gelmedi bile ve ben bekleyemiyorum! ♪
Dialogue: 0,0:01:33.54,0:01:37.33,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı, dört... Gidelim! ♪
Dialogue: 0,0:01:38.76,0:01:44.72,We Go lyrics,,0,0,0,,♪ Biz... buralara kadar geldik. ♪
Dialogue: 0,0:01:44.72,0:01:47.62,We Go lyrics,,0,0,0,,♪ Gideceğiz... hayallerimizin olduğu yere,
Dialogue: 0,0:01:47.62,0:01:52.70,We Go lyrics,,0,0,0,, ve kimseyi arkada bırakmayacağız. ♪
Dialogue: 0,0:01:52.70,0:01:55.30,We Go lyrics,,0,0,0,,♪ Hep devam edeceğiz, bu bir söz. ♪
Dialogue: 0,0:01:55.30,0:01:59.47,We Go lyrics,,0,0,0,,♪ Hayallerimizin başladığı o günden beri,
Dialogue: 0,0:01:59.47,0:02:03.72,We Go lyrics,,0,0,0,, belirlediğimiz gelecek, değişmedi! ♪
Dialogue: 0,0:02:03.72,0:02:06.24,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪
Dialogue: 0,0:02:06.24,0:02:10.61,We Go lyrics,,0,0,0,,♪ Kalbimdeki güneş, asla batmayacak! ♪
Dialogue: 0,0:02:10.61,0:02:13.38,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... ♪
Dialogue: 0,0:02:14.78,0:02:17.57,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... ♪
Dialogue: 0,0:02:18.75,0:02:24.82,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... dört... Gidelim! ♪
Dialogue: 0,0:02:27.27,0:02:29.74,We Go lyrics,,0,0,0,,♪ Gidelim! ♪
