Dialogue: 0,0:02:29.86,0:02:39.18,Title,,0,0,0,,{\fad(2000,200)}Tiger'ın Şok Edici Sırrı!
Dialogue: 0,0:02:41.94,0:02:46.25,Main,Fishman,0,0,0,,{\an8}Nihayet Koala'nın memleketini \Nişaret eden bir Daimi Pusula'yı bulduk.
Dialogue: 0,0:02:42.36,0:02:46.14,Captions,,0,0,0,,{\fad(300,0)}12 yıl önce, Grand Line
Dialogue: 0,0:02:46.25,0:02:49.13,Main,Hachi,0,0,0,,Nyuu- Koala, memleketine dönebilirsin!
Dialogue: 0,0:02:49.77,0:02:51.18,Main,Koala,0,0,0,,Uh... Şey...
Dialogue: 0,0:02:56.46,0:02:58.28,Main,Hachi,0,0,0,,Cidden çok değiştin. Seni zor tanıyorum.
Dialogue: 0,0:02:58.28,0:03:01.76,Main,Hachi,0,0,0,,{\an8}Daha kadınsı oldun.
Dialogue: 0,0:02:59.18,0:03:03.06,Captions,,0,0,0,,{\fad(300, 0)}Koala (Eski köle kız)
Dialogue: 0,0:03:03.25,0:03:05.52,Main,Koala,0,0,0,,Ben böyle şeylere...
Dialogue: 0,0:03:09.62,0:03:13.33,Main,Hachi,0,0,0,,Ne? Sonunda sana uygun kıyafetler\Nbulduk ama beğenmiyor musun?
Dialogue: 0,0:03:14.68,0:03:18.83,Main,Hachi,0,0,0,,Saçını bile kestik. Bu şekilde annenin\Ndaha çok hoşuna gideceğine eminim.
Dialogue: 0,0:03:19.51,0:03:20.17,Main,Koala,0,0,0,,Ben...
Dialogue: 0,0:03:22.64,0:03:24.00,Main,Koala,0,0,0,,...temizlik yapmalıyım.
Dialogue: 0,0:03:25.04,0:03:29.09,Main,Hachi,0,0,0,,Nyuu- endişelendiğin zaman\Nçalışma huyundan kurtulmalısın artık!
Dialogue: 0,0:03:29.09,0:03:31.59,Main,Hachi,0,0,0,,Biliyorsun, burası Mariejois değil!
Dialogue: 0,0:03:31.59,0:03:33.00,Main,Aladdin,0,0,0,,Bırak istediğini yapsın.
Dialogue: 0,0:03:33.00,0:03:33.51,Main,Hachi,0,0,0,,Nyuu?
Dialogue: 0,0:03:34.03,0:03:39.02,Main,Aladdin,0,0,0,,{\an8}Bırak zaman geçirsin. \NTravmadan kurtulmak o kadar kolay değildir.
Dialogue: 0,0:03:35.08,0:03:39.01,Captions,,0,0,0,,{\fad(300,0)}Güneş Korsanlarının Gemi Doktoru: Aladdin
Dialogue: 0,0:03:39.69,0:03:40.64,Main,Hachi,0,0,0,,Öyle mi?
Dialogue: 0,0:03:40.64,0:03:43.81,Main,Arlong,0,0,0,,Çok iyi anlıyor gibisin, Aladdin kardeş.
Dialogue: 0,0:03:44.87,0:03:48.15,Main,Arlong,0,0,0,,Eski köleler birbirini anlar.
Dialogue: 0,0:03:48.15,0:03:51.63,Main,Arlong,0,0,0,,Ama yine de şuracıkta onu\Nöldürmek istiyorsun, değil mi?
Dialogue: 0,0:03:52.69,0:03:55.95,Main,Arlong,0,0,0,,O bir insan, aynı seni köleleştirenler gibi!
Dialogue: 0,0:03:56.50,0:03:58.41,Main,Tiger,0,0,0,,Kes şunu, Arlong.
Dialogue: 0,0:03:58.41,0:04:02.75,Main,Arlong,0,0,0,,Bize gerçek tabiatını göster!\NAnnen sana ne öğretti?
Dialogue: 0,0:04:03.40,0:04:07.50,Main,Arlong,0,0,0,,Ailen balık adamları hor görüyor, değil mi?
Dialogue: 0,0:04:12.09,0:04:14.80,Main,Arlong,0,0,0,,İnsan toplumu böyle, değil mi?!
Dialogue: 0,0:04:14.80,0:04:19.78,Main,Arlong,0,0,0,,İnsanların yeryüzündeki en\Nmükemmel türler olduğunu düşünüyorlar!
Dialogue: 0,0:04:19.78,0:04:22.57,Main,Arlong,0,0,0,,Çocuklar ailelerinden bunu duyuyorlar\Nve kafalarına kazıyorlar!
Dialogue: 0,0:04:22.92,0:04:27.01,Main,Arlong,0,0,0,,Biri bunu durdurmak için güç\Nkullanana dek, döngü asla durmayacak!
Dialogue: 0,0:04:28.67,0:04:33.26,Main,Arlong,0,0,0,,Üç yıllık yolculuğumuz boyunca\Nbirçok kez onları gördünüz, değil mi?
Dialogue: 0,0:04:34.25,0:04:38.06,Main,Arlong,0,0,0,,İnsanların kibirli ve küçümseyen bakışlarını!
Dialogue: 0,0:04:38.06,0:04:42.32,Main,Arlong,0,0,0,,Patron orada olmasaydı ne yapardım bilmiyorum.
Dialogue: 0,0:04:50.72,0:04:53.73,Main,Jinbe,0,0,0,,İnsanların sadece küçük bir\Nkısmı bizi küüçümsüyor.
Dialogue: 0,0:04:53.74,0:04:56.26,Main,Jinbe,0,0,0,,Geri kalanı bana farklı göründü.
Dialogue: 0,0:04:56.26,0:04:57.37,Main,Arlong,0,0,0,,Jinbe abi...
Dialogue: 0,0:04:57.37,0:05:01.95,Main,Jinbe,0,0,0,,Görebildiğim kadarıyla hepsi bizden korkuyor.
Dialogue: 0,0:05:06.63,0:05:08.60,Main,Jinbe,0,0,0,,Korsan olduğumuz için mi?
Dialogue: 0,0:05:11.30,0:05:13.64,Main,Jinbe,0,0,0,,Neden bu kadar korkuyorsun?
Dialogue: 0,0:05:16.00,0:05:17.06,Main,Koala,0,0,0,,Çünkü...
Dialogue: 0,0:05:18.23,0:05:20.31,Main,Koala,0,0,0,,...hakkınızda hiçbir şey bilmiyoruz.
Dialogue: 0,0:05:22.59,0:05:24.69,Main,Jinbe,0,0,0,,Bilinmeyenden mi korkuyorsunuz?
Dialogue: 0,0:05:25.51,0:05:29.88,Flashbacks,Otohime,0,0,0,,Sadece belli türden insanlarla\Niletişim kurduğumuz için etkilendik.
Dialogue: 0,0:05:29.88,0:05:32.43,Flashbacks,Otohime,0,0,0,,Henüz onlarla ilgili bir şey bilmiyoruz.
Dialogue: 0,0:05:34.05,0:05:37.11,Main,Jinbe,0,0,0,,Birbirimizi daha iyi tanısaydık,\Nişler daha farklı olur muydu?
Dialogue: 0,0:05:38.87,0:05:40.79,Main,Hachi,0,0,0,,Nyuu- şuna bak, Koala!
Dialogue: 0,0:05:41.98,0:05:45.22,Main,Hachi,0,0,0,,Hangi elimde olduğunu tahmin et!
Dialogue: 0,0:05:45.75,0:05:47.70,Main,Hachi,0,0,0,,Peki hangisinde?
Dialogue: 0,0:05:48.41,0:05:51.13,Main,Koala,0,0,0,,Ah, bunda.
Dialogue: 0,0:05:52.47,0:05:54.80,Main,Hachi,0,0,0,,Bilemedin, bundaydı!
Dialogue: 0,0:06:50.06,0:06:54.16,Captions,,0,0,0,,{\fad(300,0)}Grand Line, Foolshout Adası
Dialogue: 0,0:06:50.47,0:06:54.19,Main,Tiger,0,0,0,,{\an8}Koala, aşağı gel. Memleketine geldik.
Dialogue: 0,0:06:59.74,0:07:01.82,Main,Tiger,0,0,0,,Köyün nerede?
Dialogue: 0,0:07:01.82,0:07:02.63,Main,Koala,0,0,0,,Ha?
Dialogue: 0,0:07:02.63,0:07:05.22,Main,Tiger,0,0,0,,Girişine kadar seni götüreceğim.
Dialogue: 0,0:07:05.22,0:07:06.20,Main,Koala,0,0,0,,Tamam!
Dialogue: 0,0:07:07.20,0:07:10.80,Main,Macro,0,0,0,,Gitme, Koala! \NBirlikte daha çok maceraya çıkalım!
Dialogue: 0,0:07:10.80,0:07:13.92,Main,Gyaro,0,0,0,,İnsan olsan bile çok iyi bir kızsın!
Dialogue: 0,0:07:15.06,0:07:16.46,Main,Kuroobi,0,0,0,,Ağlamayın!
Dialogue: 0,0:07:19.36,0:07:22.22,Main,Koala,0,0,0,,Bir sürü iyi kalpli balık adam olduğunu...
Dialogue: 0,0:07:22.22,0:07:26.10,Main,Koala,0,0,0,,...köydeki herkese anlatacağım!
Dialogue: 0,0:07:29.10,0:07:32.00,Main,Koala,0,0,0,,Çok teşekkür ederim!
Dialogue: 0,0:07:32.00,0:07:34.35,Main,Koala,0,0,0,,Hoşça kalın!
Dialogue: 0,0:07:40.40,0:07:42.95,Main,Hachi,0,0,0,,Kendine iyi bak!
Dialogue: 0,0:08:13.77,0:08:18.74,Main,Arlong,0,0,0,,Büyüyünce o çocuk da aynı\Ndiğer insanlar gibi olacak.
Dialogue: 0,0:08:18.74,0:08:20.76,Main,Macro,0,0,0,,Bu da ne demek oluyor, pislik?!
Dialogue: 0,0:08:21.46,0:08:22.74,Main,Macro,0,0,0,,Jinbe.
Dialogue: 0,0:08:23.52,0:08:25.20,Main,Jinbe,0,0,0,,Arlong, sen...
Dialogue: 0,0:08:25.20,0:08:27.15,Main,Arlong,0,0,0,,Jinbe abi,...
Dialogue: 0,0:08:28.06,0:08:30.95,Main,Arlong,0,0,0,,...üç yılda çok değiştin.
Dialogue: 0,0:08:30.95,0:08:31.91,Main,Jinbe,0,0,0,,Ne?
Dialogue: 0,0:08:32.05,0:08:33.46,Main,Arlong,0,0,0,,Bir düşünsene.
Dialogue: 0,0:08:33.46,0:08:38.64,Main,Arlong,0,0,0,,Şu köyden tek kişinin balık adamların iyi\Nkimseler olduğunu anlatması neyi değiştirir?
Dialogue: 0,0:08:39.17,0:08:44.72,Main,Arlong,0,0,0,,Aynı Otohime'nin konuşmaları gibi olacak.\NSözleri bir kulaktan girip diğerinden çıkacak.
Dialogue: 0,0:09:38.48,0:09:42.79,Main,Strawberry,0,0,0,,Ben Denizci Karargâhı'ndan Tuğamiral Strawberry.
Dialogue: 0,0:09:43.01,0:09:48.70,Main,Strawberry,0,0,0,,Malum bir adadan burada\Nolabileceğine dair bilgi aldık.
Dialogue: 0,0:09:48.70,0:09:55.33,Main,Strawberry,0,0,0,,Demin ziyaret ettiğin köydeki yetişkinler, küçük\Nbir gürültü olabileceği konusunda bilgilendirildi.
Dialogue: 0,0:09:55.33,0:09:57.00,Main,Strawberry,0,0,0,,Kabul ettiler ki,...
Dialogue: 0,0:09:57.67,0:10:03.28,Main,Strawberry,0,0,0,,...Kutsal Ejderler'e ait olmasına rağmen\No kızın burada kalmasına izin verelim.
Dialogue: 0,0:10:03.28,0:10:07.35,Main,Strawberry,0,0,0,,Güneş Korsanları'nın kaptanı, Fisher Tiger!
Dialogue: 0,0:10:07.97,0:10:10.32,Main,Strawberry,0,0,0,,İki sebepten suçlusun.
Dialogue: 0,0:10:10.32,0:10:12.50,Main,Strawberry,0,0,0,,Ne olduklarını bildiğine eminim.
Dialogue: 0,0:10:12.50,0:10:15.40,Main,Strawberry,0,0,0,,Baskın ve firar.
Dialogue: 0,0:10:27.85,0:10:29.85,Main,Jinbe,0,0,0,,Onlar silah sesi miydi?
Dialogue: 0,0:10:29.85,0:10:32.59,Main,Fishman,0,0,0,,Patronun gittiği yerden geldiler!
Dialogue: 0,0:10:32.59,0:10:34.57,Main,Jinbe,0,0,0,,Patrona bir şey olmuş olmalı.
Dialogue: 0,0:10:34.57,0:10:37.23,Main,Fishman,0,0,0,,Hey, denize bakın!
Dialogue: 0,0:10:39.13,0:10:41.26,Main,Chuu,0,0,0,,Denizciler! Etrafımız sarıldı -chuu!
Dialogue: 0,0:10:41.66,0:10:43.22,Main,Kuroobi,0,0,0,,Denizciler nerede?
Dialogue: 0,0:10:43.22,0:10:45.07,Main,Arlong,0,0,0,,Tuzağa düştük!
Dialogue: 0,0:10:45.07,0:10:48.37,Main,Arlong,0,0,0,,O kız, Denizciler'in attığı bir yemdi!
Dialogue: 0,0:10:48.37,0:10:53.62,Main,Arlong,0,0,0,,Demek ki Tai abi ve \Nbiz onların tuzağına düşmüşüz!
Dialogue: 0,0:10:53.62,0:10:56.92,Main,Arlong,0,0,0,,Gözünüzü açın! İnsanlar böyledir işte!
Dialogue: 0,0:11:08.81,0:11:10.35,Main,Jinbe,0,0,0,,Kahrolası Denizciler!
Dialogue: 0,0:11:11.32,0:11:14.60,Main,Jinbe,0,0,0,,Patron! Patron Tai tehlikede!
Dialogue: 0,0:11:14.60,0:11:15.70,Main,Jinbe,0,0,0,,Arlong!
Dialogue: 0,0:11:16.57,0:11:20.29,Main,Jinbe,0,0,0,,Bu işle sen ilgilen! \NBiz patrona yardım etmeye gideceğiz!
Dialogue: 0,0:11:20.29,0:11:22.36,Main,Arlong,0,0,0,,Elbette, Jinbe abi!
Dialogue: 0,0:11:22.82,0:11:26.53,Main,Arlong,0,0,0,,Abimizi sağ salim geri getirsen iyi edersin,\Nyoksa sana yumuşak davranmam!
Dialogue: 0,0:11:26.53,0:11:29.41,Main,Jinbe,0,0,0,,Tabii ki getireceğim! Gidelim!
Dialogue: 0,0:11:29.41,0:11:30.70,Main,Fishmen,0,0,0,,Tamam!
Dialogue: 0,0:11:30.70,0:11:33.83,Main,Fishmen,0,0,0,,Arlong-san, durum kötü! \NGemi fazla dayanmaz!
Dialogue: 0,0:11:34.92,0:11:36.83,Main,Arlong,0,0,0,,Gemiyi terk edin!
Dialogue: 0,0:11:38.74,0:11:41.61,Main,Arlong,0,0,0,,Denizci gemilerinden birini çalacağız!
Dialogue: 0,0:11:52.64,0:11:54.73,Main,Marine,0,0,0,,Ne kadar dayanıklı adam?!
Dialogue: 0,0:11:55.30,0:11:58.02,Main,Marine,0,0,0,,Birçok kez vurulmuş olmasına\Nrağmen neden yere yıkılmıyor?!
Dialogue: 0,0:12:01.08,0:12:03.07,Main,Tiger,0,0,0,,Affedilemez.
Dialogue: 0,0:12:03.07,0:12:04.27,Main,Tiger,0,0,0,,Affedilemez!
Dialogue: 0,0:12:04.28,0:12:07.36,Main,Tiger,0,0,0,,Bunun için sizi asla affetmeyeceğim, insanlar!
Dialogue: 0,0:12:07.36,0:12:08.03,Main,Strawberry,0,0,0,,Ateş.
Dialogue: 0,0:12:15.28,0:12:17.62,Main,Koala,0,0,0,,Bir şey duyuyor musun, anneciğim?
Dialogue: 0,0:12:18.97,0:12:19.75,Main,Koala's mom,0,0,0,,Hayır.
Dialogue: 0,0:12:22.21,0:12:23.63,Main,Jinbe,0,0,0,,Patron...
Dialogue: 0,0:12:23.63,0:12:25.34,Main,Jinbe,0,0,0,,Patron!
Dialogue: 0,0:12:26.30,0:12:28.76,Main,Marine,0,0,0,,Tuğamiral! Güneş Korsanları geldi!
Dialogue: 0,0:12:29.38,0:12:31.44,Main,Strawberry,0,0,0,,Demek bu o? Meşhur...
Dialogue: 0,0:12:32.80,0:12:34.03,Main,Strawberry,0,0,0,,...Jinbe?
Dialogue: 0,0:12:39.52,0:12:42.27,Main,Tiger,0,0,0,,Arkadaşlar... beni affedin.
Dialogue: 0,0:12:42.27,0:12:44.15,Main,Fishmen,0,0,0,,Patron!
Dialogue: 0,0:12:45.03,0:12:46.82,Main,Jinbe,0,0,0,,Demek sorumlu sensin?!
Dialogue: 0,0:12:47.15,0:12:51.93,Main,Strawberry,0,0,0,,Tüm bunlar adalet uğruna.\NGüneş Korsanları'nı yok etmek için!
Dialogue: 0,0:12:53.13,0:12:55.53,Main,Jinbe,0,0,0,,Kahrolası Denizciler!
Dialogue: 0,0:12:56.09,0:12:57.77,Main,Strawberry,0,0,0,,Senin de kafanı koparacağım!
Dialogue: 0,0:12:57.77,0:13:00.64,Main,Jinbe,0,0,0,,Yapabiliyorsan kopar!
Dialogue: 0,0:13:04.61,0:13:12.72,Main,Jinbe,0,0,0,,Patronu kurtarmayı başardık ve sonunda\NArlong'un el koyduğu gemiyle kaçtık.
Dialogue: 0,0:13:14.40,0:13:15.81,Main,Jinbe,0,0,0,,Ancak...
Dialogue: 0,0:13:19.78,0:13:21.15,Main,Fishmen,0,0,0,,Patron!
Dialogue: 0,0:13:21.75,0:13:26.98,Main,Hachi,0,0,0,,Kan naklini kabul etmiyor musun?!\NPatron, ne diyorsun sen?!
Dialogue: 0,0:13:26.98,0:13:31.45,Main,Jinbe,0,0,0,,Çok kan kaybettin! \NBir an önce kan nakli yapılmazsa,...
Dialogue: 0,0:13:31.45,0:13:37.33,Main,Aladdin,0,0,0,,Kan grubun ender rastlanır türden!\NTayfadakilerin kanıyla uyuşmuyor!
Dialogue: 0,0:13:37.73,0:13:42.73,Main,Tiger,0,0,0,,Ama Denizci gemisindeki kan stokları...
Dialogue: 0,0:13:43.89,0:13:46.40,Main,Tiger,0,0,0,,...insan kanı, değil mi?!
Dialogue: 0,0:13:47.19,0:13:51.47,Main,Aladdin,0,0,0,,Evet! İnsanlarla aynı kan türüne sahibiz!
Dialogue: 0,0:13:51.88,0:13:54.97,Main,Aladdin,0,0,0,,İnsan kanı kullanabiliriz!\NHâlâ kurtulma ihtimalin var!
Dialogue: 0,0:13:57.43,0:13:59.39,Main,Aladdin,0,0,0,,Bir an önce kan nakline...
Dialogue: 0,0:13:59.39,0:14:01.10,Main,Tiger,0,0,0,,Hayır!
Dialogue: 0,0:14:02.14,0:14:05.06,Main,Tiger,0,0,0,,Damarlarımda o kan akarken yaşamak istemiyorum!
Dialogue: 0,0:14:07.81,0:14:10.06,Main,Tiger,0,0,0,,O pis kan!
Dialogue: 0,0:14:11.08,0:14:15.41,Main,Tiger,0,0,0,,Balık adamları hor görmeye devam eden kan!
Dialogue: 0,0:14:15.41,0:14:17.54,Main,Jinbe,0,0,0,,Patron...
Dialogue: 0,0:14:17.54,0:14:21.66,Main,Tiger,0,0,0,,Onlara borçlu kalmayacağım! \NOnların merhametini kabul etmeyeceğim!
Dialogue: 0,0:14:21.66,0:14:24.88,Main,Tiger,0,0,0,,İnsanlara yenilmeyeceğim!
Dialogue: 0,0:14:27.30,0:14:31.34,Main,Arlong,0,0,0,,Abi! İnsanlarla aranda ne oldu?!
Dialogue: 0,0:14:36.97,0:14:40.77,Main,Tiger,0,0,0,,Size anlatmak istemedim.
Dialogue: 0,0:14:41.75,0:14:45.30,Main,Tiger,0,0,0,,Son yolculuğumda...
Dialogue: 0,0:14:46.27,0:14:48.87,Flashbacks,Jinbe,0,0,0,,Bu defa yolculuğun çok uzun oldu.
Dialogue: 0,0:14:48.87,0:14:50.81,Flashbacks,Tiger,0,0,0,,Evet. Bir sürü şey oldu.
Dialogue: 0,0:14:52.11,0:14:57.20,Flashbacks,Neptune,0,0,0,,Sen... Son yolculuğunda ne gördün?
Dialogue: 0,0:15:00.68,0:15:02.22,Flashbacks,Tiger,0,0,0,,İnsanları.
Dialogue: 0,0:15:05.38,0:15:07.49,Main,Tiger,0,0,0,,Yola çıktıktan kısa süre sonra...
Dialogue: 0,0:15:08.95,0:15:10.80,Main,Tiger,0,0,0,,...hapsedildim!
Dialogue: 0,0:15:11.72,0:15:14.26,Main,Tiger,0,0,0,,Mariejois'da birkaç yıl geçirdim.
Dialogue: 0,0:15:18.15,0:15:19.51,Main,Tiger,0,0,0,,Ben...
Dialogue: 0,0:15:20.75,0:15:22.25,Main,Tiger,0,0,0,,...köleydim!
Dialogue: 0,0:15:22.25,0:15:24.06,Main,Jinbe,0,0,0,,Ne?!
Dialogue: 0,0:15:27.27,0:15:29.07,Main,Hachi,0,0,0,,Patron...
Dialogue: 0,0:15:30.47,0:15:34.91,Main,Tiger,0,0,0,,Orada gördüğüm şey, insanlığın deliliğiydi.
Dialogue: 0,0:15:35.70,0:15:38.82,Main,Tiger,0,0,0,,Canımı kurtarıp kaçmayı başardım,...
Dialogue: 0,0:15:39.66,0:15:44.09,Main,Tiger,0,0,0,,...ama gördüğüm diğer\Nköleleri göz ardı edemedim.
Dialogue: 0,0:15:47.44,0:15:48.79,Main,Tiger,0,0,0,,İyi dinleyin.
Dialogue: 0,0:15:48.79,0:15:51.77,Main,Tiger,0,0,0,,Hayatımı istediğim gibi yaşadım...
Dialogue: 0,0:15:52.81,0:15:58.95,Main,Tiger,0,0,0,,...ve sonuç olarak, Kraliçe Otohime'nin\Nçabalarını birkaç kez boşa çıkardım.
Dialogue: 0,0:16:00.34,0:16:03.23,Main,Tiger,0,0,0,,Ama o haklı.
Dialogue: 0,0:16:03.85,0:16:07.62,Main,Tiger,0,0,0,,En iyisinin barış olduğunu kim olsa anlar.
Dialogue: 0,0:16:09.45,0:16:14.18,Main,Tiger,0,0,0,,Ama adamızı gerçek anlamda\Ndeğiştirebilecek olanlar...
Dialogue: 0,0:16:15.14,0:16:19.87,Main,Tiger,0,0,0,,...Koala gibilerdir. \NHiç bir şey bilmeyen yeni nesil.
Dialogue: 0,0:16:24.92,0:16:27.14,Main,Tiger,0,0,0,,Bu yüzden yalvarıyorum!
Dialogue: 0,0:16:27.14,0:16:30.75,Main,Tiger,0,0,0,,Adamızdakilere hiçbir şey anlatmayın!
Dialogue: 0,0:16:31.63,0:16:36.80,Main,Tiger,0,0,0,,Ne başımıza gelen trajediyi, \Nne de insanlara karşı duyduğumuz öfkeyi.
Dialogue: 0,0:16:36.80,0:16:37.93,Main,Arlong,0,0,0,,Ama abi...
Dialogue: 0,0:16:37.93,0:16:39.39,Main,Tiger,0,0,0,,Arlong!
Dialogue: 0,0:16:43.10,0:16:49.02,Main,Tiger,0,0,0,,Bu dünyada bir sürü iyi kalpli insan var.
Dialogue: 0,0:16:49.52,0:16:51.31,Main,Tiger,0,0,0,,Hepimiz bunu biliyoruz.
Dialogue: 0,0:16:51.31,0:16:59.74,Main,Tiger,0,0,0,,Buna rağmen ölenler olarak dünyada sadece\Nnefret bırakıyoruz. Saçmalık değil mi bu?!
Dialogue: 0,0:17:01.30,0:17:03.97,Main,Tiger,0,0,0,,Ben dahi içten içe,...
Dialogue: 0,0:17:03.97,0:17:07.28,Main,Tiger,0,0,0,,...kalbimde beni durduran...
Dialogue: 0,0:17:08.61,0:17:10.25,Main,Tiger,0,0,0,,...bir şeytan olduğunu biliyorum!
Dialogue: 0,0:17:11.13,0:17:15.30,Main,Tiger,0,0,0,,Bedenim o kanı istemiyor!
Dialogue: 0,0:17:15.92,0:17:17.36,Main,Tiger,0,0,0,,Ben...
Dialogue: 0,0:17:20.40,0:17:23.90,Main,Tiger,0,0,0,,...artık insanları sevemem!
Dialogue: 0,0:17:25.31,0:17:29.31,Main,Jinbe,0,0,0,,Patron! Lütfen öyle deme! Yaşa!
Dialogue: 0,0:17:29.31,0:17:32.44,Main,Jinbe,0,0,0,,Lütfen! Hâlâ hayatta kalabilirsin!
Dialogue: 0,0:17:32.44,0:17:38.48,Main,Aladdin,0,0,0,,Patron! Ne dersen de, kurtardığın\Ntüm kölelerin gözünde...
Dialogue: 0,0:17:38.48,0:17:40.95,Main,Aladdin,0,0,0,,...onların kurtarıcısısın!
Dialogue: 0,0:17:41.58,0:17:45.75,Main,Aladdin,0,0,0,,Birçok şeyi başaran, \Nbalık adamların kahramanısın!
Dialogue: 0,0:17:46.56,0:17:47.72,Main,Tiger,0,0,0,,Öyle düşünmene sevindim.
Dialogue: 0,0:17:49.86,0:17:51.17,Flashbacks,Tiger,0,0,0,,Daha önünde uzun bir yol var.
Dialogue: 0,0:17:51.17,0:17:52.04,Flashbacks,Jinbe,0,0,0,,Ne?!
Dialogue: 0,0:17:52.04,0:17:57.51,Flashbacks,Tiger,0,0,0,,Hareketlerin çok yumuşak. Bu kadar\Ngüçsüz yumruklarla kimseyi koruyamazsın.
Dialogue: 0,0:17:58.16,0:17:59.38,Flashbacks,Jinbe,0,0,0,,Korumak mı?!
Dialogue: 0,0:18:00.95,0:18:01.76,Flashbacks,Arlong,0,0,0,,Abi!
Dialogue: 0,0:18:02.27,0:18:07.77,Flashbacks,Tiger,0,0,0,,Başka meydan okumak isteyen yoksa, bundan\Nsonra Balık Adam Bölgesi'nin patronu ben olacağım!
Dialogue: 0,0:18:07.77,0:18:09.81,Flashbacks,Tiger,0,0,0,,Ben Tiger!
Dialogue: 0,0:18:09.81,0:18:13.18,Flashbacks,Tiger,0,0,0,,Artık lideriniz olduğuma göre, içiniz rahat olsun.
Dialogue: 0,0:18:13.18,0:18:16.41,Flashbacks,Tiger,0,0,0,,Canlarınız canımdır!
Dialogue: 0,0:18:17.86,0:18:21.37,Flashbacks,Tiger,0,0,0,,Adamlarımı koruyacağım!
Dialogue: 0,0:18:28.00,0:18:36.34,Main,Fishmen,0,0,0,,Patron!
Dialogue: 0,0:18:44.15,0:18:50.19,Main,Fishmen,0,0,0,,Patron!
Dialogue: 0,0:18:53.56,0:18:57.66,Main,Arlong,0,0,0,,Bunu asla affetmeyeceğim!
Dialogue: 0,0:19:08.87,0:19:12.37,Main,Arlong,0,0,0,,Hazırlanın!
Dialogue: 0,0:19:12.37,0:19:14.51,Main,Marine,0,0,0,,Sen o balık adamsın.
Dialogue: 0,0:19:22.30,0:19:24.38,Main,Kizaru,0,0,0,,Çok gürültü ediyorsun.
Dialogue: 0,0:19:33.98,0:19:36.39,Main,Kizaru,0,0,0,,Demek Arlong sensin?
Dialogue: 0,0:19:36.99,0:19:39.65,Main,Kizaru,0,0,0,,Neden geri döndün?
Dialogue: 0,0:19:39.65,0:19:41.44,Main,Kizaru,0,0,0,,Dikkatsizlik edip...
Dialogue: 0,0:19:47.34,0:19:52.83,Captions,,0,0,0,,{\an8\fad(300,0)}Denizci Karargâhı Koramiral Borsalino\N(Geleceğin Amiral Kizaru'su)
Dialogue: 0,0:19:50.55,0:19:52.87,Main,Kizaru,0,0,0,,...buraya geri dönüyorsun.
Dialogue: 0,0:19:52.87,0:19:57.42,Main,Arlong,0,0,0,,Tai abiyi vuran insanları katletmeye geldim!
Dialogue: 0,0:19:57.42,0:20:00.20,Main,Arlong,0,0,0,,Bizi ele veren adaya da gideceğim!
Dialogue: 0,0:20:00.20,0:20:02.55,Main,Kizaru,0,0,0,,Demek misillemen bu?
Dialogue: 0,0:20:02.55,0:20:05.77,Main,Arlong,0,0,0,,Evet! Fisher Tiger öldü!
Dialogue: 0,0:20:05.77,0:20:08.80,Main,Arlong,0,0,0,,Siz aşağılık insanlar onu öldürdünüz!
Dialogue: 0,0:20:08.80,0:20:11.85,Main,Kizaru,0,0,0,,Ah, öyle mi? Demek öldü?
Dialogue: 0,0:20:12.74,0:20:17.63,Main,Kizaru,0,0,0,,Yine de benimle geliyorsun.
Dialogue: 0,0:20:21.16,0:20:23.96,Main,Jinbe,0,0,0,,Fisher Tiger'ın ölümü Arlong'u öfkelendirdi.
Dialogue: 0,0:20:24.52,0:20:28.79,Main,Jinbe,0,0,0,,Bu yüzden içerlediği insanlara\Nkarşı dişlerini gösterdi...
Dialogue: 0,0:20:28.79,0:20:31.03,Main,Jinbe,0,0,0,,...ve yakalandı.
Dialogue: 0,0:20:32.91,0:20:35.75,Main,Arlong,0,0,0,,Kan naklini reddetmeseydi, hayatta kalabilirdi!
Dialogue: 0,0:20:35.75,0:20:39.83,Main,Arlong,0,0,0,,Balık adam kanı bulsaydık, Fisher Tiger ölmezdi!
Dialogue: 0,0:20:40.30,0:20:44.88,Main,Arlong,0,0,0,,Siz insanlar onu ölüme sürüklediniz!
Dialogue: 0,0:20:46.75,0:20:53.58,Main,Jinbe,0,0,0,,"İnsanlar kan naklini kabul etmediği için,\NGüneş Korsanları'nın kaptanı Fisher Tiger öldü."
Dialogue: 0,0:20:54.17,0:20:56.66,Main,Jinbe,0,0,0,,Gerçeğe yakın sayılır.
Dialogue: 0,0:20:57.91,0:21:01.44,Main,Aladdin,0,0,0,,Sonuçta ölmesi insanların hatasıydı.
Dialogue: 0,0:21:01.98,0:21:04.90,Main,Jinbe,0,0,0,,Arlong, Denizciler'e yalan söyledi.
Dialogue: 0,0:21:04.90,0:21:08.19,Main,Aladdin,0,0,0,,Gerçek çok daha acımasızdı.
Dialogue: 0,0:21:08.19,0:21:15.33,Main,Aladdin,0,0,0,,Ona ihanet eden insanlara içerleyen Tiger,\Ndamarlarında onların kanı dolaşsın istemedi.
Dialogue: 0,0:21:15.33,0:21:17.77,Main,Aladdin,0,0,0,,Kölelik geçmişinden bahsetmiyorum bile.
Dialogue: 0,0:21:17.77,0:21:22.01,Main,Aladdin,0,0,0,,Dünya bunu öğrenirse,\NPatron'un şerefine leke sürülür.
Dialogue: 0,0:21:22.63,0:21:25.28,Main,Aladdin,0,0,0,,Arlong bunu asla ortaya çıkarmaz.
Dialogue: 0,0:21:30.07,0:21:33.55,Main,Hachi,0,0,0,,Nyuu- Kaptan Jinbe!
Dialogue: 0,0:21:33.55,0:21:35.05,Main,Hachi,0,0,0,,Düşman gemisi göründü!
Dialogue: 0,0:21:35.05,0:21:38.89,Main,Jinbe,0,0,0,,Patron olmasa bile artık geri dönemeyiz!
Dialogue: 0,0:21:40.32,0:21:45.30,Main,Jinbe,0,0,0,,Dövüş için hazırlanın! \NSakın unutmayın, kimseyi öldürmüyoruz!
Dialogue: 0,0:21:45.30,0:21:48.53,Main,Fishmen,0,0,0,,Tamam!
Dialogue: 0,0:21:49.21,0:21:54.02,Main,Jinbe,0,0,0,,Ben, Güneş Korsanları'nın kaptanı...
Dialogue: 0,0:21:54.02,0:21:57.68,Main,Jinbe,0,0,0,,...Deniz Şövalyesi Jinbe olarak bilinir oldum.
Dialogue: 0,0:21:57.68,0:22:01.18,Main,Jinbe,0,0,0,,Kendimi asla son bulmayan bir savaşa adadım.
Dialogue: 0,0:22:04.00,0:22:06.25,Main,Neptune,0,0,0,,"Bunu sana yazıyorum."
Dialogue: 0,0:22:02.77,0:22:06.47,Captions,,0,0,0,,{\an8\fad(300,0)}Balık Adam Adası, Ryugu Sarayı
Dialogue: 0,0:22:06.45,0:22:10.87,Main,Neptune,0,0,0,,"Çünkü tüm gerçeği bilmeyi\Nhak ettiğini hissediyorum."
Dialogue: 0,0:22:11.59,0:22:15.64,Main,Neptune,0,0,0,,"Güneş Korsanları'nın Kaptanı, Jinbe."
Dialogue: 0,0:22:16.63,0:22:18.56,Flashbacks,Tiger,0,0,0,,Kararımı verdim.
Dialogue: 0,0:22:19.10,0:22:23.56,Main,Neptune,0,0,0,,Demek Tiger, \Ngittiği yolu seçmeye zorlanmış-jamon.
Dialogue: 0,0:22:24.51,0:22:29.03,Main,Otohime,0,0,0,,O gün kalbinde duyduğum çığlığı şimdi anlıyorum.
Dialogue: 0,0:22:41.83,0:22:46.37,Main,Otohime,0,0,0,,Ben iyiyim. Yenilmeyeceğim!
Dialogue: 0,0:22:47.28,0:22:49.62,Main,Otohime,0,0,0,,Güneşin altında yaşamalıyız!
Dialogue: 0,0:22:49.62,0:22:52.55,Main,Otohime,0,0,0,,İnsanların ve bizim birbirimizi\Nanladığımız gün kesinlikle gelecek!
Dialogue: 0,0:22:52.55,0:22:56.27,Main,Otohime,0,0,0,,Bu formu imzala! \NGöç etme isteğini ilan et!
Dialogue: 0,0:22:56.27,0:22:59.40,Main,Fishman,0,0,0,,Yapamam! Bu imkânsız, Otohime-sama!
Dialogue: 0,0:22:59.87,0:23:05.00,Main,Fishman,0,0,0,,Tiger-san bütün köleleri kurtardı,\Nırk ayrımı gözetmedi...
Dialogue: 0,0:23:05.00,0:23:07.39,Main,Fishman,0,0,0,,...ama insanlar onu öylece terk etti!
Dialogue: 0,0:23:07.39,0:23:08.94,Main,Fishman,0,0,0,,Birbirimizi nasıl anlamamız gerekiyor ki?!
Dialogue: 0,0:23:12.54,0:23:15.99,Main,Otohime,0,0,0,,Bugün de tek bir imza bile yok.
Dialogue: 0,0:23:17.45,0:23:18.81,Main,Princes,0,0,0,,Anne!
Dialogue: 0,0:23:18.81,0:23:20.45,Main,Otohime,0,0,0,,Çocuklarım!
Dialogue: 0,0:23:23.49,0:23:26.28,Main,Shirahoshi,0,0,0,,Anne, iyi misin?
Dialogue: 0,0:23:26.28,0:23:29.23,Main,Princes,0,0,0,,İyi misin? İyi misin?
Dialogue: 0,0:23:29.23,0:23:31.71,Main,Fukaboshi,0,0,0,,Çok bitkin düşmüş.
Dialogue: 0,0:23:31.71,0:23:35.39,Main,Otohime,0,0,0,,Ah, benim huzur vaham.
Dialogue: 0,0:23:36.99,0:23:38.55,Main,Otohime,0,0,0,,Ben iyiyim!
Dialogue: 0,0:23:39.81,0:23:40.97,Main,Shirahoshi,0,0,0,,Anne.
Dialogue: 0,0:23:41.41,0:23:42.77,Main,Princes,0,0,0,,Anne!
Dialogue: 0,0:23:43.54,0:23:45.48,Main,Otohime,0,0,0,,Geleceğiniz için...
Dialogue: 0,0:23:46.53,0:23:48.90,Main,Otohime,0,0,0,,...söz verelim.
Dialogue: 0,0:23:50.84,0:23:55.70,Main,Jinbe,0,0,0,,Gün be gün, Kraliçe Otohime kendisini yıprattı.
Dialogue: 0,0:24:03.55,0:24:06.03,Main,Jinbe,0,0,0,,Gemi enkazlarından kazazedeleri kurtararak.
Dialogue: 0,0:24:09.67,0:24:11.09,Main,Fishman,0,0,0,,Dayanın!
Dialogue: 0,0:24:11.09,0:24:12.79,Main,Fishman,0,0,0,,Yine mi korsanlar?
Dialogue: 0,0:24:13.39,0:24:14.88,Main,Man,0,0,0,,Yardım edin.
Dialogue: 0,0:24:14.88,0:24:15.98,Main,Otohime,0,0,0,,Elbette edeceğiz!
Dialogue: 0,0:24:16.70,0:24:18.59,Main,Otohime,0,0,0,,Onları adaya taşıyalım!
Dialogue: 0,0:24:19.23,0:24:22.76,Main,Jinbe,0,0,0,,Adadaki çocukları yüzeydeki\Ndünya konusunda bilgilendirerek.
Dialogue: 0,0:24:23.32,0:24:27.77,Main,Otohime,0,0,0,,Bu orman, dün size bir sürü ağacın\Nbirlikte büyüdüğünü söylediğim yer.
Dialogue: 0,0:24:27.77,0:24:30.16,Main,Kid,0,0,0,,Orman? Deniz Ormanı mı?
Dialogue: 0,0:24:30.80,0:24:32.33,Main,Jinbe,0,0,0,,İmza toplayarak.
Dialogue: 0,0:24:33.56,0:24:35.37,Main,Otohime,0,0,0,,Durun!
Dialogue: 0,0:24:36.67,0:24:38.43,Main,Otohime,0,0,0,,Sadece bir saniye sürecek!
Dialogue: 0,0:24:42.09,0:24:43.37,Main,Jinbe,0,0,0,,Ancak...
Dialogue: 0,0:24:44.64,0:24:45.95,Main,Fishman,0,0,0,,Kraliçe Otohime.
Dialogue: 0,0:24:47.10,0:24:49.37,Main,Otohime,0,0,0,,Oh! Siz!
Dialogue: 0,0:24:49.84,0:24:52.82,Main,Otohime,0,0,0,,Siz formu imzalayanlarsınız, değil mi?
Dialogue: 0,0:24:52.82,0:24:54.91,Main,Fishman,0,0,0,,Bugün sizden bir iyilik isteyeceğiz.
Dialogue: 0,0:24:54.91,0:24:57.42,Main,Fishman,0,0,0,,Kaç imza topladınız?
Dialogue: 0,0:24:58.00,0:25:00.52,Main,Otohime,0,0,0,,Bunları toplarken beş yıl harcadım.
Dialogue: 0,0:25:00.52,0:25:03.03,Main,Otohime,0,0,0,,Her kağıtta on imza var...
Dialogue: 0,0:25:03.03,0:25:04.17,Main,Otohime,0,0,0,,...ve elimde yüz kadar kağıt var.
Dialogue: 0,0:25:04.89,0:25:08.45,Main,Otohime,0,0,0,,Yani bin tane destekçi.
Dialogue: 0,0:25:08.45,0:25:14.44,Main,Otohime,0,0,0,,Balık Adam Adası'nda beş milyon kişi var,\Nbu yüzden daha fazlasını umuyordum ama...
Dialogue: 0,0:25:16.10,0:25:19.46,Main,Fishman,0,0,0,,Şey, bencilce bir isteğimiz olacak.
Dialogue: 0,0:25:19.46,0:25:25.97,Main,Fishman,0,0,0,,Kağıtlarınızın elli kadarına mâl olacak\Nsayıda imzayı geri çekmek istiyoruz.
Dialogue: 0,0:25:26.98,0:25:31.75,Main,Fishman,0,0,0,,Duymadınız mı? \NGeçen gün adaya gelen korsanlar.
Dialogue: 0,0:25:33.77,0:25:38.56,Main,Fishman,0,0,0,,Şehri yağmalayıp kaçmışlar.
Dialogue: 0,0:25:46.22,0:25:47.83,Main,Right Minister,0,0,0,,Otohime-sama...
Dialogue: 0,0:25:47.83,0:25:48.77,Main,Kid,0,0,0,,Otohime-sama!
Dialogue: 0,0:25:48.77,0:25:52.62,Main,Otohime,0,0,0,,Oh, çocuklar. Yüzeydeki dünya ile ilgili\Ndaha çok hikaye dinlemeye mi geldiniz?
Dialogue: 0,0:25:57.06,0:26:00.82,Main,Kid,0,0,0,,Hah... Geçen gün imzaladığım kağıt.
Dialogue: 0,0:26:00.82,0:26:02.04,Main,Kid,0,0,0,,Annem dedi.
Dialogue: 0,0:26:03.30,0:26:04.45,Main,Kidz,0,0,0,,Annem dedi!
Dialogue: 0,0:26:09.77,0:26:10.62,Main,Otohime,0,0,0,,Ne oldu?
Dialogue: 0,0:26:10.62,0:26:14.50,Main,Fishman,0,0,0,,Kraliçe olduğunuz için dediğinizi yaptım ama...
Dialogue: 0,0:26:17.10,0:26:19.96,Main,Fishman,0,0,0,,Sorun insanlar.
Dialogue: 0,0:26:22.17,0:26:24.30,Main,Fishman,0,0,0,,Sizin konuşmalarınızdan da...
Dialogue: 0,0:26:24.30,0:26:26.82,Main,Fishman,0,0,0,,...bıktık artık.
Dialogue: 0,0:26:28.85,0:26:30.30,Main,Fishman,0,0,0,,Onlardan bıktım.
Dialogue: 0,0:26:38.95,0:26:42.45,Main,Shirahoshi,0,0,0,,Anne, hoşgeldin!
Dialogue: 0,0:26:43.78,0:26:45.94,Main,Otohime,0,0,0,,Bugün de elimden geleni yaptım!
Dialogue: 0,0:26:45.94,0:26:48.00,Main,Otohime,0,0,0,,Ben geldim, küçük meleklerim!
Dialogue: 0,0:26:48.00,0:26:52.53,Main,Otohime,0,0,0,,Biraz aşırıya kaçtım, \Nbugünlük beni yalnız bırakabilir misiniz?
Dialogue: 0,0:27:15.12,0:27:19.17,Main,Otohime,0,0,0,,Yalancılar! Hepiniz yalancısınız!
Dialogue: 0,0:27:21.46,0:27:23.21,Main,Left Minister,0,0,0,,O-Otohime-sama!
Dialogue: 0,0:27:23.21,0:27:26.65,Main,Left Minister,0,0,0,,Bütün ülkeye yayın yapıyorsunuz!
Dialogue: 0,0:27:29.11,0:27:34.41,Main,Otohime,0,0,0,,Kapa çeneni... seni lanet Sol Bakan!
Dialogue: 0,0:27:37.70,0:27:40.18,Main,Left Minister,0,0,0,,Siz... İçiyor muydunuz?!
Dialogue: 0,0:27:40.18,0:27:45.11,Main,Otohime,0,0,0,,Kapa çeneni. Ah, sarhoş... Ah, sarhoş değilim!
Dialogue: 0,0:27:45.11,0:27:47.01,Main,Left Minister,0,0,0,,Evet, öylesiniz!
Dialogue: 0,0:27:47.01,0:27:48.55,Main,Fishman,0,0,0,,O da ne?
Dialogue: 0,0:27:48.55,0:27:50.65,Main,Fishwoman,0,0,0,,Kraliçe Otohime'nin sesi mi?
Dialogue: 0,0:27:50.65,0:27:53.99,Main,Otohime,0,0,0,,Hepiniz dinleyin!
Dialogue: 0,0:27:53.99,0:28:01.53,Main,Otohime,0,0,0,,Okyanusun istediğimiz yerinde yaşayabiliriz.
Dialogue: 0,0:28:02.05,0:28:06.47,Main,Otohime,0,0,0,,Bu engin, engin okyanusta.
Dialogue: 0,0:28:06.47,0:28:10.74,Main,Otohime,0,0,0,,Karanlık, karanlık okyanus tabanında.
Dialogue: 0,0:28:13.39,0:28:19.35,Main,Otohime,0,0,0,,Neden tek bir yerde yaşıyoruz?
Dialogue: 0,0:28:20.01,0:28:21.35,Main,Fishwoman,0,0,0,,Otohime-sama...
Dialogue: 0,0:28:22.31,0:28:29.84,Main,Otohime,0,0,0,,Burada birazcık ışık ve hava olduğu için değil mi?
Dialogue: 0,0:28:29.84,0:28:34.15,Main,Otohime,0,0,0,,Yüzeyde, tüm dünya güneş ışığı görüyor!
Dialogue: 0,0:28:34.15,0:28:37.33,Main,Otohime,0,0,0,,Üstünde engin bir gökyüzü var.
Dialogue: 0,0:28:43.54,0:28:51.70,Main,Otohime,0,0,0,,Neden çocuklar Sabaody Park'a\Nbakmak için gizlice yukarı çıkıyor?
Dialogue: 0,0:28:52.48,0:28:54.38,Main,Otohime,0,0,0,,Dünyada...
Dialogue: 0,0:28:55.55,0:28:59.47,Main,Otohime,0,0,0,,...bir sürü mükemmel yer var!
Dialogue: 0,0:29:00.55,0:29:05.59,Main,Otohime,0,0,0,,O yerlerin hepsine gidebilmeliyiz.
Dialogue: 0,0:29:06.73,0:29:15.11,Main,Otohime,0,0,0,,Biz sadece boş mazeretler uydurup, kendimizi\Npes etmemiz gerektiğine inandırmıyor muyuz?
Dialogue: 0,0:29:16.21,0:29:18.65,Main,Otohime,0,0,0,,Cesur olun...
Dialogue: 0,0:29:19.30,0:29:23.28,Main,Otohime,0,0,0,,...ve hepimizin en çok istediği şey için çabalayın!
Dialogue: 0,0:29:25.45,0:29:26.64,Main,Left Minister,0,0,0,,Majesteleri.
Dialogue: 0,0:29:27.08,0:29:30.69,Main,Otohime,0,0,0,,İnsanlar yolumuza çıkan engellerse,...
Dialogue: 0,0:29:30.69,0:29:33.55,Main,Otohime,0,0,0,,...birlikte o engeli aşalım!
Dialogue: 0,0:29:33.55,0:29:39.82,Main,Otohime,0,0,0,,Bugün Balık Adam Adası'nda yaşayan\Nçocuklar, o zaman belki...
Dialogue: 0,0:29:39.82,0:29:41.20,Main,Otohime,0,0,0,,...geleceklerini biraz değiştirebilir.
Dialogue: 0,0:29:42.98,0:29:45.37,Main,Otohime,0,0,0,,En azından birazcık!
Dialogue: 0,0:29:58.52,0:30:01.22,Captions,,0,0,0,,{\fad(300,0)}Denizci Karargâhı
Dialogue: 0,0:30:01.26,0:30:04.30,Main,Kizaru,0,0,0,,Yaraların iyileşti mi?
Dialogue: 0,0:30:04.30,0:30:06.22,Main,Strawberry,0,0,0,,Bazı ciddi sorunlar yaşadım.
Dialogue: 0,0:30:06.22,0:30:09.74,Main,Kizaru,0,0,0,,Bu kadar kötü yenileceğin hiç aklıma gelmemişti.
Dialogue: 0,0:30:09.74,0:30:16.58,Main,Strawberry,0,0,0,,Geçen gün Impel Down'a hapsedilen Arlong hiç sorun değil.
Dialogue: 0,0:30:16.58,0:30:20.06,Main,Strawberry,0,0,0,,Asıl sert olan Jinbe.
Dialogue: 0,0:30:24.50,0:30:28.02,Main,Strawberry,0,0,0,,O türden bir gücü her gün görmezsin.
Dialogue: 0,0:30:28.70,0:30:31.66,Main,Strawberry,0,0,0,,Her istediğini yapmasına izin\Nvermek fazlasıyla tehlikeli.
Dialogue: 0,0:30:34.74,0:30:37.54,Note,,0,0,0,,Belirsiz Adalet
Dialogue: 0,0:30:38.94,0:30:41.89,Main,Jinbe,0,0,0,,Shichibukai olmak mı? Ben mi?!
Dialogue: 0,0:30:41.89,0:30:46.06,Main,Macro,0,0,0,,Ödülün 250 milyon beli!
Dialogue: 0,0:30:46.06,0:30:52.80,Main,Macro,0,0,0,,Bunu yapmadıkları zaman kendileri için büyük\Nbir tehdit olacağını Hükümet fark etmiş olmalı!
Dialogue: 0,0:30:52.80,0:30:56.27,Main,Chuu,0,0,0,,Demek ders almaya başlamışlar!
Dialogue: 0,0:30:56.27,0:31:01.58,Main,Chuu,0,0,0,,Tekliflerini geri çevir ve \Nçok daha acımasız biri ol,...
Dialogue: 0,0:31:01.58,0:31:03.35,Main,Chuu,0,0,0,,...Kaptan Jinbe-chuu!
Dialogue: 0,0:31:03.35,0:31:07.77,Main,Jinbe,0,0,0,,Hayır, tekliflerini kabul etmeyi düşünüyorum.
Dialogue: 0,0:31:07.77,0:31:09.30,Main,Crew,0,0,0,,Ha?!
Dialogue: 0,0:31:09.92,0:31:14.99,Main,Neptune,0,0,0,,Shichibukai'ya katılma teklifini duydum.
Dialogue: 0,0:31:14.99,0:31:19.38,Main,Jinbe,0,0,0,,Shichibukai olursam, \NHükümet tayfamı affedecek.
Dialogue: 0,0:31:19.38,0:31:26.98,Main,Jinbe,0,0,0,,Aladdin ve korsanlığı bırakmak isteyen\Ndiğerleri bu ülkede huzur içinde yaşayabilecek.
Dialogue: 0,0:31:26.98,0:31:35.33,Main,Jinbe,0,0,0,,Asıl önemlisi bu unvanı kabul edersem, balık adamlar\NDünya Hükümeti'ne katılmaya biraz daha yaklaşabilir.
Dialogue: 0,0:31:35.81,0:31:39.11,Main,Jinbe,0,0,0,,Kendisine bu kadar sorun çıkardıktan\Nsonra Majesteleri'nin hatrına.
Dialogue: 0,0:31:39.11,0:31:41.45,Main,Neptune,0,0,0,,Evet ve minnettarım.
Dialogue: 0,0:31:42.07,0:31:45.86,Main,Neptune,0,0,0,,Gerçi şu anda epey kötü durumda.
Dialogue: 0,0:31:47.67,0:31:50.26,Main,Jinbe,0,0,0,,Bu merhum Tiger'ın arzusu.
Dialogue: 0,0:31:50.64,0:31:54.77,Main,Jinbe,0,0,0,,Bunun balık adamların kurtuluşuna ve \Nözgürlüğüne doğru bir adım olduğuna inanıyorum!
Dialogue: 0,0:31:54.77,0:32:01.15,Main,Jinbe,0,0,0,,Ancak af konusunda kaygı verici bir detay var.
Dialogue: 0,0:32:06.88,0:32:08.79,Main,Hachi,0,0,0,,Arlong-san!
Dialogue: 0,0:32:08.79,0:32:09.48,Main,Aladdin,0,0,0,,Arlong!
Dialogue: 0,0:32:14.68,0:32:18.74,Main,Hachi,0,0,0,,Arlong-san döndü! Geri döndü!
Dialogue: 0,0:32:23.31,0:32:27.00,Main,Jinbe,0,0,0,,Söylemek istediğin bir şey varsa söyle, Arlong!
Dialogue: 0,0:32:27.00,0:32:30.75,Main,Arlong,0,0,0,,Shichibukai olacaksın demek, Jinbe abi?
Dialogue: 0,0:32:30.75,0:32:35.21,Main,Arlong,0,0,0,,Yani insan hükümetinin köpeği oluyorsun!
Dialogue: 0,0:32:35.21,0:32:38.55,Main,Jinbe,0,0,0,,Tai abimizin sözlerini unuttun mu?!
Dialogue: 0,0:32:39.19,0:32:42.05,Main,Jinbe,0,0,0,,Kin ve nefretin hayatını kontrol etmesine son ver!
Dialogue: 0,0:32:43.36,0:32:45.73,Main,Arlong,0,0,0,,Yumuşamışsın, abi.
Dialogue: 0,0:32:45.73,0:32:50.30,Main,Arlong,0,0,0,,Senin emrinde olmanın benim için en\Ngüvenilir seçenek olduğuna eminim...
Dialogue: 0,0:32:50.30,0:32:51.90,Main,Arlong,0,0,0,,...ama bunu yapmayacağım!
Dialogue: 0,0:32:53.11,0:32:55.47,Main,Arlong,0,0,0,,Abimiz öldü!
Dialogue: 0,0:32:56.13,0:32:59.07,Main,Arlong,0,0,0,,Eski Arlong tayfamı yeniden kuracağım...
Dialogue: 0,0:32:59.62,0:33:02.17,Main,Arlong,0,0,0,,...ve kardeşlerimi yanımda götüreceğim.
Dialogue: 0,0:33:03.56,0:33:04.87,Main,Arlong,0,0,0,,Elveda.
Dialogue: 0,0:33:05.50,0:33:08.37,Main,Jinbe,0,0,0,,Arlong, sen...
Dialogue: 0,0:33:08.37,0:33:10.99,Main,Arlong,0,0,0,,Beni durdurmayı o kadar çok istiyorsan,...
Dialogue: 0,0:33:10.99,0:33:12.71,Main,Arlong,0,0,0,,...şimdi fırsatın var.
Dialogue: 0,0:33:13.59,0:33:16.35,Main,Arlong,0,0,0,,Öldür beni!
Dialogue: 0,0:33:16.35,0:33:17.76,Main,Hachi,0,0,0,,A-Arlong-san!
Dialogue: 0,0:33:18.70,0:33:22.29,Main,Arlong,0,0,0,,Öldüremezsen, özgürüm demektir!
Dialogue: 0,0:33:22.74,0:33:27.48,Main,Arlong,0,0,0,,Ben balık adam türünün öfkesiyim!
Dialogue: 0,0:33:28.03,0:33:31.13,Main,Jinbe,0,0,0,,Bu kadar küstahlık yeter!
Dialogue: 0,0:33:35.32,0:33:36.43,Main,Hachi,0,0,0,,Jinbe-san!
Dialogue: 0,0:33:38.56,0:33:40.36,Main,Arlong,0,0,0,,Bana uyar!
Dialogue: 0,0:33:55.44,0:33:56.84,Main,Hachi,0,0,0,,Jinbe-san!
Dialogue: 0,0:33:57.91,0:34:00.26,Main,Hachi,0,0,0,,Kes şunu!
Dialogue: 0,0:34:06.68,0:34:09.77,Main,Aladdin,0,0,0,,Götürün şunu gözümün önünden!
Dialogue: 0,0:34:13.19,0:34:16.52,Main,Aladdin,0,0,0,,Balık Adam Bölgesi'nde birlikte büyüdünüz. \NKardeş gibisiniz.
Dialogue: 0,0:34:16.52,0:34:20.85,Main,Aladdin,0,0,0,,Ne olursa olsun, onu öldüremezdin.
Dialogue: 0,0:34:21.43,0:34:25.65,Main,Jinbe,0,0,0,,O ahmak neden anlayamıyor?
Dialogue: 0,0:34:25.65,0:34:28.23,Main,Jinbe,0,0,0,,Tai Abinin asıl maksadını?!
Dialogue: 0,0:34:29.26,0:34:34.96,Main,Aladdin,0,0,0,,Nereye gittiğinin önemi yok. \NFazla sorun çıkarırsa, Denizciler harekete geçer.
Dialogue: 0,0:34:34.96,0:34:40.42,Main,Aladdin,0,0,0,,Ama harekete geçmezlerse ve o da kontrolde\Nçıkarsa, gidip onu kendimiz durduracağız.
Dialogue: 0,0:34:40.88,0:34:42.06,Main,Aladdin,0,0,0,,Kesinlikle.
Dialogue: 0,0:34:43.63,0:34:49.90,Main,Macro,0,0,0,,Ah, ah! Biz de kendi işlerimize \Ndönüyoruz, Kaptan Jinbe.
Dialogue: 0,0:34:49.90,0:34:51.62,Main,Someone,0,0,0,,Macro, sen...
Dialogue: 0,0:34:51.62,0:34:53.06,Main,Jinbe,0,0,0,,Bırakın ne isterse yapsın.
Dialogue: 0,0:34:53.43,0:34:55.50,Main,Macro,0,0,0,,Görüşürüz!
Dialogue: 0,0:34:59.64,0:35:02.57,Main,Arlong,0,0,0,,Kahretsin, aşırı güçlü pislik!
Dialogue: 0,0:35:04.58,0:35:06.49,Main,Kuroobi,0,0,0,,Hachi, gidelim.
Dialogue: 0,0:35:09.54,0:35:12.25,Main,Jinbe,0,0,0,,Güneş Korsanları...
Dialogue: 0,0:35:12.25,0:35:15.14,Main,Jinbe,0,0,0,,...üç gruba ayrıldı...
Dialogue: 0,0:35:15.84,0:35:20.41,Main,Jinbe,0,0,0,,...ve herkes kendi yoluna gitti.
