,0,0,1,2,0,5,10,10,10,1Style: TS paper,impress bt,50,&H001D221E,&H000000FF,&H001D221E,&H00000000,0,0,0,0,100,100,0,0,1,0.5,0,2,10,10,10,1Style: We Go lyrics,Duality,40.0,&H0098594E,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2.0,0,8,10,10,16,1Style: Author,Impress BT,20.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.7,0.7,9,10,10,10,1Style: Attack,Duality,32.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.0,1.0,7,12,12,12,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:02:30.00,0:02:40.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:17:22.30,0:17:32.30,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:32:46.50,0:32:49.52,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:02:29.93,0:02:31.96,Main,Neptune,0,0,0,,Nasıl gidiyor-jamon, Jinbe?Dialogue: 0,0:02:32.39,0:02:37.61,Main,Neptune,0,0,0,,Güneş Korsanları'nın Big Mom'ın müttefiği olacağı aklımın ucundan geçmezdi.Dialogue: 0,0:02:38.60,0:02:41.24,Main,Neptune,0,0,0,,O konuda keyifler yerinde mi?Dialogue: 0,0:02:41.24,0:02:45.80,Main,Jinbe,0,0,0,,Laf anlatması zor olan birisi olsa da bizlere karışmıyor.Dialogue: 0,0:02:47.06,0:02:49.72,Main,Neptune,0,0,0,,Asıl merak ettiğim...Dialogue: 0,0:02:49.72,0:02:55.35,Main,Neptune,0,0,0,,...senin gibi bir adama Fisher Tiger'dan başka biri için çalışmak zor gelmiyor mu?Dialogue: 0,0:02:55.35,0:02:57.15,Main,Jinbe,0,0,0,,Endişelenmeyin,...Dialogue: 0,0:02:57.15,0:03:01.42,Main,Jinbe,0,0,0,,...başkalarına patron demekle ilgili  bir sorunum yok.Dialogue: 0,0:03:01.42,0:03:03.62,Main,Jinbe,0,0,0,,Ayrıca Yeni Dünya'da...Dialogue: 0,0:03:03.62,0:03:09.91,Main,Jinbe,0,0,0,,...Yonko biriyle müttefik olmazsan  tayfanın güvenliği de bir o kadar riske giriyor.Dialogue: 0,0:03:11.13,0:03:16.35,Main,Neptune,0,0,0,,Öyle demek? Yaptıklarını Balık Adam Adası'nın iyiliği için yapıyormuşsun gibi geliyor bana.Dialogue: 0,0:03:16.35,0:03:19.85,Main,Neptune,0,0,0,,Böyle yapman sayesinde de...Dialogue: 0,0:03:19.85,0:03:25.03,Main,Neptune,0,0,0,,...Beyazsakal'ın göçüp gidişinin ardından adamız Big Mom'ın adı altında...Dialogue: 0,0:03:25.03,0:03:26.94,Main,Neptune,0,0,0,,...sağ salim yoluna devam ediyor.Dialogue: 0,0:03:26.94,0:03:29.68,Main,Jinbe,0,0,0,,Yok yahu, rastlantı yalnızca.Dialogue: 0,0:03:29.68,0:03:33.33,Main,Jinbe,0,0,0,,Adayı bizim korumamız gerekli özünde...Dialogue: 0,0:03:34.09,0:03:37.34,Main,Jinbe,0,0,0,,...ama kafalarımızda ödüller olan korsanlarız sonuçta...Dialogue: 0,0:03:39.08,0:03:40.46,Main,Jinbe,0,0,0,,Ancak Kral'ım...Dialogue: 0,0:03:41.44,0:03:46.28,Main,Jinbe,0,0,0,,...Big Mom'la yolumu ayırmayı planlamaktayım.Dialogue: 0,0:03:46.28,0:03:50.52,Main,Neptune,0,0,0,,Vay! Luffy-kun'un davetini kabul edeceksin öyle mi?Dialogue: 0,0:03:51.54,0:03:53.33,Flashbacks,Luffy,0,0,0,,Bak ne diyeceğim, Jinbe...Dialogue: 0,0:03:55.08,0:03:58.47,Flashbacks,Luffy,0,0,0,,Tayfama katılsana!Dialogue: 0,0:04:00.14,0:04:02.51,Main,Jinbe,0,0,0,,Evet, kararımı verdim.Dialogue: 0,0:04:03.80,0:04:07.42,Main,Jinbe,0,0,0,,Lakin izlenen yol minnet ve şeref yoludur.Dialogue: 0,0:04:07.42,0:04:11.38,Main,Jinbe,0,0,0,,İçilen sakeler ve ağızdan çıkanlarla mühürlenir verilen sözler.Dialogue: 0,0:04:11.84,0:04:16.18,Main,Jinbe,0,0,0,,Yani o sözü bozunca her şeye de hazırlıklı olmak gerekir.Dialogue: 0,0:04:16.18,0:04:18.12,Main,Jinbe,0,0,0,,Tek endişem...Dialogue: 0,0:04:18.12,0:04:22.23,Main,Jinbe,0,0,0,,...adamızın Big Mom'ın öfkesinin hedefi haline dönüşmesidir.Dialogue: 0,0:04:26.05,0:04:31.45,Main,Neptune,0,0,0,,Al yine yaptın... Her şeyden kendini sorumlu tutmayı bırak artık, Jinbe.Dialogue: 0,0:04:32.86,0:04:35.87,Main,Neptune,0,0,0,,Günü geldiğinde düşünürüz böyle şeyleri.Dialogue: 0,0:04:35.87,0:04:38.69,Main,Neptune,0,0,0,,Hem ben de bir şeyler düşünüyorum-jamon.Dialogue: 0,0:04:38.69,0:04:46.46,Main,Neptune,0,0,0,,Daha bugün, Balık Adam Bölgesi'nden 70 bin bıçkın delikanlı katıldı ordumuza.Dialogue: 0,0:04:47.79,0:04:49.88,Main,Neptune,0,0,0,,İçin rahat olsun-jamon.Dialogue: 0,0:04:53.16,0:04:58.95,Main,Neptune,0,0,0,,Hem ayrıca Big Mom'ın korsan bayrağının korumasını kaybedecek olursak da...Dialogue: 0,0:04:58.95,0:05:01.55,Main,Neptune,0,0,0,,...halihazırda kullanmak istediğim başka bir bayrak var zaten.Dialogue: 0,0:05:02.30,0:05:06.37,Main,Neptune,0,0,0,,Üzerinde hasır bir şapka giymiş kurukafa olan bir bayrak bu-jamon.Dialogue: 0,0:05:08.55,0:05:12.47,Main,Jinbe,0,0,0,,Anlıyorum! O bayrağı ben de çok severim!Dialogue: 0,0:05:19.13,0:05:21.46,Main,Right Minister,0,0,0,,Kral'ım!Dialogue: 0,0:05:21.46,0:05:25.00,Main,Right Minister,0,0,0,,Ço-Ço-Çok kötü bir şey oldu!Dialogue: 0,0:05:26.37,0:05:27.44,Main,Right Minister,0,0,0,,Kral'ım!Dialogue: 0,0:05:27.44,0:05:30.22,Main,Neptune,0,0,0,,Sorun nedir, Sağ Bakan'ım? Bu acele niye?Dialogue: 0,0:05:30.22,0:05:32.50,Main,Right Minister,0,0,0,,Çok kötü bir şey aklıma geldi!Dialogue: 0,0:05:32.50,0:05:37.54,Main,Right Minister,0,0,0,,Tüm hazinemizi Luffy-kunlar'a vermekle ilgili bir şey bu.Dialogue: 0,0:05:38.98,0:05:44.88,Main,Right Minister,0,0,0,,Onlarla karşılaştığınızda, lütfen  Tamate Kutusu'nu bize vermelerini ister misiniz?!Dialogue: 0,0:05:44.88,0:05:46.59,Main,Neptune,0,0,0,,Ağzından neler çıkıyor senin?!Dialogue: 0,0:05:46.59,0:05:50.26,Main,Neptune,0,0,0,,Verdiğim bir şeyi geri isteyecek değilim!Dialogue: 0,0:05:50.26,0:05:51.63,Main,Right Minister,0,0,0,,Öyle lakin...Dialogue: 0,0:05:55.20,0:05:58.09,Main,Neptune,0,0,0,,Ne dedin?! Açılırsa patlayacak mı?!Dialogue: 0,0:05:58.09,0:06:00.42,Main,Neptune,0,0,0,,Neden bomba koydunuz içine?Dialogue: 0,0:06:00.42,0:06:01.71,Main,Right Minister,0,0,0,,Şey...Dialogue: 0,0:06:01.71,0:06:06.02,Main,Right Minister,0,0,0,,On yıl önce, Tamate Kutusu'nun içindekiler çalındıktan sonra...Dialogue: 0,0:06:06.02,0:06:11.12,Main,Right Minister,0,0,0,,...olur da başkaları da çalmaya çalışırlarsa en azından ders olur diye düşünmüş...Dialogue: 0,0:06:11.12,0:06:16.15,Main,Right Minister,0,0,0,,...ve açıldığında patlayacak şekilde bombayla doldurmuştuk içini.Dialogue: 0,0:06:19.55,0:06:24.42,Main,Right Minister,0,0,0,,Hazine odası ve Tamate Kutusu'ndan sorumlu kişi benim nihayetinde.Dialogue: 0,0:06:24.42,0:06:27.00,Main,Neptune,0,0,0,,Peki, peki...Dialogue: 0,0:06:27.00,0:06:35.30,Main,Neptune,0,0,0,,Luffy-kunlar hazineyle geri dönecek olurlarsa  olayı iyice açıkla ve geri vermelerini iste.Dialogue: 0,0:06:35.30,0:06:37.13,Main,Right Minister,0,0,0,,Gerçekten affınıza sığınıyorum.Dialogue: 0,0:06:37.13,0:06:41.44,Main,Neptune,0,0,0,,Peki ama ya buraya gelmeden evvel açmaya kalkacak olurlarsa ne olacak?Dialogue: 0,0:06:41.44,0:06:43.53,Main,Right Minister,0,0,0,,O konuda ben de endişeliyim.Dialogue: 0,0:06:43.53,0:06:45.43,Main,Guard,0,0,0,,Kral'ım, Sağ Bakan'ım!Dialogue: 0,0:06:45.43,0:06:47.91,Main,Guard,0,0,0,,Luffy-sanlar  Ryugu Sarayı'na az önce döndüler.Dialogue: 0,0:06:47.95,0:06:50.54,Main,Right Minister,0,0,0,,Güzel!  Bir şeyleri yok, iyiler değil mi?!Dialogue: 0,0:06:50.54,0:06:54.24,Main,Right Minister,0,0,0,,Şükürler olsun! Endişelerim boşunaymış demek?Dialogue: 0,0:06:57.05,0:06:58.12,Main,Peoplez,0,0,0,,Neee?!Dialogue: 0,0:06:58.76,0:06:59.80,Main,Right Minister,0,0,0,,Hazinenin hepsini...Dialogue: 0,0:07:00.25,0:07:01.48,Main,Neptune,0,0,0,,...Big Mom'a mı...Dialogue: 0,0:07:02.08,0:07:03.91,Main,Nami,0,0,0,,...verdiniz?!Dialogue: 0,0:07:03.91,0:07:07.80,Main,Luffy,0,0,0,,Şekerleme vermezseniz adayı yıkacağım diyordu kadın!Dialogue: 0,0:07:07.80,0:07:12.21,Main,Luffy,0,0,0,,Nasıl bir beyin varsa?! Hani et olsa anlarım da, et olsa!Dialogue: 0,0:07:12.21,0:07:13.62,Main,Luffy,0,0,0,,Ama içiniz rahat olsun!Dialogue: 0,0:07:13.62,0:07:17.24,Main,Luffy,0,0,0,,Köküne kadar karşılık verdim!Dialogue: 0,0:07:17.24,0:07:20.13,Main,Usopp and Chopper and Brook,0,0,0,,Yonko'ya karşılık mı verdin?!Dialogue: 0,0:07:20.13,0:07:22.23,Main,Jinbe,0,0,0,,Big Mom'a kafa mı tuttun!?Dialogue: 0,0:07:25.01,0:07:27.22,Main,Shirahoshi,0,0,0,,Çok güçlüsün gerçekten, Luffy-sama!Dialogue: 0,0:07:28.27,0:07:30.35,Main,Usopp,0,0,0,,Olay o mu sanıyorsun?!Dialogue: 0,0:07:32.36,0:07:34.57,Main,Shirahoshi,0,0,0,,Burunn-sama, çok kötüsün!Dialogue: 0,0:07:34.57,0:07:37.95,Main,Usopp,0,0,0,,Adım Usopp benim be!Dialogue: 0,0:07:37.95,0:07:39.17,Main,Usopp,0,0,0,,Ayrıca özür de dilerim!Dialogue: 0,0:07:39.17,0:07:42.22,Main,Jinbe,0,0,0,,Eyvahlar olmasın, hiç iyi değil bu.Dialogue: 0,0:07:42.22,0:07:47.25,Main,Jinbe,0,0,0,,İşler daha da sarpa sarmadan Big Mom'la aramdaki bağları koparmalıyım.Dialogue: 0,0:07:47.74,0:07:53.68,Main,Jinbe,0,0,0,,Siz de bundan böyle Big Mom'ı daha da kızdıracak şeyler yapmaktan kesinlikle kaçının!Dialogue: 0,0:07:53.68,0:07:57.91,Main,Usopp,0,0,0,,Kaçınacağız tabii! Yonko kendisi,  canımız o kadar ucuz mu sanıyorsun?Dialogue: 0,0:07:57.91,0:08:00.27,Main,Neptune,0,0,0,,Yandığımızın resmidir, Sağ Bakan'ım!Dialogue: 0,0:08:00.27,0:08:02.07,Main,Right Minister,0,0,0,,Böyle bir şeyin olduğuna inanamıyorum!Dialogue: 0,0:08:02.07,0:08:05.57,Main,Right Minister,0,0,0,,Tamate Kutusu'nu Big Mom'a vermişlerse...Dialogue: 0,0:08:05.57,0:08:08.16,Main,Right Minister,0,0,0,,...ve olur da kutuyu kendi açacak olursa...Dialogue: 0,0:08:08.18,0:08:11.31,Main,Right Minister,0,0,0,,...patlamanın Luffy-kun'un bir meydan okuması olduğunu düşünecektir.Dialogue: 0,0:08:11.51,0:08:13.60,Main,Neptune,0,0,0,,Öyle böyle değil, ayvayı soymadan yedik-jamon!Dialogue: 0,0:08:16.11,0:08:19.05,Main,Sanji,0,0,0,,Ama başka bir seçeneğimiz de yoktu.Dialogue: 0,0:08:19.05,0:08:21.19,Main,Zoro,0,0,0,,Olmuşla ölmüşe çare yok sonuçta.Dialogue: 0,0:08:21.19,0:08:25.87,Main,Nami,0,0,0,,Kısasa kısas bir durumdu sonuçta, karşı gelmeden duramadınız değil mi?Dialogue: 0,0:08:25.87,0:08:28.81,Main,Luffy,0,0,0,,Aynen öyle ya! Kim olursa olsun--Dialogue: 0,0:08:31.27,0:08:32.27,Main,Nami,0,0,0,,Neden...Dialogue: 0,0:08:32.27,0:08:35.20,Main,Nami,0,0,0,,...hazinemin hepsini verdiniz be?!Dialogue: 0,0:08:35.20,0:08:37.22,Main,Usopp and Chopper and Brook,0,0,0,,Kızdığı şeye bak?!Dialogue: 0,0:08:37.22,0:08:38.36,Main,Nami,0,0,0,,Gebertirim be sizi!Dialogue: 0,0:08:38.36,0:08:39.97,Main,Chopper,0,0,0,,Geberttin zaten!Dialogue: 0,0:08:40.42,0:08:43.99,Main,Luffy,0,0,0,,Pekâlâ! Yeni Dünya'ya gidelim!Dialogue: 0,0:08:43.99,0:08:45.67,Main,Usopp and Chopper and Brook,0,0,0,,Mezarı kazdık, içine de girelim diyorsun yani?!Dialogue: 0,0:08:46.24,0:08:49.48,Main,Usopp,0,0,0,,Bittik! Öldük biz!Dialogue: 0,0:08:52.30,0:08:55.50,Narrator,Narrator,0,0,0,,Bu sırada şeker fabrikası yakınlarında bir yer.Dialogue: 0,0:08:56.03,0:09:01.59,Main,Caribou,0,0,0,,Lanet olsun! Birisi ben uyurken tüm hazinemi almış ya!Dialogue: 0,0:09:01.59,0:09:06.50,Main,Caribou,0,0,0,,Kim olduğunu bir bulayım çanlarına ot tıkayacağım!Dialogue: 0,0:09:06.92,0:09:10.96,Main,Caribou,0,0,0,,Dağlar kadar hazine ve Deniz Kızı Prenses'in sırrıyla gittiğimde...Dialogue: 0,0:09:10.96,0:09:15.45,Main,Caribou,0,0,0,,...o kişi beni kesin çok sevecektir!Dialogue: 0,0:09:16.40,0:09:17.28,Main,Caribou,0,0,0,,İnsanlar toplaşmışlar!Dialogue: 0,0:09:17.70,0:09:21.01,Main,Caribou,0,0,0,,Şu büyük bohçalar taşıyan ikili de neyin nesi?!Dialogue: 0,0:09:21.01,0:09:23.73,Main,Caribou,0,0,0,,Benim bunlar! Hiç şüphesiz hem de!Dialogue: 0,0:09:23.73,0:09:27.84,Main,Caribou,0,0,0,,Ne sanıyor bunlar kendini?! Canlı canlı gömeceğim ikisini de!Dialogue: 0,0:09:27.84,0:09:32.91,Main,Caribou,0,0,0,,Ben çaldım onları! Geri verin!Dialogue: 0,0:09:33.35,0:09:34.12,Main,Tamago,0,0,0,,Bu...Dialogue: 0,0:09:34.12,0:09:37.23,Main,Pekoms,0,0,0,,Bir yerlerden çıkartacağım ama-gao!Dialogue: 0,0:09:38.50,0:09:40.09,Main,Pekoms,0,0,0,,Aha, işte burada.Dialogue: 0,0:09:40.09,0:09:44.71,Main,Pekoms,0,0,0,,Islak Saç Caribou... Adı yeni duyulmaya başlanan bir acemi.Dialogue: 0,0:09:44.71,0:09:47.36,Main,Pekoms,0,0,0,,200 milyon da ödül var kafasında.Dialogue: 0,0:09:47.36,0:09:49.69,Main,Citizen,0,0,0,,200 milyon ödül mü dediniz?!Dialogue: 0,0:09:50.87,0:09:53.91,Main,Caribou,0,0,0,,Yalvarmak için artık çok geç!Dialogue: 0,0:10:11.03,0:10:15.97,Main,Caribou,0,0,0,,Delik deşik olacaksınız!Dialogue: 0,0:10:17.31,0:10:18.14,Main,Citizen,0,0,0,,Pekoms-shii!Dialogue: 0,0:10:25.19,0:10:26.90,Main,Caribou,0,0,0,,Bu da ne böyle?!Dialogue: 0,0:10:33.10,0:10:33.87,Main,Caribou,0,0,0,,Kaplumbağa mı?Dialogue: 0,0:10:47.20,0:10:48.92,Main,Caribou,0,0,0,,Şeytan Meyvesi demek?!Dialogue: 0,0:10:50.74,0:10:52.65,Main,Pekoms,0,0,0,,Öyle tabii!Dialogue: 0,0:10:55.01,0:10:58.25,Main,Caribou,0,0,0,,Ama Zoan tipisin!Dialogue: 0,0:10:59.46,0:11:01.64,Main,Caribou,0,0,0,,Geber!Dialogue: 0,0:11:22.13,0:11:29.29,Main,Pekoms,0,0,0,,Ölümsüz olduklarını sanan Logia tipi Şeytan Meyvesi yemiş kişiler çok yaşamazlar.Dialogue: 0,0:11:29.29,0:11:33.21,Main,Tamago,0,0,0,,Az pişmiş kişiler beni hayal kırıklığına uğratıyorlar-soir.Dialogue: 0,0:11:33.21,0:11:35.80,Main,Tamago,0,0,0,,Gidelim haydi-bon, Pekoms.Dialogue: 0,0:11:35.80,0:11:37.48,Main,Tamago,0,0,0,,Mama'nın yanına...Dialogue: 0,0:11:38.20,0:11:42.69,Main,Citizen,0,0,0,,200 milyonluk birini tek bir yumrukla...Dialogue: 0,0:11:42.69,0:11:47.19,Main,Citizen,0,0,0,,Pekoms-shii'nin de kafasında yanılmıyorsam 330 milyon beli ödül vardı.Dialogue: 0,0:11:47.19,0:11:52.29,Main,Citizen,0,0,0,,300 milyondan fazla?!  Yonko, böylesi adamlara hükmediyor, öyle mi?!Dialogue: 0,0:11:53.01,0:11:56.06,Main,Citizen,0,0,0,,Luffy-sanlar iyi olacaklar mı dersin?Dialogue: 0,0:11:57.70,0:12:03.49,Narrator,Narrator,0,0,0,,Bu sırada Yeni Dünya'da, Red Line'a yakın sularda.Dialogue: 0,0:12:13.58,0:12:14.87,Main,Pirate,0,0,0,,Ateş!Dialogue: 0,0:12:21.96,0:12:25.16,Main,Marine,0,0,0,,Acele edin!  Saat iki yönünde bir tane daha gözüktü!Dialogue: 0,0:12:25.16,0:12:28.47,Main,Marine,0,0,0,,Korsan gemileri birbiri ardına yüzeye çıkmaya başladılar!Dialogue: 0,0:12:29.31,0:12:30.60,Main,Marine,0,0,0,,Neler oluyor böyle?!Dialogue: 0,0:12:44.81,0:12:47.51,Main,Marine,0,0,0,,Böyle şeylerle gözüne girmeye mi çalışıyorsun?!Dialogue: 0,0:12:47.51,0:12:49.42,Main,Marine,0,0,0,,Kapa çeneni be! İşine bak!Dialogue: 0,0:12:50.41,0:12:54.60,Main,Pirate,0,0,0,,Cehennemden yeni kurtuldum! Burada ölmek istemiyorum!Dialogue: 0,0:12:55.21,0:12:57.57,Main,Marine,0,0,0,,Büyük bir tane geliyor!Dialogue: 0,0:12:58.51,0:13:00.23,Main,Marine,0,0,0,,Kaptan tehlikede!Dialogue: 0,0:13:00.23,0:13:02.40,Main,Marine,0,0,0,,Kollarımın arasına alıp  öyle koruyacağım onu!Dialogue: 0,0:13:02.40,0:13:05.53,Main,Marine,0,0,0,,O önemli görevi ben gerçekleştireceğim!Dialogue: 0,0:13:05.53,0:13:06.33,Main,Tashigi,0,0,0,,Öff!Dialogue: 0,0:13:08.84,0:13:09.53,Main,Tashigi,0,0,0,,Yine mi?!Dialogue: 0,0:13:17.75,0:13:20.42,Main,Marine,0,0,0,,Süper! İşte bu ya, Kaptan-chan!Dialogue: 0,0:13:21.26,0:13:23.39,Main,Marine,0,0,0,,Ne güzel kılıç kullanmaktır o!?Dialogue: 0,0:13:23.39,0:13:26.25,Main,Marine,0,0,0,,Tek güzel olan kılıç kullanması olsa keşke!Dialogue: 0,0:13:26.25,0:13:28.61,Main,Tashigi,0,0,0,,Beyler, biraz daha ciddi olun!Dialogue: 0,0:13:30.89,0:13:33.25,Main,Tashigi,0,0,0,,Top mermilerini nasıl savuşturacağınızı hepiniz çok iyi biliyorsunuz!Dialogue: 0,0:13:33.25,0:13:36.38,Main,Tashigi,0,0,0,,Burada bir şeyler yapmazsanız, nerede yapacaksınız?!Dialogue: 0,0:13:36.38,0:13:37.98,Main,Marine,0,0,0,,Kaptan'ım, direğe konuşuyorsunuz!Dialogue: 0,0:13:39.35,0:13:41.71,Main,Marine,0,0,0,,Gözlüklerinizi tertemiz yaptım!Dialogue: 0,0:13:41.71,0:13:42.93,Main,Tashigi,0,0,0,,Teşekkür ederim.Dialogue: 0,0:13:42.93,0:13:46.36,Main,Marine,0,0,0,,Ay çok şirin! İğrenç G-5'in yegâne çiçeği!Dialogue: 0,0:13:46.36,0:13:48.49,Main,Tashigi,0,0,0,,Savaşın ortasında oyun oynamayı bırakın!Dialogue: 0,0:13:48.87,0:13:50.93,Main,Tashigi,0,0,0,,Öleceksiniz bu gidişle!Dialogue: 0,0:13:50.93,0:13:53.14,Main,Tashigi,0,0,0,,Yetti ama bu G-5 bana!Dialogue: 0,0:13:53.14,0:13:54.89,Main,Tashigi,0,0,0,,Donanmadan demeye dilim varmıyor size!Dialogue: 0,0:13:56.72,0:13:59.31,Main,Tashigi,0,0,0,,Sırf kadınım diye beni hafife almaya kalkarsanız bağışlamam sizi!Dialogue: 0,0:13:59.31,0:14:04.33,Main,Marine,0,0,0,,Hafife almak da neymiş? Kaptan Tashigi'mizin şirinliğinden dünyamız şaşıyor yalnızca...Dialogue: 0,0:14:04.33,0:14:06.85,Main,Tashigi,0,0,0,,Ben de ondan bahsediyorum ya!Dialogue: 0,0:14:06.85,0:14:08.90,Main,Tashigi,0,0,0,,Donanmadan olduğunuzu o aklınıza-Dialogue: 0,0:14:08.90,0:14:10.43,Main,Smoker,0,0,0,,Yeter bu kadar, Tashigi!Dialogue: 0,0:14:11.95,0:14:13.24,Main,Smoker,0,0,0,,Sorgudayım şurada.Dialogue: 0,0:14:13.93,0:14:15.45,Main,Tashigi,0,0,0,,Bağışlayın!Dialogue: 0,0:14:16.03,0:14:22.35,Main,Smoker,0,0,0,,Anlıyorum... Demek hepiniz zeminde Hody Jones tarafından yakalandınız öyle mi?Dialogue: 0,0:14:22.42,0:14:28.14,Main,Smoker,0,0,0,,Geçtiğimiz bir aydır hiçbir aceminin Balık Adam Adasını geçememesine şaşırmamalı.Dialogue: 0,0:14:28.14,0:14:31.91,Main,Pirate,0,0,0,,Yakalanmak mı?! Hayır! Köleydik resmen!Dialogue: 0,0:14:31.91,0:14:37.35,Main,Pirate,0,0,0,,Ama savaş başlatan Hody ve tayfasını, bir grup korsan yenerek...Dialogue: 0,0:14:37.35,0:14:40.02,Main,Pirate,0,0,0,,...bizi serbest bıraktılar!Dialogue: 0,0:14:40.02,0:14:41.69,Main,Smoker,0,0,0,,Bir grup korsan mı?Dialogue: 0,0:14:41.69,0:14:43.94,Main,Pirate,0,0,0,,Evet ama kim olduklarını söylemeyeceğim!Dialogue: 0,0:14:44.78,0:14:47.52,Main,Pirate,0,0,0,,Salak! Söyle gitsin işte!Dialogue: 0,0:14:47.52,0:14:51.48,Main,Pirate,0,0,0,,Bunlar bildiğimiz donanma askerleri değil! G-5 karşındakiler!Dialogue: 0,0:14:51.48,0:14:54.76,Main,Pirate,0,0,0,,Korsanları yem olarak kullanıp balık tutma olsun...Dialogue: 0,0:14:54.76,0:14:57.35,Main,Pirate,0,0,0,,...korsanlardan kamp ateşi yakmak olsun...Dialogue: 0,0:14:57.88,0:15:02.22,Main,Pirate,0,0,0,,Karargâhtan gelen emirlere bile kulak asmayan  donanmanın en azılı haydutlarının bulunduğu bir grup!Dialogue: 0,0:15:02.22,0:15:05.35,Main,Pirate,0,0,0,,Böyle diretirsen neler yapacakları hiç belli olmaz!Dialogue: 0,0:15:05.35,0:15:08.47,Main,Pirate,0,0,0,,Hepsini geçtim bir de kalkıp...Dialogue: 0,0:15:09.23,0:15:12.62,Main,Pirate,0,0,0,,..."Beyaz Avcı" Smoker tarafından yakalandık!Dialogue: 0,0:15:17.66,0:15:20.96,Main,Marine,0,0,0,,Smoker Kaptan!  Bunları bana versene!Dialogue: 0,0:15:22.41,0:15:23.40,Main,Pirate,0,0,0,,Dur biraz, sakın yapma!Dialogue: 0,0:15:24.20,0:15:26.25,Main,Pirate,0,0,0,,Adlarını söyleyeceğim bak! Kurtar beni!Dialogue: 0,0:15:27.89,0:15:29.72,Main,Pirate,0,0,0,,Hodyler'i yenen kişiler...Dialogue: 0,0:15:33.49,0:15:35.32,Main,Pirate,0,0,0,,...Hasır Şapkalar'dı!Dialogue: 0,0:15:36.80,0:15:38.86,Main,Smoker,0,0,0,,Biliyorum.Dialogue: 0,0:15:39.67,0:15:40.69,Main,Smoker,0,0,0,,Aptal!Dialogue: 0,0:15:42.06,0:15:45.95,Main,Caimie,0,0,0,,Madam Sharley,  Luffy-chinler adadan ayrılıyorlarmış.Dialogue: 0,0:15:47.77,0:15:51.20,Main,Shyarly,0,0,0,,Öyle demek? İstersen yolcu etmeye gidebilirsin.Dialogue: 0,0:15:51.20,0:15:52.57,Main,Caimie,0,0,0,,Sağ olun!Dialogue: 0,0:15:53.56,0:15:56.53,Main,Mermaids,0,0,0,,Madam! Biz de gidebilir miyiz?Dialogue: 0,0:15:57.07,0:16:01.56,Main,Shyarly,0,0,0,,Hepiniz de mi? Kafeyi kapatmamız lazım o zaman ama.Dialogue: 0,0:16:01.56,0:16:05.71,Main,Shyarly,0,0,0,,Hody ahmağı da gittiğine göre turistler yine gelmeye başlayacaklar.Dialogue: 0,0:16:05.71,0:16:09.79,Main,Shyarly,0,0,0,,O yüzden de sizlerden yine çok çalışmanızı isteyeceğim, kızlar!Dialogue: 0,0:16:09.79,0:16:11.72,Main,Ishilly,0,0,0,,Siz bize güvenin, madam!Dialogue: 0,0:16:20.29,0:16:21.81,Main,Shyarly,0,0,0,,Küreyi mi merak ettin?Dialogue: 0,0:16:22.24,0:16:25.59,Main,Shyarly,0,0,0,,Önemi yok, bundan sonra kullanmayacağım.Dialogue: 0,0:16:25.59,0:16:28.33,Main,Shyarly,0,0,0,,Geleceğe bakmak yok artık.Dialogue: 0,0:16:29.94,0:16:33.90,Main,Shyarly,0,0,0,,Hasır Şapkalı Luffy, Balık Adam Adası'nı yok edecek...Dialogue: 0,0:16:34.88,0:16:38.69,Main,Shyarly,0,0,0,,Öyle korkunç bir geleceği görmek istemezdim.Dialogue: 0,0:16:39.65,0:16:44.70,Main,Shyarly,0,0,0,,Bu seferki öngörülerimde yanılmışsam buna çok sevineceğim.Dialogue: 0,0:16:45.90,0:16:50.43,Thoughts,Caimie,0,0,0,,Yanılma payı olmadığını bildiğinden hepimizden daha çok korkuyor aslında.Dialogue: 0,0:16:51.03,0:16:53.97,Thoughts,Caimie,0,0,0,,Gördüğü gelecek bu ân için değildi belki.Dialogue: 0,0:16:53.97,0:16:57.82,Thoughts,Caimie,0,0,0,,Belki bir yıl belki de çok daha sonra yaşanacak.Dialogue: 0,0:16:57.82,0:17:00.29,Thoughts,Caimie,0,0,0,,Lakin hemen yanlıştır deyip geçemeyiz!Dialogue: 0,0:17:01.96,0:17:05.92,Main,Caimie,0,0,0,,Ama şu da var ki Madam,  Luffy-chinler asla öyle bir şey yapmaz-Dialogue: 0,0:17:05.92,0:17:06.73,Main,Shyarly,0,0,0,,Camie!Dialogue: 0,0:17:08.59,0:17:13.08,Main,Shyarly,0,0,0,,Arkadaşlarından şüphe duyduğum için bağışla beni.Dialogue: 0,0:17:13.08,0:17:15.90,Main,Shyarly,0,0,0,,Biliyorum. Hasır Şapkalı gence...Dialogue: 0,0:17:16.32,0:17:18.07,Main,Shyarly,0,0,0,,...güvenebilirim, değil mi?Dialogue: 0,0:17:20.24,0:17:21.39,Main,Caimie,0,0,0,,Evet!Dialogue: 0,0:17:32.20,0:17:34.26,Main,Citizen,0,0,0,,Bizden size hediye! Yükleyin geminize!Dialogue: 0,0:17:34.26,0:17:35.98,Main,Franky,0,0,0,,Peki, çok sağ olun!Dialogue: 0,0:17:38.27,0:17:43.02,Main,Shirahoshi,0,0,0,,Luffy-sama ahalisi, gerçekten gidiyor musunuz şimdi?!Dialogue: 0,0:17:43.02,0:17:48.89,Main,Shirahoshi,0,0,0,,Tam arkadaş olduk derken... Bir güncük daha...Dialogue: 0,0:17:48.89,0:17:50.74,Main,Shirahoshi,0,0,0,,Hayır! Bir hafta daha...Dialogue: 0,0:17:50.74,0:17:53.08,Main,Shirahoshi,0,0,0,,Hayır! Bir yılcık daha kalsanız olmaz mı?!Dialogue: 0,0:17:53.08,0:17:57.26,Main,Luffy,0,0,0,,Seninle karşılaştığımız günden beri hep ağlıyorsun be, Zayıf-hoshi!Dialogue: 0,0:17:57.26,0:18:00.12,Main,Shirahoshi,0,0,0,,Ço-Çok özür dilerim!Dialogue: 0,0:18:00.74,0:18:02.60,Main,Shirahoshi,0,0,0,,Ağlamayacağım o zaman artık!Dialogue: 0,0:18:05.87,0:18:08.58,Main,Sanji,0,0,0,,Bu rüya gibi günün, Balık Adam Adası prensesinin...Dialogue: 0,0:18:09.18,0:18:13.37,Main,Sanji,0,0,0,,...ardımızdan gözyaşı dökeceği ânın, geleceğini hiç beklemiyordum!Dialogue: 0,0:18:13.46,0:18:17.26,Main,Sanji,0,0,0,,Birkaç sene daha kalabilsem keşke burada!Dialogue: 0,0:18:18.52,0:18:19.99,Main,Brook,0,0,0,,Aynı duyguları paylaşıyoruz!Dialogue: 0,0:18:19.99,0:18:24.11,Main,Brook,0,0,0,,Son şarkımda Balık Adam Adasında geçirilebilecek rüya gibi bir hayattan bahsediyorum!Dialogue: 0,0:18:25.52,0:18:29.60,Main,Brook,0,0,0,,Sabah uyandığında dökülüyor dilinden "İyi ningyo sabahları!"Dialogue: 0,0:18:25.52,0:18:29.60,Note,TL Note,0,0,0,,Ningyo: Deniz KızıDialogue: 0,0:18:29.60,0:18:33.67,Main,Sanji,0,0,0,,Ah, sevgili deniz kızlarım!Dialogue: 0,0:18:34.97,0:18:36.67,Main,Zoro,0,0,0,,Güzel bir fikirmiş bak.Dialogue: 0,0:18:36.67,0:18:40.53,Main,Zoro,0,0,0,,Çok istiyorsan kal, Kanlıburun-kun.Dialogue: 0,0:18:41.21,0:18:44.49,Main,Sanji,0,0,0,,Ne dedin sen bana öyle, yosun kafa seni!?Dialogue: 0,0:18:44.49,0:18:46.74,Main,Zoro,0,0,0,,Kimmiş lan o yosun kafa, vurayım mı?!Dialogue: 0,0:18:47.19,0:18:49.06,Main,Right Minister,0,0,0,,Kral'ım!Dialogue: 0,0:18:49.78,0:18:51.57,Main,Right Minister,0,0,0,,Bence söylemeliyiz.Dialogue: 0,0:18:51.57,0:18:55.37,Main,Right Minister,0,0,0,,Luffy-kunlar'a Big Mom'a yolladıkları Tamate Kutusundan bahsetmeliyiz.Dialogue: 0,0:18:55.45,0:18:59.93,Main,Right Minister,0,0,0,,Açıldığında büyük bir patlamaya neden olacağını söyleyelim!Dialogue: 0,0:19:03.34,0:19:06.27,Main,Neptune,0,0,0,,Haklısın da şuna bir baksana.Dialogue: 0,0:19:11.30,0:19:15.64,Main,Usopp,0,0,0,,Öldük biz!  Yonko, bize göz koydu!Dialogue: 0,0:19:15.76,0:19:19.25,Main,Usopp,0,0,0,,Yeni Dünya'ya, öteki dünyaya aktarma yapmak için geçiyoruz resmen!Dialogue: 0,0:19:19.45,0:19:26.39,Main,Chopper,0,0,0,,Bundan sonra ele geçireceğimiz hazineleri Big Mom'a versek bizi affeder mi dersin?Dialogue: 0,0:19:26.39,0:19:31.52,Main,Neptune & Right Minister,0,0,0,,Halihazırda bir de bomba yolladıklarını hayatta söyleyemeyiz!Dialogue: 0,0:19:32.14,0:19:35.94,Main,Neptune,0,0,0,,Hem zaten o bombalar on senelik!Dialogue: 0,0:19:35.94,0:19:38.91,Main,Neptune,0,0,0,,Belki de patlamazlar, Sağ Bakan'ım!Dialogue: 0,0:19:38.91,0:19:42.00,Main,Right Minister,0,0,0,,Aman Kral'ım,  bu ne olumlu düşünmektir böyle?!Dialogue: 0,0:19:42.04,0:19:45.58,Main,Right Minister,0,0,0,,Ama iyi dediniz,  Ryugu Sarayı epey rutubetli bir yer...Dialogue: 0,0:19:45.58,0:19:48.71,Main,Right Minister,0,0,0,,...kaldı ki kutuyu koskoca Big Mom açacak değil ya!?Dialogue: 0,0:19:48.71,0:19:51.98,Main,Neptune,0,0,0,,Öyleyse şimdilik iyi olmalarını umut edelim.Dialogue: 0,0:19:52.59,0:19:54.94,Main,Robin,0,0,0,,Fısır fısır ne konuşuyorsunuz siz orada?Dialogue: 0,0:19:56.04,0:19:58.34,Main,Nami,0,0,0,,Bu da nedir?Dialogue: 0,0:19:58.34,0:20:03.06,Main,Left Minister,0,0,0,,Yeni Dünya için yapılmış bir Seyir Pusulası.  Yanınıza alın.Dialogue: 0,0:20:03.06,0:20:07.48,Main,Left Minister,0,0,0,,Tek uçlu olanıyla gitmeyi düşündüğünüze inanamıyorum!Dialogue: 0,0:20:07.48,0:20:11.82,Main,Luffy,0,0,0,,Aha, ne oluyor? Yeni bir Seyir Pusulamız mı var?Dialogue: 0,0:20:11.82,0:20:13.99,Main,Luffy,0,0,0,,Vay canına, süpermiş!Dialogue: 0,0:20:15.67,0:20:18.64,Main,Nami,0,0,0,,Üç farklı ucu var bunun, neden ki?Dialogue: 0,0:20:18.64,0:20:22.78,Main,Left Minister,0,0,0,,Sizleri buraya getiren Seyir Pusulası'na bir bak!Dialogue: 0,0:20:25.87,0:20:30.83,Main,Nami,0,0,0,,Kıpırdıyor!  Şimdiye sabitlenir diye düşünmüştüm!Dialogue: 0,0:20:30.83,0:20:35.20,Main,Left Minister,0,0,0,,Sabitlendi zaten! Bundan sonra sabitlenmeleri yarım gün sürecek zaten.Dialogue: 0,0:20:35.20,0:20:41.22,Main,Left Minister,0,0,0,,Grand Line'ın ilk yarısında, Seyir Pusulası'nın bir sonraki adanın manyetik dalgalarını kaydetmesini bekliyor...Dialogue: 0,0:20:41.22,0:20:44.35,Main,Left Minister,0,0,0,,...ve geminizi bu doğrultuda yürütüyordunuz!Dialogue: 0,0:20:44.84,0:20:48.08,Main,Left Minister,0,0,0,,Lakin buradan öte  karşılaşacağınız sularda...Dialogue: 0,0:20:48.08,0:20:52.50,Main,Left Minister,0,0,0,,...akıntılar ve farklı iklimlerin yanısıra sizin bel bağladığınız...Dialogue: 0,0:20:52.50,0:20:55.92,Main,Left Minister,0,0,0,,...o manyetik alanları değişen adalar da var.Dialogue: 0,0:20:56.84,0:21:00.98,Main,Left Minister,0,0,0,,Bu manyetik alan kimi adalardaysa kökten yok olabiliyor.Dialogue: 0,0:21:00.98,0:21:04.08,Main,Nami,0,0,0,,Ne?!  Öyle olursa adayı bulamayız ama!?Dialogue: 0,0:21:04.08,0:21:07.62,Main,Left Minister,0,0,0,,Tek uçlu olanla yola çıkarsanız dediğin doğru, kaybolursunuz.Dialogue: 0,0:21:07.62,0:21:10.66,Main,Left Minister,0,0,0,,Peki ama üç uç olunca ne oluyor dersin?Dialogue: 0,0:21:12.07,0:21:16.15,Main,Nami,0,0,0,,Uçlardan biri aynı bizim tek uçlu gibi kıpırdıyor ama...Dialogue: 0,0:21:16.15,0:21:18.55,Main,Nami,0,0,0,,...diğer ikisi sabitler.Dialogue: 0,0:21:18.55,0:21:23.38,Main,Left Minister,0,0,0,,Üçü de farklı adaların manyetik dalgalarını kaydederler.Dialogue: 0,0:21:23.38,0:21:30.01,Main,Left Minister,0,0,0,,Yani özetle bu üç rotadan hangisini gözünüz kesiyorsa onu seçip yola koyulabilirsiniz.Dialogue: 0,0:21:30.01,0:21:33.59,Main,Left Minister,0,0,0,,Hayatlarınız da bu seçime bağlı olacak genelde.Dialogue: 0,0:21:33.59,0:21:40.49,Main,Left Minister,0,0,0,,İyi bir rotacı, ucun yapacağı minik kıpırtılardan bile  hangi yolun daha güvenli olduğunu anlayabilir.Dialogue: 0,0:21:40.49,0:21:44.10,Main,Left Minister,0,0,0,,İşi basite dökmek gerekirse, uç ne kadar çok kıpırdıyorsa...Dialogue: 0,0:21:45.13,0:21:48.78,Main,Left Minister,0,0,0,,...işaret ettiği yöndeki ada da bir o kadar tehlikeli demek.Dialogue: 0,0:21:48.78,0:21:54.41,Main,Left Minister,0,0,0,,Adada meydana gelen bir şeylerin manyetik dalgalarda değişime yol açtığı anlamına gelecek bu.Dialogue: 0,0:21:54.41,0:21:56.52,Main,Nami,0,0,0,,Yok artık!? Neymiş o öyle ya?!Dialogue: 0,0:21:56.52,0:21:58.88,Main,Nami,0,0,0,,Keşke hiç söylemeseydin!Dialogue: 0,0:21:58.88,0:22:00.48,Main,Chopper,0,0,0,,Hangi yönün tehlikeli olduğunu anlayacak mıyız?!Dialogue: 0,0:22:00.48,0:22:03.18,Main,Usopp,0,0,0,,Yandık!  Kır o Seyir Pusulası'nı çabuk!Dialogue: 0,0:22:03.18,0:22:07.63,Main,Left Minister,0,0,0,,Neden? Güvenli yoldan gitmeniz hayatlarınızı kurtaracak belki de?!Dialogue: 0,0:22:10.15,0:22:12.13,Main,Luffy,0,0,0,,Bir bakalım.Dialogue: 0,0:22:13.43,0:22:15.51,Main,Usopp,0,0,0,,Ay-Ayvayı yuttuk!Dialogue: 0,0:22:17.19,0:22:19.75,Main,Nami,0,0,0,,Olamaz!Dialogue: 0,0:22:19.75,0:22:25.54,Main,Luffy,0,0,0,,Ortadaki resmen beni seç dercesine kıpırdıyor! Eğlence o yönde gibi!Dialogue: 0,0:22:25.54,0:22:29.04,Main,Usopp,0,0,0,,Du-Du-Duymuş!Dialogue: 0,0:22:29.73,0:22:35.82,Main,Nami,0,0,0,,Luffy! Sen az bi' karışma!  Ne yöne gideceğimize artık ben karar vereceğim!Dialogue: 0,0:22:35.82,0:22:38.45,Main,Luffy,0,0,0,,Aptal aptal konuşmasana! Kaptan benim be!Dialogue: 0,0:22:38.45,0:22:43.74,Main,Usopp & Chopper,0,0,0,,Lütfen be Kaptan! Rotacımızın sözünü dinle!Dialogue: 0,0:22:45.45,0:22:48.84,Main,Sanji,0,0,0,,Nami-san korkunca ayrı bir tatlı oluyor!Dialogue: 0,0:22:48.84,0:22:53.33,Main,Sanji,0,0,0,,Tatlı... Tatlı...Dialogue: 0,0:22:50.22,0:22:53.33,Secondary,Brook,0,0,0,,İkinci olarak da "Adımıza Ağıtlar" şarkım bizlerle!Dialogue: 0,0:22:53.33,0:22:59.51,Main,Franky,0,0,0,,Pekâlâ millet! Hareket etmeye hazırız!Dialogue: 0,0:23:02.28,0:23:05.67,Main,Franky,0,0,0,,Den-san'dan nasıl yükseleceğimizi öğrendim!Dialogue: 0,0:23:06.56,0:23:07.89,Main,Franky,0,0,0,,Gidelim mi?Dialogue: 0,0:23:09.83,0:23:11.32,Main,Luffy,0,0,0,,Pekâlâ öyleyse!Dialogue: 0,0:23:11.32,0:23:13.53,Main,Luffy,0,0,0,,Gidelim!Dialogue: 0,0:23:15.57,0:23:16.83,Main,Caimie,0,0,0,,Luffy-chin!Dialogue: 0,0:23:16.83,0:23:18.03,Main,Pappagg,0,0,0,,Hasır!Dialogue: 0,0:23:19.92,0:23:22.81,Main,Hachi,0,0,0,,Ben fabrika onarımına yardımcı olacağım...Dialogue: 0,0:23:22.81,0:23:25.87,Main,Hachi,0,0,0,,...yanınızda kılavuz olmadan idare edebilecek misiniz?Dialogue: 0,0:23:25.87,0:23:29.45,Main,Luffy,0,0,0,,Ederiz!  Gelirken kılavuzsuz da epey eğlenceliydi!Dialogue: 0,0:23:29.45,0:23:33.10,Main,Usopp,0,0,0,,Evet, aynen öyleydi! Kılavuza mılavuza gerek yok!Dialogue: 0,0:23:33.10,0:23:36.23,Main,Usopp,0,0,0,,Erkek kimisinin son durağı cehennemdir!Dialogue: 0,0:23:36.23,0:23:39.81,Main,Chopper,0,0,0,,Aynen öyle! Savaş getirin bana, canı çıkmayasıcalar!Dialogue: 0,0:23:39.81,0:23:40.80,Main,Robin,0,0,0,,Rezillik.Dialogue: 0,0:23:40.80,0:23:43.57,Main,Mermaid,0,0,0,,Millet, yine bekleriz!Dialogue: 0,0:23:43.57,0:23:45.97,Main,Sanji,0,0,0,,Gelmeyen insan değil!Dialogue: 0,0:23:45.97,0:23:48.91,Main,Sanji,0,0,0,,Kalbimin "All Blue"su da sizlersiniz!Dialogue: 0,0:23:48.91,0:23:50.50,Main,Zoro,0,0,0,,Ne boş beleş bir hayal.Dialogue: 0,0:23:53.52,0:23:56.79,Main,Fukaboshi,0,0,0,,Minnet sözlerinden başkası elimden gelmiyor. Teşekkür ederim.Dialogue: 0,0:23:58.32,0:24:00.22,Main,Fukaboshi,0,0,0,,Güvenli bir yolculuk geçirmeniz için dua edeceğim.Dialogue: 0,0:24:01.10,0:24:02.04,Main,Luffy,0,0,0,,Sağ olasın.Dialogue: 0,0:24:02.04,0:24:07.57,Main,Manboshi,0,0,0,,Bir dahaki karşılaşmamızda deniz altının en güçlü ordusuyla karşınızda olacağız!Dialogue: 0,0:24:07.57,0:24:09.55,Main,Manboshi,0,0,0,,Ov mambo!Dialogue: 0,0:24:09.55,0:24:17.01,Main,Ryuuboshi,0,0,0,,Aynen öyle! Ulu Kral Neptune'den bile daha kudretli olacağız mi-fa-so-la-si-do!Dialogue: 0,0:24:17.93,0:24:19.00,Main,Luffy,0,0,0,,Şimdiden heyecanlandım!Dialogue: 0,0:24:23.10,0:24:25.74,Main,Luffy,0,0,0,,Bir bakalım, nereye kayboldu?Dialogue: 0,0:24:26.49,0:24:28.55,Main,Luffy,0,0,0,,Burada işte!Dialogue: 0,0:24:30.61,0:24:31.94,Main,Luffy,0,0,0,,Jinbe!Dialogue: 0,0:24:53.65,0:24:56.51,Main,Luffy,0,0,0,,Haydi bakalım! Yelkenler fora!Dialogue: 0,0:25:02.41,0:25:05.69,Main,Luffy,0,0,0,,Yola çıkıyoruz!Dialogue: 0,0:25:08.76,0:25:10.64,Main,Citizen,0,0,0,,Hasır Şapka!Dialogue: 0,0:25:12.31,0:25:15.36,Main,Chopper,0,0,0,,Görüşmek üzere, Balık Adam Adası!Dialogue: 0,0:25:15.36,0:25:18.33,Main,Citizen,0,0,0,,Canınız şekerleme yahut et çekerse uğrayın!Dialogue: 0,0:25:18.33,0:25:20.66,Main,Citizen,0,0,0,,İnsanları çok seviyorum!Dialogue: 0,0:25:20.66,0:25:22.79,Main,Citizen,0,0,0,,Rakunları ve robotları da tabii ki!Dialogue: 0,0:25:25.18,0:25:27.78,Main,Chopper,0,0,0,,Hiç de bile sevinmedim, hergeleler sizi!Dialogue: 0,0:25:27.78,0:25:30.59,Main,Brook,0,0,0,,Ne? Oha? Kemikleri kimse sevmiyor mu?Dialogue: 0,0:25:30.59,0:25:34.25,Main,Caimie,0,0,0,,Hepiniz kendinize iyi bakın!Dialogue: 0,0:25:34.25,0:25:37.53,Main,Hachi,0,0,0,,Takoyaki yemeye de beklerim yine!Dialogue: 0,0:25:37.53,0:25:40.96,Main,Pappagg,0,0,0,,Millet, sizi çok seviyorum!Dialogue: 0,0:25:42.40,0:25:44.38,Main,The Utterly Indistinguishable Ones,0,0,0,,Bir, 'ki...Dialogue: 0,0:25:44.38,0:25:46.48,Main,The Utterly Indistinguishable Ones,0,0,0,,Kemikleri de seviyoruz!Dialogue: 0,0:25:47.89,0:25:49.94,Main,Brook,0,0,0,,Beni de düşündüğünüz için teşekkür ederim!Dialogue: 0,0:25:53.94,0:25:55.31,Main,Shirahoshi,0,0,0,,Luffy-sama!Dialogue: 0,0:25:55.31,0:25:56.91,Main,Luffy,0,0,0,,Zayıf-Hoshi!Dialogue: 0,0:25:56.91,0:25:58.89,Main,Sanji,0,0,0,,Shirahoshi-chwan!Dialogue: 0,0:26:01.67,0:26:06.97,Main,Shirahoshi,0,0,0,,Bir gün yine görüşecek olursak...Dialogue: 0,0:26:08.26,0:26:10.24,Main,Shirahoshi,0,0,0,,...söz veriyorum...Dialogue: 0,0:26:10.24,0:26:13.82,Main,Shirahoshi,0,0,0,,...o zaman bu zayıf halimi geride bırakmış olacağım!Dialogue: 0,0:26:16.34,0:26:19.91,Main,Shirahoshi,0,0,0,,Yine eğlenceli gezilere çıkalım hep birlikte!Dialogue: 0,0:26:19.91,0:26:24.79,Main,Luffy,0,0,0,,Gezi mi?  Yine annenin yanına mı gitmek istiyorsun?Dialogue: 0,0:26:24.79,0:26:26.10,Main,Shirahoshi,0,0,0,,Hayır!Dialogue: 0,0:26:27.08,0:26:29.67,Main,Shirahoshi,0,0,0,,Bir dahaki sefer çok daha uzaklara gitmek istiyorum!Dialogue: 0,0:26:30.97,0:26:35.11,Main,Shirahoshi,0,0,0,,Denizlerin üzerindeki  o gerçek orman denen yere!Dialogue: 0,0:26:36.29,0:26:41.21,Main,Luffy,0,0,0,,Anlıyorum, denizin dışına hiç çıkmamıştın değil mi sen?Dialogue: 0,0:26:41.89,0:26:43.49,Main,Luffy,0,0,0,,Pekâlâ, iyi madem!Dialogue: 0,0:26:44.25,0:26:46.88,Main,Luffy,0,0,0,,Bir dahaki sefer götüreceğim seni!Dialogue: 0,0:26:59.98,0:27:01.01,Main,Shirahoshi,0,0,0,,Söz mü?Dialogue: 0,0:27:01.96,0:27:03.94,Main,Luffy,0,0,0,,Evet, güven bana!Dialogue: 0,0:27:04.93,0:27:05.96,Main,Luffy,0,0,0,,Sözüm söz!Dialogue: 0,0:27:07.33,0:27:11.18,Main,Nami,0,0,0,,İyi güzel de Luffy, o sözün ucu bize de dokunuyor!Dialogue: 0,0:27:11.18,0:27:15.74,Main,Brook,0,0,0,,Luffy-san, söz verilince ölseniz bile yerine getirmek zorundasınız.Dialogue: 0,0:27:15.74,0:27:18.68,Main,Nami,0,0,0,,Öyleyse Shirahoshi, ben de söz veriyorum!Dialogue: 0,0:27:19.95,0:27:21.16,Main,Shirahoshi,0,0,0,,Nami-chin-sama!Dialogue: 0,0:27:22.11,0:27:23.47,Main,Sanji,0,0,0,,Ben de!Dialogue: 0,0:27:23.47,0:27:25.08,Main,Chopper,0,0,0,,Ben de o zaman!Dialogue: 0,0:27:25.08,0:27:26.15,Main,Robin,0,0,0,,Ben de!Dialogue: 0,0:27:26.15,0:27:27.29,Main,Brook,0,0,0,,Ben de!Dialogue: 0,0:27:27.29,0:27:29.32,Main,Usopp,0,0,0,,Ben vermesem olmaz şimdi!Dialogue: 0,0:27:29.77,0:27:31.51,Main,Robin,0,0,0,,Bunca sözden sonra...Dialogue: 0,0:27:31.51,0:27:33.83,Main,Brook,0,0,0,,Mutlaka yerine gelecektir dileğiniz.Dialogue: 0,0:27:38.22,0:27:39.82,Main,Straw Hats,0,0,0,,Söz veriyoruz!Dialogue: 0,0:27:42.79,0:27:44.92,Main,Shirahoshi,0,0,0,,Millet!Dialogue: 0,0:27:47.32,0:27:49.23,Main,Luffy,0,0,0,,Hadi ağlama sen de artık!Dialogue: 0,0:27:53.84,0:27:54.75,Main,Shirahoshi,0,0,0,,Peki!Dialogue: 0,0:28:20.95,0:28:23.77,Main,Neptune,0,0,0,,Yaptıkları bu iyiliği asla unutmayın.Dialogue: 0,0:28:24.23,0:28:25.90,Main,Princes,0,0,0,,Elbette!Dialogue: 0,0:28:37.86,0:28:39.84,Main,Kid,0,0,0,,Baksana baba!Dialogue: 0,0:28:42.24,0:28:46.85,Main,Kid,0,0,0,,Hasır şapka alsana bana! Kahramanlar gibi olacağım!Dialogue: 0,0:28:46.85,0:28:51.04,Main,Citizen,0,0,0,,Ne? Hasır şapkaları  yüzeyde satıyorlar sadece!Dialogue: 0,0:28:51.04,0:28:52.87,Main,Kid,0,0,0,,Oradan al o zaman!Dialogue: 0,0:28:53.78,0:28:58.58,Main,Citizen,0,0,0,,Aptallık etmesene! Yüzeyde balık adamlardan  nefret eden korkunç insanlar...Dialogue: 0,0:28:58.58,0:28:59.56,Main,Kid,0,0,0,,Ne?Dialogue: 0,0:28:59.56,0:29:04.13,Main,Citizen,0,0,0,,Yani o kişilikte birileri de var...Dialogue: 0,0:29:04.75,0:29:08.33,Main,Citizen,0,0,0,,Elbette Hasır Şapkalar gibi güçlü ve iyi kişiler de var.Dialogue: 0,0:29:14.08,0:29:17.32,Main,Citizen,0,0,0,,Patron Jinbe! Tam zamanında geldiniz!Dialogue: 0,0:29:17.32,0:29:19.64,Main,Jinbe,0,0,0,,Konuşmanızı duydum.Dialogue: 0,0:29:19.64,0:29:23.83,Main,Jinbe,0,0,0,,Tüccarın birinden istetirim.Dialogue: 0,0:29:23.83,0:29:25.13,Main,Kid,0,0,0,,Gerçekten mi?!Dialogue: 0,0:29:25.32,0:29:26.23,Main,Jinbe,0,0,0,,Evet!Dialogue: 0,0:29:27.22,0:29:29.35,Main,Jinbe,0,0,0,,O kahramanın şapkasından istiyorsun, değil mi?Dialogue: 0,0:29:30.00,0:29:31.45,Main,Kid,0,0,0,,Evet!Dialogue: 0,0:29:43.18,0:29:45.01,Main,Sanji,0,0,0,,Harikaydı gerçekten!Dialogue: 0,0:29:45.39,0:29:48.36,Main,Sanji,0,0,0,,Deniz kızı cenneti!Dialogue: 0,0:29:48.36,0:29:51.18,Main,Nami,0,0,0,,Haydi bakalım millet, güzel anılarınıza veda etme vakti!Dialogue: 0,0:29:51.18,0:29:54.91,Main,Nami,0,0,0,,Denize ulaştığımızda güvenli tek bir yer olmayacak!Dialogue: 0,0:29:54.91,0:29:57.50,Main,Nami,0,0,0,,Bir kez daha karanlık suları  geçmemiz gerekecek!Dialogue: 0,0:29:58.20,0:29:59.90,Main,Usopp,0,0,0,,O da ne öyle, Franky?Dialogue: 0,0:30:00.31,0:30:05.34,Main,Franky,0,0,0,,Batmaz küre şeklindeki tahtalar gemiyi asılı tutacaklar.Dialogue: 0,0:30:05.34,0:30:09.23,Main,Franky,0,0,0,,Küre sayısını değiştirerek geminin hızını ayarlayabiliyoruz.Dialogue: 0,0:30:09.69,0:30:11.74,Main,Zoro,0,0,0,,Ne oldu, Luffy?Dialogue: 0,0:30:12.63,0:30:14.75,Main,Luffy,0,0,0,,Burayı tırmanınca...Dialogue: 0,0:30:17.53,0:30:19.54,Main,Luffy,0,0,0,,...Shanks'ın olduğu sulara varacağız!Dialogue: 0,0:30:25.27,0:30:27.47,Main,Luffy,0,0,0,,Onu görmek için sabırsızlanıyorum!Dialogue: 0,0:30:28.24,0:30:29.34,Flashbacks,Shanks,0,0,0,,Öyleyse...Dialogue: 0,0:30:30.33,0:30:32.31,Flashbacks,Shanks,0,0,0,,...bu şapkayı sana emanet ediyorum.Dialogue: 0,0:30:33.15,0:30:36.08,Flashbacks,Shanks,0,0,0,,Çok önemli bir şapkadır benim için.Dialogue: 0,0:30:36.08,0:30:38.75,Flashbacks,Shanks,0,0,0,,Mutlaka bana geri getir!Dialogue: 0,0:30:38.75,0:30:41.26,Flashbacks,Shanks,0,0,0,,Büyük bir korsan olman gerek tabii önce!Dialogue: 0,0:30:45.91,0:30:50.02,Flashbacks,Ace,0,0,0,,Gözümün arkada kalacağı tek bir konu var.Dialogue: 0,0:30:51.09,0:30:55.80,Flashbacks,Ace,0,0,0,,Hayalini gerçekleştirdiğini göremeyeceğim.Dialogue: 0,0:30:55.80,0:31:00.72,Flashbacks,Ace,0,0,0,,Ama başaracağına güvenim tam.Dialogue: 0,0:31:01.94,0:31:03.88,Flashbacks,Ace,0,0,0,,Kardeşimsin sonuçta!Dialogue: 0,0:31:03.88,0:31:06.47,Flashbacks,Jinbe,0,0,0,,Yalnızca yitirdiklerini düşünmekten vazgeç!Dialogue: 0,0:31:06.85,0:31:13.32,Flashbacks,Jinbe,0,0,0,,Giden gitmiştir! Geri kalanlardan haber ver sen!Dialogue: 0,0:31:13.32,0:31:16.37,Flashbacks,Rayleigh,0,0,0,,Zirveye kadar yolun açık olsun!Dialogue: 0,0:31:16.37,0:31:22.10,Flashbacks,Coby,0,0,0,,Luffy-san, Grand Line'ın ikici yarısına ne diyorlar biliyor musun?Dialogue: 0,0:31:24.49,0:31:32.26,Flashbacks,Coby,0,0,0,,İnsanlar Red Line'ın ardında kalan bu son denize başka bir isim takmışlar.Dialogue: 0,0:31:33.25,0:31:35.07,Flashbacks,Coby,0,0,0,,Yeni Dünya!Dialogue: 0,0:31:37.02,0:31:38.24,Flashbacks,Luffy,0,0,0,,Yeni Dünya?!Dialogue: 0,0:31:39.45,0:31:43.00,Flashbacks,Coby,0,0,0,,Gelecek nesillere kapıyı aralayacak olan korsanların toplandığı sular!Dialogue: 0,0:31:43.76,0:31:47.80,Flashbacks,Coby,0,0,0,,Ve işte o sulara hakim olan kişi de Korsanlar Kralıdır!Dialogue: 0,0:31:54.96,0:31:56.94,Main,Luffy,0,0,0,,Derin suları ardımızda bırakır bırakmaz...Dialogue: 0,0:31:58.12,0:32:00.55,Main,Luffy,0,0,0,,...dünyanın en mükemmel deniziyle karşılaşacağız!Dialogue: 0,0:32:00.55,0:32:03.87,Main,Zoro,0,0,0,,Sonunda! Her şeyi keseceğim!Dialogue: 0,0:32:03.87,0:32:07.30,Main,Brook,0,0,0,,Bekle beni, Laboon!  Yolu yarıladım!Dialogue: 0,0:32:07.30,0:32:10.04,Main,Nami,0,0,0,,Bana güvenebilirsiniz, nereye isterseniz götürürüm sizi!Dialogue: 0,0:32:10.04,0:32:12.63,Main,Franky,0,0,0,,Aynen öyle!  Sunny-go varken her yer mümkün!Dialogue: 0,0:32:12.63,0:32:15.41,Main,Chopper,0,0,0,,Yaralarınız ne denli derin olursa olsun iyileştiririm sizi!Dialogue: 0,0:32:15.41,0:32:18.04,Main,Sanji,0,0,0,,Ben varken kimseler aç kalmaz!Dialogue: 0,0:32:18.04,0:32:20.63,Main,Usopp,0,0,0,,Denizlerin savaşçısı da burada!Dialogue: 0,0:32:26.38,0:32:29.35,Main,Luffy,0,0,0,,Gidelim!Dialogue: 0,0:32:29.35,0:32:31.94,Main,Luffy,0,0,0,,Millet!Dialogue: 0,0:32:42.91,0:32:44.89,Main,Luffy,0,0,0,,Hedef Yeni Dünya!Dialogue: 0,0:32:44.89,0:32:46.41,Main,Straw Hats,0,0,0,,Evet!Dialogue: 0,0:00:02.99,0:00:08.38,Main,,0,0,0,,Dünyanın sunabileceği her şeyi elde eden adam, Korsanlar Kralı Gold Roger.Dialogue: 0,0:00:08.38,0:00:13.00,Main,,0,0,0,,Son sözleri dünyanın her yerinden maceracıları denize çekti.Dialogue: 0,0:00:13.00,0:00:14.68,Main,,0,0,0,,"Hazinem mi?"Dialogue: 0,0:00:14.68,0:00:16.22,Main,,0,0,0,,"İstiyorsanız, size vereceğim!"Dialogue: 0,0:00:16.22,0:00:17.42,Main,,0,0,0,,"Arayın ve bulun!"Dialogue: 0,0:00:17.42,0:00:19.87,Main,,0,0,0,,"Bu dünyanın sunabileceği her şeyi orada bıraktım!"Dialogue: 0,0:00:19.87,0:00:22.69,Main,,0,0,0,,Korsanlar hayallerinin peşinden yola çıktılar!Dialogue: 0,0:00:22.69,0:00:25.35,Main,,0,0,0,,Dünya, Büyük Korsan Çağı'na girdi!Dialogue: 0,0:00:25.35,0:00:29.31,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪Dialogue: 0,0:00:29.31,0:00:33.81,We Go lyrics,,0,0,0,,♪ Şafak vakti gelmedi bile ve ben bekleyemiyorum! ♪Dialogue: 0,0:00:33.81,0:00:37.48,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı, dört... Gidelim! ♪Dialogue: 0,0:00:38.97,0:00:43.05,We Go lyrics,,0,0,0,,♪ Bayrağımızı dalgalandıralım, macera şafağının doğuşuna. ♪Dialogue: 0,0:00:44.41,0:00:49.74,We Go lyrics,,0,0,0,,♪ Dalgalar yapalım, bizi uykumuzdan kaldırsınlar. ♪Dialogue: 0,0:00:49.74,0:00:54.28,We Go lyrics,,0,0,0,,♪ Eğer inanılmaz bir dünyaya gitmek istiyorsan,Dialogue: 0,0:00:54.28,0:00:58.79,We Go lyrics,,0,0,0,, gerekli olan şey senin dayanıklılığın. ♪Dialogue: 0,0:00:59.11,0:01:01.73,We Go lyrics,,0,0,0,,♪ Fazla dikkat çekmek, bu bir suç mu? ♪Dialogue: 0,0:01:01.73,0:01:04.62,We Go lyrics,,0,0,0,,♪ Aranıyor → Kazanan demektir! ♪Dialogue: 0,0:01:04.62,0:01:10.50,We Go lyrics,,0,0,0,,♪ Özgür olmak bizim tek kuralımız! ♪Dialogue: 0,0:01:10.50,0:01:15.99,We Go lyrics,,0,0,0,,♪ Endişelerinizi unutun, bırakın rüzgar essin. ♪Dialogue: 0,0:01:15.99,0:01:18.53,We Go lyrics,,0,0,0,,♪ Ne pahasına olursa olsun, One Piece'i ilk biz bulacağız! ♪Dialogue: 0,0:01:18.53,0:01:22.66,We Go lyrics,,0,0,0,,♪ Hayal kuran kalplerimiz, çok büyük... ♪Dialogue: 0,0:01:22.66,0:01:26.93,We Go lyrics,,0,0,0,,♪ Onları uyandırmamak önemli. ♪Dialogue: 0,0:01:26.93,0:01:29.57,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪Dialogue: 0,0:01:29.57,0:01:33.54,We Go lyrics,,0,0,0,,♪ Şafak vakti gelmedi bile ve ben bekleyemiyorum! ♪Dialogue: 0,0:01:33.54,0:01:37.33,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı, dört... Gidelim! ♪Dialogue: 0,0:01:38.76,0:01:44.72,We Go lyrics,,0,0,0,,♪ Biz... buralara kadar geldik. ♪Dialogue: 0,0:01:44.72,0:01:47.62,We Go lyrics,,0,0,0,,♪ Gideceğiz... hayallerimizin olduğu yere,Dialogue: 0,0:01:47.62,0:01:52.70,We Go lyrics,,0,0,0,, ve kimseyi arkada bırakmayacağız. ♪Dialogue: 0,0:01:52.70,0:01:55.30,We Go lyrics,,0,0,0,,♪ Hep devam edeceğiz, bu bir söz. ♪Dialogue: 0,0:01:55.30,0:01:59.47,We Go lyrics,,0,0,0,,♪ Hayallerimizin başladığı o günden beri,Dialogue: 0,0:01:59.47,0:02:03.72,We Go lyrics,,0,0,0,, belirlediğimiz gelecek, değişmedi! ♪Dialogue: 0,0:02:03.72,0:02:06.24,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪Dialogue: 0,0:02:06.24,0:02:10.61,We Go lyrics,,0,0,0,,♪ Kalbimdeki güneş, asla batmayacak! ♪Dialogue: 0,0:02:10.61,0:02:13.38,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... ♪Dialogue: 0,0:02:14.78,0:02:17.57,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... ♪Dialogue: 0,0:02:18.75,0:02:24.82,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... dört... Gidelim! ♪Dialogue: 0,0:02:27.27,0:02:29.74,We Go lyrics,,0,0,0,,♪ Gidelim! ♪