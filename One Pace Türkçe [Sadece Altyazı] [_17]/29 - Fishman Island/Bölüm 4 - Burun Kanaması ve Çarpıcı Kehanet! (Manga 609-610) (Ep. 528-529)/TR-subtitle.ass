0,10,10,1Style: TS paper,impress bt,48,&H001D221E,&H000000FF,&H001D221E,&H00000000,0,0,0,0,100,100,0,0,1,0.5,0,2,10,10,10,1Style: We Go lyrics,Duality,40.0,&H0098594E,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2.6,0,2,10,10,15,1Style: Author,Impress BT,20.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.7,0.7,9,10,10,10,1Style: Attack,Duality,30.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.0,1.0,7,12,12,12,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:02.99,0:00:08.38,Main,,0,0,0,,Dünyanın sunabileceği her şeyi elde eden adam, Korsanlar Kralı Gold Roger.Dialogue: 0,0:00:08.38,0:00:13.00,Main,,0,0,0,,Son sözleri dünyanın her yerinden maceracıları denize çekti.Dialogue: 0,0:00:13.00,0:00:14.68,Main,,0,0,0,,"Hazinem mi?"Dialogue: 0,0:00:14.68,0:00:16.22,Main,,0,0,0,,"İstiyorsanız, size vereceğim!"Dialogue: 0,0:00:16.22,0:00:17.42,Main,,0,0,0,,"Arayın ve bulun!"Dialogue: 0,0:00:17.42,0:00:19.87,Main,,0,0,0,,"Bu dünyanın sunabileceği her şeyi orada bıraktım!"Dialogue: 0,0:00:19.87,0:00:22.69,Main,,0,0,0,,Korsanlar hayallerinin peşinden yola çıktılar!Dialogue: 0,0:00:22.69,0:00:25.35,Main,,0,0,0,,Dünya, Büyük Korsan Çağı'na girdi!Dialogue: 0,0:00:25.35,0:00:29.31,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪Dialogue: 0,0:00:29.31,0:00:33.81,We Go lyrics,,0,0,0,,♪ Şafak vakti gelmedi bile ve ben bekleyemiyorum! ♪Dialogue: 0,0:00:33.81,0:00:37.48,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı, dört... Gidelim! ♪Dialogue: 0,0:00:38.97,0:00:43.05,We Go lyrics,,0,0,0,,♪ Bayrağımızı dalgalandıralım, macera şafağının doğuşuna. ♪Dialogue: 0,0:00:44.41,0:00:49.74,We Go lyrics,,0,0,0,,♪ Dalgalar yapalım, bizi uykumuzdan kaldırsınlar. ♪Dialogue: 0,0:00:49.74,0:00:54.28,We Go lyrics,,0,0,0,,♪ Eğer inanılmaz bir dünyaya gitmek istiyorsan,Dialogue: 0,0:00:54.28,0:00:58.79,We Go lyrics,,0,0,0,, gerekli olan şey senin dayanıklılığın. ♪Dialogue: 0,0:00:59.11,0:01:01.73,We Go lyrics,,0,0,0,,♪ Fazla dikkat çekmek, bu bir suç mu? ♪Dialogue: 0,0:01:01.73,0:01:04.62,We Go lyrics,,0,0,0,,♪ Aranıyor → Kazanan demektir! ♪Dialogue: 0,0:01:04.62,0:01:10.50,We Go lyrics,,0,0,0,,♪ Özgür olmak bizim tek kuralımız! ♪Dialogue: 0,0:01:10.50,0:01:15.99,We Go lyrics,,0,0,0,,♪ Endişelerinizi unutun, bırakın rüzgar essin. ♪Dialogue: 0,0:01:15.99,0:01:18.53,We Go lyrics,,0,0,0,,♪ Ne pahasına olursa olsun, One Piece'i ilk biz bulacağız! ♪Dialogue: 0,0:01:18.53,0:01:22.66,We Go lyrics,,0,0,0,,♪ Hayal kuran kalplerimiz, çok büyük... ♪Dialogue: 0,0:01:22.66,0:01:26.93,We Go lyrics,,0,0,0,,♪ Onları uyandırmamak önemli. ♪Dialogue: 0,0:01:26.93,0:01:29.57,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪Dialogue: 0,0:01:29.57,0:01:33.54,We Go lyrics,,0,0,0,,♪ Şafak vakti gelmedi bile ve ben bekleyemiyorum! ♪Dialogue: 0,0:01:33.54,0:01:37.33,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı, dört... Gidelim! ♪Dialogue: 0,0:01:38.76,0:01:44.72,We Go lyrics,,0,0,0,,♪ Biz... buralara kadar geldik. ♪Dialogue: 0,0:01:44.72,0:01:47.62,We Go lyrics,,0,0,0,,♪ Gideceğiz... hayallerimizin olduğu yere,Dialogue: 0,0:01:47.62,0:01:52.70,We Go lyrics,,0,0,0,, ve kimseyi arkada bırakmayacağız. ♪Dialogue: 0,0:01:52.70,0:01:55.30,We Go lyrics,,0,0,0,,♪ Hep devam edeceğiz, bu bir söz. ♪Dialogue: 0,0:01:55.30,0:01:59.47,We Go lyrics,,0,0,0,,♪ Hayallerimizin başladığı o günden beri,Dialogue: 0,0:01:59.47,0:02:03.72,We Go lyrics,,0,0,0,, belirlediğimiz gelecek, değişmedi! ♪Dialogue: 0,0:02:03.72,0:02:06.24,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪Dialogue: 0,0:02:06.24,0:02:10.61,We Go lyrics,,0,0,0,,♪ Kalbimdeki güneş, asla batmayacak! ♪Dialogue: 0,0:02:10.61,0:02:13.38,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... ♪Dialogue: 0,0:02:14.78,0:02:17.57,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... ♪Dialogue: 0,0:02:18.75,0:02:24.82,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... dört... Gidelim! ♪Dialogue: 0,0:02:27.27,0:02:30.04,We Go lyrics,,0,0,0,,♪ Gidelim! ♪Dialogue: 0,0:02:30.21,0:02:38.65,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Kaşgarlı thx to onepace.netDialogue: 0,0:13:05.50,0:13:15.50,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Kaşgarlı thx to onepace.netDialogue: 0,0:28:40.40,0:28:44.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Kaşgarlı thx to onepace.netDialogue: 0,0:02:30.21,0:02:38.65,Title,,0,0,0,,Mercan Tepesi'ne Varış! Burun Kanaması ve Çarpıcı Kehanet!Dialogue: 0,0:02:43.34,0:02:44.41,Main,Mermaids,0,0,0,,Sanji-chan!Dialogue: 0,0:02:44.41,0:02:46.31,Main,Sanji,0,0,0,,Seve seve!Dialogue: 0,0:02:49.77,0:02:50.62,Thoughts,Sanji,0,0,0,,Ben...Dialogue: 0,0:02:52.71,0:02:53.65,Thoughts,Sanji,0,0,0,,burada...Dialogue: 0,0:02:55.11,0:02:57.86,Thoughts,Sanji,0,0,0,,yaşayacağım!Dialogue: 0,0:02:58.35,0:03:00.63,Main,Mermaid,0,0,0,,Sanji-chan, çok komiksin!Dialogue: 0,0:03:01.65,0:03:05.35,Main,Usopp,0,0,0,,Burada olduğu için  eski haline dönmüş gibi duruyor.Dialogue: 0,0:03:05.35,0:03:06.36,Main,Usopp,0,0,0,,İrade gücü mü acaba?Dialogue: 0,0:03:06.36,0:03:08.42,Main,Luffy,0,0,0,,Siz çok şanslısınız, yüzebiliyorsunuz.Dialogue: 0,0:03:08.42,0:03:11.17,Main,Caimie,0,0,0,,Luffy-chin, eğer  baloncuk kullanırsan sen de yüzebilirsin.Dialogue: 0,0:03:11.17,0:03:11.97,Main,Luffy,0,0,0,,Gerçekten mi?!Dialogue: 0,0:03:11.97,0:03:13.60,Main,Chopper,0,0,0,,Ama cidden rahatladım.Dialogue: 0,0:03:13.60,0:03:17.31,Main,Chopper,0,0,0,,Burnu bir kere daha kanarsa, kan torbam kalmadığından dolayı müdahale edemem.Dialogue: 0,0:03:17.65,0:03:20.18,Main,Chopper,0,0,0,,Sanji'nin kan grubu nadir, sonuçta.Dialogue: 0,0:03:20.18,0:03:21.55,Main,Luffy,0,0,0,,Hey, Camie...Dialogue: 0,0:03:22.88,0:03:26.89,Main,Luffy,0,0,0,,Balık Adam Adası'nda gerçekten buluşmak istediğim biri var!Dialogue: 0,0:03:27.72,0:03:29.81,Main,Caimie,0,0,0,,Kim? Denizkızı Prenses mi?Dialogue: 0,0:03:29.81,0:03:30.42,Main,Luffy,0,0,0,,Hayır!Dialogue: 0,0:03:30.42,0:03:31.88,Main,Luffy,0,0,0,,Jinbe!Dialogue: 0,0:03:33.96,0:03:35.86,Main,Caimie,0,0,0,,Patron Jinbe mi?Dialogue: 0,0:03:35.86,0:03:39.42,Main,Usopp,0,0,0,,Hey Luffy, Jinbe derken,  yoksa tekrar bir Shichibukai mi...Dialogue: 0,0:03:39.42,0:03:43.38,Main,Usopp,0,0,0,,Ah, bekle, savaş sırasında istifa etti,  o yüzden sanırım artık eski Shichibukai.Dialogue: 0,0:03:43.38,0:03:45.10,Main,Luffy,0,0,0,,Evet! O benim arkadaşım!Dialogue: 0,0:03:46.03,0:03:48.03,Main,Usopp,0,0,0,,N-Neyin var senin?!Dialogue: 0,0:03:47.43,0:03:52.57,Captions,,0,0,220,,Balık Adam Adası "Ryugu Krallığı"Dialogue: 0,0:03:48.81,0:03:51.61,Main,Luffy,0,0,0,,İki yıl önce, Ace öldü...Dialogue: 0,0:03:51.61,0:03:56.18,Main,Luffy,0,0,0,,ama tekrar ayaklarımın üstüne çıkmam, onun sayesinde!Dialogue: 0,0:03:56.85,0:03:58.85,Main,Luffy,0,0,0,,Jinbe ile görüşmek istiyorum!Dialogue: 0,0:03:59.28,0:04:01.79,Flashbacks,Jinbe,0,0,0,,İki yıl sonra Balık Adam Adası'nda buluşalım! Dialogue: 0,0:04:01.79,0:04:06.43,Flashbacks,Jinbe,0,0,0,,Sen ve tayfanın  oraya varacağı günü iple çekiyorum! Dialogue: 0,0:04:07.38,0:04:11.07,Main,Luffy,0,0,0,,Onunla bu adada buluşacağıma söz verdim!Dialogue: 0,0:04:11.07,0:04:16.07,Main,Caimie,0,0,0,,Lafı açılmışken, senin Patron Jinbe ile beraber olduğunu söyleyen bir yazı okumuştum.Dialogue: 0,0:04:16.49,0:04:18.05,Main,Luffy,0,0,0,,Jinbe nerede?Dialogue: 0,0:04:18.05,0:04:22.64,Main,Caimie,0,0,0,,Ah... Şey, o şu anda bu adada değil.Dialogue: 0,0:04:22.64,0:04:23.56,Main,Luffy,0,0,0,,Ha?Dialogue: 0,0:04:23.56,0:04:27.82,Main,Caimie,0,0,0,,İki yıl önce savaş sırasında Shichibukai'liği bıraktığını biliyorsun değil mi?Dialogue: 0,0:04:27.82,0:04:32.32,Main,Caimie,0,0,0,,Bundan dolayı eski  Balık Adam Korsanları üyeleri bu adada duramıyor.Dialogue: 0,0:04:32.32,0:04:35.74,Main,Caimie,0,0,0,,O yüzden Patron Jinbe ile birlikte  hepsi adadan gitti.Dialogue: 0,0:04:35.74,0:04:39.13,Main,Luffy,0,0,0,,Ne?! Yani Jinbe'yi göremeyecek miyim?Dialogue: 0,0:04:39.47,0:04:45.68,Main,Caimie,0,0,0,,Uzun bir hikaye ama esasında savaşın bu ada üzerinde de büyük etkisi oldu.Dialogue: 0,0:04:45.68,0:04:49.32,Main,The Utterly Indistinguishable Ones,0,0,0,,Camie!Dialogue: 0,0:04:49.32,0:04:50.35,Main,The Utterly Indistinguishable Ones,0,0,0,,Bir gemi geliyor!Dialogue: 0,0:04:50.35,0:04:51.11,Main,The Utterly Indistinguishable Ones,0,0,0,,Geliyor olabilir!Dialogue: 0,0:04:51.11,0:04:52.42,Main,The Utterly Indistinguishable Ones,0,0,0,,Bir kraliyet gemisi geliyor!Dialogue: 0,0:04:52.42,0:04:53.91,Main,The Utterly Indistinguishable Ones,0,0,0,,Belki üzerinde kimse yoktur!Dialogue: 0,0:04:53.91,0:04:55.51,Main,The Utterly Indistinguishable Ones,0,0,0,,Üzerinde kesin birileri vardır!Dialogue: 0,0:04:55.98,0:04:58.35,Main,Caimie,0,0,0,,Gemide kim var, Yıllık Balığı-chinler?Dialogue: 0,0:04:58.35,0:04:59.38,Main,The Utterly Indistinguishable Ones,0,0,0,,Daha bilmiyoruz.Dialogue: 0,0:04:59.38,0:05:01.45,Main,The Utterly Indistinguishable Ones,0,0,0,,Çok nadir bir kraliyet gemisi!Dialogue: 0,0:05:01.45,0:05:03.46,Main,The Utterly Indistinguishable Ones,0,0,0,,Buraya nadiren gelen bir gemi!Dialogue: 0,0:05:03.46,0:05:07.34,Main,The Utterly Indistinguishable Ones,0,0,0,,Belki de buraya Luffy-chin ve diğerlerini tutuklamaya gelmişlerdir?Dialogue: 0,0:05:07.34,0:05:08.29,Main,The Utterly Indistinguishable Ones,0,0,0,,Gelmişlerse ne olmuş?Dialogue: 0,0:05:09.15,0:05:11.46,Main,Caimie,0,0,0,,Hepiniz saklanmalısınız, Luffy-chin!Dialogue: 0,0:05:15.23,0:05:17.37,Main,Caimie,0,0,0,,O kraliyet ailesi gondolu mu?Dialogue: 0,0:05:17.37,0:05:18.30,Main,The Utterly Indistinguishable Ones,0,0,0,,Gerçekten öyle mi?Dialogue: 0,0:05:18.30,0:05:18.79,Main,The Utterly Indistinguishable Ones,0,0,0,,Öyle!Dialogue: 0,0:05:18.79,0:05:19.39,Main,The Utterly Indistinguishable Ones,0,0,0,,Öyle mi?Dialogue: 0,0:05:19.39,0:05:20.18,Main,The Utterly Indistinguishable Ones,0,0,0,,Öyle, değil mi?Dialogue: 0,0:05:20.18,0:05:20.84,Main,The Utterly Indistinguishable Ones,0,0,0,,Öyleyse ne olmuş?Dialogue: 0,0:05:21.17,0:05:24.76,Main,Mermaid,0,0,0,,Ama gerçekten de  kraliyet ailesinden biri olamaz, değil mi?Dialogue: 0,0:05:24.76,0:05:27.91,Main,Mermaid,0,0,0,,Bu kadar köşedeki bir adaya kendileri gelmezler.Dialogue: 0,0:05:38.59,0:05:44.13,Main,Voice,0,0,0,,Üç Neptune Kardeşler geldiler!Dialogue: 0,0:05:46.28,0:05:51.00,Captions,,0,0,260,,Ryugu Krallığı Neptune Ailesi'nden Üç KardeşlerDialogue: 0,0:05:45.51,0:05:48.50,Main,Fukaboshi,0,0,0,,Selamlar, körfezin kadınları.Dialogue: 0,0:05:48.50,0:05:51.00,Main,Fukaboshi,0,0,0,,Sormak istediğim bir şey var.Dialogue: 0,0:05:51.71,0:05:52.87,Main,Mermaid,0,0,0,,Prensler!Dialogue: 0,0:05:52.87,0:05:53.93,Main,Mermaid,0,0,0,,Neden buradalar?!Dialogue: 0,0:05:53.93,0:05:55.47,Main,Usopp,0,0,0,,Prensler mi?Dialogue: 0,0:05:57.63,0:05:58.93,Main,Mermaid,0,0,0,,Hayır, Sanji-chan!Dialogue: 0,0:05:58.93,0:06:00.68,Main,Sanji,0,0,0,,T-Tamam.Dialogue: 0,0:06:03.51,0:06:05.25,Main,Mermaid,0,0,0,,Saklı kalmalısın.Dialogue: 0,0:06:05.25,0:06:06.68,Main,Sanji,0,0,0,,Hey, ne...Dialogue: 0,0:06:13.37,0:06:17.61,Captions,,0,0,260,,İlk oğul - Fukaboshi (Köpek balığı Deniz Adamı)Dialogue: 0,0:06:11.85,0:06:15.68,Main,Fukaboshi,0,0,0,,Birkaç tane kaçak göçmen hakkında bilgi aldık.Dialogue: 0,0:06:15.68,0:06:17.71,Main,Fukaboshi,0,0,0,,Buraya geldiler mi?Dialogue: 0,0:06:18.03,0:06:23.31,Captions,,0,0,260,,İkinci oğul - Ryuboshi (Kürek balığı Deniz Adamı)Dialogue: 0,0:06:17.71,0:06:20.46,Main,Ryuuboshi,0,0,0,,Geldilerse lütfen söyleyin so-la-ti-do!Dialogue: 0,0:06:20.46,0:06:23.59,Main,Ryuuboshi,0,0,0,,Eğer gelmedilerse, o zaman sıkıntı yok mi-re-do!Dialogue: 0,0:06:25.32,0:06:29.43,Captions,,0,0,260,,Üçüncü oğul - Manboshi (Ay balığı Deniz Adamı)Dialogue: 0,0:06:23.59,0:06:26.61,Main,Manboshi,0,0,0,,Akkamanbo!  Oley! Oley!Dialogue: 0,0:06:26.61,0:06:29.44,Main,Manboshi,0,0,0,,Ben de burada biraz eğlenmek istiyorum!Dialogue: 0,0:06:29.44,0:06:31.89,Main,Mermaid,0,0,0,,Buraya kimse gelmedi.Dialogue: 0,0:06:31.89,0:06:34.88,Main,Mermaid,0,0,0,,Gerçekten bu kadar önemliler mi?Dialogue: 0,0:06:34.88,0:06:38.37,Main,Mermaid,0,0,0,,Sizin buraya gelmenizi sağlayacak kadar yani...Dialogue: 0,0:06:39.21,0:06:43.65,Main,Fukaboshi,0,0,0,,Onların düşündüğümüz kişiler olup olmadıklarını daha doğrulayamadık ama.Dialogue: 0,0:06:43.65,0:06:45.79,Main,Ryuuboshi,0,0,0,,Daha doğrulamadık mi-re-do!Dialogue: 0,0:06:45.79,0:06:49.31,Main,Manboshi,0,0,0,,Millet! Hadi hepberaber dans edelim!Dialogue: 0,0:06:50.52,0:06:52.08,Main,Hammond,0,0,0,,Bu kargaşa da ne?Dialogue: 0,0:06:53.56,0:06:56.81,Main,Kasagon,0,0,0,,Hey, onlar Neptune Ordusu'nun prensleri!Dialogue: 0,0:06:56.81,0:06:58.27,Main,Hammond,0,0,0,,Neden buradalar?Dialogue: 0,0:06:58.75,0:07:00.27,Main,Hyouzou,0,0,0,,Bu bir sorun.Dialogue: 0,0:07:01.37,0:07:03.40,Main,Fukaboshi,0,0,0,,Anlıyorum. Çok teşekkür ederim.Dialogue: 0,0:07:03.89,0:07:05.84,Main,Fukaboshi,0,0,0,,Başka bir yere bakacağız.Dialogue: 0,0:07:05.84,0:07:08.58,Main,Fukaboshi,0,0,0,,Rahatsız ettiğimiz için özür dileriz.Dialogue: 0,0:07:08.58,0:07:11.35,Main,Manboshi,0,0,0,,Başka bir zaman yine dans edelim!Dialogue: 0,0:07:11.35,0:07:13.69,Main,Ryuuboshi,0,0,0,,Zahmet oldu fa-mi-re-do!Dialogue: 0,0:07:13.69,0:07:15.58,Main,Maameidzu,0,0,0,,Bir şey değil!Dialogue: 0,0:07:15.58,0:07:18.39,Main,Fukaboshi,0,0,0,,Sınır nöbetçileri bir hata mı yaptı acaba?Dialogue: 0,0:07:24.19,0:07:25.18,Main,Chopper,0,0,0,,Sanji!Dialogue: 0,0:07:26.79,0:07:28.60,Main,Mermaid,0,0,0,,Sanji-chan!Dialogue: 0,0:07:28.95,0:07:31.37,Main,Luffy,0,0,0,,Tüm o kanlar... Sanji'nin başı belada!Dialogue: 0,0:07:31.37,0:07:35.27,Main,Usopp,0,0,0,,İşe yaramadı! İçinde tuttuğu tüm heyecan patladı!Dialogue: 0,0:07:35.92,0:07:37.61,Main,Fukaboshi,0,0,0,,O...Dialogue: 0,0:07:37.61,0:07:41.51,Main,Fukaboshi,0,0,0,,Hiç şüphesiz, korsan Hasır Şapka Luffy.Dialogue: 0,0:07:41.51,0:07:43.23,Main,Fukaboshi,0,0,0,,Ammo Şövalyeleri!Dialogue: 0,0:07:43.23,0:07:43.91,Main,Knights,0,0,0,,Emredersiniz!Dialogue: 0,0:07:48.35,0:07:51.17,Main,Hammond,0,0,0,,Buradalarmış işte. Hasır Şapkalar bunlar.Dialogue: 0,0:07:51.17,0:07:53.75,Main,Kasagon,0,0,0,,Ne yapacağız? Ordu onları bizden önce yakalayacak!Dialogue: 0,0:07:53.75,0:07:58.09,Main,Hyouzou,0,0,0,,Ama burada Neptune Ordusu'na karşı kapışmak kötü bir fikir.Dialogue: 0,0:08:01.51,0:08:02.90,Main,Chopper,0,0,0,,Lütfen bekleyin!Dialogue: 0,0:08:02.90,0:08:05.06,Main,Chopper,0,0,0,,Ülkeye izinsiz girdiğimiz için özür dileriz!Dialogue: 0,0:08:05.06,0:08:07.32,Main,Chopper,0,0,0,,Ama eğer bizi tutuklayacaksanız, lütfen daha sonra yapın!Dialogue: 0,0:08:07.32,0:08:10.60,Main,Chopper,0,0,0,,Burada kanını bağışlamaya gönüllü biri var mı?!Dialogue: 0,0:08:10.98,0:08:15.04,Main,Chopper,0,0,0,,Eğer böyle devam ederse, bir saate kalmadan arkadaşımız ölecek!Dialogue: 0,0:08:15.37,0:08:18.51,Main,Chopper,0,0,0,,Kan grubu S, RH-.Dialogue: 0,0:08:18.51,0:08:21.52,Main,Chopper,0,0,0,,Çok yaygın değil ama, burada bu gruptan olan var mı?!Dialogue: 0,0:08:21.52,0:08:24.85,Main,Chopper,0,0,0,,Yoksa deniz adamları ve balık adamların insanlardan farklı kan grupları mı var?Dialogue: 0,0:08:25.70,0:08:27.02,Main,Caimie,0,0,0,,Chopper-chin...Dialogue: 0,0:08:27.02,0:08:29.73,Main,Chopper,0,0,0,,Acele edin! Kimse yok mu?!Dialogue: 0,0:08:29.73,0:08:32.53,Main,Usopp,0,0,0,,Bu kadar...  Bu kadar saçma bir şekilde ölemezsin!Dialogue: 0,0:08:33.23,0:08:36.10,Main,Luffy,0,0,0,,Lütfen, kim olursa! Yalvarıyorum!Dialogue: 0,0:08:36.10,0:08:38.53,Main,Luffy,0,0,0,,Sanji'ye kan verin!Dialogue: 0,0:08:38.97,0:08:41.17,Main,Caimie,0,0,0,,Luffy-chin, Chopper-chin!Dialogue: 0,0:08:41.17,0:08:44.58,Main,Caimie,0,0,0,,Deniz adamları ve balık adamlar insanlar ile aynı kan gruplarına sahip.Dialogue: 0,0:08:44.58,0:08:45.81,Main,Caimie,0,0,0,,Kan nakli yapılması mümkün.Dialogue: 0,0:08:45.81,0:08:46.66,Main,Caimie,0,0,0,,Ama...Dialogue: 0,0:08:52.74,0:08:56.61,Main,Hammond,0,0,0,,Bu insanlar saçmasapan şeyler söylüyorlar!Dialogue: 0,0:08:58.03,0:09:00.09,Main,Luffy,0,0,0,,Deniz canavarları olan adamlar bunlar!Dialogue: 0,0:09:00.09,0:09:03.29,Main,Knight,0,0,0,,Prens Fukaboshi, Balık Adam Bölgesi'nden Hammond.Dialogue: 0,0:09:06.76,0:09:10.19,Main,Hammon,0,0,0,,Kanımızı siz insanlar gibi alt sınıf türlere vermek mi?Dialogue: 0,0:09:10.19,0:09:14.92,Main,Hammon,0,0,0,,Kan vermek gibi bir şeye,  Balık Adam Adası'nda gönüllü olacak bir kişi bile yok!Dialogue: 0,0:09:14.92,0:09:17.51,Main,Hammon,0,0,0,,Ve birini bulsanız bile...Dialogue: 0,0:09:17.51,0:09:22.01,Main,Hammon,0,0,0,,bu adadaki insanlardan nefret edenler onları karanlığın gazabına maruz bırakırlar!Dialogue: 0,0:09:22.33,0:09:27.75,Main,Hammond,0,0,0,,O velet orada öylece yatıp kan kaybından ölebilir. Yardım etmek için bir şey yapmamıza gerek yok!Dialogue: 0,0:09:27.75,0:09:31.35,Main,Hammond,0,0,0,,Bu ülkede eski bir yasa vardır...Dialogue: 0,0:09:31.35,0:09:35.39,Main,Hammond,0,0,0,,"İnsanlarla kanınızı paylaşamazsınız."Dialogue: 0,0:09:36.03,0:09:36.96,Main,Usopp,0,0,0,,Ne?!Dialogue: 0,0:09:37.24,0:09:42.46,Main,Hammond,0,0,0,,Yanlış anlamayın! Bu yasaya siz insanlar tarafından karar verildi.Dialogue: 0,0:09:42.46,0:09:47.10,Main,Hammond,0,0,0,,Beraber olan uzun geçmişimiz boyunca, bizden her zaman canavarmışız gibi korktunuz!Dialogue: 0,0:09:47.10,0:09:50.67,Main,Hammond,0,0,0,,Kanımızın karışmasını yasaklayanlar sizdiniz!Dialogue: 0,0:09:50.67,0:09:55.48,Main,Hammond,0,0,0,,Balık Adam Adası'nın kahramanı, Fisher Tiger'ın ölümünün sebebi.Dialogue: 0,0:09:56.48,0:10:02.19,Main,Hammond,0,0,0,,Türü fark etmeksizin tüm köleleri serbest bırakmak için canını ortaya koyan adam. Kanlı bir savaştan sonra...Dialogue: 0,0:10:02.19,0:10:07.00,Main,Hammond,0,0,0,,kan nakli ile kolayca kurtarılabilecek olmasına rağmen hayatını kaybetti!Dialogue: 0,0:10:07.99,0:10:10.96,Main,Hammond,0,0,0,,Kalpsiz insanlar ona kan vermeyi reddettiği için...Dialogue: 0,0:10:10.96,0:10:12.26,Main,Hammond,0,0,0,,öldü!Dialogue: 0,0:10:13.93,0:10:20.40,Main,Hammond,0,0,0,,O bir tane astınızın hayatını boşverin, ve bizimle Balık Adam Bölgesi'ne gelin!Dialogue: 0,0:10:20.40,0:10:27.17,Main,Hammond,0,0,0,,Yeni Balık Adam Korsanları'nın kaptanı, Hody Jones-sama, sizi görmek istiyor!Dialogue: 0,0:10:27.17,0:10:30.31,Main,Usopp,0,0,0,,Hey, kurallarınız hakkında hiçbir şey bilmiyorum ama lütfen,Dialogue: 0,0:10:30.31,0:10:33.85,Main,Usopp,0,0,0,,Burada kan grubu S, RH- olan biri yok mu?!Dialogue: 0,0:10:34.52,0:10:36.15,Main,Usopp,0,0,0,,Karşılığında her şeyi yaparız!Dialogue: 0,0:10:36.15,0:10:39.09,Main,Usopp,0,0,0,,Şimdilik lütfen sadece onun hayatını kurtarın!Dialogue: 0,0:10:41.33,0:10:41.86,Main,Usopp,0,0,0,,Camie!Dialogue: 0,0:10:41.86,0:10:43.56,Main,Hammond,0,0,0,,Eğer isteyerek gelmeyecekseniz...Dialogue: 0,0:10:44.69,0:10:47.06,Main,Hammond,0,0,0,,Sizi güç kullanarak götüreceğiz!Dialogue: 0,0:10:47.95,0:10:49.10,Main,Hammond,0,0,0,,Utase Ami! Dialogue: 0,0:10:47.95,0:10:49.10,Attack,Hammond,0,0,0,,Trol AğıDialogue: 0,0:10:49.97,0:10:52.40,Main,Luffy,0,0,0,,Sizin dediklerinizi...Dialogue: 0,0:10:52.40,0:10:53.43,Main,Luffy,0,0,0,,yapmayacağımı...Dialogue: 0,0:10:53.77,0:10:54.85,Main,Luffy,0,0,0,,söylemedim mi?!Dialogue: 0,0:10:55.30,0:10:58.53,Main,Luffy,0,0,0,,Jet Pistol! Dialogue: 0,0:10:55.30,0:10:58.53,Attack,Luffy,0,0,0,,Jet TabancaDialogue: 0,0:11:03.53,0:11:05.96,Main,Usopp,0,0,0,,Luffy! Arkanda bir deniz canavarı var!Dialogue: 0,0:11:14.69,0:11:16.92,Main,Fukaboshi,0,0,0,,Balık Adam Bölgesi'nden Hammond ve çetesi...Dialogue: 0,0:11:16.92,0:11:18.56,Main,Usopp,0,0,0,,Deniz canavarı...Dialogue: 0,0:11:18.56,0:11:20.82,Main,Usopp,0,0,0,,daha dövüşmeden yenildiğini kabul mu etti?!Dialogue: 0,0:11:20.82,0:11:22.00,Main,Chopper,0,0,0,,Harika!Dialogue: 0,0:11:22.00,0:11:24.33,Main,Mermaid,0,0,0,,O da neydi? Luffy-chan harika!Dialogue: 0,0:11:24.33,0:11:25.82,Main,Fukaboshi,0,0,0,,Düşündüğüm gibi...Dialogue: 0,0:11:26.24,0:11:28.37,Main,Caimie,0,0,0,,Luffy-chin!Dialogue: 0,0:11:32.41,0:11:35.00,Main,Caimie,0,0,0,,Sanji-chin'i bindir!Dialogue: 0,0:11:35.00,0:11:36.41,Main,Caimie,0,0,0,,Şehre gidelim!Dialogue: 0,0:11:36.99,0:11:40.22,Main,Caimie,0,0,0,,Şehirdeki limanda bir sürü insan var!Dialogue: 0,0:11:40.22,0:11:40.91,Main,Caimie,0,0,0,,Acele et!Dialogue: 0,0:11:40.91,0:11:44.08,Main,Knight,0,0,0,,Sen, bekle! Ryugu prenslere aittir!Dialogue: 0,0:11:44.08,0:11:48.22,Main,Caimie,0,0,0,,Özür dilerim! Sanji-chin'i kurtardıktan sonra geri vereceğime söz veriyorum!Dialogue: 0,0:11:55.63,0:11:58.35,Main,Luffy,0,0,0,,Pekala, bindik! Camie, gidelim!Dialogue: 0,0:11:59.53,0:12:01.84,Main,Caimie,0,0,0,,Lütfen Ryugu-chin! Bizi şehre götür!Dialogue: 0,0:12:03.27,0:12:04.71,Main,Caimie,0,0,0,,Üzgünüm.Dialogue: 0,0:12:04.71,0:12:08.41,Main,Caimie,0,0,0,,Eğer aynı kan grubuna sahip olsaydım, seve seve yardım ederdim.Dialogue: 0,0:12:08.41,0:12:11.33,Main,Usopp,0,0,0,,Özür dilemen gereken bir şey yok.Dialogue: 0,0:12:11.33,0:12:14.35,Main,Usopp,0,0,0,,En baştan sapıkça düşüncelerinin olması  onun suçu.Dialogue: 0,0:12:14.35,0:12:17.52,Main,Usopp,0,0,0,,Baksana! Hala sırıtıyor.Dialogue: 0,0:12:17.52,0:12:20.28,Main,Chopper,0,0,0,,Sanji! Kes şunu artık!Dialogue: 0,0:12:20.28,0:12:24.29,Main,Chopper,0,0,0,,Hiçbir şey düşünme! Bir saniye bile kaybedemeyiz!Dialogue: 0,0:12:24.29,0:12:28.43,Main,Usopp,0,0,0,,Ama bu bana sen ve Hachi'nin iki yıl önce Sabaody'de yaşadığı ayrımcılığı hatırlatıyor.Dialogue: 0,0:12:28.43,0:12:30.50,Main,Usopp,0,0,0,,Sorun daha derin gibi.Dialogue: 0,0:12:30.50,0:12:33.39,Main,Usopp,0,0,0,,Bir burun kanamasının bu kadar ciddileşebileceğini hiç düşünmemiştim.Dialogue: 0,0:12:33.39,0:12:36.90,Main,Caimie,0,0,0,,Evet... Kan bağışlayacak birini zamanında bulup bulamayacağımız konusunda.Dialogue: 0,0:12:36.90,0:12:39.14,Main,Caimie,0,0,0,,Şehre varsak bile,  yine de biraz endişeliyim.Dialogue: 0,0:12:40.21,0:12:45.35,Main,Caimie,0,0,0,,Geçtiğimiz ay,  hiçbir insan bu adaya gelmedi.Dialogue: 0,0:12:45.35,0:12:47.98,Main,Caimie,0,0,0,,Bir süredir gelen tek misafirlersiniz.Dialogue: 0,0:12:47.98,0:12:50.86,Main,Luffy,0,0,0,,Neden? Burası ünlü bir yer değil mi?Dialogue: 0,0:12:50.86,0:12:53.39,Main,Caimie,0,0,0,,Evet, ünlü bir yer, ama...Dialogue: 0,0:12:53.39,0:12:58.29,Main,Caimie,0,0,0,,Neden bilmiyoruz, ama gezginlerin yolculuklarını bir şeyin engellediğine dair söylentiler var.Dialogue: 0,0:12:58.29,0:13:03.40,Main,Caimie,0,0,0,,Bunların hepsinin arkasında karanlık güçler olabilir diye...  Ülkedeki herkes bunun hakkında konuşuyor.Dialogue: 0,0:13:06.66,0:13:09.50,Main,Fukaboshi,0,0,0,,Bu çok tehlikeliydi.Dialogue: 0,0:13:09.50,0:13:12.32,Main,Fukaboshi,0,0,0,,Neden korsanları bizden saklıyordunuz?Dialogue: 0,0:13:14.05,0:13:16.28,Main,Mermaid,0,0,0,,Özür dileriz, Prens Fukaboshi!Dialogue: 0,0:13:16.28,0:13:19.01,Main,Mermaid,0,0,0,,Camie onların arkadaşları olduğunu söyledi.Dialogue: 0,0:13:19.01,0:13:24.35,Main,Mermaid,0,0,0,,Kötü insanlar değillerdi, o yüzden kaçak göçmenler olarak tutuklanmalarını istemedik.Dialogue: 0,0:13:25.28,0:13:27.39,Main,Mermaid,0,0,0,,Sanji-chan iyi olacak mı acaba?Dialogue: 0,0:13:27.39,0:13:31.86,Main,Fukaboshi,0,0,0,,Hemen bir sonuca varmayın. Onlar ünlü korsanlar.Dialogue: 0,0:13:31.86,0:13:35.31,Main,Fukaboshi,0,0,0,,Ülkeye nasıl girdikleri önemli değil.Dialogue: 0,0:13:35.31,0:13:37.66,Main,Fukaboshi,0,0,0,,Kim olduklarının zaten farkındaydık.Dialogue: 0,0:13:37.66,0:13:43.08,Main,Ryuuboshi,0,0,0,,Onları başka bir sebepten dolayı arıyorduk re-mi-fa!Dialogue: 0,0:13:43.08,0:13:44.74,Main,Mermaid,0,0,0,,Öyle mi?Dialogue: 0,0:13:48.26,0:13:51.09,Main,Fukaboshi,0,0,0,,Onlara Jinbe'nin mesajını...Dialogue: 0,0:13:51.09,0:13:53.72,Main,Fukaboshi,0,0,0,,iletme fırsatım olmadı.Dialogue: 0,0:13:58.67,0:14:01.93,Captions,Sign,0,0,220,,Ryugu Krallığı, Liman Kasabası   "Mercan Tepesi"Dialogue: 0,0:14:03.55,0:14:05.82,Main,Usopp,0,0,0,,Sanji! Uyandın mı?Dialogue: 0,0:14:05.82,0:14:06.53,Main,Caimie,0,0,0,,Sanji-chin!Dialogue: 0,0:14:08.67,0:14:10.40,Main,Sanji,0,0,0,,Burası da neresi?Dialogue: 0,0:14:12.53,0:14:13.43,Main,Chopper,0,0,0,,Şükürler olsun!Dialogue: 0,0:14:13.43,0:14:15.69,Main,Caimie,0,0,0,,Liman kasabasından bir arkadaşımın evindeyiz.Dialogue: 0,0:14:15.69,0:14:19.14,Main,Caimie,0,0,0,,Sanji-chin, vücudundaki çoğu kanı kaybedecektin!Dialogue: 0,0:14:20.24,0:14:25.21,Main,Chopper,0,0,0,,Aynı kan grubuna sahip bir bağışçı bulabildiğimiz için çok mutluyum!Dialogue: 0,0:14:25.21,0:14:26.85,Main,Sanji,0,0,0,,Anlıyorum... Kanım mı?Dialogue: 0,0:14:29.61,0:14:31.89,Main,Sanji,0,0,0,,Ne oldu bana?Dialogue: 0,0:14:31.89,0:14:35.69,Main,Caimie,0,0,0,,Bu kadar ani kalkmamalısın! Yatakta kal.Dialogue: 0,0:14:35.69,0:14:39.65,Main,Luffy,0,0,0,,Ama cidden balık adamlar neden ona kan vermeyi reddetti?Dialogue: 0,0:14:39.65,0:14:44.57,Main,Luffy,0,0,0,,Bütün kasabayı dolaştık ama hiç insan bulamadık!Dialogue: 0,0:14:44.57,0:14:47.25,Main,Usopp,0,0,0,,Gerçekten artık umut yok sandım!Dialogue: 0,0:14:47.25,0:14:50.47,Main,Sanji,0,0,0,,Yardım ettiğiniz için çok teşekkür ederim millet.Dialogue: 0,0:14:50.47,0:14:53.68,Main,Sanji,0,0,0,,Ama... Hiçbir şey hatırlayamıyorum.Dialogue: 0,0:14:53.68,0:14:56.91,Main,Sanji,0,0,0,,Nerede ne yapıyordum ben?Dialogue: 0,0:14:58.53,0:15:00.35,Main,Usopp & Luffy,0,0,0,,Sakın hatırlama!  Dialogue: 0,0:15:00.35,0:15:03.55,Main,Chopper,0,0,0,,Bir burun kanaması daha yaşarsan,  seni kurtaramayız!Dialogue: 0,0:15:03.55,0:15:09.73,Main,Usopp & Luffy,0,0,0,,Ah, doğru! Sanji, seni barda tanıştığımız kan bağışçılarıyla tanıştırayım!Dialogue: 0,0:15:14.74,0:15:18.37,Main,Sanji,0,0,0,,Yani bana narin bir bayan tarafından mı...  kan verildi?Dialogue: 0,0:15:22.72,0:15:24.04,Thoughts,blind woman,0,0,0,,Sorun yok...Dialogue: 0,0:15:24.50,0:15:30.04,Thoughts,blind woman,0,0,0,,Biz insanlar ihtiyaç anlarında  birbirimize yardım ederiz.Dialogue: 0,0:15:35.53,0:15:39.85,Captions,Sign,0,0,220,,Korsan İkizler   Splash ve SplatterDialogue: 0,0:15:33.76,0:15:36.03,Main,Oh god no,0,0,0,,Sorun yok, şapşal.Dialogue: 0,0:15:36.03,0:15:39.85,Main,Oh god no,0,0,0,,Eğer istersen, seve seve daha fazla veririz, şapşal.Dialogue: 0,0:15:47.55,0:15:49.53,Main,Luffy,0,0,0,,İyileştiğine çok sevindim.Dialogue: 0,0:15:51.37,0:15:53.90,Main,Usopp,0,0,0,,Hadi ama, teşekkür et artık.Dialogue: 0,0:15:54.77,0:15:58.23,Main,Chopper,0,0,0,,Luffy. Bir saniyeliğine bana sağ kolunu göster.Dialogue: 0,0:16:03.46,0:16:05.14,Main,Chopper,0,0,0,,Bir zehir tepkimesi...Dialogue: 0,0:16:05.14,0:16:08.52,Main,Chopper,0,0,0,,Gerçekten de o yara, zehir taşıyor.Dialogue: 0,0:16:08.52,0:16:12.20,Main,Luffy,0,0,0,,Şimdi söyleyince,  az önce balık adamlarla dövüşürken...Dialogue: 0,0:16:13.09,0:16:14.55,Main,Luffy,0,0,0,,küçük bir batma hissettim.Dialogue: 0,0:16:15.66,0:16:18.59,Main,Usopp,0,0,0,,Ve tamamen iyi misin?!Dialogue: 0,0:16:19.50,0:16:21.36,Main,Chopper,0,0,0,,Bu ölümcül bir zehir!Dialogue: 0,0:16:21.36,0:16:23.23,Main,Chopper,0,0,0,,İnanılmaz!Dialogue: 0,0:16:23.23,0:16:28.94,Main,Chopper,0,0,0,,Luffy'nin bedeni biz daha farketmeden antitoksinler üretmiş ve zehiri defetmiş olmalı!Dialogue: 0,0:16:28.94,0:16:33.02,Main,Chopper,0,0,0,,Daha önce  yüksek miktarlarda zehire maruz kaldın mı?Dialogue: 0,0:16:33.02,0:16:34.43,Main,Luffy,0,0,0,,Zehir mi...Dialogue: 0,0:16:35.41,0:16:39.38,Main,Luffy,0,0,0,,Impel Down'da az daha zehir yüzünden ölüyordum.Dialogue: 0,0:16:42.25,0:16:45.49,Main,Usopp,0,0,0,,Ölüyor muydun? Bu gerçekten de gülünecek bir şey mi?!Dialogue: 0,0:16:45.49,0:16:47.68,Main,Luffy,0,0,0,,Muhtemelen o adamdı...Dialogue: 0,0:16:47.68,0:16:50.29,Main,Luffy,0,0,0,,Ahtapot bacaklı kılıç ustası.Dialogue: 0,0:16:50.29,0:16:53.83,Main,Luffy,0,0,0,,Saldırıma karşı koyabildi sonuçta.Dialogue: 0,0:16:53.83,0:16:56.35,Main,Luffy,0,0,0,,Bayağı bir güçlüydü.Dialogue: 0,0:17:05.39,0:17:07.54,Main,Hyouzou,0,0,0,,Şu körfezden geldi.Dialogue: 0,0:17:07.54,0:17:11.11,Main,Hyouzou,0,0,0,,Bu denizkızları cidden susmak bilmiyor.Dialogue: 0,0:17:11.11,0:17:13.48,Main,Hyouzou,0,0,0,,Peki, şimdi ne yapmalıyım?Dialogue: 0,0:17:13.48,0:17:16.72,Main,Hyouzou,0,0,0,,Bu ikisi bu haldeyken.Dialogue: 0,0:17:16.75,0:17:22.87,Captions,,0,0,220,,Yeni Balık Adam Korsanları'nın Suikastçısı Hyouzou (Mavi Halkalı Ahtapot Deniz Adamı)Dialogue: 0,0:17:16.72,0:17:21.40,Main,Hyouzou,0,0,0,,Ben de düşüncesizce Hasır Şapka'yı zehirleyiverdim.Dialogue: 0,0:17:21.40,0:17:23.26,Main,Hyouzou,0,0,0,,Eğer ölürse çok kötü olur.Dialogue: 0,0:17:24.56,0:17:27.39,Main,Mermaid,0,0,0,,Az önceki çığlık Ishillyler'den geldi değil mi?Dialogue: 0,0:17:27.39,0:17:29.22,Main,Mermaid,0,0,0,,Ishilly!Dialogue: 0,0:17:29.22,0:17:31.40,Main,Mermaid,0,0,0,,Ishilly!Dialogue: 0,0:17:31.40,0:17:33.53,Main,Mermaid,0,0,0,,Onları buradan duyduğuma eminim.Dialogue: 0,0:17:33.53,0:17:35.27,Main,Mermaid,0,0,0,,Nereye gitmiş olabilirler?Dialogue: 0,0:17:35.27,0:17:39.81,Main,Mermaid,0,0,0,,Az önce varili açıp açmamak konusunda konuştuklarını duydum.Dialogue: 0,0:17:39.81,0:17:42.74,Main,Caimie,0,0,0,,Odayı ödünç almamıza izin veren,  Denizkızı Kafe'nin müdürü.Dialogue: 0,0:17:42.74,0:17:44.11,Main,Luffy,0,0,0,,Bu da ne?!Dialogue: 0,0:17:44.11,0:17:45.79,Main,Caimie,0,0,0,,Bu Madam Shyarly.Dialogue: 0,0:17:45.79,0:17:47.15,Main,Luffy,0,0,0,,Öyle mi? Sağol!Dialogue: 0,0:17:51.10,0:17:54.86,Captions,Sign,0,0,260,,Denizkızı Kafe'nin Sahibi Madam ShyarlyDialogue: 0,0:17:49.17,0:17:51.94,Main,Shyarly,0,0,0,,Sarışın çocuk artık iyi mi?Dialogue: 0,0:17:51.94,0:17:52.97,Main,Caimie,0,0,0,,Evet.Dialogue: 0,0:17:52.97,0:17:54.86,Main,Caimie,0,0,0,,Ama Madam, siz güzel olduğunuzdan,Dialogue: 0,0:17:54.86,0:17:57.76,Main,Caimie,0,0,0,,şimdilik odasından uzak durmalısınız.Dialogue: 0,0:17:57.76,0:18:02.01,Main,Caimie,0,0,0,,Ayrıca, burasının Denizkızı Kafe'nin  arka odaları olduğunu...Dialogue: 0,0:18:02.01,0:18:04.02,Main,Caimie,0,0,0,,Sanji-chin'e söylemeyin.Dialogue: 0,0:18:04.02,0:18:05.31,Main,Shyarly,0,0,0,,Neden?Dialogue: 0,0:18:05.31,0:18:07.20,Main,Caimie,0,0,0,,Çünkü eğer öğrenirse...Dialogue: 0,0:18:07.20,0:18:11.10,Main,Caimie,0,0,0,,başı yine belaya girer ve  doktoru Chopper-chin öyle diyor.Dialogue: 0,0:18:11.10,0:18:13.32,Main,Shyarly,0,0,0,,Garip talimatlarmış.Dialogue: 0,0:18:14.46,0:18:17.01,Main,Luffy,0,0,0,,Hey! Dev denizkızı!Dialogue: 0,0:18:17.01,0:18:19.65,Main,Caimie,0,0,0,,Adı Madam Shyarly, Luffy-chin!Dialogue: 0,0:18:19.65,0:18:20.93,Main,Luffy,0,0,0,,Bu da ne böyle?Dialogue: 0,0:18:20.93,0:18:22.35,Main,Usopp,0,0,0,,Çok güzel!Dialogue: 0,0:18:22.35,0:18:25.51,Main,Shyarly,0,0,0,,Ona sakın dokunma, Hasır Şapkalı Çocuk.Dialogue: 0,0:18:25.51,0:18:26.14,Main,Luffy & Usopp,0,0,0,,Ha?Dialogue: 0,0:18:26.14,0:18:29.84,Main,Caimie,0,0,0,,O falcılık için kullanılan bir kristal küre.Dialogue: 0,0:18:29.84,0:18:33.98,Main,Caimie,0,0,0,,Madam yaptığı gelecek tahminleri yüzünden burada, Mercan Tepesi'nde çok ünlüdür.Dialogue: 0,0:18:35.18,0:18:38.37,Main,Shyarly,0,0,0,,Artık falcılığı bıraktım.Dialogue: 0,0:18:38.37,0:18:42.17,Main,Shyarly,0,0,0,,Geleceği bilmemek daha iyidir.Dialogue: 0,0:18:42.46,0:18:45.43,Main,Luffy,0,0,0,,Peki, denizkızları kaka yapıyor mu?Dialogue: 0,0:18:45.86,0:18:48.24,Main,Usopp,0,0,0,,"Peki" de ne demek?! Bunun falcılıkla bir alakası yok!Dialogue: 0,0:18:48.24,0:18:50.58,Main,Shyarly,0,0,0,,Kaba çocuk!Dialogue: 0,0:18:50.58,0:18:52.69,Main,Caimie,0,0,0,,Ondan özür dile, Luffy-chin!Dialogue: 0,0:18:52.69,0:18:53.73,Main,Luffy & Usopp,0,0,0,,Üzgünüm!Dialogue: 0,0:18:54.23,0:18:55.50,Main,Shyarly,0,0,0,,Camie...Dialogue: 0,0:18:55.50,0:18:57.90,Main,Shyarly,0,0,0,,Bugün izin alabilirsin.Dialogue: 0,0:18:57.90,0:19:00.12,Main,Shyarly,0,0,0,,Arkadaşlarına adayı gezdir.Dialogue: 0,0:19:01.05,0:19:01.94,Main,Caimie,0,0,0,,Emin misiniz?Dialogue: 0,0:19:01.94,0:19:04.95,Main,Shyarly,0,0,0,,Çok sıkı çalışıyorsun sonuçta.Dialogue: 0,0:19:04.95,0:19:05.86,Main,Shyarly,0,0,0,,Ayrıca...Dialogue: 0,0:19:06.57,0:19:10.38,Main,Shyarly,0,0,0,,Son zamanlarda bir tane bile korsan insan müşterimiz olmamıştı.Dialogue: 0,0:19:10.38,0:19:12.80,Main,Shyarly,0,0,0,,Bu iş için çok iyi olacak.Dialogue: 0,0:19:12.80,0:19:17.47,Main,Shyarly,0,0,0,,Yakında körfezden kızlar gelecek,  o yüzden gerekenden fazla personelimiz var.Dialogue: 0,0:19:17.47,0:19:18.99,Main,Caimie,0,0,0,,Ah, şimdi hatırladım!Dialogue: 0,0:19:18.99,0:19:22.08,Main,Caimie,0,0,0,,Hemen Pappag'a midyelerini götürmeliyim!Dialogue: 0,0:19:22.84,0:19:25.08,Main,Usopp,0,0,0,,Bunu farketmek için garip bir yol.Dialogue: 0,0:19:25.08,0:19:27.92,Main,Shyarly,0,0,0,,Açlıktan ölüyor olmalı.Dialogue: 0,0:19:27.92,0:19:29.20,Main,Shyarly,0,0,0,,Ne?Dialogue: 0,0:19:29.20,0:19:33.16,Main,Shyarly,0,0,0,,Eğer Mösyo Pappag'dan bahsediyorsan, eski bir arkadaşıyla karşılaştı.Dialogue: 0,0:19:33.16,0:19:34.99,Main,Shyarly,0,0,0,,İkisi şu anda kafede takılıyorlar.Dialogue: 0,0:19:39.53,0:19:42.25,Main,Caimie,0,0,0,,Az önce bunu söylemedim ama...Dialogue: 0,0:19:42.25,0:19:45.29,Main,Caimie,0,0,0,,Madam daha bir çocukken,Dialogue: 0,0:19:45.29,0:19:48.72,Main,Caimie,0,0,0,,yakında bir sürü korsanın  adaya geleceğini söylemişti...Dialogue: 0,0:19:49.11,0:19:53.71,Main,Caimie,0,0,0,,Ve ondan sonraki yıl Büyük Korsan Çağı başladı.Dialogue: 0,0:19:53.71,0:19:55.61,Main,Luffy & Usopp,0,0,0,,Ne?!Dialogue: 0,0:19:55.91,0:19:58.10,Main,Caimie,0,0,0,,Tüm detayları anlatırsam çok uzun sürer ama,Dialogue: 0,0:19:58.10,0:20:03.53,Main,Caimie,0,0,0,,bir süre önce Marineford'daki savaşı ve Beyazsakal'ın ölümünü de tahmin etti.Dialogue: 0,0:20:03.53,0:20:07.07,Main,Caimie,0,0,0,,Bir sürü kötü şey tahmin ettiğinden dolayı,  artık bıkmış gibi duruyor.Dialogue: 0,0:20:07.07,0:20:08.76,Main,Usopp,0,0,0,,Çok korkunç!Dialogue: 0,0:20:08.76,0:20:10.26,Main,Luffy,0,0,0,,Hey, Chopper nerede?Dialogue: 0,0:20:10.26,0:20:13.17,Main,Usopp,0,0,0,,Sanji'ye göz kulak oluyor.Dialogue: 0,0:20:13.17,0:20:15.06,Main,Caimie,0,0,0,,Luffy-chin, Usopp-chin!Dialogue: 0,0:20:15.06,0:20:16.31,Main,Luffy & Usopp,0,0,0,,Geliyoruz!Dialogue: 0,0:20:19.09,0:20:22.20,Main,Caimie,0,0,0,,Burası Mercan Tepesi'nin ana caddesi.Dialogue: 0,0:20:22.20,0:20:25.70,Main,Caimie,0,0,0,,Bakın! Burası Denizkızı Kafe'nin girişi!Dialogue: 0,0:20:29.08,0:20:31.88,Main,Luffy,0,0,0,,Ah, karnım acıktı!Dialogue: 0,0:20:31.88,0:20:33.51,Main,Usopp,0,0,0,,Burası bir kafe!Dialogue: 0,0:20:33.51,0:20:35.18,Main,Caimie,0,0,0,,Yiyecek de var.Dialogue: 0,0:20:35.18,0:20:37.08,Main,Caimie,0,0,0,,Kek ve deniz meyveleri gibi!Dialogue: 0,0:20:37.08,0:20:38.38,Main,Luffy,0,0,0,,Peki et?Dialogue: 0,0:20:38.38,0:20:42.26,Main,Caimie,0,0,0,,Denizkızları et veya balık yemez, o yüzden...Dialogue: 0,0:20:42.26,0:20:46.36,Main,Caimie,0,0,0,,menü Deniz Yosunu Brûlée,  Alg Turtası, Varek Sufle...Dialogue: 0,0:20:46.36,0:20:48.60,Main,Usopp,0,0,0,,Bunlardan herhangi biri iyi mi?Dialogue: 0,0:20:48.60,0:20:50.44,Main,Caimie,0,0,0,,Ama bizde de et var!Dialogue: 0,0:20:50.44,0:20:51.55,Main,Luffy,0,0,0,,Ne?!Dialogue: 0,0:20:51.55,0:20:55.16,Main,Caimie,0,0,0,,Kabuklu Eti, Tarak Sandviçi,  Tatlısu Midyesi Pizzası-Dialogue: 0,0:20:55.16,0:20:58.31,Main,Luffy,0,0,0,,Kabuklu Eti sayılmaz! Eti hafife alma!Dialogue: 0,0:20:58.31,0:21:01.64,Main,Usopp,0,0,0,,Her neyse, hadi gidelim. Denizkızı Kafe'ye.Dialogue: 0,0:21:01.64,0:21:04.04,Main,Caimie,0,0,0,,Evet. Pappag içerde.Dialogue: 0,0:21:04.04,0:21:06.31,Main,Luffy,0,0,0,,Ciddiyim, eti hafife alma!Dialogue: 0,0:21:06.31,0:21:09.28,Main,Maameidzu,0,0,0,,Çok teşekkür ederiz!Dialogue: 0,0:21:12.42,0:21:13.81,Main,Luffy & Usopp,0,0,0,,Brook!Dialogue: 0,0:21:13.81,0:21:15.06,Main,Caimie,0,0,0,,Brook-chin!Dialogue: 0,0:21:15.06,0:21:17.63,Main,Brook,0,0,0,,Ha? Luffy-sanlar!Dialogue: 0,0:21:17.63,0:21:20.51,Main,Brook,0,0,0,,Ve Camie-san, çok uzun zaman oldu!Dialogue: 0,0:21:20.51,0:21:22.40,Main,Pappagg,0,0,0,,Hasır! Burun!Dialogue: 0,0:21:22.40,0:21:25.45,Main,Pappagg,0,0,0,,Sizi çok özledim beyler!Dialogue: 0,0:21:25.45,0:21:27.13,Main,Pappagg,0,0,0,,Sonunda geldiniz mi?Dialogue: 0,0:21:27.13,0:21:30.13,Main,Usopp,0,0,0,,Pappag ile mi beraberdin?Dialogue: 0,0:21:30.13,0:21:32.16,Main,Maameidzu,0,0,0,,Ruh Kralı, lütfen tekrar gel!Dialogue: 0,0:21:33.22,0:21:35.73,Main,Maameidzu,0,0,0,,Sanki bir rüyada yaşıyormuşuz gibi!Dialogue: 0,0:21:37.64,0:21:41.39,Main,Brook,0,0,0,,Kesinlikle geri geleceğim, güzel denizkızları!Dialogue: 0,0:21:41.39,0:21:42.56,Main,Usopp,0,0,0,,Ne?Dialogue: 0,0:21:42.56,0:21:44.75,Main,Brook,0,0,0,,Kemiklerimi biraz gevşetmem gerek.Dialogue: 0,0:21:46.06,0:21:50.67,Main,Brook,0,0,0,,Ah! Ama eğer kemiklerimi gevşetseydim, ölürdüm!Dialogue: 0,0:21:50.67,0:21:55.07,Main,Brook,0,0,0,,Şimdi ölsem hiç sıkıntı etmem!  Ben çoktan ölüyüm gerçi.Dialogue: 0,0:21:55.07,0:21:56.46,Main,Maameidzu,0,0,0,,Harika!Dialogue: 0,0:21:56.46,0:21:59.41,Main,Usopp,0,0,0,,Daha az önce kafedelerdi ama yine de bu kadar heyecanlılar.Dialogue: 0,0:21:59.41,0:22:01.74,Main,Luffy,0,0,0,,Gerçekten! İçeride neler dönüyor acaba?Dialogue: 0,0:22:01.74,0:22:04.54,Main,Pappagg,0,0,0,,Bekle! Bekle! Bekle!Dialogue: 0,0:22:04.54,0:22:06.71,Main,Pappagg,0,0,0,,Bugün gitmeyeceksiniz değil mi?Dialogue: 0,0:22:06.71,0:22:12.55,Main,Pappagg,0,0,0,,İlginizi anlıyorum ama daha sonra hep beraber Denizkızı Kafe'ye gidebiliriz.Dialogue: 0,0:22:12.55,0:22:17.80,Main,Pappagg,0,0,0,,Ben de tam Kemik'e malikanemi  göstermeye gidecektim!Dialogue: 0,0:22:17.80,0:22:20.62,Main,Pappagg,0,0,0,,Peşimden gelin!  Deniz canavarı eti sever misiniz?Dialogue: 0,0:22:20.62,0:22:22.80,Main,Luffy,0,0,0,,Etin var mı?!Dialogue: 0,0:22:22.80,0:22:27.01,Main,Pappagg,0,0,0,,Benim gibi vahşi bir adamın, denizkabuğu ve yosun ile tatmin olacağını mı düşünüyorsun?Dialogue: 0,0:22:27.01,0:22:30.46,Main,Pappagg,0,0,0,,Benim beslenmem, en dişli deniz canavarlarının etinden oluşuyor!Dialogue: 0,0:22:30.46,0:22:32.43,Main,Caimie,0,0,0,,Ah Pappag, unutmuşum!Dialogue: 0,0:22:32.43,0:22:34.15,Main,Caimie,0,0,0,,İşte, bugünün midyeleri.Dialogue: 0,0:22:34.15,0:22:37.53,Main,Pappagg,0,0,0,,Oley! Camie'nin leziz midyeleri!Dialogue: 0,0:22:37.53,0:22:39.17,Main,Usopp,0,0,0,,Hey, kabuklu değil mi onlar?!Dialogue: 0,0:22:39.17,0:22:43.53,Main,Pappagg,0,0,0,,Denizkızları et ve balık yemez ama balık adamlar yer.Dialogue: 0,0:22:43.53,0:22:46.74,Main,Pappagg,0,0,0,,Yani adada bunlardan hiç yok demek değil bu.Dialogue: 0,0:22:46.74,0:22:48.28,Main,Luffy,0,0,0,,Gerçekten mi? Çok şükür!Dialogue: 0,0:22:48.28,0:22:49.57,Main,Pappagg,0,0,0,,Hey, taksi!Dialogue: 0,0:22:51.60,0:22:52.93,Main,Brook,0,0,0,,Vander Decken?!Dialogue: 0,0:22:53.61,0:22:55.94,Main,Brook,0,0,0,,Neden bir hayalet arananlar listesinde?Dialogue: 0,0:22:57.13,0:22:59.36,Main,Usopp,0,0,0,,Buraya gelirken karşılaştığımız  hayalet gemideki adam mı?Dialogue: 0,0:22:59.85,0:23:01.90,Main,Pappagg,0,0,0,,Ne? Siz onunla tanıştınız mı?!Dialogue: 0,0:23:02.56,0:23:09.68,Main,Pappagg,0,0,0,,O ülkenin yıllardır peşinde olduğu bir tür sualtı korsanı.Dialogue: 0,0:23:09.68,0:23:13.26,Main,Pappagg,0,0,0,,Ama bunu daha sonra konuşalım. Şimdi, binin!Dialogue: 0,0:23:18.04,0:23:26.86,Main,Pappagg,0,0,0,,O Vander Decken denilen adam, her hafta Ryugu Krallığı'nın Denizkızı Prenses'ine aşk mektupları gönderirdi.Dialogue: 0,0:23:28.81,0:23:33.80,Main,Pappagg,0,0,0,,En sonunda mektuplardan paketlere, sonra da onunla evlenmesi için tehditler ve taleplerle devam etti.Dialogue: 0,0:23:33.80,0:23:35.80,Main,Luffy & Usopp,0,0,0,,Bu çok yumuşak! Çok iyi hissettiriyor!Dialogue: 0,0:23:35.80,0:23:37.90,Main,Brook,0,0,0,,Gerçekten sanki cennet gibi!Dialogue: 0,0:23:38.89,0:23:41.13,Main,Pappagg,0,0,0,,Anlattıklarımı dinleyin!Dialogue: 0,0:23:41.13,0:23:42.20,Main,Luffy & Usopp,0,0,0,,Tamam!Dialogue: 0,0:23:42.20,0:23:43.10,Main,Brook,0,0,0,,Ah, affedersin.Dialogue: 0,0:23:43.10,0:23:45.11,Main,Pappagg,0,0,0,,Denizkızı Prenses çok korkmuştu...Dialogue: 0,0:23:45.11,0:23:48.75,Main,Pappagg,0,0,0,,ve ülke bunu daha fazla görmezden gelemezdi,  o yüzden...Dialogue: 0,0:23:48.75,0:23:52.87,Main,Caimie,0,0,0,,Evet! Prensesin babası, Kral Neptune sinirlendi,Dialogue: 0,0:23:53.50,0:23:58.59,Main,Caimie,0,0,0,,ve daha önce karşılaştığınız üç prens onun peşinden gitmeleri için orduyu harekete geçirdi,Dialogue: 0,0:23:58.59,0:24:00.59,Main,Caimie,0,0,0,,ama onu bulamadılar.Dialogue: 0,0:24:00.59,0:24:04.35,Main,Pappagg,0,0,0,,Camie... Camie... Ben tam da açıklayacaktım.Dialogue: 0,0:24:04.35,0:24:08.87,Main,Caimie,0,0,0,,Yani, bu ülkeyi yöneten,  Deniz Tanrısı Kral Neptune'un,Dialogue: 0,0:24:08.87,0:24:12.94,Main,Caimie,0,0,0,,Denizkızı Prenses de dahil dört çocuğu var.Dialogue: 0,0:24:12.94,0:24:18.81,Main,Caimie,0,0,0,,En gençleri Denizkızı Prenses ve  onun abileri de daha önce karşılaştığınız üç prens.Dialogue: 0,0:24:18.81,0:24:21.53,Main,Brook,0,0,0,,Ah, ben bir şey sormak istiyorum.Dialogue: 0,0:24:21.53,0:24:28.03,Main,Brook,0,0,0,,Vander Decken birkaç yüz yıl önceden kalma lanetli korsan değil mi?Dialogue: 0,0:24:28.03,0:24:29.24,Main,Pappagg,0,0,0,,Oh!Dialogue: 0,0:24:29.24,0:24:34.04,Main,Pappagg,0,0,0,,Efsaneler genellikle abartıların abartılarıdır.Dialogue: 0,0:24:34.25,0:24:36.70,Main,Pappagg,0,0,0,,Önceden de yaşıyormuş gibi duruyor ama,Dialogue: 0,0:24:36.70,0:24:45.42,Main,Pappagg,0,0,0,,efsanedeki Vander Decken aslında sadece bu adaya ulaşan ve bu ülkede yaşayan bir adammış.Dialogue: 0,0:24:45.42,0:24:51.22,Main,Pappagg,0,0,0,,Bu yüzden, önceden karşılaştığınız gemi muhtemelen gerçek Uçan Hollandalı...Dialogue: 0,0:24:52.43,0:24:54.67,Main,Pappagg,0,0,0,,ama kaptan sadece onun torunu!Dialogue: 0,0:24:56.24,0:24:56.53,Main,Pappagg,0,0,0,,Va-Dialogue: 0,0:24:56.53,0:24:58.61,Main,Caimie,0,0,0,,Dokuzuncu Vander Decken!Dialogue: 0,0:25:00.03,0:25:04.07,Captions,,0,0,220,,Balık TaksiDialogue: 0,0:24:58.61,0:25:00.63,Main,Brook,0,0,0,,Ne?! Torunu mu?!Dialogue: 0,0:25:00.63,0:25:04.54,Main,Brook,0,0,0,,Ah, öyle mi? Hayalet değilmiş demek ki.Dialogue: 0,0:25:04.54,0:25:09.67,Main,Brook,0,0,0,,Sadece kemikli halimle gerçek bir hayaletle karşılaştığım için canlıdan daha çok ölü gibi hissetmeye başlamıştım.Dialogue: 0,0:25:09.67,0:25:12.74,Main,Brook,0,0,0,,Çok şükür. Hiç değilse buna çok sevindim.Dialogue: 0,0:25:12.74,0:25:15.58,Main,Pappagg,0,0,0,,Camie... Camie... Camie...Dialogue: 0,0:25:15.58,0:25:21.43,Main,Luffy,0,0,0,,Ah! Şimdi yakından bakınca, çok farklı türde denizkızı ve balık adam var!Dialogue: 0,0:25:21.86,0:25:25.41,Main,Usopp,0,0,0,,Nine denizkızları da var! Tıpkı yaşlı Kokoro'ya benziyorlar!Dialogue: 0,0:25:25.41,0:25:28.01,Main,Pappagg,0,0,0,,Oraya bakın! Bebekler!Dialogue: 0,0:25:28.41,0:25:32.45,Main,Pappagg,0,0,0,,Babaları balık adam ama çocukların ikisi de denizkızı ve balık adam.Dialogue: 0,0:25:32.83,0:25:40.52,Main,Pappagg,0,0,0,,Yani, eğer bir balık adam ve deniz kızı evlenirse,  iki ırktan da oğulları ve kızları olabilir.Dialogue: 0,0:25:40.52,0:25:43.72,Main,Pappagg,0,0,0,,Diğer bir deyişle, muhtemel dört sonuç var.Dialogue: 0,0:25:43.72,0:25:46.23,Main,Luffy,0,0,0,,Demek o yüzden bu kadar farklı tür var!Dialogue: 0,0:25:46.23,0:25:48.19,Main,Luffy,0,0,0,,Çok havalı!Dialogue: 0,0:25:48.19,0:25:50.70,Main,Pappagg,0,0,0,,Yüksek hızlı akıntıya biniyoruz.Dialogue: 0,0:25:55.18,0:25:56.64,Main,Luffy,0,0,0,,Çok hızlı!Dialogue: 0,0:25:56.64,0:25:58.92,Main,Luffy,0,0,0,,Ha? O da ne?Dialogue: 0,0:25:58.92,0:26:01.21,Main,Pappagg,0,0,0,,Ah, o şeker fabrikası.Dialogue: 0,0:26:01.21,0:26:04.08,Main,Luffy,0,0,0,,Onu kastetmedim. Üzerinde neden bir korsan bayrağı var?Dialogue: 0,0:26:04.08,0:26:09.14,Main,Pappagg,0,0,0,,Ah, o mu?  Körfezde ve adanın girişinde de bir tane var.Dialogue: 0,0:26:09.14,0:26:12.82,Main,Pappagg,0,0,0,,Balık Adam Adası şu anda o korsan bayrağının koruması altında.Dialogue: 0,0:26:13.38,0:26:18.06,Main,Pappagg,0,0,0,,O işaretin sahibi,  Yeni Dünya korsanı Charlotte Linlin.Dialogue: 0,0:26:18.06,0:26:21.69,Main,Pappagg,0,0,0,,Diğer adıyla, Big Mom. Yonko'dan biri!Dialogue: 0,0:26:22.30,0:26:28.50,Main,Pappagg,0,0,0,,Savaştan önce, bu ada Beyazsakal'ın adıyla korsanlardan korunuyordu.Dialogue: 0,0:26:28.50,0:26:30.82,Main,Pappagg,0,0,0,,Şimdi, Big Mom da aynısını yapıyor.Dialogue: 0,0:26:30.82,0:26:32.71,Main,Luffy,0,0,0,,Öyle mi?Dialogue: 0,0:26:32.71,0:26:37.38,Main,Pappagg,0,0,0,,Karşılığında, ona her ay yüksek miktarlarda şeker veriyoruz.Dialogue: 0,0:26:37.38,0:26:39.80,Main,Pappagg,0,0,0,,Fabrikanın amacı bu.Dialogue: 0,0:26:39.80,0:26:40.81,Main,Luffy,0,0,0,,Şeker mi?Dialogue: 0,0:26:41.20,0:26:44.42,Main,Luffy,0,0,0,,Onun gibi güçlü biri tarafından korunmazsak,Dialogue: 0,0:26:44.42,0:26:46.30,Main,Luffy,0,0,0,,ülke ayakta kalamaz.Dialogue: 0,0:26:46.30,0:26:50.76,Main,Luffy,0,0,0,,Burası korsanların ana yolu olduğu için,  tehlikeli bir yer sonuçta.Dialogue: 0,0:26:50.76,0:26:56.26,Main,Luffy,0,0,0,,Ama eğer bu Big Mom sizi Beyazsakal amcanın yerine koruyorsa, iyi biri olmalı değil mi?Dialogue: 0,0:26:56.74,0:27:01.31,Main,Pappagg,0,0,0,,Söylemesi zor...  En azından Beyazsakal ödeme istemiyordu.Dialogue: 0,0:27:01.31,0:27:04.90,Main,Pappagg,0,0,0,,Belki de Big Mom bunu bir iş gibi düşünüyordur.Dialogue: 0,0:27:04.90,0:27:08.96,Main,Luffy,0,0,0,,Big Mom ha? Shanks gibi bir Yonko.Dialogue: 0,0:27:04.90,0:27:08.96,Note,Luffy,0,0,0,,Yonko: Dört İmparatorDialogue: 0,0:27:08.96,0:27:10.93,Main,Luffy,0,0,0,,Onunla bir gün karşılaşacak mıyım acaba?Dialogue: 0,0:27:11.39,0:27:12.43,Main,Pappagg,0,0,0,,İleriye bakın!Dialogue: 0,0:27:13.07,0:27:16.90,Main,Pappagg,0,0,0,,Burası ünlülerin şehri, Gyoverly Hills!Dialogue: 0,0:27:18.23,0:27:22.32,Main,Caimie,0,0,0,,Önümüzde duran o kocaman bina Pappag'ın evi!Dialogue: 0,0:27:22.32,0:27:25.29,Main,They,0,0,0,,O mu?! Ama o sadece bir denizyıldızı!Dialogue: 0,0:27:25.29,0:27:26.93,Captions,,0,0,220,,Mercan TepesiDialogue: 0,0:27:29.27,0:27:31.23,Main,Shyarly,0,0,0,,Bu hiç iyi değil.Dialogue: 0,0:27:32.73,0:27:36.03,Main,Fishman,0,0,0,,Denizkızı Kafe'den Madam değil mi o?Dialogue: 0,0:27:36.03,0:27:38.43,Main,Fishman,0,0,0,,Sorun nedir, Madam Shyarly?Dialogue: 0,0:27:38.43,0:27:40.14,Main,Fishman,0,0,0,,Neden bu kadar üzgünsünüz?Dialogue: 0,0:27:40.14,0:27:43.44,Main,Shyarly,0,0,0,,Eğer hemen bir şey yapmazsak,  berbat bir şey olacak!Dialogue: 0,0:27:43.44,0:27:45.85,Main,Fishman,0,0,0,,Hey, Madam... Neden öyle diyorsun?Dialogue: 0,0:27:48.16,0:27:49.52,Main,Shyarly,0,0,0,,Gidip arayın onu!Dialogue: 0,0:27:49.52,0:27:52.75,Main,Shyarly,0,0,0,,Hasır şapka takan korsan çocuğu...Dialogue: 0,0:27:54.67,0:27:58.02,Main,Shyarly,0,0,0,,Hemen bu krallıktan atın onu!Dialogue: 0,0:27:58.02,0:28:00.23,Main,Fishman,0,0,0,,Bu başka bir tahmin mi?Dialogue: 0,0:28:00.23,0:28:02.48,Main,Shyarly,0,0,0,,Bakmak gibi bir niyetim yoktu...Dialogue: 0,0:28:02.48,0:28:08.29,Main,Shyarly,0,0,0,,ama onda bir şey hissettim  ve hızlıca göz attım...Dialogue: 0,0:28:08.29,0:28:09.37,Main,Shyarly,0,0,0,,onun geleceğine!Dialogue: 0,0:28:10.50,0:28:13.81,Main,Fishman,0,0,0,,Ne oldu?! Ne gördün?!Dialogue: 0,0:28:13.81,0:28:15.24,Main,Mermaid,0,0,0,,Madam?!Dialogue: 0,0:28:15.24,0:28:16.16,Main,Mermaid,0,0,0,,Shyarly?!Dialogue: 0,0:28:17.24,0:28:20.60,Main,Shyarly,0,0,0,,Yanlış olsun! Lütfen, tahminim yanlış olsun!Dialogue: 0,0:28:27.29,0:28:30.47,Main,Shyarly,0,0,0,,Hasır şapka takan bir insan...Dialogue: 0,0:28:32.39,0:28:34.84,Main,Shyarly,0,0,0,,Hasır Şapkalı Luffy...Dialogue: 0,0:28:34.84,0:28:36.75,Main,Shyarly,0,0,0,,Kendi elleriyle...Dialogue: 0,0:28:36.75,0:28:38.16,Main,Shyarly,0,0,0,,Balık Adam Adası'nı...Dialogue: 0,0:28:40.71,0:28:44.01,Main,Shyarly,0,0,0,,yok edecek!Dialogue: 0,0:00:39.81,0:00:43.07,Credits,,0,0,0,,Translation & initial timing Yibis FansubsDialogue: 0,0:00:45.24,0:00:48.84,Credits,,0,0,0,,Timing Galaxy 9000  SewilDialogue: 0,0:00:50.20,0:00:54.26,Credits,,0,0,0,,Quality checking Sewil  Feeso  Galaxy 9000Dialogue: 0,0:00:54.59,0:00:58.79,Credits,,0,0,0,,Soundtracking HaleeDialogue: 0,0:01:16.42,0:01:18.52,Credits,,0,0,0,,Video editing Sewil