Dialogue: 0,0:02:32.62,0:02:33.97,Main,Citizen,0,0,0,,N-Noah...
Dialogue: 0,0:02:39.46,0:02:44.06,Main,Citizen,0,0,0,,Noah artık düşmüyor.
Dialogue: 0,0:02:44.06,0:02:48.56,Main,Citizen,0,0,0,,Prenses gemiyi bizim için uzağa çekiyor!
Dialogue: 0,0:02:48.56,0:02:50.52,Main,Citizen2,0,0,0,,Prenses Shirahoshi!
Dialogue: 0,0:02:50.52,0:02:52.20,Main,Citizen,0,0,0,,Kaçın lütfen!
Dialogue: 0,0:02:56.13,0:02:58.53,Main,Decken,0,0,0,,Nereye gittiğini sanıyorsun, Shirahoshi?
Dialogue: 0,0:02:58.53,0:03:00.44,Main,Decken,0,0,0,,Kaçacak yerin yok!
Dialogue: 0,0:03:00.44,0:03:04.37,Main,Decken,0,0,0,,Shirahoshi!
Dialogue: 0,0:03:09.83,0:03:14.34,Main,Shirahoshi,0,0,0,,Denize ulaşmalı ve Noah'yı balonun dışına çekmeliyim!
Dialogue: 0,0:03:21.90,0:03:26.07,Main,Shirahoshi,0,0,0,,Balon şu anda olduğundan daha fazla hasar alırsa çok kötü olur!
Dialogue: 0,0:03:26.48,0:03:29.91,Main,Shirahoshi,0,0,0,,Ama ana giriş daha çok uzakta.
Dialogue: 0,0:03:31.43,0:03:38.08,Main,Shirahoshi,0,0,0,,Ryugu Şatosu'ndan ayrılan son kişiler Luffy-sama'nın arkadaşları olmalı...
Dialogue: 0,0:03:38.08,0:03:42.45,Main,Shirahoshi,0,0,0,,{\fad(0,600)}Belki de bağlantı kanalını açık bırakmışlardır!
Dialogue: 0,0:03:47.12,0:03:51.25,Main,Fishman,0,0,0,,Kahretsin, yapabileceğimiz hiçbir şey yok mu?!
Dialogue: 0,0:03:51.72,0:03:56.19,Main,Fishman2,0,0,0,,Prenses bizi kurtarmak için hayatını riske atıyor!
Dialogue: 0,0:03:56.19,0:04:00.00,Main,Fishman,0,0,0,,Decken'in onun peşine düşmesi Prenses'in suçu değil!
Dialogue: 0,0:04:00.00,0:04:03.20,Main,Fishman2,0,0,0,,Decken o geminin üstünde. Ve sadece o da değil...
Dialogue: 0,0:04:03.20,0:04:05.47,Main,Fishman2,0,0,0,,Hody de gemiye tırmanıyor!
Dialogue: 0,0:04:05.47,0:04:08.51,Main,Fishman,0,0,0,,Prenses Shirahoshi'nin hayatı tehlikede!
Dialogue: 0,0:04:08.51,0:04:12.24,Main,Hody,0,0,0,,Lanet hain, deli Decken.
Dialogue: 0,0:04:12.24,0:04:17.15,Main,Hody,0,0,0,,Ama o herifi hala kullanabilirim.
Dialogue: 0,0:04:18.20,0:04:20.62,Main,Jinbe,0,0,0,,Hody'e dikkat et, Luffy.
Dialogue: 0,0:04:22.03,0:04:26.46,Main,Jinbe,0,0,0,,Suda insanlar ve balık adamların güç farkı çok fazladır.
Dialogue: 0,0:04:27.13,0:04:28.67,Main,Luffy,0,0,0,,Biliyorum!
Dialogue: 0,0:04:28.67,0:04:33.67,Main,Sanji,0,0,0,,Balonu patlatıp onu denize uçurmamalıyım.
Dialogue: 0,0:04:33.67,0:04:38.10,Main,Sanji,0,0,0,,Ayarını tam tutturmam gerekiyor.\NFazla güçlü de olmamalı fazla güçsüz de.
Dialogue: 0,0:04:38.10,0:04:38.97,Main,Luffy,0,0,0,,Sanji!
Dialogue: 0,0:05:04.57,0:05:07.00,Main,Luffy,0,0,0,,Ne kadar da büyük bir zincir.
Dialogue: 0,0:05:07.59,0:05:10.31,Main,Luffy,0,0,0,,Burası iki balonun arası demek.
Dialogue: 0,0:05:13.93,0:05:14.90,Main,Luffy,0,0,0,,Hody!
Dialogue: 0,0:05:14.90,0:05:16.94,Main,Luffy,0,0,0,,Hala ilk balonun altında.
Dialogue: 0,0:05:21.15,0:05:24.12,Main,Fishmen,0,0,0,,Çekin! Çekin!
Dialogue: 0,0:05:24.12,0:05:28.99,Main,Fishman,0,0,0,,Durduramayız ama belki Prenses için azıcık da olsa yavaşlatabiliriz...
Dialogue: 0,0:05:28.99,0:05:31.89,Main,Fishman(offscreen),0,0,0,,Azıcık bile olsa yeter!
Dialogue: 0,0:05:31.89,0:05:33.39,Main,Fishman,0,0,0,,Çekin!
Dialogue: 0,0:05:33.39,0:05:35.56,Main,Fishman2,0,0,0,,Noah'yı durdurun!
Dialogue: 0,0:05:35.56,0:05:40.47,Main,Fishman,0,0,0,,Prenses, fırsat bulmuşken \Ngüvenli bir yere kaçın lütfen!
Dialogue: 0,0:05:43.87,0:05:46.68,Main,Fishman2,0,0,0,,Kahretsin! Dur!
Dialogue: 0,0:05:46.68,0:05:48.64,Main,Luffy,0,0,0,,Millet!
Dialogue: 0,0:05:48.64,0:05:50.18,Main,Shirahoshi,0,0,0,,Millet...
Dialogue: 0,0:05:50.18,0:05:56.41,Main,Hody,0,0,0,,Delirdiniz mi siz?!\NBunu bir milim bile oynatamazsınız!
Dialogue: 0,0:05:56.41,0:05:58.61,Main,Hody,0,0,0,,Boşuna kendiniz yoruyorsunuz.
Dialogue: 0,0:05:59.42,0:06:00.82,Main,Luffy,0,0,0,,Hey! Kes şunu!
Dialogue: 0,0:06:04.53,0:06:06.73,Main,Hody,0,0,0,,Küçük pislikler.
Dialogue: 0,0:06:06.73,0:06:12.84,Main,Hody,0,0,0,,Sizin gibi korkaklar yüzünden insanlar balık adamları küçük görüyor!
Dialogue: 0,0:06:16.17,0:06:17.51,Main,Shirahoshi,0,0,0,,Millet...
Dialogue: 0,0:06:17.51,0:06:19.40,Main,Luffy,0,0,0,,Pislik herif!
Dialogue: 0,0:06:19.40,0:06:23.48,Main,Fishman,0,0,0,,Prenses... kaçın... çabuk...
Dialogue: 0,0:06:23.48,0:06:25.12,Main,Shirahoshi,0,0,0,,Düşündüğüm gibi,
Dialogue: 0,0:06:25.12,0:06:27.98,Main,Shirahoshi,0,0,0,,Ryugu Şatosu'nun girişi açık kalmış!
Dialogue: 0,0:06:27.98,0:06:30.40,Main,Fishman,0,0,0,,Hey, dayan!
Dialogue: 0,0:06:30.40,0:06:32.03,Main,Fishman,0,0,0,,Lanet olsun sana Hody!
Dialogue: 0,0:06:33.98,0:06:35.40,Main,Fishman2,0,0,0,,Prenses Shirahoshi!
Dialogue: 0,0:06:37.00,0:06:39.19,Main,Fishman2,0,0,0,,Bağlantı kanalından denize girdi!
Dialogue: 0,0:06:41.08,0:06:42.92,Main,Fishman2,0,0,0,,Noah da peşinde!
Dialogue: 0,0:06:42.92,0:06:44.95,Main,Fishman,0,0,0,,Prenses! Devam edin!
Dialogue: 0,0:06:50.13,0:06:51.59,Main,Luffy,0,0,0,,Yukarı çıkıyor!
Dialogue: 0,0:07:01.94,0:07:03.62,Main,Luffy,0,0,0,,Bekle, zincir!
Dialogue: 0,0:07:04.24,0:07:06.97,Main,Hody,0,0,0,,Karada kendini bir şey sanıyorsun...
Dialogue: 0,0:07:06.97,0:07:11.91,Main,Hody,0,0,0,,ama denizde, \Nbir çocuk balık adama bile rakip olamazsın!
Dialogue: 0,0:07:12.09,0:07:15.85,Main,Hody,0,0,0,,Bu insanların gücünün sınırı işte.
Dialogue: 0,0:07:15.85,0:07:20.25,Main,Hody,0,0,0,,Bana karşı geldiğine pişman edeceğim seni.
Dialogue: 0,0:07:23.71,0:07:26.73,Main,Decken,0,0,0,,Shirahoshi!
Dialogue: 0,0:07:28.59,0:07:31.14,Main,Decken,0,0,0,,Özgür olmak nasıl?
Dialogue: 0,0:07:31.14,0:07:36.23,Main,Decken,0,0,0,,Seni on yıl boyunca güvende tutan \NKoukaku Kulesi'nin duvarları artık yok.
Dialogue: 0,0:07:36.94,0:07:40.36,Main,Decken,0,0,0,,Kan kaybından mı öleceksin?
Dialogue: 0,0:07:40.36,0:07:45.30,Main,Decken,0,0,0,,Yoksa bu dev Noah tarafından mı ezileceksin?
Dialogue: 0,0:07:45.30,0:07:49.58,Main,Decken,0,0,0,,Sana son bir şans veriyorum, Shirahoshi.
Dialogue: 0,0:07:49.58,0:07:54.51,Main,Decken,0,0,0,,{\i1}Evet{\i0}, dersen eğer hemen canını bağışlarım!
Dialogue: 0,0:07:54.51,0:07:57.63,Main,Shirahoshi,0,0,0,,Decken-sama, gerçekten üzgünüm ama...
Dialogue: 0,0:07:57.63,0:07:59.88,Main,Decken,0,0,0,,Evlen benimle!
Dialogue: 0,0:07:59.88,0:08:01.08,Main,Shirahoshi,0,0,0,,...tipim değilsi{\fscx250}-{\r}
Dialogue: 0,0:08:01.08,0:08:03.27,Main,Decken,0,0,0,,O zaman, öl!
Dialogue: 0,0:08:05.42,0:08:09.39,Main,Manboshi,0,0,0,,Onunla evlenmene izin veririz mi sandın?
Dialogue: 0,0:08:09.39,0:08:15.01,Main,Manboshi,0,0,0,,Tek kız kardeşimize elini sürmene izin vermeyeceğiz, Decken!
Dialogue: 0,0:08:15.01,0:08:19.02,Main,Shirahoshi,0,0,0,,Manboshi Abi! Ryuuboshi Abi! Hoe-sama!{ def: double check for three lines in workraw-sd }
Dialogue: 0,0:08:19.60,0:08:23.30,Main,Decken,0,0,0,,Ne?! Abilerimiz mi?!
Dialogue: 0,0:08:23.30,0:08:24.68,Main,Ryuuboshi+Manboshi,0,0,0,,{\i1}Kim abinmiş?!
Dialogue: 0,0:08:29.11,0:08:35.04,Main,Shirahoshi,0,0,0,,Abilerim, meydandaki herkes çok denedi...
Dialogue: 0,0:08:35.04,0:08:37.41,Main,Manboshi,0,0,0,,Shirahoshi! Daha sonra ağlarsın!
Dialogue: 0,0:08:38.01,0:08:39.97,Main,Shirahoshi,0,0,0,,Abilerim bana kızgın mı?
Dialogue: 0,0:08:41.60,0:08:43.16,Main,Manboshi,0,0,0,,Kızgın değiliz!
Dialogue: 0,0:08:43.16,0:08:48.58,Main,Ryuuboshi,0,0,0,,Babamızın dediğine göre Noah, \Nhiç zarar almaması gereken bir gemi-la-ti-do!
Dialogue: 0,0:08:49.07,0:08:53.84,Main,Ryuuboshi,0,0,0,,Bu da onu hasar görmeden deniz tabanına geri götürmeliyiz demek oluyor!
Dialogue: 0,0:08:54.47,0:08:55.58,Main,Manboshi,0,0,0,,Geliyor!
Dialogue: 0,0:08:57.64,0:09:02.62,Main,Manboshi,0,0,0,,Kahretsin! Sualtı dağlarının ve vadilerinin yakınlarında yüzemeyiz.
Dialogue: 0,0:09:02.62,0:09:04.41,Main,Manboshi,0,0,0,,Noah hasar görür!
Dialogue: 0,0:09:04.41,0:09:07.71,Main,Shirahoshi,0,0,0,,O zaman nereye kaçmalıyım, Manboshi Abi?
Dialogue: 0,0:09:08.65,0:09:12.52,Main,Manboshi,0,0,0,,Yukarıya! Deniz tabanında fazla engel var!
Dialogue: 0,0:09:13.42,0:09:14.62,Main,Shirahoshi,0,0,0,,Anladım!
Dialogue: 0,0:09:15.26,0:09:17.65,Main,Ryuuboshi,0,0,0,,Biz Decken'i indireceğiz.
Dialogue: 0,0:09:25.62,0:09:36.05,Main,Decken,0,0,0,,Noah'dan ve bitmek bilmez aşkımdan\Nkaçmanın hiçbir yolu yok, Shirahoshi!
Dialogue: 0,0:09:43.52,0:09:46.50,Main,Luffy,0,0,0,,Teşekkür ederim! Beni kurtardın!
Dialogue: 0,0:09:46.50,0:09:48.73,Main,Luffy,0,0,0,,Hody'den aldığın yara ne durumda?
Dialogue: 0,0:09:48.73,0:09:52.43,Main,Hody,0,0,0,,Kaçmana izin vermeyeceğim, Hasır Şapka!
Dialogue: 0,0:09:54.60,0:09:59.00,Main,Fukaboshi,0,0,0,,Böyle bir yara için endişelenecek zamanın yok!
Dialogue: 0,0:10:03.74,0:10:07.80,Main,Hody,0,0,0,,Dünyanın en hızlı yüzücüleri olarak kabul edilen deniz adamı ırkından olabilirsin...
Dialogue: 0,0:10:07.80,0:10:10.36,Main,Hody,0,0,0,,ama benim için sanki hiç kımıldamıyor gibisin.
Dialogue: 0,0:10:10.36,0:10:11.29,Main,Luffy,0,0,0,,Pislik herif.
Dialogue: 0,0:10:13.49,0:10:16.03,Attack,Hody,0,0,0,,{\fad(100,100)}Köpekbalığı Kesici
Dialogue: 0,0:10:30.30,0:10:32.49,Main,Luffy,0,0,0,,Hey, beni geminin güvertesine götür!
Dialogue: 0,0:10:33.85,0:10:35.89,Main,Luffy,0,0,0,,Jinbe'nin dediği gibi...
Dialogue: 0,0:10:35.98,0:10:38.66,Flashbacks,Luffy,0,0,0,,Geminin içinde de su var mıdır sence, Jinbe?
Dialogue: 0,0:10:38.66,0:10:43.23,Flashbacks,Jinbe,0,0,0,,Emin değilim ama Decken de bir Şeytan Meyvesi kullanıcısı...
Dialogue: 0,0:10:43.23,0:10:46.44,Flashbacks,Jinbe,0,0,0,,o yüzden gemiyi hareket ettirebildiğine göre bir yerde hava olması lazım.
Dialogue: 0,0:10:46.44,0:10:49.10,Main,Luffy,0,0,0,,Orada dövüşmek daha kolay olur demek ki.
Dialogue: 0,0:10:49.10,0:10:53.55,Main,Luffy,0,0,0,,Hody ve o sürekli bir şeyler fırlatan adamın kıçını tekmelemek istiyorum.
Dialogue: 0,0:10:53.55,0:10:58.03,Main,Luffy,0,0,0,,Onu kuleden çıkardığımda Zayıf-hoshi'ye onu koruyacağıma dair söz vermiştim.
Dialogue: 0,0:10:58.56,0:11:00.71,Main,Fukaboshi,0,0,0,,Bir söz, diyorsun...
Dialogue: 0,0:11:01.25,0:11:05.32,Flashbacks,Fukaboshi,0,0,0,,Babamız gibi büyük askerler olacağız. {21:07.03 in ep 546}
Dialogue: 0,0:11:08.19,0:11:13.05,Flashbacks,Fukaboshi,0,0,0,,{\fad(0,600)}Söz verdiğimiz gibi,\N Shirahoshi'yi canımız pahasına koruyacağız! { end 546 }
Dialogue: 0,0:11:13.17,0:11:15.67,Main,Fukaboshi,0,0,0,,Biz de bir söz verdik.
Dialogue: 0,0:11:15.67,0:11:19.92,Main,Fukaboshi,0,0,0,,Onun gücü, Enerji Steroidleri'nden aldığı gülünç bir taklitten başka bir şey değil.
Dialogue: 0,0:11:19.92,0:11:23.26,Main,Fukaboshi,0,0,0,,O alçağın karşısında duramadığımı düşünmek bile çok acınası.
Dialogue: 0,0:11:23.88,0:11:27.10,Main,Fukaboshi,0,0,0,,Affet bizi, senden şüphe ettiğimiz için.
Dialogue: 0,0:11:27.10,0:11:29.52,Main,Luffy,0,0,0,,Sıkıntı etme. Beni güverteye götür yeter!
Dialogue: 0,0:11:29.52,0:11:31.40,Main,Hody,0,0,0,,Güvertede ne var?
Dialogue: 0,0:11:32.82,0:11:33.69,Main,Fukaboshi,0,0,0,,Hody!
Dialogue: 0,0:11:34.09,0:11:36.10,Main,Shirahoshi,0,0,0,,Yukarı, yukarı...
Dialogue: 0,0:11:43.92,0:11:46.90,Main,Decken,0,0,0,,Ah, Hody Jones.
Dialogue: 0,0:11:48.45,0:11:51.51,Main,Decken,0,0,0,,Neptune nasıl? Onu öldürdün mü?
Dialogue: 0,0:11:52.21,0:11:55.93,Main,Decken,0,0,0,,Tam da Shirahoshi'ye Noah ile acı çektirmenin ortasındayım.
Dialogue: 0,0:11:55.93,0:11:58.48,Main,Decken,0,0,0,,Bu çok iyi bir fikir değil mi sence de?
Dialogue: 0,0:11:58.48,0:12:00.68,Main,Decken,0,0,0,,Değil mi, kardeşim?
Dialogue: 0,0:12:03.48,0:12:06.62,Main,Hody,0,0,0,,Benim de iyi bir fikrim var.
Dialogue: 0,0:12:09.34,0:12:13.28,Main,Decken,0,0,0,,Nedir o? Bana da söyler misin?
Dialogue: 0,0:12:14.58,0:12:16.98,Main,Hody,0,0,0,,Eğer ölürsen...
Dialogue: 0,0:12:33.14,0:12:35.81,Main,Hody,0,0,0,,...bu gemiye ne olur?
Dialogue: 0,0:12:42.78,0:12:45.23,Main,Hody,0,0,0,,Decken.
Dialogue: 0,0:13:05.56,0:13:08.97,Main,Decken,0,0,0,,Hody... Seni velet...
Dialogue: 0,0:13:10.82,0:13:14.66,Main,Decken,0,0,0,,Sol elimle... sana dokundum!
Dialogue: 0,0:13:15.87,0:13:19.20,Main,Decken,0,0,0,,Ne yapmaya çalışıyorsun sen, pislik?!
Dialogue: 0,0:13:20.70,0:13:24.83,Main,Hody,0,0,0,,İlk ihanet eden sendin, Decken.
Dialogue: 0,0:13:24.83,0:13:31.76,Main,Hody,0,0,0,,Doğrusu, bu gemi adanın üstündeki göğü kapattığında bir saniyeliğine panikledim. { def: it really isn't sky... but it really isn't an island either }
Dialogue: 0,0:13:31.76,0:13:36.44,Main,Hody,0,0,0,,Ama adanın balonunu patlatmak iyi fikirdi.
Dialogue: 0,0:13:36.44,0:13:41.24,Main,Hody,0,0,0,,Evet Balık Adam Adası ezilir ama Balık Adam Bölgesi sağ kalır!
Dialogue: 0,0:13:41.24,0:13:47.21,Main,Hody,0,0,0,,Eğer şimdi burada ölürsen,\NMato Mato güçlerin çalışmayı bırakır...
Dialogue: 0,0:13:41.24,0:13:47.21,Note,Hody,0,0,0,,Mato: İz
Dialogue: 0,0:13:47.21,0:13:52.32,Main,Hody,0,0,0,,ve gemi bir kere daha \NBalık Adam Adası'nın tam üstüne düşer.
Dialogue: 0,0:13:55.24,0:13:58.20,Main,Hody,0,0,0,,Her şeyi yok eder.
Dialogue: 0,0:13:58.20,0:14:04.83,Main,Hody,0,0,0,,Şu anda ilk önceliğim o sinir bozucu Hasır Şapka Korsanları'nı yok etmek.
Dialogue: 0,0:14:04.83,0:14:08.25,Main,Hody,0,0,0,,Benim de onlarca, binlerce adamım ölecek ama...
Dialogue: 0,0:14:08.25,0:14:13.63,Main,Hody,0,0,0,,Ne yapalım, daha sonra istediğim kadar insan köle alabilirim.
Dialogue: 0,0:14:18.12,0:14:20.18,Main,Decken,0,0,0,,Herkesin ölmesi mi?
Dialogue: 0,0:14:21.18,0:14:23.41,Main,Decken,0,0,0,,Kulağa güzel geliyor ama...
Dialogue: 0,0:14:23.41,0:14:25.48,Main,Decken,0,0,0,,ilki sen olacaksın!
Dialogue: 0,0:14:25.48,0:14:27.77,Main,Decken,0,0,0,,Geber!
Dialogue: 0,0:14:33.95,0:14:36.24,Main,Decken,0,0,0,,{\i1}Aptal! Dur! { def: calling the axe an idiot doesn't work in english.  the manga has "You can't be serious!" } {Swashy-B: Followed deffy. Changed from "Idiot! Stop right there!"}
Dialogue: 0,0:14:53.63,0:14:57.90,Main,Hody,0,0,0,,Yeni Balık Adam Adası'nın \Nkurulması için bir basamak ol. { def: Now you're nothing but a historical footnote for the new Fishman Island. } {Swashy-B: Changed from, "Become a founding pillar for the new Fishman Island."}
Dialogue: 0,0:15:34.13,0:15:36.72,Main,Hody,0,0,0,,Çok geçmeden öleceksin. { def: btw, the animation for this sequence made the Mato Mato power look stupidly weak.  Hody should have at least been dodging }
Dialogue: 0,0:15:36.72,0:15:42.68,Main,Hody,0,0,0,,Sonra da gemi düşüşüne devam edecek ve Balık Adam Adası'nın tam üstüne çakılacak!
Dialogue: 0,0:15:42.68,0:15:47.56,Main,Hody,0,0,0,,Ben nazik bir adamım. \NHayatın sona ermeden önce,
Dialogue: 0,0:15:47.56,0:15:50.57,Main,Hody,0,0,0,,ömür boyu süren isteğini yerine getireceğim.
Dialogue: 0,0:15:51.29,0:15:53.74,Main,Hody,0,0,0,,Shirahoshi'yi öldüreceğim!
Dialogue: 0,0:15:56.28,0:16:00.61,Main,Manboshi,0,0,0,,Decken'in işini bitirdi!\NOnların arasında neler oluyor?!
Dialogue: 0,0:16:00.61,0:16:04.05,Main,Ryuuboshi,0,0,0,,Bunu düşünecek zaman değil. Hody geliyor!
Dialogue: 0,0:16:05.04,0:16:06.42,Main,Manboshi & Ryuuboshi,0,0,0,,{\i1}Onu durduracağız!
Dialogue: 0,0:16:06.42,0:16:08.54,Main,Hody,0,0,0,,Yoluma çıkıyorsunuz!
Dialogue: 0,0:16:11.06,0:16:13.42,Main,Hody,0,0,0,,Değersiz çöpler!
Dialogue: 0,0:16:17.95,0:16:20.08,Main,Shirahoshi,0,0,0,,{\i1} Abilerim! { def: what's the "mata" here?  can we make it a "no"? }
Dialogue: 0,0:16:21.62,0:16:25.16,Main,Ryuuboshi,0,0,0,,{\i1}Shirahoshi! Kaçabildiğin kadar hızlı kaç!
Dialogue: 0,0:16:25.20,0:16:30.37,Main,Hody,0,0,0,,Artık Koukaku Kulesi'nde olmadığından dolayı işini bitirmek daha kolay olacak!
Dialogue: 0,0:16:34.85,0:16:41.31,Main,Hody,0,0,0,,Dünyada en hızlı kabul edilen deniz kızlarının \Nsu altındaki hızı bile artık bana karşı işe yaramaz! { def: underwater speed } {Swashy-B: Agreed. Gonna make the change from 'famous speed'.}
Dialogue: 0,0:16:49.94,0:16:52.99,Main,Shirahoshi,0,0,0,,{\i1}Abilerim!
Dialogue: 0,0:17:15.91,0:17:18.66,Main,Shirahoshi,0,0,0,,Luffy-sama! Fukaboshi Abi!
Dialogue: 0,0:17:21.23,0:17:22.47,Main,Manboshi,0,0,0,,Hasır Şapka!
Dialogue: 0,0:17:22.47,0:17:23.08,Main,Ryuuboshi,0,0,0,,Abi!
Dialogue: 0,0:17:23.08,0:17:26.67,Main,Fukaboshi,0,0,0,,Üzgünüm! Bazı hazırlıklar yaptığım için geç kaldım!
Dialogue: 0,0:17:26.67,0:17:29.21,Main,Hody,0,0,0,,S-Seni pislik!
Dialogue: 0,0:17:33.09,0:17:36.89,Narrator,Narrator,0,0,0,,Bu sırada, Balık Adam Adası, Gyoncorde Meydanı.
Dialogue: 0,0:17:38.47,0:17:43.60,Main,Wadatsumi,0,0,0,,Kaptan Vander Decken-sama tarafından terk edildim!
Dialogue: 0,0:17:43.73,0:17:49.82,Flashbacks,Decken,0,0,0,,Balık Adam Adası'nın geri kalanı gibi, \NShirahoshi'nin ölümü için feda edileceksin!
Dialogue: 0,0:17:53.74,0:17:56.28,Main,Pirate,0,0,0,,Hey, dövüş artık Umibouzu!
Dialogue: 0,0:17:56.28,0:17:59.20,Main,Pirate,0,0,0,,Sana güveniyoruz!\NKraken hakkında bir şeyler yap!
Dialogue: 0,0:17:59.20,0:18:01.41,Main,Usopp,0,0,0,,Bitir işini, Kraken!
Dialogue: 0,0:18:01.41,0:18:02.74,Main,Chopper,0,0,0,,Kazanabilirsin!
Dialogue: 0,0:18:02.74,0:18:08.27,Main,Citizen,0,0,0,,İkisi de dev gibi\Nama birinin dövüşmeye niyeti yok.
Dialogue: 0,0:18:08.27,0:18:09.75,Main,Citizen,0,0,0,,Kraken, kesin kazanır!
Dialogue: 0,0:18:10.71,0:18:14.40,Main,Zeo,0,0,0,,Hey, Büyük Keşiş! \NOnu yanlış duymuş olmalısın.
Dialogue: 0,0:18:16.90,0:18:19.76,Main,Zeo,0,0,0,,Decken'in sana asıl söylediği şey...
Dialogue: 0,0:18:20.34,0:18:22.68,Main,Zeo,0,0,0,,"Meydanı sana bırakıyorum!"
Dialogue: 0,0:18:24.43,0:18:29.31,Main,Zeo,0,0,0,,Yani adayı yok etme gibi bir planı hiç yoktu.
Dialogue: 0,0:18:29.90,0:18:32.69,Main,Wadatsumi,0,0,0,,Ama... bana feda edileceğimi söyledi.
Dialogue: 0,0:18:33.10,0:18:37.22,Main,Zeo,0,0,0,,Tüm kalbinle dövüşmeni ve gerekirse canını ortaya koymanı kastetti.
Dialogue: 0,0:18:37.22,0:18:39.03,Main,Wadatsumi,0,0,0,,Öyle mi?
Dialogue: 0,0:18:39.03,0:18:40.65,Main,Zeo,0,0,0,,Öyle değil mi?
Dialogue: 0,0:18:40.65,0:18:43.14,Main,Pirate,0,0,0,,Ha? Ah...
Dialogue: 0,0:18:43.14,0:18:44.67,Main,Pirate,0,0,0,,Evet evet!
Dialogue: 0,0:18:44.67,0:18:48.45,Main,Pirate,0,0,0,,Bir kaptanın bu kadar güvendiği bir ast daha yok! {Literally "An underling whom the captain has this much faith in isn't anywhere!"}
Dialogue: 0,0:18:48.45,0:18:50.42,Main,Pirate,0,0,0,,Yaparsın sen! { def: this doesn't seem right } {Swashy-B: I concur. It doesn't make sense in context with the next line. Not sure what to change that to.}
Dialogue: 0,0:18:50.42,0:18:52.12,Main,Pirate,0,0,0,,Adamlığını gösterme vakti!
Dialogue: 0,0:18:52.12,0:18:55.83,Main,Wadatsumi,0,0,0,,Ah, öyle mi?
Dialogue: 0,0:18:57.34,0:18:59.15,Thoughts,Zeo,0,0,0,,Yalan.
Dialogue: 0,0:18:59.80,0:19:02.39,Main,Zeo,0,0,0,,Şimdi, bunu yut...
Dialogue: 0,0:19:02.39,0:19:06.84,Main,Zeo,0,0,0,,ve müttefikimiz olarak, Hasır Şapka Korsanları'nı ez!
Dialogue: 0,0:19:07.51,0:19:09.38,Main,Pirate,0,0,0,,Enerji Steroidi!
Dialogue: 0,0:19:09.38,0:19:12.52,Main,Pirate,0,0,0,,İmkansız... O kadar dev birinin üstünde işe yaramaz.
Dialogue: 0,0:19:15.72,0:19:18.80,Main,Pirate,0,0,0,,{\i1}Çok etkili oldu! { def: It was super effective on him! } {Swashy-B: Changed as per def's suggestion from, "He's one of those people whom drugs work instantly on!"}
Dialogue: 0,0:19:31.06,0:19:33.03,Main,Usopp & Chopper,0,0,0,,{\i1}Surume!
Dialogue: 0,0:19:33.03,0:19:37.49,Main,Wadatsumi,0,0,0,,Kaptan Decken! \NŞüphe ettiğim için özür dilerim! {Swashy-B: Changed "ah" to "I". I just think its overkill.}
Dialogue: 0,0:19:37.49,0:19:40.24,Main,Pirate,0,0,0,,Pekala! Kraken'i devirdi!
Dialogue: 0,0:19:40.24,0:19:42.51,Main,Usopp,0,0,0,,Ne oldu?! Kendine gel!
Dialogue: 0,0:19:42.51,0:19:44.16,Main,Chopper,0,0,0,,Olamaz! Bilinci yerinde değil!
Dialogue: 0,0:19:44.16,0:19:47.62,Main,Wadatsumi,0,0,0,,Siz de düşmansınız değil mi?! {Swashy-B: Keeping consistent, "Yer" instead of "You're".}
Dialogue: 0,0:19:50.88,0:19:53.38,Main,Pirate,0,0,0,,Tamamen farklı birine dönüştü!
Dialogue: 0,0:19:53.38,0:19:58.55,Main,Wadatsumi,0,0,0,,Bunu bana bırakın!
Dialogue: 0,0:20:07.06,0:20:09.59,Main,Wadatsumi,0,0,0,,Düşman nerede?! {Swashy-B: the "Where'th" is a bit overkill in my opinion so I removed it. The "da" is enough.}
Dialogue: 0,0:20:09.59,0:20:12.01,Main,Pirate,0,0,0,,İ-İşte o, Wadatsumi!
Dialogue: 0,0:20:13.34,0:20:14.56,Main,Wadatsumi,0,0,0,,O adam mı?
Dialogue: 0,0:20:15.72,0:20:17.55,Main,Wadatsumi,0,0,0,,Yakaladım!
Dialogue: 0,0:20:18.41,0:20:19.82,Main,Nami,0,0,0,,Jinbe-chan, dikkat et!
Dialogue: 0,0:20:23.16,0:20:27.63,Attack,TL Note,0,0,0,,{\fad(60,60)}Yedi Bin Kiremit: Döner Tekme
Dialogue: 0,0:20:42.46,0:20:45.42,Main,Pirate,0,0,0,,O kadar küçük biri saldırısını nasıl engelleyebilir?!
Dialogue: 0,0:21:07.65,0:21:10.30,Main,Sanji,0,0,0,,Nami-san! Bu nasıl olur?!
Dialogue: 0,0:21:10.30,0:21:12.93,Main,Sanji,0,0,0,,Nami-san'a şok dalgası vurdu!
Dialogue: 0,0:21:14.02,0:21:15.83,Main,Sanji,0,0,0,,Ayağa kalk, pislik!
Dialogue: 0,0:21:16.60,0:21:20.38,Main,Wadatsumi,0,0,0,,Ah! Şimdiki kim?!
Dialogue: 0,0:21:22.23,0:21:27.34,Main,Sanji,0,0,0,,Şişko herif! Güzel rotacımıza bir çizik kadar bile zarar verdiysen... {Swashy-B: "Hey fatty!" or "You big oaf!" "Galoot" just sounds like he's a country bumpkin.}
Dialogue: 0,0:21:27.34,0:21:29.28,Main,Sanji,0,0,0,,sana bedelini ödetirim!
Dialogue: 0,0:21:29.28,0:21:32.83,Main,Pirate,0,0,0,,İmkansız! Onun tekmeleri de işliyor!
Dialogue: 0,0:21:32.83,0:21:34.93,Main,Pirate,0,0,0,,Sualtı dağı kadar büyük bir canavara hem de.
Dialogue: 0,0:21:34.93,0:21:37.20,Main,Pirate,0,0,0,,Ne kadar güçlü bu herif?!
Dialogue: 0,0:21:37.20,0:21:38.87,Main,Nami,0,0,0,,Ah...
Dialogue: 0,0:21:44.00,0:21:45.65,Main,Nami,0,0,0,,Kirlendim... {NO YOU ARE NOT. IN FACT YOU DON'T EVEN HAVE A SPECK OF DUST ON YOU AS FAR AS I CAN SEE. AND WHY THE HELL IS THIS THE BEST ANIMATED PART OF THE EPISODE. GODDAMMIT TOEI WILL YOU STOP TREATING THE FEMALE CHARACTERS LIKE A PAIR OF BREASTS THAT JUST HAPPEN TO HAVE A WOMAN ATTACHED TO THEM ALREADY?!!!!!!!!!!!! ...Yeah, I'm not particularly fond of blatant fanservice-shots, by the way.}
Dialogue: 0,0:21:48.43,0:21:51.45,Main,Wadatsumi,0,0,0,,Bunun için beni suçlama...
Dialogue: 0,0:21:57.26,0:21:59.89,Main,Jinbe,0,0,0,,Rakibin biziz, Büyük Keşiş!
Dialogue: 0,0:21:59.89,0:22:04.36,Main,Sanji,0,0,0,,Hayatınla özür dile, Jumbo Manjuu!
Dialogue: 0,0:21:59.87,0:22:04.38,Note,Sanji,0,0,0,,{\fad(100,100)}Manjuu: Bir Japon şekerlemesi
Dialogue: 0,0:22:05.15,0:22:07.78,Main,Pirate,0,0,0,,{\i1}Bu adamlar da ne?!
Dialogue: 0,0:22:10.16,0:22:11.63,Main,Pirate,0,0,0,,Dur!
Dialogue: 0,0:22:13.87,0:22:16.12,Main,Pirate,0,0,0,,Hyouzou-san! Biz senin tarafı{\fscx250}-{\r}
Dialogue: 0,0:22:19.21,0:22:22.06,Main,Pirate,0,0,0,,Onda bir şeyler garip.
Dialogue: 0,0:22:22.06,0:22:24.02,Main,Pirate,0,0,0,,Her zamanki sarhoş halinden daha kötü! {Swashy-B: Changed from "He's even worse than he usually is drunk!" Just needed to be reworded.}
Dialogue: 0,0:22:24.02,0:22:25.98,Main,Pirate,0,0,0,,Gücü katlanıyor!
Dialogue: 0,0:22:27.31,0:22:29.40,Attack,TL Note,0,0,0,,{\fad(100,100)}Sarhoş Sendeleyen Doğrama
Dialogue: 0,0:22:38.28,0:22:39.79,Main,Pirate,0,0,0,,Çelik kalkanlar bile durduramıyor!
Dialogue: 0,0:22:42.58,0:22:47.46,Main,Pirate,0,0,0,,Daha biraz önce hiç hasar almamasına rağmen acı içinde kıvranmıyor muydu?
Dialogue: 0,0:22:47.46,0:22:51.96,Main,Pirate,0,0,0,,Olamaz... Bu tıpkı Hody-san'ın dönüşümü gibi!
Dialogue: 0,0:22:51.96,0:22:55.81,Main,Pirate,0,0,0,,Hyouzou-san da mı bir canavara dönüştü?!
Dialogue: 0,0:22:56.35,0:23:01.10,Main,Hyouzou,0,0,0,,Çok iyi hissediyorum! Güçle taşıyorum!
Dialogue: 0,0:23:01.10,0:23:04.48,Main,Hyouzou,0,0,0,,Ah, daha fazla kişiyi kesmek istiyorum!
Dialogue: 0,0:23:04.48,0:23:06.69,Main,Hyouzou,0,0,0,,Bırakın sizi keseyim!
Dialogue: 0,0:23:07.40,0:23:10.22,Main,Pirate,0,0,0,,Kaçın! Biri onu durdursun!
Dialogue: 0,0:23:10.22,0:23:12.65,Main,Pirate,0,0,0,,Saldırılarını engellemenin yolu yok!
Dialogue: 0,0:23:14.46,0:23:17.97,Main,Hyouzou,0,0,0,,Herkes olur!
Dialogue: 0,0:23:20.18,0:23:23.34,Main,Hyouzou,0,0,0,,Buldum!
Dialogue: 0,0:23:28.04,0:23:31.42,Main,Pirate,0,0,0,,Hy-Hyouzou-san durduruldu!
Dialogue: 0,0:23:40.72,0:23:41.76,Main,Robin,0,0,0,,Zoro!
Dialogue: 0,0:23:41.76,0:23:44.27,Main,Zoro,0,0,0,,Üzgünüm ama bu adamı ben alacağım!
Dialogue: 0,0:23:45.04,0:23:49.77,Main,Zoro,0,0,0,,Yeni Dünya'ya girmeden önce \Ngüzel bir ısınma olabilir!
Dialogue: 0,0:23:59.11,0:24:02.15,Main,Luffy,0,0,0,,Denizde gücüm gerçekten de düşüyor... { def: i'm not a fan of these next five lines.  i'll recheck them after tlc }
Dialogue: 0,0:24:02.15,0:24:03.94,Main,Hody,0,0,0,,Gücün düştü mü dedin?! {Swashy-B: Changed from "power's"}
Dialogue: 0,0:24:04.68,0:24:06.38,Main,Hody,0,0,0,,Değersiz çöp!
Dialogue: 0,0:24:07.00,0:24:09.90,Main,Hody,0,0,0,,Nerede olduğumuzun farkında mısın?!
Dialogue: 0,0:24:09.90,0:24:14.69,Main,Hody,0,0,0,,Derin denizdeyiz! Sıradan bir insanın en ufak kazanma şansı bile yok!
Dialogue: 0,0:24:14.99,0:24:19.66,Main,Hody,0,0,0,,Ayrıca, her şey yakında bitecek.
Dialogue: 0,0:24:20.08,0:24:24.83,Main,Hody,0,0,0,,Shirahoshi, Balık Adam Adası\Nve yoldaşların...
Dialogue: 0,0:24:24.83,0:24:29.06,Main,Hody,0,0,0,,Senin gibi güçsüz biri onların hiçbirini koruyamaz!
Dialogue: 0,0:24:30.32,0:24:31.21,Main,Luffy,0,0,0,,Hayır.
Dialogue: 0,0:24:52.47,0:24:53.98,Main,Luffy,0,0,0,,Hepsini koruyacağım!
Dialogue: 0,0:24:55.09,0:24:58.73,Main,Luffy,0,0,0,,Son iki yıl bunun içindi!
Dialogue: 0,0:00:25.35,0:00:29.31,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪
Dialogue: 0,0:00:29.31,0:00:33.81,We Go lyrics,,0,0,0,,♪ Şafak vakti gelmedi bile ve ben bekleyemiyorum! ♪
Dialogue: 0,0:00:33.81,0:00:37.48,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı, dört... Gidelim! ♪
Dialogue: 0,0:00:38.97,0:00:43.05,We Go lyrics,,0,0,0,,♪ Bayrağımızı dalgalandıralım, macera şafağının doğuşuna. ♪
Dialogue: 0,0:00:44.41,0:00:49.74,We Go lyrics,,0,0,0,,♪ Dalgalar yapalım, bizi uykumuzdan kaldırsınlar. ♪
Dialogue: 0,0:00:49.74,0:00:54.28,We Go lyrics,,0,0,0,,♪ Eğer inanılmaz bir dünyaya gitmek istiyorsan,
Dialogue: 0,0:00:54.28,0:00:58.79,We Go lyrics,,0,0,0,, gerekli olan şey senin dayanıklılığın. ♪
Dialogue: 0,0:00:59.11,0:01:01.73,We Go lyrics,,0,0,0,,♪ Fazla dikkat çekmek, bu bir suç mu? ♪
Dialogue: 0,0:01:01.73,0:01:04.62,We Go lyrics,,0,0,0,,♪ Aranıyor → Kazanan demektir! ♪
Dialogue: 0,0:01:04.62,0:01:10.50,We Go lyrics,,0,0,0,,♪ Özgür olmak bizim tek kuralımız! ♪
Dialogue: 0,0:01:10.50,0:01:15.99,We Go lyrics,,0,0,0,,♪ Endişelerinizi unutun, bırakın rüzgar essin. ♪
Dialogue: 0,0:01:15.99,0:01:18.53,We Go lyrics,,0,0,0,,♪ Ne pahasına olursa olsun, One Piece'i ilk biz bulacağız! ♪
Dialogue: 0,0:01:18.53,0:01:22.66,We Go lyrics,,0,0,0,,♪ Hayal kuran kalplerimiz, çok büyük... ♪
Dialogue: 0,0:01:22.66,0:01:26.93,We Go lyrics,,0,0,0,,♪ Onları uyandırmamak önemli. ♪
Dialogue: 0,0:01:26.93,0:01:29.57,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪
Dialogue: 0,0:01:29.57,0:01:33.54,We Go lyrics,,0,0,0,,♪ Şafak vakti gelmedi bile ve ben bekleyemiyorum! ♪
Dialogue: 0,0:01:33.54,0:01:37.33,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı, dört... Gidelim! ♪
Dialogue: 0,0:01:38.76,0:01:44.72,We Go lyrics,,0,0,0,,♪ Biz... buralara kadar geldik. ♪
Dialogue: 0,0:01:44.72,0:01:47.62,We Go lyrics,,0,0,0,,♪ Gideceğiz... hayallerimizin olduğu yere,
Dialogue: 0,0:01:47.62,0:01:52.70,We Go lyrics,,0,0,0,, ve kimseyi arkada bırakmayacağız. ♪
Dialogue: 0,0:01:52.70,0:01:55.30,We Go lyrics,,0,0,0,,♪ Hep devam edeceğiz, bu bir söz. ♪
Dialogue: 0,0:01:55.30,0:01:59.47,We Go lyrics,,0,0,0,,♪ Hayallerimizin başladığı o günden beri,
Dialogue: 0,0:01:59.47,0:02:03.72,We Go lyrics,,0,0,0,, belirlediğimiz gelecek, değişmedi! ♪
Dialogue: 0,0:02:03.72,0:02:06.24,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪
Dialogue: 0,0:02:06.24,0:02:10.61,We Go lyrics,,0,0,0,,♪ Kalbimdeki güneş, asla batmayacak! ♪
Dialogue: 0,0:02:10.61,0:02:13.38,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... ♪
Dialogue: 0,0:02:14.78,0:02:17.57,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... ♪
Dialogue: 0,0:02:18.75,0:02:24.82,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... dört... Gidelim! ♪
Dialogue: 0,0:02:27.27,0:02:29.77,We Go lyrics,,0,0,0,,♪ Gidelim! ♪
Dialogue: 0,0:00:02.99,0:00:08.38,Main,,0,0,0,,Dünyanın sunabileceği her şeyi elde eden adam, Korsanlar Kralı Gold Roger.
Dialogue: 0,0:00:08.38,0:00:13.00,Main,,0,0,0,,Son sözleri dünyanın her yerinden\Nmaceracıları denize çekti.
Dialogue: 0,0:00:13.00,0:00:14.68,Main,,0,0,0,,"Hazinem mi?"
Dialogue: 0,0:00:14.68,0:00:16.22,Main,,0,0,0,,"İstiyorsanız, size vereceğim!"
Dialogue: 0,0:00:16.22,0:00:17.42,Main,,0,0,0,,"Arayın ve bulun!"
Dialogue: 0,0:00:17.42,0:00:19.87,Main,,0,0,0,,"Bu dünyanın sunabileceği her şeyi orada bıraktım!"
Dialogue: 0,0:00:19.87,0:00:22.69,Main,,0,0,0,,Korsanlar hayallerinin peşinden yola çıktılar!
