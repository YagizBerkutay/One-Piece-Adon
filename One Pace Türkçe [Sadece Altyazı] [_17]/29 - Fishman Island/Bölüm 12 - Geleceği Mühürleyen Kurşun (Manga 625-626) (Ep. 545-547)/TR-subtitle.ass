per,impress bt,50,&H001D221E,&H000000FF,&H001D221E,&H00000000,0,0,0,0,100,100,0,0,1,0.5,0,2,10,10,10,1Style: We Go lyrics,Duality,40.0,&H0098594E,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2.0,0,8,10,10,16,1Style: Author,Impress BT,20.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.7,0.7,9,10,10,10,1Style: Attack,Duality,32.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.0,1.0,7,12,12,12,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:02.99,0:00:08.38,Main,,0,0,0,,Dünyanın sunabileceği her şeyi elde eden adam, Korsanlar Kralı Gold Roger.Dialogue: 0,0:00:08.38,0:00:13.00,Main,,0,0,0,,Son sözleri dünyanın her yerinden maceracıları denize çekti.Dialogue: 0,0:00:13.00,0:00:14.68,Main,,0,0,0,,"Hazinem mi?"Dialogue: 0,0:00:14.68,0:00:16.22,Main,,0,0,0,,"İstiyorsanız, size vereceğim!"Dialogue: 0,0:00:16.22,0:00:17.42,Main,,0,0,0,,"Arayın ve bulun!"Dialogue: 0,0:00:17.42,0:00:19.87,Main,,0,0,0,,"Bu dünyanın sunabileceği her şeyi orada bıraktım!"Dialogue: 0,0:00:19.87,0:00:22.69,Main,,0,0,0,,Korsanlar hayallerinin peşinden yola çıktılar!Dialogue: 0,0:00:22.69,0:00:25.35,Main,,0,0,0,,Dünya, Büyük Korsan Çağı'na girdi!Dialogue: 0,0:00:25.35,0:00:29.31,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪Dialogue: 0,0:00:29.31,0:00:33.81,We Go lyrics,,0,0,0,,♪ Şafak vakti gelmedi bile ve ben bekleyemiyorum! ♪Dialogue: 0,0:00:33.81,0:00:37.48,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı, dört... Gidelim! ♪Dialogue: 0,0:00:38.97,0:00:43.05,We Go lyrics,,0,0,0,,♪ Bayrağımızı dalgalandıralım, macera şafağının doğuşuna. ♪Dialogue: 0,0:00:44.41,0:00:49.74,We Go lyrics,,0,0,0,,♪ Dalgalar yapalım, bizi uykumuzdan kaldırsınlar. ♪Dialogue: 0,0:00:49.74,0:00:54.28,We Go lyrics,,0,0,0,,♪ Eğer inanılmaz bir dünyaya gitmek istiyorsan,Dialogue: 0,0:00:54.28,0:00:58.79,We Go lyrics,,0,0,0,, gerekli olan şey senin dayanıklılığın. ♪Dialogue: 0,0:00:59.11,0:01:01.73,We Go lyrics,,0,0,0,,♪ Fazla dikkat çekmek, bu bir suç mu? ♪Dialogue: 0,0:01:01.73,0:01:04.62,We Go lyrics,,0,0,0,,♪ Aranıyor → Kazanan demektir! ♪Dialogue: 0,0:01:04.62,0:01:10.50,We Go lyrics,,0,0,0,,♪ Özgür olmak bizim tek kuralımız! ♪Dialogue: 0,0:01:10.50,0:01:15.99,We Go lyrics,,0,0,0,,♪ Endişelerinizi unutun, bırakın rüzgar essin. ♪Dialogue: 0,0:01:15.99,0:01:18.53,We Go lyrics,,0,0,0,,♪ Ne pahasına olursa olsun, One Piece'i ilk biz bulacağız! ♪Dialogue: 0,0:01:18.53,0:01:22.66,We Go lyrics,,0,0,0,,♪ Hayal kuran kalplerimiz, çok büyük... ♪Dialogue: 0,0:01:22.66,0:01:26.93,We Go lyrics,,0,0,0,,♪ Onları uyandırmamak önemli. ♪Dialogue: 0,0:01:26.93,0:01:29.57,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪Dialogue: 0,0:01:29.57,0:01:33.54,We Go lyrics,,0,0,0,,♪ Şafak vakti gelmedi bile ve ben bekleyemiyorum! ♪Dialogue: 0,0:01:33.54,0:01:37.33,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı, dört... Gidelim! ♪Dialogue: 0,0:01:38.76,0:01:44.72,We Go lyrics,,0,0,0,,♪ Biz... buralara kadar geldik. ♪Dialogue: 0,0:01:44.72,0:01:47.62,We Go lyrics,,0,0,0,,♪ Gideceğiz... hayallerimizin olduğu yere,Dialogue: 0,0:01:47.62,0:01:52.70,We Go lyrics,,0,0,0,, ve kimseyi arkada bırakmayacağız. ♪Dialogue: 0,0:01:52.70,0:01:55.30,We Go lyrics,,0,0,0,,♪ Hep devam edeceğiz, bu bir söz. ♪Dialogue: 0,0:01:55.30,0:01:59.47,We Go lyrics,,0,0,0,,♪ Hayallerimizin başladığı o günden beri,Dialogue: 0,0:01:59.47,0:02:03.72,We Go lyrics,,0,0,0,, belirlediğimiz gelecek, değişmedi! ♪Dialogue: 0,0:02:03.72,0:02:06.24,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪Dialogue: 0,0:02:06.24,0:02:10.61,We Go lyrics,,0,0,0,,♪ Kalbimdeki güneş, asla batmayacak! ♪Dialogue: 0,0:02:10.61,0:02:13.38,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... ♪Dialogue: 0,0:02:14.78,0:02:17.57,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... ♪Dialogue: 0,0:02:18.75,0:02:24.82,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... dört... Gidelim! ♪Dialogue: 0,0:02:27.27,0:02:29.54,We Go lyrics,,0,0,0,,♪ Gidelim! ♪Dialogue: 0,0:02:29.69,0:02:31.77,Main,Voice,0,0,0,,Ryugu Sarayı! Ryugu Sarayı!Dialogue: 0,0:02:31.77,0:02:33.63,Main,Voice,0,0,0,,Burası sınır polisi!Dialogue: 0,0:02:33.63,0:02:37.42,Main,Voice,0,0,0,,Devasa bir gemi enkazı acil durum girişi talep ediyor!Dialogue: 0,0:02:35.14,0:02:38.62,Author,,0,0,0,, Türkçeleştirme   onepacetr.net   Çevirmenler   Kazasker - SyLaR_54 thx to onepace.netDialogue: 0,0:18:13.10,0:18:22.10,Author,,0,0,0,, Türkçeleştirme   onepacetr.net   Çevirmenler   Kazasker - SyLaR_54 thx to onepace.netDialogue: 0,0:39:17.20,0:39:21.35,Author,,0,0,0,, Türkçeleştirme   onepacetr.net   Çevirmenler   Kazasker - SyLaR_54 thx to onepace.netDialogue: 0,0:02:35.14,0:02:38.62,Title,Voice,0,0,0,,Geleceği Mühürleyen KurşunDialogue: 0,0:02:38.60,0:02:41.38,Main,Right Minister,0,0,0,,Ne yapıyorsunuz?!  Doğal olarak girmesine izin-Dialogue: 0,0:02:41.38,0:02:42.93,Main,Voice,0,0,0,,Yanılmıyorsam,...Dialogue: 0,0:02:47.14,0:02:49.35,Main,Voice,0,0,0,,...gemide bir Kutsal Ejder var!Dialogue: 0,0:02:49.70,0:02:50.89,Main,Right Minister,0,0,0,,Ne?!Dialogue: 0,0:02:51.56,0:02:53.23,Main,Right Minister,0,0,0,,Kral Neptune!Dialogue: 0,0:02:53.23,0:02:55.19,Main,Neptune,0,0,0,,Kutsal Ejder mi?!Dialogue: 0,0:02:55.19,0:02:56.54,Main,Otohime,0,0,0,,Giriş izni verin!Dialogue: 0,0:02:57.11,0:02:58.90,Main,Otohime,0,0,0,,Kıyıya acil durum ekibi gönderin!Dialogue: 0,0:02:58.92,0:02:59.39,Main,Guards,0,0,0,,Emrederisniz!Dialogue: 0,0:02:59.72,0:03:01.91,Main,Otohime,0,0,0,,Birazdan orada olacağım.Dialogue: 0,0:03:01.91,0:03:02.79,Main,Right Minister,0,0,0,,Otohime-sama!Dialogue: 0,0:03:03.48,0:03:07.25,Main,Neptune,0,0,0,,Bir Kutsal Ejder'in okyanus tabanında ne işi var?Dialogue: 0,0:03:08.92,0:03:10.70,Main,Fishman,0,0,0,,Bir Kutsal Ejder gemisi.Dialogue: 0,0:03:10.70,0:03:13.16,Main,Fishman,0,0,0,,Görünüşe bakılırsa derin deniz yaratığının saldırısına uğramış.Dialogue: 0,0:03:13.16,0:03:19.21,Main,Fishman,0,0,0,,Bizlere ayrımcılık yapan Kutsal Ejderler'in okyanus tabanında ne işi var?Dialogue: 0,0:03:20.41,0:03:22.17,Main,Myosgard,0,0,0,,Acele edin!Dialogue: 0,0:03:24.31,0:03:28.56,Main,Myosgard,0,0,0,,Kahretsin!  O karaktersiz korkakların hepsi öldü!Dialogue: 0,0:03:28.56,0:03:32.06,Main,Myosgard,0,0,0,,Hemen bana bir maske getirin, sizi aşağılık balık yaratıklar!Dialogue: 0,0:03:32.84,0:03:39.78,Captions,,0,0,0,,Dünya Soylusu  (Kutsal Ejder) Aziz MyosgardDialogue: 0,0:03:33.70,0:03:36.42,Main,Myosgard,0,0,0,,Burası balık adam kokuyor!Dialogue: 0,0:03:39.62,0:03:41.94,Main,Myosgard,0,0,0,,Bana hemen maske getirin!Dialogue: 0,0:03:41.95,0:03:45.67,Main,Myosgard,0,0,0,,Hayatımı kurtarın, embesiller!Dialogue: 0,0:03:46.20,0:03:48.62,Main,Fishman,0,0,0,,Ne kadar bencil.Dialogue: 0,0:03:48.62,0:03:50.95,Main,Fishman,0,0,0,,Yardım isteyen birinin böyle mi davranması gerekir?Dialogue: 0,0:03:53.91,0:03:55.28,Main,Myosgard,0,0,0,,Doktor!Dialogue: 0,0:03:57.00,0:03:57.96,Main,Myosgard,0,0,0,,Bana doktor bulun!Dialogue: 0,0:03:58.54,0:03:59.45,Main,Guard,0,0,0,,Sağlıkçılar nerede?Dialogue: 0,0:03:59.45,0:04:01.16,Main,Guard,0,0,0,,Geldiler ama...Dialogue: 0,0:04:01.16,0:04:03.21,Main,Guard,0,0,0,,...ona ne yapacakları konusunda emin değiller.Dialogue: 0,0:04:03.21,0:04:05.03,Main,Hody,0,0,0,,Onu öldürmeliyiz.Dialogue: 0,0:04:06.72,0:04:10.17,Main,Hody,0,0,0,,Dünyadaki en pislik insan türü.Dialogue: 0,0:04:14.51,0:04:16.52,Main,Vander Decken,0,0,0,,Limandan çok gürültü geliyor.Dialogue: 0,0:04:16.87,0:04:17.49,Main,Fishman,0,0,0,,Hey.Dialogue: 0,0:04:20.33,0:04:23.98,Main,Fishman,0,0,0,,Kaptan, sanırım buraya bir Kutsal Ejder gelmiş.Dialogue: 0,0:04:23.98,0:04:26.16,Main,Vander Decken,0,0,0,,Kutsal Ejder mi?Dialogue: 0,0:04:26.16,0:04:29.96,Main,Fishman,0,0,0,,Enkaza dönmüş bir gemiyle gelmiş ve şimdi de yardım istiyormuş.Dialogue: 0,0:04:30.76,0:04:32.64,Main,Vander Decken,0,0,0,,İlginç.Dialogue: 0,0:04:32.64,0:04:34.54,Main,Vander Decken,0,0,0,,Gidip bakalım.Dialogue: 0,0:04:39.84,0:04:42.49,Main,Myosgard,0,0,0,,Bunun olmaması gerekiyordu.Dialogue: 0,0:04:44.07,0:04:47.72,Flashbacks,Myosgard,0,0,0,,Ne? Balık adam kölelerim Balık Adam Adası'na mı dönmüş?Dialogue: 0,0:04:47.72,0:04:49.97,Flashbacks,Myosgard,0,0,0,,Bu neden oldu, babacığım?Dialogue: 0,0:04:50.57,0:04:52.93,Flashbacks,His Daddy,0,0,0,,Duyduğum kadarıyla oğlum,...Dialogue: 0,0:04:52.93,0:04:58.15,Flashbacks,His Daddy,0,0,0,,...Shichibukai olan son kişi  Jinbe adında bir balık adammış.Dialogue: 0,0:04:58.69,0:04:59.82,Flashbacks,Myosgard,0,0,0,,Jinbe?Dialogue: 0,0:04:59.82,0:05:05.16,Flashbacks,His Daddy,0,0,0,,Kaçarak onun da içinde bulunduğu Güneş Korsanları'na katılan köleler...Dialogue: 0,0:05:05.16,0:05:08.89,Flashbacks,His Daddy,0,0,0,,...Hükümet tarafından affedilmiş, kaçma suçları bağışlanmış...Dialogue: 0,0:05:08.89,0:05:12.16,Flashbacks,His Daddy,0,0,0,,...ve ülkelerine dönmüşler, oğlum.Dialogue: 0,0:05:12.16,0:05:17.88,Flashbacks,Myosgard,0,0,0,,Evimden kaçan kölelerin de onların içinde olduğuna eminim, babacığım!Dialogue: 0,0:05:17.88,0:05:20.62,Flashbacks,His Daddy,0,0,0,,Öyle olmalılar.Dialogue: 0,0:05:20.62,0:05:25.76,Flashbacks,His Daddy,0,0,0,,Şu anda ne kadar dertsiz bir hayat sürdüklerini düşündükçe sinirleniyorum.Dialogue: 0,0:05:25.76,0:05:29.64,Flashbacks,Myosgard,0,0,0,,O zaman gidip onları geri alacağım, babacığım!Dialogue: 0,0:05:29.64,0:05:34.14,Flashbacks,Myosgard,0,0,0,,Toplamak için çok para harcadığım balık adam köle koleksiyonumu.Dialogue: 0,0:05:36.42,0:05:39.23,Main,Myosgard,0,0,0,,Kahretsin! Derin denizin...Dialogue: 0,0:05:39.43,0:05:42.54,Main,Myosgard,0,0,0,,...bu kadar korkunç olduğunu bilmiyordum.Dialogue: 0,0:05:42.74,0:05:45.43,Main,Fishman,0,0,0,,Hey! Ne yapıyorsunuz?!Dialogue: 0,0:05:57.02,0:05:59.47,Main,Fishman,0,0,0,,Uzun zaman oldu, Myosgard.Dialogue: 0,0:05:59.47,0:06:02.89,Main,Myosgard,0,0,0,,Bana saygınlık unvanı olmadan hitap ediyorsun, ha?Dialogue: 0,0:06:05.68,0:06:10.34,Main,Myosgard,0,0,0,,Ah, siz benim kölelerimsiniz.Dialogue: 0,0:06:11.37,0:06:13.94,Main,Myosgard,0,0,0,,Uysalca evime dönün!Dialogue: 0,0:06:13.94,0:06:16.44,Main,Myosgard,0,0,0,,Siz kim özgür olma izni verdi, lanet olası balık yaratıklar?!Dialogue: 0,0:06:23.74,0:06:25.71,Main,Fishman,0,0,0,,K-Kesin şunu!Dialogue: 0,0:06:25.71,0:06:29.66,Main,Fishman,0,0,0,,O bir Kutsal Ejder!  Ona el sürerseniz, aflarınız geçersiz olacak!Dialogue: 0,0:06:30.21,0:06:33.17,Main,Myosgard,0,0,0,,Dur, ahmak! Haddini bil!Dialogue: 0,0:06:33.17,0:06:36.05,Main,Myosgard,0,0,0,,Kim olduğumu biliyor musun sen?!Dialogue: 0,0:06:36.05,0:06:38.47,Main,Myosgard,0,0,0,,Ben... Ben...Dialogue: 0,0:06:38.47,0:06:44.36,Main,Fishman,0,0,0,,Yüzeyde, Kutsal Ejderler'den birinin zarar görmesi durumunda hemen bir Denizci Amirali gönderilir.Dialogue: 0,0:06:44.36,0:06:47.27,Main,Fishman,0,0,0,,Herkesin sizden korkmasının tek nedeni bu.Dialogue: 0,0:06:48.10,0:06:51.38,Main,Fishman,0,0,0,,Ancak, burası denizin dibindeki Balık Adam Adası.Dialogue: 0,0:06:51.38,0:06:55.91,Main,Fishman,0,0,0,,Buranın insanları sesini çıkarmadığı sürece,  sana ne olduğunun önemi yok.Dialogue: 0,0:06:55.91,0:06:57.44,Main,Fishman,0,0,0,,Sadece kaza geçirdiğin varsayılacak.Dialogue: 0,0:06:58.57,0:07:00.42,Main,Fishman,0,0,0,,Doğru.Dialogue: 0,0:07:01.18,0:07:02.72,Main,Fishman,0,0,0,,Hiçbir şey demeyeceğim!Dialogue: 0,0:07:02.72,0:07:03.92,Main,Fishman,0,0,0,,Tabii ki ben de!Dialogue: 0,0:07:03.92,0:07:08.81,Main,Fishman,0,0,0,,Zaten güçbela hayatta duruyor! Görmezden gelirsek ölecektir!Dialogue: 0,0:07:08.81,0:07:12.42,Main,Fishman,0,0,0,,Bırakın sizin köleyken katlandığınız acıyı tatsın!Dialogue: 0,0:07:12.42,0:07:13.53,Main,Fishman,0,0,0,,Öldürün onu!Dialogue: 0,0:07:13.53,0:07:14.93,Main,Fishman,0,0,0,,Acı çeksin ve ölsün!Dialogue: 0,0:07:14.93,0:07:16.27,Main,Fishman,0,0,0,,Onu affetmeyin!Dialogue: 0,0:07:16.86,0:07:20.05,Main,Myosgard,0,0,0,,Ne? Ben büyük...Dialogue: 0,0:07:20.73,0:07:22.22,Main,Fishman,0,0,0,,Affetmek istesem bile,...Dialogue: 0,0:07:30.23,0:07:33.32,Main,Fishman,0,0,0,,...asla affedemeyeceğim tek kişi sensin!Dialogue: 0,0:07:35.42,0:07:36.39,Main,Myosgard,0,0,0,,Hey, durun!Dialogue: 0,0:07:36.87,0:07:38.02,Main,Fishman,0,0,0,,Yapın!Dialogue: 0,0:07:38.02,0:07:38.89,Main,Fishman,0,0,0,,Öldürün onu!Dialogue: 0,0:07:43.89,0:07:45.07,Main,Otohime,0,0,0,,Durun!Dialogue: 0,0:07:45.07,0:07:46.99,Main,Myosgard,0,0,0,,Kahrolası balık yaratıklar!Dialogue: 0,0:08:02.39,0:08:04.75,Main,Fishmen,0,0,0,,Kraliçe Otohime!Dialogue: 0,0:08:08.37,0:08:10.81,Main,Fishman,0,0,0,,Majesteleri vuruldu!Dialogue: 0,0:08:21.36,0:08:22.97,Main,Fishman,0,0,0,,Kraliçe Otohime.Dialogue: 0,0:08:23.42,0:08:27.35,Main,Otohime,0,0,0,,Lütfen herkes silahlarını bıraksın.Dialogue: 0,0:08:29.75,0:08:31.69,Main,Otohime,0,0,0,,Çocuklar seyrediyor!Dialogue: 0,0:08:40.00,0:08:41.07,Main,Jinbe,0,0,0,,Aladdin!Dialogue: 0,0:08:41.73,0:08:44.23,Main,Jinbe,0,0,0,,Kazazede Kutsal Ejder'le ilgili duyduğum şey nedir?Dialogue: 0,0:08:44.23,0:08:46.04,Main,Aladdin,0,0,0,,Ben de yeni geldim.Dialogue: 0,0:08:47.85,0:08:48.75,Main,Fukaboshi,0,0,0,,Patron Jinbe!Dialogue: 0,0:08:50.37,0:08:52.72,Main,Fukaboshi,0,0,0,,Annem kaleden aceleyle çıktı.Dialogue: 0,0:08:52.72,0:08:53.97,Main,Jinbe,0,0,0,,Ne?!Dialogue: 0,0:08:54.59,0:08:57.68,Main,Shirahoshi,0,0,0,,Abi, Kutsal Ejderler kimdir?Dialogue: 0,0:08:57.68,0:09:00.32,Main,Fukaboshi,0,0,0,,İnsanlar, Shirahoshi.Dialogue: 0,0:09:00.32,0:09:01.35,Main,Shirahoshi,0,0,0,,İnsanlar mı?Dialogue: 0,0:09:02.44,0:09:07.57,Main,Fukaboshi,0,0,0,,Dünyadaki tüm insanlar içinde en korkuncu onlardır.Dialogue: 0,0:09:07.57,0:09:11.12,Main,Aladdin,0,0,0,,Birkaç el silah sesi duydum. Acele edelim.Dialogue: 0,0:09:11.12,0:09:11.95,Main,Jinbe,0,0,0,,Tamam.Dialogue: 0,0:09:11.95,0:09:13.59,Main,Fishman,0,0,0,,Otohime-sama...Dialogue: 0,0:09:15.37,0:09:17.31,Main,Otohime,0,0,0,,Beni sadece sıyırdı.Dialogue: 0,0:09:17.31,0:09:18.95,Main,Fishman,0,0,0,,Onu neden korudunuz?!Dialogue: 0,0:09:18.95,0:09:22.54,Main,Fishman,0,0,0,,O adamın geçmişte bize neler yaptığını biliyor musunuz?!Dialogue: 0,0:09:24.46,0:09:29.05,Main,Fishman,0,0,0,,Bize kölelerden kötü davrandı, hatta ineklerden bile kötü!Dialogue: 0,0:09:29.05,0:09:33.66,Main,Otohime,0,0,0,,Kalplerinizin haykırışlarını açıkça duyabiliyorum, çok acı verici.Dialogue: 0,0:09:35.95,0:09:37.30,Main,Fukaboshi,0,0,0,,Anne...Dialogue: 0,0:09:37.31,0:09:38.53,Main,Shirahoshi,0,0,0,,Anne!Dialogue: 0,0:09:44.19,0:09:46.31,Main,Otohime,0,0,0,,Sizin için zor olduğunu biliyorum...Dialogue: 0,0:09:46.31,0:09:50.17,Main,Otohime,0,0,0,,...ama insanlara duyduğunuz öfke ve nefreti...Dialogue: 0,0:09:50.17,0:09:52.57,Main,Otohime,0,0,0,,...çocuklara aktarmayın!Dialogue: 0,0:09:54.54,0:09:58.41,Main,Otohime,0,0,0,,Bundan sonra neyle yüzleşmeleri gerektiğini düşünün!Dialogue: 0,0:10:03.98,0:10:06.19,Flashbacks,Tiger,0,0,0,,Yalvarıyorum!Dialogue: 0,0:10:06.19,0:10:10.17,Flashbacks,Tiger,0,0,0,,Adadaki insanlara hiçbir şeye anlatmayın!Dialogue: 0,0:10:10.17,0:10:15.34,Flashbacks,Tiger,0,0,0,,Ne yaşadığımız trajediyi ne de insanlara duyduğumuz öfkeyi.Dialogue: 0,0:10:16.54,0:10:18.72,Thoughts,Jinbe,0,0,0,,Tai abi.Dialogue: 0,0:10:20.39,0:10:22.29,Main,Shirahoshi,0,0,0,,Anne, dikkat et!Dialogue: 0,0:10:24.54,0:10:25.90,Main,Myosgard,0,0,0,,Kıpırdamayın!Dialogue: 0,0:10:25.90,0:10:27.70,Main,Jinbe,0,0,0,,Olamaz! Majesteleri!Dialogue: 0,0:10:27.78,0:10:32.16,Main,Shirahoshi,0,0,0,,Anne!Dialogue: 0,0:10:32.54,0:10:33.45,Main,Jinbe,0,0,0,,Ne?!Dialogue: 0,0:10:57.24,0:10:59.27,Main,Fishmen,0,0,0,,Deniz Kralları?!Dialogue: 0,0:11:26.54,0:11:29.01,Main,Jinbe,0,0,0,,O da neydi?!Dialogue: 0,0:11:29.59,0:11:31.68,Main,Jinbe,0,0,0,,Tesadüf olamaz.Dialogue: 0,0:11:37.05,0:11:39.75,Thoughts,Otohime,0,0,0,,Shirahoshi. Yoksa sen...Dialogue: 0,0:11:44.96,0:11:46.84,Main,Fishman,0,0,0,,Sorun nedir, Kaptan?Dialogue: 0,0:11:47.47,0:11:51.23,Thoughts,Decken,0,0,0,,Ailemde nesilden nesile geçen bir efsane vardır.Dialogue: 0,0:11:51.23,0:11:59.31,Thoughts,Decken,0,0,0,,Eskiden Deniz Kralları'nı kontrol edebilen kutsal bir güce sahip Deniz Kızı Prensesi yaşarmış.Dialogue: 0,0:11:59.31,0:12:05.58,Thoughts,Decken,0,0,0,,Atam Vander Decken, o efsanenin peşinden okyanus tabanını dolaşmış!Dialogue: 0,0:12:05.58,0:12:10.78,Main,Decken,0,0,0,,Şerefli atam! Sonunda onu buldum!Dialogue: 0,0:12:10.78,0:12:14.14,Main,Fishman,0,0,0,,Shirahoshi, efsanevi Deniz Kızı Prensesi mi?!Dialogue: 0,0:12:14.14,0:12:16.09,Main,Fishman,0,0,0,,Başardın, kaptan!Dialogue: 0,0:12:17.58,0:12:19.66,Main,Decken,0,0,0,,Başkası bunu duyarsa kötü olur!Dialogue: 0,0:12:19.66,0:12:24.88,Main,Decken,0,0,0,,Bu sadece ailemin bildiği gizli bir efsane!Dialogue: 0,0:12:24.88,0:12:26.42,Main,Decken,0,0,0,,Öyle varsayıyorum!Dialogue: 0,0:12:26.42,0:12:29.58,Main,Decken,0,0,0,,İstediğim gibi Deniz Kralları'nı kontrol edebilseydim ve emirlerimi yaptırabilseydim,...Dialogue: 0,0:12:29.58,0:12:32.16,Main,Decken,0,0,0,,...herkes dediğimi yapardı!Dialogue: 0,0:12:32.16,0:12:34.77,Main,Decken,0,0,0,,Her istediğimi alabilirdim!Dialogue: 0,0:12:36.14,0:12:38.64,Main,Fishman,0,0,0,,Peki ne yapacaksınız?Dialogue: 0,0:12:38.64,0:12:40.85,Main,Fishman,0,0,0,,Prenses Shirahoshi'yi kaçıracak mıyız?Dialogue: 0,0:12:41.38,0:12:44.65,Main,Decken,0,0,0,,Önce prensesin kocası olmalıyım!Dialogue: 0,0:12:44.65,0:12:46.89,Main,Fishmanz,0,0,0,,Nee?!!!Dialogue: 0,0:12:46.89,0:12:49.65,Main,Fishmanz,0,0,0,,Ama Prenses Shirahoshi henüz bir çocuk!Dialogue: 0,0:12:49.65,0:12:52.61,Main,Decken,0,0,0,,Aynen öyle ve sorun da burada zaten!Dialogue: 0,0:12:55.91,0:12:56.93,Main,Otohime,0,0,0,,Aladdin.Dialogue: 0,0:12:59.70,0:13:02.21,Main,Aladdin,0,0,0,,Yaralarını tedavi edeceğim.Dialogue: 0,0:13:03.33,0:13:05.19,Main,Aladdin,0,0,0,,En kısa sürede sizinkilere de bakacağım, Otohime-sama.Dialogue: 0,0:13:05.88,0:13:12.22,Main,Jinbe,0,0,0,,Birkaç hafta sonra, Kutsal Ejder'in tedavisinin bitmesinin ve hayatının kurtulmasının ardından,...Dialogue: 0,0:13:12.22,0:13:14.58,Main,Jinbe,0,0,0,,...memleketine gitmek üzereyken...Dialogue: 0,0:13:14.58,0:13:18.89,Main,Jinbe,0,0,0,,...Kraliçe Otohime hayret verici bir girişimde bulundu.Dialogue: 0,0:13:30.48,0:13:32.39,Main,Myosgard,0,0,0,,Sakın unutmayın!Dialogue: 0,0:13:32.39,0:13:37.70,Main,Myosgard,0,0,0,,Benim, Dünya Soylusu'nun burada katlandığı densizliği ve kabalığı.Dialogue: 0,0:13:37.70,0:13:41.47,Main,Myosgard,0,0,0,,Kahrolası balık yaratıklar!  Yemin ederim sizi buna pişman edeceğim!Dialogue: 0,0:13:42.10,0:13:45.27,Main,Guard,0,0,0,,Hayatını kurtarmamıza rağmen neden bize içerliyor?!Dialogue: 0,0:13:45.27,0:13:50.85,Main,Guard,0,0,0,,Ülkemiz ona gemi ve kendisini evine götürecek tayfa verdi.Dialogue: 0,0:13:50.85,0:13:52.53,Main,Guard,0,0,0,,Bizimle nasıl böyle konuşabilir?Dialogue: 0,0:13:52.53,0:13:57.18,Main,Guard,0,0,0,,Gitmesine izin vermemliyiz.  Adayı daha da büyük bir tehlikeye sokacak.Dialogue: 0,0:13:59.69,0:14:00.79,Main,Otohime,0,0,0,,Lütfen durun!Dialogue: 0,0:14:01.75,0:14:03.95,Main,Otohime,0,0,0,,Sanırım henüz bitmemiş bir işimiz var.Dialogue: 0,0:14:04.50,0:14:07.55,Main,Otohime,0,0,0,,O zaman size yüzeye kadar eşlik edeceğim.Dialogue: 0,0:14:08.51,0:14:09.80,Main,Fishman,0,0,0,,Yüzeye mi?!Dialogue: 0,0:14:09.80,0:14:11.68,Main,Fishman,0,0,0,,Bu delilik! Otohime-sama!Dialogue: 0,0:14:12.24,0:14:12.97,Main,Shirahoshi,0,0,0,,Anne!Dialogue: 0,0:14:13.38,0:14:15.53,Main,Neptune,0,0,0,,Dur-jamon, Otohime!Dialogue: 0,0:14:15.53,0:14:17.75,Main,Neptune,0,0,0,,Bu kadar bencilce bir şey yapmana izin vermeyeceğim!Dialogue: 0,0:14:17.75,0:14:21.81,Main,Neptune,0,0,0,,Soylularla işi kesin bir sonuca bağlamak istiyorsan, ben giderim!Dialogue: 0,0:14:22.67,0:14:28.36,Main,Otohime,0,0,0,,Sen kral ve büyük şövalyesin.  İnsanlar tarafından hiç yakalanmadığına eminim.Dialogue: 0,0:14:28.36,0:14:29.78,Main,Neptune,0,0,0,,Bu yüzden ben gitmeliyim!Dialogue: 0,0:14:29.78,0:14:33.24,Main,Otohime,0,0,0,,Hayır. Senin kadar güçlü biri gitseydi,  anlamı olmazdı.Dialogue: 0,0:14:33.99,0:14:39.33,Main,Otohime,0,0,0,,Güçsüz olan kişi oraya sağ salim gidip dönemezse,...Dialogue: 0,0:14:39.33,0:14:43.57,Main,Otohime,0,0,0,,...insanlarımıza yüzeyin güvenli olduğunu kanıtlayamayız.Dialogue: 0,0:14:43.92,0:14:48.42,Main,Otohime,0,0,0,,Bu yüzden hepinizden daha güçsüz olan ben,...Dialogue: 0,0:14:48.42,0:14:50.42,Main,Otohime,0,0,0,,...yüzeye gitmeliyim.Dialogue: 0,0:14:51.51,0:14:52.88,Main,Fukaboshi,0,0,0,,Anne!Dialogue: 0,0:14:52.88,0:14:53.76,Main,Shirahoshi,0,0,0,,Anne!Dialogue: 0,0:14:53.76,0:14:55.40,Main,Fishkid,0,0,0,,Otohime-sama!Dialogue: 0,0:14:55.40,0:14:57.86,Main,Fishkid,0,0,0,,Bir yere mi gidiyorsun, Otohime-sama?Dialogue: 0,0:15:00.46,0:15:01.60,Main,Neptune,0,0,0,,Otohime...Dialogue: 0,0:15:01.60,0:15:02.99,Main,Otohime,0,0,0,,Seçtiğin...Dialogue: 0,0:15:03.53,0:15:07.16,Main,Otohime,0,0,0,,...eşine ve insanlara güven.Dialogue: 0,0:15:12.33,0:15:16.35,Main,Myosgard,0,0,0,,O sadece balık yaratıkların kraliçesi!  Bu ne kibir!Dialogue: 0,0:15:22.29,0:15:24.50,Main,Fukaboshi,0,0,0,,Anne!Dialogue: 0,0:15:24.50,0:15:27.13,Main,Shirahoshi,0,0,0,,Anne!Dialogue: 0,0:15:31.34,0:15:32.87,Main,Aladdin,0,0,0,,Jinbe...Dialogue: 0,0:15:32.87,0:15:36.48,Main,Jinbe,0,0,0,,Kimsenin onu durdurması mümkün değildi.Dialogue: 0,0:15:36.48,0:15:39.89,Main,Jinbe,0,0,0,,Tek yapabileceğimiz ona inanıp beklemek.Dialogue: 0,0:15:39.89,0:15:47.03,Main,Crowd,0,0,0,,Majesteleri! Lütfen güvende olun!Dialogue: 0,0:15:45.12,0:15:47.03,Secondary,Kid,0,0,0,,Otohime-sama!Dialogue: 0,0:15:47.03,0:15:50.50,Main,Shirahoshi,0,0,0,,Anne!Dialogue: 0,0:15:59.51,0:16:04.55,Main,Jinbe,0,0,0,,Ryugu Krallığı, belirsizliğin neden olduğu uykusuz geceler döngüsüne gark oldu.Dialogue: 0,0:16:04.55,0:16:09.72,Main,Jinbe,0,0,0,,Ama kraliçenin güvende olması için dua etmekten başka yapabileceğimiz bir şey yoktu.Dialogue: 0,0:16:12.48,0:16:15.02,Note,,0,0,0,,Japon halk hikayelerinde Pandora'nın Kutusu'na benzeyen bir nesne.Dialogue: 0,0:16:12.48,0:16:15.02,Main,Decken,0,0,0,,O da ne? Tamatebako?Dialogue: 0,0:16:15.02,0:16:19.54,Main,Underling,0,0,0,,Evet, kaptan!  Ryugu Sarayı'nda olduğunu duydum!Dialogue: 0,0:16:19.54,0:16:22.24,Main,Decken,0,0,0,,Yani o kutuyu açan kimse anında büyüyor mu?Dialogue: 0,0:16:22.24,0:16:24.62,Main,Underling,0,0,0,,Evet! Sistem böyle işliyor.Dialogue: 0,0:16:24.62,0:16:29.89,Main,Decken,0,0,0,,Örneğin, bu çocuk gibi ufaklığın biri açmış olsa,...Dialogue: 0,0:16:29.89,0:16:32.79,Main,Decken,0,0,0,,...reşit yaşın üstünde seksi bir kadın mı olur?Dialogue: 0,0:16:32.79,0:16:34.64,Main,Underling,0,0,0,,Muhtemelen öyle olurdu.Dialogue: 0,0:16:34.64,0:16:38.39,Main,Decken,0,0,0,,Evet! Sorunum çözüldü!Dialogue: 0,0:16:38.39,0:16:41.39,Main,Decken,0,0,0,,O zaman Prenses Shirahoshi'yle hemen evlenebilirim.Dialogue: 0,0:16:41.39,0:16:43.17,Main,Decken,0,0,0,,Öyle farzediyorum!Dialogue: 0,0:16:43.17,0:16:46.59,Main,Decken,0,0,0,,Hemen o Tamatebako'yu çalın!Dialogue: 0,0:16:46.59,0:16:52.55,Main,Decken,0,0,0,,Hayır, durun biraz. Ryugu Sarayı'na izinsiz girmek o kadar kolay değil.Dialogue: 0,0:16:52.55,0:16:55.61,Main,Underling,0,0,0,,Ama önce Shirahoshi'yle evlenirseniz,...Dialogue: 0,0:16:55.61,0:16:56.98,Main,Underling,0,0,0,,...istediğiniz gibi girip çıkabilirsiniz.Dialogue: 0,0:16:57.84,0:17:00.02,Main,Decken,0,0,0,,Çok akıllısınız.Dialogue: 0,0:17:00.02,0:17:03.02,Main,Decken,0,0,0,,Shirahoshi çirkin biri değil,...Dialogue: 0,0:17:03.02,0:17:07.20,Main,Decken,0,0,0,,...bu yüzden on ya da yirmi yıl sonra güzel görünümlü bir kadın olmalı.Dialogue: 0,0:17:07.60,0:17:09.55,Main,Underling,0,0,0,,Ama daha da büyük olacak.Dialogue: 0,0:17:09.72,0:17:13.87,Main,Decken,0,0,0,,Bu daha da iyi.  Büyük kadınlara karşı bir şeyim yok!Dialogue: 0,0:17:14.61,0:17:20.46,Main,Decken,0,0,0,,O kız, Deniz Krallarını kontrol edebilen efsanevi Deniz Kızı Prensesi.Dialogue: 0,0:17:20.46,0:17:23.17,Main,Decken,0,0,0,,Onun kocası olacağım...Dialogue: 0,0:17:23.17,0:17:27.93,Main,Decken,0,0,0,,...ve o gücü ele geçirince, Vander Decken ailesinin...Dialogue: 0,0:17:28.28,0:17:33.51,Main,Decken,0,0,0,,...nesillerdir aradığı hayali sonunda gerçekleştireceğim!Dialogue: 0,0:17:34.50,0:17:38.17,Main,Decken,0,0,0,,Tamam, düğün davetiyelerine başlayalım.Dialogue: 0,0:17:38.76,0:17:41.19,Main,Underling,0,0,0,,Önce evlilik teklifi gelir!Dialogue: 0,0:17:41.19,0:17:43.69,Main,Decken,0,0,0,,Ah! Hiç arkadaşım yok!Dialogue: 0,0:17:44.82,0:17:47.53,Main,Jinbe,0,0,0,,Kraliçeden haber almadan günler geçti.Dialogue: 0,0:17:47.53,0:17:50.70,Main,Jinbe,0,0,0,,Belirsizlik büyüdükçe büyüdü.Dialogue: 0,0:17:50.70,0:17:53.04,Main,Fishman,0,0,0,,Ah, onun konuşmalarını bile özledim.Dialogue: 0,0:17:55.91,0:17:58.87,Thoughts,Fishwoman,0,0,0,,Lütfen bir şekilde sağ salim dön.Dialogue: 0,0:17:58.87,0:18:02.66,Main,Kid,0,0,0,,Hey, Patron, Otohime-sama nerede?Dialogue: 0,0:18:02.66,0:18:03.80,Main,Kid,0,0,0,,Ne zaman geri dönüyor?Dialogue: 0,0:18:03.80,0:18:06.30,Main,Jinbe,0,0,0,,Ona güvenin ve bekleyin.Dialogue: 0,0:18:06.30,0:18:11.05,Main,Jinbe,0,0,0,,Sizin geleceğiniz uğruna bu yolculuğa çıktı.Dialogue: 0,0:18:14.43,0:18:17.52,Thoughts,Jinbe,0,0,0,,Majesteleri, lütfen güvende ol.Dialogue: 0,0:18:24.43,0:18:25.86,Main,Shirahoshi,0,0,0,,Anne...Dialogue: 0,0:18:33.08,0:18:38.37,Main,Neptune,0,0,0,,Sorun yok-jamon. Ona inanın ve bekleyin-jamon.Dialogue: 0,0:18:39.63,0:18:44.22,Main,Jinbe,0,0,0,,Yüz gün gibi gelen bir hafta geçti.Dialogue: 0,0:18:47.11,0:18:48.92,Main,Jinbe,0,0,0,,Ve sonra...Dialogue: 0,0:18:59.84,0:19:03.37,Main,Citizens,0,0,0,,Yaşasın! Otohime-sama!Dialogue: 0,0:19:05.84,0:19:07.68,Main,Ministers,0,0,0,,Majesteleri!Dialogue: 0,0:19:09.38,0:19:13.05,Main,Man,0,0,0,,Sırf hayatta olduğunu bilmekle, biz çok...Dialogue: 0,0:19:13.05,0:19:15.14,Main,Fishman,0,0,0,,Evinize hoşgeldiniz!Dialogue: 0,0:19:15.14,0:19:17.32,Main,Fishman,0,0,0,,Majesteleri...Dialogue: 0,0:19:17.91,0:19:20.85,Main,Jinbe,0,0,0,,Onları ikna etmesi birkaç gün sürmüş,...Dialogue: 0,0:19:20.85,0:19:25.28,Main,Jinbe,0,0,0,,...ama Kraliçe Otohime nihayet Kutsal Ejderler'i sakinleştirmiş...Dialogue: 0,0:19:25.28,0:19:28.85,Main,Jinbe,0,0,0,,...ve yanında getirdiği kâğıda...Dialogue: 0,0:19:29.57,0:19:33.91,Main,Jinbe,0,0,0,,...Balık Adam Adası'nın umut ışığı denilebilir.Dialogue: 0,0:19:30.26,0:19:33.96,Captions,,0,0,0,,Gyoncorde MeydanıDialogue: 0,0:19:34.76,0:19:38.30,Main,Otohime,0,0,0,,Herkesin dikkatine!  Söz konusu Krallar Konseyi olduğunda,...Dialogue: 0,0:19:38.30,0:19:43.98,Main,Otohime,0,0,0,,...hatta Dünya Konseyi'nde bile,  Dünya Soyluları'nın politik gücü çok fazla.Dialogue: 0,0:19:43.98,0:19:48.51,Main,Otohime,0,0,0,,Bu bir Dünya Soylusu tarafından yazıldı.  Şöyle yazıyor:...Dialogue: 0,0:19:48.51,0:19:51.68,Main,Otohime,0,0,0,,..."Balık adamlarla insanlar arasındaki barış ve arkadaşlık için,...Dialogue: 0,0:19:52.20,0:19:57.06,Main,Otohime,0,0,0,,...ekli dilekçe teklifini onaylıyorum."Dialogue: 0,0:19:57.06,0:20:01.70,Main,Otohime,0,0,0,,Yani imzalarımızı bu kağıtla birlikte...Dialogue: 0,0:20:01.70,0:20:08.24,Main,Otohime,0,0,0,,...Dünya Konseyi Toplantısı'na sunduğumuzda, gerçek manada gücümüz olacak.Dialogue: 0,0:20:08.24,0:20:11.07,Main,Otohime,0,0,0,,Kesinlikle yüzeye göç edebileceğiz.Dialogue: 0,0:20:11.07,0:20:13.83,Main,Fishman,0,0,0,,Kutsal Ejderler destek mi veriyor?Dialogue: 0,0:20:13.83,0:20:14.70,Main,Fishman,0,0,0,,Politika çok karmaşık.Dialogue: 0,0:20:14.70,0:20:19.59,Main,Otohime,0,0,0,,Tek yapmamız gereken çok sayıda imza toplamak.Dialogue: 0,0:20:19.59,0:20:24.29,Main,Otohime,0,0,0,,Bu yüzden son karar sizindir. Sadece siz karar verirken bekleyebilirim.Dialogue: 0,0:20:24.29,0:20:27.46,Main,Otohime,0,0,0,,İnsanlarla birlikte yaşamaya ne dersiniz?Dialogue: 0,0:20:27.46,0:20:31.05,Main,Otohime,0,0,0,,Lütfen yüzeye göç etme isteğinizi gösterin.Dialogue: 0,0:20:33.75,0:20:36.34,Main,Otohime,0,0,0,,Lütfen! İmzalarınız!Dialogue: 0,0:20:48.05,0:20:54.18,Main,Otohime,0,0,0,,Çocuklar, sadece beni mutlu etmeye çalışmıyor musunuz? Çünkü sonra geri istiyorsunuz.Dialogue: 0,0:20:54.18,0:20:57.68,Main,Kid,0,0,0,,İstemiyoruz!  Annem de imza vereceğini söyledi!Dialogue: 0,0:21:18.96,0:21:22.99,Main,Fishman,0,0,0,,Otohime-sama.  Bu küçük kutu yeterince büyük değil!Dialogue: 0,0:21:22.99,0:21:25.59,Main,Fishman,0,0,0,,Bu ülkede kaç kişi olduğunu sanıyorsunuz?Dialogue: 0,0:21:27.97,0:21:31.40,Main,Minister of the Right,0,0,0,,Tamam, tamam!  Bu kutuyu kullanmaya başlayın lütfen!Dialogue: 0,0:21:31.75,0:21:35.86,Main,Minister of the Right,0,0,0,,Kraliçenin büyük hayalini desteklediğinizi ifade etmek için, imzalarınızı bu kutuya koyun!Dialogue: 0,0:22:01.12,0:22:07.08,Main,Jinbe,0,0,0,,Balık adamlar ve insanlar.  Ayrımcılık tarihinden gözlerimizi kaçırıyoruz.Dialogue: 0,0:22:07.97,0:22:14.51,Main,Jinbe,0,0,0,,Ama bu umudu doğuran ilk cesur adımları atmak, kraliçenin kararıydı.Dialogue: 0,0:22:15.08,0:22:18.40,Main,Jinbe,0,0,0,,Biraz daha imza toplayabilirsek,...Dialogue: 0,0:22:18.40,0:22:22.57,Main,Jinbe,0,0,0,,...Balık Adam Adası'nın geleceğini gerçekten değiştirebiliriz.Dialogue: 0,0:22:23.00,0:22:26.94,Main,Jinbe,0,0,0,,Kraliçenin büyük inancına maruz kalırsa,...Dialogue: 0,0:22:26.94,0:22:30.74,Main,Jinbe,0,0,0,,...Arlong bile kurtarılabilir.Dialogue: 0,0:22:32.50,0:22:37.58,Main,Jinbe,0,0,0,,Keşke Tai abi bunu görebilseydi.Dialogue: 0,0:22:42.61,0:22:49.84,Main,Otohime,0,0,0,,Bu adayı gerçekten değiştirecek cesareti o anda kazandım.Dialogue: 0,0:22:49.84,0:22:50.86,Main,Fukaboshi,0,0,0,,O an?Dialogue: 0,0:22:51.97,0:22:55.43,Main,Otohime,0,0,0,,Evet, Deniz Kralları'nın  Balık Adam Adası'na bakmaya geldiği gün.Dialogue: 0,0:22:56.63,0:22:58.71,Main,Manboshi,0,0,0,,Sanırım o gün herkes şaşırmıştı.Dialogue: 0,0:22:59.67,0:23:02.47,Main,Otohime,0,0,0,,Shirahoshi çağırdığı için geldiler.Dialogue: 0,0:23:02.47,0:23:03.26,Main,Princes,0,0,0,,Ne?!Dialogue: 0,0:23:03.26,0:23:07.92,Main,Otohime,0,0,0,,Tüm balık adamlar,  hislerini balıklara iletme kabiliyetine sahiptir.Dialogue: 0,0:23:07.92,0:23:10.20,Main,Otohime,0,0,0,,Bu yüzden onlarla gerçekten konuşabiliyoruz, değil mi?Dialogue: 0,0:23:11.01,0:23:17.04,Main,Otohime,0,0,0,,Ama o devasa Deniz Kralları'yla her isteyen konuşamaz.Dialogue: 0,0:23:17.73,0:23:24.63,Main,Otohime,0,0,0,,Balinalarla iletişim kurma yeteneğine sahip tek kişi olan babanız Neptune bile bunu yapamaz.Dialogue: 0,0:23:24.63,0:23:28.49,Main,Otohime,0,0,0,,Kraliyet ailesinde nesilden nesile geçen bir efsane vardır.Dialogue: 0,0:23:28.49,0:23:36.09,Main,Otohime,0,0,0,,Birkaç yüzyılda bir, Deniz Kralları'yla iletişim kurma yeteneğine sahip bir deniz kızı doğacak.Dialogue: 0,0:23:36.09,0:23:38.23,Main,Fukaboshi,0,0,0,,O devasa Deniz Kralları'yla mı?Dialogue: 0,0:23:38.23,0:23:39.50,Main,Manboshi,0,0,0,,Shirahoshi'den mi bahsediyorsun?Dialogue: 0,0:23:40.39,0:23:45.26,Main,Otohime,0,0,0,,Evet. Bir gün, onun gücünü doğru bir amaç için kullanmasına yardımcı olacak biri ortaya çıkacak...Dialogue: 0,0:23:45.26,0:23:52.48,Main,Otohime,0,0,0,,...ve bu, dünyaya büyük değişiklik getirecek. Ya da efsane böyle söylüyor.Dialogue: 0,0:23:52.48,0:23:53.77,Main,Manboshi,0,0,0,,Tüm dünyaya mı?Dialogue: 0,0:23:54.18,0:23:59.04,Main,Otohime,0,0,0,,Evet, o büyük değişikliklerin bu adada da olacağına eminim.Dialogue: 0,0:23:59.04,0:24:02.23,Main,Ryuuboshi,0,0,0,,Belki o güç çabalarına yardım edecektir?Dialogue: 0,0:24:02.23,0:24:03.24,Main,Otohime,0,0,0,,Sanırım öyle.Dialogue: 0,0:24:03.24,0:24:09.51,Main,Otohime,0,0,0,,İnsanları kurtarmak istiyorsanız, sevginin gücü binlerce yaşamı kurtarmaya muktedirdir.Dialogue: 0,0:24:09.51,0:24:13.83,Main,Otohime,0,0,0,,Ama kötü niyetli kimse kullansaydı, tüm dünyayı denizin dibine batırabilirdi.Dialogue: 0,0:24:14.32,0:24:17.71,Main,Otohime,0,0,0,,Dünyadaki en korkunç güçlerden biri.Dialogue: 0,0:24:18.39,0:24:22.59,Main,Otohime,0,0,0,,Henüz bu gücü kullandığını fark etmedi...Dialogue: 0,0:24:22.59,0:24:24.47,Main,Otohime,0,0,0,,...ve kontrol edemiyor.Dialogue: 0,0:24:24.88,0:24:29.71,Main,Otohime,0,0,0,,Shirahoshi öncekinden çok daha büyük bir şok yaşarsa,...Dialogue: 0,0:24:29.71,0:24:35.28,Main,Otohime,0,0,0,,...bilmeden Deniz Kralları'nın ortalığı kasıp kavurmasına neden olabilir.Dialogue: 0,0:24:35.78,0:24:39.17,Main,Ryuuboshi,0,0,0,,Bu olursa, Balık Adam Adası harabeye döner!Dialogue: 0,0:24:39.17,0:24:40.37,Main,Ryuuboshi,0,0,0,,Ne yapacağız?!Dialogue: 0,0:24:40.37,0:24:44.82,Main,Shirahoshi,0,0,0,,Şimdi bunu dert etmeyin. Er geç buna bir çözüm bulacağım, her şey yolunda.Dialogue: 0,0:24:44.82,0:24:50.25,Main,Shirahoshi,0,0,0,,Üçünüz şimdilik büyümeye ve  harikulade savaşçılar olmaya odaklanmalısınız.Dialogue: 0,0:24:50.66,0:24:58.63,Main,Shirahoshi,0,0,0,,Lütfen abileri ve savaşçılar olarak,  kız kardeşinizi canınız pahasına koruyun.Dialogue: 0,0:24:58.63,0:24:59.50,Main,Ryuuboshi,0,0,0,,Tamam!Dialogue: 0,0:24:59.50,0:25:00.26,Main,Fukaboshi,0,0,0,,Elbette!Dialogue: 0,0:25:00.97,0:25:02.22,Main,Otohime,0,0,0,,Sağolun.Dialogue: 0,0:25:03.62,0:25:08.28,Main,Jinbe,0,0,0,,Ama sonra habersizce bir olay oldu.Dialogue: 0,0:25:12.81,0:25:15.98,Main,Warrior,0,0,0,,Geri çekilin!  İmzalar alevler içinde kaldı!Dialogue: 0,0:25:15.98,0:25:18.23,Main,Warrior,0,0,0,,İmza kutusu nasıl aniden alev aldı?Dialogue: 0,0:25:18.23,0:25:19.07,Main,Warrior,0,0,0,,Su! Su getirin!Dialogue: 0,0:25:19.07,0:25:20.57,Main,Warrior,0,0,0,,Çabuk, ateşi söndürün!Dialogue: 0,0:25:20.57,0:25:21.86,Main,Jinbe,0,0,0,,Bu nasıl olabilir?!Dialogue: 0,0:25:21.86,0:25:23.99,Main,Minister of the Right,0,0,0,,İmzaları toplamak için katlandığımız onca zahmetten sonra!Dialogue: 0,0:25:43.17,0:25:46.37,Main,Fishman,0,0,0,,Otohime-sama vuruldu!Dialogue: 0,0:25:46.37,0:25:47.54,Main,Aladdin,0,0,0,,Kim yaptı?!Dialogue: 0,0:25:47.54,0:25:51.25,Main,Jinbe,0,0,0,,Keskin nişancı var!  Kraliyet ailesini koruyun!Dialogue: 0,0:25:51.25,0:25:52.30,Main,Fukaboshi,0,0,0,,Anne!Dialogue: 0,0:25:52.30,0:25:53.50,Main,Ryuuboshi & Manboshi,0,0,0,,Anne!Dialogue: 0,0:25:53.50,0:25:56.00,Main,Shirahoshi,0,0,0,,Burrası çok tehlikeli!  Lütfen Ryugu Gondolu'na dönün.Dialogue: 0,0:25:57.00,0:25:59.13,Main,Soldier,0,0,0,,Prensler!Dialogue: 0,0:25:59.13,0:26:02.14,Main,Miniser of the Right,0,0,0,,Majesteleri! Majesteleri!Dialogue: 0,0:26:02.14,0:26:04.41,Main,Fishman,0,0,0,,Otohime-sama!Dialogue: 0,0:26:05.68,0:26:09.92,Main,Decken,0,0,0,,Hey, Prenses. Bu senin için zor olmalı.Dialogue: 0,0:26:10.91,0:26:11.85,Main,Soldier,0,0,0,,Sen de kimsin?!Dialogue: 0,0:26:11.85,0:26:13.19,Main,Decken,0,0,0,,Olmaz!Dialogue: 0,0:26:13.19,0:26:14.86,Main,Soldier,0,0,0,,Prensese yaklaşma!Dialogue: 0,0:26:14.86,0:26:15.93,Main,Soldier,0,0,0,,Kıpırdama!Dialogue: 0,0:26:17.53,0:26:21.66,Main,Ryuuboshi & Manboshi,0,0,0,,Anne! Anne!Dialogue: 0,0:26:21.66,0:26:23.31,Main,Fukaboshi,0,0,0,,Anne!Dialogue: 0,0:26:27.95,0:26:30.08,Main,Fukaboshi,0,0,0,,Kahretsin! Bunu kim yaptı?!Dialogue: 0,0:26:30.08,0:26:32.23,Main,Miniser of the Right,0,0,0,,Sağlıkçılar neden daha gelmedi?!Dialogue: 0,0:26:32.23,0:26:33.91,Main,Fukaboshi,0,0,0,,Anne! Anne!Dialogue: 0,0:26:33.91,0:26:35.34,Main,Manboshi,0,0,0,,Aç gözlerini!Dialogue: 0,0:26:35.34,0:26:39.87,Main,Fukaboshi,0,0,0,,Affedilemez!  Bunun sorumlusunu yok edeceğim!Dialogue: 0,0:26:42.69,0:26:43.64,Main,Fukaboshi,0,0,0,,Anne!Dialogue: 0,0:26:45.42,0:26:52.90,Main,Otohime,0,0,0,,Yanımda kalın küçük meleklerim. Yüzünüzü korkutucu yapmayın.Dialogue: 0,0:26:54.73,0:27:01.54,Main,Otohime,0,0,0,,Dikkatsiz davrandım. İmzalar beni çok mutlu etmişti.Dialogue: 0,0:27:01.54,0:27:03.41,Main,Otohime,0,0,0,,Hem de çok mutlu!Dialogue: 0,0:27:04.40,0:27:08.23,Main,Otohime,0,0,0,,Prens Fukaboshi, asıl öfkeli olan benim.Dialogue: 0,0:27:08.23,0:27:10.16,Main,Medic,0,0,0,,Majesteleri! Sizi tedavi etmeye hazırız!Dialogue: 0,0:27:13.37,0:27:18.25,Main,Otohime,0,0,0,,Bu yüzden suçlu kim olursa olsun,...Dialogue: 0,0:27:18.84,0:27:22.81,Main,Otohime,0,0,0,,...lütfen benim adıma öfkelenmeyin.Dialogue: 0,0:27:24.82,0:27:31.59,Main,Otohime,0,0,0,,Benim yüzümden öfke ve nefrete yenilmeyin.Dialogue: 0,0:27:44.54,0:27:46.41,Main,Shirahoshi,0,0,0,,Anne!Dialogue: 0,0:27:49.95,0:27:53.63,Main,Otohime,0,0,0,,Shirahoshi. Kendini kontrol et.Dialogue: 0,0:28:03.06,0:28:08.09,Flashbacks,Otohime,0,0,0,,Shirahoshi öncekinden daha büyük bir şok yaşarsa,...Dialogue: 0,0:28:11.84,0:28:12.71,Main,Jinbe,0,0,0,,Bu...Dialogue: 0,0:28:18.30,0:28:19.95,Main,Otohime,0,0,0,,Shirahoshi, hayır.Dialogue: 0,0:28:21.96,0:28:24.29,Main,Manboshi,0,0,0,,Hey! Shirahoshi!Dialogue: 0,0:28:33.31,0:28:39.25,Main,Manboshi,0,0,0,,Akkamanbo akamanbo!  Akkamanbo akamanbo!Dialogue: 0,0:28:39.25,0:28:41.77,Main,Manboshi,0,0,0,,Bak! Shirahoshi!Dialogue: 0,0:28:41.77,0:28:43.71,Main,Manboshi,0,0,0,,Akkamanbo akamanbo!Dialogue: 0,0:28:44.10,0:28:46.64,Main,Ryuuboshi,0,0,0,,Eğlenceli! Eğlenceli!Dialogue: 0,0:28:46.64,0:28:50.01,Main,Ryuuboshi,0,0,0,,Ağlanacak bir şey yok! Şarkı söyleyelim, Shirahoshi!Dialogue: 0,0:28:50.65,0:28:55.28,Main,Ryuuboshi,0,0,0,,Üçümüz hep yanında olacağız-la ti do!Dialogue: 0,0:28:58.20,0:29:01.53,Main,Manboshi,0,0,0,,Manbo dansı gerçekten çok eğlenceli!Dialogue: 0,0:29:04.11,0:29:05.41,Main,Manboshi,0,0,0,,Çok eğlenceli!Dialogue: 0,0:29:05.41,0:29:08.60,Main,Ryuuboshi,0,0,0,,Evet! Eğlenceli-do re mi fa!Dialogue: 0,0:29:09.11,0:29:11.51,Main,Minister of the Right,0,0,0,,Prensler ne yapıyor?!Dialogue: 0,0:29:11.51,0:29:13.22,Main,Soldier,0,0,0,,Onları durdurun!Dialogue: 0,0:29:13.22,0:29:14.64,Main,Soldier,0,0,0,,Hiç uygun değil!Dialogue: 0,0:29:14.64,0:29:18.34,Main,Manboshi,0,0,0,,Anne! Bak! Bak! Her şey yolunda!Dialogue: 0,0:29:18.80,0:29:24.78,Main,Ryuuboshi,0,0,0,,Onu hep böyle koruyacağız-la ti do!Dialogue: 0,0:29:25.28,0:29:30.02,Main,Soldier,0,0,0,,Lütfen durun!  Majestelerinin durumunu anlamıyor musunuz?Dialogue: 0,0:29:31.66,0:29:37.48,Main,Fukaboshi,0,0,0,,Anne. Yanan imzaları yeniden toplayacağız.Dialogue: 0,0:29:38.15,0:29:42.35,Main,Fukaboshi,0,0,0,,Babamız gibi müthiş askerler olacağız.Dialogue: 0,0:29:45.22,0:29:50.04,Main,Fukaboshi,0,0,0,,Söz verdiğimiz gibi,  Shirahoshi'yi canımız pahasına koruyacağız!Dialogue: 0,0:29:50.04,0:29:52.37,Main,Fukaboshi,0,0,0,,Lütfen...Dialogue: 0,0:29:52.37,0:29:57.63,Main,Fukaboshi,0,0,0,,L-Lütfen endişelenme!Dialogue: 0,0:30:00.33,0:30:06.33,Main,Otohime,0,0,0,,Gerçek güneşin ışığı sadece kıl payı uzakta.Dialogue: 0,0:30:47.68,0:30:50.74,Main,Guard,0,0,0,,Keskin nişancıyı bulduk!Dialogue: 0,0:30:50.74,0:30:53.52,Main,Guard,0,0,0,,Acele edin. Tepeye çıkın!Dialogue: 0,0:30:56.89,0:30:58.19,Main,Guard,0,0,0,,Suçlu o mu?Dialogue: 0,0:31:00.41,0:31:01.83,Main,Jinbe,0,0,0,,Keskin nişancı nerede?Dialogue: 0,0:31:01.83,0:31:03.27,Main,Guard,0,0,0,,Jinbe-san!Dialogue: 0,0:31:03.27,0:31:05.31,Main,Guard,0,0,0,,Biraz önce öldürdük.Dialogue: 0,0:31:05.31,0:31:07.05,Main,Jinbe,0,0,0,,Kimin nesi?Dialogue: 0,0:31:07.05,0:31:08.04,Main,Guard,0,0,0,,Şey...Dialogue: 0,0:31:11.94,0:31:13.01,Main,Jinbe,0,0,0,,O...Dialogue: 0,0:31:15.84,0:31:18.43,Main,Jinbe,0,0,0,,...bir insan.Dialogue: 0,0:31:21.37,0:31:22.60,Main,Jinbe,0,0,0,,Saklayın!Dialogue: 0,0:31:22.79,0:31:24.13,Main,Guard,0,0,0,,Ne? Patron Jinbe?!Dialogue: 0,0:31:27.58,0:31:31.28,Main,Jinbe,0,0,0,,Kraliçe'nin yaşadığı onca zorluk boşa gidecek.Dialogue: 0,0:31:32.07,0:31:37.86,Main,Jinbe,0,0,0,,Bu... Kraliçe'ye çok ağır gelmez mi?!Dialogue: 0,0:31:40.89,0:31:43.60,Main,Hody,0,0,0,,Ne var ki, gerçeklik bu.Dialogue: 0,0:31:43.60,0:31:46.00,Main,Jinbe,0,0,0,,Yanılıyorsun. Bu herif bir korsan!Dialogue: 0,0:31:46.83,0:31:50.54,Main,Hody,0,0,0,,Korsan olup olmaması önemli değil.Dialogue: 0,0:31:51.35,0:31:53.34,Main,Jinbe,0,0,0,,Dur, Hody!Dialogue: 0,0:31:53.34,0:31:54.50,Main,Jinbe,0,0,0,,Dur dedim!Dialogue: 0,0:31:58.43,0:32:00.51,Main,Hody,0,0,0,,Dinleyin ahali!Dialogue: 0,0:32:03.39,0:32:05.19,Main,Hody,0,0,0,,Bir insan...Dialogue: 0,0:32:07.01,0:32:10.74,Main,Hody,0,0,0,,...ülkemizin kraliçesini öldürdü.Dialogue: 0,0:32:11.94,0:32:18.83,Main,Hody,0,0,0,,Kraliçe Otohime'yi bir insan öldürdü!Dialogue: 0,0:32:25.10,0:32:27.65,Main,Right Minister,0,0,0,,Bu korkunç cürümü işleyen kişi...Dialogue: 0,0:32:28.36,0:32:30.72,Main,Left Minister,0,0,0,,...bir insan.Dialogue: 0,0:32:31.23,0:32:36.99,Main,Left Minister,0,0,0,,Birlikte yaşayabilmemiz için Kraliçe o kadar çabaladı.Dialogue: 0,0:32:36.99,0:32:44.21,Main,Left Minister,0,0,0,,Sözleri bizi yumuşattı, bir araya getirdi,  şimdiyse kalplerimiz parçalandı.Dialogue: 0,0:32:45.04,0:32:50.28,Main,Left Minister,0,0,0,,Sevdiğimizi bizden aldılar.Dialogue: 0,0:32:50.28,0:32:54.78,Main,Fishman,0,0,0,,Sen ölsen bile  Otohime-sama geri gelmeyecek, insan!Dialogue: 0,0:32:55.22,0:33:00.32,Main,Left Minister,0,0,0,,Bu dünyada Tanrı ya da Buda yok mu?Dialogue: 0,0:33:00.90,0:33:03.21,Main,Left Minister,0,0,0,,Bu çok zalimce!Dialogue: 0,0:33:03.21,0:33:07.23,Main,Left Minister,0,0,0,,Hem de çok zalimce!Dialogue: 0,0:33:19.11,0:33:21.61,Main,Left Minister,0,0,0,,Kral hâlâ Koukaku Kulesi'nde mi?Dialogue: 0,0:33:22.78,0:33:25.07,Main,Right Minister,0,0,0,,Sol Bakan...Dialogue: 0,0:33:25.07,0:33:27.36,Main,Right Minister,0,0,0,,Duyduğun gibi.Dialogue: 0,0:33:27.36,0:33:30.62,Main,Right Minister,0,0,0,,Onu kimse sakinleştiremez.Dialogue: 0,0:33:30.62,0:33:32.50,Flashbacks,Neptune,0,0,0,,Kapıyı kilitleyin!Dialogue: 0,0:33:32.50,0:33:36.94,Flashbacks,Neptune,0,0,0,,Sinirim geçene kadar kapıyı kesinlikle açmayın.Dialogue: 0,0:33:47.06,0:33:50.82,Main,Left Minister,0,0,0,,Kral'ım, benim.Dialogue: 0,0:33:51.87,0:33:53.64,Main,Neptune,0,0,0,,Sol Bakan...Dialogue: 0,0:33:53.64,0:33:59.98,Main,Left Minister,0,0,0,,Suçlunun silahı olduğundan askerler onu vurdu.Dialogue: 0,0:34:00.69,0:34:02.54,Main,Left Minister,0,0,0,,Bir insandı!Dialogue: 0,0:34:03.60,0:34:07.56,Main,Neptune,0,0,0,,Silahsız olsa bile onu öldürürdüm.Dialogue: 0,0:34:10.17,0:34:14.66,Main,Neptune,0,0,0,,Ama, Otohime bunu affetmezdi.Dialogue: 0,0:34:15.10,0:34:19.42,Main,Neptune,0,0,0,,Bu intikam döngüsü ne zaman başladı?Dialogue: 0,0:34:19.42,0:34:23.37,Main,Neptune,0,0,0,,Daha fazla cinayet bu döngüyü sadece devam ettirir.Dialogue: 0,0:34:23.37,0:34:27.13,Main,Neptune,0,0,0,,Sonra, bir çocuk böyle şeylerle büyürse daha kötü olaylar olur.Dialogue: 0,0:34:27.13,0:34:30.75,Main,Neptune,0,0,0,,Kalplerinde nefret yeşerir.Dialogue: 0,0:34:30.75,0:34:34.85,Main,Neptune,0,0,0,,Böylece, intikam zinciri daha da güçlenir.Dialogue: 0,0:34:36.18,0:34:40.34,Main,Neptune,0,0,0,,Otohime'nin sözlerini anlamıştım.Dialogue: 0,0:34:40.34,0:34:42.89,Main,Neptune,0,0,0,,Başkasının sorunları olarak tabii.Dialogue: 0,0:34:43.58,0:34:51.46,Main,Neptune,0,0,0,,Ama karımı öldürene  nasıl olur da elimi süremem?!Dialogue: 0,0:34:52.26,0:34:56.18,Main,Neptune,0,0,0,,Anlamıyorum-jamon.Dialogue: 0,0:34:58.28,0:35:03.83,Main,Neptune,0,0,0,,Şimdiye dek, bir asker olarak birçok kez arkadaşlarımın intikamını aldım.Dialogue: 0,0:35:04.64,0:35:09.38,Main,Neptune,0,0,0,,İnsanlar bize karşı saldırganken canlarını aldım.Dialogue: 0,0:35:09.38,0:35:14.72,Main,Neptune,0,0,0,,Bu yüzden,  Otohime'ye bu çabasında yardımcı olamadım.Dialogue: 0,0:35:14.72,0:35:17.30,Main,Neptune,0,0,0,,Onu öylece izledim.Dialogue: 0,0:35:17.30,0:35:22.69,Main,Neptune,0,0,0,,Masum birisi ölürken ben nasıl hayatta kalırım?!Dialogue: 0,0:35:22.69,0:35:30.34,Main,Neptune,0,0,0,,Otohime'nin bu çabasını devam ettirebileceğimi sanmıyorum. Geçmişim çelişkilerle dolu-jamon.Dialogue: 0,0:35:31.27,0:35:37.58,Main,Left Minister,0,0,0,,Ancak, kalp değişken bir şeydir. Hepimiz çelişkilerle doluyuz.Dialogue: 0,0:35:37.58,0:35:40.10,Main,Left Minister,0,0,0,,Balık Adamlar da  insanlar da...Dialogue: 0,0:35:40.10,0:35:44.60,Main,Left Minister,0,0,0,,Sadece bir askerin koruyabileceği şeyler vardır.Dialogue: 0,0:35:48.40,0:35:51.18,Captions,,0,0,0,,Birkaç gün sonraDialogue: 0,0:35:53.91,0:35:55.55,Main,Guards,0,0,0,,Kral'ım!Dialogue: 0,0:36:00.53,0:36:02.68,Main,Neptune,0,0,0,,Size yük oldum.Dialogue: 0,0:36:02.68,0:36:07.69,Main,Neptune,0,0,0,,Eşimin cenazesine katılmamazlık edemem-jamon.Dialogue: 0,0:36:08.86,0:36:12.14,Main,Shirahoshi,0,0,0,,Baba! Baba!Dialogue: 0,0:36:12.14,0:36:13.66,Main,Neptune,0,0,0,,Shirahoshi...Dialogue: 0,0:36:21.70,0:36:23.34,Main,Fukaboshi,0,0,0,,Baba.Dialogue: 0,0:36:23.34,0:36:25.05,Main,Neptune,0,0,0,,Çocuklar...Dialogue: 0,0:36:26.41,0:36:27.92,Main,Fukaboshi,0,0,0,,İyisiniz...Dialogue: 0,0:36:31.58,0:36:36.15,Main,Neptune,0,0,0,,Sizi endişelendirdiğim için özür dilerim.Dialogue: 0,0:36:39.10,0:36:41.42,Main,Shirahoshi,0,0,0,,Baba, buyur.Dialogue: 0,0:36:42.13,0:36:43.68,Main,Neptune,0,0,0,,Bu nedir?Dialogue: 0,0:36:43.68,0:36:47.53,Main,Shirahoshi,0,0,0,,Nereye gidersem gideyim bu mektuplar uçarak geliyor.Dialogue: 0,0:36:47.53,0:36:50.70,Main,Fukaboshi,0,0,0,,Şimdiden beş tane oldu, baba.Dialogue: 0,0:36:50.70,0:36:54.10,Main,Neptune,0,0,0,,Bu aşk mektubu mu?!Dialogue: 0,0:36:52.52,0:36:59.52,Note,,0,0,0,,Sana âşığım... Öyle farzediyorum! Benimle evlen. - Vander Decken.Dialogue: 0,0:36:54.10,0:36:56.31,Main,Neptune,0,0,0,,Shirahoshi daha 6 yaşında!Dialogue: 0,0:36:56.85,0:36:59.58,Main,Neptune,0,0,0,,Vander Decken kimin nesidir?Dialogue: 0,0:36:59.58,0:37:02.52,Main,Guard,0,0,0,,Nesillerdir korsanlık yapan bir aileden.Dialogue: 0,0:37:05.02,0:37:07.55,Main,Neptune,0,0,0,,Çocukları cenazeye götürmeyin.Dialogue: 0,0:37:08.55,0:37:11.70,Main,Neptune,0,0,0,,Suikastçinin müttefikleri halen orada olabilir.Dialogue: 0,0:37:11.70,0:37:15.80,Main,Neptune,0,0,0,,Ayrıca, bu Decken denen korsanı hemen yakalayın.Dialogue: 0,0:37:15.80,0:37:16.88,Main,Guards,0,0,0,,Emredersiniz!Dialogue: 0,0:37:56.14,0:37:57.68,Main,Fukaboshi,0,0,0,,Arkadaşlar...Dialogue: 0,0:37:58.17,0:37:59.51,Main,Fishman,0,0,0,,Monitör...Dialogue: 0,0:38:02.35,0:38:04.45,Main,Fishman,0,0,0,,Prens Fukaboshi?Dialogue: 0,0:38:04.67,0:38:06.15,Main,Neptune,0,0,0,,Fukaboshi...Dialogue: 0,0:38:06.28,0:38:11.37,Main,Fukaboshi,0,0,0,,Annem ölmek üzere iken bize bir şeyler söyledi.Dialogue: 0,0:38:12.11,0:38:16.04,Main,Fukaboshi,0,0,0,,Az bir çabayla gerçek güneşin altında yaşayabiliriz.Dialogue: 0,0:38:17.72,0:38:24.02,Main,Fukaboshi,0,0,0,,Annemin son arzusu, onun kaldığı yerden devam etmemiz ve başarıya ulaşmamız oldu.Dialogue: 0,0:38:24.69,0:38:26.58,Main,Right Minister,0,0,0,,Prenslerim...Dialogue: 0,0:38:26.58,0:38:33.25,Main,Fukaboshi,0,0,0,,Kalbiniz iki yıl sonraki  Dünya Konseyi Toplantısı'na hazır olmayabilir ama...Dialogue: 0,0:38:33.81,0:38:38.09,Main,Fukaboshi,0,0,0,,...altı yıl sonra yine olacak. 10 yıl sonra yine olacak.Dialogue: 0,0:38:38.82,0:38:44.86,Main,Fukaboshi,0,0,0,,Bu olayda, insanların hareketleri fikirlerinizi değiştirmiş olabilir.Dialogue: 0,0:38:45.60,0:38:49.54,Main,Fukaboshi,0,0,0,,Kalan imzalar yakılacak ve her şey yok olacak.Dialogue: 0,0:38:51.69,0:38:54.94,Main,Fukaboshi,0,0,0,,En baştan bir daha başlayalım.Dialogue: 0,0:38:56.31,0:39:04.43,Main,Fukaboshi,0,0,0,,Kalbimizdeki yaraları bir gün iyileştirelim.Dialogue: 0,0:39:06.14,0:39:11.13,Main,Fukaboshi,0,0,0,,Birlikte, güneşin hayalini kuralım.