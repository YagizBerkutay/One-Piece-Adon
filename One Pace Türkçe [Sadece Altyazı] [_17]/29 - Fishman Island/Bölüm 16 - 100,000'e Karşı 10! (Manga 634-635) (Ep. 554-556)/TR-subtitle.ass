Dialogue: 0,0:02:29.88,0:02:31.31,Captions,,0,0,0,,Bir Kaç Saat Önce - Deniz Ormanı
Dialogue: 0,0:02:31.33,0:02:32.29,Main,Luffy,0,0,0,,Çekil!
Dialogue: 0,0:02:32.29,0:02:34.79,Main,Jinbe,0,0,0,,Hayır! Kesinlikle izin vermeyeceğim!
Dialogue: 0,0:02:34.79,0:02:37.71,Main,Caimie,0,0,0,,Luffy-chin... Patron Jinbe...
Dialogue: 0,0:02:37.71,0:02:40.26,Main,Sanji,0,0,0,,Hadi ama daha ne kadar bekleyeceğiz?
Dialogue: 0,0:02:40.26,0:02:43.85,Main,Shirahoshi,0,0,0,,Ah, kusura bakmayın ama babamın hayatı...
Dialogue: 0,0:02:43.85,0:02:46.00,Main,Luffy,0,0,0,,Çekil dedim o yüzden çekil!
Dialogue: 0,0:02:46.00,0:02:49.10,Main,Luffy,0,0,0,,Onların kıçını tekmelemeye gideceğim!
Dialogue: 0,0:02:49.10,0:02:52.71,Main,Jinbe,0,0,0,,Daha kaç kere söyleyeceğim sana bekle diye?!
Dialogue: 0,0:02:52.71,0:02:54.19,Main,Jinbe,0,0,0,,Söyleyeceklerimi sonuna kadar dinle!
Dialogue: 0,0:02:54.19,0:02:57.48,Main,Jinbe,0,0,0,,Sen ve benim aramdaki ilişki ne?
Dialogue: 0,0:02:57.48,0:02:58.36,Main,Luffy,0,0,0,,Arkadaşız.
Dialogue: 0,0:02:58.36,0:03:00.19,Main,Jinbe,0,0,0,,Aynen öyle.
Dialogue: 0,0:03:00.19,0:03:06.51,Main,Jinbe,0,0,0,,Yıllar boyunca, balık adam ve insanların bizimki gibi basit bir ilişki kurması zorlu oldu.
Dialogue: 0,0:03:07.12,0:03:09.90,Main,Jinbe,0,0,0,,Sana Hody ile dövüşme dememin sebebi...
Dialogue: 0,0:03:09.90,0:03:14.44,Main,Jinbe,0,0,0,,sorumsuzca bir dövüş çıkarmanı istememem.\NAceleci davranma!
Dialogue: 0,0:03:14.44,0:03:23.64,Main,Jinbe,0,0,0,,Eğer Hody'i öylece döversen, bu adanın sakinleri seni sadece başka bir kalpsiz insan olarak görecek.
Dialogue: 0,0:03:23.64,0:03:25.39,Main,Jinbe,0,0,0,,Bunun yerine,
Dialogue: 0,0:03:25.39,0:03:29.52,Main,Jinbe,0,0,0,,lütfen Balık Adam Adası'nı kurtaran kahraman ol!
Dialogue: 0,0:03:30.33,0:03:31.70,Main,Luffy,0,0,0,,Kahraman mı?
Dialogue: 0,0:03:31.70,0:03:32.58,Main,Luffy,0,0,0,,İstemiyorum!
Dialogue: 0,0:03:32.58,0:03:33.54,Main,Jinbe,0,0,0,,{\i1}Neee?!
Dialogue: 0,0:03:33.75,0:03:35.40,Main,Luffy,0,0,0,,Biz korsanız!
Dialogue: 0,0:03:35.41,0:03:38.91,Main,Luffy,0,0,0,,Kahramanları çok severim ama\Nonlardan biri olmak istemiyorum!
Dialogue: 0,0:03:39.17,0:03:42.67,Main,Luffy,0,0,0,,Sen kahraman olmanın ne demek olduğunu biliyor musun ki?
Dialogue: 0,0:03:42.67,0:03:43.64,Main,Jinbe,0,0,0,,Ha?
Dialogue: 0,0:03:43.64,0:03:45.87,Main,Luffy,0,0,0,,Mesela, bir et düşün tamam mı?
Dialogue: 0,0:03:45.87,0:03:48.45,Main,Luffy,0,0,0,,Korsanlar eti ziyafetlerde yer,
Dialogue: 0,0:03:48.45,0:03:51.52,Main,Luffy,0,0,0,,ama kahramanlar eti herkes ile paylaşmak zorundadır.
Dialogue: 0,0:03:51.52,0:03:53.52,Main,Luffy,0,0,0,,Ben et yemek istiyorum!
Dialogue: 0,0:03:53.52,0:03:55.33,Main,Nami,0,0,0,,Nasıl bir mantık bu?
Dialogue: 0,0:03:55.33,0:03:59.82,Main,Jinbe,0,0,0,,Peki. Sana et vereceğim o yüzden dediğimi yap!
Dialogue: 0,0:03:59.82,0:04:00.62,Main,Luffy,0,0,0,,Tamam.
Dialogue: 0,0:04:01.58,0:04:02.70,Main,Chopper,0,0,0,,Bu kadar kolay mı?!
Dialogue: 0,0:04:02.82,0:04:06.55,Main,Jinbe,0,0,0,,Kısacası, bana yardım etmeni sağlayacağım.
Dialogue: 0,0:04:06.55,0:04:08.68,Main,Jinbe,0,0,0,,Bunu yapabildiğin sürece, sıkıntı yok.
Dialogue: 0,0:04:08.68,0:04:09.48,Main,Luffy,0,0,0,,Yardım mı?
Dialogue: 0,0:04:09.48,0:04:15.55,Main,Jinbe,0,0,0,,Evet, önce Megalo ve ben onlara bilerek yakalanacağız ve içeriye sızacağız.
Dialogue: 0,0:04:17.23,0:04:21.36,Main,Jinbe,0,0,0,,Ve sonra, ben onların dikkatini çektiğimde,
Dialogue: 0,0:04:21.36,0:04:26.46,Main,Jinbe,0,0,0,,sizden biri gizlice Megalo'nun karnından çıkacak.
Dialogue: 0,0:04:26.89,0:04:28.34,Main,Luffy,0,0,0,,Karnının içinden mi?
Dialogue: 0,0:04:32.75,0:04:36.59,Main,Jinbe,0,0,0,,Sonra da Hodyler'den \NKutsal Ejderler'in formunu alacaksınız.
Dialogue: 0,0:04:37.63,0:04:39.38,Main,Luffy,0,0,0,,Ne formu?
Dialogue: 0,0:04:39.94,0:04:45.80,Main,Sanji,0,0,0,,Doğru ya, Luffy uyuyordu, o yüzden Jinbe'nin anlattıklarını dinlemedi.
Dialogue: 0,0:04:46.61,0:04:55.19,Main,Jinbe,0,0,0,,On yıl önce Kraliçe Otohime'nin, hayatını riske atarak aldığı, bu adanın geleceğini belirleyecek önemli bir şey.
Dialogue: 0,0:04:55.44,0:04:59.53,Main,Jinbe,0,0,0,,İhtiyacımız olan bir başka şey ise Kral'ın zincirlerinin anahtarı.
Dialogue: 0,0:04:59.53,0:05:04.03,Main,Jinbe,0,0,0,,Bunları çalmamız lazım...\NBunu yapabilecek biri var mı?
Dialogue: 0,0:05:04.48,0:05:08.83,Main,Nami,0,0,0,,Çalma işini bana bırakın.\NBen ve Robin beraber yapabiliriz sanırım.
Dialogue: 0,0:05:08.83,0:05:09.91,Main,Robin,0,0,0,,Evet.
Dialogue: 0,0:05:10.57,0:05:15.88,Main,Jinbe,0,0,0,,Pekala. Kral'ı serbest bıraktıktan sonra, Luffy-kun'dan bana yardım etmesini isteyeceğim.
Dialogue: 0,0:05:15.88,0:05:21.26,Main,Jinbe,0,0,0,,Sonra da Megalo'nun karnının içinden çıkıp, \Nbüyük bir giriş yapacaksınız.
Dialogue: 0,0:05:21.26,0:05:25.72,Main,Jinbe,0,0,0,,Böylece herkes Luffy-kun ve benim beraber çalıştığımızı anlayacak.
Dialogue: 0,0:05:25.72,0:05:32.98,Main,Jinbe,0,0,0,,Prenses haber almaya hazır bir şekilde, \Nmeydanın dışında güvenli bir noktada bekleyebilir.
Dialogue: 0,0:05:32.98,0:05:36.15,Main,Jinbe,0,0,0,,Sonra da serbest kaldıkları gibi \NKral ve Prensler ile birlikte kaçabilir.
Dialogue: 0,0:05:36.15,0:05:42.44,Main,Jinbe,0,0,0,,Bunlar yaşanırken, geri kalanınız Ryugu Şatosu'na gidecek ve müttefiklerimizi kurtaracaksınız.
Dialogue: 0,0:05:42.88,0:05:46.46,Main,Jinbe,0,0,0,,Bu bittiğinde, meydana geri dönün.
Dialogue: 0,0:05:46.46,0:05:50.12,Main,Jinbe,0,0,0,,Şatodaki müttefiklerinizi nasıl kurtaracağınıza gelirsek...
Dialogue: 0,0:05:52.07,0:05:53.58,Main,Jinbe,0,0,0,,Kendiniz bir şeyler bulun.
Dialogue: 0,0:05:53.58,0:05:55.54,Main,Sanji,0,0,0,,Bu bir plan değil ki!
Dialogue: 0,0:05:56.96,0:05:59.06,Main,Franky,0,0,0,,Süper-bana bırakın!
Dialogue: 0,0:05:59.06,0:06:03.67,Main,Franky,0,0,0,,Bende Sunny var sonuçta, \Nbir şekilde bir şey düşünürüm.
Dialogue: 0,0:06:03.67,0:06:09.74,Main,Jinbe,0,0,0,,Eğer bu planı takip edersek,\Nvatandaşlar nasıl tepki verecek sizce...
Dialogue: 0,0:06:09.74,0:06:10.51,Main,Jinbe,0,0,0,,siz ikiniz?
Dialogue: 0,0:06:11.96,0:06:18.98,Main,Hachi,0,0,0,,Jinbe-san'a adadaki vatandaşlar da,\N Balık Adam Bölgesi sakinleri de saygı duyuyor.
Dialogue: 0,0:06:18.98,0:06:24.95,Main,Caimie,0,0,0,,Evet, eğer herkes Patron'un Kral'ı kurtarmak için Luffy-chin'e güvendiğini görürse,
Dialogue: 0,0:06:24.95,0:06:28.20,Main,Caimie,0,0,0,,o zaman eminim herkes Luffy-chin'i destekler!
Dialogue: 0,0:06:29.32,0:06:30.62,Main,Hachi,0,0,0,,Hasır Şapka.
Dialogue: 0,0:06:31.70,0:06:33.08,Main,Shirahoshi,0,0,0,,Luffy-sama.
Dialogue: 0,0:06:35.54,0:06:38.91,Main,Luffy,0,0,0,,Bunu sadece sen istedin diye yapıyorum, Jinbe!
Dialogue: 0,0:06:38.91,0:06:42.88,Main,Luffy,0,0,0,,Herkes tarafından desteklenmek benim sadece dikkatimi dağıtır!
Dialogue: 0,0:06:42.88,0:06:46.01,Main,Nami,0,0,0,,Bu çok sık olmuyor sonuçta.
Dialogue: 0,0:06:46.01,0:06:51.39,Main,Sanji,0,0,0,,Deniz kızları beni desteklerken, şeytanın kendisini bile yenebilirim!
Dialogue: 0,0:06:51.39,0:06:52.77,Main,Jinbe,0,0,0,,Sağol.
Dialogue: 0,0:06:53.83,0:06:55.68,Main,Robin,0,0,0,,Kesinleşti öyleyse.
Dialogue: 0,0:06:55.68,0:06:58.45,Main,Nami,0,0,0,,Geri kalan tek şey yapmak!
Dialogue: 0,0:07:01.08,0:07:03.82,Main,Nami,0,0,0,,Hala aklına takılan bir şey mi var?
Dialogue: 0,0:07:03.82,0:07:05.28,Main,Jinbe,0,0,0,,Planın adı ne olsun?
Dialogue: 0,0:07:05.28,0:07:07.31,Main,Sanji,0,0,0,,Öyle bir şeye gerek yok!
Dialogue: 0,0:07:07.31,0:07:09.12,Main,Luffy,0,0,0,,Pekala, çabuk olalım!
Dialogue: 0,0:07:09.60,0:07:14.09,Main,Citizen,0,0,0,,{\an8}Hasır Şapkalı Luffy bir insan korsan ama bizim tarafımızda, değil mi?
Dialogue: 0,0:07:09.90,0:07:14.96,Captions,,0,0,0,,{\fad(300,300)}Gyoncord Meydanı - Dış Çevre
Dialogue: 0,0:07:14.09,0:07:17.58,Main,Fishman,0,0,0,,{\an8}Prenses Shirahoshi,\NHasır Şapka'dan yardım istedi!
Dialogue: 0,0:07:17.58,0:07:22.39,Main,Fishman,0,0,0,,Patron Jinbe ile beraber \Nbu ülkeyi kurtarmaya geldi!
Dialogue: 0,0:07:22.39,0:07:23.86,Main,Fishmen,0,0,0,,Hasır Şapka!
Dialogue: 0,0:07:25.46,0:07:27.89,Main,Zeo,0,0,0,,Oldukça ünlendin gibi duruyor...
Dialogue: 0,0:07:27.89,0:07:30.83,Main,Zeo,0,0,0,,ama Kral'ı bizden aldın diye kendini bir şey sanma!
Dialogue: 0,0:07:31.26,0:07:34.93,Main,Zeo,0,0,0,,Siz alt tarafı insan korsanlarsınız!
Dialogue: 0,0:07:32.04,0:07:35.03,Author,,0,0,0,,{\fad(200,0)\fs19} Türkçeleştirme & Çevirmen  {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&} - {\c&H01BAFF&}{\b1}Kaşgarlı{\b0}{\c&HFFFFFF&}\N{\fs19}thx to onepace.net
Dialogue: 0,0:15:46.34,0:15:56.34,Author,,0,0,0,,{\fad(500,500)\fs19} Türkçeleştirme & Çevirmen  {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&} - {\c&H01BAFF&}{\b1}Kaşgarlı{\b0}{\c&HFFFFFF&}\N{\fs19}thx to onepace.net
Dialogue: 0,0:36:02.50,0:36:05.30,Author,,0,0,0,,{\fad(0,0)\fs19} Türkçeleştirme & Çevirmen  {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&} - {\c&H01BAFF&}{\b1}Kaşgarlı{\b0}{\c&HFFFFFF&}\N{\fs19}thx to onepace.net
Dialogue: 0,0:07:32.04,0:07:35.03,Title,,0,0,0,,{\fad(200,0)}100,000'e Karşı 10!\NHasır Şapkalar'ın Güçlü Yetenekleri
Dialogue: 0,0:07:34.93,0:07:38.31,Main,Brook,0,0,0,,Deniz Kızı Prenses-san, ne kadar da güzelsiniz.
Dialogue: 0,0:07:40.67,0:07:44.34,Main,Brook,0,0,0,,Kusura bakmayın ama\N acaba külodunuzu görmeme izin verir{\fscx250}-{\r}
Dialogue: 0,0:07:44.34,0:07:46.76,Main,Nami,0,0,0,,Kes şunu! Deniz Kızı Prenses o.
Dialogue: 0,0:07:46.76,0:07:48.53,Main,Brook,0,0,0,,O zaman, Nami-san'ınkiyle yetinebilir miyim?
Dialogue: 0,0:07:48.53,0:07:49.76,Main,Nami,0,0,0,,Yetinmek de ne demek?!
Dialogue: 0,0:07:53.59,0:07:55.60,Main,Luffy,0,0,0,,Sonunda herkes burada gibi görünüyor.
Dialogue: 0,0:07:55.60,0:07:57.02,Main,Daruma,0,0,0,,Görmezden geldiler!
Dialogue: 0,0:07:57.45,0:08:00.82,Main,Zeo,0,0,0,,Çünkü duyamasınlar diye bilerek sessizce söyledim!
Dialogue: 0,0:08:00.82,0:08:06.39,Main,Sanji,0,0,0,,Nami-swan! O aptalları kurtaran bendim!
Dialogue: 0,0:08:06.39,0:08:07.40,Main,Sanji,0,0,0,,Aşık oldun mu?
Dialogue: 0,0:08:07.40,0:08:08.32,Main,Nami,0,0,0,,Tabii tabii.
Dialogue: 0,0:08:08.32,0:08:12.77,Main,Zoro,0,0,0,,Aptal, çıkışa kadar kendimiz ulaştık.
Dialogue: 0,0:08:12.77,0:08:13.45,Main,Usopp,0,0,0,,
Dialogue: 0,0:08:13.79,0:08:17.58,Main,Pappagg,0,0,0,,Çünkü ben kurtardım sizi!
Dialogue: 0,0:08:17.80,0:08:19.14,Main,Nami,0,0,0,,Pappag, onları sen mi kurtardın?
Dialogue: 0,0:08:22.73,0:08:23.72,Main,Nami,0,0,0,,İşte burada.
Dialogue: 0,0:08:24.73,0:08:26.48,Main,Nami,0,0,0,,Kutsal Ejderler'in formu.
Dialogue: 0,0:08:27.50,0:08:30.25,Main,Shirahoshi,0,0,0,,Çok teşekkürler herkese.
Dialogue: 0,0:08:30.25,0:08:34.82,Main,Shirahoshi,0,0,0,,Bu annemden miras kalan, \NBalık Adam Adası'nın umudu.
Dialogue: 0,0:08:34.82,0:08:38.20,Main,Luffy,0,0,0,,Ama cidden, Güçsüz-hoshi biraz baş belası.
Dialogue: 0,0:08:39.42,0:08:43.18,Main,Jinbe,0,0,0,,Prenses'in de yakalanması kesinlikle planımın bir parçası değildi.
Dialogue: 0,0:08:43.18,0:08:44.70,Main,Jinbe,0,0,0,,Onu buradan nasıl çıkaracağız?
Dialogue: 0,0:08:45.50,0:08:49.17,Main,Shirahoshi,0,0,0,,Luffy-sama, benim hakkımda mı konuşuyorsunuz?
Dialogue: 0,0:08:49.17,0:08:49.78,Main,Luffy,0,0,0,,Evet.
Dialogue: 0,0:08:50.28,0:08:53.59,Main,Shirahoshi,0,0,0,,Şimdiye kadar bana hep, "Pısırık." dediniz.
Dialogue: 0,0:08:53.59,0:08:58.51,Main,Luffy,0,0,0,,Evet, çünkü tüm detayları bilmiyordum.\NDüşündüğüm kadar pısırık değilmişsin.
Dialogue: 0,0:08:59.56,0:09:01.13,Main,Luffy,0,0,0,,O yüzden bundan sonra...
Dialogue: 0,0:09:01.75,0:09:03.12,Main,Luffy,0,0,0,,Zayıf-hoshi'sin!
Dialogue: 0,0:09:03.12,0:09:10.84,Main,Robin,0,0,0,,Bir sorunla karşılaştığında sinir ve nefret ile karşılık vermeyi herkes yapabilir.
Dialogue: 0,0:09:12.44,0:09:15.13,Main,Robin,0,0,0,,Sana hakaret eden o adam gibi.
Dialogue: 0,0:09:16.50,0:09:24.16,Main,Nami,0,0,0,,Ama o nefretin hepsini içinde tutabilecek kadar güçlü olan birisi pısırık değildir.
Dialogue: 0,0:09:24.16,0:09:26.20,Main,Jinbe,0,0,0,,Kesinlikle öyle.
Dialogue: 0,0:09:26.20,0:09:30.04,Main,Jinbe,0,0,0,,Prenses Shirahoshi,\N onca yıl boyunca yorulmuş olmalı.
Dialogue: 0,0:09:30.46,0:09:36.67,Main,Shirahoshi,0,0,0,,Çok özür dilerim.  Bunların hepsi ben gerçeği sakladığım için oluyor.
Dialogue: 0,0:09:37.01,0:09:40.40,Main,Jinbe,0,0,0,,Sorun değil. Kendinizle gurur duymalısınız.
Dialogue: 0,0:09:41.61,0:09:46.14,Main,Jinbe,0,0,0,,Nefrete yenik düşemeyiz.\NO büyük insanlar da bizden bunu isterdi.
Dialogue: 0,0:09:46.66,0:09:50.23,Flashbacks,Tiger,0,0,0,,{\fad(0,900)} Adadaki kimseye bir şey söylemeyin! { from 543 }
Dialogue: 0,0:09:51.14,0:09:57.69,Flashbacks,Otohime,0,0,0,,{\q2}Benim yüzümden öfke ve nefret içinde kaybolmayın. { from 546 }
Dialogue: 0,0:09:59.08,0:10:02.49,Main,Jinbe,0,0,0,,Kalbine ektiğin o küçük tohum...
Dialogue: 0,0:10:02.49,0:10:04.98,Main,Jinbe,0,0,0,,büyüyüp bu adayı kaplayacak.
Dialogue: 0,0:10:04.98,0:10:08.92,Main,Jinbe,0,0,0,,Eğer diğer herkesin seninle aynı şekilde düşündüğü bir gün gelirse...
Dialogue: 0,0:10:08.92,0:10:11.51,Main,Jinbe,0,0,0,,o zaman bu intikam döngüsü kaybolur,
Dialogue: 0,0:10:11.51,0:10:15.46,Main,Jinbe,0,0,0,,balık adamlar ve insanlar arasındaki kavga biter.
Dialogue: 0,0:10:15.85,0:10:20.53,Main,Jinbe,0,0,0,,Niyetim katlandığın o uzun yıllara \Nsaygısızlık etmek değil...
Dialogue: 0,0:10:21.25,0:10:28.44,Main,Jinbe,0,0,0,,Tek başına, günden güne, \No tohumu canın pahasına korudun.
Dialogue: 0,0:10:28.44,0:10:32.35,Main,Jinbe,0,0,0,,Şimdi de onu bizim korumamıza izin ver.
Dialogue: 0,0:10:51.10,0:10:54.17,Main,Shiroshi,0,0,0,,T-T-Tamam!
Dialogue: 0,0:10:58.60,0:11:00.91,Main,Shiroshi,0,0,0,,Çok teşekkür ederim!
Dialogue: 0,0:11:03.73,0:11:06.60,Main,Luffy,0,0,0,,Pısırık değilsin ama kesinlikle bir sulugözsün!
Dialogue: 0,0:11:07.28,0:11:11.10,Main,Fishmen,0,0,0,,Hasır Şapka! Bitir işlerini!
Dialogue: 0,0:11:13.65,0:11:17.00,Main,Hody,0,0,0,,Vander Decken ne işe yaramaz adammış.
Dialogue: 0,0:11:17.00,0:11:20.78,Main,Hody,0,0,0,,Onun Shirahoshi'yi çoktan öldürmesi gerekiyordu.
Dialogue: 0,0:11:21.11,0:11:22.50,Main,Pirates,0,0,0,,Kaptan Hody!
Dialogue: 0,0:11:32.99,0:11:38.13,Main,Hody,0,0,0,,Baş belası bir güce sahip olan, efsanevi Deniz Kızı Prenses...
Dialogue: 0,0:11:38.24,0:11:42.59,Main,Hody,0,0,0,,Yapması gereken tek şey \Nhızlıca Shirahoshi'yi öldürmekti.
Dialogue: 0,0:11:42.59,0:11:46.55,Main,Hody,0,0,0,,Kahretsin, şimdi de aptal yerine koyuluyorum.
Dialogue: 0,0:11:47.17,0:11:53.37,Main,Hody,0,0,0,,Jinbe... Kendini bu kadar kolay yakalattığında anlamam gerekirdi.
Dialogue: 0,0:11:57.06,0:11:59.60,Main,Hody,0,0,0,,İnsanlarla pek sıkı fıkıymışsın!
Dialogue: 0,0:12:00.14,0:12:04.12,Main,Hody,0,0,0,,En çok da senin gibi kişilerden nefret ederim!
Dialogue: 0,0:12:04.12,0:12:10.18,Main,Hody,0,0,0,,Seninle beraber Balık Adam Bölgesi'nde büyüyen, Fisher Tiger da yeminli kardeşin Arlong da...
Dialogue: 0,0:12:10.18,0:12:13.42,Main,Hody,0,0,0,,insanlar tarafından öldürüldü.
Dialogue: 0,0:12:13.42,0:12:18.23,Main,Hody,0,0,0,,Ama kardeşinin ölümünün intikamını almak yerine, \Ngidip onu öldürenler ile arkadaş oldun!
Dialogue: 0,0:12:18.23,0:12:22.59,Main,Hody,0,0,0,,Neptune'den bile daha kötü, lanet bir korkaksın!
Dialogue: 0,0:12:22.59,0:12:26.88,Main,Hody,0,0,0,,Ben bu adanın kralı olduğumda,\Nher şey değişecek.
Dialogue: 0,0:12:26.88,0:12:31.61,Main,Hody,0,0,0,,Bu yılın Dünya Konseyi Toplantısı mükemmel bir fırsat olacak.
Dialogue: 0,0:12:32.05,0:12:37.14,Main,Hody,0,0,0,,Dünyadaki tüm insan kralları Mariejois'da katledeceğim.
Dialogue: 0,0:12:37.14,0:12:41.44,Main,Hody,0,0,0,,Sonra da korkulan denizaltı krallığımızın üstündeki perde kalkacak!
Dialogue: 0,0:12:43.82,0:12:49.51,Main,Hody,0,0,0,,Dünyadaki tüm insanları denizin dibine çekeceğiz ve onları kölemiz yapacağız!
Dialogue: 0,0:12:49.51,0:12:53.77,Main,Hody,0,0,0,,En sonunda da balık adam ırkına karşı durabilecek kimse kalmayacak!
Dialogue: 0,0:12:53.77,0:12:55.67,Main,Hody,0,0,0,,Korsanlık dünyası için de aynı şey geçerli.
Dialogue: 0,0:12:57.87,0:13:04.10,Main,Hody,0,0,0,,Tüm korsanlar Yeni Balık Adam Korsanları'nın önünde diz çökecek!
Dialogue: 0,0:13:04.10,0:13:05.93,Main,Hody,0,0,0,,Şuna bakın!
Dialogue: 0,0:13:05.93,0:13:10.28,Main,Hody,0,0,0,,Bunlar benim gücümü bilen korsanların yüzleri.
Dialogue: 0,0:13:10.76,0:13:14.09,Main,Hody,0,0,0,,Bu sizin geleceğiniz.
Dialogue: 0,0:13:14.09,0:13:19.82,Main,Hody,0,0,0,,Hasır Şapka, en sonunda yeni Korsanlar Kralı ben olacağım.
Dialogue: 0,0:13:21.70,0:13:23.26,Main,Luffy,0,0,0,,Korsanlar Kralı mı?
Dialogue: 0,0:13:25.90,0:13:30.99,Main,Hody,0,0,0,,Benim bir üflememle uçup gidecek alt tarafı on korsan ne yapabilir ki?
Dialogue: 0,0:13:30.99,0:13:33.31,Main,Hody,0,0,0,,Bende yüz bin tane var!
Dialogue: 0,0:13:33.39,0:13:36.39,Main,Hody,0,0,0,,Öldürün onları, Yeni Balık Adam Korsanları!
Dialogue: 0,0:13:39.51,0:13:40.92,Main,Chopper,0,0,0,,Yüz bin tane!
Dialogue: 0,0:13:40.92,0:13:43.32,Main,Chopper,0,0,0,,Bu kadarıyla nasıl dövüşeceğiz?!
Dialogue: 0,0:13:43.32,0:13:44.65,Main,Chopper,0,0,0,,Bu imkansız!
Dialogue: 0,0:13:44.65,0:13:48.32,Main,Pappagg,0,0,0,,Sizinle arkadaş olmaktan da hiç iyi bir şey çıkmıyor.
Dialogue: 0,0:13:49.00,0:13:52.71,Main,Robin,0,0,0,,Dövüşme şansı bile bulamadan ezilebilirmişiz gibi görünüyor.
Dialogue: 0,0:13:52.71,0:13:54.53,Main,Usopp,0,0,0,,Ezilmek mi!? Çok korkunç!
Dialogue: 0,0:13:54.53,0:13:56.82,Main,Brook,0,0,0,,Yüz bin düşman...
Dialogue: 0,0:13:56.82,0:14:00.68,Main,Brook,0,0,0,,Kesinlikle şaşırtıcı bir miktar.\NGözlerim yuvalarından fırlayacak.
Dialogue: 0,0:14:00.68,0:14:04.21,Main,Brook,0,0,0,,Benim yuvalarından fırlayacak gözlerim yok gerçi.
Dialogue: 0,0:14:04.92,0:14:08.55,Main,Nami,0,0,0,,Yüz bin de neymiş?! Hadi yapalım şunu!
Dialogue: 0,0:14:09.13,0:14:12.88,Main,Usopp,0,0,0,,Söylemesi kolay!\NBizi canlı kalkan olarak kullanıyorsun!
Dialogue: 0,0:14:14.07,0:14:16.92,Main,Franky,0,0,0,,Bunu bekliyordum. İşte benim sıram.
Dialogue: 0,0:14:16.92,0:14:21.14,Main,Franky,0,0,0,,Süper Zırhlı Ben!
Dialogue: 0,0:14:21.14,0:14:24.02,Main,Franky,0,0,0,,Hadi, bana istediğiniz taraftan saldırın!
Dialogue: 0,0:14:24.02,0:14:29.96,Main,Sanji,0,0,0,,Sadece on kişiyiz...\Nyani her birimiz on bin kişinin işini bitirmek zorunda.
Dialogue: 0,0:14:29.96,0:14:33.47,Main,Zoro,0,0,0,,Yüksek sayılar her zaman güç göstermez.
Dialogue: 0,0:14:33.47,0:14:37.91,Main,Zoro,0,0,0,,Seçkin Denizciler falan değiller. Boşuna korkuyorsun.
Dialogue: 0,0:14:38.53,0:14:41.49,Main,Sanji,0,0,0,,Korkan da kimmiş, seni pislik yosun kafa?!
Dialogue: 0,0:14:41.49,0:14:44.46,Main,Zoro,0,0,0,,Tabii ki sensin, burnu kanayan aşçı!
Dialogue: 0,0:14:47.73,0:14:49.04,Main,Sanji,0,0,0,,Hey, Luffy...
Dialogue: 0,0:14:49.04,0:14:50.84,Main,Jinbe,0,0,0,,L-Luffy-kun.
Dialogue: 0,0:14:51.33,0:14:52.79,Main,Shirahoshi,0,0,0,,Luffy-sama.
Dialogue: 0,0:14:54.10,0:14:56.67,Main,Pirate,0,0,0,,Kellesindeki 400 milyon benim!
Dialogue: 0,0:14:56.67,0:14:58.07,Main,Pirate2,0,0,0,,Benim!
Dialogue: 0,0:14:58.07,0:14:59.85,Main,Pirate,0,0,0,,İzin veririz mi sandın?
Dialogue: 0,0:15:01.66,0:15:02.68,Main,Hody,0,0,0,,Öldürün.
Dialogue: 0,0:15:39.16,0:15:41.05,Main,Pirate,0,0,0,,Bu da ne böyle?!
Dialogue: 0,0:15:57.65,0:16:01.12,Main,Pirate,0,0,0,,Hiçbir şey yapmamasına rağmen bir sürü korsanın işini bitirdi!
Dialogue: 0,0:16:01.12,0:16:03.29,Main,Pirate2,0,0,0,,Hey! Kendinize gelin!
Dialogue: 0,0:16:03.72,0:16:06.79,Main,Pirate,0,0,0,,Kahretsin! Anında yarımızı hakladı!
Dialogue: 0,0:16:06.79,0:16:10.79,Main,Pirate2,0,0,0,,Öylece elli bin kişiyi mi?! Ne yaptı o öyle?!
Dialogue: 0,0:16:11.28,0:16:13.09,Main,Citizen,0,0,0,,O da neydi?
Dialogue: 0,0:16:13.09,0:16:15.21,Main,Citizen2,0,0,0,,Ne? Ne oldu?
Dialogue: 0,0:16:15.21,0:16:17.92,Main,Shyarly,0,0,0,,Hiç fena değil, Hasır Şapkalı çocuk.
Dialogue: 0,0:16:18.82,0:16:21.21,Main,Girl,0,0,0,,Bunu Hasır Şapkalı korsan mı yaptı?
Dialogue: 0,0:16:21.21,0:16:22.89,Main,Boy,0,0,0,,Harikasın, Hasır Şapka!
Dialogue: 0,0:16:23.24,0:16:24.69,Main,Robin,0,0,0,,Bu haki mi?
Dialogue: 0,0:16:24.69,0:16:27.48,Main,Jinbe,0,0,0,,İki yılda bu kadar ileriye mi gitti?
Dialogue: 0,0:16:27.48,0:16:31.83,Main,Sanji,0,0,0,,Fatihin Hakisi. Onda bunca zamandır var mıydı?
Dialogue: 0,0:16:31.83,0:16:35.73,Main,Zoro,0,0,0,,En az bu kadar güçlü olmasaydı, ben kaptan olmak zorunda kalırdım.
Dialogue: 0,0:16:35.73,0:16:38.20,Main,Shirahoshi,0,0,0,,Harikasınız, Luffy-sama.
Dialogue: 0,0:16:38.71,0:16:42.45,Main,Luffy,0,0,0,,Sen Hody'sin, değil mi?\N Sana dersini vermek zorundayım.
Dialogue: 0,0:16:43.27,0:16:47.33,Main,Luffy,0,0,0,,Eğer öylece istediğin gibi bir ülkenin kralı olmak istiyorsan, bu beni ilgilendirmez...
Dialogue: 0,0:16:48.86,0:16:52.84,Main,Luffy,0,0,0,,Sadece bir Korsanlar Kralı için yer var!
Dialogue: 0,0:13:51.03,0:13:51.03,Main,,0,0,0,,
Dialogue: 0,0:18:21.14,0:18:22.44,Note,,0,0,0,,Üçüncü Düzen
Dialogue: 0,0:18:36.50,0:18:39.80,Attack,,0,0,0,,Dev Tabanca
Dialogue: 0,0:19:48.27,0:19:49.77,Attack,,0,0,0,,Su Atışı
Dialogue: 0,0:20:58.70,0:21:00.50,Attack,,0,0,0,,Üç Kılıç Stili
Dialogue: 0,0:21:08.78,0:21:12.10,Attack,TL Note,0,0,0,,{\fad(100,100)}Kara Dizi - Dev Ejder Kasırgası
Dialogue: 0,0:22:15.92,0:22:19.37,Attack,TL Note,0,0,0,,{\fad(100,100)}Bin İğne
Dialogue: 0,0:24:31.29,0:24:33.57,Attack,,0,0,0,,Gökyüzü Yürüyüşü
Dialogue: 0,0:24:46.77,0:24:50.65,Note,TL Note,0,0,0,,{\fad(100,100)}Geppo: Ay Yürüyüşü
Dialogue: 0,0:13:51.03,0:13:51.03,Main,,0,0,0,,
Dialogue: 0,0:16:52.86,0:16:55.02,Main,Zeo,0,0,0,,Elli bin kişiyi haklamış olabilir ama...
Dialogue: 0,0:16:57.76,0:16:58.97,Main,Zeo,0,0,0,,hala...
Dialogue: 0,0:17:00.18,0:17:02.71,Main,Zeo,0,0,0,,elli bin kişimiz var!
Dialogue: 0,0:17:05.78,0:17:11.23,Main,Zeo,0,0,0,,Hasır Şapka Korsanları bizim azmimizi parçalamadıkları sürece durmayacak!
Dialogue: 0,0:17:11.23,0:17:13.16,Main,Zeo,0,0,0,,Ezeli düşmanlarımız!
Dialogue: 0,0:17:20.74,0:17:22.94,Main,Zeo,0,0,0,,Ve Jinbe...
Dialogue: 0,0:17:23.27,0:17:27.77,Main,Zeo,0,0,0,,Otohime'nin hayallerinin gerçek olduğu ve insan pisliğiyle beraber yaşadığımız,
Dialogue: 0,0:17:27.77,0:17:31.44,Main,Zeo,0,0,0,,balık adam ırkı için olası en kötü geleceğin beden bulmuş hali!
Dialogue: 0,0:17:31.44,0:17:34.29,Main,Pirate,0,0,0,,Evet! Hasır Şapka da neymiş?!
Dialogue: 0,0:17:34.29,0:17:36.25,Main,Pirate,0,0,0,,Alt tarafı bir insan sonuçta!
Dialogue: 0,0:17:36.25,0:17:40.37,Main,Pirate,0,0,0,,Jinbe... balık adam ırkına ihanet etti! Öldürün!
Dialogue: 0,0:17:49.07,0:17:51.74,Main,Zoro,0,0,0,,Luffy, elli bin de fazla ama.
Dialogue: 0,0:17:51.74,0:17:53.16,Main,Zoro,0,0,0,,Fazla abarttın.
Dialogue: 0,0:17:53.16,0:17:54.93,Main,Luffy,0,0,0,,Öyle mi? Üzgünüm.
Dialogue: 0,0:17:55.49,0:17:57.19,Main,Sanji,0,0,0,,Ne diye hemen gaza geliyorsun?
Dialogue: 0,0:17:58.06,0:18:01.52,Main,Sanji,0,0,0,,Otuz binini ben alacağım. Anladın mı yosun kafa?
Dialogue: 0,0:18:01.52,0:18:04.65,Main,Zoro,0,0,0,,Kapa çeneni, Bay Burun Kanaması.
Dialogue: 0,0:18:07.75,0:18:09.57,Main,Pirate,0,0,0,,Bizim ırkımız üstün!
Dialogue: 0,0:18:09.57,0:18:10.87,Main,Pirate,0,0,0,,Hadi onlara gösterelim!
Dialogue: 0,0:18:19.42,0:18:20.47,Main,Luffy,0,0,0,,Gidelim!
Dialogue: 0,0:18:25.85,0:18:29.47,Main,Luffy,0,0,0,,Kaç bin kişi olduğunuz umurumda değil!
Dialogue: 0,0:18:32.94,0:18:34.33,Main,Pirate,0,0,0,,Geliyor!
Dialogue: 0,0:18:34.33,0:18:36.11,Main,Pirate,0,0,0,,O el de ne?!
Dialogue: 0,0:18:45.49,0:18:47.91,Main,Jinbe,0,0,0,,Pekala. Biz de mi başlasak?
Dialogue: 0,0:18:52.92,0:18:56.87,Main,Sanji,0,0,0,,Deniz Kızı Cenneti'mi \Nyok etmenize izin vermeyeceğim!
Dialogue: 0,0:18:58.88,0:19:02.78,Main,Zoro,0,0,0,,Teslim mi olacaklar yoksa yok mu edilecekler?
Dialogue: 0,0:19:03.15,0:19:08.22,Main,Robin,0,0,0,,Balık Adam Adası... Bu ülkede dünya tarihinin bazı önemli parçaları var!
Dialogue: 0,0:19:08.22,0:19:13.81,Main,Robin,0,0,0,,Öylece yok edebileceğiniz şeyler değiller!
Dialogue: 0,0:19:15.43,0:19:17.68,Main,Brook,0,0,0,,Ne kadar da ateşli.
Dialogue: 0,0:19:17.68,0:19:19.60,Main,Brook,0,0,0,,Konser için mükemmel!
Dialogue: 0,0:19:21.92,0:19:26.66,Main,Franky,0,0,0,,Elli bin kişilik bir ordu...\N"Onlar"ı göstermek için iyi bir fırsat!
Dialogue: 0,0:19:26.66,0:19:27.58,Main,Usopp,0,0,0,,"Onlar" mi?
Dialogue: 0,0:19:27.58,0:19:29.79,Main,Chopper,0,0,0,,"Onlar" da ne, Franky?
Dialogue: 0,0:19:29.79,0:19:34.12,Main,Franky,0,0,0,,Sunny'nin yeni silahları var! İki tane!
Dialogue: 0,0:19:34.12,0:19:35.67,Main,Franky,0,0,0,,Denemek isteyen var mı?
Dialogue: 0,0:19:36.45,0:19:37.63,Main,Usopp & Chopper,0,0,0,,Yeni silahlar mı?!
Dialogue: 0,0:19:39.14,0:19:41.65,Main,Hody,0,0,0,,Meydanın ortasında otururken...
Dialogue: 0,0:19:42.96,0:19:46.15,Main,Hody,0,0,0,,dev bir deniz kızını koruyabileceğinizi düşünüyorsanız...
Dialogue: 0,0:19:46.15,0:19:47.94,Main,Hody,0,0,0,,koruyun da görelim!
Dialogue: 0,0:20:04.71,0:20:07.71,Main,Luffy,0,0,0,,Vay... Endişelenmeme gerek yokmuş.
Dialogue: 0,0:20:12.46,0:20:17.71,Main,Daruma,0,0,0,,Kaptan Hody'nin aşırı güçlü {\i1}Uchimizu{\i0}'sunu...
Dialogue: 0,0:20:17.71,0:20:21.02,Main,Daruma,0,0,0,,Kendi {\i1}Uchimizu{\i0}'su ile durdurdu!
Dialogue: 0,0:20:21.02,0:20:24.35,Main,Daruma,0,0,0,,O adam da bir canavar!
Dialogue: 0,0:20:25.19,0:20:27.96,Main,Jinbe,0,0,0,,Böyle bir güce ulaşmak için \Nne yaptın bilmiyorum ama...
Dialogue: 0,0:20:28.19,0:20:31.18,Main,Jinbe,0,0,0,,Balık Adam Karate'nin talime ihtiyacı var!
Dialogue: 0,0:20:31.18,0:20:37.14,Main,Pirate,0,0,0,,O Shichibukai'e katılan ilk balık adam, sonuçta.
Dialogue: 0,0:20:37.14,0:20:42.12,Main,Pirate,0,0,0,,Shichibukai olmayı bıraktıktan sonra başındaki ödülün birden 400 milyona çıktığını duydum!
Dialogue: 0,0:20:42.12,0:20:45.11,Main,Pirate,0,0,0,,Böyle birine karşı ne şansımız olabilir ki?!
Dialogue: 0,0:20:45.11,0:20:48.32,Main,Jinbe,0,0,0,,Orada gevezelik etmeyi kesin de gelin!
Dialogue: 0,0:20:48.32,0:20:52.91,Main,Jinbe,0,0,0,,Prenses'in canını almak istiyorsanız önce hepimizi yenmeniz gerek!
Dialogue: 0,0:20:53.11,0:20:55.83,Main,Zeo,0,0,0,,Saldırın, Çelik Kabuk Bölüğü!
Dialogue: 0,0:20:55.83,0:20:57.75,Main,Pirate,0,0,0,,{\i1}Evet!
Dialogue: 0,0:21:20.64,0:21:24.37,Main,Pirate,0,0,0,,Çelik kabukları meyve gibi doğradı
Dialogue: 0,0:21:24.80,0:21:29.97,Main,Pirate,0,0,0,,O dev saldırı da neydi?\NÖlüm Meleği'nin tırpanı falan mı?
Dialogue: 0,0:21:29.97,0:21:30.71,Main,Pirate,0,0,0,,Daha bitmedi!
Dialogue: 0,0:21:33.70,0:21:35.54,Main,Pirate,0,0,0,,Durmuyor!
Dialogue: 0,0:21:35.54,0:21:37.22,Main,Pirate,0,0,0,,Dokunduğu şeyi kesen bir kasırga!
Dialogue: 0,0:21:37.22,0:21:39.24,Main,Pirate,0,0,0,,Kaçın! Kesileceğiz!
Dialogue: 0,0:21:39.24,0:21:41.21,Main,Pirate,0,0,0,,Daha ne kadar peşimizden gelecek?!
Dialogue: 0,0:21:42.67,0:21:44.38,Main,Zoro,0,0,0,,Cehennemin sonuna kadar.
Dialogue: 0,0:21:47.01,0:21:49.22,Main,Daruma,0,0,0,,Kafanızı kullanın, aptallar!
Dialogue: 0,0:21:50.30,0:21:52.30,Main,Pirate,0,0,0,,Balonunuzun irtifasını arttırın!
Dialogue: 0,0:21:55.21,0:21:56.42,Main,Pirate,0,0,0,,Gökyüzünden saldıracağız!
Dialogue: 0,0:21:56.99,0:21:58.89,Main,Pirate,0,0,0,,Prenses Shirahoshi'yi öldürün!
Dialogue: 0,0:21:59.92,0:22:02.25,Main,Harisenbon,0,0,0,,Hepiniz şişleneceksiniz!
Dialogue: 0,0:22:02.25,0:22:03.50,Main,Daruma,0,0,0,,Hadi, Harisenbon!
Dialogue: 0,0:22:04.81,0:22:07.63,Main,Pirate,0,0,0,,Ah, bunlar Komutan Harisenbon ve adamları.
Dialogue: 0,0:22:08.62,0:22:11.04,Main,Pirate,0,0,0,,Deniz Kestanesi Dikeni Bölüğü! {Again, the alliteration was honestly not intended.}
Dialogue: 0,0:22:11.57,0:22:14.68,Main,Daruma,0,0,0,,O ayak oyunları yapan adamı şişle!
Dialogue: 0,0:22:19.32,0:22:22.77,Main,Harisenbon,0,0,0,,Artık kaçacak yerin yok!
Dialogue: 0,0:22:22.77,0:22:24.98,Main,Brook,0,0,0,,Sanji-san, dikkat edin!
Dialogue: 0,0:22:25.54,0:22:27.98,Main,Brook,0,0,0,,Ne diye bu kadar sakinsiniz?
Dialogue: 0,0:22:27.98,0:22:29.27,Main,Brook,0,0,0,,Hey!
Dialogue: 0,0:22:36.89,0:22:38.96,Thoughts,Sanji,0,0,0,,Şimdi düşününce, nostaljik hissediyorum...
Dialogue: 0,0:22:39.53,0:22:42.00,Flashbacks,Oh god no,0,0,0,,Sanji-kyun!
Dialogue: 0,0:22:44.76,0:22:46.67,Flashbacks,Sanji,0,0,0,,Kaçtım.
Dialogue: 0,0:22:46.67,0:22:49.44,Flashbacks,Caroline,0,0,0,,Bekle, Sanji-chan!
Dialogue: 0,0:22:49.44,0:22:50.89,Flashbacks,Sanji,0,0,0,,Bekleyeceğim sanki, pislik herif!
Dialogue: 0,0:22:51.46,0:22:54.14,Flashbacks,Caroline,0,0,0,,En sevdiğim elbiseyi getirmiştim oysaki!
Dialogue: 0,0:22:54.14,0:22:56.53,Flashbacks,Oh god no,0,0,0,,Gel buraya!
Dialogue: 0,0:22:56.53,0:22:58.35,Flashbacks,Oh god no,0,0,0,,Utanmana gerek yok!
Dialogue: 0,0:22:58.78,0:23:00.18,Flashbacks,Sanji,0,0,0,,Giymeyeceğim dedim ya!
Dialogue: 0,0:23:00.18,0:23:01.22,Flashbacks,Sanji,0,0,0,,Kim utanıyormuş?!
Dialogue: 0,0:23:03.36,0:23:04.63,Thoughts,Sanji,0,0,0,,Yağmurlu günlerde bile...
Dialogue: 0,0:23:05.64,0:23:07.13,Thoughts,Sanji,0,0,0,,Karlı günlerde bile...
Dialogue: 0,0:23:09.07,0:23:10.41,Thoughts,Sanji,0,0,0,,Yıldırımlı günlerde bile...
Dialogue: 0,0:23:11.09,0:23:12.50,Thoughts,Sanji,0,0,0,,Kaçtım ve kaçtım.
Dialogue: 0,0:23:15.00,0:23:19.12,Main,Harisenbon,0,0,0,,Ayak oyunları yapan adamın işini bitirin!
Dialogue: 0,0:23:19.79,0:23:21.98,Flashbacks,Caroline,0,0,0,,Seni aptal şey...
Dialogue: 0,0:23:21.98,0:23:26.47,Flashbacks,Caroline,0,0,0,,Sana hiç yetişemeyeceğimizi mi sandın?
Dialogue: 0,0:23:26.47,0:23:27.96,Flashbacks,Oh god no,0,0,0,,{\i1}Sanji-kyun!
Dialogue: 0,0:23:28.64,0:23:32.69,Flashbacks,Sanji,0,0,0,,Gerçekten bu heriflerin \Ngalip gelmesine izin mi vereceğim?
Dialogue: 0,0:23:32.69,0:23:35.76,Flashbacks,Oh god no,0,0,0,,{\i1}Sanji-kyun!
Dialogue: 0,0:23:37.08,0:23:40.12,Thoughts,Sanji,0,0,0,,Bir gün, artık kaçacak bir yerim kalmamıştı...
Dialogue: 0,0:23:56.78,0:23:57.81,Thoughts,Sanji,0,0,0,,Kaçtım...
Dialogue: 0,0:24:00.40,0:24:02.38,Main,Harisenbon,0,0,0,,Ne? Gitmiş.
Dialogue: 0,0:24:09.94,0:24:11.03,Thoughts,Sanji,0,0,0,,Kaçtım...
Dialogue: 0,0:24:11.03,0:24:14.28,Flashbacks,Oh god no,0,0,0,,{\i1}Sanji-kyun!
Dialogue: 0,0:24:16.64,0:24:17.96,Thoughts,Sanji,0,0,0,,Ben...
Dialogue: 0,0:24:19.05,0:24:20.17,Thoughts,Sanji,0,0,0,,gökyüzünde...
Dialogue: 0,0:24:22.42,0:24:23.93,Thoughts,Sanji,0,0,0,,koşuyordum!
Dialogue: 0,0:24:27.51,0:24:28.87,Main,Harisenbon,0,0,0,,Yukarıda!
Dialogue: 0,0:24:35.02,0:24:38.05,Main,Luffy,0,0,0,,Harika! Sanji havada uçuyor!
Dialogue: 0,0:24:38.05,0:24:39.52,Main,Luffy,0,0,0,,Aynı onları gibi!
Dialogue: 0,0:24:46.78,0:24:50.62,Main,Robin,0,0,0,,Bu CP9'un {\i1}Geppo{\i0} tekniği.
Dialogue: 0,0:24:51.85,0:24:53.71,Main,Sanji,0,0,0,,Hey, beyler!
Dialogue: 0,0:24:53.71,0:24:56.05,Main,Pirate,0,0,0,,Ne?! Uçuyor!
Dialogue: 0,0:24:56.05,0:24:59.96,Main,Sanji,0,0,0,,Shirahoshi-chan ile bir işiniz varsa, \Nönce beni geçmeniz gerek!
Dialogue: 0,0:25:00.78,0:25:02.77,Main,Sanji,0,0,0,,Beni görünce, ağlayan çocuklar bile susar...
Dialogue: 0,0:25:02.77,0:25:04.77,Main,Sanji,0,0,0,,Ben sizin şövalyenizim!
Dialogue: 0,0:25:04.77,0:25:06.46,Main,Shirahoshi,0,0,0,,Sanji-chin-sama!
Dialogue: 0,0:25:06.46,0:25:09.03,Main,Pirate,0,0,0,,Kendini bir şey sanıyor!
Dialogue: 0,0:25:10.91,0:25:12.14,Main,Sanji,0,0,0,,Küçük balık nasıl pişirilir.
Dialogue: 0,0:25:13.95,0:25:16.19,Attack,,0,0,0,,Şeytan Bacağı
Dialogue: 0,0:25:16.61,0:25:18.31,Attack,,0,0,0,,Kızartma Tavası
Dialogue: 0,0:25:22.26,0:25:24.64,Main,Dosun,0,0,0,,Hadi bu işi bitirelim-dosun!
Dialogue: 0,0:25:25.35,0:25:26.97,Main,Dosun,0,0,0,,Bombardıman Bölüğü!
Dialogue: 0,0:25:28.27,0:25:31.10,Main,Dosun,0,0,0,,Shirahoshi'yi hedef alın!
Dialogue: 0,0:25:33.51,0:25:35.96,Main,Brook,0,0,0,,Üzgünüm ama buna izin veremem.
Dialogue: 0,0:25:35.96,0:25:39.68,Main,Brook,0,0,0,,Tüm dünyada sevilen, \NDeniz Kızı Prenses'i nasıl incitmeye çalışırsınız?
Dialogue: 0,0:25:40.71,0:25:42.31,Attack,,0,0,0,,Parti Müziği
Dialogue: 0,0:25:45.98,0:25:49.19,Main,Pirate,0,0,0,,Ne oluyor? Etraf bir anda karardı.
Dialogue: 0,0:25:52.53,0:25:56.00,Main,Brook,0,0,0,,Festival gecesine hoşgeldiniz!
Dialogue: 0,0:25:56.53,0:25:57.81,Main,Pirate,0,0,0,,Ne?
Dialogue: 0,0:26:11.14,0:26:12.93,Main,Pirate,0,0,0,,Biz...
Dialogue: 0,0:26:12.93,0:26:15.26,Main,Pirate,0,0,0,,rüya falan mı görüyoruz?
Dialogue: 0,0:26:15.26,0:26:18.71,Main,Brook,0,0,0,,Şimdi, havai fişekleri ateşleyin!
Dialogue: 0,0:26:25.15,0:26:27.11,Main,Pirate,0,0,0,,Bu harika!
Dialogue: 0,0:26:35.03,0:26:37.28,Main,Pirate,0,0,0,,Çok güzel!
Dialogue: 0,0:26:37.28,0:26:40.20,Main,Dosun,0,0,0,,Hey! Prenses'e nişan almanızı söyledim-bokan!
Dialogue: 0,0:26:41.11,0:26:42.48,Main,Pirate,0,0,0,,Ama...
Dialogue: 0,0:26:42.48,0:26:44.92,Main,Pirate,0,0,0,,Dosun-san, eğlenceli bir festivaldeyiz.
Dialogue: 0,0:26:44.92,0:26:47.29,Main,Brook,0,0,0,,Pekala! Sizi çoktan kestim.
Dialogue: 0,0:26:49.19,0:26:51.49,Attack,,0,0,0,,Beşinci ve Üçüncü Savunma Fantazisi
Dialogue: 0,0:26:58.15,0:26:59.55,Attack,,0,0,0,,Bin Çiçek
Dialogue: 0,0:27:05.24,0:27:07.04,Attack,,0,0,0,,Devasa El
Dialogue: 0,0:27:08.28,0:27:09.33,Main,Pirate,0,0,0,,Ayak mı?!
Dialogue: 0,0:27:09.58,0:27:10.48,Attack,,0,0,0,,Damga
Dialogue: 0,0:27:17.38,0:27:19.03,Main,Robin,0,0,0,,Üzgünüm.
Dialogue: 0,0:27:20.66,0:27:22.69,Main,Chopper,0,0,0,,Dışarısı cidden gürültülü.
Dialogue: 0,0:27:22.69,0:27:24.13,Main,Pappagg,0,0,0,,Ne oluyor?
Dialogue: 0,0:27:24.13,0:27:26.78,Main,Nami,0,0,0,,Hey, ikiniz çıkın buradan! Çok sıkışık!
Dialogue: 0,0:27:26.78,0:27:30.48,Main,Usopp,0,0,0,,Yeni silahlar umurunda bile değil, değil mi? Sen çık!
Dialogue: 0,0:27:30.48,0:27:32.46,Main,Nami,0,0,0,,Dışarısı korkunç olduğu için buradayım ben!
Dialogue: 0,0:27:32.46,0:27:34.74,Main,Pappagg,0,0,0,,Ben de dışarıda kalmak istemiyorum!
Dialogue: 0,0:27:34.74,0:27:36.81,Main,Chopper,0,0,0,,Franky, daha silahları kullanamaz mıyız?
Dialogue: 0,0:27:42.44,0:27:44.65,Main,Franky,0,0,0,,Bu kadar sabırsız olma.
Dialogue: 0,0:27:49.05,0:27:51.57,Main,Franky,0,0,0,,Şimdi, gösteri zamanı!
Dialogue: 0,0:27:54.11,0:27:56.63,Main,Nami,0,0,0,,Ben de heyecanlanmaya başladım!
Dialogue: 0,0:27:56.63,0:27:59.50,Main,Usopp,0,0,0,,Hey bekle... Bu şeyi benim sürüyor olmam lazım.
Dialogue: 0,0:28:04.88,0:28:06.09,Main,Nami,0,0,0,,Büyüdü!
Dialogue: 0,0:28:07.24,0:28:09.11,Main,Nami,0,0,0,,Ne oluyor böyle?
Dialogue: 0,0:28:13.33,0:28:16.63,Main,Franky,0,0,0,,Peki, Sunny Asker Rıhtımı'nın yeni silahları...
Dialogue: 0,0:28:16.63,0:28:17.84,Main,Chopper,0,0,0,,Çok heyecanlı!
Dialogue: 0,0:28:17.84,0:28:18.87,Main,Pappagg,0,0,0,,Ne olacak?
Dialogue: 0,0:28:19.58,0:28:22.04,Main,Franky,0,0,0,,...açığa çıkıyor!
Dialogue: 0,0:28:28.96,0:28:30.80,Main,Daruma,0,0,0,,Ölümcül Zehir Bölüğü, gidin!
Dialogue: 0,0:28:31.18,0:28:32.82,Main,Pirate,0,0,0,,{\i1}Evet!
Dialogue: 0,0:28:32.82,0:28:36.32,Main,Pirate,0,0,0,,Dev ayak da olsa, el de olsa...
Dialogue: 0,0:28:36.77,0:28:40.52,Main,Pirate,0,0,0,,Zehirli silahlarımızdan tek bir vuruş onları indirir!
Dialogue: 0,0:28:40.52,0:28:42.84,Main,Franky,0,0,0,,Bir saniye bekleyin!
Dialogue: 0,0:28:50.53,0:28:53.33,Main,Franky,0,0,0,,Asker Rıhtımı Sistemi...
Dialogue: 0,0:28:54.51,0:28:56.44,Main,Franky,0,0,0,,Kanal Dört!
Dialogue: 0,0:29:01.07,0:29:02.95,Main,Franky,0,0,0,,Kara Gergedan...
Dialogue: 0,0:29:09.64,0:29:12.81,Main,Franky,0,0,0,,FR-U 4!
Dialogue: 0,0:29:30.06,0:29:33.25,Main,Luffy,0,0,0,,Çok havalı! Gergedan motor!
Dialogue: 0,0:29:33.25,0:29:35.73,Main,Brook,0,0,0,,O şey de ne? Güçlü görünüyor!
Dialogue: 0,0:29:36.64,0:29:38.82,Main,Franky,0,0,0,,Zehir hakkında ne demiştiniz?
Dialogue: 0,0:29:42.57,0:29:44.07,Main,Pirate,0,0,0,,O da ne?!
Dialogue: 0,0:29:44.07,0:29:50.17,Main,Franky,0,0,0,,Eğer işe yarayacağını düşünüyorsanız, \Nbu çelik canavarın üstünde deneyin bakalım!
Dialogue: 0,0:29:56.51,0:29:59.13,Main,Franky,0,0,0,,Nasıl? Süper havalı değil mi?
Dialogue: 0,0:30:00.62,0:30:02.27,Main,Pirate,0,0,0,,Durdurun onları!
Dialogue: 0,0:30:02.27,0:30:05.89,Main,Pirate,0,0,0,,Pekala... Çelik çeliğe karşı!
Dialogue: 0,0:30:05.89,0:30:08.38,Main,Pirate,0,0,0,,Bana bırakın!
Dialogue: 0,0:30:11.73,0:30:15.61,Main,Pirate,0,0,0,,İşte! Seni dümdüz edeceğim!
Dialogue: 0,0:30:36.93,0:30:38.30,Main,Chopper,0,0,0,,Hey!
Dialogue: 0,0:30:40.67,0:30:44.74,Main,Franky,0,0,0,,Yeni Numara, Kanal Beş!
Dialogue: 0,0:30:44.74,0:30:48.60,Main,Franky,0,0,0,,Brachio Tank 5 geldi!
Dialogue: 0,0:30:50.36,0:30:55.40,Main,Luffy,0,0,0,,{\i1}İşte! Bir dinozor! Binmek istiyorum! { def: There it is? }{ Btwb: That confuses me too. }
Dialogue: 0,0:30:53.56,0:30:55.40,Secondary,Brook,0,0,0,,Harika!
Dialogue: 0,0:30:55.40,0:30:58.22,Main,Usopp,0,0,0,,Benim bombardıman yeteneklerimi gördünüz mü?
Dialogue: 0,0:30:59.16,0:31:02.13,Main,Nami,0,0,0,,Başka bir sürü özelliği de var gibi görünüyor.
Dialogue: 0,0:31:02.13,0:31:04.76,Main,Pappagg,0,0,0,,Ama... o bir gemi ustası... değil mi?
Dialogue: 0,0:31:07.18,0:31:10.86,Main,Chopper,0,0,0,,Komutan Chopper bildiriyor!
Dialogue: 0,0:31:11.28,0:31:14.43,Main,Chopper,0,0,0,,Saat dokuz yönünde bir düşman grubu saptandı!
Dialogue: 0,0:31:15.51,0:31:16.74,Main,Chopper,0,0,0,,Ateş! {I would just like to take a moment to point out how the sound this tank makes is the greatest thing ever.}{Ditto}
Dialogue: 0,0:31:19.37,0:31:20.81,Main,Chopper,0,0,0,,Ateş!
Dialogue: 0,0:31:23.74,0:31:24.91,Main,Chopper,0,0,0,,Ateş!
Dialogue: 0,0:31:30.96,0:31:32.92,Main,Luffy,0,0,0,,Komutan, çok havalısın!
Dialogue: 0,0:31:32.92,0:31:35.25,Main,Zoro,0,0,0,,{\i1}Dövüşsene sen!
Dialogue: 0,0:31:38.75,0:31:42.12,Main,Fishman,0,0,0,,İnanılmaz... Onlar gerçekten de inanılmaz!
Dialogue: 0,0:31:42.12,0:31:46.33,Main,Fishman,0,0,0,,Sadece on kişiler ama yüz bin kişilik orduya karşı hiçbir şeymiş gibi savaşıyorlar!
Dialogue: 0,0:31:46.33,0:31:47.73,Main,Fishman,0,0,0,,Hasır Şapka!
Dialogue: 0,0:31:47.73,0:31:49.08,Main,Fishman,0,0,0,,Sana güveniyoruz!
Dialogue: 0,0:31:49.08,0:31:50.83,Main,Fishman,0,0,0,,Patron Jinbe!
Dialogue: 0,0:31:51.99,0:31:53.88,Main,Hody,0,0,0,,Kendilerini bir şey sanıyorlar.
Dialogue: 0,0:31:57.77,0:31:59.55,Main,Hody,0,0,0,,{\i1}Gel, Kraken!
Dialogue: 0,0:32:27.08,0:32:29.34,Main,Pappagg,0,0,0,,Dev gibi!
Dialogue: 0,0:32:31.52,0:32:34.57,Main,Hody,0,0,0,,Sadece on kişiler. Ez hepsini!
Dialogue: 0,0:32:34.57,0:32:37.17,Main,Hody,0,0,0,,Böylece bitecek!
Dialogue: 0,0:32:39.84,0:32:43.40,Main,Fishman,0,0,0,,Olamaz! Efsanevi canavar, Kraken'i çağırdı!
Dialogue: 0,0:32:43.40,0:32:44.57,Main,Fishman,0,0,0,,Çekilin!
Dialogue: 0,0:32:49.67,0:32:54.93,Main,Fishman,0,0,0,,Hasır Şapkalar ne kadar güçlü olsa da,\No şey onları ezerse kesin ölürler!
Dialogue: 0,0:32:54.93,0:32:59.72,Main,Pirate,0,0,0,,Evet, Kraken bu! O kaptanın kölesi!
Dialogue: 0,0:32:59.72,0:33:01.46,Main,Pirate,0,0,0,,O aşırı güçlü!
Dialogue: 0,0:33:02.33,0:33:05.41,Main,Pirate,0,0,0,,Derin deniz canavarlarının ne kadar korkunç olduklarını görün!
Dialogue: 0,0:33:06.38,0:33:08.20,Main,Sanji,0,0,0,,Hey, o...
Dialogue: 0,0:33:12.50,0:33:14.08,Main,Hody,0,0,0,,Ne yapıyorsun?!
Dialogue: 0,0:33:16.21,0:33:21.42,Main,Hody,0,0,0,,Oyalanma. \NSeni buraya Kuzey Kutbu'ndan getirdim!
Dialogue: 0,0:33:21.42,0:33:23.09,Main,Hody,0,0,0,,Benim kölemsin!
Dialogue: 0,0:33:23.55,0:33:25.93,Main,Hody,0,0,0,,Efendine hizmet et!
Dialogue: 0,0:33:28.63,0:33:30.39,Main,Hody,0,0,0,,Yapabilirsin değil mi?!
Dialogue: 0,0:33:46.44,0:33:48.83,Main,Brook,0,0,0,,B-B-Bekle lütfen!
Dialogue: 0,0:33:50.42,0:33:52.38,Main,Chopper,0,0,0,,Geri çekilin!
Dialogue: 0,0:33:52.38,0:33:54.19,Main,Luffy,0,0,0,,Hey, Surume!
Dialogue: 0,0:33:55.02,0:33:57.05,Main,Luffy,0,0,0,,Benim, ben!
Dialogue: 0,0:33:57.05,0:34:01.54,Main,Luffy,0,0,0,,Seni önceden evcil hayvanım yapmıştım. \NArkadaşız değil mi?
Dialogue: 0,0:34:05.47,0:34:06.68,Main,Pirate,0,0,0,,Başardı!
Dialogue: 0,0:34:06.94,0:34:07.99,Main,Shirahoshi,0,0,0,,Luffy-sama!
Dialogue: 0,0:34:15.69,0:34:20.09,Main,Luffy,0,0,0,,Gıdıklıyor! K-Kes şunu, Surume!
Dialogue: 0,0:34:20.94,0:34:21.98,Main,Pirate,0,0,0,,Ne?!
Dialogue: 0,0:34:25.29,0:34:29.06,Main,Luffy,0,0,0,,Pekala... Surume! Hadi gidelim!
Dialogue: 0,0:34:35.12,0:34:37.54,Main,Pirate,0,0,0,,Kraken bize ihanet etti!
Dialogue: 0,0:34:42.55,0:34:45.04,Main,Pirate,0,0,0,,{\i1}Dur, Kraken!
Dialogue: 0,0:34:45.04,0:34:47.97,Main,Pirate,0,0,0,,{\i1}Aptal ahtapot!
Dialogue: 0,0:34:51.58,0:34:53.64,Main,Luffy,0,0,0,,Hadi, Surume!
Dialogue: 0,0:34:55.13,0:34:57.22,Main,Pirate,0,0,0,,Yardım et... Kaptan...
Dialogue: 0,0:34:57.67,0:35:00.00,Main,Luffy,0,0,0,,Kraken, o tarafa!
Dialogue: 0,0:35:01.48,0:35:04.35,Main,Pirate,0,0,0,,Lanet olsun, neler oluyor?!
Dialogue: 0,0:35:04.35,0:35:08.12,Main,Pirate,0,0,0,,Kraken, Hasır Şapka'ya arkadaşça davranıyor!
Dialogue: 0,0:35:12.94,0:35:16.87,Main,Luffy,0,0,0,,Dinle, Surume.\NSen burada kal ve Zayıf-hoshi'yi koru!
Dialogue: 0,0:35:30.33,0:35:33.87,Main,Jinbe,0,0,0,,Kraken'le bile arkadaş olduğuna inanamıyorum.
Dialogue: 0,0:35:33.87,0:35:38.47,Main,Jinbe,0,0,0,,Başkalarıyla olan ilişkilerin hep beni şaşırtmıştır!
Dialogue: 0,0:35:38.47,0:35:39.47,Main,Luffy,0,0,0,,Öyle mi?
Dialogue: 0,0:35:39.47,0:35:43.31,Main,Shirahoshi,0,0,0,,Ah... Sizinle tanıştığıma çok memnun oldum, Surume-sama.
Dialogue: 0,0:35:51.61,0:35:54.74,Main,Luffy,0,0,0,,Onlardan hala çok var.
Dialogue: 0,0:35:59.81,0:36:02.41,Main,Luffy,0,0,0,,Pekala! Gidelim!
Dialogue: 0,0:00:02.99,0:00:08.38,Main,,0,0,0,,Dünyanın sunabileceği her şeyi elde eden adam, Korsanlar Kralı Gold Roger.
Dialogue: 0,0:00:08.38,0:00:13.00,Main,,0,0,0,,Son sözleri dünyanın her yerinden\Nmaceracıları denize çekti.
Dialogue: 0,0:00:13.00,0:00:14.68,Main,,0,0,0,,"Hazinem mi?"
Dialogue: 0,0:00:14.68,0:00:16.22,Main,,0,0,0,,"İstiyorsanız, size vereceğim!"
Dialogue: 0,0:00:16.22,0:00:17.42,Main,,0,0,0,,"Arayın ve bulun!"
Dialogue: 0,0:00:17.42,0:00:19.87,Main,,0,0,0,,"Bu dünyanın sunabileceği her şeyi orada bıraktım!"
Dialogue: 0,0:00:19.87,0:00:22.69,Main,,0,0,0,,Korsanlar hayallerinin peşinden yola çıktılar!
Dialogue: 0,0:00:22.69,0:00:25.35,Main,,0,0,0,,Dünya, Büyük Korsan Çağı'na girdi!
Dialogue: 0,0:00:25.35,0:00:29.31,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪
Dialogue: 0,0:00:29.31,0:00:33.81,We Go lyrics,,0,0,0,,♪ Şafak vakti gelmedi bile ve ben bekleyemiyorum! ♪
Dialogue: 0,0:00:33.81,0:00:37.48,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı, dört... Gidelim! ♪
Dialogue: 0,0:00:38.97,0:00:43.05,We Go lyrics,,0,0,0,,♪ Bayrağımızı dalgalandıralım, macera şafağının doğuşuna. ♪
Dialogue: 0,0:00:44.41,0:00:49.74,We Go lyrics,,0,0,0,,♪ Dalgalar yapalım, bizi uykumuzdan kaldırsınlar. ♪
Dialogue: 0,0:00:49.74,0:00:54.28,We Go lyrics,,0,0,0,,♪ Eğer inanılmaz bir dünyaya gitmek istiyorsan,
Dialogue: 0,0:00:54.28,0:00:58.79,We Go lyrics,,0,0,0,, gerekli olan şey senin dayanıklılığın. ♪
Dialogue: 0,0:00:59.11,0:01:01.73,We Go lyrics,,0,0,0,,♪ Fazla dikkat çekmek, bu bir suç mu? ♪
Dialogue: 0,0:01:01.73,0:01:04.62,We Go lyrics,,0,0,0,,♪ Aranıyor → Kazanan demektir! ♪
Dialogue: 0,0:01:04.62,0:01:10.50,We Go lyrics,,0,0,0,,♪ Özgür olmak bizim tek kuralımız! ♪
Dialogue: 0,0:01:10.50,0:01:15.99,We Go lyrics,,0,0,0,,♪ Endişelerinizi unutun, bırakın rüzgar essin. ♪
Dialogue: 0,0:01:15.99,0:01:18.53,We Go lyrics,,0,0,0,,♪ Ne pahasına olursa olsun, One Piece'i ilk biz bulacağız! ♪
Dialogue: 0,0:01:18.53,0:01:22.66,We Go lyrics,,0,0,0,,♪ Hayal kuran kalplerimiz, çok büyük... ♪
Dialogue: 0,0:01:22.66,0:01:26.93,We Go lyrics,,0,0,0,,♪ Onları uyandırmamak önemli. ♪
Dialogue: 0,0:01:26.93,0:01:29.57,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪
Dialogue: 0,0:01:29.57,0:01:33.54,We Go lyrics,,0,0,0,,♪ Şafak vakti gelmedi bile ve ben bekleyemiyorum! ♪
Dialogue: 0,0:01:33.54,0:01:37.33,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı, dört... Gidelim! ♪
Dialogue: 0,0:01:38.76,0:01:44.72,We Go lyrics,,0,0,0,,♪ Biz... buralara kadar geldik. ♪
Dialogue: 0,0:01:44.72,0:01:47.62,We Go lyrics,,0,0,0,,♪ Gideceğiz... hayallerimizin olduğu yere,
Dialogue: 0,0:01:47.62,0:01:52.70,We Go lyrics,,0,0,0,, ve kimseyi arkada bırakmayacağız. ♪
Dialogue: 0,0:01:52.70,0:01:55.30,We Go lyrics,,0,0,0,,♪ Hep devam edeceğiz, bu bir söz. ♪
Dialogue: 0,0:01:55.30,0:01:59.47,We Go lyrics,,0,0,0,,♪ Hayallerimizin başladığı o günden beri,
Dialogue: 0,0:01:59.47,0:02:03.72,We Go lyrics,,0,0,0,, belirlediğimiz gelecek, değişmedi! ♪
Dialogue: 0,0:02:03.72,0:02:06.24,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪
Dialogue: 0,0:02:06.24,0:02:10.61,We Go lyrics,,0,0,0,,♪ Kalbimdeki güneş, asla batmayacak! ♪
Dialogue: 0,0:02:10.61,0:02:13.38,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... ♪
Dialogue: 0,0:02:14.78,0:02:17.57,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... ♪
Dialogue: 0,0:02:18.75,0:02:24.82,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... dört... Gidelim! ♪
Dialogue: 0,0:02:27.27,0:02:29.67,We Go lyrics,,0,0,0,,♪ Gidelim! ♪
