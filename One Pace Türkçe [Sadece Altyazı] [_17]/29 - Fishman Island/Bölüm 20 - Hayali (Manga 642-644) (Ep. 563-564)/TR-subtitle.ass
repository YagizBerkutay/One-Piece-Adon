D221E,&H00000000,0,0,0,0,100,100,0,0,1,0.5,0,2,10,10,10,1Style: We Go lyrics,Duality,40.0,&H0098594E,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2.0,0,8,10,10,16,1Style: Author,Impress BT,20.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.7,0.7,9,10,10,10,1Style: Attack,Duality,32.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.0,1.0,7,12,12,12,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:02:30.12,0:02:31.49,Main,Narrator & On-screen text,0,0,0,,Noah'ın düşmeye başlamasından önce...Dialogue: 0,0:02:31.49,0:02:33.53,Main,Narrator & On-screen text,0,0,0,,Noah'ın düşmeye başlamasından önce...Dialogue: 0,0:02:33.53,0:02:34.64,Main,Narrator & On-screen text,0,0,0,,Noah'ın düşmeye başlamasından önce...Dialogue: 0,0:02:39.83,0:02:42.73,Main,Wadatsumi,0,0,0,,Şimdi kızdım işte!Dialogue: 0,0:02:45.83,0:02:48.95,Main,Wadatsumi,0,0,0,,Bekle ve gör!Dialogue: 0,0:02:48.94,0:02:53.27,Attack,Wadatsumi,0,0,0,,Sinirli Mega Keşiş!Dialogue: 0,0:03:00.97,0:03:03.31,Main,Pirate,0,0,0,,Zaten kocamandı.Dialogue: 0,0:03:13.30,0:03:14.64,Main,Sanji,0,0,0,,Bu yaptığının bir anlamı var mı?Dialogue: 0,0:03:16.81,0:03:18.66,Main,Wadatsumi,0,0,0,,Nasıl? Şaşırdın mı?Dialogue: 0,0:03:19.73,0:03:21.94,Main,Wadatsumi,0,0,0,,Ben, kaplan balon balığı Balık Adam'ım.Dialogue: 0,0:03:22.47,0:03:24.16,Main,Wadatsumi,0,0,0,,Korktun mu?Dialogue: 0,0:03:24.16,0:03:27.94,Main,Sanji,0,0,0,,Hiç de bile.  Hem niye hızlı konuşuyorsun ki?Dialogue: 0,0:03:27.94,0:03:31.07,Main,Wadatsumi,0,0,0,,Hızlı konuşmazsam içimdeki havayı kaçırırım.Dialogue: 0,0:03:32.45,0:03:34.37,Main,Sanji,0,0,0,,Kraken senden daha büyük.Dialogue: 0,0:03:34.37,0:03:37.95,Main,Wadatsumi,0,0,0,,Ne?! Bu nasıl peki?!Dialogue: 0,0:03:37.95,0:03:39.44,Main,Wadatsumi,0,0,0,,Balon balığı!Dialogue: 0,0:03:39.44,0:03:40.44,Main,Pirate,0,0,0,,Dikkat et!Dialogue: 0,0:03:40.44,0:03:41.68,Main,Pirate,0,0,0,,Ezilmek istemiyorum!Dialogue: 0,0:03:41.68,0:03:42.85,Main,Pirate,0,0,0,,Yardım edin!Dialogue: 0,0:03:42.85,0:03:44.71,Main,Pirate,0,0,0,,Hey, Wadatsumi-san, yapma!Dialogue: 0,0:03:44.71,0:03:47.72,Main,Pirate,0,0,0,,Yandaşlarını eziyorsun.Dialogue: 0,0:03:47.72,0:03:49.88,Main,Sanji,0,0,0,,Kraken'den hâlâ küçüksün.Dialogue: 0,0:03:49.88,0:03:54.48,Main,Wadatsumi,0,0,0,,Ne?! Buna ne diyeceksin bakalım?!Dialogue: 0,0:03:54.48,0:03:57.10,Main,Pirate,0,0,0,,Yeter!Dialogue: 0,0:04:01.95,0:04:03.77,Main,Left Minister,0,0,0,,Kral'ım!Dialogue: 0,0:04:04.21,0:04:06.92,Main,Left Minister,0,0,0,,İyi misiniz?!Dialogue: 0,0:04:08.02,0:04:12.62,Main,Left Minister,0,0,0,,Sizi koruyamadığımız için özür dilerim.Dialogue: 0,0:04:12.62,0:04:15.62,Main,Left Minister,0,0,0,,İşe yaramaz bir grup adamız.Dialogue: 0,0:04:15.62,0:04:19.54,Main,Neptune,0,0,0,,Önemli değil.  Onu geç de Noah'ı gördünüz mü?Dialogue: 0,0:04:19.54,0:04:20.66,Main,Left Minister,0,0,0,,Evet.Dialogue: 0,0:04:20.66,0:04:23.76,Main,Neptune,0,0,0,,Hareket ettiğine inanamıyorum.Dialogue: 0,0:04:24.50,0:04:29.08,Main,Neptune,0,0,0,,Kahrolası Decken! Noah, Prenses'e ve adaya çarpsaydı...Dialogue: 0,0:04:29.08,0:04:32.30,Main,Neptune,0,0,0,,...her şey biterdi-jamonDialogue: 0,0:04:32.30,0:04:38.25,Main,Left Minister,0,0,0,,Neler olduğunu bilmediğimizden tüm halka tahliye çağrısı yaptık ama...Dialogue: 0,0:04:38.25,0:04:44.41,Main,Left Minister,0,0,0,,...bütün haberleşme merkezleri Yeni Balık Adam Korsanları'nın eline geçmiş.Dialogue: 0,0:04:44.80,0:04:48.98,Main,Left Minister,0,0,0,,Denizdeki sınır korumalarına da ulaşmaya çalıştık ama...Dialogue: 0,0:04:50.75,0:04:52.48,Main,Soldier,0,0,0,,Baloncuğu göndermeye hazırlanın.Dialogue: 0,0:04:52.48,0:04:53.02,Main,Soldier,0,0,0,,Acele edin!Dialogue: 0,0:04:58.57,0:05:00.40,Main,Left Minister,0,0,0,,Neden açmıyorlar?Dialogue: 0,0:05:00.40,0:05:03.40,Main,Left Minister,0,0,0,,Neyse, Kral'ımızı güvenli bir yere götürün.Dialogue: 0,0:05:03.40,0:05:04.42,Main,Neptune,0,0,0,,Hayır.Dialogue: 0,0:05:05.67,0:05:08.48,Main,Neptune,0,0,0,,Prenslerimi bekleyeceğim.Dialogue: 0,0:05:18.17,0:05:19.76,Main,Right Minister,0,0,0,,Ne demek oluyor bunlar?Dialogue: 0,0:05:22.52,0:05:25.14,Main,Right Minister,0,0,0,,Neler olduğunu anlatın.Dialogue: 0,0:05:25.91,0:05:28.23,Main,Right Minister,0,0,0,,Neden bu kadar çok korsan var?!Dialogue: 0,0:05:28.62,0:05:29.98,Main,Citizen,0,0,0,,Şeyy...Dialogue: 0,0:05:36.90,0:05:39.20,Main,Right Minister,0,0,0,,Hasır Şapka tayfası!Dialogue: 0,0:05:42.11,0:05:43.67,Main,Right Minister,0,0,0,,Jinbe...Dialogue: 0,0:05:44.23,0:05:45.41,Main,Right Minister,0,0,0,,Prenses mi?!Dialogue: 0,0:05:46.65,0:05:49.22,Main,Right Minister,0,0,0,,Hody... Decken...Dialogue: 0,0:05:49.75,0:05:51.39,Main,Right Minister,0,0,0,,Demek bunlar oldu...Dialogue: 0,0:05:55.05,0:05:58.39,Main,Right Minister,0,0,0,,Pekâlâ. Her şeyi anladım.Dialogue: 0,0:06:00.11,0:06:02.10,Main,Right Minister,0,0,0,,Askerler. Plazaya girin.Dialogue: 0,0:06:02.10,0:06:05.58,Main,Right Minister,0,0,0,,Jinbei ve Hasır Şapka tayfasına destek olun.Dialogue: 0,0:06:07.59,0:06:12.60,Main,Right Minister,0,0,0,,Güçlülerin icabına baksalar yeter, geri kalanlar sıradan savaşçı.Dialogue: 0,0:06:12.60,0:06:17.24,Main,Right Minister,0,0,0,,Suçladığımız ve güvenmediğimiz korsanlar ülkemizi koruyor.Dialogue: 0,0:06:17.24,0:06:20.53,Main,Right Minister,0,0,0,,Kendimizden utanmalıyız.Dialogue: 0,0:06:20.53,0:06:24.77,Main,Right Minister,0,0,0,,En azından onlara destek olalım!Dialogue: 0,0:06:24.77,0:06:26.00,Main,Soldier,0,0,0,,Emredersiniz!Dialogue: 0,0:06:26.44,0:06:27.87,Main,Pirate,0,0,0,,Neptune Ordusu.Dialogue: 0,0:06:27.87,0:06:30.15,Main,Pirate,0,0,0,,Onları biz yenebiliriz.Dialogue: 0,0:06:30.15,0:06:31.00,Main,Pirate,0,0,0,,Hepsini gebertin!Dialogue: 0,0:06:31.00,0:06:33.84,Main,Soldier,0,0,0,,Gücümüzü gösterme zamanı geldi.Dialogue: 0,0:06:37.63,0:06:39.60,Main,Hammond,0,0,0,,İlerle, Köle Tankı!Dialogue: 0,0:06:39.94,0:06:41.45,Main,Hammond,0,0,0,,Şu tarafa gidin!Dialogue: 0,0:06:45.62,0:06:46.66,Main,Hammond,0,0,0,,Bak sen.Dialogue: 0,0:06:46.66,0:06:50.06,Main,Hammond,0,0,0,,İşe yaramaz herif. Çekin.Dialogue: 0,0:06:52.47,0:06:55.13,Main,Hammond,0,0,0,,Ezik!Dialogue: 0,0:06:55.27,0:06:56.46,Main,Robin,0,0,0,,Korkunç.Dialogue: 0,0:06:56.80,0:06:58.64,Main,Jinbe,0,0,0,,Nico Robin.Dialogue: 0,0:06:59.51,0:07:02.15,Main,Jinbe,0,0,0,,O insan köleleri özgürleştirebilir misin?Dialogue: 0,0:07:02.58,0:07:06.28,Main,Robin,0,0,0,,Sorun olmasın?  Balık Adam Adası'na kin tuttuklarına eminim.Dialogue: 0,0:07:06.28,0:07:10.33,Main,Jinbe,0,0,0,,O insanlar bana karşı gelirse hepsini öldürürüm.Dialogue: 0,0:07:10.33,0:07:14.90,Main,Jinbe,0,0,0,,Ama şu an zaten insan bile değiller.Dialogue: 0,0:07:14.90,0:07:20.57,Main,Jinbe,0,0,0,,Hody'gilin Kutsal Ejderlerin yaptığını yapmasına dayanamıyorum.Dialogue: 0,0:07:20.57,0:07:22.62,Main,Robin,0,0,0,,Tamam, bana bırak.Dialogue: 0,0:07:22.62,0:07:24.00,Main,Jinbe,0,0,0,,Teşekkürler.Dialogue: 0,0:07:33.58,0:07:35.67,Main,Pirate,0,0,0,,Kelepçeler çözüldü.Dialogue: 0,0:07:35.67,0:07:37.25,Main,Pirate,0,0,0,,Hey, n'apıyorsunuz?!Dialogue: 0,0:07:37.25,0:07:40.17,Main,Pirate,0,0,0,,Köleleri kim serbest bıraktı?!Dialogue: 0,0:07:42.57,0:07:44.79,Main,Hammond,0,0,0,,Neyiniz var, köleler!Dialogue: 0,0:07:44.79,0:07:45.62,Main,Pirate,0,0,0,,Kelepçeler...Dialogue: 0,0:07:45.62,0:07:46.76,Main,Pirate,0,0,0,,Sen mi açtın?Dialogue: 0,0:07:46.76,0:07:48.72,Main,Pirate,0,0,0,,Bizi neden kurtardın?Dialogue: 0,0:07:49.74,0:07:52.23,Main,Robin,0,0,0,,Yakışıklı bir adamı reddedemedim.Dialogue: 0,0:07:52.23,0:07:54.51,Main,Robin,0,0,0,,Patron Jinbe'ye teşekkür edin.Dialogue: 0,0:07:54.97,0:07:56.77,Main,Pirate,0,0,0,,Jinbe mi istedi?Dialogue: 0,0:07:56.77,0:07:59.22,Main,Hammond,0,0,0,,İşime burnunu sokuyorsun.Dialogue: 0,0:08:05.81,0:08:06.73,Main,Hammond,0,0,0,,Yakaladım!Dialogue: 0,0:08:15.77,0:08:17.95,Main,Hammond,0,0,0,,Sırtıma nasıl geçtin?!Dialogue: 0,0:08:22.84,0:08:24.45,Main,Hammond,0,0,0,,Bu...Dialogue: 0,0:08:24.45,0:08:26.92,Main,Robin,0,0,0,,Uzun sürmeyecek. Rahat ol.Dialogue: 0,0:08:28.09,0:08:30.13,Main,Hammond,0,0,0,,Bırak beni. Nesin sen?!Dialogue: 0,0:08:30.13,0:08:32.71,Main,Hammond,0,0,0,,Sen! Nasıl iki kişi olabiliyorsun?!Dialogue: 0,0:08:41.02,0:08:42.19,Main,Pirate,0,0,0,,Hammond-san!Dialogue: 0,0:08:42.19,0:08:43.64,Main,Pirate,0,0,0,,Kaltak!Dialogue: 0,0:08:45.31,0:08:47.41,Main,Pirate,0,0,0,,Teşekkürler, bayan.Dialogue: 0,0:08:47.41,0:08:49.58,Main,Pirate,0,0,0,,Bunu bize yapmaya nasıl cüret edersiniz?!Dialogue: 0,0:08:49.58,0:08:52.77,Main,Pirate,0,0,0,,Siz ucubelere karşı kaybetmeyeceğiz!Dialogue: 0,0:08:52.77,0:08:54.99,Main,Pirate,0,0,0,,İnsan köleler...Dialogue: 0,0:08:54.99,0:08:57.70,Main,Pirate,0,0,0,,...isyan ediyor.Dialogue: 0,0:09:11.96,0:09:16.09,Main,Soldier,0,0,0,,Ben sınır korumayım. Siz misiniz, Sol Bakan'ım?Dialogue: 0,0:09:16.11,0:09:18.60,Main,Soldier,0,0,0,,Lütfen tüm krallığı uyarın.Dialogue: 0,0:09:18.60,0:09:22.37,Main,Soldier,0,0,0,,Devasa gemi Noah, gücünü kaybederek...Dialogue: 0,0:09:22.37,0:09:26.63,Main,Soldier,0,0,0,,...tekrar adaya düşmeye başladı.Dialogue: 0,0:09:29.12,0:09:30.21,Main,Left Minister,0,0,0,,Ne?!Dialogue: 0,0:09:30.21,0:09:32.63,Main,Neptune,0,0,0,,Noah tekrar mı düşüyor?Dialogue: 0,0:09:32.63,0:09:34.66,Main,Left Minister,0,0,0,,Şu an neredesiniz?Dialogue: 0,0:09:34.66,0:09:36.55,Main,Soldier,0,0,0,,Hava Tankı kontrol kulesinde.Dialogue: 0,0:09:36.55,0:09:41.34,Main,Left Minister,0,0,0,,Güzel.  Öyleyse, tehlikeyi halka siz bildirin.Dialogue: 0,0:09:41.34,0:09:44.28,Main,Left Minister,0,0,0,,Adadaki hiçbir haberleşme merkezi çalışmıyor.Dialogue: 0,0:09:44.28,0:09:50.09,Main,Left Minister,0,0,0,,Oradan ülkedeki tüm Den Den Mushilere ulaşabilirsiniz.Dialogue: 0,0:09:50.09,0:09:50.99,Main,Left Minister,0,0,0,,Acele edin!Dialogue: 0,0:09:50.99,0:09:52.16,Main,Soldier,0,0,0,,Emredersiniz!Dialogue: 0,0:09:57.74,0:10:02.61,Main,Voice,0,0,0,,Adanın üzerindeki Hava Tankı'ndan krallık vatandaşlarına.Dialogue: 0,0:10:02.61,0:10:05.10,Main,Voice,0,0,0,,Acil tahliye emri verildi.Dialogue: 0,0:10:05.10,0:10:07.81,Main,Voice,0,0,0,,Devasa gemi Noah, tekrar adaya düşüyor.Dialogue: 0,0:10:08.68,0:10:11.74,Main,Voice,0,0,0,,Lütfen bir an önce adayı terkedin.Dialogue: 0,0:10:11.74,0:10:13.47,Main,Citizen,0,0,0,,Baloncuk parçalanacak.Dialogue: 0,0:10:13.47,0:10:15.82,Main,Citizen,0,0,0,,Ada yok olacak.Dialogue: 0,0:10:16.94,0:10:19.35,Main,Citizen,0,0,0,,Acele et. Çantanı falan bırak şimdi!Dialogue: 0,0:10:19.35,0:10:20.48,Main,Citizen,0,0,0,,Ama...Dialogue: 0,0:10:20.64,0:10:25.69,Main,Citizen,0,0,0,,Denize kaçın. Herkes adadan kaçsın.Dialogue: 0,0:10:26.14,0:10:28.74,Main,Nami,0,0,0,,Olamaz. O şey geri mi geliyor?!Dialogue: 0,0:10:28.74,0:10:31.08,Main,Usopp,0,0,0,,Başımıza bir şey gelmesin, Luffy?Dialogue: 0,0:10:31.46,0:10:34.51,Main,Jinbe,0,0,0,,Prenses Shirahoshi'ye ne oldu?Dialogue: 0,0:10:34.51,0:10:37.68,Main,Pirate,0,0,0,,Yine mi Decken?! Manyak korsan!Dialogue: 0,0:10:37.68,0:10:40.25,Main,Pirate,0,0,0,,Biz de kaçmalıyız. Çok tehlikeli.Dialogue: 0,0:10:43.79,0:10:46.21,Main,Right Minister,0,0,0,,Hodyler'i bize bırakın.Dialogue: 0,0:10:46.21,0:10:50.73,Main,Right Minister,0,0,0,,Buradaki herkes hemen adayı terketsin.Dialogue: 0,0:10:54.54,0:10:55.37,Main,Child,0,0,0,,Olmaz!Dialogue: 0,0:10:57.56,0:11:01.63,Main,Right Minister,0,0,0,,Ne? Özellikle kadın ve çocuklar.Dialogue: 0,0:11:01.63,0:11:02.91,Main,Right Minister,0,0,0,,Gidin!Dialogue: 0,0:11:03.06,0:11:08.87,Main,Child,0,0,0,,İnsan olan korsan Hasır Şapka tayfası ada için savaşıyor.Dialogue: 0,0:11:08.87,0:11:12.19,Main,Child,0,0,0,,Onların gözü önünde kaçıp gitmeyiz.Dialogue: 0,0:11:12.94,0:11:17.70,Main,Citizen,0,0,0,,Haklı. Yardımı biz istedik üstelik!Dialogue: 0,0:11:17.70,0:11:21.02,Main,Citizen,0,0,0,,Onlarla aynı kaderi paylaşmaktan başka bir şey yapmam.Dialogue: 0,0:11:21.02,0:11:22.37,Main,Citizen,0,0,0,,Ben de.Dialogue: 0,0:11:22.37,0:11:23.58,Main,Citizen,0,0,0,,Ben de, Sağ Bakan'ım!Dialogue: 0,0:11:24.71,0:11:26.30,Main,Right Minister,0,0,0,,Susun!Dialogue: 0,0:11:26.97,0:11:29.54,Main,Right Minister,0,0,0,,Bakın, işte göreviniz.Dialogue: 0,0:11:29.54,0:11:35.46,Main,Right Minister,0,0,0,,Söylediklerimi buradaki herkese duyurun.Dialogue: 0,0:11:35.46,0:11:36.82,Main,Right Minister,0,0,0,,Anlaşıldı mı?Dialogue: 0,0:11:38.70,0:11:41.27,Main,Right Minister,0,0,0,,Herkesin kendi sebebi ve düşüncesi vardır.Dialogue: 0,0:11:41.27,0:11:44.51,Main,Right Minister,0,0,0,,Kalmak isteyen varsa kendi bilir.Dialogue: 0,0:11:48.85,0:11:52.02,Main,Right Minister,0,0,0,,Gelin bakalım, kanunsuzlar!Dialogue: 0,0:11:58.50,0:12:00.24,Main,Soldier,0,0,0,,Hasır Şapka Luffy-san.Dialogue: 0,0:12:01.45,0:12:04.09,Main,Soldier,0,0,0,,Burası Hava Tankı.Dialogue: 0,0:12:04.09,0:12:06.57,Main,Soldier,0,0,0,,Biraz önce görüşmüştük.Dialogue: 0,0:12:07.63,0:12:10.72,Main,Citizen,0,0,0,,Hasır Şapka mı? Ne yayınlıyorlar öyle?Dialogue: 0,0:12:10.72,0:12:14.64,Main,Soldier,0,0,0,,Orada yaşananları dinliyoruz.Dialogue: 0,0:12:14.64,0:12:18.60,Main,Soldier,0,0,0,,Noah'ın adaya düşüşünü de görüyoruz.Dialogue: 0,0:12:19.51,0:12:22.60,Main,Shirahoshi,0,0,0,,Luffy-sama. Noah konusunda ne yapacağız?Dialogue: 0,0:12:22.60,0:12:28.15,Main,Left Minister,0,0,0,,N'apıyorlar öyle?!  Konuşmaları tüm ülke tarafından dinleniyor.Dialogue: 0,0:12:28.15,0:12:32.22,Main,Neptune,0,0,0,,Shirahoshi! Hasır Şapka!Dialogue: 0,0:12:32.22,0:12:36.59,Main,Soldier,0,0,0,,Kalan her şeyde size güveniyoruz.Dialogue: 0,0:12:36.59,0:12:39.23,Main,Luffy,0,0,0,,Zor konuları geçin de yapın artık.Dialogue: 0,0:12:39.23,0:12:42.63,Main,Chopper,0,0,0,,Luffy'nin sesi. Çok şükür.Dialogue: 0,0:12:42.63,0:12:45.46,Main,Citizen,0,0,0,,Ne konuşuyorlar öyle?Dialogue: 0,0:12:45.46,0:12:47.68,Main,Citizen,0,0,0,,Prenses-sama'nın da sesini duydum.Dialogue: 0,0:12:47.68,0:12:50.59,Main,Citizen,0,0,0,,Hasır Şapka kızları kaçırmıyor muydu?Dialogue: 0,0:12:50.59,0:12:51.80,Main,Citizen,0,0,0,,Bir insan o.Dialogue: 0,0:12:53.38,0:12:57.30,Main,Soldier,0,0,0,,Luffy-san, lütfen adayı kurtar!Dialogue: 0,0:12:57.30,0:13:02.35,Main,Citizen,0,0,0,,Sınır koruma,  neden bir insan korsana güveniyor ki?Dialogue: 0,0:13:02.35,0:13:05.22,Main,Citizen,0,0,0,,Bir planı falan mı var?Dialogue: 0,0:13:05.22,0:13:07.78,Main,Citizen,0,0,0,,Noah'ı bir insan mı durduracak?Dialogue: 0,0:13:12.75,0:13:14.95,Main,Fukaboshi,0,0,0,,Hey, Hasır Şapka.Dialogue: 0,0:13:16.50,0:13:17.20,Main,Fukaboshi,0,0,0,,Duyuyor musun?Dialogue: 0,0:13:18.87,0:13:20.38,Main,Right Minister,0,0,0,,Prens Fukaboshi!Dialogue: 0,0:13:20.38,0:13:23.59,Main,Right Minister,0,0,0,,Hody Jones'un...Dialogue: 0,0:13:26.23,0:13:29.02,Main,Right Minister,0,0,0,,...gerçek kimliğini öğrendim.Dialogue: 0,0:13:29.44,0:13:32.72,Main,Luffy,0,0,0,,Abi-hoshi!   Ne demek istiyorsun?!Dialogue: 0,0:13:33.84,0:13:35.99,Main,Fukaboshi,0,0,0,,Hody...Dialogue: 0,0:13:36.15,0:13:38.72,Main,Fukaboshi,0,0,0,,...doğamızın doğurduğu bir canavar.Dialogue: 0,0:13:39.88,0:13:45.95,Main,Fukaboshi,0,0,0,,Yeni Balık Adam Korsanları,  antik nefretin doğurduğu bir grup canavar.Dialogue: 0,0:13:52.21,0:13:56.96,Main,Fukaboshi,0,0,0,,Nefret, Balık Adam Adası'nın gölgesindeki atalarından doğmuş.Dialogue: 0,0:13:56.96,0:13:59.30,Main,Fukaboshi,0,0,0,,İnsanlara karşı olan bu nefretlerinin...Dialogue: 0,0:14:00.84,0:14:04.62,Main,Fukaboshi,0,0,0,,...ve kızgınlıklarının unutulacağından korkuyorlar.Dialogue: 0,0:14:05.33,0:14:06.92,Main,Fukaboshi,0,0,0,,Bu yüzden bu kadar sabırsızlar.Dialogue: 0,0:14:07.93,0:14:14.60,Main,Fukaboshi,0,0,0,,Bu uğurda yaptıkları savaşta temize çıkmak için insanların kötü olmasını istiyor.Dialogue: 0,0:14:14.99,0:14:17.28,Main,Fukaboshi,0,0,0,,Akan kan görmek istiyorlar...Dialogue: 0,0:14:18.46,0:14:22.11,Main,Fukaboshi,0,0,0,,...ve Balık Adamların huzuru umurlarında bile değil.Dialogue: 0,0:14:33.58,0:14:37.35,Flashbacks,Fukaboshi,0,0,0,,Geçmişte neler yaşadın?!Dialogue: 0,0:14:37.35,0:14:38.86,Flashbacks,Fukaboshi,0,0,0,,Cevap ver, Hody!Dialogue: 0,0:14:38.86,0:14:42.57,Flashbacks,Fukaboshi,0,0,0,,İnsanlar sana ne yaptı?!Dialogue: 0,0:14:48.14,0:14:49.75,Flashbacks,Hody,0,0,0,,Hiçbir şey.Dialogue: 0,0:14:53.04,0:14:55.72,Flashbacks,Fukaboshi,0,0,0,,Hiçbir şey mi dedin?!Dialogue: 0,0:15:00.13,0:15:06.58,Flashbacks,Hody,0,0,0,,Biz cennet tarafından insanları cezalandırmak için seçilen...Dialogue: 0,0:15:09.37,0:15:12.66,Flashbacks,Hody,0,0,0,,...ve güç bahşedilenleriz!Dialogue: 0,0:15:15.94,0:15:17.52,Flashbacks,Fukaboshi,0,0,0,,Anlıyorum.Dialogue: 0,0:15:18.50,0:15:21.14,Flashbacks,Fukaboshi,0,0,0,,Demek öyle.Dialogue: 0,0:15:27.74,0:15:30.80,Main,Fukaboshi,0,0,0,,Onların nefreti...Dialogue: 0,0:15:30.80,0:15:33.81,Main,Fukaboshi,0,0,0,,...deneyimlerine ya da inançlarına bağlı değil.Dialogue: 0,0:15:36.98,0:15:38.87,Main,Fukaboshi,0,0,0,,Onların bir gerçekliği yok!Dialogue: 0,0:15:42.83,0:15:44.94,Main,Fukaboshi,0,0,0,,İçleri tamamen boş!Dialogue: 0,0:15:48.94,0:15:50.90,Main,Fukaboshi,0,0,0,,Onların nefreti...Dialogue: 0,0:15:50.90,0:15:53.69,Main,Fukaboshi,0,0,0,,...deneyimlerine ya da inançlarına bağlı değil.Dialogue: 0,0:15:53.69,0:15:57.38,Main,Fukaboshi,0,0,0,,Onların bir gerçekliği yok! İçleri bomboş!Dialogue: 0,0:15:57.38,0:16:01.16,Main,Citizen,0,0,0,,Boş mu? Ne demek istiyor acaba?Dialogue: 0,0:16:01.16,0:16:04.55,Main,Citizen,0,0,0,,Hey, kaçmanız lazım! Adayı boşaltın!Dialogue: 0,0:16:04.55,0:16:09.44,Main,Citizen,0,0,0,,Noah'nın gölgesi çoktan görünmeye başladı!Dialogue: 0,0:16:14.62,0:16:16.13,Main,Luffy,0,0,0,,Acele et, Zayıf-hoshi!Dialogue: 0,0:16:19.26,0:16:22.95,Main,Shirahoshi,0,0,0,,Hody-sama her zamankinden daha korkunç görünüyor!Dialogue: 0,0:16:27.33,0:16:32.41,Flashbacks,Arlong,0,0,0,,İnsanlar alçaktır.Dialogue: 0,0:16:32.41,0:16:34.95,Flashbacks,Arlong,0,0,0,,Unutma, Hody.Dialogue: 0,0:16:34.95,0:16:39.21,Flashbacks,Arlong,0,0,0,,İnsanlar kötüdür.Dialogue: 0,0:16:42.04,0:16:45.67,Main,Citizen,0,0,0,,Olmaz olsun! Lanetlendik!Dialogue: 0,0:16:45.67,0:16:51.13,Main,Citizen,0,0,0,,Korsanlar Çağı başladığından beri günbegün arkadaşlarımız ölüyor!Dialogue: 0,0:16:51.13,0:16:56.56,Main,Citizen,0,0,0,,İnsanlar genç deniz kızlarını kaçırıp Köle Dükkanı'nda satmış.Dialogue: 0,0:16:56.56,0:17:00.66,Main,Citizen,0,0,0,,Mahvolduk! Balıkadam Adası yıkılacak!Dialogue: 0,0:17:03.69,0:17:05.04,Main,Citizen,0,0,0,,Kahrolasıca insanlar!Dialogue: 0,0:17:05.04,0:17:07.07,Main,Citizen,0,0,0,,Vay canına!Dialogue: 0,0:17:07.07,0:17:09.22,Main,Citizen,0,0,0,,Harika bir şey! Artık bir kahramanımız var!Dialogue: 0,0:17:10.81,0:17:16.43,Main,Citizen,0,0,0,,Kendi canını feda ederek Köle Dükkanı'nı havaya uçurmuş! Saygıyla anın!Dialogue: 0,0:17:24.02,0:17:27.12,Main,Hody,0,0,0,,Layığınızı bulmuşsunuz insanlar!Dialogue: 0,0:17:30.59,0:17:32.21,Main,Daruma,0,0,0,,Harika bir şey!Dialogue: 0,0:17:32.21,0:17:33.23,Main,Zeo,0,0,0,,Evet.Dialogue: 0,0:17:33.23,0:17:35.49,Main,Ikaros,0,0,0,,Kahramanlar çok karizmatik-hi!Dialogue: 0,0:17:35.49,0:17:36.47,Main,Dosun,0,0,0,,Dosun!Dialogue: 0,0:17:41.11,0:17:45.97,Main,Citizen,0,0,0,,Arlong-san bir korsan gemisi daha batırdı!Dialogue: 0,0:17:46.54,0:17:48.80,Main,Arlong,0,0,0,,Bu kutsal bir savaş!Dialogue: 0,0:17:48.80,0:17:51.59,Main,Arlong,0,0,0,,Asırlar evvel adına insan dediğimiz pislikler,...Dialogue: 0,0:17:51.59,0:17:56.04,Main,Arlong,0,0,0,,...biz seçilmiş balık adamları kıskandı ve...Dialogue: 0,0:17:56.04,0:17:58.38,Main,Arlong,0,0,0,,...varlığımızdan korktu.Dialogue: 0,0:17:59.51,0:18:00.71,Main,Arlong,0,0,0,,Ve...Dialogue: 0,0:18:02.15,0:18:04.79,Main,Arlong,0,0,0,,...bize eziyet etmeye karar verdiler.Dialogue: 0,0:18:04.79,0:18:09.12,Main,Arlong,0,0,0,,Dünyadaki tüm insanlar solucanlar gibidirler.Dialogue: 0,0:18:09.12,0:18:16.40,Main,Arlong,0,0,0,,Tek avantajları olan sayısal üstünlüklerini kullanıp bizi deniz tabanına sürdüler.Dialogue: 0,0:18:16.40,0:18:18.37,Main,Arlong,0,0,0,,Dinleyin beni!Dialogue: 0,0:18:18.37,0:18:20.51,Main,Arlong,0,0,0,,İnsanlardan nefret et!Dialogue: 0,0:18:22.96,0:18:28.81,Main,Hachi,0,0,0,,Uzun zamandır tanıdığım Rayleigh adında bir insan var, diğerlerinden farklı!Dialogue: 0,0:18:28.81,0:18:32.06,Main,Hachi,0,0,0,,Beni görünce suratını ekşitmiyor.Dialogue: 0,0:18:32.06,0:18:33.86,Main,Hachi,0,0,0,,Nyuu- Hody?Dialogue: 0,0:18:34.76,0:18:37.10,Main,Hody,0,0,0,,Hikayeni hiç sevmedim, Hachi-san.Dialogue: 0,0:18:38.54,0:18:40.38,Main,Hody,0,0,0,,Midemi kaldırıyor.Dialogue: 0,0:18:40.38,0:18:43.70,Main,Arlong,0,0,0,,İnsanlar korkaktır.Dialogue: 0,0:18:43.70,0:18:46.11,Main,Arlong,0,0,0,,Hınçlarını devralın.Dialogue: 0,0:18:46.11,0:18:47.93,Main,Arlong,0,0,0,,Tamam mı Hody?Dialogue: 0,0:18:47.93,0:18:50.42,Main,Arlong,0,0,0,,Unutma, Hody.Dialogue: 0,0:18:50.42,0:18:55.39,Main,Arlong,0,0,0,,İnsanlar kötüdür, alçaktır.Dialogue: 0,0:18:55.39,0:18:57.51,Main,Arlong,0,0,0,,İnsanlardan nefret et.Dialogue: 0,0:18:57.51,0:19:01.95,Main,Arlong,0,0,0,,Nefret et. Nefret et! Nefret et!Dialogue: 0,0:19:02.67,0:19:06.22,Main,Citizen,0,0,0,,Korkunç bir şey olmuş! Köleleri özgürlüğüne kavuşturan Tiger-san...Dialogue: 0,0:19:06.22,0:19:08.71,Main,Citizen,0,0,0,,...insanlar tarafından öldürülmüş!Dialogue: 0,0:19:08.71,0:19:10.06,Main,Citizen,0,0,0,,Ne?!Dialogue: 0,0:19:10.06,0:19:13.01,Main,Zeo,0,0,0,,Demek seçilmiş olan Tiger değilmiş.Dialogue: 0,0:19:21.19,0:19:24.21,Main,Citizen,0,0,0,,Siz de kimsiniz? Gidin buradan!Dialogue: 0,0:19:24.21,0:19:27.53,Main,Zeo,0,0,0,,İnsanlara kan verdiğini duydum.Dialogue: 0,0:19:27.53,0:19:29.03,Main,Citizen,0,0,0,,Ne olmuş?!Dialogue: 0,0:19:29.03,0:19:31.15,Main,Citizen,0,0,0,,İnsanlardan birisi ölüyord-Dialogue: 0,0:19:35.48,0:19:37.29,Main,Citizen,0,0,0,,Baba!Dialogue: 0,0:19:48.47,0:19:52.45,Main,Hody,0,0,0,,Kraliyet ailesinin üyeleri bile akıllarını kaçırmış.Dialogue: 0,0:19:52.45,0:19:55.40,Main,Hody,0,0,0,,İnsanları affetmemizi istiyor.Dialogue: 0,0:19:56.23,0:19:57.58,Main,Daruma,0,0,0,,Başlatmasın şimdi!Dialogue: 0,0:20:00.68,0:20:04.52,Main,Ikaros,0,0,0,,Jinbe-san'ın  Shichibukai olduğunu duydunuz mu?Dialogue: 0,0:20:04.52,0:20:09.62,Main,Dosun,0,0,0,,Balık adamların arınma hareketini Arlong Korsanları'ndan başkası sürdürmüyor.Dialogue: 0,0:20:14.25,0:20:16.86,Main,Soldier,0,0,0,,Otohime-sama vuruldu!Dialogue: 0,0:20:17.99,0:20:20.14,Main,Citizen,0,0,0,,Gördünüz mü? İnsanlar böyledir işte!Dialogue: 0,0:20:20.85,0:20:26.74,Main,Citizen,0,0,0,,Kraliçe Hazretleri gibi dost canlısı birisine bile merhamet etmezler.Dialogue: 0,0:20:26.74,0:20:30.43,Main,Citizen,0,0,0,,Kraliyet ailesi intikam alma yürekliliğini göstermezse...Dialogue: 0,0:20:30.43,0:20:33.83,Main,Citizen,0,0,0,,...bu ülkeye güvenimiz falan kalmaz!Dialogue: 0,0:20:33.83,0:20:37.15,Main,Citizen,0,0,0,,Böyle omurgasız bir ülkeyi kim ne yapsın!Dialogue: 0,0:20:38.05,0:20:42.12,Main,Hody,0,0,0,,Kepazelerin başı cennet tarafından cezalandırıldı.Dialogue: 0,0:20:42.12,0:20:46.50,Main,Dosun,0,0,0,,İnsanları bağışlama yanlısı şeytanlar ölmek zorunda-dosun!Dialogue: 0,0:21:07.05,0:21:11.13,Main,Hody,0,0,0,,Öç alma vakti geldi!Dialogue: 0,0:21:11.13,0:21:15.05,Main,Hody,0,0,0,,Cennet, sonunda bizleri seçti ve bize güç bahşetti.Dialogue: 0,0:21:17.39,0:21:18.67,Main,Daruma,0,0,0,,Yoksa bunlar...Dialogue: 0,0:21:18.67,0:21:19.80,Main,Ikaros,0,0,0,,Efsanevi ilaç-hi!Dialogue: 0,0:21:20.58,0:21:22.52,Main,Dosun,0,0,0,,Ele geçirdiğine inanamıyorum-dosun!Dialogue: 0,0:21:23.27,0:21:25.31,Main,Hody,0,0,0,,Bundan bolca üretebilir misin, Zeo?Dialogue: 0,0:21:26.21,0:21:27.62,Main,Zeo,0,0,0,,Denerim.Dialogue: 0,0:21:27.62,0:21:31.49,Flashbacks,Hody,0,0,0,,Bu ülke tarafından düş kırıklığına uğratılmış  Balık Adam Bölgesi'nin sakinleri bir araya gelecek!Dialogue: 0,0:21:31.49,0:21:34.81,Flashbacks,Hody,0,0,0,,Bu kutsal bir savaş! Hazırlanın!Dialogue: 0,0:21:34.81,0:21:38.23,Flashbacks,Hody,0,0,0,,Eceliniz gelene kadar olabildiğince insan öldürmeye hazırlanın!Dialogue: 0,0:21:38.23,0:21:40.76,Flashbacks,Hody,0,0,0,,İntikam görevini...Dialogue: 0,0:21:40.76,0:21:43.98,Flashbacks,Hody,0,0,0,,...yerine getirmek bizim mirasımız.Dialogue: 0,0:21:43.98,0:21:47.06,Flashbacks,Hody,0,0,0,,Hesaplaşma günü gelecek!Dialogue: 0,0:21:50.65,0:21:53.48,Main,Hody,0,0,0,,İnsanlar, sizi aşağılık türler.Dialogue: 0,0:21:53.48,0:21:58.12,Main,Hody,0,0,0,,Hayatımızı öç almak için tüketiyoruz!Dialogue: 0,0:22:14.00,0:22:16.70,Main,Fukaboshi,0,0,0,,Artık çok geç!Dialogue: 0,0:22:16.70,0:22:21.80,Main,Fukaboshi,0,0,0,,Balık Adam Bölgesi'ni ne zaman kaderine terk ettik bilemiyorum.Dialogue: 0,0:22:21.80,0:22:26.97,Main,Fukaboshi,0,0,0,,Orada soyutlanmış bir şekilde Balık Adam Adası'nın karanlık yüzü olmuşlar!Dialogue: 0,0:22:26.97,0:22:32.97,Main,Fukaboshi,0,0,0,,Denizin derinliklerindeki o kanunsuz çukurdan...Dialogue: 0,0:22:32.97,0:22:37.53,Main,Fukaboshi,0,0,0,,...yükselen nefreti görmezden gelmeye çalıştık.Dialogue: 0,0:22:37.53,0:22:39.42,Main,Pirate,0,0,0,,Hey sen! Nereye gidiyorsun?Dialogue: 0,0:22:39.42,0:22:41.23,Main,Pirate,0,0,0,,Bırak beni! Noah...Dialogue: 0,0:22:41.23,0:22:42.12,Main,Pirate,0,0,0,,Mümkün değil!Dialogue: 0,0:22:42.12,0:22:45.45,Main,Fukaboshi,0,0,0,,Annemin yerine geçip imza topladım;...Dialogue: 0,0:22:45.45,0:22:48.09,Main,Fukaboshi,0,0,0,,...ama tek yaptığım yüzeysel işlerle uğraşmaktı.Dialogue: 0,0:22:48.91,0:22:52.25,Main,Fukaboshi,0,0,0,,İlerleme sağladığımı sanmıştım!Dialogue: 0,0:22:52.25,0:22:53.96,Flashbacks,Otohime,0,0,0,,Güç olduğunun farkındayım,...Dialogue: 0,0:22:53.96,0:22:58.16,Flashbacks,Otohime,0,0,0,,...fakat insanlara duyduğunuz nefretin tohumlarını...Dialogue: 0,0:22:58.16,0:23:00.69,Flashbacks,Otohime,0,0,0,,...çocuklarınızın zihinlerine ekemezsiniz!Dialogue: 0,0:23:00.69,0:23:07.60,Main,Fukaboshi,0,0,0,,Artık çok geç! Annem en çok onun gibilerden korkardı!Dialogue: 0,0:23:08.27,0:23:10.22,Main,Shirahoshi,0,0,0,,Abi-sama!Dialogue: 0,0:23:10.22,0:23:15.36,Main,Fukaboshi,0,0,0,,İlk olarak kendi içimizde hesaplaşmalıydık!Dialogue: 0,0:23:15.36,0:23:21.87,Main,Fukaboshi,0,0,0,,İnsanlara yönelik duygularımızla yüzleşmeliydik!Dialogue: 0,0:23:23.96,0:23:25.65,Main,Fukaboshi,0,0,0,,Annemi...Dialogue: 0,0:23:25.65,0:23:31.39,Main,Fukaboshi,0,0,0,,Annemi öldüren  Balık Adam Adası'nın nefretiydi!Dialogue: 0,0:23:31.99,0:23:36.78,Main,Fukaboshi,0,0,0,,Belki de biliyordu!Dialogue: 0,0:23:37.77,0:23:41.76,Flashbacks,Otohime,0,0,0,,Kimin yaptığı önemsiz...Dialogue: 0,0:23:41.76,0:23:45.83,Flashbacks,Otohime,0,0,0,,Benim yüzümden öfkeye kapılmayın.Dialogue: 0,0:23:46.28,0:23:51.90,Flashbacks,Otohime,0,0,0,,Benim yüzümden hınç ve nefretin içinizdeki iyiliği yenmesine izin vermeyin.Dialogue: 0,0:23:53.49,0:23:59.60,Main,Fukaboshi,0,0,0,,Ancak bir parçam o hınca  annem insanlar...Dialogue: 0,0:24:00.35,0:24:04.05,Main,Fukaboshi,0,0,0,,...tarafından öldürüldüğü için kapıldı!Dialogue: 0,0:24:05.18,0:24:06.27,Main,Citizen,0,0,0,,Prens...Dialogue: 0,0:24:07.03,0:24:09.97,Main,Fukaboshi,0,0,0,,Ölüler pişmanlıklarını yanlarında götürür.Dialogue: 0,0:24:09.97,0:24:16.76,Main,Fukaboshi,0,0,0,,Bu hınç, yalnızca yaşayanların ekip biçeceği bir yanılgıdır.Dialogue: 0,0:24:16.76,0:24:22.64,Main,Fukaboshi,0,0,0,,İnsanlardan nefret ettiğim için  Balık Adam Bölgesi'nin nefretini görmezden geldim.Dialogue: 0,0:24:22.64,0:24:28.30,Main,Fukaboshi,0,0,0,,Nihayet gözümü açtığımda ise kontrol edilemeyecek kadar güçlenmişti!Dialogue: 0,0:24:30.37,0:24:32.18,Main,Fukaboshi,0,0,0,,Bir şey yapılmazsa Balık Adam Adası...Dialogue: 0,0:24:33.69,0:24:37.46,Main,Fukaboshi,0,0,0,,...insanlara duyduğu nefret dolayısıyla kendi kendini yok edecek!Dialogue: 0,0:24:45.49,0:24:46.89,Main,Soldier,0,0,0,,Dikkatli olun!Dialogue: 0,0:24:46.89,0:24:50.21,Main,Soldier,0,0,0,,Adayı koruyan kabarcığın tersine bu,  gemiyi geçip gidebilir!Dialogue: 0,0:24:50.58,0:24:54.70,Main,Soldier,0,0,0,,Noah'nın etrafını sarmak zorunda! Hedef şaşmamalı!Dialogue: 0,0:24:54.70,0:24:56.81,Main,Fukaboshi,0,0,0,,Hasır Şapkalı! Yalvarırım!Dialogue: 0,0:25:02.96,0:25:05.07,Main,Fukaboshi,0,0,0,,Geçmiş bize lazım değil!Dialogue: 0,0:25:05.07,0:25:06.73,Main,Fukaboshi,0,0,0,,Sil gitsin tarihi!Dialogue: 0,0:25:07.02,0:25:12.50,Main,Fukaboshi,0,0,0,,Bu adayı gün ışığından uzak tutan hayaletleri yok et!Dialogue: 0,0:25:15.89,0:25:18.23,Main,Soldier,0,0,0,,Pekala, şimdi!Dialogue: 0,0:25:28.49,0:25:30.02,Main,Soldiers,0,0,0,,Haydi!Dialogue: 0,0:25:30.02,0:25:33.05,Main,Fukaboshi,0,0,0,,Balık Adam Adası'nı...Dialogue: 0,0:25:33.05,0:25:34.94,Main,Fukaboshi,0,0,0,,...en başa götür!Dialogue: 0,0:25:40.43,0:25:42.94,Main,Hody,0,0,0,,Kes sesini, Fukaboshi!Dialogue: 0,0:25:42.94,0:25:46.10,Main,Hody,0,0,0,,Balık adam kini daima var olacak!Dialogue: 0,0:25:47.50,0:25:48.33,Main,Luffy,0,0,0,,Abi-hoshi.Dialogue: 0,0:25:49.68,0:25:52.93,Main,Luffy,0,0,0,,Kendimce halletmeme izin verdiğin sürece kafana takmana gerek yok.Dialogue: 0,0:25:54.17,0:25:59.68,Main,Citizen,0,0,0,,H- Hey! Hody'nin adamlarıyla meydanda dövüşenler...Dialogue: 0,0:25:59.68,0:26:01.56,Main,Citizen,0,0,0,,Evet, onlar Hasır Şapkalar!Dialogue: 0,0:26:01.56,0:26:03.38,Main,Citizen,0,0,0,,Bir de Patron Jinbe!Dialogue: 0,0:26:03.38,0:26:05.03,Main,Citizen,0,0,0,,Ne?Dialogue: 0,0:26:05.03,0:26:06.77,Main,The Utterly Indistinguishable Ones,0,0,0,,Luffy-chan'ın sesi!Dialogue: 0,0:26:06.77,0:26:08.21,Main,The Utterly Indistinguishable Ones,0,0,0,,Doğru!Dialogue: 0,0:26:23.36,0:26:26.00,Main,Soldier,0,0,0,,İşte bu! Kabarcığın içerisinde!Dialogue: 0,0:26:28.64,0:26:32.41,Main,Luffy,0,0,0,,Jinbe ile meydana gelmeden önce kararımızı vermiştik,...Dialogue: 0,0:26:32.41,0:26:36.91,Main,Luffy,0,0,0,,...bu adadaki kimsenin zarar görmesine izin vermeyeceğiz!Dialogue: 0,0:26:36.91,0:26:38.71,Main,Luffy,0,0,0,,Bize bırak, abi-hoshi!Dialogue: 0,0:26:47.08,0:26:48.75,Main,Luffy,0,0,0,,Neticede arkadaş değil miyiz?Dialogue: 0,0:27:14.65,0:27:19.04,Thoughts,Right Minister,0,0,0,,Böyle bir insandan  kuşkulandığımıza inanamıyorum!Dialogue: 0,0:27:19.04,0:27:22.35,Main,Citizen who has the right idea,0,0,0,,Hey, sorun nedir? Durmasanıza.Dialogue: 0,0:27:26.15,0:27:28.34,Main,Citizen who has the right idea,0,0,0,,Kaçmamız lazım! Hey!Dialogue: 0,0:27:28.34,0:27:30.45,Main,Citizen who is an idiot,0,0,0,,Adadan ayrılmayacağım!Dialogue: 0,0:27:30.45,0:27:30.98,Main,Citizen who has the right idea,0,0,0,,Ne!Dialogue: 0,0:27:31.47,0:27:33.58,Main,Citizen who is an idiot,0,0,0,,Ben de!Dialogue: 0,0:27:33.58,0:27:34.65,Main,Citizen who is an idiot,0,0,0,,Ben de!Dialogue: 0,0:27:34.65,0:27:36.45,Main,Citizen who is an idiot,0,0,0,,Ben de kaçmayacağım!Dialogue: 0,0:27:36.45,0:27:38.04,Main,Citizen who is an idiot,0,0,0,,Ben de!Dialogue: 0,0:27:41.29,0:27:43.65,Main,Shirahoshi,0,0,0,,Luffy-sama!  Artık Noah'un güvertesinde hava var!Dialogue: 0,0:27:43.65,0:27:44.26,Main,Luffy,0,0,0,,Evet!Dialogue: 0,0:27:46.74,0:27:50.33,Main,Hody,0,0,0,,Benden kaçamayacaksın!Dialogue: 0,0:27:51.01,0:27:52.13,Main,Shirahoshi,0,0,0,,Hody-sama!Dialogue: 0,0:27:52.13,0:27:53.80,Main,Luffy,0,0,0,,Zayıf-hoshi!Dialogue: 0,0:27:53.80,0:27:55.04,Main,Luffy,0,0,0,,Arkama geç!Dialogue: 0,0:27:55.04,0:27:56.48,Main,Luffy,0,0,0,,Söz veriyorum incinmeyeceksin!Dialogue: 0,0:27:57.12,0:27:58.06,Main,Shirahoshi,0,0,0,,Peki!Dialogue: 0,0:28:08.52,0:28:10.43,Main,Hody,0,0,0,,Hasır Şapkalı!Dialogue: 0,0:28:12.48,0:28:13.46,Main,Shirahoshi,0,0,0,,Luffy-sama!Dialogue: 0,0:28:15.41,0:28:16.74,Main,Ikaros,0,0,0,,Ye bunu!Dialogue: 1,0:28:16.74,0:28:18.25,Main,Ikaros,0,0,0,,İkarus'un Kanatları!Dialogue: 0,0:28:21.03,0:28:22.84,Main,Franky,0,0,0,,Kanat mı?Dialogue: 0,0:28:25.82,0:28:28.12,Main,Franky,0,0,0,,Bunlar kanat falan değil! (tsubasa)Dialogue: 0,0:28:28.12,0:28:29.89,Main,Franky,0,0,0,,Tükürük bu! (tsuba)Dialogue: 0,0:28:30.12,0:28:31.11,Main,Ikaros,0,0,0,,Suyap!Dialogue: 0,0:28:36.05,0:28:37.22,Main,Franky,0,0,0,,Mürekkep!Dialogue: 0,0:28:39.21,0:28:43.47,Main,Ikaros,0,0,0,,Maalesef o benim mürekkepten yapılma kopyamdı-hi!Dialogue: 0,0:28:45.62,0:28:47.50,Main,Ikaros,0,0,0,,Sakın küçümseyeyim deme rüt-Dialogue: 0,0:28:51.39,0:28:53.35,Main,Ikaros,0,0,0,,Kuru kalamar olmak istemiyorum-hi!Dialogue: 0,0:28:53.35,0:28:56.85,Main,Chopper,0,0,0,,İşte bu! General Franky'nin yeni saldırısı!Dialogue: 0,0:28:56.85,0:28:59.16,Main,Chopper,0,0,0,,Midesinden ateş topu püskürttü!Dialogue: 0,0:29:02.02,0:29:03.68,Main,Chopper,0,0,0,,Sen miydin püskürten!Dialogue: 0,0:29:04.09,0:29:06.55,Main,Dosun,0,0,0,,Ne cüretle gardını düşürürsün-gyaban?Dialogue: 0,0:29:15.34,0:29:17.30,Main,Dosun,0,0,0,,Çekicimi çıplak elleriyle mi durdurdu?Dialogue: 0,0:29:22.09,0:29:26.80,Main,Chopper,0,0,0,,Belki de bu dönüşüm çekice karşı koymak için en iyi seçenek değildir!Dialogue: 0,0:29:26.80,0:29:28.20,Main,Zoro,0,0,0,,Hey, Chopper!Dialogue: 0,0:29:28.20,0:29:32.87,Main,Zoro,0,0,0,,Bu halinle insana falan benzemiyorsun, tam bir canavar olmuşsun!Dialogue: 0,0:29:33.63,0:29:39.58,Main,Chopper,0,0,0,,Artık önemsemiyorum. Arkadaş edinmek istediğim için cinsan gibi görünmek istemiştim.Dialogue: 0,0:29:39.58,0:29:42.38,Main,Chopper,0,0,0,,Şimdi ise Luffy'ye yardım etmek için canavar olmak istiyorum!Dialogue: 0,0:29:43.06,0:29:44.19,Main,Zoro,0,0,0,,Anlıyorum.Dialogue: 0,0:29:44.19,0:29:47.54,Main,Hyouzou,0,0,0,,Gülümseyenler beni  kesip biçme havasına sokuyor!Dialogue: 0,0:29:54.75,0:29:58.41,Main,Zoro,0,0,0,,Balık Adam Adası'nın  en güçlü kılıç ustasını getirin!Dialogue: 0,0:30:01.20,0:30:04.74,Main,Zoro,0,0,0,,Sen sıkıntımı bile öldüremezsin.Dialogue: 0,0:30:04.74,0:30:06.93,Main,Hody,0,0,0,,Hasır Şapkalı!Dialogue: 0,0:30:08.59,0:30:10.62,Main,Hody,0,0,0,,Artık sona eriyor!Dialogue: 0,0:30:14.21,0:30:16.17,Main,Luffy,0,0,0,,Dinlemiyor muydun?Dialogue: 0,0:30:16.99,0:30:20.58,Main,Luffy,0,0,0,,Balık Adam Adası'ndan kimsenin  zarar görmesine izin vermeyeceğim!Dialogue: 0,0:00:02.99,0:00:08.38,Main,,0,0,0,,Dünyanın sunabileceği her şeyi elde eden adam, Korsanlar Kralı Gold Roger.Dialogue: 0,0:00:08.38,0:00:13.00,Main,,0,0,0,,Son sözleri dünyanın her yerinden maceracıları denize çekti.Dialogue: 0,0:00:13.00,0:00:14.68,Main,,0,0,0,,"Hazinem mi?"Dialogue: 0,0:00:14.68,0:00:16.22,Main,,0,0,0,,"İstiyorsanız, size vereceğim!"Dialogue: 0,0:00:16.22,0:00:17.42,Main,,0,0,0,,"Arayın ve bulun!"Dialogue: 0,0:00:17.42,0:00:19.87,Main,,0,0,0,,"Bu dünyanın sunabileceği her şeyi orada bıraktım!"Dialogue: 0,0:00:19.87,0:00:22.69,Main,,0,0,0,,Korsanlar hayallerinin peşinden yola çıktılar!Dialogue: 0,0:00:22.69,0:00:25.35,Main,,0,0,0,,Dünya, Büyük Korsan Çağı'na girdi!Dialogue: 0,0:00:25.35,0:00:29.31,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪Dialogue: 0,0:00:29.31,0:00:33.81,We Go lyrics,,0,0,0,,♪ Şafak vakti gelmedi bile ve ben bekleyemiyorum! ♪Dialogue: 0,0:00:33.81,0:00:37.48,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı, dört... Gidelim! ♪Dialogue: 0,0:00:38.97,0:00:43.05,We Go lyrics,,0,0,0,,♪ Bayrağımızı dalgalandıralım, macera şafağının doğuşuna. ♪Dialogue: 0,0:00:44.41,0:00:49.74,We Go lyrics,,0,0,0,,♪ Dalgalar yapalım, bizi uykumuzdan kaldırsınlar. ♪Dialogue: 0,0:00:49.74,0:00:54.28,We Go lyrics,,0,0,0,,♪ Eğer inanılmaz bir dünyaya gitmek istiyorsan,Dialogue: 0,0:00:54.28,0:00:58.79,We Go lyrics,,0,0,0,, gerekli olan şey senin dayanıklılığın. ♪Dialogue: 0,0:00:59.11,0:01:01.73,We Go lyrics,,0,0,0,,♪ Fazla dikkat çekmek, bu bir suç mu? ♪Dialogue: 0,0:01:01.73,0:01:04.62,We Go lyrics,,0,0,0,,♪ Aranıyor → Kazanan demektir! ♪Dialogue: 0,0:01:04.62,0:01:10.50,We Go lyrics,,0,0,0,,♪ Özgür olmak bizim tek kuralımız! ♪Dialogue: 0,0:01:10.50,0:01:15.99,We Go lyrics,,0,0,0,,♪ Endişelerinizi unutun, bırakın rüzgar essin. ♪Dialogue: 0,0:01:15.99,0:01:18.53,We Go lyrics,,0,0,0,,♪ Ne pahasına olursa olsun, One Piece'i ilk biz bulacağız! ♪Dialogue: 0,0:01:18.53,0:01:22.66,We Go lyrics,,0,0,0,,♪ Hayal kuran kalplerimiz, çok büyük... ♪Dialogue: 0,0:01:22.66,0:01:26.93,We Go lyrics,,0,0,0,,♪ Onları uyandırmamak önemli. ♪Dialogue: 0,0:01:26.93,0:01:29.57,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪Dialogue: 0,0:01:29.57,0:01:33.54,We Go lyrics,,0,0,0,,♪ Şafak vakti gelmedi bile ve ben bekleyemiyorum! ♪Dialogue: 0,0:01:33.54,0:01:37.33,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı, dört... Gidelim! ♪Dialogue: 0,0:01:38.76,0:01:44.72,We Go lyrics,,0,0,0,,♪ Biz... buralara kadar geldik. ♪Dialogue: 0,0:01:44.72,0:01:47.62,We Go lyrics,,0,0,0,,♪ Gideceğiz... hayallerimizin olduğu yere,Dialogue: 0,0:01:47.62,0:01:52.70,We Go lyrics,,0,0,0,, ve kimseyi arkada bırakmayacağız. ♪Dialogue: 0,0:01:52.70,0:01:55.30,We Go lyrics,,0,0,0,,♪ Hep devam edeceğiz, bu bir söz. ♪Dialogue: 0,0:01:55.30,0:01:59.47,We Go lyrics,,0,0,0,,♪ Hayallerimizin başladığı o günden beri,Dialogue: 0,0:01:59.47,0:02:03.72,We Go lyrics,,0,0,0,, belirlediğimiz gelecek, değişmedi! ♪Dialogue: 0,0:02:03.72,0:02:06.24,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪Dialogue: 0,0:02:06.24,0:02:10.61,We Go lyrics,,0,0,0,,♪ Kalbimdeki güneş, asla batmayacak! ♪Dialogue: 0,0:02:10.61,0:02:13.38,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... ♪Dialogue: 0,0:02:14.78,0:02:17.57,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... ♪Dialogue: 0,0:02:18.75,0:02:24.82,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... dört... Gidelim! ♪Dialogue: 0,0:02:27.27,0:02:29.74,We Go lyrics,,0,0,0,,♪ Gidelim! ♪Dialogue: 0,0:02:30.10,0:02:34.80,Author,,0,0,0,, Türkçeleştirme   onepacetr.net   Çevirmenler   SyLaR_54 - thiefpliskin thx to onepace.netDialogue: 0,0:16:34.20,0:16:43.20,Author,,0,0,0,, Türkçeleştirme   onepacetr.net   Çevirmenler   SyLaR_54 - thiefpliskin thx to onepace.netDialogue: 0,0:30:20.96,0:30:23.87,Author,,0,0,0,, Türkçeleştirme   onepacetr.net   Çevirmenler   SyLaR_54 - thiefpliskin thx to onepace.net