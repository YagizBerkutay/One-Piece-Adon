Dialogue: 0,0:02:29.85,0:02:39.25,Title,Narrator,0,0,0,,{\fad(2000,2000)}Deniz Ormanı'nda
Dialogue: 0,0:02:49.90,0:02:51.90,Main,Zoro,0,0,0,,Zoro?!
Dialogue: 0,0:02:54.88,0:03:00.14,Main,Underlings,0,0,0,,Patron! Patron! Patron!
Dialogue: 0,0:03:00.14,0:03:04.39,Main,Underlings,0,0,0,,Bir insan su altında nasıl bir\Nbalık adamdan daha hızlı hareket edebilir?!
Dialogue: 0,0:03:04.96,0:03:07.93,Main,Underlings,0,0,0,,Kim bu adam?
Dialogue: 0,0:03:08.39,0:03:09.99,Main,Underling,0,0,0,,Kılıç ustasının kaçmasına izin vermeyin!
Dialogue: 0,0:03:11.28,0:03:14.03,Main,Underling,0,0,0,,Herkes Enerji Hapları'nı alsın.
Dialogue: 0,0:03:30.87,0:03:35.68,Main,Underling,0,0,0,,Bunlar ne kadar baş belası!\NNeptune Ordusu'ndaki herkesi yok edin!
Dialogue: 0,0:03:38.95,0:03:40.47,Thoughts,Zoro,0,0,0,,Kahretsin.
Dialogue: 0,0:03:45.36,0:03:49.53,Main,Neptune,0,0,0,,Bu da ne? Tuhaf bir aura.
Dialogue: 0,0:03:51.35,0:03:54.73,Main,Underling,0,0,0,,Kahretsin. Böyle dövüşeceklerse,\Nherkesi katledeceğiz!
Dialogue: 0,0:03:55.22,0:03:56.35,Main,Usopp,0,0,0,,Zoro!
Dialogue: 0,0:03:57.40,0:04:00.05,Main,Neptune,0,0,0,,Birazdan sarayı tamamen su basacak.
Dialogue: 0,0:04:00.05,0:04:02.68,Main,Neptune,0,0,0,,Bedenime tutunmalısınız!
Dialogue: 0,0:04:07.29,0:04:10.71,Thoughts,Neptune,0,0,0,,En iyi askerlerimizi kolayca öldürüyorlar.
Dialogue: 0,0:04:10.71,0:04:14.91,Thoughts,Neptune,0,0,0,,Bir tür karanlık güç kullanıyor olmalılar.
Dialogue: 0,0:04:14.91,0:04:18.31,Thoughts,Neptune,0,0,0,,Düşündüğüm gibi, \Ntüm askerleri saraydan çıkarmalıyım.
Dialogue: 0,0:04:18.31,0:04:22.18,Main,Neptune,0,0,0,,Hey! Bunu hava sağlamak için kullanın-jamon.
Dialogue: 0,0:04:22.18,0:04:23.69,Main,Usopp,0,0,0,,Ah, sağol!
Dialogue: 0,0:04:23.69,0:04:26.29,Main,Neptune,0,0,0,,Bedenime sıkıca tutunun-jamon!
Dialogue: 0,0:04:26.29,0:04:27.11,Main,Usopp,0,0,0,,Tamam!
Dialogue: 0,0:04:30.36,0:04:32.45,Main,Neptune,0,0,0,,Gecikemeyiz, hemen gitmeliyiz-jamon!
Dialogue: 0,0:04:32.45,0:04:35.54,Main,Usopp,0,0,0,,Zoro! Buraya gel! Yaşlı adama tutun!
Dialogue: 0,0:04:35.54,0:04:38.99,Thoughts,Neptune,0,0,0,,Yaralı sırtım dayanacak mı acaba?
Dialogue: 0,0:04:51.23,0:04:55.13,Main,Neptune,0,0,0,,Dinleyin askerler! \NBuradan yolumuzu kendimiz açacağız!
Dialogue: 0,0:04:55.13,0:04:57.84,Main,Neptune,0,0,0,,Durup dövüşmeyin. Saraydan kaçın!
Dialogue: 0,0:04:59.52,0:05:04.32,Attack,,0,0,0,,Deniz Adamı Dövüşü!
Dialogue: 0,0:05:05.81,0:05:07.98,Main,Usopp,0,0,0,,Zoro, bunu kullan!
Dialogue: 0,0:05:07.98,0:05:10.13,Main,Neptune,0,0,0,,Başlıyoruz!
Dialogue: 0,0:05:14.36,0:05:16.68,Main,Underling,0,0,0,,Neptune bir şey yapıyor!
Dialogue: 0,0:05:16.68,0:05:17.85,Main,Usopp,0,0,0,,Zoro!
Dialogue: 0,0:05:19.36,0:05:22.56,Attack,,0,0,0,,Denizaşırı!
Dialogue: 0,0:05:33.41,0:05:35.01,Main,Neptune,0,0,0,,Ah! Ah, ah, ah, ah,...
Dialogue: 0,0:05:35.01,0:05:37.38,Main,Neptune,0,0,0,,Beyler, şimdi gidin!
Dialogue: 0,0:05:37.38,0:05:38.39,Main,Soldiers,0,0,0,,Emredersiniz!
Dialogue: 0,0:05:38.39,0:05:41.04,Main,Neptune,0,0,0,,Akıntıyı kullanabildiğiniz kadar kullanın!
Dialogue: 0,0:05:41.37,0:05:45.25,Main,Underling,0,0,0,,Kahretsin, dövüşmeden kaçıyorlar!
Dialogue: 0,0:05:45.25,0:05:47.69,Main,Underling,0,0,0,,Patron Hody! Hemen bunu için!
Dialogue: 0,0:05:51.79,0:05:54.19,Main,Soldiers,0,0,0,,Kaleden çıktık! Devam edin!
Dialogue: 0,0:05:54.19,0:05:57.32,Main,Soldiers,0,0,0,,Anakaraya kadar bağlantı kanalından gidin!
Dialogue: 0,0:05:57.32,0:06:00.20,Main,Usopp,0,0,0,,Hey, yaşlı adam! Kendine gel! Yalvarırım!
Dialogue: 0,0:06:02.14,0:06:05.27,Main,Neptune,0,0,0,,Yaş çok acımasız olabiliyor.
Dialogue: 0,0:06:05.27,0:06:08.58,Main,Neptune,0,0,0,,Hiç kıpırdayamıyorum-jamon.
Dialogue: 0,0:06:09.00,0:06:09.96,Main,Usopp,0,0,0,,Ne?!
Dialogue: 0,0:06:13.61,0:06:15.30,Main,what's his bucket,0,0,0,,Majesteleri!
Dialogue: 0,0:06:15.30,0:06:16.84,Main,Soldiers,0,0,0,,Kral Neptune!
Dialogue: 0,0:06:22.54,0:06:23.93,Main,Neptune,0,0,0,,Oh, Hoe.
Dialogue: 0,0:06:26.76,0:06:29.09,Main,Neptune,0,0,0,,Bizi kurtardın!
Dialogue: 0,0:06:31.28,0:06:36.21,Main,Neptune,0,0,0,,Güçsüzlüğüm için üzgünüm.\NBoynumu bile kıpırdatamadım-jamon.
Dialogue: 0,0:06:36.21,0:06:37.41,Main,Usopp,0,0,0,,İyi misin?
Dialogue: 0,0:06:37.41,0:06:40.56,Main,what's his bucket,0,0,0,,Hele şükür, Hoe ona yardım etti!
Dialogue: 0,0:06:41.02,0:06:42.08,Main,Usopp,0,0,0,,Git!
Dialogue: 0,0:06:42.67,0:06:44.18,Thoughts,Zoro,0,0,0,,Havam tükendi.
Dialogue: 0,0:06:57.58,0:06:58.96,Main,Usopp,0,0,0,,Ne?
Dialogue: 0,0:07:00.80,0:07:03.82,Main,Usopp,0,0,0,,Neler oluyor?
Dialogue: 0,0:07:17.01,0:07:18.51,Main,Soldiers,0,0,0,,Majesteleri!
Dialogue: 0,0:07:21.35,0:07:26.00,Main,Soldiers,0,0,0,,Durum kötü! Hody, Majesteleri'ni yakaladı!
Dialogue: 0,0:07:26.00,0:07:30.19,Main,Soldiers,0,0,0,,Hody saf dışı kalmamış mıydı?
Dialogue: 0,0:07:30.19,0:07:34.54,Main,Soldiers,0,0,0,,Sağ Bakan! Geri dönelim!\NBu durumda Majesteleri...
Dialogue: 0,0:07:35.28,0:07:37.66,Main,Neptune,0,0,0,,Dönmeyin-jamon!
Dialogue: 0,0:07:38.79,0:07:44.17,Main,Neptune,0,0,0,,Bensiz devam etmeli ve Fukaboshiler'i\Nburaya getirmelisiniz!
Dialogue: 0,0:07:50.01,0:07:52.79,Main,what's his bucket,0,0,0,,Sallanmayın! Kralın emirlerine itaat edin!
Dialogue: 0,0:07:52.79,0:07:54.05,Main,Soldiers,0,0,0,,Emredersiniz!
Dialogue: 0,0:07:54.05,0:07:57.42,Main,Underling,0,0,0,,Patron Hody, kaçmalarına izin vermek doğru mu?
Dialogue: 0,0:07:57.42,0:07:59.82,Main,Hody,0,0,0,,Sorun değil, bırakın gitsinler.
Dialogue: 0,0:07:59.82,0:08:03.80,Main,Hody,0,0,0,,Krallarını terkeden bir avuç\Nsavaşçı ne yapabilir ki?
Dialogue: 0,0:08:04.41,0:08:08.23,Main,Hody,0,0,0,,Asıl önemlisi, bu ahmak kralı bağlayın.
Dialogue: 0,0:08:08.23,0:08:09.03,Main,Underling,0,0,0,,Emredersiniz!
Dialogue: 0,0:08:09.52,0:08:11.95,Main,Neptune,0,0,0,,Üzgünüm beyler,...
Dialogue: 0,0:08:11.95,0:08:15.57,Main,Neptune,0,0,0,,...ama öldürülmenize izin vermeyeceğim!
Dialogue: 0,0:08:24.42,0:08:26.47,Main,Underling,0,0,0,,Bu da ne?
Dialogue: 0,0:08:26.47,0:08:29.84,Main,Underling,0,0,0,,Bilmem. Muhtemelen birinin iskeleti.
Dialogue: 0,0:08:35.80,0:08:41.20,Captions,,0,0,0,,{\an8\fad(300,0)}Deniz Ormanı
Dialogue: 0,0:08:38.26,0:08:40.99,Main,Luffy,0,0,0,,Burası çok güzel!
Dialogue: 0,0:08:41.56,0:08:43.75,Main,Luffy,0,0,0,,Demek burası Deniz Ormanı?
Dialogue: 0,0:08:43.75,0:08:49.00,Main,Shirahoshi,0,0,0,,Gördün mü, hep buraya gelmek istedim.
Dialogue: 0,0:08:49.00,0:08:54.42,Main,Shirahoshi,0,0,0,,Sana gerçekten borçluyum, Luffy-sama.
Dialogue: 0,0:08:58.07,0:09:00.98,Main,Chopper,0,0,0,,Umarım burada dinlenip iyileşebiliriz.
Dialogue: 0,0:09:00.98,0:09:05.69,Main,Sanji,0,0,0,,Deniz kızı... Deniz kızı...
Dialogue: 0,0:09:05.69,0:09:07.23,Main,Chopper,0,0,0,,Sanji.
Dialogue: 0,0:09:08.27,0:09:09.98,Main,Luffy,0,0,0,,Oh, bu Sunny-go!
Dialogue: 0,0:09:10.39,0:09:12.65,Main,Chopper,0,0,0,,Gerçekten! Franky de orada!
Dialogue: 0,0:09:12.65,0:09:17.83,Main,Luffy,0,0,0,,Hey, Franky! Demek buradaydın.
Dialogue: 0,0:09:19.49,0:09:21.24,Main,Franky,0,0,0,,Bu sen misin, Luffy?
Dialogue: 0,0:09:21.24,0:09:22.41,Main,Franky,0,0,0,,Ha?
Dialogue: 0,0:09:23.21,0:09:28.33,Main,Franky,0,0,0,,Bu da ne?! \NYanında poster kızı mı getirdin?!
Dialogue: 0,0:09:33.30,0:09:36.59,Main,Luffy,0,0,0,,Tanıştırayım. Bu Pısırık.
Dialogue: 0,0:09:36.59,0:09:40.89,Main,Franky,0,0,0,,Oh, Pısırık, ha? \NGaliba kendini toplaman lazım.
Dialogue: 0,0:09:40.89,0:09:45.60,Main,Shirahoshi,0,0,0,,Evet, zahmet verdiğim için kusura\Nbakmayın. Adım Shirahoshi.
Dialogue: 0,0:09:45.60,0:09:48.54,Main,Luffy,0,0,0,,Franky, sadece sen mi varsın?
Dialogue: 0,0:09:48.54,0:09:52.40,Main,Franky,0,0,0,,Aslında Robin de buradaydı...
Dialogue: 0,0:09:52.40,0:09:54.30,Main,Franky,0,0,0,,...ama sonra bir şey aramaya gitti.
Dialogue: 0,0:09:54.30,0:09:57.87,Main,Franky,0,0,0,,Şu devasa mercan ormanına gitti.
Dialogue: 0,0:09:58.72,0:09:59.84,Main,Luffy,0,0,0,,Ha?
Dialogue: 0,0:10:02.21,0:10:03.66,Main,Jinbe,0,0,0,,Luffy-kun.
Dialogue: 0,0:10:05.83,0:10:07.37,Main,Luffy,0,0,0,,Jinbe!
Dialogue: 0,0:10:07.37,0:10:09.37,Main,Luffy,0,0,0,,Bu Jinbe değil mi?!
Dialogue: 0,0:10:10.86,0:10:12.43,Main,Jinbe,0,0,0,,Epey zaman oldu.
Dialogue: 0,0:10:26.48,0:10:29.81,Main,Jinbe,0,0,0,,Galiba epey güçlenmişsin. \NFarkı görebiliyorum.
Dialogue: 0,0:10:29.81,0:10:33.48,Main,Luffy,0,0,0,,Aşağıda olmadığını duyunca\Nseni göremeyeceğimi sanmıştım.
Dialogue: 0,0:10:33.48,0:10:37.29,Main,Jinbe,0,0,0,,Ne demek istiyorsun? Benimle burada\Nbuluşman için gönderdiğim mesajı almadın mı?
Dialogue: 0,0:10:37.29,0:10:40.24,Main,Luffy,0,0,0,,Neden bahsediyorsun? Bu konuda bilgim yok.
Dialogue: 0,0:10:40.24,0:10:42.41,Main,Jinbe,0,0,0,,Tuhaf.
Dialogue: 0,0:10:42.41,0:10:45.58,Main,Shirahoshi,0,0,0,,Patron Jinbe-sama, \Ngörüşmeyeli gerçekten uzun zaman oldu.
Dialogue: 0,0:10:45.58,0:10:50.04,Main,Jinbe,0,0,0,,Prenses Shirahoshi-sama, \Nseninle irtibat kuramadığım için kusura bakm-
Dialogue: 0,0:10:50.04,0:10:52.96,Main,Jinbe,0,0,0,,Nee?!!
Dialogue: 0,0:10:52.96,0:10:56.51,Main,Jinbe,0,0,0,,Prenses Shirahoshi! Neden buradasınız?!
Dialogue: 0,0:10:57.07,0:11:00.97,Main,Chopper,0,0,0,,Hey, Franky! Hachi ve Sanji'yi de\Ngetirdim, bana yardım et.
Dialogue: 0,0:11:02.72,0:11:03.57,Main,Jinbe,0,0,0,,Ha?
Dialogue: 0,0:11:04.07,0:11:06.03,Main,Franky,0,0,0,,Bu ahtapot adam değil mi?!
Dialogue: 0,0:11:06.93,0:11:08.82,Main,Franky,0,0,0,,Ne oldu sana?
Dialogue: 0,0:11:08.82,0:11:11.10,Main,Jinbe,0,0,0,,Hachi?! Ne?!
Dialogue: 0,0:11:11.71,0:11:14.88,Main,Jinbe,0,0,0,,O yaralar nasıl oldu?
Dialogue: 0,0:11:14.88,0:11:17.69,Main,Jinbe,0,0,0,,Asıl mesele, neden Balık Adam Adası'ndasın?
Dialogue: 0,0:11:17.69,0:11:21.11,Main,Jinbe,0,0,0,,Arlong'la birlikte yakalanmamış mıydın?
Dialogue: 0,0:11:21.11,0:11:25.12,Main,Hachi,0,0,0,,Jinbe-san, sen niye buradasın?
Dialogue: 0,0:11:25.12,0:11:27.65,Main,Chopper,0,0,0,,Franky! Sırada Sanji var!
Dialogue: 0,0:11:28.04,0:11:30.55,Main,Sanji,0,0,0,,Gerek yok, o kadar kötü değil.
Dialogue: 0,0:11:30.55,0:11:31.00,Main,Chopper,0,0,0,,Ha?
Dialogue: 0,0:11:40.70,0:11:43.01,Main,Sanji,0,0,0,,Ah, Deniz Kızı Prensesi!
Dialogue: 0,0:11:44.39,0:11:49.27,Main,Sanji,0,0,0,,Senden önce, \Nyeteneği olmayan bir sanatçı gibiydim.
Dialogue: 0,0:11:50.73,0:11:56.25,Main,Sanji,0,0,0,,Senin parlaklığını lâyıkıyla\Nyakalayabilecek bir fırça yok!
Dialogue: 0,0:11:56.25,0:11:57.11,Main,Shirahoshi,0,0,0,,Ş-Şey...
Dialogue: 0,0:11:57.11,0:12:02.65,Main,Chopper,0,0,0,,Bu, kadınların varlığına verdiği\Nnormal tepki! Artık daha iyi!
Dialogue: 0,0:12:04.04,0:12:06.95,Main,Sanji,0,0,0,,Tuvalim sahip olduğun güzelliği \Nasla yansıtamazdı.
Dialogue: 0,0:12:06.95,0:12:11.50,Main,Chopper,0,0,0,,Yaşasın! Yaşasın! \NSanji normal tuhaf hâline döndü!
Dialogue: 0,0:12:12.29,0:12:14.71,Main,Den,0,0,0,,Dışarıda çok gürültü var. \NNe oluyor acaba?
Dialogue: 0,0:12:15.93,0:12:18.67,Main,Den,0,0,0,,Prenses Shirahoshi neden burada?
Dialogue: 0,0:12:18.67,0:12:22.72,Main,Luffy,0,0,0,,Hey! Sen kimsin?! \NSunny'de ne işin var?!
Dialogue: 0,0:12:22.72,0:12:26.55,Main,Luffy,0,0,0,,Marangoz ustam Tom'un kardeşi Den-chan.
Dialogue: 0,0:12:26.55,0:12:29.43,Main,Luffy,0,0,0,,Geminin kaplanmasıyla ilgileniyor.
Dialogue: 0,0:12:29.43,0:12:31.68,Main,Luffy,0,0,0,,Ne? Öyle mi?
Dialogue: 0,0:12:31.68,0:12:35.37,Main,Luffy,0,0,0,,Erkek kardeşini kaplayacak usta bu, ha?
Dialogue: 0,0:12:36.80,0:12:38.56,Main,Franky,0,0,0,,Evet, epey yaklaştın!
Dialogue: 0,0:12:38.90,0:12:43.61,Main,Jimbei,0,0,0,,Prenses Shirahoshi-sama, neden buraya\Ngelmek istediğinizi anlıyorum ama...
Dialogue: 0,0:12:51.09,0:12:51.95,Main,Luffy,0,0,0,,Hâlâ mı?
Dialogue: 0,0:12:55.12,0:12:57.37,Main,Luffy,0,0,0,,Orada canına okuduktan sonra bile.
Dialogue: 0,0:12:57.85,0:12:59.64,Main,Luffy,0,0,0,,Kaç kez oldu?
Dialogue: 0,0:12:59.64,0:13:00.79,Main,Luffy,0,0,0,,Çok ısrarcı.
Dialogue: 0,0:13:00.79,0:13:05.25,Main,Jinbe,0,0,0,,Beni dinle! \NPrensesi neden buraya getirdin, Luffy-kun?
Dialogue: 0,0:13:05.89,0:13:08.67,Main,Luffy,0,0,0,,Sorun yok! Sonuçta ben varım!
Dialogue: 0,0:13:09.18,0:13:09.95,Main,Shirahoshi,0,0,0,,Evet!
Dialogue: 0,0:13:11.49,0:13:13.26,Main,Jinbe,0,0,0,,Bu da ne demek?
Dialogue: 0,0:13:19.65,0:13:22.44,Main,Luffy,0,0,0,,Demek bahsettiği mezar o.
Dialogue: 0,0:13:27.18,0:13:29.79,Main,Luffy,0,0,0,,Uzun süredir bu durumda.
Dialogue: 0,0:13:31.11,0:13:35.82,Main,Jinbe,0,0,0,,Burası, annesi Kraliçe Otohime'nin yattığı yer.
Dialogue: 0,0:13:37.00,0:13:41.59,Main,Jinbe,0,0,0,,Kraliçenin ölümünden hemen sonra...
Dialogue: 0,0:13:41.59,0:13:44.90,Main,Jinbe,0,0,0,,...Vander Decken inatla kur yapmaya başladı.
Dialogue: 0,0:13:44.90,0:13:49.24,Main,Jinbe,0,0,0,,Bu nedenle prenses annesinin\Ncenazesine bile katılamadı...
Dialogue: 0,0:13:49.87,0:13:52.97,Main,Jinbe,0,0,0,,...ve Koukaku Kulesi'nde on yıl geçirdi.
Dialogue: 0,0:14:00.84,0:14:07.47,Main,Jinbe,0,0,0,,Annesine söylemek istediği çok şey olmalı.
Dialogue: 0,0:14:13.80,0:14:15.41,Main,Nami,0,0,0,,Luffy!
Dialogue: 0,0:14:15.41,0:14:17.91,Main,Caimie,0,0,0,,Luffy-chin!
Dialogue: 0,0:14:18.34,0:14:20.25,Main,Luffy,0,0,0,,Nami! Caimie!
Dialogue: 0,0:14:20.94,0:14:25.22,Main,Caimie,0,0,0,,Dur. Prenses Shirahoshi de orada.
Dialogue: 0,0:14:25.64,0:14:27.93,Main,Caimie,0,0,0,,Nee?!!
Dialogue: 0,0:14:27.93,0:14:31.25,Main,Luffy,0,0,0,,Nami! Şölen daha başlamadı mı?
Dialogue: 0,0:14:31.25,0:14:35.19,Main,Sanji,0,0,0,,Nami-swaaaaaaaan!
Dialogue: 0,0:14:33.71,0:14:35.19,Secondary,Chopper,0,0,0,,O tamamen iyileşti.
Dialogue: 0,0:14:37.73,0:14:40.07,Main,Caimie,0,0,0,,Hacchin! Ne oldu sana?
Dialogue: 0,0:14:40.07,0:14:42.35,Main,Hachi,0,0,0,,Caimie.
Dialogue: 0,0:14:42.35,0:14:46.11,Main,Jinbe,0,0,0,,Emin misin? \NHody öyle bir şey mi yaptı?
Dialogue: 0,0:14:46.11,0:14:47.00,Main,Nami,0,0,0,,Evet.
Dialogue: 0,0:14:47.00,0:14:52.31,Main,Jinbe,0,0,0,,Demek Ryugu Sarayı'ndaki durum o kadar kötü.
Dialogue: 0,0:14:52.31,0:14:54.37,Main,Luffy,0,0,0,,Peki Zorolar'a ne oldu?
Dialogue: 0,0:14:54.37,0:14:56.09,Main,Nami,0,0,0,,Bilmem.
Dialogue: 0,0:14:56.09,0:14:58.34,Main,Nami,0,0,0,,Seni bulunca geri döneriz demiştim.
Dialogue: 0,0:14:58.34,0:15:00.41,Main,Shirahoshi,0,0,0,,O-Olamaz.
Dialogue: 0,0:15:01.26,0:15:06.01,Main,Shirahoshi,0,0,0,,Babamın o şekilde \Nyakalanabileceğine inanamıyorum!
Dialogue: 0,0:15:09.14,0:15:11.26,Main,Jinbe,0,0,0,,Luffy-kun, özür dilerim.
Dialogue: 0,0:15:12.92,0:15:19.22,Main,Jinbe,0,0,0,,Belaya bulaşmanızı istemediğim\Niçin sana mesaj bırakmıştım.
Dialogue: 0,0:15:19.22,0:15:22.11,Main,Jinbe,0,0,0,,Ama görünüşe bakılırsa çoktan\Nbizim işlerimize bulaşmaışsın.
Dialogue: 0,0:15:25.17,0:15:27.96,Main,Jinbe,0,0,0,,Acele etmemiz çok önemli,...
Dialogue: 0,0:15:27.96,0:15:30.83,Main,Jinbe,0,0,0,,...ama iki yıl önce seninle\Nkarşılaştığımızda koşullar farklıydı...
Dialogue: 0,0:15:30.83,0:15:34.70,Main,Jinbe,0,0,0,,...ve bu hikâyeyi o sırada sana anlatamadım.
Dialogue: 0,0:15:35.91,0:15:45.47,Main,Jinbe,0,0,0,,Doğu Denizi'nde Arlong'un tayfasını durdurduğun\Niçin, sana en derin şükranlarımı sunmak istiyorum.
Dialogue: 0,0:15:46.09,0:15:49.55,Main,Jinbe,0,0,0,,O sendin, değil mi?
Dialogue: 0,0:15:49.55,0:15:50.98,Main,Jinbe,0,0,0,,Teşekkür ederim.
Dialogue: 0,0:15:51.65,0:15:53.96,Main,Jinbe,0,0,0,,Bir kez daha minnettarlığımı\Nifade etmek istiyorum.
Dialogue: 0,0:15:54.78,0:15:57.41,Main,Jinbe,0,0,0,,Ama aynı zamanda özür de dilemeliyim.
Dialogue: 0,0:15:57.87,0:16:00.64,Main,Hachi,0,0,0,,Jinbe-san.
Dialogue: 0,0:16:01.52,0:16:08.21,Main,Jinbe,0,0,0,,On bir yıl önce Arlong'u\NDoğu Mavi'ye salan kişi...
Dialogue: 0,0:16:09.72,0:16:10.89,Main,Jinbe,0,0,0,,...bendim.
Dialogue: 0,0:16:51.24,0:16:53.05,Main,Guard,0,0,0,,Kral Neptune.
Dialogue: 0,0:16:53.05,0:16:56.88,Main,Guard,0,0,0,,Geri dönmeyin! Kralın iyiliğinin\Nheba olmasını mı istiyorsunuz?
Dialogue: 0,0:16:57.50,0:16:58.37,Main,Guard,0,0,0,,Çıkış orada!
Dialogue: 0,0:16:59.06,0:17:01.25,Main,Guard,0,0,0,,Tamam! Çıkmayı başardık!
Dialogue: 0,0:17:01.25,0:17:02.92,Main,Guard,0,0,0,,Kabarcıklı mercanları kullanın!
Dialogue: 0,0:17:06.04,0:17:10.40,Main,Left Minister,0,0,0,,Bu nasıl olabilir?! \NSadece kralı arkamızda bırakmakla kalmadık.
Dialogue: 0,0:17:10.40,0:17:15.26,Main,Left Minister,0,0,0,,Dışarı sadece muhafızlar çıkabildi! \NBu ne rezalet!
Dialogue: 0,0:17:15.26,0:17:17.64,Main,Right Minister,0,0,0,,Sızlanmayı kes! Kralın emri böyleydi!
Dialogue: 0,0:17:18.42,0:17:20.97,Main,Right Minister,0,0,0,,Beyler! Bu bir geri çekilme değil!
Dialogue: 0,0:17:20.97,0:17:26.48,Main,Right Minister,0,0,0,,Saraydaki korsanları haklayıp\Nkralı muhakkak kurtaracağız!
Dialogue: 0,0:17:26.48,0:17:30.77,Main,Right Minister,0,0,0,,Ama önce, Fukaboshi ve diğer\Nprenslerle irtibata geçmeliyiz!
Dialogue: 0,0:17:30.77,0:17:35.07,Main,Right Minister,0,0,0,,Prenslerle irtibata geçtikten sonra, onların\Nbirliklerinden destek kuvvetleri gelir gelmez...
Dialogue: 0,0:17:35.66,0:17:38.57,Main,Right Minister,0,0,0,,...Ryugu Sarayı'na döneceğiz!
Dialogue: 0,0:17:38.14,0:17:38.57,Main,Guards,0,0,0,,Emredersiniz!
Dialogue: 0,0:17:38.57,0:17:40.95,Main,Left Minister,0,0,0,,En yakın şehir hangisi?
Dialogue: 0,0:17:40.95,0:17:42.72,Main,Guard,0,0,0,,Fishverly Hills.
Dialogue: 0,0:17:42.72,0:17:44.19,Main,Fishman,0,0,0,,Dikkat edin!
Dialogue: 0,0:17:44.73,0:17:47.80,Narrator,Narrator,0,0,0,,{\an2}Bu arada, Balık Adam Adasının birinci sınıf bölgesi...
Dialogue: 0,0:17:47.80,0:17:49.33,Narrator,Narrator,0,0,0,,{\an2}...Fishverly Hills.
Dialogue: 0,0:17:49.33,0:17:50.73,Main,Fishman,0,0,0,,Kaçın!
Dialogue: 0,0:17:50.73,0:17:52.50,Main,Fishman,0,0,0,,Sıraya geçin!
Dialogue: 0,0:17:52.50,0:17:54.77,Main,Fishman,0,0,0,,Ölmek istemiyorsanız acele edin!
Dialogue: 0,0:17:56.15,0:17:58.43,Main,Fishman,0,0,0,,Bununla ne yapmamızı istiyorsunuz?!
Dialogue: 0,0:17:58.43,0:17:59.41,Main,Fishman,0,0,0,,Üstüne bas.
Dialogue: 0,0:17:59.41,0:18:00.08,Main,Fishman,0,0,0,,Ne?!
Dialogue: 0,0:18:00.08,0:18:00.97,Main,Fishman,0,0,0,,Bu bir sınav.
Dialogue: 0,0:18:00.97,0:18:02.15,Main,Fishman,0,0,0,,Saçmalamayın!
Dialogue: 0,0:18:03.69,0:18:08.89,Main,Ikaros,0,0,0,,Sessizlik! Bu ülke yakında\NKaptan Hody'ye ait olacak-hi.
Dialogue: 0,0:18:09.64,0:18:12.64,Captions,,0,0,0,,{\an4\fad(300, 0)\fs30}Yeni Balık Adam \NKorsanları'nın Komutanı\NIkaros Muhi
Dialogue: 0,0:18:09.98,0:18:12.61,Note,Note,0,0,8,,{\fad(100,100)}Fumi-e: Kutsal sayılan bir şeye karşı yapılan saygısızlığın sembolü.
Dialogue: 0,0:18:09.98,0:18:12.61,Main,Ikaros,0,0,0,,Fumi-e'nin üstüne bas!
Dialogue: 0,0:18:12.96,0:18:14.53,Main,Fishman,0,0,0,,Olamaz. Bunu yapamam.
Dialogue: 0,0:18:14.53,0:18:16.93,Main,Ikaros,0,0,0,,Bas dedim!
Dialogue: 0,0:18:18.81,0:18:21.33,Narrator,Narrator,0,0,0,,Kuzeydoğu, Şeker Fabrikası Şehri.
Dialogue: 0,0:18:18.60,0:18:21.33,Captions,,0,0,0,,{\fad(300, 0)}Şeker Fabrikası Şehri
Dialogue: 0,0:18:24.07,0:18:26.89,Main,Fishman,0,0,0,,Hadi, bas!
Dialogue: 0,0:18:26.89,0:18:28.67,Main,Fishwoman,0,0,0,,Y-Yapamam.
Dialogue: 0,0:18:30.29,0:18:34.90,Main,Fishwoman,0,0,0,,Affedin! Ona basamam! Yüzüne olmaz!
Dialogue: 0,0:18:34.90,0:18:35.96,Main,Fishman,0,0,0,,Sessizlik!
Dialogue: 0,0:18:37.01,0:18:39.20,Main,Daruma,0,0,0,,Onun yüzüne basmazsanız,...
Dialogue: 0,0:18:37.36,0:18:41.26,Captions,,0,0,0,,{\an4\fad(300,0)\fs30}Yeni Balık Adam \NKorsanları'nın Komutanı\NDaruma
Dialogue: 0,0:18:39.23,0:18:41.22,Main,Daruma,0,0,0,,...insanları seviyorsunuz demektir!
Dialogue: 0,0:18:41.22,0:18:44.26,Main,Daruma,0,0,0,,Yani, düşmanımızsınız!
Dialogue: 0,0:18:44.79,0:18:47.56,Narrator,Narrator,0,0,0,,Güneydoğu, Balık-İnsanlar Kültür Merkezi.
Dialogue: 0,0:18:44.70,0:18:47.20,Captions,,0,0,0,,{\fad(300, 0)}Balık-İnsanlar Kültür Merkezi Önü
Dialogue: 0,0:18:51.77,0:18:53.57,Main,Fishman,0,0,0,,Olmaz!
Dialogue: 0,0:18:52.47,0:18:53.57,Secondary,Hyouzou,0,0,0,,Hey!
Dialogue: 0,0:18:53.57,0:18:55.56,Main,Hyouzou,0,0,0,,Kolay bir tercih olmalı, değil mi?
Dialogue: 0,0:18:55.22,0:19:00.22,Captions,,0,0,0,,{\an6\fad(300,0)\fs30}Yeni Balık Adam \NKorsanları'nın Komutanı\NHyouzou
Dialogue: 0,0:18:55.56,0:18:59.43,Main,Hyouzou,0,0,0,,Ya fumi-e'ye basarsınız, ya da adadan gidersiniz.
Dialogue: 0,0:18:59.43,0:19:00.53,Main,Fishman,0,0,0,,Saçmalama!
Dialogue: 0,0:19:02.70,0:19:04.57,Main,Fishman,0,0,0,,Kahretsin! Bu konuda söz hakkımız yok mu?!
Dialogue: 0,0:19:14.54,0:19:18.01,Main,Hyouzou,0,0,0,,Acele edin. \NTercihlerin ikisini de beğenmezseniz,...
Dialogue: 0,0:19:19.67,0:19:21.84,Main,Hyouzou,0,0,0,,...sizi öldürebileceğim söylendi.
Dialogue: 0,0:19:22.00,0:19:24.64,Captions,,0,0,0,,{\fad(300, 0)}Denizci Alışveriş Mağazası
Dialogue: 0,0:19:22.45,0:19:24.81,Narrator,Narrator,0,0,0,,Doğudaki Denizci Alışveriş Mağazası.
Dialogue: 0,0:19:24.81,0:19:28.03,Main,Fishman,0,0,0,,Ülkeyi terketmek mi?! Saçmalık!
Dialogue: 0,0:19:28.03,0:19:30.77,Main,Fishman,0,0,0,,Okyanus tabanında güneş ışığı alan tek yer burası!
Dialogue: 0,0:19:30.77,0:19:34.63,Main,Fishman,0,0,0,,İnsan dünyasında da yaşayamayız!
Dialogue: 0,0:19:34.63,0:19:41.06,Main,Zeo,0,0,0,,Gördünüz mü? İnsanların bize karşı\Nuyguladığı acımasız ayrımcılığın farkındasınız.
Dialogue: 0,0:19:42.87,0:19:46.02,Main,Fishman,0,0,0,,Ne? Ne yapıyorsun?
Dialogue: 0,0:19:46.02,0:19:46.71,Main,Fishman,0,0,0,,Neler oluyor?!
Dialogue: 0,0:19:47.18,0:19:51.60,Main,Zeo,0,0,0,,İnsanlarla balık adamların uyum içinde yaşaması\Nahmakça bir fanteziden başka bir şey değil.
Dialogue: 0,0:19:51.60,0:19:54.72,Main,Zeo,0,0,0,,Bize itaat edin ve Kral Hody önünde diz çökün.
Dialogue: 0,0:19:55.90,0:19:59.88,Main,Zeo,0,0,0,,İnsanlara hükmedip tarihi değiştireceğiz!
Dialogue: 0,0:19:55.92,0:19:59.82,Captions,,0,0,0,,{\an4\fad(300,0)\fs30}Yeni Balık Adam \NKorsanları'nın Komutanı\NZeo
Dialogue: 0,0:20:00.06,0:20:02.86,Captions,,0,0,0,,{\an5\fad(300, 0)\pos(644,470)}Su Çarkı Şehri
Dialogue: 0,0:20:00.65,0:20:02.80,Narrator,Narrator,0,0,0,,{\an2}Kuzey, Su Çarkı Şehrinde.
Dialogue: 0,0:20:03.92,0:20:05.10,Main,Dosun,0,0,0,,Dosun!
Dialogue: 0,0:20:05.10,0:20:07.35,Main,Fishman,0,0,0,,Hadi. Sırada sen varsın.
Dialogue: 0,0:20:07.35,0:20:08.14,Main,Fishman,0,0,0,,Kendine eziyet etme.
Dialogue: 0,0:20:09.64,0:20:11.42,Main,Fishman,0,0,0,,Yapamam!
Dialogue: 0,0:20:13.92,0:20:17.92,Captions,,0,0,0,,{\an6\fad(300,0)\fs30}Yeni Balık Adam \NKorsanları'nın Komutanı\NDosun
Dialogue: 0,0:20:14.81,0:20:17.06,Main,Dosun,0,0,0,,Fumi-e'ye basmayı reddeden...
Dialogue: 0,0:20:17.07,0:20:18.44,Main,Dosun,0,0,0,,...herkesi ezeceğim-dosun!
Dialogue: 0,0:20:22.17,0:20:23.37,Main,Dosun,0,0,0,,Sen!
Dialogue: 0,0:20:23.40,0:20:25.57,Main,Dosun,0,0,0,,Bana engel olma, Fukaboshi!
Dialogue: 0,0:20:30.41,0:20:33.73,Main,Fukaboshi,0,0,0,,Sen ne yaptığını sanıyorsun?
Dialogue: 0,0:20:34.32,0:20:39.92,Main,Fukaboshi,0,0,0,,İnsanları merhum annemin resmi\Nüstüne basmaya zorlayarak?!
Dialogue: 0,0:20:43.30,0:20:47.50,Captions,,0,0,0,,{\fad(300, 0)}Mercan Tepesi
Dialogue: 0,0:20:43.47,0:20:45.27,Narrator,Narrator,0,0,0,,Biraz önce Luffyler'in ayrıldığı...
Dialogue: 0,0:20:45.27,0:20:47.61,Narrator,Narrator,0,0,0,,...güneydoğudaki Mercan Tepesinde.
Dialogue: 0,0:20:47.61,0:20:50.07,Main,Fishman,0,0,0,,Ne yapacağız?!
Dialogue: 0,0:20:50.07,0:20:51.48,Main,Fishman,0,0,0,,Vander Decken'in kaçmasına izin verdik...
Dialogue: 0,0:20:51.97,0:20:57.02,Main,Fishman,0,0,0,,...ve Prenses Shirahoshi, hasır şapka takan bir\Nkorsan tarafından gözümüzün önünde kaçırıldı!
Dialogue: 0,0:20:57.40,0:21:00.22,Main,Fishman,0,0,0,,Ama prenses akşam yemeğine\Nkadar döneceğini söyledi.
Dialogue: 0,0:21:00.22,0:21:03.49,Main,Fishman,0,0,0,,Aptal! \NOnu böyle demeye zorladığı besbelli!
Dialogue: 0,0:21:03.49,0:21:07.56,Main,Fishman,0,0,0,,Görünüşe bakılırsa Balık Adam Bölgesinden\Ngelenler birkaç şehirde sorun çıkarıyor.
Dialogue: 0,0:21:07.56,0:21:08.56,Main,Fishman,0,0,0,,Ne?!
Dialogue: 0,0:21:08.56,0:21:10.80,Main,Fishman,0,0,0,,Bu adada neler oluyor?!
Dialogue: 0,0:21:10.80,0:21:15.15,Main,Fishman,0,0,0,,Genç deniz kızları adadan kayboluyor...
Dialogue: 0,0:21:15.67,0:21:18.96,Main,Fishman,0,0,0,,Ya prenses Kutsal Ejderler'e satılırsa?!
Dialogue: 0,0:21:20.86,0:21:24.80,Main,Fishwoman,0,0,0,,Hey! \NGaliba genç bir deniz kızı daha kayboldu!
Dialogue: 0,0:21:25.32,0:21:26.80,Main,Fishwoman,0,0,0,,Çok korkutucu!
Dialogue: 0,0:21:26.80,0:21:28.07,Main,Fishman,0,0,0,,Durum kötü!
Dialogue: 0,0:21:31.35,0:21:34.52,Main,Caribou,0,0,0,,Bu benim işim.
Dialogue: 0,0:21:34.52,0:21:38.65,Main,Caribou,0,0,0,,Asıl önemlisi, müthiş bir şey gördüm!
Dialogue: 0,0:21:38.65,0:21:40.86,Main,Caribou,0,0,0,,Devasa bir deniz kızı!
Dialogue: 0,0:21:44.19,0:21:47.43,Main,Caribou,0,0,0,,İnsan boyutlarındaki deniz kızları\N70 milyon beli ediyorsa,...
Dialogue: 0,0:21:47.43,0:21:51.83,Main,Caribou,0,0,0,,...yedi-sekiz kat büyük olan\NDeniz Kızı Prensesi'ni yakalayabilir...
Dialogue: 0,0:21:51.83,0:21:54.31,Main,Caribou,0,0,0,,...ve satabilirsem...
Dialogue: 0,0:21:55.29,0:21:59.00,Main,Caribou,0,0,0,,Çok büyük meblağ, hayal bile edemiyorum!
Dialogue: 0,0:21:57.63,0:21:59.00,Secondary,Mermaid,0,0,0,,Sen...
Dialogue: 0,0:21:59.02,0:22:03.13,Main,Caribou,0,0,0,,Ha, iyi günler!
Dialogue: 0,0:22:07.14,0:22:11.34,Captions,,0,0,0,,{\an8\fad(300,0)}Deniz Ormanı
Dialogue: 0,0:22:09.52,0:22:10.96,Main,Shirahoshi,0,0,0,,Baba.
Dialogue: 0,0:22:11.60,0:22:14.36,Main,Jinbe,0,0,0,,Prenses Shirahoshi, endişelenme.
Dialogue: 0,0:22:14.36,0:22:21.24,Main,Jinbe,0,0,0,,Kralı ele geçirmeyi başarsalar bile, gerçek\Nanlamda ona zarar verme fırsatı bulamayacaklar.
Dialogue: 0,0:22:22.11,0:22:23.23,Main,Shirahoshi,0,0,0,,Gerçekten mi?
Dialogue: 0,0:22:23.23,0:22:27.27,Main,Jinbe,0,0,0,,Evet. Söz veriyorum, kralı kurtaracağım!
Dialogue: 0,0:22:27.27,0:22:31.99,Main,Shirahoshi,0,0,0,,Tamam. Lütfen kurtar, patron.
Dialogue: 0,0:22:32.15,0:22:36.81,Main,Jinbe,0,0,0,,Ama önce Luffy-kun ve arkadaşlarıyla\Nbiraz konuşmak istiyorum.
Dialogue: 0,0:22:41.66,0:22:44.27,Main,Sanji,0,0,0,,Güzel bayanlarım...
Dialogue: 0,0:22:45.38,0:22:46.86,Main,Sanji,0,0,0,,Çay yaptım.
Dialogue: 0,0:22:46.86,0:22:49.66,Main,Nami,0,0,0,,Sağol. Oraya bırak, Sanji-kun.
Dialogue: 0,0:22:49.66,0:22:53.36,Main,Nami,0,0,0,,Ayrıca ciddi bir konuşma yapmaya\Nçalışıyoruz, maskaralığı bırak.
Dialogue: 0,0:22:53.36,0:22:56.54,Main,Sanji,0,0,0,,Oh, Nami-san, katı olmana bayılıyorum!
Dialogue: 0,0:22:56.54,0:22:58.92,Main,Caimie,0,0,0,,Hiç değişmemişsin, Sanji-chin.
Dialogue: 0,0:22:58.92,0:23:00.22,Main,Luffy,0,0,0,,Leziz.
Dialogue: 0,0:23:00.22,0:23:01.78,Main,Sanji,0,0,0,,Senin için yapmadım!
Dialogue: 0,0:23:02.97,0:23:05.28,Main,Nami,0,0,0,,Evet, Jinbe-san.
Dialogue: 0,0:23:09.32,0:23:11.63,Main,Nami,0,0,0,,Ne demek istedin?
Dialogue: 0,0:23:12.20,0:23:16.20,Main,Nami,0,0,0,,Arlong'u Doğu Mavi'ye salan\Nkişinin kendin olduğunu söyledin.
Dialogue: 0,0:23:19.20,0:23:20.71,Main,Hachi,0,0,0,,Jinbe-san...
Dialogue: 0,0:23:21.22,0:23:22.09,Main,Jinbe,0,0,0,,Evet.
Dialogue: 0,0:23:23.74,0:23:25.17,Main,Sanji,0,0,0,,Bunu duydum.
Dialogue: 0,0:23:26.51,0:23:31.30,Main,Sanji,0,0,0,,Uzun zaman önce Luffy ve ben, \NShichibukai Jinbe'yi ilk duyduğumuzda...
Dialogue: 0,0:23:31.89,0:23:34.44,Main,Sanji,0,0,0,,...Yosaku bize anlatmıştı.
Dialogue: 0,0:23:35.30,0:23:38.58,Flashbacks,Yosaku,0,0,0,,Jinbe, Shichibukai olma karşılığında,...
Dialogue: 0,0:23:38.58,0:23:42.73,Flashbacks,Yosaku,0,0,0,,...korkunç birini Doğu Mavi'ye saldı.
Dialogue: 0,0:23:42.73,0:23:45.41,Main,Luffy,0,0,0,,Hmm, anlatmış mıydı?
Dialogue: 0,0:23:45.41,0:23:47.78,Main,Sanji,0,0,0,,Seni tanıyorsam, \Nmuhtemelen unutmuşsundur.
Dialogue: 0,0:23:47.78,0:23:49.80,Main,Luffy,0,0,0,,Yosaku nasıl acaba?
Dialogue: 0,0:23:50.64,0:23:55.06,Main,Sanji,0,0,0,,İki yıl önce senin Jinbe ile birlikte\Nçalıştığını anlatan yazıyı okuduğumda,...
Dialogue: 0,0:23:55.88,0:23:58.68,Main,Sanji,0,0,0,,...kafamda soru işaretleri uçuşmaya başladı.
Dialogue: 0,0:23:59.90,0:24:05.93,Main,Sanji,0,0,0,,Her zaman Jinbe'nin, Arlong'u gölgeler\Niçinden kontrol eden kişi olduğunu farzettim.
Dialogue: 0,0:24:05.93,0:24:06.85,Main,Sanji,0,0,0,,Hey, Jinbe.
Dialogue: 0,0:24:08.20,0:24:11.22,Main,Sanji,0,0,0,,Mazeretlerini dinlemek niyetindeyim,...
Dialogue: 0,0:24:11.22,0:24:12.76,Main,Sanji,0,0,0,,...ama kelimelerini düzgün seç.
Dialogue: 0,0:24:13.99,0:24:18.77,Main,Sanji,0,0,0,,Saklamaya gerek yok. \NGüzel rotacımız Nami-san'ın memleketi...
Dialogue: 0,0:24:19.76,0:24:21.47,Main,Sanji,0,0,0,,...Arlong'un ele geçirdiği adaydı.
Dialogue: 0,0:24:22.15,0:24:28.19,Main,Sanji,0,0,0,,Bunun sonucunda çok acılar çekti.
Dialogue: 0,0:24:30.95,0:24:33.41,Main,Sanji,0,0,0,,Demin söylediğin doğruysa,...
Dialogue: 0,0:24:33.82,0:24:35.37,Main,Sanji,0,0,0,,...seni asla affetmeyeceğim.
Dialogue: 0,0:24:40.14,0:24:41.31,Main,Hachi,0,0,0,,Jinbe-san...
Dialogue: 0,0:24:41.31,0:24:42.36,Main,Caimie,0,0,0,,Hacchin!
Dialogue: 0,0:24:42.36,0:24:45.44,Main,Chopper,0,0,0,,Yaraların tekrar açılacak!\NHenüz hareket etmemelisin!
Dialogue: 0,0:24:45.44,0:24:48.38,Main,Hachi,0,0,0,,Doğru! Onda açtığımız yaralar...
Dialogue: 0,0:24:48.38,0:24:52.34,Main,Hachi,0,0,0,,...ne kadar özür dilesek de\Naffedilemeyeceğimiz kadar derin.
Dialogue: 0,0:25:14.98,0:25:19.08,Flashbacks,Nami,0,0,0,,Yön bulma yeteneklerimi kullanarak\Ndünyadaki tüm okyanusları dolaşacağım!
Dialogue: 0,0:25:19.08,0:25:23.33,Flashbacks,Nami,0,0,0,,Sonra gördüğüm şeylere dayanarak\Ntüm dünyanın haritasını çizeceğim!
Dialogue: 0,0:25:23.33,0:25:27.96,Flashbacks,Bellemere,0,0,0,,O zaman çizdiğin bu harita, \Nhayaline giden yolda attığın ilk adım mı?
Dialogue: 0,0:25:27.96,0:25:29.34,Flashbacks,Nami,0,0,0,,Evet!
Dialogue: 0,0:25:30.37,0:25:34.20,Flashbacks,Bellemere,0,0,0,,Sonuçta ben üvey annenizim.
Dialogue: 0,0:25:34.72,0:25:37.11,Flashbacks,Bellemere,0,0,0,,Siz benim değerli ailemsiniz.
Dialogue: 0,0:25:44.91,0:25:49.87,Flashbacks,Man,0,0,0,,Korsanlar! Korsanlar geliyor!
Dialogue: 0,0:25:51.11,0:25:56.03,Flashbacks,Arlong,0,0,0,,Merhaba iğrenç ve zavallı insanlar.
Dialogue: 0,0:25:56.39,0:25:59.39,Flashbacks,Arlong,0,0,0,,Bundan sonra bu köy...
Dialogue: 0,0:25:59.39,0:26:03.11,Flashbacks,Arlong,0,0,0,,Hayır, bütün ada bana ait!
Dialogue: 0,0:26:05.83,0:26:08.11,Flashbacks,Arlong,0,0,0,,Her yetişkin için yüz bin beli.
Dialogue: 0,0:26:08.11,0:26:10.91,Flashbacks,Arlong,0,0,0,,Her çocuk için elli bin beli.
Dialogue: 0,0:26:10.91,0:26:13.63,Flashbacks,Arlong,0,0,0,,Bu vergiyi ödemeyen herkesi öldüreceğiz!
Dialogue: 0,0:26:21.67,0:26:23.95,Flashbacks,Arlong,0,0,0,,Saçma sevgin için öl.
Dialogue: 0,0:26:28.83,0:26:30.23,Flashbacks,Bellemere,0,0,0,,Nojiko! Nami!
Dialogue: 0,0:26:33.51,0:26:34.63,Flashbacks,Bellemere,0,0,0,,Sizi seviyorum.
Dialogue: 0,0:26:48.91,0:26:51.39,Flashbacks,Hachi,0,0,0,,Bu da ne? Harita mı?
Dialogue: 0,0:26:51.39,0:26:52.35,Flashbacks,Nami,0,0,0,,Yapma!
Dialogue: 0,0:26:52.35,0:26:54.75,Flashbacks,Nami,0,0,0,,O haritayı ben çizdim! O benim hazinem!
Dialogue: 0,0:26:54.75,0:26:56.39,Flashbacks,Nami,0,0,0,,Geri verin!
Dialogue: 0,0:26:56.39,0:26:57.35,Flashbacks,Arlong,0,0,0,,Bunu sen mi çizdin?
Dialogue: 0,0:26:57.35,0:26:58.51,Flashbacks,Nami,0,0,0,,Geri verin!
Dialogue: 0,0:26:57.95,0:26:58.51,Flashbacks,Nojiko,0,0,0,,Yapma, Nami!
Dialogue: 0,0:27:00.63,0:27:02.59,Flashbacks,Arlong,0,0,0,,Çok etkileyici.
Dialogue: 0,0:27:03.55,0:27:06.83,Flashbacks,Arlong,0,0,0,,İşimize yarar. Onu da getirin.
Dialogue: 0,0:27:06.83,0:27:07.11,Flashbacks,Hachi,0,0,0,,Tamam.
Dialogue: 0,0:27:07.11,0:27:10.31,Flashbacks,Nami,0,0,0,,Hayır! Bırakın! Bırakın beni!
Dialogue: 0,0:27:10.31,0:27:12.59,Flashbacks,Nami,0,0,0,,Hayır! Yapmayın!
Dialogue: 0,0:27:13.15,0:27:15.79,Flashbacks,Fishman,0,0,0,,Neden bir insanı besleyeyim ki?
Dialogue: 0,0:27:16.25,0:27:18.29,Flashbacks,Fishman,0,0,0,,Çeneni kapat ve harita çizmeye devam et!
Dialogue: 0,0:27:28.13,0:27:31.97,Flashbacks,Arlong,0,0,0,,Yüz milyon beli topla ve bana getir.
Dialogue: 0,0:27:32.53,0:27:37.01,Flashbacks,Arlong,0,0,0,,Bunu yapabilirsen, \Nköyünü bırakıp seni azat edeceğim.
Dialogue: 0,0:27:37.61,0:27:40.45,Flashbacks,Pirate,0,0,0,,Hırsız! Hazinemizi çaldı!
Dialogue: 0,0:27:40.45,0:27:41.97,Flashbacks,Pirate,0,0,0,,Sadece bir çocuk!
Dialogue: 0,0:27:41.97,0:27:44.25,Flashbacks,Pirate,0,0,0,,Umrumda değil! Öldür onu!
Dialogue: 0,0:27:45.57,0:27:47.29,Flashbacks,Pirate,0,0,0,,Kahretsin! Peşinden gidin!
Dialogue: 0,0:27:57.37,0:27:59.81,Flashbacks,Nami,0,0,0,,Yetmiş milyon daha.
Dialogue: 0,0:27:59.81,0:28:02.37,Flashbacks,Nami,0,0,0,,Yetmiş milyon beli daha bulabilirsem,...
Dialogue: 0,0:28:02.37,0:28:05.61,Flashbacks,Arlong,0,0,0,,Oh, geri dönmenden etkilendim.
Dialogue: 0,0:28:05.61,0:28:08.33,Flashbacks,Arlong,0,0,0,,Hıh, başka çaren de yok zaten.
Dialogue: 0,0:28:08.69,0:28:12.33,Flashbacks,Arlong,0,0,0,,Hoş geldin, haritacım.
Dialogue: 0,0:28:30.09,0:28:33.53,Main,Jinbe,0,0,0,,Çok acı çekmiş gibisin!
Dialogue: 0,0:28:33.53,0:28:35.89,Main,Sanji,0,0,0,,Seninle ilgisi yokmuş gibi konuşma!
Dialogue: 0,0:28:35.89,0:28:36.89,Main,Nami,0,0,0,,Evet.
Dialogue: 0,0:28:37.77,0:28:42.77,Main,Nami,0,0,0,,Ona her ne olduysa,\NArlong için asla üzülmeyeceğim.
Dialogue: 0,0:28:44.33,0:28:47.29,Main,Nami,0,0,0,,Ama iki yıl önce...
Dialogue: 0,0:28:47.29,0:28:51.32,Main,Nami,0,0,0,,...Sabaody Takımadası'na gelmeden önce, \Nbalık adamların...
Dialogue: 0,0:28:52.20,0:28:55.72,Main,Nami,0,0,0,,...güçlü olmalarına rağmen insanlar tarafından\Nayrımcılığa tâbi tutulduğunu bilmiyordum.
Dialogue: 0,0:28:56.64,0:29:02.28,Main,Nami,0,0,0,,Caimie kaçırılınca peşinden\Ngittiğimizde gözlerime inanamadım.
Dialogue: 0,0:29:03.88,0:29:09.92,Main,Nami,0,0,0,,Çünkü Sabaody Parkını gördüm ve aynı\NArlong'un yaptığı Arlong Parkı'na benziyordu.
Dialogue: 0,0:29:16.08,0:29:17.98,Main,Hachi,0,0,0,,Hep bunun özlemini duyduk.
Dialogue: 0,0:29:18.56,0:29:23.00,Main,Hachi,0,0,0,,Bağışlanma istediğim için bunu söylemiyorum, Nami.
Dialogue: 0,0:29:23.00,0:29:26.64,Main,Hachi,0,0,0,,Arlong-san insanlardan nefret etti.
Dialogue: 0,0:29:27.76,0:29:29.04,Main,Hachi,0,0,0,,Onlara kin besledi.
Dialogue: 0,0:29:31.80,0:29:34.52,Main,Hachi,0,0,0,,Çok ileri gittik.
Dialogue: 0,0:29:37.44,0:29:40.96,Main,Hachi,0,0,0,,Ama çocukluğumuzdan beri...
Dialogue: 0,0:29:40.96,0:29:45.24,Main,Hachi,0,0,0,,...insanların yaşadığı dünyanın\Nözlemini çektiğimiz bir gerçek.
Dialogue: 0,0:29:50.36,0:29:52.24,Main,Hachi,0,0,0,,Ben, Arlong-san...
Dialogue: 0,0:29:54.04,0:29:55.12,Main,Hachi,0,0,0,,...ve diğerleri.
Dialogue: 0,0:30:21.44,0:30:27.24,Main,Hachi,0,0,0,,Görünüşe göre geçmişte,\Ninsanlarla balık adamlar bölünmüş.
Dialogue: 0,0:30:27.24,0:30:34.16,Main,Hachi,0,0,0,,Ama sonra, iki yüz yıl önce Ryugu Krallığı\NDünya Hükümeti'nin bir parçası oldu.
Dialogue: 0,0:30:34.16,0:30:36.72,Main,Hachi,0,0,0,,İnsanlarla diplomatik bağlar oluşturmak için,...
Dialogue: 0,0:30:37.36,0:30:41.00,Main,Hachi,0,0,0,,...krala dünya konseyinde bir yer verildi.
Dialogue: 0,0:30:41.36,0:30:46.08,Main,Hachi,0,0,0,,Ama insanlar balık adamlardan\Nnefret etmeye devam etti.
Dialogue: 0,0:30:46.88,0:30:53.52,Main,Den,0,0,0,,Hayatımın en kötü zamanını \NBüyük Korsan Çağı başlayınca yaşadım.
Dialogue: 0,0:30:53.52,0:31:00.16,Main,Den,0,0,0,,İnsan korsanların adaya gelip her türlü çılgınlığı\Nyapmalarından korktuğumuzu hâla hatırlıyorum.
Dialogue: 0,0:31:01.16,0:31:03.56,Main,Den,0,0,0,,Bunu asla unutmayacağım.
Dialogue: 0,0:31:07.68,0:31:12.00,Main,Den,0,0,0,,Balık Adam Adası insanların işgaline uğramıştı.
Dialogue: 0,0:31:13.48,0:31:18.40,Main,Jinbe,0,0,0,,Bizi kurtaran merhum Beyazsakal'dı.
Dialogue: 0,0:31:21.12,0:31:26.68,Main,Jinbe,0,0,0,,Babalık, Balık Adam Adası'nı\Nkendi bölgesi ilan etti ve...
Dialogue: 0,0:31:26.68,0:31:29.60,Main,Jinbe,0,0,0,,...adaya barış geldi.
Dialogue: 0,0:31:31.72,0:31:36.80,Main,Jinbe,0,0,0,,Ama insanların balık adamlardan\Nnefret etmesi son bulmadı.
Dialogue: 0,0:31:36.80,0:31:40.72,Main,Jinbe,0,0,0,,Sabaody'de hepinizin bunu gördüğüne eminim.
Dialogue: 0,0:31:41.44,0:31:43.04,Main,Jinbe,0,0,0,,Acımasız gerçek.
Dialogue: 0,0:31:46.20,0:31:47.32,Main,Jinbe,0,0,0,,Tuhaf bir gidişat.
Dialogue: 0,0:31:47.32,0:31:51.92,Main,Jinbe,0,0,0,,Biri güç kazanınca hemen değişimden korkar.
Dialogue: 0,0:31:51.92,0:31:55.60,Main,Jinbe,0,0,0,,Hükümet, insanlarla balık adamların\Nbir arada olmasına karar verdi.
Dialogue: 0,0:31:55.60,0:32:01.16,Main,Jinbe,0,0,0,,Yine de gücü elinde tutan ve bize herkesten\Nfazla ayrımcılık yapan onlardan başkası değildi!
Dialogue: 0,0:32:03.48,0:32:07.16,Main,Jinbe,0,0,0,,İnsanlarla balık adamlar\Narasındaki ilişki hiç değişmedi.
Dialogue: 0,0:32:08.12,0:32:13.16,Main,Jinbe,0,0,0,,Bu nedenle bu rezil tarihe\Nson vermek amacıyla...
Dialogue: 0,0:32:13.16,0:32:16.08,Main,Jinbe,0,0,0,,...Balık Adam Adası'nda iki kişi baş kaldırdı.
Dialogue: 0,0:32:17.00,0:32:20.12,Main,Jinbe,0,0,0,,Birincisi Kraliçe Otohime'ydi.
Dialogue: 0,0:32:21.72,0:32:26.16,Main,Jinbe,0,0,0,,Ada sakinlerini insanlarla birlikte huzur\Niçinde yaşamaları için cesaretlendiren,...
Dialogue: 0,0:32:26.98,0:32:29.12,Main,Jinbe,0,0,0,,...Prenses Shirahoshi'nin annesi.
Dialogue: 0,0:32:29.48,0:32:33.60,Main,Jinbe,0,0,0,,Diğeriyse köleleri özgür bırakan kahraman...
Dialogue: 0,0:32:33.60,0:32:35.36,Main,Jinbe,0,0,0,,...Fisher Tiger.
Dialogue: 0,0:32:35.36,0:32:39.32,Main,Luffy,0,0,0,,Bir şey Tiger... \NSanırım onu daha önce duymuştum.
Dialogue: 0,0:32:39.32,0:32:41.44,Main,Jinbe,0,0,0,,İnsanlarla olan bağlarımızı\Nkeseceğini ilan etti...
Dialogue: 0,0:32:42.32,0:32:44.47,Main,Jinbe,0,0,0,,...ve dünya çapında bir tabuyu yıktı.
Dialogue: 0,0:32:44.80,0:32:48.51,Main,Jinbe,0,0,0,,Tek başına Kutsal Topraklar\NMariejoa'ya gitti ve onlara saldırdı.
Dialogue: 0,0:32:48.51,0:32:50.95,Main,Jinbe,0,0,0,,Köleleri kurtardı.
Dialogue: 0,0:32:51.39,0:32:54.87,Main,Jinbe,0,0,0,,Sonra tüm eski balık adam\Nköleleri bir araya topladı...
Dialogue: 0,0:32:54.87,0:32:58.95,Main,Jinbe,0,0,0,,...ve Güneş Korsanları'nı oluşturdu!
Dialogue: 0,0:32:58.95,0:32:59.87,Main,Sanji,0,0,0,,Güneş...
Dialogue: 0,0:33:00.31,0:33:05.43,Main,Jinbe,0,0,0,,Evet. Ben, Arlong ve Hachi.
Dialogue: 0,0:33:05.43,0:33:07.75,Main,Jinbe,0,0,0,,Dolayısıyla biz...
Dialogue: 0,0:33:09.35,0:33:12.51,Main,Jinbe,0,0,0,,...Güneş Korsanları'nın üyesiyiz.
Dialogue: 0,0:33:14.27,0:33:21.07,Main,Jinbe,0,0,0,,Ancak, denize açılan Balık Adam Korsanları'nın\NDünya Hükümeti'yle giriştiği sert mücadele...
Dialogue: 0,0:33:21.07,0:33:29.87,Main,Jinbe,0,0,0,,...insanlarla balık adamları birleştirmeye\Nçalışan Kraliçe Otohime'nin işini zorlaştırdı.
Dialogue: 0,0:33:32.23,0:33:37.39,Main,Jinbe,0,0,0,,Şu anki duruma katlanıp geleceği değiştirmeye\Nçalışan Kraliçe Otohime'nin aksine Fisher Tiger,...
Dialogue: 0,0:33:37.39,0:33:43.63,Main,Jinbe,0,0,0,,...gelecek için böylesine umutları terketti ve \Nhali hazırda acı çeken balık adam köleleri kurtardı.
Dialogue: 0,0:33:45.51,0:33:48.31,Main,Jinbe,0,0,0,,Hangisinin doğru olduğunu\Nkimse tam olarak söyleyemez.
Dialogue: 0,0:33:52.11,0:33:52.87,Main,Jinbe,0,0,0,,Size...
Dialogue: 0,0:33:53.85,0:33:59.61,Main,Jinbe,0,0,0,,...insanlarla balık adamlar arasındaki kaderi\Ndeğiştirmeye çalışan bu iki büyük insandan...
Dialogue: 0,0:34:01.01,0:34:04.01,Main,Jinbe,0,0,0,,...ve ruhlarının haykırışlarından bahsedeyim.
