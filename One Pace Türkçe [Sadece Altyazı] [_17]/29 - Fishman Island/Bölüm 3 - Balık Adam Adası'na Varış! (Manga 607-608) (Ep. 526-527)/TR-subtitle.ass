10,10,1Style: TS paper,impress bt,48,&H001D221E,&H000000FF,&H001D221E,&H00000000,0,0,0,0,100,100,0,0,1,0.5,0,2,10,10,10,1Style: We Go lyrics,Duality,40.0,&H0098594E,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2.6,0,2,10,10,15,1Style: Author,Impress BT,20.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.7,0.7,9,10,10,10,1Style: Attack,Duality,30.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.0,1.0,7,12,12,12,1Style: Sea Turtle,@GulimChe,52,&H0087EFE3,&H00FFFFFF,&H0075CCD0,&H78000000,-1,0,0,0,100,100,0,0,1,1.8,0,2,120,120,18,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:02.99,0:00:08.38,Main,,0,0,0,,Dünyanın sunabileceği her şeyi elde eden adam, Korsanlar Kralı Gold Roger.Dialogue: 0,0:00:08.38,0:00:13.00,Main,,0,0,0,,Son sözleri dünyanın her yerinden maceracıları denize çekti.Dialogue: 0,0:00:13.00,0:00:14.68,Main,,0,0,0,,"Hazinem mi?"Dialogue: 0,0:00:14.68,0:00:16.22,Main,,0,0,0,,"İstiyorsanız, size vereceğim!"Dialogue: 0,0:00:16.22,0:00:17.42,Main,,0,0,0,,"Arayın ve bulun!"Dialogue: 0,0:00:17.42,0:00:19.87,Main,,0,0,0,,"Bu dünyanın sunabileceği her şeyi orada bıraktım!"Dialogue: 0,0:00:19.87,0:00:22.69,Main,,0,0,0,,Korsanlar hayallerinin peşinden yola çıktılar!Dialogue: 0,0:00:22.69,0:00:25.35,Main,,0,0,0,,Dünya, Büyük Korsan Çağı'na girdi!Dialogue: 0,0:00:25.35,0:00:29.31,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪Dialogue: 0,0:00:29.31,0:00:33.81,We Go lyrics,,0,0,0,,♪ Şafak vakti gelmedi bile ve ben bekleyemiyorum! ♪Dialogue: 0,0:00:33.81,0:00:37.48,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı, dört... Gidelim! ♪Dialogue: 0,0:00:38.97,0:00:43.05,We Go lyrics,,0,0,0,,♪ Bayrağımızı dalgalandıralım, macera şafağının doğuşuna. ♪Dialogue: 0,0:00:44.41,0:00:49.74,We Go lyrics,,0,0,0,,♪ Dalgalar yapalım, bizi uykumuzdan kaldırsınlar. ♪Dialogue: 0,0:00:49.74,0:00:54.28,We Go lyrics,,0,0,0,,♪ Eğer inanılmaz bir dünyaya gitmek istiyorsan,Dialogue: 0,0:00:54.28,0:00:58.79,We Go lyrics,,0,0,0,, gerekli olan şey senin dayanıklılığın. ♪Dialogue: 0,0:00:59.11,0:01:01.73,We Go lyrics,,0,0,0,,♪ Fazla dikkat çekmek, bu bir suç mu? ♪Dialogue: 0,0:01:01.73,0:01:04.62,We Go lyrics,,0,0,0,,♪ Aranıyor → Kazanan demektir! ♪Dialogue: 0,0:01:04.62,0:01:10.50,We Go lyrics,,0,0,0,,♪ Özgür olmak bizim tek kuralımız! ♪Dialogue: 0,0:01:10.50,0:01:15.99,We Go lyrics,,0,0,0,,♪ Endişelerinizi unutun, bırakın rüzgar essin. ♪Dialogue: 0,0:01:15.99,0:01:18.53,We Go lyrics,,0,0,0,,♪ Ne pahasına olursa olsun, One Piece'i ilk biz bulacağız! ♪Dialogue: 0,0:01:18.53,0:01:22.66,We Go lyrics,,0,0,0,,♪ Hayal kuran kalplerimiz, çok büyük... ♪Dialogue: 0,0:01:22.66,0:01:26.93,We Go lyrics,,0,0,0,,♪ Onları uyandırmamak önemli. ♪Dialogue: 0,0:01:26.93,0:01:29.57,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪Dialogue: 0,0:01:29.57,0:01:33.54,We Go lyrics,,0,0,0,,♪ Şafak vakti gelmedi bile ve ben bekleyemiyorum! ♪Dialogue: 0,0:01:33.54,0:01:37.33,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı, dört... Gidelim! ♪Dialogue: 0,0:01:38.76,0:01:44.72,We Go lyrics,,0,0,0,,♪ Biz... buralara kadar geldik. ♪Dialogue: 0,0:01:44.72,0:01:47.62,We Go lyrics,,0,0,0,,♪ Gideceğiz... hayallerimizin olduğu yere,Dialogue: 0,0:01:47.62,0:01:52.70,We Go lyrics,,0,0,0,, ve kimseyi arkada bırakmayacağız. ♪Dialogue: 0,0:01:52.70,0:01:55.30,We Go lyrics,,0,0,0,,♪ Hep devam edeceğiz, bu bir söz. ♪Dialogue: 0,0:01:55.30,0:01:59.47,We Go lyrics,,0,0,0,,♪ Hayallerimizin başladığı o günden beri,Dialogue: 0,0:01:59.47,0:02:03.72,We Go lyrics,,0,0,0,, belirlediğimiz gelecek, değişmedi! ♪Dialogue: 0,0:02:03.72,0:02:06.24,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪Dialogue: 0,0:02:06.24,0:02:10.61,We Go lyrics,,0,0,0,,♪ Kalbimdeki güneş, asla batmayacak! ♪Dialogue: 0,0:02:10.61,0:02:13.38,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... ♪Dialogue: 0,0:02:14.78,0:02:17.57,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... ♪Dialogue: 0,0:02:18.75,0:02:24.82,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... dört... Gidelim! ♪Dialogue: 0,0:02:27.27,0:02:30.04,We Go lyrics,,0,0,0,,♪ Gidelim! ♪Dialogue: 0,0:02:30.03,0:02:38.64,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Kaşgarlı thx to onepace.netDialogue: 0,0:10:10.30,0:10:20.30,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Kaşgarlı thx to onepace.netDialogue: 0,0:24:02.95,0:24:05.85,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Kaşgarlı thx to onepace.netDialogue: 0,0:02:30.03,0:02:38.64,Title,Title,0,0,0,,Balık Adam Adası'na Varış! Denizkızı Körfezi ve Gyoverly Hills!Dialogue: 0,0:02:38.64,0:02:41.51,Main,Straw Hats,0,0,0,,Ne?!Dialogue: 0,0:02:43.09,0:02:44.79,Main,Vander Decken,0,0,0,,Beyler!Dialogue: 0,0:02:45.61,0:02:47.74,Main,Vander Decken,0,0,0,,Şimdilik, geri çekilmeliyiz!Dialogue: 0,0:02:47.74,0:02:48.69,Main,Pirates,0,0,0,,Evet!Dialogue: 0,0:02:48.69,0:02:51.90,Main,Pirates,0,0,0,,Anlaşıldı, Kaptan Vander Decken!Dialogue: 0,0:02:51.90,0:02:54.90,Main,Pirates,0,0,0,,Fenerbalığı! Wadatsumi! Gemiyi çekin!Dialogue: 0,0:02:54.90,0:02:56.35,Main,Wadatsumi,0,0,0,,A-Anlaşıldı!Dialogue: 0,0:02:58.17,0:02:59.52,Main,Nami,0,0,0,,Bu çok kötü!Dialogue: 0,0:02:59.52,0:03:04.10,Main,Nami,0,0,0,,Luffy, Kraken'e bizi buradan olabildiğince hızlı bir şekilde uzaklaştırmasını söyle!Dialogue: 0,0:03:04.10,0:03:05.07,Main,Luffy,0,0,0,,Tamam!Dialogue: 0,0:03:05.07,0:03:06.31,Main,Luffy,0,0,0,,Hey, Surume!Dialogue: 0,0:03:06.31,0:03:08.13,Main,Usopp,0,0,0,,Bekle! Buna gerek yok!Dialogue: 0,0:03:10.41,0:03:13.15,Main,Usopp,0,0,0,,Çoktan can havliyle kaçıyor zaten!Dialogue: 0,0:03:13.15,0:03:15.79,Main,Usopp,0,0,0,,Efsanevi bir canavarın bu kadar alçalabileceğini hiç tahmin etmemiştim!Dialogue: 0,0:03:15.79,0:03:18.17,Main,Nami,0,0,0,,Bunun çok yardımı dokunur!  O kadar da kötü değilmişsin!Dialogue: 0,0:03:21.18,0:03:22.64,Main,Robin,0,0,0,,Ne kötü bir koşma şekli. Dialogue: 0,0:03:22.64,0:03:26.85,Main,Franky,0,0,0,,Öyle söyleme! Bu sadece bu patlamaların ne kadar korkunç olduğunu gösteriyor!Dialogue: 0,0:03:26.85,0:03:29.25,Main,Luffy,0,0,0,,Ama ben patlama görmek istiyorum!Dialogue: 0,0:03:29.25,0:03:31.45,Main,Usopp,0,0,0,,Geminin ön tarafına koşun!Dialogue: 0,0:03:31.45,0:03:34.32,Main,Nami,0,0,0,,Bu yardımcı olmaz! Altı üstü birkaç metre!Dialogue: 0,0:03:50.43,0:03:52.91,Main,Nami,0,0,0,,Magma deniz tabanı boyunca akıyor! Dialogue: 0,0:03:52.91,0:03:54.66,Main,Nami,0,0,0,,Suyun sıcaklığı yükseliyor!Dialogue: 0,0:03:55.38,0:03:58.45,Main,Usopp,0,0,0,,Sanki bir tencerenin içindeymişiz gibi!Dialogue: 0,0:03:58.45,0:04:00.28,Main,Usopp,0,0,0,,Kaynamaya başlayacak!Dialogue: 0,0:03:58.11,0:04:00.28,Secondary,Chopper,0,0,0,,Sıcak! Sıcak!Dialogue: 0,0:04:05.35,0:04:07.39,Main,Brook,0,0,0,,Hayalet gemi ve Umibozu!Dialogue: 0,0:04:09.24,0:04:11.19,Main,Nami,0,0,0,,Kaç, Surume!Dialogue: 0,0:04:12.23,0:04:15.60,Main,Nami,0,0,0,,Sıcaklık farkı yüzünden akıntılar dönmeye başladı!Dialogue: 0,0:04:15.94,0:04:17.03,Main,Sanji,0,0,0,,Nami-san.Dialogue: 0,0:04:17.84,0:04:20.55,Main,Sanji,0,0,0,,Balık Adam Adası ne taraf-Dialogue: 0,0:04:21.02,0:04:23.10,Main,Chopper,0,0,0,,Şimdi bile edepsiz düşüncelerin mi var?!Dialogue: 0,0:04:23.10,0:04:25.21,Main,Nami,0,0,0,,Dümdüz ilerlemek zorundayız!Dialogue: 0,0:04:27.62,0:04:28.80,Main,Nami,0,0,0,,Biraz daha!Dialogue: 0,0:04:32.70,0:04:34.58,Main,Nami,0,0,0,,Şu okyanus çukurunun içine!Dialogue: 0,0:04:45.71,0:04:49.33,Main,Usopp,0,0,0,,Dikey bir düşüş bu! Ciddi misin sen?!Dialogue: 0,0:04:49.33,0:04:52.30,Main,Chopper,0,0,0,,Karanlıktan bile daha karanlık!Dialogue: 0,0:04:52.30,0:04:55.97,Main,Usopp,0,0,0,,Buranın aşağısında gerçekten Balık Adam Adası var mı?!Dialogue: 0,0:04:58.61,0:05:01.23,Main,Chopper,0,0,0,,Arkamız çok sıcak! Çok sıcak!Dialogue: 0,0:05:01.23,0:05:03.98,Main,Usopp,0,0,0,,Önümüz kapkaranlık! Korkunç!Dialogue: 0,0:05:03.98,0:05:06.64,Main,Usopp,0,0,0,,Orada daha fazla yaratık olduğu çok belli!Dialogue: 0,0:05:06.64,0:05:09.30,Main,Usopp,0,0,0,,Oradan asla canlı kurtulamayacağız!Dialogue: 0,0:05:09.60,0:05:14.74,Main,Usopp,0,0,0,,Luffy! O karanlık dümdüz cehenneme iniyor, dipsiz bir çanak gibi! Dialogue: 0,0:05:14.74,0:05:16.15,Main,Luffy,0,0,0,,Atla içine!Dialogue: 0,0:05:16.15,0:05:18.15,Main,Luffy,0,0,0,,Surume!Dialogue: 0,0:05:24.87,0:05:26.92,Main,Usopp,0,0,0,,Bir patlama daha!Dialogue: 0,0:05:26.92,0:05:30.24,Main,Franky,0,0,0,,O da ne?! Yukarıdan bir şey geliyor!Dialogue: 0,0:05:30.85,0:05:31.78,Main,Robin,0,0,0,,Kayalar mı?!Dialogue: 0,0:05:31.78,0:05:32.91,Main,Brook,0,0,0,,Toprak kayması mı?!Dialogue: 0,0:05:32.91,0:05:34.84,Main,Nami,0,0,0,,Kaya düşmesi! Dikkat edin! Dialogue: 0,0:05:34.84,0:05:37.17,Main,Chopper,0,0,0,,Az önceki patlama yüzünden çöküyor!Dialogue: 0,0:05:37.17,0:05:39.01,Main,Nami,0,0,0,,Savuştur, Surume!Dialogue: 0,0:05:40.28,0:05:42.52,Main,Zoro,0,0,0,,Baloncuktan çıkıp onları keseceğim!Dialogue: 0,0:05:42.52,0:05:45.45,Main,Zoro,0,0,0,,Luffy, bana sıkıca tutun!Dialogue: 0,0:05:45.45,0:05:46.75,Main,Luffy,0,0,0,,Tabii ki, bana bırak!Dialogue: 0,0:05:47.39,0:05:48.94,Main,Robin,0,0,0,,Zoro, yapma!Dialogue: 0,0:05:49.89,0:05:51.35,Main,Zoro,0,0,0,,Hey, bırak beni!Dialogue: 0,0:05:51.35,0:05:53.59,Main,Luffy,0,0,0,,Neden onu durduruyorsun, Robin?!Dialogue: 0,0:05:53.59,0:05:56.26,Main,Robin,0,0,0,,Yüzeyin 8 kilometre aşağısındayız!Dialogue: 0,0:05:56.26,0:05:59.72,Main,Robin,0,0,0,,Eğer baloncuktan çıkarsan, su basıncı tarafından ezilirsin!Dialogue: 0,0:05:59.72,0:06:01.73,Main,Zoro,0,0,0,,O zaman ne yapmamız gerekiyor?!Dialogue: 0,0:06:01.83,0:06:03.54,Main,Usopp,0,0,0,,Hissatsu Midori Boshi! Dialogue: 0,0:06:01.83,0:06:03.54,Attack,Usopp,0,0,0,,Öldürücü Yeşil YıldızDialogue: 0,0:06:03.78,0:06:04.90,Main,Usopp,0,0,0,,Sargasso!Dialogue: 0,0:06:12.98,0:06:14.37,Main,Chopper,0,0,0,,Deniz yosunu çıktı!Dialogue: 0,0:06:16.58,0:06:18.15,Main,Nami,0,0,0,,Kaya düşmesi...Dialogue: 0,0:06:18.15,0:06:19.29,Main,Franky,0,0,0,,durdu!Dialogue: 0,0:06:19.29,0:06:20.86,Main,Chopper,0,0,0,,Bu harika, Usopp!Dialogue: 0,0:06:20.86,0:06:23.12,Main,Usopp,0,0,0,,Bu onu birkaç saniyeliğine yavaşlatacak.Dialogue: 0,0:06:23.12,0:06:26.14,Main,Usopp,0,0,0,,Fırsatın varken buradan kaç, Surume!Dialogue: 0,0:06:33.00,0:06:34.62,Main,Chopper,0,0,0,,Güvendeyiz!Dialogue: 0,0:06:38.05,0:06:41.19,Main,Luffy,0,0,0,,Usopp, bu harikaydı!Dialogue: 0,0:06:41.19,0:06:43.81,Main,Brook,0,0,0,,Gerçekten de hızlı bir düşünmeydi!Dialogue: 0,0:06:42.65,0:06:43.81,Secondary,Usopp,0,0,0,,Çok kolaydı!Dialogue: 0,0:06:44.36,0:06:45.81,Main,Chopper,0,0,0,,Bizi kurtardın!Dialogue: 0,0:06:47.63,0:06:50.54,Main,Luffy,0,0,0,,Surume! Sen de çok iyiydin!Dialogue: 0,0:06:50.54,0:06:52.73,Main,Straw Hats,0,0,0,,Surume! Su-Dialogue: 0,0:07:07.84,0:07:12.26,Captions,Sign,0,0,200,,Yüzeyin 10 kilometre altı: Derinlikler (Çukurun dibi)Dialogue: 0,0:07:17.25,0:07:19.75,Main,Usopp,0,0,0,,K-Kurtulduk.Dialogue: 0,0:07:21.32,0:07:24.62,Main,Robin,0,0,0,,Işık mı? Yüzeyden bu kadar aşağıda olmamıza rağmen mi?Dialogue: 0,0:07:24.62,0:07:27.62,Main,Brook,0,0,0,,Çok parlak! Gözlerim kör oldu...Dialogue: 0,0:07:27.62,0:07:30.83,Main,Brook,0,0,0,,Kör olacak gözlerim yok gerçi.Dialogue: 0,0:07:32.01,0:07:34.60,Main,Luffy,0,0,0,,Hey, millet! Gelin ve şuna bakın!Dialogue: 0,0:07:34.60,0:07:36.68,Main,Luffy,0,0,0,,Yukarıya bakın! Yukarıya!Dialogue: 0,0:07:37.79,0:07:39.93,Main,Usopp,0,0,0,,O kadar parlak ki göremiyorum bile!Dialogue: 0,0:07:39.93,0:07:41.60,Main,Luffy,0,0,0,,Hey, Nami! O mu?Dialogue: 0,0:07:41.60,0:07:46.40,Main,Nami,0,0,0,,Evet, hiç şüphesiz. Pusula o adayı işaret ediyor!Dialogue: 0,0:07:46.40,0:07:47.62,Main,Nami,0,0,0,,Orası...Dialogue: 0,0:07:49.15,0:07:51.25,Main,Luffy,0,0,0,,Balık Adam Adası!Dialogue: 0,0:07:53.94,0:07:56.08,Main,Luffy,0,0,0,,Devasa!Dialogue: 0,0:07:56.78,0:08:01.17,Main,Nami,0,0,0,,Devasa bir baloncukla kaplı! İçerde bulutlar mı var?Dialogue: 0,0:08:01.17,0:08:02.52,Main,Nami,0,0,0,,Belki hava da vardır!Dialogue: 0,0:08:06.58,0:08:09.98,Main,Luffy,0,0,0,,Başardık! Geldik!Dialogue: 0,0:08:10.98,0:08:13.67,Main,Franky,0,0,0,,Grand Line'ın en ünlü yerlerinden!Dialogue: 0,0:08:13.67,0:08:17.44,Main,Caribou,0,0,0,,Oh, geldik mi?Dialogue: 0,0:08:20.00,0:08:22.24,Main,Sanji,0,0,0,,Denizkızlarının dans ettiği ada...Dialogue: 0,0:08:22.24,0:08:24.16,Main,Sanji,0,0,0,,Güzeller güzeli denizkızı prenses...Dialogue: 0,0:08:24.16,0:08:29.83,Main,Sanji,0,0,0,,Sonunda ulaştım! Çocukluğumdan beri hayalini kurduğum cennet!Dialogue: 0,0:08:31.92,0:08:35.57,Main,Sanji & Brook,0,0,0,,Denizkızları! Denizkı-Dialogue: 0,0:08:36.00,0:08:39.78,Main,Usopp,0,0,0,,Sanji! Cidden çaresizsin! Sadece hayal ederek bu hale mi geldin?!Dialogue: 0,0:08:40.51,0:08:43.96,Main,Chopper,0,0,0,,Üzgünüm, Sanji! Seni zamanında iyileştiremedim!Dialogue: 0,0:08:43.96,0:08:47.17,Main,Chopper,0,0,0,,Gerçek denizkızlarıyla tanışmasan daha iyi olur.Dialogue: 0,0:08:47.17,0:08:52.99,Main,Usopp,0,0,0,,Doktor! Balık Adam Adası'nın denizkızlarıyla tanışmak onun hayali!Dialogue: 0,0:08:52.99,0:08:55.43,Main,Chopper,0,0,0,,Ama eğer tanışırsa, ölür!Dialogue: 0,0:08:55.43,0:08:56.51,Main,Usopp,0,0,0,,Olamaz!Dialogue: 0,0:08:58.41,0:08:59.82,Main,Sanji,0,0,0,,Umurumda değil.Dialogue: 0,0:08:59.82,0:09:00.92,Main,Usopp,0,0,0,,Sanji!Dialogue: 0,0:09:01.75,0:09:04.82,Main,Usopp,0,0,0,,Hayatımın geri kalanını bu hayali gerçekleştiremeden geçirmektense,Dialogue: 0,0:09:05.45,0:09:09.17,Main,Usopp,0,0,0,,denizkızlarını görüp aşırı heyecandan ölmeyi yeğlerim!Dialogue: 0,0:09:09.73,0:09:10.87,Main,Usopp,0,0,0,,Çok kötüsün!Dialogue: 0,0:09:11.39,0:09:15.90,Main,Sanji,0,0,0,,Ben denizkızlarıyla tanışacağım!Dialogue: 0,0:09:15.90,0:09:21.22,Main,Luffy,0,0,0,,Çok heyecanlıyım!  Balık Adam Adası'nda ne tür et yiyorlar acaba?Dialogue: 0,0:09:21.22,0:09:25.24,Main,Nami,0,0,0,,Luffy, yüzündeki salyayı silip Surume'den bir şey isteyebilir misin?Dialogue: 0,0:09:25.24,0:09:27.72,Main,Nami,0,0,0,,Balık Adam Adası'nın girişini arayalım.Dialogue: 0,0:09:27.72,0:09:29.52,Main,Franky,0,0,0,,Hey, onlar da kim?!Dialogue: 0,0:09:33.45,0:09:35.57,Main,Zoro,0,0,0,,Kim onlar?!Dialogue: 0,0:09:36.06,0:09:38.45,Main,Nami,0,0,0,,Bir deniz canavarı sürüsü!Dialogue: 0,0:09:39.87,0:09:43.09,Main,Usopp,0,0,0,,Bittik biz! O kadar gelmiştik oysaki!Dialogue: 0,0:09:44.32,0:09:47.13,Main,Luffy,0,0,0,,Çok havalı, bu...Dialogue: 0,0:09:47.13,0:09:48.89,Main,Luffy,0,0,0,,deniz canavarları!Dialogue: 0,0:09:52.21,0:09:54.89,Main,Luffy,0,0,0,,Biri onları sürüyor!Dialogue: 0,0:09:54.89,0:09:58.41,Main,Hammond,0,0,0,,O insanların sana patronluk taslamasına neden izin veriyorsun...Dialogue: 0,0:09:58.41,0:10:00.04,Main,Hammond,0,0,0,,Kraken?Dialogue: 0,0:10:05.46,0:10:09.87,Main,Luffy,0,0,0,,Ne yapıyorsun, Surume?! Bizi son yere kadar taşı!Dialogue: 0,0:10:23.94,0:10:26.60,Main,Hammond,0,0,0,,Siz Hasır Şapkalar'sınız değil mi?Dialogue: 0,0:10:27.00,0:10:29.34,Main,Hammond,0,0,0,,Sizi çok iyi biliyoruz...Dialogue: 0,0:10:29.87,0:10:34.86,Main,Hammond,0,0,0,,Siz Arlong'un tayfasının işini bitiren korsanlarsınız.Dialogue: 0,0:10:36.40,0:10:39.91,Main,Hammond,0,0,0,,Eğer tek yaptığınız bu olsaydı, tepkimiz belliydi ama...Dialogue: 0,0:10:40.20,0:10:45.71,Main,Hammond,0,0,0,,Onca şeye rağmen, iki yıl önce Arlong'un tayfasının eski bir üyesi olan Hachi-san'ı korudunuz...Dialogue: 0,0:10:46.43,0:10:50.64,Main,Hammond,0,0,0,,O aşağılık Kutsal Ejderler'den birini dövdüğünüzü bile duydum!Dialogue: 0,0:10:52.05,0:10:58.17,Main,Hammond,0,0,0,,Tıpkı hepimizin hayranlık duyduğu  Balık Adam Adası'nın kahramanı, Fisher Tiger gibi!  Dialogue: 0,0:10:58.30,0:11:03.10,Captions,Sign,0,0,250,,Yeni Balık Adam Korsanları · Dövüşçü  HammondDialogue: 0,0:11:00.59,0:11:03.10,Main,Hammond,0,0,0,,Sizinle ne yapsam bilmiyorum.Dialogue: 0,0:11:03.28,0:11:08.88,Captions,Sign,0,0,250,,Yeni Balık Adam Korsanları · Tetikçi  HyouzouDialogue: 0,0:11:03.10,0:11:05.82,Main,Hammond,0,0,0,,Hey, söyleyin bakalım...Dialogue: 0,0:11:05.82,0:11:08.88,Main,Hammond,0,0,0,,Dost musunuz, düşman mı?Dialogue: 0,0:11:09.38,0:11:12.45,Main,Hammond,0,0,0,,Size seçme şansı vereceğim...Dialogue: 0,0:11:12.45,0:11:16.13,Main,Hammond,0,0,0,,Yeni Balık Adam Korsanları'na mı katılacaksınız?Dialogue: 0,0:11:16.74,0:11:18.85,Main,Hammond,0,0,0,,Yoksa Ret mi edeceksiniz?Dialogue: 0,0:11:19.37,0:11:21.81,Main,Hammond,0,0,0,,Eğer ederseniz, sizi burada batırırız.Dialogue: 0,0:11:21.81,0:11:22.98,Main,Luffy,0,0,0,,Ne dedin?!Dialogue: 0,0:11:23.89,0:11:26.04,Main,Nami,0,0,0,,Franky, yakıtı yeniden doldur.Dialogue: 0,0:11:26.04,0:11:27.66,Main,Franky,0,0,0,,Ha? Ne planlıyorsun?Dialogue: 0,0:11:28.10,0:11:31.60,Main,Nami,0,0,0,,Luffy ve diğerlerinin bu adamların söylediklerini yapmalarına imkan yok.Dialogue: 0,0:11:32.28,0:11:35.77,Main,Nami,0,0,0,,Öyle olsa bile, suyun 10 kilometre altındayız.Dialogue: 0,0:11:35.77,0:11:39.34,Main,Nami,0,0,0,,Burada geri saldıramayız bile.  Kazanmamızın imkanı yok. Dialogue: 0,0:11:39.34,0:11:40.84,Main,Nami,0,0,0,,O yüzden kaçalım!Dialogue: 0,0:11:41.23,0:11:46.30,Main,Nami,0,0,0,,Gemide kalan tüm havayı kullanıp, Coup de Burst ile Balık Adam Adası'na girelim!Dialogue: 0,0:11:47.95,0:11:49.15,Main,Franky,0,0,0,,Ciddi misin?!Dialogue: 0,0:11:49.57,0:11:52.72,Main,Nami,0,0,0,,Eğer yapmazsak, hepimiz buraya ölmek için gelmiş olacağız.Dialogue: 0,0:11:53.50,0:11:57.47,Main,Robin,0,0,0,,Doğru. Hayatta kalmamızın başka bir yolunu görmüyorum.Dialogue: 0,0:11:57.95,0:12:00.82,Main,Usopp,0,0,0,,Tamam! Gidip yakıt tanklarını dolduracağım!Dialogue: 0,0:12:00.82,0:12:02.78,Main,Usopp,0,0,0,,Franky! Dümen sana emanet!Dialogue: 0,0:12:02.78,0:12:05.84,Main,Franky,0,0,0,,Tamamdır! Süper bir şekilde halledeceğim!Dialogue: 0,0:12:07.20,0:12:12.17,Main,Hammond,0,0,0,,Peki, bizim astımız olacak mısın, Hasır Şapka Luffy?Dialogue: 0,0:12:13.97,0:12:15.58,Main,Luffy,0,0,0,,Asla.Dialogue: 0,0:12:15.58,0:12:17.14,Main,Luffy,0,0,0,,Aptal!Dialogue: 0,0:12:21.33,0:12:27.09,Main,Hammond,0,0,0,,Reddettin... Biz Yeni Balık Adam Korsanları'nın katılma davetini reddettin!Dialogue: 0,0:12:27.09,0:12:32.64,Main,Hammond,0,0,0,,O halde, düşmansınız!  Sadece bir grup günahkar insan!Dialogue: 0,0:12:32.94,0:12:36.57,Main,Luffy,0,0,0,,Neden sizin astınız olmak zorundayım ki?!Dialogue: 0,0:12:36.57,0:12:39.06,Main,Chopper,0,0,0,,Luffy! Onları kışkırtmamalısın!Dialogue: 0,0:12:39.52,0:12:43.82,Main,Hammond,0,0,0,,Çok yazık. Artık geçmenize izin vermemin bir yolu yok. Dialogue: 0,0:12:44.22,0:12:45.30,Main,Hammond,0,0,0,,Deniz aslanı!Dialogue: 0,0:12:47.22,0:12:49.04,Captions,,0,0,220,,Enerji OdasıDialogue: 0,0:12:47.63,0:12:49.04,Main,Usopp,0,0,0,,Franky, hazırız!Dialogue: 0,0:12:51.02,0:12:52.11,Main,Luffy,0,0,0,,Dövüşmek mi istiyorsun?!Dialogue: 0,0:12:54.85,0:12:56.58,Main,Nami,0,0,0,,Hadi, Franky!Dialogue: 0,0:12:56.58,0:12:58.85,Main,Franky,0,0,0,,Sunny de bir aslan!Dialogue: 0,0:12:59.50,0:13:03.02,Main,Franky,0,0,0,,Seninle başka bir gün hesaplaşalım, deniz aslanı!Dialogue: 0,0:13:03.02,0:13:04.64,Main,Franky,0,0,0,,İşte gidiyor...Dialogue: 0,0:13:04.64,0:13:07.13,Main,Franky,0,0,0,,Coup de Burst! Dialogue: 0,0:13:04.64,0:13:07.13,Note,Franky,0,0,0,,Rüzgar PatlamasıDialogue: 0,0:13:12.81,0:13:14.00,Main,Kasagon,0,0,0,,Gemi...Dialogue: 0,0:13:16.68,0:13:19.05,Main,Luffy,0,0,0,,Hava... yok oluyor!Dialogue: 0,0:13:20.25,0:13:22.37,Main,Chopper,0,0,0,,Dümdüz olacağım...Dialogue: 0,0:13:22.37,0:13:25.28,Main,Nami,0,0,0,,Dayanın! Balık Adam Adası'na girene kadar!Dialogue: 0,0:13:28.01,0:13:30.90,Main,Hammond,0,0,0,,O gemi de neyin nesi?!Dialogue: 0,0:13:31.90,0:13:34.03,Main,Franky,0,0,0,,İşte giriyoruz!Dialogue: 0,0:13:34.03,0:13:36.57,Main,Sanji,0,0,0,,Bekleyin beni, değerli denizkızlarım!Dialogue: 0,0:13:43.94,0:13:48.29,Main,Luffy,0,0,0,,Kaplama çıktı! Büyük baloncuk tarafından emildi!Dialogue: 0,0:13:49.94,0:13:52.54,Main,Robin,0,0,0,,Bu baloncuk iki katmandan oluşuyor!Dialogue: 0,0:13:53.13,0:13:56.53,Main,Robin,0,0,0,,Sıradan bir gemi bu hava dolu katmanda dibe düşerdi!Dialogue: 0,0:13:57.37,0:13:59.78,Main,Franky,0,0,0,,Geçmek için bir tane daha kullanacağız!Dialogue: 0,0:13:59.78,0:14:01.38,Main,Franky,0,0,0,,Sıkı tutunun!Dialogue: 0,0:14:05.25,0:14:06.54,Main,Zoro,0,0,0,,Su...!Dialogue: 0,0:14:18.12,0:14:20.28,Thoughts,Nami,0,0,0,,Çok güçlü bir akıntı!Dialogue: 0,0:14:26.48,0:14:28.23,Main,Chopper,0,0,0,,Yardım edin...Dialogue: 0,0:14:28.23,0:14:29.28,Main,Brook,0,0,0,,Nefes...Dialogue: 0,0:14:31.53,0:14:33.81,Thoughts,Sanji,0,0,0,,Dört Şeytan Meyvesi kulanıcımız var!Dialogue: 0,0:14:43.33,0:14:47.16,Thoughts,,0,0,0,,Ellerini... uzat!Dialogue: 0,0:14:50.04,0:14:53.05,Thoughts,Sanji,0,0,0,,Nami-san! Robin-chan!Dialogue: 0,0:14:55.49,0:14:59.08,Thoughts,Sanji,0,0,0,,Kahretsin! Akıntıya karşı duramıyorum!Dialogue: 0,0:15:13.66,0:15:17.42,Main,Hammond,0,0,0,,Ülkeye girmek için ne kadar da pervasız bir yol... Kendilerini öldürmüş olabilirler.Dialogue: 0,0:15:17.42,0:15:20.73,Main,Hyouzou,0,0,0,,Takip edelim mi, Hammond?Dialogue: 0,0:15:20.73,0:15:23.35,Main,Hyouzou,0,0,0,,Yaşayıp yaşamadıklarından emin olamayız.Dialogue: 0,0:15:25.21,0:15:27.14,Main,Hammond,0,0,0,,Her ihtimale karşı gitmeliyiz.Dialogue: 0,0:15:27.14,0:15:30.77,Main,Hammond,0,0,0,,Neptune Ordusu'nun onları bizden önce bulmasını istemiyorum.Dialogue: 0,0:15:30.77,0:15:35.74,Main,Hammond,0,0,0,,Ama önce, Noah'a geri dönelim ve patronu bu konuda bilgilendirelim.Dialogue: 0,0:15:35.74,0:15:40.69,Main,Hammond,0,0,0,,Arlong-san'ın hayallerini yıkan,  Hasır Şapka'nın geldiğini haber verelim!Dialogue: 0,0:15:44.16,0:15:46.55,Captions,Sign,0,0,180,,Balık Adam Adası'nın DerinlikleriDialogue: 0,0:15:48.25,0:15:49.19,Main,...,0,0,0,,Bak!Dialogue: 0,0:15:52.50,0:15:53.80,Main,...,0,0,0,,Bakın!Dialogue: 0,0:15:53.80,0:15:54.65,Main,...,0,0,0,,Gördüm!Dialogue: 0,0:15:54.65,0:15:55.78,Main,...,0,0,0,,Görmedim!Dialogue: 0,0:15:55.78,0:15:57.07,Main,...,0,0,0,,Görmedin mi?Dialogue: 0,0:15:57.07,0:15:58.14,Main,...,0,0,0,,Gördüysem ne olmuş?Dialogue: 0,0:15:58.14,0:15:59.62,Main,...,0,0,0,,Bakın, kımıldadı!Dialogue: 0,0:15:59.62,0:16:00.80,Main,...,0,0,0,,Kımıldadı!Dialogue: 0,0:16:00.80,0:16:02.20,Main,...,0,0,0,,Kımıldamadı!Dialogue: 0,0:16:02.20,0:16:03.87,Main,...,0,0,0,,Kımıldamadı mı?Dialogue: 0,0:16:03.87,0:16:05.44,Main,...,0,0,0,,Kımıldadıysa ne olmuş?Dialogue: 0,0:16:09.39,0:16:11.61,Main,Usopp,0,0,0,,Yaşasın! Uyandı!Dialogue: 0,0:16:11.61,0:16:13.44,Main,Chopper,0,0,0,,Luffy!Dialogue: 0,0:16:16.31,0:16:18.00,Main,Caimie,0,0,0,,Luffy-chin!Dialogue: 0,0:16:19.10,0:16:21.82,Main,Caimie,0,0,0,,İyi olduğuna çok sevindim!Dialogue: 0,0:16:21.82,0:16:23.96,Main,Caimie,0,0,0,,Nasıl hissediyorsun?Dialogue: 0,0:16:29.61,0:16:33.53,Main,Luffy,0,0,0,,Camie değil mi bu?! Uzun zaman oldu!Dialogue: 0,0:16:33.53,0:16:38.17,Main,Sanji,0,0,0,,Seni son gördüğüm zamandan bile daha tatlısın, Camie-chwan!Dialogue: 0,0:16:38.17,0:16:41.06,Main,Luffy,0,0,0,,Balık Adam Adası'na vardık mı?Dialogue: 0,0:16:41.06,0:16:46.76,Main,Chopper,0,0,0,,Evet! Anlaşılan biz tam boğulmak üzereyken denizkızları bizi kurtarmış!Dialogue: 0,0:16:46.76,0:16:52.12,Main,Usopp,0,0,0,,Evet! Bunu saklamanın manası yok. Şimdiye kadar hepimiz baygındık.Dialogue: 0,0:16:52.12,0:16:54.50,Main,Sanji,0,0,0,,Burası Camie-chan'ın evi.Dialogue: 0,0:16:54.50,0:16:55.35,Main,Sanji,0,0,0,,İşte, şapkan.Dialogue: 0,0:16:55.35,0:16:57.84,Main,Luffy,0,0,0,,Caime'nin evi, ha?Dialogue: 0,0:16:57.84,0:17:02.22,Main,Caimie,0,0,0,,Üzgünüm.  Sizi karşılamaya gelmeyi planlıyordum amaDialogue: 0,0:17:02.22,0:17:04.89,Main,Caimie,0,0,0,,bir sonraki aya kadar geleceğinizi düşünmedim.Dialogue: 0,0:17:04.89,0:17:07.50,Main,Luffy,0,0,0,,Sıkıntı etme! Diğerleri nerede?Dialogue: 0,0:17:08.33,0:17:12.30,Main,Chopper,0,0,0,,Şey... Ayrıldık gibi duruyor.Dialogue: 0,0:17:12.79,0:17:15.47,Main,Chopper,0,0,0,,İyiler mi acaba?Dialogue: 0,0:17:15.47,0:17:16.84,Main,Luffy,0,0,0,,Gerçekten mi?Dialogue: 0,0:17:17.21,0:17:20.31,Main,Luffy,0,0,0,,Ama, eminim bir şekilde hallederler.Dialogue: 0,0:17:20.31,0:17:22.97,Main,Sanji,0,0,0,,Denizde Kemik o kadar da iyi olmaz amaDialogue: 0,0:17:22.97,0:17:25.41,Main,Sanji,0,0,0,,onlarla beraber Robo ve Yeşil de var.Dialogue: 0,0:17:25.41,0:17:26.68,Main,Sanji,0,0,0,,Eminim iyilerdir.Dialogue: 0,0:17:26.72,0:17:31.62,Main,Sanji,0,0,0,,Onlara ulaşabildiğim kadar ulaşmaya çalıştım ama dibe sürüklenen bir tek biziz.Dialogue: 0,0:17:31.62,0:17:34.45,Main,Caimie,0,0,0,,Diğerlerini de yakın zamanda görmek istiyorum.Dialogue: 0,0:17:34.45,0:17:38.01,Main,Caimie,0,0,0,,Ah, işte. Üşümüş olmalısınız, değil mi?Dialogue: 0,0:17:38.01,0:17:40.36,Main,Caimie,0,0,0,,Biraz çorba yaptım, o yüzden için ve ısının.Dialogue: 0,0:17:41.63,0:17:44.40,Main,Caimie,0,0,0,,İşte! Soğuk denizyosunu çorbası!Dialogue: 0,0:17:44.40,0:17:45.54,Main,Caimie,0,0,0,,Lezzetlidir.Dialogue: 0,0:17:46.51,0:17:48.67,Main,Usopp,0,0,0,,Soğuk... çorba mı?  Dialogue: 0,0:17:51.26,0:17:54.52,Main,Caimie,0,0,0,,Soğuk çorba sizi hiçbir şekilde ısıtmaz!Dialogue: 0,0:17:54.52,0:17:56.13,Main,Caimie,0,0,0,,Ne yapacağım?!Dialogue: 0,0:17:57.53,0:17:59.75,Main,Caimie,0,0,0,,Yanlış yaptım!Dialogue: 0,0:17:59.75,0:18:02.79,Main,Sanji,0,0,0,,Sıkıntı yok, Camie-chan.Dialogue: 0,0:18:02.79,0:18:05.69,Main,Sanji,0,0,0,,Tam tersi, beni ısıtıyor!Dialogue: 0,0:18:05.69,0:18:07.18,Main,Chopper,0,0,0,,"Tam tersi" de ne demek?Dialogue: 0,0:18:07.63,0:18:09.33,Main,Luffy,0,0,0,,Hey! Sanji, ben de istiyorum!Dialogue: 0,0:18:11.12,0:18:13.11,Main,...,0,0,0,,Giysileriniz kurudu!Dialogue: 0,0:18:13.11,0:18:14.13,Main,...,0,0,0,,Kurudular!Dialogue: 0,0:18:14.13,0:18:15.61,Main,...,0,0,0,,Daha kurumadılar!Dialogue: 0,0:18:15.61,0:18:17.08,Main,...,0,0,0,,Kurumadılar mı?Dialogue: 0,0:18:17.08,0:18:18.40,Main,...,0,0,0,,Kurumuşlarsa ne olmuş?Dialogue: 0,0:18:23.69,0:18:26.04,Main,Luffy,0,0,0,,Giysilerimizi mi kuruttunuz?Dialogue: 0,0:18:26.04,0:18:27.07,Main,Luffy,0,0,0,,Sağolun!Dialogue: 0,0:18:27.07,0:18:27.85,Main,Sanji,0,0,0,,Teşekkürler.Dialogue: 0,0:18:28.44,0:18:30.58,Main,Luffy,0,0,0,,Bu arada, siz de kimsiniz?Dialogue: 0,0:18:30.58,0:18:32.58,Main,Caimie,0,0,0,,Ah, onlar benim arkadaşlarım.Dialogue: 0,0:18:32.84,0:18:34.66,Main,Caimie,0,0,0,,Yıllık Balığı Denizkızı BeşizlerDialogue: 0,0:18:34.66,0:18:35.67,Main,...,0,0,0,,Ben Ichika!Dialogue: 0,0:18:35.67,0:18:36.60,Main,...,0,0,0,,Ben Nika!Dialogue: 0,0:18:36.60,0:18:37.53,Main,...,0,0,0,,Ben Sanka!Dialogue: 0,0:18:37.53,0:18:38.44,Main,...,0,0,0,,Ben Yonka!Dialogue: 0,0:18:38.44,0:18:39.87,Main,...,0,0,0,,Ben Yonka Two!Dialogue: 0,0:18:34.66,0:18:39.87,Note,TL Note,0,0,0,,Bir-ka, İki-ka, Üç-ka, Dört-ka, ve Dört-ka İkiDialogue: 0,0:18:39.87,0:18:41.66,Main,Usopp,0,0,0,,Goka olması gerekmiyor mu onun?!Dialogue: 0,0:18:39.87,0:18:41.66,Note,TL Note,0,0,0,,Beş-kaDialogue: 0,0:18:42.40,0:18:44.98,Main,Caimie,0,0,0,,Hızlı yüzücülerdir ve oldukça bilgililerdir.Dialogue: 0,0:18:44.98,0:18:47.17,Main,Luffy,0,0,0,,Gerçekten mi?Dialogue: 0,0:18:47.17,0:18:50.06,Main,Caimie,0,0,0,,Burası Denizkızı Körfezi'nin dibi.Dialogue: 0,0:18:50.06,0:18:54.36,Main,Caimie,0,0,0,,Şehrin Denizkızı Kafe'sinin kadınlar yatakhanesindeyiz,  o yüzden burada çok fazla arkadaşım var.Dialogue: 0,0:18:55.42,0:18:57.71,Main,Sanji,0,0,0,,Kadınlar yatakhanesi mi?!Dialogue: 0,0:18:57.71,0:19:00.89,Main,Caimie,0,0,0,,Burası garson olarak çalıştığım kafe.Dialogue: 0,0:19:00.89,0:19:03.00,Main,Caimie,0,0,0,,Burada pek çok güzel denizkızı var.Dialogue: 0,0:19:04.59,0:19:05.51,Main,Usopp,0,0,0,,Sanji'nin...Dialogue: 0,0:19:05.51,0:19:07.11,Main,Chopper,0,0,0,,başı belada!Dialogue: 0,0:19:07.11,0:19:08.35,Main,Sanji,0,0,0,,Hadi oradan!Dialogue: 0,0:19:08.35,0:19:09.47,Main,Usoppu to Choppaah,0,0,0,,Geri döndü!Dialogue: 0,0:19:10.20,0:19:11.21,Main,Sanji,0,0,0,,Ben...Dialogue: 0,0:19:12.76,0:19:14.74,Main,Sanji,0,0,0,,Ben Balık Adam Adası'nda olduğum sürece...Dialogue: 0,0:19:14.76,0:19:17.22,Main,Sanji,0,0,0,,...o burun kanamalarının bilincimi kaybetmeme neden olmalarına,...Dialogue: 0,0:19:17.34,0:19:20.32,Main,Sanji,0,0,0,,...izin vermeyeceğime yemin ettim!Dialogue: 0,0:19:23.16,0:19:27.87,Main,Sanji,0,0,0,,O yüzden... Yeterince acı çekmedim mi?Dialogue: 0,0:19:28.36,0:19:29.69,Main,Usopp,0,0,0,,Sen ciddisin.Dialogue: 0,0:19:29.69,0:19:29.72,Main,Usopp,0,0,0,,Sen ciddisin.Dialogue: 0,0:19:29.72,0:19:29.76,Main,Usopp,0,0,0,,Sen ciddisin.Dialogue: 0,0:19:29.76,0:19:29.79,Main,Usopp,0,0,0,,Sen ciddisin.Dialogue: 0,0:19:29.79,0:19:29.82,Main,Usopp,0,0,0,,Sen ciddisin.Dialogue: 0,0:19:29.82,0:19:29.86,Main,Usopp,0,0,0,,Sen ciddisin.Dialogue: 0,0:19:29.86,0:19:29.89,Main,Usopp,0,0,0,,Sen ciddisin.Dialogue: 0,0:19:30.49,0:19:33.20,Main,Caimie,0,0,0,,Evet, hadi üst kata gidelim!Dialogue: 0,0:19:33.20,0:19:35.25,Main,Caimie,0,0,0,,Sizi arkadaşlarımla tanıştırırım!Dialogue: 0,0:19:39.30,0:19:40.12,Main,Luffy,0,0,0,,Bir kaplumbağa!Dialogue: 0,0:19:40.12,0:19:42.95,Sea Turtle,,0,0,0,,SEA TURTLEDialogue: 0,0:19:40.52,0:19:42.95,Main,Chopper,0,0,0,,"Deniz Kaplumbağası Asansörü" yazıyor.Dialogue: 0,0:19:44.62,0:19:46.66,Main,Caimie,0,0,0,,Kaplumbağa-chin. Bizi yukarıya çıkar, lütfen.Dialogue: 0,0:19:52.10,0:19:54.71,Main,Caimie,0,0,0,,Bunlar sualtı Mercan Apartmanları.Dialogue: 0,0:19:54.71,0:19:57.80,Main,Caimie,0,0,0,,Benim odam en ucuzu olduğu için, en aşağı katta.Dialogue: 0,0:19:57.80,0:20:01.07,Main,Caimie,0,0,0,,Güneşin parladığı en üst katlar, en pahalı olanlar.Dialogue: 0,0:20:02.20,0:20:04.01,Main,Luffy,0,0,0,,Sen fakir misin?Dialogue: 0,0:20:04.01,0:20:06.01,Main,Luffy,0,0,0,,Bu arada, Hachi ve Pappag'a ne oldu?Dialogue: 0,0:20:06.01,0:20:09.01,Main,Caimie,0,0,0,,Hacchin yaklaşık bir yıl önce feci yaralandı.Dialogue: 0,0:20:09.01,0:20:13.84,Main,Luffy,0,0,0,,Evet. Sabaody Takımadaları'nda Sunny'i koruyordu, değil mi?Dialogue: 0,0:20:13.84,0:20:17.32,Main,Caimie,0,0,0,,Yaralarının az çok iyileştiğini duydum amaDialogue: 0,0:20:17.32,0:20:21.46,Main,Caimie,0,0,0,,Hacchin aslen Balık Adam Bölgesi'nin bir sakini, o yüzden orada iyileşiyor.Dialogue: 0,0:20:22.48,0:20:23.70,Main,Usopp,0,0,0,,Balık Adam Bölgesi mi?Dialogue: 0,0:20:24.52,0:20:29.91,Main,Caimie,0,0,0,,Biraz korkunç bir yer, ama eğer siz de benimle gelirseniz, sizi gezdirmekten çekinmem.Dialogue: 0,0:20:29.91,0:20:33.47,Main,Luffy,0,0,0,,Sonra da oraya gidelim! Hachi ile buluşup teşekkür etmem gerek sonuçta.Dialogue: 0,0:20:33.47,0:20:35.22,Main,Caimie,0,0,0,,Elbette, anladım.Dialogue: 0,0:20:35.22,0:20:38.06,Main,Caimie,0,0,0,,Ah... Ve Pappag...Dialogue: 0,0:20:38.06,0:20:41.10,Main,Caimie,0,0,0,,O çok ünlü bir tasarımcı olduğu içinDialogue: 0,0:20:41.10,0:20:46.45,Main,Caimie,0,0,0,,Balık Adam Adası'nın en lüks kısmı olan Gyoverly Hills'de devasa bir malikanesi var!Dialogue: 0,0:20:46.45,0:20:49.94,Main,Caimie,0,0,0,,Ona bugün midye götürmeye gideceğim zaten. Beraber gidelim mi?Dialogue: 0,0:20:50.15,0:20:51.76,Main,Luffy,0,0,0,,Sen onun sahibi değil misin?Dialogue: 0,0:20:52.37,0:20:54.11,Main,Luffy,0,0,0,,Neden beraber yaşamıyorsunuz?Dialogue: 0,0:20:55.28,0:20:58.43,Main,Caimie,0,0,0,,Ben o şehre çok fazla uymuyorum.Dialogue: 0,0:20:58.89,0:21:01.37,Main,Caimie,0,0,0,,Ve bu bölgedeki midyelerin tadı daha güzel zaten.Dialogue: 0,0:21:02.44,0:21:05.16,Main,Usopp,0,0,0,,Hey, o pipet benzeri şey de ne?Dialogue: 0,0:21:05.16,0:21:06.45,Main,Caimie,0,0,0,,Ah, o...Dialogue: 0,0:21:06.74,0:21:10.24,Main,Caimie,0,0,0,,adanın baloncuk esnafları tarafından yapılan, Su Yolu.Dialogue: 0,0:21:10.24,0:21:13.84,Main,Caimie,0,0,0,,Balıklar ve benim gibiler onda yüzer.Dialogue: 0,0:21:14.28,0:21:15.82,Main,Caimie,0,0,0,,Sadece izleyin!Dialogue: 0,0:21:21.72,0:21:24.62,Main,Usopp,0,0,0,,Yüzeye ulaştık!Dialogue: 0,0:21:24.62,0:21:27.59,Main,Caimie,0,0,0,,Bakın! Havada bile yüzebiliyorum!Dialogue: 0,0:21:28.73,0:21:30.06,Main,Luffy,0,0,0,,Eğlenceli duruyor!Dialogue: 0,0:21:30.06,0:21:30.98,Main,Usopp,0,0,0,,Ha?Dialogue: 0,0:21:30.98,0:21:36.08,Main,Usopp,0,0,0,,Hey, bekle! Daha da önemlisi,  derin denizde bulutlar ve gökyüzü var!Dialogue: 0,0:21:36.08,0:21:38.20,Main,Mermaid,0,0,0,,Hey, Camie!Dialogue: 0,0:21:38.86,0:21:40.09,Main,Sanji,0,0,0,,Bir kadın sesi!Dialogue: 0,0:21:40.77,0:21:42.49,Main,Caimie,0,0,0,,Millet!Dialogue: 0,0:21:43.66,0:21:47.78,Main,Maameidzu,0,0,0,,Arkadaşların artık iyi mi? Boğulan korsanları kastediyorum.Dialogue: 0,0:21:50.27,0:21:53.85,Main,Maameidzu,0,0,0,,Girişten girmeyenler sizsiniz, değil mi?Dialogue: 0,0:21:56.33,0:21:59.58,Main,Maameidzu,0,0,0,,Merhaba. O kadar da korkunç gözükmüyorsunuz.Dialogue: 0,0:21:59.58,0:22:03.91,Main,Maameidzu,0,0,0,,Kaçak göçmenler mi? Ne çılgınca! Korsanları gerçekten çok severim.Dialogue: 0,0:22:06.00,0:22:08.68,Main,Usopp,0,0,0,,Neredeyse bir peri masalı dünyası gibi!Dialogue: 0,0:22:08.68,0:22:12.75,Main,Usopp,0,0,0,,Mercan bölgesi! Denizkızlarının körfezi!Dialogue: 0,0:22:15.72,0:22:17.48,Main,Chopper,0,0,0,,Sanji ağlıyor mu?!Dialogue: 0,0:22:17.48,0:22:20.55,Main,Luffy,0,0,0,,Baratie'den ayrıldığı zamankinden bile daha çok ağlıyor.Dialogue: 0,0:22:23.22,0:22:25.57,Main,Sanji,0,0,0,,Sonunda buldum!Dialogue: 0,0:22:26.36,0:22:29.60,Main,Sanji,0,0,0,,Burası benim All Blue'm!Dialogue: 0,0:22:31.90,0:22:34.46,Main,Usopp,0,0,0,,Bundan emin misin, Sanji?Dialogue: 0,0:22:35.74,0:22:37.61,Main,Caimie,0,0,0,,Onlara sizi tanıtacağım.Dialogue: 0,0:22:38.02,0:22:40.28,Main,Caimie,0,0,0,,Bu kaptan Luffy-chin!Dialogue: 0,0:22:40.82,0:22:42.72,Main,Caimie,0,0,0,,Ağlayan Sanji-chin!Dialogue: 0,0:22:43.22,0:22:44.65,Main,Caimie,0,0,0,,Burunlu olan Usopp-chin!Dialogue: 0,0:22:44.98,0:22:46.70,Main,Caimie,0,0,0,,Tanuki de Chopper-chin!Dialogue: 0,0:22:47.34,0:22:48.32,Main,Chopper,0,0,0,,Ren geyiğiyim ben!Dialogue: 0,0:22:49.19,0:22:51.62,Main,Maameidzu,0,0,0,,Ne oldu? Neden ağlıyorsun?Dialogue: 0,0:22:53.51,0:22:56.86,Main,Maameidzu,0,0,0,,Hoşgeldin! Hadi denizde beraber dans edelim!Dialogue: 0,0:23:01.85,0:23:04.38,Main,Sanji,0,0,0,,Evet... Şimdi anlıyorum.Dialogue: 0,0:23:04.38,0:23:07.05,Main,Sanji,0,0,0,,Böyle bir mutluluğun var olması imkansız.Dialogue: 0,0:23:07.05,0:23:09.92,Main,Sanji,0,0,0,,Bugün ölmüş olmam lazım.Dialogue: 0,0:23:09.92,0:23:11.77,Main,Usopp,0,0,0,,Negatif!Dialogue: 0,0:23:11.77,0:23:14.83,Main,Usopp,0,0,0,,Cidden, bu son iki yılda sana ne oldu?!Dialogue: 0,0:23:14.83,0:23:18.14,Main,Usopp,0,0,0,,Hep hayalini kurduğun cennet değil mi bu ada?!Dialogue: 0,0:23:19.29,0:23:22.41,Main,Luffy,0,0,0,,Çok komiksin, Sanji!Dialogue: 0,0:23:23.77,0:23:28.32,Main,Mermaid,0,0,0,,Bu varil Camie'nin arkadaşları ile beraber kıyıya vurdu. İçinde ne var acaba?Dialogue: 0,0:23:28.32,0:23:30.30,Main,Mermaid,0,0,0,,İçki? Hazine?Dialogue: 0,0:23:30.30,0:23:34.52,Main,Mermaid,0,0,0,,Kim bilir... Çok sıkı bir şekilde kapatılmış gerçi.Dialogue: 0,0:23:35.01,0:23:37.94,Main,Mermaid,0,0,0,,Ne dersin? Gizlice açmalı mıyız?Dialogue: 0,0:23:45.32,0:23:48.02,Main,Hody,0,0,0,,Hasır Şapka Luffy...Dialogue: 0,0:23:48.02,0:23:50.37,Main,Hody,0,0,0,,sonunda buraya mı geldi?Dialogue: 0,0:23:48.74,0:23:50.37,Captions,,0,0,180,,Balık Adam Bölgesi "Noah"Dialogue: 0,0:23:51.31,0:23:52.37,Main,Hammond,0,0,0,,E-Evet...Dialogue: 0,0:23:52.37,0:23:56.37,Main,Hammond,0,0,0,,N-Ne yapmalıyız, patron?Dialogue: 0,0:23:58.59,0:24:02.92,Main,Hody,0,0,0,,Onu buraya... getir.Dialogue: 0,0:00:39.81,0:00:43.07,Credits,,0,0,0,,Translation & initial timing Yibis FansubsDialogue: 0,0:00:45.24,0:00:48.84,Credits,,0,0,0,,Timing Galaxy 9000  Time-checking SewilDialogue: 0,0:00:50.20,0:00:54.26,Credits,,0,0,0,,Quality-checking Sewil Galaxy 9000 FeesoDialogue: 0,0:00:54.59,0:00:58.79,Credits,,0,0,0,,Soundtracking HaleeDialogue: 0,0:01:16.42,0:01:18.52,Credits,,0,0,0,,Video editing Sewil