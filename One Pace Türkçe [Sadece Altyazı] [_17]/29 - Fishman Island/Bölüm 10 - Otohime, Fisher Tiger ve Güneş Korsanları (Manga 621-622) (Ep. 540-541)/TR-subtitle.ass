,&H001D221E,&H000000FF,&H001D221E,&H00000000,0,0,0,0,100,100,0,0,1,0.5,0,2,10,10,10,1Style: We Go lyrics,Duality,40.0,&H0098594E,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2.0,0,8,10,10,16,1Style: Author,Impress BT,20.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.7,0.7,9,10,10,10,1Style: Attack,Duality,32.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.0,1.0,7,12,12,12,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:02.99,0:00:08.38,Main,,0,0,0,,Dünyanın sunabileceği her şeyi elde eden adam, Korsanlar Kralı Gold Roger.Dialogue: 0,0:00:08.38,0:00:13.00,Main,,0,0,0,,Son sözleri dünyanın her yerinden maceracıları denize çekti.Dialogue: 0,0:00:13.00,0:00:14.68,Main,,0,0,0,,"Hazinem mi?"Dialogue: 0,0:00:14.68,0:00:16.22,Main,,0,0,0,,"İstiyorsanız, size vereceğim!"Dialogue: 0,0:00:16.22,0:00:17.42,Main,,0,0,0,,"Arayın ve bulun!"Dialogue: 0,0:00:17.42,0:00:19.87,Main,,0,0,0,,"Bu dünyanın sunabileceği her şeyi orada bıraktım!"Dialogue: 0,0:00:19.87,0:00:22.69,Main,,0,0,0,,Korsanlar hayallerinin peşinden yola çıktılar!Dialogue: 0,0:00:22.69,0:00:25.35,Main,,0,0,0,,Dünya, Büyük Korsan Çağı'na girdi!Dialogue: 0,0:00:25.35,0:00:29.31,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪Dialogue: 0,0:00:29.31,0:00:33.81,We Go lyrics,,0,0,0,,♪ Şafak vakti gelmedi bile ve ben bekleyemiyorum! ♪Dialogue: 0,0:00:33.81,0:00:37.48,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı, dört... Gidelim! ♪Dialogue: 0,0:00:38.97,0:00:43.05,We Go lyrics,,0,0,0,,♪ Bayrağımızı dalgalandıralım, macera şafağının doğuşuna. ♪Dialogue: 0,0:00:44.41,0:00:49.74,We Go lyrics,,0,0,0,,♪ Dalgalar yapalım, bizi uykumuzdan kaldırsınlar. ♪Dialogue: 0,0:00:49.74,0:00:54.28,We Go lyrics,,0,0,0,,♪ Eğer inanılmaz bir dünyaya gitmek istiyorsan,Dialogue: 0,0:00:54.28,0:00:58.79,We Go lyrics,,0,0,0,, gerekli olan şey senin dayanıklılığın. ♪Dialogue: 0,0:00:59.11,0:01:01.73,We Go lyrics,,0,0,0,,♪ Fazla dikkat çekmek, bu bir suç mu? ♪Dialogue: 0,0:01:01.73,0:01:04.62,We Go lyrics,,0,0,0,,♪ Aranıyor → Kazanan demektir! ♪Dialogue: 0,0:01:04.62,0:01:10.50,We Go lyrics,,0,0,0,,♪ Özgür olmak bizim tek kuralımız! ♪Dialogue: 0,0:01:10.50,0:01:15.99,We Go lyrics,,0,0,0,,♪ Endişelerinizi unutun, bırakın rüzgar essin. ♪Dialogue: 0,0:01:15.99,0:01:18.53,We Go lyrics,,0,0,0,,♪ Ne pahasına olursa olsun, One Piece'i ilk biz bulacağız! ♪Dialogue: 0,0:01:18.53,0:01:22.66,We Go lyrics,,0,0,0,,♪ Hayal kuran kalplerimiz, çok büyük... ♪Dialogue: 0,0:01:22.66,0:01:26.93,We Go lyrics,,0,0,0,,♪ Onları uyandırmamak önemli. ♪Dialogue: 0,0:01:26.93,0:01:29.57,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪Dialogue: 0,0:01:29.57,0:01:33.54,We Go lyrics,,0,0,0,,♪ Şafak vakti gelmedi bile ve ben bekleyemiyorum! ♪Dialogue: 0,0:01:33.54,0:01:37.33,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı, dört... Gidelim! ♪Dialogue: 0,0:01:38.76,0:01:44.72,We Go lyrics,,0,0,0,,♪ Biz... buralara kadar geldik. ♪Dialogue: 0,0:01:44.72,0:01:47.62,We Go lyrics,,0,0,0,,♪ Gideceğiz... hayallerimizin olduğu yere,Dialogue: 0,0:01:47.62,0:01:52.70,We Go lyrics,,0,0,0,, ve kimseyi arkada bırakmayacağız. ♪Dialogue: 0,0:01:52.70,0:01:55.30,We Go lyrics,,0,0,0,,♪ Hep devam edeceğiz, bu bir söz. ♪Dialogue: 0,0:01:55.30,0:01:59.47,We Go lyrics,,0,0,0,,♪ Hayallerimizin başladığı o günden beri,Dialogue: 0,0:01:59.47,0:02:03.72,We Go lyrics,,0,0,0,, belirlediğimiz gelecek, değişmedi! ♪Dialogue: 0,0:02:03.72,0:02:06.24,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪Dialogue: 0,0:02:06.24,0:02:10.61,We Go lyrics,,0,0,0,,♪ Kalbimdeki güneş, asla batmayacak! ♪Dialogue: 0,0:02:10.61,0:02:13.38,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... ♪Dialogue: 0,0:02:14.78,0:02:17.57,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... ♪Dialogue: 0,0:02:18.75,0:02:24.82,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... dört... Gidelim! ♪Dialogue: 0,0:02:27.27,0:02:29.94,We Go lyrics,,0,0,0,,♪ Gidelim! ♪Dialogue: 0,0:02:29.96,0:02:32.76,Captions,,0,0,0,,16 yıl önce, Balık Adam AdasıDialogue: 0,0:02:35.25,0:02:35.91,Main,Thief,0,0,0,,Çekilin!Dialogue: 0,0:02:37.03,0:02:38.23,Main,Bank-employee,0,0,0,,Soyuldum!Dialogue: 0,0:02:38.23,0:02:41.19,Main,Bank-employee,0,0,0,,Lütfen biri onu durdursun!Dialogue: 0,0:02:41.54,0:02:44.18,Main,Bank-employee,0,0,0,,Çok para çaldı!Dialogue: 0,0:02:46.84,0:02:48.31,Main,Thief,0,0,0,,Hey, çekilin!Dialogue: 0,0:02:48.31,0:02:52.99,Main,Thief,0,0,0,,Y-Yaklaşırsanız,  bu kızın güvenliğini garanti edemem!Dialogue: 0,0:02:57.11,0:02:57.75,Main,Right Minister,0,0,0,,Majesteleri?Dialogue: 0,0:02:59.75,0:03:01.87,Main,Right Minister,0,0,0,,Ah, Majesteleri! Lütfen durun!Dialogue: 0,0:03:02.36,0:03:05.11,Main,Right Minister,0,0,0,,Kendinizi böyle şeylere bulaştırmamalısınız!Dialogue: 0,0:03:05.11,0:03:07.57,Main,Right Minister,0,0,0,,Bu bizim işimiz!Dialogue: 0,0:03:08.50,0:03:11.31,Main,Guard,0,0,0,,Lütfen durun, Kraliçe Otohime!Dialogue: 0,0:03:12.95,0:03:14.18,Main,Thief,0,0,0,,O da kim?Dialogue: 0,0:03:14.18,0:03:15.98,Main,Thief,0,0,0,,Yaklaşmayın! Yoksa ateş ederim!Dialogue: 0,0:03:18.48,0:03:22.31,Main,Thief,0,0,0,,S-Sizi uyardım!Dialogue: 0,0:03:31.29,0:03:31.83,Main,Thief,0,0,0,,Iskaladım mı?!Dialogue: 0,0:03:32.47,0:03:34.64,Main,Thief,0,0,0,,Kahretsin! Yaklaşma!Dialogue: 0,0:03:54.06,0:03:59.16,Captions,,0,0,0,,Kral Neptune'un Karısı Kraliçe Otohime  (Japon Balığı Deniz Kızı)Dialogue: 0,0:04:00.98,0:04:04.48,Main,Fishman,0,0,0,,O... Otohime-sama mı?Dialogue: 0,0:04:04.48,0:04:05.90,Main,Otohime,0,0,0,,Acıyor!Dialogue: 0,0:04:05.90,0:04:06.49,Main,Fishman,0,0,0,,Sorun bu mu?!Dialogue: 0,0:04:07.00,0:04:08.21,Main,Otohime,0,0,0,,Elim!Dialogue: 0,0:04:08.21,0:04:08.99,Main,Right Minister,0,0,0,,Doktor!Dialogue: 0,0:04:09.42,0:04:12.20,Main,Doctor,0,0,0,,Majesteleri! İzin verin bakayım.Dialogue: 0,0:04:14.20,0:04:15.91,Main,Doctor,0,0,0,,Açık kırık.Dialogue: 0,0:04:15.91,0:04:17.85,Main,Fishman,0,0,0,,Tek bir yumruktan mı?!Dialogue: 0,0:04:21.26,0:04:26.90,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Kazasker thx to onepace.netDialogue: 0,0:17:19.60,0:17:29.60,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Kazasker thx to onepace.netDialogue: 0,0:35:08.50,0:35:11.30,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Kazasker thx to onepace.netDialogue: 0,0:04:21.26,0:04:26.90,Title,,0,0,0,,Otohime, Fisher Tiger ve Güneş KorsanlarıDialogue: 0,0:04:18.31,0:04:19.51,Main,Otohime,0,0,0,,Farketmez.Dialogue: 0,0:04:21.17,0:04:23.40,Main,Doctor,0,0,0,,K-Kraliçe Otohime.Dialogue: 0,0:04:25.19,0:04:26.80,Main,Thief,0,0,0,,Kraliçe.Dialogue: 0,0:04:27.22,0:04:30.93,Main,Otohime,0,0,0,,Neden hırsızlık gibi aşağılık bir işe kalkıştın?!Dialogue: 0,0:04:30.93,0:04:34.93,Main,Thief,0,0,0,,Kapa çeneni!  Siz zengin saray halkı ne anlarsınız?!Dialogue: 0,0:04:35.34,0:04:39.53,Main,Thief,0,0,0,,Evde on çocuğum var ve  hepsi açlıktan ağlıyor!Dialogue: 0,0:04:40.55,0:04:41.73,Main,Otohime,0,0,0,,Bu daha da kötü ya!Dialogue: 0,0:04:45.82,0:04:49.28,Main,Right Minister,0,0,0,,M-Majesteleri!  Lütfen ona vurmayı bırakın.Dialogue: 0,0:04:49.58,0:04:52.95,Main,Right Minister,0,0,0,,Bedeninizin normal bir insanınkinden daha narin olduğunu biliyorsunuz!Dialogue: 0,0:04:52.95,0:04:55.73,Main,Otohime,0,0,0,,Umrumda değil! Bu kendi iyiliği için!Dialogue: 0,0:04:55.73,0:04:59.61,Main,Otohime,0,0,0,,Ellerim parçalansa bile,  anlamasını sağlamalıyım!Dialogue: 0,0:05:04.99,0:05:09.66,Main,Otohime,0,0,0,,Çalıntı parayla büyütülen çocukların gerçekten mutlu olabileceğine inanıyor musun?!Dialogue: 0,0:05:09.85,0:05:13.24,Main,Otohime,0,0,0,,Bir adam çocuklarının gurur duyabileceği bir hayat sürmeli!Dialogue: 0,0:05:15.00,0:05:16.03,Main,Otohime,0,0,0,,Ancak...Dialogue: 0,0:05:17.38,0:05:21.56,Main,Otohime,0,0,0,,...aynı zamanda özür de dilemek istiyorum.Dialogue: 0,0:05:22.46,0:05:24.60,Main,Otohime,0,0,0,,Çok üzgünüm!Dialogue: 0,0:05:26.24,0:05:28.15,Main,Otohime,0,0,0,,Ben kraliçenizim...Dialogue: 0,0:05:28.15,0:05:33.71,Main,Otohime,0,0,0,,...ama aynı krallıkta yaşamamıza rağmen acı çektiğini göremedim.Dialogue: 0,0:05:34.44,0:05:38.55,Main,Otohime,0,0,0,,Kalbinde hissettiğin acı...Dialogue: 0,0:05:39.16,0:05:40.97,Main,Otohime,0,0,0,,...benim kalbimi de delip geçiyor.Dialogue: 0,0:05:44.20,0:05:46.64,Main,Otohime,0,0,0,,Yüzleştiğin zorluklar korkunç olmalı.Dialogue: 0,0:05:48.19,0:05:51.67,Main,Thief,0,0,0,,Ben de yapmak istemedim!Dialogue: 0,0:05:51.67,0:05:55.60,Main,Thief,0,0,0,,Ama başka çarem yoktu!Dialogue: 0,0:05:55.60,0:06:00.81,Main,Thief,0,0,0,,Dükkanım yandı.  Biri dükkanımı yaktı ve tüm paramı çaldı!Dialogue: 0,0:06:01.33,0:06:04.87,Main,Thief,0,0,0,,İşim yok ve borcum çok fazla.Dialogue: 0,0:06:04.87,0:06:08.12,Main,Thief,0,0,0,,Çocuklarım açlıktan kırılıyor ve onlar için çok üzülüyorum!Dialogue: 0,0:06:10.55,0:06:11.99,Main,Otohime,0,0,0,,Demek bu yüzden.Dialogue: 0,0:06:12.61,0:06:15.91,Main,Otohime,0,0,0,,Anlıyorum. Çok iyi anlıyorum.Dialogue: 0,0:06:15.91,0:06:17.15,Main,Otohime,0,0,0,,Ama yine de yaptığın yanlıştı!Dialogue: 0,0:06:17.15,0:06:18.18,Main,Fishmen,0,0,0,,Ne?!!Dialogue: 0,0:06:18.18,0:06:21.94,Main,Otohime,0,0,0,,Sana yapılanın aynısını yaparsan, talihsizlik zincirini devam ettirmiş olursun!Dialogue: 0,0:06:21.94,0:06:23.20,Main,Thief,0,0,0,,Üzgünüm!Dialogue: 0,0:06:23.20,0:06:25.81,Main,Otohime,0,0,0,,Yine de beni affet!Dialogue: 0,0:06:25.81,0:06:29.79,Main,Otohime,0,0,0,,Senin yanında olamadığımız için bu bizim de suçumuz!Dialogue: 0,0:06:29.79,0:06:32.26,Main,Thief,0,0,0,,Hayır, siz çok iyisiniz.Dialogue: 0,0:06:32.26,0:06:35.01,Main,Thief,0,0,0,,Böylesine güzel sözleri hak etmiyorum.Dialogue: 0,0:06:35.01,0:06:36.88,Main,Otohime,0,0,0,,Ama yine de yanlıştı!Dialogue: 0,0:06:36.88,0:06:38.45,Main,Thief,0,0,0,,Üzgünüm!Dialogue: 0,0:06:38.45,0:06:40.27,Main,Otohime,0,0,0,,Ama yine de yanlıştı!Dialogue: 0,0:06:40.27,0:06:42.95,Main,Thief,0,0,0,,Söz veriyorum,  kendime çeki düzen vereceğim!Dialogue: 0,0:06:42.95,0:06:46.54,Main,Thief,0,0,0,,Benim gibi biri yüzünden ağladığınız için teşekkür ederim!Dialogue: 0,0:06:46.54,0:06:48.19,Main,Thief,0,0,0,,Majestleri!Dialogue: 0,0:06:48.19,0:06:51.35,Main,Otohime,0,0,0,,Bu mükemmel!  Lütfen, elinden geleni yap!Dialogue: 0,0:06:51.35,0:06:57.63,Main,Fishman,0,0,0,,Kraliyet ailesinin Ryugu Sarayı'ndan çıkıp krallıkta dolaşması olağanüstü bir durum.Dialogue: 0,0:06:57.63,0:07:01.92,Main,Fishman,0,0,0,,Ama tek bir yurttaşın hatrına gözyaşı döküp tokat atmaya istekli.Dialogue: 0,0:07:01.92,0:07:06.45,Main,Fishman,0,0,0,,Otohime-sama gerçekten sıradışı bir kraliçe!Dialogue: 0,0:07:06.45,0:07:11.43,Main,Fishman,0,0,0,,Gerçekten sevecen biri. Bakın!  Çocuklar bile onu çok seviyor!Dialogue: 0,0:07:11.43,0:07:13.30,Main,Children,0,0,0,,Otohime-sama!Dialogue: 0,0:07:14.71,0:07:17.91,Main,Otohime,0,0,0,,Tüm bunları sizin için yapıyorum çocuklar.Dialogue: 0,0:07:19.26,0:07:20.69,Main,Fishmen,0,0,0,,Ne?!!Dialogue: 0,0:07:20.69,0:07:24.85,Main,Otohime,0,0,0,,Burnun akıyor. Kendi iyiliğin için seni tokatlamam gerekiyordu!Dialogue: 0,0:07:25.73,0:07:29.14,Main,Otohime,0,0,0,,Burun deliğinin tekinden sümük akarken ahmak gibi görünüyorsun.Dialogue: 0,0:07:29.14,0:07:32.05,Main,Otohime,0,0,0,,Burnun akacaksa, iki delikten birden akmalı.Dialogue: 0,0:07:35.94,0:07:38.25,Main,Fishman,0,0,0,,Çok dokunaklı!Dialogue: 0,0:07:38.25,0:07:39.61,Main,Fishman,0,0,0,,Öyle mi?Dialogue: 0,0:07:40.18,0:07:43.07,Main,Jinbe,0,0,0,,Tutkuyla seven biri.Dialogue: 0,0:07:43.07,0:07:48.05,Main,Jinbe,0,0,0,,Kraliçe Otohime her gün Ryugu Sarayı'ndan aşağı iner...Dialogue: 0,0:07:48.05,0:07:50.63,Main,Jinbe,0,0,0,,...ve krallıktaki yurttaşların ilgisini çekerdi.Dialogue: 0,0:07:50.63,0:07:54.67,Main,Otohime,0,0,0,,Ryugu Krallığı'nı yüzeye çıkarmalıyız!Dialogue: 0,0:07:54.67,0:07:58.86,Main,Otohime,0,0,0,,"Derilerinin rengi farklı. Vücutlarının şekli de."Dialogue: 0,0:07:58.86,0:08:03.68,Main,Otohime,0,0,0,,Böyle düşünen insanların bizi anlamasını beklememeliyiz.Dialogue: 0,0:08:03.68,0:08:07.43,Main,Otohime,0,0,0,,Bunun yerine onlara bizzat yaklaşmalı ve tarzlarını öğrenmeliyiz.Dialogue: 0,0:08:08.17,0:08:11.27,Main,Otohime,0,0,0,,Deniz tabanıyla yüzey arasında on bin metre var.Dialogue: 0,0:08:11.27,0:08:14.66,Main,Otohime,0,0,0,,Bu mesafe insanların düşünme şekliyle bizimkini ayırıyor.Dialogue: 0,0:08:18.41,0:08:20.30,Main,Otohime,0,0,0,,Yanlış anlamayın!Dialogue: 0,0:08:20.30,0:08:24.91,Main,Otohime,0,0,0,,Bu adaya gelen insanlar,  korsanlar denilen belli bir insan türünden.Dialogue: 0,0:08:25.45,0:08:30.79,Main,Otohime,0,0,0,,Köle tacirlerinden insanları satın alanlar ise Soylular denilen elit bir azınlık.Dialogue: 0,0:08:30.79,0:08:35.41,Main,Otohime,0,0,0,,Sadece belli insan türleriyle temas kurduğumuz için kötü etkilendik.Dialogue: 0,0:08:35.41,0:08:38.33,Main,Otohime,0,0,0,,Henüz onlar hakkında hiçbir şey bilmiyoruz.Dialogue: 0,0:08:38.33,0:08:41.55,Main,Otohime,0,0,0,,Kesinlikle yüzeyde de iyi kalpli insanlar olmalı!Dialogue: 0,0:08:42.00,0:08:47.06,Main,Otohime,0,0,0,,Aynı güneşin altında birlikte yaşayabilmek için krallığımızı yukarı çıkaracağız!Dialogue: 0,0:08:49.39,0:08:55.50,Main,Otohime,0,0,0,,Bu yılki dünya konseyi toplantısında, onların dünyasına göç etmek istediğimizi ifade edelim!Dialogue: 0,0:08:55.50,0:08:57.61,Main,Otohime,0,0,0,,Lütfen hepiniz bu dilekçeyi imzalayın.Dialogue: 0,0:09:01.69,0:09:06.06,Main,Fishman,0,0,0,,Kraliçe Otohime,  siz istiyor olsanız bile emin değilim.Dialogue: 0,0:09:06.06,0:09:09.58,Main,Fishman,0,0,0,,İnsanlarla uzlaşma konusunda emin değilim.Dialogue: 0,0:09:13.83,0:09:15.68,Main,Otohime,0,0,0,,Öyle dememelisiniz.Dialogue: 0,0:09:15.68,0:09:19.55,Main,Otohime,0,0,0,,İmkansız olduğunu düşündüğümüz için asla denememek yerine ilk adımı kendimiz atmalıyız!Dialogue: 0,0:09:21.72,0:09:22.66,Main,Otohime,0,0,0,,Hadi!Dialogue: 0,0:09:24.43,0:09:25.94,Main,Fishman,0,0,0,,Üzgünüm.Dialogue: 0,0:09:30.18,0:09:34.84,Main,Jinbe,0,0,0,,Faydasız. Tarih cevabını çoktan verdi.Dialogue: 0,0:09:40.72,0:09:42.85,Main,Otohime,0,0,0,,Ben geldim çocuklar.Dialogue: 0,0:09:42.85,0:09:45.36,Main,Tha Princes,0,0,0,,Hoşgeldin, anne!Dialogue: 0,0:09:50.70,0:09:53.07,Main,Otohime,0,0,0,,Ben geldim, Shirahoshi.Dialogue: 0,0:10:02.72,0:10:06.23,Main,Otohime,0,0,0,,Ah, Shirahoshi, huzur vaham.Dialogue: 0,0:10:06.23,0:10:08.02,Main,Otohime,0,0,0,,Geciktiğim için üzgünüm.Dialogue: 0,0:10:11.00,0:10:15.55,Main,Otohime,0,0,0,,Ah, burnundan sümük akıyor  ama yine de çok sevimlisin.Dialogue: 0,0:10:16.10,0:10:19.62,Main,Fukaboshi,0,0,0,,Anne, sürekli onun yanındaydık, bu yüzden keyfi yerinde!Dialogue: 0,0:10:19.62,0:10:21.23,Main,Princes,0,0,0,,Yerinde, yerinde!Dialogue: 0,0:10:21.23,0:10:23.06,Main,Otohime,0,0,0,,Sağolun, canım prenslerim.Dialogue: 0,0:10:23.85,0:10:27.05,Main,Manboshi,0,0,0,,Anne, elin iyi mi?Dialogue: 0,0:10:27.05,0:10:29.11,Main,Otohime,0,0,0,,Ah, endişelenecek bir şey yok.Dialogue: 0,0:10:30.80,0:10:36.83,Main,Otohime,0,0,0,,Anneniz, içinde yaşayacağınız geleceğinizi değiştirecek!Dialogue: 0,0:10:39.08,0:10:45.38,Main,Left Minister,0,0,0,,Majesteleri konuşma yapmak istiyorsa,  video yayınını kullanmalı.Dialogue: 0,0:10:45.84,0:10:51.08,Main,Neptune,0,0,0,,Gözlem Haki'siyle doğduğu için öyle-jamon.Dialogue: 0,0:10:51.08,0:10:53.54,Main,Neptune,0,0,0,,Gökyüzündeki bir saraydan konuşmak istemiyor.Dialogue: 0,0:10:53.54,0:10:56.80,Main,Neptune,0,0,0,,Kalplerini hissedecek kadar onlara yakın olarak,  onlarla doğrudan yüzleşmek istiyor.Dialogue: 0,0:10:56.80,0:11:01.80,Main,Neptune,0,0,0,,Otohime'nin doğru olduğuna inandığı şey bu.  Ben bile onu durduramam.Dialogue: 0,0:11:01.80,0:11:07.12,Main,Right Minister,0,0,0,,Ama adada çok fazla insan korsan var.Dialogue: 0,0:11:07.12,0:11:12.74,Main,Left Minister,0,0,0,,Arkadaşınız korsan Beyazsakal'ın otoritesiyle korunsak bile...Dialogue: 0,0:11:12.74,0:11:15.19,Main,Left Minister,0,0,0,,...ne olacağı asla belli olmaz.Dialogue: 0,0:11:15.19,0:11:18.20,Main,Neptune,0,0,0,,O bunun farkında.Dialogue: 0,0:11:19.09,0:11:26.84,Main,Neptune,0,0,0,,Otohime'nin hayalini kurduğu dünya, yüzlerce yıl öncesinde dayanan bir tutku.Dialogue: 0,0:11:28.99,0:11:36.47,Main,Neptune,0,0,0,,Uzak atalarımız da aynı hayale sahipti ama kendi zamanlarında bunu asla farkedemediler.Dialogue: 0,0:11:37.50,0:11:39.60,Main,Left Minister,0,0,0,,Ne demek istiyorsunuz?!Dialogue: 0,0:11:40.94,0:11:44.60,Main,Neptune,0,0,0,,Otohime'yi durduramam.Dialogue: 0,0:11:45.04,0:11:47.60,Main,Neptune,0,0,0,,Benim adıma onu mutlaka koruyun.Dialogue: 0,0:11:47.60,0:11:48.44,Main,Right Minister,0,0,0,,Emredersiniz!Dialogue: 0,0:11:50.04,0:11:53.63,Main,Nami,0,0,0,,Bu Otohime-san epey tuhaf biriymiş, değil mi?Dialogue: 0,0:11:53.63,0:11:57.09,Main,Chopper,0,0,0,,Sürekli ağlıyorsun.  Annene mi çekmişsin ne?Dialogue: 0,0:11:57.09,0:12:00.43,Main,Shirahoshi,0,0,0,,Şey... B-Bilmem.Dialogue: 0,0:12:00.43,0:12:03.10,Main,Sanji,0,0,0,,Bu ülkede asker miydin?Dialogue: 0,0:12:04.21,0:12:10.77,Main,Jinbe,0,0,0,,Balık Adam Bölgesi'nde büyüdüğüm ve sadece iyi dövüşmeyi bildiğim için, tek seçeneğim buydu.Dialogue: 0,0:12:11.55,0:12:12.69,Main,Sanji,0,0,0,,Balık Adam Bölgesi?Dialogue: 0,0:12:12.69,0:12:15.94,Main,Chopper,0,0,0,,Hachi, orası senin de geldiğin yer değil mi?Dialogue: 0,0:12:16.55,0:12:19.36,Main,Chopper,0,0,0,,Korkunç bir yere benziyor.Dialogue: 0,0:12:19.36,0:12:23.05,Main,Jinbe,0,0,0,,Öyle. Gerçi eskiden...Dialogue: 0,0:12:23.05,0:12:27.98,Main,Jinbe,0,0,0,,...akrabası olmayan çocuklarla ilgilenen devasa bir yetimhaneydi.Dialogue: 0,0:12:27.98,0:12:33.84,Main,Jinbe,0,0,0,,Ama çok geçmeden oranın sakinleri kavga etmeye başladı ve idarenin baş edemeyeceği hâle geldi.Dialogue: 0,0:12:33.84,0:12:39.17,Main,Jinbe,0,0,0,,Balık Adam Adası'ndaki tüm serserilerin toplandığı kanunsuz bir bölge hâline geldi.Dialogue: 0,0:12:40.34,0:12:44.49,Main,Jinbe,0,0,0,,Balık Adam Bölgesi'nin lideri olan Fisher Tiger,...Dialogue: 0,0:12:44.49,0:12:47.99,Main,Jinbe,0,0,0,,...macera yaşamak için sonunda ülkeyi terketti.Dialogue: 0,0:12:47.99,0:12:52.28,Main,Jinbe,0,0,0,,Bense onun yerine geçmem gerekirken kraliyet ordusuna katıldım.Dialogue: 0,0:12:53.04,0:12:56.46,Main,Jinbe,0,0,0,,Macro Tayfası, balık adam olmalarına rağmen kendileri köle taciri oldular.Dialogue: 0,0:12:57.67,0:12:59.50,Main,Jinbe,0,0,0,,Diğerleriyse...Dialogue: 0,0:13:00.37,0:13:02.78,Main,Jinbe,0,0,0,,...kendi yollarına gittiler.Dialogue: 0,0:13:04.20,0:13:06.62,Main,Jinbe,0,0,0,,Sonra bir gün...Dialogue: 0,0:13:07.42,0:13:09.16,Main,Mermaid,0,0,0,,Lütfen geri ver!Dialogue: 0,0:13:09.16,0:13:11.17,Main,Arlong,0,0,0,,Geri istiyorsan, neden almaya çalışmıyorsun?Dialogue: 0,0:13:11.51,0:13:12.72,Main,Fishman,0,0,0,,Onu geri ver!Dialogue: 0,0:13:12.72,0:13:15.40,Main,Fishman,0,0,0,,O kağıtlarda kaç tane imza olduğundan haberin var mı senin?!Dialogue: 0,0:13:15.40,0:13:18.31,Main,Arlong,0,0,0,,Kaç imza olduğunu neden umursayayım?!Dialogue: 0,0:13:19.95,0:13:23.60,Main,Guard,0,0,0,,Hey, dur bakalım! Sen Balık Adam Bölgesi'nden Arlong'sun, değil mi?!Dialogue: 0,0:13:26.25,0:13:28.71,Main,Arlong,0,0,0,,Balık Adam Bölgesi'nden Arlong mu?Dialogue: 0,0:13:31.13,0:13:32.64,Main,Guard,0,0,0,,B-Bırak beni!Dialogue: 0,0:13:32.64,0:13:34.59,Main,Arlong,0,0,0,,Bu tam olarak doğru değil.Dialogue: 0,0:13:34.98,0:13:39.98,Captions,,0,0,0,,Arlong Korsanları'nın Kaptanı  Arlong, 25 yaşındaDialogue: 0,0:13:35.37,0:13:39.72,Main,Arlong,0,0,0,,Ben, Arlong Korsanları'nın kaptanı Arlong'um!Dialogue: 0,0:13:39.72,0:13:42.17,Main,Arlong,0,0,0,,Su altında nefes alamamalarına rağmen...Dialogue: 0,0:13:42.17,0:13:47.11,Main,Arlong,0,0,0,,...istedikleri gibi buraya girip çıkan aşağılık korsanları avlayarak yaşıyorum.Dialogue: 0,0:13:47.11,0:13:50.17,Main,Arlong,0,0,0,,Sizin yerinize korsanları avlıyorum!Dialogue: 0,0:13:50.17,0:13:53.27,Main,Arlong,0,0,0,,Neptune Ordusu minnetini göstermek için bana ödeme yapmalı!Dialogue: 0,0:13:53.27,0:13:56.78,Main,Guard,0,0,0,,P-Patron Jinbe.  Oturup seyretmeyi bırak da bana yardım et!Dialogue: 0,0:13:56.78,0:13:58.19,Main,Arlong,0,0,0,,Jinbe?Dialogue: 0,0:13:58.54,0:14:07.44,Captions,Arlong,0,0,150,,Ryugu Krallığı, Neptune Ordusu'nda Asker Jinbe, 30 yaşındaDialogue: 0,0:14:00.45,0:14:04.30,Main,Jinbe,0,0,0,,Hey, serseri. Bırak şu çaylağı!Dialogue: 0,0:14:04.30,0:14:06.83,Main,Jinbe,0,0,0,,O benim adamım.Dialogue: 0,0:14:06.83,0:14:11.18,Main,Jinbe,0,0,0,,Ayrıca o imzalı kağıtlar ilgimi çekmiyor olsa da,...Dialogue: 0,0:14:11.18,0:14:14.13,Main,Jinbe,0,0,0,,...kraliçe için önem arz ediyor.  Bu yüzden geri ver!Dialogue: 0,0:14:14.55,0:14:16.61,Main,Fishman,0,0,0,,Neptune Ordusu'ndan Patron Jinbe!Dialogue: 0,0:14:16.61,0:14:17.34,Main,Fishman,0,0,0,,Kurtulduk!Dialogue: 0,0:14:19.01,0:14:22.65,Main,Arlong,0,0,0,,Patron, ha? Bu isim sana yakışmış!Dialogue: 0,0:14:22.65,0:14:25.64,Main,Arlong,0,0,0,,Sonuçta mafya babası gibi davranan başka asker bulamazsın!Dialogue: 0,0:14:25.64,0:14:27.93,Main,Jinbe,0,0,0,,Dediğimi yap, Arlong!Dialogue: 0,0:14:29.52,0:14:31.95,Main,Arlong,0,0,0,,Tamam, anladım. İşte.Dialogue: 0,0:14:32.81,0:14:34.52,Main,Arlong,0,0,0,,Alın işte!Dialogue: 0,0:14:34.52,0:14:36.73,Main,Arlong,0,0,0,,Bu kadar kızma abi.Dialogue: 0,0:14:37.35,0:14:38.77,Main,Fishman,0,0,0,,Abi mi?Dialogue: 0,0:14:38.77,0:14:43.66,Main,Arlong,0,0,0,,Görüşmeyeli uzun zaman oldu. Balık Adam Bölgesi'ndeki yoldaşlarız, değil mi?Dialogue: 0,0:14:43.66,0:14:45.36,Main,Jinbe,0,0,0,,Beni kendinle bir tutma.Dialogue: 0,0:14:45.36,0:14:48.79,Main,Jinbe,0,0,0,,Hâlâ korsan mısın? Pislik!Dialogue: 0,0:14:49.66,0:14:51.82,Main,Arlong,0,0,0,,Bana pislik deme abi!Dialogue: 0,0:14:51.82,0:14:53.00,Main,Jinbe,0,0,0,,O zaman süprüntü daha mı iyi?Dialogue: 0,0:14:53.00,0:14:54.37,Main,Arlong,0,0,0,,Süprüntü?!Dialogue: 0,0:14:54.37,0:14:56.99,Main,Arlong,0,0,0,,Seni abim gibi görmeme rağmen, hâlâ benimle böyle mi konuşuyorsun?Dialogue: 0,0:14:56.99,0:15:00.98,Main,Fishman,0,0,0,,Hey, millet!  Maceracı Fisher Tiger-san geldi!Dialogue: 0,0:15:00.98,0:15:03.43,Main,Fishman,0,0,0,,Tiger-san döndü!Dialogue: 0,0:15:03.43,0:15:04.64,Main,Fishman,0,0,0,,Tiger-san!Dialogue: 0,0:15:04.64,0:15:05.97,Main,Fishman,0,0,0,,Bize yolculuğundan bahset!Dialogue: 0,0:15:05.97,0:15:07.40,Main,Jinbe,0,0,0,,Tai abi!Dialogue: 0,0:15:07.40,0:15:08.47,Main,Arlong,0,0,0,,Abi!Dialogue: 0,0:15:08.47,0:15:12.94,Main,Tiger,0,0,0,,Jinbe, Arlong! Sizi iyi gördüm.Dialogue: 0,0:15:12.94,0:15:15.67,Main,Jinbe,0,0,0,,Bu defa yolculuğun epey uzun oldu.Dialogue: 0,0:15:15.67,0:15:17.90,Main,Tiger,0,0,0,,Evet. Bir sürü şey oldu.Dialogue: 0,0:15:17.90,0:15:19.94,Main,Arlong,0,0,0,,Gemime gel!Dialogue: 0,0:15:19.94,0:15:23.20,Main,Tiger,0,0,0,,Sonra gelirim.  Önce Ryugu Sarayı'nda işim var.Dialogue: 0,0:15:23.20,0:15:25.29,Main,Jinbe,0,0,0,,O zaman seni oraya götüreyim.Dialogue: 0,0:15:25.29,0:15:27.41,Main,Jinbe,0,0,0,,Görünüşe göre korsanlarla işi yok.Dialogue: 0,0:15:27.41,0:15:31.50,Main,Arlong,0,0,0,,Ne?! Abim öyle bir şey demedi!Dialogue: 0,0:15:32.25,0:15:34.21,Main,Tiger,0,0,0,,Geçinmeye çalışın, oldu mu?Dialogue: 0,0:15:41.91,0:15:45.33,Main,Neptune,0,0,0,,Köleleri kurtarmak mı istiyorsun?Dialogue: 0,0:15:45.33,0:15:47.63,Main,Tiger,0,0,0,,Artık dayanamıyorum.Dialogue: 0,0:15:47.63,0:15:50.62,Main,Tiger,0,0,0,,Köle olmak, cehenneme girmek gibi.Dialogue: 0,0:15:51.16,0:15:56.74,Main,Tiger,0,0,0,,Biz konuşurken bile, tamamen insanlık dışı yöntemlere maruz kaldıklarına eminim.Dialogue: 0,0:15:56.74,0:15:57.93,Main,Neptune,0,0,0,,Yine de...Dialogue: 0,0:15:57.93,0:15:59.76,Main,Tiger,0,0,0,,Kararımı verdim.Dialogue: 0,0:16:00.85,0:16:06.08,Main,Neptune,0,0,0,,Sen... Son yolculuğunda ne gördün?Dialogue: 0,0:16:12.65,0:16:13.80,Main,Tiger,0,0,0,,İnsanları.Dialogue: 0,0:16:43.29,0:16:47.08,Main,Jinbe,0,0,0,,Hemen ardından büyük bir olay oldu.Dialogue: 0,0:16:47.60,0:16:49.00,Main,Fishman,0,0,0,,Kötü haber!Dialogue: 0,0:16:51.72,0:16:53.25,Main,Jinbe,0,0,0,,Ne oldu?Dialogue: 0,0:16:53.25,0:16:55.11,Main,Fishman,0,0,0,,P-Patron Jinbe!Dialogue: 0,0:16:55.11,0:17:00.17,Main,Fishman,0,0,0,,T-Tiger-san, Kutsal Ejderler'e saldırdı!Dialogue: 0,0:17:00.17,0:17:01.44,Main,Jinbe,0,0,0,,Kutsal Ejderler'e mi?!Dialogue: 0,0:17:04.35,0:17:09.72,Main,Jinbe,0,0,0,,Fisher Tiger,  Kutsal Topraklar Mariejoa'ya saldırdı.Dialogue: 0,0:17:09.72,0:17:12.73,Main,Jinbe,0,0,0,,Köleleri kurtaran kahraman olarak bilindi.Dialogue: 0,0:17:12.73,0:17:15.44,Main,Jinbe,0,0,0,,Aynı zamanda,  tehlikeli bir suçlu olarak damgalandı.Dialogue: 0,0:17:21.32,0:17:24.93,Main,Jinbe,0,0,0,,Şu an itibariyle istifa ediyorum.Dialogue: 0,0:17:24.93,0:17:28.37,Main,Right Minister,0,0,0,,Jinbe!  Ordudaki görevlerini terk mi edeceksin?!Dialogue: 0,0:17:29.08,0:17:33.45,Main,Jinbe,0,0,0,,Adayı koruma görevi bana düşündüğümden daha fazla uydu.Dialogue: 0,0:17:33.45,0:17:37.76,Main,Jinbe,0,0,0,,Ancak, prensiplerin görevden daha önemli olduğu zamanlar vardır!Dialogue: 0,0:17:42.01,0:17:45.35,Main,Arlong,0,0,0,,Tai abi sonunda yaptı!Dialogue: 0,0:17:45.78,0:17:49.68,Main,Arlong,0,0,0,,Arlong Korsanları derhal Fisher Tiger'a katılacak!Dialogue: 0,0:17:49.68,0:17:52.05,Main,Arlong,0,0,0,,Gidelim beyler!Dialogue: 0,0:17:53.80,0:17:59.97,Main,Jinbe,0,0,0,,Böylece, ona hayran olan Balık Adam Bölgesi'nin eski serserileri bir araya toplandı.Dialogue: 0,0:18:01.21,0:18:04.19,Main,Arlong,0,0,0,,Korsan işine hoşgeldin.Dialogue: 0,0:18:05.64,0:18:08.36,Main,Tiger,0,0,0,,Bundan sonra,  dünyanın kendisi düşmanımız olacak.Dialogue: 0,0:18:09.33,0:18:12.50,Main,Tiger,0,0,0,,Buna hazır olan herkes öne çıksın!Dialogue: 0,0:18:18.16,0:18:24.64,Main,Jinbe,0,0,0,,Tiger'ın kurtardığı eski köleler ile isteyerek gelenler arasındaki ayrımı bitirmek için,...Dialogue: 0,0:18:24.64,0:18:31.81,Main,Jinbe,0,0,0,,...tayfanın her üyesi kölelik izlerini gizleyecek güneş amblemiyle damgalandı.Dialogue: 0,0:18:32.80,0:18:39.24,Main,Jinbe,0,0,0,,Balık adamlar, Güneş Korsanları'nı kurdu.Dialogue: 0,0:18:46.09,0:18:48.63,Main,Neptune,0,0,0,,Demek bunu gerçekten yaptı.Dialogue: 0,0:18:52.80,0:18:56.90,Main,Neptune,0,0,0,,Balık Adam Adası'nın duruşu  bir kez daha bozuldu.Dialogue: 0,0:18:56.90,0:19:00.65,Main,Neptune,0,0,0,,Muhtemelen bu yılki dünya konseyi toplantısına bile katılamayacağız.Dialogue: 0,0:19:00.65,0:19:03.44,Main,Neptune,0,0,0,,Bu konuya nasıl çözüm bulacağız?Dialogue: 0,0:19:04.56,0:19:06.08,Main,Otohime,0,0,0,,Ama o gün...Dialogue: 0,0:19:06.08,0:19:09.66,Main,Otohime,0,0,0,,...onu durduramazdım.Dialogue: 0,0:19:10.16,0:19:15.20,Flashbacks,Neptune,0,0,0,,Son yolculuğunda ne gördün?Dialogue: 0,0:19:15.99,0:19:17.46,Flashbacks,Tiger,0,0,0,,İnsanları.Dialogue: 0,0:19:18.28,0:19:24.13,Main,Otohime,0,0,0,,Yürekten gelen sesi korkunç çığlıklar atıyordu.Dialogue: 0,0:19:38.35,0:19:41.35,Main,Newsman,0,0,0,,Yedek baskı! Yedek baskı! Flaş haber!Dialogue: 0,0:19:41.35,0:19:46.45,Main,Fishman,0,0,0,,Kutsal Ejderler'e sürpriz bir saldırı düzenlemiş. İnsanların onlara dokunması bile yasak!Dialogue: 0,0:19:46.45,0:19:49.61,Main,Fishman,0,0,0,,İşte Fisher Tiger, Balık Adam Adası'nın kahramanı!Dialogue: 0,0:19:49.94,0:19:52.85,Main,Fishman,0,0,0,,Müthiş! Bir balık adam tarih yazdı!Dialogue: 0,0:19:52.85,0:19:54.73,Main,Otohime,0,0,0,,Lütfen herkes dinlesin!Dialogue: 0,0:19:55.33,0:19:57.42,Main,Fishman,0,0,0,,Ah, Kraliçe Otohime!Dialogue: 0,0:19:57.42,0:19:58.31,Main,Fishman,0,0,0,,Yine mi?Dialogue: 0,0:19:58.66,0:20:02.91,Main,Otohime,0,0,0,,Hepimiz korktuk. Kaçtık ve gizlendik.Dialogue: 0,0:20:02.91,0:20:06.65,Main,Otohime,0,0,0,,Ama bundan ne öğrendik?Dialogue: 0,0:20:07.00,0:20:09.55,Main,Otohime,0,0,0,,Birkaç soylu insan bize karşı affedilmez suçlar işledi diye...Dialogue: 0,0:20:09.55,0:20:14.42,Main,Otohime,0,0,0,,...balık adamlar acımasızca insanları öldürmeye başlamamalı.Dialogue: 0,0:20:14.90,0:20:18.83,Main,Otohime,0,0,0,,Şimdi, insanlarla bir arada yaşamaya çalışalım.Dialogue: 0,0:20:18.83,0:20:23.38,Main,Otohime,0,0,0,,Parıldayan güneşin altında yaşayan yüzey sakinleri hakkında daha çok şey öğrenelim.Dialogue: 0,0:20:23.38,0:20:25.27,Main,Fishman,0,0,0,,Onlarla ilgili yeterince şey biliyoruz.Dialogue: 0,0:20:25.27,0:20:27.30,Main,Fishman,0,0,0,,Evet, kraliçe için üzülüyorum ama...Dialogue: 0,0:20:28.12,0:20:29.37,Main,Otohime,0,0,0,,Siz ikiniz!Dialogue: 0,0:20:32.59,0:20:33.47,Main,Otohime,0,0,0,,İmzalayın.Dialogue: 0,0:20:34.11,0:20:36.30,Main,Fishman,0,0,0,,Yapamam, Otohime-sama.Dialogue: 0,0:20:36.30,0:20:40.02,Main,Fishman,0,0,0,,Şu anda adadaki herkes Tiger'ın müthiş başarısını destekliyor.Dialogue: 0,0:20:40.02,0:20:43.88,Main,Fishman,0,0,0,,Bu olay insanlardan tamamen ayrılmak anlamına gelecek.Dialogue: 0,0:20:43.88,0:20:46.80,Main,Fishman,0,0,0,,Ama insanların hatalı olduğu aşikâr.Dialogue: 0,0:20:46.80,0:20:48.32,Main,Fishman,0,0,0,,Bu yüzden yapamayız.Dialogue: 0,0:20:48.32,0:20:54.87,Main,Otohime,0,0,0,,Şimdi imkânsızsa yedi, on bir, hatta elli yıl bile bekleriz. Ne kadar gerekirse.Dialogue: 0,0:20:54.87,0:20:59.80,Main,Otohime,0,0,0,,Bu ülkenin dünya konseyi toplantısına yeniden katılacağı gün için...Dialogue: 0,0:20:59.80,0:21:03.42,Main,Otohime,0,0,0,,Lütfen bu formu imzalayın! Lütfen!Dialogue: 0,0:21:03.42,0:21:06.05,Main,Hody,0,0,0,,Fisher Tiger müthiş!Dialogue: 0,0:21:04.18,0:21:08.98,Captions,,0,0,0,,Balık Adam BölgesiDialogue: 0,0:21:06.05,0:21:08.72,Main,Hody,0,0,0,,Aynı Balık Adam Bölgesi'nin patronu olduğu zaman ki gibi.Dialogue: 0,0:21:08.72,0:21:11.39,Main,Hody,0,0,0,,Kutsal Ejderler'in çok kızdığını yazıyor.Dialogue: 0,0:21:11.39,0:21:13.22,Main,Hody,0,0,0,,Şu malum Kutsal Ejderler.Dialogue: 0,0:21:13.22,0:21:14.86,Main,Others,0,0,0,,Ah, öyle mi?!Dialogue: 0,0:21:14.86,0:21:17.35,Main,Zeo,0,0,0,,İğrenç insanların canına okumuş.Dialogue: 0,0:21:17.35,0:21:19.44,Main,Daruma,0,0,0,,Tüm insanlar pisliktir.Dialogue: 0,0:21:19.44,0:21:21.87,Main,Daruma,0,0,0,,Arlong-san'ın her zaman dediği gibi.Dialogue: 0,0:21:23.29,0:21:24.77,Main,Daruma,0,0,0,,Gerçekten değersizler!Dialogue: 0,0:21:25.28,0:21:31.70,Main,Dosun,0,0,0,,Güneş Korsanları yüzeyde istedikleri yere gidiyorlar  ve tüm insanları mahvediyorlar-dosun.Dialogue: 0,0:21:31.70,0:21:32.82,Main,Dosun,0,0,0,,Müthişler-dosun.Dialogue: 0,0:21:33.29,0:21:37.16,Main,Ikaros,0,0,0,,Güçlü olsaydık,  biz de onlarla birlikte giderdik-hi.Dialogue: 0,0:21:37.16,0:21:40.21,Main,Hody,0,0,0,,Müthiş! Müthiş!  Bir gün onlara katılacağım!Dialogue: 0,0:21:40.21,0:21:45.61,Main,Hody,0,0,0,,Calarına okuyun, Güneş Korsanları! Tüm pis insanları öldürün!Dialogue: 0,0:21:45.61,0:21:46.92,Main,Everyone,0,0,0,,Evet!Dialogue: 0,0:21:53.19,0:21:56.49,Main,Hachi,0,0,0,,Patron! Patron!  Düşman gemisi tespit edildi-nyuu!Dialogue: 0,0:21:56.49,0:21:58.97,Main,Hachi,0,0,0,,Patron! Patron! Patron!Dialogue: 0,0:21:58.97,0:22:01.14,Main,Hachi,0,0,0,,Patron Tai! Bela geliyor!Dialogue: 0,0:22:02.77,0:22:04.98,Main,Arlong,0,0,0,,Ah, kapa çeneni, Hachi!Dialogue: 0,0:22:06.05,0:22:08.48,Main,Jinbe,0,0,0,,Neden sakin olmuyorsun?Dialogue: 0,0:22:08.96,0:22:11.64,Main,Tiger,0,0,0,,Çok gürültücüsün. Denizciler mi?Dialogue: 0,0:22:11.70,0:22:14.74,Main,Kadaru,0,0,0,,Hiç şüphesiz, bunlar Güneş Korsanları.Dialogue: 0,0:22:14.74,0:22:16.37,Main,Kadaru,0,0,0,,Tiger'ın başını alın!Dialogue: 0,0:22:22.65,0:22:24.76,Main,Arlong,0,0,0,,Iskaladınız!Dialogue: 0,0:22:29.14,0:22:30.44,Main,Marine,0,0,0,,Ateş!Dialogue: 0,0:22:33.72,0:22:36.47,Main,Kadaru,0,0,0,,Ne yapıyorsunuz?! Düzgün nişan alın!Dialogue: 0,0:22:36.47,0:22:38.43,Main,Marine,0,0,0,,Ama su altında gidiyorlar!Dialogue: 0,0:23:00.20,0:23:01.37,Main,Arlong,0,0,0,,Ah.Dialogue: 0,0:23:03.50,0:23:05.49,Main,Kadaru,0,0,0,,Kahrolası balık adamlar!Dialogue: 0,0:23:05.49,0:23:08.66,Main,Kadaru,0,0,0,,Kaçak köleleri teslim edin!Dialogue: 0,0:23:08.66,0:23:10.76,Main,Kadaru,0,0,0,,O zaman suçlarınızı görmezden gelebilirim.Dialogue: 0,0:23:12.18,0:23:16.94,Main,Marine,0,0,0,,T-Tuğamiral...  K-Karinadan saldırıyorlar.Dialogue: 0,0:23:16.94,0:23:17.47,Main,Kadaru,0,0,0,,Ne?!Dialogue: 0,0:23:21.74,0:23:24.14,Main,Officer,0,0,0,,Sessizce köleleri teslim edin!Dialogue: 0,0:23:24.14,0:23:26.79,Main,Officer,0,0,0,,Yaptığınız büyük bir suç!Dialogue: 0,0:23:26.79,0:23:30.58,Main,Officer,0,0,0,,İnsanlara saldırmak mı? Balık adamlar haddini bilmeli!Dialogue: 0,0:23:31.54,0:23:35.04,Main,Jinbe,0,0,0,,Ne dedin sen? Tekrar söyle bakalım.Dialogue: 0,0:23:35.04,0:23:37.09,Main,Jinbe,0,0,0,,Bir daha söylemeyi denesene!Dialogue: 0,0:23:40.32,0:23:41.74,Main,Marine,0,0,0,,Yardım edin.Dialogue: 0,0:23:43.80,0:23:48.70,Main,Jinbe,0,0,0,,Kahrolası kölelik doğru da, özgürlük suç mu?Dialogue: 0,0:23:48.70,0:23:51.79,Main,Jinbe,0,0,0,,O ise insanları sevmemizi mi istiyor?Dialogue: 0,0:23:51.79,0:23:53.52,Main,Jinbe,0,0,0,,Kraliçe Otohime...Dialogue: 0,0:24:13.33,0:24:15.50,Main,Kadaru,0,0,0,,Ateş! Ateş!Dialogue: 0,0:24:15.50,0:24:19.21,Main,Kadaru,0,0,0,,Nişan alın ve ateş edin!  İstihbarat aldık!Dialogue: 0,0:24:19.21,0:24:22.72,Main,Kadaru,0,0,0,,Kaçak köleleri barındırıyorsunuz!Dialogue: 0,0:24:26.14,0:24:26.80,Main,Kadaru,0,0,0,,O-Olamaz!Dialogue: 0,0:24:27.68,0:24:29.06,Main,Tiger,0,0,0,,Kaçak köleler mi?Dialogue: 0,0:24:29.58,0:24:31.35,Main,Kadaru,0,0,0,,Canavar mı bu?!Dialogue: 0,0:24:41.86,0:24:45.41,Main,Kadaru,0,0,0,,Burada onlarla ilgili bir kanıt var mı?Dialogue: 0,0:24:45.94,0:24:47.88,Main,Kadaru,0,0,0,,Bedenlerimize bak.Dialogue: 0,0:24:47.88,0:24:51.62,Main,Kadaru,0,0,0,,Kaçak kölelerde olması gereken işaret...Dialogue: 0,0:24:51.62,0:24:52.95,Main,Kadaru,0,0,0,,...buradaki birinde var mı?Dialogue: 0,0:24:53.37,0:24:55.85,Main,Kadaru,0,0,0,,Bırak beni! Dur! Ne yapıyorsun?!Dialogue: 0,0:24:56.29,0:24:58.37,Main,Kadaru,0,0,0,,Hayır! Yardım edin!Dialogue: 0,0:25:06.14,0:25:08.89,Main,Tiger,0,0,0,,Rahat ol. Seni bırakacağım.Dialogue: 0,0:25:08.89,0:25:10.42,Main,Tiger,0,0,0,,Ben siz insanlar gibi değilim.Dialogue: 0,0:25:11.49,0:25:15.22,Main,Tiger,0,0,0,,Dinleyin! Mallarını ve yiyeceklerini alıp gemiye dönün!Dialogue: 0,0:25:19.94,0:25:21.68,Main,Arlong,0,0,0,,Seni ölüme mahkum ediyorum.Dialogue: 0,0:25:21.68,0:25:25.43,Main,Arlong,0,0,0,,İnsan, senin varlığın bile affedilmez bir suç.Dialogue: 0,0:25:26.81,0:25:27.82,Main,Tiger,0,0,0,,Dur! Arlong!Dialogue: 0,0:25:27.82,0:25:29.02,Main,Arlong,0,0,0,,Geber!Dialogue: 0,0:25:34.69,0:25:35.86,Main,Kadar,0,0,0,,Koramiral Borsalino...Dialogue: 0,0:25:35.18,0:25:39.88,Captions,,0,0,0,,Marineford, Denizci KarargâhıDialogue: 0,0:25:35.86,0:25:39.49,Main,Kadar,0,0,0,,...G2 Biriminden Tuğamiral Kadaru'nun gemisi kayıp.Dialogue: 0,0:25:39.99,0:25:43.50,Main,Kizaru,0,0,0,,Oh? Neden onlarla dövüşmeye çalışmışlar?Dialogue: 0,0:25:43.50,0:25:46.88,Main,Kizaru,0,0,0,,Sadece yerlerini bildirmelerini söylemiştim.Dialogue: 0,0:25:46.88,0:25:53.13,Main,Kadar,0,0,0,,Onları görmek için çok fazla yaklaşınca etrafınızı sardıklarını söylüyorlar.Dialogue: 0,0:25:53.62,0:25:58.36,Main,Kizaru,0,0,0,,Ah, ne kadar korkunç. Sanırım su altı uzmanlarından daha azını beklemezdim.Dialogue: 0,0:25:59.40,0:26:02.39,Main,Kizaru,0,0,0,,Peki, gemidekiler ne tür kimselermiş?Dialogue: 0,0:26:02.39,0:26:03.32,Main,Kadar,0,0,0,,Efendim.Dialogue: 0,0:26:03.32,0:26:10.82,Main,Kadar,0,0,0,,Son zamanlarda Balık Adam Adası'nın yanındaki deniz tabanında görülen Arlong'un tayfası gemideymiş.Dialogue: 0,0:26:11.73,0:26:15.74,Main,Kadar,0,0,0,,Suda dövüşme konusunda doğal yeteneğe sahip oldukları için, dövüş yeteneklerini ölçmek zor.Dialogue: 0,0:26:16.54,0:26:20.77,Main,Kizaru,0,0,0,,Arlong... Söylentileri duymuştum.Dialogue: 0,0:26:21.24,0:26:23.78,Main,Kadar,0,0,0,,Tiger'ın adamları içinde sağlam yapılı biri daha olduğundan bahsediliyor.Dialogue: 0,0:26:23.78,0:26:28.33,Main,Kadar,0,0,0,,İnanılmaz derecede güçlü ama adını bile bilmiyoruz.Dialogue: 0,0:26:28.33,0:26:31.63,Main,Kizaru,0,0,0,,Oh, ne kadar can sıkıcı.Dialogue: 0,0:26:32.25,0:26:34.38,Main,Arlong,0,0,0,,Acıdı!Dialogue: 0,0:26:36.52,0:26:38.15,Main,Arlong,0,0,0,,Bu ne içindi?!Dialogue: 0,0:26:38.15,0:26:42.17,Main,Arlong,0,0,0,,Sırf birkaç değersiz pisliğin icabına baktığım için mi?!Dialogue: 0,0:26:43.85,0:26:46.10,Main,Tiger,0,0,0,,Çok ileri gittin.Dialogue: 0,0:26:47.26,0:26:50.29,Main,Tiger,0,0,0,,Sıradan katillerden oluşan bir topluluk değiliz.Dialogue: 0,0:26:50.29,0:26:51.69,Main,Tiger,0,0,0,,Kendini kaptırma!Dialogue: 0,0:26:51.69,0:26:55.17,Main,Jinbe,0,0,0,,Ama Tai Abi... Yani Patron,...Dialogue: 0,0:26:55.17,0:26:59.33,Main,Jinbe,0,0,0,,...seni öldürmek için ateş ediyorlardı.Dialogue: 0,0:26:59.33,0:27:03.93,Main,Jinbe,0,0,0,,Olabildiğince sert karşılık vermemiz normal!Dialogue: 0,0:27:03.93,0:27:04.98,Main,Jinbe,0,0,0,,Sonuçta bizi kızdırdılar!Dialogue: 0,0:27:04.98,0:27:07.16,Main,Tiger,0,0,0,,Onları öldürürsek, kaybederiz.Dialogue: 0,0:27:07.16,0:27:09.79,Main,Tiger,0,0,0,,Onlar gibi mi olmak istiyorsunuz?!Dialogue: 0,0:27:10.13,0:27:13.49,Main,Tiger,0,0,0,,Bu, ayrımcılık tarihinin intikamını alma görevi değil.Dialogue: 0,0:27:13.49,0:27:15.26,Main,Tiger,0,0,0,,Mariejoa'da yaptığım da bu değildi.Dialogue: 0,0:27:15.85,0:27:20.87,Main,Tiger,0,0,0,,Saçma kanunlarını delmiş olabilirim ama bu sadece baskı altındakileri kurtarmak içindi!Dialogue: 0,0:27:21.56,0:27:26.98,Main,Tiger,0,0,0,,Güneş Korsanları sadece özgürlük ve hürriyet için dövüşür. Başka şey için değil!Dialogue: 0,0:27:27.53,0:27:31.41,Main,Tiger,0,0,0,,Kin besleyip insanlardan intikam almaya başlarsak,...Dialogue: 0,0:27:31.41,0:27:36.15,Main,Tiger,0,0,0,,...karşılığında insanlar da intikam almak isteyeceği için daha fazla trajedi ortaya çıkar.Dialogue: 0,0:27:36.15,0:27:41.03,Main,Tiger,0,0,0,,Hiçbir suçu olmayan balık adamların torunları, atalarının suçları yüzünden cezalandırılacaklar!Dialogue: 0,0:27:41.87,0:27:43.12,Main,Tiger,0,0,0,,Anlamıyor musunuz?!Dialogue: 0,0:27:43.68,0:27:48.50,Main,Tiger,0,0,0,,Bizi kovalayanlarla dövüşüp onları soyabiliriz ama o sınırı geçmek yok.Dialogue: 0,0:27:49.36,0:27:52.42,Main,Tiger,0,0,0,,Biz kimseyi öldürmeyiz!Dialogue: 0,0:27:56.98,0:28:01.67,Main,Arlong,0,0,0,,Epeydir sana bir şey söylemek istiyordum, Abi.Dialogue: 0,0:28:01.67,0:28:04.26,Main,Arlong,0,0,0,,İnsanların intikam alacağından mı endişe ediyorsun?Dialogue: 0,0:28:05.01,0:28:08.64,Main,Arlong,0,0,0,,İntikam almaya çalışırlarsa, hepsini öldürürüz!Dialogue: 0,0:28:09.59,0:28:14.32,Main,Arlong,0,0,0,,O kadar acımasız olmalıyız ki insanlar karşımızda korkudan titremeli!Dialogue: 0,0:28:14.32,0:28:17.40,Main,Arlong,0,0,0,,Bunu yaparsak,  karşılık vermeyi bile düşünmezler.Dialogue: 0,0:28:17.89,0:28:21.36,Main,Arlong,0,0,0,,Onlar sadece balık adamların gücünü ve acımasızlığını bilmiyorlar.Dialogue: 0,0:28:22.04,0:28:24.37,Main,Arlong,0,0,0,,Bunu onların gözlerine kazımalıyız.Dialogue: 0,0:28:24.91,0:28:26.30,Main,Arlong,0,0,0,,Korkun bizden!Dialogue: 0,0:28:26.30,0:28:28.04,Main,Arlong,0,0,0,,Ne yapıyorsun sen?!Dialogue: 0,0:28:40.22,0:28:45.64,Main,Tiger,0,0,0,,Jinbe, Kraliçe Otohime'nin kampanyası ideal çözüm.Dialogue: 0,0:28:46.72,0:28:51.07,Main,Tiger,0,0,0,,Onun gözünde,  benimle Arlong arasında ne fark var?Dialogue: 0,0:29:01.49,0:29:07.27,Main,Tiger,0,0,0,,Beni en çok korkutan şey  kalbimde yaşayan şeytan.Dialogue: 0,0:29:09.50,0:29:12.33,Main,Hachi,0,0,0,,Nyuu- Korsan gemisi!Dialogue: 0,0:29:12.33,0:29:13.87,Main,Fishman,0,0,0,,Çok büyük bir gemi!Dialogue: 0,0:29:13.87,0:29:16.98,Main,Fishman,0,0,0,,Bizi yenerek meşhur olmaya çalışıyorlar.Dialogue: 0,0:29:17.40,0:29:19.35,Main,Fishman,0,0,0,,Şimdi de böyleleriyle mi uğraşmak zorundayız?Dialogue: 0,0:29:19.35,0:29:23.68,Main,Jinbe,0,0,0,,Onları batırmaya devam edersek, er geç peşimizi bırakacaklardır.Dialogue: 0,0:29:24.42,0:29:29.86,Main,Jinbe,0,0,0,,Hükümet tarafından aranıyorduk ve her gün dövüşmek zorundaydık.Dialogue: 0,0:29:29.86,0:29:35.99,Main,Jinbe,0,0,0,,Kraliçe Otohime de kendi yöntemiyle dünyaya karşı mücadele etmeye çalıştı.Dialogue: 0,0:29:35.99,0:29:37.28,Main,Otohime,0,0,0,,İmzalayın!Dialogue: 0,0:29:37.28,0:29:38.93,Main,Fishman,0,0,0,,İnsanlarla birlikte yaşamak mı?Dialogue: 0,0:29:38.93,0:29:40.24,Main,Fishman,0,0,0,,Biz almayalım, Majesteleri.Dialogue: 0,0:29:40.24,0:29:41.72,Main,Otohime,0,0,0,,İmzalayın!Dialogue: 0,0:29:42.20,0:29:47.65,Main,Hachi,0,0,0,,Hey! Patron Tai'nin ve Jinbe-san'ın başına ödül konmuş!Dialogue: 0,0:29:47.65,0:29:48.42,Main,Arlong,0,0,0,,Ne?!Dialogue: 0,0:29:48.42,0:29:51.13,Main,Arlong,0,0,0,,Vay canına! 230 milyon beli!Dialogue: 0,0:29:51.13,0:29:54.26,Main,Arlong,0,0,0,,Jinbe'ninki 76 milyon beli!Dialogue: 0,0:29:54.72,0:29:58.72,Main,Hody,0,0,0,,Aranıyor posterleri!  Görünüşe bakılırsa ödülleri artmış! Vay canına!Dialogue: 0,0:29:58.72,0:30:01.62,Main,Zeo,0,0,0,,Galiba Dünya Hükümeti'nin korkudan ödü kopuyor.Dialogue: 0,0:30:02.45,0:30:04.56,Main,Daruma,0,0,0,,Kahrolası Denizciler!Dialogue: 0,0:30:06.18,0:30:08.07,Main,Otohime,0,0,0,,İmzala!Dialogue: 0,0:30:08.07,0:30:10.22,Main,Fishman,0,0,0,,Beni rahat bırakın!Dialogue: 0,0:30:10.22,0:30:13.45,Main,Jinbe,0,0,0,,Üç yıl böyle devam etti.Dialogue: 0,0:30:13.45,0:30:17.11,Main,Jinbe,0,0,0,,Ama sonra adanın birinde bir kızla karşılaştım.Dialogue: 0,0:30:17.54,0:30:20.41,Main,Man,0,0,0,,Bize bir iyilik yapar mısınız?Dialogue: 0,0:30:17.58,0:30:20.48,Main,,0,0,0,,12 yıl önceDialogue: 0,0:30:21.24,0:30:29.08,Main,Man,0,0,0,,Üç yıl önce biz köleleri azat ettiğinizde, bu kız da Mariejoa'dan bizimle birlikte kaçtı.Dialogue: 0,0:30:29.08,0:30:30.37,Main,Man,0,0,0,,Gördüğünüz gibi.Dialogue: 0,0:30:34.13,0:30:38.91,Main,exSlave,0,0,0,,Ama ailesinin yaşadığı şehir buradan çok uzakta.Dialogue: 0,0:30:38.91,0:30:44.68,Main,exSlave,0,0,0,,Onu götürmek istedik ama bu tehlikeli denizlerde yolculuk yapamayız.Dialogue: 0,0:30:46.32,0:30:48.48,Main,Koala,0,0,0,,Ben Koala. 11 yaşındayım.Dialogue: 0,0:30:48.48,0:30:53.31,Main,Koala,0,0,0,,Üç yıl önce beni kurtardığınız için çok teşekkür ederim.Dialogue: 0,0:30:53.77,0:30:56.79,Main,Arlong,0,0,0,,Çocuk bile olsa yine de insan! İğrenç!Dialogue: 0,0:30:56.79,0:30:59.25,Main,Arlong,0,0,0,,Neden bir insanın bizimle aynı gemiye binmesine izin veriyorsun?Dialogue: 0,0:30:59.25,0:31:00.62,Main,Tiger,0,0,0,,Bu bir ilerleme.Dialogue: 0,0:31:01.32,0:31:04.62,Main,Arlong,0,0,0,,Pişmiş kelle gibi sırıtmayı bırak! Beni sinir ediyorsun!Dialogue: 0,0:31:04.62,0:31:06.08,Main,Hachi,0,0,0,,Arlong-san!Dialogue: 0,0:31:08.66,0:31:10.22,Main,Hachi,0,0,0,,Arlong-san!Dialogue: 0,0:31:10.22,0:31:12.77,Main,Arlong,0,0,0,,Bırak beni, Hachi! İşim bitmedi!Dialogue: 0,0:31:12.77,0:31:16.13,Main,Chu,0,0,0,,Gerçekten. Gülümsemeyi hiç bırakmıyor ve bu biraz ürkütücü.Dialogue: 0,0:31:27.89,0:31:29.08,Main,Arlong,0,0,0,,Sen?Dialogue: 0,0:31:29.08,0:31:31.48,Main,Koala,0,0,0,,Üzgünüm. Çalışacağım.Dialogue: 0,0:31:31.48,0:31:35.31,Main,Koala,0,0,0,,Bütün temizliği yapacağım ve hiç dinlenmeyeceğim, lütfen bana vurmayın.Dialogue: 0,0:31:35.31,0:31:36.73,Main,Koala,0,0,0,,Üzgünüm.Dialogue: 0,0:31:37.47,0:31:39.86,Main,Koala,0,0,0,,Üzgünüm, üzgünüm.Dialogue: 0,0:31:40.70,0:31:42.13,Main,Jinbe,0,0,0,,Ne yapıyorsun?Dialogue: 0,0:31:42.13,0:31:42.99,Main,Koala,0,0,0,,Üzgünüm.Dialogue: 0,0:31:43.48,0:31:46.28,Main,Koala,0,0,0,,Üzgünüm, üzgünüm.Dialogue: 0,0:31:46.28,0:31:48.41,Main,Jinbe,0,0,0,,Hey, burnun kanıyor.Dialogue: 0,0:31:48.41,0:31:49.33,Main,Koala,0,0,0,,Üzgünüm.Dialogue: 0,0:31:49.33,0:31:53.62,Main,Koala,0,0,0,,Ne olursa olsun ağlamayacağım. Lütfen beni öldürmeyin.Dialogue: 0,0:31:56.92,0:32:00.59,Main,Jinbe,0,0,0,,Hey, artık bırakabilirsin. Sence o kadar korkunç muyuz?Dialogue: 0,0:32:00.59,0:32:03.26,Main,Koala,0,0,0,,Evet ama annemi görmek istiyorum.Dialogue: 0,0:32:03.89,0:32:06.18,Main,Koala,0,0,0,,Bu yüzden dişimi sıkıp geminize bindim.Dialogue: 0,0:32:06.18,0:32:11.33,Main,Koala,0,0,0,,Ara verirsem beni öldürebilirsiniz, değil mi?Dialogue: 0,0:32:11.33,0:32:14.60,Main,Koala,0,0,0,,İşe yarar biri olacağım, lütfen beni öldürmeyin.Dialogue: 0,0:32:16.08,0:32:19.45,Main,Aladdin,0,0,0,,Kölelikten başka bir şey bilmiyor.Dialogue: 0,0:32:20.61,0:32:24.14,Main,Aladdin,0,0,0,,Bir köle ağlamak kadar önemsiz bir şey yüzünden öldürülebilir.Dialogue: 0,0:32:24.14,0:32:27.49,Main,Aladdin,0,0,0,,Temizliğe ara verdikleri için de öldürülebilirler.Dialogue: 0,0:32:27.93,0:32:33.16,Main,Aladdin,0,0,0,,Hep, "Belki de sıradaki benim" diye düşünürler. Sürekli korku içinde yaşarlar ama göstermezler.Dialogue: 0,0:32:36.28,0:32:37.03,Main,Pirate,0,0,0,,Patron.Dialogue: 0,0:32:39.56,0:32:42.63,Main,Tiger,0,0,0,,Çocuğu odama getirin.Dialogue: 0,0:32:44.58,0:32:46.04,Main,Pirate,0,0,0,,Orada ne yapıyorlar?Dialogue: 0,0:32:46.04,0:32:51.44,Main,Pirate,0,0,0,,Ona nasihat etmenin faydası olmaz.  Çocuk ruhen çökmüş.Dialogue: 0,0:32:58.72,0:33:00.79,Main,Koala,0,0,0,,Patron! Orada ne yapıyorsun?!Dialogue: 0,0:33:10.27,0:33:11.52,Main,Tiger,0,0,0,,Yarayı dağladım.Dialogue: 0,0:33:11.52,0:33:16.61,Main,Tiger,0,0,0,,Çok zor ama o işareti taşıdığı sürece unutulması daha iyi olan şeyleri asla unutmayacak.Dialogue: 0,0:33:17.34,0:33:19.04,Main,Hachi,0,0,0,,Hey, hayatta mısın?Dialogue: 0,0:33:23.50,0:33:25.43,Main,Hachi,0,0,0,,Ah, uyandı!Dialogue: 0,0:33:25.43,0:33:28.84,Main,Koala,0,0,0,,Sanırım bayılmışım. Üzgünüm.Dialogue: 0,0:33:28.84,0:33:32.39,Main,Koala,0,0,0,,Ama bakın, ağlamadım. Lütfen beni öldürmeyin.Dialogue: 0,0:33:32.39,0:33:36.60,Main,Koala,0,0,0,,Bana ne yaparsanız yapın ağlamayacağım.  Lütfen beni öldürmeyin.Dialogue: 0,0:33:39.35,0:33:41.10,Main,Tiger,0,0,0,,Ağlamanın yanlış bir tarafı yok!Dialogue: 0,0:33:44.35,0:33:49.75,Main,Tiger,0,0,0,,Sakın o aptal Kutsal Ejderler gibi olduğumuzu sanma.Dialogue: 0,0:33:50.73,0:33:51.53,Main,Tiger,0,0,0,,İyi izle.Dialogue: 0,0:34:32.53,0:34:36.03,Main,Tiger,0,0,0,,Biz kimseyi öldürmeyiz.Dialogue: 0,0:34:37.19,0:34:39.11,Main,Tiger,0,0,0,,Beyler, gidiyoruz!Dialogue: 0,0:34:40.82,0:34:42.79,Main,Tiger,0,0,0,,Bu kızı mutlaka...Dialogue: 0,0:34:46.65,0:34:49.16,Main,Tiger,0,0,0,,...evine ulaştıracağız!