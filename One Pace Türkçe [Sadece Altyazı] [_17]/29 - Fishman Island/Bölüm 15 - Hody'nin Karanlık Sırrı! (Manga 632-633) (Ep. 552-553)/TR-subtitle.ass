mpress bt,50,&H001D221E,&H000000FF,&H001D221E,&H00000000,0,0,0,0,100,100,0,0,1,0.5,0,2,10,10,10,1Style: We Go lyrics,Duality,40.0,&H0098594E,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2.0,0,8,10,10,16,1Style: Author,Impress BT,20.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.7,0.7,9,10,10,10,1Style: Attack,Duality,32.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.0,1.0,7,12,12,12,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:02:29.72,0:02:37.17,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Kaşgarlı thx to onepace.netDialogue: 0,0:15:45.80,0:15:55.80,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Kaşgarlı thx to onepace.netDialogue: 0,0:30:16.65,0:30:19.70,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Kaşgarlı thx to onepace.netDialogue: 0,0:02:29.72,0:02:37.17,Title,,0,0,0,,Hody'nin Karanlık Sırrı! Hasır Şapkalar'ın GelişiDialogue: 0,0:02:38.14,0:02:41.81,Main,Jinbe,0,0,0,,Meydana neredeyse vardık. Acele et, Megalo!Dialogue: 0,0:02:42.36,0:02:44.00,Main,Shirahoshi,0,0,0,,Baba...Dialogue: 0,0:02:44.00,0:02:47.50,Main,Totally The Real Neptune,0,0,0,,Hey, benim-jamon!Dialogue: 0,0:02:47.50,0:02:49.59,Main,Shirahoshi,0,0,0,,Patron Jinbe-sama! Megalo!Dialogue: 0,0:02:50.59,0:02:53.39,Main,Totally The Real Neptune,0,0,0,,Hey, benim-jamon!Dialogue: 0,0:02:53.84,0:02:55.77,Main,Shirahoshi,0,0,0,,Her şeye rağmen iyisin değil mi?Dialogue: 0,0:02:59.73,0:03:01.27,Main,Shirahoshi,0,0,0,,Baba!Dialogue: 0,0:03:02.18,0:03:04.08,Captions,,0,0,0,,Gyoncord MeydanıDialogue: 0,0:03:08.17,0:03:09.59,Main,Fishman,0,0,0,,Olamaz...Dialogue: 0,0:03:12.28,0:03:14.64,Main,Zeo,0,0,0,,Sergimiz oldukça büyüdü.Dialogue: 0,0:03:18.59,0:03:20.22,Main,Neptune,0,0,0,,Seni alçak!Dialogue: 0,0:03:21.88,0:03:23.94,Main,Hody,0,0,0,,İşte güzel bir manzara!Dialogue: 0,0:03:26.90,0:03:28.48,Main,Fishman,0,0,0,,Prens Manboshi!Dialogue: 0,0:03:28.48,0:03:30.32,Main,Fishman,0,0,0,,Prens Ryuuboshi!Dialogue: 0,0:03:30.32,0:03:32.24,Main,Fishman,0,0,0,,Prens Fukaboshi!Dialogue: 0,0:03:32.68,0:03:35.36,Main,Fishman,0,0,0,,O korsanlar ne yaptılar onlara? Dialogue: 0,0:03:35.88,0:03:38.70,Main,Fishman,0,0,0,,Prensler kazanıyordu oysaki!Dialogue: 0,0:03:38.70,0:03:42.33,Main,Fishman,0,0,0,,Ama bir anda durum tam tersine döndü!Dialogue: 0,0:03:42.33,0:03:45.59,Main,Dosun,0,0,0,,Yeterince yakıp yıkmadım-zugon!Dialogue: 0,0:03:45.59,0:03:49.14,Main,Ikaros,0,0,0,,Muhi, çok öfkelisin! Beni kalamar tavaya döndüreceksin-hi!Dialogue: 0,0:03:50.13,0:03:55.03,Main,Zeo,0,0,0,,Ordunun askerleri, bakanlar ve Kraliyet Ailesi...Dialogue: 0,0:03:55.03,0:03:59.18,Main,Zeo,0,0,0,,Artık bu ülkede bizimle savaşabilecek kimse kalmadı!Dialogue: 0,0:03:59.18,0:04:01.93,Main,Manboshi,0,0,0,,Ne acayip bir güç.Dialogue: 0,0:04:01.93,0:04:04.28,Main,Fukaboshi,0,0,0,,Lütfen beni affet, Baba.Dialogue: 0,0:04:04.63,0:04:09.20,Main,Neptune,0,0,0,,Öyle deme! Bu onların gerçek gücü değil-jamon!Dialogue: 0,0:04:09.20,0:04:11.78,Main,Ryuuboshi,0,0,0,,Ama yine de onunla ülkeyi ele geçirebiliyorlar.Dialogue: 0,0:04:11.78,0:04:14.30,Main,Pirate,0,0,0,,Kaptan Hody, hadi idam edelim şunları!Dialogue: 0,0:04:14.30,0:04:15.38,Main,Pirate,0,0,0,,Kızartın onları!Dialogue: 0,0:04:15.38,0:04:16.66,Main,Pirate,0,0,0,,Hayır, şişleyin!Dialogue: 0,0:04:16.66,0:04:21.97,Main,Pirate,0,0,0,,O asiller insanlarla bir arada olmak istedi! Hiç onurları yok!Dialogue: 0,0:04:21.97,0:04:23.07,Main,Pirate,0,0,0,,Zalimce öldürün!Dialogue: 0,0:04:23.58,0:04:25.96,Main,Pirate,0,0,0,,Onları sergiye koyun!Dialogue: 0,0:04:25.96,0:04:27.46,Main,Pirate,0,0,0,,İdam edin!Dialogue: 0,0:04:27.46,0:04:39.09,Main,Pirate,0,0,0,,İdam edin! İdam edin!Dialogue: 0,0:04:39.09,0:04:40.87,Main,Pirate,0,0,0,,İdam edin!Dialogue: 0,0:04:40.87,0:04:42.18,Main,Hody,0,0,0,,Sessizlik.Dialogue: 0,0:04:45.44,0:04:51.72,Main,Hody,0,0,0,,Decken'in tayfası hala Shirahoshi'nin öldüğüne dair bir haber göndermedi.Dialogue: 0,0:04:52.90,0:04:57.49,Main,Hody,0,0,0,,Eğer onu buraya çekemezsem, her şey boşuna olur!Dialogue: 0,0:04:57.91,0:05:02.34,Main,Manboshi,0,0,0,,Kız kardeşimize dokunma! O bir savaşçı değil!Dialogue: 0,0:05:02.34,0:05:05.00,Main,Manboshi,0,0,0,,Senin için ne gibi bir tehdit oluşturabilir ki?!Dialogue: 0,0:05:05.47,0:05:09.62,Main,Hody,0,0,0,,Hiçbir şey bilmediğimi mi sanıyorsunuz?Dialogue: 0,0:05:10.71,0:05:13.53,Main,Hody,0,0,0,,En çok kurtulmak istediğim kişi...Dialogue: 0,0:05:13.53,0:05:18.63,Main,Hody,0,0,0,,o baş belası güce sahip olan, efsanevi deniz kızı.Dialogue: 0,0:05:18.63,0:05:19.89,Main,Fukaboshi,0,0,0,,Hody!Dialogue: 0,0:05:20.63,0:05:22.72,Main,Pirate,0,0,0,,Kaptan Hody!Dialogue: 0,0:05:22.72,0:05:25.81,Main,Pirate,0,0,0,,Onları yakaladık!Dialogue: 0,0:05:31.90,0:05:36.12,Main,Pirate,0,0,0,,Prenses Shirahoshi ve Jinbe tuzağımıza düştü!Dialogue: 0,0:05:36.12,0:05:38.50,Main,Princes,0,0,0,,Shirahoshi!Dialogue: 0,0:05:38.50,0:05:41.32,Main,Shirahoshi,0,0,0,,Baba! Abilerim!Dialogue: 0,0:05:41.32,0:05:43.90,Main,Hody,0,0,0,,Ne şans ama!Dialogue: 0,0:05:47.33,0:05:51.40,Main,Hody,0,0,0,,En çok korktuğum iki kişi aynı anda yakalandı!Dialogue: 0,0:05:51.40,0:05:54.84,Main,Hody,0,0,0,,Bu neredeyse gerçek olamayacak kadar iyi!Dialogue: 0,0:05:56.11,0:05:58.65,Main,Shirahoshi,0,0,0,,Gerçekten çok üzgünüm.Dialogue: 0,0:05:58.65,0:06:03.60,Main,Shirahoshi,0,0,0,,Ben tuzağa düştüğüm için, siz bile...Dialogue: 0,0:06:03.60,0:06:06.60,Main,Jinbe,0,0,0,,Olan oldu artık. Sıkıntı etmeyin.Dialogue: 0,0:06:06.60,0:06:09.39,Main,Hody,0,0,0,,Sonunda geldin demek, Jinbe.Dialogue: 0,0:06:10.43,0:06:14.40,Main,Hody,0,0,0,,Daha acımasız olduğun zamanlar seni severdim.Dialogue: 0,0:06:14.40,0:06:20.03,Main,Jinbe,0,0,0,,Ne oldu sana, Hody?   Daha öncesinden farklı görünüyorsun.Dialogue: 0,0:06:20.03,0:06:21.88,Main,Fishman,0,0,0,,Bu Patron Jinbe!Dialogue: 0,0:06:21.88,0:06:25.16,Main,Fishman,0,0,0,,Shichibukai'likten istifa ettikten sonra adayı terk ettiğini sanıyordum!Dialogue: 0,0:06:25.37,0:06:29.94,Main,Fishman,0,0,0,,Prenses Shirahoshi'nin Hasır Şapkalı Luffy tarafından kaçırıldığını duymuştum ama...Dialogue: 0,0:06:29.94,0:06:32.55,Main,Fishman,0,0,0,,Patron Jinbe onu kurtarmış mı?Dialogue: 0,0:06:33.40,0:06:38.04,Main,Hody,0,0,0,,Pekala, böylece ihtiyacımız olan herkes burada.Dialogue: 0,0:06:38.04,0:06:40.90,Main,Hody,0,0,0,,Düşündüğümden de kolay oldu.Dialogue: 0,0:06:41.64,0:06:47.51,Main,Hody,0,0,0,,Şimdi, ne yapacaklarını bilmediğim sadece Hasır Şapkalar kaldı.Dialogue: 0,0:06:47.51,0:06:54.03,Main,Hody,0,0,0,,Muhtemelen ne yapacaklarını bilmez halde, Ryugu Şatosu'nun girişini arıyorlardır.Dialogue: 0,0:06:54.75,0:06:58.20,Main,Hody,0,0,0,,Yoldaşlarının ölümü ile öfkelenmiş bir şekilde buraya gelseler bile...Dialogue: 0,0:06:58.20,0:07:02.79,Main,Hody,0,0,0,,onlar için hazır olacağız. Dialogue: 0,0:07:02.79,0:07:09.06,Main,Hody,0,0,0,,Geçtiğimiz ay boyunca okyanusun dibinde insan köleler yakaladım...Dialogue: 0,0:07:09.06,0:07:10.66,Main,Hody,0,0,0,,Otuz bin tane! Dialogue: 0,0:07:19.13,0:07:24.30,Main,Hody,0,0,0,,Ve ağır silahlanmış balık adamlar, yetmiş bin tane!Dialogue: 0,0:07:44.82,0:07:47.24,Main,Fukaboshi,0,0,0,,B-Bu da ne?!Dialogue: 0,0:07:55.87,0:08:00.38,Main,Hody,0,0,0,,Buraya kapalı olan Balık Adam Bölgesi'nden geldiler.Dialogue: 0,0:08:00.38,0:08:08.10,Main,Hody,0,0,0,,Toplam da yüz bin tane suçlumuz var!Dialogue: 0,0:08:41.19,0:08:46.67,Main,Hody,0,0,0,,Meydanın etrafında bazı savaşamayacak kadın ve çocuklar var.Dialogue: 0,0:08:46.67,0:08:49.93,Main,Hody,0,0,0,,İşler sakinleştiğinde onlarla da ilgileneceğiz.Dialogue: 0,0:08:49.93,0:08:54.76,Main,Hody,0,0,0,,Ama insan kölelerin sayısı yakında gitgide artacak!Dialogue: 0,0:08:54.76,0:08:56.81,Main,Hody,0,0,0,,Ama şimdilik, yüz bin yeni vatandaşımız var!Dialogue: 0,0:08:58.17,0:09:03.06,Main,Hody,0,0,0,,Irkımızın yüz karaları evlerini size teslim etmeye zorlanacaklar.Dialogue: 0,0:09:04.16,0:09:08.83,Main,Hody,0,0,0,,Ölmek ya da kaçmak...  Hemen kararlarını vermeliler!Dialogue: 0,0:09:08.83,0:09:12.86,Main,Shyarly,0,0,0,,Toplum içinde ne büyük bir kargaşa çıkarıyorsun.Dialogue: 0,0:09:13.88,0:09:16.08,Main,Shyarly,0,0,0,,Ne haysiyetsizce.Dialogue: 0,0:09:17.00,0:09:19.09,Main,Shyarly,0,0,0,,Böyle kendini kaptırıp gitme...Dialogue: 0,0:09:19.95,0:09:23.12,Main,Shyarly,0,0,0,,Hody Jones.Dialogue: 0,0:09:23.12,0:09:25.17,Main,Hody,0,0,0,,Görüşmeyeli uzun zaman oldu.Dialogue: 0,0:09:25.70,0:09:28.09,Main,Hody,0,0,0,,Ne istiyorsun?Dialogue: 0,0:09:28.09,0:09:33.42,Main,Shyarly,0,0,0,,Çoktan kazandığını düşünen sana,  bir şey söylemek istiyorum.Dialogue: 0,0:09:33.97,0:09:35.81,Main,Fukaboshi,0,0,0,,Madam Shyarly.Dialogue: 0,0:09:35.81,0:09:40.36,Main,Fukaboshi,0,0,0,,Belirli bir adamın  Balık Adam Adası'nı yok edeceğini gördüm...Dialogue: 0,0:09:41.04,0:09:42.94,Main,Fukaboshi,0,0,0,,kehanetlerimde.Dialogue: 0,0:09:42.94,0:09:46.57,Main,Hody,0,0,0,,En sonunda biz de yok edebiliriz.Dialogue: 0,0:09:47.15,0:09:49.32,Main,Hody,0,0,0,,Beni mi gördün yani?Dialogue: 0,0:09:51.62,0:09:52.63,Main,Shyarly,0,0,0,,Hayır.Dialogue: 0,0:09:54.14,0:09:56.91,Main,Shyarly,0,0,0,,Bu adayı yok edeceğini gördüğüm adam...Dialogue: 0,0:09:57.78,0:09:59.65,Main,Shyarly,0,0,0,,Hasır Şapka Luffy.Dialogue: 0,0:09:59.65,0:10:01.86,Main,Hody,0,0,0,,Ne demeye çalışıyorsun?Dialogue: 0,0:10:01.86,0:10:03.86,Main,Shyarly,0,0,0,,Sizin olmadığınızı!Dialogue: 0,0:10:05.23,0:10:07.24,Main,Shyarly,0,0,0,,Bir şey kesin...Dialogue: 0,0:10:07.24,0:10:10.75,Main,Shyarly,0,0,0,,Biri Balık Adam Adası'nın kaderini ellerinde tutuyor.Dialogue: 0,0:10:10.75,0:10:13.67,Main,Shyarly,0,0,0,,Ama Hody, biliyorum ki...Dialogue: 0,0:10:13.67,0:10:15.38,Main,Shyarly,0,0,0,,O kişi sen değilsin.Dialogue: 0,0:10:16.64,0:10:20.06,Main,Fishman,0,0,0,,Anladım! Madam'ın kehanetleri yanlış çıkmaz!Dialogue: 0,0:10:20.06,0:10:24.22,Main,Fishman,0,0,0,,Yani, Hody'nin bu adaya hükmettiği geleceğin...Dialogue: 0,0:10:24.22,0:10:25.59,Main,Fishman,0,0,0,,yaşanma ihtimali yok!Dialogue: 0,0:10:33.24,0:10:35.03,Main,Fishman,0,0,0,,Madam Shyarly!Dialogue: 0,0:10:35.03,0:10:36.39,Main,Mermaid,0,0,0,,Madam!Dialogue: 0,0:10:36.39,0:10:37.45,Main,Fishman,0,0,0,,Bunu nasıl yapar?!Dialogue: 0,0:10:38.04,0:10:43.15,Main,Hody,0,0,0,,Saçmalık. Neyi ima ediyordun, Shyarly?Dialogue: 0,0:10:43.15,0:10:44.30,Main,Hody,0,0,0,,İntikam almak mı istiyordun?!Dialogue: 0,0:10:45.87,0:10:49.96,Main,Hody,0,0,0,,Ben senin abinden farklıyım.Dialogue: 0,0:10:50.40,0:10:57.66,Main,Hody,0,0,0,,Evet, ben daha çocukken, Balık Adam Bölgesi'ndeki herkes abin Arlong'a hayranlık duyardı.Dialogue: 0,0:10:58.63,0:11:03.14,Main,Hody,0,0,0,,Ama biz güç kazandık!Dialogue: 0,0:11:03.14,0:11:10.86,Main,Hody,0,0,0,,Şimdiye dek, Arlong Korsanları'nın işareti sadece bizi bir arada tutan boş bir semboldü.Dialogue: 0,0:11:10.86,0:11:14.36,Main,Hody,0,0,0,,Artık Arlong'un adı tamamen gereksiz!Dialogue: 0,0:11:14.92,0:11:21.87,Main,Hody,0,0,0,,Bu ülkeyi yerle bir edip  sonra da yeniden yaratabilecek...Dialogue: 0,0:11:21.87,0:11:24.42,Main,Hody,0,0,0,,tek kişi benim!Dialogue: 0,0:11:24.42,0:11:27.16,Main,Hody,0,0,0,,Bende bunu yapabilecek güç var!Dialogue: 0,0:11:29.16,0:11:32.37,Main,Hody,0,0,0,,Şu güruha bir bakın!Dialogue: 0,0:11:33.08,0:11:35.57,Main,Hody,0,0,0,,Bu benim gücüm!Dialogue: 0,0:11:36.90,0:11:42.76,Main,Hody,0,0,0,,Benim planım on yıldır işliyor!Dialogue: 0,0:11:42.76,0:11:45.02,Main,Hody,0,0,0,,Size bir şey söyleyeyim...Dialogue: 0,0:11:45.02,0:11:51.14,Main,Hody,0,0,0,,Ryugu Krallığı'nın, sizin çok sevdiğiniz Kraliçesi...Dialogue: 0,0:11:54.79,0:11:59.28,Main,Hody,0,0,0,,Otohime'yi öldüren...Dialogue: 0,0:12:00.85,0:12:02.03,Main,Hody,0,0,0,,bendim! Dialogue: 0,0:12:08.93,0:12:10.50,Main,Jinbe,0,0,0,,Ne?!Dialogue: 0,0:12:15.14,0:12:16.09,Main,Fishman,0,0,0,,Olamaz!Dialogue: 0,0:12:16.09,0:12:17.76,Main,Fishman,0,0,0,,O zaman...Dialogue: 0,0:12:17.76,0:12:19.76,Main,Fishman,0,0,0,,o insan..?Dialogue: 0,0:12:23.01,0:12:25.59,Main,Daruma,0,0,0,,Fark edememek sizin aptallığınız!Dialogue: 0,0:12:26.94,0:12:30.35,Main,Hody,0,0,0,,On yıl önceki o günden birkaç gün önce...Dialogue: 0,0:12:31.86,0:12:39.36,Flashbacks,Pirate,0,0,0,,Kim olduğunu bilmiyorum ama eğer iyi ödüyorsan, her işi seve seve yaparım.Dialogue: 0,0:12:43.15,0:12:44.81,Flashbacks,Pirate,0,0,0,,Gerçekten mi?!Dialogue: 0,0:12:44.81,0:12:46.95,Flashbacks,Hody,0,0,0,,Bu ödemenin yarısı.Dialogue: 0,0:12:46.95,0:12:49.70,Flashbacks,Hody,0,0,0,,Geri kalanını işi hallettikten sonra vereceğim.Dialogue: 0,0:12:49.70,0:12:52.62,Flashbacks,Pirate,0,0,0,,Pekala, kabul ediyorum.Dialogue: 0,0:12:52.62,0:12:56.41,Flashbacks,Pirate,0,0,0,,Bu kadarı bile bir süre içmem için yeter.Dialogue: 0,0:12:59.90,0:13:01.76,Flashbacks,Pirate,0,0,0,,Nasıl bir iş bu?Dialogue: 0,0:13:02.40,0:13:05.43,Flashbacks,Hody,0,0,0,,Bir çocuğun bile yapabileceği, kolay bir iş.Dialogue: 0,0:13:05.43,0:13:10.14,Flashbacks,Hody,0,0,0,,Ama kimsenin seni farketmediğinden emin olmalısın!Dialogue: 0,0:13:13.04,0:13:15.27,Main,Hody,0,0,0,,Sonra da, o gün...Dialogue: 0,0:13:23.08,0:13:25.72,Flashbacks,Warrior,0,0,0,,Geri çekilin! Yangın var! Dialogue: 0,0:13:25.72,0:13:26.95,Flashbacks,Warrior,0,0,0,,Ateşi söndürün!Dialogue: 0,0:13:26.95,0:13:27.69,Flashbacks,Warrior,0,0,0,,Kaçın!Dialogue: 0,0:13:27.69,0:13:29.20,Flashbacks,Warrior,0,0,0,,Kraliyet Ailesi'ni koruyun!Dialogue: 0,0:13:29.20,0:13:31.23,Flashbacks,Warrior,0,0,0,,Acele edin ve ateşleri söndürün!Dialogue: 0,0:13:42.97,0:13:46.15,Flashbacks,Warrior,0,0,0,,Otohime-sama vuruldu!Dialogue: 0,0:13:47.03,0:13:50.45,Flashbacks,Pirate,0,0,0,,Hey! Paranın geri kalanını ver artık!Dialogue: 0,0:13:50.45,0:13:53.95,Flashbacks,Pirate,0,0,0,,Tam da söz verdiğim gibi, imzaları yaktım!Dialogue: 0,0:13:53.95,0:13:57.24,Flashbacks,Pirate,0,0,0,,Bir daha seni rahatsız etmeyeceğim, hemen parayı ver!Dialogue: 0,0:14:03.25,0:14:05.07,Flashbacks,Pirate,0,0,0,,Bu da ne demek?!Dialogue: 0,0:14:05.07,0:14:07.81,Flashbacks,Hody,0,0,0,,Aptal insan.Dialogue: 0,0:14:07.81,0:14:10.22,Flashbacks,Pirate,0,0,0,,Lanet olsun... Lanet olsun!Dialogue: 0,0:14:19.02,0:14:20.77,Flashbacks,Hody,0,0,0,,Bir insan... Dialogue: 0,0:14:21.82,0:14:25.78,Flashbacks,Hody,0,0,0,,ülkemizin kraliçesini öldürdü!Dialogue: 0,0:14:25.78,0:14:33.10,Flashbacks,Hody,0,0,0,,Kraliçe Otohime'nin katili bir insan! Dialogue: 0,0:14:33.87,0:14:36.97,Main,Neptune,0,0,0,,Hody, seni pislik!Dialogue: 0,0:14:42.01,0:14:43.11,Main,Fukaboshi,0,0,0,,Baba!Dialogue: 0,0:14:43.50,0:14:44.38,Main,Ryuuboshi,0,0,0,,Baba!Dialogue: 0,0:14:44.71,0:14:46.58,Main,Manboshi,0,0,0,,Hody, kes şunu!Dialogue: 0,0:14:46.58,0:14:48.85,Main,Ryuuboshi,0,0,0,,Baba!Dialogue: 0,0:14:52.63,0:14:55.30,Main,Hody,0,0,0,,Tam bir baş belasıydı.Dialogue: 0,0:14:55.30,0:14:57.58,Main,Hody,0,0,0,,Değil mi, Shirahoshi?!Dialogue: 0,0:14:58.89,0:15:01.43,Main,Hody,0,0,0,,İnsanlara karşı intikam almanın kötü olduğunu iddia etti...Dialogue: 0,0:15:02.04,0:15:05.94,Main,Hody,0,0,0,,Adanın her yerinde insanlarla iyi geçinmemiz gerektiğine dair vaaz verdi...Dialogue: 0,0:15:05.94,0:15:09.69,Main,Hody,0,0,0,,Ve o kadın neredeyse hayallerini gerçekleştirdi. Onun hakkındaki her şeyden nefret ettim!Dialogue: 0,0:15:10.15,0:15:13.91,Main,Hody,0,0,0,,Hayır, onu öldürsem bile etkisi yok olmayacak bir insandı!Dialogue: 0,0:15:14.28,0:15:18.12,Main,Hody,0,0,0,,Ama benim için, senin annen...Dialogue: 0,0:15:18.12,0:15:21.75,Main,Hody,0,0,0,,ölmesi gereken bir kadındı!Dialogue: 0,0:15:21.75,0:15:24.08,Main,Fishman,0,0,0,,Dur! Prensesi incitmeyi kes!Dialogue: 0,0:15:24.51,0:15:25.50,Main,Fishman,0,0,0,,Çok zalimce!Dialogue: 0,0:15:29.97,0:15:31.77,Main,Shirahoshi,0,0,0,,Biliyordum.Dialogue: 0,0:15:32.48,0:15:33.98,Main,Neptune,0,0,0,,Shirahoshi!Dialogue: 0,0:15:40.07,0:15:41.96,Main,Hody,0,0,0,,Ne?!Dialogue: 0,0:15:49.99,0:15:52.53,Main,Pirate,0,0,0,,N-Ne? Ne oldu?!Dialogue: 0,0:15:52.53,0:15:58.10,Main,Decken,0,0,0,,Reddedilmenin kalbimdeki acısı asla yok olmayacak.Dialogue: 0,0:15:59.26,0:16:01.27,Main,Wadatsumi,0,0,0,,N-N-Ne?!Dialogue: 0,0:16:08.85,0:16:11.15,Main,Pirate,0,0,0,,Hareket ediyor!Dialogue: 0,0:16:11.15,0:16:13.08,Main,Pirate,0,0,0,,B-Bu da ne böyle?Dialogue: 0,0:16:13.08,0:16:14.18,Main,Pirate,0,0,0,,Kaçın!Dialogue: 0,0:16:14.19,0:16:19.82,Main,Pirate,0,0,0,,Noah'ı doğruca Shirahoshi'ye doğru gönderdim!Dialogue: 0,0:16:19.82,0:16:21.18,Main,Pirate,0,0,0,,Neeeee?!Dialogue: 0,0:16:21.18,0:16:24.53,Main,Pirate,0,0,0,,Noah, Balık Adam Adası'nın yarısı büyüklüğünde!Dialogue: 0,0:16:24.53,0:16:27.37,Main,Pirate,0,0,0,,Yani bu, eğer Noah ada ile çarpışırsa...Dialogue: 0,0:16:27.37,0:16:30.30,Main,Pirate,0,0,0,,Shirahoshi'yi öldürmekle kalmayıp, adayı da un ufak eder demek oluyor!Dialogue: 0,0:16:30.30,0:16:33.89,Main,Decken,0,0,0,,Kaçacak veya saklanacak yer yok!Dialogue: 0,0:16:33.89,0:16:39.51,Main,Decken,0,0,0,,Shirahoshi sonsuza kadar kalbimin içinde yaşamaya devam edecek!Dialogue: 0,0:16:39.92,0:16:42.58,Main,Decken,0,0,0,,Tüm ada yok olsun!Dialogue: 0,0:16:42.58,0:16:45.41,Main,Decken,0,0,0,,Elveda, sevgili Shirahoshi!Dialogue: 0,0:16:45.41,0:16:49.15,Main,Decken,0,0,0,,Elveda, Balık Adam Adası!Dialogue: 0,0:16:52.03,0:16:57.56,Main,Hody,0,0,0,,Benim senin anneni öldürdüğümü biliyor muydun?Dialogue: 0,0:16:57.56,0:17:01.95,Main,Hody,0,0,0,,Bu da ne demek oluyor, Shirahoshi?!Dialogue: 0,0:17:05.03,0:17:06.92,Main,Fukaboshi,0,0,0,,Baba! İyi misin?Dialogue: 0,0:17:07.43,0:17:08.48,Main,Fukaboshi,0,0,0,,Dayan!Dialogue: 0,0:17:12.29,0:17:14.10,Main,Neptune,0,0,0,,Shirahoshi...Dialogue: 0,0:17:16.54,0:17:22.48,Main,Shirahoshi,0,0,0,,Olaydan birkaç yıl sonra, Megalo bana gizlice söyledi.Dialogue: 0,0:17:23.35,0:17:24.32,Main,Hody,0,0,0,,Megalo mu?Dialogue: 0,0:17:24.48,0:17:27.80,Main,Shirahoshi,0,0,0,,Megalo eskiden Neptune Ordusu'nun evcil hayvanıydı.Dialogue: 0,0:17:28.74,0:17:32.15,Main,Shirahoshi,0,0,0,,O gün yaşanan her şeyi gördü.Dialogue: 0,0:17:42.98,0:17:45.68,Main,Jinbe,0,0,0,,Prenses Shirahoshi, o zaman neden bize söylemediniz?!Dialogue: 0,0:17:45.68,0:17:46.96,Main,Shirahoshi,0,0,0,,Söyleseydim...Dialogue: 0,0:17:49.21,0:17:55.65,Main,Shirahoshi,0,0,0,,insanlar Hody-sama'dan nefret ederdi.Dialogue: 0,0:17:55.65,0:18:00.67,Main,Shirahoshi,0,0,0,,Böyle olsaydı, annem çok üzülürdü.Dialogue: 0,0:18:08.88,0:18:14.32,Main,Shirahoshi,0,0,0,,Bu anneme verdiğim son sözdü.Dialogue: 0,0:18:15.10,0:18:18.31,Main,Shirahoshi,0,0,0,,Katil kim olursa olsun...Dialogue: 0,0:18:19.36,0:18:24.45,Main,Shirahoshi,0,0,0,,Ona sinirlenmemeli ve ondan nefret etmemeliyiz!Dialogue: 0,0:18:27.74,0:18:31.17,Flashbacks,Otohime,0,0,0,,Suçlu kim olursa olsun... Dialogue: 0,0:18:31.84,0:18:35.71,Flashbacks,Otohime,0,0,0,,benim yüzümden sinirlenmeyin lütfen.Dialogue: 0,0:18:36.30,0:18:42.27,Flashbacks,Otohime,0,0,0,,Benim yüzümden öfke ve nefret içinde kaybolmayın. Dialogue: 0,0:18:43.81,0:18:46.39,Main,Manboshi,0,0,0,,Shirahoshi... Sen...Dialogue: 0,0:18:46.86,0:18:49.39,Main,Ryuuboshi,0,0,0,,Yoksa... Sen...Dialogue: 0,0:18:49.39,0:18:53.73,Main,Fukaboshi,0,0,0,,Annemin on yıl önceki isteklerine sadık kalmak için...Dialogue: 0,0:18:57.32,0:19:05.37,Main,Fukaboshi,0,0,0,,bunca zamandır bu gerçeği  Koukaku Kulesi'nin içinde kendi başına mı taşıyordun?!Dialogue: 0,0:19:12.24,0:19:16.06,Thoughts,Jinbe,0,0,0,,Annesini öldüren insandan nefret etmiyor mu?!Dialogue: 0,0:19:16.06,0:19:23.44,Thoughts,Jinbe,0,0,0,,Annesinin son arzusu olsa bile, gerçeği bunca zaman boyunca taşımak neredeyse imkansız!Dialogue: 0,0:19:24.22,0:19:28.21,Thoughts,Jinbe,0,0,0,,Ne saygılı, cesur bir kız!Dialogue: 0,0:19:28.21,0:19:31.35,Thoughts,Jinbe,0,0,0,,Başka kim böyle bir şey yapabilir ki?Dialogue: 0,0:19:34.76,0:19:36.43,Main,Jinbe,0,0,0,,Gülme, pislik!Dialogue: 0,0:19:36.43,0:19:39.75,Main,Hody,0,0,0,,Böyle bir şeye nasıl gülmeyeyim?!Dialogue: 0,0:19:39.75,0:19:42.02,Main,Hody,0,0,0,,Değil mi, Megalo?Dialogue: 0,0:19:42.49,0:19:47.29,Main,Hody,0,0,0,,Eğer o zaman herkesin dikkatini çekseydin ve alarmı çalsaydın,Dialogue: 0,0:19:47.29,0:19:51.61,Main,Hody,0,0,0,,suikastçının ben olduğumu ortaya çıkarabilirdin.Dialogue: 0,0:19:51.61,0:19:54.69,Main,Hody,0,0,0,,Sessiz kalabilmene şaşırdım.Dialogue: 0,0:19:54.69,0:19:59.83,Main,Hody,0,0,0,,Ve sonra da gerçeği açıklamak için bu mankafa veledi seçtin!Dialogue: 0,0:20:00.63,0:20:06.14,Main,Hody,0,0,0,,Eğer başkasına söyleseydin, planlarım daha başlamadan mahvolmuş olurdu!Dialogue: 0,0:20:08.77,0:20:14.08,Main,Hody,0,0,0,,İyi dinle, Shirahoshi. Gerçek dünyada, biz buna "Aptallık" diyoruz.Dialogue: 0,0:20:14.70,0:20:19.98,Main,Hody,0,0,0,,Benden nefret etmeyi reddettiğin için,  bu krallık düşecek.Dialogue: 0,0:20:20.66,0:20:22.82,Main,Hody,0,0,0,,Senin yüzünden...Dialogue: 0,0:20:22.82,0:20:28.69,Main,Hody,0,0,0,,baban, abilerin, sen ve tüm insanlar, hepsi ölecek...Dialogue: 0,0:20:28.69,0:20:31.20,Main,Hody,0,0,0,,Shirahoshi!Dialogue: 0,0:20:32.70,0:20:35.82,Main,Jinbe,0,0,0,,Yanılıyor! Onu dinlemeyin Prenses!Dialogue: 0,0:20:35.82,0:20:37.86,Main,Jinbe,0,0,0,,Sizin yaptığınız bir hata değildi!Dialogue: 0,0:20:40.06,0:20:43.04,Main,Hody,0,0,0,,Bir hata değilse ne?!Dialogue: 0,0:20:45.57,0:20:47.97,Attack,,0,0,0,,Askeri Köpek Balığı OkuDialogue: 0,0:20:51.91,0:20:52.74,Main,Fishman,0,0,0,,Majesteleri!Dialogue: 0,0:20:52.74,0:20:54.22,Main,Fishman,0,0,0,,Prensler!Dialogue: 0,0:21:01.22,0:21:04.10,Main,Fishman,0,0,0,,Dur! Lütfen dur!Dialogue: 0,0:21:28.62,0:21:32.62,Main,Shirahoshi,0,0,0,,Baba! Abilerim!Dialogue: 0,0:21:34.66,0:21:36.82,Main,Pirate,0,0,0,,Ne acınası bir manzara!Dialogue: 0,0:21:37.76,0:21:39.36,Main,Hody,0,0,0,,Hey, bana bir kılıç verin.Dialogue: 0,0:21:40.48,0:21:44.44,Main,Hody,0,0,0,,Beni en çok endişelendiren,  Jinbe ve Shirahoshi yakalandı.Dialogue: 0,0:21:44.99,0:21:50.12,Main,Hody,0,0,0,,Artık plana uymak için bir sebep yok.Dialogue: 0,0:21:52.04,0:21:56.63,Main,Hody,0,0,0,,Bu aptal asillerin...Dialogue: 0,0:21:57.73,0:22:00.13,Main,Hody,0,0,0,,idamına şimdi başlayacağız!Dialogue: 0,0:22:03.55,0:22:05.22,Main,Fishman,0,0,0,,Yap! Öldür onları!Dialogue: 0,0:22:05.79,0:22:07.10,Main,Fishman,0,0,0,,İdam et!Dialogue: 0,0:22:08.37,0:22:16.67,Main,Fishman,0,0,0,,İdam et! İdam et! İdam et!Dialogue: 0,0:22:16.67,0:22:20.70,Main,Fishman,0,0,0,,Büyük Şövalye Neptune... gerçekten de öldürülecek!Dialogue: 0,0:22:20.70,0:22:22.89,Main,Fishman,0,0,0,,Tıpkı cehennem gibi!Dialogue: 0,0:22:23.60,0:22:26.40,Main,Fishman,0,0,0,,Düşmanlarımız yüz bin tane suçlu...Dialogue: 0,0:22:26.40,0:22:29.95,Main,Fishman,0,0,0,,Bu ülkenin artık işi bitti!Dialogue: 0,0:22:31.82,0:22:33.29,Main,Kid,0,0,0,,Madam Shyarly!Dialogue: 0,0:22:36.13,0:22:37.34,Main,Shyarly,0,0,0,,Çocuklar...Dialogue: 0,0:22:38.15,0:22:38.72,Main,Kid,0,0,0,,Söylesene...Dialogue: 0,0:22:39.42,0:22:41.74,Main,Kid,0,0,0,,O şapka takan korsan...Dialogue: 0,0:22:41.74,0:22:44.72,Main,Kid,0,0,0,,Bu adayı yok etmeye ne zaman gelecek?!Dialogue: 0,0:22:44.72,0:22:46.60,Main,Kid,0,0,0,,Söylesene! Ne zaman?!Dialogue: 0,0:22:49.54,0:22:51.68,Main,Shyarly,0,0,0,,Bilmiyorum.Dialogue: 0,0:22:51.68,0:22:54.98,Main,Shyarly,0,0,0,,Kehanetlerim sadece geleceği gösterir...Dialogue: 0,0:22:54.98,0:22:57.02,Main,Shyarly,0,0,0,,Yarın da olabilir, bir yıl sonra da.Dialogue: 0,0:22:57.53,0:22:59.07,Main,Kid,0,0,0,,Bence şimdi yapsa iyi olur.Dialogue: 0,0:23:04.09,0:23:06.95,Main,Kid,0,0,0,,Eğer şimdi etrafı yakıp yıkmaya başlarsa...Dialogue: 0,0:23:06.95,0:23:11.00,Main,Kid,0,0,0,,bizim de başımız belaya girer ama onların da başı belaya girer değil mi?!Dialogue: 0,0:23:11.00,0:23:15.98,Main,Kid,0,0,0,,Ben de şimdi gelmesini istiyorum! Kral'ın ölmesini istemiyorum!Dialogue: 0,0:23:15.98,0:23:17.17,Main,Kid,0,0,0,,Ben de!Dialogue: 0,0:23:24.75,0:23:26.80,Main,Fishman,0,0,0,,Çocukların da dediği gibi.Dialogue: 0,0:23:27.78,0:23:30.60,Main,Fishman,0,0,0,,Ben de öyle düşünüyorum.Dialogue: 0,0:23:30.60,0:23:32.14,Main,Fishwoman,0,0,0,,Evet... Evet...Dialogue: 0,0:23:35.03,0:23:38.99,Main,Fishman,0,0,0,,Hey! Hasır Şapkalı Luffy!Dialogue: 0,0:23:41.24,0:23:46.17,Main,Fishman,0,0,0,,Eğer adayı yok etmek istiyorsan, şimdi yap!Dialogue: 0,0:23:46.17,0:23:49.04,Main,Fishman,0,0,0,,Hemen şimdi, burayı altüst et!Dialogue: 0,0:23:49.04,0:23:52.46,Main,Fishman,0,0,0,,Evet! Duyuyor musun, Hasır Şapka?!Dialogue: 0,0:23:52.89,0:23:56.30,Main,Fishman,0,0,0,,Eğer adanın bir yerindeysen, hemen gel!Dialogue: 0,0:23:56.30,0:23:58.09,Main,Fishman,0,0,0,,Hasır Şapka!Dialogue: 0,0:23:58.74,0:24:03.00,Main,Fishman,0,0,0,,Hasır Şapka! Hasır Şapka! Hasır Şapka!Dialogue: 0,0:24:03.50,0:24:05.16,Main,Hody,0,0,0,,İnanılmaz.Dialogue: 0,0:24:05.16,0:24:08.78,Main,Hody,0,0,0,,Denize düşüp yılana sarılıyorlar!Dialogue: 0,0:24:08.78,0:24:14.92,Main,Hody,0,0,0,,Shyarly'nin kehanetleri şimdiye kadar hep tutarlı olmuştu ama bu seferlik büyük bir yalan gibi duruyor.Dialogue: 0,0:24:15.95,0:24:18.02,Main,Zeo,0,0,0,,Ne anlamsız haykırışlar.Dialogue: 0,0:24:18.02,0:24:22.49,Main,Hody,0,0,0,,Hayal dünyasında yaşayan aptalları gerçekliğe çekme vakti.Dialogue: 0,0:24:26.49,0:24:29.10,Main,Hody,0,0,0,,Dinleyin, ada sakinleri!Dialogue: 0,0:24:29.10,0:24:32.83,Main,Hody,0,0,0,,Şimdi, eski Kral Neptune'un...Dialogue: 0,0:24:33.39,0:24:35.60,Main,Hody,0,0,0,,idamını gerçekleştireceğim!Dialogue: 0,0:24:36.68,0:24:38.44,Main,Fukaboshi,0,0,0,,Baba...Dialogue: 0,0:24:38.93,0:24:41.36,Main,Hody,0,0,0,,İyice izleyin...Dialogue: 0,0:24:41.36,0:24:46.48,Main,Hody,0,0,0,,eski Kral Neptune'un kafasının uçmasını!Dialogue: 0,0:24:46.63,0:24:47.86,Main,Neptune,0,0,0,,Acınası...Dialogue: 0,0:24:47.86,0:24:49.33,Main,Hody,0,0,0,,Geber!Dialogue: 0,0:24:50.66,0:24:54.29,Main,Shirahoshi,0,0,0,,Lütfen, babamı koruyun!Dialogue: 0,0:24:54.29,0:24:57.89,Main,Shirahoshi,0,0,0,,Luffy-sama!Dialogue: 0,0:25:33.61,0:25:35.78,Main,Fishman,0,0,0,,O...Dialogue: 0,0:25:39.29,0:25:42.87,Main,Fishman,0,0,0,,Hasır Şapkalı... Luffy!Dialogue: 0,0:25:43.59,0:25:47.83,Main,Fishman,0,0,0,,Gerçekten de... ortaya çıktı!Dialogue: 0,0:25:49.60,0:25:51.79,Main,Fishman,0,0,0,,Hey, gördün mü?Dialogue: 0,0:25:51.79,0:25:54.00,Main,Fishman,0,0,0,,Kral Neptune'u kurtardı!Dialogue: 0,0:25:54.00,0:25:59.59,Main,Fishman,0,0,0,,Evet... Ve az önce Prenses Shirahoshi'nin ondan yardım istediğini duyduğuma eminim...Dialogue: 0,0:26:01.17,0:26:02.77,Main,Shirahoshi,0,0,0,,Luffy-sama!Dialogue: 0,0:26:03.45,0:26:04.96,Main,Zeo,0,0,0,,Köpek balığının içinden mi çıktı?!Dialogue: 0,0:26:05.80,0:26:07.88,Main,Daruma,0,0,0,,Bunca zamandır karnında mıymış?!Dialogue: 0,0:26:07.88,0:26:08.31,Main,Daruma,0,0,0,,Neden?!Dialogue: 0,0:26:08.97,0:26:12.27,Main,Jinbe,0,0,0,,Erken mi çıktın?Dialogue: 0,0:26:12.27,0:26:14.40,Main,Jinbe,0,0,0,,Başka seçeneğin yoktu sanırım.Dialogue: 0,0:26:14.40,0:26:16.82,Main,Jinbe,0,0,0,,Acele edin, hepiniz!Dialogue: 0,0:26:17.98,0:26:20.98,Main,Ikaros,0,0,0,,Ne? Kiminle konuşuyor-hi?!Dialogue: 0,0:26:20.98,0:26:23.87,Main,Nami,0,0,0,,Endişelenme. Başından beri acele ediyorduk zaten.Dialogue: 0,0:26:25.49,0:26:29.27,Main,Nami,0,0,0,,Luffy'nin plana uygun bir şekilde beklemesi için...Dialogue: 0,0:26:29.65,0:26:32.64,Main,Nami,0,0,0,,bir tür mucize falan lazım.Dialogue: 0,0:26:34.68,0:26:36.24,Main,Nami,0,0,0,,Serap bozuldu!Dialogue: 0,0:26:37.48,0:26:40.38,Main,Ikaros,0,0,0,,Bir anda bir kadın beliriverdi-hi!Dialogue: 0,0:26:40.81,0:26:42.97,Main,Nami,0,0,0,,Bu yeterli mi, Jinbe-chan?Dialogue: 0,0:26:42.97,0:26:44.69,Main,Nami,0,0,0,,Kutsal Ejderler'den bir form.Dialogue: 0,0:26:44.69,0:26:46.30,Main,Jinbe,0,0,0,,Harika, iyi iş çıkardın!Dialogue: 0,0:26:46.83,0:26:49.02,Main,Pirate,0,0,0,,Olamaz! Ne?!Dialogue: 0,0:26:49.02,0:26:51.24,Main,Pirate,0,0,0,,Form gitmiş! O ne zaman...Dialogue: 0,0:26:51.24,0:26:54.14,Main,Pirate,0,0,0,,Aptal! Ne yapıyordun?!Dialogue: 0,0:26:54.14,0:26:55.89,Main,Nami,0,0,0,,Ve zincirlerin anahtarları da Robin'de.Dialogue: 0,0:26:56.73,0:26:57.87,Main,Pirate,0,0,0,,Olamaz...Dialogue: 0,0:26:58.63,0:27:00.05,Main,Pirate,0,0,0,,Anahtarlar gitmiş!Dialogue: 0,0:27:00.05,0:27:01.78,Main,Pirate,0,0,0,,Asıl sen ne yapıyordun?!Dialogue: 0,0:27:05.04,0:27:06.41,Main,Manboshi,0,0,0,,Zincirler!Dialogue: 0,0:27:06.41,0:27:07.24,Main,Fukaboshi,0,0,0,,Bu da ne?Dialogue: 0,0:27:10.83,0:27:12.37,Main,Shirahoshi,0,0,0,,Robin-sama...Dialogue: 0,0:27:14.04,0:27:15.49,Main,Neptune,0,0,0,,Bu da ne?Dialogue: 0,0:27:15.49,0:27:17.71,Main,Fukaboshi,0,0,0,,Baba! İyi misin?!Dialogue: 0,0:27:17.71,0:27:20.13,Main,Fishman,0,0,0,,Hey, gökyüzüne bakın! O da ne?Dialogue: 0,0:27:21.28,0:27:22.49,Main,Fukaboshi,0,0,0,,O...Dialogue: 0,0:27:23.19,0:27:26.30,Main,Fishman,0,0,0,,Bir balina... ve bir aslan mı?Dialogue: 0,0:27:26.30,0:27:28.50,Main,Fishman,0,0,0,,Hayır, değil!Dialogue: 0,0:27:28.50,0:27:29.76,Main,Fishman,0,0,0,,O...Dialogue: 0,0:27:31.02,0:27:33.73,Attack,TL Note,0,0,0,,Aslan Kükremesi TopuDialogue: 0,0:27:38.52,0:27:40.36,Main,Pirate,0,0,0,,Korsan gemisi!Dialogue: 0,0:27:40.36,0:27:42.23,Main,Franky,0,0,0,,Ateş!Dialogue: 0,0:27:53.88,0:27:56.29,Main,Franky,0,0,0,,Şimdi! Hadi, balina!Dialogue: 0,0:28:01.18,0:28:01.75,Main,Fukaboshi,0,0,0,,Hoe?!Dialogue: 0,0:28:01.75,0:28:04.92,Main,Jinbe,0,0,0,,Prensler! Acele edin ve burayı terk edin!Dialogue: 0,0:28:04.92,0:28:08.70,Main,Dosun,0,0,0,,İzin vermeyeceğim! Dur-zugan!Dialogue: 0,0:28:11.00,0:28:13.22,Main,Pirate,0,0,0,,Asilleri aldılar!Dialogue: 0,0:28:13.22,0:28:17.01,Main,Dosun,0,0,0,,Kahretsin! Kraliyet Ailesi'ni geri getir-gyaban!Dialogue: 0,0:28:18.71,0:28:20.64,Main,Neptune,0,0,0,,Ne... oldu?Dialogue: 0,0:28:23.36,0:28:28.15,Main,Fukaboshi,0,0,0,,Jinbe, Hasır Şapkalar ile  bir plan kurmuş gibi görünüyor.Dialogue: 0,0:28:40.31,0:28:43.65,Main,Chopper,0,0,0,,Bak! Bir sürü insan var!Dialogue: 0,0:28:44.12,0:28:47.05,Main,Usopp,0,0,0,,Hey, hey! Bunların hepsi düşman mı şimdi?Dialogue: 0,0:28:47.61,0:28:51.22,Main,Sanji,0,0,0,,Muhtemelen. Buradan bakınca yetmiş, seksen...Dialogue: 0,0:28:51.22,0:28:53.52,Main,Sanji,0,0,0,,Hayır, yüz bin kişi falan var.Dialogue: 0,0:28:54.24,0:28:56.29,Main,Brook,0,0,0,,Bu biraz zorlu.Dialogue: 0,0:28:56.72,0:28:59.78,Main,Zoro,0,0,0,,O zaman, gidip odanda kestirmekte özgürsün.Dialogue: 0,0:28:59.78,0:29:01.26,Main,Zoro,0,0,0,,Ben hepsini halledeceğim!Dialogue: 0,0:29:01.76,0:29:03.33,Main,Sanji,0,0,0,,Ne dedin sen?!Dialogue: 0,0:29:05.38,0:29:07.44,Main,Franky,0,0,0,,Yerinizde duramıyorsunuz bakıyorum.Dialogue: 0,0:29:07.44,0:29:10.91,Main,Franky,0,0,0,,Hadi gidelim o zaman, beyler!Dialogue: 0,0:29:10.91,0:29:14.91,Main,Fishman,0,0,0,,Bakın! Hasır Şapkalar teker teker gemiden iniyorlar!Dialogue: 0,0:29:25.25,0:29:27.50,Main,Fishman,0,0,0,,Hey, Hasır Şapkalı Luffy!Dialogue: 0,0:29:28.09,0:29:32.05,Main,Fishman,0,0,0,,Bu adayı gerçekten yok etme niyetinde misin?!Dialogue: 0,0:29:32.42,0:29:34.75,Main,Fishman,0,0,0,,Ryugu Şatosu'nu neden işgal ettiniz?!Dialogue: 0,0:29:34.75,0:29:37.30,Main,Fishman,0,0,0,,Siz de mi Kraliyet Ailesi'ni öldürmek istiyorsunuz?!Dialogue: 0,0:29:37.95,0:29:41.64,Main,Fishman,0,0,0,,Deniz kızlarını kaçıran siz miydiniz?!Dialogue: 0,0:29:41.64,0:29:44.04,Main,Fishman,0,0,0,,Hey, cevap verin!Dialogue: 0,0:29:44.04,0:29:48.43,Main,Fishman,0,0,0,,Siz Balık Adam Adası'nın düşmanı mısınız, müttefiki mi?Dialogue: 0,0:29:48.43,0:29:51.28,Main,Fishman,0,0,0,,Cevap ver, Hasır Şapka!Dialogue: 0,0:29:58.80,0:30:00.68,Main,Luffy,0,0,0,,Düşman mıyız, müttefik mi...Dialogue: 0,0:30:01.60,0:30:02.84,Main,Luffy,0,0,0,,Buna...Dialogue: 0,0:30:12.69,0:30:16.55,Main,Luffy,0,0,0,,siz kendiniz karar verin!Dialogue: 0,0:00:02.99,0:00:08.38,Main,,0,0,0,,Dünyanın sunabileceği her şeyi elde eden adam, Korsanlar Kralı Gold Roger.Dialogue: 0,0:00:08.38,0:00:13.00,Main,,0,0,0,,Son sözleri dünyanın her yerinden maceracıları denize çekti.Dialogue: 0,0:00:13.00,0:00:14.68,Main,,0,0,0,,"Hazinem mi?"Dialogue: 0,0:00:14.68,0:00:16.22,Main,,0,0,0,,"İstiyorsanız, size vereceğim!"Dialogue: 0,0:00:16.22,0:00:17.42,Main,,0,0,0,,"Arayın ve bulun!"Dialogue: 0,0:00:17.42,0:00:19.87,Main,,0,0,0,,"Bu dünyanın sunabileceği her şeyi orada bıraktım!"Dialogue: 0,0:00:19.87,0:00:22.69,Main,,0,0,0,,Korsanlar hayallerinin peşinden yola çıktılar!Dialogue: 0,0:00:22.69,0:00:25.35,Main,,0,0,0,,Dünya, Büyük Korsan Çağı'na girdi!Dialogue: 0,0:00:25.35,0:00:29.31,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪Dialogue: 0,0:00:29.31,0:00:33.81,We Go lyrics,,0,0,0,,♪ Şafak vakti gelmedi bile ve ben bekleyemiyorum! ♪Dialogue: 0,0:00:33.81,0:00:37.48,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı, dört... Gidelim! ♪Dialogue: 0,0:00:38.97,0:00:43.05,We Go lyrics,,0,0,0,,♪ Bayrağımızı dalgalandıralım, macera şafağının doğuşuna. ♪Dialogue: 0,0:00:44.41,0:00:49.74,We Go lyrics,,0,0,0,,♪ Dalgalar yapalım, bizi uykumuzdan kaldırsınlar. ♪Dialogue: 0,0:00:49.74,0:00:54.28,We Go lyrics,,0,0,0,,♪ Eğer inanılmaz bir dünyaya gitmek istiyorsan,Dialogue: 0,0:00:54.28,0:00:58.79,We Go lyrics,,0,0,0,, gerekli olan şey senin dayanıklılığın. ♪Dialogue: 0,0:00:59.11,0:01:01.73,We Go lyrics,,0,0,0,,♪ Fazla dikkat çekmek, bu bir suç mu? ♪Dialogue: 0,0:01:01.73,0:01:04.62,We Go lyrics,,0,0,0,,♪ Aranıyor → Kazanan demektir! ♪Dialogue: 0,0:01:04.62,0:01:10.50,We Go lyrics,,0,0,0,,♪ Özgür olmak bizim tek kuralımız! ♪Dialogue: 0,0:01:10.50,0:01:15.99,We Go lyrics,,0,0,0,,♪ Endişelerinizi unutun, bırakın rüzgar essin. ♪Dialogue: 0,0:01:15.99,0:01:18.53,We Go lyrics,,0,0,0,,♪ Ne pahasına olursa olsun, One Piece'i ilk biz bulacağız! ♪Dialogue: 0,0:01:18.53,0:01:22.66,We Go lyrics,,0,0,0,,♪ Hayal kuran kalplerimiz, çok büyük... ♪Dialogue: 0,0:01:22.66,0:01:26.93,We Go lyrics,,0,0,0,,♪ Onları uyandırmamak önemli. ♪Dialogue: 0,0:01:26.93,0:01:29.57,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪Dialogue: 0,0:01:29.57,0:01:33.54,We Go lyrics,,0,0,0,,♪ Şafak vakti gelmedi bile ve ben bekleyemiyorum! ♪Dialogue: 0,0:01:33.54,0:01:37.33,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı, dört... Gidelim! ♪Dialogue: 0,0:01:38.76,0:01:44.72,We Go lyrics,,0,0,0,,♪ Biz... buralara kadar geldik. ♪Dialogue: 0,0:01:44.72,0:01:47.62,We Go lyrics,,0,0,0,,♪ Gideceğiz... hayallerimizin olduğu yere,Dialogue: 0,0:01:47.62,0:01:52.70,We Go lyrics,,0,0,0,, ve kimseyi arkada bırakmayacağız. ♪Dialogue: 0,0:01:52.70,0:01:55.30,We Go lyrics,,0,0,0,,♪ Hep devam edeceğiz, bu bir söz. ♪Dialogue: 0,0:01:55.30,0:01:59.47,We Go lyrics,,0,0,0,,♪ Hayallerimizin başladığı o günden beri,Dialogue: 0,0:01:59.47,0:02:03.72,We Go lyrics,,0,0,0,, belirlediğimiz gelecek, değişmedi! ♪Dialogue: 0,0:02:03.72,0:02:06.24,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪Dialogue: 0,0:02:06.24,0:02:10.61,We Go lyrics,,0,0,0,,♪ Kalbimdeki güneş, asla batmayacak! ♪Dialogue: 0,0:02:10.61,0:02:13.38,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... ♪Dialogue: 0,0:02:14.78,0:02:17.57,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... ♪Dialogue: 0,0:02:18.75,0:02:24.82,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... dört... Gidelim! ♪Dialogue: 0,0:02:27.27,0:02:29.67,We Go lyrics,,0,0,0,,♪ Gidelim! ♪