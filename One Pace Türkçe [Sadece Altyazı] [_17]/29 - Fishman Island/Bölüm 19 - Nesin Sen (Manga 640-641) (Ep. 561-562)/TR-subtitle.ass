Dialogue: 0,0:02:53.09,0:02:55.81,Main,Hody,0,0,0,,Hepsini koruyacağım mı?
Dialogue: 0,0:02:55.81,0:02:57.36,Main,Hody,0,0,0,,Güldürme beni!
Dialogue: 0,0:02:57.36,0:03:01.03,Main,Hody,0,0,0,,Gerçekten boş konuşuyorsun, Hasır Şapka.
Dialogue: 0,0:03:07.27,0:03:10.77,Main,Manboshi,0,0,0,,Lanet Hody. Decken'e bile saldırdı.
Dialogue: 0,0:03:10.77,0:03:13.30,Main,Ryuuboshi,0,0,0,,Shirahoshi, kaç!
Dialogue: 0,0:03:13.30,0:03:16.07,Main,Ryuuboshi,0,0,0,,Noah'yı adadan olabildiğince uzaklaştır!
Dialogue: 0,0:03:19.34,0:03:21.33,Main,Hody,0,0,0,,Artık çok geç.
Dialogue: 0,0:03:28.81,0:03:32.38,Main,Ryuuboshi,0,0,0,,Çok geç mi? O neyden bahsediyor?
Dialogue: 0,0:03:32.38,0:03:35.96,Main,Manboshi,0,0,0,,Bekle... O az önce Decken'in işini bitirmedi mi?!
Dialogue: 0,0:03:36.61,0:03:41.38,Main,Manboshi,0,0,0,,Eğer Decken, Noah'nın içinde ölürse veya bilincini kaybederse...
Dialogue: 0,0:03:58.95,0:04:02.74,Main,Manboshi,0,0,0,,...gücü tam Balık Adam Adası'nın üstündeyken çalışmayı bırakacak.
Dialogue: 0,0:04:04.47,0:04:07.20,Main,Ryuuboshi,0,0,0,,Noah... adaya...
Dialogue: 0,0:04:08.83,0:04:10.09,Main,Ryuuboshi,0,0,0,,düşecek!
Dialogue: 0,0:04:13.73,0:04:15.23,Main,Wadatsumi,0,0,0,,Ne yapıyorsun?
Dialogue: 0,0:04:15.23,0:04:17.67,Main,Wadatsumi,0,0,0,,Canım acıdı!
Dialogue: 0,0:04:18.92,0:04:21.14,Main,Sanji,0,0,0,,Seni Manjuu pislik.
Dialogue: 0,0:04:18.92,0:04:21.14,Note,Sanji,0,0,0,,{\fad(100,100)}Manjuu: Bir Japon şekerlemesi
Dialogue: 0,0:04:21.71,0:04:23.55,Main,Sanji,0,0,0,,Ne cüretle...
Dialogue: 0,0:04:25.30,0:04:27.96,Main,Sanji,0,0,0,,Nami-san'ı düşürürsün!
Dialogue: 0,0:04:27.96,0:04:29.98,Main,Wadatsumi,0,0,0,,Ödeşme vakti!
Dialogue: 0,0:04:33.37,0:04:35.36,Main,Sanji,0,0,0,,Nami-san'ı düşürmenin...
Dialogue: 0,0:04:35.36,0:04:38.03,Main,Sanji,0,0,0,,bedeli bu! {...Say, does anyone else think this is an exceptionally petty grudge he's holding? "YOU FELL NEAR NAMI AND KNOCKED HER OVER, YOU ARE SO GOING TO DIE!!!!!!!"}
Dialogue: 0,0:04:44.35,0:04:45.12,Main,Sanji,0,0,0,,Kahretsin!
Dialogue: 0,0:04:47.70,0:04:50.81,Main,Sanji,0,0,0,,{\i1}Şok dalgasına dikkat et, Nami-san! { def: they're saying shockwave way too much.  maybe just "Look out" or something similar here? }
Dialogue: 0,0:04:52.83,0:04:56.52,Main,Nami,0,0,0,,Bir şok dalgası daha mı? Bir huzur verin artık!
Dialogue: 0,0:04:56.52,0:04:58.47,Main,Pirate,0,0,0,,Gardınızı düşürmeyin! Dikkatli olun!
Dialogue: 0,0:04:58.47,0:05:01.64,Main,Pirate,0,0,0,,Az önce aygıtının içinden bir şey uçurdu!
Dialogue: 0,0:05:10.10,0:05:11.49,Main,Pirate,0,0,0,,Şimdi ne var?!
Dialogue: 0,0:05:11.49,0:05:12.90,Main,Pirate,0,0,0,,Cadı mı o?!
Dialogue: 0,0:05:12.90,0:05:15.78,Main,Nami,0,0,0,,Ne kaba ama! Cadı falan değilim!
Dialogue: 0,0:05:17.07,0:05:19.78,Main,Nami,0,0,0,,Onun yerine büyücü diyebilirsiniz! { def: originally "Magician-chan" }
Dialogue: 0,0:05:24.49,0:05:28.87,Main,Nami,0,0,0,,Bu büyüden daha çok, hesaplanmış bilim.
Dialogue: 0,0:05:32.54,0:05:33.67,Main,Pirate,0,0,0,,B-Bulut mu?!
Dialogue: 0,0:05:34.19,0:05:35.87,Attack,TL Note,0,0,0,,{\fad(100,100)}Fırtına Bulutu Aygıtı
Dialogue: 0,0:05:46.05,0:05:48.43,Main,Ikaros,0,0,0,,{\i1}Sıcak!
Dialogue: 0,0:05:48.43,0:05:50.17,Main,Pirate,0,0,0,,Lütfen yardım edin!
Dialogue: 0,0:05:50.17,0:05:53.02,Main,Ikaros,0,0,0,,Yaklaşmayın! Kalamar tavaya döneceğim-hi!
Dialogue: 0,0:05:53.02,0:05:55.06,Main,Ikaros,0,0,0,,O kadın da neyin nesi-hi?!
Dialogue: 0,0:05:55.06,0:05:56.86,Main,Zeo,0,0,0,,Hey, Ikaros.
Dialogue: 0,0:05:56.86,0:06:03.12,Main,Zeo,0,0,0,,Siyah takım giyen adam\No kadının canının yandığını sandığında endişelendi.
Dialogue: 0,0:06:04.16,0:06:08.04,Main,Zeo,0,0,0,,O kadın muhtemelen\N Hasır Şapka Korsanları'nın zayıf noktası.
Dialogue: 0,0:06:08.04,0:06:09.02,Main,Ikaros,0,0,0,,Ne?!
Dialogue: 0,0:06:09.02,0:06:10.41,Main,Zeo,0,0,0,,Gidip onu bacaklarından tutacağım.
Dialogue: 0,0:06:10.91,0:06:13.25,Main,Zeo,0,0,0,,Tuttuğumda mızraklarınla işini bitir!
Dialogue: 0,0:06:13.25,0:06:15.08,Main,Ikaros,0,0,0,,Anlaşıldı-muhi!
Dialogue: 0,0:06:15.08,0:06:18.75,Main,Nami,0,0,0,,Kızarmak istemiyorsanız,\Nbeni rahat bırakın artık!
Dialogue: 0,0:06:22.77,0:06:25.66,Main,Nami,0,0,0,,Ne?! Bacaklarım kımıldamıyor!
Dialogue: 0,0:06:31.77,0:06:34.73,Main,Ikaros,0,0,0,,Seni kalamar tavaya çevireceğim-hi!
Dialogue: 0,0:06:34.73,0:06:36.12,Main,Nami,0,0,0,,B-B-Bekle bir saniye!
Dialogue: 0,0:06:36.12,0:06:39.69,Main,Nami,0,0,0,,Bacaklarım neden hareket etmiyor?! \NBirisi yardım etsin!
Dialogue: 0,0:06:43.34,0:06:45.03,Main,Brook,0,0,0,,Nami-san! Ah, doğru ya!
Dialogue: 0,0:06:45.03,0:06:48.70,Main,Ikaros,0,0,0,,İşte! Benim Kalamar Tava Mızrağım!
Dialogue: 0,0:06:52.04,0:06:54.12,Main,Brook,0,0,0,,Külodunuzu görebilir mi{\fscx250}-{\r}
Dialogue: 0,0:06:55.40,0:06:56.64,Main,Nami,0,0,0,,Olmaz!
Dialogue: 0,0:06:57.54,0:06:59.54,Main,Ikaros,0,0,0,,Bu senin arkadaşın mı?
Dialogue: 0,0:06:59.54,0:07:02.09,Main,Ikaros,0,0,0,,Köküne kadar kuruyacak!
Dialogue: 0,0:07:02.09,0:07:03.63,Main,Ikaros,0,0,0,,Kalamar tava ol-hi!
Dialogue: 0,0:07:04.11,0:07:04.95,Main,Brook,0,0,0,,Efendim?
Dialogue: 0,0:07:06.19,0:07:07.64,Main,Ikaros,0,0,0,,Ne oluyor-hi?
Dialogue: 0,0:07:07.64,0:07:11.14,Main,Ikaros,0,0,0,,Mızraklarımın vücudundaki suyu tüketip, köküne kadar kurutması gerekiyordu-hi!
Dialogue: 0,0:07:13.75,0:07:15.89,Main,Ikaros,0,0,0,,Hey, Kuru Kalamar Mızrakları! Neden?!
Dialogue: 0,0:07:15.89,0:07:20.23,Main,Ikaros,0,0,0,,Sorun ne?!\NNeden?! Neden?! Neden?! Neden?! Neden?! Neden?!
Dialogue: 0,0:07:20.61,0:07:21.30,Main,Brook,0,0,0,,Şey...
Dialogue: 0,0:07:22.65,0:07:25.81,Main,Brook,0,0,0,,Ben uzun zaman önce kurudum zaten.
Dialogue: 0,0:07:27.90,0:07:29.95,Main,Ikaros,0,0,0,,Büyle birinin var olması imkansız!
Dialogue: 0,0:07:31.59,0:07:36.92,Main,Franky,0,0,0,,Hey! Hiç dövüşmeye değecek rakip yok mu buralarda?
Dialogue: 0,0:07:44.10,0:07:45.67,Main,Pirate,0,0,0,,İyi misiniz?
Dialogue: 0,0:07:47.72,0:07:49.16,Main,Ikaros,0,0,0,,Sen de kimsin-hi?!
Dialogue: 0,0:07:50.61,0:07:51.71,Main,Franky,0,0,0,,Benim!
Dialogue: 0,0:07:51.71,0:07:53.09,Main,Ikaros,0,0,0,,O da ne demek-hi!
Dialogue: 0,0:07:53.09,0:07:56.21,Main,Franky,0,0,0,,Ne?! Bu süper robotu tanımıyor musun?!
Dialogue: 0,0:07:56.21,0:07:59.59,Main,Franky,0,0,0,,Ha? Şimdi bakınca farkettim de komutansın sen!
Dialogue: 0,0:07:59.59,0:08:03.09,Main,Franky,0,0,0,,Omurgalı olmalısın, değil mi?!
Dialogue: 0,0:07:59.59,0:08:03.09,Note,Franky,0,0,0,,Kuvvetli, güçlü anlamında söylüyor.
Dialogue: 0,0:08:03.09,0:08:06.35,Main,Ikaros,0,0,0,,Kalamar olsam da balık adamım!\NOmurgam var!
Dialogue: 0,0:08:06.35,0:08:10.02,Main,Brook,0,0,0,,Ne? Kalamar olmana rağmen omurgan mı var?
Dialogue: 0,0:08:06.35,0:08:10.02,Note,Brook,0,0,0,,Omurga, kemikli şeklinde anlıyor.
Dialogue: 0,0:08:10.02,0:08:11.63,Main,Brook,0,0,0,,{\i1}Sempati!
Dialogue: 0,0:08:11.63,0:08:13.03,Main,Nami,0,0,0,,Ondan bahsetmiyorlar.
Dialogue: 0,0:08:13.03,0:08:17.26,Main,Pirate,0,0,0,,Hey, iskelet. Hemen kenara çekil.
Dialogue: 0,0:08:17.26,0:08:19.59,Main,Brook,0,0,0,,Efendim? Neden acaba?
Dialogue: 0,0:08:19.59,0:08:21.33,Main,Pirate,0,0,0,,Ayakların! Ayakların!
Dialogue: 0,0:08:21.33,0:08:22.77,Main,Brook,0,0,0,,Ayaklarıma ne olmuş?
Dialogue: 0,0:08:23.45,0:08:25.38,Main,Pirate,0,0,0,,Üstünde duruyorsun! Tam üstünde!
Dialogue: 0,0:08:28.20,0:08:30.53,Main,Nami,0,0,0,,Ne?! Bu herif de kim?!
Dialogue: 0,0:08:30.53,0:08:32.75,Main,Nami,0,0,0,,Hareket edemememin sebebi o mu?!
Dialogue: 0,0:08:32.75,0:08:35.92,Main,Brook,0,0,0,,Şey... Siz de kimsiniz?
Dialogue: 0,0:08:40.09,0:08:41.67,Main,Zeo,0,0,0,,{\i1}Nasılmış?!
Dialogue: 0,0:08:41.67,0:08:42.72,Main,Brook,0,0,0,,Ne?
Dialogue: 0,0:08:43.19,0:08:46.45,Main,Zeo,0,0,0,,Ayağının altına attığım kafanın gücünü diyorum!
Dialogue: 0,0:08:48.96,0:08:50.02,Main,Absolutely everyone in the area,0,0,0,,{\i1}Ne?
Dialogue: 0,0:08:50.68,0:08:55.60,Main,Zeo,0,0,0,,Saldırım yavaşça etkisini göstermeye başlayacak.
Dialogue: 0,0:08:55.60,0:08:56.94,Main,Pirate,0,0,0,,{\i1}Ne?!
Dialogue: 0,0:08:56.94,0:08:58.84,Main,Pirate,0,0,0,,Üstüne basıldığı gerçeğini kabul etmiyor!
Dialogue: 0,0:08:59.27,0:09:01.53,Main,Brook,0,0,0,,Yüzünüze bastığım için özür dilerim!
Dialogue: 0,0:09:01.53,0:09:03.75,Main,Pirate,0,0,0,,Öyle deme!
Dialogue: 0,0:09:03.75,0:09:05.54,Main,Zeo,0,0,0,,Saldırımın adı...
Dialogue: 0,0:09:06.41,0:09:08.62,Main,Zeo,0,0,0,,Chou Ashiura Zutsuki!
Dialogue: 0,0:09:09.48,0:09:12.57,Main,Zeo,0,0,0,,Süper Ayak Tabanı Kafası!
Dialogue: 0,0:09:12.57,0:09:14.87,Main,Pirate,0,0,0,,{\i1}Ad bile verdi!
Dialogue: 0,0:09:17.52,0:09:19.93,Main,Daruma,0,0,0,,Nereye kayboldun, lanet mercan kafa?!
Dialogue: 0,0:09:19.93,0:09:22.02,Main,Daruma,0,0,0,,Seni parçalara ayıracağım!
Dialogue: 0,0:09:23.60,0:09:27.84,Main,Daruma,0,0,0,,Yeraltında kaybetmemin imkanı yok! İstediğim gibi hareket edebiliyorum!
Dialogue: 0,0:09:27.84,0:09:29.37,Main,Pirate,0,0,0,,Daruma-san!
Dialogue: 0,0:09:30.48,0:09:34.45,Main,Pirate,0,0,0,,Yeri çok fazla delikle doldurmayın lütfen!
Dialogue: 0,0:09:34.45,0:09:36.62,Main,Pirate,0,0,0,,Sıkışıp kalacağız!
Dialogue: 0,0:09:43.33,0:09:44.24,Main,Chopper,0,0,0,,Pekala!
Dialogue: 0,0:09:44.65,0:09:47.13,Main,Usopp,0,0,0,,Chopper! Hallettin mi?
Dialogue: 0,0:09:47.13,0:09:49.29,Main,Usopp,0,0,0,,Buraya gel!
Dialogue: 0,0:09:50.15,0:09:53.33,Main,Dosun,0,0,0,,Aptal! Gardını düşürdü-dogon!
Dialogue: 0,0:09:53.33,0:09:55.62,Main,Dosun,0,0,0,,Onu dümdüz edeceğim!
Dialogue: 0,0:09:56.51,0:10:00.59,Main,Dosun,0,0,0,,Ezil ve öl-zugan!
Dialogue: 0,0:10:00.59,0:10:02.85,Main,Chopper,0,0,0,,Usopp, eğil!
Dialogue: 0,0:10:05.82,0:10:08.02,Attack,TL Note,0,0,0,,{\fad(100,100)}Boynuz Topu: On Bir
Dialogue: 0,0:10:08.85,0:10:12.28,Main,Usopp,0,0,0,,Güzel, Chopper! Tünelleri birleştirdin mi?
Dialogue: 0,0:10:12.28,0:10:13.99,Main,Chopper,0,0,0,,Evet, hallettim!
Dialogue: 0,0:10:13.99,0:10:16.63,Main,Usopp,0,0,0,,Pekala! İşte gidiyoruz!
Dialogue: 0,0:10:27.63,0:10:29.65,Attack,TL Note,0,0,0,,{\fad(100,100)}Kafatası Patlatıcı Çimen
Dialogue: 0,0:10:36.33,0:10:38.34,Main,Usopp,0,0,0,,Gücüm nasılmış?!
Dialogue: 0,0:10:38.67,0:10:42.33,Main,Usopp,0,0,0,,{\fad(0,350)}Arabasta'da delikler açan düşmanlarla dövüştük! { def: my attempt at fade sux0r } {Swashy: Removed 'already' and the comma b/w 'holes' and 'back'.}
Dialogue: 0,0:10:44.47,0:10:47.08,Main,Usopp,0,0,0,,Bu deneyimimizin zaferi!
Dialogue: 0,0:10:47.08,0:10:47.77,Main,Chopper,0,0,0,,Evet!
Dialogue: 0,0:10:49.32,0:10:51.86,Main,Dosun,0,0,0,,Lanet olsun sana, mercan canavarı!
Dialogue: 0,0:10:51.86,0:10:54.02,Main,Daruma,0,0,0,,Bunu yapan sen miydin?!
Dialogue: 0,0:10:54.02,0:10:57.07,Main,Dosun,0,0,0,,Size dehşet verici gücümü göstereceğim!
Dialogue: 0,0:10:57.07,0:11:00.87,Main,Chopper,0,0,0,,İş güce geldiğinde, gizli bir kozum var!
Dialogue: 0,0:11:00.87,0:11:03.29,Main,Daruma,0,0,0,,O burnunu parçalara ayıracağım!
Dialogue: 0,0:11:03.29,0:11:07.42,Main,Usopp,0,0,0,,Denesene o zaman! Destekle beni, Chopper!
Dialogue: 0,0:11:10.61,0:11:12.41,Main,Usopp,0,0,0,,H-Hey, destek!
Dialogue: 0,0:11:13.67,0:11:14.81,Main,Usopp,0,0,0,,Chopper?
Dialogue: 0,0:11:45.46,0:11:46.48,Main,Villager,0,0,0,,Yardım et.
Dialogue: 0,0:11:46.48,0:11:47.56,Main,Villager,0,0,0,,İyi misin?
Dialogue: 0,0:11:47.56,0:11:49.07,Main,Villager,0,0,0,,Seni hemen tedavi edeceğim.
Dialogue: 0,0:11:49.07,0:11:51.07,Main,Villager,0,0,0,,Hayatım! Uyanık kal!
Dialogue: 0,0:11:51.07,0:11:53.47,Main,Villager,0,0,0,,Babacığım!
Dialogue: 0,0:11:53.47,0:11:55.50,Main,Villager,0,0,0,,Hemen yaralarını tedavi edin! Acele edin!
Dialogue: 0,0:11:55.50,0:12:00.37,Main,Villager,0,0,0,,Lanet Hody. Savunmasız vatandaşlara bile saldırdı!
Dialogue: 0,0:12:01.79,0:12:04.77,Main,Villager,0,0,0,,Prenses'in durumu... iyi mi?
Dialogue: 0,0:12:04.77,0:12:06.26,Main,Villager,0,0,0,,Bilmiyorum.
Dialogue: 0,0:12:06.95,0:12:08.61,Main,Villager,0,0,0,,Ama eminim...
Dialogue: 0,0:12:08.61,0:12:11.14,Main,Villager,0,0,0,,hala bizim için savaşıyordur!
Dialogue: 0,0:12:11.14,0:12:15.77,Main,Kid,0,0,0,,Madam Shyarly.\NBalık Adam Adası'na ne olacak? { def: more importantly, what happened to your chin? }
Dialogue: 0,0:12:15.77,0:12:17.64,Main,Kid,0,0,0,,Gerçekten yok mu olacak?!
Dialogue: 0,0:12:37.79,0:12:40.53,Thoughts,Shirahoshi,0,0,0,,Daha çok uzağa!
Dialogue: 0,0:12:42.80,0:12:44.03,Main,Hody,0,0,0,,Ne acınası.
Dialogue: 0,0:12:44.61,0:12:47.06,Thoughts,Shirahoshi,0,0,0,,Adadan uzaklaşmalıyım...
Dialogue: 0,0:12:48.10,0:12:49.86,Thoughts,Shirahoshi,0,0,0,,Noah!
Dialogue: 0,0:12:49.86,0:12:51.72,Main,Manboshi,0,0,0,,Shirahoshi!
Dialogue: 0,0:12:51.72,0:12:54.98,Main,Ryuuboshi,0,0,0,,Eğer Noah düşerse, her şey biter!
Dialogue: 0,0:12:57.86,0:12:59.70,Main,Manboshi,0,0,0,,Olamaz! Bizi duyamıyor!
Dialogue: 0,0:12:59.70,0:13:01.62,Main,Ryuuboshi,0,0,0,,Dümdüz yukarıya doğru yüzmemelisin!
Dialogue: 0,0:13:01.62,0:13:06.36,Main,Ryuuboshi,0,0,0,,Kenara! Hemen kenara çekil!
Dialogue: 0,0:13:06.36,0:13:07.91,Main,Hody,0,0,0,,Fark mı ettiler?!
Dialogue: 0,0:13:09.67,0:13:11.43,Main,Ryuuboshi,0,0,0,,Shirahoshi!
Dialogue: 0,0:13:17.02,0:13:18.05,Main,Manboshi,0,0,0,,Abi!
Dialogue: 0,0:13:18.05,0:13:19.63,Main,Fukaboshi,0,0,0,,Ryuuboshi!
Dialogue: 0,0:13:20.30,0:13:23.41,Main,Hody,0,0,0,,Planıma karışmayın!
Dialogue: 0,0:13:23.41,0:13:26.01,Main,Manboshi,0,0,0,,Abi! Dayan!
Dialogue: 0,0:13:26.34,0:13:31.64,Main,Hody,0,0,0,,Eğer Decken'in gücü çalışmayı burada durdurmazsa, o zaman onu öldürmenin anlamı neydi?
Dialogue: 0,0:13:32.90,0:13:33.58,Main,Luffy,0,0,0,,Anladım!
Dialogue: 0,0:13:34.52,0:13:39.25,Main,Luffy,0,0,0,,Eğer burada durursak, gemi Balık Adam Adası \Nve oradaki herkesin üstüne düşecek!
Dialogue: 0,0:13:39.76,0:13:44.22,Main,Luffy,0,0,0,,Zayıf-hoshi onu uzağa çekmek için o kadar uğraştıktan sonra hem de!
Dialogue: 0,0:13:44.22,0:13:47.18,Main,Luffy,0,0,0,,Abi-hoshi! Zayıf-hoshi'nin yanına gidelim!
Dialogue: 0,0:13:47.18,0:13:48.41,Main,Fukaboshi,0,0,0,,Evet!
Dialogue: 0,0:13:49.54,0:13:52.06,Main,Fukaboshi,0,0,0,,{\i1}Shirahoshi!
Dialogue: 0,0:13:52.47,0:13:53.98,Main,Luffy,0,0,0,,{\i1}Zayıf-hoshi!
Dialogue: 0,0:13:57.78,0:13:59.74,Main,Hody,0,0,0,,Gidemezsiniz!
Dialogue: 0,0:13:59.74,0:14:03.70,Main,Hody,0,0,0,,Balık Adam Adası, halkı ile birlikte ezilecek!
Dialogue: 0,0:14:03.70,0:14:09.92,Main,Hody,0,0,0,,Ve Hasır Şapka, senin arkadaşların da kesinlikle ölecek!
Dialogue: 0,0:14:10.66,0:14:11.95,Main,Manboshi,0,0,0,,İyi misin?!
Dialogue: 0,0:14:13.22,0:14:14.58,Main,Manboshi,0,0,0,,Shirahoshi!
Dialogue: 0,0:14:15.06,0:14:18.20,Main,Manboshi,0,0,0,,{\i1}Kenara doğru yüz!
Dialogue: 0,0:14:18.20,0:14:20.51,Main,Manboshi,0,0,0,,{\i1}Shirahoshi!
Dialogue: 0,0:14:34.99,0:14:35.69,Main,Ryuuboshi,0,0,0,,Shirahoshi!
Dialogue: 0,0:14:37.16,0:14:38.07,Main,Luffy,0,0,0,,Zayıf-hoshi!
Dialogue: 0,0:14:39.75,0:14:40.82,Main,Hody,0,0,0,,Lanet denizkızı!
Dialogue: 0,0:14:41.64,0:14:42.90,Main,Hody,0,0,0,,Ne küstahça!
Dialogue: 0,0:14:43.31,0:14:44.97,Main,Ryuuboshi,0,0,0,,Shirahoshi bizi duydu!
Dialogue: 0,0:14:44.97,0:14:46.45,Main,Manboshi,0,0,0,,Kenara doğru yüzüyor!
Dialogue: 0,0:14:46.45,0:14:48.03,Main,Hody,0,0,0,,Bunu yapmamalıydın!
Dialogue: 0,0:14:50.08,0:14:52.07,Main,Hody,0,0,0,,İzin vermeyeceğim!
Dialogue: 0,0:14:52.07,0:14:53.93,Main,Luffy,0,0,0,,{\i1}Bekle!
Dialogue: 0,0:14:58.86,0:14:59.71,Main,Hody,0,0,0,,Bırak!
Dialogue: 0,0:14:59.71,0:15:02.26,Main,Luffy,0,0,0,,Onun yanına gitmene izin vermeyeceğim!
Dialogue: 0,0:15:03.17,0:15:04.13,Main,Hody,0,0,0,,Lanet olsun...
Dialogue: 0,0:15:08.41,0:15:10.93,Thoughts,Shirahoshi,0,0,0,,Noah! Bu tarafa gel!
Dialogue: 0,0:15:12.93,0:15:14.10,Main,Luffy,0,0,0,,Gücüm...
Dialogue: 0,0:15:14.10,0:15:16.94,Thoughts,Shirahoshi,0,0,0,,Noah! Beni takip et!
Dialogue: 0,0:15:19.97,0:15:20.77,Main,Luffy,0,0,0,,Gidelim!
Dialogue: 0,0:15:20.77,0:15:21.93,Main,Fukaboshi,0,0,0,,Evet!
Dialogue: 0,0:15:21.93,0:15:24.90,Main,Hody,0,0,0,,Lanet Decken! Geber artık!
Dialogue: 0,0:15:28.27,0:15:29.70,Main,Decken,0,0,0,,Kahretsin.
Dialogue: 0,0:15:30.19,0:15:34.54,Main,Decken,0,0,0,,Hody şerefsizi. Bunun bedelini ödeyecek!
Dialogue: 0,0:15:41.65,0:15:44.86,Thoughts,Shirahoshi,0,0,0,,Noah! Ben buradayım!
Dialogue: 0,0:15:46.96,0:15:50.59,Main,Fukaboshi,0,0,0,,Gemi... Kenara doğru gitmeye başladı!
Dialogue: 0,0:15:50.59,0:15:53.23,Main,Luffy,0,0,0,,{\i1}Güzel! Devam et, Zayıf-hoshi!
Dialogue: 0,0:15:53.23,0:15:54.64,Main,Manboshi,0,0,0,,{\i1}Shirahoshi!
Dialogue: 0,0:15:54.64,0:15:55.64,Main,Ryuuboshi,0,0,0,,{\i1}Git!
Dialogue: 0,0:16:00.48,0:16:03.24,Main,Decken,0,0,0,,Sol elimin hedefi...
Dialogue: 0,0:16:03.24,0:16:07.17,Main,Decken,0,0,0,,Hody, sensin!
Dialogue: 0,0:16:07.17,0:16:09.41,Main,Decken,0,0,0,,Hatırla bunu!
Dialogue: 0,0:16:09.41,0:16:12.11,Main,Decken,0,0,0,,Sen ölene kadar...
Dialogue: 0,0:16:12.75,0:16:16.08,Main,Decken,0,0,0,,Bedeninin ve ruhunun, peşinden geleceğim!
Dialogue: 0,0:16:18.41,0:16:19.62,Thoughts,Shirahoshi,0,0,0,,Noah!
Dialogue: 0,0:16:19.62,0:16:22.71,Main,Fukaboshi,0,0,0,,Shirahoshi! Biraz daha!
Dialogue: 0,0:16:22.71,0:16:25.71,Main,Hody,0,0,0,,Fazla uzağa giderse, bunların hepsi anlamsız olur!
Dialogue: 0,0:16:25.71,0:16:30.30,Main,Decken,0,0,0,,Cehennemin dibine kadar!
Dialogue: 0,0:16:54.59,0:16:57.06,Main,Manboshi,0,0,0,,Noah... düşüyor!
Dialogue: 0,0:17:06.03,0:17:07.69,Main,Hody,0,0,0,,Tam zamanında!
Dialogue: 0,0:17:11.47,0:17:12.81,Main,Fukaboshi,0,0,0,,Balık Adam Adası...
Dialogue: 0,0:17:13.75,0:17:15.21,Main,Fukaboshi,0,0,0,,tehlikede!
Dialogue: 0,0:17:16.71,0:17:17.66,Main,Shirahoshi,0,0,0,,Olamaz!
Dialogue: 0,0:17:18.17,0:17:20.83,Main,Hody,0,0,0,,{\i1}Zafer benim!
Dialogue: 0,0:18:01.28,0:18:03.42,Main,Hody,0,0,0,,Sonunda geberdi!
Dialogue: 0,0:18:03.42,0:18:10.63,Main,Hody,0,0,0,,Artık Vander Decken'in gücü yok olacak ve Noah Balık Adam Adası'nın üstüne düşecek!
Dialogue: 0,0:18:10.63,0:18:13.47,Main,Hody,0,0,0,,Geberin! Hasır Şapka Korsanları!
Dialogue: 0,0:18:13.47,0:18:16.62,Main,Hody,0,0,0,,Siz aptallar intikamımın önüne geçtiniz.
Dialogue: 0,0:18:16.62,0:18:18.48,Main,Ryuuboshi,0,0,0,,Balık Adam Adası...
Dialogue: 0,0:18:18.48,0:18:19.70,Main,Manboshi,0,0,0,,...yok olacak.
Dialogue: 0,0:18:23.34,0:18:26.00,Main,Fukaboshi,0,0,0,,Ne olursa olsun, gemiyi durdurmalıyız.
Dialogue: 0,0:18:27.03,0:18:28.75,Main,Hody,0,0,0,,Hasır Şapka!
Dialogue: 0,0:18:29.85,0:18:32.13,Main,Hody,0,0,0,,Noah'yı durdurmak istiyorsun, değil mi?
Dialogue: 0,0:18:32.18,0:18:33.34,Main,Luffy,0,0,0,,Pislik herif.
Dialogue: 0,0:18:33.34,0:18:37.88,Main,Fukaboshi,0,0,0,,Eğer Noah Balık Adam Adası'nın üstüne düşerse, her şey biter.
Dialogue: 0,0:18:37.88,0:18:42.97,Main,Fukaboshi,0,0,0,,Krallığımız da yüzlerce yıldır devam eden Noah'yı koruma görevimiz de.
Dialogue: 0,0:18:43.88,0:18:46.04,Flashbacks,Neptune,0,0,0,,Dinleyin, oğullarım.
Dialogue: 0,0:18:46.04,0:18:51.45,Flashbacks,Neptune,0,0,0,,O gemi, Noah, sadece tarihi bir kalıntı değil-jamon.
Dialogue: 0,0:18:56.61,0:19:02.95,Flashbacks,Neptune,0,0,0,,Uzun zaman önce, yüzlerce yıl öncesinde, çok önemli bir insana söz verdik.
Dialogue: 0,0:19:02.95,0:19:07.90,Flashbacks,Neptune,0,0,0,,O gemi bu sözü yerine getirmek için bunca zamandır deniz tabanında bekiyor.
Dialogue: 0,0:19:07.91,0:19:11.50,Flashbacks,Neptune,0,0,0,,Daha görevini tamamlayamamış bir gemi-jamon.
Dialogue: 0,0:19:11.51,0:19:16.43,Flashbacks,Neptune,0,0,0,,Ve şimdi, gemiyi inşa ederken kullanılan yöntemler bile zaman içinde kayboldu.
Dialogue: 0,0:19:16.43,0:19:20.85,Flashbacks,Neptune,0,0,0,,Söz verilen gün gelene kadar, Noah'ya zarar gelmemeli!
Dialogue: 0,0:19:20.85,0:19:23.12,Flashbacks,Fukaboshi,0,0,0,,Anlaşıldı, Baba.
Dialogue: 0,0:19:23.12,0:19:28.10,Flashbacks,Fukaboshi,0,0,0,,Hareket etmesine sebep olanın ne olduğunu bulacak ve ilgileneceğiz.
Dialogue: 0,0:19:28.89,0:19:32.81,Flashbacks,Fukaboshi,0,0,0,,Krallığı ve Noah'yı, ne olursa olsun kurtarmalıyız!
Dialogue: 0,0:19:33.41,0:19:37.79,Main,Hody,0,0,0,,Herkesi koruyacağını söylemen sadece blöf müydü, Hasır Şapka?!
Dialogue: 0,0:19:37.79,0:19:39.13,Main,Luffy,0,0,0,,Durduracağım!
Dialogue: 0,0:19:39.13,0:19:42.97,Main,Luffy,0,0,0,,Adaya ulaşmadan önce o gemiyi paramparça edeceğim!
Dialogue: 0,0:19:43.23,0:19:44.95,Main,Fukaboshi,0,0,0,,Dur, Hasır Şapka!
Dialogue: 0,0:19:44.95,0:19:51.88,Main,Fukaboshi,0,0,0,,Bunu yapabilsen bile, Noah'nın bizim geçmişimizi ve geleceğimizi bir arada tutan gemi olduğunu söyledim.
Dialogue: 0,0:19:51.89,0:19:55.70,Main,Luffy,0,0,0,,O zaman adayı kurtarabilmemizin başka bir yolu var mı ki?
Dialogue: 0,0:19:55.70,0:19:57.13,Main,Luffy,0,0,0,,Düşünecek zaman yok.
Dialogue: 0,0:19:57.13,0:19:58.95,Main,Luffy,0,0,0,,Aklıma bundan başka bir şey gelmiyor.
Dialogue: 0,0:19:58.95,0:20:02.09,Main,Fukaboshi,0,0,0,,Decken hala hayatta olabilir.
Dialogue: 0,0:20:02.09,0:20:07.04,Main,Fukaboshi,0,0,0,,Eğer bilincini yerine getirirsek, geminin yönünü değiştirmesi için onu kullanabiliriz!
Dialogue: 0,0:20:07.04,0:20:10.44,Main,Luffy,0,0,0,,Böyle diyorsun ama ölüyse ne yapacağız?
Dialogue: 0,0:20:10.44,0:20:11.92,Main,Luffy,0,0,0,,Acele edip gemiyi yok etmezsek{\fscx250}-{\r}
Dialogue: 0,0:20:11.92,0:20:14.55,Main,Fukaboshi,0,0,0,,Sana dur diyorum, anlamıyor musun?!
Dialogue: 0,0:20:14.55,0:20:16.56,Main,Hody,0,0,0,,İç çatışma ha?
Dialogue: 0,0:20:16.56,0:20:19.36,Main,Hody,0,0,0,,İkiniz, tartıştığınız sırada olana bakın.
Dialogue: 0,0:20:19.36,0:20:21.76,Main,Hody,0,0,0,,Noah Balık Adam Adası'na düşüyor.
Dialogue: 0,0:20:25.81,0:20:27.79,Main,Shirahoshi,0,0,0,,Lütfen dur, Noah!
Dialogue: 0,0:20:27.79,0:20:30.28,Main,Shirahoshi,0,0,0,,Adada benim için önemli bir sürü kişi var!
Dialogue: 0,0:20:31.31,0:20:33.09,Main,Shirahoshi,0,0,0,,Decken-sama!
Dialogue: 0,0:20:33.09,0:20:37.07,Main,Shirahoshi,0,0,0,,Eğer hayattaysanız, \No zaman lütfen gemiyi bana doğrultun!
Dialogue: 0,0:20:37.07,0:20:40.16,Main,Shirahoshi,0,0,0,,Balık Adam Adası'ndaki herkesin canını bağışlayın!
Dialogue: 0,0:20:44.28,0:20:45.58,Main,Manboshi,0,0,0,,Shirahoshi!
Dialogue: 0,0:20:45.97,0:20:47.34,Attack,Hody,0,0,0,,{\fad(100,100)}Deniz Davulu
Dialogue: 0,0:20:52.70,0:20:54.12,Main,Shirahoshi,0,0,0,,Manboshi abi!
Dialogue: 0,0:20:54.19,0:20:55.39,Main,Fukaboshi,0,0,0,,Manboshi!
Dialogue: 0,0:20:58.26,0:21:00.49,Main,Hody,0,0,0,,Ve şimdi de senin sıran.
Dialogue: 0,0:21:02.13,0:21:03.47,Main,Luffy,0,0,0,,Hody!
Dialogue: 0,0:21:03.47,0:21:05.15,Main,Hody,0,0,0,,Hasır Şapka!
Dialogue: 0,0:21:11.41,0:21:12.83,Main,Shirahoshi,0,0,0,,Luffy-sama?!
Dialogue: 0,0:21:22.49,0:21:23.86,Main,Luffy,0,0,0,,Kahretsin.
Dialogue: 0,0:21:23.94,0:21:26.84,Main,Luffy,0,0,0,,Silahlanma keskin olmayan saldırılara karşı iyi ama
Dialogue: 0,0:21:26.84,0:21:28.78,Main,Luffy,0,0,0,,buna karşı etkisiz.
Dialogue: 0,0:21:28.78,0:21:30.27,Main,Luffy,0,0,0,,Haki'min hala eğitime ihtiyacı var.
Dialogue: 0,0:21:35.97,0:21:38.81,Main,Luffy,0,0,0,,Su altında dövüşecek zaman değil.
Dialogue: 0,0:21:38.81,0:21:41.75,Main,Luffy,0,0,0,,Eğer onu yeneceksem, harekete geçmeliyim.
Dialogue: 0,0:21:49.24,0:21:52.08,Main,Hody,0,0,0,,Bu düşen gemide dövüşmek mi istiyorsun?
Dialogue: 0,0:21:52.97,0:21:55.13,Main,Hody,0,0,0,,O zaman asıl istediğin şey...
Dialogue: 0,0:21:56.40,0:21:58.49,Main,Hody,0,0,0,,güvertedeki hava değil mi?!
Dialogue: 0,0:22:00.83,0:22:04.56,Main,Luffy,0,0,0,,Eğer güverteye ulaşırsam,\NHody'i tek vuruşta indirebilirim!
Dialogue: 0,0:22:06.23,0:22:08.17,Main,Fukaboshi,0,0,0,,Niyeti buydu demek!
Dialogue: 0,0:22:08.17,0:22:11.87,Main,Hody,0,0,0,,Balonlar yeterince büyük bir deliğe dayanamazlar!
Dialogue: 0,0:22:17.26,0:22:20.43,Main,Luffy,0,0,0,,Kahretsin, güvertede hiç hava yok artık!
Dialogue: 0,0:22:31.92,0:22:38.67,Main,Hody,0,0,0,,Böyle durumlarda çaresiz kalan insanların, \Nbalık adamlardan aşağıda olduklarını anlamışsındır artık!
Dialogue: 0,0:22:39.08,0:22:41.09,Main,Hody,0,0,0,,Noah'yı durdurmayı bırak,
Dialogue: 0,0:22:41.09,0:22:43.51,Main,Hody,0,0,0,,beni bile yenemezsin!
Dialogue: 0,0:22:43.51,0:22:45.67,Main,Hody,0,0,0,,Geber, Hasır Şapka!
Dialogue: 0,0:22:47.50,0:22:48.62,Main,Luffy,0,0,0,,Ne oldu?
Dialogue: 0,0:22:48.62,0:22:49.92,Main,Shirahoshi,0,0,0,,Luffy-sama.
Dialogue: 0,0:22:49.92,0:22:51.60,Main,Shirahoshi,0,0,0,,Çok üzgünüm.
Dialogue: 0,0:22:51.60,0:22:52.72,Main,Luffy,0,0,0,,Zayıf-hoshi?
Dialogue: 0,0:22:53.76,0:22:57.04,Main,Shirahoshi,0,0,0,,Fukaboshi abi bunu yapmamı söyledi.
Dialogue: 0,0:22:57.60,0:22:58.94,Main,Luffy,0,0,0,,Abi-hoshi.
Dialogue: 0,0:22:58.94,0:23:00.25,Main,Fukaboshi,0,0,0,,Hody!
Dialogue: 0,0:23:00.25,0:23:02.36,Main,Fukaboshi,0,0,0,,Ne yapmaya çalışıyorsun sen?!
Dialogue: 0,0:23:02.36,0:23:05.46,Main,Fukaboshi,0,0,0,,O adada kaç hayat var sanıyorsun?!
Dialogue: 0,0:23:07.07,0:23:08.22,Main,Luffy,0,0,0,,Abi-hoshi.
Dialogue: 0,0:23:08.22,0:23:10.04,Main,Shirahoshi,0,0,0,,Fukaboshi abi.
Dialogue: 0,0:23:10.42,0:23:12.96,Main,Fukaboshi,0,0,0,,Sadece sahte gücün olsa bile,
Dialogue: 0,0:23:12.96,0:23:16.97,Main,Fukaboshi,0,0,0,,Senin karşında duramamam hala deneyimsiz olduğumu gösteriyor, bunu kabul ediyorum.
Dialogue: 0,0:23:16.97,0:23:20.14,Main,Fukaboshi,0,0,0,,Ama hala umut var!
Dialogue: 0,0:23:31.77,0:23:33.98,Main,Fukaboshi,0,0,0,,Neden Hody?!
Dialogue: 0,0:23:33.98,0:23:38.19,Main,Fukaboshi,0,0,0,,Neden bu kadar fazla soydaşımızı öldürmeye çalışıyorsun?
Dialogue: 0,0:23:38.19,0:23:41.10,Main,Fukaboshi,0,0,0,,Neyi amaçlıyorsun?!
Dialogue: 0,0:23:43.18,0:23:47.69,Main,Fukaboshi,0,0,0,,Nasıl bu kadar canice bir şey yapabiliyorsun, Hody?!{lit. cruel}
Dialogue: 0,0:23:50.19,0:23:51.20,Main,Hody,0,0,0,,Geber!
Dialogue: 0,0:23:55.41,0:23:58.98,Main,Shirahoshi,0,0,0,,Fukaboshi abi!
Dialogue: 0,0:24:05.21,0:24:09.05,Main,Fukaboshi,0,0,0,,Öyle sahte bir güçle beni yenemezsin!
Dialogue: 0,0:24:10.17,0:24:12.48,Main,Hody,0,0,0,,Hayatta kalabildin demek!
Dialogue: 0,0:24:12.95,0:24:16.17,Main,Fukaboshi,0,0,0,,Hody, sen ne yapmaya çalışıyorsun?!
Dialogue: 0,0:24:16.76,0:24:21.86,Main,Fukaboshi,0,0,0,,İnsanlardan intikam almak istediğini söylüyorsun\Nama balık adamlara saldırıyorsun.
Dialogue: 0,0:24:21.86,0:24:27.57,Main,Fukaboshi,0,0,0,,Balık Adam Adası'nda kaç tane balık adam soydaşını öldüreceğini bilmiyor musun?!
Dialogue: 0,0:24:28.50,0:24:32.01,Main,Fukaboshi,0,0,0,,Balık Adam Bölgesi'nden çocukluk arkadaşlarını bile öldüreceksin.
Dialogue: 0,0:24:32.90,0:24:37.97,Main,Fukaboshi,0,0,0,,Ne yaptığının farkında mısın sen?!
Dialogue: 0,0:24:44.27,0:24:51.02,Main,Fukaboshi,0,0,0,,Yoksa insanlardan o kadar nefret ediyorsun ki öfkeden kör mü oldun?
Dialogue: 0,0:24:51.46,0:24:54.74,Main,Fukaboshi,0,0,0,,Sana ne olmuş olabilir?
Dialogue: 0,0:24:54.74,0:24:58.25,Main,Fukaboshi,0,0,0,,İnsanlar tarafından şiddete mi uğradın?
Dialogue: 0,0:24:58.25,0:25:03.69,Main,Fukaboshi,0,0,0,,Sevdiğin biri veya değerli bir arkadaşın, insanlar tarafından mı öldürüldü?
Dialogue: 0,0:25:03.69,0:25:07.94,Main,Fukaboshi,0,0,0,,Bunu yapmanı sağlayacak ne olmuş olabilir?
Dialogue: 0,0:25:07.94,0:25:09.69,Main,Fukaboshi,0,0,0,,Cevap ver, Hody!
Dialogue: 0,0:25:09.69,0:25:13.38,Main,Fukaboshi,0,0,0,,İnsanlar sana ne yaptı?!
Dialogue: 0,0:25:47.00,0:25:49.94,Main,Shirahoshi,0,0,0,,Fukaboshi abi!
Dialogue: 0,0:25:51.58,0:25:52.70,Main,Luffy,0,0,0,,Zayıf-hoshi...
Dialogue: 0,0:25:57.99,0:25:59.56,Main,Soldier,0,0,0,,Hasır Şapka Luffy-san.
Dialogue: 0,0:25:59.56,0:26:00.83,Main,Soldier,0,0,0,,Burası Hava Tankı.
Dialogue: 0,0:26:00.83,0:26:02.32,Main,Soldier,0,0,0,,Önceden tanışmıştık.
Dialogue: 0,0:26:02.54,0:26:05.71,Main,Soldier,0,0,0,,Bu berbat durum hakkında her şeyi duyduk.
Dialogue: 0,0:26:05.71,0:26:09.21,Main,Soldier,0,0,0,,Sensörlerimiz düşen Noah'yı tespit etti.
Dialogue: 0,0:26:09.21,0:26:12.08,Main,Soldier,0,0,0,,Hazırlıklar plana göre işliyor.
Dialogue: 0,0:26:12.30,0:26:14.84,Main,Luffy,0,0,0,,Abi-hoshi'nin önceden bahsettiği buydu demek ki.
Dialogue: 0,0:26:14.84,0:26:17.34,Flashbacks,Hody,0,0,0,,Güvertede ne var?\NÖnden gideceğim. {First part from ep 559, 21:04.86, second half was not in previous ep}
Dialogue: 0,0:26:17.34,0:26:18.64,Flashbacks,Fukaboshi,0,0,0,,Hody!{idnetical line}
Dialogue: 0,0:26:19.13,0:26:20.77,Flashbacks,Luffy,0,0,0,,Onun peşinden git!{Abbreviated line from 559}
Dialogue: 0,0:26:20.77,0:26:23.08,Flashbacks,Fukaboshi,0,0,0,,Hayır. Bekle, Hasır Şapka.{identical line}
Dialogue: 0,0:26:23.08,0:26:25.38,Flashbacks,Luffy,0,0,0,,Neden beklemek zorundayız?!{Different line from 559, but means almost the same thing}
Dialogue: 0,0:26:25.38,0:26:28.22,Flashbacks,Fukaboshi,0,0,0,,Şimdiye anlamış olman gerek.{Identical line}
Dialogue: 0,0:26:28.22,0:26:33.14,Flashbacks,Fukaboshi,0,0,0,,Suda dövüşmek Hody gibi bir balık adamın oldukça lehine olur.{Identical line}
Dialogue: 0,0:26:33.14,0:26:34.26,Flashbacks,Fukaboshi,0,0,0,,Böyle giderse...{identical line}
Dialogue: 0,0:26:34.26,0:26:36.16,Flashbacks,Luffy,0,0,0,,O zaman ne yapacağız?!{identical line}
Dialogue: 0,0:26:36.16,0:26:37.43,Flashbacks,Fukaboshi,0,0,0,,Bir planım var.{identical line, and last from previous episode}
Dialogue: 0,0:26:39.24,0:26:42.16,Flashbacks,Luffy,0,0,0,,Hey! Nereye gidiyorsun, Abi-hoshi!{New dialogue starts with this line}
Dialogue: 0,0:26:45.55,0:26:47.12,Flashbacks,Soldier,0,0,0,,Prens Fukaboshi.
Dialogue: 0,0:26:47.12,0:26:48.91,Flashbacks,Soldier,0,0,0,,Ne oldu, Prens?
Dialogue: 0,0:26:48.91,0:26:54.87,Flashbacks,Fukaboshi,0,0,0,,Yakında büyük miktarda havaya ihtiyacımız olabilir.\NHemen hazırlayın.
Dialogue: 0,0:26:54.87,0:26:55.68,Flashbacks,Soldiers,0,0,0,,Emredersiniz!
Dialogue: 0,0:26:56.25,0:27:00.12,Flashbacks,Luffy,0,0,0,,Sorun yok. Güvertede hava var değil mi?
Dialogue: 0,0:27:00.12,0:27:02.10,Flashbacks,Luffy,0,0,0,,Onu orada yenerim!
Dialogue: 0,0:27:02.10,0:27:09.33,Flashbacks,Fukaboshi,0,0,0,,Decken'i bir kenara bırak, Hody'nin öylece senin kurallarına göre dövüşeceğini düşünüyor musun?
Dialogue: 0,0:27:09.33,0:27:14.32,Flashbacks,Fukaboshi,0,0,0,,Acil durumlar için bu Bebek Den Den Mushi'yi al.
Dialogue: 0,0:27:14.32,0:27:17.23,Flashbacks,Fukaboshi,0,0,0,,Planı uygularken dikkatli ol. Gidiyoruz!
Dialogue: 0,0:27:20.29,0:27:23.42,Main,Shirahoshi,0,0,0,,Luffy-sama, Noah'yı ne yapacağız?
Dialogue: 0,0:27:23.57,0:27:25.51,Main,Luffy,0,0,0,,Hey! Alo?
Dialogue: 0,0:27:25.51,0:27:27.00,Main,Luffy,0,0,0,,Havayı bize nasıl vereceksin?
Dialogue: 0,0:27:27.14,0:27:30.65,Main,Soldier,0,0,0,,Hava Tankı'ndaki tüm havayı kullanacağız.
Dialogue: 0,0:27:30.65,0:27:33.11,Main,Luffy,0,0,0,,Hava Tankı mı? O da ne?
Dialogue: 0,0:27:33.11,0:27:36.98,Main,Soldier,0,0,0,,Balık Adam Adası'na hava gönderen, bir hava ulaştırma aleti.
Dialogue: 0,0:27:36.98,0:27:41.72,Main,Soldier,0,0,0,,Hava Tankı'ndaki havayı bir balon oluşturmak için kullanırsak, Noah'yı kaplamak mümkün olabilir.
Dialogue: 0,0:27:42.17,0:27:49.10,Main,Soldier,0,0,0,,Ama balon kaldırma kuvvetini etkisizleştireceği için,\Niçerideki hava Noah'nın yüzmesini engelleyecek.
Dialogue: 0,0:27:49.88,0:27:52.49,Main,Soldier,0,0,0,,Yani, Noah'nın düşüşünü durdurmayacak.
Dialogue: 0,0:27:52.49,0:27:58.27,Main,Soldier,0,0,0,,Ayrıca, balonu Noah'yı kaplayacak kadar büyük yapmak için elimizdeki tüm havayı kullanmamız gerek
Dialogue: 0,0:27:58.27,0:28:01.06,Main,Soldier,0,0,0,,Yani sadece bir kez kullanabiliriz.
Dialogue: 0,0:28:01.06,0:28:05.75,Main,Soldier,0,0,0,,Eğer Noah'nın tam altımızda olduğu doğru zamanı kaçırırsak...
Dialogue: 0,0:28:05.75,0:28:09.08,Main,Soldier,0,0,0,,bir şansımız daha olmayacak.
Dialogue: 0,0:28:09.08,0:28:10.64,Main,Luffy,0,0,0,,Çok bir şey anlamadım ama...
Dialogue: 0,0:28:10.64,0:28:12.06,Main,Luffy,0,0,0,,ya batarız ya çıkarız demek ha?
Dialogue: 0,0:28:13.18,0:28:18.10,Main,Soldier,0,0,0,,Evet. Keşke daha fazlasını yapabilseydik ama\Nyapabileceğimiz tek şey size güvenmek.
Dialogue: 0,0:28:18.10,0:28:20.48,Main,Soldier,0,0,0,,Sizi böyle bir durumda bıraktığımız için çok üzgünüm ama{\fscx250}-{\r}
Dialogue: 0,0:28:20.48,0:28:23.31,Main,Luffy,0,0,0,,Bana zorluktan bahsetme!\NAcele et ve gönder!
Dialogue: 0,0:28:23.31,0:28:25.18,Main,Luffy,0,0,0,,Hava olduğu sürece, bir şekilde hallederim!
Dialogue: 0,0:28:25.18,0:28:26.89,Main,Soldier,0,0,0,,Anlaşıldı.
Dialogue: 0,0:28:26.89,0:28:29.35,Main,Soldier,0,0,0,,Size elimizden geldiği kadar yardım edeceğiz.
Dialogue: 0,0:28:29.35,0:28:32.26,Main,Soldier,0,0,0,,Luffy-san, Balık Adam Adası size emanet!
Dialogue: 0,0:28:32.26,0:28:35.09,Main,Hody,0,0,0,,Hasır Şapka. Shirahoshi.
Dialogue: 0,0:28:35.09,0:28:37.77,Main,Hody,0,0,0,,Noah'nın düşüşüne eşlik ederek neyi başarmayı planlıyorsunuz?
Dialogue: 0,0:28:37.77,0:28:40.72,Main,Hody,0,0,0,,Bu tam da bir insan ve \NDeniz Kızı Prenses'den beklediğim bir aptallık!
Dialogue: 0,0:28:45.23,0:28:46.32,Main,Hody,0,0,0,,Hasır Şapka!
Dialogue: 0,0:28:47.54,0:28:49.33,Main,Luffy,0,0,0,,Seni pislik!
Dialogue: 0,0:29:17.51,0:29:20.12,Main,Luffy,0,0,0,,Ne inatçı herif!
Dialogue: 0,0:29:23.76,0:29:28.80,Main,Hody,0,0,0,,Hey, insan. Pes et, insan.
Dialogue: 0,0:29:28.80,0:29:33.01,Main,Hody,0,0,0,,Sadece size bakmak bile tüylerimi diken diken ediyor.
Dialogue: 0,0:29:33.53,0:29:36.22,Main,Hody,0,0,0,,Hayatımı kısaltsam bile...
Dialogue: 0,0:29:36.22,0:29:38.68,Main,Hody,0,0,0,,Kaç tane masumun canını yaksam bile...
Dialogue: 0,0:29:38.68,0:29:44.53,Main,Hody,0,0,0,,Kesinlikle siz insanlardan intikamımı alacağım.
Dialogue: 0,0:29:44.53,0:29:45.91,Main,Luffy,0,0,0,,Adi herif.
Dialogue: 0,0:29:57.79,0:30:01.08,Main,Soldier,0,0,0,,Iskalayamazsın. Sadece tek bir şansımız var.
Dialogue: 0,0:30:01.08,0:30:03.38,Main,Soldier,0,0,0,,Eğer ıskalarsan, Balık Adam Adası...
Dialogue: 0,0:30:09.02,0:30:12.29,Main,Fukaboshi,0,0,0,,Hey, Hasır Şapka. Beni duyuyor musun?
Dialogue: 0,0:30:12.29,0:30:14.15,Main,Shirahoshi,0,0,0,,Fukaboshi Abi'nin sesi!
Dialogue: 0,0:30:14.15,0:30:16.32,Main,Luffy,0,0,0,,Abi-hoshi, iyi misin?
Dialogue: 0,0:30:20.90,0:30:22.84,Main,Fukaboshi,0,0,0,,Bir şekilde.
Dialogue: 0,0:30:22.84,0:30:25.23,Main,Fukaboshi,0,0,0,,Daha da önemlisi, dikkatli dinle.
Dialogue: 0,0:30:27.73,0:30:30.56,Main,Fukaboshi,0,0,0,,Hody Jones'u...
Dialogue: 0,0:30:34.51,0:30:37.42,Main,Fukaboshi,0,0,0,,artık anlıyorum.
Dialogue: 0,0:00:25.35,0:00:29.31,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪
Dialogue: 0,0:00:29.31,0:00:33.81,We Go lyrics,,0,0,0,,♪ Şafak vakti gelmedi bile ve ben bekleyemiyorum! ♪
Dialogue: 0,0:00:33.81,0:00:37.48,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı, dört... Gidelim! ♪
Dialogue: 0,0:00:38.97,0:00:43.05,We Go lyrics,,0,0,0,,♪ Bayrağımızı dalgalandıralım, macera şafağının doğuşuna. ♪
Dialogue: 0,0:00:44.41,0:00:49.74,We Go lyrics,,0,0,0,,♪ Dalgalar yapalım, bizi uykumuzdan kaldırsınlar. ♪
Dialogue: 0,0:00:49.74,0:00:54.28,We Go lyrics,,0,0,0,,♪ Eğer inanılmaz bir dünyaya gitmek istiyorsan,
Dialogue: 0,0:00:54.28,0:00:58.79,We Go lyrics,,0,0,0,, gerekli olan şey senin dayanıklılığın. ♪
Dialogue: 0,0:00:59.11,0:01:01.73,We Go lyrics,,0,0,0,,♪ Fazla dikkat çekmek, bu bir suç mu? ♪
Dialogue: 0,0:01:01.73,0:01:04.62,We Go lyrics,,0,0,0,,♪ Aranıyor → Kazanan demektir! ♪
Dialogue: 0,0:01:04.62,0:01:10.50,We Go lyrics,,0,0,0,,♪ Özgür olmak bizim tek kuralımız! ♪
Dialogue: 0,0:01:10.50,0:01:15.99,We Go lyrics,,0,0,0,,♪ Endişelerinizi unutun, bırakın rüzgar essin. ♪
Dialogue: 0,0:01:15.99,0:01:18.53,We Go lyrics,,0,0,0,,♪ Ne pahasına olursa olsun, One Piece'i ilk biz bulacağız! ♪
Dialogue: 0,0:01:18.53,0:01:22.66,We Go lyrics,,0,0,0,,♪ Hayal kuran kalplerimiz, çok büyük... ♪
Dialogue: 0,0:01:22.66,0:01:26.93,We Go lyrics,,0,0,0,,♪ Onları uyandırmamak önemli. ♪
Dialogue: 0,0:01:26.93,0:01:29.57,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪
Dialogue: 0,0:01:29.57,0:01:33.54,We Go lyrics,,0,0,0,,♪ Şafak vakti gelmedi bile ve ben bekleyemiyorum! ♪
Dialogue: 0,0:01:33.54,0:01:37.33,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı, dört... Gidelim! ♪
Dialogue: 0,0:01:38.76,0:01:44.72,We Go lyrics,,0,0,0,,♪ Biz... buralara kadar geldik. ♪
Dialogue: 0,0:01:44.72,0:01:47.62,We Go lyrics,,0,0,0,,♪ Gideceğiz... hayallerimizin olduğu yere,
Dialogue: 0,0:01:47.62,0:01:52.70,We Go lyrics,,0,0,0,, ve kimseyi arkada bırakmayacağız. ♪
Dialogue: 0,0:01:52.70,0:01:55.30,We Go lyrics,,0,0,0,,♪ Hep devam edeceğiz, bu bir söz. ♪
Dialogue: 0,0:01:55.30,0:01:59.47,We Go lyrics,,0,0,0,,♪ Hayallerimizin başladığı o günden beri,
Dialogue: 0,0:01:59.47,0:02:03.72,We Go lyrics,,0,0,0,, belirlediğimiz gelecek, değişmedi! ♪
Dialogue: 0,0:02:03.72,0:02:06.24,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪
Dialogue: 0,0:02:06.24,0:02:10.61,We Go lyrics,,0,0,0,,♪ Kalbimdeki güneş, asla batmayacak! ♪
Dialogue: 0,0:02:10.61,0:02:13.38,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... ♪
Dialogue: 0,0:02:14.78,0:02:17.57,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... ♪
Dialogue: 0,0:02:18.75,0:02:24.82,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... dört... Gidelim! ♪
Dialogue: 0,0:02:27.27,0:02:29.74,We Go lyrics,,0,0,0,,♪ Gidelim! ♪
