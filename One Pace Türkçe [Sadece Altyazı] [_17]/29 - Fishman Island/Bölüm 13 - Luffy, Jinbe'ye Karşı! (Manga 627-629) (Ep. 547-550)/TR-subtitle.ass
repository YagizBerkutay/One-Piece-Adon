impress bt,50,&H001D221E,&H000000FF,&H001D221E,&H00000000,0,0,0,0,100,100,0,0,1,0.5,0,2,10,10,10,1Style: We Go lyrics,Duality,40.0,&H0098594E,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2.0,0,8,10,10,16,1Style: Author,Impress BT,20.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.7,0.7,9,10,10,10,1Style: Attack,Duality,32.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.0,1.0,7,12,12,12,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:02.99,0:00:08.38,Main,,0,0,0,,Dünyanın sunabileceği her şeyi elde eden adam, Korsanlar Kralı Gold Roger.Dialogue: 0,0:00:08.38,0:00:13.00,Main,,0,0,0,,Son sözleri dünyanın her yerinden maceracıları denize çekti.Dialogue: 0,0:00:13.00,0:00:14.68,Main,,0,0,0,,"Hazinem mi?"Dialogue: 0,0:00:14.68,0:00:16.22,Main,,0,0,0,,"İstiyorsanız, size vereceğim!"Dialogue: 0,0:00:16.22,0:00:17.42,Main,,0,0,0,,"Arayın ve bulun!"Dialogue: 0,0:00:17.42,0:00:19.87,Main,,0,0,0,,"Bu dünyanın sunabileceği her şeyi orada bıraktım!"Dialogue: 0,0:00:19.87,0:00:22.69,Main,,0,0,0,,Korsanlar hayallerinin peşinden yola çıktılar!Dialogue: 0,0:00:22.69,0:00:25.35,Main,,0,0,0,,Dünya, Büyük Korsan Çağı'na girdi!Dialogue: 0,0:00:25.35,0:00:29.31,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪Dialogue: 0,0:00:29.31,0:00:33.81,We Go lyrics,,0,0,0,,♪ Şafak vakti gelmedi bile ve ben bekleyemiyorum! ♪Dialogue: 0,0:00:33.81,0:00:37.48,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı, dört... Gidelim! ♪Dialogue: 0,0:00:38.97,0:00:43.05,We Go lyrics,,0,0,0,,♪ Bayrağımızı dalgalandıralım, macera şafağının doğuşuna. ♪Dialogue: 0,0:00:44.41,0:00:49.74,We Go lyrics,,0,0,0,,♪ Dalgalar yapalım, bizi uykumuzdan kaldırsınlar. ♪Dialogue: 0,0:00:49.74,0:00:54.28,We Go lyrics,,0,0,0,,♪ Eğer inanılmaz bir dünyaya gitmek istiyorsan,Dialogue: 0,0:00:54.28,0:00:58.79,We Go lyrics,,0,0,0,, gerekli olan şey senin dayanıklılığın. ♪Dialogue: 0,0:00:59.11,0:01:01.73,We Go lyrics,,0,0,0,,♪ Fazla dikkat çekmek, bu bir suç mu? ♪Dialogue: 0,0:01:01.73,0:01:04.62,We Go lyrics,,0,0,0,,♪ Aranıyor → Kazanan demektir! ♪Dialogue: 0,0:01:04.62,0:01:10.50,We Go lyrics,,0,0,0,,♪ Özgür olmak bizim tek kuralımız! ♪Dialogue: 0,0:01:10.50,0:01:15.99,We Go lyrics,,0,0,0,,♪ Endişelerinizi unutun, bırakın rüzgar essin. ♪Dialogue: 0,0:01:15.99,0:01:18.53,We Go lyrics,,0,0,0,,♪ Ne pahasına olursa olsun, One Piece'i ilk biz bulacağız! ♪Dialogue: 0,0:01:18.53,0:01:22.66,We Go lyrics,,0,0,0,,♪ Hayal kuran kalplerimiz, çok büyük... ♪Dialogue: 0,0:01:22.66,0:01:26.93,We Go lyrics,,0,0,0,,♪ Onları uyandırmamak önemli. ♪Dialogue: 0,0:01:26.93,0:01:29.57,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪Dialogue: 0,0:01:29.57,0:01:33.54,We Go lyrics,,0,0,0,,♪ Şafak vakti gelmedi bile ve ben bekleyemiyorum! ♪Dialogue: 0,0:01:33.54,0:01:37.33,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı, dört... Gidelim! ♪Dialogue: 0,0:01:38.76,0:01:44.72,We Go lyrics,,0,0,0,,♪ Biz... buralara kadar geldik. ♪Dialogue: 0,0:01:44.72,0:01:47.62,We Go lyrics,,0,0,0,,♪ Gideceğiz... hayallerimizin olduğu yere,Dialogue: 0,0:01:47.62,0:01:52.70,We Go lyrics,,0,0,0,, ve kimseyi arkada bırakmayacağız. ♪Dialogue: 0,0:01:52.70,0:01:55.30,We Go lyrics,,0,0,0,,♪ Hep devam edeceğiz, bu bir söz. ♪Dialogue: 0,0:01:55.30,0:01:59.47,We Go lyrics,,0,0,0,,♪ Hayallerimizin başladığı o günden beri,Dialogue: 0,0:01:59.47,0:02:03.72,We Go lyrics,,0,0,0,, belirlediğimiz gelecek, değişmedi! ♪Dialogue: 0,0:02:03.72,0:02:06.24,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪Dialogue: 0,0:02:06.24,0:02:10.61,We Go lyrics,,0,0,0,,♪ Kalbimdeki güneş, asla batmayacak! ♪Dialogue: 0,0:02:10.61,0:02:13.38,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... ♪Dialogue: 0,0:02:14.78,0:02:17.57,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... ♪Dialogue: 0,0:02:18.75,0:02:24.82,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... dört... Gidelim! ♪Dialogue: 0,0:02:27.27,0:02:29.74,We Go lyrics,,0,0,0,,♪ Gidelim! ♪Dialogue: 0,0:02:29.81,0:02:38.41,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - SyLaR_54 thx to onepace.netDialogue: 0,0:17:51.10,0:18:01.10,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - SyLaR_54 thx to onepace.netDialogue: 0,0:34:55.70,0:34:58.65,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - SyLaR_54 thx to onepace.netDialogue: 0,0:02:29.81,0:02:38.41,Title,,0,0,0,,Luffy, Jinbe'ye Karşı!Dialogue: 0,0:02:33.69,0:02:35.63,Main,Jinbe,0,0,0,,O olaydan 10 yıl sonra bile...Dialogue: 0,0:02:35.63,0:02:38.91,Main,Jinbe,0,0,0,,...Fukaboshi, Ryuboshi, Manboshi...Dialogue: 0,0:02:38.91,0:02:45.26,Main,Jinbe,0,0,0,,...hatta Kral ve Prenses bile ekran aracılığıyla ülkeye seslendi.Dialogue: 0,0:02:45.26,0:02:49.47,Main,Jinbe,0,0,0,,Büyük çaba sarfederek çok miktarda imza topladılar.Dialogue: 0,0:02:50.38,0:02:55.27,Main,Jinbe,0,0,0,,16 yıl boyunca, adanın uğradığı bu ayrımcılıkla böyle savaşıyoruz.Dialogue: 0,0:02:55.89,0:03:00.27,Main,Jinbe,0,0,0,,Sonra, Balık Adam Korsanları meydana geldi.Dialogue: 0,0:03:02.67,0:03:11.09,Main,Jinbe,0,0,0,,Köyünü zulmü ile inim inim inleten Arlong, kardeşim sayılır.Dialogue: 0,0:03:14.99,0:03:21.18,Main,Jinbe,0,0,0,,Nerede bir sorun çıkarırsa çıkarsın onu her an durduracaktık ama...Dialogue: 0,0:03:21.18,0:03:28.88,Main,Jinbe,0,0,0,,...Arlong, yakınındaki Denizcilere rüşvet verdi.  Bunun sonucunda, siz ve köylüler çok acı çektiniz.Dialogue: 0,0:03:29.48,0:03:30.39,Main,Sanji,0,0,0,,Öyleyse, harakiri yap.Dialogue: 0,0:03:31.32,0:03:32.32,Main,Chopper,0,0,0,,Sanji...Dialogue: 0,0:03:32.32,0:03:34.07,Main,Sanji,0,0,0,,Bir özür olarak ölebilir.Dialogue: 0,0:03:34.07,0:03:38.90,Main,Sanji,0,0,0,,Affedileceğini sanma ama. Yine de, Nami-san'ın acısını azaltacak.Dialogue: 0,0:03:38.90,0:03:40.66,Main,Nami,0,0,0,,Kes şunu, Sanji-kun.Dialogue: 0,0:03:41.54,0:03:45.55,Main,Sanji,0,0,0,,Ama Nami-san!  Onların sana yaptıklarını düşü-Dialogue: 0,0:03:45.55,0:03:47.57,Main,Nami,0,0,0,,O başka mesele.Dialogue: 0,0:03:47.57,0:03:51.08,Main,Nami,0,0,0,,Dinledikten sonra onun bir suçu olmadığını öğrendim.Dialogue: 0,0:03:51.56,0:03:55.34,Main,Jinbe,0,0,0,,Sizden gelecek herhangi bir cezayı kabul edeceğim. Sizi rahatlatacaksa elbet-Dialogue: 0,0:03:55.34,0:03:55.93,Main,Nami,0,0,0,,Yeter.Dialogue: 0,0:03:57.29,0:04:00.40,Main,Nami,0,0,0,,Yeter. Ben, Arlong'dan nefret ediyorum.Dialogue: 0,0:04:06.72,0:04:11.14,Main,Nami,0,0,0,,Arlong'un iplerini elinde tutanın sen olmadığına sevindim.Dialogue: 0,0:04:11.65,0:04:14.45,Main,Nami,0,0,0,,Hem, Luffy'nin arkadaşısın, değil mi?Dialogue: 0,0:04:15.54,0:04:19.57,Main,Nami,0,0,0,,Arlong tayfasından zulüm gördüğümüz doğru.Dialogue: 0,0:04:20.13,0:04:24.92,Main,Nami,0,0,0,,Ama bu zulüm sayesinde bugünkü arkadaşlarımla tanıştım.Dialogue: 0,0:04:25.64,0:04:28.38,Main,Nami,0,0,0,,Hepimiz birbirimize bağlıyız.Dialogue: 0,0:04:30.18,0:04:33.68,Main,Nami,0,0,0,,Balık adamlara karşı herhangi bir kin gütmüyorum.Dialogue: 0,0:04:34.67,0:04:39.06,Main,Nami,0,0,0,,Bu yüzden,  hayatımdan durduk yere özür dileme.Dialogue: 0,0:04:40.70,0:04:44.78,Main,Nami,0,0,0,,Endişelenmeye bile değmez. Keyfimize bakalım.Dialogue: 0,0:04:48.53,0:04:51.75,Flashbacks,Otohime,0,0,0,,Suçlu kim olursa olsun...Dialogue: 0,0:04:52.62,0:04:56.11,Flashbacks,Otohime,0,0,0,,...benim için kızmayın lütfen.Dialogue: 0,0:04:58.00,0:05:01.05,Flashbacks,Tiger,0,0,0,,Adadakilere hiçbir şey söylemeyin.Dialogue: 0,0:05:01.05,0:05:05.65,Flashbacks,Tiger,0,0,0,,Yaşadığımız acıları. İnsanlara olan kızgınlığımızı!Dialogue: 0,0:05:07.02,0:05:09.65,Flashbacks,Aladdin,0,0,0,,Fazla düşünme, Jinbe.Dialogue: 0,0:05:09.65,0:05:13.45,Flashbacks,Aladdin,0,0,0,,Balık Adam Bölgesi'nde birer kardeş gibi büyüdünüz.Dialogue: 0,0:05:13.45,0:05:17.49,Flashbacks,Aladdin,0,0,0,,Elinde olmana rağmen onu öldürememen normal.Dialogue: 0,0:05:24.80,0:05:28.24,Main,Jinbe,0,0,0,,Bu sözlerini haketmiyorum.Dialogue: 0,0:05:30.53,0:05:32.74,Main,Jinbe,0,0,0,,Sana minnettarım!Dialogue: 0,0:05:36.77,0:05:39.62,Main,Hachi,0,0,0,,Nyuu- Nami!Dialogue: 0,0:05:45.20,0:05:47.76,Main,Shirahoshi,0,0,0,,Patron Jinbe.Dialogue: 0,0:05:48.92,0:05:52.16,Main,Franky,0,0,0,,Bir abi olmanın verdiği yükü anlıyorum.Dialogue: 0,0:05:52.16,0:05:54.18,Main,Franky,0,0,0,,Adamsın be, Jinbe!Dialogue: 0,0:05:56.30,0:06:01.56,Main,Franky,0,0,0,,Tiger da! Otohime de! Hepinizi seviyorum!Dialogue: 0,0:06:01.56,0:06:02.69,Main,Sanji,0,0,0,,Kapa çeneni, Franky! Aptal!Dialogue: 0,0:06:04.85,0:06:07.57,Thoughts,Nami,0,0,0,,Çok acı çekmiş olmalı.Dialogue: 0,0:06:20.53,0:06:22.11,Main,Crew,0,0,0,,Ne?!!Dialogue: 0,0:06:23.48,0:06:24.92,Main,Sanji,0,0,0,,Uyumasana lan!Dialogue: 0,0:06:29.28,0:06:30.79,Main,Luffy,0,0,0,,İyi uyumuşum.Dialogue: 0,0:06:32.33,0:06:34.45,Main,Luffy,0,0,0,,Neyse Jinbe,...Dialogue: 0,0:06:34.45,0:06:37.35,Main,Luffy,0,0,0,,...pısırığın annesi o hırsızları yakaladıktan sonra ne oldu?Dialogue: 0,0:06:37.35,0:06:40.82,Main,Sanji,0,0,0,,Onca zamandır uyuyor muydun?! Hikâyenin başıydı o!Dialogue: 0,0:06:40.82,0:06:41.86,Main,Luffy,0,0,0,,Öyle mi?Dialogue: 0,0:06:41.86,0:06:43.07,Main,Sanji,0,0,0,,Öyle.Dialogue: 0,0:06:43.07,0:06:46.90,Main,Nami,0,0,0,,Hey, sen Shirahoshi'sin, değil mi?Dialogue: 0,0:06:46.90,0:06:51.04,Main,Caimie,0,0,0,,Nami-chin! Prenses o! "Sen" dememelisin!Dialogue: 0,0:06:51.04,0:06:52.61,Main,Shirahoshi,0,0,0,,Evet.Dialogue: 0,0:06:52.61,0:06:57.63,Main,Shirahoshi,0,0,0,,Özür dilerim. Annemin anıları beni ağlattı.Dialogue: 0,0:06:58.41,0:07:00.43,Main,Nami,0,0,0,,Annen harika bir insanmış.Dialogue: 0,0:07:02.37,0:07:03.31,Main,Shirahoshi,0,0,0,,Evet.Dialogue: 0,0:07:04.78,0:07:07.01,Main,Shirahoshi,0,0,0,,Namichin-sama'sınız, değil mi?Dialogue: 0,0:07:07.57,0:07:11.16,Main,Caimie,0,0,0,,Deniz Kızı Prensesi'm!  Nasıl desem, "chin" lâkap gibi bir şey.Dialogue: 0,0:07:11.16,0:07:13.23,Main,Caimie,0,0,0,,Gerçek adı "chin"siz.Dialogue: 0,0:07:13.23,0:07:19.82,Main,Shirahoshi,0,0,0,,Birbirimizi ilk kez görmemize rağmen kendimi sizinle çocukluk arkadaşıymışız gibi hissediyorum.Dialogue: 0,0:07:19.82,0:07:21.70,Main,Shirahoshi,0,0,0,,Memnun oldum.Dialogue: 0,0:07:22.20,0:07:26.62,Main,Nami,0,0,0,,Öyle mi? Yaşadıklarımız birbirine benziyor.Dialogue: 0,0:07:30.78,0:07:33.21,Main,Jinbe,0,0,0,,Özür dilerim öyleyse.Dialogue: 0,0:07:34.25,0:07:39.43,Main,Jinbe,0,0,0,,Zamanınızı çaldım. Öncelikle,  Ryugu Sarayı'nda olanları gözden geçirmeliyiz.Dialogue: 0,0:07:39.90,0:07:46.00,Main,Jinbe,0,0,0,,Hody ve tayfası saldırdı. Kral ve askerleri yakalandı.Dialogue: 0,0:07:46.00,0:07:50.35,Main,Jinbe,0,0,0,,Dört arkadaşınızın yeri bilinmiyor.Dialogue: 0,0:07:50.35,0:07:53.18,Main,Jinbe,0,0,0,,Şu an, elimizdeki bilgiler bunlar.Dialogue: 0,0:07:53.18,0:07:55.23,Main,Hachi,0,0,0,,Nyuu- Jinbe-san.Dialogue: 0,0:07:55.23,0:08:01.99,Main,Hachi,0,0,0,,Hody'nin planı tuttuysa şu sıralar,  tüm ülke korkunç bir durumda olmalı.Dialogue: 0,0:08:03.35,0:08:06.84,Main,Jinbe,0,0,0,,Hody'nin planını biliyor musun?Dialogue: 0,0:08:06.84,0:08:09.64,Main,Jinbe,0,0,0,,O adam, ordudan ayrıldıktan sonra...Dialogue: 0,0:08:09.65,0:08:13.12,Main,Jinbe,0,0,0,,...Balık Adam Bölgesi'nde bir şeyler çevirdiğine dair şüpheleniyordum ama...Dialogue: 0,0:08:13.22,0:08:17.30,Main,Jinbe,0,0,0,,...karşımda hiç açık vermiyordu.Dialogue: 0,0:08:17.30,0:08:19.52,Main,Hachi,0,0,0,,Evet, biliyorum.Dialogue: 0,0:08:20.20,0:08:24.98,Main,Hachi,0,0,0,,Hody, Arlong-san'a göre insanlardan daha çok nefret ediyor.Dialogue: 0,0:08:24.98,0:08:32.19,Main,Hachi,0,0,0,,İçine ektiği nefret ve kızgınlık tohumları onun yaşamasını sağlayan her şey.Dialogue: 0,0:08:32.19,0:08:37.87,Main,Hachi,0,0,0,,Ancak, Arlong-san'dan büyük bir farkı var.Dialogue: 0,0:08:37.87,0:08:44.83,Main,Hachi,0,0,0,,Arlong-san insanlardan nefret ederdi ama diğer balık adamlara zarar vermezdi.Dialogue: 0,0:08:44.83,0:08:47.58,Main,Hachi,0,0,0,,Hody ise...Dialogue: 0,0:08:47.58,0:08:55.27,Main,Hachi,0,0,0,,...insanlara sempati duyan  balık adamlara bile acımasızca saldırır.Dialogue: 0,0:08:55.27,0:09:00.85,Main,Hachi,0,0,0,,Dünya Konseyi Toplantısı sadece dört yılda bir yapılıyor ve bu yıl gerçekleşecek, değil mi?Dialogue: 0,0:09:00.85,0:09:03.89,Main,Hachi,0,0,0,,Birçok imza toplandı.Dialogue: 0,0:09:03.89,0:09:11.91,Main,Hachi,0,0,0,,Sonunda, Kral Neptune tüm  Balık Adam Adası'nın yüzeye göç isteğini duyuracak.Dialogue: 0,0:09:12.94,0:09:14.24,Main,Jinbe,0,0,0,,Olamaz...Dialogue: 0,0:09:14.24,0:09:17.11,Main,Jinbe,0,0,0,,Bunu engellemeye çalışıyor!Dialogue: 0,0:09:17.11,0:09:21.04,Main,Hachi,0,0,0,,Hayır, bunu engellemekle kalmayacak.Dialogue: 0,0:09:28.17,0:09:30.13,Main,Chopper,0,0,0,,O da ne?Dialogue: 0,0:09:32.18,0:09:34.92,Main,Chopper,0,0,0,,Kocaman bir Den Den Mushi!Dialogue: 0,0:09:35.46,0:09:36.47,Main,Den,0,0,0,,O ne öyle?Dialogue: 0,0:09:37.33,0:09:39.00,Main,Den,0,0,0,,Görüntülü Den Den Mushi mi?Dialogue: 0,0:09:39.00,0:09:40.65,Main,Den,0,0,0,,Böyle bir yerde ne işi var?Dialogue: 0,0:09:43.07,0:09:46.34,Main,Den,0,0,0,,Bakın! Ekran çıktı!Dialogue: 0,0:09:46.34,0:09:49.03,Main,Caimie,0,0,0,,Baloncuğun içinden bir şey...Dialogue: 0,0:09:51.91,0:09:53.03,Main,Jinbe,0,0,0,,Bu...Dialogue: 0,0:09:56.15,0:09:57.40,Main,Nami,0,0,0,,O herif...Dialogue: 0,0:09:57.40,0:10:00.70,Main,Sanji,0,0,0,,Nami-san, tanıyor musun?Dialogue: 0,0:10:00.70,0:10:03.54,Main,Hachi,0,0,0,,Nyuu- Hody...Dialogue: 0,0:10:03.54,0:10:05.88,Main,Chopper,0,0,0,,O muymuş?Dialogue: 0,0:10:05.88,0:10:06.61,Main,Caimie,0,0,0,,Hacchin!Dialogue: 0,0:10:08.96,0:10:12.04,Main,Hody,0,0,0,,Ey balık adam ahalisi.Dialogue: 0,0:10:12.04,0:10:14.08,Main,Hody,0,0,0,,Duyuyor musunuz?Dialogue: 0,0:10:14.72,0:10:20.68,Main,Hody,0,0,0,,Ben, Balık Adam Bölgesi'nden, Yeni Balık Adam Korsanları kaptanı...Dialogue: 0,0:10:20.68,0:10:23.95,Main,Hody,0,0,0,,...Hody Jones.Dialogue: 0,0:10:23.95,0:10:25.23,Main,Pirate,0,0,0,,Sıradaki gelsin!Dialogue: 0,0:10:27.46,0:10:28.49,Main,Pirate,0,0,0,,Sıradaki.Dialogue: 0,0:10:32.24,0:10:33.00,Main,Pirate,0,0,0,,Sıradaki.Dialogue: 0,0:10:39.03,0:10:40.64,Main,Pirate,0,0,0,,Basmayacak mısın?!Dialogue: 0,0:10:44.48,0:10:46.87,Thoughts,Citizen,0,0,0,,Kraliçe Otohime, lütfen affedin.Dialogue: 0,0:10:46.87,0:10:51.78,Thoughts,Citizen,0,0,0,,Basmazsam öldürüleceğim. Başka seçeneğim yok!Dialogue: 0,0:10:51.78,0:10:54.30,Thoughts,Citizen,0,0,0,,Bağışlayın beni, Kraliçe Otohime.Dialogue: 0,0:10:54.30,0:10:56.84,Main,Pirate,0,0,0,,Tamam, geçebilirsin, sıradaki.Dialogue: 0,0:11:00.89,0:11:02.14,Main,Daruma,0,0,0,,Amma sıkıcı oldu.Dialogue: 0,0:11:02.14,0:11:04.10,Main,Daruma,0,0,0,,Milletin böyle çabucak basabilmesine şaşırdım.Dialogue: 0,0:11:04.89,0:11:08.35,Main,Daruma,0,0,0,,Otohime'nin bir saygınlığı olduğunu sanıyordum.Dialogue: 0,0:11:08.35,0:11:13.08,Main,Pirate,0,0,0,,Daruma-san, Kaptan Hody yayına başladı.Dialogue: 0,0:11:13.08,0:11:14.07,Main,Daruma,0,0,0,,Ha?Dialogue: 0,0:11:17.07,0:11:19.21,Main,Fishman,0,0,0,,Liderleri o herif demek.Dialogue: 0,0:11:19.21,0:11:23.02,Main,Fishman,0,0,0,,Bizi fumi-e'ye basmaya zorlayan o mu?Dialogue: 0,0:11:23.02,0:11:29.50,Main,Fishman,0,0,0,,Otohime'yi vuran herifi öldüren adam, değil mi?Dialogue: 0,0:11:29.50,0:11:33.26,Main,Fishman,0,0,0,,Evet, Hody Jones o. Kesinlikle.Dialogue: 0,0:11:33.26,0:11:35.63,Main,Fishwoman,0,0,0,,Neptune Ordusu askeri değil miydi?Dialogue: 0,0:11:35.63,0:11:38.57,Main,Hody,0,0,0,,Balık Adam Adası, Ryugu Krallığı...Dialogue: 0,0:11:38.59,0:11:40.81,Main,Hody,0,0,0,,...halkına bildirmek istediğim bir şey var.Dialogue: 0,0:11:35.90,0:11:39.80,Captions,,0,0,0,,Deniz OrmanıDialogue: 0,0:11:41.01,0:11:44.39,Main,Hody,0,0,0,,Bu ülke yakında yok olacak.Dialogue: 0,0:11:44.39,0:11:48.93,Main,Hody,0,0,0,,Ve sonra yeni bir kralın yönetiminde yeniden kurulacak. O kral...Dialogue: 0,0:11:49.53,0:11:50.70,Main,Hody,0,0,0,,...ben olacağım!Dialogue: 0,0:12:01.62,0:12:03.46,Main,Citizen,0,0,0,,Ne diyor öyle?Dialogue: 0,0:12:01.78,0:12:03.38,Captions,,0,0,0,,Mercan TepesiDialogue: 0,0:12:03.46,0:12:05.67,Main,Citizen,0,0,0,,Amacı nedir? Dalga geçme lan!Dialogue: 0,0:12:05.67,0:12:09.12,Main,Citizen,0,0,0,,Bu adam nereden yayın yapıyor?Dialogue: 0,0:12:09.12,0:12:10.55,Main,Citizen,0,0,0,,Krala ne oldu?Dialogue: 0,0:12:10.96,0:12:15.26,Main,Citizen,0,0,0,,Ryugu Sarayı'nı işgal edenler Hasır Şapka korsan tayfası değil miydi?Dialogue: 0,0:12:15.26,0:12:17.55,Main,Citizen,0,0,0,,Bu ülkeye neler olacak?!Dialogue: 0,0:12:19.25,0:12:24.03,Main,Hody,0,0,0,,Yeni Balık Adam Adası'nı yeni kanunlarla bir düzene sokacağım.Dialogue: 0,0:12:24.32,0:12:30.27,Main,Hody,0,0,0,,Yakında, Balık Adam Bölgesi'nden yeni vatandaşlar buraya göç edecek.Dialogue: 0,0:12:30.27,0:12:33.08,Main,Hody,0,0,0,,İnsanlara olan nefretleriyle.Dialogue: 0,0:12:33.08,0:12:37.93,Main,Hody,0,0,0,,Birlikte, bu adanın değişimini arzulayan dostlarımız!Dialogue: 0,0:12:37.78,0:12:41.68,Captions,,0,0,0,,Çark ŞehriDialogue: 0,0:12:37.97,0:12:39.97,Main,Fishman,0,0,0,,Ne? Göç mü?Dialogue: 0,0:12:39.97,0:12:44.02,Main,Fishman,0,0,0,,Bu kanunsuzlar bizimle yaşamaya mı geliyor?Dialogue: 0,0:12:46.65,0:12:52.11,Main,Hody,0,0,0,,Sevgili Kraliçe Otohime'nizin ölümünü hepiniz gördünüz.Dialogue: 0,0:12:52.91,0:13:00.98,Main,Hody,0,0,0,,Arkama bakıyorum da insanlarla iyi ilişkiler kurmak için çabalayan Kraliçe Otohime'yi...Dialogue: 0,0:13:00.98,0:13:04.59,Main,Hody,0,0,0,,...kim öldürdü?! Bir insan!Dialogue: 0,0:13:04.59,0:13:11.63,Main,Hody,0,0,0,,İnsanlar bir gülücüğe ve anlaşmaya inanır ama er ya da geç yine ihanet eder.Dialogue: 0,0:13:11.74,0:13:14.14,Main,Hody,0,0,0,,Bunu neden anlamıyorsunuz?!Dialogue: 0,0:13:16.66,0:13:17.90,Main,Fukaboshi,0,0,0,,O herif...Dialogue: 0,0:13:17.90,0:13:24.99,Main,Hody,0,0,0,,Neptün Ailesi yüzünden hepiniz ölüme doğru koşuyorsunuz sadece.Dialogue: 0,0:13:24.99,0:13:29.16,Main,Hody,0,0,0,,Onların hayalinin gerçekleşmesi mümkün değil.Dialogue: 0,0:13:29.16,0:13:33.22,Main,Hody,0,0,0,,Sizi daha büyük bir yok oluşa sürükleyecek olan korkunç bir yalan.Dialogue: 0,0:13:33.22,0:13:34.12,Main,Shirahoshi,0,0,0,,Olamaz...Dialogue: 0,0:13:34.20,0:13:35.33,Main,Hody,0,0,0,,Şuna bakın!Dialogue: 0,0:13:38.68,0:13:40.21,Main,Shirahoshi,0,0,0,,Baba!Dialogue: 0,0:13:40.21,0:13:41.25,Main,Manboshi,0,0,0,,Baba!Dialogue: 0,0:13:41.25,0:13:42.67,Main,Ryuuboshi,0,0,0,,Baba!Dialogue: 0,0:13:42.67,0:13:44.30,Main,Caimie,0,0,0,,Kral-sama!Dialogue: 0,0:13:44.79,0:13:48.16,Main,Hody,0,0,0,,Eski Büyük Şovalye Neptune yaşlandı.Dialogue: 0,0:13:49.38,0:13:54.81,Main,Hody,0,0,0,,Yaşlılar tahtı Balık Adam Adası'nın geleceğine emanet etmelidir.Dialogue: 0,0:13:56.81,0:14:02.46,Main,Nami,0,0,0,,Kralın yakalanmasının sebebi biziz mi desem...Dialogue: 0,0:14:03.82,0:14:05.23,Main,Nami,0,0,0,,...Zoro mu desem?Dialogue: 0,0:14:05.23,0:14:07.34,Main,Jimbe,0,0,0,,Neler yaptınız siz?!Dialogue: 0,0:14:07.34,0:14:09.82,Main,Caimie,0,0,0,,Ama, P-P-Patron Jinbe!Dialogue: 0,0:14:09.82,0:14:14.42,Main,Caimie,0,0,0,,Yanlış anladın. Nami-chinler Neptune Ordusu'nun saldırısına uğradı.Dialogue: 0,0:14:14.93,0:14:17.11,Main,Hody,0,0,0,,Eski Ryugu Krallığı'nın...Dialogue: 0,0:14:18.81,0:14:20.66,Main,Hody,0,0,0,,...çöküş zamanı geldi.Dialogue: 0,0:14:21.11,0:14:25.08,Main,Hody,0,0,0,,Üç saat içinde Gyoncorde Meydanı'nda...Dialogue: 0,0:14:25.52,0:14:30.21,Main,Hody,0,0,0,,...bu yetersiz kral idam edilecek.Dialogue: 0,0:14:31.96,0:14:36.39,Main,Hody,0,0,0,,Şimdiye öğrenmişsinizdir. Şu an Ryugu Sarayı'ndayım ve...Dialogue: 0,0:14:36.40,0:14:38.31,Main,Hody,0,0,0,,...iyi bir şey bulduk.Dialogue: 0,0:14:40.06,0:14:45.69,Main,Hody,0,0,0,,10 yıl önce, Kraliçe Otohime canını tehlikeye atarak elde etti.Dialogue: 0,0:14:47.37,0:14:50.03,Main,Hody,0,0,0,,Kutsal Ejderler'in mektubu.Dialogue: 0,0:14:51.83,0:14:55.29,Main,Hody,0,0,0,,Bunu parçalarsam bir daha asla elde edemezsiniz.Dialogue: 0,0:14:56.83,0:15:01.71,Main,Hody,0,0,0,,Ve bu koca kutuda...Dialogue: 0,0:15:03.60,0:15:07.16,Main,Hody,0,0,0,,...bu ülke halkının büyük çoğunluğunun imzası var.Dialogue: 0,0:15:11.48,0:15:14.10,Main,Hody,0,0,0,,Gözlerime inanamadım yahu.Dialogue: 0,0:15:14.10,0:15:18.81,Main,Hody,0,0,0,,İnsanlarla bir arada yaşamak isteyen ne çok aptal varmış!Dialogue: 0,0:15:18.81,0:15:26.65,Main,Hody,0,0,0,,Adları burada yazılı olanlar bu ülkenin yeni kralına, doğrudan bana karşı gelmiştir.Dialogue: 0,0:15:26.65,0:15:31.74,Main,Hody,0,0,0,,Yani, bu bir hainler listesidir.Dialogue: 0,0:15:31.74,0:15:33.58,Main,Hody,0,0,0,,Fumi-e'ye basmayı bırakabilirsiniz.Dialogue: 0,0:15:33.58,0:15:39.21,Main,Hody,0,0,0,,Yalandan, Otohime'nin üstüne basıp da kendinizi temize çıkarabilirsiniz.Dialogue: 0,0:15:39.81,0:15:46.58,Main,Hody,0,0,0,,Asıl bu imzalar kimin dost,  kimin düşman olduğunu gösteren...Dialogue: 0,0:15:46.58,0:15:48.25,Main,Hody,0,0,0,,...çürütülemez kanıtlardır!Dialogue: 0,0:15:51.46,0:15:55.35,Main,Hody,0,0,0,,Hepinizden teker teker kurtulacağız.Dialogue: 0,0:15:55.55,0:15:56.77,Main,Hody,0,0,0,,Son olarak...Dialogue: 0,0:16:03.21,0:16:05.51,Main,Hody,0,0,0,,Korsan Hasır Şapka Tayfası.Dialogue: 0,0:16:06.98,0:16:10.08,Main,Hody,0,0,0,,Size gösterecek ilginç bir şeyim var.Dialogue: 0,0:16:11.58,0:16:14.86,Main,Hody,0,0,0,,Bu adada bir yerlerde izlediğinizi biliyorum.Dialogue: 0,0:16:14.86,0:16:20.22,Main,Hody,0,0,0,,Tüm balık adamların kinini temsil eden Arlong'un tayfası siz insanlar tarafından yok edildi!Dialogue: 0,0:16:20.57,0:16:22.59,Main,Chopper,0,0,0,,Zoro, Usopp, Brook!Dialogue: 0,0:16:23.20,0:16:25.31,Main,Sanji,0,0,0,,N'apıyor bu herifler?Dialogue: 0,0:16:25.31,0:16:26.71,Main,Nami,0,0,0,,Yoksa yakalanmışlar mı?Dialogue: 0,0:16:28.98,0:16:29.98,Main,Hody,0,0,0,,Başlayın!Dialogue: 0,0:16:29.98,0:16:30.79,Main,Pirate,0,0,0,,Emredersiniz!Dialogue: 0,0:16:32.06,0:16:32.77,Main,Pirate,0,0,0,,Başlayın!Dialogue: 0,0:16:39.83,0:16:42.06,Main,Brook,0,0,0,,Ne? N'oluyor ya?! Ne?Dialogue: 0,0:16:49.55,0:16:51.54,Main,Brook,0,0,0,,Çok yüksek!Dialogue: 0,0:16:57.50,0:16:59.06,Main,Brook,0,0,0,,O ses de ne?Dialogue: 0,0:16:59.06,0:16:59.96,Main,Usopp,0,0,0,,Kükreme sesi gibi...Dialogue: 0,0:17:04.12,0:17:06.26,Main,Usopp & Brook,0,0,0,,Suymuş!Dialogue: 0,0:17:08.76,0:17:13.56,Main,Hody,0,0,0,,Kral'ın idamı bittiğinde bu oda suyla dolmuş olacak.Dialogue: 0,0:17:13.56,0:17:18.36,Main,Hody,0,0,0,,Sizin gibi aşağılık yaşam formları bununla ölür, değil mi?Dialogue: 0,0:17:18.81,0:17:22.70,Main,Hody,0,0,0,,400 milyon beli ödüllü Hasır Şapka Luffy.Dialogue: 0,0:17:23.31,0:17:28.66,Main,Hody,0,0,0,,Kelleleriniz yüzeydeki insanlara iyi birer mesaj olacak.Dialogue: 0,0:17:28.66,0:17:33.62,Main,Hody,0,0,0,,Pekâlâ eski Ryugu Krallığı'nın  bahar temizliğine başlayın.Dialogue: 0,0:17:37.92,0:17:43.68,Main,Hody,0,0,0,,Ezik geçmişinizi unutun ve  güçlü bir geleceğe inançla ilerleyin.Dialogue: 0,0:17:43.68,0:17:49.36,Main,Hody,0,0,0,,Üç saat sonra,  Balık Adam Adası'nın gururu yeniden doğacak.Dialogue: 0,0:17:59.67,0:18:00.90,Main,Citizen,0,0,0,,Şu yaptığına bak...Dialogue: 0,0:18:17.36,0:18:20.46,Main,Fukaboshi,0,0,0,,Müsaade etmeyeceğim!Dialogue: 0,0:18:23.32,0:18:26.77,Main,Usopp,0,0,0,,Off ya! Su seviyesi hızla artıyor!Dialogue: 0,0:18:26.77,0:18:32.86,Main,Brook,0,0,0,,Usopp-san, üstüm başım yeni kurudu, bir daha ıslanmak istemiyorum.Dialogue: 0,0:18:32.86,0:18:34.58,Main,Usopp,0,0,0,,Ben de istemiyorum.Dialogue: 0,0:18:35.03,0:18:36.87,Main,Usopp,0,0,0,,Bir şeyler yap, Zoro-kun!Dialogue: 0,0:18:36.87,0:18:39.33,Main,Zoro,0,0,0,,Anladım. Öyleyse...Dialogue: 0,0:18:40.57,0:18:42.00,Main,Zoro,0,0,0,,Şu zincirleri çöz.Dialogue: 0,0:18:42.46,0:18:43.59,Main,Usopp,0,0,0,,Tamamdır!Dialogue: 0,0:18:43.59,0:18:48.84,Main,Usopp,0,0,0,,Başlıyorum. Çık zincir çık. Çözül zincir çözül.Dialogue: 0,0:18:48.84,0:18:52.95,Main,Usopp,0,0,0,,Çözülüyorsun zincir. Çözülüyor... zincir...Dialogue: 0,0:18:52.95,0:18:55.02,Main,Usopp,0,0,0,,...çözülüyor.Dialogue: 0,0:18:55.90,0:18:59.44,Main,Usopp,0,0,0,,İşe yaramıyor.  Doğaüstü güçlerim yok sanırım.Dialogue: 0,0:19:00.76,0:19:02.41,Main,Brook,0,0,0,,Hey, hey. Hareket ettiğimde...Dialogue: 0,0:19:02.41,0:19:06.19,Main,Brook,0,0,0,,...o balık adamların suratını gördünüz mü?Dialogue: 0,0:19:12.09,0:19:13.26,Flashbacks,Brook,0,0,0,,Doğru cevap!Dialogue: 0,0:19:13.68,0:19:15.14,Flashbacks,Pirates,0,0,0,,Hareket ediyor....Dialogue: 0,0:19:15.55,0:19:19.21,Flashbacks,Brook,0,0,0,,Bildiniz. Ben, Ölü Kemik Brook!Dialogue: 0,0:19:19.67,0:19:23.04,Main,Usopp & Zoro,0,0,0,,Şu an yakalanmış olmamızın sorumlusu kim acaba?!Dialogue: 0,0:19:23.04,0:19:25.50,Main,Brook,0,0,0,,İmdat. Öldürüleceğim!Dialogue: 0,0:19:26.05,0:19:28.67,Main,Brook,0,0,0,,Gerçi ölüyüm.Dialogue: 0,0:19:30.47,0:19:33.49,Main,Zoro,0,0,0,,Neyse, en azından Namiler kaçtı.Dialogue: 0,0:19:33.49,0:19:36.38,Main,Zoro,0,0,0,,Luffyler'i buraya getirirler.Dialogue: 0,0:19:36.38,0:19:38.37,Main,Usopp,0,0,0,,Ya gelmezlerse n'apacaksın?!Dialogue: 0,0:19:39.24,0:19:40.33,Main,Usopp,0,0,0,,Robin taklidi.Dialogue: 0,0:19:41.07,0:19:44.85,Main,Usopp,0,0,0,,"Nami... umarım derin deniz balıklarına  yem olmamıştır. "Dialogue: 0,0:19:46.28,0:19:47.89,Main,Brook,0,0,0,,Aynısı!Dialogue: 0,0:20:02.35,0:20:06.66,Main,Robin,0,0,0,,Şimdiye kadar okuduğum ponegliflere göre bu biraz farklı.Dialogue: 0,0:20:07.68,0:20:11.88,Main,Robin,0,0,0,,Bir mektuba benziyor, hatta bir özür gibi.Dialogue: 0,0:20:12.81,0:20:15.67,Main,Robin,0,0,0,,Kimden özür diliyor acaba?Dialogue: 0,0:20:15.67,0:20:19.93,Main,Robin,0,0,0,,Kimsin sen... Joyboy?Dialogue: 0,0:20:32.29,0:20:34.68,Main,Luffy,0,0,0,,Ödülüm 400 milyon muymuş?!Dialogue: 0,0:20:34.68,0:20:37.38,Main,Luffy,0,0,0,,Ne zaman artmış ki?Dialogue: 0,0:20:37.38,0:20:38.93,Main,Nami,0,0,0,,Sırası mı bunun?!Dialogue: 0,0:20:38.94,0:20:40.98,Main,Sanji,0,0,0,,Bize resmen savaş ilan ettiler.Dialogue: 0,0:20:40.98,0:20:46.44,Main,Jinbe,0,0,0,,Marineford'daki  En İyiler Savaşı'nda birden ünlü oldun.Dialogue: 0,0:20:46.44,0:20:49.98,Main,Jinbe,0,0,0,,Bir ödül 300 milyonu aşmışsa o kadar kolay aşmamıştır.Dialogue: 0,0:20:54.89,0:20:57.79,Main,Luffy,0,0,0,,Ama, bize savaş ilan ettiklerine göre dalıyoruz.Dialogue: 0,0:20:58.17,0:20:59.51,Main,Jinbe,0,0,0,,Dur, Luffy-kun.Dialogue: 0,0:21:02.29,0:21:03.51,Main,Shirahoshi,0,0,0,,Babam...Dialogue: 0,0:21:07.93,0:21:09.68,Main,Shirahoshi,0,0,0,,Babam...Dialogue: 0,0:21:09.68,0:21:11.02,Main,Shirahoshi,0,0,0,,Babam!Dialogue: 0,0:21:11.59,0:21:13.10,Main,Shirahoshi,0,0,0,,Babam!Dialogue: 0,0:21:14.52,0:21:15.51,Main,Shirahoshi,0,0,0,,Megalo!Dialogue: 0,0:21:19.60,0:21:21.07,Main,Shirahoshi,0,0,0,,Onu kurtarmalıyız!Dialogue: 0,0:21:21.28,0:21:23.67,Main,Jinbe,0,0,0,,Bekle, Prenses Shirahoshi!Dialogue: 0,0:21:25.07,0:21:26.28,Main,Jinbe,0,0,0,,Dur, Megalo!Dialogue: 0,0:21:27.49,0:21:28.79,Main,Jinbe,0,0,0,,Bekleyin!Dialogue: 0,0:21:29.90,0:21:33.17,Main,Shirahoshi,0,0,0,,Patron Jinbe-sama! Ama...Dialogue: 0,0:21:33.17,0:21:37.34,Main,Shirahoshi,0,0,0,,Luffy-kun ve Prenses-sama, ikiniz de bekleyin.Dialogue: 0,0:21:38.66,0:21:41.72,Main,Hachi,0,0,0,,Prensesim, ben de gitmemenizin  iyi olacağını düşünüyorum.Dialogue: 0,0:21:42.33,0:21:44.02,Main,Shirahoshi,0,0,0,,Hachi-sama.Dialogue: 0,0:21:44.02,0:21:48.68,Main,Hody,0,0,0,,Ryugu Krallığı'nda Hody'nin en çok korktuğu şey...Dialogue: 0,0:21:49.28,0:21:51.98,Main,Hody,0,0,0,,...sizin yeteneğiniz.Dialogue: 0,0:21:54.00,0:21:59.10,Main,Hody,0,0,0,,Balık Adam Adası'nda ideal krallığını kursa bile...Dialogue: 0,0:21:59.10,0:22:04.19,Main,Hody,0,0,0,,...Deniz Krallarını kontrol edenler tarafından her şey yerle bir edilir.Dialogue: 0,0:22:04.19,0:22:09.37,Main,Hody,0,0,0,,Kral bu duruma karşılık bir kalkan.Dialogue: 0,0:22:09.37,0:22:13.79,Main,Sanji,0,0,0,,O heriflerin asıl hedefi Shirahoshi-chan mı yani?Dialogue: 0,0:22:14.11,0:22:20.59,Main,Hachi,0,0,0,,Nyuu- Hody ne prensesi yakalamak ne de gücünü kullanmak istiyor.Dialogue: 0,0:22:20.59,0:22:25.30,Main,Hachi,0,0,0,,O gücün varlığından korkuyor.Dialogue: 0,0:22:25.30,0:22:29.97,Main,Hachi,0,0,0,,Bu yüzden, Prenses'in canını hedef alan Decken'le işbirliği yaptı.Dialogue: 0,0:22:29.97,0:22:33.93,Main,Hachi,0,0,0,,Hody başındaki tüm sorunları çözmek istiyor.Dialogue: 0,0:22:35.13,0:22:36.20,Main,Jinbe,0,0,0,,Doğru.Dialogue: 0,0:22:36.40,0:22:41.82,Main,Jinbe,0,0,0,,Meydana doğru gitmeniz,  Hody'nin kesinlikle işine yarayacaktır.Dialogue: 0,0:22:41.82,0:22:46.48,Main,Shirahoshi,0,0,0,,Gücümün hikâyesini öğrendim ama...Dialogue: 0,0:22:46.48,0:22:51.16,Main,Shirahoshi,0,0,0,,...Deniz Krallarıyla hiç iletişim kurmadım.Dialogue: 0,0:22:51.16,0:22:55.66,Main,Shirahoshi,0,0,0,,Açıkçası, öyle bir güce sahip olup olmadığımı da bilmiyorum.Dialogue: 0,0:22:55.66,0:23:00.74,Main,Jinbe,0,0,0,,Yine de, Hody sizi öldürmek istiyordur.Dialogue: 0,0:23:01.55,0:23:06.35,Main,Jinbe,0,0,0,,Ayrıca bu konuyu Hody kesinlikle öğrenmemeli.Dialogue: 0,0:23:06.35,0:23:09.14,Main,Jinbe,0,0,0,,Korkması işimize gelir.Dialogue: 0,0:23:09.14,0:23:11.07,Main,Luffy,0,0,0,,Konuşmanız bitti mi?Dialogue: 0,0:23:11.07,0:23:13.31,Main,Luffy,0,0,0,,Bu kadar yeter.Dialogue: 0,0:23:13.80,0:23:16.85,Main,Luffy,0,0,0,,Köpek balığı!  Beni, Ryugu Sarayı'na götür.Dialogue: 0,0:23:16.85,0:23:19.63,Main,Luffy,0,0,0,,Sanji, pısırık sana emanet.Dialogue: 0,0:23:19.63,0:23:20.98,Main,Sanji,0,0,0,,Tamam, bana güvenebilirsin.Dialogue: 0,0:23:21.33,0:23:23.28,Main,Jinbe,0,0,0,,Beklemeni söyledim, Luffy-kun.Dialogue: 0,0:23:23.86,0:23:24.49,Main,Luffy,0,0,0,,Ha?Dialogue: 0,0:23:24.97,0:23:27.95,Main,Jinbe,0,0,0,,Hody ile siz savaşmamalısınız!Dialogue: 0,0:23:27.95,0:23:29.32,Main,Luffy,0,0,0,,Neden durduruyorsun?!Dialogue: 0,0:23:29.87,0:23:32.29,Main,Franky & Chopper,0,0,0,,İnsan olduğumuz için mi?Dialogue: 0,0:23:32.29,0:23:35.37,Main,Sanji,0,0,0,,Şu konuşanlara bir bak hele!Dialogue: 0,0:23:35.37,0:23:39.05,Main,Jinbe,0,0,0,,Evet. Siz dövüşmemelisiniz.Dialogue: 0,0:23:39.05,0:23:41.96,Main,Jinbe,0,0,0,,Balık adam halkı yine insanlardan nefret eder.Dialogue: 0,0:23:45.96,0:23:48.72,Main,Jinbe,0,0,0,,Bunu bana bırakın.Dialogue: 0,0:23:49.13,0:23:52.47,Main,Luffy,0,0,0,,Jinbe, tayfamı esir almışlar!Dialogue: 0,0:23:52.47,0:23:56.48,Main,Luffy,0,0,0,,Hody durdurulmalı.  Arkadaşlarımın başı belâda.Dialogue: 0,0:23:57.19,0:23:58.10,Main,Caimie,0,0,0,,Luffy-chin...Dialogue: 0,0:23:58.73,0:23:59.90,Main,Hachi,0,0,0,,Hasır Şapka...Dialogue: 0,0:24:03.79,0:24:05.98,Main,Jinbe,0,0,0,,Amma mankafalısın!Dialogue: 0,0:24:05.98,0:24:07.32,Main,Luffy,0,0,0,,Gidiyorum.Dialogue: 0,0:24:07.32,0:24:08.74,Main,Jinbe,0,0,0,,İnatçı keçi!Dialogue: 0,0:24:09.20,0:24:10.82,Main,Luffy,0,0,0,,İyi kafa yaptın ha.Dialogue: 0,0:24:10.82,0:24:14.12,Main,Luffy,0,0,0,,Durdurmak istiyorsan durdur!Dialogue: 0,0:24:14.72,0:24:16.01,Main,Chopper,0,0,0,,Luffy...Dialogue: 0,0:24:20.97,0:24:26.59,Main,Jinbe,0,0,0,,Birlikte savaştık diye dikkatsiz davranmam.Dialogue: 0,0:24:26.59,0:24:32.40,Main,Jinbe,0,0,0,,Evet, sen onun kardeşisin.Dialogue: 0,0:24:32.40,0:24:36.24,Main,Jinbe,0,0,0,,Madem durmayacaksın,  başka çaremiz kalmadı.Dialogue: 0,0:24:46.38,0:24:49.05,Main,Caimie,0,0,0,,Luffy-chin... Patron Jinbe...Dialogue: 0,0:24:49.05,0:24:52.01,Main,Nami,0,0,0,,Luffy, Jinbe, bir sakin olun.Dialogue: 0,0:24:52.01,0:24:53.85,Main,Nami,0,0,0,,N'apıyorsunuz?Dialogue: 0,0:24:53.96,0:24:56.86,Main,Luffy,0,0,0,,Ryugu Sarayı'ndan arkadaşlarımı kurtarıp...Dialogue: 0,0:24:56.86,0:24:58.94,Main,Luffy,0,0,0,,...Hody denen herifin icabına bakacağım!Dialogue: 0,0:24:58.94,0:25:01.45,Main,Jinbe,0,0,0,,Ben de bu yüzden durmanı söylüyorum.Dialogue: 0,0:25:01.45,0:25:04.41,Main,Sanji,0,0,0,,Neden kavga ediyorsunuz ki?Dialogue: 0,0:25:04.41,0:25:06.12,Main,Chopper,0,0,0,,Kesin şunu!Dialogue: 0,0:25:06.12,0:25:08.66,Main,Shirahoshi,0,0,0,,Luffy-sama, Patron Jinbe-sama!Dialogue: 0,0:25:09.75,0:25:13.29,Main,Luffy,0,0,0,,Köpek balığı. Götür beni! Ryugu Sarayı'na!Dialogue: 0,0:25:13.92,0:25:15.84,Main,Jinbe,0,0,0,,Beklemeni söyledim!Dialogue: 0,0:25:15.84,0:25:17.24,Main,Luffy,0,0,0,,Çekil!Dialogue: 0,0:25:17.34,0:25:18.92,Attack,TL Note,0,0,0,,Balık Adam Karate:Dialogue: 0,0:25:18.92,0:25:21.39,Attack,TL Note,0,0,0,,Köpek balığı Kiremit Hakiki YumrukDialogue: 0,0:25:29.35,0:25:29.77,Main,Sanji,0,0,0,,Ne?Dialogue: 0,0:25:29.77,0:25:30.80,Main,Caimie,0,0,0,,Luffy-chin!Dialogue: 0,0:25:30.80,0:25:31.68,Main,Chopper,0,0,0,,Ne?!Dialogue: 0,0:25:31.68,0:25:32.76,Main,Shirahoshi,0,0,0,,Luffy-sama!Dialogue: 0,0:25:41.56,0:25:43.54,Main,Luffy,0,0,0,,Acıdı...Dialogue: 0,0:25:43.54,0:25:44.87,Main,Nami,0,0,0,,Etkiledi mi?!Dialogue: 0,0:25:44.87,0:25:47.74,Main,Nami,0,0,0,,Lastik adamı öyle bir saldırının etkilememesi gerekiyor.Dialogue: 0,0:25:47.74,0:25:53.18,Main,Jinbe,0,0,0,,Balık Adam Karatesi'nin ruhu etrafınızdaki suyun ustalığıdır.Dialogue: 0,0:25:53.18,0:25:58.75,Main,Jinbe,0,0,0,,Atmosfer de bedeniniz de su gibidir.  Dalganın etkileri vücudunuzu deler geçer.Dialogue: 0,0:25:58.75,0:26:01.35,Main,Jinbe,0,0,0,,Yaşayan tüm canlılar temelde su parçasıdır.Dialogue: 0,0:26:01.35,0:26:04.02,Main,Jinbe,0,0,0,,Lastik adamsın diye istisna değilsin!Dialogue: 0,0:26:14.06,0:26:16.74,Main,Luffy,0,0,0,,Senin...Dialogue: 0,0:26:19.69,0:26:22.09,Main,Jinbe,0,0,0,,Gitmene izin vermeyeceğim, Luffy!Dialogue: 0,0:26:23.36,0:26:24.66,Attack,,0,0,0,,İkinci VitesDialogue: 0,0:26:27.72,0:26:30.26,Attack,,0,0,0,,Jet DamgaDialogue: 0,0:26:38.11,0:26:40.75,Main,Jinbe,0,0,0,,Eğitiminin sonucunda bu kadar mı güçlendin?Dialogue: 0,0:26:41.68,0:26:43.46,Main,Luffy,0,0,0,,Daha başlamadım!Dialogue: 0,0:26:47.32,0:26:48.81,Main,Robin,0,0,0,,Yeter.Dialogue: 0,0:26:49.43,0:26:50.30,Main,Chopper & Nami,0,0,0,,Robin!Dialogue: 0,0:26:51.51,0:26:52.64,Main,Sanji,0,0,0,,Robin-chwan!Dialogue: 0,0:26:52.95,0:26:54.98,Main,Luffy,0,0,0,,Çekil, Robin!Dialogue: 0,0:26:55.00,0:26:56.98,Main,Jinbe,0,0,0,,Sen kimsin, çekil!Dialogue: 0,0:26:56.98,0:27:01.23,Main,Sanji,0,0,0,,Robin-chan tehlikede!Dialogue: 0,0:27:11.02,0:27:14.40,Thoughts,Sanji,0,0,0,,Robin-chan...Dialogue: 0,0:27:18.95,0:27:20.21,Main,Robin,0,0,0,,Kavga etmek iyi değildir.Dialogue: 0,0:27:21.55,0:27:25.13,Main,Robin,0,0,0,,Şu anki durumu bilmiyorum ama arkadaşsınız, değil mi?Dialogue: 0,0:27:25.13,0:27:28.51,Main,Chopper,0,0,0,,Robin neden ormandan çıkıyor?Dialogue: 0,0:27:31.91,0:27:33.76,Main,Brook,0,0,0,,Pekâlâ, ben gidiyorum.Dialogue: 0,0:27:33.76,0:27:35.62,Main,Usopp,0,0,0,,Dursana yahu.Dialogue: 0,0:27:35.62,0:27:38.51,Main,Usopp,0,0,0,,Bize bunu açıklaman gerekiyor.Dialogue: 0,0:27:38.51,0:27:41.39,Main,Zoro,0,0,0,,Böyle bir şeyi yapabiliyor muydun?Dialogue: 0,0:27:41.39,0:27:43.19,Main,Brook,0,0,0,,Haklısın.Dialogue: 0,0:27:43.19,0:27:48.23,Main,Brook,0,0,0,,Ruh Kralı Dünya Turu'nda sırasında gerçekleşti.Dialogue: 0,0:27:59.51,0:28:00.80,Flashbacks,Brook,0,0,0,,Kemik!!!Dialogue: 0,0:28:02.47,0:28:04.98,Flashbacks,Brook,0,0,0,,Bu da ne?Dialogue: 0,0:28:08.60,0:28:13.80,Main,Brook,0,0,0,,Bu teknikle duvarların içinden geçebildiğime göre sizce ne yapmışımdır?Dialogue: 0,0:28:13.80,0:28:16.55,Main,Brook,0,0,0,,İkiniz de erkek olduğunuza göre anlıyorsunuzdur, değil mi?Dialogue: 0,0:28:19.02,0:28:22.83,Main,Usopp,0,0,0,,Kıskanıyorum, Zoro! Onu şimdi kıskandım işte!Dialogue: 0,0:28:22.83,0:28:24.59,Main,Zoro,0,0,0,,Kapa çeneni!Dialogue: 0,0:28:30.06,0:28:33.00,Main,Hody,0,0,0,,İdam alanına geçelim.Dialogue: 0,0:28:33.00,0:28:38.15,Main,Fishman Pirate,0,0,0,,Ryugu Sarayı'nda birini bırakalım mı, Patron Hody?Dialogue: 0,0:28:38.15,0:28:40.50,Main,Hody,0,0,0,,Önemli değil. Gerek var mı?Dialogue: 0,0:28:41.26,0:28:43.47,Main,Hody,0,0,0,,Ryugu Sarayı düşmez.Dialogue: 0,0:28:43.47,0:28:48.12,Main,Hody,0,0,0,,Döndüğümüzde kapıyı açacak birkaç kişiyi bırakın yeter.Dialogue: 0,0:28:48.12,0:28:51.22,Main,Hody,0,0,0,,Yeni kralı dışarıda bırakamayız.Dialogue: 0,0:28:51.98,0:28:53.26,Main,Fishman Pirate,0,0,0,,Haklısınız!Dialogue: 0,0:28:53.26,0:28:55.10,Main,Neptune,0,0,0,,Büyük gaflet-jamon!Dialogue: 0,0:28:56.65,0:28:59.82,Main,Neptune,0,0,0,,Halkın kalbinde şiddetle yer edinemezsin.Dialogue: 0,0:29:01.52,0:29:05.57,Main,Hody,0,0,0,,Fazla hayatın kalmadı. Sen konuşmaya devam et.Dialogue: 0,0:29:09.28,0:29:10.99,Main,Hody,0,0,0,,Yaram acıyor...Dialogue: 0,0:29:10.99,0:29:15.33,Main,Hody,0,0,0,,O küstah kılıç ustasının açtığı yara.Dialogue: 0,0:29:15.74,0:29:19.37,Main,Hody,0,0,0,,Uyuşturucunun etkisi geçiyor. Enerji Steroidi verin.Dialogue: 0,0:29:19.37,0:29:20.30,Main,Fishman Pirate,0,0,0,,Hemen!Dialogue: 0,0:29:30.84,0:29:32.35,Main,Hody,0,0,0,,Acı geçti.Dialogue: 0,0:29:32.35,0:29:35.30,Main,Fishman Pirate,0,0,0,,O kadar içmesi normal mi?Dialogue: 0,0:29:35.30,0:29:36.35,Main,Fishman Pirate,0,0,0,,Güzel soru...Dialogue: 0,0:29:36.35,0:29:40.15,Main,Fishman Pirate,0,0,0,,Patron, Hasır Şapka tayfasından o üçü ne olacak?Dialogue: 0,0:29:40.79,0:29:45.62,Main,Hody,0,0,0,,Sonuçta insanlar. Birazdan ölecekler.Dialogue: 0,0:29:45.62,0:29:50.37,Main,Hody,0,0,0,,Kim kurtarmaya gelirse gelsin,  kaleye sızmak imkânsız.Dialogue: 0,0:29:50.37,0:29:55.71,Main,Hody,0,0,0,,Neyse, Balık Adam Bölgesi'nden krallığa gelecek olan yeni vatandaşlar ne oldu?Dialogue: 0,0:29:56.24,0:29:57.42,Main,Fishman Pirate,0,0,0,,Sorun yok.Dialogue: 0,0:29:58.33,0:30:01.85,Main,Fishman Pirate,0,0,0,,Göç başladı.Dialogue: 0,0:30:03.67,0:30:07.30,Main,Hody,0,0,0,,Anlıyorum, evler yakında dolacak.Dialogue: 0,0:30:07.30,0:30:11.35,Main,Hody,0,0,0,,Bazıları ülkeyi terkedecek, kalanları ise öldürülecek.Dialogue: 0,0:30:11.35,0:30:14.19,Main,Hody,0,0,0,,Biz de onların evini kullanacağız.Dialogue: 0,0:30:17.22,0:30:22.58,Main,Hody,0,0,0,,Tüm ülke insanlardan nefret eder hâle gelince işte o zaman harika bir ülke olacağız.Dialogue: 0,0:30:26.50,0:30:29.74,Main,Brook,0,0,0,,Bir umut ışığı var!Dialogue: 0,0:30:30.20,0:30:35.69,Main,Brook,0,0,0,,Kaledekilerin hepsi gitmiş, etrafta kimse yok görünüyor.Dialogue: 0,0:30:35.69,0:30:38.42,Main,Brook,0,0,0,,Ama Pappagg-san hâlâ sarayda.Dialogue: 0,0:30:38.42,0:30:43.47,Main,Usopp,0,0,0,,Öyleyse Brook, Pappagg'a bu kilidin anahtarını bulmasını söyle.Dialogue: 0,0:30:43.47,0:30:45.76,Main,Usopp,0,0,0,,Kilidi açtıktan sonra, odanın anahtarı-Dialogue: 0,0:30:45.76,0:30:47.30,Main,Zoro,0,0,0,,Salak, dur.Dialogue: 0,0:30:47.92,0:30:52.31,Main,Zoro,0,0,0,,Kılıçlarımdan birini getirin. Bir tanesi yeter.Dialogue: 0,0:30:53.26,0:30:54.85,Main,Zoro,0,0,0,,Her şeyi keseyim.Dialogue: 0,0:30:54.85,0:30:56.93,Main,Usopp,0,0,0,,Çok güvenilirsin!Dialogue: 0,0:30:57.45,0:31:01.49,Main,Brook,0,0,0,,Kemik! Senin için geldim!Dialogue: 0,0:31:05.80,0:31:08.11,Main,Pappagg,0,0,0,,Hayalet!Dialogue: 0,0:31:14.16,0:31:15.66,Main,Brook,0,0,0,,Beklesene!Dialogue: 0,0:31:15.66,0:31:17.54,Main,Pappagg,0,0,0,,Hayalet! Korkuyorum!Dialogue: 0,0:31:17.54,0:31:20.51,Main,Brook,0,0,0,,Pappagg-san, benim yahu.Dialogue: 0,0:31:20.51,0:31:22.05,Main,Brook,0,0,0,,Acelemiz var!Dialogue: 0,0:31:22.05,0:31:25.26,Main,Brook,0,0,0,,Anahtarı... hayır, kılıcı...Dialogue: 0,0:31:25.26,0:31:25.96,Main,Brook,0,0,0,,Dur!Dialogue: 0,0:31:25.96,0:31:28.26,Main,Pappagg,0,0,0,,Yaklaşma!Dialogue: 0,0:31:28.26,0:31:28.88,Main,Pappagg,0,0,0,,Hayır!!!Dialogue: 0,0:31:28.88,0:31:31.30,Main,Brook,0,0,0,,Hayır demesene. Beni dinle.Dialogue: 0,0:31:31.30,0:31:32.68,Main,Brook,0,0,0,,Kaçma!Dialogue: 0,0:31:33.72,0:31:35.48,Main,Jinbe,0,0,0,,Düşün, Luffy.Dialogue: 0,0:31:35.60,0:31:40.19,Main,Jinbe,0,0,0,,Balık Adam Adası'nda savaş çıkarırsanız neler olacak?Dialogue: 0,0:31:40.19,0:31:47.26,Main,Jinbe,0,0,0,,Kalbini insanlara her seferinde açmış olan balık adamlara insanlar kötülük yapıyor.Dialogue: 0,0:31:47.71,0:31:52.95,Main,Jinbe,0,0,0,,"İnsanlar vahşi yaratıklardır. İnsanlar,  balık adamları aşağılıyor ve onlardan nefret ediyor."Dialogue: 0,0:31:53.31,0:31:59.88,Main,Jinbe,0,0,0,,Balık adam tarihi böyle güçlü, nahoş düşüncelerle doludur.Dialogue: 0,0:32:00.54,0:32:03.05,Main,Jinbe,0,0,0,,Arlong'un tayfası konusunda ise...Dialogue: 0,0:32:03.05,0:32:10.14,Main,Jinbe,0,0,0,,...çoğu kişi, Arlong sırf balık adam olduğu için yakalandığını düşünüyor.Dialogue: 0,0:32:10.14,0:32:17.64,Main,Jinbe,0,0,0,,Arlong'u yakalatan sen, bir de Hody ile savaşırsan neler olur sanıyorsun?Dialogue: 0,0:32:17.64,0:32:28.28,Main,Jinbe,0,0,0,,Balık Adam Adası'nın şu anki sorunlarını çözsen de, Hody'ye saldırmanın sonucunda...Dialogue: 0,0:32:28.28,0:32:32.91,Main,Jinbe,0,0,0,,...çoğu adalı, tarihimizin asla değiştirilemeyeceğini düşünecek.Dialogue: 0,0:32:45.02,0:32:47.09,Main,Sanji,0,0,0,,Öyle diyorsun da Jinbe.Dialogue: 0,0:32:48.06,0:32:51.42,Main,Sanji,0,0,0,,Yakalanan arkadaşlarımızı kurtarmamız normal bir şey.Dialogue: 0,0:32:51.42,0:32:55.64,Main,Sanji,0,0,0,,Duruma müdahele etmezsek Hody, Balık Adam Adası'nı ele geçirecek.Dialogue: 0,0:32:56.86,0:33:00.35,Main,Sanji,0,0,0,,Adada bir sürü arkadaşımız var.Dialogue: 0,0:33:00.72,0:33:02.02,Main,Sanji,0,0,0,,Hey, Hachi.Dialogue: 0,0:33:03.60,0:33:08.80,Main,Sanji,0,0,0,,Seni bu hâle getirenin kim olduğunu söyler misin?Dialogue: 0,0:33:08.80,0:33:10.76,Main,Sanji,0,0,0,,Sen de demiştin ya...Dialogue: 0,0:33:10.76,0:33:15.04,Main,Sanji,0,0,0,,Hody, insanlarla iyi geçinmek isteyen balık adamlara bile saldıracak.Dialogue: 0,0:33:15.04,0:33:16.22,Main,Sanji,0,0,0,,Sen...Dialogue: 0,0:33:17.26,0:33:21.09,Main,Sanji,0,0,0,,Bizimle arkadaş olduğun için mi bu şekilde yaralandın?Dialogue: 0,0:33:21.46,0:33:22.17,Main,Nami,0,0,0,,Hachi...Dialogue: 0,0:33:22.67,0:33:23.61,Main,Caimie,0,0,0,,Hacchin...Dialogue: 0,0:33:23.61,0:33:26.26,Main,Caimie,0,0,0,,Doğru mu bu? Bunu Hodyler mi yaptı?Dialogue: 0,0:33:27.41,0:33:28.88,Main,Hachi,0,0,0,,Şey...Dialogue: 0,0:33:28.88,0:33:35.14,Main,Sanji,0,0,0,,Jinbe, Luffy'nin savaşmak istemesinin bir başka nedeni ise ülkeniz.Dialogue: 0,0:33:36.46,0:33:38.44,Main,Sanji,0,0,0,,Bu adayı göz ardı edemeyiz.Dialogue: 0,0:33:40.13,0:33:43.55,Main,Sanji,0,0,0,,Savaşmak için nedenimiz var.Dialogue: 0,0:33:56.66,0:33:58.08,Main,Sanji,0,0,0,,Çünkü...Dialogue: 0,0:33:59.52,0:34:02.53,Main,Sanji,0,0,0,,...Camy-chan var...Dialogue: 0,0:34:02.53,0:34:05.78,Main,Sanji,0,0,0,,...Shirahoshi-chan da var!Dialogue: 0,0:34:05.78,0:34:10.62,Main,Sanji,0,0,0,,Evet! Bu ülke,  hayallerimdeki Deniz Kızı Cenneti!Dialogue: 0,0:34:20.36,0:34:22.37,Main,Luffy,0,0,0,,Çekil yolumdan, Jinbe.Dialogue: 0,0:34:22.37,0:34:24.35,Main,Luffy,0,0,0,,Gidiyorum dediysem gideceğim!Dialogue: 0,0:34:24.81,0:34:26.92,Main,Jinbe,0,0,0,,Hayır, gidemezsin. Bana bırak!Dialogue: 0,0:34:32.85,0:34:38.03,Main,Luffy,0,0,0,,Ulan senin! O zaman seni ezip geçeceğim!Dialogue: 0,0:34:38.03,0:34:42.23,Main,Jinbe,0,0,0,,Anlaman için kaç kez olacak olsun meydan okumanı kabul edeceğim!Dialogue: 0,0:34:42.23,0:34:44.38,Main,Luffy,0,0,0,,Ne dedin?Dialogue: 0,0:34:44.38,0:34:45.78,Main,Nami,0,0,0,,İkiniz de kesin şunu!