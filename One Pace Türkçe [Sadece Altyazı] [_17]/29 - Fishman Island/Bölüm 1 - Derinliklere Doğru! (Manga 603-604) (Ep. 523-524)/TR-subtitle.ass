Dialogue: 0,0:02:30.04,0:02:37.56,Title,,0,0,0,,{\fad(2000,1000)}Derinliklere Doğru!
Dialogue: 0,0:02:39.72,0:02:43.65,Captions,,0,0,180,,{\fad(800,500)}Sabaody Takımadaları
Dialogue: 0,0:02:39.62,0:02:41.80,Main,Coribou,0,0,0,,{\an8}Abi, burayı kazmak çok zor!
Dialogue: 0,0:02:41.80,0:02:42.95,Main,Caribou,0,0,0,,{\an8}Tabii öyle.
Dialogue: 0,0:02:42.95,0:02:45.34,Main,Caribou,0,0,0,,{\an8}Bu adalar çoğunlukla sadece ağaç kökü.
Dialogue: 0,0:02:45.34,0:02:48.21,Main,Not Zoro,0,0,0,,Lütfen bizi affet! Bizi gömme!
Dialogue: 0,0:02:48.21,0:02:50.82,Main,Not Sanji,0,0,0,,Ne istersen yaparız, lütfen bizi öldürme!
Dialogue: 0,0:02:50.82,0:02:54.70,Main,Not Franky,0,0,0,,Kaptan tarafından kandırıldık! O lanet Black tarafından!
Dialogue: 0,0:02:56.14,0:02:59.48,Main,Caribou,0,0,0,,Tayfamızı kurduğumuz andan beri...
Dialogue: 0,0:02:59.48,0:03:03.20,Main,Caribou,0,0,0,,rezil Hasır Şapka Korsanları'nın...
Dialogue: 0,0:03:04.37,0:03:07.04,Main,Caribou,0,0,0,,her birinin...
Dialogue: 0,0:03:07.72,0:03:12.54,Main,Caribou,0,0,0,,işini bitirmeye karar verdik biz!
Dialogue: 0,0:03:15.73,0:03:17.17,Main,Not Zoro,0,0,0,,Drip!
Dialogue: 0,0:03:17.17,0:03:19.36,Main,Not Franky,0,0,0,,Hey, lütfen dur!  Ölecek!
Dialogue: 0,0:03:19.36,0:03:21.63,Main,Not Franky,0,0,0,,Senin, Şeytan Meyvesi güçlerin mi var?!
Dialogue: 0,0:03:21.63,0:03:22.74,Main,Not Sogeking,0,0,0,,K-Kes şunu diyoruz!
Dialogue: 0,0:03:28.12,0:03:29.88,Main,Not Sogeking,0,0,0,,O da ne öyle?! Logi{\fscx250}-{\r}
Dialogue: 0,0:03:32.72,0:03:34.28,Main,Caribou,0,0,0,,İnanabiliyor musunuz?
Dialogue: 0,0:03:34.28,0:03:39.54,Main,Caribou,0,0,0,,2 yıl içinde vücutlarınızın ve yüzlerinizin değiştiğini düşünmüştüm.
Dialogue: 0,0:03:39.54,0:03:41.62,Main,Caribou,0,0,0,,Ama korsan, Hasır Şapka...
Dialogue: 0,0:03:41.62,0:03:43.27,Main,Caribou,0,0,0,,aslında değersiz biriymiş!
Dialogue: 0,0:03:43.27,0:03:45.46,Main,Caribou,0,0,0,,Sahte bir pislik sadece!
Dialogue: 0,0:03:45.46,0:03:48.78,Main,Caribou,0,0,0,,Sence Tanrı bunu affeder mi, Coribou?!
Dialogue: 0,0:03:48.78,0:03:50.31,Main,Coribou,0,0,0,,Kazın! Kazın!
Dialogue: 0,0:03:50.31,0:03:53.48,Main,Caribou,0,0,0,,Aynen öyle, arkadaşlar! Gömelim onları!
Dialogue: 0,0:03:53.48,0:03:55.91,Main,Caribou,0,0,0,,Ah, Tanrı!
Dialogue: 0,0:03:55.91,0:03:59.68,Main,Caribou,0,0,0,,Bu aptal sürüsünü gömeceğim!
Dialogue: 0,0:04:00.62,0:04:01.59,Main,Not Nami,0,0,0,,Dur!
Dialogue: 0,0:04:01.85,0:04:07.99,Main,Caribou,0,0,0,,Ama, gerçek Hasır Şapka Luffy'i kendi gözlerimle gördüm.
Dialogue: 0,0:04:09.57,0:04:13.93,Captions,Sign,0,0,180,,{\fad(800,500)}Sahte Hasır Şapkalar'ın eski buluşma noktası
Dialogue: 0,0:04:09.90,0:04:14.03,Main,Sentoumaru,0,0,0,,{\an8}Dediğim gibi, yapabileceğimiz bir şey yoktu.
Dialogue: 0,0:04:14.64,0:04:17.58,Main,Sentoumaru,0,0,0,,Karşımızdaki kişi Kara Kral Rayleigh idi.
Dialogue: 0,0:04:17.58,0:04:21.34,Main,Sentoumaru,0,0,0,,Kizaru amcayı durduran adam.\NBiz ona karşı ne yapabilirdik ki?
Dialogue: 0,0:04:22.20,0:04:26.38,Main,Sentoumaru,0,0,0,,Meydandan kaçabilen kişiler sadece Caribou kardeşler ve tayfaları...
Dialogue: 0,0:04:26.96,0:04:29.95,Main,Sentoumaru,0,0,0,,ve Sahte Hasır Şapka Korsanları'nın birkaç üyesi.
Dialogue: 0,0:04:29.95,0:04:31.95,Main,Sentoumaru,0,0,0,,Geri kalan herkesi yakaladık ama
Dialogue: 0,0:04:31.95,0:04:36.81,Main,Sentoumaru,0,0,0,,gerçek Hasır Şapka Korsanları getirdiğim iki Pacifista'ya da ağır hasarlar verdi.
Dialogue: 0,0:04:36.81,0:04:41.00,Main,Sentoumaru,0,0,0,,İki yıl önce onları köşeye sıkıştıranlarla aynı prototipler.
Dialogue: 0,0:04:41.00,0:04:43.83,Main,Sentoumaru,0,0,0,,Tabii ki, Pacifistalar'ın gücü değişmedi.
Dialogue: 0,0:04:43.83,0:04:46.30,Main,Sentoumaru,0,0,0,,Değişen onlar!
Dialogue: 0,0:04:47.38,0:04:51.15,Main,Sentoumaru,0,0,0,,İki yıllık yokluklarında,\Ninanılmaz derecede gelişmişler.
Dialogue: 0,0:04:52.80,0:04:57.52,Main,Sentoumaru,0,0,0,,Yeni Dünya'daki Donanma Karargahı'na şu mesajı ilet.
Dialogue: 0,0:04:57.52,0:05:01.88,Main,Sentoumaru,0,0,0,,Hasır Şapka Korsanları, tamamen yenilendi.
Dialogue: 0,0:05:06.74,0:05:09.28,Main,Shakki,0,0,0,,Göz açıp kapayıncaya kadar gittiler.
Dialogue: 0,0:05:09.28,0:05:13.46,Main,Shakki,0,0,0,,Monkey-chan da, diğerleri de kesinlikle güçlenmişler.
Dialogue: 0,0:05:13.46,0:05:15.08,Main,Rayleigh,0,0,0,,İzliyor muydun?
Dialogue: 0,0:05:15.08,0:05:16.63,Main,Shakki,0,0,0,,Evet. Hayranlarıyım sonuçta.
Dialogue: 0,0:05:17.41,0:05:20.97,Main,Shakki,0,0,0,,Bir şey mi hatırladın, Ray-san?
Dialogue: 0,0:05:20.97,0:05:25.27,Main,Rayleigh,0,0,0,,Ah, evet... sanırım.
Dialogue: 0,0:05:25.27,0:05:27.65,Flashbacks,Roger,0,0,0,,Hey! Güzel gemiymiş!
Dialogue: 0,0:05:27.65,0:05:31.73,Flashbacks,Rayleigh,0,0,0,,Bu çalıntı bir gemi.\NEvim yandı, o yüzden burada yaşıyorum.
Dialogue: 0,0:05:31.73,0:05:33.96,Flashbacks,Roger,0,0,0,,Anladım. Adın ne?
Dialogue: 0,0:05:33.96,0:05:35.35,Flashbacks,Rayleigh,0,0,0,,Rayleigh.
Dialogue: 0,0:05:36.42,0:05:41.32,Flashbacks,Roger,0,0,0,,Ben Roger! Bu karşılaşma kader, Rayleigh!
Dialogue: 0,0:05:41.32,0:05:44.76,Flashbacks,Roger,0,0,0,,Benimle gelip, dünyayı alt üst etmek ister misin?
Dialogue: 0,0:05:46.27,0:05:47.57,Flashbacks,Rayleigh,0,0,0,,Dünyayı mı?
Dialogue: 0,0:05:48.78,0:05:51.11,Flashbacks,Rayleigh,0,0,0,,Kim olduğunu sanıyorsun sen?
Dialogue: 0,0:05:51.11,0:05:52.14,Flashbacks,Rayleigh,0,0,0,,Kaybol buradan.
Dialogue: 0,0:05:54.38,0:05:58.40,Main,Rayleigh,0,0,0,,Belki de bu dünyada tesadüf diye bir şey yoktur.
Dialogue: 0,0:05:58.40,0:06:01.74,Main,Rayleigh,0,0,0,,Her şey bir amaç uğruna yaşanıyor gibi.
Dialogue: 0,0:06:02.93,0:06:06.06,Main,Rayleigh,0,0,0,,Kader gizemli şekillerde işliyor.
Dialogue: 0,0:06:06.06,0:06:13.47,Main,Rayleigh,0,0,0,,Ne olursa olsun, Luffy o şapkayı takmaya layık bir adam oldu.
Dialogue: 0,0:06:13.47,0:06:17.25,Main,Rayleigh,0,0,0,,Biraz daha yaşamak çok da kötü olmayabilir.
Dialogue: 0,0:06:17.25,0:06:20.60,Captions,Sign,0,0,180,,{\fad(500,0)} Sabaody Takımadaları'nın etrafındaki sular - Yüzeyin altı
Dialogue: 0,0:06:18.12,0:06:20.60,Main,Robin,0,0,0,,{\an8}Yüzey şimdiden çok uzakta.
Dialogue: 0,0:06:20.60,0:06:26.21,Main,Franky,0,0,0,,Ne manzara ama! Denizaltında bu kadar geniş bir manzara göremiyoruz.
Dialogue: 0,0:06:26.21,0:06:28.55,Main,Chopper,0,0,0,,Gitgide hızlıca batıyoruz!
Dialogue: 0,0:06:29.14,0:06:32.05,Main,Chopper,0,0,0,,Su cidden içeri girmeyecek mi? Çok endişeliyim!
Dialogue: 0,0:06:32.05,0:06:35.79,Main,Nami,0,0,0,,İnsan dünyasının dışına sürükleniyoruz gibi hissettiriyor! Kalbim küt küt atıyor.
Dialogue: 0,0:06:35.79,0:06:40.76,Main,Usopp,0,0,0,,Y-Yüzeye geri dönebilecek miyiz acaba?
Dialogue: 0,0:06:40.76,0:06:42.51,Main,Usopp,0,0,0,,Korktuğumdan falan değil yani!
Dialogue: 0,0:06:42.97,0:06:45.42,Main,Luffy,0,0,0,,Deniz çok güzel!
Dialogue: 0,0:06:46.33,0:06:48.68,Main,Brook,0,0,0,,Şu tarafa bir bakın lütfen!
Dialogue: 0,0:06:51.45,0:06:53.39,Main,Luffy,0,0,0,,Ağaçlar! Hayır, kökler!
Dialogue: 0,0:06:53.39,0:06:59.54,Main,Sanji,0,0,0,,Evet... Şimdi düşününce, Sabaody Takımadaları aslında büyük bir mangrovdan ibaret.
Dialogue: 0,0:06:59.54,0:07:01.99,Main,Brook,0,0,0,,Doğanın görkemi!
Dialogue: 0,0:07:01.99,0:07:04.05,Main,Zoro,0,0,0,,Ben çoktan gördüm.
Dialogue: 0,0:07:04.05,0:07:05.88,Main,Sanji,0,0,0,,{\i1}Yanlış gemiye bindin çünkü!
Dialogue: 0,0:07:05.88,0:07:08.27,Main,Sanji,0,0,0,,{\i1}Kes sesini! İnsanlar hayranlık içinde burada!
Dialogue: 0,0:07:09.09,0:07:12.74,Main,Robin,0,0,0,,Köklerin okyanusun dibine kadar uzaması...
Dialogue: 0,0:07:13.44,0:07:15.61,Main,Robin,0,0,0,,Çok büyükler, kelimelere dökemiyorum.
Dialogue: 0,0:07:15.61,0:07:19.97,Main,Usopp,0,0,0,,Hey, Chopper...\NŞu ağaçların arkasında bir şey var!
Dialogue: 0,0:07:21.75,0:07:23.94,Main,Chopper,0,0,0,,{\i1}Devasa!
Dialogue: 0,0:07:23.94,0:07:27.57,Main,Luffy,0,0,0,,Çok heyecanlıyım! Deniz altında büyük bir macera!
Dialogue: 0,0:07:27.57,0:07:29.42,Main,Luffy,0,0,0,,Rüya gibi!
Dialogue: 0,0:07:29.42,0:07:31.15,Main,Luffy,0,0,0,,Ah, balık!
Dialogue: 0,0:07:31.60,0:07:32.90,Main,Luffy,0,0,0,,Onları yakalayabilirim bence!
Dialogue: 0,0:07:34.21,0:07:37.05,Main,Zoro,0,0,0,,Bazı lezzetli görünen balıklarda var burada.
Dialogue: 0,0:07:38.68,0:07:40.68,Main,Usopp,0,0,0,,Kesin şunu, aptallar!
Dialogue: 0,0:07:40.68,0:07:43.45,Main,Chopper,0,0,0,,Sabun baloncuğu patlarsa ne olacak?!
Dialogue: 0,0:07:43.45,0:07:45.45,Main,Chopper,0,0,0,,Bunu bir daha yaparsanız sizi öldürürüm!
Dialogue: 0,0:07:45.45,0:07:49.17,Main,Sanji,0,0,0,,Nami-san, bunlar aptalca bir şey daha yapmadan,
Dialogue: 0,0:07:49.17,0:07:50.96,Main,Sanji,0,0,0,,bu kaplamanın nasıl çalıştığını anlatabilir misin?
Dialogue: 0,0:07:51.47,0:07:53.10,Main,Nami,0,0,0,,Olur, Sanji-kun.
Dialogue: 0,0:07:53.10,0:07:55.67,Main,Nami,0,0,0,,Rayleigh-san'dan notlar aldım sonuçta.
Dialogue: 0,0:07:55.67,0:07:57.74,Main,Nami,0,0,0,,O zaman, millet! Anlatıyorum!
Dialogue: 0,0:07:57.74,0:08:00.84,Main,Sanji,0,0,0,,Hareket etti! Gerçek bir güzellik!
Dialogue: 0,0:08:00.84,0:08:02.39,Main,Them,0,0,0,,{\i1}Sanji!
Dialogue: 0,0:08:02.39,0:08:03.69,Main,Chopper,0,0,0,,Patlayacak! Patlayacak! Patlayacak!
Dialogue: 0,0:08:03.69,0:08:06.34,Main,Usopp,0,0,0,,Bir burun kanamasıyla ne kadar uzağa uçabilirsin ki?!
Dialogue: 0,0:08:08.61,0:08:10.78,Main,Them,0,0,0,,Sanji denizin içine uçtu!
Dialogue: 0,0:08:10.78,0:08:12.37,Main,Luffy,0,0,0,,{\i1}Sanji!
Dialogue: 0,0:08:12.37,0:08:14.97,Main,Luffy,0,0,0,,{\i1}Geri gel!
Dialogue: 0,0:08:15.97,0:08:17.39,Main,Luffy,0,0,0,,Deniz olduğu için, gücüm...
Dialogue: 0,0:08:17.39,0:08:20.21,Main,Usopp & Chopper,0,0,0,,{\i1}Dayan!
Dialogue: 0,0:08:21.88,0:08:24.89,Main,Usopp,0,0,0,,Ne oldu sana, Sanji?!
Dialogue: 0,0:08:24.89,0:08:28.09,Main,Usopp,0,0,0,,Kadınlara karşı felç edici derecede zayıflaşmışsın gibi!
Dialogue: 0,0:08:28.09,0:08:29.69,Main,Chopper,0,0,0,,Hiç senlik değil!
Dialogue: 0,0:08:29.69,0:08:31.56,Main,Brook,0,0,0,,Ne kadar da üzücü.
Dialogue: 0,0:08:31.56,0:08:36.51,Main,Brook,0,0,0,,2 yıl içinde, kadın aşığı Sanji-san'ı bu hale ne getirmiş olabilir?
Dialogue: 0,0:08:36.51,0:08:40.43,Main,Brook,0,0,0,,Bu gidişle, görmeye can attığı deniz kızlarıyla karşılaştığında,
Dialogue: 0,0:08:40.43,0:08:43.16,Main,Brook,0,0,0,,kan kaybından ölebilir.
Dialogue: 0,0:08:43.16,0:08:46.50,Main,Chopper,0,0,0,,Balık Adam Adası'nda onun için bir kan nakli bulmamız lazım.
Dialogue: 0,0:08:46.50,0:08:50.75,Main,Chopper,0,0,0,,Acaba balık adamlar ve deniz adamları insanlarla aynı kan gruplarına mı sahiplerdir?
Dialogue: 0,0:08:50.75,0:08:52.84,Main,Robin,0,0,0,,Aslında, gördüğümüz gibi,
Dialogue: 0,0:08:52.84,0:08:59.89,Main,Robin,0,0,0,,bu gemiyi kaplayan sabun baloncuğu Sabaody Takımadaları'ndakilerle aynı özelliklere sahip değil mi?
Dialogue: 0,0:08:59.89,0:09:03.24,Main,Usopp,0,0,0,,Sakince sabun baloncukları hakkındaki analizine devam etme!
Dialogue: 0,0:09:03.24,0:09:04.00,Main,Nami,0,0,0,,Evet.
Dialogue: 0,0:09:04.00,0:09:06.13,Main,Nami,0,0,0,,Esasen aynılar.
Dialogue: 0,0:09:06.13,0:09:09.75,Main,Nami,0,0,0,,Belirli bir uzunluğa kadar esniyorlar,\Nve sonra da içlerinden geçiyorsunuz.
Dialogue: 0,0:09:09.75,0:09:11.15,Main,Nami,0,0,0,,En kötü senaryoda,
Dialogue: 0,0:09:11.15,0:09:16.17,Main,Nami,0,0,0,,eğer deniz canavarları tarafından saldırıya uğrarsak, onlara top ateşleyebiliriz.
Dialogue: 0,0:09:16.17,0:09:18.00,Main,Nami,0,0,0,,Baloncuk patlamaz!
Dialogue: 0,0:09:18.49,0:09:21.75,Main,Usopp,0,0,0,,Peki, ne olursa patlar?
Dialogue: 0,0:09:21.75,0:09:26.40,Main,Nami,0,0,0,,Tahmin edebileceğiniz gibi, eğer aynı anda yüksek sayıda delikler açılırsa dayanmaz.
Dialogue: 0,0:09:26.40,0:09:31.49,Main,Nami,0,0,0,,Örneğin, eğer bir deniz canavarı veya Deniz Kralı gemiyi ısırırsa, işimiz biter.
Dialogue: 0,0:09:33.61,0:09:36.22,Main,Usopp and Chopper,0,0,0,,{\i1}Arkamızda, dikkat edin!
Dialogue: 0,0:09:36.22,0:09:38.01,Main,Usopp and Chopper,0,0,0,,Kavgaymış... Kurtulduk.
Dialogue: 0,0:09:38.01,0:09:43.44,Main,Nami,0,0,0,,Eğer kayalara veya bir çukura çarparsak ve geminin kendisi hasar alırsa,
Dialogue: 0,0:09:43.44,0:09:47.35,Main,Nami,0,0,0,,direk veya gövdedeki kırıklar baloncuğun patlamasına yol açabilir.
Dialogue: 0,0:09:47.35,0:09:49.50,Main,Nami,0,0,0,,Bundan da kaçınmamız gerek.
Dialogue: 0,0:09:49.50,0:09:53.20,Main,Nami,0,0,0,,Aslında, deniz canlıları ve diğer engellere dikkat etmemiz gerekiyor.
Dialogue: 0,0:09:53.20,0:09:57.03,Main,Nami,0,0,0,,Burada aptalca bir şey yapmadığımız sürece,\Nendişelenmemiz gereken bir şey yok.
Dialogue: 0,0:09:57.03,0:10:00.57,Main,Usopp,0,0,0,,Anladım! Düşündüğümden daha güçlüymüş!
Dialogue: 0,0:10:00.57,0:10:05.69,Main,Nami,0,0,0,,Ama, Balık Adam Adası'na doğru yola çıkan gemilerin...
Dialogue: 0,0:10:05.69,0:10:08.49,Main,Nami,0,0,0,,70%'i yok edilmiş o yüzden, dikkatli olun.
Dialogue: 0,0:10:09.57,0:10:11.60,Main,Usopp & Chopper,0,0,0,,{\i1}Bize ne olacak?!
Dialogue: 0,0:10:12.08,0:10:16.78,Main,Luffy,0,0,0,,Üstlerinde Mitralyöz'ümü kullanırsam,\No balıkların hepsini yakalarım bence!
Dialogue: 0,0:10:16.78,0:10:20.41,Main,Zoro,0,0,0,,O zaman neden kimin daha çok yakalayacağına dair iddiaya girmiyoruz?
Dialogue: 0,0:10:20.78,0:10:24.16,Main,Usopp,0,0,0,,{\i1}Nami'nin dediklerini dinlemediniz mi siz?!
Dialogue: 0,0:10:24.16,0:10:26.45,Main,Usopp,0,0,0,,{\i1}Birkaç tane delik açamayız dedik ya!
Dialogue: 0,0:10:26.45,0:10:29.62,Main,Chopper,0,0,0,,{\i1}Çok fena döveceğim sizi!\NBir daha yapmayın!
Dialogue: 0,0:10:29.62,0:10:30.92,Main,Usopp,0,0,0,,Kahretsin!
Dialogue: 0,0:10:30.92,0:10:37.33,Main,Usopp,0,0,0,,Hachi bize Balık Adam Adası'na kadar eşlik edeceğini söylemişti, o yüzden tehlikeli olmaz diye düşünmüştüm!
Dialogue: 0,0:10:37.67,0:10:38.47,Main,Luffy,0,0,0,,Doğru!
Dialogue: 0,0:10:38.47,0:10:42.91,Main,Luffy,0,0,0,,Bir sürü yemek kutusu aldım.\NSanji de baygın sonuçta...
Dialogue: 0,0:10:42.91,0:10:44.66,Main,Luffy,0,0,0,,Millet! Hadi yemek yiyelim!
Dialogue: 0,0:10:44.66,0:10:47.03,Main,Chopper,0,0,0,,Karnımın guruldaması durmuyor!
Dialogue: 0,0:10:48.28,0:10:49.95,Main,Brook,0,0,0,,Benim kemiklerim de gurulduyor!
Dialogue: 0,0:10:50.43,0:10:53.96,Main,Franky,0,0,0,,Nami, gemi güvende olacak mı?
Dialogue: 0,0:10:53.96,0:10:58.25,Main,Nami,0,0,0,,Şu anda sadece büyük bir deniz akıntısında gidiyoruz, o yüzden...
Dialogue: 0,0:10:58.89,0:11:03.68,Main,Franky,0,0,0,,Hepinize, söylemem gereken bir şey var.
Dialogue: 0,0:11:03.68,0:11:05.81,Main,They,0,0,0,,{\i1}Gizli robot fonksiyonların mı?!
Dialogue: 0,0:11:05.81,0:11:08.08,Main,Franky,0,0,0,,Hayır, üzgünüm ama...
Dialogue: 0,0:11:08.08,0:11:10.15,Main,Franky,0,0,0,,{\i1}Üzgünüm ama bu doğru değil, robo.
Dialogue: 0,0:11:10.15,0:11:12.68,Main,They,0,0,0,,{\i1}Vay, harika!  Robot-dili!
Dialogue: 0,0:11:13.94,0:11:18.79,Main,Franky,0,0,0,,Gerçek şu ki, Hachi bize denizin dibine kadar rehberlik etmeyi planladı ama...
Dialogue: 0,0:11:18.79,0:11:21.40,Main,Franky,0,0,0,,Sabaody'de büyük yaralar aldığını,
Dialogue: 0,0:11:21.40,0:11:24.60,Main,Franky,0,0,0,,ve şu anda Balık Adam Adası'nda iyileştiğini duydum.
Dialogue: 0,0:11:24.60,0:11:27.60,Main,Franky,0,0,0,,Sebebi, Duval'ınki ile aynı.
Dialogue: 0,0:11:27.60,0:11:32.06,Main,Franky,0,0,0,,Adada bırakılan Thousand Sunny'i korumak için savaştı.
Dialogue: 0,0:11:32.06,0:11:36.00,Main,Franky,0,0,0,,Yaklaşık bir yıl önce, Sunny'nin yeri Donanma tarafından bulundu.
Dialogue: 0,0:11:36.00,0:11:40.08,Main,Franky,0,0,0,,Devamındaki şiddetli savaşta, ikisi de orada alaşağı edildi.
Dialogue: 0,0:11:40.08,0:11:44.82,Main,Usopp,0,0,0,,Ha? O zaman şimdiye kadar gemi nasıl dayanabildi?
Dialogue: 0,0:11:45.23,0:11:48.09,Main,Franky,0,0,0,,Çünkü orada bir dövüşçü daha vardı.
Dialogue: 0,0:11:48.09,0:11:53.22,Main,Franky,0,0,0,,2 yıl önce bizi dağıtan kişinin ta kendisi.
Dialogue: 0,0:11:55.62,0:11:59.98,Main,Franky,0,0,0,,Shichibukai'den biri olan büyük adam, Bartholomew Kuma.
Dialogue: 0,0:11:59.98,0:12:04.56,Main,Franky,0,0,0,,Birkaç gün önce, Sunny'nin olduğu yere ulaştığımda,
Dialogue: 0,0:12:04.56,0:12:06.61,Main,Franky,0,0,0,,gözlerime inanamadım.
Dialogue: 0,0:12:07.52,0:12:09.11,Flashbacks,Kuma,0,0,0,,Seni bekliyordum.
Dialogue: 0,0:12:10.58,0:12:12.81,Flashbacks,Franky,0,0,0,,Sen! Burada ne yapıyorsun?!
Dialogue: 0,0:12:14.06,0:12:17.26,Flashbacks,Kuma,0,0,0,,Görev tamamlandı.
Dialogue: 0,0:12:20.61,0:12:23.99,Main,Franky,0,0,0,,Sunny'nin üstünde bir çizik bile yoktu.
Dialogue: 0,0:12:24.52,0:12:27.33,Main,Franky,0,0,0,,Sonrasında Rayleigh ile konuştuğumda...
Dialogue: 0,0:12:28.05,0:12:30.80,Flashbacks,Kuma,0,0,0,,Ben Devrimci Ordusu'nun bir subayıyım. {Copy-paste from 507}
Dialogue: 0,0:12:30.80,0:12:34.34,Flashbacks,Kuma,0,0,0,,Bu yüzden, bu tayfayı buradan kaçırmak istiyorum. {End copy-paste from 507}
Dialogue: 0,0:12:34.34,0:12:38.06,Main,Franky,0,0,0,,Bunu sizin de farkettiğinizi düşünüyorum.
Dialogue: 0,0:12:38.06,0:12:41.35,Main,Franky,0,0,0,,O bizim hayatımızı kurtardı.
Dialogue: 0,0:12:41.35,0:12:48.03,Main,Franky,0,0,0,,Ve biz adadan kaybolduktan sonra, Rayleigh'i ziyaret eden Kuma-san şöyle söyledi...
Dialogue: 0,0:12:48.27,0:12:52.59,Flashbacks,Kuma,0,0,0,,Benim artık... vaktim kalmadı. {Copy-paste from 507.}
Dialogue: 0,0:12:52.59,0:12:55.49,Main,Franky,0,0,0,,Onun gitmesini nasıl engelliyorlardı bilmiyorum ama
Dialogue: 0,0:12:55.49,0:13:00.97,Main,Franky,0,0,0,,Donanma'nın üstünde deneyler yapmasına izin verdi ve onu yavaşça bir cyborga çevirdiler.
Dialogue: 0,0:13:00.97,0:13:03.13,Main,Franky,0,0,0,,Büyük savaşın biraz öncesinde,
Dialogue: 0,0:13:03.13,0:13:07.10,Main,Franky,0,0,0,,kişiliğini tamamen yok edecek olan bir değişikliğe maruz kalmayı kabul etti.
Dialogue: 0,0:13:07.10,0:13:14.18,Main,Chopper,0,0,0,,Ama bizim dağıldıktan sonra ne yapacağımızı bilmesinin imkanı yok!
Dialogue: 0,0:13:14.18,0:13:17.89,Main,Chopper,0,0,0,,Ayrıca, gemide bizi mi bekledi? Kişiliğini kaybetmesine rağmen mi?!
Dialogue: 0,0:13:18.19,0:13:21.82,Main,Franky,0,0,0,,Cerrah, Doctor Vegapunk ileyken,
Dialogue: 0,0:13:21.82,0:13:26.80,Main,Franky,0,0,0,,ona belirli bir görevin programlanması konusunda söz almış gibi duruyor.
Dialogue: 0,0:13:26.80,0:13:33.69,Main,Franky,0,0,0,,Hasır Şapka Korsanları'nın bir üyesi geri gelene kadar gemiyi koru.
Dialogue: 0,0:13:33.69,0:13:37.33,Main,Franky,0,0,0,,Yani o, bu iki yıl boyunca hafızası olmadan,
Dialogue: 0,0:13:37.83,0:13:43.17,Main,Franky,0,0,0,,bir insan silah olarak, geçmişteki kendinden aldığı emirleri uygulayarak bizi bekliyordu.
Dialogue: 0,0:13:43.17,0:13:45.98,Main,Zoro,0,0,0,,Yöntemleri çok sıkıntılıymış.
Dialogue: 0,0:13:45.98,0:13:47.74,Main,Zoro,0,0,0,,Neden bizim için o kadar zahmete girsin?
Dialogue: 0,0:13:48.13,0:13:50.54,Main,Usopp,0,0,0,,Devrimci Ordusu'ndan ise eğer,
Dialogue: 0,0:13:50.54,0:13:55.82,Main,Usopp,0,0,0,,düşünebildiğim tek açıklama Luffy'nin babasının onların patronu olması.
Dialogue: 0,0:13:55.82,0:13:58.20,Main,Luffy,0,0,0,,Babam hakkında çok bir şey bilmiyorum.
Dialogue: 0,0:13:58.20,0:14:01.78,Main,Luffy,0,0,0,,Ama nihayetinde, o ayıya benzeyen adam iyi bir adammış sanırım.
Dialogue: 0,0:14:02.79,0:14:04.13,Thoughts,Robin,0,0,0,,Kuma.
Dialogue: 0,0:14:04.13,0:14:05.87,Main,Franky,0,0,0,,Şu var ki...
Dialogue: 0,0:14:05.87,0:14:13.84,Main,Franky,0,0,0,,bizim için bir anlamı olmayan bu süreyi bizim için faydalı yapan kişinin o olduğuna şüphe yok.
Dialogue: 0,0:14:13.84,0:14:19.06,Main,Franky,0,0,0,,Gerçi şu anda, ona bunu neden yaptığını sorabilmemizin bir yolu yok,
Dialogue: 0,0:14:19.06,0:14:22.32,Main,Franky,0,0,0,,bunu kalplerinizde taşıyın. Bu tayfa...
Dialogue: 0,0:14:22.32,0:14:28.05,Main,Franky,0,0,0,,Bartholomew Kuma'ya hayatı boyunca, borçlu kalacak.
Dialogue: 0,0:14:28.05,0:14:34.42,Main,Franky,0,0,0,,Onunla tekrar karşılaşacağımız gün gelse bile, Kuma artık sadece, kalpsiz bir insan silahı.
Dialogue: 0,0:14:34.42,0:14:37.57,Main,Zoro,0,0,0,,Ona minnettarım ama bu çok fazla soru doğuruyor.
Dialogue: 0,0:14:37.57,0:14:40.22,Main,Zoro,0,0,0,,Umarım bir gün Kuma'nın gerçek niyetini öğrenebiliriz.
Dialogue: 0,0:14:40.22,0:14:41.99,Main,Franky,0,0,0,,Diyeceklerim bu kadar.
Dialogue: 0,0:14:41.99,0:14:43.99,Main,Chopper,0,0,0,,Ah, Sanji, uyandın mı?
Dialogue: 0,0:14:43.99,0:14:46.78,Main,Luffy,0,0,0,,Bir yemek kutusu al! Kadınlar Adası'ndan getirdim!
Dialogue: 0,0:14:46.78,0:14:48.00,Main,Sanji,0,0,0,,Kadınlar Adası...
Dialogue: 0,0:14:48.92,0:14:51.84,Main,Sanji,0,0,0,,Kuma'ya neden minnettar olmalıyım?
Dialogue: 0,0:14:51.84,0:14:54.92,Main,Sanji,0,0,0,,İki yıldır nerede olduğumu düşünüyorsunuz?!
Dialogue: 0,0:14:54.92,0:14:59.67,Main,Sanji,0,0,0,,O rüya gibi kadınlarla dolu adada ne tür eğitimler yaptın, Luffy?!
Dialogue: 0,0:14:59.67,0:15:03.34,Main,Brook,0,0,0,,Hey, hey, hey, Sanji-san.\NHep beraber şarkı söyleyelim mi?
Dialogue: 0,0:15:03.34,0:15:05.85,Main,Sanji,0,0,0,,Beni rahatlatmaya çalışma!\NBu küçük düşürücü!
Dialogue: 0,0:15:05.85,0:15:07.34,Main,Coribou,0,0,0,,Abi! Oradalar!
Dialogue: 0,0:15:07.34,0:15:08.85,Main,Coribou,0,0,0,,Önümüzde! Hasır Şapkalar!
Dialogue: 0,0:15:08.85,0:15:13.41,Main,Caribou,0,0,0,,Görünce anlayabiliyorum, seni aptal.
Dialogue: 0,0:15:14.54,0:15:17.77,Main,Caribou,0,0,0,,Bu sefer güverteye çıkabileceğim, değil mi?
Dialogue: 0,0:15:17.77,0:15:20.15,Main,Luffy,0,0,0,,Ne kadar battık acaba?
Dialogue: 0,0:15:20.15,0:15:23.87,Main,Usopp,0,0,0,,Bu kadar aşağıda fazla ışık yok gibi duruyor.
Dialogue: 0,0:15:23.87,0:15:28.93,Main,Franky,0,0,0,,Çoktan günışığı seviyesini geçtik ve şimdi de alacakaranlık seviyesinin sonuna yaklaşıyoruz.
Dialogue: 0,0:15:28.93,0:15:31.08,Main,Franky,0,0,0,,Bir kilometreden fazla aşağıda olmalıyız.
Dialogue: 0,0:15:31.77,0:15:36.04,Main,Robin,0,0,0,,Çok sessiz.\NBu gerçekten denizaltından farklı hissettiriyor.
Dialogue: 0,0:15:36.04,0:15:38.59,Main,Robin,0,0,0,,Neredeyse gökyüzünde uçuyormuşuz gibi.
Dialogue: 0,0:15:38.59,0:15:40.49,Main,Chopper,0,0,0,,Balina! Bir balina!
Dialogue: 0,0:15:40.49,0:15:42.16,Main,Brook,0,0,0,,Laboon? Laboon!
Dialogue: 0,0:15:42.16,0:15:44.92,Main,Luffy,0,0,0,,Hayır, o Beyazsakal amca!
Dialogue: 0,0:15:44.92,0:15:47.47,Main,Usopp,0,0,0,,Saat 6 yönünde bir şey görüyorum!
Dialogue: 0,0:15:47.47,0:15:49.21,Main,Usopp,0,0,0,,Deniz canavarı? Hayır...
Dialogue: 0,0:15:49.21,0:15:52.57,Main,Caribou,0,0,0,,Hazır mısınız, beyler?
Dialogue: 0,0:15:52.57,0:15:54.05,Main,Coribou,0,0,0,,Evet, Abi!
Dialogue: 0,0:15:54.05,0:15:55.37,Main,Pirates,0,0,0,,{\i1}Hayhay!
Dialogue: 0,0:15:55.37,0:15:58.27,Main,Caribou,0,0,0,,Hedefimiz gözlerimizin önünde!
Dialogue: 0,0:15:58.27,0:16:00.65,Main,Caribou,0,0,0,,Onların gemilerini yok edip,
Dialogue: 0,0:16:00.65,0:16:04.39,Main,Caribou,0,0,0,,enkazlarını denizin dibine gönderebiliriz ama,
Dialogue: 0,0:16:04.39,0:16:09.56,Main,Caribou,0,0,0,,bu hiç iyi olmaz.\NEğer bunu yaparsak, kimin yaptığını kimse bilmez.
Dialogue: 0,0:16:09.56,0:16:12.78,Main,Caribou,0,0,0,,Kafalarını kesip yüzeye geri götüreceğiz.
Dialogue: 0,0:16:12.78,0:16:17.40,Main,Caribou,0,0,0,,Böylece tüm dünyaya,\N"Caribou burada!" diye sesleneceğiz!
Dialogue: 0,0:16:17.40,0:16:18.46,Main,Pirates,0,0,0,,{\i1}Hayhay!
Dialogue: 0,0:16:18.87,0:16:21.31,Main,Caribou,0,0,0,,Bir dövüş için tamamen hazırlıksızlar!
Dialogue: 0,0:16:21.31,0:16:25.82,Main,Caribou,0,0,0,,Bu kusursuz bir gizli saldırı!\NBunun içine etmeyin sakın, beyler!
Dialogue: 0,0:16:25.82,0:16:27.23,Main,Pirates,0,0,0,,{\i1}Hayhay!
Dialogue: 0,0:16:27.23,0:16:29.30,Main,Coribou,0,0,0,,Hayhay!
Dialogue: 0,0:16:29.30,0:16:31.13,Main,Usopp,0,0,0,,Hey, millet!
Dialogue: 0,0:16:31.13,0:16:33.37,Main,Usopp,0,0,0,,Gemiye benzeyen bir gölge arkadan yaklaşıyor!
Dialogue: 0,0:16:33.37,0:16:34.25,Main,Sanji & Zoro,0,0,0,,Ne?!
Dialogue: 0,0:16:34.25,0:16:34.92,Main,Luffy,0,0,0,,Gemi mi?!
Dialogue: 0,0:16:34.92,0:16:36.47,Main,Usopp,0,0,0,,Doğruca bize doğru geliyor!
Dialogue: 0,0:16:36.47,0:16:38.48,Main,Caribou,0,0,0,,Hücum!
Dialogue: 0,0:16:43.51,0:16:44.78,Main,Chopper,0,0,0,,Bu bir korsan gemisi!
Dialogue: 0,0:16:44.78,0:16:46.67,Main,Usopp,0,0,0,,Gemimize çarpıyorlar!
Dialogue: 0,0:16:46.67,0:16:50.07,Main,Usopp,0,0,0,,Geri çekilin! Baloncuk patlayacak!
Dialogue: 0,0:16:50.82,0:16:53.69,Main,Nami,0,0,0,,Olamaz! Baloncuğumuzun içine girmeye çalışıyorlar!
Dialogue: 0,0:16:54.64,0:16:55.81,Main,Luffy,0,0,0,,Kim onlar?!
Dialogue: 0,0:16:55.81,0:16:57.83,Main,Caribou,0,0,0,,Aferin, deniz ineği!
Dialogue: 0,0:16:57.83,0:16:58.93,Main,Pirates,0,0,0,,{\i1}Hayhay!
Dialogue: 0,0:16:58.93,0:17:00.17,Main,Brook,0,0,0,,Güverteye çıkmayı mı planlıyorlar?
Dialogue: 0,0:17:00.17,0:17:01.27,Main,Nami,0,0,0,,Deniz ineği mi?
Dialogue: 0,0:17:02.38,0:17:03.88,Main,Nami,0,0,0,,Bekle bir saniye! Yoksa o...
Dialogue: 0,0:17:08.48,0:17:11.86,Main,Caribou,0,0,0,,Tamam! Gidelim mi artık?
Dialogue: 0,0:17:11.86,0:17:13.08,Main,Pirates,0,0,0,,{\i1}Hayhay!
Dialogue: 0,0:17:13.08,0:17:14.72,Main,Nami,0,0,0,,Hey, Momoo! {Gil: Timing appeared one frame early. Hope I changed it correctly.} {Yup, it's good now -FAb}
Dialogue: 0,0:17:14.72,0:17:16.92,Main,Nami,0,0,0,,Sen Arlong'un tayfasından Momoo'sun değil mi?
Dialogue: 0,0:17:17.96,0:17:19.82,Main,Nami,0,0,0,,Beni tanıdın mı?
Dialogue: 0,0:17:21.92,0:17:24.93,Main,Sanji,0,0,0,,Hey, Luffy! Bunu biz daha önce de görmedik mi?
Dialogue: 0,0:17:25.41,0:17:26.26,Main,Luffy,0,0,0,,Öyle mi?
Dialogue: 0,0:17:27.37,0:17:29.68,Flashbacks,Sanji,0,0,0,,{\i1}Geber!
Dialogue: 0,0:17:29.68,0:17:31.92,Flashbacks,Luffy,0,0,0,,{\fad(150,150)}Gomu Gomu no Pistol!\N{Lastik-Lastik Tabanca!}
Dialogue: 0,0:17:29.68,0:17:31.92,Attack,Luffy,0,0,0,,{\fad(150,150)}Lastik Lastik Tabanca!
Dialogue: 0,0:17:35.24,0:17:37.57,Main,Caribou,0,0,0,,Güverteye çıkıyoruz, beyler!
Dialogue: 0,0:17:37.57,0:17:38.28,Main,Pirates,0,0,0,,{\i1}Hayhay!
Dialogue: 0,0:17:40.46,0:17:42.15,Main,Chopper,0,0,0,,{\i1}Biri içeri geliyor!
Dialogue: 0,0:17:42.15,0:17:45.66,Main,Caribou,0,0,0,,Beyler, hazır mısınız?!
Dialogue: 0,0:17:45.66,0:17:46.92,Main,Pirates,0,0,0,,{\i1}Hayhay!
Dialogue: 0,0:17:47.56,0:17:54.89,Main,Caribou,0,0,0,,Onlar... orada öylece... beklerken...
Dialogue: 0,0:17:54.89,0:17:58.43,Main,Caribou,0,0,0,,birer birer hepsini... katledin!
Dialogue: 0,0:18:00.13,0:18:01.24,Main,Caribou,0,0,0,,Gidelim!
Dialogue: 0,0:18:01.24,0:18:02.31,Main,Pirates,0,0,0,,{\i1}Hayhay!
Dialogue: 0,0:18:02.31,0:18:05.71,Main,Caribou,0,0,0,,Beyler! Beni takip edin!
Dialogue: 0,0:18:08.28,0:18:11.34,Main,Pirates,0,0,0,,{\i1}Neeeeee?!
Dialogue: 0,0:18:11.34,0:18:12.89,Main,Pirates,0,0,0,,Ne oldu, deniz ineği?!
Dialogue: 0,0:18:12.89,0:18:14.25,Main,Pirates,0,0,0,,Neden, deniz ineği?!
Dialogue: 0,0:18:14.25,0:18:17.52,Main,Pirates,0,0,0,,Bu da ne?!\NKaptan Caribou o gemide kaldı!
Dialogue: 0,0:18:17.52,0:18:18.77,Main,Coribou,0,0,0,,Abi?!
Dialogue: 0,0:18:19.82,0:18:23.82,Main,Caribou,0,0,0,,Şimdi... Karşılama niyetine...
Dialogue: 0,0:18:24.53,0:18:28.03,Main,Caribou,0,0,0,,Mitralyözü ateşleyin!
Dialogue: 0,0:18:28.03,0:18:34.57,Main,Caribou,0,0,0,,Hasır Şapka Tayfası'nın... hepsini öldürün!
Dialogue: 0,0:18:42.58,0:18:43.71,Main,Caribou,0,0,0,,Yapma!
Dialogue: 0,0:18:43.71,0:18:47.68,Main,Caribou,0,0,0,,L-Lütfen, beni denize atma!
Dialogue: 0,0:18:47.68,0:18:48.80,Main,Caribou,0,0,0,,O kadar!
Dialogue: 0,0:18:48.80,0:18:50.21,Main,Caribou,0,0,0,,Onun dışında her şey olur!
Dialogue: 0,0:18:50.21,0:18:54.03,Main,Caribou,0,0,0,,Başkasının canını bu kadar sıradan bir şekilde alma!
Dialogue: 0,0:18:54.03,0:18:55.32,Main,Caribou,0,0,0,,Tanrı! { def: i'm going with consistency here and sticking with "God" (unless we get a confirmed plural translation).  it works with his crusaderish insignia as well. }
Dialogue: 0,0:18:55.32,0:18:57.13,Main,Caribou,0,0,0,,Tanrı izliyor!
Dialogue: 0,0:18:57.13,0:18:57.95,Main,Caribou,0,0,0,,Değil mi?!
Dialogue: 0,0:18:59.19,0:19:05.23,Main,Franky,0,0,0,,Saçmasapan şeyler söylemeyi kes! Az önce kim katletmek ve mitralyözden bahsediyordu?!
Dialogue: 0,0:19:05.23,0:19:06.96,Main,Zoro,0,0,0,,Sen kimin nesisin?
Dialogue: 0,0:19:06.96,0:19:09.77,Main,Zoro,0,0,0,,O korsan gemisinin kaptanısın, değil mi?
Dialogue: 0,0:19:09.77,0:19:11.97,Thoughts,Caribou,0,0,0,,Ha?! Roronoa Zoro!
Dialogue: 0,0:19:11.97,0:19:16.89,Main,Caribou,0,0,0,,Hayır, yanılıyorsunuz! Ben kaptan değilim!
Dialogue: 0,0:19:16.89,0:19:18.54,Main,Caribou,0,0,0,,Ben, şey...
Dialogue: 0,0:19:18.54,0:19:22.56,Main,Caribou,0,0,0,,Ben sadece onların kölesi olarak kullanılıyordum!
Dialogue: 0,0:19:22.56,0:19:25.05,Main,Caribou,0,0,0,,Lanet olsun, o gemide olmaktan bıktım artık!
Dialogue: 0,0:19:25.05,0:19:26.56,Main,Caribou,0,0,0,,Evet! Lütfen!
Dialogue: 0,0:19:26.56,0:19:30.05,Main,Caribou,0,0,0,,Bir süre geminizde kalmama izin verir misiniz?
Dialogue: 0,0:19:30.05,0:19:31.22,Main,Caribou,0,0,0,,Lütfen! Yalvarıyorum!
Dialogue: 0,0:19:31.22,0:19:34.75,Main,Chopper,0,0,0,,Şey, o biraz acınası birine benziyor.
Dialogue: 0,0:19:34.75,0:19:37.57,Main,Usopp,0,0,0,,Bunun imkanı yok! Hepsi yalan!
Dialogue: 0,0:19:37.57,0:19:39.90,Main,Chopper,0,0,0,,{\i1}Ne?! Hepsi yalan mıydı?!
Dialogue: 0,0:19:39.90,0:19:41.46,Main,Nami,0,0,0,,Hey, sen!
Dialogue: 0,0:19:41.46,0:19:44.10,Main,Nami,0,0,0,,Az önce gemiyi çeken o deniz ineği de neydi?
Dialogue: 0,0:19:44.10,0:19:45.83,Main,Caribou,0,0,0,,
Dialogue: 0,0:19:47.47,0:19:51.60,Main,Caribou,0,0,0,,Ne varmış burada? Tatlı bir kadın.
Dialogue: 0,0:19:51.60,0:19:54.41,Main,Caribou,0,0,0,,Sen Hırsız Kedi'sin değil mi?
Dialogue: 0,0:19:54.41,0:19:59.28,Main,Sanji,0,0,0,,O edepsiz gözlerinle güzeller güzeli rotacımıza bakmaya cüret etme!
Dialogue: 0,0:19:59.67,0:20:03.26,Main,Sanji,0,0,0,,Nami-san, artık sorun... yok...
Dialogue: 0,0:20:04.73,0:20:07.52,Main,Usopp,0,0,0,,Bu sinir bozucu olmaya başladı!
Dialogue: 0,0:20:07.52,0:20:11.84,Main,Caribou,0,0,0,,O sadece bu sularda yakaladığımız bir deniz canavarı.
Dialogue: 0,0:20:12.88,0:20:18.09,Main,Caribou,0,0,0,,Gemini çekmesi için öyle canavarlar kullanmak, sadece profesyonellerin yapacağı bir şey.
Dialogue: 0,0:20:18.09,0:20:19.47,Main,Luffy,0,0,0,,Ha?!
Dialogue: 0,0:20:19.47,0:20:21.27,Main,Luffy,0,0,0,,Öyle mi?!
Dialogue: 0,0:20:21.75,0:20:23.96,Main,Pirates,0,0,0,,Dur! Dur, deniz ineği!
Dialogue: 0,0:20:23.96,0:20:25.18,Main,Pirates,0,0,0,,Ne oldu, deniz ineği?!
Dialogue: 0,0:20:25.18,0:20:29.18,Main,Coribou,0,0,0,,Abi! Seni kurtaracağım!
Dialogue: 0,0:20:29.68,0:20:32.55,Main,Luffy,0,0,0,,Buralarda hiç deniz canavarı var mıdır acaba?
Dialogue: 0,0:20:32.55,0:20:35.88,Main,Nami,0,0,0,,Hey, Luffy. Neler planlıyorsun sen?
Dialogue: 0,0:20:36.52,0:20:40.59,Main,Chopper,0,0,0,,Üzerinde çok etkisi olmayacak fotoğraflarla tedavine başlayacağız.
Dialogue: 0,0:20:40.59,0:20:42.06,Main,Usopp,0,0,0,,Hey, Nami.
Dialogue: 0,0:20:42.06,0:20:45.50,Main,Usopp,0,0,0,,Seyir Pusulası'nın işaret ettiğinden farklı bir yöne mi gidiyoruz? {zzz}
Dialogue: 0,0:20:45.50,0:20:46.90,Main,Nami,0,0,0,,Evet, ama sıkıntı yok.
Dialogue: 0,0:20:47.21,0:20:50.87,Main,Nami,0,0,0,,Sadece pusula ibresinin güneybatısına doğru gitmemiz gerekiyor.
Dialogue: 0,0:20:50.87,0:20:54.62,Main,Luffy,0,0,0,,Ama dümdüz adaya gitmek daha hızlı olurdu!
Dialogue: 0,0:20:54.62,0:20:55.65,Main,Luffy,0,0,0,,Neden?
Dialogue: 0,0:20:55.65,0:21:00.28,Main,Nami,0,0,0,,Eğer ibreyi dümdüz takip edersen,\Ndeniz akıntılarına kapılır ve daha hedefine ulaşamadan,
Dialogue: 0,0:21:00.28,0:21:03.75,Main,Nami,0,0,0,,bir su altı dağı veya yanardağına çarparsın ve işin biter.
Dialogue: 0,0:21:03.75,0:21:07.42,Main,Chopper,0,0,0,,Ne?! Yanardağ mı?! Denizin dibi korkunç!
Dialogue: 0,0:21:07.42,0:21:12.22,Main,Usopp,0,0,0,,Ama Grand Line'daki akıntıların hepsinin dağınık olduğunu düşünmüştüm.
Dialogue: 0,0:21:12.22,0:21:14.76,Main,Usopp,0,0,0,,Bize gerçekten sorun çıkarmayacak bir akıntı var mı ki?
Dialogue: 0,0:21:15.24,0:21:16.76,Main,Nami,0,0,0,,Sadece bir tane var.
Dialogue: 0,0:21:16.76,0:21:21.83,Main,Nami,0,0,0,,Millet! Buradan sonra hava soğuyacak o yüzden montlarınızı giyseniz iyi olur.
Dialogue: 0,0:21:21.83,0:21:25.98,Main,Brook,0,0,0,,Gerçekten, derimdeki tüyler diken diken olmaya başladı.
Dialogue: 0,0:21:25.98,0:21:27.65,Main,Brook,0,0,0,,Ah! Ama benim{\fscx250}-{\r}
Dialogue: 0,0:21:27.65,0:21:30.41,Main,Chopper,0,0,0,,Sadece kemiksin, o yüzden derin yok, değil mi?
Dialogue: 0,0:21:32.14,0:21:35.26,Main,Zoro,0,0,0,,Soğuk bir yere mi gidiyoruz?\NDenizin dibine gitmiyor muyduk?
Dialogue: 0,0:21:35.26,0:21:38.82,Main,Franky,0,0,0,,Denizin dibindeki sular tabii ki soğuk.
Dialogue: 0,0:21:38.82,0:21:42.40,Main,Franky,0,0,0,,Küvette bile, su yukarıda daha sıcak ve dipte daha soğuk, değil mi?
Dialogue: 0,0:21:42.40,0:21:48.11,Main,Usopp,0,0,0,,Doğru. Eğer denizde de aynıysa, derinlerdeki sular yüzeydeki sulardan daha soğuktur.
Dialogue: 0,0:21:48.11,0:21:51.13,Main,Brook,0,0,0,,Farklı olan tek şey sıcaklık değil...
Dialogue: 0,0:21:51.98,0:21:54.12,Main,Usopp,0,0,0,,Daha ne kadar öyle kalacaksın?!
Dialogue: 0,0:21:54.12,0:21:55.60,Main,Brook,0,0,0,,Okyanusun derinliklerinde,
Dialogue: 0,0:21:56.12,0:22:02.89,Main,Brook,0,0,0,,"derinlik akıntıları" olarak bilinen genellikle göremeyeceğin devasa akıntılar vardır.
Dialogue: 0,0:22:02.89,0:22:07.94,Main,Brook,0,0,0,,Şimdiye kadar üstlerinde gittiğimiz yüzey akıntılarından tamamen farklılar.
Dialogue: 0,0:22:07.94,0:22:10.96,Main,Usopp,0,0,0,,Akıntıların altında akıntılar mı var?
Dialogue: 0,0:22:10.96,0:22:12.76,Main,Usopp,0,0,0,,Harbi bilgilisin he!
Dialogue: 0,0:22:14.30,0:22:15.85,Main,Brook,0,0,0,,Sadece uzun süre yaşadığım için!
Dialogue: 0,0:22:16.17,0:22:19.71,Main,Franky,0,0,0,,Akıntıların hepsi eninde sonunda bir yerde birleşir.
Dialogue: 0,0:22:19.71,0:22:22.90,Main,Franky,0,0,0,,Doğudan veya batıdan akmaya başlayıp sonra da buluşurlar...
Dialogue: 0,0:22:22.90,0:22:26.02,Main,Franky,0,0,0,,Aşağı doğru dalarlar ve yukarıya doğru yükselirler.
Dialogue: 0,0:22:26.02,0:22:28.73,Main,Franky,0,0,0,,Tıpkı devasa bir ejderha gibi.
Dialogue: 0,0:22:28.73,0:22:33.18,Main,Brook,0,0,0,,Derinlik akıntıları gerçekten de yavaş aktığı için,
Dialogue: 0,0:22:33.18,0:22:35.81,Main,Brook,0,0,0,,eğer su bir kere denizin dibine inerse,
Dialogue: 0,0:22:35.81,0:22:41.97,Main,Brook,0,0,0,,tekrar güneşi görebileceği bir seviyeye geri dönmesinin 2,000 yılı alabileceği söylenir.
Dialogue: 0,0:22:41.97,0:22:43.58,Main,Trio,0,0,0,,{\i1}2,000 yıl mı?!
Dialogue: 0,0:22:43.58,0:22:49.20,Main,Brook,0,0,0,,Evet. Dahası, bilinmeyen kapkaranlık deniz akıntıları hakkında...
Dialogue: 0,0:22:49.20,0:22:52.81,Main,Brook,0,0,0,,sayılamayacak kadar efsane vardır.
Dialogue: 0,0:22:52.81,0:22:57.96,Main,Brook,0,0,0,,Canavarlar, lanetler ve lanetlenmişlerin ruhları!
Dialogue: 0,0:22:57.96,0:23:01.07,Main,Chopper,0,0,0,,{\i1}Neeeee?! Derinliklerde hayaletler mi var?!
Dialogue: 0,0:23:01.07,0:23:03.32,Main,Brook,0,0,0,,{\i1}Ne?! Var mı?! Korkunç!
Dialogue: 0,0:23:03.32,0:23:04.63,Main,Luffy,0,0,0,,Çok heyecanlandım!
Dialogue: 0,0:23:04.63,0:23:06.71,Main,Nami,0,0,0,,Hayaletler mi?
Dialogue: 0,0:23:06.71,0:23:08.36,Main,Nami,0,0,0,,O kadarını bilmiyorum ama...
Dialogue: 0,0:23:08.36,0:23:13.84,Main,Nami,0,0,0,,yüzey akıntılarından derinlik akıntılara inebilmek için aşağı akıntıyı kullanacağız.
Dialogue: 0,0:23:13.84,0:23:17.94,Main,Nami,0,0,0,,Bunu yaparsak, denizin dibine ulaşmayı başarabiliriz.
Dialogue: 0,0:23:18.43,0:23:21.57,Main,Four,0,0,0,,Gizemli bir deniz akıntısı demek.
Dialogue: 0,0:23:21.57,0:23:24.20,Main,Nami,0,0,0,,{\i1}Anlattıklarımın hiçbirini anlamadınız, değil mi?!
Dialogue: 0,0:23:24.20,0:23:25.89,Main,Brook,0,0,0,,Şarkı mı söylesek, Nami-san?
Dialogue: 0,0:23:25.89,0:23:27.64,Main,Robin,0,0,0,,Nami, görüyorum!
Dialogue: 0,0:23:27.64,0:23:28.66,Main,Nami,0,0,0,,Gerçekten mi?
Dialogue: 0,0:23:28.66,0:23:30.56,Main,Luffy,0,0,0,,Gizemli deniz akıntısı mı?!
Dialogue: 0,0:23:32.36,0:23:33.40,Main,Sanji,0,0,0,,O da ne?
Dialogue: 0,0:23:33.40,0:23:35.63,Main,Nami,0,0,0,,Aşağı akıntı, Plume!
Dialogue: 0,0:23:36.96,0:23:39.88,Main,Luffy,0,0,0,,Harika!
Dialogue: 0,0:23:39.88,0:23:43.02,Main,Usopp,0,0,0,,Bu tıpkı devasa bir...
Dialogue: 0,0:23:45.22,0:23:48.02,Main,Usopp,0,0,0,,su altı şelalesi gibi!
Dialogue: 0,0:23:51.31,0:23:55.93,Main,Luffy,0,0,0,,Çok havalı!\NSu sonuna kadar dibe doğru akmaya devam ediyor!
Dialogue: 0,0:23:56.00,0:23:58.48,Main,Luffy,0,0,0,,Bu inanılmaz bir hız!
Dialogue: 0,0:23:59.39,0:24:01.39,Main,Franky,0,0,0,,Çok etkileyicisin, doğa!
Dialogue: 0,0:24:01.39,0:24:06.43,Main,Robin,0,0,0,,Ne devasa bir akıntı!\NKaç yüz metre boyunca devam ediyor acaba?
Dialogue: 0,0:24:06.71,0:24:11.10,Main,Brook,0,0,0,,Kendi gözlerinle görmek hikayelerde duymaktan tamamen farklı!
Dialogue: 0,0:24:11.44,0:24:15.31,Main,Usopp,0,0,0,,{\i1}Dibi göremiyorum! Aşağısı kapkaranlık!
Dialogue: 0,0:24:15.31,0:24:17.12,Main,Usopp,0,0,0,,{\i1}Her şey bitti!
Dialogue: 0,0:24:17.12,0:24:21.95,Main,Usopp,0,0,0,,{\i1}Eğer bu hızla aşağıya düşersek, denizin dibine çarparız. Öleceğiz!
Dialogue: 0,0:24:21.95,0:24:25.36,Main,Nami,0,0,0,,İyi olacağımıza emin misin, bu akıntının üstünde?
Dialogue: 0,0:24:25.36,0:24:27.47,Main,Franky,0,0,0,,Gemi için endişelenmeyin.
Dialogue: 0,0:24:27.47,0:24:32.27,Main,Franky,0,0,0,,Sunny, Hazine Ağaç Adam'dan yapılmış, \Nvar olan en güçlü gemi.
Dialogue: 0,0:24:32.27,0:24:33.69,Main,Luffy,0,0,0,,{\i1}Tamamdır!
Dialogue: 0,0:24:34.84,0:24:36.15,Main,Luffy,0,0,0,,{\i1}İleri!
Dialogue: 0,0:24:37.98,0:24:39.36,Main,Caribou,0,0,0,,Olamaz!
Dialogue: 0,0:24:39.36,0:24:44.52,Main,Caribou,0,0,0,,O {\i1}şeyin{\i0} burada yaşadığını hiç duymamıştım!
Dialogue: 0,0:24:44.52,0:24:48.07,Main,Caribou,0,0,0,,Denizler arasında gezen şeytan.
Dialogue: 0,0:24:48.07,0:24:50.88,Main,Caribou,0,0,0,,İnsanlığın düşmanı!
Dialogue: 0,0:24:50.88,0:24:54.71,Main,Caribou,0,0,0,,Hasır Şapka Tayfası! Hemen geri dönün!
Dialogue: 0,0:24:54.71,0:24:56.46,Main,Caribou,0,0,0,,Başımız belada!
Dialogue: 0,0:24:56.46,0:24:58.35,Main,Zoro,0,0,0,,Evet, sen de buradaydın.
Dialogue: 0,0:24:58.35,0:25:00.04,Main,Caribou,0,0,0,,Bir canavar var!
Dialogue: 0,0:25:05.02,0:25:07.93,Main,Usopp,0,0,0,,{\i1}Bu Kraken!
Dialogue: 0,0:25:09.22,0:25:11.59,Main,Usopp,0,0,0,,{\i1}Ne akılalmaz büyüklükte bir yaratık!
Dialogue: 0,0:25:12.16,0:25:14.99,Main,Franky,0,0,0,,Aynı anda birçok gemiyi eziyor.
Dialogue: 0,0:25:15.49,0:25:18.37,Main,Franky,0,0,0,,Buradan geçen gemileri avlıyormuş.
Dialogue: 0,0:25:18.37,0:25:21.64,Main,Caribou,0,0,0,,Yalvarırım! Ölmek istemiyorum!
Dialogue: 0,0:25:21.64,0:25:26.46,Main,Caribou,0,0,0,,Geri dönün! Sadece birkaç gün beklersek, eminim o canavar{\fscx250}-{\r}
Dialogue: 0,0:25:26.46,0:25:28.48,Main,Luffy,0,0,0,,Kapa çeneni! Sessiz ol!
Dialogue: 0,0:25:29.31,0:25:31.92,Main,Luffy,0,0,0,,Aklıma çok iyi bir fikir geldi!
Dialogue: 0,0:25:32.70,0:25:34.68,Main,Luffy,0,0,0,,Hadi onu eğitelim!
Dialogue: 0,0:25:35.69,0:25:37.16,Main,Straw Hats,0,0,0,,Ha?
Dialogue: 0,0:25:37.16,0:25:39.52,Main,Usopp,0,0,0,,{\i1}Sen neyden bahsediyorsun, Luffy?!
Dialogue: 0,0:25:39.52,0:25:42.48,Main,Luffy,0,0,0,,O ahtapotu eğitip gemimizi çekmesini sağlayacağız!
Dialogue: 0,0:25:42.48,0:25:44.83,Main,Usopp,0,0,0,,{\i1}Saçmasapan konuşma!
Dialogue: 0,0:25:44.83,0:25:49.80,Main,Usopp,0,0,0,,Şuna iyice bir bak, hayır, iyice bakmana bile gerek yok, o şeyin ne kadar devasa olduğunu göremiyor musun?!
Dialogue: 0,0:25:49.80,0:25:52.20,Main,Luffy,0,0,0,,Ah, gerçekten de büyük...
Dialogue: 0,0:25:52.65,0:25:58.30,Main,Usopp,0,0,0,,Kaç yüzyıldır yaşıyor bilmiyorum ama, Kraken sayısız efsanede adı geçen,
Dialogue: 0,0:25:58.30,0:26:01.24,Main,Usopp,0,0,0,,efsanevi bir yaratık!
