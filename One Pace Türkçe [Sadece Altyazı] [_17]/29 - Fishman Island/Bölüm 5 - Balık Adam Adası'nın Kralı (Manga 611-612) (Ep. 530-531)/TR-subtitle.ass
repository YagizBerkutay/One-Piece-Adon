10,10,15,1Style: Author,Impress BT,22.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.7,0.7,9,10,10,10,1Style: Attack,Duality,32.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.0,1.0,7,12,12,12,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:02.99,0:00:08.38,Main,,0,0,0,,Dünyanın sunabileceği her şeyi elde eden adam, Korsanlar Kralı Gold Roger.Dialogue: 0,0:00:08.38,0:00:13.00,Main,,0,0,0,,Son sözleri dünyanın her yerinden maceracıları denize çekti.Dialogue: 0,0:00:13.00,0:00:14.68,Main,,0,0,0,,"Hazinem mi?"Dialogue: 0,0:00:14.68,0:00:16.22,Main,,0,0,0,,"İstiyorsanız, size vereceğim!"Dialogue: 0,0:00:16.22,0:00:17.42,Main,,0,0,0,,"Arayın ve bulun!"Dialogue: 0,0:00:17.42,0:00:19.87,Main,,0,0,0,,"Bu dünyanın sunabileceği her şeyi orada bıraktım!"Dialogue: 0,0:00:19.87,0:00:22.69,Main,,0,0,0,,Korsanlar hayallerinin peşinden yola çıktılar!Dialogue: 0,0:00:22.69,0:00:25.35,Main,,0,0,0,,Dünya, Büyük Korsan Çağı'na girdi!Dialogue: 0,0:00:25.35,0:00:29.31,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪Dialogue: 0,0:00:29.31,0:00:33.81,We Go lyrics,,0,0,0,,♪ Şafak vakti gelmedi bile ve ben bekleyemiyorum! ♪Dialogue: 0,0:00:33.81,0:00:37.48,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı, dört... Gidelim! ♪Dialogue: 0,0:00:38.97,0:00:43.05,We Go lyrics,,0,0,0,,♪ Bayrağımızı dalgalandıralım, macera şafağının doğuşuna. ♪Dialogue: 0,0:00:44.41,0:00:49.74,We Go lyrics,,0,0,0,,♪ Dalgalar yapalım, bizi uykumuzdan kaldırsınlar. ♪Dialogue: 0,0:00:49.74,0:00:54.28,We Go lyrics,,0,0,0,,♪ Eğer inanılmaz bir dünyaya gitmek istiyorsan,Dialogue: 0,0:00:54.28,0:00:58.79,We Go lyrics,,0,0,0,, gerekli olan şey senin dayanıklılığın. ♪Dialogue: 0,0:00:59.11,0:01:01.73,We Go lyrics,,0,0,0,,♪ Fazla dikkat çekmek, bu bir suç mu? ♪Dialogue: 0,0:01:01.73,0:01:04.62,We Go lyrics,,0,0,0,,♪ Aranıyor → Kazanan demektir! ♪Dialogue: 0,0:01:04.62,0:01:10.50,We Go lyrics,,0,0,0,,♪ Özgür olmak bizim tek kuralımız! ♪Dialogue: 0,0:01:10.50,0:01:15.99,We Go lyrics,,0,0,0,,♪ Endişelerinizi unutun, bırakın rüzgar essin. ♪Dialogue: 0,0:01:15.99,0:01:18.53,We Go lyrics,,0,0,0,,♪ Ne pahasına olursa olsun, One Piece'i ilk biz bulacağız! ♪Dialogue: 0,0:01:18.53,0:01:22.66,We Go lyrics,,0,0,0,,♪ Hayal kuran kalplerimiz, çok büyük... ♪Dialogue: 0,0:01:22.66,0:01:26.93,We Go lyrics,,0,0,0,,♪ Onları uyandırmamak önemli. ♪Dialogue: 0,0:01:26.93,0:01:29.57,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪Dialogue: 0,0:01:29.57,0:01:33.54,We Go lyrics,,0,0,0,,♪ Şafak vakti gelmedi bile ve ben bekleyemiyorum! ♪Dialogue: 0,0:01:33.54,0:01:37.33,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı, dört... Gidelim! ♪Dialogue: 0,0:01:38.76,0:01:44.72,We Go lyrics,,0,0,0,,♪ Biz... buralara kadar geldik. ♪Dialogue: 0,0:01:44.72,0:01:47.62,We Go lyrics,,0,0,0,,♪ Gideceğiz... hayallerimizin olduğu yere,Dialogue: 0,0:01:47.62,0:01:52.70,We Go lyrics,,0,0,0,, ve kimseyi arkada bırakmayacağız. ♪Dialogue: 0,0:01:52.70,0:01:55.30,We Go lyrics,,0,0,0,,♪ Hep devam edeceğiz, bu bir söz. ♪Dialogue: 0,0:01:55.30,0:01:59.47,We Go lyrics,,0,0,0,,♪ Hayallerimizin başladığı o günden beri,Dialogue: 0,0:01:59.47,0:02:03.72,We Go lyrics,,0,0,0,, belirlediğimiz gelecek, değişmedi! ♪Dialogue: 0,0:02:03.72,0:02:06.24,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪Dialogue: 0,0:02:06.24,0:02:10.61,We Go lyrics,,0,0,0,,♪ Kalbimdeki güneş, asla batmayacak! ♪Dialogue: 0,0:02:10.61,0:02:13.38,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... ♪Dialogue: 0,0:02:14.78,0:02:17.57,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... ♪Dialogue: 0,0:02:18.75,0:02:24.82,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... dört... Gidelim! ♪Dialogue: 0,0:02:27.27,0:02:30.04,We Go lyrics,,0,0,0,,♪ Gidelim! ♪Dialogue: 0,0:02:30.03,0:02:39.04,Title,,0,0,0,,Balık Adam Adası'nın KralıDialogue: 0,0:02:39.75,0:02:42.46,Main,Gyro,0,0,0,,Sessiz... Sessiz olun!Dialogue: 0,0:02:42.83,0:02:45.68,Main,Gyro,0,0,0,,İşte şansımız! Acele edin ve gemiye binin!Dialogue: 0,0:02:45.90,0:02:48.25,Main,Gyro,0,0,0,,Herkes bir kürek alıp gitmeye hazırlansın!Dialogue: 0,0:02:52.93,0:02:55.67,Captions,Sign,0,0,180,,Balık Adam Bölgesi   "Noah"Dialogue: 0,0:02:57.56,0:02:58.93,Main,Pirate,0,0,0,,Acele edin! Acele edin!Dialogue: 0,0:02:58.93,0:03:00.69,Main,Pirate,0,0,0,,Her an peşimizden gelebilirler!Dialogue: 0,0:03:00.69,0:03:03.36,Main,Gyro,0,0,0,,Artık Balık Adam Adası'nda kalamayız.Dialogue: 0,0:03:03.36,0:03:04.91,Main,Gyro,0,0,0,,Hemen Red Line'ı geçmeliyiz!Dialogue: 0,0:03:04.91,0:03:08.18,Main,Pirate,0,0,0,,Kahretsin!  Denizkızı Kafe'yi görmeyi çok istiyordum!Dialogue: 0,0:03:08.18,0:03:12.37,Main,Gyro,0,0,0,,Bundan vazgeçin aptallar!  Şimdi konuşmayı bırakın ve çekin!Dialogue: 0,0:03:12.37,0:03:15.20,Main,Gyro,0,0,0,,Gerçekten... Buna inanamıyorum!Dialogue: 0,0:03:15.56,0:03:20.10,Main,Gyro,0,0,0,,Kraken deniz tabanında uyuyordu, o yüzden onu geçebildik...Dialogue: 0,0:03:20.31,0:03:22.55,Main,Gyro,0,0,4,,ve 10 kilometre aşağıya vardık.Dialogue: 0,0:03:20.63,0:03:27.12,Captions,Sign,0,0,240,,Güney Mavili Korsan  Yengeç-El GyroDialogue: 0,0:03:20.73,0:03:27.12,Captions,Sign,0,0,240,,Ödül: 73,000,000 Beli.Dialogue: 0,0:03:22.55,0:03:25.40,Main,Gyro,0,0,4,,Sonra o deniz canavarları tarafından çevrildik...Dialogue: 0,0:03:25.40,0:03:27.12,Main,Gyro,0,0,4,,ve karşı koyamadık da!Dialogue: 0,0:03:27.40,0:03:31.62,Main,Gyro,0,0,0,,Balık adamlara katıl ya da öl mü?!Dialogue: 0,0:03:31.62,0:03:35.44,Main,Gyro,0,0,0,,O zaman, onlara katılmaktan başka çaremiz yoktu!Dialogue: 0,0:03:36.56,0:03:38.96,Main,Pirate,0,0,0,,Denizkızı Kafe'den daha da uzaklaşıyoruz.Dialogue: 0,0:03:40.71,0:03:42.81,Main,Gyro,0,0,0,,Ağlamayı bırakın da gidelim beyler!Dialogue: 0,0:03:42.81,0:03:45.52,Main,Gyro,0,0,0,,Eğer hayatta kaçabilirsek bile şanslıyız!Dialogue: 0,0:03:46.70,0:03:49.26,Main,Hody,0,0,0,,Ha? Kaçtılar mı?Dialogue: 0,0:03:49.67,0:03:51.24,Main,Fishman,0,0,0,,Evet, Patron.Dialogue: 0,0:03:51.24,0:03:55.58,Main,Dosun,0,0,0,,Yani tekrar mı kaçtılar-dosun? Hiç ders almıyorlar değil mi-dosun?Dialogue: 0,0:03:51.66,0:03:55.58,Captions,Character Box,0,0,220,,Yeni Balık Adam Korsanları'nın Üyesi  Dosun (Çekiç Başlı Köpek Balığı Balık Adamı)Dialogue: 0,0:03:56.19,0:03:59.45,Captions,Character Box,0,0,220,,Yeni Balık Adam Korsanları'nın Üyesi  Zeo (Halı Köpek Balığı Balık Adamı)Dialogue: 0,0:03:57.29,0:03:59.45,Main,Zeo,0,0,0,,İnsanlar her seferinde kaçıyor.Dialogue: 0,0:03:59.50,0:04:03.42,Main,Daruma,0,0,0,,Onları parçalara ayırmalı mıyım?Dialogue: 0,0:03:59.72,0:04:03.42,Captions,Character Box,0,0,220,,Yeni Balık Adam Korsanları'nın Üyesi  Daruma (Çörek-kapan Köpek Balığı Balık Adamı)Dialogue: 0,0:04:06.32,0:04:07.56,Main,Hody,0,0,0,,Sıkıntı yok.Dialogue: 0,0:04:09.26,0:04:12.40,Main,Hody,0,0,4,,Onları diğerlerine örnek olsun diye kullanabiliriz.Dialogue: 0,0:04:09.73,0:04:13.43,Captions,Character Box,0,0,240,,Yeni Balık Adam Korsanları'nın Kaptanı   Hody JonesDialogue: 0,0:04:09.81,0:04:13.43,Captions,,0,0,0,,Büyük Beyaz  Köpek Balığı Balık AdamıDialogue: 0,0:04:13.68,0:04:17.95,Captions,Character Box,0,0,220,,Yeni Balık Adam Korsanları'nın Üyesi   Ikaros Much (Dev Kalamar Balık Adamı)Dialogue: 0,0:04:14.93,0:04:17.85,Main,Ikaros,0,0,0,,Bu durumda, ben gidebilir miyim-hi?Dialogue: 0,0:04:17.85,0:04:20.23,Main,Hody,0,0,0,,Gerek yok, Ikaros.Dialogue: 0,0:04:20.23,0:04:22.27,Main,Ikaros,0,0,0,,Muhi, anlaşıldı.Dialogue: 0,0:04:22.27,0:04:23.57,Main,Hody,0,0,0,,Kendim gideceğim.Dialogue: 0,0:04:23.57,0:04:24.23,Main,Daruma,0,0,0,,Ne?!Dialogue: 0,0:04:24.68,0:04:26.60,Main,Hody,0,0,0,,Baloncuğu hazırlayın.Dialogue: 0,0:04:35.94,0:04:39.36,Main,Daruma,0,0,0,,Tek seferde o kadar fazla güç hapı alamazsın!Dialogue: 0,0:04:59.90,0:05:01.77,Main,Pappagg,0,0,0,,Tamamdır, geldik!Dialogue: 0,0:05:02.17,0:05:03.92,Main,Pappagg,0,0,0,,Burası benim evim!Dialogue: 0,0:05:03.92,0:05:06.69,Main,Luffy,0,0,0,,Kocaman!Dialogue: 0,0:05:06.69,0:05:10.31,Main,Peoplez,0,0,0,,Hoşgeldiniz, Efendim!Dialogue: 0,0:05:10.31,0:05:12.50,Main,Mermaid,0,0,0,,Ah! Bu Mösyo Pappag!Dialogue: 0,0:05:12.50,0:05:14.39,Main,Mermaid,0,0,0,,Harika! Gerçekten o mu?Dialogue: 0,0:05:17.28,0:05:19.72,Main,Pappagg,0,0,0,,Evet, eminim şu anda çok şaşkınsınızdır!Dialogue: 0,0:05:19.98,0:05:24.98,Main,Pappagg,0,0,0,,Denizin ortasında, ben havalı bir denizyıldızından başka bir şey değilim.Dialogue: 0,0:05:25.61,0:05:28.61,Main,Pappagg,0,0,0,,Ama Balık Adam Adası'nda, giyim markası Criminal'ın başkanıyım.Dialogue: 0,0:05:29.17,0:05:32.80,Main,Pappagg,0,0,0,,Süper popüler bir ünlü tasarımcı!Dialogue: 0,0:05:33.50,0:05:36.83,Main,Pappagg,0,0,0,,Markam dünya çapında bilinir,Dialogue: 0,0:05:36.83,0:05:39.95,Main,Pappagg,0,0,0,,ve her ülkenin dükkanlarında satılır! Dialogue: 0,0:05:39.96,0:05:41.42,Main,Pappagg,0,0,0,,Çok ünlü Doskoi Panda bile-Dialogue: 0,0:05:41.42,0:05:44.20,Main,Luffy,0,0,0,,Ah, oraya bakın! O da ne?Dialogue: 0,0:05:44.20,0:05:46.33,Main,Caimie,0,0,0,,İlk kattaki bir Criminal Mağazası.Dialogue: 0,0:05:46.33,0:05:49.61,Main,Luffy,0,0,0,,Öyle mi? Gidip bir bakalım!Dialogue: 0,0:05:46.99,0:05:48.45,Secondary,Pappagg,0,0,0,,Camie... Camie...Dialogue: 0,0:05:49.61,0:05:50.37,Main,Caimie,0,0,0,,Tabii ki!Dialogue: 0,0:05:51.12,0:05:52.66,Main,Pappagg,0,0,0,,Hey!Dialogue: 0,0:05:52.66,0:05:55.66,Main,Pappagg,0,0,0,,Dediklerimi... dinleyin...Dialogue: 0,0:05:57.33,0:06:00.42,Secondary,Store-Man,0,0,0,,Bekleyin, sayın müşterimiz, bu hiç makul değil!Dialogue: 0,0:06:00.42,0:06:03.66,Secondary,Store-Man,0,0,0,,Yüksek sınıf bir marka satıyoruz biz burada.Dialogue: 0,0:06:00.80,0:06:01.76,Main,Luffy,0,0,0,,Ne oluyor?Dialogue: 0,0:06:01.76,0:06:03.93,Main,Caimie,0,0,0,,Mağaza sahibi sorun yaşıyor gibi duruyor.Dialogue: 0,0:06:03.93,0:06:05.05,Main,Caimie,0,0,0,,Şikayet mi acaba?Dialogue: 0,0:06:05.05,0:06:09.64,Main,Nami,0,0,0,,Dediğim gibi, bu dükkan çok pahalı!  Giysiler tatlı gerçi.Dialogue: 0,0:06:09.64,0:06:10.80,Main,Usopp,0,0,0,,O ses yoksa...Dialogue: 0,0:06:11.24,0:06:13.55,Main,Nami,0,0,0,,Peki, fiyatı 10,000 Beli'ye düşür o zaman.Dialogue: 0,0:06:13.66,0:06:18.00,Main,Store-Man,0,0,0,,Bunu yapamam, sayın müşterimiz! Bu orijinal fiyatın yarısı!Dialogue: 0,0:06:18.16,0:06:21.13,Main,Usopp,0,0,0,,Şikayetçinin o olduğunu biliyordum.Dialogue: 0,0:06:21.13,0:06:23.84,Main,Luffy,0,0,0,,Hey, Nami!Dialogue: 0,0:06:23.84,0:06:24.63,Main,Nami,0,0,0,,Luffy!Dialogue: 0,0:06:24.63,0:06:25.63,Main,Caimie,0,0,0,,Nami-chin!Dialogue: 0,0:06:26.70,0:06:27.97,Main,Nami,0,0,0,,Camie!Dialogue: 0,0:06:27.97,0:06:30.95,Main,Store-Man,0,0,0,,Ah, Mösyö Pappag, mükemmel zamanlama.Dialogue: 0,0:06:31.25,0:06:33.56,Main,Store-Man,0,0,0,,Burada biraz zorlu bir müşterimiz var...Dialogue: 0,0:06:33.56,0:06:34.27,Main,Nami,0,0,0,,Dialogue: 0,0:06:34.52,0:06:37.52,Main,Nami,0,0,0,,Bekle, burası senin dükkanın mı demek oluyor bu?Dialogue: 0,0:06:37.62,0:06:40.04,Main,Nami,0,0,0,,Bu fiyatlar da ne? Beni soymaya mı çalışıyorsun?!Dialogue: 0,0:06:40.04,0:06:41.55,Main,Store-Man,0,0,0,,Mösyö!Dialogue: 0,0:06:41.55,0:06:45.80,Main,Pappagg,0,0,0,,Şey, markam pahalı. Ben ünlü bir tasarımcıyım sonuçta...Dialogue: 0,0:06:45.80,0:06:46.97,Main,Nami,0,0,0,,İndirim yap!Dialogue: 0,0:06:46.97,0:06:48.09,Main,Pappagg,0,0,0,,Hayır, bekle!Dialogue: 0,0:06:49.99,0:06:51.72,Main,Pappagg,0,0,0,,Bu kadar saldırgan olma!Dialogue: 0,0:06:51.81,0:06:55.36,Main,Pappagg,0,0,0,,Sizlere iki yıl öncesinden çok şey borçluyum!Dialogue: 0,0:06:55.36,0:06:58.68,Main,Pappagg,0,0,0,,Her şey bedava! İstediğinizi alın!Dialogue: 0,0:06:59.03,0:07:01.92,Main,Nami,0,0,0,,Bedava mı? Gerçekten mi?!Dialogue: 0,0:07:02.30,0:07:04.90,Main,Store-Man,0,0,0,,Mösyo! Tüm dükkanı boşalttılar!Dialogue: 0,0:07:04.90,0:07:07.04,Main,Pappagg,0,0,0,,Cidden istediğinizi almışsınız!Dialogue: 0,0:07:07.16,0:07:09.49,Main,Caimie,0,0,0,,Sizin adınıza sevindim millet.Dialogue: 0,0:07:10.41,0:07:12.42,Main,Brook,0,0,0,,Bu da ne acaba?Dialogue: 0,0:07:12.42,0:07:14.41,Main,Brook,0,0,0,,Dışarıdan çok fazla ses geliyor.Dialogue: 0,0:07:14.54,0:07:17.10,Main,Store-Man,0,0,0,,Mösyö! Büyük bir olay var!Dialogue: 0,0:07:17.10,0:07:18.72,Main,Pappagg,0,0,0,,Ne oldu?Dialogue: 0,0:07:19.00,0:07:21.05,Main,Store-Man,0,0,0,,O-O adam..!Dialogue: 0,0:07:22.90,0:07:24.12,Main,Fishman,0,0,0,,O-O adam...Dialogue: 0,0:07:24.32,0:07:25.59,Main,Fishman,0,0,0,,O adam...Dialogue: 0,0:07:26.19,0:07:29.09,Main,Store-Man,0,0,0,,Gökyüzüne bakın lütfen!Dialogue: 0,0:07:29.09,0:07:31.76,Main,Store-Man,0,0,0,,O adam kraliyet sarayından..!Dialogue: 0,0:07:32.87,0:07:37.74,Main,Neptune,0,0,0,,Jamon! Jamon!Dialogue: 0,0:07:35.27,0:07:37.74,Main,Luffy,0,0,0,,O da ne? Balina mı?Dialogue: 0,0:07:39.32,0:07:41.40,Main,Pappagg,0,0,0,,O adam neden burada?Dialogue: 0,0:07:42.30,0:07:44.68,Main,Caimie,0,0,0,,Onu ilk kez görüyorum!Dialogue: 0,0:07:45.22,0:07:48.31,Main,Fishman,0,0,0,,Neler oluyor? Yanında muhafız bile yok!Dialogue: 0,0:07:48.31,0:07:53.18,Main,Fishman,0,0,0,,Bir tür ulusal kriz olması lazım! Öyle olmasa, buralara kadarDialogue: 0,0:07:53.18,0:07:55.72,Main,Fishman,0,0,0,,neden kendisi gelsin?!Dialogue: 0,0:08:02.68,0:08:07.17,Captions,Character Box,0,0,240,,Ryugu Krallığı'nın Kralı  Deniz Tanrısı NeptuneDialogue: 0,0:08:02.68,0:08:07.17,Captions,,0,0,0,,Kolekant Deniz AdamıDialogue: 0,0:08:04.10,0:08:07.17,Main,Neptune,0,0,4,,Neptune.Dialogue: 0,0:08:07.25,0:08:10.20,Captions,,0,0,250,,Hoe   (Onun Sevgili Balinası)Dialogue: 0,0:08:10.20,0:08:12.90,Main,Usopp,0,0,0,,Ne dev bir deniz adamı!Dialogue: 0,0:08:12.90,0:08:15.37,Main,Brook,0,0,0,,Denizkızlarını fazlasıyla tercih ederim.Dialogue: 0,0:08:15.37,0:08:16.65,Main,Pappagg,0,0,0,,Hey, beyler!Dialogue: 0,0:08:16.65,0:08:19.68,Main,Luffy,0,0,0,,Ne kaba sakallı bir amca!Dialogue: 0,0:08:19.68,0:08:21.64,Main,Pappagg,0,0,0,,Kaba davranıyorsunuz!Dialogue: 0,0:08:21.64,0:08:23.59,Main,Pappagg,0,0,0,,Hemen diz çökün!Dialogue: 0,0:08:23.59,0:08:25.08,Main,Nami,0,0,0,,Balina çok sevimli!Dialogue: 0,0:08:25.08,0:08:27.25,Main,Fishman,0,0,0,,O insanlarla bir işi mi var? Dialogue: 0,0:08:27.25,0:08:32.16,Main,Neptune,0,0,0,,Hey, Megalo. Bu insanlar olduklarına eminsin değil mi-jamon?Dialogue: 0,0:08:33.32,0:08:37.50,Main,Nami,0,0,0,,Ha? Buraya gelirken yolda o köpek balığıyla karşılaşmadık mı?Dialogue: 0,0:08:37.50,0:08:40.50,Main,Neptune,0,0,0,,Hey, hasır şapkalı insan ve arkadaşları.Dialogue: 0,0:08:41.00,0:08:42.70,Main,Neptune,0,0,0,,Sizi...Dialogue: 0,0:08:43.16,0:08:45.74,Main,Neptune,0,0,0,,Ryugu Sarayı'na...Dialogue: 0,0:08:45.84,0:08:49.96,Main,Neptune,0,0,0,,götürmeye geldim-jamon!Dialogue: 0,0:08:49.96,0:08:51.70,Main,Caimie and Pappagg,0,0,0,,Neee?!Dialogue: 0,0:08:51.70,0:08:56.61,Main,Caimie and Pappagg,0,0,0,,R-R-R-R-R-Ryugu Sarayı mı?!Dialogue: 0,0:08:57.40,0:08:59.28,Main,Luffy,0,0,0,,Ryugu Sarayı mı?Dialogue: 0,0:09:00.10,0:09:04.72,Captions,,0,0,220,,Balık Adam Bölgesi "Noah"nın yakınları DerinliklerDialogue: 0,0:09:01.35,0:09:03.02,Main,Pirate,0,0,0,,Hadi, daha hızlı çekin!Dialogue: 0,0:09:03.02,0:09:04.72,Main,Gyro,0,0,0,,Yoksa bizi bulacaklar!Dialogue: 0,0:09:04.72,0:09:08.09,Main,Pirate,0,0,0,,Derin bir deniz akıntısına yakalandık! Bu çok zor!Dialogue: 0,0:09:08.44,0:09:11.20,Main,Gyro,0,0,0,,Bu yüzden gemiye yüklenmiş küreklerimiz var!Dialogue: 0,0:09:11.67,0:09:14.20,Main,Gyro,0,0,0,,Yeni Dünya'yı nasıl bir yer sanıyorsunuz?!Dialogue: 0,0:09:15.10,0:09:16.81,Main,Pirate,0,0,0,,Kaptan, bak!Dialogue: 0,0:09:17.07,0:09:19.21,Main,Pirate,0,0,0,,Önümüzde bir şey var!Dialogue: 0,0:09:21.40,0:09:23.84,Main,Gyro,0,0,0,,Hody Jones!Dialogue: 0,0:09:24.75,0:09:27.30,Main,Pirate,0,0,0,,O-Olamaz! Bizi buldu!Dialogue: 0,0:09:27.57,0:09:29.58,Main,Pirate,0,0,0,,Ne? O...Dialogue: 0,0:09:33.27,0:09:36.58,Main,Pirate,0,0,0,,O da ne? Kelepçe takıyor! Dialogue: 0,0:09:40.73,0:09:41.48,Main,Pirate,0,0,0,,Kayboldu!Dialogue: 0,0:09:42.31,0:09:44.23,Main,Pirate,0,0,0,,O pislik nereye kayboldu?!Dialogue: 0,0:09:54.00,0:09:55.50,Main,Pirate,0,0,0,,Geminin içine girdi!Dialogue: 0,0:09:56.13,0:09:59.04,Main,Gyro,0,0,0,,Durdurun onu! Sadece bir düşman var!Dialogue: 0,0:09:59.04,0:10:01.50,Main,Gyro,0,0,0,,Balık adamlarla dövüşmüşlüğüm var.Dialogue: 0,0:10:01.50,0:10:05.27,Main,Gyro,0,0,0,,Buraya gelene kadar kaç kere sınandım sanıyorsun?!Dialogue: 0,0:10:05.27,0:10:10.94,Main,Gyro,0,0,0,,Altı üstü bir balıksın! İnsanları küçümseme, aptal herif!Dialogue: 0,0:10:10.94,0:10:11.53,Main,Pirate,0,0,0,,Kaptan!Dialogue: 0,0:10:14.59,0:10:16.62,Main,Gyro,0,0,0,,Kahretsin!Dialogue: 0,0:10:29.19,0:10:33.36,Main,Ikaros,0,0,0,,Cidden, elimize çok fena bir şey geçti-hi.Dialogue: 0,0:10:34.19,0:10:37.27,Main,Ikaros,0,0,0,,Güç hapları... Enerji Steroidi.Dialogue: 0,0:10:37.57,0:10:41.95,Main,Zeo,0,0,0,,Bir balık adamın doğal gücü bir insanınkinin on katıdır.Dialogue: 0,0:10:42.79,0:10:48.42,Main,Zeo,0,0,0,,Ancak, bu Enerji Steroidi'nden bir tane aldığın takdirde ulaşacağın güç,Dialogue: 0,0:10:48.42,0:10:50.55,Main,Zeo,0,0,0,,bir insanın yirmi katı.Dialogue: 0,0:10:50.75,0:10:53.34,Main,Zeo,0,0,0,,İki tane almak tekrar katlar!Dialogue: 0,0:10:53.34,0:10:57.30,Main,Zeo,0,0,0,,Bu rüya gibi gücün ücreti yaşam süreni kısaltması.Dialogue: 0,0:10:57.30,0:11:02.22,Main,Zeo,0,0,0,,Ancak, davamızı ilerletmek pahasına erken ölümü kabul edeceğiz!Dialogue: 0,0:11:05.15,0:11:07.32,Main,Pirate,0,0,0,,N-Ne yapıyor o pislik?!Dialogue: 0,0:11:07.32,0:11:09.10,Main,Pirate,0,0,0,,Direk ile ne yapmayı planlıyor?!Dialogue: 0,0:11:11.03,0:11:13.20,Main,Pirate,0,0,0,,Anladım, o kelepçeler...Dialogue: 0,0:11:13.54,0:11:17.09,Main,Pirate,0,0,0,,Bizi batırmak için ellerine bile ihtiyacı olmadığı anlamına geliyor!Dialogue: 0,0:11:18.25,0:11:24.00,Main,Zeo,0,0,0,,İnsanlar tarafından alınan Fisher Tiger'ın hayatı! Ve Arlong'un iradesi!Dialogue: 0,0:11:24.07,0:11:27.99,Main,Zeo,0,0,0,,Balık Adam Adası'nın baskılanmış karanlık tarihi bu nesilde bitecek!Dialogue: 0,0:11:27.99,0:11:31.33,Main,Zeo,0,0,0,,Bunu biz, Yeni Balık Adam Korsanları yapacağız!Dialogue: 0,0:11:45.80,0:11:48.51,Main,Hody,0,0,0,,Yeni Dünya'ya yüzün.Dialogue: 0,0:11:52.62,0:11:56.83,Main,Fishman,0,0,0,,Amanın... Onların hepsini öldürmedin değil mi?Dialogue: 0,0:11:58.92,0:12:01.17,Main,Hody,0,0,0,,Hayatta kalmazlarsa sıkıntı olur.Dialogue: 0,0:12:02.05,0:12:06.90,Main,Hody,0,0,0,,O yaralar ile yaşayın ve yukarıdaki dünyaya gösterin...Dialogue: 0,0:12:07.72,0:12:11.77,Main,Hody,0,0,0,,denizin altında size neler olduğunu!Dialogue: 0,0:12:12.20,0:12:14.56,Main,Hody,0,0,0,,Kimlerle tanıştığınızı!Dialogue: 0,0:12:14.81,0:12:19.06,Main,Hody,0,0,0,,Kara toprağın üstündeki insanlara dehşetimizi anlatın!Dialogue: 0,0:12:19.06,0:12:22.46,Main,Hody,0,0,0,,Biz dünyanın merkezi, Balık Adam Adası'nı,Dialogue: 0,0:12:22.46,0:12:26.02,Main,Hody,0,0,0,,o acınası Deniz Tanrısı Neptune'dan alacağız,Dialogue: 0,0:12:26.02,0:12:31.36,Main,Hody,0,0,0,,ve siz insanları denizin karanlık derinliklerine çekeceğiz!Dialogue: 0,0:12:31.36,0:12:36.83,Main,Hody,0,0,0,,Siz hepinize balık adamların üstün tür olduğunu öğreteceğiz!Dialogue: 0,0:12:37.60,0:12:39.39,Narrator,Narrator,0,0,0,,Birkaç saat önce...Dialogue: 0,0:12:39.39,0:12:42.87,Narrator,Narrator,0,0,0,,Ryugu Krallığı, Denizkızı Körfezi. Dialogue: 0,0:12:42.87,0:12:45.94,Main,Ishilly,0,0,0,,Neden bu şey bu kadar sıkı kapatılmış.Dialogue: 0,0:12:48.01,0:12:50.10,Main,Mermaid,0,0,0,,İçinde ne var acaba?Dialogue: 0,0:12:50.10,0:12:52.56,Main,Ishilly,0,0,0,,Eğer hazine olsaydı bir tür sandık olurdu.Dialogue: 0,0:12:52.56,0:12:55.89,Main,Ishilly,0,0,0,,Bir varil olduğundan dolayı içinde kaliteli içki mi var acaba? Dialogue: 0,0:12:57.48,0:12:59.88,Main,Ishilly,0,0,0,,Cidden... çok... sert!Dialogue: 0,0:13:00.08,0:13:04.11,Main,Caribou,0,0,0,,Ah, yeterince açıldı.Dialogue: 0,0:13:06.55,0:13:12.69,Main,Caribou,0,0,0,,Bu kadar açılması yeter de artar bile!Dialogue: 0,0:13:12.79,0:13:15.74,Main,Mermaid,0,0,0,,Ne?! İçinde biri mi varmış?!Dialogue: 0,0:13:15.74,0:13:16.32,Main,Mermaid,0,0,0,,Olamaz!Dialogue: 0,0:13:24.43,0:13:27.35,Main,Caribou,0,0,0,,Çok teşekkürler!Dialogue: 0,0:13:28.56,0:13:32.87,Main,Caribou,0,0,0,,Size gerçekten minnettarım, denizkızları!Dialogue: 0,0:13:33.95,0:13:36.39,Main,Caribou,0,0,0,,Kaçmaya çalışmayın bakalım!Dialogue: 0,0:13:36.39,0:13:38.59,Main,Ishilly,0,0,0,,Çabuk! Suya girin!Dialogue: 0,0:13:42.79,0:13:45.01,Main,Caribou,0,0,0,,Bunun için çok geç!Dialogue: 0,0:13:50.35,0:13:52.54,Main,Mermaid,0,0,0,,Vücudum... batıyor...Dialogue: 0,0:13:52.54,0:13:54.65,Main,Mermaid,0,0,0,,Bir bataklık! Buraya nasıl geldi?! Dialogue: 0,0:13:54.87,0:13:58.39,Main,Caribou,0,0,0,,Bu bataklıktan kurtulamazsınız!Dialogue: 0,0:13:58.39,0:14:01.07,Main,Caribou,0,0,0,,Tamamen dipsizdir!Dialogue: 0,0:14:01.07,0:14:06.32,Main,Caribou,0,0,0,,Ben Şeytan Meyvesi kullanıcısıyım. Bataklık Bataklık meyvesini yemiş, bataklık adamım!Dialogue: 0,0:14:06.32,0:14:09.19,Main,Caribou,0,0,0,,Ne kadar uğraşırsanız...Dialogue: 0,0:14:10.18,0:14:10.86,Main,Ishilly,0,0,0,,Hayır!Dialogue: 0,0:14:10.86,0:14:13.94,Main,Caribou,0,0,0,,...o kadar hızlı batarsınız!Dialogue: 0,0:14:13.94,0:14:15.10,Main,Mermaid,0,0,0,,Yardım edin!Dialogue: 0,0:14:15.10,0:14:20.34,Main,Caribou,0,0,0,,Lütfen, bu kadar bağırmayın. Sizi öldürmeyeceğim.Dialogue: 0,0:14:20.51,0:14:22.15,Main,Ishilly,0,0,0,,Birisi-Dialogue: 0,0:14:22.15,0:14:27.55,Main,Caribou,0,0,0,,Daha az önce bağırmamanı söylemedim mi, aptal?!Dialogue: 0,0:14:27.55,0:14:28.70,Main,Mermaid,0,0,0,,Ishilly!Dialogue: 0,0:14:29.60,0:14:32.93,Main,Caribou,0,0,0,,Sadece kısa bir süre uykuya dalmanıza ihtiyacım var!Dialogue: 0,0:14:49.77,0:14:54.71,Main,Caribou,0,0,0,,Benim vücudum dipsizdir...Dialogue: 0,0:14:55.63,0:14:58.46,Main,Caribou,0,0,0,,Denizkızları için ne kadar ödüyorlardı acaba?Dialogue: 0,0:14:58.46,0:15:02.80,Main,Caribou,0,0,0,,Açık artırmada her biri için başlangıç fiyatının 70,000,000 olduğunu hatırlıyorum.Dialogue: 0,0:15:02.92,0:15:05.14,Main,Caribou,0,0,0,,Yani üç tane ile...Dialogue: 0,0:15:07.02,0:15:09.65,Main,Caribou,0,0,0,,Hasır Şapkalar'a bunun için borçluyum!Dialogue: 0,0:15:10.63,0:15:15.70,Main,Caribou,0,0,0,,Onların sayesinde Balık Adam Adası'na kayıtsız girebildim...Dialogue: 0,0:15:15.70,0:15:17.70,Main,Caribou,0,0,0,,Ve üst sınıf denizkızlarını özgürce avlayabilirim!Dialogue: 0,0:15:18.00,0:15:20.75,Main,Caribou,0,0,0,,Burası bir hazine adası!Dialogue: 0,0:15:24.44,0:15:27.57,Captions,Character Box,0,0,220,,Ryugu Krallığı Liman Kasabası  "Mercan Tepesi"Dialogue: 0,0:15:25.45,0:15:27.57,Main,Knight,0,0,0,,Hasır Şapka Korsanları mı? Dialogue: 0,0:15:27.57,0:15:31.53,Main,Knight,0,0,0,,Denizkızı Körfezi'nden kızları kaçıran onlar mıydı?Dialogue: 0,0:15:31.93,0:15:34.57,Main,Mermaid,0,0,0,,Hayır, öyle bir şey demedim.Dialogue: 0,0:15:34.76,0:15:36.65,Main,Mermaid,0,0,0,,İyi insanlara benziyorlardı...Dialogue: 0,0:15:36.65,0:15:39.57,Main,Mermaid,0,0,0,,Ayrıca, Camie'nin arkadaşı onlar.Dialogue: 0,0:15:39.57,0:15:41.27,Main,Knight,0,0,0,,Onu tehdit etmiş olabilirler.Dialogue: 0,0:15:41.35,0:15:42.10,Main,Mermaid,0,0,0,,Olamaz.Dialogue: 0,0:15:42.34,0:15:45.94,Main,Knight,0,0,0,,Eğer bilgilerimizi göz önüne alırsak, o zaman orada bulunan kişiler...Dialogue: 0,0:15:45.94,0:15:48.47,Main,Knight,0,0,0,,biz muhafızlar ve kızlar,Dialogue: 0,0:15:48.47,0:15:51.13,Main,Knight,0,0,0,,Balık Adam Bölgesi'nden gelen dövülen çete...Dialogue: 0,0:15:51.63,0:15:54.47,Main,Knight,0,0,0,,ve Hasır Şapkalar.Dialogue: 0,0:15:54.47,0:15:58.57,Main,Knight,0,0,0,,Ve onlar ortadan kaybolduktan sonra ne yaptıklarını doğrulayacak kimse yok.Dialogue: 0,0:15:58.77,0:16:02.60,Main,Knight,0,0,0,,İnsanların her zaman denizkızlarını kaçırmak için bir sebepleri vardır.Dialogue: 0,0:16:02.60,0:16:06.93,Main,Knight,0,0,0,,İnsan toplumunda,  genç denizkızları yüksek fiyatlara satılır.Dialogue: 0,0:16:06.93,0:16:10.39,Main,Fishman,0,0,0,,Öyle olsa bile, sadece tahmin yürüterek onları suçlayamazsınız.Dialogue: 0,0:16:10.39,0:16:14.80,Main,Knight,0,0,0,,Şimdiye kadar kaç tane insanın önce iyi bir ifade takınıp,Dialogue: 0,0:16:14.83,0:16:17.88,Main,Knight,0,0,0,,sonra da denizkızlarını kaçırdığından haberin var mı?!Dialogue: 0,0:16:19.88,0:16:20.96,Main,Knight,0,0,0,,Prens Fukaboshi. Dialogue: 0,0:16:21.05,0:16:24.86,Main,Fukaboshi,0,0,0,,Ve Madam Shyarly, az önce dediğiniz şey...Dialogue: 0,0:16:24.86,0:16:28.27,Main,Fukaboshi,0,0,0,,Gerçekten de öyle bir gelecek gördünüz mü?Dialogue: 0,0:16:29.67,0:16:35.94,Main,Fukaboshi,0,0,0,,Korsan Hasır Şapkalı Luffy'nin  Balık Adam Adası'nı yok edecek olması hakkında...Dialogue: 0,0:16:36.91,0:16:39.88,Main,Mermaid,0,0,0,,Madam Shyarly, biraz su için.Dialogue: 0,0:16:44.73,0:16:47.63,Main,Shyarly,0,0,0,,Evet, gerçekten de gördüm.Dialogue: 0,0:16:48.18,0:16:50.19,Main,Shyarly,0,0,0,,Gördüğüm gerçekti.Dialogue: 0,0:16:50.19,0:16:56.26,Main,Fukaboshi,0,0,0,,Ryugu Sarayı'ndaki bizler bile kehanetlerinizin ne kadar tutarlı olduğunu duyduk.Dialogue: 0,0:16:57.04,0:16:59.10,Main,Fukaboshi,0,0,0,,Çıkmaza girdik.Dialogue: 0,0:16:59.10,0:17:05.24,Main,Fukaboshi,0,0,0,,Onlara kız kardeşimizin evcil hayvanını kurtardıkları için teşekkür edecektik.Dialogue: 0,0:17:05.24,0:17:10.71,Main,Fukaboshi,0,0,0,,Ama şimdi, bu kehanet bile doğrulanmış değil, özgürce dolaşmalarına izin veremeyiz.Dialogue: 0,0:17:10.71,0:17:13.43,Main,Fukaboshi,0,0,0,,Onları yakalamalıyız.Dialogue: 0,0:17:14.38,0:17:16.57,Captions,,0,0,220,,Ryugu Krallığı  Seçkin Bölge: "Gyoverly Hills"Dialogue: 0,0:17:15.03,0:17:16.57,Main,Fishman,0,0,0,,Gittiler...Dialogue: 0,0:17:16.57,0:17:19.50,Main,Fishman,0,0,0,,Onlar kimdi ki zaten?Dialogue: 0,0:17:19.50,0:17:24.06,Main,Fishman,0,0,0,,Kral Neptune'un onları bizzat  Ryugu Sarayı'na davet ettiğine inanamıyorum.Dialogue: 0,0:17:25.92,0:17:27.79,Main,Neptune,0,0,0,,Düşmeyin sakın!Dialogue: 0,0:17:27.79,0:17:31.97,Main,Neptune,0,0,0,,Neptune!Dialogue: 0,0:17:35.27,0:17:36.83,Main,Luffy,0,0,0,,O da ne amca?Dialogue: 0,0:17:36.83,0:17:39.91,Main,Luffy,0,0,0,,O haykırmalar çok gülünç.Dialogue: 0,0:17:42.44,0:17:43.68,Main,Pappagg,0,0,0,,Kaba olmayı kes!Dialogue: 0,0:17:43.68,0:17:46.99,Main,Pappagg,0,0,0,,Hasır, pislik! Korkunçsun!  Beni gerçekten korkutuyorsun!Dialogue: 0,0:17:49.19,0:17:51.04,Main,Neptune,0,0,0,,O köpek balığı, Megalo...Dialogue: 0,0:17:51.04,0:17:54.96,Main,Neptune,0,0,0,,Benim kızımın çok değer verdiği evcil hayvanı-jamon.Dialogue: 0,0:17:56.57,0:18:01.19,Main,Neptune,0,0,0,,Megalo geri gelmeyince ağlamayı bir türlü kesmedi.Dialogue: 0,0:18:01.19,0:18:03.70,Main,Neptune,0,0,0,,Kraken tarafından saldırılmış demek...Dialogue: 0,0:18:02.43,0:18:06.66,Captions,,0,0,220,,Megalo (Denizkızı Prenses'in Sevgili Köpek balığı)Dialogue: 0,0:18:03.70,0:18:07.71,Main,Neptune,0,0,0,,Gerçekten tehlikeliydi ama onu kurtardığınız için çok teşekkürler-jamon.Dialogue: 0,0:18:10.39,0:18:13.47,Main,Luffy,0,0,0,,Şey, sadece tesadüftü, ama yine de, onu kurtarabildiğimiz iyi oldu.Dialogue: 0,0:18:13.47,0:18:16.05,Main,Pappagg,0,0,0,,O Denizkızı Prenses'in evcil hayvanı mıymış?Dialogue: 0,0:18:16.05,0:18:21.91,Main,Brook,0,0,0,,Ne? Pappag-san, bir keresinde Denizkızı Prenses ile en iyi arkadaşlar olduğunuzu söylememiş miydin?Dialogue: 0,0:18:23.79,0:18:25.92,Main,Brook,0,0,0,,Ah, yalan mıydı yani?Dialogue: 0,0:18:27.47,0:18:29.55,Main,Caimie,0,0,0,,Sorun olur mu...Dialogue: 0,0:18:31.40,0:18:34.75,Main,Caimie,0,0,0,,bizim de Ryugu Sarayı'na gelmemiz..?Dialogue: 0,0:18:34.75,0:18:38.63,Main,Usopp,0,0,0,,"Arkadaşlarınız da gelebilir-jamon." dedi o yüzden sorun olmaz değil mi?Dialogue: 0,0:18:40.39,0:18:45.99,Main,Neptune,0,0,0,,Açık konuşayım, sizi getirmeleri için oğullarımı gönderdim, ama hala geri dönmediler-jamon.Dialogue: 0,0:18:45.99,0:18:47.84,Main,Neptune,0,0,0,,O yüzden ben geldim.Dialogue: 0,0:18:48.29,0:18:53.50,Main,Neptune,0,0,0,,Sonuçta ben de ziyafeti sabırsızlıkla bekliyorum, ve hemen yemeye başlamak istiyorum-jamon!Dialogue: 0,0:18:53.50,0:18:58.67,Main,Neptune,0,0,0,,Ah, bahsetmeyi unuttum ama, arkadaşlarınızdan biri çoktan oraya götürüldü.Dialogue: 0,0:18:58.67,0:18:59.48,Main,Nami & Usopp,0,0,0,,Dialogue: 0,0:18:59.92,0:19:04.40,Main,Neptune,0,0,0,,Bir kılıç ustası. Şimdiden içmeye başladı bile.Dialogue: 0,0:19:04.40,0:19:09.45,Main,Neptune,0,0,0,,Bu ziyafetler herkes orada olunca daha eğlenceli. Ne bencil adam ama.Dialogue: 0,0:19:09.45,0:19:11.46,Main,Neptune,0,0,0,,Adı sanırsam...Dialogue: 0,0:19:11.63,0:19:13.03,Thoughts,Usopp,0,0,0,,Zoro, mu?Dialogue: 0,0:19:13.03,0:19:14.43,Thoughts,Nami,0,0,0,,Evet o Zoro.Dialogue: 0,0:19:14.63,0:19:15.70,Main,Neptune,0,0,0,,Zori!  Dialogue: 0,0:19:15.90,0:19:17.27,Main,Nami & Usopp,0,0,0,,Zoro o!Dialogue: 0,0:19:22.18,0:19:28.91,Main,Neptune,0,0,0,,Muhafızlar arkadaşlarınızı arıyor ve hepsini kaleye davet edecekler, o yüzden merak etmeyin-jamon.Dialogue: 0,0:19:28.91,0:19:32.02,Main,Luffy,0,0,0,,Nami, onların nereye gittiklerini biliyor musun?Dialogue: 0,0:19:32.97,0:19:38.09,Flashbacks,Franky,0,0,0,,Etrafta bu kadar insan varken, düşündüğümden daha hızlı bilgi toplayabilirim sanırım.Dialogue: 0,0:19:38.09,0:19:39.12,Flashbacks,Nami,0,0,0,,Dialogue: 0,0:19:39.12,0:19:42.53,Flashbacks,Franky,0,0,0,,En çok öğrenmek istediğim şey, gemi ustası ustamın akrabaları.Dialogue: 0,0:19:42.97,0:19:45.62,Flashbacks,Franky,0,0,0,,Burası Tom-san'ın memleketi.Dialogue: 0,0:19:46.86,0:19:49.57,Flashbacks,Robin,0,0,0,,Benim de araştırmak istediğim şeyler var.Dialogue: 0,0:19:49.57,0:19:50.93,Flashbacks,Nami,0,0,0,,Sen de mi?Dialogue: 0,0:19:50.93,0:19:55.67,Flashbacks,Robin,0,0,0,,Eski çağlardan beri, Balık Adam Adası zengin kültürlü bir ada olmuştur.Dialogue: 0,0:19:56.00,0:19:59.07,Flashbacks,Robin,0,0,0,,Eminim bir tanesi daha burada duruyor...Dialogue: 0,0:19:59.07,0:20:01.50,Flashbacks,Robin,0,0,0,,Değerli bir tarih parçası.Dialogue: 0,0:20:02.07,0:20:04.85,Main,Nami,0,0,0,,Bu yüzden tekrar ayrıldık.Dialogue: 0,0:20:04.85,0:20:06.66,Main,Nami,0,0,0,,Siz bir sorun yaşamadınız değil mi?Dialogue: 0,0:20:06.66,0:20:10.60,Main,Usopp,0,0,0,,Şey, yaşadık da denebilir, yaşamadık da denebilir...Dialogue: 0,0:20:10.60,0:20:13.28,Main,Nami,0,0,0,,Bu arada, dede...  Dialogue: 0,0:20:14.09,0:20:17.06,Main,Pappagg,0,0,0,,Konuştuğun kişi Deniz Tanrısı Neptune-sama!Dialogue: 0,0:20:18.46,0:20:24.34,Main,Nami,0,0,0,,Burası denizin on bin metre altında olmasına rağmen, neden sadece Balık Adam Adası bu kadar parlak?Dialogue: 0,0:20:25.76,0:20:29.18,Main,Neptune,0,0,0,,Balık Adam Adası'nı çevreleyen bölge parlak değil.Dialogue: 0,0:20:29.18,0:20:33.61,Main,Neptune,0,0,0,,Burası deniz tabanında  güneşin parladığı tek yer,Dialogue: 0,0:20:33.74,0:20:36.74,Main,Neptune,0,0,0,,bu yüzden uzun zaman önce  balık adamlar burada yaşamaya başladı.Dialogue: 0,0:20:36.74,0:20:39.75,Main,Neptune,0,0,0,,İşte Balık Adam Adası böyle kuruldu.Dialogue: 0,0:20:40.42,0:20:44.61,Main,Neptune,0,0,0,,Burası güneş ışığını yüzeyden denizin dibine olduğu gibi yansıtan,Dialogue: 0,0:20:44.61,0:20:49.09,Main,Neptune,0,0,0,,Güneş Işığı Ağacı Eve'nin köklerinin ulaştığı yer.Dialogue: 0,0:20:49.09,0:20:50.47,Main,Nami,0,0,0,,Güneş ışığını mı?Dialogue: 0,0:20:50.73,0:20:55.18,Main,Nami,0,0,0,,Yani bu ağacın denizin on bin metre altına ulaşan, parlayan kökleri olduğunu mu söylüyorsun?Dialogue: 0,0:20:55.56,0:21:00.14,Main,Neptune,0,0,0,,Aynen. Bilim adamları bunun hakkında yeni teoriler üretiyorlar ama,Dialogue: 0,0:21:00.14,0:21:04.98,Main,Neptune,0,0,0,,nihayetinde bu yüzeyden ışık alıp köklerinden dışarı saçan gizemli bir ağaç-jamon. Dialogue: 0,0:21:04.98,0:21:10.38,Main,Neptune,0,0,0,,Yaptığı solunum da deniz tabanına hava sağlıyor.Dialogue: 0,0:21:10.88,0:21:15.37,Main,Usopp,0,0,0,,Sabaody'deki Yarukiman Mangrovları'nın büyük patronu gibi mi yani?Dialogue: 0,0:21:15.61,0:21:18.10,Main,Luffy,0,0,0,,Kaba sakallı amca, karnım acıktı!Dialogue: 0,0:21:18.10,0:21:18.52,Main,Pappagg,0,0,0,,Hey!Dialogue: 0,0:21:20.62,0:21:21.96,Main,Neptune,0,0,0,,Neredeyse geldik.Dialogue: 0,0:21:22.77,0:21:25.40,Main,Neptune,0,0,0,,Orası giriş-jamon.Dialogue: 0,0:21:28.29,0:21:29.60,Main,Talking Doorbell,0,0,0,,Ding-dong.Dialogue: 0,0:21:29.94,0:21:30.56,Main,Voice,0,0,0,,Evet?Dialogue: 0,0:21:30.56,0:21:31.84,Main,Neptune,0,0,0,,Benim-jamon.Dialogue: 0,0:21:31.84,0:21:33.92,Main,Voice,0,0,0,,O konuşma... M-Majesteleri!Dialogue: 0,0:21:34.25,0:21:35.92,Main,Voice,0,0,0,,Yolu sizin için hemen indireceğim!Dialogue: 0,0:21:38.24,0:21:40.47,Main,Neptune,0,0,0,,Baloncuklarınızı sıkı tutun-jamon.Dialogue: 0,0:21:41.15,0:21:43.16,Main,Neptune,0,0,0,,Hadi gidelim.Dialogue: 0,0:21:44.05,0:21:48.15,Main,Neptune,0,0,0,,Neptune! Dialogue: 0,0:21:48.86,0:21:51.08,Main,Nami,0,0,0,,Yaşasın, Ryugu Sarayı!Dialogue: 0,0:21:54.79,0:21:56.99,Main,Neptune,0,0,0,,İşte burası-jamon.Dialogue: 0,0:22:02.81,0:22:05.37,Captions,Sign,0,0,260,,Ryugu Krallığı'nın Kraliyet Sarayı   Ryugu SarayıDialogue: 0,0:22:18.05,0:22:20.56,Main,Luffy,0,0,0,,Harika! Çok havalı!Dialogue: 0,0:22:20.78,0:22:23.90,Main,Brook,0,0,0,,Pappag-san'ın malikanesi bunun yanında pire gibi kalıyor.Dialogue: 0,0:22:23.90,0:22:24.81,Main,Pappagg,0,0,0,,Karşılaştırma!Dialogue: 0,0:22:25.14,0:22:27.32,Main,Nami,0,0,0,,Ne güzel bir kale!Dialogue: 0,0:22:29.65,0:22:32.03,Main,Voice,0,0,0,,Kral Neptune geri döndü!Dialogue: 0,0:22:32.13,0:22:34.28,Main,Voice,0,0,0,,Nereye gittiğini merak ediyordum.Dialogue: 0,0:22:34.28,0:22:35.74,Main,Voice,0,0,0,,Kapıyı açın!Dialogue: 0,0:22:36.04,0:22:37.57,Main,Voice,0,0,0,,Kapıyı açıyorum!Dialogue: 0,0:22:41.71,0:22:44.83,Main,Voice,0,0,0,,Tekrar hoş geldiniz, Majesteleri!Dialogue: 0,0:22:47.71,0:22:50.96,Main,Luffy,0,0,0,,Çok eğlenceli duran bir kale!Dialogue: 0,0:22:51.32,0:22:54.85,Main,Neptune,0,0,0,,Burası benim kalem-jamon! Kendi evinizmiş gibi davranın!Dialogue: 0,0:22:54.85,0:22:55.87,Main,Merman,0,0,0,,Yine yaptınız!Dialogue: 0,0:22:55.87,0:23:01.95,Main,Merman,0,0,0,,Yine mevkinizi düşünmeden kendi başınıza krallığın içine gittiniz!Dialogue: 0,0:23:01.95,0:23:06.57,Main,Merman,0,0,0,,Yanınıza muhafız bile almadan öylece yüzeye inemezsiniz!Dialogue: 0,0:23:06.57,0:23:07.87,Main,Merman,0,0,0,,Biz ne yapacağız?Dialogue: 0,0:23:07.87,0:23:10.63,Main,Neptune,0,0,0,,İleride daha dikkatli olurum-jamon.Dialogue: 0,0:23:11.16,0:23:13.07,Thoughts,The Shocked Crowd,0,0,0,,Azarlandı.Dialogue: 0,0:23:13.40,0:23:16.00,Main,Merman,0,0,0,,Eğer size bir şey olsaydı özürler için çok geç olurdu!Dialogue: 0,0:23:16.00,0:23:21.30,Main,Merman,0,0,0,,Ülkemizin nasıl bir durum içinde olduğundan haberiniz var mı ki?!Dialogue: 0,0:23:24.48,0:23:25.96,Main,Neptune,0,0,0,,Onu boşverin de, bakın!Dialogue: 0,0:23:25.96,0:23:31.69,Main,Neptune,0,0,0,,Kraken tarafından zorbalığa uğrayan Megalo'yu kurtaran insanları getirdim-jamon.Dialogue: 0,0:23:32.41,0:23:35.29,Main,Neptune,0,0,0,,Şimdi, misafirlerimizi karşılayın!Dialogue: 0,0:23:35.29,0:23:38.46,Main,Neptune,0,0,0,,Prenses Shirahoshi ne yapıyor?Dialogue: 0,0:23:38.46,0:23:41.86,Main,Merman,0,0,0,,Şey, Majesteleri, tekrar olmuş gibi duruyor...Dialogue: 0,0:23:41.86,0:23:46.98,Main,Neptune,0,0,0,,Ne?! Bunların hepsi prensesi sakin tutmak için onunla ilgilenmemeniz yüzünden!Dialogue: 0,0:23:46.98,0:23:48.44,Main,Neptune,0,0,0,,Aptallar!Dialogue: 0,0:23:48.44,0:23:50.07,Main,Merman,0,0,0,,Ve bunlar olurken...Dialogue: 0,0:23:50.07,0:23:52.37,Main,Merman,0,0,0,,bir iz bile bırakmadan kayboldun!Dialogue: 0,0:23:52.69,0:23:56.66,Main,Merman,0,0,0,,Herkesi endişelendirdiğinizin farkında değil misiniz, Majesteleri?!Dialogue: 0,0:23:56.66,0:23:57.88,Main,Merman,0,0,0,,İlk olarak...Dialogue: 0,0:23:57.88,0:24:01.25,Main,Neptune,0,0,0,,İleride daha dikkatli olacağıma söz veriyorum-jamon.Dialogue: 0,0:24:01.51,0:24:03.49,Thoughts,The Shocked Crowd,0,0,0,,Yine azarlandı.Dialogue: 0,0:24:04.06,0:24:07.44,Main,Right Minister,0,0,0,,Buraya misafirler getirdiğinizde bundan bahsettiğim için...Dialogue: 0,0:24:07.44,0:24:11.76,Main,Right Minister,0,0,0,,yürekten özür diliyorum ama, konuşmamız gereken önemli konular var.Dialogue: 0,0:24:07.20,0:24:12.21,Captions,Character Box,480,0,260,,Ryugu Krallığı Sağ Bakan'ı  (Denizatı Deniz Adamı)Dialogue: 0,0:24:11.76,0:24:14.97,Main,Left Minister,0,0,0,,Evet, az önce Prens Fukaboshi...Dialogue: 0,0:24:14.97,0:24:16.89,Main,Left Minister,0,0,0,,bizimle iletişime geçti.Dialogue: 0,0:24:13.23,0:24:18.02,Captions,,0,450,230,,Ryugu Krallığı Sol Bakan'ı  (Kedi Balığı Deniz Adamı)Dialogue: 0,0:24:16.89,0:24:18.70,Main,Left Minister,0,0,0,,Biz ne yapacağız?Dialogue: 0,0:24:19.48,0:24:22.04,Main,Neptune,0,0,0,,Fukaboshi mi? Ne oldu?!Dialogue: 0,0:24:22.04,0:24:23.61,Main,Left Minister,0,0,0,,Gördüğünüz gibi...Dialogue: 0,0:24:24.77,0:24:27.79,Main,Brook,0,0,0,,Daha ne kadar bizi görmezden gelecekler acaba?Dialogue: 0,0:24:27.79,0:24:29.59,Main,Nami,0,0,0,,Ne? Luffy nereye gitti?Dialogue: 0,0:24:30.45,0:24:33.24,Main,Usopp,0,0,0,,Az önce buradaydı!Dialogue: 0,0:24:33.24,0:24:36.29,Main,Usopp,0,0,0,,Bir dakika bile yerinde duramıyor değil mi?Dialogue: 0,0:24:36.29,0:24:40.12,Main,Pappagg,0,0,0,,Tanrı'nın yerinde gezinerek ne yaptığını sanıyor o?!Dialogue: 0,0:24:41.06,0:24:42.86,Main,Luffy,0,0,0,,Koku yok oldu...Dialogue: 0,0:24:43.26,0:24:45.40,Main,Luffy,0,0,0,,Yani o kapının arkasında!Dialogue: 0,0:24:58.74,0:25:02.16,Main,Luffy,0,0,0,,Acaba burası ziyafetin olduğu yer mi?Dialogue: 0,0:25:02.46,0:25:04.65,Main,Luffy,0,0,0,,Zoro'nun zaten burada olduğunu söylemişlerdi, değil mi?Dialogue: 0,0:25:05.61,0:25:10.65,Main,Luffy,0,0,0,,Ama, bu ne büyük, kalın ve sert görünümlü bir kapı!Dialogue: 0,0:25:10.65,0:25:16.09,Main,Luffy,0,0,0,,Duvarlar da sağlam gözüküyor. Tıpkı Impel Down'daki duvarlar gibiler!Dialogue: 0,0:25:16.09,0:25:18.96,Main,Luffy,0,0,0,,İçerde ne tür lezzetli yemek var acaba?!Dialogue: 0,0:25:24.40,0:25:27.47,Main,Luffy,0,0,0,,Kapkaranlık... Ziyafet yeri burası değil miydi yani?Dialogue: 0,0:25:29.24,0:25:32.76,Main,Luffy,0,0,0,,Ama çok güzel kokan yemekler var burada!Dialogue: 0,0:25:32.76,0:25:35.07,Main,Luffy,0,0,0,,Burası yemek deposu mu o zaman?Dialogue: 0,0:25:35.07,0:25:37.12,Main,Luffy,0,0,0,,Her neyse! Biraz alacağım!Dialogue: 0,0:25:37.12,0:25:39.29,Main,Luffy,0,0,0,,Açlığım sınırında!Dialogue: 0,0:25:41.12,0:25:42.49,Main,Luffy,0,0,0,,Bu da ne?Dialogue: 0,0:25:43.66,0:25:46.89,Main,Luffy,0,0,0,,Bu adada nereye gidersem mercanlar var ha?Dialogue: 0,0:25:49.96,0:25:52.80,Main,Luffy,0,0,0,,Bu da ne? Çok yumuşak...Dialogue: 0,0:25:54.34,0:25:58.63,Main,Luffy,0,0,0,,Ne? Az önce birisinin sesini mi duydum?Dialogue: 0,0:26:00.98,0:26:03.69,Main,Luffy,0,0,0,,Bu mercan puding gibi!Dialogue: 0,0:26:04.48,0:26:06.14,Main,Shirahoshi,0,0,0,,Orada biri mi var?!Dialogue: 0,0:26:13.10,0:26:15.12,Main,Shirahoshi,0,0,0,,Bu da ne?!Dialogue: 0,0:26:19.06,0:26:22.59,Main,Shirahoshi,0,0,0,,Başkasının vücudunun üstünde ne yapıyorsunuz?!Dialogue: 0,0:26:22.86,0:26:28.14,Main,Shirahoshi,0,0,0,,Siz de kimsiniz acaba?!Dialogue: 0,0:26:26.08,0:26:30.75,Captions,Character Box,0,0,220,,Ryugu Krallığının Prensesi  Prenses Shirahoshi (Dev Bakalyaro Denizkızı)Dialogue: 0,0:26:30.75,0:26:35.34,Main,Luffy,0,0,0,,Ne?! Dev bir insan... denizkızı mıydın?!Dialogue: 0,0:26:35.58,0:26:39.58,Main,Shirahoshi,0,0,0,,S-Siz de benim canımı almaya geldiniz, değil mi?Dialogue: 0,0:26:39.58,0:26:42.15,Main,Shirahoshi,0,0,0,,A-Ama sizden korkmuyorum!Dialogue: 0,0:26:42.15,0:26:45.34,Main,Shirahoshi,0,0,0,,Ben Neptune'un kızıyım sonuçta...Dialogue: 0,0:26:45.34,0:26:46.96,Main,Shirahoshi,0,0,0,,Ben korkmuyor...Dialogue: 0,0:26:46.96,0:26:49.69,Main,Shirahoshi,0,0,0,,Korkmu...Dialogue: 0,0:26:51.83,0:26:53.27,Main,Shirahoshi,0,0,0,,Birisi!Dialogue: 0,0:26:53.27,0:26:56.96,Main,Shirahoshi,0,0,0,,Baba! Abi!Dialogue: 0,0:26:56.96,0:27:00.35,Main,Luffy,0,0,0,,H-Hey, hey... Ben hiçbir şey yapmadım!Dialogue: 0,0:27:02.54,0:27:06.52,Main,Luffy,0,0,0,,Neyin var senin?!Dialogue: 0,0:00:39.81,0:00:43.07,Credits,,0,0,0,,Translation & initial timing Yibis FansubsDialogue: 0,0:00:45.24,0:00:48.84,Credits,,0,0,0,,Timing Galaxy 9000  Time-checking SewilDialogue: 0,0:00:50.20,0:00:54.26,Credits,,0,0,0,,Quality-checking Sewil Galaxy 9000 FeesoDialogue: 0,0:00:54.59,0:00:58.79,Credits,,0,0,0,,Soundtracking HaleeDialogue: 0,0:01:16.42,0:01:18.52,Credits,,0,0,0,,Video editing Sewil