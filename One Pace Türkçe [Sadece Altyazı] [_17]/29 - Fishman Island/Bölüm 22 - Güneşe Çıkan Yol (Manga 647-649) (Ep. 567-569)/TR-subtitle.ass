0,1Style: TS paper,impress bt,50,&H001D221E,&H000000FF,&H001D221E,&H00000000,0,0,0,0,100,100,0,0,1,0.5,0,2,10,10,10,1Style: We Go lyrics,Duality,40.0,&H0098594E,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2.0,0,8,10,10,16,1Style: Author,Impress BT,20.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.7,0.7,9,10,10,10,1Style: Attack,Duality,32.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.0,1.0,7,12,12,12,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:02:30.00,0:02:40.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:19:44.50,0:19:54.50,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:42:24.80,0:42:27.75,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:02:50.26,0:02:53.02,Main,Right Minster,0,0,0,,Akıllara zarar üst düzey üyeleri bile...Dialogue: 0,0:02:53.02,0:02:55.57,Main,Right Minster,0,0,0,,...helva gibi yediler!Dialogue: 0,0:02:55.57,0:02:57.13,Main,Right Minster,0,0,0,,Nasıl bir güçtür bu?!Dialogue: 0,0:03:29.82,0:03:31.72,Main,Sanji,0,0,0,,Paketiniz var!Dialogue: 0,0:03:31.72,0:03:33.14,Main,Sanji,0,0,0,,Denk gelirse yamultur,...Dialogue: 0,0:03:33.14,0:03:34.80,Main,Sanji,0,0,0,,...uyarmadı demeyin!Dialogue: 0,0:03:38.09,0:03:40.24,Main,Pirate,0,0,0,,Oha, Wadatsumi...Dialogue: 0,0:03:40.24,0:03:41.83,Main,Pirate,0,0,0,,Üstümüzü düşüyor!Dialogue: 0,0:03:56.49,0:03:58.95,Main,Zoro,0,0,0,,Daha uzağa yollasaydın ya, aşçı bozuntusu seni!Dialogue: 0,0:03:58.95,0:04:02.68,Main,Sanji,0,0,0,,Kapa çeneni be! Bir dahakini sana denk getireceğim zaten!Dialogue: 0,0:04:08.61,0:04:11.60,Main,Chopper,0,0,0,,Harikaydın gerçekten, Sanji.Dialogue: 0,0:04:15.09,0:04:18.41,Main,Franky,0,0,0,,Baksana bana Chopper, biraz küçülebilir misin?Dialogue: 0,0:04:18.41,0:04:21.17,Main,Franky,0,0,0,,Robotumun heybetine gölge düşürüyorsun!Dialogue: 0,0:04:21.17,0:04:23.65,Main,Usopp,0,0,0,,Franky, lazer dehşetti!Dialogue: 0,0:04:24.31,0:04:27.80,Main,Robin,0,0,0,,Robot neredeyse hiçbir işe yaramadı gibi...Dialogue: 0,0:04:31.95,0:04:32.76,Main,Brook,0,0,0,,Nami-san!Dialogue: 0,0:04:32.76,0:04:33.85,Main,Nami,0,0,0,,Ne var be?Dialogue: 0,0:04:34.72,0:04:36.54,Main,Brook,0,0,0,,Bir dahaki sefer mini etek giyin lütfen!Dialogue: 0,0:04:36.54,0:04:37.42,Main,Nami,0,0,0,,Kapa çeneni be!Dialogue: 0,0:04:43.06,0:04:46.05,Main,Jinbe,0,0,0,,Luffy-kun'un tayfasından da daha azı beklenemezdi!Dialogue: 0,0:04:46.19,0:04:47.29,Main,Guard,0,0,0,,Hey...Dialogue: 0,0:04:47.90,0:04:49.65,Main,Guard,0,0,0,,Noah...Dialogue: 0,0:04:59.89,0:05:02.25,Main,Citizen,0,0,0,,Noah, burnumuzun dibine kadar gelmiş!Dialogue: 0,0:05:07.67,0:05:09.17,Main,Citizen,0,0,0,,Kaçın!Dialogue: 0,0:05:09.17,0:05:12.45,Main,Pirate,0,0,0,,Adayla beraber bizi de yok edecek!Dialogue: 0,0:05:12.45,0:05:16.60,Main,Pirate,0,0,0,,Burada kalacak olursak Neptune'ün ordusu bizi plazada parmaklıklar ardına tıkar!Dialogue: 0,0:05:16.60,0:05:19.63,Main,Pirate,0,0,0,,Acele edin! Bizim elemanlar da yok artık!Dialogue: 0,0:05:19.85,0:05:20.87,Main,Citizen,0,0,0,,İyi misin?Dialogue: 0,0:05:22.98,0:05:25.16,Main,Citizen,0,0,0,,Zamanında kaçamayacak mıyız?!Dialogue: 0,0:05:28.59,0:05:30.74,Main,Citizen,0,0,0,,Başaramayacak mısın, Hasır Şapka?Dialogue: 0,0:05:32.30,0:05:34.38,Main,Citizen,0,0,0,,Hasır Şapka!Dialogue: 0,0:05:42.71,0:05:44.61,Main,Guard,0,0,0,,Bu çocuk hâlâ...Dialogue: 0,0:05:48.11,0:05:49.64,Main,Guard,0,0,0,,...vazgeçmiş değil!Dialogue: 0,0:05:53.28,0:05:55.54,Main,Guard,0,0,0,,Hasır Şapkalı Luffy-sama...Dialogue: 0,0:06:01.58,0:06:03.33,Main,Guard,0,0,0,,...tüm gücüyle Noah'yı...Dialogue: 0,0:06:05.66,0:06:07.48,Main,Guard,0,0,0,,...yok etmeye...Dialogue: 0,0:06:09.38,0:06:11.16,Main,Guard,0,0,0,,...çalışıyor!Dialogue: 0,0:06:13.66,0:06:15.09,Main,Shirahoshi,0,0,0,,Luffy-sama!Dialogue: 0,0:06:19.21,0:06:23.86,Main,Right Minister,0,0,0,,Düşmeden evvel  Noah'yı paramparça edebilirse ada kurtulur.Dialogue: 0,0:06:23.86,0:06:25.98,Main,Right Minister,0,0,0,,Lakin zamanında yapamazsa...Dialogue: 0,0:06:27.18,0:06:30.54,Main,Right Minister,0,0,0,,...Balık Adam Adası'nın sonu olur bu!Dialogue: 0,0:06:31.19,0:06:33.63,Main,Usopp,0,0,0,,Göster tüm gücünü, Luffy!Dialogue: 0,0:06:34.79,0:06:36.07,Main,Brook,0,0,0,,Luffy-san!Dialogue: 0,0:06:36.07,0:06:38.18,Main,Usopp,0,0,0,,Luffy!Dialogue: 0,0:06:38.18,0:06:40.59,Main,Chopper,0,0,0,,Luffy!Dialogue: 0,0:06:42.12,0:06:43.57,Main,Jinbe,0,0,0,,Luffy-kun!Dialogue: 0,0:06:55.63,0:06:56.79,Main,Citizen,0,0,0,,Vazgeçme Hasır Şapka!Dialogue: 0,0:06:57.19,0:07:00.18,Main,Citizen,0,0,0,,Aynen öyle Hasır Şapka! Seninleyiz!Dialogue: 0,0:07:00.18,0:07:02.29,Main,Citizen,0,0,0,,Dayan, Hasır Şapka!Dialogue: 0,0:07:02.29,0:07:05.35,Main,Citizen,0,0,0,,İnsan olmana rağmen bizim için savaşıyorsun!Dialogue: 0,0:07:05.35,0:07:07.17,Main,Citizen,0,0,0,,Hiçbir yere kaçacak değiliz!Dialogue: 0,0:07:07.94,0:07:11.14,Main,Citizen,0,0,0,,Yapabilirsin, Hasır Şapkalı Abi!Dialogue: 0,0:07:13.91,0:07:17.22,Main,Right Minister,0,0,0,,Balık Adam Adası'nı kurtar, Hasır Şapka!Dialogue: 0,0:07:17.22,0:07:19.55,Main,Citizen,0,0,0,,Göster kendini, Hasır Şapka!Dialogue: 0,0:07:19.55,0:07:21.70,Main,Citizen,0,0,0,,Sana tüm kalbimizle inanıyoruz!Dialogue: 0,0:07:22.29,0:07:24.33,Main,Citizen,0,0,0,,Hasır Şapka!Dialogue: 0,0:07:24.33,0:07:26.51,Main,Citizen,0,0,0,,Hasır Şapka!Dialogue: 0,0:07:26.51,0:07:28.91,Main,Citizen,0,0,0,,Hasır Şapka!Dialogue: 0,0:07:29.61,0:07:42.89,Main,Citizen,0,0,0,,Hasır Şapka!Dialogue: 0,0:07:42.89,0:07:44.61,Main,Citizen,0,0,0,,Dur artık, Noah!Dialogue: 0,0:07:45.96,0:07:49.31,Main,Citizen,0,0,0,,Dur!Dialogue: 0,0:07:57.21,0:07:58.24,Main,Shirahoshi,0,0,0,,Luffy-sama!Dialogue: 0,0:08:02.20,0:08:04.05,Main,Shirahoshi,0,0,0,,Yaranız git gide daha da açılı-Dialogue: 0,0:08:04.05,0:08:04.82,Main,Luffy,0,0,0,,Yaklaşma!Dialogue: 0,0:08:06.75,0:08:09.49,Main,Luffy,0,0,0,,İzle olduğun yerden!Dialogue: 0,0:08:09.49,0:08:12.36,Main,Luffy,0,0,0,,Bu şeyi tüm gücümle parçalayıp geçeceğim!Dialogue: 0,0:08:16.98,0:08:20.93,Main,Luffy,0,0,0,,Dur artık, gemi!Dialogue: 0,0:08:31.19,0:08:34.47,Main,Fukaboshi,0,0,0,,Bağışlayın beni, babacığım.Dialogue: 0,0:08:34.98,0:08:39.64,Main,Fukaboshi,0,0,0,,Noah parçalanacak... Başka yolu kalmadı ne yazık ki!Dialogue: 0,0:08:39.64,0:08:41.72,Main,Left Minister,0,0,0,,Hasır Şapka!Dialogue: 0,0:08:41.90,0:08:44.19,Main,Neptune,0,0,0,,Adına söz verdiğimiz gemi...Dialogue: 0,0:08:44.19,0:08:47.65,Main,Neptune,0,0,0,,Ama başka bir seçeneğimiz de yok, yitirilecek canlar söz konusu!Dialogue: 0,0:08:48.05,0:08:52.68,Main,Neptune,0,0,0,,Bağışla beni, sözümü yerine getiremeyeceğim-jamon!Dialogue: 0,0:08:52.68,0:08:54.35,Main,Neptune,0,0,0,,Joy Boy!Dialogue: 0,0:08:54.68,0:08:55.81,Main,Sea King,0,0,0,,Dur!Dialogue: 0,0:09:01.82,0:09:03.06,Main,Luffy,0,0,0,,Sen de kimsin?!Dialogue: 0,0:09:07.71,0:09:10.49,Main,Shirahoshi,0,0,0,,Yapmayın artık, Luffy-sama!Dialogue: 0,0:09:10.49,0:09:13.47,Main,Shirahoshi,0,0,0,,Luffy-sama! Yalvarırım, durun!Dialogue: 0,0:09:15.37,0:09:18.32,Main,Luffy,0,0,0,,Çekil önümden Zayıf-hoshi! Bunu yapmazsam ada...Dialogue: 0,0:09:21.78,0:09:23.20,Main,Shirahoshi,0,0,0,,Artık gerek kalmadı!Dialogue: 0,0:09:23.20,0:09:26.58,Main,Luffy,0,0,0,,Ne demekmiş gerek kalmadı?! Herkes hâlâ adada be!Dialogue: 0,0:09:26.58,0:09:27.82,Main,Shirahoshi,0,0,0,,Noah artık...Dialogue: 0,0:09:29.50,0:09:31.06,Main,Shirahoshi,0,0,0,,...düşmüyor.Dialogue: 0,0:09:41.48,0:09:44.21,Main,Luffy,0,0,0,,Deniz Kralları mı geldiler? Neden ki?!Dialogue: 0,0:09:48.00,0:09:52.15,Main,Shirahoshi,0,0,0,,Luffy-sama çok kızdı!Dialogue: 0,0:09:52.15,0:09:54.66,Main,Luffy,0,0,0,,Bak bana, şimdi onun için ağlayacak zaman mı?!Dialogue: 0,0:09:59.62,0:10:03.48,Main,Shirahoshi,0,0,0,,Ben de bilemiyorum ki...Dialogue: 0,0:10:04.50,0:10:06.50,Main,Shirahoshi,0,0,0,,Ama...Dialogue: 0,0:10:06.50,0:10:08.97,Main,Shirahoshi,0,0,0,,...Noah artık durdu!Dialogue: 0,0:10:11.66,0:10:14.18,Main,Guard,0,0,0,,Bu da ne böyle?!Dialogue: 0,0:10:14.18,0:10:18.18,Main,Guard,0,0,0,,Ne anlama geliyor bu? Deniz Kralları gemiyi durdurdular!Dialogue: 0,0:10:24.24,0:10:28.05,Main,Shirahoshi,0,0,0,,Luffy-sama, yaranız yine açılıyor!Dialogue: 0,0:10:28.05,0:10:29.65,Main,Shirahoshi,0,0,0,,Çok fazla kan kaybediyorsunuz!Dialogue: 0,0:10:33.78,0:10:37.35,Main,Luffy,0,0,0,,Ar-Artık önemi yok.Dialogue: 0,0:10:38.48,0:10:42.30,Main,Luffy,0,0,0,,Gemi durdu nihayetinde.Dialogue: 0,0:10:43.31,0:10:49.22,Main,Luffy,0,0,0,,Herkes...  şükürler olsun ki güvende.Dialogue: 0,0:10:50.60,0:10:52.17,Main,Shirahoshi,0,0,0,,Luffy-sama!Dialogue: 0,0:10:53.73,0:10:55.45,Main,Sea King,0,0,0,,Endişelenme.Dialogue: 0,0:11:04.32,0:11:08.34,Main,Sea King,0,0,0,,Cidden yani, nasıl bir insandır bu?!Dialogue: 0,0:11:08.34,0:11:12.31,Main,Sea King,0,0,0,,Ne kadar da güçlü bir insan değil mi?Dialogue: 0,0:11:12.31,0:11:16.68,Main,Sea King,0,0,0,,Az daha geç kalsak adaya bir şey olmayacakmış.Dialogue: 0,0:11:16.68,0:11:20.25,Main,Sea King,0,0,0,,Ama Noah tamamıyla yok edilmiş olacaktı.Dialogue: 0,0:11:23.12,0:11:31.25,Main,Sea King,0,0,0,,Zamanında yetişebilmemize çok sevindim! İyi ki Prenses Shirahoshi bizleri çağırmış.Dialogue: 0,0:11:32.78,0:11:36.13,Main,Shirahoshi,0,0,0,,Ben hiçbir şey yapmadım ki, çok üzgündüm sadece...Dialogue: 0,0:11:36.13,0:11:42.03,Main,Sea King,0,0,0,,Hiç de bile! Hasır Şapkalı gencin kararlılığından etkilenip...Dialogue: 0,0:11:43.05,0:11:44.36,Main,Sea King,0,0,0,,...diledin.Dialogue: 0,0:11:47.93,0:11:51.38,Main,Sea King,0,0,0,,Adayı kurtarabilmesi için...Dialogue: 0,0:11:51.38,0:11:57.18,Main,Sea King,0,0,0,,...tüm kalbinle, bir şekilde gücünü ona aktarabilmeyi diledin.Dialogue: 0,0:12:12.06,0:12:16.43,Main,Sea King,0,0,0,,Bizim gücümüz senin gücündür.Dialogue: 0,0:12:16.43,0:12:20.78,Main,Sea King,0,0,0,,Senin çağrınla ona yardıma geldik.Dialogue: 0,0:12:29.36,0:12:31.99,Main,Guard,0,0,0,,Krallık'taki herkese sesleniyorum...Dialogue: 0,0:12:31.99,0:12:37.67,Main,Guard,0,0,0,,Az önce burada yaşananlar kelimelere sığmayacak şeylerdi.Dialogue: 0,0:12:37.67,0:12:40.95,Main,Guard,0,0,0,,Lakin hepsi de gözlerimizin önünde gerçekleşti!Dialogue: 0,0:12:41.75,0:12:44.19,Main,Guard,0,0,0,,Noah durdu!Dialogue: 0,0:12:47.76,0:12:50.90,Main,Guard,0,0,0,,Noah tamamıyla paramparça edilmeden...Dialogue: 0,0:12:53.02,0:12:56.61,Main,Guard,0,0,0,,...Balık Adam Adası kurtarıldı!Dialogue: 0,0:12:58.22,0:13:00.98,Main,Citizen,0,0,0,,Hasır Şapka başardı!Dialogue: 0,0:13:29.65,0:13:31.39,Main,Sea King,0,0,0,,Prenses Shirahoshi.Dialogue: 0,0:13:31.93,0:13:37.84,Main,Sea King,0,0,0,,Dünyaya gelmeni çok uzun vakitler bekledik.Dialogue: 0,0:13:37.84,0:13:39.59,Main,Shirahoshi,0,0,0,,Benim mi?Dialogue: 0,0:13:39.59,0:13:44.25,Main,Sea King,0,0,0,,Gemi bizler tarafından çekilmek için tasarlandı.Dialogue: 0,0:13:44.25,0:13:49.45,Main,Sea King,0,0,0,,Ve eski zamanlardan beri de bu görev nesilden nesile aktarılıyor.Dialogue: 0,0:13:49.45,0:13:53.17,Main,Shirahoshi,0,0,0,,O yüzden mi Noah bu kadar büyük yani?Dialogue: 0,0:13:53.17,0:13:53.97,Main,Sea King,0,0,0,,Evet.Dialogue: 0,0:13:54.48,0:14:01.91,Main,Sea King,0,0,0,,Uzun yüzyılların ardından kraliçemiz  deniz kızı formunda dünyaya gelir.Dialogue: 0,0:14:01.91,0:14:03.70,Main,Sea King,0,0,0,,Neden acaba?Dialogue: 0,0:14:04.72,0:14:06.43,Main,Sea King,0,0,0,,Öyle hakikaten!Dialogue: 0,0:14:06.43,0:14:08.18,Main,Sea King,0,0,0,,Sen...Dialogue: 0,0:14:08.18,0:14:11.45,Main,Sea King,0,0,0,,Doğduğun andan beri...Dialogue: 0,0:14:11.45,0:14:14.51,Main,Sea King,0,0,0,,...kraliçemizdin.Dialogue: 0,0:14:19.90,0:14:21.43,Main,Manboshi,0,0,0,,Abi!Dialogue: 0,0:14:21.43,0:14:24.78,Main,Ryuuboshi,0,0,0,,Evet, Shirahoshi gerçekten de...Dialogue: 0,0:14:24.78,0:14:28.75,Main,Fukaboshi,0,0,0,,Deniz Kralları'yla konuşuyor.Dialogue: 0,0:14:28.75,0:14:29.76,Main,Fukaboshi,0,0,0,,Gözlerime inanamıyorum!Dialogue: 0,0:14:29.76,0:14:34.87,Main,Guard,0,0,0,,İşin aslı Deniz Kralları,  adanın üzerinde, yoktan var oldular resmen!Dialogue: 0,0:14:34.87,0:14:38.73,Main,Guard,0,0,0,,Sanırsınız Luffy-san yok etmesin diye...Dialogue: 0,0:14:38.73,0:14:42.81,Main,Guard,0,0,0,,...Noah'yı korumaya gelmişler gibi.Dialogue: 0,0:14:42.81,0:14:47.65,Main,Guard,0,0,0,,Acaba Noah onlar için değerli bir şey falan mı?Dialogue: 0,0:14:47.65,0:14:49.43,Main,Left Minister,0,0,0,,Neptune-sama?!Dialogue: 0,0:14:51.37,0:14:53.19,Main,Neptune,0,0,0,,Deniz Kralları...Dialogue: 0,0:14:54.39,0:14:56.65,Main,Neptune,0,0,0,,Sonunda uyanmaya başladı-jamon.Dialogue: 0,0:14:57.45,0:15:01.31,Main,Neptune,0,0,0,,Dünyanın sonunu getirebilecek o güç!Dialogue: 0,0:15:03.35,0:15:08.38,Main,Sea King,0,0,0,,Bak, balon adanınkiyle birleşmeye başladı.Dialogue: 0,0:15:08.38,0:15:11.95,Main,Sea King,0,0,0,,İnsanlar derin sularda hayatta kalamazlar.Dialogue: 0,0:15:11.95,0:15:15.31,Main,Sea King,0,0,0,,Gidip onu kurtarsan iyi edersin.Dialogue: 0,0:15:17.19,0:15:18.82,Main,Shirahoshi,0,0,0,,Luffy-sama!Dialogue: 0,0:15:18.82,0:15:19.74,Main,Shirahoshi,0,0,0,,Olamaz!Dialogue: 0,0:15:27.68,0:15:29.50,Main,Sea King,0,0,0,,Bana mı öyle geliyor acaba?Dialogue: 0,0:15:30.77,0:15:35.91,Main,Sea King,0,0,0,,Şapkalı insan seslerimizi duydu sanki.Dialogue: 0,0:15:35.91,0:15:37.77,Main,Sea King,0,0,0,,Mümkün değil.Dialogue: 0,0:15:38.38,0:15:43.19,Main,Sea King,0,0,0,,Benzer bir şey yaşanalı o kadar da çok olmadı aslında.Dialogue: 0,0:15:43.19,0:15:46.00,Main,Sea King,0,0,0,,Evet, daha önce de olmuştu değil mi?Dialogue: 0,0:15:47.48,0:15:51.05,Flashbacks,Roger,0,0,0,,Rayleigh, az önceki sesi duydun mu?Dialogue: 0,0:15:51.05,0:15:52.37,Flashbacks,Rayleigh,0,0,0,,Ne diyorsun sen yahu?Dialogue: 0,0:15:52.37,0:15:54.56,Flashbacks,Rayleigh,0,0,0,,Sessizliğin ta en diplerindeyiz.Dialogue: 0,0:15:55.83,0:16:00.06,Flashbacks,Roger,0,0,0,,Kimsiniz siz,  böylesi derin sularda ne konuşursunuz?!Dialogue: 0,0:16:00.71,0:16:03.81,Flashbacks,Roger,0,0,0,,Hey! Gösterin kendinizi!Dialogue: 0,0:16:09.09,0:16:10.98,Main,Sea King,0,0,0,,Neden acaba?Dialogue: 0,0:16:10.98,0:16:13.27,Main,Sea King,0,0,0,,Öyle hakikaten.Dialogue: 0,0:16:18.63,0:16:20.38,Main,Den,0,0,0,,Deniz Kralları mı?!Dialogue: 0,0:16:20.38,0:16:23.51,Main,Hachi,0,0,0,,Oha! Noah'yı çekiyorlar!Dialogue: 0,0:16:23.80,0:16:25.48,Main,Caimie,0,0,0,,Yiyecekler bizi!Dialogue: 0,0:16:29.96,0:16:32.80,Main,Sea King,0,0,0,,Gemi altüst olmuş.Dialogue: 0,0:16:33.60,0:16:38.70,Main,Sea King,0,0,0,,Onarılabilir mi acaba? Çalışıyor mu hâlâ?Dialogue: 0,0:16:39.17,0:16:40.48,Main,Sea King,0,0,0,,Kim bilir?Dialogue: 0,0:16:40.48,0:16:46.38,Main,Sea King,0,0,0,,Onarabilmek için "o klanın" gücüne ihtiyacımız olacak ama...Dialogue: 0,0:16:46.53,0:16:49.08,Main,Sea King,0,0,0,,...devir değişti.Dialogue: 0,0:16:50.35,0:16:52.72,Main,Sea King,0,0,0,,Onarılabilir mi acaba?Dialogue: 0,0:16:52.72,0:16:54.61,Main,Sea King,0,0,0,,Söz verilmiş o gün gelene kadar...Dialogue: 0,0:16:55.96,0:16:59.02,Main,Sea King,0,0,0,,...onarılır umarım.Dialogue: 0,0:17:04.15,0:17:08.45,Main,Guard,0,0,0,,Ryugu Sarayı'ndan bildiriyorum! Sol Bakanım, bunu duymak isteyebilirsiniz!Dialogue: 0,0:17:08.45,0:17:09.43,Main,Left Minister,0,0,0,,Ne oldu?Dialogue: 0,0:17:09.43,0:17:15.73,Main,Guard,0,0,0,,Daha önceden kaçırılmış deniz kızlarımızı, nasıl desem, sarayın içerisinde bulduk!Dialogue: 0,0:17:15.73,0:17:19.56,Main,Left Minister,0,0,0,,Ne?! İyiler mi peki?Dialogue: 0,0:17:19.56,0:17:23.35,Main,Guard,0,0,0,,Evet! Yaşadıkları sarsıntıyı üzerlerinden atabilmiş değiller henüz lakin...Dialogue: 0,0:17:23.86,0:17:26.73,Main,Guard,0,0,0,,...kendilerini kaçıran kişiyi çok net hatırlıyorlarmış!Dialogue: 0,0:17:27.06,0:17:30.30,Main,Guard,0,0,0,,Ayrıca hazine odası da bomboş!Dialogue: 0,0:17:30.67,0:17:34.09,Main,Guard,0,0,0,,Geriye tek bir parça hazine bırakılmamış.Dialogue: 0,0:17:34.53,0:17:37.59,Main,Guard,0,0,0,,Elbette buna ulusal hazinemiz olan Tamate Kutusu da dahil!Dialogue: 0,0:17:40.50,0:17:45.34,Main,Left Minister,0,0,0,,Kral-sama'm, birileri yokluğumuzu fırsat belleyip hazine odasını boşaltmış!Dialogue: 0,0:17:45.67,0:17:48.91,Main,Neptune,0,0,0,,Boşverin şimdi hazine hırsızını.Dialogue: 0,0:17:48.91,0:17:53.72,Main,Neptune,0,0,0,,Az öncesine kadar koca ülke elden gidiyordu-jamon.Dialogue: 0,0:17:54.78,0:17:59.66,Main,Neptune,0,0,0,,Ama her şeyden önce deniz kızlarımızın iyi olduğunu duyurmak gerekir tüm ülkeye.Dialogue: 0,0:17:59.66,0:18:04.21,Main,Neptune,0,0,0,,Biraz geç kalmış da olsak Hasır Şapkalar'ın adlarını temize çıkartmak gerekir-jamon.Dialogue: 0,0:18:05.74,0:18:07.74,Main,Neptune,0,0,0,,Çok yanlış yaptık!Dialogue: 0,0:18:12.84,0:18:18.34,Main,Jinbe,0,0,0,,O balonlarla uçarak kaçmaya çalışırsanız vururum sizi!Dialogue: 0,0:18:18.51,0:18:19.98,Main,Pirate,0,0,0,,Kahretsin ya!Dialogue: 0,0:18:19.98,0:18:23.55,Main,Pirate,0,0,0,,Acı bize Patron! Bırak gidelim!Dialogue: 0,0:18:23.55,0:18:26.10,Main,Pirate,0,0,0,,Hodyler'den korktuğumuz için yaptık her şeyi!Dialogue: 0,0:18:26.10,0:18:27.88,Main,Pirate,0,0,0,,Biz geçebiliriz değil mi?Dialogue: 0,0:18:27.88,0:18:30.54,Main,Pirate,0,0,0,,Bu adada olan savaşla  bir ilgimiz yok bizim, insanız biz!Dialogue: 0,0:18:30.72,0:18:35.53,Main,Pirate,0,0,0,,Bu adayı korsanların cebindeki paralarla geçinen turistik bir bölge sanmıştık!Dialogue: 0,0:18:35.60,0:18:37.57,Main,Pirate,0,0,0,,Bırak da gidelim!Dialogue: 0,0:18:37.75,0:18:41.76,Main,Jinbe,0,0,0,,Hepinizin de kellesini alacak değiller!Dialogue: 0,0:18:43.03,0:18:46.42,Main,Jinbe,0,0,0,,Neptune kraliyet ailesinin kararını bekleyeceksiniz!Dialogue: 0,0:18:48.93,0:18:53.30,Main,Left Minister,0,0,0,,Tüm ada sakinlerine duyurmak istediğimiz bir haber var.Dialogue: 0,0:18:54.07,0:18:56.47,Main,Left Minister,0,0,0,,Hasır Şapka tayfasının...Dialogue: 0,0:18:56.47,0:19:00.11,Main,Left Minister,0,0,0,,...deniz kızı kaçırma olayıyla bir ilgisi yoktur.Dialogue: 0,0:19:02.15,0:19:07.29,Main,Left Minister,0,0,0,,Araştırmalarımız süresinde hata yaptığımızı kabul ediyor...Dialogue: 0,0:19:07.29,0:19:11.84,Main,Left Minister,0,0,0,,...ve tüm sorumluluğu üstlenerek özürlerimizi sunmak istiyoruz.Dialogue: 0,0:19:11.84,0:19:15.30,Main,Citizen,0,0,0,,Ben zaten Hasır Şapkalar'ın bir şey yapmadığını biliyordum.Dialogue: 0,0:19:15.30,0:19:18.83,Main,Citizen,0,0,0,,Suçsuzlar diye ta en başından diyordum zaten!Dialogue: 0,0:19:18.83,0:19:20.18,Main,Citizen,0,0,0,,Yalancılar sizi!Dialogue: 0,0:19:20.18,0:19:23.97,Main,Citizen,0,0,0,,Hepimiz suçlu olduklarına kalpten inanmıştık işte!Dialogue: 0,0:19:25.86,0:19:28.08,Main,Citizen,0,0,0,,Yok yahu, biz onlara inanıyorduk değil mi?Dialogue: 0,0:19:28.08,0:19:28.59,Main,Citizen,0,0,0,,Öyle tabii...Dialogue: 0,0:19:28.59,0:19:30.12,Main,Citizen,0,0,0,,Yalancılar sizi!Dialogue: 0,0:19:30.12,0:19:31.18,Main,Citizen,0,0,0,,Sus bakayım!Dialogue: 0,0:19:31.18,0:19:32.49,Main,Citizen,0,0,0,,Şu saatten sonra kimi kandırıyo'sunuz!?Dialogue: 0,0:19:32.49,0:19:34.02,Main,Citizen,0,0,0,,Aynen öyle!Dialogue: 0,0:19:35.44,0:19:39.59,Main,Citizen,0,0,0,,Kabul edin işte, zerre güvenmedik onlara!Dialogue: 0,0:19:40.10,0:19:43.16,Main,Citizen,0,0,0,,Sırf insan oldukları için şüphe duyduk onlardan!Dialogue: 0,0:19:44.25,0:19:49.31,Main,Citizen,0,0,0,,İnsanlara hep böyle davrandık.Dialogue: 0,0:19:49.31,0:19:52.99,Main,Franky,0,0,0,,Süper...Dialogue: 0,0:19:52.99,0:19:54.96,Main,Franky,0,0,0,,...Afro!Dialogue: 0,0:19:54.96,0:19:57.22,Main,Brook,0,0,0,,Franky-san, harikuladeydi gerçekten!Dialogue: 0,0:19:57.22,0:19:58.24,Main,Franky,0,0,0,,Süper di' mi?Dialogue: 0,0:19:58.24,0:20:02.72,Main,Chopper,0,0,0,,Canavar Noktası'na geçtikten sonra yorgunluktan...Dialogue: 0,0:20:02.72,0:20:05.96,Main,Chopper,0,0,0,,...birkaç saat yürümem dahi imkansız oluyor.Dialogue: 0,0:20:05.96,0:20:09.60,Main,Chopper,0,0,0,,Ama böyle de sarabilirim yaralarınızı.Dialogue: 0,0:20:09.60,0:20:11.35,Main,Chopper,0,0,0,,Var mı ezik, çizik?Dialogue: 0,0:20:11.35,0:20:13.46,Main,Zoro,0,0,0,,Bak şu konuşana derler adama!Dialogue: 0,0:20:13.46,0:20:14.92,Main,Robin,0,0,0,,Herkes gayet iyi gibi.Dialogue: 0,0:20:14.92,0:20:16.63,Main,Sanji,0,0,0,,Robin-chan!Dialogue: 0,0:20:16.63,0:20:19.47,Main,Sanji,0,0,0,,Ben de çok mükemmel bir teknik kullandığımdan hareket edemiyorum!Dialogue: 0,0:20:19.47,0:20:21.47,Main,Sanji,0,0,0,,Ben de kafacığımı o güzel bacacıklarına yaslayıvereyim!Dialogue: 0,0:20:21.47,0:20:22.93,Main,Sanji,0,0,0,,Olar mı?!Dialogue: 0,0:20:22.93,0:20:24.79,Main,Zoro,0,0,0,,Geber kal olduğun yerde!Dialogue: 0,0:20:24.79,0:20:26.17,Main,Sanji,0,0,0,,Sen geber kal!Dialogue: 0,0:20:27.19,0:20:28.14,Main,Nami,0,0,0,,Luffy.Dialogue: 0,0:20:28.65,0:20:30.43,Main,Citizen,0,0,0,,Prensler bunlar!Dialogue: 0,0:20:37.13,0:20:38.15,Main,Citizen,0,0,0,,Hody?!Dialogue: 0,0:20:38.15,0:20:40.45,Main,Citizen,0,0,0,,Vander Decken?!Dialogue: 0,0:20:40.45,0:20:44.16,Main,Fukaboshi,0,0,0,,Babacığım, sizi merakta koyduğumuz için bağışlayın!Dialogue: 0,0:20:44.49,0:20:46.75,Main,Neptune,0,0,0,,İyiliğiniz her şeylerden önce-jamon.Dialogue: 0,0:20:51.55,0:20:55.34,Main,Fukaboshi,0,0,0,,Millet, içiniz rahat olsun!Dialogue: 0,0:20:55.34,0:20:58.55,Main,Fukaboshi,0,0,0,,Bir daha sorun çıkartmalarına müsaade etmeyeceğiz!Dialogue: 0,0:21:01.93,0:21:04.70,Main,Citizen,0,0,0,,Artık korkusuzca yaşayabileceğiz!Dialogue: 0,0:21:06.33,0:21:10.86,Main,Citizen,0,0,0,,Balık Adam Bölgesi'nde o kadar korkunç birinin var olduğuna inanamıyorum!Dialogue: 0,0:21:12.27,0:21:14.61,Main,Citizen,0,0,0,,Ka-Kaptan Hody!Dialogue: 0,0:21:14.61,0:21:16.09,Main,Citizen,0,0,0,,Canavar gibi olmuş?!Dialogue: 0,0:21:19.09,0:21:21.42,Main,Franky,0,0,0,,Helal gerçekten!Dialogue: 0,0:21:25.28,0:21:26.52,Main,Sanji,0,0,0,,Şu şey değil mi?Dialogue: 0,0:21:26.52,0:21:28.59,Main,Brook,0,0,0,,Döndüler sonunda!Dialogue: 0,0:21:28.59,0:21:29.87,Main,Brook,0,0,0,,Luffy-san!Dialogue: 0,0:21:29.87,0:21:32.67,Main,Citizen,0,0,0,,Hasır Şapkalı Luffy'yle Prenses Shirahoshi bunlar!Dialogue: 0,0:21:32.89,0:21:35.37,Main,Shirahoshi,0,0,0,,Yardım edin lütfen!Dialogue: 0,0:21:35.37,0:21:39.99,Main,Shirahoshi,0,0,0,,Luffy-sama'nın kanaması bir türlü durmuyor!Dialogue: 0,0:21:41.52,0:21:45.31,Main,Shirahoshi,0,0,0,,Luffy-sama!  Bizim için imkansızı yapmaya çalıştı!Dialogue: 0,0:21:45.31,0:21:46.36,Main,Citizen,0,0,0,,Hasır Şapka!Dialogue: 0,0:21:48.21,0:21:52.18,Main,Chopper,0,0,0,,Durum vahim! Çantamda kan kesiciler vardı!Dialogue: 0,0:21:53.36,0:21:54.38,Main,Chopper,0,0,0,,Bulsana onları, Robin!Dialogue: 0,0:21:54.38,0:21:55.65,Main,Robin,0,0,0,,Hemen.Dialogue: 0,0:21:55.65,0:21:59.04,Main,Usopp,0,0,0,,Şu noktadan öte kendini nasıl idame ettireceksin çok merak ediyorum doktor!?Dialogue: 0,0:21:59.04,0:22:00.79,Main,Chopper,0,0,0,,Tamam, iyi böyle!Dialogue: 0,0:22:01.81,0:22:02.86,Main,Robin,0,0,0,,Hareket işini bana bırak sen!Dialogue: 0,0:22:02.86,0:22:05.16,Main,Usopp,0,0,0,,Tuhaf bir doktor görüş alanıma girdi!Dialogue: 0,0:22:05.16,0:22:06.95,Main,Chopper,0,0,0,,Biraz sola git sola.Dialogue: 0,0:22:06.95,0:22:09.78,Main,Shirahoshi,0,0,0,,Luffy-sama iyileşecek mi acaba?!Dialogue: 0,0:22:09.78,0:22:13.50,Main,Chopper,0,0,0,,Kanamayı durdurabilirim ama halihazırda çok kan kaybetmiş durumda!Dialogue: 0,0:22:13.50,0:22:15.03,Main,Chopper,0,0,0,,Bu şekilde kurtulamaz!Dialogue: 0,0:22:15.03,0:22:16.05,Main,Brook,0,0,0,,Ne?!Dialogue: 0,0:22:16.05,0:22:19.65,Main,Sanji,0,0,0,,Aramızda Luffy dışında F grubu kanı olan yok.Dialogue: 0,0:22:19.65,0:22:20.93,Main,Usopp,0,0,0,,Yandık o zaman!Dialogue: 0,0:22:20.93,0:22:23.51,Main,Franky,0,0,0,,Alanda birilerinde vardır kesin!Dialogue: 0,0:22:23.51,0:22:24.28,Main,Chopper,0,0,0,,Kimsede yok mu?!Dialogue: 0,0:22:24.28,0:22:25.69,Main,Franky,0,0,0,,Hey!Dialogue: 0,0:22:25.69,0:22:27.74,Thoughts,Citizen,0,0,0,,Benim grubum F.Dialogue: 0,0:22:27.74,0:22:29.59,Thoughts,Citizen,0,0,0,,Benim de F ama...Dialogue: 0,0:22:29.59,0:22:32.51,Main,Citizen,0,0,0,,Baba, senin F'ti di' mi?Dialogue: 0,0:22:32.51,0:22:33.89,Main,Citizen,0,0,0,,Şey, ben, aslında...Dialogue: 0,0:22:33.89,0:22:39.39,Main,Chopper,0,0,0,,Tabii ya!  Burada insanlara kan vermek yasaktı!Dialogue: 0,0:22:40.45,0:22:43.65,Main,Nami,0,0,0,,Nasıl kanunmuş o öyle?  Utanın kendinizden!Dialogue: 0,0:22:43.65,0:22:46.41,Main,Franky,0,0,0,,Yalvarıyorum! Luffy'nin hayatı söz konusu!Dialogue: 0,0:22:48.06,0:22:52.94,Main,Shirahoshi,0,0,0,,Benimkinin grubu tutmuyor ama o da kırmızı!Dialogue: 0,0:22:52.94,0:22:54.21,Main,Shirahoshi,0,0,0,,Olmaz mı ki?!Dialogue: 0,0:22:54.21,0:22:56.73,Main,Chopper,0,0,0,,Olmaz ama düşünmen bile yetti!Dialogue: 0,0:22:56.73,0:22:58.80,Main,Citizen,0,0,0,,Prenses Shirahoshi...Dialogue: 0,0:22:58.80,0:23:02.04,Main,Chopper,0,0,0,,Tabii ya! İnsan korsanlar da vardı!Dialogue: 0,0:23:11.88,0:23:14.21,Main,Jinbe,0,0,0,,Benim kanımı alın!Dialogue: 0,0:23:15.52,0:23:19.27,Main,Jinbe,0,0,0,,F'tir! Alın ne kadarı lazımsa!Dialogue: 0,0:23:19.27,0:23:20.58,Main,Usopp,0,0,0,,Jinbe!Dialogue: 0,0:23:20.58,0:23:21.56,Main,Nami,0,0,0,,Jinbe-chan!Dialogue: 0,0:23:21.56,0:23:23.85,Main,Chopper,0,0,0,,Olur ama kurallarınız...?!Dialogue: 0,0:23:23.85,0:23:27.06,Main,Jinbe,0,0,0,,Korsanım ben be!Dialogue: 0,0:23:27.06,0:23:30.16,Main,Citizen,0,0,0,,Patron, şükürler olsun!Dialogue: 0,0:23:30.16,0:23:31.18,Main,Citizen,0,0,0,,Jinbe-san!Dialogue: 0,0:23:31.18,0:23:32.89,Main,Citizen,0,0,0,,Teşekkür ederiz!Dialogue: 0,0:23:34.31,0:23:36.31,Main,Left Minister,0,0,0,,Jinbe, sen-Dialogue: 0,0:23:36.31,0:23:38.09,Main,Neptune,0,0,0,,Böylesi âlâ-jamon.Dialogue: 0,0:23:38.09,0:23:39.48,Main,Left Minister,0,0,0,,Kral'ım!Dialogue: 0,0:23:39.48,0:23:45.42,Main,Neptune,0,0,0,,Ne olmuş yani? Pas tutmuş kurallarımız da aslında...Dialogue: 0,0:23:45.42,0:23:47.09,Main,Neptune,0,0,0,,...birer lanet-jamon.Dialogue: 0,0:24:07.49,0:24:10.04,Main,Chopper,0,0,0,,Jinbe, biraz canın yanacak.Dialogue: 0,0:24:10.04,0:24:11.20,Main,Jinbe,0,0,0,,Âlâ!Dialogue: 0,0:24:33.16,0:24:34.73,Narrator,Narrator,0,0,0,,Canlar da yaksan...Dialogue: 0,0:24:43.80,0:24:45.47,Narrator,Narrator,0,0,0,,...canını da yaksalar...Dialogue: 0,0:24:51.37,0:24:54.46,Narrator,Narrator,0,0,0,,...akacak şey aynı kırmızı kan olacaktır.Dialogue: 0,0:25:05.10,0:25:08.96,Narrator,Narrator,0,0,0,,Aslında yol bile sayılamayacak daracık bir doğrultu!Dialogue: 0,0:25:08.96,0:25:14.09,Narrator,Narrator,0,0,0,,İncecik, küçücük bir delik! Lakin işte bu sayede...Dialogue: 0,0:25:20.40,0:25:23.46,Narrator,Narrator,0,0,0,,...korkutan önyargılar ve...Dialogue: 0,0:25:35.15,0:25:37.95,Narrator,Narrator,0,0,0,,...öncesinde akmış kanlar için verilen savaşlardan...Dialogue: 0,0:25:43.74,0:25:46.34,Narrator,Narrator,0,0,0,,...bu kadar kolay sıyrılabiliyor bu yol.Dialogue: 0,0:25:49.75,0:25:52.01,Narrator,Narrator,0,0,0,,Tüm yanılsamalardan uzak,...Dialogue: 0,0:25:53.03,0:25:57.98,Narrator,Narrator,0,0,0,,...gerçekte de orada var olan aydınlığa uzanan o yol.Dialogue: 0,0:26:08.58,0:26:10.11,Main,Luffy,0,0,0,,Jinbe.Dialogue: 0,0:26:10.91,0:26:13.83,Main,Shirahoshi,0,0,0,,Luffy-sama, yaşıyorsunuz!Dialogue: 0,0:26:13.83,0:26:14.99,Main,The crew,0,0,0,,Luffy!Dialogue: 0,0:26:14.99,0:26:16.70,Main,Citizens,0,0,0,,Luffy!Dialogue: 0,0:26:16.78,0:26:20.67,Main,Jinbe,0,0,0,,Bak sen? Hemen kendine gelmişsin!Dialogue: 0,0:26:24.13,0:26:25.66,Main,Citizens,0,0,0,,Hasır Şapka!Dialogue: 0,0:26:25.66,0:26:26.97,Main,Citizens,0,0,0,,Luffy!Dialogue: 0,0:26:54.65,0:26:58.29,Main,Fukaboshi,0,0,0,,Her şeye sünger çektiğimiz ândır bu!Dialogue: 0,0:27:02.01,0:27:03.10,Main,Fukaboshi,0,0,0,,Anneciğim!Dialogue: 0,0:27:17.63,0:27:19.16,Main,Luffy,0,0,0,,Bak ne diyeceğim, Jinbe...Dialogue: 0,0:27:30.96,0:27:34.82,Main,Luffy,0,0,0,,Tayfama katılsana!Dialogue: 0,0:27:36.64,0:27:39.23,Main,Citizen,0,0,0,,Kraliyet ailesi kararını verdi!Dialogue: 0,0:27:41.46,0:27:43.74,Main,Pirate,0,0,0,,Yaşasın be! Özgürüz!Dialogue: 0,0:27:44.40,0:27:46.77,Main,Pirate,0,0,0,,Lanet olası Hody! Şu haline bir bak!Dialogue: 0,0:27:47.85,0:27:50.74,Main,Pirate,0,0,0,,Sonsuza dek köle olarak kalacağım sandım!Dialogue: 0,0:27:50.74,0:27:54.56,Main,Pirate,0,0,0,,Hasır Şapka Tayfasına hayatlarımızı borçluyuz!Dialogue: 0,0:27:54.56,0:27:56.89,Main,Pirate,0,0,0,,Korsanlar Kralı olmaya gidiyorum!Dialogue: 0,0:27:56.89,0:27:59.04,Main,Pirate,0,0,0,,Ne? Sanki biraz...Dialogue: 0,0:27:59.04,0:28:00.36,Main,Pirate,0,0,0,,Aptal! Olacağım işte!Dialogue: 0,0:28:00.36,0:28:04.72,Main,Pirate,0,0,0,,Sonunda yeni dünyaya yelken açabileceğiz!Dialogue: 0,0:28:04.72,0:28:08.58,Main,Right Minister,0,0,0,,Hody'e karşı besledikleri kini  tüm balık adamlardan çıkartmaya çalışmasınlar?Dialogue: 0,0:28:08.58,0:28:15.50,Main,Neptune,0,0,0,,O ayrı mevzu. Bu ada aslen korsanlar için seyahat ve dinlenme yeriydi.Dialogue: 0,0:28:15.50,0:28:18.56,Main,Neptune,0,0,0,,Ayrıca bizlere karşı kötü bir niyetleri olmadığından...Dialogue: 0,0:28:18.56,0:28:21.62,Main,Neptune,0,0,0,,...onları burada esir tutmanın da  bir anlamı yok-jamon.Dialogue: 0,0:28:21.62,0:28:26.05,Main,Neptune,0,0,0,,Şimdi, geri kalan Yeni Balık Adam  Korsanları'na gelecek olursak...Dialogue: 0,0:28:26.05,0:28:28.33,Main,Pirate,0,0,0,,Hayatlarımızı bağışla!Dialogue: 0,0:28:28.33,0:28:29.81,Main,Pirate,0,0,0,,Acı bize!Dialogue: 0,0:28:29.81,0:28:35.36,Main,Pirate,0,0,0,,Kraliçeyi öldüren kişinin Hody olduğunu bilmiyorduk!Dialogue: 0,0:28:35.36,0:28:37.18,Main,Pirate,0,0,0,,Hepsi de kafayı sıyırmışlar ciddi ciddi!Dialogue: 0,0:28:37.18,0:28:38.99,Main,Neptune,0,0,0,,Sizlerden...Dialogue: 0,0:28:40.01,0:28:43.03,Main,Neptune,0,0,0,,Balık Adam Adası'nda yaşamanızı istiyorum!Dialogue: 0,0:28:43.03,0:28:45.01,Main,Pirate,0,0,0,,Neee?!Dialogue: 0,0:28:45.01,0:28:48.35,Main,Pirate,0,0,0,,Ne dedin sen?! Bizlerden yasalara uygun bir şekilde yaşamamızı mı istiyorsun?!Dialogue: 0,0:28:48.35,0:28:51.12,Main,Pirate,0,0,0,,Her türlü Hody için çalışmaktan iyidir!Dialogue: 0,0:28:51.12,0:28:55.75,Main,Citizen,0,0,0,,Olmaz ama böyle, Kral'ım! Öyleleri aramızda dolaşırsa...Dialogue: 0,0:28:55.75,0:28:58.43,Main,Citizen,0,0,0,,Çocuklarımızı korkudan dışarı salamayız!Dialogue: 0,0:28:59.86,0:29:02.93,Main,Neptune,0,0,0,,Elbette yaptıklarının bedelini ödeyecek...Dialogue: 0,0:29:02.93,0:29:05.54,Main,Neptune,0,0,0,,...ve ordumun gözetiminde çalışacaklar-jamon.Dialogue: 0,0:29:05.54,0:29:10.89,Main,Neptune,0,0,0,,Her birinize gücünüzü değerlendirebileceğiniz işler vereceğim.Dialogue: 0,0:29:10.89,0:29:13.38,Main,Neptune,0,0,0,,Kontrolden çıkmış Balık Adam Bölgesi,...Dialogue: 0,0:29:13.38,0:29:17.23,Main,Neptune,0,0,0,,...bugünden öte kapatılmıştır-jamon.Dialogue: 0,0:29:18.72,0:29:21.85,Narrator,Narrator,0,0,0,,Kraliçe Otohime'nin gerçek katiliyle birlikte...Dialogue: 0,0:29:21.85,0:29:25.57,Narrator,Narrator,0,0,0,,...balık adamların karanlık tarafları da gün yüzüne çıkmıştı.Dialogue: 0,0:29:26.23,0:29:30.01,Narrator,Narrator,0,0,0,,Korsan Hody Jones'un Balık Adam Adası'nı ele geçirme planı...Dialogue: 0,0:29:31.51,0:29:36.93,Narrator,Narrator,0,0,0,,...adadan gelip geçmekte olan bir avuç korsan tarafından engellenmişti.Dialogue: 0,0:29:39.05,0:29:40.18,Main,Neptune,0,0,0,,Hey.Dialogue: 0,0:29:40.76,0:29:43.23,Main,Neptune,0,0,0,,Hasır Şapkalı Luffy, nerede-jamon?Dialogue: 0,0:29:43.23,0:29:46.37,Main,Fukaboshi,0,0,0,,Nasıl desem... Kaçtılar!Dialogue: 0,0:29:46.37,0:29:47.60,Main,Neptune,0,0,0,,Kaçtılar mı?Dialogue: 0,0:29:47.89,0:29:52.56,Main,Shirahoshi,0,0,0,,Niye böyle kaçar gibi meydandan ayrıldınız ki?Dialogue: 0,0:29:52.56,0:29:54.38,Main,Zoro,0,0,0,,Aptal aptal sorular sormasana!Dialogue: 0,0:29:54.38,0:29:57.90,Main,Zoro,0,0,0,,Onca insanın önünde savaştıktan sonra...Dialogue: 0,0:29:57.90,0:30:01.92,Main,Zoro,0,0,0,,...orada kalacak olsaydık kahraman muamelesi falan görürdük kesin.Dialogue: 0,0:30:01.92,0:30:04.76,Main,Zoro,0,0,0,,Düşüncesi bile içimi ürpertiyor.Dialogue: 0,0:30:05.20,0:30:08.44,Main,Shirahoshi,0,0,0,,Kahraman olmak kötü bir şey mi ki?Dialogue: 0,0:30:08.44,0:30:15.14,Main,Zoro,0,0,0,,Bak beni dinle, kahraman dediğin kişi sakesini başkalarıyla paylaşan kişidir.Dialogue: 0,0:30:15.14,0:30:16.89,Main,Zoro,0,0,0,,Bense bütün sakeyi kendim içmek istiyorum!Dialogue: 0,0:30:16.89,0:30:20.02,Main,Nami,0,0,0,,Bu ne şimdi ya?!  Ne acayip kahramanlık tanımlarınız var sizin!?Dialogue: 0,0:30:20.02,0:30:22.28,Main,Luffy,0,0,0,,Neden katılmıyorsun ki tayfama, Jinbe?!Dialogue: 0,0:30:22.28,0:30:24.10,Main,Luffy,0,0,0,,Hadi birlikte maceralara bayrak açalım!Dialogue: 0,0:30:24.10,0:30:27.41,Main,Luffy,0,0,0,,Denizlere açılalım!  Çok eğlenceli olacak bak!Dialogue: 0,0:30:27.41,0:30:29.60,Main,Usopp,0,0,0,,Aynen! Katıl bize, Patron!Dialogue: 0,0:30:29.60,0:30:32.95,Main,Chopper,0,0,0,,Yanımızda bir tane eski Shichibukai olması acayip havalı olur hem!Dialogue: 0,0:30:32.95,0:30:35.50,Main,Chopper,0,0,0,,O değil de Luffy, senin iyice dinlenmen lazım!Dialogue: 0,0:30:37.21,0:30:40.49,Main,Jinbe,0,0,0,,Size şimdi katılmam imkansız diyorum!Dialogue: 0,0:30:41.58,0:30:45.44,Main,Jinbe,0,0,0,,Teklifiniz bile beni göklere uçurmaya yetti...Dialogue: 0,0:30:45.44,0:30:49.95,Main,Jinbe,0,0,0,,...ve sizlerle birlikte denizlere açılmanın çok eğlenceli olacağına da hiç şüphem yok.Dialogue: 0,0:30:50.50,0:30:54.97,Main,Jinbe,0,0,0,,Ama hâlâ halledilmesi gereken işlerim var.Dialogue: 0,0:30:54.97,0:31:01.24,Main,Jinbe,0,0,0,,Halihazırda almış olduğum sorumluluklar var. Biraz uzak kaldım onlardan sadece.Dialogue: 0,0:31:02.01,0:31:08.09,Main,Jinbe,0,0,0,,Üzerime düşenleri yapıp kendi zincirlerimi elime alır almaz...Dialogue: 0,0:31:08.09,0:31:13.23,Main,Jinbe,0,0,0,,...sizleri görmeye geleceğim konusunda söz veriyorum.Dialogue: 0,0:31:14.21,0:31:19.37,Main,Jinbe,0,0,0,,Hülasa o zaman hâlâ aynı fikirde olursanız...Dialogue: 0,0:31:19.37,0:31:24.01,Main,Jinbe,0,0,0,,...teklifinizi seve seve kabul ederim, Hasır Şapka tayfası!Dialogue: 0,0:31:24.01,0:31:25.24,Main,Luffy,0,0,0,,Bak kesin geleceksin ama?!Dialogue: 0,0:31:30.45,0:31:35.51,Main,Sanji,0,0,0,,Az dur bakalım, erkek kimisi sorumluluklarından bahsederken böyle sıkıştıramazsın!Dialogue: 0,0:31:35.51,0:31:37.30,Main,Robin,0,0,0,,Epey alıştılar birbirlerine.Dialogue: 0,0:31:43.85,0:31:48.48,Main,Franky,0,0,0,,Luffy'nin saygı duyduğu bir adamsın sonuçta! Bekleyeceğiz seni, Jinbe!Dialogue: 0,0:31:49.68,0:31:51.79,Main,Jinbe,0,0,0,,Peki o vakit, teşekkür ettim!Dialogue: 0,0:31:52.34,0:31:53.98,Main,Zoro,0,0,0,,Planımız nedir peki?Dialogue: 0,0:31:55.04,0:31:56.38,Main,Zoro,0,0,0,,Hemen Yeni Dünya'ya mı devam edeceğiz?Dialogue: 0,0:31:57.99,0:32:01.04,Main,Shirahoshi,0,0,0,,Hemencecik ayrılıyor musunuz?!Dialogue: 0,0:32:01.04,0:32:05.41,Main,Shirahoshi,0,0,0,,Size teşekkür edemedim henüz, düzgünce oturup konuşamadım bile sizinle...Dialogue: 0,0:32:05.41,0:32:10.40,Main,Sanji,0,0,0,,Tamam o zaman! Deniz Kızı Kafesi'nde birkaç hafta kalalım derim ben!Dialogue: 0,0:32:10.40,0:32:12.99,Main,Usopp,0,0,0,,Hep kendini düşünüyorsun var ya!Dialogue: 0,0:32:12.99,0:32:14.26,Main,Usopp,0,0,0,,Gerçi ben de gitmek istiyorum!Dialogue: 0,0:32:15.24,0:32:16.96,Main,Guard,0,0,0,,Hey! Bekleyin biraz!Dialogue: 0,0:32:17.68,0:32:19.33,Main,Luffy,0,0,0,,Ne oldu ki?Dialogue: 0,0:32:19.33,0:32:21.66,Main,Usopp,0,0,0,,Neptune ordusunun askerlerinden bu!Dialogue: 0,0:32:21.66,0:32:24.06,Main,Guard,0,0,0,,Bekleyin, Hasır Şapka ahalisi!Dialogue: 0,0:32:24.50,0:32:27.27,Main,Guard,0,0,0,,Neptune Kral'ım! Gemiyi yakalamayı başardım!Dialogue: 0,0:32:27.27,0:32:29.89,Main,Neptune,0,0,0,,Çok şükür. Luffy-kun!Dialogue: 0,0:32:29.89,0:32:31.49,Main,Neptune,0,0,0,,Neden çekip gittiniz hemen?Dialogue: 0,0:32:31.49,0:32:32.45,Main,Neptune,0,0,0,,Daha size-Dialogue: 0,0:32:32.45,0:32:34.51,Main,Luffy,0,0,0,,Kahraman olmak istemiyorum ben!Dialogue: 0,0:32:34.51,0:32:37.54,Main,Neptune,0,0,0,,Farkındayım! Ziyafet düzenleyelim!Dialogue: 0,0:32:37.54,0:32:40.41,Main,Neptune,0,0,0,,Düzenleyemediğimiz o ziyafeti-jamon!Dialogue: 0,0:32:40.41,0:32:41.83,Main,Luffy,0,0,0,,Ziyafet mi!?Dialogue: 0,0:32:41.83,0:32:45.37,Main,Luffy,0,0,0,,Tamamdır!  Hachi'yle Camieler'i de alıp yardıralım!Dialogue: 0,0:32:49.23,0:32:53.12,Narrator,Narrator,0,0,0,,Neptune'ün emriyle Balık Adam Bölgesi derhal mühürlendi.Dialogue: 0,0:32:56.15,0:33:01.32,Narrator,Narrator,0,0,0,,Hody'nin kendisi, Yeni Balık Adam Korsanları üst düzey üyeleri ve Vander Decken'se...Dialogue: 0,0:33:01.32,0:33:04.12,Narrator,Narrator,0,0,0,,...Tutsak Kulesi'ne hapsedildiler.Dialogue: 0,0:33:08.60,0:33:12.03,Main,Guard,0,0,0,,Sana güveniyoruz Kraken! Götür şunu uzaklara!Dialogue: 0,0:33:12.03,0:33:15.56,Main,Guard,0,0,0,,Wadatsumi, seni koyabileceğimiz bir hücremiz yok!Dialogue: 0,0:33:15.56,0:33:19.13,Main,Guard,0,0,0,,Bu ülkeye girişin yasaklanmıştır!Dialogue: 0,0:33:20.55,0:33:21.81,Main,Citizen,0,0,0,,Yakaladınız mı?Dialogue: 0,0:33:21.81,0:33:23.50,Main,Citizen,0,0,0,,Evet!Dialogue: 0,0:33:23.50,0:33:26.85,Main,Citizen,0,0,0,,Pekâlâ öyleyse, hazırlayalım şunları da Ryugu Sarayı'na götürelim!Dialogue: 0,0:33:26.85,0:33:29.94,Main,Citizen,0,0,0,,Hasır Şapkalar'la birlikte devasa bir ziyafet vereceklermiş!Dialogue: 0,0:33:29.94,0:33:31.22,Main,Citizen,0,0,0,,Sen bize bırak o işi!Dialogue: 0,0:33:31.73,0:33:34.28,Main,Citizen,0,0,0,,Deniz canavarı eti seviyorlarmış diye duyduk!Dialogue: 0,0:33:34.68,0:33:37.23,Main,Citizen,0,0,0,,Şekerlemeler ve pastalar da götürelim!Dialogue: 0,0:33:37.23,0:33:39.05,Main,Citizen,0,0,0,,Çok yiyorlarmış diye duydum!Dialogue: 0,0:33:39.05,0:33:40.36,Main,Citizen,0,0,0,,Ne var ne yok götürelim!Dialogue: 0,0:33:40.36,0:33:44.44,Main,Citizen,0,0,0,,Sakeler yetecek miymiş?! Elimdeki en iyi sakeleri götürüyorum onlara!Dialogue: 0,0:33:44.73,0:33:48.08,Main,Neptune,0,0,0,,Hoş geldiniz-jamon! Luffy-kun ve değerli tayfası...Dialogue: 0,0:33:48.08,0:33:50.70,Main,Neptune,0,0,0,,Muhabbeti ziyafetten sonrasına saklayalım.Dialogue: 0,0:33:51.14,0:33:54.09,Main,Neptune,0,0,0,,Dere pisileri sizleri ziyafetin verileceği salona getirecekler!Dialogue: 0,0:33:54.38,0:33:56.64,Main,Luffy,0,0,0,,Vay canına! Amma da büyük fareler bunlar ha!Dialogue: 0,0:33:56.64,0:33:57.66,Main,Zoro,0,0,0,,Yassı balık bunlar.Dialogue: 0,0:33:57.66,0:33:59.66,Main,Usopp,0,0,0,,Adam az önce dere pisisi dedi.Dialogue: 0,0:34:05.49,0:34:07.82,Main,Nami,0,0,0,,Ağzına kadar su dolu kapkaranlık bir oda...Dialogue: 0,0:34:07.82,0:34:11.21,Main,Caimie,0,0,0,,Biz de geldik ama oldu mu ki böyle? Gerim gerim gerildim!Dialogue: 0,0:34:12.52,0:34:14.59,Main,Hachi,0,0,0,,Hayatımda ilk defa Ryugu Sarayı'na giriyorum!Dialogue: 0,0:34:14.59,0:34:16.78,Main,Luffy,0,0,0,,Burası neresi? Et nerede? Ziyafet nerede?Dialogue: 0,0:34:18.13,0:34:20.35,Main,Guard,0,0,0,,İşte, kahramanlarımız geldiler!Dialogue: 0,0:34:22.17,0:34:25.01,Main,Chopper,0,0,0,,Aşağısı ağzına kadar asker dolu!Dialogue: 0,0:34:25.01,0:34:30.69,Main,Guard,0,0,0,,Kahramanlarımız! Kahramanlarımız! Kahramanlarımız!Dialogue: 0,0:34:30.69,0:34:35.28,Main,Luffy,0,0,0,,Kesin be! Kahraman kahraman demeyi kesin de et getirin bana!Dialogue: 0,0:34:36.01,0:34:39.10,Main,Zoro,0,0,0,,Aynen öyle! Sake içmek istiyorum ben!Dialogue: 0,0:34:41.07,0:34:42.27,Main,Nami,0,0,0,,Bunlar var ya...Dialogue: 0,0:34:42.64,0:34:46.10,Main,Shirahoshi,0,0,0,,Luffy-sama! Sunucu sahneye çıktı!Dialogue: 0,0:34:48.72,0:34:49.96,Main,Luffy,0,0,0,,Sahne mi?Dialogue: 0,0:34:50.10,0:34:53.31,Main,Voice,0,0,0,,Öncelikle huzurlarınıza derin denizlerin en ünlü divasını takdim ediyoruz!Dialogue: 0,0:34:53.31,0:34:55.35,Main,Voice,0,0,0,,Maria Napole!Dialogue: 0,0:35:34.06,0:35:36.94,Main,Voice,0,0,0,,Ve elbette Swing Caz Orkestrası!Dialogue: 0,0:35:48.01,0:35:50.48,Main,Nami,0,0,0,,Anam! Ne tatlı bir sestir bu böyle!?Dialogue: 0,0:35:50.48,0:35:52.60,Main,Usopp,0,0,0,,Ölürüm, Maria-sama!Dialogue: 0,0:35:52.60,0:35:55.62,Main,Brook,0,0,0,,Ruhum coştu resmen!Dialogue: 0,0:36:05.09,0:36:07.78,Main,Voice,0,0,0,,Ve çok özel konuklarımız!Dialogue: 0,0:36:08.80,0:36:10.30,Main,Sanji,0,0,0,,Yo-Yoksa...Dialogue: 0,0:36:16.96,0:36:20.64,Main,Voice,0,0,0,,Güzellikleri tüm krallıkta dillere destan...Dialogue: 0,0:36:33.24,0:36:37.10,Main,Voice,0,0,0,,...Deniz Kızı Kafesi Dansçıları!Dialogue: 0,0:36:46.68,0:36:47.70,Main,Chopper,0,0,0,,Ağzını kapa!Dialogue: 0,0:36:57.20,0:36:58.95,Main,Chopper,0,0,0,,Öleceksin be, Sanji!Dialogue: 0,0:37:00.99,0:37:04.38,Main,Brook,0,0,0,,Güzelliğini yansıtamaz hiçbir resim! Bir numarasın!Dialogue: 0,0:37:06.82,0:37:08.71,Main,Brook,0,0,0,,Gücüm kalmadı...Dialogue: 0,0:37:08.71,0:37:09.51,Main,Robin,0,0,0,,Bak sen!Dialogue: 0,0:37:09.51,0:37:10.68,Main,Usopp,0,0,0,,Süper be!Dialogue: 0,0:37:10.68,0:37:11.77,Main,Nami,0,0,0,,Büyüleyici gerçekten!Dialogue: 0,0:37:14.18,0:37:15.96,Main,Ishilly,0,0,0,,Caimie!Dialogue: 0,0:37:15.96,0:37:18.91,Main,Caimie,0,0,0,,Ishilly! İyi olmana çok sevindim!Dialogue: 0,0:37:22.73,0:37:25.50,Main,Zoro,0,0,0,,İşte beklediğim şey! Bu olmadan ziyafetin tadı olmuyor!Dialogue: 0,0:37:27.35,0:37:29.36,Main,Franky,0,0,0,,Süper, ben de bunu bekliyordum!Dialogue: 0,0:37:29.36,0:37:31.11,Main,Pappagg,0,0,0,,Boşuna Ryugu Sarayı demiyorlar buraya!Dialogue: 0,0:37:32.17,0:37:33.00,Main,Robin,0,0,0,,Teşekkür ederim.Dialogue: 0,0:37:33.77,0:37:34.68,Main,Jinbe,0,0,0,,Sağ olasın.Dialogue: 0,0:37:35.15,0:37:35.95,Main,Princes,0,0,0,,Teşekkür ederiz.Dialogue: 0,0:37:36.24,0:37:38.90,Main,Sanji,0,0,0,,Deniz Kızcıkları!Dialogue: 0,0:37:42.62,0:37:43.94,Main,Princess,0,0,0,,Çok teşekkür ederim.Dialogue: 0,0:37:44.08,0:37:48.01,Main,Everyone,0,0,0,,Şerefe!Dialogue: 0,0:37:48.01,0:37:50.52,Main,Nami,0,0,0,,Haydi bakalım, içelim güzelleşelim!Dialogue: 0,0:37:53.65,0:37:54.89,Main,Luffy,0,0,0,,Acayip bi'şey!Dialogue: 0,0:37:54.89,0:37:56.35,Main,Mermad,0,0,0,,Bol bol getirdik!Dialogue: 0,0:37:56.35,0:37:58.28,Thoughts,Sanji,0,0,0,,Ay ölüyorum, kemik!Dialogue: 0,0:37:58.28,0:37:59.88,Main,Chopper,0,0,0,,Sanji!Dialogue: 0,0:38:03.16,0:38:05.16,Main,Mermaid,0,0,0,,Böyle fazla zorlama kendini ama abi!Dialogue: 0,0:38:05.96,0:38:07.64,Main,Shirahoshi,0,0,0,,Babacığım!Dialogue: 0,0:38:07.64,0:38:08.80,Main,Neptune,0,0,0,,Shirahoshi.Dialogue: 0,0:38:09.31,0:38:10.55,Main,Luffy,0,0,0,,Şerefe!Dialogue: 0,0:38:10.99,0:38:14.41,Main,Neptune,0,0,0,,Şerefe-jamon! Aman neyse ne artık-jamon!Dialogue: 0,0:38:16.01,0:38:18.16,Main,Luffy,0,0,0,,Size de şerefe!Dialogue: 0,0:38:18.16,0:38:19.26,Main,Guards,0,0,0,,Şerefe!Dialogue: 0,0:38:19.98,0:38:22.75,Main,Robin,0,0,0,,Çok leziz sakeymiş. Su farklı olduğu için mi acaba?Dialogue: 0,0:38:22.75,0:38:25.88,Main,Left Minister,0,0,0,,Farkı anlayabildiniz demek, genç hanım?Dialogue: 0,0:38:28.64,0:38:29.70,Main,Nami,0,0,0,,Bi' tane daha!Dialogue: 0,0:38:29.70,0:38:33.06,Main,Nami,0,0,0,,Ne oldu öyle, soldun gittin? Boşaldı bu, boşaldı!Dialogue: 0,0:38:33.06,0:38:35.56,Main,Fukaboshi,0,0,0,,Sa-Sabahlar olmasın!Dialogue: 0,0:38:37.68,0:38:40.67,Main,Manboshi,0,0,0,,Ay balığı! Salla, salla!Dialogue: 0,0:38:40.67,0:38:43.19,Main,Manboshi,0,0,0,,Kopun haydi millet!Dialogue: 0,0:38:43.19,0:38:46.93,Main,Ryuuboshi,0,0,0,,Yiyin, için ve kudurun! Mi-fa-so-la-si-do!Dialogue: 0,0:39:03.47,0:39:05.15,Main,Neptune,0,0,0,,Ne konuşmak istiyordun bakalım,...Dialogue: 0,0:39:05.15,0:39:06.05,Main,Neptune,0,0,0,,...korsan kızım?Dialogue: 0,0:39:06.56,0:39:10.28,Main,Robin,0,0,0,,Özür dilerim ama fırsat bu fırsat yalnız kalabiliriz diye düşündüm.Dialogue: 0,0:39:10.90,0:39:16.00,Main,Neptune,0,0,0,,Peşin peşin söyleyeyim bak, sonsuza dek aşk yeminleri içtiğim Otohime adında bir karım var benim!Dialogue: 0,0:39:16.00,0:39:18.84,Main,Neptune,0,0,0,,Ölmüş dahi olsa onu aldatacak değil-Dialogue: 0,0:39:18.84,0:39:20.66,Main,Robin,0,0,0,,Joy Boy denen kişi kim?Dialogue: 0,0:39:25.54,0:39:29.14,Main,Robin,0,0,0,,Deniz Ormanı'ndaki Poneglif'i okudum.Dialogue: 0,0:39:29.29,0:39:32.09,Main,Robin,0,0,0,,Kimden özür diliyordu?Dialogue: 0,0:39:34.61,0:39:37.34,Main,Neptune,0,0,0,,Okuyabiliyor musun onu?Dialogue: 0,0:39:37.48,0:39:42.84,Main,Robin,0,0,0,,Ohara'dan sağ kurtuldum ben!  İstemediğin ayrıntıları paylaşmak zorunda değilsin.Dialogue: 0,0:39:48.05,0:39:49.03,Main,Neptune,0,0,0,,Hayır.Dialogue: 0,0:39:51.21,0:39:53.62,Main,Neptune,0,0,0,,Bildiğim her şeyi anlatacağım sana.Dialogue: 0,0:39:54.42,0:39:56.09,Main,Neptune,0,0,0,,Size güveniyorum.Dialogue: 0,0:39:57.77,0:40:04.18,Main,Neptune,0,0,0,,Joy Boy dediğin insan Kayıp Yüzyılda yeryüzünde yaşamış bir kişiymiş-jamon.Dialogue: 0,0:40:04.18,0:40:07.64,Main,Robin,0,0,0,,800 yıl önce yaşamış birisi yani öyle mi?Dialogue: 0,0:40:07.64,0:40:13.61,Main,Neptune,0,0,0,,O mesaj da o sıralar adada bulunan Deniz Kızı Prensesi'ne yazılmış-jamon.Dialogue: 0,0:40:14.56,0:40:19.07,Main,Neptune,0,0,0,,Adaya karşı verdiği sözü tutamadığı için özür dilediği bir mektup niteliğindeymiş.Dialogue: 0,0:40:19.07,0:40:21.01,Main,Robin,0,0,0,,Söz mü?Dialogue: 0,0:40:21.01,0:40:24.18,Main,Neptune,0,0,0,,Verdiği söze dair pek bir bilgim yok ne yazık ki ama...Dialogue: 0,0:40:24.18,0:40:30.84,Main,Neptune,0,0,0,,...bir gün birisinin gelip Joy Boy adına bu sözü yerine getireceğini söylüyorlar.Dialogue: 0,0:40:30.84,0:40:34.55,Main,Neptune,0,0,0,,Kraliyet ailesinde nesilden nesile aktarılan hikayemiz böyle işte.Dialogue: 0,0:40:34.84,0:40:37.54,Main,Neptune,0,0,0,,O yüzden o günün geleceğine inanıyor ve...Dialogue: 0,0:40:37.54,0:40:43.58,Main,Neptune,0,0,0,,...bu yüzden de sözümüzü tutup Noah'yı koruyoruz.Dialogue: 0,0:40:43.58,0:40:49.81,Main,Neptune,0,0,0,,O gün geldiğinde, Noah ilk kez yapılış amacı doğrultusunda iş görmüş olacak-jamon!Dialogue: 0,0:40:49.81,0:40:54.04,Main,Robin,0,0,0,,Bugün ada üzerindeki savaşlar sona erdiğinde...Dialogue: 0,0:40:54.04,0:40:57.31,Main,Robin,0,0,0,,...yarısı yok edilmiş olan Noah'nın Deniz Ormanı'na götürüldüğünü duydum.Dialogue: 0,0:40:58.41,0:41:00.52,Main,Robin,0,0,0,,Deniz Kralları götürmüşler!Dialogue: 0,0:41:01.03,0:41:07.44,Main,Robin,0,0,0,,Noah'yı kullanacak olan Joy Boy acaba Deniz Kralları'nı kontrol edecek güce de sahip miydi?Dialogue: 0,0:41:07.44,0:41:13.48,Main,Neptune,0,0,0,,Hayır, o güce sahip kişi bir önceki Deniz Kızı Prensesi'ydi-jamon.Dialogue: 0,0:41:13.48,0:41:18.22,Main,Robin,0,0,0,,Düşündüğüm gibi... Öyleyse Prenses Shirahoshi de aynı güce sahip öyle mi?Dialogue: 0,0:41:18.73,0:41:24.41,Main,Neptune,0,0,0,,Evet. Ve korkarım ki o güç bugün tamamıyla uyandı.Dialogue: 0,0:41:34.64,0:41:37.56,Main,Neptune,0,0,0,,Hiç hoşuma gittiğini söyleyemem.Dialogue: 0,0:41:37.56,0:41:39.38,Main,Robin,0,0,0,,Anlayabiliyorum.Dialogue: 0,0:41:39.38,0:41:46.41,Main,Robin,0,0,0,,İki yıl önce Gökyüzü Adası'ndayken antik silahlardan birinin yerini belirten bir Poneglif okumuştum.Dialogue: 0,0:41:49.03,0:41:52.74,Main,Robin,0,0,0,,Ve hedef gösterdiği yer bu adaydı.Dialogue: 0,0:41:54.60,0:41:57.88,Main,Robin,0,0,0,,Joy Boy'la aynı zaman diliminde yaşamış Deniz Kızı Prensesi...Dialogue: 0,0:41:59.41,0:42:02.32,Main,Robin,0,0,0,,...özel bir isimle çağrılıyordu değil mi?Dialogue: 0,0:42:04.62,0:42:11.43,Main,Robin,0,0,0,,Hülasa aynı güçleri taşıyan Prenses Shirahoshi de o ismi miras alacak.Dialogue: 0,0:42:13.79,0:42:16.49,Main,Robin,0,0,0,,Prensesin diğer ismi...Dialogue: 0,0:42:20.26,0:42:21.62,Main,Robin,0,0,0,,...antik silah...Dialogue: 0,0:42:23.19,0:42:24.72,Main,Robin,0,0,0,,...Poseidon!Dialogue: 0,0:00:25.35,0:00:29.31,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪Dialogue: 0,0:00:29.31,0:00:33.81,We Go lyrics,,0,0,0,,♪ Şafak vakti gelmedi bile ve ben bekleyemiyorum! ♪Dialogue: 0,0:00:33.81,0:00:37.48,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı, dört... Gidelim! ♪Dialogue: 0,0:00:38.97,0:00:43.05,We Go lyrics,,0,0,0,,♪ Bayrağımızı dalgalandıralım, macera şafağının doğuşuna. ♪Dialogue: 0,0:00:44.41,0:00:49.74,We Go lyrics,,0,0,0,,♪ Dalgalar yapalım, bizi uykumuzdan kaldırsınlar. ♪Dialogue: 0,0:00:49.74,0:00:54.28,We Go lyrics,,0,0,0,,♪ Eğer inanılmaz bir dünyaya gitmek istiyorsan,Dialogue: 0,0:00:54.28,0:00:58.79,We Go lyrics,,0,0,0,, gerekli olan şey senin dayanıklılığın. ♪Dialogue: 0,0:00:59.11,0:01:01.73,We Go lyrics,,0,0,0,,♪ Fazla dikkat çekmek, bu bir suç mu? ♪Dialogue: 0,0:01:01.73,0:01:04.62,We Go lyrics,,0,0,0,,♪ Aranıyor → Kazanan demektir! ♪Dialogue: 0,0:01:04.62,0:01:10.50,We Go lyrics,,0,0,0,,♪ Özgür olmak bizim tek kuralımız! ♪Dialogue: 0,0:01:10.50,0:01:15.99,We Go lyrics,,0,0,0,,♪ Endişelerinizi unutun, bırakın rüzgar essin. ♪Dialogue: 0,0:01:15.99,0:01:18.53,We Go lyrics,,0,0,0,,♪ Ne pahasına olursa olsun, One Piece'i ilk biz bulacağız! ♪Dialogue: 0,0:01:18.53,0:01:22.66,We Go lyrics,,0,0,0,,♪ Hayal kuran kalplerimiz, çok büyük... ♪Dialogue: 0,0:01:22.66,0:01:26.93,We Go lyrics,,0,0,0,,♪ Onları uyandırmamak önemli. ♪Dialogue: 0,0:01:26.93,0:01:29.57,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪Dialogue: 0,0:01:29.57,0:01:33.54,We Go lyrics,,0,0,0,,♪ Şafak vakti gelmedi bile ve ben bekleyemiyorum! ♪Dialogue: 0,0:01:33.54,0:01:37.33,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı, dört... Gidelim! ♪Dialogue: 0,0:01:38.76,0:01:44.72,We Go lyrics,,0,0,0,,♪ Biz... buralara kadar geldik. ♪Dialogue: 0,0:01:44.72,0:01:47.62,We Go lyrics,,0,0,0,,♪ Gideceğiz... hayallerimizin olduğu yere,Dialogue: 0,0:01:47.62,0:01:52.70,We Go lyrics,,0,0,0,, ve kimseyi arkada bırakmayacağız. ♪Dialogue: 0,0:01:52.70,0:01:55.30,We Go lyrics,,0,0,0,,♪ Hep devam edeceğiz, bu bir söz. ♪Dialogue: 0,0:01:55.30,0:01:59.47,We Go lyrics,,0,0,0,,♪ Hayallerimizin başladığı o günden beri,Dialogue: 0,0:01:59.47,0:02:03.72,We Go lyrics,,0,0,0,, belirlediğimiz gelecek, değişmedi! ♪Dialogue: 0,0:02:03.72,0:02:06.24,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪Dialogue: 0,0:02:06.24,0:02:10.61,We Go lyrics,,0,0,0,,♪ Kalbimdeki güneş, asla batmayacak! ♪Dialogue: 0,0:02:10.61,0:02:13.38,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... ♪Dialogue: 0,0:02:14.78,0:02:17.57,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... ♪Dialogue: 0,0:02:18.75,0:02:24.82,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... dört... Gidelim! ♪Dialogue: 0,0:02:27.27,0:02:29.74,We Go lyrics,,0,0,0,,♪ Gidelim! ♪Dialogue: 0,0:00:02.99,0:00:08.38,Main,,0,0,0,,Dünyanın sunabileceği her şeyi elde eden adam, Korsanlar Kralı Gold Roger.Dialogue: 0,0:00:08.38,0:00:13.00,Main,,0,0,0,,Son sözleri dünyanın her yerinden maceracıları denize çekti.Dialogue: 0,0:00:13.00,0:00:14.68,Main,,0,0,0,,"Hazinem mi?"Dialogue: 0,0:00:14.68,0:00:16.22,Main,,0,0,0,,"İstiyorsanız, size vereceğim!"Dialogue: 0,0:00:16.22,0:00:17.42,Main,,0,0,0,,"Arayın ve bulun!"Dialogue: 0,0:00:17.42,0:00:19.87,Main,,0,0,0,,"Bu dünyanın sunabileceği her şeyi orada bıraktım!"Dialogue: 0,0:00:19.87,0:00:22.69,Main,,0,0,0,,Korsanlar hayallerinin peşinden yola çıktılar!Dialogue: 0,0:00:22.69,0:00:25.35,Main,,0,0,0,,Dünya, Büyük Korsan Çağı'na girdi!