10,10,1Style: TS paper,impress bt,48,&H001D221E,&H000000FF,&H001D221E,&H00000000,0,0,0,0,100,100,0,0,1,0.5,0,2,10,10,10,1Style: We Go lyrics,Duality,40.0,&H0098594E,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2.6,0,2,10,10,15,1Style: Author,Impress BT,20.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.7,0.7,9,10,10,10,1Style: Attack,Duality,30.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.0,1.0,7,12,12,12,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:02.99,0:00:08.38,Main,,0,0,0,,Dünyanın sunabileceği her şeyi elde eden adam, Korsanlar Kralı Gold Roger.Dialogue: 0,0:00:08.38,0:00:13.00,Main,,0,0,0,,Son sözleri dünyanın her yerinden maceracıları denize çekti.Dialogue: 0,0:00:13.00,0:00:14.68,Main,,0,0,0,,"Hazinem mi?"Dialogue: 0,0:00:14.68,0:00:16.22,Main,,0,0,0,,"İstiyorsanız, size vereceğim!"Dialogue: 0,0:00:16.22,0:00:17.42,Main,,0,0,0,,"Arayın ve bulun!"Dialogue: 0,0:00:17.42,0:00:19.87,Main,,0,0,0,,"Bu dünyanın sunabileceği her şeyi orada bıraktım!"Dialogue: 0,0:00:19.87,0:00:22.69,Main,,0,0,0,,Korsanlar hayallerinin peşinden yola çıktılar!Dialogue: 0,0:00:22.69,0:00:25.35,Main,,0,0,0,,Dünya, Büyük Korsan Çağı'na girdi!Dialogue: 0,0:00:25.35,0:00:29.31,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪Dialogue: 0,0:00:29.31,0:00:33.81,We Go lyrics,,0,0,0,,♪ Şafak vakti gelmedi bile ve ben bekleyemiyorum! ♪Dialogue: 0,0:00:33.81,0:00:37.48,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı, dört... Gidelim! ♪Dialogue: 0,0:00:38.97,0:00:43.05,We Go lyrics,,0,0,0,,♪ Bayrağımızı dalgalandıralım, macera şafağının doğuşuna. ♪Dialogue: 0,0:00:44.41,0:00:49.74,We Go lyrics,,0,0,0,,♪ Dalgalar yapalım, bizi uykumuzdan kaldırsınlar. ♪Dialogue: 0,0:00:49.74,0:00:54.28,We Go lyrics,,0,0,0,,♪ Eğer inanılmaz bir dünyaya gitmek istiyorsan,Dialogue: 0,0:00:54.28,0:00:58.79,We Go lyrics,,0,0,0,, gerekli olan şey senin dayanıklılığın. ♪Dialogue: 0,0:00:59.11,0:01:01.73,We Go lyrics,,0,0,0,,♪ Fazla dikkat çekmek, bu bir suç mu? ♪Dialogue: 0,0:01:01.73,0:01:04.62,We Go lyrics,,0,0,0,,♪ Aranıyor → Kazanan demektir! ♪Dialogue: 0,0:01:04.62,0:01:10.50,We Go lyrics,,0,0,0,,♪ Özgür olmak bizim tek kuralımız! ♪Dialogue: 0,0:01:10.50,0:01:15.99,We Go lyrics,,0,0,0,,♪ Endişelerinizi unutun, bırakın rüzgar essin. ♪Dialogue: 0,0:01:15.99,0:01:18.53,We Go lyrics,,0,0,0,,♪ Ne pahasına olursa olsun, One Piece'i ilk biz bulacağız! ♪Dialogue: 0,0:01:18.53,0:01:22.66,We Go lyrics,,0,0,0,,♪ Hayal kuran kalplerimiz, çok büyük... ♪Dialogue: 0,0:01:22.66,0:01:26.93,We Go lyrics,,0,0,0,,♪ Onları uyandırmamak önemli. ♪Dialogue: 0,0:01:26.93,0:01:29.57,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪Dialogue: 0,0:01:29.57,0:01:33.54,We Go lyrics,,0,0,0,,♪ Şafak vakti gelmedi bile ve ben bekleyemiyorum! ♪Dialogue: 0,0:01:33.54,0:01:37.33,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı, dört... Gidelim! ♪Dialogue: 0,0:01:38.76,0:01:44.72,We Go lyrics,,0,0,0,,♪ Biz... buralara kadar geldik. ♪Dialogue: 0,0:01:44.72,0:01:47.62,We Go lyrics,,0,0,0,,♪ Gideceğiz... hayallerimizin olduğu yere,Dialogue: 0,0:01:47.62,0:01:52.70,We Go lyrics,,0,0,0,, ve kimseyi arkada bırakmayacağız. ♪Dialogue: 0,0:01:52.70,0:01:55.30,We Go lyrics,,0,0,0,,♪ Hep devam edeceğiz, bu bir söz. ♪Dialogue: 0,0:01:55.30,0:01:59.47,We Go lyrics,,0,0,0,,♪ Hayallerimizin başladığı o günden beri,Dialogue: 0,0:01:59.47,0:02:03.72,We Go lyrics,,0,0,0,, belirlediğimiz gelecek, değişmedi! ♪Dialogue: 0,0:02:03.72,0:02:06.24,We Go lyrics,,0,0,0,,♪ Yerimde duramıyorum! Duramıyorum! ♪Dialogue: 0,0:02:06.24,0:02:10.61,We Go lyrics,,0,0,0,,♪ Kalbimdeki güneş, asla batmayacak! ♪Dialogue: 0,0:02:10.61,0:02:13.38,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... ♪Dialogue: 0,0:02:14.78,0:02:17.57,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... ♪Dialogue: 0,0:02:18.75,0:02:24.82,We Go lyrics,,0,0,0,,♪ Bir, iki, günışığı... dört... Gidelim! ♪Dialogue: 0,0:02:27.27,0:02:30.04,We Go lyrics,,0,0,0,,♪ Gidelim! ♪Dialogue: 0,0:02:30.03,0:02:38.12,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Kaşgarlı thx to onepace.netDialogue: 0,0:10:00.00,0:10:10.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Kaşgarlı thx to onepace.netDialogue: 0,0:24:11.90,0:24:14.90,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Kaşgarlı thx to onepace.netDialogue: 0,0:02:30.03,0:02:38.95,Title,Title,0,0,0,,Okyanusun Derinliklerinde Macera! Yüzeyin 10 Kilometre Aşağısı!Dialogue: 0,0:02:39.34,0:02:44.59,Main,Brook,0,0,0,,Kemikleri olmayan bir canlı... Eti olmayan bir iskelet...Dialogue: 0,0:02:44.59,0:02:48.09,Main,Brook,0,0,0,,Benim tamamen zıttım olan bir canlı gibi duruyor.Dialogue: 0,0:02:48.09,0:02:49.43,Main,Usopp,0,0,0,,Farketmez!Dialogue: 0,0:02:50.41,0:02:52.72,Main,Franky,0,0,0,,Bu işte cidden iyisin.Dialogue: 0,0:02:52.72,0:02:55.20,Main,Robin,0,0,0,,Bunun gibi bir şeyi her gün görmüyorsun sonuçta.Dialogue: 0,0:02:55.20,0:02:56.92,Main,Chopper,0,0,0,,Sakince resmini mi çiziyorsun?!Dialogue: 0,0:02:56.92,0:03:00.57,Main,Zoro,0,0,0,,Benim için uygun ama, bir planın var mı, Luffy?Dialogue: 0,0:03:00.57,0:03:03.66,Main,Luffy,0,0,0,,Sorun denizin altında olmamız.Dialogue: 0,0:03:04.08,0:03:06.33,Main,Usopp,0,0,0,,Hayır... Hayır... Hayır...Dialogue: 0,0:03:07.04,0:03:09.55,Main,Usopp,0,0,0,,Sorun onun büyüklüğü.Dialogue: 0,0:03:09.55,0:03:12.10,Main,Usopp,0,0,0,,Yüzeyde olsaydık bile, şimdiki kadar tehlikeli olurdu.Dialogue: 0,0:03:12.72,0:03:15.40,Thoughts,Caribou,0,0,0,,Bunların nesi var?!Dialogue: 0,0:03:15.40,0:03:21.54,Thoughts,Caribou,0,0,0,,Böyle bir durumda, doğal olan herkesin beraber çalışarak buradan kaçması!Dialogue: 0,0:03:21.54,0:03:23.75,Main,Nami,0,0,0,,Dümeni döndürün! Rotayı güneye çevirin!Dialogue: 0,0:03:23.75,0:03:26.75,Main,Luffy,0,0,0,,Hey, Nami! Dümdüz ahtapota doğru git!Dialogue: 0,0:03:26.75,0:03:29.57,Main,Nami,0,0,0,,Saçmasapan konuşma! O ahtapot-Dialogue: 0,0:03:28.18,0:03:29.57,Secondary,Sanji,0,0,0,,Hey, hey, Nami-san.Dialogue: 0,0:03:29.91,0:03:31.62,Main,Sanji,0,0,0,,Ben senin için...Dialogue: 0,0:03:33.55,0:03:34.66,Main,Sanji,0,0,0,,buradayım.Dialogue: 0,0:03:34.66,0:03:37.55,Main,Usopp,0,0,0,,Dayandı! Aferin sana!Dialogue: 0,0:03:37.55,0:03:41.10,Main,Chopper,0,0,0,,Tedavisi sayesinde ve Nami'nin mont giymesi sayesinde!Dialogue: 0,0:03:41.10,0:03:45.10,Thoughts,Caribou,0,0,0,,Bu gemi tehlikeli! Kendimi kurtarmam lazım! Dialogue: 0,0:03:45.52,0:03:47.34,Main,Franky,0,0,0,,Arkamızdan bir şey yaklaşıyor.Dialogue: 0,0:03:49.96,0:03:52.20,Main,Coribou,0,0,0,,Abi!Dialogue: 0,0:03:52.20,0:03:53.24,Main,Usopp,0,0,0,,Bu az önceki gemi!Dialogue: 0,0:03:53.80,0:03:56.75,Main,Caribou,0,0,0,,Coribou! Beyler!Dialogue: 0,0:03:56.75,0:04:00.68,Main,Caribou,0,0,0,,Beni kurtarmaya mı geldiniz?!Dialogue: 0,0:04:00.68,0:04:03.08,Main,Coribou,0,0,0,,Biz seni kurtaracağız, Abi!Dialogue: 0,0:04:03.08,0:04:04.65,Main,Pirates,0,0,0,,Hayhay!Dialogue: 0,0:04:08.66,0:04:10.08,Main,Caribou,0,0,0,,Dur!Dialogue: 0,0:04:13.03,0:04:15.46,Main,Chopper,0,0,0,,Baloncuk kaplaması patladı!Dialogue: 0,0:04:15.46,0:04:18.17,Main,Usopp,0,0,0,,Ve o gemi Sunny'den bile büyüktü!Dialogue: 0,0:04:21.52,0:04:27.41,Main,Caribou,0,0,0,,Beyler...Dialogue: 0,0:04:28.33,0:04:29.44,Main,Zoro,0,0,0,,Denizanasına benziyorlar.Dialogue: 0,0:04:29.44,0:04:30.75,Main,Caribou,0,0,0,,Kapa çeneni, Roronoa!Dialogue: 0,0:04:32.76,0:04:34.00,Main,Usopp,0,0,0,,Buraya geliyor!Dialogue: 0,0:04:37.19,0:04:38.39,Main,Chopper,0,0,0,,Fazla büyük!Dialogue: 0,0:04:38.79,0:04:39.58,Main,Luffy,0,0,0,,Gear Thir-Dialogue: 0,0:04:39.58,0:04:41.80,Main,Usopp,0,0,0,,Durun!Dialogue: 0,0:04:41.80,0:04:44.49,Main,Usopp,0,0,0,,Büyük bir saldırı yaparsanız baloncuk patlar!Dialogue: 0,0:04:44.91,0:04:47.15,Main,Franky,0,0,0,,Chicken Voyage! Dialogue: 0,0:04:44.91,0:04:47.15,Attack,Franky,0,0,0,,Tavuk Yolculuğu!Dialogue: 0,0:04:48.60,0:04:51.18,Main,Nami,0,0,0,,Bir şey yapmalıyız! Kaçamaz mıyız?!Dialogue: 0,0:04:51.18,0:04:53.74,Main,Luffy,0,0,0,,Hiçbir şey yapmayın! Onunla dövüşeceğim!Dialogue: 0,0:04:53.74,0:04:56.94,Main,Chopper,0,0,0,,Lütfen dur! Baloncuğu patlatacaksın!Dialogue: 0,0:04:56.94,0:05:02.84,Main,Caribou,0,0,0,,Beni dinle! Eğer o kadar dövüşmek istiyorsan, bir fikrim var.Dialogue: 0,0:05:04.10,0:05:06.05,Main,Caribou,0,0,0,,Tamam, böyle iyi.Dialogue: 0,0:05:06.61,0:05:09.39,Main,Caribou,0,0,0,,Bu hazır Palet Kaplaması!Dialogue: 0,0:05:09.39,0:05:12.25,Main,Caribou,0,0,0,,Hazır bir dalış kıyafeti!Dialogue: 0,0:05:12.59,0:05:16.49,Thoughts,Caribou,0,0,0,,Bu aptalların istediklerini yapmalarına izin verirsem, onlarla birlikte ben de yanarım.Dialogue: 0,0:05:16.49,0:05:18.91,Main,Usopp,0,0,0,,Neden böyle bir şey yaptın, yabancı?!Dialogue: 0,0:05:18.91,0:05:21.31,Main,Usopp,0,0,0,,Kaçmamız gerekiyordu bizim!Dialogue: 0,0:05:21.31,0:05:23.47,Main,Usopp,0,0,0,,Şimdi dövüşmek zorunda kalacağız, değil mi?!Dialogue: 0,0:05:23.76,0:05:29.44,Main,Caribou,0,0,0,,Başından beri kaçmamız gerektiğini söylüyorum ama senin o aptal kaptanın dinlemiyor değil mi?!Dialogue: 0,0:05:29.88,0:05:34.04,Main,Caribou,0,0,0,,Onun ortalığı hala gemideyken mi  karıştırmasını tercih ederdin?!Dialogue: 0,0:05:34.43,0:05:37.15,Main,Usopp,0,0,0,,Tamam, git bakalım! Gemiden olabildiğince uzağa!Dialogue: 0,0:05:37.15,0:05:39.78,Main,Nami,0,0,0,,Eğer onunla dövüşeceksen, geminin yakınına yaklaşma!Dialogue: 0,0:05:39.78,0:05:41.28,Main,Luffy,0,0,0,,Bu ip beni engelliyor.Dialogue: 0,0:05:44.19,0:05:45.64,Main,Nami,0,0,0,,Bekle!Dialogue: 0,0:05:45.64,0:05:47.92,Main,Nami,0,0,0,,Halatlara bağlı kalmanız gerekiyor!Dialogue: 0,0:05:47.92,0:05:49.42,Main,Nami,0,0,0,,Yoksa ayrılırsınız!Dialogue: 0,0:05:49.42,0:05:52.00,Main,Sanji,0,0,0,,Nami-san benim hakkımda endişeleniyor!Dialogue: 0,0:05:52.00,0:05:55.36,Main,Luffy,0,0,0,,Beyler! Bana biraz zaman kazandırın. tamam mı?Dialogue: 0,0:05:55.36,0:05:57.63,Main,Luffy,0,0,0,,Tek bir güçlü saldırıyla içini bitireceğim.Dialogue: 0,0:05:57.63,0:06:00.81,Main,Zoro,0,0,0,,Sen hazırlandığın sırada ben onu hallederim.Dialogue: 0,0:06:00.81,0:06:02.87,Main,Luffy,0,0,0,,Onu öldürürsün, o yüzden olmaz!Dialogue: 0,0:06:03.35,0:06:05.46,Main,Luffy,0,0,0,,O ahtapotu saklayacağım!Dialogue: 0,0:06:07.08,0:06:09.38,Main,Usopp,0,0,0,,Hala bizi hedef alıyor!Dialogue: 0,0:06:10.79,0:06:13.05,Main,Franky,0,0,0,,Franky...Dialogue: 0,0:06:15.88,0:06:18.12,Main,Franky,0,0,0,,Rocket Launcher! Dialogue: 0,0:06:15.88,0:06:18.12,Attack,Franky,0,0,0,,RoketatarDialogue: 0,0:06:21.93,0:06:23.00,Main,Usopp,0,0,0,,Vurdun!Dialogue: 0,0:06:23.00,0:06:24.54,Main,Chopper,0,0,0,,Çok güçlü!Dialogue: 0,0:06:25.69,0:06:28.23,Main,Usopp,0,0,0,,Bir kol daha geliyor!Dialogue: 0,0:06:28.23,0:06:29.88,Main,Chopper,0,0,0,,Neden hep bize saldırıyor?!Dialogue: 0,0:06:30.89,0:06:32.06,Main,Chopper,0,0,0,,Guard Point! Dialogue: 0,0:06:30.89,0:06:32.06,Attack,Chopper,0,0,0,,Savunma NoktasıDialogue: 0,0:06:33.20,0:06:34.92,Main,Zoro,0,0,0,,Tam isabet etti!Dialogue: 0,0:06:36.15,0:06:37.34,Main,Chopper,0,0,0,,İyi misiniz millet?!Dialogue: 0,0:06:37.34,0:06:39.74,Main,Usopp,0,0,0,,D-Durdurdun!Dialogue: 0,0:06:39.74,0:06:40.88,Main,Franky,0,0,0,,Aferin sana!Dialogue: 0,0:06:40.88,0:06:42.28,Main,Nami,0,0,0,,Harikasın, Chopper!Dialogue: 0,0:06:43.84,0:06:46.15,Main,Brook,0,0,0,,Şimdi de sualtı dağına çarpacağız!Dialogue: 0,0:06:46.56,0:06:47.48,Main,Robin,0,0,0,,Mil Fleur...Dialogue: 0,0:06:46.56,0:06:47.48,Attack,Robin,0,0,0,,Bin ÇiçekDialogue: 0,0:06:48.92,0:06:50.39,Main,Robin,0,0,0,,Gigantesco Mano!Dialogue: 0,0:06:48.92,0:06:50.39,Attack,Robin,0,0,0,,Dev ElDialogue: 0,0:06:52.00,0:06:53.72,Main,Chopper,0,0,0,,Devasa eller!Dialogue: 0,0:06:56.43,0:06:57.30,Main,Trio,0,0,0,,Yaşasın!Dialogue: 0,0:06:57.30,0:06:59.67,Main,Usopp,0,0,0,,Aferin, Robin! Bizi kurtardın!Dialogue: 0,0:07:01.20,0:07:02.80,Main,Robin,0,0,0,,Şükürler olsun...Dialogue: 0,0:07:02.80,0:07:06.74,Main,Robin,0,0,0,,Su altında olmamıza rağmen, bir anlığına bile olsa yapabildim.Dialogue: 0,0:07:07.49,0:07:09.20,Main,Luffy,0,0,0,,Gear Third! Dialogue: 0,0:07:07.49,0:07:09.20,Attack,Luffy,0,0,0,,Üçüncü VitesDialogue: 0,0:07:13.84,0:07:15.54,Main,Luffy,0,0,0,,Busoshoku: Koka! Dialogue: 0,0:07:13.84,0:07:15.54,Attack,Luffy,0,0,0,,Silahlanma Rengi: ZırhlanDialogue: 0,0:07:20.80,0:07:23.99,Main,Luffy,0,0,0,,Denizde... gücüm emiliyor.Dialogue: 0,0:07:26.64,0:07:29.69,Main,Sanji,0,0,0,,Lanet ahtapot, o daha darbe indirmeden işini bitirmeye mi çalışıyorsun?Dialogue: 0,0:07:30.29,0:07:31.29,Main,Sanji,0,0,0,,Blue Walk! Dialogue: 0,0:07:30.29,0:07:31.29,Attack,Sanji,0,0,0,,Mavi YürüyüşDialogue: 0,0:07:32.97,0:07:35.39,Main,Brook,0,0,0,,Sanji-san sabon baloncuğundan çıktı!Dialogue: 0,0:07:35.39,0:07:37.67,Main,Usopp,0,0,0,,Onu boşver o hız da neyin nesi öyle?!Dialogue: 0,0:07:37.67,0:07:40.05,Main,Usopp,0,0,0,,Balık adam gibi! İnanılmaz!Dialogue: 0,0:07:40.05,0:07:41.52,Thoughts,Sanji,0,0,0,,Koştum! Koştum!Dialogue: 0,0:07:42.49,0:07:45.32,Thoughts,Sanji,0,0,0,,İki yılımı iğrenç yaratıklardan kaçarak geçirdim.Dialogue: 0,0:07:46.38,0:07:50.35,Thoughts,Sanji,0,0,0,,Onlara kıyaslandığında, bu şey zar zor canavar sayılır.Dialogue: 0,0:07:50.35,0:07:52.13,Thoughts,Sanji,0,0,0,,Neredeyse şirin bile.Dialogue: 0,0:07:52.13,0:07:53.89,Thoughts,Sanji,0,0,0,,Diable Jambe...Dialogue: 0,0:07:52.13,0:07:53.89,Attack,Sanji,0,0,0,,Şeytan BacağıDialogue: 0,0:07:57.89,0:07:58.79,Thoughts,Sanji,0,0,0,,Bien Cuit...Dialogue: 0,0:07:57.89,0:07:58.79,Attack,Note,0,0,0,,İyi PişmişDialogue: 0,0:07:59.79,0:08:01.06,Main,Sanji,0,0,0,,Grill Shot! Dialogue: 0,0:07:59.79,0:08:01.06,Attack,Sanji,0,0,0,,Izgara VuruşuDialogue: 0,0:08:11.49,0:08:13.55,Main,TL Note,0,0,0,,Santoryu Ogi... Dialogue: 0,0:08:11.49,0:08:13.55,Attack,TL Note,0,0,0,,Üç Kılıç Stili Gizli TeknikDialogue: 0,0:08:13.55,0:08:15.09,Main,TL Note,0,0,0,,Rokudo no Tsuji! Dialogue: 0,0:08:13.55,0:08:15.09,Attack,TL Note,0,0,0,,Altı Yolun KesişimiDialogue: 0,0:08:18.37,0:08:19.88,Main,Franky,0,0,0,,H-Harika...Dialogue: 0,0:08:19.88,0:08:22.09,Main,Usopp,0,0,0,,Kılıcının hareketini göremedim bile!Dialogue: 0,0:08:22.26,0:08:26.49,Main,Luffy,0,0,0,,Ne yapıyorsunuz?! Zoro, Sanji! Bu gidişle kolu kalmayacak!Dialogue: 0,0:08:26.49,0:08:28.75,Main,Luffy,0,0,0,,Gomu Gomu no... Dialogue: 0,0:08:30.67,0:08:33.61,Main,Luffy,0,0,0,,Elephant Gun! Dialogue: 0,0:08:30.67,0:08:33.61,Attack,Luffy,0,0,0,,Fil SilahıDialogue: 0,0:08:41.31,0:08:43.60,Main,Usopp,0,0,0,,Yendi onu!Dialogue: 0,0:08:43.60,0:08:46.37,Main,Nami,0,0,0,,Ne kadar güçlendi o?!Dialogue: 0,0:08:47.09,0:08:49.20,Main,Chopper,0,0,0,,Ne? Orada bir şey var!Dialogue: 0,0:08:49.20,0:08:50.19,Main,Straw Hats,0,0,0,,Ne?Dialogue: 0,0:08:51.12,0:08:53.08,Main,Chopper,0,0,0,,Köpekbalığı mı?Dialogue: 0,0:08:53.99,0:08:55.10,Main,Luffy,0,0,0,,Köpekbalığı mı?Dialogue: 0,0:08:55.10,0:08:57.28,Main,Sanji,0,0,0,,O köpekbalığı kıyafet mi giyiyor?Dialogue: 0,0:08:57.28,0:08:59.43,Main,Zoro,0,0,0,,Bayağı büyük bir köpekbalığı.Dialogue: 0,0:09:01.05,0:09:01.87,Main,Luffy,0,0,0,,Ne oluyor?Dialogue: 0,0:09:10.03,0:09:12.31,Main,Robin,0,0,0,,Aşağı akıntı tarafından yutuldular!Dialogue: 0,0:09:12.31,0:09:13.63,Main,Usopp,0,0,0,,Olamaz, peşlerinden gidelim!Dialogue: 0,0:09:13.63,0:09:15.23,Main,Usopp,0,0,0,,Beraber durmalıyız!Dialogue: 0,0:09:18.17,0:09:20.99,Main,Chopper,0,0,0,,Böyle bir yerde ölmek istemiyorum!Dialogue: 0,0:09:20.99,0:09:22.19,Main,Caribou,0,0,0,,Dalga geçmeyi bırakın!Dialogue: 0,0:09:22.19,0:09:23.76,Main,Franky,0,0,0,,Sen hala burada mısın?Dialogue: 0,0:09:23.76,0:09:24.72,Main,Usopp,0,0,0,,Niye bu kadar sakinsin?!Dialogue: 0,0:09:26.32,0:09:29.34,Main,Brook,0,0,0,,Gözlerim dönüyor! Benim gözlerim yok gerçi.Dialogue: 0,0:09:33.68,0:09:36.95,Main,Nami,0,0,0,,Avlu seviyesini sabit tutun! Gemiyi sola çevirin!Dialogue: 0,0:09:36.95,0:09:38.51,Main,Nami,0,0,0,,Kıta sahanlığına* çarpacağız!Dialogue: 0,0:09:39.73,0:09:41.02,Main,Franky,0,0,0,,Tamamdır!Dialogue: 0,0:09:41.02,0:09:43.73,Main,Nami,0,0,0,,Eğer dikkatli olmazsak, gemi yok olur!Dialogue: 0,0:09:43.73,0:09:45.06,Main,Chopper,0,0,0,,Neeee?!Dialogue: 0,0:09:45.06,0:09:46.73,Main,Usopp,0,0,0,,Sakın dengenizi bozmayın!Dialogue: 0,0:09:48.36,0:09:50.55,Main,Nami,0,0,0,,Gemiyi akıntının merkezine getirin!Dialogue: 0,0:09:51.49,0:09:53.36,Main,Franky,0,0,0,,Bu nasıl bir hız?!Dialogue: 0,0:10:06.74,0:10:07.74,Main,Nami,0,0,0,,Usopp.Dialogue: 0,0:10:07.74,0:10:10.40,Main,Usopp,0,0,0,,Dialogue: 0,0:10:11.70,0:10:13.81,Main,Usopp,0,0,0,,Hala hayatta mıyım?Dialogue: 0,0:10:13.81,0:10:17.12,Main,Usopp,0,0,0,,Ne oldu? Neden yüzleriniz bu kadar asık?Dialogue: 0,0:10:17.12,0:10:20.72,Main,Usopp,0,0,0,,Cidden, ben olmadan tamamen çaresizsiniz.Dialogue: 0,0:10:22.12,0:10:24.59,Main,Usopp,0,0,0,,Çok soğuk burası!Dialogue: 0,0:10:24.59,0:10:28.47,Main,Robin,0,0,0,,Luffy ve diğerlerini bulamıyoruz. Ayrı düştük gibi duruyor.Dialogue: 0,0:10:28.47,0:10:29.92,Main,Usopp,0,0,0,,Ne?!Dialogue: 0,0:10:29.92,0:10:33.64,Main,Robin,0,0,0,,Umarım vücutları bir deniz canavarı tarafından parçalara ayrılmamıştır.Dialogue: 0,0:10:33.64,0:10:35.67,Main,Usopp,0,0,0,,Hayal gücün çok korkunç.Dialogue: 0,0:10:36.21,0:10:39.80,Main,Usopp,0,0,0,,Zaten ne kadar bakarsak bakalım bu karanlıkta onları hiçbir şekilde bulamayacağız.Dialogue: 0,0:10:39.80,0:10:44.83,Main,Brook,0,0,0,,Ben karanlığı hiç sevmem... Siz de sanki izleniyormuşuz gibi hissediyor musunuz?Dialogue: 0,0:10:45.48,0:10:48.57,Main,Franky,0,0,0,,Şu anda en az 7 kilometre aşağıdayız.Dialogue: 0,0:10:48.57,0:10:52.49,Main,Franky,0,0,0,,Bu derinlikte, basınç Köpekbalığı Denizaltı'nı  bile krep gibi dümdüz eder.Dialogue: 0,0:10:52.49,0:10:55.03,Main,Chopper,0,0,0,,Balık Adam Adası'na yakın mıyız?Dialogue: 0,0:10:55.03,0:10:57.83,Main,Chopper,0,0,0,,Belki de oraya çoktan ulaşmışlardır?Dialogue: 0,0:10:57.83,0:11:02.81,Main,Robin,0,0,0,,Camie-chan sanırım 10 kilometre aşağıda olduğunu söylemişti.Dialogue: 0,0:11:02.81,0:11:05.49,Main,Chopper,0,0,0,,3 kilometre daha mı dalmamız gerekiyor?!Dialogue: 0,0:11:05.99,0:11:08.82,Main,Usopp,0,0,0,,Sadece o küçük baloncuklar tarafından korunuyorlar.Dialogue: 0,0:11:08.82,0:11:11.84,Main,Usopp,0,0,0,,Eğer hala hayattalarsa bile, yakında havasız kalacaklar!Dialogue: 0,0:11:12.44,0:11:15.21,Main,Nami,0,0,0,,İşte o yüzden halatlara bağlı kalmalarını söylemiştim!Dialogue: 0,0:11:15.21,0:11:17.43,Main,Franky,0,0,0,,Ağlamak hiçbir işe yaramayacak.Dialogue: 0,0:11:17.43,0:11:20.61,Main,Franky,0,0,0,,Arayalım onları. Üzerimde kurulu bir ışıklandırma fonksiyonu var.Dialogue: 0,0:11:20.61,0:11:21.45,Main,Usoppu and Choppa,0,0,0,,Ne?!Dialogue: 0,0:11:21.45,0:11:22.84,Main,Chopper,0,0,0,,Yoksa gözlerin..!Dialogue: 0,0:11:22.95,0:11:24.35,Main,Franky,0,0,0,,Franky...Dialogue: 0,0:11:24.67,0:11:27.02,Main,Franky,0,0,0,,Nipple Light! Dialogue: 0,0:11:24.67,0:11:27.02,Attack,Franky,0,0,0,,Meme Ucu IşığıDialogue: 0,0:11:27.02,0:11:28.98,Main,Usopp,0,0,0,,Işıkları neden oraya kurarsın ki?!Dialogue: 0,0:11:28.98,0:11:32.60,Captions,Sign,0,0,220,,Burası derin su seviyeleri. Işık buraya erişemez ve sıradan canlılar hayatta kalamaz.Dialogue: 0,0:11:33.71,0:11:37.42,Captions,Sign,0,0,220,,"Denizin Yeraltı Dünyası".Dialogue: 0,0:11:35.65,0:11:37.42,Main,,0,0,0,,Kaçalım!Dialogue: 0,0:11:40.51,0:11:45.33,Main,Usopp,0,0,0,,Luffy! Zoro! Sanji!Dialogue: 0,0:11:45.33,0:11:47.85,Main,Chopper,0,0,0,,Nereye gittiniz?Dialogue: 0,0:11:47.85,0:11:49.71,Main,Chopper,0,0,0,,Lütfen geri dönün!Dialogue: 0,0:11:51.18,0:11:55.95,Main,Franky,0,0,0,,Sunny'nin gözlerinin menzili yeterince uzağa ulaşamıyor.Dialogue: 0,0:11:56.55,0:11:59.19,Main,Brook,0,0,0,,Ne kadar da iç karartıcı.Dialogue: 0,0:11:59.19,0:12:03.12,Main,Brook,0,0,0,,Karanlık burayı daha da üzücü yapıyor.Dialogue: 0,0:12:03.12,0:12:05.53,Main,Usopp,0,0,0,,Bu hiç yardımcı olmuyor.Dialogue: 0,0:12:05.99,0:12:07.56,Main,Usopp,0,0,0,,Ne yapmalıyız?Dialogue: 0,0:12:08.50,0:12:12.54,Main,Nami,0,0,0,,Gemiyi yavaşlatamayız, o yüzden hiçbir şeyi gözden kaçırmayın.Dialogue: 0,0:12:15.05,0:12:18.41,Main,Chopper,0,0,0,,Denizanası! Üstümüzde devasa bir denizanası var!Dialogue: 0,0:12:18.41,0:12:19.88,Main,Brook,0,0,0,,Kocaman!Dialogue: 0,0:12:19.88,0:12:21.65,Main,Brook,0,0,0,,Gerçekten kocaman!Dialogue: 0,0:12:22.19,0:12:26.62,Main,Brook,0,0,0,,Parlıyor! Tıpkı yıldızlı bir gece göğü gibi!Dialogue: 0,0:12:28.33,0:12:29.49,Main,Chopper,0,0,0,,Kolu içeri girdi!Dialogue: 0,0:12:29.71,0:12:32.22,Main,Chopper,0,0,0,,A-Arkadaş mı olmak istiyor acaba?Dialogue: 0,0:12:32.22,0:12:34.01,Main,Robin,0,0,0,,Sakın ona dokunma, Chopper!Dialogue: 0,0:12:34.36,0:12:35.56,Main,Robin,0,0,0,,Muhtemelen zehirlidir!Dialogue: 0,0:12:35.99,0:12:36.99,Main,Chopper,0,0,0,,Dialogue: 0,0:12:38.45,0:12:39.58,Main,Franky,0,0,0,,Olamaz!Dialogue: 0,0:12:39.58,0:12:42.13,Main,Franky,0,0,0,,Chotto Coup De Burst! Dialogue: 0,0:12:39.58,0:12:42.13,Attack,Franky,0,0,0,,Küçük Rüzgar PatlamasıDialogue: 0,0:12:45.60,0:12:47.11,Main,Usoppu ando Choppa,0,0,0,,N-Ne?!Dialogue: 0,0:12:47.85,0:12:49.48,Main,Chopper,0,0,0,,Denizanası yenildi!Dialogue: 0,0:12:50.71,0:12:53.76,Main,Brook,0,0,0,,Gemi biraz hava kaybetmiş gibi duruyor.Dialogue: 0,0:12:53.76,0:12:55.61,Main,Franky,0,0,0,,Yenilmekten iyidir, değil mi?Dialogue: 0,0:12:56.64,0:13:00.66,Main,Franky,0,0,0,,Coup de Burst yüksek miktarlarda hava kullanan bir silahdır.Dialogue: 0,0:13:00.66,0:13:05.05,Main,Franky,0,0,0,,Ama, şu anda suyun altındayız. Havamız kısıtlı!Dialogue: 0,0:13:05.63,0:13:09.09,Main,Franky,0,0,0,,Eğer dışarıya hava ateşlersek, baloncuk küçülür!Dialogue: 0,0:13:12.34,0:13:15.03,Main,Chopper,0,0,0,,Denizanasına saldıran balık öldü!Dialogue: 0,0:13:15.03,0:13:17.06,Main,Robin,0,0,0,,Tam da şüphelendiğim gibi, sinir zehri.Dialogue: 0,0:13:17.69,0:13:20.69,Main,Chopper,0,0,0,,Derin deniz korkunç! Ve karanlık.Dialogue: 0,0:13:21.14,0:13:25.89,Main,Chopper,0,0,0,,Ve bir sürü gözleri bembeyaz balık var. Çok korkunçlar!Dialogue: 0,0:13:26.82,0:13:32.37,Main,Brook,0,0,0,,Derin deniz karanlığın dünyasıdır. Bu yüzden birçok canlının gözü gelişmemiştir.Dialogue: 0,0:13:32.37,0:13:35.95,Main,Chopper,0,0,0,,Ah, yani iyi göremiyorlar mı?Dialogue: 0,0:13:37.71,0:13:40.49,Main,Usopp,0,0,0,,Aptal! Buraya gelmeye çalış bakalım!Dialogue: 0,0:13:40.49,0:13:43.99,Main,Brook,0,0,0,,Ne? Gözlerim olmamasına rağmen nasıl gördüğümü mü sordunuz?Dialogue: 0,0:13:44.34,0:13:47.22,Main,Robin,0,0,0,,Tam tersine, bazı canlılar son derece evrimleşmiş gözlere de sahip olabilir.Dialogue: 0,0:13:49.80,0:13:51.41,Main,Brook,0,0,0,,Cevap şu...Dialogue: 0,0:13:54.46,0:13:55.97,Main,Brook,0,0,0,,Bu bir sır!Dialogue: 0,0:13:55.97,0:13:59.29,Main,Franky,0,0,0,,Sen ne yapıyorsun orada kendi başına?Dialogue: 0,0:13:59.69,0:14:03.28,Main,Brook,0,0,0,,Endişeye gerek yok. Yalnızlığa oldukça alışığımdır.Dialogue: 0,0:14:03.28,0:14:06.92,Main,Usoppu to Choppaah,0,0,0,,Luffy, Zoro, Sanji!Dialogue: 0,0:14:06.92,0:14:09.75,Main,Usoppu to Choppaah,0,0,0,,Nereye gittiniz?Dialogue: 0,0:14:10.54,0:14:11.92,Main,Brook,0,0,0,,Dialogue: 0,0:14:12.69,0:14:14.14,Main,Brook,0,0,0,,Bu halatlar...Dialogue: 0,0:14:14.78,0:14:16.16,Main,Brook,0,0,0,,Millet?Dialogue: 0,0:14:16.16,0:14:17.33,Main,Franky,0,0,0,,Ha?Dialogue: 0,0:14:17.33,0:14:20.62,Main,Brook,0,0,0,,O korsan adama ne olduğunu biliyor musunuz?Dialogue: 0,0:14:20.62,0:14:23.00,Main,Franky,0,0,0,,Ah evet, o da buradaydı.Dialogue: 0,0:14:23.00,0:14:24.94,Main,Franky,0,0,0,,Tamamen unutmuşum.Dialogue: 0,0:14:24.94,0:14:26.42,Main,Chopper,0,0,0,,Nereye gitti?Dialogue: 0,0:14:26.42,0:14:29.45,Main,Robin,0,0,0,,Derin denize ulaştığımızdan beri onu görmedim.Dialogue: 0,0:14:29.45,0:14:32.69,Main,Chopper,0,0,0,,Belki aşağı akışta dengesini kaybetmiştir?Dialogue: 0,0:14:32.69,0:14:36.04,Main,Usopp,0,0,0,,Olabilir. Kolları ve bacakları bağlıydı sonuçta.Dialogue: 0,0:14:36.04,0:14:38.88,Main,Usopp,0,0,0,,Hiçbir şeye tutunamamış olmalı.Dialogue: 0,0:14:38.88,0:14:40.27,Main,Brook,0,0,0,,Hayır, şey...Dialogue: 0,0:14:41.20,0:14:43.99,Main,Brook,0,0,0,,Halatlar kendiliğinden çıkmış gibi duruyor. Bakın.Dialogue: 0,0:14:45.04,0:14:47.19,Main,Usopp,0,0,0,,Y-Yani o hala güvertede mi?Dialogue: 0,0:14:47.77,0:14:48.84,Main,Usopp,0,0,0,,Nerede?!Dialogue: 0,0:14:49.49,0:14:52.11,Main,Nami,0,0,0,,Geminin bir yerinde saklanıyor olabilir.Dialogue: 0,0:14:55.01,0:14:57.59,Thoughts,Caribou,0,0,0,,Eğer saklanmamı istiyorsanız belki de saklanmalıyım.Dialogue: 0,0:14:57.59,0:14:59.40,Thoughts,Caribou,0,0,0,,Kadınlar bölümüne mesela?Dialogue: 0,0:14:59.40,0:15:04.88,Main,Usopp,0,0,0,,Kahretsin... Kendi gemimizde bile gardımızı indiremiyor muyuz?Dialogue: 0,0:15:05.19,0:15:09.05,Main,Franky,0,0,0,,Farketmez. O kadar da güçlü biri değil zaten.Dialogue: 0,0:15:11.38,0:15:13.14,Thoughts,Caribou,0,0,0,,Bu çok iyi!Dialogue: 0,0:15:14.38,0:15:21.69,Thoughts,Caribou,0,0,0,,Kraken'le dövüşen o canavar üçlü kayboluverdi!Dialogue: 0,0:15:22.21,0:15:28.61,Thoughts,Caribou,0,0,0,,Burada o kadar küçük baloncukların içinde kaybolduklarına göre kesin ölmüşlerdir!Dialogue: 0,0:15:30.50,0:15:35.37,Thoughts,Caribou,0,0,0,,Hasır Şapka'nın kellesini alamamam yazık oldu ama...Dialogue: 0,0:15:35.37,0:15:39.78,Thoughts,Caribou,0,0,0,,bu gemideki diğer herkesin kellesini alırsam eğer,Dialogue: 0,0:15:39.78,0:15:44.45,Thoughts,Caribou,0,0,0,,bu Hasır Şapka'nın öldüğünü kanıtlamak için yeter de artar bile!Dialogue: 0,0:15:46.54,0:15:49.78,Thoughts,Caribou,0,0,0,,Ama, fazla acele etme, Caribou!Dialogue: 0,0:15:49.78,0:15:51.56,Thoughts,Caribou,0,0,0,,Çok erken davranmamalısın!Dialogue: 0,0:15:51.56,0:15:55.13,Thoughts,Caribou,0,0,0,,Eğer onları şimdi öldürürsen gemiyi sürecek kimse kalmaz.Dialogue: 0,0:15:55.13,0:15:59.80,Thoughts,Caribou,0,0,0,,Denizde yönlerini bulma konusunda çok yetenekliler.Dialogue: 0,0:15:59.80,0:16:03.10,Thoughts,Caribou,0,0,0,,Ama Balık Adam Adası'na ulaştığımız anda...Dialogue: 0,0:16:03.10,0:16:06.26,Thoughts,Caribou,0,0,0,,bu onların sonu olacak!Dialogue: 0,0:16:09.26,0:16:11.07,Main,Franky,0,0,0,,Burada!Dialogue: 0,0:16:14.57,0:16:15.57,Main,Caribou,0,0,0,,Kahretsin!Dialogue: 0,0:16:15.57,0:16:17.59,Main,Franky,0,0,0,,Artık iyi olacağız.Dialogue: 0,0:16:15.57,0:16:17.59,Secondary,Caribou,0,0,0,,Berbat ettim!Dialogue: 0,0:16:17.59,0:16:19.63,Main,Brook,0,0,0,,Bu küçük varilin içine nasıl girdi?Dialogue: 0,0:16:20.01,0:16:24.49,Main,Franky,0,0,0,,Dikkatsiz davrandık. O bu kadar aptal olmasaydı sıkıntıdaydık.Dialogue: 0,0:16:24.80,0:16:28.29,Main,Franky,0,0,0,,Vücudu asıl şeklini kaybetti ve çamurumsu bir maddeye dönüştü.Dialogue: 0,0:16:28.29,0:16:30.79,Main,Franky,0,0,0,,Hiç şüphesiz bu bir şeytan meyvesi.Dialogue: 0,0:16:30.79,0:16:33.16,Main,Franky,0,0,0,,Dahası, o bir Logia.Dialogue: 0,0:16:33.72,0:16:37.77,Main,Franky,0,0,0,,Saldırılarımızı bilerek yedi ve yakalanmış gibi davrandı.Dialogue: 0,0:16:37.77,0:16:41.20,Main,Caribou,0,0,0,,Hey! Lütfen beni buradan çıkar usta!Dialogue: 0,0:16:41.20,0:16:45.48,Main,Caribou,0,0,0,,Mayo giyen usta! Senin hizmetkarın olurum!Dialogue: 0,0:16:48.11,0:16:49.87,Main,Franky,0,0,0,,Ne oldu, Chopper?Dialogue: 0,0:16:49.87,0:16:53.47,Main,Chopper,0,0,0,,Bilmiyorum, bir anda çok sıcaklaştı.Dialogue: 0,0:16:53.47,0:16:56.14,Main,Chopper,0,0,0,,Ben sıcaklığı kaldıramıyorum.Dialogue: 0,0:16:56.53,0:16:59.16,Main,Usopp,0,0,0,,Çok sıcak! Neler oluyor?!Dialogue: 0,0:16:59.57,0:17:03.22,Main,Usopp,0,0,0,,Ha, bu da ne? Duman?Dialogue: 0,0:17:03.22,0:17:05.06,Main,Usopp,0,0,0,,Görüşümüzü kısıtlıyor!Dialogue: 0,0:17:05.06,0:17:07.90,Main,Chopper,0,0,0,,Deniz yüzeyinden çıkan duman mı? Nasıl?Dialogue: 0,0:17:07.90,0:17:09.13,Main,Nami,0,0,0,,Bu...Dialogue: 0,0:17:10.41,0:17:11.95,Main,Nami,0,0,0,,Yoksa?!Dialogue: 0,0:17:14.74,0:17:16.27,Main,Nami,0,0,0,,Hidrotermal yataklar!Dialogue: 0,0:17:16.27,0:17:17.17,Main,Usopp,0,0,0,,Ha?Dialogue: 0,0:17:17.17,0:17:19.44,Main,Nami,0,0,0,,Burası sualtı yanardağları ile dolu bir alan!Dialogue: 0,0:17:20.00,0:17:22.23,Main,Nami,0,0,0,,Bak! Yakın zamanda etkin olduklarını görebilirsin.Dialogue: 0,0:17:23.51,0:17:25.08,Main,Franky,0,0,0,,Buradan çıkmalıyız!Dialogue: 0,0:17:25.55,0:17:27.43,Main,Franky,0,0,0,,Eğer biri bile patlarsa işimiz biter!Dialogue: 0,0:17:28.35,0:17:30.83,Main,Chopper,0,0,0,,Sıcak... çok sıcak!Dialogue: 0,0:17:32.53,0:17:34.44,Main,Chopper,0,0,0,,Peşimizden bir şey geliyor!Dialogue: 0,0:17:34.44,0:17:36.26,Main,Usopp,0,0,0,,Etcil bir tüp solucanı!Dialogue: 0,0:17:39.95,0:17:42.23,Main,Brook,0,0,0,,Yüzsüz yengeçler!Dialogue: 0,0:17:44.32,0:17:46.74,Main,Usopp,0,0,0,,Bunun ne olduğunu bilmiyorum!Dialogue: 0,0:17:46.74,0:17:47.77,Main,Franky,0,0,0,,Chotto... Dialogue: 0,0:17:46.74,0:17:47.77,Attack,Franky,0,0,0,,Küçük...Dialogue: 0,0:17:47.77,0:17:49.19,Main,Franky,0,0,0,,Coup de Burst! Dialogue: 0,0:17:47.77,0:17:49.19,Attack,Franky,0,0,0,,Rüzgar PatlamasıDialogue: 0,0:17:49.53,0:17:51.88,Main,Chopper,0,0,0,,Derin deniz korkunç!Dialogue: 0,0:17:52.71,0:17:56.81,Main,Chopper,0,0,0,,Luffy ve diğerlerinin orada hayatta kalmalarının imkanı yok.Dialogue: 0,0:17:56.81,0:18:00.79,Main,Chopper,0,0,0,,Çok üzgünüm. İki yıl sonra tekrar buluşmuştuk oysaki.Dialogue: 0,0:18:00.79,0:18:03.72,Main,Usopp,0,0,0,,Saçmasapan konuşma! Onlar o kadar kolay ölmezler!Dialogue: 0,0:18:03.72,0:18:09.01,Main,Franky,0,0,0,,Arka arkaya Coup de Burst kullandık... Fazla havamız kalmadı.Dialogue: 0,0:18:10.58,0:18:13.43,Main,Chopper,0,0,0,,O da ne? Çok fazla parlıyor!Dialogue: 0,0:18:13.43,0:18:17.66,Main,Chopper,0,0,0,,Belki de Balık Adam Adası'dır! Belki Luffy ve diğerleri de oradadır!Dialogue: 0,0:18:17.66,0:18:20.50,Main,Nami,0,0,0,,Daha üç kilometre dalmadık.Dialogue: 0,0:18:20.50,0:18:23.17,Main,Franky,0,0,0,,Sen de kim-sin?Dialogue: 0,0:18:23.17,0:18:26.98,Main,Usopp,0,0,0,,Hey! O sinyalleri nasıl gönderiyorsun öyle?!Dialogue: 0,0:18:27.56,0:18:28.68,Main,Usopp,0,0,0,,Bir şey görüyor musun?Dialogue: 0,0:18:28.68,0:18:30.56,Main,Chopper,0,0,0,,Hala fazla parlak.Dialogue: 0,0:18:34.09,0:18:35.05,Main,Franky,0,0,0,,Olamaz!Dialogue: 0,0:18:37.92,0:18:40.70,Main,Usopp,0,0,0,,Fenerbalığı! Bizi kandırdı!Dialogue: 0,0:18:41.12,0:18:44.26,Main,Brook,0,0,0,,Bir derin deniz avcısı tarafından yakalandık! Bu hiç iyi değil!Dialogue: 0,0:18:47.90,0:18:49.53,Main,Usopp,0,0,0,,Bu yakındı!Dialogue: 0,0:18:49.53,0:18:53.60,Main,Franky,0,0,0,,Bizi direkt tuzağına çekti! Kaçabilecek miyiz?Dialogue: 0,0:18:59.88,0:19:01.68,Main,Franky,0,0,0,,Şimdi ne var?!Dialogue: 0,0:19:01.68,0:19:03.05,Main,Nami,0,0,0,,İ-İnsan?!Dialogue: 0,0:19:03.05,0:19:05.05,Main,Chopper,0,0,0,,O da ne öyle?!Dialogue: 0,0:19:05.05,0:19:09.29,Main,Usopp,0,0,0,,İnsan şekline sahip bir deniz canavarı!Dialogue: 0,0:19:10.41,0:19:14.19,Main,Usopp,0,0,0,,Umibozu! Dialogue: 0,0:19:17.70,0:19:19.88,Main,Chopper,0,0,0,,Gemiyi batıracak!Dialogue: 0,0:19:23.82,0:19:24.63,Main,Usopp,0,0,0,,O mu?!Dialogue: 0,0:19:25.14,0:19:28.77,Main,Wadatsumi,0,0,0,,Hey! Fenerbalığı! Bunu yapamazsın!Dialogue: 0,0:19:29.78,0:19:31.78,Main,Wadatsumi,0,0,0,,Gemileri yemek yok!Dialogue: 0,0:19:32.09,0:19:34.41,Main,Wadatsumi,0,0,0,,Sana daha kaç kere söylemem gerek?Dialogue: 0,0:19:35.12,0:19:38.68,Main,Wadatsumi,0,0,0,,Kaptan Vander Decken-sama sana kızacak!Dialogue: 0,0:19:39.01,0:19:41.25,Main,Nami,0,0,0,,B-Bizi kurtardı mı?Dialogue: 0,0:19:42.29,0:19:44.74,Main,Usopp,0,0,0,,K-Kaçalım! Ne olduğunu boşver, kaçalım!Dialogue: 0,0:19:44.74,0:19:46.19,Main,Usopp,0,0,0,,İkisi de canavar!Dialogue: 0,0:19:52.63,0:19:56.97,Main,Vander Decken,0,0,0,,Ölüler konuşmaz ve açgözlülük etmez. Dialogue: 0,0:19:56.27,0:19:56.97,Secondary,Brook,0,0,0,,Yoksa o...Dialogue: 0,0:19:57.73,0:20:02.76,Main,Vander Decken,0,0,0,,Kargaların bile uçmadığı bu kapkara ülkede,Dialogue: 0,0:19:57.73,0:19:58.61,Secondary,Brook,0,0,0,,...ben miyim?Dialogue: 0,0:19:59.86,0:20:01.15,Main,Usopp,0,0,0,,Dialogue: 0,0:20:03.47,0:20:07.99,Main,Vander Decken,0,0,0,,ölümün parmaklarında mücevherlere ihtiyacı yoktur.Dialogue: 0,0:20:08.97,0:20:14.04,Main,Vander Decken,0,0,0,,Karanlıkta kendi pişmanlıklarını bile göremezler.Dialogue: 0,0:20:14.70,0:20:23.18,Main,Vander Decken,0,0,0,,Arayın! Arayın! Batan tüm hazineler bana ait! Dialogue: 0,0:20:23.18,0:20:30.73,Main,Vander Decken,0,0,0,,Ben dünyanın en zengin adamı, Kaptan Vander Decken!Dialogue: 0,0:20:35.41,0:20:36.17,Main,Usopp,0,0,0,,Olamaz...Dialogue: 0,0:20:39.75,0:20:40.98,Main,Nami,0,0,0,,Denizin dibinde bile mi?!Dialogue: 0,0:20:46.37,0:20:48.50,Main,Brook,0,0,0,,Hayır!Dialogue: 0,0:20:48.50,0:20:50.17,Main,Brook,0,0,0,,Hayalet gemi!Dialogue: 0,0:20:50.17,0:20:52.41,Main,Usopp,0,0,0,,Sen neden korkuyorsun ki?!Dialogue: 0,0:20:52.41,0:20:56.06,Main,Brook,0,0,0,,O şey gerçek! Şu yelkene bir bakın!Dialogue: 0,0:20:57.19,0:21:03.68,Main,Brook,0,0,0,,Efsanevi gemi, Uçan Hollandalı! Bu dünyada var olmaması gereken bir gemi!Dialogue: 0,0:21:03.68,0:21:07.55,Main,Brook,0,0,0,,Yüzyıllar öncesinden kalma bir hikaye var.Dialogue: 0,0:21:08.88,0:21:10.92,Main,Brook,0,0,0,,Bir gün, fırtına sırasında,Dialogue: 0,0:21:11.47,0:21:14.56,Main,Brook,0,0,0,,birdenbire deliye dönen korsan gemisinin kaptanı,Dialogue: 0,0:21:14.56,0:21:19.83,Main,Brook,0,0,0,,tayfasını teker teker fırtınalı denize attı, hepsini öldürdü,Dialogue: 0,0:21:19.83,0:21:22.57,Main,Brook,0,0,0,,hatta Tanrı'nın yüzüne tükürdü!Dialogue: 0,0:21:22.57,0:21:28.29,Main,Brook,0,0,0,,O kaptanın adı Vander Decken'di! Geminin adı da Uçan Hollandalı'ydı!Dialogue: 0,0:21:28.29,0:21:31.32,Main,Brook,0,0,0,,Tanrı'nın gazabını üstüne çekti veDialogue: 0,0:21:31.32,0:21:38.33,Main,Brook,0,0,0,,ebediyen keder içinde, denizlerde sürüklenmekle lanetlendi!Dialogue: 0,0:21:38.33,0:21:45.64,Main,Brook,0,0,0,,Şu anda gözümüzün önünde duran o gemi, Kaptan Vander Decken'ın lanetli gemisi!Dialogue: 0,0:21:45.64,0:21:51.01,Main,Vander Decken,0,0,0,,Fenerbalığı! Wadatsumi! Eğer gemiyi yerseniz, hazinelerini alamam!Dialogue: 0,0:21:51.01,0:21:52.81,Main,Vander Decken,0,0,0,,Ezin onu!Dialogue: 0,0:21:54.52,0:21:56.19,Main,Wadatsumi,0,0,0,,Anlaşıldı!Dialogue: 0,0:21:56.65,0:21:58.76,Main,Usopp,0,0,0,,Ah! Umibozu...Dialogue: 0,0:21:58.76,0:22:01.10,Main,Chopper,0,0,0,,Düşmanmış demek ki!Dialogue: 0,0:22:01.10,0:22:03.42,Main,Nami,0,0,0,,Franky! Coup de Burst'ı kullan!Dialogue: 0,0:22:03.42,0:22:06.10,Main,Franky,0,0,0,,Yapamam! Hiç yakıtımız kalmadı!Dialogue: 0,0:22:06.10,0:22:09.20,Main,Franky,0,0,0,,Enerji odasındaki kolayı yeniden doldurmamız lazım!Dialogue: 0,0:22:17.21,0:22:18.76,Main,Chopper,0,0,0,,Kraken?! Dialogue: 0,0:22:23.91,0:22:26.58,Main,Vander Decken,0,0,0,,Kuzey Kutbu'nun canavarı, Kraken.Dialogue: 0,0:22:26.58,0:22:28.21,Main,Wadatsumi,0,0,0,,Seni pislik! Dialogue: 0,0:22:32.06,0:22:34.35,Main,Luffy,0,0,0,,Hey, bu kadar yeter!Dialogue: 0,0:22:34.35,0:22:35.04,Main,Luffy,0,0,0,,Kes şunu!Dialogue: 0,0:22:35.88,0:22:37.03,Main,Luffy,0,0,0,,Aferin sana!Dialogue: 0,0:22:41.77,0:22:44.27,Main,Luffy,0,0,0,,Heeeey!Dialogue: 0,0:22:44.73,0:22:47.45,Main,Usopp,0,0,0,,Luffy! Zoro, Sanji!Dialogue: 0,0:22:47.45,0:22:50.57,Main,Chopper,0,0,0,,Çok şükür hayattasınız!Dialogue: 0,0:22:50.57,0:22:54.24,Main,Sanji,0,0,0,,Nami-swan! Robin-chwan!Dialogue: 0,0:22:54.24,0:22:56.83,Main,Luffy,0,0,0,,Sizi arıyorduk millet!Dialogue: 0,0:22:57.88,0:22:59.88,Main,Zoro,0,0,0,,Başımıza cidden çok dert açtılar...Dialogue: 0,0:23:00.39,0:23:01.65,Main,Zoro,0,0,0,,Bizden ayrılarak...Dialogue: 0,0:23:01.65,0:23:04.95,Main,Vander Decken,0,0,0,,Hey! Uyan, Wadatsumi!Dialogue: 0,0:23:04.95,0:23:07.78,Main,Vander Decken,0,0,0,,İntikam zamanı! Bitir işlerini!Dialogue: 0,0:23:10.35,0:23:14.96,Main,Luffy,0,0,0,,Benim ve Sanji'nin baloncuğu patladı, biz de Zoro'nunkine girdik.  Dialogue: 0,0:23:16.15,0:23:17.71,Main,Luffy,0,0,0,,Az kalsın ölüyorduk!Dialogue: 0,0:23:17.71,0:23:19.70,Main,Nami,0,0,0,,Bizi bu kadar endişelendirmeyin!Dialogue: 0,0:23:20.93,0:23:23.90,Main,Luffy,0,0,0,,Sonunda! Burada olmak en iyisi!Dialogue: 0,0:23:23.90,0:23:27.30,Main,Chopper,0,0,0,,Luffy! Çok endişelendim!Dialogue: 0,0:23:28.29,0:23:31.26,Main,Franky,0,0,0,,Dayanıklılığınızdan etkilendim!Dialogue: 0,0:23:31.26,0:23:34.87,Main,Nami,0,0,0,,İnanılmaz! Cidden onu eğittiniz mi?!Dialogue: 0,0:23:34.87,0:23:36.95,Main,Nami,0,0,0,,O canavar ahtapotu?!Dialogue: 0,0:23:36.95,0:23:41.53,Main,Luffy,0,0,0,,Evet! Onu tıpkı bir profesyonel gibi kullanıyorum!Dialogue: 0,0:23:41.53,0:23:42.64,Main,Luffy,0,0,0,,Değil mi, Surume?Dialogue: 0,0:23:42.64,0:23:44.93,Main,Usopp,0,0,0,,Neden ona bir mürekkepbalığı ismi verdin?!Dialogue: 0,0:23:45.34,0:23:48.60,Main,Usopp,0,0,0,,Gemiyi tam olarak çekmiyor gerçi.Dialogue: 0,0:23:48.60,0:23:51.64,Main,Usopp,0,0,0,,Umuyorum dikkatli olur da bizi ezmez.Dialogue: 0,0:23:56.36,0:23:57.14,Main,Luffy,0,0,0,,Ne oluyor?Dialogue: 0,0:23:57.14,0:23:58.31,Main,Wadatsumi,0,0,0,,Ha?!Dialogue: 0,0:24:02.38,0:24:05.88,Main,Pirate,0,0,0,,Bu hiç iyi değil, Kaptan Vander Decken!Dialogue: 0,0:24:06.40,0:24:09.26,Main,Nami,0,0,0,,Olamaz! Sualtı yanardağları...Dialogue: 0,0:24:09.26,0:24:09.95,Main,Nami,0,0,0,,patlıyor!Dialogue: 0,0:00:39.81,0:00:43.07,Credits,,0,0,0,,Translation & initial timing Yibis FansubsDialogue: 0,0:00:50.20,0:00:54.26,Credits,,0,0,0,,Quality-checking Sewil Galaxy 9000 FeesoDialogue: 0,0:00:54.59,0:00:58.79,Credits,,0,0,0,,Soundtracking HaleeDialogue: 0,0:01:16.42,0:01:18.52,Credits,,0,0,0,,Video editing SewilDialogue: 0,0:00:45.24,0:00:48.84,Credits,,0,0,0,,Timing Galaxy 9000  Time-checking Sewil