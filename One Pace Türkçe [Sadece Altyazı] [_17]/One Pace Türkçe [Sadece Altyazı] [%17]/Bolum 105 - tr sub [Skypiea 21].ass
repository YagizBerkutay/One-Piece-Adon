&H00000000,0,0,0,0,100,100,0,0,1,1.5,0,8,10,10,30,1Style: Karaoke,Duality,65,&H009E375F,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,8,10,10,30,1Style: Translation,Duality,65,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,3,0,2,10,10,30,1Style: Luffy Monologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1Style: KaraokeED,Duality,70,&H00FFFFFF,&H000000FF,&H00DB7A3A,&H00000000,0,0,0,0,100,100,2,0,1,3,0,7,30,8,15,1Style: TranslationED,Duality,70,&H00FFFFFF,&H000000FF,&H00DB7A3A,&H00000000,0,0,0,0,100,100,2,0,1,3,0,1,30,100,15,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:50.05,0:02:00.04,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 50,0:01:50.88,0:01:53.51,Narrator-207-,,0,0,0,,Kuzey Mavi'de bir krallıkta,Dialogue: 50,0:01:53.51,0:01:56.01,Narrator-207-,,0,0,0,,Mont Blanc Noland diye biri yaşarmış.Dialogue: 50,0:01:57.64,0:02:03.56,Narrator-207-,,0,0,0,,Noland sürekli fantastik gezilerinden bahseden bir kaşifmiş.Dialogue: 50,0:02:04.40,0:02:09.90,Narrator-207-,,0,0,0,,Ancak, köylüler hikayeleri doğru mu değil mi bir türlü anlayamazlarmış.Dialogue: 50,0:02:11.32,0:02:15.87,Narrator-207-,,0,0,0,,Bir gün keşiften dönen Noland,  Kral'a rapor vermiş:Dialogue: 50,0:02:16.57,0:02:19.54,Flashbacks-207-,,0,0,0,,Harabeye dönmesine rağmen hâlâ güzel ve görkemli kalmış.Dialogue: 50,0:02:20.33,0:02:22.04,Flashbacks-207-,,0,0,0,,Oraya "Shandora" diyorlar!Dialogue: 50,0:02:22.04,0:02:26.00,Flashbacks-207-,,0,0,0,,Tam anlamıyla "Altın Şehir".Dialogue: 50,0:02:28.46,0:02:33.47,Main-207-,,0,0,0,,Mary Geoise, Grand Line'a olan yolculuğunu kabul etti.Dialogue: 50,0:02:33.93,0:02:37.10,Main-207-,,0,0,0,,Bu nedenle, seni başka bir göreve göndermek istiyorum.Dialogue: 50,0:02:37.10,0:02:38.81,Main-207-,,0,0,0,,Memnuniyetle!Dialogue: 50,0:02:38.81,0:02:45.60,Main-207-,,0,0,0,,Ancak, bu kez tayfa askerlerimden oluşacak ve kişisel olarak sana eşlik edeceğim.Dialogue: 50,0:02:45.60,0:02:46.90,Main-207-,,0,0,0,,Anlaşıldı mı?Dialogue: 50,0:02:46.90,0:02:47.90,Main-207-,,0,0,0,,Emredersiniz!Dialogue: 50,0:02:51.32,0:02:52.40,Main-207-,,0,0,0,,Kalgara!Dialogue: 50,0:02:52.40,0:02:53.40,Main-207-,,0,0,0,,Seto...Dialogue: 50,0:02:53.40,0:02:55.28,Main-207-,,0,0,0,,Çanı mı çalacaksın?Dialogue: 50,0:02:55.28,0:02:56.82,Main-207-,,0,0,0,,Yardım edeyim.Dialogue: 50,0:02:59.95,0:03:01.37,Main-207-,,0,0,0,,Hey, Nola.Dialogue: 50,0:03:01.37,0:03:03.71,Main-207-,,0,0,0,,Harabede yaşamaktan memnun gibisin.Dialogue: 50,0:03:06.50,0:03:09.96,Main-207-,,0,0,0,,Hey, sence Noland-san ve tayfası ne zaman gelecek?Dialogue: 50,0:03:11.13,0:03:13.97,Main-207-,,0,0,0,,Buraya gelince hep bunu soruyorsun.Dialogue: 50,0:03:14.38,0:03:16.93,Main-207-,,0,0,0,,Geri dönmesi o kadar da kolay olmayacak.Dialogue: 50,0:03:17.30,0:03:20.30,Main-207-,,0,0,0,,Uzak kuzey denizinde doğdu.Dialogue: 50,0:03:20.30,0:03:22.31,Main-207-,,0,0,0,,Ayrıca memleketinde bir ailesi var.Dialogue: 50,0:03:22.31,0:03:24.18,Main-207-,,0,0,0,,Ama sözleştik.Dialogue: 50,0:03:24.18,0:03:29.69,Main-207-,,0,0,0,,Bu çanı çalmaya devam ettiğimiz sürece, er ya da geç ortaya çıkacak.Dialogue: 50,0:03:33.86,0:03:35.11,Main-207-,,0,0,0,,Bu da ne?!Dialogue: 50,0:03:35.11,0:03:36.20,Main-207-,,0,0,0,,İyiye alamet değil!Dialogue: 50,0:03:37.03,0:03:38.99,Main-207-,,0,0,0,,Gel, Seto! Köyü korumalıyız!Dialogue: 50,0:04:02.43,0:04:03.64,Thoughts-207-,,0,0,0,,Niye?Dialogue: 50,0:04:05.27,0:04:07.81,Thoughts-207-,,0,0,0,,Ada neden burada bitiyor?!Dialogue: 50,0:04:11.15,0:04:12.48,Main-207-,,0,0,0,,Seni köpek...!Dialogue: 50,0:04:12.48,0:04:14.78,Main-207-,,0,0,0,,Bana yalan söyledin!Dialogue: 50,0:04:14.78,0:04:18.24,Main-207-,,0,0,0,,Senin şu altınların nerede?Dialogue: 50,0:04:18.74,0:04:20.53,Thoughts-207-,,0,0,0,,Köy nereye kayboldu?!Dialogue: 50,0:04:21.87,0:04:23.95,Thoughts-207-,,0,0,0,,Bu adaya ne oldu böyle?!Dialogue: 50,0:04:23.95,0:04:25.37,Thoughts-207-,,0,0,0,,Kalgara!Dialogue: 50,0:04:25.37,0:04:27.58,Thoughts-207-,,0,0,0,,Eğer hayattaysan duymama izin ver!Dialogue: 50,0:04:27.58,0:04:29.46,Thoughts-207-,,0,0,0,,Altın çanın sesini!Dialogue: 50,0:04:29.46,0:04:32.63,Thoughts-207-,,0,0,0,,Cevap ver, Shandora'nın Işığı!Dialogue: 50,0:04:36.34,0:04:39.01,Main-207-,,0,0,12,,Noland'ın halka açık infazı başlamak üzere!Dialogue: 50,0:04:39.88,0:04:42.22,Main-207-,,0,0,0,,Hey! Bu taraftan, millet!Dialogue: 50,0:04:42.22,0:04:44.18,Main-207-,,0,0,0,,Altı yıl önce,Dialogue: 50,0:04:44.18,0:04:48.48,Main-207-,,0,0,0,,Grand Line'daki Jaya Adası'nda devasa bir altın şehir gördüm!Dialogue: 50,0:04:49.19,0:04:52.31,Main-207-,,0,0,0,,Altın Şehir gerçekten var!Dialogue: 50,0:04:52.65,0:04:55.69,Main-207-,,0,0,0,,O zaman mürettebatınızdan birini dinleyelim.Dialogue: 50,0:04:56.23,0:04:58.74,Main-207-,,0,0,0,,Bu adam gerçeği mi söylüyor?Dialogue: 50,0:04:59.11,0:05:01.53,Main-207-,,0,0,0,,Hayır. Tamamen yalan.Dialogue: 50,0:05:01.99,0:05:05.70,Main-207-,,0,0,0,,Ne?! Noland-san bir yalancı mı?!Dialogue: 50,0:05:05.70,0:05:08.16,Main-207-,,0,0,0,,Öyleyse anlattığı tüm hikayeler yalan mıydı?!Dialogue: 50,0:05:08.16,0:05:09.41,Main-207-,,0,0,0,,Bu berbat bir şey!Dialogue: 50,0:05:09.41,0:05:12.04,Main-207-,,0,0,0,,Herkese yalan söyledi ve kahraman gibi davrandı!Dialogue: 50,0:05:12.92,0:05:16.30,Main-207-,,0,0,0,,O tanık da kim?! Bizim arkadaşımız değil!Dialogue: 50,0:05:16.30,0:05:18.21,Main-207-,,0,0,0,,Kalgara ve kabilesini görmedin mi?Dialogue: 50,0:05:18.59,0:05:21.05,Main-207-,,0,0,0,,Komodor! Orada ne oldu?!Dialogue: 50,0:05:21.43,0:05:22.80,Main-207-,,0,0,0,,Yakalayın onları!Dialogue: 50,0:05:24.72,0:05:25.76,Main-207-,,0,0,0,,Kahretsin!Dialogue: 50,0:05:26.60,0:05:27.81,Main-207-,,0,0,0,,Adamlarım...Dialogue: 50,0:05:31.31,0:05:33.56,Main-207-,,0,0,0,,Mont Blanc Noland,Dialogue: 50,0:05:33.56,0:05:37.07,Main-207-,,0,0,0,,iğrenç yalanları yüzünden, başı kesilerek idama mahkûm edilmiştir.Dialogue: 50,0:05:38.69,0:05:40.03,Main-207-,,0,0,0,,Yalancı!Dialogue: 50,0:05:40.03,0:05:43.53,Main-207-,,0,0,0,,– Yalancı! – Yalancı!Dialogue: 50,0:05:43.53,0:05:46.41,Main-207-,,0,0,0,,Komodor asla yalan söylemez!Dialogue: 50,0:05:46.41,0:05:47.79,Main-207-,,0,0,0,,Komodor!Dialogue: 50,0:05:47.79,0:06:00.67,Main-207-,,0,0,0,,– Yalancı! Yalancı! – Yalancı! Yalancı!Dialogue: 50,0:06:43.09,0:06:46.26,Main-207-,,0,0,0,,Tanrı'm! Dev bir vearth adası!Dialogue: 50,0:06:46.26,0:06:48.76,Main-207-,,0,0,0,,Aynen öyle. Duydun mu?Dialogue: 50,0:06:48.76,0:06:51.47,Main-207-,,0,0,0,,Bu görkemli vearth'ün şarkı söyleyen sesi...Dialogue: 50,0:06:51.47,0:06:54.94,Main-207-,,0,0,0,,Bu gerçekten kutsal bir toprağın doğuşu.Dialogue: 50,0:06:55.31,0:06:58.02,Main-207-,,0,0,0,,Orada yaşamalıyım!Dialogue: 50,0:07:01.57,0:07:03.69,Thoughts-207-,,0,0,0,,Ne oldu öyle?!Dialogue: 50,0:07:04.32,0:07:07.37,Thoughts-207-,,0,0,0,,Neler oluyor?! Zar zor nefes alıyorum!Dialogue: 50,0:07:07.74,0:07:08.95,Main-207-,,0,0,0,,Herkes iyi mi?!Dialogue: 50,0:07:08.95,0:07:10.53,Main-207-,,0,0,0,,Kendinize gelin!Dialogue: 50,0:07:10.53,0:07:11.74,Main-207-,,0,0,0,,Kendinize gelin artık!Dialogue: 50,0:07:11.74,0:07:13.75,Main-207-,,0,0,0,,Yaralılarla ilgilenin! Acele edin!Dialogue: 50,0:07:13.75,0:07:16.42,Main-207-,,0,0,0,,Kalgara! Davetsiz misafirler!Dialogue: 50,0:07:16.42,0:07:19.42,Main-207-,,0,0,0,,Bu vearth'ün benim olduğunu iddia ediyorum!Dialogue: 50,0:07:19.42,0:07:21.42,Main-207-,,0,0,0,,Ben Tanrı'yım!Dialogue: 50,0:07:23.05,0:07:24.92,Main-207-,,0,0,0,,Kıçımın tanrısı!Dialogue: 50,0:07:24.92,0:07:27.80,Main-207-,,0,0,0,,Onları geri püskürtün, savaşçılar!Dialogue: 50,0:07:27.80,0:07:30.26,Main-207-,,0,0,0,,Burayı almalarına izin veremeyiz!Dialogue: 50,0:07:32.97,0:07:35.85,Thoughts-207-,,0,0,0,,Bir söz verdik, Noland.Dialogue: 50,0:07:35.85,0:07:39.11,Thoughts-207-,,0,0,0,,Bir gün tekrar buluşacağız.Dialogue: 50,0:07:39.56,0:07:40.98,Thoughts-207-,,0,0,0,,Kalgara...Dialogue: 50,0:07:40.98,0:07:43.32,Thoughts-207-,,0,0,0,,nereye kayboldun?Dialogue: 50,0:07:43.32,0:07:49.03,Thoughts-207-,,0,0,0,,Jaya'ya döndüğün zaman bizi gitmiş görünce ne düşüneceksin?Dialogue: 50,0:07:50.03,0:07:51.62,Thoughts-207-,,0,0,0,,Sadece biraz daha bekle!Dialogue: 50,0:07:51.62,0:07:53.62,Thoughts-207-,,0,0,0,,Bir mesaj göndereceğim...Dialogue: 50,0:07:53.62,0:07:56.29,Thoughts-207-,,0,0,0,,"Biz buradayız!" diye.Dialogue: 50,0:07:56.29,0:07:58.79,Thoughts-207-,,0,0,0,,Hayatta mısın?!Dialogue: 50,0:07:58.79,0:08:01.54,Thoughts-207-,,0,0,0,,Sana anlatacak çok şeyim var.Dialogue: 50,0:08:02.67,0:08:03.84,Thoughts-207-,,0,0,0,,Kalgara...Dialogue: 50,0:08:04.59,0:08:08.26,Thoughts-207-,,0,0,0,,Sadece iyi olup olmadığını bilmek istiyorum...Dialogue: 50,0:08:09.39,0:08:13.76,Thoughts-207-,,0,0,0,,Bir gün yine bu topraklarda buluşalım, Noland!Dialogue: 50,0:08:14.81,0:08:18.06,Flashbacks-207-,,0,0,0,,Shandora'nın Işığını Yakın!Dialogue: 50,0:08:18.89,0:08:22.23,Main-207-,,0,0,0,,Şanlı Savaşçı Kalgara, o sözlerle bağırmaya devam etti.Dialogue: 50,0:08:22.23,0:08:24.57,Main-207-,,0,0,0,,Sadece bir kez çalsa yeterli olacaktı,Dialogue: 50,0:08:25.11,0:08:31.95,Main-207-,,0,0,0,,çünkü Shandora'nın Işığı'nın yankılanıp herkese şunu duyuracağına inanıyordu:Dialogue: 50,0:08:31.95,0:08:34.41,Main-207-,,0,0,0,,"Biz buradayız!"Dialogue: 50,0:08:34.41,0:08:38.04,Main-207-,,0,0,0,,Ancak, çan hiç çalmadı.Dialogue: 50,0:08:38.50,0:08:44.46,Main-207-,,0,0,0,,Daha sonra, Mavi Deniz'den köyümüze gelen bir gemi, haberler getirdi.Dialogue: 50,0:08:44.46,0:08:48.59,Main-207-,,0,0,0,,Kurtarıcımız, şehrimizin övünç kaynağı Noland,Dialogue: 50,0:08:48.59,0:08:55.22,Main-207-,,0,0,0,,yalancı olarak damgalanmış ve Shandora'nın varlığını reddetmeden ölmüştü.Dialogue: 50,0:08:55.72,0:08:58.48,Main-207-,,0,0,0,,Ama çok geç olmuşken bile...Dialogue: 50,0:08:58.48,0:09:04.07,Main-207-,,0,0,0,,Şanlı Savaşçı Kalgara, gökte de büyük savaşçı olmaya devam etti.Dialogue: 50,0:09:04.52,0:09:07.15,Main-207-,,0,0,0,,Hislerini ulaştırmadaki başarısızlığı...Dialogue: 50,0:09:07.15,0:09:07.99,Main-207-,,0,0,0,,onun...Dialogue: 50,0:09:08.94,0:09:11.61,Main-207-,,0,0,0,,Şanlı Savaşçı Kalgara'nın en büyük pişmanlığıydı.Dialogue: 50,0:09:11.61,0:09:13.66,Main-207-,,0,0,0,,Sence hâlâ ona ulaşabilir mi?Dialogue: 50,0:09:13.66,0:09:15.49,Main-207-,,0,0,0,,Şu çan!Dialogue: 50,0:09:16.04,0:09:18.66,Main-207-,,0,0,0,,Şimdi çalsak, sesi Noland'a ulaşır mı?!Dialogue: 50,0:09:20.62,0:09:22.46,Main-207-,,0,0,0,,Çok güzel bir soru.Dialogue: 50,0:09:22.83,0:09:25.50,Main-207-,,0,0,0,,Burada cennete yakınız...Dialogue: 50,0:09:27.92,0:09:31.88,Main-207-,,0,0,0,,Wyper! Şimdi kaçmazsak öleceğiz!Dialogue: 50,0:09:32.26,0:09:33.34,Main-207-,,0,0,0,,Hadi ama!Dialogue: 50,0:09:34.55,0:09:36.39,Main-207-,,0,0,0,,Wyper...Dialogue: 50,0:09:36.39,0:09:37.35,Main-207-,,0,0,0,,Enel...Dialogue: 50,0:09:37.97,0:09:41.77,Main-207-,,0,0,0,,Sana her şeyi alma hakkını veren ne?!Dialogue: 50,0:09:45.94,0:09:48.69,Main-207-,,0,0,0,,Burası gökyüzü! Tanrı'nın çiftliği!Dialogue: 50,0:09:49.65,0:09:51.36,Main-207-,,0,0,0,,Her şey bir felaket!Dialogue: 50,0:09:51.36,0:09:55.66,Main-207-,,0,0,0,,İnsanlar, ağaçlar ve toprak! Ait olduğunuz yere dönün!Dialogue: 50,0:09:55.66,0:09:58.99,Main-207-,,0,0,0,,Her şey, Mavi Deniz'e yağsın!Dialogue: 50,0:10:03.04,0:10:04.04,Main-207-,,0,0,0,,Çabuk!Dialogue: 50,0:10:04.04,0:10:06.13,Main-207-,,0,0,0,,Melek Adası fazla dayanmayacak!Dialogue: 50,0:10:07.92,0:10:09.84,Main-207-,,0,0,0,,Çok sayıda yaralı var!Dialogue: 50,0:10:09.84,0:10:12.09,Main-207-,,0,0,0,,Botlara bindirin ve orada tedavi edin!Dialogue: 50,0:10:12.93,0:10:13.80,Main-207-,,0,0,0,,Kaçın!Dialogue: 50,0:10:13.80,0:10:15.97,Main-207-,,0,0,0,,– Çabuk! – Çabuk, denize açılın!Dialogue: 50,0:10:18.89,0:10:22.69,Thoughts-207-,,0,0,0,,O kızın uyarısı bir an bile gecikmiş olsaydı sıçmıştık.Dialogue: 50,0:10:22.69,0:10:24.44,Thoughts-207-,,0,0,0,,O iyi mi acaba?!Dialogue: 50,0:10:37.03,0:10:42.75,Main-207-,,0,0,0,,Melekler nasıl da rahatsız olmuş karıncalar gibi koşturuyor!Dialogue: 50,0:10:42.75,0:10:47.29,Main-207-,,0,0,0,,Ait olduğun yere dön, Skypiea!Dialogue: 50,0:10:49.71,0:10:51.05,Main-207-,,0,0,0,,O da ne?!Dialogue: 50,0:10:51.88,0:10:54.01,Main-207-,,0,0,0,,Beyaz-Beyaz Deniz'de bir delik mi?!Dialogue: 50,0:10:54.01,0:10:58.35,Main-207-,,0,0,0,,Bu nostaljik eski tapınağa artık ihtiyacım yok!Dialogue: 50,0:11:03.48,0:11:06.35,Main-207-,,0,0,0,,Altındaki Shandora şehrine de...Dialogue: 50,0:11:16.28,0:11:21.04,Main-207-,,0,0,0,,Burada istediğim tek bir şey var!Dialogue: 50,0:11:21.04,0:11:23.91,Main-207-,,0,0,0,,Büyük altın çan!Dialogue: 50,0:11:25.08,0:11:28.21,Main-207-,,0,0,0,,Hâlâ iki ses mi duyuyorum?Dialogue: 50,0:11:28.54,0:11:30.96,Main-207-,,0,0,0,,Tanrım! Nasıl bu kadar hızlı koşabiliyor?!Dialogue: 50,0:11:31.71,0:11:33.80,Main-207-,,0,0,0,,Nami, lütfen iyi ol!Dialogue: 50,0:11:33.80,0:11:38.64,Main-207-,,0,0,0,,O altın çanı almana izin vermeyeceğim, Enel!Dialogue: 50,0:11:50.48,0:11:53.73,Main-207-,,0,0,0,,Enel'in orada istediği ne var?Dialogue: 50,0:11:53.73,0:11:55.86,Main-207-,,0,0,0,,Tepede saklı olan altın çanı istiyor.Dialogue: 50,0:11:56.28,0:11:57.45,Main-207-,,0,0,0,,Çan...Dialogue: 50,0:11:57.91,0:11:59.70,Main-207-,,0,0,0,,Altın bir çan mı?Dialogue: 50,0:12:00.91,0:12:03.41,Main-207-,,0,0,0,,Daha önce de söylemiştin, değil mi?Dialogue: 50,0:12:03.41,0:12:04.50,Main-207-,,0,0,0,,Wyper...Dialogue: 50,0:12:04.50,0:12:05.50,Main-207-,,0,0,0,,Evet...Dialogue: 50,0:12:05.50,0:12:08.83,Main-207-,,0,0,0,,N-N-Ne konuşuyorsunuz siz?!Dialogue: 50,0:12:09.33,0:12:15.21,Main-207-,,0,0,0,,Enel seni çarpmadan önce ona çandan bahsetmiştin.Dialogue: 50,0:12:15.21,0:12:17.30,Main-207-,,0,0,0,,Yani peşinde olduğu şey o mu?Dialogue: 50,0:12:17.80,0:12:19.55,Main-207-,,0,0,0,,Tam olarak nerede?!Dialogue: 50,0:12:19.55,0:12:21.55,Main-207-,,0,0,0,,Hey, durun biraz!Dialogue: 50,0:12:21.55,0:12:23.81,Main-207-,,0,0,0,,Bunu konuşacak vaktimiz yok!Dialogue: 50,0:12:23.81,0:12:25.27,Main-207-,,0,0,0,,O yıldırımı gördünüz!Dialogue: 50,0:12:26.02,0:12:28.39,Main-207-,,0,0,0,,Buradan kaçmazsak öleceğiz!Dialogue: 50,0:12:30.98,0:12:34.07,Main-207-,,0,0,0,,Bu dev sarmaşığın tepesine yakın bir yerde.Dialogue: 50,0:12:34.40,0:12:36.69,Main-207-,,0,0,0,,Nasıl?! Bunu nasıl bilebilirsin?!Dialogue: 50,0:12:36.69,0:12:37.74,Main-207-,,0,0,0,,Hey!Dialogue: 50,0:12:38.70,0:12:41.91,Main-207-,,0,0,0,,Nami'ye onu gemide bekleyeceğimize söz verdik!Dialogue: 50,0:12:42.41,0:12:46.16,Main-207-,,0,0,0,,Luffy'yi alıp hemen arkamızdan gelecek!Dialogue: 50,0:12:46.16,0:12:47.66,Main-207-,,0,0,0,,O haklı, Wyper.Dialogue: 50,0:12:48.79,0:12:51.92,Main-207-,,0,0,0,,Shandora'nın kalıntıları tam altımızda.Dialogue: 50,0:12:51.92,0:12:55.96,Main-207-,,0,0,0,,Sarmaşık, toprağı tam şehrin kalbinden delip geçmiş.Dialogue: 50,0:12:57.01,0:12:59.63,Main-207-,,0,0,0,,Hey, bakın! Hey!Dialogue: 50,0:12:59.63,0:13:03.47,Main-207-,,0,0,0,,Harabe olsun ya da olmasın, her şey paramparça olmuş!Dialogue: 50,0:13:04.72,0:13:08.27,Main-207-,,0,0,0,,Sıradaki biz olabiliriz!Dialogue: 50,0:13:08.27,0:13:13.86,Main-207-,,0,0,0,,Harabede bulduğum bir harita, büyük çan kulesinin bir zamanlar...Dialogue: 50,0:13:13.86,0:13:16.53,Main-207-,,0,0,0,,şehrin merkezinde olduğunu gösteriyordu.Dialogue: 50,0:13:16.90,0:13:20.49,Main-207-,,0,0,0,,Diğer bir deyişle, sarmaşığın güçlü darbesi...Dialogue: 50,0:13:20.49,0:13:23.37,Main-207-,,0,0,0,,çanı daha da yukarıya fırlatmış olabilir.Dialogue: 50,0:13:38.51,0:13:39.80,Flashbacks-207-,,0,0,0,,Hey, millet!Dialogue: 50,0:13:44.18,0:13:48.27,Flashbacks-207-,,0,0,0,,Büyük çan, Altın Şehir'de olmalı, değil mi?Dialogue: 50,0:13:54.65,0:13:57.61,Main-207-,,0,0,0,,Güzel, Dev Jack'in tepesine ulaştım.Dialogue: 50,0:13:58.48,0:14:04.78,Main-207-,,0,0,0,,Kimsenin Tanrı'nın Tapınağı'nın bu kadar yukarısını aradığını sanmıyorum.Dialogue: 50,0:14:05.78,0:14:07.99,Main-207-,,0,0,0,,400 yıl sonra bile.Dialogue: 50,0:14:08.54,0:14:11.37,Main-207-,,0,0,0,,Şimdi, nerede bu...Dialogue: 50,0:14:11.87,0:14:13.83,Main-207-,,0,0,0,,altın çan?Dialogue: 50,0:14:26.97,0:14:28.43,Main-207-,,0,0,0,,Burası da ne böyle?!Dialogue: 50,0:14:34.65,0:14:36.52,Main-207-,,0,0,0,,Yine o...Dialogue: 50,0:14:37.02,0:14:40.28,Main-207-,,0,0,0,,Kolundaki o ağırlıkla buraya gelebilmesine şaşırdım.Dialogue: 50,0:14:42.11,0:14:43.78,Main-207-,,0,0,0,,İşte ordasın!Dialogue: 50,0:14:44.57,0:14:49.66,Main-207-,,0,0,0,,Tam orada bekle! Enel!Dialogue: 50,0:14:50.45,0:14:52.12,Main-207-,,0,0,0,,Baş belası.Dialogue: 50,0:15:16.06,0:15:18.27,Main-207-,,0,0,0,,Wyper! Ne yapmaya çalışıyorsun?Dialogue: 50,0:15:18.27,0:15:20.77,Main-207-,,0,0,0,,Sarmaşığa tırmanacağını söyleme sakın!Dialogue: 50,0:15:25.74,0:15:28.03,Main-207-,,0,0,0,,Herkes sarmaşıktan uzaklaşsın!Dialogue: 50,0:15:28.03,0:15:29.91,Main-207-,,0,0,0,,Bir şey düşüyor!Dialogue: 50,0:15:37.88,0:15:38.88,Main-207-,,0,0,0,,Sarmaşığın ucu mu?!Dialogue: 50,0:15:39.25,0:15:40.46,Main-207-,,0,0,0,,Orada ne oldu?!Dialogue: 50,0:15:40.46,0:15:44.88,Main-207-,,0,0,0,,Hey, hey! Sakın bana Luffy ve Nami'nin onunla düştüğünü söyleme?!Dialogue: 50,0:15:44.88,0:15:46.26,Main-207-,,0,0,0,,Wyper!Dialogue: 50,0:15:47.18,0:15:50.85,Main-207-,,0,0,0,,Yapma! Böyle gidemezsiniz!Dialogue: 50,0:15:50.85,0:15:52.60,Main-207-,,0,0,0,,Perişan durumdasın!Dialogue: 50,0:15:52.60,0:15:57.69,Main-207-,,0,0,0,,Oraya tırmansan bile, Enel'e ulaşmanın hiçbir yolu yok!Dialogue: 50,0:15:57.69,0:15:58.48,Main-207-,,0,0,0,,O...Dialogue: 50,0:15:59.73,0:16:01.86,Main-207-,,0,0,0,,Tam üstümüzde!Dialogue: 50,0:16:03.32,0:16:08.07,Main-207-,,0,0,0,,Şanlı Savaşçı Kalgara'nın aradığı çan!Dialogue: 50,0:16:17.46,0:16:21.63,Main-207-,,0,0,0,,O hâlde buraya tırmanmayı nasıl planlıyorsun?Dialogue: 50,0:16:22.63,0:16:24.51,Main-207-,,0,0,0,,P-Pislik!Dialogue: 50,0:16:27.26,0:16:29.84,Main-207-,,0,0,0,,Bir süre daha orada kal.Dialogue: 50,0:16:30.76,0:16:33.26,Main-207-,,0,0,0,,Sana ilginç bir şey göstereceğim.Dialogue: 50,0:16:42.61,0:16:43.69,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:16:46.65,0:16:50.45,Main-207-,,0,0,0,,Ah, sahi. Geri gelmeden önce bir şey yapsam iyi olur!Dialogue: 50,0:17:06.13,0:17:10.63,Main-207-,,0,0,0,,Lastik-Lastik...Dialogue: 50,0:17:12.01,0:17:14.72,Main-207-,,0,0,0,,Yo-Yo!Dialogue: 50,0:17:21.48,0:17:23.11,Main-207-,,0,0,0,,Ne yapıyor bu?!Dialogue: 50,0:17:29.19,0:17:31.82,Main-207-,,0,0,0,,Pekâlâ! Hedefime geri döndüm!Dialogue: 50,0:17:32.20,0:17:34.87,Main-207-,,0,0,0,,Şimdi o gemiye binme şansım var!Dialogue: 50,0:17:38.83,0:17:40.75,Main-207-,,0,0,0,,Luffy! Nihayet sana yetiştim!Dialogue: 50,0:17:40.75,0:17:43.58,Main-207-,,0,0,0,,Ha? Nami! Burada ne yapıyorsun?!Dialogue: 50,0:17:43.96,0:17:45.88,Main-207-,,0,0,0,,Seni almaya geldim.Dialogue: 50,0:17:45.88,0:17:49.63,Main-207-,,0,0,0,,Sanji-kun ve Usopp sayesinde güvenli bir şekilde aşağı inmiştim!Dialogue: 50,0:17:50.92,0:17:53.43,Main-207-,,0,0,0,,Demek öyle! Anladım!Dialogue: 50,0:17:53.43,0:17:54.47,Main-207-,,0,0,0,,Bu harika!Dialogue: 50,0:17:54.97,0:17:56.51,Main-207-,,0,0,0,,Daha da önemlisi...Dialogue: 50,0:17:57.18,0:17:57.97,Main-207-,,0,0,0,,Bekle!Dialogue: 50,0:17:59.22,0:18:00.39,Main-207-,,0,0,0,,O da ne?!Dialogue: 50,0:18:04.69,0:18:08.28,Main-207-,,0,0,0,,Fırtına bulutları şekil değiştiriyor.Dialogue: 50,0:18:13.32,0:18:14.36,Main-207-,,0,0,0,,Gökyüzü!Dialogue: 50,0:18:14.36,0:18:16.33,Main-207-,,0,0,0,,Kurtarın bizi!Dialogue: 50,0:18:16.33,0:18:19.54,Main-207-,,0,0,0,,– Gökyüzü simsiyah! – Çok kötü! Kurtarın bizi!Dialogue: 50,0:18:20.00,0:18:21.46,Main-207-,,0,0,0,,– Anne! – Ne oluyor?!Dialogue: 50,0:18:21.96,0:18:24.92,Main-207-,,0,0,0,,Denize! Çabuk!Dialogue: 50,0:18:24.92,0:18:29.25,Main-207-,,0,0,0,,Gökyüzünde süzülen dev bir top var!Dialogue: 50,0:18:34.09,0:18:35.80,Main-207-,,0,0,0,,O şeyin iyi olma ihtimali yok.Dialogue: 50,0:18:36.30,0:18:40.18,Main-207-,,0,0,0,,Fırtına bulutu küresinin içi...Dialogue: 50,0:18:40.85,0:18:44.56,Main-207-,,0,0,0,,inanılmaz hava akımları ve elektriksel boşalmalarla dolu!Dialogue: 50,0:18:57.37,0:19:00.41,Main-207-,,0,0,0,,Tam Melek Adası'nın üstünde!Dialogue: 50,0:19:01.66,0:19:03.66,Main-207-,,0,0,0,,Fırtına bulutlarını küreye dönüştürmüş.Dialogue: 50,0:19:04.79,0:19:06.96,Main-207-,,0,0,0,,B-Bu bir kabus olmalı!Dialogue: 50,0:19:06.96,0:19:08.88,Main-207-,,0,0,0,,Bu gerçek olamaz!Dialogue: 50,0:19:10.38,0:19:15.18,Main-207-,,0,0,0,,Daha neler planlıyor acaba?!Dialogue: 50,0:19:21.14,0:19:23.23,Main-207-,,0,0,0,,Denize! Denize, çabuk!Dialogue: 50,0:19:23.23,0:19:24.35,Main-207-,,0,0,0,,Bekleyin!Dialogue: 50,0:19:32.61,0:19:36.03,Main-207-,,0,0,0,,Göklerin bana ait olduğunu öğrenme vaktiniz geldi!Dialogue: 50,0:19:38.16,0:19:42.54,Main-207-,,0,0,0,,Gemi Maxim'le benim birleşen gücümüz...Dialogue: 50,0:19:42.54,0:19:45.21,Main-207-,,0,0,0,,bir tanrının gücünü oluşturuyor!Dialogue: 50,0:19:46.42,0:19:47.67,Main-207-,,0,0,0,,Şuna bakın!Dialogue: 50,0:19:47.67,0:19:49.58,Main-207-,,0,0,0,,Melek Adası'nın üstüne düşecek!Dialogue: 50,0:19:51.50,0:19:52.42,Main-207-,,0,0,0,,Çok geç!Dialogue: 50,0:19:52.42,0:19:54.34,Main-207-,,0,0,0,,Başaramayacağız!Dialogue: 50,0:19:54.34,0:19:55.84,Main-207-,,0,0,0,,Canını seven kaçsın!Dialogue: 50,0:19:55.84,0:19:57.34,Main-207-,,0,0,0,,Korkuyorum!Dialogue: 50,0:20:05.93,0:20:07.64,Main-207-,,0,0,0,,*Raigo.Dialogue: 50,0:20:35.13,0:20:37.13,Main-207-,,0,0,0,,Hayır, bu gerçek olamaz!Dialogue: 50,0:20:37.13,0:20:39.43,Main-207-,,0,0,0,,Beyaz Bereliler kaçtı mı?Dialogue: 50,0:20:39.43,0:20:42.51,Main-207-,,0,0,0,,Bizi kurtardılar...Dialogue: 50,0:20:42.51,0:20:44.31,Main-207-,,0,0,0,,Doğduğumuz ada...Dialogue: 50,0:20:45.84,0:20:48.27,Main-207-,,0,0,0,,Yurdumuz... Tamamen yok oldu!Dialogue: 50,0:20:51.23,0:20:55.23,Main-207-,,0,0,0,,Deniz bulutları bile yok oldu!Dialogue: 50,0:21:01.24,0:21:03.12,Main-207-,,0,0,0,,Ne harika bir manzara!Dialogue: 50,0:21:03.87,0:21:06.45,Main-207-,,0,0,0,,Gökyüzü böyle olmalı.Dialogue: 50,0:21:11.37,0:21:14.63,Main-207-,,0,0,0,,O-O ne tür bir patlamaydı öyle?!Dialogue: 50,0:21:15.00,0:21:19.67,Main-207-,,0,0,0,,Üstelik yıldırımlar hâlâ yağmur gibi düşüyor!Dialogue: 50,0:21:19.67,0:21:22.59,Main-207-,,0,0,0,,Bundan sağ çıkabileceğimizi sanmıyorum!Dialogue: 50,0:21:23.05,0:21:27.85,Main-207-,,0,0,0,,Melek Adası'nı yok etti.Dialogue: 50,0:21:30.35,0:21:32.27,Main-207-,,0,0,0,,Nasıl bu kadar...Dialogue: 50,0:21:33.19,0:21:36.44,Main-207-,,0,0,0,,Nasıl bu kadar acımasız olabilirsin, Enel?!Dialogue: 50,0:21:40.86,0:21:42.66,Main-207-,,0,0,0,,Ne gümbürtü ama...Dialogue: 50,0:21:44.66,0:21:45.83,Main-207-,,0,0,0,,Beklemeliyiz.Dialogue: 50,0:21:46.54,0:21:49.50,Main-207-,,0,0,0,,Mavi Deniz'e dönmelerine yardım etmeliyim.Dialogue: 50,0:21:51.08,0:21:53.54,Main-207-,,0,0,0,,Luffy! Hadi bin de aşağı inelim!Dialogue: 50,0:21:54.17,0:21:56.00,Main-207-,,0,0,0,,Herkes çoktan gemiye gitti!Dialogue: 50,0:21:56.00,0:21:58.00,Main-207-,,0,0,0,,Biz de gitmeliyiz!Dialogue: 50,0:21:58.76,0:21:59.71,Main-207-,,0,0,0,,Gelemem.Dialogue: 50,0:22:00.17,0:22:03.26,Main-207-,,0,0,0,,Gelemez misin? Neden?! Ne demek istiyorsun?!Dialogue: 50,0:22:03.26,0:22:05.60,Main-207-,,0,0,0,,Artık kurtarılmaya ihtiyacın olmasa bile...Dialogue: 50,0:22:06.10,0:22:08.72,Main-207-,,0,0,0,,burada hâlâ yarım kalan bir işim var!Dialogue: 50,0:22:08.72,0:22:11.85,Main-207-,,0,0,0,,"Yarım kalan iş" mi? Burada daha ne işin olabilir ki?!Dialogue: 50,0:22:11.85,0:22:13.90,Main-207-,,0,0,0,,Enel'den intikam almaya mı çalışıyorsun?!Dialogue: 50,0:22:13.90,0:22:16.98,Main-207-,,0,0,0,,Altın çan burada, gökyüzünde!Dialogue: 50,0:22:17.36,0:22:20.49,Main-207-,,0,0,0,,Altın çan mı?Dialogue: 50,0:22:20.49,0:22:23.36,Main-207-,,0,0,0,,Canımız daha önemli! Şuna bak!Dialogue: 50,0:22:24.03,0:22:26.32,Main-207-,,0,0,0,,Yıldırım seni etkilemese bile,Dialogue: 50,0:22:26.32,0:22:30.41,Main-207-,,0,0,0,,yine de diğer her şeyi yok edebilir!Dialogue: 50,0:22:30.41,0:22:33.79,Main-207-,,0,0,0,,Altın istiyorsan kolundakiyle yetin!Dialogue: 50,0:22:34.37,0:22:36.46,Main-207-,,0,0,0,,Altın çanı unut!Dialogue: 50,0:22:36.46,0:22:38.30,Main-207-,,0,0,0,,Öldürüleceksin!Dialogue: 50,0:22:38.30,0:22:40.09,Main-207-,,0,0,0,,Ölmeyeceğim.Dialogue: 50,0:22:40.09,0:22:41.92,Main-207-,,0,0,0,,Şunu keser misin artık?! Sen–Dialogue: 50,0:22:41.92,0:22:43.26,Main-207-,,0,0,0,,Kendin de gördün!Dialogue: 50,0:22:44.76,0:22:46.18,Main-207-,,0,0,0,,Neyi?Dialogue: 50,0:22:50.97,0:22:54.52,Main-207-,,0,0,0,,Altın Şehir... Gerçekten varmış!Dialogue: 50,0:22:59.57,0:23:01.11,Main-207-,,0,0,0,,Yalan söylemiyordu!Dialogue: 50,0:23:03.15,0:23:05.20,Main-207-,,0,0,0,,Kestane kafalı ihtiyarın atası...Dialogue: 50,0:23:08.03,0:23:09.95,Flashbacks-207-,,0,0,0,,Oradaysa sorun değil,Dialogue: 50,0:23:09.95,0:23:12.29,Flashbacks-207-,,0,0,0,,değilse de sorun değil.Dialogue: 50,0:23:12.29,0:23:15.79,Flashbacks-207-,,0,0,0,,Onun masum olduğunu kanıtlamak umurumda değil.Dialogue: 50,0:23:16.75,0:23:22.09,Flashbacks-207-,,0,0,0,,Bu, hayatımı karartan adamla bir hesaplaşma.Dialogue: 50,0:23:23.13,0:23:25.63,Main-207-,,0,0,0,,Gerçeği söylüyordu.Dialogue: 50,0:23:26.68,0:23:30.10,Main-207-,,0,0,0,,Bu yüzden kestane kafalı ihtiyar ve maymunlar bilmek zorunda!Dialogue: 50,0:23:32.72,0:23:35.27,Main-207-,,0,0,0,,Altın Şehir gökte!Dialogue: 50,0:23:38.98,0:23:40.90,Main-207-,,0,0,0,,Çanı çalarsam...Dialogue: 50,0:23:42.03,0:23:43.78,Main-207-,,0,0,0,,duyacaklar.Dialogue: 50,0:23:44.53,0:23:49.49,Main-207-,,0,0,0,,Aksi takdirde, ölene kadar denizin dibini aramaya devam edecekler!Dialogue: 50,0:23:54.37,0:23:55.46,Main-207-,,0,0,0,,Luffy...Dialogue: 50,0:23:56.58,0:23:59.04,Main-207-,,0,0,0,,Enel'in onu almasına izin veremem!Dialogue: 50,0:23:59.88,0:24:04.01,Main-207-,,0,0,0,,O devasa çanın sesi, her yerden duyulabilecek kadar gürültülü olacak!Dialogue: 50,0:24:06.05,0:24:10.22,Main-207-,,0,0,0,,Bu yüzden ben, o altın çanı çalacağım!Dialogue: 50,0:24:14.06,0:24:18.69,Flashbacks-207-,,0,0,0,,Hey, millet! Büyük çan, Altın Şehir'de olmalı, değil mi?Dialogue: 50,0:24:19.19,0:24:24.40,Flashbacks-207-,,0,0,0,,Noland'ın seyir defterine göre öyle. Kesinlikle olduğunu yazmış.Dialogue: 50,0:24:24.78,0:24:26.28,Flashbacks-207-,,0,0,0,,Neden soruyorsun?Dialogue: 50,0:24:26.28,0:24:27.86,Flashbacks-207-,,0,0,0,,Evet, neden?Dialogue: 50,0:24:29.55,0:24:32.99,Flashbacks-207-,,0,0,0,,Aklıma harika bir fikir geldi!Dialogue: 50,0:24:32.99,0:24:34.58,Flashbacks-207-,,0,0,0,,Ne? Nedir o?Dialogue: 50,0:24:35.37,0:24:38.62,Flashbacks-207-,,0,0,0,,O koca çanı çalarsam...Dialogue: 50,0:24:38.62,0:24:42.88,Flashbacks-207-,,0,0,0,,muhtemelen kestane kafalı ihtiyar ve maymunlar duyacak!Dialogue: 50,0:24:45.59,0:24:47.97,Flashbacks-207-,,0,0,0,,Kesinlikle duyarlar, değil mi?Dialogue: 50,0:24:50.39,0:24:53.30,Main-207-,,0,0,0,,Bir şeyi yapacağım deyince yapar.Dialogue: 50,0:24:53.64,0:24:56.02,Main-207-,,0,0,0,,Yani o...Dialogue: 50,0:24:56.35,0:24:58.23,Main-207-,,0,0,0,,Kesinlikle, öyle dedi.Dialogue: 50,0:24:58.23,0:25:00.35,Main-207-,,0,0,0,,Ama işler bu durumdayken...Dialogue: 50,0:25:03.94,0:25:05.28,Main-207-,,0,0,0,,Çanı...Dialogue: 50,0:25:05.61,0:25:07.78,Main-207-,,0,0,0,,Çanı çalacak mı?Dialogue: 50,0:25:08.32,0:25:12.99,Main-207-,,0,0,0,,Evet. Nami onu geri getirmeye çalışsa bile gelmeyecektir.Dialogue: 50,0:25:14.03,0:25:17.95,Main-207-,,0,0,0,,Çünkü o ve Enel, aynı şeyin peşinde.Dialogue: 50,0:25:27.59,0:25:28.38,Main-207-,,0,0,0,,Yakaladım!Dialogue: 50,0:25:32.93,0:25:36.01,Main-207-,,0,0,0,,Gemime binebileceğini kim söyledi?Dialogue: 50,0:25:36.51,0:25:37.60,Main-207-,,0,0,0,,Enel!Dialogue: 50,0:25:46.40,0:25:50.11,Main-207-,,0,0,0,,Luffy! Sana kötü bir fikir olduğunu söylemiştim!Dialogue: 50,0:25:50.74,0:25:51.82,Main-207-,,0,0,0,,Pislik herif!Dialogue: 50,0:25:53.32,0:25:54.82,Main-207-,,0,0,0,,Nasıldı?Dialogue: 50,0:25:54.82,0:25:58.58,Main-207-,,0,0,0,,O zavallı küçük adanın gökyüzünden kaybolduğunu gördün mü?Dialogue: 50,0:25:59.29,0:26:00.66,Main-207-,,0,0,0,,Kız.Dialogue: 50,0:26:00.66,0:26:05.04,Main-207-,,0,0,0,,Seni Sonsuz Vearth'e götürmem için beni tatlı dille kandırma çabandan...Dialogue: 50,0:26:05.04,0:26:07.25,Main-207-,,0,0,0,,vazgeçtiğini varsayabilir miyim?Dialogue: 50,0:26:07.63,0:26:08.46,Main-207-,,0,0,0,,Aynen öyle!Dialogue: 50,0:26:08.46,0:26:12.59,Main-207-,,0,0,0,,İstediğimi alınca...Dialogue: 50,0:26:12.59,0:26:18.01,Main-207-,,0,0,0,,tüm Skypiea'yı parçalamak için bir Raigo daha kullanacağım!Dialogue: 50,0:26:18.01,0:26:21.56,Main-207-,,0,0,0,,Hiç biriniz kaçamayacaksınız!Dialogue: 50,0:26:26.06,0:26:30.15,Main-207-,,0,0,0,,Ne siz, ne de tam altınızdaki birkaç ses!Dialogue: 50,0:26:30.69,0:26:31.95,Main-207-,,0,0,0,,Hemen altımızda mı?!Dialogue: 50,0:26:32.57,0:26:36.16,Main-207-,,0,0,0,,Bu gökyüzüne ait olmayan toprakları ortadan kaldıracağım...Dialogue: 50,0:26:37.03,0:26:40.70,Main-207-,,0,0,0,,ve her şeyi hak ettiği düzene geri döndüreceğim!Dialogue: 50,0:26:41.37,0:26:42.87,Main-207-,,0,0,0,,Bu...Dialogue: 50,0:26:42.87,0:26:47.00,Main-207-,,0,0,0,,Bu, Tanrı olarak benim görevim!Dialogue: 50,0:26:53.72,0:26:55.68,Main-207-,,0,0,0,,Bunun olmasına...Dialogue: 50,0:26:56.72,0:27:00.89,Main-207-,,0,0,0,,izin vermeyeceğim!Dialogue: 50,0:27:08.27,0:27:10.36,Main-207-,,0,0,0,,Elveda, lastik adam!Dialogue: 50,0:27:10.36,0:27:13.86,Main-207-,,0,0,0,,Elin kolun bağlı şekilde ecelini bekle!Dialogue: 50,0:27:15.95,0:27:16.49,Main-207-,,0,0,0,,Luffy!Dialogue: 50,0:27:23.96,0:27:24.66,Main-207-,,0,0,0,,Luffy!Dialogue: 50,0:27:28.79,0:27:33.30,Main-207-,,0,0,0,,Artık... hiç kimse beni durduramaz.Dialogue: 50,0:27:37.39,0:27:40.05,Main-207-,,0,0,0,,Kahretsin!Dialogue: 50,0:27:40.43,0:27:44.81,Flashbacks-207-,,0,0,0,,Size söz veriyorum, yarın gökyüzünde geziyor olacaksınız!Dialogue: 50,0:27:51.73,0:27:53.03,Main-207-,,0,0,0,,Luffy...Dialogue: 50,0:27:55.95,0:27:58.45,Main-207-,,0,0,0,,Ben...Dialogue: 50,0:28:02.41,0:28:08.12,Main-207-,,0,0,0,,o çanı çalacağım!!!Dialogue: 1,0:01:51.05,0:01:56.01,Captions-207-,,0,0,0,,Kuzey MaviDialogue: 1,0:01:51.05,0:01:56.01,Captions-207-,,0,0,0,,Kuzey MaviDialogue: 0,0:01:51.05,0:01:56.01,Captions-207-,,0,0,0,,Kuzey MaviDialogue: 1,0:01:51.05,0:01:56.01,Captions-207-,,0,0,0,,Lvneel KrallığıDialogue: 1,0:01:51.05,0:01:56.01,Captions-207-,,0,0,0,,Lvneel KrallığıDialogue: 0,0:01:51.05,0:01:56.01,Captions-207-,,0,0,0,,Lvneel KrallığıDialogue: 0,0:01:56.05,0:02:04.27,Title-207-,,0,0,0,,RaigoDialogue: 1,0:01:56.05,0:02:04.27,Title-207-,,0,0,0,,RaigoDialogue: 1,0:02:27.46,0:02:30.46,Captions-207-,,0,0,0,,5 Yıl SonraDialogue: 1,0:02:27.46,0:02:30.46,Captions-207-,,0,0,0,,5 Yıl SonraDialogue: 0,0:02:27.46,0:02:30.46,Captions-207-,,0,0,0,,5 Yıl SonraDialogue: 1,0:02:47.90,0:02:50.94,Captions-207-,,0,0,0,,Noland'ın Dönmesinden 1 Yıl ÖnceDialogue: 1,0:02:47.90,0:02:50.94,Captions-207-,,0,0,0,,Noland'ın Dönmesinden 1 Yıl ÖnceDialogue: 0,0:02:47.90,0:02:50.94,Captions-207-,,0,0,0,,Noland'ın Dönmesinden 1 Yıl ÖnceDialogue: 1,0:03:57.01,0:04:02.43,Captions-207-,,0,0,0,,16 Kasım 1127 Deniz ÇağıDialogue: 1,0:03:57.01,0:04:02.43,Captions-207-,,0,0,0,,16 Kasım 1127 Deniz ÇağıDialogue: 0,0:03:57.01,0:04:02.43,Captions-207-,,0,0,0,,16 Kasım 1127 Deniz ÇağıDialogue: 1,0:04:35.51,0:04:39.01,Captions-207-,,0,0,0,,Lvneel KrallığıDialogue: 1,0:04:35.51,0:04:39.01,Captions-207-,,0,0,0,,Lvneel KrallığıDialogue: 0,0:04:35.51,0:04:39.01,Captions-207-,,0,0,0,,Lvneel KrallığıDialogue: 0,0:00:46.23,0:00:50.41,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 0,0:00:46.23,0:00:50.41,Credits-207-,,0,0,0,,fedew ZenefDialogue: 0,0:00:51.78,0:00:55.70,Credits-207-,,0,0,0,,GrafikDialogue: 0,0:00:51.78,0:00:55.70,Credits-207-,,0,0,0,,DatenshiDialogue: 0,0:00:56.79,0:01:01.04,Credits-207-,,0,0,0,,Kalite KontrolDialogue: 0,0:00:56.79,0:01:01.04,Credits-207-