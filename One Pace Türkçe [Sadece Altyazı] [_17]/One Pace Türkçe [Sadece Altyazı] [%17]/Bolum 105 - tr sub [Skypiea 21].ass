6,0:29:19.64,KaraokeED,,0,0,0,,aDialogue: 0,0:29:19.64,0:29:22.73,KaraokeED,,0,0,0,,aDialogue: 0,0:29:16.34,0:29:19.64,KaraokeED,,0,0,0,,yuDialogue: 0,0:29:19.64,0:29:19.96,KaraokeED,,0,0,0,,yuDialogue: 0,0:29:19.96,0:29:22.73,KaraokeED,,0,0,0,,yuDialogue: 0,0:29:16.34,0:29:19.96,KaraokeED,,0,0,0,,muDialogue: 0,0:29:19.96,0:29:20.30,KaraokeED,,0,0,0,,muDialogue: 0,0:29:20.30,0:29:22.73,KaraokeED,,0,0,0,,muDialogue: 0,0:29:16.34,0:29:20.30,KaraokeED,,0,0,0,,deDialogue: 0,0:29:20.30,0:29:20.49,KaraokeED,,0,0,0,,deDialogue: 0,0:29:20.49,0:29:22.73,KaraokeED,,0,0,0,,deDialogue: 0,0:29:16.34,0:29:20.49,KaraokeED,,0,0,0,,shoDialogue: 0,0:29:20.49,0:29:21.01,KaraokeED,,0,0,0,,shoDialogue: 0,0:29:21.01,0:29:22.73,KaraokeED,,0,0,0,,shoDialogue: 0,0:29:16.34,0:29:21.01,KaraokeED,,0,0,0,,uDialogue: 0,0:29:21.01,0:29:22.53,KaraokeED,,0,0,0,,uDialogue: 0,0:29:22.53,0:29:22.73,KaraokeED,,0,0,0,,uDialogue: 0,0:28:13.73,0:28:19.25,TranslationED,,0,0,0,,Yalnız ve kayıp hissettiğinde, seslenip beni yanına çağır,Dialogue: 0,0:28:19.47,0:28:24.68,TranslationED,,0,0,0,,Evden uzakta göğe bak, saklanma, yükün olmasın ağır.Dialogue: 0,0:28:24.68,0:28:27.47,TranslationED,,0,0,0,,Tıpkı ay gibisin;Dialogue: 0,0:28:27.47,0:28:32.12,TranslationED,,0,0,0,,Yıldızlardan durgun, parıltını yitirmişsin,Dialogue: 0,0:28:35.57,0:28:44.52,TranslationED,,0,0,0,,Yavaşça yok oluyorsun, buna değer mi? Kendini bitirmişsin.Dialogue: 0,0:28:44.58,0:28:49.76,TranslationED,,0,0,0,,Kendin ol, sakın ha yolundan sapma,Dialogue: 0,0:28:49.76,0:28:58.06,TranslationED,,0,0,0,,Sözlerim rehberin olsun, gün doğana dek gözünü kapatma!Dialogue: 0,0:28:58.70,0:29:04.96,TranslationED,,0,0,0,,Hayallerinden vazgeçme, sonsuz gecelerce sana gelirler,Dialogue: 0,0:29:04.96,0:29:10.57,TranslationED,,0,0,0,,Vazgeçersen göremezsin, gerçekleşmeden giderler!Dialogue: 0,0:29:11.81,0:29:16.34,TranslationED,,0,0,0,,Geri döner misin bilmem, umarım dersini alırsın,Dialogue: 0,0:29:16.34,0:29:22.73,TranslationED,,0,0,0,,Geçmişi bırak geride, yepyeni bir güne uyanırsın.