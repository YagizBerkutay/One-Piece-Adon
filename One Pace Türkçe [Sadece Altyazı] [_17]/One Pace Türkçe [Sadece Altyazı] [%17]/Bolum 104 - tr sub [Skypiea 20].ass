&H00000000,0,0,0,0,100,100,0,0,1,1.5,0,8,10,10,30,1Style: Karaoke,Duality,65,&H009E375F,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,8,10,10,30,1Style: Translation,Duality,65,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,3,0,2,10,10,30,1Style: Luffy Monologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1Style: KaraokeED,Duality,70,&H00FFFFFF,&H000000FF,&H00DB7A3A,&H00000000,0,0,0,0,100,100,2,0,1,3,0,7,30,8,15,1Style: TranslationED,Duality,70,&H00FFFFFF,&H000000FF,&H00DB7A3A,&H00000000,0,0,0,0,100,100,2,0,1,3,0,1,30,100,15,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:50.05,0:02:00.04,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 50,0:01:52.38,0:01:54.34,Main-207-,,0,0,0,,Y-Yılan!Dialogue: 50,0:01:54.72,0:01:55.80,Main-207-,,0,0,0,,Bu...?Dialogue: 50,0:01:56.18,0:01:58.43,Main-207-,,0,0,0,,Hey, Kalgara! Bak şuna!Dialogue: 50,0:02:00.06,0:02:04.02,Main-207-,,0,0,0,,Ne sürpriz ama. O yılanın torunu da varmış.Dialogue: 50,0:02:04.65,0:02:06.44,Main-207-,,0,0,0,,"O yılan" mı?Dialogue: 50,0:02:08.52,0:02:09.61,Main-207-,,0,0,0,,Yılan, demek?Dialogue: 50,0:02:13.86,0:02:16.95,Main-207-,,0,0,0,,O ikisini anlamıyorum...Dialogue: 50,0:02:16.95,0:02:20.04,Main-207-,,0,0,0,,Birkaç gün önce neredeyse birbirlerini öldürecekken...Dialogue: 50,0:02:20.04,0:02:22.54,Main-207-,,0,0,0,,şimdi çok iyi arkadaşmış gibi anlaşıyorlar.Dialogue: 50,0:02:22.54,0:02:26.25,Main-207-,,0,0,0,,Kalgara bu köyde asla arkadaş edinmedi.Dialogue: 50,0:02:27.25,0:02:29.75,Main-207-,,0,0,0,,Onu hiç böyle gülerken görmemiştim.Dialogue: 50,0:02:31.96,0:02:33.97,Main-207-,,0,0,0,,Sadece beni izleyin.Dialogue: 50,0:02:35.13,0:02:36.97,Main-207-,,0,0,0,,Buradan aşağı iniyoruz.Dialogue: 50,0:02:36.97,0:02:38.47,Main-207-,,0,0,0,,Aşağı mı?Dialogue: 50,0:02:49.69,0:02:51.53,Main-207-,,0,0,0,,Bu ses...Dialogue: 50,0:02:52.53,0:02:55.78,Main-207-,,0,0,0,,Hey, Kalgara! Bu güzel ses nereden geliyor?!Dialogue: 50,0:02:55.78,0:02:58.74,Main-207-,,0,0,0,,Beni izlersen göreceksin.Dialogue: 50,0:03:36.45,0:03:38.03,Main-207-,,0,0,0,,Geldiler!Dialogue: 50,0:03:38.03,0:03:40.03,Main-207-,,0,0,0,,Nefesiniz mi kesildi?Dialogue: 50,0:03:40.03,0:03:41.87,Main-207-,,0,0,0,,Burası Altın Şehir, Shandora.Dialogue: 50,0:03:41.87,0:03:44.91,Main-207-,,0,0,0,,Biz bu şehrin hayatta kalanlarıyız.Dialogue: 50,0:03:45.37,0:03:47.37,Main-207-,,0,0,0,,Altın şehir...Dialogue: 50,0:03:47.92,0:03:50.88,Main-207-,,0,0,0,,Hayal görüyor gibiyim.Dialogue: 50,0:03:51.29,0:03:54.51,Main-207-,,0,0,0,,O-Oha, her yerde altın var!Dialogue: 50,0:03:54.51,0:03:58.18,Main-207-,,0,0,0,,Burası hazine şehri!Dialogue: 50,0:03:58.18,0:04:01.22,Main-207-,,0,0,0,,H-Hey, millet! Hadi ama!Dialogue: 50,0:04:01.89,0:04:03.22,Main-207-,,0,0,0,,Sorun değil.Dialogue: 50,0:04:03.22,0:04:08.10,Main-207-,,0,0,0,,O çan kulesi haricinde, geminizin taşıyabileceği kadar altın alabilirsiniz.Dialogue: 50,0:04:10.02,0:04:12.65,Main-207-,,0,0,0,,Köylülerin hepsi fikir birliğine vardı.Dialogue: 50,0:04:12.65,0:04:16.86,Main-207-,,0,0,0,,Bizi salgından kurtardığınız için size çok büyük borçlandık.Dialogue: 50,0:04:17.32,0:04:18.61,Main-207-,,0,0,0,,Başka söze gerek yok.Dialogue: 50,0:04:19.36,0:04:21.24,Main-207-,,0,0,0,,Çok cömertsiniz, Şanlı Savaşçı!Dialogue: 50,0:04:21.24,0:04:26.20,Main-207-,,0,0,0,,Ama bu şehri asırlardır korumuyor muydunuz?Dialogue: 50,0:04:26.20,0:04:27.58,Main-207-,,0,0,0,,Doğru.Dialogue: 50,0:04:27.58,0:04:31.38,Main-207-,,0,0,0,,Bu şehri koruyoruz, ama...Dialogue: 50,0:04:31.38,0:04:35.21,Main-207-,,0,0,0,,hazineyi korumuyoruz!Dialogue: 50,0:04:35.67,0:04:38.09,Main-207-,,0,0,0,,Aslında koruduğumuz şey...Dialogue: 50,0:04:45.52,0:04:47.52,Main-207-,,0,0,0,,...bu taş.Dialogue: 50,0:04:49.23,0:04:51.90,Main-207-,,0,0,0,,Bu da ne?Dialogue: 50,0:04:51.90,0:04:53.31,Main-207-,,0,0,0,,Yazı mı?Dialogue: 50,0:04:53.31,0:04:54.94,Main-207-,,0,0,0,,Tarihi bir metin.Dialogue: 50,0:04:54.94,0:04:57.69,Main-207-,,0,0,0,,Poneglif olarak bilinir.Dialogue: 50,0:04:57.69,0:05:00.07,Main-207-,,0,0,0,,Biz de okuyamıyoruz.Dialogue: 50,0:05:00.07,0:05:04.24,Main-207-,,0,0,0,,Yani bunu atalarınız yazmadı mı?Dialogue: 50,0:05:04.74,0:05:06.87,Main-207-,,0,0,0,,Bir şeyi kesin olarak biliyoruz:Dialogue: 50,0:05:06.87,0:05:12.83,Main-207-,,0,0,0,,Shandora, bu taşı korumak için verilen umutsuz bir savaş sırasında yok edildi.Dialogue: 50,0:05:13.17,0:05:17.42,Main-207-,,0,0,0,,Atalarımızın ona karşı olan sevgisini onurlandırmaya devam etmeliyiz.Dialogue: 50,0:05:17.42,0:05:19.01,Main-207-,,0,0,0,,Onların torunları olarak,Dialogue: 50,0:05:19.01,0:05:23.34,Main-207-,,0,0,0,,atalarımızın uğruna hayatlarını riske attığı mirası korumalıyız.Dialogue: 50,0:05:23.80,0:05:27.81,Main-207-,,0,0,0,,Atalarımıza tanrılarımız kadar saygı duyuyoruz.Dialogue: 50,0:05:27.81,0:05:33.86,Main-207-,,0,0,0,,Duyduğum sesin, bu devasa altın çana ait olduğu kimin aklına gelirdi...Dialogue: 50,0:05:35.77,0:05:38.69,Main-207-,,0,0,0,,Çanın sesi aslında bir mesaj.Dialogue: 50,0:05:38.69,0:05:40.11,Main-207-,,0,0,0,,Mesaj mı?Dialogue: 50,0:05:40.11,0:05:44.03,Main-207-,,0,0,0,,Cennet'teki atalarımızın ruhlarının ne zaman isterlerse...Dialogue: 50,0:05:44.03,0:05:49.12,Main-207-,,0,0,0,,güvenle buraya dönmelerine izin veriyor.Dialogue: 50,0:05:49.12,0:05:52.67,Main-207-,,0,0,0,,Şu sözleri onlara iletmesi için çanı çalıyoruz:Dialogue: 50,0:05:52.67,0:05:56.09,Main-207-,,0,0,0,,"Biz buradayız."Dialogue: 50,0:05:57.21,0:06:02.51,Main-207-,,0,0,0,,Çanın çalışı Shandora'nın eski ihtişamını gösteriyor.Dialogue: 50,0:06:02.51,0:06:06.10,Main-207-,,0,0,0,,Bu ihtişamı denizin bitimine doğru haykırıyor.Dialogue: 50,0:06:06.10,0:06:09.22,Main-207-,,0,0,0,,Asla kaçıp saklanmayacağız.Dialogue: 50,0:06:10.10,0:06:14.94,Main-207-,,0,0,0,,Bu yüzden, şehrin gurur kaynağı olan bu çana "Shandora'nın Işığı" denir.Dialogue: 50,0:06:15.48,0:06:18.98,Main-207-,,0,0,0,,Görkemli sesine yakışan bir isim.Dialogue: 50,0:06:18.98,0:06:20.36,Main-207-,,0,0,0,,Öyle mi düşünüyorsun?!Dialogue: 50,0:06:20.36,0:06:21.44,Main-207-,,0,0,0,,Tabii!Dialogue: 50,0:06:22.03,0:06:26.66,Main-207-,,0,0,0,,O gün, ışık bizi kucakladı ve buraya yönlendirdi.Dialogue: 50,0:06:28.49,0:06:35.12,Main-207-,,0,0,0,,Sağır edici bir fırtınanın içindeyken, bu çanın yankısı geldi kulağıma.Dialogue: 50,0:06:39.71,0:06:43.34,Main-207-,,0,0,0,,Bu çanın sesini sen de seviyorsun, ha?Dialogue: 50,0:06:43.34,0:06:47.89,Main-207-,,0,0,0,,Acaba sen de bir gün dev bir yılana dönüşecek misin?Dialogue: 50,0:06:52.81,0:06:55.73,Main-207-,,0,0,0,,Belki 100 yıl falan sonra!Dialogue: 50,0:06:58.27,0:07:01.48,Main-207-,,0,0,0,,Hey! İstediğin kadar kalabilirsin, Noland!Dialogue: 50,0:07:01.98,0:07:07.62,Main-207-,,0,0,0,,Shandora, 400 yıl önceki düşüşünden bu yana hiç misafir ağırlamadı!Dialogue: 50,0:07:07.62,0:07:09.70,Main-207-,,0,0,0,,Misafirperverliğimizi göstermek istiyoruz!Dialogue: 50,0:07:11.33,0:07:13.08,Main-207-,,0,0,0,,Çok memnun olurum.Dialogue: 50,0:07:13.08,0:07:15.83,Main-207-,,0,0,0,,Ormandan bitkiler toplamak istiyorum.Dialogue: 50,0:07:15.83,0:07:18.92,Main-207-,,0,0,0,,Ağaç ateşi bitene kadar tedavisiyle ilgileneceğim.Dialogue: 50,0:07:18.92,0:07:22.05,Main-207-,,0,0,0,,Komodor! Komodor!Dialogue: 50,0:07:22.05,0:07:24.05,Main-207-,,0,0,0,,Hey, hey, bu kıyafetler de ne böyle?Dialogue: 50,0:07:24.05,0:07:26.09,Main-207-,,0,0,0,,Daimi pusulaya bakın!Dialogue: 50,0:07:26.09,0:07:27.84,Main-207-,,0,0,0,,Ve bir harita, Komodor! Bir harita!Dialogue: 50,0:07:28.89,0:07:32.06,Main-207-,,0,0,0,,Onları son gelen davetsiz misafirler bıraktı.Dialogue: 50,0:07:32.60,0:07:33.85,Main-207-,,0,0,0,,Evet.Dialogue: 50,0:07:33.85,0:07:36.81,Main-207-,,0,0,0,,Kuru kafa şekli kesinlikle bu adaya ait.Dialogue: 50,0:07:36.81,0:07:41.57,Main-207-,,0,0,0,,"Shandora" adı, bu şehrin konumunu işaret eden...Dialogue: 50,0:07:41.57,0:07:45.49,Main-207-,,0,0,0,,"kuru kafanın sağ gözü" anlamına gelir.Dialogue: 50,0:07:47.20,0:07:48.91,Main-207-,,0,0,0,,Pekâlâ, kendinize iyi bakın.Dialogue: 50,0:07:48.91,0:07:51.58,Main-207-,,0,0,0,,Bol bol dinlendiğinize emin olun.Dialogue: 50,0:07:51.58,0:07:53.91,Main-207-,,0,0,0,,Doktor-san, teşekkür ederim!Dialogue: 50,0:07:56.46,0:07:58.29,Main-207-,,0,0,0,,Hey, herkes buraya gelsin!Dialogue: 50,0:07:58.29,0:08:01.54,Main-207-,,0,0,0,,Noland, bize bazı garip mahsuller vereceğini söyledi!Dialogue: 50,0:08:01.54,0:08:06.59,Main-207-,,0,0,0,,Gemide her türlü bitki örneğinin bulunduğu bir sera var.Dialogue: 50,0:08:06.59,0:08:09.84,Main-207-,,0,0,0,,Toprağınıza uygun bazı tohumlar ve filizler bırakacağım.Dialogue: 50,0:08:09.84,0:08:11.85,Main-207-,,0,0,0,,Tadı güzel mi?Dialogue: 50,0:08:11.85,0:08:14.81,Main-207-,,0,0,0,,Evet, güzel! Üstelik de besleyici.Dialogue: 50,0:09:15.45,0:09:16.99,Main-207-,,0,0,0,,Pekâlâ!Dialogue: 50,0:09:16.99,0:09:18.91,Main-207-,,0,0,0,,Bugün yine sıkı çalışalım!Dialogue: 50,0:09:19.29,0:09:21.33,Main-207-,,0,0,0,,Ne için çok çalışacaksın?Dialogue: 50,0:09:21.33,0:09:22.96,Main-207-,,0,0,0,,Kamp ateşi partisi için mi?!Dialogue: 50,0:09:31.30,0:09:32.64,Main-207-,,0,0,0,,Niye?!Dialogue: 50,0:09:32.64,0:09:35.35,Main-207-,,0,0,0,,Niye Doktor-san'ın tayfası bunu yaptı?Dialogue: 50,0:09:40.06,0:09:43.02,Main-207-,,0,0,0,,Şef! Noland ve tayfası geldi!Dialogue: 50,0:09:43.90,0:09:47.65,Main-207-,,0,0,0,,Dinleyin. Dün gece olanlardan bahsetmeyin!Dialogue: 50,0:09:47.65,0:09:50.74,Main-207-,,0,0,0,,Birkaç gün içinde denize açılacaklarını söylediler.Dialogue: 50,0:09:51.11,0:09:55.03,Main-207-,,0,0,0,,Düşüncesizce bir şey yapmadığınızdan kesinlikle emin olun!Dialogue: 50,0:09:55.41,0:09:59.29,Main-207-,,0,0,0,,Asla aynı fikirde olamayacağımızı biliyordum.Dialogue: 50,0:09:59.70,0:10:04.38,Main-207-,,0,0,0,,İlaçları ne kadar iyi olursa olsun, o hâlâ bir tanrı katili!Dialogue: 50,0:10:04.38,0:10:08.80,Main-207-,,0,0,0,,Kendilerini tarihimizi ayaklar altına alacak kadar büyük mü sanıyorlar?Dialogue: 50,0:10:09.59,0:10:14.18,Main-207-,,0,0,0,,Hislerinizi saklayın, sabırla gitmelerini bekleyin.Dialogue: 50,0:10:14.18,0:10:15.51,Main-207-,,0,0,0,,Geldiler!Dialogue: 50,0:10:18.47,0:10:19.97,Main-207-,,0,0,0,,Hepinize merhaba.Dialogue: 50,0:10:19.97,0:10:21.43,Main-207-,,0,0,0,,Kalgara burada mı?Dialogue: 50,0:10:30.32,0:10:34.49,Main-207-,,0,0,0,,Ne oldu da birden soğuk davranmaya başladınız? Kalgara nerede?Dialogue: 50,0:10:34.49,0:10:37.87,Main-207-,,0,0,0,,Sizler hâlâ yabancısınız!Dialogue: 50,0:10:37.87,0:10:41.37,Main-207-,,0,0,0,,Kalgara, seni görmek istemediğini söylüyor.Dialogue: 50,0:10:41.37,0:10:42.29,Main-207-,,0,0,0,,Seto!Dialogue: 50,0:10:45.12,0:10:48.42,Main-207-,,0,0,0,,Ne zaman gideceksiniz acaba?Dialogue: 50,0:10:48.79,0:10:49.63,Main-207-,,0,0,0,,Ha?!Dialogue: 50,0:10:50.71,0:10:55.22,Main-207-,,0,0,0,,Aniden bizden nefret etmeye başlamış gibiler.Dialogue: 50,0:10:55.22,0:10:59.47,Main-207-,,0,0,0,,Hey, bekleyin?! Davranışlarınız hiç mantıklı değil!Dialogue: 50,0:10:59.47,0:11:00.47,Main-207-,,0,0,0,,Bu kadarı yeter.Dialogue: 50,0:11:02.68,0:11:05.64,Main-207-,,0,0,0,,İşimize bakalım.Dialogue: 50,0:11:06.35,0:11:09.06,Main-207-,,0,0,0,,Henüz ormanın araştırmadığımız bölümleri var.Dialogue: 50,0:11:12.11,0:11:14.15,Main-207-,,0,0,0,,İşte buradasın, Kalgara!Dialogue: 50,0:11:14.15,0:11:15.86,Main-207-,,0,0,0,,Noland seni arıyordu!Dialogue: 50,0:11:15.86,0:11:19.41,Main-207-,,0,0,0,,Evet, onun yüzünü görmek istemiyorum.Dialogue: 50,0:11:19.99,0:11:24.50,Main-207-,,0,0,0,,Yüzünü görürsem onu öldürebilirim!Dialogue: 50,0:11:30.88,0:11:33.38,Main-207-,,0,0,0,,Bugün çan çalmadı.Dialogue: 50,0:11:33.38,0:11:34.26,Main-207-,,0,0,0,,Evet.Dialogue: 50,0:11:34.26,0:11:38.22,Main-207-,,0,0,0,,Burada olduğumuz bir ay boyunca böyle bir şey hiç olmamıştı, değil mi?Dialogue: 50,0:11:38.89,0:11:40.30,Main-207-,,0,0,0,,Komodor...Dialogue: 50,0:11:40.30,0:11:43.47,Main-207-,,0,0,0,,İki gün içinde, tüm ormanı araştırmış olacağız.Dialogue: 50,0:11:43.47,0:11:44.93,Main-207-,,0,0,0,,E-Evet...Dialogue: 50,0:11:45.56,0:11:50.44,Main-207-,,0,0,0,,Tayfaya üç gün içinde tekrar yelken açacağımızı söyle,Dialogue: 50,0:11:50.44,0:11:54.15,Main-207-,,0,0,0,,o zamana kadar sağlam zeminin tadını çıkarsınlar.Dialogue: 50,0:11:54.74,0:11:59.11,Main-207-,,0,0,0,,Komodor, açıkçası burada daha fazla durmak hiç içime sinmiyor...Dialogue: 50,0:11:59.11,0:12:01.53,Main-207-,,0,0,0,,Başladığımız işi bitirmeliyiz!Dialogue: 50,0:12:01.53,0:12:02.53,Main-207-,,0,0,0,,Gidip uyu.Dialogue: 50,0:12:04.91,0:12:07.04,Flashbacks-207-,,0,0,0,,Burada yaşamalısın, Noland!Dialogue: 50,0:12:07.04,0:12:11.04,Flashbacks-207-,,0,0,0,,Sahi! Neden Mousse'u karın olarak almıyorsun?Dialogue: 50,0:12:11.04,0:12:12.21,Flashbacks-207-,,0,0,0,,Saçmalama!Dialogue: 50,0:12:12.21,0:12:15.42,Flashbacks-207-,,0,0,0,,Memlekette bir ailem, bir de onun yaşında bir çocuğum var.Dialogue: 50,0:12:15.42,0:12:16.55,Flashbacks-207-,,0,0,0,,Geri dönmem gerek.Dialogue: 50,0:12:16.92,0:12:20.39,Flashbacks-207-,,0,0,0,,Kalgara, seni görmek istemediğini söylüyor.Dialogue: 50,0:12:21.55,0:12:25.14,Flashbacks-207-,,0,0,0,,Ne zaman gideceksiniz acaba?Dialogue: 50,0:12:30.81,0:12:33.07,Main-207-,,0,0,0,,Burada olduğunu biliyorum, Kalgara!Dialogue: 50,0:12:33.07,0:12:34.57,Main-207-,,0,0,0,,Çık ortaya!Dialogue: 50,0:12:35.19,0:12:38.20,Main-207-,,0,0,0,,Bana bir açıklama borçlu değil misin sence?!Dialogue: 50,0:12:38.20,0:12:39.82,Main-207-,,0,0,0,,Göster kendini!Dialogue: 50,0:12:39.82,0:12:41.78,Main-207-,,0,0,0,,Sen anlatmazsan anlayamam!Dialogue: 50,0:12:42.41,0:12:45.04,Main-207-,,0,0,0,,Yakında yelken açacağız!Dialogue: 50,0:12:45.04,0:12:47.62,Main-207-,,0,0,0,,Bu şekilde ayrılmak istemiyorum!Dialogue: 50,0:13:00.76,0:13:04.18,Main-207-,,0,0,0,,Yüzünü bana gösterme!Dialogue: 50,0:13:04.18,0:13:07.47,Main-207-,,0,0,0,,Yoksa ölümün mü bizi ayırmasını tercih edersin?!Dialogue: 50,0:13:11.19,0:13:12.65,Main-207-,,0,0,0,,Kalgara!Dialogue: 50,0:13:16.73,0:13:19.61,Main-207-,,0,0,0,,Komodor yalnız görünüyor...Dialogue: 50,0:13:19.61,0:13:20.90,Main-207-,,0,0,0,,Evet.Dialogue: 50,0:13:20.90,0:13:26.12,Main-207-,,0,0,0,,Onca yoldan bu ücra adaya geldi ve harika bir arkadaş buldu.Dialogue: 50,0:13:27.79,0:13:30.16,Main-207-,,0,0,0,,Bunların hiçbiri mantıklı değil!Dialogue: 50,0:13:30.16,0:13:34.17,Main-207-,,0,0,0,,Yarın sabah ilk iş, yelken açacağız.Dialogue: 50,0:13:34.17,0:13:37.05,Main-207-,,0,0,0,,Köylüler o kadar aksi ki yanlarına yaklaşamıyoruz.Dialogue: 50,0:13:37.05,0:13:41.13,Main-207-,,0,0,0,,Ve çan, bugün de çalmadı.Dialogue: 50,0:13:43.89,0:13:46.93,Flashbacks-207-,,0,0,0,,Yüzünü bana gösterme!Dialogue: 50,0:13:46.93,0:13:49.89,Flashbacks-207-,,0,0,0,,Yoksa ölümün mü bizi ayırmasını tercih edersin?!Dialogue: 50,0:14:06.16,0:14:11.00,Main-207-,,0,0,0,,Ayrılmak için ne kadar üzücü bir yol.Dialogue: 50,0:14:11.00,0:14:11.96,Main-207-,,0,0,0,,Şey...Dialogue: 50,0:14:16.54,0:14:17.63,Main-207-,,0,0,0,,Doktor-san...Dialogue: 50,0:14:18.17,0:14:19.67,Main-207-,,0,0,0,,Mousse-chan?!Dialogue: 50,0:14:19.67,0:14:22.26,Main-207-,,0,0,0,,Bir dakikanız var mı?Dialogue: 50,0:14:26.93,0:14:30.22,Main-207-,,0,0,0,,Ne tür bir bitki bilimci bunu yapar?!Dialogue: 50,0:14:36.15,0:14:37.77,Main-207-,,0,0,0,,Noland!Dialogue: 50,0:14:38.19,0:14:42.15,Main-207-,,0,0,0,,Eğer bunlar sözde "gelişimin" kurbanlarıysa...Dialogue: 50,0:14:42.15,0:14:46.57,Main-207-,,0,0,0,,o zaman sizi asla kabul etmemeliydik!Dialogue: 50,0:14:49.91,0:14:51.29,Main-207-,,0,0,0,,Ataların ağaçları mı?Dialogue: 50,0:14:52.12,0:14:53.16,Main-207-,,0,0,0,,Evet.Dialogue: 50,0:14:54.33,0:14:58.63,Main-207-,,0,0,0,,Geçtiğimiz bir kaç asırda, bu adada ölen atalarımızın ruhlarının...Dialogue: 50,0:14:58.63,0:15:02.34,Main-207-,,0,0,0,,çanın sesiyle yönlendirilerek ağaçların içinde yaşadığı söylenir.Dialogue: 50,0:15:02.34,0:15:06.72,Main-207-,,0,0,0,,Shandora döneminden beri atalarımızın hepsi...Dialogue: 50,0:15:06.72,0:15:13.68,Main-207-,,0,0,0,,o kutsal beyaz ağaçlardan bizi gözetler.Dialogue: 50,0:15:20.15,0:15:24.03,Main-207-,,0,0,0,,Biz Shandialılar için atalarımızın ağaçları...Dialogue: 50,0:15:24.36,0:15:31.87,Main-207-,,0,0,0,,o kadar değerlidir ki onları kendi hayatlarımız gibi koruduk!Dialogue: 50,0:15:31.87,0:15:34.87,Main-207-,,0,0,0,,Biz de gidip onları kestik.Dialogue: 50,0:15:36.25,0:15:40.96,Main-207-,,0,0,0,,Savaşçılar o kadar öfkeliydi ki hemen silahlandılar...Dialogue: 50,0:15:40.96,0:15:43.09,Flashbacks-207-,,0,0,0,,Onları bu adadan süreceğiz!Dialogue: 50,0:15:43.09,0:15:44.42,Flashbacks-207-,,0,0,0,,– Evet! – Evet!Dialogue: 50,0:15:46.76,0:15:53.14,Main-207-,,0,0,0,,...ama hayatlarımızı kurtardığınız için size borçluyuz.Dialogue: 50,0:15:53.14,0:15:55.02,Main-207-,,0,0,0,,Anlıyorum.Dialogue: 50,0:15:56.10,0:15:59.10,Main-207-,,0,0,0,,Yani sadece öfkelerini bastırıyorlardı...Dialogue: 50,0:15:59.98,0:16:02.57,Main-207-,,0,0,0,,Ormandaki araştırmanızın bir parçası olsa bile,Dialogue: 50,0:16:03.32,0:16:04.78,Main-207-,,0,0,0,,bilmiyor olsanız bile...Dialogue: 50,0:16:05.49,0:16:09.11,Main-207-,,0,0,0,,köylülerin öfkesi dinmeyecek.Dialogue: 50,0:16:09.11,0:16:12.28,Main-207-,,0,0,0,,Bu yüzden bunu niye yaptığınızı...Dialogue: 50,0:16:14.50,0:16:16.71,Main-207-,,0,0,0,,bilmek istedim.Dialogue: 50,0:16:18.83,0:16:20.58,Secondary-207-,,0,0,0,,Hey! Biri yardım etsin!Dialogue: 50,0:16:20.58,0:16:21.96,Secondary-207-,,0,0,0,,Hepsini gemiye alın!Dialogue: 50,0:16:21.96,0:16:24.55,Secondary-207-,,0,0,0,,Düzgün bağladığınızdan emin olun!Dialogue: 50,0:16:19.96,0:16:23.17,Main-207-,,0,0,0,,Atalarının ruhlarının olduğu ağaçlar...Dialogue: 50,0:16:23.17,0:16:25.34,Main-207-,,0,0,0,,Hiç bilmiyordum.Dialogue: 50,0:16:25.34,0:16:28.18,Main-207-,,0,0,0,,Asla yapılmaması gereken bir şey yaptık.Dialogue: 50,0:16:28.55,0:16:31.01,Main-207-,,0,0,0,,Köylülerin kızmaya hakkı var.Dialogue: 50,0:16:31.01,0:16:32.14,Main-207-,,0,0,0,,Ama Komodor!Dialogue: 50,0:16:32.14,0:16:33.22,Main-207-,,0,0,0,,Başka seçeneğimiz yok–Dialogue: 50,0:16:33.22,0:16:35.14,Main-207-,,0,0,0,,Mazeret üretemeyiz!Dialogue: 50,0:16:35.89,0:16:38.98,Main-207-,,0,0,0,,Doğru olduğunu düşündüğüm şeyi yaptım...Dialogue: 50,0:16:39.56,0:16:41.69,Main-207-,,0,0,0,,Şehrin varlığıyla...Dialogue: 50,0:16:41.69,0:16:44.94,Main-207-,,0,0,0,,övünmelerinin yanı sıra...Dialogue: 50,0:16:44.94,0:16:49.20,Main-207-,,0,0,0,,çanın sesi, atalarının ruhlarını bu adaya yönlendiriyormuş.Dialogue: 50,0:16:49.82,0:16:54.62,Main-207-,,0,0,0,,O ruhları barındıran ağaçları kestik!Dialogue: 50,0:16:55.12,0:16:57.04,Main-207-,,0,0,0,,Bu affedilemez bir davranış!Dialogue: 50,0:16:57.62,0:17:00.08,Main-207-,,0,0,0,,Komodor...Dialogue: 50,0:17:02.46,0:17:04.42,Main-207-,,0,0,0,,Herkes dinlesin!Dialogue: 50,0:17:04.42,0:17:06.26,Main-207-,,0,0,0,,– Ha?! – Ha?!Dialogue: 50,0:17:06.26,0:17:09.22,Main-207-,,0,0,0,,– Altını bırakıyor muyuz?! – Altını bırakıyor muyuz?!Dialogue: 50,0:17:10.72,0:17:14.14,Main-207-,,0,0,0,,Noland ve tayfası yola çıkmaya hazırlanıyor.Dialogue: 50,0:17:24.61,0:17:27.23,Main-207-,,0,0,0,,Mousse! Neredeydin?!Dialogue: 50,0:17:29.78,0:17:30.74,Main-207-,,0,0,0,,Ya...Dialogue: 50,0:17:31.61,0:17:35.20,Main-207-,,0,0,0,,Ya tek bir değerli ağacın...Dialogue: 50,0:17:35.70,0:17:38.16,Main-207-,,0,0,0,,ölümcül bir zehirle mahvolduğunu...Dialogue: 50,0:17:38.91,0:17:42.83,Main-207-,,0,0,0,,ve bu zehrin eninde sonunda tüm ormana...Dialogue: 50,0:17:43.33,0:17:46.30,Main-207-,,0,0,0,,oradan da insanlara yayılarak tüm adayı...Dialogue: 50,0:17:46.30,0:17:49.05,Main-207-,,0,0,0,,öldüreceğini önceden bilseydik?Dialogue: 50,0:17:49.34,0:17:50.92,Main-207-,,0,0,0,,Ne demek istiyor?Dialogue: 50,0:17:50.92,0:17:52.38,Main-207-,,0,0,0,,Neden bahsediyorsun?!Dialogue: 50,0:17:52.38,0:17:54.05,Main-207-,,0,0,0,,Önceden bilseydik...Dialogue: 50,0:17:55.43,0:17:57.76,Main-207-,,0,0,0,,o kıymetli ağaca...Dialogue: 50,0:17:59.56,0:18:01.44,Main-207-,,0,0,0,,ne yapardık?!Dialogue: 50,0:18:03.56,0:18:06.82,Main-207-,,0,0,0,,Baba, lütfen git! Onları durdurmalısın!Dialogue: 50,0:18:06.82,0:18:09.69,Main-207-,,0,0,0,,Aptal olma! Ne yaptıklarını biliyorsun!Dialogue: 50,0:18:09.69,0:18:13.03,Main-207-,,0,0,0,,Böyle gimelerine izin verirsen ölene kadar pişman olacaksın.Dialogue: 50,0:18:13.03,0:18:15.99,Main-207-,,0,0,0,,Sonunda böyle değerli bir arkadaş edindin...Dialogue: 50,0:18:15.99,0:18:18.45,Main-207-,,0,0,0,,ve biz Shandialılar onlara çok şey borçluyuz!Dialogue: 50,0:18:18.45,0:18:20.91,Main-207-,,0,0,0,,Onları hayatları boyunca incitmiş olacağız!Dialogue: 50,0:18:21.41,0:18:23.12,Main-207-,,0,0,0,,Ne demek istiyorsun?!Dialogue: 50,0:18:23.75,0:18:25.79,Flashbacks-207-,,0,0,0,,Mazeret üretiyormuşuz gibi olacak...Dialogue: 50,0:18:26.38,0:18:30.21,Flashbacks-207-,,0,0,0,,ama Komodor'un onuru için anlatacağım.Dialogue: 50,0:18:30.21,0:18:33.47,Flashbacks-207-,,0,0,0,,Sözünü ettiğin orman çoktan ölmüştü.Dialogue: 50,0:18:33.47,0:18:34.47,Flashbacks-207-,,0,0,0,,Ha?!Dialogue: 50,0:18:35.09,0:18:37.93,Flashbacks-207-,,0,0,0,,Ağaç ateşi hastalığının korkunç tarafı...Dialogue: 50,0:18:38.56,0:18:42.39,Flashbacks-207-,,0,0,0,,bitkilere de bulaşmasıdır.Dialogue: 50,0:18:43.02,0:18:45.23,Flashbacks-207-,,0,0,0,,Komodor sizi ikna etmek için...Dialogue: 50,0:18:45.23,0:18:48.98,Flashbacks-207-,,0,0,0,,hayatını riske attı, çünkü korkunç gerçeği biliyordu.Dialogue: 50,0:18:50.36,0:18:53.15,Flashbacks-207-,,0,0,0,,İnsanlardan ormana, ormandan insanlara taşınır.Dialogue: 50,0:18:53.15,0:18:58.41,Flashbacks-207-,,0,0,0,,Küçük adaları tamamen yok etmiş olan birçok örneği var.Dialogue: 50,0:19:00.41,0:19:02.79,Flashbacks-207-,,0,0,0,,Ama artık endişelenmenize gerek yok.Dialogue: 50,0:19:02.79,0:19:06.71,Flashbacks-207-,,0,0,0,,Tüm ormanı kontrol etme işini bitirdik.Dialogue: 50,0:19:06.71,0:19:09.88,Flashbacks-207-,,0,0,0,,O ağaçların değerli olduklarını bilmiyorduk,Dialogue: 50,0:19:09.88,0:19:11.96,Flashbacks-207-,,0,0,0,,açıklamadık bile, üzgünüm.Dialogue: 50,0:19:12.46,0:19:16.09,Flashbacks-207-,,0,0,0,,Açıklama yapsak bile affedilmeyebiliriz.Dialogue: 50,0:19:16.09,0:19:20.47,Flashbacks-207-,,0,0,0,,Bir bitki bilimci sebebsiz yere ormana asla zarar vermez.Dialogue: 50,0:19:20.93,0:19:24.69,Flashbacks-207-,,0,0,0,,Komodor tanrılardan veya ruhlardan nefret etmiyor.Dialogue: 50,0:19:28.90,0:19:31.86,Flashbacks-207-,,0,0,0,,Sadece her zaman en önemli şeyin...Dialogue: 50,0:19:31.86,0:19:33.61,Flashbacks-207-,,0,0,0,,ne olduğunu biliyor.Dialogue: 50,0:19:34.82,0:19:38.87,Main-207-,,0,0,0,,Yani bunu... bizi korumak için mi yaptılar?Dialogue: 50,0:19:43.95,0:19:44.96,Main-207-,,0,0,0,,Baba!Dialogue: 50,0:19:47.62,0:19:49.42,Thoughts-207-,,0,0,0,,Üzgünüm, Noland!Dialogue: 50,0:19:50.04,0:19:52.17,Thoughts-207-,,0,0,0,,Gitmemiş ol!Dialogue: 50,0:19:53.05,0:19:54.88,Main-207-,,0,0,0,,Her şey tamam mı?Dialogue: 50,0:19:55.76,0:19:57.34,Main-207-,,0,0,0,,Bir şey hariç...Dialogue: 50,0:19:57.34,0:19:59.34,Main-207-,,0,0,0,,Sızlanmayı kes! Unut gitsin!Dialogue: 50,0:19:59.85,0:20:01.43,Main-207-,,0,0,0,,Tamam, yola çıkalım!Dialogue: 50,0:20:01.43,0:20:02.89,Main-207-,,0,0,0,,Herkes işinin başına!Dialogue: 50,0:20:02.89,0:20:05.81,Main-207-,,0,0,0,,Lvneel Krallığı'na doğru yelken açıyoruz!Dialogue: 50,0:20:05.81,0:20:08.15,Main-207-,,0,0,0,,– Başüstüne! – Başüstüne!Dialogue: 50,0:20:08.15,0:20:10.61,Thoughts-207-,,0,0,0,,Noland!Dialogue: 50,0:20:11.31,0:20:13.98,Thoughts-207-,,0,0,0,,Büyük bir günah işledim!Dialogue: 50,0:20:13.98,0:20:17.57,Thoughts-207-,,0,0,0,,Bekle! Noland!Dialogue: 50,0:20:19.53,0:20:22.24,Main-207-,,0,0,0,,Yelkenler fora!Dialogue: 50,0:20:30.21,0:20:31.50,Main-207-,,0,0,0,,Çan...Dialogue: 50,0:20:32.34,0:20:33.92,Main-207-,,0,0,0,,neden çalıyor?Dialogue: 50,0:20:34.84,0:20:36.80,Main-207-,,0,0,0,,Çalın!Dialogue: 50,0:20:37.13,0:20:39.59,Thoughts-207-,,0,0,0,,Üzgünüz, Noland-san!Dialogue: 50,0:20:39.59,0:20:41.14,Main-207-,,0,0,0,,Daha güçlü çalın!Dialogue: 50,0:20:41.14,0:20:43.14,Main-207-,,0,0,0,,Noland ve tayfası bunu duymalı!Dialogue: 50,0:20:46.22,0:20:47.56,Main-207-,,0,0,0,,Komodor! Bakın!Dialogue: 50,0:20:57.36,0:21:01.03,Main-207-,,0,0,0,,Noland!Dialogue: 50,0:21:01.45,0:21:03.24,Main-207-,,0,0,0,,Kalgara...Dialogue: 50,0:21:17.84,0:21:22.93,Main-207-,,0,0,0,,Tekrar gel!Dialogue: 50,0:21:24.05,0:21:25.89,Main-207-,,0,0,0,,Noland...Dialogue: 50,0:21:25.89,0:21:29.35,Main-207-,,0,0,0,,Seni burada bekliyor olacağım!Dialogue: 50,0:21:30.52,0:21:33.56,Main-207-,,0,0,0,,Senin için çanı çalmaya devam edeceğiz!Dialogue: 50,0:21:33.98,0:21:38.99,Main-207-,,0,0,0,,Böylece geri döndüğünüzde denizde kaybolmayacaksınız.Dialogue: 50,0:21:38.99,0:21:42.99,Main-207-,,0,0,0,,Fırtınada bile yolunuzu bulacaksınız.Dialogue: 50,0:21:42.99,0:21:47.33,Main-207-,,0,0,0,,Sizi beklerken çanı çalacağız!Dialogue: 50,0:21:56.63,0:22:02.76,Main-207-,,0,0,0,,Bir gün mutlaka tekrar buluşalım... değerli dostum!Dialogue: 50,0:22:05.22,0:22:06.51,Main-207-,,0,0,0,,Öyleyse...Dialogue: 50,0:22:07.22,0:22:09.72,Main-207-,,0,0,0,,tekrar gelebilir miyim?Dialogue: 50,0:22:12.94,0:22:15.52,Main-207-,,0,0,0,,Geleceğim! Kesinlikle...Dialogue: 50,0:22:15.52,0:22:17.07,Main-207-,,0,0,0,,geleceğim!Dialogue: 50,0:22:20.86,0:22:25.66,Main-207-,,0,0,0,,Bir gün mutlaka tekrar buluşalım!Dialogue: 0,0:02:39.43,0:02:43.69,Title-207-,,0,0,0,,Shandora'nın IşığıDialogue: 1,0:02:39.43,0:02:43.69,Title-207-,,0,0,0,,Shandora'nın IşığıDialogue: 1,0:09:25.96,0:09:30.42,Captions-207-,,0,0,0,,Karaya Ayak Bastıktan 1 Ay SonraDialogue: 1,0:09:25.96,0:09:30.42,Captions-207-,,0,0,0,,Karaya Ayak Bastıktan 1 Ay SonraDialogue: 0,0:09:25.96,0:09:30.42,Captions-207-,,0,0,0,,Karaya Ayak Bastıktan 1 Ay SonraDialogue: 0,0:00:46.23,0:00:50.41,Credits-207-,,0,0,0,,