2,180,180,27,1Style: RogerMonologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1Style: Karaoke,Duality,68,&H00292CC7,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,4,0,1,6.8,0,8,23,23,23,1Style: Translation,Duality,68,&H00292CC7,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,4,0,1,6.8,0,2,23,23,34,1Style: Ending Romaji,Josefin Sans,75,&H00FFFFFF,&H005455BE,&HıF5455BE,&HC7000000,0,0,0,0,100,100,0,0,1,0,3,8,135,23,35,1Style: Ending Romaji Luffy,Josefin Sans,75,&H00FFFFFF,&H0039A6DD,&HıF39A6DD,&HC7000000,0,0,0,0,100,100,0,0,1,0,3,7,55,23,35,1Style: Ending Romaji Zoro,Josefin Sans,75,&H00FFFFFF,&H00278853,&H00278853,&HBB000000,0,0,0,0,100,100,0,0,1,0,3,9,0,55,35,1Style: Ending Romaji Ussop,Josefin Sans,75,&H00FFFFFF,&H00328190,&H00328190,&HCF000000,0,0,0,0,100,100,0,0,1,0,3,9,10,55,35,1Style: Ending Romaji Sanji,Josefin Sans,75,&H00FFFFFF,&H004BB9C3,&H004BB9C3,&HB0000000,0,0,0,0,100,100,0,0,1,0,3,7,55,10,35,1Style: Ending Translation,Josefin Sans,75,&H00FFFFFF,&H005455BE,&HıF5455BE,&HC7000000,0,0,0,0,100,100,0,0,1,0,3,2,135,23,35,1Style: Ending Translation Luffy,Josefin Sans,75,&H00FFFFFF,&H0039A6DD,&HıF39A6DD,&HC7000000,0,0,0,0,100,100,0,0,1,0,2,1,55,23,35,1Style: Ending Translation Zoro,Josefin Sans,75,&H00FFFFFF,&H00278853,&H00278853,&HBB000000,0,0,0,0,100,100,0,0,1,0,3,3,0,55,35,1Style: Ending Translation Ussop,Josefin Sans,75,&H00FFFFFF,&H00328190,&H00328190,&HCF000000,0,0,0,0,100,100,0,0,1,0,3,3,10,55,35,1Style: Ending Translation Sanji,Josefin Sans,75,&H00FFFFFF,&H004BB9C3,&H004BB9C3,&HB0000000,0,0,0,0,100,100,0,0,1,0,3,1,55,10,35,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:49.92,0:01:59.92,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 55,0:01:54.22,0:01:56.55,Main-207-,,0,0,0,,Luffy!Dialogue: 55,0:01:56.55,0:01:58.56,Main-207-,,0,0,0,,Luffy! Luffy! Luffy! Luffy!Dialogue: 55,0:01:58.56,0:01:59.35,Main-207-,,0,0,0,,Luffy! Luffy!Dialogue: 55,0:01:59.35,0:02:02.19,Main-207-,,0,0,0,,Luffy!Dialogue: 55,0:02:05.98,0:02:07.57,Main-207-,,0,0,0,,Ah, ah, ah...Dialogue: 55,0:02:08.65,0:02:10.78,Main-207-,,0,0,0,,Felaket! Nami’yi bir dinozor yedi!Dialogue: 55,0:02:10.78,0:02:13.78,Main-207-,,0,0,0,,Cidden mi?!Dialogue: 55,0:02:12.49,0:02:14.66,Main-207-,,0,0,0,,Bir dinozordan kaçmak için...Dialogue: 55,0:02:14.66,0:02:18.70,Main-207-,,0,0,0,,ormana doğru birlikte koştuğumuz sırada aniden kayboldu!!Dialogue: 55,0:02:19.62,0:02:20.83,Main-207-,,0,0,0,,Ben ne yaptım?!Dialogue: 55,0:02:20.83,0:02:23.46,Main-207-,,0,0,0,,Arkadaşımın ölmesine izin verdim!Dialogue: 55,0:02:24.27,0:02:26.21,Main-207-,,0,0,0,,D-Durun biraz!Dialogue: 55,0:02:26.21,0:02:28.67,Main-207-,,0,0,0,,İkiniz de sakin olun!Dialogue: 55,0:02:29.13,0:02:30.25,Main-207-,,0,0,0,,– Ha? – Ha?Dialogue: 55,0:02:30.25,0:02:35.30,Main-207-,,0,0,0,,Aniden yok oldu dedin, yani ona ne olduğunu görmedin değil mi?Dialogue: 55,0:02:35.76,0:02:36.97,Main-207-,,0,0,0,,Kafayı mı yedin?!Dialogue: 55,0:02:36.97,0:02:39.18,Main-207-,,0,0,0,,O kadar korktum ki gidip bakamadım bile!Dialogue: 55,0:02:39.18,0:02:41.10,Main-207-,,0,0,0,,Ya dinozor ya da canavardı!Dialogue: 55,0:02:41.10,0:02:42.81,Main-207-,,0,0,0,,Başka ne olabilir?!Dialogue: 55,0:02:42.81,0:02:44.94,Main-207-,,0,0,0,,Bilemiyorum.Dialogue: 55,0:02:44.94,0:02:49.32,Main-207-,,0,0,0,,Ama Baroque Works bizi bu adaya kadar takip etmiş olabilir.Dialogue: 55,0:02:49.32,0:02:53.78,Main-207-,,0,0,0,,Sana kıyasla Nami-san'ın hedef alınması gayet doğal.Dialogue: 55,0:02:53.78,0:02:55.15,Main-207-,,0,0,0,,Ne?!Dialogue: 55,0:02:55.15,0:02:58.28,Main-207-,,0,0,0,,Baroque Works bu adada mı?!Dialogue: 55,0:02:59.28,0:03:00.41,Main-207-,,0,0,0,,Bekle...Dialogue: 55,0:03:01.29,0:03:03.45,Main-207-,,0,0,0,,Niye ben hedef alınmıyorum ki?Dialogue: 55,0:03:03.83,0:03:08.38,Main-207-,,0,0,0,,Büyük ihtimalle Baroque Works'ün ölüm listesinde olmadığın için.Dialogue: 55,0:03:08.38,0:03:09.42,Main-207-,,0,0,0,,Anladım!Dialogue: 55,0:03:09.96,0:03:14.70,Main-207-,,0,0,0,,O içki de bizim için hazırlanmış olabilir.Dialogue: 55,0:03:15.38,0:03:16.38,Main-207-,,0,0,0,,İçki mi?!Dialogue: 55,0:03:16.38,0:03:18.51,Main-207-,,0,0,0,,Ne içkisi?!Dialogue: 55,0:03:18.51,0:03:21.85,Main-207-,,0,0,0,,Brogy içkisini Dorry'ye verdi.Dialogue: 55,0:03:21.85,0:03:26.98,Main-207-,,0,0,0,,Dorry de içkiyi yudumladı, ardından içki midesinde patladı.Dialogue: 55,0:03:26.98,0:03:29.86,Main-207-,,0,0,0,,Ne?! İçkimiz midesinde mi patladı?!Dialogue: 55,0:03:30.61,0:03:33.99,Main-207-,,0,0,0,,O hâliyle düelloya mı gitti?!Dialogue: 55,0:03:33.99,0:03:37.07,Main-207-,,0,0,0,,Onu durdurmaya çalıştım ama hâlimi görüyorsun.Dialogue: 55,0:03:39.49,0:03:41.33,Main-207-,,0,0,0,,Ciddi olamazsın!Dialogue: 55,0:03:41.33,0:03:47.75,Main-207-,,0,0,0,,Eşit şartlarda, var güçleriyle 100 yıldır dövüşüyorlar!Dialogue: 55,0:03:52.38,0:03:56.34,Main-207-,,0,0,0,,Bu, dünyanın gördüğü en asil dövüş olsa gerek!Dialogue: 55,0:03:56.34,0:03:56.92,Main-207-,,0,0,0,,Evet.Dialogue: 55,0:03:56.92,0:04:00.01,Main-207-,,0,0,0,,Düello böyle bitmemeli!Dialogue: 55,0:04:02.22,0:04:04.27,Main-207-,,0,0,0,,Sorun nedir?!Dialogue: 55,0:04:16.19,0:04:17.86,Main-207-,,0,0,0,,Hâlâ dövüşüyorlar.Dialogue: 55,0:04:18.91,0:04:22.99,Main-207-,,0,0,0,,Evet. Mavi Dev Dorry epey inatçı biri.Dialogue: 55,0:04:24.87,0:04:27.62,Main-207-,,0,0,0,,Belki de bir el atmalıyım.Dialogue: 55,0:04:38.97,0:04:41.18,Thoughts-207-,,0,0,0,,Tam bir asır sürdü.Dialogue: 55,0:04:45.77,0:04:49.69,Thoughts-207-,,0,0,0,,Gerçekten uzun bir dövüştü!Dialogue: 55,0:05:29.14,0:05:31.14,Flashbacks-207-,,0,0,0,,İlahi adalet cezamı kesti.Dialogue: 55,0:05:31.14,0:05:33.98,Flashbacks-207-,,0,0,0,,Savaş tanrısı Elbaf, kaderime hükmetti.Dialogue: 55,0:05:33.98,0:05:36.48,Flashbacks-207-,,0,0,0,,Onun ilahi korumasını yitirdim.Dialogue: 55,0:05:36.48,0:05:38.40,Flashbacks-207-,,0,0,0,,Hepsi bu.Dialogue: 55,0:05:46.12,0:05:46.95,Main-207-,,0,0,0,,Luffy!Dialogue: 55,0:05:46.95,0:05:48.04,Main-207-,,0,0,0,,Luffy-san?!Dialogue: 55,0:05:48.41,0:05:51.62,Main-207-,,0,0,0,,Kimdi o?!Dialogue: 55,0:05:51.62,0:06:02.55,Main-207-,,0,0,0,,Çık ortaya!Dialogue: 55,0:06:03.63,0:06:04.68,Main-207-,,0,0,0,,Ha?Dialogue: 55,0:06:05.55,0:06:08.35,Main-207-,,0,0,0,,Bay 3, sanırım bir şey duydum.Dialogue: 55,0:06:10.68,0:06:12.27,Main-207-,,0,0,0,,Çok zevkli!Dialogue: 55,0:06:12.27,0:06:14.98,Main-207-,,0,0,0,,Belki de ormandaki acınası bir eziğin ağlayışıydı!Dialogue: 55,0:06:20.94,0:06:24.32,Main-207-,,0,0,0,,Yetmiş üç... bin...Dialogue: 55,0:06:26.03,0:06:30.20,Main-207-,,0,0,0,,dört yüz... altmış yedi düello.Dialogue: 55,0:06:32.25,0:06:38.21,Main-207-,,0,0,0,,Yetmiş üç... bin... dört yüz altmış altı beraberlik...Dialogue: 55,0:06:41.05,0:06:42.72,Main-207-,,0,0,0,,ve bir galibiyet!Dialogue: 55,0:06:58.65,0:07:00.82,Main-207-,,0,0,0,,Gözyaşların zafer sevincinden mi?Dialogue: 55,0:07:00.82,0:07:02.99,Main-207-,,0,0,0,,Cahillik mutluluktur.Dialogue: 55,0:07:03.82,0:07:07.11,Main-207-,,0,0,0,,Yine de tebrik etmek yerinde olur.Dialogue: 55,0:07:07.11,0:07:09.08,Main-207-,,0,0,0,,Sevinç gözyaşları mı?!Dialogue: 55,0:07:09.08,0:07:11.45,Main-207-,,0,0,0,,Sen ne anlarsın ki?!Dialogue: 55,0:07:11.45,0:07:12.87,Main-207-,,0,0,0,,Kimsin lan sen?!Dialogue: 55,0:07:13.20,0:07:14.71,Main-207-,,0,0,0,,Bay 3.Dialogue: 55,0:07:14.71,0:07:19.38,Main-207-,,0,0,0,,Kod adımı kullandığım için üzgünüm. Ben yalnızca bir heykeltıraşım.Dialogue: 55,0:07:19.38,0:07:25.34,Main-207-,,0,0,0,,Bu da yardımcım, realizm akımının ressamı Bayan Golden Week.Dialogue: 55,0:07:25.76,0:07:29.80,Main-207-,,0,0,0,,Dahası, seni çoktan yakaladım.Dialogue: 55,0:07:31.56,0:07:33.98,Main-207-,,0,0,0,,B-Bu da ne?!Dialogue: 55,0:07:40.77,0:07:42.11,Main-207-,,0,0,0,,Tamam, Luffy!Dialogue: 55,0:07:42.11,0:07:45.49,Main-207-,,0,0,0,,Kim olduklarını bilmiyorum ama onları kendim haklayacağım!Dialogue: 55,0:07:46.40,0:07:47.49,Main-207-,,0,0,0,,Ben de geliyorum!Dialogue: 55,0:07:47.49,0:07:50.78,Main-207-,,0,0,0,,Peki! Madem ısrar ediyorsun! Desteğe hayır demem!Dialogue: 55,0:07:50.78,0:07:52.37,Main-207-,,0,0,0,,Buna gerek yok!Dialogue: 55,0:07:55.37,0:07:56.83,Main-207-,,0,0,0,,Demek sizdiniz!Dialogue: 55,0:08:04.17,0:08:06.17,Main-207-,,0,0,0,,Onu geri alabilirsin.Dialogue: 55,0:08:06.17,0:08:07.17,Main-207-,,0,0,0,,İhtiyacımız kalmadı.Dialogue: 55,0:08:09.64,0:08:10.47,Main-207-,,0,0,0,,Karoo!Dialogue: 55,0:08:10.47,0:08:12.60,Main-207-,,0,0,0,,Ulan...!Dialogue: 55,0:08:12.60,0:08:14.27,Main-207-,,0,0,0,,Hey. Onlar da kim?Dialogue: 55,0:08:14.27,0:08:15.98,Main-207-,,0,0,0,,Son uğradığımız kasabadaydılar!Dialogue: 55,0:08:16.48,0:08:18.10,Main-207-,,0,0,0,,Ne yapıyorsunuz siz?!Dialogue: 55,0:08:18.10,0:08:19.98,Main-207-,,0,0,0,,Karoo'nun bununla bir ilgisi yok!Dialogue: 55,0:08:20.48,0:08:23.86,Main-207-,,0,0,0,,Haklısın. O kuşun bununla kesinlikle bir ilgisi yok.Dialogue: 55,0:08:23.86,0:08:28.90,Main-207-,,0,0,0,,Ama o hasır şapkalı adamın ciddi bir tehdit olabileceğini düşündük.Dialogue: 55,0:08:29.82,0:08:36.62,Main-207-,,0,0,0,,Planımız, kuşu bağırtıp seni ondan uzaklaştırmaktı...Dialogue: 55,0:08:36.62,0:08:39.08,Main-207-,,0,0,0,,ama o epey inatçı bir ördek çıktı.Dialogue: 55,0:08:39.92,0:08:42.67,Flashbacks-207-,,0,0,0,,Şimdi! Sahibini çağır!Dialogue: 55,0:08:44.13,0:08:47.09,Flashbacks-207-,,0,0,0,,Güçlü vakla ki özgür kalabilesin!Dialogue: 55,0:08:51.09,0:08:53.55,Flashbacks-207-,,0,0,0,,Çok yazık! Zorla biz vaklatacağız!Dialogue: 55,0:08:54.43,0:08:56.22,Flashbacks-207-,,0,0,0,,Prensesi çağır.Dialogue: 55,0:08:59.89,0:09:01.73,Flashbacks-207-,,0,0,0,,Onu...Dialogue: 55,0:09:01.73,0:09:03.98,Flashbacks-207-,,0,0,0,,hemen çağırsan iyi olur!Dialogue: 55,0:09:07.32,0:09:09.49,Flashbacks-207-,,0,0,0,,Aç gaganı, lanet olası kuş!Dialogue: 55,0:09:11.16,0:09:16.49,Main-207-,,0,0,0,,Ama görünen o ki Hasır Şapka çoktan saf dışı kalmış.Dialogue: 55,0:09:16.49,0:09:18.70,Main-207-,,0,0,0,,Bu yüzden artık kuşa ihtiyacımız yok.Dialogue: 55,0:09:19.21,0:09:20.46,Main-207-,,0,0,0,,Karoo...Dialogue: 55,0:09:26.25,0:09:27.34,Main-207-,,0,0,0,,Ne aptal bir kuş!Dialogue: 55,0:09:29.63,0:09:31.84,Main-207-,,0,0,0,,Adiler...!Dialogue: 55,0:09:31.84,0:09:35.18,Main-207-,,0,0,0,,Patlayan içki sizin işiniz miydi?!Dialogue: 55,0:09:36.18,0:09:39.06,Main-207-,,0,0,0,,Ah, evet. Sen de kimsin?Dialogue: 55,0:09:39.06,0:09:40.06,Main-207-,,0,0,0,,Listede miydi?Dialogue: 55,0:09:40.06,0:09:43.52,Main-207-,,0,0,0,,Hayır ama belli ki onlardan biri. Onu da yok edelim.Dialogue: 55,0:09:43.52,0:09:46.40,Main-207-,,0,0,0,,Demek devlerin düellosunu sabote eden sizdiniz.Dialogue: 55,0:09:46.77,0:09:48.44,Main-207-,,0,0,0,,Onlar mı yapmış?!Dialogue: 55,0:09:48.44,0:09:49.90,Main-207-,,0,0,0,,Canlarına okuyacağım!Dialogue: 55,0:09:50.40,0:09:52.36,Main-207-,,0,0,0,,Yok edilecek olanlar sizlersiniz!Dialogue: 55,0:09:53.70,0:09:57.37,Main-207-,,0,0,0,,Oh? Bizi kendin mi karşılayacaksın, Bayan Wednesday?Dialogue: 55,0:09:58.83,0:10:02.41,Main-207-,,0,0,0,,İki rütbeli ajana karşı şansın olduğunu mu düşünüyorsun?Dialogue: 55,0:10:02.41,0:10:04.42,Main-207-,,0,0,0,,Tavus Kesici!Dialogue: 55,0:10:04.42,0:10:05.17,Main-207-,,0,0,0,,Alın bunu!Dialogue: 55,0:10:05.17,0:10:07.25,Main-207-,,0,0,0,,Ölümcül Patlayan Yıldız!Dialogue: 55,0:10:10.55,0:10:11.38,Main-207-,,0,0,0,,Tam isabet!Dialogue: 55,0:10:14.80,0:10:15.93,Main-207-,,0,0,0,,İyi patlamaydı!Dialogue: 55,0:10:16.80,0:10:18.51,Main-207-,,0,0,0,,Süslü Sümük Topu!Dialogue: 55,0:10:24.44,0:10:25.44,Main-207-,,0,0,0,,Zavallı şey!Dialogue: 55,0:10:25.44,0:10:27.02,Main-207-,,0,0,0,,Usopp!Dialogue: 55,0:10:27.44,0:10:28.98,Main-207-,,0,0,0,,10.000 Kiloluk Baskı!Dialogue: 55,0:10:33.57,0:10:35.49,Main-207-,,0,0,0,,Kes şunu artık!Dialogue: 55,0:10:42.16,0:10:43.79,Main-207-,,0,0,0,,Niye bu kadar tedirginsin?Dialogue: 55,0:10:43.79,0:10:46.75,Main-207-,,0,0,0,,Seni henüz öldürmeyeceğiz.Dialogue: 55,0:10:50.75,0:10:53.09,Main-207-,,0,0,0,,Şimdilik canlı lazımsın.Dialogue: 55,0:10:53.09,0:10:55.59,Main-207-,,0,0,0,,Bay 3'ün emirleri doğrultusunda.Dialogue: 55,0:10:58.10,0:10:59.76,Main-207-,,0,0,0,,Bay 3 mü?Dialogue: 55,0:10:59.76,0:11:01.52,Main-207-,,0,0,0,,Mum gücüne sahip adam mı?!Dialogue: 55,0:11:01.52,0:11:03.18,Main-207-,,0,0,0,,Bu adada mı?!Dialogue: 55,0:11:03.18,0:11:05.06,Main-207-,,0,0,0,,Aynen öyle.Dialogue: 55,0:11:05.06,0:11:10.69,Main-207-,,0,0,0,,Bedeninden mum salgılayıp onu kontrol eden bir adam o!Dialogue: 55,0:11:14.82,0:11:16.16,Main-207-,,0,0,0,,Seni alçak!Dialogue: 55,0:11:16.16,0:11:17.57,Main-207-,,0,0,0,,Bu da ne?Dialogue: 55,0:11:19.37,0:11:21.20,Main-207-,,0,0,0,,Görmüyor musun?Dialogue: 55,0:11:21.20,0:11:24.37,Main-207-,,0,0,0,,İşte bu yüzden cahil dangalaklara katlanamıyorum.Dialogue: 55,0:11:24.37,0:11:28.58,Main-207-,,0,0,0,,Elbette ki bir sanat eseri ortaya koyuyorum.Dialogue: 55,0:11:34.01,0:11:36.26,Main-207-,,0,0,0,,Uslu bir kız ol artık.Dialogue: 55,0:11:36.26,0:11:41.47,Main-207-,,0,0,0,,Gerçekten Baroque Works'tan kaçabileceğine inandın mı?Dialogue: 55,0:11:48.90,0:11:52.52,Main-207-,,0,0,0,,30 milyonluk kellesi olan o adam bile  bizim dengimiz değil.Dialogue: 55,0:11:53.98,0:11:56.99,Main-207-,,0,0,0,,Whisky Peak'te yaptığının acısını nihayet senden çıkardım!Dialogue: 55,0:11:57.36,0:11:59.49,Main-207-,,0,0,0,,Kendinizi korsan sanan sizler,Dialogue: 55,0:11:59.49,0:12:03.12,Main-207-,,0,0,0,,bu işe burnunuzu sokarak kendi sonunuzu getirdiniz.Dialogue: 55,0:12:03.12,0:12:08.42,Main-207-,,0,0,0,,Kılıç ustası arkadaşını ve diğer kızı zaten yakaladık.Dialogue: 55,0:12:09.33,0:12:11.00,Main-207-,,0,0,0,,Zoro'yu yakaladınız mı?Dialogue: 55,0:12:11.00,0:12:11.88,Main-207-,,0,0,0,,Ha?Dialogue: 55,0:12:11.88,0:12:14.63,Main-207-,,0,0,0,,Öyleyse hapı yutmuşsunuz.Dialogue: 55,0:12:14.63,0:12:15.88,Main-207-,,0,0,0,,Oh?Dialogue: 55,0:12:15.88,0:12:17.88,Main-207-,,0,0,0,,Tatminkâr Bombamı...Dialogue: 55,0:12:17.88,0:12:20.80,Main-207-,,0,0,0,,yüzüne yemene rağmen hâlâ konuşabiliyorsun.Dialogue: 55,0:12:20.80,0:12:23.18,Main-207-,,0,0,0,,Biraz bile acıtmadı!Dialogue: 55,0:12:23.18,0:12:25.60,Main-207-,,0,0,0,,Seni mahvedeceğim!Dialogue: 55,0:12:29.73,0:12:30.81,Main-207-,,0,0,0,,Zavallı şey.Dialogue: 55,0:12:34.15,0:12:35.40,Main-207-,,0,0,0,,Luffy-san!Dialogue: 55,0:12:38.57,0:12:39.66,Main-207-,,0,0,0,,Geber!Dialogue: 55,0:12:52.71,0:12:53.42,Main-207-,,0,0,0,,Aptal!Dialogue: 55,0:12:53.42,0:12:55.05,Secondary-207-,,0,0,0,,Luffy-san!Dialogue: 55,0:12:55.05,0:12:57.72,Main-207-,,0,0,0,,Luffy-san! Luffy-san!Dialogue: 55,0:12:57.72,0:12:59.30,Main-207-,,0,0,0,,Gidelim, Bayan Valentine!Dialogue: 55,0:12:59.30,0:13:00.51,Main-207-,,0,0,0,,Luffy-san!Dialogue: 55,0:13:01.39,0:13:03.47,Main-207-,,0,0,0,,Usopp-san! Karoo!Dialogue: 55,0:13:24.74,0:13:25.58,Main-207-,,0,0,0,,Seni ifrit!Dialogue: 55,0:13:25.99,0:13:28.50,Main-207-,,0,0,0,,Pes et gitsin!Dialogue: 55,0:13:28.50,0:13:34.29,Main-207-,,0,0,0,,Mum örtüm katılaşınca çelikten farksız olur!Dialogue: 55,0:13:35.92,0:13:38.21,Main-207-,,0,0,0,,Devlerin sınırsız gücü...Dialogue: 55,0:13:38.21,0:13:42.43,Main-207-,,0,0,0,,zaptedildiğinde hiçbir şey ifade etmez.Dialogue: 55,0:13:42.43,0:13:44.76,Main-207-,,0,0,0,,Eninde sonunda akıl üstün gelir.Dialogue: 55,0:13:44.76,0:13:47.60,Main-207-,,0,0,0,,Gereksiz yere yüz yüze gelmekten kaçınırım.Dialogue: 55,0:13:48.47,0:13:51.35,Main-207-,,0,0,0,,Zaferin tadına varınca gardını düşürdün,Dialogue: 55,0:13:51.35,0:13:53.23,Main-207-,,0,0,0,,Kızıl Dev Brogy.Dialogue: 55,0:13:55.61,0:13:57.44,Main-207-,,0,0,0,,Bana öyle bakma.Dialogue: 55,0:13:57.44,0:13:59.53,Main-207-,,0,0,0,,Korkudan dilim tutuldu!Dialogue: 55,0:14:00.74,0:14:02.91,Main-207-,,0,0,0,,Mutlu olmalısın!Dialogue: 55,0:14:02.91,0:14:06.74,Main-207-,,0,0,0,,Düellon sonunda sonuca erdi.Dialogue: 55,0:14:06.74,0:14:11.08,Main-207-,,0,0,0,,Bir asır boyunca şerefin için savaşmadın mı?Dialogue: 55,0:14:11.08,0:14:14.92,Main-207-,,0,0,0,,Bu durumda zaferin tadı muhteşem olmaz mı?Dialogue: 55,0:14:14.92,0:14:18.96,Main-207-,,0,0,0,,Bu kez dışarıdan bir yardım gelmiş olsa bile?Dialogue: 55,0:14:19.92,0:14:21.26,Main-207-,,0,0,0,,Yanılıyor muyum?Dialogue: 55,0:14:21.26,0:14:22.84,Main-207-,,0,0,0,,Seni köpek!Dialogue: 55,0:14:22.84,0:14:23.97,Main-207-,,0,0,0,,Yoksa?!Dialogue: 55,0:14:27.51,0:14:29.10,Main-207-,,0,0,0,,Ama sonunda...Dialogue: 55,0:14:29.10,0:14:31.23,Main-207-,,0,0,0,,gerçek galip benim!Dialogue: 55,0:14:31.23,0:14:36.48,Main-207-,,0,0,0,,Uzun zaman önce kafanıza konan ödülün,Dialogue: 55,0:14:36.48,0:14:38.23,Main-207-,,0,0,0,,o büyük miktardaki paranın...Dialogue: 55,0:14:38.23,0:14:40.69,Main-207-,,0,0,0,,hâlâ geçerli olduğunu biliyor muydun?Dialogue: 55,0:14:41.69,0:14:42.90,Main-207-,,0,0,0,,Seni şeytan!Dialogue: 55,0:14:42.90,0:14:46.87,Main-207-,,0,0,0,,Gömülü bir hazine keşfetmiş gibiyim.Dialogue: 55,0:14:47.99,0:14:49.91,Main-207-,,0,0,0,,Demek bunun peşindesin ha?!Dialogue: 55,0:14:49.91,0:14:50.49,Main-207-,,0,0,0,,Hım?Dialogue: 55,0:14:50.49,0:14:52.00,Main-207-,,0,0,0,,Bay 3!Dialogue: 55,0:14:52.79,0:14:54.00,Main-207-,,0,0,0,,Onu getirdik.Dialogue: 55,0:14:54.92,0:14:56.79,Main-207-,,0,0,0,,Örgütümüzün haini.Dialogue: 55,0:14:56.79,0:14:57.96,Main-207-,,0,0,0,,Çok yavaşsınız.Dialogue: 55,0:14:57.96,0:14:59.50,Main-207-,,0,0,0,,Beklemekten sıkıldım.Dialogue: 55,0:14:59.50,0:15:02.46,Main-207-,,0,0,0,,Kurnaz planların haddini aştı, Bay 3!Dialogue: 55,0:15:03.17,0:15:05.84,Main-207-,,0,0,0,,Dorry'nin patlayan içkisini sen ayarladın!Dialogue: 55,0:15:05.84,0:15:06.97,Main-207-,,0,0,0,,Ne?!Dialogue: 55,0:15:07.72,0:15:08.93,Main-207-,,0,0,0,,İçki mi?Dialogue: 55,0:15:09.43,0:15:12.31,Thoughts-207-,,0,0,0,,Ona verdiğim içki mi?!Dialogue: 55,0:15:14.85,0:15:15.89,Flashbacks-207-,,0,0,0,,Dorry!Dialogue: 55,0:15:15.89,0:15:18.27,Flashbacks-207-,,0,0,0,,İçkin nasıldı?! İyi geldi ama değil mi?!Dialogue: 55,0:15:18.77,0:15:20.07,Flashbacks-207-,,0,0,0,,Evet.Dialogue: 55,0:15:20.07,0:15:22.53,Flashbacks-207-,,0,0,0,,İlahi bir tadı vardı.Dialogue: 55,0:15:22.90,0:15:26.11,Thoughts-207-,,0,0,0,,Demek bunu kastettin, Dorry?!Dialogue: 55,0:15:26.91,0:15:30.53,Main-207-,,0,0,0,,Yani zavallı kız, küçük numaramı anlamış.Dialogue: 55,0:15:30.53,0:15:31.95,Main-207-,,0,0,0,,Önemi yok.Dialogue: 55,0:15:31.95,0:15:34.50,Main-207-,,0,0,0,,Ne de olsa artık çaresizsin.Dialogue: 55,0:15:36.17,0:15:39.00,Main-207-,,0,0,0,,Mum...Dialogue: 55,0:15:39.00,0:15:40.67,Main-207-,,0,0,0,,Kilidi!Dialogue: 55,0:15:49.39,0:15:50.35,Main-207-,,0,0,0,,Bay 5!Dialogue: 55,0:15:50.35,0:15:51.05,Main-207-,,0,0,0,,Ha?Dialogue: 55,0:15:51.05,0:15:52.85,Main-207-,,0,0,0,,Kılıç ustasını ve kızı getirin.Dialogue: 55,0:15:54.35,0:15:55.23,Main-207-,,0,0,0,,Başlayalım.Dialogue: 55,0:15:59.06,0:16:04.65,Main-207-,,0,0,0,,Ekstra Özel Şamdan!Dialogue: 55,0:16:30.14,0:16:31.26,Main-207-,,0,0,0,,Ne oluyor?!Dialogue: 55,0:16:32.05,0:16:33.72,Main-207-,,0,0,0,,İşte geri kalanlar.Dialogue: 55,0:16:39.06,0:16:40.19,Main-207-,,0,0,0,,Reziller.Dialogue: 55,0:16:42.02,0:16:45.15,Main-207-,,0,0,0,,Bu adi heriflere yenilmek utanç vericiliğin de ötesindeydi.Dialogue: 55,0:16:45.15,0:16:47.82,Main-207-,,0,0,0,,Kendimden tiksiniyorum.Dialogue: 55,0:16:48.32,0:16:49.61,Main-207-,,0,0,0,,Bu da ne böyle?!Dialogue: 55,0:16:49.61,0:16:52.07,Main-207-,,0,0,0,,Nami-san... Bay Bushido...Dialogue: 55,0:16:52.07,0:16:53.08,Main-207-,,0,0,0,,Vivi!Dialogue: 55,0:16:53.08,0:16:55.74,Main-207-,,0,0,0,,Ne oldu?! Luffy'yle birlikte değil miydin?!Dialogue: 55,0:16:55.74,0:16:57.45,Main-207-,,0,0,0,,Evet ama–Dialogue: 55,0:16:57.45,0:17:01.38,Main-207-,,0,0,0,,Hasır Şapka'yı kastediyorsan, işini bitirdim.Dialogue: 55,0:17:02.63,0:17:04.96,Main-207-,,0,0,0,,Kolay bir işti.Dialogue: 55,0:17:05.55,0:17:06.96,Main-207-,,0,0,0,,Sen mi?Dialogue: 55,0:17:24.52,0:17:27.99,Main-207-,,0,0,0,,Hepiniz servis setime hoş geldiniz!Dialogue: 55,0:17:31.20,0:17:35.95,Main-207-,,0,0,0,,Pastanın içine sıkışmış bir mum olmak böyle bir his mi?Dialogue: 55,0:17:35.95,0:17:38.91,Main-207-,,0,0,0,,Orada dönüp duran şey de ne?Dialogue: 55,0:17:40.71,0:17:42.29,Main-207-,,0,0,0,,Bacaklarım kıpırdamıyor bile.Dialogue: 55,0:17:42.79,0:17:45.96,Main-207-,,0,0,0,,Bizi kıpırdayamaz hâlde tutmaları normal.Dialogue: 55,0:17:45.96,0:17:47.30,Main-207-,,0,0,0,,Ne de olsa düşmanız.Dialogue: 55,0:17:51.38,0:17:52.84,Main-207-,,0,0,0,,Çok sert.Dialogue: 55,0:17:53.51,0:17:56.76,Main-207-,,0,0,0,,Üstelik bu pozisyonda gücümü hiç kullanamıyorum.Dialogue: 55,0:17:56.76,0:17:58.64,Main-207-,,0,0,0,,Bir şeyler yağıyor!Dialogue: 55,0:18:01.10,0:18:04.02,Main-207-,,0,0,0,,Özel şamdanımın keyfini çıkarın!Dialogue: 55,0:18:04.65,0:18:07.15,Main-207-,,0,0,0,,Kafalarınıza damlayan mumla kaplı buğu...Dialogue: 55,0:18:07.15,0:18:09.99,Main-207-,,0,0,0,,yakında sizi bal mumu figürlerine dönüştürecek!Dialogue: 55,0:18:10.86,0:18:14.07,Main-207-,,0,0,0,,Yeteneklerimle dahi gerçekleştiremeyeceğim...Dialogue: 55,0:18:14.07,0:18:17.03,Main-207-,,0,0,0,,mükemmel insan figürleri olacaksınız!Dialogue: 55,0:18:17.74,0:18:22.00,Main-207-,,0,0,0,,Yakında ruh içeren bal mumu figürleri olacaksınız.Dialogue: 55,0:18:23.04,0:18:25.00,Main-207-,,0,0,0,,Şimdi sanat için...Dialogue: 55,0:18:25.33,0:18:26.96,Main-207-,,0,0,0,,ölün.Dialogue: 55,0:18:27.63,0:18:29.55,Main-207-,,0,0,0,,Siktir git!Dialogue: 55,0:18:29.55,0:18:32.97,Main-207-,,0,0,0,,Niye senin sanat eserin olmak zorundayız?!Dialogue: 55,0:18:33.47,0:18:36.30,Main-207-,,0,0,0,,Brogy-san! Orada öylece yatma!Dialogue: 55,0:18:36.30,0:18:39.10,Main-207-,,0,0,0,,Bir şey yap, yoksa sen de bal mumu figürü olacaksın!Dialogue: 55,0:18:39.10,0:18:41.60,Main-207-,,0,0,0,,Yuh, amma da iri kıyım biriymiş.Dialogue: 55,0:18:42.81,0:18:46.10,Main-207-,,0,0,0,,Söylediğin hiçbir şey onu harekete geçiremez!Dialogue: 55,0:18:46.10,0:18:52.82,Main-207-,,0,0,0,,Rakibinin yaralarını fark etmeden 100 yıldır dövüştüğü dostu Dorry'i,Dialogue: 55,0:18:52.82,0:18:56.57,Main-207-,,0,0,0,,kendi elleriyle öldürdüğünü daha yeni öğrendi.Dialogue: 55,0:18:56.57,0:19:04.25,Main-207-,,0,0,0,,Üstelik ahmak, sevinç gözyaşlarının ne kadar boş olduğunu anladı.Dialogue: 55,0:19:04.25,0:19:08.04,Main-207-,,0,0,0,,Ya da belki, sevgili dostunu kaybedişine ağlıyordun?Dialogue: 55,0:19:09.59,0:19:13.42,Main-207-,,0,0,0,,Ne olursa olsun, zamanı geri alamazsın, budala!Dialogue: 55,0:19:23.60,0:19:25.35,Main-207-,,0,0,0,,Biliyordum.Dialogue: 55,0:19:25.35,0:19:26.60,Main-207-,,0,0,0,,Ha?Dialogue: 55,0:19:26.60,0:19:29.31,Main-207-,,0,0,0,,Bir şeylerin ters gittiğini biliyordum.Dialogue: 55,0:19:34.65,0:19:37.45,Main-207-,,0,0,0,,Dövüşümüze başladığımız andan itibaren...Dialogue: 55,0:19:37.45,0:19:40.08,Main-207-,,0,0,0,,Dorry'nin bir şey gizlediğini biliyordum.Dialogue: 55,0:19:40.45,0:19:43.25,Main-207-,,0,0,0,,Oh? Biliyordun ha?Dialogue: 55,0:19:43.25,0:19:44.12,Main-207-,,0,0,0,,Yalancı!Dialogue: 55,0:19:44.83,0:19:47.54,Main-207-,,0,0,0,,Öyleyse niye dövüşmeye devam ettin?Dialogue: 55,0:19:47.54,0:19:53.34,Main-207-,,0,0,0,,Ne kadar sert dövüştüğünü gördüm. Zerre kadar acıman yoktu!Dialogue: 55,0:19:56.93,0:19:59.59,Main-207-,,0,0,0,,Düellonun önemini anlamayan bir çocuğun...Dialogue: 55,0:19:59.59,0:20:02.47,Main-207-,,0,0,0,,gözyaşlarımın sebebini anlaması mümkün değil!Dialogue: 55,0:20:03.35,0:20:05.93,Main-207-,,0,0,0,,Sen ne anlarsın ki?Dialogue: 55,0:20:05.93,0:20:10.27,Main-207-,,0,0,0,,Yaralarını saklayıp yine de dövüşen bir savaşçıyı...Dialogue: 55,0:20:10.27,0:20:11.73,Main-207-,,0,0,0,,küçük mü düşürseydim?!Dialogue: 55,0:20:15.65,0:20:22.08,Main-207-,,0,0,0,,Yaralı bir savaşçı dövüşmeye devam etmeyi seçtiğinde merhamet dilemez!Dialogue: 55,0:20:23.03,0:20:26.00,Main-207-,,0,0,0,,Ve şimdi sebebini öğrendim.Dialogue: 55,0:20:26.91,0:20:30.96,Main-207-,,0,0,0,,Artık bildiğime göre, bu işi kendi ellerimle çözeceğim!Dialogue: 55,0:20:39.59,0:20:41.51,Main-207-,,0,0,0,,Değerli dostum Dorry'yi...Dialogue: 55,0:20:41.51,0:20:43.89,Main-207-,,0,0,0,,en azından bu şekilde onurlandırabilirim!Dialogue: 55,0:20:48.44,0:20:49.64,Main-207-,,0,0,0,,Brogy-san!Dialogue: 55,0:20:55.65,0:20:57.32,Main-207-,,0,0,0,,– Brogy-san! – Brogy-san!Dialogue: 55,0:20:58.11,0:21:00.32,Main-207-,,0,0,0,,Ne sinir bozucu, geveze bir canavar.Dialogue: 55,0:21:01.74,0:21:05.24,Main-207-,,0,0,0,,U... Usopp...Dialogue: 55,0:21:05.24,0:21:06.91,Main-207-,,0,0,0,,Usopp...!Dialogue: 55,0:21:09.87,0:21:13.13,Main-207-,,0,0,0,,Bu... onların yanına kâr mı kalacak?Dialogue: 55,0:21:13.59,0:21:15.00,Main-207-,,0,0,0,,Hayır...Dialogue: 55,0:21:15.00,0:21:16.59,Main-207-,,0,0,0,,Asla.Dialogue: 55,0:21:25.60,0:21:28.43,Main-207-,,0,0,0,,Sen de mi... kızgınsın?Dialogue: 55,0:21:34.94,0:21:37.03,Main-207-,,0,0,0,,Pekâlâ! Hadi şunları...Dialogue: 55,0:21:37.53,0:21:39.78,Main-207-,,0,0,0,,öldüresiye dövmeye gidelim!Dialogue: 55,0:21:39.78,0:21:40.90,Main-207-,,0,0,0,,Brogy-san!Dialogue: 55,0:21:41.91,0:21:42.74,Main-207-,,0,0,0,,Aptal!Dialogue: 55,0:21:43.99,0:21:49.45,Main-207-,,0,0,0,,Devlerin acımasız gücünü hafife aldım!Dialogue: 55,0:21:50.91,0:21:54.63,Main-207-,,0,0,0,,Görünen o ki seni daha iyi zapt etmeliyim!Dialogue: 55,0:21:54.63,0:21:57.59,Main-207-,,0,0,0,,Mum Sanatı: Kelepçeler!Dialogue: 55,0:22:00.76,0:22:02.22,Main-207-,,0,0,0,,Daha bitirmedim!Dialogue: 55,0:22:08.77,0:22:11.43,Main-207-,,0,0,0,,Ve son dokunuş!Dialogue: 55,0:22:11.43,0:22:12.48,Main-207-,,0,0,0,,Al!Dialogue: 55,0:22:21.90,0:22:24.87,Main-207-,,0,0,0,,Şimdi kurtul da göreyim!Dialogue: 55,0:22:33.46,0:22:35.42,Main-207-,,0,0,0,,Nasıl bu kadar acımasız olabilir?Dialogue: 55,0:22:35.42,0:22:38.38,Main-207-,,0,0,0,,Şimdi hızlan, özel şamdanım!Dialogue: 55,0:22:39.05,0:22:43.09,Main-207-,,0,0,0,,Onları bal mumu figürlerine çevir!Dialogue: 55,0:22:48.26,0:22:50.27,Main-207-,,0,0,0,,G-Göğsüm yanmaya başladı.Dialogue: 55,0:22:50.27,0:22:52.48,Main-207-,,0,0,0,,Mum ciğerlerimize doluyor!Dialogue: 55,0:22:52.48,0:22:55.85,Main-207-,,0,0,0,,Bu gidişle içten dışa doğru bal mumu figürlerine dönüşeceğiz!Dialogue: 55,0:22:57.15,0:22:58.48,Main-207-,,0,0,0,,Evet! Evet!Dialogue: 55,0:22:58.48,0:23:01.82,Main-207-,,0,0,0,,Acı içinde görünmeniz her şeyi daha da güzelleştiriyor!Dialogue: 55,0:23:02.19,0:23:07.82,Main-207-,,0,0,0,,Sanatta en değer verdiğim şey, acı ve elem dolu suratlardır!Dialogue: 55,0:23:08.78,0:23:10.83,Main-207-,,0,0,0,,Dehşet içindeyken katılaşın!Dialogue: 55,0:23:11.37,0:23:13.96,Main-207-,,0,0,0,,Bu mu sanat, seni topuz kafalı ucube?!Dialogue: 55,0:23:13.96,0:23:17.17,Main-207-,,0,0,0,,Ve bunu Brogy-san'a yapmaya nasıl cüret edersin?!Dialogue: 55,0:23:17.96,0:23:21.05,Main-207-,,0,0,0,,Hak ettiğini bulacaksın! Duyuyor musun?!Dialogue: 55,0:23:23.21,0:23:25.55,Main-207-,,0,0,0,,İstediğin kadar bağır!Dialogue: 55,0:23:32.14,0:23:33.60,Thoughts-207-,,0,0,0,,100 yıl...Dialogue: 55,0:23:42.07,0:23:46.53,Thoughts-207-,,0,0,0,,Günbegün, dövüş üstüne dövüş...Dialogue: 55,0:23:46.53,0:23:52.04,Thoughts-207-,,0,0,0,,Elbaf savaşçıları olarak şerefimiz üzerine düelloya tutuştuk!Dialogue: 55,0:23:52.66,0:23:53.66,Thoughts-207-,,0,0,0,,Ama bize...Dialogue: 55,0:23:53.66,0:23:58.71,Thoughts-207-,,0,0,0,,bu sonu mu layık gördün, savaş tanrısı Elbaf?!Dialogue: 55,0:24:01.59,0:24:08.84,Thoughts-207-,,0,0,0,,Böyle zavallı bir son yerine daha iyisini haketmiyor muyuz, Elbaf?!Dialogue: 55,0:24:08.84,0:24:13.14,Thoughts-207-,,0,0,0,,Savaşarak ölmemiz gerekmez miydi?!Dialogue: 55,0:24:15.77,0:24:17.81,Main-207-,,0,0,0,,Ne muhteşem bir ifade!Dialogue: 55,0:24:17.81,0:24:21.15,Main-207-,,0,0,0,,İşte bu! Acı! Keder! Istırap!Dialogue: 55,0:24:21.15,0:24:24.61,Main-207-,,0,0,0,,Ne harika bir sanat eseri!Dialogue: 55,0:24:24.61,0:24:27.03,Thoughts-207-,,0,0,0,,Elbaf!Dialogue: 55,0:24:27.57,0:24:29.66,Main-207-,,0,0,0,,Olamaz! Ellerim kıpırdamıyor!Dialogue: 55,0:24:29.66,0:24:32.16,Main-207-,,0,0,0,,Böyle bitmesin! Bir şeyler yapamaz mıyız?!Dialogue: 55,0:24:32.16,0:24:34.37,Main-207-,,0,0,0,,Bedenim çoktan sertleşmeye başladı!Dialogue: 55,0:24:34.37,0:24:35.95,Main-207-,,0,0,0,,Ne yapabiliriz?!Dialogue: 55,0:24:36.58,0:24:38.71,Main-207-,,0,0,0,,Z-Zoro! Bir şeyler düşün!Dialogue: 55,0:24:39.42,0:24:41.04,Main-207-,,0,0,0,,Hey, ihtiyar.Dialogue: 55,0:24:41.38,0:24:42.88,Main-207-,,0,0,0,,Hâlâ biraz gücün var, değil mi?Dialogue: 55,0:24:42.88,0:24:43.80,Main-207-,,0,0,0,,Ha?Dialogue: 55,0:24:43.80,0:24:45.46,Main-207-,,0,0,0,,Benim de.Dialogue: 55,0:24:47.80,0:24:50.76,Main-207-,,0,0,0,,Şunları birlikte ezmeye ne dersiniz?Dialogue: 55,0:24:52.43,0:24:54.10,Main-207-,,0,0,0,,Bekle, Zoro! Ne yapıyorsun?!Dialogue: 55,0:24:54.10,0:24:55.22,Main-207-,,0,0,0,,Yoksa–Dialogue: 55,0:24:55.22,0:24:55.93,Main-207-,,0,0,0,,Evet.Dialogue: 55,0:24:55.93,0:24:58.27,Main-207-,,0,0,0,,Bacaklarını kesme konusunda şaka yapma!Dialogue: 55,0:24:58.27,0:25:00.19,Main-207-,,0,0,0,,Şaka değil.Dialogue: 55,0:25:00.19,0:25:02.69,Main-207-,,0,0,0,,Buradan çıkmamızın tek yolu bu.Dialogue: 55,0:25:02.69,0:25:03.77,Main-207-,,0,0,0,,Kararınız nedir?Dialogue: 55,0:25:03.77,0:25:05.28,Main-207-,,0,0,0,,Kararımız mı? Mümkün değil!Dialogue: 55,0:25:05.28,0:25:07.90,Main-207-,,0,0,0,,Aşağı inmeyi başarsak bile yine yakalanacağız!Dialogue: 55,0:25:08.32,0:25:10.86,Main-207-,,0,0,0,,Denemeden bilemeyiz!Dialogue: 55,0:25:11.49,0:25:14.62,Main-207-,,0,0,0,,Zaten burada kalırsak nalları dikeceğiz.Dialogue: 55,0:25:14.62,0:25:16.83,Main-207-,,0,0,0,,Bari destansı bir direniş sergileyelim!Dialogue: 55,0:25:17.70,0:25:21.08,Main-207-,,0,0,0,,Bu değersiz böceklere karşı  bu kadar kolay ölemem!Dialogue: 55,0:25:21.08,0:25:22.33,Main-207-,,0,0,0,,Haksız mıyım?Dialogue: 55,0:25:22.33,0:25:24.50,Main-207-,,0,0,0,,Neden bahsediyor bu? Delirmiş mi?Dialogue: 55,0:25:25.09,0:25:26.59,Main-207-,,0,0,0,,Blöf yapıyorsun!Dialogue: 55,0:25:26.59,0:25:28.80,Main-207-,,0,0,0,,Yapmakla tehdit ettiğin şey çok gülünç!Dialogue: 55,0:25:28.80,0:25:30.30,Main-207-,,0,0,0,,Rol yapıyorsun!Dialogue: 55,0:25:33.64,0:25:36.22,Main-207-,,0,0,0,,Ne korkusuz bir çocuk.Dialogue: 55,0:25:36.22,0:25:37.81,Main-207-,,0,0,0,,Ben ise acınacak hâldeyim.Dialogue: 55,0:25:37.81,0:25:40.73,Main-207-,,0,0,0,,Mücadele kararlılığımı yitirmek üzereydim.Dialogue: 55,0:25:41.35,0:25:44.19,Main-207-,,0,0,0,,Ama içindeki tutku, beni savaşmaya heveslendirdi!Dialogue: 55,0:25:46.11,0:25:48.36,Main-207-,,0,0,0,,Ciddi olamazsın, değil mi?!Dialogue: 55,0:25:48.36,0:25:50.61,Main-207-,,0,0,0,,Bacakların olmadan nasıl dövüşeceksin?Dialogue: 55,0:25:50.61,0:25:51.57,Main-207-,,0,0,0,,Kim bilir?Dialogue: 55,0:25:51.95,0:25:53.07,Main-207-,,0,0,0,,Ama...Dialogue: 55,0:25:53.82,0:25:55.74,Main-207-,,0,0,0,,kazanmayı planlıyorum.Dialogue: 55,0:25:56.53,0:25:58.20,Main-207-,,0,0,0,,Bu herifin nesi var?!Dialogue: 55,0:25:58.20,0:25:59.75,Main-207-,,0,0,0,,Kafayı yemiş!Dialogue: 55,0:26:00.37,0:26:02.25,Thoughts-207-,,0,0,0,,Böyle bir adam nasıl var olabilir?!Dialogue: 55,0:26:02.25,0:26:06.38,Thoughts-207-,,0,0,0,,Ama o gözleri daha önce  bir yerde görmüşüm gibi.Dialogue: 55,0:26:06.38,0:26:07.71,Flashbacks-207-,,0,0,0,,Prenses Vivi!Dialogue: 55,0:26:08.17,0:26:11.17,Flashbacks-207-,,0,0,0,,Hayatta kalmaya kararlı mısın?Dialogue: 55,0:26:11.17,0:26:12.51,Main-207-,,0,0,0,,B-Bekle!Dialogue: 55,0:26:12.51,0:26:13.68,Main-207-,,0,0,0,,Ben de dövüşeceğim!Dialogue: 55,0:26:13.68,0:26:14.30,Main-207-,,0,0,0,,Vivi!Dialogue: 55,0:26:14.30,0:26:15.64,Main-207-,,0,0,0,,Bunu duymak güzel.Dialogue: 55,0:26:16.05,0:26:19.39,Main-207-,,0,0,0,,Başlıyoruz, çocuk!Dialogue: 55,0:26:19.39,0:26:22.39,Main-207-,,0,0,0,,Aptalca! Bir saldırı stratejin var mı acaba?!Dialogue: 55,0:26:32.61,0:26:33.91,Main-207-,,0,0,0,,Ulan!Dialogue: 55,0:26:33.91,0:26:35.87,Main-207-,,0,0,0,,Dayak yemeye hazır olun!Dialogue: 55,0:26:39.20,0:26:40.41,Main-207-,,0,0,0,,Ne?Dialogue: 55,0:26:41.96,0:26:43.29,Main-207-,,0,0,0,,Hadi yapalım, Usopp!Dialogue: 55,0:26:43.29,0:26:43.92,Main-207-,,0,0,0,,Evet!Dialogue: 55,0:26:43.92,0:26:45.54,Main-207-,,0,0,0,,Kuş?!Dialogue: 55,0:26:45.54,0:26:46.46,Main-207-,,0,0,0,,Luffy!Dialogue: 55,0:26:46.46,0:26:47.42,Main-207-,,0,0,0,,Usopp!Dialogue: 55,0:26:47.79,0:26:48.55,Main-207-,,0,0,0,,Karoo!Dialogue: 55,0:26:48.92,0:26:52.80,Main-207-,,0,0,0,,Usta Brogy! Öfkeni devralıyoruz!Dialogue: 55,0:26:52.80,0:26:53.72,Main-207-,,0,0,0,,Usopp...!Dialogue: 55,0:26:53.72,0:26:56.72,Main-207-,,0,0,0,,Şunları eşek sudan gelinceye dek pataklayıp...Dialogue: 55,0:26:56.72,0:26:58.89,Main-207-,,0,0,0,,dünyanın öteki ucuna fırlatın!Dialogue: 55,0:26:58.89,0:27:00.18,Main-207-,,0,0,0,,Evet! Yapacağız!Dialogue: 55,0:27:00.81,0:27:04.69,Main-207-,,0,0,0,,İhtiyar devlerin düellosunu mahvettiler!Dialogue: 55,0:27:05.06,0:27:09.69,Main-207-,,0,0,0,,Cidden Doğu Mavi'nin en yüksek ödülüne mi sahipsin?Dialogue: 55,0:27:09.69,0:27:12.36,Main-207-,,0,0,0,,Denizciler, kesinlikle standartlarını düşürmüş!Dialogue: 55,0:27:12.36,0:27:13.99,Main-207-,,0,0,0,,Yuh! Tuhaf bir kafan var!Dialogue: 55,0:27:13.99,0:27:14.86,Main-207-,,0,0,0,,Kapa' çeneni!Dialogue: 55,0:27:14.86,0:27:16.74,Main-207-,,0,0,0,,Yanan bir üç numara!Dialogue: 55,0:27:16.74,0:27:17.37,Main-207-,,0,0,0,,Sus!Dialogue: 55,0:27:17.37,0:27:20.33,Main-207-,,0,0,0,,Önce şu sütunu kır, Luffy!Dialogue: 55,0:27:20.33,0:27:22.87,Main-207-,,0,0,0,,Bal mumu figürleri olmak üzereyiz!Dialogue: 55,0:27:22.87,0:27:23.54,Main-207-,,0,0,0,,Ha?Dialogue: 55,0:27:24.08,0:27:25.25,Main-207-,,0,0,0,,Ne? Başınız dertte mi?Dialogue: 55,0:27:25.25,0:27:27.04,Main-207-,,0,0,0,,Hayır, önemli bir şey değil.Dialogue: 55,0:27:27.04,0:27:29.04,Main-207-,,0,0,0,,Hey, dur! Bacakların!Dialogue: 55,0:27:29.04,0:27:29.79,Main-207-,,0,0,0,,Evet.Dialogue: 55,0:27:30.17,0:27:32.13,Main-207-,,0,0,0,,Sadece yarısına kadar kestim.Dialogue: 55,0:27:32.13,0:27:35.22,Main-207-,,0,0,0,,Nasıl "önemli bir şey değil" dersin?!Dialogue: 55,0:27:35.59,0:27:39.39,Main-207-,,0,0,0,,Her neyse Luffy, önce şu sütunu kırabilir misin?Dialogue: 55,0:27:39.80,0:27:41.18,Main-207-,,0,0,0,,Sonra yardırırsın.Dialogue: 55,0:27:41.89,0:27:43.35,Main-207-,,0,0,0,,Elbette!Dialogue: 55,0:27:44.52,0:27:46.27,Main-207-,,0,0,0,,Ben o kadar emin olmazdım.Dialogue: 55,0:27:46.77,0:27:50.06,Main-207-,,0,0,0,,Ne olduğunu bilmiyorum ama önce onu kıracağız!Dialogue: 55,0:27:50.06,0:27:51.27,Main-207-,,0,0,0,,Tamam!Dialogue: 55,0:27:51.27,0:27:52.48,Main-207-,,0,0,0,,Anladım!Dialogue: 55,0:27:52.48,0:27:55.40,Main-207-,,0,0,0,,Yenilenmiş gibi hissediyorum!Dialogue: 55,0:27:58.07,0:28:01.16,Main-207-,,0,0,0,,Biz katılaşmadan önce acele edin!Dialogue: 0,0:01:53.72,0:01:56.55,Title-207-,,0,0,0,,Kural İhlaliDialogue: 1,0:01:53.72,0:01:56.55,Title-207-,,0,0,0,,Kural İhlaliDialogue: 0,0:00:01.73,0:00:03.73,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 1,0:00:01.73,0:00:03.73,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 0,0:00:01.73,0:00:03.73,Credits-207-,,0,0,0,,Galaxy 9000 Gigglebot ZenefDialogue: 1,0:00:01.73,0:00:03.73,Credits-207-,,0,0,0,,Galaxy 9000 Gigglebot ZenefDialogue: 0,0:00:03.73,0:00:05.73,Credits-207-,,0,0,0,,ZamanlamaDialogue: 1,0:00:03.73,0:00:05.73,Credits-207-,,0,0,0,,ZamanlamaDialogue: 0,0:00:03.73,0:00:05.73,Credits-207-,,0,0,0,,Gab PhosCity ZenefDialogue: 1,0:00:03.73,0:00:05.73,Credits-207-,,0,0,0,,Gab PhosCity ZenefDialogue: 0,0:00:05.73,0:00:07.73,Credits-207-,,0,0,0,,DizgiDialogue: 1,0:00:05.73,0:00:07.73,Credits-207-,,0,0,0,,DizgiDialogue: 0,0:00:05.73,0:00:07.73,Credits-207-,,0,0,0,,GabDialogue: 1,0:00:05.73,0:00:07.73,Credits-207-,,0,0,0,,GabDialogue: 0,0:00:07.73,0:00:09.73,Credits-207-,,0,0,0,,Kalite KontrolDialogue: 1,0:00:07.73,0:00:09.73,Credits-207-,,0,0,0,,Kalite KontrolDialogue: 0,0:00:07.73,0:00:09.73,Credits-207-,,0,0,0,,Galaxy 9000 PepperjackDialogue: 1,0:00:07.73,0:00:09.73,Credits-207-,,0,0,0,,Galaxy 9000 PepperjackDialogue: 0,0:00:09.73,0:00:11.73,Credits-207-,,0,0,0,,MüzikDialogue: 1,