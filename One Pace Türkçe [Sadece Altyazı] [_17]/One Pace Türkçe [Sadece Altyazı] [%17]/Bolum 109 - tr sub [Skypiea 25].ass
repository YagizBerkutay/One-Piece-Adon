&H00000000,0,0,0,0,100,100,0,0,1,1.5,0,8,10,10,30,1Style: Karaoke,Duality,65,&H009E375F,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,8,10,10,30,1Style: Translation,Duality,65,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,3,0,2,10,10,30,1Style: Luffy Monologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1Style: KaraokeED,Duality,70,&H00FFFFFF,&H000000FF,&H00DB7A3A,&H00000000,0,0,0,0,100,100,2,0,1,3,0,7,30,8,15,1Style: TranslationED,Duality,70,&H00FFFFFF,&H000000FF,&H00DB7A3A,&H00000000,0,0,0,0,100,100,2,0,1,3,0,1,30,100,15,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:50.05,0:02:00.04,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 50,0:01:53.34,0:01:56.35,Main-207-,,0,0,0,,Ne? Adadan kaçtılar mı?Dialogue: 50,0:01:56.35,0:01:59.47,Main-207-,,0,0,0,,Evet. Minnettarlığımızı gösteremedik.Dialogue: 50,0:01:59.47,0:02:01.81,Main-207-,,0,0,0,,Çok üzücü...Dialogue: 50,0:02:02.98,0:02:07.65,Main-207-,,0,0,0,,Onlara ne kadar borçlu olduğumuzu bilmiyorlar mı?Dialogue: 50,0:02:09.32,0:02:13.11,Main-207-,,0,0,0,,Evet. Hislerimizi hâlâ anlayabilmiş değiller.Dialogue: 50,0:02:16.53,0:02:18.41,Main-207-,,0,0,0,,Bu adil değil, Aisa...Dialogue: 50,0:02:18.41,0:02:20.83,Main-207-,,0,0,0,,Onlarla vedalaşan tek kişi sensin.Dialogue: 50,0:02:20.83,0:02:24.67,Main-207-,,0,0,0,,Herkes kurtarıcılarımızın kaçışı konusunda velvele yapıyor.Dialogue: 50,0:02:25.88,0:02:29.67,Main-207-,,0,0,0,,Ama Luffy ve tayfası kimseye söyleme dedi!Dialogue: 50,0:02:30.34,0:02:34.63,Main-207-,,0,0,0,,Hey Raki, Luffy'nin bedeni esneyebiliyor, haberin var mıydı?!Dialogue: 50,0:02:34.93,0:02:37.80,Main-207-,,0,0,0,,"Lastik-Lastik Tabanca" diye bağırıyordu.Dialogue: 50,0:02:37.80,0:02:40.43,Main-207-,,0,0,0,,Hey, Aisa, kıpırdama.Dialogue: 50,0:02:40.43,0:02:43.39,Main-207-,,0,0,0,,Demek Mavi Deniz'de de öyle güçlü bir savaşçı varmış!Dialogue: 50,0:02:44.02,0:02:48.06,Main-207-,,0,0,0,,Onun gibi olmak istiyorum, "Lastik-Lastik" gibi!Dialogue: 50,0:02:49.61,0:02:51.07,Main-207-,,0,0,0,,Aisa...Dialogue: 50,0:02:52.57,0:02:56.03,Main-207-,,0,0,0,,Bugünlük sadece uçlarından alalım. Saçını uzatmalısın.Dialogue: 50,0:02:56.03,0:02:56.86,Main-207-,,0,0,0,,Ne?Dialogue: 50,0:02:56.86,0:03:01.54,Main-207-,,0,0,0,,Bence sana çok yakışır. Sonuçta kızsın, şirin olmalısın.Dialogue: 50,0:03:01.83,0:03:06.17,Main-207-,,0,0,0,,Şirin mi?! Ben?!Dialogue: 50,0:03:07.67,0:03:08.42,Main-207-,,0,0,0,,Aynen öyle!Dialogue: 50,0:03:09.04,0:03:12.67,Main-207-,,0,0,0,,Artık siz çocukların silah taşımasına gerek yok.Dialogue: 50,0:03:14.63,0:03:19.10,Main-207-,,0,0,0,,Normal bir adalı gibi özgürce yaşayabilirsin.Dialogue: 50,0:03:21.14,0:03:23.35,Main-207-,,0,0,0,,Bugün çok hanım hanımsın!Dialogue: 50,0:03:24.52,0:03:27.27,Main-207-,,0,0,0,,Şimdi, kıpırdama, Aisa!Dialogue: 50,0:03:27.27,0:03:28.65,Main-207-,,0,0,0,,Hanım hanım, Raki!Dialogue: 50,0:03:28.65,0:03:29.90,Main-207-,,0,0,0,,Aisa!Dialogue: 50,0:03:37.20,0:03:38.99,Main-207-,,0,0,0,,Şanlı Savaşçı Kalgara...Dialogue: 50,0:03:39.87,0:03:43.49,Main-207-,,0,0,0,,Bize, Shandia halkının kutsal görevini tamamladığı söylendi.Dialogue: 50,0:03:44.12,0:03:47.71,Main-207-,,0,0,0,,Dileğin kesinlikle en iyi arkadaşına ulaştı.Dialogue: 50,0:03:48.50,0:03:53.34,Main-207-,,0,0,0,,Gelecek nesillerde kan dökmemize gerek yok.Dialogue: 50,0:03:54.01,0:03:59.01,Main-207-,,0,0,0,,Savaş sona erdi ama onurumuzu yitirmeyeceğiz!Dialogue: 50,0:03:59.59,0:04:03.10,Main-207-,,0,0,0,,Bu yüzden, lütfen bizi gözetmeye devam et.Dialogue: 50,0:04:05.31,0:04:09.31,Main-207-,,0,0,0,,Shandora'nın Işığı'nı daima yakacağımıza ant içeriz!Dialogue: 50,0:04:19.24,0:04:23.03,Main-207-,,0,0,0,,Ben yalnızca Gökyüzü Şövalyesiyim, serbest çalışan bir paralı askerim.Dialogue: 50,0:04:24.04,0:04:26.37,Main-207-,,0,0,0,,Bu işe uygun olan kişi sensin.Dialogue: 50,0:04:26.37,0:04:29.67,Main-207-,,0,0,0,,Bu topraklar ilk günden beri size aitti.Dialogue: 50,0:04:29.67,0:04:31.21,Main-207-,,0,0,0,,Bu da ne şimdi?Dialogue: 50,0:04:31.75,0:04:34.13,Main-207-,,0,0,0,,Bu iyi bir sebep değil.Dialogue: 50,0:04:34.13,0:04:36.96,Main-207-,,0,0,0,,Bu savaş, vearth üzerinde...Dialogue: 50,0:04:37.59,0:04:40.64,Main-207-,,0,0,0,,kimsenin hak iddia edemeyeceğini hepimize gösterdi.Dialogue: 50,0:04:40.97,0:04:43.39,Main-207-,,0,0,0,,"Tanrı" unvanı güç kazandırır.Dialogue: 50,0:04:43.39,0:04:47.10,Main-207-,,0,0,0,,Bu diyarın adı Skypiea. Şehrin adı ise Shandora.Dialogue: 50,0:04:47.93,0:04:50.02,Main-207-,,0,0,0,,Onları birleştirebilecek tek kişi sensin;Dialogue: 50,0:04:50.02,0:04:55.61,Main-207-,,0,0,0,,bu topraklardaki bitmek bilmeyen savaş için hep acı çeken sen.Dialogue: 50,0:04:57.07,0:04:59.49,Main-207-,,0,0,0,,Gökyüzü Şövalyesi Gan Fall...Dialogue: 50,0:04:59.49,0:05:01.57,Main-207-,,0,0,0,,Bir kez daha tanrı olmanı...Dialogue: 50,0:05:01.57,0:05:05.49,Main-207-,,0,0,0,,ve bu yaralı millete iyileşme gücü vermeni istiyorum.Dialogue: 50,0:05:07.50,0:05:09.41,Main-207-,,0,0,0,,Bizim de isteğimiz bu!Dialogue: 50,0:05:09.41,0:05:10.50,Main-207-,,0,0,0,,Gan Fall-sama!Dialogue: 50,0:05:10.83,0:05:12.63,Main-207-,,0,0,0,,Siz varsanız biz de varız!Dialogue: 50,0:05:12.63,0:05:13.71,Main-207-,,0,0,0,,Evet!Dialogue: 50,0:05:13.71,0:05:15.04,Main-207-,,0,0,0,,Gan Fall!Dialogue: 50,0:05:15.04,0:05:16.21,Main-207-,,0,0,0,,Tanrı'm!Dialogue: 50,0:05:16.21,0:05:16.92,Main-207-,,0,0,0,,Lütfen dönün!Dialogue: 50,0:05:20.68,0:05:22.43,Main-207-,,0,0,0,,Cidden...Dialogue: 50,0:05:23.55,0:05:28.89,Main-207-,,0,0,0,,Tam da artık huzur içinde kabak yetiştirebilirim diyordum...Dialogue: 50,0:05:55.63,0:05:57.21,Main-207-,,0,0,0,,Millet! Göründü sonunda!Dialogue: 50,0:05:58.38,0:06:01.42,Main-207-,,0,0,0,,İleri bakın! Bulutun Sonu'na!Dialogue: 50,0:06:01.42,0:06:02.63,Main-207-,,0,0,0,,Ah! Bakayım!Dialogue: 50,0:06:03.80,0:06:06.93,Main-207-,,0,0,0,,Vay... Yani oradan inebilir miyiz?Dialogue: 50,0:06:06.93,0:06:09.10,Main-207-,,0,0,0,,Buraya gerçekten çabuk geldik.Dialogue: 50,0:06:11.27,0:06:13.98,Main-207-,,0,0,0,,Hemen ayrılıyor muyuz?Dialogue: 50,0:06:13.98,0:06:17.69,Main-207-,,0,0,0,,Cidden, ayrılmak üzere olmamız biraz üzüyor.Dialogue: 50,0:06:17.69,0:06:20.57,Main-207-,,0,0,0,,Bu beyaz denize elveda deme vakti.Dialogue: 50,0:06:20.57,0:06:23.74,Main-207-,,0,0,0,,Gökyüzü adası eğlenceliydi ama biraz da korkunçtu.Dialogue: 50,0:06:24.20,0:06:28.70,Main-207-,,0,0,0,,Demek oradan Mavi Deniz'e inen bir süt yolu var, ha?Dialogue: 50,0:06:29.49,0:06:32.12,Main-207-,,0,0,0,,Bir daha gökyüzü adasına gelir miyiz acaba?Dialogue: 50,0:06:32.12,0:06:33.96,Main-207-,,0,0,0,,Belki.Dialogue: 50,0:06:42.92,0:06:47.26,Main-207-,,0,0,0,,Pekâlâ millet! Üzgünüm ama burada vedalaşıyoruz!Dialogue: 50,0:06:47.26,0:06:49.06,Main-207-,,0,0,0,,Kendinize iyi bakın!Dialogue: 50,0:06:49.89,0:06:51.72,Main-207-,,0,0,0,,Bizi uğurladığınız için sağ olun!Dialogue: 50,0:06:51.72,0:06:54.39,Main-207-,,0,0,0,,Conis-chan! Kendine iyi bak!Dialogue: 50,0:06:54.39,0:06:56.35,Main-207-,,0,0,0,,Diğerlerine de selamlarımızı iletin!Dialogue: 50,0:06:56.90,0:06:58.90,Main-207-,,0,0,0,,Görüşürüz!Dialogue: 50,0:06:59.65,0:07:01.69,Main-207-,,0,0,0,,Her şey için sağ olun!Dialogue: 50,0:07:02.69,0:07:07.16,Main-207-,,0,0,0,,Hayır! Asıl siz sağ olun!Dialogue: 50,0:07:07.87,0:07:10.99,Main-207-,,0,0,0,,Sizi asla unutmayacağım!Dialogue: 50,0:07:11.49,0:07:14.33,Main-207-,,0,0,0,,Conis, ihtiyar ve tüy yumağı! Kendinize iyi bakın!Dialogue: 50,0:07:14.33,0:07:15.50,Main-207-,,0,0,0,,– Olur! – Olur!Dialogue: 50,0:07:15.50,0:07:19.54,Main-207-,,0,0,0,,Şimdi, yelkenleri hemen toplayın ve gemiye sıkı tutunun!Dialogue: 50,0:07:19.54,0:07:21.67,Main-207-,,0,0,0,,Pekâlâ! Dediğini yapalım!Dialogue: 50,0:07:22.09,0:07:23.97,Main-207-,,0,0,0,,Oldukça hızlı olacak gibi!Dialogue: 50,0:07:23.97,0:07:27.76,Main-207-,,0,0,0,,Evet, 7.000 metre aşağı kayacağız! Acele edin!Dialogue: 50,0:07:27.76,0:07:28.76,Main-207-,,0,0,0,,– Tamam! – Tamam!Dialogue: 50,0:07:33.93,0:07:35.02,Main-207-,,0,0,0,,N-Ne?! Ha?!Dialogue: 50,0:07:37.90,0:07:40.06,Main-207-,,0,0,0,,"Beni unutmayın." diyor.Dialogue: 50,0:07:40.06,0:07:43.86,Main-207-,,0,0,0,,Ah... Gökyüzüne getirdiğimiz güney kuşu.Dialogue: 50,0:07:47.24,0:07:48.53,Main-207-,,0,0,0,,Tamamız, Kaptan!Dialogue: 50,0:07:48.95,0:07:51.16,Main-207-,,0,0,0,,Rotamız belirlendi!Dialogue: 50,0:07:53.62,0:07:59.88,Main-207-,,0,0,0,,Evet! Aşağı iner inmez başka bir maceraya atılacağız!Dialogue: 50,0:08:00.25,0:08:03.09,Main-207-,,0,0,0,,Hazır mısınız, millet?!Dialogue: 50,0:08:04.67,0:08:07.34,Main-207-,,0,0,0,,Mavi Deniz'e dönüyoruz!Dialogue: 50,0:08:07.34,0:08:08.76,Main-207-,,0,0,0,,– Evet! – Evet!Dialogue: 50,0:08:21.90,0:08:25.40,Main-207-,,0,0,0,,Millet! Düşerken dikkatli olun!Dialogue: 50,0:08:29.36,0:08:30.61,Main-207-,,0,0,0,,– Düşerken mi? – Düşerken mi?Dialogue: 50,0:08:39.58,0:08:41.00,Main-207-,,0,0,0,,Heso!Dialogue: 50,0:08:45.42,0:08:50.05,Main-207-,,0,0,0,,İşte başlıyor! Gökyüzü adasının ünlü ahtapot balonu!Dialogue: 50,0:09:02.44,0:09:04.40,Main-207-,,0,0,0,,Ahtapot!Dialogue: 50,0:09:04.40,0:09:06.28,Main-207-,,0,0,0,,Şerefsi...!Dialogue: 50,0:09:10.65,0:09:11.45,Main-207-,,0,0,0,,A-Ah...Dialogue: 50,0:09:11.82,0:09:14.41,Main-207-,,0,0,0,,N-N-Ne olu...?!Dialogue: 50,0:09:16.37,0:09:18.91,Main-207-,,0,0,0,,Hey, şuna bakın! Bu müthiş!Dialogue: 50,0:09:21.25,0:09:22.75,Main-207-,,0,0,0,,Bu şey de ne?!Dialogue: 50,0:09:22.75,0:09:24.09,Main-207-,,0,0,0,,Balon bu!Dialogue: 50,0:09:25.04,0:09:26.63,Main-207-,,0,0,0,,Çok eğlenceli!Dialogue: 50,0:09:26.63,0:09:27.71,Main-207-,,0,0,0,,Yavaşladık!Dialogue: 50,0:09:27.71,0:09:32.97,Main-207-,,0,0,0,,So... Sonunda öteki dünyaya gideceğimi sanmıştım.Dialogue: 50,0:10:00.25,0:10:06.17,Main-207-,,0,0,0,,Çalın! Kurtarıcılarımızı güzel bir şarkıyla uğurlayalım!Dialogue: 50,0:10:06.17,0:10:07.09,Main-207-,,0,0,0,,Heso!Dialogue: 50,0:10:09.59,0:10:13.09,Main-207-,,0,0,0,,Luffy! Tekrar buluşalım!Dialogue: 50,0:10:13.09,0:10:14.80,Main-207-,,0,0,0,,Yine gelin!Dialogue: 50,0:10:14.80,0:10:16.60,Main-207-,,0,0,0,,Teşekkür ederiz!Dialogue: 50,0:10:16.60,0:10:20.43,Main-207-,,0,0,0,,Mavi Deniz'e sağ salim geri dönün!Dialogue: 50,0:10:27.11,0:10:29.61,Narrator-207-,,0,0,0,,Başınızı kaldırıp göğe baktığınızda,Dialogue: 50,0:10:30.86,0:10:34.66,Narrator-207-,,0,0,0,,on bin metre yükseklikteki bu Tanrı Diyarı...Dialogue: 50,0:10:35.45,0:10:37.45,Narrator-207-,,0,0,0,,hakikat mi, yoksa bir düş mü?Dialogue: 50,0:10:38.12,0:10:41.04,Narrator-207-,,0,0,0,,Kulak kesilirseniz çanın sesini duyacaksınız.Dialogue: 50,0:10:41.04,0:10:43.96,Narrator-207-,,0,0,0,,Bugün çalacak. Yarın yine çalacak.Dialogue: 50,0:10:44.92,0:10:47.29,Narrator-207-,,0,0,0,,Gökte yankılanan çan sesi...Dialogue: 50,0:10:47.29,0:10:51.76,Narrator-207-,,0,0,0,,bu gezgin toprağın zaferini haykırıyor...Dialogue: 50,0:11:00.60,0:11:02.43,Main-207-,,0,0,0,,Çok iyi!Dialogue: 50,0:11:02.43,0:11:06.94,Main-207-,,0,0,0,,Evet! Bu harika hissettiriyor!Dialogue: 50,0:11:09.15,0:11:10.98,Main-207-,,0,0,0,,Keşfi bırakıyor musun?!Dialogue: 50,0:11:10.98,0:11:14.99,Main-207-,,0,0,0,,Mantıklı değil mi?! Altın Şehir, meğersem gökteymiş!Dialogue: 50,0:11:14.99,0:11:18.16,Main-207-,,0,0,0,,Denizin dibinde bir şey bulamayacağız.Dialogue: 50,0:11:18.16,0:11:20.16,Main-207-,,0,0,0,,Artık işimiz kalmadı.Dialogue: 50,0:11:20.16,0:11:22.49,Main-207-,,0,0,0,,Burada kalmanın bir anlamı yok.Dialogue: 50,0:11:23.20,0:11:24.08,Main-207-,,0,0,0,,Patron...Dialogue: 50,0:11:24.75,0:11:26.17,Main-207-,,0,0,0,,Patron...Dialogue: 50,0:11:26.17,0:11:33.84,Main-207-,,0,0,0,,Hayalim uğruna yıllarca yanımda olduğunuz için hepinize minnettarım.Dialogue: 50,0:11:33.84,0:11:35.30,Main-207-,,0,0,0,,Ne demek istiyorsun...?Dialogue: 50,0:11:35.30,0:11:37.64,Main-207-,,0,0,0,,Bir yabancıymışız gibi konuşma.Dialogue: 50,0:11:37.64,0:11:38.97,Main-207-,,0,0,0,,Pekâlâ, beyler!Dialogue: 50,0:11:41.89,0:11:44.85,Main-207-,,0,0,0,,Şimdi ne tür bir romantizmin peşinden gidelim?!Dialogue: 50,0:11:50.90,0:11:54.36,Main-207-,,0,0,0,,Peşinden her yere geliriz, patron!Dialogue: 50,0:11:58.28,0:12:03.29,Main-207-,,0,0,0,,Altın! Altın! Altın! Altın! Altın!Dialogue: 50,0:12:03.79,0:12:07.92,Main-207-,,0,0,0,,Nihayet zengin olduk! Ne alsak acaba?!Dialogue: 50,0:12:07.92,0:12:11.25,Main-207-,,0,0,0,,Kocaman bronz bir heykele ne dersiniz?!Dialogue: 50,0:12:11.25,0:12:14.59,Main-207-,,0,0,0,,Seni aptal! Neden altını bronzla takas edesin ki?!Dialogue: 50,0:12:14.59,0:12:16.84,Main-207-,,0,0,0,,Birkaç top almalıyız!Dialogue: 50,0:12:16.84,0:12:18.18,Main-207-,,0,0,0,,On tane alalım! On tane!Dialogue: 50,0:12:18.18,0:12:21.55,Main-207-,,0,0,0,,Nami-san! Kilitli bir buzdolabı istiyorum!Dialogue: 50,0:12:21.55,0:12:25.89,Main-207-,,0,0,0,,Saçmalama! Karnımız acıkınca ne yapacağız?! İtiraz ediyorum!Dialogue: 50,0:12:22.60,0:12:25.47,Main-207-,,0,0,0,,B... B... Bana kitap almanı istiyorum!Dialogue: 50,0:12:25.89,0:12:27.98,Main-207-,,0,0,0,,Bu yüzden istiyorum zaten, salak!Dialogue: 50,0:12:25.47,0:12:27.98,Main-207-,,0,0,0,,Diğer ülkelerdeki tıp kitaplarını okumak istiyorum!Dialogue: 50,0:12:27.98,0:12:30.06,Main-207-,,0,0,0,,Bir saniye durun, çocuklar!Dialogue: 50,0:12:30.73,0:12:34.23,Main-207-,,0,0,0,,Aşağıya varınca hazineyi paylaşırız, tamam mı?Dialogue: 50,0:12:34.23,0:12:35.90,Main-207-,,0,0,0,,Lütfen, bana biraz kitap al!Dialogue: 50,0:12:36.57,0:12:40.53,Main-207-,,0,0,0,,Parayı sağa sola savurursak en sonunda hepsini çöpe atmış oluruz.Dialogue: 50,0:12:49.62,0:12:52.00,Main-207-,,0,0,0,,Güneş tamamen battı.Dialogue: 50,0:12:52.00,0:12:53.59,Main-207-,,0,0,0,,Güzel bir manzara ama.Dialogue: 50,0:12:53.59,0:12:56.30,Main-207-,,0,0,0,,Evet, haklısın!Dialogue: 50,0:13:09.77,0:13:11.60,Main-207-,,0,0,0,,Soğuk...!Dialogue: 50,0:13:11.60,0:13:13.90,Main-207-,,0,0,0,,Nami-san! Robin-chan! İyi misiniz?Dialogue: 50,0:13:17.07,0:13:18.44,Main-207-,,0,0,0,,Ödüm patladı!Dialogue: 50,0:13:18.44,0:13:21.16,Main-207-,,0,0,0,,Ahtapot aniden söndü!Dialogue: 50,0:13:21.16,0:13:22.82,Main-207-,,0,0,0,,Sanırım havası tükendi.Dialogue: 50,0:13:22.82,0:13:24.49,Main-207-,,0,0,0,,Ne oldu öyle?!Dialogue: 50,0:13:27.24,0:13:30.33,Main-207-,,0,0,0,,Ama bir şekilde aşağıya indik... ölmeden.Dialogue: 50,0:13:30.33,0:13:32.04,Main-207-,,0,0,0,,Çok teşekkür ederiz!Dialogue: 50,0:13:32.46,0:13:33.83,Main-207-,,0,0,0,,Yine de...Dialogue: 50,0:13:38.88,0:13:41.38,Main-207-,,0,0,0,,inanılmaz bir yere gittik, değil mi?Dialogue: 50,0:13:41.38,0:13:44.43,Main-207-,,0,0,0,,İndikten sonra kesinlikle öyle görünüyor.Dialogue: 50,0:13:44.43,0:13:46.47,Main-207-,,0,0,0,,Sanki bir rüya gibiydi.Dialogue: 50,0:13:46.85,0:13:49.98,Main-207-,,0,0,0,,Bir rüya ülkesi. Acaba bir gün tekrar görür müyüz?Dialogue: 50,0:13:50.31,0:13:52.69,Main-207-,,0,0,0,,Belki ölünce... ya da daha yakın bir yere.Dialogue: 50,0:13:53.02,0:13:55.86,Main-207-,,0,0,0,,Zoro, cennete gideceğinden emin misin?Dialogue: 50,0:13:55.86,0:13:57.61,Main-207-,,0,0,0,,Kapa' çeneni!Dialogue: 50,0:13:57.61,0:14:00.28,Main-207-,,0,0,0,,Şimdilik her şey sakin görünüyor.Dialogue: 50,0:14:00.28,0:14:01.86,Main-207-,,0,0,0,,Kahve falan yapacağım.Dialogue: 50,0:14:01.86,0:14:03.99,Main-207-,,0,0,0,,Ben yemek istiyorum, Sanji!Dialogue: 50,0:14:03.99,0:14:07.37,Main-207-,,0,0,0,,Evet, evet, ilgileniyorum. Bir kahve iç ve az sabırlı ol.Dialogue: 50,0:14:10.79,0:14:13.29,Main-207-,,0,0,0,,Bu korsan ganimeti, o yüzden eşit bölüşeceğiz!Dialogue: 50,0:14:14.38,0:14:16.00,Main-207-,,0,0,0,,Hepimiz alacak mıyız?!Dialogue: 50,0:14:16.00,0:14:16.92,Main-207-,,0,0,0,,Elbette.Dialogue: 50,0:14:16.92,0:14:18.38,Main-207-,,0,0,0,,Sonunda be!Dialogue: 50,0:14:18.38,0:14:21.01,Main-207-,,0,0,0,,Bronz heykel alacağım!Dialogue: 50,0:14:21.01,0:14:22.93,Main-207-,,0,0,0,,Evet! Kitap alabilir miyim?!Dialogue: 50,0:14:23.55,0:14:28.06,Main-207-,,0,0,0,,Yeni bir tencere, tavalar, kap kacak ve dev fare kapanları...Dialogue: 50,0:14:28.06,0:14:30.56,Main-207-,,0,0,0,,Geriye bir sürü param da kalıyor!Dialogue: 50,0:14:30.56,0:14:32.39,Main-207-,,0,0,0,,Kendimi içkiye boğacağım!Dialogue: 50,0:14:32.73,0:14:35.35,Main-207-,,0,0,0,,Öncelikle, yüzde 80'i zulama gidiyor!Dialogue: 50,0:14:35.94,0:14:37.15,Main-207-,,0,0,0,,– Dur bir saniye! – Dur bir saniye!Dialogue: 50,0:14:37.15,0:14:39.07,Main-207-,,0,0,0,,Şaka yaptım be.Dialogue: 50,0:14:39.07,0:14:43.11,Main-207-,,0,0,0,,Bi' zahmet! Herkesin bildiği gizli bir zula olmaz!Dialogue: 50,0:14:43.11,0:14:49.08,Main-207-,,0,0,0,,"Zula"dan kastım, geminin onarım fonu!Dialogue: 50,0:14:49.08,0:14:52.12,Main-207-,,0,0,0,,Gemi mi? Merry'yi mi kastediyorsun?Dialogue: 50,0:14:52.12,0:14:56.29,Main-207-,,0,0,0,,Evet, Going Merry bizi buralara kadar getirdi.Dialogue: 50,0:14:56.29,0:14:57.84,Main-207-,,0,0,0,,Sahi düşününce,Dialogue: 50,0:14:57.84,0:15:04.01,Main-207-,,0,0,0,,Doğu Mavi'deki köyümden beri, hep bizi taşıdı.Dialogue: 50,0:15:04.01,0:15:07.43,Main-207-,,0,0,0,,Bize çok yardımcı oldu ama epey hırpalandı.Dialogue: 50,0:15:07.43,0:15:10.89,Main-207-,,0,0,0,,Harika fikir! Going Merry'nin Büyük Restorasyonu!Dialogue: 50,0:15:10.89,0:15:12.68,Main-207-,,0,0,0,,Kesinlikle katılıyorum!Dialogue: 50,0:15:12.68,0:15:14.23,Main-207-,,0,0,0,,Hadi, afiyet olsun.Dialogue: 50,0:15:15.48,0:15:19.36,Main-207-,,0,0,0,,Sanırım, Usopp'un boktan onarım işleri fazla dayanmayacak.Dialogue: 50,0:15:19.36,0:15:22.07,Main-207-,,0,0,0,,Hey, ben keskin nişancıyım, tamirci değil!Dialogue: 50,0:15:22.07,0:15:28.66,Main-207-,,0,0,0,,Evet. Gemiyi tersaneye götürüp uzman bir marangozdan yardım almalıyız.Dialogue: 50,0:15:29.95,0:15:32.41,Main-207-,,0,0,0,,Yani, Usopp'tan iyi tamirciler mi var?Dialogue: 50,0:15:32.66,0:15:35.04,Main-207-,,0,0,0,,Onu düzenli olarak onarmamız gerek,Dialogue: 50,0:15:35.04,0:15:36.67,Main-207-,,0,0,0,,yoksa ileride pişman oluruz!Dialogue: 50,0:15:36.67,0:15:38.00,Main-207-,,0,0,0,,Tamam, karar verdim!Dialogue: 50,0:15:38.58,0:15:40.71,Main-207-,,0,0,0,,Tayfamıza bir gemi marangozu katacağız!Dialogue: 50,0:15:41.59,0:15:43.88,Main-207-,,0,0,0,,Daha gidecek çok yolumuz var!Dialogue: 50,0:15:43.88,0:15:45.17,Main-207-,,0,0,0,,– Evet! – Evet!Dialogue: 50,0:15:45.17,0:15:47.47,Main-207-,,0,0,0,,Böyle birine ihtiyacımız olacak.Dialogue: 50,0:15:47.84,0:15:49.93,Main-207-,,0,0,0,,Merry bizim yuvamız!Dialogue: 50,0:15:50.35,0:15:51.39,Main-207-,,0,0,0,,Canımız!Dialogue: 50,0:15:51.97,0:15:55.27,Main-207-,,0,0,0,,Onu koruyacak bir gemi marangozu bulalım!Dialogue: 50,0:15:57.90,0:15:59.27,Main-207-,,0,0,0,,Yine yaptı...Dialogue: 50,0:15:59.27,0:16:03.28,Main-207-,,0,0,0,,Evet, nadiren de olsa bazen doğruyu söylüyor.Dialogue: 50,0:16:03.28,0:16:06.07,Main-207-,,0,0,0,,Bu harika olur! Yapalım!Dialogue: 50,0:16:06.65,0:16:08.03,Main-207-,,0,0,0,,Tamam, planımız bu!Dialogue: 50,0:16:08.03,0:16:10.53,Main-207-,,0,0,0,,Umarım iyi birini buluruz!Dialogue: 50,0:16:10.53,0:16:12.03,Main-207-,,0,0,0,,Bir de müzisyen!Dialogue: 50,0:16:12.03,0:16:13.49,Main-207-,,0,0,0,,Hayır, ona ihtiyacımız yok.Dialogue: 50,0:16:20.04,0:16:22.34,Main-207-,,0,0,0,,Bu gürültü de ne?!Dialogue: 50,0:16:22.34,0:16:23.71,Main-207-,,0,0,0,,Kaçın!Dialogue: 50,0:16:24.34,0:16:27.05,Main-207-,,0,0,0,,İtme! U-Uzak durmamız lazım!Dialogue: 50,0:16:27.05,0:16:28.01,Main-207-,,0,0,0,,Anlaşmazlık mı?!Dialogue: 50,0:16:41.19,0:16:42.31,Main-207-,,0,0,0,,Bellamy!Dialogue: 50,0:16:42.31,0:16:43.69,Main-207-,,0,0,0,,Sarquiss!Dialogue: 50,0:16:43.69,0:16:45.44,Main-207-,,0,0,0,,Lütfen! Durdurun onları!Dialogue: 50,0:16:46.15,0:16:51.24,Main-207-,,0,0,0,,Lütfen! Kes şunu! Bunu neden yapıyorsun?!Dialogue: 50,0:16:51.53,0:16:53.16,Main-207-,,0,0,0,,Neler oluyor?!Dialogue: 50,0:16:53.16,0:16:55.33,Main-207-,,0,0,0,,Durması için yalvaran Sarquiss mi?Dialogue: 50,0:16:55.33,0:16:59.04,Main-207-,,0,0,0,,Neden mi? Birde soruyor musunuz?Dialogue: 50,0:16:59.04,0:17:02.13,Main-207-,,0,0,0,,Sarquiss... Bellamy...Dialogue: 50,0:17:03.79,0:17:07.76,Main-207-,,0,0,0,,Sembolümü rezil ettiğiniz için elbette.Dialogue: 50,0:17:10.84,0:17:13.72,Main-207-,,0,0,0,,"Gökyüzü adası var mı, yok mu?"Dialogue: 50,0:17:14.10,0:17:17.56,Main-207-,,0,0,0,,"Altın Şehir hayal mi, gerçek mi?"Dialogue: 50,0:17:19.69,0:17:22.44,Main-207-,,0,0,0,,Hiçbiri önemli değil.Dialogue: 50,0:17:23.11,0:17:26.40,Main-207-,,0,0,0,,"İnançları çarpıştır, puslu zihinlere hükmet."Dialogue: 50,0:17:27.19,0:17:28.82,Main-207-,,0,0,0,,Tam da bunu demiştim...Dialogue: 50,0:17:28.82,0:17:30.86,Main-207-,,0,0,0,,değil mi, Bellamy?Dialogue: 50,0:17:32.16,0:17:35.45,Main-207-,,0,0,0,,O... Donquixote Doflamingo!Dialogue: 50,0:17:35.45,0:17:38.08,Main-207-,,0,0,0,,Shichibukai!Dialogue: 50,0:17:38.08,0:17:40.71,Main-207-,,0,0,0,,Kelle ödülü 300 milyonun üzerinde!Dialogue: 50,0:17:40.71,0:17:42.75,Main-207-,,0,0,0,,Burada ne arıyor?!Dialogue: 50,0:17:42.75,0:17:47.88,Main-207-,,0,0,0,,Emrimde sizin gibi beceriksiz adamları istemem...Dialogue: 50,0:17:48.63,0:17:51.05,Main-207-,,0,0,0,,Kahretsin! Bedenimi kontrol edemiyorum!Dialogue: 50,0:17:51.05,0:17:54.09,Main-207-,,0,0,0,,Dur! Lütfen, yapma...!Dialogue: 50,0:17:54.51,0:17:56.93,Main-207-,,0,0,0,,Hayır!Dialogue: 50,0:18:00.60,0:18:01.60,Main-207-,,0,0,0,,Bellamy!Dialogue: 50,0:18:05.27,0:18:08.11,Main-207-,,0,0,0,,B-Bana...Dialogue: 50,0:18:08.86,0:18:11.99,Main-207-,,0,0,0,,Bana bir şans daha verin...!Dialogue: 50,0:18:12.65,0:18:16.62,Main-207-,,0,0,0,,Biz... sadık takipçilerin olacağız!Dialogue: 50,0:18:16.62,0:18:17.83,Main-207-,,0,0,0,,Bellamy!Dialogue: 50,0:18:17.83,0:18:19.45,Main-207-,,0,0,0,,Yeter artık, Bellamy!Dialogue: 50,0:18:21.62,0:18:25.58,Main-207-,,0,0,0,,Kaybettim ama asla ilkelerine karşı gelmedim!Dialogue: 50,0:18:25.58,0:18:27.21,Main-207-,,0,0,0,,Sembolün üstüne yemin ederim!Dialogue: 50,0:18:27.21,0:18:29.88,Main-207-,,0,0,0,,Sadece meseleleri böyle çözüyorum!Dialogue: 50,0:18:29.88,0:18:32.42,Main-207-,,0,0,0,,Gitmesine izin veremezdik!Dialogue: 50,0:18:32.42,0:18:35.59,Main-207-,,0,0,0,,Bir gün seni yakalayacaktı!Dialogue: 50,0:18:36.80,0:18:40.14,Main-207-,,0,0,0,,Ne kadar da dokunaklı, benim sadık astım.Dialogue: 50,0:18:40.47,0:18:45.02,Main-207-,,0,0,0,,Bellamy, sevdiğim yönün de bu işte.Dialogue: 50,0:18:47.52,0:18:51.94,Main-207-,,0,0,0,,Yeni çağ kapımıza dayanmak üzere. İstediğini yap.Dialogue: 50,0:18:53.24,0:18:56.53,Main-207-,,0,0,0,,Ama... Artık sana ihtiyacım yok.Dialogue: 50,0:18:59.41,0:19:02.33,Main-207-,,0,0,0,,Doflamingo!Dialogue: 50,0:19:08.13,0:19:11.55,Main-207-,,0,0,0,,55 milyon değerinde, ünlü bir çaylağı saf dışı bıraktı!Dialogue: 50,0:19:11.55,0:19:13.30,Main-207-,,0,0,0,,Onun için çocuk oyuncağıydı!Dialogue: 50,0:19:15.01,0:19:16.89,Main-207-,,0,0,0,,Nihayet başlıyor!Dialogue: 50,0:19:16.89,0:19:19.30,Main-207-,,0,0,0,,Hazırlansanız iyi olur!Dialogue: 50,0:19:19.30,0:19:23.18,Main-207-,,0,0,0,,Sadece gerçek korsanların hayatta kalabileceği bir dünya yaklaşıyor!Dialogue: 50,0:19:23.18,0:19:25.56,Main-207-,,0,0,0,,Güçsüz olanlar, fırsatınız varken kaçın.Dialogue: 50,0:19:25.56,0:19:27.56,Main-207-,,0,0,0,,Eşsiz güçlerin olduğu yeni çağ,Dialogue: 50,0:19:27.56,0:19:31.07,Main-207-,,0,0,0,,durdurulamaz bir dalga gibi üzerimize geliyor!Dialogue: 0,0:01:50.09,0:01:56.05,Title-207-,,0,0,0,,FinalDialogue: 1,0:01:50.09,0:01:56.05,Title-207-,,0,0,0,,FinalDialogue: 1,0:05:44.12,0:05:50.91,Captions-207-,,0,0,0,,Skypiea'nın Aşağısı, Beyaz DenizDialogue: 1,0:05:44.12,0:05:50.91,Captions-207-,,0,0,0,,Skypiea'nın Aşağısı, Beyaz DenizDialogue: 0,0:05:44.12,0:05:50.91,Captions-207-,,0,0,0,,Skypiea'nın Aşağısı, Beyaz DenizDialogue: 0,0:00:46.23,0:00:50.41,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 0,0:00:46.23,0:00:50.41,Credits-207-,,0,0,0,,fedew ZenefDialogue: 