0,0,0,0,0,100,100,0,0,1,1.9,1.9,2,180,180,27,1Style: RogerMonologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1Style: Karaoke,Duality,68,&H00292CC7,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,4,0,1,6.8,0,8,23,23,23,1Style: Translation,Duality,68,&H00292CC7,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,4,0,1,6.8,0,2,23,23,34,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:49.92,0:01:59.91,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 50,0:01:51.22,0:01:52.88,Main-207-,,0,0,0,,Baroque Works mü?Dialogue: 50,0:01:53.34,0:01:54.89,Main-207-,,0,0,0,,Hiç duymadım.Dialogue: 50,0:01:54.89,0:01:57.47,Main-207-,,0,0,0,,Var olduğuna dair herhangi bir kanıtınız var mı?Dialogue: 50,0:01:57.47,0:02:00.89,Main-207-,,0,0,0,,Bizler mütevazı vatandaşlarız, Sayın Denizci.Dialogue: 50,0:02:01.39,0:02:04.10,Main-207-,,0,0,0,,Bu karmaşada dürüst insanlara zarar mı vereceksiniz?!Dialogue: 50,0:02:07.98,0:02:08.98,Main-207-,,0,0,0,,Başçavuş Tashigi!Dialogue: 50,0:02:09.57,0:02:11.40,Main-207-,,0,0,0,,Niye tereddüt ediyorsunuz?!Dialogue: 50,0:02:12.74,0:02:15.87,Main-207-,,0,0,0,,Kanıt için beklerseniz, hiçbir şeyi engelleyemezsiniz!Dialogue: 50,0:02:15.87,0:02:17.58,Main-207-,,0,0,0,,Düşmanı tespit etmek sizin işiniz!Dialogue: 50,0:02:18.03,0:02:20.16,Main-207-,,0,0,0,,Başüstüne! Özür dileriz!Dialogue: 50,0:02:20.75,0:02:22.46,Thoughts-207-,,0,0,0,,Neredeyse 16:30...Dialogue: 50,0:02:22.46,0:02:23.92,Thoughts-207-,,0,0,0,,Zamanımız tükeniyor...Dialogue: 50,0:02:26.50,0:02:27.75,Main-207-,,0,0,0,,Saat...!Dialogue: 50,0:02:28.80,0:02:30.63,Main-207-,,0,0,0,,Vırak, vırak, vırak, vırak...Dialogue: 50,0:02:30.63,0:02:32.76,Main-207-,,0,0,0,,Hey, şunu dinle, Bay 7.Dialogue: 50,0:02:32.76,0:02:35.89,Main-207-,,0,0,0,,Bu epey önemli bir görev!Dialogue: 50,0:02:35.89,0:02:39.35,Main-207-,,0,0,0,,Haklısın, Bayan Father's Day.Dialogue: 50,0:02:39.35,0:02:44.56,Main-207-,,0,0,0,,Sanırım bu işten sonra büyük bir terfi alabiliriz! Vırak, vırak.Dialogue: 50,0:02:46.81,0:02:48.90,Main-207-,,0,0,0,,Umarım öyle olur.Dialogue: 50,0:02:48.90,0:02:52.61,Main-207-,,0,0,0,,Umarım. Umarım, Bayan Father's Day.Dialogue: 50,0:02:52.61,0:02:56.16,Main-207-,,0,0,0,,Tüm yapmamız gereken bu topu kalabalığa nişan almak ve...Dialogue: 50,0:02:56.16,0:03:01.16,Main-207-,,0,0,0,,sonra ateşlemek!Dialogue: 50,0:03:01.16,0:03:01.99,Main-207-,,0,0,0,,Umarım!Dialogue: 50,0:03:06.46,0:03:09.42,Main-207-,,0,0,0,,Vırak! Zaman geldi, Bay 7!Dialogue: 50,0:03:10.17,0:03:13.21,Main-207-,,0,0,0,,Hazır ve nazır!Dialogue: 50,0:03:27.85,0:03:28.98,Main-207-,,0,0,0,,Tam olarak,Dialogue: 50,0:03:29.73,0:03:33.74,Main-207-,,0,0,0,,neyi anlamıyorum?Dialogue: 50,0:03:42.54,0:03:44.41,Main-207-,,0,0,0,,Lastik-Lastik...Dialogue: 50,0:03:44.83,0:03:46.62,Main-207-,,0,0,0,,Mitralyöz!Dialogue: 50,0:03:54.76,0:03:56.42,Main-207-,,0,0,0,,Kafan basmıyor mu?Dialogue: 50,0:03:56.42,0:04:02.56,Main-207-,,0,0,0,,O yarandaki zehir seni her an devirebilir.Dialogue: 50,0:04:04.64,0:04:07.73,Main-207-,,0,0,0,,Bedenin şu anda uyuşuyor olmalı.Dialogue: 50,0:04:09.19,0:04:12.36,Main-207-,,0,0,0,,Bu düellonun sonucu ne olursa olsun,Dialogue: 50,0:04:12.36,0:04:15.65,Main-207-,,0,0,0,,sonunda bu tapınağın altında gömülü kalacaksın.Dialogue: 50,0:04:15.65,0:04:18.20,Main-207-,,0,0,0,,Patlamaya 15 saniye...Dialogue: 50,0:04:20.36,0:04:23.28,Main-207-,,0,0,0,,Hedefimiz meydanın ortası!Dialogue: 50,0:04:23.28,0:04:24.33,Main-207-,,0,0,0,,Vırak, vırak.Dialogue: 50,0:04:24.33,0:04:26.12,Main-207-,,0,0,0,,Ateşle!Dialogue: 50,0:04:27.58,0:04:30.46,Main-207-,,0,0,0,,Hey, Nami! Ne planlıyorsun?!Dialogue: 50,0:04:30.96,0:04:32.71,Main-207-,,0,0,0,,Bunun için vaktimiz yok!Dialogue: 50,0:04:32.71,0:04:35.17,Main-207-,,0,0,0,,Batırırsak, öldük!Dialogue: 50,0:04:35.17,0:04:36.17,Main-207-,,0,0,0,,Hey!Dialogue: 50,0:04:36.17,0:04:40.80,Main-207-,,0,0,0,,Biliyorum! Sadece kıpırdama!  Bazı hesaplamalar yapıyorum!Dialogue: 50,0:04:41.30,0:04:44.06,Main-207-,,0,0,0,,Kıpırdama mı?! Niye böyle durduğumuzu bile bilmiyorum!Dialogue: 50,0:04:44.06,0:04:46.64,Main-207-,,0,0,0,,Ne yapacaksın?!Dialogue: 50,0:04:46.64,0:04:48.18,Main-207-,,0,0,0,,Yapınca göreceksin!Dialogue: 50,0:04:48.68,0:04:49.94,Main-207-,,0,0,0,,Hazır mısınız?!Dialogue: 50,0:04:49.94,0:04:51.81,Main-207-,,0,0,0,,Vırak, vırak, vırak, vırak...Dialogue: 50,0:04:51.81,0:04:54.52,Main-207-,,0,0,0,,Hey, dinle, Bay 7!Dialogue: 50,0:04:54.52,0:04:57.04,Main-207-,,0,0,0,,Bu özel bir an! Geri sayım yapmalıyız!Dialogue: 50,0:04:57.57,0:05:01.57,Main-207-,,0,0,0,,Planın bu mu? Harika! Harika! Kulağa eğlenceli geliyor!Dialogue: 50,0:05:02.62,0:05:05.12,Main-207-,,0,0,0,,Tayfun için uyarı!Dialogue: 50,0:05:05.12,0:05:08.58,Main-207-,,0,0,0,,– Patlamaya 13 saniye kaldı! – Patlamaya 13 saniye kaldı!Dialogue: 50,0:05:10.25,0:05:13.21,Main-207-,,0,0,0,,Siklon Tempo!Dialogue: 50,0:05:13.21,0:05:18.76,Main-207-,,0,0,0,,H-Hey! Siklon Tempo sadece partiler için bumerang oyunu!Dialogue: 50,0:05:19.13,0:05:20.72,Main-207-,,0,0,0,,Hedef saat kulesi!Dialogue: 50,0:05:35.31,0:05:37.44,Main-207-,,0,0,0,,Ne...? Uçuyorlar.Dialogue: 50,0:05:38.07,0:05:41.40,Main-207-,,0,0,0,,Chopper! Sanji-kun'a doğru zıpla!Dialogue: 50,0:05:41.40,0:05:42.36,Main-207-,,0,0,0,,– Ne?! – Ne?!Dialogue: 50,0:05:42.36,0:05:43.66,Main-207-,,0,0,0,,Yoksa...Dialogue: 50,0:05:43.66,0:05:47.33,Main-207-,,0,0,0,,plan, oraya kadar uçmak mı?!Dialogue: 50,0:05:47.33,0:05:49.89,Main-207-,,0,0,0,,Sanji-kun, ne yapacağını biliyorsun, değil mi?Dialogue: 50,0:05:49.89,0:05:51.25,Main-207-,,0,0,0,,Fazla vaktimiz yok!Dialogue: 50,0:05:51.25,0:05:53.33,Main-207-,,0,0,0,,Sanırım fikri anladım, ama...Dialogue: 50,0:05:53.33,0:05:55.88,Main-207-,,0,0,0,,Ah, neyse! Hemen girişmeliyim!Dialogue: 50,0:05:56.29,0:05:58.25,Main-207-,,0,0,0,,Bunu düşünecek zamanımız yok!Dialogue: 50,0:05:58.25,0:05:59.67,Main-207-,,0,0,0,,Sana güveniyorum, Tony-kun!Dialogue: 50,0:05:59.67,0:06:02.34,Main-207-,,0,0,0,,Tamam! Sıkı tutun, Vivi!Dialogue: 50,0:06:04.09,0:06:06.10,Main-207-,,0,0,0,,Anlıyorum... Demek plan bu.Dialogue: 50,0:06:06.10,0:06:08.47,Main-207-,,0,0,0,,Chopper! Sağ bacağıma zıpla!Dialogue: 50,0:06:08.47,0:06:09.89,Main-207-,,0,0,0,,Tamam!Dialogue: 50,0:06:10.39,0:06:11.60,Main-207-,,0,0,0,,– 12! – 12!Dialogue: 50,0:06:13.60,0:06:15.65,Main-207-,,0,0,0,,İşte geliyorlar, Zoro!Dialogue: 50,0:06:15.65,0:06:17.15,Main-207-,,0,0,0,,Tamam! Aferin!Dialogue: 50,0:06:19.73,0:06:21.86,Main-207-,,0,0,0,,Sadece onları tepeye ulaştırmam lazım, ha?!Dialogue: 50,0:06:21.86,0:06:23.49,Main-207-,,0,0,0,,– 10! – 10!Dialogue: 50,0:06:23.49,0:06:24.91,Main-207-,,0,0,0,,Zoro!Dialogue: 50,0:06:25.28,0:06:26.78,Main-207-,,0,0,0,,Tamam, bana bırakın!Dialogue: 50,0:06:27.37,0:06:28.33,Main-207-,,0,0,0,,Kılıçla mı?!Dialogue: 50,0:06:28.33,0:06:30.79,Main-207-,,0,0,0,,Aptal, korkma! Ters yüzlerini kullanacağım!Dialogue: 50,0:06:30.79,0:06:31.87,Main-207-,,0,0,0,,Sağlam dur!Dialogue: 50,0:06:31.87,0:06:32.87,Main-207-,,0,0,0,,Tamam!Dialogue: 50,0:06:32.87,0:06:34.17,Main-207-,,0,0,0,,– 9! – 9!Dialogue: 50,0:06:34.17,0:06:36.54,Main-207-,,0,0,0,,Dikkatli ol, Vivi! Orada gerçekten tuhaf tipler var!Dialogue: 50,0:06:36.54,0:06:38.13,Main-207-,,0,0,0,,Evet, onları tanıyorum!Dialogue: 50,0:06:39.80,0:06:40.42,Main-207-,,0,0,0,,Hayır!Dialogue: 50,0:06:41.88,0:06:43.51,Main-207-,,0,0,0,,Bayan Wednesday!Dialogue: 50,0:06:43.51,0:06:48.39,Main-207-,,0,0,0,,Vırak, vırak, vırak! Onu hatırlıyorum! Örgüte ihanet etti!Dialogue: 50,0:06:48.76,0:06:50.56,Main-207-,,0,0,0,,Hay aksi, fark edildiler!Dialogue: 50,0:06:50.56,0:06:51.35,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:06:51.85,0:06:54.39,Main-207-,,0,0,0,,Durun! Havadayız!Dialogue: 50,0:06:54.39,0:06:56.35,Main-207-,,0,0,0,,Bize ateş ederlerse...!Dialogue: 50,0:06:57.61,0:07:00.73,Main-207-,,0,0,0,,Bu ülkede sizin için değerli hiçbir şey olmadığına eminim!Dialogue: 50,0:07:01.32,0:07:02.74,Main-207-,,0,0,0,,Yanılıyor muyum?Dialogue: 50,0:07:02.74,0:07:04.82,Main-207-,,0,0,0,,Başka biri için dövüşüyorsun!Dialogue: 50,0:07:05.45,0:07:07.28,Main-207-,,0,0,0,,Niye bunun için ölesin?!Dialogue: 50,0:07:08.12,0:07:12.66,Main-207-,,0,0,0,,Sadece bir, iki arkadaş. Onları boş verip kendini bu zor durumdan kurtar!Dialogue: 50,0:07:13.29,0:07:16.54,Main-207-,,0,0,0,,Tam bir aptallar topluluğusunuz.Dialogue: 50,0:07:18.54,0:07:22.51,Main-207-,,0,0,0,,Dediğim gibi, hiçbir şey anlamıyorsun.Dialogue: 50,0:07:22.88,0:07:24.01,Main-207-,,0,0,0,,Vivi,Dialogue: 50,0:07:27.26,0:07:30.14,Main-207-,,0,0,0,,insanlara hayatlarını feda etmemelerini söylüyor.Dialogue: 50,0:07:30.14,0:07:33.72,Main-207-,,0,0,0,,Ama hep başkalarını kurtarmak için hayatını tehlikeye atıyor.Dialogue: 50,0:07:34.27,0:07:36.48,Main-207-,,0,0,0,,Ona yardım etmezsek, öldürülecek.Dialogue: 50,0:07:36.48,0:07:37.73,Main-207-,,0,0,0,,Sizin tafınızdan.Dialogue: 50,0:07:37.73,0:07:39.90,Main-207-,,0,0,0,,Seni anlamıyorum!Dialogue: 50,0:07:40.23,0:07:44.32,Main-207-,,0,0,0,,Bu yüzden öyle sinir bozucu birini terk–Dialogue: 50,0:07:45.11,0:07:47.70,Main-207-,,0,0,0,,Ölmesini istemiyorum!Dialogue: 50,0:07:47.70,0:07:49.87,Main-207-,,0,0,0,,Biz arkadaşız!!!Dialogue: 50,0:07:50.45,0:07:53.62,Main-207-,,0,0,0,,Bu yüzden ülkesinden vazgeçmedikçe,Dialogue: 50,0:07:54.25,0:07:57.58,Main-207-,,0,0,0,,dövüşmeyi bırakmayacağız!Dialogue: 50,0:07:58.00,0:08:00.92,Main-207-,,0,0,0,,Ölsen bile mi?Dialogue: 50,0:08:01.42,0:08:04.17,Main-207-,,0,0,0,,Ölürsek, ölürüz.Dialogue: 50,0:08:04.88,0:08:07.26,Main-207-,,0,0,0,,Hazır! Vırak-Vırak Silahı!Dialogue: 50,0:08:07.26,0:08:08.84,Main-207-,,0,0,0,,Sürpriz bir gelişme bu!Dialogue: 50,0:08:09.22,0:08:11.68,Main-207-,,0,0,0,,Hazır! Yeşil Silah!Dialogue: 50,0:08:12.72,0:08:15.64,Main-207-,,0,0,0,,Güzel! Güzel! Hedef halindeler!Dialogue: 50,0:08:15.64,0:08:19.65,Main-207-,,0,0,0,,Şerefsiz! Ne cüretle Vivi-chan'a silah doğrultuyorsunuz?!Dialogue: 50,0:08:19.65,0:08:22.02,Main-207-,,0,0,0,,Bu kötü! Onlar keskin nişancı çifti!Dialogue: 50,0:08:22.02,0:08:22.82,Main-207-,,0,0,0,,Chopper!Dialogue: 50,0:08:22.82,0:08:24.44,Main-207-,,0,0,0,,Seni yukarı fırlatacağım!Dialogue: 50,0:08:24.44,0:08:27.07,Main-207-,,0,0,0,,Yönü değiştireceğim ama gerisi sana kalıyor!Dialogue: 50,0:08:27.07,0:08:28.49,Main-207-,,0,0,0,,Ha? Ben mi?!Dialogue: 50,0:08:28.49,0:08:30.07,Main-207-,,0,0,0,,7 saniye kaldı!Dialogue: 50,0:08:30.07,0:08:32.45,Main-207-,,0,0,0,,Bir şey yapın!Dialogue: 50,0:08:34.74,0:08:37.71,Main-207-,,0,0,0,,Hazır mısınız?! Yapalım şunu, Chopper, Vivi!Dialogue: 50,0:08:37.71,0:08:38.91,Main-207-,,0,0,0,,Tamam!Dialogue: 50,0:08:40.00,0:08:41.13,Main-207-,,0,0,0,,Hazır...!Dialogue: 50,0:08:41.13,0:08:41.79,Main-207-,,0,0,0,,Vur!Dialogue: 50,0:08:43.04,0:08:44.17,Main-207-,,0,0,0,,Hadi!Dialogue: 50,0:08:44.17,0:08:45.55,Main-207-,,0,0,0,,Hey, şunu dinle!Dialogue: 50,0:08:45.55,0:08:47.26,Main-207-,,0,0,0,,Mermilerimiz...Dialogue: 50,0:08:48.05,0:08:50.72,Main-207-,,0,0,0,,çarpıştıklarında patlıyorlar!Dialogue: 50,0:08:54.10,0:08:55.43,Main-207-,,0,0,0,,Zoro!Dialogue: 50,0:08:59.77,0:09:00.85,Main-207-,,0,0,0,,O aptal!Dialogue: 50,0:09:01.23,0:09:02.52,Main-207-,,0,0,0,,Direkt vuruldu!Dialogue: 50,0:09:03.23,0:09:04.69,Main-207-,,0,0,0,,Hazır mısın, Vivi?!Dialogue: 50,0:09:04.69,0:09:07.40,Main-207-,,0,0,0,,Lütfen, elinden geleni yap, Tony-kun!Dialogue: 50,0:09:10.95,0:09:12.74,Main-207-,,0,0,0,,Vırak, vırak. Atlatmak...Dialogue: 50,0:09:12.74,0:09:13.82,Main-207-,,0,0,0,,faydasız!Dialogue: 50,0:09:13.82,0:09:15.12,Main-207-,,0,0,0,,– Vur! – Vur!Dialogue: 50,0:09:16.04,0:09:16.79,Main-207-,,0,0,0,,– Kim...?! – Kim...?!Dialogue: 50,0:09:18.20,0:09:19.08,Main-207-,,0,0,0,,– Ne...?! – Ne...?!Dialogue: 50,0:09:25.80,0:09:27.59,Main-207-,,0,0,0,,Bayan Wednesday, nerede?!Dialogue: 50,0:09:27.59,0:09:29.59,Main-207-,,0,0,0,,Ne oldu?!Dialogue: 50,0:09:31.59,0:09:35.01,Main-207-,,0,0,0,,Geri Gelen...Dialogue: 50,0:09:35.51,0:09:36.72,Main-207-,,0,0,0,,Tepemizde!Dialogue: 50,0:09:39.39,0:09:44.19,Main-207-,,0,0,0,,– Hadi! – Hadi!Dialogue: 50,0:09:49.11,0:09:54.24,Main-207-,,0,0,0,,İstediğini söyleyebilirsin ama hareket etmen zorlaşıyor değil mi?Dialogue: 50,0:09:55.74,0:09:58.20,Main-207-,,0,0,0,,Hak ettiğini buldun, Hasır Şapka.Dialogue: 50,0:10:02.16,0:10:03.33,Main-207-,,0,0,0,,...Tavus...Dialogue: 50,0:10:08.59,0:10:10.34,Main-207-,,0,0,0,,Vırak, vırak! Çok yazık.Dialogue: 50,0:10:10.88,0:10:11.63,Main-207-,,0,0,0,,Iskaladın!Dialogue: 50,0:10:17.43,0:10:19.31,Main-207-,,0,0,0,,Zincir Kesici!Dialogue: 50,0:10:22.94,0:10:24.19,Main-207-,,0,0,0,,Çok iyi!Dialogue: 50,0:10:47.33,0:10:49.67,Flashbacks-207-,,0,0,0,,– Vivi! – Vivi!Dialogue: 50,0:10:49.67,0:10:51.88,Flashbacks-207-,,0,0,0,,Hey, veletler!Dialogue: 50,0:10:52.26,0:10:54.51,Flashbacks-207-,,0,0,0,,Yine o gizli geçitten girdiniz, değil mi?!Dialogue: 50,0:10:54.51,0:10:56.34,Flashbacks-207-,,0,0,0,,Koruma! Kaçın!Dialogue: 50,0:10:57.01,0:11:01.35,Flashbacks-207-,,0,0,0,,Chaka-sama, Pell-sama! Lütfen o çocuklara bir şey söyleyin!Dialogue: 50,0:11:02.81,0:11:03.60,Flashbacks-207-,,0,0,0,,Olur.Dialogue: 50,0:11:04.81,0:11:07.06,Flashbacks-207-,,0,0,0,,Vivi-sama, çıkıyor musunuz?Dialogue: 50,0:11:07.48,0:11:09.19,Flashbacks-207-,,0,0,0,,Evet! Gizli üssümüze!Dialogue: 50,0:11:09.19,0:11:11.23,Flashbacks-207-,,0,0,0,,Tamam, eğlenmenize bakın.Dialogue: 50,0:11:13.90,0:11:15.36,Flashbacks-207-,,0,0,0,,Vivi-sama, nereye gitti?Dialogue: 50,0:11:17.03,0:11:18.28,Flashbacks-207-,,0,0,0,,Söyleyemem.Dialogue: 50,0:11:18.28,0:11:19.41,Flashbacks-207-,,0,0,0,,Bu bir sır.Dialogue: 50,0:11:22.29,0:11:23.45,Flashbacks-207-,,0,0,0,,Saat kulesine, ha?Dialogue: 50,0:11:54.69,0:11:56.24,Main-207-,,0,0,0,,Durdurdu mu?Dialogue: 50,0:12:22.22,0:12:24.18,Main-207-,,0,0,0,,Nasıl? Hâlâ yaşıyor musun?Dialogue: 50,0:12:25.06,0:12:27.64,Main-207-,,0,0,0,,B-Bombaya ne oldu?Dialogue: 50,0:12:29.10,0:12:30.69,Main-207-,,0,0,0,,Üzerime ne düştü?Dialogue: 50,0:12:29.60,0:12:32.61,Main-207-,,0,0,0,,Ah!Dialogue: 50,0:12:36.61,0:12:38.11,Main-207-,,0,0,0,,Ne oldu?Dialogue: 50,0:12:38.11,0:12:40.11,Main-207-,,0,0,0,,Yukarıda tuhaf şeyler oluyor.Dialogue: 50,0:12:40.11,0:12:42.07,Main-207-,,0,0,0,,Vivi gözükmüyor.Dialogue: 50,0:12:45.08,0:12:46.66,Main-207-,,0,0,0,,Yardım edin, millet!Dialogue: 50,0:12:47.04,0:12:48.16,Main-207-,,0,0,0,,Vivi!Dialogue: 50,0:12:48.54,0:12:52.08,Main-207-,,0,0,0,,Bombanın zamanlayıcısı var! Yine de patlayacak!Dialogue: 50,0:12:53.34,0:12:56.51,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:12:58.34,0:13:01.30,Main-207-,,0,0,0,,Kalleş iblis!Dialogue: 50,0:13:03.43,0:13:09.18,Main-207-,,0,0,0,,En azından "ihtiyatlı" diyebilirdin, Bay Cobra.Dialogue: 50,0:13:09.18,0:13:13.69,Main-207-,,0,0,0,,Plan yaparken her ihtimali düşünmelisin.Dialogue: 50,0:13:15.52,0:13:18.78,Main-207-,,0,0,0,,Bombacı etkisiz hâle gelse bile,Dialogue: 50,0:13:18.78,0:13:21.78,Main-207-,,0,0,0,,bombayı kendi kendine patlayacak şekilde ayarladım.Dialogue: 50,0:13:21.78,0:13:25.49,Main-207-,,0,0,0,,Evet, sadece birkaç saniye farkedecek.Dialogue: 50,0:13:26.37,0:13:30.16,Main-207-,,0,0,0,,Meydanın merkezine ateşlemeyi umuyordum...Dialogue: 50,0:13:30.16,0:13:35.17,Main-207-,,0,0,0,,ama her hâlükârda hasar muazzam olacak.Dialogue: 50,0:13:41.55,0:13:44.39,Flashbacks-207-,,0,0,0,,"Bunu yaparsam, isyanı durdurabilirim."Dialogue: 50,0:13:45.22,0:13:48.35,Flashbacks-207-,,0,0,0,,"Şunu yaparsam, isyanı durdurabilirim."Dialogue: 50,0:13:49.68,0:13:54.31,Flashbacks-207-,,0,0,0,,Ateşli idealizmin midemi bulandırıyor.Dialogue: 50,0:13:58.73,0:14:00.61,Flashbacks-207-,,0,0,0,,Yine söyleyeceğim.Dialogue: 50,0:14:06.24,0:14:09.41,Flashbacks-207-,,0,0,0,,Bu ülkeyi kurtaramazsın.Dialogue: 50,0:14:12.62,0:14:14.75,Main-207-,,0,0,0,,Kahretsin! Bu olabilir mi?!Dialogue: 50,0:14:14.75,0:14:17.00,Main-207-,,0,0,0,,Ateşlemeyi durdurmuş olsak da bombanın...Dialogue: 50,0:14:17.59,0:14:19.13,Main-207-,,0,0,0,,zamanlayıcısı mı var?Dialogue: 50,0:14:19.76,0:14:23.01,Main-207-,,0,0,0,,Patlama beş kilometre çapında olacak.Dialogue: 50,0:14:23.01,0:14:25.59,Main-207-,,0,0,0,,Meydan ve şehir tamamen yok olacak!Dialogue: 50,0:14:27.81,0:14:30.60,Main-207-,,0,0,0,,Şimdi ne yapacağız?!Dialogue: 50,0:14:30.60,0:14:35.10,Main-207-,,0,0,0,,Yani patlamayı durdurma şansımız hiç yok muydu?!Dialogue: 50,0:14:37.65,0:14:40.23,Main-207-,,0,0,0,,Bize bombayı arattırdı!Dialogue: 50,0:14:40.78,0:14:43.45,Main-207-,,0,0,0,,Ne zaman ateşleyeceğini bile söyledi!Dialogue: 50,0:14:43.45,0:14:44.86,Main-207-,,0,0,0,,Bizi...Dialogue: 50,0:14:49.45,0:14:53.75,Main-207-,,0,0,0,,aptal yerine koymak için daha ne kadar ileri gidecek?!Dialogue: 50,0:14:55.29,0:14:59.63,Main-207-,,0,0,0,,Bizimle daha ne kadar alay edecek?!Dialogue: 50,0:15:02.30,0:15:05.55,Main-207-,,0,0,0,,Crocodile!Dialogue: 50,0:15:15.77,0:15:17.15,Flashbacks-207-,,0,0,0,,Bu yüzden...Dialogue: 50,0:15:17.56,0:15:19.52,Flashbacks-207-,,0,0,0,,ülkesinden vazgeçmedikçe,Dialogue: 50,0:15:20.61,0:15:23.57,Flashbacks-207-,,0,0,0,,dövüşmeyi bırakmayacağız!Dialogue: 50,0:15:42.00,0:15:43.51,Main-207-,,0,0,0,,Sen...Dialogue: 50,0:15:43.51,0:15:44.80,Main-207-,,0,0,0,,beni...Dialogue: 50,0:15:48.89,0:15:50.60,Main-207-,,0,0,0,,yenemezsin!Dialogue: 50,0:15:52.39,0:15:55.93,Main-207-,,0,0,0,,Tüm söyleyebildiğin bu sözler mi?Dialogue: 50,0:15:58.19,0:16:04.57,Main-207-,,0,0,0,,Ölüm döşeğinde olan bir kaybeden için uygun son sözler.Dialogue: 50,0:16:04.57,0:16:06.11,Main-207-,,0,0,0,,Sadece laftan ibaretsin!Dialogue: 50,0:16:09.87,0:16:13.45,Main-207-,,0,0,0,,Ben, Korsanlar Kralı olacağım!Dialogue: 50,0:16:13.95,0:16:15.70,Main-207-,,0,0,0,,Dinle, velet.Dialogue: 50,0:16:15.70,0:16:18.46,Main-207-,,0,0,0,,Denizi daha fazla tanıdıkça,Dialogue: 50,0:16:18.46,0:16:22.42,Main-207-,,0,0,0,,böyle küstahça beyanatlarda bulunmamayı öğreneceksin.Dialogue: 50,0:16:24.30,0:16:25.92,Main-207-,,0,0,0,,Daha önce de söylemiştim.Dialogue: 50,0:16:26.55,0:16:31.14,Main-207-,,0,0,0,,Denizde senin gibi bir sürü çaylak var!Dialogue: 50,0:16:34.62,0:16:37.60,Main-207-,,0,0,0,,Ama denizi ne kadar iyi bilirsen,Dialogue: 50,0:16:38.52,0:16:41.81,Main-207-,,0,0,0,,böyle hayaller o kadar imkânsız gelir!Dialogue: 50,0:16:58.00,0:16:59.08,Main-207-,,0,0,0,,Ben,Dialogue: 50,0:16:59.67,0:17:02.17,Main-207-,,0,0,0,,seni yenecek adamım!Dialogue: 50,0:17:04.34,0:17:05.84,Main-207-,,0,0,0,,O...?Dialogue: 50,0:17:05.84,0:17:07.51,Main-207-,,0,0,0,,Kuş adam.Dialogue: 50,0:17:12.64,0:17:13.43,Main-207-,,0,0,0,,Pell!Dialogue: 50,0:17:14.97,0:17:17.18,Main-207-,,0,0,0,,Anılarım canlandı...Dialogue: 50,0:17:17.18,0:17:19.81,Main-207-,,0,0,0,,Kum Kum Klanı'nın gizli üssü.Dialogue: 50,0:17:19.81,0:17:21.19,Secondary-207-,,0,0,0,,Pell, dinle!Dialogue: 50,0:17:21.19,0:17:25.23,Secondary-207-,,0,0,0,,Bombanın zamanlayıcısı var ve her an patlayabilir!Dialogue: 50,0:17:21.19,0:17:27.90,Main-207-,,0,0,0,,Eskiden hep bizi zor duruma sokacak tuhaf şeyler yapardınız.Dialogue: 50,0:17:29.11,0:17:31.91,Flashbacks-207-,,0,0,0,,Vivi-sama! Cephanelikte ne yapıyordun?!Dialogue: 50,0:17:34.16,0:17:35.66,Flashbacks-207-,,0,0,0,,Hey, ne oldu?!Dialogue: 50,0:17:35.66,0:17:37.33,Flashbacks-207-,,0,0,0,,O patlama da neydi?!Dialogue: 50,0:17:40.04,0:17:44.84,Flashbacks-207-,,0,0,0,,Size cephanelikten uzak durmanızı defalarca söyledik!Dialogue: 50,0:17:45.67,0:17:46.55,Flashbacks-207-,,0,0,0,,Pell!Dialogue: 50,0:17:46.92,0:17:48.21,Flashbacks-207-,,0,0,0,,Pell-sama!Dialogue: 50,0:17:49.46,0:17:52.97,Flashbacks-207-,,0,0,0,,Havai fişek yapmaya çalışırken çuvalladım.Dialogue: 50,0:17:52.97,0:17:56.22,Flashbacks-207-,,0,0,0,,Bugün senin muhafız olmanın yıl dönümü––Dialogue: 50,0:17:58.06,0:17:59.60,Flashbacks-207-,,0,0,0,,Ne yapıyorsunuz?!Dialogue: 50,0:17:59.60,0:18:02.02,Flashbacks-207-,,0,0,0,,Size kaç kez söyledim...Dialogue: 50,0:18:02.02,0:18:03.90,Flashbacks-207-,,0,0,0,,bu yere asla girmeyin diye?!Dialogue: 50,0:18:06.02,0:18:09.40,Flashbacks-207-,,0,0,0,,Seni pislik! Ne yaptığın hakkında bir fikrin var mı?!Dialogue: 50,0:18:09.40,0:18:11.53,Flashbacks-207-,,0,0,0,,Seni kovacağım! Ne cüretle–Dialogue: 50,0:18:11.53,0:18:12.57,Flashbacks-207-,,0,0,0,,Bekle, Igaram!Dialogue: 50,0:18:13.95,0:18:15.28,Flashbacks-207-,,0,0,0,,Hey, hey...Dialogue: 50,0:18:18.66,0:18:20.41,Flashbacks-207-,,0,0,0,,Size bir şey olsaydı,Dialogue: 50,0:18:22.58,0:18:23.92,Flashbacks-207-,,0,0,0,,ben ne yapardım?Dialogue: 50,0:18:30.55,0:18:31.80,Flashbacks-207-,,0,0,0,,Daha fazla!Dialogue: 50,0:18:31.80,0:18:33.18,Flashbacks-207-,,0,0,0,,Daha yükseğe!Dialogue: 50,0:18:33.18,0:18:34.89,Flashbacks-207-,,0,0,0,,Daha yükseğe dedim!Dialogue: 50,0:18:35.64,0:18:39.81,Flashbacks-207-,,0,0,0,,Vivi-sama! Bunu majestelerinden gizli tutmalısınız, tamam mı?Dialogue: 50,0:18:42.81,0:18:48.07,Flashbacks-207-,,0,0,0,,Majesteleri özellikle sizi sırtımda uçurmamamı söyledi.Dialogue: 50,0:18:48.07,0:18:49.32,Flashbacks-207-,,0,0,0,,O zaman yapmasaydın!Dialogue: 50,0:18:49.32,0:18:51.65,Flashbacks-207-,,0,0,0,,Öbür türlü seni asla affetmezdim!Dialogue: 50,0:18:53.65,0:18:57.41,Flashbacks-207-,,0,0,0,,Ayrıca ne istersem yapacağını söyleyen sendin.Dialogue: 50,0:19:03.62,0:19:04.87,Flashbacks-207-,,0,0,0,,Hey, Pell.Dialogue: 50,0:19:04.87,0:19:05.67,Flashbacks-207-,,0,0,0,,Evet?Dialogue: 50,0:19:05.67,0:19:08.25,Flashbacks-207-,,0,0,0,,Niye sürekli savaş için eğitim görüyorsunuz?Dialogue: 50,0:19:08.25,0:19:09.63,Flashbacks-207-,,0,0,0,,Çünkü ben korumayım.Dialogue: 50,0:19:09.63,0:19:11.63,Flashbacks-207-,,0,0,0,,Bu ülkeyi korumak benim görevim.Dialogue: 50,0:19:11.63,0:19:13.59,Flashbacks-207-,,0,0,0,,Güçlü olmalıyım.Dialogue: 50,0:19:13.59,0:19:15.38,Flashbacks-207-,,0,0,0,,Kiminle dövüşeceksin?Dialogue: 50,0:19:15.38,0:19:16.34,Flashbacks-207-,,0,0,0,,Bilmiyorum...Dialogue: 50,0:19:18.05,0:19:20.97,Flashbacks-207-,,0,0,0,,Dövüşmekten çok korumakla ilgili.Dialogue: 50,0:19:21.85,0:19:23.31,Flashbacks-207-,,0,0,0,,Birbirinden farklı mı?Dialogue: 50,0:19:23.93,0:19:25.56,Flashbacks-207-,,0,0,0,,Amaçları farklı.Dialogue: 50,0:19:28.02,0:19:29.40,Flashbacks-207-,,0,0,0,,Çok tuhaf.Dialogue: 50,0:19:34.24,0:19:38.45,Main-207-,,0,0,0,,Vivi-sama, size ve Nefertari ailesine hizmet etmek,Dialogue: 50,0:19:39.49,0:19:41.79,Main-207-,,0,0,0,,hayatımın en büyük gururuydu.Dialogue: 50,0:20:05.89,0:20:06.64,Thoughts-207-,,0,0,0,,Ben...Dialogue: 50,0:20:07.31,0:20:08.69,Thoughts-207-,,0,0,0,,Alabasta'nın koruyucu meleği,Dialogue: 50,0:20:16.19,0:20:17.86,Thoughts-207-,,0,0,0,,doğanım!Dialogue: 50,0:20:39.30,0:20:40.68,Thoughts-207-,,0,0,0,,Kraliyet ailesinin...Dialogue: 50,0:20:41.30,0:20:43.05,Thoughts-207-,,0,0,0,,düşmanlarını yok eden kişi!Dialogue: 50,0:21:31.27,0:21:32.40,Main-207-,,0,0,0,,Lanet olası...Dialogue: 50,0:21:36.11,0:21:37.61,Main-207-,,0,0,0,,O...Dialogue: 50,0:21:37.61,0:21:39.44,Main-207-,,0,0,0,,tüm ülkeyi korudu…Dialogue: 50,0:21:59.13,0:21:59.97,Main-207-,,0,0,0,,Hey...Dialogue: 50,0:22:01.47,0:22:02.93,Main-207-,,0,0,0,,Bu gerçek olamaz...Dialogue: 50,0:22:09.02,0:22:10.06,Main-207-,,0,0,0,,Dur...Dialogue: 50,0:22:11.18,0:22:12.64,Main-207-,,0,0,0,,Lütfen durun...!Dialogue: 50,0:22:12.64,0:22:13.73,Main-207-,,0,0,0,,Başçavuş, dikkat!Dialogue: 50,0:22:22.49,0:22:23.41,Main-207-,,0,0,0,,Nasıl...?Dialogue: 50,0:22:26.32,0:22:27.24,Flashbacks-207-,,0,0,0,,Tashigi...Dialogue: 50,0:22:28.45,0:22:31.66,Flashbacks-207-,,0,0,0,,Bu ülkeye ne olduğunu dikkatlice izle.Dialogue: 50,0:22:32.66,0:22:37.13,Flashbacks-207-,,0,0,0,,Yaşananlar, yeni bir çağın kapılarını açacak.Dialogue: 50,0:22:54.77,0:22:56.06,Main-207-,,0,0,0,,Delilik...Dialogue: 50,0:22:57.27,0:22:58.57,Main-207-,,0,0,0,,Niye...Dialogue: 50,0:22:58.57,0:22:59.86,Main-207-,,0,0,0,,durmuyorlar?Dialogue: 50,0:23:01.11,0:23:02.57,Main-207-,,0,0,0,,Lütfen...Dialogue: 50,0:23:02.57,0:23:04.40,Main-207-,,0,0,0,,savaşmayı kesin!Dialogue: 50,0:23:05.07,0:23:07.07,Main-207-,,0,0,0,,Lütfen...Dialogue: 50,0:23:07.07,0:23:09.28,Main-207-,,0,0,0,,savaşmayı kesin!Dialogue: 50,0:23:09.28,0:23:10.54,Main-207-,,0,0,0,,Lütfen...Dialogue: 50,0:23:11.08,0:23:13.37,Main-207-,,0,0,0,,savaşmayı kesin!Dialogue: 50,0:23:13.37,0:23:15.08,Main-207-,,0,0,0,,Lütfen...Dialogue: 50,0:23:15.08,0:23:17.17,Main-207-,,0,0,0,,savaşmayı kesin!Dialogue: 50,0:23:17.17,0:23:19.04,Main-207-,,0,0,0,,Lütfen...Dialogue: 50,0:23:19.04,0:23:21.17,Main-207-,,0,0,0,,savaşmayı kesin!Dialogue: 50,0:23:21.80,0:23:23.67,Main-207-,,0,0,0,,Lütfen...Dialogue: 50,0:23:23.67,0:23:25.80,Main-207-,,0,0,0,,savaşmayı kesin!Dialogue: 50,0:23:26.30,0:23:28.14,Main-207-,,0,0,0,,Lütfen...Dialogue: 50,0:23:28.14,0:23:30.35,Main-207-,,0,0,0,,savaşmayı kesin!Dialogue: 50,0:23:31.14,0:23:31.93,Main-207-,,0,0,0,,Vivi...Dialogue: 50,0:23:31.14,0:23:32.60,Main-207-,,0,0,0,,Lütfen...Dialogue: 50,0:23:33.14,0:23:35.56,Main-207-,,0,0,0,,savaşmayı kesin!Dialogue: 50,0:23:35.56,0:23:39.40,Main-207-,,0,0,0,,Lütfen... savaşmayı kesin!Dialogue: 50,0:23:40.32,0:23:44.15,Main-207-,,0,0,0,,Lütfen... savaşmayı kesin!Dialogue: 50,0:23:44.90,0:23:46.53,Main-207-,,0,0,0,,Lütfen...Dialogue: 50,0:23:46.91,0:23:48.82,Main-207-,,0,0,0,,durun!Dialogue: 50,0:23:49.53,0:23:52.91,Main-207-,,0,0,0,,Lütfen... savaşmayı kesin!Dialogue: 50,0:23:52.91,0:23:55.00,Main-207-,,0,0,0,,Lütfen...Dialogue: 50,0:23:55.00,0:23:56.46,Main-207-,,0,0,0,,savaşmayı kesin!Dialogue: 50,0:23:55.00,0:23:56.46,Main-207-,,0,0,0,,Seni ahmak...Dialogue: 50,0:23:57.04,0:23:59.79,Main-207-,,0,0,0,,Siz! Ne diye dikilip duruyorsunuz?!Dialogue: 50,0:23:59.79,0:24:02.46,Main-207-,,0,0,0,,Ne yapıyorsanız yapın ama şu isyanı durdurun!Dialogue: 50,0:24:02.46,0:24:03.84,Main-207-,,0,0,0,,Çabuk olun, gidin!Dialogue: 50,0:24:03.84,0:24:05.09,Main-207-,,0,0,0,,Ah!Dialogue: 50,0:24:05.47,0:24:08.59,Main-207-,,0,0,0,,Mümkün olduğu kadar hayat kurtarın!Dialogue: 50,0:24:08.59,0:24:10.47,Main-207-,,0,0,0,,Lütfen...Dialogue: 50,0:24:10.47,0:24:13.06,Main-207-,,0,0,0,,savaşmayı kesin!Dialogue: 50,0:24:13.06,0:24:14.85,Main-207-,,0,0,0,,Lütfen...Dialogue: 50,0:24:14.85,0:24:16.35,Main-207-,,0,0,0,,savaşmayı kesin!Dialogue: 50,0:24:16.73,0:24:18.23,Main-207-,,0,0,0,,Lütfen...Dialogue: 50,0:24:18.23,0:24:19.81,Main-207-,,0,0,0,,savaşmayı kesin!Dialogue: 50,0:24:20.19,0:24:21.62,Main-207-,,0,0,0,,Lütfen...Dialogue: 50,0:24:21.62,0:24:23.27,Main-207-,,0,0,0,,savaşmayı kesin!Dialogue: 50,0:24:23.27,0:24:25.15,Main-207-,,0,0,0,,Lütfen...Dialogue: 50,0:24:25.15,0:24:26.86,Main-207-,,0,0,0,,savaşmayı kesin!Dialogue: 50,0:25:18.04,0:25:20.04,Thoughts-207-,,0,0,0,,Akrep zehri...Dialogue: 50,0:25:20.04,0:25:22.71,Thoughts-207-,,0,0,0,,etkisini göstermiş olmalıydı.Dialogue: 50,0:25:24.00,0:25:25.71,Thoughts-207-,,0,0,0,,Bu velet, o kadar gücü...Dialogue: 50,0:25:26.59,0:25:28.59,Thoughts-207-,,0,0,0,,nereden buluyor?Dialogue: 50,0:25:35.89,0:25:38.43,Flashbacks-207-,,0,0,0,,Bay 5 çifti yenildi mi dedin?Dialogue: 50,0:25:39.14,0:25:41.73,Flashbacks-207-,,0,0,0,,Onları kim yenebilir?Dialogue: 50,0:25:42.27,0:25:44.31,Flashbacks-207-,,0,0,0,,Monkey D. Luffy mi?Dialogue: 50,0:25:44.31,0:25:45.61,Flashbacks-207-,,0,0,0,,Hiç duymadım.Dialogue: 50,0:25:47.19,0:25:48.86,Flashbacks-207-,,0,0,0,,Yanılıyor olmalısın.Dialogue: 50,0:25:49.99,0:25:52.53,Flashbacks-207-,,0,0,0,,Hâlâ hayatta olduklarını mı söylüyorsun?!Dialogue: 50,0:25:52.99,0:25:55.41,Flashbacks-207-,,0,0,0,,O korsanlar buradalar…Dialogue: 50,0:25:59.62,0:26:03.00,Main-207-,,0,0,0,,Sen adı sanı duyulmamış önemsiz veledin tekisin!Dialogue: 50,0:26:03.67,0:26:05.13,Main-207-,,0,0,0,,Benim...Dialogue: 50,0:26:05.13,0:26:07.80,Main-207-,,0,0,0,,kim olduğumu sanıyorsun?!Dialogue: 50,0:26:09.67,0:26:12.30,Main-207-,,0,0,0,,Kim olduğun umurumda değil!Dialogue: 50,0:26:13.30,0:26:16.76,Main-207-,,0,0,0,,Seni geçeceğim!Dialogue: 50,0:26:32.74,0:26:37.20,Main-207-,,0,0,0,,Bu kutsal tapınakla birlikte seni de yok edeceğim!Dialogue: 50,0:26:37.66,0:26:39.70,Main-207-,,0,0,0,,Güçlü...!Dialogue: 50,0:26:43.25,0:26:44.71,Main-207-,,0,0,0,,Kum Fırtınası!Dialogue: 50,0:27:06.44,0:27:09.82,Main-207-,,0,0,0,,Lastik-Lastik...Dialogue: 50,0:27:10.69,0:27:12.40,Main-207-,,0,0,0,,Çöl...Dialogue: 50,0:27:13.53,0:27:15.95,Main-207-,,0,0,0,,...Fırtına!Dialogue: 50,0:27:14.95,0:27:17.53,Main-207-,,0,0,0,,...Kılıcı!Dialogue: 50,0:28:28.10,0:28:29.60,Main-207-,,0,0,0,,İnanılmaz...Dialogue: 50,0:28:29.60,0:28:33.19,Main-207-,,0,0,0,,Burasıyla yüzey arasında katman katman ana kaya var.Dialogue: 50,0:28:43.95,0:28:45.91,Main-207-,,0,0,0,,Hey, bakın! Yukarıda!Dialogue: 50,0:28:55.38,0:28:57.63,Main-207-,,0,0,0,,– Crocodile mı?! – Crocodile mı?!Dialogue: 50,0:29:15.90,0:29:20.91,Flashbacks-207-,,0,0,0,,Bir şey yapmazsam, krallık kanlı bir savaşın içine çekilecek.Dialogue: 50,0:29:21.45,0:29:24.78,Flashbacks-207-,,0,0,0,,Sağ salim eve dönmek yetmez!Dialogue: 50,0:29:24.78,0:29:26.37,Flashbacks-207-,,0,0,0,,Zamanında da yetişmeliyim!Dialogue: 50,0:29:26.95,0:29:31.87,Flashbacks-207-,,0,0,0,,Bir anlık gecikme, bir milyon insanın akılsızca birbirini öldürmesiyle sonuçlanır!Dialogue: 50,0:29:41.63,0:29:42.76,Flashbacks-207-,,0,0,0,,Pekâlâ!Dialogue: 50,0:29:42.76,0:29:43.47,Flashbacks-207-,,0,0,0,,Yani...Dialogue: 50,0:29:44.22,0:29:45.47,Flashbacks-207-,,0,0,0,,tüm yapmam gereken...Dialogue: 50,0:29:46.47,0:29:48.35,Flashbacks-207-,,0,0,0,,Crocodile'ı yenmek, değil mi?Dialogue: 50,0:29:51.64,0:29:53.40,Thoughts-207-,,0,0,0,,Luffy-san...Dialogue: 50,0:29:59.94,0:30:04.32,Main-207-,,0,0,0,,Nereden uçtuğunu anlamadım ama...Dialogue: 50,0:30:04.32,0:30:05.33,Main-207-,,0,0,0,,Tabii ya!Dialogue: 50,0:30:05.70,0:30:09.25,Main-207-,,0,0,0,,Aklımda hiç şüphe yoktu.Dialogue: 50,0:30:09.25,0:30:11.21,Main-207-,,0,0,0,,Bunun tek bir anlamı olabilir...Dialogue: 50,0:30:11.21,0:30:14.67,Main-207-,,0,0,0,,– Kazandı! – Kazandı!Dialogue: 50,0:30:23.89,0:30:27.47,Main-207-,,0,0,0,,Düşmanımız çoktan yenilmişken....Dialogue: 50,0:30:34.10,0:30:35.94,Main-207-,,0,0,0,,daha fazla...Dialogue: 50,0:30:35.94,0:30:38.69,Main-207-,,0,0,0,,kan dökmeyin.Dialogue: 50,0:30:41.74,0:30:42.82,Main-207-,,0,0,0,,Lütfen...Dialogue: 50,0:30:43.57,0:30:46.74,Main-207-,,0,0,0,,savaşmayı kesin!!!Dialogue: 50,0:31:07.47,0:31:08.14,Main-207-,,0,0,0,,Koza!Dialogue: 50,0:31:08.64,0:31:10.14,Main-207-,,0,0,0,,İyi misin, Koza?Dialogue: 50,0:31:13.98,0:31:15.40,Main-207-,,0,0,0,,Hissediyor musun...?Dialogue: 50,0:31:28.53,0:31:31.49,Flashbacks-207-,,0,0,0,,Ondan şüphelenme, Koza.Dialogue: 50,0:31:37.42,0:31:39.75,Flashbacks-207-,,0,0,0,,Yağmur yağacak.Dialogue: 50,0:31:50.14,0:31:51.56,Main-207-,,0,0,0,,Savaş...Dialogue: 50,0:31:52.39,0:31:53.52,Main-207-,,0,0,0,,sona erecek!Dialogue: 50,0:31:58.52,0:31:59.56,Main-207-,,0,0,0,,Yağmur...Dialogue: 50,0:32:11.70,0:32:13.20,Thoughts-207-,,0,0,0,,Sakinleştiler.Dialogue: 50,0:32:14.37,0:32:15.66,Thoughts-207-,,0,0,0,,Tereddüt ediyorlar.Dialogue: 50,0:32:17.46,0:32:20.42,Main-207-,,0,0,0,,Yağmur havayı temizliyor...Dialogue: 50,0:32:30.51,0:32:32.01,Main-207-,,0,0,0,,Hey, çocuk!Dialogue: 50,0:32:33.76,0:32:36.10,Main-207-,,0,0,0,,Lütfen daha fazla...Dialogue: 50,0:32:36.64,0:32:43.69,Main-207-,,0,0,0,,savaşmayın!!!Dialogue: 50,0:32:46.90,0:32:48.78,Main-207-,,0,0,0,,Vivi'nin sesi...Dialogue: 50,0:32:48.78,0:32:50.07,Main-207-,,0,0,0,,onlara ulaşıyor.Dialogue: 50,0:32:55.70,0:32:57.46,Main-207-,,0,0,0,,Vivi-sama...Dialogue: 50,0:32:57.46,0:32:58.54,Main-207-,,0,0,0,,Bu Vivi-sama...Dialogue: 50,0:32:59.29,0:33:00.54,Main-207-,,0,0,0,,Vivi...Dialogue: 50,0:33:00.54,0:33:03.00,Main-207-,,0,0,0,,Burada olmadığını sanıyordum.Dialogue: 50,0:33:09.55,0:33:10.93,Main-207-,,0,0,0,,Crocodile-san?Dialogue: 50,0:33:11.47,0:33:14.76,Main-207-,,0,0,0,,Nasıl oldu da buraya düştü?Dialogue: 50,0:33:14.76,0:33:17.73,Main-207-,,0,0,0,,Crocodile-san mı dedin?!Dialogue: 50,0:33:18.23,0:33:21.23,Main-207-,,0,0,0,,Bu ülkeye ne yaptığıyla ilgili sana bir çift lafım var!Dialogue: 50,0:33:21.85,0:33:24.69,Main-207-,,0,0,0,,Dur biraz. Sakin ol.Dialogue: 50,0:33:36.79,0:33:39.08,Main-207-,,0,0,0,,Şu anda yağan yağmur,Dialogue: 50,0:33:39.08,0:33:42.50,Main-207-,,0,0,0,,eskisi gibi tekrar yağacak.Dialogue: 50,0:33:44.00,0:33:46.13,Main-207-,,0,0,0,,Kâbus...Dialogue: 50,0:33:46.13,0:33:47.76,Main-207-,,0,0,0,,nihayet sona erdi.Dialogue: 50,0:34:09.40,0:34:10.90,Main-207-,,0,0,0,,Teşekkürler.Dialogue: 50,0:34:19.83,0:34:21.54,Main-207-,,0,0,0,,Bir şey değil.Dialogue: 0,0:01:49.96,0:01:52.88,Title-207-,,0,0,0,,Seni GeçeceğimDialogue: 1,0:01:49.96,0:01:52.88,Title-207-,,0,0,0,,Seni GeçeceğimDialogue: 0,0:09:08.40,0:09:10.95,Captions-207-,,0,0,0,,Patlamaya 5 Saniye KaldıDialogue: 0,0:09:08.40,0:09:10.95,Captions-207-,,0,0,0,,Patlamaya 5 Saniye KaldıDialogue: 0,0:09:08.40,0:09:10.95,Captions-207-,,0,0,0,,Patlamaya 5 Saniye KaldıDialogue: 0,0:09:19.71,0:09:22.33,Captions-207-,,0,0,0,,Patlamaya 4 Saniye KaldıDialogue: 0,0:09:19.71,0:09:22.33,Captions-207-,,0,0,0,,Patlamaya 4 Saniye KaldıDialogue: 0,0:09:19.71,0:09:22.33,Captions-207-,,0,0,0,,Patlamaya 4 Saniye KaldıDialogue: 0,0:09:36.72,0:09:39.39,Captions-207-,,0,0,0,,Patlamaya 3 Saniye KaldıDialogue: 0,0:09:36.72,0:09:39.39,Captions-207-,,0,0,0,,Patlamaya 3 Saniye KaldıDialogue: 0,0:09:36.72,0:09:39.39,Captions-207-,,0,0,0,,Patlamaya 3 Saniye KaldıDialogue: 0,0:10:15.34,0:10:17.43,Captions-207-,,0,0,0,,Patlamaya 2 Saniye KaldıDialogue: 0,0:10:15.34,0:10:17.43,Captions-207-,,0,0,0,,Patlamaya 2 Saniye KaldıDialogue: 0,0:10:15.34,0:10:17.43,Captions-207-,,0,0,0,,Patlamaya 2 Saniye KaldıDialogue: 0,0:10:31.11,0:10:33.53,Captions-207-,,0,0,0,,Patlamaya 1 Saniye KaldıDialogue: 0,0:10:31.11,0:10:33.53,Captions-207-,,0,0,0,,Patlamaya 1 Saniye KaldıDialogue: 0,0:10:31.11,0:10:33.53,Captions-207-,,0,0,0,,Patlamaya 1 Saniye KaldıDialogue: 0,0:00:01.73,0:00:03.73,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 1,0:00:01.73,0:00:03.73,Credits-207-,,0,