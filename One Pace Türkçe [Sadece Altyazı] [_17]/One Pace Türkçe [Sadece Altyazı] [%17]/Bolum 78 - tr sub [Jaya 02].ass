,Credits-207-,,0,0,0,,Jack Cohle -onepacetr.net-Dialogue: 0,0:01:45.00,0:01:48.09,Credits-207-,,0,0,0,,Çevirmen [TR]Dialogue: 0,0:01:45.00,0:01:48.09,Credits-207-,,0,0,0,,Mantisentil -onepacetr.net-Dialogue: 0,0:00:06.90,0:00:10.48,Roger Monologue,,0,0,0,,Bir dünya... Evet!Dialogue: 0,0:00:10.48,0:00:16.53,Roger Monologue,,0,0,0,,Senin gibi özgürlüğü arayan biri için koca bir dünya tam gözlerinin önünde.Dialogue: 0,0:00:16.53,0:00:20.41,Roger Monologue,,0,0,0,,Sonu olmayan rüyaların peşinden gitmek istiyorsan,Dialogue: 0,0:00:20.41,0:00:25.17,Roger Monologue,,0,0,0,,inandıklarının bayrağını taşıyarak onların ötesine geç!Dialogue: 0,0:00:29.94,0:00:30.28,Karaoke,,0,0,0,fx,m 68 52 b 53 52 53 74 68 74 b 82 74 82 52 68 52 m 78 61 l 134 63 l 78 65 m 58 61 l 0 63 l 58 65 m 65 52 l 68 0 l 70 52 m 65 74 l 68 126 l 70 74Dialogue: 1,0:00:29.94,0:00:30.68,Karaoke,,0,0,0,fx,BoDialogue: 0,0:00:30.13,0:00:30.42,Karaoke,,0,0,0,fx,m 68 52 b 53 52 53 74 68 74 b 82 74 82 52 68 52 m 78 61 l 134 63 l 78 65 m 58 61 l 0 63 l 58 65 m 65 52 l 68 0 l 70 52 m 65 74 l 68 126 l 70 74Dialogue: 1,0:00:30.13,0:00:30.82,Karaoke,,0,0,0,fx,kuDialogue: 0,0:00:30.27,0:00:30.58,Karaoke,,0,0,0,fx,m 68 52 b 53 52 53 74 68 74 b 82 74 82 52 68 52 m 78 61 l 134 63 l 78 65 m 58 61 l 0 63 l 58 65 m 65 52 l 68 0 l 70 52 m 65 74 l 68 126 l 70 74Dialogue: 1,0:00:30.27,0:00:30.98,Karaoke,,0,0,0,fx,waDialogue: 0,0:00:30.43,0:00:30.71,Karaoke,,0,0,0,fx,m 68 52 b 53 52 53 74 68 74 b 82 74 82 52 68 52 m 78 61 l 134 63 l 78 65 m 58 61 l 0 63 l 58 65 m 65 52 l 68 0 l 70 52 m 65 74 l 68 126 l 70 74Dialogue: 1,0:00:30.43,0:00:31.11,Karaoke,,0,0,0,fx,iDialogue: 0,0:00:30.56,0:00:30.85,Karaoke,,0,0,0,fx,m 68 52 b 53 52 53 74 68 74 b 82 74 82 52 68 52 m 78 61 l 134 63 l 78 65 m 58 61 l 0 63 l 58 65 m 65 52 l 68 0 l 70 52 m 65 74 l 68 126 l 70 74Dialogue: 1,0:00:30.56,0:00:31.25,Karaoke,,0,0,0,fx,maDialogue: 0,0:00:30.70,0:00:31.16,Karaoke,,0,0,0,fx,m 68 52 b 53 52 53 74 68 74 b 82 74 82 52 68 52 m 78 61 l 134 63 l 78 65 m 5