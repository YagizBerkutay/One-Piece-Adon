00,0,0,1,0,0,2,15,15,15,1Style: Translation-furigana,Duality,52.5,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,2.25,0,2,15,15,15,1Style: Karaoke-furigana,Duality,52.5,&H009E375F,&H009E375F,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2.25,0,8,15,15,15,1Style: Karaoke,Duality,82,&H009E375F,&H009E375F,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,4.5,0,8,15,15,15,1Style: Translation,Duality,82,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,4.5,0,2,15,15,15,1Style: Sign-OP,Captain Redemption,375,&H0015181B,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0,0,2,15,15,15,1Style: Sign-Wano,KG Ten Thousand Reasons Alt,60,&H005B57D2,&H000000FF,&H00000000,&H00000000,-1,0,0,0,100,100,0,0,1,0,0,2,15,15,15,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:41.87,0:01:51.86,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 50,0:01:46.85,0:01:49.75,Main-207+,,0,0,0,,Pekâlâ çocuklar, derse geçelim.Dialogue: 50,0:01:49.75,0:01:53.09,Main-207+,,0,0,0,,Bugün Wano'nun tarihini işleyeceğiz!Dialogue: 50,0:01:53.09,0:01:54.72,Main-207+,,0,0,0,,– Peki öğretmenim! – Peki öğretmenim!Dialogue: 50,0:02:01.47,0:02:02.81,Main-207+,,0,0,0,,Peki öyleyse...Dialogue: 50,0:02:04.31,0:02:07.38,Main-207+,,0,0,0,,Sakoku nedir bakayım?Dialogue: 50,0:02:07.38,0:02:08.81,Main-207+,,0,0,0,,Ben!Dialogue: 50,0:02:08.81,0:02:12.94,Main-207+,,0,0,0,,Ülkenin huzurunu sağlamak için kapılarını dışarıya kapatmaktır!Dialogue: 50,0:02:12.94,0:02:14.07,Main-207+,,0,0,0,,Doğru!Dialogue: 50,0:02:14.07,0:02:15.77,Main-207+,,0,0,0,,Çocuk oyuncağı ya!Dialogue: 50,0:02:16.27,0:02:16.99,Main-207+,,0,0,0,,Peki...Dialogue: 50,0:02:16.99,0:02:19.96,Main-207+,,0,0,0,,kaikoku nedir?Dialogue: 50,0:02:19.96,0:02:20.48,Main-207+,,0,0,0,,Ben!Dialogue: 50,0:02:20.48,0:02:21.09,Main-207+,,0,0,0,,Ben!Dialogue: 50,0:02:21.09,0:02:22.91,Main-207+,,0,0,0,,Öğretmenim!Dialogue: 50,0:02:21.09,0:02:22.91,Secondary-207+,,0,0,0,,Ben, ben!Dialogue: 50,0:02:22.91,0:02:24.16,Main-207+,,0,0,0,,Söyle yavrum.Dialogue: 50,0:02:24.16,0:02:25.23,Main-207+,,0,0,0,,Tamam!Dialogue: 50,0:02:25.23,0:02:30.29,Main-207+,,0,0,0,,Kötü insanları ve fikirleri ülkeye sokacak çok yanlış bir harekettir!Dialogue: 50,0:02:31.91,0:02:36.38,Main-207+,,0,0,0,,Diğer ülkelerin Wano'daki birçok şeyde gözü var.Dialogue: 50,0:02:36.38,0:02:39.05,Main-207+,,0,0,0,,Aynen öyle, doğru!Dialogue: 50,0:02:40.13,0:02:41.80,Main-207+,,0,0,0,,Uzun zaman evvel...Dialogue: 50,0:02:42.89,0:02:46.99,Main-207+,,0,0,0,,bu kötülüğü yapmaya kalkışan dangalaklar da vardı.Dialogue: 50,0:02:49.52,0:02:53.44,Main-207+,,0,0,0,,– Oden ile Dokuz Kızıl Kın! – Oden ile Dokuz Kızıl Kın!Dialogue: 50,0:02:53.44,0:02:57.37,Main-207+,,0,0,0,,Durun bakalım, cevabını istemedim ki!Dialogue: 50,0:02:57.37,0:02:59.40,Main-207+,,0,0,0,,Dialogue: 50,0:02:59.40,0:03:02.77,Main-207+,,0,0,0,,– Aha, boynu yine uzuyor! – Aha, boynu yine uzuyor!Dialogue: 50,0:03:02.77,0:03:05.78,Main-207+,,0,0,0,,Kafanıza göre konuştunuz! Çok ayıp!Dialogue: 50,0:03:05.78,0:03:08.08,Main-207+,,0,0,0,,Neden cevap veremiyoruz ki?Dialogue: 50,0:03:08.08,0:03:11.62,Main-207+,,0,0,0,,Dokuz Kızıl Kın...Dialogue: 50,0:03:11.62,0:03:15.52,Main-207+,,0,0,0,,duymak dahi istemediğim bir isim de ondan.Dialogue: 50,0:03:16.65,0:03:20.46,Main-207+,,0,0,0,,Ama üzerinden 20 yıl geçti artık.Dialogue: 50,0:03:24.09,0:03:29.93,Main-207+,,0,0,0,,Bir de kötü samurayların hakkından gelen kahramanımız vardı tabii.Dialogue: 50,0:03:31.31,0:03:34.61,Main-207+,,0,0,0,,– Şogun, Kurozumi Orochi-sama! – Şogun, Kurozumi Orochi-sama!Dialogue: 50,0:03:34.61,0:03:36.28,Main-207+,,0,0,0,,Doğru!Dialogue: 50,0:03:36.28,0:03:38.18,Main-207+,,0,0,0,,Orochi İki Kılıç Stili!Dialogue: 50,0:03:38.18,0:03:42.32,Main-207+,,0,0,0,,Dokuz Kızıl Kın, kaçacak delik arayın! Canınıza okuyacağım!Dialogue: 50,0:03:45.93,0:03:48.76,Thoughts-207+,,0,0,0,,Çocuklara ne öğretiyorlar böyle?Dialogue: 50,0:03:48.76,0:03:51.83,Thoughts-207+,,0,0,0,,Külliyen yalan!Dialogue: 50,0:03:51.83,0:03:56.67,Main-207+,,0,0,0,,Şogun Orochi, Wano'yu kötülerin elinden kurtardı!Dialogue: 50,0:03:56.67,0:03:58.28,Main-207+,,0,0,0,,Kesinlikle.Dialogue: 50,0:03:58.89,0:04:00.05,Main-207+,,0,0,0,,20 yıl evvel...Dialogue: 50,0:04:01.22,0:04:03.93,Main-207+,,0,0,0,,kötülerin hepsi geberdi gitti.Dialogue: 50,0:04:03.93,0:04:07.01,Main-207+,,0,0,0,,Böylece Wano da...Dialogue: 50,0:04:07.01,0:04:10.81,Main-207+,,0,0,0,,şu anki huzuruna kavuştu!Dialogue: 50,0:04:15.78,0:04:19.07,Main-207+,,0,0,0,,Şogun Orochi ödleğin önde gideni!Dialogue: 50,0:04:19.07,0:04:23.05,Main-207+,,0,0,0,,K-K-Kyoshiro-dono! Neler diyorsunuz?Dialogue: 50,0:04:23.05,0:04:24.99,Main-207+,,0,0,0,,Sesinizi alçaltın lütfen!Dialogue: 50,0:04:25.45,0:04:28.78,Main-207+,,0,0,0,,Kes lan, andaval!Dialogue: 50,0:04:31.41,0:04:32.66,Main-207+,,0,0,0,,Tırsma lan!Dialogue: 50,0:04:32.66,0:04:37.03,Main-207+,,0,0,0,,Duyan duysun, gerçekleri söylüyoruz.Dialogue: 50,0:04:52.89,0:04:56.30,Main-207+,,0,0,0,,Sake! Kadehim boş kalmasın!Dialogue: 50,0:04:59.57,0:05:02.40,Thoughts-207+,,0,0,0,,Orochi ile bir bağlantısı mı var?Dialogue: 50,0:05:02.40,0:05:04.11,Thoughts-207+,,0,0,0,,"Uykucu" Kyoshiro'dan...Dialogue: 50,0:05:04.11,0:05:07.95,Thoughts-207+,,0,0,0,,önemli bilgiler öğrenebilirim belki.Dialogue: 50,0:05:09.67,0:05:11.37,Main-207+,,0,0,0,,20 yıl evvel...Dialogue: 50,0:05:11.37,0:05:13.88,Main-207+,,0,0,0,,alevler içindeki Oden Kalesi'nin önünde...Dialogue: 50,0:05:13.88,0:05:17.71,Main-207+,,0,0,0,,Oden'in hanımı son nefesini vermeden evvel şunları söyledi:Dialogue: 50,0:05:29.22,0:05:32.64,Main-207+,,0,0,0,,"Ey şafaktan bihaber olan Ay!Dialogue: 50,0:05:32.64,0:05:36.23,Main-207+,,0,0,0,,Dileğin kabul olsun...Dialogue: 50,0:05:36.23,0:05:41.98,Main-207+,,0,0,0,,ve yirmi yılı dokuyan o geceye dokuz gölge düşsün...Dialogue: 50,0:05:41.98,0:05:45.88,Main-207+,,0,0,0,,İşte o vakit, şafağın ihtişamına şahit olacaksın!"Dialogue: 50,0:05:54.25,0:05:59.63,Main-207+,,0,0,0,,Hatunun can havliyle zırvaladıklarını Orochi-sama'mız gitti de şöyle yorumladı!Dialogue: 50,0:06:09.72,0:06:11.47,Main-207+,,0,0,0,,Nasıl yorumladı?Dialogue: 50,0:06:12.76,0:06:16.18,Main-207+,,0,0,0,,Orochi-sama...Dialogue: 50,0:06:16.18,0:06:17.92,Main-207+,,0,0,0,,Evet!Dialogue: 50,0:06:27.13,0:06:29.23,Main-207+,,0,0,0,,Nasıl yorumladı be?Dialogue: 50,0:06:30.47,0:06:33.20,Main-207+,,0,0,0,,Sahi, şöyle anlamış bak.Dialogue: 50,0:06:35.49,0:06:38.12,Main-207+,,0,0,0,,"Üzerine lanet yağsın!"Dialogue: 50,0:06:38.12,0:06:39.67,Main-207+,,0,0,0,,Hayalet misali mi?Dialogue: 50,0:06:39.67,0:06:44.59,Main-207+,,0,0,0,,"İntikamlarını almak için dokuz samurayın hayaleti...Dialogue: 50,0:06:46.30,0:06:50.06,Main-207+,,0,0,0,,yirmi yıl sonra mehtaplı bir gecede belirecek ve...Dialogue: 50,0:06:50.06,0:06:51.22,Main-207+,,0,0,0,,canını alacak."Dialogue: 50,0:06:51.22,0:06:54.10,Main-207+,,0,0,0,,Orochi-sama'yı kastederek....Dialogue: 50,0:06:55.22,0:06:58.48,Main-207+,,0,0,0,,"Wano'nun kapılarını dünyaya açacaklar!" demiş güya!Dialogue: 50,0:06:59.44,0:07:03.03,Main-207+,,0,0,0,,Bu sene de yirminci yıla girdik!Dialogue: 50,0:07:05.65,0:07:09.49,Main-207+,,0,0,0,,Bu yüzden şogun Orochi fena tırsıyor!Dialogue: 50,0:07:09.49,0:07:15.63,Main-207+,,0,0,0,,Kozuki Hanesi'nin hayaletlerinin onu öldürmeye geleceğini sanıyor!Dialogue: 50,0:07:18.04,0:07:20.66,Main-207+,,0,0,0,,Onlarla kapışmak isterim!Dialogue: 50,0:07:25.42,0:07:27.46,Main-207+,,0,0,0,,Fakat cesetler ne halt yiyebilir ki?Dialogue: 50,0:07:31.89,0:07:34.97,Main-207+,,0,0,0,,Kozuki Hanesi samuraylarını...Dialogue: 50,0:07:34.97,0:07:39.73,Main-207+,,0,0,0,,20 yıl evvel kalede köşeye kıstırarak...Dialogue: 50,0:07:42.02,0:07:46.11,Main-207+,,0,0,0,,canlı canlı yaktık!Dialogue: 50,0:07:56.78,0:08:00.77,Main-207+,,0,0,0,,Zamanında burada Oden Kalesi vardı.Dialogue: 50,0:08:01.08,0:08:03.60,Main-207+,,0,0,0,,Esasen atfedilmiş bir isimden ibarettir.Dialogue: 50,0:08:03.60,0:08:06.35,Main-207+,,0,0,0,,Asıl ismi Kuri Kalesi idi!Dialogue: 50,0:08:06.35,0:08:11.22,Main-207+,,0,0,0,,Kuri halkı Oden-sama'yı öyle severdi ki kaleye böyle hitap etmeye başladı.Dialogue: 50,0:08:11.22,0:08:12.63,Main-207+,,0,0,0,,Momo'nun babası mı oluyor?Dialogue: 50,0:08:12.63,0:08:14.26,Main-207+,,0,0,0,,Aynen öyle!Dialogue: 50,0:08:14.78,0:08:19.17,Main-207+,,0,0,0,,Efendimiz Oden-sama, gözü pek biriydi.Dialogue: 50,0:08:19.98,0:08:26.62,Main-207+,,0,0,0,,Zamanın Wano şogunu Kozuki Sukiyaki-sama'nın oğlu olsa da...Dialogue: 50,0:08:26.62,0:08:30.43,Main-207+,,0,0,0,,özgür ruhlu, asabi bir karakterdi.Dialogue: 50,0:08:38.87,0:08:40.99,Main-207+,,0,0,0,,Defalarca mevzu çıkardığı için...Dialogue: 50,0:08:40.99,0:08:45.71,Main-207+,,0,0,0,,nihayetinde Çiçek Başkenti'nden sürüldü.Dialogue: 50,0:08:45.71,0:08:46.60,Main-207+,,0,0,0,,– Ne? – Ne?Dialogue: 50,0:08:46.60,0:08:47.58,Main-207+,,0,0,0,,Sürüldü mü?Dialogue: 50,0:08:48.45,0:08:51.17,Main-207+,,0,0,0,,Zira kanı kaynayan Oden-sama için...Dialogue: 50,0:08:51.17,0:08:55.23,Main-207+,,0,0,0,,Çiçek Başkenti heyecandan yoksun, küçücük bir yerdi.Dialogue: 50,0:09:02.65,0:09:03.77,Flashbacks-207+,,0,0,0,,Seni lanet..Dialogue: 50,0:09:03.77,0:09:04.81,Flashbacks-207+,,0,0,0,,Geber lan!Dialogue: 50,0:09:07.77,0:09:12.60,Narrator-207+,,0,0,0,,O zamanlar Wano'da "kanunsuz bölge" olarak adlandırılan bir yer vardı.Dialogue: 50,0:09:14.44,0:09:20.28,Narrator-207+,,0,0,0,,Memleketlerinden sürülen azılı suçlularla roninlerin kurduğu çeteler fink atıyordu.Dialogue: 50,0:09:20.28,0:09:24.41,Narrator-207+,,0,0,0,,Birbirlerini yağmalayıp kılıçtan geçiriyorlardı. Her yer kan revan içindeydi.Dialogue: 50,0:09:24.41,0:09:28.58,Narrator-207+,,0,0,0,,Yer o kadar tekin değildi ki, şogun bile burayı gözden çıkarmıştı.Dialogue: 50,0:09:28.58,0:09:30.88,Narrator-207+,,0,0,0,,Kuri öyle bir yerdi işte.Dialogue: 50,0:09:33.92,0:09:36.09,Flashbacks-207+,,0,0,0,,Sevdim bu işi!Dialogue: 50,0:09:38.05,0:09:43.18,Main-207+,,0,0,0,,Delikanlı Oden-sama gide gide menfur Kuri'ye ayak bastı!Dialogue: 50,0:09:43.18,0:09:49.52,Main-207+,,0,0,0,,Sonunda da it sürülerinin başındaki Kuri'nin en tehlikeli adamı karşısına çıktı.Dialogue: 50,0:09:55.74,0:09:58.86,Main-207+,,0,0,0,,Ashura Doji adındaki bu kişiyle anında kavgaya tutuştular!Dialogue: 50,0:10:42.31,0:10:45.16,Main-207+,,0,0,0,,Etkileyici biçimde Ashura Doji'nin hakkından gelmişti.Dialogue: 50,0:10:46.22,0:10:47.16,Main-207+,,0,0,0,,Dahası ise...Dialogue: 50,0:10:48.41,0:10:52.21,Main-207+,,0,0,0,,o zorbaların yeni lideri olmuştu.Dialogue: 50,0:10:56.55,0:10:58.78,Main-207+,,0,0,0,,Helal olsun be.Dialogue: 50,0:10:58.78,0:11:00.63,Main-207+,,0,0,0,,Kuri'yi kurtarmış!Dialogue: 50,0:11:00.63,0:11:05.01,Main-207+,,0,0,0,,Oden-sama bununla kalmayıp kasabayı kökten değiştirdi!Dialogue: 50,0:11:07.65,0:11:12.01,Main-207+,,0,0,0,,İlk iş olarak zorbalara iş tutmayı öğretti.Dialogue: 50,0:11:14.76,0:11:18.57,Main-207+,,0,0,0,,Kasabayı kalkındırıp bir kale inşa ederek...Dialogue: 50,0:11:19.13,0:11:22.83,Main-207+,,0,0,0,,halkın her kesimi için Cennet Tarlası'nı hayata geçirdi.Dialogue: 50,0:11:26.47,0:11:31.08,Main-207+,,0,0,0,,Kuri artık özgür ve gülen yüzlerle dolu cıvıl cıvıl bir bölge olmuşken...Dialogue: 50,0:11:32.18,0:11:36.13,Main-207+,,0,0,0,,Oden-sama da şogun Sukiyaki-sama tarafından...Dialogue: 50,0:11:36.13,0:11:39.59,Main-207+,,0,0,0,,Kuri daimyosu konumuna layık görüldü.Dialogue: 50,0:11:40.67,0:11:46.03,Main-207+,,0,0,0,,Oden-sama daha 20 yaşındayken bunları başarmıştı işte.Dialogue: 50,0:11:49.60,0:11:51.89,Main-207+,,0,0,0,,Nehirler ve...Dialogue: 50,0:11:51.89,0:11:53.48,Main-207+,,0,0,0,,rıhtımlar inşa etti.Dialogue: 50,0:11:53.48,0:11:55.36,Main-207+,,0,0,0,,Bölgeler ve insanlar...Dialogue: 50,0:11:55.36,0:11:57.37,Main-207+,,0,0,0,,arasında köprü kurmuştu.Dialogue: 50,0:12:00.86,0:12:02.39,Main-207+,,0,0,0,,Ardından ben...Dialogue: 50,0:12:04.70,0:12:06.62,Main-207+,,0,0,0,,Evet ya, ayrıca...Dialogue: 50,0:12:11.49,0:12:14.26,Main-207+,,0,0,0,,Kuri halkının yere göğe sığdıramadığı bir daimyo idi.Dialogue: 50,0:12:14.96,0:12:18.96,Main-207+,,0,0,0,,Gelgelelim Oden-sama özgürlüğüne düşkündü.Dialogue: 50,0:12:19.78,0:12:23.84,Main-207+,,0,0,0,,Bu çapta bir tebaaya sahip olmak hiç tarzı değildi.Dialogue: 50,0:12:28.76,0:12:31.48,Main-207+,,0,0,0,,Ağzından düşürmediği laf ise...Dialogue: 50,0:12:44.73,0:12:49.37,Flashbacks-207+,,0,0,0,,Burası çok dar!Dialogue: 50,0:12:59.85,0:13:04.06,Main-207+,,0,0,0,,Wano, Oden-sama'ya çok küçük geliyordu.Dialogue: 50,0:13:07.51,0:13:09.61,Main-207+,,0,0,0,,Hey gidi günler...Dialogue: 50,0:13:11.20,0:13:14.00,Main-207+,,0,0,0,,Tam da bu sahilde oldu!Dialogue: 50,0:13:14.00,0:13:18.77,Main-207+,,0,0,0,,Kıyıya vurduktan sonra bize "konuşan köpekle kedi" olarak...Dialogue: 50,0:13:19.31,0:13:22.65,Main-207+,,0,0,0,,hitap eden insanların ödü patlamıştı.Dialogue: 50,0:13:23.49,0:13:25.83,Main-207+,,0,0,0,,Fakat Oden-sama öyle yapmadı!Dialogue: 50,0:13:28.60,0:13:31.33,Flashbacks-207+,,0,0,0,,Size ne zararları oldu ki?Dialogue: 50,0:13:31.33,0:13:35.06,Flashbacks-207+,,0,0,0,,Kendinizden farklı olanlardan tırsmanız cahilliğinizi gösteriyor!Dialogue: 50,0:13:40.36,0:13:42.92,Main-207+,,0,0,0,,O bizim kurtarıcımızdı!Dialogue: 50,0:13:44.38,0:13:47.05,Main-207+,,0,0,0,,Beyazsakal'ı etkilemeyi başarıp...Dialogue: 50,0:13:47.05,0:13:51.22,Main-207+,,0,0,0,,Roger'ın saygısını kazanan Wano samurayı!Dialogue: 50,0:13:52.82,0:13:55.33,Main-207+,,0,0,0,,Tam bir kahramandı!Dialogue: 50,0:13:55.33,0:13:58.23,Main-207+,,0,0,0,,Efendimizdi!Dialogue: 50,0:14:22.82,0:14:25.38,Main-207+,,0,0,0,,Tüm halkın sevip saydığı Oden-sama...Dialogue: 50,0:14:35.42,0:14:37.64,Main-207+,,0,0,0,,Anlatsana! Oden'e ne oldu?Dialogue: 50,0:14:39.87,0:14:45.61,Main-207+,,0,0,0,,Çiçek Başkenti'nde bir suçlu olarak can verdi!Dialogue: 50,0:14:48.15,0:14:49.70,Main-207+,,0,0,0,,Ne?Dialogue: 50,0:14:52.82,0:14:55.04,Main-207+,,0,0,0,,Dalga mı geçiyorsun?!Dialogue: 50,0:14:55.04,0:14:57.58,Main-207+,,0,0,0,,Alçağın tekiymişsin lan Orochi!Dialogue: 50,0:14:58.79,0:15:00.83,Main-207+,,0,0,0,,İnanmıyorum ya!Dialogue: 50,0:15:02.33,0:15:03.63,Main-207+,,0,0,0,,Çok üzücü!Dialogue: 50,0:15:03.63,0:15:07.03,Main-207+,,0,0,0,,Oden-sama'nın korkunç ölümü...Dialogue: 50,0:15:07.65,0:15:10.57,Main-207+,,0,0,0,,20 yıl evvel yaşanmasına rağmen....Dialogue: 50,0:15:11.05,0:15:13.81,Main-207+,,0,0,0,,bize göre...Dialogue: 50,0:15:13.81,0:15:16.61,Main-207+,,0,0,0,,yalnızca birkaç ay önce yaşandı..!Dialogue: 50,0:15:17.67,0:15:21.68,Main-207+,,0,0,0,,Kozuki Oden adındaki cesur samurayın...Dialogue: 50,0:15:22.82,0:15:24.61,Main-207+,,0,0,0,,son anları...Dialogue: 50,0:15:24.98,0:15:29.82,Main-207+,,0,0,0,,hâlâ gözümün önüne geliyor!Dialogue: 50,0:15:33.91,0:15:36.53,Main-207+,,0,0,0,,Büyük adammış!Dialogue: 50,0:15:40.09,0:15:44.09,Main-207+,,0,0,0,,Öyle bir durumdan iyi sağ çıkmışsınız ha.Dialogue: 50,0:15:44.09,0:15:45.39,Main-207+,,0,0,0,,Evet.Dialogue: 50,0:15:45.39,0:15:48.28,Main-207+,,0,0,0,,Hiçbir müttefikimiz kalmadığından...Dialogue: 50,0:15:48.28,0:15:52.47,Main-207+,,0,0,0,,sonrasında arkamıza bakmadan kaçtık!Dialogue: 50,0:15:53.73,0:15:55.72,Narrator-207+,,0,0,0,,İnfaz alanından çıkıp...Dialogue: 50,0:15:55.72,0:15:58.64,Narrator-207+,,0,0,0,,doğruca Oden Kalesi'ne baş koyduk!Dialogue: 50,0:16:03.23,0:16:07.02,Narrator-207+,,0,0,0,,Yol üstünde Nekomamushi ile Inuarashi laf dalaşına girince...Dialogue: 50,0:16:07.02,0:16:11.32,Narrator-207+,,0,0,0,,Orochi'nin adamlarına yakalandılar, biz de onları ölüme terk ettik!Dialogue: 50,0:16:12.20,0:16:14.78,Narrator-207+,,0,0,0,,Hangimiz ölürse ölsün...Dialogue: 50,0:16:14.78,0:16:17.74,Narrator-207+,,0,0,0,,mutlaka birinin Oden Kalesi'ne  varması gerekiyordu!Dialogue: 50,0:16:18.45,0:16:22.41,Narrator-207+,,0,0,0,,Kozuki Hanesi'nin sonunu getirmek isteyen Orochi'nin hedefinde...Dialogue: 50,0:16:24.22,0:16:27.66,Narrator-207+,,0,0,0,,kalede olan Momonosuke-sama vardı!Dialogue: 50,0:16:36.31,0:16:38.43,Flashbacks-207+,,0,0,0,,K-Kale..!Dialogue: 50,0:16:39.42,0:16:45.21,Narrator-207+,,0,0,0,,Lakin Kaido çoktan harekete geçtiğinden kale alevler içindeydi.Dialogue: 50,0:16:48.48,0:16:51.74,Flashbacks-207+,,0,0,0,,Lan! Soysuzlar!Dialogue: 50,0:16:51.74,0:16:54.15,Flashbacks-207+,,0,0,0,,Bunu ödeyeceksiniz!Dialogue: 50,0:16:55.07,0:16:57.24,Flashbacks-207+,,0,0,0,,Yakalayın şunları!Dialogue: 50,0:17:06.96,0:17:09.13,Flashbacks-207+,,0,0,0,,Çiçek Shurikeni!Dialogue: 50,0:17:14.25,0:17:18.76,Narrator-207+,,0,0,0,,Momonosuke-sama ve küçük kardeşi Hiyori-sama'yla...Dialogue: 50,0:17:18.76,0:17:23.35,Narrator-207+,,0,0,0,,anneleri Kozuki Toki-sama kalede kalmıştı.Dialogue: 50,0:17:24.20,0:17:25.68,Flashbacks-207+,,0,0,0,,Anne...Dialogue: 50,0:17:30.76,0:17:33.44,Flashbacks-207+,,0,0,0,,Momonosuke-sama! Hiyori-sama!Dialogue: 50,0:17:33.44,0:17:34.99,Flashbacks-207+,,0,0,0,,Toki-sama!Dialogue: 50,0:17:37.53,0:17:39.82,Flashbacks-207+,,0,0,0,,Çabuk! Acele edin!Dialogue: 50,0:17:50.22,0:17:52.50,Flashbacks-207+,,0,0,0,,Momonosuke-sama!Dialogue: 50,0:17:52.50,0:17:54.71,Flashbacks-207+,,0,0,0,,Şükürler olsun ki iyisiniz!Dialogue: 50,0:17:55.33,0:17:57.77,Flashbacks-207+,,0,0,0,,Hiyori-sama! Toki-sama!Dialogue: 50,0:18:03.47,0:18:05.71,Flashbacks-207+,,0,0,0,,Özürlerimi sunarım!Dialogue: 50,0:18:05.71,0:18:09.60,Flashbacks-207+,,0,0,0,,Yanında olmamıza rağmen Oden-sama'yı...Dialogue: 50,0:18:09.60,0:18:12.86,Flashbacks-207+,,0,0,0,,Sizin hiçbir suçunuz yok.Dialogue: 50,0:18:12.86,0:18:13.80,Flashbacks-207+,,0,0,0,,Fakat...Dialogue: 50,0:18:13.80,0:18:15.66,Flashbacks-207+,,0,0,0,,Başınızı kaldırın.Dialogue: 50,0:18:16.58,0:18:19.82,Flashbacks-207+,,0,0,0,,Toki-sama, kale dayanmayacak! Dışarı çıkalım!Dialogue: 50,0:18:21.25,0:18:23.16,Flashbacks-207+,,0,0,0,,Ben kalıyorum.Dialogue: 50,0:18:24.49,0:18:25.69,Flashbacks-207+,,0,0,0,,Yapamazsınız!Dialogue: 50,0:18:25.69,0:18:28.48,Flashbacks-207+,,0,0,0,,Birlikte çıkalım!Dialogue: 50,0:18:28.48,0:18:29.72,Flashbacks-207+,,0,0,0,,Toki-sama!Dialogue: 50,0:18:32.78,0:18:36.46,Flashbacks-207+,,0,0,0,,Öyleyse burada kalarak sizinle aynı kaderi paylaşacağız!Dialogue: 50,0:18:37.27,0:18:39.97,Flashbacks-207+,,0,0,0,,Gidin lütfen... geleceğe.Dialogue: 50,0:18:40.93,0:18:42.26,Flashbacks-207+,,0,0,0,,Geleceğe mi?Dialogue: 50,0:18:42.26,0:18:46.09,Flashbacks-207+,,0,0,0,,Geçmişe dönemesek de...Dialogue: 50,0:18:46.09,0:18:48.23,Flashbacks-207+,,0,0,0,,geleceğe gidebiliriz.Dialogue: 50,0:18:51.18,0:18:54.67,Flashbacks-207+,,0,0,0,,Tuhaf Zaman-Zaman Meyvesi'nin gücüyle...Dialogue: 50,0:18:54.67,0:18:58.27,Flashbacks-207+,,0,0,0,,gelecekte gitgide ileri giderek...Dialogue: 50,0:18:58.27,0:19:03.74,Flashbacks-207+,,0,0,0,,nihayet yolculuğumun son durağına vardım.Dialogue: 50,0:19:03.74,0:19:06.86,Narrator-207+,,0,0,0,,İnanması güç olsa da...Dialogue: 50,0:19:06.86,0:19:11.79,Narrator-207+,,0,0,0,,Toki-sama'nın çok eski zamanlarda dünyaya geldiği söylentileri vardı.Dialogue: 50,0:19:13.76,0:19:15.01,Flashbacks-207+,,0,0,0,,Sebebi de...Dialogue: 50,0:19:15.80,0:19:17.96,Flashbacks-207+,,0,0,0,,Oden-sama ile karşılaşmış olmanız.Dialogue: 50,0:19:17.96,0:19:21.89,Flashbacks-207+,,0,0,0,,Evet, bu sebeple kalıyorum.Dialogue: 50,0:19:28.02,0:19:29.52,Flashbacks-207+,,0,0,0,,Bu kadar kararlıyken...Dialogue: 50,0:19:30.49,0:19:32.70,Flashbacks-207+,,0,0,0,,sizi kim caydırabilir ki?!Dialogue: 50,0:19:43.38,0:19:47.29,Flashbacks-207+,,0,0,0,,Gerçekten de geleceğe gidecek olursak...Dialogue: 50,0:19:49.33,0:19:54.17,Flashbacks-207+,,0,0,0,,mutlaka Oden-sama'nın hayalini gerçekleştirerek...Dialogue: 50,0:19:54.17,0:19:57.92,Flashbacks-207+,,0,0,0,,Orochi ile Kaido'yu alt edeceğiz!Dialogue: 50,0:20:03.00,0:20:05.46,Flashbacks-207+,,0,0,0,,Ant içeriz ki...Dialogue: 50,0:20:05.46,0:20:07.85,Flashbacks-207+,,0,0,0,,ülkemizin kapılarını açacağız!Dialogue: 50,0:20:11.18,0:20:14.65,Flashbacks-207+,,0,0,0,,Momonosuke size emanet.Dialogue: 50,0:20:16.07,0:20:17.19,Flashbacks-207+,,0,0,0,,Anne?Dialogue: 50,0:20:20.87,0:20:25.16,Flashbacks-207+,,0,0,0,,Gitmek istemiyorum! Seninle kalacağım anne!Dialogue: 50,0:20:25.16,0:20:28.58,Flashbacks-207+,,0,0,0,,Anne, lütfen bırakma beni!Dialogue: 50,0:20:28.58,0:20:33.79,Flashbacks-207+,,0,0,0,,Anne! Anne!Dialogue: 50,0:20:50.76,0:20:52.79,Flashbacks-207+,,0,0,0,,Ah...Dialogue: 50,0:20:57.90,0:21:00.35,Flashbacks-207+,,0,0,0,,Ha?! Burası...?!Dialogue: 50,0:21:04.90,0:21:08.46,Flashbacks-207+,,0,0,0,,Hayal mi görüyorum? Neredeyiz?Dialogue: 50,0:21:08.46,0:21:10.90,Flashbacks-207+,,0,0,0,,Kale nereye kayboldu? Peki yangın?Dialogue: 50,0:21:10.90,0:21:13.83,Flashbacks-207+,,0,0,0,,Toki-sama! Hiyori-sama!Dialogue: 50,0:21:16.65,0:21:21.26,Flashbacks-207+,,0,0,0,,Neredesin anne?Dialogue: 50,0:21:21.93,0:21:24.47,Flashbacks-207+,,0,0,0,,Bekleyin, Momonosuke-sama!Dialogue: 50,0:21:24.47,0:21:26.84,Flashbacks-207+,,0,0,0,,Anne!Dialogue: 50,0:21:29.93,0:21:31.59,Flashbacks-207+,,0,0,0,,Kin'emon!Dialogue: 50,0:21:39.56,0:21:42.61,Flashbacks-207+,,0,0,0,,Kendi mezarlarımız mı?Dialogue: 50,0:21:42.61,0:21:45.10,Flashbacks-207+,,0,0,0,,Hem de epey eskiler!Dialogue: 50,0:21:45.71,0:21:49.57,Flashbacks-207+,,0,0,0,,Toki-sama'nın gücü gerçekmiş!Dialogue: 50,0:21:56.49,0:21:59.35,Flashbacks-207+,,0,0,0,,Bu... Kuri'deki bir kasaba mı?Dialogue: 50,0:22:02.49,0:22:05.95,Flashbacks-207+,,0,0,0,,Wano'nun geleceği böyle miymiş?Dialogue: 50,0:22:09.11,0:22:12.21,Main-207+,,0,0,0,,Geçmişten gelen bizler...Dialogue: 50,0:22:12.80,0:22:17.50,Main-207+,,0,0,0,,20 yıl sonraki dünyaya tamamen yabancıydık.Dialogue: 50,0:22:18.07,0:22:19.94,Main-207+,,0,0,0,,Orochiler'in elinde...Dialogue: 50,0:22:19.94,0:22:24.18,Main-207+,,0,0,0,,murdar edilen ülkemizin durumunu görmek için...Dialogue: 50,0:22:24.18,0:22:25.86,Main-207+,,0,0,0,,dolaştık durduk.Dialogue: 50,0:22:26.73,0:22:28.85,Main-207+,,0,0,0,,Sıra sıra fabrikalarla,Dialogue: 50,0:22:28.85,0:22:31.78,Main-207+,,0,0,0,,kara duman üfleyen bir sürü bacayla...Dialogue: 50,0:22:31.78,0:22:36.62,Main-207+,,0,0,0,,suyun kirletildiğini, gıdanın tekelleştiğini gördük.Dialogue: 50,0:22:37.25,0:22:40.48,Main-207+,,0,0,0,,Daimyolar'la bölgeler yok edilmiş!Dialogue: 50,0:22:40.48,0:22:42.09,Main-207+,,0,0,0,,Topraklar çoraklaşmış!Dialogue: 50,0:22:42.09,0:22:46.88,Main-207+,,0,0,0,,İftiraları yüzünden Kozuki adından tiksinir olunmuş.Dialogue: 50,0:22:47.80,0:22:52.03,Main-207+,,0,0,0,,Artık tanıdığımız...Dialogue: 50,0:22:52.71,0:22:55.26,Main-207+,,0,0,0,,Wano'dan eser kalmamış!Dialogue: 50,0:22:59.91,0:23:03.69,Narrator-207+,,0,0,0,,Bizlerle omuz omuza çarpışacak kimse kalmamıştır diyordum.Dialogue: 50,0:23:18.33,0:23:19.37,Flashbacks-207+,,0,0,0,,İnanılmaz...Dialogue: 50,0:23:22.33,0:23:26.27,Flashbacks-207+,,0,0,0,,Siz Kozuki Momonosuke-sama'sınız...Dialogue: 50,0:23:26.27,0:23:28.84,Flashbacks-207+,,0,0,0,,değil mi?Dialogue: 50,0:23:33.47,0:23:37.27,Flashbacks-207+,,0,0,0,,Tıpkı 20 yıl öncesi gibi görünüyorsunuz.Dialogue: 50,0:23:37.96,0:23:42.46,Flashbacks-207+,,0,0,0,,Toki-sama'nın son sözleri doğruymuş!Dialogue: 50,0:23:47.82,0:23:53.95,Flashbacks-207+,,0,0,0,,Vaktiyle Kibi'nin hizmetkârıydım. Adım Jibuemon.Dialogue: 50,0:23:53.95,0:23:56.01,Flashbacks-207+,,0,0,0,,20 yıldır...Dialogue: 50,0:23:56.85,0:24:00.26,Flashbacks-207+,,0,0,0,,sizi bekliyordum.Dialogue: 50,0:24:00.26,0:24:04.68,Flashbacks-207+,,0,0,0,,Anneniz Toki-sama'nın dediklerine inandım...Dialogue: 50,0:24:05.29,0:24:07.12,Flashbacks-207+,,0,0,0,,ve bu günü bekledim.Dialogue: 50,0:24:10.55,0:24:14.81,Flashbacks-207+,,0,0,0,,Annemin son sözlerini...Dialogue: 50,0:24:15.36,0:24:16.79,Flashbacks-207+,,0,0,0,,söyle bana!Dialogue: 50,0:24:16.79,0:24:18.11,Flashbacks-207+,,0,0,0,,Peki, efendim!Dialogue: 50,0:24:18.11,0:24:19.86,Flashbacks-207+,,0,0,0,,Söyleyeceğim.Dialogue: 50,0:24:22.33,0:24:26.06,Flashbacks-207+,,0,0,0,,"Ey şafaktan bihaber olan Ay!Dialogue: 50,0:24:26.06,0:24:29.36,Flashbacks-207+,,0,0,0,,Dileğin kabul olsun...Dialogue: 50,0:24:29.36,0:24:35.11,Flashbacks-207+,,0,0,0,,ve yirmi yılı dokuyan o geceye dokuz gölge düşsün...Dialogue: 50,0:24:35.11,0:24:38.74,Flashbacks-207+,,0,0,0,,İşte o vakit, şafağın ihtişamına şahit olacaksın!"Dialogue: 50,0:24:39.80,0:24:42.46,Flashbacks-207+,,0,0,0,,Toki-sama'nın son sözleri, 20 yıl sonra...Dialogue: 50,0:24:42.46,0:24:46.96,Flashbacks-207+,,0,0,0,,Kozuki Hanesi'nin intikamını öne sürüyordu.Dialogue: 50,0:24:46.96,0:24:50.55,Flashbacks-207+,,0,0,0,,Bunun imkânsız olduğunu düşündük ama...Dialogue: 50,0:24:50.55,0:24:58.08,Flashbacks-207+,,0,0,0,,sanki olasılık varmış gibi, Dokuz Kızıl Kın'ın cesetlerinin hiçbiri...Dialogue: 50,0:24:58.08,0:25:00.92,Flashbacks-207+,,0,0,0,,bulunamadı.Dialogue: 50,0:25:04.44,0:25:06.73,Flashbacks-207+,,0,0,0,,Anne...Dialogue: 50,0:25:06.73,0:25:14.05,Flashbacks-207+,,0,0,0,,Uzak bir şans da olsa 20 yıl sonra ortaya çıkıp...Dialogue: 50,0:25:14.05,0:25:18.16,Flashbacks-207+,,0,0,0,,Orochi'yi indirip  hakimiyetimizi alacaksınız diye...Dialogue: 50,0:25:18.16,0:25:22.08,Flashbacks-207+,,0,0,0,,savaşmaya kararlı olanlar...Dialogue: 50,0:25:22.08,0:25:24.87,Flashbacks-207+,,0,0,0,,yanınızda savaşmak isteyenler olarak...Dialogue: 50,0:25:24.87,0:25:29.13,Flashbacks-207+,,0,0,0,,nerede oldukları veya ne yaptıkları önemsiz şekilde...Dialogue: 50,0:25:32.38,0:25:36.68,Flashbacks-207+,,0,0,0,,ayak bileklerinde bir ay işaretiyle bekliyorlar!Dialogue: 50,0:25:43.85,0:25:45.92,Flashbacks-207+,,0,0,0,,N... Ne?!Dialogue: 50,0:25:46.60,0:25:49.81,Flashbacks-207+,,0,0,0,,20 yıl sonra bile hâlâ müttefiklerimiz mi var?Dialogue: 50,0:25:49.81,0:25:52.57,Flashbacks-207+,,0,0,0,,Kaç kişi var?Dialogue: 50,0:25:52.57,0:25:55.25,Flashbacks-207+,,0,0,0,,Tam olarak bilmiyoruz.Dialogue: 50,0:25:55.25,0:26:01.16,Flashbacks-207+,,0,0,0,,Ancak Wano'nun dört bir yanında bu anı bekleyenler var!Dialogue: 50,0:26:02.78,0:26:04.25,Flashbacks-207+,,0,0,0,,Kaido'yu indirmek için...Dialogue: 50,0:26:04.86,0:26:09.08,Flashbacks-207+,,0,0,0,,mümkün olduğu kadar çok müttefikimiz olmalı.Dialogue: 50,0:26:09.60,0:26:14.30,Flashbacks-207+,,0,0,0,,Wano'da aynı görüşteki insanları toplar mısın?Dialogue: 50,0:26:14.85,0:26:19.76,Flashbacks-207+,,0,0,0,,Ama bunu sinsice yapmalısın.Dialogue: 50,0:26:19.76,0:26:21.27,Flashbacks-207+,,0,0,0,,Başüstüne!Dialogue: 50,0:26:21.27,0:26:23.39,Flashbacks-207+,,0,0,0,,Tüm çabamızı buna adayacağız!Dialogue: 50,0:26:23.85,0:26:29.79,Main-207+,,0,0,0,,Wano için bir gelecek olabileceğini düşünerek umutlarımızı canlı tutabildik.Dialogue: 50,0:26:29.79,0:26:33.19,Main-207+,,0,0,0,,Kiku'dan düşmanları araştırmasını istedik,Dialogue: 50,0:26:33.89,0:26:38.82,Main-207+,,0,0,0,,ben, Kanjuro, Raizo ve  Momonosuke-sama dördümüz...Dialogue: 50,0:26:38.82,0:26:42.75,Main-207+,,0,0,0,,müttefik toplamak için yola çıktık.Dialogue: 50,0:26:43.28,0:26:46.50,Main-207+,,0,0,0,,Bu ülkeyi terk etmek bile bir suçtur.Dialogue: 50,0:26:46.50,0:26:51.46,Main-207+,,0,0,0,,Bizi görür görmez kovaladılar.Dialogue: 50,0:26:51.46,0:26:55.17,Main-207+,,0,0,0,,Bunun üzerine, nasıl yelken açacağımızı bilmediğimizden...Dialogue: 50,0:26:55.17,0:27:00.23,Main-207+,,0,0,0,,Zou'ya ulaşmaya çalıştık ama kısa sürede kaza yaptık!Dialogue: 50,0:27:00.23,0:27:03.95,Main-207+,,0,0,0,,Gemi mahvolmuştu ve Raizo'dan ayrı düşmüştük!Dialogue: 50,0:27:03.95,0:27:07.22,Flashbacks-207+,,0,0,0,,Zou'da görüşürüz!Dialogue: 50,0:27:07.22,0:27:09.61,Flashbacks-207+,,0,0,0,,Raizo...!Dialogue: 50,0:27:09.61,0:27:11.56,Main-207+,,0,0,0,,Raizo...!Dialogue: 50,0:27:11.56,0:27:15.80,Main-207+,,0,0,0,,Ölümümüze ramak kala Dressrosa'daki karaya vurduk ama...Dialogue: 50,0:27:15.80,0:27:19.57,Main-207+,,0,0,0,,Kaido'ya bağlı Doflamingo peşimize düştü ve...Dialogue: 50,0:27:19.57,0:27:24.79,Main-207+,,0,0,0,,yanlışlıkla bilinmeyen bir gemiye binen Momonosuke-sama'dan ayrılmıştık.Dialogue: 50,0:27:27.91,0:27:31.04,Flashbacks-207+,,0,0,0,,Momonosuke-sama!Dialogue: 50,0:27:31.56,0:27:37.49,Main-207+,,0,0,0,,Ve Momonosuke-sama'yı takip ederken ben de Kanjuro'dan ayrıldım!Dialogue: 50,0:27:37.49,0:27:40.17,Flashbacks-207+,,0,0,0,,Beni merak etme!Dialogue: 50,0:27:40.17,0:27:43.10,Flashbacks-207+,,0,0,0,,Kanjuro...!Dialogue: 50,0:27:43.10,0:27:45.35,Main-207+,,0,0,0,,Kanjuro...!Dialogue: 50,0:27:46.33,0:27:52.06,Main-207+,,0,0,0,,Böylece, Wano'dan ayrıldıktan sonra dağıldık.Dialogue: 50,0:27:56.58,0:28:01.69,Main-207+,,0,0,0,,Düşmüş olduğum Punk Hazard'ta bile Momonosuke-sama'yı ararken...Dialogue: 50,0:28:01.69,0:28:04.87,Main-207+,,0,0,0,,Kaido'nun kuklası olan Caesar yoluma çıkmıştı.Dialogue: 50,0:28:04.87,0:28:09.29,Main-207+,,0,0,0,,Ayrıca, şu anda müttefikim olan Law-dono tarafından da doğranmıştım.Dialogue: 50,0:28:15.05,0:28:16.96,Main-207+,,0,0,0,,Başım büyük dertteydi.Dialogue: 50,0:28:18.02,0:28:20.72,Main-207+,,0,0,0,,O sırada sizinle tanıştım!Dialogue: 50,0:28:28.67,0:28:31.02,Flashbacks-207+,,0,0,0,,Havalı!Dialogue: 50,0:28:31.02,0:28:32.64,Flashbacks-207+,,0,0,0,,Siz kimsiniz?Dialogue: 50,0:28:32.64,0:28:35.19,Flashbacks-207+,,0,0,0,,Az önce ejderha konuştu!Dialogue: 50,0:28:35.19,0:28:38.73,Flashbacks-207+,,0,0,0,,Çok edepsizce! Üstünde sadece göğüs bezi var!Dialogue: 50,0:28:38.73,0:28:40.68,Flashbacks-207+,,0,0,0,,He, hoşuna gitmedi mi?Dialogue: 50,0:28:41.19,0:28:42.70,Flashbacks-207+,,0,0,0,,Hayır, bayıldım!Dialogue: 50,0:28:42.70,0:28:45.71,Flashbacks-207+,,0,0,0,,Beni yiyemezsin!Dialogue: 50,0:28:45.71,0:28:48.24,Flashbacks-207+,,0,0,0,,Beni yemeye çalışırsan ben seni yerim!Dialogue: 50,0:28:48.24,0:28:50.62,Flashbacks-207+,,0,0,0,,Kendine gel!Dialogue: 50,0:28:55.12,0:28:58.97,Main-207+,,0,0,0,,Geçmişe bakınca kriz ardına kriz vardı ama...Dialogue: 50,0:28:59.65,0:29:01.70,Main-207+,,0,0,0,,iyi insanlarla tanıştım.Dialogue: 50,0:29:02.38,0:29:07.70,Main-207+,,0,0,0,,Hayatımı emanet edebileceğim güvenilir müttefikler bulabildim ve geri döndüm.Dialogue: 50,0:29:08.30,0:29:12.14,Main-207+,,0,0,0,,Orochi'nin adamları, adımızdan bahsetti ama...Dialogue: 50,0:29:12.14,0:29:17.73,Main-207+,,0,0,0,,buna inanmadıklarından şu an için rahatız!Dialogue: 50,0:29:17.73,0:29:21.82,Main-207+,,0,0,0,,Bizi sadece hayalet olarak düşünüyorlar.Dialogue: 50,0:29:21.82,0:29:27.16,Main-207+,,0,0,0,,Bu yüzden henüz arananlar listesine bile girmedik...Dialogue: 50,0:29:27.16,0:29:31.55,Main-207+,,0,0,0,,ve ülkeye yeniden girdiğimizi fark etmediler.Dialogue: 50,0:29:31.55,0:29:34.91,Main-207+,,0,0,0,,Aynı tarafta olmamıza rağmen ben bile bilmiyordum.Dialogue: 50,0:29:34.91,0:29:37.63,Main-207+,,0,0,0,,Bunun için üzgünüm!Dialogue: 50,0:29:37.63,0:29:39.54,Main-207+,,0,0,0,,Hey, yiyişmeyin!Dialogue: 50,0:29:42.98,0:29:47.80,Main-207+,,0,0,0,,Bu savaşta Kaidolar'dan varlığımızı...Dialogue: 50,0:29:48.80,0:29:50.39,Main-207+,,0,0,0,,saklamak çok önemli.Dialogue: 50,0:29:56.64,0:29:59.27,Main-207+,,0,0,0,,Tamam! Anladım!Dialogue: 50,0:29:59.27,0:30:03.90,Main-207+,,0,0,0,,Kaido ve Kurozumi Orochi'nin yönettiği dev ordulara karşıyız.Dialogue: 50,0:30:03.90,0:30:07.61,Main-207+,,0,0,0,,Diğer yandan, bizde...Dialogue: 50,0:30:07.61,0:30:11.58,Main-207+,,0,0,0,,Luffy-dono önderliğinde Hasır Şapkalar.Dialogue: 50,0:30:11.58,0:30:15.54,Main-207+,,0,0,0,,Law-dono önderliğinde Kalp Korsanları.Dialogue: 50,0:30:15.54,0:30:21.13,Main-207+,,0,0,0,,Minkler, Inuarashi silahşorları ve Nekomamushi muhafızları.Dialogue: 50,0:30:21.13,0:30:27.04,Main-207+,,0,0,0,,Ve topladığımız isyancı düşünceleri olan samuraylar.Dialogue: 50,0:30:27.04,0:30:31.60,Main-207+,,0,0,0,,Beş bin kişiye sahip olmak yeterli!Dialogue: 50,0:30:31.60,0:30:35.75,Main-207+,,0,0,0,,Ama biz savaşın peşinde değiliz.Dialogue: 50,0:30:37.02,0:30:42.44,Main-207+,,0,0,0,,Düşmanlarımız ve Kaidolar hakkında gizlice bilgi toplayıp plan yaparak...Dialogue: 50,0:30:46.61,0:30:49.03,Main-207+,,0,0,0,,liderlerinin kellesini...Dialogue: 50,0:30:50.07,0:30:51.45,Main-207+,,0,0,0,,almak istiyoruz!Dialogue: 0,0:01:41.95,0:01:45.45,Title-207+,,0,0,0,,Oden'i SeviyorumDialogue: 0,0:01:45.45,0:01:49.75,Captions Wano,,0,0,0,,Çiçek BaşkentiDialogue: 50,0:02:16.99,0:02:19.95,Note-207+,,0,0,0,,"Kurozumi Orochi"Dialogue: 50,0:02:46.14,0:02:49.52,Note-207+,,0,0,0,,Kozuki OdenDialogue: 0,0:04:36.96,0:04:39.67,Captions Wano,,0,0,0,,Kurozumi Hanesi'nin SarrafıDialogue: 0,0:04:39.71,0:04:43.13,Captions Wano,,0,0,0,,"Uykucu" KyoshiroDialogue: 0,0:13:06.05,0:13:10.68,Captions Wano,,0,0,0,,Gündüz Dükü Inuarashi Mokomo DüklüğüDialogue: 50,0:14:16.54,0:14:25.38,Note-207+,,0,0,0,,Kozuki OdenDialogue: 0,0:00:26.17,0:00:30.13,Credits-207+,,0,0,0,,Video DüzenlemeDialogue: 1,0:00:26.17,0:00:30.13,Credits-207+,,0,0,0,,Video DüzenlemeDialogue: 0,0:00:26.17,0:00:30.13,Credits-207+,,0,0,0,,FeesoDialogue: 1,0:00:26.17,0:00:30.13,Credits-207+,,0,0,0,,FeesoDialogue: 2,0:00:26.17,0:00:30.13,Credits-207+,,0,0,0,,FeesoDialogue: 0,0:00:30.21,0:00:34.63,Credits-207+,,0,0,0,,ZamanlamaDialogue: 1,0:00:30.21,0:00:34.63,Credits-207+,,0,0,0,,ZamanlamaDialogue: 0,0:00:30.21,0:00:34.63,Credits-207+,,0,0,0,,KaitouYahikoDialogue: 1,0:00:30.21,0:00:34.63,Credits-207+,,0,0,0,,KaitouYahikoDialogue: 2,0:00:30.21,0:00:34.63,Credits-207+,,0,0,0,,KaitouYahikoDialogue: 0,0:00:30.21,0:00:34.63,Credits-207+,,0,0,0,,DizgiDialogue: 1,0:00:30.21,0:00:34.63,Credits-207+,,0,0,0,,DizgiDialogue: 0,0:00:30.21,0:00:34.63,Credits-207+,,0,0,0,,Gab PhosCityDialogue: 1,0:00:30.21,0:00:34.63,Credits-207+,,0,0,0,,Gab PhosCityDialogue: 2,0:00:30.21,0:00:34.63,Credits-207+,,0,0,0,,Gab PhosCityDialogue: 0,0:00:34.93,0:00:38.51,Credits-207+,,0,0,0,,Kalite KontrolDialogue: 1,0:00:34.93,0:00:38.51,Credits-207+,,0,0,0,,Kalite KontrolDialogue: 0,0:00:34.93,0:00:38.51,Credits-207+,,0,0,0,,DolphinWeabu Galaxy 9000 Grug PepperjackDialogue: 1,0:00:34.93,0:00:38.51,Credits-207+,,0,0,0,,DolphinWeabu Galaxy 9000 Grug PepperjackDialogue: 2,0:00:34.93,0:00:38.51,Credits-207+,,0,0,0,,Dol