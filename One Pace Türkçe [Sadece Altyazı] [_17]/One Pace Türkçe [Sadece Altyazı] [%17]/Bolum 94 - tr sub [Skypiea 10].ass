&H00000000,0,0,0,0,100,100,0,0,1,1.5,0,8,10,10,30,1Style: Karaoke,Duality,65,&H009E375F,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,8,10,10,30,1Style: Translation,Duality,65,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,3,0,2,10,10,30,1Style: Luffy Monologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:50.72,0:02:00.72,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 50,0:01:52.43,0:01:57.26,Narrator-207-,,0,0,0,,Şu ana kadar Yukarı Bahçe hayatta kalma oyununda 1 kişi düştü,Dialogue: 50,0:01:57.26,0:01:59.35,Narrator-207-,,0,0,0,,kalan ise 80 kişi.Dialogue: 50,0:02:00.56,0:02:04.06,Main-207-,,0,0,0,,Tanrı'nın sevgili kulu değilmiş demek...Dialogue: 50,0:02:07.07,0:02:11.03,Narrator-207-,,0,0,0,,Bu sırada, Hasır Şapkalar'dan 4 kişi altın arayışında.Dialogue: 50,0:02:11.53,0:02:16.53,Narrator-207-,,0,0,0,,Hedefleri: antik şehrin kalıntıları içinde yatan hazine.Dialogue: 50,0:02:17.53,0:02:21.16,Narrator-207-,,0,0,0,,Adak Sunağı'ndan tam güneye doğru ilerliyorlar.Dialogue: 50,0:02:22.62,0:02:24.71,Narrator-207-,,0,0,0,,Tam güneye...Dialogue: 50,0:02:25.33,0:02:27.13,Narrator-207-,,0,0,0,,doğru...Dialogue: 50,0:02:34.76,0:02:37.76,Main-207-,,0,0,0,,Orman da pek hareketlendi...Dialogue: 50,0:02:38.26,0:02:40.81,Main-207-,,0,0,0,,Bu ev, şehirden epey uzakta,Dialogue: 50,0:02:41.43,0:02:43.73,Main-207-,,0,0,0,,doğal olarak orman tarafından yutulmuş.Dialogue: 50,0:02:43.73,0:02:47.65,Main-207-,,0,0,0,,Acaba asıl şehrin kalıntıları daha iyi durumda mı?Dialogue: 50,0:02:54.53,0:02:56.28,Main-207-,,0,0,0,,Kadın!Dialogue: 50,0:02:56.28,0:02:59.78,Main-207-,,0,0,0,,Bu yol, Tanrı'nın Tapınağı'na gider!Dialogue: 50,0:02:59.78,0:03:02.29,Main-207-,,0,0,0,,Daha öteye gitmek küstahlık olur!Dialogue: 50,0:03:04.41,0:03:05.96,Main-207-,,0,0,0,,İn oradan aşağı!Dialogue: 50,0:03:06.25,0:03:11.71,Main-207-,,0,0,0,,Asıl küstahlık, senin bu tarihi kalıntıların üstünde dolaşman!Dialogue: 50,0:03:12.30,0:03:13.92,Main-207-,,0,0,0,,Yüzsüz!Dialogue: 50,0:03:14.26,0:03:15.72,Main-207-,,0,0,0,,Benle ne işin var?Dialogue: 50,0:03:15.72,0:03:16.88,Main-207-,,0,0,0,,Ne istiyorsun?Dialogue: 50,0:03:18.18,0:03:21.10,Main-207-,,0,0,0,,Basit! Tanrı'nın emriyle...Dialogue: 50,0:03:21.10,0:03:23.81,Main-207-,,0,0,0,,siz Mavi Deniz'den gelenleri ve Shandialıları...Dialogue: 50,0:03:23.81,0:03:27.02,Main-207-,,0,0,0,,axe dial'ımla parçalamak!Dialogue: 50,0:03:29.86,0:03:31.40,Main-207-,,0,0,0,,Altı Çiçek!Dialogue: 50,0:03:33.78,0:03:34.99,Main-207-,,0,0,0,,Bükme!Dialogue: 50,0:03:42.08,0:03:44.20,Main-207-,,0,0,0,,Çok barbarca.Dialogue: 50,0:03:48.62,0:03:51.34,Main-207-,,0,0,0,,K-Kurtarın beni!Dialogue: 50,0:03:51.34,0:03:53.09,Main-207-,,0,0,0,,Olamaz!Dialogue: 50,0:03:53.09,0:03:55.63,Main-207-,,0,0,0,,Gelmeyin! Bırakın peşimi!Dialogue: 50,0:04:15.90,0:04:16.86,Main-207-,,0,0,0,,Shandialılar!Dialogue: 50,0:04:17.86,0:04:19.36,Main-207-,,0,0,0,,İlahi savaşçılar!Dialogue: 50,0:04:40.68,0:04:41.64,Main-207-,,0,0,0,,Buraya...Dialogue: 50,0:04:43.35,0:04:46.35,Main-207-,,0,0,0,,hiç gelmemeliydim!Dialogue: 50,0:04:55.53,0:04:57.61,Main-207-,,0,0,0,,Aldın mı boyunun ölçüsünü, ilahi savaşçı?!Dialogue: 50,0:05:00.28,0:05:02.62,Main-207-,,0,0,0,,Çok kayıp verdik!Dialogue: 50,0:05:02.62,0:05:03.78,Main-207-,,0,0,0,,Lanet olsun!Dialogue: 50,0:05:03.78,0:05:06.62,Main-207-,,0,0,0,,Bu ilahi savaşçılar büyük dert!Dialogue: 50,0:05:06.62,0:05:09.58,Main-207-,,0,0,0,,Peki. Peki. Peki...Dialogue: 50,0:05:09.58,0:05:12.33,Main-207-,,0,0,0,,O, Wyper'ın bahsettiği Mavi Denizlilerden biri mi?!Dialogue: 50,0:05:12.71,0:05:14.34,Main-207-,,0,0,0,,Yok edilmeli!Dialogue: 50,0:05:18.17,0:05:19.17,Main-207-,,0,0,0,,Gerilla!Dialogue: 50,0:05:20.72,0:05:22.26,Main-207-,,0,0,0,,Sanırım dövüşmek istiyor!Dialogue: 50,0:05:23.09,0:05:24.43,Main-207-,,0,0,0,,Geber!Dialogue: 50,0:05:24.76,0:05:27.39,Main-207-,,0,0,0,,Ne olduğunu anlamasam da...!Dialogue: 50,0:05:32.85,0:05:35.40,Main-207-,,0,0,0,,Sizin derdiniz ne be?!Dialogue: 50,0:05:38.90,0:05:41.28,Main-207-,,0,0,0,,Lütfen, bağışla beni! Pes ediyorum!Dialogue: 50,0:05:41.65,0:05:43.28,Main-207-,,0,0,0,,Pes ediyorum!Dialogue: 50,0:05:43.28,0:05:44.66,Main-207-,,0,0,0,,Kaybettim!Dialogue: 50,0:05:44.66,0:05:46.78,Main-207-,,0,0,0,,Lütfen, merhamet et!Dialogue: 50,0:05:51.50,0:05:52.92,Main-207-,,0,0,0,,Biri daha mı?!Dialogue: 50,0:05:53.29,0:05:54.29,Main-207-,,0,0,0,,Hey, sen!Dialogue: 50,0:05:54.29,0:05:57.34,Main-207-,,0,0,0,,Rahip değilsen bana saldırmaya yeltenme bile!Dialogue: 50,0:05:57.34,0:05:59.46,Main-207-,,0,0,0,,Acelem var!Dialogue: 50,0:06:23.07,0:06:24.91,Main-207-,,0,0,0,,Şerefsiz!Dialogue: 50,0:06:24.91,0:06:27.28,Main-207-,,0,0,0,,O parlayan tabancalar da ne?!Dialogue: 50,0:06:29.83,0:06:30.87,Main-207-,,0,0,0,,Nereye gitti?!Dialogue: 50,0:06:50.68,0:06:52.68,Main-207-,,0,0,0,,Zorlu çıktın.Dialogue: 50,0:06:52.68,0:06:55.65,Main-207-,,0,0,0,,Üzgünüm. Seni hafife aldım, Mavi Deniz insanı.Dialogue: 50,0:07:01.44,0:07:04.65,Main-207-,,0,0,0,,Hayır, asıl ben üzgünüm.Dialogue: 50,0:07:05.40,0:07:07.57,Main-207-,,0,0,0,,Seni kolay lokma sanmıştım.Dialogue: 50,0:07:22.84,0:07:24.51,Thoughts-207-,,0,0,0,,Ayakları kıpırdamadı bile!Dialogue: 50,0:07:30.22,0:07:33.22,Thoughts-207-,,0,0,0,,Farklı tiplerde waverlar var demişlerdi...Dialogue: 50,0:07:34.18,0:07:37.19,Thoughts-207-,,0,0,0,,Giydiği o paten gibi şeyler de waver mı?Dialogue: 50,0:07:39.11,0:07:41.44,Thoughts-207-,,0,0,0,,Patenleri ile kendini havada ittiriyor!Dialogue: 50,0:07:42.15,0:07:43.32,Thoughts-207-,,0,0,0,,Ve...Dialogue: 50,0:07:43.32,0:07:45.78,Thoughts-207-,,0,0,0,,tabancaları ateş etmeden önce parlıyor!Dialogue: 50,0:07:46.24,0:07:49.07,Thoughts-207-,,0,0,0,,O yüzden onu takip edemiyorum!Dialogue: 50,0:07:50.49,0:07:52.12,Main-207-,,0,0,0,,Nereye gitti?!Dialogue: 50,0:07:57.83,0:07:58.67,Main-207-,,0,0,0,,Kaplan...Dialogue: 50,0:07:58.67,0:08:00.04,Main-207-,,0,0,0,,Üç kılıç mı?!Dialogue: 50,0:08:00.04,0:08:01.34,Main-207-,,0,0,0,,...Avı!Dialogue: 50,0:08:05.88,0:08:07.84,Main-207-,,0,0,0,,Şerefsiz!Dialogue: 50,0:08:20.19,0:08:24.03,Main-207-,,0,0,0,,Waver ve dial kullanmayı bilmeyen Mavi Deniz'den bir kılıç ustası.Dialogue: 50,0:08:24.48,0:08:26.57,Main-207-,,0,0,0,,Bana karşı hiçbir şansın yok!Dialogue: 50,0:08:28.82,0:08:31.53,Main-207-,,0,0,0,,Bu ne biliyor musun?!Dialogue: 50,0:08:31.91,0:08:32.99,Main-207-,,0,0,0,,Ne...?!Dialogue: 50,0:08:33.70,0:08:35.12,Main-207-,,0,0,0,,Milky Dial!Dialogue: 50,0:08:40.21,0:08:44.50,Main-207-,,0,0,0,,Havada dövüşmek, öyle rastgele sağa sola zıplamak değildir!Dialogue: 50,0:08:46.59,0:08:48.59,Main-207-,,0,0,0,,Y-Yılan balığı mı?!Dialogue: 50,0:08:59.81,0:09:03.40,Main-207-,,0,0,0,,Bunun da ızgarası bi' acayip olur ha...Dialogue: 50,0:09:23.83,0:09:26.34,Main-207-,,0,0,0,,F-Fena çuvalladım!Dialogue: 50,0:09:26.34,0:09:28.34,Main-207-,,0,0,0,,Aptal mıyım neyim?!Dialogue: 50,0:09:29.13,0:09:33.34,Main-207-,,0,0,0,,Zaten zar zor baş ediyordum...Dialogue: 50,0:09:34.47,0:09:35.97,Main-207-,,0,0,0,,bir de bacağımdan vuruldum!Dialogue: 50,0:09:36.35,0:09:40.81,Main-207-,,0,0,0,,O kör eden tabancalara karşı ne yapacağım?!Dialogue: 50,0:09:41.48,0:09:42.44,Main-207-,,0,0,0,,İşte bu!Dialogue: 50,0:09:43.27,0:09:45.98,Main-207-,,0,0,0,,Silahların da pek şekil!Dialogue: 50,0:09:49.44,0:09:51.32,Main-207-,,0,0,0,,Ama ne yazık ki...Dialogue: 50,0:09:51.32,0:09:53.45,Main-207-,,0,0,0,,Bak! Gözlüğüm var!Dialogue: 50,0:09:53.78,0:09:58.20,Main-207-,,0,0,0,,Tabancalarının flaşları artık işe yaramaz!Dialogue: 50,0:09:58.95,0:10:01.04,Main-207-,,0,0,0,,Pes etsen iyi olur!Dialogue: 50,0:10:01.04,0:10:03.75,Main-207-,,0,0,0,,Güneş gözlüğüne benzemiyor...Dialogue: 50,0:10:04.21,0:10:05.75,Thoughts-207-,,0,0,0,,Blöfü yemedi!Dialogue: 50,0:10:06.09,0:10:09.13,Main-207-,,0,0,0,,Flaşlı tabancalarımı pek sevmiş gibi gözükmüyorsun.Dialogue: 50,0:10:09.55,0:10:11.38,Main-207-,,0,0,0,,Kılıç ustası için yakın dövüş şarttır.Dialogue: 50,0:10:11.38,0:10:13.93,Main-207-,,0,0,0,,Benle boy ölçüşemezsin.Dialogue: 50,0:10:14.76,0:10:18.97,Main-207-,,0,0,0,,Buraya neden geldiniz bilmiyorum...Dialogue: 50,0:10:19.43,0:10:25.56,Main-207-,,0,0,0,,ama burada olduğunuz sürece düşmanımızsınız.Dialogue: 50,0:10:25.98,0:10:28.27,Main-207-,,0,0,0,,O yüzden pes et ve ölümü kabullen!Dialogue: 50,0:10:28.27,0:10:30.36,Main-207-,,0,0,0,,Bacağın çok acıyordur diye tahmin ediyorum.Dialogue: 50,0:10:30.86,0:10:32.53,Main-207-,,0,0,0,,Sempatine ihtiyacım yok.Dialogue: 50,0:10:32.53,0:10:34.20,Main-207-,,0,0,0,,Alt tarafı bir sıyrık!Dialogue: 50,0:10:35.61,0:10:41.37,Thoughts-207-,,0,0,0,,Yılan balığının dikkatimi dağıtması yeterince odaklanmadığımı gösteriyor.Dialogue: 50,0:10:42.25,0:10:46.88,Main-207-,,0,0,0,,O tekniği denemenin tam sırası...Dialogue: 50,0:10:47.75,0:10:49.30,Main-207-,,0,0,0,,Denesem mi ki?Dialogue: 50,0:11:11.36,0:11:12.82,Main-207-,,0,0,0,,Kaçacak mısın?Dialogue: 50,0:11:14.61,0:11:19.87,Main-207-,,0,0,0,,Görme, duyma, koklama, tatma, dokunma ve sezgi...Dialogue: 50,0:11:19.87,0:11:24.37,Main-207-,,0,0,0,,İnsanın iyiliği, kötülüğü ve barışı taşıyan altı kökeni bunlardır.Dialogue: 50,0:11:24.71,0:11:26.12,Main-207-,,0,0,0,,Ne anlatıyorsun?Dialogue: 50,0:11:27.12,0:11:30.13,Main-207-,,0,0,0,,Ayrıca hepsi kusursuz olabilir ya da kusurlu olabilir.Dialogue: 50,0:11:30.79,0:11:33.09,Main-207-,,0,0,0,,İnsan hayatında 36 dünyevi arzu vardır.Dialogue: 50,0:11:36.67,0:11:40.35,Main-207-,,0,0,0,,Şu an sana bir top doğrultuyorum.Dialogue: 50,0:11:40.35,0:11:43.39,Main-207-,,0,0,0,,Senin tabancaların benim topuma karşı.Dialogue: 50,0:11:43.39,0:11:46.56,Main-207-,,0,0,0,,Menzil ve güç konusunda benim silahım daha üstün.Dialogue: 50,0:11:47.02,0:11:50.61,Main-207-,,0,0,0,,Şu ana kadar iyi dövüştün ama şimdi her şey bitecek!Dialogue: 50,0:11:56.86,0:11:58.28,Main-207-,,0,0,0,,Top mu?Dialogue: 50,0:11:58.66,0:12:00.03,Main-207-,,0,0,0,,Kafayı mı yedin?Dialogue: 50,0:12:00.03,0:12:02.24,Main-207-,,0,0,0,,Nerede bu bahsettiğin top?!Dialogue: 50,0:12:03.37,0:12:05.50,Main-207-,,0,0,0,,Hiç uçan...Dialogue: 50,0:12:05.50,0:12:07.21,Main-207-,,0,0,0,,kesiş saldırısı gördün mü?Dialogue: 50,0:12:07.21,0:12:09.12,Main-207-,,0,0,0,,Bu kadar saçmalık yeter!Dialogue: 50,0:12:11.09,0:12:12.71,Main-207-,,0,0,0,,Tek Kılıç Stili:Dialogue: 50,0:12:19.39,0:12:23.43,Main-207-,,0,0,0,,36 Poundluk Top!Dialogue: 50,0:12:40.66,0:12:42.12,Main-207-,,0,0,0,,Üzgünüm.Dialogue: 50,0:12:43.20,0:12:46.33,Main-207-,,0,0,0,,Kişisel değildi...Dialogue: 50,0:12:46.33,0:12:50.33,Main-207-,,0,0,0,,ama ben, hemen pes edecek biri değilim.Dialogue: 50,0:12:53.38,0:12:56.34,Main-207-,,0,0,0,,Her ne olursa olsun, hayatta kalacağım!Dialogue: 50,0:13:21.95,0:13:24.62,Main-207-,,0,0,0,,Lanet olsun...Dialogue: 50,0:13:26.58,0:13:30.21,Main-207-,,0,0,0,,Kayboldum...Dialogue: 50,0:13:30.21,0:13:32.54,Main-207-,,0,0,0,,Millet!Dialogue: 50,0:13:32.54,0:13:35.79,Main-207-,,0,0,0,,Luffy! Zoro! Robin!Dialogue: 50,0:13:37.17,0:13:40.42,Main-207-,,0,0,0,,Burada ölüme mi terk edileceğim?Dialogue: 50,0:13:40.42,0:13:43.30,Main-207-,,0,0,0,,Geyikler cennete alınır mı?Dialogue: 50,0:13:43.30,0:13:45.93,Main-207-,,0,0,0,,Doktor beni bekliyor mudur orada?Dialogue: 50,0:13:48.18,0:13:50.81,Main-207-,,0,0,0,,Hayır, bu düşüncelere kapılamam!Dialogue: 50,0:13:50.81,0:13:52.39,Main-207-,,0,0,0,,Ben bir doktorum!Dialogue: 50,0:13:52.39,0:13:56.02,Main-207-,,0,0,0,,Ölüm hakkında böyle düşünemem!Dialogue: 50,0:13:58.03,0:14:00.53,Main-207-,,0,0,0,,Ama cennet nasıl bir yerdir acaba...Dialogue: 50,0:14:01.70,0:14:04.03,Main-207-,,0,0,0,,Bekle, burası cennet değil mi?Dialogue: 50,0:14:04.03,0:14:04.82,Main-207-,,0,0,0,,Ha?!Dialogue: 50,0:14:06.83,0:14:09.79,Main-207-,,0,0,0,,Burası aradığımız harabeye benziyor.Dialogue: 50,0:14:10.79,0:14:12.29,Main-207-,,0,0,0,,Belki çoktan gelmişlerdir!Dialogue: 50,0:14:12.29,0:14:14.92,Main-207-,,0,0,0,,Sanırım harikayım!Dialogue: 50,0:14:14.92,0:14:17.04,Main-207-,,0,0,0,,Ah! İlk ben mi geldim acaba?!Dialogue: 50,0:14:17.04,0:14:17.92,Main-207-,,0,0,0,,Evet!Dialogue: 50,0:14:17.92,0:14:20.01,Main-207-,,0,0,0,,Burnum iyi çalıştı demek ki!Dialogue: 50,0:14:20.01,0:14:24.09,Main-207-,,0,0,0,,Yaşasın! İlk ben geldim!Dialogue: 50,0:14:26.10,0:14:27.43,Thoughts-207-,,0,0,0,,Bir tanuki...Dialogue: 50,0:14:26.10,0:14:27.43,Note-207-,,0,0,0,,Tanuki: Japon Rakun KöpeğiDialogue: 50,0:14:40.36,0:14:42.95,Main-207-,,0,0,0,,İstediğin kadar ateş et, faydasız!Dialogue: 50,0:14:42.95,0:14:46.82,Main-207-,,0,0,0,,Toplar ve silahlar, bana etki etmez!Dialogue: 50,0:14:46.82,0:14:48.24,Main-207-,,0,0,0,,Öyle görünüyor.Dialogue: 50,0:14:49.08,0:14:51.58,Main-207-,,0,0,0,,Başka bir yol deneyelim.Dialogue: 50,0:15:02.80,0:15:03.97,Main-207-,,0,0,0,,Bu koku da ne?!Dialogue: 50,0:15:03.97,0:15:06.80,Main-207-,,0,0,0,,Bu dialın içinde gaz var.Dialogue: 50,0:15:06.80,0:15:10.39,Main-207-,,0,0,0,,Bazukam da onu sana üflüyor.Dialogue: 50,0:15:10.39,0:15:15.98,Main-207-,,0,0,0,,Önce gaz dışarı atılır, sonra da avı küle çeviren mavi alevler halinde yanar!Dialogue: 50,0:15:33.33,0:15:34.33,Main-207-,,0,0,0,,N...?!Dialogue: 50,0:15:34.33,0:15:36.17,Main-207-,,0,0,0,,Dev ağacı deldi geçti!Dialogue: 50,0:15:37.54,0:15:38.29,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:15:39.04,0:15:40.09,Main-207-,,0,0,0,,Kayboldu!Dialogue: 50,0:15:50.64,0:15:52.51,Main-207-,,0,0,0,,Lastik-Lastik...Dialogue: 50,0:15:53.31,0:15:54.81,Main-207-,,0,0,0,,Tabanca!Dialogue: 50,0:16:02.19,0:16:05.03,Main-207-,,0,0,0,,Lastik-Lastik Damga!Dialogue: 50,0:16:27.38,0:16:28.55,Main-207-,,0,0,0,,Ucuz kurtuldum!Dialogue: 50,0:16:29.55,0:16:31.76,Main-207-,,0,0,0,,Lastik-Lastik...Dialogue: 50,0:16:32.60,0:16:33.72,Main-207-,,0,0,0,,Mızrak!Dialogue: 50,0:16:51.74,0:16:53.37,Main-207-,,0,0,0,,Bazuka istiyorsan,Dialogue: 50,0:16:53.87,0:16:55.49,Main-207-,,0,0,0,,al sana!Dialogue: 50,0:16:55.49,0:16:57.29,Main-207-,,0,0,0,,Hasır Şapka!Dialogue: 50,0:16:57.79,0:16:59.75,Main-207-,,0,0,0,,Lastik-Lastik...Dialogue: 50,0:16:59.75,0:17:01.42,Main-207-,,0,0,0,,Yanan...Dialogue: 50,0:17:05.50,0:17:08.63,Main-207-,,0,0,0,,– ...Bazuka! – ...Bazuka!Dialogue: 50,0:17:26.53,0:17:28.99,Main-207-,,0,0,0,,Hasır Şapka!Dialogue: 50,0:17:33.91,0:17:36.24,Main-207-,,0,0,0,,Şerefsiz!Dialogue: 50,0:17:40.16,0:17:41.67,Main-207-,,0,0,0,,Sanji-kun!Dialogue: 50,0:17:44.08,0:17:46.46,Main-207-,,0,0,0,,Sanji!Dialogue: 50,0:17:48.71,0:17:50.67,Main-207-,,0,0,0,,Sanji!Dialogue: 50,0:17:54.30,0:17:55.51,Main-207-,,0,0,0,,– Sanji-kun! – H-Hey!Dialogue: 50,0:17:56.26,0:17:58.52,Main-207-,,0,0,0,,Bir şey söyle, Sanji!Dialogue: 50,0:18:00.98,0:18:02.19,Main-207-,,0,0,0,,Hey!Dialogue: 50,0:18:02.64,0:18:04.65,Main-207-,,0,0,0,,Ne oldu?!Dialogue: 50,0:18:04.65,0:18:05.94,Main-207-,,0,0,0,,Sanji!Dialogue: 50,0:18:12.53,0:18:15.12,Main-207-,,0,0,0,,Hey! Kalbi atmıyor!Dialogue: 50,0:18:15.12,0:18:16.33,Main-207-,,0,0,0,,Olamaz!Dialogue: 50,0:18:22.58,0:18:24.67,Main-207-,,0,0,0,,Zavallı herif.Dialogue: 50,0:18:24.67,0:18:29.96,Main-207-,,0,0,0,,Oysa buraya kötü bir niyetle gelmemiştim.Dialogue: 50,0:18:31.30,0:18:34.30,Main-207-,,0,0,0,,O hâlde neden buradasın?!Dialogue: 50,0:18:36.01,0:18:38.72,Main-207-,,0,0,0,,Ne soğuk bir tavır bu...Dialogue: 50,0:18:42.23,0:18:47.90,Main-207-,,0,0,0,,Altı yıl oldu, eski Tanrı, Gan Fall.Dialogue: 0,0:02:28.46,0:02:34.76,Title-207-,,0,0,0,,Korsan Luffy, Berserker Wyper'a KarşıDialogue: 1,0:02:28.46,0:02:34.76,Title-207-,,0,0,0,,Korsan Luffy, Berserker Wyper'a KarşıDialogue: 0,0:00:46.73,0:00:50.90,Credits-207-,,0,0,0,,Video DüzenlemeDialo