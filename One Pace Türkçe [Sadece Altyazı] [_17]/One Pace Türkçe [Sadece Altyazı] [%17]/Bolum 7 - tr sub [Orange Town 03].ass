000000,0,0,0,0,100,100,0,0,1,1.9,1.9,2,180,180,27,1Style: Kanji-furigana,Duality,36,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,2.95,0,8,23,23,146,1Style: Karaoke-furigana,Duality,36,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,2.95,0,8,23,23,23,1Style: Lyrics-furigana,Duality,36,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,2.95,0,2,23,23,34,1Style: Lyrics,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,2,23,23,34,1Style: Karaoke,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,23,1Style: Kanji,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,146,1Style: Roger-Monologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1Style: Romaji ED,Josefin Sans,82,&H00FFFFFF,&H003592BE,&H00000000,&H64000000,0,0,0,0,100,100,0,0,1,0,4,8,10,10,20,1Style: Translation ED,Josefin Sans,82,&H00FFFFFF,&H000000FF,&H00FFFFFF,&H64000000,0,0,0,0,100,100,0,0,1,0,4,2,10,10,20,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Your media player does not support the subtitle format used in this episode. Subtitles will likely not function properly. Please use one of the recommended video players, preferably mpv: https://mpv.ioDialogue: 0,0:01:54.68,0:02:04.67,Warning,,0,0,0,,Your media player does not support the subtitle format used in this episode. Subtitles will likely not function properly. Please use one of the recommended video players, preferably mpv: https://mpv.ioDialogue: 50,0:01:53.22,0:01:54.55,Main-207-,,0,0,0,,Terslik var...Dialogue: 50,0:01:54.55,0:01:57.68,Main-207-,,0,0,0,,Başkan genelde bu kadar süre ortadan kaybolmaz.Dialogue: 50,0:01:57.68,0:02:00.39,Main-207-,,0,0,0,,Kasabada bir şeyler olmuş olmalı!Dialogue: 50,0:02:00.39,0:02:03.90,Main-207-,,0,0,0,,Ayrıca, normalden fazla top ateşi yapıldı!Dialogue: 50,0:02:03.90,0:02:07.32,Main-207-,,0,0,0,,Tamam, kontrol etmeye gideceğim. Siz burada kalın!Dialogue: 50,0:02:07.32,0:02:08.52,Main-207-,,0,0,0,,Ben de geleceğim!Dialogue: 50,0:02:08.78,0:02:13.53,Main-207-,,0,0,0,,Aptal olma! Onlar Buggy korsanları!Dialogue: 50,0:02:13.53,0:02:15.92,Main-207-,,0,0,0,,Bu yüzden hep beraber gitmeliyiz.Dialogue: 50,0:02:15.92,0:02:20.75,Main-207-,,0,0,0,,Eğer başkanı koruyamazsak, ne biçim halkız biz?Dialogue: 50,0:02:20.75,0:02:24.79,Main-207-,,0,0,0,,Bizi durdurmaya çalışma. Hepimiz bunu istiyoruz.Dialogue: 50,0:02:26.33,0:02:27.59,Main-207-,,0,0,0,,İstediğinizi yapın.Dialogue: 50,0:02:27.59,0:02:28.92,Main-207-,,0,0,0,,Gidelim, millet!Dialogue: 50,0:02:28.92,0:02:32.13,Main-207-,,0,0,0,,– Evet! – Evet!Dialogue: 50,0:02:35.97,0:02:40.68,Main-207-,,0,0,0,,Beni onun kadar sinirlendiren biriyle hiç karşılaşmadım.Dialogue: 50,0:02:40.68,0:02:44.66,Main-207-,,0,0,0,,Shanks beni hazinelerimden yoksun bıraktı.Dialogue: 50,0:02:44.66,0:02:47.26,Main-207-,,0,0,0,,Aranızdaki bağı bilmiyorum ama,Dialogue: 50,0:02:47.26,0:02:50.19,Main-207-,,0,0,0,,onun hakkında istediğimi söylemek hakkım!Dialogue: 50,0:02:54.36,0:02:56.64,Flashbacks-207-,,0,0,0,,– Hakla onu! Dövüşün! – Dik durun!Dialogue: 50,0:02:56.64,0:02:57.53,Main-207-,,0,0,0,,Kuzey kutbu!Dialogue: 50,0:02:57.53,0:02:58.41,Main-207-,,0,0,0,,Hayır, güney!Dialogue: 50,0:02:58.41,0:02:59.41,Main-207-,,0,0,0,,Yine başladın, ha?!Dialogue: 50,0:02:59.41,0:03:02.37,Main-207-,,0,0,0,,Aynen öyle! Çünkü haklıyım!Dialogue: 50,0:03:02.83,0:03:05.86,Main-207-,,0,0,0,,Vay, cesaretin var! Bu işi bir an önce bitirelim!Dialogue: 50,0:03:05.86,0:03:07.20,Main-207-,,0,0,0,,Gel öyleyse!Dialogue: 50,0:03:07.20,0:03:10.35,Main-207-,,0,0,0,,Hadi bakalım! Senin canına okuyacağım!Dialogue: 50,0:03:10.35,0:03:11.15,Main-207-,,0,0,0,,Gel!Dialogue: 50,0:03:11.15,0:03:12.32,Main-207-,,0,0,0,,Kesin şunu!Dialogue: 50,0:03:12.63,0:03:16.05,Main-207-,,0,0,0,,Kuzey ya da güney kutbu'nun soğuk olması kimin umrunda?Dialogue: 50,0:03:16.59,0:03:19.88,Main-207-,,0,0,0,,O kadar çok istiyorsanız, gidip kendiniz öğrenin!Dialogue: 50,0:03:19.88,0:03:21.14,Main-207-,,0,0,0,,Şimdi sakinleşin!Dialogue: 50,0:03:21.14,0:03:22.97,Main-207-,,0,0,0,,Bir gemi!Dialogue: 50,0:03:23.27,0:03:25.77,Main-207-,,0,0,0,,Düşman gemisi kuzeydoğudan yaklaşıyor!Dialogue: 50,0:03:25.78,0:03:28.52,Main-207-,,0,0,0,,Pekala, hazırlanın! Savaş zamanı!Dialogue: 50,0:03:28.52,0:03:30.02,Main-207-,,0,0,0,,– Evet! – Evet!Dialogue: 50,0:03:30.02,0:03:32.15,Main-207-,,0,0,0,,Harika! Fırtına gibi yağmalayacağım!Dialogue: 50,0:03:32.15,0:03:33.82,Main-207-,,0,0,0,,Mutlu görünüyorsun, Buggy!Dialogue: 50,0:03:33.82,0:03:34.61,Main-207-,,0,0,0,,Elbette!Dialogue: 50,0:03:35.03,0:03:37.78,Main-207-,,0,0,0,,Düşman gemisi hazine sandığı gibidir.Dialogue: 50,0:03:37.78,0:03:39.39,Main-207-,,0,0,0,,Korsanlar onları açmayı sever!Dialogue: 50,0:03:39.39,0:03:40.51,Main-207-,,0,0,0,,Yanlış mıyım?!Dialogue: 50,0:03:41.16,0:03:42.91,Main-207-,,0,0,0,,Evet, sebeplerden biri bu.Dialogue: 50,0:03:42.91,0:03:44.16,Main-207-,,0,0,0,,Çok safsın!Dialogue: 50,0:03:44.16,0:03:48.74,Main-207-,,0,0,0,,Sen ve diğer herkes hazineleri asla ciddiye almazsınız.Dialogue: 50,0:03:49.17,0:03:51.29,Main-207-,,0,0,0,,Korsan olmayı bilmiyorsun!Dialogue: 50,0:03:59.34,0:04:01.01,Main-207-,,0,0,0,,B-Bu ne?!Dialogue: 50,0:04:01.01,0:04:03.68,Main-207-,,0,0,0,,H-H-Hazine haritası!Dialogue: 50,0:04:04.29,0:04:07.64,Main-207-,,0,0,0,,İlk defa görüyorum! İnanılmaz!Dialogue: 50,0:04:08.64,0:04:11.54,Main-207-,,0,0,0,,Okyanusun dibinde bulunmayı bekliyor.Dialogue: 50,0:04:13.98,0:04:20.82,Thoughts-207-,,0,0,0,,Süper! Kaderim en gösterişli şekilde yeniden çizildi!Dialogue: 50,0:04:28.08,0:04:30.71,Secondary-207-,,0,0,0,,Bugün kolay bir galibiyet daha oldu!Dialogue: 50,0:04:30.71,0:04:32.17,Secondary-207-,,0,0,0,,Hey! Şerefe!Dialogue: 50,0:04:32.17,0:04:33.24,Main-207-,,0,0,0,,Hey, Buggy!Dialogue: 50,0:04:33.25,0:04:37.09,Main-207-,,0,0,0,,Herkesle birlikte kutlamayacak mısın? Epey ilginç ganimet var.Dialogue: 50,0:04:37.09,0:04:40.05,Main-207-,,0,0,0,,H-Hiçbir şey çalmadım, hiçbir şey de bilmiyorum!Dialogue: 50,0:04:40.05,0:04:42.80,Main-207-,,0,0,0,,Ha? Neden bahsediyorsun?Dialogue: 50,0:04:42.80,0:04:44.26,Main-207-,,0,0,0,,Uh, yok bi' şey...Dialogue: 50,0:04:48.06,0:04:51.94,Main-207-,,0,0,0,,Bir gün bu gemiden ayrılacağını söylemiştin.Dialogue: 50,0:04:51.94,0:04:54.02,Main-207-,,0,0,0,,Ne yapmayı planlıyorsun?Dialogue: 50,0:04:54.02,0:04:55.78,Main-207-,,0,0,0,,Kendi gemim olacak.Dialogue: 50,0:04:55.78,0:04:59.24,Main-207-,,0,0,0,,Güvenilir bir tayfa toplayıp dünyayı gezeceğim.Dialogue: 50,0:04:59.24,0:05:03.20,Main-207-,,0,0,0,,Güzelce, keyifli bir tempoda, elbette bir korsan olarak.Dialogue: 50,0:05:03.20,0:05:06.12,Main-207-,,0,0,0,,Hep o duygusal saçmalıkları söylüyorsun.Dialogue: 50,0:05:06.12,0:05:07.20,Main-207-,,0,0,0,,Ne dedin?Dialogue: 50,0:05:07.20,0:05:10.06,Main-207-,,0,0,0,,Savaş yeteneklerini takdir ediyorum.Dialogue: 50,0:05:10.06,0:05:14.38,Main-207-,,0,0,0,,Bu kadar duygusal olmasan, seni takipçim olarak alırdım.Dialogue: 50,0:05:14.38,0:05:16.62,Main-207-,,0,0,0,,Ben... Senin takipçin...? Şaka yapıyorsun.Dialogue: 50,0:05:16.62,0:05:17.20,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:05:18.51,0:05:20.22,Main-207-,,0,0,0,,Çok farklı düşünüyoruz,Dialogue: 50,0:05:20.22,0:05:23.09,Main-207-,,0,0,0,,yollarımızı ayırmamız daha iyi olur,Dialogue: 50,0:05:23.09,0:05:24.05,Main-207-,,0,0,0,,korsanlar olarak.Dialogue: 50,0:05:24.30,0:05:27.43,Main-207-,,0,0,0,,Hıh! Uzmanmışsın gibi konuşuyon, ha?Dialogue: 50,0:05:27.43,0:05:30.91,Main-207-,,0,0,0,,Ama, denizde karşılaşırsak, seni öldürmem gerekecek.Dialogue: 50,0:05:31.52,0:05:33.98,Main-207-,,0,0,0,,Evet, korsanlar öyle şeyler de yapar.Dialogue: 50,0:05:34.52,0:05:36.33,Main-207-,,0,0,0,,Seni hiç anlamıyorum.Dialogue: 50,0:05:37.28,0:05:40.74,Main-207-,,0,0,0,,Her neyse, ganimetten bahsettin ya...Dialogue: 50,0:05:40.74,0:05:43.03,Main-207-,,0,0,0,,Evet, şeytan meyvesi bulduk.Dialogue: 50,0:05:43.03,0:05:43.99,Main-207-,,0,0,0,,Şeytan meyvesi mi?Dialogue: 50,0:05:44.24,0:05:47.74,Main-207-,,0,0,0,,Deniz şeytanlarının vücut bulmuş hali derler.Dialogue: 50,0:05:47.74,0:05:50.12,Main-207-,,0,0,0,,Derler ki, şeytan meyvesi yersen,Dialogue: 50,0:05:50.12,0:05:53.79,Main-207-,,0,0,0,,güç kazanırsın ama deniz seni lanetler, çapa gibi dibe batarsın.Dialogue: 50,0:05:53.79,0:05:56.54,Main-207-,,0,0,0,,Yiyen kişi aptalın teki olmalı.Dialogue: 50,0:05:57.04,0:06:02.09,Thoughts-207-,,0,0,0,,Yüzemezsem, denizin dibindeki hazineyi ele geçiremem!Dialogue: 50,0:06:02.09,0:06:06.64,Main-207-,,0,0,0,,Ayrıca bu meyveyi 100 milyon beli'ye satabileceğini duydum.Dialogue: 50,0:06:08.93,0:06:09.71,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:06:10.98,0:06:15.06,Main-207-,,0,0,0,,Ben, korsan Buggy. Şimdi şeytan meyvesini yiyeceğim.Dialogue: 50,0:06:16.44,0:06:19.48,Main-207-,,0,0,0,,Gençler işte, hiç sonuçlarını düşünmezler...Dialogue: 50,0:06:21.11,0:06:23.80,Main-207-,,0,0,0,,– Vay! – Yedi!Dialogue: 50,0:06:24.91,0:06:27.91,Main-207-,,0,0,0,,Pekala Buggy, tuhaf bir şey hissediyor musun?Dialogue: 50,0:06:27.91,0:06:29.74,Main-207-,,0,0,0,,Ha... Hayır...Dialogue: 50,0:06:29.74,0:06:31.20,Main-207-,,0,0,0,,Ne? Sahte miydi?Dialogue: 50,0:06:31.95,0:06:36.06,Main-207-,,0,0,0,,Zaten şeytan meyvesi sadece bir efsane.Dialogue: 50,0:06:38.25,0:06:41.26,Main-207-,,0,0,0,,Tamamdır, her şey yolunda gitti.Dialogue: 50,0:06:41.26,0:06:44.00,Main-207-,,0,0,0,,Öğlen yediğim şey, kendim yaptığım sahte bir meyveydi!Dialogue: 50,0:06:44.00,0:06:46.73,Main-207-,,0,0,0,,Şaşırdım, her şey yolunda gitti!Dialogue: 50,0:06:46.73,0:06:49.64,Main-207-,,0,0,0,,Gerçek ortaya çıkmadan tüymeliyim!Dialogue: 50,0:06:49.89,0:06:52.77,Main-207-,,0,0,0,,Şeytan meyvesini satıp haritadaki hazineyiDialogue: 50,0:06:52.77,0:06:56.40,Main-207-,,0,0,0,,ele geçirdikten sonra, kendi korsan tayfamı oluşturabileceğim.Dialogue: 50,0:06:56.40,0:06:57.65,Main-207-,,0,0,0,,Hey, Buggy!Dialogue: 50,0:06:57.65,0:06:59.32,Main-207-,,0,0,0,,Neden mırıldanıp duruyorsun?Dialogue: 50,0:06:59.32,0:07:01.90,Main-207-,,0,0,0,,Oh, sen misin? Beni öyle korkutma.Dialogue: 50,0:07:01.90,0:07:03.69,Main-207-,,0,0,0,,O sıfat ne öyle?Dialogue: 50,0:07:04.40,0:07:07.66,Main-207-,,0,0,0,,Mutfağı sürekli soyarsan, aşçı sana hayatı zindan eder!Dialogue: 50,0:07:08.53,0:07:10.24,Main-207-,,0,0,0,,Öf, çok yakındı...Dialogue: 50,0:07:10.24,0:07:12.75,Main-207-,,0,0,0,,Aah, aklıma geldi! Kaptan az önce–Dialogue: 50,0:07:19.17,0:07:21.30,Main-207-,,0,0,0,,– Ne yapı...?! – Shanks! Lanet olası!Dialogue: 50,0:07:21.30,0:07:23.67,Main-207-,,0,0,0,,Benim... Benim... Ben...Dialogue: 50,0:07:24.67,0:07:26.22,Main-207-,,0,0,0,,O kağıt parçası ne?Dialogue: 50,0:07:26.22,0:07:28.64,Main-207-,,0,0,0,,Ahh, haritam!! Ahh!Dialogue: 50,0:07:29.05,0:07:30.89,Main-207-,,0,0,0,,Hey, Buggy!Dialogue: 50,0:07:32.85,0:07:35.69,Thoughts-207-,,0,0,0,,Ne? Kıpırdayamıyorum...Dialogue: 50,0:07:36.14,0:07:40.65,Thoughts-207-,,0,0,0,,Demek ki gerçekten bir çapa gibi batıyorsun! Lanet olsun!Dialogue: 50,0:07:41.19,0:07:43.15,Main-207-,,0,0,0,,Hey! Buggy! Ne yapıyorsun?Dialogue: 50,0:07:43.15,0:07:44.67,Main-207-,,0,0,0,,Yüzme konusunda harikasın!Dialogue: 50,0:07:48.07,0:07:48.78,Main-207-,,0,0,0,,Buggy!Dialogue: 50,0:07:49.74,0:07:52.74,Thoughts-207-,,0,0,0,,Y-Yardım edin...Dialogue: 50,0:07:52.74,0:07:57.75,Flashbacks-207-,,0,0,0,,Seni kurtaracağım, Buggy!Dialogue: 50,0:08:05.09,0:08:07.80,Main-207-,,0,0,0,,Demek Shanks hayatını kurtardı?Dialogue: 50,0:08:07.80,0:08:10.01,Main-207-,,0,0,0,,Anlatmaya çalıştığım bu değildi!Dialogue: 50,0:08:10.30,0:08:15.18,Main-207-,,0,0,0,,Onun yüzünden planım 10 yıl gecikti!Dialogue: 50,0:08:15.73,0:08:17.31,Main-207-,,0,0,0,,Ve sonra aydınlandım!Dialogue: 50,0:08:17.31,0:08:21.15,Main-207-,,0,0,0,,Eğer denizdeki hazineleri alamıyorsam, o zaman karadaki hazineleri...Dialogue: 50,0:08:21.65,0:08:24.90,Main-207-,,0,0,0,,...bölünme yeteneğimle alabilirim.Dialogue: 50,0:08:24.90,0:08:32.53,Main-207-,,0,0,0,,Bu yüzden hazineme dokunanı sağ bırakmam!Dialogue: 50,0:08:34.45,0:08:36.62,Main-207-,,0,0,0,,Onlar benim...Dialogue: 50,0:08:36.62,0:08:39.12,Main-207-,,0,0,0,,hazinelerim!Dialogue: 50,0:08:39.12,0:08:40.75,Main-207-,,0,0,0,,Kahretsin! Farketti!Dialogue: 50,0:08:42.67,0:08:45.63,Main-207-,,0,0,0,,Benden kaçabileceğini sanma, Nami!Dialogue: 50,0:08:46.17,0:08:48.63,Main-207-,,0,0,0,,Seni gerçekten gösterişli doğrayacağım.Dialogue: 50,0:09:02.02,0:09:06.48,Main-207-,,0,0,0,,Benim... T... top... toplarım...Dialogue: 50,0:09:07.11,0:09:09.45,Main-207-,,0,0,0,,Senin rakibin benim.Dialogue: 50,0:09:10.40,0:09:11.36,Main-207-,,0,0,0,,Hey!Dialogue: 50,0:09:11.61,0:09:14.33,Main-207-,,0,0,0,,Hazineyi bırakıp kaçmalısın!Dialogue: 50,0:09:14.33,0:09:15.58,Main-207-,,0,0,0,,Sürekli peşinden gelecek.Dialogue: 50,0:09:15.58,0:09:16.33,Main-207-,,0,0,0,,Olmaz!Dialogue: 50,0:09:16.79,0:09:20.00,Main-207-,,0,0,0,,Hazineyi bırak mı dedin?! Kesinlikle hayır!Dialogue: 50,0:09:20.00,0:09:22.68,Main-207-,,0,0,0,,Niye hazinemi bırakacak mışım?Dialogue: 50,0:09:23.38,0:09:25.46,Main-207-,,0,0,0,,Senin hazinen mi?!Dialogue: 50,0:09:25.46,0:09:27.21,Main-207-,,0,0,0,,Tabii öyle!Dialogue: 50,0:09:27.21,0:09:29.22,Main-207-,,0,0,0,,Ben korsanlardan çalan bir hırsızım.Dialogue: 50,0:09:29.22,0:09:31.43,Main-207-,,0,0,0,,Şimdi de bir korsandan çaldım.Dialogue: 50,0:09:32.43,0:09:35.86,Main-207-,,0,0,0,,O yüzden bütün hazine benim!Dialogue: 50,0:09:36.35,0:09:38.43,Main-207-,,0,0,0,,Oh, anladım!Dialogue: 50,0:09:38.43,0:09:41.56,Main-207-,,0,0,0,,Saçmalık! Onlar benim hazinem!Dialogue: 50,0:09:41.56,0:09:44.31,Main-207-,,0,0,0,,Çalmak, sahip olmanı mı sağlar?!Dialogue: 50,0:09:45.65,0:09:48.73,Main-207-,,0,0,0,,Cidden! Nasıl bir ortamda büyüdün?!Dialogue: 50,0:09:48.73,0:09:51.61,Main-207-,,0,0,0,,Bir hırsız, diğer hırsıza vaaz mı veriyor?Dialogue: 50,0:09:51.61,0:09:52.66,Main-207-,,0,0,0,,Saçmalık!Dialogue: 50,0:09:52.66,0:09:53.61,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:09:53.95,0:09:59.04,Main-207-,,0,0,0,,Kendimi siz korsanlarla aynı seviyeye düşürmeyeceğim!Dialogue: 50,0:10:01.71,0:10:04.42,Main-207-,,0,0,0,,Kendini hazırlasan iyi olur, Nami...Dialogue: 50,0:10:05.08,0:10:08.30,Main-207-,,0,0,0,,Bölük Pörçük...Dialogue: 50,0:10:09.76,0:10:12.76,Main-207-,,0,0,0,,Festival!Dialogue: 50,0:10:15.47,0:10:19.22,Main-207-,,0,0,0,,Arkadaşına yardım edebileceksen, şimdi yapmalısın, Lastik-Lastik.Dialogue: 50,0:10:19.22,0:10:22.77,Main-207-,,0,0,0,,Kahretsin, daha fazla parçaya ayrılıyor.Dialogue: 50,0:10:24.40,0:10:25.52,Main-207-,,0,0,0,,Bu da ne?Dialogue: 50,0:10:25.90,0:10:27.44,Main-207-,,0,0,0,,Nami!Dialogue: 50,0:10:27.73,0:10:30.23,Main-207-,,0,0,0,,Hazinemi geri ver!Dialogue: 50,0:10:29.19,0:10:30.23,Secondary-207-,,0,0,0,,Olmaz!Dialogue: 50,0:10:32.95,0:10:34.95,Main-207-,,0,0,0,,Agucuk, gugucuk!Dialogue: 50,0:10:40.66,0:10:42.33,Main-207-,,0,0,0,,Öf, çok inatçısın!Dialogue: 50,0:10:44.62,0:10:46.29,Main-207-,,0,0,0,,Dursana!Dialogue: 50,0:10:46.29,0:10:49.59,Main-207-,,0,0,0,,Durması gereken kişi sensin!Dialogue: 50,0:10:55.72,0:10:57.93,Main-207-,,0,0,0,,Geri verdiğin için teşekkürler!Dialogue: 50,0:10:59.64,0:11:04.44,Main-207-,,0,0,0,,Bırak! Bırak! Onlar benim!Dialogue: 50,0:11:00.31,0:11:04.44,Secondary-207-,,0,0,0,,Bırak mı?! Onlar benim hazinelerim!Dialogue: 50,0:11:04.44,0:11:06.02,Main-207-,,0,0,0,,Sen bırak!Dialogue: 50,0:11:09.52,0:11:11.82,Main-207-,,0,0,0,,Geber!Dialogue: 50,0:11:12.90,0:11:15.57,Main-207-,,0,0,0,,Sana rakibin benim dedim!Dialogue: 50,0:11:42.22,0:11:45.43,Main-207-,,0,0,0,,Bu tekmeyi başkandan bir hediye olarak düşünebilirsin.Dialogue: 50,0:11:47.85,0:11:49.81,Main-207-,,0,0,0,,Beni kurtardığın için saol.Dialogue: 50,0:11:49.81,0:11:51.57,Main-207-,,0,0,0,,Ah... rica ederim.Dialogue: 50,0:11:52.02,0:11:53.98,Main-207-,,0,0,0,,Evet! Harita!Dialogue: 50,0:11:52.61,0:11:53.98,Secondary-207-,,0,0,0,,Hazine–Dialogue: 50,0:11:54.44,0:11:57.95,Main-207-,,0,0,0,,Henüz bitmedi, Lastik-Lastik!Dialogue: 50,0:11:57.95,0:11:59.16,Main-207-,,0,0,0,,Hala hayatta!Dialogue: 50,0:11:59.16,0:12:00.53,Main-207-,,0,0,0,,Kapa çeneni!Dialogue: 50,0:12:00.53,0:12:03.91,Main-207-,,0,0,0,,Bana bu kadar acı çektirmeye nasıl cüret edersin!Dialogue: 50,0:12:03.91,0:12:06.21,Main-207-,,0,0,0,,Bunu ödeyeceksin!Dialogue: 50,0:12:07.25,0:12:09.71,Main-207-,,0,0,0,,Birleşin! Bölük Pörçük Parçalar!Dialogue: 50,0:12:17.38,0:12:18.19,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:12:21.47,0:12:22.68,Main-207-,,0,0,0,,Bunları mı arıyordun?!Dialogue: 50,0:12:23.76,0:12:24.64,Main-207-,,0,0,0,,Parçalarım!Dialogue: 50,0:12:26.64,0:12:28.64,Main-207-,,0,0,0,,Hırsız olduğuna şüphe yok!Dialogue: 50,0:12:28.64,0:12:30.31,Main-207-,,0,0,0,,Y-Y-Yapma!Dialogue: 50,0:12:30.31,0:12:32.19,Main-207-,,0,0,0,,Hazırlan, Buggy!Dialogue: 50,0:12:32.19,0:12:34.28,Main-207-,,0,0,0,,Lastik-Lastik...Dialogue: 50,0:12:35.40,0:12:37.28,Main-207-,,0,0,0,,Bazuka!Dialogue: 50,0:12:49.08,0:12:50.64,Main-207-,,0,0,0,,Kazandım!Dialogue: 50,0:12:52.88,0:12:56.01,Main-207-,,0,0,0,,Hey, Kaptan Buggy yenildi!Dialogue: 50,0:12:56.01,0:12:59.17,Main-207-,,0,0,0,,Ş-Şimdi ne yapacağız?!Dialogue: 50,0:12:59.17,0:13:00.93,Main-207-,,0,0,0,,Ölü taklidine devam!Dialogue: 50,0:13:00.93,0:13:01.64,Main-207-,,0,0,0,,İyi fikir!Dialogue: 50,0:13:07.10,0:13:09.14,Main-207-,,0,0,0,,Paramparça olmuş...Dialogue: 50,0:13:09.14,0:13:10.64,Main-207-,,0,0,0,,Şey, önemi yok!Dialogue: 50,0:13:10.64,0:13:11.90,Main-207-,,0,0,0,,Hala giyebilirim.Dialogue: 50,0:13:11.90,0:13:14.37,Main-207-,,0,0,0,,Buggy yenildiği için kızgın da değilim.Dialogue: 50,0:13:19.57,0:13:22.78,Main-207-,,0,0,0,,Endişelenme. Sonra senin için tamir ederim.Dialogue: 50,0:13:22.78,0:13:24.12,Main-207-,,0,0,0,,Ha? Ne?Dialogue: 50,0:13:24.12,0:13:25.37,Main-207-,,0,0,0,,Yok bir şey!Dialogue: 50,0:13:25.37,0:13:29.12,Main-207-,,0,0,0,,Neyse, çantayı ikiye böldüm, yarısını sen taşı!Dialogue: 50,0:13:29.12,0:13:31.37,Main-207-,,0,0,0,,Benim için çok ağır!Dialogue: 50,0:13:31.37,0:13:32.54,Main-207-,,0,0,0,,Bayağı çokmuş!Dialogue: 50,0:13:32.54,0:13:37.38,Main-207-,,0,0,0,,Hiçbir şey bilmiyorsa bile, Buggy hazinelerden anlıyormuş!Dialogue: 50,0:13:37.38,0:13:40.90,Main-207-,,0,0,0,,Büyük ihtimalle hepsi 10 milyon beli yapar!Dialogue: 50,0:13:45.51,0:13:46.72,Main-207-,,0,0,0,,Al bakalım.Dialogue: 50,0:13:46.72,0:13:47.22,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:13:47.22,0:13:50.48,Main-207-,,0,0,0,,Grand Line haritası. İstiyordun, değil mi?Dialogue: 50,0:13:50.48,0:13:51.48,Main-207-,,0,0,0,,Bana mı veriyorsun?!Dialogue: 50,0:13:51.48,0:13:53.27,Main-207-,,0,0,0,,Hayatımı kurtardın.Dialogue: 50,0:13:54.10,0:13:55.44,Main-207-,,0,0,0,,Saol, Nami!Dialogue: 50,0:13:55.44,0:13:58.69,Main-207-,,0,0,0,,Sonunda Grand Line'ın haritasını ele geçirdim!Dialogue: 50,0:13:58.69,0:14:00.19,Main-207-,,0,0,0,,Yaşasın!Dialogue: 50,0:14:00.57,0:14:03.57,Main-207-,,0,0,0,,Ah! Bu bize katıldığın anlamına mı geliyor?!Dialogue: 50,0:14:03.57,0:14:07.01,Main-207-,,0,0,0,,Söyledim ya, bir korsan tayfasına asla katılmam!Dialogue: 50,0:14:08.20,0:14:12.04,Main-207-,,0,0,0,,Ama sorun değil! Sizinle olmak bana çok para kazandıracak.Dialogue: 50,0:14:12.29,0:14:14.92,Main-207-,,0,0,0,,Ama, sadece birlikte çalışacağız.Dialogue: 50,0:14:14.92,0:14:16.34,Main-207-,,0,0,0,,Fazlası değil!Dialogue: 50,0:14:16.63,0:14:17.48,Main-207-,,0,0,0,,Tamam!Dialogue: 50,0:14:20.38,0:14:22.76,Main-207-,,0,0,0,,Hey, Zoro! Uyan!Dialogue: 50,0:14:22.76,0:14:24.94,Main-207-,,0,0,0,,Zoro! Gidiyoruz!Dialogue: 50,0:14:26.60,0:14:28.35,Main-207-,,0,0,0,,İcabına baktın mı?Dialogue: 50,0:14:27.60,0:14:28.35,Secondary-207-,,0,0,0,,Evet!Dialogue: 50,0:14:28.35,0:14:31.49,Main-207-,,0,0,0,,Harita ve rotacı, hepsini aldım!Dialogue: 50,0:14:36.44,0:14:39.53,Main-207-,,0,0,0,,Oh kahretsin, bayılacağım....  Kıpırdayamıyorum da....Dialogue: 50,0:14:39.53,0:14:43.82,Main-207-,,0,0,0,,Elbette. Eğer kıpırdayabilseydiniz, insan olmazdınız.Dialogue: 50,0:14:43.82,0:14:45.45,Main-207-,,0,0,0,,Niye beni de kattın?Dialogue: 50,0:14:45.45,0:14:47.78,Main-207-,,0,0,0,,Sen herkesten daha garipsin!Dialogue: 50,0:14:47.78,0:14:50.29,Main-207-,,0,0,0,,Her neyse, başkanla ilgilenmeliyiz.Dialogue: 50,0:14:50.29,0:14:51.41,Main-207-,,0,0,0,,Oh, doğru!Dialogue: 50,0:14:52.16,0:14:54.42,Main-207-,,0,0,0,,Yaşlı adamı da uyandırmalıyız.Dialogue: 50,0:14:54.42,0:14:55.37,Main-207-,,0,0,0,,Siz!Dialogue: 50,0:14:55.62,0:14:57.63,Main-207-,,0,0,0,,Buralı değilsiniz, değil mi?!Dialogue: 50,0:14:57.63,0:14:59.50,Main-207-,,0,0,0,,Evet. Siz kimsiniz?Dialogue: 50,0:15:00.05,0:15:02.01,Main-207-,,0,0,0,,Bizler kasaba halkıyız.Dialogue: 50,0:15:02.01,0:15:04.38,Main-207-,,0,0,0,,Korsanlar arasında anlaşmazlık mı çıktı?!Dialogue: 50,0:15:05.88,0:15:07.93,Main-207-,,0,0,0,,Bir şey biliyorsanız, söyleyin!Dialogue: 50,0:15:07.93,0:15:10.43,Main-207-,,0,0,0,,Oh, demek siz buranın halkısınız!Dialogue: 50,0:15:10.43,0:15:12.14,Main-207-,,0,0,0,,Daha fazla korsan olmasından korktum.Dialogue: 50,0:15:12.14,0:15:13.27,Main-207-,,0,0,0,,Oh, Başkan!Dialogue: 50,0:15:13.27,0:15:14.98,Main-207-,,0,0,0,,Ne oldu? Kendinize gelin!Dialogue: 50,0:15:14.98,0:15:16.19,Main-207-,,0,0,0,,Hey, Başkan!Dialogue: 50,0:15:16.19,0:15:18.40,Main-207-,,0,0,0,,– Bayılmış! – Bunu korsanlar yapmış olmalı.Dialogue: 50,0:15:18.40,0:15:20.27,Main-207-,,0,0,0,,Ne kadar korkunç!Dialogue: 50,0:15:20.27,0:15:23.19,Main-207-,,0,0,0,,Üzgünüm, onu bayıltmam gerekiyordu.Dialogue: 50,0:15:23.53,0:15:24.61,Main-207-,,0,0,0,,– Ne?! – Ne?!Dialogue: 50,0:15:24.99,0:15:27.24,Main-207-,,0,0,0,,Lan! Söylemen gerekmiyordu!Dialogue: 50,0:15:27.24,0:15:30.70,Main-207-,,0,0,0,,– Sen de gördün. – Evet de bunun iyi bir nedeni–Dialogue: 50,0:15:32.33,0:15:36.83,Main-207-,,0,0,0,,Niye başkanımızı incittiniz?Dialogue: 50,0:15:36.83,0:15:38.21,Main-207-,,0,0,0,,Mazeret uydurmayın!Dialogue: 50,0:15:38.50,0:15:41.04,Main-207-,,0,0,0,,Kimsiniz siz?! Korsanlarla bağlantınız mı var?!Dialogue: 50,0:15:42.09,0:15:43.84,Thoughts-207-,,0,0,0,,Gözleri dönmüş...Dialogue: 50,0:15:43.84,0:15:46.51,Thoughts-207-,,0,0,0,,Hırsız ya da korsan olduğumuz anlaşılırsa—Dialogue: 50,0:15:46.76,0:15:47.84,Main-207-,,0,0,0,,Biz korsanız!Dialogue: 50,0:15:51.26,0:15:52.51,Main-207-,,0,0,0,,– Biz de öyle sanmıştık! – Biz de öyle sanmıştık!Dialogue: 50,0:15:54.18,0:15:54.93,Main-207-,,0,0,0,,Aptal!Dialogue: 50,0:15:54.93,0:15:55.85,Main-207-,,0,0,0,,Ama doğru!Dialogue: 50,0:15:55.85,0:15:59.40,Main-207-,,0,0,0,,Korsanlar! Kasabamızı nasıl mahvedersiniz?!Dialogue: 50,0:15:59.40,0:16:01.33,Main-207-,,0,0,0,,Çocuk olsanız da sizi affetmeyeceğiz!Dialogue: 50,0:16:02.61,0:16:05.96,Main-207-,,0,0,0,,Şimdi ne olacak? Artık hiçbir şey dinlemeyecekler.Dialogue: 50,0:16:07.49,0:16:10.22,Main-207-,,0,0,0,,Kaçın!Dialogue: 50,0:16:11.28,0:16:12.70,Main-207-,,0,0,0,,Kaçamayacaksınız!Dialogue: 50,0:16:12.70,0:16:16.12,Main-207-,,0,0,0,,Başkanımızı incitmeye nasıl cüret edersiniz!?Dialogue: 50,0:16:21.25,0:16:23.92,Main-207-,,0,0,0,,Neden işleri daha da berbat ettin?!Dialogue: 50,0:16:23.92,0:16:25.26,Main-207-,,0,0,0,,Burası iyi bir kasaba.Dialogue: 50,0:16:24.76,0:16:25.26,Secondary-207-,,0,0,0,,Ha?!Dialogue: 50,0:16:25.80,0:16:29.72,Main-207-,,0,0,0,,Herkes başkanlarının başına gelenler yüzünden öfkeli!Dialogue: 50,0:16:33.93,0:16:38.10,Main-207-,,0,0,0,,Ne söylersek söyleyelim sonucu böyle olacaktı!Dialogue: 50,0:16:38.10,0:16:39.39,Main-207-,,0,0,0,,Hey, sağa!Dialogue: 50,0:16:39.39,0:16:42.11,Main-207-,,0,0,0,,D-Dur! Son anda söylemesene!Dialogue: 50,0:16:42.11,0:16:43.57,Main-207-,,0,0,0,,Ara sokağa saptılar!Dialogue: 50,0:16:48.32,0:16:49.86,Main-207-,,0,0,0,,N...? Chouchou?!Dialogue: 50,0:16:50.28,0:16:51.66,Main-207-,,0,0,0,,Köpek!Dialogue: 50,0:16:56.08,0:16:57.91,Main-207-,,0,0,0,,H-Hey! Yoldan çekil, Chouchou!Dialogue: 50,0:16:57.91,0:16:58.58,Main-207-,,0,0,0,,Hey!Dialogue: 50,0:16:58.58,0:17:02.00,Main-207-,,0,0,0,,– Onlar kötü korsanlar! – Yanlış kişilere havlıyorsun!Dialogue: 50,0:17:04.04,0:17:05.59,Main-207-,,0,0,0,,Niye bizi engelliyorsun?!Dialogue: 50,0:17:05.59,0:17:06.67,Main-207-,,0,0,0,,Chouchou! Bırak geçelim!Dialogue: 50,0:17:08.42,0:17:11.94,Main-207-,,0,0,0,,Görüşürüz, köpek!Dialogue: 50,0:17:20.56,0:17:22.15,Main-207-,,0,0,0,,Tanrı'ya şükür.Dialogue: 50,0:17:22.15,0:17:24.44,Main-207-,,0,0,0,,Chouchou sayesinde kaçmayı başardık.Dialogue: 50,0:17:24.44,0:17:26.90,Main-207-,,0,0,0,,Hem niye böyle bir durumda kaldık ki?Dialogue: 50,0:17:26.90,0:17:29.86,Main-207-,,0,0,0,,Ne fark eder? İstediğimiz şeyi başardık.Dialogue: 50,0:17:29.86,0:17:31.53,Main-207-,,0,0,0,,Öyle, ama...Dialogue: 50,0:17:31.53,0:17:33.16,Main-207-,,0,0,0,,Hey, bu senin teknen mi?!Dialogue: 50,0:17:33.16,0:17:34.78,Main-207-,,0,0,0,,Çok güzel!Dialogue: 50,0:17:34.78,0:17:37.41,Main-207-,,0,0,0,,Nesi harika?Dialogue: 50,0:17:37.41,0:17:39.83,Main-207-,,0,0,0,,Bir grup aptal korsandan aldım.Dialogue: 50,0:17:39.83,0:17:41.54,Main-207-,,0,0,0,,Pis bir ağzın var!Dialogue: 50,0:17:43.13,0:17:44.92,Main-207-,,0,0,0,,Seni bekliyorduk, hırsız!Dialogue: 50,0:17:44.92,0:17:47.75,Main-207-,,0,0,0,,Tekrar karşılaşacağımızı düşünmediniz, değil mi?!Dialogue: 50,0:17:50.01,0:17:51.43,Main-207-,,0,0,0,,Onları tanıyor musun?Dialogue: 50,0:17:51.43,0:17:52.63,Main-207-,,0,0,0,,Evet... birazcık!Dialogue: 50,0:17:52.63,0:17:56.10,Main-207-,,0,0,0,,Tam tersine! Kaderimiz birbirine bağlı!Dialogue: 50,0:17:56.10,0:18:00.48,Main-207-,,0,0,0,,Demek arkadaşların, ha? Öyleyse başkalarının eşyalarını...Dialogue: 50,0:18:00.48,0:18:04.52,Main-207-,,0,0,0,,...çalmak konusunda, hepinize bir ders vermemiz gerekecek!Dialogue: 50,0:18:04.52,0:18:09.74,Main-207-,,0,0,0,,Hey, sen! Beni biraz dikkate alır mısın?!Dialogue: 50,0:18:10.24,0:18:11.11,Main-207-,,0,0,0,,Ha?!Dialogue: 50,0:18:19.54,0:18:22.50,Main-207-,,0,0,0,,Başkan! Kendinize geldiniz mi?!Dialogue: 50,0:18:23.42,0:18:26.17,Main-207-,,0,0,0,,Tanrı'ya şükür iyisiniz.Dialogue: 50,0:18:26.17,0:18:28.06,Main-207-,,0,0,0,,Ne oldu?!Dialogue: 50,0:18:30.38,0:18:31.51,Main-207-,,0,0,0,,Bu...?!Dialogue: 50,0:18:31.51,0:18:34.05,Main-207-,,0,0,0,,Geldiğimizde bu haldeydi.Dialogue: 50,0:18:34.05,0:18:37.93,Main-207-,,0,0,0,,Kalan korsanlar iz bırakmadan kayboldu!Dialogue: 50,0:18:38.93,0:18:41.27,Main-207-,,0,0,0,,Neler olduğunu gördünüz mü?!Dialogue: 50,0:18:41.27,0:18:42.93,Main-207-,,0,0,0,,Gençler nerede?!Dialogue: 50,0:18:42.43,0:18:42.93,Secondary-207-,,0,0,0,,Ha?Dialogue: 50,0:18:42.93,0:18:44.14,Main-207-,,0,0,0,,"Gençler" mi?Dialogue: 50,0:18:44.14,0:18:46.27,Main-207-,,0,0,0,,O üç çocuktan mı bahsediyorsun?Dialogue: 50,0:18:46.86,0:18:49.37,Main-207-,,0,0,0,,Yani yaşıyorlar mı?!Dialogue: 50,0:18:50.73,0:18:54.74,Main-207-,,0,0,0,,O aptallar, benim gibi yaşlı birine nasıl zarar verebilirler?!Dialogue: 50,0:18:56.70,0:19:00.70,Main-207-,,0,0,0,,Az önce o aptalları defettik!Dialogue: 50,0:19:00.70,0:19:01.79,Main-207-,,0,0,0,,Ama öfkemiz dinmedi...!Dialogue: 50,0:19:02.16,0:19:04.79,Main-207-,,0,0,0,,Sanırım bizimle eğleniyorlardı.Dialogue: 50,0:19:04.79,0:19:10.21,Main-207-,,0,0,0,,Kasabamıza saldırdıklarında nasıl hissettiğimizi asla anlayamazlar!Dialogue: 50,0:19:10.21,0:19:11.30,Main-207-,,0,0,0,,Evet! Doğru!Dialogue: 50,0:19:11.30,0:19:13.17,Main-207-,,0,0,0,,Onları çok geç olmadan yakalayal–Dialogue: 50,0:19:13.17,0:19:14.76,Main-207-,,0,0,0,,Yeter artık!Dialogue: 50,0:19:14.76,0:19:17.68,Main-207-,,0,0,0,,Onları azarlayacak tek kişi benim!Dialogue: 50,0:19:18.10,0:19:21.35,Main-207-,,0,0,0,,Onlar hakkında kötü konuşmanıza izin vermem!Dialogue: 50,0:19:21.35,0:19:24.18,Main-207-,,0,0,0,,N-Ne oluyor?! Neden korsanları koruyorsunuz?!Dialogue: 50,0:19:24.18,0:19:27.52,Main-207-,,0,0,0,,Öylece gidebileceklerini mi sanıyorlar?!Dialogue: 50,0:19:27.52,0:19:28.61,Main-207-,,0,0,0,,Nereye gittiler?!Dialogue: 50,0:19:28.61,0:19:31.65,Main-207-,,0,0,0,,Şey... iskeleye doğru gittiler.Dialogue: 50,0:19:33.11,0:19:35.11,Main-207-,,0,0,0,,Lanet olsun!Dialogue: 50,0:19:33.11,0:19:35.11,Main-207-,,0,0,0,,– Başkan! Başkan! – Başkan! Başkan!Dialogue: 50,0:19:35.11,0:19:38.41,Main-207-,,0,0,0,,Kasabamda istediklerini yapabileceklerini sanıyorlar!Dialogue: 50,0:19:38.41,0:19:42.37,Main-207-,,0,0,0,,Hala size söyleyecek çok şeyim var!Dialogue: 50,0:19:46.12,0:19:47.68,Main-207-,,0,0,0,,Pekala! Gidelim!Dialogue: 50,0:19:48.58,0:19:52.34,Main-207-,,0,0,0,,Geminde hala Buggy'nin bayrağı mı dalgalanıyor?Dialogue: 50,0:19:52.34,0:19:55.34,Main-207-,,0,0,0,,Çünkü bu onların teknesi... Başka bir zaman indireceğim.Dialogue: 50,0:19:57.22,0:20:01.18,Main-207-,,0,0,0,,Hey! Durun! Gençler!Dialogue: 50,0:20:01.18,0:20:02.64,Main-207-,,0,0,0,,İhtiyar başkan!Dialogue: 50,0:20:10.86,0:20:13.57,Thoughts-207-,,0,0,0,,Ölmeye hazırdım!Dialogue: 50,0:20:13.57,0:20:17.30,Thoughts-207-,,0,0,0,,Çaresiz ve umutsuz halde ölmeye hazırdım!Dialogue: 50,0:20:18.95,0:20:20.78,Main-207-,,0,0,0,,Teşekkürler! Size borçluyuz!Dialogue: 50,0:20:24.20,0:20:27.25,Main-207-,,0,0,0,,Dert etme! Rahatına bak!Dialogue: 50,0:20:27.71,0:20:31.71,Thoughts-207-,,0,0,0,,Sizi gençler. Sizi gençler!Dialogue: 50,0:20:31.71,0:20:34.44,Thoughts-207-,,0,0,0,,Sizi gençler...Dialogue: 50,0:20:36.26,0:20:38.02,Main-207-,,0,0,0,,Söyleyecek sözüm kalmadı...Dialogue: 50,0:20:42.60,0:20:44.18,Main-207-,,0,0,0,,Hm... Ne?Dialogue: 50,0:20:44.18,0:20:46.02,Main-207-,,0,0,0,,Ne dedin sen?!Dialogue: 50,0:20:46.27,0:20:48.44,Main-207-,,0,0,0,,Hazine torbalarından birini bıraktın mı?!Dialogue: 50,0:20:48.44,0:20:48.89,Main-207-,,0,0,0,,Aynen.Dialogue: 50,0:20:48.89,0:20:52.02,Main-207-,,0,0,0,,Sadece o bir torba 5 milyon beli değerinde!Dialogue: 50,0:20:52.02,0:20:55.53,Main-207-,,0,0,0,,Ama şehri yeniden kuracaklarsa, paraya ihtiyaçları olacak, değil mi?Dialogue: 50,0:20:55.53,0:20:57.44,Main-207-,,0,0,0,,O benim hazinemdi!Dialogue: 50,0:20:57.82,0:21:00.41,Main-207-,,0,0,0,,Onu çalmak benim için ne kadar zordu biliyor musun?Dialogue: 50,0:21:01.07,0:21:02.91,Main-207-,,0,0,0,,Bunu niye yaptın?!Dialogue: 50,0:21:02.91,0:21:04.91,Main-207-,,0,0,0,,Kes şunu! Yüzemiyorum!Dialogue: 50,0:21:04.91,0:21:06.66,Main-207-,,0,0,0,,Biliyorum!Dialogue: 50,0:21:06.66,0:21:08.54,Main-207-,,0,0,0,,İstiyorsan, geri dön al o zaman!Dialogue: 50,0:21:08.54,0:21:10.75,Main-207-,,0,0,0,,Bunu yapamam! Sen git al!Dialogue: 50,0:21:10.75,0:21:13.54,Main-207-,,0,0,0,,Hayır! Bu gerçekten tehlikeli! Ölebilirim!Dialogue: 50,0:21:13.54,0:21:15.21,Main-207-,,0,0,0,,Öl o zaman!Dialogue: 50,0:21:15.75,0:21:18.63,Main-207-,,0,0,0,,Bir daha yaparsan seni gerçekten denize atarım!Dialogue: 50,0:21:20.34,0:21:23.39,Thoughts-207-,,0,0,0,,İyi ya da kötü,...Dialogue: 50,0:21:23.39,0:21:28.06,Thoughts-207-,,0,0,0,,görünüyor ki artık yolculuğumuz için bir rotacımız var.Dialogue: 0,0:01:50.01,0:01:53.22,Captions-207-,,0,0,0,,Kasaba Halkının Acil Durum SığınağıDialogue: 1,0:01:50.01,0:01:53.22,Captions-207-,,0,0,0,,Kasaba Halkının Acil Durum SığınağıDialogue: 0,0:02:35.26,0:02:40.72,Title-207-,,0,0,0,,Korsan "Palyaço" BuggyDialogue: 0,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 1,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 0,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Galaxy 9000Dialogue: 1,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Galaxy 9000Dialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,MüzikDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,MüzikDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,HaleeDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,HaleeDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,GrafikDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,GrafikDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,Datenshi JimmyVictus KaitouYahiko YagDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,Datenshi JimmyVictus KaitouYahiko YagDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,Rayleigh Art FixDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,Rayleigh Art FixDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,Aphantastic Rabbit zukushiLDDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,Ap