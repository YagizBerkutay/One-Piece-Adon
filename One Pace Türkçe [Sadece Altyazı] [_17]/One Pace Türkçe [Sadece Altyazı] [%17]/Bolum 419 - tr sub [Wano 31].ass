[Script Info]Title: Default Aegisub fileScriptType: v4.00+WrapStyle: 0ScaledBorderAndShadow: yesYCbCr Matrix: TV.709PlayResX: 1920LayoutResX: 1920LayoutResY: 1080PlayResY: 1080[V4+ Styles]Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, EncodingStyle: Main-207+,Impress BT Pace,82,&H00FFFFFF,&H000000FF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,300,300,27,1Style: Thoughts-207+,Impress BT Pace,82,&H00FFFFFF,&H00FFFFFF,&H00525252,&H78000000,0,0,0,0,100,100,0,0,1,4.2,3.8,2,300,300,27,1Style: Title-207+,Gilroy-Bold,110,&H00FEFEFE,&H000000FF,&H00000000,&H00000000,-1,0,0,0,100,100,0,0,1,2.5,0,2,15,15,360,1Style: Captions-207+,Impress BT Pace,60,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,3,0,2,15,15,30,1Style: Credits-207+,Gilroy-Medium,45,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,105,105,1.5,0,1,3.7,0,7,15,15,15,1Style: Narrator-207+,Impress BT Pace,80,&H00FFFFFF,&H000000FF,&H00000000,&H78000000,0,-1,0,0,100,100,0,0,1,3.8,3.8,8,300,300,27,1Style: Warning,Impress BT Pace,90,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,2,2,2,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 50,0:00:13.58,0:00:16.12,Narrator-207+,,0,0,0,,Reverie olarak da bilinen Dünya Konferansı;Dialogue: 50,0:00:16.83,0:00:19.50,Narrator-207+,,0,0,0,,Dünya Hükûmeti'ne bağlı...Dialogue: 50,0:00:19.50,0:00:25.76,Narrator-207+,,0,0,0,,170'ten fazla ülkeyi temsil eden elli kral ve kraliçenin katıldığı büyük bir toplantıdır.Dialogue: 50,0:00:25.76,0:00:28.76,Narrator-207+,,0,0,0,,Her dört yılda bir tekrarlanır.Dialogue: 50,0:00:34.97,0:00:38.98,Narrator-207+,,0,0,0,,Her zamanki gibi Reverie yine büyük bir kargaşayla bitti...Dialogue: 50,0:00:38.98,0:00:42.27,Narrator-207+,,0,0,0,,ve tüm temsilciler evlerine geri döndü.Dialogue: 50,0:00:43.11,0:00:44.11,Narrator-207+,,0,0,0,,Ardından...Dialogue: 50,0:00:45.90,0:00:48.32,Narrator-207+,,0,0,0,,Bir hafta sonra...Dialogue: 50,0:00:49.65,0:00:53.20,Main-207+,,0,0,20,,Şükürler olsun ki sonunda evime döndüm.Dialogue: 50,0:00:53.20,0:00:58.16,Main-207+,,0,0,0,,Sahiden, yukarıdaki dünya bizden çok uzak.Dialogue: 50,0:00:58.54,0:01:02.17,Main-207+,,0,0,0,,Bize eşlik ettiğiniz için size çok teşekkür ederiz...Dialogue: 50,0:01:02.17,0:01:04.50,Main-207+,,0,0,0,,Luffy-sama'nın dedesi!Dialogue: 50,0:01:04.50,0:01:07.42,Main-207+,,0,0,0,,Epey uzun bir yolculuk oldu ha, Neptune?Dialogue: 50,0:01:07.76,0:01:09.67,Main-207+,,0,0,0,,Yorulmuş olmalısın!Dialogue: 50,0:01:11.84,0:01:13.76,Main-207+,,0,0,0,,Öldüm, bittim.Dialogue: 50,0:01:13.76,0:01:17.22,Main-207+,,0,0,0,,Garp, bizimle kal da biraz dinlenip kendine gel.Dialogue: 50,0:01:17.22,0:01:20.94,Main-207+,,0,0,0,,Eh, bir çayınızı içeyim o zaman...Dialogue: 50,0:01:20.94,0:01:24.94,Main-207+,,0,0,0,,ama vaziyet ortada, pek kalamam buralarda.Dialogue: 50,0:01:26.61,0:01:29.44,Main-207+,,0,0,0,,Reverie hep büyük olaylara gebedir.Dialogue: 50,0:01:30.24,0:01:35.41,Main-207+,,0,0,0,,Elli ülke toplandığında işler öyle sadece "anlaşalım" demekle bitmiyor.Dialogue: 50,0:01:36.20,0:01:39.16,Main-207+,,0,0,0,,Her birinin kendi iç meseleleri var.Dialogue: 50,0:01:39.58,0:01:43.17,Main-207+,,0,0,0,,Büyük devletler sessizce birbirini süzerken...Dialogue: 50,0:01:43.17,0:01:45.50,Main-207+,,0,0,0,,aradaki küçükleri didişmeye bırakıyorlar.Dialogue: 50,0:01:48.34,0:01:52.43,Main-207+,,0,0,0,,Ellerindeki kaynakları ve teknolojiyi göz korkutmak için kullanıyorlar.Dialogue: 50,0:01:54.80,0:01:59.27,Main-207+,,0,0,0,,Tüm ülkelerin eşit olduğu savunuluyor ama sadece lafta.Dialogue: 50,0:01:59.81,0:02:06.11,Main-207+,,0,0,0,,Zenginlik ve inanç ayrılıkları varken asla eşit olamazlar!Dialogue: 50,0:02:11.78,0:02:16.32,Main-207+,,0,0,0,,El sıkışıp gülerler ama arkadan birbirlerinin kuyusunu seve seve kazarlar.Dialogue: 50,0:02:16.32,0:02:23.08,Main-207+,,0,0,0,,Kendi halkı kadar başkalarını da düşünen kaç lider kalmıştır ki?Dialogue: 50,0:02:23.08,0:02:25.42,Main-207+,,0,0,0,,Kıçımın yuvarlak masası...Dialogue: 50,0:02:25.42,0:02:30.21,Main-207+,,0,0,0,,Haklısın. Hükümdarlar arasındaki görüşmeler pamuk ipliğine bağlıydı.Dialogue: 50,0:02:30.21,0:02:36.55,Main-207+,,0,0,0,,Biz de istisna değiliz ama ülkeler arasındaki çekişmeler öyle kolay çözülmüyor.Dialogue: 50,0:02:37.01,0:02:39.22,Main-207+,,0,0,0,,Bir ülkenin tarihi ne kadar eskiyse,Dialogue: 50,0:02:39.22,0:02:42.52,Main-207+,,0,0,0,,anlaşmazlığın kökleri de o kadar derine iner.Dialogue: 50,0:02:43.43,0:02:49.19,Main-207+,,0,0,0,,Anlaşmazlık olsa bile kan dökülmediği sürece ben bu duruma barış derim.Dialogue: 50,0:02:50.19,0:02:52.78,Main-207+,,0,0,0,,Ama bu sefer yaşananlar felaketti!Dialogue: 50,0:02:53.32,0:02:58.57,Main-207+,,0,0,0,,Biraz geç oldu ama size henüz bahsetmediğim bir şey daha var.Dialogue: 50,0:02:58.57,0:03:03.75,Main-207+,,0,0,0,,Reverie dağılıp yola çıktığımızda, bir hadise vuku buldu.Dialogue: 50,0:03:04.08,0:03:06.50,Main-207+,,0,0,0,,Raporu ben gemideyken ilettiler.Dialogue: 50,0:03:07.46,0:03:11.92,Main-207+,,0,0,0,,Biz Denizciler bunu çözmek için elimizden geleni yapacağız,Dialogue: 50,0:03:12.34,0:03:15.34,Main-207+,,0,0,0,,ama lütfen yüzeyden ve biz insanlardan korkmayın!Dialogue: 50,0:03:16.34,0:03:17.84,Main-207+,,0,0,0,,Ne oldu?Dialogue: 50,0:03:17.84,0:03:21.60,Main-207+,,0,0,0,,Garp, nasıl bir rapor aldın?Dialogue: 50,0:03:22.64,0:03:25.60,Main-207+,,0,0,0,,Alabasta Krallığı'nı ilgilendiren bir olay.Dialogue: 50,0:03:25.60,0:03:27.56,Main-207+,,0,0,0,,Alabasta Krallığı...Dialogue: 50,0:03:28.90,0:03:30.36,Main-207+,,0,0,0,,Vivi-sama!Dialogue: 50,0:03:32.40,0:03:35.32,Narrator-207+,,0,0,0,,Tüm bunlar yaşanmadan önce,Dialogue: 50,0:03:35.86,0:03:39.62,Narrator-207+,,0,0,0,,tam Reverie bittiği sırada Dünya Ekonomi Gazetesi'nde...Dialogue: 50,0:03:40.24,0:03:43.24,Main-207+,,0,0,0,,İnanılmaz! Ardı ardına şeyler yaşanıyor!Dialogue: 50,0:03:43.24,0:03:46.12,Main-207+,,0,0,0,,Bir anda nasıl bu kadar çok şey oldu anlayamıyorum.Dialogue: 50,0:03:46.12,0:03:49.33,Main-207+,,0,0,0,,Dinleyin! Bana şimdiye kadarki en harika manşeti bulun!Dialogue: 50,0:03:50.46,0:03:53.71,Main-207+,,0,0,0,,Efendim, hangi haberi ön sayfaya basalım?Dialogue: 50,0:03:54.67,0:03:56.97,Main-207+,,0,0,0,,Dinleyin! Elimizde bir ölüm haberi var!Dialogue: 50,0:03:56.97,0:03:59.84,Main-207+,,0,0,0,,Büyük ölüm haberleri çok gazete sattırıyor.Dialogue: 50,0:03:59.84,0:04:00.97,Main-207+,,0,0,0,,O hâlde başla–Dialogue: 50,0:04:00.97,0:04:02.47,Main-207+,,0,0,0,,Hayır, bekle!Dialogue: 50,0:04:02.47,0:04:04.72,Main-207+,,0,0,0,,Toplantının sonucu da uyar gibi!Dialogue: 50,0:04:04.72,0:04:08.23,Main-207+,,0,0,0,,Suikast girişimi de dikkatleri çekebilir!Dialogue: 50,0:04:08.23,0:04:09.40,Main-207+,,0,0,0,,Çok doğru!Dialogue: 50,0:04:09.40,0:04:11.27,Main-207+,,0,0,0,,Ön sayfada iki tanesini paylaşacağız!Dialogue: 50,0:04:11.27,0:04:13.52,Main-207+,,0,0,0,,Arka sayfa da aynı formatta olacak!Dialogue: 50,0:04:13.52,0:04:14.82,Main-207+,,0,0,0,,– Anlaşıldı! – Anlaşıldı!Dialogue: 50,0:04:14.82,0:04:16.40,Main-207+,,0,0,0,,Efendim!Dialogue: 50,0:04:16.40,0:04:18.36,Main-207+,,0,0,0,,Hükûmetten acil posta geldi!Dialogue: 50,0:04:19.41,0:04:20.78,Main-207+,,0,0,0,,Bir çek, ha?Dialogue: 50,0:04:20.78,0:04:23.03,Main-207+,,0,0,0,,Oh, bayağı iyimiş!Dialogue: 50,0:04:23.03,0:04:26.29,Main-207+,,0,0,0,,Demek öyle... Haberi çarpıtmamızı istiyorlar!Dialogue: 50,0:04:26.29,0:04:28.66,Main-207+,,0,0,0,,Ama neden ki?Dialogue: 50,0:04:32.13,0:04:35.34,Main-207+,,0,0,0,,Bu olayı gizlemek için ne bu acele?!Dialogue: 50,0:04:35.34,0:04:36.84,Main-207+,,0,0,0,,Hayatta olmaz!Dialogue: 50,0:04:37.38,0:04:39.34,Main-207+,,0,0,0,,Çeki götlerine soksunlar!Dialogue: 50,0:04:40.30,0:04:41.34,Main-207+,,0,0,0,,Hey, sorun ne?Dialogue: 50,0:04:41.34,0:04:43.39,Main-207+,,0,0,0,,Hayır, hayır, hayır...Dialogue: 50,0:04:46.60,0:04:49.52,Main-207+,,0,0,0,,Sana söyleneni yapacaksın, Morgans!Dialogue: 50,0:04:49.52,0:04:50.73,Main-207+,,0,0,0,,Gizli teşkilat...Dialogue: 50,0:04:50.73,0:04:52.15,Main-207+,,0,0,0,,Cipher Pol mu?!Dialogue: 50,0:04:52.52,0:04:55.98,Main-207+,,0,0,0,,Dünya Hükûmeti'nin emirlerine uymak zorundasınız.Dialogue: 50,0:04:55.98,0:04:56.86,Main-207+,,0,0,0,,Kıpırdama!Dialogue: 50,0:05:01.45,0:05:05.87,Main-207+,,0,0,0,,Büyük Haberler Morgans'ı asla küçümsemeyin!Dialogue: 50,0:05:10.50,0:05:12.63,Main-207+,,0,0,0,,Bu ne ara içeri sızdı?Dialogue: 50,0:05:13.25,0:05:17.13,Main-207+,,0,0,0,,Efendim! Cipher Pol üyeleri hükûmet yetkilileridir!Dialogue: 50,0:05:17.13,0:05:18.26,Main-207+,,0,0,0,,Biliyorum!Dialogue: 50,0:05:18.26,0:05:20.47,Main-207+,,0,0,0,,Burası artık tehlikeli, millet.Dialogue: 50,0:05:20.47,0:05:22.34,Main-207+,,0,0,0,,Hadi uçalım!Dialogue: 50,0:05:25.97,0:05:28.22,Main-207+,,0,0,0,,Hırslı olabilirim...Dialogue: 50,0:05:28.22,0:05:31.31,Main-207+,,0,0,0,,ama her şeyden önce bir gazeteciyim!Dialogue: 50,0:05:31.47,0:05:33.73,Main-207+,,0,0,0,,Yalanlarımla insanların kalpleriyle oynarım.Dialogue: 50,0:05:33.73,0:05:35.44,Main-207+,,0,0,0,,Kelimelerin uzmanıyımdır!Dialogue: 50,0:05:35.44,0:05:39.40,Main-207+,,0,0,0,,Neyin yayınlanacağına ben karar veririm!Dialogue: 50,0:05:43.41,0:05:44.94,Main-207+,,0,0,0,,Morgans-san!Dialogue: 50,0:05:45.41,0:05:47.70,Main-207+,,0,0,0,,Kral Wapol'dan bir çağrı aldık!Dialogue: 50,0:05:47.70,0:05:49.12,Main-207+,,0,0,0,,Kral Wapol mu?Dialogue: 50,0:05:51.04,0:05:52.87,Main-207+,,0,0,0,,Ne istiyormuş?Dialogue: 50,0:05:52.87,0:05:56.09,Main-207+,,0,0,0,,Görünüşe göre sızdırılacak bilgileri var.Dialogue: 50,0:05:56.09,0:05:58.17,Main-207+,,0,0,0,,Ne?!Dialogue: 50,0:06:08.51,0:06:10.02,Main-207+,,0,0,0,,Neler oluyor?Dialogue: 50,0:06:10.02,0:06:11.10,Main-207+,,0,0,0,,Özel baskı mı?Dialogue: 50,0:06:19.03,0:06:19.94,Main-207+,,0,0,0,,Endişelenme...Dialogue: 50,0:06:20.44,0:06:21.86,Main-207+,,0,0,0,,Her şey iyi olacak.Dialogue: 50,0:06:29.20,0:06:32.54,Narrator-207+,,0,0,0,,Hükûmet olanları örtbas edemeyince,Dialogue: 50,0:06:32.54,0:06:37.29,Narrator-207+,,0,0,0,,Reverie'deki hadiseler ve kararlar...Dialogue: 50,0:06:37.29,0:06:42.09,Narrator-207+,,0,0,0,,tüm dünyada duyulup büyük şok yarattı.Dialogue: 50,0:06:43.55,0:06:44.93,Main-207+,,0,0,0,,Bekle!Dialogue: 50,0:06:44.93,0:06:46.34,Main-207+,,0,0,0,,Bu da ne böyle?!Dialogue: 50,0:06:49.64,0:06:51.35,Main-207+,,0,0,0,,Bu doğru olamaz.Dialogue: 50,0:06:51.35,0:06:53.48,Main-207+,,0,0,0,,Uydurma bir haber olmalı, değil mi?Dialogue: 50,0:06:53.48,0:06:57.06,Main-207+,,0,0,0,,Şu Ekonomi Gazetesi işte! O kuş başkan uydurmuştur!Dialogue: 50,0:06:57.61,0:06:59.52,Main-207+,,0,0,0,,Bundan eminim!Dialogue: 50,0:07:02.94,0:07:04.82,Main-207+,,0,0,0,,Sabo'dan bahsediyoruz!Dialogue: 50,0:07:04.82,0:07:06.45,Main-207+,,0,0,0,,Bu imkânsız!Dialogue: 50,0:07:06.45,0:07:08.66,Main-207+,,0,0,0,,Buna asla inanmam!Dialogue: 50,0:07:08.66,0:07:09.78,Main-207+,,0,0,0,,Sakin ol!Dialogue: 50,0:07:10.41,0:07:13.62,Main-207+,,0,0,0,,Öncelikle bu söylenenleri doğrulamamız gerekiyor.Dialogue: 50,0:07:13.62,0:07:16.04,Main-207+,,0,0,0,,Ama hepsiyle iletişimi kaybettik...Dialogue: 50,0:07:17.00,0:07:18.63,Main-207+,,0,0,0,,nasıl teyit edebiliriz ki?Dialogue: 50,0:07:19.29,0:07:21.00,Main-207+,,0,0,0,,Bu doğru olamaz, değil mi?Dialogue: 50,0:07:22.42,0:07:23.80,Main-207+,,0,0,0,,Sabo-kun...Dialogue: 50,0:07:26.59,0:07:27.80,Main-207+,,0,0,0,,Leydim!Dialogue: 50,0:07:27.80,0:07:29.85,Main-207+,,0,0,0,,Mary Geoise'de miydi?!Dialogue: 50,0:07:30.30,0:07:32.89,Main-207+,,0,0,0,,K-Kardeşim orada mıydı?!Dialogue: 50,0:07:35.52,0:07:37.43,Main-207+,,0,0,0,,Makino'ya ne oldu?Dialogue: 50,0:07:37.43,0:07:39.23,Main-207+,,0,0,0,,Bar bugün kapalı.Dialogue: 50,0:07:39.23,0:07:40.40,Main-207+,,0,0,0,,Ne?!Dialogue: 50,0:07:40.40,0:07:43.61,Main-207+,,0,0,0,,Dünyada çok fazla şey oluyorken...Dialogue: 50,0:07:43.61,0:07:45.61,Main-207+,,0,0,0,,bir içki iyi giderdi.Dialogue: 50,0:07:48.86,0:07:50.37,Main-207+,,0,0,0,,Sabo-kun...Dialogue: 50,0:07:52.83,0:07:56.50,Main-207+,,0,0,0,,Tam da hayatta olduğunu yeni yeni öğrenmişken...Dialogue: 50,0:07:57.08,0:07:59.04,Main-207+,,0,0,0,,Gerçek olmadığını söyle bana!Dialogue: 50,0:07:59.04,0:08:04.21,Main-207+,,0,0,0,,Sabo!Dialogue: 50,0:08:10.55,0:08:14.43,Main-207+,,0,0,0,,Bu dünyada sıkılman imkânsız!Dialogue: 50,0:08:15.47,0:08:17.60,Main-207+,,0,0,0,,İşler ilginçleşiyor!Dialogue: 50,0:08:24.65,0:08:27.28,Main-207+,,0,0,0,,Hey, millet!Dialogue: 50,0:08:27.28,0:08:29.03,Main-207+,,0,0,0,,Haydi yelken açalım!Dialogue: 50,0:08:29.03,0:08:31.62,Main-207+,,0,0,0,,Onu denizcilere vermektense...Dialogue: 50,0:08:31.62,0:08:34.54,Main-207+,,0,0,0,,kendim alırım daha iyi!Dialogue: 50,0:08:39.42,0:08:42.33,Narrator-207+,,0,0,0,,Ve şimdi, günümüze dönelim.Dialogue: 50,0:08:57.60,0:08:59.35,Main-207+,,0,0,0,,Koby, benim.Dialogue: 50,0:09:03.73,0:09:04.94,Main-207+,,0,0,0,,Bekle bi' saniye.Dialogue: 50,0:09:05.32,0:09:07.11,Main-207+,,0,0,0,,Daha sakin bir yere geçeyim.Dialogue: 50,0:09:07.11,0:09:07.69,Main-207+,,0,0,0,,Tamam.Dialogue: 50,0:09:11.36,0:09:13.37,Main-207+,,0,0,0,,Ah, doğru! "Deniz!"Dialogue: 50,0:09:13.70,0:09:14.70,Main-207+,,0,0,0,,"Sis!"Dialogue: 50,0:09:16.41,0:09:17.83,Main-207+,,0,0,0,,Her zamanki gibi...Dialogue: 50,0:09:17.83,0:09:19.00,Main-207+,,0,0,0,,dikkatlisin.Dialogue: 50,0:09:19.00,0:09:22.50,Main-207+,,0,0,0,,Şey, kural kuraldır...Dialogue: 50,0:09:22.50,0:09:24.17,Main-207+,,0,0,0,,Ah, evet! Dinleyin!Dialogue: 50,0:09:24.50,0:09:26.67,Main-207+,,0,0,0,,Size acilen bildirmem gereken bir konu var,Dialogue: 50,0:09:27.25,0:09:28.26,Main-207+,,0,0,0,,Komutan!Dialogue: 50,0:09:37.01,0:09:38.47,Main-207+,,0,0,0,,Ne?!Dialogue: 50,0:09:38.47,0:09:40.85,Main-207+,,0,0,0,,Demek vaziyet bu?!Dialogue: 50,0:09:41.19,0:09:43.98,Main-207+,,0,0,0,,Evet. Bütün Denizciler birleşse bile...Dialogue: 50,0:09:43.98,0:09:47.27,Main-207+,,0,0,0,,bunu temizlemek imkânsız olacak.Dialogue: 50,0:09:47.27,0:09:49.82,Main-207+,,0,0,0,,Yani planladığımız gibi,Dialogue: 50,0:09:49.82,0:09:53.03,Main-207+,,0,0,0,,Denizciler oradaki mevzuya müdahale edemeyecek.Dialogue: 50,0:09:53.03,0:09:54.87,Main-207+,,0,0,0,,Ellerinde yeterince adam yok.Dialogue: 50,0:09:54.87,0:09:56.37,Main-207+,,0,0,0,,Sorun yok.Dialogue: 50,0:09:56.37,0:09:59.20,Main-207+,,0,0,0,,Wano, Dünya Hükûmeti bünyesinde değil.Dialogue: 50,0:09:59.66,0:10:03.79,Main-207+,,0,0,0,,Şimdi, Big Mom'ın Onigashima'ya gelmesi hakkında...Dialogue: 50,0:10:03.79,0:10:04.50,Main-207+,,0,0,0,,Evet.Dialogue: 50,0:10:05.00,0:10:08.71,Main-207+,,0,0,0,,Kaido ve Big Mom'ın ezeli düşmanlığı,Dialogue: 50,0:10:08.71,0:10:12.09,Main-207+,,0,0,0,,Denizciler için birbirlerini yok etmeleri adına bir fırsattı.Dialogue: 50,0:10:12.09,0:10:13.63,Main-207+,,0,0,0,,Evet, öyle.Dialogue: 50,0:10:13.63,0:10:18.85,Main-207+,,0,0,0,,Birbirlerini yok etmelerini beklerken,Dialogue: 50,0:10:20.22,0:10:22.02,Main-207+,,0,0,0,,el ele verip ittifak kurdular!Dialogue: 50,0:10:24.23,0:10:28.27,Main-207+,,0,0,0,,N-N-N-Nasıl yani?!Dialogue: 50,0:10:32.11,0:10:35.87,Main-207+,,0,0,0,,Hasır Şapkalı Luffy'ye gelince, kaçtığına dair bir haber yok.Dialogue: 50,0:10:36.49,0:10:38.74,Main-207+,,0,0,0,,Çıkmaza girdik.Dialogue: 50,0:10:38.74,0:10:41.12,Main-207+,,0,0,0,,Bir de şu can sıkıcı mesele var...Dialogue: 50,0:10:41.12,0:10:44.08,Main-207+,,0,0,0,,Geçen gün başkentte Cipher Pol 0'ı gördüm.Dialogue: 50,0:10:44.08,0:10:46.21,Main-207+,,0,0,0,,Ne?! Neden Wano'dalar?!Dialogue: 50,0:10:47.38,0:10:49.38,Main-207+,,0,0,0,,Umarım yanılıyorumdur...Dialogue: 50,0:10:49.75,0:10:52.59,Main-207+,,0,0,0,,ama bu, Dünya Hükûmeti'nin...Dialogue: 50,0:10:52.59,0:10:56.18,Main-207+,,0,0,0,,korsanlar tarafından yönetilen Wano'yla iş yaptığı anlamına gelir.Dialogue: 50,0:10:58.30,0:11:00.01,Main-207+,,0,0,0,,Bunu öğrendiğimde...Dialogue: 50,0:11:00.51,0:11:01.18,Main-207+,,0,302,0,,bir süre kendime gelemedim.Dialogue: 50,0:11:01.18,0:11:03.43,Main-207+,,0,302,0,,bir süre kendime gelemedim.Dialogue: 50,0:11:13.28,0:11:15.91,Main-207+,,0,0,0,,Bu arada, sen neredesin?Dialogue: 50,0:11:15.91,0:11:16.61,Main-207+,,0,0,0,,Evet.Dialogue: 50,0:11:17.41,0:11:20.95,Main-207+,,0,0,0,,Boa Hancock'u yakalamak için...Dialogue: 50,0:11:25.50,0:11:28.08,Main-207+,,0,0,0,,Kadınlar Adası'na doğru gidiyoruz!Dialogue: 50,0:11:28.96,0:11:29.79,Main-207+,,0,0,0,,Olamaz...Dialogue: 50,0:11:30.42,0:11:33.84,Main-207+,,0,0,0,,Şu gemiler Calm Belt'den geliyorlar.Dialogue: 50,0:11:33.84,0:11:35.63,Main-207+,,0,0,0,,Denizci filosu mu?!Dialogue: 50,0:11:36.59,0:11:38.68,Main-207+,,0,0,0,,Marguerite!Dialogue: 50,0:11:38.68,0:11:41.56,Thoughts-207+,,0,0,0,,Neler oluyor?!Dialogue: 50,0:11:43.81,0:11:46.77,Narrator-207+,,0,0,0,,Haberler tüm dünyaya yayıldı.Dialogue: 50,0:11:47.77,0:11:50.48,Main-207+,,0,0,0,,Bunu çok daha önce yapacaklardı!Dialogue: 50,0:11:50.48,0:11:53.11,Main-207+,,0,0,0,,Korsanlarla takım olmaya çalışmak bir hataydı!Dialogue: 50,0:11:53.78,0:11:54.86,Main-207+,,0,0,0,,Onlar şeytan!Dialogue: 50,0:11:55.53,0:11:58.28,Narrator-207+,,0,0,0,,Tüm korsanların kötü olduğunu düşünenler...Dialogue: 50,0:12:00.37,0:12:03.20,Main-207+,,0,0,0,,Sonunda şu hükûmet köpeklerinden kurtuluyoruz!Dialogue: 50,0:12:03.58,0:12:07.08,Main-207+,,0,0,0,,O İmparatoriçe'nin de Şahin Göz'ün de Palyaço'nun da canı cehenneme!Dialogue: 50,0:12:07.08,0:12:10.21,Main-207+,,0,0,0,,Onlar yağmacıdan başka bir şey değil!Dialogue: 50,0:12:11.46,0:12:15.30,Narrator-207+,,0,0,0,,...ve yağmacılardan iğrenenler için müjde bir haber bu!Dialogue: 50,0:12:15.63,0:12:19.80,Main-207+,,0,0,0,,Ama Zirve Savaşı'nda hepsi harikaydı!Dialogue: 50,0:12:20.64,0:12:22.22,Main-207+,,0,0,0,,Reverie'nin kararı bu muymuş?Dialogue: 50,0:12:22.76,0:12:25.14,Main-207+,,0,0,0,,Denizciler derhal harekete geçmeye hazır.Dialogue: 50,0:12:25.14,0:12:26.43,Main-207+,,0,0,0,,Akıllıca bir iş mi bu?Dialogue: 50,0:12:26.43,0:12:30.10,Main-207+,,0,0,0,,Onlar dünyanın en büyük 3 gücünden biri!Dialogue: 50,0:12:30.10,0:12:33.73,Narrator-207+,,0,0,0,,Zirve Savaşı'ndaki başarılarını bilenler...Dialogue: 50,0:12:33.73,0:12:38.49,Narrator-207+,,0,0,0,,ve üç büyük gücün dengesinin bozulmasından endişe duyanlar için...Dialogue: 50,0:12:38.49,0:12:40.99,Narrator-207+,,0,0,0,,bu gerçekten sıkıntılı bir durumdu.Dialogue: 50,0:12:43.87,0:12:49.54,Narrator-207+,,0,0,0,,Son Reverie'den gelen ve tüm dünyayı şoke eden...Dialogue: 50,0:12:50.12,0:12:51.04,Narrator-207+,,0,0,0,,o haber...Dialogue: 50,0:12:52.63,0:12:54.21,Narrator-207+,,0,0,0,,Shichibukai sisteminin...Dialogue: 50,0:12:54.84,0:12:56.34,Narrator-207+,,0,0,0,,kaldırılmasıydı!Dialogue: 50,0:12:57.88,0:13:02.76,Narrator-207+,,0,0,0,,Shichibukai, hükûmetin resmen tanıdığı korsanlardı.Dialogue: 50,0:13:02.76,0:13:05.18,Narrator-207+,,0,0,0,,Yağma yapmalarına izin verilse de...Dialogue: 50,0:13:05.18,0:13:10.10,Narrator-207+,,0,0,0,,hükûmet onları diğer korsanlara karşı caydırıcı olarak kullanıyordu.Dialogue: 50,0:13:10.10,0:13:15.73,Narrator-207+,,0,0,0,,Shichibukai kadrosu zaman içinde defalarca değişime uğradı.Dialogue: 50,0:13:22.07,0:13:23.41,Narrator-207+,,0,0,0,,Crocodile.Dialogue: 50,0:13:23.95,0:13:28.87,Narrator-207+,,0,0,0,,Alabasta Krallığı'nı ele geçirmeye çalışırken Hasır Şapkalarla çatıştı.Dialogue: 50,0:13:28.87,0:13:31.75,Narrator-207+,,0,0,0,,Krallığı devirmeye çalışsa da...Dialogue: 50,0:13:31.75,0:13:35.84,Narrator-207+,,0,0,0,,en sonunda Luffy'ye yenildi ve Shichibukai'den ihraç edildi.Dialogue: 50,0:13:36.75,0:13:40.17,Narrator-207+,,0,0,0,,Crocodile'ın yerine geçen ve Shichibukai'ye katılan isim...Dialogue: 50,0:13:40.17,0:13:42.43,Narrator-207+,,0,0,0,,Marshall D. Teach'ti.Dialogue: 50,0:13:42.43,0:13:48.89,Narrator-207+,,0,0,0,,Ancak amacına ulaştıktan hemen sonra istifasını sundu.Dialogue: 50,0:13:50.18,0:13:52.14,Narrator-207+,,0,0,0,,Denizin Şövalyesi Jinbe...Dialogue: 50,0:13:52.14,0:13:54.94,Narrator-207+,,0,0,0,,Zirve Savaşı'na karşı çıktı ve Denizciler'le arası bozuldu.Dialogue: 50,0:13:55.65,0:13:58.61,Narrator-207+,,0,0,0,,O da istifasını ilan etti.Dialogue: 50,0:14:01.86,0:14:03.70,Narrator-207+,,0,0,0,,Gecko Moria.Dialogue: 50,0:14:03.70,0:14:10.00,Narrator-207+,,0,0,0,,Hasır Şapkalarla bir zamanlar çatışan bu adam da Zirve Savaşı'na çağrılmıştı.Dialogue: 50,0:14:11.16,0:14:12.12,Narrator-207+,,0,0,0,,Ancak...Dialogue: 50,0:14:13.54,0:14:17.80,Narrator-207+,,0,0,0,,savaşın hemen ardından hükûmet emriyle pusuya düşürüldü...Dialogue: 50,0:14:17.80,0:14:19.63,Narrator-207+,,0,0,0,,ve sistemden atıldı.Dialogue: 50,0:14:20.55,0:14:23.51,Narrator-207+,,0,0,0,,Gökçe Şeytan Donquixote Doflamingo.Dialogue: 50,0:14:25.18,0:14:28.18,Narrator-207+,,0,0,0,,Dressrosa'yı kral olarak yönetirken...Dialogue: 50,0:14:28.18,0:14:33.77,Narrator-207+,,0,0,0,,yeraltı dünyasının kilit ismi olarak yapay şeytan meyvesi "GÜLÜCÜK" ticareti yapıyordu.Dialogue: 50,0:14:34.27,0:14:35.44,Narrator-207+,,0,0,0,,Ancak...Dialogue: 50,0:14:36.48,0:14:39.77,Narrator-207+,,0,0,0,,Luffy'nin ittifakına karşı krallığı kaybetti...Dialogue: 50,0:14:39.77,0:14:41.99,Narrator-207+,,0,0,0,,ve Shichibukai unvanı elinden alındı.Dialogue: 50,0:14:42.44,0:14:45.16,Narrator-207+,,0,0,0,,Ve son olarak, Trafalgar Law.Dialogue: 50,0:14:45.16,0:14:49.12,Narrator-207+,,0,0,0,,Doflamingo'yu devirmek için Hasır Şapkalarla ittifak kurdu...Dialogue: 50,0:14:49.79,0:14:52.25,Narrator-207+,,0,0,0,,ve unvanından oldu.Dialogue: 50,0:14:53.25,0:14:56.63,Narrator-207+,,0,0,0,,Adeta birer imparator gibi hüküm süren dört korsan:Dialogue: 50,0:14:58.25,0:14:59.42,Narrator-207+,,0,0,0,,Yonko.Dialogue: 50,0:15:00.34,0:15:03.22,Narrator-207+,,0,0,0,,Onları dizginlemeye çalışan: Denizciler.Dialogue: 50,0:15:03.72,0:15:06.55,Narrator-207+,,0,0,0,,Ve son olarak: Shichibukai.Dialogue: 50,0:15:06.55,0:15:11.39,Narrator-207+,,0,0,0,,Bu üç büyük güç, dünyadaki barışı muhafaza ediyordu.Dialogue: 50,0:15:11.97,0:15:12.93,Narrator-207+,,0,0,0,,Ancak...Dialogue: 50,0:15:13.48,0:15:16.69,Narrator-207+,,0,0,0,,Shichibukai yüzünden büyük acılar çeken iki kral vardı:Dialogue: 50,0:15:16.69,0:15:20.02,Narrator-207+,,0,0,0,,Alabasta Krallığı'ndan Nefertari Cobra...Dialogue: 50,0:15:20.61,0:15:23.78,Narrator-207+,,0,0,0,,ve Dressrosa Krallığı'ndan 3. Riku Doldo.Dialogue: 50,0:15:23.78,0:15:26.86,Narrator-207+,,0,0,0,,Shichibukai sistemini tamamen yıkmak için mücadele ettiler.Dialogue: 50,0:15:27.53,0:15:31.08,Narrator-207+,,0,0,0,,Ve Reverie'deki hararetli tartışmaların ardından...Dialogue: 50,0:15:31.08,0:15:35.46,Narrator-207+,,0,0,0,,teklif oy çokluğuyla kabul edildi!Dialogue: 50,0:15:36.71,0:15:42.30,Main-207+,,0,0,0,,Dolayısıyla, Shichibukai üyeleri tüm haklarından otomatikman mahrum bırakılacak...Dialogue: 50,0:15:42.30,0:15:46.18,Main-207+,,0,0,0,,ve Dünya Hükûmeti ile olan tüm bağları bundan böyle kesilecektir.Dialogue: 50,0:15:46.18,0:15:47.01,Main-207+,,0,0,0,,Bunun anlamı...Dialogue: 50,0:15:47.89,0:15:49.26,Main-207+,,0,0,0,,Buggy,Dialogue: 50,0:15:49.26,0:15:53.27,Main-207+,,0,0,0,,artık sadece sıradan bir korsansın!Dialogue: 50,0:15:54.14,0:15:56.39,Main-207+,,0,0,0,,Bu hiç adil değil, sizi adi herifler!Dialogue: 50,0:15:56.39,0:16:01.44,Main-207+,,0,0,0,,Bize sormadan karar alıp, işiniz bitince de bizi tutuklamaya mı kalkıyorsunuz?!Dialogue: 50,0:16:01.44,0:16:03.65,Main-207+,,0,0,0,,Sizde zerre adalet duygusu yok!Dialogue: 50,0:16:03.65,0:16:08.24,Main-207+,,0,0,0,,Crocodile ve Doflamingo'nun sizi parmağında oynatmasının benimle hiçbir ilgisi yok!Dialogue: 50,0:16:08.24,0:16:11.24,Main-207+,,0,0,0,,Acısını benden çıkarmayın!Dialogue: 50,0:16:11.24,0:16:13.83,Main-207+,,0,0,0,,Bütün kıyıyı kuşatmışlar!Dialogue: 50,0:16:14.33,0:16:15.87,Main-207+,,0,0,0,,Ne yapacağız şimdi?Dialogue: 50,0:16:16.91,0:16:20.79,Thoughts-207+,,0,0,0,,Hayatımın planı mahvoldu, her şey bitti!Dialogue: 50,0:16:21.29,0:16:22.25,Main-207+,,0,0,0,,Ha?Dialogue: 50,0:16:22.63,0:16:25.92,Main-207+,,0,0,0,,Denizciler bizim tarafımızda olmalıydı ama bize karşı duruyorlar!Dialogue: 50,0:16:25.92,0:16:27.72,Main-207+,,0,0,0,,Ne yapacağız anneciğim?!Dialogue: 50,0:16:28.30,0:16:30.18,Main-207+,,0,0,0,,Anne!Dialogue: 50,0:16:31.80,0:16:33.56,Main-207+,,0,0,0,,Teslim ol,Dialogue: 50,0:16:33.56,0:16:35.06,Main-207+,,0,0,0,,Şahin Göz Mihawk!Dialogue: 50,0:16:35.60,0:16:37.68,Main-207+,,0,0,0,,Hemen teslim ol!Dialogue: 50,0:16:39.39,0:16:42.15,Main-207+,,0,0,0,,Yılan Prenses, başımız dertte!Dialogue: 50,0:16:42.15,0:16:46.44,Main-207+,,0,0,0,,Shichibukai unvanınız elinizden alındı!Dialogue: 50,0:16:47.11,0:16:48.36,Main-207+,,0,0,0,,Nyon-sama!Dialogue: 50,0:16:48.36,0:16:50.32,Main-207+,,0,0,0,,Kıyılarımızda Denizciler cirit atıyor!Dialogue: 50,0:16:50.32,0:16:51.53,Main-207+,,0,0,0,,Ne?!Dialogue: 50,0:16:51.53,0:16:54.16,Main-207+,,0,0,0,,Çoktan harekete mi geçmişler?!Dialogue: 50,0:16:55.16,0:16:56.58,Main-207+,,0,0,0,,Panik yapmayın!Dialogue: 50,0:16:57.91,0:16:59.21,Main-207+,,0,0,0,,Yılan Prenses!Dialogue: 50,0:16:59.54,0:17:01.75,Main-207+,,0,0,0,,Belli ki bir şeyi unutmuşlar...Dialogue: 50,0:17:03.46,0:17:04.71,Main-207+,,0,0,0,,değil mi?Dialogue: 50,0:17:05.17,0:17:07.97,Main-207+,,0,0,0,,Bu hiç iyi değil, Başkan Buggy!Dialogue: 50,0:17:07.97,0:17:09.38,Main-207+,,0,0,0,,Kaçmalı mıyız?!Dialogue: 50,0:17:10.01,0:17:14.05,Main-207+,,0,0,0,,Tabii ki hayır! Onlara gösterişli bir savaş sunacağız!Dialogue: 50,0:17:18.68,0:17:23.90,Main-207+,,0,0,0,,Biraz cesur olun, sizi pısırıklar!Dialogue: 50,0:17:25.19,0:17:27.78,Main-207+,,0,0,0,,– İşte Başkan Buggy'miz! – İşte Başkan Buggy'miz!Dialogue: 50,0:17:29.32,0:17:33.20,Main-207+,,0,0,0,,– Buggy! Buggy! Buggy! Buggy! – Buggy! Buggy! Buggy! Buggy!Dialogue: 50,0:17:33.53,0:17:36.70,Main-207+,,0,0,0,,Görünüşe bakılırsa artık aynı tarafta değiliz!Dialogue: 50,0:17:36.70,0:17:39.37,Main-207+,,0,0,0,,Bu gerçekten affedilemez...Dialogue: 50,0:17:39.37,0:17:40.91,Main-207+,,0,0,0,,Weevil!Dialogue: 50,0:17:40.91,0:17:43.00,Main-207+,,0,0,0,,Onları yok etmene izin veriyorum!Dialogue: 50,0:17:43.00,0:17:44.80,Main-207+,,0,0,0,,G-Gerçekten mi?!Dialogue: 50,0:17:44.80,0:17:48.05,Main-207+,,0,0,0,,O hâlde hepsini öldüreceğim!Dialogue: 50,0:17:49.63,0:17:52.59,Main-207+,,0,0,0,,Tabii Beyazsakal adına!Dialogue: 50,0:17:53.26,0:17:54.89,Main-207+,,0,0,0,,İçim kıpır kıpır.Dialogue: 50,0:17:55.64,0:17:57.26,Main-207+,,0,0,0,,Uzun zaman olmuştu...Dialogue: 50,0:17:59.27,0:18:02.19,Main-207+,,0,0,0,,avlanan taraf olmayalı.Dialogue: 50,0:18:03.85,0:18:07.40,Main-207+,,0,0,0,,Bizler Shichibukai unvanını...Dialogue: 50,0:18:09.90,0:18:12.74,Main-207+,,0,0,15,,çok güçlü olduğumuz için aldık!Dialogue: 50,0:18:12.74,0:18:16.07,Thoughts-207+,,0,0,0,,Size güveniyorum beyler!Dialogue: 50,0:18:16.07,0:18:18.20,Thoughts-207+,,0,0,0,,Siz onları oyalarken...Dialogue: 50,0:18:20.50,0:18:22.21,Thoughts-207+,,0,0,0,,ben de tüyeceğim.Dialogue: 0,0:00:00.00,0:00:09.99,Title-207+,,0,0,0,,Büyük HaberlerDialogue: 1,0:00:00.00,0:00:09.99,Title-207+,,0,0,0,,Büyük HaberlerDialogue: 0,0:00:11.07,0:00:18.00,Captions-207+,,0,0,0,,Pangaea Kalesi Mary GeoiseDialogue: 1,0:00:11.07,0:00:18.00,Captions-207+,,0,0,0,,Pangaea Kalesi Mary GeoiseDialogue: 1,0:00:50.28,0:00:53.20,Captions-207+,,0,0,0,,Balıkadam Adası, Ryugu Krallığı Ryugu SarayıDialogue: 2,0:00:50.28,0:00:53.20,Captions-207+,,0,0,0,,Balıkadam Adası, Ryugu Krallığı Ryugu SarayıDialogue: 0,0:03:54.76,0:03:59.84,Captions-207+,,0,0,0,,Dünya Ekonomi Gazetesi Genel Yayın Yönetmeni, MorgansDialogue: 1,0:03:54.76,0:03:59.84,Captions-207+,,0,0,0,,Dünya Ekonomi Gazetesi Genel Yayın Yönetmeni, MorgansDialogue: 0,0:06:49.64,0:06:57.06,Captions-207+,,0,0,0,,Kamabakka Kraliçeliği Devrim Ordusu KarargâhıDialogue: 1,0:06:49.64,0:06:57.06,Captions-207+,,0,0,0,,Kamabakka Kraliçeliği Devrim Ordusu KarargâhıDialogue: 0,0:07:25.13,0:07:27.80,Captions-207+,,0,0,0,,Goa Krallığı Krali