Dialogue: 55,0:00:01.33,0:00:06.89,Main-207+,,0,0,0,,Bu ülkeyi dış dünyaya\Naçmamızı siz de istemiyorsunuz.
Dialogue: 55,0:00:06.89,0:00:08.53,Main-207+,,0,0,0,,Haksız mıyım?
Dialogue: 55,0:00:09.98,0:00:15.86,Main-207+,,0,0,0,,Ne de olsa, korsanlarla savaşmak için\Nkorsanlardan silah almaya can atıyorsunuz.
Dialogue: 55,0:00:18.16,0:00:21.22,Main-207+,,0,0,0,,Sizce de tuhaf değil mi...
Dialogue: 55,0:00:21.22,0:00:22.93,Main-207+,,0,0,0,,he?!
Dialogue: 55,0:00:26.89,0:00:31.46,Main-207+,,0,0,0,,Joker olarak bilinen simsarın da\Nortadan kalkmasıyla...
Dialogue: 55,0:00:31.46,0:00:39.18,Main-207+,,0,0,0,,{\t(6620,0,1,\3c&HFFFFFF&\4c&HFFFFFF&)}aracısız direkt olarak bizimle anlaşmaktan başka şansınız yok.
Dialogue: 55,0:00:39.18,0:00:45.52,Main-207+,,0,0,0,,Çaresiz durumdasınız, yapabileceğim\Nen iyi teklifi vermeye çalışıyorum.
Dialogue: 55,0:00:47.39,0:00:50.82,Main-207+,,0,0,0,,Yine de hâlâ çok şey istiyorsunuz.
Dialogue: 55,0:00:50.82,0:00:55.78,Main-207+,,0,0,0,,Wano kendi kendine yetebilen bir ülke!
Dialogue: 55,0:01:01.41,0:01:05.54,Main-207+,,0,0,0,,Herkesin ne kadar mutlu olduğunu gördünüz.
Dialogue: 55,0:01:05.54,0:01:10.17,Main-207+,,0,0,0,,Şu anda ihtiyacımız olan tek şey\Ndaha fazla güç!
Dialogue: 55,0:01:10.17,0:01:13.59,Main-207+,,0,0,0,,Şimdilik sadece bir savaş gemisi istiyorum.
Dialogue: 55,0:01:14.97,0:01:19.18,Main-207+,,0,0,0,,Bir dahaki sefere\NDr. Vegapunk'ı istiyorum!
Dialogue: 55,0:01:19.18,0:01:21.01,Main-207+,,0,0,0,,Bu imkânsız!
Dialogue: 55,0:01:26.14,0:01:29.73,Main-207+,,0,0,0,,İmkânsız olsa istemezdim!
Dialogue: 55,0:01:34.03,0:01:37.59,Main-207+,,0,0,0,,Kutsal Ejderler... ya da Donanma...
Dialogue: 55,0:01:37.59,0:01:42.41,Main-207+,,0,0,0,,Hiçbirinden korkmadığımızı biliyorsunuz, değil mi?
Dialogue: 55,0:01:46.08,0:01:50.29,Main-207+,,0,0,0,,Hepiniz birleşseniz bile\Nbu ülkeyi yok edemezsiniz.
Dialogue: 55,0:01:50.29,0:01:54.84,Main-207+,,0,0,0,,Çünkü arkamda Kaido var!
Dialogue: 55,0:04:00.59,0:04:05.39,Main-207+,,0,0,0,,{\i1}Tayu{\i0} Komurasaki'nin geçit töreni için yolu açın!
Dialogue: 55,0:04:00.59,0:04:05.39,Note-207+,,0,0,0,,Tayu: Oiran ile eş anlamlı.
Dialogue: 55,0:04:05.39,0:04:08.42,Main-207+,,0,0,0,,Ah, Komurasaki-{\i1}sama{\i0}!
Dialogue: 55,0:04:08.42,0:04:11.48,Main-207+,,0,0,0,,Şuraya bak, Oiran!
Dialogue: 55,0:04:18.21,0:04:20.28,Main-207+,,0,0,0,,Özür dilerim, geç kaldım!
Dialogue: 55,0:04:24.07,0:04:26.12,Main-207+,,0,0,0,,Senin için endişelendim.
Dialogue: 55,0:04:27.49,0:04:29.79,Main-207+,,0,0,0,,Lütfen affet, abla!
Dialogue: 55,0:04:29.79,0:04:31.93,Main-207+,,0,0,0,,Şimdi işe koyul.
Dialogue: 55,0:04:32.65,0:04:33.87,Main-207+,,0,0,0,,Peki!
Dialogue: 55,0:04:39.59,0:04:42.38,Main-207+,,0,0,0,,İşte geliyor! Komurasaki-{\i1}sama{\i0}!
Dialogue: 55,0:04:45.18,0:04:47.35,Main-207+,,0,0,0,,Oiran'ın geçit töreni!
Dialogue: 55,0:04:48.69,0:04:49.76,Main-207+,,0,0,0,,Hâlâ gelmedi mi?!
Dialogue: 55,0:04:49.76,0:04:52.86,Main-207+,,0,0,0,,Burada binlerce insan var.
Dialogue: 55,0:04:52.86,0:04:56.40,Main-207+,,0,0,0,,Güzelliğini çok merak ettim.
Dialogue: 55,0:04:56.40,0:05:00.15,Main-207+,,0,0,0,,Lütfen acele edin, Komurasaki-{\i1}chwan{\i0}!
Dialogue: 55,0:05:06.20,0:05:09.08,Main-207+,,0,0,0,,Kurnaz sürtük...
Dialogue: 55,0:05:09.08,0:05:11.16,Main-207+,,0,0,0,,...Komurasaki!
Dialogue: 55,0:05:11.16,0:05:12.58,Main-207+,,0,0,0,,Komurasaki!
Dialogue: 55,0:05:12.92,0:05:15.41,Main-207+,,0,0,0,,Komurasaki...!
Dialogue: 55,0:05:17.46,0:05:19.84,Main-207+,,0,0,0,,Sanırım belalarını arıyorlar!
Dialogue: 55,0:05:21.01,0:05:22.37,Main-207+,,0,0,0,,H-Hey!
Dialogue: 55,0:05:22.37,0:05:23.84,Main-207+,,0,0,0,,O fahişeyi...
Dialogue: 55,0:05:23.84,0:05:25.88,Main-207+,,0,0,0,,öldürmeliyim!
Dialogue: 55,0:05:26.47,0:05:29.26,Main-207+,,0,0,0,,Şehirden kovulacağım.
Dialogue: 55,0:05:29.27,0:05:31.47,Main-207+,,0,0,0,,Her şey bitti!
Dialogue: 55,0:05:31.47,0:05:34.22,Main-207+,,0,0,0,,Zaten öleceğim,
Dialogue: 55,0:05:34.22,0:05:36.44,Main-207+,,0,0,0,,onu da yanımda götüreceğim!
Dialogue: 55,0:05:46.35,0:05:48.66,Main-207+,,0,0,0,,Oiran'dan uzak durun!
Dialogue: 55,0:06:01.67,0:06:04.62,Main-207+,,0,0,0,,Komurasaki...
Dialogue: 55,0:06:08.90,0:06:13.56,Main-207+,,0,0,0,,Sonsuza kadar seninle birlikte\Nolmak istiyorum, aşkım.
Dialogue: 50,0:06:13.56,0:06:14.45,Main-207+,,0,0,0,,Ne?
Dialogue: 55,0:06:14.98,0:06:17.89,Main-207+,,0,0,0,,B-Benim gibi bir yaşlı adamla mı?!
Dialogue: 55,0:06:17.89,0:06:22.58,Main-207+,,0,0,0,,Orochi-{\i1}sama{\i0}'nın kuklası olmaktansa...
Dialogue: 55,0:06:22.58,0:06:26.86,Main-207+,,0,0,0,,sizin beni satın almanızı tercih ederim.
Dialogue: 55,0:06:26.86,0:06:30.91,Main-207+,,0,0,0,,Ancak, özgürlüğümün fahiş bir bedeli var,
Dialogue: 55,0:06:30.91,0:06:33.87,Main-207+,,0,0,0,,bu imkânsıza yakın bir hayal.
Dialogue: 55,0:06:33.87,0:06:39.11,Main-207+,,0,0,0,,Kuşların Orochi-{\i1}sama{\i0}'ya\Nbu düşüncemi öttüğünü hayal edin.
Dialogue: 55,0:06:40.01,0:06:42.00,Main-207+,,0,0,0,,Umutsuzluğa kapılma, hayatım!
Dialogue: 55,0:06:42.74,0:06:44.75,Main-207+,,0,0,0,,Eğer istediğin buysa...
Dialogue: 55,0:06:44.75,0:06:48.55,Main-207+,,0,0,0,,ben Bingo, bunu gerçeğe dönüştüreceğim!
Dialogue: 55,0:06:50.70,0:06:52.80,Main-207+,,0,0,0,,Gerçekten mi?
Dialogue: 55,0:06:52.80,0:06:56.98,Main-207+,,0,0,0,,Ciddi değilsen bile\Nbunu duyduğuma çok sevindim.
Dialogue: 55,0:07:00.60,0:07:02.99,Main-207+,,0,0,0,,Bana geri ödeyecek paranız yok mu?!
Dialogue: 55,0:07:02.99,0:07:04.47,Main-207+,,0,0,0,,Özür dilerim!
Dialogue: 55,0:07:04.47,0:07:07.11,Main-207+,,0,0,0,,Beni aptal mı sanıyorsunuz?!
Dialogue: 55,0:07:07.78,0:07:10.75,Main-207+,,0,0,0,,Ağlamak bu işi çözmez!
Dialogue: 55,0:07:10.75,0:07:14.60,Main-207+,,0,0,0,,Borcunuza teminat olarak evinizi alıyorum!
Dialogue: 55,0:07:16.87,0:07:19.21,Main-207+,,0,0,0,,İşte, Komurasaki.
Dialogue: 55,0:07:19.21,0:07:22.90,Main-207+,,0,0,0,,Hiç bu kadar parayı bir arada görmemiştim!
Dialogue: 55,0:07:22.90,0:07:28.41,Main-207+,,0,0,0,,Komurasaki, işte seni satın almak için olan paranın ön ödemesi.
Dialogue: 55,0:07:28.41,0:07:31.29,Main-207+,,0,0,0,,Henüz yeterli değil,\Nama biraz daha dayanmanı istiyorum.
Dialogue: 55,0:07:31.29,0:07:33.70,Main-207+,,0,0,0,,O hâlde kaydını deftere geçeyim.
Dialogue: 55,0:07:33.70,0:07:35.64,Main-207+,,0,0,0,,Buna gerek yok!
Dialogue: 55,0:07:35.64,0:07:39.35,Main-207+,,0,0,0,,Yalnızca bir aptal,\Nsevdiği kadına güvenmez.
Dialogue: 55,0:07:39.35,0:07:41.89,Main-207+,,0,0,0,,Sözlerin bana yeter.
Dialogue: 55,0:07:41.89,0:07:43.62,Main-207+,,0,0,0,,Bingo-{\i1}sama{\i0}.
Dialogue: 55,0:07:44.69,0:07:49.32,Main-207+,,0,0,0,,Beni alıp götürdüğün anı\Nsabırsızlıkla bekliyorum.
Dialogue: 55,0:07:55.70,0:07:57.90,Main-207+,,0,0,0,,Ağlama.
Dialogue: 55,0:07:58.77,0:07:59.75,Main-207+,,0,0,0,,Sorun değil.
Dialogue: 55,0:07:59.75,0:08:02.64,Main-207+,,0,0,0,,Cenazeyle ben ilgilenirim.
Dialogue: 55,0:08:02.64,0:08:06.22,Main-207+,,0,0,0,,Ayrıca masraflarınız için\Nsize biraz borç da vereceğim.
Dialogue: 55,0:08:09.21,0:08:11.97,Main-207+,,0,0,0,,Ağlamayı kes artık!
Dialogue: 55,0:08:11.97,0:08:14.94,Main-207+,,0,0,0,,Bana iki katını ödemen gerekiyor!
Dialogue: 55,0:08:14.94,0:08:18.55,Main-207+,,0,0,0,,Saf olman senin hatandı!
Dialogue: 55,0:08:20.84,0:08:22.77,Main-207+,,0,0,0,,İşte paran!
Dialogue: 55,0:08:22.77,0:08:25.16,Main-207+,,0,0,0,,Vay canına! Bu çok fazla!
Dialogue: 55,0:08:26.21,0:08:27.40,Main-207+,,0,0,0,,Ama...
Dialogue: 55,0:08:27.40,0:08:29.09,Main-207+,,0,0,0,,Ne oldu?
Dialogue: 55,0:08:29.09,0:08:34.43,Main-207+,,0,0,0,,Gerçek şu ki başka biri beni\Nsatın almak için teklifte bulundu.
Dialogue: 55,0:08:34.43,0:08:35.66,Main-207+,,0,0,0,,Ne?!
Dialogue: 55,0:08:35.66,0:08:37.03,Main-207+,,0,0,0,,Acele etmeliyim!
Dialogue: 55,0:08:37.03,0:08:42.04,Main-207+,,0,0,0,,Daha fazla paraya ihtiyacım var.\NSatabileceğim bir şeyler olmalı.
Dialogue: 55,0:08:44.21,0:08:47.42,Main-207+,,0,0,0,,Depomu sattım, Komurasaki!
Dialogue: 55,0:08:47.42,0:08:50.59,Main-207+,,0,0,0,,Minnettarım.
Dialogue: 55,0:08:50.59,0:08:52.59,Main-207+,,0,0,0,,Yeter artık!
Dialogue: 55,0:08:54.00,0:08:56.17,Main-207+,,0,0,0,,Senden bıktım usandım!
Dialogue: 55,0:08:56.93,0:09:00.00,Main-207+,,0,0,0,,Ben ailemin evine dönüyorum!
Dialogue: 55,0:09:00.00,0:09:02.06,Main-207+,,0,0,0,,İstediğini yap!
Dialogue: 55,0:09:04.29,0:09:08.06,Main-207+,,0,0,0,,Yoldayım, Komurasaki!
Dialogue: 55,0:09:10.56,0:09:12.46,Main-207+,,0,0,0,,Ailemi bile terk ettim!
Dialogue: 55,0:09:14.61,0:09:18.36,Main-207+,,0,0,0,,Aşkım, lütfen kendine dikkat et.
Dialogue: 55,0:09:19.30,0:09:21.91,Main-207+,,0,0,0,,İlaç almak sadece israf.
Dialogue: 55,0:09:21.91,0:09:24.01,Main-207+,,0,0,0,,Bana bir şey olmaz.
Dialogue: 55,0:09:24.01,0:09:31.13,Main-207+,,0,0,0,,İstediğimi elde ettiğimde\Ndünyanın en mutlu adamı olacağım.
Dialogue: 55,0:09:31.13,0:09:38.34,Main-207+,,0,0,0,,İtiraf ediyorum ki seninle geçireceğim\Nher gecenin hayalini kuruyorum.
Dialogue: 55,0:09:38.34,0:09:42.19,Main-207+,,0,0,0,,Oh... Komurasaki!
Dialogue: 55,0:09:47.31,0:09:48.86,Main-207+,,0,0,0,,Kalanını da tamamladım.
Dialogue: 55,0:09:48.86,0:09:54.24,Main-207+,,0,0,0,,Evsiz kalmış olabilirim ama yeni hayatımıza başlamak için artık özgürüz!
Dialogue: 55,0:09:54.24,0:09:57.24,Main-207+,,0,0,0,,İşte kalan son 500 altın.
Dialogue: 55,0:09:57.24,0:10:02.24,Main-207+,,0,0,0,,Bununla birlikte artık benimsin, Komurasaki!
Dialogue: 55,0:10:04.20,0:10:05.45,Main-207+,,0,0,0,,He?
Dialogue: 55,0:10:05.45,0:10:09.63,Main-207+,,0,0,0,,Üzgünüm, oiran bugün çok hasta.
Dialogue: 55,0:10:09.63,0:10:11.34,Main-207+,,0,0,0,,Demek öyle!
Dialogue: 55,0:10:12.07,0:10:16.46,Main-207+,,0,0,0,,Bunu ona mutlaka verin.\NBen daha sonra uğrarım.
Dialogue: 55,0:10:22.28,0:10:24.56,Main-207+,,0,0,0,,Komurasaki!
Dialogue: 55,0:10:24.56,0:10:31.43,Main-207+,,0,0,0,,Seni zevk mekânından kurtarmaya geldim! Gel benimle yaşa!
Dialogue: 55,0:10:42.99,0:10:45.46,Main-207+,,0,0,0,,Bu numaraya gerçekten düştün mü?
Dialogue: 55,0:10:45.46,0:10:48.62,Main-207+,,0,0,0,,Yürü git, seni yaşlı sapık!
Dialogue: 55,0:10:49.61,0:10:52.21,Main-207+,,0,0,0,,Hey, millet...
Dialogue: 55,0:10:52.21,0:10:56.81,Main-207+,,0,0,0,,gülmeyi bırakın ve\Nbana Komurasaki'yi getirin.
Dialogue: 55,0:10:58.90,0:11:03.10,Main-207+,,0,0,0,,Birlikte sonsuza dek mutlu yaşayacağız!
Dialogue: 55,0:11:05.60,0:11:08.94,Main-207+,,0,0,0,,Seni ahmak, hayal kurmayı bırak!
Dialogue: 55,0:11:08.94,0:11:11.10,Main-207+,,0,0,0,,Sanki onun için yeterli paran varmış gibi!
Dialogue: 55,0:11:11.10,0:11:15.73,Main-207+,,0,0,0,,Elbette var! Para Komurasaki'de!\NBenim için güvende tutmasını istedim!
Dialogue: 55,0:11:17.70,0:11:20.15,Main-207+,,0,0,0,,Oh, Bingo-{\i1}san{\i0}.
Dialogue: 55,0:11:20.15,0:11:24.67,Main-207+,,0,0,0,,Ah, Komurasaki! Lütfen durumu açıkla!
Dialogue: 55,0:11:24.67,0:11:30.24,Main-207+,,0,0,0,,Hakkımızda bir şey bilmedikleri için\Nalayının ağzı hurra laf yapıyor!
Dialogue: 55,0:11:30.24,0:11:31.60,Main-207+,,0,0,0,,Ah?
Dialogue: 55,0:11:33.00,0:11:37.67,Main-207+,,0,0,0,,O paranın benim olduğunu söylememiş miydin?
Dialogue: 55,0:11:38.39,0:11:39.22,Main-207+,,0,0,0,,Ne?!
Dialogue: 55,0:11:45.83,0:11:48.97,Main-207+,,0,0,0,,Hepsini harcadım.
Dialogue: 55,0:11:50.01,0:11:51.56,Main-207+,,0,0,0,,Teşekkür ederim.
Dialogue: 55,0:11:53.79,0:11:59.32,Main-207+,,0,0,0,,Bu yaşlı serseri, cidden Komurasaki-{\i1}san{\i0}'ın\Nona aşık olduğunu düşünmüş!
Dialogue: 55,0:12:12.70,0:12:15.88,Main-207+,,0,0,0,,Bu moruğun burada işi ne?
Dialogue: 55,0:12:15.88,0:12:16.71,Main-207+,,0,0,0,,Ne?
Dialogue: 55,0:12:16.71,0:12:18.67,Main-207+,,0,0,0,,Komurasaki...
Dialogue: 55,0:12:20.67,0:12:23.34,Main-207+,,0,0,0,,P-Patron Kyoshiro!
Dialogue: 55,0:12:24.20,0:12:25.72,Main-207+,,0,0,0,,Demek...
Dialogue: 55,0:12:25.72,0:12:30.85,Main-207+,,0,0,0,,bugünlerde Komurasaki'nin çevresinde dolaşan ihtiyar sendin.
Dialogue: 55,0:12:30.85,0:12:34.40,Main-207+,,0,0,0,,Çevresinde dolanan mı? B-Bu doğru değil!
Dialogue: 55,0:12:34.40,0:12:37.98,Main-207+,,0,0,0,,Komurasaki, bu bir şaka mı?
Dialogue: 55,0:12:40.57,0:12:44.50,Main-207+,,0,0,0,,Her şeyimi feda ettim!
Dialogue: 55,0:12:44.50,0:12:46.74,Main-207+,,0,0,0,,Hiçbir şeyim kalmadı!
Dialogue: 55,0:12:46.74,0:12:50.66,Main-207+,,0,0,0,,Senin için her şeyimi verdim!
Dialogue: 55,0:13:01.10,0:13:02.92,Main-207+,,0,0,0,,Öf be..
Dialogue: 55,0:13:02.92,0:13:05.21,Main-207+,,0,0,0,,bu kaçıncı zavallı?
Dialogue: 55,0:13:05.21,0:13:09.50,Main-207+,,0,0,0,,Şu ağlak tipinle dükkânın önünü kapa'mana izin veremeyiz, ihtiyar.
Dialogue: 55,0:13:09.50,0:13:13.18,Main-207+,,0,0,0,,İşin bittiyse, defol!
Dialogue: 55,0:13:13.89,0:13:16.52,Main-207+,,0,0,0,,Seni çapkın moruk seni!
Dialogue: 55,0:13:22.36,0:13:24.86,Main-207+,,0,0,0,,Durun!
Dialogue: 55,0:13:24.86,0:13:26.86,Main-207+,,0,0,0,,Durun..!
Dialogue: 55,0:13:27.78,0:13:29.78,Main-207+,,0,0,0,,Gidiyorum!
Dialogue: 55,0:13:29.78,0:13:33.20,Main-207+,,0,0,0,,Gidiyorum, lütfen durun!
Dialogue: 55,0:13:45.00,0:13:46.93,Main-207+,,0,0,0,,Komurasaki..!
Dialogue: 55,0:13:54.40,0:13:57.60,Main-207+,,0,0,0,,{\i1}Tayu{\i0} Komurasaki'nin geçit töreni...
Dialogue: 55,0:14:00.40,0:14:03.93,Main-207+,,0,0,0,,geliyor!
Dialogue: 55,0:14:08.00,0:14:10.83,Main-207+,,0,0,0,,– Komurasaki-{\i1}sama{\i0}!\N– Komurasaki-{\i1}sama{\i0}!
Dialogue: 55,0:14:15.48,0:14:17.33,Main-207+,,0,0,0,,Ne çarpıcı bir güzellik!
Dialogue: 55,0:14:17.33,0:14:19.71,Main-207+,,0,0,0,,Muhteşem!
Dialogue: 55,0:14:24.46,0:14:26.89,Main-207+,,0,0,0,,Ah, çok güzel!
Dialogue: 55,0:14:26.89,0:14:29.47,Main-207+,,0,0,0,,Bu nasıl bir ışıltı böyle! Gözlerim!
Dialogue: 55,0:14:33.51,0:14:35.39,Main-207+,,0,0,0,,Komurasaki!
Dialogue: 55,0:14:35.39,0:14:38.60,Main-207+,,0,0,0,,Evimi, ailemi, her şeyimi kaybettim!
Dialogue: 55,0:14:38.60,0:14:43.80,Main-207+,,0,0,0,,Paramı bana geri ver! Seni hırsız!
Dialogue: 55,0:14:45.40,0:14:48.07,Main-207+,,0,0,0,,Hediyelerinizi geri mi istiyorsunuz?
Dialogue: 55,0:14:48.75,0:14:51.69,Main-207+,,0,0,0,,Bundan daha acınası bir şey olabilir mi?
Dialogue: 55,0:14:52.37,0:14:57.50,Main-207+,,0,0,0,,Benim için erkekler, bana para getiren köpeklerden ibaret.
Dialogue: 55,0:14:57.50,0:15:00.33,Main-207+,,0,0,0,,Bunu artık yapamıyorsanız\Nbenim için öldünüz demektir.
Dialogue: 55,0:15:05.00,0:15:07.51,Main-207+,,0,0,0,,Artık kaçamazsınız, beyler!
Dialogue: 55,0:15:08.81,0:15:11.51,Main-207+,,0,0,0,,Paranız bittiyse defolun gidin!
Dialogue: 55,0:15:11.51,0:15:15.72,Main-207+,,0,0,0,,Zenginlik üretemeyen kimsenin\NÇiçek Başkenti'nde yeri yok.
Dialogue: 55,0:15:15.72,0:15:20.27,Main-207+,,0,0,0,,Şogun Orochi adına,\Nüçünüzü de sürgüne mahkûm ediyorum!
Dialogue: 55,0:15:23.39,0:15:25.40,Main-207+,,0,0,0,,Lütfen yapmayın!
Dialogue: 55,0:15:25.40,0:15:29.40,Main-207+,,0,0,0,,Şehrin dışındaki koşullar insanlık dışı!
Dialogue: 55,0:15:29.40,0:15:31.99,Main-207+,,0,0,0,,Kahretsin! Cehenneme kadar yolunuz var!
Dialogue: 55,0:15:31.99,0:15:35.13,Main-207+,,0,0,0,,Komurasaki!
Dialogue: 55,0:15:36.10,0:15:40.41,Main-207+,,0,0,0,,Fakirlere duyduğum tek his...
Dialogue: 55,0:15:40.41,0:15:43.08,Main-207+,,0,0,0,,aşağılamadır.
Dialogue: 55,0:16:00.35,0:16:03.17,Main-207+,,0,0,0,,Kapıları açın!
Dialogue: 55,0:16:11.12,0:16:15.74,Main-207+,,0,0,0,,{\i1}Tayu{\i0} Komurasaki geldi!
Dialogue: 55,0:16:33.88,0:16:36.81,Main-207+,,0,0,0,,Demek küçük bir kardeşin var, Momo-{\i1}kun{\i0}?
Dialogue: 55,0:16:36.81,0:16:38.01,Main-207+,,0,0,0,,Hey, Tama!
Dialogue: 55,0:16:38.01,0:16:41.43,Main-207+,,0,0,0,,Çok laubalisin!\NKiminle konuştuğunu sanıyorsun sen?!
Dialogue: 55,0:16:41.43,0:16:42.94,Main-207+,,0,0,0,,Momo-{\i1}kun{\i0}'la.
Dialogue: 55,0:16:43.94,0:16:45.06,Main-207+,,0,0,0,,Unut gitsin...
Dialogue: 55,0:16:46.65,0:16:49.39,Main-207+,,0,0,0,,Evet, küçük bir kız kardeşim var.
Dialogue: 55,0:16:49.39,0:16:51.53,Main-207+,,0,0,0,,Eğer hayattaysa\Nşu an 26 yaşında olmalı.
Dialogue: 55,0:16:52.41,0:16:57.99,Main-207+,,0,0,0,,Annemin vefatına tanıklık edenler vardı\Nlakin Hiyori'nin öldüğünü doğrulayan olmadı.
Dialogue: 55,0:16:57.99,0:17:02.83,Main-207+,,0,0,0,,Hâla bir yerlerde yaşadığına inanıyorum.
Dialogue: 55,0:17:02.83,0:17:05.17,Main-207+,,0,0,0,,Umarım ona tekrar kavuşursun.
Dialogue: 55,0:17:05.17,0:17:07.08,Main-207+,,0,0,0,,Hayır, onu henüz göremem!
Dialogue: 55,0:17:07.08,0:17:11.51,Main-207+,,0,0,0,,Kimliği ifşa olursa\NOrochi onu hedef alır.
Dialogue: 55,0:17:12.40,0:17:15.57,Main-207+,,0,0,0,,Sadece savaş kazanıldıktan sonra kavuşabiliriz!
Dialogue: 55,0:17:21.64,0:17:26.46,Main-207+,,0,0,0,,Muhteşem bir oiran görebilmek için işten kaçabileceğini mi sanıyorsun, Franko?!
Dialogue: 55,0:17:26.46,0:17:27.94,Main-207+,,0,0,0,,Hayır, patron!
Dialogue: 55,0:17:27.94,0:17:29.77,Main-207+,,0,0,0,,Çok özür dilerim!
Dialogue: 55,0:17:30.70,0:17:34.07,Main-207+,,0,0,0,,Bu kadar ateşli bir bebek\Ngörebileceğime hiç inanmazdım!
Dialogue: 55,0:17:35.92,0:17:39.05,Main-207+,,0,0,0,,Nasıl hissettiğini anlıyorum!
Dialogue: 55,0:17:42.84,0:17:47.50,Main-207+,,0,0,0,,Ama biliyorsun ki\Nitibarımı korumak zorundayım, seni salak!
Dialogue: 55,0:17:50.25,0:17:53.01,Main-207+,,0,0,0,,Evet! Çok özür dilerim!
Dialogue: 55,0:17:53.01,0:17:59.47,Main-207+,,0,0,0,,Efsanevi marangozların liderinin\Nadını lekelemek gibi bir niyetim yoktu!
Dialogue: 55,0:18:00.10,0:18:03.31,Main-207+,,0,0,0,,Herkesten on kat daha\Nfazla çalıştığın için...
Dialogue: 55,0:18:03.31,0:18:06.33,Main-207+,,0,0,0,,sanırım bazen işi kaytarman\Numurumda olmaz.
Dialogue: 55,0:18:06.33,0:18:11.86,Main-207+,,0,0,0,,Bana inşa ettiğin Onigashima kalesinin planlarını gösterirsen...
Dialogue: 55,0:18:11.86,0:18:12.90,Main-207+,,0,0,0,,on—
Dialogue: 55,0:18:12.90,0:18:17.07,Main-207+,,0,0,0,,hayır, yüz kat daha fazla çalışacağım!
Dialogue: 55,0:18:17.99,0:18:19.63,Main-207+,,0,0,0,,Oh, evet!
Dialogue: 55,0:18:19.63,0:18:26.16,Main-207+,,0,0,0,,Sorup durduğun\NOnigashima konusuna gelirsek...
Dialogue: 55,0:18:26.16,0:18:29.12,Main-207+,,0,0,0,,O konuya gelirsek... Şey...
Dialogue: 55,0:18:33.50,0:18:36.47,Main-207+,,0,0,0,,Ah, bu sadece bir mendil.
Dialogue: 55,0:18:37.50,0:18:38.63,Main-207+,,0,0,0,,Hadi ama!
Dialogue: 55,0:18:41.09,0:18:42.35,Main-207+,,0,0,0,,Şu planlar...
Dialogue: 55,0:18:46.68,0:18:48.44,Main-207+,,0,0,0,,Şimdi hatırladım.
Dialogue: 55,0:18:50.89,0:18:54.32,Main-207+,,0,0,0,,Yaklaşık on yıl önce,\Nonları rehin verdim!
Dialogue: 55,0:19:08.59,0:19:14.17,Main-207+,,0,0,0,,Bunca haftadır neden senin\Niçin çalıştığımı sanıyorsun lan?
Dialogue: 55,0:19:14.17,0:19:17.63,Main-207+,,0,0,0,,Ah! Lanet olsun, kes şunu, Franko!
Dialogue: 55,0:19:21.55,0:19:25.18,Main-207+,,0,0,0,,Ustana saldırdın!\NSen kim olduğunu sanıyorsun?!
Dialogue: 55,0:19:25.18,0:19:27.31,Main-207+,,0,0,0,,Seni sik kafalı!
Dialogue: 55,0:19:27.31,0:19:29.48,Main-207+,,0,0,0,,Beni deli ediyorsun!
Dialogue: 55,0:19:31.23,0:19:32.27,Main-207+,,0,0,0,,Al bakalım!
Dialogue: 55,0:19:32.27,0:19:35.48,Main-207+,,0,0,0,,{\fad(150,150)}Franosuke Roketatarı!!
Dialogue: 55,0:19:40.78,0:19:43.87,Main-207+,,0,0,0,,Kovuldun! Kaybol, seni bok çuvalı!
Dialogue: 55,0:19:43.87,0:19:46.49,Main-207+,,0,0,0,,Memnuniyetle!\NArtık burada çalışmak işime yaramaz!
Dialogue: 55,0:19:49.21,0:19:52.79,Main-207+,,0,0,0,,On yıl önce rehin verilen planlar mı?
Dialogue: 55,0:19:53.51,0:19:56.67,Main-207+,,0,0,0,,Bu durumla pek sık karşılaşmıyoruz.
Dialogue: 55,0:19:58.99,0:20:00.38,Main-207+,,0,0,0,,Ah, hatırladım!
Dialogue: 55,0:20:00.38,0:20:02.72,Main-207+,,0,0,0,,Ne? Sendeler mi?!
Dialogue: 55,0:20:02.72,0:20:07.07,Main-207+,,0,0,0,,Hayır, tabii ki başkasına sattık.
Dialogue: 55,0:20:07.07,0:20:09.77,Main-207+,,0,0,0,,Kimdi ki acaba?
Dialogue: 55,0:20:09.77,0:20:12.89,Main-207+,,0,0,0,,Hmmm, kim almıştı...?
Dialogue: 55,0:20:12.89,0:20:15.61,Main-207+,,0,0,0,,Acaba...
Dialogue: 55,0:20:16.42,0:20:17.69,Main-207+,,0,0,0,,Ah, evet!
Dialogue: 55,0:20:18.34,0:20:22.70,Main-207+,,0,0,0,,Onları inceleyeceğini söyleyen,\NUzunevler'den Kumagoro'ydu. Kesinlikle!
Dialogue: 55,0:20:24.00,0:20:25.16,Main-207+,,0,0,0,,Kim?!
Dialogue: 55,0:20:25.16,0:20:25.20,Main-207+,,0,0,0,,{\clip(885,950,1077,1056)}Kim?!
Dialogue: 55,0:20:25.20,0:20:25.24,Main-207+,,0,0,0,,{\clip(941,950,1016,1056)}Kim?!}
Dialogue: 55,0:20:25.24,0:20:25.28,Main-207+,,0,0,0,,{\clip(965,950,986,1056)}Kim?!
Dialogue: 55,0:20:26.10,0:20:28.79,Main-207+,,0,0,0,,Kumagoro!
Dialogue: 55,0:20:28.79,0:20:30.79,Main-207+,,0,0,0,,Planlar mı?
Dialogue: 55,0:20:30.79,0:20:34.10,Main-207+,,0,0,0,,Ah, evet, bir aralar bendeydi...
Dialogue: 55,0:20:34.10,0:20:38.55,Main-207+,,0,0,0,,ama kiramı ödeyemedim, bu yüzden ev sahibim Kobe-{\i1}san{\i0} onları benden aldı.
Dialogue: 55,0:20:39.59,0:20:41.47,Main-207+,,0,0,0,,O kim be?!
Dialogue: 55,0:20:41.47,0:20:41.51,Main-207+,,0,0,0,,{\clip(717,939,1238,1056)}O kim be?!
Dialogue: 55,0:20:41.51,0:20:41.55,Main-207+,,0,0,0,,{\clip(837,939,1107,1056)}O kim be?!
Dialogue: 55,0:20:41.55,0:20:41.59,Main-207+,,0,0,0,,{\clip(909,939,1019,1056)}O kim be?!
Dialogue: 55,0:20:41.59,0:20:41.63,Main-207+,,0,0,0,,{\clip(954,939,980,1056)}O kim be?!
Dialogue: 55,0:20:42.42,0:20:44.13,Main-207+,,0,0,0,,Kobe!
Dialogue: 55,0:20:44.13,0:20:49.99,Main-207+,,0,0,0,,Ha, planlar mı? Çok kaliteli şeylerdi,\Nben de onları gözde geyşama verdim.
Dialogue: 55,0:20:49.99,0:20:50.97,Main-207+,,0,0,0,,Kisegawa-{\i1}chan{\i0}.
Dialogue: 55,0:20:50.97,0:20:52.40,Main-207+,,0,0,0,,Onu tanıyor musun?
Dialogue: 55,0:20:52.40,0:20:53.48,Main-207+,,0,0,0,,Tanımıyorum!
Dialogue: 55,0:20:53.48,0:20:53.52,Main-207+,,0,0,0,,{\clip(795,894,1145,1067)}Tanımıyorum!
Dialogue: 55,0:20:53.52,0:20:53.56,Main-207+,,0,0,0,,{\clip(875,894,1055,1067)}Tanımıyorum!
Dialogue: 55,0:20:53.56,0:20:53.60,Main-207+,,0,0,0,,{\clip(923,894,995,1067)}Tanımıyorum!
Dialogue: 55,0:20:53.60,0:20:53.64,Main-207+,,0,0,0,,{\clip(947,894,969,1067)}Tanımıyorum!
Dialogue: 55,0:20:54.48,0:20:59.23,Main-207+,,0,0,0,,Onlarla ne yapacağımı bilemedim, o yüzden tabak altlığı yaptım ama sonra Tokijiro-{\i1}san{\i0}...
Dialogue: 55,0:20:59.23,0:21:01.49,Main-207+,,0,0,0,,Tamam, peki o kim?
Dialogue: 55,0:21:01.49,0:21:01.53,Main-207+,,0,0,0,,{\clip(603,957,1046,1053)}Tamam, peki o kim?
Dialogue: 55,0:21:01.53,0:21:01.57,Main-207+,,0,0,0,,{\clip(603,957,813,1053)}Tamam, peki o kim?
Dialogue: 55,0:21:01.86,0:21:01.90,Main-207+,,0,0,0,,{\clip(1064,971,1140,1061)}Bendeydi...
Dialogue: 55,0:21:01.90,0:21:01.94,Main-207+,,0,0,0,,{\clip(834,971,1140,1061)}Bendeydi...
Dialogue: 55,0:21:01.94,0:21:03.78,Main-207+,,0,0,0,,Bendeydi...
Dialogue: 55,0:21:03.78,0:21:06.99,Main-207+,,0,0,0,,ama Rakuda-{\i1}san{\i0} onların değerli olduklarını söyleyip benden aldı!
Dialogue: 55,0:21:06.99,0:21:09.70,Main-207+,,0,0,0,,Ne? Rakuda mı? Bir hayvan mı aldı?!
Dialogue: 55,0:21:09.70,0:21:09.74,Main-207+,,0,0,0,,{\clip(m 312 859.5 l 1180.5 867 1287 1048.5 312 1048.5)}Ne? Rakuda mı? Bir hayvan mı aldı?!
Dialogue: 55,0:21:09.74,0:21:09.79,Main-207+,,0,0,0,,{\clip(m 312 859.5 l 1069.5 868.5 1183.5 1048.5 312 1048.5)}Ne? Rakuda mı? Bir hayvan mı aldı?!
Dialogue: 55,0:21:09.79,0:21:09.83,Main-207+,,0,0,0,,{\clip(m 312 859.5 l 961.5 868.5 1074 1048.5 312 1048.5)}Ne? Rakuda mı? Bir hayvan mı aldı?!
Dialogue: 55,0:21:09.83,0:21:09.87,Main-207+,,0,0,0,,{\clip(m 312 859.5 l 861 864 961.5 1048.5 312 1048.5)}Ne? Rakuda mı? Bir hayvan mı aldı?!
Dialogue: 55,0:21:09.87,0:21:09.91,Main-207+,,0,0,0,,{\clip(m 312 859.5 l 738 861 855 1048.5 312 1048.5)}Ne? Rakuda mı? Bir hayvan mı aldı?!
Dialogue: 55,0:21:09.91,0:21:09.95,Main-207+,,0,0,0,,{\clip(m 312 859.5 l 628.5 868.5 753 1048.5 312 1048.5)}Ne? Rakuda mı? Bir hayvan mı aldı?!
Dialogue: 55,0:21:09.95,0:21:09.99,Main-207+,,0,0,0,,{\clip(m 312 957 l 579 960 639 1048.5 312 1048.5)}Ne? Rakuda mı? Bir hayvan mı aldı?!
Dialogue: 50,0:21:09.99,0:21:10.04,Main-207+,,0,0,0,,{\clip(m 326 960 l 490 978 554 1060 304 1062)}Ne? Rakuda mı? Bir hayvan mı aldı?!
Dialogue: 50,0:21:10.04,0:21:10.08,Main-207+,,0,0,0,,{\clip(m 316 970 l 390 988 444 1054 274 1048)}Ne? Rakuda mı? Bir hayvan mı aldı?!
Dialogue: 55,0:21:10.81,0:21:12.77,Main-207+,,0,0,0,,Rakuda benim!
Dialogue: 55,0:21:12.77,0:21:16.23,Main-207+,,0,0,0,,Var ya, o planlar yüzünden\Ninanılmaz kötü zamanlar atlattım.
Dialogue: 55,0:21:16.23,0:21:18.29,Main-207+,,0,0,0,,Adamın biri onlarla kaçtı!
Dialogue: 55,0:21:18.29,0:21:23.55,Main-207+,,0,0,0,,Yüzü kapalıydı,\Nama dediğine göre Kuri'den geliyormuş.
Dialogue: 55,0:21:23.55,0:21:26.10,Main-207+,,0,0,0,,{\fad(0,500)}Kuri mi?!
Dialogue: 55,0:21:30.31,0:21:30.93,Main-207+,,0,0,0,,Şey...
Dialogue: 55,0:21:30.93,0:21:34.00,Main-207+,,0,0,0,,Ah, üzgünüm. Bu bir çipura.
Dialogue: 55,0:21:34.00,0:21:36.23,Main-207+,,0,0,0,,Çipura normalde böyle mi görünür?
Dialogue: 55,0:21:36.23,0:21:39.11,Main-207+,,0,0,0,,Sizinle iş yapmak çok güzeldi!
Dialogue: 55,0:21:43.03,0:21:44.49,Main-207+,,0,0,0,,Franosuke-{\i1}dono{\i0}!
Dialogue: 55,0:21:46.40,0:21:48.24,Main-207+,,0,0,0,,Neşen yerinde gibi.
Dialogue: 55,0:21:48.24,0:21:51.37,Main-207+,,0,0,0,,Elbette! Sen burada ne yapıyorsun?!
Dialogue: 55,0:21:51.37,0:21:55.09,Main-207+,,0,0,0,,Ne? Şey, balık satıyorum.
Dialogue: 55,0:21:55.09,0:21:58.79,Main-207+,,0,0,0,,Çok fazla göze batıyorsun!\NÇocuklar etrafını sarmış!
Dialogue: 55,0:21:58.79,0:22:04.91,Main-207+,,0,0,0,,Her neyse, neden acele hâlindesin?\NBir durum mu var?
Dialogue: 55,0:22:04.91,0:22:10.35,Main-207+,,0,0,0,,Hah, doğru ya! Göze batmayı falan boşver!\NÇok daha önemli işlerimiz var!
Dialogue: 55,0:22:10.35,0:22:16.06,Main-207+,,0,0,0,,Çalıştığım kişinin elinde planlar yokmuş!
Dialogue: 55,0:22:17.55,0:22:20.56,Main-207+,,0,0,0,,Şuradaki kılıçları kontrol et.
Dialogue: 55,0:22:20.56,0:22:25.74,Main-207+,,0,0,0,,Kaido'nun kalesinin planları burada,\NKuri'de miymiş?
Dialogue: 55,0:22:25.74,0:22:30.45,Main-207+,,0,0,0,,{\i1}Evet! Bütün başkent boyunca\Naradım ama onları bulamadım!
Dialogue: 55,0:22:30.45,0:22:33.15,Main-207+,,0,0,0,,{\i1}Şu an ne yapmam gerek bilmiyorum!
Dialogue: 55,0:22:34.21,0:22:36.66,Main-207+,,0,0,0,,Başına gelenler için üzgünüm.
Dialogue: 55,0:22:36.66,0:22:40.75,Main-207+,,0,0,0,,Franosuke-dono, lütfen başkenttekilere görevlerini tamamlamaları için destek ol.
Dialogue: 55,0:22:40.75,0:22:42.39,Main-207+,,0,0,0,,{\i1}Anlaşıldı!
Dialogue: 55,0:22:42.38,0:22:43.11,Main-207+,,0,0,0,,{Clank.}
Dialogue: 55,0:22:43.60,0:22:48.52,Main-207+,,0,0,0,,Hmm. Kaido'nun kalesinin planlarını kim ister ki?
Dialogue: 55,0:22:48.52,0:22:49.91,Main-207+,,0,0,0,,Acaba...
Dialogue: 55,0:22:50.80,0:22:52.72,Main-207+,,0,0,0,,Dük-{\i1}sama{\i0}! Kin-{\i1}san{\i0}!
Dialogue: 55,0:22:52.72,0:22:54.77,Main-207+,,0,0,0,,Hey!
Dialogue: 55,0:22:55.47,0:22:56.77,Main-207+,,0,0,0,,
Dialogue: 55,0:22:56.77,0:23:01.94,Main-207+,,0,0,0,,Fabrikadan bir sürü silah\Nve yiyecek çalabildik!
Dialogue: 55,0:23:01.94,0:23:05.15,Main-207+,,0,0,0,,Harika iş. Kartı da arkada bıraktın mı?
Dialogue: 55,0:23:05.15,0:23:06.78,Main-207+,,0,0,0,,Elbette!
Dialogue: 55,0:23:08.65,0:23:10.55,Main-207+,,0,0,0,,Ama sorun olmayacak mı?
Dialogue: 55,0:23:10.55,0:23:16.20,Main-207+,,0,0,0,,Bıraktığımız not, Canavar Korsanları'nın\NAshura Doji'ye saldırmasına neden olabilir.
Dialogue: 55,0:23:16.20,0:23:20.58,Main-207+,,0,0,0,,Bu da tam istediğimiz şey.\NSaldırıya uğramak onu çileden çıkaracaktır.
Dialogue: 55,0:23:20.58,0:23:25.42,Main-207+,,0,0,0,,Öfkesinden faydalanıp onu\NCanavar Korsanları'yla savaşmaya itmezsek...
Dialogue: 55,0:23:25.42,0:23:28.68,Main-207+,,0,0,0,,içindeki ateşi asla yeniden yakamayız.
Dialogue: 55,0:23:31.69,0:23:38.21,Main-207+,,0,0,0,,20 yıldır yaşadığı pişmanlık göz önüne alındığında bu biraz ağır görünüyor.
Dialogue: 55,0:23:38.21,0:23:39.60,Main-207+,,0,0,0,,Biliyorum!
Dialogue: 55,0:23:39.60,0:23:45.23,Main-207+,,0,0,0,,Ama başka seçeneğimiz yok, Kaido'yu yenmek için ne gerekiyorsa yapmalıyız!
Dialogue: 55,0:23:45.90,0:23:48.69,Main-207+,,0,0,0,,Ashura Doji'ye ihtiyacımız var!
Dialogue: 55,0:23:51.40,0:23:54.87,Main-207+,,0,0,0,,Hey! Geri döndüm!
Dialogue: 55,0:24:00.41,0:24:01.79,Main-207+,,0,0,0,,Yas-{\i1}san{\i0}!
Dialogue: 55,0:24:02.79,0:24:05.96,Main-207+,,0,0,0,,Gerçekten dönmüşsün, Tonoyasu!
Dialogue: 55,0:24:05.96,0:24:09.59,Main-207+,,0,0,0,,Gittin geldin ama hâlâ yiyeceğimiz yok!
Dialogue: 55,0:24:11.08,0:24:12.76,Main-207+,,0,0,0,,Çok açım!
Dialogue: 55,0:24:13.69,0:24:15.55,Main-207+,,0,0,0,,Açlıktan ölüyorum!
Dialogue: 55,0:24:24.80,0:24:27.40,Main-207+,,0,0,0,,Neden bu kadar neşeliler?
Dialogue: 55,0:24:27.40,0:24:28.86,Main-207+,,0,0,0,,Vay be!
Dialogue: 55,0:24:28.86,0:24:33.20,Main-207+,,0,0,0,,Hemen anladınız, bayım!\NBuradaki herkes mutlu görünüyor, değil mi?
Dialogue: 55,0:24:33.94,0:24:36.66,Main-207+,,0,0,0,,Kuri'deki Okobore Kasabası'ndan oldukça farklı.
Dialogue: 55,0:24:39.07,0:24:43.79,Main-207+,,0,0,0,,Böyle gülebilen tek kişiler biziz!
Dialogue: 55,0:24:43.79,0:24:44.67,Main-207+,,0,0,0,,Evet!
Dialogue: 55,0:24:44.67,0:24:48.90,Main-207+,,0,0,0,,{\fad(150,150)}♪ İşte bu yüzden basacaksın kahkahayı! ♪
Dialogue: 50,0:24:50.68,0:24:52.76,Main-207+,,0,0,0,,{\fad(150,150)}♪ Basacaksın kahkahayı! ♪
Dialogue: 50,0:24:54.97,0:24:57.28,Main-207+,,0,0,0,,{\fad(150,150)}♪ Basacaksın kahkahayı! ♪
Dialogue: 55,0:25:00.72,0:25:02.68,Main-207+,,0,0,0,,Kusurumuza bakmayın!
Dialogue: 55,0:25:11.59,0:25:12.99,Main-207+,,0,0,0,,– Orochi-{\i1}sama{\i0}!\N– Orochi-{\i1}sama{\i0}!
Dialogue: 55,0:25:21.20,0:25:25.12,Main-207+,,0,0,0,,Yeter! Başlarınızı kaldırın!
Dialogue: 55,0:25:26.33,0:25:30.09,Main-207+,,0,0,0,,Akşam yemeği ne durumda?
Dialogue: 55,0:25:30.09,0:25:33.38,Main-207+,,0,0,0,,Efendim! Her şey hazır!
Dialogue: 55,0:25:33.38,0:25:34.62,Main-207+,,0,0,0,,Getirin!
Dialogue: 55,0:25:37.34,0:25:39.22,Main-207+,,0,0,0,,Oh!
Dialogue: 55,0:25:39.22,0:25:43.40,Main-207+,,0,0,0,,Orochi Çiftliği'nin eşsiz ortamında beslediğimiz tavukları kesip...
Dialogue: 55,0:25:43.40,0:25:45.06,Main-207+,,0,0,0,,suda haşladık.
Dialogue: 55,0:25:45.06,0:25:47.06,Main-207+,,0,0,0,,İstemez! Canım tavuk istemiyor!
Dialogue: 55,0:25:47.06,0:25:49.60,Main-207+,,0,0,0,,Tabii, lordum! Hemen yok ediyoruz!
Dialogue: 55,0:25:49.60,0:25:51.10,Main-207+,,0,0,0,,Götürün onu!
Dialogue: 55,0:25:51.10,0:25:52.15,Main-207+,,0,0,0,,Sıradaki!
Dialogue: 55,0:25:52.15,0:25:54.45,Main-207+,,0,0,0,,Sırada taze ve lezzetli sebzeler...
Dialogue: 55,0:25:54.45,0:25:55.37,Main-207+,,0,0,0,,İstemiyorum!
Dialogue: 55,0:25:55.37,0:25:57.28,Main-207+,,0,0,0,,Tabii, lordum. Hemen çöpe atacağız.
Dialogue: 55,0:25:57.28,0:25:58.36,Main-207+,,0,0,0,,Sıradaki!
Dialogue: 55,0:25:59.39,0:26:02.45,Main-207+,,0,0,0,,Karşınızda bulabileceğiniz en has, en yağlı uskumrular!
Dialogue: 55,0:26:03.62,0:26:06.10,Main-207+,,0,0,0,,Uskumruyu severim!
Dialogue: 55,0:26:06.10,0:26:07.90,Main-207+,,0,0,0,,Ve sashimi için de tunamız var!
Dialogue: 55,0:26:07.91,0:26:10.79,Main-207+,,0,0,0,,Of! Tuna en iyisi!
Dialogue: 55,0:26:10.79,0:26:14.88,Main-207+,,0,0,0,,Ve Wano'nun dört bir yanından çeşitli sakelerimiz var...
Dialogue: 55,0:26:14.88,0:26:16.84,Main-207+,,0,0,0,,Anladık be anladık!
Dialogue: 55,0:26:18.41,0:26:21.73,Main-207+,,0,0,0,,Sakeniz bol nasılsa!
Dialogue: 55,0:26:21.73,0:26:24.12,Main-207+,,0,0,0,,Peki ya kadın?
Dialogue: 55,0:26:24.12,0:26:25.77,Main-207+,,0,0,0,,Her şey ayarlandı!
Dialogue: 55,0:26:25.77,0:26:27.89,Main-207+,,0,0,0,,Güzel! Güzel!
Dialogue: 55,0:26:33.98,0:26:36.92,Main-207+,,0,0,0,,Anne, acıktım!
Dialogue: 55,0:26:36.92,0:26:38.78,Main-207+,,0,0,0,,Ben de!
Dialogue: 55,0:26:41.57,0:26:45.45,Main-207+,,0,0,0,,Yetersiz beslenmeden dolayı dişim düştü!
Dialogue: 55,0:26:46.90,0:26:49.28,Main-207+,,0,0,0,,Sanki çiğneyecek yemeğin varmış gibi!
Dialogue: 55,0:26:51.17,0:26:54.96,Main-207+,,0,0,0,,Tonoyasu, bu ronin kim?
Dialogue: 55,0:26:54.96,0:26:57.76,Main-207+,,0,0,0,,Üç kılıcı var!
Dialogue: 55,0:26:58.76,0:27:01.58,Main-207+,,0,0,0,,Haklısın! Üç kılıç!
Dialogue: 55,0:27:01.58,0:27:03.26,Main-207+,,0,0,0,,Ve hepsi uzun kılıçlar!
Dialogue: 55,0:27:03.26,0:27:05.10,Main-207+,,0,0,0,,Komik olmaya mı çalışıyorsun?
Dialogue: 55,0:27:07.09,0:27:11.79,Main-207+,,0,0,0,,Vay vay! Bu beyefendiye hayranım!
Dialogue: 55,0:27:11.79,0:27:16.40,Main-207+,,0,0,0,,Oh hayır! Şu tuhaf herifin\Nseni takip etmesine üzüldüm.
Dialogue: 55,0:27:16.40,0:27:19.82,Main-207+,,0,0,0,,O kadar da kötü değil,\Nben dünyanın en iyi dalkavuğuyum!
Dialogue: 55,0:27:19.82,0:27:22.02,Main-207+,,0,0,0,,Değil mi, yakışıklı?!
Dialogue: 55,0:27:23.00,0:27:27.50,Main-207+,,0,0,0,,Anladım! Ama suratına baksana. Çok ciddi!
Dialogue: 55,0:27:27.50,0:27:31.83,Main-207+,,0,0,0,,Hadi, genç adam. Şu korkunç bakışı bırak.
Dialogue: 55,0:27:34.30,0:27:36.71,Main-207+,,0,0,0,,Bize güzel bi' gülümseme ver!
Dialogue: 55,0:27:36.71,0:27:40.30,Main-207+,,0,0,0,,Ebisu gibi berbat bir delikte bile iyi şeyler olabilir!
Dialogue: 55,0:27:40.30,0:27:44.97,Main-207+,,0,0,0,,O, kasabaya uğradı mı?!
Dialogue: 55,0:27:44.97,0:27:49.93,Main-207+,,0,0,0,,Aynen öyle, Ushimitsu Kozo\Nbizi bir kez daha ziyaret etti!
Dialogue: 55,0:27:51.52,0:27:53.31,Main-207+,,0,0,0,,Bu harika!
Dialogue: 55,0:27:53.31,0:27:55.48,Main-207+,,0,0,0,,Uhimi'ne'?
Dialogue: 55,0:27:55.48,0:27:59.40,Main-207+,,0,0,0,,Evet, ne zaman başımız belaya girse,\Nburaya uğrar!
Dialogue: 55,0:27:59.40,0:28:02.83,Main-207+,,0,0,0,,Kim olduğunu hiç bilmiyoruz.
Dialogue: 55,0:28:04.12,0:28:07.90,Main-207+,,0,0,0,,Geceleyin iblis saatinde ortaya çıkıyor...
Dialogue: 55,0:28:07.90,0:28:11.46,Main-207+,,0,0,0,,ve başkentteki pislik zenginlerden çalıyor.
Dialogue: 55,0:28:19.40,0:28:23.69,Main-207+,,0,0,0,,Parayı fakirlere dağıtıp ortadan kayboluyor.
Dialogue: 55,0:28:23.69,0:28:26.63,Main-207+,,0,0,0,,Kim olduğunu çok merak ediyorum!
Dialogue: 55,0:28:26.63,0:28:29.51,Main-207+,,0,0,0,,Tanrıya şükür, tanrıya şükür!
Dialogue: 55,0:28:30.60,0:28:32.94,Main-207+,,0,0,0,,Gülmek şans getirir!
Dialogue: 55,0:28:32.94,0:28:37.16,Main-207+,,0,0,0,,Bu yüzden, biz de bu ilkeye uyma kararı aldık!
Dialogue: 55,0:28:38.32,0:28:41.15,Main-207+,,0,0,0,,Ah! Ne tür bir ilke?
Dialogue: 55,0:28:41.15,0:28:43.13,Main-207+,,0,0,0,,Burada!
Dialogue: 55,0:28:43.13,0:28:44.41,Main-207+,,0,0,0,,Gördün mü?
Dialogue: 55,0:28:44.41,0:28:46.28,Main-207+,,0,0,0,,İşte bu!
Dialogue: 55,0:28:47.19,0:28:49.12,Main-207+,,0,0,0,,Lütfen bir bardak al!
Dialogue: 55,0:28:50.85,0:28:52.46,Main-207+,,0,0,0,,Biraz içmelisin!
Dialogue: 55,0:28:54.19,0:28:56.00,Main-207+,,0,0,0,,Temiz su!
Dialogue: 55,0:28:56.00,0:28:58.34,Main-207+,,0,0,0,,Gelen parayla biraz aldık!
Dialogue: 55,0:29:01.84,0:29:04.05,Main-207+,,0,0,0,,Hayır, içmesem daha iyi...
Dialogue: 55,0:29:04.05,0:29:05.73,Main-207+,,0,0,0,,Endişelenme!
Dialogue: 55,0:29:06.89,0:29:11.39,Main-207+,,0,0,0,,Bu su temiz,\No yüzden karnın ağrımaz!
Dialogue: 55,0:29:11.39,0:29:16.09,Main-207+,,0,0,0,,Yasu-{\i1}san{\i0} seni buraya getirdiyse\Niyi bir insan olmalısın!
Dialogue: 55,0:29:20.52,0:29:22.80,Main-207+,,0,0,0,,Utangaç olma!
Dialogue: 55,0:29:22.80,0:29:27.62,Main-207+,,0,0,0,,Hadi iç!\NHerkesin biraz almaya hakkı var!
Dialogue: 55,0:29:27.62,0:29:29.74,Main-207+,,0,0,0,,{\fad(150,150)}♪ Lezzetli su! ♪
Dialogue: 55,0:29:29.74,0:29:31.74,Main-207+,,0,0,0,,{\fad(150,150)}♪ Temiz su! ♪
Dialogue: 55,0:29:31.74,0:29:34.08,Main-207+,,0,0,0,,{\fad(150,150)}♪ Lezzetli su! ♪
Dialogue: 55,0:29:34.08,0:29:36.21,Main-207+,,0,0,0,,{\fad(150,150)}♪ Temiz su! ♪
Dialogue: 55,0:29:36.21,0:29:40.63,Main-207+,,0,0,0,,{\fad(150,150)}♪ Lezzetli su! Temiz su! ♪
Dialogue: 55,0:29:40.63,0:29:44.68,Main-207+,,0,0,0,,{\fad(150,150)}♪ Lezzetli su! Temiz su! ♪
Dialogue: 55,0:29:44.68,0:29:49.34,Main-207+,,0,0,0,,{\fad(150,150)}♪ Lezzetli su! Temiz su! ♪
Dialogue: 55,0:30:02.03,0:30:04.94,Main-207+,,0,0,0,,Nasıl ama?!\Nİliklerine kadar işliyor, değil mi?!
Dialogue: 55,0:30:05.78,0:30:08.53,Main-207+,,0,0,0,,Hadi ama yine mi o ciddi bakış!
Dialogue: 55,0:30:10.95,0:30:14.09,Main-207+,,0,0,0,,Gül ki şans da sana gülsün!
Dialogue: 55,0:30:14.79,0:30:18.42,Main-207+,,0,0,0,,Bu ülkede herkes böyle bir gülümsemeye...
Dialogue: 55,0:30:18.42,0:30:22.42,Main-207+,,0,0,0,,"Ebisu Sırıtışı" der, bayım!
Dialogue: 55,0:30:22.42,0:30:25.45,Main-207+,,0,0,0,,Bu yüzden buraya Ebisu deniyor!
Dialogue: 55,0:30:25.45,0:30:28.55,Main-207+,,0,0,0,,Yoksulluk ve talihsizlik bizi yıkamaz!
Dialogue: 55,0:30:28.55,0:30:32.56,Main-207+,,0,0,0,,♪ Ağlamak yoksulluğunuzu gidermez!\NO yüzden, basacaksın kahkahayı! ♪
Dialogue: 55,0:30:32.56,0:30:35.06,Main-207+,,0,0,0,,♪ Basacaksın kahkahayı! ♪
Dialogue: 55,0:30:42.02,0:30:45.24,Main-207+,,0,0,0,,Yeterince bekledim! Onları göreceğim!
Dialogue: 55,0:30:45.24,0:30:47.49,Main-207+,,0,0,0,,Bir saniye, lordum!
Dialogue: 55,0:30:48.74,0:30:53.24,Main-207+,,0,0,0,,Ah, evet! Bu kızlar harika!
Dialogue: 55,0:30:57.83,0:31:01.99,Main-207+,,0,0,0,,Memnun kaldınız mı, lordum?
Dialogue: 55,0:31:01.99,0:31:04.88,Main-207+,,0,0,0,,Onlar... muhteşemler!
Dialogue: 55,0:31:06.20,0:31:10.43,Main-207+,,0,0,0,,Harika! Haydi ziyafete başlayalım!
Dialogue: 55,0:31:10.43,0:31:11.68,Main-207+,,0,0,0,,İçin!
Dialogue: 55,0:31:11.68,0:31:13.30,Main-207+,,0,0,0,,Dans edin!
Dialogue: 55,0:31:13.30,0:31:15.14,Main-207+,,0,0,0,,Şarkı söyleyin!
Dialogue: 55,0:31:15.14,0:31:18.05,Main-207+,,0,0,0,,Sakın kendinizi tutmayın!
Dialogue: 55,0:31:27.40,0:31:29.40,Main-207+,,0,0,0,,Ben geldim.
Dialogue: 55,0:31:39.00,0:31:42.79,Main-207+,,0,0,0,,Ah, Komurasaki! Seni özledim!
Dialogue: 55,0:31:44.11,0:31:46.34,Main-207+,,0,0,0,,Ben de sizi...
Dialogue: 55,0:31:47.10,0:31:48.01,Main-207+,,0,0,0,,lordum.
Dialogue: 55,0:31:48.01,0:31:50.43,Main-207+,,0,0,0,,Oh, ö-öyle mi?!
Dialogue: 55,0:31:53.64,0:31:55.54,Main-207+,,0,0,0,,Özledin mi?!
Dialogue: 55,0:32:04.59,0:32:07.44,Main-207+,,0,0,0,,Trao, seni buraya ne getirdi?
Dialogue: 55,0:32:07.44,0:32:11.49,Main-207+,,0,0,0,,Acil bir durum var.\NSaklanman gerek, Kara Bacak-{\i1}ya{\i0}.
Dialogue: 55,0:32:12.41,0:32:16.20,Main-207+,,0,0,0,,Önceki kavgayla mı ilgili?\NGeri dönerlerse onları yine pataklarım.
Dialogue: 55,0:32:16.20,0:32:17.66,Main-207+,,0,0,0,,Sorun o değil.
Dialogue: 55,0:32:18.50,0:32:21.08,Main-207+,,0,0,0,,Şu an gelenler suratlarımızı biliyor.
Dialogue: 55,0:32:22.99,0:32:24.00,Main-207+,,0,0,0,,Hawkins mi?
Dialogue: 55,0:32:24.00,0:32:27.59,Main-207+,,0,0,0,,Sadece o olsaydı problem olmazdı...
Dialogue: 55,0:32:28.50,0:32:32.60,Main-207+,,0,0,0,,Öncülerin en güçlü altısına\NTobi Roppo deniyor.
Dialogue: 55,0:32:33.39,0:32:34.89,Main-207+,,0,0,0,,İkisi buraya geliyor.
Dialogue: 55,0:32:34.89,0:32:36.05,Main-207+,,0,0,0,,İkisi mi?
Dialogue: 55,0:32:36.05,0:32:40.27,Main-207+,,0,0,0,,Tobi Roppo'dan Page One...
Dialogue: 55,0:32:49.48,0:32:52.65,Main-207+,,0,0,0,,Tobi Roppo... Page One...
Dialogue: 55,0:32:52.65,0:32:57.83,Main-207+,,0,0,0,,...ve X Drake.
Dialogue: 55,0:32:57.83,0:32:59.90,Main-207+,,0,0,0,,Drake...
Dialogue: 55,0:32:59.90,0:33:02.54,Main-207+,,0,0,0,,En Kötü Nesilden.
Dialogue: 55,0:33:06.80,0:33:12.05,Main-207+,,0,0,0,,Page One, bunu neden bizim yapmamız gerekiyor?
Dialogue: 55,0:33:17.43,0:33:19.50,Main-207+,,0,0,0,,Bir örnek teşkil etmesi için, sanırım.
Dialogue: 55,0:33:19.50,0:33:28.34,Main-207+,,0,0,0,,Wano'da Canavar Korsanları'na bulaşınca neler olduğunu onlara göstermeliyiz.
Dialogue: 55,0:33:28.34,0:33:31.03,Main-207+,,0,0,0,,Peki sen neden buradasın,
Dialogue: 55,0:33:31.53,0:33:32.81,Main-207+,,0,0,0,,Hawkins?
Dialogue: 55,0:33:32.81,0:33:35.46,Main-207+,,0,0,0,,Birini arıyorum...
Dialogue: 55,0:33:35.46,0:33:40.28,Main-207+,,0,0,0,,Bu iş sandığından daha çetrefilli, Drake.
Dialogue: 55,0:33:48.54,0:33:53.84,Main-207+,,0,0,0,,Önceki teklifim üzerine düşündün mü, patron?
Dialogue: 55,0:33:53.84,0:33:58.62,Main-207+,,0,0,0,,Kaçacaksan beni de yanına al!
Dialogue: 55,0:33:58.62,0:34:00.93,Main-207+,,0,0,0,,Her şeyi yaparım!
Dialogue: 55,0:34:00.93,0:34:05.77,Main-207+,,0,0,0,,Güçlerimizi birleştirirsek durdurulamaz oluruz!
Dialogue: 55,0:34:05.77,0:34:09.54,Main-207+,,0,0,0,,Kes artık!\NNiye Dikenli'yle takım olmuyorsun?!
Dialogue: 55,0:34:09.54,0:34:11.07,Main-207+,,0,0,0,,Kid'den mi bahsediyorsun?
Dialogue: 55,0:34:11.07,0:34:15.66,Main-207+,,0,0,0,,Hayatta olmaz. Onun itibârı yerlerde.
Dialogue: 55,0:34:15.66,0:34:21.87,Main-207+,,0,0,0,,Big Mom'ı devirmeye çalıştığını duydun mu?
Dialogue: 55,0:34:21.87,0:34:27.11,Main-207+,,0,0,0,,Söylentiye göre kaçmadan önce\Nkolu Big Mom'ın...
Dialogue: 55,0:34:27.11,0:34:29.84,Main-207+,,0,0,0,,bir astı tarafından koparılmış.
Dialogue: 55,0:34:30.88,0:34:34.72,Main-207+,,0,0,0,,Söylenti mi? Bu tür saçmalıkları dinlemek acı verici.
Dialogue: 55,0:34:34.97,0:34:41.22,Main-207+,,0,0,0,,Hayır, çok güvenilir bir\Nkaynaktan duydum, patron!
Dialogue: 55,0:34:44.48,0:34:47.94,Main-207+,,0,0,0,,Kimmiş kaynak?
Dialogue: 55,0:34:47.94,0:34:52.36,Main-207+,,0,0,0,,Big Mom'ı asla devirmeye çalışmadım!
Dialogue: 55,0:34:52.36,0:34:55.10,Main-207+,,0,0,0,,K-K-K-Kid!
Dialogue: 55,0:34:55.10,0:34:58.00,Main-207+,,0,0,0,,Onun Tatlı Komutanları'ndan birini yaraladım...
Dialogue: 55,0:34:58.00,0:35:00.70,Main-207+,,0,0,0,,ve istediğimi alıp oradan ayrıldım!
Dialogue: 55,0:35:00.70,0:35:03.24,Main-207+,,0,0,0,,A-A-A-Ama kolun...
Dialogue: 55,0:35:03.24,0:35:09.58,Main-207+,,0,0,0,,Onu çoktan Kızıl Saç Korsanları'na \Nkarşı verdiğim savaşta kaybetmiştim.
Dialogue: 55,0:35:12.30,0:35:14.15,Main-207+,,0,0,0,,Başka sorusu olan?!
Dialogue: 55,0:35:14.15,0:35:14.88,Main-207+,,0,0,0,,Yok.
Dialogue: 55,0:35:14.88,0:35:20.38,Main-207+,,0,0,0,,O hâlde, bir şey söyleyeyim!\NSen de dinle, aptal maymun!
Dialogue: 55,0:35:20.38,0:35:21.34,Main-207+,,0,0,0,,Ne?!
Dialogue: 55,0:35:22.01,0:35:25.90,Main-207+,,0,0,0,,Kaido'yu devirip zaferi kazanacak olan benim!
Dialogue: 55,0:35:25.90,0:35:27.88,Main-207+,,0,0,0,,Hayır, benim!
Dialogue: 55,0:35:27.88,0:35:28.77,Main-207+,,0,0,0,,Ne?!
Dialogue: 55,0:35:38.57,0:35:42.70,Main-207+,,0,0,0,,Millet, Ateş Festivali neredeyse yaklaştı!
Dialogue: 55,0:35:42.70,0:35:45.03,Main-207+,,0,0,0,,Bu partiyi hazırlık olarak düşünelim!
Dialogue: 55,0:35:45.03,0:35:48.41,Main-207+,,0,0,0,,Kendinizi şımartın!
Dialogue: 55,0:35:48.41,0:35:51.92,Main-207+,,0,0,0,,Burası Wano!
Dialogue: 55,0:35:51.92,0:35:54.34,Main-207+,,0,0,0,,Ülke tam bir cennet!
Dialogue: 55,0:35:54.34,0:35:57.71,Main-207+,,0,0,0,,Gönlünüzce yiyip için!
Dialogue: 55,0:36:06.04,0:36:10.35,Main-207+,,0,0,0,,Devasa bir gemiyle güneydoğudan yaklaşıyorlar!
Dialogue: 55,0:36:12.02,0:36:14.52,Main-207+,,0,0,0,,Gerçekten geldi demek!
Dialogue: 55,0:36:15.20,0:36:17.07,Main-207+,,0,0,0,,Parçalayın onları!
Dialogue: 55,0:36:17.07,0:36:19.92,Main-207+,,0,0,0,,Bu ülkeye girmelerine izin vermeyin!
Dialogue: 55,0:36:19.92,0:36:23.91,Main-207+,,0,0,0,,Ama bir problemimiz var.
Dialogue: 55,0:36:30.08,0:36:34.92,Main-207+,,0,0,0,,Sazanlar gemiyi çekiyor, yardırmış geliyorlar!
Dialogue: 55,0:36:34.92,0:36:36.60,Main-207+,,0,0,0,,Ne?!
Dialogue: 55,0:36:36.60,0:36:40.09,Main-207+,,0,0,0,,Şelaleye nasıl tırmanacaklarını nereden biliyorlar?!
Dialogue: 55,0:36:40.09,0:36:46.18,Main-207+,,0,0,0,,Big Mom Korsanları iyi istihbarat toplamalarıyla bilinirler.
Dialogue: 55,0:36:46.18,0:36:49.10,Main-207+,,0,0,0,,Kapa' çeneni! Bu umurumda değil!
Dialogue: 55,0:36:49.10,0:36:51.89,Main-207+,,0,0,0,,Geleceklerini zaten biliyorduk!
Dialogue: 55,0:36:51.89,0:36:54.19,Main-207+,,0,0,0,,Batırın gitsin!
Dialogue: 55,0:37:00.20,0:37:07.62,Main-207+,,0,0,0,,O bunak kocakarı!\NOnu uyardığımı unutmuş olmalı...
Dialogue: 55,0:37:07.62,0:37:12.83,Main-207+,,0,0,0,,Buraya adım atarsan seni öldürürüm, Linlin!
Dialogue: 55,0:38:46.89,0:38:50.87,Main-207+,,0,0,0,,Benden kaçamazsın, Hasır Şapka.
