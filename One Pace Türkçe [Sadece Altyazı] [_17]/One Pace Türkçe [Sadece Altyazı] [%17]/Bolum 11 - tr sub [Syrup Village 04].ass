yle: Karaoke-furigana,Duality,36,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,2.95,0,8,23,23,23,1Style: Lyrics-furigana,Duality,36,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,2.95,0,2,23,23,34,1Style: Lyrics,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,2,23,23,34,1Style: Karaoke,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,23,1Style: Kanji,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,146,1Style: Roger-Monologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1Style: Romaji ED,Josefin Sans,82,&H00FFFFFF,&H003592BE,&H00000000,&H64000000,0,0,0,0,100,100,0,0,1,0,4,8,10,10,20,1Style: Translation ED,Josefin Sans,82,&H00FFFFFF,&H000000FF,&H00FFFFFF,&H64000000,0,0,0,0,100,100,0,0,1,0,4,2,10,10,20,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:50.01,0:02:00.00,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 50,0:02:03.65,0:02:05.02,Flashbacks-207-,,0,0,0,,Lan!Dialogue: 50,0:02:05.02,0:02:08.40,Flashbacks-207-,,0,0,0,,Beni aptal durumuna düşürdün...Dialogue: 50,0:02:08.98,0:02:13.07,Flashbacks-207-,,0,0,0,,Korsan kanımla alay etmeye nasıl cüret edersin?!Dialogue: 50,0:02:13.07,0:02:15.45,Flashbacks-207-,,0,0,0,,Lütfen dur, Usopp-san!Dialogue: 50,0:02:36.18,0:02:37.72,Main-207-,,0,0,0,,Klahadore...Dialogue: 50,0:02:38.60,0:02:40.10,Main-207-,,0,0,0,,Klahadore, orda mısın?Dialogue: 50,0:02:41.60,0:02:43.23,Main-207-,,0,0,0,,Klahadore...Dialogue: 50,0:02:46.23,0:02:48.19,Main-207-,,0,0,0,,M-Merry!Dialogue: 50,0:02:48.82,0:02:49.90,Main-207-,,0,0,0,,Merry!Dialogue: 50,0:02:50.69,0:02:53.03,Main-207-,,0,0,0,,Sorun nedir?! Ne oldu?!Dialogue: 50,0:02:53.03,0:02:54.40,Main-207-,,0,0,0,,Hey, uyan Merry!Dialogue: 50,0:02:55.91,0:02:57.66,Main-207-,,0,0,0,,Lütfen ölme!Dialogue: 50,0:02:57.66,0:02:59.41,Main-207-,,0,0,0,,H-Hanımefendi...Dialogue: 50,0:02:59.41,0:03:01.87,Main-207-,,0,0,0,,Tanrı'ya şükür, iyisiniz.Dialogue: 50,0:03:02.33,0:03:03.25,Main-207-,,0,0,0,,Merry...!Dialogue: 50,0:03:07.29,0:03:10.50,Main-207-,,0,0,0,,Merry? B-Bunu sana kim yaptı?!Dialogue: 50,0:03:10.50,0:03:11.88,Main-207-,,0,0,0,,Klahadore!Dialogue: 50,0:03:11.88,0:03:14.80,Main-207-,,0,0,0,,Bunun... sorumlusu o!Dialogue: 50,0:03:16.72,0:03:21.22,Main-207-,,0,0,0,,O... başından beri bir korsandı!Dialogue: 50,0:03:21.97,0:03:24.81,Main-207-,,0,0,0,,S-Sen neden bahsediyorsun?Dialogue: 50,0:03:24.81,0:03:30.94,Main-207-,,0,0,0,,Bu ailenin servetindeydi gözü, bu yüzden size yaklaştı.Dialogue: 50,0:03:44.83,0:03:45.75,Main-207-,,0,0,0,,Öyleyse,Dialogue: 50,0:03:46.41,0:03:49.33,Main-207-,,0,0,0,,dün, Usopp-san'ın söylediği şey...Dialogue: 50,0:03:50.88,0:03:53.84,Main-207-,,0,0,0,,Evet, şimdi düşününce...Dialogue: 50,0:03:54.34,0:03:59.39,Main-207-,,0,0,0,,Gerçeği öğrenip tek başına yardım etmeye çalıştı!Dialogue: 50,0:03:59.39,0:04:05.31,Main-207-,,0,0,0,,Ama söylediklerinin hiçbirine inanmadık!Dialogue: 50,0:04:06.64,0:04:08.44,Flashbacks-207-,,0,0,0,,Kaçmalısın, Kaya!Dialogue: 50,0:04:08.44,0:04:09.73,Flashbacks-207-,,0,0,0,,Seni öldürecekler!Dialogue: 50,0:04:11.73,0:04:13.61,Flashbacks-207-,,0,0,0,,Her neyse, şimdilik kaçalım!Dialogue: 50,0:04:16.03,0:04:21.66,Main-207-,,0,0,0,,Asıl kötüyü barındırıp cesur genci ise dışladık!Dialogue: 50,0:04:21.66,0:04:26.50,Main-207-,,0,0,0,,Köyü kurtarmak için kendini ateşe attı,Dialogue: 50,0:04:27.46,0:04:29.62,Main-207-,,0,0,0,,biz de kalkıp onu kovduk!Dialogue: 50,0:04:32.21,0:04:35.51,Main-207-,,0,0,0,,B-Biri yardım etsin! Merry yara...!Dialogue: 50,0:04:34.13,0:04:35.51,Secondary-207-,,0,0,0,,Hanımefendi!Dialogue: 50,0:04:35.51,0:04:36.71,Main-207-,,0,0,0,,Faydası yok...Dialogue: 50,0:04:38.67,0:04:43.18,Main-207-,,0,0,0,,Dün itibariyle herkes tatile çıktı.Dialogue: 50,0:04:43.81,0:04:45.47,Main-207-,,0,0,0,,Olamaz...Dialogue: 50,0:04:45.47,0:04:46.72,Main-207-,,0,0,0,,Öyleyse ben...Dialogue: 50,0:04:46.72,0:04:48.81,Main-207-,,0,0,0,,Sakin olmalısınız!Dialogue: 50,0:04:49.52,0:04:52.15,Main-207-,,0,0,0,,Henüz planlarını uygulamadılar!Dialogue: 50,0:04:52.15,0:04:56.48,Main-207-,,0,0,0,,Her şeyi dikkatlice düşünmelisiniz!Dialogue: 50,0:04:58.78,0:05:03.12,Main-207-,,0,0,0,,Klahadore, bu malikaneyi ve tüm servetinizi istiyorsa...Dialogue: 50,0:05:03.12,0:05:05.99,Main-207-,,0,0,0,,istediğini verin gitsin!Dialogue: 50,0:05:05.99,0:05:09.37,Main-207-,,0,0,0,,Hiçbiri hayatınızı riske atmaya değmez!Dialogue: 50,0:05:11.96,0:05:12.96,Main-207-,,0,0,0,,Haklısın.Dialogue: 50,0:05:13.33,0:05:14.75,Main-207-,,0,0,0,,Acımasızca olsa bile...Dialogue: 50,0:05:14.75,0:05:18.71,Main-207-,,0,0,0,,Klahadore'u durdurabilecek tek kişi sizsiniz.Dialogue: 50,0:05:20.22,0:05:21.80,Main-207-,,0,0,0,,Yapabilir misiniz?Dialogue: 50,0:05:21.80,0:05:25.35,Main-207-,,0,0,0,,Sizin sorumluluğunuz olmasa bile...Dialogue: 50,0:05:26.18,0:05:31.14,Main-207-,,0,0,0,,Bunun, kaçarak çözülecek bir sorun olmadığının farkındayım...Dialogue: 50,0:05:32.02,0:05:33.77,Main-207-,,0,0,0,,Tamamen anlıyorum!Dialogue: 50,0:05:35.11,0:05:38.53,Main-207-,,0,0,0,,Klahadore ile konuşacağım!Dialogue: 50,0:05:41.78,0:05:45.20,Main-207-,,0,0,0,,Ne?! Uşak Klahadore kıyıya mı gitti?!Dialogue: 50,0:05:45.20,0:05:48.29,Main-207-,,0,0,0,,Evet! Çok korkunç görünüyordu!Dialogue: 50,0:05:50.08,0:05:51.62,Main-207-,,0,0,0,,Hey, uyuma!Dialogue: 50,0:05:53.00,0:05:55.71,Main-207-,,0,0,0,,Ama hâlâ uyku vakti...Dialogue: 50,0:05:55.71,0:05:58.09,Main-207-,,0,0,0,,Uyuyacak zaman değil!Dialogue: 50,0:05:58.09,0:06:00.05,Main-207-,,0,0,0,,Başımız belada olabilir!Dialogue: 50,0:06:00.05,0:06:01.42,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:06:03.05,0:06:05.68,Main-207-,,0,0,0,,Sanırım korsanlar gerçekten bize saldıracak.Dialogue: 50,0:06:06.43,0:06:10.14,Main-207-,,0,0,0,,Kaptanımız “yalan söyledim” dedi ama bence o da yalandı.Dialogue: 50,0:06:10.64,0:06:11.77,Main-207-,,0,0,0,,Bence de!Dialogue: 50,0:06:12.77,0:06:16.73,Main-207-,,0,0,0,,Aynı düşünüyorum! Dün kaptanda bir tuhaflık vardı.Dialogue: 50,0:06:16.73,0:06:18.44,Main-207-,,0,0,0,,Oh, Kaya-san!Dialogue: 50,0:06:18.44,0:06:19.94,Main-207-,,0,0,0,,İyimiş!Dialogue: 50,0:06:30.41,0:06:33.33,Main-207-,,0,0,0,,Canı sıkkın gibi.Dialogue: 50,0:06:33.33,0:06:36.33,Main-207-,,0,0,0,,Kaya-san evden yalnız başına çıkıyor...Dialogue: 50,0:06:36.33,0:06:37.88,Main-207-,,0,0,0,,Bir şeyler dönüyor!Dialogue: 50,0:06:37.88,0:06:40.46,Main-207-,,0,0,0,,Bir şey olmuş olmalı!Dialogue: 50,0:06:44.01,0:06:46.47,Main-207-,,0,0,0,,Öne çıkın, Miyavban Kardeşler!Dialogue: 50,0:06:50.68,0:06:53.14,Main-207-,,0,0,13,,Siz mi çağırdınız, Kaptan Jango?Dialogue: 50,0:06:55.02,0:06:56.44,Main-207-,,0,0,13,,Siz mi çağırdınız?Dialogue: 50,0:06:56.44,0:06:57.94,Main-207-,,0,0,0,,Sham...Dialogue: 50,0:06:57.94,0:06:58.86,Main-207-,,0,0,0,,...ve Buchi!Dialogue: 50,0:06:58.86,0:07:02.82,Main-207-,,0,0,0,,– Birlikte, Miyavban Kardeşleriz! – Birlikte, Miyavban Kardeşleriz!Dialogue: 50,0:07:06.16,0:07:07.66,Main-207-,,0,0,0,,Buchi! Sham!Dialogue: 50,0:07:07.66,0:07:12.16,Main-207-,,0,0,0,,Bu yokuşu geçmemiz şart,Dialogue: 50,0:07:12.16,0:07:14.04,Main-207-,,0,0,0,,ama biri bize engel oluyor.Dialogue: 50,0:07:14.50,0:07:15.67,Main-207-,,0,0,0,,Kurtulun ondan.Dialogue: 50,0:07:16.46,0:07:19.59,Main-207-,,0,0,0,,B-Bu bizim için imkânsız!Dialogue: 50,0:07:19.59,0:07:21.21,Main-207-,,0,0,0,,Değil mi, Buchi?Dialogue: 50,0:07:21.21,0:07:23.92,Main-207-,,0,0,0,,Evet, çok güçlü görünüyor.Dialogue: 50,0:07:24.26,0:07:25.34,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:07:25.80,0:07:29.10,Main-207-,,0,0,0,,Dahası, bizim görevimiz gemiye göz kulak olmak.Dialogue: 50,0:07:29.10,0:07:32.93,Main-207-,,0,0,0,,Ah evet, haklısın. Biz dövüşten sorumlu değiliz.Dialogue: 50,0:07:32.93,0:07:37.35,Main-207-,,0,0,0,,Ne? Bu adamların onların kozu olması gerekmiyor muydu?Dialogue: 50,0:07:37.35,0:07:39.81,Main-207-,,0,0,0,,Sham! Yapın şunu!Dialogue: 50,0:07:39.81,0:07:41.69,Main-207-,,0,0,0,,Ne?! B-Ben mi?!Dialogue: 50,0:07:41.69,0:07:42.69,Main-207-,,0,0,0,,Hemen!Dialogue: 50,0:07:42.69,0:07:45.15,Main-207-,,0,0,0,,T-Tamam, yapacağım!Dialogue: 50,0:07:45.53,0:07:47.41,Main-207-,,0,0,0,,Ağlıyor!Dialogue: 50,0:07:47.41,0:07:49.16,Main-207-,,0,0,0,,Neyin peşindeler?Dialogue: 50,0:07:50.41,0:07:52.41,Main-207-,,0,0,0,,Niye o zavallıyı dövüştürüyor ki?Dialogue: 50,0:07:52.41,0:07:53.74,Main-207-,,0,0,0,,Hey, sen!Dialogue: 50,0:07:53.74,0:07:54.91,Main-207-,,0,0,0,,Hazır ol!Dialogue: 50,0:07:54.91,0:07:57.92,Main-207-,,0,0,0,,Çünkü seni bu pençelerle parçalayacağım!Dialogue: 50,0:08:00.21,0:08:02.21,Main-207-,,0,0,0,,Bu herifle ne yapmam gerekiyor?Dialogue: 50,0:08:02.67,0:08:05.01,Main-207-,,0,0,0,,Lan! Durmazsan seni ikiye bölerim!Dialogue: 50,0:08:07.09,0:08:08.22,Main-207-,,0,0,0,,Tabii yapabilirsen!Dialogue: 50,0:08:08.22,0:08:09.22,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:08:13.35,0:08:14.18,Thoughts-207-,,0,0,0,,Ne oluyor lan?!Dialogue: 50,0:08:14.18,0:08:15.22,Main-207-,,0,0,0,,Sen!Dialogue: 50,0:08:16.02,0:08:18.27,Main-207-,,0,0,0,,Beni fazlasıyla hafife aldın, değil mi?!Dialogue: 50,0:08:18.27,0:08:23.02,Main-207-,,0,0,0,,"Zavallı kedi" numaramdan sonra hâlâ savunma yapabilmen etkileyici!Dialogue: 50,0:08:23.86,0:08:25.53,Main-207-,,0,0,0,,Biraz yetenekli olabilirsin,Dialogue: 50,0:08:25.53,0:08:29.57,Main-207-,,0,0,0,,ama Miyavban Kardeşlerden Sham'ı hafife almasan iyi olur.Dialogue: 50,0:08:33.74,0:08:37.96,Main-207-,,0,0,0,,Bir şey mi kaybettin? Bana hiç bakma!Dialogue: 50,0:08:38.66,0:08:39.67,Main-207-,,0,0,0,,İşte bu...Dialogue: 50,0:08:39.67,0:08:41.13,Main-207-,,0,0,0,,"Kedi Kapışı"...Dialogue: 50,0:08:41.54,0:08:43.63,Main-207-,,0,0,0,,O kılıçları geri ver!Dialogue: 50,0:08:43.63,0:08:48.05,Main-207-,,0,0,0,,Geri ver mi? Zaten bir kılıcın var.Dialogue: 50,0:08:51.09,0:08:53.22,Main-207-,,0,0,0,,Bunlar beni yavaşlatır.Dialogue: 50,0:09:00.02,0:09:01.31,Main-207-,,0,0,0,,Harika!Dialogue: 50,0:09:01.31,0:09:03.40,Main-207-,,0,0,0,,Yüküm hafifledi.Dialogue: 50,0:09:03.40,0:09:07.07,Main-207-,,0,0,0,,Başkalarının eşyalarına biraz saygı göster!Dialogue: 50,0:09:11.16,0:09:12.91,Main-207-,,0,0,0,,Piç herif!Dialogue: 50,0:09:15.03,0:09:15.70,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:09:16.91,0:09:18.70,Main-207-,,0,0,0,,Ne kestiğini sandın ki?!Dialogue: 50,0:09:18.70,0:09:20.71,Main-207-,,0,0,0,,Sonuçta bir kedi gibi çeviğim!Dialogue: 50,0:09:23.46,0:09:25.17,Main-207-,,0,0,0,,Sahne senin, Buchi!Dialogue: 50,0:09:25.17,0:09:26.09,Main-207-,,0,0,0,,Hakla onu!Dialogue: 50,0:09:26.09,0:09:27.96,Main-207-,,0,0,0,,Tamamdır, Sham!Dialogue: 50,0:09:28.67,0:09:30.97,Main-207-,,0,0,0,,Kedi...Dialogue: 50,0:09:33.64,0:09:35.47,Main-207-,,0,0,0,,Vuruşu!Dialogue: 50,0:09:37.64,0:09:39.27,Main-207-,,0,0,0,,Kahretsin!Dialogue: 50,0:09:39.27,0:09:40.60,Main-207-,,0,0,0,,Kaçtı.Dialogue: 50,0:09:40.60,0:09:43.35,Main-207-,,0,0,0,,Hey, onu doğru düzgün tut, Sham!Dialogue: 50,0:09:43.35,0:09:44.73,Main-207-,,0,0,0,,Benim hatam!Dialogue: 50,0:09:44.73,0:09:47.78,Main-207-,,0,0,0,,Onun bu kadar güçlü olmasını beklemiyordum.Dialogue: 50,0:09:48.53,0:09:50.28,Thoughts-207-,,0,0,0,,Ne oluyor lan?!Dialogue: 50,0:09:50.28,0:09:55.20,Thoughts-207-,,0,0,0,,Eğer bana vursaydı, tüm kemiklerim paramparça olurdu!Dialogue: 50,0:09:55.57,0:09:57.16,Main-207-,,0,0,0,,Bu kez kaçamayacak!Dialogue: 50,0:09:57.16,0:09:58.37,Main-207-,,0,0,0,,Elbette!Dialogue: 50,0:09:58.87,0:10:02.00,Main-207-,,0,0,0,,Tek kılıç tekniklerine pek aşina değilim, ama...Dialogue: 50,0:10:03.04,0:10:05.00,Main-207-,,0,0,0,,Gidelim, Buchi!Dialogue: 50,0:10:05.42,0:10:07.21,Main-207-,,0,0,0,,Evet! Yapalım, Sham!Dialogue: 50,0:10:07.21,0:10:10.92,Main-207-,,0,0,0,,– Söğüt Kedilerinin Yürüyüşü! – Söğüt Kedilerinin Yürüyüşü!Dialogue: 50,0:10:18.35,0:10:20.81,Main-207-,,0,0,0,,Durum fena! Zoro’yu savunmaya zorladılar!Dialogue: 50,0:10:24.06,0:10:25.56,Main-207-,,0,0,0,,Ne yapıyorsun?!Dialogue: 50,0:10:25.56,0:10:29.32,Main-207-,,0,0,0,,Sadece savunma yaparak bir yere varamaz!Dialogue: 50,0:10:29.32,0:10:30.90,Main-207-,,0,0,0,,Ona yardım edeceğim!Dialogue: 50,0:10:30.90,0:10:32.53,Main-207-,,0,0,0,,Alın bakalım!Dialogue: 50,0:10:32.53,0:10:33.74,Main-207-,,0,0,0,,Kurşun Yıldızı!Dialogue: 50,0:10:39.95,0:10:41.12,Main-207-,,0,0,0,,Açıkta!Dialogue: 50,0:10:47.13,0:10:50.13,Main-207-,,0,0,0,,Neden bizden birini vuruyorsun?!Dialogue: 50,0:10:50.88,0:10:52.34,Main-207-,,0,0,0,,Hayır, öyle değil.Dialogue: 50,0:10:52.34,0:10:55.89,Main-207-,,0,0,0,,Vurulmak için öne atılan oydu.Dialogue: 50,0:10:55.89,0:10:57.76,Main-207-,,0,0,0,,Ha?! Kendi mi yaptı?!Dialogue: 50,0:10:59.81,0:11:01.81,Main-207-,,0,0,0,,Usopp, seni aptal!Dialogue: 50,0:11:01.81,0:11:03.02,Main-207-,,0,0,0,,Ölmek mi istiyorsun?!Dialogue: 50,0:11:07.52,0:11:09.23,Main-207-,,0,0,0,,Yoksa...Dialogue: 50,0:11:09.73,0:11:12.23,Main-207-,,0,0,0,,burada kurtarılan biz miydik?Dialogue: 50,0:11:12.23,0:11:16.24,Main-207-,,0,0,0,,Eğer onları o atışla vurmuş olsaydın...Dialogue: 50,0:11:16.24,0:11:19.37,Main-207-,,0,0,0,,muhtemelen bizim peşimize düşerlerdi!Dialogue: 50,0:11:20.03,0:11:21.24,Main-207-,,0,0,0,,O adam...Dialogue: 50,0:11:21.79,0:11:24.00,Main-207-,,0,0,0,,Bizim için endişelenecek zaman değil!Dialogue: 50,0:11:27.25,0:11:28.54,Thoughts-207-,,0,0,0,,Kahretsin!Dialogue: 50,0:11:28.54,0:11:31.88,Thoughts-207-,,0,0,0,,Sadece bir kılıcım daha olsaydı...!Dialogue: 50,0:11:34.13,0:11:35.93,Main-207-,,0,0,0,,Gidip kılıçlarını alacağım!Dialogue: 50,0:11:35.93,0:11:38.01,Main-207-,,0,0,0,,Kılıçlarını geri alırsa, onları yenebilir!Dialogue: 50,0:11:38.01,0:11:39.47,Main-207-,,0,0,0,,Öyleyse, ben yaparım!Dialogue: 50,0:11:40.35,0:11:41.85,Main-207-,,0,0,0,,Kendini zorlama!Dialogue: 50,0:11:41.85,0:11:43.68,Main-207-,,0,0,0,,Ayakta bile duramıyorsun!Dialogue: 50,0:11:45.43,0:11:46.39,Main-207-,,0,0,0,,Hey! Nami!Dialogue: 50,0:12:06.58,0:12:07.62,Main-207-,,0,0,0,,Nami!Dialogue: 50,0:12:07.96,0:12:10.25,Main-207-,,0,0,0,,Bu kılıçlarla ne yapmak istiyorsun?Dialogue: 50,0:12:25.22,0:12:29.48,Main-207-,,0,0,0,,Şey! Açıklayabilirim!Dialogue: 50,0:12:33.40,0:12:37.49,Main-207-,,0,0,0,,Şafak sökeli epey oldu...Dialogue: 50,0:12:37.49,0:12:41.87,Main-207-,,0,0,0,,Bu yüzden planın ilerlemediğini görmek tuhaf.Dialogue: 50,0:12:42.41,0:12:44.74,Main-207-,,0,0,0,,K-Kaptan Kuro!Dialogue: 50,0:12:44.74,0:12:46.37,Main-207-,,0,0,0,,Ö-Öldük biz!Dialogue: 50,0:12:52.84,0:12:54.30,Main-207-,,0,0,0,,Beterin beteri!Dialogue: 50,0:13:08.14,0:13:11.77,Main-207-,,0,0,0,,Neler oluyor lan?!Dialogue: 50,0:13:16.48,0:13:20.32,Main-207-,,0,0,0,,Bu veletlere takılıp kalacağınızı hiç düşünmemiştim.Dialogue: 50,0:13:20.95,0:13:23.91,Main-207-,,0,0,0,,Kara Kedi Korsanları ne hâle gelmiş...Dialogue: 50,0:13:24.74,0:13:25.99,Main-207-,,0,0,0,,Ha...?Dialogue: 50,0:13:26.87,0:13:28.45,Main-207-,,0,0,0,,Jango?!Dialogue: 50,0:13:32.75,0:13:35.88,Main-207-,,0,0,0,,A-A-Ama...Dialogue: 50,0:13:36.96,0:13:41.47,Main-207-,,0,0,0,,O çocuğu salmanın sorun olmayacağını söylemiştiniz!Dialogue: 50,0:13:44.55,0:13:46.39,Main-207-,,0,0,0,,Evet, söylemiştim.Dialogue: 50,0:13:46.39,0:13:47.47,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:13:47.85,0:13:50.06,Main-207-,,0,0,0,,Ne olmuş?Dialogue: 50,0:13:50.06,0:13:54.98,Main-207-,,0,0,0,,Gelip bizi durdurmaya çalışacaklarını biliyordum.Dialogue: 50,0:13:54.98,0:13:57.73,Main-207-,,0,0,0,,Ama beklemediğim şey,Dialogue: 50,0:13:57.73,0:14:00.86,Main-207-,,0,0,0,,siz ahmakların bu kadar işe yaramaz olması!Dialogue: 50,0:14:00.86,0:14:03.74,Main-207-,,0,0,0,,İşe... yaramaz mıydık?Dialogue: 50,0:14:03.74,0:14:05.99,Main-207-,,0,0,0,,K-Kimmiş işe yaramayan?Dialogue: 50,0:14:05.99,0:14:07.66,Main-207-,,0,0,0,,Diline dikkat et, Kaptan Kuro!Dialogue: 50,0:14:10.45,0:14:12.71,Main-207-,,0,0,0,,Evet, bir zamanlar güçlüydün,Dialogue: 50,0:14:13.21,0:14:15.46,Main-207-,,0,0,0,,ama bu üç yıl önceydi!Dialogue: 50,0:14:15.46,0:14:20.38,Main-207-,,0,0,0,,Sen bu köyde dalganı geçerken, biz boş durmuyorduk!Dialogue: 50,0:14:20.38,0:14:21.84,Main-207-,,0,0,0,,Aynen öyle!Dialogue: 50,0:14:21.84,0:14:26.30,Main-207-,,0,0,0,,Sayısız köyü yağmaladık ve sayısız korsan çetesini yendik.Dialogue: 50,0:14:28.26,0:14:30.06,Main-207-,,0,0,0,,Sadede gelin...Dialogue: 50,0:14:30.97,0:14:33.98,Main-207-,,0,0,0,,Üç yıl boyunca hiçbir şey yapmadın!Dialogue: 50,0:14:33.98,0:14:37.36,Main-207-,,0,0,0,,Miyavban Kardeşleri yenmen artık mümkün değil!Dialogue: 50,0:14:41.44,0:14:44.41,Main-207-,,0,0,0,,Buchi, Sham, durun!Dialogue: 50,0:14:50.24,0:14:52.75,Main-207-,,0,0,0,,Sen artık kaptanımız değilsin!Dialogue: 50,0:14:52.75,0:14:55.67,Main-207-,,0,0,0,,Affedersin ama ölme vaktin geldi!Dialogue: 50,0:15:08.18,0:15:10.60,Main-207-,,0,0,0,,N-Ne zaman arkalarına geçti?!Dialogue: 50,0:15:11.18,0:15:12.81,Main-207-,,0,0,0,,Üstelik o silahlar...Dialogue: 50,0:15:14.73,0:15:16.98,Main-207-,,0,0,0,,Kimi öldüreceksiniz?Dialogue: 50,0:15:18.23,0:15:20.19,Main-207-,,0,0,0,,– Arkamıza... – ...sıvışmış!Dialogue: 50,0:15:24.28,0:15:26.32,Main-207-,,0,0,0,,Ha?! Gitmiş!Dialogue: 50,0:15:31.03,0:15:33.37,Main-207-,,0,0,0,,İşte! "Kedi Yürüyüşü"...Dialogue: 50,0:15:38.21,0:15:40.29,Main-207-,,0,0,0,,Haklıydınız.Dialogue: 50,0:15:45.01,0:15:48.47,Main-207-,,0,0,0,,Sanırım biraz yavaşladım.Dialogue: 50,0:15:49.30,0:15:54.48,Thoughts-207-,,0,0,0,,Zoro tek kılıçla zorlanırken, o adam onlarla kedi gibi oynuyor!Dialogue: 50,0:15:55.73,0:16:00.06,Thoughts-207-,,0,0,0,,"Kedi Yürüyüşü" ona sessizce hareket etme yeteneği veriyor.Dialogue: 50,0:16:00.81,0:16:05.69,Thoughts-207-,,0,0,0,,50 suikastçin olsa bile, kimse bir şey farketmeden hepsini öldürebilir.Dialogue: 50,0:16:06.90,0:16:10.91,Thoughts-207-,,0,0,0,,Onun planlarından kaçmamız mümkün değil.Dialogue: 50,0:16:11.78,0:16:17.62,Thoughts-207-,,0,0,0,,Üç yıl sonra, o alışkanlığını tekrar gördüğümde tüylerim ürperdi.Dialogue: 50,0:16:18.25,0:16:24.21,Thoughts-207-,,0,0,0,,Kedi pençeleriyle yüzünü çizmemek için, gözlüklerini o şekilde düzeltmesi...Dialogue: 50,0:16:24.21,0:16:27.01,Thoughts-207-,,0,0,0,,nasıl dövüşeceğini unutmadığını kanıtlar!Dialogue: 50,0:16:35.31,0:16:38.48,Main-207-,,0,0,0,,Bu adada üç yıl geçirdikten sonra,Dialogue: 50,0:16:38.98,0:16:42.56,Main-207-,,0,0,0,,sanırım ben de biraz yumuşamışım...Dialogue: 50,0:16:44.48,0:16:46.57,Main-207-,,0,0,0,,Size beş dakika vereceğim.Dialogue: 50,0:16:48.70,0:16:52.49,Main-207-,,0,0,0,,Beş dakika içinde işlerini bitirmezseniz...Dialogue: 50,0:16:54.49,0:16:57.25,Main-207-,,0,0,0,,her birinizi tek tek...Dialogue: 50,0:16:58.00,0:17:00.67,Main-207-,,0,0,0,,kendi ellerimle öldüreceğim!Dialogue: 50,0:17:09.84,0:17:10.72,Main-207-,,0,0,0,,Beş dakika...Dialogue: 50,0:17:11.47,0:17:13.05,Main-207-,,0,0,0,,Beş dakika fazla bile!Dialogue: 50,0:17:14.01,0:17:15.72,Main-207-,,0,0,0,,O-O işte!Dialogue: 50,0:17:15.72,0:17:20.81,Main-207-,,0,0,0,,Onu yenersek, bu yokuşu geçebileceğiz!Dialogue: 50,0:17:28.90,0:17:31.32,Main-207-,,0,0,0,,Az önce ona karşı üstünlük sağladık!Dialogue: 50,0:17:31.32,0:17:33.45,Main-207-,,0,0,0,,Beş dakika içinde onu paramparça edeceğiz!Dialogue: 50,0:17:33.95,0:17:37.66,Main-207-,,0,0,0,,Size güveniyorum, Miyavban Kardeşler!Dialogue: 50,0:17:40.58,0:17:41.46,Main-207-,,0,0,0,,Zoro!Dialogue: 50,0:17:45.92,0:17:46.88,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:17:46.88,0:17:48.34,Main-207-,,0,0,0,,H-Hey!Dialogue: 50,0:17:48.34,0:17:50.88,Main-207-,,0,0,0,,Şimdi de kılıçlarımı mı tekmeliyorsun?!Dialogue: 50,0:17:51.84,0:17:53.30,Main-207-,,0,0,0,,Hani "teşekkür"?Dialogue: 50,0:17:54.55,0:17:55.39,Main-207-,,0,0,0,,Evet...Dialogue: 50,0:17:56.89,0:17:58.52,Main-207-,,0,0,0,,Teşekkür ederim!Dialogue: 50,0:18:01.02,0:18:02.27,Main-207-,,0,0,0,,Faydasız!Dialogue: 50,0:18:02.27,0:18:03.77,Main-207-,,0,0,0,,Üç tane kılıcın olsa bile...Dialogue: 50,0:18:03.77,0:18:05.56,Main-207-,,0,0,0,,sonuç değişmeyecek!Dialogue: 50,0:18:07.61,0:18:08.32,Main-207-,,0,0,0,,Kaplan...Dialogue: 50,0:18:11.86,0:18:13.78,Main-207-,,0,0,0,,Anlamıyorsunuz, değil mi?Dialogue: 50,0:18:14.53,0:18:16.07,Main-207-,,0,0,0,,...Avı!Dialogue: 50,0:18:20.83,0:18:23.42,Main-207-,,0,0,0,,Dört dakika kaldı.Dialogue: 50,0:18:26.42,0:18:30.21,Main-207-,,0,0,0,,Üç kılıç kullanmak ve üç kılıç tekniği...Dialogue: 50,0:18:30.21,0:18:32.22,Main-207-,,0,0,0,,tamamen farklı şeylerdir!Dialogue: 50,0:18:37.93,0:18:38.81,Main-207-,,0,0,0,,İ...Dialogue: 50,0:18:42.06,0:18:43.52,Main-207-,,0,0,0,,İnanılmaz...Dialogue: 50,0:18:47.81,0:18:49.40,Main-207-,,0,0,0,,Tek vuruşla...Dialogue: 50,0:18:58.16,0:19:01.54,Main-207-,,0,0,0,,M-Miyavban Kardeşleri tek vuruşta yendi!Dialogue: 50,0:19:12.71,0:19:14.26,Main-207-,,0,0,0,,Endişelenme!Dialogue: 50,0:19:15.18,0:19:21.77,Main-207-,,0,0,0,,Beş dakikanız dolmadan her birinizi halledeceğim!Dialogue: 50,0:19:36.07,0:19:38.82,Main-207-,,0,0,0,,Üç dakika kaldı.Dialogue: 50,0:19:42.62,0:19:46.50,Main-207-,,0,0,0,,O pisliği... öldüreceğim...Dialogue: 50,0:19:49.79,0:19:51.92,Main-207-,,0,0,0,,K-Kaptan...Dialogue: 50,0:19:51.92,0:19:55.09,Main-207-,,0,0,0,,B-Beni hipnotize et....Dialogue: 50,0:19:57.09,0:19:59.55,Main-207-,,0,0,0,,L-Lütfen, Kaptan!Dialogue: 50,0:20:00.10,0:20:01.68,Main-207-,,0,0,0,,Hâlâ yaşıyor.Dialogue: 50,0:20:01.68,0:20:03.27,Main-207-,,0,0,0,,Özensiz iş yapıyorsun.Dialogue: 50,0:20:05.60,0:20:08.56,Main-207-,,0,0,0,,Sanırım fazla yağları onu kurtardı.Dialogue: 50,0:20:30.08,0:20:32.29,Main-207-,,0,0,0,,Hakla onu, Buchi!Dialogue: 50,0:20:36.76,0:20:39.97,Main-207-,,0,0,0,,Yine mi hipnoz?!Dialogue: 50,0:20:43.72,0:20:44.97,Main-207-,,0,0,0,,Tam bir baş belası.Dialogue: 50,0:20:45.47,0:20:48.44,Main-207-,,0,0,0,,Zaten zemini parçalayacak kadar güçlüydü.Dialogue: 50,0:20:51.06,0:20:53.57,Main-207-,,0,0,0,,Süper güçle nasıl bir şey olacak?!Dialogue: 50,0:21:02.70,0:21:04.16,Main-207-,,0,0,0,,İşte fırsat!Dialogue: 50,0:21:04.16,0:21:07.62,Main-207-,,0,0,0,,Hâlâ yapabiliyorken onu uyandırmalıyım!Dialogue: 50,0:21:07.62,0:21:10.25,Main-207-,,0,0,0,,Şimdi ne yapacaksın...?Dialogue: 50,0:21:11.29,0:21:13.00,Main-207-,,0,0,0,,İşgüzar kız...Dialogue: 50,0:21:13.42,0:21:16.63,Main-207-,,0,0,0,,Herkes dövülürken o mışıl mışıl uyuyor!Dialogue: 50,0:21:18.01,0:21:19.34,Main-207-,,0,0,0,,Geber!Dialogue: 50,0:21:23.39,0:21:24.93,Main-207-,,0,0,0,,Uyan!Dialogue: 50,0:21:24.93,0:21:26.81,Main-207-,,0,0,0,,Nami! Dikkat et!Dialogue: 50,0:21:31.27,0:21:32.77,Main-207-,,0,0,0,,Seni ikiye böleceğim!Dialogue: 50,0:21:34.15,0:21:35.40,Main-207-,,0,0,0,,Eğil!Dialogue: 50,0:21:37.07,0:21:39.36,Main-207-,,0,0,0,,N-Ne?!Dialogue: 50,0:21:40.36,0:21:41.78,Thoughts-207-,,0,0,0,,Chakram!Dialogue: 50,0:21:40.36,0:21:41.78,Note-207-,,0,0,0,,Chakram: Yuvarlak ve metal savaş aleti.Dialogue: 50,0:21:41.78,0:21:44.24,Thoughts-207-,,0,0,0,,O sadece hipnoz aleti değil miydi?!Dialogue: 50,0:21:45.45,0:21:50.29,Main-207-,,0,0,0,,Nami! Yüzüme basmaya nasıl cüret edersin?!Dialogue: 50,0:21:52.08,0:21:53.63,Main-207-,,0,0,0,,Y-Yaşıyor mu?!Dialogue: 50,0:21:54.79,0:21:59.05,Main-207-,,0,0,0,,Zamanlaması iyi mi kötü mü bilemiyorum.Dialogue: 50,0:22:02.93,0:22:04.09,Main-207-,,0,0,0,,L-Luffy...Dialogue: 50,0:22:09.52,0:22:11.06,Main-207-,,0,0,0,,Luffy!Dialogue: 50,0:22:11.06,0:22:13.98,Main-207-,,0,0,0,,Ah...Dialogue: 50,0:22:14.35,0:22:16.73,Main-207-,,0,0,0,,Ahh!Dialogue: 50,0:22:17.15,0:22:19.61,Main-207-,,0,0,0,,Hayata döndü!Dialogue: 50,0:22:19.61,0:22:21.44,Main-207-,,0,0,0,,Durum kötü!Dialogue: 50,0:22:21.44,0:22:24.11,Main-207-,,0,0,0,,Beş dakika yetmez artık!Dialogue: 50,0:22:25.03,0:22:28.20,Main-207-,,0,0,0,,Nami! Bu çok acıttı, seni pislik!Dialogue: 50,0:22:28.20,0:22:30.16,Main-207-,,0,0,0,,Ben yapmadım!Dialogue: 50,0:22:30.16,0:22:31.71,Main-207-,,0,0,0,,O...Dialogue: 50,0:22:35.17,0:22:36.50,Main-207-,,0,0,0,,N-Nami?Dialogue: 50,0:22:36.50,0:22:38.92,Main-207-,,0,0,0,,Omzun mu yaralandı?Dialogue: 50,0:22:39.96,0:22:42.38,Main-207-,,0,0,0,,Ö-Önemli değil. İyiyim...Dialogue: 50,0:22:42.38,0:22:45.84,Main-207-,,0,0,0,,Her neyse, elimden geleni yaptım.Dialogue: 50,0:22:45.84,0:22:48.14,Main-207-,,0,0,0,,Gerisini sana bırakıyorum.Dialogue: 50,0:22:49.18,0:22:53.27,Main-207-,,0,0,0,,Bu savaşı kesinlikle kaybedemeyiz!Dialogue: 50,0:22:53.27,0:22:54.06,Main-207-,,0,0,0,,Evet!Dialogue: 50,0:22:55.35,0:22:58.73,Main-207-,,0,0,0,,Hazinem için elinden geleni yap!Dialogue: 50,0:22:58.73,0:23:01.94,Main-207-,,0,0,0,,Peki! Senin tarzın bu!Dialogue: 50,0:23:03.15,0:23:05.49,Main-207-,,0,0,0,,Bir dakika kaldı.Dialogue: 50,0:23:07.82,0:23:09.62,Main-207-,,0,0,0,,Bu imkânsız!Dialogue: 50,0:23:09.62,0:23:12.04,Main-207-,,0,0,0,,Kaptan Jango ve Buchi-san bile...Dialogue: 50,0:23:12.37,0:23:15.87,Main-207-,,0,0,0,,...onları bir dakikada yenemez!Dialogue: 50,0:23:26.22,0:23:29.05,Main-207-,,0,0,0,,Buchi! Aylaklık edecek zaman değil!Dialogue: 50,0:23:29.80,0:23:32.02,Main-207-,,0,0,0,,Sen o kuşaklı herifle ilgilen,Dialogue: 50,0:23:32.02,0:23:36.23,Main-207-,,0,0,0,,ben de bu tuhaf çocukla ilgileneceğim.Dialogue: 50,0:23:42.78,0:23:44.57,Main-207-,,0,0,0,,Hasır Şapka'yı bana bırak!Dialogue: 50,0:23:47.16,0:23:50.08,Main-207-,,0,0,0,,Ne? O kötü uşak da burada.Dialogue: 50,0:23:51.03,0:23:52.74,Main-207-,,0,0,0,,O...Dialogue: 50,0:23:52.74,0:23:55.46,Main-207-,,0,0,0,,Uçurumdan düşüp ölmemiş miydi?Dialogue: 50,0:23:57.21,0:23:58.50,Main-207-,,0,0,0,,Neyse.Dialogue: 50,0:24:10.97,0:24:12.56,Main-207-,,0,0,0,,Sakın bana...Dialogue: 50,0:24:16.02,0:24:18.14,Main-207-,,0,0,0,,arkamdan yaklaşma!Dialogue: 50,0:24:18.98,0:24:20.94,Main-207-,,0,0,0,,Kaya!Dialogue: 50,0:24:36.75,0:24:38.67,Main-207-,,0,0,0,,Usopp-san! İyi misin?!Dialogue: 50,0:24:38.67,0:24:40.00,Main-207-,,0,0,0,,K-Kaya...Dialogue: 50,0:24:40.00,0:24:41.67,Main-207-,,0,0,0,,Burada ne arıyorsun?!Dialogue: 50,0:24:42.38,0:24:44.63,Main-207-,,0,0,0,,Üzgünüm, Usopp-san...Dialogue: 50,0:24:44.63,0:24:47.47,Main-207-,,0,0,0,,Özrümü kabul etmezsen anlarım,Dialogue: 50,0:24:47.47,0:24:52.76,Main-207-,,0,0,0,,ama K-Klahadore'un bir korsan olduğuna inanamadım...Dialogue: 50,0:24:52.76,0:24:54.72,Main-207-,,0,0,0,,Boş ver gitsin!Dialogue: 50,0:24:54.72,0:24:56.18,Main-207-,,0,0,0,,Niye buradasın?!Dialogue: 50,0:24:56.18,0:24:58.23,Main-207-,,0,0,0,,Sana kaçmanı söylemiştim!Dialogue: 50,0:24:58.23,0:25:00.44,Main-207-,,0,0,0,,Hayatın tehlikede!Dialogue: 50,0:25:00.44,0:25:04.27,Main-207-,,0,0,0,,Ama... sen dövüşüyorsun!Dialogue: 50,0:25:05.78,0:25:09.57,Main-207-,,0,0,0,,Seni hem kırdım hem üzdüm ama...Dialogue: 50,0:25:09.57,0:25:12.78,Main-207-,,0,0,0,,sen hâlâ beni koruyorsun!Dialogue: 50,0:25:12.78,0:25:13.58,Main-207-,,0,0,0,,Bu yüzden..Dialogue: 50,0:25:13.58,0:25:15.16,Main-207-,,0,0,0,,Kaya hanımefendi...Dialogue: 50,0:25:16.24,0:25:18.71,Main-207-,,0,0,0,,Niye buradasınız?Dialogue: 50,0:25:21.37,0:25:24.13,Main-207-,,0,0,0,,K-Kes şunu...Dialogue: 50,0:25:27.30,0:25:30.80,Main-207-,,0,0,0,,Kes şunu, Klahadore!Dialogue: 50,0:25:37.22,0:25:40.19,Main-207-,,0,0,0,,Merry bana her şeyi anlattı.Dialogue: 50,0:25:43.02,0:25:45.36,Main-207-,,0,0,0,,O kız, malikânenin sahibi değil mi?Dialogue: 50,0:25:45.82,0:25:48.69,Main-207-,,0,0,0,,Yani planımızın son hedefi o mu?Dialogue: 50,0:25:48.69,0:25:51.45,Main-207-,,0,0,0,,Öyleyse, artık köye gitmemize gerek yok mu?Dialogue: 50,0:25:51.45,0:25:53.66,Main-207-,,0,0,0,,Sadece onu öldürmemiz gerekiyor, değil mi?Dialogue: 50,0:25:56.79,0:25:58.54,Main-207-,,0,0,0,,Klahadore, yalvarıyorum!Dialogue: 50,0:25:58.54,0:26:02.00,Main-207-,,0,0,0,,Eğer servetimi istiyorsan, hepsi senindir!Dialogue: 50,0:26:02.00,0:26:03.79,Main-207-,,0,0,0,,Al ve bu köyü terk et!Dialogue: 50,0:26:03.79,0:26:05.42,Main-207-,,0,0,0,,Derhal!Dialogue: 50,0:26:05.42,0:26:09.63,Main-207-,,0,0,0,,Teklifiniz için sağ olun, ancak...Dialogue: 50,0:26:10.13,0:26:14.76,Main-207-,,0,0,0,,Arzu ettiğim bir şey daha var.Dialogue: 50,0:26:16.72,0:26:19.31,Main-207-,,0,0,0,,Arzu ettiğim şey...Dialogue: 50,0:26:20.85,0:26:23.19,Main-207-,,0,0,0,,huzur bulmak.Dialogue: 50,0:26:23.69,0:26:25.40,Main-207-,,0,0,0,,Huzur mu...?Dialogue: 50,0:26:26.15,0:26:29.86,Main-207-,,0,0,0,,Evet. Huzurlu olmak istiyorum.Dialogue: 50,0:26:31.07,0:26:35.07,Main-207-,,0,0,0,,Buradaki köylülerin güvenini kazanmak için üç yılımı harcadım.Dialogue: 50,0:26:35.07,0:26:40.33,Main-207-,,0,0,0,,Gülünç olan şu ki, bu süre zarfında kendimi çok huzurlu hissettim.Dialogue: 50,0:26:40.33,0:26:46.88,Main-207-,,0,0,0,,Böyle bir huzuru her zaman yaşamak istiyorum.Dialogue: 50,0:26:53.88,0:26:55.59,Main-207-,,0,0,0,,Bu yüzden...Dialogue: 50,0:26:56.34,0:26:59.72,Main-207-,,0,0,0,,Bu yüzden huzur istiyorum!Dialogue: 50,0:26:59.72,0:27:02.18,Main-207-,,0,0,0,,Tabii servetinizi de...Dialogue: 50,0:27:02.81,0:27:05.15,Main-207-,,0,0,0,,Kısacası, korsanlar köye saldıracak!Dialogue: 50,0:27:08.27,0:27:09.19,Main-207-,,0,0,0,,Sen de...Dialogue: 50,0:27:09.77,0:27:12.90,Main-207-,,0,0,0,,bir vasiyet bırakıp öleceksin!Dialogue: 50,0:27:13.28,0:27:16.70,Main-207-,,0,0,0,,Bu iki koşul kesinlikle gerekli.Dialogue: 50,0:27:17.28,0:27:19.20,Main-207-,,0,0,0,,H-Hayır, o...Dialogue: 50,0:27:20.20,0:27:22.41,Main-207-,,0,0,0,,K-Klahadore değil...Dialogue: 50,0:27:23.08,0:27:26.92,Main-207-,,0,0,0,,Kaç! Hemen kaç, Kaya! Onunla konuşmanın anlamı yok!Dialogue: 50,0:27:26.92,0:27:28.29,Main-207-,,0,0,0,,Hemen kaç!Dialogue: 50,0:27:28.29,0:27:31.25,Main-207-,,0,0,0,,S-Sen Klahadore değilsin.Dialogue: 50,0:27:31.25,0:27:33.51,Main-207-,,0,0,0,,Olamazsın!Dialogue: 50,0:27:34.72,0:27:36.22,Main-207-,,0,0,0,,Kaya...Dialogue: 50,0:27:36.63,0:27:38.05,Main-207-,,0,0,0,,Bu köyü terket!Dialogue: 50,0:27:38.05,0:27:39.47,Main-207-,,0,0,0,,Hemen!Dialogue: 50,0:27:39.80,0:27:41.43,Main-207-,,0,0,0,,Anlıyorum.Dialogue: 50,0:27:41.43,0:27:45.39,Main-207-,,0,0,0,,Üç yılda çok büyüdünüz,Dialogue: 50,0:27:46.27,0:27:48.23,Main-207-,,0,0,0,,Kaya hanımefendi.Dialogue: 50,0:27:49.40,0:27:51.73,Main-207-,,0,0,0,,Hatırlar mısınız?Dialogue: 50,0:27:51.73,0:27:54.82,Main-207-,,0,0,0,,Üç yıl içinde o kadar çok şey oldu ki.Dialogue: 50,0:27:55.86,0:28:00.07,Main-207-,,0,0,0,,Aileni kaybedip hastalanmadan önce bile...Dialogue: 50,0:28:00.07,0:28:03.95,Main-207-,,0,0,0,,beraber çok vakit geçirdik.Dialogue: 50,0:28:05.04,0:28:06.54,Main-207-,,0,0,0,,Çok uzun zaman...Dialogue: 50,0:28:10.25,0:28:11.67,Main-207-,,0,0,0,,Bir sürü anı...Dialogue: 50,0:28:11.67,0:28:16.30,Main-207-,,0,0,0,,Birlikte acı çektik, birlikte mutlu olduk...Dialogue: 50,0:28:16.80,0:28:19.30,Main-207-,,0,0,0,,K-Klahadore...Dialogue: 50,0:28:20.30,0:28:22.31,Main-207-,,0,0,0,,Şehri birlikte gezerdik...Dialogue: 50,0:28:23.06,0:28:25.81,Main-207-,,0,0,0,,ve ateşiniz çıktığında size hep ben bakardım.Dialogue: 50,0:28:26.81,0:28:30.81,Main-207-,,0,0,0,,Hikayelerimi her zaman gülümseyerek dinlerdiniz.Dialogue: 50,0:28:32.90,0:28:35.99,Main-207-,,0,0,0,,Kendimi size adadım.Dialogue: 50,0:28:37.20,0:28:38.99,Main-207-,,0,0,0,,Uzun süredir...Dialogue: 50,0:28:38.99,0:28:41.20,Main-207-,,0,0,0,,Evet, çok uzun süre...Dialogue: 50,0:28:41.62,0:28:43.87,Main-207-,,0,0,0,,buna katlandım.Dialogue: 50,0:28:45.54,0:28:52.38,Main-207-,,0,0,0,,Evet, sonunda seni öldürebileceğim bu an için her şeye katlandım!Dialogue: 50,0:28:59.38,0:29:03.18,Main-207-,,0,0,0,,Eskiden Kaptan Kuro olarak bilinen ben,Dialogue: 50,0:29:03.51,0:29:07.48,Main-207-,,0,0,0,,kendimi aşağılayıp, sümüklü bir kız için gülümsemek zorunda kaldım!Dialogue: 50,0:29:08.39,0:29:12.61,Main-207-,,0,0,0,,Doğamı bir kenara atıp, kendimi sana sevdirmeye çalıştım!Dialogue: 50,0:29:17.44,0:29:19.03,Main-207-,,0,0,0,,Lanet olsun sana...Dialogue: 50,0:29:19.61,0:29:22.99,Main-207-,,0,0,0,,Günbegün ne kadar aşağılandığımı anlıyor musun?Dialogue: 50,0:29:23.91,0:29:28.71,Main-207-,,0,0,0,,Bu, Kaptan Kuro denen adam için ne anlama geliyordu, biliyor musun?!Dialogue: 50,0:29:36.09,0:29:39.13,Main-207-,,0,0,0,,Kuro!Dialogue: 50,0:29:44.80,0:29:47.18,Main-207-,,0,0,0,,Aklıma geldi de...Dialogue: 50,0:29:49.52,0:29:52.85,Main-207-,,0,0,0,,Hâlâ bana bir yumruk borcun var.Dialogue: 50,0:29:53.40,0:29:55.06,Main-207-,,0,0,0,,Usopp-san!Dialogue: 50,0:29:55.40,0:29:59.86,Main-207-,,0,0,0,,O sırada bana oldukça sert vurdun.Dialogue: 50,0:30:23.09,0:30:27.93,Main-207-,,0,0,0,,Madem bu kadar nefret ettin, sana yüzlercesini bedavaya vereceğim!Dialogue: 0,0:01:50.05,0:01:57.68,Title-207-,,0,0,0,,Sessiz AdamDialogue: 0,0:01:50.05,0:01:57.68,Title-207-,,0,0,0,,Sessiz AdamDialogue: 0,0:06:50.14,0:06:53.14,Captions-207-,,0,0,0,,Sham Gemi Muhafızı Kara Kedi KorsanlarıDialogue: 1,0:06:50.14,0:06:53.14,Captions-207-,,0,0,0,,Sham Gemi Muhafızı Kara Kedi KorsanlarıDialogue: 2,0:06:50.14,0:06:53.14,Captions-207-,,0,0,0,,Sham Gemi Muhafızı Kara Kedi KorsanlarıDialogue: 0,0:06:53.31,0:06:56.44,Captions-207-,,0,0,0,,Buchi Gemi Muhafızı Kara Kedi KorsanlarıDialogue: 1,0:06:53.31,0:06:56.44,Captions-207-,,0,0,0,,Buchi Gemi Muhafızı Kara Kedi KorsanlarıDialogue: 2,0:06:53.31,0:06:56.44,Captions-207-,,0,0,0,,Buchi Gemi Muhafızı Kara Kedi KorsanlarıDialogue: 0,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 1,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 0,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Feeso Galaxy 9000Dialogue: 1,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Feeso Galaxy 9000Dialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,MüzikDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,MüzikDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,HaleeDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,HaleeDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,GrafikDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,GrafikDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,DatenshiDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,DatenshiDialogue: 0,0:00:06.78,0:00:10.78,C