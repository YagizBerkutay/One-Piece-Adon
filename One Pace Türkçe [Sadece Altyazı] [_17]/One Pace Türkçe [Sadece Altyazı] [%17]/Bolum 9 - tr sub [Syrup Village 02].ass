8,23,23,23,1Style: Lyrics-furigana,Duality,36,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,2.95,0,2,23,23,34,1Style: Lyrics,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,2,23,23,34,1Style: Karaoke,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,23,1Style: Kanji,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,146,1Style: Roger-Monologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1Style: Romaji ED,Josefin Sans,82,&H00FFFFFF,&H003592BE,&H00000000,&H64000000,0,0,0,0,100,100,0,0,1,0,4,8,10,10,20,1Style: Translation ED,Josefin Sans,82,&H00FFFFFF,&H000000FF,&H00FFFFFF,&H64000000,0,0,0,0,100,100,0,0,1,0,4,2,10,10,20,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:49.96,0:01:59.95,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 50,0:01:52.55,0:01:56.30,Main-207-,,0,0,0,,Kulağa kötü gelen suikast kelimesini kullanma, Jango.Dialogue: 50,0:01:56.30,0:01:58.14,Main-207-,,0,0,0,,Ah, haklısın.Dialogue: 50,0:01:58.14,0:01:59.77,Main-207-,,0,0,0,,Yanlışlıkla. Yanlışlıkla oldu.Dialogue: 50,0:02:01.85,0:02:04.35,Main-207-,,0,0,0,,Hey, onlar neden bahsediyor?Dialogue: 50,0:02:04.35,0:02:06.11,Main-207-,,0,0,0,,B-Bana sorma!Dialogue: 50,0:02:06.11,0:02:08.57,Main-207-,,0,0,0,,Ben de bunu öğrenmeye çalışıyorum.Dialogue: 50,0:02:08.98,0:02:11.53,Main-207-,,0,0,0,,Öylece onu öldüremeyiz.Dialogue: 50,0:02:11.53,0:02:15.45,Main-207-,,0,0,0,,Kaya hanımefendi bir kaza yüzünden ölmeli.Dialogue: 50,0:02:15.45,0:02:17.03,Main-207-,,0,0,0,,Sakın berbat etme!Dialogue: 50,0:02:18.08,0:02:23.96,Main-207-,,0,0,0,,Kısacası, işaretinle köye saldırıp hanımefendiyi öldüreceğiz.Dialogue: 50,0:02:24.46,0:02:27.71,Main-207-,,0,0,0,,Sonra mirasına sahip olacaksın.Dialogue: 50,0:02:27.71,0:02:30.59,Main-207-,,0,0,0,,Aptal! Kafanı çalıştır!Dialogue: 50,0:02:30.59,0:02:34.13,Main-207-,,0,0,0,,Bir yabancı onun mirasına nasıl sahip olabilir?!Dialogue: 50,0:02:34.13,0:02:36.01,Main-207-,,0,0,0,,Çok çalışarak mı?Dialogue: 50,0:02:36.01,0:02:37.72,Main-207-,,0,0,0,,Çok çalışmak nafile.Dialogue: 50,0:02:38.60,0:02:41.64,Main-207-,,0,0,0,,Dinle, en önemli kısmını anlatıyorum.Dialogue: 50,0:02:41.64,0:02:45.69,Main-207-,,0,0,0,,Kaya'yı öldürmeden önce, hipnotize edip vasiyetine şunu yazdıracaksın...Dialogue: 50,0:02:46.06,0:02:50.19,Main-207-,,0,0,0,,"Tüm servetimi uşağım Klahadore’a bırakıyorum!"Dialogue: 50,0:02:52.44,0:02:57.45,Main-207-,,0,0,0,,Ancak o zaman onun muazzam servetine...Dialogue: 50,0:02:58.20,0:03:00.91,Main-207-,,0,0,0,,yasal bir şekilde sahip olabilirim.Dialogue: 50,0:03:01.79,0:03:06.62,Main-207-,,0,0,0,,Tam 3 yıl boyunca etrafındaki herkesin güvenini kazandım,Dialogue: 50,0:03:06.62,0:03:10.84,Main-207-,,0,0,0,,böylece mirasını bana bıraktığında kimse şüphelenmeyecek.Dialogue: 50,0:03:11.46,0:03:14.80,Main-207-,,0,0,0,,Bunun için 3 yıl uşaklık yaptın, ha?Dialogue: 50,0:03:14.80,0:03:17.39,Main-207-,,0,0,0,,O zamanlar bizi çok korkutmuştun,Dialogue: 50,0:03:17.39,0:03:18.47,Main-207-,,0,0,0,,Kaptan Kuro.Dialogue: 50,0:03:19.39,0:03:23.22,Main-207-,,0,0,0,,3 yıl önce aniden korsanlığı bırakacağını söylemiştin.Dialogue: 50,0:03:23.93,0:03:27.19,Main-207-,,0,0,0,,Sana benzeyen bir astını feda edip...Dialogue: 50,0:03:27.19,0:03:30.86,Main-207-,,0,0,0,,dünyayı Kaptan Kuro'nun öldüğüne inandırdın.Dialogue: 50,0:03:41.45,0:03:45.33,Main-207-,,0,0,0,,İşte planın başlangıcı buydu.Dialogue: 50,0:03:45.33,0:03:47.37,Main-207-,,0,0,0,,"Bin Planlı" Kuro'ya yakışır şekilde.Dialogue: 50,0:03:47.37,0:03:49.67,Main-207-,,0,0,0,,Beni o isimle anma.Dialogue: 50,0:03:49.67,0:03:51.88,Main-207-,,0,0,0,,3 yıl önce o ismi bıraktım.Dialogue: 50,0:03:52.13,0:03:56.63,Main-207-,,0,0,0,,Sadece zengin olup, hükûmetin beni takip etmesini istemiyorum.Dialogue: 50,0:03:56.63,0:03:59.22,Main-207-,,0,0,0,,Başka bir deyişle, şimdi bir barışseverim.Dialogue: 50,0:04:01.05,0:04:03.72,Main-207-,,0,0,0,,Çok barışseversin, yahu!Dialogue: 50,0:04:03.72,0:04:08.19,Main-207-,,0,0,0,,Hangi barışsever zengin bir kızın bütün ailesini öldürür ki?Dialogue: 50,0:04:08.19,0:04:09.27,Main-207-,,0,0,0,,Dur, bakalım.Dialogue: 50,0:04:09.27,0:04:11.73,Main-207-,,0,0,0,,Babasının ölümünün benimle bir alakası yok.Dialogue: 50,0:04:11.73,0:04:13.61,Main-207-,,0,0,0,,O beklenmedik bir şeydi.Dialogue: 50,0:04:13.86,0:04:14.94,Main-207-,,0,0,0,,Her neyse.Dialogue: 50,0:04:14.94,0:04:16.57,Main-207-,,0,0,0,,Beni ilgilendirmez.Dialogue: 50,0:04:16.57,0:04:19.03,Main-207-,,0,0,0,,Bize işaret ver artık.Dialogue: 50,0:04:19.03,0:04:24.08,Main-207-,,0,0,0,,Gemimiz neredeyse bir haftadır yakınlarda demirlemiş vaziyette.Dialogue: 50,0:04:24.66,0:04:27.71,Main-207-,,0,0,0,,Adamlarım sabırsızlanıyor.Dialogue: 50,0:04:33.88,0:04:35.46,Thoughts-207-,,0,0,0,,Çok fena!Dialogue: 50,0:04:36.21,0:04:39.09,Thoughts-207-,,0,0,0,,Korkunç bir şeye kulak misafiri olduk!Dialogue: 50,0:04:40.34,0:04:43.05,Main-207-,,0,0,0,,Hey, neler oluyor? Pek iyi görünmüyor.Dialogue: 50,0:04:43.05,0:04:46.60,Main-207-,,0,0,0,,Dinlemedin mi?! Bu gerçekten korkunç!Dialogue: 50,0:04:46.60,0:04:47.93,Main-207-,,0,0,0,,Onlar ciddiler!Dialogue: 50,0:04:48.27,0:04:55.15,Main-207-,,0,0,0,,Kaptan Kuro, tüm zamanların en kurnaz ve gaddar korsanı olarak bilinir!Dialogue: 50,0:04:55.98,0:05:00.24,Main-207-,,0,0,0,,3 sene önce denizciler tarafından yakalanıp idam edildiğini duymuştum.Dialogue: 50,0:05:00.24,0:05:02.66,Main-207-,,0,0,0,,Ama Kaptan Kuro yaşıyor...Dialogue: 50,0:05:02.66,0:05:05.20,Main-207-,,0,0,0,,"Uşak Klahadore" olarak!Dialogue: 50,0:05:05.20,0:05:10.83,Main-207-,,0,0,0,,3 yıldır Kaya'nın servetinin peşindeymiş!Dialogue: 50,0:05:12.38,0:05:14.50,Main-207-,,0,0,0,,Köye saldıracaklar!Dialogue: 50,0:05:15.04,0:05:16.05,Main-207-,,0,0,0,,Kaya da tehlikede!Dialogue: 50,0:05:19.42,0:05:20.59,Main-207-,,0,0,0,,Korkunç!Dialogue: 50,0:05:20.59,0:05:22.89,Main-207-,,0,0,0,,Gerçekten korkunç!Dialogue: 50,0:05:25.68,0:05:28.10,Main-207-,,0,0,0,,H-Hey, ayağa kalkma! Seni görecekler!Dialogue: 50,0:05:28.10,0:05:29.39,Main-207-,,0,0,0,,Hey, sizler!Dialogue: 50,0:05:29.39,0:05:31.19,Main-207-,,0,0,0,,Hanımefendiye dokunmayın!Dialogue: 50,0:05:33.23,0:05:34.40,Main-207-,,0,0,0,,Sen kimsin?!Dialogue: 50,0:05:34.40,0:05:37.32,Main-207-,,0,0,0,,Salak! Seni fark ettiler!Dialogue: 50,0:05:37.32,0:05:39.36,Main-207-,,0,0,0,,Çabuk! Öldürülmeden saklan!Dialogue: 50,0:05:39.74,0:05:40.99,Main-207-,,0,0,0,,Bak sen...Dialogue: 50,0:05:40.99,0:05:43.74,Main-207-,,0,0,0,,Bu Usopp-kun değil mi?Dialogue: 50,0:05:44.99,0:05:46.70,Main-207-,,0,0,0,,Beni de gördüler!Dialogue: 50,0:05:47.33,0:05:50.66,Main-207-,,0,0,0,,Bazı ilginç şeyler duymuş olabilir misin?Dialogue: 50,0:05:50.66,0:05:53.37,Main-207-,,0,0,0,,H-Hayır! N-Ne demek istiyorsun?!Dialogue: 50,0:05:53.37,0:05:56.13,Main-207-,,0,0,0,,Daha yeni geldik, bu yüzden hiç–Dialogue: 50,0:05:56.13,0:05:57.30,Main-207-,,0,0,0,,Her şeyi duyduk!Dialogue: 50,0:05:57.30,0:05:58.34,Main-207-,,0,0,0,,Hey!Dialogue: 50,0:06:04.51,0:06:07.76,Main-207-,,0,0,0,,Peki, peki.Dialogue: 50,0:06:08.51,0:06:10.27,Main-207-,,0,0,0,,Hey, beyinsizler!Dialogue: 50,0:06:10.73,0:06:12.44,Main-207-,,0,0,0,,Dikkatlice halkaya bakın!Dialogue: 50,0:06:12.73,0:06:14.31,Main-207-,,0,0,0,,Ha? O da ne?Dialogue: 50,0:06:14.31,0:06:17.44,Main-207-,,0,0,0,,Ç-Çok kötü! Bu bir fırlatma silahı! Savuştur!Dialogue: 50,0:06:18.44,0:06:21.69,Main-207-,,0,0,0,,"Bir, iki, Jango" diyeceğim ve uyuyacaksınız.Dialogue: 50,0:06:21.69,0:06:23.15,Main-207-,,0,0,0,,Tamam mı?Dialogue: 50,0:06:23.15,0:06:24.53,Main-207-,,0,0,0,,Bir...Dialogue: 50,0:06:24.53,0:06:25.57,Main-207-,,0,0,0,,İki...Dialogue: 50,0:06:23.70,0:06:26.12,Main-207-,,0,0,0,,Saklan! Bizi öldürecek!Dialogue: 50,0:06:26.12,0:06:27.07,Main-207-,,0,0,0,,Jango!Dialogue: 50,0:06:32.20,0:06:33.83,Main-207-,,0,0,0,,Hey, uyan, Jango!Dialogue: 50,0:06:33.83,0:06:36.04,Main-207-,,0,0,0,,Hâlâ bu alışkanlığından kurtulamadın mı?Dialogue: 50,0:06:38.25,0:06:40.88,Main-207-,,0,0,0,,H-Hey, ne yapıyorsun?! Düşeceksin!Dialogue: 50,0:06:44.68,0:06:47.93,Main-207-,,0,0,0,,Kafa üstü, ha?Dialogue: 50,0:06:47.93,0:06:50.56,Main-207-,,0,0,0,,Seni öldürmek gibi bir niyetim yoktu.Dialogue: 50,0:06:50.56,0:06:53.18,Main-207-,,0,0,0,,O yükseklikten düşünce, kurtulamazsın.Dialogue: 50,0:06:53.56,0:06:54.52,Main-207-,,0,0,0,,Kahretsin!Dialogue: 50,0:06:55.77,0:06:57.02,Main-207-,,0,0,0,,Onu öldürdü!Dialogue: 50,0:06:57.02,0:06:58.15,Main-207-,,0,0,0,,Şerefsiz herif!Dialogue: 50,0:06:58.15,0:06:59.48,Main-207-,,0,0,0,,Kahretsin!Dialogue: 50,0:06:59.94,0:07:01.48,Main-207-,,0,0,0,,Peki ya diğeri?Dialogue: 50,0:07:01.48,0:07:03.24,Main-207-,,0,0,0,,İcabına bakayım mı?Dialogue: 50,0:07:03.24,0:07:04.45,Main-207-,,0,0,0,,Gerek yok.Dialogue: 50,0:07:04.82,0:07:07.62,Main-207-,,0,0,0,,Ne söylerse söylesin, işe yaramayacak.Dialogue: 50,0:07:09.58,0:07:11.62,Main-207-,,0,0,0,,Yarın sabah, Jango.Dialogue: 50,0:07:11.62,0:07:13.96,Main-207-,,0,0,0,,Şafak vakti köye saldırın.Dialogue: 50,0:07:13.96,0:07:16.17,Main-207-,,0,0,0,,Köylülerin evlerini yağmalayın,Dialogue: 50,0:07:16.17,0:07:20.54,Main-207-,,0,0,0,,ve Kaya hanımefendinin cinayetinin bir kaza gibi görünmesini sağlayın!Dialogue: 50,0:07:21.92,0:07:23.01,Main-207-,,0,0,0,,Yarın!Dialogue: 50,0:07:23.34,0:07:25.76,Main-207-,,0,0,0,,İşte böyle, Usopp.Dialogue: 50,0:07:25.76,0:07:30.51,Main-207-,,0,0,0,,Ne duymuş olursan ol, planımı bozamayacaksın.Dialogue: 50,0:07:30.51,0:07:31.93,Main-207-,,0,0,0,,Lanet olsun!Dialogue: 50,0:07:35.89,0:07:37.35,Main-207-,,0,0,0,,Emin misin?Dialogue: 50,0:07:37.35,0:07:40.40,Main-207-,,0,0,0,,Elbette. Planım kusursuz.Dialogue: 50,0:07:42.82,0:07:45.36,Thoughts-207-,,0,0,0,,Bu çok kötü! Bu gerçekten çok kötü!Dialogue: 50,0:07:45.86,0:07:48.78,Thoughts-207-,,0,0,0,,Birlikte büyüdüğüm herkes öldürülecek.Dialogue: 50,0:07:48.78,0:07:50.87,Thoughts-207-,,0,0,0,,Kaya öldürülecek!Dialogue: 50,0:07:51.24,0:07:54.91,Thoughts-207-,,0,0,0,,Sevdiğim herkes...!Dialogue: 50,0:07:57.08,0:07:58.67,Flashbacks-207-,,0,0,0,,Sen de kimsin?!Dialogue: 50,0:07:58.67,0:08:00.33,Flashbacks-207-,,0,0,0,,Ben Usopp!Dialogue: 50,0:08:00.33,0:08:02.34,Flashbacks-207-,,0,0,0,,Denizin cesur savaşçısı!Dialogue: 50,0:08:03.42,0:08:05.46,Flashbacks-207-,,0,0,0,,Son zamanlarda mutsuz olduğunu duydum!Dialogue: 50,0:08:05.46,0:08:07.51,Flashbacks-207-,,0,0,0,,Bir hikâyeyle seni neşelendireyim!Dialogue: 50,0:08:08.01,0:08:09.89,Flashbacks-207-,,0,0,0,,Seni ilgilendirmez!Dialogue: 50,0:08:09.89,0:08:10.89,Flashbacks-207-,,0,0,0,,Lütfen git!Dialogue: 50,0:08:10.89,0:08:12.64,Flashbacks-207-,,0,0,0,,Yoksa birilerini çağıracağım!Dialogue: 50,0:08:16.14,0:08:18.56,Flashbacks-207-,,0,0,0,,Sonra? Ondan sonra ne oldu?!Dialogue: 50,0:08:18.56,0:08:20.31,Flashbacks-207-,,0,0,0,,Tabii ki savaştım!Dialogue: 50,0:08:22.23,0:08:26.78,Main-207-,,0,0,0,,Kahretsin!Dialogue: 50,0:08:31.24,0:08:32.62,Main-207-,,0,0,0,,– Kaptan! – Kaptan!Dialogue: 50,0:08:32.62,0:08:35.83,Main-207-,,0,0,0,,Ne? Luffy onunla değil miydi?Dialogue: 50,0:08:38.04,0:08:39.21,Main-207-,,0,0,0,,– Kaptan! – Kaptan!Dialogue: 50,0:08:40.33,0:08:42.67,Main-207-,,0,0,0,,Luffy nerede? Seninle kıyıda...?Dialogue: 50,0:08:47.01,0:08:51.34,Main-207-,,0,0,0,,Hâlâ babasının aşağılanmasına mı öfkeli?Dialogue: 50,0:08:52.68,0:08:54.31,Main-207-,,0,0,0,,Kim bilir?Dialogue: 50,0:08:54.56,0:08:56.81,Main-207-,,0,0,0,,Hayır, bakışları farklıydı!Dialogue: 50,0:08:56.81,0:08:58.56,Main-207-,,0,0,0,,Evet, bir şey olmuş olmalı!Dialogue: 50,0:08:58.56,0:09:01.02,Main-207-,,0,0,0,,Yüz ifadesini böyle değiştiren ne olabilir?Dialogue: 50,0:09:01.85,0:09:04.40,Main-207-,,0,0,0,,Hey, o kıyıya nasıl gidebiliriz?Dialogue: 50,0:09:04.77,0:09:06.90,Main-207-,,0,0,0,,Bu işte bir sıkıntı var gibi!Dialogue: 50,0:09:06.90,0:09:09.20,Main-207-,,0,0,0,,Evet, kıyıda bir şey olmuş olmalı.Dialogue: 50,0:09:09.20,0:09:11.36,Main-207-,,0,0,0,,Bu Usopp Korsanlarına göre bir iş!Dialogue: 50,0:09:11.61,0:09:14.24,Main-207-,,0,0,0,,Tamam, anladık be! Oraya nasıl gideceğiz?!Dialogue: 50,0:09:19.08,0:09:22.25,Main-207-,,0,0,0,,Kötü haber, millet!!!Dialogue: 50,0:09:22.25,0:09:26.71,Main-207-,,0,0,0,,Korsanlar geliyor!!!Dialogue: 50,0:09:30.13,0:09:33.93,Main-207-,,0,0,0,,Korsanlar, yarın sabah bu köye baskın yapacaklar!Dialogue: 50,0:09:33.93,0:09:35.76,Main-207-,,0,0,0,,Herkes kaçsın!Dialogue: 50,0:09:53.49,0:09:54.70,Main-207-,,0,0,0,,Hey, Usopp!Dialogue: 50,0:09:54.70,0:09:56.91,Main-207-,,0,0,0,,Yeter artık, yeter!Dialogue: 50,0:09:56.91,0:10:00.12,Main-207-,,0,0,0,,Seni sonsuza dek susturacağız!Dialogue: 50,0:10:00.12,0:10:02.62,Main-207-,,0,0,0,,H-Hayır, bu sefer öyle değil!Dialogue: 50,0:10:02.62,0:10:03.96,Main-207-,,0,0,0,,Bu kez doğru!Dialogue: 50,0:10:04.21,0:10:07.29,Main-207-,,0,0,0,,Kapa' çeneni! Bize hep yalan söyledin.Dialogue: 50,0:10:07.29,0:10:11.47,Main-207-,,0,0,0,,Eğer Klahadore kadar dürüst olsaydın, sana inanabilirdik.Dialogue: 50,0:10:11.51,0:10:14.39,Flashbacks-207-,,0,0,0,,Ne söylerse söylesin, işe yaramayacak.Dialogue: 50,0:10:14.39,0:10:15.97,Flashbacks-207-,,0,0,0,,Yarın sabah, Jango.Dialogue: 50,0:10:15.97,0:10:18.22,Flashbacks-207-,,0,0,0,,Şafak vakti köye saldırın.Dialogue: 50,0:10:18.97,0:10:20.35,Thoughts-207-,,0,0,0,,Kahretsin!Dialogue: 50,0:10:20.35,0:10:25.52,Thoughts-207-,,0,0,0,,Beni saldı, çünkü kimsenin bana inanmayacağını biliyordu, değil mi?!Dialogue: 50,0:10:31.86,0:10:34.11,Main-207-,,0,0,0,,Bu hoşunuza gitti mi?Dialogue: 50,0:10:35.03,0:10:38.16,Main-207-,,0,0,0,,Komşu kasabadan sipariş ettiğiniz...Dialogue: 50,0:10:38.49,0:10:40.70,Main-207-,,0,0,0,,gözlükleri aldım.Dialogue: 50,0:10:40.70,0:10:42.58,Main-207-,,0,0,0,,Evet, mükemmel!Dialogue: 50,0:10:43.58,0:10:47.13,Main-207-,,0,0,0,,Seni komşu kasabaya kadar yorduğum için üzgünüm.Dialogue: 50,0:10:53.92,0:10:55.30,Main-207-,,0,0,0,,Hediye mi?Dialogue: 50,0:10:55.30,0:10:56.55,Main-207-,,0,0,0,,Evet.Dialogue: 50,0:10:56.55,0:11:01.06,Main-207-,,0,0,0,,Yarın Klahadore'un bu malikâneye gelişinin 3. yıldönümü olacak.Dialogue: 50,0:11:01.06,0:11:03.31,Main-207-,,0,0,0,,Onca yıldır benimle ilgilendi.Dialogue: 50,0:11:03.85,0:11:06.48,Main-207-,,0,0,0,,Klahadore-san buna bayılacak!Dialogue: 50,0:11:06.48,0:11:07.27,Main-207-,,0,0,0,,Evet!Dialogue: 50,0:11:10.02,0:11:12.53,Main-207-,,0,0,0,,Millet, lütfen beni dinleyin!Dialogue: 50,0:11:12.90,0:11:15.61,Main-207-,,0,0,0,,Korsanlar yarın sabah buraya gerçekten saldıracak!Dialogue: 50,0:11:15.99,0:11:20.99,Main-207-,,0,0,0,,Senin her uydurduğuna inansaydık, çoktan yüzlerce kez kaçmıştık!Dialogue: 50,0:11:20.99,0:11:23.58,Main-207-,,0,0,0,,Lütfen bana inanın! Buradan kaçmalısınız!Dialogue: 50,0:11:23.58,0:11:26.71,Main-207-,,0,0,0,,Gerçekten herkesi öldürecekler!Dialogue: 50,0:11:26.71,0:11:29.50,Main-207-,,0,0,0,,Yemin ederim, bu sefer doğru!Dialogue: 50,0:11:29.50,0:11:32.21,Main-207-,,0,0,0,,Bu sefer seni yakalayacağız!Dialogue: 50,0:11:35.63,0:11:37.76,Main-207-,,0,0,0,,Kahretsin!!!Dialogue: 50,0:11:37.76,0:11:40.05,Main-207-,,0,0,0,,Yakalayın onu! Kaçmasına izin vermeyin!Dialogue: 50,0:11:48.06,0:11:51.11,Main-207-,,0,0,0,,Geldiğiniz için teşekkürler, beyler.Dialogue: 50,0:11:51.11,0:11:53.07,Main-207-,,0,0,0,,Tam 3 yıl oldu.Dialogue: 50,0:11:53.65,0:11:56.32,Main-207-,,0,0,0,,Bu plan başarılı olursa...Dialogue: 50,0:11:56.32,0:12:00.53,Main-207-,,0,0,0,,ganimetten hepinize adil bir pay vermeyi düşünüyorum.Dialogue: 50,0:12:01.49,0:12:05.58,Main-207-,,0,0,0,,Yarın sabah, köyü dilediğiniz gibi yağmalayın!Dialogue: 50,0:12:13.05,0:12:15.51,Main-207-,,0,0,0,,– Ne?! Hanımefendiyi mi öldürecekler?! – Ne?! Hanımefendiyi mi öldürecekler?!Dialogue: 50,0:12:15.51,0:12:18.72,Main-207-,,0,0,0,,– Gerçekten köye mi saldıracaklar?! – Gerçekten köye mi saldıracaklar?!Dialogue: 50,0:12:19.47,0:12:20.34,Main-207-,,0,0,0,,Evet.Dialogue: 50,0:12:20.34,0:12:22.68,Main-207-,,0,0,0,,Böyle diyorlardı. Hiç şüphem yok.Dialogue: 50,0:12:26.85,0:12:29.73,Main-207-,,0,0,0,,Bu arada, sen niye burada kestiriyorsun?Dialogue: 50,0:12:30.19,0:12:31.40,Main-207-,,0,0,0,,Olay da bu zaten!Dialogue: 50,0:12:31.40,0:12:34.23,Main-207-,,0,0,0,,Uçurumun tepesinde olduğumu sanıyordum...Dialogue: 50,0:12:34.73,0:12:37.32,Secondary-207-,,0,0,0,,Nasıl oldu da buraya geldim?Dialogue: 50,0:12:35.19,0:12:37.49,Main-207-,,0,0,0,,Haklıymışız, Klahadore kötü biri!Dialogue: 50,0:12:37.49,0:12:39.07,Main-207-,,0,0,0,,Tipinden belliydi!Dialogue: 50,0:12:39.07,0:12:42.99,Main-207-,,0,0,0,,Demek bu yüzden kaptanımız o gergin bakışla köye koştu!Dialogue: 50,0:12:42.99,0:12:44.29,Main-207-,,0,0,0,,Harika o zaman!Dialogue: 50,0:12:44.29,0:12:47.25,Main-207-,,0,0,0,,Uyarıldıkları için kaçacak zamanları var.Dialogue: 50,0:12:47.25,0:12:48.79,Main-207-,,0,0,0,,Aptal kötülerden bahsediyoruz!Dialogue: 50,0:12:48.79,0:12:51.71,Main-207-,,0,0,0,,Evet, bu doğru! Bu yüzden biz de kaçmalıyız!Dialogue: 50,0:12:51.71,0:12:53.54,Main-207-,,0,0,0,,Evet, değerli ne varsa alıp...Dialogue: 50,0:12:53.54,0:12:54.50,Main-207-,,0,0,0,,– tüyelim! – tüyelim!Dialogue: 50,0:12:58.22,0:12:58.88,Main-207-,,0,0,0,,Eyvah!Dialogue: 50,0:12:58.88,0:13:00.05,Main-207-,,0,0,0,,Ne oldu?Dialogue: 50,0:12:59.88,0:13:03.85,Main-207-,,0,0,0,,Kasap kaçmadan önce yiyecek stoklamalıyız!Dialogue: 50,0:13:04.97,0:13:07.18,Main-207-,,0,0,0,,Bunu düşünecek zaman değil.Dialogue: 50,0:13:24.07,0:13:25.24,Main-207-,,0,0,0,,Usopp-san!Dialogue: 50,0:13:31.67,0:13:32.83,Main-207-,,0,0,0,,Tanrı'ya şükür!Dialogue: 50,0:13:32.83,0:13:35.34,Main-207-,,0,0,0,,Bir daha buraya gelmeyeceğini düşünmüştüm.Dialogue: 50,0:13:36.50,0:13:38.34,Main-207-,,0,0,0,,Kaçmalısın, Kaya!Dialogue: 50,0:13:38.34,0:13:39.55,Main-207-,,0,0,0,,Seni öldürecekler!Dialogue: 50,0:13:39.80,0:13:40.59,Main-207-,,0,0,0,,Şey...Dialogue: 50,0:13:41.30,0:13:42.63,Main-207-,,0,0,0,,Ne demek istiyorsun?Dialogue: 50,0:13:42.63,0:13:44.76,Main-207-,,0,0,0,,Aldatıldın!Dialogue: 50,0:13:44.76,0:13:46.72,Main-207-,,0,0,0,,Uşak aslında bir korsan!Dialogue: 50,0:13:47.81,0:13:49.31,Main-207-,,0,0,0,,Dur biraz...Dialogue: 50,0:13:50.48,0:13:52.27,Main-207-,,0,0,0,,Bu ne tür bir şaka böyle?Dialogue: 50,0:13:53.56,0:13:54.98,Main-207-,,0,0,0,,Şaka değil!Dialogue: 50,0:13:54.98,0:13:57.15,Main-207-,,0,0,0,,Kendi kulaklarımla duydum!Dialogue: 50,0:13:57.48,0:13:58.73,Main-207-,,0,0,0,,Klahadore,Dialogue: 50,0:13:58.73,0:14:02.53,Main-207-,,0,0,0,,servetini çalmak için sinsice bu malikâneye sızan bir korsan!Dialogue: 50,0:14:02.53,0:14:07.12,Main-207-,,0,0,0,,Senden çalmak için tam 3 yıldır uşakmış gibi davrandı!Dialogue: 50,0:14:07.91,0:14:11.16,Main-207-,,0,0,0,,Sen neden bahsediyorsun, Usopp-san?Dialogue: 50,0:14:11.66,0:14:16.13,Main-207-,,0,0,0,,Adamları şafak vakti baskın yapıp seni öldürecekler!Dialogue: 50,0:14:20.46,0:14:25.05,Main-207-,,0,0,0,,O herif tam bir cani! Hemen kaçmalısın!Dialogue: 50,0:14:26.64,0:14:29.39,Main-207-,,0,0,0,,Kabul ediyorum, daha önce çok ileri gitti.Dialogue: 50,0:14:30.02,0:14:32.02,Main-207-,,0,0,0,,Ama böyle bir yalan...Dialogue: 50,0:14:32.98,0:14:34.69,Main-207-,,0,0,0,,Bu sen değilsin, Usopp-san!Dialogue: 50,0:14:36.31,0:14:39.11,Main-207-,,0,0,0,,Hayır, yalan değil...Dialogue: 50,0:14:42.07,0:14:43.11,Main-207-,,0,0,0,,Ben...Dialogue: 50,0:14:44.15,0:14:45.95,Main-207-,,0,0,0,,Onlara bayıldım.Dialogue: 50,0:14:48.37,0:14:51.75,Main-207-,,0,0,0,,Anlattığın yalanları çok sevdim...Dialogue: 50,0:14:52.12,0:14:54.79,Main-207-,,0,0,0,,Ama neden bunu söylüyorsun?Dialogue: 50,0:14:56.79,0:15:01.21,Main-207-,,0,0,0,,Öyle değil! Klahadore'dan intikam almaya çalışmıyorum...Dialogue: 50,0:15:01.59,0:15:04.43,Main-207-,,0,0,0,,O zaman neden...?Dialogue: 50,0:15:04.43,0:15:06.39,Main-207-,,0,0,0,,Kaya... Ben...Dialogue: 50,0:15:08.18,0:15:10.51,Main-207-,,0,0,0,,Hanımefendi, bir sorun mu var?!Dialogue: 50,0:15:15.81,0:15:17.35,Main-207-,,0,0,0,,Kaçmalısın, Kaya!Dialogue: 50,0:15:17.94,0:15:20.27,Main-207-,,0,0,0,,Hanımefendiyi bırak!Dialogue: 50,0:15:21.73,0:15:23.65,Main-207-,,0,0,0,,Sadece bana güven!Dialogue: 50,0:15:23.65,0:15:25.65,Main-207-,,0,0,0,,O uşak geri gelmeden önce...Dialogue: 50,0:15:25.65,0:15:28.20,Main-207-,,0,0,0,,bu köyü terketmelisin!Dialogue: 50,0:15:40.42,0:15:41.59,Main-207-,,0,0,0,,Yapma!Dialogue: 50,0:15:44.72,0:15:45.26,Main-207-,,0,0,0,,Hadi!Dialogue: 50,0:15:50.93,0:15:53.22,Main-207-,,0,0,0,,Yarın olunca bana inanacaksın.Dialogue: 50,0:15:53.22,0:15:54.98,Main-207-,,0,0,0,,Şimdilik kaçalım!Dialogue: 50,0:15:54.98,0:15:56.44,Main-207-,,0,0,0,,Lütfen, dinle!Dialogue: 50,0:16:05.24,0:16:06.90,Main-207-,,0,0,0,,Acınacak hâldesin.Dialogue: 50,0:16:18.37,0:16:20.29,Main-207-,,0,0,0,,Hanımefendiden uzaklaş!Dialogue: 50,0:16:23.67,0:16:24.38,Main-207-,,0,0,0,,Yapma!Dialogue: 50,0:16:37.98,0:16:39.98,Main-207-,,0,0,0,,Lütfen, yakalayın onu!Dialogue: 50,0:16:39.98,0:16:42.19,Main-207-,,0,0,0,,Evin hanımını hırpaladı!Dialogue: 50,0:16:42.52,0:16:43.48,Main-207-,,0,0,0,,Ne kadar korkunç!Dialogue: 50,0:16:43.48,0:16:44.82,Main-207-,,0,0,0,,Nasıl yapabildi?!Dialogue: 50,0:16:49.57,0:16:50.66,Thoughts-207-,,0,0,0,,Neden...Dialogue: 50,0:16:51.82,0:16:53.83,Thoughts-207-,,0,0,0,,kimse bana inanmıyor?Dialogue: 50,0:16:57.25,0:16:58.87,Main-207-,,0,0,0,,İşte orada!Dialogue: 50,0:16:58.87,0:17:00.42,Main-207-,,0,0,0,,Yakalayın!Dialogue: 50,0:17:06.38,0:17:08.63,Main-207-,,0,0,0,,Usopp-san...Dialogue: 50,0:17:09.38,0:17:12.43,Main-207-,,0,0,0,,Hanımefendi, lütfen soğukkanlılığınızı koruyun!Dialogue: 50,0:17:15.89,0:17:18.14,Flashbacks-207-,,0,0,0,,Yarın sabah, Jango.Dialogue: 50,0:17:18.14,0:17:20.89,Flashbacks-207-,,0,0,0,,Şafak vakti köye saldırın.Dialogue: 50,0:17:28.44,0:17:30.45,Main-207-,,0,0,0,,– Kaptan! – Kaptan!Dialogue: 50,0:17:33.03,0:17:34.78,Main-207-,,0,0,0,,Selam, çocuklar!Dialogue: 50,0:17:35.41,0:17:36.45,Main-207-,,0,0,0,,Selam!Dialogue: 50,0:17:38.16,0:17:40.12,Main-207-,,0,0,0,,Y-Yaşıyor musun?!Dialogue: 50,0:17:40.12,0:17:41.50,Main-207-,,0,0,0,,Yaşıyor muyum?Dialogue: 50,0:17:41.50,0:17:43.67,Main-207-,,0,0,0,,Evet, demin uyandım!Dialogue: 50,0:17:43.67,0:17:45.46,Main-207-,,0,0,0,,Onca zamandır uyuyormuş.Dialogue: 50,0:17:45.46,0:17:46.80,Main-207-,,0,0,0,,Neyse Kaptan!Dialogue: 50,0:17:46.80,0:17:48.67,Main-207-,,0,0,0,,Her şeyi duyduk!Dialogue: 50,0:17:48.67,0:17:52.05,Main-207-,,0,0,0,,Acele edip herkesi korsanlar konusunda uyarmalıyız!Dialogue: 50,0:17:52.05,0:17:54.01,Main-207-,,0,0,0,,Herkesi uyarmak mı?Dialogue: 50,0:17:57.01,0:17:58.47,Flashbacks-207-,,0,0,0,,Acınacak hâldesin.Dialogue: 50,0:18:00.93,0:18:03.35,Flashbacks-207-,,0,0,0,,Kapa' çeneni! Bize hep yalan söyledin.Dialogue: 50,0:18:12.61,0:18:15.07,Main-207-,,0,0,0,,Her zamanki gibi yalan söyledim!Dialogue: 50,0:18:15.07,0:18:17.08,Main-207-,,0,0,0,,O lanet uşak beni sinirlendirdi,Dialogue: 50,0:18:17.08,0:18:20.04,Main-207-,,0,0,0,,bu yüzden onun korsan olduğu yalanını uydurdum!Dialogue: 50,0:18:21.83,0:18:23.33,Main-207-,,0,0,0,,Ah, anlıyorum.Dialogue: 50,0:18:23.33,0:18:26.29,Main-207-,,0,0,0,,Demek hasır şapkalı adam da işin içinde!Dialogue: 50,0:18:30.76,0:18:32.72,Main-207-,,0,0,0,,Hey, sorun nedir?Dialogue: 50,0:18:32.72,0:18:33.47,Main-207-,,0,0,0,,Ben...Dialogue: 50,0:18:33.88,0:18:35.84,Main-207-,,0,0,0,,Bunu yaptığına inanamıyorum, Kaptan.Dialogue: 50,0:18:35.84,0:18:36.47,Main-207-,,0,0,0,,Ben de!Dialogue: 50,0:18:36.47,0:18:37.10,Main-207-,,0,0,0,,Aynen!Dialogue: 50,0:18:37.10,0:18:39.47,Main-207-,,0,0,0,,O uşak kötü biri olsa bile...Dialogue: 50,0:18:39.47,0:18:44.14,Main-207-,,0,0,0,,birini incitmek için yalan söyleyeceğini hiç düşünmemiştik.Dialogue: 50,0:18:44.14,0:18:47.44,Main-207-,,0,0,0,,Sana gerçekten saygı duymuştuk!Dialogue: 50,0:18:47.44,0:18:48.32,Main-207-,,0,0,0,,Eve gidelim!Dialogue: 50,0:18:48.32,0:18:50.03,Main-207-,,0,0,0,,Evet, akşam yemeği vakti!Dialogue: 50,0:18:50.03,0:18:51.57,Main-207-,,0,0,0,,Acaba ne yiyeceğiz...?Dialogue: 50,0:18:57.37,0:18:59.91,Main-207-,,0,0,0,,Neden onlara öyle söyledin?Dialogue: 50,0:18:59.91,0:19:02.08,Main-207-,,0,0,0,,Çünkü yalancının tekiyim.Dialogue: 50,0:19:02.08,0:19:05.54,Main-207-,,0,0,0,,En baştan beri kimsenin inanacağı yoktu.Dialogue: 50,0:19:05.54,0:19:06.83,Main-207-,,0,0,0,,Çok iyimserim.Dialogue: 50,0:19:07.96,0:19:10.80,Main-207-,,0,0,0,,Ama sonuçta, gerçek hâlâ gerçektir.Dialogue: 50,0:19:11.30,0:19:14.34,Main-207-,,0,0,0,,Korsanlar gerçekten gelecek, değil mi?Dialogue: 50,0:19:14.34,0:19:16.89,Main-207-,,0,0,0,,Evet, geleceklerine şüphe yok.Dialogue: 50,0:19:16.89,0:19:19.39,Main-207-,,0,0,0,,Ama herkes bunu yalan biliyor.Dialogue: 50,0:19:19.39,0:19:23.52,Main-207-,,0,0,0,,Yarının başka bir sıradan, huzurlu gün olacağını düşünüyorlar...Dialogue: 50,0:19:25.81,0:19:26.94,Main-207-,,0,0,0,,İşte bu yüzden...Dialogue: 50,0:19:26.94,0:19:30.86,Main-207-,,0,0,0,,Yarın kıyıda korsanları durdurup yalan olarak kalmasını sağlayacağım!Dialogue: 50,0:19:30.86,0:19:34.82,Main-207-,,0,0,0,,Bu, benim gibi bir yalancı için mantıklı olan tek şey!Dialogue: 50,0:19:36.45,0:19:38.99,Main-207-,,0,0,0,,Kolumdan vurulsam da...Dialogue: 50,0:19:39.53,0:19:42.04,Main-207-,,0,0,0,,süpürgelerle kovalanmış olsam da...Dialogue: 50,0:19:42.04,0:19:44.33,Main-207-,,0,0,0,,burası benim yuvam!Dialogue: 50,0:19:44.33,0:19:46.71,Main-207-,,0,0,0,,Bu köyü seviyorum!Dialogue: 50,0:19:48.04,0:19:50.67,Main-207-,,0,0,0,,Herkesi korumak istiyorum!Dialogue: 50,0:19:51.63,0:19:53.26,Main-207-,,0,0,0,,Çok iyi bir adamsın,Dialogue: 50,0:19:53.26,0:19:56.13,Main-207-,,0,0,0,,tayfanı bir kenara itip tek başına savaşa giriyorsun.Dialogue: 50,0:19:56.13,0:19:59.64,Main-207-,,0,0,0,,Şunu belirteyim, tüm korsan hazineleri benim olacak.Dialogue: 50,0:19:59.64,0:20:01.60,Main-207-,,0,0,0,,Pekâlâ! Sana yardım edeceğiz!Dialogue: 50,0:20:02.10,0:20:03.10,Main-207-,,0,0,0,,Siz...Dialogue: 50,0:20:03.10,0:20:05.35,Main-207-,,0,0,0,,benimle birlikte savaşmak mı istiyorsunuz?Dialogue: 50,0:20:05.35,0:20:06.56,Main-207-,,0,0,0,,Niye?Dialogue: 50,0:20:06.56,0:20:09.86,Main-207-,,0,0,0,,Sayıca çok azsın, değil mi?Dialogue: 50,0:20:09.86,0:20:12.07,Main-207-,,0,0,0,,Korktuğun yüzünden okunuyor.Dialogue: 50,0:20:12.07,0:20:13.90,Main-207-,,0,0,0,,B-Ben mi korkmuşum?Dialogue: 50,0:20:13.90,0:20:17.07,Main-207-,,0,0,0,,Bir sürü kötü adama karşı falan, tamamen mükemmelim!Dialogue: 50,0:20:17.07,0:20:22.24,Main-207-,,0,0,0,,Çünkü ben denizin cesur savaşçısı, Kaptan Usopp'um!Dialogue: 50,0:20:24.66,0:20:25.75,Main-207-,,0,0,0,,Kahretsin!Dialogue: 50,0:20:25.75,0:20:27.50,Main-207-,,0,0,0,,Neye bakıyorsunuz?!Dialogue: 50,0:20:27.50,0:20:29.75,Main-207-,,0,0,0,,Klahadore'un tayfasıyla karşı karşıyayız!Dialogue: 50,0:20:29.75,0:20:31.21,Main-207-,,0,0,0,,Tabii ki korktum.Dialogue: 50,0:20:31.21,0:20:32.71,Main-207-,,0,0,0,,Bunun nesi yanlış?!Dialogue: 50,0:20:32.71,0:20:34.71,Main-207-,,0,0,0,,Bana acımayın!Dialogue: 50,0:20:34.71,0:20:37.17,Main-207-,,0,0,0,,Gülmeyi kesin ve gidin! Defolun!Dialogue: 50,0:20:37.67,0:20:39.18,Main-207-,,0,0,0,,Gülmüyoruz!Dialogue: 50,0:20:39.18,0:20:42.14,Main-207-,,0,0,0,,Cesaretini takdir ettiğimiz için yardım etmek istiyoruz.Dialogue: 50,0:20:43.14,0:20:46.10,Main-207-,,0,0,0,,Acıma olsaydı, hayatımızı riske atar mıydık?!Dialogue: 50,0:20:51.35,0:20:53.11,Main-207-,,0,0,0,,Ya...Dialogue: 50,0:20:53.11,0:20:55.03,Main-207-,,0,0,0,,Siz...Dialogue: 0,0:01:50.01,0:01:56.26,Title-207-,,0,0,0,,Kaptan KuroDialogue: 1,0:01:50.01,0:01:56.26,Title-207-,,0,0,0,,Kaptan KuroDialogue: 0,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 1,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 0,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Feeso Galaxy 9000Dialogue: 1,0:00:01.7