,0,100,100,0,0,1,1.9,1.9,2,180,180,27,1Style: RogerMonologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1Style: Karaoke,Duality,68,&H00292CC7,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,4,0,1,6.8,0,8,23,23,23,1Style: Translation,Duality,68,&H00292CC7,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,4,0,1,6.8,0,2,23,23,34,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:49.92,0:01:59.93,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 50,0:01:53.18,0:01:55.60,Main-207-,,0,0,0,,Tsunami!Dialogue: 50,0:01:55.60,0:01:56.80,Main-207-,,0,0,0,,Şimdi ne var?Dialogue: 50,0:01:56.80,0:01:58.47,Main-207-,,0,0,0,,Tsunami geliyor!Dialogue: 50,0:01:58.47,0:02:00.10,Main-207-,,0,0,0,,Ne oluyor, Luffy?!Dialogue: 50,0:02:00.10,0:02:02.73,Main-207-,,0,0,0,,Belki de o kadar da iyi bir fikir değildi, ha?Dialogue: 50,0:02:02.73,0:02:04.19,Main-207-,,0,0,0,,İyi olmayan fikir neydi?Dialogue: 50,0:02:04.19,0:02:08.98,Main-207-,,0,0,0,,Ona yapma dedim ama çok susadım dayanamıyorum dedi,Dialogue: 50,0:02:08.98,0:02:12.57,Main-207-,,0,0,0,,ardından oradaki bir kaktüsü yemeye çalıştı.Dialogue: 50,0:02:12.57,0:02:13.86,Main-207-,,0,0,0,,Kaktüs mü?Dialogue: 50,0:02:13.86,0:02:15.82,Main-207-,,0,0,0,,He. Şurada.Dialogue: 50,0:02:16.20,0:02:17.78,Main-207-,,0,0,0,,Şu yuvarlak şeyler.Dialogue: 50,0:02:18.53,0:02:20.91,Main-207-,,0,0,0,,Ne?! Hiç iyi değil!Dialogue: 50,0:02:20.91,0:02:24.83,Main-207-,,0,0,0,,Onlar meskalin kaktüsleri! Halüsinojen yapımında kullanılırlar!Dialogue: 50,0:02:24.83,0:02:26.00,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:02:26.92,0:02:28.67,Main-207-,,0,0,0,,Olamaz!Dialogue: 50,0:02:28.67,0:02:30.42,Main-207-,,0,0,0,,Boğulacağız!Dialogue: 50,0:02:30.42,0:02:33.55,Main-207-,,0,0,0,,İyi o zaman, sen istedin bunu!Dialogue: 50,0:02:34.05,0:02:36.51,Main-207-,,0,0,0,,Ağzınızı, burnunuzu kıracağım!Dialogue: 50,0:02:38.81,0:02:40.47,Main-207-,,0,0,0,,Eyvah!Dialogue: 50,0:02:40.47,0:02:42.77,Main-207-,,0,0,0,,Lastik-Lastik...Dialogue: 50,0:02:45.23,0:02:46.44,Main-207-,,0,0,0,,Yatıştırıcı!Dialogue: 50,0:02:46.44,0:02:47.94,Main-207-,,0,0,0,,Eline sağlık, Chopper!Dialogue: 50,0:02:49.44,0:02:53.07,Main-207-,,0,0,0,,İki gün sonra, saat tam on ikide harekât başlayacak.Dialogue: 50,0:02:53.07,0:02:55.28,Main-207-,,0,0,0,,Tüm hazırlıkları yaptın mı?Dialogue: 50,0:02:55.28,0:02:57.53,Main-207-,,0,0,0,,Evet. Her şey hazır.Dialogue: 50,0:02:58.20,0:03:02.37,Main-207-,,0,0,0,,Milyarların 150 tanesi Nanohana'da bekliyor.Dialogue: 50,0:03:02.87,0:03:09.34,Main-207-,,0,0,0,,Bay 2'yi de geri çağırdım. Anlaşılan Bay 3'ü yakalayamamış.Dialogue: 50,0:03:10.34,0:03:14.17,Main-207-,,0,0,0,,Bu akşam saat 8'de, bütün rütbeli ajanlar....Dialogue: 50,0:03:15.17,0:03:17.59,Main-207-,,0,0,0,,Spiders Kafe'de toplanacak.Dialogue: 50,0:03:20.01,0:03:22.72,Main-207-,,0,0,10,,Evet. Çok güzel.Dialogue: 50,0:03:23.18,0:03:25.73,Main-207-,,0,0,0,,Saat çoktan 5 oldu.Dialogue: 50,0:03:25.73,0:03:29.69,Main-207-,,0,0,0,,Tahminimce biz konuşurken  oraya gidiyorlardır.Dialogue: 50,0:03:47.96,0:03:50.46,Main-207-,,0,0,0,,Evet! Evet! Evet! Merry Christmas! Merry Christmas!Dialogue: 50,0:03:50.46,0:03:53.88,Main-207-,,0,0,0,,Ne uzun ve yorucu bir yolculuktu! Belim koptu!Dialogue: 50,0:03:53.88,0:03:56.17,Main-207-,,0,0,0,,Hepsi senin suçun, Bay 4!Dialogue: 50,0:03:56.17,0:03:58.38,Main-207-,,0,0,0,,Yavaşlığın sırtımı ağrıtırıyor!Dialogue: 50,0:03:58.84,0:04:03.85,Main-207-,,0,0,0,,B-Ben...Dialogue: 50,0:04:03.85,0:04:05.18,Main-207-,,0,0,0,,özür...Dialogue: 50,0:04:03.85,0:04:05.18,Secondary-207-,,0,0,0,,Evet! Evet! Evet! Evet!Dialogue: 50,0:04:05.18,0:04:07.60,Main-207-,,0,0,0,,İşler nasıl gidiyor, Paula? Bugün hiç müşteri yok!Dialogue: 50,0:04:07.60,0:04:10.86,Main-207-,,0,0,0,,Bu dükkan bomboş! Dükkan bomboş! Boşkan! B-O-Ş-K-A-N!Dialogue: 50,0:04:11.36,0:04:15.11,Main-207-,,0,0,0,,Sizi yeniden görmek güzel.  Hoş geldiniz, Bayan Merry Christmas,Dialogue: 50,0:04:15.11,0:04:16.32,Main-207-,,0,0,0,,ve Bay 4.Dialogue: 50,0:04:16.94,0:04:19.57,Main-207-,,0,0,0,,Bugün burası tamamen size ait.Dialogue: 50,0:04:19.57,0:04:22.45,Main-207-,,0,0,0,,Size portakallı pekoe çayı...Dialogue: 50,0:04:22.45,0:04:26.08,Main-207-,,0,0,0,,Bay 4, size de elma çayı, değil mi?Dialogue: 50,0:04:26.08,0:04:29.33,Main-207-,,0,0,0,,Ve ılık olsun! Kaynarken hemen dikemiyorum!Dialogue: 50,0:04:29.33,0:04:33.04,Main-207-,,0,0,0,,Hemen yap! Şimdi! Hemen şimdi! Derhal!Dialogue: 50,0:04:33.04,0:04:35.80,Main-207-,,0,0,0,,Her zamanki gibi hayat dolusunuz. İşler nasıl?Dialogue: 50,0:04:35.80,0:04:39.05,Main-207-,,0,0,0,,Bizde başarısızlık ölüm demektir. Elbette işler çok iyi.Dialogue: 50,0:04:39.05,0:04:42.05,Main-207-,,0,0,0,,Salak! Salak! Salaaak!Dialogue: 50,0:04:42.80,0:04:45.64,Main-207-,,0,0,0,,Haklısınız. Özür dilerim.Dialogue: 50,0:04:46.02,0:04:47.93,Main-207-,,0,0,0,,♪ Un, deux... ♪Dialogue: 50,0:04:46.93,0:04:47.93,Secondary-207-,,0,0,0,,♪ ...ourrois! ♪Dialogue: 50,0:04:47.93,0:04:49.48,Main-207-,,0,0,0,,♪ Un, deux... ♪Dialogue: 50,0:04:48.81,0:04:49.48,Secondary-207-,,0,0,0,,♪ ...korrois! ♪Dialogue: 50,0:04:49.85,0:04:55.15,Main-207-,,0,0,0,,Ne oluyor böyle?! Buradaki şarkıların sözleri çok tuhaf!Dialogue: 50,0:04:55.15,0:04:59.99,Main-207-,,0,0,0,,Sözler derken? Şu an sonat çalıyor.Dialogue: 50,0:04:59.99,0:05:01.78,Main-207-,,0,0,0,,Sözleri olmaz.Dialogue: 50,0:05:02.24,0:05:04.74,Main-207-,,0,0,0,,♪ Un, deux... ♪Dialogue: 50,0:05:03.41,0:05:04.74,Secondary-207-,,0,0,0,,♪ ...ourrois! ♪Dialogue: 50,0:05:04.74,0:05:05.83,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:05:05.83,0:05:06.70,Main-207-,,0,0,0,,♪ Un, deux... ♪Dialogue: 50,0:05:06.70,0:05:07.87,Main-207-,,0,0,0,,♪ ...korrois! ♪Dialogue: 50,0:05:07.87,0:05:09.66,Main-207-,,0,0,0,,♪ Şimdi ayak parmaklarını kıvır! ♪Dialogue: 50,0:05:09.66,0:05:11.71,Main-207-,,0,0,0,,♪ Un, deux... ♪Dialogue: 50,0:05:10.79,0:05:11.71,Secondary-207-,,0,0,0,,♪ ...korrois! ♪Dialogue: 50,0:05:11.71,0:05:13.54,Main-207-,,0,0,0,,♪ Tırnaklarınla devam et! ♪Dialogue: 50,0:05:13.54,0:05:15.34,Main-207-,,0,0,0,,♪ Un, deux... ♪Dialogue: 50,0:05:14.29,0:05:15.34,Secondary-207-,,0,0,0,,♪ ...ourrois! ♪Dialogue: 50,0:05:15.34,0:05:18.63,Main-207-,,0,0,0,,♪ Tıpkı... doğduğun zamanki gibi...♪Dialogue: 50,0:05:19.42,0:05:22.47,Main-207-,,0,0,0,,♪ Öğren! Öğren! ♪Dialogue: 50,0:05:23.85,0:05:26.39,Main-207-,,0,0,0,,♪ Aşk ve... ♪Dialogue: 50,0:05:26.93,0:05:28.85,Main-207-,,0,0,0,,♪ maskara! ♪Dialogue: 50,0:05:28.85,0:05:33.35,Main-207-,,0,0,0,,♪ Maskaralı burun kanaması! ♪Dialogue: 50,0:05:33.35,0:05:38.32,Main-207-,,0,0,0,,– ♪ Kendimi yarattım! ♪  – ♪ Kendimi yarattım! ♪Dialogue: 50,0:05:38.32,0:05:41.20,Main-207-,,0,0,0,,♪ İşte... bu... yüzden... ♪Dialogue: 50,0:05:41.70,0:05:43.87,Main-207-,,0,0,0,,♪ Öğren! ♪Dialogue: 50,0:05:42.70,0:05:43.87,Secondary-207-,,0,0,0,,♪ Öğren! ♪Dialogue: 50,0:05:43.87,0:05:46.20,Main-207-,,0,0,0,,♪ Öğren! ♪Dialogue: 50,0:05:44.87,0:05:46.20,Secondary-207-,,0,0,0,,♪ Öğren! ♪Dialogue: 50,0:05:46.20,0:05:49.04,Main-207-,,0,0,0,,♪ Okama yolunu! ♪Dialogue: 50,0:05:49.54,0:05:51.16,Main-207-,,0,0,0,,♪ Ve... gülümse! ♪Dialogue: 50,0:05:51.16,0:05:52.62,Main-207-,,0,0,0,,♪ Oh, en büyük! ♪Dialogue: 50,0:05:52.62,0:05:54.04,Main-207-,,0,0,0,,♪ En büyük! ♪Dialogue: 50,0:05:53.46,0:05:55.46,Secondary-207-,,0,0,0,,♪ En büyük! ♪Dialogue: 50,0:05:54.04,0:05:55.46,Main-207-,,0,0,0,,♪ En büyük! ♪Dialogue: 50,0:05:56.04,0:05:59.76,Main-207-,,0,0,0,,– ♪ Okama yolu! ♪  – ♪ Okama yolu! ♪Dialogue: 50,0:05:56.04,0:05:59.76,Note-207-,,0,0,0,,Oh, come my way: Benim yolumdan gel. O-ka-ma-way: Okama yolu. Kelime oyunu var.Dialogue: 50,0:06:05.30,0:06:07.47,Main-207-,,0,0,0,,Selamlar!Dialogue: 50,0:06:07.47,0:06:10.52,Main-207-,,0,0,0,,Nasılsınız... deux?Dialogue: 50,0:06:10.52,0:06:11.77,Main-207-,,0,0,0,,Aptal olmalısın.Dialogue: 50,0:06:11.77,0:06:14.02,Main-207-,,0,0,0,,Ben aptal değilim, Paula!Dialogue: 50,0:06:14.02,0:06:17.52,Main-207-,,0,0,0,,Ama bir dansçıyım!Dialogue: 50,0:06:17.52,0:06:19.19,Main-207-,,0,0,0,,Ahtapotpa, rica edebilir miyim?Dialogue: 50,0:06:19.19,0:06:20.11,Main-207-,,0,0,0,,Ahtapotpa mı?Dialogue: 50,0:06:20.11,0:06:22.07,Main-207-,,0,0,0,,Bunun şakası yok!Dialogue: 50,0:06:22.07,0:06:24.70,Main-207-,,0,0,0,,Ahtapot parfesi. Çok belli değil mi?Dialogue: 50,0:06:26.41,0:06:28.87,Main-207-,,0,0,0,,Oh, sizler eve gidebilirsiniz.Dialogue: 50,0:06:28.87,0:06:29.58,Main-207-,,0,0,0,,– Başüstüne! – Başüstüne!Dialogue: 50,0:06:29.91,0:06:33.21,Main-207-,,0,0,0,,Sakın dans pratiklerinizi aksatmayın!Dialogue: 50,0:06:33.21,0:06:34.29,Main-207-,,0,0,0,,– Başüstüne! – Başüstüne!Dialogue: 50,0:06:34.29,0:06:36.25,Main-207-,,0,0,0,,♪ Un, deux! Un, deux! ♪Dialogue: 50,0:06:36.25,0:06:39.75,Main-207-,,0,0,0,,Ha? Şişko ve kocakarı burada ne yapıyor?Dialogue: 50,0:06:39.75,0:06:41.05,Main-207-,,0,0,0,,Kapa' çeneni!Dialogue: 50,0:06:41.05,0:06:44.01,Main-207-,,0,0,0,,Konuştukça sırtımı ağrıtıyorsun!Dialogue: 50,0:06:44.01,0:06:45.93,Main-207-,,0,0,0,,Aa, doğru, doğru, doğru!Dialogue: 50,0:06:45.93,0:06:51.22,Main-207-,,0,0,0,,Duyduğuma göre Bay 1 ve partneri de burada olacak.Dialogue: 50,0:06:51.22,0:06:54.77,Main-207-,,0,0,0,,Nedense onlarla hiç tanışmadım.Dialogue: 50,0:06:54.77,0:06:56.81,Main-207-,,0,0,0,,Bu bekleyiş beni öldürecek!Dialogue: 50,0:07:01.98,0:07:05.28,Main-207-,,0,0,0,,Bunu sana vermek istiyordum. Al.Dialogue: 50,0:07:08.45,0:07:11.29,Main-207-,,0,0,0,,İyi sakla. Daima.Dialogue: 50,0:07:11.83,0:07:13.87,Main-207-,,0,0,0,,Ne bu? Kağıt sadece.Dialogue: 50,0:07:13.87,0:07:19.34,Main-207-,,0,0,0,,Öyle ama, o kağıt bir gün bizi tekrar buluşturacak.Dialogue: 50,0:07:20.46,0:07:21.84,Main-207-,,0,0,0,,İstemiyor musun?Dialogue: 50,0:07:22.38,0:07:23.80,Main-207-,,0,0,0,,Hayır, istiyorum!Dialogue: 50,0:07:23.80,0:07:26.43,Main-207-,,0,0,0,,Abiler, küçük kardeşleri için...Dialogue: 50,0:07:27.93,0:07:30.14,Main-207-,,0,0,0,,endişelenmeden duramaz.Dialogue: 50,0:07:30.60,0:07:34.18,Main-207-,,0,0,0,,Eminim başınızı bayağı ağrıtmıştır.Dialogue: 50,0:07:34.18,0:07:35.94,Main-207-,,0,0,0,,Benim için ona göz kulak olun.Dialogue: 50,0:07:37.31,0:07:39.90,Main-207-,,0,0,0,,Ha? Şimdiden gidiyor musun?Dialogue: 50,0:07:43.03,0:07:47.70,Main-207-,,0,0,0,,Luffy! Korsan dünyasının zirvesinde görüşürüz!Dialogue: 50,0:08:09.68,0:08:12.43,Main-207-,,0,0,0,,Baksana, Luffy...Dialogue: 50,0:08:11.68,0:08:12.43,Secondary-207-,,0,0,0,,Evet?Dialogue: 50,0:08:12.43,0:08:14.31,Main-207-,,0,0,0,,Abin sana ne verdi?Dialogue: 50,0:08:14.31,0:08:15.89,Main-207-,,0,0,0,,Bilmiyorum ki.Dialogue: 50,0:08:16.64,0:08:18.31,Main-207-,,0,0,0,,Kağıt sadece.Dialogue: 50,0:08:18.31,0:08:19.69,Main-207-,,0,0,0,,Sadece kağıt mı?Dialogue: 50,0:08:19.69,0:08:20.90,Main-207-,,0,0,0,,Bakayım bi'.Dialogue: 50,0:08:22.40,0:08:26.86,Main-207-,,0,0,0,,Sadece kağıt gerçekten. Not veya benzeri bir şey de değil.Dialogue: 50,0:08:29.07,0:08:30.49,Main-207-,,0,0,0,,Bunun anlamı ne?Dialogue: 50,0:08:32.12,0:08:34.41,Main-207-,,0,0,0,,Ben de emin değilim ama...Dialogue: 50,0:08:38.41,0:08:39.37,Main-207-,,0,0,0,,Hey! Tükür onu!Dialogue: 50,0:08:40.75,0:08:41.75,Main-207-,,0,0,0,,Cidden...Dialogue: 50,0:08:41.75,0:08:43.38,Main-207-,,0,0,0,,Luffy, şapkanı versene.Dialogue: 50,0:08:43.38,0:08:44.34,Main-207-,,0,0,0,,Ha? Bunu mu?Dialogue: 50,0:08:44.34,0:08:48.26,Main-207-,,0,0,0,,Bu kadar mühimse, şapkanın bandına dikeyim.Dialogue: 50,0:08:48.26,0:08:50.34,Main-207-,,0,0,0,,Oh! Harika! Sağlam dik!Dialogue: 50,0:08:50.34,0:08:51.72,Main-207-,,0,0,0,,Tabii tabii.Dialogue: 50,0:08:53.97,0:08:55.31,Main-207-,,0,0,0,,Bitti, hazır.Dialogue: 50,0:08:56.27,0:08:57.27,Main-207-,,0,0,0,,Buyur!Dialogue: 50,0:08:57.27,0:09:00.23,Main-207-,,0,0,0,,Teşekkürler! Artık kafam rahat!Dialogue: 50,0:09:00.23,0:09:03.94,Main-207-,,0,0,0,,Hiçbir şey yazmıyor üstünde. Saklamanın ne anlamı var?Dialogue: 50,0:09:04.57,0:09:08.36,Main-207-,,0,0,0,,Ace sakla dedi, ben de saklıyorum!Dialogue: 50,0:09:08.82,0:09:11.36,Main-207-,,0,0,0,,Umarım üçgüdülerin seni yanıltmaz.Dialogue: 50,0:09:11.36,0:09:13.24,Main-207-,,0,0,0,,Sorun değil! Genelde yanıltmazlar!Dialogue: 50,0:09:13.24,0:09:18.08,Main-207-,,0,0,0,,Pek emin olamadım ama...Dialogue: 50,0:09:14.83,0:09:18.08,Secondary-207-,,0,0,0,,Birisi taşısın beni...Dialogue: 50,0:09:18.45,0:09:23.29,Main-207-,,0,0,0,,Ah! Gece... derinleşiyor!Dialogue: 50,0:09:24.21,0:09:26.71,Main-207-,,0,0,0,,Belirlenen saat sekiz, yaklaşıyor.Dialogue: 50,0:09:36.39,0:09:38.43,Main-207-,,0,0,0,,Of, sıkıldım!Dialogue: 50,0:09:40.89,0:09:43.40,Main-207-,,0,0,0,,O kadar sıkıldım ki dönüyorum!Dialogue: 50,0:09:44.06,0:09:46.65,Main-207-,,0,0,0,,Evet, döneceğim. Sadece döneceğim.Dialogue: 50,0:09:46.65,0:09:48.36,Main-207-,,0,0,0,,Kes şunu, başımı döndürdün!Dialogue: 50,0:09:48.36,0:09:52.15,Main-207-,,0,0,0,,Derdin ne yaşlı cadı?! Beni mi sınıyorsun?!Dialogue: 50,0:09:52.15,0:09:53.74,Main-207-,,0,0,0,,Hiç sormayacaksın sandım!Dialogue: 50,0:09:54.20,0:09:57.70,Main-207-,,0,0,0,,Hadi ama! İkiniz sakinleşecek misiniz?Dialogue: 50,0:10:09.26,0:10:11.92,Main-207-,,0,0,0,,D-Dur bir dakika! Ne oldu size?!Dialogue: 50,0:10:11.92,0:10:13.97,Main-207-,,0,0,0,,Neden buraya pat diye geri döndün?Dialogue: 50,0:10:13.97,0:10:15.72,Main-207-,,0,0,0,,H-Hayır... B-Ben yapmadım...Dialogue: 50,0:10:17.18,0:10:20.56,Main-207-,,0,0,0,,Oh. Siz tanışıyor muydunuz?Dialogue: 50,0:10:23.06,0:10:26.61,Main-207-,,0,0,0,,Çölde şüpheli davranışlar sergiliyorlardı.Dialogue: 50,0:10:26.61,0:10:29.57,Main-207-,,0,0,0,,Endişelenme, öldüklerini sanmıyorum.Dialogue: 50,0:10:29.57,0:10:33.03,Main-207-,,0,0,0,,Onlarla bayağı yakın gibisin,Dialogue: 50,0:10:33.03,0:10:35.49,Main-207-,,0,0,0,,böyle bağlar, yıkımla sonlanır.Dialogue: 50,0:10:35.49,0:10:37.99,Main-207-,,0,0,0,,Onlar benim adamlarım!Dialogue: 50,0:10:37.99,0:10:39.87,Main-207-,,0,0,0,,Yapma, Bay 2!Dialogue: 50,0:10:42.41,0:10:45.21,Main-207-,,0,0,0,,Un, Deux, Korrois!Dialogue: 50,0:10:46.47,0:10:49.80,Main-207-,,0,0,0,,Un, Deux, Ourrois!Dialogue: 50,0:10:53.26,0:10:54.88,Main-207-,,0,0,0,,Cesur Dönüşüm!Dialogue: 50,0:10:54.88,0:10:56.22,Main-207-,,0,0,0,,Un! Deux!Dialogue: 50,0:11:04.02,0:11:06.02,Main-207-,,0,0,0,,Nasıl olur...?!Dialogue: 50,0:11:06.02,0:11:07.56,Main-207-,,0,0,0,,Duvarın içinden geçti!Dialogue: 50,0:11:07.56,0:11:09.73,Main-207-,,0,0,0,,Hayır! Duvarı parçaladı?!Dialogue: 50,0:11:12.48,0:11:14.32,Main-207-,,0,0,0,,Anlaşılan ölmek istiyorsun.Dialogue: 50,0:11:15.65,0:11:18.78,Main-207-,,0,0,0,,Dur! Bu kadarı yeterli, Bay 1!Dialogue: 50,0:11:18.78,0:11:23.62,Main-207-,,0,0,0,,Beni durdurma, Bayan Doublefinger. Onu öldüreceğim.Dialogue: 50,0:11:24.25,0:11:27.29,Main-207-,,0,0,0,,Dur! Bırak beni, dombili!Dialogue: 50,0:11:27.29,0:11:30.21,Main-207-,,0,0,0,,Bay 2! Senin de sakinleşmen gerekiyor.Dialogue: 50,0:11:30.21,0:11:35.34,Main-207-,,0,0,0,,Saat 8 oldu. Davet edilen bütün ajanlar burada.Dialogue: 50,0:11:36.09,0:11:40.60,Main-207-,,0,0,0,,Ve emirleri içeren bir mektup, Spiders Kafe'ye ulaştı.Dialogue: 50,0:11:43.22,0:11:47.52,Main-207-,,0,0,0,,Rotamızın Hayaller Şehri, Rainbase olduğu yazıyor.Dialogue: 50,0:11:47.52,0:11:52.61,Main-207-,,0,0,0,,Yüzünü hiç görmediğimiz, patron dediğimiz adam...Dialogue: 50,0:11:57.70,0:11:59.41,Main-207-,,0,0,0,,bizi orada bekliyor.Dialogue: 50,0:12:07.16,0:12:11.42,Main-207-,,0,0,0,,Şu anda Rainbase'e doğru yola çıkmış olmalılar.Dialogue: 50,0:12:14.21,0:12:16.42,Main-207-,,0,0,10,,Bunchi'yi onları alması için gönderdim.Dialogue: 50,0:12:16.42,0:12:18.88,Main-207-,,0,0,10,,Bu akşam, varmalarını bekliyorum.Dialogue: 50,0:12:23.85,0:12:28.35,Main-207-,,0,0,0,,Bayan Doublefinger olduğundan bize hiç bahsetmedin...Dialogue: 50,0:12:30.35,0:12:34.23,Main-207-,,0,0,0,,Değilim dediğimi de hatırlamıyorum.Dialogue: 50,0:12:34.90,0:12:39.20,Main-207-,,0,0,0,,Nanohana'da kaybettiğimiz milyarların yerini doldurdun mu?Dialogue: 50,0:12:40.03,0:12:42.45,Main-207-,,0,0,0,,Yerlerini çoktan doldurdum.Dialogue: 50,0:12:43.08,0:12:48.91,Main-207-,,0,0,0,,Haberci kertenkeleleri görevlendirdim. Yeni milyarlar ile iletişime geçecekler.Dialogue: 50,0:12:55.46,0:12:59.01,Main-207-,,0,0,0,,Anladım. Her şey tıkırında ilerliyor.Dialogue: 50,0:13:03.64,0:13:06.39,Main-207-,,0,0,0,,Yukarıda! Işık görüyorum!Dialogue: 50,0:13:06.39,0:13:08.52,Main-207-,,0,0,0,,Yuba'ya mı vardık?!Dialogue: 50,0:13:08.52,0:13:11.19,Main-207-,,0,0,0,,Kumdan göremiyorum ki!Dialogue: 50,0:13:12.02,0:13:14.15,Main-207-,,0,0,0,,Bu ses... duyuyor musunuz?Dialogue: 50,0:13:16.28,0:13:17.90,Main-207-,,0,0,0,,Bir şeyler yanlış!Dialogue: 50,0:13:25.37,0:13:26.74,Main-207-,,0,0,0,,Kum fırtınası!Dialogue: 50,0:13:30.04,0:13:33.08,Main-207-,,0,0,0,,Yuba Şehri, kum fırtınasına yakalanmış!Dialogue: 50,0:13:46.22,0:13:47.68,Main-207-,,0,0,0,,Olamaz...Dialogue: 50,0:13:50.81,0:13:52.98,Main-207-,,0,0,10,,Berbat gözüküyor.Dialogue: 50,0:13:52.98,0:13:55.90,Main-207-,,0,0,10,,Erumalu şehrinden farkı kalmamış!Dialogue: 50,0:13:57.90,0:13:59.15,Main-207-,,0,0,0,,Su nerede?!Dialogue: 50,0:13:59.78,0:14:02.61,Main-207-,,0,0,0,,Burası vaha şehri değil miydi, Vivi-chan?Dialogue: 50,0:14:03.11,0:14:05.37,Main-207-,,0,0,0,,Kum zemini yükseltmiş!Dialogue: 50,0:14:06.12,0:14:08.58,Main-207-,,0,0,0,,Vaha tamamen yutulmuş!Dialogue: 50,0:14:13.92,0:14:16.04,Main-207-,,0,0,0,,Sizler gezgin misiniz?Dialogue: 50,0:14:16.96,0:14:21.09,Main-207-,,0,0,0,,Çöldeki yolculuğunuz...  sizleri yormuş olmalı.Dialogue: 50,0:14:22.59,0:14:27.05,Main-207-,,0,0,0,,Kusura bakmayın. Bu şehir biraz kurak.Dialogue: 50,0:14:28.31,0:14:31.43,Main-207-,,0,0,0,,Ama ihtiyacınız varsa burada dinlenebilirsiniz.Dialogue: 50,0:14:34.31,0:14:37.02,Main-207-,,0,0,0,,Burada bolca han var.Dialogue: 50,0:14:37.02,0:14:40.82,Main-207-,,0,0,0,,Ne de olsa misafirperverliğimizle ünlüyüzdür.Dialogue: 50,0:14:42.19,0:14:46.49,Main-207-,,0,0,0,,Aslında, İsyan Ordusu'nun burada olduğunu duyduğumuz için geldik.Dialogue: 50,0:14:47.07,0:14:49.41,Main-207-,,0,0,0,,İsyan Ordusu'yla ne işiniz var?!Dialogue: 50,0:14:49.41,0:14:55.08,Main-207-,,0,0,0,,Embesiller! Onlara katılmaya niyetiniz yok, değil mi?!Dialogue: 50,0:14:59.09,0:15:03.72,Main-207-,,0,0,0,,O aptalları arıyorsanız çoktan şehri terk ettiler.Dialogue: 50,0:15:03.72,0:15:06.76,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:15:06.76,0:15:08.22,Main-207-,,0,0,0,,Olamaz!Dialogue: 50,0:15:09.10,0:15:15.98,Main-207-,,0,0,0,,Bu, Yuba'nın maruz kaldığı ilk kum fırtınası değildi.Dialogue: 50,0:15:15.98,0:15:20.65,Main-207-,,0,0,0,,Üç yıllık kuraklığın ardından geriye sadece kum kaldı,Dialogue: 50,0:15:20.65,0:15:25.32,Main-207-,,0,0,0,,ve o zamandan beri burası kum fırtınalarının uğrak yeri oldu.Dialogue: 50,0:15:25.32,0:15:32.58,Main-207-,,0,0,0,,Vaha zamanla kumlarla kaplandı ve geriye gördüğünüz manzara kaldı.Dialogue: 50,0:15:32.58,0:15:36.42,Main-207-,,0,0,0,,Şehrin kaynakları da kesilince...Dialogue: 50,0:15:36.42,0:15:40.00,Main-207-,,0,0,0,,İsyan Ordusu'nun mücadelesi artık sonuna yaklaştı.Dialogue: 50,0:15:40.00,0:15:45.05,Main-207-,,0,0,0,,O yüzden karargâhı Katorea'ya taşıdılar.Dialogue: 50,0:15:45.80,0:15:47.26,Main-207-,,0,0,0,,Katorea mı?!Dialogue: 50,0:15:47.26,0:15:50.93,Main-207-,,0,0,0,,Orası neresi, Vivi?! Yakınlarda mı?!Dialogue: 50,0:15:50.93,0:15:53.47,Main-207-,,0,0,0,,Nanohana’ya yakın bir vaha.Dialogue: 50,0:15:54.10,0:15:57.52,Main-207-,,0,0,0,,Bu kadar yolu boş yere mi geldik?!Dialogue: 50,0:15:58.15,0:15:59.40,Main-207-,,0,0,0,,Vivi?Dialogue: 50,0:15:59.40,0:16:00.73,Main-207-,,0,0,0,,''Vivi'' mi dediniz?Dialogue: 50,0:16:01.19,0:16:05.40,Main-207-,,0,0,0,,Dur, ihtiyar! Vivi prenses değil ki!Dialogue: 50,0:16:03.73,0:16:05.40,Secondary-207-,,0,0,0,,Sessiz ol, aptal!Dialogue: 50,0:16:07.15,0:16:09.99,Main-207-,,0,0,0,,Vivi-chan, sen misin? Sensin değil mi?Dialogue: 50,0:16:11.12,0:16:15.16,Main-207-,,0,0,0,,Hayattasın! Şükürler olsun!Dialogue: 50,0:16:15.55,0:16:18.67,Main-207-,,0,0,0,,Benim! Tanıyamadın mı beni?Dialogue: 50,0:16:19.42,0:16:23.42,Main-207-,,0,0,0,,Senin suçun değil. Biraz kilo verdim...Dialogue: 50,0:16:24.00,0:16:25.76,Main-207-,,0,0,0,,Toto amca...?Dialogue: 50,0:16:28.63,0:16:30.09,Main-207-,,0,0,0,,Evet!Dialogue: 50,0:16:34.47,0:16:35.89,Main-207-,,0,0,0,,Olamaz...Dialogue: 50,0:16:41.77,0:16:45.28,Flashbacks-207-,,0,0,0,,Elveda, Vivi-chan. Şimdilik veda vakti.Dialogue: 50,0:16:45.78,0:16:48.86,Flashbacks-207-,,0,0,0,,Şehir bir şeye benzemeye başladığında ziyarete gel.Dialogue: 50,0:16:48.86,0:16:51.20,Flashbacks-207-,,0,0,0,,Olur, Toto amca!Dialogue: 50,0:16:53.37,0:16:57.41,Flashbacks-207-,,0,0,0,,Yuba, bu ülkenin bereketini artıracak.Dialogue: 50,0:17:00.58,0:17:01.67,Flashbacks-207-,,0,0,0,,Kesinlikle.Dialogue: 50,0:17:11.39,0:17:13.60,Main-207-,,0,0,0,,Toto amca mı?Dialogue: 50,0:17:13.60,0:17:19.43,Main-207-,,0,0,0,,Kral'a olan inancımı hiç kaybetmedim, Vivi-chan!Dialogue: 50,0:17:22.31,0:17:26.61,Main-207-,,0,0,0,,O, bu ülkeye ihanet edecek birisi değil.Dialogue: 50,0:17:26.61,0:17:28.32,Main-207-,,0,0,0,,Değil mi?!Dialogue: 50,0:17:58.14,0:18:00.85,Main-207-,,0,0,0,,Bu başkaldırı, aptallık!Dialogue: 50,0:18:02.39,0:18:04.90,Main-207-,,0,0,0,,Hepsi aptal...Dialogue: 50,0:18:05.48,0:18:09.57,Flashbacks-207-,,0,0,0,,Vivi! Büyü ve iyi bir prenses ol!Dialogue: 50,0:18:45.06,0:18:48.11,Main-207-,,0,0,0,,Köyümüz... Köyümüz kurudu!Dialogue: 50,0:18:48.11,0:18:50.44,Main-207-,,0,0,0,,Bize neden yardım etmedin?!Dialogue: 50,0:18:51.11,0:18:54.32,Main-207-,,0,0,0,,Ama hava olayları, tanrıların iradesine bağlıdır.Dialogue: 50,0:18:54.32,0:18:59.74,Main-207-,,0,0,0,,Kral olabilirim ama sözüm doğanın kudretine geçmiyor.Dialogue: 50,0:19:00.41,0:19:04.08,Main-207-,,0,0,0,,Ama babam, kral her şeyi yapabilir demişti!Dialogue: 50,0:19:04.46,0:19:08.46,Main-207-,,0,0,0,,Ben ancak insanın gücünün yettiğini yapabilirim—Dialogue: 50,0:19:08.46,0:19:11.55,Main-207-,,0,0,0,,Majesteleri! Çocuğun babası saraya geldi.Dialogue: 50,0:19:11.55,0:19:14.34,Main-207-,,0,0,0,,En derin özürlerimi sunarım, Majesteleri!Dialogue: 50,0:19:14.34,0:19:16.34,Main-207-,,0,0,0,,Şımarık oğlumu affedin!Dialogue: 50,0:19:16.34,0:19:18.35,Main-207-,,0,0,0,,Bütün sorumluluk bana ait!Dialogue: 50,0:19:18.97,0:19:23.31,Main-207-,,0,0,0,,Onu değil, beni cezalandırın! Daha iyisini yapacağım! Lütfen, yalvarırım!Dialogue: 50,0:19:23.31,0:19:26.77,Main-207-,,0,0,0,,Bu kadar aptal olmanı aklım almıyor… Çok aptalsın…!Dialogue: 50,0:19:26.77,0:19:31.23,Main-207-,,0,0,0,,Aptalsın! Aptalsın! Aptalsın! Aptalsın!Dialogue: 50,0:19:31.23,0:19:34.44,Main-207-,,0,0,0,,Toto'ydu, değil mi?Dialogue: 50,0:19:34.44,0:19:35.49,Main-207-,,0,0,0,,Evet!Dialogue: 50,0:19:35.95,0:19:41.45,Main-207-,,0,0,0,,Krallık, kuraklıktan etkilenen köylülere destek sağlayacak.Dialogue: 50,0:19:41.45,0:19:46.92,Main-207-,,0,0,0,,Geleceğini planlayabilmen için sana Alubarna’da yaşama hakkı tanıyorum!Dialogue: 50,0:19:46.92,0:19:52.59,Main-207-,,0,0,0,,Oh, çok düşüncelisiniz, Majesteleri! Teşekkür ederim! Teşekkür ederim!Dialogue: 50,0:19:53.63,0:19:57.30,Main-207-,,0,0,0,,Boşversene! Sanki köylülerin duygularını anlayabilirmişsin gibi!Dialogue: 50,0:19:57.97,0:20:00.30,Main-207-,,0,0,0,,Bekle, Koza! Geri dön!Dialogue: 50,0:20:02.56,0:20:03.56,Main-207-,,0,0,0,,Toto.Dialogue: 50,0:20:03.56,0:20:04.68,Main-207-,,0,0,0,,Evet, efendim!Dialogue: 50,0:20:05.93,0:20:10.65,Main-207-,,0,0,0,,O iyi bir çocuk. Köylülerin hislerini paylaştı.Dialogue: 50,0:20:10.65,0:20:16.61,Main-207-,,0,0,0,,Halkın iyiliği için buraya fırtına gibi daldı.Dialogue: 50,0:20:20.62,0:20:22.03,Main-207-,,0,0,0,,Ağlak bebe.Dialogue: 50,0:20:25.54,0:20:27.25,Main-207-,,0,0,0,,Bana mı dedin, seni bücür?Dialogue: 50,0:20:28.46,0:20:29.58,Main-207-,,0,0,0,,Cobra-sama.Dialogue: 50,0:20:30.08,0:20:31.38,Main-207-,,0,0,0,,Ne oldu, Igaram?Dialogue: 50,0:20:31.38,0:20:32.54,Main-207-,,0,0,0,,Affınıza sığınarak,Dialogue: 50,0:20:33.04,0:20:37.47,Main-207-,,0,0,0,,krallığın herkesi destekleyecek maddi gücü bulunmuyor.Dialogue: 50,0:20:37.47,0:20:38.88,Main-207-,,0,0,0,,Aptal!Dialogue: 50,0:20:38.88,0:20:43.10,Main-207-,,0,0,0,,O hâlde kendi masraflarımızdan ve gereksiz harcamalardan kısalım!Dialogue: 50,0:20:43.10,0:20:45.85,Main-207-,,0,0,0,,Anlaşıldı. Nasıl isterseniz.Dialogue: 50,0:20:46.64,0:20:49.77,Main-207-,,0,0,0,,Majesteleri, çok fena! Vivi-sama!Dialogue: 50,0:20:52.98,0:20:55.28,Main-207-,,0,0,0,,Kavga ettim. Kaybettim.Dialogue: 50,0:20:55.28,0:20:57.61,Main-207-,,0,0,0,,Vivi!Dialogue: 50,0:20:56.28,0:20:57.61,Secondary-207-,,0,0,0,,Vivi-sama!Dialogue: 50,0:20:57.61,0:21:00.95,Main-207-,,0,0,0,,O küçük serseri! Bir prensese nasıl zarar verebilir?!Dialogue: 50,0:21:00.95,0:21:04.58,Main-207-,,0,0,0,,Mahvedeceğim onu! Selasını okutsun!Dialogue: 50,0:21:02.70,0:21:04.58,Secondary-207-,,0,0,0,, Bekle! Bekle! Igaram!Dialogue: 50,0:21:04.58,0:21:07.54,Main-207-,,0,0,0,,En derin özürlerimle!Dialogue: 50,0:21:07.54,0:21:10.25,Main-207-,,0,0,0,,Bedelini canımla ödeyeceğim!Dialogue: 50,0:21:10.25,0:21:13.88,Main-207-,,0,0,0,,Yeter ikinize de be!Dialogue: 50,0:21:16.67,0:21:20.63,Main-207-,,0,0,0,,Aptallar! Çocuk kavgası bu!Dialogue: 50,0:21:28.77,0:21:29.98,Main-207-,,0,0,0,,Hesaplaşacaklar!Dialogue: 50,0:21:29.98,0:21:32.85,Main-207-,,0,0,0,,Buyrun, gelin!Dialogue: 50,0:21:29.98,0:21:32.85,Secondary-207-,,0,0,0,,Dövüş! Dövüş!Dialogue: 50,0:21:33.98,0:21:35.98,Main-207-,,0,0,0,,Prenses diye acıma!Dialogue: 50,0:21:35.98,0:21:38.74,Main-207-,,0,0,0,,O ukala soyluyu haddini bildir!Dialogue: 50,0:21:38.74,0:21:41.11,Main-207-,,0,0,0,,Başarabilirsin, Vivi-chan!Dialogue: 50,0:21:41.11,0:21:44.62,Main-207-,,0,0,0,,Hey, siz! Koza liderimiz, biliyorsunuz değil mi?!Dialogue: 50,0:21:48.33,0:21:52.25,Main-207-,,0,0,0,,Kazanırsam, liderliği ben devralırım!Dialogue: 50,0:21:53.00,0:21:55.34,Main-207-,,0,0,0,,Asla sana kaybetmem, cüce!Dialogue: 50,0:21:55.79,0:21:58.55,Main-207-,,0,0,0,,Köyümde daima lider ben oldum.Dialogue: 50,0:22:00.38,0:22:01.88,Main-207-,,0,0,0,,Başlıyoruz!Dialogue: 50,0:22:17.86,0:22:19.32,Main-207-,,0,0,0,,Dinleyin, millet!Dialogue: 50,0:22:19.73,0:22:23.61,Main-207-,,0,0,0,,Bugün itibarıyla Vivi, Kum-Kum Klanı'nın yardımcı lideri!Dialogue: 50,0:22:23.61,0:22:25.32,Main-207-,,0,0,0,,Bununla sorunu olan var mı?!Dialogue: 50,0:22:25.32,0:22:27.83,Main-207-,,0,0,0,,– Hayır! – Hayır!Dialogue: 50,0:22:29.04,0:22:30.66,Main-207-,,0,0,0,,Bak, Igaram.Dialogue: 50,0:22:31.29,0:22:33.67,Main-207-,,0,0,0,,Vivi, arkadaş edindi.Dialogue: 50,0:22:34.29,0:22:35.25,Main-207-,,0,0,0,,Evet.Dialogue: 50,0:22:35.25,0:22:39.88,Main-207-,,0,0,0,,Eğer bir gün Alabasta'yı omuzlarında taşıyacaksa,Dialogue: 50,0:22:39.88,0:22:42.13,Main-207-,,0,0,0,,arkadaşlık pek mühim olacak.Dialogue: 50,0:22:48.68,0:22:49.85,Main-207-,,0,0,0,,Aha!Dialogue: 50,0:22:50.81,0:22:53.56,Main-207-,,0,0,0,,Toto amca ve Hanımefendi! Günaydın!Dialogue: 50,0:22:53.56,0:22:54.64,Main-207-,,0,0,0,,Lider nerede?Dialogue: 50,0:22:54.64,0:22:58.65,Main-207-,,0,0,0,,Oh, günaydın! Koza'yı arıyorsan çoktan çıktı!Dialogue: 50,0:22:59.11,0:23:00.98,Main-207-,,0,0,0,,Sanırım her zamanki yerinde.Dialogue: 50,0:23:00.98,0:23:02.44,Main-207-,,0,0,0,,Görüşürüz!Dialogue: 50,0:23:02.82,0:23:05.91,Main-207-,,0,0,0,,Oh, Vivi-chan! Yemeğe kalacak mısın?Dialogue: 50,0:23:05.91,0:23:08.12,Main-207-,,0,0,0,,Memnuniyetle! Teşekkürler!Dialogue: 50,0:23:09.24,0:23:11.75,Main-207-,,0,0,0,,Çok garip bir ülke burası.Dialogue: 50,0:23:11.75,0:23:16.08,Main-207-,,0,0,0,,Bir krallığın prensesi bizim gibi köylülerle takılıyor!Dialogue: 50,0:23:16.08,0:23:18.08,Main-207-,,0,0,0,,Barışın kanıtı işte bu!Dialogue: 50,0:23:19.25,0:23:21.55,Main-207-,,0,0,0,,Igaram-san, siz de  yemeğe kalacak mısınız?Dialogue: 50,0:23:21.55,0:23:24.22,Main-207-,,0,0,0,,Hayır, hayır, her şey yolunda! Prinç toplarım var!Dialogue: 50,0:23:24.22,0:23:25.43,Main-207-,,0,0,0,,İzninizle!Dialogue: 50,0:23:34.31,0:23:36.98,Main-207-,,0,0,0,,Majesteleri! Burada ne işiniz var?!Dialogue: 50,0:23:38.44,0:23:39.69,Main-207-,,0,0,0,,Efendim!Dialogue: 50,0:23:41.15,0:23:43.49,Main-207-,,0,0,0,,Yine beni mi takip ediyorsunuz?!Dialogue: 50,0:23:43.49,0:23:48.45,Main-207-,,0,0,0,,A-Ama küçük Vivi'im için endişelenmeden duramıyorum!Dialogue: 50,0:23:49.99,0:23:53.33,Main-207-,,0,0,0,,Geri dönün! Bana yük oluyorsunuz!Dialogue: 50,0:23:53.33,0:23:54.96,Main-207-,,0,0,0,,Ne dedin?!Dialogue: 50,0:23:54.96,0:23:57.79,Main-207-,,0,0,0,,Yok öyle "Ne dedin?!" falan.Dialogue: 50,0:24:11.26,0:24:13.43,Main-207-,,0,0,0,,N'aber, kız?!Dialogue: 50,0:24:13.43,0:24:16.56,Main-207-,,0,0,0,,Bir yere mi gidiyorsun? Biz götürelim.Dialogue: 50,0:24:19.35,0:24:21.61,Main-207-,,0,0,0,,Saldırın, Kum-Kum Klanı!Dialogue: 50,0:24:23.94,0:24:27.11,Main-207-,,0,0,0,,Şaka mı bu?! Kaçmıyorlar da!Dialogue: 50,0:24:27.82,0:24:28.99,Main-207-,,0,0,0,,Lider! Millet!Dialogue: 50,0:24:28.99,0:24:32.66,Main-207-,,0,0,0,,Vivi, kaç! Seni kaçırmaya gelmişler!Dialogue: 50,0:24:32.66,0:24:34.74,Main-207-,,0,0,0,,Kaç buradan, Vivi!Dialogue: 50,0:24:34.74,0:24:36.04,Main-207-,,0,0,0,,Öldürürler seni!Dialogue: 50,0:24:36.04,0:24:37.91,Main-207-,,0,0,0,,Ama... Lider!Dialogue: 50,0:24:40.50,0:24:42.21,Main-207-,,0,0,0,,Seni öldürmeyeceğiz!Dialogue: 50,0:24:42.21,0:24:46.17,Main-207-,,0,0,0,,Fidye için kullanmak istiyoruz, kaçıracağız sadece!Dialogue: 50,0:24:47.88,0:24:48.84,Main-207-,,0,0,0,,Şerefsiz!Dialogue: 50,0:24:49.84,0:24:52.68,Main-207-,,0,0,0,,Usulca gel, Prenses Vivi!Dialogue: 50,0:24:57.98,0:24:59.39,Main-207-,,0,0,0,,İzin vermem!Dialogue: 50,0:24:59.39,0:25:01.94,Main-207-,,0,0,0,,Onu son nefesinize kadar koruyun, Kum-Kum Klanı!Dialogue: 50,0:25:01.94,0:25:03.11,Main-207-,,0,0,0,,– Başüstüne! – Başüstüne!Dialogue: 0,0:02:47.98,0:02:54.95,Title-207-,,0,0,0,,İsyancıların Şehri, YubaDialogue: 1,0:02:47.98,0:02:54.95,Title-207-,,0,0,0,,İsyancıların Şehri, YubaDialogue: 0,0:03:18.68,0:03:22.72,Captions-207-,,0,0,0,,Spiders Kafe, Baroque Works Karargâhı Alabasta KrallığıDialogue: 1,0:03:18.68,0:03:22.72,Captions-207-,,0,0,0,,Spiders Kafe, Baroque Works Karargâhı Alabasta KrallığıDialogue: 2,0:03:18.68,0:03:22.72,Captions-207-,,0,0,0,,Spiders Kafe, Baroque Works Karargâhı Alabasta KrallığıDialogue: 0,0:03:53.88,0:03:58.38,Captions-207-,,0,0,0,,Bayan Merry Christmas Baroque Works'ün Rütbeli AjanıDialogue: 1,0:03:53.88,0:03:58.38,Captions-207-,,0,0,0,,Bayan Merry Christmas Baroque Works'ün Rütbeli AjanıDialogue: 2,0:03:53.88,0:03:58.38,Captions-207-,,0,0,0,,Bayan Merry Christmas Baroque Works'ün Rütbeli AjanıDialogue: 0,0:03:58.38,0:04:03.35,Captions-207-,,0,0,0,,Bay 4 Baroque Works'ün Rütbeli AjanıDialogue: 1,0:03:58.38,0:04:03.35,Captions-207-,,0,0,0,,Bay 4 Baroque Works'ün Rütbeli AjanıDialogue: 2,0:03:58.38,0:04:03.35,Captions-207-,,0,0,0,,Bay 4 Baroque Works'ün Rütbeli AjanıDialogue: 0,0:04:16.32,0:04:26.08,Captions-207-,,0,0,0,,Paula, Spiders Kafe'nin SahibiDialogue: 1,0:04:16.32,0:04:26.08,Captions-207-,,0,0,0,,Paula, Spiders Kafe'nin SahibiDialogue: 2,0:04:16.32,0:04:26.08,Captions-207-,,0,0,0,,Paula, Spiders Kafe'nin SahibiDialogue: 0,0:10:22.52,0:10:35.49,Captions-207-,,0,0,0,,Bay 1 Baroque Works'ün Rütbeli AjanıDialogue: 1,0:10:22.52,0:10:35.49,Captions-207-,,0,0,0,,Bay 1 Baroque Works'ün Rütbeli AjanıDialogue: 2,0:10:22.52,0:10:35.49,Captions-207-,,0,0,0,,Bay 1 Baroque Works'ün Rütbeli AjanıDialogue: 0,0:12:11.46,0:12:16.55,Captions-207-,,0,0,0,,Bunchi Her Arazide Gidebilen Baroque Works'ün Özel Kaplumbağa TaşıtıDialogue: 1,0:12:11.46,0:12:16.55,Captions-207-,,0,0,0,,Bunchi Her Arazide Gidebilen Baroque Works'ün Özel Kaplumbağa TaşıtıDialogue: 2,0:12:11.46,0:12:16.55,Captions-207-,,0,0,0,,Bunchi Her Arazide Gidebilen Baroque Works'ün Özel Kaplumbağa TaşıtıDialogue: 2,0:12:28.35,0:12:34.23,Captions-207-,,0,0,0,,Bayan Doublefinger Baroque Works'ün Rütbeli AjanıDialogue: 2,0:12:28.3