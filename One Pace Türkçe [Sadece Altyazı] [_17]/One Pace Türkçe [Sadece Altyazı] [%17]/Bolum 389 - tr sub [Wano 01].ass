[Script Info]Title: Default Aegisub fileScriptType: v4.00+WrapStyle: 0ScaledBorderAndShadow: yesYCbCr Matrix: TV.709PlayResX: 1920PlayResY: 1080[V4+ Styles]Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, EncodingStyle: Main-207+,Impress BT Pace,82,&H00FFFFFF,&H000000FF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,300,300,27,1Style: Flashbacks-207+,Impress BT Pace,82,&H00FFFFFF,&H00FFFFFF,&H00525252,&H78000000,0,-1,0,0,100,100,0,0,1,4.2,3.8,2,300,300,27,1Style: Title-207+,Gilroy-Bold,110,&H00FEFEFE,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,2.5,0,2,15,15,360,1Style: Credits-207+,Gilroy-Medium,55,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,105,105,1.5,0,1,3.7,0,7,15,15,15,1Style: Warning,Impress BT Pace,90,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,2,2,2,10,10,10,1Style: Captions-207+,Impress BT Pace,70,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,3,0,2,15,15,30,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:41.87,0:01:51.86,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 50,0:00:09.16,0:00:13.24,Main-207+,,0,0,2,,Usta Nekomamushi'nin denizcilik yetenekleri müthiş!Dialogue: 50,0:00:13.24,0:00:16.75,Main-207+,,0,0,0,,Korsanlar Kralı ile denize açılmış bir adama da ancak bu yakışır!Dialogue: 50,0:00:16.75,0:00:21.63,Main-207+,,0,0,0,,Bu harabede ne kadar bekleyeceğiz?Dialogue: 50,0:00:21.63,0:00:25.00,Main-207+,,0,0,0,,Usta Nekomamushi, Marco ile dönene kadar!Dialogue: 50,0:00:25.00,0:00:27.84,Main-207+,,0,0,0,,Gelecek mi acaba?Dialogue: 50,0:00:27.84,0:00:33.22,Main-207+,,0,0,0,,Marco'nun bizimle Wano'ya gelmesi güçlü bir müttefikimiz olacak demek!Dialogue: 50,0:00:35.10,0:00:39.89,Main-207+,,0,0,0,,Marco eski Beyazsakal Korsanları'nın 1. Tümen Komutanı!Dialogue: 50,0:00:39.89,0:00:41.98,Main-207+,,0,0,0,,Anka Marco diyorlar ona!Dialogue: 50,0:00:41.98,0:00:45.90,Main-207+,,0,0,0,,Ustanın arkadaşı olduğunu duyunca şaşırdım.Dialogue: 50,0:00:45.90,0:00:47.03,Main-207+,,0,0,0,,Pekâlâ!Dialogue: 50,0:00:47.90,0:00:51.32,Main-207+,,0,0,0,,Ben de onu görmeye gideceğim.Dialogue: 50,0:00:51.32,0:00:53.53,Main-207+,,0,0,0,,Hey! Bekle, bekle, bekle!Dialogue: 50,0:00:53.99,0:00:58.37,Main-207+,,0,0,0,,Usta, o korkunç-gara suratın yüzünden burada beklemeni istedi!Dialogue: 50,0:00:59.25,0:01:02.25,Main-207+,,0,0,0,,Marco gerçekten yüzümden korkacak birisi mi?Dialogue: 50,0:01:03.38,0:01:04.46,Main-207+,,0,0,0,,Bak!Dialogue: 50,0:01:05.09,0:01:09.92,Main-207+,,0,0,0,,Şelalenin arkasındaki mağaranın diğer tarafında huzurlu bir köy varmış.Dialogue: 50,0:01:09.92,0:01:13.01,Main-207+,,0,0,0,,Bizim gibi savaşçılar, onları korkutur.Dialogue: 50,0:01:13.01,0:01:13.76,Main-207+,,0,0,0,,Haklısın.Dialogue: 50,0:01:14.30,0:01:18.06,Main-207+,,0,0,0,,Gel gör ki Usta'nın yüzü benimkinden daha korkunç!Dialogue: 50,0:01:18.06,0:01:19.52,Main-207+,,0,0,0,,Hele bir de kızdığında.Dialogue: 50,0:01:19.52,0:01:21.73,Main-207+,,0,0,0,,Gülerken de sevimli oluyor!Dialogue: 50,0:01:21.73,0:01:23.10,Main-207+,,0,0,0,,Aynen!Dialogue: 50,0:01:40.33,0:01:41.00,Main-207+,,0,0,0,,İşte!Dialogue: 50,0:01:41.00,0:01:42.87,Main-207+,,0,0,0,,Hey, bekle!Dialogue: 50,0:02:04.02,0:02:04.73,Main-207+,,0,0,0,,Bitti.Dialogue: 50,0:02:05.10,0:02:06.61,Main-207+,,0,0,0,,Tedavi işi tamamdır.Dialogue: 50,0:02:06.61,0:02:07.82,Main-207+,,0,0,0,,Hareket edebilir.Dialogue: 50,0:02:08.90,0:02:11.24,Main-207+,,0,0,0,,Hareket edebilirmişsin!Dialogue: 50,0:02:11.24,0:02:12.65,Main-207+,,0,0,0,,Tama, kalkabilir misin?Dialogue: 50,0:02:18.66,0:02:19.87,Main-207+,,0,0,0,,Yavaş ol.Dialogue: 50,0:02:19.87,0:02:23.92,Main-207+,,0,0,0,,İyileştiren Alevler'imin başkaları üzerindeki etkisi sınırlı.Dialogue: 50,0:02:26.00,0:02:29.30,Main-207+,,0,0,2,,Bu tedaviyle daha hızlı iyileşecektir.Dialogue: 50,0:02:29.30,0:02:31.76,Main-207+,,0,0,2,,Yarın hoplayıp zıplayabileceksin.Dialogue: 50,0:02:35.80,0:02:38.43,Main-207+,,0,0,0,,Vay! Marco'nun büyüsü!Dialogue: 50,0:02:38.43,0:02:40.43,Main-207+,,0,0,0,,Harika değil mi, Tama?!Dialogue: 50,0:02:50.32,0:02:52.40,Main-207+,,0,0,0,,Vay! Harika!Dialogue: 50,0:02:53.03,0:02:55.61,Main-207+,,0,0,0,,İyileştin, Tama!Dialogue: 50,0:03:00.41,0:03:02.62,Main-207+,,0,0,0,,Yarın dedim! Zıplamayı kes!Dialogue: 50,0:03:04.08,0:03:05.92,Main-207+,,0,0,0,,Teşekkürler, Marco!Dialogue: 50,0:03:05.92,0:03:07.46,Main-207+,,0,0,0,,Sen bir tanesin!Dialogue: 50,0:03:14.51,0:03:16.38,Main-207+,,0,0,0,,– Marco... – Marco-san...Dialogue: 50,0:03:16.38,0:03:17.84,Main-207+,,0,0,2,,Omzum tutuldu...Dialogue: 50,0:03:17.84,0:03:19.22,Main-207+,,0,0,2,,Marco, dağda...Dialogue: 50,0:03:19.22,0:03:21.10,Main-207+,,0,0,0,,Marco, tarlamdaki sebzeler...Dialogue: 50,0:03:21.10,0:03:24.10,Main-207+,,0,0,0,,Marco, sırt ağrılarım geri döndü!Dialogue: 50,0:03:24.10,0:03:27.85,Main-207+,,0,0,0,,- Marco-chan, dizlerim... - Marco, çalışmama yardım eder misin?Dialogue: 50,0:03:27.85,0:03:30.19,Main-207+,,0,0,0,,Marco, kardeşim bana kötü davranıyor!Dialogue: 50,0:03:30.65,0:03:35.90,Main-207+,,0,0,0,,Tamam, teker teker konuşun.Dialogue: 50,0:03:53.76,0:03:56.84,Main-207+,,0,0,0,,Bu köyü Babalık inşa etti.Dialogue: 50,0:03:56.84,0:03:59.30,Main-207+,,0,0,0,,İhtiyar Beyazsakal mı?Dialogue: 50,0:03:59.30,0:04:00.89,Main-207+,,0,0,0,,Ne demek istiyorsun?Dialogue: 50,0:04:03.39,0:04:05.68,Main-207+,,0,0,0,,Çok fakir olduklarından...Dialogue: 50,0:04:05.68,0:04:10.40,Main-207+,,0,0,0,,kutsal vergiyi ödeyemiyorlar. Böyle olunca Hükûmet'e bağlı olamıyorlar.Dialogue: 50,0:04:10.40,0:04:13.19,Main-207+,,0,0,0,,Hükûmet'e bağlı olmayan ülkelerin hâli bu.Dialogue: 50,0:04:13.19,0:04:18.49,Main-207+,,0,0,0,,Korsanlar ve insan tacirleri istediklerini yapıp o adaları kanunsuz hâle getiriyorlar.Dialogue: 50,0:04:19.91,0:04:23.91,Main-207+,,0,0,0,,Ülkeler yıkılıyor ve çocuklar öksüz kalıyor.Dialogue: 50,0:04:23.91,0:04:26.91,Main-207+,,0,0,0,,Babalık da o yetimlerden birisiydi.Dialogue: 50,0:04:29.17,0:04:34.46,Main-207+,,0,0,0,,Genç yaşta denize açılmış.Dialogue: 50,0:04:39.51,0:04:42.85,Main-207+,,0,0,0,,Korsan olduktan sonra bile bu adayla ilgilendi.Dialogue: 50,0:04:43.22,0:04:48.56,Main-207+,,0,0,0,,Kimliğini gizleyerek kara para ve...Dialogue: 50,0:04:48.56,0:04:50.27,Main-207+,,0,0,0,,erzak aktardı.Dialogue: 50,0:04:51.77,0:04:56.28,Main-207+,,0,0,0,,Bir ailesi yoktu ve eski arkadaşları göçüp gitmişti ama...Dialogue: 50,0:04:56.28,0:04:58.19,Main-207+,,0,0,0,,burası onun memleketiydi.Dialogue: 50,0:05:00.91,0:05:05.74,Main-207+,,0,0,0,,Yozlaşmış dünyada temiz paradan söz edilemez!Dialogue: 50,0:05:07.87,0:05:09.37,Main-207+,,0,0,0,,Teşekkürler.Dialogue: 50,0:05:12.12,0:05:13.92,Main-207+,,0,0,0,,Zirve Savaşı'ndan sonra...Dialogue: 50,0:05:14.17,0:05:19.51,Main-207+,,0,0,0,,en azından değer verdiği şeyleri korumak istedik.Dialogue: 50,0:05:19.51,0:05:24.01,Main-207+,,0,0,0,,Kara Sakal bölgemizi istila ettiğinde, "İntikam Savaşı" başladı.Dialogue: 50,0:05:24.01,0:05:28.39,Main-207+,,0,0,0,,Ancak Babalığın gücüne sahip olduğundan Teach ile baş edemedik.Dialogue: 50,0:05:29.39,0:05:33.27,Main-207+,,0,0,0,,Her şeyi aldı.Dialogue: 50,0:05:37.98,0:05:41.20,Main-207+,,0,0,0,,O nankörün pestilini çıkarmak istemiştim.Dialogue: 50,0:05:48.87,0:05:50.33,Main-207+,,0,0,0,,Babalık...Dialogue: 50,0:05:52.79,0:05:55.96,Main-207+,,0,0,0,,çok cimriydi, ha?Dialogue: 50,0:06:04.22,0:06:06.35,Main-207+,,0,0,0,,Hep başkalarının içkilerini isterdi.Dialogue: 50,0:06:07.22,0:06:09.81,Main-207+,,0,0,0,,Asla bir şey ısmarlamazdı!Dialogue: 50,0:06:14.19,0:06:19.07,Main-207+,,0,0,0,,Neticede hazinedeki tüm payını buraya gönderirdi.Dialogue: 50,0:06:21.94,0:06:23.82,Main-207+,,0,0,0,,Bunu bilmeyen yoktu.Dialogue: 50,0:06:25.57,0:06:27.53,Main-207+,,0,0,0,,Anlıyorum.Dialogue: 50,0:06:28.66,0:06:34.58,Main-207+,,0,0,0,,Burası ihtiyardan kalma son yadigâr, ha?Dialogue: 50,0:06:35.37,0:06:36.54,Main-207+,,0,0,0,,Evet.Dialogue: 50,0:06:39.59,0:06:40.59,Main-207+,,0,0,0,,Kızıl Saç da...Dialogue: 50,0:06:41.71,0:06:44.47,Main-207+,,0,0,0,,mezarını yakın bir yere yaptı.Dialogue: 50,0:06:46.64,0:06:48.26,Main-207+,,0,0,0,,Bu arada...Dialogue: 50,0:06:48.68,0:06:53.68,Main-207+,,0,0,0,,Babalığın oğlu olduğunu söyleyip onunla alakası olanlara saldıran...Dialogue: 50,0:06:53.68,0:06:56.15,Main-207+,,0,0,0,,Weevil adında bir Shichibukai var.Dialogue: 50,0:06:56.52,0:06:58.61,Main-207+,,0,0,0,,Doğru mu bu?Dialogue: 50,0:06:58.61,0:07:01.90,Main-207+,,0,0,0,,Babalığın kadınlarla olan mazisi hakkında bir yorum yapamam,Dialogue: 50,0:07:02.40,0:07:05.82,Main-207+,,0,0,0,,ama sanırım miras peşindeler.Dialogue: 50,0:07:05.82,0:07:08.45,Main-207+,,0,0,0,,Miras falan yok desek inanmayacaklardır.Dialogue: 50,0:07:10.45,0:07:14.83,Main-207+,,0,0,0,,Er geç, benim ve buranın peşine düşecektir.Dialogue: 50,0:07:14.83,0:07:16.08,Main-207+,,0,0,0,,Anladım.Dialogue: 50,0:07:16.08,0:07:18.83,Main-207+,,0,0,0,,Öyleyse buradan ayrılamazsın, miyav.Dialogue: 50,0:07:21.38,0:07:25.38,Main-207+,,0,0,0,,Weevil'ın annesi Buckin, eski bir korsan.Dialogue: 50,0:07:25.38,0:07:31.97,Main-207+,,0,0,0,,30 veya 40 yıl önce falan Babalık ile aynı gemideymiş.Dialogue: 50,0:07:35.14,0:07:38.60,Main-207+,,0,0,0,,Belki de korunması gereken başka bir yadigârdır.Dialogue: 50,0:07:41.19,0:07:44.07,Main-207+,,0,0,0,,Davranışları aksini gösteriyor!Dialogue: 50,0:07:44.07,0:07:45.07,Main-207+,,0,0,0,,Haklısın.Dialogue: 50,0:07:50.07,0:07:55.54,Main-207+,,0,0,0,,Hasır Şapka Luffy'yle buluşacaksan ona bir mesajım var, Nekomamushi.Dialogue: 50,0:07:55.54,0:07:58.17,Main-207+,,0,0,0,,Cankulağıyla dinliyorum.Dialogue: 50,0:07:58.17,0:07:59.92,Main-207+,,0,0,0,,Hedefiniz Wano mu dedin?Dialogue: 50,0:07:59.92,0:08:00.79,Main-207+,,0,0,0,,Evet.Dialogue: 50,0:08:06.84,0:08:09.76,Main-207+,,0,0,0,,Luffy! Reverie başlamış!Dialogue: 50,0:08:10.14,0:08:15.06,Main-207+,,0,0,0,,Dünyanın dört bir yanından hükümdarlar, Mary Geoise'daki konferansa katılıyor!Dialogue: 50,0:08:17.60,0:08:19.73,Main-207+,,0,0,0,,Bu seferki konferansta ise tüm gözler...Dialogue: 50,0:08:19.73,0:08:23.52,Main-207+,,0,0,0,,iki asırdır ilk kez katıldıkları için Ryugu Krallığı'na çevrilmiş durumda!Dialogue: 50,0:08:23.52,0:08:26.53,Main-207+,,0,0,0,,Neptune-san ile oğullarının fotoğrafını çekmişler.Dialogue: 50,0:08:28.28,0:08:31.57,Main-207+,,0,0,0,,Red Port'ta Shirahoshi'ye alkış seli olmuş!Dialogue: 50,0:08:32.24,0:08:34.62,Main-207+,,0,0,0,,Karaya çıkmış demek!Dialogue: 50,0:08:34.62,0:08:37.25,Main-207+,,0,0,0,,Bizim Pısırıkhoshi güçlenmiş!Dialogue: 50,0:08:39.71,0:08:42.33,Main-207+,,0,0,0,,Anlaşılan deden onların refakatçisiymiş.Dialogue: 50,0:08:42.33,0:08:43.42,Main-207+,,0,0,0,,Ya...?Dialogue: 50,0:08:43.84,0:08:49.34,Main-207+,,0,0,0,,Balıkadamları yüzeye taşıma hayallerine doğru büyük bir adım atmışlar!Dialogue: 50,0:08:53.97,0:08:56.52,Main-207+,,0,0,0,,Vivi-chwan!Dialogue: 50,0:08:56.52,0:09:00.90,Main-207+,,0,0,0,,Daha da güzel bir prenses olmuşsun!Dialogue: 50,0:09:01.52,0:09:03.65,Main-207+,,0,0,0,,Kimin gönlünü çalmak için?Dialogue: 50,0:09:03.65,0:09:06.28,Main-207+,,0,0,0,,Benim mi? Hey, benim için mi?!Dialogue: 50,0:09:07.78,0:09:08.74,Main-207+,,0,0,0,,Çekil!Dialogue: 50,0:09:12.62,0:09:13.49,Main-207+,,0,0,0,,Vivi!Dialogue: 50,0:09:13.91,0:09:15.03,Main-207+,,0,0,0,,Bizim Vivi!Dialogue: 50,0:09:15.03,0:09:17.91,Main-207+,,0,0,0,,Onu görmeyeli uzun zaman oldu!Dialogue: 50,0:09:17.91,0:09:20.37,Main-207+,,0,0,0,,Zarif ve krallara layık bir prenses olmuş.Dialogue: 50,0:09:20.37,0:09:23.75,Main-207+,,0,0,0,,Oh, demek bu Vivi-san.Dialogue: 50,0:09:23.75,0:09:26.67,Main-207+,,0,0,0,,Onunla karşılaşınca külotunu görmek isterim–Dialogue: 50,0:09:26.67,0:09:27.80,Main-207+,,0,0,0,,Gösterir mi hiç sana!Dialogue: 50,0:09:31.22,0:09:35.10,Main-207+,,0,0,0,,Bu fotoğraflar Sosyalleşme Alanı'nda çekilmiş.Dialogue: 50,0:09:35.10,0:09:38.39,Main-207+,,0,0,0,,İştirak eden kraliyet ailelerine ve korumalarına baksanıza!Dialogue: 50,0:09:39.10,0:09:41.52,Main-207+,,0,0,0,,D-Dressrosa da katılıyorsa...Dialogue: 50,0:09:42.02,0:09:44.06,Main-207+,,0,0,0,,İşte! Viola-chan!Dialogue: 50,0:09:50.86,0:09:52.24,Main-207+,,0,0,0,,Bu Wapol!Dialogue: 50,0:09:52.24,0:09:54.24,Main-207+,,0,0,0,,Palamut amca da yanında!Dialogue: 50,0:09:54.24,0:09:56.03,Main-207+,,0,0,0,,Ne? Wapol mu?Dialogue: 50,0:09:56.03,0:09:57.41,Main-207+,,0,0,0,,Geri mi döndü?!Dialogue: 50,0:09:58.41,0:10:00.08,Main-207+,,0,0,0,,Rebecca! Sai!Dialogue: 50,0:10:00.08,0:10:02.29,Main-207+,,0,0,0,,Birçok tanıdık yüz var!Dialogue: 50,0:10:02.29,0:10:03.67,Main-207+,,0,0,0,,E hâliyle.Dialogue: 50,0:10:03.67,0:10:08.50,Main-207+,,0,0,0,,Dünyanın dört bir yanından Reverie'ye gelip istişare ediyorlar!Dialogue: 50,0:10:10.01,0:10:13.26,Main-207+,,0,0,0,,Oh, belki Reverie'de...Dialogue: 50,0:10:14.05,0:10:18.51,Main-207+,,0,0,0,,Reverie'de, tanıştığım prensesler...Dialogue: 50,0:10:18.51,0:10:22.77,Main-207+,,0,0,0,,hakkımda konuşmaktan yerinde duramıyorlardır!Dialogue: 50,0:10:22.77,0:10:24.65,Main-207+,,0,0,0,,Ne güzel olurdu, değil mi?Dialogue: 50,0:10:25.27,0:10:27.27,Main-207+,,0,0,0,,Hey, baksana Chopper!Dialogue: 50,0:10:28.52,0:10:29.36,Main-207+,,0,0,0,,Şuraya!Dialogue: 50,0:10:33.11,0:10:35.45,Main-207+,,0,0,0,,Ne oldu, Choniki?Dialogue: 50,0:10:43.50,0:10:46.21,Main-207+,,0,0,0,,Doktorin!Dialogue: 50,0:10:46.21,0:10:48.50,Main-207+,,0,0,0,,Hadi ya, daha ölmemiş mi?Dialogue: 50,0:10:48.50,0:10:49.55,Main-207+,,0,0,0,,Hey!Dialogue: 50,0:10:56.59,0:10:58.05,Main-207+,,0,0,0,,Doktorin...Dialogue: 50,0:10:58.05,0:11:00.22,Main-207+,,0,0,0,,Hey! Ne halt yiyorsun Chopper?Dialogue: 50,0:11:00.64,0:11:01.72,Main-207+,,0,0,0,,Kesmesene!Dialogue: 50,0:11:01.72,0:11:03.31,Main-207+,,0,0,0,,Ne? Dur biraz!Dialogue: 50,0:11:03.31,0:11:05.23,Main-207+,,0,0,0,,Prenseslerimi bana ver!Dialogue: 50,0:11:05.23,0:11:07.69,Main-207+,,0,0,0,,N'apıyorsunuz ya?Dialogue: 50,0:11:13.36,0:11:16.57,Main-207+,,0,0,0,,Hey! Henüz arka sayfayı okumamıştım!Dialogue: 50,0:11:16.57,0:11:17.78,Main-207+,,0,0,0,,Delik deşik etmişsiniz!Dialogue: 50,0:11:19.41,0:11:22.24,Main-207+,,0,0,0,,Ha? Kaido hakkında yazı mı var?Dialogue: 50,0:11:25.00,0:11:28.38,Main-207+,,0,0,0,,Big Mom... Ne yapıyormuş? Okunmuyor ki!Dialogue: 50,0:11:28.38,0:11:30.88,Main-207+,,0,0,0,,Sanji-kun! Chopper! Verin şunları!Dialogue: 50,0:11:30.88,0:11:32.17,Main-207+,,0,0,0,,– Olmaz! – Olmaz!Dialogue: 50,0:11:35.51,0:11:38.39,Main-207+,,0,0,0,,Hepsini de iyi gördüğüme sevindim!Dialogue: 50,0:11:38.39,0:11:41.47,Main-207+,,0,0,0,,Dünyayı dolaşmayı bitirince ziyaretlerine gidelim!Dialogue: 50,0:11:41.47,0:11:44.14,Main-207+,,0,0,0,,Evet! Durumları iyiymiş!Dialogue: 50,0:11:44.14,0:11:49.65,Main-207+,,0,0,0,,Bu arada Luffy-san, aktarıcı salyangoz hâlâ çalışmıyor mu?Dialogue: 50,0:11:49.65,0:11:51.77,Main-207+,,0,0,0,,Sahi, aklımdan çıkmış.Dialogue: 50,0:11:51.77,0:11:53.65,Main-207+,,0,0,0,,Hey! Benim, Luffy!Dialogue: 50,0:11:53.65,0:11:54.65,Main-207+,,0,0,0,,Cevap verin!Dialogue: 50,0:11:57.49,0:11:59.74,Main-207+,,0,0,0,,Cevap yok yav.Dialogue: 50,0:11:59.74,0:12:01.66,Main-207+,,0,0,0,,Önemli değil, devam edelim!Dialogue: 50,0:12:04.62,0:12:05.70,Main-207+,,0,0,0,,Bekle, Luffy!Dialogue: 50,0:12:06.25,0:12:07.16,Main-207+,,0,0,0,,Ne oldu?Dialogue: 50,0:12:08.50,0:12:09.54,Main-207+,,0,0,0,,Rüzgâr...Dialogue: 50,0:12:30.69,0:12:34.78,Main-207+,,0,0,0,,Soğuk rüzgârla daha önce hiç görmediğim biçimdeki dalgalar...Dialogue: 50,0:12:35.44,0:12:37.36,Main-207+,,0,0,0,,kesinlikle hayra alamet değil!Dialogue: 50,0:12:42.87,0:12:46.25,Main-207+,,0,0,0,,Wano çevresindeki deniz sahasına geldik demek!Dialogue: 50,0:12:54.63,0:13:00.13,Main-207+,,0,0,0,,Yaklaştıkça rüzgâr şiddeti gibi dalga boyları da artıyor!Dialogue: 50,0:13:00.93,0:13:05.01,Main-207+,,0,0,0,,Bu kabarma, rüzgârın sürüklediği sıradan bir akıntıya benzemiyor.Dialogue: 50,0:13:05.43,0:13:07.89,Main-207+,,0,0,0,,Sıra dışı dalgaların yanı sıra...Dialogue: 50,0:13:08.56,0:13:10.98,Main-207+,,0,0,0,,gökyüzündeki korkunç havaya baksana!Dialogue: 50,0:13:20.40,0:13:22.78,Main-207+,,0,0,0,,Fırtınadan kaçınmak akıllıca olur.Dialogue: 50,0:13:22.78,0:13:24.41,Main-207+,,0,0,0,,Dinmesini bekleyelim mi?Dialogue: 50,0:13:24.87,0:13:26.87,Main-207+,,0,0,0,,Hey! Ne diyorsun, Brook?Dialogue: 50,0:13:26.87,0:13:29.04,Main-207+,,0,0,0,,Wano'ya hemen gidiyoruz!Dialogue: 50,0:13:29.04,0:13:33.71,Main-207+,,0,0,0,,Luffy-san, niye hep mürettebatını bariz bir tehlikeye sokmak istiyorsun ki?Dialogue: 50,0:13:35.13,0:13:37.05,Main-207+,,0,0,0,,Şöyle ki Brook...Dialogue: 50,0:13:37.05,0:13:37.80,Main-207+,,0,0,0,,Ha?Dialogue: 50,0:13:38.21,0:13:41.59,Main-207+,,0,0,0,,Kin'emon bu konuda bizi uyarmıştı.Dialogue: 50,0:13:42.34,0:13:45.93,Flashbacks-207+,,0,0,0,,Zamanı gelince haber salyangozuyla açıklayacak olsam da...Dialogue: 50,0:13:46.60,0:13:51.48,Flashbacks-207+,,0,0,0,,Wano'yu sarmalayan deniz sahasında dinmek bilmeyen bir fırtına vardır.Dialogue: 50,0:13:51.48,0:13:54.40,Flashbacks-207+,,0,0,0,,Taşkın deniz ve şiddetli akıntılar yüzünden...Dialogue: 50,0:13:54.73,0:13:57.36,Flashbacks-207+,,0,0,0,,ülkeye girmek oldukça güçtür!Dialogue: 50,0:13:57.36,0:13:58.36,Main-207+,,0,0,0,,Ne?!Dialogue: 50,0:13:58.36,0:14:00.36,Main-207+,,0,0,0,,Hava hep böyle kötü mü?!Dialogue: 50,0:14:00.36,0:14:03.24,Main-207+,,0,0,0,,Öylece fırtınaya mı dalacağız yani?Dialogue: 50,0:14:03.24,0:14:05.12,Main-207+,,0,0,0,,Öyle yapalım derim! Dalalım!Dialogue: 50,0:14:05.12,0:14:09.24,Main-207+,,0,0,0,,Hem güçlü samurayları var hem de girişi zor...Dialogue: 50,0:14:09.24,0:14:11.75,Main-207+,,0,0,0,,İzole bir ülke olmasına şaşmamalı!Dialogue: 50,0:14:12.87,0:14:15.17,Main-207+,,0,0,0,,Biraz düşüneyim...Dialogue: 50,0:14:15.17,0:14:18.30,Main-207+,,0,0,0,,Güvenli bir şekilde geçmenin bir yolu olmalı.Dialogue: 50,0:14:23.09,0:14:24.68,Main-207+,,0,0,0,,Bu şey de ne böyle?!Dialogue: 50,0:14:24.68,0:14:26.01,Main-207+,,0,0,0,,Ahtapot!Dialogue: 50,0:14:26.01,0:14:27.30,Main-207+,,0,0,0,,Çok büyük!Dialogue: 50,0:14:27.30,0:14:28.97,Main-207+,,0,0,0,,Ahtapotun burada ne işi var?!Dialogue: 50,0:14:28.97,0:14:30.81,Main-207+,,0,0,0,,Denizdeyiz! Burada yaşıyorlar!Dialogue: 50,0:14:30.81,0:14:32.14,Main-207+,,0,0,0,,Onu biliyorum be...!Dialogue: 50,0:14:32.14,0:14:35.44,Main-207+,,0,0,0,,Ne ara güverteye çıktı?Dialogue: 50,0:14:35.81,0:14:39.44,Main-207+,,0,0,0,,Hey! Wano'ya yaklaşıyoruz!Dialogue: 50,0:14:39.44,0:14:40.82,Main-207+,,0,0,0,,Ne?!Dialogue: 50,0:14:40.82,0:14:42.82,Main-207+,,0,0,0,,Kimin umurunda?!Dialogue: 50,0:14:42.82,0:14:45.49,Main-207+,,0,0,0,,İlerle, Sunny!Dialogue: 50,0:14:45.49,0:14:48.83,Main-207+,,0,0,0,,Wano'ya doğru!Dialogue: 50,0:15:03.01,0:15:05.55,Main-207+,,0,0,0,,Hey! Gemiye yaklaşan şeyler var!Dialogue: 50,0:15:09.43,0:15:11.43,Main-207+,,0,0,0,,Ne? Onlar da ne?Dialogue: 50,0:15:11.43,0:15:13.56,Main-207+,,0,0,0,,Dev balıklara benziyorlar!Dialogue: 50,0:15:13.56,0:15:14.69,Main-207+,,0,0,0,,Köpek balığı mı acaba?Dialogue: 50,0:15:14.69,0:15:15.73,Main-207+,,0,0,0,,Köpek balığı mı?Dialogue: 50,0:15:17.35,0:15:18.98,Main-207+,,0,0,0,,Sıçtık! Saldırıyor!Dialogue: 50,0:15:27.45,0:15:29.37,Main-207+,,0,0,0,,S-S-Sazan...Dialogue: 50,0:15:29.37,0:15:31.29,Main-207+,,0,0,0,,Muhteşem! Muhteşem!Dialogue: 50,0:15:33.95,0:15:35.41,Main-207+,,0,0,0,,Kocaman sazan!Dialogue: 50,0:15:44.05,0:15:45.42,Main-207+,,0,0,0,,Sazan balığı sürüsü mü?Dialogue: 50,0:15:52.97,0:15:55.02,Main-207+,,0,0,0,,Denizde sazan ne arar ki?Dialogue: 50,0:15:55.02,0:15:56.56,Main-207+,,0,0,0,,Tatlı su balığıdır!Dialogue: 50,0:15:56.56,0:15:58.06,Main-207+,,0,0,0,,Buralarda nasıl yaşıyorlar?Dialogue: 50,0:15:58.06,0:16:01.19,Main-207+,,0,0,0,,Böyle canavarımsı büyüklükteki balıklara mantık söker mi?Dialogue: 50,0:16:01.19,0:16:03.57,Main-207+,,0,0,0,,Hey Sanji, tatları güzel midir?Dialogue: 50,0:16:03.57,0:16:06.36,Main-207+,,0,0,0,,Canavar balıkları yemeyi aklından çıkar!Dialogue: 50,0:16:06.90,0:16:10.57,Main-207+,,0,0,0,,Onları sıcak ve soğuk suda bir süre dinlendirerek sıkılaştırıyoruz;Dialogue: 50,0:16:10.57,0:16:12.58,Main-207+,,0,0,0,,böylece "arai" diye bir lezzet elde ediliyor.Dialogue: 50,0:16:12.58,0:16:14.33,Main-207+,,0,0,0,,Miso'yla Koikoku da yapabilirsin.Dialogue: 50,0:16:14.33,0:16:17.96,Main-207+,,0,0,0,,Tempura ve tatlı soya sosu haşlamasıyla da iyi gider bak.Dialogue: 50,0:16:17.96,0:16:21.00,Main-207+,,0,0,0,,Tamamdır!Dialogue: 50,0:16:21.42,0:16:24.63,Main-207+,,0,0,0,,Zorolar'la buluştuğumuzda bu balıkla ziyafet çekeceğiz!Dialogue: 50,0:16:24.63,0:16:26.17,Main-207+,,0,0,0,,Yapma, Luffy!Dialogue: 50,0:16:26.17,0:16:28.43,Main-207+,,0,0,0,,Sazanın kılçığı çok olur!Dialogue: 50,0:16:28.43,0:16:29.51,Main-207+,,0,0,0,,Kimin umurunda?!Dialogue: 50,0:16:29.51,0:16:31.72,Main-207+,,0,0,0,,Bunun şu anda ne önemi var?!Dialogue: 50,0:16:38.44,0:16:40.10,Main-207+,,0,0,0,,Direnmesene!Dialogue: 50,0:16:40.10,0:16:41.69,Main-207+,,0,0,0,,Tabii direnecek be!Dialogue: 50,0:16:42.11,0:16:44.36,Main-207+,,0,0,0,,Bir kere laf dinlesen ölür müsün?!Dialogue: 50,0:16:44.36,0:16:48.99,Main-207+,,0,0,0,,Sanji-kun! Senin de kabahatin var. Luffy'yi geri getir!Dialogue: 50,0:16:48.99,0:16:50.74,Main-207+,,0,0,0,,Endişelenme, Nami-san.Dialogue: 50,0:16:50.74,0:16:52.49,Main-207+,,0,0,0,,Başının çaresine bakar.Dialogue: 50,0:16:52.49,0:16:53.74,Main-207+,,0,0,0,,Ne?!Dialogue: 50,0:16:53.74,0:16:55.74,Main-207+,,0,0,0,,Daha ziyade gemiyi koruyalım!Dialogue: 50,0:17:17.47,0:17:20.39,Main-207+,,0,0,0,,Rüzgâr şiddetli! Carrot, yelkenleri topla!Dialogue: 50,0:17:20.39,0:17:21.35,Main-207+,,0,0,0,,Tamamdır!Dialogue: 50,0:17:21.35,0:17:22.77,Main-207+,,0,0,0,,Yardım edeyim!Dialogue: 50,0:17:41.46,0:17:46.92,Main-207+,,0,0,0,,Şu suyun berraklığına bakın! Dağ nehrindeki suyu aratmıyor!Dialogue: 50,0:17:46.92,0:17:51.55,Main-207+,,0,0,0,,Keşke berrak olmasaydı! Dev balıklar beni korkutuyor!Dialogue: 50,0:17:51.97,0:17:54.60,Main-207+,,0,0,0,,Ne? Nehre mi girdik yani?Dialogue: 50,0:17:55.60,0:17:58.06,Main-207+,,0,0,0,,Sazanlar nereye yüzüyor ki?!Dialogue: 50,0:18:00.02,0:18:01.48,Main-207+,,0,0,0,,Sıkı tutunun!Dialogue: 50,0:18:01.48,0:18:03.06,Main-207+,,0,0,0,,Akıntıya kapılıyoruz!Dialogue: 50,0:18:03.98,0:18:05.81,Main-207+,,0,0,0,,Luffy hâlâ yakınımızda mı?Dialogue: 50,0:18:13.11,0:18:13.86,Main-207+,,0,0,0,,Ne?Dialogue: 50,0:18:16.87,0:18:18.37,Main-207+,,0,0,0,,Oha-çüş...!Dialogue: 50,0:18:18.37,0:18:19.83,Main-207+,,0,0,0,,Bu da ne böyle?!Dialogue: 50,0:18:20.91,0:18:24.92,Main-207+,,0,0,0,,Akan nehir, şelaleye mi bağlanıyor! Bu nasıl mümkün olabilir?!Dialogue: 50,0:18:34.93,0:18:36.05,Main-207+,,0,0,0,,Anladım!Dialogue: 50,0:18:36.64,0:18:41.02,Main-207+,,0,0,0,,Tatlı suyun nedeni karşımızdaki şelale ise üzerinde devasa bir havza da olmalı!Dialogue: 50,0:18:41.93,0:18:45.23,Main-207+,,0,0,0,,Wano Ülkesi şelalenin ardında mı yoksa?Dialogue: 50,0:18:45.23,0:18:46.56,Main-207+,,0,0,0,,Şelalenin ardı...Dialogue: 50,0:18:46.56,0:18:48.82,Main-207+,,0,0,0,,Ne?! Nee?!Dialogue: 50,0:18:48.82,0:18:50.90,Main-207+,,0,0,0,,Nasıl olabilir?!Dialogue: 50,0:19:12.05,0:19:14.51,Main-207+,,0,0,0,,Ya! Şuna bakın!Dialogue: 50,0:19:14.51,0:19:16.59,Main-207+,,0,0,0,,Sazanlar şelaleyi tırmanıyorlar!Dialogue: 50,0:19:16.59,0:19:18.26,Main-207+,,0,0,0,,Nasıl be?!Dialogue: 50,0:19:25.89,0:19:28.36,Main-207+,,0,0,0,,Muhteşem ya! Muhteşem!Dialogue: 50,0:19:28.90,0:19:32.90,Main-207+,,0,0,0,,Gemimiz bunu yapamaz ki! Şelalenin dibini boylarız!Dialogue: 50,0:19:32.90,0:19:34.78,Main-207+,,0,0,0,,Herhâlde!Dialogue: 50,0:19:35.99,0:19:37.28,Main-207+,,0,0,0,,Luffy!Dialogue: 50,0:19:37.28,0:19:40.20,Main-207+,,0,0,0,,Vay be, sazanlar amma güçlüymüş!Dialogue: 50,0:19:40.20,0:19:42.24,Main-207+,,0,0,0,,Hiç sırası değil şimdi!Dialogue: 50,0:19:42.24,0:19:44.91,Main-207+,,0,0,0,,Luffy! Gemimiz batacakmış!Dialogue: 50,0:19:44.91,0:19:46.37,Main-207+,,0,0,0,,Tamamdır, bana bırakın.Dialogue: 50,0:19:46.37,0:19:47.62,Main-207+,,0,0,0,,Ne?!Dialogue: 50,0:19:49.13,0:19:51.25,Main-207+,,0,0,0,,Sıkı tutunun bakayım!Dialogue: 50,0:19:56.97,0:19:58.80,Main-207+,,0,0,0,,Size güveniyorum, sazanlar!Dialogue: 50,0:19:58.80,0:20:01.10,Main-207+,,0,0,0,,Dalga geçiyorsun herhâlde!Dialogue: 50,0:20:03.01,0:20:05.48,Main-207+,,0,0,0,,Gidelim!Dialogue: 50,0:20:23.49,0:20:25.95,Main-207+,,0,0,0,,Yaşasın!Dialogue: 50,0:20:28.96,0:20:32.50,Main-207+,,0,0,0,,Tırmanıyoruz!Dialogue: 50,0:20:53.11,0:20:56.86,Main-207+,,0,0,0,,Wano'nun ne biçim bir deniz sahası varmış ya?Dialogue: 50,0:20:56.86,0:20:58.32,Main-207+,,0,0,0,,Çok kaotik.Dialogue: 50,0:20:58.32,0:21:00.82,Main-207+,,0,0,0,,Hey! İşte kıyı!Dialogue: 50,0:21:08.91,0:21:10.96,Main-207+,,0,0,0,,– Bir girdap! – Bir girdap!Dialogue: 50,0:21:17.17,0:21:19.47,Main-207+,,0,0,0,,Luffy! Sazanları sal!Dialogue: 50,0:21:19.47,0:21:21.55,Main-207+,,0,0,0,,Olmaz! Onları yiyeceğim!Dialogue: 50,0:21:22.30,0:21:24.60,Main-207+,,0,0,0,,Kes artık!Dialogue: 50,0:21:25.72,0:21:27.81,Main-207+,,0,0,0,,Brook! Dümene geç!Dialogue: 50,0:21:27.81,0:21:29.68,Main-207+,,0,0,0,,Anlaşıldı!Dialogue: 50,0:21:40.07,0:21:42.53,Main-207+,,0,0,0,,Çok kötü! Akıntı çok güçlü!Dialogue: 50,0:21:48.25,0:21:51.12,Main-207+,,0,0,0,,Lanet olsun! Varmak üzereydik!Dialogue: 50,0:21:52.87,0:21:54.96,Main-207+,,0,0,0,,Bu sefer kesin gidiciyiz!Dialogue: 50,0:21:55.38,0:21:57.67,Main-207+,,0,0,0,,Doktorin!Dialogue: 50,0:22:01.51,0:22:03.59,Main-207+,,0,0,0,,Hey? Sazanlarım nereye gitti?Dialogue: 50,0:22:03.59,0:22:05.51,Main-207+,,0,0,0,,Daha büyük dertlerimiz var!Dialogue: 50,0:22:05.51,0:22:06.72,Main-207+,,0,0,0,,Ha?Dialogue: 50,0:22:18.07,0:22:21.49,Main-207+,,0,0,0,,Olamaz! Girdaba yakalanmışız!Dialogue: 0,0:00:04.94,0:00:08.45,Captions-207+,,0,0,0,,Yeni DünyaDialogue: 1,0:00:04.94,0:00:08.45,Captions-207+,,0,0,0,,Yeni DünyaDialogue: 0,0:00:08.53,0:00:13.24,Captions-207+,,0,0,0,,Mink MuhafızlarıDialogue: 1,0:00:08.53,0:00:13.24,Captions-207+,,0,0,0,,Mink MuhafızlarıDialogue: 0,0:01:24.56,0:01:31.28,Title-207+,,0,0,0,,Wano'ya DoğruDialogue: 1,0:01:24.56,0:01:31.28,Title-207+,,0,0,0,,Wano'ya DoğruDialogue: 0,0:02:25.50,0:02:31.76,Captions-207+,,0,0,0,,Marco Eski Beyazsakal Korsanları Üyesi 1. Tümen Komutanı (Doktor)Dialogue: 1,0:02:25.50,0:02:31.76,Captions-207+,,0,0,0,,Marco Eski Beyazsakal Korsanları Üyesi 1. Tümen Komutanı (Doktor)Dialogue: 0,0:03:16.51,0:03:19.22,Captions-207+,,0,0,0,,Nekomamushi Mink MuhafızıDialogue: 1,0:03:16.51,0:03:19.22,Captions-207+,,0,0,0,,Nekomamushi Mink MuhafızıDialogue: 0,0:08:02.63,0:08:06.01,Captions-207+,,0,0,0,,Yeni Dünya SularıDialogue: 1,0:08:02.63,0:08:06.01,Captions-207+,,0,0,0,,Yeni Dünya SularıDialogue: 0,0:08:38.66,0:08:43.42,Captions-207+,,0,0,0,,"Hasır Şapkalı" Luffy Hasır Şapka Korsanları Kaptanı Kelle Ödülü: ¬1.5 MilyarDialogue: 1,0:08:38.66,0:08:43.42,Captions-207+,,0,0,0,,"Hasır Şapkalı" Luffy Hasır Şapka Korsanları Kaptanı Kelle Ödülü: ¬1.5 MilyarDialogue: 0,0:22:45.47,0:22:48.60,Credits-207+,,0,0,0,,Düzenleme: Galaxy 9000 Feeso  Zamanlama: Gab Galaxy 9000 PhosCity  Kalite Kontrol: Camotoy fedew Galaxy 9000 Grug Pepperjack Scolines ZenefDialogue: 0,0:22:45.47,0:22:48.60,Credits-207+,,0,0,0,,Dizgi: Gab PhosCity  Müzik: Halee  Grafik: Datenshi  Altyazı Düzenleme: Jack Cohle  Çevirmen: dmc3[Aegisub Extradata]Data: 0,_aegişfolddata,e0;1;1Data: 1,_aegişfolddata,eı;1;1Data: 6,_aegişfolddata,e0;1;3Data: 7,_aegişfolddata,eı;1;3Data: 8,_aegişfolddata,e0;1;4Data: 9,_aegişfolddata,eı;1;4Data: 14,_aegişfolddata,e0;0;2Data: 15,_aegişfolddata,eı;0;2Data: 16,_aegişfolddata,e0;1;2Data: 17,_aegişfolddata,eı;1;2Data: 18,_aegişfolddata,e0;0;3Data: 19,_aegişfolddata,eı;0;3Data: 20,_aegi