2,180,180,27,1Style: RogerMonologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1Style: Karaoke,Duality,68,&H00292CC7,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,4,0,1,6.8,0,8,23,23,23,1Style: Translation,Duality,68,&H00292CC7,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,4,0,1,6.8,0,2,23,23,34,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:59.99,0:02:09.98,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 50,0:00:10.49,0:00:15.32,Main-207-,,0,0,0,,Hadi! Hadi, Zoro! Ne bekliyorsun?! Git ve onları ez!Dialogue: 50,0:00:15.32,0:00:18.26,Main-207-,,0,0,0,,Kapatın çenenizi ve gidip saklanın!Dialogue: 50,0:00:19.35,0:00:21.92,Main-207-,,0,0,0,,Beni biraz eğlendirseniz olur mu?Dialogue: 50,0:00:28.56,0:00:33.68,Main-207-,,0,0,0,,Hakla onları, Zoro! Elindeki tek meziyet bu, değil mi?!Dialogue: 50,0:00:38.71,0:00:43.69,Main-207-,,0,0,0,,Çabuk ol ve işlerini... bitir... şu çirkin tiplerin...Dialogue: 50,0:00:45.07,0:00:46.94,Main-207-,,0,0,0,,Ne yapmayı planlıyorsunuz? Ha?!Dialogue: 50,0:00:46.94,0:00:52.57,Main-207-,,0,0,0,,Suikastin ilk kuralı: Önce en güçsüz hedefi seç.Dialogue: 50,0:00:52.57,0:00:54.91,Main-207-,,0,0,0,,Profesyonellerin nasıl çalıştığını seyret.Dialogue: 50,0:00:57.20,0:00:58.87,Main-207-,,0,0,0,,B-Ben mi?Dialogue: 50,0:00:59.20,0:01:04.34,Main-207-,,0,0,0,,D-Durun biraz. Beni öldürmenizin hiçbir anlamı yok.Dialogue: 50,0:01:04.34,0:01:07.60,Main-207-,,0,0,0,,Yüzüm ve tarzım birinci sınıftır ama...Dialogue: 50,0:01:07.60,0:01:08.76,Main-207-,,0,0,0,,dövüşte iyi değilim.Dialogue: 50,0:01:09.25,0:01:11.30,Main-207-,,0,0,0,,Biz de öyle demedik mi?Dialogue: 50,0:01:11.65,0:01:15.08,Main-207-,,0,0,0,,Senin gibilerden başlamak, işleri bitirmenin en hızlı yoludur.Dialogue: 50,0:01:23.80,0:01:27.19,Main-207-,,0,0,0,,Bu yüzden kapat çeneni ve saklan dedim.Dialogue: 50,0:03:22.31,0:03:27.39,Main-207-,,0,0,0,,Luffy-san öldü mü? Bu saçmalığa inanmıyorum!Dialogue: 50,0:03:27.39,0:03:29.11,Main-207-,,0,0,0,,Saçmalık değil.Dialogue: 50,0:03:30.49,0:03:35.44,Main-207-,,0,0,0,,Hasır Şapka, Rainbase'deki kumların altına gömüldü, Bayan Wednesday.Dialogue: 50,0:03:39.17,0:03:45.25,Main-207-,,0,0,0,,Sana bulaşmamış olsaydı, daha uzun yaşardı.Dialogue: 50,0:03:45.85,0:03:49.77,Main-207-,,0,0,0,,Senin gibi biri, Luffy-san'ı öldüremez!Dialogue: 50,0:03:50.41,0:03:56.87,Main-207-,,0,0,0,,Şu an nefes alıp gözyaşı dökebiliyorsan, arkadaşlarının fedakârlığı sayesinde.Dialogue: 50,0:03:56.87,0:04:01.93,Main-207-,,0,0,0,,Onlara içtenlikle teşekkür etmelisin, hiç değilse ölenler...Dialogue: 50,0:04:01.93,0:04:04.35,Main-207-,,0,0,0,,Luffy-san nerede?!Dialogue: 50,0:04:04.35,0:04:07.41,Main-207-,,0,0,0,,Niye buradasın?!Dialogue: 50,0:04:10.51,0:04:12.61,Main-207-,,0,0,0,,...huzur içinde olacak.Dialogue: 50,0:04:13.35,0:04:17.59,Main-207-,,0,0,4,,Ah şu aptal! Nereye gitti bu?!Dialogue: 50,0:04:17.59,0:04:19.45,Main-207-,,0,0,4,,Bu yüzden susup saklanmanı söyledim.Dialogue: 50,0:04:19.70,0:04:23.91,Main-207-,,0,0,0,,Tam bir baş belası! Aptal kadın!Dialogue: 50,0:04:30.44,0:04:34.67,Thoughts-207-,,0,0,0,,Bu kadar. Daha fazla koşamam. Dövüşmeliyim.Dialogue: 50,0:04:40.82,0:04:41.59,Thoughts-207-,,0,0,0,,İmkânsız!Dialogue: 50,0:04:42.91,0:04:44.56,Thoughts-207-,,0,0,0,,Bu işe son verme zamanı.Dialogue: 50,0:04:46.31,0:04:47.27,Main-207-,,0,0,0,,Çok sabırsız.Dialogue: 50,0:04:55.18,0:04:55.73,Main-207-,,0,0,0,,Zoro!Dialogue: 50,0:05:01.58,0:05:03.28,Main-207-,,0,0,0,,Sütun dikey parçalara ayrıldı!Dialogue: 50,0:05:05.81,0:05:09.39,Main-207-,,0,0,8,,Ayrıldı mı? Hayır.Dialogue: 50,0:05:09.91,0:05:12.83,Main-207-,,0,0,0,,Bu kesinlikle bir kılıç ustasının işiydi.Dialogue: 50,0:05:14.98,0:05:15.59,Main-207-,,0,0,0,,Çekil.Dialogue: 50,0:05:21.03,0:05:23.53,Main-207-,,0,0,0,,Onu kestin, değil mi? O kolunla.Dialogue: 50,0:05:26.48,0:05:28.98,Main-207-,,0,0,0,,Tuhaf bir bedenin var.Dialogue: 50,0:05:30.02,0:05:35.67,Main-207-,,0,0,0,,Çok doğru. Kesme Meyvesi sayesinde kılıç adam oldum.Dialogue: 50,0:05:35.67,0:05:37.05,Main-207-,,0,0,0,,Sendin, değil mi?Dialogue: 50,0:05:37.05,0:05:40.24,Main-207-,,0,0,0,,Whisky Peak'te 100 çalışanımızı biçen kılıç ustası.Dialogue: 50,0:05:41.29,0:05:46.06,Main-207-,,0,0,0,,Birkaç yıl önce Doğu Mavi'de Baroque Works'ün davetini reddeden...Dialogue: 50,0:05:46.06,0:05:49.25,Main-207-,,0,0,0,,ve Bay 7'yi ortadan kaldıran kişi,Dialogue: 50,0:05:49.90,0:05:51.04,Main-207-,,0,0,0,,sendin değil mi?Dialogue: 50,0:05:51.48,0:05:54.50,Main-207-,,0,0,0,,Ha! Anılarım canlandı.Dialogue: 50,0:05:54.50,0:05:59.25,Main-207-,,0,0,0,,Şartlarımı kabul etmemeniz sizin hatanızdı.Dialogue: 50,0:05:59.71,0:06:03.26,Main-207-,,0,0,0,,Ajanınıza ne söylediğimi hatırlıyorum.Dialogue: 50,0:06:03.97,0:06:06.93,Main-207-,,0,0,0,,"Beni patron yaparsanız, katılırım."Dialogue: 50,0:06:08.47,0:06:10.02,Main-207-,,0,0,0,,Ne komik adam.Dialogue: 50,0:06:10.75,0:06:14.09,Main-207-,,0,0,0,,Şartlarımı kabul etmek yerine, beni öldürmeye çalıştı.Dialogue: 50,0:06:14.09,0:06:15.95,Main-207-,,0,0,0,,Ben de yapmam gerekeni yaptım.Dialogue: 50,0:06:16.65,0:06:18.73,Main-207-,,0,0,0,,Siz de beni davet etmek ister misiniz?Dialogue: 50,0:06:19.45,0:06:23.58,Main-207-,,0,0,0,,Elbette, artık sizin gibi aptalların patronu olmak ilgimi çekmiyor.Dialogue: 50,0:06:28.76,0:06:31.39,Main-207-,,0,0,0,,Bizimle alay mı ediyorsun?Dialogue: 50,0:06:33.87,0:06:37.42,Main-207-,,0,0,0,,Küçük, değersiz korsan tayfasından bir kılıç ustası.Dialogue: 50,0:06:38.16,0:06:41.54,Main-207-,,0,0,0,,Peki sen nesin?Dialogue: 50,0:06:41.54,0:06:44.29,Main-207-,,0,0,0,,Sözde bir ütopya fikriyle...Dialogue: 50,0:06:44.29,0:06:46.94,Main-207-,,0,0,0,,aklı çelinen beyinsiz bir kukla mı?Dialogue: 50,0:06:46.94,0:06:49.80,Main-207-,,0,0,0,,Yoksa cidden içi boş...Dialogue: 50,0:06:52.62,0:06:53.94,Main-207-,,0,0,0,,teneke askerler misiniz?Dialogue: 50,0:06:54.35,0:06:56.31,Main-207-,,0,0,0,,Bayan Doublefinger...Dialogue: 50,0:06:56.94,0:07:00.19,Main-207-,,0,0,0,,"Bu herifi öldüreceğim" diyeceksin, değil mi?Dialogue: 50,0:07:00.19,0:07:04.36,Main-207-,,0,0,0,,İstediğini yap. Kızla ben ilgilenirim.Dialogue: 50,0:07:04.99,0:07:06.08,Main-207-,,0,0,0,,Hey, Nami!Dialogue: 50,0:07:06.08,0:07:07.39,Main-207-,,0,0,0,,Gitmiş.Dialogue: 50,0:07:27.78,0:07:30.43,Thoughts-207-,,0,0,0,,Her yerde olan savaşın gürültüsünü duyabiliyorum.Dialogue: 50,0:07:31.00,0:07:34.09,Thoughts-207-,,0,0,0,,İsyan Ordusu'nu kapıda durduramamışlar.Dialogue: 50,0:07:34.64,0:07:36.85,Thoughts-207-,,0,0,0,,Vivi ve diğerleri güvende mi?Dialogue: 50,0:07:37.56,0:07:41.64,Thoughts-207-,,0,0,0,,Herkes bu savaşta canlarını tehlikeye atıyor.Dialogue: 50,0:07:41.64,0:07:43.77,Thoughts-207-,,0,0,0,,Ama ben...Dialogue: 50,0:07:50.90,0:07:55.29,Flashbacks-207-,,0,0,0,,Dediğim gibi, daha güçlü bir silaha ihtiyacım var!Dialogue: 50,0:07:55.65,0:08:00.41,Flashbacks-207-,,0,0,0,,Daha güçlü bir silah mı? Güçlü olmanın ne anlamı var?Dialogue: 50,0:08:00.41,0:08:05.53,Flashbacks-207-,,0,0,0,,Şey, ben dövüşçü değilim. Harika bir tarzım var ve güzelim ama...Dialogue: 50,0:08:05.53,0:08:06.67,Flashbacks-207-,,0,0,0,,Neden bahsediyorsun?Dialogue: 50,0:08:06.67,0:08:07.99,Flashbacks-207-,,0,0,0,,Ben,Dialogue: 50,0:08:09.58,0:08:13.28,Flashbacks-207-,,0,0,0,,kimseye yük olmayacak kadar güçlü olmak istiyorum.Dialogue: 50,0:08:14.12,0:08:16.84,Flashbacks-207-,,0,0,0,,Özellikle şu anda, Vivi için.Dialogue: 50,0:08:37.13,0:08:40.79,Flashbacks-207-,,0,0,0,,Usopp, anlıyorsun, değil mi?Dialogue: 50,0:08:41.44,0:08:43.71,Flashbacks-207-,,0,0,0,,Biz onlar gibi değiliz.Dialogue: 50,0:08:45.48,0:08:48.32,Flashbacks-207-,,0,0,0,,Onlar canavarlar kadar güçlüler.Dialogue: 50,0:08:48.32,0:08:52.33,Flashbacks-207-,,0,0,0,,Yalnızca kendi güçleriyle her türlü düşmana karşı koyabilirler.Dialogue: 50,0:08:52.33,0:08:57.12,Flashbacks-207-,,0,0,0,,Fakat ikimiz de güçsüz, sıradan insanlarız.Dialogue: 50,0:08:57.64,0:09:02.10,Flashbacks-207-,,0,0,0,,Savaş vakti, bir şey yapamayacak kadar korkacağız.Dialogue: 50,0:09:02.10,0:09:05.86,Flashbacks-207-,,0,0,0,,Kendimizi koruyamayacağımız için,  onlara yük olacağız.Dialogue: 50,0:09:08.07,0:09:10.95,Flashbacks-207-,,0,0,0,,Yani bizim gibi insanlar dövüşmek istiyorsa,Dialogue: 50,0:09:10.95,0:09:13.66,Flashbacks-207-,,0,0,0,,güçlü silahlara sahip olmalı, değil mi?Dialogue: 50,0:09:20.58,0:09:23.75,Flashbacks-207-,,0,0,0,,Silah icat etmek için deli gibi çalışmanın nedeni,Dialogue: 50,0:09:24.56,0:09:29.63,Flashbacks-207-,,0,0,0,,tıpkı diğerleri gibi dövüşebilme gururunu elinde tutmak istediğin için, değil mi?Dialogue: 50,0:09:30.13,0:09:36.47,Flashbacks-207-,,0,0,0,,Ben de öyle! Vivi için,  kendi başıma dövüşebilmek istiyorum!Dialogue: 50,0:09:36.47,0:09:37.68,Flashbacks-207-,,0,0,0,,Bana o gücü ver!Dialogue: 50,0:09:40.30,0:09:42.69,Flashbacks-207-,,0,0,0,,Alabasta'ya varmadan önce zamanımız kısıtlı.Dialogue: 50,0:09:46.17,0:09:50.49,Flashbacks-207-,,0,0,0,,Haklısın. Bu kadar çabuk güçlenebilmem imkânsız.Dialogue: 50,0:09:51.07,0:09:52.89,Flashbacks-207-,,0,0,0,,Saçmaladım, kusura bakma.Dialogue: 50,0:09:53.90,0:09:56.16,Flashbacks-207-,,0,0,0,,Zamanımız az diye buna saçma denir mi?Dialogue: 50,0:09:59.21,0:10:02.79,Flashbacks-207-,,0,0,0,,Hey, Usopp-sama için zor bir iş olmadığını bilmiyor musun?Dialogue: 50,0:10:04.29,0:10:04.75,Flashbacks-207-,,0,0,0,,Öyleyse...Dialogue: 50,0:10:06.08,0:10:08.00,Flashbacks-207-,,0,0,0,,yapacak mısın?Dialogue: 50,0:10:08.00,0:10:10.83,Flashbacks-207-,,0,0,0,,Oh, seni seviyorum! Teşekkürler, Usopp!Dialogue: 50,0:10:10.83,0:10:12.76,Flashbacks-207-,,0,0,0,,Şimdi maliyete gelirsek–Dialogue: 50,0:10:12.76,0:10:15.01,Flashbacks-207-,,0,0,0,,Çok teşekkür ederim, gerçekten!Dialogue: 50,0:10:15.01,0:10:18.06,Flashbacks-207-,,0,0,0,,Hey, hey, hey… Silahlar bedavaya yapılmıyor.Dialogue: 50,0:10:18.56,0:10:19.82,Flashbacks-207-,,0,0,0,,Peki, sana güveniyorum!Dialogue: 50,0:10:19.82,0:10:21.02,Flashbacks-207-,,0,0,0,,Hey, dinlesene!Dialogue: 50,0:10:21.69,0:10:23.63,Flashbacks-207-,,0,0,0,,Siz artık gidebilirsiniz.Dialogue: 50,0:10:26.10,0:10:28.61,Flashbacks-207-,,0,0,0,,Nami-san...Dialogue: 50,0:10:38.33,0:10:44.00,Thoughts-207-,,0,0,0,,Ne yapıyorum ben? O ses beni neredeyse ölümüne korkuttu.Dialogue: 50,0:10:45.21,0:10:48.49,Thoughts-207-,,0,0,0,,Usopp'un önünde çok cesur davrandım.Dialogue: 50,0:10:48.49,0:10:50.46,Thoughts-207-,,0,0,0,,Hazır olmam gerekiyor!Dialogue: 50,0:10:52.36,0:10:54.43,Thoughts-207-,,0,0,0,,Vivi için, dövüşeceğim.Dialogue: 50,0:11:01.89,0:11:05.52,Thoughts-207-,,0,0,0,,Evet. Usopp sözünü tuttu.Dialogue: 50,0:11:05.92,0:11:07.68,Main-207-,,0,0,0,,Sadece dövüşmem gerekiyor!Dialogue: 50,0:11:07.68,0:11:10.60,Main-207-,,0,0,0,,Sadece bir kadın, hakkından gelebilirim...Dialogue: 50,0:11:35.15,0:11:37.80,Main-207-,,0,0,0,,Benden kaçamazsın, tatlım.Dialogue: 50,0:11:38.69,0:11:42.31,Thoughts-207-,,0,0,0,,Bayan Doublefinger! Mızrak falan mı kullandı?Dialogue: 50,0:11:42.31,0:11:45.48,Thoughts-207-,,0,0,0,,O da mı şeytan meyvesi gücüne sahip?Dialogue: 50,0:11:47.14,0:11:48.98,Main-207-,,0,0,0,,Henüz anlamadın mı?Dialogue: 50,0:11:50.82,0:11:53.57,Main-207-,,0,0,0,,Diken Meyvesi sayesinde, diken kadın oldum.Dialogue: 50,0:11:53.57,0:11:57.07,Main-207-,,0,0,0,,Bedenimin herhangi bir yerinde diken oluşturabilirim.Dialogue: 50,0:11:57.46,0:12:00.64,Thoughts-207-,,0,0,0,,Taş duvarı kolayca parçalayabilen dikenler...Dialogue: 50,0:12:00.64,0:12:04.95,Thoughts-207-,,0,0,0,,Bir an bile köşeye sıkışırsam, dikenleri her yerimi deler ve işim biter.Dialogue: 50,0:12:05.28,0:12:09.25,Main-207-,,0,0,0,,Zavallı şey benimle dövüşmek için ayağa kalkıyor.Dialogue: 50,0:12:10.04,0:12:10.96,Main-207-,,0,0,0,,Aynen öyle!Dialogue: 50,0:12:13.80,0:12:18.05,Flashbacks-207-,,0,0,0,,Bulutları toplayıp yağmur yağdırabilir.Dialogue: 50,0:12:18.05,0:12:20.55,Flashbacks-207-,,0,0,0,,Rüzgâr bile çıkarabilir!Dialogue: 50,0:12:20.55,0:12:24.52,Flashbacks-207-,,0,0,0,,Bu mucizevi asa, havada olağanüstü değişimlere yol açabilir!Dialogue: 50,0:12:26.90,0:12:30.98,Main-207-,,0,0,0,,Sen bittin! İşte yeni silahım, İklim Asası!Dialogue: 50,0:12:30.98,0:12:32.69,Main-207-,,0,0,0,,Ne oluyor…?Dialogue: 50,0:12:33.12,0:12:34.23,Main-207-,,0,0,0,,Önce, güneşli!Dialogue: 50,0:12:34.23,0:12:35.85,Main-207-,,0,0,0,,Güzel Tempo!Dialogue: 50,0:12:39.05,0:12:42.89,Main-207-,,0,0,0,,Vay, harika! İçinden güvercinler çıktı!Dialogue: 50,0:12:43.94,0:12:45.46,Main-207-,,0,0,0,,Bu aptalcaydı!Dialogue: 50,0:12:50.40,0:12:52.54,Main-207-,,0,0,0,,Sen... iyi misin?Dialogue: 50,0:12:53.88,0:12:55.92,Thoughts-207-,,0,0,0,,Bir saldırıya böyle başlarsın!Dialogue: 50,0:12:56.32,0:12:58.79,Thoughts-207-,,0,0,0,,Önce düşmanın dikkatini dağıtırsın, değil mi?Dialogue: 50,0:12:58.79,0:12:59.88,Thoughts-207-,,0,0,0,,Anladım, Usopp.Dialogue: 50,0:13:01.20,0:13:02.63,Main-207-,,0,0,0,,Bu sefer, işin bitti!Dialogue: 50,0:13:02.63,0:13:03.76,Main-207-,,0,0,0,,Bulutlu Tempo!Dialogue: 50,0:13:06.10,0:13:08.43,Main-207-,,0,0,0,,Vay! Ne güzel çiçekler!Dialogue: 50,0:13:09.99,0:13:11.76,Main-207-,,0,0,0,,Bu şekilde kazanmam mümkün değil!Dialogue: 50,0:13:14.08,0:13:18.24,Thoughts-207-,,0,0,0,,Ne oluyor bilmiyorum ama onun için çok üzülüyorum.Dialogue: 50,0:13:21.20,0:13:23.03,Main-207-,,0,0,0,,Çabuk! Vivi-sama tehlikede!Dialogue: 50,0:13:24.42,0:13:27.91,Main-207-,,0,0,0,,Toplar! Topları getirin! Kapıyı yok edin!Dialogue: 50,0:13:27.91,0:13:28.75,Main-207-,,0,0,0,,Çabuk!Dialogue: 50,0:13:32.62,0:13:34.85,Main-207-,,0,0,0,,16 Çiçek!Dialogue: 50,0:13:42.94,0:13:43.59,Main-207-,,0,0,0,,Ne?Dialogue: 50,0:14:11.47,0:14:14.39,Main-207-,,0,0,0,,Umarım şimdi biraz huzur ve sükûnet bulabiliriz.Dialogue: 50,0:14:41.82,0:14:43.36,Main-207-,,0,0,0,,Çok inatçısın.Dialogue: 50,0:14:47.53,0:14:49.97,Main-207-,,0,0,0,,Kaçmanın işe yaramayacağını anlamıyor musun?Dialogue: 50,0:14:50.89,0:14:52.37,Main-207-,,0,0,0,,Kazanma şansın yok.Dialogue: 50,0:14:52.87,0:14:54.96,Main-207-,,0,0,0,,Sen öyle san!Dialogue: 50,0:14:54.96,0:14:58.74,Main-207-,,0,0,0,,Kullanma kılavuzuna göre daha bir sürü teknik var.Dialogue: 50,0:15:01.30,0:15:05.01,Main-207-,,0,0,0,,İyi bir kız ol ve kımıldama.Dialogue: 50,0:15:05.01,0:15:07.80,Main-207-,,0,0,0,,Yenilgiyi kabullen de sana acısız bir ölüm vereyim.Dialogue: 50,0:15:09.30,0:15:13.18,Main-207-,,0,0,0,,Yoksa o eğlenceli sihir oyununa devam mı edeceksin?Dialogue: 50,0:15:14.55,0:15:16.43,Main-207-,,0,0,0,,Hava, gök gürültülü olacak!Dialogue: 50,0:15:16.43,0:15:17.69,Main-207-,,0,0,0,,Gök Gürültüsü Tempo!Dialogue: 50,0:15:26.59,0:15:30.42,Main-207-,,0,0,0,,Gök Gürültüsü Tempo... Gök Gürültüsü Tempo... Gök Gürültüsü...Dialogue: 50,0:15:30.42,0:15:33.20,Main-207-,,0,0,0,,Diken Parmak!Dialogue: 50,0:15:39.00,0:15:43.48,Main-207-,,0,0,0,,Hayır!!Dialogue: 50,0:15:51.52,0:15:53.49,Thoughts-207-,,0,0,0,,Yanağım kanıyor!Dialogue: 50,0:15:54.21,0:15:57.73,Thoughts-207-,,0,0,0,,Ahh... Acaba ölecek miyim?Dialogue: 50,0:15:58.13,0:16:00.73,Thoughts-207-,,0,0,0,,Büyük ihtimalle öleceğim. Öleceğim.Dialogue: 50,0:16:01.43,0:16:07.22,Main-207-,,0,0,0,,Ölürsem onu lanetleyeceğim. Uzun burunlu aptal! Uzun burunlu!!Dialogue: 50,0:16:07.22,0:16:09.53,Main-207-,,0,0,0,,Bunun silah olması gerekiyordu.Dialogue: 50,0:16:10.92,0:16:11.58,Main-207-,,0,0,0,,Bu...?Dialogue: 50,0:16:12.49,0:16:16.08,Main-207-,,0,0,0,,Pekâlâ, ölme vaktin geldi. Hazır mısın?Dialogue: 50,0:16:24.64,0:16:27.72,Main-207-,,0,0,0,,Köprünün altında duruyor. Nasıl?!Dialogue: 50,0:16:30.88,0:16:32.93,Main-207-,,0,0,0,,Kirpi Dikeni!Dialogue: 50,0:16:34.06,0:16:34.93,Main-207-,,0,0,0,,Ucuz atlattım!Dialogue: 50,0:16:37.04,0:16:39.10,Main-207-,,0,0,0,,H-H-Hey, dur biraz! Dur!Dialogue: 50,0:16:40.41,0:16:42.78,Main-207-,,0,0,0,,Dur dedim! Dursana!Dialogue: 50,0:16:42.78,0:16:45.86,Main-207-,,0,0,0,,Bir dakika! Sadece bir dakika! Hey!Dialogue: 50,0:16:47.66,0:16:49.20,Main-207-,,0,0,0,,Açıkta yakalanacağım!Dialogue: 50,0:16:58.47,0:17:01.25,Main-207-,,0,0,0,,Bitti artık. Seni şişleyeceğim!Dialogue: 50,0:17:01.25,0:17:04.38,Main-207-,,0,0,0,,Teşekkürler... ben almayayım!Dialogue: 50,0:17:17.74,0:17:18.79,Main-207-,,0,0,0,,Bak sen...Dialogue: 50,0:17:21.30,0:17:26.36,Main-207-,,0,0,0,,Görünüşe göre dövüşte o kadar da amatör değil.Dialogue: 50,0:17:28.48,0:17:29.65,Main-207-,,0,0,0,,O da neydi?Dialogue: 50,0:17:29.65,0:17:32.91,Main-207-,,0,0,0,,Klavuzda daha önce bir şey gözüme takıldı.Dialogue: 50,0:17:32.91,0:17:35.86,Main-207-,,0,0,0,,Hiç de iyi görünmüyordu.Dialogue: 50,0:17:35.86,0:17:36.87,Main-207-,,0,0,0,,Neredeydi?Dialogue: 50,0:17:37.44,0:17:38.36,Flashbacks-207-,,0,0,0,,İşte bu!Dialogue: 50,0:17:38.36,0:17:42.34,Flashbacks-207-,,0,0,0,,Buraya kadar anlatılan numaralar parti ve kutlama yapılırken...Dialogue: 50,0:17:42.36,0:17:45.17,Flashbacks-207-,,0,0,0,,ortamı canlandırmak ve insanları eğlendirmek içindi.Dialogue: 50,0:17:48.96,0:17:51.05,Main-207-,,0,0,0,,Dalga mı geçiyorsun, aptal?Dialogue: 50,0:17:51.05,0:17:54.80,Flashbacks-207-,,0,0,0,,Ayrıca, dövüş talimatları arka yüzde.Dialogue: 50,0:17:55.38,0:17:56.61,Main-207-,,0,0,0,,Arka mı?Dialogue: 50,0:18:04.13,0:18:07.61,Main-207-,,0,0,0,,Ee, bu kez nereye saklandın,Dialogue: 50,0:18:07.90,0:18:09.23,Main-207-,,0,0,0,,küçük kedicik?Dialogue: 50,0:18:16.96,0:18:19.17,Main-207-,,0,0,0,,Bir daha kaçıp saklanmayacağım.Dialogue: 50,0:18:19.17,0:18:23.50,Main-207-,,0,0,0,,Sekiz yıldır hırsızlık yaptım ve tüm ölüm kalım durumlarını...Dialogue: 50,0:18:23.50,0:18:26.21,Main-207-,,0,0,0,,yalnız başıma atlattım!Dialogue: 50,0:18:28.36,0:18:32.76,Main-207-,,0,0,0,,Sıradan bir kızmışım gibi davranılmasına dayanamıyorum.Dialogue: 50,0:18:33.26,0:18:36.39,Main-207-,,0,0,0,,Öyle mi? Bunun için üzgünüm.Dialogue: 50,0:18:36.39,0:18:39.01,Main-207-,,0,0,0,,Niye aniden öz güvenle doldun?Dialogue: 50,0:18:39.26,0:18:41.77,Main-207-,,0,0,0,,Seni uyarıyorum! Şimdi dövüşmeye hazırım!Dialogue: 50,0:18:43.14,0:18:45.23,Flashbacks-207-,,0,0,0,,Asanın savaş konfigürasyonları...Dialogue: 50,0:18:45.23,0:18:48.75,Flashbacks-207-,,0,0,0,,1. Temel Kural: Üç sopanın özelliklerini kavra.Dialogue: 50,0:18:48.75,0:18:53.40,Flashbacks-207-,,0,0,0,,Her birini sallamak veya üflemek hava topları çıkaracak.Dialogue: 50,0:18:54.06,0:18:55.69,Flashbacks-207-,,0,0,0,,İlk sopa sıcak hava yaratır,Dialogue: 50,0:18:58.89,0:19:00.65,Flashbacks-207-,,0,0,0,,ısı kabarcığı!Dialogue: 50,0:19:00.65,0:19:02.87,Main-207-,,0,0,0,,Bu da ne böyle? Sıcak hissettiriyor.Dialogue: 50,0:19:03.37,0:19:05.04,Flashbacks-207-,,0,0,0,,İkinci sopa soğuk hava yaratır,Dialogue: 50,0:19:07.16,0:19:08.84,Flashbacks-207-,,0,0,0,,soğuk kabarcığı!Dialogue: 50,0:19:08.84,0:19:10.67,Main-207-,,0,0,0,,Ah, çok serin.Dialogue: 50,0:19:11.08,0:19:13.27,Flashbacks-207-,,0,0,0,,Üçüncü sopa da elektrik yaratır,Dialogue: 50,0:19:15.47,0:19:17.08,Flashbacks-207-,,0,0,0,,yıldırım kabarcığı!Dialogue: 50,0:19:17.08,0:19:19.13,Main-207-,,0,0,0,,Ah, biraz çarpıldım.Dialogue: 50,0:19:19.13,0:19:24.06,Flashbacks-207-,,0,0,0,,Bu teknikler henüz tamamlanmadı, bu yüzden partilerde kullanırsan…Dialogue: 50,0:19:24.06,0:19:25.27,Main-207-,,0,0,0,,Öyleyse yazmasaydın!Dialogue: 50,0:19:26.94,0:19:28.80,Main-207-,,0,0,0,,Tatmin oldun mu?Dialogue: 50,0:19:33.18,0:19:35.07,Main-207-,,0,0,0,,Diken Dikişi!Dialogue: 50,0:19:36.22,0:19:40.48,Main-207-,,0,0,0,,Lütfen! Kullanabileceğim bir şey! Numara değil, gerçek teknikler!Dialogue: 50,0:19:45.71,0:19:47.71,Main-207-,,0,0,0,,Üzgünüm.Dialogue: 50,0:19:47.71,0:19:49.67,Main-207-,,0,0,0,,Daha fazla oynayacak zamanım yok.Dialogue: 50,0:19:51.20,0:19:52.30,Main-207-,,0,0,0,,Diken Ezişi!Dialogue: 50,0:20:07.46,0:20:10.80,Main-207-,,0,0,0,,Anlıyorum! Isı kabarcığı ve soğuk kabarcığı!Dialogue: 50,0:20:10.80,0:20:14.79,Main-207-,,0,0,0,,Kabarcıklar durduğunda çarpışır, hava akımı meydana gelir,Dialogue: 50,0:20:14.79,0:20:17.03,Main-207-,,0,0,0,,ve muazzam bir rüzgâr çıkar!Dialogue: 50,0:20:17.03,0:20:18.83,Main-207-,,0,0,0,,Bu inanılmaz, Usopp!Dialogue: 50,0:20:18.83,0:20:21.47,Flashbacks-207-,,0,0,0,,Siklon tempo bumerang gibidir.Dialogue: 50,0:20:21.47,0:20:24.31,Flashbacks-207-,,0,0,0,,Parti sonrası, dışarıda insanlarla  oynayabilirsin.Dialogue: 50,0:20:24.31,0:20:26.58,Main-207-,,0,0,0,,Ne yaptığından haberi bile yok...Dialogue: 50,0:20:28.28,0:20:30.86,Main-207-,,0,0,0,,Ama bununla, belki...Dialogue: 50,0:20:33.46,0:20:35.59,Main-207-,,0,0,0,,Ne tuhaf bir silah.Dialogue: 50,0:20:36.71,0:20:38.80,Main-207-,,0,0,0,,Dikkatini dövüşe vermelisin!Dialogue: 50,0:20:41.11,0:20:43.97,Main-207-,,0,0,0,,Dövüşte rakibine sırtını dönmek...Dialogue: 50,0:20:43.97,0:20:46.22,Main-207-,,0,0,0,,Seni öldürmeye çalıştığımı unuttun mu?Dialogue: 50,0:21:00.18,0:21:03.37,Main-207-,,0,0,0,,Havanın yoğunluğunu soğuk kabarcığıyla değiştirdim.Dialogue: 50,0:21:03.37,0:21:06.15,Main-207-,,0,0,0,,Büyük sıcaklık farkı sonucu oluşan ışık kırılmaları…Dialogue: 50,0:21:06.15,0:21:06.91,Main-207-,,0,0,0,,Yani...Dialogue: 50,0:21:07.43,0:21:11.63,Main-207-,,0,0,0,,Serap! İmkânsız... Bu kadar kısa mesafede mi?!Dialogue: 50,0:21:16.73,0:21:21.68,Flashbacks-207-,,0,0,0,,Güçle üstesinden gelemeyiz, zekânla hayatta kalacaksın!Dialogue: 50,0:21:22.44,0:21:24.55,Flashbacks-207-,,0,0,0,,İşte bizim dövüşme şeklimiz, ha?!Dialogue: 50,0:21:25.35,0:21:27.93,Main-207-,,0,0,0,,Düzgün kullanılırsa, mucizeler oluşturabilir!Dialogue: 50,0:21:28.50,0:21:30.73,Main-207-,,0,0,0,,Bu silah benim için mükemmel!Dialogue: 50,0:21:34.91,0:21:37.42,Main-207-,,0,0,0,,Sonunda İklim Asası'nı anlıyorum.Dialogue: 50,0:21:37.93,0:21:39.63,Main-207-,,0,0,0,,Vaktin varken pes et!Dialogue: 50,0:21:46.12,0:21:47.70,Main-207-,,0,0,0,,Demek canlı çıkabildiniz.Dialogue: 50,0:21:49.90,0:21:51.57,Main-207-,,0,0,0,,– Sanji! – Sanji!Dialogue: 50,0:21:51.57,0:21:52.88,Main-207-,,0,0,0,,O yaralar...Dialogue: 50,0:21:54.80,0:21:56.84,Main-207-,,0,0,0,,Eee, Bay 2'yle olan dövüşün nasıl geçti?Dialogue: 50,0:21:57.12,0:21:59.63,Main-207-,,0,0,0,,Sence? Al.Dialogue: 50,0:21:59.88,0:22:02.60,Main-207-,,0,0,0,,Ahhh! Gözlüğüm!Dialogue: 50,0:22:02.60,0:22:07.06,Main-207-,,0,0,0,,Onu benim için almışsın! Sağ ol, Sanji!Dialogue: 50,0:22:07.06,0:22:10.87,Main-207-,,0,0,0,,Sen çok düşünce- Ahh! Hey, dur biraz! Kırılmış!Dialogue: 50,0:22:10.87,0:22:14.41,Main-207-,,0,0,0,,Lanet olası, bunlar Kuzey Mavi'nin son modeli!Dialogue: 50,0:22:14.41,0:22:17.27,Main-207-,,0,0,0,,Bana ne kadara mal olduğu hakkında bir fikrin var mı?!Dialogue: 50,0:22:17.27,0:22:18.67,Main-207-,,0,0,0,,Hey, oraya bakın.Dialogue: 50,0:22:18.67,0:22:19.97,Main-207-,,0,0,0,,Beni dinle...Dialogue: 50,0:22:19.97,0:22:20.90,Main-207-,,0,0,0,,Ah!Dialogue: 50,0:22:21.49,0:22:24.43,Main-207-,,0,0,0,,İsyan Ordusu'nun destek kuvvetleri olmalılar.Dialogue: 50,0:22:25.05,0:22:26.58,Main-207-,,0,0,0,,Daha fazla mı?Dialogue: 50,0:22:26.58,0:22:31.08,Main-207-,,0,0,0,,Görünüşe bakılırsa, Vivi-chan İsyan Ordusu’nu engelleyememiş.Dialogue: 50,0:22:32.06,0:22:34.34,Main-207-,,0,0,0,,Ah, kahretsin!Dialogue: 50,0:22:33.67,0:22:34.34,Secondary-207-,,0,0,0,,Vooo.Dialogue: 50,0:22:34.34,0:22:36.04,Main-207-,,0,0,0,,Hm? Vooo mı?Dialogue: 50,0:22:36.04,0:22:39.63,Main-207-,,0,0,0,,Hey, nerede saklanıyordun, Kirpik?Dialogue: 50,0:22:40.49,0:22:44.39,Main-207-,,0,0,0,,Hemen saraya gidelim! Belki Vivi-chan'a yardımımız dokunur.Dialogue: 50,0:22:44.39,0:22:45.24,Main-207-,,0,0,0,,Tamamdır.Dialogue: 50,0:22:45.24,0:22:46.55,Main-207-,,0,0,0,,Hey, Usopp! Gidelim hadi!Dialogue: 50,0:22:46.55,0:22:49.60,Main-207-,,0,0,0,,T-Tamam. Hey, Kirpik, bırak bineyim!Dialogue: 50,0:22:49.60,0:22:52.31,Main-207-,,0,0,0,,Bak! Ne hâldeyim, görmüyor musun?Dialogue: 50,0:22:52.31,0:22:54.27,Main-207-,,0,0,0,,Kirpik, dur! Bırak bineyim!Dialogue: 50,0:22:55.68,0:22:57.23,Main-207-,,0,0,0,,Baba!Dialogue: 50,0:23:00.47,0:23:03.36,Main-207-,,0,0,0,,Kralı bırak, Crocodile!Dialogue: 50,0:23:05.75,0:23:07.52,Main-207-,,0,0,0,,Affet beni, Vivi...Dialogue: 50,0:23:08.11,0:23:15.10,Main-207-,,0,0,0,,Elde etmek için hayatını riske attığın istihbaratı kullanmayı beceremedim.Dialogue: 50,0:23:15.10,0:23:16.46,Main-207-,,0,0,0,,Baba...Dialogue: 50,0:23:23.89,0:23:28.37,Main-207-,,0,0,0,,Öncelikle, hiçbirinizi canlı bırakmaya niyetim yok.Dialogue: 50,0:23:28.95,0:23:34.18,Main-207-,,0,0,0,,Kraliyet ailesinin, krallıkla birlikte düşmesi doğaldır.Dialogue: 50,0:23:35.64,0:23:37.61,Main-207-,,0,0,0,,Ancak tahtı ele geçirmeden önce,Dialogue: 50,0:23:37.61,0:23:44.15,Main-207-,,0,0,0,,şimdiki kral olan sana bir şey sormalıyım.Dialogue: 50,0:23:45.95,0:23:49.87,Main-207-,,0,0,0,,En başından beri nihai amacım olan şeyi...Dialogue: 50,0:23:51.60,0:23:55.54,Main-207-,,0,0,0,,Cobra... Pluton nerede?Dialogue: 50,0:24:05.40,0:24:09.50,Main-207-,,0,0,0,,Seni şeytan, bunu nereden duydun?Dialogue: 0,0:03:17.18,0:03:21.01,Title-207-,,0,0,0,,Havayı Kontrol Eden KadınDialogue: 1,0:03:17.18,0:03:21.01,Title-207-,,0,0,0,,Havayı Kontrol Eden KadınDialogue: 2,0:00:00.52,0:00:04.90,Captions-207-,,0,0,0,,Kuzey BloğuDialogue: 2,0:00:00.52,0:00:04.90,Captions-207-,,0,0,0,,Kuzey BloğuDialogue: 2,0:00:00.52,0:00:04.90,Captions-207-,,0,0,0,,Kuzey BloğuDialogue: 0,0:04:12.65,0:04:19.45,Captions-207-,,0,0,0,,Medi Toplantı Salonu Alubarna Kuzey BloğuDialogue: 1,0:04:12.65,0:04:19.45,Captions-207-,,0,0,0,,Medi Toplantı Salonu Alubarna Kuzey BloğuDialogue: 2,0:04:12.65,0:04:19.45,Captions-207-,,0,0,0,,Medi Toplantı Salonu Alubarna Kuzey BloğuDialogue: 0,0:05:03.32,0:05:09.58,Captions-207-,,0,0,0,,Bay 1 ve Bayan Doublefinger,Dialogue: 1,0:05:03.32,0:05:09.58,Captions-207-,,0,0,0,,Bay 1 ve Bayan Doublefinger,Dialogue: 2,0:05:03.32,0:05:09.58,Captions-207-,,0,0,0,,Bay 1 ve Bayan Doublefinger,Dialogue: 0,0:05:03.32,0:05:09.58,Captions-207-,,0,0,0,,Roronoa Zoro ve Nami'ye Karşı