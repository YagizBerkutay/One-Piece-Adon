95,0,8,23,23,146,1Style: Karaoke-furigana,Duality,36,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,2.95,0,8,23,23,23,1Style: Lyrics-furigana,Duality,36,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,2.95,0,2,23,23,34,1Style: Lyrics,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,2,23,23,34,1Style: Karaoke,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,23,1Style: Kanji,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,146,1Style: Roger-Monologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1Style: Romaji ED,Josefin Sans,82,&H00FFFFFF,&H003592BE,&H00000000,&H64000000,0,0,0,0,100,100,0,0,1,0,4,8,10,10,20,1Style: Translation ED,Josefin Sans,82,&H00FFFFFF,&H000000FF,&H00FFFFFF,&H64000000,0,0,0,0,100,100,0,0,1,0,4,2,10,10,20,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:54.68,0:02:04.67,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 50,0:01:52.88,0:01:54.76,Main-207-,,0,0,0,,Sen, bir korsan mısın?Dialogue: 50,0:01:54.76,0:01:55.80,Main-207-,,0,0,0,,Evet!Dialogue: 50,0:01:55.80,0:01:59.89,Main-207-,,0,0,0,,Peki, neden bu restorana top ateşledin?Dialogue: 50,0:01:59.89,0:02:01.60,Main-207-,,0,0,0,,O bir kazaydı!Dialogue: 50,0:02:01.60,0:02:03.60,Main-207-,,0,0,0,,Kendimi savunuyordum!Dialogue: 50,0:02:03.60,0:02:04.94,Main-207-,,0,0,0,,Şimdi ne olacak?Dialogue: 50,0:02:05.94,0:02:09.48,Main-207-,,0,0,0,,Neyse ne. Sadece burada iş çevirmeye kalkma.Dialogue: 50,0:02:09.82,0:02:13.57,Main-207-,,0,0,0,,Mekan sahibi, zamanında azılı bir korsan tayfasında aşçılık yapmış.Dialogue: 50,0:02:14.66,0:02:16.78,Main-207-,,0,0,0,,Demek o amca eskiden korsandı!Dialogue: 50,0:02:17.45,0:02:22.33,Main-207-,,0,0,0,,O moruğa göre, bu restoran hazine gibi bir şey.Dialogue: 50,0:02:22.83,0:02:29.96,Main-207-,,0,0,0,,Üstelik, ona özenen ve peşinden giden aşçılar da korsanlar kadar asabi.Dialogue: 50,0:02:30.59,0:02:35.55,Main-207-,,0,0,0,,Korsanların uğrak yeri için biçilmiş kaftanlar.Dialogue: 50,0:02:35.55,0:02:39.01,Main-207-,,0,0,0,,Burası oldukça deli bir mekan.Dialogue: 50,0:02:39.01,0:02:42.02,Main-207-,,0,0,0,,Evet, buralarda işler böyle yürür.Dialogue: 50,0:02:42.02,0:02:46.81,Main-207-,,0,0,0,,Bazı insanlar, sadece aşçılarla korsanların kapışmasını izlemeye gelir.Dialogue: 50,0:02:47.23,0:02:52.61,Main-207-,,0,0,0,,Bu yüzden bütün garsonlar korktu ve kaçıp gitti.Dialogue: 50,0:02:53.24,0:02:57.24,Main-207-,,0,0,0,,Anladım… Yani bu yüzden bir yıl boyunca çalışmamı istedi.Dialogue: 50,0:02:57.99,0:03:00.03,Main-207-,,0,0,0,,Hey, tayfamıza katılsana.Dialogue: 50,0:03:00.03,0:03:01.79,Main-207-,,0,0,0,,Reddediyorum.Dialogue: 50,0:03:02.29,0:03:05.96,Main-207-,,0,0,0,,Burada kalmak için sebeplerim var.Dialogue: 50,0:03:06.29,0:03:06.96,Main-207-,,0,0,0,,Hayır!Dialogue: 50,0:03:06.96,0:03:07.83,Main-207-,,0,0,0,,Reddediyorum.Dialogue: 50,0:03:08.42,0:03:09.17,Main-207-,,0,0,0,,Ne dedin?!Dialogue: 50,0:03:09.71,0:03:12.84,Main-207-,,0,0,0,,Senin reddini reddediyorum!Dialogue: 50,0:03:12.84,0:03:16.34,Main-207-,,0,0,0,,Sen iyi bir aşçısın, o yüzden beraber korsan olalım.Dialogue: 50,0:03:16.97,0:03:19.55,Main-207-,,0,0,0,,H-Hey! Sebebimi duymadın daha!Dialogue: 50,0:03:19.55,0:03:20.81,Main-207-,,0,0,0,,Dinliyorum?Dialogue: 50,0:03:21.43,0:03:22.72,Main-207-,,0,0,0,,Seni ilgilendirmez!Dialogue: 50,0:03:24.02,0:03:25.60,Main-207-,,0,0,0,,Az önce dinlememi söyledin!Dialogue: 50,0:03:25.60,0:03:29.94,Main-207-,,0,0,0,,Kararımı kabul etmen gerektiğini söylüyordum!Dialogue: 50,0:03:29.94,0:03:32.94,Main-207-,,0,0,0,,Üç parçaya ayırırım seni, hasır şapkalı pislik!Dialogue: 50,0:03:32.94,0:03:33.86,Main-207-,,0,0,0,,Ne dedin sen?!Dialogue: 50,0:03:33.86,0:03:37.36,Main-207-,,0,0,0,,Hasır şapkam ile dalga geçersen seni yerle bir ederim, pislik!Dialogue: 50,0:03:38.11,0:03:40.20,Main-207-,,0,0,0,,Böldüğüm için üzgünüm...Dialogue: 50,0:03:40.20,0:03:41.08,Main-207-,,0,0,0,,– Ne?! – Ne?!Dialogue: 50,0:03:41.08,0:03:45.12,Main-207-,,0,0,5,,Ben Krieg Korsanları'ndan Gin.Dialogue: 50,0:03:45.12,0:03:47.08,Main-207-,,0,0,5,,Siz de korsansınız, değil mi?Dialogue: 50,0:03:47.62,0:03:49.21,Main-207-,,0,0,0,,Hedefiniz nedir?Dialogue: 50,0:03:49.21,0:03:51.59,Main-207-,,0,0,0,,One Piece'in peşindeyim.Dialogue: 50,0:03:51.59,0:03:53.50,Main-207-,,0,0,0,,Grand Line'a gidiyorum.Dialogue: 50,0:03:57.34,0:04:02.85,Main-207-,,0,0,0,,Bir aşçı aradığına göre, tayfanda fazla kişi yok gibi görünüyor.Dialogue: 50,0:04:02.85,0:04:04.72,Main-207-,,0,0,0,,Evet. Onunla beraber beş kişiyiz.Dialogue: 50,0:04:04.72,0:04:06.85,Main-207-,,0,0,0,,Beni neden sayıyorsun ki?!Dialogue: 50,0:04:06.85,0:04:10.98,Main-207-,,0,0,0,,Kötü birine benzemiyorsun, bu yüzden seni uyaracağım.Dialogue: 50,0:04:10.98,0:04:13.48,Main-207-,,0,0,0,,Grand Line'a gitmekten vazgeç.Dialogue: 50,0:04:13.48,0:04:17.11,Main-207-,,0,0,0,,Hala çok gençsin. Acele etmene gerek yok.Dialogue: 50,0:04:17.11,0:04:20.62,Main-207-,,0,0,0,,Grand Line dünyadaki denizlerin sadece küçük bir bölümü.Dialogue: 50,0:04:20.62,0:04:24.41,Main-207-,,0,0,0,,Bir korsan için çok daha güvenli sular var.Dialogue: 50,0:04:25.12,0:04:26.95,Main-207-,,0,0,0,,Oh, cidden mi?Dialogue: 50,0:04:27.33,0:04:29.96,Main-207-,,0,0,0,,Grand Line hakkında ne biliyorsun?Dialogue: 50,0:04:29.96,0:04:31.33,Main-207-,,0,0,0,,Hayır...Dialogue: 50,0:04:31.33,0:04:34.50,Main-207-,,0,0,0,,Hiçbir şey bilmiyorum... Hiçbir şey anlamıyorum...Dialogue: 50,0:04:34.88,0:04:36.76,Main-207-,,0,0,0,,İşte bu yüzden beni korkutuyor...Dialogue: 50,0:04:38.01,0:04:42.01,Main-207-,,0,0,0,,Krieg'in tayfasından birine göre, çok pısırıkça konuşuyorsun.Dialogue: 50,0:04:42.64,0:04:43.89,Main-207-,,0,0,0,,Krieg de kim?Dialogue: 50,0:04:52.52,0:04:54.27,Main-207-,,0,0,5,,Masa 3'e ordövr!Dialogue: 50,0:04:54.27,0:04:55.44,Main-207-,,0,0,5,,Kendin servis et.Dialogue: 50,0:04:55.44,0:04:57.11,Main-207-,,0,0,0,,Garsonumuz yok.Dialogue: 50,0:04:59.45,0:05:01.36,Main-207-,,0,0,0,,Cidden sıkıntı olmayacak mı, Patty?Dialogue: 50,0:05:01.36,0:05:02.11,Main-207-,,0,0,0,,Ne sıkıntısı?Dialogue: 50,0:05:03.70,0:05:06.74,Main-207-,,0,0,0,,Demin restoranda dövdüğün adamın...Dialogue: 50,0:05:06.74,0:05:09.87,Main-207-,,0,0,0,,Krieg Korsanları'ndan biri olduğunu duydum.Dialogue: 50,0:05:09.87,0:05:12.58,Main-207-,,0,0,0,,Evet, doğru duymuşsun.Dialogue: 50,0:05:12.58,0:05:18.21,Main-207-,,0,0,0,,Don Krieg bu sulardaki, en adi ve en acımasız korsan.Dialogue: 50,0:05:18.21,0:05:19.34,Main-207-,,0,0,0,,Bu doğru.Dialogue: 50,0:05:23.09,0:05:28.39,Main-207-,,0,0,0,,Kırk kaplan gücünde değil belki ama...Dialogue: 50,0:05:28.39,0:05:33.40,Main-207-,,0,0,0,,50 kaptanlık bir filonun başı sonuçta.Dialogue: 50,0:05:34.31,0:05:36.94,Main-207-,,0,0,0,,O bir canavardan farksız.Dialogue: 50,0:05:36.94,0:05:38.86,Main-207-,,0,0,0,,Öyleyse ne olmuş?Dialogue: 50,0:05:39.94,0:05:44.66,Main-207-,,0,0,0,,Söylenene göre ordusu 5.000’i aşkın korsandan oluşuyor.Dialogue: 50,0:05:46.45,0:05:53.71,Main-207-,,0,0,0,,Eğer o adam ona nasıl davrandığımızı Don Krieg'e anlatırsa,Dialogue: 50,0:05:54.08,0:06:00.84,Main-207-,,0,0,0,,buradaki herkes, fil sürüsünün altında ezilen karıncalara dönerdi.Dialogue: 50,0:06:00.84,0:06:02.72,Main-207-,,0,0,0,,Öyle mi...?Dialogue: 50,0:06:03.05,0:06:08.43,Main-207-,,0,0,0,,Yani, bedava yemesi daha mı iyi olurdu?Dialogue: 50,0:06:08.43,0:06:12.14,Main-207-,,0,0,0,,O zaman da ücretini ödeyen müşterilere kabalık olurdu.Dialogue: 50,0:06:14.60,0:06:20.94,Main-207-,,0,0,0,,Bu, Baratie dövüşçü aşçılarının itibarını yerle bir ederdi!Dialogue: 50,0:06:21.32,0:06:26.99,Main-207-,,0,0,0,,Bugüne kadar kaç korsanı alt ettiğimizi sanıyorsun?Dialogue: 50,0:06:26.99,0:06:29.45,Main-207-,,0,0,0,,Eğer o kadar korkuyorsan, bu işi bırak!Dialogue: 50,0:06:29.45,0:06:30.62,Main-207-,,0,0,0,,Ne dedin sen!?Dialogue: 50,0:06:30.62,0:06:34.83,Main-207-,,0,0,0,,Ah evet, tüm garsonlar senin o bozuk ağzın yüzünden işi bıraktı!Dialogue: 50,0:06:34.83,0:06:38.38,Main-207-,,0,0,0,,Patty, bu durumda suç sende!Dialogue: 50,0:06:38.84,0:06:43.72,Main-207-,,0,0,0,,O pısırık herifler başından beri işe yaramazlardı zaten!Dialogue: 50,0:06:44.13,0:06:45.38,Main-207-,,0,0,0,,Hadi bakalım!Dialogue: 50,0:06:45.38,0:06:46.59,Main-207-,,0,0,0,,Carne, bitir işini!Dialogue: 50,0:06:46.59,0:06:48.14,Main-207-,,0,0,0,,Patty, patakla onu!Dialogue: 50,0:06:49.22,0:06:50.97,Main-207-,,0,0,0,,Hey, sizi aptallar!Dialogue: 50,0:06:50.97,0:06:52.98,Main-207-,,0,0,0,,İşinizin başına dönün!Dialogue: 50,0:06:52.98,0:06:54.94,Main-207-,,0,0,0,,– Emredersiniz, Patron! – Emredersiniz, Patron!Dialogue: 50,0:06:56.52,0:06:57.86,Main-207-,,0,0,0,,Görüşürüz...Dialogue: 50,0:06:57.86,0:07:00.73,Main-207-,,0,0,0,,Bu arada, Grand Line'a yine de gideceğim.Dialogue: 50,0:07:00.73,0:07:01.65,Main-207-,,0,0,0,,Tabii...Dialogue: 50,0:07:01.65,0:07:03.40,Main-207-,,0,0,0,,İstediğini yap.Dialogue: 50,0:07:03.90,0:07:07.11,Main-207-,,0,0,0,,Benim gibi bir yabancının seni durdurmaya hakkı yok.Dialogue: 50,0:07:07.11,0:07:10.33,Main-207-,,0,0,0,,Sadece seni uyarmak istedim.Dialogue: 50,0:07:10.33,0:07:12.37,Main-207-,,0,0,0,,Ve Sanji-san...Dialogue: 50,0:07:12.37,0:07:14.21,Main-207-,,0,0,0,,Çok teşekkür ederim!Dialogue: 50,0:07:14.71,0:07:16.71,Main-207-,,0,0,0,,Sana hayatımı borçluyum.Dialogue: 50,0:07:16.71,0:07:19.54,Main-207-,,0,0,0,,O yemek gerçekten çok lezzetliydi.Dialogue: 50,0:07:19.54,0:07:21.50,Main-207-,,0,0,0,,Yine gelebilir miyim?Dialogue: 50,0:07:21.88,0:07:23.42,Main-207-,,0,0,0,,İstediğin zaman!Dialogue: 50,0:07:23.42,0:07:26.26,Main-207-,,0,0,0,,Hey, kamarot velet!Dialogue: 50,0:07:26.63,0:07:27.47,Main-207-,,0,0,0,,İhtiyar!Dialogue: 50,0:07:27.47,0:07:29.14,Main-207-,,0,0,0,,Buradasın demek!Dialogue: 50,0:07:33.39,0:07:35.02,Main-207-,,0,0,0,,Git, Gin.Dialogue: 50,0:07:36.23,0:07:37.65,Main-207-,,0,0,0,,Üzgünüm.Dialogue: 50,0:07:37.65,0:07:41.40,Main-207-,,0,0,0,,Bana bedava yedirdiğin için sorun yaşacayaksın, değil mi?Dialogue: 50,0:07:41.86,0:07:43.48,Main-207-,,0,0,0,,Yani...Dialogue: 50,0:07:53.54,0:07:56.21,Main-207-,,0,0,0,,Kanıt olmadan ceza olmaz.Dialogue: 50,0:08:02.63,0:08:04.84,Main-207-,,0,0,0,,Bir sonraki sefere yakalanma, Gin!Dialogue: 50,0:08:04.84,0:08:06.67,Main-207-,,0,0,0,,Teşekkürler, Sanji-san!Dialogue: 50,0:08:06.67,0:08:09.30,Main-207-,,0,0,0,,Nezaketini asla unutmayacağım!Dialogue: 50,0:08:09.30,0:08:11.39,Main-207-,,0,0,0,,Sanji! Kamarot!Dialogue: 50,0:08:11.39,0:08:13.39,Main-207-,,0,0,0,,İşe dönün artık!Dialogue: 50,0:08:14.18,0:08:16.81,Main-207-,,0,0,0,,Hey, masa üç hazır!Dialogue: 50,0:08:20.27,0:08:21.40,Main-207-,,0,0,5,,Ben Luffy!Dialogue: 50,0:08:21.40,0:08:23.23,Main-207-,,0,0,5,,Yeni kamarotunuzum.Dialogue: 50,0:08:23.23,0:08:24.94,Main-207-,,0,0,5,,Tanıştığımıza memnun oldum!Dialogue: 50,0:08:39.42,0:08:41.71,Main-207-,,0,0,0,,Masa altının tatlısı hazır olmadı mı?Dialogue: 50,0:08:42.92,0:08:45.30,Main-207-,,0,0,0,,Hey, o siparişten kim sorumlu?!Dialogue: 50,0:08:45.30,0:08:46.80,Main-207-,,0,0,0,,Sen değil misin?!Dialogue: 50,0:08:46.80,0:08:49.18,Main-207-,,0,0,0,,Ben çok meşgulüm şuan!Dialogue: 50,0:08:49.18,0:08:50.76,Main-207-,,0,0,0,,Aklını başına topla!Dialogue: 50,0:08:50.76,0:08:52.97,Main-207-,,0,0,0,,Ne dedin sen?! Kavga mı istiyorsun?!Dialogue: 50,0:08:55.22,0:08:59.64,Main-207-,,0,0,0,,– Boş boş oturma, bulaşıkları hallet, kamarot! – Boş boş oturma, bulaşıkları hallet, kamarot!Dialogue: 50,0:08:59.64,0:09:01.19,Main-207-,,0,0,0,,Sanji nerede?Dialogue: 50,0:09:01.94,0:09:03.90,Main-207-,,0,0,0,,Yemek salonunda flörtleşiyor.Dialogue: 50,0:09:03.90,0:09:05.15,Main-207-,,0,0,0,,Yine mi?!Dialogue: 50,0:09:05.15,0:09:10.36,Main-207-,,0,0,0,,Yardımcı şef olması beni yeterince sinirlendiriyor zaten!Dialogue: 50,0:09:10.74,0:09:12.03,Main-207-,,0,0,0,,Alış artık.Dialogue: 50,0:09:12.03,0:09:14.83,Main-207-,,0,0,0,,Burada en uzun süredir çalışan o.Dialogue: 50,0:09:15.33,0:09:20.92,Main-207-,,0,0,0,,Patron ile anlaşamıyorken neden burada olduğunu anlıyor musun?Dialogue: 50,0:09:20.92,0:09:23.46,Main-207-,,0,0,0,,Baş şef olmayı hedefliyor.Dialogue: 50,0:09:23.46,0:09:25.42,Main-207-,,0,0,0,,Anlamaman için kör olman lazım.Dialogue: 50,0:09:30.30,0:09:32.09,Main-207-,,0,0,0,,Hey, Kamarot!Dialogue: 50,0:09:32.09,0:09:35.47,Main-207-,,0,0,0,,Şimdiye kadar kaç tane tabak kırdın?!Dialogue: 50,0:09:35.47,0:09:38.14,Main-207-,,0,0,0,,Oh, üzgünüm. Saymayı unuttum.Dialogue: 50,0:09:38.14,0:09:41.98,Main-207-,,0,0,0,,Demek istediğim bu değildi! Onları kırdığın için özür dile!Dialogue: 50,0:09:41.98,0:09:45.11,Main-207-,,0,0,0,,Bulaşıkları yıkamayı unut. Şurayı temizle!Dialogue: 50,0:09:45.11,0:09:46.48,Main-207-,,0,0,0,,Tamamdır, bana bırak!Dialogue: 50,0:09:48.48,0:09:50.44,Main-207-,,0,0,0,,Tabaklardan bir şeyler alma!Dialogue: 50,0:09:50.44,0:09:53.07,Main-207-,,0,0,0,,Ana yemekti o!Dialogue: 50,0:09:53.74,0:09:55.49,Main-207-,,0,0,0,,Ah, merak etmeyin!Dialogue: 50,0:09:55.49,0:09:57.41,Main-207-,,0,0,0,,Ay!Dialogue: 50,0:09:59.50,0:10:03.00,Secondary-207-,,0,0,0,,Ah, ah, ah, ah, ah, ah, ah!Dialogue: 50,0:10:00.50,0:10:03.00,Main-207-,,0,0,0,,– Defol git, mutfaktan! – Defol git, mutfaktan!Dialogue: 50,0:10:03.46,0:10:05.96,Main-207-,,0,0,0,,Git ve siparişleri al, tamam mı?Dialogue: 50,0:10:06.46,0:10:10.30,Main-207-,,0,0,0,,Müşterilere ne yemek istediklerini sor! Bu kadarını yapabilirsin, değil mi?!Dialogue: 50,0:10:10.30,0:10:11.59,Main-207-,,0,0,0,,Evet.Dialogue: 50,0:10:11.59,0:10:13.88,Main-207-,,0,0,0,,Kamarotluk çok zor.Dialogue: 50,0:10:13.88,0:10:15.43,Main-207-,,0,0,0,,Koby perişan olmuş olmalı.Dialogue: 50,0:10:15.43,0:10:17.47,Main-207-,,0,0,0,,Hey, Kamarot!Dialogue: 50,0:10:18.39,0:10:19.39,Main-207-,,0,0,0,,Çocuklar...Dialogue: 50,0:10:19.39,0:10:21.81,Main-207-,,0,0,0,,Burada bir yıl çalışman gerekiyormuş!Dialogue: 50,0:10:21.81,0:10:23.89,Main-207-,,0,0,0,,Geminin bayrağını değiştirsek olur mu?Dialogue: 50,0:10:23.89,0:10:28.65,Main-207-,,0,0,0,,S-S-Sizin bensiz böyle lezzetli yemekler yemeniz...Dialogue: 50,0:10:28.65,0:10:30.07,Main-207-,,0,0,0,,canımı yakıyor!Dialogue: 50,0:10:30.07,0:10:32.82,Main-207-,,0,0,0,,Yemememiz için hiç bir sebep yok, değil mi?Dialogue: 50,0:10:34.16,0:10:34.78,Main-207-,,0,0,0,,Al bunu!Dialogue: 50,0:10:35.99,0:10:37.24,Main-207-,,0,0,0,,Evet, yok.Dialogue: 50,0:10:38.62,0:10:41.91,Main-207-,,0,0,0,,Her neyse, cidden buranın yemeği çok lezzetli.Dialogue: 50,0:10:43.75,0:10:44.83,Main-207-,,0,0,0,,Senin için...Dialogue: 50,0:10:45.54,0:10:47.67,Main-207-,,0,0,0,,üzülüyorum, ama...Dialogue: 50,0:10:48.38,0:10:50.71,Main-207-,,0,0,0,,Bunu kendin iç!Dialogue: 50,0:10:52.72,0:10:55.05,Secondary-207-,,0,0,0,,Bunu yaptığına inanamıyorum!Dialogue: 50,0:10:55.55,0:10:57.89,Main-207-,,0,0,0,,Asıl ben inanamıyorum!Dialogue: 50,0:10:57.89,0:11:00.01,Main-207-,,0,0,0,,Çok iğrenç! Çok iğrenç!Dialogue: 50,0:10:57.51,0:11:00.01,Secondary-207-,,0,0,0,,Gülmekten karnım ağrıyor!Dialogue: 50,0:11:07.23,0:11:09.19,Main-207-,,0,0,0,,Bir susmadılar.Dialogue: 50,0:11:09.19,0:11:09.98,Main-207-,,0,0,0,,Yoksa onlar...Dialogue: 50,0:11:10.40,0:11:12.65,Main-207-,,0,0,0,,onun tayfası mı?Dialogue: 50,0:11:16.91,0:11:18.41,Main-207-,,0,0,0,,Kendin doldur.Dialogue: 50,0:11:19.12,0:11:20.95,Main-207-,,0,0,0,,Oh, sevgili okyanus,Dialogue: 50,0:11:20.95,0:11:23.25,Main-207-,,0,0,0,,Bu güzel karşılaşma için sana minnettarım!Dialogue: 50,0:11:23.25,0:11:24.04,Main-207-,,0,0,0,,– Ne?! – Ne?!Dialogue: 50,0:11:24.04,0:11:26.12,Main-207-,,0,0,0,,Ah, aşk,...Dialogue: 50,0:11:26.12,0:11:28.50,Main-207-,,0,0,0,,bu yokluk ile başa çıkamıyorum.Dialogue: 50,0:11:28.50,0:11:29.96,Main-207-,,0,0,0,,Durmayın ve bana gülün.Dialogue: 50,0:11:30.46,0:11:35.59,Main-207-,,0,0,0,,Artık senin ile beraber olabilmek için bir korsan hatta bir şeytan bile...Dialogue: 50,0:11:35.59,0:11:36.72,Main-207-,,0,0,0,,olmaya hazırım!Dialogue: 50,0:11:38.72,0:11:41.06,Main-207-,,0,0,0,,Ancak, ne kadar trajik!Dialogue: 50,0:11:41.06,0:11:44.27,Main-207-,,0,0,0,,Aramızdaki engeller devasa!Dialogue: 50,0:11:44.27,0:11:47.69,Main-207-,,0,0,0,,O engel benim, değil mi...Dialogue: 50,0:11:47.69,0:11:48.98,Main-207-,,0,0,0,,Sanji?Dialogue: 50,0:11:48.98,0:11:50.56,Main-207-,,0,0,0,,Moruk...!Dialogue: 50,0:11:50.56,0:11:55.44,Main-207-,,0,0,0,,Bu iyi bir fırsat. Neden onlara katılmıyorsun?Dialogue: 50,0:11:55.44,0:11:58.74,Main-207-,,0,0,0,,Artık bu restoranda sana ihtiyaç yok!Dialogue: 50,0:12:14.21,0:12:15.67,Main-207-,,0,0,0,,Anladım...Dialogue: 50,0:12:16.17,0:12:21.55,Main-207-,,0,0,0,,Hayatın o aşçı tarafından kurtarıldı ve böylece buraya geri dönebildin.Dialogue: 50,0:12:21.55,0:12:25.02,Main-207-,,0,0,0,,Bunu mu demek istiyorsun, Gin?Dialogue: 50,0:12:25.52,0:12:26.98,Main-207-,,0,0,0,,E-Evet...Dialogue: 50,0:12:26.98,0:12:28.98,Main-207-,,0,0,0,,A-Ama...Dialogue: 50,0:12:29.35,0:12:33.23,Main-207-,,0,0,0,,Ana gemimizin bu durumda olduğunu bilmiyordum...Dialogue: 50,0:12:33.23,0:12:34.65,Main-207-,,0,0,0,,Don Krieg!Dialogue: 50,0:12:34.65,0:12:36.07,Main-207-,,0,0,0,,Ne?Dialogue: 50,0:12:38.61,0:12:39.91,Main-207-,,0,0,0,,Seni oraya götüreceğim,Dialogue: 50,0:12:39.91,0:12:42.66,Main-207-,,0,0,0,,Deniz Restoranı Baratie'ye.Dialogue: 50,0:12:47.16,0:12:48.83,Main-207-,,0,0,0,,Hey, moruk!Dialogue: 50,0:12:48.83,0:12:51.13,Main-207-,,0,0,0,,Yardımcı şef var karşında.Dialogue: 50,0:12:51.13,0:12:53.63,Main-207-,,0,0,0,,Artık bana ihtiyacınız yok da ne demek?!Dialogue: 50,0:12:53.63,0:12:56.01,Main-207-,,0,0,0,,Müşteriler ile sık sık sorun yaşıyorsun.Dialogue: 50,0:12:56.01,0:12:59.26,Main-207-,,0,0,0,,Bir kadın gördüğün anda burun deliklerin genişliyor.Dialogue: 50,0:12:59.26,0:13:01.34,Main-207-,,0,0,0,,Ortalama bir yemek bile yapamıyorsun,Dialogue: 50,0:13:01.34,0:13:04.14,Main-207-,,0,0,0,,o yüzden bu restoran için ölü ağırlıksın.Dialogue: 50,0:13:04.14,0:13:05.64,Main-207-,,0,0,0,,Bu yüzden sana ihtiyacım yok.Dialogue: 50,0:13:05.64,0:13:07.47,Main-207-,,0,0,0,,Ne dedin?Dialogue: 50,0:13:10.56,0:13:14.11,Main-207-,,0,0,0,,Diğer aşçılar ile de iyi geçinemiyorsun.Dialogue: 50,0:13:14.11,0:13:20.03,Main-207-,,0,0,0,,O yüzden korsan veya ne oluyorsan ol ve bu restoranı terk et artık!Dialogue: 50,0:13:21.03,0:13:22.66,Main-207-,,0,0,0,,Bu da ne demek?Dialogue: 50,0:13:23.53,0:13:27.87,Main-207-,,0,0,0,,Susmayacaksın, değil mi, seni yaşlı bunak?Dialogue: 50,0:13:28.83,0:13:33.42,Main-207-,,0,0,0,,Her şeyi görmezden gelirim ama aşçılığıma laf ettirmem!Dialogue: 50,0:13:33.96,0:13:37.84,Main-207-,,0,0,0,,Ne dersen de, burada aşçılık yapacağım!Dialogue: 50,0:13:37.84,0:13:39.63,Main-207-,,0,0,0,,Bir kelime daha duymak istemiyorum!Dialogue: 50,0:13:39.63,0:13:43.51,Main-207-,,0,0,0,,Patronunun yakasına yapışmak da ne demek oluyor?Dialogue: 50,0:13:43.51,0:13:45.80,Main-207-,,0,0,0,,Sen lanet patlıcan!Dialogue: 50,0:13:47.56,0:13:50.10,Main-207-,,0,0,0,,Lanet olsun...Dialogue: 50,0:13:51.98,0:13:54.86,Main-207-,,0,0,0,,Beni ne kadar buradan atmaya uğraşırsan uğraş,Dialogue: 50,0:13:54.86,0:13:58.44,Main-207-,,0,0,0,,burada bir aşçı olarak çalışmaya devam edeceğim.Dialogue: 50,0:13:58.44,0:14:00.44,Main-207-,,0,0,0,,Sen ölene kadar!Dialogue: 50,0:14:00.44,0:14:02.32,Main-207-,,0,0,0,,Çok beklersin!Dialogue: 50,0:14:02.32,0:14:04.20,Main-207-,,0,0,0,,Yüz yıl daha yaşayacağım.Dialogue: 50,0:14:04.20,0:14:06.41,Main-207-,,0,0,0,,Bu moruğun da hiç lafı bitmiyor...Dialogue: 50,0:14:06.41,0:14:09.29,Main-207-,,0,0,0,,Tamamdır, izin aldın! Artık bir korsan olabilirsin!Dialogue: 50,0:14:09.29,0:14:10.41,Main-207-,,0,0,0,,Asla!Dialogue: 50,0:14:10.95,0:14:12.50,Main-207-,,0,0,0,,Her neyse...Dialogue: 50,0:14:12.87,0:14:14.29,Main-207-,,0,0,0,,Deminki olay için üzgünüm.Dialogue: 50,0:14:14.29,0:14:17.46,Main-207-,,0,0,0,,Özür olarak, bu meyve salatasını kabul edin, prensesim.Dialogue: 50,0:14:17.46,0:14:19.67,Main-207-,,0,0,0,,Vay, teşekkürler!Dialogue: 50,0:14:19.67,0:14:20.67,Main-207-,,0,0,0,,Çok naziksin.Dialogue: 50,0:14:20.67,0:14:21.42,Main-207-,,0,0,0,,Lafı olmaz...Dialogue: 50,0:14:21.42,0:14:23.59,Main-207-,,0,0,0,,Bizden özür dilemeyecek misin?!Dialogue: 50,0:14:23.59,0:14:26.22,Main-207-,,0,0,0,,Seni şikayet edeceğim, aptal aşk aşçısı!Dialogue: 50,0:14:26.22,0:14:28.93,Main-207-,,0,0,0,,Size çay servis ediyorum, değil mi?Dialogue: 50,0:14:28.93,0:14:30.72,Main-207-,,0,0,0,,Buna şükret, uzun burun.Dialogue: 50,0:14:30.72,0:14:32.23,Main-207-,,0,0,0,,Ha? Kavga mı istiyorsun?Dialogue: 50,0:14:32.23,0:14:34.06,Main-207-,,0,0,0,,Kendimi tutmam ama.Dialogue: 50,0:14:34.06,0:14:35.65,Main-207-,,0,0,0,,Bitir işini, Zoro!Dialogue: 50,0:14:35.65,0:14:37.19,Main-207-,,0,0,0,,Kendin yap.Dialogue: 50,0:14:37.19,0:14:39.69,Main-207-,,0,0,0,,Durun! Lütfen benim için dövüşmeyin.Dialogue: 50,0:14:39.69,0:14:40.69,Main-207-,,0,0,0,,Tamam, duracağım.Dialogue: 50,0:14:40.69,0:14:42.82,Main-207-,,0,0,0,,Kim senin için olduğunu söyledi?!Dialogue: 50,0:14:42.82,0:14:44.11,Main-207-,,0,0,0,,Bu arada...Dialogue: 50,0:14:44.11,0:14:44.91,Main-207-,,0,0,0,,Evet?Dialogue: 50,0:14:44.91,0:14:47.03,Main-207-,,0,0,0,,Buradaki yemekler çok lezzetli...Dialogue: 50,0:14:47.03,0:14:49.41,Main-207-,,0,0,0,,ama benim için biraz pahalılar.Dialogue: 50,0:14:49.41,0:14:51.04,Main-207-,,0,0,0,,Oh, tabii ki size ücretsiz.Dialogue: 50,0:14:51.04,0:14:52.54,Main-207-,,0,0,0,,Teşekkürler!Dialogue: 50,0:14:53.58,0:14:55.62,Main-207-,,0,0,0,,Siz ödemek zorundasınız.Dialogue: 50,0:14:54.54,0:14:55.62,Secondary-207-,,0,0,0,,Ne...?!Dialogue: 50,0:14:55.62,0:14:57.84,Thoughts-207-,,0,0,0,,Çok tahmin edilebilirsin.Dialogue: 50,0:14:59.96,0:15:02.30,Main-207-,,0,0,0,,Niye orada dikiliyorsun?!Dialogue: 50,0:15:02.30,0:15:04.55,Main-207-,,0,0,0,,Müşterilere sıcak havlu getir!Dialogue: 50,0:15:04.55,0:15:05.55,Main-207-,,0,0,0,,Emredersin.Dialogue: 50,0:15:37.67,0:15:42.17,Main-207-,,0,0,0,,Düşmanları uyarmak için konulan kurukafanın etrafındaki kum saatleri.Dialogue: 50,0:15:42.50,0:15:44.30,Main-207-,,0,0,0,,O bayrak!Dialogue: 50,0:15:44.30,0:15:46.05,Main-207-,,0,0,0,,O bayrak...!Dialogue: 50,0:15:46.05,0:15:49.68,Main-207-,,0,0,0,,Doğu Mavi'nin en güçlü adamı,Dialogue: 50,0:15:50.22,0:15:52.64,Main-207-,,0,0,0,,Don Krieg!Dialogue: 50,0:16:06.70,0:16:07.57,Main-207-,,0,0,0,,Neden...?!Dialogue: 50,0:16:07.57,0:16:10.37,Main-207-,,0,0,0,,Neden Krieg Korsanları burada?!Dialogue: 50,0:16:10.37,0:16:13.33,Main-207-,,0,0,0,,Gördün mü, Patty?! Gerçekten de geldiler!Dialogue: 50,0:16:13.33,0:16:15.33,Main-207-,,0,0,0,,Onlardan kurtulacaksın, değil mi?!Dialogue: 50,0:16:15.33,0:16:17.08,Main-207-,,0,0,0,,B-Bu olamaz!Dialogue: 50,0:16:17.08,0:16:20.08,Main-207-,,0,0,0,,Adam, 5.000 korsandan oluşan bir filonun komutanı!Dialogue: 50,0:16:20.08,0:16:23.34,Main-207-,,0,0,0,,Tek bir adamı için intikam almaya neden gelsin?!Dialogue: 50,0:16:23.34,0:16:24.84,Main-207-,,0,0,0,,Hata falan yok!Dialogue: 50,0:16:24.84,0:16:26.67,Main-207-,,0,0,0,,O cidden burada!Dialogue: 50,0:16:26.67,0:16:27.93,Main-207-,,0,0,0,,Hey, bu hiç iyi değil!Dialogue: 50,0:16:27.93,0:16:30.18,Main-207-,,0,0,0,,Buradan gitmemiz gerekmiyor mu?!Dialogue: 50,0:16:30.18,0:16:32.64,Main-207-,,0,0,0,,Ne kadar da büyük bir kalyon!Dialogue: 50,0:16:39.98,0:16:41.86,Main-207-,,0,0,0,,Ne kadar da devasa bir gemi!Dialogue: 50,0:16:41.86,0:16:44.78,Main-207-,,0,0,0,,Belki de Gin, teşekkür etmek için döndü.Dialogue: 50,0:16:44.78,0:16:47.28,Main-207-,,0,0,0,,Bundan şüpheliyim...Dialogue: 50,0:16:47.28,0:16:49.11,Main-207-,,0,0,0,,Ama bir şeyler garip...Dialogue: 50,0:16:48.20,0:16:49.11,Secondary-207-,,0,0,0,,Ha?Dialogue: 50,0:16:58.04,0:16:59.29,Main-207-,,0,0,0,,H-Hey...Dialogue: 50,0:16:59.29,0:17:00.96,Main-207-,,0,0,0,,B-Bu da ne...?Dialogue: 50,0:17:08.42,0:17:11.39,Main-207-,,0,0,0,,Gemileri cidden darmadağın...Dialogue: 50,0:17:11.39,0:17:14.35,Main-207-,,0,0,0,,Top ateşi yüzünden bu hale gelmiş gibi durmuyor.Dialogue: 50,0:17:15.10,0:17:18.06,Main-207-,,0,0,0,,Bunu bir insan da yapmış olamaz.Dialogue: 50,0:17:18.06,0:17:20.27,Main-207-,,0,0,0,,Bir hortumdan mı geçtiler?Dialogue: 50,0:17:22.35,0:17:24.19,Main-207-,,0,0,0,,İşte geliyor...Dialogue: 50,0:17:46.46,0:17:47.96,Main-207-,,0,0,0,,Ü-Üzgünüm...Dialogue: 50,0:17:49.17,0:17:52.93,Main-207-,,0,0,0,,Biraz su ve yemek alabilir miyim?Dialogue: 50,0:17:53.47,0:17:55.43,Main-207-,,0,0,0,,Paramız var...Dialogue: 50,0:17:55.43,0:17:57.85,Main-207-,,0,0,0,,tonla var...Dialogue: 50,0:17:59.52,0:18:01.27,Main-207-,,0,0,0,,N-Ne diyor bu?!Dialogue: 50,0:18:01.27,0:18:03.40,Main-207-,,0,0,0,,Ne saygın ne de kudretli gözüküyor.Dialogue: 50,0:18:03.40,0:18:08.28,Main-207-,,0,0,0,,Gerçekten o, devasa korsan filosuna sahip Komodor Don Krieg mi?Dialogue: 50,0:18:08.28,0:18:10.61,Main-207-,,0,0,0,,Demek ki acıkmış...Dialogue: 50,0:18:15.74,0:18:17.41,Main-207-,,0,0,0,,K-Kaptan!Dialogue: 50,0:18:18.95,0:18:20.45,Main-207-,,0,0,0,,Don Krieg!Dialogue: 50,0:18:22.08,0:18:23.50,Main-207-,,0,0,0,,L-Lütfen!Dialogue: 50,0:18:23.50,0:18:25.21,Main-207-,,0,0,0,,Kaptanımıza yardım edin!Dialogue: 50,0:18:25.79,0:18:27.59,Main-207-,,0,0,0,,Açlıktan ölmek üzere!Dialogue: 50,0:18:28.13,0:18:32.17,Main-207-,,0,0,0,,Günlerdir hiçbir şey yemedi, böyle giderse ölecek!Dialogue: 50,0:18:40.43,0:18:42.27,Main-207-,,0,0,0,,Bu harika!Dialogue: 50,0:18:42.27,0:18:46.61,Main-207-,,0,0,0,,Büyük haydut Don Krieg'i böyle acınası bir durumda görmek!Dialogue: 50,0:18:46.61,0:18:48.44,Main-207-,,0,0,0,,Bu sefer param var.Dialogue: 50,0:18:48.44,0:18:49.86,Main-207-,,0,0,0,,Biz müşteriyiz!Dialogue: 50,0:18:49.86,0:18:51.99,Main-207-,,0,0,0,,Saçmalamayı kes!Dialogue: 50,0:18:51.99,0:18:54.36,Main-207-,,0,0,0,,Hey, hemen Donanma'ya haber verin.Dialogue: 50,0:18:54.36,0:18:55.16,Main-207-,,0,0,0,,Ne?Dialogue: 50,0:18:55.16,0:18:58.87,Main-207-,,0,0,0,,Şu anda olabileceği en güçsüz halde, böyle bir şansı tekrar bulamayız!Dialogue: 50,0:18:58.87,0:19:00.49,Main-207-,,0,0,0,,Ona hiçbir şey yedirmeyin!Dialogue: 50,0:19:00.49,0:19:01.91,Main-207-,,0,0,0,,Sadece yakalayın!Dialogue: 50,0:19:02.62,0:19:05.96,Main-207-,,0,0,0,,O haklı! Enerjisini geri kazandığında ne yapacağını bilmiyoruz.Dialogue: 50,0:19:05.96,0:19:07.63,Main-207-,,0,0,0,,O bir cani.Dialogue: 50,0:19:07.63,0:19:12.34,Main-207-,,0,0,0,,Yaptıkları yüzünden aç kalmayı hakediyor!Dialogue: 50,0:19:12.34,0:19:16.47,Main-207-,,0,0,0,,Kendine geldikten sonra, bu restorana saldıracağı çok belli.Dialogue: 50,0:19:16.47,0:19:19.10,Main-207-,,0,0,0,,Bir bardak su bile vermeyin.Dialogue: 50,0:19:20.68,0:19:23.14,Main-207-,,0,0,0,,Hiçbir şey yapmayacağım.Dialogue: 50,0:19:25.31,0:19:27.06,Main-207-,,0,0,0,,Hiçbir şey yapmayacağım.Dialogue: 50,0:19:27.06,0:19:29.27,Main-207-,,0,0,0,,Karnımı doyurduğum gibi,Dialogue: 50,0:19:29.27,0:19:31.61,Main-207-,,0,0,0,,usluca buradan gideceğim.Dialogue: 50,0:19:31.61,0:19:35.28,Main-207-,,0,0,0,,O yüzden lütfen... yardım... edin...Dialogue: 50,0:19:35.90,0:19:38.16,Main-207-,,0,0,0,,Don Krieg, lütfen dur!Dialogue: 50,0:19:38.16,0:19:40.53,Main-207-,,0,0,0,,Lütfen yalvarmayın!Dialogue: 50,0:19:40.53,0:19:42.29,Main-207-,,0,0,0,,Size yakışmıyor!Dialogue: 50,0:19:42.29,0:19:45.04,Main-207-,,0,0,0,,Lütfen böyle utanç verici bir şey yapmayın!Dialogue: 50,0:19:45.04,0:19:46.62,Main-207-,,0,0,0,,Söz veriyorum...Dialogue: 50,0:19:47.37,0:19:48.79,Main-207-,,0,0,0,,Lütfen...Dialogue: 50,0:19:48.79,0:19:52.09,Main-207-,,0,0,0,,Arta kalanlar da olur, herhangi bir şey de...Dialogue: 50,0:19:53.09,0:19:55.13,Main-207-,,0,0,0,,Her şey olur...Dialogue: 50,0:19:57.80,0:19:58.97,Main-207-,,0,0,0,,Don...Dialogue: 50,0:20:03.18,0:20:05.18,Main-207-,,0,0,0,,Kendini acındırmaya mı çalışıyorsun?Dialogue: 50,0:20:05.18,0:20:07.27,Main-207-,,0,0,0,,Hey, yolumdan çekil, Patty.Dialogue: 50,0:20:13.15,0:20:14.44,Main-207-,,0,0,0,,Oha!Dialogue: 50,0:20:15.40,0:20:16.11,Main-207-,,0,0,0,,Sa...Dialogue: 50,0:20:16.86,0:20:18.41,Main-207-,,0,0,0,,Sanji-san!Dialogue: 50,0:20:20.99,0:20:22.99,Main-207-,,0,0,0,,İşte, Gin.Dialogue: 50,0:20:22.99,0:20:24.58,Main-207-,,0,0,0,,Bunu yiyebilir.Dialogue: 50,0:20:27.12,0:20:28.58,Main-207-,,0,0,0,,Sanji-san...Dialogue: 50,0:20:34.46,0:20:35.51,Main-207-,,0,0,0,,Teşekkür ederim!Dialogue: 50,0:20:46.52,0:20:49.35,Main-207-,,0,0,0,,Hey, Sanji! Hemen o yemeği önünden al!Dialogue: 50,0:20:49.81,0:20:52.31,Main-207-,,0,0,0,,Onun nasıl biri olduğunu bilmiyor musun?!Dialogue: 50,0:20:52.73,0:20:55.82,Main-207-,,0,0,0,,O Doğu Mavi'nin en güçlüsü olarak bahsedilen,Dialogue: 50,0:20:55.82,0:20:57.57,Main-207-,,0,0,0,,Hileci Krieg!Dialogue: 50,0:20:59.15,0:21:03.41,Main-207-,,0,0,0,,Bu ismi hapishanede aldı. Bir donanma askeri gibi davrandı...Dialogue: 50,0:21:03.41,0:21:07.50,Main-207-,,0,0,0,,ve kıdemli bir subayı öldürerek geminin komutasını ele geçirdi.Dialogue: 50,0:21:07.50,0:21:10.17,Main-207-,,0,0,0,,Böylece kendini bir korsan ilan etti.Dialogue: 50,0:21:11.46,0:21:14.59,Main-207-,,0,0,0,,Bazen limanlara girerken Donanma bayrağını çeker,...Dialogue: 50,0:21:14.59,0:21:16.76,Main-207-,,0,0,0,,kasabaları ve yolcu gemilerini hedef alır.Dialogue: 50,0:21:16.76,0:21:19.93,Main-207-,,0,0,0,,Beyaz bayrak ççekerek düşman gemilere saldırdığı da olmuş.Dialogue: 50,0:21:19.93,0:21:22.14,Main-207-,,0,0,0,,O kazanmak için her şeyi yapar.Dialogue: 50,0:21:22.14,0:21:24.51,Main-207-,,0,0,0,,Şu anda bulunduğu konuma böyle erişti!Dialogue: 50,0:21:25.68,0:21:27.97,Main-207-,,0,0,0,,Ne? Kirli dövüşüyor demek.Dialogue: 50,0:21:27.97,0:21:31.06,Main-207-,,0,0,0,,Fiziksel gücü de küçümsenecek gibi değil.Dialogue: 50,0:21:31.06,0:21:32.94,Main-207-,,0,0,0,,Karnını doyurduktan sonra gitmek mi?Dialogue: 50,0:21:32.94,0:21:35.40,Main-207-,,0,0,0,,Öyle bir şey yapması imkansız!Dialogue: 50,0:21:35.40,0:21:40.24,Main-207-,,0,0,0,,Bu kadar zalim birinin ölmesine izin vermek, toplumun yararına olur!Dialogue: 50,0:21:56.50,0:21:57.75,Main-207-,,0,0,0,,Sa...Dialogue: 50,0:21:57.75,0:21:59.63,Main-207-,,0,0,0,,Sanji!Dialogue: 50,0:22:07.35,0:22:08.10,Main-207-,,0,0,0,,Bö...Dialogue: 50,0:22:08.10,0:22:10.43,Main-207-,,0,0,0,,Böyle anlaşmamıştık, Don Krieg!Dialogue: 50,0:22:10.77,0:22:14.69,Main-207-,,0,0,0,,Bu restorandaki kimseye dokunmaman koşulu ile seni buraya getirdim!Dialogue: 50,0:22:14.69,0:22:16.44,Main-207-,,0,0,0,,Ve o adam...Dialogue: 50,0:22:16.44,0:22:18.28,Main-207-,,0,0,0,,Bizim hayatımızı kurtardı...Dialogue: 50,0:22:22.82,0:22:25.12,Main-207-,,0,0,0,,Evet, çok lezzetliydi.Dialogue: 50,0:22:26.74,0:22:28.37,Main-207-,,0,0,0,,Tekrardan canlı hissediyorum.Dialogue: 50,0:22:43.80,0:22:45.84,Main-207-,,0,0,0,,H-Hey... N-Ne...?Dialogue: 50,0:22:45.84,0:22:49.35,Main-207-,,0,0,0,,O-Orada ne haltlar dönüyor?Dialogue: 50,0:22:49.35,0:22:50.72,Main-207-,,0,0,0,,Gidip öğrenelim.Dialogue: 50,0:22:50.72,0:22:52.56,Main-207-,,0,0,0,,Ne?! C-Ciddi misin sen?!Dialogue: 50,0:22:54.56,0:22:57.56,Main-207-,,0,0,0,,Ne kadar da güzel bir restoran.Dialogue: 50,0:22:57.56,0:22:59.69,Main-207-,,0,0,0,,Bu gemiyi alacağım.Dialogue: 50,0:23:02.65,0:23:04.40,Main-207-,,0,0,0,,Demek...Dialogue: 50,0:23:04.40,0:23:05.70,Main-207-,,0,0,0,,bu yüzden geldin...Dialogue: 50,0:23:06.16,0:23:07.87,Main-207-,,0,0,0,,Ah, ah, ah...Dialogue: 50,0:23:14.46,0:23:17.83,Main-207-,,0,0,0,,Benim gemim harabeye döndü,...Dialogue: 50,0:23:17.83,0:23:20.38,Main-207-,,0,0,0,,o yüzden yenisine ihtiyacım var.Dialogue: 50,0:23:20.75,0:23:24.80,Main-207-,,0,0,0,,Size söylediklerimi yaptıktan sonra gitmekte özgürsünüz.Dialogue: 50,0:23:24.80,0:23:26.22,Main-207-,,0,0,0,,N-Ne?!Dialogue: 50,0:23:26.22,0:23:30.10,Main-207-,,0,0,0,,Don Krieg, anlaştığımız bu değildi.Dialogue: 50,0:23:32.77,0:23:36.73,Main-207-,,0,0,0,,Gemimde hayatta kalan sadece 100 adam kaldı.Dialogue: 50,0:23:37.19,0:23:39.94,Main-207-,,0,0,0,,Açlıktan ölüyorlar ve ağır yaralılar.Dialogue: 50,0:23:40.82,0:23:46.24,Main-207-,,0,0,0,,Önce, onlar için 100 kişilik yemek ve su hazırlayın.Dialogue: 50,0:23:46.57,0:23:48.91,Main-207-,,0,0,0,,Bazıları çoktan açlıktan öldü.Dialogue: 50,0:23:50.20,0:23:52.83,Main-207-,,0,0,0,,S-Su...Dialogue: 50,0:23:56.25,0:23:58.04,Main-207-,,0,0,0,,Kaybedecek zaman yok!Dialogue: 50,0:23:58.83,0:24:01.46,Main-207-,,0,0,0,,Bu gemiye saldıracak olan korsanlaraDialogue: 50,0:24:01.80,0:24:03.88,Main-207-,,0,0,0,,yardım etmemizi mi istiyorsun?!Dialogue: 50,0:24:03.88,0:24:05.22,Main-207-,,0,0,0,,Reddediyoruz!Dialogue: 50,0:24:06.05,0:24:07.72,Main-207-,,0,0,0,,Reddetmek mi?Dialogue: 50,0:24:07.72,0:24:09.64,Main-207-,,0,0,0,,Beni yanlış anlamayın.Dialogue: 50,0:24:09.64,0:24:12.31,Main-207-,,0,0,0,,Sizden bir istekte bulunmuyorum.Dialogue: 50,0:24:12.31,0:24:14.35,Main-207-,,0,0,0,,Size emrediyorum.Dialogue: 50,0:24:14.35,0:24:15.85,Main-207-,,0,0,0,,Kim olursan ol...Dialogue: 50,0:24:15.85,0:24:21.98,Main-207-,,0,0,0,,sakın bana karşı gelmeye cüret etme!Dialogue: 50,0:24:26.95,0:24:28.61,Main-207-,,0,0,0,,Sanji-san...Dialogue: 50,0:24:29.49,0:24:31.74,Main-207-,,0,0,0,,Sanji-san, üzgünüm...Dialogue: 50,0:24:31.74,0:24:34.33,Main-207-,,0,0,0,,Bunun olmasını istemedim...Dialogue: 50,0:24:34.33,0:24:38.33,Main-207-,,0,0,0,,Seni pislik! Bizi bu pisliğe sen bulaştırdın!Dialogue: 50,0:24:56.56,0:24:59.19,Main-207-,,0,0,0,,Hey Sanji! Nereye gidiyorsun?!Dialogue: 50,0:25:01.15,0:25:02.52,Main-207-,,0,0,0,,Mutfağa.Dialogue: 50,0:25:03.02,0:25:06.15,Main-207-,,0,0,0,,100 kişilik yemek yapmam gerek.Dialogue: 50,0:25:06.90,0:25:07.65,Main-207-,,0,0,0,,Sanji-san!Dialogue: 50,0:25:07.65,0:25:08.65,Main-207-,,0,0,0,,Sanji?!Dialogue: 50,0:25:08.65,0:25:11.11,Main-207-,,0,0,0,,– Ne?! – Ne?!Dialogue: 50,0:25:11.91,0:25:13.20,Main-207-,,0,0,0,,Evet.Dialogue: 50,0:25:13.20,0:25:14.83,Main-207-,,0,0,0,,Olması gereken bu.Dialogue: 50,0:25:19.62,0:25:22.50,Main-207-,,0,0,0,,Krieg'in casusu falan mısın, Sanji?!Dialogue: 50,0:25:22.50,0:25:24.59,Main-207-,,0,0,0,,Mutfağa gitmene izin veremeyiz!Dialogue: 50,0:25:24.59,0:25:28.09,Main-207-,,0,0,0,,Senin bu çılgınca davranışlarından bıktık artık!Dialogue: 50,0:25:29.59,0:25:31.05,Main-207-,,0,0,0,,Durmayın.Dialogue: 50,0:25:32.39,0:25:34.47,Main-207-,,0,0,0,,Eğer beni durdurmak istiyorsanız, yapın!Dialogue: 50,0:25:37.47,0:25:39.39,Main-207-,,0,0,0,,Biliyorum...Dialogue: 50,0:25:39.77,0:25:43.86,Main-207-,,0,0,0,,Onun uslanmaz bir düzenbaz olduğunu ben de biliyorum.Dialogue: 50,0:25:46.11,0:25:48.74,Main-207-,,0,0,0,,Ama bu benim için hiçbir şey değiştirmiyor.Dialogue: 50,0:25:49.74,0:25:51.82,Main-207-,,0,0,0,,Benim için farketmez!Dialogue: 50,0:25:52.28,0:25:54.53,Main-207-,,0,0,0,,Onlara yemek verdikten sonra...Dialogue: 50,0:25:54.53,0:25:56.53,Main-207-,,0,0,0,,ne olacağı hiç umurumda değil.Dialogue: 50,0:25:56.53,0:25:57.70,Main-207-,,0,0,0,,Ben bir aşçıyım.Dialogue: 50,0:25:57.70,0:26:00.04,Main-207-,,0,0,0,,Ne eksik. Ne fazla.Dialogue: 50,0:26:00.04,0:26:03.04,Main-207-,,0,0,0,,Eğer birisi aç ise, onu besleyeceğim.Dialogue: 50,0:26:03.04,0:26:04.54,Main-207-,,0,0,0,,İşte o kadar.Dialogue: 50,0:26:05.92,0:26:07.21,Main-207-,,0,0,0,,Aşçının görevi...Dialogue: 50,0:26:07.21,0:26:09.42,Main-207-,,0,0,0,,bu değil midir?Dialogue: 50,0:26:17.56,0:26:18.52,Main-207-,,0,0,0,,Patty!Dialogue: 50,0:26:18.52,0:26:20.35,Main-207-,,0,0,0,,Hey, biri onu zapt etmeliydi!Dialogue: 50,0:26:21.52,0:26:27.36,Main-207-,,0,0,0,,Sanji, bazen arka kapıdan kovduğum müşterileri besliyorsun, değil mi?Dialogue: 50,0:26:27.86,0:26:33.32,Main-207-,,0,0,0,,Kim haklı, kim haksız bilmem ama bu sefer yanılıyorsun.Dialogue: 50,0:26:33.78,0:26:36.62,Main-207-,,0,0,0,,Artık istediğini yapmana izin vermeyeceğim.Dialogue: 50,0:26:36.62,0:26:38.74,Main-207-,,0,0,0,,Bu restoranı koruyacağım.Dialogue: 50,0:26:38.74,0:26:40.62,Main-207-,,0,0,0,,Tek düşmanımız var, neyse ki.Dialogue: 50,0:26:40.62,0:26:44.21,Main-207-,,0,0,0,,Bu kişi Don Krieg olsa bile, bize karşı ne yapabilir ki?Dialogue: 50,0:26:46.46,0:26:49.92,Main-207-,,0,0,0,,Burası her gün korsanların uğradığı bir restoran.Dialogue: 50,0:26:50.38,0:26:53.68,Main-207-,,0,0,0,,Her türden müşteriye hizmet vermeye hazırız!Dialogue: 50,0:26:53.68,0:26:54.84,Main-207-,,0,0,0,,Yoksa o...Dialogue: 50,0:26:54.84,0:26:58.47,Main-207-,,0,0,0,,Doydun mu, Krieg-san?Dialogue: 50,0:26:58.47,0:27:00.77,Main-207-,,0,0,0,,Ana yemekten sonra...Dialogue: 50,0:27:01.47,0:27:05.90,Main-207-,,0,0,0,,sıcak kurşundan bir tatlıya ne dersiniz?!Dialogue: 50,0:27:06.65,0:27:10.53,Main-207-,,0,0,0,,Bozuk Köfte!Dialogue: 50,0:27:26.50,0:27:27.54,Main-207-,,0,0,0,,Don!Dialogue: 50,0:27:32.76,0:27:35.01,Main-207-,,0,0,0,,Kapıyı kırdım sanırım.Dialogue: 50,0:27:35.01,0:27:37.01,Main-207-,,0,0,0,,Patron yine bana kızacak.Dialogue: 50,0:27:37.01,0:27:39.26,Main-207-,,0,0,0,,Restoranı korumak için yaptın sonuçta.Dialogue: 50,0:27:39.26,0:27:40.89,Main-207-,,0,0,0,,Küçük bir bedel sadece.Dialogue: 50,0:27:41.47,0:27:44.98,Main-207-,,0,0,0,,Krieg'in gemisindekiler ile ilgili ne yapmayı planlıyorsun?Dialogue: 50,0:27:44.98,0:27:46.23,Main-207-,,0,0,0,,Kim bilir?Dialogue: 50,0:27:46.23,0:27:49.31,Main-207-,,0,0,0,,Belki de gemiye tereyağı sürüp tavada kızartırız.Dialogue: 50,0:27:49.65,0:27:53.61,Main-207-,,0,0,0,,Çok lezzetli olurdu,...Dialogue: 50,0:27:54.36,0:27:55.82,Main-207-,,0,0,0,,seni acınası aşçı!Dialogue: 50,0:27:57.91,0:28:00.33,Main-207-,,0,0,0,,Böyle berbat bir tatlıyı bana nasıl sunarsın?!Dialogue: 50,0:28:00.33,0:28:02.79,Main-207-,,0,0,0,,Burası en berbat restoran!Dialogue: 50,0:28:07.37,0:28:09.67,Main-207-,,0,0,0,,Çok sinir bozucusun!Dialogue: 50,0:28:16.01,0:28:17.43,Main-207-,,0,0,0,,Vücudunun her yerinden..Dialogue: 50,0:28:17.43,0:28:18.55,Main-207-,,0,0,0,,Mermiler...Dialogue: 50,0:28:32.77,0:28:35.65,Main-207-,,0,0,0,,Bana karşı gelmeye kalkmayın!Dialogue: 50,0:28:36.15,0:28:38.86,Main-207-,,0,0,0,,Ben herkesten daha güçlüyüm!Dialogue: 50,0:28:40.16,0:28:42.37,Main-207-,,0,0,0,,Çelik kollar, etten kuvvetlidir...Dialogue: 50,0:28:42.74,0:28:45.50,Main-207-,,0,0,0,,En sert wootz çeliğiyle kaplanmış zırh...Dialogue: 50,0:28:45.50,0:28:49.33,Main-207-,,0,0,0,,Ve her şeyi yok edecek elmas yumruklar!Dialogue: 50,0:28:50.42,0:28:52.96,Main-207-,,0,0,0,,Vücuduma gömülmüş her türlü silah,...Dialogue: 50,0:28:52.96,0:28:55.09,Main-207-,,0,0,0,,50 gemi büyüklüğündeki bir filo...Dialogue: 50,0:28:55.09,0:28:57.09,Main-207-,,0,0,0,,ve 5,000 korsanlı askeri güç...Dialogue: 50,0:28:57.09,0:29:00.84,Main-207-,,0,0,0,,Geçmişte girdiğim tüm savaşları kazandım!Dialogue: 50,0:29:00.84,0:29:05.39,Main-207-,,0,0,0,,Sadece ben, "Don" diye seslenilmeye uygun olan adamım!Dialogue: 50,0:29:06.14,0:29:08.14,Main-207-,,0,0,0,,Çekil yolumdan, velet!Dialogue: 50,0:29:10.31,0:29:15.53,Main-207-,,0,0,0,,Size yemek yapmanızı söylediğimde, itaat edin!Dialogue: 50,0:29:15.98,0:29:18.32,Main-207-,,0,0,0,,Kimse bana karşı gelemez!Dialogue: 50,0:29:21.57,0:29:23.95,Main-207-,,0,0,0,,Bunun içinde 100 kişilik yemek var.Dialogue: 50,0:29:23.95,0:29:26.08,Main-207-,,0,0,0,,Hemen bunu gemine götür.Dialogue: 50,0:29:26.08,0:29:27.54,Main-207-,,0,0,0,,– Patron Zeff! – Patron Zeff!Dialogue: 50,0:29:29.71,0:29:33.08,Main-207-,,0,0,0,,Z... Zeff mi?Dialogue: 50,0:29:37.30,0:29:39.92,Main-207-,,0,0,0,,Ne... Ne yapıyorsun öyle?!Dialogue: 50,0:29:40.51,0:29:45.60,Main-207-,,0,0,0,,Korsanları beslersek gelip burayı istila edecekler.Dialogue: 50,0:29:45.60,0:29:49.48,Main-207-,,0,0,0,,Güçleri varsa tabii!Dialogue: 50,0:29:51.19,0:29:54.94,Main-207-,,0,0,0,,Haksız mıyım, seni Grand Line fiyaskosu?Dialogue: 50,0:29:57.90,0:29:59.65,Main-207-,,0,0,0,,O-Olamaz.Dialogue: 50,0:29:59.65,0:30:02.24,Main-207-,,0,0,0,,Don Krieg, Grand Line'da başarısız mı oldu?Dialogue: 50,0:30:02.61,0:30:05.62,Main-207-,,0,0,0,,Doğu Mavi’nin fatihi bile...Dialogue: 50,0:30:05.62,0:30:09.91,Main-207-,,0,0,0,,elli gemilik filoyla başaramadı mı?!Dialogue: 50,0:30:10.25,0:30:11.87,Main-207-,,0,0,0,,Grand Line mı?Dialogue: 50,0:30:11.87,0:30:15.67,Main-207-,,0,0,0,,S... Sen...Dialogue: 50,0:30:15.67,0:30:17.59,Main-207-,,0,0,0,,Kızıl Bacak Zeff'sin.Dialogue: 0,0:01:50.05,0:01:54.76,Title-207-,,0,0,0,,Korsan Komodor Don KriegDialogue: 1,0:01:50.05,0:01:54.76,Title-207-,,0,0,0,,Korsan Komodor Don KriegDialogue: 0,0:03:41.12,0:03:47.08,Captions-207-,,0,0,0,,Gin Korsan Savaşçı Krieg KorsanlarıDialogue: 1,0:03:41.12,0:03:47.08,Captions-207-,,0,0,0,,Gin Korsan Savaşçı Krieg KorsanlarıDialogue: 0,0:04:51.94,0:04:56.90,Captions-207-,,0,0,0,,Gemi Mutfağı Deniz RestoranıDialogue: 1,0:04:51.94,0:04:56.90,Captions-207-,,0,0,0,,Gemi Mutfağı Deniz RestoranıDialogue: 0,0:08:18.27,0:08:23.19,Captions-207-,,0,0,0,,Monkey D. Luffy Borçlu Kamarot Deniz RestoranıDialogue: 1,0:08:18.27,0:08:23.19,Captions-207-,,0,0,0,,Monkey D. Luffy Borçlu Kamarot Deniz RestoranıDialogue: 0,0:08:26.36,0:08:29.24,Captions-207-,,0,0,0,,Korsanlığa Ara VerdiDialogue: 1,0:08:26.36,0:08:29.24,Captions-207-,,0,0,0,,Korsanlığa Ara VerdiDialogue: 0,0:08:30.82,0:08:32.70,Captions-207-,,0,0,0,,Korsanlığa Ara VerdiDialogue: 1,0:08:30.82,0:08:32.70,Captions-207-,,0,0,0,,Korsanlığa Ara VerdiDialogue: 0,0:08:33.83,0:08:35.91,Captions-207-,,0,0,0,,Korsanlığa Ara VerdiDialogue: 1,0:08:33.83,0:08:35.91,Captions-207-,,0,0,0,,Korsanlığa Ara VerdiDialogue: 0,0:08:37.54,0:08:38.87,Captions-207-,,0,0,0,,Korsanlığa Ara VerdiDialogue: 1,0:08:37.54,0:08:38.87,Captions-207-,,0,0,0,,Korsanlığa Ara VerdiDialogue: 0,0:08:40.96,0:08:42.92,Captions-207-,,0,0,0,,Korsanlığa Ara VerdiDialogue: 1,0:08:40.96,0:08:42.92,Captions-207-,,0,0,0,,Korsanlığa Ara VerdiDialogue: 0,0:08:52.97,0:08:54.68,Captions-207-,,0,0,0,,Korsanlığa Ara VerdiDialogue: 1,0:08:52.97,0:08:54.68,Captions-207-,,0,0,0,,Korsanlığa Ara VerdiDialogue: 0,0:15:08.30,0:15:12.47,Captions-207-,,0,0,0,,İki Gün SonraDialogue: 1,0:15:08.30,0:15:12.47,Captions-207-,,0,0,0,,İki Gün SonraDialogue: 0,0:17:39.87,0:17:44.84,Captions-207-,,0,0,0,,Don Krieg Korsan KomodorDialogue: 1,0:17:3