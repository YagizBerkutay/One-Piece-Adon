&H00000000,0,0,0,0,100,100,0,0,1,1.5,0,8,10,10,30,1Style: Karaoke,Duality,65,&H009E375F,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,8,10,10,30,1Style: Translation,Duality,65,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,3,0,2,10,10,30,1Style: Luffy Monologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:50.01,0:02:00.01,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 50,0:02:03.35,0:02:05.23,Main-207-,,0,0,0,,Neredeyse vardım.Dialogue: 50,0:02:05.23,0:02:10.36,Main-207-,,0,0,0,,Altını ilk bulan ben olacağım. Herkes çok etkilenecek.Dialogue: 50,0:02:16.24,0:02:18.70,Main-207-,,0,0,0,,Daha fazla harabe...Dialogue: 50,0:02:24.79,0:02:25.75,Main-207-,,0,0,0,,Ah!Dialogue: 50,0:02:26.42,0:02:27.96,Main-207-,,0,0,0,,Burası da ne?Dialogue: 50,0:02:27.96,0:02:30.00,Main-207-,,0,0,0,,Buradaki zemin biraz eğilimli.Dialogue: 50,0:02:30.00,0:02:31.88,Main-207-,,0,0,0,,Oradan yürümeye başlayacağım.Dialogue: 50,0:02:38.05,0:02:40.31,Main-207-,,0,0,0,,Altın! Altın!Dialogue: 50,0:02:42.64,0:02:43.89,Main-207-,,0,0,0,,Dur.Dialogue: 50,0:02:43.89,0:02:45.60,Main-207-,,0,0,0,,Dur, Holy.Dialogue: 50,0:02:45.60,0:02:47.36,Main-207-,,0,0,0,,Holy, dur.Dialogue: 50,0:02:57.07,0:02:59.70,Thoughts-207-,,0,0,0,,Kendimi çok kaptırdım!Dialogue: 50,0:02:59.70,0:03:01.74,Thoughts-207-,,0,0,0,,Geri dönmeliydim!Dialogue: 50,0:03:01.74,0:03:03.96,Thoughts-207-,,0,0,0,,Öleceğim...!Dialogue: 50,0:03:06.54,0:03:10.88,Main-207-,,0,0,0,,Bugün buraya gelmeyi başaran üçüncü kişisin.Dialogue: 50,0:03:11.25,0:03:12.21,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:03:12.21,0:03:13.17,Main-207-,,0,0,0,,Sen de kimsin?Dialogue: 50,0:03:13.72,0:03:16.84,Main-207-,,0,0,0,,O örümcek kafa her zamanki gibi dikkatsiz.Dialogue: 50,0:03:17.64,0:03:20.10,Main-207-,,0,0,0,,Gedatsu'nun işini bitiren sensin, değil mi?Dialogue: 50,0:03:21.43,0:03:23.77,Thoughts-207-,,0,0,0,,Deminki adamdan bahsediyor.Dialogue: 50,0:03:25.06,0:03:27.27,Main-207-,,0,0,0,,Ah, hayır. Endişelenme.Dialogue: 50,0:03:27.27,0:03:30.19,Main-207-,,0,0,0,,Bu dünya o aptal yokken daha iyi.Dialogue: 50,0:03:30.19,0:03:31.52,Main-207-,,0,0,0,,Öyle değil mi?Dialogue: 50,0:03:43.16,0:03:44.95,Main-207-,,0,0,0,,Ha? Neye takıl–Dialogue: 50,0:03:52.00,0:03:53.63,Main-207-,,0,0,0,,Korkmana gerek yok.Dialogue: 50,0:03:53.63,0:03:55.97,Main-207-,,0,0,0,,O köpek benim sevimli hayvanım, Holy.Dialogue: 50,0:03:55.97,0:03:57.59,Main-207-,,0,0,0,,Isırmaz.Dialogue: 50,0:03:57.97,0:04:01.39,Main-207-,,0,0,0,,A-Ama bu adam kana bulanmış ve baygın durumda!Dialogue: 50,0:04:01.39,0:04:06.10,Main-207-,,0,0,0,,Holy, iyi eğitilmiştir. Sebepsiz yere kimseyi ısırmaz.Dialogue: 50,0:04:07.44,0:04:10.56,Main-207-,,0,0,0,,O adamı doğrayan bendim.Dialogue: 50,0:04:11.69,0:04:14.11,Main-207-,,0,0,0,,Bu çok korkunç! Kimsin sen?!Dialogue: 50,0:04:14.82,0:04:15.90,Main-207-,,0,0,0,,Kimsin?Dialogue: 50,0:04:15.90,0:04:17.15,Main-207-,,0,0,0,,Adım, Ohm.Dialogue: 50,0:04:17.15,0:04:19.07,Secondary-207-,,0,0,0,,Korkunçsun...Dialogue: 50,0:04:17.78,0:04:19.07,Main-207-,,0,0,0,,Sessiz ol!Dialogue: 50,0:04:19.07,0:04:20.32,Secondary-207-,,0,0,0,,Çok korkunç!Dialogue: 50,0:04:20.32,0:04:23.70,Main-207-,,0,0,0,,İnsanlar ne kadar kırılgan diye üzülüyorum.Dialogue: 50,0:04:21.07,0:04:22.49,Secondary-207-,,0,0,0,,Ondan hoşlanmadım!Dialogue: 50,0:04:23.70,0:04:24.58,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:04:25.70,0:04:29.04,Main-207-,,0,0,0,,Hayatlarının ne kadar çabuk geçtiğini bildikleri hâlde...Dialogue: 50,0:04:29.04,0:04:31.79,Main-207-,,0,0,0,,niye insanlar dövüşmeyi seçer?!Dialogue: 50,0:04:32.67,0:04:34.00,Main-207-,,0,0,0,,Ne...?Dialogue: 50,0:04:34.73,0:04:36.84,Main-207-,,0,0,0,,Mutlu olmayı umarak doğup...Dialogue: 50,0:04:36.84,0:04:38.43,Main-207-,,0,0,0,,bunun arayışında...Dialogue: 50,0:04:38.88,0:04:40.47,Main-207-,,0,0,0,,birbirlerini yok ediyorlar.Dialogue: 50,0:04:41.18,0:04:44.97,Main-207-,,0,0,0,,Doğrusu dövüşmemeleri daha iyi olurdu.Dialogue: 50,0:04:44.97,0:04:47.35,Main-207-,,0,0,0,,İnsan kendi doğasından kaçamaz.Dialogue: 50,0:04:47.35,0:04:48.68,Main-207-,,0,0,0,,Çok üzücü.Dialogue: 50,0:04:49.73,0:04:52.77,Main-207-,,0,0,0,,Ama onları kurtarmanın bir yolu var!Dialogue: 50,0:04:54.36,0:04:55.98,Main-207-,,0,0,0,,Hepsi ölmeli!Dialogue: 50,0:04:56.73,0:04:59.03,Main-207-,,0,0,0,,Niye o kadar korkunç bir şey söyledin?!Dialogue: 50,0:04:59.03,0:05:00.61,Main-207-,,0,0,0,,Bu delilik...!Dialogue: 50,0:05:01.24,0:05:03.78,Main-207-,,0,0,0,,Buraya niye geldin?Dialogue: 50,0:05:03.78,0:05:06.04,Main-207-,,0,0,0,,Ah, sadece biraz altın bulmak ve–Dialogue: 50,0:05:06.04,0:05:08.41,Main-207-,,0,0,0,,Açgözlülük çatışma doğurur.Dialogue: 50,0:05:08.41,0:05:09.12,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:05:09.50,0:05:11.12,Main-207-,,0,0,0,,Seni kurtaracağım.Dialogue: 50,0:05:11.12,0:05:14.09,Main-207-,,0,0,0,,Kurtarmak mı? Beni mi?Dialogue: 50,0:05:18.84,0:05:22.09,Main-207-,,0,0,0,,Ölürsen, hiçbir şey yapmayacak ve hiçbir şey aramayacaksın.Dialogue: 50,0:05:23.76,0:05:26.68,Thoughts-207-,,0,0,0,,Beni kurtarmaya çalışmıyor!!Dialogue: 50,0:05:36.73,0:05:37.82,Main-207-,,0,0,0,,Kamakiri...!Dialogue: 50,0:05:38.94,0:05:40.32,Main-207-,,0,0,0,,Kamakiri!Dialogue: 50,0:05:42.45,0:05:43.57,Main-207-,,0,0,0,,Git...Dialogue: 50,0:05:44.41,0:05:46.12,Main-207-,,0,0,0,,Git, Raki...Dialogue: 50,0:05:46.78,0:05:48.37,Main-207-,,0,0,0,,Ama, Kamakiri...!Dialogue: 50,0:05:50.58,0:05:55.46,Main-207-,,0,0,0,,Wyper, Tanrı'nın Tapınağı'na gidiyor.Dialogue: 50,0:05:55.46,0:05:58.25,Main-207-,,0,0,0,,Enel orada değil.Dialogue: 50,0:05:58.25,0:06:00.51,Main-207-,,0,0,0,,Onu hâlâ durdurabilirsin.Dialogue: 50,0:06:01.38,0:06:03.26,Main-207-,,0,0,0,,Wyper'ı durdur!Dialogue: 50,0:06:03.89,0:06:06.85,Main-207-,,0,0,0,,Tamam! Anladım, artık konuşma!Dialogue: 50,0:06:10.98,0:06:14.35,Main-207-,,0,0,0,,Onu... kimse yenemez.Dialogue: 50,0:06:14.48,0:06:17.82,Flashbacks-207-,,0,0,0,,Ben yıldırımım.Dialogue: 50,0:06:24.74,0:06:27.12,Main-207-,,0,0,0,,O... yenilmez...Dialogue: 50,0:06:30.04,0:06:36.50,Main-207-,,0,0,0,,O saf yıldırımdır... Binlerce yıldır korkulan ilahi bir güç.Dialogue: 50,0:06:39.50,0:06:41.17,Main-207-,,0,0,0,,Wyper'ı durduracağım.Dialogue: 50,0:06:41.17,0:06:42.63,Main-207-,,0,0,0,,Burada bekle.Dialogue: 50,0:06:42.63,0:06:46.22,Main-207-,,0,0,0,,Aisa'nın çantası sana emanet!Dialogue: 50,0:06:57.86,0:07:00.52,Flashbacks-207-,,0,0,0,,Onu... kimse yenemez.Dialogue: 50,0:07:00.52,0:07:03.52,Flashbacks-207-,,0,0,0,,O... yenilmez...Dialogue: 50,0:07:03.52,0:07:07.91,Thoughts-207-,,0,0,0,,Kamakiri çok güçlü ama şevki kırılmış.Dialogue: 50,0:07:09.74,0:07:11.19,Thoughts-207-,,0,0,0,,Yıldırım-Yıldırım Meyvesi,Dialogue: 50,0:07:11.19,0:07:16.00,Thoughts-207-,,0,0,0,,en güçlü şeytan meyvesi olan logia ve Enel ona sahip.Dialogue: 50,0:07:11.19,0:07:16.00,Note-207-,,0,0,0,,Logia: Doğa tipiDialogue: 50,0:07:16.00,0:07:17.54,Thoughts-207-,,0,0,0,,Wyper'ı hemen durdurmalıyım!Dialogue: 50,0:07:23.34,0:07:27.72,Main-207-,,0,0,0,,Sanırım bunu daha önce gördüm... yoksa görmedim mi?Dialogue: 50,0:07:27.72,0:07:28.89,Main-207-,,0,0,0,,Gördüm mü...Dialogue: 50,0:07:30.10,0:07:32.10,Main-207-,,0,0,0,,görmedim mi?Dialogue: 50,0:07:32.10,0:07:33.10,Main-207-,,0,0,0,,Evet, gördüm.Dialogue: 50,0:07:34.10,0:07:35.89,Main-207-,,0,0,0,,Sadece andırıyor mu?Dialogue: 50,0:07:40.86,0:07:42.57,Main-207-,,0,0,0,,Az önce bana mı güldün?!Dialogue: 50,0:07:45.53,0:07:49.87,Main-207-,,0,0,0,,Ne? Bedava yemek için beni takip etmen senin hatan.Dialogue: 50,0:07:49.87,0:07:53.29,Main-207-,,0,0,0,,Yanımda durarak elde ettiğin bu. Kaybol hadi!Dialogue: 50,0:08:01.25,0:08:02.04,Main-207-,,0,0,0,,Aptal! Hey!Dialogue: 50,0:08:02.04,0:08:03.17,Main-207-,,0,0,0,,Hey, hey!Dialogue: 50,0:08:04.55,0:08:07.17,Main-207-,,0,0,0,,Bekle! İçinde yemek falan yok!Dialogue: 50,0:08:07.17,0:08:08.68,Main-207-,,0,0,0,,Bırak! Hey!Dialogue: 50,0:08:08.68,0:08:12.39,Main-207-,,0,0,0,,Nereye gidiyorsun?!Dialogue: 50,0:08:13.31,0:08:16.27,Main-207-,,0,0,0,,Burası gerçekten tuhaf bir yer.Dialogue: 50,0:08:19.60,0:08:21.40,Main-207-,,0,0,0,,Çıkmaz yol mu?!Dialogue: 50,0:08:25.28,0:08:28.57,Main-207-,,0,0,0,,Ciddi olamazsın... O kadar da yol yürüdüm!Dialogue: 50,0:08:29.45,0:08:30.32,Main-207-,,0,0,0,,Yoksa...Dialogue: 50,0:08:30.91,0:08:32.83,Main-207-,,0,0,0,,Gizli bir kapı olabilir mi?Dialogue: 50,0:08:34.12,0:08:35.87,Main-207-,,0,0,0,,Anlıyorum.Dialogue: 50,0:08:35.87,0:08:39.67,Main-207-,,0,0,0,,Parçalarsam, devam edebilirim.Dialogue: 50,0:08:39.67,0:08:44.80,Main-207-,,0,0,0,,Lastik-Lastik Bazuka!Dialogue: 50,0:08:48.92,0:08:49.93,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:08:49.93,0:08:51.72,Main-207-,,0,0,0,,Kımıldamadı bile...Dialogue: 50,0:08:59.35,0:09:01.85,Main-207-,,0,0,0,,Neler oluyor?!Dialogue: 50,0:09:19.75,0:09:21.79,Main-207-,,0,0,0,,Peşimden gelmiyor. Hele şükür.Dialogue: 50,0:09:25.13,0:09:27.63,Main-207-,,0,0,0,,O da mı rahip?Dialogue: 50,0:09:27.63,0:09:30.05,Main-207-,,0,0,0,,Burada saklanacak çok yer var.Dialogue: 50,0:09:30.05,0:09:33.89,Main-207-,,0,0,0,,Buradan çıkıp Luffy ve diğerlerini bulmalıyım.Dialogue: 50,0:09:36.72,0:09:38.77,Main-207-,,0,0,0,,Kılıç ustası gibi görünüyordu.Dialogue: 50,0:09:38.77,0:09:41.89,Main-207-,,0,0,0,,Mesafemi korur ve gizlenirsem, kaçabilirim.Dialogue: 50,0:09:44.98,0:09:46.82,Main-207-,,0,0,0,,Epey mesafe koştu.Dialogue: 50,0:09:47.53,0:09:50.57,Main-207-,,0,0,0,,Ben onu kurtarmaya çalışırken, ahmak kaçıyor.Dialogue: 50,0:09:50.57,0:09:54.32,Main-207-,,0,0,0,,Bu, yaşama olan bağlılığının dünyevi bir istek olduğunu gösteriyor.Dialogue: 50,0:09:55.83,0:09:56.83,Main-207-,,0,0,0,,Ancak...!Dialogue: 50,0:10:14.80,0:10:18.35,Main-207-,,0,0,0,,Huzura ulaşmanın bu kederli yolunda, hayatta kalmak namümkündür...Dialogue: 50,0:10:19.64,0:10:24.23,Main-207-,,0,0,0,,Demir Testi'nde hayatta kalma oranı yüzde 0!Dialogue: 50,0:10:25.10,0:10:25.77,Main-207-,,0,0,0,,Aisa?Dialogue: 50,0:10:25.77,0:10:28.52,Main-207-,,0,0,0,,Burada kalamam! Raki'yi bulacağım!Dialogue: 50,0:10:28.52,0:10:30.03,Main-207-,,0,0,0,,Dur!Dialogue: 50,0:10:30.57,0:10:32.32,Main-207-,,0,0,0,,Dur! Yapma!Dialogue: 50,0:10:33.11,0:10:34.24,Main-207-,,0,0,0,,Öf be!Dialogue: 50,0:10:37.66,0:10:39.16,Main-207-,,0,0,0,,Dur dedim!Dialogue: 50,0:10:39.16,0:10:43.29,Main-207-,,0,0,0,,Niye durayım? Bırak! Bırak! Bırak!!Dialogue: 50,0:10:43.79,0:10:45.75,Main-207-,,0,0,0,,Bu senin sorunun değil!Dialogue: 50,0:10:45.75,0:10:50.63,Main-207-,,0,0,0,,Değil ama senin gibi bir çocuğun öylece öldürülmesine izin veremem!Dialogue: 50,0:10:50.63,0:10:51.88,Main-207-,,0,0,0,,Ben savaşçıyım!Dialogue: 50,0:10:52.26,0:10:55.55,Main-207-,,0,0,0,,Evet, evet, duydum. Seni küçük savaşçı.Dialogue: 50,0:10:56.34,0:10:58.72,Main-207-,,0,0,0,,Pis bakışlarla beni korkutamazsın.Dialogue: 50,0:10:58.72,0:11:01.18,Main-207-,,0,0,0,,Şey, iyi misiniz?Dialogue: 50,0:11:01.18,0:11:02.39,Main-207-,,0,0,0,,İyiyiz.Dialogue: 50,0:11:02.39,0:11:05.06,Main-207-,,0,0,0,,Hey, çabalamayı bırak! Bin!Dialogue: 50,0:11:05.69,0:11:10.44,Main-207-,,0,0,0,,Hayır! Bırak beni! Onlara yardım etmeliyim! Bırak!Dialogue: 50,0:11:10.44,0:11:12.86,Main-207-,,0,0,0,,Hemen kes şunu yoksa seni pataklayacağım!Dialogue: 50,0:11:14.07,0:11:15.11,Main-207-,,0,0,0,,Ağlamak da yok!Dialogue: 50,0:11:15.78,0:11:19.12,Main-207-,,0,0,0,,Zaten tayfamızdan iki kişiyi kaybettik.Dialogue: 50,0:11:19.12,0:11:21.20,Main-207-,,0,0,0,,Gitmene izin veremem!Dialogue: 50,0:11:21.54,0:11:23.37,Main-207-,,0,0,0,,Hadi, hemen bin şuna.Dialogue: 50,0:11:40.30,0:11:41.51,Main-207-,,0,0,0,,Eyvah!Dialogue: 50,0:11:47.39,0:11:50.52,Main-207-,,0,0,0,,Peh, bu beni korkuttu!Dialogue: 50,0:11:50.52,0:11:52.23,Main-207-,,0,0,0,,Bu ne biçim bi' mağara be?!Dialogue: 50,0:11:52.90,0:11:56.74,Main-207-,,0,0,0,,Önce deprem oldu, sonra da deniz bulutu taşkını...Dialogue: 50,0:11:58.07,0:11:59.87,Main-207-,,0,0,0,,Neredeyse boğuluyordum!Dialogue: 50,0:11:59.87,0:12:00.87,Main-207-,,0,0,0,,Aptal şey!Dialogue: 50,0:12:00.87,0:12:02.70,Main-207-,,0,0,0,,Açıl!!Dialogue: 50,0:12:07.37,0:12:09.25,Main-207-,,0,0,0,,Niye bu kadar büyük?!Dialogue: 50,0:12:09.25,0:12:10.67,Main-207-,,0,0,0,,Lanet olası!Dialogue: 50,0:12:10.67,0:12:12.67,Main-207-,,0,0,0,,Çıkış nerede?!Dialogue: 50,0:12:12.67,0:12:17.38,Main-207-,,0,0,0,,Lastik-Lastik Mitralyöz!Dialogue: 50,0:12:27.94,0:12:29.14,Main-207-,,0,0,0,,Nami-san!Dialogue: 50,0:12:29.14,0:12:31.15,Main-207-,,0,0,0,,Ormana gidiyorsun!Dialogue: 50,0:12:33.02,0:12:34.86,Main-207-,,0,0,0,,Nami-san!Dialogue: 50,0:12:36.74,0:12:37.95,Main-207-,,0,0,0,,Ne yapacağız?Dialogue: 50,0:12:37.95,0:12:39.57,Main-207-,,0,0,0,,Ormana girdiler.Dialogue: 50,0:12:45.87,0:12:46.87,Main-207-,,0,0,0,,Kahretsin.Dialogue: 50,0:12:48.75,0:12:49.79,Main-207-,,0,0,0,,Zorlusun!Dialogue: 50,0:13:04.72,0:13:05.56,Main-207-,,0,0,0,,Ne oluyor?Dialogue: 50,0:13:08.64,0:13:09.48,Main-207-,,0,0,0,,O da kim?Dialogue: 50,0:13:09.48,0:13:11.23,Main-207-,,0,0,0,,Bir şey... bir şey geliyor!Dialogue: 50,0:13:17.23,0:13:18.82,Main-207-,,0,0,0,,O tarafa git! O tarafa!Dialogue: 50,0:13:20.82,0:13:22.24,Main-207-,,0,0,0,,Gökyüzü Kralı!Dialogue: 50,0:13:22.61,0:13:24.45,Main-207-,,0,0,0,,O Aisa'mıydı?Dialogue: 50,0:13:44.72,0:13:46.85,Main-207-,,0,0,0,,Ormanın...Dialogue: 50,0:13:46.85,0:13:48.31,Main-207-,,0,0,0,,içine girdik...!Dialogue: 50,0:13:52.56,0:13:55.31,Main-207-,,0,0,0,,Hey, indir beni!Dialogue: 50,0:13:55.31,0:13:57.44,Main-207-,,0,0,0,,Beni duymuyor musun?!Dialogue: 50,0:13:59.44,0:14:02.91,Main-207-,,0,0,0,,Aptal kuş. Beni yere indir yoksa kanatlarını yolacağım.Dialogue: 50,0:14:09.62,0:14:10.25,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:14:15.92,0:14:17.75,Main-207-,,0,0,0,,D-Dev yılan!Dialogue: 50,0:14:17.75,0:14:21.13,Main-207-,,0,0,0,,Hey! Yüksel yoksa bizi yiyecek!Dialogue: 50,0:14:23.51,0:14:25.47,Main-207-,,0,0,0,,Çabuk! Hey!Dialogue: 50,0:14:27.97,0:14:31.39,Main-207-,,0,0,0,,Hâlâ peşimizde! O yılan epey kızmış görünüyor.Dialogue: 50,0:14:50.33,0:14:52.33,Main-207-,,0,0,0,,Ulan...!Dialogue: 50,0:15:08.64,0:15:12.98,Main-207-,,0,0,0,,Tanrı'nın Tapınağı, Dev Jack'in tepesinde.Dialogue: 50,0:15:13.60,0:15:16.23,Main-207-,,0,0,0,,Enel orada.Dialogue: 50,0:15:16.23,0:15:22.07,Main-207-,,0,0,0,,Onu yenip 400 yıllık mücadeleyi noktalayacağım!Dialogue: 50,0:15:23.32,0:15:24.24,Main-207-,,0,0,0,,Geliyor.Dialogue: 50,0:15:38.33,0:15:43.46,Main-207-,,0,0,0,,Wyper, o sarmaşığa az daha tırmanırsan Tanrı'nın Tapınağı'na ulaşacaksın.Dialogue: 50,0:15:43.84,0:15:46.22,Main-207-,,0,0,0,,Geçmene kim izin verdi?Dialogue: 50,0:15:47.89,0:15:49.22,Main-207-,,0,0,0,,Ohm!Dialogue: 50,0:15:51.56,0:15:55.39,Main-207-,,0,0,0,,Artık Tanrı'nın Tapınağı'na gitmek için bir sebep yok.Dialogue: 50,0:15:56.27,0:15:57.64,Main-207-,,0,0,0,,Gan Fall!Dialogue: 50,0:16:00.48,0:16:02.94,Main-207-,,0,0,0,,Sen niye buradasın?Dialogue: 50,0:16:03.36,0:16:06.20,Main-207-,,0,0,0,,Kutsal tahtını geri almak niyetinde misin?Dialogue: 50,0:16:06.20,0:16:10.41,Main-207-,,0,0,0,,Böyle bir niyetim yok. Görevimi yapmak için geldim.Dialogue: 50,0:16:11.16,0:16:16.33,Main-207-,,0,0,0,,Az önce Tanrı'nın Tapınağı'ndaydım.Dialogue: 50,0:16:20.29,0:16:23.30,Main-207-,,0,0,0,,Trajik bir manzaraydı. Tamamen yok edilmişti.Dialogue: 50,0:16:30.93,0:16:34.60,Main-207-,,0,0,0,,Elbette Enel'den iz yoktu.Dialogue: 50,0:16:35.39,0:16:40.35,Main-207-,,0,0,0,,Oradaki hiçbir şeyin artık işine yaramayacağının bir kanıtıydı.Dialogue: 50,0:16:42.55,0:16:48.45,Flashbacks-207-,,0,0,0,,O altı yıllık canla başla çalışmalarının sonu geliyor.Dialogue: 50,0:16:48.45,0:16:52.18,Flashbacks-207-,,0,0,0,,Buraya sana veda etmeye geldim.Dialogue: 50,0:16:56.79,0:17:00.62,Main-207-,,0,0,0,,Neyin peşindesiniz, Ohm?!Dialogue: 50,0:17:01.21,0:17:05.21,Main-207-,,0,0,0,,Enel, Tanrı'nın Tapınağı'nda değil mi dedin?Dialogue: 50,0:17:22.23,0:17:24.77,Main-207-,,0,0,0,,Hasır Şapkalar'dan biri mi?Dialogue: 50,0:17:24.79,0:17:26.78,Main-207-,,0,0,0,,Üf, acıttı!Dialogue: 50,0:17:26.78,0:17:28.53,Main-207-,,0,0,0,,O kuşu öldüreceğim!Dialogue: 50,0:17:28.53,0:17:29.65,Main-207-,,0,0,0,,Bu sensin!Dialogue: 50,0:17:33.37,0:17:34.45,Main-207-,,0,0,0,,Neredeyim?Dialogue: 50,0:17:39.66,0:17:41.83,Main-207-,,0,0,0,,Harabe mi?Dialogue: 50,0:17:45.25,0:17:47.92,Main-207-,,0,0,0,,Görünüşe bakılırsa burada epey sert adam var.Dialogue: 50,0:17:48.51,0:17:50.63,Main-207-,,0,0,0,,Hey, altını ver!Dialogue: 50,0:17:50.63,0:17:52.63,Main-207-,,0,0,0,,Ah, ne üzücü.Dialogue: 50,0:17:52.63,0:17:56.64,Main-207-,,0,0,0,,Hiçbiriniz Demir Testi'mden kaçamayacaksınız.Dialogue: 50,0:17:56.64,0:18:00.39,Main-207-,,0,0,0,,Yoluma çıkan olursa yok ederim!Dialogue: 50,0:18:00.39,0:18:05.15,Main-207-,,0,0,0,,Enel'in ve kutsal ordumun nerede olduğunu söyleyeceksin.Dialogue: 50,0:18:08.78,0:18:11.95,Main-207-,,0,0,0,,Bu mağaranın nesi var?!Dialogue: 50,0:18:22.83,0:18:27.21,Main-207-,,0,0,0,,Evet beyler, kafanızda çok şey var gibi.Dialogue: 50,0:18:27.21,0:18:29.21,Main-207-,,0,0,0,,Ama istediğiniz şeyi elde etmek için...Dialogue: 50,0:18:29.21,0:18:32.17,Main-207-,,0,0,0,,önce hayatta kalmalısınız!Dialogue: 50,0:18:39.81,0:18:41.10,Main-207-,,0,0,0,,Gidelim, Holy.Dialogue: 50,0:18:41.10,0:18:42.85,Main-207-,,0,0,0,,Onlara ne istersen yap.Dialogue: 50,0:18:44.52,0:18:46.90,Main-207-,,0,0,0,,Hedefimiz o herif, Pierre!Dialogue: 50,0:18:46.90,0:18:50.28,Main-207-,,0,0,0,,İlerlemeden önce Enel'in rahibi yenilmeli!Dialogue: 50,0:18:54.95,0:19:00.41,Main-207-,,0,0,0,,Kahrolası dev yılan buraya kadar peşimden gelmiş.Dialogue: 50,0:19:05.17,0:19:06.79,Main-207-,,0,0,0,,Kahretsin!Dialogue: 50,0:19:08.00,0:19:11.30,Main-207-,,0,0,0,,Kırılmıyor ama dik duruyor ve sonra yana dönüyor.Dialogue: 50,0:19:13.34,0:19:15.55,Main-207-,,0,0,0,,Bu mağara adamı çileden çıkarıyor!Dialogue: 50,0:19:19.14,0:19:21.35,Main-207-,,0,0,0,,Hepiniz birlikte...Dialogue: 50,0:19:22.77,0:19:24.27,Main-207-,,0,0,0,,ölebilirsiniz!Dialogue: 50,0:19:37.78,0:19:39.99,Main-207-,,0,0,0,,O silah epey tehlikeli.Dialogue: 50,0:19:39.99,0:19:42.54,Main-207-,,0,0,0,,Seni küstah Mavi Denizli!Dialogue: 50,0:19:43.16,0:19:48.29,Main-207-,,0,0,0,,Gökyüzüne daha dün gelmiş olan sizlerin burada alacağı hiçbir şey yok!Dialogue: 50,0:19:48.29,0:19:52.63,Main-207-,,0,0,0,,Ne yapıp yapamayacağımızı söylemenizden bıktım.Dialogue: 50,0:19:54.34,0:19:57.93,Main-207-,,0,0,0,,Gökyüzünde olan biten bizim sorunumuz değil!Dialogue: 50,0:19:58.59,0:19:59.64,Main-207-,,0,0,0,,Aynen öyle!Dialogue: 50,0:20:03.35,0:20:06.56,Main-207-,,0,0,0,,Zaten seni de gebertmeyi planlıyordum! Bana uyar!Dialogue: 50,0:20:06.56,0:20:07.52,Main-207-,,0,0,0,,Geber!Dialogue: 50,0:20:14.65,0:20:17.11,Thoughts-207-,,0,0,0,,Bu herif düşündüğümden daha iyi.Dialogue: 50,0:20:29.29,0:20:30.63,Main-207-,,0,0,0,,Geber!Dialogue: 50,0:20:48.89,0:20:50.65,Main-207-,,0,0,0,,Sahi...Dialogue: 50,0:20:50.65,0:20:53.11,Main-207-,,0,0,0,,O şeyin dişleri zehirli.Dialogue: 50,0:20:59.28,0:21:00.53,Main-207-,,0,0,0,,Bunun da dişleri var!Dialogue: 50,0:21:05.45,0:21:07.75,Main-207-,,0,0,0,,Bir köpek nasıl öyle hareket edebilir?!Dialogue: 50,0:21:09.08,0:21:11.58,Main-207-,,0,0,0,,Onun adı, Holy.Dialogue: 50,0:21:11.58,0:21:14.34,Main-207-,,0,0,0,,Gökyüzü hayvanlarını eğittiğim konusunda seni uyarmalıyım.Dialogue: 50,0:21:14.34,0:21:16.51,Main-207-,,0,0,0,,Yani gökyüzü hayvan terbiyecisiyim.Dialogue: 50,0:21:17.09,0:21:20.34,Main-207-,,0,0,0,,İş hayvanlara geldiğinde normal disiplinle yetinmem.Dialogue: 50,0:21:20.34,0:21:25.35,Main-207-,,0,0,0,,Onu iki ayak üzerinde yürümesi ve yakın dövüş yapması için eğittim.Dialogue: 50,0:21:26.10,0:21:27.60,Main-207-,,0,0,0,,Gösterinin tadını çıkar!Dialogue: 50,0:21:29.68,0:21:31.31,Main-207-,,0,0,0,,Bu biraz fazla değil mi?Dialogue: 50,0:21:39.49,0:21:40.78,Main-207-,,0,0,0,,Gan Fall,Dialogue: 50,0:21:41.40,0:21:44.74,Main-207-,,0,0,0,,Shura tarafından yenildikten sonra bile öğrenemedin mi?Dialogue: 50,0:21:45.58,0:21:48.83,Main-207-,,0,0,0,,Muhtemelen artık o mızrağı kaldıramıyorsundur bile, değil mi?Dialogue: 50,0:21:48.83,0:21:50.08,Main-207-,,0,0,0,,Seni aptal ihtiyar!Dialogue: 50,0:21:50.66,0:21:52.58,Main-207-,,0,0,0,,Öyle olsa bile, geri adım atamam!Dialogue: 50,0:21:52.58,0:21:56.29,Main-207-,,0,0,0,,Siz ahmakların ne planladığını öğrenmeliyim!Dialogue: 50,0:21:59.09,0:22:00.92,Main-207-,,0,0,0,,Kendini bir şey sanma!Dialogue: 50,0:22:01.55,0:22:05.85,Main-207-,,0,0,0,,Bilsen bile, senin gibiler Tanrı'nın maksadını...Dialogue: 50,0:22:06.35,0:22:08.47,Main-207-,,0,0,0,,tahayyül bile edemez.Dialogue: 50,0:22:15.90,0:22:17.69,Main-207-,,0,0,0,,Peşlerinden, peşlerinden!Dialogue: 50,0:22:17.69,0:22:19.78,Main-207-,,0,0,0,,Shandialılar'ın peşinden!Dialogue: 50,0:22:23.91,0:22:26.03,Main-207-,,0,0,0,,Ne? O da neydi öyle?!Dialogue: 50,0:22:26.03,0:22:27.28,Main-207-,,0,0,0,,"Meh" sesi duydum.Dialogue: 50,0:22:27.28,0:22:28.16,Main-207-,,0,0,0,,Keçiler mi?Dialogue: 50,0:22:28.16,0:22:31.20,Main-207-,,0,0,0,,Onlar ilahi savaşçılar! Bizi yakalarlarsa öldürürler!Dialogue: 50,0:22:31.20,0:22:33.25,Main-207-,,0,0,0,,İlahi savaşçılar da ne?Dialogue: 50,0:22:33.25,0:22:34.83,Main-207-,,0,0,0,,Enel'in denyoları!Dialogue: 50,0:22:34.83,0:22:36.42,Main-207-,,0,0,0,,Buradan gitmeliyiz!Dialogue: 50,0:22:36.42,0:22:38.92,Main-207-,,0,0,0,,D-Dur biraz!Dialogue: 50,0:22:38.92,0:22:41.51,Main-207-,,0,0,0,,Tam olarak nereye gidiyoruz?!Dialogue: 50,0:22:54.77,0:22:58.69,Main-207-,,0,0,0,,Lanet olası yılan. Bana engel olup duruyor!Dialogue: 50,0:23:10.04,0:23:11.83,Main-207-,,0,0,0,,Hey, Chopper...Dialogue: 50,0:23:12.29,0:23:14.50,Main-207-,,0,0,0,,Hey! Ne oldu?!Dialogue: 50,0:23:16.33,0:23:17.58,Main-207-,,0,0,0,,Anlıyorum...Dialogue: 50,0:23:17.58,0:23:19.84,Main-207-,,0,0,0,,Mavi Denizli arkadaşı.Dialogue: 50,0:23:21.59,0:23:24.05,Main-207-,,0,0,0,,Hey, adımına dikkat et.Dialogue: 50,0:23:31.77,0:23:32.89,Main-207-,,0,0,0,,O da neydi?Dialogue: 50,0:23:34.43,0:23:36.27,Main-207-,,0,0,0,,Dikenli tel mi?!Dialogue: 50,0:23:37.90,0:23:40.11,Main-207-,,0,0,0,,Yani test bu mu?Dialogue: 50,0:23:40.69,0:23:41.69,Main-207-,,0,0,0,,Chopper!Dialogue: 50,0:23:41.69,0:23:43.28,Main-207-,,0,0,0,,Hey, Chopper!Dialogue: 50,0:23:43.28,0:23:44.78,Main-207-,,0,0,0,,Cevap ver!Dialogue: 50,0:23:44.78,0:23:47.61,Main-207-,,0,0,0,,Niye tek başına buradaydın?!Dialogue: 50,0:23:47.61,0:23:49.07,Main-207-,,0,0,0,,Hey!Dialogue: 50,0:23:49.07,0:23:50.87,Main-207-,,0,0,0,,Ne utanç verici.Dialogue: 50,0:23:54.54,0:23:56.79,Main-207-,,0,0,0,,Demir bulutundan yapıldılar.Dialogue: 50,0:23:57.75,0:24:01.29,Main-207-,,0,0,0,,Bulut kadar hafif ama demir kadar sert.Dialogue: 50,0:24:01.29,0:24:04.38,Main-207-,,0,0,0,,Milky dial'ler ile fırlatılabilir.Dialogue: 50,0:24:04.38,0:24:07.05,Main-207-,,0,0,0,,Tuzakların her biri toprağın üzerinde.Dialogue: 50,0:24:07.05,0:24:08.80,Main-207-,,0,0,0,,Bastığın tetiklenir.Dialogue: 50,0:24:10.18,0:24:15.77,Main-207-,,0,0,0,,Bu savaş alanında, saldırının ne zaman ve nereden geleceği belli olmaz.Dialogue: 50,0:24:15.77,0:24:19.90,Main-207-,,0,0,0,,O hayvana olanların yarısı benim işim.Dialogue: 50,0:24:20.48,0:24:23.57,Main-207-,,0,0,0,,Kalanını testte kendi kendine yaptı.Dialogue: 50,0:24:30.37,0:24:32.74,Main-207-,,0,0,0,,İntikam mı istiyorsun?Dialogue: 50,0:24:33.28,0:24:34.41,Main-207-,,0,0,0,,Hayır.Dialogue: 50,0:24:35.29,0:24:39.17,Main-207-,,0,0,0,,İntikam için dövüşmeyi hiç sevmem.Dialogue: 50,0:24:40.25,0:24:41.63,Main-207-,,0,0,0,,Vay...Dialogue: 50,0:24:42.25,0:24:43.50,Main-207-,,0,0,0,,Etkileyici bir cevap.Dialogue: 50,0:24:43.50,0:24:44.38,Main-207-,,0,0,0,,Ama...Dialogue: 50,0:24:47.76,0:24:50.51,Main-207-,,0,0,0,,şimdi biraz gaza geldim.Dialogue: 50,0:25:03.02,0:25:06.65,Main-207-,,0,0,0,,Üzgünüm. Burası doğru yer mi, Conis-san?Dialogue: 50,0:25:06.65,0:25:09.15,Main-207-,,0,0,0,,Burası buluşacakları kıyı mı?Dialogue: 50,0:25:09.15,0:25:10.66,Main-207-,,0,0,0,,Evet, baba.Dialogue: 50,0:25:10.66,0:25:12.87,Main-207-,,0,0,0,,Nami-san öyle demişti.Dialogue: 50,0:25:13.37,0:25:15.49,Main-207-,,0,0,0,,Ama şimdi ne yapacağız?Dialogue: 50,0:25:15.49,0:25:18.33,Main-207-,,0,0,0,,Gemiyi koruyanlardan biri olacağımızı düşünmemiştim.Dialogue: 50,0:25:19.08,0:25:23.29,Main-207-,,0,0,0,,Onlar dönene dek korumak için elimizden geleni yapmalıyız.Dialogue: 50,0:25:23.29,0:25:25.67,Main-207-,,0,0,0,,Tehlikeyi uzaklaştırmak için borazan çalayım mı?Dialogue: 50,0:25:25.67,0:25:27.59,Main-207-,,0,0,0,,Evet, baba!Dialogue: 50,0:25:27.59,0:25:29.30,Main-207-,,0,0,0,,Bu bize cesaret verir!Dialogue: 50,0:25:33.72,0:25:35.72,Main-207-,,0,0,0,,Bu işe yarar.Dialogue: 50,0:25:40.48,0:25:43.61,Main-207-,,0,0,0,,Suu, sen de oradan göz kulak olur musun?Dialogue: 50,0:25:49.82,0:25:53.07,Main-207-,,0,0,0,,Tamam! İyileşmeniz için size yardımcı olacağım!Dialogue: 50,0:25:53.07,0:25:54.82,Main-207-,,0,0,0,,Lütfen, dayanın!Dialogue: 50,0:26:01.87,0:26:04.54,Thoughts-207-,,0,0,0,,Umarım herkes iyidir.Dialogue: 50,0:26:04.54,0:26:07.67,Thoughts-207-,,0,0,0,,Gökyüzü adası böyle olduğu için üzgünüm.Dialogue: 50,0:26:13.64,0:26:15.30,Main-207-,,0,0,0,,Doğrudan Tanrı'nın Tapınağı'na...!Dialogue: 50,0:26:16.76,0:26:19.97,Main-207-,,0,0,0,,Enel'in başını alma fırsatımız var!Dialogue: 50,0:26:22.19,0:26:24.90,Main-207-,,0,0,0,,Tanrı'nın Tapınağı'na ulaşmanıza izin vermeyeceğiz!Dialogue: 50,0:26:25.31,0:26:29.15,Main-207-,,0,0,0,,Dev Jack'e tırmanın!Dialogue: 50,0:26:34.99,0:26:38.54,Thoughts-207-,,0,0,0,,Wyper, lütfen reject'i bir daha kullanma!Dialogue: 50,0:26:39.62,0:26:41.37,Main-207-,,0,0,0,,İlahi savaşçılar, toplanın!Dialogue: 50,0:26:41.37,0:26:43.25,Main-207-,,0,0,0,,Shandialıları durdurun!Dialogue: 50,0:26:53.13,0:26:55.34,Thoughts-207-,,0,0,0,,Enel'e meydan okumamalısın, Wyper!Dialogue: 50,0:27:01.31,0:27:02.60,Thoughts-207-,,0,0,0,,Enel'i...Dialogue: 50,0:27:03.14,0:27:06.02,Thoughts-207-,,0,0,0,,Ne yaparsak yapalım, Enel'i yenemeyiz!Dialogue: 50,0:27:26.92,0:27:28.00,Main-207-,,0,0,0,,Evet.Dialogue: 50,0:27:28.79,0:27:34.97,Main-207-,,0,0,0,,Hepiniz, Harabenin Üstü'ne çıkın ve birbirinizi yok edin.Dialogue: 50,0:27:38.22,0:27:40.89,Main-207-,,0,0,0,,Sadece beş kişi kalacak.Dialogue: 50,0:27:44.14,0:27:48.90,Main-207-,,0,0,0,,Tanrı'nın kehaneti mutlaktır.Dialogue: 50,0:27:58.49,0:28:00.45,Main-207-,,0,0,0,,Dur, Wyper!Dialogue: 50,0:28:00.45,0:28:01.91,Main-207-,,0,0,0,,Ben–Dialogue: 50,0:28:01.91,0:28:04.04,Main-207-,,0,0,0,,Sen ne?Dialogue: 50,0:28:04.04,0:28:06.25,Main-207-,,0,0,0,,Düşmanımız olmadığını mı söyleyeceksin?!Dialogue: 50,0:28:06.71,0:28:11.29,Main-207-,,0,0,0,,Bizim için sen ve Enel aynısınız, Gan Fall!Dialogue: 50,0:28:11.29,0:28:14.17,Main-207-,,0,0,0,,Yani dinleyemeyecek kadar aciz misin?!Dialogue: 50,0:28:21.39,0:28:22.43,Main-207-,,0,0,0,,Lanet olası!Dialogue: 50,0:28:33.44,0:28:37.45,Main-207-,,0,0,0,,Yanan bazukam onu öldürmedi mi?! Derisi neyden yapılmış öyle?!Dialogue: 50,0:28:42.33,0:28:47.96,Main-207-,,0,0,0,,Yeter! Yeter, aptal mağara!Dialogue: 50,0:29:08.10,0:29:10.35,Main-207-,,0,0,0,,O da neydi?Dialogue: 50,0:29:11.60,0:29:14.44,Main-207-,,0,0,0,,Tipik cahil bir Mavi Denizli.Dialogue: 50,0:29:15.36,0:29:18.99,Main-207-,,0,0,0,,Bu kılıç da demir bulutundan yapılma.Dialogue: 50,0:29:18.99,0:29:20.86,Main-207-,,0,0,0,,Diğer bir deyişle bu kılıç,Dialogue: 50,0:29:21.45,0:29:27.45,Main-207-,,0,0,0,,kabzanın içine gömülü bir dial'dan fırlatılan demir bulutu.Dialogue: 50,0:29:27.45,0:29:29.79,Main-207-,,0,0,0,,Nerede olursa olsun avımı yakalar!Dialogue: 50,0:29:33.96,0:29:38.01,Main-207-,,0,0,0,,Şimdi anlıyor musun, Mavi Denizli kılıç ustası?Dialogue: 50,0:29:38.01,0:29:40.09,Main-207-,,0,0,0,,Demek bir kamçı gibi.Dialogue: 50,0:29:40.09,0:29:44.72,Main-207-,,0,0,0,,Beyaz-Beyaz Deniz savaşçılarının sirk soytarılığı da yaptığını bilmiyordum.Dialogue: 50,0:29:51.23,0:29:52.23,Main-207-,,0,0,0,,Holy...Dialogue: 50,0:29:53.27,0:29:54.77,Main-207-,,0,0,0,,Ayrı dövüşeceğiz.Dialogue: 50,0:29:58.65,0:30:03.49,Main-207-,,0,0,0,,Harabenin Üstü biraz kalabalıklaşıyor.Dialogue: 50,0:30:17.00,0:30:20.80,Main-207-,,0,0,0,,Gökyüzü Kralı'nı burada beklemiyordum.Dialogue: 50,0:30:20.80,0:30:23.30,Main-207-,,0,0,0,,Size destek olacağız, Ohm-sama!Dialogue: 50,0:30:27.76,0:30:28.97,Main-207-,,0,0,0,,Siz...!Dialogue: 50,0:30:30.48,0:30:32.10,Main-207-,,0,0,0,,Görünüşe göre...Dialogue: 50,0:30:32.10,0:30:34.85,Main-207-,,0,0,0,,Evet, tek kalan biziz.Dialogue: 50,0:30:34.85,0:30:38.94,Main-207-,,0,0,0,,Enel'e ulaşmana yardım edeceğiz, Wyper!Dialogue: 50,0:30:45.03,0:30:48.58,Main-207-,,0,0,0,,Anladım şimdi! Kendi yolumu açacağım!Dialogue: 50,0:30:56.04,0:30:57.63,Main-207-,,0,0,0,,Dev yılan...Dialogue: 50,0:31:02.22,0:31:04.09,Main-207-,,0,0,0,,– ...gülüyor! – ...gülüyor!Dialogue: 50,0:31:09.76,0:31:11.31,Main-207-,,0,0,0,,Dur!Dialogue: 50,0:31:13.06,0:31:16.02,Main-207-,,0,0,0,,Bizi rahat bırakın!Dialogue: 50,0:31:16.02,0:31:18.02,Main-207-,,0,0,0,,N-Nami?!Dialogue: 50,0:31:18.02,0:31:18.90,Main-207-,,0,0,0,,Aisa!Dialogue: 50,0:31:18.90,0:31:20.23,Main-207-,,0,0,0,,Genç bayan!Dialogue: 50,0:31:20.23,0:31:21.98,Main-207-,,0,0,0,,Öldürün onları!Dialogue: 50,0:31:38.92,0:31:41.17,Main-207-,,0,0,0,,Aisa, burada ne yapıyorsun?!Dialogue: 50,0:31:41.17,0:31:43.71,Main-207-,,0,0,0,,Nami! Niye buradasın?!Dialogue: 50,0:31:45.09,0:31:47.01,Main-207-,,0,0,0,,Zoro! Diğerleri nerede?Dialogue: 50,0:31:47.01,0:31:48.18,Main-207-,,0,0,0,,Wyper!Dialogue: 50,0:31:48.18,0:31:50.89,Main-207-,,0,0,0,,Neyin peşindesin, Mavi Denizli?!Dialogue: 50,0:31:51.35,0:31:53.77,Main-207-,,0,0,0,,Aisa! O kadından uzaklaş!Dialogue: 50,0:32:00.90,0:32:02.28,Main-207-,,0,0,0,,Ucuz kurtulduk.Dialogue: 50,0:32:02.28,0:32:05.49,Main-207-,,0,0,0,,Şeytan! Wyper, seni şeytan!Dialogue: 50,0:32:05.86,0:32:08.49,Main-207-,,0,0,0,,Niye buraya geldiniz?Dialogue: 50,0:32:08.49,0:32:10.45,Main-207-,,0,0,0,,Niye mi?!Dialogue: 50,0:32:10.45,0:32:13.24,Main-207-,,0,0,0,,Çünkü şu devasa...Dialogue: 50,0:32:13.91,0:32:14.87,Main-207-,,0,0,0,,yılan...Dialogue: 50,0:32:21.38,0:32:23.00,Main-207-,,0,0,0,,Aptal...!Dialogue: 50,0:32:23.84,0:32:24.96,Main-207-,,0,0,0,,Aisa!Dialogue: 50,0:32:38.27,0:32:39.85,Main-207-,,0,0,0,,Wyper!Dialogue: 50,0:32:43.82,0:32:47.32,Main-207-,,0,0,0,,Gardınızı indirdiniz, ahmaklar.Dialogue: 50,0:32:49.07,0:32:51.41,Main-207-,,0,0,0,,Başkaları için endişelenmemeliydiniz!Dialogue: 50,0:32:52.41,0:32:53.91,Main-207-,,0,0,0,,Hiçbiriniz...Dialogue: 50,0:32:53.91,0:32:56.54,Main-207-,,0,0,0,,buradan canlı çıkamayacaksınız!Dialogue: 0,0:01:50.05,0:01:53.13,Title-207-,,0,0,0,,KonçertoDialogue: 1,0:01:50.05,0:01:53.13,Title-207-,,0,0,0,,KonçertoDialogue: 0,0:00:46.23,0:00:50.41,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 0,0:00:46.23,0:00:50.41,Credits-207-,,0,0,0,,FeesoDialogue: 0,0:00:51.78,0:00:55.70,Credits-207-,,0,0,0,,GrafikDialogue: 0,0:00:51.78,0:00:55.70,Credits-207-,,0,0,0,,DatenshiDialogue: 0,0:00:56.79,0:01:01.04,Credits-207-,,0,0,0,,Kalite KontrolDialogue: 0,0:00:56.79,0:01:01.04,Credits-207-,,0,0,0,,Galaxy 9000 Pepperjack PhosCity Scolines ZenefDialogue: 0,0:01:01.04,0:01:07.80,Credits-207-,,0,0,0,,KaraokeDialogue: 0,0:01:01.04,0:01:07.80,Credits-207-,,0,0,0,,KaitouYahikoDialogue: 0,0:01:07.80,0:01:11.80,Credits-207-,,0,0,0,,MüzikDialogue: 0,0:01:07.80,0:01:11.80,Credits-207-,,0,0,0,,HaleeDialogue: 0,0:01:23.81,0:01:27.44,Credits-207-,,0,0,0,,Zamanlama/DizgiDialogue: 0,0:01:23.81,0:01:27.44,Credits-207-,,0,0,0,,GabDialogue: 0,0:01:27.44,0:01:31.49,Credits-207-,,0,0,0,,Altyazı Düzenleme [TR]Dialogue: 0,0:01:27.44,0:01:31.49,Credits-207-,,0,0,0,,Jack Cohle -onepacetr.net-Dialogue: 0,0:01:33.57,0:01:37.04,Credits-207-,,0,0,0,,Çevirmenler [TR]Dialogue: 0,0:01:33.57,0:01:37.04,Credits-207-,,0,0,0,,Jack Cohle Kazasker -onepacetr.net-Dialo