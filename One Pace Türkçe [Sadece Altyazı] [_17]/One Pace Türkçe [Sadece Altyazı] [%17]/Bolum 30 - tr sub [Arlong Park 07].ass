8,23,23,23,1Style: Lyrics-furigana,Duality,36,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,2.95,0,2,23,23,34,1Style: Lyrics,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,2,23,23,34,1Style: Karaoke,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,23,1Style: Kanji,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,146,1Style: Roger-Monologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1Style: Romaji ED,Josefin Sans,80,&H00D0740C,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,8,10,10,20,1Style: Translation ED,Josefin Sans,82,&H00D0740C,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,2,10,10,20,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:50.01,0:02:00.01,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:53.51,0:01:55.51,Main-207-,,0,0,0,,Ne oldu, Roronoa Zoro?Dialogue: 0,0:01:55.51,0:01:58.47,Main-207-,,0,0,0,,Neden bilmiyorum ama acı içinde gözüküyorsun.Dialogue: 0,0:01:58.47,0:02:02.44,Main-207-,,0,0,0,,Bu hâldeyken altı kılıç stilimi yenebileceğini mi düşünüyorsun?Dialogue: 0,0:02:02.44,0:02:05.44,Main-207-,,0,0,0,,Tüm dünya kazanamayacağını söylerdi.Dialogue: 0,0:02:06.31,0:02:07.94,Main-207-,,0,0,0,,Duymak istemiyorum.Dialogue: 0,0:02:08.32,0:02:11.44,Main-207-,,0,0,0,,Zoro abi tehlikede!Dialogue: 0,0:02:11.44,0:02:13.70,Main-207-,,0,0,0,,Yaraları yüzünden ateşi yükseldi.Dialogue: 0,0:02:13.70,0:02:15.70,Main-207-,,0,0,0,,Muhtemelen zar zor ayakta.Dialogue: 0,0:02:15.70,0:02:20.54,Main-207-,,0,0,0,,Eğer yaraları açılırsa, kesinlikle ölür!Dialogue: 0,0:02:20.54,0:02:23.08,Main-207-,,0,0,0,,Şimdi bunu dert etmenin sırası değil!Dialogue: 0,0:02:23.08,0:02:26.92,Main-207-,,0,0,0,,Evet! O, bu durumdan çıkış yolu bulabilecek tek kişi!Dialogue: 0,0:02:27.92,0:02:31.13,Main-207-,,0,0,0,,Sana üç kılıç stilini göstereceğim.Dialogue: 0,0:02:31.92,0:02:35.43,Main-207-,,0,0,0,,Yosaku! Johnny! Kılıçlarınızı verin!Dialogue: 0,0:02:35.43,0:02:36.43,Main-207-,,0,0,0,,Elbette!Dialogue: 0,0:02:36.43,0:02:38.89,Main-207-,,0,0,0,,Abi, yakala!Dialogue: 0,0:02:39.64,0:02:43.10,Thoughts-207-,,0,0,0,,Kahretsin! Bayılacakmışım gibi hissediyorum.Dialogue: 0,0:02:43.10,0:02:45.10,Thoughts-207-,,0,0,0,,Acaba ne kadar daha ayakta durabilirim.Dialogue: 0,0:02:45.60,0:02:47.31,Main-207-,,0,0,0,,Abi! Kılıçlarımızı yolladık!Dialogue: 0,0:02:47.31,0:02:49.48,Main-207-,,0,0,0,,Kullanmak istiyorum demiştin! Yakalasana!Dialogue: 0,0:02:49.48,0:02:54.11,Main-207-,,0,0,0,,Ha! Sana iki elli insanın adım atamayacağı bir dünya göstereceğim!Dialogue: 0,0:02:54.11,0:02:55.20,Main-207-,,0,0,0,,Altı Kılıç Stili:Dialogue: 0,0:02:55.20,0:02:56.66,Main-207-,,0,0,0,,Abi! Dikkat et!!Dialogue: 0,0:02:56.66,0:02:58.16,Main-207-,,0,0,0,,Dokunaç Fırıldağı!Dialogue: 0,0:02:58.16,0:02:59.53,Main-207-,,0,0,0,,Abi!Dialogue: 0,0:03:04.41,0:03:05.50,Main-207-,,0,0,0,,Üç Kılıç Stili:Dialogue: 0,0:03:08.92,0:03:10.80,Main-207-,,0,0,0,,Süzülen Kurt Kılıçları!Dialogue: 0,0:03:17.80,0:03:19.30,Main-207-,,0,0,0,,Başardı!Dialogue: 0,0:03:19.30,0:03:22.52,Main-207-,,0,0,0,,Altı kılıçlı saldırıyı savuşturdu! İnanılmaz!Dialogue: 0,0:03:25.77,0:03:30.06,Main-207-,,0,0,0,,Ne inanılmaz konsantrasyon! Ne inanılmaz irade!Dialogue: 0,0:03:30.44,0:03:33.53,Main-207-,,0,0,0,,Ah... Ne cüretkâr bir küstahlık!Dialogue: 0,0:03:33.90,0:03:36.90,Main-207-,,0,0,0,,İşte şimdi kızdım, balıkçının evladı!Dialogue: 0,0:03:36.90,0:03:38.36,Main-207-,,0,0,0,,Seni öldüreceğim!Dialogue: 0,0:03:38.36,0:03:41.20,Main-207-,,0,0,0,,Düşününce çok açık!Dialogue: 0,0:03:41.20,0:03:43.54,Main-207-,,0,0,0,,Bende altı kılıç var; sende ise üç!Dialogue: 0,0:03:43.54,0:03:46.37,Main-207-,,0,0,0,,Beni yenebilmenin imkânı yok!Dialogue: 0,0:03:46.37,0:03:47.54,Main-207-,,0,0,0,,Değil mi?!Dialogue: 0,0:03:47.54,0:03:51.50,Main-207-,,0,0,0,,Çok mu açık? Ölümcül bir yanlış hesaplama.Dialogue: 0,0:03:51.84,0:03:53.21,Flashbacks-207-,,0,0,0,,Omzundaki yük nedir?Dialogue: 0,0:03:53.21,0:03:55.84,Flashbacks-207-,,0,0,0,,Gücü neden amaçlıyorsun?Dialogue: 0,0:03:58.05,0:04:02.43,Main-207-,,0,0,0,,Üç kılıç ya da altı kılıç...Dialogue: 0,0:04:02.81,0:04:05.18,Main-207-,,0,0,0,,Bunun hiçbir önemi yok!Dialogue: 0,0:04:07.44,0:04:12.52,Main-207-,,0,0,0,,Kılıçlarımızın taşıdığı yük farklı!Dialogue: 0,0:04:19.32,0:04:21.12,Thoughts-207-,,0,0,0,,Çok fazla su yutmuş.Dialogue: 0,0:04:21.12,0:04:23.58,Thoughts-207-,,0,0,0,,Onu hemen yukarı çıkarmalıyız, yoksa geç olacak.Dialogue: 0,0:04:25.58,0:04:28.16,Thoughts-207-,,0,0,0,,Kahretsin! Sanırım denizin altında kıramayacağım.Dialogue: 0,0:04:28.16,0:04:29.83,Thoughts-207-,,0,0,0,,Gücüm yetmiyor.Dialogue: 0,0:04:29.83,0:04:31.25,Thoughts-207-,,0,0,0,,Gen-san, acele et.Dialogue: 0,0:04:31.25,0:04:33.34,Thoughts-207-,,0,0,0,,Hiç iyi değil. Taşı kıramıyorum.Dialogue: 0,0:04:33.34,0:04:36.34,Thoughts-207-,,0,0,0,,Oksijen tüpü yeterli olurdu ama alacak vaktimiz yok.Dialogue: 0,0:04:36.96,0:04:39.72,Thoughts-207-,,0,0,0,,Onu su üstüne taşla beraber çıkartamayız da.Dialogue: 0,0:04:40.34,0:04:41.43,Thoughts-207-,,0,0,0,,– Doğru! – Doğru!Dialogue: 0,0:04:46.35,0:04:48.14,Main-207-,,0,0,0,,Yük mü dedin?Dialogue: 0,0:04:48.14,0:04:52.02,Main-207-,,0,0,0,,Anladım. Yani senin kılıçların ağır.Dialogue: 0,0:04:52.02,0:04:56.44,Main-207-,,0,0,0,,İnanmayacaksın ama benim her bir kılıcım en az 300 kilo.Dialogue: 0,0:04:56.44,0:05:01.11,Main-207-,,0,0,0,,Bunlar senin cılız insan kılıçlarından çok daha ağır!Dialogue: 0,0:05:01.66,0:05:04.12,Main-207-,,0,0,0,,Akılsızla münakaşa olmaz.Dialogue: 0,0:05:04.12,0:05:06.58,Main-207-,,0,0,0,,Altı-Kılıç Stili: Ahtapot Kapanı!Dialogue: 0,0:05:07.04,0:05:08.45,Main-207-,,0,0,0,,Yeni Yılın...Dialogue: 0,0:05:10.54,0:05:11.54,Main-207-,,0,0,0,,Açık...Dialogue: 0,0:05:14.04,0:05:14.96,Main-207-,,0,0,0,,Vücut Darbesi!Dialogue: 0,0:05:16.09,0:05:17.80,Main-207-,,0,0,0,,Kalleşlik bu! Tam yarasına vurdu!Dialogue: 0,0:05:18.17,0:05:19.34,Main-207-,,0,0,0,,İbret olsun sana!Dialogue: 0,0:05:19.34,0:05:19.88,Main-207-,,0,0,0,,Abi!Dialogue: 0,0:05:20.51,0:05:21.76,Main-207-,,0,0,0,,Ölecek!Dialogue: 0,0:05:22.09,0:05:24.14,Main-207-,,0,0,0,,Yere düşmeden seni öldüreceğim!Dialogue: 0,0:05:24.14,0:05:25.26,Main-207-,,0,0,0,,Altı Kılıç Stili Gizli Tekniği:Dialogue: 0,0:05:25.93,0:05:27.64,Main-207-,,0,0,0,,Altı Kılıcın Vals'ı!Dialogue: 0,0:05:28.10,0:05:30.35,Main-207-,,0,0,0,,Kılıçlarıma dokunduğunda kıyma olacaksın!Dialogue: 0,0:05:30.35,0:05:32.06,Main-207-,,0,0,0,,Kıyma ol!Dialogue: 0,0:05:33.02,0:05:33.98,Main-207-,,0,0,0,,Abi!Dialogue: 0,0:05:41.99,0:05:43.49,Main-207-,,0,0,0,,Ah!Dialogue: 0,0:05:43.49,0:05:44.99,Main-207-,,0,0,0,,– Abi! – Abi!Dialogue: 0,0:05:52.67,0:05:57.59,Main-207-,,0,0,0,,Piç kurusu! Vuruşlarını kılıçlarımla kusursuzca senkronladı.Dialogue: 0,0:05:57.59,0:06:00.84,Main-207-,,0,0,0,,Bir de üstüne bedava kan akıtma hizmeti verdi!Dialogue: 0,0:06:00.84,0:06:04.14,Main-207-,,0,0,0,,Beni hafife alma! Ben palyaço değilim!Dialogue: 0,0:06:04.14,0:06:06.55,Main-207-,,0,0,0,,Çok öfkeliyim! Bu hakaretini affetmeyeceğim!Dialogue: 0,0:06:06.55,0:06:08.43,Main-207-,,0,0,0,,Onu öldü bilin!Dialogue: 0,0:06:08.89,0:06:11.93,Main-207-,,0,0,0,,Abi çok fazla acı çekiyor.Dialogue: 0,0:06:11.93,0:06:15.35,Main-207-,,0,0,0,,O darbeyle yaraları açılmış olabilir.Dialogue: 0,0:06:15.35,0:06:19.15,Main-207-,,0,0,0,,Onun yerine geçebilseydim, geçerdim.Dialogue: 0,0:06:20.65,0:06:24.70,Thoughts-207-,,0,0,0,,Beni felç edecek yaralarım olsa bile...Dialogue: 0,0:06:24.70,0:06:26.91,Thoughts-207-,,0,0,0,,ayakta durmalıyım.Dialogue: 0,0:06:30.08,0:06:32.91,Main-207-,,0,0,0,,Altı Kılıç Stili: Ahtapot Kapanı!Dialogue: 0,0:06:32.91,0:06:34.29,Main-207-,,0,0,0,,Buraya kadar!Dialogue: 0,0:06:35.75,0:06:39.75,Thoughts-207-,,0,0,0,,Ölümcül yaralara bile...Dialogue: 0,0:06:39.75,0:06:41.46,Thoughts-207-,,0,0,0,,yenilmemeliyim.Dialogue: 0,0:06:41.46,0:06:42.38,Main-207-,,0,0,0,,Yeni Yıl'ın...Dialogue: 0,0:06:44.34,0:06:46.89,Thoughts-207-,,0,0,0,,Olağanüstü Şahin Göz'ü yenebilmek için,Dialogue: 0,0:06:48.14,0:06:50.35,Thoughts-207-,,0,0,0,,normal biri olamam!Dialogue: 0,0:06:56.85,0:06:58.90,Main-207-,,0,0,0,,Ejder Hortumu!Dialogue: 0,0:07:17.25,0:07:18.63,Main-207-,,0,0,0,,Hachi...Dialogue: 0,0:07:19.50,0:07:20.84,Main-207-,,0,0,0,,Nasıl...Dialogue: 0,0:07:22.21,0:07:24.38,Main-207-,,0,0,0,,üç kılıç stiline...Dialogue: 0,0:07:25.47,0:07:27.26,Main-207-,,0,0,0,,yenildim?Dialogue: 0,0:07:32.77,0:07:34.14,Main-207-,,0,0,0,,Seni ucube,Dialogue: 0,0:07:35.02,0:07:36.98,Main-207-,,0,0,0,,şimdi kılıçlarımızın...Dialogue: 0,0:07:38.60,0:07:42.15,Main-207-,,0,0,0,,taşıdığı yükün farkını anladın.Dialogue: 0,0:07:42.15,0:07:43.90,Main-207-,,0,0,0,,Tatmin oldun mu?Dialogue: 0,0:07:49.24,0:07:51.87,Main-207-,,0,0,0,,O ahtapot manyağı artık mesele değil.Dialogue: 0,0:07:52.87,0:07:55.33,Main-207-,,0,0,0,,Acele edip Luffy'yi kurtarmalıyım.Dialogue: 0,0:07:55.33,0:07:56.79,Main-207-,,0,0,0,,Abi! Dikkat et!Dialogue: 0,0:07:56.79,0:07:58.50,Main-207-,,0,0,0,,Ne cüretle Hachi'yi yenersin!Dialogue: 0,0:08:00.46,0:08:01.63,Main-207-,,0,0,0,,Ulan...Dialogue: 0,0:08:02.17,0:08:04.63,Main-207-,,0,0,0,,Beni gerçekten uçurdun!Dialogue: 0,0:08:04.96,0:08:06.05,Main-207-,,0,0,0,,He?Dialogue: 0,0:08:06.63,0:08:11.60,Main-207-,,0,0,0,,Doğu Mavi'de yumruğuma dayanacak biri olduğunu düşünmemiştim.Dialogue: 0,0:08:12.14,0:08:17.06,Main-207-,,0,0,0,,Muhtemelen bir sürü var... Özellikle bildiğim bir restorantta.Dialogue: 0,0:08:18.69,0:08:20.77,Main-207-,,0,0,0,,Bana saygısızlık ediyorsun.Dialogue: 0,0:08:21.40,0:08:23.07,Main-207-,,0,0,0,,A-Abi! Bu pervasızca!Dialogue: 0,0:08:23.07,0:08:24.40,Main-207-,,0,0,0,,Hey, dursana!Dialogue: 0,0:08:24.40,0:08:27.70,Main-207-,,0,0,0,,Denize öyle bir yarayla girersen ölürsün!Dialogue: 0,0:08:27.70,0:08:31.37,Main-207-,,0,0,0,,Kapa çeneni! Zaten uzun zamandır aşağıda.Dialogue: 0,0:08:31.37,0:08:33.45,Main-207-,,0,0,0,,Onu yenmeni bekleyecek zamanımız yok.Dialogue: 0,0:08:33.45,0:08:35.16,Main-207-,,0,0,0,,Evet, biliyorum.Dialogue: 0,0:08:35.75,0:08:38.37,Main-207-,,0,0,0,,Zaman harcayacak lüksümüz kalmadı.Dialogue: 0,0:08:38.37,0:08:40.67,Main-207-,,0,0,0,,Durumun farkında olup seni durduruyorum.Dialogue: 0,0:08:40.67,0:08:42.63,Main-207-,,0,0,0,,Çeneni kapatmalısın, moron!Dialogue: 0,0:08:43.09,0:08:44.84,Main-207-,,0,0,0,,Bunu yaparsam yakınamazsın, ha?!Dialogue: 0,0:08:47.30,0:08:48.51,Main-207-,,0,0,0,,Etkileyici!Dialogue: 0,0:08:48.51,0:08:50.63,Main-207-,,0,0,0,,Benimle suda mı savaşmak istiyor?Dialogue: 0,0:08:50.63,0:08:52.01,Main-207-,,0,0,0,,Tam bi' aptal!Dialogue: 0,0:08:52.01,0:08:53.43,Main-207-,,0,0,0,,Umursamaz herif!Dialogue: 0,0:08:53.43,0:08:57.22,Main-207-,,0,0,0,,Suyun içinde savaşmak tam da istedikleri şey!Dialogue: 0,0:09:08.44,0:09:11.91,Thoughts-207-,,0,0,0,,O? Cocoyashi Köyü'ndeki adam!Dialogue: 0,0:09:12.45,0:09:15.62,Thoughts-207-,,0,0,0,,O boynu mu? Luffy'nin boynunu uzatmışlar!Dialogue: 0,0:09:18.29,0:09:21.17,Thoughts-207-,,0,0,0,,Üzgünüm, bedenini tamamen çekebilecek gücüm yok.Dialogue: 0,0:09:21.17,0:09:24.92,Thoughts-207-,,0,0,0,,En azından kafan buradayken, nefes al!Dialogue: 0,0:09:25.29,0:09:27.63,Thoughts-207-,,0,0,0,,Nefes al artık! Umarım çok geç olmamıştır!Dialogue: 0,0:09:27.63,0:09:29.84,Thoughts-207-,,0,0,0,,Acele etmezsem nefessiz kalacağım!Dialogue: 0,0:09:30.51,0:09:33.34,Thoughts-207-,,0,0,0,,Anladım. Taşı kıramadı.Dialogue: 0,0:09:33.34,0:09:36.97,Thoughts-207-,,0,0,0,,Ama Luffy'nin kafası suyun üstündeyse en azından nefes alabilir.Dialogue: 0,0:09:36.97,0:09:40.06,Thoughts-207-,,0,0,0,,Bu demek oluyor ki taşı tekmemle parçalarsam...Dialogue: 0,0:09:40.06,0:09:41.85,Thoughts-207-,,0,0,0,,gerisini onlara bırakabilirim.Dialogue: 0,0:09:41.85,0:09:44.81,Main-207-,,0,0,0,,Balıkadam Karatesi... Balyoz!Dialogue: 0,0:09:47.23,0:09:48.28,Main-207-,,0,0,0,,Ders zamanı!Dialogue: 0,0:09:48.82,0:09:51.61,Main-207-,,0,0,0,,İnsandan başka bir şey değilsiniz.Dialogue: 0,0:09:55.32,0:09:58.20,Main-207-,,0,0,0,,Heh! Sen Cocoyashi Köyü'ndensin.Dialogue: 0,0:09:58.20,0:09:59.83,Main-207-,,0,0,0,,Zamanını boşa harcıyorsun.Dialogue: 0,0:09:59.83,0:10:01.66,Thoughts-207-,,0,0,0,,Kahretsin! Beni buldu!Dialogue: 0,0:10:02.04,0:10:05.92,Main-207-,,0,0,0,,Ömrünü böyle uzatmanın ne gereği var?!Dialogue: 0,0:10:02.04,0:10:05.92,Note-207-,,0,0,0,,Ç.N: Boynunu uzatmasıyla kelime oyunu yapıyor.Dialogue: 0,0:10:05.92,0:10:08.30,Main-207-,,0,0,0,,Seni de boğacağım!Dialogue: 0,0:10:11.26,0:10:12.97,Thoughts-207-,,0,0,0,,Buna asla izin vermem!Dialogue: 0,0:10:13.72,0:10:16.93,Main-207-,,0,0,0,,Kahrolası insan!Dialogue: 0,0:10:18.64,0:10:21.64,Main-207-,,0,0,0,,Cidden suyun altında benimle dövüşmek mi istiyorsun?!Dialogue: 0,0:10:21.64,0:10:24.98,Main-207-,,0,0,0,,Sizler nefesinizi tutmak zorunda olan aşağılık bir ırksınız!Dialogue: 0,0:10:26.31,0:10:28.40,Main-207-,,0,0,0,,Tamam, dövüşeceğim.Dialogue: 0,0:10:28.40,0:10:31.82,Main-207-,,0,0,0,,Balıkadam Karatesi: Saç İpi Düellosu!Dialogue: 0,0:10:39.49,0:10:43.21,Main-207-,,0,0,0,,O da neydi? Suyun altında tekmelerinin gücü yarı yarıya düşmüş.Dialogue: 0,0:10:43.21,0:10:45.71,Main-207-,,0,0,0,,İnsanların sınırı bu.Dialogue: 0,0:10:45.71,0:10:50.50,Main-207-,,0,0,0,,Ama suda olmak, Balıkadam Karatesi'ni zayıflatmaz!Dialogue: 0,0:10:51.05,0:10:54.43,Main-207-,,0,0,0,,Hatta bazı tekniklerin gücü iki katına çıkar!Dialogue: 0,0:10:55.93,0:10:57.39,Main-207-,,0,0,0,,Balıkadam Karatesi:Dialogue: 0,0:10:57.85,0:10:58.68,Main-207-,,0,0,0,,Yakıcı...Dialogue: 0,0:10:59.39,0:11:01.64,Main-207-,,0,0,0,,Bağırsak Darbesi!Dialogue: 0,0:11:06.35,0:11:07.65,Main-207-,,0,0,0,,Balıkadam Karatesi:Dialogue: 0,0:11:10.90,0:11:13.86,Main-207-,,0,0,0,,Öfkeli Balta Tekmesi!Dialogue: 0,0:11:19.62,0:11:20.99,Main-207-,,0,0,0,,Çene Kırıcı!Dialogue: 0,0:11:25.12,0:11:26.50,Main-207-,,0,0,0,,Ölümcül...Dialogue: 0,0:11:28.38,0:11:30.38,Main-207-,,0,0,0,,Avuç İçi Bombası!Dialogue: 0,0:11:52.69,0:11:55.32,Thoughts-207-,,0,0,0,,Hava! Hava! Hava! Hava! Oksijen! Hava!Dialogue: 0,0:11:55.74,0:11:58.41,Thoughts-207-,,0,0,0,,Çok fazla hava kaçırdım! Nefes alamıyorum!Dialogue: 0,0:12:04.25,0:12:05.58,Main-207-,,0,0,0,,Nereye böyle?Dialogue: 0,0:12:05.58,0:12:09.67,Thoughts-207-,,0,0,0,,Kahretsin! Bırak geçeyim. Havaya ihtiyacım var! Nefes almalıyım!Dialogue: 0,0:12:10.13,0:12:12.50,Main-207-,,0,0,0,,Dayanıklılığın şaşırtıcı.Dialogue: 0,0:12:12.50,0:12:14.13,Main-207-,,0,0,0,,İnsan olduğuna inanamıyorum.Dialogue: 0,0:12:14.88,0:12:16.47,Thoughts-207-,,0,0,0,,Bırak nefes alayım...Dialogue: 0,0:12:17.59,0:12:19.30,Main-207-,,0,0,0,,Yanlış hatırlamıyorsam,Dialogue: 0,0:12:19.30,0:12:23.93,Main-207-,,0,0,0,,bir bayana zarar verenlerin pislik olduğunu söylemiştin.Dialogue: 0,0:12:24.43,0:12:26.06,Main-207-,,0,0,0,,Ama sonuca bi' bak.Dialogue: 0,0:12:26.06,0:12:29.73,Main-207-,,0,0,0,,İşe yaramaz kahramanlığının sonucu bu.Dialogue: 0,0:12:32.06,0:12:35.36,Main-207-,,0,0,0,,Burada benden kaçamadan öleceksin.Dialogue: 0,0:12:35.36,0:12:38.53,Main-207-,,0,0,0,,O köylü ve lastik çocuk da ölecek.Dialogue: 0,0:12:38.53,0:12:44.62,Main-207-,,0,0,0,,Zoro'yu, uzun burunlu adamı hatta köydeki asileri dahi öldüreceğiz.Dialogue: 0,0:12:44.62,0:12:48.58,Main-207-,,0,0,0,,Bunca olandan sonra Nami'nin ihaneti de yanına kâr kalmayacak!Dialogue: 0,0:12:49.29,0:12:51.00,Main-207-,,0,0,0,,Anladın mı?Dialogue: 0,0:12:51.46,0:12:54.46,Main-207-,,0,0,0,,Önemsiz kahramanlığınla...Dialogue: 0,0:12:54.46,0:13:00.22,Main-207-,,0,0,0,,Nami'yi ya da bir başkasını koruyabileceğini düşünme!Dialogue: 0,0:13:06.81,0:13:09.81,Main-207-,,0,0,0,,Oldukça güçlü olabilirsin,Dialogue: 0,0:13:09.81,0:13:14.61,Main-207-,,0,0,0,,ama saçmalıkların zayıflığını ele veriyor.Dialogue: 0,0:13:16.11,0:13:20.65,Main-207-,,0,0,0,,Siz insanlar sudaki ani basınç değişimini kaldıramazsınız, değil mi?Dialogue: 0,0:13:21.82,0:13:26.20,Main-207-,,0,0,0,,Yani, hızla derinliğe dalarsan...Dialogue: 0,0:13:27.08,0:13:29.79,Main-207-,,0,0,0,,vücudun içten parçalanır.Dialogue: 0,0:13:32.50,0:13:39.09,Main-207-,,0,0,0,,Parçalayan Basınç Dalışı!Dialogue: 0,0:13:45.93,0:13:48.22,Thoughts-207-,,0,0,0,,Bunu yanına bırakmayacağım!Dialogue: 0,0:13:48.77,0:13:52.73,Thoughts-207-,,0,0,0,,Kimseyi koruyamaz mıyım?!Dialogue: 0,0:14:06.45,0:14:09.37,Main-207-,,0,0,0,,Hâlâ ölmedi mi?Dialogue: 0,0:14:11.62,0:14:15.58,Main-207-,,0,0,0,,Tekrar yapmak istiyorsan, memnuniyetle!Dialogue: 0,0:14:16.09,0:14:19.42,Thoughts-207-,,0,0,0,,Karada ciğerlerinden nefes alıyorlar,Dialogue: 0,0:14:19.42,0:14:21.97,Thoughts-207-,,0,0,0,,ancak suda solungaçlarını kullanıyorlar.Dialogue: 0,0:14:24.64,0:14:28.47,Thoughts-207-,,0,0,0,,Bu da sadece konuşan balık oldukları anlamına geliyor.Dialogue: 0,0:14:29.97,0:14:32.14,Main-207-,,0,0,0,,İkinci kere hayatta kalabilecek misin?Dialogue: 0,0:14:32.14,0:14:36.65,Thoughts-207-,,0,0,0,,Solungaçlarına hava girerse balık ölür.Dialogue: 0,0:14:36.65,0:14:40.40,Thoughts-207-,,0,0,0,,Balık olduğuna göre bu da aşırı acıtıyor olmalı!Dialogue: 0,0:14:49.41,0:14:50.58,Main-207-,,0,0,0,,Hım?Dialogue: 0,0:14:52.20,0:14:53.41,Main-207-,,0,0,0,,Sen...Dialogue: 0,0:14:57.29,0:14:58.17,Main-207-,,0,0,0,,Hey...Dialogue: 0,0:14:58.17,0:15:01.05,Main-207-,,0,0,0,,Endişelenme. O iyi.Dialogue: 0,0:15:01.05,0:15:01.84,Main-207-,,0,0,0,,Cidden mi?!Dialogue: 0,0:15:01.84,0:15:02.88,Main-207-,,0,0,0,,Sayılır.Dialogue: 0,0:15:02.88,0:15:04.34,Main-207-,,0,0,0,,Sayılır mı?Dialogue: 0,0:15:04.34,0:15:05.97,Main-207-,,0,0,0,,Daha sonra açıklarım.Dialogue: 0,0:15:06.93,0:15:11.22,Main-207-,,0,0,0,,Neyse, sudan çık, seni lanet balık! Bu işi bitirelim!Dialogue: 0,0:15:14.48,0:15:17.19,Main-207-,,0,0,0,,Hâlâ anlamıyorsun, değil mi?Dialogue: 0,0:15:17.19,0:15:21.61,Main-207-,,0,0,0,,İster suda, ister karada, neresi olursa olsun her yer aynı.Dialogue: 0,0:15:21.61,0:15:23.74,Main-207-,,0,0,0,,Şimdi cidden sinirlendim!Dialogue: 0,0:15:24.11,0:15:27.41,Main-207-,,0,0,0,,Sana Balıkadam Karatesi'nin ruhunu tattıracağım!Dialogue: 0,0:15:28.62,0:15:32.66,Main-207-,,0,0,0,,Öncesinde seni uçuran yumruk, yüz tuğla yumruğuydu!Dialogue: 0,0:15:33.12,0:15:37.25,Main-207-,,0,0,0,,Ama benim nihai saldırım bin tuğla yumruğudur!Dialogue: 0,0:15:37.25,0:15:39.42,Main-207-,,0,0,0,,Hayatta kalma şansın...Dialogue: 0,0:15:39.42,0:15:42.92,Main-207-,,0,0,0,,sıfır!!!Dialogue: 0,0:15:43.96,0:15:44.72,Main-207-,,0,0,0,,Boyun!Dialogue: 0,0:15:48.64,0:15:50.80,Main-207-,,0,0,0,,Benim kahramanlığım boşuna mı?Dialogue: 0,0:15:52.26,0:15:53.89,Main-207-,,0,0,0,,Omuz!Dialogue: 0,0:15:54.89,0:15:57.60,Main-207-,,0,0,0,,Kimseyi koruyamam mı dedin?Dialogue: 0,0:15:57.60,0:16:01.40,Main-207-,,0,0,0,,Kaburga! Bel! Göğüs!Dialogue: 0,0:16:01.77,0:16:03.73,Main-207-,,0,0,0,,Uyluk!Dialogue: 0,0:16:07.99,0:16:10.12,Main-207-,,0,0,0,,Seni...Dialogue: 0,0:16:10.74,0:16:11.70,Main-207-,,0,0,0,,adi insan!Dialogue: 0,0:16:12.08,0:16:15.29,Main-207-,,0,0,0,,Nihai Yumruk: Bin Tuğla!Dialogue: 0,0:16:20.38,0:16:21.59,Main-207-,,0,0,0,,Koyun...Dialogue: 0,0:16:21.59,0:16:22.46,Main-207-,,0,0,0,,Tokmağı!Dialogue: 0,0:16:41.81,0:16:43.27,Main-207-,,0,0,0,,Tatlıya...Dialogue: 0,0:16:44.32,0:16:45.94,Main-207-,,0,0,0,,gerek yok gibi?Dialogue: 0,0:17:01.17,0:17:03.04,Main-207-,,0,0,0,,Kuroobi...Dialogue: 0,0:17:05.55,0:17:06.92,Main-207-,,0,0,0,,Hachi...Dialogue: 0,0:17:07.76,0:17:10.22,Main-207-,,0,0,0,,Sonuçta onlar küçük balıklar.Dialogue: 0,0:17:10.22,0:17:13.60,Main-207-,,0,0,0,,Balıklar, aşçılarla milyon yıl geçse de kapışamaz!Dialogue: 0,0:17:14.68,0:17:18.56,Main-207-,,0,0,0,,Bu oyunun kazananları biziz gibi görünüyor.Dialogue: 0,0:17:20.06,0:17:27.36,Main-207-,,0,0,0,,Sizi piçler, sevgili kardeşlerimi art arda dövmeye nasıl cüret edersiniz?Dialogue: 0,0:17:27.36,0:17:31.41,Main-207-,,0,0,0,,Kendinizi biraz fazla kaptırmıyor musunuz?!Dialogue: 0,0:17:34.66,0:17:38.87,Main-207-,,0,0,0,,Hey, Luffy'nin iyi durumda sayılır olmasıyla ne demek istedin?Dialogue: 0,0:17:38.87,0:17:42.00,Main-207-,,0,0,0,,Şu an için ölmeyecek demek oluyor.Dialogue: 0,0:17:42.00,0:17:46.46,Main-207-,,0,0,0,,Ama onu kurtarmak için yine denize dalmam gerekiyor,Dialogue: 0,0:17:47.46,0:17:51.34,Main-207-,,0,0,0,,gerçi o herif, izin verecek gibi durmuyor.Dialogue: 0,0:17:54.30,0:17:56.89,Main-207-,,0,0,0,,İnanılmaz! Gerçekten inanılmazlar!Dialogue: 0,0:17:57.68,0:18:00.43,Main-207-,,0,0,0,,Arlong Korsanları'nın iki yetkilisini yendiler!Dialogue: 0,0:18:04.90,0:18:07.73,Main-207-,,0,0,0,,Elimden gelen bu. Nefesim tükendi.Dialogue: 0,0:18:07.73,0:18:10.69,Main-207-,,0,0,0,,Gen-san, yer değişelim. Bu sefer ben dalayım.Dialogue: 0,0:18:10.69,0:18:12.49,Main-207-,,0,0,0,,Biraz su tükürdü.Dialogue: 0,0:18:12.49,0:18:13.74,Main-207-,,0,0,0,,Orada neler oluyor?Dialogue: 0,0:18:13.74,0:18:16.12,Main-207-,,0,0,0,,Endişelenme. Herkes hayatta.Dialogue: 0,0:18:16.12,0:18:17.24,Main-207-,,0,0,0,,Hatta,Dialogue: 0,0:18:17.74,0:18:19.75,Main-207-,,0,0,0,,inanması gerçekten zor...Dialogue: 0,0:18:19.75,0:18:22.04,Main-207-,,0,0,0,,ama bu savaş...Dialogue: 0,0:18:22.66,0:18:25.46,Main-207-,,0,0,0,,içimde sakladığım umudu alevlendirdi!Dialogue: 0,0:18:32.05,0:18:35.09,Main-207-,,0,0,0,,Aman be... Bana çok sıkıntı verdin!Dialogue: 0,0:18:35.84,0:18:38.51,Main-207-,,0,0,0,,Ne inanılmaz bir kaçma yeteneği!Dialogue: 0,0:18:40.10,0:18:41.81,Main-207-,,0,0,0,,Ama bu çok kolaydı.Dialogue: 0,0:18:41.81,0:18:44.73,Main-207-,,0,0,0,,Su tabancamın bir atışıyla anında öldü.Dialogue: 0,0:18:44.73,0:18:45.27,Main-207-,,0,0,0,,Hımm!Dialogue: 0,0:18:46.02,0:18:49.94,Main-207-,,0,0,0,,Sanırım geri dönmeliyim. Şimdiye kadar işleri bitmiş olmalı.Dialogue: 0,0:18:51.65,0:18:52.99,Thoughts-207-,,0,0,0,,Kurtuldum!Dialogue: 0,0:18:53.32,0:18:58.87,Thoughts-207-,,0,0,0,,İşe yaradı! Ketçap Yıldız'ını yaptığım için çok mutluyum.Dialogue: 0,0:18:58.87,0:19:04.58,Thoughts-207-,,0,0,0,,Suyla beni vurduğunu sanıyor! Evine dön, zeki çocuk!Dialogue: 0,0:19:06.42,0:19:10.50,Thoughts-207-,,0,0,0,,Cidden, ne kadar korkunç bir ırk.Dialogue: 0,0:19:10.84,0:19:15.63,Thoughts-207-,,0,0,0,,Köydeki evleri ters düz edebiliyorlar.Dialogue: 0,0:19:16.22,0:19:22.64,Thoughts-207-,,0,0,0,,Nami için üzülüyorum ve ona yardım etmek istiyorum ama...Dialogue: 0,0:19:22.64,0:19:23.60,Main-207-,,0,0,0,,Ha?Dialogue: 0,0:19:26.23,0:19:27.69,Main-207-,,0,0,0,,Bana öyle geldi gibi.Dialogue: 0,0:19:28.40,0:19:30.90,Thoughts-207-,,0,0,0,,Sanırım ölmeye devam edeceğim.Dialogue: 0,0:19:31.69,0:19:35.90,Thoughts-207-,,0,0,0,,A... Ama aslında, yine de ketçapla kaplıyım...Dialogue: 0,0:19:35.90,0:19:39.78,Thoughts-207-,,0,0,0,,Ölümcül bir savaşın izlerini taşıyor gibi görünmeliyim.Dialogue: 0,0:19:39.78,0:19:41.45,Thoughts-207-,,0,0,0,,Ah, evet!Dialogue: 0,0:19:41.45,0:19:45.04,Thoughts-207-,,0,0,0,,Tüm vücudum çamurlu bir hâlde ortaya çıkarsam, öyle görünebilir.Dialogue: 0,0:19:45.04,0:19:49.75,Main-207-,,0,0,0,,"Ahh, üzgünüm. Kaybettim" gibi bir şey derim.Dialogue: 0,0:19:51.00,0:19:53.26,Main-207-,,0,0,0,,Hım. Acaba,Dialogue: 0,0:19:53.26,0:19:58.18,Main-207-,,0,0,0,,"O piçi neredeyse haklıyordum ama kaçtı" demek daha mı iyi?Dialogue: 0,0:19:58.18,0:20:01.22,Main-207-,,0,0,0,,Bu o kadar da inandırıcı olmayabilir.Dialogue: 0,0:20:01.76,0:20:03.97,Flashbacks-207-,,0,0,0,,Biz bir ekibiz, değil mi?Dialogue: 0,0:20:04.35,0:20:09.40,Main-207-,,0,0,0,,"Ağlama Nami. Biz sadece doğru olanı yaptık."Dialogue: 0,0:20:09.90,0:20:12.61,Flashbacks-207-,,0,0,0,,Kaybetmektense ölmeyi yeğlerim.Dialogue: 0,0:20:12.61,0:20:16.45,Main-207-,,0,0,0,,"Yani, hepimiz çok iyi mücadele ettik."Dialogue: 0,0:20:16.78,0:20:21.78,Flashbacks-207-,,0,0,0,,O, bir bayana zarar verecek lanet bir çeteden 100 kat daha iyidir.Dialogue: 0,0:20:22.53,0:20:25.75,Main-207-,,0,0,0,,"Yani, kesinlikle ölümüne bir savaştı."Dialogue: 0,0:20:26.29,0:20:29.88,Flashbacks-207-,,0,0,0,,Tamamlamam gereken bir iş var. Tek seçeneğim buydu!Dialogue: 0,0:20:31.71,0:20:36.34,Main-207-,,0,0,0,,"Yani, yaralarım o kadar da kötü değil."Dialogue: 0,0:20:36.67,0:20:38.76,Flashbacks-207-,,0,0,0,,Nami abla ağlıyordu!Dialogue: 0,0:20:38.76,0:20:42.30,Flashbacks-207-,,0,0,0,,Hayatlarını ortaya koymak için bundan başka sebebe ihtiyaçları mı var?Dialogue: 0,0:20:42.89,0:20:47.27,Flashbacks-207-,,0,0,0,,Henüz on yaşındaydı. Bu seçimin zorluğunu hayal edebiliyor musunuz?Dialogue: 0,0:20:49.23,0:20:52.15,Flashbacks-207-,,0,0,0,,– Savaşacağız! – Savaşacağız!Dialogue: 0,0:20:56.74,0:21:03.16,Main-207-,,0,0,0,,“Yani, dövüşme tarzım... gerçekten...”Dialogue: 0,0:21:07.50,0:21:08.37,Thoughts-207-,,0,0,0,,Ne...Dialogue: 0,0:21:09.66,0:21:11.33,Thoughts-207-,,0,0,0,,Ne kadar utanç verici!Dialogue: 0,0:21:15.92,0:21:20.38,Thoughts-207-,,0,0,0,,Nasıl bu kadar utanç verici olabilirim?!Dialogue: 0,0:21:20.38,0:21:23.22,Main-207-,,0,0,0,,Bekle, seni şerefsiz balık!Dialogue: 0,0:21:25.26,0:21:28.85,Main-207-,,0,0,0,,Ne oldu? Hâlâ hayatta mısın?Dialogue: 0,0:21:30.69,0:21:35.07,Main-207-,,0,0,0,,Elbette! Sanki yarı balık biri beni vurabilir de...!Dialogue: 0,0:21:37.40,0:21:41.66,Thoughts-207-,,0,0,0,,Köyümü terk ettiğim anda, barış ve güvenlik gibi...Dialogue: 0,0:21:41.66,0:21:44.24,Thoughts-207-,,0,0,0,,şeyleri de geride bıraktım.Dialogue: 0,0:21:45.03,0:21:50.79,Thoughts-207-,,0,0,0,,Her gün ölümle yüzleşiyorlar, bu yüzden gülüşleri içten!Dialogue: 0,0:21:53.25,0:21:55.92,Thoughts-207-,,0,0,0,,Bu yüzden denize açılmaya karar verdim.Dialogue: 0,0:21:55.92,0:21:57.88,Thoughts-207-,,0,0,0,,Ben de kalpten gülmeyi istedim!Dialogue: 0,0:21:57.88,0:22:00.34,Thoughts-207-,,0,0,0,,Eğer şimdi her şeyimle savaşmazsam,Dialogue: 0,0:22:00.34,0:22:03.89,Thoughts-207-,,0,0,0,,onlarla aynı gemide yaşama hakkım yok.Dialogue: 0,0:22:03.89,0:22:08.18,Main-207-,,0,0,0,,Onlarla beraber gülüp eğlenemeyeceğim!Dialogue: 0,0:22:17.65,0:22:19.03,Main-207-,,0,0,0,,Aptal mısın?Dialogue: 0,0:22:19.86,0:22:21.99,Main-207-,,0,0,0,,Ölü taklidi yapmaya devam etmeliydin.Dialogue: 0,0:22:22.78,0:22:25.49,Main-207-,,0,0,0,,Beyniniz bile gelişmemiş.Dialogue: 0,0:22:27.16,0:22:30.79,Main-207-,,0,0,0,,Benden bu kadar.Dialogue: 0,0:22:31.16,0:22:34.62,Main-207-,,0,0,0,,Elbette bu kadar! Hemen bittin!Dialogue: 0,0:22:35.13,0:22:36.33,Main-207-,,0,0,0,,Benden bu kadar!Dialogue: 0,0:22:36.88,0:22:38.34,Main-207-,,0,0,0,,Usopp Çekici!Dialogue: 0,0:22:40.05,0:22:42.30,Main-207-,,0,0,0,,Usopp'un Ölüm Lastiği!Dialogue: 0,0:22:46.85,0:22:49.35,Main-207-,,0,0,0,,Aah! Lanet olsun!Dialogue: 0,0:22:49.35,0:22:52.52,Main-207-,,0,0,0,,Aptalca numaraya kandım!Dialogue: 0,0:22:53.02,0:22:56.90,Main-207-,,0,0,0,,Şerefsiz herif!Dialogue: 0,0:22:59.32,0:23:01.90,Main-207-,,0,0,0,,Ölümcül Kurşun Yıldız!Dialogue: 0,0:23:00.07,0:23:01.15,Secondary-207-,,0,0,0,,Alkol mü?Dialogue: 0,0:23:04.82,0:23:09.08,Main-207-,,0,0,0,,Kendini beğenmiş saçmalıklarından bıktım artık, aşağılık varlık!Dialogue: 0,0:23:09.78,0:23:14.66,Main-207-,,0,0,0,,Nereye saklanırsan saklan, seni bu suyla uçuracağım!Dialogue: 0,0:23:18.00,0:23:20.80,Main-207-,,0,0,0,,Hakkımda söyledikleri umurumda değil.Dialogue: 0,0:23:20.80,0:23:25.51,Main-207-,,0,0,0,,Bir erkek olarak bu savaştan kaçamam.Dialogue: 0,0:23:26.26,0:23:28.47,Main-207-,,0,0,0,,Kaybedersem ölürüm.Dialogue: 0,0:23:28.47,0:23:30.97,Main-207-,,0,0,0,,Çoktan bir korsan oldum!Dialogue: 0,0:23:30.97,0:23:32.43,Main-207-,,0,0,0,,Su Topu!Dialogue: 0,0:23:41.40,0:23:44.61,Main-207-,,0,0,0,,Vaay! Ne güç ama!Dialogue: 0,0:23:45.36,0:23:49.32,Main-207-,,0,0,0,,Neden böyle bir aptalla savaşmak zorundayım?Dialogue: 0,0:23:49.70,0:23:52.08,Main-207-,,0,0,0,,Kendini tamamen açıkta bırakıyor!Dialogue: 0,0:23:53.08,0:23:54.79,Main-207-,,0,0,0,,Seni delik deşik edeceğim!Dialogue: 0,0:23:54.79,0:23:57.00,Main-207-,,0,0,0,,Makineli Su Tüfeği!Dialogue: 0,0:23:57.75,0:24:00.96,Main-207-,,0,0,0,,Aah! B-Burada olduğumu nasıl fark etti?!Dialogue: 0,0:24:00.96,0:24:05.59,Main-207-,,0,0,0,,Kahretsin! Kahretsin! Beni koruyun, Usopp Korsanları! Kaya!Dialogue: 0,0:24:05.59,0:24:08.05,Main-207-,,0,0,0,,Denize açıldım ve korsan oldum!Dialogue: 0,0:24:08.68,0:24:14.47,Main-207-,,0,0,0,,Savaşacağım! Denizin cesur savaşçısı olacağım! Artık yalan yok!Dialogue: 0,0:24:14.47,0:24:22.36,Main-207-,,0,0,0,,Kendimi kandırmayı ve korsan numarası yapmayı bırakıyorum!Dialogue: 0,0:24:23.36,0:24:24.99,Main-207-,,0,0,0,,Neden bahsediyorsun?Dialogue: 0,0:24:24.99,0:24:27.70,Main-207-,,0,0,0,,Bu dövüşten! Bilmiyorsan, alkol kolay yanar!Dialogue: 0,0:24:28.24,0:24:30.45,Main-207-,,0,0,0,,Ölümcül Alevli Yıldız!Dialogue: 0,0:24:35.16,0:24:39.12,Main-207-,,0,0,0,,Sıcak! Sıcak! Sıcak! Su! Su! Su! Su! Su! Su!Dialogue: 0,0:24:39.12,0:24:40.21,Main-207-,,0,0,0,,Sıcak! Sıcak! Sıcak!Dialogue: 0,0:24:40.21,0:24:40.71,Main-207-,,0,0,0,,Eyvah!Dialogue: 0,0:24:40.71,0:24:43.71,Main-207-,,0,0,0,,Su, su, su! Su!Dialogue: 0,0:24:44.75,0:24:48.17,Main-207-,,0,0,0,,Usopp Çekici!Dialogue: 0,0:25:09.45,0:25:10.16,Main-207-,,0,0,0,,Şerefsiz!Dialogue: 0,0:25:10.16,0:25:10.78,Main-207-,,0,0,0,,Ahh!Dialogue: 0,0:25:11.28,0:25:12.57,Main-207-,,0,0,0,,Usopp Çekici!Dialogue: 0,0:25:12.57,0:25:15.54,Main-207-,,0,0,0,,Usopp Çekici! Usopp Çekici! Usopp Çekici!Dialogue: 0,0:25:15.54,0:25:18.75,Main-207-,,0,0,0,,Usopp'un Ölüm Lastiği! Usopp Çekici! Usopp Çekici!Dialogue: 0,0:25:18.75,0:25:20.79,Main-207-,,0,0,0,,Usopp Çekici!Dialogue: 0,0:25:29.47,0:25:32.39,Thoughts-207-,,0,0,0,,Kazandım! Balıkadamı yendim!Dialogue: 0,0:25:38.48,0:25:40.85,Main-207-,,0,0,0,,İşte hakkettiğini buldun!Dialogue: 0,0:25:40.85,0:25:43.61,Main-207-,,0,0,0,,Eğer denersem ben de yapabilirim!Dialogue: 0,0:25:43.61,0:25:45.86,Main-207-,,0,0,0,,Gördünüz mü?!Dialogue: 0,0:25:45.86,0:25:49.11,Main-207-,,0,0,0,,Beni hafife almayın, şerefsizler!!!Dialogue: 0,0:01:50.05,0:01:53.01,Title-207-,,0,0,0,,Kahramanlık, Balıkadam Karatesine KarşıDialogue: 1,0:01:50.05,0:01:53.01,Title-207-,,0,0,0,,Kahramanlık, Balıkadam Karatesine KarşıDialogue: 0,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 1,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 0,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Gigglebot ZenefDialogue: 1,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Gigglebot ZenefDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,MüzikDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,MüzikDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,HaleeDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,HaleeDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,GrafikDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,GrafikDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,DatenshiDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,DatenshiDialogue: 0,0:00:06.78,0:00:10.78,Credits-207-,,0,0,0,,Kalite KontrolDialogue: 1,0:00:06.78,0:00:10.78,Credits-207-,,0,0,0,,Kalite KontrolDialogue: 0,0:00:06.78,0:00:10.78,Credits-207-,,0,0,0,,danpmss DolphinWeabu Feeso Galaxy 9000 Honoka Pepperjack ScolinesDialogue: 1,0:00:06.78,0:00:10.78,Credits-207-,,0,0,0,,danpmss DolphinWeabu Feeso Galaxy 9000 Honoka Pepperjack ScolinesDialogue: 0,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,KaraokeDialogue: 1,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,KaraokeDialogue: 0,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,KaitouYahikoDialogue: 1,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,KaitouYahikoDialogue: 0,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,ZamanlamaDialogue: 1,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,ZamanlamaDialogue: 0,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,PhosCity VillagerDialogue: 1,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,PhosCity VillagerDialogue: 0,0:00:13.28,0:00:16.79,Credits-207-,,0,0,0,,Altyazı Düzenleme [TR]Dialogue: 1,0:00:13.28,0:00:16.79,Credits-207-,,0,0,0,,Altyaz