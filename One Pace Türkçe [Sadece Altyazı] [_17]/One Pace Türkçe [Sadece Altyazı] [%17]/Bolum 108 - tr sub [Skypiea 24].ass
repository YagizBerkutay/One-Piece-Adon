&H00000000,0,0,0,0,100,100,0,0,1,1.5,0,8,10,10,30,1Style: Karaoke,Duality,65,&H009E375F,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,8,10,10,30,1Style: Translation,Duality,65,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,3,0,2,10,10,30,1Style: Luffy Monologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1Style: KaraokeED,Duality,70,&H00FFFFFF,&H000000FF,&H00DB7A3A,&H00000000,0,0,0,0,100,100,2,0,1,3,0,7,30,8,15,1Style: TranslationED,Duality,70,&H00FFFFFF,&H000000FF,&H00DB7A3A,&H00000000,0,0,0,0,100,100,2,0,1,3,0,1,30,100,15,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:50.05,0:02:00.04,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 50,0:01:58.93,0:02:02.73,Narrator-207-,,0,0,0,,Skypiea'nın 400 yılık savaşı sona erdi...Dialogue: 50,0:02:02.73,0:02:07.27,Narrator-207-,,0,0,0,,ve bütün her yeri saran kutlama gece boyunca devam etti.Dialogue: 50,0:02:08.78,0:02:12.11,Main-207-,,0,0,0,,A... A... Artık içemem...Dialogue: 50,0:02:17.03,0:02:18.70,Main-207-,,0,0,0,,İşte oradalar!Dialogue: 50,0:02:24.00,0:02:24.67,Main-207-,,0,0,0,,Hey!Dialogue: 50,0:02:27.25,0:02:28.54,Main-207-,,0,0,0,,Ne?Dialogue: 50,0:02:28.54,0:02:30.21,Main-207-,,0,0,0,,Nami, herkesi uyandır!Dialogue: 50,0:02:31.67,0:02:32.97,Main-207-,,0,0,0,,Niye?Dialogue: 50,0:02:34.93,0:02:36.64,Main-207-,,0,0,0,,Biraz altın çalıp kaçacağız!Dialogue: 50,0:02:39.14,0:02:40.47,Main-207-,,0,0,0,,Altın var mı?!Dialogue: 50,0:02:40.47,0:02:42.06,Main-207-,,0,0,0,,Aptal! Sessiz ol!Dialogue: 50,0:02:42.06,0:02:45.73,Main-207-,,0,0,0,,Aptal mı?! Benden daha gürültücüsün!Dialogue: 50,0:02:45.73,0:02:48.98,Main-207-,,0,0,0,,Ben mi? Asıl bağıra çağıra konuşan sensin!Dialogue: 50,0:02:48.98,0:02:54.03,Main-207-,,0,0,0,,Nasıl yani?! Ortalığı inlettiğin hâlde bana mı gürültücü diyorsun?!Dialogue: 50,0:02:54.59,0:02:58.07,Main-207-,,0,0,0,,Senin sesin tam anlamıyla kulakları sağır edecek cinsten!Dialogue: 50,0:02:58.07,0:03:02.29,Main-207-,,0,0,0,,Saçmalama! Yüksek sesle konuşmamın tek nedeni senin bağırman!Dialogue: 50,0:03:02.75,0:03:05.92,Main-207-,,0,0,0,,İlk bağıran sendin!Dialogue: 50,0:03:02.75,0:03:05.92,Main-207-,,0,0,0,,Kesin sesinizi! Uyuyamıyorum!Dialogue: 50,0:03:05.92,0:03:07.58,Main-207-,,0,0,0,,Ne?! Hâlâ bağırıyorsun!Dialogue: 50,0:03:07.58,0:03:09.17,Main-207-,,0,0,0,,Hayır! Sen bağırıyorsun!Dialogue: 50,0:03:09.17,0:03:13.59,Main-207-,,0,0,0,,Ben zarif bir hanımefendiyim! Ağzımı açıp bağıracak değilim ya!Dialogue: 50,0:03:13.59,0:03:16.80,Main-207-,,0,0,0,,Bak gördün mü?! Ağzın kocaman açık!Dialogue: 50,0:03:16.80,0:03:19.35,Main-207-,,0,0,0,,Beni kızdırdığın için!Dialogue: 50,0:03:19.35,0:03:22.22,Main-207-,,0,0,0,,Bağırmana gerek yok dedim ya!Dialogue: 50,0:03:17.64,0:03:19.80,Secondary-207-,,0,0,0,,Nami-san! Günaydın!Dialogue: 50,0:03:19.80,0:03:22.22,Secondary-207-,,0,0,0,,Ha? Daha sabah olmamış!Dialogue: 50,0:03:08.08,0:03:10.46,Main-207-,,0,0,0,,Usopp bana vurdu!Dialogue: 50,0:03:10.46,0:03:11.38,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:03:11.38,0:03:13.59,Main-207-,,0,0,0,,Bunu asla yapmam!Dialogue: 50,0:03:13.59,0:03:15.68,Main-207-,,0,0,0,,Beni bununla itham etme!Dialogue: 50,0:03:15.68,0:03:17.51,Main-207-,,0,0,0,,Ama bana vurdun!Dialogue: 50,0:03:17.51,0:03:19.10,Main-207-,,0,0,0,,Tam buraya, hissettim!Dialogue: 50,0:03:19.10,0:03:21.47,Main-207-,,0,0,0,,He he... Öyle sanmaya devam et, budala.Dialogue: 50,0:03:21.47,0:03:23.22,Main-207-,,0,0,0,,"Budala" mı?!Dialogue: 50,0:03:14.67,0:03:16.80,Secondary-207-,,0,0,0,,Hadi uyan artık, uykucu!Dialogue: 50,0:03:22.60,0:03:25.98,Main-207-,,0,0,0,,Mavi Denizliler parti yapmayı çok seviyor, değil mi?Dialogue: 50,0:03:25.98,0:03:28.10,Main-207-,,0,0,0,,Hiç yorulmamış gibiler.Dialogue: 50,0:03:28.10,0:03:30.44,Main-207-,,0,0,0,,Kesinlikle insan değiller.Dialogue: 50,0:03:37.45,0:03:38.99,Main-207-,,0,0,0,,Evet, plan bu!Dialogue: 50,0:03:38.99,0:03:42.45,Main-207-,,0,0,0,,Tamam, millet! Nadir bulunan bir yerdeyiz!Dialogue: 50,0:03:42.45,0:03:44.91,Main-207-,,0,0,0,,Arkanızda pişmanlık bırakmayın!Dialogue: 50,0:03:49.08,0:03:51.59,Main-207-,,0,0,0,,Şef! Altın çanı bulduk!Dialogue: 50,0:03:52.42,0:03:53.00,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:03:53.88,0:03:55.38,Main-207-,,0,0,0,,Hey, emin misin?!Dialogue: 50,0:03:55.38,0:03:59.34,Main-207-,,0,0,0,,Evet. Devrilen Dev Jack'e takılmış.Dialogue: 50,0:03:59.34,0:04:01.80,Main-207-,,0,0,0,,Şu anda herkes onu çekmeye çalışıyor!Dialogue: 50,0:04:02.64,0:04:04.93,Main-207-,,0,0,0,,İyi olan herkes batı kıyısına!Dialogue: 50,0:04:04.93,0:04:07.48,Main-207-,,0,0,0,,Çabuk! En kısa sürede!Dialogue: 50,0:04:07.48,0:04:10.15,Main-207-,,0,0,0,,Tamam! Herkesi toplayın!Dialogue: 50,0:04:10.86,0:04:12.27,Main-207-,,0,0,0,,Çanı bulduk!Dialogue: 50,0:04:12.27,0:04:13.32,Main-207-,,0,0,0,,Nerede?!Dialogue: 50,0:04:13.32,0:04:14.53,Main-207-,,0,0,0,,Batı kıyısında!Dialogue: 50,0:04:14.53,0:04:15.57,Main-207-,,0,0,0,,– Tamam! – Tamam!Dialogue: 50,0:04:15.57,0:04:16.28,Main-207-,,0,0,0,,Emin misin?!Dialogue: 50,0:04:16.28,0:04:18.07,Main-207-,,0,0,0,,Evet! Acele edin artık!Dialogue: 50,0:04:18.53,0:04:20.53,Main-207-,,0,0,0,,Belli ki denize düşmüş!Dialogue: 50,0:04:20.53,0:04:24.04,Main-207-,,0,0,0,,Evet. Hareket edebilen herkes batı kıyısında buluşsun!Dialogue: 50,0:04:27.00,0:04:28.96,Main-207-,,0,0,0,,Çanı buldular!Dialogue: 50,0:04:28.96,0:04:30.88,Main-207-,,0,0,0,,Batı kıyısında!Dialogue: 50,0:04:31.63,0:04:32.84,Thoughts-207-,,0,0,0,,Çan...?Dialogue: 50,0:04:34.63,0:04:36.13,Main-207-,,0,0,0,,Bir daha!Dialogue: 50,0:04:36.13,0:04:38.80,Main-207-,,0,0,0,,Bir, iki...!Dialogue: 50,0:04:40.01,0:04:42.60,Main-207-,,0,0,0,,Çekin!Dialogue: 50,0:05:00.53,0:05:03.70,Main-207-,,0,0,0,,Kahretsin! Yeterli insan gücümüz yok!Dialogue: 50,0:05:06.49,0:05:09.00,Main-207-,,0,0,0,,Atalarımızın onuru— Shandora'nın yadigârı.Dialogue: 50,0:05:09.00,0:05:10.33,Main-207-,,0,0,0,,Ne gerekiyorsa yapacağız!Dialogue: 50,0:05:10.96,0:05:12.08,Main-207-,,0,0,0,,Evet!Dialogue: 50,0:05:12.08,0:05:13.38,Main-207-,,0,0,0,,Tüm gücünüzle!Dialogue: 50,0:05:13.71,0:05:17.09,Main-207-,,0,0,0,,Bir daha! Bir, iki...!Dialogue: 50,0:05:43.03,0:05:45.95,Main-207-,,0,0,0,,Tüm gücünüzle çekin!Dialogue: 50,0:05:53.17,0:05:55.75,Main-207-,,0,0,0,,Lastik bant mı?! Buna lastik bant mı deniyor?!Dialogue: 50,0:05:55.75,0:05:56.71,Main-207-,,0,0,0,,Evet!Dialogue: 50,0:05:56.71,0:06:01.55,Main-207-,,0,0,0,,Usopp'un Ölümcül Lastik Bantları, Dev Jack'e hasarın yüzde 90'ını verdi!Dialogue: 50,0:06:01.55,0:06:03.72,Main-207-,,0,0,0,,– Vay! – Vay! İnanılmaz!Dialogue: 50,0:06:03.72,0:06:05.93,Main-207-,,0,0,0,,Dünyada sadece bende var!Dialogue: 50,0:06:05.93,0:06:07.81,Main-207-,,0,0,0,,– Vay! – Vay! Müthiş!Dialogue: 50,0:06:10.81,0:06:15.23,Main-207-,,0,0,0,,Ama bunu şimdilik bir kenara bırakalım. Sırada bu sac var!Dialogue: 50,0:06:15.98,0:06:20.07,Main-207-,,0,0,0,,Şimdi, bayanlar ve baylar! Bu sıradan bir sac değil!Dialogue: 50,0:06:20.07,0:06:26.45,Main-207-,,0,0,0,,Bu, Going Merry gemimizden alınan, Grand Line'ı ve Enel'in saldırılarını...Dialogue: 50,0:06:26.45,0:06:29.91,Main-207-,,0,0,0,,sağlam bir şekilde atlatmış bir sac! Bu "Sac'ların Kralı"!Dialogue: 50,0:06:30.37,0:06:32.41,Main-207-,,0,0,0,,Ne dersiniz?! Sac ister misiniz?Dialogue: 50,0:06:32.41,0:06:34.75,Main-207-,,0,0,0,,Birkaç "dial" ile takas edebilirim!Dialogue: 50,0:06:34.75,0:06:36.25,Main-207-,,0,0,0,,Hayır! Bu lastik bandı istiyorum!Dialogue: 50,0:06:36.25,0:06:38.38,Main-207-,,0,0,0,,Bununla takas edeceğiz!Dialogue: 50,0:06:38.38,0:06:40.05,Main-207-,,0,0,0,,Ben de istiyorum! Başka var mı?!Dialogue: 50,0:06:40.05,0:06:41.26,Main-207-,,0,0,0,,Ben de!Dialogue: 50,0:06:40.67,0:06:43.17,Thoughts-207-,,0,0,0,,Vay... Cidden mi?!Dialogue: 50,0:06:41.26,0:06:42.47,Main-207-,,0,0,0,,Bana da ver!Dialogue: 50,0:06:42.47,0:06:43.88,Main-207-,,0,0,0,,Bana da!Dialogue: 50,0:06:57.73,0:07:00.48,Main-207-,,0,0,0,,Deniz kabukları! Deniz kabuklarım var! Oh, evet!Dialogue: 50,0:07:00.48,0:07:05.66,Main-207-,,0,0,0,,Şanslı, şanslı! Çok şanslıyım!Dialogue: 50,0:07:01.07,0:07:02.90,Main-207-,,0,0,0,,Çok keyiflisin, Usopp.Dialogue: 50,0:07:04.28,0:07:05.66,Main-207-,,0,0,0,,Satışlar iyi miydi?Dialogue: 50,0:07:07.57,0:07:09.53,Main-207-,,0,0,0,,Bak, bak...Dialogue: 50,0:07:09.53,0:07:12.50,Main-207-,,0,0,0,,Bir sürü dial'ım var!Dialogue: 50,0:07:13.08,0:07:14.46,Main-207-,,0,0,0,,Sadece buraya bas ve...Dialogue: 50,0:07:15.08,0:07:16.00,Main-207-,,0,0,0,,olanları izle!Dialogue: 50,0:07:16.92,0:07:18.17,Main-207-,,0,0,0,,Aferin sana.Dialogue: 50,0:07:18.17,0:07:19.29,Main-207-,,0,0,0,,Aferin bana!Dialogue: 50,0:07:19.29,0:07:22.30,Main-207-,,0,0,0,,Bu kadar dial ile her türlü şey yapabilirim!Dialogue: 50,0:07:23.92,0:07:27.59,Main-207-,,0,0,0,,Usopp Fabrikası olanca hızıyla gelişecek!Dialogue: 50,0:07:28.64,0:07:32.93,Main-207-,,0,0,0,,Hey, Zoro! Ya kılıçlarını kavun aromalı kılıçlara dönüştürsem?Dialogue: 50,0:07:32.93,0:07:35.48,Main-207-,,0,0,0,,Antrenmanların eğlenceli hâle gelir!Dialogue: 50,0:07:35.48,0:07:36.23,Main-207-,,0,0,0,,Yok kalsın.Dialogue: 50,0:07:36.23,0:07:37.35,Main-207-,,0,0,0,,Oh...Dialogue: 50,0:07:37.35,0:07:41.69,Main-207-,,0,0,0,,Tabii ya! Nami'nin İklim Asası'nı geliştirebilirim!Dialogue: 50,0:07:41.69,0:07:44.65,Main-207-,,0,0,0,,Ve sapanım her zamankinden daha güçlü olacak!Dialogue: 50,0:07:48.74,0:07:51.24,Main-207-,,0,0,0,,Sahi, Robin, Luffy ve diğerleri nerede?Dialogue: 50,0:07:51.91,0:07:55.91,Main-207-,,0,0,0,,Luffy ve diğerleri hâlâ içeride. Robin de bir yere gitti.Dialogue: 50,0:08:01.04,0:08:04.96,Main-207-,,0,0,0,,Şey... O yılan deliksiz uyuyor.Dialogue: 50,0:08:04.96,0:08:07.43,Main-207-,,0,0,0,,Bir kaç gün durmadan dans etti.Dialogue: 50,0:08:07.43,0:08:10.05,Main-207-,,0,0,0,,Acaba neden o kadar mutluydu.Dialogue: 50,0:08:10.05,0:08:12.01,Main-207-,,0,0,0,,Her hâlükârda, hemen çıkmazlarsa...Dialogue: 50,0:08:12.01,0:08:14.31,Main-207-,,0,0,0,,yılan uyanacak ve işler kötüleşecek.Dialogue: 50,0:08:14.31,0:08:15.31,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:08:15.31,0:08:17.27,Main-207-,,0,0,0,,O uysal yılan mı?Dialogue: 50,0:08:17.73,0:08:21.23,Main-207-,,0,0,0,,Sersem. Bu şeyin kızgın hâlini görmedin!Dialogue: 50,0:08:21.23,0:08:22.98,Main-207-,,0,0,0,,O uysal yılan mı?Dialogue: 50,0:08:22.98,0:08:28.40,Main-207-,,0,0,0,,Dediğim gibi, onu kızgınken görmediğin için öyle diyorsun!Dialogue: 50,0:08:28.40,0:08:30.45,Main-207-,,0,0,0,,O uysal yılan mı?Dialogue: 50,0:08:30.45,0:08:33.03,Main-207-,,0,0,0,,Hey, dinliyor musun, Usopp?!Dialogue: 50,0:08:33.66,0:08:35.75,Main-207-,,0,0,0,,O uysal yılan mı?Dialogue: 50,0:08:35.75,0:08:37.08,Main-207-,,0,0,0,,Tone dial'dı!Dialogue: 50,0:08:37.08,0:08:39.46,Main-207-,,0,0,0,,Aptalca şakaları kes artık!Dialogue: 50,0:08:40.04,0:08:44.38,Main-207-,,0,0,0,,Evet, aptalcaydı! Aptalca!Dialogue: 50,0:08:44.38,0:08:47.55,Main-207-,,0,0,0,,Bu da ne?! Bu yılan ne yiyormuş böyle?Dialogue: 50,0:08:47.55,0:08:49.01,Main-207-,,0,0,0,,Hâlâ bulamadın mı, Luffy?Dialogue: 50,0:08:49.01,0:08:50.76,Main-207-,,0,0,0,,Bakın! İşte burada!Dialogue: 50,0:08:50.76,0:08:52.55,Main-207-,,0,0,0,,Vay! Müthiş!Dialogue: 50,0:08:52.55,0:08:54.56,Main-207-,,0,0,0,,Sahiden gerçekmiş!Dialogue: 50,0:08:54.56,0:08:57.81,Main-207-,,0,0,0,,Çok güzel! Maymunların evinde gördüklerimizin aynısı!Dialogue: 50,0:08:59.56,0:09:01.81,Main-207-,,0,0,0,,Ya? Ya? Ya?!Dialogue: 50,0:09:01.81,0:09:02.90,Main-207-,,0,0,0,,Şunlara bakın!Dialogue: 50,0:09:03.61,0:09:06.15,Main-207-,,0,0,0,,Harika değil mi?!Dialogue: 50,0:09:14.74,0:09:16.24,Main-207-,,0,0,0,,Demek bu altın...Dialogue: 50,0:09:18.00,0:09:19.62,Main-207-,,0,0,0,,– Ne kadar güzel... – İnanılmaz...Dialogue: 50,0:09:19.62,0:09:22.17,Main-207-,,0,0,0,,– Böyle bir şey beklemiyordum... – Ne kadar muhteşem.Dialogue: 50,0:09:22.75,0:09:25.96,Main-207-,,0,0,0,,Ama yan sütunlardan biri kırık.Dialogue: 50,0:09:25.96,0:09:28.05,Main-207-,,0,0,0,,Evet ama yapacak bir şey yok.Dialogue: 50,0:09:28.05,0:09:30.88,Main-207-,,0,0,0,,Hey! Şuna bakın.Dialogue: 50,0:09:31.43,0:09:34.05,Main-207-,,0,0,0,,O... poneglif...Dialogue: 50,0:09:35.01,0:09:39.35,Main-207-,,0,0,0,,Atalarımızın korumak için canını verdiği taş!Dialogue: 50,0:09:40.77,0:09:43.90,Main-207-,,0,0,0,,Peki ne yazıyor, Şef?Dialogue: 50,0:09:45.23,0:09:47.86,Main-207-,,0,0,0,,Bilmesek de olur...Dialogue: 50,0:09:51.28,0:09:52.45,Main-207-,,0,0,0,,Biz sadece...Dialogue: 50,0:09:52.45,0:09:55.03,Main-207-,,0,0,0,,"Gerçeği içinde sakla, ağzını sıkı tut.Dialogue: 50,0:09:56.58,0:09:59.62,Main-207-,,0,0,0,,Bizler, büyük çanın yankılarıyla...Dialogue: 50,0:09:59.62,0:10:01.71,Main-207-,,0,0,0,,tarihi dokuyanlarız..."Dialogue: 50,0:10:03.67,0:10:06.38,Main-207-,,0,0,0,,O sözleri nereden biliyorsun?Dialogue: 50,0:10:06.38,0:10:09.38,Main-207-,,0,0,0,,Shandia kalıntılarına işlenmişlerdi.Dialogue: 50,0:10:09.38,0:10:13.01,Main-207-,,0,0,0,,Yani nesiller boyu bunu koruyanlar sizmişsiniz.Dialogue: 50,0:10:19.60,0:10:23.77,Main-207-,,0,0,0,,Yani... Bu sembolleri okuyabiliyor musun?!Dialogue: 50,0:10:28.15,0:10:32.03,Main-207-,,0,0,0,,Bir tanrının adıyla anılan antik bir silah, Poseidon.Dialogue: 50,0:10:32.03,0:10:33.57,Main-207-,,0,0,0,,Onun konumu hakkında...Dialogue: 50,0:10:33.57,0:10:34.86,Main-207-,,0,0,0,,Ne?! O da ne?!Dialogue: 50,0:10:34.86,0:10:35.49,Main-207-,,0,0,0,,"Antik" mi?!Dialogue: 50,0:10:35.49,0:10:37.28,Main-207-,,0,0,0,,Antik silah mı?Dialogue: 50,0:10:37.28,0:10:39.70,Main-207-,,0,0,0,,Niye öyle bir şey yazsın ki?!Dialogue: 50,0:10:39.70,0:10:41.04,Main-207-,,0,0,0,,Evet...Dialogue: 50,0:10:41.75,0:10:46.58,Thoughts-207-,,0,0,0,,Bir silah daha... Alabasta'daki Pluton'dan farklı.Dialogue: 50,0:10:47.29,0:10:49.21,Thoughts-207-,,0,0,0,,Dünyanın bir köşesinde...Dialogue: 50,0:10:49.21,0:10:52.59,Thoughts-207-,,0,0,0,,hâlâ böyle tehlikeli şeylerin uykuda olması...!Dialogue: 50,0:10:53.80,0:10:55.30,Main-207-,,0,0,0,,Tam bir hayal kırıklığı.Dialogue: 50,0:10:56.05,0:10:59.35,Thoughts-207-,,0,0,0,,Aradığım şey bu değildi.Dialogue: 50,0:10:59.35,0:11:00.81,Main-207-,,0,0,0,,Hey, sen!Dialogue: 50,0:11:00.81,0:11:03.77,Main-207-,,0,0,0,,Şu taraftakiler de aynı dilde yazılmamış mı?!Dialogue: 50,0:11:04.14,0:11:05.19,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:11:08.86,0:11:12.11,Main-207-,,0,0,0,,"Gol D. Roger"...!Dialogue: 50,0:11:13.74,0:11:15.03,Main-207-,,0,0,0,,Bu ne?!Dialogue: 50,0:11:16.61,0:11:19.45,Flashbacks-207-,,0,0,0,,Buraya kadar başardım.Dialogue: 50,0:11:19.45,0:11:22.66,Flashbacks-207-,,0,0,0,,Bu sözleri dünyanın öbür ucuna götüreceğim.Dialogue: 50,0:11:22.66,0:11:25.41,Flashbacks-207-,,0,0,0,,Korsan Gol D. Roger.Dialogue: 50,0:11:27.63,0:11:28.67,Main-207-,,0,0,0,,Korsanlar Kralı...!Dialogue: 50,0:11:29.38,0:11:33.59,Main-207-,,0,0,0,,Bu, gökyüzü adasına geldiği anlamına mı geliyor?!Dialogue: 50,0:11:34.05,0:11:39.09,Main-207-,,0,0,0,,Hayır, en önemlisi, nasıl bu dilde yazabilmiş?Dialogue: 50,0:11:41.85,0:11:43.97,Main-207-,,0,0,0,,"Roger" mı yazıyor?Dialogue: 50,0:11:44.52,0:11:45.73,Main-207-,,0,0,0,,Tanıyor musun?!Dialogue: 50,0:11:45.73,0:11:51.02,Main-207-,,0,0,0,,Yirmi yılı aşkın bir süre önce, Mavi Deniz'den buraya gelen bir korsandı.Dialogue: 50,0:11:51.61,0:11:53.78,Main-207-,,0,0,0,,Oraya onun ismi mi kazınmış?Dialogue: 50,0:11:53.78,0:11:54.40,Main-207-,,0,0,0,,Evet.Dialogue: 50,0:11:55.15,0:11:59.07,Main-207-,,0,0,0,,Bu çana nasıl ulaşmış, bilmiyorum...Dialogue: 50,0:11:59.99,0:12:02.91,Main-207-,,0,0,0,,ama bu, onun yaptığının kesin kanıtı.Dialogue: 50,0:12:03.45,0:12:08.00,Main-207-,,0,0,0,,Düşündüm de, iki çeşit poneglif taşı var.Dialogue: 50,0:12:08.92,0:12:13.50,Main-207-,,0,0,0,,Bazıları bilgi içeriyor, bazıları konum gösteriyor.Dialogue: 50,0:12:13.50,0:12:16.38,Main-207-,,0,0,0,,Bu, bilgi içerenlerden.Dialogue: 50,0:12:22.97,0:12:25.35,Thoughts-207-,,0,0,0,,"Buraya kadar başardım."Dialogue: 50,0:12:25.98,0:12:28.48,Thoughts-207-,,0,0,0,,"Bu metni dünyanın öbür ucuna götüreceğim."Dialogue: 50,0:12:30.35,0:12:31.94,Thoughts-207-,,0,0,0,,Bu metni götüreceğim...Dialogue: 50,0:12:33.52,0:12:34.78,Thoughts-207-,,0,0,0,,Götüreceğim...Dialogue: 50,0:12:39.32,0:12:40.49,Main-207-,,0,0,0,,Yoksa...Dialogue: 50,0:12:40.49,0:12:42.45,Main-207-,,0,0,0,,Rio Poneglifi'nden mi bahsediyor?!Dialogue: 50,0:12:40.49,0:12:42.45,Note-207-,,0,0,0,,Rio Poneglifi: Gerçek tarihi metin.Dialogue: 50,0:12:48.08,0:12:48.91,Main-207-,,0,0,0,,Şef...Dialogue: 50,0:12:49.67,0:12:53.67,Main-207-,,0,0,0,,Bu poneglif, çoktan amacına hizmet etmiş.Dialogue: 50,0:12:53.67,0:12:55.05,Main-207-,,0,0,0,,Amaç mı?!Dialogue: 50,0:12:56.84,0:12:57.72,Main-207-,,0,0,0,,Evet.Dialogue: 50,0:12:57.72,0:13:02.26,Main-207-,,0,0,0,,Dünyanın dört bir yanına dağılmış olan bilgi ponegliflerini birleştirerek,Dialogue: 50,0:13:02.26,0:13:08.39,Main-207-,,0,0,0,,Kayıp Yüzyıl'ı dolduracak tek bir metne ulaşılabileceğine inanıyorum.Dialogue: 50,0:13:09.98,0:13:14.23,Main-207-,,0,0,0,,Kısaca, tüm metnin birleştirilmesi,Dialogue: 50,0:13:14.23,0:13:19.07,Main-207-,,0,0,0,,henüz var olmayan Rio Poneglifi'ni ortaya çıkaracak.Dialogue: 50,0:13:20.36,0:13:22.53,Main-207-,,0,0,0,,Korsanlar Kralı, Gol D. Roger'ın...Dialogue: 50,0:13:23.16,0:13:26.95,Main-207-,,0,0,0,,bu metni hedefine ulaştırdığından eminim.Dialogue: 50,0:13:33.63,0:13:34.50,Main-207-,,0,0,0,,Artık...Dialogue: 50,0:13:34.50,0:13:35.50,Main-207-,,0,0,0,,O zaman...Dialogue: 50,0:13:35.50,0:13:36.30,Main-207-,,0,0,0,,Hm?Dialogue: 50,0:13:38.09,0:13:43.47,Main-207-,,0,0,0,,Biz... artık... savaşmak zorunda değil miyiz?Dialogue: 50,0:13:46.10,0:13:50.89,Main-207-,,0,0,0,,Anlıyorum... Atalarımızın dileği gerçekleşmiş mi?Dialogue: 50,0:13:52.02,0:13:53.06,Main-207-,,0,0,0,,– Şef! – Şef!Dialogue: 50,0:13:53.06,0:13:54.61,Main-207-,,0,0,0,,İyi misiniz?!Dialogue: 50,0:13:54.61,0:13:59.36,Main-207-,,0,0,0,,Şükürler, şükürler olsun... Görevimiz tamamlandı!Dialogue: 50,0:14:01.03,0:14:02.24,Main-207-,,0,0,0,,Evet.Dialogue: 50,0:14:03.11,0:14:04.95,Thoughts-207-,,0,0,0,,Yani ben de,Dialogue: 50,0:14:04.95,0:14:09.50,Thoughts-207-,,0,0,0,,şimdiye kadar okuduğum ponegliflerdeki metinleri...Dialogue: 50,0:14:10.66,0:14:14.00,Thoughts-207-,,0,0,0,,Grand Line'ın sonundaki Laugh Tale'e götürmeliyim!Dialogue: 50,0:14:16.25,0:14:24.05,Main-207-,,0,0,0,,Genç hanım, o hasır şapkalı çocuk, bana Roger'ı andıran bir his veriyor.Dialogue: 50,0:14:25.05,0:14:27.22,Main-207-,,0,0,0,,Ama belki de sadece hayal gücümdür.Dialogue: 50,0:14:27.68,0:14:30.06,Main-207-,,0,0,0,,Adı Monkey D. Luffy.Dialogue: 50,0:14:30.06,0:14:32.06,Main-207-,,0,0,0,,İlgimi her zaman canlı tutuyor.Dialogue: 50,0:14:32.52,0:14:36.61,Main-207-,,0,0,0,,D mi? Anlıyorum. İsimlerinde aynı harfi paylaşıyorlar.Dialogue: 50,0:14:39.44,0:14:44.07,Main-207-,,0,0,0,,Evet... ve eminim ki tarihimiz için oldukça önemli olacak.Dialogue: 50,0:14:45.66,0:14:46.62,Main-207-,,0,0,0,,Affedersiniz...Dialogue: 50,0:14:47.53,0:14:50.37,Main-207-,,0,0,0,,Altın istiyordunuz, değil mi?Dialogue: 50,0:14:50.37,0:14:53.83,Main-207-,,0,0,0,,Mavi Deniz'deki vearth'den daha değerliydi demiştiniz.Dialogue: 50,0:14:53.83,0:14:54.71,Main-207-,,0,0,0,,Öyle.Dialogue: 50,0:14:54.71,0:14:57.75,Main-207-,,0,0,0,,Size çanı veremeyiz ama...Dialogue: 50,0:14:57.75,0:14:59.29,Main-207-,,0,0,0,,çan sütununa ne dersiniz?Dialogue: 50,0:14:59.29,0:15:01.05,Main-207-,,0,0,0,,Bu harika bir fikir!Dialogue: 50,0:15:01.05,0:15:05.05,Main-207-,,0,0,0,,Sonuçta, sizlere bir şekilde teşekkür etmemiz gerekiyor.Dialogue: 50,0:15:05.05,0:15:05.97,Main-207-,,0,0,0,,Doğru!Dialogue: 50,0:15:05.97,0:15:06.93,Main-207-,,0,0,0,,Israr ediyoruz!Dialogue: 50,0:15:06.93,0:15:09.89,Main-207-,,0,0,0,,Emin misiniz?! Bunu duyunca çok sevinecekler!Dialogue: 50,0:15:10.31,0:15:11.60,Main-207-,,0,0,0,,Evet!Dialogue: 50,0:15:12.98,0:15:17.15,Main-207-,,0,0,0,,Hadi o zaman! Bunu Mavi Deniz insanlarına götürelim!Dialogue: 50,0:15:17.15,0:15:19.40,Main-207-,,0,0,0,,Yan taraflarına geçin! Taşıması zor olacak!Dialogue: 50,0:15:19.40,0:15:21.78,Main-207-,,0,0,0,,Ülkemizin kurtarıcılarına vereceğiz!Dialogue: 50,0:15:21.78,0:15:23.65,Main-207-,,0,0,0,,Ama bu çok büyük.Dialogue: 50,0:15:30.78,0:15:35.29,Main-207-,,0,0,0,,Robin ne yapıyor? Gecikti.Dialogue: 50,0:15:35.87,0:15:37.46,Main-207-,,0,0,0,,Eyvah, acıkıyorum!Dialogue: 50,0:15:39.38,0:15:43.26,Main-207-,,0,0,0,,Ortalıkta kimse kalmamış. Neler oluyor?Dialogue: 50,0:15:43.67,0:15:47.22,Main-207-,,0,0,0,,Gerillalar ve melekler nereye gitti?Dialogue: 50,0:15:47.22,0:15:51.89,Main-207-,,0,0,0,,Burada olmamaları daha iyi. Öğrenirlerse bizi kovalarlar!Dialogue: 50,0:15:51.89,0:15:56.27,Main-207-,,0,0,0,,Sonuçta altın çalıp kaçıyoruz.Dialogue: 50,0:15:56.27,0:15:57.90,Main-207-,,0,0,0,,Buna izin vermeyecekler!Dialogue: 50,0:15:57.90,0:16:01.69,Main-207-,,0,0,0,,Nami ve Conis gemiyi hazırlıyor, biz de vakit kaybetmemeliyiz.Dialogue: 50,0:16:01.69,0:16:04.28,Main-207-,,0,0,0,,Bu arada Sanji, yiyecek bir şeyin var mı?Dialogue: 50,0:16:04.28,0:16:05.49,Main-207-,,0,0,0,,Evet, gemide var.Dialogue: 50,0:16:06.28,0:16:09.20,Main-207-,,0,0,0,,Ama bir şeyler atıştırmak lazım, değil mi?Dialogue: 50,0:16:09.20,0:16:10.53,Main-207-,,0,0,0,,Versene!Dialogue: 50,0:16:10.53,0:16:12.87,Main-207-,,0,0,0,,Yok dedim ya, beni rahat bırak!Dialogue: 50,0:16:09.20,0:16:10.53,Main-207-,,0,0,0,,Can sıkıcı!Dialogue: 50,0:16:10.53,0:16:12.87,Main-207-,,0,0,0,,Niye o kadını beklemek zorundayız?Dialogue: 50,0:16:12.87,0:16:14.87,Main-207-,,0,0,0,,Ben önden gemiye gidiyorum.Dialogue: 50,0:16:14.87,0:16:16.25,Main-207-,,0,0,0,,Aptal, sakın yapma!Dialogue: 50,0:16:16.25,0:16:17.00,Main-207-,,0,0,0,,Aptal!Dialogue: 50,0:16:17.00,0:16:18.08,Main-207-,,0,0,0,,Aptal, Yosun Kafa!Dialogue: 50,0:16:18.08,0:16:19.29,Main-207-,,0,0,0,,Yosun Kafalı aptal!Dialogue: 50,0:16:20.63,0:16:24.76,Main-207-,,0,0,0,,O ormanda tek başına üç adım bile atamazsın, kaybolursun!Dialogue: 50,0:16:28.43,0:16:29.72,Main-207-,,0,0,0,,Hey, bakın! Robin!Dialogue: 50,0:16:31.51,0:16:33.60,Main-207-,,0,0,0,,Robin-chan!Dialogue: 50,0:16:34.26,0:16:36.85,Main-207-,,0,0,0,,Hey, Robin!Dialogue: 50,0:16:36.85,0:16:40.60,Main-207-,,0,0,0,,Çabuk, çabuk! Kaçıyoruz! Bir sürü altın çaldık!Dialogue: 50,0:16:40.60,0:16:42.11,Main-207-,,0,0,0,,Kes sesini, sersem!Dialogue: 50,0:16:42.11,0:16:43.52,Main-207-,,0,0,0,,Arkasına bak!Dialogue: 50,0:16:43.94,0:16:46.44,Main-207-,,0,0,0,,Hep birlikte geliyorlar!Dialogue: 50,0:16:47.57,0:16:48.90,Main-207-,,0,0,0,,Koca bir ordu!Dialogue: 50,0:16:51.74,0:16:56.58,Main-207-,,0,0,0,,Eyvah! Eyvah! Başımız büyük dertte!Dialogue: 50,0:16:56.58,0:16:58.71,Main-207-,,0,0,0,,O da ne? Dev bir top mu?!Dialogue: 50,0:16:59.41,0:17:00.17,Main-207-,,0,0,0,,Kesin öyle!Dialogue: 50,0:17:00.58,0:17:03.34,Main-207-,,0,0,0,,Demek topluca geliyorlar!Dialogue: 50,0:17:03.79,0:17:05.55,Main-207-,,0,0,0,,Gemiye koşun!Dialogue: 50,0:17:05.88,0:17:08.47,Main-207-,,0,0,0,,Daha fazla kalamayız!Dialogue: 50,0:17:09.72,0:17:11.64,Main-207-,,0,0,0,,Şuna bak! İyi bir vurgun yaptık!Dialogue: 50,0:17:11.64,0:17:13.97,Main-207-,,0,0,0,,Çantalarımız dolu! Zenginiz!Dialogue: 50,0:17:13.97,0:17:17.39,Main-207-,,0,0,0,,Ne? Hepsi çantalarını toplamış!Dialogue: 50,0:17:17.39,0:17:20.44,Main-207-,,0,0,0,,Yoksa hemen gidiyorlar mı?!Dialogue: 50,0:17:20.44,0:17:22.85,Main-207-,,0,0,0,,Hey, durun! Durun!Dialogue: 50,0:17:23.19,0:17:25.07,Main-207-,,0,0,0,,Gördünüz mü?! Fark ettiler!Dialogue: 50,0:17:22.85,0:17:26.48,Secondary-207-,,0,0,0,,Hey! Durun! Bekleyin, size diyorum!Dialogue: 50,0:17:25.07,0:17:26.48,Main-207-,,0,0,0,,Kaçın!Dialogue: 50,0:17:27.73,0:17:30.28,Main-207-,,0,0,0,,Poz kesip durumu kurtarma zamanı!Dialogue: 50,0:17:31.66,0:17:34.70,Main-207-,,0,0,0,,İstediğiniz kadar durmamızı söyleyin!Dialogue: 50,0:17:34.70,0:17:36.79,Main-207-,,0,0,0,,Evet! Konuş be, Usopp!Dialogue: 50,0:17:38.29,0:17:41.29,Main-207-,,0,0,0,,Canımızı ortaya koyarak geldik bu gökyüzü adasına!Dialogue: 50,0:17:40.79,0:17:42.50,Secondary-207-,,0,0,0,,İyi dedin!Dialogue: 50,0:17:41.29,0:17:44.04,Main-207-,,0,0,0,,Ve efsanevi Altın Şehir'i bulduk!Dialogue: 50,0:17:43.04,0:17:46.09,Secondary-207-,,0,0,0,,Robin! Çabuk! Bizi yakalayacaklar!Dialogue: 50,0:17:44.04,0:17:49.13,Main-207-,,0,0,0,,Onurlu korsanlar olarak ellerimiz boş dönmemizi mi bekliyorsunuz?!Dialogue: 50,0:17:49.59,0:17:51.97,Main-207-,,0,0,0,,Ne?! Yakalamak mı?! Neden bahsediyor bu?Dialogue: 50,0:17:52.34,0:17:54.47,Main-207-,,0,0,0,,Sadece teşekkür etmek istiyoruz!Dialogue: 50,0:17:54.47,0:17:58.43,Main-207-,,0,0,0,,Hey hanımefendi, altını almayacak mısınız?Dialogue: 50,0:18:01.89,0:18:02.85,Main-207-,,0,0,0,,İstemiyorlar!Dialogue: 50,0:18:02.85,0:18:04.73,Main-207-,,0,0,0,,– Ne?! – Ne?!Dialogue: 50,0:18:04.73,0:18:06.15,Main-207-,,0,0,0,,Olamaz!Dialogue: 50,0:18:09.65,0:18:11.95,Main-207-,,0,0,0,,Kaçın!Dialogue: 50,0:18:10.53,0:18:14.07,Secondary-207-,,0,0,0,,– Hey! Bekleyin! – Hey! Bekleyin!Dialogue: 50,0:18:14.07,0:18:17.49,Main-207-,,0,0,0,,Hepsi peşimizde! Çok korkunç!Dialogue: 50,0:18:18.29,0:18:20.45,Main-207-,,0,0,0,,Nasıldı?! Havalı mıydım?!Dialogue: 50,0:18:20.45,0:18:22.87,Main-207-,,0,0,0,,Evet! İyi işti!Dialogue: 50,0:18:23.62,0:18:26.29,Main-207-,,0,0,0,,Robin-chwan! Acele et!Dialogue: 50,0:18:26.63,0:18:29.76,Secondary-207-,,0,0,0,,– Hey! Geri dönün! – Hey! Geri dönün!Dialogue: 50,0:18:29.76,0:18:31.42,Main-207-,,0,0,0,,Millet!Dialogue: 50,0:18:31.42,0:18:35.34,Main-207-,,0,0,0,,Gökyüzünün sonuna kadar durmayın!Dialogue: 50,0:18:35.34,0:18:39.10,Main-207-,,0,0,0,,– Tamam! – Tamam!Dialogue: 0,0:01:50.09,0:01:55.51,Title-207-,,0,0,0,,Buraya Kadar BaşardımDialogue: 1,0:01:50.09,0:01:55.51,Title-207-,,0,0,0,,Buraya Kadar BaşardımDialogue: 0,0:00:46.23,0:00:50.41,Credits