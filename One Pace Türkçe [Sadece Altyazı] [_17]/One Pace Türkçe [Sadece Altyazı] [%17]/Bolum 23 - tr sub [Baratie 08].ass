00,0,0,0,0,100,100,3,0,1,2.95,0,8,23,23,23,1Style: Lyrics-furigana,Duality,36,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,2.95,0,2,23,23,34,1Style: Lyrics,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,2,23,23,34,1Style: Karaoke,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,23,1Style: Kanji,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,146,1Style: Roger-Monologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1Style: Romaji ED,Josefin Sans,82,&H00FFFFFF,&H003592BE,&H00000000,&H64000000,0,0,0,0,100,100,0,0,1,0,4,8,10,10,20,1Style: Translation ED,Josefin Sans,82,&H00FFFFFF,&H000000FF,&H00FFFFFF,&H64000000,0,0,0,0,100,100,0,0,1,0,4,2,10,10,20,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:50.01,0:02:00.01,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 50,0:02:04.56,0:02:07.11,Main-207-,,0,0,0,,Şapkam! Hasır şapkam!Dialogue: 50,0:02:07.11,0:02:08.73,Main-207-,,0,0,0,,İşte şurada.Dialogue: 50,0:02:08.73,0:02:10.40,Main-207-,,0,0,0,,Ha? Ah, evet. Burada.Dialogue: 50,0:02:10.40,0:02:11.94,Main-207-,,0,0,0,,Kalk ve harekete geç.Dialogue: 50,0:02:12.57,0:02:14.32,Main-207-,,0,0,0,,Ha? O adamlara ne oldu?Dialogue: 50,0:02:14.70,0:02:15.87,Main-207-,,0,0,0,,Gittiler...Dialogue: 50,0:02:15.87,0:02:17.20,Main-207-,,0,0,0,,senin sayende.Dialogue: 50,0:02:17.20,0:02:18.33,Main-207-,,0,0,0,,Benim mi?Dialogue: 50,0:02:18.33,0:02:22.00,Main-207-,,0,0,0,,Gin, "Grand Line'da tekrar görüşelim." dedi.Dialogue: 50,0:02:23.75,0:02:24.83,Main-207-,,0,0,0,,Gin...Dialogue: 50,0:02:25.33,0:02:26.33,Main-207-,,0,0,0,,sana mı dedi?Dialogue: 50,0:02:26.33,0:02:27.84,Main-207-,,0,0,0,,Sana dedi!Dialogue: 50,0:02:30.67,0:02:33.59,Main-207-,,0,0,0,,Hazır lafı açılmışken, onları uzaklaştırdığıma göre,Dialogue: 50,0:02:33.59,0:02:35.68,Main-207-,,0,0,0,,bugün kamarotluğu bırakabilirim, değil mi?Dialogue: 50,0:02:35.68,0:02:36.80,Main-207-,,0,0,0,,Tebrikler.Dialogue: 50,0:02:37.14,0:02:38.51,Main-207-,,0,0,0,,Bu arada, sen...Dialogue: 50,0:02:38.51,0:02:40.26,Main-207-,,0,0,0,,Seninle gelmiyorum!Dialogue: 50,0:02:40.26,0:02:41.93,Main-207-,,0,0,0,,Korsan olmayacağım.Dialogue: 50,0:02:42.43,0:02:44.44,Main-207-,,0,0,0,,Burada aşçı olarak kalacağım,Dialogue: 50,0:02:44.44,0:02:47.61,Main-207-,,0,0,0,,o moruğa yeteneklerimi kabul ettirene kadar.Dialogue: 50,0:02:48.11,0:02:50.07,Main-207-,,0,0,0,,Anladım, pes ediyorum.Dialogue: 50,0:02:50.48,0:02:52.57,Main-207-,,0,0,0,,Elin hala pes etmedi!Dialogue: 50,0:02:56.49,0:03:01.45,Main-207-,,0,0,0,,Hepsi bu kadar güvenilmezken buradan ayrılamam.Dialogue: 50,0:03:01.45,0:03:04.54,Main-207-,,0,0,0,,Ama bir gün ayrılmayı umuyorum.Dialogue: 50,0:03:05.21,0:03:06.83,Main-207-,,0,0,0,,Grand Line'a.Dialogue: 50,0:03:09.54,0:03:11.30,Main-207-,,0,0,0,,O zaman hadi gidelim.Dialogue: 50,0:03:11.30,0:03:13.26,Main-207-,,0,0,0,,Daha zamanı değil.Dialogue: 50,0:03:15.88,0:03:17.22,Main-207-,,0,0,0,,Söylesene...Dialogue: 50,0:03:17.97,0:03:19.97,Main-207-,,0,0,0,,All Blue'yu biliyor musun?Dialogue: 50,0:03:19.97,0:03:21.10,Main-207-,,0,0,0,,Hayır.Dialogue: 50,0:03:21.10,0:03:23.35,Main-207-,,0,0,0,,Cidden hiç duymadın mı?!Dialogue: 50,0:03:23.35,0:03:24.85,Main-207-,,0,0,0,,Mucizevi bir deniz!Dialogue: 50,0:03:26.94,0:03:28.15,Main-207-,,0,0,0,,O denizde...Dialogue: 50,0:03:28.15,0:03:31.36,Main-207-,,0,0,0,,Doğu Mavi, Batı Mavi, Kuzey Mavi ve Güney Mavi...Dialogue: 50,0:03:31.36,0:03:34.40,Main-207-,,0,0,0,,Dünyanın dört bir yanından balıklar orada yüzer!Dialogue: 50,0:03:36.86,0:03:39.62,Main-207-,,0,0,0,,Biz aşçılar için, rüya gibi bir cennet!Dialogue: 50,0:03:39.99,0:03:43.20,Main-207-,,0,0,0,,İşte Grand Line böyle bir yer! Peki, şeyi duydun mu...?Dialogue: 50,0:03:47.79,0:03:50.67,Main-207-,,0,0,0,,Hâlâ o yerden bahsederken gözleri parlıyor.Dialogue: 50,0:03:52.04,0:03:53.67,Main-207-,,0,0,0,,Ne aptal ama!Dialogue: 50,0:03:59.30,0:04:01.89,Main-207-,,0,0,0,,Yemek zamanı, beyler!Dialogue: 50,0:04:02.31,0:04:03.85,Main-207-,,0,0,0,,Çok şükür...Dialogue: 50,0:04:03.85,0:04:05.35,Main-207-,,0,0,0,,Sonunda yiyebileceğiz!Dialogue: 50,0:04:05.35,0:04:07.10,Main-207-,,0,0,0,,Yemek! Yemek! Yemek!Dialogue: 50,0:04:13.02,0:04:15.57,Main-207-,,0,0,0,,Hey, biz nereye oturacağız?Dialogue: 50,0:04:15.57,0:04:16.49,Main-207-,,0,0,0,,Yemeğimiz nerede?Dialogue: 50,0:04:16.49,0:04:18.91,Main-207-,,0,0,0,,Tüm sandalyeler dolu.Dialogue: 50,0:04:19.57,0:04:21.12,Main-207-,,0,0,0,,Yerde yiyin.Dialogue: 50,0:04:21.12,0:04:22.62,Main-207-,,0,0,0,,Sandalye yok mu?Dialogue: 50,0:04:22.62,0:04:24.12,Main-207-,,0,0,0,,Bu nasıl olabilir?!Dialogue: 50,0:04:24.12,0:04:26.41,Main-207-,,0,0,0,,Burası bir restoran!Dialogue: 50,0:04:28.00,0:04:29.25,Main-207-,,0,0,0,,Peki, neyse...Dialogue: 50,0:04:29.25,0:04:31.58,Main-207-,,0,0,0,,Biraz garip davranıyorlar...Dialogue: 50,0:04:33.59,0:04:34.75,Main-207-,,0,0,0,,Klasik halleri...Dialogue: 50,0:04:36.59,0:04:39.72,Main-207-,,0,0,0,,Hey! Bu sabah çorbayı kim yaptı?!Dialogue: 50,0:04:40.30,0:04:42.47,Main-207-,,0,0,0,,Hey, ben yaptım! Lezzetli, değil mi?!Dialogue: 50,0:04:42.47,0:04:44.72,Main-207-,,0,0,0,,Bugün ekstra özen gösterdim!Dialogue: 50,0:04:45.22,0:04:47.31,Main-207-,,0,0,0,,Bu çorba rezalet, içilmez!Dialogue: 50,0:04:47.31,0:04:48.94,Main-207-,,0,0,0,,Bu resmen çamur!Dialogue: 50,0:04:56.19,0:05:01.57,Main-207-,,0,0,0,,Hey… İnsan yemeği damak tadına uymadı mı, seni lanet tanuki?Dialogue: 50,0:05:02.45,0:05:04.78,Main-207-,,0,0,0,,Bu kadar kötü yapmak da bir sanat.Dialogue: 50,0:05:04.78,0:05:06.49,Main-207-,,0,0,0,,Midemi bozuyor!Dialogue: 50,0:05:08.29,0:05:10.96,Main-207-,,0,0,0,,Üzgünüm ama bu çorbanın arkasında dururum.Dialogue: 50,0:05:10.96,0:05:13.75,Main-207-,,0,0,0,,Senin ağzının tadı bozuk!Dialogue: 50,0:05:18.55,0:05:20.51,Main-207-,,0,0,0,,Öğk! Bu berbat!Dialogue: 50,0:05:22.18,0:05:24.10,Main-207-,,0,0,0,,Bunu yiyemem!Dialogue: 50,0:05:25.72,0:05:26.56,Main-207-,,0,0,0,,Değil mi, beyler?!Dialogue: 50,0:05:27.77,0:05:29.18,Main-207-,,0,0,0,,Bu yenmez!Dialogue: 50,0:05:30.56,0:05:32.52,Main-207-,,0,0,0,,Bu çorba iğrenç!Dialogue: 50,0:05:32.52,0:05:34.06,Main-207-,,0,0,0,,Böyle bir çorbayı içemem!Dialogue: 50,0:05:34.06,0:05:36.52,Main-207-,,0,0,0,,Bu berbat! Biri bana su getirsin!Dialogue: 50,0:05:36.52,0:05:38.90,Main-207-,,0,0,0,,Kimi kandırmaya çalışıyorsunuz, şerefsizler?!Dialogue: 50,0:05:38.90,0:05:42.15,Main-207-,,0,0,0,,Yardımcı şef olarak yüz karasısın.Dialogue: 50,0:05:42.15,0:05:43.78,Main-207-,,0,0,0,,Bayatladın!Dialogue: 50,0:05:43.78,0:05:47.16,Main-207-,,0,0,0,,Her olayı şiddetle çözmenden de bıktık usandık!Dialogue: 50,0:05:47.16,0:05:49.87,Main-207-,,0,0,0,,Yemek kötüyse, kötü olduğunu söyleriz!Dialogue: 50,0:05:51.00,0:05:51.75,Main-207-,,0,0,0,,Ne dedin...?!Dialogue: 50,0:05:56.54,0:05:57.63,Main-207-,,0,0,0,,– Patron! – Patron!Dialogue: 50,0:05:57.63,0:05:59.05,Main-207-,,0,0,0,,Moruk...!Dialogue: 50,0:06:01.01,0:06:04.76,Main-207-,,0,0,0,,Bu iğrenç, berbat çorba da neyin nesi?Dialogue: 50,0:06:04.76,0:06:06.51,Main-207-,,0,0,0,,Bunu müşterilere sunarsak,Dialogue: 50,0:06:06.51,0:06:08.68,Main-207-,,0,0,0,,dükkanı kapatırız!Dialogue: 50,0:06:08.68,0:06:10.98,Main-207-,,0,0,0,,Kes şunu, moruk!Dialogue: 50,0:06:10.98,0:06:14.69,Main-207-,,0,0,0,,Çorbamın seninkinden farkı ne?! Söyle!Dialogue: 50,0:06:14.69,0:06:16.77,Main-207-,,0,0,0,,Kıyaslama mı yapıyorsun?!Dialogue: 50,0:06:19.65,0:06:21.44,Main-207-,,0,0,0,,Kendini bir şey sanma!Dialogue: 50,0:06:23.86,0:06:25.36,Main-207-,,0,0,0,,Patron onu yumrukladı...Dialogue: 50,0:06:25.36,0:06:26.99,Main-207-,,0,0,0,,Onu tekmelemek yerine mi?Dialogue: 50,0:06:26.99,0:06:31.62,Main-207-,,0,0,0,,Aşçılığı bana öğretmen için milyarlarca yıl geçmesi lazım, seni küçük patlıcan!Dialogue: 50,0:06:31.62,0:06:35.71,Main-207-,,0,0,0,,Dünya çapındaki denizlerde aşçılık yapmış biriyim ben.Dialogue: 50,0:06:40.05,0:06:41.13,Main-207-,,0,0,0,,Kahretsin!Dialogue: 50,0:06:51.64,0:06:55.02,Main-207-,,0,0,0,,Bu çorba oldukça lezzetli.Dialogue: 50,0:06:55.02,0:06:56.65,Main-207-,,0,0,0,,Bunu biliyoruz.Dialogue: 50,0:06:56.65,0:06:57.27,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:06:57.27,0:07:01.53,Main-207-,,0,0,0,,Sanji'nin aşçılık yetenekleri buradaki herkes tarafından biliniyor.Dialogue: 50,0:07:02.36,0:07:03.57,Main-207-,,0,0,0,,Hiç de kötü değil.Dialogue: 50,0:07:03.57,0:07:06.24,Main-207-,,0,0,0,,Evet, bu çorba iyi yapılmış.Dialogue: 50,0:07:06.24,0:07:07.99,Main-207-,,0,0,0,,Çok korkunçtu...Dialogue: 50,0:07:07.99,0:07:09.74,Main-207-,,0,0,0,,Cidden kafayı yedi.Dialogue: 50,0:07:09.74,0:07:10.99,Main-207-,,0,0,0,,Evet...Dialogue: 50,0:07:16.92,0:07:22.00,Secondary-207-,,0,0,0,,Ancak bu denli sert olursak o salak laf dinler.Dialogue: 50,0:07:24.22,0:07:25.68,Main-207-,,0,0,0,,Çocuk...Dialogue: 50,0:07:26.05,0:07:29.68,Main-207-,,0,0,0,,Gemine bir aşçı istediğini söylemiştin, değil mi?Dialogue: 50,0:07:29.68,0:07:33.35,Main-207-,,0,0,0,,Senden iyilik falan istemiyorum ama o küçük patlıcanı,Dialogue: 50,0:07:33.35,0:07:36.31,Main-207-,,0,0,0,,kendinle götürür müsün,...Dialogue: 50,0:07:36.85,0:07:38.73,Main-207-,,0,0,0,,Grand Line'a?Dialogue: 50,0:07:40.19,0:07:42.23,Main-207-,,0,0,0,,Grand Line...Dialogue: 50,0:07:42.23,0:07:44.24,Main-207-,,0,0,0,,onun hayali.Dialogue: 50,0:07:46.20,0:07:49.78,Main-207-,,0,0,0,,Patron bize tam bir oyun sergiletti.Dialogue: 50,0:07:49.78,0:07:54.04,Main-207-,,0,0,0,,Senin kötü oyunculuğun yüzünden fark edecek diye endişelendim.Dialogue: 50,0:07:55.16,0:07:57.25,Main-207-,,0,0,0,,Buradaki kötü oyuncu sendin.Dialogue: 50,0:07:57.25,0:07:58.75,Main-207-,,0,0,0,,Bir kase daha alacağım!Dialogue: 50,0:07:58.75,0:08:00.92,Main-207-,,0,0,0,,– Ben de! – Ben de!Dialogue: 50,0:08:15.93,0:08:19.65,Thoughts-207-,,0,0,0,,Her şeyi duyabiliyorum, sizi aptallar...Dialogue: 50,0:08:21.44,0:08:23.19,Main-207-,,0,0,0,,Ne dersin, çocuk?Dialogue: 50,0:08:23.65,0:08:24.61,Main-207-,,0,0,0,,Olmaz.Dialogue: 50,0:08:24.61,0:08:25.48,Main-207-,,0,0,0,,– Ne?! – Ne?!Dialogue: 50,0:08:26.69,0:08:30.20,Main-207-,,0,0,0,,Gemine bir aşçı istediğini sanıyordum.Dialogue: 50,0:08:31.28,0:08:34.87,Main-207-,,0,0,0,,Yoksa onun yeterince iyi olmadığını mı söylüyorsun?Dialogue: 50,0:08:35.62,0:08:39.87,Main-207-,,0,0,0,,Sorun onun yetersizliği değil. Benimle gelmesini çok istiyorum.Dialogue: 50,0:08:40.50,0:08:44.00,Main-207-,,0,0,0,,O burada bir aşçı olarak devam etmek istiyor.Dialogue: 50,0:08:44.00,0:08:47.51,Main-207-,,0,0,0,,Siz onu yanıma almamı isteseniz bile, yapamam.Dialogue: 50,0:08:48.13,0:08:52.89,Main-207-,,0,0,0,,Yani sana kendisi söylemedikçe kabul etmeyeceğini söylüyorsun, ha?Dialogue: 50,0:08:53.22,0:08:54.68,Main-207-,,0,0,0,,Aynen. Bir tabak daha!Dialogue: 50,0:08:54.68,0:08:57.31,Main-207-,,0,0,0,,Gayet makul.Dialogue: 50,0:08:57.85,0:08:59.69,Main-207-,,0,0,0,,Ama o arızalı velet, öyle kolayca gidiyorum der mi...?Dialogue: 50,0:08:59.69,0:09:02.98,Secondary-207-,,0,0,0,,Ama o arızalı velet, öyle kolayca gidiyorum der mi...?Dialogue: 50,0:09:02.98,0:09:06.94,Secondary-207-,,0,0,0,,Öyle inatçı bir aptal için boşuna bekleme.Dialogue: 50,0:09:06.94,0:09:08.15,Secondary-207-,,0,0,0,,Bir tabak daha!Dialogue: 50,0:09:36.81,0:09:37.60,Main-207-,,0,0,0,,Kahretsin...!Dialogue: 50,0:09:37.60,0:09:38.43,Main-207-,,0,0,0,,Sanji!Dialogue: 50,0:09:38.43,0:09:40.43,Main-207-,,0,0,0,,O da ne? Balıkadam mı?Dialogue: 50,0:09:40.43,0:09:43.19,Main-207-,,0,0,0,,Balıkadam Adası'ndan mutfağımızı denemeye mi gelmiş?Dialogue: 50,0:09:43.19,0:09:45.40,Main-207-,,0,0,0,,Salak! İnsan ve panda köpek balığı bunlar!Dialogue: 50,0:09:46.07,0:09:46.94,Main-207-,,0,0,0,,Ne oluyor?Dialogue: 50,0:09:46.94,0:09:48.90,Main-207-,,0,0,0,,Oh! Yosaku bu!Dialogue: 50,0:09:49.32,0:09:51.82,Main-207-,,0,0,0,,Ah, Luffy abi!Dialogue: 50,0:09:51.82,0:09:54.20,Main-207-,,0,0,0,,Neden yalnızsın? Diğerleri nerede?Dialogue: 50,0:09:54.20,0:09:55.28,Main-207-,,0,0,0,,Peki Nami?Dialogue: 50,0:10:02.58,0:10:04.96,Main-207-,,0,0,0,,Aslında ona yetişemedik...Dialogue: 50,0:10:04.96,0:10:09.46,Main-207-,,0,0,0,,ama Nami ablanın gidiş yönüne göre varış noktasını tahmin edebildik.Dialogue: 50,0:10:10.42,0:10:12.51,Main-207-,,0,0,0,,Onu geri alabiliriz o zaman.Dialogue: 50,0:10:13.09,0:10:14.64,Main-207-,,0,0,0,,Şey...Dialogue: 50,0:10:15.26,0:10:21.18,Main-207-,,0,0,0,,Doğru tahmin ettiysek, belanın tam ortasına gidiyor.Dialogue: 50,0:10:22.89,0:10:25.77,Main-207-,,0,0,0,,Her durumda, yardımına ihtiyacımız var, Luffy abi.Dialogue: 50,0:10:25.77,0:10:26.98,Main-207-,,0,0,0,,Lütfen benimle gel!Dialogue: 50,0:10:27.36,0:10:31.07,Main-207-,,0,0,0,,Pek anlamadım ama tamam. Hadi gidelim!Dialogue: 50,0:10:39.62,0:10:40.74,Main-207-,,0,0,0,,Bekle!Dialogue: 50,0:10:41.75,0:10:45.25,Main-207-,,0,0,0,,İkimizin de aptalca hayalleri var.Dialogue: 50,0:10:48.67,0:10:53.17,Main-207-,,0,0,0,,Hedefime, All Blue'ya ulaşmak için...Dialogue: 50,0:10:54.13,0:10:55.09,Main-207-,,0,0,0,,Sanji?Dialogue: 50,0:10:56.26,0:10:57.14,Main-207-,,0,0,0,,Evet.Dialogue: 50,0:10:57.14,0:11:00.60,Main-207-,,0,0,0,,Korsanlar Kralı olma yolculuğunda sana eşlik edeceğim!Dialogue: 50,0:11:00.60,0:11:01.43,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:11:02.89,0:11:06.02,Main-207-,,0,0,0,,Geminin aşçısı olacağım.Dialogue: 50,0:11:06.02,0:11:07.98,Main-207-,,0,0,0,,Olur mu?Dialogue: 50,0:11:08.65,0:11:09.94,Main-207-,,0,0,0,,Olur!Dialogue: 50,0:11:09.94,0:11:11.32,Main-207-,,0,0,0,,Yaşasın!Dialogue: 50,0:11:11.32,0:11:13.15,Main-207-,,0,0,0,,Hayırlı olsun, Luffy abi!Dialogue: 50,0:11:13.15,0:11:13.99,Main-207-,,0,0,0,,Evet!Dialogue: 50,0:11:13.99,0:11:15.40,Main-207-,,0,0,0,,– Oley! Oley! – Oley! Oley!Dialogue: 50,0:11:15.40,0:11:17.45,Main-207-,,0,0,0,,– Aşçımız oldu! Yemekleri enfes! – Aşçımız oldu! Yemekleri enfes!Dialogue: 50,0:11:18.07,0:11:19.95,Main-207-,,0,0,0,,İşte böyle millet.Dialogue: 50,0:11:18.07,0:11:19.95,Secondary-207-,,0,0,0,,Lezzetli yemek!Dialogue: 50,0:11:21.24,0:11:23.87,Main-207-,,0,0,0,,Başınıza dert olduğum için özür dilerim.Dialogue: 50,0:11:24.75,0:11:25.87,Main-207-,,0,0,0,,Beni kızdırıyorsun...Dialogue: 50,0:11:25.87,0:11:29.88,Main-207-,,0,0,0,,Seni buradan kendim kovmak istiyordum.Dialogue: 50,0:11:29.88,0:11:33.09,Main-207-,,0,0,0,,Ve bu kadar kolay mı karar verdin?Dialogue: 50,0:11:34.13,0:11:38.09,Main-207-,,0,0,0,,Sana o dandik oyunculuğunu sergilettirdiğim için affet.Dialogue: 50,0:11:38.09,0:11:39.85,Main-207-,,0,0,0,,Biliyor muydun?!Dialogue: 50,0:11:39.85,0:11:41.31,Main-207-,,0,0,0,,Her şeyi duydum...Dialogue: 50,0:11:41.31,0:11:42.56,Main-207-,,0,0,0,,Hepiniz aptalsınız.Dialogue: 50,0:11:42.56,0:11:43.77,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:11:44.14,0:11:49.10,Main-207-,,0,0,0,,Demek beni defetmek için her şeyi yaparsın, ha, moruk?!Dialogue: 50,0:11:49.69,0:11:54.94,Main-207-,,0,0,0,,Niye hep böyle saygısız bir pislik gibi konuşuyorsun?!Dialogue: 50,0:11:56.45,0:11:58.78,Main-207-,,0,0,0,,Aynen öyle, küçük patlıcan!Dialogue: 50,0:11:59.45,0:12:01.95,Main-207-,,0,0,0,,Her şeyden önce çocukları hiç sevmem!Dialogue: 50,0:12:01.95,0:12:07.21,Main-207-,,0,0,0,,İşe yaramaz veledin birini kurtardığım her gün için pişman oldum.Dialogue: 50,0:12:07.96,0:12:10.33,Main-207-,,0,0,0,,İşimi kolaylaştırdın, moruk!Dialogue: 50,0:12:10.33,0:12:13.17,Main-207-,,0,0,0,,Geri kalan hayatının sefasını sür.Dialogue: 50,0:12:14.42,0:12:16.80,Main-207-,,0,0,0,,Böyle güzel bir gemiyi kullanabilir miyiz?Dialogue: 50,0:12:16.80,0:12:19.01,Main-207-,,0,0,0,,Sanji'nin teknesi. Elbette.Dialogue: 50,0:12:19.51,0:12:21.85,Main-207-,,0,0,0,,Daha yetmedi mi sana?!Dialogue: 50,0:12:21.85,0:12:23.51,Main-207-,,0,0,0,,Hayır. Biraz daha et ver.Dialogue: 50,0:12:23.51,0:12:26.39,Main-207-,,0,0,0,,Kaç gün denizde kalacaksınız ki?Dialogue: 50,0:12:26.39,0:12:27.48,Main-207-,,0,0,0,,Bilmiyorum...Dialogue: 50,0:12:31.44,0:12:33.57,Flashbacks-207-,,0,0,0,,Oha!Dialogue: 50,0:12:33.57,0:12:37.15,Flashbacks-207-,,0,0,0,,Moruk, bu Deniz Restoranı mı?Dialogue: 50,0:12:57.88,0:13:00.43,Flashbacks-207-,,0,0,0,,Örneğin, Sanji...Dialogue: 50,0:13:01.18,0:13:02.43,Flashbacks-207-,,0,0,0,,Ne?Dialogue: 50,0:13:02.93,0:13:07.39,Flashbacks-207-,,0,0,0,,İster azılı suçlular olsun, ister firari mahkûmlar...Dialogue: 50,0:13:07.39,0:13:13.86,Flashbacks-207-,,0,0,0,,eğer bu zibidi herifler açlıktan geberip bu restorana düşerse,Dialogue: 50,0:13:14.90,0:13:18.36,Flashbacks-207-,,0,0,0,,bu bile bize devam etme motivasyonu vermeli,...Dialogue: 50,0:13:18.36,0:13:20.61,Flashbacks-207-,,0,0,0,,sence de öyle değil mi?Dialogue: 50,0:13:21.24,0:13:22.32,Flashbacks-207-,,0,0,0,,Evet!Dialogue: 50,0:13:23.37,0:13:25.74,Flashbacks-207-,,0,0,0,,Baya yoğun olacağız!Dialogue: 50,0:13:25.74,0:13:28.62,Flashbacks-207-,,0,0,0,,Sorun yok çünkü ben buradayım!Dialogue: 50,0:13:38.42,0:13:40.26,Flashbacks-207-,,0,0,0,,Ah...Dialogue: 50,0:13:41.55,0:13:42.68,Flashbacks-207-,,0,0,0,,Cidden...Dialogue: 50,0:13:44.97,0:13:46.68,Flashbacks-207-,,0,0,0,,Daha ince soy, küçük patlıcan!Dialogue: 50,0:13:47.56,0:13:49.68,Flashbacks-207-,,0,0,0,,Bu çok acıttı!Dialogue: 50,0:13:49.68,0:13:54.10,Flashbacks-207-,,0,0,0,,Biri ciddi bir şekilde yemek yapıyorsa, çeneni kapatıp izlemen gerekir!Dialogue: 50,0:13:54.10,0:13:57.07,Flashbacks-207-,,0,0,0,,Ne?! Kendini bir şey sanma, küçük patlıcan!Dialogue: 50,0:13:57.07,0:13:59.23,Flashbacks-207-,,0,0,0,,Ben küçük patlıcan değilim!Dialogue: 50,0:13:59.23,0:14:02.57,Flashbacks-207-,,0,0,0,,Seni bunak herif!Dialogue: 50,0:14:04.03,0:14:05.66,Flashbacks-207-,,0,0,0,,Bunu dene.Dialogue: 50,0:14:05.66,0:14:07.66,Flashbacks-207-,,0,0,0,,Sen mi yaptın?Dialogue: 50,0:14:08.24,0:14:09.16,Flashbacks-207-,,0,0,0,,Evet.Dialogue: 50,0:14:11.21,0:14:12.04,Flashbacks-207-,,0,0,0,,Nasıl olmuş?Dialogue: 50,0:14:12.41,0:14:13.58,Flashbacks-207-,,0,0,0,,İğrenç!Dialogue: 50,0:14:13.58,0:14:15.54,Flashbacks-207-,,0,0,0,,Bu yenmez, seni küçük patlıcan!Dialogue: 50,0:14:16.25,0:14:18.75,Flashbacks-207-,,0,0,0,,Seni pis moruk!Dialogue: 50,0:14:28.43,0:14:30.85,Main-207-,,0,0,0,,Aşçı abi geç kaldı.Dialogue: 50,0:14:30.85,0:14:31.68,Main-207-,,0,0,0,,Evet...Dialogue: 50,0:14:41.86,0:14:43.36,Main-207-,,0,0,0,,Bunun zamanı geldi!Dialogue: 50,0:14:43.36,0:14:44.82,Main-207-,,0,0,0,,Kendini hazırla, Sanji!Dialogue: 50,0:14:51.79,0:14:54.16,Main-207-,,0,0,0,,Sizin onu yenmenizin imkanı yok.Dialogue: 50,0:15:07.93,0:15:09.26,Main-207-,,0,0,0,,Gidelim.Dialogue: 50,0:15:09.26,0:15:11.14,Main-207-,,0,0,0,,Veda etmen gerekmiyor mu?Dialogue: 50,0:15:11.52,0:15:12.77,Main-207-,,0,0,0,,Sıkıntı yok.Dialogue: 50,0:15:12.77,0:15:14.10,Main-207-,,0,0,0,,Sanji!Dialogue: 50,0:15:14.69,0:15:17.35,Main-207-,,0,0,0,,Sakın üşütme.Dialogue: 50,0:15:32.49,0:15:34.75,Main-207-,,0,0,0,,Patron Zeff!Dialogue: 50,0:15:36.25,0:15:40.21,Main-207-,,0,0,0,,Bunca yıldır benim için yaptıklarından dolayı teşekkür ederim!Dialogue: 50,0:15:40.75,0:15:43.26,Main-207-,,0,0,0,,Bu iyiliğini hayatım boyunca...Dialogue: 50,0:15:43.26,0:15:44.76,Main-207-,,0,0,0,,unutmayacağım!Dialogue: 50,0:16:04.19,0:16:07.15,Main-207-,,0,0,0,,Seni pislik!Dialogue: 50,0:16:09.16,0:16:12.16,Main-207-,,0,0,0,,Seni özleyeceğim, kahretsin!Dialogue: 50,0:16:12.16,0:16:14.12,Main-207-,,0,0,0,,Seni özleyeceğim!Dialogue: 50,0:16:28.01,0:16:29.89,Main-207-,,0,0,0,,Seni özleyeceğim!Dialogue: 50,0:16:29.89,0:16:32.14,Main-207-,,0,0,0,,Beni ağlatıyorsun, kahretsin!Dialogue: 50,0:16:39.31,0:16:40.69,Main-207-,,0,0,0,,Sizi aptallar!Dialogue: 50,0:16:42.06,0:16:45.53,Main-207-,,0,0,0,,Erkekler tek laf etmeden ayrılmalı.Dialogue: 50,0:16:48.61,0:16:51.70,Main-207-,,0,0,0,,Gidelim! Demir alın!Dialogue: 50,0:16:51.70,0:16:55.45,Main-207-,,0,0,0,,Tekrar görüşürüz, lanet pislikler!Dialogue: 50,0:17:07.38,0:17:13.05,Thoughts-207-,,0,0,0,,Eğer kararlılığın ölümü umursamayacak kadar güçlendiğinde...Dialogue: 50,0:17:13.51,0:17:16.27,Thoughts-207-,,0,0,0,,işte o zaman bulacaksın,...Dialogue: 50,0:17:17.14,0:17:19.06,Thoughts-207-,,0,0,0,,All Blue'yu.Dialogue: 50,0:17:21.77,0:17:25.11,Main-207-,,0,0,0,,Beyler, birazdan müşteriler doluşacak!Dialogue: 50,0:17:25.11,0:17:27.78,Main-207-,,0,0,0,,İşe koyulun artık!Dialogue: 0,0:01:53.84,0:01:57.76,Title-207-,,0,0,0,,DördüncüDialogue: 1,0:01:53.84,0:01:57.76,Title-207-,,0,0,0,,DördüncüDialogue: 1,0:04:02.35,0:04:07.10,Captions-207-,,0,0,0,,Personel Yemek Odası 2. Kat, BaratieDialogue: 2,0:04:02.35,0:04:07.10,Captions-207-,,0,0,0,,Personel Yemek Odası 2. Kat, BaratieDialogue: 3,0:04:02.35,0:04:07.10,Captions-207-,,0,0,0,,Personel Yemek Odası 2. Kat, BaratieDialogue: 0,0:12:40.11,0:12:42.07,Captions-207-,,0,0,0,,m 271 292 l 273 287 276 283 287 278 1145 23 1157 20 1164 19 1162 756 1159 759 267 943Dialogue: 0,0:12:40.11,0:12:42.07,Captions-207-,,0,0,0,,m 271 292 l 273 287 276 283 287 278 1145 23 1157 20 1164 19 1162 756 1159 759 267 943Dialogue: 0,0:12:40.11,0:12:42.07,Captions-207-,,0,0,0,,m 271 292 l 273 287 276 283 287 278 1145 23 1157 20 1164 19 1162 756 1159 759 267 943Dialogue: 0,0:12:40.11,0:12:42.07,Captions-207-,,0,0,0,,m 271 292 l 273 287 276 283 287 278 1145 23 1157 20 1164 19 1162 756 1159 759 267 943Dialogue: 0,0:12:40.11,0:12:42.07,Captions-207-,,0,0,0,,m 271 292 l 273 287 276 283 287 278 1145 23 1157 20 1164 19 1162 756 1159 759 267 943Dialogue: 0,0:12:40.11,0:12:42.07,Captions-207-,,0,0,0,,m 271 292 l 273 287 276 283 287 278 1145 23 1157 20 1164 19 1162 756 1159 759 267 943Dialogue: 0,0:12:40.11,0:12:42.07,Captions-207-,,0,0,0,,m 271 292 l 273 287 276 283 287 278 1145 23 1157 20 1164 19 1162 756 1159 759 267 943Dialogue: 0,0:12:40.11,0:12:42.07,Captions-207-,,0,0,0,,m 271 292 l 273 2