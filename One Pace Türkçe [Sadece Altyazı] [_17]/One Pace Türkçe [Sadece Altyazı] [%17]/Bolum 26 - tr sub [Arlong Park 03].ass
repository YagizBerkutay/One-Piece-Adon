00,0,0,0,0,100,100,3,0,1,2.95,0,8,23,23,23,1Style: Lyrics-furigana,Duality,36,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,2.95,0,2,23,23,34,1Style: Lyrics,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,2,23,23,34,1Style: Karaoke,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,23,1Style: Kanji,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,146,1Style: Roger-Monologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1Style: Romaji ED,Josefin Sans,80,&H00D0740C,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,8,10,10,20,1Style: Translation ED,Josefin Sans,82,&H00D0740C,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,2,10,10,20,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:50.01,0:02:00.01,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:55.64,0:01:59.43,Main-207-,,0,0,0,,Bu hazine haritası mı?Dialogue: 0,0:02:00.35,0:02:02.98,Main-207-,,0,0,0,,Görünüşe göre Cocoyashi Köyünü gösteriyor.Dialogue: 0,0:02:03.39,0:02:05.40,Main-207-,,0,0,0,,Cocoyashi Köyü'nde hazine mi var?!Dialogue: 0,0:02:05.40,0:02:06.73,Main-207-,,0,0,0,,Gerçekten mi?!Dialogue: 0,0:02:06.73,0:02:10.36,Main-207-,,0,0,0,,O benim şahsi haritam.Dialogue: 0,0:02:10.36,0:02:12.49,Main-207-,,0,0,0,,Sizi hiç ilgilendirmez!Dialogue: 0,0:02:12.49,0:02:13.78,Main-207-,,0,0,0,,Dur bakalım.Dialogue: 0,0:02:13.78,0:02:16.45,Main-207-,,0,0,0,,Bir anda neden bu kadar kızdın?Dialogue: 0,0:02:18.83,0:02:21.33,Main-207-,,0,0,0,,Bu da ne?!Dialogue: 0,0:02:21.91,0:02:25.42,Main-207-,,0,0,0,,Burada ne oldu böyle?!Dialogue: 0,0:02:25.42,0:02:27.96,Main-207-,,0,0,0,,Korsan Avcısı, Roronoa Zoro'nun işi!Dialogue: 0,0:02:28.75,0:02:31.38,Main-207-,,0,0,0,,Peki, sen neredeydin, Hachi?!Dialogue: 0,0:02:31.76,0:02:34.05,Main-207-,,0,0,0,,Eğer burada olsaydın, bunu önleyebilirdin!Dialogue: 0,0:02:34.05,0:02:37.89,Main-207-,,0,0,0,,Tabii ki önleyebilirdim! Eğer burada olsaydım!Dialogue: 0,0:02:37.89,0:02:40.18,Main-207-,,0,0,0,,Bu affedilemez!Dialogue: 0,0:02:40.52,0:02:44.14,Main-207-,,0,0,0,,Yani, sen de mi Zoro'nun nereye kaybolduğunu bilmiyorsun?Dialogue: 0,0:02:46.15,0:02:50.69,Main-207-,,0,0,0,,Tek gördüğüm daha önce hiç karşılaşmadığım...Dialogue: 0,0:02:50.69,0:02:53.61,Main-207-,,0,0,0,,tuhaf bir kılıç ustasıydı...Dialogue: 0,0:02:55.91,0:02:57.41,Main-207-,,0,0,0,,Yoksa o muydu?!Dialogue: 0,0:02:59.87,0:03:01.74,Main-207-,,0,0,0,,Yani onu gördün, aptal!Dialogue: 0,0:03:01.74,0:03:03.41,Main-207-,,0,0,0,,Peki, nereye gitti?!Dialogue: 0,0:03:03.41,0:03:08.88,Main-207-,,0,0,0,,Arlong-san'ı görmek istediğinden, onu şimdi Cocoyashi Köyü'ne bıraktım.Dialogue: 0,0:03:10.96,0:03:14.51,Main-207-,,0,0,0,,Yani acele edip onu aramaya gerek yok.Dialogue: 0,0:03:14.92,0:03:18.26,Main-207-,,0,0,0,,O da beni arıyor.Dialogue: 0,0:03:18.26,0:03:22.31,Main-207-,,0,0,0,,Senin misafirin olduğunu söyledi.Dialogue: 0,0:03:22.31,0:03:27.10,Main-207-,,0,0,0,,Ve ben de senin bu kadar çabuk döneceğini düşünmedim.Dialogue: 0,0:03:27.10,0:03:28.52,Thoughts-207-,,0,0,0,,Zoro, ha?!Dialogue: 0,0:03:28.52,0:03:31.48,Thoughts-207-,,0,0,0,,Yani, kendim için biraz daha zaman kazanmam gerek.Dialogue: 0,0:03:37.41,0:03:39.53,Thoughts-207-,,0,0,0,,Neden yoluma çıkıyorsun?!Dialogue: 0,0:03:39.53,0:03:42.16,Thoughts-207-,,0,0,0,,Her şey yoluna girmeye çok yakınken!Dialogue: 0,0:03:45.66,0:03:46.83,Thoughts-207-,,0,0,0,,Çok yakın...!Dialogue: 0,0:03:57.68,0:04:00.05,Main-207-,,0,0,0,,L-Lanet olası! Kapışmak mı istiyorsun?!Dialogue: 0,0:04:00.55,0:04:01.80,Main-207-,,0,0,0,,Baş belasısın!Dialogue: 0,0:04:02.51,0:04:04.10,Main-207-,,0,0,0,,Bu senin hatan!Dialogue: 0,0:04:04.52,0:04:06.93,Main-207-,,0,0,0,,Arlong'la uğraşırsan olacağı bu!Dialogue: 0,0:04:07.81,0:04:10.81,Main-207-,,0,0,0,,Nami! Beni hayal kırıklığına uğrattın!Dialogue: 0,0:04:10.81,0:04:14.69,Main-207-,,0,0,0,,Gemimizi çalıp kaçtıktan sonra bile,...Dialogue: 0,0:04:14.69,0:04:17.57,Main-207-,,0,0,0,,Luffy senden zerre şüphelenmedi!Dialogue: 0,0:04:17.57,0:04:19.82,Main-207-,,0,0,0,,Şimdi bile, sana tamamen güveniyor!Dialogue: 0,0:04:19.82,0:04:23.20,Main-207-,,0,0,0,,Böyle birinin suratına baka baka nasıl yalan söyledin?!Dialogue: 0,0:04:23.20,0:04:25.70,Main-207-,,0,0,0,,Tek güvendiğim şey paradır.Dialogue: 0,0:04:25.70,0:04:27.50,Main-207-,,0,0,0,,Saflığı kendi hatası!Dialogue: 0,0:04:27.50,0:04:28.79,Main-207-,,0,0,0,,Ne dedin?!Dialogue: 0,0:04:30.96,0:04:34.21,Main-207-,,0,0,0,,Her şeyin sorunsuz olması gerekiyordu.Dialogue: 0,0:04:36.88,0:04:41.84,Main-207-,,0,0,0,,Siz benim sekiz yıllık emeğimi boşa çıkartacaksınız.Dialogue: 0,0:04:41.84,0:04:43.35,Main-207-,,0,0,0,,Yani en azından...Dialogue: 0,0:04:43.76,0:04:46.35,Main-207-,,0,0,0,,işini bitirecek kişi ben olmalıyım!Dialogue: 0,0:04:48.27,0:04:52.44,Main-207-,,0,0,0,,Ayrılmadan önceki halinden daha korsansın!Dialogue: 0,0:04:52.44,0:04:53.73,Main-207-,,0,0,0,,İşimi bitirmek mi?Dialogue: 0,0:04:55.57,0:04:58.24,Main-207-,,0,0,0,,Sen mi beni bitireceksin?! Güldürme lütfen!Dialogue: 0,0:04:58.69,0:04:59.86,Main-207-,,0,0,0,,Yerinde olsam...Dialogue: 0,0:05:00.66,0:05:02.49,Main-207-,,0,0,0,,beni hafife almazdım.Dialogue: 0,0:05:04.62,0:05:05.49,Thoughts-207-,,0,0,0,,Sıçtım.Dialogue: 0,0:05:06.33,0:05:08.87,Thoughts-207-,,0,0,0,,Eğer burada durursam, kesinlikle ölürüm!Dialogue: 0,0:05:08.87,0:05:10.16,Main-207-,,0,0,0,,Ölümcül...Dialogue: 0,0:05:13.88,0:05:15.63,Main-207-,,0,0,0,,Sis Yıldızı!Dialogue: 0,0:05:16.75,0:05:19.01,Main-207-,,0,0,0,,Şerefsiz, sis bombası attı!Dialogue: 0,0:05:19.01,0:05:20.84,Main-207-,,0,0,0,,Etrafını sarın! Sakın kaçmasın!Dialogue: 0,0:05:22.34,0:05:23.22,Main-207-,,0,0,0,,Tam sırası!Dialogue: 0,0:05:26.85,0:05:29.35,Main-207-,,0,0,0,,Böyle bir şey yapacağını tahmin etmiştim.Dialogue: 0,0:05:29.85,0:05:30.81,Main-207-,,0,0,0,,Nami!Dialogue: 0,0:05:31.56,0:05:34.27,Main-207-,,0,0,0,,B-Beni...Dialogue: 0,0:05:41.15,0:05:43.24,Main-207-,,0,0,0,,Tamamlamam gereken bir iş var.Dialogue: 0,0:05:48.58,0:05:50.75,Main-207-,,0,0,0,,Tek seçeneğim buydu!Dialogue: 0,0:05:50.75,0:05:52.87,Main-207-,,0,0,0,,N-Nami, nasıl yaparsın?Dialogue: 0,0:05:55.46,0:05:57.25,Main-207-,,0,0,0,,Şimdi usluca öl.Dialogue: 0,0:06:03.80,0:06:05.51,Main-207-,,0,0,0,,– Helal be, Nami! – İntikam böyle alınır!Dialogue: 0,0:06:05.51,0:06:08.31,Main-207-,,0,0,0,,İşte bu yüzden Arlong Korsanları'nda yetkilisin!Dialogue: 0,0:06:09.39,0:06:16.48,Main-207-,,0,0,0,,Usopp abi, Nami abla tarafından öldürüldü!Dialogue: 0,0:06:19.73,0:06:21.28,Main-207-,,0,0,0,,İstediğin buydu, değil mi?Dialogue: 0,0:06:21.28,0:06:22.95,Main-207-,,0,0,0,,Denizde ölmek?Dialogue: 0,0:06:22.95,0:06:25.66,Main-207-,,0,0,0,,Nami, senden şüphelendiğim için üzgünüm.Dialogue: 0,0:06:25.66,0:06:27.91,Main-207-,,0,0,0,,Bizden birisin.Dialogue: 0,0:06:28.49,0:06:29.41,Main-207-,,0,0,0,,Sizden biri mi?Dialogue: 0,0:06:29.91,0:06:31.83,Main-207-,,0,0,0,,Ben yalnız çalışırım!Dialogue: 0,0:06:34.12,0:06:37.29,Main-207-,,0,0,0,,Size katılmamın tek bir sebebi var!Dialogue: 0,0:06:38.25,0:06:40.46,Main-207-,,0,0,0,,Cocoyashi Köyü'nü satın almak!Dialogue: 0,0:06:41.63,0:06:43.09,Main-207-,,0,0,0,,Sözünde dur!Dialogue: 0,0:06:43.09,0:06:45.47,Main-207-,,0,0,0,,Yakında 100 milyon beli toplayacağım!Dialogue: 0,0:06:45.47,0:06:46.47,Main-207-,,0,0,0,,Elbette.Dialogue: 0,0:06:47.22,0:06:51.43,Main-207-,,0,0,0,,Para konusunda sözümü bozmaktansa kendimi öldürmeyi tercih ederim.Dialogue: 0,0:06:51.77,0:06:54.14,Main-207-,,0,0,0,,Ben böyle biriyim.Dialogue: 0,0:06:54.69,0:06:56.52,Main-207-,,0,0,0,,Arlong'a yakışır şekilde.Dialogue: 0,0:06:56.52,0:06:57.94,Main-207-,,0,0,0,,Anlaşmayı biliyorsun.Dialogue: 0,0:07:00.23,0:07:02.03,Main-207-,,0,0,0,,Bu kız beni ürkütüyor.Dialogue: 0,0:07:04.15,0:07:07.03,Main-207-,,0,0,0,,Kendini bulmaya başladı!Dialogue: 0,0:07:08.91,0:07:10.62,Main-207-,,0,0,0,,Cadı...!Dialogue: 0,0:07:10.62,0:07:13.75,Main-207-,,0,0,0,,Gerçekten cadı!Dialogue: 0,0:07:17.83,0:07:20.59,Main-207-,,0,0,0,,İşte orası! Arlong Park!Dialogue: 0,0:07:23.59,0:07:25.88,Main-207-,,0,0,0,,Hey! Yorulmanın zamanı değil, inek!Dialogue: 0,0:07:26.26,0:07:30.10,Main-207-,,0,0,0,,Cidden, Sanji abinin tekmelerinden etkilenmiş olmalı!Dialogue: 0,0:07:30.43,0:07:34.56,Main-207-,,0,0,0,,Hey! O tarafa değil! Sol tarafa! Oradaki binaya!Dialogue: 0,0:07:58.46,0:08:00.08,Main-207-,,0,0,0,,Sanki uçuyoruz!Dialogue: 0,0:08:00.08,0:08:01.09,Main-207-,,0,0,0,,Sanki değil!Dialogue: 0,0:08:01.09,0:08:02.59,Main-207-,,0,0,0,,Harbi uçuyoruz, beyinsiz!Dialogue: 0,0:08:02.59,0:08:05.84,Main-207-,,0,0,0,,D-Düşüyoruz!Dialogue: 0,0:08:17.52,0:08:19.40,Main-207-,,0,0,0,,İnmeyi başardık!Dialogue: 0,0:08:21.69,0:08:24.15,Main-207-,,0,0,0,,Hey! Zoro!Dialogue: 0,0:08:35.49,0:08:37.37,Main-207-,,0,0,0,,Başardık! Başardık!Dialogue: 0,0:08:37.37,0:08:40.88,Main-207-,,0,0,0,,S-Siz aptallar,..Dialogue: 0,0:08:41.42,0:08:43.04,Main-207-,,0,0,0,,ne yapıyorsunuz?!Dialogue: 0,0:08:43.84,0:08:47.42,Main-207-,,0,0,0,,Ne demek istiyorsun? Nami için geldik.Dialogue: 0,0:08:47.42,0:08:49.43,Main-207-,,0,0,0,,Onu hala bulamadın mı?Dialogue: 0,0:08:49.93,0:08:52.43,Main-207-,,0,0,0,,Harbi, Usopp ve Johnny nerede?Dialogue: 0,0:08:52.43,0:08:53.68,Main-207-,,0,0,0,,Usopp!Dialogue: 0,0:08:54.31,0:08:57.43,Main-207-,,0,0,0,,D-Doğru ya! Burada vakit öldüremem!Dialogue: 0,0:08:58.18,0:08:59.56,Main-207-,,0,0,0,,Sorun ne?!Dialogue: 0,0:08:59.56,0:09:01.77,Main-207-,,0,0,0,,O salak, Arlong tarafından yakalandı!Dialogue: 0,0:09:01.77,0:09:03.81,Main-207-,,0,0,0,,Öldürülmeden önce acele etmeliyiz!Dialogue: 0,0:09:03.81,0:09:04.94,Main-207-,,0,0,0,,Geciktiniz!Dialogue: 0,0:09:04.94,0:09:06.03,Main-207-,,0,0,0,,Ne?!Dialogue: 0,0:09:08.24,0:09:10.82,Main-207-,,0,0,0,,Usopp abi, öldü!Dialogue: 0,0:09:11.41,0:09:13.57,Main-207-,,0,0,0,,Öldürüldü!Dialogue: 0,0:09:14.74,0:09:16.74,Main-207-,,0,0,0,,Nami abla tarafından!Dialogue: 0,0:09:20.71,0:09:22.04,Main-207-,,0,0,0,,Çabuk! Çabuk!Dialogue: 0,0:09:22.04,0:09:23.25,Main-207-,,0,0,0,,Ne oldu?!Dialogue: 0,0:09:23.25,0:09:25.00,Main-207-,,0,0,0,,Denizciler! Denizciler burada!Dialogue: 0,0:09:25.42,0:09:29.97,Main-207-,,0,0,0,,Bazı Gosa'dan kaçıp kurtulanlar hükümetle irtibata geçmiş!Dialogue: 0,0:09:29.97,0:09:33.68,Main-207-,,0,0,0,,Denizciler bizi kurtarmaya geldi!Dialogue: 0,0:09:33.68,0:09:34.43,Main-207-,,0,0,0,,Bak!Dialogue: 0,0:09:37.35,0:09:39.23,Main-207-,,0,0,0,,Kurtulduk!Dialogue: 0,0:09:39.23,0:09:42.02,Main-207-,,0,0,0,,Sonunda bu adadan kaçabileceğiz!Dialogue: 0,0:09:45.98,0:09:49.24,Main-207-,,0,0,0,,Demek kötü şöhretli Arlong Park burası!Dialogue: 0,0:09:49.24,0:09:53.32,Main-207-,,0,0,0,,Korsanların bu kadar rahat yaşamaları, sanki dünyanın sonu gelmiş gibi.Dialogue: 0,0:09:53.86,0:09:55.32,Main-207-,,0,0,0,,Dinleyin, beyler!Dialogue: 0,0:09:55.32,0:10:01.21,Main-207-,,0,0,0,,Bugünkü görevimiz, Arlong Korsanları tarafından yok edilen,...Dialogue: 0,0:10:01.21,0:10:04.04,Main-207-,,0,0,0,,Gosa Köyünden sağ kalanları kurtarmak!Dialogue: 0,0:10:04.67,0:10:06.34,Main-207-,,0,0,0,,Sorarım size...Dialogue: 0,0:10:07.17,0:10:11.01,Main-207-,,0,0,0,,Bizim adalet anlayışımız bu kontrolsüz korsanın kalesini...Dialogue: 0,0:10:11.47,0:10:14.01,Main-207-,,0,0,0,,görmezden gelmemize izin verir mi?!Dialogue: 0,0:10:14.59,0:10:15.89,Main-207-,,0,0,0,,– Hayır, efendim! – Hayır, efendim!Dialogue: 0,0:10:16.30,0:10:20.68,Main-207-,,0,0,0,,Bizim birliğimiz, Arlong'u ve adamlarını yok edecek!Dialogue: 0,0:10:20.68,0:10:22.69,Main-207-,,0,0,0,,Hemen savaşa hazırlanın!Dialogue: 0,0:10:22.69,0:10:23.44,Main-207-,,0,0,0,,– Başüstüne! – Başüstüne!Dialogue: 0,0:10:23.94,0:10:26.27,Main-207-,,0,0,0,,77. Denizci Birliği mi?Dialogue: 0,0:10:26.61,0:10:28.36,Main-207-,,0,0,0,,Evet, öyle dediler.Dialogue: 0,0:10:28.36,0:10:30.03,Main-207-,,0,0,0,,Yeni bir birlik.Dialogue: 0,0:10:30.03,0:10:32.57,Main-207-,,0,0,0,,Oraya gidip yetkili biriyle pazarlık edin.Dialogue: 0,0:10:32.57,0:10:36.95,Main-207-,,0,0,0,,Eğer 2 milyon, ağızlarını kapatmaya yetmiyorsa,Dialogue: 0,0:10:36.95,0:10:38.24,Main-207-,,0,0,0,,hepsinden kurtulun!Dialogue: 0,0:10:42.54,0:10:43.91,Main-207-,,0,0,0,,Aniden saldırıya geçtiler!Dialogue: 0,0:10:43.91,0:10:45.17,Main-207-,,0,0,0,,Arlong-san ! Dikkat et!Dialogue: 0,0:10:55.22,0:10:58.10,Main-207-,,0,0,0,,A-Ağzıyla top güllesini durdurdu!Dialogue: 0,0:10:58.10,0:11:00.06,Main-207-,,0,0,0,,Isırığı dehşet verici!Dialogue: 0,0:11:00.72,0:11:02.56,Main-207-,,0,0,0,,Arlong-san. Pazarlık?Dialogue: 0,0:11:05.02,0:11:05.85,Main-207-,,0,0,0,,İptal edildi.Dialogue: 0,0:11:06.77,0:11:07.90,Main-207-,,0,0,0,,Peki! Hadi gidelim!Dialogue: 0,0:11:07.90,0:11:08.81,Main-207-,,0,0,0,,Savaş zamanı!Dialogue: 0,0:11:08.81,0:11:11.53,Main-207-,,0,0,0,,Denizciler için kan banyosu olacak!Dialogue: 0,0:11:12.57,0:11:14.36,Main-207-,,0,0,0,,Yavaş olun, beyler.Dialogue: 0,0:11:17.03,0:11:21.20,Main-207-,,0,0,1,,Çöpü atmak için bu kadar efora ihtiyacımız yok.Dialogue: 0,0:11:22.08,0:11:23.91,Main-207-,,0,0,1,,Biz hallederiz!Dialogue: 0,0:11:23.91,0:11:28.54,Main-207-,,0,0,1,,Suda bize meydan okuyan o insanlar salak olmalılar.Dialogue: 0,0:11:28.54,0:11:32.42,Main-207-,,0,0,0,,Üç yetkilimiz mi?! Harika bir savaş olacak!Dialogue: 0,0:11:33.17,0:11:36.13,Main-207-,,0,0,0,,Gemileri üç dakika bile dayanamaz!Dialogue: 0,0:11:38.30,0:11:39.64,Main-207-,,0,0,0,,Çok garip...Dialogue: 0,0:11:40.10,0:11:42.22,Main-207-,,0,0,0,,Komodor! Gülle boş çıktı!Dialogue: 0,0:11:42.22,0:11:45.14,Main-207-,,0,0,0,,Yine ateş edin! Savaşma niyetimizi görsünler!Dialogue: 0,0:11:45.14,0:11:47.52,Main-207-,,0,0,0,,Düşmanımız balıkadamlar, tetikte olun!Dialogue: 0,0:11:47.52,0:11:48.31,Main-207-,,0,0,0,,– Başüstüne! – Başüstüne!Dialogue: 0,0:11:51.61,0:11:53.44,Main-207-,,0,0,0,,Vuruldu! Arlong'un adamı vurdu!Dialogue: 0,0:11:53.44,0:11:54.82,Main-207-,,0,0,0,,Yakalayın! Saldırın!Dialogue: 0,0:11:55.19,0:11:56.28,Main-207-,,0,0,0,,Durun! Sakin olun!Dialogue: 0,0:11:58.20,0:12:00.24,Main-207-,,0,0,0,,Arlong'un adamısın, değil mi?Dialogue: 0,0:12:00.24,0:12:04.16,Main-207-,,0,0,0,,Ben 77. Denizci Birliği'nden Komodor Purinpurin.Dialogue: 0,0:12:04.16,0:12:09.96,Main-207-,,0,0,0,,Biz bilinen bir elit denizci birliğiyiz!Dialogue: 0,0:12:09.96,0:12:13.88,Main-207-,,0,0,0,,Ölmek istemiyorsanız, teslim olmanızı tavsiye ederi–Dialogue: 0,0:12:14.63,0:12:15.38,Main-207-,,0,0,0,,– Komodor! – Komodor!Dialogue: 0,0:12:15.76,0:12:16.88,Main-207-,,0,0,0,,Bunu nasıl yaparsın!Dialogue: 0,0:12:16.88,0:12:18.09,Main-207-,,0,0,0,,Öldürün onu!Dialogue: 0,0:12:19.55,0:12:20.93,Main-207-,,0,0,0,,N-Neydi o çarpma?!Dialogue: 0,0:12:20.93,0:12:22.85,Main-207-,,0,0,0,,Yoksa... Saldırı alttan mı?!Dialogue: 0,0:12:26.64,0:12:29.98,Main-207-,,0,0,0,,Sizi bu şekilde rahatsız ettiğim için üzgünüm,...Dialogue: 0,0:12:30.48,0:12:33.69,Main-207-,,0,0,0,,ama geminizin dümenini sökme cüretini gösterdik.Dialogue: 0,0:12:33.69,0:12:35.44,Main-207-,,0,0,0,,N-Ne?!Dialogue: 0,0:12:34.19,0:12:35.44,Secondary-207-,,0,0,0,,Komodor!Dialogue: 0,0:12:35.44,0:12:36.40,Main-207-,,0,0,0,,İyi misiniz?!Dialogue: 0,0:12:37.65,0:12:41.12,Main-207-,,0,0,0,,Endişelenmeyin. Hiçbir hayati organı vurmadım.Dialogue: 0,0:12:42.62,0:12:45.87,Main-207-,,0,0,0,,Farazi konuşuyorum, Komodor...Dialogue: 0,0:12:45.87,0:12:50.29,Main-207-,,0,0,0,,sence birisi büyük bir kayayı güçlü bir akıntıya doğru hareket ettirirse,Dialogue: 0,0:12:50.29,0:12:52.13,Main-207-,,0,0,0,,okyanusa ne olur?Dialogue: 0,0:12:52.13,0:12:53.09,Main-207-,,0,0,0,,Ne?!Dialogue: 0,0:12:57.46,0:12:59.63,Main-207-,,0,0,0,,Kayayı hareket ettirmek mi?!Dialogue: 0,0:12:59.63,0:13:02.18,Main-207-,,0,0,0,,Bu imkansız!Dialogue: 0,0:13:02.59,0:13:04.43,Main-207-,,0,0,0,,Tamamdır! Yeri iyi, Hachi!Dialogue: 0,0:13:04.43,0:13:06.14,Main-207-,,0,0,0,,Tamam!Dialogue: 0,0:13:06.14,0:13:07.35,Main-207-,,0,0,0,,K-Komodor!Dialogue: 0,0:13:07.85,0:13:09.48,Main-207-,,0,0,0,,Dev bir girdap oluştu!Dialogue: 0,0:13:09.48,0:13:10.81,Main-207-,,0,0,0,,Dümen çalışmıyor!Dialogue: 0,0:13:10.81,0:13:11.69,Main-207-,,0,0,0,,Ne?!Dialogue: 0,0:13:11.69,0:13:14.69,Main-207-,,0,0,0,,Size söyledim. Dümeni söktük.Dialogue: 0,0:13:15.23,0:13:18.07,Main-207-,,0,0,0,,Dümensiz geminiz doğrudan denizin derinliklerine...Dialogue: 0,0:13:19.53,0:13:20.65,Main-207-,,0,0,0,,yol alıyor.Dialogue: 0,0:13:38.76,0:13:40.05,Main-207-,,0,0,0,,Bu olamaz...Dialogue: 0,0:13:41.63,0:13:43.76,Main-207-,,0,0,0,,Gerçek bu.Dialogue: 0,0:13:44.80,0:13:46.10,Main-207-,,0,0,0,,Arlong'un kontrolünden...Dialogue: 0,0:13:46.68,0:13:49.27,Main-207-,,0,0,0,,kaçmamızın imkanı yok.Dialogue: 0,0:13:52.48,0:13:54.23,Main-207-,,0,0,0,,Bunun için teşekkürler.Dialogue: 0,0:13:54.23,0:13:57.65,Main-207-,,0,0,0,,Basitti. Bu sularda rüzgarlardan derinliklere kadar,Dialogue: 0,0:13:57.65,0:13:59.15,Main-207-,,0,0,0,,her şeyi biliyoruz.Dialogue: 0,0:13:59.15,0:14:00.36,Main-207-,,0,0,0,,Çocuk oyuncağıydı.Dialogue: 0,0:14:00.36,0:14:03.95,Main-207-,,0,0,0,,Üstün yeteneklerimizle bu denizde bize kimse meydan okuyamaz!Dialogue: 0,0:14:03.95,0:14:06.91,Main-207-,,0,0,0,,Ve Nami'nin deniz haritalarını unutmayalım.Dialogue: 0,0:14:06.91,0:14:09.50,Main-207-,,0,0,0,,Onlar gerçekten de harika kalitede haritalar!Dialogue: 0,0:14:09.50,0:14:16.09,Main-207-,,0,0,0,,Nami tüm okyanusları haritalayınca, denizlerin efendileri biz olacağız!Dialogue: 0,0:14:17.34,0:14:22.72,Main-207-,,0,0,0,,Nami, Arlong İmparatorluğu'nu kurmak için hayati bir öneme sahip!Dialogue: 0,0:14:22.72,0:14:23.76,Main-207-,,0,0,0,,Çok yazık!Dialogue: 0,0:14:23.76,0:14:24.84,Main-207-,,0,0,0,,Yazık mı?Dialogue: 0,0:14:24.84,0:14:27.64,Main-207-,,0,0,0,,Nami, 100 milyon beli topladığında, onun ve köyününDialogue: 0,0:14:27.64,0:14:30.39,Main-207-,,0,0,0,,gitmesine izin vereceğine söz verdi.Dialogue: 0,0:14:30.39,0:14:32.10,Main-207-,,0,0,0,,Gerçekten mi, Arlong-san ?!Dialogue: 0,0:14:32.10,0:14:34.44,Main-207-,,0,0,0,,Cidden onun gitmesine izin mi vereceksin?!Dialogue: 0,0:14:34.44,0:14:36.02,Main-207-,,0,0,0,,Başka seçeneğim yok.Dialogue: 0,0:14:36.02,0:14:39.36,Main-207-,,0,0,0,,Sekiz yıl önce böyle bir söz verdim.Dialogue: 0,0:14:39.36,0:14:45.91,Main-207-,,0,0,0,,Konu para olduğunda, sözümden dönmektense ölmeyi tercih ederim.Dialogue: 0,0:14:46.66,0:14:48.87,Main-207-,,0,0,0,,Tekrar söyle de kıçına tekmeyi basayım!Dialogue: 0,0:14:48.87,0:14:51.62,Main-207-,,0,0,0,,Dur, Luffy. Bunun Johnny'le bir alakası yok.Dialogue: 0,0:14:51.62,0:14:53.96,Main-207-,,0,0,0,,Eğer bana inanmak istemiyorsan, inanma!Dialogue: 0,0:14:53.96,0:14:56.00,Main-207-,,0,0,0,,Ama ne gördüğümü biliyorum!Dialogue: 0,0:14:56.00,0:14:57.63,Main-207-,,0,0,0,,Abla, Usopp abiyi–Dialogue: 0,0:14:57.63,0:14:58.63,Main-207-,,0,0,0,,Kapa' çeneni!Dialogue: 0,0:14:59.00,0:15:01.84,Main-207-,,0,0,0,,Nami asla Usopp'u öldürmez!Dialogue: 0,0:15:01.84,0:15:03.59,Main-207-,,0,0,0,,O bizden biri!Dialogue: 0,0:15:03.59,0:15:05.68,Main-207-,,0,0,0,,Ama, ben...!Dialogue: 0,0:15:07.01,0:15:09.22,Main-207-,,0,0,0,,Kim sizdenmiş, Luffy?Dialogue: 0,0:15:09.64,0:15:10.56,Main-207-,,0,0,0,,Nami!Dialogue: 0,0:15:10.97,0:15:12.18,Main-207-,,0,0,0,,Niye buradasın?Dialogue: 0,0:15:12.64,0:15:13.98,Main-207-,,0,0,0,,Neden bahsediyorsun?Dialogue: 0,0:15:13.98,0:15:17.19,Main-207-,,0,0,0,,Bizim arkadaşımızsın! Seni almaya geldik!Dialogue: 0,0:15:17.19,0:15:18.65,Main-207-,,0,0,0,,Baş belasısın resmen.Dialogue: 0,0:15:18.65,0:15:19.40,Main-207-,,0,0,0,,Nami?Dialogue: 0,0:15:19.82,0:15:21.07,Main-207-,,0,0,0,,Arkadaş mı?Dialogue: 0,0:15:21.07,0:15:22.40,Main-207-,,0,0,0,,Güldürme beni!Dialogue: 0,0:15:22.40,0:15:24.86,Main-207-,,0,0,0,,Zar zor bir arada duruyorsunuz.Dialogue: 0,0:15:25.86,0:15:27.99,Main-207-,,0,0,0,,Seni cadı! Onu öldürdün!Dialogue: 0,0:15:27.99,0:15:29.87,Main-207-,,0,0,0,,Kendi gözlerimle gördüm!Dialogue: 0,0:15:29.87,0:15:31.12,Main-207-,,0,0,0,,Ne cüretle...!Dialogue: 0,0:15:31.12,0:15:32.83,Main-207-,,0,0,0,,Ne cüretle Usopp abiyi öldürürsün?!Dialogue: 0,0:15:32.83,0:15:34.54,Main-207-,,0,0,0,,Ne olmuş yani?Dialogue: 0,0:15:34.54,0:15:36.79,Main-207-,,0,0,0,,O zaman öldür beni de intikamını al!Dialogue: 0,0:15:37.75,0:15:38.96,Main-207-,,0,0,0,,Ne?!Dialogue: 0,0:15:38.96,0:15:41.30,Main-207-,,0,0,0,,Size şu kadarını söyleyeceğim.Dialogue: 0,0:15:41.30,0:15:45.67,Main-207-,,0,0,0,,Şu anda Arlong, Roronoa Zoro ve adamlarını öldürmek istiyor.Dialogue: 0,0:15:45.67,0:15:48.18,Main-207-,,0,0,0,,Çünkü Zoro illa bir salaklık yapacaktı.Dialogue: 0,0:15:48.55,0:15:51.56,Main-207-,,0,0,0,,Canavar gibi güçleriniz olsa bile,...Dialogue: 0,0:15:51.56,0:15:54.14,Main-207-,,0,0,0,,gerçek canavarlarla boy ölçüşemezsin.Dialogue: 0,0:15:56.85,0:15:59.52,Main-207-,,0,0,0,,Merhaba, Nami-san ! Benim! Beni hatırladın mı?!Dialogue: 0,0:15:59.52,0:16:01.36,Main-207-,,0,0,0,,Hadi birlikte yelken açalım!Dialogue: 0,0:16:01.36,0:16:04.65,Main-207-,,0,0,0,,Kapa' çeneni! İşleri daha da karmaşıklaştırıyorsun!Dialogue: 0,0:16:04.65,0:16:06.24,Main-207-,,0,0,0,,Ne dedin?!Dialogue: 0,0:16:06.24,0:16:08.61,Main-207-,,0,0,0,,Aşk her zaman bir kasırgadır!Dialogue: 0,0:16:08.61,0:16:10.49,Main-207-,,0,0,0,,Lan! Biri konuşurken dinle!Dialogue: 0,0:16:10.49,0:16:11.49,Main-207-,,0,0,0,,Usopp nerede?Dialogue: 0,0:16:12.16,0:16:13.45,Main-207-,,0,0,0,,Denizin dibinde.Dialogue: 0,0:16:13.45,0:16:15.29,Main-207-,,0,0,0,,Kahretsin! Saçmalamayı kes!Dialogue: 0,0:16:17.79,0:16:21.34,Main-207-,,0,0,0,,Yani kılıç ustaları kadınlara da mı saldırır, Roronoa Zoro?Dialogue: 0,0:16:21.34,0:16:25.13,Main-207-,,0,0,0,,Ne?! Burada ne olduğunu bile bilmiyorsun! Geri çekil!Dialogue: 0,0:16:26.63,0:16:29.84,Main-207-,,0,0,0,,O kadar pataklansam ben de sinir olurdum.Dialogue: 0,0:16:31.39,0:16:32.35,Main-207-,,0,0,0,,Lan!Dialogue: 0,0:16:32.35,0:16:33.89,Main-207-,,0,0,0,,Diline sahip çık!Dialogue: 0,0:16:33.89,0:16:37.14,Main-207-,,0,0,0,,Kendi işine bak, pislik!Dialogue: 0,0:16:37.14,0:16:41.06,Main-207-,,0,0,0,,Abiler! Aramızda kavga etmenin zamanı değil!Dialogue: 0,0:16:41.06,0:16:42.73,Main-207-,,0,0,0,,Aynen öyle!Dialogue: 0,0:16:42.73,0:16:45.28,Main-207-,,0,0,0,,Kavga edecekseniz, adadan ayrılana kadar bekleyin!Dialogue: 0,0:16:45.28,0:16:48.95,Main-207-,,0,0,0,,Daha fazla işimize karışmayın, yabancılar!Dialogue: 0,0:16:48.95,0:16:50.61,Main-207-,,0,0,0,,Hala anlamadınız, değil mi?Dialogue: 0,0:16:50.61,0:16:55.37,Main-207-,,0,0,0,,Sizinle yakınlaşmamın tek sebebi paranızdı!Dialogue: 0,0:16:55.37,0:16:59.58,Main-207-,,0,0,0,,Şimdi paranız olmadığına göre size ihtiyacım kalmadı!Dialogue: 0,0:16:59.58,0:17:01.04,Main-207-,,0,0,0,,Geminizi de alabilirsiniz,Dialogue: 0,0:17:01.04,0:17:04.42,Main-207-,,0,0,0,,başka bir rotacı bulun ve Grand Line'a gidin!Dialogue: 0,0:17:04.42,0:17:07.71,Main-207-,,0,0,0,,Gidin ve One Piece ya da her neyse onu arayın!Dialogue: 0,0:17:08.22,0:17:10.30,Main-207-,,0,0,0,,Yeterki defolun! Sizi görmekten bıktım!Dialogue: 0,0:17:13.43,0:17:14.81,Main-207-,,0,0,0,,Elveda.Dialogue: 0,0:17:16.22,0:17:17.47,Main-207-,,0,0,0,,Nami...Dialogue: 0,0:17:24.19,0:17:25.27,Main-207-,,0,0,0,,Luffy abi?!Dialogue: 0,0:17:25.73,0:17:26.65,Main-207-,,0,0,0,,Kestireceğim.Dialogue: 0,0:17:26.65,0:17:27.40,Main-207-,,0,0,0,,Kestirmek mi?!Dialogue: 0,0:17:27.40,0:17:29.74,Main-207-,,0,0,0,,Böyle bir zamanda, yolun ortasında mı?!Dialogue: 0,0:17:29.74,0:17:32.03,Main-207-,,0,0,0,,Hiçbir yere gitmiyorum,...Dialogue: 0,0:17:32.61,0:17:36.16,Main-207-,,0,0,0,,adada olup bitenlerle de ilgilenmiyorum.Dialogue: 0,0:17:36.16,0:17:37.87,Main-207-,,0,0,0,,Ve biraz uykum var.Dialogue: 0,0:17:38.20,0:17:39.58,Main-207-,,0,0,0,,Uyuyacağım.Dialogue: 0,0:17:38.75,0:17:39.58,Secondary-207-,,0,0,0,,Ha?!Dialogue: 0,0:17:46.50,0:17:47.46,Main-207-,,0,0,0,,İyi be...Dialogue: 0,0:17:47.46,0:17:49.67,Main-207-,,0,0,0,,Ne halin varsa gör! Geber!Dialogue: 0,0:17:49.67,0:17:50.55,Main-207-,,0,0,0,,Na–Dialogue: 0,0:17:55.68,0:17:57.68,Main-207-,,0,0,0,,Hey, Zoro abi!Dialogue: 0,0:17:57.68,0:18:00.06,Main-207-,,0,0,0,,Sen ne düşünüyorsun?!Dialogue: 0,0:18:00.06,0:18:02.81,Main-207-,,0,0,0,,Arlong bizi öldürmek istiyor!Dialogue: 0,0:18:02.81,0:18:04.56,Main-207-,,0,0,0,,Neden kaçıp gitmiyoruz?!Dialogue: 0,0:18:04.56,0:18:06.82,Main-207-,,0,0,0,,Nami'nin gerçek yüzünü de gördük,Dialogue: 0,0:18:06.82,0:18:09.74,Main-207-,,0,0,0,,bu adada kalmamız için hiçbir sebep kalmadı!Dialogue: 0,0:18:12.95,0:18:15.07,Main-207-,,0,0,0,,P-Pekâlâ!Dialogue: 0,0:18:15.07,0:18:19.04,Main-207-,,0,0,0,,Buluşmamız kısa oldu ama rehberliğimiz buraya kadar!Dialogue: 0,0:18:19.04,0:18:22.87,Main-207-,,0,0,0,,Katılıyorum! Ölmek istemiyorum!Dialogue: 0,0:18:23.37,0:18:24.37,Main-207-,,0,0,0,,Tamam.Dialogue: 0,0:18:24.37,0:18:25.75,Main-207-,,0,0,0,,Dikkatli olun.Dialogue: 0,0:18:25.75,0:18:28.25,Main-207-,,0,0,0,,Tekrar görüşene dek!Dialogue: 0,0:18:28.25,0:18:30.01,Main-207-,,0,0,0,,Kendinize iyi bakın!Dialogue: 0,0:18:30.01,0:18:31.42,Main-207-,,0,0,0,,Siz de!Dialogue: 0,0:18:45.31,0:18:46.52,Main-207-,,0,0,0,,Hey.Dialogue: 0,0:18:46.52,0:18:47.11,Main-207-,,0,0,0,,Ha?Dialogue: 0,0:18:47.44,0:18:51.07,Main-207-,,0,0,0,,Nami-san'ın Uzun Burun'u öldürdüğüne gerçekten inanıyor musun?Dialogue: 0,0:18:58.53,0:18:59.83,Thoughts-207-,,0,0,0,,Orada...Dialogue: 0,0:19:01.29,0:19:03.50,Flashbacks-207-,,0,0,0,,Tamamlamam gereken bir iş var!Dialogue: 0,0:19:05.33,0:19:06.96,Flashbacks-207-,,0,0,0,,Tek seçeneğim buydu!Dialogue: 0,0:19:08.71,0:19:11.05,Thoughts-207-,,0,0,0,,Orada, Nami...Dialogue: 0,0:19:11.38,0:19:15.76,Thoughts-207-,,0,0,0,,beni bıçaklamış gibi göstermek için kendi elini bıçakladı!Dialogue: 0,0:19:18.30,0:19:23.48,Thoughts-207-,,0,0,0,,Eğer bunu yapmasaydı, Arlong kesinlikle beni öldürürdü!Dialogue: 0,0:19:24.31,0:19:25.48,Thoughts-207-,,0,0,0,,Ne yapmalıyım?!Dialogue: 0,0:19:25.48,0:19:30.11,Thoughts-207-,,0,0,0,,Erkek adam Usopp, kurtarıldıktan sonra tüyemez!Dialogue: 0,0:19:30.11,0:19:33.57,Thoughts-207-,,0,0,0,,Şimdilik, acele edip Zoro'yu bulmalıyım!Dialogue: 0,0:19:34.78,0:19:36.70,Thoughts-207-,,0,0,0,,Yoksa o... Zoro mu?!Dialogue: 0,0:19:36.70,0:19:38.41,Thoughts-207-,,0,0,0,,Oymuş! Harika!Dialogue: 0,0:19:38.87,0:19:41.95,Main-207-,,0,0,0,,Nami onu öldürmedi. Demeye çalıştığın bu mu?Dialogue: 0,0:19:41.95,0:19:43.16,Main-207-,,0,0,0,,Haksız mıyım?Dialogue: 0,0:19:43.91,0:19:45.00,Main-207-,,0,0,0,,Kim bilir?Dialogue: 0,0:19:45.00,0:19:50.17,Main-207-,,0,0,0,,Ona "Sen sadece birinin ölümünü bile izleyemeyen küçük bir kızsın" dedim.Dialogue: 0,0:19:50.17,0:19:51.63,Main-207-,,0,0,0,,Belki de bu onu kızdırmıştır.Dialogue: 0,0:19:51.63,0:19:53.09,Main-207-,,0,0,0,,Ne demek "küçük kız"?!Dialogue: 0,0:19:53.55,0:19:56.76,Main-207-,,0,0,0,,Göğüsleri sana küçük bir kızınki gibi mi görünüyor?Dialogue: 0,0:19:56.76,0:19:57.88,Main-207-,,0,0,0,,Tek düşünebildiğin o-Dialogue: 0,0:20:02.35,0:20:04.10,Main-207-,,0,0,0,,Yaşıyor!Dialogue: 0,0:20:04.10,0:20:08.56,Main-207-,,0,0,0,,Hayır, galiba şimdi öldü.Dialogue: 0,0:20:27.25,0:20:29.04,Main-207-,,0,0,0,,Mekanı dağıtmayı iyi biliyorsun.Dialogue: 0,0:20:29.62,0:20:32.09,Main-207-,,0,0,0,,Nami, sorun ne?Dialogue: 0,0:20:32.09,0:20:34.80,Main-207-,,0,0,0,,Hiç. Sadece biraz dinlenmek için geldim.Dialogue: 0,0:20:36.09,0:20:41.30,Main-207-,,0,0,0,,Cam ve mobilyaya zarar vermek, rahatlamak için biraz fazla.Dialogue: 0,0:20:43.31,0:20:47.27,Main-207-,,0,0,0,,Madem sorun yok neden o hazine haritasına bakıyorsun?Dialogue: 0,0:20:49.64,0:20:52.90,Main-207-,,0,0,0,,Bana her şeyi anlatabileceğini söylemiştim, hatırladın mı?Dialogue: 0,0:20:53.32,0:20:55.57,Main-207-,,0,0,0,,Sadece bir şeye kızdım, hepsi bu!Dialogue: 0,0:20:57.94,0:20:59.78,Main-207-,,0,0,0,,Onlar demek. Hem kim onlar...?Dialogue: 0,0:21:00.41,0:21:01.16,Main-207-,,0,0,0,,Tanıştınız mı?!Dialogue: 0,0:21:01.49,0:21:04.66,Main-207-,,0,0,0,,Evet. Kaptan ya da onun gibi bir şeydi.Dialogue: 0,0:21:04.66,0:21:06.58,Main-207-,,0,0,0,,Gerçi yalan söylüyor gibiydi.Dialogue: 0,0:21:13.00,0:21:14.84,Main-207-,,0,0,0,,Şimdi anlıyorum...Dialogue: 0,0:21:16.00,0:21:17.88,Main-207-,,0,0,0,,Evet, senin için zor olmuştur.Dialogue: 0,0:21:18.30,0:21:22.09,Main-207-,,0,0,0,,Birinin onu geri almaya gelmesine şaşırdım.Dialogue: 0,0:21:22.64,0:21:24.68,Main-207-,,0,0,0,,Arkadaşlar, ha?Dialogue: 0,0:21:26.85,0:21:28.31,Main-207-,,0,0,0,,Hiçbir kelime...Dialogue: 0,0:21:28.98,0:21:30.19,Main-207-,,0,0,0,,onun için...Dialogue: 0,0:21:32.27,0:21:33.90,Main-207-,,0,0,0,,daha acı verici olamaz.Dialogue: 0,0:21:34.82,0:21:36.19,Main-207-,,0,0,0,,Usopp!Dialogue: 0,0:21:36.19,0:21:38.44,Main-207-,,0,0,0,,Bunu sana Nami mi yaptı?!Dialogue: 0,0:21:38.44,0:21:40.57,Main-207-,,0,0,0,,Özür dilerim. Onu biz yaptık.Dialogue: 0,0:21:40.57,0:21:42.32,Main-207-,,0,0,0,,Sen yaptın!Dialogue: 0,0:21:42.32,0:21:45.20,Main-207-,,0,0,0,,L-Luffy! Geldin mi?!Dialogue: 0,0:21:45.20,0:21:46.45,Main-207-,,0,0,0,,Evet. Yeni geldik.Dialogue: 0,0:21:46.45,0:21:48.54,Main-207-,,0,0,0,,Ben de geldim! Seni gördüğüme sevindim!Dialogue: 0,0:21:48.54,0:21:50.58,Main-207-,,0,0,0,,Bir gün seni öldüreceğim!Dialogue: 0,0:21:50.58,0:21:52.96,Main-207-,,0,0,0,,Oh! Görünüşe göre çok iyi durumdasın!Dialogue: 0,0:21:52.96,0:21:53.67,Main-207-,,0,0,0,,Kes sesini!Dialogue: 0,0:21:53.67,0:21:57.05,Main-207-,,0,0,0,,Bu arada, Nami'nin seni öldürdüğünü duyduk.Dialogue: 0,0:21:57.05,0:21:57.67,Main-207-,,0,0,0,,Ha?!Dialogue: 0,0:21:57.67,0:22:01.42,Main-207-,,0,0,0,,Lanet olası Johnny! Biliyordum!  Saçmalıyordu!Dialogue: 0,0:22:01.42,0:22:02.93,Main-207-,,0,0,0,,Hayır...Dialogue: 0,0:22:02.93,0:22:05.64,Main-207-,,0,0,0,,Aslında bir bakıma doğru.Dialogue: 0,0:22:06.01,0:22:07.72,Main-207-,,0,0,0,,Hatta tam tersi!Dialogue: 0,0:22:07.72,0:22:10.10,Main-207-,,0,0,0,,Nami hayatımı kurtardı!Dialogue: 0,0:22:10.64,0:22:15.19,Main-207-,,0,0,0,,Galiba balıkadam korsanlarının tayfasında olmasının bir sebebi var!Dialogue: 0,0:22:15.19,0:22:16.19,Main-207-,,0,0,0,,Kesinlikle.Dialogue: 0,0:22:16.19,0:22:17.57,Main-207-,,0,0,0,,Yani, şimdi ne yapacağız?Dialogue: 0,0:22:17.57,0:22:18.98,Main-207-,,0,0,0,,Arlong Park'ı mı basalım?Dialogue: 0,0:22:18.98,0:22:23.49,Main-207-,,0,0,0,,B-Bekleyin! Önce Nami'nin hikayesinin ne olduğunu öğrenmeliyiz!Dialogue: 0,0:22:23.49,0:22:25.66,Main-207-,,0,0,0,,Her iki şekilde de zaman kaybı.Dialogue: 0,0:22:24.95,0:22:25.66,Secondary-207-,,0,0,0,,Ha?Dialogue: 0,0:22:25.66,0:22:29.58,Main-207-,,0,0,0,,Ne yaparsanız yapın, Arlong'un yönetimi sona ermeyecek.Dialogue: 0,0:22:29.58,0:22:30.50,Main-207-,,0,0,0,,Nojiko!Dialogue: 0,0:22:30.87,0:22:31.87,Main-207-,,0,0,0,,Bu da kim?Dialogue: 0,0:22:31.87,0:22:32.83,Main-207-,,0,0,0,,Nami'nin ablası.Dialogue: 0,0:22:32.83,0:22:36.50,Main-207-,,0,0,0,,N-Nami-san'ın ablası mı?! Bu kadar güzel olmasını açıklıyor!Dialogue: 0,0:22:36.50,0:22:38.46,Main-207-,,0,0,0,,Ne demek "zaman kaybı"?Dialogue: 0,0:22:38.96,0:22:42.34,Main-207-,,0,0,0,,Lütfen, daha fazla bu köyün işine karışmayın.Dialogue: 0,0:22:42.34,0:22:44.13,Main-207-,,0,0,0,,Nami'yi rahat bırakın.Dialogue: 0,0:22:44.47,0:22:46.39,Main-207-,,0,0,0,,Size her şeyi açıklayacağım.Dialogue: 0,0:22:46.39,0:22:49.01,Main-207-,,0,0,0,,Duyduktan sonra adayı terk etmek isteyeceksiniz.Dialogue: 0,0:22:49.01,0:22:51.73,Main-207-,,0,0,0,,Kıyıda bir denizci gemisi mi var?!Dialogue: 0,0:22:51.73,0:22:53.85,Main-207-,,0,0,0,,16. Birliğin gemisi!Dialogue: 0,0:22:53.85,0:22:56.56,Main-207-,,0,0,0,,Belki de 77. Birliğin başına gelenlerden sonra,Dialogue: 0,0:22:56.56,0:22:58.73,Main-207-,,0,0,0,,Karargâh harekete geçmiştir!Dialogue: 0,0:23:02.15,0:23:05.74,Main-207-,,0,0,0,,Ben 16. Denizci Birliği'nden Albay Zenumi.Dialogue: 0,0:23:05.74,0:23:08.37,Main-207-,,0,0,0,,Bana Cocoyashi Köyünün muhtarı Genzo'yu getirin!Dialogue: 0,0:23:09.12,0:23:11.87,Main-207-,,0,0,0,,Ben Genzo, Albay.Dialogue: 0,0:23:11.87,0:23:13.20,Main-207-,,0,0,0,,Sensin, ha?Dialogue: 0,0:23:13.20,0:23:15.75,Main-207-,,0,0,0,,Beni Nami denen kızın evine götür.Dialogue: 0,0:23:15.75,0:23:19.54,Main-207-,,0,0,0,,Nami mi? Bu da ne demek oluyor?!Dialogue: 0,0:23:21.09,0:23:25.30,Main-207-,,0,0,0,,Sen sadece yolu göster.Dialogue: 0,0:01:50.05,0:01:53.97,Title-207-,,0,0,0,,Deniz Haritaları ve BalıkadamlarDialogue: 1,0:01:50.05,0:01:53.97,Title-207-,,0,0,0,,Deniz Haritaları ve BalıkadamlarDialogue: 0,0:09:20.08,0:09:25.00,Captions-207-,,0,0,0,,Adanın Batı Tarafı, Cocoyashi KöyüDialogue: 1,0:09:20.08,0:09:25.00,Captions-207-,,0,0,0,,Adanın Batı Tarafı, Cocoyashi KöyüDialogue: 0,0:11:16.70,0:11:21.66,Captions-207-,,0,0,0,,Chew Arlong Korsanları Yetkilisi (Öpüşen Gurami Balıkadam)Dialogue: 1,0:11:16.70,0:11:21.66,Captions-207-,,0,0,0,,Chew Arlong Korsanları Yetkilisi (Öpüşen Gurami Balıkadam)Dialogue: 0,0:11:23.58,0:11:28.54,Captions-207-,,0,0,0,,Kuroobi Arlong Korsanları Yetkilisi (Vatoz Balıkadam)Dialogue: 1,0:11:23.58,0:11:28.54,Captions-207-,,0,0,0,,Kuroobi Arlong Korsanları Yetkilisi (Vatoz Balıkadam)Dialogue: 0,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 1,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 0,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Gigglebot ZenefDialogue: 1,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Gigglebot ZenefDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,MüzikDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,MüzikDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,HaleeDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,HaleeDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,GrafikDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,GrafikDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,DatenshiDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,DatenshiDialogue: 0,0:00:06.78,0:00:10.78,Credits-207-,,0,0,0,,Kalite Ko