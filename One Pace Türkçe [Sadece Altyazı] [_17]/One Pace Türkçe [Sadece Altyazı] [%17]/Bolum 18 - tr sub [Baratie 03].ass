8,23,23,23,1Style: Lyrics-furigana,Duality,36,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,2.95,0,2,23,23,34,1Style: Lyrics,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,2,23,23,34,1Style: Karaoke,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,23,1Style: Kanji,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,146,1Style: Roger-Monologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1Style: Romaji ED,Josefin Sans,82,&H00FFFFFF,&H003592BE,&H00000000,&H64000000,0,0,0,0,100,100,0,0,1,0,4,8,10,10,20,1Style: Translation ED,Josefin Sans,82,&H00FFFFFF,&H000000FF,&H00FFFFFF,&H64000000,0,0,0,0,100,100,0,0,1,0,4,2,10,10,20,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:02:32.51,0:02:42.50,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 50,0:01:50.34,0:01:52.01,Main-207-,,0,0,0,,Kızıl Bacak Zeff.Dialogue: 50,0:01:52.63,0:01:55.14,Main-207-,,0,0,0,,Yaşıyordun demek.Dialogue: 50,0:01:55.14,0:01:59.60,Main-207-,,0,0,0,,Hem aşçılık hem de kaptanlık yapmış, rakipsiz bir korsan.Dialogue: 50,0:02:00.10,0:02:02.81,Main-207-,,0,0,0,,Yaşıyorsam ne olmuş?Dialogue: 50,0:02:02.81,0:02:05.48,Main-207-,,0,0,0,,Bu seni ilgilendirmiyor.Dialogue: 50,0:02:05.48,0:02:10.07,Main-207-,,0,0,0,,Gördüğün gibi, artık bir aşçı olarak yaşıyorum.Dialogue: 50,0:02:12.90,0:02:15.70,Main-207-,,0,0,0,,Bunu böyle söylemen kulağa hoş geliyor...Dialogue: 50,0:02:15.70,0:02:19.54,Main-207-,,0,0,0,,ama sen sadece zaman geçirmek için aşçılık yapmıyorsun,...Dialogue: 50,0:02:19.54,0:02:22.71,Main-207-,,0,0,0,,sanki yapabildiğin tek şey bu.Dialogue: 50,0:02:23.12,0:02:30.21,Main-207-,,0,0,0,,Kızıl Bacak Zeff, ellerini kullanmadan dövüşen bir tekme ustasıdır.Dialogue: 50,0:02:30.63,0:02:37.97,Main-207-,,0,0,0,,Güçlü bacaklarının kayaları parçalayıp çeliğin üstünde iz bıraktığı söylenir.Dialogue: 50,0:02:38.76,0:02:40.68,Main-207-,,0,0,0,,“Kızıl Bacak” lakabı,Dialogue: 50,0:02:40.68,0:02:46.69,Main-207-,,0,0,0,,tekmelediklerinin kanıyla kaplı, alevi andıran çizmelerinden gelir.Dialogue: 50,0:02:47.44,0:02:52.44,Main-207-,,0,0,0,,Ama görüyorum ki, o değerli bacaklarından birini kaybetmişsin.Dialogue: 50,0:02:53.49,0:02:56.20,Main-207-,,0,0,0,,Demek ki söylentiler doğruymuş.Dialogue: 50,0:02:56.20,0:02:59.53,Main-207-,,0,0,0,,Denizde böyle bir kaza yaşaman baya şanssızlık.Dialogue: 50,0:03:00.08,0:03:06.25,Main-207-,,0,0,0,,Bir bacağını kaybetmek dövüş yeteneğini de götürür sanırım.Dialogue: 50,0:03:06.58,0:03:08.92,Main-207-,,0,0,0,,Dövüşmek umurumda değil.Dialogue: 50,0:03:08.92,0:03:13.67,Main-207-,,0,0,0,,Bir bacağımı kaybettim ama ellerim olduğu sürece yemek yapabilirim.Dialogue: 50,0:03:13.67,0:03:17.47,Main-207-,,0,0,0,,Ne demek istiyorsan söyle artık.Dialogue: 50,0:03:19.14,0:03:21.18,Main-207-,,0,0,0,,Kızıl Bacak Zeff,Dialogue: 50,0:03:21.18,0:03:26.48,Main-207-,,0,0,0,,bir keresinde Grand Line'a gittin ve hiç yaralanmadan geri döndün.Dialogue: 50,0:03:26.48,0:03:32.57,Main-207-,,0,0,0,,O bir yıllık yolcuğuluktan kalma bir seyir defterin olması lazım.Dialogue: 50,0:03:32.98,0:03:34.36,Main-207-,,0,0,0,,Onu bana ver!Dialogue: 50,0:03:35.95,0:03:40.16,Main-207-,,0,0,0,,Vay, ihtiyar! Sen de mi Grand Line'a gittin?!Dialogue: 50,0:03:40.16,0:03:41.16,Main-207-,,0,0,0,,Evet...Dialogue: 50,0:03:41.99,0:03:43.66,Main-207-,,0,0,0,,Seyir defterim, ha?Dialogue: 50,0:03:43.66,0:03:47.21,Main-207-,,0,0,0,,Evet, istediğin şeye sahibim.Dialogue: 50,0:03:47.62,0:03:50.29,Main-207-,,0,0,0,,Ama onu sana vermemin imkanı yok.Dialogue: 50,0:03:51.50,0:03:56.72,Main-207-,,0,0,0,,O seyir defteri, benimle yolculuk eden herkesin onurunu taşıyor.Dialogue: 50,0:03:56.72,0:04:01.26,Main-207-,,0,0,0,,Senin gibilere fazla ağır gelir.Dialogue: 50,0:04:01.72,0:04:04.31,Main-207-,,0,0,0,,O zaman zorla almam gerekecek!Dialogue: 50,0:04:05.06,0:04:08.56,Main-207-,,0,0,0,,Grand Line'ın beni yendiğini kabul ediyorum.Dialogue: 50,0:04:08.56,0:04:12.32,Main-207-,,0,0,0,,Ama yenilgide bile, ben yılmaz Don KriegDialogue: 50,0:04:12.98,0:04:16.99,Main-207-,,0,0,0,,en tehlikeli denizleri geçebilecek güce sahiptim.Dialogue: 50,0:04:16.99,0:04:18.20,Main-207-,,0,0,0,,Adamlarım vardı.Dialogue: 50,0:04:18.20,0:04:19.66,Main-207-,,0,0,0,,Hırsım vardı.Dialogue: 50,0:04:21.49,0:04:25.41,Main-207-,,0,0,0,,Tek eksik olan şey bilgiydi.Dialogue: 50,0:04:25.87,0:04:28.12,Main-207-,,0,0,0,,Sadece neyle karşılaşacağımı bilmiyordum.Dialogue: 50,0:04:29.21,0:04:31.63,Main-207-,,0,0,0,,O seyir defteri benim olacak.Dialogue: 50,0:04:31.63,0:04:37.34,Main-207-,,0,0,0,,Onunla korsan filomu yeniden toplayıp One Piece’i ele geçireceğim.Dialogue: 50,0:04:37.76,0:04:41.14,Main-207-,,0,0,0,,Ve bu Büyük Korsan Çağı'nın en tepesine çıkacağım!Dialogue: 50,0:04:46.77,0:04:47.85,Main-207-,,0,0,0,,Dur bakalım.Dialogue: 50,0:04:48.23,0:04:50.60,Main-207-,,0,0,0,,Korsanlar Kralı olacak kişi benim!Dialogue: 50,0:04:51.60,0:04:52.27,Main-207-,,0,0,0,,Kamarot?!Dialogue: 50,0:04:53.52,0:04:56.03,Main-207-,,0,0,0,,Hey, geri dur, Kamarot!Dialogue: 50,0:04:56.03,0:04:57.90,Main-207-,,0,0,0,,Sen onun dengi değilsin!Dialogue: 50,0:04:57.90,0:05:00.61,Main-207-,,0,0,0,,Geri duramam. Bu konu da olmaz.Dialogue: 50,0:05:02.53,0:05:05.16,Main-207-,,0,0,0,,Bir şey mi söyledin, velet?Dialogue: 50,0:05:05.66,0:05:08.00,Main-207-,,0,0,0,,Demin söylediklerini görmezden geleceğim.Dialogue: 50,0:05:08.00,0:05:10.08,Main-207-,,0,0,0,,Buna gerek yok.Dialogue: 50,0:05:10.08,0:05:12.00,Main-207-,,0,0,0,,Sadece gerçeği söylüyorum.Dialogue: 50,0:05:12.79,0:05:15.00,Main-207-,,0,0,0,,Bu bir oyun değil, çocuk.Dialogue: 50,0:05:15.50,0:05:16.63,Main-207-,,0,0,0,,Haklısın.Dialogue: 50,0:05:16.63,0:05:18.97,Main-207-,,0,0,0,,Grand Line'a ben hükmedeceğim.Dialogue: 50,0:05:19.76,0:05:21.76,Main-207-,,0,0,0,,Bu iş şaka değil, velet!Dialogue: 50,0:05:21.76,0:05:23.89,Main-207-,,0,0,0,,Bilgi eksikliğimizi bir kenara koyarsak,Dialogue: 50,0:05:23.89,0:05:27.85,Main-207-,,0,0,0,,5,000 kişilik 50 gemim o acımasız denizde sadece yedi gün dayandı!Dialogue: 50,0:05:27.85,0:05:30.06,Main-207-,,0,0,0,,Senin gibi bir veledin hiç şansı yok!Dialogue: 50,0:05:30.06,0:05:32.06,Main-207-,,0,0,0,,Y-Yedi gün mü?Dialogue: 50,0:05:32.06,0:05:34.94,Main-207-,,0,0,0,,Krieg Korsanları sadece yedi gün mü dayanabildi?!Dialogue: 50,0:05:35.61,0:05:37.28,Main-207-,,0,0,0,,Onlara ne oldu böyle?!Dialogue: 50,0:05:37.86,0:05:42.03,Main-207-,,0,0,0,,Üzgünüm ama bu şekilde şaka yapılmasından nefret ediyorum.Dialogue: 50,0:05:42.53,0:05:47.49,Main-207-,,0,0,0,,Israrına devam edersen, seni burada ezip geçerim.Dialogue: 50,0:05:47.91,0:05:49.87,Main-207-,,0,0,0,,Ezebilirsen tabii.Dialogue: 50,0:05:52.50,0:05:54.33,Main-207-,,0,0,0,,Nasıl istersen.Dialogue: 50,0:05:54.33,0:05:58.38,Main-207-,,0,0,0,,İstediğin gibi, seni öbür dünyaya yollayacağım.Dialogue: 50,0:06:04.22,0:06:06.93,Main-207-,,0,0,0,,Dövüşecek misin, Luffy? Yardım lazım mı?Dialogue: 50,0:06:06.93,0:06:09.47,Main-207-,,0,0,0,,Ş-şey, yardıma gerek yoksa da olur tabii...Dialogue: 50,0:06:10.14,0:06:13.14,Main-207-,,0,0,0,,Zoro! Usopp! Burada olduğunuzu bilmiyordum!Dialogue: 50,0:06:13.14,0:06:15.23,Main-207-,,0,0,0,,İyiyim ben. Oradan izleyin sadece.Dialogue: 50,0:06:15.23,0:06:16.52,Main-207-,,0,0,0,,T-Tamam.Dialogue: 50,0:06:18.61,0:06:21.11,Main-207-,,0,0,0,,Onlar senin adamların mı?Dialogue: 50,0:06:21.69,0:06:24.16,Main-207-,,0,0,0,,Bayağı küçük bir tayfan varmış!Dialogue: 50,0:06:24.16,0:06:27.07,Main-207-,,0,0,0,,Ne diyorsun sen?! İki kişi daha var!Dialogue: 50,0:06:27.07,0:06:29.04,Main-207-,,0,0,0,,Hey! Beni de saydın, değil mi?!Dialogue: 50,0:06:30.45,0:06:32.79,Main-207-,,0,0,0,,Sizinle daha sonra ilgileneceğim.Dialogue: 50,0:06:33.33,0:06:36.29,Main-207-,,0,0,0,,Önce gidip adamlarımı beslemeliyim.Dialogue: 50,0:06:38.96,0:06:44.01,Main-207-,,0,0,0,,Canını seven, ben geri dönmeden buradan ayrılsa iyi olur.Dialogue: 50,0:06:44.76,0:06:49.18,Main-207-,,0,0,0,,Tek istediğim o seyir defteri ve bu gemi.Dialogue: 50,0:06:50.93,0:06:54.69,Main-207-,,0,0,0,,Eğer hâlâ hayatınızı önemsemiyorsanız,Dialogue: 50,0:06:54.69,0:06:57.86,Main-207-,,0,0,0,,sizi denizin dibine gömeceğim!Dialogue: 50,0:06:58.36,0:06:59.98,Main-207-,,0,0,0,,Seçiminizi yapın.Dialogue: 50,0:07:04.74,0:07:06.74,Main-207-,,0,0,0,,Çok üzgünüm, Sanji-san.Dialogue: 50,0:07:06.74,0:07:09.58,Main-207-,,0,0,0,,Bu kadar ileri gideceğini bilmiyordum.Dialogue: 50,0:07:09.58,0:07:13.41,Main-207-,,0,0,0,,Özre gerek yok, çaylak.Dialogue: 50,0:07:14.58,0:07:18.92,Main-207-,,0,0,0,,Buradaki her aşçı neyin doğru olduğunu düşündülerse onu yaptılar.Dialogue: 50,0:07:18.92,0:07:21.00,Main-207-,,0,0,0,,Hepsi bu.Dialogue: 50,0:07:21.00,0:07:22.38,Main-207-,,0,0,0,,Patron!Dialogue: 50,0:07:22.38,0:07:27.01,Main-207-,,0,0,0,,Ciddi ciddi Sanji'nin tarafını tutmuyorsun, değil mi?Dialogue: 50,0:07:27.01,0:07:28.34,Main-207-,,0,0,0,,Evet!Dialogue: 50,0:07:28.34,0:07:31.22,Main-207-,,0,0,0,,Olanların hepsi onun suçu!Dialogue: 50,0:07:31.72,0:07:34.77,Main-207-,,0,0,0,,Sizin değerli restoranınızı yok etmeye çalışıyor!Dialogue: 50,0:07:34.77,0:07:36.56,Main-207-,,0,0,0,,Susun artık, sizi lanet patlıcanlar!Dialogue: 50,0:07:37.77,0:07:43.78,Main-207-,,0,0,0,,Hiç açlıktan öleceğinizi düşündüğünüz bir an oldu mu?!Dialogue: 50,0:07:44.24,0:07:51.28,Main-207-,,0,0,0,,Bu sonsuz denizde aç ve susuz kalmanın ne denli...Dialogue: 50,0:07:51.28,0:07:54.54,Main-207-,,0,0,0,,acı ve dehşet verici olduğunu anlayabilir misiniz?!Dialogue: 50,0:07:54.54,0:07:55.41,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:07:55.41,0:07:58.04,Main-207-,,0,0,0,,N-Ne demek istiyorsunuz, Patron?!Dialogue: 50,0:07:58.04,0:08:03.55,Main-207-,,0,0,0,,Sanji’nin sizden farkı, ne demek istediğimi anlamasıdır.Dialogue: 50,0:08:05.67,0:08:08.30,Main-207-,,0,0,0,,Ben burada kalıp dövüşeceğim!Dialogue: 50,0:08:08.30,0:08:11.47,Main-207-,,0,0,0,,Öylece kaçıp gitmek için fazla sinirliyim!Dialogue: 50,0:08:11.47,0:08:15.43,Main-207-,,0,0,0,,Ben de! Burası benim çalıştığım yer!Dialogue: 50,0:08:15.43,0:08:17.81,Main-207-,,0,0,0,,Gidecek başka yerimiz yok zaten!Dialogue: 50,0:08:19.65,0:08:21.69,Main-207-,,0,0,0,,Ne yapıyorsunuz?!Dialogue: 50,0:08:21.69,0:08:24.65,Main-207-,,0,0,0,,Don'un neler yapabileceğini gördünüz!Dialogue: 50,0:08:24.65,0:08:26.15,Main-207-,,0,0,0,,Hey, Gin!Dialogue: 50,0:08:26.57,0:08:28.11,Main-207-,,0,0,0,,Sana bir şey söyleyeyim.Dialogue: 50,0:08:28.11,0:08:33.08,Main-207-,,0,0,0,,Bir aşçı olarak benim görevim, karnı aç olanları beslemektir.Dialogue: 50,0:08:33.08,0:08:33.87,Main-207-,,0,0,0,,Ama...Dialogue: 50,0:08:38.66,0:08:42.04,Main-207-,,0,0,0,,o yağmacılar, tok karınlarıyla yedikleri kaba sıçarlarsaDialogue: 50,0:08:42.79,0:08:47.63,Main-207-,,0,0,0,,korsan arkadaşlarını pataklarken sesini çıkarmayasın!Dialogue: 50,0:08:47.63,0:08:49.55,Main-207-,,0,0,0,,Eğer bu restorana el uzatırsanız...Dialogue: 50,0:08:49.88,0:08:53.26,Main-207-,,0,0,0,,bir an bile düşünmeden sizi öldürüm.Dialogue: 50,0:08:53.89,0:08:55.01,Main-207-,,0,0,0,,Anladın mı?Dialogue: 50,0:08:57.22,0:09:01.65,Main-207-,,0,0,0,,Önce kurtarıp sonra öldürmek mi?  Umutsuz vakanın tekisin, Sanji.Dialogue: 50,0:09:01.65,0:09:03.06,Main-207-,,0,0,0,,Kapa çeneni, berbat aşçı!Dialogue: 50,0:09:03.44,0:09:05.69,Main-207-,,0,0,0,,Şuna bakın! Çok havalı değil mi?!Dialogue: 50,0:09:05.69,0:09:08.11,Main-207-,,0,0,0,,O kimin umurunda?!Dialogue: 50,0:09:08.11,0:09:10.24,Main-207-,,0,0,0,,Buradan gitmemiz lazım!Dialogue: 50,0:09:10.24,0:09:11.16,Main-207-,,0,0,0,,Sakin ol!Dialogue: 50,0:09:11.70,0:09:14.66,Main-207-,,0,0,0,,Krieg olsa bile, şu anda bitik durumda.Dialogue: 50,0:09:15.66,0:09:20.33,Main-207-,,0,0,0,,Gin, Grand Line hakkında hiçbir şey bilmediğini söylemiştin ama,Dialogue: 50,0:09:20.33,0:09:22.21,Main-207-,,0,0,0,,oraya gittin, değil mi?!Dialogue: 50,0:09:23.33,0:09:25.67,Main-207-,,0,0,0,,Orası hakkında hiçbir şey bilmediğim doğru.Dialogue: 50,0:09:26.13,0:09:30.34,Main-207-,,0,0,0,,Grand Line'daki yedinci günümüzde gördüğümüz şey...Dialogue: 50,0:09:30.34,0:09:32.01,Main-207-,,0,0,0,,bir hayal de olabilir,Dialogue: 50,0:09:33.09,0:09:34.05,Main-207-,,0,0,0,,gerçek de...Dialogue: 50,0:09:35.05,0:09:38.89,Main-207-,,0,0,0,,Hala daha kafamı toparlayamıyorum.Dialogue: 50,0:09:39.85,0:09:41.64,Main-207-,,0,0,0,,İnanılmaz bir şeydi!Dialogue: 50,0:09:44.06,0:09:45.77,Main-207-,,0,0,0,,Yalnız bir adam, nasıl...Dialogue: 50,0:09:48.28,0:09:51.99,Main-207-,,0,0,0,,50 gemiden oluşan bir filoyu yok edebilir?!Dialogue: 50,0:09:56.87,0:09:59.62,Main-207-,,0,0,0,,– Ne?! – Ne?!Dialogue: 50,0:10:01.41,0:10:04.25,Main-207-,,0,0,0,,Bir anda oluverdi.Dialogue: 50,0:10:04.25,0:10:07.63,Main-207-,,0,0,0,,Biz daha onun orada olduğunu anlayamadan,Dialogue: 50,0:10:07.63,0:10:10.67,Main-207-,,0,0,0,,gemiler ardı ardına batmaya başladı.Dialogue: 50,0:10:15.01,0:10:18.51,Main-207-,,0,0,0,,O fırtına ile karşılaşmamış olsaydık,Dialogue: 50,0:10:18.51,0:10:21.81,Main-207-,,0,0,0,,ana gemimiz de aynı kader ile yüzleşecekti.Dialogue: 50,0:10:29.48,0:10:33.57,Main-207-,,0,0,0,,Kaç tane gemimizin hayatta kaldığını bilmiyorum.Dialogue: 50,0:10:33.57,0:10:38.20,Main-207-,,0,0,0,,Gerçek olduğunu kabul etmek için fazla korkunçtu.Dialogue: 50,0:10:38.20,0:10:40.16,Main-207-,,0,0,0,,Hatırlamak istemiyorum!Dialogue: 50,0:10:41.16,0:10:42.91,Main-207-,,0,0,0,,O adamı unutmak istiyorum—Dialogue: 50,0:10:42.91,0:10:46.83,Main-207-,,0,0,0,,sadece bir bakışıyla nasıl öldürebildiğini—Dialogue: 50,0:10:46.83,0:10:49.17,Main-207-,,0,0,0,,o şahin gibi bakışıyla!Dialogue: 50,0:10:49.80,0:10:50.80,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:10:50.80,0:10:51.55,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:10:52.67,0:10:54.47,Main-207-,,0,0,0,,Yoksa...?!Dialogue: 50,0:10:58.18,0:11:00.26,Main-207-,,0,0,0,,O muhtemelen...Dialogue: 50,0:11:00.68,0:11:04.02,Main-207-,,0,0,0,,Şahin Göz olarak bilinen adam.Dialogue: 50,0:11:04.02,0:11:04.89,Main-207-,,0,0,0,,Ne?Dialogue: 50,0:11:05.44,0:11:11.36,Main-207-,,0,0,0,,Sadece gözlerinin şahin gibi olması, kanıt sayılmaz.Dialogue: 50,0:11:11.36,0:11:17.49,Main-207-,,0,0,0,,Böyle bir yıkımı yaratabilecek olması, o olduğunu işaret eden güçlü bir delil.Dialogue: 50,0:11:17.95,0:11:19.83,Main-207-,,0,0,0,,Şahin gözlü adam!Dialogue: 50,0:11:19.83,0:11:22.16,Main-207-,,0,0,0,,Ha? Tanıyor musun, Zoro?Dialogue: 50,0:11:23.41,0:11:25.04,Main-207-,,0,0,0,,Evet...Dialogue: 50,0:11:25.04,0:11:27.33,Main-207-,,0,0,0,,O benim aradığım kişi.Dialogue: 50,0:11:29.42,0:11:33.34,Main-207-,,0,0,0,,O adam sizin tayfanıza karşı bir kin besliyor olmalı.Dialogue: 50,0:11:33.34,0:11:35.22,Main-207-,,0,0,0,,Onu daha önce hiç görmedim!Dialogue: 50,0:11:35.22,0:11:38.01,Main-207-,,0,0,0,,Onu uykusundan falan uyandırmışsınızdır belki de.Dialogue: 50,0:11:38.01,0:11:39.64,Main-207-,,0,0,0,,Saçmalamayın!Dialogue: 50,0:11:39.64,0:11:42.89,Main-207-,,0,0,0,,Kim böyle bir şey için bir filoyu yok eder?!Dialogue: 50,0:11:44.23,0:11:46.14,Main-207-,,0,0,0,,Bu kadar sinirlenme.Dialogue: 50,0:11:46.14,0:11:47.85,Main-207-,,0,0,0,,Ben sadece...Dialogue: 50,0:11:48.65,0:11:53.82,Main-207-,,0,0,0,,Grand Line'da böyle şeylerin mümkün olduğunu söylüyorum.Dialogue: 50,0:11:53.82,0:11:56.45,Main-207-,,0,0,0,,Ne tür bir yer orası?!Dialogue: 50,0:11:56.45,0:11:59.20,Main-207-,,0,0,0,,Her şeyin olabileceği bir yer.Dialogue: 50,0:12:00.37,0:12:03.62,Main-207-,,0,0,0,,Hey Luffy, öyle bir yere gitmemeliyiz!Dialogue: 50,0:12:03.62,0:12:05.25,Main-207-,,0,0,0,,Luffy!Dialogue: 50,0:12:08.25,0:12:10.17,Main-207-,,0,0,0,,Hey, Luffy?Dialogue: 50,0:12:10.54,0:12:13.92,Main-207-,,0,0,0,,Vay, çok heyecanlandım!Dialogue: 50,0:12:13.92,0:12:15.97,Main-207-,,0,0,0,,Öyle bir yer olduğunu biliyordum!Dialogue: 50,0:12:15.97,0:12:18.51,Main-207-,,0,0,0,,En azından ne kadar tehlikeli olduğunu kabullen!Dialogue: 50,0:12:18.51,0:12:23.26,Main-207-,,0,0,0,,Bununla beraber, artık tek hedefim kesinlikle Grand Line.Dialogue: 50,0:12:23.26,0:12:24.72,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:12:25.14,0:12:26.77,Main-207-,,0,0,0,,O adamı...Dialogue: 50,0:12:26.77,0:12:29.60,Main-207-,,0,0,0,,O adamı Grand Line'da bulacağım!Dialogue: 50,0:12:31.23,0:12:33.44,Main-207-,,0,0,0,,Delirdin mi sen?Dialogue: 50,0:12:34.15,0:12:36.61,Main-207-,,0,0,0,,Tam olarak, önden saldırıp ölecek bir tipsin.Dialogue: 50,0:12:36.99,0:12:40.45,Main-207-,,0,0,0,,Haklısın aslında, ama bana deli demekle ileri gidiyorsun.Dialogue: 50,0:12:41.57,0:12:46.41,Main-207-,,0,0,0,,Dünyanın en iyi kılıç ustası olmayı seçtiğimde zaten hayatımı çöpe attım.Dialogue: 50,0:12:46.91,0:12:51.13,Main-207-,,0,0,0,,Sadece tek bir kişi bana deli diyebilir ve o kişi de benim!Dialogue: 50,0:12:53.29,0:12:55.63,Main-207-,,0,0,0,,Evet, benim için de aynısı geçerli!Dialogue: 50,0:12:55.63,0:12:58.38,Main-207-,,0,0,0,,Aynı şekilde ben de, sonuçta denizciyim!Dialogue: 50,0:12:58.38,0:13:00.09,Main-207-,,0,0,0,,Yalan söylüyorsun.Dialogue: 50,0:13:02.55,0:13:04.31,Main-207-,,0,0,0,,Saçmalık...Dialogue: 50,0:13:07.73,0:13:09.73,Main-207-,,0,0,0,,Hey, hey!Dialogue: 50,0:13:09.73,0:13:13.73,Main-207-,,0,0,0,,Siz mankafalar burada neler döndüğünün farkında mısınız?!Dialogue: 50,0:13:13.73,0:13:20.95,Main-207-,,0,0,0,,Dışarıda, Komodor Don Krieg’in filosuna ait devasa bir kalyon var!Dialogue: 50,0:13:20.95,0:13:25.03,Main-207-,,0,0,0,,Bu savaş bittiğinde istediğiniz hayali kurabilirsiniz!Dialogue: 50,0:13:34.17,0:13:36.55,Main-207-,,0,0,0,,– Kurtulduk! – Kurtulduk!Dialogue: 50,0:13:36.55,0:13:38.30,Main-207-,,0,0,0,,Bu harika! Yaşayacağız!Dialogue: 50,0:13:38.30,0:13:39.84,Main-207-,,0,0,0,,Sanki bir rüya gibi!Dialogue: 50,0:13:39.84,0:13:42.51,Main-207-,,0,0,0,,Bu kabustan kurtulduk!Dialogue: 50,0:13:42.51,0:13:46.97,Main-207-,,0,0,0,,Korsan Mezarlığı'ndan canlı çıktık!Dialogue: 50,0:13:49.06,0:13:50.14,Main-207-,,0,0,0,,Bu doğru...Dialogue: 50,0:13:50.89,0:13:55.23,Main-207-,,0,0,0,,Gözlerimizi bir kez daha Grand Line'a dikebiliriz.Dialogue: 50,0:13:57.90,0:13:59.36,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:13:59.36,0:14:00.99,Main-207-,,0,0,0,,Bu bakışlar da ne?Dialogue: 50,0:14:01.57,0:14:03.91,Main-207-,,0,0,0,,O-Oraya geri mi döneceğiz?!Dialogue: 50,0:14:09.83,0:14:13.58,Main-207-,,0,0,0,,Başka itirazı olan var mı?Dialogue: 50,0:14:25.55,0:14:26.80,Main-207-,,0,0,0,,İlk olarak,Dialogue: 50,0:14:27.35,0:14:32.52,Main-207-,,0,0,0,,bu tamir edilemez gemiyi terk edip o restoranı ele geçireceğiz.Dialogue: 50,0:14:32.52,0:14:35.69,Main-207-,,0,0,0,,Çalışanları bir grup haydutumsu aşçıdan ibaret.Dialogue: 50,0:14:35.69,0:14:38.27,Main-207-,,0,0,0,,Bize karşı hiç şansları yok.Dialogue: 50,0:14:44.49,0:14:45.78,Main-207-,,0,0,0,,Saldırın!Dialogue: 50,0:14:51.25,0:14:53.71,Main-207-,,0,0,0,,Geliyorlar! Bağırışlarını duyabiliyorum!Dialogue: 50,0:14:53.71,0:14:57.75,Main-207-,,0,0,0,,Onları uzak tutun! Bu gemi bizim restoranımız!Dialogue: 50,0:15:01.38,0:15:03.13,Main-207-,,0,0,0,,Yolu açın, sizi pislikler!Dialogue: 50,0:15:19.65,0:15:20.52,Main-207-,,0,0,0,,O da neydi?!Dialogue: 50,0:15:21.86,0:15:23.36,Main-207-,,0,0,0,,Ne oldu?!Dialogue: 50,0:15:23.36,0:15:25.32,Main-207-,,0,0,0,,Don Krieg!Dialogue: 50,0:15:25.32,0:15:27.28,Main-207-,,0,0,0,,Ana gemimiz...Dialogue: 50,0:15:27.28,0:15:29.28,Main-207-,,0,0,0,,ikiye bölündü!Dialogue: 50,0:15:29.28,0:15:32.04,Main-207-,,0,0,0,,İkiye mi bölündü?! Doğru mu duydum?!Dialogue: 50,0:15:32.04,0:15:34.79,Main-207-,,0,0,0,,Bizim devasa kalyon mu?!Dialogue: 50,0:15:34.79,0:15:35.91,Main-207-,,0,0,0,,Böylesi...Dialogue: 50,0:15:36.50,0:15:40.75,Main-207-,,0,0,0,,imkansız bir şey nasıl olabilir?!Dialogue: 50,0:15:43.96,0:15:45.72,Main-207-,,0,0,0,,Demir atın!Dialogue: 50,0:15:45.72,0:15:47.97,Main-207-,,0,0,0,,Bütün gemiyi yok edecek!Dialogue: 50,0:15:47.97,0:15:48.93,Main-207-,,0,0,0,,Emredersiniz!Dialogue: 50,0:15:51.43,0:15:52.43,Main-207-,,0,0,0,,Hiç iyi değil!Dialogue: 50,0:15:52.43,0:15:55.39,Main-207-,,0,0,0,,Nami, Yosaku ve Johnny ön taraftaki gemide!Dialogue: 50,0:15:56.48,0:15:59.06,Main-207-,,0,0,0,,Kahretsin! Muhtemelen çoktan geç kaldık!Dialogue: 50,0:16:07.86,0:16:09.95,Main-207-,,0,0,0,,Abi!Dialogue: 50,0:16:09.95,0:16:11.41,Main-207-,,0,0,0,,Abi!Dialogue: 50,0:16:11.41,0:16:14.41,Main-207-,,0,0,0,,Yosaku! Johnny!Dialogue: 50,0:16:14.41,0:16:15.41,Main-207-,,0,0,0,,İyi misiniz?Dialogue: 50,0:16:15.79,0:16:18.54,Main-207-,,0,0,0,,Gemi nerede?! Gitmiş! Nami'ye ne oldu?!Dialogue: 50,0:16:18.54,0:16:19.79,Main-207-,,0,0,0,,Şey...Dialogue: 50,0:16:19.79,0:16:23.05,Main-207-,,0,0,0,,Üzgünüm, abi! O çoktan gitti!Dialogue: 50,0:16:23.05,0:16:26.05,Flashbacks-207-,,0,0,0,,Görüşürüz! Luffy ve diğerlerine şöyle söyleyin...Dialogue: 50,0:16:26.05,0:16:27.55,Main-207-,,0,0,0,,Nami Abla...!Dialogue: 50,0:16:27.55,0:16:30.14,Flashbacks-207-,,0,0,0,,"Kaderde varsa, yine karşılaşırız."Dialogue: 50,0:16:30.93,0:16:34.89,Main-207-,,0,0,0,,Tüm hazineyi aldı ve kaçtı!Dialogue: 50,0:16:34.89,0:16:36.10,Main-207-,,0,0,0,,– N...?! – N...?!Dialogue: 50,0:16:36.10,0:16:38.23,Main-207-,,0,0,0,,– Ne dedin?! – Ne dedin?!Dialogue: 50,0:16:50.49,0:16:52.16,Main-207-,,0,0,0,,O adam...Dialogue: 50,0:17:09.84,0:17:10.84,Main-207-,,0,0,0,,Ne diyorsunuz siz?!Dialogue: 50,0:17:10.84,0:17:14.10,Main-207-,,0,0,0,,Nami Going Merry'yi alıp kaçtı mı?!Dialogue: 50,0:17:14.10,0:17:16.39,Main-207-,,0,0,0,,Ne yaptığını sanıyor ki?!Dialogue: 50,0:17:22.06,0:17:25.11,Main-207-,,0,0,0,,Daha az önce oldu!Dialogue: 50,0:17:29.24,0:17:31.49,Main-207-,,0,0,0,,Bir sorun mu var, Nami Abla?Dialogue: 50,0:17:31.49,0:17:32.07,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:17:32.66,0:17:35.20,Main-207-,,0,0,0,,Bu posterlere bakıyorsun da.Dialogue: 50,0:17:35.20,0:17:37.20,Main-207-,,0,0,0,,Ah... Hiçbir şey...Dialogue: 50,0:17:37.20,0:17:39.45,Main-207-,,0,0,0,,Her zamanki gibi etkileyicisin.Dialogue: 50,0:17:39.87,0:17:42.58,Main-207-,,0,0,0,,Görüyorum ki büyük bir ödül dikkatini çekmiş.Dialogue: 50,0:17:42.58,0:17:46.46,Main-207-,,0,0,0,,Ama Arlong, peşinden gitmemen gereken bir korsan.Dialogue: 50,0:17:46.46,0:17:48.55,Main-207-,,0,0,0,,Acayip güçlü olduğunu söylüyorlar.Dialogue: 50,0:17:48.55,0:17:55.60,Main-207-,,0,0,0,,Uzun süre sessiz sedasız takılıyordu, şimdi tekrar fırtına koparıyor.Dialogue: 50,0:17:55.97,0:17:59.52,Main-207-,,0,0,0,,Ama o 20 milyon beli'lik ödülden vazgeçmek de zor tabii.Dialogue: 50,0:17:59.52,0:18:05.73,Main-207-,,0,0,0,,Bu adam o kadar güçlü ki, savaşsak ölümle burun buruna geliriz.Dialogue: 50,0:18:06.32,0:18:07.02,Main-207-,,0,0,0,,– Ha? – Ha?Dialogue: 50,0:18:07.40,0:18:08.44,Main-207-,,0,0,0,,Nami Abla?Dialogue: 50,0:18:10.07,0:18:14.28,Main-207-,,0,0,0,,Affedersiniz, üzerimi değiştireceğim, arkanızı döner misiniz?Dialogue: 50,0:18:14.28,0:18:15.28,Main-207-,,0,0,0,,– Ne?! – Ne?!Dialogue: 50,0:18:15.28,0:18:16.91,Main-207-,,0,0,0,,Ş-Şey...Dialogue: 50,0:18:16.91,0:18:18.24,Main-207-,,0,0,0,,Değiştirmek? Burada? Şimdi?!Dialogue: 50,0:18:18.79,0:18:20.45,Main-207-,,0,0,0,,Sakıncası yoksa.Dialogue: 50,0:18:21.08,0:18:22.79,Main-207-,,0,0,0,,– Devam edin, lütfen! – Devam edin, lütfen!Dialogue: 50,0:18:27.75,0:18:30.76,Main-207-,,0,0,0,,Gerçekten de göründüğü kadar cesur!Dialogue: 50,0:18:30.76,0:18:33.68,Main-207-,,0,0,0,,Bir göz atmaktan zarar gelmez, değil mi?Dialogue: 50,0:18:33.68,0:18:34.47,Main-207-,,0,0,0,,Hiç olmaz!Dialogue: 50,0:18:41.81,0:18:43.60,Main-207-,,0,0,0,,N-Ne yapıyorsun?!Dialogue: 50,0:18:44.73,0:18:46.94,Main-207-,,0,0,0,,Ne mi yapıyorum? İş, tabii ki!Dialogue: 50,0:18:46.94,0:18:49.07,Main-207-,,0,0,0,,Ben korsanlardan çalan bir hırsızım.Dialogue: 50,0:18:49.07,0:18:50.73,Main-207-,,0,0,0,,Bu gemiyi alıyorum.Dialogue: 50,0:18:51.69,0:18:54.82,Main-207-,,0,0,0,,Tayfadan biri olduğumu asla söylemedim.Dialogue: 50,0:18:54.82,0:18:56.28,Main-207-,,0,0,0,,Sadece bir ittifaktı.Dialogue: 50,0:18:56.28,0:19:01.04,Main-207-,,0,0,0,,Luffy ve diğerleriyle kısa bir zaman geçirdim ama çok eğlendim.Dialogue: 50,0:19:01.91,0:19:03.54,Main-207-,,0,0,0,,Onlara şöyle söyleyin:Dialogue: 50,0:19:04.41,0:19:07.29,Main-207-,,0,0,0,,"Kaderde varsa, yine karşılaşırız."Dialogue: 50,0:19:08.54,0:19:10.46,Main-207-,,0,0,0,,Nami Abla!Dialogue: 50,0:19:17.84,0:19:20.18,Main-207-,,0,0,0,,D-Dur! Bunu yapamazsın!Dialogue: 50,0:19:20.18,0:19:25.06,Main-207-,,0,0,0,,Bizden gemiye göz kulak olmamız söylenmişti!Dialogue: 50,0:19:30.40,0:19:33.74,Main-207-,,0,0,0,,Ve işte gemiyi böyle aldı...Dialogue: 50,0:19:33.74,0:19:34.57,Main-207-,,0,0,0,,Üzgünüz!Dialogue: 50,0:19:34.57,0:19:35.40,Main-207-,,0,0,0,,Kahretsin!Dialogue: 50,0:19:35.40,0:19:38.78,Main-207-,,0,0,0,,Bizim için bu krizi daha da kötü hale getirdi!Dialogue: 50,0:19:38.78,0:19:41.12,Main-207-,,0,0,0,,Bize o gemiyi Kaya vermişti!Dialogue: 50,0:19:41.12,0:19:43.08,Main-207-,,0,0,0,,Bekle! Onu hala görebiliyorum!Dialogue: 50,0:19:43.08,0:19:45.04,Main-207-,,0,0,0,,Bu Going Merry!Dialogue: 50,0:19:45.41,0:19:46.79,Main-207-,,0,0,0,,Sizin geminiz nerede?Dialogue: 50,0:19:46.79,0:19:48.38,Main-207-,,0,0,0,,Hala burada duruyor...Dialogue: 50,0:19:49.00,0:19:50.63,Main-207-,,0,0,0,,Zoro! Usopp! Hemen gidin!Dialogue: 50,0:19:50.63,0:19:52.59,Main-207-,,0,0,0,,O gemiye binin ve Nami'yi takip edin!Dialogue: 50,0:19:52.59,0:19:55.42,Main-207-,,0,0,0,,Unut gitsin. Bırak gemiyi alsın.Dialogue: 50,0:19:55.42,0:19:58.14,Main-207-,,0,0,0,,O kadının arkasından gitmeye gerek yok.Dialogue: 50,0:19:58.14,0:20:01.01,Main-207-,,0,0,0,,Başka kimseyi rotacımız istemiyorum!Dialogue: 50,0:20:03.43,0:20:06.94,Main-207-,,0,0,0,,Tamam, nasıl istiyorsan... Ne zahmetli kaptansın ama!Dialogue: 50,0:20:07.52,0:20:08.69,Main-207-,,0,0,0,,Hey, Usopp! Gidelim!Dialogue: 50,0:20:08.69,0:20:10.23,Main-207-,,0,0,0,,T-Tamam...Dialogue: 50,0:20:12.27,0:20:14.82,Main-207-,,0,0,0,,– Zoro abi, gemi hazır! – Zoro abi, gemi hazır!Dialogue: 50,0:20:15.19,0:20:16.57,Main-207-,,0,0,0,,Luffy, peki sen?Dialogue: 50,0:20:16.57,0:20:20.82,Main-207-,,0,0,0,,Bu restorandaki işim henüz bitmediği için ayrılamam.Dialogue: 50,0:20:20.82,0:20:22.28,Main-207-,,0,0,0,,Dikkatli ol.Dialogue: 50,0:20:22.28,0:20:24.62,Main-207-,,0,0,0,,Buradaki durum hiç normal değil.Dialogue: 50,0:20:24.62,0:20:26.58,Main-207-,,0,0,0,,Evet, biliyorum.Dialogue: 50,0:20:26.58,0:20:29.50,Main-207-,,0,0,0,,Gemi ikiye bölündü!Dialogue: 50,0:20:30.38,0:20:31.71,Main-207-,,0,0,0,,Şuna bak!Dialogue: 50,0:20:32.38,0:20:33.80,Main-207-,,0,0,0,,B-B-Bu o!Dialogue: 50,0:20:38.93,0:20:42.10,Main-207-,,0,0,0,,Don Krieg! Bu o!Dialogue: 50,0:20:42.10,0:20:45.47,Main-207-,,0,0,0,,Bu filomuzu yok eden adam!Dialogue: 50,0:20:48.52,0:20:51.06,Main-207-,,0,0,0,,O-O adam...Dialogue: 50,0:20:59.82,0:21:01.36,Main-207-,,0,0,0,,Yani o adam...Dialogue: 50,0:21:03.07,0:21:05.66,Main-207-,,0,0,0,,Şu lanet uyuz köpek!Dialogue: 50,0:21:06.33,0:21:08.37,Main-207-,,0,0,0,,Bizi öldürmek için...Dialogue: 50,0:21:08.37,0:21:10.46,Main-207-,,0,0,0,,buraya kadar takip etmiş!Dialogue: 50,0:21:10.92,0:21:12.63,Main-207-,,0,0,0,,Hapı yuttuk!Dialogue: 50,0:21:13.38,0:21:14.25,Main-207-,,0,0,0,,Zoro?Dialogue: 50,0:21:14.84,0:21:16.21,Main-207-,,0,0,0,,O da kim?Dialogue: 50,0:21:16.92,0:21:19.42,Main-207-,,0,0,0,,Aradığım kişi.Dialogue: 50,0:21:19.93,0:21:21.84,Main-207-,,0,0,0,,Şahin Göz Mihawk!Dialogue: 50,0:21:22.76,0:21:25.01,Main-207-,,0,0,0,,Şahin Göz Mihawk...Dialogue: 50,0:21:31.35,0:21:33.36,Main-207-,,0,0,0,,Dünyadaki en güçlü adam...Dialogue: 50,0:21:35.32,0:21:41.91,Main-207-,,0,0,0,,Grand Line'da Krieg'in elli gemisini kendi başına batıran adam o mu?Dialogue: 50,0:21:41.91,0:21:45.62,Main-207-,,0,0,0,,O zaman Krieg'in gemisini yok eden de o olmalı.Dialogue: 50,0:21:45.62,0:21:49.41,Main-207-,,0,0,0,,Ama sıradan biri gibi görünüyor!Dialogue: 50,0:21:49.41,0:21:52.42,Main-207-,,0,0,0,,Hiçbir özel silahı da yok gibi gözüküyor.Dialogue: 50,0:21:53.04,0:21:54.92,Main-207-,,0,0,0,,Silahı sırtında duruyor...Dialogue: 50,0:21:54.92,0:21:57.34,Main-207-,,0,0,0,,Şaka yapıyorsun!Dialogue: 50,0:21:57.34,0:22:01.22,Main-207-,,0,0,0,,Cidden o kocaman gemiyi sırtındaki o kılıçla mı doğradı?Dialogue: 50,0:22:01.72,0:22:04.85,Main-207-,,0,0,0,,O kılıç ustalarının efendisi Şahin Göz,Dialogue: 50,0:22:04.85,0:22:08.68,Main-207-,,0,0,0,,kılıç ustalarının en tepesinde yer alan adam.Dialogue: 50,0:22:13.27,0:22:15.27,Main-207-,,0,0,0,,S-Seni orospu çocuğu...Dialogue: 50,0:22:15.77,0:22:18.78,Main-207-,,0,0,0,,Nasıl bir nefret ki bu, hâlâ peşimizdesin?Dialogue: 50,0:22:20.11,0:22:21.44,Main-207-,,0,0,0,,Zaman öldürüyorum.Dialogue: 50,0:22:21.44,0:22:25.37,Main-207-,,0,0,0,,Ne...?! Bizimle dalga geçme!Dialogue: 50,0:22:34.96,0:22:36.21,Main-207-,,0,0,0,,N-Ne?!Dialogue: 50,0:22:36.59,0:22:38.38,Main-207-,,0,0,0,,Direkt ona nişan aldığıma eminim!Dialogue: 50,0:22:38.38,0:22:39.71,Main-207-,,0,0,0,,Sektirdi.Dialogue: 50,0:22:40.46,0:22:43.72,Main-207-,,0,0,0,,Kılıcının ucuyla yönlerini sakince değiştirdi.Dialogue: 50,0:22:44.18,0:22:45.55,Main-207-,,0,0,0,,Bu saçmalık!Dialogue: 50,0:22:46.72,0:22:49.10,Main-207-,,0,0,0,,H-Hey! Sen de kimsin?!Dialogue: 50,0:22:49.43,0:22:53.14,Main-207-,,0,0,0,,Daha önce kılıcını bu kadar hassas kullanan birini görmemiştim.Dialogue: 50,0:22:53.81,0:22:56.69,Main-207-,,0,0,0,,Kuvvete dayalı bir kılıç darbesi güç barındırmaz.Dialogue: 50,0:22:57.23,0:23:00.19,Main-207-,,0,0,0,,Bu gemiyi de o kılıçla mı doğradın?Dialogue: 50,0:23:00.19,0:23:01.65,Main-207-,,0,0,0,,Doğru.Dialogue: 50,0:23:01.65,0:23:03.07,Main-207-,,0,0,0,,Anlıyorum...Dialogue: 50,0:23:03.53,0:23:04.82,Main-207-,,0,0,0,,Sen en iyisin...Dialogue: 50,0:23:04.82,0:23:07.70,Main-207-,,0,0,0,,Üç katana var... Yoksa o...?!Dialogue: 50,0:23:07.70,0:23:11.16,Main-207-,,0,0,0,,Seninle tanışmak için denize açıldım.Dialogue: 50,0:23:11.16,0:23:12.83,Main-207-,,0,0,0,,Amacın ne?Dialogue: 50,0:23:12.83,0:23:14.29,Main-207-,,0,0,0,,En iyisi olmak!Dialogue: 50,0:23:15.58,0:23:17.08,Main-207-,,0,0,0,,Ne kadar aptalca...Dialogue: 50,0:23:34.35,0:23:36.31,Main-207-,,0,0,0,,İyi insanlardı...Dialogue: 50,0:23:36.31,0:23:40.73,Main-207-,,0,0,0,,Bir daha karşılaşırsak, onlara katılmama izin verirler mi ki?Dialogue: 50,0:23:42.44,0:23:44.65,Main-207-,,0,0,0,,Yine karşılaşacak mıyız acaba?Dialogue: 50,0:23:46.28,0:23:48.82,Main-207-,,0,0,0,,Özgür olmak istiyorum...Dialogue: 50,0:23:51.12,0:23:52.99,Main-207-,,0,0,0,,Bell-mère-san...Dialogue: 50,0:23:57.42,0:24:00.29,Main-207-,,0,0,0,,Zamanın var, değil mi? Hadi dövüşelim!Dialogue: 50,0:24:00.29,0:24:03.46,Main-207-,,0,0,0,,B-Bu adam... Zoro!Dialogue: 50,0:24:03.46,0:24:05.67,Main-207-,,0,0,0,,Üç-kılıç stili kullanan Roronoa Zoro!Dialogue: 50,0:24:05.67,0:24:06.63,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:24:07.88,0:24:09.26,Main-207-,,0,0,0,,Korsan Avcısı, ha?Dialogue: 50,0:24:10.14,0:24:11.68,Main-207-,,0,0,0,,O mu?!Dialogue: 50,0:24:14.89,0:24:16.89,Main-207-,,0,0,0,,Hey, bu hiç iyi değil, Luffy!Dialogue: 50,0:24:16.89,0:24:19.44,Main-207-,,0,0,0,,Going Merry yakında görüşümüzden çıkacak!Dialogue: 50,0:24:19.44,0:24:20.90,Main-207-,,0,0,0,,Hey, Luffy!Dialogue: 50,0:24:21.27,0:24:22.57,Main-207-,,0,0,0,,Dövüş mü?Dialogue: 50,0:24:23.69,0:24:26.07,Main-207-,,0,0,0,,Sana acıyorum, zayıf olan.Dialogue: 50,0:24:30.53,0:24:32.37,Main-207-,,0,0,0,,Eğer yetkin bir kılıç ustasıysan,Dialogue: 50,0:24:32.37,0:24:37.41,Main-207-,,0,0,0,,Kılıçlarımızı çekmeden yetenek farkını görebilmen gerekir.Dialogue: 50,0:24:37.79,0:24:40.67,Main-207-,,0,0,0,,Kılıcını bana doğrultmanın sebebi ne?Dialogue: 50,0:24:40.67,0:24:44.50,Main-207-,,0,0,0,,Cesaretin mi, yoksa cehaletin mi?Dialogue: 50,0:24:44.50,0:24:46.76,Main-207-,,0,0,0,,Hırsım!Dialogue: 50,0:24:49.38,0:24:52.39,Main-207-,,0,0,0,,Ve değerli bir arkadaşıma verdiğim söz.Dialogue: 50,0:24:52.39,0:24:56.02,Main-207-,,0,0,0,,D-Dünyanın en iyi kılıç ustası, Şahin Göz Mihawk...Dialogue: 50,0:24:56.02,0:24:58.06,Main-207-,,0,0,0,,ve Korsan Avcısı Zoro...Dialogue: 50,0:24:58.06,0:25:00.65,Main-207-,,0,0,0,,Ne tür bir dövüş olacak acaba?Dialogue: 50,0:25:01.06,0:25:03.65,Main-207-,,0,0,0,,Abiyi yenebilecek birinin olmasının imkanı yok!Dialogue: 50,0:25:03.65,0:25:04.40,Main-207-,,0,0,0,,E-Evet!Dialogue: 50,0:25:04.73,0:25:06.86,Main-207-,,0,0,0,,Abi zaten en güçlü olan!Dialogue: 50,0:25:11.11,0:25:13.99,Main-207-,,0,0,0,,Hey, bu da ne demek oluyor?Dialogue: 50,0:25:14.49,0:25:18.96,Main-207-,,0,0,0,,Tavşan avlamak için top kullanan bir ahmak değilim.Dialogue: 50,0:25:18.96,0:25:22.17,Main-207-,,0,0,0,,Ünlü bir kılıç ustası olsan bile,Dialogue: 50,0:25:22.17,0:25:27.92,Main-207-,,0,0,0,,bu deniz, Doğu Mavi, dört deniz arasından en güçsüzüdür.Dialogue: 50,0:25:28.38,0:25:32.26,Main-207-,,0,0,0,,Ne yazık ki, yanımda bundan daha küçük bir kılıç yok.Dialogue: 50,0:25:32.26,0:25:35.81,Main-207-,,0,0,0,,Bu kadar dalga geçtiğin yeter!Dialogue: 50,0:25:35.81,0:25:38.10,Main-207-,,0,0,0,,Seni öldürdüğümde pişman olmazsan iyi olur!Dialogue: 50,0:25:38.10,0:25:39.48,Main-207-,,0,0,0,,Kuyudaki kurbağa...Dialogue: 50,0:25:39.48,0:25:41.44,Main-207-,,0,0,0,,dünyanın büyüklüğünü kavra.Dialogue: 50,0:25:41.44,0:25:43.35,Main-207-,,0,0,0,,Şeytan Kesişi!Dialogue: 50,0:25:46.57,0:25:48.61,Main-207-,,0,0,0,,N-Ne?!Dialogue: 50,0:25:53.91,0:25:55.08,Main-207-,,0,0,0,,Zoro?!Dialogue: 50,0:25:55.45,0:25:58.58,Main-207-,,0,0,0,,Ne...?  Abi'nin "Şeytan Kesişi"ni durdurdu!Dialogue: 50,0:25:58.58,0:26:02.04,Main-207-,,0,0,0,,O teknik düşmanları her seferinde savurur, fakat...!Dialogue: 50,0:26:02.04,0:26:03.79,Main-207-,,0,0,0,,Neler oluyor?!Dialogue: 50,0:26:04.33,0:26:08.25,Thoughts-207-,,0,0,0,,O... Onları hareket ettiremiyorum! Ne yaptı o öyle?!Dialogue: 50,0:26:08.25,0:26:12.51,Thoughts-207-,,0,0,0,,Bu teknikten kurtulan olmamıştı, ama o bir oyuncakla engelledi mi?!Dialogue: 50,0:26:13.01,0:26:15.47,Thoughts-207-,,0,0,0,,Bu... olamaz!Dialogue: 50,0:26:16.64,0:26:19.06,Thoughts-207-,,0,0,0,,Yeteneklerimiz arasında bu kadar mı fark var?!Dialogue: 50,0:26:19.06,0:26:22.06,Thoughts-207-,,0,0,0,,Böyle bir şey olamaz! Bu kadar mesafe olması imkansız.Dialogue: 50,0:26:24.56,0:26:27.19,Main-207-,,0,0,0,,Dünyanın en güçlüsü bu kadar önde olamaz!Dialogue: 50,0:26:35.12,0:26:37.99,Main-207-,,0,0,0,,Bu doğru olamaz, değil mi, abi?! Ciddileş artık!Dialogue: 50,0:26:37.99,0:26:39.70,Main-207-,,0,0,0,,Abi!Dialogue: 50,0:26:39.70,0:26:42.08,Main-207-,,0,0,0,,Aramızda bu kadar mesafe olamaz!Dialogue: 50,0:26:56.05,0:26:58.14,Main-207-,,0,0,0,,Ne kadar vahşi bir kılıç kullanımı.Dialogue: 50,0:27:05.31,0:27:09.48,Main-207-,,0,0,0,,Zoro'nun üç-kılıç stili saldırılarını o küçük bıçak ile karşılıyor.Dialogue: 50,0:27:09.48,0:27:12.36,Main-207-,,0,0,0,,Canavar Zoro'nun bile ötesinde bir canavarlıkta!Dialogue: 50,0:27:12.36,0:27:13.86,Thoughts-207-,,0,0,0,,Ben...Dialogue: 50,0:27:13.86,0:27:18.70,Thoughts-207-,,0,0,0,,Kılıç ustalığını böyle bir oyuncağa heba etmek için öğrenmedim!Dialogue: 50,0:27:24.16,0:27:27.38,Flashbacks-207-,,0,0,0,,Zoro, çok şanslısın. Sen bir erkeksin.Dialogue: 50,0:27:27.88,0:27:31.67,Flashbacks-207-,,0,0,0,,Ben de dünyanın en iyi kılıç ustası olmak istiyorum!Dialogue: 50,0:27:32.17,0:27:33.88,Flashbacks-207-,,0,0,0,,Söz ver bana!Dialogue: 50,0:27:33.88,0:27:38.55,Flashbacks-207-,,0,0,0,,Bir gün, birimiz dünyanın en iyi kılıç ustası olacak!Dialogue: 50,0:27:38.55,0:27:39.68,Flashbacks-207-,,0,0,0,,Söz ver!Dialogue: 50,0:27:40.93,0:27:41.93,Flashbacks-207-,,0,0,0,,– Söz! – Söz!Dialogue: 50,0:27:47.48,0:27:49.94,Thoughts-207-,,0,0,0,,Dünyanın en iyisi olmak için!Dialogue: 50,0:27:59.66,0:28:04.16,Flashbacks-207-,,0,0,0,,Ben... Onun için de güçleneceğim!Dialogue: 50,0:28:04.16,0:28:06.83,Flashbacks-207-,,0,0,0,,Adım cennete ulaşacak kadar güçlü olacağım!Dialogue: 50,0:28:06.83,0:28:10.29,Flashbacks-207-,,0,0,0,,Dünyanın en iyi kılıç ustası olacağım!Dialogue: 50,0:28:10.88,0:28:12.67,Flashbacks-207-,,0,0,0,,Ona söz verdim...Dialogue: 50,0:28:12.67,0:28:14.09,Flashbacks-207-,,0,0,0,,Ben...Dialogue: 50,0:28:23.35,0:28:26.10,Thoughts-207-,,0,0,0,,Her şeyi bu adamı yenmek için yaptım.Dialogue: 50,0:28:31.65,0:28:32.98,Main-207-,,0,0,0,,Omzundaki yük nedir?Dialogue: 50,0:28:32.98,0:28:37.28,Main-207-,,0,0,0,,Güç kazandığında ne yapmayı arzuluyorsun, zayıf olan?Dialogue: 50,0:28:37.36,0:28:41.41,Flashbacks-207-,,0,0,0,,Yeteneğin çok etkileyici. Sana katılabilir miyiz?Dialogue: 50,0:28:41.41,0:28:45.45,Flashbacks-207-,,0,0,0,,Biz ödül avcılarıyız, kanını donduracak kadar korkutucu...Dialogue: 50,0:28:45.45,0:28:47.16,Flashbacks-207-,,0,0,0,,Yosaku ve Johnny'yiz.Dialogue: 50,0:28:47.54,0:28:50.42,Main-207-,,0,0,0,,Abi'ye zayıf mı dedin? Seni haçlı pislik!Dialogue: 50,0:28:50.42,0:28:52.96,Main-207-,,0,0,0,,Sana terbiye dersi vereceğiz!Dialogue: 50,0:28:52.96,0:28:55.84,Main-207-,,0,0,0,,Kesin şunu, Yosaku ve Johnny! Ayak bağı olmayın!Dialogue: 50,0:28:56.30,0:28:58.93,Main-207-,,0,0,0,,Sabırlı... olun...!Dialogue: 50,0:29:00.80,0:29:02.55,Main-207-,,0,0,0,,Luffy...Dialogue: 50,0:29:03.85,0:29:07.02,Main-207-,,0,0,0,,Ben... kaybedemem...Dialogue: 50,0:29:18.82,0:29:19.95,Main-207-,,0,0,0,,Kaplan...Dialogue: 50,0:29:19.95,0:29:20.91,Flashbacks-207-,,0,0,0,,Harika!Dialogue: 50,0:29:20.91,0:29:22.78,Flashbacks-207-,,0,0,0,,Dünyanın en iyi kılıç ustası!Dialogue: 50,0:29:22.78,0:29:26.41,Flashbacks-207-,,0,0,0,,Korsanlar kralının mürettebatında daha azı olamaz zaten!Dialogue: 50,0:29:26.41,0:29:27.50,Main-207-,,0,0,0,,Avı!Dialogue: 50,0:29:48.60,0:29:51.52,Main-207-,,0,0,0,,Öylece kalbini deşmeme izin mi vereceksin?Dialogue: 50,0:29:51.52,0:29:53.27,Main-207-,,0,0,0,,Neden geri çekilmiyorsun?Dialogue: 50,0:29:53.86,0:29:56.11,Main-207-,,0,0,0,,Neden bilmiyorum, ama...Dialogue: 50,0:29:56.65,0:29:58.74,Main-207-,,0,0,0,,eğer bir adım bile geri çekilirsem,Dialogue: 50,0:29:58.74,0:30:05.24,Main-207-,,0,0,0,,geçmişteki sözler ve yeminler gibi önemli birçok şey parçalanacak,Dialogue: 50,0:30:05.24,0:30:08.70,Main-207-,,0,0,0,,ve şu anda bulunduğum konuma geri gelemeyeceğim.Dialogue: 50,0:30:10.00,0:30:12.12,Main-207-,,0,0,0,,Evet, yenilgi böyle bir şeydir.Dialogue: 50,0:30:13.25,0:30:15.54,Main-207-,,0,0,0,,O zaman çekilmemem için bir sebep daha.Dialogue: 50,0:30:16.34,0:30:17.88,Main-207-,,0,0,0,,Ölsen bile mi?Dialogue: 50,0:30:18.67,0:30:20.92,Main-207-,,0,0,0,,Ölmeyi yeğlerim.Dialogue: 50,0:30:21.47,0:30:24.01,Thoughts-207-,,0,0,0,,Ne güçlü bir yürek!Dialogue: 50,0:30:24.01,0:30:26.72,Thoughts-207-,,0,0,0,,Ölmeyi yenilgiye tercih ediyor!Dialogue: 50,0:30:29.77,0:30:31.77,Main-207-,,0,0,0,,Çocuk! Adını bahşet.Dialogue: 50,0:30:36.23,0:30:38.23,Main-207-,,0,0,0,,Roronoa Zoro.Dialogue: 50,0:30:39.07,0:30:40.49,Main-207-,,0,0,0,,Bunu hatırlayacağım.Dialogue: 50,0:30:40.49,0:30:43.45,Main-207-,,0,0,0,,Uzun süre senin gibisini görmedim, güçlü olan. Bu yüzden...Dialogue: 50,0:30:45.41,0:30:50.58,Main-207-,,0,0,0,,Bir ustanın nezaketiyle, dünyanın en güçlü kara kılıcıyla işini bitireceğim.Dialogue: 50,0:30:50.58,0:30:53.33,Main-207-,,0,0,0,,Minnettarım.Dialogue: 50,0:30:54.92,0:30:55.92,Main-207-,,0,0,0,,Sonunda çekti!Dialogue: 50,0:30:55.92,0:30:57.96,Main-207-,,0,0,0,,O, gemiyi doğradığı kılıç!Dialogue: 50,0:30:58.67,0:31:01.17,Thoughts-207-,,0,0,0,,Bu son vuruş olacak...Dialogue: 50,0:31:01.17,0:31:03.13,Thoughts-207-,,0,0,0,,Dünyanın en iyisi olmak mı?Dialogue: 50,0:31:03.13,0:31:04.13,Thoughts-207-,,0,0,0,,Ölmek mi?Dialogue: 50,0:31:08.55,0:31:10.56,Main-207-,,0,0,0,,Abi! Yeter artık! Lütfen dur!Dialogue: 50,0:31:10.56,0:31:12.77,Main-207-,,0,0,0,,Üç Kılıç Stili Gizli Teknik:Dialogue: 50,0:31:15.65,0:31:16.56,Main-207-,,0,0,0,,Yıkıl!Dialogue: 50,0:31:16.56,0:31:18.94,Main-207-,,0,0,0,,Üç Bin Dünya!Dialogue: 50,0:31:26.28,0:31:27.62,Thoughts-207-,,0,0,0,,Kaybettim...Dialogue: 50,0:31:29.12,0:31:32.29,Thoughts-207-,,0,0,0,,Kaybedeceğimi hiç düşünmemiştim...Dialogue: 50,0:31:34.08,0:31:36.75,Thoughts-207-,,0,0,0,,Demek ki bu dünyanın en iyisinin gücü...Dialogue: 50,0:31:40.75,0:31:41.67,Main-207-,,0,0,0,,Ne yapıyorsun...?Dialogue: 50,0:31:43.05,0:31:45.55,Main-207-,,0,0,0,,Sırttaki yaralar bir kılıç ustasının utancıdır.Dialogue: 50,0:31:46.01,0:31:46.97,Main-207-,,0,0,0,,Harikulade!Dialogue: 50,0:31:50.85,0:31:56.81,Main-207-,,0,0,0,,Zoro!Dialogue: 50,0:31:58.73,0:32:01.61,Thoughts-207-,,0,0,0,,Ölümün kucağına bodoslama atlama, delikanlı.Dialogue: 50,0:32:02.86,0:32:04.24,Main-207-,,0,0,0,,Zoro!Dialogue: 50,0:32:05.36,0:32:06.74,Main-207-,,0,0,0,,– Abi! – Abi!Dialogue: 50,0:32:09.57,0:32:11.08,Thoughts-207-,,0,0,0,,Neden?Dialogue: 50,0:32:13.37,0:32:20.21,Flashbacks-207-,,0,0,0,,Dünyanın en iyi kılıç ustası olmayı seçtiğimde zaten hayatımı çöpe attım.Dialogue: 50,0:32:22.00,0:32:25.59,Thoughts-207-,,0,0,0,,O delirmiş! Rakibi dünyanın en iyisi!Dialogue: 50,0:32:26.51,0:32:27.97,Thoughts-207-,,0,0,0,,Sonuç belliydi.Dialogue: 50,0:32:27.97,0:32:30.18,Thoughts-207-,,0,0,0,,Ölmek yerine hırsından vazgeçmesi lazımdı!Dialogue: 50,0:32:30.18,0:32:31.51,Main-207-,,0,0,0,,Çok basit lan!Dialogue: 50,0:32:31.51,0:32:33.47,Main-207-,,0,0,0,,Sadece hırsından vazgeç!Dialogue: 50,0:32:37.06,0:32:40.52,Main-207-,,0,0,0,,Demek ki bu Grand Line'nın gücü... dünyanın gücü!Dialogue: 50,0:32:41.11,0:32:44.82,Main-207-,,0,0,0,,Korsan Avcısı Zoro, yeni doğmuş bir bebek kadar çaresizdi!Dialogue: 50,0:32:44.82,0:32:49.16,Main-207-,,0,0,0,,Lanet olsun, lanet olsun... lanet olsun!Dialogue: 50,0:32:49.16,0:32:51.12,Main-207-,,0,0,0,,– Abi! – Abi!Dialogue: 50,0:32:55.70,0:32:57.83,Main-207-,,0,0,0,,O-O da ne?!Dialogue: 50,0:32:59.37,0:33:03.34,Main-207-,,0,0,0,,Demek ki o velette şeytan meyvesinin gücü var!Dialogue: 50,0:33:04.00,0:33:04.88,Main-207-,,0,0,0,,Seni–Dialogue: 50,0:33:07.09,0:33:09.63,Main-207-,,0,0,0,,O genç kılıç ustasının arkadaşı mısın?Dialogue: 50,0:33:09.63,0:33:12.47,Main-207-,,0,0,0,,Sonuna kadar izleyerek beni etkiledin!Dialogue: 50,0:33:16.85,0:33:20.48,Main-207-,,0,0,0,,Merak etme. Onu öldürmedim.Dialogue: 50,0:33:20.48,0:33:21.23,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:33:21.23,0:33:23.98,Main-207-,,0,0,0,,Abi! Abi! Bir şey söyle!Dialogue: 50,0:33:23.98,0:33:24.90,Main-207-,,0,0,0,,Zoro?!Dialogue: 50,0:33:26.86,0:33:27.86,Main-207-,,0,0,0,,Zoro!Dialogue: 50,0:33:27.86,0:33:29.78,Main-207-,,0,0,0,,Hadi, çabuk olun ve onu gemiye çıkartın!Dialogue: 50,0:33:31.66,0:33:33.41,Main-207-,,0,0,0,,Bu ilacı üzerine dökün!Dialogue: 50,0:33:33.82,0:33:36.24,Main-207-,,0,0,0,,Ölmen için daha çok erken.Dialogue: 50,0:33:36.74,0:33:39.37,Main-207-,,0,0,0,,Benim adım Dracule Mihawk!Dialogue: 50,0:33:39.37,0:33:40.75,Main-207-,,0,0,0,,Kendini bil!Dialogue: 50,0:33:40.75,0:33:42.04,Main-207-,,0,0,0,,Dünyayı öğren!Dialogue: 50,0:33:42.04,0:33:43.33,Main-207-,,0,0,0,,Ve güçlen!Dialogue: 50,0:33:43.33,0:33:45.88,Main-207-,,0,0,0,,Kaç yıl geçerse geçsin,Dialogue: 50,0:33:45.88,0:33:48.30,Main-207-,,0,0,0,,en iyi olarak kalıp seni bekleyeceğim.Dialogue: 50,0:33:48.88,0:33:51.05,Main-207-,,0,0,0,,Bu kılıcı aş!Dialogue: 50,0:33:51.05,0:33:55.43,Main-207-,,0,0,0,,Beni geç, Roronoa Zoro!Dialogue: 50,0:33:56.89,0:33:59.64,Main-207-,,0,0,0,,Abi! Abi, bir şey söyle!Dialogue: 50,0:33:58.14,0:33:59.64,Secondary-207-,,0,0,0,,Abi!Dialogue: 50,0:34:00.43,0:34:04.15,Main-207-,,0,0,0,,Şahin Göz Mihawk’a bunları söyletmiş olması…Dialogue: 50,0:34:05.40,0:34:07.90,Main-207-,,0,0,0,,Çocuk, neyi hedefliyorsun?Dialogue: 50,0:34:08.44,0:34:09.53,Main-207-,,0,0,0,,Korsanlar Kralı!Dialogue: 50,0:34:10.28,0:34:14.28,Main-207-,,0,0,0,,Bu beni geçmekten bile zor!Dialogue: 50,0:34:14.28,0:34:17.03,Main-207-,,0,0,0,,Daha olmadan nasıl bilebilirim ki?!Dialogue: 50,0:34:18.12,0:34:19.75,Main-207-,,0,0,0,,Yaşıyor!Dialogue: 50,0:34:20.12,0:34:21.50,Main-207-,,0,0,0,,Sadece bayılmış.Dialogue: 50,0:34:22.54,0:34:24.67,Main-207-,,0,0,0,,Abi! Bir şey söyle!Dialogue: 50,0:34:21.50,0:34:22.54,Main-207-,,0,0,0,,Abi!Dialogue: 50,0:34:25.33,0:34:26.42,Main-207-,,0,0,0,,Zoro?Dialogue: 50,0:34:27.09,0:34:28.25,Main-207-,,0,0,0,,Abi!Dialogue: 50,0:34:29.76,0:34:31.38,Main-207-,,0,0,0,,L... Luffy...Dialogue: 50,0:34:31.88,0:34:33.13,Main-207-,,0,0,0,,Beni duyabiliyor musun?Dialogue: 50,0:34:33.13,0:34:34.59,Main-207-,,0,0,0,,Evet!Dialogue: 50,0:34:35.60,0:34:37.76,Main-207-,,0,0,0,,Seni endişelendirdim mi?Dialogue: 50,0:34:38.76,0:34:40.18,Main-207-,,0,0,0,,Ben...Dialogue: 50,0:34:40.85,0:34:46.69,Main-207-,,0,0,0,,dünyanın en iyi kılıç ustası olamazsam zorlanırsın, değil mi?Dialogue: 50,0:34:47.69,0:34:50.65,Main-207-,,0,0,0,,Abi! Lütfen daha fazla konuşma!Dialogue: 50,0:34:49.57,0:34:50.65,Secondary-207-,,0,0,0,,Abi!Dialogue: 50,0:34:51.11,0:34:52.61,Main-207-,,0,0,0,,Ben...Dialogue: 50,0:34:52.99,0:34:55.07,Main-207-,,0,0,0,,Ben bir daha...Dialogue: 50,0:34:55.07,0:34:57.53,Main-207-,,0,0,0,,asla yenilmeyeceğim!Dialogue: 50,0:35:00.24,0:35:04.04,Main-207-,,0,0,0,,Onu yeneceğim ve gerçek bir usta olacağım o güne dek...Dialogue: 50,0:35:04.54,0:35:06.00,Main-207-,,0,0,0,,Bir daha asla...Dialogue: 50,0:35:06.00,0:35:07.38,Main-207-,,0,0,0,,kaybetmeyeceğim!Dialogue: 50,0:35:08.04,0:35:09.96,Main-207-,,0,0,0,,Bununla ilgili bir sorun var mı...Dialogue: 50,0:35:11.38,0:35:13.55,Main-207-,,0,0,0,,Korsanlar Kralı?!Dialogue: 50,0:35:17.14,0:35:18.14,Main-207-,,0,0,0,,Yok!Dialogue: 50,0:35:18.14,0:35:19.93,Main-207-,,0,0,0,,İyi bir takımsınız.Dialogue: 50,0:35:19.93,0:35:22.85,Main-207-,,0,0,0,,Sizi bir daha görmek isterim.Dialogue: 50,0:35:23.85,0:35:25.98,Main-207-,,0,0,0,,Hey, Şahin Göz!Dialogue: 50,0:35:26.40,0:35:29.90,Main-207-,,0,0,0,,Benim kellemi almaya gelmedin mi...Dialogue: 50,0:35:29.90,0:35:33.40,Main-207-,,0,0,0,,Doğu Mavi'nin hakimi, Don Krieg'in kellesini?Dialogue: 50,0:35:33.86,0:35:37.78,Main-207-,,0,0,0,,Alacaktım ama yeterince eğlendim.Dialogue: 50,0:35:37.78,0:35:39.78,Main-207-,,0,0,0,,Dinlenmek için eve geri dönüyorum.Dialogue: 50,0:35:39.78,0:35:43.50,Main-207-,,0,0,0,,Sana yetmiş olabilir ama ben sürekli yenilmekten bıktım.Dialogue: 50,0:35:43.50,0:35:45.00,Main-207-,,0,0,0,,D-Don?Dialogue: 50,0:35:45.00,0:35:47.38,Main-207-,,0,0,0,,Neden onu burada tutmaya çalışıyorsun?Dialogue: 50,0:35:47.75,0:35:49.50,Main-207-,,0,0,0,,Gitmeden önce öl!Dialogue: 50,0:35:50.88,0:35:53.13,Thoughts-207-,,0,0,0,,Tahmin ettiğim gibi... asla dersini almıyor...Dialogue: 50,0:36:01.14,0:36:03.10,Main-207-,,0,0,0,,Kahretsin! Kaçtı...Dialogue: 50,0:36:12.02,0:36:13.69,Main-207-,,0,0,0,,Usopp!Dialogue: 50,0:36:13.69,0:36:14.69,Main-207-,,0,0,0,,Luffy!Dialogue: 50,0:36:15.07,0:36:17.41,Main-207-,,0,0,0,,Git! Nami'yi size bırakıyorum!Dialogue: 50,0:36:17.91,0:36:18.91,Main-207-,,0,0,0,,Anladım!Dialogue: 50,0:36:18.91,0:36:21.83,Main-207-,,0,0,0,,Zoro ve ben, Nami'yi kesinlikle geri getireceğiz!Dialogue: 50,0:36:21.83,0:36:24.37,Main-207-,,0,0,0,,Sen de o aşçıyı tayfamıza al!Dialogue: 50,0:36:24.75,0:36:27.50,Main-207-,,0,0,0,,Beşimiz yeniden bir araya geldiğimizde gidelim...Dialogue: 50,0:36:27.92,0:36:29.92,Main-207-,,0,0,0,,Grand Line'a!Dialogue: 50,0:36:29.92,0:36:30.92,Main-207-,,0,0,0,,Evet!Dialogue: 50,0:36:30.92,0:36:32.17,Main-207-,,0,0,0,,Bence de güzel plan!Dialogue: 50,0:36:32.17,0:36:37.34,Main-207-,,0,0,0,,Beyler! Küçük bir engel ile karşılaştık ama gerçek savaş şimdi başlıyor!Dialogue: 50,0:36:37.34,0:36:39.01,Main-207-,,0,0,0,,O gemiyi alacağız!Dialogue: 50,0:36:39.01,0:36:40.14,Main-207-,,0,0,0,,– Evet! – Evet!Dialogue: 50,0:36:40.14,0:36:44.85,Main-207-,,0,0,0,,İhtiyar, eğer onları uzaklaştırırsam, kamarotluğu bırakabilir miyim?Dialogue: 50,0:36:44.85,0:36:46.73,Main-207-,,0,0,0,,Keyfine bak.Dialogue: 0,0:04:41.18,0:04:46.14,Title-207-,,0,0,0,,YeminDialogue: 1,0:04:41.18,0:04:46.14,Title-207-,,0,0,0,,YeminDialogue: 0,0:21:25.06,0:21:29.98,Captions-207-,,0,0,0,,"Şahin Göz" Mihawk Dünyanın En İyi Kılıç UstasıDialogue: 1,0:21:25.06,0:21:29.98,Captions-207-,,0,0,0,,"Şahin Göz" Mihawk Dünyanın En İyi Kılıç UstasıDialogue: 2,0:21:25.06,0:21:29.98,Captions-207-,,0,0,0,,"Şahin Göz" Mihawk Dünyanın En İyi Kılıç UstasıDialogue: 0,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Video 