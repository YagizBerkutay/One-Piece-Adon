Style: Sign-OP-furigana,Captain Redemption,187.5,&H0015181B,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0,0,2,15,15,15,1Style: Translation-furigana,Duality,52.5,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,2.25,0,2,15,15,15,1Style: Karaoke-furigana,Duality,52.5,&H009E375F,&H009E375F,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2.25,0,8,15,15,15,1Style: Karaoke,Duality,82,&H009E375F,&H009E375F,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,4.5,0,8,15,15,15,1Style: Translation,Duality,82,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,4.5,0,2,15,15,15,1Style: Sign-OP,Captain Redemption,375,&H0015181B,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0,0,2,15,15,15,1Style: Sign-Wano,KG Ten Thousand Reasons Alt,60,&H005B57D2,&H000000FF,&H00000000,&H00000000,-1,0,0,0,100,100,0,0,1,0,0,2,15,15,15,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:41.87,0:01:51.86,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 55,0:01:41.87,0:01:44.33,Main-207+,,0,0,0,,Ah, Inuarashi!Dialogue: 55,0:01:44.81,0:01:46.83,Main-207+,,0,0,0,,Nerelerdeydin?Dialogue: 55,0:01:46.83,0:01:48.92,Main-207+,,0,0,0,,Bir sorun mu var, Kin'emon?Dialogue: 55,0:01:49.62,0:01:51.67,Main-207+,,0,0,0,,Gerçekten çok zor durumdayız!Dialogue: 55,0:01:54.03,0:01:58.05,Main-207+,,0,0,0,,Düşman, ilandan ve hilal dövmesinden haberdar mı?!Dialogue: 55,0:01:58.05,0:02:01.30,Main-207+,,0,0,0,,Evet! Bu büyük bir problem!Dialogue: 55,0:02:01.30,0:02:03.89,Main-207+,,0,0,0,,Ne yapacağız Dük-sama?!Dialogue: 55,0:02:04.57,0:02:07.70,Main-207+,,0,0,0,,Bunları gizliden gizliye dağıtıyorduk...Dialogue: 55,0:02:07.70,0:02:10.86,Main-207+,,0,0,0,,yani nasıl sızdığından emin değiliz.Dialogue: 55,0:02:10.86,0:02:16.82,Main-207+,,0,0,0,,Yanlış ellere geçme ihtimaline karşı bu kodlu sembolü seçmiştik.Dialogue: 55,0:02:16.82,0:02:24.17,Main-207+,,0,0,0,,Ama bir şekilde sembol ve dövme arasındaki ilişkinin sırrını çözmüşler.Dialogue: 55,0:02:26.16,0:02:27.75,Main-207+,,0,0,0,,Aldığımız raporlara göre...Dialogue: 55,0:02:27.75,0:02:33.17,Main-207+,,0,0,0,,başkentteki müttefiklerimiz, Kaido ve Orochi'nin güçleri tarafından tutuklanıyor.Dialogue: 55,0:02:34.71,0:02:37.46,Main-207+,,0,0,0,,– Tutuklusun!  – Tutuklusun!Dialogue: 55,0:02:39.57,0:02:43.14,Main-207+,,0,0,0,,Direnmeyi bırak, seni asi bok!Dialogue: 55,0:02:43.56,0:02:46.10,Main-207+,,0,0,0,,Bir tane daha buldum!Dialogue: 55,0:02:47.76,0:02:50.35,Main-207+,,0,0,0,,Çok kolay oldu!Dialogue: 55,0:02:50.35,0:02:52.81,Main-207+,,0,0,0,,Bunun da hilal dövmesi var!Dialogue: 55,0:02:53.66,0:02:57.11,Main-207+,,0,0,0,,Ayak bileğinde bu işaret olan herkes haindir!Dialogue: 55,0:02:57.87,0:03:00.05,Main-207+,,0,0,0,,Bunu gördüğünüz herkesi rapor edin!Dialogue: 55,0:03:05.50,0:03:07.67,Main-207+,,0,0,0,,Haberler hızlı yayılıyor.Dialogue: 55,0:03:07.67,0:03:10.50,Main-207+,,0,0,0,,Tüm başkent çoktan duymuş.Dialogue: 55,0:03:10.50,0:03:14.48,Main-207+,,0,0,0,,Hamamlara ziyaretler yapmanın sırası değil.Dialogue: 55,0:03:15.21,0:03:17.47,Main-207+,,0,0,0,,Çok şanslısın.Dialogue: 55,0:03:17.47,0:03:19.09,Main-207+,,0,0,0,,Bu da ne demek?Dialogue: 55,0:03:25.16,0:03:28.47,Flashbacks-207+,,0,0,0,,Gizli Kara'dan beklenildiği gibi!Dialogue: 55,0:03:28.47,0:03:30.14,Flashbacks-207+,,0,0,0,,Gelecek sefere onu haklayacağım!Dialogue: 55,0:03:30.69,0:03:33.99,Main-207+,,0,0,0,,Kaçmaları senin suçun olduğu için sen de onlar kadar suçlusun.Dialogue: 55,0:03:39.07,0:03:42.03,Main-207+,,0,0,0,,Ah, Komurasaki...!Dialogue: 55,0:03:55.00,0:03:57.38,Main-207+,,0,0,0,,Patron Kyoshiro.Dialogue: 55,0:03:57.96,0:04:01.26,Main-207+,,0,0,0,,Komurasaki'nin cenaze töreni iptal edildi.Dialogue: 55,0:04:01.26,0:04:06.47,Main-207+,,0,0,0,,Bu kadar çok kederli insan cenazeye akın ederse işler kontrolden çıkabilir.Dialogue: 55,0:04:07.97,0:04:12.68,Main-207+,,0,0,0,,Yarınki tören bundan çok daha kalabalık olabilir.Dialogue: 55,0:04:13.58,0:04:16.52,Main-207+,,0,0,0,,Huzur içinde yatsın!Dialogue: 55,0:04:16.52,0:04:21.27,Main-207+,,0,0,0,,Bir çoğu olanlar için size kin güdüyor.Dialogue: 55,0:04:21.94,0:04:23.65,Main-207+,,0,0,0,,Lütfen dikkatli olun.Dialogue: 55,0:04:24.72,0:04:27.20,Main-207+,,0,0,0,,Herkes kendi işine baksın.Dialogue: 55,0:04:32.37,0:04:36.58,Main-207+,,0,0,0,,Başka çare yoktu.Dialogue: 55,0:04:36.58,0:04:40.58,Main-207+,,0,0,0,,Hem en çok acı çeken kişi...Dialogue: 55,0:04:40.58,0:04:41.96,Main-207+,,0,0,0,,benim.Dialogue: 55,0:04:42.72,0:04:44.25,Main-207+,,0,0,0,,Kesinlikle.Dialogue: 55,0:04:50.26,0:04:54.37,Main-207+,,0,0,0,,Orochi-sama'nın morali hâlâ kötü.Dialogue: 55,0:04:54.37,0:04:58.14,Main-207+,,0,0,0,,Bahse varım, onun canını sıkan şey bu.Dialogue: 55,0:05:06.90,0:05:08.90,Main-207+,,0,0,0,,Yeter artık, ikiniz de!Dialogue: 55,0:05:08.90,0:05:11.87,Main-207+,,0,0,0,,Tartışmak bunların hiçbirini çözmeyecek!Dialogue: 55,0:05:13.08,0:05:15.00,Main-207+,,0,0,0,,Hepimiz aynı taraftayız!Dialogue: 55,0:05:17.25,0:05:21.82,Main-207+,,0,0,0,,Orochi'ye isyan ettiğinden şüphelenilen herkesi tutuklamaya başladılar...Dialogue: 55,0:05:23.00,0:05:26.18,Main-207+,,0,0,0,,tam da senin tayfan ortadan kaybolduğu zaman!Dialogue: 55,0:05:26.99,0:05:28.06,Main-207+,,0,0,0,,Bu da ne demek?!Dialogue: 55,0:05:28.06,0:05:30.64,Main-207+,,0,0,0,,Şu küçük ayı ve arkadaşları...Dialogue: 55,0:05:30.64,0:05:33.97,Main-207+,,0,0,0,,planı sızdıran onlar olmalılar!Dialogue: 55,0:05:35.18,0:05:40.69,Main-207+,,0,0,0,,Konuşmaktansa ölmeyi yeğlerler! Sakın onlara saygısızlık edeyim deme!Dialogue: 55,0:05:41.76,0:05:45.31,Main-207+,,0,0,0,,Bekle! Tam olarak düşmanın istediği şeyi yapıyorsun, Trao!Dialogue: 55,0:05:45.31,0:05:49.20,Main-207+,,0,0,0,,Senden hiçbir şey duymak istemiyorum, Kara Bacak-ya!Dialogue: 55,0:05:49.20,0:05:52.41,Main-207+,,0,0,0,,İkiniz de sakinleşin.Dialogue: 55,0:05:53.12,0:05:56.74,Main-207+,,0,0,0,,Asıl sakinleşmesi gereken sensin!Dialogue: 55,0:05:57.71,0:05:59.26,Main-207+,,0,0,0,,İkinizin de...Dialogue: 55,0:05:59.26,0:06:01.86,Main-207+,,0,0,0,,İkinizin de birbirinize güvenmesi gerekiyor!Dialogue: 55,0:06:01.86,0:06:04.58,Main-207+,,0,0,0,,Burada en güvenilmez kişi sensin!Dialogue: 55,0:06:08.85,0:06:11.27,Main-207+,,0,0,0,,Hiçbir şey görmedim ki...Dialogue: 55,0:06:11.27,0:06:15.27,Main-207+,,0,0,0,,Sen nasıl bi' dayak yedin be?Dialogue: 55,0:06:16.82,0:06:17.94,Main-207+,,0,0,0,,Kaçıyor musun?!Dialogue: 55,0:06:17.94,0:06:21.60,Main-207+,,0,0,0,,Yakalanan kişileri ortadan kaldırman gerekiyor!Dialogue: 55,0:06:22.11,0:06:23.40,Main-207+,,0,0,0,,Onları susturmalısın!Dialogue: 55,0:06:23.40,0:06:24.77,Main-207+,,0,0,0,,Ne dedin sen?!Dialogue: 55,0:06:24.77,0:06:27.51,Main-207+,,0,0,0,,Ninja dünyasının kuralı budur!Dialogue: 55,0:06:27.51,0:06:29.68,Main-207+,,0,0,0,,Korkunçsun, Shinobu!Dialogue: 55,0:06:33.29,0:06:36.42,Main-207+,,0,0,0,,Burada oyun oynamıyoruz!Dialogue: 55,0:06:41.81,0:06:46.01,Main-207+,,0,0,0,,Bu iş için tam 20 yıl bekledik!Dialogue: 55,0:06:46.01,0:06:50.42,Main-207+,,0,0,0,,Çuvallarsak, denemek için başka şansımız olmayacak!Dialogue: 55,0:06:54.63,0:06:57.09,Main-207+,,0,0,0,,Bu kadar yeter, Shinobu!Dialogue: 55,0:06:58.61,0:07:00.32,Main-207+,,0,0,0,,Kan-sama...Dialogue: 55,0:07:02.16,0:07:04.90,Main-207+,,0,0,0,,İşler her zaman planlandığı gibi gitmez!Dialogue: 55,0:07:04.90,0:07:07.10,Main-207+,,0,0,0,,Endişeni anlıyorum...Dialogue: 55,0:07:07.10,0:07:12.87,Main-207+,,0,0,0,,ama hedefleri bizimkilerle aynı olan müttefikler bulmamız bile bir mucize!Dialogue: 55,0:07:12.87,0:07:17.24,Main-207+,,0,0,0,,Onlar olmadan, Oden-sama'nın dileğini asla gerçekleştiremeyiz!Dialogue: 55,0:07:21.83,0:07:24.37,Main-207+,,0,0,0,,Rahatsız ediyorum! Affedersiniz!Dialogue: 55,0:07:24.37,0:07:27.86,Main-207+,,0,0,0,,Dışarıdaydım ve söylediklerinize kulak misafiri oldum!Dialogue: 55,0:07:28.98,0:07:31.28,Main-207+,,0,0,0,,Ve hepsi çok güzel şeylerdi!Dialogue: 55,0:07:31.28,0:07:33.57,Main-207+,,0,0,0,,Bekle, kimsin sen?!Dialogue: 55,0:07:33.57,0:07:34.84,Main-207+,,0,0,0,,Ah?Dialogue: 55,0:07:35.58,0:07:39.31,Main-207+,,0,0,0,,Vaay! Bu ne güzellik! Tam bir tanrıça!Dialogue: 55,0:07:40.46,0:07:41.51,Main-207+,,0,0,0,,Hadi ya!Dialogue: 55,0:07:41.51,0:07:43.82,Main-207+,,0,0,0,,Lütfen, kendinizi evinizde hissedin.Dialogue: 55,0:07:43.82,0:07:46.82,Main-207+,,0,0,0,,Ah, böldüğüm için bağışlayın.Dialogue: 55,0:07:46.82,0:07:47.52,Main-207+,,0,0,0,,Hey!Dialogue: 55,0:07:50.25,0:07:51.37,Main-207+,,0,0,0,,Yoksa...Dialogue: 55,0:07:51.37,0:07:54.08,Main-207+,,0,0,0,,Shinobu-chan?!Dialogue: 55,0:07:56.54,0:07:58.21,Main-207+,,0,0,0,,Kanjuro-kun!Dialogue: 55,0:07:58.96,0:08:03.27,Main-207+,,0,0,0,,Amanın! Demek öyle! Demek öyle!Dialogue: 55,0:08:03.27,0:08:07.58,Main-207+,,0,0,0,,O hâlde bu gerçek olmalı, değil mi?!Dialogue: 55,0:08:07.58,0:08:11.29,Main-207+,,0,0,0,,Başkentte herkes bunu konuşuyor!Dialogue: 55,0:08:11.29,0:08:14.17,Main-207+,,0,0,0,,Kalbim yerinden fırlayacak sanki!Dialogue: 55,0:08:14.96,0:08:19.10,Main-207+,,0,0,0,,Söylenenler doğru mu?! Büyük savaş olacak mı?!Dialogue: 55,0:08:36.17,0:08:37.49,Main-207+,,0,0,0,,Kılıcım...Dialogue: 55,0:08:37.49,0:08:39.32,Main-207+,,0,0,0,,Kılıcım!Dialogue: 55,0:08:44.49,0:08:46.22,Main-207+,,0,0,0,,Sen...Dialogue: 55,0:08:46.22,0:08:48.97,Main-207+,,0,0,0,,Beni korkuttun!Dialogue: 55,0:08:49.51,0:08:52.33,Main-207+,,0,0,0,,Lütfen, dinlenmen gerek...Dialogue: 55,0:08:53.86,0:08:55.72,Main-207+,,0,0,0,,yoksa yaran açılır.Dialogue: 55,0:08:55.72,0:08:59.21,Main-207+,,0,0,0,,Aynen öyle! Henüz kalkmaman gerek!Dialogue: 55,0:09:00.55,0:09:02.40,Main-207+,,0,0,0,,Neredeyim ben?Dialogue: 55,0:09:09.11,0:09:15.44,Main-207+,,0,0,0,,Bizi orada kurtardığın için sana sonsuz teşekkür ederiz.Dialogue: 55,0:09:18.07,0:09:20.05,Main-207+,,0,0,0,,Evet, çok sağ ol!Dialogue: 55,0:09:21.47,0:09:24.49,Main-207+,,0,0,0,,Ama çok kötü yaralandın!Dialogue: 55,0:09:25.03,0:09:28.76,Main-207+,,0,0,0,,Sana tam olarak... nasıl teşekkür edebileceğimi bilemedim.Dialogue: 55,0:09:30.79,0:09:33.97,Main-207+,,0,0,0,,Yaralanmam benim saflığımdı.Dialogue: 55,0:09:33.97,0:09:36.14,Main-207+,,0,0,0,,Seninle hiçbir ilgisi yok.Dialogue: 55,0:09:37.96,0:09:41.05,Main-207+,,0,0,0,,Peki o herif nereye gitti?!Dialogue: 55,0:09:41.05,0:09:43.34,Main-207+,,0,0,0,,Shusui hâlâ onda!Dialogue: 55,0:09:43.77,0:09:46.90,Main-207+,,0,0,0,,Lütfen, bu yarayla bir yere gitmeye çalışmayın!Dialogue: 55,0:09:46.90,0:09:48.21,Main-207+,,0,0,0,,Acıdı be!Dialogue: 55,0:09:48.21,0:09:51.50,Main-207+,,0,0,0,,Orası yaralı yerim, salak!Dialogue: 55,0:09:51.50,0:09:52.52,Main-207+,,0,0,0,,Özür dilerim!Dialogue: 55,0:09:52.52,0:09:54.32,Main-207+,,0,0,0,,Öf be...!Dialogue: 55,0:09:54.32,0:09:55.98,Main-207+,,0,0,0,,Hadi görüşürüz!Dialogue: 55,0:09:56.57,0:10:00.32,Main-207+,,0,0,0,,Gitmeyin! Yaranız henüz iyileşmedi!Dialogue: 55,0:10:00.32,0:10:01.98,Main-207+,,0,0,0,,Ay, ay, ay, acıyor!Dialogue: 55,0:10:01.98,0:10:05.08,Main-207+,,0,0,0,,Sana o kolum yaralı dedim ya! Senin sorunun ne?!Dialogue: 55,0:10:05.08,0:10:06.84,Main-207+,,0,0,0,,Ç-Çok özür dilerim!Dialogue: 55,0:10:10.02,0:10:12.29,Main-207+,,0,0,0,,Of, of, of.Dialogue: 55,0:10:12.29,0:10:14.64,Main-207+,,0,0,0,,Geçecek, samuray-san!Dialogue: 55,0:10:14.64,0:10:16.36,Main-207+,,0,0,0,,Yakında iyi hissedeceksiniz!Dialogue: 55,0:10:16.36,0:10:20.11,Main-207+,,0,0,0,,Başkentteyken her yaraya iyi gelen özel bir kurbağa yağı çalmış...Dialogue: 55,0:10:20.72,0:10:22.03,Main-207+,,0,0,0,,yani almıştım!Dialogue: 55,0:10:22.03,0:10:23.51,Main-207+,,0,0,0,,Çaldın demek.Dialogue: 55,0:10:23.51,0:10:25.09,Main-207+,,0,0,0,,H-Hayır, çalmadım!Dialogue: 55,0:10:26.37,0:10:28.27,Main-207+,,0,0,0,,Şey, umurumda değil.Dialogue: 55,0:10:28.27,0:10:30.31,Main-207+,,0,0,0,,Bu kurbağa yağı inanılmaz!Dialogue: 55,0:10:30.94,0:10:33.98,Main-207+,,0,0,0,,Kesik yaralarını tamamen yok ediyormuş.Dialogue: 55,0:10:33.98,0:10:38.37,Main-207+,,0,0,0,,Kurbağa yağı, ha? Şey, umarım işe yarıyordur!Dialogue: 55,0:10:40.33,0:10:42.99,Main-207+,,0,0,0,,Hey, samuray-san!Dialogue: 55,0:10:45.79,0:10:47.58,Main-207+,,0,0,0,,Bizi terk etme!Dialogue: 55,0:10:50.52,0:10:52.26,Main-207+,,0,0,0,,Yiyecek bir şeyler var mı?Dialogue: 55,0:10:52.26,0:10:54.79,Main-207+,,0,0,0,,Evet! Biraz ister misin?!Dialogue: 55,0:11:02.39,0:11:03.42,Main-207+,,0,0,0,,Gyukimaru mu?Dialogue: 55,0:11:03.42,0:11:05.54,Main-207+,,0,0,0,,E-Evet.Dialogue: 55,0:11:07.11,0:11:11.60,Main-207+,,0,0,0,,Soyguncu Köprüsü'ndeki Gyukimaru'nun hikayesini tüm başkent bilir.Dialogue: 55,0:11:12.22,0:11:17.40,Flashbacks-207+,,0,0,0,,İsimli kılıç Shusui çoktan ait olduğu yere döndü.Dialogue: 55,0:11:17.40,0:11:24.40,Flashbacks-207+,,0,0,0,,Wano'nun efsanevi samurayı Ryuma'nın mezarından çalınmış bir hazinedir o!Dialogue: 55,0:11:24.49,0:11:27.35,Main-207+,,0,0,0,,Nerede kaldığı meçhul...Dialogue: 55,0:11:27.35,0:11:32.71,Main-207+,,0,0,0,,ama köprüyü geçmeye kalkan silahlı herkesin yolunu keser.Dialogue: 55,0:11:34.24,0:11:39.08,Main-207+,,0,0,0,,Yani sürekli orada mı? Öyleyse aceleye gerek yok.Dialogue: 55,0:11:39.08,0:11:42.42,Main-207+,,0,0,0,,Aklım hâlâ Gyukimaru'da...Dialogue: 55,0:11:42.42,0:11:44.76,Main-207+,,0,0,0,,ama önce, siz kimsiniz, anlatın hele?Dialogue: 55,0:11:44.76,0:11:48.34,Main-207+,,0,0,0,,O azrail kılıklı herif neden peşinizdeydi?Dialogue: 55,0:11:57.47,0:12:02.45,Main-207+,,0,0,0,,Çünkü Wano şogununu sinirlendirdik.Dialogue: 55,0:12:02.45,0:12:04.17,Main-207+,,0,0,0,,Şogun, he?Dialogue: 55,0:12:04.17,0:12:06.41,Main-207+,,0,0,0,,Oro... Oroshi?Dialogue: 55,0:12:06.41,0:12:07.78,Main-207+,,0,0,0,,Orochi.Dialogue: 55,0:12:07.78,0:12:10.33,Main-207+,,0,0,0,,Hey, samuray-san!Dialogue: 55,0:12:11.22,0:12:13.04,Main-207+,,0,0,0,,Benim adım, Toko!Dialogue: 55,0:12:13.04,0:12:16.41,Main-207+,,0,0,0,,Saygı eki olan "O"yu kullanırsan Otoko oluyor, yani "erkek".Dialogue: 55,0:12:17.59,0:12:19.87,Main-207+,,0,0,0,,Çok komik değil mi?!Dialogue: 55,0:12:19.87,0:12:21.03,Main-207+,,0,0,0,,Hayır, değil.Dialogue: 55,0:12:21.03,0:12:22.96,Main-207+,,0,0,0,,Ne? Nee?!Dialogue: 55,0:12:23.75,0:12:27.60,Main-207+,,0,0,0,,Herkes komik olduğunu söyler! Senin sorunun ne?!Dialogue: 55,0:12:27.60,0:12:28.81,Main-207+,,0,0,0,,Ne bileyim ben.Dialogue: 55,0:12:31.75,0:12:35.56,Main-207+,,0,0,0,,Wano samurayı gibi giyinseniz de...Dialogue: 55,0:12:35.56,0:12:37.65,Main-207+,,0,0,0,,aslında dışarıdan geldiniz, değil mi?Dialogue: 55,0:12:37.65,0:12:40.47,Main-207+,,0,0,0,,Yani kötü birine benzemiyor...Dialogue: 55,0:12:41.51,0:12:42.49,Main-207+,,0,0,0,,benze...Dialogue: 55,0:12:44.15,0:12:44.94,Main-207+,,0,0,0,,benzemiyorsunuz.Dialogue: 55,0:12:44.94,0:12:46.99,Main-207+,,0,0,0,,Lafı geveleme!Dialogue: 55,0:12:46.20,0:12:46.99,Secondary-207+,,0,0,0,,Özür dilerim!Dialogue: 55,0:12:47.97,0:12:50.69,Main-207+,,0,0,0,,Samuray-san, epey korkutucu duruyorsun!Dialogue: 55,0:12:50.69,0:12:54.83,Main-207+,,0,0,0,,Ama gerçekten iyi birisin, çünkü bizi kurtardın!Dialogue: 55,0:13:13.02,0:13:13.76,Main-207+,,0,0,0,,Şey...Dialogue: 55,0:13:15.16,0:13:18.56,Main-207+,,0,0,0,,Size bir sırrımı açıklamak istiyorum ama kimseye söylememelisiniz.Dialogue: 55,0:13:21.65,0:13:22.73,Main-207+,,0,0,0,,Neymiş?Dialogue: 55,0:13:22.73,0:13:26.72,Main-207+,,0,0,0,,Ben... aslında abimi arıyorum.Dialogue: 55,0:13:26.72,0:13:29.42,Main-207+,,0,0,0,,20 yıl kadar önce ayrı düştük...Dialogue: 55,0:13:33.49,0:13:37.38,Main-207+,,0,0,0,,ve şimdi, Wano'ya gelmiş olabilir!Dialogue: 55,0:13:38.13,0:13:40.71,Main-207+,,0,0,0,,Adı...Dialogue: 55,0:13:40.71,0:13:42.68,Main-207+,,0,0,0,,Kozuki Momonosuke.Dialogue: 55,0:13:44.14,0:13:45.74,Main-207+,,0,0,0,,Onun küçük kardeşiyim.Dialogue: 55,0:13:49.16,0:13:50.92,Main-207+,,0,0,0,,Adım Hiyori!Dialogue: 55,0:13:55.46,0:13:58.18,Main-207+,,0,0,0,,Küçük kardeşi mi?!Dialogue: 55,0:13:59.27,0:14:00.23,Main-207+,,0,0,0,,Haklıymışım!Dialogue: 55,0:14:00.23,0:14:02.99,Main-207+,,0,0,0,,İyi ki cesaretimi toplayıp söylemişim!Dialogue: 55,0:14:04.27,0:14:06.16,Main-207+,,0,0,0,,Bu tam bir kumardı.Dialogue: 55,0:14:07.52,0:14:09.49,Main-207+,,0,0,0,,Kardeşimi tanıyorsun, değil mi?!Dialogue: 55,0:14:10.18,0:14:11.90,Main-207+,,0,0,0,,Durumu nasıl, iyi mi?!Dialogue: 55,0:14:11.90,0:14:14.13,Main-207+,,0,0,0,,Bekle! Sakinleş biraz!Dialogue: 55,0:14:14.13,0:14:16.08,Main-207+,,0,0,0,,Düşüncelerimi toparlamam gerekiyor.Dialogue: 55,0:14:17.83,0:14:21.48,Main-207+,,0,0,0,,Şu sıralar her yerde Kozuki Hanesi'nin geri döneceği konuşuluyor.Dialogue: 55,0:14:22.08,0:14:27.54,Main-207+,,0,0,0,,Tesadüfe bak ki uzak denizlerden cesur ve iyi kalpli bir samuray çıkageliyor.Dialogue: 55,0:14:27.54,0:14:29.67,Main-207+,,0,0,0,,Abimin müttefiki olabileceğini düşündüm!Dialogue: 55,0:14:31.18,0:14:34.90,Main-207+,,0,0,0,,Yoksa onu alaşağı etmek için peşinden gelen bir düşman mısın?!Dialogue: 55,0:14:34.90,0:14:36.02,Main-207+,,0,0,0,,Değilim.Dialogue: 55,0:14:37.68,0:14:39.32,Main-207+,,0,0,0,,Onun müttefikiyim.Dialogue: 55,0:14:40.82,0:14:42.36,Main-207+,,0,0,0,,Rahatladım.Dialogue: 55,0:14:44.11,0:14:47.65,Main-207+,,0,0,0,,Kin'emon sağ mı, bilgin var mı?Dialogue: 55,0:14:49.67,0:14:54.75,Main-207+,,0,0,0,,Kanjuro, Raizo ve Kikunojo onunla mı?Dialogue: 55,0:14:54.75,0:14:56.28,Main-207+,,0,0,0,,Kikunojo?Dialogue: 55,0:14:57.50,0:14:59.24,Main-207+,,0,0,0,,Kiku'yu diyorsun sanırım...Dialogue: 55,0:14:59.24,0:15:03.47,Main-207+,,0,0,0,,Evet, ama bekle... Kafamı kurcalayan bir şeyler var.Dialogue: 55,0:15:03.47,0:15:06.25,Main-207+,,0,0,0,,Nasıl Momo'nun kardeşi olabilirsin?Dialogue: 55,0:15:09.28,0:15:10.93,Main-207+,,0,0,0,,Açıklayayım.Dialogue: 55,0:15:13.88,0:15:15.43,Main-207+,,0,0,0,,Anladım.Dialogue: 55,0:15:15.43,0:15:17.51,Main-207+,,0,0,0,,Demek bunlar oldu.Dialogue: 55,0:15:17.51,0:15:21.40,Main-207+,,0,0,0,,Momo buraya geçmişten geldi, o yüzden 8 yaşında kaldı...Dialogue: 55,0:15:21.40,0:15:24.69,Main-207+,,0,0,0,,Sen de onun küçük kız kardeşi olarak...Dialogue: 55,0:15:24.69,0:15:27.36,Main-207+,,0,0,0,,20 yıl yaşlandın ve şimdi 26 yaşındasın.Dialogue: 55,0:15:27.36,0:15:28.53,Main-207+,,0,0,0,,Evet.Dialogue: 55,0:15:28.53,0:15:29.84,Main-207+,,0,0,0,,Bu arada...Dialogue: 55,0:15:31.08,0:15:31.62,Main-207+,,0,0,0,,Ha?Dialogue: 55,0:15:32.04,0:15:34.54,Main-207+,,0,0,0,,onun bunları duyması sorun olmaz mı?Dialogue: 55,0:15:35.02,0:15:38.02,Main-207+,,0,0,0,,Sorun yok! Zaten biliyorum!Dialogue: 55,0:15:40.08,0:15:43.27,Main-207+,,0,0,0,,Ablayla küçük sırrımızdı!Dialogue: 55,0:15:43.27,0:15:47.84,Main-207+,,0,0,0,,Otoko benim gerçek kimliğimi bilen nadir yakınlarımdan biri.Dialogue: 55,0:15:49.02,0:15:53.17,Main-207+,,0,0,0,,Neşesi beni her gün ayakta tutuyor ve yoluma devam etmemi sağlıyor.Dialogue: 55,0:15:53.17,0:15:58.56,Main-207+,,0,0,0,,Yirmi yıl önce, tıpkı onun gibi küçük bir kızdım...Dialogue: 55,0:15:59.81,0:16:03.89,Main-207+,,0,0,0,,ama o gün yaşananları asla unutmayacağım.Dialogue: 55,0:16:09.23,0:16:12.24,Flashbacks-207+,,0,0,0,,Geleceğe... kaçın!Dialogue: 55,0:16:14.58,0:16:17.58,Flashbacks-207+,,0,0,0,,Anne, lütfen bunu yapma!Dialogue: 55,0:16:17.58,0:16:21.21,Flashbacks-207+,,0,0,0,,Anne! Anne!Dialogue: 55,0:16:23.76,0:16:27.16,Main-207+,,0,0,0,,Neler olduğuna dair hiçbir şey anlamıyordum.Dialogue: 55,0:16:28.01,0:16:30.59,Main-207+,,0,0,0,,O alevlerin ortasında,Dialogue: 55,0:16:30.59,0:16:35.21,Main-207+,,0,0,0,,abim ve diğerleri gözlerimin önünde kayboldu.Dialogue: 55,0:16:37.71,0:16:40.85,Main-207+,,0,0,0,,Babam Oden'i, üstüne bir de annemi...Dialogue: 55,0:16:40.85,0:16:42.39,Main-207+,,0,0,0,,kaybettiğim gündü.Dialogue: 55,0:16:42.96,0:16:45.58,Main-207+,,0,0,0,,Sadece bir günde, aniden her şeyimi yitirdim.Dialogue: 55,0:16:46.46,0:16:49.80,Main-207+,,0,0,0,,Bana abimin 20 yıl sonra geri döneceği söylendi...Dialogue: 55,0:16:50.46,0:16:55.55,Main-207+,,0,0,0,,ama her şey bu kadar belirsizken umudum gelip geçiciydi...Dialogue: 55,0:16:56.82,0:17:00.66,Main-207+,,0,0,0,,Bunca yıl devam edebilecek iradeye sahip değildim.Dialogue: 55,0:17:02.02,0:17:04.96,Main-207+,,0,0,0,,Neden sen de onlarla geleceğe gitmedin?Dialogue: 55,0:17:05.58,0:17:10.67,Main-207+,,0,0,0,,Yolculuk sırasında bana  ya da kardeşime bir zarar gelirse...Dialogue: 55,0:17:10.67,0:17:13.84,Main-207+,,0,0,0,,Kozuki soyunun bitmesini istemediler.Dialogue: 55,0:17:13.84,0:17:16.84,Main-207+,,0,0,0,,Bu çok zalimce.Dialogue: 55,0:17:16.84,0:17:20.43,Main-207+,,0,0,0,,Ama babamın hizmetkârı...Dialogue: 55,0:17:20.43,0:17:26.27,Main-207+,,0,0,0,,Kappa Kawamatsu, duygusal olarak bana hep destek oldu ve beni büyüttü.Dialogue: 55,0:17:26.27,0:17:27.23,Main-207+,,0,0,0,,Kappa mı?!Dialogue: 55,0:17:27.23,0:17:28.61,Main-207+,,0,0,0,,Evet.Dialogue: 55,0:17:28.61,0:17:34.91,Main-207+,,0,0,0,,Böylesi yaratıkların varlığına inanmak güç, fakat o kendiyle büyük gurur duyuyor.Dialogue: 55,0:17:35.86,0:17:39.51,Main-207+,,0,0,0,,Kalenin yandığı o gün, etrafımız düşman tarafından sarılmıştı...Dialogue: 55,0:17:39.51,0:17:44.41,Main-207+,,0,0,0,,ama hendekteki drenaj kanalını kullanarak tespit edilmeden kaçtık.Dialogue: 55,0:17:44.41,0:17:47.25,Main-207+,,0,0,0,,Prenses! Az daha sabredin!Dialogue: 55,0:17:50.99,0:17:54.63,Main-207+,,0,0,0,,Babamı, annemi ve kardeşimi kaybettikten sonra...Dialogue: 55,0:17:54.63,0:18:00.10,Main-207+,,0,0,0,,şokun etkisiyle dilsizleştim ama o hep beni neşelendirdi ve destekledi.Dialogue: 55,0:18:00.10,0:18:03.38,Flashbacks-207+,,0,0,0,,Prenses! Bu Kappa Dansı!Dialogue: 55,0:18:03.38,0:18:08.18,Flashbacks-207+,,0,0,0,,♪ Hadi! Kappappa, kappappa, ♪ ♪ kappappa ve pa! ♪Dialogue: 55,0:18:08.18,0:18:10.31,Flashbacks-207+,,0,0,0,,♪ Kappappa, kappappa... ♪Dialogue: 55,0:18:10.31,0:18:13.95,Flashbacks-207+,,0,0,0,,Hadi, yiyin Prenses.Dialogue: 55,0:18:18.60,0:18:21.07,Flashbacks-207+,,0,0,0,,Kawamatsu, sen de açsın, değil mi?Dialogue: 55,0:18:21.07,0:18:27.54,Flashbacks-207+,,0,0,0,,Hayır, midem bulanıyor, o yüzden bu sesleri çıkarıyor!Dialogue: 55,0:18:28.04,0:18:32.26,Flashbacks-207+,,0,0,0,,Lütfen... Lütfen en azından yarısını ye.Dialogue: 55,0:18:32.26,0:18:37.13,Flashbacks-207+,,0,0,0,,Hayır, iyiyim ben. Demin nehirde yüzen kızarmış bir balık buldum.Dialogue: 55,0:18:41.68,0:18:43.56,Flashbacks-207+,,0,0,0,,Nehirde yüzen kızarmış balık mı?Dialogue: 55,0:18:43.56,0:18:44.64,Flashbacks-207+,,0,0,0,,Evet!Dialogue: 55,0:18:45.27,0:18:50.31,Flashbacks-207+,,0,0,0,,Ben de şipşak ayıklayıp gelirken yolda yedim.Dialogue: 55,0:18:51.78,0:18:56.37,Main-207+,,0,0,0,,Kendi pek yemezdi ama karnımı doyurmak için çok çabalardı.Dialogue: 55,0:18:57.24,0:19:02.18,Main-207+,,0,0,0,,Sadık koruyucu meleğim, Kawamatsu sağ olsun...Dialogue: 55,0:19:02.18,0:19:05.24,Main-207+,,0,0,0,,yavaş yavaş yeniden gülmeyi öğrendim.Dialogue: 55,0:19:06.21,0:19:07.91,Main-207+,,0,0,0,,Şu an nerede peki?Dialogue: 55,0:19:08.70,0:19:12.57,Main-207+,,0,0,0,,Sanırım ben 13 yaşlarındayken...Dialogue: 55,0:19:12.57,0:19:13.96,Main-207+,,0,0,0,,ayrı düştük.Dialogue: 55,0:19:14.56,0:19:19.60,Main-207+,,0,0,0,,Ama Kawamatsu görkemli bir samuraydır.Dialogue: 55,0:19:19.60,0:19:24.84,Main-207+,,0,0,0,,Yani hâlâ bir yerlerde, büyük savaşın başlamasını bekliyor olmalı!Dialogue: 55,0:19:25.57,0:19:28.47,Main-207+,,0,0,0,,Onu ve diğerlerini görmeyi çok istiyorum.Dialogue: 55,0:19:28.47,0:19:30.47,Main-207+,,0,0,0,,Ben de kappa görmek istiyorum!Dialogue: 55,0:19:33.33,0:19:34.30,Main-207+,,0,0,0,,Hı hı!Dialogue: 55,0:19:35.21,0:19:36.14,Main-207+,,0,0,0,,Zorojuro-san.Dialogue: 55,0:19:37.45,0:19:42.40,Main-207+,,0,0,0,,Başka kimler büyük savaşa hazırlanıyor?Dialogue: 55,0:19:42.40,0:19:44.86,Main-207+,,0,0,0,,Şey...Dialogue: 55,0:19:44.86,0:19:46.67,Main-207+,,0,0,0,,Ne?!Dialogue: 55,0:19:46.67,0:19:49.83,Main-207+,,0,0,0,,O hâlde Köpecik-chan ve Kedicik-chan da mı burada?!Dialogue: 55,0:19:49.83,0:19:50.70,Main-207+,,0,0,0,,Evet.Dialogue: 55,0:19:50.70,0:19:56.16,Main-207+,,0,0,0,,İkisinin de öldüğünü duymuştum, bir daha göremeyeceğimi sandım!Dialogue: 55,0:19:56.16,0:20:00.60,Main-207+,,0,0,0,,Nekomamushi henüz Wano'da olmayabilir...Dialogue: 55,0:20:04.01,0:20:05.64,Main-207+,,0,0,0,,Ne yapıyorsun sen?Dialogue: 55,0:20:05.64,0:20:07.84,Main-207+,,0,0,0,,Çok mutluyum..Dialogue: 55,0:20:14.23,0:20:16.06,Main-207+,,0,0,0,,Gülmekten yarıyorsun insanı, abla!Dialogue: 55,0:20:20.47,0:20:22.22,Main-207+,,0,0,0,,Ama hayır, ağlamayacağım!Dialogue: 55,0:20:23.08,0:20:25.28,Main-207+,,0,0,0,,Ben bir samuray kızıyım!Dialogue: 55,0:20:25.28,0:20:28.27,Main-207+,,0,0,0,,Köpecik-chan ve Kedicik-chan da burada olacaklarsa...Dialogue: 55,0:20:28.27,0:20:32.67,Main-207+,,0,0,0,,tüm Dokuz Kızıl Kın üyeleri bir araya gelebilir!Dialogue: 55,0:20:32.67,0:20:34.62,Main-207+,,0,0,0,,Bundan pek emin değilim.Dialogue: 55,0:20:34.62,0:20:36.07,Main-207+,,0,0,8,,Kin'emon.Dialogue: 55,0:20:37.03,0:20:38.36,Main-207+,,0,0,8,,Kanjuro.Dialogue: 55,0:20:39.35,0:20:40.85,Main-207+,,0,0,8,,Raizo.Dialogue: 55,0:20:41.78,0:20:43.51,Main-207+,,0,0,8,,Okiku.Dialogue: 55,0:20:44.36,0:20:45.80,Main-207+,,0,0,8,,Inuarashi.Dialogue: 55,0:20:46.92,0:20:48.39,Main-207+,,0,0,8,,Nekomamushi.Dialogue: 55,0:20:52.38,0:20:57.36,Main-207+,,0,0,8,,Tüm bildiklerimiz bu altısı ve Momonosuke.Dialogue: 55,0:20:57.36,0:21:00.95,Main-207+,,0,0,8,,Henüz diğer üçüyle tanışmadık.Dialogue: 55,0:21:00.95,0:21:05.12,Main-207+,,0,0,8,,Sana o üçünün ilkini anlatmıştım, Kawamatsu...Dialogue: 55,0:21:05.12,0:21:07.54,Main-207+,,0,0,8,,ve ayrıca Denjiro'yla Ashura Doji de var.Dialogue: 55,0:21:07.54,0:21:13.53,Main-207+,,0,0,0,,Neredeler, sağ mılar değiller mi bilmiyorum...Dialogue: 55,0:21:14.69,0:21:19.42,Main-207+,,0,0,0,,Ama şimdi başkentteki herkes bu ilan yüzünden kargaşa içindeyken,Dialogue: 55,0:21:19.42,0:21:21.88,Main-207+,,0,0,0,,kesinlikle kendilerini göstereceklerdir!Dialogue: 55,0:21:21.88,0:21:25.63,Main-207+,,0,0,0,,İsyancılara dağıttığımız el ilanı değil mi o?Dialogue: 55,0:21:25.63,0:21:26.96,Main-207+,,0,0,0,,Evet.Dialogue: 55,0:21:26.96,0:21:33.05,Main-207+,,0,0,0,,O hengame sayesinde mesaj hızla yayıldı. İyi bir şeymiş gibi görünse de...Dialogue: 55,0:21:33.05,0:21:35.51,Main-207+,,0,0,0,,aslında bizi zor duruma soktu.Dialogue: 55,0:21:35.51,0:21:39.58,Main-207+,,0,0,0,,Buluşma yerimiz ifşa oldu ve müttefiklerimiz bir bir yakalanıyor.Dialogue: 55,0:21:40.45,0:21:42.94,Main-207+,,0,0,0,,Gidişat pek hayra alamet değil.Dialogue: 55,0:21:42.94,0:21:44.69,Main-207+,,0,0,0,,Her şey iyi olacaktır.Dialogue: 55,0:21:45.57,0:21:48.07,Main-207+,,0,0,0,,Buna yürekten inanıyorum.Dialogue: 55,0:21:48.07,0:21:48.65,Main-207+,,0,0,0,,Şey...Dialogue: 55,0:21:51.70,0:21:57.50,Main-207+,,0,0,0,,Nerede çokluk orada bokluk. Artık dert etmeyeceğim.Dialogue: 55,0:21:57.50,0:21:59.06,Main-207+,,0,0,0,,Ah, evet! Kesinlikle!Dialogue: 55,0:21:59.06,0:22:03.00,Main-207+,,0,0,0,,Her şeyden önce, iyileşmene bakmalısın!Dialogue: 55,0:22:03.00,0:22:05.36,Main-207+,,0,0,0,,Şimdi, güzelce dinlen.Dialogue: 55,0:22:05.36,0:22:07.81,Main-207+,,0,0,0,,Tamam, iki kere söylemene gerek yok.Dialogue: 55,0:22:10.75,0:22:12.49,Main-207+,,0,0,0,,Otoko, bu bir mucize!Dialogue: 55,0:22:12.49,0:22:13.72,Main-207+,,0,0,0,,Şu an çok mutluyum!Dialogue: 55,0:22:14.80,0:22:17.22,Main-207+,,0,0,0,,Kardeşim yaşıyor!Dialogue: 55,0:22:18.60,0:22:20.85,Main-207+,,0,0,0,,Senin adına mutluyum, abla!Dialogue: 55,0:22:24.10,0:22:26.41,Main-207+,,0,0,0,,Hem de çok, abla!Dialogue: 55,0:22:26.41,0:22:27.98,Main-207+,,0,0,0,,Toko, bu harika!Dialogue: 55,0:22:31.63,0:22:35.16,Thoughts-207+,,0,0,0,,Daha sessiz olamazlar mı? Burada uyumaya çalışıyoruz!Dialogue: 55,0:22:41.16,0:22:42.71,Main-207+,,0,0,0,,Ama hâlâ sekiz yaşında!Dialogue: 55,0:22:42.71,0:22:44.58,Main-207+,,0,0,0,,Çok tuhaf.Dialogue: 55,0:22:45.11,0:22:47.67,Main-207+,,0,0,0,,Abim hâlâ bir çocuk.Dialogue: 55,0:22:47.67,0:22:51.68,Main-207+,,0,0,0,,Sanıyorum Kin'emon ve diğerleri de 20 yıl genç kaldılar.Dialogue: 55,0:22:51.68,0:22:55.48,Main-207+,,0,0,0,,Karşılaşacağımız ânı düşünmekten kafayı yiyeceğim.Dialogue: 55,0:22:55.48,0:22:59.20,Main-207+,,0,0,0,,Belki de büyük savaş öncesinde onları görmemem daha iyi olur.Dialogue: 55,0:22:59.20,0:23:03.65,Main-207+,,0,0,0,,Varlığım samuraylarının kararlılığını zayıflatabilir.Dialogue: 55,0:23:03.65,0:23:05.44,Main-207+,,0,0,0,,Değil mi, Otoko?Dialogue: 55,0:23:29.78,0:23:34.02,Main-207+,,0,0,0,,Bu kadar serseriyi enseliyeceklerini beklemiyordum!Dialogue: 55,0:23:34.02,0:23:38.22,Main-207+,,0,0,0,,Millet, onlara iyice, uzun uzun bakın!Dialogue: 55,0:23:38.22,0:23:46.15,Main-207+,,0,0,0,,Orochi-sama ve Kaido-sama'ya karşı gelen bu budalaların hâline bakın!Dialogue: 55,0:23:51.74,0:23:53.49,Main-207+,,0,0,0,,Kaldır o koca kıçını!Dialogue: 55,0:23:58.93,0:24:00.75,Main-207+,,0,0,0,,Sizler için üzülüyorum.Dialogue: 55,0:24:00.75,0:24:04.08,Main-207+,,0,0,0,,Planlarınız çoktan suya düştü.Dialogue: 55,0:24:04.77,0:24:06.54,Main-207+,,0,0,0,,Başarısız oldunuz.Dialogue: 55,0:24:06.54,0:24:09.20,Main-207+,,0,0,0,,Fukurokuju-dono, lütfen bekleyin!Dialogue: 55,0:24:09.20,0:24:13.34,Main-207+,,0,0,0,,Hangi akla hizmet bu bilek dövmesinin bizi isyancı yaptığını düşünürsünüz?!Dialogue: 55,0:24:13.34,0:24:17.80,Main-207+,,0,0,0,,Alt tarafı popüler bir sembol bu! Bizim isyanla falan alakamız yok!Dialogue: 55,0:24:17.80,0:24:22.51,Main-207+,,0,0,0,,Kes! Öyleyse bu ilanı nasıl açıklayacaksınız?!Dialogue: 55,0:24:24.04,0:24:28.51,Main-207+,,0,0,0,,İlanının ortasında ters hilal var.Dialogue: 55,0:24:28.51,0:24:33.98,Main-207+,,0,0,0,,Orochi-sama'ya karşı isyana işaret eden bir sembol olduğunu varsayıyorum!Dialogue: 55,0:24:33.98,0:24:37.16,Main-207+,,0,0,0,,Tıpkı dövmeleriniz gibi.Dialogue: 55,0:24:37.72,0:24:42.12,Main-207+,,0,0,0,,Bu emri Orochi-sama verdi, o yüzden oturun ve kapayın çenenizi!Dialogue: 55,0:24:54.06,0:24:56.09,Main-207+,,0,0,0,,Büyük bir çıkmazın içine girdik.Dialogue: 55,0:24:56.09,0:24:58.30,Main-207+,,0,0,0,,Herkes bizim...Dialogue: 55,0:24:59.96,0:25:02.69,Main-207+,,0,0,0,,planı sızdırdığımızı sanacak.Dialogue: 55,0:25:05.47,0:25:06.56,Main-207+,,0,0,0,,Endişelenmeyin!Dialogue: 55,0:25:06.56,0:25:10.90,Main-207+,,0,0,0,,Kaptanımız bize inanacaktır!Dialogue: 55,0:25:26.67,0:25:32.13,Main-207+,,0,0,0,,Haydi, haydi! Basın götlerine tekmeyi!Dialogue: 55,0:25:36.14,0:25:38.92,Main-207+,,0,0,0,,Bu sumo maçında ben de rol almak istiyorum!Dialogue: 55,0:25:38.92,0:25:45.52,Main-207+,,0,0,0,,Ben Madillo Adam! Armadillo GÜLÜCÜK meyvesi yiyerek yetenekli oldum!Dialogue: 55,0:25:50.11,0:25:53.26,Main-207+,,0,0,0,,Ah, bedenin oldukça sağlam görünüyor.Dialogue: 55,0:25:53.26,0:25:54.74,Main-207+,,0,0,0,,Antrenmanım için harikasın!Dialogue: 55,0:25:54.74,0:25:56.19,Main-207+,,0,0,0,,Seni ahmak!Dialogue: 55,0:25:56.19,0:26:00.75,Main-207+,,0,0,0,,Bu lanet şeylerin mermileri deniz taşından yapılma!Dialogue: 55,0:26:03.36,0:26:05.91,Main-207+,,0,0,0,,İşiniz bitti, arkadaşlar!Dialogue: 55,0:26:07.49,0:26:09.13,Main-207+,,0,0,0,,İşleri "bitti" mi?Dialogue: 55,0:26:09.13,0:26:14.75,Main-207+,,0,0,0,,Bu gerzekler bu kadar kör mü?! Henüz "bitti"nin "b"sinde bile değiller.Dialogue: 55,0:26:16.27,0:26:17.18,Main-207+,,0,0,0,,İhtiyar.Dialogue: 55,0:26:17.18,0:26:20.21,Main-207+,,0,0,0,,Sağa git, eğil ve sonra sıçra.Dialogue: 55,0:26:20.21,0:26:20.92,Main-207+,,0,0,0,,Ha?!Dialogue: 55,0:26:20.92,0:26:22.14,Main-207+,,0,0,0,,Geberin!Dialogue: 55,0:26:22.14,0:26:22.94,Main-207+,,0,0,0,,Koş!Dialogue: 55,0:26:22.94,0:26:23.80,Main-207+,,0,0,0,,Tamam!Dialogue: 55,0:26:24.80,0:26:26.26,Main-207+,,0,0,0,,Sağa git!Dialogue: 55,0:26:27.22,0:26:28.22,Main-207+,,0,0,0,,Eğil!Dialogue: 55,0:26:28.22,0:26:30.40,Main-207+,,0,0,0,,Ve...Dialogue: 55,0:26:29.60,0:26:30.39,Secondary-207+,,0,0,0,,Seni bücür..!Dialogue: 55,0:26:30.40,0:26:31.56,Main-207+,,0,0,0,,...sıçra!Dialogue: 55,0:26:39.62,0:26:41.82,Main-207+,,0,0,0,,– Neee?! – Neee?!Dialogue: 55,0:26:41.82,0:26:43.82,Main-207+,,0,0,0,,Ay, ay, ay...Dialogue: 55,0:26:44.91,0:26:46.79,Main-207+,,0,0,0,,Kahretsin, kahretsin, kahretsin!Dialogue: 55,0:26:48.84,0:26:51.04,Main-207+,,0,0,0,,İyi işti, ihtiyar! Böyle devam et!Dialogue: 55,0:26:51.04,0:26:55.42,Main-207+,,0,0,0,,Bu da neydi?! Geleceği falan mı görebiliyorsun?Dialogue: 55,0:26:55.42,0:26:56.76,Main-207+,,0,0,0,,Sıçayım sana!Dialogue: 55,0:26:56.76,0:27:01.67,Main-207+,,0,0,0,,Bu tam bir saçmalık! Tam olarak ne yaptın sen?!Dialogue: 55,0:27:08.31,0:27:10.19,Main-207+,,0,0,0,,İhtiyar! Şimdi sola git!Dialogue: 55,0:27:10.19,0:27:10.94,Main-207+,,0,0,0,,Ne?!Dialogue: 55,0:27:10.94,0:27:12.56,Main-207+,,0,0,0,,Seni...!Dialogue: 55,0:27:12.56,0:27:14.14,Main-207+,,0,0,0,,Sola!Dialogue: 55,0:27:15.53,0:27:18.31,Main-207+,,0,0,0,,Lanet olsun, seni boklu ihtiyar!Dialogue: 55,0:27:18.31,0:27:19.61,Main-207+,,0,0,0,,Al bakalım!Dialogue: 55,0:27:24.50,0:27:27.62,Main-207+,,0,0,0,,Sola! Sola! Sola! Sola!Dialogue: 55,0:27:30.89,0:27:32.13,Main-207+,,0,0,0,,Seni hilebaz!Dialogue: 55,0:27:36.09,0:27:37.22,Main-207+,,0,0,0,,Tam on ikiden!Dialogue: 55,0:27:44.45,0:27:46.56,Main-207+,,0,0,0,,Bana kurşun işlemez.Dialogue: 55,0:27:47.89,0:27:50.69,Main-207+,,0,0,0,,S-Seni sinsi piç..!Dialogue: 55,0:27:58.58,0:28:01.28,Main-207+,,0,0,0,,Henüz bitirmedim!Dialogue: 55,0:28:01.95,0:28:04.08,Main-207+,,0,0,0,,Temas etmeden onu savur!Dialogue: 55,0:28:10.58,0:28:11.89,Main-207+,,0,0,0,,İstediğim bu değil.Dialogue: 55,0:28:11.89,0:28:13.91,Main-207+,,0,0,0,,Bu dümdüz silahlanma hakisi.Dialogue: 55,0:28:17.13,0:28:18.97,Main-207+,,0,0,0,,Hay sokayım!Dialogue: 55,0:28:20.01,0:28:21.92,Main-207+,,0,0,0,,Armadi-Koruması!Dialogue: 55,0:28:25.93,0:28:26.98,Main-207+,,0,0,0,,Bu da değil.Dialogue: 55,0:28:26.98,0:28:29.97,Main-207+,,0,0,0,,Hâlâ normal silahlanma.Dialogue: 55,0:28:29.97,0:28:32.24,Main-207+,,0,0,0,,Ha?! Bana vurmayacak mıydın?!Dialogue: 55,0:28:33.93,0:28:37.01,Main-207+,,0,0,0,,Alpaka Eskrimi!Dialogue: 55,0:28:37.01,0:28:39.69,Main-207+,,0,0,0,,Hey! Şimdi hangi yöne gitmeliyim?!Dialogue: 55,0:28:39.69,0:28:43.07,Main-207+,,0,0,0,,Bay Hasır Şapka!Dialogue: 55,0:28:43.07,0:28:45.16,Main-207+,,0,0,0,,Pekâlâ! Orada dur bakalım!Dialogue: 55,0:28:45.16,0:28:46.44,Main-207+,,0,0,0,,Böyle iyi mi?!Dialogue: 55,0:28:51.35,0:28:53.20,Main-207+,,0,0,0,,Böylesi daha kolay olacak!Dialogue: 55,0:28:53.20,0:28:55.12,Main-207+,,0,0,0,,Çok üzgünüm..!Dialogue: 55,0:28:55.12,0:28:57.23,Main-207+,,0,0,0,,Hazır olduğunda başlayalım, Alpaka Adam!Dialogue: 55,0:28:57.23,0:28:58.36,Main-207+,,0,0,0,,Hazırım!Dialogue: 55,0:28:59.71,0:29:05.06,Main-207+,,0,0,0,,Beni aşağı indir! Sana yük olmam hiç adil değil!Dialogue: 55,0:29:06.16,0:29:09.51,Main-207+,,0,0,0,,Hayır. Aslında ne kadar ağır o kadar iyi.Dialogue: 55,0:29:09.51,0:29:10.68,Main-207+,,0,0,0,,Ne?!Dialogue: 55,0:29:15.36,0:29:17.10,Main-207+,,0,0,0,,Antrenmanım için..!Dialogue: 55,0:29:22.42,0:29:24.69,Main-207+,,0,0,0,,Anladım, anladım!Dialogue: 55,0:29:26.45,0:29:32.53,Main-207+,,0,0,0,,Bu el ilanı sayesinde yaklaşan savaşla ilgili her şeyi öğrendik!Dialogue: 55,0:29:32.53,0:29:38.26,Main-207+,,0,0,0,,Yanan iki kuş... Ateş Festivali'nin olduğu gün tan vaktinde demek!Dialogue: 55,0:29:38.26,0:29:42.54,Main-207+,,0,0,0,,Baskın için buluşma noktası ise Habu Limanı!Dialogue: 55,0:29:38.26,0:29:42.54,Note-207+,,0,0,0,,Habu: EngerekDialogue: 55,0:29:43.19,0:29:46.81,Main-207+,,0,0,0,,Kin'emon-kun bunun için beynini fazla zorlamış olmalı.Dialogue: 55,0:29:47.65,0:29:49.84,Main-207+,,0,0,0,,Kin'emon... kun?Dialogue: 55,0:29:50.76,0:29:53.75,Main-207+,,0,0,0,,Ah, neden bana öyle bakıyorsun...Dialogue: 55,0:29:53.75,0:29:55.27,Main-207+,,0,0,0,,Shinobu-chan?!Dialogue: 55,0:29:57.42,0:30:01.95,Main-207+,,0,0,0,,Peki anlıyorum. Suratlarınızın bu kadar asılması şaşıralacak bir şey değil.Dialogue: 55,0:30:01.95,0:30:05.01,Main-207+,,0,0,0,,Düşmanlarımız da bunun farkındaysa...Dialogue: 55,0:30:05.01,0:30:07.99,Main-207+,,0,0,0,,plan suya düştü demek.Dialogue: 55,0:30:08.76,0:30:11.74,Main-207+,,0,0,0,,Evet, bu doğru.Dialogue: 55,0:30:12.26,0:30:16.37,Main-207+,,0,0,0,,İsyanımızın işareti olan ters hilal dövmesini taşıyan dostlarımız...Dialogue: 55,0:30:16.37,0:30:18.71,Main-207+,,0,0,0,,şu an tek tek avlanıyor.Dialogue: 55,0:30:21.07,0:30:25.55,Main-207+,,0,0,0,,Keşke bir yolunu bulup, "Hepsi bir numaraydı!" diyerek her şeyi geri alabilseydik!Dialogue: 55,0:30:25.55,0:30:29.09,Main-207+,,0,0,0,,Ama bu, müttefiklerini de yanıltır.Dialogue: 55,0:30:30.38,0:30:35.69,Main-207+,,0,0,0,,Tüm bunlardan önce, şu ayak bileğindeki hilal dövmesi meselesini bilmiyordum.Dialogue: 55,0:30:35.69,0:30:38.51,Main-207+,,0,0,0,,Benim gibi olan tüm o müttefikleri düşünün!Dialogue: 55,0:30:52.46,0:30:55.24,Main-207+,,0,0,0,,Bu da değildi! Bir türlü doğru yapamıyorum!Dialogue: 55,0:30:55.24,0:30:56.42,Main-207+,,0,0,0,,Ne?!Dialogue: 55,0:30:57.38,0:31:02.28,Main-207+,,0,0,0,,Deminden beri kime vursan "Bu değil!" dedin!Dialogue: 55,0:31:02.28,0:31:04.13,Main-207+,,0,0,0,,Ne yapmaya çalışıyorsun?Dialogue: 55,0:31:04.13,0:31:07.79,Main-207+,,0,0,0,,Düşmana temas etmeden onu savuracak bir yumruk atmak istiyorum!Dialogue: 55,0:31:07.79,0:31:09.81,Main-207+,,0,0,0,,Bunu başarırsam...Dialogue: 55,0:31:09.81,0:31:14.02,Main-207+,,0,0,0,,sanırım Kaido'nun sert derisini delip geçebilirim!Dialogue: 55,0:31:14.02,0:31:16.77,Main-207+,,0,0,0,,Düşmana temas etmeden savurmak mı?Dialogue: 55,0:31:16.77,0:31:20.60,Main-207+,,0,0,0,,Evet. Denemeden çalıştığını bilemem.Dialogue: 55,0:31:20.60,0:31:23.10,Main-207+,,0,0,0,,Gerçi, önceden çalıştığını gördüm...Dialogue: 55,0:31:24.00,0:31:25.03,Main-207+,,0,0,0,,Hem Rayleigh...Dialogue: 55,0:31:27.00,0:31:29.36,Main-207+,,0,0,0,,hem de o baltalı adam...Dialogue: 55,0:31:30.49,0:31:32.94,Main-207+,,0,0,0,,ikisi de aynı silahlanma hakisini kullanmıştı.Dialogue: 55,0:31:32.94,0:31:35.21,Main-207+,,0,0,0,,Onlarınki benimkinden nasıl farklı?!Dialogue: 55,0:31:35.21,0:31:38.17,Main-207+,,0,0,0,,Haki yabancıların kullandığı terim olmalı.Dialogue: 55,0:31:38.17,0:31:40.21,Main-207+,,0,0,0,,Bir şeyler biliyor musun?!Dialogue: 55,0:31:40.21,0:31:45.17,Main-207+,,0,0,0,,Wano'da biz, bedenden akan ve kılıcı saran görünmez bir güç kullanırız.Dialogue: 55,0:31:46.08,0:31:49.29,Main-207+,,0,0,0,,İyi bir kılıç, sen istediğinde demiri bile keser;Dialogue: 55,0:31:49.29,0:31:52.39,Main-207+,,0,0,0,,istemediğinde ise bir kağıdı bile çizmez.Dialogue: 55,0:31:52.39,0:31:55.10,Main-207+,,0,0,0,,Kılıcı kullananın takdirine bağlıdır!Dialogue: 55,0:32:06.02,0:32:07.49,Main-207+,,0,0,0,,İhtiyar..!Dialogue: 55,0:32:07.49,0:32:10.36,Main-207+,,0,0,0,,Şu bunağa bir bakın! Ölmek mi istiyorsun?!Dialogue: 55,0:32:11.32,0:32:13.52,Main-207+,,0,0,0,,Bay Hasır Şapka.Dialogue: 55,0:32:13.52,0:32:18.81,Main-207+,,0,0,0,,Kılıç dövüşlerinde ustalaşarak kazandığım gücü seyret!Dialogue: 55,0:32:24.98,0:32:29.52,Thoughts-207+,,0,0,0,,Aptalca bir infaz oyununun merkezinde olmamıza rağmen...Dialogue: 55,0:32:29.52,0:32:33.84,Thoughts-207+,,0,0,0,,bunu antrenman için bir fırsat olarak mı görüyor?!Dialogue: 55,0:32:35.30,0:32:37.69,Main-207+,,0,0,0,,Bay Hasır Şapka! Yönlendir beni!Dialogue: 55,0:32:38.61,0:32:39.30,Main-207+,,0,0,0,,Tamam!Dialogue: 55,0:32:46.92,0:32:49.57,Main-207+,,0,0,0,,Tüm gücüyle sağ kılıcını savuracak!Dialogue: 55,0:32:50.31,0:32:51.99,Main-207+,,0,0,0,,Anlaşıldı!Dialogue: 55,0:33:06.08,0:33:08.62,Main-207+,,0,0,0,,Seni boklu ihtiyar!Dialogue: 55,0:33:36.70,0:33:38.25,Main-207+,,0,0,0,,Onu geriye uçurdu!Dialogue: 55,0:33:46.08,0:33:47.17,Main-207+,,0,0,0,,İhtiyar...Dialogue: 55,0:33:47.92,0:33:52.12,Main-207+,,0,0,0,,İhtiyar Hyo, yetenekliyi devirdi!Dialogue: 55,0:33:52.12,0:33:53.51,Main-207+,,0,0,0,,Alpaka Adam!Dialogue: 55,0:33:56.53,0:34:01.94,Main-207+,,0,0,0,,Şu çelimsiz ihtiyar... Sözde bir ayağı çukurdaydı.Dialogue: 55,0:34:01.94,0:34:05.06,Main-207+,,0,0,0,,Ama şaşırtıcı derecede dinçmiş!Dialogue: 55,0:34:07.68,0:34:09.90,Main-207+,,0,0,0,,İhtiyar Hyo gerçekten de...Dialogue: 55,0:34:09.90,0:34:12.61,Main-207+,,0,0,0,,meşhur Çiçek Hyogoro olabilir mi?!Dialogue: 55,0:34:15.69,0:34:17.54,Main-207+,,0,0,0,,Bay Hasır Şapka...Dialogue: 55,0:34:19.15,0:34:23.41,Main-207+,,0,0,0,,peşinde olduğun şey bunun gibi bir şeyse...Dialogue: 55,0:34:24.13,0:34:27.24,Main-207+,,0,0,0,,belki biraz yardımım dokunabilir.Dialogue: 55,0:34:32.51,0:34:34.05,Main-207+,,0,0,0,,Bana öğretmelisin!Dialogue: 55,0:34:35.64,0:34:37.88,Main-207+,,0,0,0,,İstediğim tam olarak buydu!Dialogue: 0,0:02:27.87,0:02:33.17,Title-207+,,0,0,0,,Kadının SırrıDialogue: 1,0:02:27.87,0:02:33.17,Title-207+,,0,0,0,,Kadının SırrıDialogue: 0,0:01:50.09,0:01:53.42,Captions Wano,,0,0,0,,Kin'emon ve Mink Silahşorları Terkedilmiş bir köyde KuriDialogue: 1,0:01:50.09,0:01:53.42,Captions Wano,,0,0,0,,Kin'emon ve Mink Silahşorları Terkedilmiş bir köyde KuriDialogue: 0,0:04:02.93,0:04:07.97,Captions Wano,,0,0,0,,Çiçek Başkenti Zevk MekânıDialogue: 1,0:04:02.93,0:04:07.97,Captions Wano,,0,0,0,,Çiçek Başkenti Zevk MekânıDialogue: 0,0:05:06.53,0:05:13.08,Captions Wano,,0,0,0,,Ebisu KasabasıDialogue: 1,0:05:06.53,0:05:13.08,Captions Wano,,0,0,0,,Ebisu KasabasıDialogue: 0,0:08:20.85,0:08:26.27,Captions Wano,,0,0,0,,Ringo Kuzey MezarlığıDialogue: 1,0:08:20.85,0:08:26.27,Captions Wano,,0,0,0,,Ringo Kuzey MezarlığıDialogue: 0,0:12:13.16,0:12:16.41,Sign-Otoko,Base,0,0,0,,ODialogue: 2,0:12:13.16,0:12:16.41,Sign-Otoko,White dots 2,0,0,0,,ODialogue: 2,0:12:13.16,0:12:16.41,Sign-Otoko,Border,0,0,0,,ODialogue: 0,0:12:11.79,0:12:16.41,Sign-Otoko,Base,0,0,0,,TOKODialogue: 2,0:12:11.79,0:12:16.41,Sign-Otoko,White dots 2,0,0,0,,TOKODialogue: 2,0:12:11.79,0:12:16.41,Sign-Otoko,Border,0,0,0,,TOKODialogue: 0,0:20:50.72,0:20:58.98,Captions Wano,,0,0,0,,Dokuz Kızıl KınDialogue: 1,0:20:50.72,0:20:58.98,Captions Wano,,0,0,0,,Dokuz Kızıl KınDialogue: 0,0:21:03.70,0:21:07.16,Captions Wano,,0,0,0,,KAWAMATSUDialogue: 0,0:21:03.70,0:21:07.54,Captions Wano,,0,0,0,,DENJIRODialogue: 0,0:21:04.08,0:21:07.54,Captions Wano,,0,0,0,,ASHURA DOJIDialogue: 0,0:23:15