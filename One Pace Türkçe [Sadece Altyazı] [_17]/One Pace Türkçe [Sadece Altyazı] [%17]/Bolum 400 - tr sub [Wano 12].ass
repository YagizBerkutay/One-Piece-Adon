,1,2.25,0,8,15,15,15,1Style: Karaoke,Duality,82,&H009E375F,&H009E375F,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,4.5,0,8,15,15,15,1Style: Translation,Duality,82,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,4.5,0,2,15,15,15,1Style: Sign-OP,Captain Redemption,375,&H0015181B,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0,0,2,15,15,15,1Style: Sign-Wano,KG Ten Thousand Reasons Alt,60,&H005B57D2,&H000000FF,&H00000000,&H00000000,-1,0,0,0,100,100,0,0,1,0,0,2,15,15,15,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:41.87,0:01:51.86,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 50,0:01:41.86,0:01:44.62,Main-207+,,0,0,0,,Yanıma alıp kaçmaktan başka çarem yok!Dialogue: 50,0:01:47.10,0:01:49.63,Main-207+,,0,0,0,,O kadar dayanıklılığım kalmıştır.Dialogue: 50,0:01:49.63,0:01:50.96,Main-207+,,0,0,0,,Oda!Dialogue: 50,0:01:55.13,0:01:56.30,Main-207+,,0,0,0,,Değişi–Dialogue: 50,0:01:58.55,0:02:00.88,Main-207+,,0,0,0,,Güçsüz hissediyorum..!Dialogue: 50,0:02:03.43,0:02:06.01,Main-207+,,0,0,0,,Hiç uğraşma Trafalgar.Dialogue: 50,0:02:07.31,0:02:10.81,Main-207+,,0,0,0,,Yine mi sen? Tam da sırasıydı!Dialogue: 50,0:02:10.81,0:02:16.02,Main-207+,,0,0,0,,Her yerde kullanılan deniz taşı Wano'da icat edilmiştir.Dialogue: 50,0:02:17.57,0:02:20.57,Main-207+,,0,0,0,,Deniz taşından... çivi mi?!Dialogue: 50,0:02:20.96,0:02:26.33,Main-207+,,0,0,0,,Bu kadar küçük şekle sokabilen ustaları Wano dışında bulamazsın.Dialogue: 50,0:02:28.37,0:02:29.87,Main-207+,,0,0,0,,Hasır Kılıç!Dialogue: 50,0:02:40.05,0:02:43.01,Main-207+,,0,0,0,,Hay sikeyim! Daha beteri olamazdı!Dialogue: 50,0:02:46.02,0:02:47.22,Main-207+,,0,0,0,,Oda!Dialogue: 50,0:02:48.64,0:02:49.97,Main-207+,,0,0,0,,Değişim!Dialogue: 50,0:02:52.27,0:02:54.23,Main-207+,,0,0,0,,Epey sinir bozucu bir yetenek.Dialogue: 50,0:02:57.94,0:02:59.86,Main-207+,,0,0,0,,Fazla uzaklaşamaz.Dialogue: 50,0:03:00.57,0:03:03.55,Main-207+,,0,0,0,,Civarda saklanıyordur, aramaya koyulun!Dialogue: 50,0:03:03.55,0:03:04.62,Main-207+,,0,0,0,,– Başüstüne! – Başüstüne!Dialogue: 50,0:03:13.79,0:03:15.52,Main-207+,,0,0,0,,Hücreye tıkın!Dialogue: 50,0:03:15.52,0:03:17.34,Main-207+,,0,0,0,,– B-Başüstüne, efendim! – B-Başüstüne, efendim!Dialogue: 50,0:03:17.34,0:03:21.19,Main-207+,,0,0,0,,Burnu sürtüldükten sonra bundan iyi asker olur!Dialogue: 50,0:03:21.19,0:03:22.82,Main-207+,,0,0,0,,– E-Emredersiniz! – E-Emredersiniz!Dialogue: 50,0:03:22.82,0:03:25.74,Main-207+,,0,0,0,,Bildirilerde korsan ibaresini dahi geçirmeyin.Dialogue: 50,0:03:25.74,0:03:27.01,Main-207+,,0,0,0,,– Tabii, efendim! – Tabii, efendim!Dialogue: 50,0:03:27.64,0:03:34.40,Main-207+,,0,0,0,,Ülkenin cahil halkının dış dünyayı biraz olsun merak etmesini istemiyorum.Dialogue: 50,0:03:34.40,0:03:35.32,Main-207+,,0,0,0,,– Başüstüne! – Başüstüne!Dialogue: 50,0:03:35.32,0:03:36.67,Main-207+,,0,0,0,,Götürelim!Dialogue: 50,0:03:36.67,0:03:39.32,Main-207+,,0,0,0,,Lan, dikilmeyin de ayaklarından tutun!Dialogue: 50,0:03:39.32,0:03:40.15,Main-207+,,0,0,0,,– Peki! – Peki!Dialogue: 50,0:04:05.43,0:04:07.39,Main-207+,,0,0,0,,Sen de kullanabiliyorsun demek,Dialogue: 50,0:04:07.39,0:04:09.93,Main-207+,,0,0,0,,velet!Dialogue: 50,0:04:12.39,0:04:14.19,Main-207+,,0,0,0,,Mümkün değil!Dialogue: 50,0:04:16.56,0:04:19.90,Main-207+,,0,0,0,,Oden-sama'nın tekniğini kullandı!Dialogue: 50,0:04:20.47,0:04:24.03,Main-207+,,0,0,0,,Baygın hâlde olmasına rağmen mi kullanabildi?Dialogue: 50,0:04:26.33,0:04:30.29,Main-207+,,0,0,0,,Bu velet de kimin nesi böyle?Dialogue: 50,0:04:34.50,0:04:37.34,Main-207+,,0,0,0,,Kid veledi de kralın hakisini kullanıyor!Dialogue: 50,0:04:37.34,0:04:40.92,Main-207+,,0,0,0,,Bu kadar çok...Dialogue: 50,0:04:40.92,0:04:43.67,Main-207+,,0,0,0,,krala hacet yok!Dialogue: 50,0:04:58.09,0:05:01.00,Main-207+,,0,0,0,,Trafalgar sonraya artık,Dialogue: 50,0:05:01.00,0:05:03.69,Main-207+,,0,0,0,,şimdi kafayı çekeceğim.Dialogue: 50,0:05:07.40,0:05:11.62,Main-207+,,0,0,0,,Ulan iyice ayıldım.Dialogue: 50,0:05:52.71,0:05:55.67,Main-207+,,0,0,0,,Deniz taşından çivi mi?Dialogue: 50,0:05:55.67,0:05:58.79,Main-207+,,0,0,0,,Böyle bir şeyi ilk kez duyuyorum!Dialogue: 50,0:06:00.67,0:06:02.09,Main-207+,,0,0,0,,Vaziyet sakat.Dialogue: 50,0:06:02.09,0:06:04.67,Flashbacks-207+,,0,0,0,,– Kaptan! – Kaptan!Dialogue: 50,0:06:05.78,0:06:08.76,Main-207+,,0,0,0,,Bepolar'ın durumu iyi midir acaba?Dialogue: 50,0:06:14.93,0:06:16.61,Main-207+,,0,0,0,,Hawkins-sama!Dialogue: 50,0:06:16.61,0:06:18.73,Main-207+,,0,0,0,,Trafalgar'ı buldunuz mu?Dialogue: 50,0:06:18.73,0:06:23.00,Main-207+,,0,0,0,,Bakmadığımız delik kalmadı ama hiçbir yerde bulamadık!Dialogue: 50,0:06:23.00,0:06:26.56,Main-207+,,0,0,0,,Çoktan kasabadan çıkmış olabilir.Dialogue: 50,0:06:28.00,0:06:29.78,Main-207+,,0,0,0,,Kelepçeleyin.Dialogue: 50,0:06:29.78,0:06:31.03,Main-207+,,0,0,0,,– Emredersiniz! – Emredersiniz!Dialogue: 50,0:06:38.84,0:06:43.04,Main-207+,,0,0,0,,Hasır Şapka'yı yakalamak bile şimdilik fazlasıyla kâfi...Dialogue: 50,0:06:43.04,0:06:48.30,Main-207+,,0,0,0,,fakat ne pahasına olursa olsun, Trafalgar Law'u da avlayacağım!Dialogue: 50,0:06:48.30,0:06:50.57,Main-207+,,0,0,0,,Elimden kaçamayacak!Dialogue: 50,0:06:55.99,0:06:57.52,Main-207+,,0,0,0,,Gorobe-san!Dialogue: 50,0:06:57.52,0:06:59.14,Main-207+,,0,0,0,,Sık dişini!Dialogue: 50,0:07:02.54,0:07:05.08,Main-207+,,0,0,0,,Hemen yaralarınla ilgileniyorum.Dialogue: 50,0:07:07.87,0:07:10.00,Main-207+,,0,0,0,,Düşündüğüm gibi, bu ses...Dialogue: 50,0:07:10.00,0:07:12.34,Main-207+,,0,0,0,,Özür dilemek istiyorum ya...Dialogue: 50,0:07:13.70,0:07:17.62,Main-207+,,0,0,0,,Luffytaro-san'dan özür dilemek istiyorum...Dialogue: 50,0:07:18.04,0:07:24.08,Main-207+,,0,0,0,,O kadar zahmete girip getirdiği yiyecekler hiç oldu.Dialogue: 50,0:07:24.08,0:07:26.72,Main-207+,,0,0,0,,Yiyecekleri boşver şimdi.Dialogue: 50,0:07:26.72,0:07:31.93,Main-207+,,0,0,0,,O değil de kasaba saldırıya uğradığından kendini suçlamaz umarım.Dialogue: 50,0:07:33.15,0:07:35.93,Main-207+,,0,0,0,,Yufka yürekli bir adam olduğundan...Dialogue: 50,0:07:38.37,0:07:42.73,Main-207+,,0,0,0,,20 yıl sonra bile çok güzelsin! Hiç değişmemişsin!Dialogue: 50,0:07:43.03,0:07:49.54,Main-207+,,0,0,0,,Lakin Oden-sama'nın hayalini gerçekleştirmeden seni göremem!Dialogue: 50,0:07:50.88,0:07:54.57,Main-207+,,0,0,0,,Böyle bencil bir koca olduğum için beni bağışla!Dialogue: 50,0:08:08.60,0:08:09.86,Main-207+,,0,0,0,,O...Dialogue: 50,0:08:10.14,0:08:12.02,Main-207+,,0,0,0,,Ashura Doji!Dialogue: 50,0:08:19.97,0:08:21.89,Main-207+,,0,0,0,,Devasa bir çukur mu?Dialogue: 50,0:08:21.89,0:08:23.81,Main-207+,,0,0,0,,Okiku!Dialogue: 50,0:08:26.77,0:08:28.11,Main-207+,,0,0,0,,Yoksa...Dialogue: 50,0:08:33.57,0:08:37.99,Main-207+,,0,0,0,,Yardım edin lütfen! Dev bir çukur açıldı!Dialogue: 50,0:08:37.99,0:08:39.87,Main-207+,,0,0,0,,Okiku-chwan!Dialogue: 50,0:08:39.87,0:08:42.41,Main-207+,,0,0,0,,Bir şekilde atlatmayı başardık!Dialogue: 50,0:08:42.41,0:08:44.54,Main-207+,,0,0,0,,– Hey! – Buradayız!Dialogue: 50,0:08:44.54,0:08:45.79,Main-207+,,0,0,0,,Şükürler olsun!Dialogue: 50,0:08:45.79,0:08:48.84,Main-207+,,0,0,0,,Başınıza bir zeval gelmemiş!Dialogue: 50,0:08:48.84,0:08:52.21,Main-207+,,0,0,0,,Çukur sayesinde saldırıyı atlatsak da...Dialogue: 50,0:08:53.19,0:08:55.09,Main-207+,,0,0,0,,Düşüyoruz!Dialogue: 50,0:08:55.64,0:08:57.18,Main-207+,,0,0,0,,Millet!Dialogue: 50,0:08:59.03,0:09:00.39,Main-207+,,0,0,0,,Ay ay!Dialogue: 50,0:09:00.39,0:09:02.36,Main-207+,,0,0,0,,Sıkı tutunun.Dialogue: 50,0:09:06.14,0:09:07.89,Main-207+,,0,0,0,,– Teşekkürler! – Teşekkürler!Dialogue: 50,0:09:07.89,0:09:09.57,Main-207+,,0,0,0,,Kahramanım!Dialogue: 50,0:09:14.13,0:09:16.86,Main-207+,,0,0,0,,Hanımefendileri kurtarabildim.Dialogue: 50,0:09:16.86,0:09:21.13,Main-207+,,0,0,0,,Biz piç miyiz lan?Dialogue: 50,0:09:21.13,0:09:23.91,Main-207+,,0,0,0,,Ucuz yırttık!Dialogue: 50,0:09:23.91,0:09:28.66,Main-207+,,0,0,0,,Saldırıyı Shino-chan'ın tekniği sayesinde atlattınız demek!Dialogue: 50,0:09:28.66,0:09:30.38,Main-207+,,0,0,0,,Evet, öyle!Dialogue: 50,0:09:31.60,0:09:33.59,Main-207+,,0,0,0,,O an...Dialogue: 50,0:09:33.59,0:09:36.39,Flashbacks-207+,,0,0,0,,Sıcak Nefes!Dialogue: 50,0:09:45.45,0:09:48.40,Flashbacks-207+,,0,0,0,,Olgun Baştan Çıkarma Tekniği!Dialogue: 50,0:09:56.79,0:09:58.87,Flashbacks-207+,,0,0,0,,Gard Noktası!Dialogue: 50,0:10:17.92,0:10:20.61,Flashbacks-207+,,0,0,0,,Kurtulduk!Dialogue: 50,0:10:24.07,0:10:31.19,Main-207+,,0,0,0,,Olgun Baştan Çıkarma Tekniği'm her şeyi olgun hâline çevirebilir.Dialogue: 50,0:10:31.19,0:10:35.11,Main-207+,,0,0,0,,Evet, Shino-chan elini neye sürse çürüyor!Dialogue: 50,0:10:35.11,0:10:37.19,Main-207+,,0,0,0,,Çürür mü... Ağzını topla!Dialogue: 50,0:10:37.19,0:10:40.40,Main-207+,,0,0,0,,Bu arada, durumumuza gelirsek...Dialogue: 50,0:10:40.40,0:10:41.62,Main-207+,,0,0,0,,Sahi!Dialogue: 50,0:10:41.62,0:10:43.57,Main-207+,,0,0,0,,Luffy'ye ne oldu?Dialogue: 50,0:10:43.57,0:10:46.82,Main-207+,,0,0,0,,Kaido'yla kapışmak istiyor gibiydi!Dialogue: 50,0:10:49.39,0:10:51.54,Main-207+,,0,0,0,,Söyleyeceklerime kendinizi hazırlayın.Dialogue: 50,0:11:08.82,0:11:11.44,Main-207+,,0,0,0,,Nasıl bu kadar kalpsiz olur?Dialogue: 50,0:11:11.44,0:11:13.68,Main-207+,,0,0,0,,Hâlâ nefes alıyor.Dialogue: 50,0:11:13.68,0:11:15.44,Main-207+,,0,0,0,,Derhâl tedavi edin.Dialogue: 50,0:11:15.44,0:11:16.42,Main-207+,,0,0,0,,Emredersiniz!Dialogue: 50,0:11:17.03,0:11:19.72,Main-207+,,0,0,0,,Burada göze çarpacağımızdan ormana girelim!Dialogue: 50,0:11:21.25,0:11:23.91,Main-207+,,0,0,0,,El kadar çocuğa bu yapılır mı?Dialogue: 50,0:11:33.79,0:11:37.50,Main-207+,,0,0,0,,Aşağılık, Kaido!Dialogue: 50,0:12:02.50,0:12:05.41,Narrator-207+,,0,0,0,,Luffytaro'nun Kuri'deki büyük kapışmasını...Dialogue: 50,0:12:05.41,0:12:07.76,Main-207+,,0,0,0,,Ekstra sayı! Ekstra sayı!Dialogue: 50,0:12:07.76,0:12:12.37,Main-207+,,0,0,0,,Ekstra sayı! Ekstra sayı!Dialogue: 50,0:12:14.47,0:12:17.59,Narrator-207+,,0,0,0,,...Wano'da öğrenmeyen kalmamıştı.Dialogue: 50,0:12:26.90,0:12:29.01,Main-207+,,0,0,0,,Ha? El ilanı mı?Dialogue: 50,0:12:30.23,0:12:32.55,Main-207+,,0,0,0,,Oh! Luffy!Dialogue: 50,0:12:32.55,0:12:34.57,Main-207+,,0,0,0,,Wano'ya nihayet–Dialogue: 50,0:12:56.27,0:12:57.50,Main-207+,,0,0,0,,Oh, Luffy!Dialogue: 50,0:12:57.50,0:12:59.17,Main-207+,,0,0,0,,Wano'ya–Dialogue: 50,0:13:10.86,0:13:13.14,Main-207+,,0,0,0,,Ekstra sayı!Dialogue: 50,0:13:13.98,0:13:14.85,Main-207+,,0,0,0,,Lu–Dialogue: 50,0:13:40.93,0:13:42.60,Thoughts-207+,,0,0,0,,Yandım lan!Dialogue: 50,0:13:54.02,0:13:55.72,Main-207+,,0,0,0,,Bak sen...Dialogue: 50,0:13:55.72,0:14:00.41,Main-207+,,0,0,0,,Wano'da böyle çılgın bir herifin ortaya çıktığına inanamıyorum!Dialogue: 50,0:14:01.41,0:14:03.27,Main-207+,,0,0,0,,Ne okuyorsun?Dialogue: 50,0:14:03.27,0:14:04.03,Thoughts-207+,,0,0,0,,Yandım!Dialogue: 50,0:14:04.03,0:14:08.11,Main-207+,,0,0,0,,Luffytaro ismindeki bir samuray Kaido-sama'yla kapışmış.Dialogue: 50,0:14:12.53,0:14:15.07,Main-207+,,0,0,0,,Hop! Bu olmadı ama birader!Dialogue: 50,0:14:15.07,0:14:17.37,Main-207+,,0,0,0,,Wasabi sushi'yi tükürmesene!Dialogue: 50,0:14:17.37,0:14:21.03,Main-207+,,0,0,0,,Hem öküz gibi yedin, paran var mı?Dialogue: 50,0:14:21.03,0:14:22.67,Main-207+,,0,0,0,,Versene bi'!Dialogue: 50,0:14:29.61,0:14:32.39,Main-207+,,0,0,0,,Ne halt yiyorsun be Luffy?Dialogue: 50,0:14:46.83,0:14:49.95,Main-207+,,0,0,0,,Dövün, dövün! Demiri iyice dövün!Dialogue: 50,0:14:52.42,0:14:57.41,Main-207+,,0,0,0,,Ne kadar sağlam ve güçlü silahlar yaparsak başkentimiz o kadar gelişir!Dialogue: 50,0:14:57.41,0:15:00.34,Main-207+,,0,0,0,,Hayatlarınız artık Orochi-sama'nın malıdır!Dialogue: 50,0:15:00.93,0:15:02.92,Main-207+,,0,0,0,,Yaşamak istiyorsanız iyice dövün!Dialogue: 50,0:15:02.92,0:15:06.47,Main-207+,,0,0,0,,Soluklanmak isteyenin kellesi uçar!Dialogue: 50,0:15:07.10,0:15:09.47,Main-207+,,0,0,0,,Daha hızlı yürüyün lan!Dialogue: 50,0:15:10.56,0:15:12.77,Narrator-207+,,0,0,0,,Wano'nun Udon bölgesi.Dialogue: 50,0:15:12.77,0:15:16.65,Narrator-207+,,0,0,0,,Mahkûmlara angaryacılık yaptırıldığı...Dialogue: 50,0:15:16.69,0:15:20.94,Narrator-207+,,0,0,0,,silah fabrikalarıyla madenlerin yuvasıdır.Dialogue: 50,0:15:25.45,0:15:27.98,Main-207+,,0,0,0,,Yakala hadi! Zehirli balığın!Dialogue: 50,0:15:31.46,0:15:34.77,Main-207+,,0,0,0,,O değil de hücrede kim var ki?Dialogue: 50,0:15:34.77,0:15:36.29,Main-207+,,0,0,0,,Bilmem,Dialogue: 50,0:15:36.29,0:15:42.42,Main-207+,,0,0,0,,tek söyledikleri günde bir zehirli balığı kılçıklarını çıkarıp vermemiz.Dialogue: 50,0:15:42.42,0:15:43.63,Main-207+,,0,0,0,,Hepsi bu.Dialogue: 50,0:15:43.63,0:15:47.84,Main-207+,,0,0,0,,Zehirli balık yemeyi mi seviyor yani?Dialogue: 50,0:15:47.84,0:15:51.84,Main-207+,,0,0,0,,Zehirli balığı başlarda canını almak için veriyorlardı.Dialogue: 50,0:15:51.84,0:15:58.80,Main-207+,,0,0,0,,Fakat hücrede nasıl bir dalyarak varsa artık, zehirli balığı yiye yiye bugüne kadar yaşadı!Dialogue: 50,0:15:58.80,0:16:01.35,Main-207+,,0,0,0,,Köpek balığı veya timsah falan mı?Dialogue: 50,0:16:01.35,0:16:06.69,Main-207+,,0,0,0,,İyi de ne diye kılçığını çıkarmamız gerekiyor ki? Kim uğraşacak şimdi!Dialogue: 50,0:16:07.57,0:16:08.98,Main-207+,,0,0,0,,Sebebi...Dialogue: 50,0:16:13.31,0:16:14.74,Main-207+,,0,0,0,,"Azılı suçlu" mu?!Dialogue: 50,0:16:14.99,0:16:20.12,Main-207+,,0,0,0,,Milletin dilinden düşüremediği çömez geldi öyleyse!Dialogue: 50,0:16:20.12,0:16:21.29,Main-207+,,0,0,0,,Ne?Dialogue: 50,0:16:26.68,0:16:28.97,Main-207+,,0,0,0,,Hoş geldin, çömez!Dialogue: 50,0:16:30.12,0:16:31.72,Main-207+,,0,0,0,,Amma taşaklıymışsın!Dialogue: 50,0:16:34.01,0:16:37.68,Main-207+,,0,0,0,,Kaido-sama'ya bulaştıktan sonra sağ kalabileceğini sanma!Dialogue: 50,0:16:39.93,0:16:41.64,Main-207+,,0,0,0,,Kendini hazırla!Dialogue: 50,0:16:48.77,0:16:51.19,Main-207+,,0,0,0,,Hadisene, hızlı yürü!Dialogue: 50,0:16:59.41,0:17:01.58,Main-207+,,0,0,0,,Baksana, gerçekten de...Dialogue: 50,0:17:01.58,0:17:06.76,Main-207+,,0,0,0,,Kuri'de Kaido-sama'yla savaşıp kasabayı talan eden eleman mı?Dialogue: 50,0:17:06.76,0:17:08.38,Main-207+,,0,0,0,,Öyle gibi.Dialogue: 50,0:17:08.38,0:17:09.69,Main-207+,,0,0,0,,Bu götten bacaklı yani?Dialogue: 50,0:17:09.69,0:17:14.09,Main-207+,,0,0,0,,Aynen, ben de Önderler kadar büyük olacak sanmıştım!Dialogue: 50,0:17:14.09,0:17:16.38,Main-207+,,0,0,0,,Bir şey desene lan!Dialogue: 50,0:17:20.35,0:17:22.29,Main-207+,,0,0,0,,Çok güçsüz!Dialogue: 50,0:17:22.29,0:17:26.74,Main-207+,,0,0,0,,Böyle bir ezik mi Kaido-sama'ya meydan okudu yani?Dialogue: 50,0:17:26.74,0:17:30.45,Main-207+,,0,0,0,,Hadi, aylaklık etme! Kalk ayağa!Dialogue: 50,0:17:38.78,0:17:41.54,Main-207+,,0,0,0,,Ha? Nasıl da dik dik bakıyor!Dialogue: 50,0:17:45.30,0:17:50.46,Main-207+,,0,0,0,,Dert değil, gözünün feri gidene değin uzun uzun işkence edeceğim!Dialogue: 50,0:17:54.26,0:17:58.65,Main-207+,,0,0,0,,Bu da kim lan? Biz gardiyanlara yan baktı!Dialogue: 50,0:18:01.14,0:18:05.03,Main-207+,,0,0,0,,Bize karşı gelirsen ne olacağını kafana sokayım!Dialogue: 50,0:18:05.03,0:18:06.10,Main-207+,,0,0,0,,Geber!Dialogue: 50,0:18:14.90,0:18:16.54,Main-207+,,0,0,0,,Boynum!Dialogue: 50,0:18:16.54,0:18:19.15,Main-207+,,0,0,0,,Hücreden balık kılçığı fırladı.Dialogue: 50,0:18:19.15,0:18:22.58,Main-207+,,0,0,0,,Andaval! Balığı kılçığından ayırmadan mı verdin?Dialogue: 50,0:18:22.58,0:18:25.95,Main-207+,,0,0,0,,Pis acıyor! Boynum acıyor!Dialogue: 50,0:18:25.95,0:18:29.20,Main-207+,,0,0,0,,İçeride ne var? Hücrede ne tutuluyor ki?Dialogue: 50,0:18:29.20,0:18:30.77,Main-207+,,0,0,0,,Kimse bilmiyor!Dialogue: 50,0:18:36.22,0:18:38.93,Main-207+,,0,0,0,,Pekâlâ, içeri geç bakayım.Dialogue: 50,0:18:39.80,0:18:44.35,Main-207+,,0,0,0,,Burnun iyice sürtülüp Kaido-sama'ya boyun eğene dek!Dialogue: 50,0:18:48.30,0:18:51.11,Main-207+,,0,0,0,,Yarın, ölene kadar çalıştıracağız seni!Dialogue: 50,0:18:51.11,0:18:53.50,Main-207+,,0,0,0,,Elimizden çekeceğin var.Dialogue: 50,0:18:59.70,0:19:03.25,Main-207+,,0,0,0,,Görüşürüz koçum, bugünlük dinlenmene bak!Dialogue: 50,0:19:03.25,0:19:05.96,Main-207+,,0,0,0,,Yarın cehennemi tadacaksın!Dialogue: 0,0:01:41.86,0:01:44.62,Title-207+,,0,0,0,,HaDialogue: 0,0:06:52.46,0:06:55.99,Captions Wano,,0,0,0,,Okobore KasabasıDialogue: 50,0:12:12.76,0:12:13.87,Note-207+,,0,0,0,,"Aranıyor El İlanı"Dialogue: 50,0:13:07.27,0:13:09.23,Note-207+,,0,0,0,,"Kurbağa Yağı"Dialogue: 50,0:13:32.92,0:13:36.04,Note-207+,,0,0,0,,"Wasabi"Dialogue: 0,0:15:10.56,0:15:20.94,Captions Wano,,0,0,0,,Udon, WanoDialogue: 50,0:16:12.62,0:16:14.99,Note-207+,,0,0,0,,"Azılı suçlu"Dialogue: 50,0:16:44.02,0:16:46.65,Note-207+,,0,0,0,,"Luffytaro"Dialogue: 50,0:19:11.29,0:19:11.33,Main-207+,,0,0,900,,AH...Dialogue: 50,0:19:11.33,0:19:11.37,Main-207+,,0,0,900,,AH...Dialogue: 50,0:19:11.37,0:19:11.42,Main-207+,,0,0,900,,AH...Dialogue: 50,0:19:11.42,0:19:11.46,Main-207+,,0,0,900,,AH...Dialogue: 50,0:19:11.46,0:19:11.50,Main-207+,,0,0,900,,AH...Dialogue: 50,0:19:11.50,0:19:11.54,Main-207+,,0,0,900,,AH...Dialogue: 50,0:19:11.54,0:19:11.58,Main-207+,,0,0,900,,AH...Dialogue: 50,0:19:11.58,0:19:11.62,Main-207+,,0,0,900,,AH...Dialogue: 50,0:19:11.62,0:19:11.67,Main-207+,,0,0,900,,AH...Dialogue: 50,0:19:11.67,0:19:11.71,Main-207+,,0,0,900,,AH...Dialogue: 50,0:19:11.71,0:19:11.75,Main-207+,,0,0,900,,AH...Dialogue: 50,0:19:11.75,0:19:11.79,Main-207+,,0,0,900,,AH...Dialogue: 50,0:19:11.79,0:19:11.83,Main-207+,,0,0,900,,AH...Dialogue: 50,0:19:11.83,0:19:11.88,Main-207+,,0,0,900,,AH...Dialogue: 50,0:19:11.88,0:19:11.92,Main-207+,,0,0,900,,AH...Dialogue: 50,0:19:11.92,0:19:11.96,Main-207+,,0,0,900,,AH...Dialogue: 50,0:19:11.96,0:19:12.00,Main-207+,,0,0,900,,AH...Dialogue: 50,0:19:12.00,0:19:12.04,Main-207+,,0,0,900,,AH...Dialo