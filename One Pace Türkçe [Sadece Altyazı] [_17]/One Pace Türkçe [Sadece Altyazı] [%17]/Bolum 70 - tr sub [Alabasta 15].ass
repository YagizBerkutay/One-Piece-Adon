2,180,180,27,1Style: RogerMonologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1Style: Karaoke,Duality,68,&H00292CC7,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,4,0,1,6.8,0,8,23,23,23,1Style: Translation,Duality,68,&H00292CC7,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,4,0,1,6.8,0,2,23,23,34,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:59.99,0:02:09.98,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 50,0:01:52.34,0:01:55.30,Main-207-,,0,0,0,,Çekilin! Çekilin! Çekilin!Dialogue: 50,0:01:55.30,0:01:56.30,Main-207-,,0,0,0,,O-Onlar...Dialogue: 50,0:02:03.65,0:02:05.31,Main-207-,,0,0,0,,Lütfen durun, Chaka-sama!Dialogue: 50,0:02:08.90,0:02:10.11,Main-207-,,0,0,0,,Onlar da kim?Dialogue: 50,0:02:10.53,0:02:11.65,Main-207-,,0,0,0,,Siz...Dialogue: 50,0:02:12.03,0:02:13.49,Main-207-,,0,0,0,,Tsumegeri Birliği!Dialogue: 50,0:02:12.03,0:02:13.49,Note-207-,,0,0,0,,Tsumegeri: Pençe AtmaDialogue: 50,0:02:23.33,0:02:24.83,Main-207-,,0,0,0,,Hepiniz durun!Dialogue: 50,0:02:25.46,0:02:28.17,Main-207-,,0,0,0,,Bu adama saldırmayın!Dialogue: 50,0:02:31.80,0:02:33.97,Main-207-,,0,0,0,,Tsumegeri Birliği, kapıları yarıp geçti!Dialogue: 50,0:02:33.97,0:02:35.09,Main-207-,,0,0,0,,Hiç şaşırmadım!Dialogue: 50,0:02:35.09,0:02:37.26,Main-207-,,0,0,0,,Lütfen kralı ve Vivi-sama'yı kurtarın!Dialogue: 50,0:02:38.26,0:02:39.56,Main-207-,,0,0,0,,Majesteleri!Dialogue: 50,0:02:40.01,0:02:43.98,Main-207-,,0,0,0,,Dördümüz sizi ölümüne korumaya yemin ettik!Dialogue: 50,0:02:43.98,0:02:46.06,Main-207-,,0,0,0,,Ona saldırmaktan başka çaremiz yok!Dialogue: 50,0:02:46.81,0:02:49.32,Main-207-,,0,0,0,,Onun bir Shichibukai olduğunu biliyoruz.Dialogue: 50,0:02:49.32,0:02:52.32,Main-207-,,0,0,0,,Adil bir dövüş beklemiyoruz.Dialogue: 50,0:02:52.82,0:02:54.53,Main-207-,,0,0,0,,– Dördümüz... – Dördümüz...Dialogue: 50,0:02:55.03,0:02:56.70,Main-207-,,0,0,0,,...bizzat, onun icabına...Dialogue: 50,0:02:57.12,0:02:58.53,Main-207-,,0,0,0,,...bakacağız.Dialogue: 50,0:02:59.66,0:03:02.66,Main-207-,,0,0,0,,Oldukça popüler görünüyorsunuz.Dialogue: 50,0:03:02.66,0:03:04.25,Main-207-,,0,0,0,,Buradan...Dialogue: 50,0:03:04.25,0:03:06.79,Main-207-,,0,0,0,,defolursanız, yaşamanıza izin vereceğim.Dialogue: 50,0:03:06.79,0:03:08.75,Main-207-,,0,0,0,,Gitmeyeceğiz.Dialogue: 50,0:03:09.46,0:03:12.26,Main-207-,,0,0,0,,Gitmememizin bir sebebi var!Dialogue: 50,0:03:12.84,0:03:14.51,Main-207-,,0,0,0,,Sebep mi?Dialogue: 50,0:03:16.68,0:03:21.76,Main-207-,,0,0,0,,Bu isyanı tezgâhlayan sensen, seni yok etmeliyiz.Dialogue: 50,0:03:25.73,0:03:26.98,Main-207-,,0,0,0,,O morluklar...!Dialogue: 50,0:03:29.19,0:03:30.73,Main-207-,,0,0,0,,Yoksa siz...Dialogue: 50,0:03:34.99,0:03:35.95,Main-207-,,0,0,0,,Halledeyim mi?Dialogue: 50,0:03:35.95,0:03:38.70,Main-207-,,0,0,0,,Zahmet etme. Böcekler.Dialogue: 50,0:03:41.87,0:03:42.66,Main-207-,,0,0,0,,Olamaz...Dialogue: 50,0:03:46.00,0:03:47.21,Main-207-,,0,0,0,,Chaka!Dialogue: 50,0:03:47.21,0:03:48.88,Main-207-,,0,0,0,,Onlarda bir terslik var!Dialogue: 50,0:03:48.88,0:03:51.96,Main-207-,,0,0,0,,Geçici süreliğine süper güç elde etmek için,Dialogue: 50,0:03:52.92,0:03:54.92,Main-207-,,0,0,0,,ölümcül iksiri içmişler.Dialogue: 50,0:03:55.55,0:03:57.80,Main-207-,,0,0,0,,"Ölümcül Yakıtı" içmişler.Dialogue: 50,0:03:57.80,0:04:00.60,Main-207-,,0,0,0,,Yaşamak için sadece birkaç dakikaları var!Dialogue: 50,0:04:00.97,0:04:02.31,Main-207-,,0,0,0,,Kurtarılamazlar...Dialogue: 50,0:04:02.31,0:04:03.97,Main-207-,,0,0,0,,Olamaz!Dialogue: 50,0:04:05.98,0:04:09.35,Main-207-,,0,0,0,,Ben de öyle düşünmüştüm.Dialogue: 50,0:04:09.35,0:04:12.94,Main-207-,,0,0,0,,Benimle dövüşmek için hayatlarınızdan mı vazgeçtiniz?Dialogue: 50,0:04:13.65,0:04:15.19,Main-207-,,0,0,0,,Chaka-sama,Dialogue: 50,0:04:15.19,0:04:18.36,Main-207-,,0,0,0,,lütfen bencilliğimizi affedin.Dialogue: 50,0:04:18.36,0:04:19.91,Main-207-,,0,0,0,,Ama ona...Dialogue: 50,0:04:20.74,0:04:23.28,Main-207-,,0,0,0,,bu ülkenin çektiği acıyı hissettirmeliyiz.Dialogue: 50,0:04:41.97,0:04:44.31,Main-207-,,0,0,0,,Sizi ahmaklar...Dialogue: 50,0:04:45.14,0:04:47.73,Main-207-,,0,0,0,,Bu adam...Dialogue: 50,0:04:47.77,0:04:49.48,Main-207-,,0,0,0,,bu ülkenin...Dialogue: 50,0:04:54.48,0:04:56.98,Main-207-,,0,0,0,,öfkesini hissetmeli!!Dialogue: 50,0:05:11.54,0:05:13.79,Main-207-,,0,0,0,,Pek akıllı sayılmazsınız.Dialogue: 50,0:05:14.46,0:05:17.13,Main-207-,,0,0,0,,Hayatınıza değer vermelisiniz.Dialogue: 50,0:05:17.76,0:05:19.63,Main-207-,,0,0,0,,Gerçi bunun için çok geç, ha?Dialogue: 50,0:05:25.93,0:05:30.43,Main-207-,,0,0,0,,Her hâlükârda ölecekseniz niye sizinle dövüşme zahmetine gireyim ki ?Dialogue: 50,0:05:30.81,0:05:33.56,Main-207-,,0,0,0,,Onlarla dövüşmeyecek misin?Dialogue: 50,0:05:49.87,0:05:52.00,Main-207-,,0,0,0,,Cha... ka-sama...Dialogue: 50,0:05:57.96,0:06:01.47,Main-207-,,0,0,0,,Bu tam anlamıyla aptallığın zirvesi.Dialogue: 50,0:06:02.97,0:06:04.84,Main-207-,,0,0,0,,Seni lanet...Dialogue: 50,0:06:08.39,0:06:10.77,Main-207-,,0,0,0,,İblis!Dialogue: 50,0:06:12.85,0:06:14.02,Main-207-,,0,0,0,,Chaka!Dialogue: 50,0:06:14.40,0:06:16.40,Main-207-,,0,0,0,,Chaka! Dur!Dialogue: 50,0:06:16.40,0:06:18.65,Main-207-,,0,0,0,,Hayatını boşa harcama!Dialogue: 50,0:06:19.07,0:06:21.40,Main-207-,,0,0,0,,Demek, bir Zoan Tipi.Dialogue: 50,0:06:21.40,0:06:25.45,Main-207-,,0,0,0,,Köpek-Köpek Meyvesi, Model: Çakal!Dialogue: 50,0:06:26.28,0:06:28.41,Main-207-,,0,0,0,,Uluyan Diş!Dialogue: 50,0:06:32.37,0:06:34.00,Main-207-,,0,0,0,,Demek sen de...Dialogue: 50,0:06:34.00,0:06:35.50,Main-207-,,0,0,0,,başkaları için...Dialogue: 50,0:06:36.83,0:06:38.75,Main-207-,,0,0,0,,ölmek istiyorsun?Dialogue: 50,0:06:52.98,0:06:54.10,Main-207-,,0,0,0,,Kahretsin...Dialogue: 50,0:06:54.10,0:06:55.73,Main-207-,,0,0,0,,Çok fazla kan kaybettim.Dialogue: 50,0:06:56.60,0:06:59.82,Main-207-,,0,0,0,,Yaralarım çok derin olmadığı için şanslıyım.Dialogue: 50,0:06:59.82,0:07:02.90,Main-207-,,0,0,0,,Ama... yine de... acıyorlar.Dialogue: 50,0:07:04.86,0:07:06.91,Main-207-,,0,0,0,,Diğerleri nasıl acaba?Dialogue: 50,0:07:06.91,0:07:09.33,Main-207-,,0,0,0,,Umarım kimse ölmemiştir.Dialogue: 50,0:07:09.33,0:07:11.37,Main-207-,,0,0,0,,Ne olduğunu bilmek istiyorum...Dialogue: 50,0:07:11.99,0:07:13.62,Flashbacks-207-,,0,0,0,,Ne?!Dialogue: 50,0:07:13.62,0:07:17.83,Flashbacks-207-,,0,0,0,,Kirpikle takım mı olacağız?!Dialogue: 50,0:07:17.83,0:07:21.46,Flashbacks-207-,,0,0,0,,O bir deve, Tanrı aşkına!Dialogue: 50,0:07:21.46,0:07:24.51,Flashbacks-207-,,0,0,0,,Güçsüzlüğümü hafife alma!Dialogue: 50,0:07:24.82,0:07:28.01,Flashbacks-207-,,0,0,0,,Kısa çöpü çektin. Şikayeti kes.Dialogue: 50,0:07:28.01,0:07:31.14,Flashbacks-207-,,0,0,0,,Tamam, ama bana bir konuda söz ver...Dialogue: 50,0:07:31.14,0:07:32.89,Flashbacks-207-,,0,0,0,,Başımız derde girerse,Dialogue: 50,0:07:32.89,0:07:34.64,Flashbacks-207-,,0,0,0,,lütfen bizi kurtarmaya gel.Dialogue: 50,0:07:34.64,0:07:38.44,Flashbacks-207-,,0,0,0,,Aptal. Ben sadece bayanları kurtarırım.Dialogue: 50,0:07:40.73,0:07:42.07,Main-207-,,0,0,0,,Usopp...Dialogue: 50,0:07:44.94,0:07:46.40,Main-207-,,0,0,0,,Hey, Usopp.Dialogue: 50,0:07:46.40,0:07:49.37,Main-207-,,0,0,0,,Ne diye ağlıyorsun?Dialogue: 50,0:07:49.37,0:07:52.54,Main-207-,,0,0,0,,Kim ağlıyormuş? Ağlamıyorum!Dialogue: 50,0:07:52.54,0:07:54.66,Main-207-,,0,0,0,,Ağlıyorsun diyen ağlıyordur!Dialogue: 50,0:07:54.66,0:07:56.66,Main-207-,,0,0,0,,Bu hiç mantıklı değil!Dialogue: 50,0:07:56.66,0:07:58.37,Main-207-,,0,0,0,,Ama...Dialogue: 50,0:07:58.75,0:08:01.00,Main-207-,,0,0,0,,o kocakarı köstebek...Dialogue: 50,0:08:01.00,0:08:05.34,Main-207-,,0,0,0,,Luffy'nin öldüğünü söyledi. Bu yüzden...Dialogue: 50,0:08:05.84,0:08:07.80,Main-207-,,0,0,0,,D-Doğru söylemiş olabilir mi?Dialogue: 50,0:08:08.55,0:08:10.80,Main-207-,,0,0,0,,Buna cidden inanıyor musunuz?Dialogue: 50,0:08:11.26,0:08:14.14,Main-207-,,0,0,0,,Elbette inanmıyorum! Aptal mısın nesin?!Dialogue: 50,0:08:14.14,0:08:16.93,Main-207-,,0,0,0,,Ben de! Hiç inanmıyorum!Dialogue: 50,0:08:18.69,0:08:20.31,Main-207-,,0,0,0,,Tamam öyleyse!Dialogue: 50,0:08:20.31,0:08:24.69,Main-207-,,0,0,0,,En hızlı şekilde saraya gitsek iyi olur!Dialogue: 50,0:08:25.15,0:08:29.57,Main-207-,,0,0,0,,En azından savaşın gürültüsü bitene dek burnunuzu temizleyin.Dialogue: 50,0:08:31.49,0:08:32.66,Main-207-,,0,0,0,,Yutmayın!Dialogue: 50,0:08:36.12,0:08:38.04,Flashbacks-207-,,0,0,0,,Hepinize... teşekkür ederim.Dialogue: 50,0:08:38.79,0:08:40.50,Flashbacks-207-,,0,0,0,,Teşekkür için biraz erken.Dialogue: 50,0:08:40.88,0:08:44.38,Flashbacks-207-,,0,0,0,,Evet. Korsanlara teşekkür etmek istiyorsan...Dialogue: 50,0:08:44.38,0:08:46.26,Flashbacks-207-,,0,0,0,,paradan haber vermelisin.Dialogue: 50,0:08:46.26,0:08:49.97,Flashbacks-207-,,0,0,0,,Bu krallık yeterince zor durumda değil mi?!Dialogue: 50,0:08:50.22,0:08:51.51,Thoughts-207-,,0,0,0,,İyi mi acaba?Dialogue: 50,0:08:51.51,0:08:53.97,Thoughts-207-,,0,0,0,,Nami kaçmayı başardı mı?Dialogue: 50,0:09:01.44,0:09:02.90,Main-207-,,0,0,0,,Sonunda başardım.Dialogue: 50,0:09:03.27,0:09:07.86,Main-207-,,0,0,0,,Demek bu yüzden tek seferlik saldırıymış.Dialogue: 50,0:09:09.11,0:09:12.57,Main-207-,,0,0,0,,İsyan Ordusu dalgası yakında.Dialogue: 50,0:09:17.16,0:09:19.12,Main-207-,,0,0,0,,Durum değişti.Dialogue: 50,0:09:19.12,0:09:21.12,Main-207-,,0,0,0,,Ne olursa olsun, saraya ulaşmalıyım.Dialogue: 50,0:09:26.34,0:09:28.05,Thoughts-207-,,0,0,0,,Vivi'ye ne oldu?Dialogue: 50,0:09:28.05,0:09:30.88,Thoughts-207-,,0,0,0,,Seslere bakılırsa savaş başlamış gibi.Dialogue: 50,0:09:31.72,0:09:33.47,Flashbacks-207-,,0,0,0,,Sahi, Vivi-chan,Dialogue: 50,0:09:33.47,0:09:35.18,Flashbacks-207-,,0,0,0,,şunu unutma.Dialogue: 50,0:09:35.89,0:09:39.35,Flashbacks-207-,,0,0,0,,Luffy, dövüşten sonra çok yemek yer.Dialogue: 50,0:09:39.85,0:09:41.14,Flashbacks-207-,,0,0,0,,Evet.Dialogue: 50,0:09:41.14,0:09:43.81,Flashbacks-207-,,0,0,0,,Seni Alubarna'da bekleyeceğiz, tamam mı?!Dialogue: 50,0:09:43.81,0:09:47.15,Flashbacks-207-,,0,0,0,,Tamam!Dialogue: 50,0:09:47.15,0:09:49.53,Flashbacks-207-,,0,0,0,,Bu iş artık ölüm kalım meselesi!Dialogue: 50,0:09:51.90,0:09:53.11,Flashbacks-207-,,0,0,0,,İşi batırmayın!Dialogue: 50,0:09:53.74,0:09:55.12,Flashbacks-207-,,0,0,0,,Gidelim!Dialogue: 50,0:09:55.12,0:09:57.33,Flashbacks-207-,,0,0,0,,Alubarna Sarayı'nda buluşacağız!Dialogue: 50,0:10:08.88,0:10:09.88,Main-207-,,0,0,0,,Chaka!Dialogue: 50,0:10:15.89,0:10:17.64,Main-207-,,0,0,0,,Güçsüzlük,Dialogue: 50,0:10:18.06,0:10:19.89,Main-207-,,0,0,0,,affedilemez bir günahtır.Dialogue: 50,0:10:23.73,0:10:24.77,Main-207-,,0,0,0,,Vivi!Dialogue: 50,0:10:41.54,0:10:43.54,Main-207-,,0,0,0,,K... Koza!Dialogue: 50,0:10:50.84,0:10:51.92,Main-207-,,0,0,0,,Sen...Dialogue: 50,0:10:51.92,0:10:54.63,Main-207-,,0,0,0,,Tabii ya, bildiğin gizli geçiti kullanmışsın.Dialogue: 50,0:10:56.34,0:10:58.64,Main-207-,,0,0,0,,Gözlerim beni aldatıyor mu?Dialogue: 50,0:11:09.44,0:11:12.57,Main-207-,,0,0,0,,Kraliyet Ordusu'yla görüşmek için gelmiştim, ama...Dialogue: 50,0:11:14.99,0:11:15.91,Main-207-,,0,0,0,,Chaka...Dialogue: 50,0:11:17.36,0:11:19.58,Main-207-,,0,0,0,,ve kral,Dialogue: 50,0:11:19.91,0:11:22.79,Main-207-,,0,0,0,,ülkemizin kahramanının ellerinde ölüyor.Dialogue: 50,0:11:22.79,0:11:25.00,Main-207-,,0,0,0,,Gördüğüm şeye inanamıyorum.Dialogue: 50,0:11:27.96,0:11:30.96,Main-207-,,0,0,0,,İlginç, değil mi?Dialogue: 50,0:11:30.96,0:11:38.14,Main-207-,,0,0,0,,Tam isyanın ortasındayız ve iki tarafın liderleri yüz yüze geliyor.Dialogue: 50,0:11:38.14,0:11:43.02,Main-207-,,0,0,0,,Bu savaş sanki, iki başsız kertenkele arasındaki ölümüne bir dövüş gibi oldu.Dialogue: 50,0:11:45.81,0:11:47.56,Main-207-,,0,0,0,,Kafan karışmış gibi.Dialogue: 50,0:11:47.56,0:11:51.27,Main-207-,,0,0,0,,Tepkin gayet doğal, fakat mesele aslında basit.Dialogue: 50,0:11:52.82,0:11:57.40,Main-207-,,0,0,0,,Sadece en kötü senaryoyu hayal et.Dialogue: 50,0:12:01.87,0:12:05.54,Flashbacks-207-,,0,0,0,,Ondan şüphelenme, Koza.Dialogue: 50,0:12:12.50,0:12:15.01,Flashbacks-207-,,0,0,0,,Bu ülkeyi seviyor musun?Dialogue: 50,0:12:23.18,0:12:25.85,Flashbacks-207-,,0,0,0,,Evet! Burası benim vatanım!Dialogue: 50,0:12:26.48,0:12:28.31,Flashbacks-207-,,0,0,0,,Ben de!Dialogue: 50,0:12:29.85,0:12:30.94,Main-207-,,0,0,0,,Koza, dinle–Dialogue: 50,0:12:30.94,0:12:32.19,Main-207-,,0,0,0,,Vivi!Dialogue: 50,0:12:32.19,0:12:34.94,Main-207-,,0,0,0,,Bu ülkenin yağmurunu çalan kim?!Dialogue: 50,0:12:37.03,0:12:38.15,Main-207-,,0,0,0,,Hepsi–Dialogue: 50,0:12:38.15,0:12:40.16,Main-207-,,0,0,0,,Bendim, Koza.Dialogue: 50,0:12:41.03,0:12:45.87,Main-207-,,0,0,0,,Kralın yaptığına inandığın her şey,Dialogue: 50,0:12:45.87,0:12:48.87,Main-207-,,0,0,0,,örgütüm tarafından planlanmış bir tuzaktı.Dialogue: 50,0:12:48.87,0:12:54.34,Main-207-,,0,0,0,,Son iki yıldır kraliyet ailesi ve ordusu...Dialogue: 50,0:12:55.63,0:13:01.30,Main-207-,,0,0,0,,çaresizce bizi durdurmaya çalışırken sizler ekmeğimize yağ sürdünüz.Dialogue: 50,0:13:07.06,0:13:11.77,Main-207-,,0,0,0,,Bu gerçeği öğrenmeseydin daha mutlu bir şekilde ölecektin.Dialogue: 50,0:13:18.24,0:13:20.74,Main-207-,,0,0,0,,Onu dinleme, Koza!Dialogue: 50,0:13:21.99,0:13:23.07,Main-207-,,0,0,0,,Kral...Dialogue: 50,0:13:23.49,0:13:26.24,Main-207-,,0,0,0,,Şu an yapman gereken bir şey var!Dialogue: 50,0:13:26.24,0:13:29.04,Main-207-,,0,0,0,,Yapabiliyorken insanlarımızı kurtar!Dialogue: 50,0:13:30.71,0:13:32.50,Main-207-,,0,0,0,,Yarım saatten az bir süre içinde,Dialogue: 50,0:13:32.96,0:13:35.96,Main-207-,,0,0,0,,saray meydanında devasa bir patlama olacak!Dialogue: 50,0:13:36.38,0:13:37.59,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:13:38.09,0:13:40.55,Main-207-,,0,0,0,,Hâlâ yaşıyor musun?Dialogue: 50,0:13:44.97,0:13:48.02,Main-207-,,0,0,0,,Çabuk!Dialogue: 50,0:13:58.90,0:14:00.32,Main-207-,,0,0,0,,Hayır!Dialogue: 50,0:14:02.40,0:14:03.86,Main-207-,,0,0,0,,Vivi!Dialogue: 50,0:14:04.24,0:14:07.03,Main-207-,,0,0,0,,Hey! Çekil, Vivi! Ne yapıyorsun?!Dialogue: 50,0:14:07.03,0:14:09.04,Main-207-,,0,0,0,,Meydan savaş alanına dönüşecek!Dialogue: 50,0:14:09.04,0:14:10.37,Main-207-,,0,0,0,,Gerçekten patlama–Dialogue: 50,0:14:10.37,0:14:14.29,Main-207-,,0,0,0,,İzin vermem! Buranın savaş alanına dönüşmesine asla izin vermeyeceğim!Dialogue: 50,0:14:17.50,0:14:20.59,Main-207-,,0,0,0,,Ne kadar paniğe kapıldığına bak!Dialogue: 50,0:14:20.59,0:14:25.47,Main-207-,,0,0,0,,Meydanın akıbetini bilseler hepsinin tepkisi nasıl olurdu?Dialogue: 50,0:14:25.47,0:14:28.68,Main-207-,,0,0,0,,Panik olacağını söylemek hafif kalır.Dialogue: 50,0:14:29.31,0:14:31.02,Main-207-,,0,0,0,,Sonrasında...Dialogue: 50,0:14:31.02,0:14:32.81,Main-207-,,0,0,0,,savaş bitmeyecek!Dialogue: 50,0:14:32.81,0:14:34.02,Main-207-,,0,0,0,,Kimse kurtulamayacak!Dialogue: 50,0:14:38.23,0:14:39.94,Main-207-,,0,0,0,,Öyle değil mi?Dialogue: 50,0:14:40.44,0:14:43.95,Main-207-,,0,0,0,,Vay, zekice bir muhakeme.Dialogue: 50,0:14:44.32,0:14:47.45,Main-207-,,0,0,0,,Yapmamız gereken şey başından beri aynıydı!Dialogue: 50,0:14:50.24,0:14:53.37,Main-207-,,0,0,0,,Bu planlanmış isyanı durdurmalıyız!Dialogue: 50,0:14:54.92,0:14:56.42,Main-207-,,0,0,0,,Şimdi,Dialogue: 50,0:14:56.42,0:14:58.92,Main-207-,,0,0,0,,bunu yapabilecek tek kişi sensin!Dialogue: 50,0:15:18.11,0:15:23.03,Main-207-,,0,0,0,,Öylece durup bunu yapmanızı izleyeceğimi mi sandınız?Dialogue: 50,0:15:34.66,0:15:35.58,Main-207-,,0,0,0,,Chaka!Dialogue: 50,0:15:38.21,0:15:39.46,Main-207-,,0,0,0,,Ben,Dialogue: 50,0:15:39.88,0:15:42.30,Main-207-,,0,0,0,,Alabasta'nın İlahi Muhafızı, Çakal'ım!Dialogue: 50,0:15:42.30,0:15:45.38,Main-207-,,0,0,0,,Kraliyet Ordusu'nun düşmanlarını yok eden kişi!Dialogue: 50,0:15:47.47,0:15:50.64,Main-207-,,0,0,0,,İçimde bir yaşam kırıntısı kaldığı sürece, dövüşeceğim!Dialogue: 50,0:15:51.56,0:15:54.27,Main-207-,,0,0,0,,Ve senin gibilere aptal denir.Dialogue: 50,0:15:54.60,0:15:56.94,Main-207-,,0,0,0,,Siz ikiniz ne istiyorsanız onu yapın!Dialogue: 50,0:15:56.94,0:16:00.27,Main-207-,,0,0,0,,Onu burada birkaç dakika daha tutabilirim!Dialogue: 50,0:16:00.86,0:16:01.77,Main-207-,,0,0,0,,Tamam!Dialogue: 50,0:16:03.44,0:16:04.57,Thoughts-207-,,0,0,0,,Chaka!Dialogue: 50,0:16:04.57,0:16:07.78,Flashbacks-207-,,0,0,0,,Kum-Kum Klanı'nın lideri  pek cesur görünmüyor.Dialogue: 50,0:16:12.12,0:16:13.70,Flashbacks-207-,,0,0,0,,Pekâlâ, sorun nedir?Dialogue: 50,0:16:18.71,0:16:20.96,Flashbacks-207-,,0,0,0,,Ah!Dialogue: 50,0:16:21.50,0:16:25.26,Flashbacks-207-,,0,0,0,,Bu ne içindi? Ben yetişkin değilim! Bana yumuşak davran!Dialogue: 50,0:16:25.26,0:16:27.51,Flashbacks-207-,,0,0,0,,Baş belası.Dialogue: 50,0:16:28.09,0:16:32.47,Flashbacks-207-,,0,0,0,,Seni eğitmemi söylediğini hatırlıyorum.Dialogue: 50,0:16:46.65,0:16:48.95,Main-207-,,0,0,0,,2. Muhafız Birliği, karargâha dönün!Dialogue: 50,0:16:49.91,0:16:51.91,Main-207-,,0,0,0,,2. Muhafız Birliği, karargâha dönün!Dialogue: 50,0:16:51.91,0:16:54.91,Main-207-,,0,0,0,,4. Birlik yok edildi!Dialogue: 50,0:16:57.12,0:17:00.62,Main-207-,,0,0,0,,İsyancılar, ana meydandan geçip kuzey bloğuna doğru harekete geçti!Dialogue: 50,0:17:00.62,0:17:02.00,Main-207-,,0,0,0,,Saraya yaklaşıyorlar!Dialogue: 50,0:17:02.63,0:17:04.34,Main-207-,,0,0,0,,Beyaz bayrak sallayın!Dialogue: 50,0:17:05.17,0:17:09.17,Main-207-,,0,0,0,,Size teslim olmanızı emrediyorum, Kraliyet Ordusu!Dialogue: 50,0:17:09.17,0:17:11.55,Main-207-,,0,0,0,,Vivi-sama! Ne diyorsunuz?Dialogue: 50,0:17:11.55,0:17:12.68,Main-207-,,0,0,0,,Teslim olmak mı?Dialogue: 50,0:17:12.68,0:17:16.14,Main-207-,,0,0,0,,Bunu yaparsak, ülkeye ne olacak?Dialogue: 50,0:17:16.89,0:17:18.52,Main-207-,,0,0,0,,Hey, bakın!Dialogue: 50,0:17:18.52,0:17:19.60,Main-207-,,0,0,0,,O...Dialogue: 50,0:17:20.10,0:17:21.48,Main-207-,,0,0,0,,Koza!Dialogue: 50,0:17:21.48,0:17:24.31,Main-207-,,0,0,0,,İsyan Ordusu'nun lideri neden burada?!Dialogue: 50,0:17:24.94,0:17:27.73,Main-207-,,0,0,0,,Vivi'yi dinleyin!Dialogue: 50,0:17:27.73,0:17:31.41,Main-207-,,0,0,0,,Artık savaş ya da zafer istemiyoruz!Dialogue: 50,0:17:31.41,0:17:34.12,Main-207-,,0,0,0,,Bu savaş bitmeli!Dialogue: 50,0:17:34.12,0:17:36.70,Main-207-,,0,0,0,,– Ne? – Neler oluyor?Dialogue: 50,0:17:37.79,0:17:43.38,Main-207-,,0,0,0,,Bu savaşın manasız olduğu konusunda, İsyan Ordusu'nu bilgilendireceğim!Dialogue: 50,0:17:44.46,0:17:48.05,Main-207-,,0,0,0,,Artık birbirimizle dövüşmek için sebebimiz olmadığını söyleyeceğim!Dialogue: 50,0:17:48.76,0:17:54.01,Main-207-,,0,0,0,,Daha fazla kan dökülmesini önlemek için, lütfen beyaz bayrak sallayın!Dialogue: 50,0:17:54.01,0:17:55.43,Main-207-,,0,0,0,,Size yalvarıyorum!Dialogue: 50,0:17:56.26,0:17:59.22,Main-207-,,0,0,0,,Kralın başı önümüzde!Dialogue: 50,0:18:00.23,0:18:02.69,Main-207-,,0,0,0,,Saat kulesine vardık!Dialogue: 50,0:18:08.78,0:18:11.32,Main-207-,,0,0,0,,Saray meydanına yaklaşıyoruz!Dialogue: 50,0:18:11.82,0:18:14.28,Main-207-,,0,0,0,,Saldırıya hazırlanın!Dialogue: 50,0:18:23.58,0:18:24.92,Main-207-,,0,0,0,,D-Durun!Dialogue: 50,0:18:32.55,0:18:34.05,Main-207-,,0,0,0,,Beyaz bayrak mı?!Dialogue: 50,0:18:34.93,0:18:39.56,Main-207-,,0,0,0,,Kraliyet Ordusu, teslim olmak için beyaz bayrak sallıyor!Dialogue: 50,0:18:43.94,0:18:45.69,Main-207-,,0,0,0,,Koza-san!Dialogue: 50,0:18:45.69,0:18:48.86,Main-207-,,0,0,0,,Savaş bitti!Dialogue: 50,0:18:48.86,0:18:50.36,Main-207-,,0,0,0,,Tüm isyancılar,Dialogue: 50,0:18:50.36,0:18:53.32,Main-207-,,0,0,0,,öfkenizi dizginleyin ve silahlarınızı bırakın!Dialogue: 50,0:18:54.28,0:18:57.95,Main-207-,,0,0,0,,Kraliyet Ordusu, artık savaşmak istemiyor!Dialogue: 50,0:19:01.24,0:19:02.58,Thoughts-207-,,0,0,0,,Buna bir son verin…!Dialogue: 50,0:19:19.72,0:19:21.72,Main-207-,,0,0,0,,Gerçekten mi, Koza-san?Dialogue: 50,0:19:22.10,0:19:25.10,Main-207-,,0,0,0,,Evet. Artık savaş...Dialogue: 50,0:19:41.91,0:19:47.08,Main-207-,,0,0,0,,Koza!Dialogue: 50,0:19:51.38,0:19:53.30,Main-207-,,0,0,0,,Koza!Dialogue: 50,0:19:54.51,0:19:59.55,Flashbacks-207-,,0,0,0,,Bu ülkenin yeşilliğine yeşillik katacak görkemli bir şehir kuracağız!Dialogue: 50,0:20:00.30,0:20:01.43,Flashbacks-207-,,0,0,0,,Şüphesiz!Dialogue: 50,0:20:12.27,0:20:15.36,Main-207-,,0,0,0,,O-Onlarla dövüşmeyin,Dialogue: 50,0:20:16.74,0:20:19.32,Main-207-,,0,0,0,,İsyan Ordusu!Dialogue: 50,0:20:19.32,0:20:26.25,Main-207-,,0,0,0,,– Koza-san! – Koza-san!Dialogue: 50,0:20:26.25,0:20:28.29,Main-207-,,0,0,0,,Ne cüretle Koza-san'ı vurursunuz?!Dialogue: 50,0:20:28.29,0:20:29.83,Main-207-,,0,0,0,,Öldürün onları!Dialogue: 50,0:20:35.46,0:20:37.34,Main-207-,,0,0,0,,Baroque Works!Dialogue: 50,0:20:45.22,0:20:48.23,Main-207-,,0,0,0,,Lanet olası! Niye Koza'yı vurdun?!Dialogue: 50,0:20:56.07,0:20:58.40,Main-207-,,0,0,0,,İsyan Ordusu...Dialogue: 50,0:20:58.40,0:21:00.11,Main-207-,,0,0,0,,d-dinleyin.Dialogue: 50,0:21:02.12,0:21:03.12,Main-207-,,0,0,0,,Ne oluyor?!Dialogue: 50,0:21:03.83,0:21:05.49,Main-207-,,0,0,0,,Aniden kum fırtınası çıktı!Dialogue: 50,0:21:07.04,0:21:09.04,Main-207-,,0,0,0,,İsyan Ordusu...!Dialogue: 50,0:21:13.38,0:21:14.46,Main-207-,,0,0,0,,Bize ateş ediyorlar!Dialogue: 50,0:21:14.96,0:21:17.51,Main-207-,,0,0,0,,Piçler...!Dialogue: 50,0:21:24.39,0:21:26.89,Main-207-,,0,0,0,,Bu kum fırtınası da ne böyle?!Dialogue: 50,0:21:26.89,0:21:28.35,Main-207-,,0,0,0,,Hiçbir şey göremiyorum!Dialogue: 50,0:21:33.52,0:21:35.73,Main-207-,,0,0,0,,Lanet olası piçler!Dialogue: 50,0:21:41.03,0:21:42.41,Main-207-,,0,0,0,,Rastgele ateş etmeyin!Dialogue: 50,0:21:42.41,0:21:43.62,Main-207-,,0,0,0,,Neler oluyor?Dialogue: 50,0:21:44.24,0:21:45.99,Main-207-,,0,0,0,,Basit.Dialogue: 50,0:21:46.62,0:21:51.79,Main-207-,,0,0,0,,Baroque Works, yani biz, iki tarafa da sızdık.Dialogue: 50,0:21:57.17,0:21:58.26,Main-207-,,0,0,0,,Olamaz!Dialogue: 50,0:21:58.67,0:22:00.76,Main-207-,,0,0,0,,Hey! Dayan!Dialogue: 50,0:22:08.10,0:22:10.35,Main-207-,,0,0,0,,Bu nasıl teslim olmak?!Dialogue: 50,0:22:10.98,0:22:13.85,Main-207-,,0,0,0,,Bizi tuzağa çekmek için beyaz bayrak salladılar!Dialogue: 50,0:22:14.60,0:22:17.82,Main-207-,,0,0,0,,Kraliyet Ordusu böyle mi savaşıyor?Dialogue: 50,0:22:18.15,0:22:20.03,Main-207-,,0,0,0,,Nasıl bu kadar alçalabildiler?!Dialogue: 50,0:22:25.78,0:22:28.79,Main-207-,,0,0,0,,Yalvarıyorum! Hepiniz, durun!Dialogue: 50,0:22:28.79,0:22:30.00,Main-207-,,0,0,0,,Dövüşmeyin!Dialogue: 50,0:22:30.54,0:22:33.00,Main-207-,,0,0,0,,Beni dinleyin!Dialogue: 50,0:22:35.58,0:22:38.84,Main-207-,,0,0,0,,D-Durun... İsyan Ordusu...Dialogue: 50,0:22:38.84,0:22:41.67,Main-207-,,0,0,0,,Bu savaş...Dialogue: 50,0:22:56.35,0:22:57.44,Main-207-,,0,0,0,,İyi misin?!Dialogue: 50,0:22:59.27,0:23:01.86,Main-207-,,0,0,0,,Kraliyet Ordusu, ateşe karşılık verin!Dialogue: 50,0:23:34.27,0:23:35.23,Main-207-,,0,0,0,,Durun...!Dialogue: 50,0:23:35.73,0:23:37.02,Main-207-,,0,0,0,,Durun artık...Dialogue: 50,0:23:39.98,0:23:40.94,Main-207-,,0,0,0,,Lütfen...Dialogue: 50,0:23:42.36,0:23:44.19,Main-207-,,0,0,0,,Durun...Dialogue: 50,0:23:44.95,0:23:47.82,Main-207-,,0,0,0,,İyi mücadele ettin, tatlım.Dialogue: 50,0:23:48.53,0:23:49.66,Main-207-,,0,0,0,,Ama...Dialogue: 50,0:23:50.20,0:23:52.87,Main-207-,,0,0,0,,artık sesin onlara ulaşmayacak.Dialogue: 50,0:23:55.58,0:23:57.29,Main-207-,,0,0,0,,Buraya kadar mı?Dialogue: 50,0:24:02.25,0:24:03.84,Main-207-,,0,0,0,,Kaç, Vivi!Dialogue: 50,0:24:04.21,0:24:07.38,Main-207-,,0,0,0,,O adamdan uzaklaş!Dialogue: 50,0:24:15.14,0:24:16.14,Main-207-,,0,0,0,,Hayır.Dialogue: 50,0:24:21.82,0:24:25.28,Main-207-,,0,0,0,,Bu kum fırtınası, senin işin, değil mi?Dialogue: 50,0:24:27.57,0:24:28.57,Main-207-,,0,0,0,,Yine de...Dialogue: 50,0:24:30.66,0:24:34.49,Main-207-,,0,0,0,,Yine de 15 dakika içinde patlamayı durdurursam,Dialogue: 50,0:24:35.16,0:24:37.12,Main-207-,,0,0,0,,kayıpları en aza indirebilirim!Dialogue: 50,0:24:42.46,0:24:45.21,Main-207-,,0,0,0,,"Bunu yaparsam, isyanı durdurabilirim."Dialogue: 50,0:24:45.21,0:24:47.72,Main-207-,,0,0,0,,"Şunu yaparsam, isyanı durdurabilirim."Dialogue: 50,0:24:48.17,0:24:50.80,Main-207-,,0,0,0,,Aç gözlerini, Prenses.Dialogue: 50,0:24:51.80,0:24:55.64,Main-207-,,0,0,0,,Ateşli idealizmin midemi bulandırıyor.Dialogue: 50,0:24:59.10,0:25:04.73,Main-207-,,0,0,0,,İdealler, güce sahip olanların gerçekleştirebileceği bir şeydir.Dialogue: 50,0:25:05.53,0:25:08.61,Main-207-,,0,0,0,,Ve sen bunun dışındasın!Dialogue: 50,0:25:11.82,0:25:14.03,Main-207-,,0,0,0,,Ne düşündüğün umurumda değil.Dialogue: 50,0:25:15.20,0:25:17.37,Main-207-,,0,0,0,,İdeallerimden vazgeçmeyeceğim!Dialogue: 50,0:25:20.21,0:25:22.54,Main-207-,,0,0,0,,Senin gibi biri asla anlayamaz!Dialogue: 50,0:25:23.04,0:25:25.80,Main-207-,,0,0,0,,Ben bu ülkenin prensesiyim!Dialogue: 50,0:25:25.80,0:25:27.51,Main-207-,,0,0,0,,Asla pes etmeyeceğim!Dialogue: 50,0:25:33.01,0:25:35.47,Main-207-,,0,0,0,,Hiç çekiciliğin yok...Dialogue: 50,0:25:36.68,0:25:38.68,Main-207-,,0,0,0,,Pes edeceğimi mi sandın?Dialogue: 50,0:25:39.35,0:25:40.44,Main-207-,,0,0,0,,Ben...Dialogue: 50,0:25:43.40,0:25:47.11,Main-207-,,0,0,0,,Ben... bu ülkeyi kurtaracağım!Dialogue: 50,0:25:53.82,0:25:54.91,Main-207-,,0,0,0,,Vivi!Dialogue: 50,0:25:59.58,0:26:02.58,Main-207-,,0,0,0,,Bombanın meydanda patlaması için 15 dakika daha.Dialogue: 50,0:26:03.33,0:26:08.55,Main-207-,,0,0,0,,Konuştuğumuz gibi, İsyan Ordusu'nun destek kuvvetleri toplanıyor.Dialogue: 50,0:26:09.26,0:26:14.84,Main-207-,,0,0,0,,Acımasız kaderlerinin farkında olmadan doğruca patlama alanına yürüyorlar.Dialogue: 50,0:26:24.94,0:26:29.90,Main-207-,,0,0,0,,Askerlerin meydandaki bombadan haberdar olmalarına izin verseydin,Dialogue: 50,0:26:29.90,0:26:31.90,Main-207-,,0,0,0,,paniğe yol açabilirdin ama,Dialogue: 50,0:26:31.90,0:26:36.20,Main-207-,,0,0,0,,binlercesini veya on binlercesini kurtarabilirdin.Dialogue: 50,0:26:37.91,0:26:39.16,Main-207-,,0,0,0,,Yapma!Dialogue: 50,0:26:39.16,0:26:41.87,Main-207-,,0,0,0,,Lütfen yapma, Crocodile!Dialogue: 50,0:26:45.83,0:26:50.84,Main-207-,,0,0,0,,Sonunda, her şeyi kurtarmaya yönelik iyimser ideallerin,Dialogue: 50,0:26:50.84,0:26:56.76,Main-207-,,0,0,0,,çok sevdiğin halkının ölümüyle sonuçlanacaktır.Dialogue: 50,0:27:02.35,0:27:08.19,Main-207-,,0,0,0,,Baştan sona, bu ülkedeki insanlar beni eğlendirmekten...Dialogue: 50,0:27:08.19,0:27:11.32,Main-207-,,0,0,0,,asla geri kalmadılar.Dialogue: 50,0:27:19.74,0:27:25.33,Main-207-,,0,0,0,,Son iki yıldır örgütümü gözetleme konusunda iyi bir iş çıkardın.Dialogue: 50,0:27:27.33,0:27:29.75,Flashbacks-207-,,0,0,0,,Benim! Tanıyamadın mı beni?Dialogue: 50,0:27:31.00,0:27:32.92,Flashbacks-207-,,0,0,0,,Senin suçun değil.Dialogue: 50,0:27:32.92,0:27:34.88,Flashbacks-207-,,0,0,0,,Biraz kilo verdim...Dialogue: 50,0:27:36.89,0:27:40.85,Main-207-,,0,0,0,,Sonuçta sen ve arkadaşların hiçbir şeyi durduramadınız.Dialogue: 50,0:27:42.02,0:27:45.56,Main-207-,,0,0,0,,"İsyanı durduracağım." "Krallığı kurtaracağım."Dialogue: 50,0:27:45.56,0:27:49.52,Main-207-,,0,0,0,,Değersiz ideallerin sadece...Dialogue: 50,0:27:49.52,0:27:52.73,Main-207-,,0,0,0,,gereksiz kurbanlar yarattı.Dialogue: 50,0:27:54.99,0:27:56.86,Main-207-,,0,0,0,,Yine söyleyeceğim.Dialogue: 50,0:27:58.66,0:28:00.99,Main-207-,,0,0,0,,Bu ülkeyi kurtaramazsın.Dialogue: 50,0:28:03.45,0:28:05.41,Main-207-,,0,0,0,,Elveda, prenses.Dialogue: 50,0:28:50.33,0:28:51.63,Thoughts-207-,,0,0,0,,İmkânsız...Dialogue: 50,0:28:53.04,0:28:56.80,Main-207-,,0,0,0,,Crocodile!Dialogue: 50,0:29:00.72,0:29:02.35,Main-207-,,0,0,0,,Luffy-san!Dialogue: 50,0:29:05.06,0:29:07.27,Main-207-,,0,0,0,,Hasır Şapka...!Dialogue: 0,0:01:49.96,0:01:56.30,Title-207-,,0,0,0,,LiderlerDialogue: 1,0:01:49.96,0:01:56.30,Title-207-,,0,0,0,,LiderlerDialogue: 0,0:02:15.99,0:02:20.12,Captions-207-,,0,0,0,,Tsumegeri Birliği Alabasta'nın Seçkin Kraliyet MuhafızlarıDialogue: 1,0:02:15.99,0:02:20.12,Captions-207-,,0,0,0,,Tsumegeri Birliği Alabasta'nın Seçkin Kraliyet MuhafızlarıDialogue: 0,0:06:45.89,0