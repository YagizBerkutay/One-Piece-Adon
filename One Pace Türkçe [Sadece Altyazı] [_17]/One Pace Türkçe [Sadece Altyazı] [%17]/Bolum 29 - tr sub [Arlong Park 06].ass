8,23,23,23,1Style: Lyrics-furigana,Duality,36,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,2.95,0,2,23,23,34,1Style: Lyrics,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,2,23,23,34,1Style: Karaoke,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,23,1Style: Kanji,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,146,1Style: Roger-Monologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1Style: Romaji ED,Josefin Sans,80,&H00D0740C,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,8,10,10,20,1Style: Translation ED,Josefin Sans,82,&H00D0740C,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,2,10,10,20,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:50.01,0:02:00.01,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:50.01,0:01:56.71,Title-207-,,0,0,0,,Tamam, Hadi Karşı Koyalım!Dialogue: 0,0:01:56.72,0:01:58.47,Main-207-,,0,0,0,,Hanginiz Arlong?!Dialogue: 0,0:01:59.10,0:02:01.48,Main-207-,,0,0,0,,Arlong, benim.Dialogue: 0,0:02:01.48,0:02:02.94,Main-207-,,0,0,0,,Ben, Luffy.Dialogue: 0,0:02:03.31,0:02:04.90,Main-207-,,0,0,0,,Luffy mi?Dialogue: 0,0:02:04.90,0:02:06.56,Main-207-,,0,0,0,,Ee, nesin sen?Dialogue: 0,0:02:06.90,0:02:08.44,Main-207-,,0,0,0,,Korsanım!Dialogue: 0,0:02:08.78,0:02:10.49,Main-207-,,0,0,0,,Bekle, sersem.Dialogue: 0,0:02:11.57,0:02:13.32,Main-207-,,0,0,0,,Nereye gittiğini sanıyorsun?!Dialogue: 0,0:02:14.03,0:02:18.70,Main-207-,,0,0,0,,Önce bizimle konuşmalısın, ufaklık.Dialogue: 0,0:02:19.24,0:02:20.20,Main-207-,,0,0,0,,Aynen!Dialogue: 0,0:02:20.20,0:02:21.79,Main-207-,,0,0,0,,Eğer durmazsan...Dialogue: 0,0:02:23.00,0:02:24.29,Main-207-,,0,0,0,,Çekilin!Dialogue: 0,0:02:27.29,0:02:29.34,Main-207-,,0,0,0,,Bir korsanın benimle ne işi olur?Dialogue: 0,0:02:51.32,0:02:53.57,Main-207-,,0,0,0,,Kimsin lan sen?Dialogue: 0,0:02:58.62,0:02:59.49,Flashbacks-207-,,0,0,0,,Luffy...Dialogue: 0,0:03:01.12,0:03:02.12,Flashbacks-207-,,0,0,0,,Yardım et...Dialogue: 0,0:03:02.12,0:03:04.96,Main-207-,,0,0,0,,Rotacımızı ağlatmanıza asla izin vermem!Dialogue: 0,0:03:04.96,0:03:05.75,Main-207-,,0,0,0,,Pislik...Dialogue: 0,0:03:05.75,0:03:08.38,Main-207-,,0,0,0,,Arlong-san'ı nasıl aşağılarsın!Dialogue: 0,0:03:10.46,0:03:13.34,Main-207-,,0,0,0,,Çekilin aradan, çömezler!Dialogue: 0,0:03:16.34,0:03:17.39,Main-207-,,0,0,0,,Peh...Dialogue: 0,0:03:17.93,0:03:20.26,Main-207-,,0,0,0,,Sanki, tek başına hareket etmek zorundaydın.Dialogue: 0,0:03:20.26,0:03:22.47,Main-207-,,0,0,0,,Tek başıma kaybedecek değilim ya.Dialogue: 0,0:03:22.47,0:03:26.60,Main-207-,,0,0,0,,Aptal! Senin için endişelendiğimi kim söyledi?!Dialogue: 0,0:03:27.31,0:03:29.86,Main-207-,,0,0,0,,Tüm avı kendine almanı istemiyorum!Dialogue: 0,0:03:29.86,0:03:31.15,Main-207-,,0,0,0,,Anladım!Dialogue: 0,0:03:31.15,0:03:36.32,Main-207-,,0,0,0,,B-Ben hepsini alırsanız pek umursamam!Dialogue: 0,0:03:36.32,0:03:39.03,Main-207-,,0,0,0,,Baya cesaretlisin ha.Dialogue: 0,0:03:40.37,0:03:44.33,Main-207-,,0,0,0,,İşte o! Gizemli kılıç ustası!Dialogue: 0,0:03:44.33,0:03:45.83,Main-207-,,0,0,0,,Roronoa Zoro.Dialogue: 0,0:03:45.83,0:03:51.25,Main-207-,,0,0,0,,Ha? Hah, tahmin etmiştim! Beni kandırdı!Dialogue: 0,0:03:51.25,0:03:52.84,Main-207-,,0,0,0,,Beni tamamen kandırdı...Dialogue: 0,0:03:52.84,0:03:55.80,Main-207-,,0,0,0,,Hayır, bekle. Ona ben teklif etmemiş miydim?Dialogue: 0,0:03:55.80,0:03:57.38,Main-207-,,0,0,0,,Bakın! Uzun burunlu herif!Dialogue: 0,0:03:58.55,0:04:02.22,Main-207-,,0,0,0,,N-Nami onu öldürmemiş miydi?!Dialogue: 0,0:04:02.22,0:04:04.52,Main-207-,,0,0,0,,Şerefsiz hayatta. Bu demek oluyor ki...Dialogue: 0,0:04:05.39,0:04:08.19,Main-207-,,0,0,0,,O zaman düşündüğüm gibi.Dialogue: 0,0:04:16.24,0:04:18.15,Main-207-,,0,0,0,,Hey! Bunlar da kim?!Dialogue: 0,0:04:18.95,0:04:19.99,Main-207-,,0,0,0,,Bekleyin!Dialogue: 0,0:04:21.91,0:04:24.16,Main-207-,,0,0,0,,Arlong'u uçurdu!Dialogue: 0,0:04:24.16,0:04:25.87,Main-207-,,0,0,0,,İnanılır gibi değil!Dialogue: 0,0:04:27.37,0:04:29.71,Main-207-,,0,0,0,,Hiçbir sıradan insan bunu yapamaz!Dialogue: 0,0:04:29.71,0:04:31.67,Main-207-,,0,0,0,,Onlar...Dialogue: 0,0:04:32.17,0:04:35.38,Main-207-,,0,0,0,,Hâlâ içeri girmek istiyor musunuz?Dialogue: 0,0:04:35.38,0:04:38.76,Main-207-,,0,0,0,,Sizin varlığınız savaşı uzatır.Dialogue: 0,0:04:38.76,0:04:40.64,Main-207-,,0,0,0,,Ayak bağı olursunuz.Dialogue: 0,0:04:40.64,0:04:44.39,Main-207-,,0,0,0,,A-Ama neden savaşıyorlar?Dialogue: 0,0:04:44.39,0:04:47.02,Main-207-,,0,0,0,,Sebepleri ne?!Dialogue: 0,0:04:47.02,0:04:48.56,Main-207-,,0,0,0,,Savaşmak için sebep mi?Dialogue: 0,0:04:51.15,0:04:52.86,Main-207-,,0,0,0,,Nami abla ağlıyordu!Dialogue: 0,0:04:55.98,0:04:59.61,Main-207-,,0,0,0,,Hayatlarını ortaya koymak için bundan başka sebebe ihtiyaçları mı var?Dialogue: 0,0:05:03.83,0:05:06.54,Main-207-,,0,0,0,,Korsan, ha? Anladım.Dialogue: 0,0:05:06.54,0:05:09.41,Main-207-,,0,0,0,,Yani sizin olayınız bu.Dialogue: 0,0:05:10.33,0:05:13.00,Main-207-,,0,0,0,,En başından beri Nami'nin peşindeydiniz.Dialogue: 0,0:05:13.00,0:05:14.17,Main-207-,,0,0,0,,Ama...Dialogue: 0,0:05:15.92,0:05:18.51,Main-207-,,0,0,0,,siz dört aşağılık solucan ne yapabilirsiniz ki?!Dialogue: 0,0:05:20.76,0:05:24.30,Main-207-,,0,0,0,,Aptallar! Arlong'un size ayıracak vakti yok!Dialogue: 0,0:05:24.68,0:05:26.43,Main-207-,,0,0,0,,O fazlasıyla yetecektir!Dialogue: 0,0:05:34.86,0:05:36.07,Main-207-,,0,0,0,,Olamaz!Dialogue: 0,0:05:36.07,0:05:37.73,Main-207-,,0,0,0,,Geliyor!Dialogue: 0,0:05:41.32,0:05:43.82,Main-207-,,0,0,0,,Ne... Ne... Ne oluyor?!Dialogue: 0,0:05:43.82,0:05:46.66,Main-207-,,0,0,0,,Çık dışarı, Momoo!Dialogue: 0,0:05:53.12,0:05:55.25,Main-207-,,0,0,0,,C-Canavar!Dialogue: 0,0:05:55.25,0:05:58.75,Main-207-,,0,0,0,,Gosa şehrini yok eden Grand Line canavarı!Dialogue: 0,0:06:10.27,0:06:12.06,Main-207-,,0,0,0,,Geldi!Dialogue: 0,0:06:13.73,0:06:15.23,Main-207-,,0,0,0,,O-O...Dialogue: 0,0:06:15.23,0:06:16.52,Main-207-,,0,0,0,,Deniz ineği, Momoo!Dialogue: 0,0:06:22.65,0:06:23.91,Main-207-,,0,0,0,,Ha, o muymuş?Dialogue: 0,0:06:23.91,0:06:25.62,Main-207-,,0,0,0,,Balıkadamların arkadaşı mı?Dialogue: 0,0:06:29.41,0:06:32.37,Main-207-,,0,0,0,,Bekle! Momoo! Nereye gidiyorsun?!Dialogue: 0,0:06:32.79,0:06:36.00,Main-207-,,0,0,0,,Bekle! Dur! Geri gel! Momoo!Dialogue: 0,0:06:37.75,0:06:40.96,Main-207-,,0,0,0,,Momoo. Ne yaptığını sanıyorsun?Dialogue: 0,0:06:45.30,0:06:50.47,Main-207-,,0,0,0,,Yine de kaçmak istersen seni durdurmam.Dialogue: 0,0:06:52.48,0:06:54.52,Main-207-,,0,0,0,,Anladın mı, Momoo?Dialogue: 0,0:07:01.73,0:07:03.69,Main-207-,,0,0,0,,Geliyor!Dialogue: 0,0:07:03.69,0:07:04.70,Main-207-,,0,0,0,,Pekâlâ!Dialogue: 0,0:07:04.70,0:07:06.53,Main-207-,,0,0,0,,Momoo'yu takip edin!Dialogue: 0,0:07:10.91,0:07:13.33,Main-207-,,0,0,0,,Üzgünüm! Üzgünüm! Üzgünüm! Üzgünüm!Dialogue: 0,0:07:16.96,0:07:19.67,Main-207-,,0,0,0,,Bana bırakın! Bu zaman kaybı!Dialogue: 0,0:07:28.76,0:07:31.22,Main-207-,,0,0,0,,Şimdi ne planlıyor?!Dialogue: 0,0:07:31.22,0:07:34.10,Main-207-,,0,0,0,,Hiç hayra alamet değil...Dialogue: 0,0:07:51.87,0:07:53.74,Main-207-,,0,0,0,,Kolları uzadı!Dialogue: 0,0:07:55.96,0:07:58.25,Main-207-,,0,0,0,,Şeytan meyvesi gücü mü var?!Dialogue: 0,0:07:58.25,0:07:59.29,Main-207-,,0,0,0,,Ne?!Dialogue: 0,0:07:59.29,0:08:00.13,Main-207-,,0,0,0,,Kim takar?!Dialogue: 0,0:08:00.13,0:08:00.71,Main-207-,,0,0,0,,Hadi!Dialogue: 0,0:08:03.34,0:08:04.17,Main-207-,,0,0,0,,Hey! Kaç!Dialogue: 0,0:08:04.17,0:08:06.22,Main-207-,,0,0,0,,Ne? Ne yapıyor?!Dialogue: 0,0:08:06.22,0:08:08.72,Main-207-,,0,0,0,,Bilmiyorum, ama iyi görünmüyor!Dialogue: 0,0:08:08.72,0:08:15.06,Main-207-,,0,0,0,,Lastik-Lastik...Dialogue: 0,0:08:16.06,0:08:21.15,Main-207-,,0,0,0,,Rüzgar Gülü!Dialogue: 0,0:08:30.99,0:08:34.83,Main-207-,,0,0,0,,Buraya bunlarla savaşmaya gelmedim!Dialogue: 0,0:08:35.37,0:08:37.75,Main-207-,,0,0,0,,Tek dövmek istediğim kişi...Dialogue: 0,0:08:38.96,0:08:40.08,Main-207-,,0,0,0,,sensin!Dialogue: 0,0:08:40.79,0:08:42.96,Main-207-,,0,0,0,,O zaman, bu mükemmel.Dialogue: 0,0:08:44.59,0:08:48.72,Main-207-,,0,0,0,,Tam da seni öldürmeyi düşünüyordum.Dialogue: 0,0:08:48.72,0:08:51.14,Main-207-,,0,0,0,,Bu tehlikeliydi, aptal!Dialogue: 0,0:08:51.14,0:08:53.76,Main-207-,,0,0,0,,Bizi de mi öldürmeyi düşündün?!Dialogue: 0,0:08:58.89,0:09:01.27,Main-207-,,0,0,0,,Ne inanılmaz bir güç...Dialogue: 0,0:09:01.65,0:09:05.65,Main-207-,,0,0,0,,Hiç bir insanın o dev canavarı fırlatabileceğini tahmin etmezdim!Dialogue: 0,0:09:05.98,0:09:08.82,Main-207-,,0,0,0,,Rüya falan mı görüyorum?Dialogue: 0,0:09:11.70,0:09:14.37,Main-207-,,0,0,0,,Kardeşlerimize nasıl zarar verirsin!Dialogue: 0,0:09:15.33,0:09:19.62,Main-207-,,0,0,0,,Görünüşe göre bizim de savaşmamız lazım.Dialogue: 0,0:09:19.62,0:09:23.29,Main-207-,,0,0,0,,Onlara ırklarımız arasındaki farkı göstermeliyiz.Dialogue: 0,0:09:23.29,0:09:26.25,Main-207-,,0,0,0,,Ana birlik sonunda ortaya çıktı, ha?Dialogue: 0,0:09:30.05,0:09:32.76,Main-207-,,0,0,0,,Arlong-san, lütfen rahatla.Dialogue: 0,0:09:32.76,0:09:39.48,Main-207-,,0,0,0,,Eğer öfkene yenik düşersen, Arlong Park paramparça olur.Dialogue: 0,0:09:42.48,0:09:45.15,Main-207-,,0,0,0,,Onların icabına biz bakarız!Dialogue: 0,0:09:45.15,0:09:48.11,Main-207-,,0,0,0,,Tamamdır, istediğiniz gibi olsun.Dialogue: 0,0:09:49.03,0:09:51.28,Main-207-,,0,0,0,,Korkutucu!Dialogue: 0,0:09:51.90,0:09:54.82,Main-207-,,0,0,0,,Hey. Beyler. Söylemem gereken...Dialogue: 0,0:09:54.82,0:09:57.28,Main-207-,,0,0,0,,Ahtapot bir şeyler planlıyor.Dialogue: 0,0:09:57.28,0:10:00.50,Main-207-,,0,0,0,,Ahtapot, biraz tuzla haşlanıp dilimlendiğinde en iyisidir.Dialogue: 0,0:10:00.50,0:10:04.71,Main-207-,,0,0,0,,Biraz zeytinyağı ve kırmızı biberle, içkinin yanında enfes bir meze olur.Dialogue: 0,0:10:04.71,0:10:07.13,Main-207-,,0,0,0,,Hey, başım biraz belada. Beni dinleyin.Dialogue: 0,0:10:07.13,0:10:09.34,Main-207-,,0,0,0,,Bakalım görmemek nasıl hissettiriyor!Dialogue: 0,0:10:09.34,0:10:12.13,Main-207-,,0,0,0,,Hachi Mürekkep Püskürtme!Dialogue: 0,0:10:16.55,0:10:18.81,Main-207-,,0,0,0,,Aptal! Neden kaçmadın?!Dialogue: 0,0:10:20.52,0:10:22.77,Main-207-,,0,0,0,,Göremiyorum!Dialogue: 0,0:10:23.85,0:10:25.56,Main-207-,,0,0,0,,Şimdi işini bitirme zamanı!Dialogue: 0,0:10:28.57,0:10:30.53,Main-207-,,0,0,0,,Hey, Luffy! Kaç!Dialogue: 0,0:10:31.36,0:10:33.49,Main-207-,,0,0,0,,İşte sorun da bu.Dialogue: 0,0:10:34.66,0:10:37.41,Main-207-,,0,0,0,,Hareket edemiyorum!Dialogue: 0,0:10:38.41,0:10:39.70,Main-207-,,0,0,0,,Ha?!Dialogue: 0,0:10:40.08,0:10:42.71,Main-207-,,0,0,0,,A-Ayaklarım sıkıştı!Dialogue: 0,0:10:42.71,0:10:45.67,Main-207-,,0,0,0,,Ayaklarını oraya sıkıştıran sensin!Dialogue: 0,0:10:45.67,0:10:47.92,Main-207-,,0,0,0,,Niye böyle bir şey yaptı ki?!Dialogue: 0,0:10:49.38,0:10:52.76,Main-207-,,0,0,0,,Kayaların Üzerinden Hachi Mürekkep Püskürtme!Dialogue: 0,0:11:09.86,0:11:12.53,Main-207-,,0,0,0,,Çok acınası.Dialogue: 0,0:11:12.53,0:11:15.28,Main-207-,,0,0,0,,Sanji! Harikasın!Dialogue: 0,0:11:15.28,0:11:19.45,Main-207-,,0,0,0,,Görünüşe göre kaptanım olarak bir aptalı takip ediyorum.Dialogue: 0,0:11:19.78,0:11:20.95,Main-207-,,0,0,0,,Katılıyorum.Dialogue: 0,0:11:20.95,0:11:23.50,Main-207-,,0,0,0,,O... harika!Dialogue: 0,0:11:23.83,0:11:29.92,Main-207-,,0,0,0,,Ama o, bir bayana zarar verecek lanet bir çeteden 100 kat daha iyidir.Dialogue: 0,0:11:29.92,0:11:31.67,Main-207-,,0,0,0,,Bayan mı?Dialogue: 0,0:11:33.01,0:11:36.22,Main-207-,,0,0,0,,Buraya sadece o iğrenç kız için gelmen delilik.Dialogue: 0,0:11:36.72,0:11:38.18,Main-207-,,0,0,0,,İğrenç kız mı?Dialogue: 0,0:11:38.80,0:11:41.35,Main-207-,,0,0,0,,Yiyorsa Nami-san hakkında yine kötü konuş.Dialogue: 0,0:11:41.35,0:11:45.23,Main-207-,,0,0,0,,Seni tereyağında kızartacağım, sayın balık kızartması!Dialogue: 0,0:11:45.23,0:11:48.85,Main-207-,,0,0,0,,Bir insana göre yeteneklisin.Dialogue: 0,0:11:48.85,0:11:52.98,Main-207-,,0,0,0,,Ama kahramanlık peşindeki bir korsan, sadece sıradan biri olabilir.Dialogue: 0,0:11:54.90,0:11:58.24,Main-207-,,0,0,0,,Gel de sıradan olup olmadığımı kendin test et!Dialogue: 0,0:11:58.24,0:12:01.99,Main-207-,,0,0,0,,Yarım ömrüm sert bir korsan tarafından yetiştirildi.Dialogue: 0,0:12:04.66,0:12:09.63,Main-207-,,0,0,0,,Görünüşe göre balıkadam ırkının gerçek gücünü bilmiyorsun.Dialogue: 0,0:12:13.00,0:12:14.84,Main-207-,,0,0,0,,Hâlâ sıkışmış durumdalar.Dialogue: 0,0:12:15.51,0:12:17.80,Main-207-,,0,0,0,,Hâlâ mı?! Sıkışmışlar mı?!Dialogue: 0,0:12:19.09,0:12:21.05,Main-207-,,0,0,0,,Evet, hâlâ sıkışmış durumdalar.Dialogue: 0,0:12:21.05,0:12:23.81,Main-207-,,0,0,0,,Beni böyle çekmen işe yaramayacak gibi.Dialogue: 0,0:12:23.81,0:12:27.27,Main-207-,,0,0,0,,Hiç çabalıyor musun?! Bacaklarını kurtarmaya çalışıyor musun?!Dialogue: 0,0:12:27.27,0:12:32.23,Main-207-,,0,0,0,,Neden Arlong Park'ta oyun oynuyorlar?Dialogue: 0,0:12:32.73,0:12:34.32,Main-207-,,0,0,0,,Onları öldüreceğim!Dialogue: 0,0:12:35.57,0:12:38.20,Main-207-,,0,0,0,,Hadi be! Kurtul artık!Dialogue: 0,0:12:40.16,0:12:41.62,Main-207-,,0,0,0,,Geri gel!Dialogue: 0,0:12:41.62,0:12:42.99,Main-207-,,0,0,0,,Hey, ahtapot.Dialogue: 0,0:12:43.49,0:12:45.45,Main-207-,,0,0,0,,Şu anda meşguller.Dialogue: 0,0:12:46.58,0:12:48.41,Main-207-,,0,0,0,,Seninle ben ilgilenirim.Dialogue: 0,0:12:49.79,0:12:53.04,Main-207-,,0,0,0,,Roronoa Zoro! Doğru! Unutmuşum!Dialogue: 0,0:12:53.04,0:12:55.30,Main-207-,,0,0,0,,Ne cüretle beni kandırırsın?!Dialogue: 0,0:12:58.76,0:13:03.76,Main-207-,,0,0,0,,Doğru! Bir de tonlarca kardeşimi kestin!Dialogue: 0,0:13:03.76,0:13:06.18,Main-207-,,0,0,0,,Eski hikayeler ilgimi çekmiyor.Dialogue: 0,0:13:06.77,0:13:10.94,Main-207-,,0,0,0,,Beni neden öldürmek istediğin önemli değil.Dialogue: 0,0:13:11.65,0:13:13.90,Main-207-,,0,0,0,,Artık durum değişti!Dialogue: 0,0:13:14.44,0:13:17.11,Main-207-,,0,0,0,,Siz bizi yok etmeye çalışmıyorsunuz.Dialogue: 0,0:13:17.11,0:13:19.86,Main-207-,,0,0,0,,Biz sizi yok etmeye çalışıyoruz!Dialogue: 0,0:13:19.86,0:13:24.03,Main-207-,,0,0,0,,P-Pekâlâ, Zoro! Ahtapot senindir! Güzel!Dialogue: 0,0:13:24.70,0:13:26.33,Main-207-,,0,0,0,,Luffy!Dialogue: 0,0:13:32.50,0:13:33.79,Main-207-,,0,0,0,,Geri döndüm.Dialogue: 0,0:13:36.80,0:13:38.46,Main-207-,,0,0,0,,Ulan sen...Dialogue: 0,0:13:38.46,0:13:40.42,Main-207-,,0,0,0,,Benim hatam...Dialogue: 0,0:13:40.42,0:13:44.43,Main-207-,,0,0,0,,Galiba seni gerçekten öldürmemi istiyorsun.Dialogue: 0,0:13:49.27,0:13:53.23,Main-207-,,0,0,0,,Bu adam Gen-san'ı kurtarmamış mıydı?Dialogue: 0,0:13:56.02,0:13:58.19,Main-207-,,0,0,0,,Siz Cocoyashi köylülerisiniz!Dialogue: 0,0:13:58.19,0:13:59.32,Main-207-,,0,0,0,,Ha?Dialogue: 0,0:13:59.32,0:14:04.20,Main-207-,,0,0,0,,Silah taşıdığınıza bakılırsa bu bir isyan girişimi, öyle mi?Dialogue: 0,0:14:04.66,0:14:05.49,Main-207-,,0,0,0,,Hepiniz–Dialogue: 0,0:14:05.49,0:14:07.16,Main-207-,,0,0,0,,Patlayan Yıldız!Dialogue: 0,0:14:07.74,0:14:09.20,Main-207-,,0,0,0,,Usopp abi!Dialogue: 0,0:14:12.00,0:14:15.58,Main-207-,,0,0,0,,Senin rakibin benim!Dialogue: 0,0:14:17.67,0:14:20.55,Main-207-,,0,0,0,,Ölmeye bu kadar hevesliysen, şimdi gebertirim seni!Dialogue: 0,0:14:23.51,0:14:25.93,Main-207-,,0,0,0,,O delikanlı da kim?Dialogue: 0,0:14:25.93,0:14:29.68,Main-207-,,0,0,0,,Bir an cesur davranıyor, sonra kaçıyor. İnsanı şaşırtıyor.Dialogue: 0,0:14:32.98,0:14:34.56,Main-207-,,0,0,0,,Gel buraya, uzun burun!Dialogue: 0,0:14:34.56,0:14:36.61,Main-207-,,0,0,0,,Senin de ağzın kocaman!Dialogue: 0,0:14:37.82,0:14:40.19,Thoughts-207-,,0,0,0,,Bunlar nasıl korsanlar?!Dialogue: 0,0:14:44.99,0:14:49.83,Main-207-,,0,0,0,,Hepiniz zavallısınız. Çekilin. İzlemekten bıktım.Dialogue: 0,0:14:50.12,0:14:54.33,Main-207-,,0,0,0,,Arlong-san! Sizden öfkelenmemenizi istedik!Dialogue: 0,0:14:54.33,0:14:58.79,Main-207-,,0,0,0,,Endişelenme. Sadece aklıma eğlenceli bir oyun fikri geldi.Dialogue: 0,0:15:00.42,0:15:05.13,Main-207-,,0,0,0,,Seni pataklayacağım!Dialogue: 0,0:15:06.43,0:15:10.14,Main-207-,,0,0,0,,Gerçekten bizi yenebilir misiniz?Dialogue: 0,0:15:10.14,0:15:12.10,Main-207-,,0,0,0,,Peki ya yenersek?Dialogue: 0,0:15:12.10,0:15:15.56,Main-207-,,0,0,0,,Yenebiliriz, aptal! Bırak beni!Dialogue: 0,0:15:15.56,0:15:17.52,Main-207-,,0,0,0,,Söyleyecek bir şeyi var gibi.Dialogue: 0,0:15:25.45,0:15:27.11,Main-207-,,0,0,0,,Ne oluyor...?! Ne oluyor...?!Dialogue: 0,0:15:29.12,0:15:31.95,Main-207-,,0,0,0,,Şeytan meyvesi yiyenler yüzemez!Dialogue: 0,0:15:32.49,0:15:36.71,Main-207-,,0,0,0,,Kaldı ki, bu durumda meyve kullanıcısı olmayanlar bile yüzemezdi!Dialogue: 0,0:15:38.21,0:15:40.13,Main-207-,,0,0,0,,Yoksa onu denize mi atacak?!Dialogue: 0,0:15:41.00,0:15:43.88,Main-207-,,0,0,0,,Lastik-Lastik Tabanca!Dialogue: 0,0:15:46.30,0:15:49.26,Main-207-,,0,0,0,,Ah!Dialogue: 0,0:15:49.26,0:15:50.35,Main-207-,,0,0,0,,Aptal.Dialogue: 0,0:15:51.26,0:15:53.72,Main-207-,,0,0,0,,Lanet olası!Dialogue: 0,0:15:53.72,0:15:55.68,Main-207-,,0,0,0,,Boşuna uğraş.Dialogue: 0,0:16:00.73,0:16:01.36,Main-207-,,0,0,0,,Luffy!Dialogue: 0,0:16:01.65,0:16:02.86,Main-207-,,0,0,0,,Şerefsiz!Dialogue: 0,0:16:13.08,0:16:13.91,Main-207-,,0,0,0,,Seni kurtara–Dialogue: 0,0:16:13.91,0:16:15.79,Main-207-,,0,0,0,,Aptal! Acele etme!Dialogue: 0,0:16:16.41,0:16:19.37,Main-207-,,0,0,0,,Suya girmemizi istiyorlar!Dialogue: 0,0:16:19.37,0:16:23.00,Main-207-,,0,0,0,,Su altında savaşırsak onlar için oldukça avantajlı olur.Dialogue: 0,0:16:23.75,0:16:26.17,Main-207-,,0,0,0,,Luffy'yi kurtarmanın tek bir yolu var!Dialogue: 0,0:16:27.34,0:16:30.68,Main-207-,,0,0,0,,Bu adamları anında yenip sonra suya mı girelim?Dialogue: 0,0:16:32.05,0:16:34.14,Main-207-,,0,0,0,,Hadi yapalım! Zamanımız yok!Dialogue: 0,0:16:34.14,0:16:34.68,Main-207-,,0,0,0,,Evet!Dialogue: 0,0:16:34.68,0:16:38.64,Main-207-,,0,0,0,,Acaba lastik çocuk ne kadar dayanabilecek?Dialogue: 0,0:16:38.64,0:16:40.69,Main-207-,,0,0,0,,Ah, demek oyun bu?Dialogue: 0,0:16:40.69,0:16:41.94,Main-207-,,0,0,0,,Anladım.Dialogue: 0,0:16:45.23,0:16:46.82,Main-207-,,0,0,0,,Balığı alabilirsin.Dialogue: 0,0:16:47.53,0:16:49.66,Main-207-,,0,0,0,,Sen de ahtapotu kes ve sosla.Dialogue: 0,0:17:02.54,0:17:06.26,Thoughts-207-,,0,0,0,,Bu iyi olmadı. Hiç gücüm kalmadı.Dialogue: 0,0:17:07.38,0:17:10.09,Main-207-,,0,0,0,,Ne yapacağız?! Tek başına kurtulamaz!Dialogue: 0,0:17:10.09,0:17:11.84,Main-207-,,0,0,0,,Luffy abi ölecek!Dialogue: 0,0:17:20.39,0:17:22.77,Main-207-,,0,0,0,,Su altında bile nefes alamıyorlar.Dialogue: 0,0:17:23.06,0:17:26.07,Main-207-,,0,0,0,,İnsanlar gerçekten aşağılık varlıklar!Dialogue: 0,0:17:28.11,0:17:31.07,Main-207-,,0,0,0,,Gel bakalım! Karşıma çık da görelim, seni ucube ahtapot!Dialogue: 0,0:17:35.45,0:17:36.66,Main-207-,,0,0,0,,Kabul!Dialogue: 0,0:17:36.99,0:17:39.16,Main-207-,,0,0,0,,Senin icabına beş saniyede bakacağım!Dialogue: 0,0:17:40.00,0:17:41.08,Main-207-,,0,0,0,,Hayır, üç saniye!Dialogue: 0,0:17:41.67,0:17:43.38,Main-207-,,0,0,0,,Bu kadar aceleci olma.Dialogue: 0,0:17:44.00,0:17:48.13,Main-207-,,0,0,0,,Ne olursa olsun, hiçbirinizin hayatta kalma şansı yok!Dialogue: 0,0:18:01.56,0:18:06.48,Main-207-,,0,0,0,,Ö-Öldürüleceğim!Dialogue: 0,0:18:06.82,0:18:08.48,Main-207-,,0,0,0,,Onu beş saniyede yeneceğim, Luffy!Dialogue: 0,0:18:08.48,0:18:09.69,Main-207-,,0,0,0,,Hemen geliyorum!Dialogue: 0,0:18:10.07,0:18:11.57,Main-207-,,0,0,0,,Hachi Mürekkep Püskürtme!Dialogue: 0,0:18:19.79,0:18:22.04,Main-207-,,0,0,0,,Saçım! Şerefsiz!Dialogue: 0,0:18:22.04,0:18:24.83,Main-207-,,0,0,0,,Seni...Dialogue: 0,0:18:25.21,0:18:26.13,Main-207-,,0,0,0,,affediyorum.Dialogue: 0,0:18:26.13,0:18:28.42,Main-207-,,0,0,0,,Alt tarafı saç, geri uzayacaktır.Dialogue: 0,0:18:28.42,0:18:28.84,Main-207-,,0,0,0,,Ha?Dialogue: 0,0:18:29.21,0:18:30.46,Main-207-,,0,0,0,,Roronoa Zoro!Dialogue: 0,0:18:30.46,0:18:34.47,Main-207-,,0,0,0,,Beni kesemezsin çünkü altı elim var.Dialogue: 0,0:18:34.47,0:18:36.55,Main-207-,,0,0,0,,Hadi kes beni, gücün yetiyorsa!Dialogue: 0,0:18:36.55,0:18:37.14,Main-207-,,0,0,0,,Seni ucube!Dialogue: 0,0:18:37.51,0:18:38.10,Main-207-,,0,0,0,,Hachi'nin  Üçlü Kılıç Yakalaması!Dialogue: 0,0:18:38.10,0:18:39.01,Main-207-,,0,0,0,,Hachi'nin Üçlü Kılıç Yakalaması!Dialogue: 0,0:18:39.01,0:18:39.85,Main-207-,,0,0,0,,Hachi'nin Üçlü Kılıç Yakalaması!Dialogue: 0,0:18:39.85,0:18:40.60,Main-207-,,0,0,0,,Hachi'nin Üçlü Kılıç Yakalaması!Dialogue: 0,0:18:40.60,0:18:41.43,Main-207-,,0,0,0,,Hachi'nin Üçlü Kılıç Yakalaması!Dialogue: 0,0:18:41.43,0:18:42.27,Main-207-,,0,0,0,,Hachi'nin Üçlü Kılıç Yakalaması!Dialogue: 0,0:18:42.27,0:18:43.10,Main-207-,,0,0,0,,Hachi'nin Üçlü Kılıç Yakalaması!Dialogue: 0,0:18:43.10,0:18:44.06,Main-207-,,0,0,0,,Hachi'nin Üçlü Kılıç Yakalaması!Dialogue: 0,0:18:46.40,0:18:48.15,Main-207-,,0,0,0,,Acıdı!Dialogue: 0,0:18:48.15,0:18:49.90,Main-207-,,0,0,0,,Seninle oynayacak zamanım yok!Dialogue: 0,0:18:51.53,0:18:53.36,Main-207-,,0,0,0,,Ritmimi bozuyor.Dialogue: 0,0:18:54.03,0:18:55.74,Thoughts-207-,,0,0,0,,Yoksa o...Dialogue: 0,0:18:55.74,0:18:57.74,Main-207-,,0,0,0,,Dikkatsiz olursan, ölürsün!Dialogue: 0,0:18:57.74,0:19:00.74,Main-207-,,0,0,0,,Balık, aşçıyla kapışmamalı!Dialogue: 0,0:19:01.24,0:19:04.04,Main-207-,,0,0,0,,Zamanımız azalıyor. Hiç zaman kalmadı!Dialogue: 0,0:19:05.46,0:19:07.04,Main-207-,,0,0,0,,Öl artık!Dialogue: 0,0:19:10.55,0:19:14.55,Main-207-,,0,0,0,,Dokuz Numaralı Takohachi!Dialogue: 0,0:19:16.05,0:19:18.72,Main-207-,,0,0,0,,Ne olmuş yani?! İn aşağı artık!Dialogue: 0,0:19:20.22,0:19:21.97,Main-207-,,0,0,0,,Şerefsiz ahtapot!Dialogue: 0,0:19:23.14,0:19:26.23,Main-207-,,0,0,0,,Yavaş hareket ediyor ve oyalanıyor!Dialogue: 0,0:19:26.23,0:19:28.19,Main-207-,,0,0,0,,Ama şimdi denize girerse,Dialogue: 0,0:19:28.19,0:19:30.77,Main-207-,,0,0,0,,dibi boylar.Dialogue: 0,0:19:30.77,0:19:33.90,Main-207-,,0,0,0,,Böyle giderse de Luffy abi ölecek!Dialogue: 0,0:19:33.90,0:19:35.86,Main-207-,,0,0,0,,Bir şey yapmamız lazım!Dialogue: 0,0:19:35.86,0:19:36.41,Main-207-,,0,0,0,,Evet!Dialogue: 0,0:19:36.41,0:19:36.86,Main-207-,,0,0,0,,Durun!Dialogue: 0,0:19:36.86,0:19:38.53,Main-207-,,0,0,0,,– Ah! – Ah!Dialogue: 0,0:19:38.53,0:19:42.08,Main-207-,,0,0,0,,Bu kadar ciddi yaralarla nasıl denize girebilirsiniz?Dialogue: 0,0:19:43.20,0:19:45.91,Main-207-,,0,0,0,,Bu durumda bir şey yapamazsınız.Dialogue: 0,0:19:46.46,0:19:49.58,Main-207-,,0,0,0,,Bahsettiğiniz o lastik delikanlıysa, ben gider kurtarırım.Dialogue: 0,0:19:49.58,0:19:51.04,Main-207-,,0,0,0,,K-Kurtaracak mısın?Dialogue: 0,0:19:51.04,0:19:52.30,Main-207-,,0,0,0,,Gen-san!Dialogue: 0,0:19:52.30,0:19:53.21,Main-207-,,0,0,0,,Ben de geliyorum!Dialogue: 0,0:19:53.21,0:19:54.38,Main-207-,,0,0,0,,Ben de geleceğim!Dialogue: 0,0:19:54.38,0:19:55.72,Main-207-,,0,0,0,,Ben de!Dialogue: 0,0:19:55.72,0:20:01.01,Main-207-,,0,0,0,,Olmaz! Eğer hepimiz kurtarmaya gidersek balıkadamlar fark eder.Dialogue: 0,0:20:01.01,0:20:03.56,Main-207-,,0,0,0,,Bu sadece daha fazla sorun çıkarır.Dialogue: 0,0:20:03.56,0:20:04.27,Main-207-,,0,0,0,,Gen-san!Dialogue: 0,0:20:04.27,0:20:08.90,Main-207-,,0,0,0,,Onların savaşına müdahale edersek bu anlamsız olur.Dialogue: 0,0:20:08.90,0:20:10.23,Main-207-,,0,0,0,,Bu yüzden tek gitmeliyim.Dialogue: 0,0:20:11.23,0:20:13.36,Main-207-,,0,0,0,,Üzgünüz... Teşekkür ederim!Dialogue: 0,0:20:13.36,0:20:16.82,Main-207-,,0,0,0,,Size bırakıyoruz. Özür dilerim ama lütfen acele edin.Dialogue: 0,0:20:17.32,0:20:18.03,Main-207-,,0,0,0,,Bekle!Dialogue: 0,0:20:19.11,0:20:20.95,Main-207-,,0,0,0,,Gen-san, ben de geliyorum.Dialogue: 0,0:20:20.95,0:20:23.08,Main-207-,,0,0,0,,Nojiko, yaralısın!Dialogue: 0,0:20:23.08,0:20:26.83,Main-207-,,0,0,0,,Bu adamlar küçük kardeşim için savaşıyor!Dialogue: 0,0:20:27.12,0:20:28.12,Main-207-,,0,0,0,,Gen-san!Dialogue: 0,0:20:29.33,0:20:31.29,Main-207-,,0,0,0,,Tamam. Gel!Dialogue: 0,0:20:31.29,0:20:32.13,Main-207-,,0,0,0,,Acele edelim!Dialogue: 0,0:20:32.13,0:20:32.79,Main-207-,,0,0,0,,Tamam!Dialogue: 0,0:20:34.50,0:20:35.92,Thoughts-207-,,0,0,0,,Üzgünüm...Dialogue: 0,0:20:35.92,0:20:38.72,Thoughts-207-,,0,0,0,,Sadece biraz daha güçlü olsaydık...Dialogue: 0,0:20:39.18,0:20:42.14,Thoughts-207-,,0,0,0,,Lütfen... Luffy abiyi kurtarın!Dialogue: 0,0:20:46.22,0:20:50.10,Main-207-,,0,0,0,,Roronoa Zoro! Sana bir soru sorsam sakıncası olur mu? Olmaz, değil mi?Dialogue: 0,0:20:50.10,0:20:52.23,Main-207-,,0,0,0,,Üç kılıç stilini kullandığını duydum.Dialogue: 0,0:20:52.23,0:20:53.98,Main-207-,,0,0,0,,Niye tek kılıç var elinde?Dialogue: 0,0:20:53.98,0:20:56.61,Main-207-,,0,0,0,,Tek kılıca rağmen kaybediyorsun!Dialogue: 0,0:20:56.61,0:20:59.20,Main-207-,,0,0,0,,K-Kapa' çeneni! Bu dövüşü ciddiye almıyorum!Dialogue: 0,0:20:59.20,0:21:03.83,Main-207-,,0,0,0,,Aslında, insan bir kılıç ustasının beni yenememesinin bir sebebi var.Dialogue: 0,0:21:03.83,0:21:05.91,Main-207-,,0,0,0,,Anlatayım mı? İstersin, değil mi?Dialogue: 0,0:21:05.91,0:21:09.16,Main-207-,,0,0,0,,Duyduğunda saşıracaksın, korkacaksın, şoke uğrayacaksın!Dialogue: 0,0:21:09.92,0:21:13.29,Thoughts-207-,,0,0,0,,Kahretsin! Şimdi bitkin düşemem!Dialogue: 0,0:21:21.34,0:21:22.80,Main-207-,,0,0,0,,Düşündüğüm gibi...Dialogue: 0,0:21:24.93,0:21:26.77,Main-207-,,0,0,0,,Şahin Göz'ün açtığı yaralar...Dialogue: 0,0:21:27.35,0:21:28.48,Main-207-,,0,0,0,,Abi!Dialogue: 0,0:21:31.69,0:21:34.31,Main-207-,,0,0,0,,İşte! Bu benim asıl formum!Dialogue: 0,0:21:34.31,0:21:37.15,Main-207-,,0,0,0,,Altı kılıç stili kullanıcısı Hachi geliyor!Dialogue: 0,0:21:37.15,0:21:41.03,Main-207-,,0,0,0,,Hey! Düşecek zaman değil! Benimle alay etme!Dialogue: 0,0:21:43.82,0:21:44.99,Main-207-,,0,0,0,,Ah! Abi!Dialogue: 0,0:21:44.99,0:21:47.24,Main-207-,,0,0,0,,Yani acıya katlanıyordu!Dialogue: 0,0:21:47.24,0:21:48.41,Main-207-,,0,0,0,,Evet.Dialogue: 0,0:21:48.41,0:21:52.92,Main-207-,,0,0,0,,Yaraları normal bir insanı ya öldürür ya da altı ay yatalak bırakırdı!Dialogue: 0,0:21:52.92,0:21:53.71,Main-207-,,0,0,0,,Ne dedin?!Dialogue: 0,0:21:56.63,0:21:58.59,Main-207-,,0,0,0,,Bir şeyin garip olduğunu biliyordum.Dialogue: 0,0:21:58.59,0:22:02.26,Main-207-,,0,0,0,,O düellodan sonra hiçbir şey olmamış gibi davranıyordu.Dialogue: 0,0:22:02.26,0:22:03.64,Main-207-,,0,0,0,,Aptal mı ne?!Dialogue: 0,0:22:11.27,0:22:14.52,Main-207-,,0,0,0,,Dikkat etmen için seni uyardığımı sanıyordum.Dialogue: 0,0:22:14.52,0:22:16.73,Main-207-,,0,0,0,,Balıkadam Karate'de 40. seviyedeyim.Dialogue: 0,0:22:16.73,0:22:19.23,Main-207-,,0,0,0,,N-Ne?Dialogue: 0,0:22:19.23,0:22:20.69,Main-207-,,0,0,0,,Birisi mi uçtu?!Dialogue: 0,0:22:20.69,0:22:22.40,Main-207-,,0,0,0,,A-Abi?!Dialogue: 0,0:22:22.40,0:22:23.82,Main-207-,,0,0,0,,Aşçı abi!Dialogue: 0,0:22:24.41,0:22:25.87,Main-207-,,0,0,0,,Ahh...Dialogue: 0,0:22:26.49,0:22:29.49,Main-207-,,0,0,0,,Aşçı abi!Dialogue: 0,0:22:30.29,0:22:32.75,Main-207-,,0,0,0,,Onunla ilgilendim, Arlong-san.Dialogue: 0,0:22:32.75,0:22:34.71,Main-207-,,0,0,0,,Roronoa Zoro'yu ne yapalım?Dialogue: 0,0:22:34.71,0:22:39.75,Main-207-,,0,0,0,,Denize atın gitsin. Ne kadar güçsüzler. Çok sıkıcı!Dialogue: 0,0:22:42.88,0:22:43.72,Main-207-,,0,0,0,,Bitti mi?Dialogue: 0,0:22:44.05,0:22:47.55,Main-207-,,0,0,0,,Yine de çok fazla hasar verdiler.Dialogue: 0,0:22:47.55,0:22:49.26,Main-207-,,0,0,0,,Önemli değil.Dialogue: 0,0:22:49.26,0:22:52.48,Main-207-,,0,0,0,,Arlong Park bu kadar hasarla yok edilemez.Dialogue: 0,0:22:52.48,0:22:53.69,Main-207-,,0,0,0,,Katılıyorum.Dialogue: 0,0:22:55.31,0:22:57.40,Main-207-,,0,0,0,,Bu ne cürret, Roronoa Zoro!Dialogue: 0,0:22:57.40,0:23:01.03,Main-207-,,0,0,0,,Ben, yüce kılıç ustası, sana saldırmadan şoktan mı öldün?!Dialogue: 0,0:23:01.03,0:23:04.61,Main-207-,,0,0,0,,Altı kılıç stilime yenilseydin, tarih seni unutmayacaktı.Dialogue: 0,0:23:04.61,0:23:08.24,Main-207-,,0,0,0,,Ne yaparsan yap, dünya tersine dönse bile,Dialogue: 0,0:23:08.24,0:23:14.29,Main-207-,,0,0,0,,altı kılıç kullanan bana hiçbir insan el süremezdi!Dialogue: 0,0:23:22.71,0:23:26.18,Main-207-,,0,0,0,,Yeter, Hachi. Nasıl hissettiğini biliyorum,Dialogue: 0,0:23:26.18,0:23:28.72,Main-207-,,0,0,0,,ama ciddi öfkelenirsen, sorun olur.Dialogue: 0,0:23:28.72,0:23:30.39,Main-207-,,0,0,0,,Arlong Park'ı mı yok edeceksin?Dialogue: 0,0:23:30.39,0:23:32.14,Main-207-,,0,0,0,,Oh! Ahh...Dialogue: 0,0:23:32.14,0:23:34.14,Main-207-,,0,0,0,,H-Hayır. Üzgünüm.Dialogue: 0,0:23:34.81,0:23:37.73,Main-207-,,0,0,0,,Abarttım.Dialogue: 0,0:23:37.73,0:23:38.90,Main-207-,,0,0,0,,Kendini kaptırma.Dialogue: 0,0:23:38.90,0:23:40.90,Main-207-,,0,0,0,,Haklısın. Özür dilerim.Dialogue: 0,0:23:41.78,0:23:44.61,Main-207-,,0,0,0,,Altı kılıç stili, ha? Ne şaka ama!Dialogue: 0,0:23:50.83,0:23:52.29,Main-207-,,0,0,0,,Abi!Dialogue: 0,0:23:54.54,0:23:56.75,Main-207-,,0,0,0,,Roronoa Zoro!Dialogue: 0,0:23:56.75,0:23:59.08,Main-207-,,0,0,0,,Sana tek bir şey söyleyeceğim, ahtapot.Dialogue: 0,0:23:59.67,0:24:02.59,Main-207-,,0,0,0,,Tekrar görmem gereken biri var.Dialogue: 0,0:24:03.17,0:24:05.67,Main-207-,,0,0,0,,O zamana kadar,Dialogue: 0,0:24:07.93,0:24:11.72,Main-207-,,0,0,0,,Azrail bile canımı alamaz!Dialogue: 0,0:24:25.74,0:24:26.90,Main-207-,,0,0,0,,Hım? Ahh!Dialogue: 0,0:24:28.45,0:24:30.24,Main-207-,,0,0,0,,Hâlâ yaşıyor!Dialogue: 0,0:24:30.24,0:24:32.41,Main-207-,,0,0,0,,Abi! Aşçı abi!Dialogue: 0,0:24:33.49,0:24:37.62,Main-207-,,0,0,0,,Demek yediğim yumruk 40. seviyeydi, ha? Hımm...Dialogue: 0,0:24:38.25,0:24:43.34,Main-207-,,0,0,0,,O zaman bizim moruktan sürekli yediğim tekmeler 400. seviye olmalı.Dialogue: 0,0:24:44.05,0:24:46.51,Main-207-,,0,0,0,,Ne inatçı herif be!Dialogue: 0,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 1,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 0,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Gigglebot ZenefDialogue: 1,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Gigglebot ZenefDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,MüzikDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,MüzikDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,HaleeDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,HaleeDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,GrafikDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,GrafikDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,DatenshiDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,DatenshiDialogue: 0,0:00:06.78,0:00:10.78,Credits-207-,,0,0,0,,Kalite KontrolDialogue: 1,0:00:06.78,0:00:10.78,Credits-207-,,0,0,0,,Kalite KontrolDialogue: 0,0:00:06.78,0:00:10.78,Credits-207-,,0,0,0,,DolphinWeabu danpmss Feeso Galaxy 9000 Pepperjack ScolinesDialogue: 1,0:00:06.78,0:00:10.78,Credits-207-,,0,0,0,,DolphinWeabu danpmss Feeso Galaxy 9000 Pepperjack ScolinesDialogue: 0,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,KaraokeDialogue: 1,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,KaraokeDialogue: 0,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,KaitouYahikoDialogue: 1,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,KaitouYahikoDialogue: 0,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,ZamanlamaDialogue: 1,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,ZamanlamaDialogue: 0,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,PhosCity VillagerDialogue: 1,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,PhosCity VillagerDialogue: 0,0:00:13.28,0:00:16.79,Credits-207-,,0,0,0,,Altyazı Düzenleme [TR]Dialogue: 1,0:00:13.28,0:00:16.79,Credits-207-,,0,0,0,,Altyazı Düzenleme [TR]Dialogue: 0,0:00:13.28,0:00:16.79,Credits-207-,,0,0,0,,Jack Cohle -onepacetr.net-Dialogue: 1,0:00:13.28,0:00:16.79,Credits-207-,,0,0,0,,Jack Cohle -onepacetr.net-Dialogue: 0,0:00:16.79,0:00:19.25,Credits-207-,,0,0,0,,RawsDialogue: 1,0:00:16.79,0:00:19.25,Credits-207-,,0,0,0,,RawsDialogue: 0,0:00:16.79,0:00:19.25,Credits-207-,,0,0,0,,Neo-RawsDialogue: 1,0:00:16.79,0:00:19.25,Credits-207-,,0,0,0,,Neo-RawsDialogue: 0,0:00:16.79,0:00:19.25,Credits-207-,,0,0,0,,Çevirmenler [TR]Dialogue: 1,0:00:16.79,0:00:19.25,Credits-207-,,0,0,0,,Çevirmenler [TR]Dialogue: 0,0:00:16.79,0:00:19.25,Credits-207-,,0,0,0,,Knaryaa Jack Cohle -onepacetr.net-Dialogue: 1,0:00:16.79,0:00:19.25,Credits-207-,,0,0,0,,Knaryaa Jack Cohle -onepacetr.net-Dialogue: 0,0:00:01.52,0:00:03.65,Roger-Monologue,,0,0,0,,Zenginlik, şöhret, güç...Dialogue: 0,0:00:03.65,0:00:07.82,Roger-Monologue,,0,0,0,,Dünyanın sunabileceği her şeyi elde eden adam, Korsanlar Kralı, Gold Roger.Dialogue: 0,0:00:07.82,0:00:11.66,Roger-Monologue,,0,0,0,,Son sözleri dünyanın her yerinden maceracıları denize çekti.Dialogue: 0,0:00:11.66,0:00:13.66,Roger-Monologue,,0,0,0,,Hazinem mi?Dialogue: 0,0:00:13.66,0:00:15.45,Roger-Monologue,,0,0,0,,İstiyorsanız, alabilirsiniz.Dialogue: 0,0:00:15.45,0:00:16.66,Roger-Monologue,,0,0,0,,Arayıp bulun!Dialogue: 0,0:00:16.66,0:00:19.25,Roger-Monologue,,0,0,0,,Bu dünyanın sunabileceği her şeyi orada bıraktım!Dialogue: 0,0:00:21.67,0:00:26.38,Roger-Monologue,,0,0,0,,Artık herkes, hayallerinin peşinde Grand Line’a yelken açıyor!Dialogue: 0,0:00:26.38,0:00:29.63,Roger-Monologue,,0,0,0,,Dünya, Büyük Korsan Çağı'na girdi!Dialogue: 0,0:00:29.91,0:00:35.35,Lyrics,,0,0,0,fx,ADialogue: 0,0:00:29.91,0:00:35.35,Lyrics,,0,0,0,fx,tDialogue: 0,0:00:29.91,0:00:35.35,Lyrics,,0,0,0,fx,lDialogue: 0,0:00:29.91,0:00:35.35,Lyrics,,0,0,0,fx,aDialogue: 0,0:00:29.91,0:00:35.35,Lyrics,,0,0,0,fx,yDialogue: 0,0:00:29.91,0:00:35.35,Lyrics,,0,0,0,fx,ıDialogue: 0,0:00:29.91,0:00:35.35,Lyrics,,0,0,0,fx,nDialogue: 0,0:00:29.91,0:00:35.35,Lyrics,,0,0,0,fx,Dialogue: 0,0:00:29.91,0:00:35.35,Lyrics,,0,0,0,fx,gDialogue: 0,0:00:29.91,0:00:35.35,Lyrics,,0,0,0,fx,eDialogue: 0,0:00:29.91,0:00:35.35,Lyrics,,0,0,0,fx,mDialogue: 0,0:00:29.91,0:00:35.35,Lyrics,,0,0,0,fx,iDialogue: 0,0:00:29.91,0:00:35.35,Lyrics,,0,0,0,fx,yDialogue: 0,0:00:29.91,0:00:35.35,Lyrics,,0,0,0,fx,eDialogue: 0,0:00:29.91,0:00:35.35,Lyrics,,0,0,0,fx,,Dialogue: 0,0:00:29.91,0:00:35.35,Lyrics,,0,0,0,fx,Dialogue: 0,0:00:29.91,0:00:35.35,Lyrics,,0,0,0,fx,gDialogue: 0,0:00:29.91,0