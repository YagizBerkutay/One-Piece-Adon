,0,100,100,3,0,1,2.95,0,8,23,23,23,1Style: Lyrics-furigana,Duality,36,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,2.95,0,2,23,23,34,1Style: Lyrics,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,2,23,23,34,1Style: Karaoke,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,23,1Style: Kanji,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,146,1Style: Roger-Monologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1Style: Romaji ED,Josefin Sans,82,&H00FFFFFF,&H003592BE,&H00000000,&H64000000,0,0,0,0,100,100,0,0,1,0,4,8,10,10,20,1Style: Translation ED,Josefin Sans,82,&H00FFFFFF,&H000000FF,&H00FFFFFF,&H64000000,0,0,0,0,100,100,0,0,1,0,4,2,10,10,20,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 50,0:00:00.00,0:00:09.99,Narrator-207-,,0,0,0,,Your media player does not support the subtitle format used in this episode. Subtitles will likely not function properly. Please use one of the recommended video players, preferably mpv: https://mpv.ioDialogue: 50,0:01:50.17,0:02:00.17,Narrator-207-,,0,0,0,,Your media player does not support the subtitle format used in this episode. Subtitles will likely not function properly. Please use one of the recommended video players, preferably mpv: https://mpv.ioDialogue: 50,0:02:02.31,0:02:04.08,Main-207-,,0,0,0,,Müthiş...Dialogue: 50,0:02:13.11,0:02:14.61,Main-207-,,0,0,0,,Tamam!Dialogue: 50,0:02:17.03,0:02:19.41,Main-207-,,0,0,0,,Aman, yine mi...Dialogue: 50,0:02:19.41,0:02:20.62,Main-207-,,0,0,0,,Vurucu dışarı!Dialogue: 50,0:02:20.62,0:02:22.25,Main-207-,,0,0,0,,Ne yapıyorsun?Dialogue: 50,0:02:22.25,0:02:23.64,Main-207-,,0,0,0,,Beceriksiz!Dialogue: 50,0:02:30.88,0:02:32.63,Main-207-,,0,0,0,,Gerçekten ağır...Dialogue: 50,0:02:32.63,0:02:36.34,Main-207-,,0,0,0,,O zaman içkiyle dolu olmalı!Dialogue: 50,0:02:47.31,0:02:49.07,Main-207-,,0,0,0,,Sancak tarafında tehlike!Dialogue: 50,0:02:49.40,0:02:51.73,Main-207-,,0,0,0,,Direğin tepesinde korsan bayrağı asılı!Dialogue: 50,0:02:51.73,0:02:55.61,Main-207-,,0,0,0,,Korsan gemisi! Düşman saldırısı! Düşman saldırısı!Dialogue: 50,0:03:19.39,0:03:20.89,Main-207-,,0,0,0,,Koby!Dialogue: 50,0:03:21.14,0:03:22.35,Main-207-,,0,0,0,,E-evet, madam?!Dialogue: 50,0:03:22.35,0:03:25.89,Main-207-,,0,0,0,,Bu okyanustaki en güzel kadın kim?Dialogue: 50,0:03:25.89,0:03:30.61,Main-207-,,0,0,0,,Tabii ki bu geminin kaptanı, Alvida-sama.Dialogue: 50,0:03:36.65,0:03:37.82,Main-207-,,0,0,0,,İyi dedin!Dialogue: 50,0:03:37.82,0:03:39.82,Main-207-,,0,0,0,,Ç-Çok teşekkür ederim!Dialogue: 50,0:03:39.82,0:03:42.45,Main-207-,,0,0,0,,Alvida-sama, uzun zaman oldu değil mi?Dialogue: 50,0:03:42.45,0:03:43.54,Main-207-,,0,0,0,,Doğru!Dialogue: 50,0:03:44.04,0:03:46.66,Main-207-,,0,0,0,,Şimdi gemiyi bordaya alın!Dialogue: 50,0:03:46.66,0:03:48.89,Main-207-,,0,0,0,,– Emredersiniz! – Emredersiniz!Dialogue: 50,0:04:12.02,0:04:17.32,Main-207-,,0,0,0,,Adamlarım! Onlara demir topuzlu dişi korsan Alvida'nın gücünü gösterin!Dialogue: 50,0:04:27.66,0:04:29.92,Main-207-,,0,0,0,,Koby! Sen ne yapıyorsun?Dialogue: 50,0:04:29.92,0:04:32.29,Main-207-,,0,0,0,,B-Ben bu tür şeylerde pek iyi değilim.Dialogue: 50,0:04:32.29,0:04:33.54,Main-207-,,0,0,0,,Ne...?!Dialogue: 50,0:04:33.54,0:04:36.21,Main-207-,,0,0,0,,Bana karşı konuşmaya mı cüret ediyorsun?Dialogue: 50,0:04:37.05,0:04:39.97,Main-207-,,0,0,0,,Lütfen, demir topuz harici bir şey olsun!Dialogue: 50,0:04:40.93,0:04:43.60,Main-207-,,0,0,0,,Öyleyse çabuk ol ve işe koyul!Dialogue: 50,0:05:04.45,0:05:09.62,Main-207-,,0,0,0,,Sizi öldürmeyeceğiz, ama değerli olan her şeyinizi alacağız.Dialogue: 50,0:05:09.62,0:05:14.42,Main-207-,,0,0,0,,Direniş gösteren herkes okyanusa atılacak!Dialogue: 50,0:05:14.84,0:05:17.21,Main-207-,,0,0,0,,Merhaba...?Dialogue: 50,0:05:18.84,0:05:22.05,Main-207-,,0,0,0,,Burada kimse yok, değil mi...?Dialogue: 50,0:05:22.68,0:05:24.80,Main-207-,,0,0,0,,Tanrı'ya şükür... Hm?Dialogue: 50,0:05:26.89,0:05:29.93,Main-207-,,0,0,0,,Bu oldukça büyük bir fıçı.Dialogue: 50,0:05:36.32,0:05:37.94,Main-207-,,0,0,0,,Hey, korkak!Dialogue: 50,0:05:37.94,0:05:40.61,Main-207-,,0,0,0,,Yine saklanıp hiçbir şey yapmadan duruyor musun?Dialogue: 50,0:05:40.61,0:05:44.82,Main-207-,,0,0,0,,Hiç de değil! Bu şarap fıçısını ittiriyordum...Dialogue: 50,0:05:45.95,0:05:47.95,Main-207-,,0,0,0,,Yükünü hafifletmemize izin ver!Dialogue: 50,0:05:47.95,0:05:49.45,Main-207-,,0,0,0,,Çok susadık.Dialogue: 50,0:05:49.45,0:05:52.92,Main-207-,,0,0,0,,Olamaz! Eğer Alvida-sama bunu öğrenirse, öldürülürsünüz.Dialogue: 50,0:05:52.92,0:05:55.67,Main-207-,,0,0,0,,Eğer çeneni kapalı tutarsan bir şey olmaz.Dialogue: 50,0:05:55.67,0:05:57.42,Main-207-,,0,0,0,,Değil mi, Koby?Dialogue: 50,0:05:57.42,0:06:00.88,Main-207-,,0,0,0,,E-Evet! Kesinlikle!Dialogue: 50,0:06:00.88,0:06:02.17,Main-207-,,0,0,0,,Oldukça ağır...Dialogue: 50,0:06:02.17,0:06:03.34,Main-207-,,0,0,0,,Sabırsızlanıyorum!Dialogue: 50,0:06:03.34,0:06:05.47,Main-207-,,0,0,0,,Hemen açacağım!Dialogue: 50,0:06:15.06,0:06:22.65,Main-207-,,0,0,0,,NE HARİKA BİR ŞEKERLEMEEEEEEE!Dialogue: 50,0:06:25.95,0:06:26.74,Main-207-,,0,0,0,,Ne?Dialogue: 50,0:06:30.87,0:06:31.70,Main-207-,,0,0,0,,Siz de kimsiniz?Dialogue: 50,0:06:31.70,0:06:33.62,Main-207-,,0,0,0,,– Asıl sen kimsin lan?! – Asıl sen kimsin lan?!Dialogue: 50,0:06:33.62,0:06:35.63,Main-207-,,0,0,0,,Eğer burda uyursa üşütecek.Dialogue: 50,0:06:35.63,0:06:37.46,Main-207-,,0,0,0,,– Bu senin hatan! – Bu senin hatan!Dialogue: 50,0:06:39.13,0:06:40.23,Main-207-,,0,0,0,,Pislik...!Dialogue: 50,0:06:40.25,0:06:43.97,Main-207-,,0,0,0,,Sen kim olduğunu sanıyorsun da korsanlarla uğraşıyorsun, ha?!Dialogue: 50,0:06:44.26,0:06:47.93,Main-207-,,0,0,0,,Acıktım! Yiyecek bir şeyin var mı?Dialogue: 50,0:06:45.89,0:06:47.93,Secondary-207-,,0,0,0,,Bizi görmezden gelme!Dialogue: 50,0:06:48.30,0:06:50.43,Main-207-,,0,0,0,,Seni lanet velet!Dialogue: 50,0:06:52.68,0:06:54.06,Main-207-,,0,0,0,,Geber!Dialogue: 50,0:07:10.41,0:07:12.50,Main-207-,,0,0,0,,Böyle aniden ne yapıyorsunuz?Dialogue: 50,0:07:12.83,0:07:14.71,Main-207-,,0,0,0,,K... Kimsin sen?Dialogue: 50,0:07:14.71,0:07:15.46,Main-207-,,0,0,0,,Ben mi?Dialogue: 50,0:07:16.00,0:07:19.71,Main-207-,,0,0,0,,Ben, Monkey D. Luffy. Memnun oldum!Dialogue: 50,0:07:27.39,0:07:29.64,Main-207-,,0,0,0,,Demin... demin ne oldu öyle?Dialogue: 50,0:07:29.64,0:07:31.39,Main-207-,,0,0,0,,Onların sorunu ne?Dialogue: 50,0:07:31.39,0:07:33.02,Main-207-,,0,0,0,,Çabuk! Hemen kaç!Dialogue: 50,0:07:33.02,0:07:36.02,Main-207-,,0,0,0,,Arkadaşlarıyla birlikte geri geldikleri zaman, seni öldürecekler!Dialogue: 50,0:07:36.02,0:07:38.02,Main-207-,,0,0,0,,Öyle bile olsa, çok açım!Dialogue: 50,0:07:38.02,0:07:41.02,Main-207-,,0,0,0,,Nasıl bu kadar pervasız olabiliyorsun?!Dialogue: 50,0:07:41.02,0:07:44.61,Main-207-,,0,0,0,,Güvertede bir sürü korsan var!Dialogue: 50,0:07:44.61,0:07:47.36,Main-207-,,0,0,0,,O tarafa gitme.Dialogue: 50,0:07:47.36,0:07:48.82,Main-207-,,0,0,0,,D-D-Dur!Dialogue: 50,0:07:48.82,0:07:51.78,Main-207-,,0,0,0,,Yanlış yöne gidiyorsun!Dialogue: 50,0:07:56.96,0:08:00.33,Main-207-,,0,0,0,,Yiyecek! Yiyecek! Yiyecek! Yaşasın!Dialogue: 50,0:08:00.33,0:08:04.67,Main-207-,,0,0,0,,Aslında bizi burada bulamayabilirler!Dialogue: 50,0:08:05.21,0:08:08.63,Main-207-,,0,0,0,,Hangisini alsam acaba? Bu kutuyu mu? Oh, bingo.Dialogue: 50,0:08:08.63,0:08:10.39,Main-207-,,0,0,0,,Çok lezzetli görünüyorlar!Dialogue: 50,0:08:10.39,0:08:13.01,Main-207-,,0,0,0,,B-Benim adım Koby.Dialogue: 50,0:08:13.01,0:08:14.77,Main-207-,,0,0,0,,Sen Luffy-san'sın, değil mi?Dialogue: 50,0:08:14.77,0:08:17.64,Main-207-,,0,0,0,,Az önce inanılmazdın! Bunu nasıl yaptın?!Dialogue: 50,0:08:18.39,0:08:19.60,Main-207-,,0,0,0,,Bunlar harika!Dialogue: 50,0:08:21.23,0:08:22.98,Main-207-,,0,0,0,,Bu gemi, korsan gemisi mi?Dialogue: 50,0:08:22.98,0:08:29.95,Main-207-,,0,0,0,,Hayır, bu gemi, Alvida-sama tarafından yağmalanan bir yolcu gemisi.Dialogue: 50,0:08:29.95,0:08:31.74,Main-207-,,0,0,0,,Benim için farketmez.Dialogue: 50,0:08:31.74,0:08:33.95,Main-207-,,0,0,0,,Bu gemide hiç sandal var mı?Dialogue: 50,0:08:33.95,0:08:36.50,Main-207-,,0,0,0,,Olabilir, ama...Dialogue: 50,0:08:36.50,0:08:38.96,Main-207-,,0,0,0,,Benim gemim girdaba yakalandı.Dialogue: 50,0:08:38.96,0:08:42.59,Main-207-,,0,0,0,,Eh, o girdaba mı? Ölmüş olmalıydın.Dialogue: 50,0:08:42.59,0:08:46.05,Main-207-,,0,0,0,,Evet, beni gerçekten endişelendirdi.Dialogue: 50,0:08:47.42,0:08:50.43,Main-207-,,0,0,0,,Sen de onlar gibi korsan mısın?Dialogue: 50,0:08:49.68,0:08:50.43,Secondary-207-,,0,0,0,,Hm?Dialogue: 50,0:08:53.89,0:08:56.97,Main-207-,,0,0,0,,O gün... vahim bir gündü.Dialogue: 50,0:08:57.48,0:09:02.94,Main-207-,,0,0,0,,O gün, balığa çıkmak niyetiyle sandala binmiştim...Dialogue: 50,0:09:08.32,0:09:14.74,Main-207-,,0,0,0,,Ama o sandal korsan gemisine doğru gidiyordu!Dialogue: 50,0:09:14.74,0:09:16.62,Main-207-,,0,0,0,,Geçtiğimiz 2 yıldan beri,...Dialogue: 50,0:09:16.62,0:09:20.54,Main-207-,,0,0,0,,...beni öldürmemeleri için köle gibi çalışıyorum.Dialogue: 50,0:09:21.08,0:09:23.21,Main-207-,,0,0,0,,Gerçekten aptalsın!Dialogue: 50,0:09:23.21,0:09:25.25,Main-207-,,0,0,0,,Son derece dürüstsün.Dialogue: 50,0:09:25.25,0:09:26.50,Main-207-,,0,0,0,,Kaçabilirsin!Dialogue: 50,0:09:26.50,0:09:29.30,Main-207-,,0,0,0,,Y-Yapamam! İmkansız, imkansız!Dialogue: 50,0:09:29.30,0:09:33.05,Main-207-,,0,0,0,,Alvida-sama'nın beni bulması düşüncesi bile dizlerimi titretiyor.Dialogue: 50,0:09:33.30,0:09:35.93,Main-207-,,0,0,0,,Ne, sen şu korkak olanlardan mısın?Dialogue: 50,0:09:35.93,0:09:38.81,Main-207-,,0,0,0,,Senden hoşlanmadım.Dialogue: 50,0:09:40.52,0:09:43.15,Main-207-,,0,0,0,,Hey, gevşemeyi bırakın da acele edin.Dialogue: 50,0:09:43.15,0:09:46.02,Main-207-,,0,0,0,,Denizciler buraya gelmeden her şeyi taşıyın!Dialogue: 50,0:09:46.98,0:09:50.95,Main-207-,,0,0,0,,Her kim işi gevşek tutarsa, demir topuzumun tadına bakar!Dialogue: 50,0:09:49.69,0:09:50.95,Secondary-207-,,0,0,0,,Ne ganimet ama!Dialogue: 50,0:09:56.87,0:09:58.08,Main-207-,,0,0,0,,– Alvida-sama! – Alvida-sama!Dialogue: 50,0:09:59.37,0:10:00.04,Main-207-,,0,0,0,,– Sorun var! – Sorun var!Dialogue: 50,0:10:00.41,0:10:02.21,Main-207-,,0,0,0,,Ne oldu? Çok gürültü yapıyorsunuz.Dialogue: 50,0:10:02.21,0:10:03.62,Main-207-,,0,0,0,,F-f-fıçı!Dialogue: 50,0:10:03.62,0:10:05.42,Main-207-,,0,0,0,,Y-Yaratık!Dialogue: 50,0:10:05.42,0:10:06.46,Main-207-,,0,0,0,,Ha?!Dialogue: 50,0:10:08.30,0:10:10.42,Main-207-,,0,0,0,,Kimmiş yaratık?Dialogue: 50,0:10:17.93,0:10:19.68,Main-207-,,0,0,0,,Yanlış anladınız...Dialogue: 50,0:10:19.68,0:10:22.64,Main-207-,,0,0,0,,Fıçıdan garip bir adam çıktı...Dialogue: 50,0:10:22.64,0:10:26.31,Main-207-,,0,0,0,,Ödül avcısı olabilir.Dialogue: 50,0:10:26.31,0:10:27.94,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:10:28.98,0:10:30.32,Main-207-,,0,0,0,,Evet.Dialogue: 50,0:10:30.57,0:10:31.82,Main-207-,,0,0,0,,Haklısın.Dialogue: 50,0:10:31.82,0:10:36.32,Main-207-,,0,0,0,,Keşke bir varilin içinde denizlerde savrulacak kadar cesaretim olsaydı,...Dialogue: 50,0:10:36.32,0:10:40.33,Main-207-,,0,0,0,,...o zaman gerçekten istediğim şeyi başarmış olurdum.Dialogue: 50,0:10:40.33,0:10:44.58,Main-207-,,0,0,0,,Şey... Seni denize açılmaya ne itti, Luffy-san?Dialogue: 50,0:10:44.58,0:10:45.29,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:10:45.79,0:10:48.09,Main-207-,,0,0,0,,Ben, Korsanlar Kralı olacağım!Dialogue: 50,0:10:50.21,0:10:52.34,Main-207-,,0,0,0,,Ko-Ko-Korsanlar Kralı mı?!Dialogue: 50,0:10:52.34,0:10:52.76,Main-207-,,0,0,0,,Aynen.Dialogue: 50,0:10:52.76,0:10:53.84,Main-207-,,0,0,0,,Ciddi misin?!Dialogue: 50,0:10:53.84,0:10:54.47,Main-207-,,0,0,0,,Ciddiyim.Dialogue: 50,0:10:54.47,0:10:57.26,Main-207-,,0,0,0,,Yani Luffy-san, sende mi korsansın?Dialogue: 50,0:10:57.26,0:10:58.22,Main-207-,,0,0,0,,Tabii.Dialogue: 50,0:10:58.22,0:10:59.10,Main-207-,,0,0,0,,Peki tayfan...?Dialogue: 50,0:10:59.10,0:11:01.27,Main-207-,,0,0,0,,Hiç yok, ama şu anda bulmaya çalışıyorum.Dialogue: 50,0:11:05.85,0:11:11.98,Main-207-,,0,0,0,,K-K-Korsanlar Kralı, bu dünyanın sunduğu her şeyi elde eden kişidir!Dialogue: 50,0:11:11.98,0:11:15.91,Main-207-,,0,0,0,,Bu, en büyük zenginliği, şöhreti ve gücü aramak anlamına gelir.Dialogue: 50,0:11:15.91,0:11:18.57,Main-207-,,0,0,0,,One Piece'in peşinden gittiğini söyleme bana.Dialogue: 50,0:11:18.57,0:11:19.07,Main-207-,,0,0,0,,Aynen!Dialogue: 50,0:11:19.07,0:11:23.54,Main-207-,,0,0,0,,"Aynen mi"?! Dünyadaki bütün korsanlar o hazinenin peşinden gidiyor!Dialogue: 50,0:11:23.54,0:11:24.58,Main-207-,,0,0,0,,Ben de gidiyorum!Dialogue: 50,0:11:24.58,0:11:28.42,Main-207-,,0,0,0,,İmkansız, imkansız, imkansız, imkansız, kesinlikle imkansız!Dialogue: 50,0:11:28.42,0:11:32.09,Main-207-,,0,0,0,,Bu Büyük Korsan Çağı'nın zirvesine çıkman imkansız!Dialogue: 50,0:11:32.09,0:11:33.17,Main-207-,,0,0,0,,İmkansız! İmkansız!Dialogue: 50,0:11:35.51,0:11:37.64,Main-207-,,0,0,0,,Bana niye vurdun?Dialogue: 50,0:11:37.64,0:11:39.01,Main-207-,,0,0,0,,İçimden geldi.Dialogue: 50,0:11:39.76,0:11:42.64,Main-207-,,0,0,0,,Sorun değil, nasıl olsa buna alıştım.Dialogue: 50,0:11:46.23,0:11:48.10,Main-207-,,0,0,0,,İmkansız olup olmaması önemli değil.Dialogue: 50,0:11:48.10,0:11:48.73,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:11:48.73,0:11:50.40,Main-207-,,0,0,0,,Bunu istediğim için yapıyorum.Dialogue: 50,0:11:53.23,0:11:56.74,Main-207-,,0,0,0,,Ben, Korsanlar Kralı olmaya karar verdim.Dialogue: 50,0:11:56.74,0:11:59.95,Main-207-,,0,0,0,,Bu yolda ölsem bile farketmez.Dialogue: 50,0:12:02.95,0:12:07.16,Main-207-,,0,0,0,,Artık doyduğuma göre, gidip bir sandal alabilirim.Dialogue: 50,0:12:07.16,0:12:08.87,Main-207-,,0,0,0,,Acaba bana bir tane verirler mi?Dialogue: 50,0:12:08.87,0:12:11.13,Main-207-,,0,0,0,,Umarım cömert olurlar.Dialogue: 50,0:12:12.04,0:12:14.67,Main-207-,,0,0,0,,Bunu hiç düşünmemiştim.Dialogue: 50,0:12:16.05,0:12:18.26,Main-207-,,0,0,0,,Bunu ben de yapabilir miyim?Dialogue: 50,0:12:19.18,0:12:20.89,Main-207-,,0,0,0,,Ölmekten korkmadan.Dialogue: 50,0:12:20.89,0:12:21.72,Main-207-,,0,0,0,,Neyi?Dialogue: 50,0:12:22.39,0:12:23.51,Main-207-,,0,0,0,,Sence...Dialogue: 50,0:12:24.01,0:12:26.14,Main-207-,,0,0,0,,...donanmaya katılabilir miyim?Dialogue: 50,0:12:27.10,0:12:27.94,Main-207-,,0,0,0,,Donanma mı?!Dialogue: 50,0:12:27.94,0:12:31.73,Main-207-,,0,0,0,,Evet! Kötü adamları yakalamak benim hayalim!Dialogue: 50,0:12:31.98,0:12:34.19,Main-207-,,0,0,0,,Çocukluğumdan beri hayalimdi!Dialogue: 50,0:12:34.19,0:12:35.94,Main-207-,,0,0,0,,Bunu yapabilir miyim?Dialogue: 50,0:12:35.94,0:12:37.07,Main-207-,,0,0,0,,Ben nereden bileyim?Dialogue: 50,0:12:37.07,0:12:38.57,Main-207-,,0,0,0,,Hayır, bunu yapacağım!Dialogue: 50,0:12:38.57,0:12:42.83,Main-207-,,0,0,0,,Ya hayatım boyunca miço olarak kalırım ya da Alvida-sama'yı...Dialogue: 50,0:12:42.83,0:12:45.20,Main-207-,,0,0,0,,Hayır, Alvida'yı yakalayıp özgür olurum!Dialogue: 50,0:12:52.04,0:12:54.71,Main-207-,,0,0,0,,Böyle arkadaş edinerek...Dialogue: 50,0:12:54.71,0:12:57.17,Main-207-,,0,0,0,,...kimi yakalayacaksın?Dialogue: 50,0:12:57.17,0:12:59.93,Main-207-,,0,0,0,,Ha, Koby?!Dialogue: 50,0:13:13.90,0:13:16.40,Main-207-,,0,0,0,,Korsan Avcısı Zoro'ya hiç benzemiyorsun.Dialogue: 50,0:13:17.40,0:13:18.19,Main-207-,,0,0,0,,Zoro mu?Dialogue: 50,0:13:18.19,0:13:19.86,Main-207-,,0,0,0,,Koby!Dialogue: 50,0:13:20.11,0:13:24.12,Main-207-,,0,0,0,,Bu okyanusta en güzel kadın kim?!Dialogue: 50,0:13:25.33,0:13:27.29,Main-207-,,0,0,0,,E-Elbette siz–Dialogue: 50,0:13:27.91,0:13:29.75,Main-207-,,0,0,0,,Bu şişman kadın kim?Dialogue: 50,0:13:36.21,0:13:37.05,Main-207-,,0,0,0,,"Şişman" mı?Dialogue: 50,0:13:37.05,0:13:38.17,Main-207-,,0,0,0,,Sıçtı...Dialogue: 50,0:13:40.97,0:13:44.14,Main-207-,,0,0,0,,Seni bücür!Dialogue: 50,0:13:47.10,0:13:48.06,Main-207-,,0,0,0,,Gidelim!Dialogue: 50,0:13:56.57,0:13:57.69,Main-207-,,0,0,0,,Seni...!Dialogue: 50,0:14:18.38,0:14:21.80,Main-207-,,0,0,0,,Arkadan saldırmak hiç adil değil!Dialogue: 50,0:14:28.93,0:14:32.98,Main-207-,,0,0,0,,Çok fazla kişiyle saldırmak da adil değil!Dialogue: 50,0:14:42.28,0:14:43.28,Main-207-,,0,0,0,,Kandırdım!Dialogue: 50,0:14:45.16,0:14:50.41,Main-207-,,0,0,0,,Lastik-Lastik...Dialogue: 50,0:14:51.75,0:14:55.25,Main-207-,,0,0,0,,Roket!Dialogue: 50,0:14:56.17,0:14:57.75,Main-207-,,0,0,0,,Nee?!Dialogue: 50,0:15:03.05,0:15:06.26,Main-207-,,0,0,0,,Luffy-san, nesin sen?Dialogue: 50,0:15:06.26,0:15:06.72,Main-207-,,0,0,0,,Ben mi?Dialogue: 50,0:15:07.51,0:15:09.18,Main-207-,,0,0,0,,Ben lastik adamım.Dialogue: 50,0:15:09.81,0:15:13.68,Main-207-,,0,0,0,,Lastik adam mı? Ciddi olamazsın!Dialogue: 50,0:15:16.77,0:15:19.44,Main-207-,,0,0,0,,Şeytan meyvesini yedin, değil mi?Dialogue: 50,0:15:20.19,0:15:22.28,Main-207-,,0,0,0,,Evet! Lastik-Lastik meyvesini yedim.Dialogue: 50,0:15:22.53,0:15:24.28,Main-207-,,0,0,0,,Anlıyorum!Dialogue: 50,0:15:24.28,0:15:29.49,Main-207-,,0,0,0,,Söylentiler duymuştum ama sanırım gerçekten varlarmış!Dialogue: 50,0:15:29.83,0:15:32.04,Main-207-,,0,0,0,,Sen de fena değilsin.Dialogue: 50,0:15:32.04,0:15:33.41,Main-207-,,0,0,0,,Ödül avcısı mısın?Dialogue: 50,0:15:33.79,0:15:34.96,Main-207-,,0,0,0,,Hayır, korsanım!Dialogue: 50,0:15:34.96,0:15:36.71,Main-207-,,0,0,0,,Korsan mı?! Ha!Dialogue: 50,0:15:36.71,0:15:37.79,Main-207-,,0,0,0,,Tek başına mı?!Dialogue: 50,0:15:37.79,0:15:41.63,Main-207-,,0,0,0,,Şu an sadece ben varım ama bir tayfa kuracağım!Dialogue: 50,0:15:41.63,0:15:44.47,Main-207-,,0,0,0,,Şöyle bi'... on kişi iyi olur gibi!Dialogue: 50,0:15:44.47,0:15:48.43,Main-207-,,0,0,0,,Bu bizi düşman yapıyor, değil mi?Dialogue: 50,0:15:48.43,0:15:50.80,Main-207-,,0,0,0,,Lu... Luffy-san, kaç.Dialogue: 50,0:15:50.80,0:15:51.31,Main-207-,,0,0,0,,Neden?Dialogue: 50,0:15:51.31,0:15:53.47,Main-207-,,0,0,0,,O demir topuzun gücünü gördün.Dialogue: 50,0:15:53.85,0:15:56.69,Main-207-,,0,0,0,,Bu kadın bir numaralı...Dialogue: 50,0:15:59.15,0:16:02.90,Flashbacks-207-,,0,0,0,,Ben, Korsanlar Kralı olmaya karar verdim.Dialogue: 50,0:16:02.90,0:16:06.07,Flashbacks-207-,,0,0,0,,Bu yolda ölsem bile farketmez.Dialogue: 50,0:16:09.36,0:16:11.87,Main-207-,,0,0,0,,Bir numaralı ne?Dialogue: 50,0:16:11.87,0:16:14.62,Main-207-,,0,0,0,,Bir... bir... bir...Dialogue: 50,0:16:15.50,0:16:21.29,Main-207-,,0,0,0,,Bir numaralı kokuşmuş, çirkin ve yaşlı bir kocakarıdır!Dialogue: 50,0:16:32.85,0:16:35.14,Main-207-,,0,0,0,,N-Ne dedin sen?!Dialogue: 50,0:16:35.77,0:16:38.14,Main-207-,,0,0,0,,B-Ben donanmaya katılacağım!Dialogue: 50,0:16:38.14,0:16:41.15,Main-207-,,0,0,0,,Katılıp senin gibi korsanlarla dövüşeceğim!Dialogue: 50,0:16:41.15,0:16:43.52,Main-207-,,0,0,0,,Sen ne dediğinin farkında mısın?!Dialogue: 50,0:16:43.52,0:16:47.15,Main-207-,,0,0,0,,Farkındayım! Ben istediğim şeyi yapacağım!Dialogue: 50,0:16:47.15,0:16:49.15,Main-207-,,0,0,0,,Ben... Ben bir denizci olduğumda...Dialogue: 50,0:16:49.15,0:16:51.82,Main-207-,,0,0,0,,Seni sonsuza kadar hapse tıkacağım!Dialogue: 50,0:16:51.82,0:16:54.87,Main-207-,,0,0,0,,Seni lanet tıfıl!Dialogue: 50,0:16:54.87,0:16:59.37,Thoughts-207-,,0,0,0,,Pişmanlık yok! Pişmanlık yok! Söyledim! Hayalim için savaştım!Dialogue: 50,0:16:59.37,0:17:00.46,Main-207-,,0,0,0,,İyi dedin!Dialogue: 50,0:17:13.01,0:17:14.35,Main-207-,,0,0,0,,İşe yaramaz!Dialogue: 50,0:17:14.35,0:17:15.47,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:17:15.47,0:17:17.10,Main-207-,,0,0,0,,Çünkü ben lastiğim.Dialogue: 50,0:17:19.48,0:17:23.73,Main-207-,,0,0,0,,Lastik-Lastik...Dialogue: 50,0:17:24.73,0:17:30.15,Main-207-,,0,0,0,,Tabanca!Dialogue: 50,0:17:48.26,0:17:51.17,Main-207-,,0,0,0,,Gökyüzü masmavi...Dialogue: 50,0:18:02.85,0:18:03.52,Main-207-,,0,0,0,,Hey!Dialogue: 50,0:18:03.52,0:18:04.40,Main-207-,,0,0,0,,– Evet?! – Evet?!Dialogue: 50,0:18:04.40,0:18:07.11,Main-207-,,0,0,0,,Koby'ye sandal verin.Dialogue: 50,0:18:07.11,0:18:09.23,Main-207-,,0,0,0,,Donanmaya katılacak.Dialogue: 50,0:18:09.23,0:18:10.69,Main-207-,,0,0,0,,Bırakın gitsin.Dialogue: 50,0:18:11.45,0:18:13.16,Main-207-,,0,0,0,,– T-Tabii! – T-Tabii!Dialogue: 50,0:18:14.87,0:18:16.20,Main-207-,,0,0,0,,Luffy-san...!Dialogue: 50,0:18:23.21,0:18:25.33,Main-207-,,0,0,0,,Bunlar... Denizciler!Dialogue: 50,0:18:25.33,0:18:26.34,Main-207-,,0,0,0,,Oh!Dialogue: 50,0:18:26.59,0:18:29.38,Main-207-,,0,0,0,,Harika zamanlama!  Onları görmelisin!Dialogue: 50,0:18:29.38,0:18:29.96,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:18:29.96,0:18:31.34,Main-207-,,0,0,0,,Ben korsanım, kaçma zamanı!Dialogue: 50,0:18:31.34,0:18:32.34,Main-207-,,0,0,0,,Ciddi misin?!Dialogue: 50,0:18:32.34,0:18:36.05,Main-207-,,0,0,0,,Donanmaya böyle katılamam. Giremeden beni tutuklarlar!Dialogue: 50,0:18:48.73,0:18:50.94,Main-207-,,0,0,0,,Neyse ki kaçabildik, ha?Dialogue: 50,0:18:50.94,0:18:53.28,Main-207-,,0,0,0,,Uf, çok eğlenceliydi!Dialogue: 50,0:18:54.28,0:18:55.66,Main-207-,,0,0,0,,Şey, Luffy-san.Dialogue: 50,0:18:55.66,0:18:56.41,Main-207-,,0,0,0,,Evet?Dialogue: 50,0:18:56.41,0:19:01.20,Main-207-,,0,0,0,,Eğer One Piece'i arıyorsan, o zaman Grand Line'a gidiyorsun, değil mi?Dialogue: 50,0:19:01.20,0:19:01.79,Main-207-,,0,0,0,,Aynen.Dialogue: 50,0:19:01.79,0:19:04.92,Main-207-,,0,0,0,,O yer aynı zamanda Korsan Mezarlığı olarak da bilinir.Dialogue: 50,0:19:04.92,0:19:07.79,Main-207-,,0,0,0,,Evet, işte bu yüzden güçlü bir tayfaya ihtiyacım var.Dialogue: 50,0:19:08.25,0:19:10.50,Main-207-,,0,0,0,,Şu korsan avcısı...Dialogue: 50,0:19:10.50,0:19:11.59,Main-207-,,0,0,0,,O nasıl biri?Dialogue: 50,0:19:12.17,0:19:13.67,Main-207-,,0,0,0,,Zoro'yu mu kastediyorsun?Dialogue: 50,0:19:13.67,0:19:17.34,Main-207-,,0,0,0,,Donanma tarafından yakalandığını duydum.Dialogue: 50,0:19:17.34,0:19:19.26,Main-207-,,0,0,0,,Ne? O güçsüz biri mi?Dialogue: 50,0:19:19.26,0:19:20.60,Main-207-,,0,0,0,,Hiç de değil!Dialogue: 50,0:19:20.60,0:19:24.39,Main-207-,,0,0,0,,O dehşet verici bir şeytan!Dialogue: 50,0:19:25.35,0:19:27.69,Main-207-,,0,0,0,,Niye bana bunu soruyorsun?Dialogue: 50,0:19:28.69,0:19:31.65,Main-207-,,0,0,0,,Eğer iyi biriyse, tayfama alabilirim!Dialogue: 50,0:19:32.98,0:19:35.11,Main-207-,,0,0,0,,Yine pervasızca bir şey yapacaksın.Dialogue: 50,0:19:35.11,0:19:36.86,Main-207-,,0,0,0,,İyi bir adam olabilir!Dialogue: 50,0:19:36.86,0:19:39.12,Main-207-,,0,0,0,,O kötü bir adam olduğu için yakalandı!Dialogue: 50,0:19:39.12,0:19:42.08,Main-207-,,0,0,0,,Hayır! İmkansız, imkansız, imkansız, Kesinlikle imkan–Dialogue: 50,0:19:43.12,0:19:45.37,Main-207-,,0,0,0,,Bana niye vurdun?Dialogue: 50,0:19:45.37,0:19:46.58,Main-207-,,0,0,0,,İçimden geldi.Dialogue: 0,0:01:50.21,0:01:57.47,Title-207-,,0,0,0,,Ona "Hasır Şapkalı" Luffy diyorlarDialogue: 1,0:01:50.21,0:01:57.47,Title-207-,,0,0,0,,Ona "Hasır Şapkalı" Luffy diyorlarDialogue: 0,0:03:20.93,0:03:25.64,Captions-207-,,0,0,0,,"Kamarot" KobyDialogue: 2,0:03:20.93,0:03:25.64,Captions-207-,,0,0,0,,"Kamarot" KobyDialogue: 0,0:03:35.57,0:03:39.78,Captions-207-,,0,0,0,,"Demir Topuz" Alvida Kadın KorsanDialogue: 2,0:03:35.57,0:03:39.78,Captions-207-,,0,0,0,,"Demir Topuz" Alvida Kadın KorsanDialogue: 50,0:00:11.82,0:00:11.82,Main-207-,,0,0,0,,Dialogue: 0,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 1,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 0,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Feeso Galaxy 9000Dialogue: 1,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Feeso Galaxy 9000Dialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,MüzikDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,MüzikDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,HaleeDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,HaleeDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,GrafikDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,GrafikDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,DatenshiDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,DatenshiDialogue: 0,0:00:06.78,0:00:10.28,Credits-207-,,0,0,0,,Kalite KontrolDialogue: 1,0:00:06.78,0:00:10.28,Credits-207-,,0,0,0,,Kalite KontrolDialogue: 0,0:00:06.78,0:00:10.28,Credits-207-,,0,0,0,,Gab Gol D. Rocks Pepperjack TheFVGuy Westfal Villager ZenefDialogue: 1,0:00:06.78