eDialogue: 0,0:23:30.88,0:23:32.42,Romaji ED,,0,0,0,,tteDialogue: 0,0:23:27.22,0:23:30.88,Romaji ED,,0,0,0,,yuDialogue: 1,0:23:30.88,0:23:31.23,Romaji ED,,0,0,0,,yuDialogue: 0,0:23:31.23,0:23:32.42,Romaji ED,,0,0,0,,yuDialogue: 0,0:23:27.22,0:23:31.23,Romaji ED,,0,0,0,,keDialogue: 1,0:23:31.23,0:23:31.39,Romaji ED,,0,0,0,,keDialogue: 0,0:23:31.39,0:23:32.42,Romaji ED,,0,0,0,,keDialogue: 0,0:23:27.22,0:23:31.39,Romaji ED,,0,0,0,,ruDialogue: 1,0:23:31.39,0:23:32.27,Romaji ED,,0,0,0,,ruDialogue: 0,0:23:32.27,0:23:32.42,Romaji ED,,0,0,0,,ruDialogue: 0,0:22:26.76,0:22:31.75,Translation ED,,0,0,0,,Taşar içim, anlatamam, anlaman zor inanDialogue: 0,0:22:31.77,0:22:36.61,Translation ED,,0,0,0,,Ne olursa olsun, elini bırakmaya dayanamamDialogue: 0,0:22:36.66,0:22:41.56,Translation ED,,0,0,0,,Yine de ilerlemeliyim, tek başıma da olsamDialogue: 0,0:22:41.60,0:22:46.83,Translation ED,,0,0,0,,Söz ver, kaybolduğumda bile beni gözetlemeye devamDialogue: 0,0:22:51.48,0:22:56.36,Translation ED,,0,0,0,,Gözümü açtım, bu sıcaklık düştü aklıma bir anDialogue: 0,0:22:56.41,0:23:01.11,Translation ED,,0,0,0,,"Neden bu kadar yakıcı? Nefes alamıyorum inan!"Dialogue: 0,0:23:01.11,0:23:07.62,Translation ED,,0,0,0,,Ne zamandır böyle, bilemiyorum hâlâDialogue: 0,0:23:07.62,0:23:11.50,Translation ED,,0,0,0,,Bu düşünceler aklımdan çıkmaz aslaDialogue: 0,0:23:12.45,0:23:17.36,Translation ED,,0,0,0,,Çok isterim yakalamayı o koşucu sarhoşluğunu daDialogue: 0,0:23:17.36,0:23:22.24,Translation ED,,0,0,0,,Belki de çok koştum, kendimi kaybettim yolun sonundaDialogue: 0,0:23:22.29,0:23:27.22,Translation ED,,0,0,0,,Tek istediğim, kelimelere sığmaz bir hayal aslında Dialogue: 0,0:23:27.22,0:23:32.42,Translation ED,,0,0,0,,Yeter ki benimle ol, koşarım… ölsem bile yanında