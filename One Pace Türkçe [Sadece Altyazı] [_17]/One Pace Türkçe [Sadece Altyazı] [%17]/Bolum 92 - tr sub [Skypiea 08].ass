,23,23,23,1Style: Translation,Duality,68,&H00B95DıD,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,2.25,0,1,4.5,0,2,23,23,23,1Style: Roger Monologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:49.63,0:01:59.63,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 51,0:01:56.76,0:01:59.02,Main-207-,,0,0,0,,Teşekkürler, Tanrım!Dialogue: 50,0:02:00.27,0:02:04.90,Main-207-,,0,0,0,,Bunca badireden sonra, gökyüzü adasının Altın Şehir çıktığına inanamıyorum!Dialogue: 50,0:02:05.36,0:02:11.36,Main-207-,,0,0,0,,Bu iyi bir insan olmanın bir ödülü mü, Tanrım?Dialogue: 50,0:02:11.36,0:02:15.32,Main-207-,,0,0,0,,Hey, bu adanın tanrısından korkmuyor muydun sen?!Dialogue: 50,0:02:16.24,0:02:20.54,Main-207-,,0,0,0,,Tanrı mı? O kimin umurunda? Altından değerli mi?Dialogue: 50,0:02:21.75,0:02:25.25,Main-207-,,0,0,0,,Daha şimdi, "Teşekkürler, Tanrım" diyordun.Dialogue: 50,0:02:25.25,0:02:28.04,Main-207-,,0,0,0,,Sanırım ne dediğini kendisi de bilmiyor!Dialogue: 50,0:02:48.36,0:02:49.86,Main-207-,,0,0,0,,Çabalarınız boşuna.Dialogue: 50,0:02:58.62,0:03:00.58,Main-207-,,0,0,0,,Hey, burası da ne böyle?!Dialogue: 50,0:03:00.58,0:03:04.33,Main-207-,,0,0,0,,Bahse girerim burası bir sonraki test alanı.Dialogue: 50,0:03:04.33,0:03:07.04,Main-207-,,0,0,0,,Bir başka rahip her an belirebilir. Ayık olun!Dialogue: 50,0:03:07.04,0:03:08.29,Main-207-,,0,0,0,,Öf bee...Dialogue: 50,0:03:08.29,0:03:11.38,Main-207-,,0,0,0,,Bir test bana ziyadesiyle yetti!Dialogue: 50,0:03:12.00,0:03:13.17,Main-207-,,0,0,0,,Bu sefer ne olacak?!Dialogue: 50,0:03:13.17,0:03:14.47,Main-207-,,0,0,0,,İp mi?Dialogue: 50,0:03:14.47,0:03:15.47,Main-207-,,0,0,0,,Demir mi?Dialogue: 50,0:03:15.47,0:03:16.51,Main-207-,,0,0,0,,Bataklık mı?!Dialogue: 50,0:03:16.51,0:03:18.30,Main-207-,,0,0,0,,Sıradan bir çayıra benziyor.Dialogue: 50,0:03:18.30,0:03:21.81,Main-207-,,0,0,0,,Sıradan değil! Dikkatli bak!Dialogue: 50,0:03:21.81,0:03:25.60,Main-207-,,0,0,0,,Kazıkların ucunda kafatasları var!Dialogue: 50,0:03:25.60,0:03:27.40,Main-207-,,0,0,0,,Oh, haklısın! Nereye düştük lan?!Dialogue: 50,0:03:30.52,0:03:31.65,Main-207-,,0,0,0,,Bir şey geliyor.Dialogue: 50,0:03:34.94,0:03:37.28,Main-207-,,0,0,0,,Geliyorlar!Dialogue: 50,0:03:49.42,0:03:50.29,Main-207-,,0,0,0,,Sizi pislikler!Dialogue: 50,0:03:50.29,0:03:52.38,Main-207-,,0,0,0,,Lastik-Lastik...Dialogue: 50,0:03:53.05,0:03:54.71,Main-207-,,0,0,0,,Balon!Dialogue: 50,0:03:59.51,0:04:00.80,Main-207-,,0,0,0,,O neydi öyle?!Dialogue: 50,0:04:00.80,0:04:02.14,Main-207-,,0,0,0,,Paramecia...!Dialogue: 50,0:04:00.80,0:04:02.14,Note-207-,,0,0,0,,Paramecia: İnsanüstü TipiDialogue: 50,0:04:02.14,0:04:03.81,Main-207-,,0,0,0,,Wyper, kapışacak mıyız?!Dialogue: 50,0:04:03.81,0:04:05.22,Main-207-,,0,0,0,,Hayır, onlarla işimiz yok!Dialogue: 50,0:04:05.68,0:04:06.56,Main-207-,,0,0,0,,Bu adam...!Dialogue: 50,0:04:07.39,0:04:10.98,Main-207-,,0,0,0,,Hey, siz! Ne yapıyorsunuz be?! Adamsanız gelin lan!Dialogue: 50,0:04:10.98,0:04:12.57,Main-207-,,0,0,0,,Şerefsizler!Dialogue: 50,0:04:15.65,0:04:21.07,Main-207-,,0,0,0,,Demek Skypiea'yı karıştıran Mavi Deniz insanları sizlersiniz.Dialogue: 50,0:04:22.37,0:04:23.74,Main-207-,,0,0,0,,Hey, Luffy,Dialogue: 50,0:04:23.74,0:04:26.58,Main-207-,,0,0,0,,o adam, Beyaz Deniz'de gördüğümüz gerilla!Dialogue: 51,0:04:26.58,0:04:29.08,Flashbacks-207-,,0,0,0,,Ne oldu birden bire...? Ha?!Dialogue: 50,0:04:29.46,0:04:30.88,Flashbacks-207-,,0,0,0,,Bulutların üstünde kayıyor!Dialogue: 50,0:04:32.46,0:04:34.21,Flashbacks-207-,,0,0,0,,Hey, dur! Ne istiyorsun?!Dialogue: 50,0:04:34.21,0:04:35.17,Flashbacks-207-,,0,0,0,,Sizi öldürmeyi!Dialogue: 50,0:04:36.88,0:04:39.63,Main-207-,,0,0,0,,Gökyüzü adası korkunç, gökyüzü adası korkunç...!Dialogue: 50,0:04:40.26,0:04:43.60,Main-207-,,0,0,0,,Hayatta kalmak istiyorsanız hemen Mavi Deniz'e geri dönün!Dialogue: 50,0:04:44.22,0:04:48.52,Main-207-,,0,0,0,,Buranın işlerine karışmaya devam ederseniz...Dialogue: 50,0:04:49.64,0:04:52.44,Main-207-,,0,0,0,,Enel ile birlikte sizin de icabınıza bakarız!Dialogue: 50,0:04:53.82,0:04:56.32,Main-207-,,0,0,0,,Demek Enel'i öldürmek istiyorlar, ha?Dialogue: 50,0:04:56.32,0:05:00.15,Main-207-,,0,0,0,,O zaman gerillalar ve Tanrı farklı saflardalar.Dialogue: 50,0:05:00.15,0:05:01.78,Main-207-,,0,0,0,,Bunlar rahipler değil mi?Dialogue: 50,0:05:01.78,0:05:07.41,Main-207-,,0,0,0,,O zaman bunlara hiç bulaşmayalım ve tüyelim hemen, Luffy!Dialogue: 50,0:05:07.41,0:05:08.91,Main-207-,,0,0,0,,Ne diyorsun lan, pislik?!Dialogue: 50,0:05:08.91,0:05:11.87,Main-207-,,0,0,0,,Gel ulan! Gel de alayım ifadeni!Dialogue: 50,0:05:12.25,0:05:14.84,Main-207-,,0,0,0,,Dur! Lütfen dur!Dialogue: 50,0:05:14.84,0:05:18.21,Main-207-,,0,0,0,,Kımıldamayın bir yere, geliyorum!Dialogue: 50,0:05:18.21,0:05:22.09,Main-207-,,0,0,0,,Az öncekini misliyle ödeteceğim!Dialogue: 50,0:05:25.60,0:05:27.60,Main-207-,,0,0,0,,Geri dönün dedim ama...Dialogue: 50,0:05:28.22,0:05:33.23,Main-207-,,0,0,0,,geri dönebilir misiniz dönemez misiniz o başka bir konu.Dialogue: 50,0:05:37.82,0:05:40.03,Main-207-,,0,0,0,,Bunların olayı ne?Dialogue: 50,0:05:40.03,0:05:46.70,Main-207-,,0,0,0,,Hem bize hem de Tanrı Enel'e düşmanlar, onu öğrendik.Dialogue: 50,0:05:46.70,0:05:48.45,Main-207-,,0,0,0,,Kahretsin...!Dialogue: 50,0:05:48.45,0:05:50.37,Main-207-,,0,0,0,,Nereden düştük bu adaya?Dialogue: 50,0:05:50.37,0:05:51.54,Main-207-,,0,0,0,,Devam edelim.Dialogue: 50,0:06:06.93,0:06:08.26,Main-207-,,0,0,0,,Ben sizi korurum!Dialogue: 50,0:06:09.43,0:06:11.48,Main-207-,,0,0,0,,Yoldaşımızı kurtarın!Dialogue: 50,0:06:13.14,0:06:14.19,Main-207-,,0,0,0,,Saldırın!Dialogue: 50,0:06:56.06,0:06:59.44,Main-207-,,0,0,0,,Epey bir yol geldik, değil mi Sanji?Dialogue: 50,0:07:00.40,0:07:02.44,Main-207-,,0,0,0,,Değil mi, Sanji?!Dialogue: 50,0:07:02.44,0:07:06.45,Main-207-,,0,0,0,,Evet, geçtiğimiz çayırların da bir numarası yokmuş.Dialogue: 50,0:07:06.45,0:07:09.41,Main-207-,,0,0,0,,Sunağa kadar böyle sakince gideriz umarım.Dialogue: 50,0:07:09.91,0:07:11.79,Main-207-,,0,0,0,,Birazdan güneş batacak.Dialogue: 50,0:07:13.08,0:07:15.54,Main-207-,,0,0,0,,Bulutlar güneşi kapatıyor.Dialogue: 50,0:07:15.54,0:07:18.38,Main-207-,,0,0,0,,Demek burada da gün batımı izlenebiliyor.Dialogue: 50,0:07:31.68,0:07:33.56,Main-207-,,0,0,0,,Wyper! Kamakiri'yle burayı hallederiz!Dialogue: 50,0:07:36.19,0:07:37.60,Main-207-,,0,0,0,,Siz onlara yardım edin!Dialogue: 50,0:07:37.60,0:07:38.48,Main-207-,,0,0,0,,Anlaşıldı!Dialogue: 50,0:07:52.99,0:07:54.87,Main-207-,,0,0,0,,Chopper!Dialogue: 50,0:07:54.87,0:07:56.62,Main-207-,,0,0,0,,Neredesin?!Dialogue: 50,0:07:57.46,0:07:59.54,Main-207-,,0,0,0,,Ne oldu, Chopper?!Dialogue: 50,0:07:59.54,0:08:01.13,Main-207-,,0,0,0,,Cevap ver!Dialogue: 50,0:08:01.13,0:08:04.01,Main-207-,,0,0,0,,Merry'nin ana direği gitmiş.Dialogue: 50,0:08:04.01,0:08:06.26,Main-207-,,0,0,0,,Gemiye ne yapmış böyle?Dialogue: 50,0:08:06.26,0:08:10.09,Main-207-,,0,0,0,,Aptal mısın sen be?! Belli ki gemi saldırıya uğramış!Dialogue: 50,0:08:10.09,0:08:13.43,Main-207-,,0,0,0,,Chopper! İşimiz çok uzadı, özür dilerim!Dialogue: 50,0:08:13.43,0:08:16.68,Main-207-,,0,0,0,,Etraf güvenli! Hâlâ oradasın, değil mi?!Dialogue: 50,0:08:17.31,0:08:21.02,Main-207-,,0,0,0,,Ortaya çık da bir şey söyle, Chopper!Dialogue: 50,0:08:21.86,0:08:23.98,Main-207-,,0,0,0,,Belki de onu lime lime etmişlerdir.Dialogue: 50,0:08:23.98,0:08:25.69,Main-207-,,0,0,0,,Korkunç şeyler söylemeyi kes!Dialogue: 50,0:08:26.90,0:08:29.16,Main-207-,,0,0,0,,Hey, Chopper! Orada mısın?!Dialogue: 50,0:08:29.16,0:08:32.16,Main-207-,,0,0,0,,Bir şey mi oldu?! Cevap ver!Dialogue: 50,0:08:34.49,0:08:35.75,Main-207-,,0,0,0,,Kor...Dialogue: 50,0:08:37.79,0:08:38.54,Main-207-,,0,0,0,,Kor...Dialogue: 50,0:08:40.25,0:08:43.92,Main-207-,,0,0,0,,Korkunç hiçbir şey olmadı!Dialogue: 50,0:08:45.34,0:08:50.01,Main-207-,,0,0,0,,Tamam, tamam. En cesur sensin. Anlat bize neler oldu.Dialogue: 50,0:08:55.18,0:08:58.60,Main-207-,,0,0,0,,Daha ne kadar döneceğiz?!Dialogue: 50,0:09:00.73,0:09:02.48,Main-207-,,0,0,0,,Çok eğlenceli!Dialogue: 50,0:09:05.23,0:09:07.28,Main-207-,,0,0,0,,Sırılsıklam olduk!Dialogue: 50,0:09:08.40,0:09:09.28,Main-207-,,0,0,0,,Hey, bakın!Dialogue: 50,0:09:09.28,0:09:10.53,Main-207-,,0,0,0,,Bulduk!Dialogue: 50,0:09:10.53,0:09:12.03,Main-207-,,0,0,0,,Going Merry!Dialogue: 50,0:09:12.03,0:09:13.95,Main-207-,,0,0,0,,İşte sunak!Dialogue: 50,0:09:17.33,0:09:19.46,Main-207-,,0,0,0,,Nami-san! Robin-chwan!Dialogue: 50,0:09:19.46,0:09:21.46,Main-207-,,0,0,0,,Beklettiğimiz için üzgünüz!Dialogue: 50,0:09:21.96,0:09:25.04,Main-207-,,0,0,0,,Aşk Testi'ni geçtim de geldim!Dialogue: 50,0:09:25.04,0:09:27.63,Main-207-,,0,0,0,,Aşk testi mi? Test o muydu?Dialogue: 50,0:09:27.63,0:09:29.47,Main-207-,,0,0,0,,Korktunuz mu?!Dialogue: 50,0:09:29.47,0:09:33.76,Main-207-,,0,0,0,,Kaptan Usopp artık burada olduğuna göre rahat edebilirsiniz!Dialogue: 50,0:09:33.76,0:09:37.39,Main-207-,,0,0,0,,Görünüşe bakılırsa iyiler. İçim rahatladı.Dialogue: 50,0:09:45.02,0:09:46.52,Main-207-,,0,0,0,,Ana direk...Dialogue: 50,0:09:46.52,0:09:47.44,Main-207-,,0,0,0,,yok...Dialogue: 50,0:09:48.11,0:09:49.86,Main-207-,,0,0,0,,Eee... Usopp...Dialogue: 50,0:09:49.86,0:09:54.03,Main-207-,,0,0,0,,Özür dilerim. Elimden geleni yaptım ama...Dialogue: 50,0:09:54.70,0:09:56.83,Main-207-,,0,0,0,,geminin pek çok kısmı yandı.Dialogue: 50,0:09:56.83,0:09:59.16,Main-207-,,0,0,0,,Yaralanmışsın! İyi misin?!Dialogue: 50,0:09:59.16,0:09:59.95,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:10:01.04,0:10:01.79,Main-207-,,0,0,0,,Evet.Dialogue: 50,0:10:04.13,0:10:07.25,Main-207-,,0,0,0,,Mızrağıyla sağı solu yakan bir adam ha, çok korkunç.Dialogue: 50,0:10:07.25,0:10:10.26,Main-207-,,0,0,0,,Sen yanmamışsın ya önemli olan o.Dialogue: 50,0:10:11.26,0:10:13.88,Main-207-,,0,0,0,,Gemi için sonra endişeleniriz.Dialogue: 50,0:10:16.18,0:10:19.35,Main-207-,,0,0,0,,Yemin ediyorum daha sorumluluk sahibi biri olacağım!Dialogue: 50,0:10:19.93,0:10:21.31,Main-207-,,0,0,0,,Hey, Chopper!Dialogue: 50,0:10:21.31,0:10:24.02,Main-207-,,0,0,0,,O rahibi nasıl kovdun?Dialogue: 50,0:10:25.52,0:10:27.15,Main-207-,,0,0,0,,Düdüğü kullandım.Dialogue: 50,0:10:27.15,0:10:29.40,Main-207-,,0,0,0,,Gökyüzü Şövalyesi gelip beni kurtardı.Dialogue: 50,0:10:30.11,0:10:31.86,Main-207-,,0,0,0,,O garip ihtiyar mı? Şimdi nerede?Dialogue: 50,0:10:42.29,0:10:45.17,Main-207-,,0,0,0,,Demek düdüğü bize karşılıksız verdiği hâlde,Dialogue: 50,0:10:45.17,0:10:47.79,Main-207-,,0,0,0,,canını ortaya koyup savaştı, ha?Dialogue: 50,0:10:48.67,0:10:51.17,Main-207-,,0,0,0,,Eğer o olmasaydı,Dialogue: 50,0:10:51.17,0:10:53.30,Main-207-,,0,0,0,,geminin de benim de işim bitmişti.Dialogue: 50,0:10:53.30,0:10:57.43,Main-207-,,0,0,0,,Ona soracak çok sorumuz var ama uyanmasını beklemeliyiz.Dialogue: 50,0:10:57.93,0:10:59.81,Main-207-,,0,0,0,,Sana da teşekkürler.Dialogue: 50,0:11:04.06,0:11:05.39,Main-207-,,0,0,0,,Luffy!Dialogue: 50,0:11:07.52,0:11:10.90,Main-207-,,0,0,0,,Gemi hasar almış, güneş de batıyor...Dialogue: 50,0:11:10.90,0:11:13.36,Main-207-,,0,0,0,,Yarından önce Melek Adası'na dönme şansımız yok.Dialogue: 50,0:11:14.65,0:11:18.24,Main-207-,,0,0,0,,Ormana gidip göl kenarında kamp kuralım.Dialogue: 50,0:11:18.24,0:11:19.37,Main-207-,,0,0,0,,Neden?Dialogue: 50,0:11:19.37,0:11:23.87,Main-207-,,0,0,0,,Burada savaşırsak geminin işi biter, değil mi?Dialogue: 50,0:11:23.87,0:11:25.33,Main-207-,,0,0,0,,Az kafanı kullan!Dialogue: 50,0:11:26.17,0:11:30.04,Main-207-,,0,0,0,,Zaten kıyıda dövüşmek daha kolay.Dialogue: 50,0:11:30.92,0:11:33.92,Main-207-,,0,0,0,,Yaşasın! Harika! Kamp yapıyoruz! Parti zamanı!Dialogue: 50,0:11:32.00,0:11:32.84,Secondary-207-,,0,0,0,,Yaşasın!Dialogue: 50,0:11:33.92,0:11:34.80,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:11:34.80,0:11:37.51,Main-207-,,0,0,0,,Hey, durun! Düşman topraklarındayız!Dialogue: 50,0:11:37.51,0:11:38.59,Main-207-,,0,0,0,,Kamp nerden çıktı?!Dialogue: 50,0:11:47.27,0:11:49.10,Main-207-,,0,0,0,,Pekâlâ!Dialogue: 50,0:11:49.44,0:11:53.23,Main-207-,,0,0,0,,Herkese raporları için teşekkürler.Dialogue: 51,0:11:53.23,0:11:57.20,Main-207-,,0,0,0,,Topladığınız bilgilerle epey şey öğrendik.Dialogue: 50,0:11:57.20,0:12:00.41,Main-207-,,0,0,0,,Ancak en büyük keşfimiz...Dialogue: 50,0:12:00.41,0:12:01.12,Main-207-,,0,0,0,,bu!Dialogue: 50,0:12:01.12,0:12:06.87,Main-207-,,0,0,0,,İnanılır gibi değil ama Saruyama İttifakı'nın aradığı Altın Şehir buradaymış!Dialogue: 50,0:12:07.25,0:12:08.87,Main-207-,,0,0,0,,Gerçekten mi?!Dialogue: 50,0:12:08.87,0:12:10.58,Main-207-,,0,0,0,,Ben söylediğimde dinlemedin mi?!Dialogue: 50,0:12:11.09,0:12:13.92,Main-207-,,0,0,0,,Bu mantra denen şey de ne?Dialogue: 50,0:12:13.92,0:12:15.21,Main-207-,,0,0,0,,Bilmiyorum.Dialogue: 50,0:12:15.21,0:12:17.22,Main-207-,,0,0,0,,Acaba sezgi gibi bir şey mi?Dialogue: 50,0:12:17.22,0:12:18.05,Main-207-,,0,0,0,,Sezgi, ha?Dialogue: 50,0:12:18.80,0:12:21.43,Main-207-,,0,0,0,,Hey, Chopper! Biraz daha ezmemi ister misin?Dialogue: 50,0:12:21.43,0:12:24.31,Main-207-,,0,0,0,,Evet. Yutması kolay olsun.Dialogue: 50,0:12:24.31,0:12:27.14,Main-207-,,0,0,0,,Sindirim sistemi hasar görmüş.Dialogue: 50,0:12:31.69,0:12:32.82,Main-207-,,0,0,0,,Altın Şehir, ha?Dialogue: 50,0:12:32.82,0:12:35.03,Main-207-,,0,0,0,,İşte beklediğim macera bu!Dialogue: 50,0:12:35.03,0:12:36.24,Main-207-,,0,0,0,,Sabırsızlanıyorum!Dialogue: 50,0:12:37.44,0:12:39.78,Main-207-,,0,0,0,,Duymak istediğim tam da buydu!Dialogue: 50,0:12:39.78,0:12:41.20,Main-207-,,0,0,0,,Hey, hey, Luffy.Dialogue: 50,0:12:41.20,0:12:44.16,Main-207-,,0,0,0,,Gerillanın uyarısını unuttun mu?Dialogue: 50,0:12:45.16,0:12:46.54,Main-207-,,0,0,0,,Tanrı çok öfkelenecek.Dialogue: 50,0:12:46.54,0:12:47.54,Main-207-,,0,0,0,,Çok korkunç!Dialogue: 50,0:12:49.29,0:12:50.58,Main-207-,,0,0,0,,Kulağa eğlenceli geliyor.Dialogue: 50,0:12:50.58,0:12:55.92,Main-207-,,0,0,0,,Korsanlar olarak burnumuzun dibindeki hazineyi görmezden mi geleceğiz?Dialogue: 50,0:12:55.92,0:12:57.80,Main-207-,,0,0,0,,Pek çok düşman da edindik.Dialogue: 50,0:12:57.80,0:13:00.51,Main-207-,,0,0,0,,Ortalık karışacak.Dialogue: 50,0:13:00.51,0:13:01.89,Main-207-,,0,0,0,,Eğlenceli olacak!Dialogue: 50,0:13:02.26,0:13:03.89,Main-207-,,0,0,0,,Siz...Dialogue: 50,0:13:05.06,0:13:08.18,Main-207-,,0,0,0,,Tanrıdan biraz da olsun korkmuyor musunuz?!Dialogue: 50,0:13:08.18,0:13:10.73,Main-207-,,0,0,0,,Beni bağlamaz! Bu sefer cidden yargılanacaksınız!Dialogue: 50,0:13:19.61,0:13:20.74,Main-207-,,0,0,0,,Pekâlâ!Dialogue: 50,0:13:20.74,0:13:24.41,Main-207-,,0,0,0,,Hadi gidip o altını bulalım!Dialogue: 50,0:13:25.53,0:13:27.54,Main-207-,,0,0,0,,Kaç, Kamakiri!Dialogue: 50,0:13:29.87,0:13:31.79,Main-207-,,0,0,0,,Sana borçlandım, Kamakiri...Dialogue: 50,0:13:34.42,0:13:36.09,Main-207-,,0,0,0,,Kamakiri!Dialogue: 50,0:13:36.09,0:13:37.17,Main-207-,,0,0,0,,Kahretsin!Dialogue: 50,0:13:42.30,0:13:44.55,Main-207-,,0,0,0,,Wyper! Kamakiri ağır yaralandı!Dialogue: 50,0:13:45.22,0:13:46.26,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:13:50.60,0:13:52.48,Main-207-,,0,0,0,,Kahretsin!Dialogue: 50,0:13:52.48,0:13:54.44,Main-207-,,0,0,0,,Çok yaklaşmıştık!Dialogue: 50,0:13:55.69,0:13:57.61,Main-207-,,0,0,0,,Nereden biliyorsun?Dialogue: 50,0:13:58.28,0:14:01.99,Main-207-,,0,0,0,,Gece olduğunda avantajımız daha da artacak.Dialogue: 50,0:14:10.58,0:14:13.33,Main-207-,,0,0,0,,Yaralılara yardım edin! Geri çekiliyoruz!Dialogue: 50,0:14:13.33,0:14:15.38,Main-207-,,0,0,0,,Buluşma noktasında toplanın!Dialogue: 50,0:14:18.71,0:14:20.51,Main-207-,,0,0,0,,Kaçmanıza izin vermeyeceğiz!Dialogue: 50,0:14:20.51,0:14:22.01,Main-207-,,0,0,0,,Bekle, Ohm!Dialogue: 50,0:14:23.55,0:14:24.72,Main-207-,,0,0,0,,Ne oldu?Dialogue: 50,0:14:25.97,0:14:28.22,Main-207-,,0,0,0,,Tanrı Enel bizi görmek istiyor.Dialogue: 50,0:14:43.28,0:14:45.24,Main-207-,,0,0,0,,Çok sıkıldım be!Dialogue: 50,0:14:45.24,0:14:47.53,Main-207-,,0,0,0,,Niye ona bakıp duruyorsun ki?!Dialogue: 50,0:14:48.37,0:14:53.62,Main-207-,,0,0,0,,Senin tek görevin yoğuşan suyu mataralara koymak....Dialogue: 50,0:14:53.62,0:14:57.25,Main-207-,,0,0,0,,ki yarın içecek temiz suyumuz olsun.Dialogue: 50,0:14:59.46,0:15:01.51,Main-207-,,0,0,0,,Ama...Dialogue: 50,0:15:01.51,0:15:03.59,Main-207-,,0,0,0,,Sanji! Bir sürü şey bulduk!Dialogue: 50,0:15:03.59,0:15:05.93,Main-207-,,0,0,0,,Ah! Aferin! Neler topladınız?Dialogue: 50,0:15:05.93,0:15:08.68,Main-207-,,0,0,0,,Ceviz, sarısabır, muz ve sarımsak!Dialogue: 50,0:15:08.68,0:15:09.85,Main-207-,,0,0,0,,Ayrıca fare ve kurbağa.Dialogue: 50,0:15:09.85,0:15:12.02,Main-207-,,0,0,0,,Güzel! Yahniye atın hepsini!Dialogue: 50,0:15:12.02,0:15:14.85,Main-207-,,0,0,0,,Dur be! O garip şeylerin hepisini beraber mi yiyeceğiz!Dialogue: 50,0:15:15.69,0:15:18.36,Main-207-,,0,0,0,,Haklısın! Ne kadar dikkatsizim!Dialogue: 50,0:15:18.36,0:15:19.90,Main-207-,,0,0,0,,Sarımsak olur mu hiç?Dialogue: 50,0:15:19.90,0:15:21.82,Main-207-,,0,0,0,,Tek problem o değil!Dialogue: 50,0:15:21.82,0:15:23.32,Main-207-,,0,0,0,,Sorun nedir...Dialogue: 50,0:15:23.78,0:15:25.03,Main-207-,,0,0,0,,Rotacı Hanım?Dialogue: 50,0:15:25.53,0:15:27.03,Main-207-,,0,0,0,,Vay, Robin!Dialogue: 50,0:15:27.03,0:15:29.66,Main-207-,,0,0,0,,O mavi şey ne? Değerli bir taş mı?!Dialogue: 50,0:15:29.66,0:15:30.78,Main-207-,,0,0,0,,Güzel, değil mi?Dialogue: 50,0:15:30.78,0:15:32.24,Main-207-,,0,0,0,,Ama hayır, değil.Dialogue: 50,0:15:32.24,0:15:34.71,Main-207-,,0,0,0,,Ah, tuz kristali, ha?Dialogue: 50,0:15:34.71,0:15:36.92,Main-207-,,0,0,0,,İyi bulmuşsun, Robin-chan!Dialogue: 50,0:15:36.92,0:15:38.92,Main-207-,,0,0,0,,Gölün kenarında buldum.Dialogue: 50,0:15:38.92,0:15:40.88,Main-207-,,0,0,0,,İşe yarar diye düşündüm.Dialogue: 50,0:15:40.88,0:15:42.42,Main-207-,,0,0,0,,Yarar tabii!Dialogue: 50,0:15:42.42,0:15:45.38,Main-207-,,0,0,0,,Tuz, yaban hayatı için çok önemlidir!Dialogue: 50,0:15:47.18,0:15:49.89,Main-207-,,0,0,0,,Sarısabır ve sarımsağın yarısını alacağım!Dialogue: 50,0:15:49.89,0:15:53.89,Main-207-,,0,0,0,,Gökyüzü Şövalyesi için yanık ilacı ve antiseptik yapmak istiyorum!Dialogue: 50,0:15:53.89,0:15:54.89,Main-207-,,0,0,0,,Öyle mi?Dialogue: 50,0:15:55.23,0:15:57.31,Main-207-,,0,0,0,,Kurbağalar ne olacak?Dialogue: 50,0:15:55.98,0:15:57.31,Secondary-207-,,0,0,0,,Kurbağa lazım değil.Dialogue: 50,0:15:57.31,0:15:58.60,Main-207-,,0,0,0,,Hey, Zoro!Dialogue: 50,0:15:59.31,0:16:01.36,Main-207-,,0,0,0,,Boş boş duruyorsun. Gel yardım et.Dialogue: 50,0:16:03.94,0:16:08.16,Main-207-,,0,0,0,,Kılıçlarım bu işler için değil, biliyorsun değil mi?Dialogue: 50,0:16:08.16,0:16:12.41,Main-207-,,0,0,0,,Çok konuşma! Aşçıyı kızdırırsan akşam yemeğinde taş yersin!Dialogue: 50,0:16:16.41,0:16:18.37,Main-207-,,0,0,0,,Ha?! Taş mı yiyeceğiz?!Dialogue: 50,0:16:18.37,0:16:19.63,Main-207-,,0,0,0,,Tadı güzel mi?Dialogue: 50,0:16:19.63,0:16:20.75,Main-207-,,0,0,0,,Saçmalama.Dialogue: 50,0:16:20.75,0:16:22.09,Main-207-,,0,0,0,,Bu taş yahnisi.Dialogue: 50,0:16:22.09,0:16:25.09,Main-207-,,0,0,0,,Taşın sıcaklığıyla yahni pişiyor.Dialogue: 50,0:16:26.17,0:16:28.01,Main-207-,,0,0,0,,Yahni çok iyidir!Dialogue: 50,0:16:28.01,0:16:30.80,Main-207-,,0,0,0,,Böylece ziyansız tüm besin değerinden faydalanırsın!Dialogue: 50,0:16:30.80,0:16:32.22,Main-207-,,0,0,0,,Anladım!Dialogue: 50,0:16:32.22,0:16:34.06,Main-207-,,0,0,0,,Ah! Demek yahn–Dialogue: 50,0:16:34.06,0:16:35.68,Main-207-,,0,0,0,,Açma kapağını!Dialogue: 50,0:16:37.06,0:16:39.81,Main-207-,,0,0,0,,Sanji! Çok acıktım!Dialogue: 50,0:16:39.81,0:16:41.65,Main-207-,,0,0,0,,Daha pişmedi ki!Dialogue: 50,0:16:42.02,0:16:45.90,Main-207-,,0,0,0,,Yahu daha demin koca bir kızarmış köpek balığı yemedin mi sen?!Dialogue: 50,0:16:45.90,0:16:46.86,Main-207-,,0,0,0,,Evet...Dialogue: 50,0:16:46.86,0:16:49.20,Main-207-,,0,0,0,,ama o aperatifti.Dialogue: 50,0:16:49.74,0:16:52.62,Main-207-,,0,0,0,,Nasıl bir midesi var bunun ya?Dialogue: 50,0:16:52.62,0:16:54.24,Main-207-,,0,0,0,,Doymak bilmiyor...Dialogue: 50,0:16:58.12,0:17:00.62,Main-207-,,0,0,0,,Ne yapıyorsun, Usopp? Akşam yemeği neredeyse hazır.Dialogue: 50,0:17:00.62,0:17:01.79,Main-207-,,0,0,0,,Evet, biliyorum.Dialogue: 50,0:17:02.29,0:17:06.63,Main-207-,,0,0,0,,Gemiyi onarmak için odun hazırlıyordum.Dialogue: 50,0:17:07.38,0:17:08.72,Main-207-,,0,0,0,,Gemiye kadar yüzecek misin?Dialogue: 50,0:17:08.72,0:17:10.26,Main-207-,,0,0,0,,Ha? Evet.Dialogue: 50,0:17:10.26,0:17:12.55,Main-207-,,0,0,0,,Dev köpek balıkları var yalnız.Dialogue: 50,0:17:17.52,0:17:20.77,Main-207-,,0,0,0,,Yarın hallederim! Hadi yemeğe gidelim, Zoro!Dialogue: 50,0:17:22.94,0:17:24.57,Main-207-,,0,0,0,,Peki...Dialogue: 50,0:17:28.32,0:17:29.86,Main-207-,,0,0,0,,Tamamdır! Bitirdim!Dialogue: 50,0:17:29.86,0:17:32.49,Main-207-,,0,0,0,,Önce hanımlar. Tamam mı?Dialogue: 50,0:17:32.49,0:17:33.32,Main-207-,,0,0,0,,Tamam.Dialogue: 50,0:17:33.70,0:17:35.95,Main-207-,,0,0,0,,Pekâlâ! Herkes yerini alsın!Dialogue: 50,0:17:35.95,0:17:38.54,Main-207-,,0,0,0,,Servisi ben yapacağım, soğutmadan yeyin!Dialogue: 50,0:17:38.54,0:17:39.91,Main-207-,,0,0,0,,Dinleyin, çocuklar!Dialogue: 50,0:17:39.91,0:17:43.38,Main-207-,,0,0,0,,Yarın ne yapacağız, onu planlayalım!Dialogue: 50,0:17:43.38,0:17:45.38,Main-207-,,0,0,0,,Ooh! Harika görünüyor!Dialogue: 50,0:17:45.96,0:17:47.42,Main-207-,,0,0,0,,Herkes hazır mı?Dialogue: 50,0:17:47.42,0:17:49.88,Main-207-,,0,0,0,,Önce Nolan'ın kitabına tekrar bakalım!Dialogue: 50,0:17:49.88,0:17:54.14,Main-207-,,0,0,0,,Noland, Altın Şehir'i 400 yıl önce keşfetmiş.Dialogue: 50,0:17:54.14,0:17:58.06,Main-207-,,0,0,0,,Ama yıllar sonra Jaya'ya döndüğünde...Dialogue: 50,0:17:58.06,0:18:00.39,Main-207-,,0,0,0,,altından eser kalmamış!Dialogue: 50,0:18:00.39,0:18:03.02,Main-207-,,0,0,0,,Yahni acayip iyi! Aynı–Dialogue: 50,0:18:04.10,0:18:06.02,Main-207-,,0,0,0,,Hey! Dinliyor musunuz?!Dialogue: 50,0:18:06.02,0:18:08.61,Main-207-,,0,0,0,,Üzgünüm, Nami-san! Ama rahat–Dialogue: 50,0:18:08.61,0:18:11.70,Main-207-,,0,0,0,,Gökyüzü adası yemekleri çok güzel!Dialogue: 50,0:18:13.20,0:18:14.82,Main-207-,,0,0,0,,Ne diyordum...!Dialogue: 50,0:18:14.82,0:18:19.08,Main-207-,,0,0,0,,Yani o yıllarda bu ada Jaya'nın bir parçasıymış,Dialogue: 50,0:18:19.08,0:18:20.66,Main-207-,,0,0,0,,ve gökyüzüne yükselmiş!Dialogue: 50,0:18:21.46,0:18:24.63,Main-207-,,0,0,0,,Yani Yukarı Fırlatan Akıntı ile mi yükselmiş?!Dialogue: 50,0:18:24.63,0:18:27.42,Main-207-,,0,0,0,,Evet. Aklıma başka bir ihtimal gelmiyor.Dialogue: 50,0:18:27.42,0:18:31.67,Main-207-,,0,0,0,,Cricket, deniz her seferinde farklı noktalardan patlıyor demişti.Dialogue: 50,0:18:31.67,0:18:35.39,Main-207-,,0,0,0,,O kadar büyük bir patlama bir adayı bile uçurur!Dialogue: 50,0:18:36.22,0:18:42.31,Main-207-,,0,0,0,,Ama Jaya'daki ormanla bunun aynı olduğuna inanmak güç.Dialogue: 50,0:18:42.31,0:18:46.81,Main-207-,,0,0,0,,Muhtemelen ada bulutları ve denizin farklı olmasından dolayı.Dialogue: 50,0:18:47.44,0:18:49.44,Main-207-,,0,0,0,,Anlaşılan buranın çevre koşulları,Dialogue: 50,0:18:49.44,0:18:52.57,Main-207-,,0,0,0,,bitkilerin ve hayvanların çok hızlı büyümesini sağlıyor.Dialogue: 50,0:18:52.57,0:18:56.78,Main-207-,,0,0,0,,Bu, medeniyete dair her şeyin doğa tarafından yutulmasını da açıklıyor.Dialogue: 50,0:18:56.78,0:19:02.20,Main-207-,,0,0,0,,Gölde bizi kurtaran güney kuşları da kocamandı!Dialogue: 50,0:19:02.20,0:19:05.12,Main-207-,,0,0,0,,Evet, muhtemelen buradaki 400 yıllık evrimleri yüzünden.Dialogue: 50,0:19:05.12,0:19:07.25,Main-207-,,0,0,0,,Ama yine de bir gariplik var...Dialogue: 50,0:19:07.25,0:19:10.75,Main-207-,,0,0,0,,Kuşlar seni neden kurtardı ki?Dialogue: 50,0:19:10.75,0:19:13.38,Main-207-,,0,0,0,,Bilmiyorum.Dialogue: 50,0:19:13.38,0:19:17.47,Main-207-,,0,0,0,,Ama Gökyüzü Şövalyesi'ne "Tanrı" dediler.Dialogue: 50,0:19:18.60,0:19:22.47,Main-207-,,0,0,0,,Tanrı mı?! Yani sadece o ihtiyarı mı yenmemiz gerekiyor?!Dialogue: 50,0:19:22.47,0:19:25.10,Main-207-,,0,0,0,,Elbette hayır, salak!Dialogue: 50,0:19:25.10,0:19:27.81,Main-207-,,0,0,0,,Tamam, yeter! Boşboğazlık yapma da otur yerine!Dialogue: 50,0:19:27.81,0:19:28.77,Main-207-,,0,0,0,,Evet! Otur bakayım!Dialogue: 50,0:19:28.77,0:19:30.23,Main-207-,,0,0,0,,Kimmiş boşboğaz?!Dialogue: 50,0:19:30.23,0:19:30.98,Main-207-,,0,0,0,,Sensin!Dialogue: 50,0:19:30.98,0:19:36.78,Main-207-,,0,0,0,,Neyse, Noland'ın seyir defteri Altın Şehir hakkında ne diyordu, hatırlıyor musunuz?!Dialogue: 50,0:19:36.78,0:19:38.66,Main-207-,,0,0,0,,Evet! Altından bahsediyordu!Dialogue: 50,0:19:38.66,0:19:41.99,Main-207-,,0,0,0,,Tabii ki altından bahsediyordu! Onu sormuyor, düşün az!Dialogue: 50,0:19:41.99,0:19:47.37,Main-207-,,0,0,0,,Altından devasa bir çandan bahsediyordu bir de güney kuşları vardı.Dialogue: 50,0:19:48.00,0:19:51.75,Main-207-,,0,0,0,,Son sayfasında anlaşılmayan bir satır vardı.Dialogue: 50,0:19:51.75,0:19:54.92,Main-207-,,0,0,0,,Ölmeden önce Noland bir şey yazmıştı,Dialogue: 50,0:19:55.30,0:19:57.72,Main-207-,,0,0,0,,kuru kafanın sağ gözünde altın gördüğüne dair.Dialogue: 50,0:19:57.72,0:19:58.68,Main-207-,,0,0,0,,Evet!Dialogue: 50,0:19:59.26,0:20:00.35,Main-207-,,0,0,0,,Bakın!Dialogue: 50,0:20:00.35,0:20:05.68,Main-207-,,0,0,0,,Robin'in Jaya haritasını Skypiea haritası ile eşleşecek şekilde yeniden ölçekledim.Dialogue: 50,0:20:05.68,0:20:07.31,Main-207-,,0,0,0,,Sadece bir tahmin...Dialogue: 50,0:20:07.31,0:20:11.61,Main-207-,,0,0,0,,ama deniz kenarındaki eve göre ayarladığında...Dialogue: 50,0:20:12.77,0:20:15.53,Main-207-,,0,0,0,,Bakın! Jaya 400 yıl önce böyleydi!Dialogue: 50,0:20:17.28,0:20:19.16,Main-207-,,0,0,0,,Vay! Kuru kafa oldu!Dialogue: 50,0:20:19.16,0:20:20.74,Main-207-,,0,0,0,,Aynı kuru kafaya benziyor!Dialogue: 50,0:20:22.16,0:20:23.08,Main-207-,,0,0,0,,Eee?Dialogue: 50,0:20:23.08,0:20:24.04,Main-207-,,0,0,0,,Harika!Dialogue: 50,0:20:24.04,0:20:25.91,Main-207-,,0,0,0,,Bravo, Nami-san!Dialogue: 50,0:20:25.91,0:20:27.54,Main-207-,,0,0,0,,Başardık!Dialogue: 50,0:20:27.54,0:20:28.67,Main-207-,,0,0,0,,O zaman...Dialogue: 50,0:20:28.67,0:20:30.75,Main-207-,,0,0,0,,kuru kafanın sağ gözü...Dialogue: 50,0:20:32.25,0:20:33.38,Main-207-,,0,0,0,,...tam burada!Dialogue: 50,0:20:34.30,0:20:38.13,Main-207-,,0,0,0,,Noland adanın şeklini kastediyordu.Dialogue: 50,0:20:38.13,0:20:42.89,Main-207-,,0,0,0,,Ama sadece yarısı kalmıştı, bu yüzden kimse ne dediğini anlamadı!Dialogue: 50,0:20:43.39,0:20:45.14,Main-207-,,0,0,0,,Anladım!Dialogue: 50,0:20:45.14,0:20:47.23,Main-207-,,0,0,0,,Demek bu yüzden.Dialogue: 50,0:20:47.23,0:20:48.98,Main-207-,,0,0,0,,İlginç.Dialogue: 50,0:20:48.98,0:20:50.35,Main-207-,,0,0,0,,Hazine!Dialogue: 50,0:20:50.35,0:20:51.86,Main-207-,,0,0,0,,Hazine!Dialogue: 50,0:20:52.19,0:20:55.23,Main-207-,,0,0,0,,Yani tam olarak gözün olduğu yere gitmeliyiz!Dialogue: 50,0:20:55.78,0:20:57.65,Main-207-,,0,0,0,,Ama gemiyi bırakamayız,Dialogue: 50,0:20:57.65,0:21:00.36,Main-207-,,0,0,0,,o yüzden yarın iki gruba ayrılalım!Dialogue: 50,0:21:01.70,0:21:03.20,Main-207-,,0,0,0,,Artık şüphe yok!Dialogue: 50,0:21:03.20,0:21:06.95,Main-207-,,0,0,0,,Orada bizi bekleyen koca bir hazine var!Dialogue: 50,0:21:07.70,0:21:10.46,Main-207-,,0,0,0,,Ehh, ne yedik be!Dialogue: 50,0:21:11.50,0:21:12.75,Main-207-,,0,0,0,,Yarın altın bulacağız!Dialogue: 50,0:21:12.75,0:21:14.13,Main-207-,,0,0,0,,Aynen öyle!Dialogue: 50,0:21:15.00,0:21:16.96,Main-207-,,0,0,0,,Yarın hava güneşli mi olur sizce?Dialogue: 50,0:21:16.96,0:21:18.67,Main-207-,,0,0,0,,Bulutların üzerindeyiz...Dialogue: 50,0:21:19.17,0:21:21.05,Main-207-,,0,0,0,,Epey geç oldu.Dialogue: 50,0:21:21.05,0:21:23.43,Main-207-,,0,0,0,,Lazım değilse ateşi söndürelim...Dialogue: 50,0:21:23.43,0:21:25.18,Main-207-,,0,0,0,,Yoksa yerimizi belli edecek.Dialogue: 50,0:21:26.89,0:21:28.39,Main-207-,,0,0,0,,Çok aptalca!Dialogue: 50,0:21:28.39,0:21:29.77,Main-207-,,0,0,0,,Duydun mu, Usopp?Dialogue: 50,0:21:29.77,0:21:32.81,Main-207-,,0,0,0,,Ateşi söndürmek istiyormuş!Dialogue: 50,0:21:33.48,0:21:34.77,Main-207-,,0,0,0,,Onun suçu değil.Dialogue: 50,0:21:35.52,0:21:40.03,Main-207-,,0,0,0,,Bugüne kadar ne gördü ki.Dialogue: 50,0:21:40.03,0:21:41.11,Main-207-,,0,0,0,,Bilmez o.Dialogue: 50,0:21:42.61,0:21:44.24,Main-207-,,0,0,0,,Ne demek istiyorsunuz?Dialogue: 50,0:21:45.49,0:21:48.91,Main-207-,,0,0,0,,Kamp ateşi hep yanmalıdır!Dialogue: 50,0:21:48.91,0:21:51.71,Main-207-,,0,0,0,,Ölümün kıyısında olsan bile,Dialogue: 50,0:21:51.71,0:21:54.88,Main-207-,,0,0,0,,gece kamp ateşini canlı tutmak insanı insan yapan şeydir!Dialogue: 50,0:21:54.88,0:21:57.46,Main-207-,,0,0,0,,Tam bir salaksınız!Dialogue: 50,0:21:57.46,0:21:59.84,Main-207-,,0,0,0,,Saçmalamayı kesin artık!Dialogue: 50,0:22:00.47,0:22:04.09,Main-207-,,0,0,0,,Bu orman ne kadar tehlikeli biliyor musunuz?!Dialogue: 50,0:22:04.09,0:22:04.97,Main-207-,,0,0,0,,Bilmiyorum!Dialogue: 50,0:22:04.97,0:22:07.31,Main-207-,,0,0,0,,Rahipler var! Gerillalar var!Dialogue: 50,0:22:07.31,0:22:11.52,Main-207-,,0,0,0,,Onlar olmasa bile ormanlar gece tehlikeli olur!Dialogue: 50,0:22:11.52,0:22:14.40,Main-207-,,0,0,0,,Vahşi hayvanlar ve canavarlar olabilir!Dialogue: 50,0:22:14.40,0:22:15.52,Main-207-,,0,0,0,,Canavarlar mı?!Dialogue: 50,0:22:15.52,0:22:17.98,Main-207-,,0,0,0,,Gökyüzü adası korkunç, gökyüzü adası korkunç...Dialogue: 50,0:22:17.98,0:22:19.23,Main-207-,,0,0,0,,Hey, Luffy!Dialogue: 50,0:22:20.11,0:22:22.28,Main-207-,,0,0,0,,Bu kadar odun yeter mi?Dialogue: 50,0:22:22.28,0:22:24.70,Main-207-,,0,0,0,,Siz de mi bunlara uyuyorsunuz?!Dialogue: 50,0:22:25.70,0:22:27.16,Main-207-,,0,0,0,,Dert etme, Nami-san.Dialogue: 50,0:22:27.16,0:22:30.12,Main-207-,,0,0,0,,Vahşi hayvanlar ateşten korkarlar.Dialogue: 50,0:22:30.62,0:22:32.25,Main-207-,,0,0,0,,Arkanda, arkanda!Dialogue: 50,0:22:32.25,0:22:34.12,Main-207-,,0,0,0,,Arkanda bir şeyler var!Dialogue: 50,0:22:41.59,0:22:44.43,Main-207-,,0,0,0,,Hey! Bir şey diyor! Gelsene, Chopper!Dialogue: 50,0:22:51.02,0:22:54.98,Main-207-,,0,0,0,,Parti başlasın! Bu, altın avı arifesi şenliği!Dialogue: 50,0:22:59.23,0:23:01.19,Main-207-,,0,0,0,,Bu ne böyle?! Acayip lezzetli!Dialogue: 50,0:23:01.19,0:23:03.32,Main-207-,,0,0,0,,Bunu siz mi yaptınız?Dialogue: 50,0:23:03.32,0:23:04.99,Main-207-,,0,0,0,,Tadı çok güzel! Biraz daha lütfen!Dialogue: 50,0:23:19.04,0:23:20.75,Main-207-,,0,0,0,,Bu ne ya?! Leziz!Dialogue: 50,0:23:20.75,0:23:22.76,Main-207-,,0,0,0,,Hadi hazineyi bulalım!Dialogue: 50,0:23:22.76,0:23:24.67,Main-207-,,0,0,0,,– Altın! – Altın!Dialogue: 50,0:23:28.93,0:23:31.93,Main-207-,,0,0,0,,Kurtlarla bile dost oldular.Dialogue: 50,0:23:33.48,0:23:38.61,Main-207-,,0,0,0,,Enel'in topraklarında kimse böyle alem yapmaya cüret edemezdi.Dialogue: 50,0:23:38.61,0:23:41.15,Main-207-,,0,0,0,,Ah, demek uyandın! Yatıp dinlenmen gerekmiyor mu?Dialogue: 50,0:23:41.15,0:23:44.53,Main-207-,,0,0,0,,Size yardım etmek istemiştim ama yük oldum, özür dilerim.Dialogue: 50,0:23:44.53,0:23:46.78,Main-207-,,0,0,0,,Ne diyorsun? Çok büyük iyiliğin dokundu!Dialogue: 50,0:23:46.78,0:23:51.03,Main-207-,,0,0,0,,Teşekkürler! Chopper'ı ve gemimizi kurtardın.Dialogue: 50,0:23:51.03,0:23:52.04,Main-207-,,0,0,0,,Bir şey değil...Dialogue: 50,0:23:52.04,0:23:54.29,Main-207-,,0,0,0,,Hâlâ biraz yahni var. İster misin?Dialogue: 50,0:23:54.29,0:23:57.67,Main-207-,,0,0,0,,Hayır, teşekkürler. Almayayım.Dialogue: 50,0:23:59.50,0:24:03.00,Main-207-,,0,0,0,,Ah?! O garip ihtiyar ayaklanmış! Yardımların için teşekkürler!Dialogue: 50,0:24:03.00,0:24:04.13,Main-207-,,0,0,0,,Hadi dans edelim!Dialogue: 50,0:24:04.13,0:24:05.84,Main-207-,,0,0,0,,Hadi dans edelim, Gökyüzü Şövalyesi!Dialogue: 50,0:24:05.84,0:24:07.43,Main-207-,,0,0,0,,Sen doktorsun, doktor!Dialogue: 50,0:24:09.09,0:24:10.30,Main-207-,,0,0,0,,Vaay ihtiyar!Dialogue: 50,0:24:10.30,0:24:12.43,Main-207-,,0,0,0,,Conis-chan nasıl? İyi mi?Dialogue: 50,0:24:12.43,0:24:16.94,Main-207-,,0,0,0,,Evet. Babasıyla birlikte evimde kalıyorlar. Endişelenmeyin.Dialogue: 50,0:24:16.94,0:24:17.77,Main-207-,,0,0,0,,Gerçekten mi?!Dialogue: 50,0:24:17.77,0:24:20.40,Main-207-,,0,0,0,,Harika! Çok endişeleniyordum!Dialogue: 50,0:24:20.40,0:24:23.27,Main-207-,,0,0,0,,Güvende olduklarına sevindim!Dialogue: 50,0:24:23.27,0:24:25.49,Main-207-,,0,0,0,,Pekâlâ! Hadi Chopper'ı havaya atalım!Dialogue: 50,0:24:25.49,0:24:26.57,Main-207-,,0,0,0,,Neden?!Dialogue: 50,0:24:41.63,0:24:44.71,Main-207-,,0,0,0,,Az önce sizi konuşurken duydum...Dialogue: 50,0:24:45.21,0:24:48.34,Main-207-,,0,0,0,,Buranın ismi önceden Jaya mıymış?Dialogue: 50,0:24:48.34,0:24:49.34,Main-207-,,0,0,0,,Evet.Dialogue: 50,0:24:49.34,0:24:53.43,Main-207-,,0,0,0,,Buranın neden "kutsal topraklar" diye anıldığını...Dialogue: 50,0:24:53.43,0:24:57.06,Main-207-,,0,0,0,,bilmiyorsunuz anlaşılan.Dialogue: 50,0:25:04.27,0:25:07.19,Main-207-,,0,0,0,,Savaşta bu gibi şeyler dikkatimizi dağıtıyor!Dialogue: 50,0:25:07.19,0:25:10.32,Main-207-,,0,0,0,,Bize külfet olmaya mı geldin buraya Raki?!Dialogue: 50,0:25:11.41,0:25:15.33,Main-207-,,0,0,0,,Kamakiri için çok üzgünüm.Dialogue: 50,0:25:15.70,0:25:17.04,Main-207-,,0,0,0,,Rakiplerimiz rahipler!Dialogue: 50,0:25:17.04,0:25:19.96,Main-207-,,0,0,0,,Tüm dikkatimizi vermezsek Tanrı'nın Tapı–Dialogue: 50,0:25:19.96,0:25:22.63,Main-207-,,0,0,0,,Özür dilemek bir şeyi değiştirmeyecek biliyorum!Dialogue: 50,0:25:22.63,0:25:26.30,Main-207-,,0,0,0,,Ama lütfen onu geri ver! O Aisa'nın hazinesi!Dialogue: 50,0:25:26.30,0:25:30.76,Main-207-,,0,0,0,,Ona vearth getireceğime dair söz verdim!Dialogue: 50,0:25:29.92,0:25:30.76,Secondary-207-,,0,0,0,,Kes sesini!Dialogue: 50,0:25:30.76,0:25:32.47,Main-207-,,0,0,0,,Bağışla beni! Lütfen çantayı atma!Dialogue: 50,0:25:35.81,0:25:39.14,Main-207-,,0,0,0,,Kamakiri... Yaraların...Dialogue: 50,0:25:39.64,0:25:41.60,Main-207-,,0,0,0,,Hâlâ dövüşebilirim.Dialogue: 50,0:25:44.44,0:25:48.11,Main-207-,,0,0,0,,Haklısın, Yukarı Bahçe'yi almak için en iyi şansımızdı.Dialogue: 50,0:25:51.95,0:25:56.58,Main-207-,,0,0,0,,Satori'nin olmadığı bu günün savaşında iyi bir mücadele verdik.Dialogue: 50,0:25:56.58,0:26:00.79,Main-207-,,0,0,0,,Yarın tekrar saldıralım, Wyper.Dialogue: 50,0:26:08.13,0:26:10.72,Main-207-,,0,0,0,,Siz Mavi Deniz'den gelenler için,Dialogue: 50,0:26:10.72,0:26:14.84,Main-207-,,0,0,0,,buranın toprağı normal gözüküyordur.Dialogue: 50,0:26:14.84,0:26:16.18,Main-207-,,0,0,0,,Evet, öyle.Dialogue: 50,0:26:17.06,0:26:19.02,Main-207-,,0,0,0,,Anladım.Dialogue: 50,0:26:19.72,0:26:20.85,Main-207-,,0,0,0,,Ama bu toprak...Dialogue: 50,0:26:21.64,0:26:24.69,Main-207-,,0,0,0,,normalde gökyüzünde var olan bir şey değildir.Dialogue: 50,0:26:25.02,0:26:30.19,Main-207-,,0,0,0,,Ada bulutlarında bitkiler yaşayabilir ama doğal olarak çimlenemezler.Dialogue: 50,0:26:30.19,0:26:33.66,Main-207-,,0,0,0,,Yeşillik ve toprak, doğal olarak burada bulunmaz.Dialogue: 50,0:26:40.87,0:26:44.54,Main-207-,,0,0,0,,Biz buna "vearth" deriz.Dialogue: 50,0:26:46.13,0:26:52.09,Main-207-,,0,0,0,,Burada yaşayanlar için, sonsuz umudun ve hayatın maddeleşmiş halidir.Dialogue: 50,0:26:54.59,0:26:56.30,Main-207-,,0,0,0,,Enel'i yendikten sonra,Dialogue: 50,0:26:56.30,0:27:00.27,Main-207-,,0,0,0,,bir avuç vearth'e bile tapmamız gerekmeyecek.Dialogue: 50,0:27:01.27,0:27:03.48,Main-207-,,0,0,0,,Değil mi, Wyper?Dialogue: 50,0:27:07.86,0:27:09.23,Main-207-,,0,0,0,,Shandia'yı...Dialogue: 50,0:27:09.23,0:27:12.44,Main-207-,,0,0,0,,400 yıl önceki hâline geri döndürelim!Dialogue: 50,0:27:13.15,0:27:16.45,Main-207-,,0,0,0,,Hadi ama, Zoro! Sadece bir kereliğine...!Dialogue: 50,0:27:16.45,0:27:18.45,Main-207-,,0,0,0,,Gelmiyorum dedim!Dialogue: 50,0:27:18.45,0:27:20.24,Main-207-,,0,0,0,,Amma mızmızlandın ya!Dialogue: 50,0:27:20.24,0:27:22.33,Main-207-,,0,0,0,,Korktuysan sabaha kadar bekle!Dialogue: 50,0:27:22.33,0:27:25.33,Main-207-,,0,0,0,,Bekleyebilsem beklerim!Dialogue: 50,0:27:25.33,0:27:28.17,Main-207-,,0,0,0,,Git kendi başına işe.Dialogue: 50,0:27:29.92,0:27:32.71,Main-207-,,0,0,0,,Taş kalplinin tekisin, Zoro!Dialogue: 50,0:27:51.32,0:27:53.15,Thoughts-207-,,0,0,0,,Bu ses de ne?!Dialogue: 50,0:28:04.12,0:28:07.21,Thoughts-207-,,0,0,0,,Geminin orada kimsenin olmaması gerekiyor..Dialogue: 50,0:28:08.75,0:28:11.29,Main-207-,,0,0,0,,Sisten bir şey gözükmüyor.Dialogue: 50,0:28:46.66,0:28:48.92,Main-207-,,0,0,0,,Ne yapıyor bu?Dialogue: 50,0:28:49.29,0:28:52.54,Main-207-,,0,0,0,,İşemeye gidip uyuya kalmış.Dialogue: 50,0:28:52.54,0:28:54.30,Main-207-,,0,0,0,,Umutsuz vaka.Dialogue: 50,0:28:55.42,0:28:58.59,Main-207-,,0,0,0,,H-Hayalet... H-H-Hayalet...Dialogue: 50,0:28:59.22,0:29:01.18,Main-207-,,0,0,0,,Rüya görüyorsun!Dialogue: 50,0:29:01.55,0:29:04.14,Main-207-,,0,0,0,,H-H-Hayalet!Dialogue: 50,0:29:05.10,0:29:05.93,Main-207-,,0,0,0,,Orada...Dialogue: 50,0:29:06.47,0:29:08.89,Main-207-,,0,0,0,,hayalet...!Dialogue: 50,0:29:11.15,0:29:12.81,Main-207-,,0,0,0,,Biz...Dialogue: 50,0:29:16.36,0:29:17.36,Main-207-,,0,0,0,,Hey.Dialogue: 50,0:29:23.57,0:29:25.79,Main-207-,,0,0,0,,Dudağını ısırırken...Dialogue: 50,0:29:26.62,0:29:29.00,Main-207-,,0,0,0,,konuşmak zor olmalı.Dialogue: 50,0:29:33.08,0:29:34.67,Main-207-,,0,0,0,,Ne kadar dikkatsizim.Dialogue: 50,0:29:36.38,0:29:38.13,Main-207-,,0,0,0,,Size söylediğim gibi,Dialogue: 50,0:29:38.13,0:29:43.93,Main-207-,,0,0,0,,Enel-sama bizi çağırdı çünkü Wyper'ın kaçmasına izin verdiniz!Dialogue: 50,0:29:48.14,0:29:52.52,Main-207-,,0,0,0,,Gan Fall'ı yendin diye bir tarafın kalkmasın, Shura!Dialogue: 50,0:29:53.15,0:29:54.81,Main-207-,,0,0,0,,Eğlence başlıyor!Dialogue: 50,0:29:59.86,0:30:03.41,Main-207-,,0,0,0,,Tanrım, rahipler geldi.Dialogue: 50,0:30:03.41,0:30:05.28,Main-207-,,0,0,0,,Kapıyı aç.Dialogue: 50,0:30:15.17,0:30:16.63,Main-207-,,0,0,0,,Yine mi...?Dialogue: 50,0:30:16.63,0:30:19.71,Main-207-,,0,0,0,,Ne yapıyorsunuz?!Dialogue: 50,0:30:20.59,0:30:22.68,Main-207-,,0,0,0,,Amma salaksınız...Dialogue: 50,0:30:22.68,0:30:24.18,Main-207-,,0,0,0,,Sessizlik!Dialogue: 50,0:30:24.18,0:30:27.47,Main-207-,,0,0,0,,Tüm gücümü kullanamamamın tek nedeni...Dialogue: 50,0:30:27.47,0:30:29.93,Main-207-,,0,0,0,,bunların bana yük olması!Dialogue: 50,0:30:29.93,0:30:35.36,Main-207-,,0,0,0,,Tüm adanın kontrolü bende olursa çok daha iyi iş çıkarırım!Dialogue: 50,0:30:35.36,0:30:38.86,Main-207-,,0,0,0,,Fazla büyük konuşuyorsun!Dialogue: 50,0:30:38.86,0:30:44.11,Main-207-,,0,0,0,,Sana güçlerinin ne kadar işe yaramaz olduğunu göstereceğim!Dialogue: 50,0:30:48.95,0:30:51.25,Main-207-,,0,0,0,,Aydınlanmanın kederli yolunda...Dialogue: 50,0:30:51.75,0:30:53.62,Main-207-,,0,0,0,,Demir Testi!Dialogue: 50,0:30:53.62,0:30:57.17,Main-207-,,0,0,0,,Senin peş para etmez testin bir işe yaramaz!Dialogue: 50,0:30:59.55,0:31:02.59,Main-207-,,0,0,0,,Benim bataklığım en üstün Test'dir!Dialogue: 50,0:31:03.13,0:31:04.80,Main-207-,,0,0,0,,Denemek ister misin?Dialogue: 50,0:31:05.47,0:31:08.85,Main-207-,,0,0,0,,Gedatsu-sama. Yaptığın yorucu olmalı.Dialogue: 50,0:31:08.85,0:31:12.64,Main-207-,,0,0,0,,Kollarını kavuşturmak için, ellerini dirseklerinin altına koyman gerekir.Dialogue: 50,0:31:13.43,0:31:14.27,Main-207-,,0,0,0,,Çok dikkatsizim!Dialogue: 50,0:31:14.27,0:31:17.27,Main-207-,,0,0,0,,Hadi ama! Yeter artık!Dialogue: 50,0:31:17.27,0:31:19.94,Main-207-,,0,0,0,,Tanrı'nın huzurundasınız!Dialogue: 50,0:31:19.94,0:31:21.11,Main-207-,,0,0,0,,Huzurunda mı?Dialogue: 50,0:31:21.94,0:31:25.11,Main-207-,,0,0,0,,Onu göremiyorum!Dialogue: 50,0:31:26.61,0:31:28.20,Main-207-,,0,0,0,,Buradayım!Dialogue: 50,0:31:44.97,0:31:47.64,Main-207-,,0,0,0,,Ben Tanrı'yım.Dialogue: 50,0:31:47.64,0:31:50.26,Main-207-,,0,0,0,,Gördüğünüz gibi tam buradayım.Dialogue: 50,0:31:50.81,0:31:53.22,Main-207-,,0,0,0,,Eğitimlerinize devam etmeniz gerekiyor.Dialogue: 50,0:31:53.22,0:31:55.10,Main-207-,,0,0,0,,Hâlâ çok zayıfsınız.Dialogue: 50,0:31:55.10,0:31:58.60,Main-207-,,0,0,0,,Sonunuz o zavallı Satori gibi mi olsun istiyorsunuz?!Dialogue: 50,0:31:59.36,0:32:01.07,Main-207-,,0,0,0,,O neydi öyle?!Dialogue: 50,0:32:01.52,0:32:04.15,Main-207-,,0,0,0,,Ne çirkin bir şakaydı!Dialogue: 50,0:32:04.15,0:32:08.07,Main-207-,,0,0,0,,Bunu söylemek için mi bizi buraya çağırdın?!Dialogue: 50,0:32:08.07,0:32:10.49,Main-207-,,0,0,0,,Canım sıkıldı.Dialogue: 50,0:32:11.83,0:32:13.29,Main-207-,,0,0,0,,Gelin de oturun.Dialogue: 50,0:32:13.95,0:32:19.13,Main-207-,,0,0,0,,Mavi Deniz'den gelenlere pek dikkat etmediniz sanırım...Dialogue: 50,0:32:19.13,0:32:20.29,Main-207-,,0,0,0,,Enel-sama.Dialogue: 50,0:32:20.29,0:32:21.92,Main-207-,,0,0,0,,Satori'yi kastediyorsan...Dialogue: 50,0:32:21.92,0:32:24.59,Main-207-,,0,0,0,,...o acemiliğinin kurbanı oldu.Dialogue: 50,0:32:24.59,0:32:27.13,Main-207-,,0,0,0,,Dandik Top Testi'nin bir numarası yoktu.Dialogue: 50,0:32:28.13,0:32:31.10,Main-207-,,0,0,0,,Dediğim gibi zayıfsınız, Shura.Dialogue: 50,0:32:33.26,0:32:35.81,Main-207-,,0,0,0,,Onların istedikleri...Dialogue: 50,0:32:35.81,0:32:37.35,Main-207-,,0,0,0,,altın.Dialogue: 50,0:32:37.73,0:32:39.02,Main-207-,,0,0,0,,Altın...Dialogue: 50,0:32:39.35,0:32:42.27,Main-207-,,0,0,0,,Altını nereden biliyorlar?Dialogue: 50,0:32:42.86,0:32:46.57,Main-207-,,0,0,0,,Bu ada aslında Mavi Deniz'in bir parçasıydı.Dialogue: 50,0:32:46.57,0:32:50.16,Main-207-,,0,0,0,,Mavi Deniz'den gelenlerin bunu biliyor olması garip değil.Dialogue: 50,0:32:52.87,0:32:55.54,Main-207-,,0,0,0,,Yarın harekete geçecekler.Dialogue: 50,0:32:55.54,0:32:58.25,Main-207-,,0,0,0,,Ve Shandialılar tekrar saldıracak.Dialogue: 50,0:32:58.25,0:33:02.63,Main-207-,,0,0,0,,Kurallara göre her biriniz Yukarı Bahçe'nin bir bölgesinden sorumlusunuz.Dialogue: 50,0:33:02.63,0:33:06.55,Main-207-,,0,0,0,,Ve birbirinizin bölgesine karışamazsınız.Dialogue: 50,0:33:06.55,0:33:09.84,Main-207-,,0,0,0,,Yarın için bu kuralı kaldırıyorum.Dialogue: 50,0:33:10.64,0:33:13.47,Main-207-,,0,0,0,,Testlerinizi istediğiniz yerde uygulayın.Dialogue: 50,0:33:14.14,0:33:17.60,Main-207-,,0,0,0,,Kuralları görmezden gelip istediğiniz gibi takılın.Dialogue: 50,0:33:19.10,0:33:21.69,Main-207-,,0,0,0,,Aniden bu değişikliğin sebebi nedir?Dialogue: 50,0:33:21.69,0:33:27.28,Main-207-,,0,0,0,,Aslına bakarsanız, Maxim'i neredeyse tamamladım.Dialogue: 50,0:33:27.28,0:33:33.66,Main-207-,,0,0,0,,O yüzden, bu adanın defterini dürelim ve hayalimizdeki dünyaya gidelim!Dialogue: 50,0:33:36.49,0:33:38.96,Main-207-,,0,0,0,,Bakın! Tam dediğim gbii!Dialogue: 50,0:33:38.96,0:33:40.96,Main-207-,,0,0,0,,Burada biri vardı!Dialogue: 50,0:33:40.96,0:33:45.13,Main-207-,,0,0,0,,– Merry tamir edilmiş! – Merry tamir edilmiş!Dialogue: 50,0:33:45.92,0:33:47.71,Main-207-,,0,0,0,,Gördüm!Dialogue: 50,0:33:48.38,0:33:51.38,Main-207-,,0,0,0,,Rüya değilmiş!Dialogue: 50,0:33:53.80,0:33:55.10,Main-207-,,0,0,0,,Ana direk...Dialogue: 50,0:33:55.10,0:33:59.14,Main-207-,,0,0,0,,Tamamen kopmuştu ama tamir edilmiş!Dialogue: 50,0:33:59.14,0:34:02.48,Main-207-,,0,0,0,,Dürüst olmak gerekirse pek iyi iş çıkararmamışlar.Dialogue: 50,0:34:02.48,0:34:04.44,Main-207-,,0,0,0,,Ne iyi insanlar var!Dialogue: 50,0:34:04.94,0:34:09.82,Main-207-,,0,0,0,,Ama kim neden gemimizi tamir etsin ki?Dialogue: 50,0:34:10.49,0:34:15.28,Main-207-,,0,0,0,,Yukarı Bahçe'de biz hariç sadece düşmanlarımız var.Dialogue: 50,0:34:16.20,0:34:20.25,Main-207-,,0,0,0,,Ama artık uçuş modunda değil, Usopp.Dialogue: 50,0:34:20.25,0:34:21.12,Main-207-,,0,0,0,,Evet...Dialogue: 50,0:34:22.50,0:34:25.67,Main-207-,,0,0,0,,Evet. Merak ediyorum da...Dialogue: 50,0:34:29.63,0:34:36.64,Main-207-,,0,0,0,,Gemiyi tamir edenler Merry'nin orijinalini nereden bilebilirler?Dialogue: 50,0:34:36.64,0:34:41.06,Main-207-,,0,0,0,,Kanatları ve kuyruğu olmadığını nasıl bildiler?Dialogue: 50,0:34:43.44,0:34:45.56,Main-207-,,0,0,0,,Nasıl?Dialogue: 50,0:34:50.99,0:34:55.24,Main-207-,,0,0,0,,Söylesene, Merry. Kimdi o?Dialogue: 50,0:35:00.04,0:35:02.33,Main-207-,,0,0,0,,Şimdi. İşte harita burada..Dialogue: 50,0:35:02.33,0:35:06.04,Main-207-,,0,0,0,,Araştırma ekibi güneye doğru giden bu yolu izleyecek.Dialogue: 50,0:35:06.54,0:35:09.75,Main-207-,,0,0,0,,Sağ gözün orada bir tür harabe olmalı.Dialogue: 50,0:35:09.75,0:35:13.05,Main-207-,,0,0,0,,Düşmana karşı tetikte olup altını getirin!Dialogue: 50,0:35:13.05,0:35:14.88,Main-207-,,0,0,0,,Çok kolaymış gibi söylüyorsun.Dialogue: 50,0:35:14.88,0:35:18.89,Main-207-,,0,0,0,,Ne? Durmadan altından bahseden kişi olarak sen gelmeyecek misin?Dialogue: 50,0:35:18.89,0:35:21.18,Main-207-,,0,0,0,,Hayır! Benim için fazla korkunç!Dialogue: 50,0:35:21.18,0:35:24.31,Thoughts-207-,,0,0,0,,Altını istiyor ama zahmete de girmiyor!Dialogue: 50,0:35:24.31,0:35:26.35,Thoughts-207-,,0,0,0,,Nami, çok fena! Çok fena!Dialogue: 50,0:35:26.35,0:35:30.32,Main-207-,,0,0,0,,O sırada biz de adayı Merry ile terkediyor olacağız...Dialogue: 50,0:35:30.32,0:35:32.07,Main-207-,,0,0,0,,ki bu da çok tehlikeli.Dialogue: 50,0:35:32.40,0:35:35.45,Main-207-,,0,0,0,,Vakit kaybetmeden sahildeki o harabeye gideceğiz!Dialogue: 50,0:35:35.45,0:35:37.32,Main-207-,,0,0,0,,Orada buluşalım,Dialogue: 50,0:35:37.32,0:35:39.78,Main-207-,,0,0,0,,ve gökyüzü adasından kaçalım!Dialogue: 50,0:35:40.58,0:35:43.83,Main-207-,,0,0,0,,Köşeyi döneceğiz!Dialogue: 50,0:35:43.83,0:35:45.37,Main-207-,,0,0,0,,Ne istersek alabileceğiz!Dialogue: 50,0:35:45.37,0:35:46.54,Main-207-,,0,0,0,,Yaşasın!Dialogue: 50,0:35:46.54,0:35:48.58,Main-207-,,0,0,0,,İstediğim kadar et yiyebileceğim!Dialogue: 50,0:35:48.58,0:35:51.92,Main-207-,,0,0,0,,Kaçıyoruz, ha? Kulağa hoş geliyor!Dialogue: 50,0:35:52.59,0:35:55.09,Main-207-,,0,0,0,,Bakın! Hava çok güzel!Dialogue: 50,0:35:55.09,0:35:56.59,Main-207-,,0,0,0,,Bulutların üzerindeyiz...Dialogue: 50,0:35:56.59,0:35:59.39,Main-207-,,0,0,0,,Öyleyse doğu sahilinde sağ salim buluşalım!Dialogue: 50,0:35:59.39,0:36:00.35,Main-207-,,0,0,0,,Pekâlâ!Dialogue: 50,0:36:00.35,0:36:01.68,Main-207-,,0,0,0,,Yapalım şunu!Dialogue: 50,0:36:01.68,0:36:02.97,Main-207-,,0,0,0,,Evet!Dialogue: 50,0:36:33.63,0:36:36.97,Thoughts-207-,,0,0,0,,İp Testi'me kimler denk gelecek?Dialogue: 50,0:36:36.97,0:36:38.47,Thoughts-207-,,0,0,0,,Shandialılar mı...Dialogue: 50,0:36:38.47,0:36:40.72,Thoughts-207-,,0,0,0,,yoksa Mavi Deniz insanları mı?Dialogue: 50,0:36:46.02,0:36:53.69,Thoughts-207-,,0,0,0,,Hava, yaklaşan şenlik için mükemmel...Dialogue: 0,0:01:49.76,0:01:56.10,Title-207-,,0,0,0,,VearthDialogue: 1,0:01:49.76,0:01:56.10,Title-207-,,0,0,0,,VearthDialogue: 0,0:11:49.10,0:11:51.94,Captions-207-,,0,0,0,,Rahipler mantra kullanarak saldırılarımızı öngörebiliyor!Dialogue: 0,0:11:49.10,0:11:51.94,Captions-207-,,0,0,0,,Rahipler mantra kullanarak saldırılarımızı öngörebiliyor!Dialogue: 0,0:11:56.20,0:12:01.12,Captions-207-,,0,0,0,,Kuş ağzından alev atıyor!Dialogue: 0,0:11:56.20,0:12:01.12,Captions-207-,,0,0,0,,Mızrak yakıyor!Dialogue: 0,0:11:56.20,0:12:00.41,Captions-207-,,0,0,0,,Jaya'nın battı sandığımız kısmı aslında gökyüzündeymiş!Dialogue: 0,0:12:00.41,0:12:00.49,Captions-207-,,0,0,0,,Jaya'nın battı sandığımız kısmı aslında gökyüzündeymiş!Dialogue: 0,0:12:00.49,0:12:00.57,Captions-207-,,0,0,0,,Jaya'nın battı sandığımız kısmı aslında gökyüzündeymiş!Dialogue: 0,0:12:00.57,0:12:00.62,Captions-207-,,0,0,0,,Jaya'nın battı sandığımız kısmı aslında gökyüzündeymiş!Dialogue: 0,0:12:00.62,0:12:00.66,Captions-207-,,0,0,0,,Jaya'nın battı sandığımız kısmı aslında gökyüzündeymiş!Dialogue: 0,0:12:00.66,0:12:00.70,Captions-207-,,0,0,0,,Jaya'nın battı sandığımız kısmı aslında gökyüzündeymiş!Dialogue: 0,0:12:00.70,0:12:00.74,Captions-207-,,0,0,0,,Jaya'nın battı sandığımız kısmı aslında gökyüzündeymiş!Dialogue: 0,0:12:00.74,0:12:00.78,Captions-207-,,0,0,0,,Jaya'nın battı sandığımız kısmı aslında gökyüzündeymiş!Dialogue: 0,0:12:00.78,0:12:01.12,Captions-207-,,0,0,0,,Jaya'nın battı sandığımız kısmı aslında gökyüzündeymiş!Dialogue: 0,0:11:56.20,0:12:00.41,Captions-207-,,0,0,0,,Jaya'nın battı sandığımız kısmı aslında gökyüzündeymiş!Dialogue: 0,0:12:00.41,0:12:00.49,Captions-207-,,0,0,0,,Jaya'nın battı sandığımız kısmı aslında gökyüzündeymiş!Dialogue: 0,0:12:00.49,0:12:00.57,Captions-207-,,0,0,0,,Jaya'nın battı sandığımız kısmı aslında gökyüzündeymiş!Dialogue: 0,0:12:00.57,0:12:00.62,Captions-207-,,0,0,0,,Jay