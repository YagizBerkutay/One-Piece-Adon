,23,1Style: Translation,Duality,68,&H00B95DıD,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,2.25,0,1,4.5,0,2,23,23,23,1Style: Roger Monologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:49.71,0:01:59.71,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 50,0:01:54.76,0:01:58.72,Main-207-,,0,0,0,,Nerede kaldı bu?! Sabah oldu bile!Dialogue: 50,0:01:59.43,0:02:04.48,Main-207-,,0,0,0,,Tam 46 dakika gecikti! Akıntıyı kaçıracağız!Dialogue: 50,0:02:04.48,0:02:08.73,Main-207-,,0,0,0,,O kadar altını da taşıması lazım, kim bilir ne kadar gecikecek!Dialogue: 50,0:02:08.73,0:02:11.86,Main-207-,,0,0,0,,İmkânı yok onu düşünmemiştir bile!Dialogue: 50,0:02:11.86,0:02:15.24,Main-207-,,0,0,0,,Hayır, muhtemelen zamanı hiç planlamadı.Dialogue: 50,0:02:15.24,0:02:16.70,Main-207-,,0,0,0,,Evet, kesin öyle.Dialogue: 50,0:02:16.70,0:02:19.45,Main-207-,,0,0,0,,Sence Luffy yenildi mi?Dialogue: 50,0:02:19.83,0:02:21.50,Main-207-,,0,0,0,,Bellamy denen herife mi?!Dialogue: 50,0:02:21.50,0:02:24.42,Main-207-,,0,0,0,,Eğer yenildiyse, gecikmesi onun son problemi olacak!Dialogue: 50,0:02:24.92,0:02:26.92,Main-207-,,0,0,0,,Derdin ne senin be?Dialogue: 50,0:02:30.67,0:02:33.68,Main-207-,,0,0,0,,Hey!Dialogue: 50,0:02:37.64,0:02:40.47,Main-207-,,0,0,0,,İşte geldi! Şükürler olsun! Döndü!Dialogue: 50,0:02:40.47,0:02:42.35,Main-207-,,0,0,0,,Başardım!Dialogue: 50,0:02:42.35,0:02:45.73,Main-207-,,0,0,0,,Acele et, Luffy! Programımızın gerisindeyiz!Dialogue: 50,0:02:45.73,0:02:47.27,Main-207-,,0,0,0,,Baksanıza!Dialogue: 50,0:02:47.27,0:02:51.32,Main-207-,,0,0,0,,Herkül böceği! Bulmam uzun sürdü!Dialogue: 50,0:02:51.32,0:02:52.69,Main-207-,,0,0,0,,Böcek mi...Dialogue: 50,0:02:52.69,0:02:54.07,Main-207-,,0,0,0,,...arıyordun?!Dialogue: 50,0:03:02.66,0:03:05.04,Main-207-,,0,0,0,,Oha! Harika!Dialogue: 50,0:03:05.04,0:03:07.83,Main-207-,,0,0,0,,Going Merry: Uçuş Versiyonu!Dialogue: 50,0:03:07.83,0:03:09.71,Main-207-,,0,0,0,,Cidden uçacak gibi!Dialogue: 50,0:03:09.71,0:03:13.01,Main-207-,,0,0,0,,Değil mi?! Onlara teşekkür et!Dialogue: 50,0:03:17.72,0:03:18.72,Main-207-,,0,0,0,,Görmezden gelin.Dialogue: 50,0:03:18.72,0:03:21.47,Main-207-,,0,0,0,,Bakınca bile tadım kaçıyor...Dialogue: 50,0:03:21.47,0:03:22.60,Main-207-,,0,0,0,,Benim de.Dialogue: 50,0:03:23.22,0:03:26.94,Main-207-,,0,0,0,,Güvercin bile tavuktan iyi bir seçim olurdu...Dialogue: 50,0:03:26.94,0:03:29.73,Main-207-,,0,0,0,,Sorun sence o mu?! Amma aptalsın!Dialogue: 50,0:03:29.73,0:03:33.40,Main-207-,,0,0,0,,Pekâlâ! Hadi yelken açalım! Herkes hazır mı?!Dialogue: 50,0:03:33.40,0:03:34.74,Main-207-,,0,0,0,,– Hay hay, efendim! – Hay hay, efendim!Dialogue: 50,0:03:40.45,0:03:42.95,Main-207-,,0,0,0,,Gemiye bin! Vakit kalmadı!Dialogue: 50,0:03:42.95,0:03:47.04,Main-207-,,0,0,0,,Yoksa gökyüzüne olan tek biletini yakmak mı istiyorsun, aptal?Dialogue: 50,0:03:47.46,0:03:49.46,Main-207-,,0,0,0,,Pekâlâ! Gemi için teşekkürler!Dialogue: 50,0:03:53.09,0:03:55.55,Main-207-,,0,0,0,,Asıl onlara teşekkür et.Dialogue: 50,0:03:56.26,0:03:58.72,Main-207-,,0,0,0,,Evet! Teşekkürler!Dialogue: 50,0:03:58.72,0:04:01.22,Main-207-,,0,0,0,,Herkül böceğim sizin olsun!Dialogue: 50,0:04:01.64,0:04:05.73,Main-207-,,0,0,0,,– Gerçekten mi?! Bizim mi?! – Gerçekten mi?!Dialogue: 50,0:04:05.73,0:04:08.10,Main-207-,,0,0,0,,– Ne kadar iyi biri! – Ne kadar iyi biri!Dialogue: 50,0:04:08.10,0:04:11.31,Main-207-,,0,0,0,,Neyse, artık gitmeliyiz! Çok geç olmadan gemiye bin!Dialogue: 50,0:04:11.31,0:04:14.19,Main-207-,,0,0,0,,Biz önden gideceğiz, bizi takip edin!Dialogue: 50,0:04:14.57,0:04:16.07,Main-207-,,0,0,0,,Luffy! Acele et!Dialogue: 50,0:04:16.07,0:04:17.45,Main-207-,,0,0,0,,Tamam!Dialogue: 50,0:04:23.66,0:04:28.12,Flashbacks-207-,,0,0,0,,O "Altın Şehir" sadece Noland'ın hayal ürünüydü!Dialogue: 50,0:04:29.75,0:04:31.50,Main-207-,,0,0,0,,Saruyama İttifakı!Dialogue: 50,0:04:34.75,0:04:36.46,Main-207-,,0,0,0,,Bu işi berbat etmeyin!Dialogue: 50,0:04:36.96,0:04:41.72,Main-207-,,0,0,0,,Bu tayfa için elinizden gelen her şeyi yapın!Dialogue: 50,0:04:41.72,0:04:43.89,Main-207-,,0,0,0,,– Evet! – Evet!Dialogue: 50,0:04:46.39,0:04:47.89,Main-207-,,0,0,0,,Pekâlâ! Gidelim!Dialogue: 50,0:04:51.77,0:04:53.44,Main-207-,,0,0,0,,Millet, yelken açma zamanı!Dialogue: 50,0:04:53.44,0:04:54.40,Main-207-,,0,0,0,,İşte bu!Dialogue: 50,0:04:54.40,0:04:56.23,Main-207-,,0,0,0,,Başüstüne, Nami-tan!Dialogue: 50,0:05:08.41,0:05:11.92,Main-207-,,0,0,0,,Burada yollarımız ayrılıyor, çocuk!Dialogue: 50,0:05:12.92,0:05:13.96,Main-207-,,0,0,0,,Evet!Dialogue: 50,0:05:14.71,0:05:18.92,Main-207-,,0,0,0,,Kesin olarak bildiğim bir şey var.Dialogue: 50,0:05:18.30,0:05:18.92,Secondary-207-,,0,0,0,,Ha?Dialogue: 50,0:05:19.55,0:05:25.89,Main-207-,,0,0,0,,Hiç kimse Altın Şehir'in veya gökyüzü adasının varlığını kanıtlayamadı.Dialogue: 50,0:05:25.89,0:05:26.89,Main-207-,,0,0,0,,Evet!Dialogue: 50,0:05:28.18,0:05:33.94,Main-207-,,0,0,0,,İnsanlar bunlara gülüp saçma desin, benim için sorun değil.Dialogue: 50,0:05:33.94,0:05:36.61,Main-207-,,0,0,0,,İşte romantizm budur!Dialogue: 50,0:05:36.61,0:05:38.07,Main-207-,,0,0,0,,Romantizm...Dialogue: 50,0:05:40.44,0:05:41.70,Main-207-,,0,0,0,,Aynen öyle!Dialogue: 50,0:05:45.70,0:05:48.83,Main-207-,,0,0,0,,Altın için teşekkürler.Dialogue: 50,0:05:50.20,0:05:53.54,Main-207-,,0,0,0,,Gökyüzünden düşmeyin, tamam mı?!Dialogue: 50,0:05:56.00,0:05:57.92,Main-207-,,0,0,0,,Görüşürüz, kestane kafa!Dialogue: 50,0:05:57.92,0:06:00.46,Main-207-,,0,0,0,,Her şey için teşekkürler, Cricket-san!Dialogue: 50,0:06:00.46,0:06:05.26,Main-207-,,0,0,0,,Bayım, eminim Altın Şehir gerçektir!Dialogue: 50,0:06:05.26,0:06:08.43,Main-207-,,0,0,0,,Kestane kafa! Kendini çok zorlama!Dialogue: 50,0:06:08.43,0:06:10.73,Main-207-,,0,0,0,,Kendi işine bak!Dialogue: 50,0:06:18.19,0:06:20.40,Main-207-,,0,0,0,,Sabah oldu bile!Dialogue: 50,0:06:20.82,0:06:23.20,Main-207-,,0,0,0,,Pekâlâ? Bir şey görüyor musun?Dialogue: 50,0:06:23.70,0:06:26.57,Main-207-,,0,0,0,,Henüz kıyıyı bile göremiyorum!Dialogue: 50,0:06:26.57,0:06:29.66,Main-207-,,0,0,0,,Gerçekten gökyüzü adasına mı gidiyorlar?Dialogue: 50,0:06:30.16,0:06:32.00,Main-207-,,0,0,0,,Evet, öyle dediler.Dialogue: 50,0:06:32.00,0:06:36.46,Main-207-,,0,0,0,,Onları takip etmek zor olacak, o yüzden şimdiden işlerini bitirelim.Dialogue: 50,0:06:37.08,0:06:40.50,Main-207-,,0,0,0,,Dinleyin! Saat 7!Dialogue: 50,0:06:40.50,0:06:45.05,Main-207-,,0,0,0,,Saat 11'de hedefimize varmış olacağız!Dialogue: 50,0:06:45.05,0:06:49.51,Main-207-,,0,0,0,,Patronun dediği gibi Yukarı Fırlatan Akıntı'nın yeri her seferinde değişiyor,Dialogue: 50,0:06:49.51,0:06:56.52,Main-207-,,0,0,0,,o yüzden alana erken varıp yerini tespit etmemiz gerekiyor!Dialogue: 50,0:06:57.02,0:06:58.77,Main-207-,,0,0,0,,Bakın! Bakın!Dialogue: 50,0:06:58.77,0:07:01.98,Main-207-,,0,0,0,,Programın biraz gerisindeyiz, o yüzden...Dialogue: 50,0:07:01.98,0:07:05.61,Main-207-,,0,0,0,,Hey! Beni dinliyor musunuz?Dialogue: 50,0:07:05.61,0:07:07.82,Main-207-,,0,0,0,,Bakın! İleri baktı!Dialogue: 50,0:07:08.99,0:07:12.20,Main-207-,,0,0,0,,Ne garip kuşlar var!Dialogue: 50,0:07:12.20,0:07:17.33,Main-207-,,0,0,0,,Doğruymuş! Sadece güneye bakabiliyor! Bu eleman pusula gibi! Çok komik!Dialogue: 50,0:07:21.59,0:07:22.67,Main-207-,,0,0,0,,Ne dedi?Dialogue: 50,0:07:23.17,0:07:26.59,Main-207-,,0,0,0,,"Farklı bir yöne bakıp işinizi berbat edeceğim" dedi.Dialogue: 50,0:07:28.26,0:07:29.64,Main-207-,,0,0,0,,Denesene!Dialogue: 50,0:07:32.60,0:07:34.98,Main-207-,,0,0,0,,Ah! Kuzeye baktı!Dialogue: 50,0:07:43.07,0:07:45.36,Main-207-,,0,0,0,,Güneye bakmadan içi rahat etmiyor!Dialogue: 50,0:07:45.36,0:07:50.53,Main-207-,,0,0,0,,Hey, çocuklar! Büyük patronu kızdırmayın!Dialogue: 50,0:07:51.28,0:07:57.00,Main-207-,,0,0,0,,Boş verin onları! Onlarla uğraşırsak işimize odaklanamayız!Dialogue: 50,0:07:57.33,0:07:58.96,Main-207-,,0,0,0,,Ha? Sorun nedir?Dialogue: 50,0:08:00.13,0:08:03.25,Main-207-,,0,0,0,,Kaygılanmanın faydası yok!Dialogue: 50,0:08:03.96,0:08:05.67,Main-207-,,0,0,0,,Rahatlayın biraz!Dialogue: 50,0:08:05.67,0:08:07.93,Main-207-,,0,0,0,,Peki kimin yüzünden programın gerisindeyiz?Dialogue: 50,0:08:08.43,0:08:13.51,Main-207-,,0,0,0,,O haklı! Gergin olmanın kimseye faydası yok!Dialogue: 50,0:08:13.51,0:08:18.52,Main-207-,,0,0,0,,Anladım! Pekâlâ! Tam yol ileri ama rahat bir şekilde!Dialogue: 50,0:08:21.36,0:08:23.90,Main-207-,,0,0,0,,Hava ne güzel!Dialogue: 50,0:08:27.03,0:08:28.49,Main-207-,,0,0,0,,Bu işi becerebilecek miyiz?Dialogue: 50,0:08:28.90,0:08:31.70,Main-207-,,0,0,0,,Patron! Kötü haberlerim var!Dialogue: 50,0:08:30.79,0:08:31.70,Secondary-207-,,0,0,0,,Sorun nedir?!Dialogue: 50,0:08:31.70,0:08:35.16,Main-207-,,0,0,0,,Güneybatı yönünden gece yaklaşıyor! İmparator kümülüs!Dialogue: 50,0:08:35.16,0:08:37.58,Main-207-,,0,0,0,,Gerçekten mi?! Saat kaç?!Dialogue: 50,0:08:37.58,0:08:40.75,Main-207-,,0,0,0,,Saat 10! Beklediğimizden çok daha erken bu!Dialogue: 50,0:08:40.75,0:08:43.13,Main-207-,,0,0,0,,Bu hiç iyi değil... Başarabilecek miyiz, Shojo?Dialogue: 50,0:08:43.13,0:08:45.70,Main-207-,,0,0,0,,Utan Dalgıçları! Hemen denize!Dialogue: 50,0:08:45.70,0:08:47.17,Main-207-,,0,0,0,,Akıntıyı tespit edin!Dialogue: 50,0:08:50.30,0:08:52.01,Main-207-,,0,0,0,,İmparator kümülüs!Dialogue: 50,0:08:52.80,0:08:54.39,Main-207-,,0,0,0,,Ne oluyor?!Dialogue: 50,0:08:55.51,0:09:00.60,Main-207-,,0,0,0,,Beklediğimizden daha erken belirdi. Ama daha akıntının yerini bilmiyoruz!Dialogue: 50,0:09:08.32,0:09:12.70,Main-207-,,0,0,0,,Yankı doğrulandı! Saat 12 yönünde, dev bir akıntı bulundu!Dialogue: 50,0:09:12.70,0:09:16.66,Main-207-,,0,0,0,,Saat 9 yönünde, dev bir yaratık belirlendi! Muhtemelen deniz kralı!Dialogue: 50,0:09:17.37,0:09:20.62,Main-207-,,0,0,0,,Saat 10 yönünde, akıntıya ters hareket eden dalga belirlendi!Dialogue: 50,0:09:20.62,0:09:22.67,Main-207-,,0,0,0,,Muhtemelen dev bir girdap!Dialogue: 50,0:09:22.67,0:09:26.13,Main-207-,,0,0,0,,İşte bu! Pruvayı saat 10 yönüne çevirin!Dialogue: 50,0:09:26.13,0:09:29.92,Main-207-,,0,0,0,,Patlama olacağının belirtisi bu! Girdabı yakalayın! Geri çekilmeyin!Dialogue: 50,0:09:34.72,0:09:35.85,Main-207-,,0,0,0,,Ne olu...?!Dialogue: 50,0:09:35.85,0:09:39.10,Main-207-,,0,0,0,,Dalgalar aniden yükseldi!Dialogue: 50,0:09:37.54,0:09:39.10,Secondary-207-,,0,0,0,,Alabora olacağız!Dialogue: 50,0:09:41.06,0:09:43.94,Main-207-,,0,0,0,,Patlama öncesi depremi bu! Hazır olun!Dialogue: 50,0:09:43.94,0:09:45.56,Main-207-,,0,0,0,,P-Patlama mı?!Dialogue: 50,0:09:46.07,0:09:47.02,Main-207-,,0,0,0,,Rotacı Hanım!Dialogue: 50,0:09:47.69,0:09:49.24,Main-207-,,0,0,0,,Seyir Pusulası ne diyor!Dialogue: 50,0:09:52.07,0:09:53.84,Main-207-,,0,0,0,,O bulutu gösteriyor!Dialogue: 50,0:09:54.84,0:09:57.49,Main-207-,,0,0,0,,Gökyüzü adası tam üstümüzde mi?!Dialogue: 50,0:09:58.20,0:09:59.79,Main-207-,,0,0,0,,Rüzgâr da tam istediğimiz yönde!Dialogue: 50,0:09:59.79,0:10:02.50,Main-207-,,0,0,0,,İmparator kümülüs girdaba doğru geliyor!Dialogue: 50,0:10:02.50,0:10:05.92,Main-207-,,0,0,0,,Bekleyin! Ne girdabı? Nerede gördünüz girdabı?Dialogue: 50,0:10:06.59,0:10:09.76,Main-207-,,0,0,0,,Görünüşe göre hedefi tam on ikiden vurduk kardeşim!Dialogue: 50,0:10:09.76,0:10:13.18,Main-207-,,0,0,0,,Evet! Patlama da yeterince büyük olacak gibi görünüyor!Dialogue: 50,0:10:13.18,0:10:14.55,Main-207-,,0,0,0,,Yani başaracak mıyız?!Dialogue: 50,0:10:14.55,0:10:15.97,Main-207-,,0,0,0,,Elbette!Dialogue: 50,0:10:18.06,0:10:18.85,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:10:18.85,0:10:21.14,Main-207-,,0,0,0,,Sizi girdabın içine doğru çekeceğiz!Dialogue: 50,0:10:21.64,0:10:23.56,Main-207-,,0,0,0,,Sonra ne yapacağız?!Dialogue: 50,0:10:23.56,0:10:27.94,Main-207-,,0,0,0,,Akıntıda ilerleyin! Girdabın merkezine gidebilirseniz iyi olacaksınız!Dialogue: 50,0:10:29.40,0:10:31.40,Main-207-,,0,0,0,,Bu devasa girdabın merkezine mi?!Dialogue: 50,0:10:36.03,0:10:38.37,Main-207-,,0,0,0,,Kimse bununla ilgili bir şey söylemedi!Dialogue: 50,0:10:38.78,0:10:41.87,Main-207-,,0,0,0,,Sorun değil, Nami-san! Seni ve Robin-chan'ı koruyacağım!Dialogue: 50,0:10:42.58,0:10:44.54,Main-207-,,0,0,0,,Böyle bir girdap ilk defa görüyorum...Dialogue: 50,0:10:47.42,0:10:50.88,Main-207-,,0,0,0,,Lanet olsun! Bu hiç iyi değil! Geri dönelim! Bırakın geri döneyim!Dialogue: 50,0:10:50.88,0:10:54.18,Main-207-,,0,0,0,,Koyver gitsin, Usopp! Artık geri dönüş yok. Girdaba girdik bile.Dialogue: 50,0:10:54.59,0:10:56.68,Main-207-,,0,0,0,,Gidelim! Gökyüzü adasına!Dialogue: 50,0:11:19.33,0:11:20.95,Main-207-,,0,0,0,,Pekâlâ çocuklar!Dialogue: 50,0:11:20.95,0:11:24.96,Main-207-,,0,0,0,,Gerisi sizde! Bol şans!Dialogue: 50,0:11:24.96,0:11:28.08,Main-207-,,0,0,0,,Tamam! Yardımınız için teşekkürler!Dialogue: 50,0:11:27.33,0:11:28.08,Secondary-207-,,0,0,0,,Bekleyin!Dialogue: 50,0:11:28.58,0:11:32.34,Main-207-,,0,0,0,,Beni de alın! Korkudan öleceğim!Dialogue: 50,0:11:32.34,0:11:34.26,Main-207-,,0,0,0,,Bırakın da geri döneyim!Dialogue: 50,0:11:34.26,0:11:36.09,Main-207-,,0,0,0,,Hepimiz öleceğiz!Dialogue: 50,0:11:36.09,0:11:39.51,Main-207-,,0,0,0,,Kimse bana dev girdaptan bahsetmedi! Bizi kandırdılar!Dialogue: 50,0:11:39.51,0:11:41.06,Main-207-,,0,0,0,,Gece oldu!Dialogue: 50,0:11:41.06,0:11:44.56,Main-207-,,0,0,0,,Girdap bizi içine çekiyor!Dialogue: 50,0:11:44.56,0:11:48.06,Main-207-,,0,0,0,,Geri dönelim, Luffy! Hâlâ vaktimiz var!Dialogue: 50,0:11:48.06,0:11:51.86,Main-207-,,0,0,0,,Anlamıyor musun?! Bu girdap bile bizi öldürmeye yeter!Dialogue: 50,0:11:51.86,0:11:53.69,Main-207-,,0,0,0,,Gökyüzü adası, hayal içinde hayal!Dialogue: 50,0:11:53.69,0:11:56.20,Main-207-,,0,0,0,,Hayal içinde hayal mi? Cidden öyle mi düşünüyorsun?Dialogue: 50,0:11:56.20,0:11:59.53,Main-207-,,0,0,0,,Evet, Luffy! Bunu gerçekten başarabileceğimizi sanmıyorum!Dialogue: 50,0:11:59.91,0:12:01.91,Main-207-,,0,0,0,,Hayal içinde hayal bir ada!Dialogue: 50,0:12:01.91,0:12:05.79,Main-207-,,0,0,0,,Böyle bir macerayı kaçırırsam kendimi asla affetmem!Dialogue: 50,0:12:06.50,0:12:09.42,Main-207-,,0,0,0,,– Ç-Çok mutlu görünüyor... – Ç-Çok mutlu görünüyor...Dialogue: 50,0:12:13.42,0:12:16.22,Main-207-,,0,0,0,,Hey! Siz orada sızlanırken...Dialogue: 50,0:12:16.22,0:12:17.38,Main-207-,,0,0,0,,Ha? Ne?Dialogue: 50,0:12:20.84,0:12:22.64,Main-207-,,0,0,0,,İçine çekiliyoruz!Dialogue: 50,0:12:25.06,0:12:28.73,Main-207-,,0,0,0,,Şimdi, Nami-san! Kollarımda teselli bul!Dialogue: 50,0:12:30.65,0:12:31.79,Main-207-,,0,0,0,,İçine düşüyoruz!Dialogue: 50,0:12:36.36,0:12:38.82,Main-207-,,0,0,0,,Ne?! Yok mu oldu?! Nasıl?!Dialogue: 50,0:12:38.82,0:12:39.91,Main-207-,,0,0,0,,Ne oldu?!Dialogue: 50,0:12:39.91,0:12:44.83,Main-207-,,0,0,0,,O dev girdap... Ne oluyor böyle?!Dialogue: 50,0:12:50.71,0:12:54.34,Main-207-,,0,0,0,,Hayır! Çoktan başladı!Dialogue: 50,0:12:54.34,0:12:55.46,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:12:56.13,0:12:58.80,Main-207-,,0,0,0,,Girdap kayboldu!Dialogue: 50,0:13:00.38,0:13:03.30,Main-207-,,0,0,0,,Y-Yani...Dialogue: 50,0:13:03.30,0:13:05.81,Main-207-,,0,0,0,,Durun!Dialogue: 50,0:13:08.85,0:13:09.85,Main-207-,,0,0,0,,Hey, Zoro!Dialogue: 50,0:13:10.48,0:13:11.35,Main-207-,,0,0,0,,Bak!Dialogue: 50,0:13:19.15,0:13:23.62,Main-207-,,0,0,0,,Seni yakaladık, Hasır Şapkalı Luffy!Dialogue: 50,0:13:24.20,0:13:26.20,Main-207-,,0,0,0,,Mock Şehri'ndeki herif...!Dialogue: 50,0:13:28.41,0:13:29.33,Main-207-,,0,0,0,,Kim o?!Dialogue: 50,0:13:29.33,0:13:34.29,Main-207-,,0,0,0,,100 milyonluk kelleni almaya geldim! Hazır ol!Dialogue: 50,0:13:39.59,0:13:42.34,Main-207-,,0,0,0,,Hey, kim bunlar? Arkadaşlarınız mı?Dialogue: 50,0:13:43.18,0:13:44.97,Main-207-,,0,0,0,,Ha, bilmiyorum.Dialogue: 50,0:13:48.93,0:13:50.77,Main-207-,,0,0,0,,Burası niye karanlık?Dialogue: 50,0:13:50.77,0:13:53.90,Main-207-,,0,0,0,,Ödülüm mü? Ne 100 milyonu?Dialogue: 50,0:13:53.90,0:13:56.27,Main-207-,,0,0,0,,Demek bilmiyorsun!Dialogue: 50,0:13:56.90,0:14:01.65,Main-207-,,0,0,0,,Kellene 100 milyon beli ödül biçilmiş!Dialogue: 50,0:14:01.65,0:14:05.95,Main-207-,,0,0,0,,Ve sen Korsan Avcısı Zoro! Sen de 60 milyon değerindesin!Dialogue: 50,0:14:05.95,0:14:08.95,Main-207-,,0,0,0,,Bu doğru! Onlar yeni aranıyor posterleri.Dialogue: 50,0:14:08.95,0:14:12.08,Main-207-,,0,0,0,,Zoro! Sağlam ödülün var artık ha!Dialogue: 50,0:14:12.08,0:14:16.29,Main-207-,,0,0,0,,Ne?! Dur bakalım! Ya ben?! Benim de var değil mi?!Dialogue: 50,0:14:16.29,0:14:17.88,Main-207-,,0,0,0,,Ah... senin yok.Dialogue: 50,0:14:17.88,0:14:19.38,Main-207-,,0,0,0,,Dikkatli bak!Dialogue: 50,0:14:20.01,0:14:20.84,Main-207-,,0,0,0,,Yok.Dialogue: 50,0:14:23.09,0:14:27.01,Main-207-,,0,0,0,,Mantıklı. Alabasta'dan sonra ödüllerinizin böyle fırlaması normal.Dialogue: 50,0:14:27.01,0:14:28.68,Main-207-,,0,0,0,,Ama 100 milyon...!Dialogue: 50,0:14:30.27,0:14:31.77,Main-207-,,0,0,0,,100 milyon!Dialogue: 50,0:14:31.77,0:14:34.40,Main-207-,,0,0,0,,Duydunuz mu?! 100 milyon değerindeyim!Dialogue: 50,0:14:34.40,0:14:36.73,Main-207-,,0,0,0,,60 milyon demek, baya hayal kırıklığı!Dialogue: 50,0:14:36.73,0:14:38.69,Main-207-,,0,0,0,,Bu kutlanacak şey mi?!Dialogue: 50,0:14:39.90,0:14:43.20,Main-207-,,0,0,0,,Hey, çocuklar! Dikkatiniz dağılmasın!Dialogue: 50,0:14:47.07,0:14:51.16,Main-207-,,0,0,0,,Geliyor! Yukarı Fırlatan Akıntı!Dialogue: 50,0:14:51.70,0:14:54.12,Main-207-,,0,0,0,,Hazır olun!Dialogue: 50,0:14:56.58,0:14:57.46,Main-207-,,0,0,0,,Ne olu...?Dialogue: 50,0:14:58.04,0:15:01.00,Main-207-,,0,0,0,,Herkes gemiye tutunsun veya içeri girsin!Dialogue: 50,0:15:01.00,0:15:07.09,Main-207-,,0,0,0,,Gemi yükseliyor!Dialogue: 50,0:15:44.34,0:15:47.43,Main-207-,,0,0,0,,Eyvah! Gemi alabora olacak!Dialogue: 50,0:15:49.89,0:15:51.85,Main-207-,,0,0,0,,Herkes tutunsun!Dialogue: 50,0:15:51.85,0:15:53.60,Main-207-,,0,0,0,,Sakın düşmeyin!Dialogue: 50,0:15:57.27,0:16:00.44,Main-207-,,0,0,0,,– Gidin! Gökyüzü adasına...! – Gidin! Gökyüzü adasına...!Dialogue: 50,0:16:02.40,0:16:03.86,Main-207-,,0,0,0,,Ne oluyor lan böyle?!Dialogue: 50,0:16:03.86,0:16:07.32,Main-207-,,0,0,0,,Gemi akıntının üzerinde düşey olarak ilerliyor!Dialogue: 50,0:16:07.32,0:16:08.36,Main-207-,,0,0,0,,Çok eğlenceli!Dialogue: 50,0:16:08.36,0:16:10.37,Main-207-,,0,0,0,,Bu nasıl mümkün olabilir?!Dialogue: 50,0:16:12.37,0:16:13.33,Main-207-,,0,0,0,,Rüzgâr mı?!Dialogue: 50,0:16:13.91,0:16:20.33,Main-207-,,0,0,0,,Pekâlâ! şimdi gökyüzüne gidebiliriz! Hadi, Merry!Dialogue: 50,0:16:22.29,0:16:25.76,Main-207-,,0,0,0,,Dur bakalım! Sanırım o kadar kolay olmayacak!Dialogue: 50,0:16:25.76,0:16:27.05,Main-207-,,0,0,0,,N-Ne oldu?!Dialogue: 50,0:16:27.05,0:16:29.22,Main-207-,,0,0,0,,Ha? Bir şey mi atladık?Dialogue: 50,0:16:29.22,0:16:31.47,Main-207-,,0,0,0,,Gemi sudan ayırlıyor!Dialogue: 50,0:16:31.47,0:16:32.55,Main-207-,,0,0,0,,Ha?!Dialogue: 50,0:16:32.55,0:16:35.56,Main-207-,,0,0,0,,Böyle giderse, ölümümüze doğru düşeceğiz!Dialogue: 50,0:16:35.56,0:16:41.31,Main-207-,,0,0,0,,A-A-A-Ama ne yapmamızı istiyorsun?! Z-Z-Z-Zar zor tutunuyoruz zaten!Dialogue: 50,0:16:41.31,0:16:43.27,Main-207-,,0,0,0,,Ha?! O ne?!Dialogue: 50,0:16:44.32,0:16:45.40,Main-207-,,0,0,0,,Deniz kralı!Dialogue: 50,0:16:45.40,0:16:47.61,Main-207-,,0,0,0,,Girdap tarafından yutulmuştu!Dialogue: 50,0:16:51.91,0:16:55.54,Main-207-,,0,0,0,,Gördünüz mü?! Aynı şey her an bizim başımıza da gelebilir!Dialogue: 50,0:16:55.54,0:17:01.04,Main-207-,,0,0,0,,Öyle diyorsun ama patlamanın etkisine kapılmış durumdayız!Dialogue: 50,0:17:01.04,0:17:02.50,Main-207-,,0,0,0,,Ne yapabiliriz ki?!Dialogue: 50,0:17:02.50,0:17:05.46,Main-207-,,0,0,0,,Doğal afet bu sonuçta!Dialogue: 50,0:17:07.84,0:17:09.80,Main-207-,,0,0,0,,Bir şeyler düşüyor!Dialogue: 50,0:17:10.34,0:17:13.47,Main-207-,,0,0,0,,Yukarı Fırlatan Akıntı'nın kurbanları!Dialogue: 50,0:17:13.47,0:17:18.52,Main-207-,,0,0,0,,İşimiz bitti! Denize çakılıp öleceğiz!Dialogue: 50,0:17:20.98,0:17:22.81,Main-207-,,0,0,0,,Yelkenleri açın! Hemen şimdi!Dialogue: 50,0:17:23.48,0:17:27.94,Main-207-,,0,0,0,,Bu önünde sonunda bir deniz!  Sudan bir kule değil! Yükselen bir akıntı!Dialogue: 50,0:17:27.94,0:17:30.24,Main-207-,,0,0,0,,Ve altımızdan esen rüzgâr da...Dialogue: 50,0:17:30.24,0:17:33.53,Main-207-,,0,0,0,,jeotermal ısı ve buhar patlaması sonucu yükselen hava akımıdır!Dialogue: 50,0:17:34.07,0:17:36.83,Main-207-,,0,0,0,,Eğer deniz ve rüzgâr varsa bu işi halledebilirim!Dialogue: 50,0:17:37.20,0:17:39.25,Main-207-,,0,0,0,,Bu geminin rotacısı kim?!Dialogue: 50,0:17:41.04,0:17:43.25,Main-207-,,0,0,0,,Sensin Nami-san!Dialogue: 50,0:17:43.25,0:17:46.38,Main-207-,,0,0,0,,Pekâlâ! Herkes Nami-san'ın dediğini yapsın!Dialogue: 50,0:17:46.38,0:17:47.71,Main-207-,,0,0,0,,– Hay hay! – Hay hay!Dialogue: 50,0:17:47.71,0:17:51.68,Main-207-,,0,0,0,,Rüzgârı sancaktan alıp dümeni iskeleye kırın ve akıntıyla ilerleyin!Dialogue: 50,0:17:51.68,0:17:52.38,Main-207-,,0,0,0,,– Başüstüne! – Başüstüne!Dialogue: 50,0:17:54.39,0:17:57.35,Main-207-,,0,0,0,,Hayır, olamaz! Gemi sudan ayrılıyor!Dialogue: 50,0:17:57.76,0:18:00.81,Main-207-,,0,0,0,,Düşeceğiz! Düşeceğiz, Nami! Bir şey yap, Nami!Dialogue: 50,0:18:00.81,0:18:02.77,Main-207-,,0,0,0,,Hayır, başaracağız!Dialogue: 50,0:18:06.48,0:18:08.15,Main-207-,,0,0,0,,Uçuyoruz!Dialogue: 50,0:18:10.36,0:18:13.07,Main-207-,,0,0,0,,Harika! Gemi uçuyor!Dialogue: 50,0:18:13.57,0:18:14.45,Main-207-,,0,0,0,,Bu gerçek mi?!Dialogue: 50,0:18:17.16,0:18:18.37,Main-207-,,0,0,0,,Başardık!Dialogue: 50,0:18:18.37,0:18:19.79,Main-207-,,0,0,0,,Vay be!Dialogue: 50,0:18:19.79,0:18:22.21,Main-207-,,0,0,0,,Nami-san, muhteşemsin!Dialogue: 50,0:18:22.91,0:18:25.67,Main-207-,,0,0,0,,Ve seni seviyorum!Dialogue: 50,0:18:26.29,0:18:30.59,Thoughts-207-,,0,0,0,,Gidin! Ulaşılamayan göğe!Dialogue: 50,0:18:35.51,0:18:37.97,Main-207-,,0,0,0,,– Gidin! – Gidin!Dialogue: 50,0:18:38.43,0:18:42.39,Main-207-,,0,0,0,,Bu akıntı ve rüzgârla istediğimiz kadar yükseğe çıkabiliriz!Dialogue: 50,0:18:42.98,0:18:46.15,Main-207-,,0,0,0,,Hey, Nami! Gökyüzü adasına yaklaştık mı?!Dialogue: 50,0:18:46.61,0:18:49.51,Main-207-,,0,0,0,,Öyle bir yer varsa, bulutların üzerindedir!Dialogue: 50,0:18:51.03,0:18:52.36,Main-207-,,0,0,0,,Bulutların üzerinde, ha?!Dialogue: 50,0:18:52.64,0:18:55.32,Main-207-,,0,0,0,,Orada ne var merak ediyorum!Dialogue: 50,0:18:55.70,0:18:58.37,Main-207-,,0,0,0,,İmparator kümülüse gidelim!Dialogue: 0,0:01:49.76,0:01:54.76,Title-207-,,0,0,0,,Yukarı Fırlatan AkıntıDialogue: 1,0:01:49.76,0:01:54.76,Title-207-,,0,0,0,,Yukarı Fırlatan AkıntıDialogue: 0,0:00:05.28,0:00:07.78,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 0,0:00:05.28,0:00:07.78,Credits-207-,,0,0,0,,SewilDialogue: 0,0:00:07.78,0:00:10.28,Credits-207-,,0,0,0,,GrafikDialogue: 0,0:00:07.78,0:00:10.28,Credits-207-,,0,0,0,,DatenshiDialogue: 0,0:00:10.29,0:00:12.79,Credits-207-,,0,0,0,,Kalite KontrolDialogue: 0,0:00:10.29,0:00:12.79,Credits-207-,,0,0,0,,Galaxy 9000 Pepperjack PhosCity Scolines ZenefDialogue: 0,0:00:12.79,0:00:15.29,Credits-207-,,0,0,0,,KaraokeDialogue: 0,0:00:12.79,0:00:15.29,Credits-207-,,0,0,0,,KaitouYahikoDialogue: 0,0:00:15.29,0:00:17.79,Credits-207-,,0,0,0,,MüzikDialogue: 0,0:00:15.29,0:00:17.79,Credits-207-,,0,0,0,,HaleeDialogue: 0,0:00:17.79,0:00:20.29,Credits-207-,,0,0,0,,ZamanlamaDialogue: 0,0:00:17.79,0:00:20.29,Credits-207-,,0,0,0,,GabDialogue: 0,0:00:20.30,0:00:22.92,Credits-207-,,0,0,0,,Altyazı Düzenleme [TR]Dialogue: 0,0:00:20.30,0:00:22.92,Credits-207-,,0,0,0,,Jack Cohle -onepacetr.net-Dialogue: 0,0:00:22.92,0:00:25.42,Credits-207-,,0,0,0,,Çevirmen [TR]Dialogue: 0,0:00:22.92,0:00:25.42,Credits-207-,,0,0,0,,Mantisentil -onepacetr.net-Dialogue: 51,0:17:44.21,0:17:44.66,Lyrics Main,,0,0,0,fx,Dialogue: 52,0:17:44.66,0:17:44.91,Lyrics Main,,0,0,0,fx,Dialogue: 51,0:17:44.26,0:17:44.66,Lyrics Main,,0,0,0,fx,Atlayın gemiye, getirin umut 