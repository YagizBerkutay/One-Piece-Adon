,15,1Style: Karaoke,Duality,82,&H009E375F,&H009E375F,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,4.5,0,8,15,15,15,1Style: Translation,Duality,82,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,4.5,0,2,15,15,15,1Style: Sign-OP,Captain Redemption,375,&H0015181B,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0,0,2,15,15,15,1Style: Sign-Wano,KG Ten Thousand Reasons Alt,60,&H005B57D2,&H000000FF,&H00000000,&H00000000,-1,0,0,0,100,100,0,0,1,0,0,2,15,15,15,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:41.87,0:01:51.86,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 50,0:01:43.20,0:01:45.16,Main-207+,,0,0,0,,Tamamdır! Yola koyulalım millet!Dialogue: 50,0:01:48.74,0:01:50.38,Main-207+,,0,0,0,,Ne oldu, Bepo?Dialogue: 50,0:01:54.92,0:01:57.18,Main-207+,,0,0,0,,Bepo, sen...Dialogue: 50,0:02:01.63,0:02:02.81,Main-207+,,0,0,0,,Oda!Dialogue: 50,0:02:11.17,0:02:12.28,Main-207+,,0,0,0,,Tara!Dialogue: 50,0:02:15.85,0:02:18.13,Main-207+,,0,0,0,,Biliyordum.Dialogue: 50,0:02:18.13,0:02:22.37,Main-207+,,0,0,0,,Üzgünüm, kendime engel olamadım da.Dialogue: 50,0:02:23.03,0:02:26.50,Main-207+,,0,0,0,,Ö-Ölecek miyim şimdi, kaptan?Dialogue: 50,0:02:26.50,0:02:29.62,Main-207+,,0,0,0,,Ne ölmesi be! Alt tarafı mideni bozdun.Dialogue: 50,0:02:30.21,0:02:33.12,Main-207+,,0,0,0,,Bu yüzden dereden balık yemeyin demiştim işte.Dialogue: 50,0:02:33.75,0:02:35.84,Main-207+,,0,0,0,,Hayret bir şey, tam da sırasıydı!Dialogue: 50,0:02:35.84,0:02:38.80,Main-207+,,0,0,0,,Ö-Özür dilerim...Dialogue: 50,0:02:46.89,0:02:48.64,Main-207+,,0,0,0,,Şirinlik yapmasana!Dialogue: 50,0:02:50.35,0:02:54.07,Main-207+,,0,0,0,,Bi' rahat dursanız dişimi kıracağım!Dialogue: 50,0:02:54.68,0:02:58.76,Main-207+,,0,0,0,,Bizim dangalaklar olay çıkarmıyordur umarım.Dialogue: 50,0:03:00.74,0:03:02.57,Main-207+,,0,0,0,,Asiler!Dialogue: 50,0:03:05.17,0:03:08.29,Main-207+,,0,0,0,,Patron! Avamdan bir asi çetesi geldi!Dialogue: 50,0:03:08.29,0:03:11.54,Main-207+,,0,0,0,,Sulh hakimi katili Zorojuro da onlarla!Dialogue: 50,0:03:12.28,0:03:14.12,Main-207+,,0,0,0,,Telaşlanmayın.Dialogue: 50,0:03:14.12,0:03:15.50,Main-207+,,0,0,0,,Yoldayım.Dialogue: 50,0:03:16.58,0:03:19.51,Main-207+,,0,0,0,,İçlerinden biri ensesinde hasır şapka taşıyor, değil mi?Dialogue: 50,0:03:19.51,0:03:21.22,Main-207+,,0,0,0,,E-Evet!Dialogue: 50,0:03:21.22,0:03:23.89,Main-207+,,0,0,0,,Karşılarına çıkmayın.Dialogue: 50,0:03:24.64,0:03:27.14,Main-207+,,0,0,0,,Onlarla aşık atamazsınız!Dialogue: 50,0:03:29.66,0:03:31.52,Main-207+,,0,0,0,,Yokozuna'ya bunu nasıl yaparsın?!Dialogue: 50,0:03:31.52,0:03:33.52,Main-207+,,0,0,0,,Alt tarafı bir avam müsveddesisin!Dialogue: 50,0:03:33.52,0:03:35.48,Main-207+,,0,0,0,,Size bir ders vereceğiz!Dialogue: 50,0:03:39.27,0:03:42.86,Main-207+,,0,0,0,,Tama dediğin, Holdem-sama'nın tutsak aldığı velet mi?Dialogue: 50,0:03:44.45,0:03:47.24,Main-207+,,0,0,0,,Onu kurtarmaya mı geldiniz?! Gelin de alın o zaman!Dialogue: 50,0:03:47.24,0:03:50.45,Main-207+,,0,0,0,,Sumo güreşinden sonra sıra kılıç müsabakası mı?Dialogue: 50,0:03:53.25,0:03:54.83,Main-207+,,0,0,0,,Saldırın!Dialogue: 50,0:03:57.38,0:04:00.67,Main-207+,,0,0,0,,Tama'yı verin lan!Dialogue: 50,0:04:01.87,0:04:03.80,Main-207+,,0,0,0,,Yine kını fırlatıverdi!Dialogue: 50,0:04:22.66,0:04:24.41,Main-207+,,0,0,0,,Tama!Dialogue: 50,0:04:35.08,0:04:37.12,Main-207+,,0,0,0,,Ben ne yapayım?Dialogue: 50,0:04:37.78,0:04:39.21,Main-207+,,0,0,0,,Zayıfım ayaklarını geç.Dialogue: 50,0:04:40.05,0:04:41.55,Main-207+,,0,0,0,,Arkanı kollamam.Dialogue: 50,0:04:42.76,0:04:46.09,Main-207+,,0,0,0,,Ben de... Kılıçtan geçireyim mi?Dialogue: 50,0:04:48.01,0:04:49.35,Main-207+,,0,0,0,,Geçir gitsin!Dialogue: 50,0:04:49.93,0:04:52.60,Main-207+,,0,0,0,,Veledi kurtarmak istiyorsan tabii!Dialogue: 50,0:05:01.09,0:05:02.19,Main-207+,,0,0,0,,Otama-chan...Dialogue: 50,0:05:08.76,0:05:10.03,Main-207+,,0,0,0,,İstiyorum!Dialogue: 50,0:05:24.80,0:05:27.93,Main-207+,,0,0,0,,Tama'yı verin lan!Dialogue: 50,0:05:32.85,0:05:35.45,Main-207+,,0,0,0,,Bir an önce vermezseniz...Dialogue: 50,0:05:37.90,0:05:40.06,Main-207+,,0,0,0,,geberip gideceksiniz.Dialogue: 50,0:05:45.88,0:05:48.11,Main-207+,,0,0,0,,Uzayın lan!Dialogue: 50,0:06:17.26,0:06:19.68,Main-207+,,0,0,0,,Diğer kasabada bir olay var.Dialogue: 50,0:06:21.04,0:06:23.80,Main-207+,,0,0,0,,Çok açım!Dialogue: 50,0:06:23.80,0:06:26.31,Main-207+,,0,0,0,,Ağlama! Hiç yakışmıyor!Dialogue: 50,0:06:28.53,0:06:33.13,Main-207+,,0,0,0,,Wano'nun erkekleri yakınmak nedir bilmemeli!Dialogue: 50,0:06:33.13,0:06:36.12,Main-207+,,0,0,0,,Açım ama!Dialogue: 50,0:06:44.01,0:06:45.46,Main-207+,,0,0,0,,Ağlama canım, ağlama.Dialogue: 50,0:06:46.58,0:06:48.59,Main-207+,,0,0,0,,Otsuru-san!Dialogue: 50,0:06:49.56,0:06:52.19,Main-207+,,0,0,0,,Otsuru-san, elinde beşparmak otu var mı?Dialogue: 50,0:06:52.19,0:06:52.86,Main-207+,,0,0,0,,Ne?Dialogue: 50,0:06:52.86,0:06:57.72,Main-207+,,0,0,0,,Evladım açlığa dayanamayıp nehir suyundan içmiş!Dialogue: 50,0:06:57.72,0:06:58.81,Main-207+,,0,0,0,,İnanmıyorum!Dialogue: 50,0:06:58.81,0:07:00.44,Main-207+,,0,0,0,,Gel hemen!Dialogue: 50,0:07:50.92,0:07:52.66,Main-207+,,0,0,0,,Hasat vakti!Dialogue: 50,0:07:55.03,0:07:57.91,Main-207+,,0,0,0,,Hasatlarınızı sepete koyun!Dialogue: 50,0:08:16.45,0:08:18.06,Main-207+,,0,0,0,,E-Efendim...Dialogue: 50,0:08:18.06,0:08:20.43,Main-207+,,0,0,0,,Ha, bunun için mi geldin?Dialogue: 50,0:08:21.67,0:08:23.14,Main-207+,,0,0,0,,B-Beş gümüş sikke mi?Dialogue: 50,0:08:23.14,0:08:27.36,Main-207+,,0,0,0,,Alacağını aldıysan arka kapıdan çaktırmadan Okobore Kasabası'na dön!Dialogue: 50,0:08:27.36,0:08:32.71,Main-207+,,0,0,0,,N'olur! Verdiğiniz ücret, ailemi bir haftalığına doyurmaya yetmez!Dialogue: 50,0:08:32.71,0:08:35.03,Main-207+,,0,0,0,,Bununla su bile satın alamayız!Dialogue: 50,0:08:35.03,0:08:37.16,Main-207+,,0,0,0,,Kes lan! Ağlama!Dialogue: 50,0:09:09.61,0:09:11.80,Main-207+,,0,0,0,,Patronunun adı ne?Dialogue: 50,0:09:11.80,0:09:15.45,Main-207+,,0,0,0,,Bol... de... H-Holde...Dialogue: 50,0:09:15.45,0:09:18.95,Main-207+,,0,0,0,,Hol... de... m...Dialogue: 50,0:09:21.78,0:09:23.00,Main-207+,,0,0,0,,Boldeb mi?Dialogue: 50,0:09:23.00,0:09:25.12,Main-207+,,0,0,0,,İtfaiyeyi çağırın!Dialogue: 50,0:09:26.00,0:09:29.17,Main-207+,,0,0,0,,Yangın! Yangın çıktı!Dialogue: 50,0:09:35.63,0:09:40.01,Main-207+,,0,0,0,,Çık lan ortaya! Boldeb!Dialogue: 50,0:09:40.57,0:09:45.31,Main-207+,,0,0,0,,Tama'nın saçının teline dokunduysan bedelini ağır ödersin!Dialogue: 50,0:09:45.31,0:09:47.44,Main-207+,,0,0,0,,Ağaç olduk lan!Dialogue: 50,0:09:47.44,0:09:51.40,Main-207+,,0,0,0,,Boldeb! Tama'yı ver!Dialogue: 50,0:10:07.54,0:10:11.63,Main-207+,,0,0,0,,Boldeb!Dialogue: 50,0:10:17.26,0:10:21.10,Main-207+,,0,0,0,,Beni arıyorsan buradayım, velet!Dialogue: 50,0:10:23.64,0:10:26.48,Main-207+,,0,0,0,,Kasabanın patronu...Dialogue: 50,0:10:26.48,0:10:29.19,Main-207+,,0,0,0,,Boldeb sensin, değil mi?Dialogue: 50,0:10:30.10,0:10:34.07,Main-207+,,0,0,0,,Adım Holdem!Dialogue: 50,0:10:41.45,0:10:43.58,Main-207+,,0,0,0,,Holdem-sama!Dialogue: 50,0:10:43.58,0:10:45.93,Main-207+,,0,0,0,,Ona haddini bildirin!Dialogue: 50,0:10:48.21,0:10:49.54,Main-207+,,0,0,0,,Nihayet geldin demek!Dialogue: 50,0:10:50.53,0:10:53.46,Main-207+,,0,0,0,,Başka çare mi bıraktın?Dialogue: 50,0:10:53.46,0:10:58.27,Main-207+,,0,0,0,,Sumo zırvanızla evimi yerle bir ettin lan!Dialogue: 50,0:10:58.27,0:11:03.26,Main-207+,,0,0,0,,Urashima'nın çarptığı evim moloz yığınına döndü! Sıçtıklarım.Dialogue: 50,0:11:03.26,0:11:05.56,Main-207+,,0,0,0,,Hangi bok çukurundan geliyorsunuz lan?Dialogue: 50,0:11:18.61,0:11:20.53,Main-207+,,0,0,0,,Ağabey!Dialogue: 50,0:11:20.53,0:11:21.91,Main-207+,,0,0,0,,Tama!Dialogue: 50,0:11:21.91,0:11:23.29,Main-207+,,0,0,0,,Otama-chan!Dialogue: 50,0:11:30.66,0:11:33.79,Main-207+,,0,0,0,,Bize karşı geldiğinize göre...Dialogue: 50,0:11:34.45,0:11:38.26,Main-207+,,0,0,0,,haydut Shutenmaru'nun adamı mısınız?Dialogue: 50,0:11:39.93,0:11:44.39,Main-207+,,0,0,0,,Bakura Kasabası'na bulaşmayacaktınız işte!Dialogue: 50,0:11:46.30,0:11:49.27,Main-207+,,0,0,0,,Shutenmaru mu? O kim lan?Dialogue: 50,0:11:52.65,0:11:54.31,Main-207+,,0,0,0,,Shutenmaru...Dialogue: 50,0:11:54.31,0:11:55.77,Main-207+,,0,0,0,,Ağzına sıçtıklarım!Dialogue: 50,0:11:55.77,0:11:59.11,Main-207+,,0,0,0,,Veledi istiyorsunuz galiba.Dialogue: 50,0:11:59.11,0:12:01.57,Main-207+,,0,0,0,,Ama kılınızı kıpırdatmayın hele!Dialogue: 50,0:12:01.57,0:12:06.41,Main-207+,,0,0,0,,Kızı saniyeler içerisinde paramparça eder!Dialogue: 50,0:12:15.76,0:12:17.92,Main-207+,,0,0,0,,Ağabey...!Dialogue: 50,0:12:19.85,0:12:20.67,Main-207+,,0,0,0,,Tama...Dialogue: 50,0:12:36.25,0:12:39.65,Main-207+,,0,0,0,,Karnında aslan mı var?Dialogue: 50,0:12:39.65,0:12:44.15,Main-207+,,0,0,0,,Şu an Holdem-sama hasır şapkalı adamla konuşuyor!Dialogue: 50,0:12:45.32,0:12:48.53,Main-207+,,0,0,0,,Her an bir savaş patlak verebilir!Dialogue: 50,0:12:48.53,0:12:51.62,Main-207+,,0,0,0,,Patron! Emirlerinizi bekliyoruz!Dialogue: 50,0:12:52.73,0:12:53.58,Main-207+,,0,0,0,,Varmak üzereyim,Dialogue: 50,0:12:54.53,0:12:56.50,Main-207+,,0,0,0,,Bakura Kasabası'nın girişindeyim!Dialogue: 50,0:12:59.55,0:13:02.38,Main-207+,,0,0,0,,Kaptan, Hawkins girişe vardı!Dialogue: 50,0:13:02.38,0:13:04.72,Main-207+,,0,0,0,,Kasabada da yangın çıktı.Dialogue: 50,0:13:04.72,0:13:07.34,Main-207+,,0,0,0,,Yangını çıkaran ise...Dialogue: 50,0:13:10.22,0:13:13.23,Main-207+,,0,0,0,,Kaptan, beni bırakma...Dialogue: 50,0:13:14.37,0:13:15.73,Main-207+,,0,0,0,,Yoksa bizimkinin işi mi?Dialogue: 50,0:13:15.73,0:13:19.26,Main-207+,,0,0,0,,Maalesef, Hasır Şapka'yı görüyorum.Dialogue: 50,0:13:19.26,0:13:20.37,Main-207+,,0,0,0,,Ha?!Dialogue: 50,0:13:24.62,0:13:26.57,Main-207+,,0,0,0,,Ağabey!Dialogue: 50,0:13:27.15,0:13:29.53,Main-207+,,0,0,0,,Seni hemen kurtarıyorum, Tama!Dialogue: 50,0:13:29.53,0:13:32.24,Main-207+,,0,0,0,,Nah kurtarırsın!Dialogue: 50,0:13:32.24,0:13:34.71,Main-207+,,0,0,0,,Aptal!Dialogue: 50,0:13:38.17,0:13:39.63,Main-207+,,0,0,0,,Ah şu aptallar!Dialogue: 50,0:13:53.89,0:13:55.31,Main-207+,,0,0,0,,Kapıyı açın!Dialogue: 50,0:13:57.03,0:13:59.32,Main-207+,,0,0,0,,Açın!Dialogue: 50,0:14:10.39,0:14:15.62,Main-207+,,0,0,0,,Yine birbirinden enfes duran türlü türlü yiyeceğimiz var!Dialogue: 50,0:14:20.56,0:14:24.24,Main-207+,,0,0,0,,Kesinlikle Speed-sama. O yüzden neden göz atmıyorsunuz?Dialogue: 50,0:14:24.24,0:14:25.84,Main-207+,,0,0,0,,Yiyecekler arkanızda da.Dialogue: 50,0:14:25.84,0:14:27.50,Main-207+,,0,0,0,,Görebiliyorum ki!Dialogue: 50,0:14:27.50,0:14:28.15,Main-207+,,0,0,0,,Ne?Dialogue: 50,0:14:29.21,0:14:30.88,Main-207+,,0,0,0,,Ne de olsa...Dialogue: 50,0:14:30.88,0:14:33.10,Main-207+,,0,0,0,,görüş alanım...Dialogue: 50,0:14:33.10,0:14:34.90,Main-207+,,0,0,0,,350 derece!Dialogue: 50,0:14:34.90,0:14:36.30,Main-207+,,0,0,0,,Bir attan farkınız yok!Dialogue: 50,0:14:36.30,0:14:37.76,Main-207+,,0,0,0,,Öyle mi dersin?Dialogue: 50,0:14:39.31,0:14:41.38,Main-207+,,0,0,0,,At gibi de gülüyorsunuz!Dialogue: 50,0:14:50.99,0:14:52.12,Main-207+,,0,0,0,,Yangın çanı mı?Dialogue: 50,0:14:52.12,0:14:54.28,Main-207+,,0,0,0,,Yangın! Yangın!Dialogue: 50,0:14:54.28,0:14:55.68,Main-207+,,0,0,0,,Yolu açın!Dialogue: 50,0:14:55.68,0:14:57.25,Main-207+,,0,0,0,,Açılın! Açılın!Dialogue: 50,0:14:58.23,0:15:02.46,Main-207+,,0,0,0,,Birinci takımın en iyileri olarak, bu yangını biz halledeceğiz!Dialogue: 50,0:15:07.38,0:15:08.38,Main-207+,,0,0,0,,Burası...Dialogue: 50,0:15:19.44,0:15:21.43,Main-207+,,0,0,0,,Yangını söndürsenize!Dialogue: 50,0:15:23.42,0:15:26.07,Main-207+,,0,0,0,,Burası Holdem'in konağı.Dialogue: 50,0:15:28.02,0:15:31.11,Main-207+,,0,0,0,,Binalara ne olmuş böyle?Dialogue: 50,0:15:31.11,0:15:33.65,Main-207+,,0,0,0,,Arkanıza bakın, Speed-sama!Dialogue: 50,0:15:36.18,0:15:37.80,Main-207+,,0,0,0,,Görebiliyorum.Dialogue: 50,0:15:37.80,0:15:40.58,Main-207+,,0,0,0,,Görüş alanımın bir attan aşağı kalır yanı yoktur da.Dialogue: 50,0:15:40.58,0:15:43.96,Main-207+,,0,0,0,,Bugün sumo güreşi müsabakası var diye biliyordum.Dialogue: 50,0:15:45.10,0:15:46.46,Main-207+,,0,0,0,,Neler oluyor?Dialogue: 50,0:15:56.85,0:15:59.46,Main-207+,,0,0,0,,Ağabey!Dialogue: 50,0:15:59.46,0:16:02.27,Main-207+,,0,0,0,,Tama! Şimdi kurtarıyorum seni!Dialogue: 50,0:16:04.15,0:16:05.71,Main-207+,,0,0,0,,Kurtarıyor musun?Dialogue: 50,0:16:05.71,0:16:10.49,Main-207+,,0,0,0,,Nasıl kurtaracakmışsın bakayım? Söyle hele!Dialogue: 50,0:16:13.49,0:16:15.09,Main-207+,,0,0,0,,Kılınızı kıpırdatmayın!Dialogue: 50,0:16:15.09,0:16:20.50,Main-207+,,0,0,0,,En ufak direniş gösterirseniz sıpanın vücudu...Dialogue: 50,0:16:23.87,0:16:28.29,Main-207+,,0,0,0,,karnımdaki aslan Kamijiro'nun ağzında mezeye döner!Dialogue: 50,0:16:35.93,0:16:38.60,Main-207+,,0,0,0,,Otama-chan! Seni hemen kurtaracağız!Dialogue: 50,0:16:39.11,0:16:43.88,Main-207+,,0,0,0,,Tama'yı bırak Boldeb! Yoksa canına okurum!Dialogue: 50,0:16:43.88,0:16:48.32,Main-207+,,0,0,0,,Adım Holdem dedik ya lan! Öğren artık!Dialogue: 50,0:16:52.74,0:16:54.69,Main-207+,,0,0,0,,Ağabey!Dialogue: 50,0:16:55.20,0:16:57.46,Main-207+,,0,0,0,,Okiku-chan!Dialogue: 50,0:16:57.46,0:16:59.37,Main-207+,,0,0,0,,Komachiyo!Dialogue: 50,0:17:02.11,0:17:05.00,Main-207+,,0,0,0,,İstediğin kadar atıp tut, dangalak!Dialogue: 50,0:17:05.00,0:17:07.75,Main-207+,,0,0,0,,Kızı nah veririm!Dialogue: 50,0:17:07.75,0:17:12.13,Main-207+,,0,0,0,,Bir sıpa için bu kadar olay çıkardığınıza göre...Dialogue: 50,0:17:12.13,0:17:17.69,Main-207+,,0,0,0,,yeteneğinden haberiniz var galiba!Dialogue: 50,0:17:38.45,0:17:40.70,Main-207+,,0,0,0,,Sizi rehin alıp...Dialogue: 50,0:17:40.70,0:17:44.16,Main-207+,,0,0,0,,Shutenmaru'yu da yakalayacağım!Dialogue: 50,0:17:45.50,0:17:46.25,Main-207+,,0,0,0,,Kimi?Dialogue: 50,0:17:52.62,0:17:54.63,Thoughts-207+,,0,0,0,,Shutenmaru...Dialogue: 50,0:17:54.63,0:17:58.01,Main-207+,,0,0,0,,Aptal ayağına yatma!Dialogue: 50,0:17:58.01,0:18:01.39,Main-207+,,0,0,0,,Hırsız çetenizin başı işte!Dialogue: 50,0:18:03.64,0:18:07.76,Main-207+,,0,0,0,,Son günlerde tarladaki soygunlar da...Dialogue: 50,0:18:08.43,0:18:11.89,Main-207+,,0,0,0,,siz Atama Dağı Hırsızları'nın işi, değil mi?Dialogue: 50,0:18:12.55,0:18:16.36,Main-207+,,0,0,0,,Bala göte de olsa Urashima'yı alt edebildiysen...Dialogue: 50,0:18:16.36,0:18:19.82,Main-207+,,0,0,0,,en güvendiği adamlarından biri olduğuna kalıbımı basarım!Dialogue: 50,0:18:21.87,0:18:23.76,Main-207+,,0,0,0,,Ne diyo'n be?Dialogue: 50,0:18:23.76,0:18:25.09,Main-207+,,0,0,0,,Luffytaro-san...Dialogue: 50,0:18:26.42,0:18:29.75,Main-207+,,0,0,0,,Onu kızdırmamaya çalış lütfen.Dialogue: 50,0:18:29.75,0:18:32.50,Main-207+,,0,0,0,,Çoktan küplere binmiş ki!Dialogue: 50,0:18:38.26,0:18:42.22,Main-207+,,0,0,0,,Bu yüzden daha da damarına basma lütfen!Dialogue: 50,0:18:43.59,0:18:46.39,Main-207+,,0,0,0,,Kendisi elbette güçlü de...Dialogue: 50,0:18:48.78,0:18:54.27,Main-207+,,0,0,0,,kasaba halkının asıl korktuğu kişi Holdem'den ziyade...Dialogue: 50,0:18:54.72,0:18:56.74,Main-207+,,0,0,0,,arkasını kollayan adamdır.Dialogue: 50,0:18:58.32,0:18:59.86,Main-207+,,0,0,0,,Canavar Korsanları'ndan...Dialogue: 50,0:19:00.99,0:19:02.57,Main-207+,,0,0,0,,Kaido'nun as adamlarından biri...Dialogue: 50,0:19:06.53,0:19:08.71,Main-207+,,0,0,0,,"Kuraklık" Jack,Dialogue: 50,0:19:08.71,0:19:11.38,Main-207+,,0,0,0,,Kuri'nin gerçek patronudur!Dialogue: 50,0:19:14.46,0:19:18.84,Main-207+,,0,0,0,,Zou'nun içinden geçtiği adam değil mi?Dialogue: 50,0:19:18.84,0:19:21.50,Main-207+,,0,0,0,,Ne? O muymuş?Dialogue: 50,0:19:22.60,0:19:25.68,Main-207+,,0,0,0,,Kediyle köpeğe karşı zehir kullanmıştı.Dialogue: 50,0:19:29.89,0:19:33.46,Main-207+,,0,0,0,,Sonunda ise fil onu havaya uçurmuştu, değil mi?Dialogue: 50,0:19:48.57,0:19:51.79,Main-207+,,0,0,0,,Jack, gemisiyle birlikte denizi boylamıştı!Dialogue: 50,0:19:51.79,0:19:54.31,Main-207+,,0,0,0,,Gebermemiş mi?Dialogue: 50,0:19:59.72,0:20:02.88,Main-207+,,0,0,0,,Kedi, köpek ve fil mi?Dialogue: 50,0:20:03.70,0:20:05.60,Main-207+,,0,0,0,,Hayvanlardan mı bahsediyorlar?Dialogue: 50,0:20:06.83,0:20:09.60,Main-207+,,0,0,0,,Demek Jack'in denizdeki kazasını biliyorsunuz!Dialogue: 50,0:20:11.61,0:20:13.73,Main-207+,,0,0,0,,Sapasağlam ayaktaydı.Dialogue: 50,0:20:14.63,0:20:18.73,Main-207+,,0,0,0,,Birkaç gün önce ise Bakura Kasabası'na geldi.Dialogue: 50,0:20:19.70,0:20:20.99,Main-207+,,0,0,0,,Ne?Dialogue: 50,0:20:21.81,0:20:25.84,Main-207+,,0,0,0,,Yani Holdem'i kızdırırsanız...Dialogue: 50,0:20:25.84,0:20:29.16,Main-207+,,0,0,0,,felaket olarak bilinen Jack de misilleme yapmaya gelirse...Dialogue: 50,0:20:30.14,0:20:33.56,Main-207+,,0,0,0,,kasaba moloz yığınına döner.Dialogue: 50,0:20:34.09,0:20:37.23,Main-207+,,0,0,0,,Bunun yaşanmasına izin veremeyiz!Dialogue: 50,0:20:37.23,0:20:39.05,Main-207+,,0,0,0,,Adiliğe bak!Dialogue: 50,0:20:39.05,0:20:42.63,Main-207+,,0,0,0,,Resmen tüm kasabayı rehin tutuyorlar o zaman!Dialogue: 50,0:20:49.77,0:20:51.39,Main-207+,,0,0,0,,Lan!Dialogue: 50,0:20:51.39,0:20:53.95,Main-207+,,0,0,0,,Lan, lan, lan, lan, lan, lan, lan!Dialogue: 50,0:20:53.95,0:20:57.27,Main-207+,,0,0,0,,Ne mırıldanıyorsunuz bakayım?Dialogue: 50,0:20:59.57,0:21:01.50,Main-207+,,0,0,0,,Ne oldu?Dialogue: 50,0:21:01.50,0:21:06.36,Main-207+,,0,0,0,,Sıpayı kurtarmaya çalışsanıza hadi!Dialogue: 50,0:21:06.36,0:21:09.99,Main-207+,,0,0,0,,Gerçi kılınızı kıpırdattığınız gibi...Dialogue: 50,0:21:12.95,0:21:15.50,Main-207+,,0,0,0,,işte böyle olacak!Dialogue: 50,0:21:18.70,0:21:21.76,Main-207+,,0,0,0,,Canım yanıyor!Dialogue: 50,0:21:23.09,0:21:26.67,Main-207+,,0,0,0,,Yapma! Şerefsiz!Dialogue: 50,0:21:31.85,0:21:39.06,Main-207+,,0,0,0,,Bayılıyorum be! Avamların acı içindeki feryatlarına!Dialogue: 50,0:21:42.55,0:21:48.78,Main-207+,,0,0,0,,Yokozuna'yı fırlatarak evimi yerle bir ettiğinizi unutmayın!Dialogue: 50,0:22:05.11,0:22:08.30,Main-207+,,0,0,0,,Bu neyin curcunası, Holdem?Dialogue: 50,0:22:10.11,0:22:15.34,Main-207+,,0,0,0,,Speed-sama'nın değerli erzak gemisi! Bugünkü menümüz!Dialogue: 50,0:22:22.52,0:22:25.46,Main-207+,,0,0,0,,Gemi dolusu yiyecek!Dialogue: 50,0:22:25.46,0:22:27.78,Main-207+,,0,0,0,,Cennet Tarlası'nın hasadı.Dialogue: 50,0:22:29.85,0:22:33.91,Main-207+,,0,0,0,,Temiz suyla yetiştirildiğinden zehirli olmayan yiyecekler.Dialogue: 50,0:22:34.66,0:22:37.23,Main-207+,,0,0,0,,Neden hepsi onların oluyormuş?Dialogue: 50,0:22:38.71,0:22:41.00,Main-207+,,0,0,0,,Zoro! Şurayı sen halleder misin?Dialogue: 50,0:22:41.94,0:22:42.97,Main-207+,,0,0,0,,Oldu bil.Dialogue: 50,0:22:42.97,0:22:43.50,Main-207+,,0,0,0,,Ne?Dialogue: 50,0:22:44.28,0:22:45.80,Main-207+,,0,0,0,,Ben de Tama'yı kurtaracağım!Dialogue: 50,0:22:45.80,0:22:47.57,Main-207+,,0,0,0,,Ne? Ne?Dialogue: 50,0:22:49.57,0:22:54.45,Main-207+,,0,0,0,,Kiku! Kusura bakma ama kapkaç yapmaya karar verdik!Dialogue: 50,0:22:54.45,0:22:56.31,Main-207+,,0,0,0,,Ne? Hangi ara?Dialogue: 50,0:22:58.90,0:23:04.48,Main-207+,,0,0,0,,Sinirlenmesine neden olacağını bilsem de canına okumamızdan iyidir ama, değil mi?Dialogue: 50,0:23:12.70,0:23:14.49,Main-207+,,0,0,0,,Hawkins-san!Dialogue: 50,0:23:16.24,0:23:18.75,Main-207+,,0,0,0,,Onların dengi değiliz!Dialogue: 50,0:23:19.67,0:23:21.32,Main-207+,,0,0,0,,Holdem nerede?Dialogue: 50,0:23:21.32,0:23:23.79,Main-207+,,0,0,0,,4. Bölge'nin meydanında kıyameti koparıyor!Dialogue: 50,0:23:26.90,0:23:28.92,Main-207+,,0,0,0,,Açmıyorsun demek, Holdem.Dialogue: 50,0:23:35.85,0:23:39.60,Main-207+,,0,0,0,,Buradan ileriye geçemezsin, Basil Hawkins!Dialogue: 50,0:23:49.03,0:23:50.11,Main-207+,,0,0,0,,Sen de kimsin?Dialogue: 50,0:23:51.15,0:23:52.03,Thoughts-207+,,0,0,0,,Güçlü.Dialogue: 50,0:23:53.24,0:23:57.33,Thoughts-207+,,0,0,0,,Kabuğuna kapanmış Wano, dışarıdan haber alamadığı için şanslıyken...Dialogue: 50,0:23:57.33,0:24:00.44,Thoughts-207+,,0,0,0,,bizi tanıyan bu elemanı...Dialogue: 50,0:24:01.45,0:24:03.00,Thoughts-207+,,0,0,0,,ortadan kaldırsam iyi olacak!Dialogue: 50,0:24:07.34,0:24:08.78,Main-207+,,0,0,0,,Şimdi,Dialogue: 50,0:24:10.08,0:24:13.18,Main-207+,,0,0,0,,gerçek eğlence başlıyor.Dialogue: 50,0:24:16.76,0:24:20.10,Main-207+,,0,0,0,,Kazara birkaçını öldürseniz de dert değil!Dialogue: 50,0:24:20.10,0:24:23.02,Main-207+,,0,0,0,,Yakalayın şunları!Dialogue: 50,0:24:27.73,0:24:29.53,Main-207+,,0,0,0,,Lan, kadın!Dialogue: 50,0:24:29.53,0:24:34.74,Main-207+,,0,0,0,,Sıpayı rehin tuttuğumuzu unutmadın umarım?Dialogue: 50,0:24:45.57,0:24:48.29,Main-207+,,0,0,0,,Luffytaro-san... Zorojuro-san...Dialogue: 50,0:24:48.98,0:24:49.82,Main-207+,,0,0,0,,Neden...?Dialogue: 50,0:24:49.82,0:24:51.67,Main-207+,,0,0,0,,Şimdi yaptınız yapacağınızı!Dialogue: 50,0:24:51.67,0:24:57.64,Main-207+,,0,0,0,,Sizi gayet iyi anladım! Sıpayı istemiyorsunuz yani?Dialogue: 50,0:24:57.64,0:25:01.61,Main-207+,,0,0,0,,Ben de arzu ettiğiniz üzere onu mezeye çevireyim!Dialogue: 50,0:25:01.61,0:25:03.44,Main-207+,,0,0,0,,Ye gitsin, Kamijiro!Dialogue: 50,0:25:23.65,0:25:24.41,Main-207+,,0,0,0,,Ne?Dialogue: 50,0:25:24.41,0:25:25.98,Main-207+,,0,0,0,,Sıpa gitmiş!Dialogue: 50,0:25:32.01,0:25:34.59,Main-207+,,0,0,0,,Ha? Ne ara aldı lan?Dialogue: 50,0:25:34.59,0:25:37.93,Main-207+,,0,0,0,,Kamijiro! Ne bok yiyorsun?Dialogue: 50,0:26:04.70,0:26:07.37,Main-207+,,0,0,0,,Hadi gidelim, Tama!Dialogue: 50,0:26:08.19,0:26:10.00,Main-207+,,0,0,0,,Ağabey...!Dialogue: 50,0:26:10.00,0:26:12.38,Main-207+,,0,0,0,,Beklettiğim için üzgünüm!Dialogue: 50,0:26:14.10,0:26:15.89,Main-207+,,0,0,0,,Komachiyo!Dialogue: 50,0:26:18.01,0:26:19.64,Main-207+,,0,0,0,,Kamijiro!Dialogue: 50,0:26:23.74,0:26:27.14,Main-207+,,0,0,0,,Alev kılıcımla seni lime lime edeceğim!Dialogue: 50,0:26:33.86,0:26:40.24,Main-207+,,0,0,0,,Hileli kılıcımdan kurtulmayı başaran daha çıkmadı!Dialogue: 50,0:26:41.07,0:26:44.45,Main-207+,,0,0,0,,Zebani Kılıcı!Dialogue: 50,0:26:49.30,0:26:52.88,Main-207+,,0,0,0,,Yakaladım! Gel bakalım! Sen de rehinemizsin artık!Dialogue: 50,0:26:56.38,0:26:59.59,Main-207+,,0,0,0,,Yoldaşını kaybetmeye razı mısın?Dialogue: 50,0:27:05.56,0:27:08.13,Main-207+,,0,0,0,,Kılıçlarını bırak!Dialogue: 50,0:27:14.65,0:27:16.61,Main-207+,,0,0,0,,Ha şöyle!Dialogue: 50,0:27:16.61,0:27:18.65,Main-207+,,0,0,0,,Zorojuro-san...Dialogue: 50,0:27:18.65,0:27:23.64,Main-207+,,0,0,0,,Kıpırdayayım deme! Seni ölümüne döveceğim!Dialogue: 50,0:27:31.59,0:27:33.17,Main-207+,,0,0,0,,Bak hele.Dialogue: 50,0:27:33.17,0:27:35.72,Main-207+,,0,0,0,,Benden medet umma.Dialogue: 50,0:27:42.13,0:27:45.11,Main-207+,,0,0,0,,Kadına ne olacağını önemsemiyor musun?Dialogue: 50,0:27:50.52,0:27:52.40,Main-207+,,0,0,0,,Kaçamazsın!Dialogue: 50,0:27:58.01,0:27:59.49,Main-207+,,0,0,0,,Müsaadenle.Dialogue: 50,0:28:02.69,0:28:03.74,Main-207+,,0,0,0,,Ne yapayım?Dialogue: 50,0:28:03.74,0:28:05.45,Main-207+,,0,0,0,,Kendi tarafını hallet!Dialogue: 50,0:28:05.45,0:28:06.55,Main-207+,,0,0,0,,Tamam!Dialogue: 50,0:28:49.40,0:28:51.41,Main-207+,,0,0,0,,Köpek! Buraya gel!Dialogue: 50,0:28:58.88,0:29:01.01,Main-207+,,0,0,0,,Teşekkür ederim!Dialogue: 50,0:29:09.97,0:29:11.52,Main-207+,,0,0,0,,Bizi kasabadan çıkar!Dialogue: 50,0:29:25.66,0:29:27.94,Main-207+,,0,0,0,,Yanağına ne oldu senin?Dialogue: 50,0:29:31.57,0:29:33.00,Main-207+,,0,0,0,,Bir şey yok ya.Dialogue: 50,0:29:34.21,0:29:36.92,Main-207+,,0,0,0,,Kerpetenle çektiler sadece.Dialogue: 50,0:29:37.79,0:29:39.33,Main-207+,,0,0,0,,Kibi dango yeteneği...Dialogue: 50,0:29:40.12,0:29:42.80,Main-207+,,0,0,0,,öyle çekseler bile çalışmaz ki!Dialogue: 50,0:29:44.93,0:29:46.01,Main-207+,,0,0,0,,Kerpeten mi?Dialogue: 50,0:29:47.68,0:29:49.72,Main-207+,,0,0,0,,Bekle hele!Dialogue: 50,0:29:50.70,0:29:52.47,Main-207+,,0,0,0,,Kaçmasana lan!Dialogue: 50,0:29:57.69,0:30:03.61,Main-207+,,0,0,0,,Ağabey! Bir şeyim kalmadı! Beni kurtardın çünkü!Dialogue: 50,0:30:05.49,0:30:07.87,Main-207+,,0,0,0,,Ha? Saldırmaya mı kalkıyor?Dialogue: 50,0:30:08.20,0:30:11.08,Main-207+,,0,0,0,,Kükre! Aslan Ateşi!Dialogue: 50,0:30:18.17,0:30:20.79,Main-207+,,0,0,0,,Ağabey!Dialogue: 50,0:30:20.79,0:30:27.38,Main-207+,,0,0,0,,Üstüne hileli kılıcımın tadına da bak!Dialogue: 50,0:30:30.01,0:30:32.43,Main-207+,,0,0,0,,Lastik-Lastik...Dialogue: 50,0:30:35.77,0:30:38.35,Main-207+,,0,0,0,,Kızıl Şahin!Dialogue: 0,0:01:41.95,0:01:45.16,Title-207+,,0,0,0,,Değerli Erzak GemisiDialogue: 1,0:01:41.95,0:01:45.16,Title-207+,,0,0,0,,Değerli Erzak GemisiDialogue: 0,0:05:58.54,0:06:05.51,Sign 3,,0,0,0,,Okobore Kasabası KuriDialogue: 1,0:05:58.54,0:06:05.51,Sign 3,,0,0,0,,Okobore Kasabası KuriDialogue: 0,0:07:43.77,0:07:52.66,Sign 3,,0,0,0,,Cennet TarlasıDialogue: 1,0:07:43.77,0:07:52.66,Sign 3,,0,0,0,,Cennet TarlasıDialogue: 0,0:07:43.77,0:07:52.66,Sign 3,,0,0,0,,Bakura Kasabası'nın Uç BölgesiDialogue: 1,0:07:43.77,0:07:52.66,Sign 3,,0,0,0,,Bakura Kasabası'nın Uç BölgesiDialogue: 0,0:14:41.81,0:14:47.24,Captions Wano,,0,0,0,,SpeedDialogue: 1,0:14:41.81,0:14:47.24,Captions Wano,,0,0,0,,SpeedDialogue: 0,0:14:41.81,0:14:47.24,Sign 3,,0,0,0,,Canavar Korsanları Öncüsü, At GÜLÜCÜK KullanıcısıDialogue: 1,0:14:41.81,0:14:47.24,Sign 3,,0,0,0,,Canavar Korsanları Öncüsü, At GÜLÜCÜK KullanıcısıDialogue: 0,0:16:27.96,0:16:28.00,Captions-207+,,0,0,0,,Kamijiro  Holdem'in MidesiDialogue: 1,0:16:27.96,0:16:28.00,Captions-207+,,0,0,0,,Kamijiro  Holdem'in MidesiDialogue: 0,0:16:28.00,0:16:28.05,Captions-207+,,0,0,0,,Kamijiro  Holdem'in MidesiDialogue: 1,0:16:28.00,0:16:28.05,Captions-207+,,0,0,0,,Kamijiro  Holdem'in MidesiDialogue: 0,0:16:28.05,0:16:28.09,Captions-207+,,0,0,0,,Kamijiro  Holdem'in MidesiDialogue: 1,0:16:28.05,0:16:28.09,Captions-207+,,0,0,0,,Kamijiro  Holdem'in MidesiDialogue: 0,0:16:28.09,0:16:28.13,Captions-207+,,0,0,0,,Kamijiro  Holdem'in MidesiDialogue: 1,0:16:28.09,0:16:28.13,Captions-207+,,0,0,0,,Kamijiro  Holdem'in MidesiDialogue: 0,0:16:28.13,0:16:28.17,Captions-207+,,0,0,0,,Kamijiro  Holdem'in MidesiDialogue: 1,