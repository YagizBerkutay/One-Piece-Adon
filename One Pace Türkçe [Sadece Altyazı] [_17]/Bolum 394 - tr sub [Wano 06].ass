aoke,Duality,82,&H009E375F,&H009E375F,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,4.5,0,8,15,15,15,1Style: Translation,Duality,82,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,4.5,0,2,15,15,15,1Style: Sign-OP,Captain Redemption,375,&H0015181B,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0,0,2,15,15,15,1Style: Sign-Wano,KG Ten Thousand Reasons Alt,60,&H005B57D2,&H000000FF,&H00000000,&H00000000,-1,0,0,0,100,100,0,0,1,0,0,2,15,15,15,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:41.87,0:01:51.86,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 50,0:01:44.41,0:01:46.62,Main-207+,,0,0,0,,Amma iri bir aslan köpekmiş!Dialogue: 50,0:01:46.62,0:01:48.30,Main-207+,,0,0,0,,Sahibi kim ola ki?Dialogue: 50,0:01:49.21,0:01:52.50,Main-207+,,0,0,0,,Otama veledini nasıl bulacağız?Dialogue: 50,0:01:52.50,0:01:56.42,Main-207+,,0,0,0,,Kasaba halkına sorsak da cevap alamayız.Dialogue: 50,0:01:56.42,0:02:00.53,Main-207+,,0,0,0,,Hepsi de Orochi'nin gölgesinde yaşıyor.Dialogue: 50,0:02:02.17,0:02:06.23,Main-207+,,0,0,0,,İyi de savaşıyor gibi bir hâli olmayan, sıradan insanlar da görüyorum.Dialogue: 50,0:02:07.37,0:02:10.22,Main-207+,,0,0,0,,Kasaba halkı, oldu olası burada yaşardı zaten.Dialogue: 50,0:02:10.91,0:02:16.23,Main-207+,,0,0,0,,20 yıl önceye kadar hayat dolu bir kale kasabasıydı.Dialogue: 50,0:02:17.40,0:02:21.82,Main-207+,,0,0,0,,Günün birinde ise Orochi'nin adamları diledikleri hanelere kurularak...Dialogue: 50,0:02:22.57,0:02:24.79,Main-207+,,0,0,0,,gerekli gördükleri tüccarlar haricinde...Dialogue: 50,0:02:26.39,0:02:30.84,Main-207+,,0,0,0,,herkesi kasabadan sürdüler.Dialogue: 50,0:02:32.77,0:02:36.26,Main-207+,,0,0,0,,Bakura Kasabası da bu hâle geldi işte.Dialogue: 50,0:03:01.32,0:03:03.78,Main-207+,,0,0,0,,Bir sumo güreşçisi mi? Nasıl olur?Dialogue: 50,0:03:05.78,0:03:08.20,Main-207+,,0,0,0,,Kasabada bir işler dönüyor.Dialogue: 50,0:03:08.20,0:03:10.67,Main-207+,,0,0,0,,Bir sumo güreşçisi fırlatıldığına göre...Dialogue: 50,0:03:10.67,0:03:12.33,Main-207+,,0,0,0,,sumo güreşi olsa gerek.Dialogue: 50,0:03:18.45,0:03:23.80,Main-207+,,0,0,0,,Yok mu?! Çiçek Başkenti'nin Yokozunası Urashima'yı...Dialogue: 50,0:03:23.80,0:03:30.13,Main-207+,,0,0,0,,yıkabilecek bir babayiğit yok mu?!Dialogue: 50,0:03:38.39,0:03:40.76,Main-207+,,0,0,0,,Yine çer çöp çıktılar-pe.Dialogue: 50,0:03:48.77,0:03:49.70,Main-207+,,0,0,0,,Yine...Dialogue: 50,0:03:58.95,0:04:02.26,Main-207+,,0,0,0,,Sumo ha? Eğlenceli olsa gerek!Dialogue: 50,0:04:08.37,0:04:14.81,Main-207+,,0,0,0,,Urashima'yla güreş tutanların sayısı böylelikle 19 etti!Dialogue: 50,0:04:15.68,0:04:20.15,Main-207+,,0,0,0,,Gelgelelim kırdığı kemik sayısı...Dialogue: 50,0:04:21.63,0:04:23.85,Main-207+,,0,0,0,,10 kol,Dialogue: 50,0:04:23.85,0:04:26.10,Main-207+,,0,0,0,,15 bacak,Dialogue: 50,0:04:26.10,0:04:28.37,Main-207+,,0,0,0,,52 kaburga,Dialogue: 50,0:04:28.37,0:04:30.83,Main-207+,,0,0,0,,4 kafatası ve...Dialogue: 50,0:04:30.83,0:04:33.61,Main-207+,,0,0,0,,7 omurga!!Dialogue: 50,0:04:34.04,0:04:39.50,Main-207+,,0,0,0,,Toplamda 88 kemik pert olmuş, 4 güreşçi de kayıplarda!Dialogue: 50,0:04:40.08,0:04:42.92,Main-207+,,0,0,0,,Ezip geçiyor!Dialogue: 50,0:04:43.53,0:04:47.14,Main-207+,,0,0,0,,Neredeyse insan üstü bir güç!Dialogue: 50,0:04:47.14,0:04:49.50,Main-207+,,0,0,0,,Yenilmez canavar!Dialogue: 50,0:04:49.50,0:04:55.90,Main-207+,,0,0,0,,Yokozuna Urashima!Dialogue: 55,0:04:55.90,0:04:59.98,Main-207+,,0,0,0,,Bugün müstesna bir gösteri maçına tanıklık ediyoruz!Dialogue: 55,0:05:00.07,0:05:03.49,Main-207+,,0,0,0,,Urashima'nın sırtını yere getirene tamı tamına 500 altın sikke!Dialogue: 50,0:05:04.09,0:05:06.11,Main-207+,,0,0,0,,Urashima'nın hakkından gelin!Dialogue: 50,0:05:06.11,0:05:07.91,Main-207+,,0,0,0,,Paramı size oynadım ha!Dialogue: 50,0:05:07.91,0:05:10.32,Main-207+,,0,0,0,,Hadi tosunlar, yaparsınız!Dialogue: 50,0:05:11.39,0:05:15.12,Main-207+,,0,0,0,,Planımız kusursuz! Altınlar bizim olacak!Dialogue: 50,0:05:15.12,0:05:17.65,Main-207+,,0,0,0,,Adi herife gününü göster!Dialogue: 50,0:05:17.65,0:05:19.54,Main-207+,,0,0,0,,Urashima-sama!Dialogue: 50,0:05:26.22,0:05:29.14,Main-207+,,0,0,0,,Vay vay! Şuraya bakın hele!Dialogue: 50,0:05:33.55,0:05:35.18,Main-207+,,0,0,0,,Hazır...Dialogue: 50,0:05:36.60,0:05:38.40,Main-207+,,0,0,0,,Başlayın!Dialogue: 50,0:05:48.28,0:05:50.49,Main-207+,,0,0,0,,Okiku!Dialogue: 50,0:05:52.68,0:05:56.33,Main-207+,,0,0,0,,Geleceğini biliyordum!Dialogue: 50,0:05:57.83,0:06:02.04,Main-207+,,0,0,0,,Karım olmaya mı karar verdin yani-pe?Dialogue: 50,0:06:05.19,0:06:06.96,Main-207+,,0,0,0,,Affedersin.Dialogue: 50,0:06:06.96,0:06:09.30,Main-207+,,0,0,0,,Arkama geçmek seni gizlemez.Dialogue: 50,0:06:09.30,0:06:12.12,Main-207+,,0,0,0,,Gözlerime inanamıyorum!Dialogue: 50,0:06:12.12,0:06:16.81,Main-207+,,0,0,0,,Urashima'nın evlilik sözü aldığı bir kadın çıkageldi!Dialogue: 50,0:06:17.52,0:06:22.77,Main-207+,,0,0,0,,Kıskanmamak elde değil! Yokozuna'nın gönlünü çalmış!Dialogue: 50,0:06:22.77,0:06:28.67,Main-207+,,0,0,0,,Yılın şok haberi!Dialogue: 50,0:06:28.67,0:06:32.39,Main-207+,,0,0,0,,Ne? Muhteşem Urashima'nın karısı mı?Dialogue: 50,0:06:32.39,0:06:33.69,Main-207+,,0,0,0,,Karısı mısın?Dialogue: 50,0:06:33.69,0:06:34.79,Main-207+,,0,0,0,,Hayır.Dialogue: 50,0:06:36.93,0:06:42.75,Main-207+,,0,0,0,,Daha önce tanık olduğun üzere kendi kendine gelin güveyi oldu.Dialogue: 50,0:06:45.37,0:06:50.02,Flashbacks-207+,,0,0,0,,Okiku! Bakura Kasabası'nda bir müsabakam olacak-pe!Dialogue: 50,0:06:50.02,0:06:54.01,Flashbacks-207+,,0,0,0,,Gücümü merak ediyorsan izlemeye gelirsin!Dialogue: 50,0:06:59.15,0:07:02.48,Main-207+,,0,0,0,,Benim... Kendi iradem var!Dialogue: 50,0:07:04.91,0:07:06.36,Main-207+,,0,0,0,,Anlıyorum.Dialogue: 50,0:07:07.45,0:07:09.49,Main-207+,,0,0,0,,Millet!Dialogue: 50,0:07:09.49,0:07:12.45,Main-207+,,0,0,0,,Birini arıyoruz!Dialogue: 50,0:07:12.45,0:07:15.16,Main-207+,,0,0,0,,Tama isimli küçük bir kız!Dialogue: 50,0:07:15.73,0:07:18.87,Main-207+,,0,0,0,,Kasaba patronunun yerini söyleyin!Dialogue: 50,0:07:18.87,0:07:21.01,Main-207+,,0,0,0,,Orada buluruz!Dialogue: 50,0:07:22.61,0:07:27.34,Main-207+,,0,0,0,,Yere batasıca! Hayallerim yıkıldı! Servet avcısı sürtük!Dialogue: 50,0:07:27.34,0:07:31.83,Main-207+,,0,0,0,,Deve kadar olsa da tam Urashima'nın dişine göre!Dialogue: 50,0:07:31.83,0:07:34.30,Main-207+,,0,0,0,,Ben daha uygun bir eş olurdum!Dialogue: 50,0:07:35.45,0:07:37.01,Main-207+,,0,0,0,,Takan yok ki.Dialogue: 50,0:07:37.01,0:07:42.48,Main-207+,,0,0,0,,Okiku ziyaretime gelmiş. Çocuklar, kapın gelin!Dialogue: 50,0:07:42.48,0:07:43.65,Main-207+,,0,0,0,,– Başüstüne! – Başüstüne!Dialogue: 50,0:07:43.65,0:07:46.94,Main-207+,,0,0,0,,Ağabey! Yere bakan yürek yakan olduğunu bilmezdim!Dialogue: 50,0:07:46.94,0:07:50.24,Main-207+,,0,0,0,,Senin gibi olmak istiyorum! Sana ayvayı yakmasına şaşmamalı!Dialogue: 50,0:07:51.87,0:07:53.36,Main-207+,,0,0,0,,Okiku!Dialogue: 50,0:07:53.36,0:07:57.28,Main-207+,,0,0,0,,İyi be, kendimiz ararız! Gidelim!Dialogue: 50,0:07:59.87,0:08:03.96,Main-207+,,0,0,0,,Lan kadın! Urashima ağabeyimiz seni istiyor, gel hele!Dialogue: 50,0:08:03.96,0:08:06.46,Main-207+,,0,0,0,,Siz de kimsiniz lan? Uzayın!Dialogue: 50,0:08:06.46,0:08:08.25,Main-207+,,0,0,0,,Pataklayın gitsin!Dialogue: 50,0:08:10.46,0:08:12.43,Main-207+,,0,0,0,,Bize engel olmayın!Dialogue: 50,0:08:31.28,0:08:32.40,Main-207+,,0,0,0,,Ne?Dialogue: 50,0:08:32.95,0:08:34.74,Main-207+,,0,0,0,,İyi daldın!Dialogue: 50,0:08:40.38,0:08:43.51,Main-207+,,0,0,0,,Tsuki-oshi'yle kazandım galiba.Dialogue: 50,0:08:45.12,0:08:47.52,Main-207+,,0,0,0,,Gel buraya kadın!Dialogue: 50,0:08:47.52,0:08:49.38,Main-207+,,0,0,0,,Hayır, bırak lütfen!Dialogue: 50,0:08:53.17,0:08:57.14,Main-207+,,0,0,0,,Silahsız, çıplak bir adamı mı keseceksin?Dialogue: 50,0:09:04.02,0:09:06.81,Main-207+,,0,0,0,,Oley!Dialogue: 50,0:09:08.65,0:09:12.61,Main-207+,,0,0,0,,Hoppa! Hoppa! Hoppa!Dialogue: 50,0:09:14.57,0:09:16.07,Main-207+,,0,0,0,,Kiku!Dialogue: 50,0:09:18.78,0:09:20.20,Main-207+,,0,0,0,,Çekil lan!Dialogue: 50,0:09:28.58,0:09:31.34,Main-207+,,0,0,0,,Hey, Zoro! Buna nasıl göz yumarsın?Dialogue: 50,0:09:36.59,0:09:37.72,Main-207+,,0,0,0,,Üzgünüm.Dialogue: 50,0:09:37.72,0:09:41.14,Main-207+,,0,0,0,,Çıplak bir adamı biçmek...Dialogue: 50,0:09:41.87,0:09:43.68,Main-207+,,0,0,0,,doğru gelmedi de.Dialogue: 50,0:09:44.65,0:09:45.82,Main-207+,,0,0,0,,Hem...Dialogue: 50,0:09:46.81,0:09:50.19,Main-207+,,0,0,0,,o da sıradan bir çay evi garsonu değil.Dialogue: 50,0:09:53.31,0:09:56.57,Main-207+,,0,0,0,,Hey! Kasabanın dışındaki çay evinde çalışan kız!Dialogue: 50,0:09:56.57,0:10:01.24,Main-207+,,0,0,0,,Kasabamıza adım atması dahi küstahlık olan avam tabakasından!Dialogue: 50,0:10:01.24,0:10:05.45,Main-207+,,0,0,0,,Öyle mi? Sürtüğü kapı dışarı edin o zaman!Dialogue: 50,0:10:05.45,0:10:07.67,Main-207+,,0,0,0,,Amiyane orospu!Dialogue: 50,0:10:10.54,0:10:13.50,Main-207+,,0,0,0,,Kesin lan, halk bozuntusu!Dialogue: 50,0:10:17.22,0:10:23.46,Main-207+,,0,0,0,,Samuray sınıfının gözünde bir farkınız yok, adi avamlarsınız-pe!Dialogue: 50,0:10:26.29,0:10:29.10,Main-207+,,0,0,0,,Beş para etmez hayatlarınızı...Dialogue: 50,0:10:29.10,0:10:31.94,Main-207+,,0,0,0,,bağışlamak da almak da...Dialogue: 50,0:10:33.19,0:10:35.40,Main-207+,,0,0,0,,bana kalmış!Dialogue: 50,0:10:56.83,0:11:01.85,Main-207+,,0,0,0,,O yüzden, Okiku!Dialogue: 50,0:11:01.85,0:11:03.64,Main-207+,,0,0,0,,Benim malım...Dialogue: 50,0:11:03.64,0:11:09.64,Main-207+,,0,0,0,,olsana!Dialogue: 50,0:11:14.32,0:11:18.37,Main-207+,,0,0,0,,Ben "avam" denen birini...Dialogue: 50,0:11:19.21,0:11:20.65,Main-207+,,0,0,0,,tanımıyorum!Dialogue: 50,0:11:51.84,0:11:53.21,Main-207+,,0,0,0,,Dalga geçmeyi bırak.Dialogue: 50,0:11:53.86,0:11:56.44,Main-207+,,0,0,0,,Amiyane olan senin kalbindir.Dialogue: 50,0:12:06.62,0:12:09.41,Main-207+,,0,0,0,,Yokozuna'nın topuzu!Dialogue: 50,0:12:15.04,0:12:18.26,Main-207+,,0,0,0,,Dehşet ya!Dialogue: 50,0:12:18.26,0:12:21.42,Main-207+,,0,0,0,,Kiku da boş değilmiş!Dialogue: 50,0:12:21.42,0:12:24.33,Main-207+,,0,0,0,,Şimdi işler kızıştı!Dialogue: 50,0:12:26.01,0:12:28.93,Main-207+,,0,0,0,,Bir kadın tarafından geri çevrildiği yetmedi...Dialogue: 50,0:12:28.93,0:12:31.89,Main-207+,,0,0,0,,üstüne topuzu da kesildi!Dialogue: 50,0:12:31.89,0:12:34.52,Main-207+,,0,0,0,,Patronlarını böyle daha çabuk ortaya çıkarırız!Dialogue: 50,0:12:50.83,0:12:55.17,Main-207+,,0,0,0,,Okiku!Dialogue: 50,0:12:55.84,0:12:58.00,Main-207+,,0,0,0,,Bana...Dialogue: 50,0:12:58.00,0:13:00.96,Main-207+,,0,0,0,,ihanet ettin!Dialogue: 50,0:13:03.80,0:13:05.59,Main-207+,,0,0,0,,Onca insanın içinde...Dialogue: 50,0:13:06.58,0:13:07.89,Main-207+,,0,0,0,,neden bunu yaptım ki?Dialogue: 50,0:13:11.36,0:13:14.25,Main-207+,,0,0,0,,Bir gazap tanrısının suratını andırıyor!Dialogue: 50,0:13:19.21,0:13:20.86,Main-207+,,0,0,0,,Okiku!Dialogue: 50,0:13:21.73,0:13:24.19,Main-207+,,0,0,0,,Olamaz! Aldığı duruş...Dialogue: 50,0:13:24.19,0:13:27.07,Main-207+,,0,0,0,,Rakiplerini uçuran Ekinoks Harite!Dialogue: 50,0:13:28.18,0:13:30.66,Main-207+,,0,0,0,,Bağışlayın lütfen, Urashima-sama.Dialogue: 50,0:13:37.16,0:13:38.00,Main-207+,,0,0,0,,Fakat...Dialogue: 50,0:13:41.45,0:13:46.01,Main-207+,,0,0,0,,düşündüğüm gibi, kadınlara el kaldıracak bir adammışsın.Dialogue: 50,0:13:50.76,0:13:53.93,Main-207+,,0,0,0,,Geber!Dialogue: 50,0:14:14.45,0:14:17.29,Main-207+,,0,0,0,,Lastik-Lastik...Dialogue: 50,0:14:18.42,0:14:19.71,Main-207+,,0,0,0,,Tsuppari!Dialogue: 50,0:14:50.68,0:14:54.24,Main-207+,,0,0,0,,Lan lan lan... Aman aman... Aman aman...Dialogue: 50,0:14:55.58,0:14:56.63,Main-207+,,0,0,0,,Lan lan lan...Dialogue: 50,0:14:57.71,0:14:58.54,Main-207+,,0,0,0,,Aman aman...Dialogue: 50,0:15:15.18,0:15:17.68,Main-207+,,0,0,0,,Sokayım!Dialogue: 50,0:15:18.75,0:15:21.73,Main-207+,,0,0,0,,Harite'me ne yaptın lan?Dialogue: 50,0:15:24.52,0:15:28.19,Main-207+,,0,0,0,,Sıçtığım, Okiku'nun neyi oluyorsun-pe?Dialogue: 50,0:15:28.19,0:15:32.32,Main-207+,,0,0,0,,Çekil önümden!Dialogue: 50,0:15:32.90,0:15:36.70,Main-207+,,0,0,0,,Okiku'yu paramparça etmezsem...Dialogue: 50,0:15:37.25,0:15:40.00,Main-207+,,0,0,0,,bana götüyle gülerler!Dialogue: 50,0:15:40.95,0:15:42.79,Main-207+,,0,0,0,,Anlaşıldı, nasıl istersen!Dialogue: 50,0:15:43.08,0:15:44.85,Main-207+,,0,0,0,,Öyleyse...Dialogue: 50,0:15:45.67,0:15:47.68,Main-207+,,0,0,0,,Dosukoi!Dialogue: 50,0:15:48.75,0:15:50.05,Main-207+,,0,0,0,,Dosukoi!Dialogue: 50,0:15:54.39,0:15:56.48,Main-207+,,0,0,0,,Önce beni yenmen lazım ama!Dialogue: 50,0:15:59.22,0:16:00.06,Main-207+,,0,0,0,,Ben...Dialogue: 50,0:16:02.33,0:16:04.90,Main-207+,,0,0,0,,sumo'da ustayımdır!Dialogue: 50,0:16:09.82,0:16:12.20,Main-207+,,0,0,0,,Önümden...Dialogue: 50,0:16:12.20,0:16:14.41,Main-207+,,0,0,0,,çekil dedim lan!Dialogue: 50,0:16:14.41,0:16:17.58,Main-207+,,0,0,0,,Budist Harite!Dialogue: 50,0:16:31.37,0:16:34.01,Main-207+,,0,0,0,,Urashima'nın hariteleri'ni savuşturabiliyor!Dialogue: 50,0:16:34.01,0:16:35.76,Main-207+,,0,0,0,,Acayip çevik!Dialogue: 50,0:16:36.86,0:16:38.43,Main-207+,,0,0,0,,Ha gayret, bacaksız!Dialogue: 50,0:16:38.43,0:16:41.02,Main-207+,,0,0,0,,Kaçarak kazanamazsın ama!Dialogue: 50,0:16:52.57,0:16:54.48,Main-207+,,0,0,0,,Kulak Patlatıcı!Dialogue: 50,0:16:56.59,0:16:57.24,Main-207+,,0,0,0,,Hey!Dialogue: 50,0:16:57.24,0:16:58.28,Main-207+,,0,0,0,,Göz Çıkarıcı!Dialogue: 50,0:17:04.82,0:17:08.38,Main-207+,,0,0,0,,Lan! Onlar yasak değil mi?Dialogue: 50,0:17:08.38,0:17:10.56,Main-207+,,0,0,0,,Kes!Dialogue: 50,0:17:11.55,0:17:13.67,Main-207+,,0,0,0,,Ben...Dialogue: 50,0:17:13.67,0:17:18.80,Main-207+,,0,0,0,,yokozuna'yım!Dialogue: 50,0:17:22.41,0:17:24.80,Main-207+,,0,0,0,,Neyse, öyle olsun.Dialogue: 50,0:17:28.77,0:17:31.23,Main-207+,,0,0,0,,Holdem-sama! Kötü bir haberimiz var!Dialogue: 50,0:17:31.23,0:17:36.15,Main-207+,,0,0,0,,Ha? Kadının teki, yokozuna'nın topuzunu mu kesti?Dialogue: 50,0:17:36.15,0:17:40.70,Main-207+,,0,0,0,,Ortalık ayağa kalktı! Biz de n'apacağımızı bilmiyoruz!Dialogue: 50,0:17:40.70,0:17:44.87,Main-207+,,0,0,0,,Sikimde değil! Bana ne bundan?Dialogue: 50,0:17:51.70,0:17:56.72,Main-207+,,0,0,0,,Kızın yanaklarını koparmakla meşgulüm!Dialogue: 50,0:17:58.84,0:18:03.35,Main-207+,,0,0,0,,Bağışlayın lütfen! Babununuzu geri alabilirsiniz!Dialogue: 50,0:18:03.35,0:18:06.23,Main-207+,,0,0,0,,Yapmayın lütfen!Dialogue: 50,0:18:07.39,0:18:09.71,Main-207+,,0,0,0,,Yok öyle yağma!Dialogue: 50,0:18:10.62,0:18:15.88,Main-207+,,0,0,0,,Kozuki adını ağzına almışsın.Dialogue: 50,0:18:19.45,0:18:24.70,Flashbacks-207+,,0,0,0,,Kozuki Hanesi döndüğünde gününüzü gösterecek!Dialogue: 50,0:18:25.97,0:18:28.65,Main-207+,,0,0,0,,Sen de biliyorsun ki...Dialogue: 50,0:18:29.67,0:18:33.27,Main-207+,,0,0,0,,"Kozuki" adını anmak...Dialogue: 50,0:18:33.27,0:18:35.42,Main-207+,,0,0,0,,büyük suçtur!Dialogue: 50,0:18:36.35,0:18:40.72,Main-207+,,0,0,0,,Aynı zamanda cezanı veriyorum yani.Dialogue: 50,0:18:42.52,0:18:46.28,Main-207+,,0,0,0,,Hayaletlerden medet ummayı bırakın artık.Dialogue: 50,0:18:46.28,0:18:49.36,Main-207+,,0,0,0,,Kozukiler 20 yıl evvel...Dialogue: 50,0:18:49.81,0:18:57.17,Main-207+,,0,0,0,,Wano'yu yok etmeye kalkışan şeytani bir haneydi!Dialogue: 50,0:19:17.05,0:19:19.17,Main-207+,,0,0,0,,Çekil lan, götten bacaklı!Dialogue: 50,0:19:20.14,0:19:24.72,Main-207+,,0,0,0,,Okiku telafisi olmayan bir suç işledi-pe!Dialogue: 50,0:19:26.52,0:19:31.74,Main-207+,,0,0,0,,Samuray sınıfına ait biriyle evlenip hizmet etme onurunu kabul etmediği gibi...Dialogue: 50,0:19:33.10,0:19:34.90,Main-207+,,0,0,0,,bir de beni aşağıladı!Dialogue: 50,0:19:35.77,0:19:40.08,Main-207+,,0,0,0,,İbretlik olsun diye beyninin pekmezini akıtacağım!Dialogue: 50,0:19:54.41,0:19:56.25,Main-207+,,0,0,0,,Tatava yapma!Dialogue: 50,0:19:56.25,0:19:58.67,Main-207+,,0,0,0,,Kazanırsan istediğini yapabilirsin dedik ya!Dialogue: 50,0:20:12.19,0:20:14.94,Main-207+,,0,0,0,,Gücün yetmez gerçi!Dialogue: 50,0:20:17.40,0:20:18.65,Main-207+,,0,0,0,,Ne diyorsun lan?Dialogue: 50,0:20:20.35,0:20:21.82,Main-207+,,0,0,0,,Ben...Dialogue: 50,0:20:23.04,0:20:25.45,Main-207+,,0,0,0,,Ben...Dialogue: 50,0:20:25.50,0:20:31.54,Main-207+,,0,0,0,,Wano'nun en güçlü yokozuna'sıyım!Dialogue: 50,0:20:33.25,0:20:35.79,Main-207+,,0,0,0,,Üstün Harite!Dialogue: 50,0:20:52.35,0:20:54.40,Main-207+,,0,0,0,,Bu da ne?Dialogue: 50,0:20:54.40,0:20:56.35,Main-207+,,0,0,0,,Bilmem ki, ne acaba?Dialogue: 50,0:21:10.93,0:21:13.25,Main-207+,,0,0,0,,Sen yokozuna'ysan...Dialogue: 50,0:21:16.41,0:21:17.25,Main-207+,,0,0,0,,ben de...Dialogue: 50,0:21:21.63,0:21:25.48,Main-207+,,0,0,0,,Korsanlar Kralı olacak adamam!Dialogue: 50,0:21:29.89,0:21:31.56,Main-207+,,0,0,0,,Ay, ay, ay, ay...Dialogue: 50,0:21:32.66,0:21:36.23,Main-207+,,0,0,0,,Luffy ağabey!Dialogue: 50,0:21:36.65,0:21:39.32,Main-207+,,0,0,0,,Lastik-Lastik...Dialogue: 50,0:22:01.34,0:22:03.30,Main-207+,,0,0,0,,Dev...Dialogue: 50,0:22:04.88,0:22:08.97,Main-207+,,0,0,0,,Sumo Harite!Dialogue: 50,0:22:28.15,0:22:32.45,Main-207+,,0,0,0,,DosukoiDialogue: 50,0:22:52.60,0:22:54.43,Main-207+,,0,0,0,,Yapma...Dialogue: 50,0:22:56.67,0:22:57.77,Main-207+,,0,0,0,,N'oluyor?Dialogue: 50,0:23:37.40,0:23:40.51,Main-207+,,0,0,0,,K-Kurtuldum mu?Dialogue: 50,0:23:53.10,0:23:55.96,Main-207+,,0,0,0,,Y-Yokozuna...Dialogue: 50,0:23:55.96,0:23:59.99,Main-207+,,0,0,0,,havaya uçuruldu!Dialogue: 50,0:24:00.37,0:24:02.79,Main-207+,,0,0,0,,Yokozuna!Dialogue: 50,0:24:02.79,0:24:06.75,Main-207+,,0,0,0,,Yok daha neler! Bacaksızın tekine yenilemez ki!Dialogue: 50,0:24:16.36,0:24:19.31,Main-207+,,0,0,0,,Artık yokozuna benim!Dialogue: 50,0:24:19.31,0:24:23.81,Main-207+,,0,0,0,,Karşıma kim çıkacaksa çıksın!Dialogue: 50,0:24:26.92,0:24:30.03,Main-207+,,0,0,0,,Bu curcunanın üzerine patronları ortaya çıkar herhâlde.Dialogue: 50,0:24:31.06,0:24:32.07,Main-207+,,0,0,0,,Bence de!Dialogue: 50,0:24:33.20,0:24:35.03,Main-207+,,0,0,0,,O-O adam...Dialogue: 50,0:24:35.56,0:24:38.99,Main-207+,,0,0,0,,Hatırladım! Sulh hakimi katili!Dialogue: 50,0:24:42.00,0:24:43.92,Main-207+,,0,0,0,,Zorojuro mu?Dialogue: 50,0:24:52.10,0:24:53.93,Main-207+,,0,0,0,,Ne olmuş öyleyse?Dialogue: 50,0:25:00.12,0:25:03.33,Main-207+,,0,0,0,,Yoksa bu işte birlikteler mi?Dialogue: 50,0:25:07.27,0:25:08.48,Main-207+,,0,0,0,,Hey!Dialogue: 50,0:25:09.91,0:25:12.44,Main-207+,,0,0,0,,Kasabanın patronunu getirin!Dialogue: 50,0:25:36.38,0:25:38.72,Main-207+,,0,0,0,,Tama'yı almaya geldik!Dialogue: 0,0:01:41.91,0:01:44.41,Title-207+,,0,0,0,,Wano'nun Büyük Sumo TurnuvasıDialogue: 1,0:01:41.91,0:01:44.41,Title-207+,,0,0,0,,Wano'nun Büyük Sumo TurnuvasıDialogue: 0,0:03:26.22,0:03:31.14,Captions Wano,,0,0,0,,UrashimaDialogue: 1,0:03:26.22,0:03:31.14,Captions Wano,,0,0,0,,UrashimaDialogue: 0,0:03:26.22,0:03:31.14,Sign 3,,0,0,0,,Wano Sumo Güreşçisi, YokozunaDialogue: 1,0:03:26.22,0:03:31.14,Sign 3,,0,0,0,,Wano Sumo Güreşçisi, YokozunaDialogue: 0,0:04:59.44,0:04:59.57,Sign - Peace,,0,0,0,,Ülkeye barış                          egemendir.Dialogue: 1,0:04:59.44,0:04:59.57,Sign - Peace,,0,0,0,,Ülkeye barış                          egemendir.Dialogue: 0,0:04:59.57,0:04:59.69,Sign - Peace,,0,0,0,,Ülkeye barış                     egemendir.Dialogue: 1,0:04:59.57,0:04:59.69,Sign - Peace,,0,0,0,,Ülkeye barış                     egemendir.Dialogue: 0,0:04:59.69,0:04:59.82,Sign - Peace,,0,0,0,,Ülkeye barış                     egemendir.Dialogue: 1,0:04:59.69,0:04:59.82,Sign - Peace,,0,0,0,,Ülkeye barış                     egemendir.Dialogue: 0,0:04:59.82,0:04:59.94,Sign - Peace,,0,0,0,,Ülkeye barış                     egemendir.Dialogue: 1,0:04:59.82,0:04:59.94,Sign - Peace,,0,0,0,,Ülkeye barış                     egemendir.Dialogue: 0,0:04:59.94,0:05:00.07,Sign - Peace,,0,0,0,,