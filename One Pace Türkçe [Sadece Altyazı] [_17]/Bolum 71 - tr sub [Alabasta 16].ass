0,0,0,0,0,100,100,0,0,1,1.9,1.9,2,180,180,27,1Style: RogerMonologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1Style: Karaoke,Duality,68,&H00292CC7,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,4,0,1,6.8,0,8,23,23,23,1Style: Translation,Duality,68,&H00292CC7,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,4,0,1,6.8,0,2,23,23,34,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:49.92,0:01:59.91,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 50,0:02:16.41,0:02:18.16,Main-207-,,0,0,0,,Zamanında yetiştim.Dialogue: 50,0:02:21.16,0:02:22.58,Main-207-,,0,0,0,,Luffy-san...Dialogue: 50,0:02:22.58,0:02:23.75,Main-207-,,0,0,0,,Pell...Dialogue: 50,0:02:23.75,0:02:27.50,Main-207-,,0,0,0,,Meydanın havaya uçmasına çok az zaman kaldı...Dialogue: 50,0:02:31.21,0:02:32.30,Main-207-,,0,0,0,,Herkes...Dialogue: 50,0:02:33.42,0:02:35.05,Main-207-,,0,0,0,,ölecek!Dialogue: 50,0:02:38.01,0:02:42.77,Main-207-,,0,0,0,,Sesim kimseye ulaşmıyor.Dialogue: 50,0:02:44.02,0:02:47.15,Main-207-,,0,0,0,,Bu durumda, ülke...Dialogue: 50,0:02:49.94,0:02:51.82,Main-207-,,0,0,0,,Endişelenme.Dialogue: 50,0:02:56.11,0:02:58.57,Main-207-,,0,0,0,,Biz seni gayet iyi duyabiliyoruz!Dialogue: 50,0:03:08.71,0:03:13.41,Main-207-,,0,0,0,,Yine söylüyorum, yaralarım seninkilerden daha berbat durumda!Dialogue: 50,0:03:13.41,0:03:17.39,Main-207-,,0,0,0,,Sen erkeksin, sızlanmayı kes! Bacağım acıyor! Ayakta duramıyoru–Dialogue: 50,0:03:17.39,0:03:18.80,Main-207-,,0,0,0,,Ah, bayılacağım.Dialogue: 50,0:03:19.35,0:03:20.93,Main-207-,,0,0,0,,Yalancı!Dialogue: 50,0:03:26.19,0:03:28.65,Main-207-,,0,0,0,,Dikkatli ol, Luffy-kun.Dialogue: 50,0:03:29.11,0:03:32.61,Main-207-,,0,0,0,,Bir ton et yedim. Çok fazla enerjim var!Dialogue: 50,0:03:37.11,0:03:38.03,Main-207-,,0,0,0,,Bir daha...Dialogue: 50,0:03:38.82,0:03:40.91,Main-207-,,0,0,0,,kaybetmeyeceğim!Dialogue: 50,0:03:41.45,0:03:45.12,Main-207-,,0,0,0,,O yaralarla batan kumdan nasıl kaçabildi?Dialogue: 50,0:03:51.25,0:03:53.09,Main-207-,,0,0,0,,Luffy yaşıyor!Dialogue: 50,0:03:54.84,0:03:56.05,Main-207-,,0,0,0,,Tony-kun!Dialogue: 50,0:03:56.05,0:03:58.05,Main-207-,,0,0,0,,N-N-N-Ne?!Dialogue: 50,0:03:58.05,0:03:59.47,Main-207-,,0,0,0,,Luffy!Dialogue: 50,0:03:59.47,0:04:01.18,Main-207-,,0,0,0,,Vivi de orada!Dialogue: 50,0:04:02.18,0:04:06.56,Main-207-,,0,0,0,,Gö-Gördün mü?! Yaşadığını söylemiştim! Ondan hiç şüphe etmedim!Dialogue: 50,0:04:06.56,0:04:07.73,Main-207-,,0,0,0,,Öyle mi?Dialogue: 50,0:04:07.73,0:04:10.52,Main-207-,,0,0,0,,Yüzündeki ifadeye bakılırsa öyle düşünmüyordun.Dialogue: 50,0:04:13.02,0:04:14.86,Main-207-,,0,0,0,,Usopp-san, Sanji-san!Dialogue: 50,0:04:15.99,0:04:17.86,Main-207-,,0,0,0,,Oh! Ne oldu, Vivi-chan?!Dialogue: 50,0:04:17.86,0:04:19.57,Main-207-,,0,0,0,,Çok kötü yaralanmışsın!Dialogue: 50,0:04:20.03,0:04:21.74,Main-207-,,0,0,0,,Usopp!Dialogue: 50,0:04:22.24,0:04:24.74,Main-207-,,0,0,0,,Nami-san, Bay Bushido...Dialogue: 50,0:04:27.00,0:04:29.21,Main-207-,,0,0,0,,Herkes güvende!Dialogue: 50,0:04:29.21,0:04:33.80,Main-207-,,0,0,0,,Parti numaraları için oyuncak yapmanı kim söyledi?!Dialogue: 50,0:04:33.80,0:04:35.88,Main-207-,,0,0,0,,Ayakta durabildiğini biliyordum!Dialogue: 50,0:04:35.88,0:04:38.17,Main-207-,,0,0,0,,Nami-swaan!Dialogue: 50,0:04:38.17,0:04:42.22,Main-207-,,0,0,0,,A-Ama işini gördü, değil mi?Dialogue: 50,0:04:42.22,0:04:45.22,Main-207-,,0,0,0,,Seninle sonra görüşeceğim!Dialogue: 50,0:04:45.22,0:04:46.06,Main-207-,,0,0,0,,Vivi...Dialogue: 50,0:04:47.10,0:04:50.19,Main-207-,,0,0,0,,Neler oluyor? Bu kum fırtınası da ne?!Dialogue: 50,0:04:50.19,0:04:50.94,Main-207-,,0,0,0,,Evet...Dialogue: 50,0:04:52.52,0:04:54.15,Main-207-,,0,0,0,,Hey, budala!Dialogue: 50,0:04:54.15,0:04:56.15,Main-207-,,0,0,0,,Nami-san, nasıl yaralandı?!Dialogue: 50,0:04:56.15,0:04:57.48,Main-207-,,0,0,0,,Seni öldüreceğim!Dialogue: 50,0:04:57.48,0:04:58.90,Main-207-,,0,0,0,,Hiçbir şeyi yok!Dialogue: 50,0:05:00.99,0:05:03.74,Main-207-,,0,0,0,,Chopper, bana bir iyilik yap.Dialogue: 50,0:05:03.74,0:05:06.37,Main-207-,,0,0,0,,Lütfen bedenimi çöle gömer misin?Dialogue: 50,0:05:06.99,0:05:09.96,Main-207-,,0,0,0,,Aniden ölümcül yaralarına yenik düştü!Dialogue: 50,0:05:10.29,0:05:11.87,Main-207-,,0,0,0,,Üzgünüm, çocuklar.Dialogue: 50,0:05:12.38,0:05:15.59,Main-207-,,0,0,0,,Ona karşı durdum ve yenildim.Dialogue: 50,0:05:17.09,0:05:18.55,Main-207-,,0,0,0,,Bu yüzden bir daha...Dialogue: 50,0:05:19.84,0:05:20.97,Main-207-,,0,0,0,,yenilmeyeceğim!Dialogue: 50,0:05:20.97,0:05:22.26,Main-207-,,0,0,0,,Gerisi sizde!Dialogue: 50,0:05:23.01,0:05:24.72,Main-207-,,0,0,0,,Bir an önce git.Dialogue: 50,0:05:27.18,0:05:29.35,Main-207-,,0,0,0,,Sen onu yenemezsen...Dialogue: 50,0:05:30.06,0:05:32.60,Main-207-,,0,0,0,,kim yenebilir?!Dialogue: 50,0:05:38.57,0:05:40.07,Main-207-,,0,0,0,,Şuna kesin olarak...Dialogue: 50,0:05:41.82,0:05:43.24,Main-207-,,0,0,0,,bir son verelim!Dialogue: 50,0:05:43.24,0:05:45.41,Main-207-,,0,0,0,,– Evet! – Evet!Dialogue: 50,0:05:50.50,0:05:51.62,Main-207-,,0,0,0,,Hepiniz...Dialogue: 50,0:05:53.00,0:05:56.46,Main-207-,,0,0,0,,Burada hâlâ arkadaşlarım var.Dialogue: 50,0:06:03.43,0:06:06.68,Main-207-,,0,0,0,,Seni piç!Dialogue: 50,0:06:13.94,0:06:19.57,Main-207-,,0,0,0,,Kaç kez dövüşürsek dövüşelim, bana bir kez bile vuramayacaksın!Dialogue: 50,0:06:19.98,0:06:22.28,Main-207-,,0,0,0,,Yine şişlenmek istiyorsun galiba.Dialogue: 50,0:06:58.98,0:07:00.23,Main-207-,,0,0,0,,Lastik-Lastik...Dialogue: 50,0:07:00.73,0:07:02.65,Main-207-,,0,0,0,,O da kim?!Dialogue: 50,0:07:14.33,0:07:16.67,Main-207-,,0,0,0,,Yoksa o...?!Dialogue: 50,0:07:16.67,0:07:20.25,Main-207-,,0,0,0,,Daire Testere!Dialogue: 50,0:07:49.41,0:07:51.24,Main-207-,,0,0,0,,Crocodile'a vurdu!Dialogue: 50,0:08:08.13,0:08:09.76,Main-207-,,0,0,0,,Vay vay...Dialogue: 50,0:08:21.56,0:08:22.69,Main-207-,,0,0,0,,Ayağa kalk.Dialogue: 50,0:08:24.53,0:08:29.70,Main-207-,,0,0,0,,Yuba suyunun eline dökülmesiyle her şey çözüldü.Dialogue: 50,0:08:30.16,0:08:34.08,Main-207-,,0,0,0,,Su sana değerse kuma dönüşemezsin.Dialogue: 50,0:08:35.87,0:08:39.96,Main-207-,,0,0,0,,Sudan korkuyorsun, değil mi?  Bu yüzden yağmuru çaldın.Dialogue: 50,0:08:43.86,0:08:46.21,Main-207-,,0,0,0,,Şimdi seni mahvedebilirim.Dialogue: 50,0:08:48.84,0:08:50.97,Main-207-,,0,0,0,,Gerçek dövüşe hazır ol.Dialogue: 50,0:08:52.80,0:08:54.01,Main-207-,,0,0,0,,Ne dedin sen?!Dialogue: 50,0:08:54.39,0:08:56.85,Main-207-,,0,0,0,,Meydan on dakika içinde bombalanacak mı?Dialogue: 50,0:08:57.25,0:08:58.45,Main-207-,,0,0,0,,10 dakikada mı?!Dialogue: 50,0:08:58.45,0:09:00.10,Main-207-,,0,0,0,,Bunu düşünecek vaktimiz yok!Dialogue: 50,0:09:00.10,0:09:03.15,Main-207-,,0,0,0,,Ama 5 kilometre çapında bir patlamaysa...Dialogue: 50,0:09:03.15,0:09:07.61,Main-207-,,0,0,0,,en azından 2,5 kilometre uzaktan atıyor olmalılar, değil mi?Dialogue: 50,0:09:07.61,0:09:09.11,Main-207-,,0,0,0,,Hayır, öyle değil.Dialogue: 50,0:09:09.11,0:09:13.03,Main-207-,,0,0,0,,Bombacılar daha çok meydana yakın olacak gibi!Dialogue: 50,0:09:13.03,0:09:15.20,Main-207-,,0,0,0,,Ne?! Neden?!Dialogue: 50,0:09:15.20,0:09:18.20,Main-207-,,0,0,0,,Öyleyse, bombacılar da herkesle birlikte havaya uçacak!Dialogue: 50,0:09:18.20,0:09:21.29,Main-207-,,0,0,0,,Crocodile böyle bir adam.Dialogue: 50,0:09:21.29,0:09:23.75,Main-207-,,0,0,0,,Kendi adamlarını mı öldürtecek?!Dialogue: 50,0:09:26.50,0:09:28.46,Main-207-,,0,0,0,,Kurnaz piç...Dialogue: 50,0:09:28.84,0:09:30.47,Main-207-,,0,0,0,,Acele etsek iyi olur.Dialogue: 50,0:09:40.81,0:09:43.02,Main-207-,,0,0,0,,Seni bulduk, Prenses Vivi!Dialogue: 50,0:09:43.02,0:09:46.65,Main-207-,,0,0,0,,Ölümün bize büyük bir terfi sağlayacak!Dialogue: 50,0:09:48.03,0:09:49.49,Main-207-,,0,0,0,,Milyarlar!Dialogue: 50,0:09:49.82,0:09:51.82,Main-207-,,0,0,0,,On dakika kaç saniyedir?Dialogue: 50,0:09:51.82,0:09:54.57,Main-207-,,0,0,0,,Hey, hey! Bunu bile konuşacak zamanımız yok!Dialogue: 50,0:09:55.28,0:09:56.28,Main-207-,,0,0,0,,2 saniye!Dialogue: 50,0:09:55.28,0:09:56.28,Main-207-,,0,0,0,,2 saniye!Dialogue: 50,0:09:56.28,0:09:57.62,Main-207-,,0,0,0,,Önden gideceğim!Dialogue: 50,0:09:57.62,0:09:58.74,Main-207-,,0,0,0,,– Ben de! – Ben de!Dialogue: 50,0:10:02.67,0:10:04.13,Main-207-,,0,0,0,,Yavaşlama, sersem!Dialogue: 50,0:10:04.67,0:10:07.92,Main-207-,,0,0,0,,Herkes ayrılsın! Bu lanet kum fırtınasından çıkmalıyız!Dialogue: 50,0:10:11.34,0:10:12.38,Thoughts-207-,,0,0,0,,Sadece on dakika!Dialogue: 50,0:10:13.01,0:10:14.51,Main-207-,,0,0,0,,Tamam, acele et! Gitmeliyiz!Dialogue: 50,0:10:14.51,0:10:15.68,Main-207-,,0,0,0,,Evet!Dialogue: 50,0:10:16.35,0:10:19.93,Thoughts-207-,,0,0,0,,Bu son şansımız!Dialogue: 50,0:10:20.77,0:10:22.48,Thoughts-207-,,0,0,0,,Ülkenin kaderi...Dialogue: 50,0:10:23.14,0:10:26.94,Thoughts-207-,,0,0,0,,on dakika içinde belli olacak!Dialogue: 50,0:10:35.57,0:10:38.24,Main-207-,,0,0,0,,Beni yenebileceğini mi düşünüyorsun?Dialogue: 50,0:10:38.62,0:10:39.79,Main-207-,,0,0,0,,Evet.Dialogue: 50,0:10:40.43,0:10:44.46,Main-207-,,0,0,0,,Ölümün eşiğindeyken bunu anlamış olmandan epey etkilendim.Dialogue: 50,0:10:44.87,0:10:49.50,Main-207-,,0,0,0,,Ama bu seni hâlâ benim seviyeme çıkarmaz—Dialogue: 50,0:10:49.50,0:10:52.72,Main-207-,,0,0,0,,Bir Shichibukai seviyesine.Dialogue: 50,0:10:52.72,0:10:55.63,Main-207-,,0,0,0,,Shichibukai'ysen ne olmuş?Dialogue: 50,0:10:55.63,0:10:56.97,Main-207-,,0,0,0,,Öyleyse ben...Dialogue: 50,0:10:57.97,0:10:59.43,Main-207-,,0,0,0,,Hachibukai'yim!Dialogue: 50,0:10:57.97,0:10:59.43,Note-207-,,0,0,0,,Shichi - 7     Hachi - 8Dialogue: 50,0:11:02.98,0:11:05.35,Main-207-,,0,0,0,,Kim bu adam Tanrı aşkına?!Dialogue: 50,0:11:05.73,0:11:06.98,Main-207-,,0,0,0,,Korsan.Dialogue: 50,0:11:06.98,0:11:09.02,Main-207-,,0,0,0,,Hiç duymadın mı?Dialogue: 50,0:11:09.02,0:11:13.65,Main-207-,,0,0,0,,Prenses bir kez daha ucu ucuna ölümden kaçmış gibi görünüyor.Dialogue: 50,0:11:13.65,0:11:18.07,Main-207-,,0,0,0,,Öyleyse Vivi'yi buraya getiren kişi o olmalı.Dialogue: 50,0:11:20.66,0:11:22.62,Main-207-,,0,0,0,,Lastik-Lastik...Dialogue: 50,0:11:22.62,0:11:24.21,Main-207-,,0,0,0,,Tabanca!Dialogue: 50,0:11:24.58,0:11:27.46,Main-207-,,0,0,0,,Saldırılarını atlatırsam stratejin bir işe yaramaz.Dialogue: 50,0:11:27.46,0:11:29.25,Main-207-,,0,0,0,,Suyla kaplanmış bile olsan,Dialogue: 50,0:11:30.38,0:11:34.05,Main-207-,,0,0,0,,yine de ellerimle seni kurutabilirim!Dialogue: 50,0:11:34.05,0:11:36.26,Main-207-,,0,0,0,,K-Kahretsin! Hâlâ bunu yapabiliyor!Dialogue: 50,0:11:49.90,0:11:51.90,Main-207-,,0,0,0,,Bunu söyleyen sendin, değil mi?Dialogue: 50,0:11:54.32,0:11:56.49,Main-207-,,0,0,0,,Şeytan Meyvesi'nin yeteneği...Dialogue: 50,0:11:56.49,0:11:58.36,Main-207-,,0,0,0,,nasıl kullandığına bağlı olarak,Dialogue: 50,0:11:58.36,0:12:00.28,Main-207-,,0,0,0,,daha da gelişebilir.Dialogue: 50,0:12:00.28,0:12:03.37,Main-207-,,0,0,0,,Lastik-Lastik Tabanca!Dialogue: 50,0:12:10.00,0:12:11.21,Main-207-,,0,0,0,,Çifte Tabanca!Dialogue: 50,0:12:11.21,0:12:12.67,Main-207-,,0,0,0,,Arsız velet!Dialogue: 50,0:12:12.67,0:12:14.34,Main-207-,,0,0,0,,Çöl Kılıcı!Dialogue: 50,0:12:15.46,0:12:16.38,Main-207-,,0,0,0,,Yine mi o?!Dialogue: 50,0:12:22.22,0:12:23.81,Main-207-,,0,0,0,,Çok yakındı...Dialogue: 50,0:12:24.56,0:12:26.43,Main-207-,,0,0,0,,Lastik-Lastik...!Dialogue: 50,0:12:27.52,0:12:30.35,Main-207-,,0,0,0,,Aynı saldırıları tekrar tekrar kullanarak,Dialogue: 50,0:12:30.35,0:12:31.69,Main-207-,,0,0,0,,kazanabilir misin?Dialogue: 50,0:12:31.69,0:12:32.40,Main-207-,,0,0,0,,Evet!Dialogue: 50,0:12:33.07,0:12:34.07,Main-207-,,0,0,0,,Kazanacağım!Dialogue: 50,0:12:37.49,0:12:39.78,Main-207-,,0,0,0,,Başından beri bunu planlıyordum!Dialogue: 50,0:12:39.78,0:12:41.07,Main-207-,,0,0,0,,Seni suyla kaplayacağım!Dialogue: 50,0:12:41.07,0:12:43.20,Main-207-,,0,0,0,,Ne anlaşılır bir strateji!Dialogue: 50,0:12:43.20,0:12:45.20,Main-207-,,0,0,0,,Kum Fırtınası!Dialogue: 50,0:12:55.63,0:12:57.59,Main-207-,,0,0,0,,Fıçı! Fıçı!Dialogue: 50,0:13:01.89,0:13:04.39,Main-207-,,0,0,0,,Ne kadar umutsuzsun, Hasır Şapka luffy!Dialogue: 50,0:13:04.39,0:13:08.06,Main-207-,,0,0,0,,Fıçı olmadan hiçbir şey yapamazsın.Dialogue: 50,0:13:08.06,0:13:10.98,Main-207-,,0,0,0,,Bu dövüşün ilk kapışmamızdan hiçbir farkı yok.Dialogue: 50,0:13:13.94,0:13:15.94,Main-207-,,0,0,0,,Haklısın.Dialogue: 50,0:13:16.65,0:13:18.86,Main-207-,,0,0,0,,Şimdiye dek hiçbir şey değişmedi.Dialogue: 50,0:13:27.70,0:13:28.95,Main-207-,,0,0,0,,Ya şimdi?!Dialogue: 50,0:13:30.54,0:13:32.54,Main-207-,,0,0,0,,Artık önceki gibi değilim!Dialogue: 50,0:13:32.88,0:13:34.59,Main-207-,,0,0,0,,Delirdin mi sen?Dialogue: 50,0:13:37.21,0:13:38.71,Main-207-,,0,0,0,,Su Luffy!Dialogue: 50,0:13:39.74,0:13:41.68,Main-207-,,0,0,0,,Ah! Kahretsin! Sızdırıyorum!Dialogue: 50,0:13:42.22,0:13:43.93,Thoughts-207-,,0,0,0,,Bu velet...Dialogue: 50,0:13:43.93,0:13:45.68,Thoughts-207-,,0,0,0,,ciddi mi?Dialogue: 50,0:13:47.10,0:13:48.77,Main-207-,,0,0,0,,Karnım suyla doldu...Dialogue: 50,0:13:51.31,0:13:53.35,Main-207-,,0,0,0,,Çok içtim galiba...Dialogue: 50,0:13:55.44,0:13:58.28,Thoughts-207-,,0,0,0,,İçinde bulunduğu durumu anlamıyor mu?Dialogue: 50,0:14:06.99,0:14:09.95,Main-207-,,0,0,0,,Bu kadar oyun yeter, velet!Dialogue: 50,0:14:22.72,0:14:24.01,Thoughts-207-,,0,0,0,,Kahretsin!Dialogue: 50,0:14:25.22,0:14:27.68,Main-207-,,0,0,0,,Oynayan kimmiş?Dialogue: 50,0:14:28.06,0:14:29.35,Thoughts-207-,,0,0,0,,Bedenim...Dialogue: 50,0:14:30.14,0:14:32.89,Main-207-,,0,0,0,,Ben her zaman ciddiyim!Dialogue: 50,0:14:32.89,0:14:34.35,Main-207-,,0,0,0,,Lastik-Lastik...Dialogue: 50,0:14:36.81,0:14:38.52,Main-207-,,0,0,0,,Bazuka!Dialogue: 50,0:14:59.46,0:15:02.17,Main-207-,,0,0,0,,Nasıldı, Kumcroc?Dialogue: 50,0:15:05.93,0:15:07.93,Main-207-,,0,0,0,,İnanılmaz...!Dialogue: 50,0:15:07.93,0:15:09.93,Main-207-,,0,0,0,,Crocodile'ı dövüyor...Dialogue: 50,0:15:10.43,0:15:13.89,Main-207-,,0,0,0,,Etkilenecek zaman değil, Bay Cobra.Dialogue: 50,0:15:17.77,0:15:20.94,Main-207-,,0,0,0,,Şimdi beni, poneglifin olduğu...Dialogue: 50,0:15:21.32,0:15:23.49,Main-207-,,0,0,0,,yere götüreceksin.Dialogue: 50,0:15:25.03,0:15:29.03,Main-207-,,0,0,0,,Onu görmek sana ne kazandıracak?Dialogue: 50,0:15:32.54,0:15:34.41,Main-207-,,0,0,0,,Aptalca sorular sorma.Dialogue: 50,0:15:34.41,0:15:37.25,Main-207-,,0,0,0,,Sadece yolu göster.Dialogue: 50,0:15:43.46,0:15:46.97,Main-207-,,0,0,0,,Hiç şansın kalmadı...Dialogue: 50,0:15:46.97,0:15:48.43,Main-207-,,0,0,0,,Çok zamanın yok.Dialogue: 50,0:15:53.18,0:15:55.81,Main-207-,,0,0,0,,Git buradan, Nico Robin.Dialogue: 50,0:15:55.81,0:15:58.40,Main-207-,,0,0,0,,Tabii sen de kurumak istemiyorsan.Dialogue: 50,0:15:59.02,0:16:02.86,Main-207-,,0,0,0,,Artık... sabrımı yitirdim.Dialogue: 50,0:16:03.23,0:16:05.07,Main-207-,,0,0,0,,Nico Robin mi?!Dialogue: 50,0:16:05.74,0:16:07.78,Main-207-,,0,0,0,,Pekâlâ. Nasıl isterseniz.Dialogue: 50,0:16:10.16,0:16:12.24,Main-207-,,0,0,0,,Dinle, Hasır Şapka.Dialogue: 50,0:16:12.24,0:16:15.04,Main-207-,,0,0,0,,Buradaki tüm kayaları...Dialogue: 50,0:16:15.04,0:16:16.96,Main-207-,,0,0,0,,un ufak edeceğim.Dialogue: 50,0:16:25.46,0:16:27.51,Main-207-,,0,0,0,,Otlar kuruyor!Dialogue: 50,0:16:32.93,0:16:34.81,Main-207-,,0,0,0,,Kurutma!Dialogue: 50,0:16:38.60,0:16:39.85,Main-207-,,0,0,0,,Ne oluyor...?!Dialogue: 50,0:16:42.27,0:16:44.07,Main-207-,,0,0,0,,Düşüyorum!Dialogue: 50,0:16:45.07,0:16:46.78,Main-207-,,0,0,0,,U-Ucuz kurtuldum!Dialogue: 50,0:16:46.78,0:16:48.78,Main-207-,,0,0,0,,Lanet olası!Dialogue: 50,0:16:48.78,0:16:51.62,Main-207-,,0,0,0,,Su-Su Tabanca!Dialogue: 50,0:16:55.08,0:16:57.58,Main-207-,,0,0,0,,Ne?! Suyu eliyle emdi!Dialogue: 50,0:16:57.97,0:17:02.50,Main-207-,,0,0,0,,Yeteneğimi engellemeye mi çalışıyorsun, Su Luffy?Dialogue: 50,0:17:04.38,0:17:07.46,Main-207-,,0,0,0,,Öyleyse, üzücü bir biçimde hatalısın.Dialogue: 50,0:17:08.01,0:17:11.26,Main-207-,,0,0,0,,Kumun gücü, mutlak kuruluğunda yatmaktadır.Dialogue: 50,0:17:11.26,0:17:12.47,Main-207-,,0,0,0,,İzle!Dialogue: 50,0:17:13.68,0:17:17.68,Main-207-,,0,0,0,,Bu sağ el dokunduğu her şeye kuruluk bahşediyor.Dialogue: 50,0:17:18.31,0:17:20.69,Main-207-,,0,0,0,,Sınırsız olarak.Dialogue: 50,0:17:46.63,0:17:48.17,Main-207-,,0,0,0,,Kayalar...Dialogue: 50,0:17:48.17,0:17:50.13,Main-207-,,0,0,0,,Heykeller bile kuma dönüşüyor!Dialogue: 50,0:17:54.01,0:17:55.51,Main-207-,,0,0,0,,Yer...Dialogue: 50,0:17:55.51,0:17:57.01,Main-207-,,0,0,0,,kuruyor!Dialogue: 50,0:17:58.43,0:17:59.47,Main-207-,,0,0,0,,Terliklerim bile!Dialogue: 50,0:18:00.23,0:18:03.10,Main-207-,,0,0,0,,Bu elin dokunduğu her şey...Dialogue: 50,0:18:03.73,0:18:05.65,Main-207-,,0,0,0,,kurur!Dialogue: 50,0:18:05.73,0:18:08.07,Main-207-,,0,0,0,,Erozyon Döngüsü!Dialogue: 50,0:18:30.88,0:18:33.63,Main-207-,,0,0,0,,Tam zamanında geldiniz, Denizciler.Dialogue: 50,0:18:33.63,0:18:36.09,Main-207-,,0,0,0,,Çekilin. Acelem var.Dialogue: 50,0:18:36.09,0:18:37.51,Main-207-,,0,0,0,,Bunu yapamam!Dialogue: 50,0:18:37.51,0:18:42.10,Main-207-,,0,0,0,,Yaralı bir asker, Alubarna'da olan biten her şeyi anlattı!Dialogue: 50,0:18:42.85,0:18:46.48,Main-207-,,0,0,0,,O adamın kim olduğunu sanıyorsun?!Dialogue: 50,0:18:46.48,0:18:48.73,Main-207-,,0,0,0,,Kim olduğu önemli değil.Dialogue: 50,0:18:48.73,0:18:51.44,Main-207-,,0,0,0,,Hükûmetle ilişkisi olanlardan nefret ediyorum.Dialogue: 50,0:18:51.44,0:18:54.57,Main-207-,,0,0,0,,Geçmeme izin vermezseniz...Dialogue: 50,0:18:55.20,0:18:57.57,Main-207-,,0,0,0,,Geçmene izin vermek niyetinde değilim!Dialogue: 50,0:18:58.58,0:19:00.74,Main-207-,,0,0,0,,Öyleyse, hepinizi öldürmek zorundayım.Dialogue: 50,0:19:00.74,0:19:03.41,Main-207-,,0,0,0,,Denizciler, durun! Bana ne olduğu önemli değil!Dialogue: 50,0:19:03.41,0:19:05.71,Main-207-,,0,0,0,,İsyanın patlak verdiği saray meydanı...Dialogue: 50,0:19:05.71,0:19:09.17,Main-207-,,0,0,0,,tam 4:30'da bir patlama tarafından yutulacak!Dialogue: 50,0:19:09.17,0:19:11.51,Main-207-,,0,0,0,,Lütfen, patlamayı durdurmalısınız!Dialogue: 50,0:19:11.51,0:19:12.80,Main-207-,,0,0,0,,Ne...?!Dialogue: 50,0:19:13.80,0:19:14.97,Main-207-,,0,0,0,,7 dakika sonra...!Dialogue: 50,0:19:15.34,0:19:18.72,Main-207-,,0,0,0,,Bir milyon insanımın hayatı tehlikede!Dialogue: 50,0:19:18.72,0:19:19.68,Main-207-,,0,0,0,,Ama...Dialogue: 50,0:19:20.68,0:19:23.89,Main-207-,,0,0,0,,Önce seni kurtaralım, sonra patlamayı durdururuz!Dialogue: 50,0:19:23.89,0:19:25.27,Main-207-,,0,0,0,,Durun! Bu kadın–Dialogue: 50,0:19:25.27,0:19:26.85,Main-207-,,0,0,0,,Hazırlanın!Dialogue: 50,0:19:27.60,0:19:28.77,Main-207-,,0,0,0,,Yoluma çıkmayın!Dialogue: 50,0:19:29.15,0:19:30.69,Main-207-,,0,0,0,,30 Çiçek!Dialogue: 50,0:19:31.94,0:19:33.19,Main-207-,,0,0,0,,Boğma!Dialogue: 50,0:19:34.78,0:19:35.65,Main-207-,,0,0,0,,Şeytan meyvesi...!Dialogue: 50,0:19:36.03,0:19:37.78,Main-207-,,0,0,0,,Acelem var demiştim, değil mi?Dialogue: 50,0:19:37.78,0:19:39.87,Main-207-,,0,0,0,,Beni daha fazla kızdırmayın!Dialogue: 50,0:19:41.83,0:19:42.95,Main-207-,,0,0,0,,Başçavuş!Dialogue: 50,0:19:42.95,0:19:44.79,Main-207-,,0,0,0,,Bu kadın, Nico Robin!Dialogue: 50,0:19:45.71,0:19:46.83,Main-207-,,0,0,0,,Eminim!Dialogue: 50,0:19:47.33,0:19:51.09,Main-207-,,0,0,0,,Albay Smoker, onun aranıyor posterlerini asmamı söylemişti!Dialogue: 50,0:19:51.09,0:19:53.09,Main-207-,,0,0,0,,Bu kadının kellesine...Dialogue: 50,0:19:53.09,0:19:57.18,Main-207-,,0,0,0,,yirmi yıl önce dünya çapında büyük bir ödül konuldu!Dialogue: 50,0:19:57.18,0:20:01.10,Main-207-,,0,0,0,,Gazete yazısını bile hatırlıyorum.Dialogue: 50,0:20:01.10,0:20:05.35,Main-207-,,0,0,0,,Altı Denizci savaş gemisinin batırıldığı olayın faili oydu.Dialogue: 50,0:20:05.35,0:20:09.81,Main-207-,,0,0,0,,Bunu yaparken henüz sadece sekiz yaşındaydı.Dialogue: 50,0:20:09.81,0:20:13.94,Main-207-,,0,0,0,,Hükûmet tarafından üst düzey bir suçlu olarak ilan edildi...Dialogue: 50,0:20:13.94,0:20:18.07,Main-207-,,0,0,0,,ve kellesine 79 milyon beli ödül kondu!Dialogue: 50,0:20:18.07,0:20:22.12,Main-207-,,0,0,0,,Bunun ardından, hiçbir iz bırakmadan ortadan kayboldu.Dialogue: 50,0:20:22.12,0:20:23.87,Main-207-,,0,0,0,,Gevezeliği kes!Dialogue: 50,0:20:23.87,0:20:26.96,Main-207-,,0,0,0,,Çekilin ya da ölün! Hangisi?Dialogue: 50,0:20:27.79,0:20:30.25,Thoughts-207-,,0,0,0,,Sayımızı dert etmiyor gibi görünüyor.Dialogue: 50,0:20:33.17,0:20:36.67,Main-207-,,0,0,0,,Çavuş! Herkesi meydana götür ve patlamayı durdur!Dialogue: 50,0:20:36.67,0:20:37.88,Main-207-,,0,0,0,,Ama, Başçavuş...!Dialogue: 50,0:20:37.88,0:20:40.26,Main-207-,,0,0,0,,Çabuk! Sadece altı dakika kaldı!Dialogue: 50,0:20:40.26,0:20:41.18,Main-207-,,0,0,0,,Başüstüne!Dialogue: 50,0:20:47.93,0:20:50.56,Main-207-,,0,0,0,,Şimdi, bırak onu!Dialogue: 50,0:20:50.90,0:20:52.81,Main-207-,,0,0,0,,Seni uyardım!Dialogue: 50,0:21:27.77,0:21:29.60,Main-207-,,0,0,0,,Ucuz atlattım.Dialogue: 50,0:21:29.60,0:21:31.90,Main-207-,,0,0,0,,Sağ eli çok tehlikeli...Dialogue: 50,0:21:33.36,0:21:36.27,Main-207-,,0,0,0,,Bahçe çöle döndü.Dialogue: 50,0:21:38.86,0:21:40.86,Main-207-,,0,0,0,,Nereye gitti bu?Dialogue: 50,0:21:48.70,0:21:51.50,Main-207-,,0,0,0,,Kendimi çok fazla zorlamama neden oldun.Dialogue: 50,0:22:01.84,0:22:02.88,Main-207-,,0,0,0,,Iskaladın.Dialogue: 50,0:22:05.10,0:22:06.81,Main-207-,,0,0,0,,Croco...Dialogue: 50,0:22:19.90,0:22:22.15,Main-207-,,0,0,0,,Bir kez daha...Dialogue: 50,0:22:22.15,0:22:24.11,Main-207-,,0,0,0,,kaybettin,Dialogue: 50,0:22:25.32,0:22:27.37,Main-207-,,0,0,0,,Hasır Şapkalı Luffy.Dialogue: 0,0:01:49.96,0:01:53.51,Title-207-,,0,0,0,,UMUT!!Dialogue: 0,0:00:01.73,0:00:03.73,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 1,0:00:01.73,0:00:03.73,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 0,0:00:01.73,0:00:03.73,Credits-207-,,0,0,0,,Gigglebot fedewDialogue: 1,0:00:01.73,0:00:03.73,Credits-207-,,0,0,0,,Gigg