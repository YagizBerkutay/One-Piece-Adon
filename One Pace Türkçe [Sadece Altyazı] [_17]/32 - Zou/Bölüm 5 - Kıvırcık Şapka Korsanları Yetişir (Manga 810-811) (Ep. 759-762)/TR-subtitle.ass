Dialogue: 0,0:01:41.80,0:01:44.80,Title,,0,0,250,,{\fad(250,250)}Kıvırcık Şapka Korsanları Yetişir
Dialogue: 0,0:01:44.87,0:01:50.20,Captions,,0,507,7,,{\fad(700,0)\b1\bord8\fs78\fnPragmatica\fscx115}1 Milyar Beli
Dialogue: 0,0:01:54.86,0:01:59.83,Main,,0,0,0,,Fil Fil Meyvesi'nin çok eski bir türü olmalı.\NEpey nadir bir meyve yemişsin!
Dialogue: 0,0:02:00.28,0:02:03.28,Main,,0,0,0,,Daha bu kadar çok askerleri varmış ha?
Dialogue: 0,0:02:12.00,0:02:16.54,Main,,0,0,0,,Köpek size uslu uslu söylerken\Nçekilecektiniz!
Dialogue: 0,0:02:16.54,0:02:17.40,Main,,0,0,0,,Efendim!
Dialogue: 0,0:02:18.88,0:02:22.38,Main,,0,0,0,,Asker sayısı olarak\Nbüyük ülkelerle yarışırız!
Dialogue: 0,0:02:25.76,0:02:26.99,Main,,0,0,0,,Bepo!
Dialogue: 0,0:02:27.46,0:02:29.98,Main,,0,0,0,,Siz-gara'lar hâlâ\Nbenim korumam altındasınız!
Dialogue: 0,0:02:30.36,0:02:32.63,Main,,0,0,0,,Savaşmanıza gerek yok!
Dialogue: 0,0:02:33.04,0:02:36.07,Main,,0,0,0,,Olmaz öyle Efendim!
Dialogue: 0,0:02:36.64,0:02:40.14,Main,,0,0,0,,Korsan bile olsam burası benim ülkem!
Dialogue: 0,0:02:40.14,0:02:41.48,Main,,0,0,0,,Bizim için de...
Dialogue: 0,0:02:41.48,0:02:43.04,Main,,0,0,0,,Dostumuzun ülkesi!
Dialogue: 0,0:02:44.44,0:02:46.56,Main,,0,0,0,,Daha tam olmadınız!
Dialogue: 0,0:02:47.72,0:02:50.13,Main,,0,0,0,,Her şeyi yok edeceğim!
Dialogue: 0,0:02:50.13,0:02:52.18,Main,,0,0,0,,Kolay olacak sanma!
Dialogue: 0,0:03:20.18,0:03:21.02,Main,,0,0,0,,Sabah olmuş bile!
Dialogue: 0,0:03:26.14,0:03:28.12,Main,,0,0,0,,Hâlâ vazgeçmedin mi Jack!?
Dialogue: 0,0:03:37.10,0:03:40.48,Main,,0,0,0,,Savaşçılarımızı gece-gündüz değiştirerek...
Dialogue: 0,0:03:40.48,0:03:45.58,Main,,0,0,0,,...iki gün, üç gün, dört gün derken\Nhep savaştık.
Dialogue: 0,0:03:46.18,0:03:51.80,Main,,0,0,0,,Fakat denizden aralıksız gelen Jack'in\Nadamlarıyla zar zor baş edebiliyorduk.
Dialogue: 0,0:03:52.24,0:03:55.74,Main,,0,0,0,,Düşman sonu olmayan\Nbir zombi ordusu gibiydi!
Dialogue: 0,0:03:56.64,0:04:00.76,Main,,0,0,0,,Fakat üstünlük hep bizdeydi!
Dialogue: 0,0:04:02.08,0:04:07.29,Main,,0,0,0,,Hatta aralarında\Nyenemediğimiz yegane kişi...
Dialogue: 0,0:04:07.82,0:04:08.99,Main,,0,0,0,,...Jack'ın ta kendisiydi!
Dialogue: 0,0:04:10.12,0:04:12.23,Main,,0,0,0,,O gerçekten de bir canavardı!
Dialogue: 0,0:04:16.42,0:04:19.96,Main,,0,0,0,,Bu ihtiyarın bile yenemediği adam\NKaidou'nun adamı ha?
Dialogue: 0,0:04:20.28,0:04:20.97,Main,,0,0,0,,Vay canına!
Dialogue: 0,0:04:21.59,0:04:23.99,Main,,0,0,0,,Ama düşman da zorlanıyordu.
Dialogue: 0,0:04:23.99,0:04:29.54,Main,,0,0,0,,Jack de iki hükümdarı kendi gücüyle\Nyenemediğinden olsa gerek...
Dialogue: 0,0:04:29.54,0:04:33.06,Main,,0,0,0,,...beşinci gün, sonunda bir silah getirdi!
Dialogue: 0,0:04:34.78,0:04:36.02,Main,,0,0,0,,Size bahsettiğim...
Dialogue: 0,0:04:41.59,0:04:43.23,Main,,0,0,0,,...zehirli gaz silahıydı.
Dialogue: 0,0:04:43.90,0:04:45.60,Main,,0,0,0,,Her şey çok hızlı oldu.
Dialogue: 0,0:04:48.62,0:04:52.52,Main,,0,0,0,,Patlama dalgası hızında yayılan\Nzehirli gaz tüm ülkeyi kaplamıştı!
Dialogue: 0,0:04:52.98,0:04:54.80,Main,,0,0,0,,Bundan nasıl kaçabilirdik ki?!
Dialogue: 0,0:04:55.98,0:05:03.90,Main,,0,0,0,,Gaz tüm şehri ve ormanın yarısını içine alıp hepimizi felç etti.
Dialogue: 0,0:05:04.90,0:05:09.06,Main,,0,0,0,,Kalenin dış kısımlarına çekilen\Nkişiler hariç herkes yenildi!
Dialogue: 0,0:05:10.24,0:05:14.45,Main,,0,0,0,,Oradan sonra olanları\Nhatırlamak dahi istemiyorum!
Dialogue: 0,0:05:18.58,0:05:20.48,Main,,0,0,0,,Soruma cevap ver!
Dialogue: 0,0:05:22.32,0:05:24.89,Main,,0,0,0,,Wano Krallığı'nın savaşçısı nerede?!
Dialogue: 0,0:05:24.89,0:05:25.76,Main,,0,0,0,,Burada değil!
Dialogue: 0,0:05:33.28,0:05:36.35,Main,,0,0,0,,Cevabını bildikleri soruları\Nsorup durdular!
Dialogue: 0,0:05:36.35,0:05:39.28,Main,,0,0,0,,Savaşçılarımıza işkence edip\Nülkemizi parçaladılar!
Dialogue: 0,0:05:40.56,0:05:47.63,Main,,0,0,0,,Sonra da gaz yüzünden hareket edemeyen Nekomamushi Efendi'yi ve Muhafızları bulup...
Dialogue: 0,0:05:49.26,0:05:51.30,Main,,0,0,0,,...aynı şeyleri onlara da yaptılar.
Dialogue: 0,0:05:52.24,0:05:54.40,Main,,0,0,0,,Ama bu şekilde bir sonuca\Nvaramadıklarını görünce...
Dialogue: 0,0:05:57.55,0:06:02.20,Main,,0,0,0,,...güçlü olanlarımızı\Nçarmıha gerip işkence ettiler.
Dialogue: 0,0:06:03.40,0:06:05.70,Main,,0,0,0,,Wana Krallığı'nın savaşçısı nerede?!
Dialogue: 0,0:06:05.70,0:06:06.97,Main,,0,0,0,,Bilmiyorum!
Dialogue: 0,0:06:06.97,0:06:08.75,Main,,0,0,0,,Böyle bir şeyi neden saklayalım?!
Dialogue: 0,0:06:11.28,0:06:13.02,Main,,0,0,0,,Durun artık...
Dialogue: 0,0:06:15.55,0:06:19.76,Main,,0,0,0,,Bu ülkedeki kimse hiçbir şey bilmiyor!
Dialogue: 0,0:06:19.76,0:06:23.63,Main,,0,0,0,,Gerçekten boş yere can alıyorsunuz!\NMerhametsizlik bu!
Dialogue: 0,0:06:36.98,0:06:40.55,Main,,0,0,0,,Ölsem bile bu böyle kalmayacak Jack!
Dialogue: 0,0:06:40.94,0:06:44.78,Main,,0,0,0,,Kedi kinimle sen-gara ölene kadar\Nlanetleyeceğim seni!
Dialogue: 0,0:06:50.64,0:06:54.70,Main,,0,0,0,,Bu olaylar bütün gün sürdü\Nve altıncı günde...
Dialogue: 0,0:06:55.20,0:06:57.68,Main,,0,0,0,,...gerçekleştirdiği yıkımdan\Nmemnun olduğundan mıdır...
Dialogue: 0,0:06:57.71,0:07:00.10,Main,,0,0,0,,...yoksa aynı cevapları almaktan\Nbıktığından mıdır bilinmez...
Dialogue: 0,0:07:00.87,0:07:05.87,Main,,0,0,0,,...Jack bir avuç adamını bırakıp\Nülkeden ayrıldı.
Dialogue: 0,0:07:05.87,0:07:07.28,Main,,0,0,0,,Dehşet verici bir olay!
Dialogue: 0,0:07:07.28,0:07:10.03,Main,,0,0,0,,Hiçbir kurtuluş yokmuş.
Dialogue: 0,0:07:10.03,0:07:13.32,Main,,0,0,0,,Hayır, bu aslında hayatımızı kurtardı.
Dialogue: 0,0:07:13.32,0:07:15.06,Main,,0,0,0,,Uyandın mı?!
Dialogue: 0,0:07:15.38,0:07:19.12,Main,,0,0,0,,Gazetede Jack'in\Nölüm ilanını görünce anladım.
Dialogue: 0,0:07:20.54,0:07:23.94,Captions,,230,0,220,,{\fr-36\fs90\be1\c&H272829&\3c&H272829&\3a&HC8&}Jack öldü!
Dialogue: 0,0:07:20.54,0:07:23.94,Captions,,0,0,0,,{\pos(640,580)\fr-37\be1\c&H272829&\3c&H272829&\3a&HC8&}Canavar Korsanları'nın Yıldız Üyesi
Dialogue: 0,0:07:20.54,0:07:23.94,Captions,,0,0,0,,{\pos(500,680)\fr-37\be1\c&H272829&\3c&H272829&\3a&HC8&}"Kuraklık Jack"
Dialogue: 0,0:07:21.12,0:07:23.92,Main,,0,0,0,,Jack bu demek?
Dialogue: 0,0:07:23.92,0:07:27.62,Main,,0,0,0,,Siz-gara'ların Doflamingo'yu yendiğiniz gün...
Dialogue: 0,0:07:27.62,0:07:30.30,Main,,0,0,0,,...Jack bu ülkeden ayrıldı.
Dialogue: 0,0:07:31.44,0:07:35.66,Main,,0,0,0,,Jack bu ülkeden\NDoflamingo'yu kurtarmak için ayrıldı.
Dialogue: 0,0:07:36.08,0:07:38.98,Main,,0,0,0,,Belki de aralarında\Nderin bir bağ falan vardı.
Dialogue: 0,0:07:39.64,0:07:44.41,Main,,0,0,0,,Yani o canavarı\Nbu ülkeden uzaklaştıran kişiler...
Dialogue: 0,0:07:44.41,0:07:45.94,Main,,0,0,0,,...siz-gara'lardınız.
Dialogue: 0,0:07:49.44,0:07:50.45,Main,,0,0,0,,Gene uyuyakaldı!
Dialogue: 0,0:07:51.78,0:07:53.25,Main,,0,0,0,,Anlıyorum!
Dialogue: 0,0:07:53.25,0:07:57.40,Main,,0,0,0,,Bunu da düşününce size minnetim de \Nmucizeye olan inancım da artıyor!
Dialogue: 0,0:07:57.40,0:08:02.13,Main,,0,0,0,,Buraya Jack ayrıldıktan\Nsonraki gün ayak bastık!
Dialogue: 0,0:08:06.54,0:08:07.89,Main,,0,0,0,,Bu...
Dialogue: 0,0:08:07.89,0:08:09.26,Main,,0,0,0,,...Zou mu?!
Dialogue: 0,0:08:13.68,0:08:17.28,Main,,0,0,0,,Uyarmadı demeyin!\NOraya ayak basma fikrine karşıyım!
Dialogue: 0,0:08:21.58,0:08:23.37,Main,,0,0,0,,Sizi var ya!
Dialogue: 0,0:08:23.37,0:08:24.63,Main,,0,0,0,,Kapa çeneni ve uç!
Dialogue: 0,0:08:24.63,0:08:27.89,Main,,0,0,0,,Lanet olsun!\NBu yanınıza kalmaz bilesiniz!
Dialogue: 0,0:08:33.94,0:08:35.10,Main,,0,0,0,,Bu...
Dialogue: 0,0:08:46.47,0:08:47.44,Main,,0,0,0,,Sanji-kun!
Dialogue: 0,0:08:48.94,0:08:49.98,Main,,0,0,0,,Kapı...
Dialogue: 0,0:08:49.98,0:08:53.40,Main,,0,0,0,,Devasa bir güçle kırılıp açılmış gibi.
Dialogue: 0,0:08:53.40,0:08:55.36,Main,,0,0,0,,Bir tür saldırı yaşandığı su götürmez.
Dialogue: 0,0:08:55.36,0:08:58.94,Main,,0,0,0,,Sa-Saldırı mı?!\NBize de mi düşmanlar acaba?!
Dialogue: 0,0:08:58.94,0:09:02.86,Main,,0,0,0,,Brook! Nami-san burada sana emanet.\NBen içlere doğru bir bakayım.
Dialogue: 0,0:09:02.86,0:09:04.42,Main,,0,0,0,,Elbette.
Dialogue: 0,0:09:04.42,0:09:07.30,Main,,0,0,0,,Onami'yi ben de korurum!
Dialogue: 0,0:09:07.30,0:09:09.10,Main,,0,0,0,,Chopper, Caesar! Gidelim!
Dialogue: 0,0:09:09.10,0:09:10.69,Main,,0,0,0,,Neden ben de gidiyo-
Dialogue: 0,0:09:11.18,0:09:12.73,Main,,0,0,0,,Yürü dediysek yürü işte!
Dialogue: 0,0:09:12.73,0:09:14.78,Main,,0,0,0,,Görüşürüz!
Dialogue: 0,0:09:14.78,0:09:16.17,Main,,0,0,0,,Çabuk dönün!
Dialogue: 0,0:09:17.44,0:09:19.30,Main,,0,0,0,,Terk edilmiş gibi görünüyor.
Dialogue: 0,0:09:19.30,0:09:22.37,Main,,0,0,0,,Ne muhafız ne de bir bekçi var...\NNe oldu acaba?
Dialogue: 0,0:09:23.58,0:09:25.27,Main,,0,0,0,,Yardım edin!
Dialogue: 0,0:09:25.27,0:09:26.64,Main,,0,0,0,,Ne oluyor?!
Dialogue: 0,0:09:31.20,0:09:33.32,Thoughts,,0,0,0,,O mu konuştu?!
Dialogue: 0,0:09:33.74,0:09:34.92,Thoughts,,0,0,0,,Durum ne olabilir?!
Dialogue: 0,0:09:35.78,0:09:39.86,Thoughts,,0,0,0,,Aha bu herif kötüyüm diye bas bas bağırıyor! \NYani o kızcağız mağdur!
Dialogue: 0,0:09:41.00,0:09:41.74,Main,,0,0,0,,Bu taraftan!
Dialogue: 0,0:09:43.64,0:09:46.16,Main,,0,0,0,,Bekle bakalım küçük sincap!
Dialogue: 0,0:09:46.16,0:09:49.55,Main,,0,0,0,,Seni azıcık çarmıha gerip\Nbirkaç soru soracağız sadece!
Dialogue: 0,0:09:49.55,0:09:50.80,Main,,0,0,0,,Siz de kimsiniz?!
Dialogue: 0,0:09:50.80,0:09:52.64,Main,,0,0,0,,Brook! O ikisiyle ilgilen lütfen!
Dialogue: 0,0:09:53.04,0:09:53.84,Main,,0,0,0,,Peki.
Dialogue: 0,0:10:04.54,0:10:06.00,Main,,0,0,0,,Yürü!
Dialogue: 0,0:10:11.72,0:10:13.59,Main,,0,0,0,,{\fad(150,150)}Soul Parade!
Dialogue: 0,0:10:11.72,0:10:13.59,Attack,,0,0,0,,{\fad(150,150)}Ruh Geçidi
Dialogue: 0,0:10:16.86,0:10:18.44,Main,,0,0,0,,{\fad(150,150)}Ice Burn!
Dialogue: 0,0:10:16.86,0:10:18.44,Attack,,0,0,0,,{\fad(150,150)}Buz Yanığı
Dialogue: 0,0:10:22.68,0:10:23.47,Main,,0,0,0,,Yaşasın!
Dialogue: 0,0:10:23.47,0:10:25.40,Main,,0,0,0,,Süpersin Kemikiçi!
Dialogue: 0,0:10:25.92,0:10:27.36,Main,,0,0,0,,Sağ ol Brook!
Dialogue: 0,0:10:27.36,0:10:30.26,Thoughts,,0,0,0,,Kemik de yılan balığı da konuşuyor!\NKorkunç!
Dialogue: 0,0:10:32.34,0:10:35.28,Main,,0,0,0,,Bekle biraz! Hey!\NBu adada ne oluyor?!
Dialogue: 0,0:10:43.18,0:10:44.89,Main,,0,0,0,,Ne olmuş burada?!
Dialogue: 0,0:10:45.52,0:10:47.20,Main,,0,0,0,,Gazla dolu.
Dialogue: 0,0:10:48.32,0:10:51.47,Main,,0,0,0,,Yerdekilerin hepsi de hayvan mı böyle?!
Dialogue: 0,0:10:51.47,0:10:55.46,Main,,0,0,0,,Aptallar! Mink Kabilesi bu!\NBilmiyor muydunuz?!
Dialogue: 0,0:10:58.80,0:11:03.13,Main,,0,0,0,,Neyse ne, şimdilik ormana geri dönelim!\NGaz bizim de sonumuz olacak!
Dialogue: 0,0:11:03.13,0:11:04.82,Main,,0,0,0,,Siz-garalar...
Dialogue: 0,0:11:07.02,0:11:09.68,Main,,0,0,0,,Hâlâ yaşıyorlar anlaşılan.
Dialogue: 0,0:11:10.74,0:11:13.24,Main,,0,0,0,,Onlar-gara'nın dostu değilsiniz değil mi?
Dialogue: 0,0:11:13.66,0:11:17.50,Main,,0,0,0,,Adım Pedro! Yardım edin.
Dialogue: 0,0:11:18.96,0:11:19.90,Main,,0,0,0,,Lütfen!
Dialogue: 0,0:11:20.74,0:11:26.40,Main,,0,0,0,,Dük Inuarashi ve Nekomamushi Efendi'nin\Nacil tedaviye ihtiyacı var!
Dialogue: 0,0:11:27.52,0:11:30.98,Main,,0,0,0,,Yoksa ikisi de ölecek!
Dialogue: 0,0:11:37.08,0:11:40.24,Main,,0,0,0,,Dünya onları bekliyor.
Dialogue: 0,0:11:41.78,0:11:44.26,Main,,0,0,0,,En azından o ikisinin...
Dialogue: 0,0:11:44.62,0:11:47.92,Main,,0,0,0,,...asla ama asla...
Dialogue: 0,0:11:49.06,0:11:52.06,Main,,0,0,0,,...ölmemesi lazım!
Dialogue: 0,0:12:03.21,0:12:08.25,Captions,,0,0,170,,{\fad(500,500)}Zou, 10 gün önce
Dialogue: 0,0:12:03.64,0:12:05.97,Main,,0,0,3,,Gör de inanma resmen!
Dialogue: 0,0:12:05.97,0:12:08.77,Main,,0,0,3,,{\fs54}Tüm ülke zehirli gaza teslim olmuş.
Dialogue: 0,0:12:10.82,0:12:12.68,Main,,0,0,0,,Gücüne tanık olmak\Ntüylerimi diken diken etti!
Dialogue: 0,0:12:15.04,0:12:16.41,Main,,0,0,0,,Niye gülüyorsun?!
Dialogue: 0,0:12:16.94,0:12:19.20,Main,,0,0,0,,Gazın adı Koro!
Dialogue: 0,0:12:19.54,0:12:22.22,Main,,0,0,0,,Benim icat ettiğim bir kitle imha silahı!
Dialogue: 0,0:12:22.22,0:12:23.78,Main,,0,0,0,,Ne dedin?!
Dialogue: 0,0:12:23.78,0:12:26.69,Main,,0,0,0,,O gaz benim ürünüm dedi-
Dialogue: 0,0:12:30.70,0:12:33.82,Main,,0,0,0,,Suçu niye bana atıyorsunuz şimdi?!
Dialogue: 0,0:12:34.24,0:12:36.75,Main,,0,0,0,,Kullanan ben değilim!
Dialogue: 0,0:12:36.75,0:12:38.50,Main,,0,0,0,,Alçak herif.
Dialogue: 0,0:12:38.50,0:12:42.33,Main,,0,0,0,,Yapmamış olsaydın\Nkimse kurban olmayacaktı!
Dialogue: 0,0:12:42.33,0:12:44.89,Main,,0,0,0,,Eminim gücünle\Netkisiz hale getirebiliyorsundur!
Dialogue: 0,0:12:44.89,0:12:46.01,Main,,0,0,0,,Hemen yap!
Dialogue: 0,0:12:46.40,0:12:50.55,Main,,0,0,0,,Ondan sonra da panzehir yapacaksın!\NOnları hâlâ kurtarabiliriz!
Dialogue: 0,0:12:50.55,0:12:56.23,Main,,0,0,0,,Dağılan gaz miktarını düşününce\Nbir günden fazla olmuş bile diyebilirim!
Dialogue: 0,0:12:56.23,0:12:57.88,Main,,0,0,0,,Yine mi?!
Dialogue: 0,0:12:58.62,0:13:02.70,Main,,0,0,0,,Hey! Ezilenleri hep iyi sanmayın!
Dialogue: 0,0:13:03.70,0:13:09.43,Main,,0,0,0,,Minkler insanlardan nefret etmeleri\Nve savaş güçleriyle tanınan bir kabiledir!
Dialogue: 0,0:13:09.43,0:13:12.05,Main,,0,0,0,,Onları kendi hallerine bırakmanız\Nsizin de işinize gelir!
Dialogue: 0,0:13:12.05,0:13:15.32,Main,,0,0,0,,Onları kurtarır kurtarmaz\Ndişlerini bize geçirecekler!
Dialogue: 0,0:13:15.76,0:13:18.11,Main,,0,0,0,,Dişlerini mi geçirecekler?
Dialogue: 0,0:13:30.22,0:13:31.30,Main,,0,0,0,,Gücüm...
Dialogue: 0,0:13:31.66,0:13:33.78,Main,,0,0,0,,Tuzlu! Deniz suyu bu!
Dialogue: 0,0:13:36.26,0:13:36.98,Main,,0,0,0,,Chopper!
Dialogue: 0,0:13:47.78,0:13:50.91,Main,,0,0,0,,Biraz daha nazikçe kurtaramaz mıydın?!
Dialogue: 0,0:13:50.91,0:13:53.58,Main,,0,0,0,,Seni kurtardığıma şükret!
Dialogue: 0,0:13:57.66,0:13:58.72,Main,,0,0,0,,Nami-san'ın sesiydi bu!
Dialogue: 0,0:13:59.34,0:14:00.62,Main,,0,0,0,,İyi dinle Caesar?!
Dialogue: 0,0:14:00.62,0:14:05.60,Main,,0,0,0,,Ben dönene kadar yarattığın\Nbu gazı şehirden uzaklaştır!
Dialogue: 0,0:14:05.60,0:14:07.27,Main,,0,0,0,,Ne?!
Dialogue: 0,0:14:07.27,0:14:10.96,Main,,0,0,0,,Yoksa kalbini yumruğumu sıktığım gibi...
Dialogue: 0,0:14:11.36,0:14:13.22,Main,,0,0,0,,Anladık tamam! İblis seni!
Dialogue: 0,0:14:14.08,0:14:16.40,Main,,0,0,0,,Sanji, onu bana bırak!
Dialogue: 0,0:14:16.40,0:14:18.44,Main,,0,0,0,,Peki, sende o zaman!
Dialogue: 0,0:14:22.68,0:14:23.75,Main,,0,0,0,,Orada!
Dialogue: 0,0:14:23.75,0:14:24.90,Main,,0,0,0,,Brook!
Dialogue: 0,0:14:24.90,0:14:26.68,Main,,0,0,0,,O şekilde tutmaya devam et!
Dialogue: 0,0:14:26.68,0:14:27.40,Main,,0,0,0,,Ne?!
Dialogue: 0,0:14:28.52,0:14:30.74,Main,,0,0,0,,{\fad(150,150)}Diable! Mouton...
Dialogue: 0,0:14:28.52,0:14:30.74,Attack,,0,0,0,,{\fad(150,150)}Şeytan Koyun Eti
Dialogue: 0,0:14:31.22,0:14:32.84,Main,,0,0,0,,{\fad(150,150)}Shot!
Dialogue: 0,0:14:31.22,0:14:32.84,Attack,,0,0,0,,{\fad(150,150)}Vuruşu!
Dialogue: 0,0:14:36.58,0:14:38.16,Main,,0,0,0,,Sheepshead-sama!
Dialogue: 0,0:14:39.22,0:14:41.04,Main,,0,0,0,,Gidiyoruz buradan!
Dialogue: 0,0:14:41.44,0:14:43.48,Main,,0,0,0,,Sheepshead-sama yenildi!
Dialogue: 0,0:14:43.48,0:14:44.56,Main,,0,0,0,,Ne?!
Dialogue: 0,0:14:44.56,0:14:46.54,Main,,0,0,0,,Fakat samurayı daha bulamadık!
Dialogue: 0,0:14:46.54,0:14:49.59,Main,,0,0,0,,Onları bu kadar köşeye sıkıştırmamıza\Nrağmen hâlâ ortaya çıkmadı.
Dialogue: 0,0:14:49.59,0:14:52.15,Main,,0,0,0,,Samuray burada değil.\NOna böyle söyleyin!
Dialogue: 0,0:14:52.15,0:14:53.18,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:14:54.78,0:14:57.04,Main,,0,0,0,,Yap hadi! Gazı temizle!
Dialogue: 0,0:14:57.64,0:15:02.15,Main,,0,0,0,,Amma can sıktın! \NTamam anladık, yapacağım. Mutlu musun?!
Dialogue: 0,0:15:02.92,0:15:05.34,Main,,0,0,0,,{\fad(150,150)}Koro-nötrleyici gaz!
Dialogue: 0,0:15:06.70,0:15:08.79,Main,,0,0,0,,Hiç isteyerek yapmıyorum!
Dialogue: 0,0:15:10.72,0:15:12.72,Main,,0,0,0,,{\fad(150,150)}Roko!
Dialogue: 0,0:15:10.72,0:15:12.72,Note,,0,0,0,,{\fad(150,150)}Roko: Koro gazını nötrleyen gaz
Dialogue: 0,0:15:49.08,0:15:50.25,Main,,0,0,0,,Tamam, oldu gibi!
Dialogue: 0,0:15:50.25,0:15:52.50,Main,,0,0,0,,Millet!
Dialogue: 0,0:15:53.36,0:15:55.23,Main,,0,0,0,,Çabuk buraya gelin!
Dialogue: 0,0:15:56.22,0:15:59.45,Main,,0,0,0,,Choppaemon bu!\NOrmanın ilerisinden geliyor!
Dialogue: 0,0:15:59.45,0:16:01.47,Main,,0,0,0,,Kaybedecek zaman yok, gidelim!
Dialogue: 0,0:16:05.28,0:16:07.62,Main,,0,0,0,,Korkunç...
Dialogue: 0,0:16:08.10,0:16:10.56,Main,,0,0,0,,Hepsini de Caesar'ın silahı mı öldürmüş?!
Dialogue: 0,0:16:12.68,0:16:16.22,Main,,0,0,0,,Evet, ülkenin çoğu mahvolmuş.
Dialogue: 0,0:16:16.62,0:16:18.99,Main,,0,0,0,,Az önceki elemanların işi olmalı.
Dialogue: 0,0:16:18.99,0:16:21.44,Main,,0,0,0,,Bize saldıranları mı diyorsun?!
Dialogue: 0,0:16:22.24,0:16:25.26,Main,,0,0,0,,Caesar gazı nötrlemeyi başarmış gibi ama...
Dialogue: 0,0:16:26.38,0:16:28.20,Main,,0,0,0,,...bunun sorumlusu onlar olmalı.
Dialogue: 0,0:16:28.84,0:16:32.67,Main,,0,0,0,,Yani adanın bir yerlerinde\Nhâlâ saklanan tonla düşman olabilir.
Dialogue: 0,0:16:32.67,0:16:37.88,Main,,0,0,0,,Gaz puştunun dediğine göre\NMink Kabilesi vahşi bir ırkmış.
Dialogue: 0,0:16:39.89,0:16:43.70,Main,,0,0,0,,Onları kurtardığımız için\Nsonradan pişman olabiliriz.
Dialogue: 0,0:16:44.10,0:16:46.44,Main,,0,0,0,,Siz-tiaralar da Jack'ın adamları mısınız?!
Dialogue: 0,0:16:49.20,0:16:50.02,Main,,0,0,0,,Nami-san!
Dialogue: 0,0:16:50.66,0:16:52.66,Main,,0,0,0,,Bekle! Zarar vermeyeceğiz!
Dialogue: 0,0:16:53.36,0:16:54.78,Main,,0,0,0,,Zehir yüzünden güçsüz düşmüş!
Dialogue: 0,0:17:04.50,0:17:07.21,Main,,0,0,0,,Nami-san, üzerinde bomba var!
Dialogue: 0,0:17:07.62,0:17:08.32,Main,,0,0,0,,Ne?!
Dialogue: 0,0:17:12.46,0:17:16.56,Main,,0,0,0,,Siz-tiaralar'ı asla affetmeyeceğim! Asla!
Dialogue: 0,0:17:17.12,0:17:21.68,Main,,0,0,0,,Size ne yaptık?!\NBizi öldürerek elinize ne geçecek?!
Dialogue: 0,0:17:22.69,0:17:24.62,Main,,0,0,0,,Siz-tiaralar'ın aradığı kişi burada değil!
Dialogue: 0,0:17:26.06,0:17:28.56,Main,,0,0,0,,Bin yıllık tarihe sahip bu ülkeyi...
Dialogue: 0,0:17:29.46,0:17:31.78,Main,,0,0,0,,...daha ne kadar \Nyaralayınca doyacaksınız?!
Dialogue: 0,0:17:48.95,0:17:50.35,Main,,0,0,0,,Wanda-san!
Dialogue: 0,0:17:50.35,0:17:53.14,Main,,0,0,0,,Onlar-tiara hayatımı kurtardılar!
Dialogue: 0,0:17:53.48,0:17:54.59,Main,,0,0,0,,Tristan!
Dialogue: 0,0:17:54.59,0:17:57.82,Main,,0,0,0,,Jack'ın bütün adamları\Naz önce adayı terk etti!
Dialogue: 0,0:17:57.82,0:17:59.74,Main,,0,0,0,,Ne? Terk mi ettiler?
Dialogue: 0,0:18:00.18,0:18:01.36,Main,,0,0,0,,Doğru mu bu?!
Dialogue: 0,0:18:04.53,0:18:05.30,Main,,0,0,0,,Pedro!
Dialogue: 0,0:18:05.30,0:18:06.44,Main,,0,0,0,,Wanda...
Dialogue: 0,0:18:07.00,0:18:09.56,Main,,0,0,0,,...onların-gara Jack'la bir ilgisi yok.
Dialogue: 0,0:18:13.56,0:18:16.44,Main,,0,0,0,,Zehirli gazı şehirden uzaklaştıran da...
Dialogue: 0,0:18:17.90,0:18:20.04,Main,,0,0,0,,...onların-gara büyüsü.
Dialogue: 0,0:18:20.04,0:18:23.04,Main,,0,0,0,,Sahi, gaz gitmiş.
Dialogue: 0,0:18:23.48,0:18:24.90,Main,,0,0,0,,Siz-tialar...
Dialogue: 0,0:18:26.16,0:18:27.65,Main,,0,0,0,,Kimsiniz?
Dialogue: 0,0:18:27.65,0:18:29.42,Main,,0,0,0,,Ne yapıyorsunuz?!
Dialogue: 0,0:18:29.42,0:18:30.46,Main,,0,0,0,,Chopper!
Dialogue: 0,0:18:30.46,0:18:34.19,Main,,0,0,0,,Gaza maruz kalmalarının üzerinden\Nbir günden fazla zaman geçmiş!
Dialogue: 0,0:18:34.19,0:18:36.90,Main,,0,0,0,,Maruz kalanlarda gazın etkisini\Nsıfırlayabilmek için...
Dialogue: 0,0:18:36.90,0:18:39.83,Main,,0,0,0,,...48 saat içinde panzehir verilmesi\Ngerekli yoksa ölecekler!
Dialogue: 0,0:18:39.83,0:18:40.90,Main,,0,0,0,,Onlar...?
Dialogue: 0,0:18:41.75,0:18:45.86,Main,,0,0,0,,Ülkedeki herkesi kurtarabilmek için\Nbir saniye bile boşa geçiremeyiz!
Dialogue: 0,0:18:45.86,0:18:49.04,Main,,0,0,0,,Hastaneniz nerede?!\NElimde yeterli malzeme ve ilaç yok!
Dialogue: 0,0:18:49.04,0:18:51.71,Main,,0,0,0,,Yardım edebiliyorsanız herkesi oraya taşıyın!
Dialogue: 0,0:18:51.71,0:18:54.22,Main,,0,0,0,,Doktorum ben. Sözümü dinleyin!
Dialogue: 0,0:18:56.76,0:18:59.38,Main,,0,0,0,,Bizi kurtaracak mısınız?
Dialogue: 0,0:19:01.24,0:19:05.26,Main,,0,0,0,,Hepimiz de\Nöleceğiz diye düşünmeye başlamıştım...
Dialogue: 0,0:19:05.26,0:19:07.40,Main,,0,0,0,,Bir kişiyi bile geride bırakmayacağız!
Dialogue: 0,0:19:36.85,0:19:39.28,Main,,0,0,0,,Yüreğinize su serpecek bir müzik çalayım size!
Dialogue: 0,0:19:44.57,0:19:47.91,Main,,0,0,0,,Bizi tanımamanıza rağmen...
Dialogue: 0,0:19:49.05,0:19:51.85,Main,,0,0,0,,...bir an bile vazgeçmeyip\Nbizi kurtardınız.
Dialogue: 0,0:19:53.51,0:19:57.09,Main,,0,0,0,,Yaptığınız bu iyiliği asla unutmayacağız!
Dialogue: 0,0:19:57.53,0:19:59.96,Main,,0,0,0,,Günün birinde\Nborcumuzu elbet ödeyeceğiz!
Dialogue: 0,0:19:59.96,0:20:02.29,Main,,0,0,0,,Hiç gerek yok!
Dialogue: 0,0:20:05.41,0:20:09.95,Main,,0,0,0,,Ne iyi bir şey yapmışsınız!\NSizinle gurur duyuyorum!
Dialogue: 0,0:20:10.49,0:20:13.12,Main,,0,0,0,,Durumun bu kadar\Nciddi olduğuna inanamıyorum...
Dialogue: 0,0:20:13.12,0:20:16.49,Main,,0,0,0,,Bizi demek o yüzden\No kadar iyi karşıladınız!
Dialogue: 0,0:20:20.07,0:20:22.95,Main,,0,0,0,,O değil de şu Jack denen herif\Ntepemi attırdı!
Dialogue: 0,0:20:23.43,0:20:26.50,Main,,0,0,0,,Günün birinde Kaido'yla beraber\Nonun da canına okuyacağım!
Dialogue: 0,0:20:26.67,0:20:29.71,Main,,0,0,0,,Jack için ölüm ilanı yayınlandı\Ndemişti ama...
Dialogue: 0,0:20:29.71,0:20:35.45,Main,,0,0,0,,O ilan Jack'i kendi gözleriyle gören\Nbiri için pek inandırıcı değil açıkçası.
Dialogue: 0,0:20:36.85,0:20:38.98,Main,,0,0,0,,Millet, siz burada mı kalacaksınız?
Dialogue: 0,0:20:40.04,0:20:42.24,Main,,0,0,0,,Bir yere mi gidiyorsun Chopper?
Dialogue: 0,0:20:42.24,0:20:48.19,Main,,0,0,0,,Akşam oldu, şimdi Gecenin Kralı Nekomamushi'yi \Nve Balina Ormanı'nın Muhafızları'nı kontrole gidiyorum.
Dialogue: 0,0:20:48.19,0:20:50.43,Main,,0,0,0,,Warney'le götüreyim o zaman.
Dialogue: 0,0:20:50.83,0:20:55.01,Main,,0,0,0,,Aklıma gelmişken Wanda,\Nsenin de uyuman gerekmiyor mu?
Dialogue: 0,0:20:55.01,0:20:58.37,Main,,0,0,0,,Ben Kral Kuşu olarak çalışıyorum.
Dialogue: 0,0:20:58.58,0:20:59.89,Main,,0,0,0,,Kral Kuşu mu?
Dialogue: 0,0:20:59.89,0:21:03.93,Main,,0,0,0,,Evet, gece gündüz fark etmeksizin\Nkrallara yardımcı olmak adına...
Dialogue: 0,0:21:03.93,0:21:07.85,Main,,0,0,0,,...iki kral arasında gidip gelme izni olan\Nbirkaç kişiden biriyim.
Dialogue: 0,0:21:08.03,0:21:10.79,Main,,0,0,0,,Vay canına, sağlam işmiş!
Dialogue: 0,0:21:11.81,0:21:14.82,Main,,0,0,0,,Dük Inuarashi'nin iyi olduğunu\Nhaber vermem lazım.
Dialogue: 0,0:21:15.25,0:21:17.44,Main,,0,0,0,,Muhtemelen buna gerek yok derdi ama...
Dialogue: 0,0:21:17.44,0:21:20.59,Main,,0,0,0,,Ben de geliyorum!\NNekomamushi'yi görmek istiyorum!
Dialogue: 0,0:21:20.79,0:21:26.34,Main,,0,0,0,,Nekomamushi Efendi, onu çok seviyorum!\NBen de geleceğim!
Dialogue: 0,0:21:30.89,0:21:35.07,Main,,0,0,0,,Dolunay var ama\Nşükürler olsun ki bulutlarla kaplı.
Dialogue: 0,0:21:35.97,0:21:37.45,Main,,0,0,0,,Dikkatli olun!
Dialogue: 0,0:21:37.45,0:21:37.98,Main,,0,0,0,,Peki!
Dialogue: 0,0:21:38.55,0:21:40.95,Main,,0,0,0,,Kusura bakma Carrot, \Nseni de rahatsız ettik.
Dialogue: 0,0:21:40.95,0:21:43.11,Main,,0,0,0,,Önemi yok, ben de Kral Kuşu'yum.
Dialogue: 0,0:21:47.21,0:21:50.37,Main,,0,0,0,,Hikayeye dönecek olursak Wanda...
Dialogue: 0,0:21:50.37,0:21:54.73,Main,,0,0,0,,Evet, Kıvırcık Kaş da\NGaz Herif de hâlâ buradalardı.
Dialogue: 0,0:21:55.19,0:21:57.67,Main,,0,0,0,,Oradan sonra olanları ben anlatayım.
Dialogue: 0,0:22:02.61,0:22:08.77,Main,,0,0,0,,İşin aslı bundan\Nülkedeki çoğu kişiye bahsetmedik.
Dialogue: 0,0:22:09.67,0:22:14.18,Main,,0,0,0,,Ülkeleri mahvolmuş bu insanları \Ndaha da endişelendirmek istemedik çünkü.
Dialogue: 0,0:22:18.93,0:22:23.99,Main,,0,0,0,,Bu iki gün önce gizlice gerçekleşmiş\Nçok önemli bir olay.
Dialogue: 0,0:22:24.59,0:22:26.73,Main,,0,0,0,,En kötüsüne hazırlayın kendinizi.
Dialogue: 0,0:22:27.75,0:22:30.15,Main,,0,0,0,,Sanji-san artık...
Dialogue: 0,0:22:30.59,0:22:33.70,Main,,0,0,0,,...geri dönmeyebilir.
Dialogue: 0,0:22:33.70,0:22:34.90,Main,,0,0,0,,Ne?!
Dialogue: 0,0:22:34.90,0:22:36.02,Main,,0,0,0,,Hey, hey!
Dialogue: 0,0:22:36.02,0:22:37.45,Main,,0,0,0,,Neden peki Brook?!
Dialogue: 0,0:22:37.45,0:22:40.84,Main,,0,0,0,,Yazdığı mektupta "geri döneceğim" demiş ya!
Dialogue: 0,0:22:40.84,0:22:43.75,Main,,0,0,0,,Mesele çok daha karışık diyoruz sana!
Dialogue: 0,0:22:43.75,0:22:47.17,Main,,0,0,0,,Sanji geri dönecek!\NOna inancım tam!
Dialogue: 0,0:22:49.27,0:22:52.50,Main,,0,0,0,,Peki peki...\NBiraz sakinleş Luffy-san.
Dialogue: 0,0:22:52.50,0:22:54.87,Main,,0,0,0,,Yaşananları en başından anlatacağım.
Dialogue: 0,0:22:54.87,0:22:55.73,Main,,0,0,0,,Tamam!
Dialogue: 0,0:22:57.07,0:22:59.75,Main,,0,0,0,,Zou adası hayalet bir ada.
Dialogue: 0,0:23:00.25,0:23:05.33,Main,,0,0,0,,Adanın kendisi canlı olduğundan\NSeyir Pusulası'yla bile ona ulaşamaz...
Dialogue: 0,0:23:05.83,0:23:08.53,Main,,0,0,0,,...normal bir şekilde bulamazsın fakat...
Dialogue: 0,0:23:09.65,0:23:13.10,Main,,0,0,0,,...bizler biraz dikkatsizlik edip\Nkozumuzu belli ettik.
Dialogue: 0,0:23:14.49,0:23:16.44,Main,,0,0,0,,Öncelikle o gün...
Dialogue: 0,0:23:17.29,0:23:19.97,Flashbacks,,0,0,0,,Siz Zou'ya gidin!
Dialogue: 0,0:23:21.67,0:23:27.15,Main,,0,0,0,,...peşimizden atmayı başardığımız\Ngemiye gideceğimiz yeri belli ettik.
Dialogue: 0,0:23:27.72,0:23:32.19,Main,,0,0,0,,Ve onların gemide de\Nbu Hayalet Ada'dan olan biri vardı.
Dialogue: 0,0:23:34.25,0:23:38.51,Main,,0,0,0,,Yani iki gün önce karşımıza dikilenler...
Dialogue: 0,0:23:39.03,0:23:41.43,Main,,0,0,0,,...Yonko Big Mom Korsanları'ydı.
Dialogue: 0,0:23:47.13,0:23:48.55,Main,,0,0,0,,Ulaştık.
Dialogue: 0,0:23:49.13,0:23:53.31,Main,,0,0,0,,Evet, sorun yok. \NBize güvenebilirsin Mama.
Dialogue: 0,0:23:53.31,0:23:55.61,Main,,0,0,0,,İkimiz üstesinden geliriz.
Dialogue: 0,0:23:56.77,0:23:59.98,Main,,0,0,0,,Zou benim ülkem-gao!
Dialogue: 0,0:23:59.98,0:24:03.00,OP11 Credits,,0,0,0,,Editing: Galaxy 9000\N\NTiming: Datenshi,\NSewil\N\NQC: Mr Luffy,\NGalaxy 9000\N\NSoundtracking: Halee\N\NTC/Infoboxes: Datenshi\N\NTranslation: Yibis
Dialogue: 0,0:00:00.82,0:00:06.82,English - OP18,,0,0,0,,♪ Görmedim dünyanın sonunu kendi gözlerimle hiç. ♪
Dialogue: 0,0:00:06.82,0:00:13.95,English - OP18,,0,0,0,,♪ O yüzden çıktım yola sizinle, bunu yapmak için! ♪
Dialogue: 0,0:00:23.67,0:00:27.00,English - OP18,,0,0,0,,♪ Bir denizden diğerine yol alırken,...
Dialogue: 0,0:00:29.06,0:00:31.85,English - OP18,,0,0,0,,...bunun sadece bir peri masalı olduğunu söylemek. ♪
Dialogue: 0,0:00:31.85,0:00:38.78,English - OP18,,0,0,0,,♪ Gerçek, kurgudan daha tuhaf değil mi? ♪
Dialogue: 0,0:00:39.94,0:00:43.18,English - OP18,,0,0,0,,♪ Fakat sırt çevirme hiçbirine. ♪
Dialogue: 0,0:00:43.56,0:00:50.04,English - OP18,,0,0,0,,♪ Sağduyu dedikleri zihnidir toplulukların! ♪
Dialogue: 0,0:00:51.36,0:00:57.41,English - OP18,,0,0,0,,♪ Görmedim dünyanın sonunu kendi gözlerimle hiç. ♪
Dialogue: 0,0:00:57.41,0:01:01.96,English - OP18,,0,0,0,,♪ O yüzden gitmemiz lazım Kaptan Özgür-Ruh! ♪
Dialogue: 0,0:01:01.96,0:01:04.67,English - OP18,,0,0,0,,♪ Kim demiş imkansız diye,...
Dialogue: 0,0:01:04.67,0:01:07.75,English - OP18,,0,0,0,,...daha hiçbir şey başlamadan! ♪
Dialogue: 0,0:01:07.75,0:01:12.72,English - OP18,,0,0,0,,♪ Her şeyi bilmek istiyorum ve şimdi bilebiliriz de... ♪
Dialogue: 0,0:01:12.72,0:01:18.68,English - OP18,,0,0,0,,♪ Bilebiliriz, bilebilirsin! Şu anda... ♪
Dialogue: 0,0:01:19.06,0:01:24.10,English - OP18,,0,0,0,,♪ Bilebiliriz, bilebilirim! Bu harika hissi... ♪
Dialogue: 0,0:01:24.39,0:01:31.32,English - OP18,,0,0,0,,♪ Hemen, şimdi, bilebiliriz! ♪
Dialogue: 0,0:01:37.34,0:01:38.64,English - OP18,,0,0,0,,♪ Evet, bilebiliriz! ♪
