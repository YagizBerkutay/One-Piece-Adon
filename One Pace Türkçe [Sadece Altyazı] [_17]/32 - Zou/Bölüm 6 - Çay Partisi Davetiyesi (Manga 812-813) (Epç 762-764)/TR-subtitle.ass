0000000,0,0,0,0,100.0,100,0.0,0,1,1.8,0,2,22,22,18,1Style: Author,Impress BT,20.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.7,0.7,9,10,10,10,1Style: Attack,Duality,30.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.0,1.0,7,12,12,12,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.82,0:00:06.82,English - OP18,,0,0,0,,♪ Görmedim dünyanın sonunu kendi gözlerimle hiç. ♪Dialogue: 0,0:00:06.82,0:00:13.95,English - OP18,,0,0,0,,♪ O yüzden çıktım yola sizinle, bunu yapmak için! ♪Dialogue: 0,0:00:23.67,0:00:27.00,English - OP18,,0,0,0,,♪ Bir denizden diğerine yol alırken,...Dialogue: 0,0:00:29.06,0:00:31.85,English - OP18,,0,0,0,,...bunun sadece bir peri masalı olduğunu söylemek. ♪Dialogue: 0,0:00:31.85,0:00:38.78,English - OP18,,0,0,0,,♪ Gerçek, kurgudan daha tuhaf değil mi? ♪Dialogue: 0,0:00:39.94,0:00:43.18,English - OP18,,0,0,0,,♪ Fakat sırt çevirme hiçbirine. ♪Dialogue: 0,0:00:43.56,0:00:50.04,English - OP18,,0,0,0,,♪ Sağduyu dedikleri zihnidir toplulukların! ♪Dialogue: 0,0:00:51.36,0:00:57.41,English - OP18,,0,0,0,,♪ Görmedim dünyanın sonunu kendi gözlerimle hiç. ♪Dialogue: 0,0:00:57.41,0:01:01.96,English - OP18,,0,0,0,,♪ O yüzden gitmemiz lazım Kaptan Özgür-Ruh! ♪Dialogue: 0,0:01:01.96,0:01:04.67,English - OP18,,0,0,0,,♪ Kim demiş imkansız diye,...Dialogue: 0,0:01:04.67,0:01:07.75,English - OP18,,0,0,0,,...daha hiçbir şey başlamadan! ♪Dialogue: 0,0:01:07.75,0:01:12.72,English - OP18,,0,0,0,,♪ Her şeyi bilmek istiyorum ve şimdi bilebiliriz de... ♪Dialogue: 0,0:01:12.72,0:01:18.68,English - OP18,,0,0,0,,♪ Bilebiliriz, bilebilirsin! Şu anda... ♪Dialogue: 0,0:01:19.06,0:01:24.10,English - OP18,,0,0,0,,♪ Bilebiliriz, bilebilirim! Bu harika hissi... ♪Dialogue: 0,0:01:24.39,0:01:31.32,English - OP18,,0,0,0,,♪ Hemen, şimdi, bilebiliriz! ♪Dialogue: 0,0:01:37.34,0:01:38.64,English - OP18,,0,0,0,,♪ Evet, bilebiliriz! ♪Dialogue: 0,0:01:41.74,0:01:46.38,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:14:13.70,0:14:23.70,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:29:30.98,0:29:36.80,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:01:41.74,0:01:46.38,Title,,0,0,240,,Çay Partisi DavetiyesiDialogue: 0,0:01:47.44,0:01:48.66,Main,,0,0,0,,Ne?Dialogue: 0,0:01:49.78,0:01:51.72,Main,,0,0,0,,Şaka mı bu?!Dialogue: 0,0:01:57.00,0:01:59.29,Main,,0,0,0,,Bu da ne böyle!? Hey!Dialogue: 0,0:01:59.29,0:02:01.38,Main,,0,0,0,,Herkes nerede?!Dialogue: 0,0:02:02.19,0:02:06.17,Main,,0,0,0,,Ne olmuş burada-gao?! Zou'ya bunu kim yaptı!?Dialogue: 0,0:02:10.46,0:02:13.61,Main,,0,0,0,,Hasır Şapkalar mı yaptı bunu?!Dialogue: 0,0:02:13.61,0:02:19.26,Main,,0,0,0,,Ülkeme ne yaptığını sanıyor bunlar?!Dialogue: 0,0:02:34.98,0:02:39.14,Main,,0,0,0,,Burası atalarımızın yaşadığı yerleşim bölgesi.Dialogue: 0,0:02:39.88,0:02:44.98,Main,,0,0,0,,Zunesha hiç değişmeksizin Mink Kabilesi'ni nesiller boyu sırtında taşımış.Dialogue: 0,0:02:45.78,0:02:50.11,Main,,0,0,0,,Çok eskiye dayanan, yabancılarla dostluk simgesi olarak...Dialogue: 0,0:02:50.11,0:02:53.92,Main,,0,0,0,,...kıyafet alış verişi yapmak gibi çok eski bir de geleneğimiz vardır.Dialogue: 0,0:02:53.92,0:02:58.24,Main,,0,0,0,,Çok güzelmiş!  Kendimi önemli biri gibi hissediyorum!Dialogue: 0,0:02:58.24,0:03:00.94,Main,,0,0,0,,Öyledir.  O takı ulusal hazinemizin bir parçası.Dialogue: 0,0:03:03.24,0:03:05.73,Main,,0,0,0,,Ne?! Bana mı veriyorsunuz?!Dialogue: 0,0:03:05.73,0:03:08.26,Main,,0,0,0,,Elbette. Herkes kabul etti.Dialogue: 0,0:03:08.64,0:03:12.20,Main,,0,0,0,,Garchu! Garchu-chu!Dialogue: 0,0:03:12.92,0:03:15.42,Main,,0,0,0,,Matmazel, garchu.Dialogue: 0,0:03:15.42,0:03:16.44,Main,,0,0,0,,Garchu.Dialogue: 0,0:03:18.40,0:03:20.65,Main,,0,0,0,,Nasılsınız, garchu!Dialogue: 0,0:03:20.65,0:03:21.58,Main,,0,0,0,,Garchu.Dialogue: 0,0:03:23.52,0:03:25.48,Main,,0,0,0,,Tristan-chan!Dialogue: 0,0:03:25.88,0:03:28.32,Main,,0,0,0,,Garchu!Dialogue: 0,0:03:28.80,0:03:29.82,Main,,0,0,0,,Garchu!Dialogue: 0,0:03:30.76,0:03:32.96,Main,,0,0,0,,Sanji-san, selamlaşmayı epey seviyorsunuz gibi.Dialogue: 0,0:03:37.04,0:03:39.18,Main,,0,0,0,,Bu garchu ne böyle arkadaş?!Dialogue: 0,0:03:39.62,0:03:41.84,Main,,0,0,0,,Mucizevi bir söz falan mı?Dialogue: 0,0:03:43.44,0:03:47.85,Main,,0,0,0,,Sanji! Kurtarıcımıza garchu!Dialogue: 0,0:03:47.85,0:03:50.28,Main,,0,0,0,,Kesin lan, sizi ne yapayım ben?!Dialogue: 0,0:03:50.28,0:03:52.89,Main,,0,0,0,,Ay Sanji-san, garchu!Dialogue: 0,0:03:52.89,0:03:55.98,Main,,0,0,0,,Amanın ya, minklemek çok yaşasın!Dialogue: 0,0:03:56.82,0:03:57.98,Main,,0,0,0,,Tanrıça?!Dialogue: 0,0:03:58.70,0:03:59.69,Main,,0,0,0,,Hayır...Dialogue: 0,0:04:01.56,0:04:03.70,Main,,0,0,0,,Nami-san!Dialogue: 0,0:04:04.28,0:04:05.69,Main,,0,0,0,,Garchu!Dialogue: 0,0:04:11.14,0:04:12.78,Main,,0,0,0,,Momo nerede?Dialogue: 0,0:04:12.78,0:04:17.50,Main,,0,0,0,,Hâlâ odasında kilitli. Öyle kendini daha rahat hissediyormuş.Dialogue: 0,0:04:17.90,0:04:20.89,Main,,0,0,0,,Ayrıca kendini insanlara göstermemesi daha iyi.Dialogue: 0,0:04:20.89,0:04:21.90,Main,,0,0,0,,Haklısın.Dialogue: 0,0:04:21.90,0:04:25.58,Main,,0,0,0,,Burada samuray kelimesini kullanmasak iyi ederiz.Dialogue: 0,0:04:27.62,0:04:33.24,Main,,0,0,0,,O şımarık veledi Minkler'e teslim edin de bu dandik adadan defolup gidelim.Dialogue: 0,0:04:33.24,0:04:36.58,Main,,0,0,0,,Kes sesini!  Lan Ceasar, ilacı yapmayı bitirdin mi?Dialogue: 0,0:04:36.58,0:04:39.12,Main,,0,0,0,,Karşında dahi duruyor! Kotamı doldurdum.Dialogue: 0,0:04:39.28,0:04:40.89,Main,,0,0,0,,Daha yap, boş boş durma!Dialogue: 0,0:04:40.89,0:04:42.97,Main,,0,0,0,,Daha bir sürü yaralı insan var!Dialogue: 0,0:04:42.97,0:04:43.93,Main,,0,0,0,,Çalış!Dialogue: 0,0:04:43.93,0:04:46.14,Main,,0,0,0,,Neden yapayım ki bunu...Dialogue: 0,0:04:46.71,0:04:49.94,Main,,0,0,0,,Dr. Caesar, ilaçları almaya geldim.Dialogue: 0,0:04:52.69,0:04:55.87,Main,,0,0,0,,Yanlışlık olmasın! Ben eczacı Cedar'ım!Dialogue: 0,0:04:56.26,0:04:56.88,Main,,0,0,0,,Al bakalım.Dialogue: 0,0:04:58.12,0:05:01.61,Main,,0,0,0,,Lanet olsun! Onları kurtarmak için niye ilaç yapıyorum ki?!Dialogue: 0,0:05:01.61,0:05:04.01,Main,,0,0,0,,Teşekkür ederim Dr. Caesar!Dialogue: 0,0:05:04.01,0:05:05.22,Main,,0,0,0,,Cedar'ım ben!Dialogue: 0,0:05:05.88,0:05:10.09,Main,,0,0,0,,Öf ulan, dahi çılgın bilim adamı Ceasar'ın adını kirletiyorum resmen!Dialogue: 0,0:05:10.66,0:05:11.29,Main,,0,0,0,,Sahi ya...Dialogue: 0,0:05:11.29,0:05:12.57,Main,,0,0,0,,Cedar'ım ben!Dialogue: 0,0:05:12.57,0:05:15.45,Main,,0,0,0,,Baron Ceset, hayranlarınız dışarıda sizi bekliyor.Dialogue: 0,0:05:15.45,0:05:16.04,Main,,0,0,0,,Öh!Dialogue: 0,0:05:17.18,0:05:21.03,Main,,0,0,0,,Böyle popülarite olmaz olsun...Dialogue: 0,0:05:22.98,0:05:23.90,Main,,0,0,0,,Pekoms!Dialogue: 0,0:05:23.90,0:05:25.16,Main,,0,0,0,,Kimleri görüyorum!Dialogue: 0,0:05:26.30,0:05:27.58,Main,,0,0,0,,Dönmüşsün!Dialogue: 0,0:05:27.58,0:05:28.54,Main,,0,0,0,,Pekoms!Dialogue: 0,0:05:31.20,0:05:33.90,Main,,0,0,0,,İyisiniz!Dialogue: 0,0:05:33.90,0:05:39.06,Main,,0,0,0,,Baba! Anne! Akrabalarım ve dostlarım!Dialogue: 0,0:05:39.06,0:05:40.71,Main,,0,0,0,,Hoş geldin!Dialogue: 0,0:05:40.71,0:05:41.97,Main,,0,0,0,,Görüşmeyeli kaç sene oldu?!Dialogue: 0,0:05:41.97,0:05:43.92,Main,,0,0,0,,Resmen geçmişe gittim!Dialogue: 0,0:05:43.92,0:05:47.46,Main,,0,0,0,,İyi gördüm seni garchu!Dialogue: 0,0:05:49.68,0:05:55.75,Main,,0,0,0,,Ahmaklar! Böyle yara bere içinde, nasıl mutlu olabilirsiniz ki?!Dialogue: 0,0:05:55.75,0:05:59.95,Main,,0,0,0,,Şehrin halini gördüğümde kalbim duracak sandım!Dialogue: 0,0:05:59.95,0:06:01.16,Main,,0,0,0,,Garchu!Dialogue: 0,0:06:00.40,0:06:00.98,Secondary,,0,0,0,,Hey!Dialogue: 0,0:06:01.34,0:06:02.96,Main,,0,0,0,,Acıtıyorsun!Dialogue: 0,0:06:04.44,0:06:07.28,Main,,0,0,0,,Hasır Şapka tayfasına borçluyuz bunu!Dialogue: 0,0:06:07.68,0:06:12.90,Main,,0,0,0,,Canla başla bize yardım etmeselerdi şimdiye halimiz nice olurdu kim bilir!Dialogue: 0,0:06:14.98,0:06:18.48,Main,,0,0,0,,Hayatta olmanıza çok sevindim!Dialogue: 0,0:06:23.68,0:06:26.06,Main,,0,0,0,,Ağlamayı bırak hadi!Dialogue: 0,0:06:26.86,0:06:32.13,Main,,0,0,0,,Onlar... Canavar Korsanlarından  Jack'i hayatta affetmem!Dialogue: 0,0:06:32.13,0:06:35.74,Main,,0,0,0,,Memleketime böyle bir şeyi nasıl yapar?!Dialogue: 0,0:06:37.70,0:06:41.61,Main,,0,0,0,,Bakın! Big Mom Korsanları'ndan onlar... Buraya kadar peşimizden gelmişler!Dialogue: 0,0:06:41.61,0:06:44.50,Main,,0,0,0,,Pekoms değil mi o? Geri döndü demek?Dialogue: 0,0:06:45.08,0:06:47.15,Main,,0,0,0,,Eskiden çok ünlü bir serseriydi.Dialogue: 0,0:06:48.30,0:06:51.66,Main,,0,0,0,,O da Mink demek?Dialogue: 0,0:06:53.34,0:06:56.44,Main,,0,0,0,,Buraya geldiğimizi duymuş olmalılar!Dialogue: 0,0:06:56.44,0:06:58.06,Main,,0,0,0,,Benim peşimdeler!Dialogue: 0,0:06:58.22,0:07:02.09,Main,,0,0,0,,Yalvarıyorum bak, beni onlara vermeyin!Dialogue: 0,0:07:02.09,0:07:05.15,Main,,0,0,0,,Doflamingo'ya karşı kozumuzdun.Dialogue: 0,0:07:05.54,0:07:10.08,Main,,0,0,0,,Luffyler onu yendiğine göre sana ne olacağı umrumuzda değil.Dialogue: 0,0:07:10.08,0:07:13.90,Main,,0,0,0,,Öyle demeyin ama! Arkadaş değil miyiz?!Dialogue: 0,0:07:13.90,0:07:15.72,Main,,0,0,0,,Ne ara arkadaş olduk?!Dialogue: 0,0:07:16.46,0:07:21.42,Main,,0,0,0,,Dressrosa'da da söylenip duruyordun zaten. Big Mom'a ne yaptın da böyle korkuyorsun?Dialogue: 0,0:07:21.42,0:07:24.28,Main,,0,0,0,,Hah ben de onu diyorum! Dinleyin beni!Dialogue: 0,0:07:24.28,0:07:28.57,Main,,0,0,0,,Bir araştırma yapmam için bir teklif aldım ama henüz başarılı olmadı...Dialogue: 0,0:07:28.57,0:07:31.76,Main,,0,0,0,,...ben de oldu diye yalan söyleyip sağlam para götürdüm ondan!Dialogue: 0,0:07:31.76,0:07:35.73,Main,,0,0,0,,Doflamingo'ya güvenip şansımı zorladım!Dialogue: 0,0:07:35.73,0:07:37.17,Main,,0,0,0,,Ne ekersen onu biçersin.Dialogue: 0,0:07:38.06,0:07:40.96,Main,,0,0,0,,Umarım tek istedikleri Caesar olur...Dialogue: 0,0:07:40.96,0:07:42.43,Main,,0,0,0,,Ne?!Dialogue: 0,0:07:42.43,0:07:46.06,Flashbacks,,0,0,0,,Yeni Dünya'da canına okuyup...Dialogue: 0,0:07:46.82,0:07:49.98,Flashbacks,,0,0,0,,...Balık Adam Adası'nı kendi bölgem yapacağım!Dialogue: 0,0:07:51.07,0:07:55.27,Main,,0,0,0,,Luffy Balık Adam Adası'nda Big Mom'a kafa tutmuştu.Dialogue: 0,0:07:55.27,0:07:57.16,Main,,0,0,0,,Gemilerine de zarar verdik.Dialogue: 0,0:07:59.37,0:08:03.61,Main,,0,0,0,,Bana bak az, Kara Bacak...  Birlikte çalışıp o ikisini alaşağı edelim mi?Dialogue: 0,0:08:03.61,0:08:05.20,Main,,0,0,0,,Düşünsene!Dialogue: 0,0:08:08.40,0:08:10.08,Main,,0,0,0,,Nami-san, siz burada bekleyin.Dialogue: 0,0:08:10.08,0:08:10.60,Main,,0,0,0,,Peki.Dialogue: 0,0:08:11.16,0:08:12.77,Main,,0,0,0,,Brook, sen benimle gel.Dialogue: 0,0:08:12.77,0:08:13.64,Main,,0,0,0,,Tamam.Dialogue: 0,0:08:13.64,0:08:16.89,Main,,0,0,0,,Hey, Karabacak! Onları habersizce ortadan kaldırma planıma ne diyorsun?!Dialogue: 0,0:08:16.89,0:08:19.52,Main,,0,0,0,,Bir adım ötesinden sonrasını göremeyen çeneni kapat.Dialogue: 0,0:08:36.92,0:08:39.30,Main,,0,0,0,,Big Mom Korsanları, ne istiyorsunuz?Dialogue: 0,0:08:40.42,0:08:42.60,Main,,0,0,0,,Fazla sorun çıkartmayın.Dialogue: 0,0:08:43.04,0:08:46.84,Main,,0,0,0,,Ülkenin insanları halihazırda ruhen ve bedenen yaralanmış durumdalar.Dialogue: 0,0:08:46.84,0:08:49.18,Main,,0,0,0,,Kaçmayacak yahut saklanmayacağız.Dialogue: 0,0:08:53.82,0:08:56.96,Main,,0,0,0,,Teşekkür ederimden başka bir şey diyemiyorum-gao!Dialogue: 0,0:09:03.02,0:09:04.49,Main,,0,0,0,,H-Hey...Dialogue: 0,0:09:08.12,0:09:13.82,Main,,0,0,0,,Memleketimi bu halde bulacağım aklımın ucundan geçmezdi.Dialogue: 0,0:09:15.70,0:09:18.75,Main,,0,0,0,,İnsanlarını siz kurtardınız değil mi?!Dialogue: 0,0:09:18.75,0:09:20.80,Main,,0,0,0,,Sana borçluyum!Dialogue: 0,0:09:20.80,0:09:22.86,Main,,0,0,0,,Nasıl teşekkür ederim?!Dialogue: 0,0:09:32.00,0:09:37.52,Main,,0,0,0,,Mama'nın emriyle, Caesar'ı yakalamak dışında bir görevimiz daha var.Dialogue: 0,0:09:37.94,0:09:41.12,Main,,0,0,0,,Korsan grubunuzun sonunu getirecek bir görev bu.Dialogue: 0,0:09:41.76,0:09:42.73,Main,,0,0,0,,Sonunu mu getirecek?Dialogue: 0,0:09:42.90,0:09:47.58,Main,,0,0,0,,Ama unutalım gitsin!  Görev başarısız oldu! Caesar'ı verin yeter!Dialogue: 0,0:09:47.58,0:09:52.36,Main,,0,0,0,,Mama'ya Hasır Şapkalar'ın kaçtığını söyleyeceğim!Dialogue: 0,0:09:53.48,0:09:57.33,Main,,0,0,0,,Pekoms, delirdin mi sen?! Duygularını bu işe karıştırma!Dialogue: 0,0:09:57.33,0:10:00.70,Main,,0,0,0,,Kapa çeneni çaylak! Cezası neyse ben çekerim!Dialogue: 0,0:10:03.76,0:10:06.70,Main,,0,0,0,,Ailemi, dostlarımı kurtardılar.Dialogue: 0,0:10:06.70,0:10:10.46,Main,,0,0,0,,Onlara bir şey yapamam.Dialogue: 0,0:10:11.32,0:10:13.09,Main,,0,0,0,,Korkak herif!Dialogue: 0,0:10:27.74,0:10:29.54,Main,,0,0,0,,Lanet olası!Dialogue: 0,0:10:35.18,0:10:36.97,Main,,0,0,0,,Dostunu sırtından vurdu!Dialogue: 0,0:10:37.90,0:10:39.46,Main,,0,0,0,,Nasıl yapar bunu!?Dialogue: 0,0:10:44.32,0:10:45.97,Main,,0,0,0,,O da neydi öyle?Dialogue: 0,0:10:48.22,0:10:51.63,Main,,0,0,0,,Pek belli etmese de epey ünlü bir korsandır.Dialogue: 0,0:10:52.10,0:10:57.20,Main,,0,0,0,,Ama işine gereksiz duygularını karıştırınca böyle işe yaramazın teki olup çıkıyor demek?Dialogue: 0,0:10:58.64,0:11:01.81,Main,,0,0,0,,Artık bir işe yaramayacak gibi.Dialogue: 0,0:11:03.10,0:11:04.66,Main,,0,0,0,,Bu işi kendim hallederim!Dialogue: 0,0:11:05.58,0:11:07.84,Main,,0,0,0,,Haydi millet, sıranız geldi!Dialogue: 0,0:11:20.63,0:11:21.74,Main,,0,0,0,,Çıkın ortaya!Dialogue: 0,0:11:27.92,0:11:29.20,Main,,0,0,0,,Ne?!Dialogue: 0,0:11:43.52,0:11:45.24,Main,,0,0,0,,Ne?! İnsanlar mı?!Dialogue: 0,0:11:54.66,0:11:55.74,Main,,0,0,0,,Bu da ne böyle?!Dialogue: 0,0:12:02.92,0:12:05.87,Main,,0,0,0,,Teslim olun, sayıca bizden azsınız!Dialogue: 0,0:12:10.10,0:12:11.82,Main,,0,0,0,,Karnından insan mı çıkardı bu?!Dialogue: 0,0:12:12.49,0:12:14.94,Main,,0,0,0,,Ne tür bir güce sahip?!Dialogue: 0,0:12:14.94,0:12:20.03,Main,,0,0,0,,Az önce elinde insanlar gördüm sanmıştım ama demek doğru görmüşüm!Dialogue: 0,0:12:20.03,0:12:23.12,Main,,0,0,0,,Ben Kale Kale Meyvesi yemiş kale insanım.Dialogue: 0,0:12:23.84,0:12:31.46,Main,,0,0,0,,Kaptanınızla aynı nesilden sayılıyorum yani beni tanıyor olmanız lazım.Dialogue: 0,0:12:31.48,0:12:38.85,Captions,,540,0,350,,Ateş Tankı Korsanları KaptanıDialogue: 0,0:12:31.48,0:12:38.85,Captions,,550,0,260,,Capone "Gang" BegeDialogue: 0,0:12:31.48,0:12:38.85,Captions,,550,0,178,,Kelle Ödülü: 300 milyon beliDialogue: 0,0:12:32.58,0:12:38.94,Main,,0,0,0,,Sabaody Takımadaları'nda Luffy  Kutsal Ejder'e yumruk attığında sen de o adadaydın!Dialogue: 0,0:12:41.16,0:12:46.88,Main,,0,0,0,,Biz de şu anda burada fazla patırtı kopartmak istemiyoruz.Dialogue: 0,0:12:48.14,0:12:52.66,Main,,0,0,0,,Şu anda Minkler  mutlaka sizin tarafınızı tutacaklardır.Dialogue: 0,0:12:52.66,0:12:55.68,Main,,0,0,0,,Ne kadar iyi savaştıklarını biliyorum.Dialogue: 0,0:12:56.25,0:12:57.25,Main,,0,0,0,,Vito!Dialogue: 0,0:12:58.04,0:13:00.22,Main,,0,0,0,,Öf! Bırak beni!Dialogue: 0,0:13:02.02,0:13:02.92,Main,,0,0,0,,Nami-san!Dialogue: 0,0:13:02.92,0:13:04.03,Main,,0,0,0,,Chopper-san!Dialogue: 0,0:13:07.21,0:13:09.71,Main,,0,0,0,,Özür dileriz... Ne olduğunu merak edip...Dialogue: 0,0:13:09.71,0:13:12.10,Main,,0,0,0,,Özür dilerim! Yalnızca iki kişiler sanıyorduk!Dialogue: 0,0:13:16.40,0:13:17.42,Main,,0,0,0,,Bak sen...Dialogue: 0,0:13:18.84,0:13:21.68,Main,,0,0,0,,Caesar, sen de çık ortaya!Dialogue: 0,0:13:25.62,0:13:30.22,Main,,0,0,0,,İki saniye içinde kairouseki mermili tüfeklerle göğe ateş edeceğiz!Dialogue: 0,0:13:25.62,0:13:30.22,Note,,0,0,0,,Kairouseki: Deniz TaşıDialogue: 0,0:13:34.08,0:13:35.02,Main,,0,0,0,,İki!Dialogue: 0,0:13:36.92,0:13:37.84,Main,,0,0,0,,Bir!Dialogue: 0,0:13:39.26,0:13:41.80,Main,,0,0,0,,Durun biraz! Buradayım! Ateş etmeyin!Dialogue: 0,0:13:47.16,0:13:49.05,Main,,0,0,0,,Bana doğru tutmayın şunları!Dialogue: 0,0:13:49.05,0:13:53.32,Main,,0,0,0,,Sahi ya, kairouseki mermimiz yoktu.Dialogue: 0,0:13:53.32,0:13:54.19,Main,,0,0,0,,Ne?!Dialogue: 0,0:13:55.10,0:13:58.08,Main,,0,0,0,,Ama aynı işi gören mızraklarımız var!Dialogue: 0,0:13:58.66,0:14:03.08,Main,,0,0,0,,Böyle ayakta kaldık, kalemin içine buyrun.Dialogue: 0,0:14:06.40,0:14:09.28,Main,,0,0,0,,Bu bir emirdir.Dialogue: 0,0:14:09.28,0:14:12.60,Main,,0,0,0,,Lanet olsun! Avucunda oynatıyor bizi!Dialogue: 0,0:14:53.16,0:14:54.74,Main,,0,0,0,,Beklettim biraz.Dialogue: 0,0:14:57.30,0:15:00.44,Main,,0,0,0,,Bir şey yer misiniz?Dialogue: 0,0:15:00.92,0:15:01.79,Main,,0,0,0,,İstemez.Dialogue: 0,0:15:02.48,0:15:05.32,Main,,0,0,0,,Çekinmenin lüzumu yok. Bir bardak şarap ikram edelim?Dialogue: 0,0:15:07.24,0:15:10.24,Main,,0,0,0,,İstemiyoruz dedik! Ne istiyorsan söyle artık!Dialogue: 0,0:15:11.20,0:15:15.41,Thoughts,,0,0,0,,Öldük biz! Öldük biz! Öldük biz!Dialogue: 0,0:15:15.41,0:15:17.68,Main,,0,0,0,,Böyle galeyana gelmeye gerek yok.Dialogue: 0,0:15:24.10,0:15:30.50,Main,,0,0,0,,Bir hafta önce denizde birbirimize  ateş ettiğimizden bu yana durum biraz değişti.Dialogue: 0,0:15:31.24,0:15:34.60,Main,,0,0,0,,Bu daveti sana teslim etmem emredildi.Dialogue: 0,0:15:34.60,0:15:38.00,Main,,0,0,0,,Mama'nın çay partisi için.Dialogue: 0,0:15:38.00,0:15:39.34,Main,,0,0,0,,Saçmalık.Dialogue: 0,0:15:39.68,0:15:42.71,Main,,0,0,0,,Big Mom'ın çay partisinde ne işim olur?!Dialogue: 0,0:15:42.71,0:15:45.48,Main,,0,0,0,,Partinin gözde olayı bir düğün.Dialogue: 0,0:15:46.20,0:15:49.83,Main,,0,0,0,,Damat Vinsmoke Ailesi'nin üçüncü oğlu...Dialogue: 0,0:15:50.28,0:15:52.31,Captions,,0,70,360,,Damat   Vinsmoke Ailesi'nin 3. Oğlu    SanjiDialogue: 0,0:15:51.36,0:15:52.30,Main,,0,0,0,,...Sanji!Dialogue: 0,0:15:52.91,0:15:53.64,Main,,0,0,0,,Ne?!Dialogue: 0,0:15:54.93,0:15:55.90,Main,,0,0,0,,Ne?!Dialogue: 0,0:15:55.90,0:15:58.11,Main,,0,0,0,,Ne?!!Dialogue: 0,0:15:57.52,0:16:00.45,Captions,,0,70,360,,Damat   Vinsmoke Ailesi'nin 3. Oğlu    SanjiDialogue: 0,0:15:58.11,0:15:59.09,Main,,0,0,0,,Gelinse...Dialogue: 0,0:15:59.00,0:16:02.36,Captions,,0,0,0,,Gelin   Charlotte Ailesi'nin 35. Kızı   PuddingDialogue: 0,0:15:59.09,0:16:02.74,Main,,0,0,0,,...Charlotte Ailesi'nin 35. kızı, Pudding.Dialogue: 0,0:16:20.31,0:16:22.34,Captions,,0,0,0,,ÇAY PARTİSİDialogue: 0,0:16:22.68,0:16:24.46,Main,,0,0,0,,Ça-Çay partisi sırasında...Dialogue: 0,0:16:24.14,0:16:25.52,Captions,,0,0,0,,Damat   Vinsmoke Ailesi'nin 3. Oğlu    SanjiDialogue: 0,0:16:24.14,0:16:25.52,Captions,,0,0,0,,Gelin   Charlotte Ailesi'nin 35. Kızı   PuddingDialogue: 0,0:16:25.84,0:16:27.72,Main,,0,0,0,,Sanji'yi mi evlendirecekler?!Dialogue: 0,0:16:27.41,0:16:28.75,Captions,,0,0,0,,Damat   Vinsmoke Ailesi'nin 3. Oğlu    SanjiDialogue: 0,0:16:27.41,0:16:28.75,Captions,,0,0,0,,Gelin   Charlotte Ailesi'nin 35. Kızı   PuddingDialogue: 0,0:16:30.58,0:16:33.05,Captions,,0,0,0,,Damat   Vinsmoke Ailesi'nin 3. Oğlu    SanjiDialogue: 0,0:16:30.58,0:16:33.05,Captions,,0,0,0,,Gelin   Charlotte Ailesi'nin 35. Kızı   PuddingDialogue: 0,0:16:33.05,0:16:33.98,Captions,,0,0,0,,Damat   Vinsmoke Ailesi'nin 3. Oğlu    SanjiDialogue: 0,0:16:33.05,0:16:33.98,Captions,,0,0,0,,Gelin   Charlotte Ailesi'nin 35. Kızı   PuddingDialogue: 0,0:16:39.68,0:16:40.96,Main,,0,0,0,,Al hadi.Dialogue: 0,0:16:45.38,0:16:47.81,Captions,,0,0,0,,Damat   Vinsmoke Ailesi'nin 3. Oğlu    SanjiDialogue: 0,0:16:45.38,0:16:47.81,Captions,,0,0,0,,Gelin   Charlotte Ailesi'nin 35. Kızı   PuddingDialogue: 0,0:16:45.38,0:16:47.81,Captions,,0,0,0,,ÇAY PARTİSİDialogue: 0,0:16:47.82,0:16:48.76,Captions,,0,0,0,,Damat   Vinsmoke Ailesi'nin 3. Oğlu    SanjiDialogue: 0,0:16:47.82,0:16:48.76,Captions,,0,0,0,,Gelin   Charlotte Ailesi'nin 35. Kızı   PuddingDialogue: 0,0:16:50.06,0:16:51.89,Main,,0,0,0,,Bunca yıl sonra ne bu şimdi?!Dialogue: 0,0:16:51.29,0:16:54.99,Captions,,0,0,0,,Vinsmoke Ailesi'nin 3. OğluDialogue: 0,0:16:51.89,0:16:54.99,Main,,0,0,0,,Ailenle neler döndü bilmiyorum.Dialogue: 0,0:16:59.56,0:17:02.74,Main,,0,0,0,,Puşt herif,  kalemi aleve vermeye mi çalışıyorsun?!Dialogue: 0,0:17:03.28,0:17:05.38,Main,,0,0,0,,Hey, Sanji-kun, ne oluyor?!Dialogue: 0,0:17:05.38,0:17:07.28,Main,,0,0,0,,Evlenecek misin?!Dialogue: 0,0:17:08.86,0:17:10.98,Main,,0,0,0,,Buna kim karar verdi?!Dialogue: 0,0:17:11.60,0:17:14.20,Main,,0,0,0,,Ailenden başka kim olabilir?!Dialogue: 0,0:17:14.76,0:17:19.60,Main,,0,0,0,,Vinsmoke Ailesi'nin oğlu olmana rağmen amma terbiyesizmişsin.Dialogue: 0,0:17:20.44,0:17:23.74,Main,,0,0,0,,Sanji-san'ın soyadı Vinsmoke muymuş?!Dialogue: 0,0:17:24.24,0:17:26.92,Main,,0,0,0,,Nedense insanın kanını donduran bir isim...Dialogue: 0,0:17:27.52,0:17:29.53,Main,,0,0,0,,Ama yok, olamaz yani.Dialogue: 0,0:17:29.53,0:17:31.12,Main,,0,0,0,,Bir bardak şarap getirin!Dialogue: 0,0:17:31.12,0:17:31.70,Main,,0,0,0,,Emredersiniz!Dialogue: 0,0:17:32.20,0:17:33.96,Main,,0,0,0,,Sanji-kun'un ailesi...Dialogue: 0,0:17:34.94,0:17:36.72,Flashbacks,,0,0,0,,"Yalancı Noland" mı?Dialogue: 0,0:17:36.72,0:17:38.40,Flashbacks,,0,0,0,,Biliyor musun Sanji-kun?Dialogue: 0,0:17:38.75,0:17:42.18,Flashbacks,,0,0,0,,Kuzey Mavi'de basılmış gerçi ama...Dialogue: 0,0:17:42.18,0:17:45.62,Flashbacks,,0,0,0,,Evet. Kuzey Mavi'de doğdum ben.Dialogue: 0,0:17:46.18,0:17:48.23,Flashbacks,,0,0,0,,Söylememiş miydim?Dialogue: 0,0:17:48.23,0:17:51.98,Flashbacks,,0,0,0,,İlk defa duyuyorum. Senin de Doğu'dan olduğunu sanıyordum.Dialogue: 0,0:17:51.98,0:17:55.24,Flashbacks,,0,0,0,,Orada büyüdüm. Ama ne fark eder ki?Dialogue: 0,0:17:56.60,0:17:59.39,Main,,0,0,0,,O zaman epey tuhaf gelmişti.Dialogue: 0,0:17:59.84,0:18:04.74,Main,,0,0,0,,Sanji-kun'la Doğu Mavi'de tanışmıştık ama bize Kuzey'de doğduğunu söyledi.Dialogue: 0,0:18:04.74,0:18:07.18,Main,,0,0,0,,Ne?! Doğru mu bu Nami-san?!Dialogue: 0,0:18:07.74,0:18:10.58,Main,,0,0,0,,Eğer doğruysa durum ciddi demektir!Dialogue: 0,0:18:14.70,0:18:19.86,Main,,0,0,0,,Kuzey Mavi'den Doğu Mavi'ye varabilmek için Red Line'ı aşmak gerekir!Dialogue: 0,0:18:19.86,0:18:21.03,Main,,0,0,0,,Aynen öyle!Dialogue: 0,0:18:21.03,0:18:23.14,Main,,0,0,0,,Zor bir şey mi ki bu?Dialogue: 0,0:18:23.14,0:18:26.68,Main,,0,0,0,,Evet, öyle bir yerden bir yere taşınmak gibi bir şey değil.Dialogue: 0,0:18:26.68,0:18:27.78,Main,,0,0,0,,Devasa bir seyahat!Dialogue: 0,0:18:29.36,0:18:32.52,Main,,0,0,0,,Sanji-san, ne tür bir çocukluk yaşadın?!Dialogue: 0,0:18:33.26,0:18:37.19,Main,,0,0,0,,Onu boşverin de, Charlotte Big Mom'ın soyadı be!Dialogue: 0,0:18:37.37,0:18:38.96,Main,,0,0,0,,Ne?!Dialogue: 0,0:18:38.96,0:18:42.56,Main,,0,0,0,,Şerefsize bak!  Big Mom'ın kızıyla mı evlenecek?!Dialogue: 0,0:18:42.96,0:18:45.70,Main,,0,0,0,,Sanji Yonko'nun ailesine mi katılacak?!Dialogue: 0,0:18:45.70,0:18:51.45,Main,,0,0,0,,Tayfanızdan biri onun damadı olursa siz de Big Mom'ın adamı olmuş sayılırsınız!Dialogue: 0,0:18:51.45,0:18:52.72,Main,,0,0,0,,Ne?!Dialogue: 0,0:18:52.72,0:18:54.18,Main,,0,0,0,,Hemen sonuca atlamayın!Dialogue: 0,0:18:56.16,0:18:59.48,Main,,0,0,0,,Bu çay partisine gitmem için hiçbir neden yok!Dialogue: 0,0:19:00.18,0:19:01.99,Main,,0,0,0,,Saçmalığın daniskası!Dialogue: 0,0:19:01.99,0:19:03.66,Main,,0,0,0,,Evlilik töreniymiş!Dialogue: 0,0:19:04.03,0:19:06.49,Main,,0,0,0,,Hem de yüzünü bile görmediğim biriyle?!Dialogue: 0,0:19:06.49,0:19:08.00,Main,,0,0,0,,Olmaz öyle iş!Dialogue: 0,0:19:13.36,0:19:17.37,Main,,0,0,0,,Ayrıca Hasır Şapkalar' ın sizin emrinizde olmasını da istemiyorum!Dialogue: 0,0:19:18.02,0:19:22.06,Main,,0,0,0,,Kaptanımız başkalarının altında çalışabilecek bir adam değildir!Dialogue: 0,0:19:23.86,0:19:25.03,Main,,0,0,0,,Luffy...Dialogue: 0,0:19:25.88,0:19:27.96,Main,,0,0,0,,...Korsanlar Kralı olacak adam!Dialogue: 0,0:19:31.16,0:19:34.45,Main,,0,0,0,,Diyeceğin başka bir şey yoksa Caesar'ı alabilirsin.Dialogue: 0,0:19:34.45,0:19:35.69,Main,,0,0,0,,Ne?!Dialogue: 0,0:19:36.72,0:19:41.89,Main,,0,0,0,,Bir şeyleri yanlış anladın sanırım? Davetiye bakman içindi yalnızca.Dialogue: 0,0:19:42.80,0:19:45.96,Main,,0,0,0,,Vereceğin cevabın bir önemi yok.Dialogue: 0,0:19:46.72,0:19:50.68,Main,,0,0,0,,Vücudumun içindesin sonuçta!Dialogue: 0,0:19:54.28,0:19:59.93,Main,,0,0,0,,Hepiniz çoktan tutsak edildiniz! Sizi Mama'ya götüreceğim!Dialogue: 0,0:19:59.93,0:20:00.62,Main,,0,0,0,,Ne?!Dialogue: 0,0:20:05.42,0:20:07.87,Main,,0,0,0,,Her şey sabit gibi görünüyor olabilir...Dialogue: 0,0:20:08.83,0:20:10.45,Main,,0,0,0,,...ama çoktan hareket etmeye başladım bile.Dialogue: 0,0:20:11.32,0:20:12.96,Main,,0,0,0,,Gerçekten de hareket halinde miyiz?!Dialogue: 0,0:20:13.15,0:20:16.52,Main,,0,0,0,,Öldürecek beni! Bırakın!Dialogue: 0,0:20:18.10,0:20:19.18,Main,,0,0,0,,Lanet olası...Dialogue: 0,0:20:22.22,0:20:25.12,Main,,0,0,0,,Savaşmak istiyorsan seve seve eşlik ederim.Dialogue: 0,0:20:29.83,0:20:30.85,Main,,0,0,0,,Bu da ne?!Dialogue: 0,0:20:33.12,0:20:34.14,Main,,0,0,0,,Sanji-kun!Dialogue: 0,0:20:49.40,0:20:52.72,Main,,0,0,0,,Kalenin içinde tam hakimiyete sahibim!Dialogue: 0,0:21:00.94,0:21:03.96,Main,,0,0,0,,Her şey benim kontrolümde!Dialogue: 0,0:21:05.62,0:21:06.70,Main,,0,0,0,,Yardım edin!Dialogue: 0,0:21:07.62,0:21:09.22,Main,,0,0,0,,Nami batıyor!Dialogue: 0,0:21:09.22,0:21:10.01,Main,,0,0,0,,Nami-san!Dialogue: 0,0:21:11.10,0:21:12.02,Main,,0,0,0,,Dur!Dialogue: 0,0:21:12.70,0:21:14.56,Main,,0,0,0,,Dur dedim!Dialogue: 0,0:21:22.86,0:21:24.08,Main,,0,0,0,,İyi misin?Dialogue: 0,0:21:24.08,0:21:24.98,Main,,0,0,0,,Evet.Dialogue: 0,0:21:24.98,0:21:26.35,Main,,0,0,0,,Şükürler olsun!Dialogue: 0,0:21:26.35,0:21:32.44,Main,,0,0,0,,Sana bir şey yapmasam bile Mama'nın çay partisinden kaçamazsın.Dialogue: 0,0:21:36.94,0:21:39.74,Main,,0,0,0,,Yeni Dünya'da herkesin bildiği bir şeydir bu.Dialogue: 0,0:21:43.34,0:21:44.36,Main,,0,0,0,,Aynen öyle.Dialogue: 0,0:21:44.38,0:21:50.66,Main,,0,0,0,,Mama acı şekerlemelerden ve çay partilerindeki boş koltuklardan nefret eder-rero.Dialogue: 0,0:21:55.26,0:21:58.38,Main,,0,0,0,,Olur da cahilin biri onu reddederse-rero...Dialogue: 0,0:21:58.38,0:22:01.96,Main,,0,0,3,,...o kişinin pişmanlık çığlıklarını...Dialogue: 0,0:22:01.96,0:22:04.34,Main,,0,0,3,,...duymaya katlanamam-rorero!Dialogue: 0,0:22:00.18,0:22:06.34,Captions,,0,0,235,,Ateş Tankı Korsanları Müşaviri "Hayalet Tüfek" VitoDialogue: 0,0:22:07.52,0:22:11.84,Main,,0,0,0,,Big Mom'dan gelen çay partisi daveti-rero...Dialogue: 0,0:22:12.17,0:22:17.18,Main,,0,0,0,,...özünde karşı gelinemeyecek bir çağrıdır!Dialogue: 0,0:22:17.52,0:22:23.95,Main,,0,0,0,,Şeytanın ta kendisi bile cehennemden kalkıp Mama'nın çay partisi davetine icabet edermiş!Dialogue: 0,0:22:25.56,0:22:28.56,Main,,0,0,0,,Elbette gitmeme özgürlüğüne sahipsin-rorero.Dialogue: 0,0:22:28.98,0:22:31.46,Main,,0,0,0,,Ama olur da reddedersen...Dialogue: 0,0:22:34.92,0:22:36.77,Main,,0,0,0,,Kulağına söyleyeceğim-rorero.Dialogue: 0,0:23:19.16,0:23:21.51,Main,,0,0,0,,Bunu nasıl öğrendiniz?!Dialogue: 0,0:23:22.75,0:23:23.88,Main,,0,0,0,,Aptalca bir soru bu.Dialogue: 0,0:23:24.98,0:23:28.30,Main,,0,0,0,,Efendimizi kim sanıyorsun sen?Dialogue: 0,0:23:29.04,0:23:33.79,Main,,0,0,0,,Yeni Dünya'da mutlak hüküm süren en güçlü korsanlardan biri olan...Dialogue: 0,0:23:34.50,0:23:38.30,Main,,0,0,0,,...Yonko Big Mom.Dialogue: 0,0:23:38.30,0:23:40.73,Main,,0,0,0,,Her şeyin sahibidir.Dialogue: 0,0:23:40.73,0:23:44.40,Main,,0,0,0,,Birisine "seni öldüreceğim" derse o kişi ölür.Dialogue: 0,0:23:46.16,0:23:47.57,Main,,0,0,0,,Blöf yapmaz.Dialogue: 0,0:23:49.17,0:23:52.78,Main,,0,0,0,,Ağzından çıkacak her kelimeyi hayatın söz konusuymuşçasına tart.Dialogue: 0,0:23:53.51,0:23:58.18,Main,,0,0,0,,Birilerinin emrinde olmadan hayatta kalmayı istiyorsan...Dialogue: 0,0:23:58.18,0:24:00.78,Main,,0,0,0,,...şimdilik dediklerinden çıkma.Dialogue: 0,0:24:08.16,0:24:10.66,Main,,0,0,0,,Sanji-san, iyi misin?Dialogue: 0,0:24:10.66,0:24:13.16,Main,,0,0,0,,O adam kulağına ne söyledi?Dialogue: 0,0:24:15.20,0:24:19.44,Main,,0,0,0,,Ne oldu Sanji?! Düşmanımız Yonko bile olsa savaşırız!Dialogue: 0,0:24:19.44,0:24:20.74,Main,,0,0,0,,Oturun oturduğunuz yerde!Dialogue: 0,0:24:34.56,0:24:36.74,Main,,0,0,0,,Kağıt kalem verin.Dialogue: 0,0:24:38.39,0:24:40.92,Main,,0,0,0,,Hasır Şapka'ya not mu bırakacaksın?Dialogue: 0,0:24:52.74,0:24:55.37,Main,,0,0,0,,Bunu Luffyler'e verin.Dialogue: 0,0:24:56.46,0:24:58.48,Main,,0,0,0,,Sanji-kun...Dialogue: 0,0:24:58.48,0:24:59.68,Main,,0,0,0,,Nami-san.Dialogue: 0,0:25:01.11,0:25:02.12,Main,,0,0,0,,Chopper.Dialogue: 0,0:25:03.21,0:25:04.04,Main,,0,0,0,,Brook.Dialogue: 0,0:25:05.22,0:25:06.82,Main,,0,0,0,,Hiçbir şeye olmasa bile bu diyeceğime inanın.Dialogue: 0,0:25:08.02,0:25:11.24,Main,,0,0,0,,Dostlarımdan hiçbir şey saklamak istemedim.Dialogue: 0,0:25:14.31,0:25:19.04,Main,,0,0,0,,Bir daha karşıma çıkmayacağını düşündüğüm bir geçmişti.Dialogue: 0,0:25:20.63,0:25:24.88,Main,,0,0,0,,Ne pahasına olursa olsun yalnız gidip işleri yoluna koymam lazım!Dialogue: 0,0:25:27.86,0:25:31.41,Main,,0,0,0,,Bekle biraz Sanji-san, ne demek "yalnız" gidip?!Dialogue: 0,0:25:32.71,0:25:37.71,Main,,0,0,0,,Dışarıda güçlü bir varlık seziyorum. Muhtemelen Mink'lerden biri.Dialogue: 0,0:25:39.02,0:25:40.22,Main,,0,0,0,,Hazır mısınız?Dialogue: 0,0:25:40.65,0:25:41.65,Main,,0,0,0,,Ne için?Dialogue: 0,0:25:41.65,0:25:42.72,Main,,0,0,0,,İyi şanslar!Dialogue: 0,0:25:57.09,0:25:58.87,Main,,0,0,0,,Beni unuttun sanki?!Dialogue: 0,0:25:59.06,0:25:59.91,Main,,0,0,0,,Adi herif!Dialogue: 0,0:25:59.91,0:26:01.44,Main,,0,0,0,,Dostlarını kurtardı!Dialogue: 0,0:26:02.88,0:26:04.92,Main,,0,0,0,,Şerefsiz!Dialogue: 0,0:26:06.12,0:26:07.74,Main,,0,0,0,,Kimse kıpırdamasın!Dialogue: 0,0:26:08.20,0:26:09.91,Main,,0,0,0,,Neden?!Dialogue: 0,0:26:10.11,0:26:11.86,Main,,0,0,0,,Kulaklarınızı açıp beni dinleyin!Dialogue: 0,0:26:12.48,0:26:16.66,Main,,0,0,0,,Biricik dahi bilim adamınızın beynini uçurmamı istemiyorsunuzdur eminim!Dialogue: 0,0:26:17.48,0:26:20.09,Main,,0,0,0,,Unutmam bunu, Kara Bacak!Dialogue: 0,0:26:20.28,0:26:21.33,Main,,0,0,0,,Tahmin ettiğim gibi...Dialogue: 0,0:26:21.52,0:26:24.54,Main,,0,0,0,,Beni de öldüremiyorsunuz değil mi?!Dialogue: 0,0:26:25.52,0:26:29.56,Main,,0,0,0,,Bu evlilik meselesini öğrenmem sırlardan birini çözdü bile.Dialogue: 0,0:26:30.03,0:26:33.26,Main,,0,0,0,,Aranıyor posterimde "Sadece Diri" yazıyor!Dialogue: 0,0:26:33.76,0:26:35.11,Main,,0,0,0,,Beni canlı yakalamanız lazım!Dialogue: 0,0:26:37.06,0:26:40.76,Main,,0,0,0,,Beni öldürürseniz eminim birilerini fena kızdıracaksınız!Dialogue: 0,0:26:41.21,0:26:45.32,Main,,0,0,0,,Eminim beni zincire vurmamanız, bana insan gibi davranmanız da söylenmiştir!Dialogue: 0,0:26:45.78,0:26:49.69,Main,,0,0,0,,O posteri o şekilde yaptıran kişi de evliliğimi ayarlayan kişi de...Dialogue: 0,0:26:49.88,0:26:51.70,Main,,0,0,0,,...aynı kişi olmalı!Dialogue: 0,0:26:55.29,0:26:57.33,Main,,0,0,0,,Lanet olsun! Dışarı çıkıp peşlerine düşelim!Dialogue: 0,0:26:57.52,0:26:59.16,Main,,0,0,0,,Kıpırdamayın demedim mi size?!Dialogue: 0,0:26:59.36,0:27:01.53,Main,,0,0,0,,Lütfen kıpırdamayın!Dialogue: 0,0:27:01.73,0:27:05.90,Main,,0,0,0,,Sırtımı kollayan biri olduğunu anlamışsınızdır!Dialogue: 0,0:27:06.80,0:27:12.24,Main,,0,0,0,,Endişelenmeyin. O kişiyle bu meseleyi çözmek için sizinle geleceğim.Dialogue: 0,0:27:13.17,0:27:16.08,Main,,0,0,0,,O yüzden dostlarıma dokunmayın!Dialogue: 0,0:27:17.77,0:27:19.68,Main,,0,0,0,,Kimse dışarı çıkmasın!Dialogue: 0,0:27:19.88,0:27:20.76,Main,,0,0,0,,Ne?!Dialogue: 0,0:27:20.76,0:27:21.49,Main,,0,0,0,,Baba!Dialogue: 0,0:27:29.60,0:27:34.58,Main,,0,0,0,,Şu an... dışarıda... bir canavar var!Dialogue: 0,0:27:39.36,0:27:41.64,Main,,0,0,0,,Nekomamushi Efendi...Dialogue: 0,0:27:41.64,0:27:44.84,Thoughts,,0,0,0,,Canavar kedi mi?! Burada böyle tehlikeli biri olduğunu bilmiyordum!Dialogue: 0,0:27:46.02,0:27:46.88,Main,,0,0,0,,Hey!Dialogue: 0,0:27:48.62,0:27:51.30,Main,,0,0,0,,Siz-gara da kimsiniz?Dialogue: 0,0:27:52.04,0:27:56.55,Main,,0,0,0,,Pekoms'u kan revan içinde baygın buldum.Dialogue: 0,0:27:56.55,0:28:00.33,Main,,0,0,0,,Yanlış anladın, ben Pekoms'un tayfadanım!Dialogue: 0,0:28:00.33,0:28:01.66,Main,,0,0,0,,Tayfa mı?Dialogue: 0,0:28:01.85,0:28:04.93,Main,,0,0,0,,Evet, aynı korsan grubuna bağlıyız!Dialogue: 0,0:28:04.93,0:28:07.80,Main,,0,0,0,,İşin aslı Jack'ın tayfadan kalanların saldırısına uğradık!Dialogue: 0,0:28:09.83,0:28:11.00,Main,,0,0,0,,Ne diyorsun sen be?!Dialogue: 0,0:28:11.20,0:28:13.20,Main,,0,0,0,,Kendi dostumu neden vurayım ki?!Dialogue: 0,0:28:14.46,0:28:17.49,Main,,0,0,0,,Sanji-kun, dışarı çık! Neden orada kaldın?!Dialogue: 0,0:28:17.49,0:28:21.14,Main,,0,0,0,,Neler oluyor söyle bize Sanji!Dialogue: 0,0:28:21.34,0:28:26.14,Main,,0,0,0,,Ne demek yalnız gideceğim!? Hep beraber gitsek olmuyor mu?!Dialogue: 0,0:28:26.14,0:28:28.65,Main,,0,0,0,,Luffy-sanlar'ı bekleyelim, Sanji-san!Dialogue: 0,0:28:35.70,0:28:37.95,Main,,0,0,0,,Bu benim sorunum.Dialogue: 0,0:28:37.95,0:28:39.52,Main,,0,0,0,,Geri döneceğim.Dialogue: 0,0:28:41.58,0:28:43.90,Main,,0,0,0,,Onlara benden selam söyleyin.Dialogue: 0,0:28:50.77,0:28:51.74,Main,,0,0,0,,Castle Tank!Dialogue: 0,0:28:50.77,0:28:51.74,Attack,,0,0,0,,Kale TankDialogue: 0,0:28:57.27,0:28:59.16,Main,,0,0,0,,Sanji!Dialogue: 0,0:29:00.62,0:29:01.88,Main,,0,0,0,,Sanji-kun!Dialogue: 0,0:29:09.62,0:29:12.46,Main,,0,0,0,,Nami, Chopper! Peşine düşeyim mi?!Dialogue: 0,0:29:12.66,0:29:14.64,Main,,0,0,0,,Hayır, boşa uğraşmış olursun Wanda-san!Dialogue: 0,0:29:15.19,0:29:16.13,Main,,0,0,0,,Baron Ceset!Dialogue: 0,0:29:18.88,0:29:21.96,Main,,0,0,0,,Peşinden gitsek bile onun şimdi...Dialogue: 0,0:29:22.96,0:29:25.00,Main,,0,0,0,,...geri döneceğini sanmıyorum.Dialogue: 0,0:29:25.27,0:29:31.00,Captions,,850,0,380,,Hergele dostlarıma. Bir kadını görmeye gidiyorum. Mutlaka geri döneceğim.  SanjiDialogue: 0,0:29:30.98,0:29:36.80,OP11 Credits,,0,0,0,,Editing: Galaxy 9000  Timing: Datenshi, Sewil  QC: Mr Luffy, Galaxy 9000, Datenshi  Soundtracking: Halee  TC/Infoboxes: Datenshi  Translation: Yibis