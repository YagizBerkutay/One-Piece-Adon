,0.0,0,1,1.8,0,2,22,22,18,1Style: Author,Impress BT,20.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.7,0.7,9,10,10,10,1Style: Attack,Duality,30.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.0,1.0,7,12,12,12,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:01.12,0:00:07.12,Lyrics,,0,0,0,,♪ Görmedim dünyanın sonunu kendi gözlerimle hiç. ♪Dialogue: 0,0:00:07.12,0:00:14.25,Lyrics,,0,0,0,,♪ O yüzden çıktım yola sizinle, bunu yapmak için! ♪Dialogue: 0,0:00:23.97,0:00:27.30,Lyrics,,0,0,0,,♪ Bir denizden diğerine yol alırken,...Dialogue: 0,0:00:29.36,0:00:32.15,Lyrics,,0,0,0,,...bunun sadece bir peri masalı olduğunu söylemek. ♪Dialogue: 0,0:00:32.15,0:00:39.08,Lyrics,,0,0,0,,♪ Gerçek, kurgudan daha tuhaf değil mi? ♪Dialogue: 0,0:00:40.24,0:00:43.48,Lyrics,,0,0,0,,♪ Fakat sırt çevirme hiçbirine. ♪Dialogue: 0,0:00:43.86,0:00:50.34,Lyrics,,0,0,0,,♪ Sağduyu dedikleri zihnidir toplulukların! ♪Dialogue: 0,0:00:51.66,0:00:57.71,Lyrics,,0,0,0,,♪ Görmedim dünyanın sonunu kendi gözlerimle hiç. ♪Dialogue: 0,0:00:57.71,0:01:02.26,Lyrics,,0,0,0,,♪ O yüzden gitmemiz lazım Kaptan Özgür-Ruh! ♪Dialogue: 0,0:01:02.26,0:01:04.97,Lyrics,,0,0,0,,♪ Kim demiş imkansız diye,...Dialogue: 0,0:01:04.97,0:01:08.05,Lyrics,,0,0,0,,...daha hiçbir şey başlamadan! ♪Dialogue: 0,0:01:08.05,0:01:13.02,Lyrics,,0,0,0,,♪ Her şeyi bilmek istiyorum ve şimdi bilebiliriz de... ♪Dialogue: 0,0:01:13.02,0:01:18.98,Lyrics,,0,0,0,,♪ Bilebiliriz, bilebilirsin! Şu anda... ♪Dialogue: 0,0:01:19.36,0:01:24.40,Lyrics,,0,0,0,,♪ Bilebiliriz, bilebilirim! Bu harika hissi... ♪Dialogue: 0,0:01:24.69,0:01:31.62,Lyrics,,0,0,0,,♪ Hemen, şimdi, bilebiliriz! ♪Dialogue: 0,0:01:37.64,0:01:38.94,Lyrics,,0,0,0,,♪ Evet, bilebiliriz! ♪Dialogue: 0,0:01:41.74,0:01:44.12,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:10:56.60,0:11:03.60,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:20:34.23,0:20:37.16,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:01:41.74,0:01:44.12,Title,,0,0,450,,Mink KabilesiDialogue: 0,0:01:44.14,0:01:46.62,Main,,0,0,0,,Etetetetete...Dialogue: 0,0:01:46.62,0:01:47.64,Main,,0,0,0,,Ete mi?Dialogue: 0,0:01:47.64,0:01:51.02,Main,,0,0,0,,Evet! Raizo "tetete" diye koşan bir ninjadır-de gozaru.Dialogue: 0,0:01:51.02,0:01:53.52,Main,,0,0,0,,Bir de şöyle bir gücü de vardı.Dialogue: 0,0:01:53.52,0:01:57.28,Main,,0,0,0,,Ninpo Gözbağı Jutsusu! Bil bakalım kimim!Dialogue: 0,0:01:57.28,0:02:01.80,Main,,0,0,0,,Se-Sen misin Kanjuro? Yani arkamda senden başkası yok zaten.Dialogue: 0,0:02:01.80,0:02:05.34,Main,,0,0,0,,Eyvah! Eğilin!Dialogue: 0,0:02:08.22,0:02:11.12,Main,,0,0,0,,Hey! Şu ninpo saçmalıklarını...Dialogue: 0,0:02:13.71,0:02:16.34,Main,,0,0,0,,Eyvah, düştüler!Dialogue: 0,0:02:16.34,0:02:19.78,Main,,0,0,0,,Lanet olsun! Birden üstümüze düşen o şey de neyin nesiydi?!Dialogue: 0,0:02:19.78,0:02:25.18,Main,,0,0,0,,Bilmiyorum ama sanki bedenine bıçaklar saplı kan revan içinde bir insandı...Dialogue: 0,0:02:25.18,0:02:26.28,Main,,0,0,0,,Ne?!Dialogue: 0,0:02:26.28,0:02:27.64,Main,,0,0,0,,Ya da küçük bir maymun.Dialogue: 0,0:02:27.64,0:02:30.68,Main,,0,0,0,,Korkutmasana insanı ya! Hem nasıl bir algı gücüdür bu?!Dialogue: 0,0:02:30.68,0:02:34.90,Main,,0,0,0,,Kin'emon! Kanjuro!Dialogue: 0,0:02:34.90,0:02:38.84,Secondary,,0,0,0,,Kin'emon! Kanjuro!Dialogue: 0,0:02:38.84,0:02:40.36,Main,,0,0,0,,Denize mi düştüler acaba?Dialogue: 0,0:02:40.36,0:02:41.68,Main,,0,0,0,,Yardım edelim!Dialogue: 0,0:02:41.68,0:02:46.17,Main,,0,0,0,,Luffy-dono, biz iyiyiz-de gozaru!Dialogue: 0,0:02:46.17,0:02:47.50,Main,,0,0,0,,Kin'mon'un sesi bu!Dialogue: 0,0:02:47.50,0:02:49.42,Main,,0,0,0,,Şükürler olsun, iyiler!Dialogue: 0,0:02:49.42,0:02:53.74,Main,,0,0,0,,Siz devam edin! Biz size yetişiriz!Dialogue: 0,0:02:53.74,0:02:57.02,Main,,0,0,0,,Ne diyor bu, hayatta olmaz! Geri dönelim!Dialogue: 0,0:02:57.02,0:03:00.52,Main,,0,0,0,,Ejderha, geri dönüyoruz!Dialogue: 0,0:03:02.23,0:03:04.88,Main,,0,0,0,,Ryunosuke, aşağı gidece-Dialogue: 0,0:03:07.73,0:03:09.95,Main,,0,0,0,,Hey, Ryunosuke...Dialogue: 0,0:03:16.56,0:03:19.84,Main,,0,0,0,,Bu zavallı şeye nasıl geri dön deriz?!Dialogue: 0,0:03:19.84,0:03:23.28,Main,,0,0,0,,O da en kısa sürede işini bitirmek istiyor anlaşılan.Dialogue: 0,0:03:23.28,0:03:26.67,Main,,0,0,0,,Dehşet acı çekiyor. İyisi mi yola devam edelim.Dialogue: 0,0:03:26.67,0:03:28.02,Thoughts,,0,0,0,,Çok şirin...Dialogue: 0,0:03:28.02,0:03:32.19,Main,,0,0,0,,O zaman biz önden devam ediyoruz! Görüşmek üzere!Dialogue: 0,0:03:32.19,0:03:34.36,Main,,0,0,0,,Pekâlâ!Dialogue: 0,0:03:34.36,0:03:37.06,Main,,0,0,0,,Hey! Ülkeye girmenize izin vermem!Dialogue: 0,0:03:37.06,0:03:38.92,Main,,0,0,0,,Gidin!Dialogue: 0,0:03:39.24,0:03:43.58,Main,,0,0,0,,Ha? Tanımadığım bir ses de duydum sanki...Dialogue: 0,0:03:59.68,0:04:02.47,Main,,0,0,0,,Dayan Ryunosuke!Dialogue: 0,0:04:02.47,0:04:04.42,Main,,0,0,0,,Başarabilirsin!Dialogue: 0,0:04:04.42,0:04:05.74,Main,,0,0,0,,Luffy!Dialogue: 0,0:04:08.89,0:04:10.96,Main,,0,0,0,,Zirve değil mi şu?!Dialogue: 0,0:04:10.96,0:04:12.08,Main,,0,0,0,,Ne?Dialogue: 0,0:04:12.08,0:04:14.24,Main,,0,0,0,,Evet öyle!Dialogue: 0,0:04:14.24,0:04:17.14,Main,,0,0,0,,Çok az kaldı Ryunosuke!Dialogue: 0,0:04:18.00,0:04:19.46,Main,,0,0,0,,Zirve mi?!Dialogue: 0,0:04:19.46,0:04:22.06,Main,,0,0,0,,Zirveye çok az kaldı!Dialogue: 0,0:04:28.00,0:04:30.16,Main,,0,0,0,,Oha! Hıza bak!Dialogue: 0,0:04:30.16,0:04:32.96,Main,,0,0,0,,Ryunosuke final çizgisini görünce hızlanıyor!Dialogue: 0,0:04:35.32,0:04:38.60,Main,,0,0,0,,Bastır Ryunosuke!Dialogue: 0,0:04:38.60,0:04:41.58,Main,,0,0,0,,Çok az kaldı! Koş!Dialogue: 0,0:04:41.58,0:04:43.88,Main,,0,0,0,,Çok az kaldı!Dialogue: 0,0:04:43.88,0:04:45.80,Main,,0,0,0,,♪ Çok az kaldı! ♪Dialogue: 0,0:04:45.80,0:04:47.68,Main,,0,0,0,,♪ Çok az kaldı! ♪Dialogue: 0,0:04:47.68,0:04:49.46,Main,,0,0,0,,♪ Çok az kaldı! ♪Dialogue: 0,0:04:49.46,0:04:51.60,Main,,0,0,0,,♪ Çok az kaldı! ♪Dialogue: 0,0:04:51.60,0:04:53.57,Main,,0,0,0,,♪ Çok az kaldı! ♪Dialogue: 0,0:04:53.57,0:04:56.18,Main,,0,0,0,,İşte bu! Bir şeyler görünmeye başladı!Dialogue: 0,0:04:56.18,0:04:59.18,Main,,0,0,0,,Ryunosuke dayan! Hedef burnunun ucunda!Dialogue: 0,0:05:01.21,0:05:03.65,Main,,0,0,0,,Ryunosuke!Dialogue: 0,0:05:04.16,0:05:06.04,Main,,0,0,0,,Ryunosuke!Dialogue: 0,0:05:06.04,0:05:08.29,Main,,0,0,0,,Dayan Ryunosuke!Dialogue: 0,0:05:08.29,0:05:10.44,Main,,0,0,0,,Ryunosuke!Dialogue: 0,0:05:10.44,0:05:12.42,Main,,0,0,0,,Ryunosuke!Dialogue: 0,0:05:12.42,0:05:14.40,Main,,0,0,0,,Ryunosuke!Dialogue: 0,0:05:14.40,0:05:16.76,Main,,0,0,0,,Ryunosuke!Dialogue: 0,0:05:18.43,0:05:20.28,Main,,0,0,0,,Başardık!Dialogue: 0,0:05:20.28,0:05:22.30,Main,,0,0,0,,Zirvedeyiz!Dialogue: 0,0:05:22.30,0:05:23.97,Main,,0,0,0,,Sonunda vardık!Dialogue: 0,0:05:23.97,0:05:27.20,Main,,0,0,0,,Ryunosuke, helal be!Dialogue: 0,0:05:27.20,0:05:30.34,Main,,0,0,0,,Zou'ya vardık!Dialogue: 0,0:05:36.54,0:05:39.70,Main,,0,0,0,,Çizgi haline geri döneceksin değil mi?Dialogue: 0,0:05:43.89,0:05:46.26,Main,,0,0,0,,Hey, bekle!Dialogue: 0,0:05:46.66,0:05:48.88,Main,,0,0,0,,Ryunosuke!Dialogue: 0,0:05:48.88,0:05:50.30,Main,,0,0,0,,Ryunosuke!Dialogue: 0,0:05:50.30,0:05:52.04,Main,,0,0,0,,Ryunosuke!Dialogue: 0,0:06:00.21,0:06:05.02,Main,,0,0,0,,Ryunosuke!Dialogue: 0,0:06:04.30,0:06:08.58,Secondary,,0,0,0,,Ryunosuke!Dialogue: 0,0:06:08.58,0:06:09.95,Main,,0,0,0,,Saçmalık.Dialogue: 0,0:06:09.95,0:06:11.82,Main,,0,0,0,,Dandik çizimin tekiydi işte.Dialogue: 0,0:06:11.82,0:06:13.98,Main,,0,0,0,,Hey, duygusuz alçaklar sizi!Dialogue: 0,0:06:13.98,0:06:16.86,Main,,0,0,0,,Buraya kadar sırtında taşıdı bizi, hiç mi utanmanız yok?!Dialogue: 0,0:06:16.86,0:06:19.96,Main,,0,0,0,,Yabancı topraklardayız. Gözümüzü ardımızı çeviremeyiz.Dialogue: 0,0:06:19.96,0:06:23.17,Main,,0,0,0,,Haklısın da...Dialogue: 0,0:06:23.17,0:06:26.40,Main,,0,0,0,,Usopp, Ryunosuke dehşet biriydi değil mi?!Dialogue: 0,0:06:26.40,0:06:29.97,Main,,0,0,0,,Gözünüz hep ileride olsun. Bakın!Dialogue: 0,0:06:30.30,0:06:32.37,Main,,0,0,0,,Ülkeye giriş kapısı olmalı bu.Dialogue: 0,0:06:32.37,0:06:36.14,Main,,0,0,0,,Filin sırtında gerçekten de bir medeniyet yaşıyor.Dialogue: 0,0:06:36.14,0:06:40.86,Main,,0,0,0,,Gözetleme kulesi var ama hiç muhafız yok. Hiçbir ülkeye yakışmayan bir durum bu.Dialogue: 0,0:06:40.86,0:06:43.10,Main,,0,0,0,,Ne soğuk herifler!Dialogue: 0,0:06:43.10,0:06:47.08,Main,,0,0,0,,Cidden yani, çok çabuk unuttunuz!Dialogue: 0,0:06:47.76,0:06:51.66,Main,,0,0,0,,Hey, Usopp, sen de gelsene! Manzara dehşet!Dialogue: 0,0:06:51.66,0:06:53.66,Main,,0,0,0,,Tırmanmak için bir saniye bile kaybetmedin ha!Dialogue: 0,0:06:53.66,0:06:55.88,Main,,0,0,0,,Harika resmen!Dialogue: 0,0:06:55.88,0:07:00.02,Main,,0,0,0,,Filin sırtı böyle bir yer ha?!Dialogue: 0,0:07:28.59,0:07:33.49,Main,,0,0,0,,Vay canına! Cidden de filin sırtı mı bu?!Dialogue: 0,0:07:33.49,0:07:36.31,Main,,0,0,0,,Çok ilginç!Dialogue: 0,0:07:36.31,0:07:39.40,Main,,0,0,0,,Bin yıllık devasa bir fil...Dialogue: 0,0:07:39.40,0:07:42.08,Main,,0,0,0,,...ve sırtında da koca bir ülke taşıyor!Dialogue: 0,0:07:42.08,0:07:43.82,Main,,0,0,0,,Evet!Dialogue: 0,0:07:44.68,0:07:48.12,Main,,0,0,0,,Ormanı, akarsuyu, şehri var!Dialogue: 0,0:07:48.12,0:07:50.84,Main,,0,0,0,,Gerçekten de harika! Normal bir adadan farkı yok!Dialogue: 0,0:07:50.84,0:07:53.40,Main,,0,0,0,,Usopp, şu ağaca bak, balinaya benziyor!Dialogue: 0,0:07:53.40,0:07:54.98,Main,,0,0,0,,Öyle gerçekten de!Dialogue: 0,0:07:54.98,0:07:58.26,Main,,0,0,0,,Şehir de düşündüğümden daha büyükmüş!Dialogue: 0,0:07:58.26,0:08:01.73,Main,,0,0,0,,Ama nedense sanki biraz...Dialogue: 0,0:08:04.00,0:08:05.74,Main,,0,0,0,,Luffy atladı!Dialogue: 0,0:08:05.74,0:08:08.40,Main,,0,0,0,,Tahmin etmiştim. Kıvırcık Kaş'dan haber var mı?Dialogue: 0,0:08:08.40,0:08:09.30,Main,,0,0,0,,Yok.Dialogue: 0,0:08:09.30,0:08:12.00,Main,,0,0,0,,Çıplak gözle bu yükseklikte bizi kimse göremez zaten.Dialogue: 0,0:08:12.00,0:08:14.90,Main,,0,0,0,,Zoro, Kin'emon'ları beklese miydik?Dialogue: 0,0:08:14.90,0:08:18.49,Main,,0,0,0,,Uçsuz bucaksız topraklarda değiliz sonuçta. Gidelim.Dialogue: 0,0:08:18.49,0:08:21.83,Main,,0,0,0,,Durun durun! Ben de sizinle geliyorum!Dialogue: 0,0:08:21.83,0:08:24.90,Main,,0,0,0,,Zıplamasına gerek yoktu gerçi, kapı açıkmış.Dialogue: 0,0:08:24.90,0:08:27.44,Main,,0,0,0,,Hayır, bu daha çok...Dialogue: 0,0:08:27.44,0:08:31.19,Main,,0,0,0,,Evet, açık değilmiş...Dialogue: 0,0:08:31.19,0:08:34.66,Main,,0,0,0,,Birileri yıkıp geçmiş.Dialogue: 0,0:08:39.00,0:08:40.91,Main,,0,0,0,,Öyle gibi.Dialogue: 0,0:08:40.91,0:08:43.56,Main,,0,0,0,,Bu izler de epey şüphe uyandırıcı.Dialogue: 0,0:08:43.90,0:08:47.84,Main,,0,0,0,,Hayvan izi sayılamayacak kadar genişler.Dialogue: 0,0:08:49.62,0:08:53.42,Main,,0,0,0,,Her yer fena mahvolmuş.Dialogue: 0,0:08:53.42,0:08:57.32,Main,,0,0,0,,Ve yakın zaman önce olmuş gibi. Sanji'ler iyi mi acaba?!Dialogue: 0,0:08:57.64,0:08:59.42,Main,,0,0,0,,Ne olmuş burada böyle?!Dialogue: 0,0:08:59.42,0:09:03.14,Main,,0,0,0,,Yukarıdan görünmüyordu ama tüm bunlar ne anlama geliyor?!Dialogue: 0,0:09:03.14,0:09:04.96,Main,,0,0,0,,Dikkatlice ilerleyelim!Dialogue: 0,0:09:04.96,0:09:09.65,Main,,0,0,0,,Ne?! Daha burada yaşayanlarla bile tanışmadan başka düşmanlar da mı belirdi?!Dialogue: 0,0:09:09.65,0:09:11.22,Main,,0,0,0,,H-H, Hey!Dialogue: 0,0:09:11.22,0:09:13.78,Main,,0,0,0,,D-D-D-Durun biraz millet! Durun lütfen!Dialogue: 0,0:09:13.78,0:09:16.54,Main,,0,0,0,,Bu kadar acele etmemize gerek var mı?!Dialogue: 0,0:09:19.90,0:09:21.82,Main,,0,0,0,,Yürümek epey zor.Dialogue: 0,0:09:21.82,0:09:24.14,Main,,0,0,0,,Filin derisi üzerindeyiz sonuçta.Dialogue: 0,0:09:25.24,0:09:28.68,Main,,0,0,0,,Tuhaf yerlerde çiçekler bitmiş.Dialogue: 0,0:09:28.68,0:09:30.81,Main,,0,0,0,,Bariete'ye ne oldu?Dialogue: 0,0:09:30.81,0:09:33.25,Main,,0,0,0,,Az Tüylüler kapıdan geçmişler.Dialogue: 0,0:09:30.81,0:09:33.25,Note,,0,0,0,,Lesser Minks: Az TüylülerDialogue: 0,0:09:33.25,0:09:35.63,Main,,0,0,0,,Yenildi mi acaba?!Dialogue: 0,0:09:35.63,0:09:38.36,Main,,0,0,0,,Şehirdeyim!Dialogue: 0,0:09:39.12,0:09:42.66,Main,,0,0,0,,Kimse yok! Ne biçim bir ülke bu?!Dialogue: 0,0:09:42.66,0:09:44.80,Main,,0,0,0,,Her yer paramparça olmuş!Dialogue: 0,0:09:44.80,0:09:48.36,Main,,0,0,0,,Hey! Sanji! Nami!Dialogue: 0,0:09:48.36,0:09:52.68,Main,,0,0,0,,Chopper! Brook! Momo!Dialogue: 0,0:09:52.68,0:09:55.41,Main,,0,0,0,,Bir de gaz eleman vardı! Gerçi salla onu.Dialogue: 0,0:09:56.62,0:09:59.08,Main,,0,0,0,,Burada ne olmuş?Dialogue: 0,0:09:59.08,0:10:03.76,Main,,0,0,0,,Hafiften barut ve gaz kokusu alıyorum.Dialogue: 0,0:10:03.76,0:10:05.27,Main,,0,0,0,,Bu ne böyle ya?!Dialogue: 0,0:10:05.29,0:10:09.84,Main,,0,0,0,,Bir kere olsun şöyle barışçıl bir ülkeye adım atamaz mıyız?!Dialogue: 0,0:10:10.24,0:10:13.19,Main,,0,0,0,,Ne?! Ne oldu?! Ne gördünüz!?Dialogue: 0,0:10:14.08,0:10:15.94,Main,,0,0,0,,Bana bırakın.Dialogue: 0,0:10:19.98,0:10:22.13,Main,,0,0,0,,Birden...Dialogue: 0,0:10:22.44,0:10:24.46,Main,,0,0,0,,...havaya mı zıpladı?!Dialogue: 0,0:10:26.50,0:10:28.47,Main,,0,0,0,,Bu da ne-?!Dialogue: 0,0:10:28.47,0:10:31.38,Main,,0,0,0,,Bekle! Yapma, Carrot!Dialogue: 0,0:10:35.34,0:10:37.46,Main,,0,0,0,,Unut onları-teia!Dialogue: 0,0:10:37.46,0:10:41.54,Main,,0,0,0,,Balina Ormanı'nı işgal edenler daha önemli!Dialogue: 0,0:10:43.06,0:10:45.64,Main,,0,0,0,,Hayvanlar konuşuyor!Dialogue: 0,0:10:45.64,0:10:47.62,Main,,0,0,0,,Mink Kabilesi'nden onlar!Dialogue: 0,0:10:49.06,0:10:52.66,Main,,0,0,0,,Ne?! O kıyafet...Dialogue: 0,0:10:54.44,0:10:56.60,Main,,0,0,0,,...Nami'nin değil mi?!Dialogue: 0,0:11:05.52,0:11:09.26,Main,,0,0,0,,Nasıl bir silahtı o?! Bir anlığına çarpıldım sanki!Dialogue: 0,0:11:09.26,0:11:11.50,Main,,0,0,0,,Balina Ormanı'nda işgalci mi var?!Dialogue: 0,0:11:11.50,0:11:14.04,Main,,0,0,0,,Evet, başımız büyük dertte!Dialogue: 0,0:11:14.04,0:11:17.12,Main,,0,0,0,,Muhafızlar çok kızacaklar!Dialogue: 0,0:11:17.12,0:11:18.38,Main,,0,0,0,,Hayvan mı?Dialogue: 0,0:11:18.38,0:11:19.92,Main,,0,0,0,,Yoksa insan mı?!Dialogue: 0,0:11:19.92,0:11:24.06,Main,,0,0,0,,Bana bak, o kıyafeti nereden buldun?!Dialogue: 0,0:11:24.06,0:11:26.51,Main,,0,0,0,,Nami'ye ne yaptın?!Dialogue: 0,0:11:26.51,0:11:28.38,Main,,0,0,0,,Yamyam bir kabile mi acaba?Dialogue: 0,0:11:28.38,0:11:31.02,Main,,0,0,0,,Korkunç şeyler söylemesene!Dialogue: 0,0:11:32.56,0:11:35.70,Main,,0,0,0,,Özür dilerim, yeme beni!Dialogue: 0,0:11:35.70,0:11:37.54,Main,,0,0,0,,Ne biçim bir zıplama yeteneği!Dialogue: 0,0:11:37.54,0:11:41.72,Main,,0,0,0,,Mink Kabilesi'ne özgü fiziksel bir güç mü bu?!Dialogue: 0,0:11:44.72,0:11:45.92,Main,,0,0,0,,Ne oldu?!Dialogue: 0,0:11:45.92,0:11:48.12,Main,,0,0,0,,Bir şeyler görebildin mi, Carrot?!Dialogue: 0,0:11:52.96,0:11:56.14,Main,,0,0,0,,Gördüm! Biraz geç kalmış olabiliriz!Dialogue: 0,0:11:56.14,0:12:00.11,Main,,0,0,0,,Kurau Şehri'nin öteki tarafında, Balina Ormanı'nda hareketlilik var!Dialogue: 0,0:12:00.11,0:12:03.52,Main,,0,0,0,,Tahmin etmiştim! Gidelim, Warney!Dialogue: 0,0:12:04.82,0:12:07.30,Main,,0,0,0,,- Atla, Carrot! - Peki!Dialogue: 0,0:12:08.42,0:12:11.24,Main,,0,0,0,,Siz-tia'ları götürecek zamanımız yok!Dialogue: 0,0:12:11.24,0:12:13.31,Main,,0,0,0,,Bana güvenip dediğimi yapın!Dialogue: 0,0:12:13.31,0:12:16.72,Main,,0,0,0,,Sağ tarafınızdaki Sağbut Ormanı'na gidip...Dialogue: 0,0:12:16.72,0:12:20.61,Main,,0,0,0,,...derin kara bataklıktan sola dönüp Sağböğür Ormanı'na ulaşın!Dialogue: 0,0:12:20.61,0:12:23.59,Main,,0,0,0,,Dostlarınızın bedenlerini orada bulacaksınız!Dialogue: 0,0:12:23.59,0:12:27.02,Main,,0,0,0,,Be-Beden mi?!Dialogue: 0,0:12:30.26,0:12:34.66,Main,,0,0,0,,Sağböğür Ormanı'nda bekleyin! Sizinle orada buluşacağız!Dialogue: 0,0:12:37.03,0:12:39.79,Main,,0,0,0,,Başarabilecekler mi dersin-tiara?Dialogue: 0,0:12:39.79,0:12:41.96,Main,,0,0,0,,Onlar Hasır Şapka tayfasıydı.Dialogue: 0,0:12:41.96,0:12:45.80,Main,,0,0,0,,Ne? Onlar-tiara büyük bir şok yaşayacaklar.Dialogue: 0,0:12:45.80,0:12:50.27,Main,,0,0,0,,Çok yazık ama yapabileceğimiz bir şey yok. Olan oldu.Dialogue: 0,0:12:50.27,0:12:56.59,Main,,0,0,0,,Balina Ormanı'nı işgal eden kişi muhtemelen korsan Hasır Şapkalı Luffy.Dialogue: 0,0:12:56.59,0:13:01.46,Main,,0,0,0,,Onların-tiara kaptanı olsa bile Muhafızlar merhamet göstermezler!Dialogue: 0,0:13:03.96,0:13:07.16,Main,,0,0,0,,Öldürülmüşler!Dialogue: 0,0:13:08.50,0:13:12.64,Main,,0,0,0,,Bedenlerin hâlâ duruyor oluşu en azından yenmediklerine işaret ediyor.Dialogue: 0,0:13:12.64,0:13:15.96,Main,,0,0,0,,Millet can derdinde, sen kalkmış ne diyorsun ya?!Dialogue: 0,0:13:15.96,0:13:17.55,Main,,0,0,0,,Sakin ol biraz!Dialogue: 0,0:13:17.55,0:13:21.76,Main,,0,0,0,,Bizim Kıvırcık Kaşlı da onlarlaydı, kimsenin öldürülmesine müsaade etmez.Dialogue: 0,0:13:21.76,0:13:25.83,Main,,0,0,0,,Aynen!  Öyle kolayca öleceklerini mi sanıyorsun?Dialogue: 0,0:13:25.83,0:13:29.14,Main,,0,0,0,,Moralimizi bozup onlara itaat etmemizi kolaylaştıracakları bir tuzak olmalı bu!Dialogue: 0,0:13:29.14,0:13:32.32,Main,,0,0,0,,Haklısın, inanmak mümkün değil.Dialogue: 0,0:13:32.32,0:13:33.08,Main,,0,0,0,,Tra-o-kun.Dialogue: 0,0:13:33.54,0:13:35.36,Main,,0,0,0,,Senin dostların da buradaydılar değil mi?Dialogue: 0,0:13:35.38,0:13:37.84,Main,,0,0,0,,Onlarla iletişim kurmanı sağlayacak bir şeyin var mı?Dialogue: 0,0:13:37.84,0:13:38.99,Main,,0,0,0,,Yok.Dialogue: 0,0:13:38.99,0:13:42.24,Main,,0,0,0,,Onları tekrar göreceğimi sanmıyordum.Dialogue: 0,0:13:42.68,0:13:44.94,Main,,0,0,0,,Ama sahi ya...Dialogue: 0,0:13:44.94,0:13:48.70,Main,,0,0,0,,Elimde Vivre Kartı olduğunu unutmuşum.Dialogue: 0,0:13:49.04,0:13:53.04,Main,,0,0,0,,Rotacımız Bepo'ya ait bu.Dialogue: 0,0:13:53.04,0:13:55.90,Main,,0,0,0,,Sahi ya sizin tayfada konuşan bir kutup ayısı vardı!Dialogue: 0,0:13:55.90,0:13:57.76,Main,,0,0,0,,O da mı Mink Kabilesi'nden?Dialogue: 0,0:13:57.76,0:13:59.02,Main,,0,0,0,,Evet.Dialogue: 0,0:13:59.02,0:14:02.99,Main,,0,0,0,,Memleketi burası.Dialogue: 0,0:14:03.44,0:14:08.04,Main,,0,0,0,,Ama adayı çok küçük yaşta terk ettiğinden...Dialogue: 0,0:14:08.04,0:14:11.71,Main,,0,0,0,,...buraya dair pek bir şey hatırlamıyordu.Dialogue: 0,0:14:11.71,0:14:15.91,Main,,0,0,0,,On yıldır tanıdığım biri. Ona güvenebiliriz.Dialogue: 0,0:14:15.91,0:14:19.60,Main,,0,0,0,,Güvenilir bilgi edinmek istiyorsak dümdüz gitmemiz lazım.Dialogue: 0,0:14:20.10,0:14:25.44,Main,,0,0,0,,Az evvel kuledeyken görmüştüm, o tarafta bir şehir vardı!Dialogue: 0,0:14:25.44,0:14:28.68,Main,,0,0,0,,Nasıl birileri olduklarını bilmiyoruz! Başımıza bir şey gelmesin?!Dialogue: 0,0:14:28.68,0:14:30.98,Main,,0,0,0,,Yamyam kabile orada yaşıyor olabilir.Dialogue: 0,0:14:33.02,0:14:36.33,Main,,0,0,0,,Hiç tanımadığımız bir hayvanın sözüne güvenmekten iyidir.Dialogue: 0,0:14:36.33,0:14:38.48,Main,,0,0,0,,Gidelim hadi.Dialogue: 0,0:14:43.04,0:14:45.83,Captions,,0,0,170,,Balina OrmanıDialogue: 0,0:14:45.83,0:14:48.52,Main,,0,0,0,,Gomu Gomu no...Dialogue: 0,0:14:48.52,0:14:51.80,Main,,0,0,0,,Moo Golova!Dialogue: 0,0:14:48.52,0:14:51.80,Attack,,0,0,0,,Moo KafaDialogue: 0,0:14:51.80,0:14:54.24,Main,,0,0,0,,Kane!Dialogue: 0,0:14:51.80,0:14:54.24,Attack,,0,0,0,,ÇanDialogue: 0,0:14:59.86,0:15:03.08,Main,,0,0,0,,Elektro neden etki etmiyor-gara?!Dialogue: 0,0:15:03.95,0:15:06.98,Main,,0,0,0,,Yeter! Durun!Dialogue: 0,0:15:06.98,0:15:09.06,Main,,0,0,0,,Onu tanıyorum!Dialogue: 0,0:15:09.06,0:15:11.62,Main,,0,0,0,,Onu tanıman işgalci olduğu gerçeğini değiştirmez!Dialogue: 0,0:15:11.62,0:15:14.83,Main,,0,0,0,,Seni güç kullanarak durdurmamız gerekecek anlaşılan!Dialogue: 0,0:15:14.83,0:15:17.66,Main,,0,0,0,,Karışmayın!Dialogue: 0,0:15:18.58,0:15:21.32,Main,,0,0,0,,Jean Bart!Dialogue: 0,0:15:21.32,0:15:23.68,Main,,0,0,0,,Lanet olsun,  bizim üstesinden geleceğimiz şey değil bu!Dialogue: 0,0:15:23.68,0:15:24.96,Main,,0,0,0,,Ne güç ama!Dialogue: 0,0:15:25.62,0:15:28.10,Main,,0,0,0,,Yeter bu kadar, Muhafızlar!Dialogue: 0,0:15:28.10,0:15:30.10,Main,,0,0,0,,Parıldayan bir şey!Dialogue: 0,0:15:33.64,0:15:35.38,Main,,0,0,0,,Muz!Dialogue: 0,0:15:45.96,0:15:49.84,Main,,0,0,0,,Yaşasın muz!Dialogue: 0,0:15:50.18,0:15:54.56,Captions,,0,0,240,,Balina Ormanı Muhafızı (Boğa Mink) RoddyDialogue: 0,0:15:55.18,0:15:58.56,Captions,,0,0,240,,Balina Ormanı Muhafızı (Goril Mink)  BB (Blackback)Dialogue: 0,0:16:01.13,0:16:03.80,Main,,0,0,0,,Böyle sakinleştiriliyorlar demek...Dialogue: 0,0:16:10.18,0:16:11.98,Main,,0,0,0,,Köpek mi?Dialogue: 0,0:16:12.20,0:16:15.58,Captions,,0,0,240,,Battlebeast Kabilesi (Köpek Mink) WandaDialogue: 0,0:16:12.90,0:16:15.95,Main,,0,0,3,,Sen-tia, Hasır Şapkalı Luffy'sin değil mi?Dialogue: 0,0:16:12.90,0:16:15.95,Note,,0,0,3,,Battlebeast: Savaş CanavarıDialogue: 0,0:16:15.95,0:16:18.16,Main,,0,0,0,,Adım Wanda.Dialogue: 0,0:16:18.44,0:16:21.87,Captions,,0,0,240,,Battlebeast Kabilesi (Tavşan Mink) CarrotDialogue: 0,0:16:18.72,0:16:21.22,Main,,0,0,3,,O da Carrot.Dialogue: 0,0:16:21.86,0:16:25.98,Main,,0,0,0,,Sana bir zararımız dokunmayacak, direnmeyi bırak.Dialogue: 0,0:16:25.98,0:16:28.79,Main,,0,0,0,,Ülkede tuhaf yaratıktan geçilmiyor.Dialogue: 0,0:16:28.79,0:16:31.22,Main,,0,0,0,,Etrafta bir ton Chopper varmış gibi sanki.Dialogue: 0,0:16:31.70,0:16:33.78,Main,,0,0,0,,Onların nesi var böyle?!Dialogue: 0,0:16:33.78,0:16:36.88,Main,,0,0,0,,Durduk yere saldırdılar!Dialogue: 0,0:16:36.88,0:16:40.83,Main,,0,0,0,,Girmemen gereken ormana girdiğin için sana-tia saldırdılar.Dialogue: 0,0:16:40.83,0:16:42.85,Main,,0,0,0,,Ne yapıyorsun?!Dialogue: 0,0:16:42.85,0:16:44.35,Main,,0,0,0,,Muhafızlar!Dialogue: 0,0:16:44.35,0:16:46.53,Main,,0,0,0,,Onu derhal buradan çıkartacağız!Dialogue: 0,0:16:46.53,0:16:48.44,Main,,0,0,0,,Bağışlayın!Dialogue: 0,0:16:53.22,0:16:55.40,Main,,0,0,0,,Wanda öyle diyorsa madem...Dialogue: 0,0:16:55.40,0:16:56.80,Main,,0,0,0,,Gidiyoruz Roddy!Dialogue: 0,0:17:00.56,0:17:02.33,Main,,0,0,0,,BB!Dialogue: 0,0:17:03.04,0:17:05.07,Main,,0,0,0,,Pedro!Dialogue: 0,0:17:05.60,0:17:08.08,Main,,0,0,0,,Hepiniz geri çekilin!Dialogue: 0,0:17:12.28,0:17:14.14,Main,,0,0,0,,Etrafım sarılmış meğer!Dialogue: 0,0:17:14.14,0:17:18.20,Main,,0,0,0,,Ay ışığında olmadığına şükret.Dialogue: 0,0:17:22.55,0:17:27.22,Main,,0,0,0,,Hasır Şapka, bizi unuttun mu yoksa?!Dialogue: 0,0:17:27.22,0:17:30.26,Main,,0,0,0,,En Büyükler Savaşı'ndan sonra sana biz bakmıştık!Dialogue: 0,0:17:30.26,0:17:31.96,Main,,0,0,0,,Hiç beklemezdim!Dialogue: 0,0:17:31.96,0:17:37.22,Main,,0,0,0,,Sen Tra-o'nun tayfadaki konuşan ayısın!Dialogue: 0,0:17:37.22,0:17:38.18,Main,,0,0,0,,Tra-o mu?!Dialogue: 0,0:17:38.18,0:17:42.10,Main,,0,0,3,,Hayır be, Trafalgar Law için çalışıyoruz biz!Dialogue: 0,0:17:38.65,0:17:43.80,Captions,,0,0,240,,Kalp Korsanları Rotacısı Muhafız Yardımcısı BepoDialogue: 0,0:17:42.10,0:17:44.16,Main,,0,0,3,,Kalp Korsanları!Dialogue: 0,0:17:44.16,0:17:45.92,Main,,0,0,0,,Ben de öyle dedim ya zaten!Dialogue: 0,0:17:45.92,0:17:47.18,Main,,0,0,0,,Demedin!Dialogue: 0,0:17:47.18,0:17:50.14,Main,,0,0,0,,Gazeteden haberlerinizi aldık!Dialogue: 0,0:17:50.14,0:17:52.00,Main,,0,0,0,,Şaşılacak tonla şey yaşandı!Dialogue: 0,0:17:52.00,0:17:53.92,Main,,0,0,0,,İttifakız artık değil mi?Dialogue: 0,0:17:53.92,0:17:55.42,Main,,0,0,0,,Kaptanımız da burada mı?Dialogue: 0,0:17:55.42,0:17:57.44,Main,,0,0,0,,Evet, Tra-o da bizimle!Dialogue: 0,0:17:57.44,0:18:00.64,Main,,0,0,0,,Gene tutturamadın! Kimmiş o Tra-o?!Dialogue: 0,0:18:01.36,0:18:03.22,Main,,0,0,0,,Tra-o Law işte.Dialogue: 0,0:18:03.22,0:18:05.54,Main,,0,0,0,,Hadi ya? Hiç bilmiyordum.Dialogue: 0,0:18:05.54,0:18:08.98,Main,,0,0,0,,Kaptanımız da geldi öyle mi? Yaşasın!Dialogue: 0,0:18:08.98,0:18:12.30,Main,,0,0,0,,Kaptan, seni görmek için can atıyorum!Dialogue: 0,0:18:13.20,0:18:18.15,Captions,,0,0,180,,Filin Sırtında Tam Merkezdeki Kurau ŞehriDialogue: 0,0:18:18.77,0:18:22.28,Main,,0,0,0,,Saldırıya uğradığına şüphe yok.Dialogue: 0,0:18:22.28,0:18:29.28,Main,,0,0,0,,Birkaç yüz bin kişiyi barındırabilecek kapasitedeki bu şehirde kimseler kalmamış.Dialogue: 0,0:18:30.62,0:18:34.22,Main,,0,0,0,,Böyle ortalık yerde duramayız!Dialogue: 0,0:18:34.22,0:18:36.86,Main,,0,0,0,,Düşmanlar hâlâ yakınlarda olabilir!Dialogue: 0,0:18:40.02,0:18:42.94,Main,,0,0,0,,İşkence aleti...Dialogue: 0,0:18:46.08,0:18:50.42,Main,,0,0,0,,Düşmanların insan olup olmadığını bile bilemiyoruz.Dialogue: 0,0:18:50.42,0:18:53.46,Main,,0,0,0,,Çok fazla pençe izi var.Dialogue: 0,0:18:53.46,0:18:56.25,Main,,0,0,0,,Evet ya, ne bunlar böyle?!Dialogue: 0,0:18:56.25,0:18:59.12,Main,,0,0,0,,Hey, şuna bakın.Dialogue: 0,0:19:03.92,0:19:06.79,Main,,0,0,0,,Devasa bir ayak izi bu.Dialogue: 0,0:19:06.79,0:19:09.00,Main,,0,0,0,,File falan mı ait?Dialogue: 0,0:19:09.00,0:19:13.70,Main,,0,0,0,,Mink Kabilesi şehrine hayvanlar, canavarlar falan mı saldırdı acaba?Dialogue: 0,0:19:13.70,0:19:18.68,Main,,0,0,0,,Ama pençe izlerine bakılırsa dostlar arasında bir anlaşmazlık da olabilir.Dialogue: 0,0:19:18.68,0:19:20.80,Main,,0,0,0,,Kesin olan şey şu ki...Dialogue: 0,0:19:21.74,0:19:28.76,Main,,0,0,0,,...bu ülke birkaç hafta önce aniden yerlebir edilmiş.Dialogue: 0,0:19:30.94,0:19:35.47,Main,,0,0,0,,Öy-Öyleyse Sanji'ler de mi...Dialogue: 0,0:19:35.47,0:19:38.89,Main,,0,0,0,,...bu işe karıştılar diyorsun?!Dialogue: 0,0:19:40.60,0:19:42.16,Main,,0,0,0,,Yerlebir edildi öyle mi?Dialogue: 0,0:19:42.16,0:19:45.30,Main,,0,0,0,,Demek o yüzden kimse yoktu!Dialogue: 0,0:19:45.30,0:19:51.07,Main,,0,0,0,,Asırlar yaşındaki bu ülkenin adı Mokomo Düklüğü.Dialogue: 0,0:19:51.07,0:19:57.44,Main,,0,0,0,,Daha iki hafta öncesini düşündüğümde insanların mutlu yüzlerini hatırlayabiliyorum.Dialogue: 0,0:20:04.06,0:20:07.76,Main,,0,0,0,,Bu ülkeyi mahveden kişinin adı...Dialogue: 0,0:20:08.68,0:20:09.78,Main,,0,0,0,,...Jack!Dialogue: 0,0:20:13.66,0:20:15.06,Main,,0,0,0,,Bu da ne?!Dialogue: 0,0:20:17.24,0:20:18.72,Main,,0,0,0,,Ne oluyor?!Dialogue: 0,0:20:18.72,0:20:21.00,Main,,0,0,0,,Patlama-Yağmur geliyor!Dialogue: 0,0:20:21.00,0:20:22.70,Main,,0,0,0,,Ağaca tırmanın!Dialogue: 0,0:20:22.70,0:20:25.72,Main,,0,0,0,,Warney'e atla! Seni Sağböğür'e götüreceğiz!Dialogue: 0,0:20:26.02,0:20:27.50,Main,,0,0,0,,Dostların orada!Dialogue: 0,0:20:27.80,0:20:31.11,Main,,0,0,0,,Çok sevindim! Sanjiler orada değil mi?!Dialogue: 0,0:20:33.08,0:20:34.14,Main,,0,0,0,,Ne oldu?!Dialogue: 0,0:20:34.23,0:20:37.16,Credits,,0,0,0,,Editing: Galaxy 9000 Timing: Datenshi QC: Mr Luffy, Sewil Soundtracking: Halee TC/Infoboxes: Datenshi