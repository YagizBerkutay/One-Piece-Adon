Dialogue: 0,0:01:41.81,0:01:44.10,Title,,0,0,250,,{\fad(800,800)}Anlaşıldı
Dialogue: 0,0:01:44.20,0:01:45.66,Main,,0,0,0,,Shanks'ı diyorum!
Dialogue: 0,0:01:45.66,0:01:48.18,Main,,0,0,0,,Yoksa tanıyor musun onu Nekomamushi?!
Dialogue: 0,0:01:48.18,0:01:52.17,Main,,0,0,0,,Tanımam mı! \NKızıl Saçlı Shanks'dan bahsediyorsun değil mi?
Dialogue: 0,0:01:52.17,0:01:57.21,Main,,0,0,0,,Tabii ya! \NHasır şapkanın tanıdık gelmesine şaşırmamalı!
Dialogue: 0,0:01:58.50,0:02:00.16,Main,,0,0,0,,Öyle ha!
Dialogue: 0,0:02:01.15,0:02:05.10,Main,,0,0,0,,Inuarashi de öyle dedi!\NHepiniz Shanks'ı tanıyor musunuz?!
Dialogue: 0,0:02:05.50,0:02:10.27,Main,,0,0,0,,Kedi de ben de bir zamanlar\NRoger'ın gemisindeydik sonuçta.
Dialogue: 0,0:02:14.00,0:02:15.03,Main,,0,0,0,,Oha!?
Dialogue: 0,0:02:15.03,0:02:17.86,Main,,0,0,0,,Siz de mi Korsanlar Kralı'nın tayfasındaydınız?!
Dialogue: 0,0:02:18.55,0:02:22.72,Main,,0,0,0,,Tayfa ha...\NSanırım öyle de denebilir...
Dialogue: 0,0:02:22.72,0:02:27.37,Main,,0,0,0,,...ama aslen Oden-sama'nın hizmetkarları\Nolarak pek çok gemiye binmişizdir.
Dialogue: 0,0:02:27.37,0:02:30.83,Main,,0,0,0,,Beyazsakal'ın Moby Dick'inde\Nseyahat ederken de...
Dialogue: 0,0:02:32.99,0:02:37.82,Main,,0,0,0,,...oradan Oden-sama Roger tarafından\Nyanına alındığında da hep onun yanındaydık.
Dialogue: 0,0:02:37.82,0:02:40.83,Main,,0,0,0,,Du-Durun biraz! Beyazsakal mı?!
Dialogue: 0,0:02:43.87,0:02:47.85,Main,,0,0,0,,Evet. O zamanlar biz de...
Dialogue: 0,0:02:47.85,0:02:53.23,Main,,0,0,0,,...Shanks ve Buggy gibi küçücük çıraklardık.
Dialogue: 0,0:02:53.23,0:02:55.88,Main,,0,0,0,,Bekle biraz, bekle!
Dialogue: 0,0:02:55.88,0:02:59.07,Main,,0,0,0,,Kafam allak bullak oldu.
Dialogue: 0,0:02:59.47,0:03:03.89,Main,,0,0,0,,Ama biz ikimiz onlarla birlikte\NRaftel'e gitmedik.
Dialogue: 0,0:03:03.89,0:03:06.54,Main,,0,0,0,,Durun biraz dedim yahu!
Dialogue: 0,0:03:08.50,0:03:11.84,Main,,0,0,0,,Öncelikle Beyazsakal'ın gemisinde...
Dialogue: 0,0:03:11.84,0:03:15.87,Main,,0,0,0,,...Oden, köpek ve kedi vardı.
Dialogue: 0,0:03:15.87,0:03:21.51,Main,,0,0,0,,Sonra Oden Roger tarafından yanına alındı\Nve üçünüz Roger'ın gemisine geçtiniz.
Dialogue: 0,0:03:21.51,0:03:27.39,Main,,0,0,0,,Evet, hâlâ hatırlıyorum!\NO zamanlar ne eğlenirdik ha!
Dialogue: 0,0:03:32.41,0:03:37.06,Main,,0,0,0,,Hayatımda daha önce hiç görmediğim\Ntürler, manzaralar, iklimler!
Dialogue: 0,0:03:37.06,0:03:40.08,Main,,0,0,0,,Gökteki bulut denizi!
Dialogue: 0,0:03:44.11,0:03:48.07,Main,,0,0,0,,Yeraltında süzülen ada! Gün ışığı!
Dialogue: 0,0:03:48.07,0:03:52.11,Main,,0,0,0,,Her gün büyük bir heyecanla geçerdi!
Dialogue: 0,0:03:52.11,0:03:55.14,Main,,0,0,0,,Ne güzel macera dolu günlerdi!
Dialogue: 0,0:04:00.54,0:04:03.61,Main,,0,0,0,,Daha beş dakika öncesine kadar\Nbirbirinizi öldürmeye çalışıyordunuz.
Dialogue: 0,0:04:03.61,0:04:08.06,Main,,0,0,0,,O zaman siz de mi\NBayazsakal'ın gemisindeydiniz?
Dialogue: 0,0:04:08.06,0:04:10.85,Main,,0,0,0,,Hayır, biz o süreç boyunca\Nhep Wano Krallığında'ydık.
Dialogue: 0,0:04:10.85,0:04:14.73,Main,,0,0,0,,Hatta aksine Oden-sama'nın\Nkorsan gemisine binmesini...
Dialogue: 0,0:04:15.09,0:04:17.11,Main,,0,0,0,,...tüm gücümüzle engellemeye çalışmıştık!
Dialogue: 0,0:04:17.61,0:04:22.44,Main,,0,0,0,,Dünyaya kapalı ülkelerde\Nülkeyi terk etmek bile büyük suçtur.
Dialogue: 0,0:04:22.44,0:04:26.63,Main,,0,0,0,,Öte yandan Oden-sama\Nülkenin kanunları konusunda...
Dialogue: 0,0:04:26.63,0:04:30.41,Main,,0,0,0,,...şüpheleri olan aykırı biriydi.
Dialogue: 0,0:04:30.41,0:04:34.61,Main,,0,0,0,,Beyazsakal ve Roger'la da...
Dialogue: 0,0:04:34.61,0:04:38.64,Main,,0,0,0,,...onlar Wano Krallığı'na\Nayak bastıklarında tanıştık.
Dialogue: 0,0:04:38.64,0:04:42.30,Main,,0,0,0,,Başkalarına karşı vefalıydılar yani\Nonların kötü insanlar olduğunu düşünmedik.
Dialogue: 0,0:04:42.30,0:04:48.69,Main,,0,0,0,,Ama daimyonun hizmetkarlarıyla birlikte \Nkorsan gemisine bindiğini daha önce hiç duymamıştım.
Dialogue: 0,0:04:50.69,0:04:55.19,Main,,0,0,0,,Neyse işte, sonuçta Shanks'ı\Ntanıyorsunuz değil mi?! Rayleigh'i de?
Dialogue: 0,0:04:55.19,0:04:57.38,Main,,0,0,0,,Elbette!
Dialogue: 0,0:04:57.38,0:05:00.30,Main,,0,0,0,,Roger'ın gemisine binmişseniz...
Dialogue: 0,0:05:00.30,0:05:05.90,Main,,0,0,0,,...bindiğiniz gemi ustam Tom-san'ın\Nyaptığı Oro Jackson olmalı!
Dialogue: 0,0:05:07.32,0:05:10.78,Main,,0,0,0,,Gemi yapımcısı Tom'un öğrencisisin öyle mi?!
Dialogue: 0,0:05:10.78,0:05:15.77,Main,,0,0,0,,Şey, ben de bir şey sorabilir miyim?\NEminim geminin doktoru Crocus'u...
Dialogue: 0,0:05:15.77,0:05:16.82,Main,,0,0,0,,Bekle Brook.
Dialogue: 0,0:05:16.82,0:05:21.82,Main,,0,0,0,,Böldüğüm için özür dilerim ama\Nonaylatmak istediğim bir şey var.
Dialogue: 0,0:05:30.76,0:05:36.81,Main,,0,0,0,,Dört Yol Poneglifi'nin Raftel'in yerini göstereceğini söylemiştiniz değil mi?
Dialogue: 0,0:05:36.81,0:05:40.52,Main,,0,0,0,,Rota konusu çok kafamı kurcalıyor.
Dialogue: 0,0:05:40.52,0:05:41.80,Main,,0,0,0,,Şuna bakın.
Dialogue: 0,0:05:43.76,0:05:45.57,Main,,0,0,0,,Seyir Pusulası'nın iğneleri!
Dialogue: 0,0:05:45.57,0:05:51.37,Main,,0,0,0,,Normalde bu üç iğneye bakarak bir sonraki\Ngideceğimiz yeri seçiyorduk ama...
Dialogue: 0,0:05:51.37,0:05:54.62,Main,,0,0,0,,...şu anda o yönde gitmiyoruz,\Nsorun olur mu bu?
Dialogue: 0,0:05:58.34,0:06:04.00,Main,,0,0,0,,Tra-o-kun'la karşılaştıktan sonra Vivre Kartı\Nsayesinde şans eseri buraya geldik...
Dialogue: 0,0:06:04.00,0:06:09.97,Main,,0,0,0,,...ve yine şans eseri Raftel'in yeri hakkında\Nipucu veren Yol Poneglifi'ni öğrendik.
Dialogue: 0,0:06:09.97,0:06:14.14,Main,,0,0,0,,Fakat İkiz Tepeler'deki Crocus-san'a göre...
Dialogue: 0,0:06:14.14,0:06:19.19,Main,,0,0,0,,...iğneleri takip edince sonunda\Nher rotanın bir noktada birleşmesi lazım.
Dialogue: 0,0:06:19.19,0:06:25.32,Main,,0,0,0,,Şimdiye kadar Raftel'in\No yer olduğunu düşünmüştüm hep.
Dialogue: 0,0:06:26.32,0:06:31.35,Main,,0,0,0,,Crocus ha! Görmeyeli epey oldu!
Dialogue: 0,0:06:31.35,0:06:33.39,Main,,0,0,0,,Hali hatrı yerinde mi?!
Dialogue: 0,0:06:33.39,0:06:37.04,Main,,0,0,0,,Yerinde yerinde!\NGerçi göreli iki yıl oldu ama!
Dialogue: 0,0:06:39.43,0:06:42.35,Main,,0,0,0,,Laboon'un yanındaki amca değil mi?
Dialogue: 0,0:06:42.35,0:06:48.54,Main,,0,0,0,,Gemi doktoru Crocus! O zamanlar\Nfalanca bir korsan grubunu arıyordu.
Dialogue: 0,0:06:48.54,0:06:51.97,Main,,0,0,0,,Benim tayfa o! Geriye kimse kalmadı!
Dialogue: 0,0:06:51.97,0:06:53.52,Main,,0,0,0,,Ne?!
Dialogue: 0,0:06:53.52,0:06:57.06,Main,,0,0,0,,Az kenarda durun!\NÖnemli bir şey konuşuyoruz şurada!
Dialogue: 0,0:06:57.06,0:07:00.31,Main,,0,0,0,,Ne demek istediğini anladım.
Dialogue: 0,0:07:00.31,0:07:04.56,Main,,0,0,0,,İğnelerin seni nereye götüreceğini\Nmerak ediyorsan gidip kendin gör.
Dialogue: 0,0:07:04.56,0:07:08.20,Main,,0,0,0,,Üç iğnenin de sonunda aynı noktaya çıkan...
Dialogue: 0,0:07:08.20,0:07:12.03,Main,,0,0,0,,...üç farklı rotayı gösterdiği kesin.
Dialogue: 0,0:07:17.52,0:07:21.86,Main,,0,0,0,,Fakat siz-garalar\No noktanın çok ötesine uzanan...
Dialogue: 0,0:07:21.86,0:07:25.19,Main,,0,0,0,,...bir yolculuğa çıkmışsınız bile.
Dialogue: 0,0:07:26.77,0:07:28.30,Main,,0,0,0,,Nasıl yani?
Dialogue: 0,0:07:29.65,0:07:35.56,Main,,0,0,0,,Normalde Poneglifleri ve kadim dilin gerçeğini...
Dialogue: 0,0:07:36.55,0:07:40.85,Main,,0,0,0,,...ilk kez rotanın sonuna\Nvardığınızda öğrenmeniz lazımdı.
Dialogue: 0,0:07:43.53,0:07:46.56,Main,,0,0,0,,Pek tabii bunları yaratmış uygarlığı ve...
Dialogue: 0,0:07:46.56,0:07:51.55,Main,,0,0,0,,...saklı son ada Raftel'in varlığını da öyle.
Dialogue: 0,0:07:56.43,0:08:01.59,Main,,0,0,0,,Roger oraya vardığında neredeyse her şeye\Nen başından başlamak zorunda kaldı.
Dialogue: 0,0:08:05.07,0:08:10.70,Main,,0,0,0,,Crocus da Korsanlar Kralı tayfasındaydı.\NHer şeyi bilenlerden biri.
Dialogue: 0,0:08:11.31,0:08:14.72,Main,,0,0,0,,Sizden nefret etmemişse\Nyalan söyleyeceğini sanmıyorum.
Dialogue: 0,0:08:23.92,0:08:25.89,Main,,0,0,0,,Anladım!
Dialogue: 0,0:08:27.91,0:08:33.96,Main,,0,0,0,,Endişelencek bir şey yokmuş.\NRotadan çıkmıyormuşuz.
Dialogue: 0,0:08:33.96,0:08:38.53,Main,,0,0,0,,Henüz bilmediğimiz gerçekler yüzünden\Nkafam karışmış sadece.
Dialogue: 0,0:08:38.53,0:08:42.12,Main,,0,0,0,,İğneler yalan söylemiyormuş!
Dialogue: 0,0:08:42.12,0:08:46.75,Main,,0,0,0,,Rotacı sen misin?\NEpey güvenilir biri gibi duruyorsun.
Dialogue: 0,0:08:47.40,0:08:51.21,Main,,0,0,0,,Endişelenme! Doğru yoldasınız.
Dialogue: 0,0:08:51.21,0:08:53.39,Main,,0,0,0,,İlerlemeye devam edin!
Dialogue: 0,0:08:53.39,0:08:54.62,Main,,0,0,0,,Peki!
Dialogue: 0,0:08:54.62,0:08:57.65,Main,,0,0,0,,Neden bahsediyorsunuz bilmiyorum ama...
Dialogue: 0,0:08:57.65,0:09:01.60,Main,,0,0,0,,...rotacımız harika değil mi?!
Dialogue: 0,0:09:01.60,0:09:05.59,Main,,0,0,0,,Harika ha? Evet, öyleyimdir!
Dialogue: 0,0:09:05.59,0:09:08.64,Main,,0,0,0,,Gelecek Korsanlar Kralı'nın rotacısı!
Dialogue: 0,0:09:08.64,0:09:10.52,Main,,0,0,0,,Harika!
Dialogue: 0,0:09:12.53,0:09:14.64,Main,,0,0,0,,Vurmasana, acıyor!
Dialogue: 0,0:09:17.60,0:09:19.59,Main,,0,0,0,,Luffy...
Dialogue: 0,0:09:19.59,0:09:23.33,Main,,0,0,0,,Siz-garalar epey eğleniyor gibisiniz.
Dialogue: 0,0:09:28.37,0:09:32.70,Main,,0,0,0,,Yalnız o kadar çok efsaneyle bağlantılısınız ki...
Dialogue: 0,0:09:32.70,0:09:35.72,Main,,0,0,0,,...aynı Rayleigh'le tanıştığımda\Nolduğum gibi aklım uçtu resmen.
Dialogue: 0,0:09:35.72,0:09:38.70,Main,,0,0,0,,Rogerlar'la ben de tanıştım ama...
Dialogue: 0,0:09:38.70,0:09:42.30,Main,,0,0,0,,...o zamanlar çok küçük\Nolduğumdan tam hatırlamıyorum.
Dialogue: 0,0:09:42.30,0:09:44.30,Main,,0,0,0,,Tam hatırlamıyorsun demek...
Dialogue: 0,0:09:44.30,0:09:48.16,Main,,0,0,0,,Sus yalancı! \NRoger öleli 20 yıldan fazla oldu!
Dialogue: 0,0:09:48.16,0:09:49.65,Main,,0,0,0,,Kimden bahsediyorsun sen?!
Dialogue: 0,0:09:51.89,0:09:55.15,Main,,0,0,0,,Oden-sama'nın yolculuğunda çok şey yaşandı.
Dialogue: 0,0:09:55.15,0:09:57.86,Main,,0,0,0,,Bir ara size anlatırım.
Dialogue: 0,0:09:58.56,0:10:04.34,Main,,0,0,0,,Öyleyse şimdi Kaido'yla savaşa başlamadan\Nönce yapmamız gereken şeyler var.
Dialogue: 0,0:10:04.34,0:10:07.11,Main,,0,0,0,,Hazırlanmamız lazım.
Dialogue: 0,0:10:07.11,0:10:10.17,Main,,0,0,0,,Dediğim gibi, Wano Krallığında savaşacak...
Dialogue: 0,0:10:10.17,0:10:13.92,Main,,0,0,0,,...samuraylar toplamaya çalışıyoruz.
Dialogue: 0,0:10:13.92,0:10:18.18,Main,,0,0,0,,O sırada bizim de\Nbuluşmamız gereken birisi var!
Dialogue: 0,0:10:18.18,0:10:21.70,Main,,0,0,0,,Ne kadar çok destek o kadar iyi.
Dialogue: 0,0:10:21.70,0:10:22.49,Main,,0,0,0,,Kimden bahsediyorsunuz?
Dialogue: 0,0:10:23.57,0:10:27.39,Main,,0,0,0,,Eski Beyazsakal Korsanları\NBirinci Tümen Komutanı...
Dialogue: 0,0:10:34.80,0:10:38.10,Main,,0,0,0,,...Anka Kuşu Marco!
Dialogue: 0,0:10:43.57,0:10:44.61,Main,,0,0,0,,Marco mu?
Dialogue: 0,0:10:44.61,0:10:48.12,Main,,0,0,0,,- Bu ismi burada duymayı beklemiyordum.\N- Marco... Marco...
Dialogue: 0,0:10:48.12,0:10:52.79,Main,,0,0,0,,Onunla dostsunuz demek!\Nİşte bu harika oldu!
Dialogue: 0,0:10:53.86,0:10:58.38,Main,,0,0,0,,Bize destek olabilirse inanılmaz\Nbir güç kazanmış oluruz!
Dialogue: 0,0:10:59.27,0:11:04.22,Main,,0,0,0,,Ama durun biraz.\NBir yıl önceki olayda onlar...
Dialogue: 0,0:11:04.62,0:11:06.83,Main,,0,0,0,,Pek umutlanmamak lazım.
Dialogue: 0,0:11:06.83,0:11:09.52,Main,,0,0,0,,Onu bulsak bile\Nbize katılma ihtimali çok düşük.
Dialogue: 0,0:11:09.52,0:11:13.85,Main,,0,0,0,,Marco... Marco...\NBir yerlerden duyduğuma eminim ama...
Dialogue: 0,0:11:13.85,0:11:18.84,Main,,0,0,0,,Marineford'daki Büyük Savaş'da\Nonunla karşılaşmış olman lazım!
Dialogue: 0,0:11:18.84,0:11:20.33,Main,,0,0,0,,Marco ha... Kimdi ya?!
Dialogue: 0,0:11:20.33,0:11:24.58,Main,,0,0,0,,Çok nadir bir\Nşeytan meyvesi yemiş diyorlar!
Dialogue: 0,0:11:24.58,0:11:26.62,Main,,0,0,0,,Ne? Nadir mi?
Dialogue: 0,0:11:27.56,0:11:29.79,Main,,0,0,0,,Ananas gibi kafası var.
Dialogue: 0,0:11:32.71,0:11:33.78,Main,,0,0,0,,Ha onu mu diyorsunuz!
Dialogue: 0,0:11:33.78,0:11:37.90,Main,,0,0,0,,Evet, Marco liderliğindeki\Nkalan Beyazsakal Korsanları ve...
Dialogue: 0,0:11:37.90,0:11:40.67,Main,,0,0,0,,...Karasakal Korsanları arasındaki savaş!
Dialogue: 0,0:11:41.80,0:11:44.78,Main,,0,0,0,,Sözde İntikam Savaşı üzerinden bir yıl geçti...
Dialogue: 0,0:11:44.78,0:11:49.39,Main,,0,0,0,,...ama komutanlara ne olduğu\Nhenüz kulağımıza çalınmadı.
Dialogue: 0,0:11:49.79,0:11:55.75,Main,,0,0,0,,Eğer hâlâ hayattaysa Marco'nun\Nnerede olabileceğini biliyordum.
Dialogue: 0,0:11:55.75,0:11:59.23,Main,,0,0,0,,Durun biraz!\NKarasakal'la mı savaştılar?!
Dialogue: 0,0:12:00.54,0:12:01.20,Main,,0,0,0,,Evet.
Dialogue: 0,0:12:03.35,0:12:07.62,Main,,0,0,0,,İki tarafın da ek desteğe sahip olduğu\Noldukça büyük çaplı bir savaştı.
Dialogue: 0,0:12:18.70,0:12:22.72,Main,,0,0,0,,Ve Marcolar ezici bir mağlubiyet yaşadılar.
Dialogue: 0,0:12:23.46,0:12:29.06,Main,,0,0,0,,Karasakal bu savaştan sonra\NYonko olarak anılmaya başlandı.
Dialogue: 0,0:12:29.06,0:12:32.60,Main,,0,0,0,,Öyle oldu demek.\NLanet olası Karasakal!
Dialogue: 0,0:12:32.60,0:12:35.66,Main,,0,0,0,,Sağır sultan bile bu olayı duydu!
Dialogue: 0,0:12:35.66,0:12:37.98,Main,,0,0,0,,Seni hangi mağaradaydın?
Dialogue: 0,0:12:37.98,0:12:40.24,Main,,0,0,0,,Jinbe anlatmıştı.
Dialogue: 0,0:12:40.96,0:12:42.74,Main,,0,0,0,,Büyük Savaş'da...
Dialogue: 0,0:12:42.74,0:12:48.27,Main,,0,0,0,,...ben bayıldıktan sonra hayatımı\NBeyazsakal Korsanları kurtarmış.
Dialogue: 0,0:12:55.75,0:12:59.50,Flashbacks,,0,0,0,,Savaş daha bitmedi ey!
Dialogue: 0,0:13:00.45,0:13:03.88,Flashbacks,,0,0,0,,Ace'in kardeşini götür buradan Jinbe!
Dialogue: 0,0:13:03.88,0:13:07.44,Main,,0,0,0,,Onunla gene görüşüp\Nteşekkür etmek isterdim.
Dialogue: 0,0:13:07.44,0:13:14.43,Main,,0,0,0,,Özetle Kin'emon gibi bizim de \Nhazırlanmak için zamana ihtiyacımız olacak.
Dialogue: 0,0:13:14.43,0:13:17.94,Main,,0,0,0,,Peki, tamam öyleyse!\NŞimdilik ayrılalım!
Dialogue: 0,0:13:17.94,0:13:23.63,Main,,0,0,0,,Biz ittifak güçler toplayıp\NWano Krallığı'nda bir plan düşüneceğiz.
Dialogue: 0,0:13:23.63,0:13:25.63,Main,,0,0,0,,Dönmeniz sıkıntı olmasın?
Dialogue: 0,0:13:25.63,0:13:27.70,Main,,0,0,0,,Şogunun peşinizde olduğunu sanıyordum.
Dialogue: 0,0:13:28.80,0:13:32.91,Main,,0,0,0,,Kendimizden çok ülkedeki dostlarımız\Nkonusunda da endişeleniyoruz.
Dialogue: 0,0:13:32.91,0:13:37.47,Main,,0,0,0,,Bizim denizaltıya binerseniz\Nyolculuk sırasında güvende olursunuz.
Dialogue: 0,0:13:37.47,0:13:39.08,Main,,0,0,0,,Bir de...
Dialogue: 0,0:13:40.89,0:13:44.84,Main,,0,0,0,,...adada saklanacak bir yerler biliyorsanız\Nbir şekilde üstesinden gelirsiniz.
Dialogue: 0,0:13:44.84,0:13:48.92,Main,,0,0,0,,Ben adamlarımla birlikte\NMarco'yu aramaya gideceğim.
Dialogue: 0,0:13:48.92,0:13:51.97,Main,,0,0,0,,Madem Kin'emonlar\Nbizden önce gidecekler...
Dialogue: 0,0:13:52.07,0:13:55.00,Main,,0,0,0,,...hepimizin Wano Krallığı'nda\Nbuluşması mantıklı olur.
Dialogue: 0,0:13:55.20,0:13:58.10,Main,,0,0,0,,Kin'emon'un Vivre Kartı'nı yapalım.
Dialogue: 0,0:13:58.10,0:14:00.08,Main,,0,0,0,,Anlaşıldı.
Dialogue: 0,0:14:00.08,0:14:02.61,Main,,0,0,0,,İşte orada! Raizo-dono!
Dialogue: 0,0:14:02.61,0:14:04.31,Main,,0,0,0,,Tekrardan hoş geldin!
Dialogue: 0,0:14:04.95,0:14:06.32,Main,,0,0,0,,Ne?
Dialogue: 0,0:14:06.32,0:14:08.91,Main,,0,0,0,,İyi olmana çok sevindim!
Dialogue: 0,0:14:10.61,0:14:13.31,Main,,0,0,0,,Raizo-san!
Dialogue: 0,0:14:16.24,0:14:17.87,Main,,0,0,0,,Ah-Ahali...
Dialogue: 0,0:14:20.16,0:14:21.90,Main,,0,0,0,,Kutlama ziyafeti verelim!
Dialogue: 0,0:14:21.90,0:14:23.75,Main,,0,0,0,,Tüm hazırlıklar tamam!
Dialogue: 0,0:14:25.71,0:14:29.68,Main,,0,0,0,,Kutlama ziyafeti mi? Neyi kutluyoruz?!
Dialogue: 0,0:14:29.68,0:14:32.23,Main,,0,0,0,,Raizo-san'ın güvende oluşunu...
Dialogue: 0,0:14:34.18,0:14:37.28,Main,,0,0,0,,...iki kralın barışmasını ve...
Dialogue: 0,0:14:38.27,0:14:41.90,Main,,0,0,0,,...Kozuki Klanı'nın\Nsağ salim bir araya gelişini!
Dialogue: 0,0:14:42.40,0:14:43.40,Main,,0,0,0,,Amanın!
Dialogue: 0,0:14:44.61,0:14:48.27,Main,,0,0,0,,Sizi canı çıkmayası Minkler!
Dialogue: 0,0:14:49.26,0:14:51.53,Main,,0,0,0,,Seni kilitlediğimiz için kusurumuza bakma!
Dialogue: 0,0:14:51.53,0:14:54.95,Main,,0,0,0,,Jack ve adamlarından korumak istedik seni!
Dialogue: 0,0:14:54.95,0:14:56.33,Main,,0,0,0,,Raizo-san!
Dialogue: 0,0:14:56.33,0:14:59.00,Main,,0,0,0,,Bağladığımız ellerin acımıyor değil mi?
Dialogue: 0,0:14:59.00,0:15:00.30,Main,,0,0,0,,Raizo-san!
Dialogue: 0,0:15:06.67,0:15:08.42,Main,,0,0,0,,{\fad(150,150)}Ninpo!
Dialogue: 0,0:15:09.84,0:15:12.45,Main,,0,0,0,,{\fad(150,150)}Daisuki no Jutsu!
Dialogue: 0,0:15:09.84,0:15:12.45,Attack,,0,0,0,,{\fad(150,150)}Sizi Çok Seviyorum Tekniği!
Dialogue: 0,0:15:16.64,0:15:18.42,Main,,0,0,0,,Raizo-dono!
Dialogue: 0,0:15:18.42,0:15:20.41,Main,,0,0,0,,Raizo-dono!
Dialogue: 0,0:15:20.41,0:15:23.06,Main,,0,0,0,,Nin! Nin! Nin! Nin!
Dialogue: 0,0:15:23.06,0:15:26.07,Main,,0,0,0,,Haydi öyleyse, ziyafet vakti!
Dialogue: 0,0:15:29.53,0:15:34.74,Main,,0,0,0,,Ziyafet!
Dialogue: 0,0:15:34.74,0:15:36.40,Main,,0,0,0,,Ziyafet!
Dialogue: 0,0:15:36.40,0:15:37.58,Main,,0,0,0,,Bekle bakalım Luffy!
Dialogue: 0,0:15:38.76,0:15:40.79,Main,,0,0,0,,Yeteri kadar ziyafet vermedik mi?!
Dialogue: 0,0:15:40.79,0:15:44.71,Main,,0,0,0,,Hemen yelken açalım! \NSanji-kun'u zamanında kurtaramazsak ne yapacaksın?!
Dialogue: 0,0:15:44.71,0:15:46.78,Main,,0,0,0,,Ne?! Sen de mi geliyorsun?
Dialogue: 0,0:15:46.78,0:15:51.59,Main,,0,0,0,,Herhâlde, ne sandın!\NKendimi sorumlu hissettiğim gibi...
Dialogue: 0,0:15:51.59,0:15:54.50,Main,,0,0,0,,...her şeyden öte\NYeni Dünya denizinde...
Dialogue: 0,0:15:54.50,0:15:58.01,Main,,0,0,0,,...rotacın olmadan yolunu\Nbulabileceğini mi sanıyorsun?
Dialogue: 0,0:15:59.75,0:16:03.98,Main,,0,0,0,,Ben de geliyorum! Pekoms ağır yaralı!\NDoktora ihtiyacı var!
Dialogue: 0,0:16:05.72,0:16:06.56,Main,,0,0,0,,Ayrıca...
Dialogue: 0,0:16:08.77,0:16:13.76,Main,,0,0,0,,...kendinizi kötü hissettiğinizde moralinizi\Nyerine kim getirecek sanıyorsunuz?
Dialogue: 0,0:16:13.76,0:16:22.00,English - OP18,,0,0,0,,♪ Nekomamushi Efendi'yi... Görmeye... ♪
Dialogue: 0,0:16:20.69,0:16:22.00,Main,,0,0,0,,O olmasa da olur.
Dialogue: 0,0:16:22.00,0:16:25.73,Main,,0,0,0,,Hemen dış kapının dış mandalı\Nmuamelesi yapmayın ama!
Dialogue: 0,0:16:25.73,0:16:29.76,Main,,0,0,0,,Sanji-san götürülürken\Nben de oradaydım bir kere!
Dialogue: 0,0:16:29.76,0:16:33.00,Main,,0,0,0,,Kin'emon, bunları yanımda\Ngötürsem sorun olur mu?
Dialogue: 0,0:16:33.00,0:16:36.76,Main,,0,0,0,,Bana sormana lüzum yok,\Ntayfa senin tayfan!
Dialogue: 0,0:16:36.76,0:16:41.52,Main,,0,0,0,,Ayrıca dostunu kurtarmaya çalışan\Nbirini kim durdurabilir?!
Dialogue: 0,0:16:41.52,0:16:45.49,Main,,0,0,0,,Hatta keşke ben de size katılabilseydim!
Dialogue: 0,0:16:45.49,0:16:47.77,Main,,0,0,0,,Sanji-dono'ya borcum büyük!
Dialogue: 0,0:16:47.77,0:16:49.61,Main,,0,0,0,,Bağışlayın!
Dialogue: 0,0:16:49.61,0:16:53.76,Main,,0,0,0,,Gizlice sızma işi yavaştan yalan oluyor.
Dialogue: 0,0:16:54.53,0:16:58.29,Main,,0,0,0,,Düğünü mahveder mahvetmez kaçın oradan!
Dialogue: 0,0:16:58.29,0:17:02.04,Main,,0,0,0,,Biz Kin'emonlar'la gidiyoruz,\NSanji size emanet!
Dialogue: 0,0:17:02.04,0:17:03.00,Main,,0,0,0,,Peki!
Dialogue: 0,0:17:03.00,0:17:03.97,Main,,0,0,0,,Bize güvenebilirsiniz!
Dialogue: 0,0:17:03.97,0:17:05.21,Main,,0,0,0,,Luffy.
Dialogue: 0,0:17:05.21,0:17:10.71,Main,,0,0,0,,Poneglife falan denk gelirseniz\Nbana bir kopyasını çıkartır mısın?
Dialogue: 0,0:17:10.71,0:17:11.70,Main,,0,0,0,,Peki!
Dialogue: 0,0:17:11.70,0:17:12.88,Main,,0,0,0,,Parka geziye mi gidiyorlar?!
Dialogue: 0,0:17:13.24,0:17:18.30,Main,,0,0,0,,Ben de Wano Krallığı'nda Kaido'nun\Nsahip olduğu Poneglifi araştıracağım.
Dialogue: 0,0:17:18.30,0:17:18.85,Main,,0,0,0,,Harika!
Dialogue: 0,0:17:18.85,0:17:22.10,Main,,0,0,0,,Pekâlâ öyleyse, sanırım tamamız?
Dialogue: 0,0:17:29.84,0:17:31.32,Main,,0,0,0,,Ne oldu?
Dialogue: 0,0:17:32.82,0:17:33.85,Main,,0,0,0,,Ne?!
Dialogue: 0,0:17:35.84,0:17:36.84,Main,,0,0,0,,Bu...
Dialogue: 0,0:17:38.88,0:17:40.41,Main,,0,0,0,,Ne oluyor?!
Dialogue: 0,0:17:57.07,0:17:58.18,Main,,0,0,0,,Tüm ada sallanıyor!
Dialogue: 0,0:18:03.20,0:18:05.56,Main,,0,0,0,,Zunesha haykırıyor!
Dialogue: 0,0:18:05.56,0:18:06.96,Main,,0,0,0,,Ne oluyor?!
Dialogue: 0,0:18:06.96,0:18:08.06,Main,,0,0,0,,Zunesha kim?!
Dialogue: 0,0:18:08.06,0:18:10.61,Main,,0,0,0,,Bu işte bu!
Dialogue: 0,0:18:10.61,0:18:13.07,Main,,0,0,0,,Filin adı ha!
Dialogue: 0,0:18:13.07,0:18:15.82,Main,,0,0,0,,Devasa bir deprem bu!\NDaha önce böylesi hiç olmamıştı!
Dialogue: 0,0:18:27.62,0:18:31.67,Main,,0,0,0,,Kimsin sen?! Kimin sesi bu?!
Dialogue: 0,0:18:46.61,0:18:48.94,Main,,0,0,0,,Kaçın! Yıkılıyor!
Dialogue: 0,0:18:50.24,0:18:52.59,Main,,0,0,0,,{\fad(150,150)}Strong Right!
Dialogue: 0,0:18:50.24,0:18:52.59,Attack,,0,0,0,,{\fad(150,150)}Sert Sağ
Dialogue: 0,0:18:53.24,0:18:55.58,Main,,0,0,0,,Binalardan uzaklaşın!
Dialogue: 0,0:18:58.58,0:19:01.74,Main,,0,0,0,,- Ağaçlara tutunun!\N- Peki!
Dialogue: 0,0:19:03.81,0:19:05.53,Main,,0,0,0,,Bu taraftan!
Dialogue: 0,0:19:08.55,0:19:09.59,Main,,0,0,0,,Acele haydi!
Dialogue: 0,0:19:09.59,0:19:11.12,Main,,0,0,0,,Teşekkür ederiz!
Dialogue: 0,0:19:12.03,0:19:14.61,Main,,0,0,0,,Kimsin sen?! Kim konuşuyor?!
Dialogue: 0,0:19:22.43,0:19:24.56,Main,,0,0,0,,Kemiklerim kırılacak!\NKemiklerim kırılacak!
Dialogue: 0,0:19:24.56,0:19:29.35,Main,,0,0,0,,Kemiklerim çatır, çatır, çatır, çatır!
Dialogue: 0,0:19:29.35,0:19:32.90,Main,,0,0,0,,Momonosuke-sama, neyin var?!
Dialogue: 0,0:19:36.73,0:19:39.86,Main,,0,0,0,,Zunesha'ya ne oluyor?!
Dialogue: 0,0:19:48.61,0:19:51.29,Thoughts,,0,0,0,,Oradaysan...
Dialogue: 0,0:19:52.60,0:19:54.29,Main,,0,0,0,,Ki-Kim bu?!
Dialogue: 0,0:19:55.56,0:19:58.13,Main,,0,0,0,,- Sesi gene duyuyorum!\N- Momonosuke-sama!
Dialogue: 0,0:19:59.13,0:20:00.58,Main,,0,0,0,,Luffy, ne oluyor?!
Dialogue: 0,0:20:00.58,0:20:03.20,Main,,0,0,0,,Ne demek ne oluyor?!\NSiz de duymuyor musunuz?
Dialogue: 0,0:20:03.20,0:20:04.51,Main,,0,0,0,,Neyi?!
Dialogue: 0,0:20:04.51,0:20:07.51,Main,,0,0,0,,- Mümkün değil!\N- Yoksa o da mı duyabiliyor?!
Dialogue: 0,0:20:07.51,0:20:10.75,Thoughts,,0,0,0,,Acele et!
Dialogue: 0,0:20:10.75,0:20:13.04,Main,,0,0,0,,Sen de kimsin?!
Dialogue: 0,0:20:13.04,0:20:16.77,Main,,0,0,0,,Bu seferki ses çok yüksekti!
Dialogue: 0,0:20:16.77,0:20:18.70,Main,,0,0,0,,Ateş!
Dialogue: 0,0:20:29.26,0:20:30.33,Main,,0,0,0,,İşe yarıyor!
Dialogue: 0,0:20:32.14,0:20:33.92,Main,,0,0,0,,Herhâlde yarayacak.
Dialogue: 0,0:20:34.70,0:20:38.88,Main,,0,0,0,,Normal filler tek bir arıdan bile\Nölümüne korkarlar.
Dialogue: 0,0:20:38.88,0:20:42.38,Main,,0,0,0,,Vücuduna iyi bakın.
Dialogue: 0,0:20:42.38,0:20:48.60,Main,,0,0,0,,Dile kolay bin yıl! Gerçekten o kadar zamandır yaşıyorsa derisi ciddi anlamda zayıflamış demektir!
Dialogue: 0,0:20:54.60,0:21:00.02,Main,,0,0,0,,Yaşayan bir efsane mi sandınız bunu?\NHayır! Yaşlı bir hayvan sadece!
Dialogue: 0,0:21:00.02,0:21:02.90,Main,,0,0,0,,Ateşi sol ön ayağına odaklayın!
Dialogue: 0,0:21:07.16,0:21:08.74,Main,,0,0,0,,Durmadan yağdırın!
Dialogue: 0,0:21:22.47,0:21:24.31,Main,,0,0,0,,Ateşe devam!
Dialogue: 0,0:21:24.31,0:21:27.00,Main,,0,0,0,,Diz çöktürüp kafasını\Nsuya yaklaştırabilirsek...
Dialogue: 0,0:21:27.00,0:21:29.64,Main,,0,0,0,,...işini kolayca bitiririz!
Dialogue: 0,0:21:35.23,0:21:38.80,Main,,0,0,0,,Gözlerini oyup dilini kesmek istiyorum!
Dialogue: 0,0:21:38.80,0:21:42.19,Main,,0,0,0,,Oradan girip içeriden\Nkarnını bile kesebiliriz hatta!
Dialogue: 0,0:21:46.88,0:21:48.91,Thoughts,,0,0,0,,Acele et!
Dialogue: 0,0:21:49.41,0:21:51.58,Thoughts,,0,0,0,,Emir ver bana!
Dialogue: 0,0:21:53.96,0:21:56.30,Thoughts,,0,0,0,,Eğer oradaysan...
Dialogue: 0,0:21:56.30,0:21:59.10,Main,,0,0,0,,Ne emir vereyim?!
Dialogue: 0,0:21:59.10,0:22:02.34,Main,,0,0,0,,Cevap ver! Kimsin sen?!
Dialogue: 0,0:22:23.48,0:22:25.00,Main,,0,0,0,,Biz hiçbir şey duymuyoruz.
Dialogue: 0,0:22:25.60,0:22:27.36,Main,,0,0,0,,Sadece sesini duyabiliyorum.
Dialogue: 0,0:22:27.76,0:22:31.74,Main,,0,0,0,,Beni dinlemiyor\Nve kim olduğunu da bilmiyorum!
Dialogue: 0,0:22:35.39,0:22:37.00,Main,,0,0,0,,Bu da ne demek şimdi?!
Dialogue: 0,0:22:37.00,0:22:39.48,Main,,0,0,0,,Ne oluyor burada böyle ya?!
Dialogue: 0,0:22:39.48,0:22:41.96,Main,,0,0,0,,Gol D. Roger da...
Dialogue: 0,0:22:41.96,0:22:44.20,Main,,0,0,0,,...Oden-sama da bu adada...
Dialogue: 0,0:22:44.20,0:22:46.92,Main,,0,0,0,,...aynı şeyi yaşamışlar diye duydum.
Dialogue: 0,0:22:46.92,0:22:51.66,Main,,0,0,0,,Şiddetli bir ses duymuşlar ama\Nondan bir cevap alamamışlar.
Dialogue: 0,0:22:51.66,0:22:55.60,Main,,0,0,0,,Momonosuke-sama! Momonosuke-sama!
Dialogue: 0,0:22:55.60,0:22:57.65,Thoughts,,0,0,0,,Momonosuke-sama!
Dialogue: 0,0:23:10.04,0:23:13.06,Main,,0,0,0,,Bu ne böyle?
Dialogue: 0,0:23:16.04,0:23:21.35,Main,,0,0,0,,Başım! Başım çatlıyor!
Dialogue: 0,0:23:26.10,0:23:27.59,Main,,0,0,0,,Bu...
Dialogue: 0,0:23:31.58,0:23:32.95,Main,,0,0,0,,Jack!
Dialogue: 0,0:23:35.51,0:23:36.80,Main,,0,0,0,,Jack...
Dialogue: 0,0:23:36.80,0:23:39.68,Main,,0,0,0,,Jack file saldırıyor!
Dialogue: 0,0:23:41.48,0:23:45.92,Main,,0,0,0,,Saat dokuz yönünde\Nçok güçlü görünen beş gemi var!
Dialogue: 0,0:23:45.92,0:23:48.00,Main,,0,0,0,,Zunesha saldırı altında mı dedin?!
Dialogue: 0,0:23:48.00,0:23:50.24,Main,,0,0,0,,Jack ölmemiş!
Dialogue: 0,0:23:50.64,0:23:53.51,Main,,0,0,0,,Momo, nereden biliyorsun bunu?!
Dialogue: 0,0:23:53.51,0:23:56.80,Main,,0,0,0,,Bilmiyorum... Ama gördüm!
Dialogue: 0,0:23:56.80,0:23:57.83,Main,,0,0,0,,Gördün mü?
Dialogue: 0,0:23:58.51,0:24:04.50,Main,,0,0,0,,Kafamın... Kafamın içinde belirdi...
Dialogue: 0,0:24:04.50,0:24:06.79,Main,,0,0,0,,Korkuyorum!
Dialogue: 0,0:24:07.48,0:24:09.46,Main,,0,0,0,,Gemileri çıkartın!
Dialogue: 0,0:24:09.46,0:24:12.09,Main,,0,0,0,,Jack'a saldıracağız!
Dialogue: 0,0:24:12.09,0:24:13.99,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:24:21.20,0:24:23.73,Thoughts,,0,0,0,,Canım yanıyor!
Dialogue: 0,0:24:26.22,0:24:29.19,Thoughts,,0,0,0,,Devrilecek olursam...
Dialogue: 0,0:24:31.15,0:24:34.16,Thoughts,,0,0,0,,...sizin için de hiç iyi olmaz!
Dialogue: 0,0:24:53.32,0:24:55.26,Main,,0,0,0,,Konuşan kişi...
Dialogue: 0,0:24:56.43,0:24:58.35,Main,,0,0,0,,...bu...
Dialogue: 0,0:24:59.05,0:25:00.72,Main,,0,0,0,,...filin ta kendisi!
Dialogue: 0,0:25:03.37,0:25:04.85,Main,,0,0,0,,Zunesha mı!?
Dialogue: 0,0:25:04.85,0:25:07.81,Main,,0,0,0,,Momonosuke-sama, ne oluyor?!
Dialogue: 0,0:25:09.20,0:25:09.82,Main,,0,0,0,,Gene oluyor!
Dialogue: 0,0:25:14.76,0:25:19.74,Thoughts,,0,0,0,,Ben uzun zaman önce...
Dialogue: 0,0:25:20.79,0:25:26.42,Thoughts,,0,0,0,,Fil uzun zaman önce\Nbir suç işlemiş...
Dialogue: 0,0:25:27.02,0:25:33.73,Main,,0,0,0,,...ve artık... yalnızca...\Nyürümesine... izin veriliyormuş.
Dialogue: 0,0:25:33.73,0:25:38.05,Main,,0,0,0,,O emre... itaat ediyormuş.
Dialogue: 0,0:25:43.31,0:25:44.27,Main,,0,0,0,,O yüzden...
Dialogue: 0,0:25:56.83,0:25:59.45,Main,,0,0,0,,Vurun şunu! Patlatın!
Dialogue: 0,0:26:01.20,0:26:07.46,Thoughts,,0,0,0,,O yüzden bir kerelik bile olsa\Nizin ver bana!
Dialogue: 0,0:26:16.14,0:26:19.30,Main,,0,0,0,,Bitirin işini! Fili öldürün!
Dialogue: 0,0:26:32.76,0:26:35.01,Thoughts,,0,0,0,,Savaşmam için...
Dialogue: 0,0:26:35.98,0:26:37.32,Thoughts,,0,0,0,,...emir ver!
Dialogue: 0,0:26:38.60,0:26:40.34,Main,,0,0,0,,Momo!
Dialogue: 0,0:26:40.34,0:26:45.07,Main,,0,0,0,,Söyle ona! Sesin ona ulaşacak bence!
Dialogue: 0,0:26:45.07,0:26:46.04,Main,,0,0,0,,Ama...
Dialogue: 0,0:26:46.44,0:26:50.25,Main,,0,0,0,,Fili devirirlerse hepimiz denize düşeriz!
Dialogue: 0,0:26:50.25,0:26:53.08,Main,,0,0,0,,Fakat sesim o kadar...
Dialogue: 0,0:26:53.08,0:26:56.06,Main,,0,0,0,,Tüm gücünle bağır işte!\NFil ölecek yoksa!
Dialogue: 0,0:27:09.04,0:27:10.77,Main,,0,0,0,,Çok az kaldı!
Dialogue: 0,0:27:16.66,0:27:21.69,Main,,0,0,0,,Vazgeçme fil! Devrilemezsin!
Dialogue: 0,0:27:22.68,0:27:24.63,Main,,0,0,0,,Jack'ı...
Dialogue: 0,0:27:25.13,0:27:34.14,Main,,0,0,0,,Jack'ı defet!
Dialogue: 0,0:27:38.92,0:27:40.88,Thoughts,,0,0,0,,Anlaşıldı!
Dialogue: 0,0:28:13.37,0:28:14.63,Main,,0,0,0,,Hortumu...
Dialogue: 0,0:28:24.08,0:28:28.10,Main,,0,0,0,,Jack-sama, gemimiz havaya fırlatıldı!
Dialogue: 0,0:29:16.56,0:29:17.85,Main,,0,0,0,,Ey...
Dialogue: 0,0:29:17.85,0:29:21.48,Main,,0,0,0,,Eyvah-degosaru!
Dialogue: 0,0:29:55.19,0:29:57.18,Main,,0,0,0,,Sakinleşti.
Dialogue: 0,0:29:57.18,0:29:58.81,Main,,0,0,0,,Ne oldu?!
Dialogue: 0,0:29:58.81,0:30:04.53,Main,,0,0,0,,Bilmiyorum ama kafamdaki\Nses ve görüntüler kayboldu.
Dialogue: 0,0:30:09.41,0:30:13.54,Main,,0,0,0,,Zunesha hortumunu kullandı öyle mi?
Dialogue: 0,0:30:14.93,0:30:16.75,Main,,0,0,0,,Evet-degosaru!\NTek bir darbede hem de!
Dialogue: 0,0:30:16.75,0:30:22.50,Main,,0,0,0,,Zunesha'nın kendi bilinci olacağı\Naklımın ucundan geçmezdi!
Dialogue: 0,0:30:22.50,0:30:26.47,Main,,0,0,0,,Üstüne üstlük onunla konuşabiliyoruz da.
Dialogue: 0,0:30:26.47,0:30:31.42,Main,,0,0,0,,Oden-sama Momonosuke-sama'nın\Nbu yeteneğinden haberdar mıydı?
Dialogue: 0,0:30:31.42,0:30:33.13,Main,,0,0,0,,Hey!
Dialogue: 0,0:30:33.70,0:30:36.69,Main,,0,0,0,,Ne oldu? \NNeden herkes hâlâ bu kadar ciddi bakıyor?
Dialogue: 0,0:30:36.69,0:30:39.98,Main,,0,0,0,,Yaşanan bu ani gelişmeler bizi şok etti.
Dialogue: 0,0:30:40.65,0:30:44.94,Main,,0,0,0,,Her şeyden önce Jack'ın buraya\Nnasıl gelebildiğini öğrenmemiz lazım.
Dialogue: 0,0:30:44.94,0:30:47.90,Main,,0,0,0,,Yoksa bu yer\Ngüvenli bir yer olmaktan çıkar.
Dialogue: 0,0:30:47.90,0:30:53.99,Main,,0,0,0,,Anladım. İyi şanslar o zaman.\NFil de bize katılırsa harika olur.
Dialogue: 0,0:30:53.99,0:30:56.87,Main,,0,0,0,,Söylemesi kolay tabii!
Dialogue: 0,0:30:56.87,0:31:02.08,Main,,0,0,0,,Neyse, biz gidiyoruz.\NHadi bize yiyecek tonla bir şeyler verin!
Dialogue: 0,0:31:23.42,0:31:25.19,Main,,0,0,0,,Ne var?
Dialogue: 0,0:31:27.53,0:31:31.24,Main,,0,0,0,,{\i1}Jack'la iletişimimiz aniden kesilmiş!{\i0}
Dialogue: 0,0:31:32.14,0:31:34.15,Main,,0,0,0,,Kaido-san!
Dialogue: 0,0:31:55.81,0:32:01.00,Main,,0,0,0,,Şimdiki adıyla Sakura Krallığı'nın tıp bilimi\Nve Kuş Krallığı'nın eczacılık bilgisi...
Dialogue: 0,0:32:01.00,0:32:02.98,Main,,0,0,0,,Hakikaten de mucizelere gebe!
Dialogue: 0,0:32:02.98,0:32:05.49,Main,,0,0,0,,Kanama durdu.
Dialogue: 0,0:32:05.49,0:32:07.50,Main,,0,0,0,,Çok iyi dayandın!
Dialogue: 0,0:32:07.50,0:32:11.32,Main,,0,0,0,,Bolca ilaç hazırladım, iyileşeceksin!
Dialogue: 0,0:32:11.32,0:32:13.51,Main,,0,0,0,,Dr. Chopper'a helal olsun!
Dialogue: 0,0:32:13.51,0:32:16.16,Main,,0,0,0,,Yeminle harika iş başardı!
Dialogue: 0,0:32:16.16,0:32:18.99,Main,,0,0,0,,Bö-Böyle iltifatlar...
Dialogue: 0,0:32:18.99,0:32:22.53,Main,,0,0,0,,...beni hiç de mutlu etmiyor,\Nhergeleler sizi!
Dialogue: 0,0:32:24.59,0:32:27.48,Main,,0,0,0,,Aynen bize öğrettiğin gibi...
Dialogue: 0,0:32:27.48,0:32:32.30,Main,,0,0,0,,...düzenli bir biçimde bandajları temizleyip\Nyaranın durumunu kontrol edeceğiz.
Dialogue: 0,0:32:32.30,0:32:37.46,Main,,0,0,0,,Harika ama bandajları değiştirmenin\Nkolay olacağını sanmıyorum.
Dialogue: 0,0:32:37.46,0:32:40.02,Main,,0,0,0,,Dikkatli oluruz.
Dialogue: 0,0:32:40.02,0:32:42.25,Main,,0,0,0,,Evet! Bize güvenebilirsin!
Dialogue: 0,0:32:42.25,0:32:47.61,Main,,0,0,0,,Zunesha bin yıl boyunca bize vatan olmuş!
Dialogue: 0,0:32:49.20,0:32:56.66,Main,,0,0,0,,Doğduğumuz günden beri hep gözümüzün önünde olduğundan biraz fazla rahatlayıp bunu unutmuş olabiliriz.
Dialogue: 0,0:32:56.66,0:33:01.16,Main,,0,0,0,,Ama bugün yeniden fark ettik.
Dialogue: 0,0:33:01.16,0:33:10.21,Main,,0,0,0,,Bu yüce canlı sayesinde hâlâ buradayız.
Dialogue: 0,0:33:11.56,0:33:16.51,Main,,0,0,0,,Ve bugünler de elbet sona erecek.
Dialogue: 0,0:33:16.51,0:33:22.44,Main,,0,0,0,,Kendi iradesi olan vatanımız Zunesha'ya...
Dialogue: 0,0:33:22.44,0:33:25.56,Main,,0,0,0,,...şimdi şunu sormak isterdim.
Dialogue: 0,0:33:27.11,0:33:36.61,Main,,0,0,0,,"Bin yıldır süren yolculuğunun varış noktası neresi?"
Dialogue: 0,0:33:39.91,0:33:44.68,Captions,,0,0,175,,{\fad(400,400)}Mokomo Düklüğü, Kurau Şehri
Dialogue: 0,0:33:41.59,0:33:45.60,Main,,0,0,3,,Burada, Zou'da mı kalmak istiyorsun?!
Dialogue: 0,0:33:45.60,0:33:46.50,Main,,0,0,0,,Evet.
Dialogue: 0,0:33:46.80,0:33:48.58,Main,,0,0,0,,Kalıp da ne yapacaksın?
Dialogue: 0,0:33:48.58,0:33:54.67,Main,,0,0,0,,Tam olarak bilmiyorum ama...
Dialogue: 0,0:33:55.33,0:33:57.43,Flashbacks,,0,0,0,,Anlaşıldı!
Dialogue: 0,0:33:58.40,0:34:03.02,Main,,0,0,0,,Mümkünse bin yıldır yaşayan...
Dialogue: 0,0:34:03.82,0:34:07.02,Main,,0,0,0,,...Zunesha'yla...
Dialogue: 0,0:34:07.02,0:34:12.02,Main,,0,0,0,,...bir kez daha konuşmak istiyorum!
Dialogue: 0,0:34:12.02,0:34:16.45,Main,,0,0,0,,Sesimi nasıl duyabildi?
Dialogue: 0,0:34:17.23,0:34:22.08,Main,,0,0,0,,Belki Kozuki Klanı'yla ilgili bizim\Nbilmediğimiz bir şeyler biliyordur!
Dialogue: 0,0:34:22.08,0:34:25.83,Main,,0,0,0,,- Ne?!\N- Momonosuke-sama?
Dialogue: 0,0:34:26.93,0:34:31.29,Main,,0,0,0,,Anlıyorum fakat Wano Krallığı'nda\Nbizi bekleyen insanlar var...
Dialogue: 0,0:34:32.77,0:34:34.34,Main,,0,0,0,,Bir şey olmaz, Kin'emon.
Dialogue: 0,0:34:35.54,0:34:41.60,Main,,0,0,0,,Zou'yu Kaido tehditinden hâlâ\Nkorumam gerektiğine inanıyorum.
Dialogue: 0,0:34:41.60,0:34:48.85,Main,,0,0,0,,Jack'ın burayı iki kez nasıl bulabildiğini bilmiyoruz o yüzden tedbiri elden bırakamayız.
Dialogue: 0,0:34:51.44,0:34:55.82,Main,,0,0,0,,Wano Krallığı'na\Nhep birlikte de gidemeyiz zaten.
Dialogue: 0,0:34:55.82,0:34:59.60,Main,,0,0,0,,Bir süre daha burada kalmayı planlıyorum.
Dialogue: 0,0:34:59.60,0:35:02.95,Main,,0,0,0,,Momonosuke-sama'yı sonra ben getiririm.
Dialogue: 0,0:35:02.95,0:35:03.89,Main,,0,0,0,,Peki öyleyse.
Dialogue: 0,0:35:03.89,0:35:07.93,Main,,0,0,0,,Nekomamushi az evvel Vivre Kartı'mı yaptı.
Dialogue: 0,0:35:07.93,0:35:10.12,Main,,0,0,0,,Bunu herkese paylaştırayım.
Dialogue: 0,0:35:10.12,0:35:14.04,Main,,0,0,0,,Öyleyse dört gruba ayrılacağız.
Dialogue: 0,0:35:14.06,0:35:19.23,Captions,,0,0,680,,Marco'yu Arama
Dialogue: 0,0:35:14.06,0:35:19.23,Captions,,860,0,530,,Wano Ülkesi
Dialogue: 0,0:35:14.06,0:35:19.23,Captions,,0,0,3,,Zou
Dialogue: 0,0:35:14.06,0:35:19.23,Captions,,0,780,500,,Whole Cake Adası
Dialogue: 0,0:35:14.06,0:35:19.23,Captions,,40,0,515,,Nekomamushi'nin Grubu
Dialogue: 0,0:35:14.06,0:35:19.23,Captions,,950,0,100,,Kin'emon'un Grubu
Dialogue: 0,0:35:14.06,0:35:19.23,Captions,,0,0,95,,Inuarashi'nin Grubu
Dialogue: 0,0:35:14.06,0:35:19.23,Captions,,0,850,150,,Luffy'nin Grubu
Dialogue: 0,0:35:19.22,0:35:23.41,Main,,0,0,0,,Vivre Kartı'yla\Nbuluşma noktasına ulaşabilirsiniz...
Dialogue: 0,0:35:23.41,0:35:26.36,Main,,0,0,0,,...fakat asıl sorun\Nbirbirimizle nasıl iletişim kuracağımız...
Dialogue: 0,0:35:26.36,0:35:30.40,Main,,0,0,0,,Diğer ülkelerde şu kadarcık\Nsalyangozları kullanıyorlar...
Dialogue: 0,0:35:30.40,0:35:33.94,Main,,0,0,0,,...ve içine doğru konuşunca sesini\Nuzaktaki birine iletebiliyorsun...
Dialogue: 0,0:35:33.94,0:35:36.94,Main,,0,0,0,,- Den Den Mushileri mi diyorsun?\N- Onlar ha?
Dialogue: 0,0:35:36.94,0:35:41.16,Main,,0,0,0,,Ama bu ülkede onlara pek ihtiyacımız\Nolmadığından pek bulunmaz.
Dialogue: 0,0:35:41.16,0:35:44.99,Main,,0,0,0,,Den Den Mushi arıyorsanız ormanda\Nvahşi bir tane görmüştüm.
Dialogue: 0,0:35:47.00,0:35:50.90,Main,,0,0,0,,İstiyorsanız size bir tane yaparım,\Nçok kolaydır.
Dialogue: 0,0:35:50.90,0:35:51.46,Main,,0,0,0,,Ne?
Dialogue: 0,0:35:51.49,0:35:54.08,Captions,,0,0,170,,{\fad(300,0)}Balina Ormanı
Dialogue: 0,0:35:51.95,0:35:54.08,Main,,0,0,3,,Hey!
Dialogue: 0,0:35:54.57,0:35:56.88,Main,,0,0,3,,Hey!
Dialogue: 0,0:35:54.13,0:35:56.44,Captions,,0,0,170,,{\fad(300,0)}Muhafız Barınakları Civarları
Dialogue: 0,0:35:58.35,0:36:02.27,Main,,0,0,0,,Pekomamushi'nin evi yıkılmış!
Dialogue: 0,0:36:02.27,0:36:03.84,Main,,0,0,0,,Hey, Pekomamushi!
Dialogue: 0,0:36:04.13,0:36:07.10,Main,,0,0,0,,İyi misin?! Cevap ver!
Dialogue: 0,0:36:07.59,0:36:09.90,Main,,0,0,0,,Pekomamushi! Neredesin?!
Dialogue: 0,0:36:09.90,0:36:11.36,Main,,0,0,0,,Buradayım gao!
Dialogue: 0,0:36:11.36,0:36:12.80,Main,,0,0,0,,Neredesin?!
Dialogue: 0,0:36:12.80,0:36:14.33,Main,,0,0,0,,Aşağı bak aşağı!
Dialogue: 0,0:36:16.76,0:36:18.86,Main,,0,0,0,,Kaplumbağa mı bu?!
Dialogue: 0,0:36:18.86,0:36:21.53,Main,,0,0,0,,Geri çekil!
Dialogue: 0,0:36:25.16,0:36:29.17,Main,,0,0,0,,Cidden yani!\NBu sarsıntılar da neyin nesiydi?!
Dialogue: 0,0:36:29.17,0:36:32.08,Main,,0,0,0,,Kamemamushi miydin sen?!
Dialogue: 0,0:36:29.17,0:36:32.08,Note,,0,0,0,,Kame: Kaplumbağa
Dialogue: 0,0:36:32.08,0:36:38.46,Main,,0,0,0,,Bak sen! Adımı unutmanı geçtim şimdi bir de\Naslan olduğumu unuttun öyle mi gao?!
Dialogue: 0,0:36:38.46,0:36:43.00,Main,,0,0,0,,Öyle olacak tabii!\NKame Kame güç kullanıcısıyım!
Dialogue: 0,0:36:43.00,0:36:46.30,Main,,0,0,0,,Kabuğumsa elmas kadar serttir!
Dialogue: 0,0:36:46.30,0:36:48.50,Main,,0,0,0,,Kime konuşuyorum!?
Dialogue: 0,0:36:48.50,0:36:52.18,Main,,0,0,0,,Chopper sorumluluğunu üstlenip\Nseni tedavi edecekmiş.
Dialogue: 0,0:36:52.18,0:36:57.94,Main,,0,0,0,,Anlıyorum, elmaslı kısma bir yorum\Nyapmayacaksın demek gao!
Dialogue: 0,0:36:59.54,0:37:02.99,Main,,0,0,0,,Ama tedavi için müteşekkirim.
Dialogue: 0,0:37:02.99,0:37:06.32,Main,,0,0,0,,Size büyük borcum var.
Dialogue: 0,0:37:06.32,0:37:08.95,Main,,0,0,0,,Ne?
Dialogue: 0,0:37:08.95,0:37:11.50,Main,,0,0,0,,Ne?!!
Dialogue: 0,0:37:11.50,0:37:14.53,Main,,0,0,0,,O yüzden\NBig Mom'ın yerine gidelim hadi!
Dialogue: 0,0:37:14.53,0:37:17.17,Main,,0,0,0,,Ne?!
Dialogue: 0,0:37:17.17,0:37:19.30,Main,,0,0,0,,Bekle, lanet olası!
Dialogue: 0,0:37:19.30,0:37:24.47,Main,,0,0,0,,Fena halde yaralıyım, kafan almıyor mu?!
Dialogue: 0,0:37:26.93,0:37:31.20,Main,,0,0,0,,Yaralıyım diyorum! Adamın asabını...
Dialogue: 0,0:37:33.98,0:37:37.69,Main,,0,0,0,,Aklım almıyor, ne biçim iş bu?!
Dialogue: 0,0:37:37.69,0:37:42.07,Main,,0,0,0,,Ne biçim insanlara\Nhayatımı borçluyum böyle?!
Dialogue: 0,0:37:42.10,0:37:43.77,Captions,,930,0,300,,{\fad(250,250)}Muhafızların Yerleşim \NBölgesi
Dialogue: 0,0:37:45.22,0:37:46.56,Main,,0,0,0,,Efendi.
Dialogue: 0,0:37:47.65,0:37:48.88,Main,,0,0,0,,Pedro.
Dialogue: 0,0:37:48.88,0:37:50.99,Main,,0,0,0,,Sanji ülkemizin kurtarıcısıdır.
Dialogue: 0,0:37:54.51,0:37:57.12,Main,,0,0,0,,Ve kendisi bu ülkedeyken kaçırıldı.
Dialogue: 0,0:37:57.12,0:38:00.88,Main,,0,0,0,,Az kişi gitmeleri gerektiğini biliyorum\Nfakat Mink Kabilesi'nden...
Dialogue: 0,0:38:00.88,0:38:06.05,Main,,0,0,0,,...yalnızca Pekoms'un gitmesine\Nmüsaade edersek bize yakışmaz.
Dialogue: 0,0:38:06.05,0:38:10.30,Main,,0,0,0,,Sen-gara, Luffy'le mi gitmek istiyorsun?
Dialogue: 0,0:38:10.60,0:38:11.53,Main,,0,0,0,,Evet!
Dialogue: 0,0:38:11.53,0:38:14.18,Main,,0,0,0,,Hemen öne çıkma bakalım Pedro!
Dialogue: 0,0:38:14.18,0:38:16.87,Main,,0,0,0,,O görevi...
Dialogue: 0,0:38:20.52,0:38:25.07,Main,,0,0,0,,...Inuarashi Silahşörleri olarak\Nüstlenmeye hazırız!
Dialogue: 0,0:38:25.07,0:38:27.53,Main,,0,0,0,,İşime karışma Shishilian!
Dialogue: 0,0:38:27.53,0:38:31.94,Main,,0,0,0,,Senin gibi gürültücü biri\Nbu görev için uygun değil!
Dialogue: 0,0:38:33.57,0:38:36.29,Main,,0,0,0,,Kimmiş o gürültücü?!
Dialogue: 0,0:38:36.29,0:38:41.04,Main,,0,0,0,,Öyleyse ben gideyim!\NBunca zamandır onlarla birlikteydim!
Dialogue: 0,0:38:41.04,0:38:44.34,Main,,0,0,0,,Dr. Chopper'ın asistanı olarak\Nbeni de gönderin lütfen!
Dialogue: 0,0:38:44.34,0:38:45.85,Main,,0,0,0,,Wanda! Tristan!
Dialogue: 0,0:38:45.85,0:38:49.89,Main,,0,0,0,,Biz Luffy'le dövüştükten sonra\Narkadaş olduk Pedro-san!
Dialogue: 0,0:38:49.89,0:38:51.72,Main,,0,0,0,,BB! Roddy!
Dialogue: 0,0:38:53.62,0:38:56.61,Main,,0,0,0,,Nami karnımın üstünde uyumayı seviyor!
Dialogue: 0,0:38:56.61,0:38:58.77,Main,,0,0,0,,Bunun kime\Nne faydası var şimdi Aziz Yomo!
Dialogue: 0,0:38:58.77,0:39:02.87,Main,,0,0,0,,Sonsuza dek Baron Ceset'in\Nkemiklerini kemirmek istiyorum!
Dialogue: 0,0:39:02.87,0:39:04.89,Main,,0,0,0,,- Ben de!\N- Ben de ben de!
Dialogue: 0,0:39:04.89,0:39:08.32,Main,,0,0,0,,Sizden başka kime ne faydası var bunun!?\NAz kapayın çenenizi köpek klanı!
Dialogue: 0,0:39:08.32,0:39:11.37,Main,,0,0,0,,Herkesin neler hissettiğini anlayabiliyorum.
Dialogue: 0,0:39:11.37,0:39:13.60,Main,,0,0,0,,Ama bu işi...
Dialogue: 0,0:39:13.60,0:39:15.62,Main,,0,0,0,,...Pedro'ya bırakın!
Dialogue: 0,0:39:19.72,0:39:21.96,Main,,0,0,0,,Neden Efendi?!
Dialogue: 0,0:39:21.96,0:39:24.15,Main,,0,0,0,,Pekoms da onlarla beraber olacağı için.
Dialogue: 0,0:39:27.98,0:39:32.55,Main,,0,0,0,,Ona-gara Pedro'dan başka\Nkimse sözünü geçiremez!
Dialogue: 0,0:39:37.72,0:39:40.74,Main,,0,0,0,,Orada bir şeyler oluyor ama!
Dialogue: 0,0:39:41.85,0:39:45.82,Main,,0,0,0,,Sonuncuya "mükemmel" demiştim ama...
Dialogue: 0,0:39:45.82,0:39:50.15,Main,,0,0,0,,...bu yeni model ona da toz yutturuyor!
Dialogue: 0,0:39:50.15,0:39:53.41,Main,,0,0,0,,Pop Green'nin büyüme yeteneğini dahil edip...
Dialogue: 0,0:39:53.41,0:39:57.49,Main,,0,0,0,,...yüzey kaplamasında\NFranky'den yardım aldım.
Dialogue: 0,0:39:57.49,0:40:01.83,Main,,0,0,0,,Asrın en büyük icadı desem\Nabartmış olmam...
Dialogue: 0,0:40:04.33,0:40:05.75,Main,,0,0,0,,Dinliyor musun sen beni Nami?!
Dialogue: 0,0:40:05.75,0:40:07.96,Main,,0,0,0,,Burasını sıkarsam...
Dialogue: 0,0:40:17.79,0:40:18.85,Main,,0,0,0,,Öleyazdım!
Dialogue: 0,0:40:21.27,0:40:23.29,Main,,0,0,0,,Biraz fazla uzun olmuş, Usopp!
Dialogue: 0,0:40:23.29,0:40:29.15,Main,,0,0,0,,Talimatlarımı dinlesene!\NO kadar uzatan sensin! Pratik yapman lazım!
Dialogue: 0,0:40:29.15,0:40:35.62,Main,,0,0,0,,Kullanımında ufak değişiklikler yapılmış gönlünce uzayıp kısalan yeni İklim Aygıtı o!
Dialogue: 0,0:40:37.69,0:40:39.67,Main,,0,0,0,,Bak sen!
Dialogue: 0,0:40:40.74,0:40:45.38,Main,,0,0,0,,Sabaody'de senden aldığım\Ntüm Weatheria aletlerini ekledim.
Dialogue: 0,0:40:48.15,0:40:49.85,Main,,0,0,0,,Ama bir şey var ki...
Dialogue: 0,0:40:51.80,0:40:54.58,Main,,0,0,0,,Sabaody'de bana dediklerin...
Dialogue: 0,0:41:00.31,0:41:02.46,Flashbacks,,0,0,0,,Büyü aygıtı gibi bir şey olsun!
Dialogue: 0,0:41:02.46,0:41:05.02,Main,,0,0,0,,Ne istediğini zerre anlamamıştım.
Dialogue: 0,0:41:05.02,0:41:08.30,Main,,0,0,0,,Elde tutuşu harika! Kolay sallanıyor!
Dialogue: 0,0:41:08.30,0:41:11.41,Main,,0,0,0,,- Nasıl olduğuna sen karar ver.\N- Bravo be Usopp!
Dialogue: 0,0:41:11.41,0:41:15.11,Main,,0,0,0,,Ne... Ne... \NNe gelişmiş bir ninjutsudur bu?!
Dialogue: 0,0:41:16.40,0:41:17.65,Main,,0,0,0,,Bayıldım!
Dialogue: 0,0:41:17.65,0:41:21.10,Main,,0,0,0,,Weatheria'nın hava durumu biliminin\Ndoruk noktası bu!
Dialogue: 0,0:41:21.10,0:41:24.62,Main,,0,0,0,,Hep istediğim Büyücü İklim Aygıtı!
Dialogue: 0,0:41:24.62,0:41:26.59,Main,,0,0,0,,Teşekkür ederim, Usopp!
Dialogue: 0,0:41:26.59,0:41:28.00,Main,,0,0,0,,Lafı olmaz yahu!
Dialogue: 0,0:41:28.25,0:41:30.34,Main,,0,0,0,,Şimdi yapılan masraflara gelince...
Dialogue: 0,0:41:31.23,0:41:32.97,Main,,0,0,0,,{\fad(150,150)}Mirage Tempo!
Dialogue: 0,0:41:31.23,0:41:32.97,Attack,,0,0,0,,{\fad(150,150)}Serap Tempo
Dialogue: 0,0:41:32.97,0:41:35.06,Main,,0,0,0,,Kaçma!
Dialogue: 0,0:41:36.36,0:41:37.66,Captions,,0,0,170,,{\fad(500,0)}Zou Ana Giriş Kapısı
Dialogue: 0,0:41:39.22,0:41:42.24,Main,,0,0,0,,Altı kişiyiz yani.
Dialogue: 0,0:41:42.81,0:41:44.70,Main,,0,0,0,,Seni de aramızda görmek güzel Peropero!
Dialogue: 0,0:41:44.70,0:41:46.66,Main,,0,0,0,,Pedro olacak o.\NSize ayakbağı olmam.
Dialogue: 0,0:41:47.23,0:41:51.11,Main,,0,0,0,,Pedro abi niye geliyor gao?!
Dialogue: 0,0:41:51.11,0:41:55.07,Main,,0,0,0,,Seni-gara uzun zamandır\Ntanıyan biri olarak geliyorum.
Dialogue: 0,0:41:55.07,0:41:57.55,Main,,0,0,0,,O da ne demek öyle gao?!
Dialogue: 0,0:41:57.55,0:42:00.82,Main,,0,0,0,,Nami, kendine iyi bak!
Dialogue: 0,0:42:00.82,0:42:04.22,Main,,0,0,0,,Teşekkür ederim! Sen de öyle, Wanda!
Dialogue: 0,0:42:05.86,0:42:08.75,Main,,0,0,0,,Dr. Chopper, kendine iyi bak.
Dialogue: 0,0:42:15.22,0:42:17.80,Main,,0,0,0,,Bana bak,\Nherifin nasıl biri olduğunu biliyorsun.
Dialogue: 0,0:42:17.80,0:42:22.50,Main,,0,0,0,,Evleneceği için sevinçten\Ndeli gibi dans ediyor olabilir.
Dialogue: 0,0:42:22.50,0:42:23.56,Main,,0,0,0,,Yok artık daha neler!
Dialogue: 0,0:42:23.56,0:42:25.60,Main,,0,0,0,,-de diyemiyorum hemen!
Dialogue: 0,0:42:25.60,0:42:28.44,Main,,0,0,0,,Su akar yolunu bulur!
Dialogue: 0,0:42:28.44,0:42:32.82,Main,,0,0,0,,Öyleyse Luffy-dono,\NWano Krallığı'nda bekleyeceğiz!
Dialogue: 0,0:42:32.82,0:42:34.66,Main,,0,0,0,,İyi şanslar Luffy!
Dialogue: 0,0:42:36.40,0:42:37.90,Main,,0,0,0,,Kendinize iyi bakın!
Dialogue: 0,0:42:39.74,0:42:42.05,Main,,0,0,0,,Bir sorun olursa\Nhemen haber verin olur mu?
Dialogue: 0,0:42:42.05,0:42:45.80,Main,,0,0,0,,Kaido'yu yenecek bir silah yapacağım!
Dialogue: 0,0:42:45.80,0:42:50.00,Main,,0,0,0,,Ben de Wano Krallığı'ndaki\Nsamurayları bir araya toplayacağım!
Dialogue: 0,0:42:50.00,0:42:53.67,Main,,0,0,0,,Öyleyse filden inmenize yardım edeyim.
Dialogue: 0,0:42:53.67,0:42:56.26,Main,,0,0,0,,Hiç gerek yok, Kanjuro!
Dialogue: 0,0:43:03.70,0:43:05.31,Main,,0,0,0,,Güle güle!
Dialogue: 0,0:43:06.20,0:43:08.39,Main,,0,0,0,,Yihu!
Dialogue: 0,0:43:25.24,0:43:27.62,Main,,0,0,0,,Sanji'yi bize bırakın!
Dialogue: 0,0:43:27.62,0:43:30.17,Main,,0,0,0,,Ne?!
Dialogue: 0,0:43:30.17,0:43:32.52,Main,,0,0,0,,Wano Krallığı'nda görüşmek üzere!
Dialogue: 0,0:43:32.52,0:43:35.16,Main,,0,0,0,,- Pekâlâ!\N- Big Mom'a yakalanmayın sakın!
Dialogue: 0,0:43:35.16,0:43:37.63,Main,,0,0,0,,Denizlerin imparatoru olur kendisi!
Dialogue: 0,0:43:37.63,0:43:39.77,Main,,0,0,0,,Tamamdır! Hadi görüşürüz!
Dialogue: 0,0:43:46.51,0:43:49.50,Narrator,,0,0,0,,Böylece Luffy liderliğindeki\NSanji'yi kurtarma takımı...
Dialogue: 0,0:43:49.50,0:43:56.15,Narrator,,0,0,0,,...Luffy'nin kafa tuttuğu Yonko Big Mom'ın beklediği Whole Cake Adası'na doğru yola koyulur.
Dialogue: 0,0:43:57.50,0:44:02.61,Narrator,,0,0,0,,Bu sırada, Grand Line'daki\Nçöl krallığı Arabasta'da...
Dialogue: 0,0:44:03.30,0:44:05.16,Main,,0,0,0,,Baba, acele et!
Dialogue: 0,0:44:05.16,0:44:08.70,Main,,0,0,0,,Bekle biraz Vivi.\NNeden bu kadar neşelisin?
Dialogue: 0,0:44:19.64,0:44:23.93,Main,,0,0,0,,Denizlere açılmayalı bir asır oldu çünkü!
Dialogue: 0,0:44:29.01,0:44:34.20,OP11 Credits,,0,0,0,,Editing:\N Galaxy 9000\N\NSubtitling:\N Galaxy 9000,\NDatenshi,\NSewil\N\NQuality Assurance:\N Mr Luffy,\NGalaxy 9000,\NFeeso\N\NSoundtracking:\N Halee\N\NInfoboxes\Nand Titlecard:\N Datenshi\N\NTranslation:\NCrunchyroll
