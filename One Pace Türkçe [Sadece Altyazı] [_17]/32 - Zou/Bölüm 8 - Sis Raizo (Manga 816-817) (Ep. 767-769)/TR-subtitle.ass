Dialogue: 0,0:01:41.80,0:01:46.49,Title,,0,0,240,,{\fad(200,200)}Sis Raizo
Dialogue: 0,0:01:43.01,0:01:46.50,Main,,0,0,0,,Durum vahim!\NKin'emonlar çoktan gelmişler!
Dialogue: 0,0:01:46.50,0:01:51.79,Main,,0,0,0,,Burada adı bile bilinmeyen Raizo denen samuray yüzünden Mokomo Krallığı yerlebir edildi!
Dialogue: 0,0:01:52.14,0:01:58.05,Main,,0,0,0,,Minkler'le karşılaşıp Raizo'yu arıyoruz\Nderlerse yandığımızın resmidir!
Dialogue: 0,0:01:58.05,0:02:00.58,Main,,0,0,0,,Her halükârda onları durdurmamız lazım!
Dialogue: 0,0:02:00.58,0:02:01.20,Main,,0,0,0,,Evet!
Dialogue: 0,0:02:01.20,0:02:02.16,Main,,0,0,0,,Gidelim!
Dialogue: 0,0:02:16.22,0:02:19.36,Main,,0,0,0,,Eyvah-degosaru!
Dialogue: 0,0:02:20.94,0:02:22.40,Main,,0,0,0,,Bariete çanı çalıyor!
Dialogue: 0,0:02:25.41,0:02:30.42,Main,,0,0,0,,Samuraylar burada-degosaru!\NSamuraylar geldi-degosaru!
Dialogue: 0,0:02:36.13,0:02:39.84,Main,,0,0,0,,Şehre gidelim! \Nİyi durumda olan herkes peşimden gelsin!
Dialogue: 0,0:02:39.84,0:02:40.58,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:02:42.24,0:02:45.22,Main,,0,0,0,,Dük-sama, Warney'iniz hazır!
Dialogue: 0,0:03:02.46,0:03:07.72,Main,,0,0,0,,Ne sinir bozucu bir çanmış!\NDurmak bilmedi.
Dialogue: 0,0:03:08.10,0:03:10.66,Main,,0,0,0,,Ziyaretçi geldiğini haber vermek için\Nçaldıkları çan değil mi bu?
Dialogue: 0,0:03:11.64,0:03:14.02,Main,,0,0,0,,Böyle hoş geldin diyorlar!
Dialogue: 0,0:03:14.48,0:03:15.77,Main,,0,0,0,,Gayet mümkün!
Dialogue: 0,0:03:21.28,0:03:24.18,Main,,0,0,0,,Fakat Law-dono...
Dialogue: 0,0:03:24.62,0:03:29.01,Main,,0,0,0,,...insanları sevmeyen Zou sakinlerinin\NMink Kabilesi olduğunu söylemişti.
Dialogue: 0,0:03:29.01,0:03:34.64,Main,,0,0,0,,Haklısın, dünyada böyle biliniyorlar demek! \NDuy da inanma.
Dialogue: 0,0:03:35.50,0:03:38.46,Main,,0,0,0,,İnsanlar bugünlerde böyle düşünüyorsa...
Dialogue: 0,0:03:43.53,0:03:46.78,Main,,0,0,0,,Baba! Kanjuro!
Dialogue: 0,0:03:47.52,0:03:49.09,Main,,0,0,0,,Momonosuke!
Dialogue: 0,0:03:50.76,0:03:53.96,Main,,0,0,0,,Kanjuro!\NSeni iyi gördüğüme çok sevindim!
Dialogue: 0,0:03:55.42,0:03:57.00,Main,,0,0,0,,Anlaşılan benim için endişelenmişsin.
Dialogue: 0,0:03:57.00,0:04:01.48,Main,,0,0,0,,Neden yalnızsın peki?\NLuffy-donolar nerede?
Dialogue: 0,0:04:02.76,0:04:08.06,Main,,0,0,0,,İşin aslı bu ülkeye ayak\Nbastığımdan beri içim hiç rahat değil.
Dialogue: 0,0:04:08.06,0:04:11.13,Main,,0,0,0,,O yüzden odamda tek başıma uyuyordum.
Dialogue: 0,0:04:11.13,0:04:12.24,Main,,0,0,0,,Amanın!
Dialogue: 0,0:04:12.24,0:04:13.52,Main,,0,0,0,,Zavallı yavrucak!
Dialogue: 0,0:04:13.52,0:04:16.38,Main,,0,0,0,,Öyle demek! Bizimle gel öyleyse.
Dialogue: 0,0:04:17.94,0:04:23.03,Main,,0,0,0,,Eminim bizi karşılamaya\Nhazırlanıyorlardır şimdi!
Dialogue: 0,0:04:23.38,0:04:28.18,Main,,0,0,0,,Neden?! Neden?! Neden?! \NNeden sabahın köründe koşturuyorsunuz beni?!
Dialogue: 0,0:04:28.18,0:04:31.53,Main,,0,0,0,,Ne diyorum sana?!\NKin'emon'la bir de neydi adı...
Dialogue: 0,0:04:31.53,0:04:32.59,Main,,0,0,0,,Kanjuro!
Dialogue: 0,0:04:32.59,0:04:35.56,Main,,0,0,0,,Evet, o ikisi gelmişler!
Dialogue: 0,0:04:35.56,0:04:39.98,Main,,0,0,0,,İki samuray ortaya çıktı diye\Ntüm ülke ayağa kalkmış durumda!
Dialogue: 0,0:04:39.98,0:04:44.22,Main,,0,0,0,,Nekomamushi Efendi, \NMuhafızlar'ı peşine takıp şehre gitti!
Dialogue: 0,0:04:44.22,0:04:48.27,Main,,0,0,0,,Bir ziyafet daha olacak ha?!\NAynı gün olmuş, benim için hiç sorun değil!
Dialogue: 0,0:04:48.27,0:04:50.32,Main,,0,0,0,,Hayır be!\Nİntikam almaya gidiyorlar!
Dialogue: 0,0:04:52.12,0:04:53.56,Main,,0,0,0,,Başka ne beklenir ki?!
Dialogue: 0,0:04:54.14,0:04:57.84,Main,,0,0,0,,Samurayın tekini saklıyorlar diye\Nboş yere suçlanıp ölümden döndüler!
Dialogue: 0,0:05:10.18,0:05:12.31,Main,,0,0,0,,Neredeler?!
Dialogue: 0,0:05:12.31,0:05:14.24,Main,,0,0,0,,Hemen buluruz!
Dialogue: 0,0:05:14.24,0:05:18.06,Main,,0,0,0,,Ülkedeki herkes şehre doğru geliyor...
Dialogue: 0,0:05:24.84,0:05:27.68,Main,,0,0,0,,Pedro! Bir şey görüyor musun?!
Dialogue: 0,0:05:30.42,0:05:31.90,Main,,0,0,0,,Durum hiç iyi değil.
Dialogue: 0,0:05:37.48,0:05:40.14,Main,,0,0,0,,Samurayları hâlâ bulamadınız mı?
Dialogue: 0,0:05:40.14,0:05:41.48,Main,,0,0,0,,Arayış tam hız sürüyor!
Dialogue: 0,0:05:41.48,0:05:44.15,Main,,0,0,0,,Efendi, lütfen geri çekilin!
Dialogue: 0,0:05:44.15,0:05:45.68,Main,,0,0,0,,Geri mi çekileyim?!
Dialogue: 0,0:05:45.68,0:05:46.54,Main,,0,0,0,,Çabuk!
Dialogue: 0,0:05:46.54,0:05:49.03,Main,,0,0,0,,O da ne demekmiş öyle?!
Dialogue: 0,0:05:49.84,0:05:52.58,Thoughts,,0,0,0,,Ne olur görmeyin birbirinizi!
Dialogue: 0,0:06:15.73,0:06:21.00,Main,,0,0,0,,Eyv- Eyvah! Karşılaştılar!
Dialogue: 0,0:06:27.46,0:06:28.24,Main,,0,0,0,,Efendi!
Dialogue: 0,0:06:28.24,0:06:29.36,Main,,0,0,0,,Dük-sama!
Dialogue: 0,0:06:30.98,0:06:32.74,Main,,0,0,0,,Yapmayın lütfen, Efendi!
Dialogue: 0,0:06:32.74,0:06:35.83,Main,,0,0,0,,Dük-sama, sakinleşin!
Dialogue: 0,0:06:41.31,0:06:43.12,Main,,0,0,0,,Dövüş mü var?
Dialogue: 0,0:06:49.14,0:06:50.22,Main,,0,0,0,,Bunlar...
Dialogue: 0,0:06:57.02,0:06:59.12,Main,,0,0,0,,Resmen, uçurumun ucundan...
Dialogue: 0,0:06:59.12,0:07:00.30,Main,,0,0,0,,Kurtulduk!
Dialogue: 0,0:07:02.04,0:07:06.23,Main,,0,0,0,,Üçünüz sözümü dinleyip\Nderhal Sunny-go'ya dönün!
Dialogue: 0,0:07:08.78,0:07:13.70,Main,,0,0,0,,Görüşmeyeli kaç yıl oldu Canavar Kedi?\NGörmeyeli daha bir canavarlaşmışsın.
Dialogue: 0,0:07:15.46,0:07:20.32,Main,,0,0,0,,Sana ne demeli-gara,\Nbacaklarından birini kaybetmişsin.
Dialogue: 0,0:07:23.21,0:07:24.76,Main,,0,0,0,,Yandığımızın resmidir!
Dialogue: 0,0:07:24.76,0:07:26.58,Main,,0,0,0,,Biri onları durdursun!
Dialogue: 0,0:07:28.60,0:07:30.70,Flashbacks,,0,0,0,,Raizo nerede?!
Dialogue: 0,0:07:31.21,0:07:32.84,Flashbacks,,0,0,0,,Raizo'yu verin!
Dialogue: 0,0:07:33.26,0:07:35.26,Flashbacks,,0,0,0,,Raizo'nun bu ülkede olduğunu biliyorum!
Dialogue: 0,0:07:36.66,0:07:39.68,Flashbacks,,0,0,0,,Burada öyle biri yok! \NSana daha kaç kere söyleyeceğim?!
Dialogue: 0,0:07:39.68,0:07:44.40,Flashbacks,,0,0,0,,Ülkeyi istediğiniz kadar arayın!\NSamuraydan falan haberimiz...
Dialogue: 0,0:07:48.88,0:07:56.16,Flashbacks,,0,0,0,,Acaba ben bacağını uçurmadan önce \Nsamurayın yerini söyleyecek misin?
Dialogue: 0,0:07:59.21,0:08:03.04,Flashbacks,,0,0,0,,Deneyip görelim Köpek Kral!
Dialogue: 0,0:08:11.38,0:08:16.74,Flashbacks,,0,0,0,,Öyleyse bu bacağı kurtarmamın\Nbir yolu yok demektir.
Dialogue: 0,0:08:20.02,0:08:25.10,Main,,0,0,0,,Sen-gara'nın da eli kesilmiş.\NArtık savaşamazsın.
Dialogue: 0,0:08:25.10,0:08:28.08,Main,,0,0,0,,Tek yapabileceğin lazanya yemek.
Dialogue: 0,0:08:29.34,0:08:31.82,Flashbacks,,0,0,0,,Konuş! Samuray nerede?!
Dialogue: 0,0:08:32.88,0:08:35.25,Flashbacks,,0,0,0,,Burada olmayan birinin yerini\Nsana nasıl söyleyeyim?!
Dialogue: 0,0:08:35.25,0:08:38.49,Flashbacks,,0,0,0,,Wano Krallığı'ndan birinin\Nburada ne işi olur?!
Dialogue: 0,0:08:39.00,0:08:43.76,Flashbacks,,0,0,0,,Elinizden insanları gazlayıp zayıf düşmüş\Nsavaşçılara saldırmaktan iyisi gelmiyor mu?!
Dialogue: 0,0:08:43.76,0:08:46.30,Flashbacks,,0,0,0,,Ödlek mahluklar!
Dialogue: 0,0:08:47.46,0:08:50.96,Flashbacks,,0,0,0,,Zincirlerinı kırmaya çalışıyor!
Dialogue: 0,0:08:51.52,0:08:54.47,Flashbacks,,0,0,0,,Ne işe yaramaz gazmış bu!\NKollarını tutun!
Dialogue: 0,0:08:54.47,0:08:57.36,Flashbacks,,0,0,0,,Ha şöyle!
Dialogue: 0,0:08:58.18,0:09:03.28,Flashbacks,,0,0,0,,Çok boş zamanınız varsa mızraklarınızı\Nhalkıma değil bana doğrultun!
Dialogue: 0,0:09:03.62,0:09:05.58,Flashbacks,,0,0,0,,Olamaz... Efendi!
Dialogue: 0,0:09:05.58,0:09:10.36,Flashbacks,,0,0,0,,O dandik mızraklarınıza\Nben yeterim de artarım bile!
Dialogue: 0,0:09:11.62,0:09:13.58,Flashbacks,,0,0,0,,Efendi!
Dialogue: 0,0:09:19.80,0:09:24.28,Main,,0,0,0,,Yalnızca tek bacağını yitirmen çok yazık!
Dialogue: 0,0:09:24.28,0:09:27.62,Main,,0,0,0,,Ölüp gitseydin ne hoş olurdu!
Dialogue: 0,0:09:27.62,0:09:30.46,Main,,0,0,0,,Ölüp gitseydin ne hoş olurdu!
Dialogue: 0,0:09:30.82,0:09:32.54,Main,,0,0,0,,İkiniz de durun lütfen!
Dialogue: 0,0:09:33.86,0:09:37.13,Main,,0,0,0,,Öyleyse krallardan birini\Nhemen öteki tarafa yollayalım!
Dialogue: 0,0:09:39.20,0:09:41.38,Main,,0,0,0,,Öleceksin-gara!
Dialogue: 0,0:09:42.12,0:09:43.56,Main,,0,0,0,,Köpekle kedi mi?!
Dialogue: 0,0:09:43.56,0:09:44.42,Main,,0,0,0,,Kime diyoruz!
Dialogue: 0,0:09:53.88,0:09:57.24,Main,,0,0,0,,Güçlü olduklarını duymuştum\Nama vay canına!
Dialogue: 0,0:09:58.70,0:10:00.10,Main,,0,0,0,,Hey, bekle!
Dialogue: 0,0:10:01.56,0:10:03.74,Main,,0,0,0,,Savaşı kesin!
Dialogue: 0,0:10:05.34,0:10:07.54,Main,,0,0,0,,Aptal mısın sen?! Niye bağırıyorsun?!
Dialogue: 0,0:10:08.34,0:10:09.44,Main,,0,0,0,,Samuray...
Dialogue: 0,0:10:11.74,0:10:13.26,Main,,0,0,0,,...bu!
Dialogue: 0,0:10:18.12,0:10:20.06,Main,,0,0,0,,Al işte, gördüler seni!
Dialogue: 0,0:10:20.06,0:10:23.31,Main,,0,0,0,,Kaç Kin'emon, öldürecekler seni!
Dialogue: 0,0:10:24.73,0:10:25.70,Main,,0,0,0,,Momo-chan!
Dialogue: 0,0:10:25.70,0:10:27.74,Main,,0,0,0,,Hey, bırakın beni! Lütfen!
Dialogue: 0,0:10:29.00,0:10:30.26,Main,,0,0,0,,Ne yapmaya çalışıyorsun?!
Dialogue: 0,0:10:30.86,0:10:32.72,Main,,0,0,0,,Momo, yaklaşma!
Dialogue: 0,0:10:32.72,0:10:35.72,Main,,0,0,0,,Kanjuro, niye ortaya çıktınız?!
Dialogue: 0,0:10:35.72,0:10:37.24,Main,,0,0,0,,Kaçın! Hemen!
Dialogue: 0,0:10:40.90,0:10:43.84,Main,,0,0,0,,Nekomamushi, Inuarashi...\NDurun biraz!
Dialogue: 0,0:10:43.84,0:10:46.29,Main,,0,0,0,,Kötü bir niyetleri yok!
Dialogue: 0,0:10:49.90,0:10:52.35,Main,,0,0,0,,Zou halkı!
Dialogue: 0,0:10:52.35,0:10:57.72,Main,,0,0,0,,Bendeniz Wano Krallığı\NKozuki Klanı'nın uşağı Kin'emon'um!
Dialogue: 0,0:10:59.15,0:11:03.00,Main,,0,0,0,,Aynı ülkeden olan Raizo isimli\Nsavaşçı dostumu aramaya geldim!
Dialogue: 0,0:11:03.32,0:11:05.38,Main,,0,0,0,,Bu ülkeye geldi mi?
Dialogue: 0,0:11:05.38,0:11:09.09,Main,,0,0,0,,Burada olmadığı için\Nülkeyi yerlebir ettiler be!
Dialogue: 0,0:11:09.09,0:11:10.04,Main,,0,0,0,,Luffy!
Dialogue: 0,0:11:10.04,0:11:11.02,Main,,0,0,0,,Evet...
Dialogue: 0,0:11:27.08,0:11:29.14,Main,,0,0,0,,Sizi bekliyorduk.
Dialogue: 0,0:11:31.16,0:11:34.70,Flashbacks,,0,0,0,,Tanrı şahidim olsun ki\NRaizo adında birini bilmiyorum!
Dialogue: 0,0:11:39.72,0:11:44.89,Flashbacks,,0,0,0,,Aradığınız kişi burada çıkarsa\Ncanımı alabilirsiniz!
Dialogue: 0,0:11:48.32,0:11:50.16,Main,,0,0,0,,Raizo-dono...
Dialogue: 0,0:11:51.02,0:11:52.54,Main,,0,0,0,,...güvende!
Dialogue: 0,0:12:08.34,0:12:11.46,Main,,0,0,0,,İyi ha! Şükürler olsun!
Dialogue: 0,0:12:19.06,0:12:20.16,Main,,0,0,0,,Lan ne oluyor?!
Dialogue: 0,0:12:21.04,0:12:24.53,Main,,0,0,0,,Raizo bunca zamandır burada mıydı yani?!
Dialogue: 0,0:12:24.53,0:12:26.55,Main,,0,0,0,,Hepiniz biliyor muydunuz?!
Dialogue: 0,0:12:33.35,0:12:40.10,Main,,0,0,0,,N-N-N- Neredeyse ölüyordunuz be!
Dialogue: 0,0:12:40.46,0:12:44.02,Main,,0,0,0,,Bin yıllık şehir mahvoldu be!
Dialogue: 0,0:12:51.78,0:12:55.36,Main,,0,0,0,,Siz-gara'dan da\Nsakladığımız için bağışlayın bizi.
Dialogue: 0,0:12:56.00,0:13:02.44,Main,,0,0,0,,Wano Krallığı'nın Kozuki Klanı'yla biz \Nçok uzun zamandır aile gibiyizdir.
Dialogue: 0,0:13:04.78,0:13:09.92,Main,,0,0,0,,Ölürüz de dostlarımızı satmayız!
Dialogue: 0,0:13:31.70,0:13:32.42,Main,,0,0,0,,Bana bakın!
Dialogue: 0,0:13:32.42,0:13:32.83,Main,,0,0,0,,Emredin!
Dialogue: 0,0:13:33.96,0:13:37.00,Main,,0,0,0,,Oradan nasıl görünüyor?\NÖlmüş müyüm?
Dialogue: 0,0:13:37.34,0:13:39.58,Main,,0,0,0,,Ha-Hayır!\NKesinlikle doğru değil!
Dialogue: 0,0:13:39.58,0:13:41.84,Main,,0,0,0,,Yaşıyorsunuz Jack-sama!
Dialogue: 0,0:13:53.62,0:13:56.54,Main,,0,0,0,,Hepinize müteşekkirim!
Dialogue: 0,0:14:00.56,0:14:03.50,Main,,0,0,0,,Söylediklerimin delili de budur!
Dialogue: 0,0:14:11.64,0:14:17.46,Main,,0,0,0,,Dük-sama'da, Efendi'de ve \NRaizo-san'da da olan Kozuki klanı sembolü!
Dialogue: 0,0:14:21.60,0:14:22.94,Main,,0,0,0,,Kozuki...
Dialogue: 0,0:14:23.26,0:14:26.24,Main,,0,0,0,,Tanışıyorlarmış ha!
Dialogue: 0,0:14:28.58,0:14:32.72,Main,,0,0,0,,Ciddi ciddi Minklerle dövüşmeye\Nhazırlanıyordum! Korkutmayın böyle!
Dialogue: 0,0:14:32.72,0:14:37.77,Main,,0,0,0,,Yapacak bir şey yok. \NSonuçta durumu bize bile açıklayamazlardı.
Dialogue: 0,0:14:38.40,0:14:42.77,Main,,0,0,0,,Köpekçik ve kediciğin de\Naynı işarete sahip olduğunu söyledi.
Dialogue: 0,0:14:43.44,0:14:47.65,Main,,0,0,0,,Aralarındaki bağ muhtemelen bizim\Ndüşündüğümüzden daha derin.
Dialogue: 0,0:14:47.65,0:14:51.38,Main,,0,0,0,,Fakat Inuarashi, Nekomamushi...
Dialogue: 0,0:14:53.84,0:14:58.00,Main,,0,0,0,,...sizi sağ salim\Nburada gördüğüme çok şaşırdım!
Dialogue: 0,0:14:58.00,0:14:59.81,Main,,0,0,0,,Ölsek büyük dertten kurtulurduk belki.
Dialogue: 0,0:14:59.81,0:15:02.93,Main,,0,0,0,,Ama o gün söylediklerinize\Ngüvenip burada beklersek...
Dialogue: 0,0:15:02.93,0:15:07.92,Main,,0,0,0,,Evet, günün birinde ne olursa olsun\Nsizi yeniden görebileceğimizi düşündük!
Dialogue: 0,0:15:07.92,0:15:09.05,Main,,0,0,0,,Bana bak canavar kedi!
Dialogue: 0,0:15:09.68,0:15:12.64,Main,,0,0,0,,Kin'emon'la ben konuşuyorum!
Dialogue: 0,0:15:13.26,0:15:14.97,Main,,0,0,0,,Sözümü kesme!
Dialogue: 0,0:15:16.24,0:15:22.00,Main,,0,0,0,,Kin'emon'un seninle konuşmaktan\Nmidesi kalkmıştır diye düşünüp...
Dialogue: 0,0:15:22.00,0:15:24.77,Main,,0,0,0,,...çaktırmadan araya girdim!
Dialogue: 0,0:15:24.77,0:15:27.40,Main,,0,0,0,,Sakinleştiler sanmıştım.
Dialogue: 0,0:15:27.40,0:15:28.07,Main,,0,0,0,,Peh...
Dialogue: 0,0:15:28.46,0:15:30.76,Main,,0,0,0,,Sen-gara'nın yapacak \Nbaşka bir şeyi kalmadı! Kaybol!
Dialogue: 0,0:15:30.76,0:15:32.32,Main,,0,0,0,,Asıl sen kaybol!
Dialogue: 0,0:15:32.32,0:15:36.68,Main,,0,0,0,,Durun lütfen! Uzun zamandır\Nbeklediğimiz misafirlerimiz geldiler!
Dialogue: 0,0:15:40.64,0:15:44.13,Main,,0,0,0,,Kavgaya son verin Inuarashi, Nekomamushi!
Dialogue: 0,0:15:47.64,0:15:53.99,Main,,0,0,0,,İkiniz ne iyi anlaşırdınız! Şimdi niye birbirinizin canına kast edercesine savaşıyorsunuz?!
Dialogue: 0,0:15:53.99,0:15:54.76,Main,,0,0,0,,Çünkü...
Dialogue: 0,0:15:54.76,0:15:57.32,Main,,0,0,0,,Bir daha kavga etmenizi yasaklıyorum!
Dialogue: 0,0:15:57.32,0:16:00.41,Main,,0,0,0,,Hele babam yüzündense\Ndaha bir yasaklıyorum!
Dialogue: 0,0:16:00.41,0:16:04.60,Main,,0,0,0,,İkinizi böyle görse babam çok üzülürdü.
Dialogue: 0,0:16:07.68,0:16:09.56,Main,,0,0,0,,Oden-sama...
Dialogue: 0,0:16:16.72,0:16:17.96,Main,,0,0,0,,Momo?
Dialogue: 0,0:16:18.58,0:16:21.31,Main,,0,0,0,,Babam üzülürdü mü dedin?
Dialogue: 0,0:16:21.31,0:16:23.29,Main,,0,0,0,,Kin'emon yanında duruyor yahu.
Dialogue: 0,0:16:24.08,0:16:25.88,Main,,0,0,0,,Bağışlayın!
Dialogue: 0,0:16:25.88,0:16:30.92,Main,,0,0,0,,Momonosuke-sama! Çok haklısınız!\NKendimden utanıyorum!
Dialogue: 0,0:16:32.02,0:16:33.12,Main,,0,0,0,,Ne?!
Dialogue: 0,0:16:33.12,0:16:34.09,Main,,0,0,0,,Dük-sama!
Dialogue: 0,0:16:34.40,0:16:37.64,Main,,0,0,0,,Efendi başkasının önünde diz çöktü!
Dialogue: 0,0:16:40.22,0:16:41.80,Main,,0,0,0,,Yoksa bu çocuk...
Dialogue: 0,0:16:47.32,0:16:49.90,Main,,0,0,0,,Momonosuke-sama çok haklı!
Dialogue: 0,0:16:51.44,0:16:55.00,Main,,0,0,0,,Size de yalan söylediğim için bağışlayın!
Dialogue: 0,0:16:56.38,0:16:59.37,Main,,0,0,0,,İşin aslı Momonosuke-sama'yla...
Dialogue: 0,0:16:59.37,0:17:01.20,Main,,0,0,0,,...baba oğul değiliz!
Dialogue: 0,0:17:03.90,0:17:06.37,Main,,0,0,0,,Ne?!
Dialogue: 0,0:17:11.40,0:17:14.07,Main,,0,0,0,,Burada gördüğünüz adam\NWano Krallığı'ndaki...
Dialogue: 0,0:17:14.07,0:17:18.54,Main,,0,0,600,,...Kuri'nin yüce daimyosu\NKozuki Oden-sama'nın varisi...
Dialogue: 0,0:17:15.62,0:17:20.18,Captions,,0,0,320,,{\fad(500,500)}Wano Ülkesi\NKuri Daimyo'sunun Varisi\NKozuki Momonosuke
Dialogue: 0,0:17:18.86,0:17:21.40,Main,,0,0,3,,...Kozuki Momonosuke-sama'dır!
Dialogue: 0,0:17:25.56,0:17:29.02,Main,,0,0,0,,Özetle Inuarashi ve Nekomamushi de dahil...
Dialogue: 0,0:17:29.02,0:17:31.36,Main,,0,0,0,,...buradaki herkesin lordudur.
Dialogue: 0,0:17:31.36,0:17:35.26,Main,,0,0,0,,Kozuki Ailesi'nin varisi,\NOden-dono'nun oğlu ha!?
Dialogue: 0,0:17:35.26,0:17:37.57,Main,,0,0,0,,Nasıl gözümden kaçtı?!
Dialogue: 0,0:17:37.57,0:17:40.14,Main,,0,0,0,,Ne? Momo önemli biriymiş ha?
Dialogue: 0,0:17:40.48,0:17:46.00,Main,,0,0,0,,Uşaklarının onlar olduğunu düşünürsek\Nçok büyük bir lord olduğunu söyleyebiliriz.
Dialogue: 0,0:17:46.00,0:17:48.75,Main,,0,0,0,,Buraya yolculuğumuz sırasında\Ngerçek kimliği ortaya çıkarsa...
Dialogue: 0,0:17:48.80,0:17:51.66,Main,,0,0,0,,...daha fazla düşmanı\Nüzerimize çekeceğimizi düşünüp...
Dialogue: 0,0:17:51.96,0:17:55.36,Main,,0,0,0,,...Momonosuke-sama'yla\Nbaba oğul gibi davrandık.
Dialogue: 0,0:17:56.30,0:18:01.01,Main,,0,0,0,,Size güvenmesine güvendik fakat\Ndoğruları söyleyecek fırsat olmadı.
Dialogue: 0,0:18:01.01,0:18:01.81,Main,,0,0,0,,Bağışlayın.
Dialogue: 0,0:18:05.66,0:18:08.06,Main,,0,0,0,,Baba oğul değilsiniz ha.
Dialogue: 0,0:18:08.06,0:18:10.40,Main,,0,0,0,,Birbirlerine benziyorlar. İkisi de sapık.
Dialogue: 0,0:18:14.98,0:18:19.16,Main,,0,0,0,,Yalan söylediğim için özür dilerim.\NAslında çok saygın biriyim!
Dialogue: 0,0:18:19.58,0:18:21.27,Main,,0,0,0,,Evet, saygın bir sapıksın.
Dialogue: 0,0:18:21.27,0:18:22.12,Main,,0,0,0,,Sadece saygın!
Dialogue: 0,0:18:22.62,0:18:24.27,Main,,0,0,0,,Neyse ne artık!
Dialogue: 0,0:18:24.27,0:18:28.41,Main,,0,0,0,,Ne demek neyse ne?!\NÖnümde eğileceksiniz, Luffy!
Dialogue: 0,0:18:28.41,0:18:29.78,Main,,0,0,0,,Çok beklersin!
Dialogue: 0,0:18:29.78,0:18:34.71,Main,,0,0,0,,Sırf önemli birisin diye sana davranış şeklimizi değiştirecek değiliz, aptal!
Dialogue: 0,0:18:34.71,0:18:36.65,Main,,0,0,0,,M-Momonosuke-sama!
Dialogue: 0,0:18:37.44,0:18:40.68,Main,,0,0,0,,Yüksekten bile korkan\Nödlek veledin tekisin be!
Dialogue: 0,0:18:40.68,0:18:43.70,Main,,0,0,0,,Biz samuraylar hiçbir şeyden korkmayız! \NKüstah seni!
Dialogue: 0,0:18:45.78,0:18:49.81,Main,,0,0,0,,Gene başlıyoruz.\NHayatımızı ona borçluyuz tamam da...
Dialogue: 0,0:18:49.81,0:18:53.44,Main,,0,0,0,,Korsandan alçakgönüllü olmasını bekleyemezsin.
Dialogue: 0,0:18:53.44,0:18:56.00,Main,,0,0,0,,Kafasını dağıtacak bir şeyleri oluyor işte, ne ala.
Dialogue: 0,0:19:00.64,0:19:04.65,Main,,0,0,0,,Öf be Onami! \NLuffy çok kötü biri!
Dialogue: 0,0:19:04.65,0:19:06.33,Main,,0,0,0,,Geçti geçti.
Dialogue: 0,0:19:07.02,0:19:10.82,Main,,0,0,0,,Uzaklaş ondan Momonosuke-sama,\Nseni boklu velet!
Dialogue: 0,0:19:10.82,0:19:11.50,Main,,0,0,0,,Hey!
Dialogue: 0,0:19:15.00,0:19:17.08,Main,,0,0,0,,Baksana Momo-chan...
Dialogue: 0,0:19:17.08,0:19:21.77,Main,,0,0,0,,...baban koskoca lordsa eminim\Nkalesinde hazinesi de vardır.
Dialogue: 0,0:19:21.77,0:19:23.00,Main,,0,0,0,,Kes şunu!
Dialogue: 0,0:19:23.00,0:19:25.36,Main,,0,0,0,,Ne korkunç bir insansın sen ya!
Dialogue: 0,0:19:25.92,0:19:29.52,Main,,0,0,0,,Daha birkaç ay oldu...
Dialogue: 0,0:19:32.68,0:19:36.64,Main,,0,0,0,,Onların-gara neşesi ona da yardımcı oluyor.
Dialogue: 0,0:19:51.04,0:19:52.88,Main,,0,0,0,,Ateşkes ilan edelim, kedi.
Dialogue: 0,0:19:52.88,0:19:57.06,Main,,0,0,0,,Geçmişe kısılıp kalırsak\NMomonosuke-sama'yı üzeriz.
Dialogue: 0,0:20:01.58,0:20:03.37,Main,,0,0,0,,Lordumuz için, öyle olsun.
Dialogue: 0,0:20:03.37,0:20:07.51,Main,,0,0,0,,Seninle konuşacak ama\Nkalben bağlanmayacağım.
Dialogue: 0,0:20:08.48,0:20:10.14,Main,,0,0,0,,Anlaştık öyleyse!
Dialogue: 0,0:20:16.54,0:20:18.19,Main,,0,0,0,,Şuna bakın!
Dialogue: 0,0:20:18.19,0:20:20.82,Main,,0,0,0,,O ikisi... Mümkün değil!
Dialogue: 0,0:20:24.84,0:20:26.24,Main,,0,0,0,,Mucize!
Dialogue: 0,0:20:26.24,0:20:28.62,Main,,0,0,0,,Krallarımız barıştı!
Dialogue: 0,0:20:28.98,0:20:31.93,Main,,0,0,0,,Gündüz Kralı'yle Gece Kralı sonunda...
Dialogue: 0,0:20:31.93,0:20:34.34,Main,,0,0,0,,Kozuki Ailesi'nin kudreti ne büyük!
Dialogue: 0,0:20:42.34,0:20:43.62,Main,,0,0,0,,Gözlerim yaşardı!
Dialogue: 0,0:20:43.62,0:20:45.76,Main,,0,0,0,,Miyagi-sensei, yerinizde duramıyorsunuz!
Dialogue: 0,0:21:04.18,0:21:06.37,Main,,0,0,0,,Balina'ya tırmanacağız.
Dialogue: 0,0:21:06.37,0:21:11.01,Main,,0,0,0,,Hangi dallara tutunacağını bilirsen\Nzirveye kadar çıkabilirsin.
Dialogue: 0,0:21:11.01,0:21:13.25,Main,,0,0,0,,Raizo orada ha?!
Dialogue: 0,0:21:18.92,0:21:20.22,Main,,0,0,0,,Nin-nin!
Dialogue: 0,0:21:20.22,0:21:21.48,Main,,0,0,0,,Nin-nin!
Dialogue: 0,0:21:21.48,0:21:22.75,Main,,0,0,0,,Nin-nin!
Dialogue: 0,0:21:22.75,0:21:24.02,Main,,0,0,0,,Nin-nin!
Dialogue: 0,0:21:24.02,0:21:25.22,Main,,0,0,0,,Nin-nin!
Dialogue: 0,0:21:25.22,0:21:26.37,Main,,0,0,0,,Nin-nin!
Dialogue: 0,0:21:26.37,0:21:27.58,Main,,0,0,0,,Nin-nin!
Dialogue: 0,0:21:27.58,0:21:28.88,Main,,0,0,0,,Nin-nin!
Dialogue: 0,0:21:28.88,0:21:31.56,Main,,0,0,0,,Ninjayı görmeyi \Nresmen dört gözle bekliyorum! Nin-nin!
Dialogue: 0,0:21:31.88,0:21:34.10,Main,,0,0,0,,Ninjayı göreceğim! Nin-nin!
Dialogue: 0,0:21:34.10,0:21:36.60,Main,,0,0,0,,Su Tekniği! Nin-nin!
Dialogue: 0,0:21:38.94,0:21:42.25,Main,,0,0,0,,Kendimi pek iyi hissetmiyorum, Kin'emon.
Dialogue: 0,0:21:42.25,0:21:45.65,Main,,0,0,0,,İsterseniz aşağıda bekleyebilirsiniz\NMomonosuke-sama.
Dialogue: 0,0:21:48.85,0:21:53.40,Main,,0,0,0,,Balina'ya yaklaştıkça ses artıyor.
Dialogue: 0,0:21:57.12,0:22:00.56,Main,,0,0,0,,Oden-sama'nınkine benzer\Nbir güce sahipsiniz.
Dialogue: 0,0:22:01.63,0:22:06.00,Main,,0,0,0,,Benzer şeyleri söyleyen\Nbaşka bir adam daha vardı.
Dialogue: 0,0:22:06.58,0:22:09.86,Main,,0,0,0,,Benim de aklıma o geldi.
Dialogue: 0,0:22:17.16,0:22:20.42,Main,,0,0,0,,Giriş böyle bir yerdeymiş ha?!
Dialogue: 0,0:22:21.78,0:22:25.38,Main,,0,0,0,,Balina Ağacı'nın kuyruğunda...\NKimsenin aklına gelmez!
Dialogue: 0,0:22:25.38,0:22:29.20,Main,,0,0,0,,Üstüne üstlük gizli bir kapı.\NBulunması imkansız.
Dialogue: 0,0:22:29.20,0:22:30.16,Main,,0,0,0,,Gidelim.
Dialogue: 0,0:22:34.60,0:22:37.70,Main,,0,0,0,,Merdivenler epey sürüyor, dikkatli olun.
Dialogue: 0,0:22:49.08,0:22:50.12,Main,,0,0,0,,Bu...
Dialogue: 0,0:22:50.12,0:22:52.07,Main,,0,0,0,,Raizo'nun sesi.
Dialogue: 0,0:22:52.07,0:22:53.81,Main,,0,0,0,,Ne?! Ninjanın mı?!
Dialogue: 0,0:22:53.81,0:22:55.14,Main,,0,0,0,,Ninja!
Dialogue: 0,0:22:56.35,0:22:57.94,Main,,0,0,0,,Ninja!
Dialogue: 0,0:23:03.05,0:23:04.36,Main,,0,0,0,,Ninja nerede?!
Dialogue: 0,0:23:04.36,0:23:05.70,Main,,0,0,0,,Ninja! Ninja!
Dialogue: 0,0:23:05.70,0:23:06.61,Main,,0,0,0,,Geldik.
Dialogue: 0,0:23:06.61,0:23:09.82,Main,,0,0,0,,O kişi-gara ninja Raizo.
Dialogue: 0,0:23:09.82,0:23:11.65,Main,,0,0,0,,Ninja! Nin...
Dialogue: 0,0:23:15.16,0:23:17.26,Main,,0,0,0,,Geldin sonunda Nekomamushi!
Dialogue: 0,0:23:18.14,0:23:23.00,Main,,0,0,3,,Beni onlara neden vermediniz?!
Dialogue: 0,0:23:19.49,0:23:25.81,Captions,,0,0,270,,{\fad(700,700)}Wano Ülkesinden Bir Ninja\NSis Raizo
Dialogue: 0,0:23:23.00,0:23:26.40,Main,,0,0,3,,Bana yemek getiren herkes...
Dialogue: 0,0:23:26.40,0:23:28.30,Main,,0,0,0,,...yaralıydı
Dialogue: 0,0:23:28.78,0:23:32.67,Main,,0,0,0,,Ülkenin durumunun iyi olduğunu\Nsöylediler ama doğru mu bu?!
Dialogue: 0,0:23:32.67,0:23:37.76,Main,,0,0,0,,Eğer yalansa ben, Raizo,\Nsenden ölümüne nefret ederim!
Dialogue: 0,0:23:47.58,0:23:49.29,Main,,0,0,0,,Ne?!
Dialogue: 0,0:23:49.29,0:23:52.53,Main,,0,0,0,,Ne umduk ne bulduk resmen!
Dialogue: 0,0:23:52.53,0:23:57.12,Main,,0,0,0,,Siz bu ülkeden değilsiniz sanırım!\NNeyin nesisiniz?!
Dialogue: 0,0:24:00.22,0:24:01.37,Main,,0,0,0,,Raizo!
Dialogue: 0,0:24:03.02,0:24:07.63,Main,,0,0,0,,Kin'emon! Kanjuro! Momonosuke-sama!
Dialogue: 0,0:24:07.63,0:24:09.34,Main,,0,0,0,,Şükürler olsun ki iyisiniz!
Dialogue: 0,0:24:09.34,0:24:10.55,Main,,0,0,0,,Biz de seni iyi gördüğümüze sevindik!
Dialogue: 0,0:24:11.00,0:24:11.90,Main,,0,0,0,,Bu...
Dialogue: 0,0:24:18.90,0:24:20.62,Main,,0,0,0,,Kozuki Ailesi'nin arması!
Dialogue: 0,0:24:25.36,0:24:27.06,Main,,0,0,0,,Kin'emon'unkiyle aynı!
Dialogue: 0,0:24:27.78,0:24:31.86,Main,,0,0,0,,Bu arma asırlardır var olan bir şey.
Dialogue: 0,0:24:33.78,0:24:36.20,Main,,0,0,0,,Ve şu taş...
Dialogue: 0,0:24:36.76,0:24:39.66,Main,,0,0,0,,...daha önce hiç görmediğim\Nbir renkte, ateş kırmızısı!
Dialogue: 0,0:24:42.40,0:24:45.37,Main,,0,0,0,,Evet, Ponegliff o.
Dialogue: 0,0:24:47.31,0:24:50.90,Main,,0,0,0,,Sen-gara'yı biliyoruz, Nico Robin.
Dialogue: 0,0:24:53.16,0:24:56.59,Main,,0,0,0,,Oharalıların bu harfleri okuyabildiğini duydum.
Dialogue: 0,0:24:59.28,0:25:02.58,Main,,0,0,0,,O Ponegliff niye kırmızı?
Dialogue: 0,0:25:04.42,0:25:08.40,Main,,0,0,0,,Bugüne dek gördüğüm\Nhiçbir Ponegliff öyle değildi.
Dialogue: 0,0:25:10.30,0:25:12.16,Main,,0,0,0,,Farklı bir amaca hizmet ettiği için öyle.
Dialogue: 0,0:25:15.10,0:25:16.57,Main,,0,0,0,,Okuyabiliyor musun?
Dialogue: 0,0:25:16.96,0:25:19.60,Main,,0,0,0,,Evet, okuyabilir miyim?
Dialogue: 0,0:25:19.60,0:25:21.10,Main,,0,0,0,,Elbette.
Dialogue: 0,0:25:21.10,0:25:25.92,Main,,0,0,0,,Siz ne ayaksınız? \NDeminden beri bön bön niye bakıyorsunuz?
Dialogue: 0,0:25:26.88,0:25:29.10,Main,,0,0,0,,Cidden ninja mısın sen?
Dialogue: 0,0:25:29.10,0:25:31.38,Main,,0,0,0,,Terbiyesize bak!\NKim olduğunu sanıyorsun sen?!
Dialogue: 0,0:25:31.38,0:25:33.46,Main,,0,0,0,,Sahi ya daha tanıştırmamıştık sizi.
Dialogue: 0,0:25:33.92,0:25:38.76,Main,,0,0,0,,Raizo, onlar Hasır Şapka tayfası.\NKorsanlar.
Dialogue: 0,0:25:38.76,0:25:39.55,Main,,0,0,0,,Korsan mı?!
Dialogue: 0,0:25:40.14,0:25:44.22,Main,,0,0,0,,Gerçek bir ninjaysan\Nshuriken fırlat da görelim!
Dialogue: 0,0:25:44.56,0:25:46.62,Main,,0,0,0,,Şelale altında meditasyon yap!
Dialogue: 0,0:25:47.70,0:25:49.94,Main,,0,0,0,,Nin deyip ninpou göster bize!
Dialogue: 0,0:25:51.20,0:25:53.18,Main,,0,0,0,,Toprak Kaçış Tekniği'ni görmek istiyorum!
Dialogue: 0,0:25:53.18,0:25:54.94,Main,,0,0,0,,Ben ateşlisini görmek istiyorum!
Dialogue: 0,0:25:54.94,0:25:56.45,Main,,0,0,0,,Ben sulu olanı!
Dialogue: 0,0:25:56.45,0:25:58.34,Main,,0,0,0,,Az durun da motorunuz soğusun!
Dialogue: 0,0:25:59.18,0:26:01.98,Main,,0,0,0,,Siz korsanlar bunu niye bu kadar\Nçok görmek istiyorsunuz ki?!
Dialogue: 0,0:26:01.98,0:26:04.48,Main,,0,0,0,,Korsan olduğumuz için değil.
Dialogue: 0,0:26:06.88,0:26:08.72,Main,,0,0,0,,Süper!
Dialogue: 0,0:26:09.63,0:26:13.76,Main,,0,0,0,,Tüm erkekler ninjaları sever!
Dialogue: 0,0:26:21.10,0:26:23.72,Main,,0,0,0,,Utandırıyorsunuz beni.
Dialogue: 0,0:26:25.88,0:26:29.56,Main,,0,0,0,,Hiç ninja sevgilin oldu mu?!
Dialogue: 0,0:26:30.40,0:26:33.68,Main,,0,0,0,,Daha yükseğe zıplayabilmek için\Nher gün ninja sırıklarının üstünden atla!
Dialogue: 0,0:26:34.44,0:26:36.56,Main,,0,0,0,,Gölge Klon Tekniğini göster.
Dialogue: 0,0:26:37.86,0:26:41.32,Main,,0,0,0,,Tavana gizlenip mızrakların hedefi ol.
Dialogue: 0,0:26:41.32,0:26:43.87,Main,,0,0,0,,Kocaman bir kurbağa çağır!
Dialogue: 0,0:26:43.87,0:26:46.70,Main,,0,0,0,,Ağzında bir parça parşömenle\N"Nin-nin" de!
Dialogue: 0,0:26:46.70,0:26:48.78,Main,,0,0,0,,Kesin be!
Dialogue: 0,0:26:49.10,0:26:51.76,Main,,0,0,0,,Tatlı hayallerinizi bana yükleyip durmayın!
Dialogue: 0,0:26:53.78,0:26:59.59,Main,,0,0,0,,Biz ninjalar "Nin-nin" demeyiz!\NSizin bildiğiniz ninja düşten ibaret!
Dialogue: 0,0:26:59.59,0:27:02.28,Main,,0,0,0,,Ne?!
Dialogue: 0,0:27:03.18,0:27:07.10,Main,,0,0,0,,E bu halinle nasıl ninja\Nolabiliyorsun o zaman sen?!
Dialogue: 0,0:27:08.32,0:27:14.08,Main,,0,0,0,,Evet, bu halimle kadın ninjaların\Nilgisini dahi çekemiyorum...
Dialogue: 0,0:27:14.08,0:27:15.98,Main,,0,0,0,,O yüzden beni rahat bırakın!
Dialogue: 0,0:27:18.20,0:27:23.78,Main,,0,0,0,,Bana bakın! Shinobi* olmak için güçlü ve\Nsakin bir zihne ihtiyacınız vardır!
Dialogue: 0,0:27:23.78,0:27:27.90,Main,,0,0,0,,Gölgelerde yaşayan bizler her önüne\Ngelene ninja tekniklerimizi göstermeyiz!
Dialogue: 0,0:27:27.90,0:27:30.04,Main,,0,0,0,,Ninjutsu oyuncak değildir...
Dialogue: 0,0:27:50.70,0:27:52.88,Main,,0,0,0,,{\fad(150,150)}Ninpo: Enton no Jutsu!
Dialogue: 0,0:27:50.70,0:27:52.88,Attack,,0,0,0,,{\fad(150,150)}Ninpo: Duman Kaçışı Tekniği!
Dialogue: 0,0:27:58.23,0:28:00.46,Main,,0,0,0,,Kay... Kayboldu!
Dialogue: 0,0:28:01.70,0:28:03.88,Main,,0,0,0,,{\i1}Kaybolmadım!
Dialogue: 0,0:28:07.74,0:28:08.95,Main,,0,0,0,,Buradayım.
Dialogue: 0,0:28:08.95,0:28:10.20,Main,,0,0,0,,O-Oha!
Dialogue: 0,0:28:14.46,0:28:15.60,Main,,0,0,0,,Ve burada!
Dialogue: 0,0:28:16.12,0:28:16.92,Main,,0,0,0,,Burada da!
Dialogue: 0,0:28:17.44,0:28:18.88,Main,,0,0,0,,Ve de burada!
Dialogue: 0,0:28:18.88,0:28:21.41,Main,,0,0,0,,Yok artık, kaç tane oldu!
Dialogue: 0,0:28:21.41,0:28:22.80,Main,,0,0,0,,Yoksa bu...
Dialogue: 0,0:28:24.30,0:28:27.34,Main,,0,0,0,,{\fad(150,150)}Ninpo: Bunshin no Jutsu!
Dialogue: 0,0:28:24.30,0:28:27.34,Attack,,0,0,0,,{\fad(150,150)}Ninpo: Gölge Klon Tekniği!
Dialogue: 0,0:28:27.34,0:28:29.22,Main,,0,0,0,,Harika!
Dialogue: 0,0:28:31.38,0:28:33.38,Main,,0,0,0,,Nasıl ninjasın sen diye soruyordunuz!
Dialogue: 0,0:28:34.18,0:28:36.24,Main,,0,0,0,,{\fad(150,150)}Hana Shuriken!
Dialogue: 0,0:28:34.18,0:28:36.24,Attack,,0,0,0,,{\fad(150,150)}Çiçek Shurikenleri
Dialogue: 0,0:28:36.60,0:28:38.11,Note,,0,0,0,,Shinobi
Dialogue: 0,0:28:47.45,0:28:50.87,Main,,0,0,0,,Kızların yan gözle bakmadığı,\Nyanmaz yenilmez ninja!
Dialogue: 0,0:28:52.64,0:28:57.12,Main,,0,0,0,,"Sis" Raizo...
Dialogue: 0,0:28:58.12,0:29:01.46,Main,,0,0,0,,...karşınızda!
Dialogue: 0,0:29:01.46,0:29:04.10,Main,,0,0,0,,Raizo!
Dialogue: 0,0:29:04.58,0:29:08.08,Main,,0,0,0,,Nin! Nin!
