Dialogue: 0,0:00:00.82,0:00:06.82,English - OP18,,0,0,0,,♪ Görmedim dünyanın sonunu kendi gözlerimle hiç. ♪
Dialogue: 0,0:00:06.82,0:00:13.95,English - OP18,,0,0,0,,♪ O yüzden çıktım yola sizinle, bunu yapmak için! ♪
Dialogue: 0,0:00:23.67,0:00:27.00,English - OP18,,0,0,0,,♪ Bir denizden diğerine yol alırken,...
Dialogue: 0,0:00:29.06,0:00:31.85,English - OP18,,0,0,0,,...bunun sadece bir peri masalı olduğunu söylemek. ♪
Dialogue: 0,0:00:31.85,0:00:38.78,English - OP18,,0,0,0,,♪ Gerçek, kurgudan daha tuhaf değil mi? ♪
Dialogue: 0,0:00:39.94,0:00:43.18,English - OP18,,0,0,0,,♪ Fakat sırt çevirme hiçbirine. ♪
Dialogue: 0,0:00:43.56,0:00:50.04,English - OP18,,0,0,0,,♪ Sağduyu dedikleri zihnidir toplulukların! ♪
Dialogue: 0,0:00:51.36,0:00:57.41,English - OP18,,0,0,0,,♪ Görmedim dünyanın sonunu kendi gözlerimle hiç. ♪
Dialogue: 0,0:00:57.41,0:01:01.96,English - OP18,,0,0,0,,♪ O yüzden gitmemiz lazım Kaptan Özgür-Ruh! ♪
Dialogue: 0,0:01:01.96,0:01:04.67,English - OP18,,0,0,0,,♪ Kim demiş imkansız diye,...
Dialogue: 0,0:01:04.67,0:01:07.75,English - OP18,,0,0,0,,...daha hiçbir şey başlamadan! ♪
Dialogue: 0,0:01:07.75,0:01:12.72,English - OP18,,0,0,0,,♪ Her şeyi bilmek istiyorum ve şimdi bilebiliriz de... ♪
Dialogue: 0,0:01:12.72,0:01:18.68,English - OP18,,0,0,0,,♪ Bilebiliriz, bilebilirsin! Şu anda... ♪
Dialogue: 0,0:01:19.06,0:01:24.10,English - OP18,,0,0,0,,♪ Bilebiliriz, bilebilirim! Bu harika hissi... ♪
Dialogue: 0,0:01:24.39,0:01:31.32,English - OP18,,0,0,0,,♪ Hemen, şimdi, bilebiliriz! ♪
Dialogue: 0,0:01:37.34,0:01:38.64,English - OP18,,0,0,0,,♪ Evet, bilebiliriz! ♪
Dialogue: 0,0:01:41.74,0:01:46.70,Author,,0,0,0,,{\fad(250,250)\fs18} Türkçeleştirme & Çevirmen  {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&} - {\c&H01BAFF&}{\b1}eray.gns{\b0}{\c&HFFFFFF&}\N{\fs18}thx to onepace.net
Dialogue: 0,0:24:27.94,0:24:35.00,Author,,0,0,0,,{\fad(0,0)\fs18} Türkçeleştirme & Çevirmen  {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&} - {\c&H01BAFF&}{\b1}eray.gns{\b0}{\c&HFFFFFF&}\N{\fs19}thx to onepace.net
Dialogue: 0,0:01:41.74,0:01:46.70,Title,,0,0,100,,{\fad(250,250)}Dük Inuarashi ve Efendi Nekomamushi
Dialogue: 0,0:01:52.04,0:01:53.48,Main,,0,0,0,,Mamut mu?!
Dialogue: 0,0:01:53.48,0:01:55.38,Main,,0,0,0,,O tarih öncesi\Ncanavarın burada ne işi var?!
Dialogue: 0,0:01:55.38,0:02:00.97,Main,,0,0,0,,Düşmanın istediği ve\Nsizin sahip olmadığınız şey bu öyle mi?
Dialogue: 0,0:02:10.48,0:02:13.18,Main,,0,0,0,,Wano Krallığı savaşçısı Raizo mu?
Dialogue: 0,0:02:13.18,0:02:14.98,Main,,0,0,0,,Öyle birini tanımıyoruz!
Dialogue: 0,0:02:16.62,0:02:20.68,Main,,0,0,0,,Ülkemizi rahat bırakın!\NGidin buradan!
Dialogue: 0,0:02:24.59,0:02:29.19,Main,,0,0,0,,Mink Kabilesi'nin hayalet ülkesi\Ngerçekten de varmış!
Dialogue: 0,0:02:29.19,0:02:31.80,Main,,0,0,0,,Siz aptal hayvanlar\Nbiraz fazla konuşuyorsunuz!
Dialogue: 0,0:02:31.80,0:02:34.66,Main,,0,0,0,,Tanıtın kendinizi! Siz-gara kimsiniz?!
Dialogue: 0,0:02:35.70,0:02:39.74,Main,,0,0,0,,O soruyu kime sorduğunun\Nfarkında mısın sen?!
Dialogue: 0,0:02:39.74,0:02:41.94,Main,,0,0,0,,Burada duran kişi...
Dialogue: 0,0:02:42.18,0:02:45.35,Main,,0,0,0,,...ünlü Yonko Kaido-sama'nın sağ kolu...
Dialogue: 0,0:02:45.35,0:02:49.58,Main,,0,0,0,,..."felaketler" olarak bilinen\Nüç hizmetkardan biri...
Dialogue: 0,0:02:49.43,0:02:52.67,Captions,,0,0,290,,{\fad(600,0)}Canavar Korsanları Yıldızı\NMamut Kaptan\N"Kuraklık" Jack
Dialogue: 0,0:02:50.04,0:02:52.66,Main,,0,0,650,,...Kuraklık Jack-sama!
Dialogue: 0,0:02:53.34,0:02:56.02,Main,,0,0,0,,Jack-sama'nın geçtiği topraklar...
Dialogue: 0,0:02:56.02,0:03:00.90,Main,,0,0,0,,...kuraklık yaşanmışçasına yerlebir edilir!
Dialogue: 0,0:03:01.70,0:03:05.99,Main,,0,0,0,,Haydi, Wano Krallığı'nın\Nsavaşçısı Raizo'yu verin bize!
Dialogue: 0,0:03:05.99,0:03:08.44,Main,,0,0,3,,Çocuklarınıza sarılabildiğiniz bu huzur dolu...
Dialogue: 0,0:03:06.32,0:03:10.89,Captions,,0,0,240,,{\fad(600,0)}Canavar Korsanları\NGifters(Yetenekliler) Şefi\NSheepshead
Dialogue: 0,0:03:08.44,0:03:10.88,Main,,0,0,3,,...günlerin sona ermesini istemezsiniz!
Dialogue: 0,0:03:12.42,0:03:15.54,Main,,0,0,0,,Yoksa savaşmak mı istiyorsunuz?!
Dialogue: 0,0:03:18.18,0:03:20.98,Main,,0,0,0,,Savaşmak gibi bir arzumuz yok.
Dialogue: 0,0:03:20.98,0:03:22.15,Main,,0,0,0,,Mon-ji!
Dialogue: 0,0:03:22.38,0:03:28.93,Main,,0,0,0,,Fakat anlaşabilmemiz için\Nsizin de bizi dinlemeniz lazım.
Dialogue: 0,0:03:28.93,0:03:32.32,Main,,0,0,0,,Keza burada olmayan birini\Nsize teslim edemeyiz.
Dialogue: 0,0:03:32.32,0:03:37.36,Main,,0,0,0,,Jack-san, biz Mink'ler yalan söylemeyiz.
Dialogue: 0,0:03:37.36,0:03:42.07,Main,,0,0,0,,İşte bu Raizo denen kişiyi isterseniz\Nkapı kapı arayabilirsiniz...
Dialogue: 0,0:03:48.88,0:03:52.64,Main,,0,0,0,,Kadınmış, çocukmuş, yaşlıymış...\NKimseye acıması yoktur!
Dialogue: 0,0:03:54.94,0:03:59.77,Main,,0,0,0,,Buraya konuşmaya mı geldik, Gin-Rummy?
Dialogue: 0,0:03:59.77,0:04:04.62,Main,,0,0,0,,Hayır Jack-sama!\NBuraya bir samuray yakalamaya geldik.
Dialogue: 0,0:04:04.62,0:04:08.79,Main,,0,0,0,,Samuray değil o aptal! Raizo ninja!
Dialogue: 0,0:04:08.79,0:04:11.05,Main,,0,0,0,,Kes sesini, Sheepshead-sama!
Dialogue: 0,0:04:11.05,0:04:15.44,Main,,0,0,0,,Samuray Wano Krallığı'nın savaşçıları\Niçin kullanılan genel bir terimdir.
Dialogue: 0,0:04:15.44,0:04:17.54,Main,,0,0,0,,Samurayla ninja bambaşka şeyler!
Dialogue: 0,0:04:18.32,0:04:20.86,Main,,0,0,0,,Tek bir isteğim var!
Dialogue: 0,0:04:21.32,0:04:23.96,Main,,0,0,0,,Raizo'yu buraya getirin!
Dialogue: 0,0:04:24.68,0:04:28.68,Main,,0,0,0,,Bu ülkeye saldıranlar\NKaido'nun adamlarıydı demek?
Dialogue: 0,0:04:30.48,0:04:31.64,Main,,0,0,0,,Evet.
Dialogue: 0,0:04:38.44,0:04:40.73,Main,,0,0,0,,Raizo adında kimseyi bilmiyoruz!
Dialogue: 0,0:04:40.73,0:04:44.13,Main,,0,0,0,,Bizden istediğiniz şey imkansız!\NOnu gerçekten tanımıyoruz!
Dialogue: 0,0:04:44.13,0:04:47.20,Main,,0,0,0,,Öyleyse ülkenin her bir karışını arayın!
Dialogue: 0,0:04:47.20,0:04:48.10,Main,,0,0,0,,Pleasures!
Dialogue: 0,0:04:52.64,0:04:53.71,Main,,0,0,0,,Oğlum!
Dialogue: 0,0:04:53.71,0:04:58.47,Main,,0,0,3,,{\an8}Aptal velet! Ne kadar acımasız olabileceğinizi gösterin onlara!
Dialogue: 0,0:04:54.51,0:04:58.19,Captions,,0,0,170,,{\fad(500,0)}Pleasures (Hazcılar)
Dialogue: 0,0:05:16.96,0:05:19.21,Main,,0,0,0,,Acıyor!
Dialogue: 0,0:05:25.90,0:05:27.57,Main,,0,0,0,,Ne yapıyorsunuz?!
Dialogue: 0,0:05:34.10,0:05:35.35,Main,,0,0,0,,Ne yapıyor bunlar?!
Dialogue: 0,0:05:36.57,0:05:38.18,Main,,0,0,0,,Rezil herifler!
Dialogue: 0,0:05:39.18,0:05:42.35,Main,,0,0,0,,Bu ülkede güçsüz kimse yoktur!
Dialogue: 0,0:05:43.06,0:05:48.84,Main,,0,0,0,,Tüm Mink'ler yetenekli birer\Nsavaşçı olarak dünyaya gelir!
Dialogue: 0,0:05:48.84,0:05:52.76,Main,,0,0,0,,Bebekler bile kendilerini savunmayı bilirler!
Dialogue: 0,0:05:55.86,0:06:00.40,Main,,0,0,0,,Siz-gara'lar bu ülkedeki herkesi\Nkarşınızı alabileceğinizi mi sanıyorsunuz?
Dialogue: 0,0:06:00.40,0:06:05.98,Main,,0,0,0,,Yanımızda yetenekleri kelimelere sığmayacak\Nyüksek eğitimli silahşörler de var!
Dialogue: 0,0:06:06.38,0:06:09.88,Main,,0,0,0,,Savaşırsak iki taraf da ağır yara alır!
Dialogue: 0,0:06:10.48,0:06:16.96,Main,,0,0,0,,Birini arıyorsanız önce en azından\Nülkemizin düküyle konuşmaz mısınız?
Dialogue: 0,0:06:16.96,0:06:18.30,Main,,0,0,0,,Konuşmak mı?
Dialogue: 0,0:06:26.86,0:06:27.83,Main,,0,0,0,,İstemiyorum!
Dialogue: 0,0:06:28.54,0:06:30.67,Main,,0,0,0,,Gifters! Öne gelin!
Dialogue: 0,0:06:31.12,0:06:33.00,Main,,0,0,0,,Peki!
Dialogue: 0,0:06:35.54,0:06:43.10,Captions,,0,0,170,,{\fad(600,0)}Gifters (Yetenekliler)
Dialogue: 0,0:06:43.46,0:06:46.35,Main,,0,0,0,,Bunların-gara, bedenleri de ne biçim böyle?!
Dialogue: 0,0:06:47.89,0:06:52.69,Main,,0,0,0,,Pekâlâ öyleyse!\NÜlkeyi yok edip samurayı bulun!
Dialogue: 0,0:06:59.54,0:07:03.87,Main,,0,0,0,,Sözümüzü dinlemediler bile\Nve savaş başladı.
Dialogue: 0,0:07:03.87,0:07:05.64,Main,,0,0,0,,Huzur dolu Kurau Şehri...
Dialogue: 0,0:07:07.96,0:07:10.66,Main,,0,0,0,,...göz açıp kapayıncaya\Nsavaş alanına döndü!
Dialogue: 0,0:07:12.14,0:07:15.82,Main,,0,0,0,,Yürüyebilenler\Nyürüyemeyenlere yardım edip...
Dialogue: 0,0:07:15.82,0:07:17.42,Main,,0,0,0,,...onları buraya taşıdılar.
Dialogue: 0,0:07:17.82,0:07:21.90,Main,,0,0,0,,Ayrıca onların-tiara,\Nbu adaya nasıl geldiğini...
Dialogue: 0,0:07:21.90,0:07:25.86,Main,,0,0,0,,...yahut samurayın neden burada olduğunu\Ndüşündüklerini de bilmiyoruz.
Dialogue: 0,0:07:25.86,0:07:28.82,Main,,0,0,0,,Mamut devasa bir şeydi kesin!
Dialogue: 0,0:07:29.76,0:07:32.97,Main,,0,0,0,,Heyecanlanma hemen, şimdi sırası da değil!
Dialogue: 0,0:07:35.54,0:07:38.22,Main,,0,0,0,,Wanda-san'ın anlattıklarını\Ndinledikten sonra...
Dialogue: 0,0:07:38.22,0:07:42.26,Main,,0,0,0,,...neden "samuray" ve "Wano Krallığı"\Nkelimelerinin tabu olduğunu anlamışsınızdır.
Dialogue: 0,0:07:42.26,0:07:43.64,Main,,0,0,0,,Haklısın.
Dialogue: 0,0:07:43.64,0:07:45.64,Main,,0,0,0,,Ne kötü insanlar!
Dialogue: 0,0:07:45.81,0:07:48.34,Main,,0,0,0,,Yani o kelimeleri kullanacak olursanız...
Dialogue: 0,0:07:48.86,0:07:51.78,Main,,0,0,0,,...Mink Kabilesi'ni kızdırıp sizden nefret\Netmelerine neden olursunuz.
Dialogue: 0,0:07:51.78,0:07:53.35,Main,,0,0,0,,Yalnız var ya...
Dialogue: 0,0:08:00.36,0:08:03.93,Main,,0,0,0,,Kin'mon'un bahsettiği şu ninja\Nburada değilmiş demek?!
Dialogue: 0,0:08:03.93,0:08:05.16,Main,,0,0,0,,Büyük hayal kırıklığı!
Dialogue: 0,0:08:16.70,0:08:18.19,Main,,0,0,0,,Ninja?
Dialogue: 0,0:08:19.78,0:08:21.88,Main,,0,0,0,,{\fad(150,150)}Bone-Bone Chop!
Dialogue: 0,0:08:19.78,0:08:21.88,Attack,,0,0,0,,{\fad(150,150)}Kemik Kemik Vuruşu!
Dialogue: 0,0:08:26.06,0:08:28.44,Main,,0,0,0,,Vuruş! Vuruş! Vuruş!
Dialogue: 0,0:08:30.10,0:08:33.84,Main,,0,0,0,,Ninja derken Wano Krallığı'nın\Nbir savaşçısından mı bahsediyorsun?
Dialogue: 0,0:08:34.16,0:08:36.48,Main,,0,0,0,,Siz-tia'lar bir şeyler mi biliyorsunuz?
Dialogue: 0,0:08:37.13,0:08:40.54,Main,,0,0,0,,Olur mu öyle şey,\Nağzından tek kelime bile çıkmadı!
Dialogue: 0,0:08:41.68,0:08:44.76,Main,,0,0,0,,"Hasta" demiştir belki?\NHastanın durumu nasıl gibilerinden?!
Dialogue: 0,0:08:41.68,0:08:44.76,Note,,0,0,0,,Kanja: Hasta
Dialogue: 0,0:08:45.70,0:08:47.27,Main,,0,0,0,,Garchu!
Dialogue: 0,0:08:47.27,0:08:49.65,Main,,0,0,0,,Hiç acımadı ki...
Dialogue: 0,0:08:49.65,0:08:52.42,Main,,0,0,0,,Hastanın evine daha çok var mı?
Dialogue: 0,0:08:52.42,0:08:56.00,Main,,0,0,0,,Yok, Dük-sama'nın sanatoryumu\Ngörüş alanımıza girdi bile.
Dialogue: 0,0:08:56.64,0:08:58.69,Main,,0,0,0,,Benimle geldiğiniz için teşekkür ederim.
Dialogue: 0,0:08:58.69,0:09:00.62,Main,,0,0,0,,Sohbetimize daha sonra devam ederiz.
Dialogue: 0,0:09:01.84,0:09:05.33,Captions,,0,0,170,,{\fad(500,0)}Dük Inuarashi'nin Sanatoryumu
Dialogue: 0,0:09:06.62,0:09:09.20,Main,,0,0,0,,Çok özür dileriz, Shishilian-sama!
Dialogue: 0,0:09:09.20,0:09:10.94,Main,,0,0,0,,Bağışla bizi!
Dialogue: 0,0:09:16.92,0:09:19.33,Main,,0,0,0,,Shishilian-sama kontrolden çıktı!
Dialogue: 0,0:09:19.92,0:09:20.91,Main,,0,0,0,,Ne oluyor?
Dialogue: 0,0:09:23.18,0:09:25.30,Main,,0,0,0,,Shishilian-dono, sorun nedir?!
Dialogue: 0,0:09:25.88,0:09:27.76,Main,,0,0,0,,Sen miydin Wanda?!
Dialogue: 0,0:09:27.76,0:09:30.65,Main,,0,0,0,,Onlar-gara güzel şeyler söyleyip durdular...
Dialogue: 0,0:09:31.30,0:09:34.98,Main,,0,0,3,,...ben de onları uçurumdan aşağı attım!
Dialogue: 0,0:09:33.25,0:09:36.66,Captions,,0,0,230,,Dük Inuarashi Silahşörleri Kaptanı (Aslan Mink)\N"Tam Güç" Shishilian
Dialogue: 0,0:09:36.65,0:09:37.66,Main,,0,0,0,,Şefkat!
Dialogue: 0,0:09:37.91,0:09:38.66,Main,,0,0,0,,Sevgi!
Dialogue: 0,0:09:38.66,0:09:39.36,Main,,0,0,0,,Aşk!
Dialogue: 0,0:09:39.54,0:09:40.36,Main,,0,0,0,,Bebekler!
Dialogue: 0,0:09:40.36,0:09:41.49,Main,,0,0,0,,Şeker!
Dialogue: 0,0:09:41.66,0:09:44.30,Main,,0,0,0,,Bal!
Dialogue: 0,0:09:45.74,0:09:49.44,Main,,0,0,0,,Önümde böyle tatlı şeylerden\Nsakın bahsetmeyin!
Dialogue: 0,0:09:49.44,0:09:51.45,Main,,0,0,0,,Yoksa boğazınızı kopartırım!
Dialogue: 0,0:09:51.45,0:09:54.66,Main,,0,0,0,,Haydi, tek başınıza\Nburaya tırmanmaya çalışın!
Dialogue: 0,0:09:55.61,0:09:57.46,Main,,0,0,0,,Ne şefkatli biri!
Dialogue: 0,0:09:57.46,0:09:59.32,Main,,0,0,0,,Ne dedin sen?!
Dialogue: 0,0:10:01.95,0:10:03.35,Main,,0,0,0,,Ne?!
Dialogue: 0,0:10:03.92,0:10:10.46,Main,,0,0,0,,Daha az önce yapmayın dememe rağmen\Nönümde sevgiymiş, şefkatmiş ne cüretle konuşursunuz?!
Dialogue: 0,0:10:15.10,0:10:17.96,Main,,0,0,0,,Adam havalı arkadaş!
Dialogue: 0,0:10:17.96,0:10:21.47,Main,,0,0,0,,Özür dileriz!\NBir daha asla iyi konuşmayız!
Dialogue: 0,0:10:21.47,0:10:23.19,Main,,0,0,0,,Anladıysanız ne ala!
Dialogue: 0,0:10:23.19,0:10:24.38,Main,,0,0,0,,Shishilian-dono.
Dialogue: 0,0:10:24.38,0:10:25.24,Main,,0,0,0,,Ne var?!
Dialogue: 0,0:10:25.60,0:10:28.21,Main,,0,0,0,,Onlar-tiara Hasır Şapka tayfası.
Dialogue: 0,0:10:36.38,0:10:40.00,Main,,0,0,0,,Ülkemi kurtardığınız için teşekkür ederim!
Dialogue: 0,0:10:40.00,0:10:42.22,Main,,0,0,0,,Bu borcu size sonsuza dek ödeyemem!
Dialogue: 0,0:10:44.46,0:10:48.10,Main,,0,0,0,,Shishilian-dono her ne olursa olsun\Nyaptığı şeyi sonuna kadar yapan biridir.
Dialogue: 0,0:10:48.10,0:10:50.00,Main,,0,0,0,,Ne sinir bozucu bir aslan.
Dialogue: 0,0:10:52.24,0:10:56.16,Main,,0,0,0,,Dük sizi bekliyor, haydi içeri geçin!\NOyalanmayın!
Dialogue: 0,0:10:58.48,0:10:59.92,Main,,0,0,0,,Luffyler!
Dialogue: 0,0:11:16.80,0:11:21.80,Captions,,0,0,170,,{\fad(750,0)}Mokomo Düklüğü   Gündüz Kralı   Dük Inuarashi
Dialogue: 0,0:11:23.10,0:11:26.00,Main,,0,0,0,,Dük-sama, şükürler olsun ki iyisiniz!
Dialogue: 0,0:11:27.90,0:11:31.37,Main,,0,0,0,,Siz-gara'lar Hasır Şapka tayfası olmalısınız.
Dialogue: 0,0:11:31.61,0:11:35.16,Main,,0,0,0,,Her açıdan hayatımızı kurtardınız.
Dialogue: 0,0:11:35.16,0:11:37.33,Main,,0,0,0,,Çok teşekkür ederim.
Dialogue: 0,0:11:37.70,0:11:42.38,Main,,0,0,0,,Dostlarımın sizi kurtardığını duydum\Nama henüz hâlâ tüm hikayeyi bilmiyorum.
Dialogue: 0,0:11:42.76,0:11:47.66,Main,,0,0,0,,Sizin-gara da yardımınız büyük oldu,\NHasır Şapkalı Luffy-kun.
Dialogue: 0,0:11:48.02,0:11:51.84,Main,,0,0,0,,Yalnız var ya güçlüsündür şimdi sen ihtiyar!\NAcayip güçlü hem de!
Dialogue: 0,0:11:51.84,0:11:56.58,Main,,0,0,0,,O da ne demekmiş?! Kabalığın lüzumu yok!\NDük-sama ülkenin en güçlü savaşçısıdır!
Dialogue: 0,0:11:58.06,0:12:01.95,Main,,0,0,0,,Gerek yok buna.\NYenilmiş birine en güçlü diyemezsin.
Dialogue: 0,0:12:01.95,0:12:03.61,Main,,0,0,0,,Ne demek yenilmiş?!
Dialogue: 0,0:12:03.61,0:12:07.74,Main,,0,0,0,,Düşmanlarımız can sıkıcılardı belki\Nama üstünlük bizdeydi!
Dialogue: 0,0:12:08.82,0:12:10.18,Main,,0,0,0,,Kullandıkları silah...
Dialogue: 0,0:12:15.76,0:12:17.50,Main,,0,0,0,,...zehirli gaz silahıydı.
Dialogue: 0,0:12:21.38,0:12:22.24,Main,,0,0,0,,Gaz mı?
Dialogue: 0,0:12:22.24,0:12:23.49,Main,,0,0,0,,Aynen öyle, Luffy.
Dialogue: 0,0:12:23.70,0:12:27.46,Main,,0,0,0,,Bu ülkeyi mahveden\NCaesar'ın zehirli gaz silahı oldu!
Dialogue: 0,0:12:28.58,0:12:34.58,Main,,0,0,0,,Caesar'ın yarattığı, Doflamingo'nun sattığı silah \NKaidou'ya kadar ulaşmış demek!
Dialogue: 0,0:12:36.18,0:12:37.80,Main,,0,0,0,,Caesar!
Dialogue: 0,0:12:52.40,0:12:53.70,Main,,0,0,0,,Ağzının suyu akıyor!
Dialogue: 0,0:12:54.31,0:12:57.20,Main,,0,0,0,,Sizi çok iyi anlıyorum Dük-sama!\NO-tia da kurtarıcılarımızdan biri!
Dialogue: 0,0:12:57.20,0:12:59.79,Main,,0,0,0,,Ne leziz görünümlü bir kurtarıcı!
Dialogue: 0,0:12:59.79,0:13:02.56,Main,,0,0,0,,Daha tam olarak iyileşmediniz...
Dialogue: 0,0:13:02.90,0:13:03.70,Main,,0,0,0,,...sonraya saklayın.
Dialogue: 0,0:13:03.70,0:13:05.33,Main,,0,0,0,,Sonra da olmaz!
Dialogue: 0,0:13:08.22,0:13:10.98,Main,,0,0,0,,Nasıl yenildiğimizi konuşmaktan ziyade...
Dialogue: 0,0:13:10.98,0:13:15.18,Main,,0,0,0,,O hasır şapka sen-gara'ya çok yakışmış.
Dialogue: 0,0:13:17.82,0:13:20.04,Main,,0,0,0,,Bir zamanlar ben de...
Dialogue: 0,0:13:20.36,0:13:23.48,Main,,0,0,0,,Neydi adı ya?!
Dialogue: 0,0:13:24.04,0:13:25.97,Main,,0,0,0,,Şu kedi...
Dialogue: 0,0:13:25.97,0:13:28.26,Main,,0,0,0,,Nekomamushi Efendi.
Dialogue: 0,0:13:28.26,0:13:32.45,Main,,0,0,0,,İkimiz bir zamanlar\Nbirlikte denizleri arşınlıyorduk.
Dialogue: 0,0:13:33.42,0:13:38.92,Main,,0,0,0,,Şimdilerde Yonko olan korsan Shanks da\No zamanlar benzer bir şapka takıyordu.
Dialogue: 0,0:13:38.92,0:13:43.20,Main,,0,0,0,,Shanks'ı tanıyor musun ihtiyar?\NAma nasıl?!
Dialogue: 0,0:13:44.32,0:13:47.48,Main,,0,0,0,,Bu şapkayı Shanks'dan aldım ve...
Dialogue: 0,0:13:49.38,0:13:50.62,Main,,0,0,0,,Uyudu!
Dialogue: 0,0:13:51.40,0:13:53.13,Main,,0,0,0,,Saat 6 olmuş bile.
Dialogue: 0,0:13:53.13,0:13:55.31,Main,,0,0,0,,Saat daha 6! Çocuk mu bu?!
Dialogue: 0,0:13:55.47,0:13:56.91,Main,,0,0,0,,Uyansana!
Dialogue: 0,0:13:56.91,0:14:02.89,Main,,0,0,0,,Daha önce de bahsettiğim gibi \NMokomo Düklüğü iki hükümdar tarafından yönetiliyor.
Dialogue: 0,0:14:04.04,0:14:07.39,Main,,0,0,0,,Resmi hükümdar Dük Inuarashi olsa da...
Dialogue: 0,0:14:07.56,0:14:14.32,Main,,0,0,0,,...kutsal ve kadim Balina Ormanı'nı koruyan Nekomamushi Efendi de aynı yetkilere sahiptir.
Dialogue: 0,0:14:16.22,0:14:20.05,Main,,0,0,0,,Bu anlattıklarının\Nuykuya dalmış olmasıyla ne alakası var?
Dialogue: 0,0:14:22.70,0:14:24.01,Secondary,,0,0,0,,Yapma dedim!
Dialogue: 0,0:14:24.01,0:14:27.14,Main,,0,0,0,,Birbirlerini pek sevmezler.
Dialogue: 0,0:14:29.08,0:14:33.38,Main,,0,0,0,,Karşılaştıklarında birbirlerini\Nöldürmeye çalışacak kadar hem de!
Dialogue: 0,0:14:37.26,0:14:38.57,Main,,0,0,0,,Öldürecek kadar mı?!
Dialogue: 0,0:14:38.57,0:14:39.64,Main,,0,0,0,,Neden ki?!
Dialogue: 0,0:14:40.26,0:14:42.33,Main,,0,0,0,,Nedenini bilmiyorum.
Dialogue: 0,0:14:42.33,0:14:45.06,Main,,0,0,0,,Duyduğuma göre eskiden çok iyi arkadaşlarmış...
Dialogue: 0,0:14:45.76,0:14:48.97,Main,,0,0,0,,...ama ikisi de kral seviyesinde\Nsaygı duyulan kişilermiş...
Dialogue: 0,0:14:49.19,0:14:52.00,Main,,0,0,0,,...ve savaşsalar bile birbirlerine\Ngalip gelemiyorlarmış.
Dialogue: 0,0:14:52.00,0:14:56.42,Main,,0,0,0,,Birbirleriyle o kadar çok savaşmışlar ki \Nartık birbirlerini görmek dahi istemediklerinden...
Dialogue: 0,0:14:58.68,0:15:03.33,Main,,0,0,0,,...biri güneşle birlikte\Nsabah altıdan akşam altıya...
Dialogue: 0,0:15:03.33,0:15:09.06,Main,,0,0,0,,...öteki de ayla birlikte\Nakşam altıdan sabah altıya...
Dialogue: 0,0:15:10.92,0:15:14.43,Main,,0,0,0,,Günü bu şekilde bölüşmüşler.
Dialogue: 0,0:15:14.90,0:15:17.22,Main,,0,0,0,,Birbirlerinden o denli mi nefret ediyorlar?!
Dialogue: 0,0:15:20.24,0:15:23.27,Main,,0,0,0,,Doktorlar ne ara uykuya daldı?!
Dialogue: 0,0:15:23.56,0:15:27.36,Main,,0,0,0,,Bu kaledeki herkes şimdilerde uyuyor olmalı.
Dialogue: 0,0:15:34.62,0:15:37.32,Main,,0,0,0,,Benim de uykum gelmeye başladı...
Dialogue: 0,0:15:37.98,0:15:39.12,Main,,0,0,0,,Sen...
Dialogue: 0,0:15:39.37,0:15:42.19,Main,,0,0,0,,Shishilian! Her zaman tam güç!
Dialogue: 0,0:15:42.37,0:15:44.44,Main,,0,0,0,,Bağırmana gerek yok, duyuyoruz!
Dialogue: 0,0:15:45.74,0:15:50.17,Main,,0,0,0,,Gündüz-gece vardiyaları bizi de etkiliyor.
Dialogue: 0,0:15:50.17,0:15:54.50,Main,,0,0,0,,Şehirdeki insanlar gündüz uyanıktırlar.
Dialogue: 0,0:15:54.50,0:15:57.20,Main,,0,0,0,,Ormandaki insanlarsa...
Dialogue: 0,0:15:57.64,0:16:00.37,Main,,0,0,0,,...gece...
Dialogue: 0,0:16:04.96,0:16:06.36,Main,,0,0,0,,Bulun onu!
Dialogue: 0,0:16:06.80,0:16:10.01,Main,,0,0,0,,Raizo'nun bu ülkede olduğunu biliyorum!
Dialogue: 0,0:16:10.01,0:16:11.49,Main,,0,0,0,,Yeter!
Dialogue: 0,0:16:11.49,0:16:13.90,Main,,0,0,0,,Şehri daha fazla harap etmeyin!
Dialogue: 0,0:16:13.90,0:16:15.32,Main,,0,0,0,,Bu gidişle...
Dialogue: 0,0:16:15.32,0:16:17.36,Main,,0,0,0,,Şu samuray nerede?!
Dialogue: 0,0:16:17.36,0:16:19.87,Main,,0,0,0,,Bilmiyorum! Bilmiyorum dedim!
Dialogue: 0,0:16:20.86,0:16:23.43,Main,,0,0,0,,O zaman geber!
Dialogue: 0,0:16:26.82,0:16:28.85,Main,,0,0,0,,Silahşörler geldi!
Dialogue: 0,0:16:30.76,0:16:34.97,Main,,0,0,0,,Şükürler olsun! Onlar-gara'ya bırakın!\NHerkes geri çekilsin!
Dialogue: 0,0:16:36.84,0:16:38.84,Main,,0,0,3,,Hasarı en azda tutun!
Dialogue: 0,0:16:36.99,0:16:42.00,Captions,,0,0,170,,{\fad(500,0)}Silahşörler
Dialogue: 0,0:16:39.16,0:16:41.40,Main,,0,0,3,,Onları silahsız bırakmaya çalışın!
Dialogue: 0,0:16:41.40,0:16:42.32,Main,,0,0,3,,Evet!
Dialogue: 0,0:16:43.48,0:16:44.34,Main,,0,0,0,,Gidelim!
Dialogue: 0,0:16:44.34,0:16:45.02,Main,,0,0,0,,Peki!
Dialogue: 0,0:17:03.52,0:17:06.90,Main,,0,0,0,,Nesi var bunların-tiara?!\NTüylerim diken diken oldu!
Dialogue: 0,0:17:13.14,0:17:14.95,Main,,0,0,0,,Çok tuhaf savaşçıları var!
Dialogue: 0,0:17:16.28,0:17:18.07,Main,,0,0,0,,Bilmediğimiz bir kabile mi?!
Dialogue: 0,0:17:18.07,0:17:20.05,Main,,0,0,0,,Nasıl güçler bunlar?!
Dialogue: 0,0:17:22.26,0:17:25.02,Main,,0,0,0,,Siyah boynuzları olanlara dikkat edin!
Dialogue: 0,0:17:25.02,0:17:27.05,Main,,0,0,0,,{\fad(150,150)}Kurt Kavrayışı
Dialogue: 0,0:17:27.96,0:17:29.19,Main,,0,0,0,,Eli kurda mı dönüştü?!
Dialogue: 0,0:17:29.42,0:17:31.16,Main,,0,0,0,,Geber!
Dialogue: 0,0:17:31.84,0:17:33.08,Main,,0,0,0,,Wanda!
Dialogue: 0,0:17:35.26,0:17:37.06,Main,,0,0,0,,Siz-gara geri çekilin!
Dialogue: 0,0:17:37.64,0:17:38.87,Main,,0,0,0,,Shishilian-dono!
Dialogue: 0,0:17:45.66,0:17:50.05,Captions,,0,0,170,,{\fad(600,0)}Inuarashi'nin Üç Silahşörü
Dialogue: 0,0:17:47.78,0:17:49.42,Main,,0,0,3,,Üç Silahşörler geldi!
Dialogue: 0,0:17:50.36,0:17:54.10,Main,,0,0,0,,Uygun tüm silahşörler,\Nhalkı ormana götürün!
Dialogue: 0,0:17:54.10,0:17:54.49,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:18:01.58,0:18:03.16,Main,,0,0,0,,Bunlar da kimin nesi?!
Dialogue: 0,0:18:27.08,0:18:28.79,Main,,0,0,0,,Dük Inuarashi!
Dialogue: 0,0:18:31.72,0:18:33.82,Main,,0,0,0,,Adın Jack öyle mi?
Dialogue: 0,0:18:33.82,0:18:36.90,Main,,0,0,0,,Bu yakıp yıkmalara ve şiddete derhal son ver!
Dialogue: 0,0:18:42.00,0:18:44.90,Main,,0,0,0,,Ülkenin kralı sensin demek!
Dialogue: 0,0:19:05.46,0:19:06.54,Main,,0,0,0,,Ne?!
Dialogue: 0,0:19:07.20,0:19:09.98,Main,,0,0,0,,Dük-sama, kılıcınızı neden bıraktınız?!
Dialogue: 0,0:19:11.86,0:19:16.86,Main,,0,0,0,,Karşılık vermeyeceğiz!\NŞehri, hatta ülkeyi...
Dialogue: 0,0:19:17.46,0:19:20.50,Main,,0,0,0,,...o samuray için\Nistediğiniz kadar arayabilirsiniz!
Dialogue: 0,0:19:21.12,0:19:22.74,Main,,0,0,0,,O yüzden bu yıkıma bir son verin!
Dialogue: 0,0:19:25.26,0:19:27.48,Main,,0,0,0,,Harika bir tarihe sahip bir ülke bu!
Dialogue: 0,0:19:27.48,0:19:29.01,Main,,0,0,0,,Reddediyorum!
Dialogue: 0,0:19:31.96,0:19:34.12,Main,,0,0,0,,Dük-sama, kaçın!
Dialogue: 0,0:19:38.96,0:19:40.39,Main,,0,0,0,,Dük-sama!
Dialogue: 0,0:19:58.81,0:20:01.75,Main,,0,0,0,,Oha oha! Ne biçim bir köpek bu?!
Dialogue: 0,0:20:01.75,0:20:04.30,Main,,0,0,0,,Jack-sama'nın saldırısına dayanmış!
Dialogue: 0,0:20:05.75,0:20:08.84,Main,,0,0,0,,Bravo Dük Inuarashi!
Dialogue: 0,0:20:08.84,0:20:11.38,Main,,0,0,0,,Adada böyle güçlü biri olduğu\Nsöylenmedi bize!
Dialogue: 0,0:20:11.79,0:20:14.78,Main,,0,0,0,,Pofuduk hayvan cenneti\Ndeğil miydi burası?!
Dialogue: 0,0:20:19.50,0:20:21.10,Main,,0,0,0,,Gerçi hiç fark etmez!
Dialogue: 0,0:20:21.10,0:20:27.04,Main,,0,0,0,,Patronumuz Jack-sama Yeni Dünya'da herkesin tanıdığı büyük bir korsandır!
Dialogue: 0,0:20:27.04,0:20:30.91,Main,,0,0,0,,Kafasına konan ödül...
Dialogue: 0,0:20:30.91,0:20:33.72,Main,,0,0,0,,...bir milyar beli!
Dialogue: 0,0:20:37.41,0:20:41.97,Main,,0,0,0,,Yani öyle azıcık güçlüsünüz diye\Nşansınızı zorlamayın!
Dialogue: 0,0:20:41.97,0:20:44.72,Main,,0,0,0,,Bu geveze herifi hiç sevmedim.
Dialogue: 0,0:20:47.18,0:20:48.28,Main,,0,0,0,,Lütfen!
Dialogue: 0,0:20:49.20,0:20:53.06,Main,,0,0,0,,Boş yere suçluyorsunuz bizi!\NSamuray falan saklamıyoruz!
Dialogue: 0,0:20:53.46,0:20:55.51,Main,,0,0,0,,Şöyle söyleyeyim o zaman...
Dialogue: 0,0:20:55.51,0:20:58.86,Main,,0,0,0,,Samurayı alır almaz\Nsaldırılarımıza son vereceğiz!
Dialogue: 0,0:20:59.64,0:21:02.61,Main,,0,0,0,,Alamazsak da bu sizin suçunuz!
Dialogue: 0,0:21:04.58,0:21:06.28,Thoughts,,0,0,0,,Saçmalık bu.
Dialogue: 0,0:21:09.36,0:21:11.30,Main,,0,0,0,,Ve bir şey daha söyleyeyim.
Dialogue: 0,0:21:12.28,0:21:14.76,Main,,0,0,0,,Yakıp yıkmayı çok severim!
Dialogue: 0,0:21:19.68,0:21:21.26,Main,,0,0,0,,Durum çok kötü!
Dialogue: 0,0:21:26.80,0:21:29.14,Main,,0,0,0,,Hepsini öldürün!
Dialogue: 0,0:21:29.14,0:21:30.93,Main,,0,0,0,,Gidelim!
Dialogue: 0,0:21:45.78,0:21:48.52,Main,,0,0,0,,Bunca su nereden geldi?!
Dialogue: 0,0:21:50.60,0:21:52.90,Main,,0,0,0,,Bu yağmur gözünüzü korkutmasın!
Dialogue: 0,0:22:03.98,0:22:06.24,Main,,0,0,0,,Nekomamushi Efendi'nin kükreyişi bu!
Dialogue: 0,0:22:08.50,0:22:10.81,Main,,0,0,0,,Gecenin Aptalı uyandı anlaşılan!
Dialogue: 0,0:22:11.03,0:22:12.85,Main,,0,0,0,,Geri çekiliyoruz, Silahşörler!
Dialogue: 0,0:22:12.85,0:22:13.84,Main,,0,0,0,,Ne?!
Dialogue: 0,0:22:13.84,0:22:15.85,Main,,0,0,0,,Savaşmayacak mıyız?
Dialogue: 0,0:22:15.85,0:22:18.88,Main,,0,0,0,,Hayır, gece-gündüz vardiyası işliyor.
Dialogue: 0,0:22:19.40,0:22:22.46,Main,,0,0,0,,Düşmana dinlenecek fırsat tanımadan\Naralıksız saldırabiliriz.
Dialogue: 0,0:22:22.46,0:22:23.59,Main,,0,0,0,,Gerçekten de öyle!
Dialogue: 0,0:22:24.86,0:22:25.85,Main,,0,0,0,,Jack!
Dialogue: 0,0:22:26.44,0:22:31.29,Main,,0,0,0,,Bu topraklarda laftan anlamayan\Ntek kişi sen değilsin!
Dialogue: 0,0:22:31.29,0:22:34.40,Main,,0,0,0,,Nereye gidersen git\Naptal insan sıkıntısı çekmezsin!
Dialogue: 0,0:22:51.33,0:22:53.18,Note,,0,0,0,,Koru
Dialogue: 0,0:22:53.18,0:22:56.58,Main,,0,0,0,,Ay çıktımı ülke benimdir!
Dialogue: 0,0:22:56.58,0:22:59.76,Main,,0,0,0,,Hiçbir saldırganın kaçmasına müsaade etmem!
Dialogue: 0,0:22:59.74,0:23:02.13,Captions,,0,0,170,,{\fad(250,0)}Muhafızlar
Dialogue: 0,0:23:03.96,0:23:07.24,Main,,0,0,0,,Buradan sağ kurtulabileceğinizi sanmayın!
Dialogue: 0,0:23:07.24,0:23:08.22,Main,,0,0,0,,Devasa!
Dialogue: 0,0:23:08.22,0:23:09.44,Main,,0,0,0,,Canavar kedi!
Dialogue: 0,0:23:23.50,0:23:25.32,Main,,0,0,0,,Jack-sama!
Dialogue: 0,0:23:25.32,0:23:27.38,Main,,0,0,0,,Efendim, şehir...
Dialogue: 0,0:23:27.38,0:23:31.06,Main,,0,0,0,,Hiç önemli değil! Olup biteni duydum.
Dialogue: 0,0:23:31.92,0:23:36.02,Main,,0,0,0,,Wano Ülkesi'nden bir samurayı\Naramaya gelmişsin öyle mi?
Dialogue: 0,0:23:37.83,0:23:41.81,Main,,0,0,0,,Bu ülkeye hiçbir samurayın\Nayak basmasına izin vermem!
Dialogue: 0,0:23:41.81,0:23:47.04,Main,,0,0,0,,Gelirlerse kafalarını kopartacak\Nilk kişi ben olurum hatta!
Dialogue: 0,0:23:48.00,0:23:50.49,Main,,0,0,0,,Adım Nekomamushi!
