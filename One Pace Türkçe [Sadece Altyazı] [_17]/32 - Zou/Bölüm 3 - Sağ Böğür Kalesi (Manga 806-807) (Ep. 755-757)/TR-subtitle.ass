Dialogue: 0,0:01:44.52,0:01:47.59,Title,,0,0,230,,{\fad(200,200)}Sağ Böğür Kalesi
Dialogue: 0,0:01:48.04,0:01:50.24,Main,,0,0,0,,Patlama-Yağmur geliyor!
Dialogue: 0,0:02:02.20,0:02:02.78,Main,,0,0,0,,Ne?!
Dialogue: 0,0:02:04.66,0:02:06.33,Main,,0,0,0,,Ani bir su baskını mı?!
Dialogue: 0,0:02:06.33,0:02:07.86,Main,,0,0,0,,Sel olacak!
Dialogue: 0,0:02:07.86,0:02:08.77,Main,,0,0,0,,Yüksek bir yerlere çıkalım!
Dialogue: 0,0:02:08.77,0:02:10.08,Main,,0,0,0,,Acele edin!
Dialogue: 0,0:02:12.50,0:02:13.45,Main,,0,0,0,,Bunun için...
Dialogue: 0,0:02:13.45,0:02:14.78,Main,,0,0,0,,Çok geç gibi!
Dialogue: 0,0:02:21.76,0:02:26.54,Narrator,,0,0,0,,Bu sırada filin sol arka bacağına\Ntırmanmakta olan Kin'emon'larsa...
Dialogue: 0,0:02:28.58,0:02:30.00,Main,,0,0,0,,Sonunda sakinleşti.
Dialogue: 0,0:02:30.60,0:02:33.77,Main,,0,0,0,,Az önceki sarsıntı da neyin nesiydi öyle?
Dialogue: 0,0:02:33.77,0:02:34.98,Main,,0,0,0,,Bilmiyorum.
Dialogue: 0,0:02:35.42,0:02:37.40,Main,,0,0,0,,Ama oldukça kritik bir noktaya\Nvarmak üzereyiz!
Dialogue: 0,0:02:37.72,0:02:39.97,Main,,0,0,0,,Dayan kedi! Nekozaemon!
Dialogue: 0,0:02:37.72,0:02:39.97,Note,,0,0,0,,Neko: Kedi
Dialogue: 0,0:02:42.20,0:02:43.46,Main,,0,0,0,,Haydi acele et!
Dialogue: 0,0:02:43.46,0:02:45.40,Main,,0,0,0,,Güneş batmak üzere, Nekozaemon!
Dialogue: 0,0:02:50.24,0:02:53.42,Main,,0,0,0,,Bu file tırmanmak\Nkedi için biraz fazla değil mi?
Dialogue: 0,0:02:54.26,0:02:55.32,Main,,0,0,0,,Kanjuro!
Dialogue: 0,0:02:55.96,0:02:57.00,Main,,0,0,0,,Katiyen!
Dialogue: 0,0:02:57.00,0:02:59.46,Main,,0,0,0,,Kediler ağaca tırmanmada ustadırlar.
Dialogue: 0,0:02:59.46,0:03:00.62,Main,,0,0,0,,Öyle gerçekten de!
Dialogue: 0,0:03:06.60,0:03:07.56,Main,,0,0,0,,Su mu?!
Dialogue: 0,0:03:07.56,0:03:08.30,Main,,0,0,0,,Ne?!
Dialogue: 0,0:03:11.10,0:03:14.91,Main,,0,0,0,,Bu ülkenin üzerine dökülen\NPatlama-Yağmur'un taşan kısmı...
Dialogue: 0,0:03:14.91,0:03:18.90,Main,,0,0,0,,Su kötü haber! Nekozaemon eriyecek!
Dialogue: 0,0:03:20.46,0:03:24.82,Main,,0,0,0,,Zaman kaybedecek lüksümüz de yok ama\Nyine buraya kadar geldikten sonra...
Dialogue: 0,0:03:31.26,0:03:35.28,Captions,,0,0,175,,{\fad(300,500)}Balina Ormanı - Luffy'nin Grubu
Dialogue: 0,0:03:35.73,0:03:39.29,Main,,0,0,0,,Ne yağdı be!
Dialogue: 0,0:03:39.29,0:03:41.96,Main,,0,0,0,,Patlama-Yağmur aslında yağmur değil.
Dialogue: 0,0:03:43.70,0:03:47.17,Main,,0,0,0,,Günde iki kez Zunesha üzerine su serper.
Dialogue: 0,0:03:47.17,0:03:50.64,Main,,0,0,0,,Yani az önceki üzerimize\Nfışkıran deniz suyuydu.
Dialogue: 0,0:03:52.44,0:03:57.15,Main,,0,0,0,,Yağmur şehrin merkezindeki bir süzme\Nsisteminden geçip sukemerlerine ulaşır...
Dialogue: 0,0:03:57.15,0:04:00.02,Main,,0,0,0,,...ve tüm ülke için içilebilir su haline gelir.
Dialogue: 0,0:04:00.02,0:04:05.12,Main,,0,0,0,,Deniz suyuyla birlikte bir sürü balık da\Ngeldiğinden yiyecek sıkıntısı da çekmiyoruz.
Dialogue: 0,0:04:05.84,0:04:08.42,Main,,0,0,0,,Patlama-Yağmur bize çok fayda sağlıyor.
Dialogue: 0,0:04:12.36,0:04:13.83,Main,,0,0,0,,Hey, Hasır Şapka!
Dialogue: 0,0:04:15.10,0:04:16.55,Main,,0,0,0,,Ha, Ayı!
Dialogue: 0,0:04:16.55,0:04:22.71,Main,,0,0,0,,Ben bu ormandan çıkamıyorum o yüzden kaptanımıza bizden bahsedip onu buraya getirir misin?!
Dialogue: 0,0:04:22.71,0:04:24.18,Main,,0,0,0,,Çıkamıyorsunuz ha?
Dialogue: 0,0:04:24.50,0:04:25.54,Main,,0,0,0,,Peki, getiririm!
Dialogue: 0,0:04:25.54,0:04:27.78,Main,,0,0,0,,Çok sağ ol!
Dialogue: 0,0:04:27.78,0:04:31.54,Main,,0,0,0,,Bepo burada doğmuş olmasına rağmen\Nkorsan olduğundan...
Dialogue: 0,0:04:31.54,0:04:36.52,Main,,0,0,0,,...şimdilerde ormanın patronu\NNekomamushi Efendi'nin himayesi altında.
Dialogue: 0,0:04:44.17,0:04:49.42,Captions,,0,0,175,,{\fad(500,0)}Kurau City - Zoro'nun Grubu
Dialogue: 0,0:04:44.34,0:04:45.78,Main,,0,0,3,,Sel oldu!
Dialogue: 0,0:04:46.38,0:04:49.40,Main,,0,0,3,,Köpek balığı var!\NKöpek balığı mı?! Neden?!
Dialogue: 0,0:04:49.40,0:04:51.00,Main,,0,0,0,,Daha çıksaydın!
Dialogue: 0,0:04:51.00,0:04:52.88,Main,,0,0,0,,Yeteri kadar yüksekteyiz.
Dialogue: 0,0:04:53.42,0:04:54.42,Main,,0,0,0,,Deniz suyu mu?
Dialogue: 0,0:04:55.34,0:04:59.78,Main,,0,0,0,,Acaba bu şekilde dev fil\Nüzerine su serpiyor olabilir mi?
Dialogue: 0,0:05:03.16,0:05:06.95,Main,,0,0,0,,Şehir de orman da bu seviyelerde\Nsuya adapte olmuş gibi.
Dialogue: 0,0:05:06.95,0:05:11.44,Main,,0,0,0,,Çok mantıklı... \NSu seviyesine bakılırsa haklı gibisin.
Dialogue: 0,0:05:11.84,0:05:14.83,Main,,0,0,0,,Yani her gün olan bir şey mi bu?
Dialogue: 0,0:05:19.96,0:05:24.05,Main,,0,0,0,,Böyle bardaktan boşalırcasına\Nbir yağmura her gün kim katlanır?!
Dialogue: 0,0:05:24.05,0:05:28.21,Main,,0,0,0,,Hemen herkesi bulup\Nbu adadan gitmemiz lazım!
Dialogue: 0,0:05:29.68,0:05:32.96,Main,,0,0,0,,Luffy'i gördüm! Şehrin kıyısında!
Dialogue: 0,0:05:32.96,0:05:36.25,Main,,0,0,0,,Nami-köpek kız ve\Nzıplayan tavşan da onunla birlikte!
Dialogue: 0,0:05:36.88,0:05:39.92,Main,,0,0,0,,Luffy'i kandırmışlar, inlerine götürüyorlar...
Dialogue: 0,0:05:43.00,0:05:44.54,Main,,0,0,0,,Ne oldu Usopp?!
Dialogue: 0,0:05:44.54,0:05:47.43,Main,,0,0,0,,Luffy'i biraz yediler!
Dialogue: 0,0:05:47.43,0:05:50.20,Main,,0,0,0,,Ne?! Yani gerçekten de...
Dialogue: 0,0:05:50.56,0:05:52.60,Main,,0,0,0,,Su çok yakında çekilir.
Dialogue: 0,0:06:09.00,0:06:10.14,Flashbacks,,0,0,0,,Burada olduğunu biliyorum!
Dialogue: 0,0:06:10.76,0:06:12.78,Flashbacks,,0,0,0,,Değil diyorum sana!
Dialogue: 0,0:06:16.22,0:06:19.66,Flashbacks,,0,0,0,,Getir onu hemen\Nyoksa ülkeni paramparça ederim!
Dialogue: 0,0:06:20.48,0:06:23.48,Flashbacks,,0,0,0,,Neden bahsediyorsun\Nbilmiyorum bile!
Dialogue: 0,0:06:23.90,0:06:26.12,Flashbacks,,0,0,0,,Bilmiyorum dedim!
Dialogue: 0,0:06:26.12,0:06:28.27,Flashbacks,,0,0,0,,Daha ne bekliyorsun benden?!
Dialogue: 0,0:06:50.36,0:06:51.57,Main,,0,0,0,,Kimdi şu...
Dialogue: 0,0:06:51.57,0:06:55.20,Main,,0,0,0,,Hani şu adını söylemiştiniz,\Nbu ülkeye saldıran kişi...
Dialogue: 0,0:06:55.82,0:06:56.82,Main,,0,0,0,,Jack.
Dialogue: 0,0:06:57.96,0:07:00.64,Main,,0,0,0,,Ölüm ilanını birkaç gün önce\Ngazetede gördüm.
Dialogue: 0,0:07:04.46,0:07:08.55,Main,,0,0,0,,Dediğine göre Jack\Nbu ülkeyi yağmaladıktan sonra...
Dialogue: 0,0:07:08.55,0:07:13.26,Main,,0,0,0,,...Doflamingo'yu taşıyan dört\NDonanma gemisine saldırmış...
Dialogue: 0,0:07:13.91,0:07:17.52,Main,,0,0,0,,...ve ikisini batırmış ama\Ngeri kalanlar karşılık vermişler.
Dialogue: 0,0:07:17.52,0:07:20.59,Main,,0,0,0,,Ne?! Dressrosa'da mıymış?!
Dialogue: 0,0:07:21.44,0:07:25.97,Main,,0,0,0,,Bir donanma amiralinin ve eski filo\Namiralinin bulunduğu gemilere saldırmak...
Dialogue: 0,0:07:25.97,0:07:28.40,Main,,0,0,0,,...aklı olan birinin yapacağı bir şey değil.
Dialogue: 0,0:07:30.98,0:07:33.66,Main,,0,0,0,,Gazetede ölümünün\Nhenüz onaylanmadığını söylüyordu.
Dialogue: 0,0:07:34.10,0:07:35.72,Main,,0,0,0,,Bana kalırsa hâlâ hayatta.
Dialogue: 0,0:07:40.28,0:07:43.54,Main,,0,0,0,,Jack'i asla affetmeyeceğiz!
Dialogue: 0,0:07:50.98,0:07:52.58,Main,,0,0,0,,Sis de amma yoğunlaştı.
Dialogue: 0,0:07:52.97,0:07:54.88,Main,,0,0,0,,Zoro'lar da orada mı olacaklar?
Dialogue: 0,0:07:55.22,0:07:56.26,Main,,0,0,0,,Muhtemelen.
Dialogue: 0,0:07:57.02,0:07:59.93,Main,,0,0,0,,Gizli kalemize\Ngiden yolu onlara söyledim.
Dialogue: 0,0:07:59.93,0:08:01.06,Main,,0,0,0,,{\fad(150,150)}Shambles!
Dialogue: 0,0:07:59.93,0:08:01.06,Attack,,0,0,0,,{\fad(150,150)}Karmaşa
Dialogue: 0,0:08:06.58,0:08:08.23,Main,,0,0,0,,Kimleri görüyorum!
Dialogue: 0,0:08:08.23,0:08:12.07,Main,,0,0,0,,Hey, Luffy! Nereni yediler?!\NElin ayağın hâlâ sende mi?!
Dialogue: 0,0:08:12.94,0:08:17.44,Main,,0,0,0,,Bana bak Nami-köpek kadın!\NYanında duran bizim kaptanımız!
Dialogue: 0,0:08:18.96,0:08:21.03,Main,,0,0,0,,Ne güzel de yiyecektiniz değil mi?!
Dialogue: 0,0:08:21.03,0:08:23.40,Main,,0,0,0,,Zor yediririm size, yırtıcı yosmalar!
Dialogue: 0,0:08:25.78,0:08:29.02,Main,,0,0,0,,Hemen onu ve diğer dostlarımızı\Nbize vermezseniz...
Dialogue: 0,0:08:29.02,0:08:31.16,Main,,0,0,0,,...bu üç kılıcın kınından\Nne kadar hızlı çıktığını göreceksiniz!
Dialogue: 0,0:08:32.24,0:08:33.60,Main,,0,0,0,,İnanamıyorum size.
Dialogue: 0,0:08:34.32,0:08:36.73,Main,,0,0,0,,Bir şeyleri yanlış anladınız sanırım.
Dialogue: 0,0:08:36.73,0:08:40.37,Main,,0,0,0,,Ama ziyani yok,\Ngideceğimiz yere vardık bile.
Dialogue: 0,0:08:40.37,0:08:40.92,Main,,0,0,0,,Ne?
Dialogue: 0,0:08:41.47,0:08:43.94,Main,,0,0,0,,Şu tarafa, sisin içine dikkatlice bakın...
Dialogue: 0,0:08:46.34,0:08:49.04,Main,,0,0,0,,Muhafızları ve\Normana açılan kapıyı göreceksiniz.
Dialogue: 0,0:08:49.04,0:08:51.38,Main,,0,0,0,,Wanda! Onlar-gara da kim?!
Dialogue: 0,0:08:51.88,0:08:54.02,Main,,0,0,0,,Balina Ormanı'na sızanlar mı?!
Dialogue: 0,0:08:57.54,0:08:59.00,Main,,0,0,0,,Kötü bir niyetleri yoktu!
Dialogue: 0,0:08:59.36,0:09:02.52,Main,,0,0,0,,Karşılama Çanı \Narıza yüzünden çalmayınca...
Dialogue: 0,0:09:02.52,0:09:04.89,Main,,0,0,0,,...içlerinden biri \NBalina Ormanı'nda kaybolmuş!
Dialogue: 0,0:09:04.89,0:09:07.92,Main,,0,0,0,,Kapıyı açıp herkese haber salın!
Dialogue: 0,0:09:08.34,0:09:10.56,Main,,0,0,0,,Hasır Şapkalar geldi!
Dialogue: 0,0:09:10.56,0:09:12.84,Main,,0,0,0,,Ne? Onlar-gara mı?!
Dialogue: 0,0:09:17.70,0:09:22.87,Captions,,0,0,175,,{\fad(700,0)}Kalenin İçi
Dialogue: 0,0:09:20.36,0:09:21.28,Secondary,,0,0,3,,Nami!
Dialogue: 0,0:09:22.02,0:09:22.87,Secondary,,0,0,3,,Nami!
Dialogue: 0,0:09:23.80,0:09:24.82,Secondary,,0,0,0,,Nami!!
Dialogue: 0,0:09:27.42,0:09:29.28,Main,,0,0,0,,Luffy'ler geldi!
Dialogue: 0,0:09:29.78,0:09:31.10,Main,,0,0,0,,Sonunda geldiler!
Dialogue: 0,0:09:36.28,0:09:39.22,Main,,0,0,0,,Nami! Luffy'ler sonunda geldi diyorum!
Dialogue: 0,0:09:39.82,0:09:41.82,Main,,0,0,0,,Hepsi de sağ salim geldi!
Dialogue: 0,0:09:44.44,0:09:47.23,Main,,0,0,0,,Geldiler mi?! Sahiden mi Chopper?!
Dialogue: 0,0:09:47.80,0:09:49.70,Main,,0,0,0,,Kale kapısındalar şimdi!
Dialogue: 0,0:09:51.93,0:09:56.40,Main,,0,0,0,,Dostlarınız geldi demek...\NŞükürler olsun.
Dialogue: 0,0:09:56.40,0:09:57.50,Main,,0,0,0,,Nami!
Dialogue: 0,0:09:59.88,0:10:00.88,Main,,0,0,0,,Özür dilerim.
Dialogue: 0,0:10:01.42,0:10:03.32,Main,,0,0,0,,Çok önemli misafirlerimiz!
Dialogue: 0,0:10:03.64,0:10:06.82,Main,,0,0,0,,Yüce kurtarıcılarımızın\Ndostlarını karşılamaya hazırlanın!
Dialogue: 0,0:10:09.26,0:10:12.44,Main,,0,0,0,,Garchu!
Dialogue: 0,0:10:15.94,0:10:17.82,Main,,0,0,0,,Garchu!
Dialogue: 0,0:10:17.82,0:10:20.42,Main,,0,0,0,,Hoş geldiniz, Hasır Şapka tayfası!
Dialogue: 0,0:10:20.73,0:10:23.73,Main,,0,0,0,,Garchu!
Dialogue: 0,0:10:25.70,0:10:27.52,Main,,0,0,0,,Hoş geldiniz!
Dialogue: 0,0:10:31.97,0:10:33.55,Main,,0,0,0,,Ne? Ne?!
Dialogue: 0,0:10:37.17,0:10:39.59,Main,,0,0,0,,Vay canına, işe bak!
Dialogue: 0,0:10:39.59,0:10:41.70,Main,,0,0,0,,Ortam epey neşeli!
Dialogue: 0,0:10:41.70,0:10:44.02,Main,,0,0,0,,Bize böyle söylenmedi!
Dialogue: 0,0:10:44.02,0:10:48.08,Main,,0,0,0,,Garchu!
Dialogue: 0,0:10:50.20,0:10:52.69,Main,,0,0,0,,Garchu!
Dialogue: 0,0:10:54.03,0:10:55.57,Main,,0,0,0,,Garchu da ne demek?
Dialogue: 0,0:10:55.57,0:10:58.75,Main,,0,0,0,,İnsanlardan nefret eden\Nbir kabile değil miydiniz?
Dialogue: 0,0:11:00.85,0:11:02.15,Main,,0,0,0,,Nefret ha?
Dialogue: 0,0:11:03.31,0:11:07.65,Main,,0,0,0,,Bu muhtemelen öteki Minkleri\Nbilmeyen kişilerin korku ve düşüncesi.
Dialogue: 0,0:11:07.65,0:11:09.31,Main,,0,0,0,,Öteki Minkler mi?
Dialogue: 0,0:11:09.31,0:11:13.99,Main,,0,0,0,,Bize göre siz-tiara'lar\Naz tüylü Maymun Minkler'siniz.
Dialogue: 0,0:11:15.21,0:11:17.62,Main,,0,0,0,,Aynı Mink Kabilesi'nin parçası, farklı tür.
Dialogue: 0,0:11:17.62,0:11:21.96,Main,,0,0,0,,Yani biz insanlar\NMaymun Minkler'iz öyle mi?
Dialogue: 0,0:11:21.96,0:11:22.93,Main,,0,0,0,,Aynen öyle.
Dialogue: 0,0:11:23.37,0:11:28.43,Main,,0,0,0,,Biz ırka göre değil\Nkaraktere göre değer biçeriz.
Dialogue: 0,0:11:28.43,0:11:30.51,Main,,0,0,0,,Garchu!
Dialogue: 0,0:11:30.89,0:11:34.49,Main,,0,0,0,,Biz vücudumuzu saran tüylerle\Ngurur duyarız...
Dialogue: 0,0:11:34.49,0:11:36.59,Main,,0,0,0,,...ama siz-tiara'ların da bu güzel...
Dialogue: 0,0:11:37.84,0:11:41.11,Main,,0,0,0,,...az tüylü kürklerini de\Niçimizde seven epey kişi vardır.
Dialogue: 0,0:11:41.11,0:11:42.64,Main,,0,0,0,,Oradalar!
Dialogue: 0,0:11:42.64,0:11:45.67,Main,,0,0,0,,Bakın, Nami'yle Chopper!
Dialogue: 0,0:11:45.67,0:11:48.42,Main,,0,0,0,,Şükürler olsun ki iyiler!
Dialogue: 0,0:11:50.05,0:11:51.52,Main,,0,0,0,,Nami!
Dialogue: 0,0:11:53.02,0:11:55.26,Main,,0,0,0,,Nami! \NSenin adına çok sevindim, Garchu!
Dialogue: 0,0:11:55.26,0:11:56.59,Main,,0,0,0,,Garchu!
Dialogue: 0,0:12:00.27,0:12:02.90,Main,,0,0,0,,Yakalandım! İzin verin!
Dialogue: 0,0:12:02.90,0:12:05.79,Main,,0,0,0,,Anladım Garchu, Garchu!
Dialogue: 0,0:12:05.79,0:12:08.31,Main,,0,0,0,,Ne iyi değil mi, Garchu!
Dialogue: 0,0:12:11.97,0:12:16.16,Main,,0,0,0,,Bunlar bildiğin sevgi yumağı be?!\NResmen ne bekliyordum ne buldum!
Dialogue: 0,0:12:18.12,0:12:19.58,Main,,0,0,0,,Luffy!
Dialogue: 0,0:12:19.58,0:12:21.49,Main,,0,0,0,,Millet!
Dialogue: 0,0:12:21.49,0:12:24.63,Main,,0,0,0,,Vay be, sizi gördüğüme çok sevindim!
Dialogue: 0,0:12:24.63,0:12:26.67,Main,,0,0,0,,Nami! Chopper!
Dialogue: 0,0:12:27.85,0:12:29.17,Main,,0,0,0,,Usopp!
Dialogue: 0,0:12:29.67,0:12:31.41,Main,,0,0,0,,Beklettik biraz, Chopper!
Dialogue: 0,0:12:31.41,0:12:34.03,Main,,0,0,0,,Sanji de, Brook da, Momo da iyiler ha!
Dialogue: 0,0:12:45.34,0:12:46.47,Main,,0,0,0,,Özür dilerim!
Dialogue: 0,0:12:50.85,0:12:52.42,Main,,0,0,0,,Sanji-kun...
Dialogue: 0,0:12:57.76,0:13:01.37,Main,,0,0,0,,Güneş batıyor!\NBugün daha fazla devam edemeyiz-{\i1}de gozaru{\i0}!
Dialogue: 0,0:13:01.37,0:13:05.35,Main,,0,0,0,,Gemiye dönüp yarın deneyelim artık!
Dialogue: 0,0:13:11.71,0:13:15.01,Main,,0,0,0,,Yarasın!\NBuyur, biraz daha iç!
Dialogue: 0,0:13:15.90,0:13:16.78,Main,,0,0,0,,Hiç çekinme!
Dialogue: 0,0:13:16.78,0:13:21.85,Main,,0,0,0,,Özel Maymun Sake'miz.\NOrmanın bereketli meyvelerinden yapılıyor.
Dialogue: 0,0:13:22.51,0:13:24.55,Main,,0,0,0,,İçimi harika!
Dialogue: 0,0:13:27.07,0:13:29.80,Main,,0,0,0,,İçkimi içemiyorum sizin yüzünüzden,\Nsürtünüp durmayın!
Dialogue: 0,0:13:29.80,0:13:32.17,Main,,0,0,0,,Ne?! Oynayalım hadi!
Dialogue: 0,0:13:32.17,0:13:33.97,Main,,0,0,0,,Sevgi ısırıklarıma engel olamazsın!
Dialogue: 0,0:13:33.97,0:13:35.77,Main,,0,0,0,,İzin ver garchu!
Dialogue: 0,0:13:35.77,0:13:37.25,Main,,0,0,0,,Öpeyim seni!
Dialogue: 0,0:13:37.25,0:13:39.23,Main,,0,0,0,,Kapayın çenenizi, çocuklaşmayın!
Dialogue: 0,0:13:39.23,0:13:41.21,Main,,0,0,0,,Sinirlenme Zoro!
Dialogue: 0,0:13:42.49,0:13:46.10,Main,,0,0,0,,Ne güzel ağırlıyorlar bizi bak,\Nkabalığın lüzumu yok!
Dialogue: 0,0:13:46.10,0:13:52.11,Main,,0,0,0,,Bu tarz kültürel farklılıkları maruz görün.\NMinklemek bizim için dostluk göstergesidir.
Dialogue: 0,0:13:52.11,0:13:54.86,Main,,0,0,0,,Acayip lezzetli!\NNe eti bu?
Dialogue: 0,0:13:54.86,0:13:59.09,Main,,0,0,0,,Su Aygırı. Bunlar da kertenkele,\Ntimsah ve kurbağa.
Dialogue: 0,0:13:59.49,0:14:02.25,Main,,0,0,0,,Kürkleri olan hayvanları yemiyoruz.
Dialogue: 0,0:14:02.25,0:14:05.99,Main,,0,0,0,,Her şey tamam da,\Nbizi niye bu kadar sıcak karşıladınız?
Dialogue: 0,0:14:05.99,0:14:09.36,Main,,0,0,0,,Siz-tia'lar kurtarıcımızsınız da ondan!
Dialogue: 0,0:14:09.36,0:14:12.16,Main,,0,0,0,,Kurtarıcı ha... Ne oldu ki burada?
Dialogue: 0,0:14:12.84,0:14:17.97,Main,,0,0,0,,Hayır!!!
Dialogue: 0,0:14:26.98,0:14:28.09,Main,,0,0,0,,Brook!
Dialogue: 0,0:14:29.28,0:14:32.95,Main,,0,0,0,,Ne rahatladım var ya!\NGazeteden haberinizi almıştım!
Dialogue: 0,0:14:33.33,0:14:35.62,Main,,0,0,0,,İyi olmanıza çok sevindim!
Dialogue: 0,0:14:35.62,0:14:36.99,Main,,0,0,0,,Luffy-san!
Dialogue: 0,0:14:36.99,0:14:39.45,Main,,0,0,0,,Ne oldu sana böyle,\Nelbiselerin paramparça olmuş!
Dialogue: 0,0:14:39.45,0:14:42.03,Main,,0,0,0,,Sanji-san için çok özür dilerim!
Dialogue: 0,0:14:42.51,0:14:44.43,Main,,0,0,0,,Karşınıza çıkacak yüzüm yok!
Dialogue: 0,0:14:44.97,0:14:47.17,Main,,0,0,0,,Gerçi normalde de bir yüzüm yok ya...
Dialogue: 0,0:14:47.17,0:14:50.07,Main,,0,0,0,,Momo da sizinle değil miydi?
Dialogue: 0,0:14:50.07,0:14:54.14,Main,,0,0,0,,Evet, hali vakti yerinde ama o biraz...
Dialogue: 0,0:14:54.14,0:14:56.23,Main,,0,0,0,,...Minkleri sevmiyor.
Dialogue: 0,0:14:57.44,0:14:59.87,Main,,0,0,0,,Bu iyi insanları neden sevmiyor ki?
Dialogue: 0,0:14:59.87,0:15:03.58,Main,,0,0,0,,Kendini odasına kapattı ve hiç dışarı çıkmıyor.
Dialogue: 0,0:15:03.58,0:15:05.59,Main,,0,0,0,,Ama böylesi bizim için daha iyi.
Dialogue: 0,0:15:05.59,0:15:06.09,Main,,0,0,0,,Ha?
Dialogue: 0,0:15:06.45,0:15:08.47,Main,,0,0,0,,Luffy-san, biraz konuşabilir miyiz?
Dialogue: 0,0:15:09.91,0:15:11.67,Main,,0,0,0,,Bu taraftan.
Dialogue: 0,0:15:12.89,0:15:16.19,Main,,0,0,0,,Zou'ya yeni giriş yapanlar,\Nbu taraftan lütfen!
Dialogue: 0,0:15:18.02,0:15:20.43,Main,,0,0,0,,Kin'emon-san şu an nerede?
Dialogue: 0,0:15:20.91,0:15:23.34,Main,,0,0,0,,Çok yakında burada olması lazım.
Dialogue: 0,0:15:23.34,0:15:26.47,Main,,0,0,0,,Anlıyorum. Çok iyi öyleyse.
Dialogue: 0,0:15:26.91,0:15:33.32,Main,,0,0,0,,Bu ülkede "samuray" ve "Wano Krallığı" gibi\Nsözcükleri kullanmamaya çalışın.
Dialogue: 0,0:15:33.77,0:15:35.10,Main,,0,0,0,,Hatta yapabiliyorsanız tamamen silin aklınızdan.
Dialogue: 0,0:15:36.81,0:15:41.54,Main,,0,0,0,,Keza bu sözleri sarf ederseniz\Npek çok kişiyi gücendirebilir...
Dialogue: 0,0:15:41.54,0:15:44.36,Main,,0,0,0,,...sizden nefret etmelerine,\Nsize öfkelenmelerine neden olabilirsiniz.
Dialogue: 0,0:15:44.85,0:15:46.46,Main,,0,0,0,,Gücendirmek mi?
Dialogue: 0,0:15:46.46,0:15:48.32,Main,,0,0,0,,Nefret ve öfke mi?!
Dialogue: 0,0:15:48.32,0:15:50.17,Main,,0,0,0,,Samurayın nesi varmış?!
Dialogue: 0,0:15:50.17,0:15:53.41,Main,,0,0,0,,İşin aslı bu ülke...
Dialogue: 0,0:16:01.41,0:16:03.03,Main,,0,0,0,,Bulduk seni...
Dialogue: 0,0:16:06.46,0:16:08.73,Main,,0,0,0,,Baron Ceset!
Dialogue: 0,0:16:08.73,0:16:10.93,Main,,0,0,0,,Geldiler!
Dialogue: 0,0:16:10.93,0:16:12.16,Main,,0,0,0,,Ceset mi?!
Dialogue: 0,0:16:14.16,0:16:17.96,Flashbacks,,0,0,0,,Sağ Böğür Ormanı'na ulaşın!\NDostunuz-tiara'nın cesedini orada bulacaksınız!
Dialogue: 0,0:16:17.96,0:16:20.41,Flashbacks,,0,0,0,,Ce-Ceset mi?!
Dialogue: 0,0:16:21.34,0:16:23.38,Main,,0,0,0,,Dostunuzun cesedi derken...
Dialogue: 0,0:16:23.38,0:16:25.14,Main,,0,0,0,,Brook'dan mı bahsediyormuş!?
Dialogue: 0,0:16:26.49,0:16:28.91,Main,,0,0,0,,Sevgiden ona böyle sesleniyoruz.
Dialogue: 0,0:16:28.91,0:16:31.18,Main,,0,0,0,,Epey kafa karıştırıcı.
Dialogue: 0,0:16:31.18,0:16:33.17,Main,,0,0,0,,Açık konuşmak gerekirse\Nbeni acayip şaşırttı...
Dialogue: 0,0:16:33.53,0:16:37.61,Main,,0,0,0,,Dünyada onunki gibi\Nbir ırk olduğunu bilmiyordum!
Dialogue: 0,0:16:40.21,0:16:43.08,Main,,0,0,0,,Yapmayın! Kurtarın beni!
Dialogue: 0,0:16:43.08,0:16:47.96,Main,,0,0,0,,Biz Köpek Mink'ler, ke-kemiklere çok düşkünüzdür!
Dialogue: 0,0:16:43.69,0:16:46.29,Secondary,,0,0,0,,Çiğnemeyi bırakın!
Dialogue: 0,0:16:48.15,0:16:49.57,Main,,0,0,0,,Aptallık bu...
Dialogue: 0,0:16:52.76,0:16:56.03,Main,,0,0,0,,Luffy, sahi ya, Tra-o nerede?
Dialogue: 0,0:16:56.34,0:16:58.46,Main,,0,0,0,,Ormana gitti... Ayı Ormanı'na...
Dialogue: 0,0:16:58.46,0:17:01.50,Main,,0,0,0,,Onu bunu boşverin de,\NSanji-kun meselesini ne yapacağız?!
Dialogue: 0,0:17:03.48,0:17:07.94,Main,,0,0,0,,Dediğim gibi, not bırakmış ya işte.\Nİşler bir şekilde yoluna girer.
Dialogue: 0,0:17:09.60,0:17:11.75,Main,,0,0,0,,Kaçırılmamış sonuçta.
Dialogue: 0,0:17:11.75,0:17:15.08,Main,,0,0,0,,Hiç normal görünmediği için\Nendişeleniyorum ya ben de!
Dialogue: 0,0:17:15.08,0:17:16.12,Main,,0,0,0,,Özür dilerim!
Dialogue: 0,0:17:16.60,0:17:19.12,Main,,0,0,0,,Elimizden bir şey gelmedi!
Dialogue: 0,0:17:20.32,0:17:22.33,Main,,0,0,0,,Ağlamana gerek yok yahu!
Dialogue: 0,0:17:22.33,0:17:27.64,Main,,0,0,0,,İşin aslı şu anda acayip\Nkafamız karışmış durumda.
Dialogue: 0,0:17:28.08,0:17:31.33,Main,,0,0,0,,Anlattıklarınızdan üstünkörü\Nbir şeyler anladık ama o kadar.
Dialogue: 0,0:17:31.33,0:17:32.64,Main,,0,0,0,,Aynen öyle!
Dialogue: 0,0:17:32.64,0:17:37.79,Main,,0,0,0,,Son konuşmamızda Big Mom'ın gemisiyle\Nkarşı karşıya olduğunuzu söylemiştiniz.
Dialogue: 0,0:17:37.79,0:17:44.14,Main,,0,0,0,,Tam Zou'ya geldik derken karşımıza filin sırtında\Nkonuşabilen hayvanlar ve mahvolmuş bir şehir çıktı!
Dialogue: 0,0:17:44.14,0:17:48.74,Main,,0,0,0,,Mink Kabilesi'ni düşmanımız sanırken birden\Nkendimizi hoş geldin partilerinde bulduk!
Dialogue: 0,0:17:49.16,0:17:52.35,Main,,0,0,0,,Bizden kurtarıcılarının dostları\Ndiye bahsediyorlar!
Dialogue: 0,0:17:52.35,0:17:55.72,Main,,0,0,0,,Her şeyi en başından\Nanlatabilir misin, Nami?
Dialogue: 0,0:17:56.34,0:18:01.98,Main,,0,0,0,,11 gün önce Dressrosa'dan\Nayrıldığınızdan beri başınızdan neler geçti?
Dialogue: 0,0:18:03.92,0:18:07.11,Main,,0,0,0,,Haklısınız, biraz üzgün olduğum için\Nkafanızı karıştırdım sanırım.
Dialogue: 0,0:18:07.98,0:18:11.00,Main,,0,0,0,,Peki, her şeyi olduğu gibi anlatacağım.
Dialogue: 0,0:18:11.31,0:18:15.11,Main,,0,0,0,,O gün Dressrosa kıyısında karşılaştığımız şey...
Dialogue: 0,0:18:16.54,0:18:20.44,Main,,0,0,0,,...Big Mom Korsanları'nın\Ndevasa şarkı söyleyen gemisiydi!
Dialogue: 0,0:18:20.44,0:18:21.38,Main,,0,0,0,,Şarkı söyleyen mi?!
Dialogue: 0,0:18:23.00,0:18:25.78,English - OP18,,0,0,0,,♪ Ship! Ship! ♪
Dialogue: 0,0:18:28.76,0:18:33.72,Main,,0,0,0,,Savaşçıları arasında Balık Adam Adası'nda\NLuffy'nin karşılaştığı ikili de vardı.
Dialogue: 0,0:18:34.44,0:18:37.33,Main,,0,0,0,,Mama! Caesar'ı gördüm-gao!
Dialogue: 0,0:18:37.33,0:18:41.93,Main,,0,0,0,,Gemilerini batırıp\Nyalnızca Caesar'ı alalım-soir!
Dialogue: 0,0:18:43.09,0:18:44.50,Main,,0,0,0,,Ve diğer bir kişi de...
Dialogue: 0,0:18:47.58,0:18:49.60,Main,,0,0,0,,En Kötü Nesil'den...
Dialogue: 0,0:18:53.03,0:18:54.70,Main,,0,0,0,,Capone "Gang" Bege idi!
Dialogue: 0,0:18:54.70,0:18:55.55,Main,,0,0,0,,Bege mi?
Dialogue: 0,0:18:55.55,0:18:58.98,Main,,0,0,0,,Sanırım Big Mom'ın\Nhimayesi altına girmişler.
Dialogue: 0,0:18:59.82,0:19:05.03,Main,,0,0,0,,Caesar için gelmişlerdi ama\NCaesar da yakalanmaktan korkuyordu.
Dialogue: 0,0:19:05.66,0:19:08.63,Main,,0,0,0,,Ama maalesef atlatabileceğimiz\Nbirileri de değillerdi.
Dialogue: 0,0:19:09.52,0:19:12.66,Main,,0,0,0,,Bir şeyler yapmazsak\Nsuyun dibini boylamamız an meselesiydi!
Dialogue: 0,0:19:13.14,0:19:15.03,Main,,0,0,0,,Coup de Burst'le kaçalım buradan!
Dialogue: 0,0:19:15.19,0:19:16.76,Main,,0,0,0,,Gaon Topu'na ne dersiniz?!
Dialogue: 0,0:19:16.76,0:19:20.70,Main,,0,0,0,,Olmaz! Yeterli kolamız yok!\NHem benim bir planım var!
Dialogue: 0,0:19:22.02,0:19:24.40,Main,,0,0,0,,Fikrin varsa söyle işte!
Dialogue: 0,0:19:24.72,0:19:27.04,Main,,0,0,0,,Hayatta kalmak istiyorsan\Nsen de yardım edeceksin!
Dialogue: 0,0:19:28.71,0:19:31.68,Main,,0,0,0,,Brook! Onlarla pupa tarafında savaşıp\Nsavunmalarını düşürmelerini sağlayalım!
Dialogue: 0,0:19:39.92,0:19:41.06,Main,,0,0,0,,{\fad(150,150)}Soul Parade!
Dialogue: 0,0:19:39.92,0:19:41.06,Attack,,0,0,0,,{\fad(150,150)}Ruh Geçidi
Dialogue: 0,0:19:47.83,0:19:50.37,Main,,0,0,0,,Cho-Cho-Cho-Cho-Cho... Chopperemon?!
Dialogue: 0,0:19:50.37,0:19:52.24,Main,,0,0,0,,Yakala Chopper!
Dialogue: 0,0:19:57.10,0:19:59.61,Main,,0,0,0,,Yapma! Bırak beni!
Dialogue: 0,0:20:00.73,0:20:04.75,Main,,0,0,0,,Kumaş parçası gibi nasıl kullanırsın beni?!\NBunu yazdım bir kenara!
Dialogue: 0,0:20:05.11,0:20:09.91,Main,,0,0,0,,Direnmeyi bırakmazsan\Nseni kurtarmayız!
Dialogue: 0,0:20:10.97,0:20:12.02,Main,,0,0,0,,Yapma!
Dialogue: 0,0:20:12.02,0:20:14.99,Main,,0,0,0,,Senindir, Sanji!
Dialogue: 0,0:20:19.66,0:20:21.41,Main,,0,0,0,,Caesar bu-gao!
Dialogue: 0,0:20:21.41,0:20:23.17,Main,,0,0,0,,Ne yapıyor bunlar-bon?!
Dialogue: 0,0:20:23.17,0:20:25.27,Main,,0,0,0,,Güzel atış, Chopper!
Dialogue: 0,0:20:28.03,0:20:29.17,Main,,0,0,0,,Nasıl uçabiliyor bu?!
Dialogue: 0,0:20:31.75,0:20:33.75,Main,,0,0,0,,{\fad(150,150)}Poele a Frire...
Dialogue: 0,0:20:31.75,0:20:33.75,Attack,,0,0,0,,{\fad(150,150)}Kızartma Tavası
Dialogue: 0,0:20:37.25,0:20:39.20,Main,,0,0,0,,{\fad(150,150)}...Spectre!
Dialogue: 0,0:20:37.25,0:20:39.20,Attack,,0,0,0,,{\fad(150,150)}Spektrumu
Dialogue: 0,0:20:43.25,0:20:44.56,Main,,0,0,0,,Olamaz-gao!
Dialogue: 0,0:20:44.56,0:20:46.09,Main,,0,0,0,,Gemiyi döndürün-bon!
Dialogue: 0,0:20:51.37,0:20:53.48,Default,,0,0,0,,Gemi!
Dialogue: 0,0:20:54.21,0:20:56.30,Main,,0,0,0,,Sancak tarafı hasar aldı!
Dialogue: 0,0:20:56.30,0:20:58.70,Main,,0,0,0,,Pekâlâ, benim sıram!
Dialogue: 0,0:20:59.24,0:21:00.35,Main,,0,0,0,,{\fad(150,150)}Clima-Tact
Dialogue: 0,0:20:59.24,0:21:00.35,Attack,,0,0,0,,{\fad(150,150)}İklim Aygıtı
Dialogue: 0,0:21:01.55,0:21:02.51,Main,,0,0,0,,{\fad(150,150)}Weather...
Dialogue: 0,0:21:01.55,0:21:02.51,Attack,,0,0,0,,{\fad(150,150)}Hava...
Dialogue: 0,0:21:02.97,0:21:03.83,Main,,0,0,0,,{\fad(150,150)}...Egg!
Dialogue: 0,0:21:02.97,0:21:03.83,Attack,,0,0,0,,{\fad(150,150)}...Yumurtası
Dialogue: 0,0:21:05.78,0:21:08.41,Main,,0,0,0,,Çatla, yağmur bulutları!
Dialogue: 0,0:21:19.08,0:21:21.12,Main,,0,0,0,,{\fad(150,150)}Rain Tempo!
Dialogue: 0,0:21:19.08,0:21:21.12,Attack,,0,0,0,,{\fad(150,150)}Yağmur Tempo
Dialogue: 0,0:21:22.43,0:21:25.81,Main,,0,0,0,,Hava neden yalnızca\No bölgede değişti-bon?!
Dialogue: 0,0:21:25.81,0:21:28.57,Main,,0,0,0,,Onları kaybedeceğiz-gao!
Dialogue: 0,0:21:32.87,0:21:34.63,Main,,0,0,0,,Helal!
Dialogue: 0,0:21:35.89,0:21:38.44,Main,,0,0,0,,Hiç de bile utanmadım, hergele seni!
Dialogue: 0,0:21:38.80,0:21:40.60,Main,,0,0,0,,İşte böyle tuttuğunu koparacaksın!
Dialogue: 0,0:21:40.60,0:21:42.40,Main,,0,0,0,,Süpermiş!
Dialogue: 0,0:21:42.40,0:21:43.55,Main,,0,0,0,,Bravo!
Dialogue: 0,0:21:43.55,0:21:46.68,Main,,0,0,0,,Yapmayın yahu!\NÖyle abartılacak bir şey yok yani...
Dialogue: 0,0:21:46.68,0:21:49.95,Main,,0,0,0,,Peki oradan Zou'ya ulaşmanız\Nkaç gün sürdü?
Dialogue: 0,0:21:50.31,0:21:51.95,Main,,0,0,0,,Ertesi günü Zou'ya ulaştık biz.
Dialogue: 0,0:21:52.35,0:21:54.56,Main,,0,0,0,,Şansımıza Zou\No tarihte yakınlardaymış.
Dialogue: 0,0:21:54.56,0:21:56.53,Main,,0,0,0,,10 gün öncesi yani.
Dialogue: 0,0:21:56.53,0:21:58.69,Main,,0,0,0,,Görebildiğim kadarıyla...
Dialogue: 0,0:21:58.69,0:22:03.06,Main,,0,0,0,,...Zou'daki yıkıntılar en fazla...
Dialogue: 0,0:22:03.06,0:22:05.51,Main,,0,0,0,,...iki haftadan biraz öncesine ait.
Dialogue: 0,0:22:06.80,0:22:08.24,Main,,0,0,0,,Aynen öyle.
Dialogue: 0,0:22:08.24,0:22:12.83,Main,,0,0,0,,Yani 10 gün önce ülkenin çoğu\Nhalihazırda yok edilmişti.
Dialogue: 0,0:22:13.57,0:22:17.83,Main,,0,0,0,,Ama o gün\NNamiler'in buraya ayak basışını...
Dialogue: 0,0:22:18.47,0:22:20.52,Main,,0,0,0,,...mucizeden başka bir şekilde\Ndillendiremiyorum!
Dialogue: 0,0:22:21.23,0:22:25.26,Main,,0,0,0,,Cesaretleri ve\NChopper'ın tıbbi deneyimi olmasa...
Dialogue: 0,0:22:25.26,0:22:31.06,Main,,0,0,0,,...Mokomo Düklüğü'ndeki her bir kişi\Nbiçare halde öldürülecekti.
Dialogue: 0,0:22:37.50,0:22:43.51,Main,,0,0,0,,Acınızın taze olduğunu biliyorum.\NYani konuşmak istemezseniz anlarız.
Dialogue: 0,0:22:44.35,0:22:46.46,Main,,0,0,0,,Hayır, her şeyi anlatacağım.
Dialogue: 0,0:22:46.46,0:22:49.65,Main,,0,0,0,,Siz-tia'ların her şeyi bilmeye hakkınız var.
Dialogue: 0,0:22:49.65,0:22:51.12,Secondary,,0,0,0,,Hey!
Dialogue: 0,0:22:51.72,0:22:53.06,Main,,0,0,0,,Millet!
Dialogue: 0,0:22:55.35,0:22:57.76,Main,,0,0,0,,Dük-sama uyandı!
Dialogue: 0,0:23:02.40,0:23:03.70,Main,,0,0,0,,Şükürler olsun!
Dialogue: 0,0:23:07.23,0:23:09.87,Main,,0,0,0,,Dük-sama... İyileşti...
Dialogue: 0,0:23:11.46,0:23:14.15,Main,,0,0,0,,Pekâlâ, hemen durumunu\Nkontrol etmeye gidelim!
Dialogue: 0,0:23:14.48,0:23:16.14,Main,,0,0,0,,Miyagi! Tristan!
Dialogue: 0,0:23:16.30,0:23:19.00,Main,,0,0,0,,Hemen geliyorum!
Dialogue: 0,0:23:19.00,0:23:22.79,Main,,0,0,0,,Vakit keçi gibi inatçılıkla\Nöğrenme vaktidir!
Dialogue: 0,0:23:23.49,0:23:25.46,Main,,0,0,0,,Miyagi-sensei, fazla zıplıyorsunuz!
Dialogue: 0,0:23:30.39,0:23:31.09,Main,,0,0,0,,Wanda!
Dialogue: 0,0:23:31.09,0:23:35.56,Main,,0,0,0,,Dük Inuarashi kurtarıcılarımıza\Nteşekkür etmek istiyormuş!
Dialogue: 0,0:23:35.56,0:23:36.81,Main,,0,0,0,,Peki, hemen geliyoruz!
Dialogue: 0,0:23:37.65,0:23:40.45,Main,,0,0,0,,Siz-tia'lar benimle gelir misiniz?!
Dialogue: 0,0:23:40.45,0:23:43.27,Main,,0,0,0,,Evet ama bu Inuarashi de kim?
Dialogue: 0,0:23:43.83,0:23:46.11,Main,,0,0,0,,Mokomo Düklüğü'nün dükü.
Dialogue: 0,0:23:46.65,0:23:48.95,Main,,0,0,0,,Yani bu ülkenin kralı!
Dialogue: 0,0:23:49.91,0:23:54.45,Main,,0,0,0,,Şehir yerlebir edildiğinden beri komadaydı.
Dialogue: 0,0:23:54.45,0:23:56.16,Main,,0,0,0,,Diğeri de öyle keza.
Dialogue: 0,0:23:57.46,0:23:58.57,Main,,0,0,0,,Diğeri mi?!
Dialogue: 0,0:23:59.09,0:24:02.46,Main,,0,0,0,,Evet, bu ülkenin iki kralı var!
Dialogue: 0,0:24:03.89,0:24:07.06,Main,,0,0,0,,"Gündüz Kralı" Dük Inuarashi!
Dialogue: 0,0:24:07.91,0:24:11.49,Main,,0,0,0,,"Gece Kralı" Nekomamushi Efendi!
Dialogue: 0,0:24:39.28,0:24:40.86,Main,,0,0,0,,Kaptan!
Dialogue: 0,0:24:40.86,0:24:43.19,Main,,0,0,0,,Bizim için geldin!
Dialogue: 0,0:24:44.03,0:24:45.30,Main,,0,0,0,,Kaptan!
Dialogue: 0,0:24:45.47,0:24:46.70,Main,,0,0,0,,Kaptan!
Dialogue: 0,0:24:47.78,0:24:51.83,Main,,0,0,0,,Kaptan, Doflamingo'yu yenmişsin, harika bir şey bu!
Dialogue: 0,0:24:52.27,0:24:54.94,Main,,0,0,0,,Hayır, onu aslında Hasır Şapka-ya...
Dialogue: 0,0:24:54.94,0:24:58.57,Main,,0,0,0,,Konuşacak çok şeyimiz var!\NOrmanın derinlerine geçelim.
Dialogue: 0,0:24:59.54,0:25:00.60,Main,,0,0,0,,Peki.
Dialogue: 0,0:25:01.86,0:25:06.43,Captions,,0,0,175,,{\fad(450,0)}Sağ Böğür Ormanı
Dialogue: 0,0:25:06.43,0:25:09.16,Main,,0,0,0,,Fakat iki hafta kadar önce\No olay gerçekleşti.
Dialogue: 0,0:25:13.41,0:25:16.76,Main,,0,0,0,,Tam olarak 17 gün önce oldu.
Dialogue: 0,0:25:17.47,0:25:21.46,Main,,0,0,0,,Evet, Bepo'ların ardından\Nilk kez bir buçuk ay sonra...
Dialogue: 0,0:25:21.46,0:25:25.23,Main,,0,0,0,,...Mokomo Düklüğü'nde\Nyeniden ziyaretçi çanı çalındı.
Dialogue: 0,0:25:25.97,0:25:27.17,Main,,0,0,0,,Fakat...
Dialogue: 0,0:25:27.87,0:25:29.47,Main,,0,0,0,,...bu aslında...
Dialogue: 0,0:25:29.47,0:25:33.24,Main,,0,0,0,,...belki de hiç duyulmamış\Nistila çanıydı!
Dialogue: 0,0:25:40.79,0:25:41.95,Main,,0,0,0,,Ne çanı bu?
Dialogue: 0,0:25:42.69,0:25:44.45,Main,,0,0,0,,İstila çanı!
Dialogue: 0,0:25:44.45,0:25:45.25,Main,,0,0,0,,Ne?!
Dialogue: 0,0:25:45.25,0:25:46.35,Main,,0,0,0,,İstila mı?
Dialogue: 0,0:25:46.35,0:25:49.15,Main,,0,0,0,,Daha gençsin-gara, o yüzden bilmemen normal.
Dialogue: 0,0:25:49.77,0:25:52.00,Main,,0,0,0,,Çok nadir çalınan bir çandır.
Dialogue: 0,0:25:52.25,0:25:55.26,Main,,0,0,0,,Kapı kırıldı! Korsanlar!\NDefedin onları!
Dialogue: 0,0:25:55.59,0:26:00.00,Main,,0,0,0,,Düşman ormanı da yararak\Nhuzurlu şehrimizi istila etti.
Dialogue: 0,0:26:01.43,0:26:05.61,Main,,0,0,0,,Bu alışılmadık hareketler karşısında\NZunesha kükredi!
Dialogue: 0,0:26:12.72,0:26:15.55,Main,,0,0,0,,Kimdi peki onlar?! Neden gelmişler?!
Dialogue: 0,0:26:15.55,0:26:22.86,Main,,0,0,0,,Düşman bizden sahip olmadığımız\Nbir şey istediğinde...
Dialogue: 0,0:26:22.86,0:26:25.36,Main,,0,0,0,,...bunu onlara nasıl verebiliriz ki?!
Dialogue: 0,0:26:28.81,0:26:31.75,Main,,0,0,0,,Haydi, onu derhal bize verin!
Dialogue: 0,0:26:31.75,0:26:36.64,Main,,0,0,0,,Bu ülkede Raizo adında bir\NWano Krallığı savaşçısı olduğunu biliyorum!
Dialogue: 0,0:26:37.27,0:26:41.99,OP11 Credits,,0,0,0,,Editing: Galaxy 9000\N\NTiming: Datenshi\NSewil\N\NQC: Mr Luffy,\NGalaxy 9000\N\NSoundtracking: Halee\N\NTC/Infoboxes: Datenshi\N\NTranslation: Yibis,\NCrunchyroll
