,0,0,0,100.0,100,0.0,0,1,1.8,0,2,22,22,18,1Style: Author,Impress BT,20.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.7,0.7,9,10,10,10,1Style: Attack,Duality,30.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.0,1.0,7,12,12,12,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.82,0:00:06.82,English - OP18,,0,0,0,,♪ Görmedim dünyanın sonunu kendi gözlerimle hiç. ♪Dialogue: 0,0:00:06.82,0:00:13.95,English - OP18,,0,0,0,,♪ O yüzden çıktım yola sizinle, bunu yapmak için! ♪Dialogue: 0,0:00:23.67,0:00:27.00,English - OP18,,0,0,0,,♪ Bir denizden diğerine yol alırken,...Dialogue: 0,0:00:29.06,0:00:31.85,English - OP18,,0,0,0,,...bunun sadece bir peri masalı olduğunu söylemek. ♪Dialogue: 0,0:00:31.85,0:00:38.78,English - OP18,,0,0,0,,♪ Gerçek, kurgudan daha tuhaf değil mi? ♪Dialogue: 0,0:00:39.94,0:00:43.18,English - OP18,,0,0,0,,♪ Fakat sırt çevirme hiçbirine. ♪Dialogue: 0,0:00:43.56,0:00:50.04,English - OP18,,0,0,0,,♪ Sağduyu dedikleri zihnidir toplulukların! ♪Dialogue: 0,0:00:51.36,0:00:57.41,English - OP18,,0,0,0,,♪ Görmedim dünyanın sonunu kendi gözlerimle hiç. ♪Dialogue: 0,0:00:57.41,0:01:01.96,English - OP18,,0,0,0,,♪ O yüzden gitmemiz lazım Kaptan Özgür-Ruh! ♪Dialogue: 0,0:01:01.96,0:01:04.67,English - OP18,,0,0,0,,♪ Kim demiş imkansız diye,...Dialogue: 0,0:01:04.67,0:01:07.75,English - OP18,,0,0,0,,...daha hiçbir şey başlamadan! ♪Dialogue: 0,0:01:07.75,0:01:12.72,English - OP18,,0,0,0,,♪ Her şeyi bilmek istiyorum ve şimdi bilebiliriz de... ♪Dialogue: 0,0:01:12.72,0:01:18.68,English - OP18,,0,0,0,,♪ Bilebiliriz, bilebilirsin! Şu anda... ♪Dialogue: 0,0:01:19.06,0:01:24.10,English - OP18,,0,0,0,,♪ Bilebiliriz, bilebilirim! Bu harika hissi... ♪Dialogue: 0,0:01:24.39,0:01:31.32,English - OP18,,0,0,0,,♪ Hemen, şimdi, bilebiliriz! ♪Dialogue: 0,0:01:37.34,0:01:38.64,English - OP18,,0,0,0,,♪ Evet, bilebiliriz! ♪Dialogue: 0,0:01:42.86,0:01:45.23,Main,,0,0,0,,Nekomamushi Efendi.Dialogue: 0,0:01:45.23,0:01:47.79,Main,,0,0,0,,Gerçekten de harika biri.Dialogue: 0,0:01:48.15,0:01:53.43,Main,,0,0,0,,Onu o kadar seviyorum ki adına şarkı yazdım.Dialogue: 0,0:01:53.44,0:01:55.91,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:30:43.65,0:30:46.70,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - eray.gns thx to onepace.netDialogue: 0,0:01:53.44,0:01:55.91,Title,,0,0,160,,Nekomamushi Efendi'yi Görmeye Gidelim!Dialogue: 0,0:01:55.93,0:02:05.17,English - OP18,,0,0,0,,♪ Nekomamushi Efendi'yi görmeye gidelim ♪Dialogue: 0,0:02:05.17,0:02:14.53,English - OP18,,0,0,0,,♪ Nekomamushi Efendi'yi görmeye gidelim ♪Dialogue: 0,0:02:14.53,0:02:23.70,English - OP18,,0,0,0,,♪ Nekomamushi Efendi'yi görmeye gidelim ♪Dialogue: 0,0:02:23.70,0:02:33.00,English - OP18,,0,0,0,,♪ Nekomamushi Efendi'yi görmeye gidelim ♪Dialogue: 0,0:02:37.28,0:02:46.55,English - OP18,,0,0,0,,♪ Nekomamushi Efendi'yi görmeye gidelim ♪Dialogue: 0,0:02:46.55,0:02:55.12,English - OP18,,0,0,0,,♪ Nekomamushi Efendi'yi görmeye gidelim ♪Dialogue: 0,0:02:59.36,0:03:02.49,Main,,0,0,0,,Nami... Sanji'yle Cedar'ı göremedim.Dialogue: 0,0:03:04.73,0:03:07.90,Main,,0,0,0,,Yoksa kaçırıldılar mı?!Dialogue: 0,0:03:07.90,0:03:10.61,Main,,0,0,0,,Hayır, isteyerek gitti.Dialogue: 0,0:03:10.61,0:03:11.17,Main,,0,0,0,,Ne?Dialogue: 0,0:03:11.17,0:03:13.97,Main,,0,0,0,,Wanda! Carrot!Dialogue: 0,0:03:14.28,0:03:21.21,Main,,0,0,0,,Onlar-gara bu konuyu fazla kurcalamanızı istemiyorlar. Anlayın.Dialogue: 0,0:03:21.21,0:03:23.82,Main,,0,0,0,,Pekoms'la da biz ilgileneceğiz.Dialogue: 0,0:03:23.82,0:03:27.89,Main,,0,0,0,,Gündüz insanlarına gereksiz endişe yaşatmayın.Dialogue: 0,0:03:28.18,0:03:30.64,Main,,0,0,0,,Teşekkür ederim Efendi.Dialogue: 0,0:03:30.64,0:03:35.41,Main,,0,0,0,,Siz-garalar yüreği yaralı vatandaşlarımıza ilgi göstermişsiniz.Dialogue: 0,0:03:35.41,0:03:37.33,Main,,0,0,0,,Asıl teşekkür etmesi gerekenler biziz.Dialogue: 0,0:03:41.34,0:03:43.64,Main,,0,0,0,,Gümüş asma gördüm!Dialogue: 0,0:03:49.54,0:03:58.25,English - OP18,,0,0,0,,♪ Nekomamushi Efendi,  acelecidir hissetmekte yalnız kendini ♪Dialogue: 0,0:03:58.52,0:04:07.92,English - OP18,,0,0,0,,♪ Aklıma gelince onun bu hali, burkulur yüreğim ♪Dialogue: 0,0:04:07.92,0:04:16.43,English - OP18,,0,0,0,,♪ Masumdur yüzü, ay ışığıyla yıkanırken ♪Dialogue: 0,0:04:16.93,0:04:26.36,English - OP18,,0,0,0,,♪ Parıl parıldır gözleri, aya bakarken ♪Dialogue: 0,0:04:30.76,0:04:39.94,English - OP18,,0,0,0,,♪ Ama gün doğdu mu bir kere, çalışır görünmeye sert ♪Dialogue: 0,0:04:39.94,0:04:48.80,English - OP18,,0,0,0,,♪ Yapar elinden gelenin en iyisini ve  hayatını tek başına yaşar. ♪Dialogue: 0,0:04:49.94,0:04:51.27,Main,,0,0,0,,Güzel şarkıymış.Dialogue: 0,0:04:51.74,0:04:54.92,Main,,0,0,0,,Nekomamushi Efendi böyle biri mi?Dialogue: 0,0:04:54.92,0:04:56.44,Main,,0,0,0,,Alakası yok.Dialogue: 0,0:04:57.30,0:04:59.87,Main,,0,0,0,,Ha bi de değil?!Dialogue: 0,0:04:59.87,0:05:01.61,Main,,0,0,0,,Ondan esinlenerek yazdığım bir şarkı sadece.Dialogue: 0,0:05:05.24,0:05:08.02,Main,,0,0,0,,O zaman  "bir kadını görmeye gidiyorum" demesi...Dialogue: 0,0:05:08.44,0:05:11.79,Main,,0,0,0,,...evleneceği anlamına mı geliyor?Dialogue: 0,0:05:11.79,0:05:14.76,Main,,0,0,0,,Tam olarak öyle olmasa da...Dialogue: 0,0:05:14.76,0:05:18.20,Main,,0,0,0,,...nedense çok kararlı görünüyordu.Dialogue: 0,0:05:18.20,0:05:20.92,Main,,0,0,0,,Belki de eşiyle birlikte geri döner?!Dialogue: 0,0:05:20.92,0:05:22.05,Main,,0,0,0,,Ne?!Dialogue: 0,0:05:22.05,0:05:24.14,Main,,0,0,0,,O zaman tayfaya biri daha eklenmiş olur!Dialogue: 0,0:05:24.14,0:05:25.82,Main,,0,0,0,,Luffy-san.Dialogue: 0,0:05:25.82,0:05:28.18,Main,,0,0,0,,Gelin Yonko'nun kızı.Dialogue: 0,0:05:28.18,0:05:31.88,Main,,0,0,0,,Yani bu Big Mom'ın emrine gireceğimiz anlamına geliyor.Dialogue: 0,0:05:34.64,0:05:35.45,Main,,0,0,0,,Olmaz!Dialogue: 0,0:05:35.45,0:05:39.67,Main,,0,0,0,,Elbette Sanji-san da bunu istemiyor.Dialogue: 0,0:05:39.67,0:05:42.55,Main,,0,0,0,,O da buna şiddetle karşı geldi.Dialogue: 0,0:05:42.86,0:05:45.54,Main,,0,0,0,,O yüzden de endişeleniyorum ya.Dialogue: 0,0:05:45.54,0:05:51.91,Main,,0,0,0,,Karşısında Big Mom var, evlilik olayından kurtulamazsa...Dialogue: 0,0:05:51.91,0:05:54.73,Main,,0,0,0,,...Sanji-san ne yapacak dersiniz?Dialogue: 0,0:05:54.73,0:05:57.47,Main,,0,0,0,,Ne yapacak...Dialogue: 0,0:05:58.58,0:06:04.32,Main,,0,0,0,,Evet, muhtemelen bize sorun çıkartmamak için...Dialogue: 0,0:06:05.16,0:06:08.98,Main,,0,0,0,,...kendini bizden ayırmaya çalışacaktır.Dialogue: 0,0:06:09.42,0:06:11.88,Main,,0,0,0,,Sanji gruptan ayrılacak mı diyorsunuz?!Dialogue: 0,0:06:12.34,0:06:14.15,Main,,0,0,0,,O daha da olmaz işte!Dialogue: 0,0:06:14.48,0:06:21.85,Main,,0,0,0,,Bizi dışarı fırlattığında kendi de bizimle dışarı kaçabilirdi.Dialogue: 0,0:06:21.85,0:06:28.10,Main,,0,0,0,,Bana kalırsa daha mektubu yazdığı anda tek başına gitmeye karar vermişti.Dialogue: 0,0:06:30.66,0:06:33.68,Main,,0,0,0,,Big Mom'un kızı ha?Dialogue: 0,0:06:33.68,0:06:37.16,Main,,0,0,0,,Çok can sıkıcı bir evlilik teklifi almış.Dialogue: 0,0:06:37.16,0:06:43.21,Main,,0,0,0,,Bir de Vinsmoke dediniz değil mi? Bence bu soyadı olayın kilit noktası.Dialogue: 0,0:06:43.21,0:06:46.86,Main,,0,0,0,,Sanji'nin babası olabilir, annesi yahut kardeşi olabilir...Dialogue: 0,0:06:46.86,0:06:49.54,Main,,0,0,0,,Özetle bir zamanlar  Kuzey Mavi'de yaşıyorlarmış...Dialogue: 0,0:06:49.57,0:06:53.07,Main,,0,0,0,,...sonra Doğu Mavi'ye geçmişler, şimdi de Yeni Dünya'dalar öyle mi!?Dialogue: 0,0:06:53.07,0:06:54.16,Main,,0,0,0,,İnanılmaz bir şey bu!Dialogue: 0,0:06:54.62,0:06:55.79,Main,,0,0,0,,Vinsmoke...Dialogue: 0,0:06:56.14,0:06:57.56,Main,,0,0,0,,Daha önce duymuştum sanırım...Dialogue: 0,0:07:04.84,0:07:06.53,Main,,0,0,0,,Özür dileriz.Dialogue: 0,0:07:06.53,0:07:10.51,Main,,0,0,0,,Onları en azıdan siz gelene kadar oyalayabilseydik...Dialogue: 0,0:07:10.51,0:07:15.95,Main,,0,0,0,,Buna Sanji izin vermemiş. Sizin bir suçunuz yok.Dialogue: 0,0:07:15.95,0:07:20.95,Main,,0,0,0,,Ama Robin, ya onu bir daha hiç göremezsek?!Dialogue: 0,0:07:20.95,0:07:22.98,Main,,0,0,0,,Ne güzel işte!Dialogue: 0,0:07:22.98,0:07:23.79,Main,,0,0,0,,Ha?!Dialogue: 0,0:07:23.79,0:07:27.70,Main,,0,0,0,,Yani öyle temelli gitme niyeti varsa...Dialogue: 0,0:07:27.70,0:07:31.66,Main,,0,0,0,,...en azından "her şey için teşekkür ederim"  falan demesi lazımdı.Dialogue: 0,0:07:31.66,0:07:34.80,Main,,0,0,0,,Bir de "verdiğim tüm zahmetler için özür dilerim" tabii.Dialogue: 0,0:07:34.80,0:07:37.17,Main,,0,0,0,,Hayır, mesele bu değil!Dialogue: 0,0:07:37.17,0:07:42.34,Main,,0,0,0,,Aklınızı çalıştırın biraz.  Şu anda durdurulamaz bir trenin içindeyiz.Dialogue: 0,0:07:42.69,0:07:45.17,Main,,0,0,0,,Caesar'ın dediklerini hatırlayın.Dialogue: 0,0:07:45.17,0:07:51.74,Main,,0,0,0,,Yapay Şeytan Meyvesi GÜLÜCÜK'ün  en büyük müşterisi Kaido.Dialogue: 0,0:07:56.72,0:08:01.31,Main,,0,0,0,,Punk Hazard'daki laboratuvarı yok ederek Doflamingo'yu kızdırdığımız gibi...Dialogue: 0,0:08:01.31,0:08:04.95,Main,,0,0,0,,...Dressrosa'daki GÜLÜCÜK fabrikasını yok etmekle de...Dialogue: 0,0:08:04.95,0:08:07.76,Main,,0,0,0,,...şimdi de en çok tepesini attıracağımız kişi...Dialogue: 0,0:08:09.30,0:08:11.61,Main,,0,0,0,,...Yonko Kaidou olacak!Dialogue: 0,0:08:11.61,0:08:14.07,Main,,0,0,0,,Kendisi artık bizim için uzak bir tehdit değil.Dialogue: 0,0:08:14.35,0:08:19.08,Main,,0,0,0,,Üstelik emrindeki Canavar Korsanları'yla çoktan bir çatışma yaşamışız bile.Dialogue: 0,0:08:19.48,0:08:25.62,Main,,0,0,0,,Bu ülkeyi mahveden Jack ve tayfasının  peşimize düşmesi an meselesidir!Dialogue: 0,0:08:26.80,0:08:31.08,Main,,0,0,0,,Tra-o'yla bundan sonra gelecek savaşlar için de ittifak halindeyiz.Dialogue: 0,0:08:31.08,0:08:36.41,Main,,0,0,0,,Neden bilmiyorum ama anladığım kadarıyla Kin'emonlar da Kaido'nun hedefi.Dialogue: 0,0:08:36.41,0:08:41.43,Main,,0,0,0,,Yonko Kaido'yla çok yakında karşı karşıya geleceğiz!Dialogue: 0,0:08:41.43,0:08:47.64,Main,,0,0,0,,Kıvırcık kaşın böyle bir zamanda kalkıp  bir de yine Yonko olan Big Mom'a bulaşması...Dialogue: 0,0:08:47.64,0:08:48.67,Main,,0,0,0,,...aptallıktan başka bir şey değil!Dialogue: 0,0:08:51.66,0:08:53.55,Main,,0,0,0,,Öyle söylenir mi bu?!Dialogue: 0,0:08:54.42,0:08:59.25,Main,,0,0,0,,Hödük herif! İkisi bambaşka meseleler!Dialogue: 0,0:08:59.51,0:09:04.89,Main,,0,0,0,,Ayrıca evlilik gibi küçük bir meseleyi nasıl bu kadar büyütür hiç bilmiyorum!Dialogue: 0,0:09:05.22,0:09:07.20,Main,,0,0,0,,Ne dedin?!Dialogue: 0,0:09:07.20,0:09:10.09,Main,,0,0,0,,İkiniz de sakinleşin biraz!Dialogue: 0,0:09:10.39,0:09:12.44,Main,,0,0,0,,Basbayağı da büyük bir mesele!Dialogue: 0,0:09:12.44,0:09:15.74,Main,,0,0,0,,İnsanların dertleri büyük mü küçük mü sen karar veremezsin!Dialogue: 0,0:09:15.74,0:09:16.33,Main,,0,0,0,,Ne dedin?!Dialogue: 0,0:09:16.33,0:09:18.07,Main,,0,0,0,,Pekâlâ!Dialogue: 0,0:09:18.07,0:09:21.51,Main,,0,0,0,,Aklından neler geçiyor bilmiyoruz o yüzden gidip Sanji'ye soralım!Dialogue: 0,0:09:23.07,0:09:24.72,Main,,0,0,0,,Ne?!Dialogue: 0,0:09:26.28,0:09:28.55,Main,,0,0,0,,Hey! Unut gitsin Luffy!Dialogue: 0,0:09:28.55,0:09:31.62,Main,,0,0,0,,Big Mom'ın yerine mi gideceğiz?!Dialogue: 0,0:09:32.01,0:09:32.75,Main,,0,0,0,,Başka seçenek yok.Dialogue: 0,0:09:32.75,0:09:36.35,Main,,0,0,0,,Ona halihazırda kafa tuttuğunu unuttun mu?!Dialogue: 0,0:09:36.35,0:09:41.13,Main,,0,0,0,,Herhangi bir strateji yahut destek olmadan anında pert oluruz!Dialogue: 0,0:09:41.52,0:09:43.59,Main,,0,0,0,,Kadın Yonko.Dialogue: 0,0:09:43.59,0:09:47.37,Main,,0,0,0,,Luffy, unutma sakın, şimdiye kadarki düşmanlarımızdan bambaşka seviyede biri.Dialogue: 0,0:09:47.64,0:09:49.40,Main,,0,0,0,,O zaman gizlice gideriz.Dialogue: 0,0:09:49.40,0:09:51.54,Main,,0,0,0,,Nasıl bulacağız onları peki?!Dialogue: 0,0:09:53.10,0:09:56.57,Main,,0,0,0,,Peşlerinden gitmenin bir yolu var elbette ama...Dialogue: 0,0:10:00.72,0:10:02.78,Main,,0,0,0,,Öyle.Dialogue: 0,0:10:02.78,0:10:07.85,Main,,0,0,0,,Big Mom Korsanları yüzünden Sanji-san gitmiş olabilir...Dialogue: 0,0:10:07.85,0:10:11.42,Main,,0,0,0,,...ama onun yerine geride başka birini bıraktılar.Dialogue: 0,0:10:12.50,0:10:18.46,Main,,0,0,0,,O kişi uyanmışsa ondan yeni bir şeyler öğrenebiliriz.Dialogue: 0,0:10:19.46,0:10:22.40,Main,,0,0,0,,Gidip görelim.Dialogue: 0,0:10:42.42,0:10:45.62,Main,,0,0,0,,Burası da epey mahvolmuş.Dialogue: 0,0:10:49.33,0:10:54.13,Captions,,30,0,240,,Balina Ormanı Muhafız YerleşkesiDialogue: 0,0:11:03.24,0:11:09.15,Main,,0,0,0,,Balina Ağaç yakından çok daha büyük görünüyor!Dialogue: 0,0:11:13.00,0:11:14.25,Main,,0,0,0,,Millet!Dialogue: 0,0:11:14.25,0:11:16.48,Main,,0,0,0,,Hasır Şapkalar geldi!Dialogue: 0,0:11:16.48,0:11:18.09,Main,,0,0,0,,Chopper da burada!Dialogue: 0,0:11:18.09,0:11:20.17,Main,,0,0,0,,Garchu!Dialogue: 0,0:11:20.17,0:11:21.83,Main,,0,0,0,,Garchu!Dialogue: 0,0:11:21.83,0:11:24.34,Main,,0,0,0,,Garchu!Dialogue: 0,0:11:24.34,0:11:27.08,Main,,0,0,0,,Garchu!Dialogue: 0,0:11:29.10,0:11:32.52,Main,,0,0,0,,Minkler biraz hızlı iyileşiyor sanki?Dialogue: 0,0:11:32.52,0:11:33.17,Main,,0,0,0,,Bak bu çok doğru!Dialogue: 0,0:11:33.46,0:11:36.37,Main,,0,0,0,,Hasır Şapkalı Luffy, bizi tanıdın mı!?Dialogue: 0,0:11:36.69,0:11:38.83,Main,,0,0,0,,Ormanda olanlar için kusurumuza bakma.Dialogue: 0,0:11:38.83,0:11:42.45,Main,,0,0,0,,Kim olursa olsun hiçbir davetsiz misafire izin veremeyiz!Dialogue: 0,0:11:42.45,0:11:44.68,Main,,0,0,0,,Tanıdım sizi!Dialogue: 0,0:11:44.68,0:11:46.72,Main,,0,0,0,,Önemli değil!Dialogue: 0,0:11:47.64,0:11:50.29,Main,,0,0,0,,Neko... Nekomamushi nerede?Dialogue: 0,0:11:52.38,0:11:54.42,Main,,0,0,0,,Sizi gördüğüme sevindim!Dialogue: 0,0:11:54.42,0:11:57.61,Main,,0,0,0,,Kurtarıcılarımız ve dostları!Dialogue: 0,0:11:57.61,0:12:00.02,Main,,0,0,0,,Bir kez daha söyleyeyim...Dialogue: 0,0:12:00.02,0:12:00.80,Main,,0,0,0,,Teşekkür ederiz!Dialogue: 0,0:12:01.16,0:12:02.03,Main,,0,0,0,,Sen de kimsin?!Dialogue: 0,0:12:02.03,0:12:06.81,Captions,,0,0,335,,Balina Ormanı Muhafızları Kaptanı (Jaguar Mink) "Ağaç Üstü" PedroDialogue: 0,0:12:03.42,0:12:05.95,Main,,0,0,3,,Ormanda adamlarımın yaptıkları için özür dilerim.Dialogue: 0,0:12:05.95,0:12:08.04,Main,,0,0,3,,İstilacılar konusunda fazla tedbirliler.Dialogue: 0,0:12:09.60,0:12:10.88,Main,,0,0,0,,Sen de orada mıydın ki?Dialogue: 0,0:12:10.88,0:12:13.60,Main,,0,0,0,,Evet, ağaçlardan birinin üstündeydim.Dialogue: 0,0:12:13.60,0:12:16.85,Main,,0,0,0,,Bepolar geride siz-garaları bekliyor.Dialogue: 0,0:12:19.70,0:12:21.35,Main,,0,0,0,,Onlarla sonra görüşsek de olur.Dialogue: 0,0:12:21.65,0:12:24.72,Main,,0,0,0,,Önce Nekomamushi'yle Aslan Pekomamushi'yi görmek istiyoruz.Dialogue: 0,0:12:25.65,0:12:26.82,Main,,0,0,0,,Garchu!Dialogue: 0,0:12:27.56,0:12:31.61,Main,,0,0,0,,Pekoms'dan bahsediyorsan gözünü açtı. Arka taraftaki binada.Dialogue: 0,0:12:31.61,0:12:35.45,Main,,0,0,0,,Bu olayı herkesten saklı tutuyoruz.Dialogue: 0,0:12:35.45,0:12:37.24,Main,,0,0,0,,Sanji iyi biri.Dialogue: 0,0:12:37.55,0:12:39.67,Main,,0,0,0,,Umarım bir şekilde size yardımımız dokunur.Dialogue: 0,0:12:41.14,0:12:45.90,Main,,0,0,0,,Luffy, çeşitli nedenlerden ötürü Nekomamushi konusunda endişeliyim...Dialogue: 0,0:12:45.90,0:12:47.46,Main,,0,0,0,,...o yüzden önden gidiyorum!Dialogue: 0,0:12:47.46,0:12:48.21,Main,,0,0,0,,Peki!Dialogue: 0,0:12:48.21,0:12:51.82,Main,,0,0,0,,Öyleyse Chopper-sensei*'ye ben eşlik edeyim.Dialogue: 0,0:13:05.02,0:13:08.10,Main,,0,0,0,,Hey Chopper, dondun kaldın birden?!Dialogue: 0,0:13:09.58,0:13:12.28,Main,,0,0,0,,Do-Donmadım.Dialogue: 0,0:13:12.28,0:13:13.24,Main,,0,0,0,,Tuhaf davranıyorsun.Dialogue: 0,0:13:15.32,0:13:16.67,Main,,0,0,0,,Bu taraftan.Dialogue: 0,0:13:16.67,0:13:17.74,Main,,0,0,0,,Pe-Peki!Dialogue: 0,0:13:18.06,0:13:21.80,Main,,0,0,0,,Nekomamushi Efendi şu anda yıkanıyor.Dialogue: 0,0:13:25.48,0:13:27.02,Main,,0,0,0,,Yıkanıyor mu?!Dialogue: 0,0:13:27.47,0:13:28.84,Captions,,0,0,0,,SAKEDialogue: 0,0:13:30.97,0:13:31.07,Captions,,0,0,0,,KORUDialogue: 0,0:13:31.07,0:13:31.17,Captions,,0,0,0,,KORUDialogue: 0,0:13:31.17,0:13:31.30,Captions,,0,0,0,,KORUDialogue: 0,0:13:31.30,0:13:31.44,Captions,,0,0,0,,KORUDialogue: 0,0:13:31.44,0:13:31.55,Captions,,0,0,0,,KORUDialogue: 0,0:13:31.55,0:13:31.65,Captions,,0,0,0,,KORUDialogue: 0,0:13:31.65,0:13:31.77,Captions,,0,0,0,,KORUDialogue: 0,0:13:34.02,0:13:36.91,Main,,0,0,0,,Lazaniyav!Dialogue: 0,0:13:36.91,0:13:40.36,Main,,0,0,0,,Çok hoş miyav! Beya!Dialogue: 0,0:13:41.14,0:13:43.00,Main,,0,0,0,,Hey, Nekomamushi!Dialogue: 0,0:13:43.00,0:13:46.17,Main,,0,0,0,,Yıkanmaman lazım! Dikişlerin atacak!Dialogue: 0,0:13:46.49,0:13:48.44,Main,,0,0,0,,Ayrıca hafif şeyler yemen lazım!Dialogue: 0,0:13:48.44,0:13:50.31,Main,,0,0,0,,Sol elini niye kullanıyorsun?!Dialogue: 0,0:13:54.70,0:13:56.11,Main,,0,0,0,,Kime diyorum?!Dialogue: 0,0:13:56.11,0:13:57.96,Main,,0,0,0,,Oh, Chopper!Dialogue: 0,0:13:58.69,0:14:01.09,Main,,0,0,0,,Bir şey olmaz yahu!Dialogue: 0,0:14:01.09,0:14:04.61,Main,,0,0,0,,Ben özgürlüğe düşkün bir adamımdır!Dialogue: 0,0:14:04.61,0:14:06.26,Main,,0,0,0,,Doktorunun sözünden çıkma!Dialogue: 0,0:14:06.26,0:14:08.79,Main,,0,0,0,,Düşündüğümden de büyükmüş.Dialogue: 0,0:14:08.79,0:14:11.92,Main,,0,0,0,,Kusura bakma ama doktorun dedikleri bile...Dialogue: 0,0:14:13.14,0:14:15.13,Main,,0,0,0,,Bir kulağımdan girer ötekinden çıkar!Dialogue: 0,0:14:15.46,0:14:19.20,Main,,0,0,0,,Sol elimi kullanamamaya hâlâ alışamadım!Dialogue: 0,0:14:20.00,0:14:23.50,Main,,0,0,0,,Böyle alkışlayamıyorum bile!Dialogue: 0,0:14:26.08,0:14:30.49,Main,,0,0,0,,Siz-garalar Hasır Şapka Tayfası'sınız demek?!Dialogue: 0,0:14:30.49,0:14:32.38,Main,,0,0,0,,Hayatımı kurtardınız!Dialogue: 0,0:14:32.68,0:14:34.64,Main,,0,0,0,,Sağ olun!Dialogue: 0,0:14:36.14,0:14:39.36,Main,,0,0,0,,Günün birinde size borcumu ödeyeceğim!Dialogue: 0,0:14:39.91,0:14:44.06,Main,,0,0,0,,Pek belli etmesem de yoğun minnet ve şefkat anlayışına sahibimdir!Dialogue: 0,0:14:47.58,0:14:49.17,Main,,0,0,0,,Top.Dialogue: 0,0:14:54.17,0:14:57.24,Main,,0,0,0,,Yaşasın! Top var!Dialogue: 0,0:15:02.26,0:15:04.05,Main,,0,0,0,,Sana kıpırdamak yasak dedim!Dialogue: 0,0:15:08.02,0:15:09.99,Main,,0,0,0,,Gördün mü, yaran açıldı!Dialogue: 0,0:15:16.32,0:15:18.86,Main,,0,0,0,,Bana bakın... Ben...Dialogue: 0,0:15:18.86,0:15:22.77,Main,,0,0,0,,Yatağa istediğim için girdim.Dialogue: 0,0:15:22.77,0:15:25.64,Main,,0,0,0,,Evet... Evet anladık.Dialogue: 0,0:15:25.64,0:15:27.67,Main,,0,0,0,,Neyse ne zaten, sakın kıpırdama!Dialogue: 0,0:15:27.99,0:15:29.67,Main,,0,0,0,,İğne vuracağım.Dialogue: 0,0:15:30.60,0:15:32.68,Main,,0,0,0,,Hey, sen-gara!Dialogue: 0,0:15:32.68,0:15:36.14,Main,,0,0,0,,Şuradaki tilki kuyruğunu getirsene.Dialogue: 0,0:15:37.32,0:15:39.02,Main,,0,0,0,,Böyle mi?Dialogue: 0,0:15:44.00,0:15:48.63,Main,,0,0,0,,Chopper! Ben böyle eğleniyor, o tarafa bakmıyorken vur hadi!Dialogue: 0,0:15:48.63,0:15:50.06,Main,,0,0,0,,Kıpırdama dedik sana!Dialogue: 0,0:15:50.43,0:15:53.56,Main,,0,0,0,,Bu halinle bir de utanmadan iğneden mi korkuyorsun?!Dialogue: 0,0:16:02.78,0:16:04.74,Main,,0,0,0,,Tamamen iyileştim.Dialogue: 0,0:16:04.74,0:16:08.01,Main,,0,0,0,,Öyle bir ilaç yok bir kere, kapa çeneni!Dialogue: 0,0:16:08.01,0:16:09.28,Main,,0,0,0,,Yaralı hastaya niye vuruyorsun?!Dialogue: 0,0:16:11.72,0:16:14.82,Main,,0,0,0,,Bu adam beni öldürüyor ya!Dialogue: 0,0:16:14.82,0:16:16.65,Main,,0,0,0,,Bayılıyorum!Dialogue: 0,0:16:18.15,0:16:20.56,Main,,0,0,0,,Hayatta kalman mucize resmen!Dialogue: 0,0:16:20.85,0:16:25.60,Main,,0,0,0,,Yarısını yeteneğimle engelledim gao!Dialogue: 0,0:16:25.60,0:16:27.77,Main,,0,0,0,,Bege adisi...Dialogue: 0,0:16:27.77,0:16:33.08,Main,,0,0,0,,Kusura bakmayın,  Kara Bacak'ı yanlarında götürdüler demek?Dialogue: 0,0:16:33.08,0:16:35.81,Main,,0,0,0,,Artık düğünden kaçışı yok!Dialogue: 0,0:16:36.18,0:16:38.93,Main,,0,0,0,,İşte biz de onu diyoruz Pekomamushi...Dialogue: 0,0:16:38.93,0:16:41.52,Main,,0,0,0,,...kim ayarladı bu evliliği?Dialogue: 0,0:16:41.52,0:16:48.09,Main,,0,0,0,,Elbette Mama'mızla Vinsmoke Ailesi'nin babası ayarladı!Dialogue: 0,0:16:48.09,0:16:50.35,Main,,0,0,0,,Sanji-kun'un babası mı yani?Dialogue: 0,0:16:50.35,0:16:52.59,Main,,0,0,0,,Nasıl biri peki?Dialogue: 0,0:16:52.59,0:16:56.56,Main,,0,0,0,,Yeraltı dünyasında epey ünlü bir adamdır.Dialogue: 0,0:16:56.96,0:17:01.19,Main,,0,0,0,,Germa 66 adını hiç duydunuz mu?Dialogue: 0,0:17:01.19,0:17:03.43,Main,,0,0,0,,Savaş Çığırtkanları olarak da bilinirler.Dialogue: 0,0:17:03.43,0:17:04.93,Main,,0,0,0,,Ne diyorsun sen be?!Dialogue: 0,0:17:04.93,0:17:07.87,Main,,0,0,0,,Uydurma bir şeytani ordu değil mi o?!Dialogue: 0,0:17:08.16,0:17:10.11,Main,,0,0,0,,Saçmalık resmen!Dialogue: 0,0:17:10.82,0:17:15.15,Main,,0,0,0,,Hayır, ciddi ciddi var bu örgüt.Dialogue: 0,0:17:15.15,0:17:19.05,Main,,0,0,0,,Başını da Vinsmoke Ailesi çekiyor!Dialogue: 0,0:17:19.05,0:17:23.54,Main,,0,0,0,,Patronları da Kara Bacak'ın babası!Dialogue: 0,0:17:24.80,0:17:27.06,Flashbacks,,0,0,0,,Hiçbir şeye olmasa bile bu diyeceğime inanın.Dialogue: 0,0:17:27.63,0:17:31.48,Flashbacks,,0,0,0,,Dostlarımdan hiçbir şey saklamak istemedim.Dialogue: 0,0:17:36.28,0:17:40.47,Main,,0,0,0,,Vinsmoke Ailesi özetle...Dialogue: 0,0:17:42.38,0:17:44.61,Main,,0,0,0,,...suikastçi bir aile!Dialogue: 0,0:17:51.18,0:17:54.22,Main,,0,0,0,,Sanji-kun suikastçi bir aileden öyle mi?!Dialogue: 0,0:17:55.96,0:17:59.58,Main,,0,0,0,,Neden bahsediyorsun bilmiyorum ama bunlar umrumda değil!Dialogue: 0,0:18:01.26,0:18:02.73,Main,,0,0,0,,Eminim değildir!Dialogue: 0,0:18:03.84,0:18:08.16,Main,,0,0,0,,Bizi yalnızca geri dönüp dönmeyeceği ilgilendiriyor!Dialogue: 0,0:18:08.16,0:18:10.00,Main,,0,0,0,,Evlenmek istiyorsa evlenebilir!Dialogue: 0,0:18:11.60,0:18:16.80,Main,,0,0,0,,Ama sırf bu yüzden Big Mom'ın emri altına girmeyiz!Dialogue: 0,0:18:16.80,0:18:19.74,Main,,0,0,0,,Yani evlenecek olurlarsa siz benim emrime girersiniz!Dialogue: 0,0:18:22.88,0:18:26.25,Main,,0,0,0,,Acıdı!Dialogue: 0,0:18:34.40,0:18:36.50,Main,,0,0,0,,Pekoms, iyi misin?Dialogue: 0,0:18:37.19,0:18:38.73,Main,,0,0,0,,Luffy çok komiksin!Dialogue: 0,0:18:38.73,0:18:42.17,Main,,0,0,0,,Ağzından çıkanı kulağın duysun velet! Yok ederim seni!Dialogue: 0,0:18:42.58,0:18:44.07,Main,,0,0,0,,Gao!Dialogue: 0,0:18:44.44,0:18:47.34,Main,,0,0,0,,Size hayat borcum var biliyorum ama şansınızı zorlamayın!Dialogue: 0,0:18:47.34,0:18:51.48,Main,,0,0,0,,Mama denizin imparatorları, Yonko'dan biri!Dialogue: 0,0:18:51.48,0:18:51.94,Main,,0,0,0,,Evet.Dialogue: 0,0:18:54.06,0:18:55.31,Main,,0,0,0,,Yaralarım sızlıyor.Dialogue: 0,0:18:55.71,0:18:57.78,Main,,0,0,0,,Çok şirin gözlerin varmış.Dialogue: 0,0:19:00.14,0:19:01.32,Main,,0,0,0,,Kapa çeneni!Dialogue: 0,0:19:05.12,0:19:09.89,Main,,0,0,0,,Her halükârda evlilikten kaçışı yok.Dialogue: 0,0:19:09.89,0:19:11.17,Main,,0,0,0,,Neden?!Dialogue: 0,0:19:11.17,0:19:14.86,Main,,0,0,0,,Kara Bacak'ın da paşa paşa gittiği gibi...Dialogue: 0,0:19:14.86,0:19:21.11,Main,,0,0,0,,...Mama'nın çay partisi davetini kimse reddedemez.Dialogue: 0,0:19:21.11,0:19:29.05,Main,,0,0,0,,Eğer reddedecek olursa bu kişi şok edici bir hediye alır.Dialogue: 0,0:19:29.05,0:19:32.02,Main,,0,0,0,,Mama'yı utandırmıştır çünkü.Dialogue: 0,0:19:33.52,0:19:36.85,Main,,0,0,0,,Hediye dediğime bakma, sevindiren türde değil bu.Dialogue: 0,0:19:38.66,0:19:43.56,Main,,0,0,0,,Paketin içinde o kişinin değer verdiği birinin kellesi olur!Dialogue: 0,0:19:45.94,0:19:51.33,Main,,0,0,0,,Bu Hasır Şapka tayfasından birinin olabileceği gibi...Dialogue: 0,0:19:51.33,0:19:56.14,Main,,0,0,0,,...Doğu Mavi'deki o restorandan birinin kellesi de olabilir.Dialogue: 0,0:19:57.20,0:20:02.95,Main,,0,0,0,,Hatta Kamabakka Krallığı'ndan biri bile olabilir.Dialogue: 0,0:20:03.40,0:20:06.48,Main,,0,0,0,,Hey! Bunları nereden biliyorsunuz?!Dialogue: 0,0:20:10.54,0:20:14.26,Main,,0,0,0,,Güce sahip olmak böyle bir şey işte Hasır Şapka!Dialogue: 0,0:20:16.06,0:20:18.76,Thoughts,,0,0,0,,Orada kulağına söylediği şey yoksa...Dialogue: 0,0:20:19.46,0:20:26.60,Main,,0,0,0,,Onun kadar güçlü birinin tehdidi mutlak yaklaşmakta olan bir geleceğin habercisidir.Dialogue: 0,0:20:27.66,0:20:30.34,Main,,0,0,0,,Böyle bir şeye kim karşı koyabilir?!Dialogue: 0,0:20:31.56,0:20:34.78,Main,,0,0,0,,Yonko böyle bir şey işte!Dialogue: 0,0:20:34.78,0:20:38.95,Main,,0,0,0,,Karşısında yapabileceğin hiçbir şey yoktur!Dialogue: 0,0:20:40.18,0:20:43.69,Main,,0,0,0,,Sanji-kun'un o yüzden gitmekten başka seçeneği yoktu!Dialogue: 0,0:20:45.92,0:20:51.52,Main,,0,0,0,,Hayatımı borçlu olduğum sizlere içinizi rahatlatacak bir şey daha söyleyeyim.Dialogue: 0,0:20:51.52,0:20:55.53,Main,,0,0,0,,Emrimiz altına girmeyeceksiniz gao!Dialogue: 0,0:20:57.96,0:21:00.60,Main,,0,0,0,,Politik bir evlilik bu.Dialogue: 0,0:21:00.91,0:21:06.27,Main,,0,0,0,,Mama emri altına girecek kişilerle mutlaka bir bağ kurar.Dialogue: 0,0:21:06.27,0:21:08.35,Main,,0,0,0,,Özetle bu evlilik...Dialogue: 0,0:21:08.35,0:21:13.80,Main,,0,0,0,,...Vinsmoke Ailesi'yle Charlotte Ailesi arasında bağ kuracak bir tören.Dialogue: 0,0:21:13.80,0:21:17.15,Main,,0,0,0,,Sizinle bir alakası yok.Dialogue: 0,0:21:18.06,0:21:21.29,Main,,0,0,0,,Biraz daha açık konuşayım isterseniz.Dialogue: 0,0:21:22.80,0:21:25.77,Main,,0,0,0,,Evliliğin gerçekleştiği andan itibaren...Dialogue: 0,0:21:25.77,0:21:30.67,Main,,0,0,0,,...Kara Bacak Sanji artık sizin tayfanın bir parçası olmayacak!Dialogue: 0,0:21:31.82,0:21:32.59,Main,,0,0,0,,Ne?!Dialogue: 0,0:21:32.59,0:21:35.41,Main,,0,0,0,,Böyle bir şeye kim karar verdi?! Sanji benim tayfama ait!Dialogue: 0,0:21:36.52,0:21:40.68,Main,,0,0,0,,Her şeyden önce Vinsmoke Ailesi'nin oğlu!Dialogue: 0,0:21:40.68,0:21:42.55,Main,,0,0,0,,Bana kızıp durma gao!Dialogue: 0,0:21:46.16,0:21:49.57,Main,,0,0,0,,Sanji'nin böyle bir evliliği reddedeceğine eminim!Dialogue: 0,0:21:49.57,0:21:54.07,Main,,0,0,0,,Mama'yla korkunç Vinsmoke Ailesi karşısında mı?Dialogue: 0,0:21:54.07,0:21:58.03,Main,,0,0,0,,Acaba reddettikten sonra tek parça halinde kalabilecek mi?Dialogue: 0,0:21:58.38,0:21:59.80,Main,,0,0,0,,O da ne demekmiş öyle?!Dialogue: 0,0:21:59.80,0:22:03.90,Main,,0,0,0,,Bana bak Pekomamushi! Şimdi ne yapmayı planlıyorsun?!Dialogue: 0,0:22:04.48,0:22:08.22,Main,,0,0,0,,İyileştikten sonra Mama'nın yanına döneceğim.Dialogue: 0,0:22:08.22,0:22:12.28,Main,,0,0,0,,Adi Bege veledi beni öldürdüğünü sanıyor!Dialogue: 0,0:22:12.28,0:22:15.11,Main,,0,0,0,,Ama bu yanına kalmaz!Dialogue: 0,0:22:15.11,0:22:17.01,Main,,0,0,0,,O zaman beni de yanında götür!Dialogue: 0,0:22:18.10,0:22:19.21,Main,,0,0,0,,Luffy!Dialogue: 0,0:22:19.21,0:22:21.32,Main,,0,0,0,,Nami, tek başıma gideceğim.Dialogue: 0,0:22:21.32,0:22:22.15,Main,,0,0,0,,Ne?Dialogue: 0,0:22:22.15,0:22:27.99,Main,,0,0,0,,Robinler'in de dediği gibi hep birlikte gidersek savaş istiyormuş gibi görünürüz.Dialogue: 0,0:22:27.99,0:22:30.39,Main,,0,0,0,,Şu anda bunun için zamanımız yok.Dialogue: 0,0:22:31.90,0:22:33.91,Main,,0,0,0,,Tek başıma gideceğim!Dialogue: 0,0:22:33.91,0:22:39.22,Main,,0,0,0,,Onunla gidersem çay partisine sızıp düğünü mahvedebilirim.Dialogue: 0,0:22:39.22,0:22:43.04,Main,,0,0,0,,Hadi be oradan!  Düşmana yataklık etmemi mi istiyorsun?!Dialogue: 0,0:22:43.04,0:22:44.38,Main,,0,0,0,,Çok eğlenceli olacak gibi!Dialogue: 0,0:22:45.52,0:22:48.02,Main,,0,0,0,,Carrot, çok ciddi bir mesele bu!Dialogue: 0,0:22:48.85,0:22:50.80,Main,,0,0,0,,Pekâlâ öyleyse, karar verildi!Dialogue: 0,0:22:51.59,0:22:52.52,Main,,0,0,0,,La-Lan!Dialogue: 0,0:22:53.60,0:22:54.22,Main,,0,0,0,,Acıdı!Dialogue: 0,0:22:54.22,0:22:56.72,Main,,0,0,0,,Chopper'ı getireyim ben! Hemen iyileş!Dialogue: 0,0:22:58.62,0:23:01.36,Main,,0,0,0,,Her şeye kafana göre karar verme!Dialogue: 0,0:23:02.59,0:23:04.36,Main,,0,0,0,,Kime diyorum!Dialogue: 0,0:23:05.24,0:23:07.13,Main,,0,0,0,,Bekle Hasır Şapka!Dialogue: 0,0:23:07.58,0:23:11.13,Main,,0,0,0,,Burada mıydın Zoro!? Dediklerini duydun mu?!Dialogue: 0,0:23:11.13,0:23:12.20,Main,,0,0,0,,Birazcık.Dialogue: 0,0:23:12.49,0:23:15.14,Main,,0,0,0,,Sanji konusunda endişelendin değil mi?Dialogue: 0,0:23:15.84,0:23:19.76,Main,,0,0,0,,Basacağım tekmeyi şimdi! O aptalı unut demiştim!Dialogue: 0,0:23:19.76,0:23:21.59,Main,,0,0,0,,Hey!Dialogue: 0,0:23:21.59,0:23:25.78,Main,,0,0,0,,Luffy! Zoro! Pekoms nasıl?!Dialogue: 0,0:23:25.78,0:23:27.54,Main,,0,0,0,,Oh, Chopper!Dialogue: 0,0:23:27.54,0:23:31.59,Main,,0,0,0,,Acıdan ağlıyor,  kafasını duvarlara vurup bağırıyor falan!Dialogue: 0,0:23:31.59,0:23:32.59,Main,,0,0,0,,Çabucak iyileştir onu!Dialogue: 0,0:23:33.66,0:23:36.33,Main,,0,0,0,,Ne biçim hastalık belirtisiymiş o öyle?! Hemen bakayım!Dialogue: 0,0:23:39.72,0:23:41.87,Main,,0,0,0,,Garchu! Baron Ceset!Dialogue: 0,0:23:47.26,0:23:52.54,Main,,0,0,0,,Sen-gara Hasır Şapkalı Luffy'sin demek?! Sonunda görüşebildik!Dialogue: 0,0:23:52.54,0:23:55.98,Main,,0,0,0,,Yok artık?!  Sen niye peşimizden geldin?! Git yat!Dialogue: 0,0:23:55.98,0:23:58.48,Main,,0,0,0,,Birden iyileştim!Dialogue: 0,0:23:58.48,0:23:59.82,Main,,0,0,0,,Yok öyle bir dünya!Dialogue: 0,0:24:00.09,0:24:04.05,Main,,0,0,0,,Devasaymış! Nekomamushi bu ha?! Canavar kedi gibi resmen!Dialogue: 0,0:24:11.65,0:24:13.90,Main,,0,0,0,,Bir kucak dolusu Garchu!Dialogue: 0,0:24:29.35,0:24:31.75,Main,,0,0,0,,Nekomamushi'den kan fışkırıyor!Dialogue: 0,0:24:31.75,0:24:34.38,Main,,0,0,0,,Ne yaptığını sanıyorsun sen, canavar kedi?!Dialogue: 0,0:24:39.54,0:24:42.69,Main,,0,0,0,,Aç gözlerini, Nekomamushi!Dialogue: 0,0:24:46.78,0:24:48.57,Main,,0,0,0,,Ne oluyor burada?Dialogue: 0,0:24:48.57,0:24:51.30,Main,,0,0,0,,Yedek kan kalmadı! Hemen kan getirin!Dialogue: 0,0:24:51.70,0:24:53.27,Main,,0,0,0,,Peki Chopper-sensei.Dialogue: 0,0:24:54.16,0:24:56.31,Main,,0,0,0,,Lü-Lüt-Lüt-Lüt...Dialogue: 0,0:24:56.67,0:24:58.38,Main,,0,0,0,,Ne oldu Chopper?!Dialogue: 0,0:24:58.38,0:25:00.94,Main,,0,0,0,,Kalk ağaya canavar kedi! İkiye ayıracağım seni!Dialogue: 0,0:25:01.27,0:25:03.84,Main,,0,0,0,,Adam yaralı!Dialogue: 0,0:25:03.84,0:25:05.64,Main,,0,0,0,,Hey, Tra-o!Dialogue: 0,0:25:05.64,0:25:07.82,Main,,0,0,0,,Ve dostların olsalar gerek?Dialogue: 0,0:25:08.09,0:25:12.78,Main,,0,0,0,,Evet, tanıştırmaya geldim. 20 kişiden oluşan tayfam.Dialogue: 0,0:25:13.49,0:25:17.26,Main,,0,0,4,,Tanıştığımıza memnun olduk Hasır Şapka!Dialogue: 0,0:25:13.74,0:25:17.26,Captions,,0,0,170,,Kalp KorsanlarıDialogue: 0,0:25:17.26,0:25:18.39,Main,,0,0,0,,Aynen!Dialogue: 0,0:25:18.39,0:25:19.90,Main,,0,0,0,,Konuşmamız lazım.Dialogue: 0,0:25:20.40,0:25:21.53,Main,,0,0,0,,Oha! Bu kadarcık mıydı?!Dialogue: 0,0:25:22.76,0:25:24.13,Main,,0,0,0,,İhmal ediliyoruz!Dialogue: 0,0:25:24.43,0:25:28.91,Secondary,,0,0,0,,İhmal ediliyoruz!Dialogue: 0,0:25:26.80,0:25:28.91,Main,,0,0,0,,İhmal ediliyoruz Kaptan!Dialogue: 0,0:25:28.91,0:25:33.41,Main,,0,0,0,,İttifak olmamız sıkı fıkı dost olduk anlamına gelmiyor.Dialogue: 0,0:25:38.17,0:25:39.55,Main,,0,0,0,,Yardım edin...Dialogue: 0,0:25:39.86,0:25:43.22,Main,,0,0,0,,Ne?! Kara Bacak Big Mom'a mı gitti?!Dialogue: 0,0:25:43.22,0:25:44.45,Main,,0,0,0,,Evet.Dialogue: 0,0:25:44.83,0:25:47.10,Main,,0,0,0,,İşler nasıl o noktaya gelebildi?!Dialogue: 0,0:25:47.10,0:25:50.33,Main,,0,0,0,,Endişelenme işte! Gidip alıp geleceğim!Dialogue: 0,0:25:50.33,0:25:53.63,Main,,0,0,0,,Kaidou'yla savaşımızı birazcık erteleyelim işte!Dialogue: 0,0:25:53.96,0:25:55.80,Main,,0,0,0,,Bekleyelim beklemesine de...Dialogue: 0,0:25:55.80,0:25:59.00,Main,,0,0,0,,Kaidou'nun peşimize düşmesi artık an meselesi!Dialogue: 0,0:26:00.12,0:26:05.58,Main,,0,0,0,,Zou'da bir süre saklanabiliriz diye düşünüyordum ama artık nerede olduğumuzu biliyorlar.Dialogue: 0,0:26:08.74,0:26:14.46,Main,,0,0,0,,Bir dahaki sefer hedefleri biz olsak bile  bu ülkeye gene saldırırlarsa ne olur sanıyorsun?!Dialogue: 0,0:26:14.97,0:26:17.26,Main,,0,0,0,,Ne iyi yüreklisiniz!Dialogue: 0,0:26:22.62,0:26:23.73,Main,,0,0,0,,Ne ara geldiler?!Dialogue: 0,0:26:23.73,0:26:25.45,Main,,0,0,0,,Garchu!Dialogue: 0,0:26:25.45,0:26:28.10,Main,,0,0,0,,Siz-garalar ciddi ciddi korsan mısınız?!Dialogue: 0,0:26:28.43,0:26:31.97,Main,,0,0,0,,Bizi kurtarıp üstüne bir de bu kadar değer verdiğiniz için sağ olun!Dialogue: 0,0:26:31.97,0:26:33.97,Main,,0,0,0,,Teşekkür ederiz Garchu!Dialogue: 0,0:26:35.01,0:26:37.67,Main,,0,0,0,,Pekoms, yaralı mısın?Dialogue: 0,0:26:37.95,0:26:39.05,Main,,0,0,0,,Evet...Dialogue: 0,0:26:39.05,0:26:40.88,Main,,0,0,0,,Aman kim takar!Dialogue: 0,0:26:40.88,0:26:43.64,Main,,0,0,0,,Pekâlâ, ziyafet vakti!Dialogue: 0,0:26:43.64,0:26:45.02,Main,,0,0,0,,İçki ve yiyecek getirin!Dialogue: 0,0:26:45.28,0:26:47.32,Main,,0,0,0,,Kime diyorum ben Nekomamushi?!Dialogue: 0,0:26:47.32,0:26:48.92,Main,,0,0,0,,Varım!Dialogue: 0,0:26:48.92,0:26:50.05,Main,,0,0,0,,Yoksun!Dialogue: 0,0:27:31.05,0:27:35.27,Main,,0,0,0,,Luffy-sanlar tamamen unuttular gibi.Dialogue: 0,0:27:37.80,0:27:41.58,Main,,0,0,0,,Fakat bizler tayfanın yetişkinleri olarak yapılması gerekeni yapmalıyız.Dialogue: 0,0:27:41.58,0:27:44.54,Main,,0,0,0,,Haklısın. Bu ülkeye...Dialogue: 0,0:27:44.54,0:27:48.16,Main,,0,0,0,,Evet!  Ne olursa olsun samuraylar girmemeli!Dialogue: 0,0:27:48.16,0:27:51.89,Main,,0,0,0,,Hem sonuçta Kin'emon-sanlar'ın aradığı...Dialogue: 0,0:27:51.89,0:27:55.45,Main,,0,0,0,,...Raizo-san burada değil. Ülkeye girmeleri gereksiz.Dialogue: 0,0:27:55.77,0:27:58.66,Main,,0,0,0,,Üstüne üstlük bu nedenle...Dialogue: 0,0:28:00.78,0:28:03.29,Main,,0,0,0,,...bin yıllık şehir mahvoldu!Dialogue: 0,0:28:04.76,0:28:07.90,Flashbacks,,0,0,0,,Raizo'yu getirin!Dialogue: 0,0:28:09.02,0:28:12.00,Flashbacks,,0,0,0,,Wano Krallığı'nın savaşçıları nerede?!Dialogue: 0,0:28:15.10,0:28:18.52,Main,,0,0,0,,Bize kurtarıcı deyip sonsuz teşekkür etseler de...Dialogue: 0,0:28:18.52,0:28:24.35,Main,,0,0,0,,...onlara samuray dostlarımız var diyemeyiz.Dialogue: 0,0:28:29.54,0:28:35.36,Main,,0,0,0,,Kin'emonlar'ın burayı buluşmak için kullanacaklarını öğrenirlerse...Dialogue: 0,0:28:35.36,0:28:39.88,Main,,0,0,0,,...neşeli Mink Kabilesi bile epey sinirlenecektir.Dialogue: 0,0:28:47.54,0:28:52.44,Main,,0,0,0,,Böyle tanış olduktan sonra onlarla savaşmak istemiyorum!Dialogue: 0,0:28:52.44,0:28:57.41,Main,,0,0,0,,Gerekirse sabaha kadar bekleyip Kin'emon'la Kanjuro'nun ülkeye girmesine engel olalım.Dialogue: 0,0:29:06.63,0:29:09.36,Captions,,0,0,170,,Ertesi SabahDialogue: 0,0:29:14.96,0:29:19.66,Main,,0,0,0,,Hava karanlık, şafak henüz sökmemiş.Dialogue: 0,0:29:19.93,0:29:21.89,Main,,0,0,0,,Sonunda vardık-degozaru!Dialogue: 0,0:29:21.89,0:29:25.04,Main,,0,0,0,,Aynen öyle! Sonunda zirvedeyiz!Dialogue: 0,0:29:29.62,0:29:32.68,Main,,0,0,0,,Zor oldu ama sonunda buradayız.Dialogue: 0,0:29:42.36,0:29:45.97,Main,,0,0,0,,Luffy-donolar eminim endişelenmişlerdir.Dialogue: 0,0:29:45.97,0:29:47.33,Main,,0,0,0,,Öyle.Dialogue: 0,0:29:47.60,0:29:50.75,Main,,0,0,0,,Hepsi de bizi bekliyordur şimdi!Dialogue: 0,0:29:50.75,0:29:53.37,Main,,0,0,0,,Ayaklarına sağlık Kaplansaburo.Dialogue: 0,0:29:53.64,0:29:57.77,Note,,0,0,0,,Tora: KaplanDialogue: 0,0:29:53.37,0:29:57.77,Main,,0,0,0,,Kaplan mı?! Bu hayvan kaplandı demek?Dialogue: 0,0:29:58.07,0:30:00.48,Main,,0,0,0,,Haydi artık, resme dönüş!Dialogue: 0,0:30:04.56,0:30:09.37,Main,,0,0,0,,Fakat maymun kardeş, bize hiçbir şey söylemedin.Dialogue: 0,0:30:09.37,0:30:11.39,Main,,0,0,0,,Biz yalnızca Raizo isimli bir savaşçının...Dialogue: 0,0:30:13.10,0:30:15.85,Main,,0,0,0,,Hiçbir şey bilmiyorum-degosaru*!Dialogue: 0,0:30:15.85,0:30:18.80,Main,,0,0,0,,Ne oldu? Betin benzin attı birden...Dialogue: 0,0:30:20.32,0:30:22.90,Main,,0,0,0,,Bekle biraz! Nereye gidiyorsun?!Dialogue: 0,0:30:22.90,0:30:25.49,Main,,0,0,0,,Raizo'yu tek başımıza arayamayız!Dialogue: 0,0:30:25.49,0:30:28.90,Main,,0,0,0,,Bekle maymun kardeş! Etrafı bilen birileri lazım!Dialogue: 0,0:30:33.21,0:30:36.45,Main,,0,0,0,,Eyvah-degosaru! Samuraylar burada-degosaru!Dialogue: 0,0:30:36.84,0:30:38.78,Main,,0,0,0,,Herkese haber vermem lazım!Dialogue: 0,0:30:40.28,0:30:43.65,Main,,0,0,0,,Samuraylar burada-degosaru!Dialogue: 0,0:30:43.65,0:30:46.70,OP11 Credits,,0,0,0,,Editing: Galaxy 9000  Timing: Datenshi, Sewil  QC: Mr Luffy, Galaxy 9000, Datenshi Grug  Soundtracking: Halee  TC/Infoboxes: Datenshi  Translation: Yibis