Dialogue: 0,0:01:42.20,0:01:45.50,Title,,0,0,0,,{\pos(634.667,478)}{\fad(750,500)}Zou
Dialogue: 0,0:01:42.24,0:01:45.50,Captions,,0,0,0,,{\pos(629.334,571.334)}{\fad(250,0)}Dressrosa
Dialogue: 0,0:01:46.33,0:01:50.13,Captions,,0,0,175,,{\fad(500,0)}Kraliyet Sarayı
Dialogue: 0,0:01:46.41,0:01:50.13,Main,,0,0,0,,{\an8}Kaçakçılık için kullandıkları\Nlisteyi bulamadım.
Dialogue: 0,0:01:50.13,0:01:54.34,Main,,0,0,0,,Ama listeyi birilerinin çaldığı\Ngün gibi ortada.
Dialogue: 0,0:01:54.34,0:01:55.59,Main,,0,0,0,,Tahmin etmiştim.
Dialogue: 0,0:01:56.20,0:02:02.22,Main,,0,0,0,,Geride bırakılan tüm silah ve patlayıcılar da \Nyaşanan bu olay sonrasında çalınmışlar.
Dialogue: 0,0:02:02.22,0:02:04.56,Main,,0,0,0,,{\an8}Büyük bir miktardan bahsediyorum.
Dialogue: 0,0:02:04.31,0:02:09.31,Captions,,0,0,235,,{\fad(500,0)}Cipher Pol, Aigis 0
Dialogue: 0,0:02:04.56,0:02:06.76,Main,,0,0,0,,{\an8}Örgütün işi olmalı.
Dialogue: 0,0:02:06.76,0:02:09.31,Main,,0,0,0,,{\an8}Bu konuda Donanma da epey endişeliydi.
Dialogue: 0,0:02:09.31,0:02:11.31,Main,,0,0,0,,Devrim Ordusu ha?
Dialogue: 0,0:02:11.31,0:02:15.75,Main,,0,0,0,,Evet. Onlardan başkası olamaz.\NGeri dönebilirsin.
Dialogue: 0,0:02:16.24,0:02:18.03,Main,,0,0,0,,Çok can sıkmaya başladılar.
Dialogue: 0,0:02:18.03,0:02:20.45,Main,,0,0,0,,Haklısın, patron!
Dialogue: 0,0:02:20.95,0:02:22.96,Main,,0,0,0,,Aynı senin gibi...
Dialogue: 0,0:02:23.65,0:02:26.08,Main,,0,0,0,,Vay canına!\NSöylenecek şey mi o, kalbimi kırdın!
Dialogue: 0,0:02:31.04,0:02:35.62,Main,,0,0,0,,Şimdi yolculuk nereye, Hasır Şapka?
Dialogue: 0,0:02:37.97,0:02:41.90,Narrator,,0,0,0,,Burası trajedilerin ülkesi.
Dialogue: 0,0:02:42.53,0:02:48.48,Narrator,,0,0,0,,Birbiri ardına\Nadayı pençesine alan kara sicimleri...
Dialogue: 0,0:02:48.48,0:02:50.69,Narrator,,0,0,0,,...ve yaşadıkları felaketleri\Ndüşünen insanlar...
Dialogue: 0,0:02:50.69,0:02:54.66,Narrator,,0,0,0,,...gözyaşlarına engel olup\Ndört bir yanda yankılanan...
Dialogue: 0,0:02:57.89,0:02:59.60,Main,,0,0,0,,Oh, evet!
Dialogue: 0,0:03:00.07,0:03:03.28,Narrator,,0,0,0,,...el çırpma sesleriyle\Nmüziğe eşlik ediyorlar!
Dialogue: 0,0:03:12.90,0:03:19.26,Narrator,,0,0,0,,Uzun, hüzünlü ve isimsiz gösteri sırasında,\Ninikti perdeler tek bir alkış olmaksızın...
Dialogue: 0,0:03:19.26,0:03:22.93,Narrator,,0,0,0,,...ve sonra hakikat çalındı kulaklarına.
Dialogue: 0,0:03:28.35,0:03:34.27,Narrator,,0,0,0,,Kral geri döndü ve şu an huzur içinde,\Nbarış dolu bir gelecek bekliyor bizleri.
Dialogue: 0,0:03:34.99,0:03:38.96,Main,,0,0,0,,Size bir teklifim olacak...
Dialogue: 0,0:03:38.96,0:03:43.34,Main,,0,0,0,,Takdim için teşekkür ederim.
Dialogue: 0,0:03:43.34,0:03:46.49,Main,,0,0,0,,Bendeniz Tontaların Şefi Gancho!
Dialogue: 0,0:03:47.77,0:03:51.35,Main,,0,0,0,,Yanımda gördüğünüz kişi de kızım...
Dialogue: 0,0:03:51.35,0:03:53.72,Main,,0,0,0,,Adım Mansherry!
Dialogue: 0,0:03:57.20,0:03:59.34,Main,,0,0,0,,Ay ne şirin!
Dialogue: 0,0:04:03.47,0:04:06.14,Main,,0,0,0,,Bunu yapmamızı istiyorsun ha, Leo-kun?
Dialogue: 0,0:04:06.14,0:04:07.22,Main,,0,0,0,,Evet, lütfen!
Dialogue: 0,0:04:07.22,0:04:09.39,Main,,0,0,0,,Size güveniyoruz!
Dialogue: 0,0:04:13.43,0:04:17.55,Main,,0,0,0,,Dünya Konferansı "Reverie" bu yıl yapılacak.
Dialogue: 0,0:04:17.55,0:04:19.78,Main,,0,0,0,,Fazla zaman kalmamış.
Dialogue: 0,0:04:19.78,0:04:23.43,Main,,0,0,0,,Diğer ülkeler hazırlıklara\Nçoktan başlamışlar gibi.
Dialogue: 0,0:04:23.43,0:04:25.42,Main,,0,0,0,,Baba!
Dialogue: 0,0:04:25.42,0:04:29.66,Main,,0,0,0,,Rebecca akşama doğru\Nbize yemek pişirmeye gelecekmiş!
Dialogue: 0,0:04:29.66,0:04:32.62,Main,,0,0,0,,Öyle demek!? Peki ya Kyros?
Dialogue: 0,0:04:32.62,0:04:34.50,Main,,0,0,0,,Elbette beraber gelecekler.
Dialogue: 0,0:04:34.50,0:04:40.84,Main,,0,0,0,,Çok sevindim! Uzun bir aradan sonra\Ntüm aile bir arada olacak!
Dialogue: 0,0:04:42.16,0:04:48.39,Narrator,,0,0,0,,Bu krallığın ziyaretçileri,\Nhalk arasına karışıp...
Dialogue: 0,0:04:52.74,0:04:54.38,Main,,0,0,0,,Jambon alacaktım!
Dialogue: 0,0:04:54.38,0:04:55.86,Main,,0,0,0,,Hoş geldiniz!
Dialogue: 0,0:04:55.86,0:04:58.16,Main,,0,0,0,,Rebecca, Mansherry!
Dialogue: 0,0:04:59.11,0:05:06.06,Narrator,,0,0,0,,...insanlarla yan yana yaşayan\Nşirin mi şirin Küçük İnsanlara...
Dialogue: 0,0:05:06.06,0:05:07.10,Main,,0,0,0,,Hey, hey.
Dialogue: 0,0:05:07.10,0:05:09.16,Main,,0,0,0,,Daha başımızı sokacak evlerimizi yapamadık.
Dialogue: 0,0:05:09.16,0:05:12.16,Main,,0,0,0,,Yok yok, bu bizim\Nen öncelikli işimiz olmalı!
Dialogue: 0,0:05:13.08,0:05:17.44,Narrator,,0,0,0,,...hayran kalacaklar!
Dialogue: 0,0:05:23.33,0:05:27.45,Narrator,,0,0,0,,Burası aşkın, tutkunun ve perilerin ülkesi...
Dialogue: 0,0:05:27.45,0:05:29.64,Main,,0,0,0,,Haklısın, heykeller önce gelir!
Dialogue: 0,0:05:29.64,0:05:30.85,Main,,0,0,0,,Evet!
Dialogue: 0,0:05:32.01,0:05:34.70,Narrator,,0,0,0,,...Dressrosa.
Dialogue: 0,0:05:42.65,0:05:46.84,Main,,0,0,0,,{\an8}Tutukluyu teslim eder etmez\Nbir seyahate çıkacağım.
Dialogue: 0,0:05:43.90,0:05:48.41,Captions,,0,0,170,,{\fad(500,0)}Donanma Filosu
Dialogue: 0,0:05:46.84,0:05:48.41,Main,,0,0,0,,{\an8}Seyahat mi dedin?
Dialogue: 0,0:05:51.70,0:05:57.83,Main,,0,0,0,,Hasır Şapka ve Law'un kelleleri olmadan\NDonanma Karargâhı'na adım atamam sonuçta...
Dialogue: 0,0:06:00.70,0:06:02.38,Main,,0,0,0,,Çok inatçısın ha!
Dialogue: 0,0:06:02.38,0:06:06.59,Main,,0,0,0,,Özür dilesen\NSakazuki de görünüşü kurtarabilir.
Dialogue: 0,0:06:06.59,0:06:08.22,Main,,0,0,0,,İstemiyorum.
Dialogue: 0,0:06:08.62,0:06:09.93,Main,,0,0,0,,Neden?
Dialogue: 0,0:06:09.93,0:06:13.06,Main,,0,0,0,,Benim de korumam gereken\Nbir duruşum mevcut.
Dialogue: 0,0:06:16.43,0:06:18.98,Main,,0,0,0,,Ah sen yok musun!
Dialogue: 0,0:06:24.18,0:06:26.49,Main,,0,0,0,,Fujitora.
Dialogue: 0,0:06:28.54,0:06:32.49,Main,,0,0,0,,Aptalın teki o, Tsuru-san.
Dialogue: 0,0:06:32.49,0:06:35.87,Main,,0,0,0,,Son şansıydı bu.
Dialogue: 0,0:06:35.87,0:06:40.25,Main,,0,0,0,,Benimle bir olup\Nveletlerden kurtulmama yardım etseydi...
Dialogue: 0,0:06:40.25,0:06:43.38,Main,,0,0,0,,...işler bu hale gelmeyecekti.
Dialogue: 0,0:06:43.99,0:06:47.51,Main,,0,0,0,,Dizginler benim elimdeydi.
Dialogue: 0,0:06:47.51,0:06:51.80,Main,,0,0,0,,Dünyadaki canavarların zincirlerinden bahsediyorum.
Dialogue: 0,0:06:52.31,0:06:56.25,Main,,0,0,0,,Beni almayacaktınız.
Dialogue: 0,0:06:56.25,0:07:00.96,Main,,0,0,0,,Buna çok pişman olacaksınız.
Dialogue: 0,0:07:00.96,0:07:04.49,Main,,0,0,0,,Zavallı hikayelerini kendine sakla.
Dialogue: 0,0:07:05.69,0:07:11.68,Main,,0,0,0,,"O zaman keşke şöyle olsaydı"\Ndiye bir dünya yok!
Dialogue: 0,0:07:11.68,0:07:14.50,Main,,0,0,0,,Tek gerçeklik yaşanmış olanlar.
Dialogue: 0,0:07:18.00,0:07:20.41,Main,,0,0,0,,Yenildin.
Dialogue: 0,0:07:26.29,0:07:30.30,Main,,0,0,0,,Sana doyum olmuyor ha!
Dialogue: 0,0:07:31.88,0:07:33.89,Main,,0,0,0,,Kişi kendinden bilir işi.
Dialogue: 0,0:07:33.89,0:07:37.85,Main,,0,0,0,,Korsanlar dünyasına\Nbundan sonra ne olacak?
Dialogue: 0,0:07:38.69,0:07:41.96,Main,,0,0,0,,Soruna soruyla\Nkarşılık veriyor olacağım ama...
Dialogue: 0,0:07:41.96,0:07:45.32,Main,,0,0,0,,...şimdiye dek beslediğim yemini yitirmiş\Nve zinciri kopmuş canavarlar...
Dialogue: 0,0:07:45.32,0:07:48.01,Main,,0,0,0,,...ne yapacak sanıyorsun?
Dialogue: 0,0:07:48.01,0:07:52.30,Main,,0,0,0,,Şu anda tüm denizlere hakim,\Nzirvede bir isim var mı?
Dialogue: 0,0:07:52.30,0:07:55.28,Main,,0,0,0,,Denizlere kim hükmediyor?
Dialogue: 0,0:07:55.28,0:07:59.82,Main,,0,0,0,,Denizin imparatorları Yonko'dan biri mi?
Dialogue: 0,0:07:55.28,0:07:59.82,Note,,0,0,0,,Yonko: Dört İmparator
Dialogue: 0,0:07:59.82,0:08:03.65,Main,,0,0,0,,Zekice denizlerde yaşayan Shichibukai mı?
Dialogue: 0,0:07:59.82,0:08:03.65,Note,,0,0,0,,Shichibukai: Yedi Savaş Ağası
Dialogue: 0,0:08:03.65,0:08:08.19,Main,,0,0,0,,Yoksa En Kötü Nesil'in veletleri mi?
Dialogue: 0,0:08:09.23,0:08:10.88,Main,,0,0,0,,Yok yok...
Dialogue: 0,0:08:10.88,0:08:16.35,Main,,0,0,0,,Adaletin güçlü eli Donanma da\Ndenizleri fethediyor!
Dialogue: 0,0:08:16.35,0:08:19.80,Main,,0,0,0,,Halkın müttefiki Devrim Ordusu'nda da...
Dialogue: 0,0:08:19.80,0:08:23.23,Main,,0,0,0,,...gözden kaçırılmaması gereken\Ngüçlü kişiler var.
Dialogue: 0,0:08:24.90,0:08:29.74,Main,,0,0,0,,Tarihin gölgesinde saklanan\ND. ailesi de tabii...
Dialogue: 0,0:08:30.44,0:08:33.90,Main,,0,0,0,,Ne zaman ortaya çıkacaklar?!
Dialogue: 0,0:08:35.57,0:08:38.37,Main,,0,0,0,,Kim müttefik olacak?
Dialogue: 0,0:08:38.37,0:08:41.37,Main,,0,0,0,,Kim kime ihanet edecek?!
Dialogue: 0,0:08:41.37,0:08:46.26,Main,,0,0,0,,Mariejois'daki Kutsal Ejderler'e şunu ilet...
Dialogue: 0,0:08:41.37,0:08:46.26,Note,,0,0,0,,Tenryuubito: Kutsal Ejderler
Dialogue: 0,0:08:46.26,0:08:50.46,Main,,0,0,0,,Hepiniz alaşağı olacaksınız!
Dialogue: 0,0:08:50.46,0:08:56.47,Main,,0,0,0,,Gold Roger'ın Grand Line'ı tamamen\Nkeşfetmesinin üzerinden 25 yıl geçti.
Dialogue: 0,0:08:56.47,0:08:59.59,Main,,0,0,0,,Can düşmanı Beyazsakal'sa\Ntahta oturmayıp...
Dialogue: 0,0:08:59.59,0:09:02.85,Main,,0,0,0,,...yalnızca önünde durarak\Ndizginleri eline aldı.
Dialogue: 0,0:09:02.85,0:09:05.46,Main,,0,0,0,,Peki ya şimdi?!
Dialogue: 0,0:09:05.46,0:09:08.86,Main,,0,0,0,,Sayıları anbean artan korsanların aksine...
Dialogue: 0,0:09:08.86,0:09:11.93,Main,,0,0,0,,...boş tek bir koltuk var!
Dialogue: 0,0:09:11.93,0:09:14.20,Main,,0,0,0,,Anlıyorsun değil mi?
Dialogue: 0,0:09:15.06,0:09:17.69,Main,,0,0,0,,Başlayacak!
Dialogue: 0,0:09:17.69,0:09:21.63,Main,,0,0,0,,Korsan tarihindeki en büyük...
Dialogue: 0,0:09:22.54,0:09:25.37,Main,,0,0,0,,...üstünlük mücadelesi başlayacak!
Dialogue: 0,0:09:25.37,0:09:26.88,Main,,0,0,0,,Gemi direği alev aldı!
Dialogue: 0,0:09:26.88,0:09:28.17,Main,,0,0,0,,Söndürün!
Dialogue: 0,0:09:34.67,0:09:38.48,Main,,0,0,0,,Impel Down'a mı gidiyoruz?
Dialogue: 0,0:09:38.48,0:09:43.39,Main,,0,0,0,,Zahmet olacak ama her gün bir adet\Ngazete getirmenizi isteyeceğim.
Dialogue: 0,0:09:43.70,0:09:47.64,Main,,0,0,0,,Canım sıkılmasın diye.
Dialogue: 0,0:09:51.35,0:09:53.54,Main,,0,0,0,,Dört Donanma gemisi var.
Dialogue: 0,0:09:53.54,0:09:59.28,Main,,0,0,0,,Ama içlerinde çok sağlam kişiler mevcut.\NÜlke falan yok etmeye mi gidiyorlar?!
Dialogue: 0,0:09:59.28,0:10:01.70,Main,,0,0,0,,Nakil için bu kadar güç kullanmaya\Ngerek var mı?!
Dialogue: 0,0:10:01.70,0:10:05.20,Main,,0,0,0,,Doflamingo-sama'dan bahsediyoruz burada!
Dialogue: 0,0:10:06.81,0:10:09.20,Main,,0,0,0,,Joker'ı geri almak imkansız bir hal aldı.
Dialogue: 0,0:10:09.20,0:10:11.62,Main,,0,0,0,,Kaptan Jack, dönelim mi?
Dialogue: 0,0:10:11.62,0:10:12.72,Main,,0,0,0,,Neden?
Dialogue: 0,0:10:12.72,0:10:13.71,Main,,0,0,0,,Ne?
Dialogue: 0,0:10:13.71,0:10:16.51,Main,,0,0,0,,Aptal herif! Bu işi halledeceğiz!
Dialogue: 0,0:10:16.51,0:10:17.51,Main,,0,0,0,,Ne?!
Dialogue: 0,0:10:17.51,0:10:19.52,Main,,0,0,0,,Sen benim kim olduğumu biliyor musun?!
Dialogue: 0,0:10:27.31,0:10:29.59,Captions,,0,0,0,,{\pos(1072,363.667)}{\fad(500,500)}Luffy'nin Grubu
Dialogue: 0,0:10:30.18,0:10:33.78,Captions,,0,0,0,,{\pos(637.333,483.667)}{\fad(250,500)}Barto Kulübü Korsan Gemisi\NGoing Luffy-senpai
Dialogue: 0,0:10:31.28,0:10:33.08,Main,,0,0,0,,{\an8}Kafayı mı sıyırdınız siz?!
Dialogue: 0,0:10:33.08,0:10:35.68,Main,,0,0,0,,{\an8}Gören de Luffy bu gemide yaşıyor sanır!
Dialogue: 0,0:10:35.68,0:10:38.10,Main,,0,0,0,,Bunu duyduğuma çok sevindim!
Dialogue: 0,0:10:38.10,0:10:39.36,Main,,0,0,0,,İltifat etmiyordum!
Dialogue: 0,0:10:39.36,0:10:44.66,Main,,0,0,0,,Ayrıca şu anda bizi\Nher şeyden daha çok mutlu eden şey...
Dialogue: 0,0:10:46.16,0:10:50.42,Main,,0,0,0,,...bu Vivre Kartı'nın gösterdiği yönde...
Dialogue: 0,0:10:46.16,0:10:50.42,Note,,0,0,0,,Vivre Kartı: Yaşam Kartı
Dialogue: 0,0:10:50.42,0:10:53.71,Main,,0,0,0,,...gerçek Luffy-senpai'nin oluşudur!
Dialogue: 0,0:10:56.20,0:11:02.84,Main,,0,0,0,,Hoş geldiniz! Gemimize ayak bastığınız için\Nne kadar teşekkür etsek azdır!
Dialogue: 0,0:11:04.84,0:11:07.90,Main,,0,0,0,,Patron, o kadar göz kamaştırıcı biri ki\Nbakamıyorum resmen!
Dialogue: 0,0:11:07.90,0:11:10.23,Main,,0,0,0,,Ben de öyle!
Dialogue: 0,0:11:13.78,0:11:16.11,Main,,0,0,0,,Hepsi aynı telden demek...
Dialogue: 0,0:11:19.07,0:11:24.38,Main,,0,0,0,,Sabo'nun Vivre Kartı'nı yapması\Nçok hoş olmuş!
Dialogue: 0,0:11:24.38,0:11:27.59,Main,,0,0,0,,Ne olur ne olmaz diye\NLuffy'nin Vivre Kartı'nı yapmıştım.
Dialogue: 0,0:11:27.59,0:11:30.30,Main,,0,0,0,,Ha?! Ne ara zaman bulabildin?
Dialogue: 0,0:11:30.30,0:11:32.09,Main,,0,0,0,,Bir parçasını alıyorum.
Dialogue: 0,0:11:32.09,0:11:35.04,Main,,0,0,0,,Yüce Sabo-senpai'me bak sen be!
Dialogue: 0,0:11:35.04,0:11:38.42,Main,,0,0,0,,Hem düşünceli hem de güçlü biri!\NNe adam ama!
Dialogue: 0,0:11:41.26,0:11:45.40,Main,,0,0,0,,Oğullarından biri olmayacağım ama...
Dialogue: 0,0:11:45.40,0:11:48.22,Main,,0,0,0,,...yine de bir parça alıyorum.
Dialogue: 0,0:11:48.22,0:11:49.22,Main,,0,0,0,,Bellamy!
Dialogue: 0,0:11:49.22,0:11:51.64,Main,,0,0,0,,Biz de alacağız.
Dialogue: 0,0:11:52.90,0:11:55.48,Main,,0,0,0,,Pekâlâ öyleyse, şimdilik veda vakti geldi!
Dialogue: 0,0:11:55.48,0:11:58.57,Main,,0,0,0,,Görüşmek üzere, patron!
Dialogue: 0,0:11:58.57,0:12:00.65,Main,,0,0,0,,Hasır Şapkalı Luffy!
Dialogue: 0,0:12:01.20,0:12:04.24,Main,,0,0,0,,Görüşürüz millet!
Dialogue: 0,0:12:05.62,0:12:10.52,Main,,0,0,0,,Ziyafette ne eğlendik ama ya!\NOnları sevmeye başladım!
Dialogue: 0,0:12:10.52,0:12:14.29,Main,,0,0,0,,Bartolomeo, \Nzaman kaybetmeden Zou'ya varalım!
Dialogue: 0,0:12:14.29,0:12:16.99,Main,,0,0,0,,Kiminle konuştuğunu sanıyorsun...
Dialogue: 0,0:12:16.99,0:12:18.46,Main,,0,0,0,,Sana güveniyoruz.
Dialogue: 0,0:12:18.46,0:12:21.22,Main,,0,0,0,,Elbette! Bana bırakın!
Dialogue: 0,0:12:21.22,0:12:25.26,Main,,0,0,0,,Beyler, tam hız Zou'ya gidiyoruz!
Dialogue: 0,0:12:25.26,0:12:27.30,Main,,0,0,0,,Peki!
Dialogue: 0,0:12:27.30,0:12:30.60,Main,,0,0,0,,Acaba Sanji'ler adaya\Nsağ salim varabilmişler midir?
Dialogue: 0,0:12:30.60,0:12:33.60,Main,,0,0,0,,Nami yanlarındaydı yani seyrüsefer konusunda\Nbir sıkıntı çıkacağını sanmıyorum...
Dialogue: 0,0:12:33.60,0:12:36.40,Main,,0,0,0,,...ama Big Mom'ın gemisine\Nne oldu acaba?
Dialogue: 0,0:12:36.40,0:12:37.82,Main,,0,0,0,,Endişeleniyor insan.
Dialogue: 0,0:12:38.66,0:12:40.58,Main,,0,0,0,,Hey, Luffy.
Dialogue: 0,0:12:40.58,0:12:43.11,Main,,0,0,0,,Görünüşe bakılırsa bizim ödüller artmış.
Dialogue: 0,0:12:43.20,0:12:45.07,Main,,0,0,0,,Ne? Harbi mi?!
Dialogue: 0,0:12:45.07,0:12:48.22,Main,,0,0,0,,Bilmiyor muydunuz?!
Dialogue: 0,0:12:50.70,0:12:54.58,Main,,0,0,0,,Aranıyor posterleri odamda, buyrun!
Dialogue: 0,0:12:54.58,0:12:55.59,Main,,0,0,0,,Buyrun!
Dialogue: 0,0:12:55.59,0:12:57.04,Main,,0,0,0,,Gelelim madem!
Dialogue: 0,0:12:57.04,0:12:58.58,Main,,0,0,0,,Hey, Trafalgar.
Dialogue: 0,0:12:58.58,0:13:01.22,Main,,0,0,0,,Senin posteri atmıştım ama\Nödülün 500 milyon olmuş.
Dialogue: 0,0:13:01.22,0:13:05.94,Main,,0,0,0,,Hadi ya? Sağ ol.\NÖdül falan umrumda değil.
Dialogue: 0,0:13:07.98,0:13:10.64,Main,,0,0,0,,Bakın lütfen!
Dialogue: 0,0:13:10.64,0:13:12.10,Main,,0,0,0,,Çevçeveletmiş!
Dialogue: 0,0:13:12.10,0:13:14.69,Main,,0,0,0,,Verdiğiniz imzalarınızı da koydum!
Dialogue: 0,0:13:14.69,0:13:18.73,Main,,0,0,0,,{\an8}Hasır Şapkalı Luffy-senpai'ninkinden başlayalım!
Dialogue: 0,0:13:14.90,0:13:16.83,Captions,,320,0,570,,{\pos(825,141)}"Ben"
Dialogue: 0,0:13:14.90,0:13:16.83,Captions,,720,0,350,,{\pos(1010,378)}"Bartolomeo'ya"
Dialogue: 0,0:13:14.90,0:13:16.83,Captions,,0,730,350,,{\pos(347,368)}"Kılıç"
Dialogue: 0,0:13:14.90,0:13:16.83,Captions,,0,660,150,,{\pos(305,606)}"Kardeşime"
Dialogue: 0,0:13:14.90,0:13:16.83,Captions,,830,0,150,,{\pos(986,607)}"Nico Robin"
Dialogue: 0,0:13:18.73,0:13:22.12,Main,,0,0,0,,Ödülün 500 milyon beli!
Dialogue: 0,0:13:22.12,0:13:26.03,Main,,0,0,0,,{\an8}500 milyon be! Budur!
Dialogue: 0,0:13:22.53,0:13:26.03,Captions,,0,0,0,,{\pos(393.334,510.001)}{\fad(500,0)}"Hasır Şapkalı" Luffy\NKelle Ödülü: 500 Milyon Beli
Dialogue: 0,0:13:26.03,0:13:30.09,Main,,0,0,0,,Sırada "Korsan Avcısı" Zoro-senpai...
Dialogue: 0,0:13:30.09,0:13:33.41,Main,,0,0,0,,{\an8}320 milyon beli!
Dialogue: 0,0:13:32.62,0:13:36.62,Captions,,0,0,0,,{\pos(424,520.667)}{\fad(500,0)}"Korsan Avcısı" Zoro\NKelle Ödülü: 320 Milyon Beli
Dialogue: 0,0:13:34.32,0:13:36.62,Main,,0,0,0,,{\an8}İçkisi olan var mı?
Dialogue: 0,0:13:37.14,0:13:39.94,Main,,0,0,0,,"Şeytanın Çocuğu" Nico Robin-senpai...
Dialogue: 0,0:13:39.94,0:13:43.04,Main,,0,0,0,,{\an8}130 milyon beli!
Dialogue: 0,0:13:41.84,0:13:45.84,Captions,,0,0,0,,{\pos(864,519.333)}{\fad(500,0)}"Şeytanın Çocuğu" Nico Robin\NKelle Ödülü: 130 Milyon Beli
Dialogue: 0,0:13:43.04,0:13:45.17,Main,,0,0,0,,{\an8}Olamaz, artmış.
Dialogue: 0,0:13:45.84,0:13:50.43,Main,,0,0,0,,"Sayborg" Franky-senpai...\N94 milyon beli!
Dialogue: 0,0:13:50.43,0:13:51.82,Main,,0,0,0,,{\an8}Çok az kalmış be!
Dialogue: 0,0:13:50.43,0:13:55.81,Captions,,0,0,0,,{\pos(397.333,519.334)}{\fad(500,0)}"Sayborg" Franky\NKelle Ödülü: 94 Milyon Beli
Dialogue: 0,0:13:51.82,0:13:55.81,Main,,0,0,0,,{\an8}Üstüne üstlük resim de General Franky'e ait...
Dialogue: 0,0:13:55.81,0:13:59.69,Main,,0,0,0,,"Tanrı" Usopp-senpai...\N200 milyon beli!
Dialogue: 0,0:13:59.69,0:14:03.19,Captions,,0,0,0,,{\pos(885.333,515.333)}{\fad(500,0)}"Tanrı" Usopp\NKelle Ödülü: 200 Milyon Beli
Dialogue: 0,0:14:00.42,0:14:03.19,Main,,0,0,0,,{\an8}Hem maskesiz hem de ödüle bak!
Dialogue: 0,0:14:03.19,0:14:04.78,Main,,0,0,0,,Peşime düşecekler!
Dialogue: 0,0:14:04.78,0:14:06.20,Main,,0,0,0,,Ama çok mutlu oldum!
Dialogue: 0,0:14:06.20,0:14:08.07,Main,,0,0,0,,Ama resim berbat çıkmış!
Dialogue: 0,0:14:08.07,0:14:13.76,Main,,0,0,0,,Şaka mı be bu?!\NSenin ödül niye o kadar artmış?!
Dialogue: 0,0:14:13.76,0:14:16.79,Main,,0,0,0,,Kendi dostlarım bile\Nbeni öldürmeye çalışıyor!
Dialogue: 0,0:14:16.79,0:14:21.34,Main,,0,0,0,,100 milyonun altında bir ben kalmışım!\NKahrımdan öleyim mi şimdi?!
Dialogue: 0,0:14:21.34,0:14:22.88,Main,,0,0,0,,Dur, dur biraz! Bir daha bak!
Dialogue: 0,0:14:22.88,0:14:24.42,Main,,0,0,0,,Namiler de var daha!
Dialogue: 0,0:14:24.42,0:14:29.93,Main,,0,0,0,,"Kara Bacak" Sanji-senpai...\N177 milyon beli!
Dialogue: 0,0:14:29.93,0:14:33.68,Captions,,0,0,0,,{\pos(428,519.334)}{\fad(500,0)}"Kara Bacak" Sanji\NÖdülü: 177 Milyon Beli
Dialogue: 0,0:14:30.12,0:14:33.68,Main,,0,0,0,,{\an8}Resmi artık çizim değil!
Dialogue: 0,0:14:33.68,0:14:35.70,Main,,0,0,0,,İşin eğlencesi kaçmış,...
Dialogue: 0,0:14:35.70,0:14:37.52,Main,,0,0,0,,...öteki daha komikti.
Dialogue: 0,0:14:39.73,0:14:44.72,Main,,0,0,0,,{\an8}"Hırsız Kedi" Nami-senpai...\N66 milyon beli!
Dialogue: 0,0:14:43.77,0:14:48.15,Captions,,0,0,0,,{\pos(912,514)}{\fad(500,0)}"Hırsız Kedi" Nami\NKelle Ödülü: 66 Milyon Beli
Dialogue: 0,0:14:44.72,0:14:48.15,Main,,0,0,0,,{\an8}Bu resmi ne ara çektirmiş?!
Dialogue: 0,0:14:48.15,0:14:51.38,Main,,0,0,0,,"Pamuk Şeker Hastası"\NChopper-senpai...
Dialogue: 0,0:14:51.38,0:14:53.20,Main,,0,0,0,,100 beli!
Dialogue: 0,0:14:53.20,0:14:56.20,Captions,,0,0,0,,{\pos(402.667,519.333)}{\fad(500,0)}"Pamuk Şeker Hastası" Chopper\NKelle Ödülü: 100 Beli
Dialogue: 0,0:14:53.20,0:14:56.20,Main,,0,0,0,,{\an8}Aklıma onu sevindirecek\Nhiçbir söz gelmiyor...
Dialogue: 0,0:14:56.20,0:15:01.47,Main,,0,0,0,,{\an8}"Ruh Kralı" Brook-senpai...\N83 milyon beli!
Dialogue: 0,0:15:00.96,0:15:05.09,Captions,,0,0,0,,{\pos(877.333,515.333)}{\fad(500,0)}"Ruh Kralı" Brook\NKelle Ödülü: 83 Milyon Beli
Dialogue: 0,0:15:01.47,0:15:05.09,Main,,0,0,0,,{\an8}Konser posteri mi bu?!
Dialogue: 0,0:15:05.09,0:15:10.82,Main,,0,0,0,,Son yaşanan olayda göz önünde bulunmayıp ne kadar tehlikeli olabileceklerini göstermeyenler haricinde...
Dialogue: 0,0:15:10.82,0:15:14.18,Main,,0,0,0,,...herkesin ödülü 50 milyon artmış!
Dialogue: 0,0:15:14.18,0:15:16.96,Main,,0,0,0,,Bizimki de 50 milyon artmış.
Dialogue: 0,0:15:16.96,0:15:19.14,Main,,0,0,0,,Ama...
Dialogue: 0,0:15:19.14,0:15:20.98,Main,,0,0,0,,...şuna bakın biraz.
Dialogue: 0,0:15:20.98,0:15:24.74,Main,,0,0,0,,"Kara Bacak" Sanji-senpai için \Nödül tuhaf bir biçimde arttığı gibi...
Dialogue: 0,0:15:24.74,0:15:27.37,Main,,0,0,0,,...bir de bu yazı var.
Dialogue: 0,0:15:27.37,0:15:30.33,Main,,0,0,0,,"YALNIZCA DİRİ" mi?
Dialogue: 0,0:15:34.24,0:15:35.70,Main,,0,0,0,,Dolu!
Dialogue: 0,0:15:35.70,0:15:37.62,Main,,0,0,0,,Çok büyükler! Dikkatli olun!
Dialogue: 0,0:15:39.50,0:15:42.47,Main,,0,0,0,,– Ha?!\N– Güvertede delik açtı!
Dialogue: 0,0:15:42.47,0:15:45.34,Main,,0,0,0,,Luffy-senpailerim, siz hemen içeri geçin!
Dialogue: 0,0:15:45.34,0:15:47.67,Main,,0,0,0,,Ne diyorsun sen?! Yardım edeceğiz!
Dialogue: 0,0:15:47.67,0:15:49.92,Main,,0,0,0,,Ne tarafa gidelim?!
Dialogue: 0,0:15:49.92,0:15:52.84,Main,,0,0,0,,Rotacınız kim?! Yön söylesin!
Dialogue: 0,0:15:52.84,0:15:58.81,Main,,0,0,0,,Rotacımız yok bizim,\Nözünde kara tabanlı bir gruptuk da...
Dialogue: 0,0:15:59.85,0:16:02.56,Main,,0,0,0,,Oha! Yeni Dünya'da olduğunuzun\Nfarkında mısınız siz?!
Dialogue: 0,0:16:02.56,0:16:05.62,Main,,0,0,0,,Alo, nine? Benim ben, Gambia!
Dialogue: 0,0:16:05.62,0:16:09.70,Main,,0,0,0,,Biliyor musun dehşet bir\Ndolu yağışı başladı burada.
Dialogue: 0,0:16:09.70,0:16:13.69,Main,,0,0,0,,Başımız ne zaman derde girse \NDen Den Mushi'yle memleketimizdeki ninemizi ararız.
Dialogue: 0,0:16:13.69,0:16:17.03,Main,,0,0,0,,Anlıyorum! \NDenizler hakkında bilgili biri demek?
Dialogue: 0,0:16:17.03,0:16:18.44,Main,,0,0,0,,Hey, öğrendim!
Dialogue: 0,0:16:18.44,0:16:21.71,Main,,0,0,0,,Güvertede çıkartamadığımız sakızlar vardı,\Nhatırlıyor musunuz?
Dialogue: 0,0:16:21.71,0:16:23.79,Main,,0,0,0,,Evet, bir türlü becerememiştik!
Dialogue: 0,0:16:23.79,0:16:27.54,Main,,0,0,0,,Yağan buz parçalarını kumaşla sarıp \Nsakızların üzerine sürünce kolayca çıkarlarmış!
Dialogue: 0,0:16:27.54,0:16:28.80,Main,,0,0,0,,Hadi ya!
Dialogue: 0,0:16:29.86,0:16:32.34,Main,,0,0,0,,Tak diye çıktı cidden!
Dialogue: 0,0:16:32.34,0:16:35.18,Main,,0,0,0,,Ha çok lazımdı şimdi bu bilgi!
Dialogue: 0,0:16:35.18,0:16:36.76,Main,,0,0,0,,Ama...
Dialogue: 0,0:16:36.76,0:16:38.31,Main,,0,0,0,,Kafasına buz düştü!
Dialogue: 0,0:16:38.31,0:16:40.64,Main,,0,0,0,,Şişmiş yerlerine şeker koyun diyor!
Dialogue: 0,0:16:40.64,0:16:42.94,Main,,0,0,0,,Bu kadar nine bilgisi yeter!
Dialogue: 0,0:16:42.94,0:16:46.77,Main,,0,0,0,,Eyvah, gemi batacak!\NNami, kurtar bizi!
Dialogue: 0,0:16:46.77,0:16:50.61,Main,,0,0,0,,Binecek tonla gemi vardı\Nseçe seçe bunu seçtik!
Dialogue: 0,0:16:50.61,0:16:53.49,Main,,0,0,0,,Bir şekilde bizim halletmemiz\Ngerekecek anlaşılan.
Dialogue: 0,0:16:53.49,0:16:57.76,Main,,0,0,0,,Keşke en azından Sunny-go'daki\Naletlerim yanımda olsaydı!
Dialogue: 0,0:16:57.76,0:16:59.41,Main,,0,0,0,,Ne canlı bir gemi!
Dialogue: 0,0:17:00.56,0:17:02.66,Main,,0,0,0,,Bariyerini niye kullanmıyorsun?!
Dialogue: 0,0:17:02.66,0:17:06.15,Main,,0,0,0,,Şey, ninem diyor ki...
Dialogue: 0,0:17:06.15,0:17:08.98,Main,,0,0,0,,..."Doğaya karşı gelirsen pişman olursun!"
Dialogue: 0,0:17:08.98,0:17:11.30,Main,,0,0,0,,Bu kadar korkuyorsan karaya geri dön!
Dialogue: 0,0:17:11.30,0:17:12.92,Main,,0,0,0,,Şaka mı bunlar?!
Dialogue: 0,0:17:12.92,0:17:17.64,Main,,0,0,0,,Millet, Tanrı'nın kendisinden bile\Nkorkmayan Hasır Şapkalar yanımızda...
Dialogue: 0,0:17:17.64,0:17:19.03,Main,,0,0,0,,...bin kişilik ordu gibiler!
Dialogue: 0,0:17:19.08,0:17:21.89,Main,,0,0,0,,Minnettarlığımızın kar gibi,\Ndolu gibi sonu yok!
Dialogue: 0,0:17:21.89,0:17:25.64,Main,,0,0,0,,Siz buraya kadar nasıl gelebildiniz\Nben ona şaşıyorum!
Dialogue: 0,0:17:25.64,0:17:27.35,Main,,0,0,0,,Ne sevinç!
Dialogue: 0,0:17:27.35,0:17:29.65,Main,,0,0,0,,Siz de yardım etsenize!
Dialogue: 0,0:17:31.02,0:17:34.04,Main,,0,0,0,,{\an8}Eskiden Beyazsakal Korsanları'nın parçası olan \NA.O. Korsanları ...
Dialogue: 0,0:17:31.98,0:17:36.99,Captions,,0,0,173,,{\fad(1000,0)}Donanma Karargâhı
Dialogue: 0,0:17:34.04,0:17:35.07,Main,,0,0,0,,{\an8}...ortadan kaldırıldı.
Dialogue: 0,0:17:35.07,0:17:36.99,Main,,0,0,0,,{\an8}Gene mi o yapmış?
Dialogue: 0,0:17:36.99,0:17:40.24,Main,,0,0,0,,Evet, Shichibukai Edward Weevil'ın işi.
Dialogue: 0,0:17:40.24,0:17:46.12,Captions,,0,0,0,,{\pos(629.333,486.333)}{\fad(500,0)}Donanma Amirali\NKizaru (Borsalino)
Dialogue: 0,0:17:40.24,0:17:43.35,Main,,0,0,0,,{\an8}Bununla beraber Beyazsakal'ın emrinde\Nçalışıp da...
Dialogue: 0,0:17:43.35,0:17:46.12,Main,,0,0,0,,{\an8}...işi biten kaç kaptan oldu?
Dialogue: 0,0:17:46.12,0:17:47.58,Main,,0,0,0,,16 efendim.
Dialogue: 0,0:17:49.33,0:17:51.92,Main,,0,0,0,,Diğerlerinde olduğu gibi\Nburada da bir tür tartışmanın ardından...
Dialogue: 0,0:17:51.92,0:17:54.55,Main,,0,0,0,,...bulundukları kasabayla beraber\Nhavaya uçurulmuşlar.
Dialogue: 0,0:17:54.55,0:17:57.43,Main,,0,0,0,,600 kadar kayıp var.
Dialogue: 0,0:17:57.43,0:18:01.89,Main,,0,0,0,,Her zaman yoğun miktarlarda\Nsivil zaiyata neden olan biri.
Dialogue: 0,0:18:01.89,0:18:05.76,Main,,0,0,0,,Shichibukai dahi olsa\Nbunu görmezden gelemeyiz.
Dialogue: 0,0:18:05.76,0:18:08.31,Main,,0,0,0,,Al başına belayı.
Dialogue: 0,0:18:08.31,0:18:12.69,Main,,0,0,0,,Kendisinden Beyazsakal\NEdward Newgate'in oğlu olarak bahsetmesi...
Dialogue: 0,0:18:12.69,0:18:15.57,Main,,0,0,0,,...onu özel biri yapıyor ama\Nbuna inanmayan da çok kişi mevcut.
Dialogue: 0,0:18:15.57,0:18:22.53,Note,,0,0,0,,{\an8}"Belirsiz Adalet"
Dialogue: 0,0:18:15.57,0:18:22.53,Main,,0,0,0,,Doğru olup olmadığı\Nbizi zerre ilgilendirmiyor.
Dialogue: 0,0:18:22.53,0:18:27.87,Main,,0,0,0,,Babası kim olursa olsun bizim için\Ndeğişmez tek bir değeri var.
Dialogue: 0,0:18:27.87,0:18:32.56,Main,,0,0,0,,O da bir korsan olarak\Ndevasa bir güce sahip olması.
Dialogue: 0,0:18:33.21,0:18:38.68,Main,,0,0,0,,Aynı Beyazsakal'ın gençliğinde olduğu gibi.
Dialogue: 0,0:18:38.68,0:18:41.68,Main,,0,0,0,,Gerçi aralarındaki tek benzerlik de bu.
Dialogue: 0,0:18:41.68,0:18:45.40,Narrator,,0,0,0,,{\i1}Dressrosa'dan ayrılmalarından bir hafta sonra...{\i0}
Dialogue: 0,0:18:45.40,0:18:49.02,Main,,0,0,0,,Acayip sis var, hiçbir şey görünmüyor.
Dialogue: 0,0:18:50.15,0:18:52.52,Main,,0,0,0,,Sizi de amma çok deniz tutuyor!
Dialogue: 0,0:18:52.52,0:18:54.40,Main,,0,0,0,,Ne biçim korsansınız siz?!
Dialogue: 0,0:18:54.40,0:18:56.53,Main,,0,0,0,,Sakız... Sakız...
Dialogue: 0,0:18:57.20,0:19:01.07,Main,,0,0,0,,Ninem sakızın biraz da olsa\Niyi geleceğini söylemişti.
Dialogue: 0,0:19:01.07,0:19:04.41,Main,,0,0,0,,O yüzden mi gemide\Nnereye elimi atsam sakıza dokunuyorum?!
Dialogue: 0,0:19:06.20,0:19:07.66,Main,,0,0,0,,Harikaymış!
Dialogue: 0,0:19:07.66,0:19:12.83,Main,,0,0,0,,Patron, saat iki yönünde\Nbir şey görüyorum!
Dialogue: 0,0:19:12.83,0:19:15.86,Main,,0,0,0,,Neymiş o bir şey?!
Dialogue: 0,0:19:15.86,0:19:17.55,Main,,0,0,0,,Yoğun sisin içinde...
Dialogue: 0,0:19:17.55,0:19:20.18,Main,,0,0,0,,...dağ mıdır canavar mıdır bilinmez...
Dialogue: 0,0:19:20.18,0:19:23.89,Main,,0,0,0,,Dağla karıştırılacak bir canavarsa\Nzaten ölelim biz!
Dialogue: 0,0:19:23.89,0:19:27.60,Main,,0,0,0,,Ama deminden beri\Nyavaş yavaş hareket ediyor gibi...
Dialogue: 0,0:19:27.60,0:19:30.69,Main,,0,0,0,,Çok içtin herhâlde, lanet...
Dialogue: 0,0:19:30.69,0:19:32.31,Main,,0,0,0,,Hareket eden bir dağsa hemen çıkalım!
Dialogue: 0,0:19:32.31,0:19:35.41,Main,,0,0,0,,Aptal olma! Şimdi yalnızca...
Dialogue: 0,0:19:35.41,0:19:38.74,Main,,0,0,0,,...bu sisin içinden çıkmaya\Nodaklanmamız lazım!
Dialogue: 0,0:19:38.74,0:19:41.08,Main,,0,0,0,,Yoksa kayalıklara falan çarpıp\Nalabora olacağız!
Dialogue: 0,0:19:41.08,0:19:42.63,Main,,0,0,0,,Bekle, Tanrı.
Dialogue: 0,0:19:43.24,0:19:46.02,Main,,0,0,0,,Tanrı mı dedin? Utandırıyorsun beni!
Dialogue: 0,0:19:46.02,0:19:50.62,Main,,0,0,0,,200 milyonluk biri olarak\Nresmen mahçup ediyorsun beni!
Dialogue: 0,0:19:50.62,0:19:55.25,Main,,0,0,0,,Artık Donanma amiralleri bile\Nfarkındadır senin.
Dialogue: 0,0:19:57.25,0:20:00.76,Main,,0,0,0,,Bakın. Vivre Kartı\No şeye doğru hareket ediyor.
Dialogue: 0,0:20:00.76,0:20:04.34,Main,,0,0,0,,Haklıymışsın! Tayfan orada demek!
Dialogue: 0,0:20:05.86,0:20:09.89,Main,,0,0,0,,Usopp, betin benzin attı birden!\NSakız getireyim mi?
Dialogue: 0,0:20:09.89,0:20:13.52,Main,,0,0,0,,Bu gerçekle yüzleşmekten kaçıyordum...
Dialogue: 0,0:20:14.44,0:20:21.36,Main,,0,0,0,,Zou'nun yoğun bir sis ve haşin akıntılarla yabancıları kendinden uzak tuttuğunu duymuştum.
Dialogue: 0,0:20:21.36,0:20:23.49,Main,,0,0,0,,Rüzgar da tam karşıdan esiyor!
Dialogue: 0,0:20:23.49,0:20:27.33,Main,,0,0,0,,Yelkenleri toplayın! Kürek çekeceğiz!
Dialogue: 0,0:20:27.33,0:20:29.96,Main,,0,0,0,,Baş üstüne...
Dialogue: 0,0:20:29.96,0:20:32.66,Main,,0,0,0,,Hey! Bu nasıl bir cevap şekli?!
Dialogue: 0,0:20:38.55,0:20:41.13,Main,,0,0,0,,Zou burası demek?
Dialogue: 0,0:20:41.13,0:20:43.32,Main,,0,0,0,,Çok tuhaf!
Dialogue: 0,0:20:43.32,0:20:46.76,Main,,0,0,0,,Eyvah ki ne eyvah!\NKaçalım! Gemiyi döndürün!
Dialogue: 0,0:20:46.76,0:20:49.01,Main,,0,0,0,,Hayır, doğru yerdeyiz.
Dialogue: 0,0:21:01.11,0:21:05.74,Main,,0,0,0,,Tra-o, bildiğin fil bu?!
Dialogue: 0,0:21:08.26,0:21:13.50,Main,,0,0,0,,Evet, Zou denen yer\Ndevasa bir filin sırtında bulunuyor.
Dialogue: 0,0:21:13.50,0:21:16.08,Main,,0,0,0,,Yok artık! Canlı mı bu?!
Dialogue: 0,0:21:16.08,0:21:20.34,Main,,0,0,0,,Sürekli hareket halinde olduğundan\Nasla aynı yerde bulunamayan...
Dialogue: 0,0:21:20.34,0:21:21.92,Main,,0,0,0,,Hayalet Ada.
Dialogue: 0,0:21:21.92,0:21:25.38,Main,,0,0,0,,Gerçek bir ada olmadığından\NSeyir Pusulalar'ı sizi ona götüremez.
Dialogue: 0,0:21:26.08,0:21:28.68,Main,,0,0,0,,Ben de ilk kez geliyorum.
Dialogue: 0,0:21:30.10,0:21:32.34,Main,,0,0,0,,Bize sırtını gösteriyor oluşu...
Dialogue: 0,0:21:32.34,0:21:35.94,Main,,0,0,0,,...Kara Bacaklar'ın buraya çok daha\Nönce geldiğinin bir işareti olabilir ama...
Dialogue: 0,0:21:35.94,0:21:40.04,Main,,0,0,0,,Yani sürekli bizden uzaklaşan\Nbir filin peşindeydik öyle mi?
Dialogue: 0,0:21:40.04,0:21:43.11,Main,,0,0,0,,Evet, karayla temasa hazırlanın.
Dialogue: 0,0:21:43.11,0:21:45.53,Main,,0,0,0,,Yiyecek bir şeyler verebilir misin?
Dialogue: 0,0:21:45.53,0:21:46.99,Main,,0,0,0,,Sana mı?!
Dialogue: 0,0:21:46.99,0:21:49.70,Main,,0,0,0,,Hasır Şapka-ya'ya\Nyiyecek bir şeyler verebilir misin?
Dialogue: 0,0:21:49.70,0:21:52.41,Main,,0,0,0,,Bütün depo sizin!
Dialogue: 0,0:21:52.41,0:21:54.32,Main,,0,0,0,,Zou burası ha?!
Dialogue: 0,0:21:54.32,0:21:58.21,Main,,0,0,0,,Şu dünyada görülecek neler varmış!
Dialogue: 0,0:22:00.50,0:22:03.30,Main,,0,0,0,,Momonosuke iyi midir-{\i1}de gozaru{\i0}* acaba?
Dialogue: 0,0:22:03.30,0:22:06.88,Main,,0,0,0,,Zou'da insanlardan nefret eden\Nbir kabile olduğunu duymuştum.
Dialogue: 0,0:22:06.88,0:22:09.54,Main,,0,0,0,,Evet, Mink Kabilesi.
Dialogue: 0,0:22:09.54,0:22:14.89,Main,,0,0,0,,İnsanları kendinden uzak tutan bu ülkenin geçmişi \Nbin yıl öncesine dayanıyormuş.
Dialogue: 0,0:22:14.89,0:22:18.65,Main,,0,0,0,,Bin yıl mı?!\NBir filin sırtında hem de?!
Dialogue: 0,0:22:21.14,0:22:26.15,Main,,0,0,0,,Yani şimdi bu fil bin yıldır yaşıyor mu?!
Dialogue: 0,0:22:31.08,0:22:32.54,Main,,0,0,0,,Şu şey...
Dialogue: 0,0:22:32.54,0:22:35.75,Main,,0,0,0,,Ne?! Yoksa...
Dialogue: 0,0:22:41.50,0:22:43.42,Main,,0,0,0,,Sunny-go!
Dialogue: 0,0:22:54.46,0:22:55.81,Main,,0,0,0,,Rahat dur biraz!
Dialogue: 0,0:22:56.14,0:22:57.85,Main,,0,0,0,,Demek bu...
Dialogue: 0,0:22:59.73,0:23:02.27,Main,,0,0,0,,Demek bu...
Dialogue: 0,0:23:02.27,0:23:07.11,Main,,0,0,0,,...Hasır Şapka tayfasını taşıyan\Nbüyük gemi!
Dialogue: 0,0:23:07.11,0:23:13.24,Main,,0,0,0,,Thousand Sunny-go-senpai!\NŞükürler olsun! Şükürler olsun!
Dialogue: 0,0:23:13.24,0:23:15.26,Main,,0,0,0,,Şükürler olsun!
Dialogue: 0,0:23:15.26,0:23:16.37,Main,,0,0,0,,Tapmaya başlamayın hemen!
Dialogue: 0,0:23:16.37,0:23:20.08,Main,,0,0,0,,Sevindim! Zou'ya varmışlar...
Dialogue: 0,0:23:20.08,0:23:23.59,Main,,0,0,0,,Big Mom'ın elinden kurtulmayı\Nbaşarmışlar anlaşılan.
Dialogue: 0,0:23:23.59,0:23:25.96,Main,,0,0,0,,Gemide büyük bir hasar da görünmüyor.
Dialogue: 0,0:23:25.96,0:23:28.36,Main,,0,0,0,,Hey! Sanji!
Dialogue: 0,0:23:28.36,0:23:33.08,Main,,0,0,0,,Nami! Chopper! Brook! Momo!
Dialogue: 0,0:23:33.08,0:23:36.39,Main,,0,0,0,,Bir de... Şu gazlı elemanın adı neydi?
Dialogue: 0,0:23:36.39,0:23:38.98,Main,,0,0,0,,Senpailerim, hemen karşıya geçip...
Dialogue: 0,0:23:38.98,0:23:39.85,Main,,0,0,0,,Ne?
Dialogue: 0,0:23:39.85,0:23:41.48,Main,,0,0,0,,Nereye gittiler?!
Dialogue: 0,0:23:41.48,0:23:44.23,Main,,0,0,0,,Ha! Geçmeye başlamışlar bile!
Dialogue: 0,0:23:44.23,0:23:45.98,Main,,0,0,0,,Luffy, kimseden haber var mı?
Dialogue: 0,0:23:46.80,0:23:47.94,Main,,0,0,0,,Burada değiller gibi.
Dialogue: 0,0:23:47.94,0:23:49.65,Main,,0,0,0,,Ne dedin?!
Dialogue: 0,0:23:49.65,0:23:51.91,Main,,0,0,0,,Karaya çıkmış olmalılar.
Dialogue: 0,0:23:51.91,0:23:53.84,Main,,0,0,0,,Pekâlâ, kendinize iyi bakın millet!
Dialogue: 0,0:23:53.84,0:23:56.33,Main,,0,0,0,,Sen de bizimle geliyorsun!
Dialogue: 0,0:23:56.33,0:23:58.50,Main,,0,0,0,,İstediğiniz başka bir şey var mı?
Dialogue: 0,0:23:58.50,0:24:00.46,Main,,0,0,0,,Keşke peşlerinden gidip...
Dialogue: 0,0:24:00.46,0:24:02.52,Main,,0,0,0,,...hayallerimdeki Hasır Şapka yıldızlarını...
Dialogue: 0,0:24:02.52,0:24:05.63,Main,,0,0,0,,...bir süre daha izleyebilsem ama...
Dialogue: 0,0:24:05.63,0:24:09.96,Main,,0,0,0,,...bu kudretli insanların maceralarında\Nonlara ayakbağı olmak da istemiyorum!
Dialogue: 0,0:24:09.96,0:24:14.34,Main,,0,0,0,,Mutluluk barometremiz çoktan\Nsonuna dayandı zaten!
Dialogue: 0,0:24:14.78,0:24:16.98,Main,,0,0,0,,Bir dahaki görüşmemizde...
Dialogue: 0,0:24:16.98,0:24:21.82,Main,,0,0,0,,...hepimiz Hasır Şapkalar'ın\Nadamıyız diyebileceğimiz...
Dialogue: 0,0:24:21.82,0:24:24.35,Main,,0,0,0,,...güçlere sahip olacağız!
Dialogue: 0,0:24:24.56,0:24:28.69,Main,,0,0,0,,Ve o gün geldiğinde işinize yararsak...
Dialogue: 0,0:24:28.73,0:24:32.61,Captions,,0,0,175,,{\fad(500,0)}İlahi Damlalar (İmzalar)
Dialogue: 0,0:24:28.69,0:24:32.61,Main,,0,0,0,,{\an8}...kalan dört senpaimizin de\Nİlahi Damlalar'ını istiyoruz!
Dialogue: 0,0:24:32.61,0:24:38.24,Main,,0,0,0,,Bunları alabilirsek\Ndünyanın en mutlu insanları oluruz!
Dialogue: 0,0:24:38.24,0:24:40.64,Main,,0,0,0,,- Solucan mı bu?\N- Yılan değil mi?
Dialogue: 0,0:24:40.64,0:24:43.37,Main,,0,0,0,,Bacakları var, kertenkele olması lazım.
Dialogue: 0,0:24:43.37,0:24:46.75,Main,,0,0,0,,Tamamem görmezden gelindim!\NZerre takmadılar!
Dialogue: 0,0:24:46.75,0:24:50.30,Main,,0,0,0,,Ama bunun mutluluğu da\Nbaşkaymış be!
Dialogue: 0,0:24:50.30,0:24:51.88,Main,,0,0,0,,Çok mutluyuz!
Dialogue: 0,0:24:54.81,0:24:58.39,Main,,0,0,0,,Tamamdır, bitirdim-{\i1}de gozaru{\i0}!
Dialogue: 0,0:24:59.58,0:25:03.23,Main,,0,0,0,,- Bu da ne ki?\N- Yılan işte.
Dialogue: 0,0:25:03.23,0:25:06.35,Main,,0,0,0,,Yılan mı-{\i1}de gozaru{\i0} acaba?
Dialogue: 0,0:25:11.16,0:25:13.34,Main,,0,0,0,,Ortaya çık, Yükselen Ejder!
Dialogue: 0,0:25:13.34,0:25:14.20,Main,,0,0,0,,Ejder mi?!
Dialogue: 0,0:25:24.22,0:25:26.25,Main,,0,0,0,,Bu da ne?
Dialogue: 0,0:25:38.39,0:25:39.55,Main,,0,0,0,,Vay canına!
Dialogue: 0,0:25:46.20,0:25:51.44,Main,,0,0,0,,Ej...
Dialogue: 0,0:25:51.44,0:25:56.00,Main,,0,0,0,,Ej-Ejder...
Dialogue: 0,0:25:56.00,0:25:59.24,Main,,0,0,0,,Zavallı bir yaratık belirdi!
Dialogue: 0,0:26:00.28,0:26:03.58,Main,,0,0,0,,- Bak şimdi...\N- Göze göz derler.
Dialogue: 0,0:26:04.32,0:26:05.75,Thoughts,,0,0,0,,Şirin...
Dialogue: 0,0:26:12.08,0:26:16.30,Main,,0,0,0,,Pekâlâ millet, ejderhanın sırtına tutunun! \NTırmanacak!
Dialogue: 0,0:26:16.30,0:26:17.76,Main,,0,0,0,,Uçmayacak mı yani?!
Dialogue: 0,0:26:18.70,0:26:20.89,Main,,0,0,0,,Pekâlâ, gidelim!
Dialogue: 0,0:26:29.30,0:26:31.46,Main,,0,0,0,,Güzel! Bastır, Ejder!
Dialogue: 0,0:26:31.46,0:26:33.53,Main,,0,0,0,,Yukarı kaç kilometre var acaba?
Dialogue: 0,0:26:33.53,0:26:35.84,Main,,0,0,0,,Sonu görünmüyor resmen!
Dialogue: 0,0:26:35.84,0:26:37.36,Main,,0,0,0,,Orada bir ülke olduğuna emin misin?!
Dialogue: 0,0:26:37.36,0:26:38.91,Main,,0,0,0,,Endişelenme.
Dialogue: 0,0:26:38.91,0:26:41.03,Main,,0,0,0,,Vivre Kartı yukarıyı gösteriyor.
Dialogue: 0,0:26:41.03,0:26:44.45,Main,,0,0,0,,Ta-Tamam o zaman. Ejder, dayan!
Dialogue: 0,0:26:49.58,0:26:54.71,Main,,0,0,0,,Güle güle, Lome-o ve diğerleri!\NBizi buraya getirdiğiniz için teşekkür ederiz!
Dialogue: 0,0:26:54.71,0:26:58.80,Main,,0,0,0,,Ne?! Adımı mı söyledi?!
Dialogue: 0,0:26:58.80,0:27:02.10,Main,,0,0,0,,İlk defa adımı söyledi!
Dialogue: 0,0:27:03.60,0:27:05.81,Main,,0,0,0,,Adına çok sevindim patron!
Dialogue: 0,0:27:05.81,0:27:10.44,Main,,0,0,0,,Güle güle! Asıl biz teşekkür ederiz!
Dialogue: 0,0:27:10.44,0:27:13.61,Main,,0,0,0,,Kendinize iyi bakın!
Dialogue: 0,0:27:13.61,0:27:17.07,Main,,0,0,0,,Siz de! Görüşürüz!
Dialogue: 0,0:27:18.22,0:27:21.70,Thoughts,,0,0,0,,Luffy-senpai, kendine iyi bak!
Dialogue: 0,0:27:23.58,0:27:30.08,Narrator,,0,0,0,,{\i1}Ve böylece ekip \NHayalet Ada Zou'ya tırmanmaya başlar.{\i0}
Dialogue: 0,0:27:42.34,0:27:47.35,Captions,,0,0,0,,{\pos(636,475.333)}{\fad(500,0)}Devrim Ordusu Ana Karargâhı\NBaltigo - Grand Line
Dialogue: 0,0:27:43.04,0:27:44.43,Main,,0,0,0,,{\an8}Dragon-{\i1}san{\i}!
Dialogue: 0,0:27:44.43,0:27:47.35,Main,,0,0,0,,{\an8}İsyancı orduları tüm dünyada\Ngalibiyetler kazanıyor!
Dialogue: 0,0:27:47.47,0:27:53.61,Captions,,0,0,0,,{\pos(644,482)}{\fad(400,500)}Devrim Ordusu Kurucu Lideri\NMonkey D. Dragon
Dialogue: 0,0:27:47.72,0:27:52.02,Main,,0,0,0,,{\an8}Donquixote Ailesi'nin düşüşü çok etkili oldu.
Dialogue: 0,0:27:53.02,0:27:57.36,Main,,0,0,0,,{\an8}Bunca ülke silah kaçakçılığıyla\Nalakalıymış demek ki.
Dialogue: 0,0:27:57.90,0:27:59.84,Main,,0,0,0,,Savaşın gidişatı değişiyor.
Dialogue: 0,0:27:59.84,0:28:03.32,Main,,0,0,0,,Ama bu zaferler üzerine\Nfazla heyecanlanmamalarını söyle.
Dialogue: 0,0:28:03.32,0:28:05.96,Main,,0,0,0,,Dünya Hükümeti sessiz kalmayacaktır.
Dialogue: 0,0:28:05.96,0:28:08.72,Main,,0,0,0,,Cipher Pol'a geçtiğimiz yıllarda\Ntakviyeler yapıldı.
Dialogue: 0,0:28:08.72,0:28:10.84,Main,,0,0,0,,O yüzden çok dikkatli olsunlar.
Dialogue: 0,0:28:10.84,0:28:11.46,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:28:14.26,0:28:15.75,Main,,0,0,0,,Dragon-{\i1}san{\i}.
Dialogue: 0,0:28:17.18,0:28:19.71,Main,,0,0,0,,Dressrosa'dan getirdiğimiz silahlarda...
Dialogue: 0,0:28:19.71,0:28:22.13,Main,,0,0,0,,...özel bir cevher bulmuşlar.
Dialogue: 0,0:28:22.13,0:28:23.89,Main,,0,0,0,,Cevher mi?
Dialogue: 0,0:28:24.55,0:28:26.60,Main,,0,0,0,,Kitetsukou isimli cevheri biliyor musunuz?
Dialogue: 0,0:28:24.55,0:28:26.60,Note,,0,0,0,,Kitetsukou: Sarhoş Demir Cevheri
Dialogue: 0,0:28:26.60,0:28:30.42,Main,,0,0,0,,Çok nadir olduğu ve yalnızca\Nbirkaç ülkede çıkarılabildiği için...
Dialogue: 0,0:28:30.42,0:28:34.15,Main,,0,0,0,,...büyük ihtimalle silahların\Nnerede yapıldığını bulabilirlermiş.
Dialogue: 0,0:28:34.15,0:28:36.52,Main,,0,0,0,,İşte bu güzel haber.
Dialogue: 0,0:28:36.52,0:28:37.44,Main,,0,0,0,,Evet.
Dialogue: 0,0:28:38.68,0:28:41.61,Main,,0,0,0,,Dressrosa'da ortadan kaybolan\Ndostlarımızı da geri getirdin.
Dialogue: 0,0:28:41.61,0:28:43.40,Main,,0,0,0,,Harika bir iş çıkartıyorsun.
Dialogue: 0,0:28:44.18,0:28:47.16,Main,,0,0,0,,Ne demek! \NHem Sabo-{\i1}kun{\i0}'la Luffy-{\i1}kun{\i0} da oradaydı!
Dialogue: 0,0:28:47.16,0:28:49.62,Main,,0,0,0,,Robin nasıldı?
Dialogue: 0,0:28:49.62,0:28:53.41,Main,,0,0,0,,Sabaody'de yakalandığını\Nduymuştum ama yalanmış demek?
Dialogue: 0,0:28:53.41,0:28:56.29,Main,,0,0,0,,Elbette! Robin-san yaşam doluydu!
Dialogue: 0,0:28:56.29,0:28:57.58,Main,,0,0,0,,Sanki...
Dialogue: 0,0:28:57.58,0:28:59.80,Main,,0,0,0,,Luffy-kun'u sormayacak mısınız?
Dialogue: 0,0:28:59.80,0:29:03.28,Main,,0,0,0,,Biraz daha duyarsam patlayacağım.
Dialogue: 0,0:29:03.28,0:29:06.72,Main,,0,0,0,,Sabo-kun'dan bol bol dinlediniz demek...
Dialogue: 0,0:29:07.56,0:29:09.72,Main,,0,0,0,,O değil de Koala...
Dialogue: 0,0:29:09.72,0:29:10.64,Main,,0,0,0,,Emredin!
Dialogue: 0,0:29:10.64,0:29:13.31,Main,,0,0,0,,Onların yardımına ihtiyacımız olacak.
Dialogue: 0,0:29:13.98,0:29:15.27,Main,,0,0,0,,Onlar derken?
Dialogue: 0,0:29:16.88,0:29:21.23,Main,,0,0,0,,Dünyadaki tüm Devrim Ordusu\Nliderlerini buraya çağır!
Dialogue: 0,0:29:21.23,0:29:22.36,Main,,0,0,0,,Emredersiniz.
Dialogue: 0,0:29:22.36,0:29:27.03,Main,,0,0,0,,Ne?! Yine tüm o önemli insanları\Nbir araya mı toplayacaksınız?!
Dialogue: 0,0:29:27.16,0:29:32.04,Captions,,0,0,0,,{\fad(500,500)}Denizde bir yerde - Yeni Dünya
Dialogue: 0,0:29:42.84,0:29:44.47,Main,,0,0,0,,Lafitte konuşuyor.
Dialogue: 0,0:29:44.47,0:29:47.68,Main,,0,0,0,,{\i1}Ben... urgess.{\i0}
Dialogue: 0,0:29:50.00,0:29:51.51,Main,,0,0,0,,{\i1}Benim!{\i0}
Dialogue: 0,0:29:51.51,0:29:53.18,Main,,0,0,0,,{\an8}Burgess... Sensin demek!
Dialogue: 0,0:29:52.85,0:29:58.86,Captions,,0,0,0,,{\pos(644,479.333)}{\fad(500,0)}Yonko Karasakal Korsanları Beşinci Gemi Kaptanı\N"Şeytani Şerif" Lafitte
Dialogue: 0,0:29:53.18,0:29:56.14,Main,,0,0,0,,{\an8}Dressrosa'ya seni almaya geldik\Nama hiçbir yerde yoktun.
Dialogue: 0,0:29:56.14,0:29:58.06,Main,,0,0,0,,{\an8\i1}Evet, kusura bakmayın.{\i0}
Dialogue: 0,0:29:58.86,0:30:02.98,Main,,0,0,0,,{\i1}Daha yeni yeni kendime gelebiliyorum, \Niletişim kuramadım.{\i0}
Dialogue: 0,0:30:02.98,0:30:08.78,Captions,,0,0,0,,{\pos(642.667,482)}{\fad(400,0)}Yonko Karasakal Korsanları İkinci Gemi Kaptanı\N"Yağmur" Shiryu
Dialogue: 0,0:30:04.84,0:30:07.91,Main,,0,0,0,,{\an8}Adi herif yaşıyormuş demek?
Dialogue: 0,0:30:08.78,0:30:11.24,Main,,0,0,0,,Nerelerdeydin?
Dialogue: 0,0:30:11.24,0:30:12.74,Main,,0,0,0,,Şu anda neredesin?
Dialogue: 0,0:30:12.74,0:30:16.50,Main,,0,0,0,,{\i1}Her taraf bembeyaz...{\i0}
Dialogue: 0,0:30:16.50,0:30:18.75,Main,,0,0,0,,{\i1}Bembeyaz bir ada.{\i0}
Dialogue: 0,0:30:19.21,0:30:23.76,Main,,0,0,0,,Falanca bir geminin altında saklanıyordum.
Dialogue: 0,0:30:25.59,0:30:28.22,Main,,0,0,0,,Kaptan Teach'e söyle...
Dialogue: 0,0:30:28.22,0:30:32.14,Main,,0,0,0,,Burayı şimdi istila edersek\Ndevasa miktarlarda silah elde edebiliriz!
Dialogue: 0,0:30:32.14,0:30:33.89,Main,,0,0,0,,{\i1}Komodor Teach diyeceksin.{\i0}
Dialogue: 0,0:30:33.89,0:30:35.34,Main,,0,0,0,,{\i1}Daha kaç kere\Nsöyleyeceğim sana bunu?!{\i0}
Dialogue: 0,0:30:35.34,0:30:40.38,Main,,0,0,0,,Doc Q'yu da getirin!\NCiddi şekilde yaralıyım!
Dialogue: 0,0:30:40.38,0:30:43.69,Main,,0,0,0,,{\i1}Burgess, söylesene neredesin?!{\i0}
Dialogue: 0,0:30:43.69,0:30:46.44,Main,,0,0,0,,Adanın adını bilmiyorum.
Dialogue: 0,0:30:46.44,0:30:49.16,Main,,0,0,0,,Haritalarda olmayan bir yer.
Dialogue: 0,0:30:49.16,0:30:52.49,Main,,0,0,0,,{\i1}Vivre Kartı'mı takip edin!{\i0}
Dialogue: 0,0:30:53.16,0:30:59.12,Main,,0,0,0,,Dragon ve o iğrenç Sabo da burada!
Dialogue: 0,0:31:01.20,0:31:03.32,Main,,0,0,0,,Buldum!
Dialogue: 0,0:31:03.32,0:31:07.09,Main,,0,0,0,,Devrim Ordusu'nun ana karargâhını buldum!
Dialogue: 0,0:31:24.23,0:31:28.19,Captions,,0,0,173,,{\fad(500,0)}Bir Yerlerdeki Ada
Dialogue: 0,0:31:24.23,0:31:28.78,Main,,0,0,0,,{\an8}Kimseye bir türlü laf anlatamadım arkadaş!
Dialogue: 0,0:31:28.78,0:31:33.57,Main,,0,0,0,,Hepsi de anlaşmış gibi bir ağızdan...
Dialogue: 0,0:31:34.58,0:31:40.29,Main,,0,0,0,,...Beyazsakal'ın yegane oğulları\NBeyazsakal Korsanları'dır diyor!
Dialogue: 0,0:31:41.25,0:31:48.76,Captions,,0,0,0,,{\pos(641.333,427.333)}{\fad(400,0)}Edward Weevil – Shichibukai\NKendi deyimiyle "Küçük Beyazsakal"\N(Eski Kelle Ödülü 480 Milyon Beli)
Dialogue: 0,0:31:41.25,0:31:43.75,Main,,0,0,0,,{\an8}Anne, anne!
Dialogue: 0,0:31:43.75,0:31:46.62,Main,,0,0,0,,{\an8}Beyazsakal'ın oğlu benim değil mi?
Dialogue: 0,0:31:46.62,0:31:48.76,Main,,0,0,0,,{\an8}Sakalım beyaz çünkü!
Dialogue: 0,0:31:48.76,0:31:50.40,Main,,0,0,0,,Aynen öyle canım benim!
Dialogue: 0,0:31:50.40,0:31:54.22,Main,,0,0,0,,Beyazsakal Korsanları yalandan bir aileydi.
Dialogue: 0,0:31:54.22,0:32:00.42,Main,,0,0,0,,Dünyanın en güçlü korsanı\NBeyazsakal'ın gerçek oğlu sensin!
Dialogue: 0,0:32:00.42,0:32:01.89,Main,,0,0,0,,Evet! Evet!
Dialogue: 0,0:32:01.89,0:32:04.77,Main,,0,0,0,,Ve ben de...
Dialogue: 0,0:32:04.98,0:32:09.24,Captions,,0,0,0,,{\pos(642.667,482)}{\fad(250,0)}Bayan Buckin – Weevil'in Annesi\NKendi deyimiyle "Beyazsakal'ın Sevgilisi"
Dialogue: 0,0:32:05.48,0:32:08.36,Main,,0,0,0,,{\an8}...Beyazsakal'ın sevdiği kadınım!
Dialogue: 0,0:32:13.46,0:32:16.62,Main,,0,0,0,,Kafanı dik tut\Naltın yumurtlayan tavuğum benim!
Dialogue: 0,0:32:16.62,0:32:18.74,Main,,0,0,0,,Acıttın ama anne!
Dialogue: 0,0:32:18.74,0:32:21.96,Main,,0,0,0,,- Şuna bak!\N- Ne? Ayna mı bu?
Dialogue: 0,0:32:21.96,0:32:24.88,Main,,0,0,0,,Hayır be yavrum, Beyazsakal'ın resmi bu!
Dialogue: 0,0:32:24.88,0:32:27.80,Main,,0,0,0,,Ben de ayna sandım!
Dialogue: 0,0:32:27.80,0:32:30.88,Main,,0,0,0,,Bu kadar benziyorken\Nonun oğlu olmamana imkan yok!
Dialogue: 0,0:32:30.88,0:32:32.76,Main,,0,0,0,,Aptal mısın nesin?!
Dialogue: 0,0:32:32.76,0:32:36.05,Main,,0,0,0,,Özür dilerim anne!
Dialogue: 0,0:32:37.60,0:32:40.56,Main,,0,0,0,,Seni affediyorum.
Dialogue: 0,0:32:41.10,0:32:44.27,Main,,0,0,0,,Çünkü seni seviyorum!
Dialogue: 0,0:32:44.27,0:32:46.31,Main,,0,0,0,,Anne!
Dialogue: 0,0:32:46.31,0:32:50.44,Main,,0,0,0,,Gidelim!\NNe yapacaktın söyle...
Dialogue: 0,0:32:50.44,0:32:53.50,Main,,0,0,0,,Şey...
Dialogue: 0,0:32:53.50,0:32:54.57,Main,,0,0,0,,Unuttum.
Dialogue: 0,0:32:54.57,0:33:00.34,Main,,0,0,0,,Feniks Marco gibi Beyazsakal Korsanları'ndan\Nkalan kişileri bulacaksın!
Dialogue: 0,0:33:00.34,0:33:03.04,Main,,0,0,0,,Ve onlardan bir şeyler alacaksın!
Dialogue: 0,0:33:03.04,0:33:07.10,Main,,0,0,0,,Baban Newgate ardında\Ndehşet bir hazine bırakmış olmalı...
Dialogue: 0,0:33:07.10,0:33:11.26,Main,,0,0,0,,...ve onun gerçek oğlu olarak\Nbu hazine senin hakkın!
Dialogue: 0,0:33:11.26,0:33:13.93,Main,,0,0,0,,Anladım...
Dialogue: 0,0:33:23.56,0:33:27.56,Main,,0,0,0,,Sahi ya! Ama aslında\Nen çok istediğim şey intikam!
Dialogue: 0,0:33:27.56,0:33:30.90,Main,,0,0,0,,Babamı öldüren Karasakal'dan\Nintikamımı almak istiyorum!
Dialogue: 0,0:33:30.90,0:33:33.82,Main,,0,0,0,,Onu öldüreceğim!
Dialogue: 0,0:33:33.82,0:33:37.11,Main,,0,0,0,,Asla affetmeyeceğim!
Dialogue: 0,0:33:37.11,0:33:40.00,Main,,0,0,0,,Aptal oğlan!\Nİntikamın kime ne faydası var?!
Dialogue: 0,0:33:40.00,0:33:42.75,Main,,0,0,0,,İntikam sana bir beli bile kazandırmaz!
Dialogue: 0,0:33:42.75,0:33:46.33,Main,,0,0,0,,Para lazım bize para!\NServetini senin alman lazım!
Dialogue: 0,0:33:48.80,0:33:50.80,Main,,0,0,0,,Haklısın anne!
Dialogue: 0,0:33:55.26,0:33:57.43,Main,,0,0,0,,Ne oldu anne?
Dialogue: 0,0:33:57.43,0:34:00.01,Main,,0,0,0,,Doflamingo alt edilmiş.
Dialogue: 0,0:34:03.22,0:34:06.69,Main,,0,0,0,,Gene o, Garp'ın torunu yapmış!
Dialogue: 0,0:34:06.69,0:34:10.73,Main,,0,0,0,,En Büyükler Savaşı'nda da\NMarco'lar onu korumaya çalışmışlar.
Dialogue: 0,0:34:10.73,0:34:13.38,Main,,0,0,0,,Marco'larla ilgili\Nbir şeyler biliyor olabilir o zaman.
Dialogue: 0,0:34:13.38,0:34:15.15,Main,,0,0,0,,Gidip dövelim mi?
Dialogue: 0,0:34:25.00,0:34:30.04,Captions,,0,0,0,,{\pos(641.333,479.333)}{\fad(400,0)}"Buggy Kasabası"\NKarai Bari Adası, Yeni Dünya
Dialogue: 0,0:34:34.50,0:34:36.97,Main,,0,0,0,,- Patron Buggy!\N- Ne oldu?
Dialogue: 0,0:34:36.97,0:34:40.22,Main,,0,0,0,,Siparişlerin ardı arkası kesilmiyor!
Dialogue: 0,0:34:41.50,0:34:43.18,Main,,0,0,0,,Güzel güzel...
Dialogue: 0,0:34:43.18,0:34:46.52,Main,,0,0,0,,Artık Doflamingo'dan silah alamadıklarından...
Dialogue: 0,0:34:46.52,0:34:49.52,Main,,0,0,0,,...yüzlerini bize çevirdiler,\Ntelefonların ardı arkası gelmiyor!
Dialogue: 0,0:34:49.52,0:34:52.36,Main,,0,0,0,,Askeri marketi resmen biz yönetiyoruz!
Dialogue: 0,0:34:55.58,0:34:57.57,Main,,0,0,0,,Duydunuz mu?!
Dialogue: 0,0:35:01.12,0:35:02.53,Main,,0,0,0,,Millet!
Dialogue: 0,0:35:02.92,0:35:04.66,Main,,0,0,0,,Yemeğini bitiren...
Dialogue: 0,0:35:04.66,0:35:08.21,Main,,0,0,0,,...cephelere koşsun, \Nortalığı birbirine katın ve ganimet getirin!
Dialogue: 0,0:35:11.08,0:35:15.50,Captions,,0,0,0,,{\pos(654.667,482)}{\fad(250,400)}"Dahi Soytarı" Buggy – Shichibukai/Korsan\NBuggy Eve Servis'in Patronu
Dialogue: 0,0:35:11.04,0:35:14.80,Main,,0,0,0,,{\an8}Yaptığınız korsanlıklar bendeniz Shichibukai...
Dialogue: 0,0:35:14.80,0:35:19.05,Main,,0,0,0,,{\an8}...Dahi Soytarı Buggy-sama'nın\Nhimayesinde garanti altındadır!
Dialogue: 0,0:35:22.01,0:35:27.73,Captions,,0,0,0,,{\pos(640,502)}{\fad(600,600)}Buggy Eve Servis\NParalı Korsan Ajansı
Dialogue: 0,0:35:22.01,0:35:27.77,Main,,0,0,0,,{\an8}Buggy! Buggy! Buggy! Buggy! Buggy!
Dialogue: 0,0:35:29.31,0:35:31.40,Main,,0,0,0,,Doğru ya, Patron Buggy!
Dialogue: 0,0:35:31.96,0:35:36.28,Main,,0,0,0,,Söylemeyi unutmuştum ama\N"S" Seviye paralı asker Hajrudin aramıştı...
Dialogue: 0,0:35:36.28,0:35:37.99,Main,,0,0,0,,...işi bırakmak istiyormuş.
Dialogue: 0,0:35:37.99,0:35:38.94,Main,,0,0,0,,Ne dedin?!
Dialogue: 0,0:35:38.94,0:35:43.48,Main,,0,0,0,,Bir tanesinden bir şey olmaz,\Ndört tane daha var sonuçta.
Dialogue: 0,0:35:43.48,0:35:44.74,Main,,0,0,0,,Beşi birden bırakmak istiyormuş.
Dialogue: 0,0:35:44.74,0:35:47.72,Main,,0,0,0,,Ne?! En çok iş yapan adamlarımız onlar!
Dialogue: 0,0:35:47.72,0:35:51.00,Main,,0,0,0,,Ve böyle meşgul bir anda...\NNeden ayrılmak istiyorlar?!
Dialogue: 0,0:35:51.00,0:35:52.88,Main,,0,0,0,,Duymak istemezsin...
Dialogue: 0,0:35:52.88,0:35:54.90,Main,,0,0,0,,Söyle dedim!
Dialogue: 0,0:35:54.90,0:35:57.59,Main,,0,0,0,,Söyle!!!
Dialogue: 0,0:36:15.56,0:36:17.44,Main,,0,0,0,,Sonu hâlâ görünmüyor.
Dialogue: 0,0:36:17.44,0:36:19.92,Main,,0,0,0,,Sanji'ler nasıl tırmandılar acaba?
Dialogue: 0,0:36:19.92,0:36:21.99,Main,,0,0,0,,Tırmandılar mı acaba?
Dialogue: 0,0:36:49.18,0:36:52.06,Narrator,,0,0,0,,Luffy'lerin sırtına bindikleri "şey" şu anda...
Dialogue: 0,0:36:52.06,0:36:56.31,Narrator,,0,0,0,,...devasa filin sol arka\Nbacağına tırmanmakta.
Dialogue: 0,0:37:04.41,0:37:06.45,Main,,0,0,0,,Çok yüksek...\NKorkudan öleceğim!
Dialogue: 0,0:37:06.45,0:37:09.16,Main,,0,0,0,,Kollarım da yoruldu! Düştüm düşeceğim!
Dialogue: 0,0:37:09.16,0:37:12.41,Main,,0,0,0,,Öyle deme Usopp,\No da elinden geleni yapıyor.
Dialogue: 0,0:37:16.08,0:37:17.46,Thoughts,,0,0,0,,Çok şirin...
Dialogue: 0,0:37:17.46,0:37:19.04,Main,,0,0,0,,Kin'emon, Kanjuro...
Dialogue: 0,0:37:19.04,0:37:21.84,Main,,0,0,0,,Sahi ya,\Nsiz niye Zou'ya gitmek istiyordunuz?
Dialogue: 0,0:37:21.84,0:37:24.30,Main,,0,0,0,,Güzel soru-{\i1}de gozaru{\i0}.
Dialogue: 0,0:37:24.30,0:37:28.43,Main,,0,0,0,,Size hayatımızı borçluyuz, yani\Ner ya da geç her şeyi anlatmamız lazım.
Dialogue: 0,0:37:28.43,0:37:31.22,Main,,0,0,0,,Ama önce ayağımız bir yere bassın.
Dialogue: 0,0:37:31.22,0:37:35.60,Main,,0,0,0,,Evet... Wano Krallığı'ndan ayrıldığımızdan\Nberi Zou yegâne hedefimizdi.
Dialogue: 0,0:37:35.60,0:37:37.86,Main,,0,0,0,,Momonosuke'nin sağ salim\Nolduğunu görmek istiyoruz.
Dialogue: 0,0:37:37.86,0:37:41.23,Main,,0,0,0,,Bir de denizde ayrı düştüğümüz\Ndiğer dostumuz...
Dialogue: 0,0:37:41.23,0:37:46.82,Main,,0,0,0,,...ninja Raizo'nun sağ salim buraya\Ngelip gelmediğini öğrenmek istiyoruz.
Dialogue: 0,0:37:46.82,0:37:49.66,Main,,0,0,0,,- Ninja mı?!\N- Ninja mı dedin?!
Dialogue: 0,0:37:49.66,0:37:50.70,Main,,0,0,0,,Ne oldu?
Dialogue: 0,0:37:50.70,0:37:53.45,Main,,0,0,0,,Ninja... Tanışmak istiyorum!
Dialogue: 0,0:37:53.45,0:37:55.75,Main,,0,0,0,,Etetetetete...
Dialogue: 0,0:37:55.75,0:37:58.54,Main,,0,0,0,,Luffy, yukarı bak! Bir şey düşüyor!
Dialogue: 0,0:37:59.46,0:38:01.60,Main,,0,0,0,,Etetetetete...
Dialogue: 0,0:38:01.60,0:38:03.96,Main,,0,0,0,,Bu da ne be?!
Dialogue: 0,0:38:03.95,0:38:09.70,OP11 Credits,,0,0,0,,Editing:\N Feeso,\NGalaxy 9000,\NSimon\N\NTiming:\NHalee\N\NQuality Assurance:\NGrug,\NMr. Luffy,\NPepperjack\N\NSoundtracking:\N Halee\N\NGraphics:\N Datenshi\N\NTranslation:\NCrunchyroll\NYibis (Opening)
