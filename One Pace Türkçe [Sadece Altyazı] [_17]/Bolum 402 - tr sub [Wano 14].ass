,100,100,0,0,1,0,0,2,15,15,15,1Style: Translation-furigana,Duality,52.5,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,2.25,0,2,15,15,15,1Style: Karaoke-furigana,Duality,52.5,&H009E375F,&H009E375F,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2.25,0,8,15,15,15,1Style: Karaoke,Duality,82,&H009E375F,&H009E375F,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,4.5,0,8,15,15,15,1Style: Translation,Duality,82,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,4.5,0,2,15,15,15,1Style: Sign-OP,Captain Redemption,375,&H0015181B,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0,0,2,15,15,15,1Style: Sign-Wano,KG Ten Thousand Reasons Alt,60,&H005B57D2,&H000000FF,&H00000000,&H00000000,-1,0,0,0,100,100,0,0,1,0,0,2,15,15,15,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Your media player does not support the subtitle format used in this episode. Subtitles will likely not function properly. Please use one of the recommended video players, preferably mpv: https://mpv.ioDialogue: 0,0:01:41.87,0:01:51.86,Warning,,0,0,0,,Your media player does not support the subtitle format used in this episode. Subtitles will likely not function properly. Please use one of the recommended video players, preferably mpv: https://mpv.ioDialogue: 55,0:00:04.89,0:00:06.81,Main-207+,,0,0,0,,Beş-Bir. Çift zar kazandı.Dialogue: 55,0:00:13.53,0:00:14.78,Main-207+,,0,0,0,,Vay be!Dialogue: 55,0:00:15.43,0:00:19.27,Main-207+,,0,0,0,,Hep zarın nasıl yuvarlandığına bağlı derler...Dialogue: 55,0:00:20.66,0:00:24.87,Main-207+,,0,0,0,,ama şans sizden yana, bayım! Galibiyet serisi yakaladınız!Dialogue: 55,0:00:24.87,0:00:25.96,Main-207+,,0,0,0,,İşte.Dialogue: 55,0:00:29.39,0:00:32.47,Main-207+,,0,0,0,,Teknedeki suşiler için geri ödeme.Dialogue: 55,0:00:32.47,0:00:35.84,Main-207+,,0,0,0,,Vay be! Bu ödediğimde de fazla, bayım!Dialogue: 55,0:00:36.45,0:00:38.76,Main-207+,,0,0,0,,Endişelenme. Fazlasını kazanacağım.Dialogue: 55,0:00:40.64,0:00:42.06,Main-207+,,0,0,0,,Vaaaay!Dialogue: 55,0:00:42.06,0:00:44.98,Main-207+,,0,0,0,,Tek amacımız yağmurdan kaçınacağımız bi' dam bulmaktı!Dialogue: 55,0:00:45.91,0:00:49.40,Main-207+,,0,0,0,,Eğer sana yapışıp kalırsam bir daha asla aç kalmam!Dialogue: 55,0:00:50.05,0:00:53.03,Main-207+,,0,0,0,,Ciddiyim! Sen Wano'daki en uyanık adamsın!Dialogue: 55,0:00:56.89,0:00:59.66,Main-207+,,0,0,0,,Bu gece birinci sınıf sake içeceğim.Dialogue: 55,0:01:00.99,0:01:03.20,Main-207+,,0,0,0,,Şimdi, bahislerinizi açın!Dialogue: 55,0:01:06.15,0:01:07.04,Main-207+,,0,0,0,,Tek.Dialogue: 55,0:01:07.04,0:01:11.96,Main-207+,,0,0,0,,Vaaay! Ne ilginç bir bahis, genç bayım!Dialogue: 55,0:01:13.34,0:01:15.60,Main-207+,,0,0,0,,Teke bir bahsimiz var!Dialogue: 55,0:01:26.10,0:01:27.44,Main-207+,,0,0,0,,Hazır.Dialogue: 55,0:01:32.94,0:01:34.78,Main-207+,,0,0,0,,İşte geliyor!Dialogue: 55,0:01:40.53,0:01:42.04,Main-207+,,0,0,0,,Oh!Dialogue: 55,0:01:47.49,0:01:49.00,Main-207+,,0,0,0,,Kılıçsız Stil...Dialogue: 55,0:01:49.67,0:01:52.13,Main-207+,,0,0,0,,Ejder Kasırgası!Dialogue: 55,0:02:07.94,0:02:11.06,Main-207+,,0,0,0,,Ne?! Hileciler!Dialogue: 55,0:02:11.86,0:02:14.23,Main-207+,,0,0,0,,Aşağışık ezikler.Dialogue: 55,0:02:17.89,0:02:19.91,Main-207+,,0,0,0,,Hepiniz derhal buraya gelin!Dialogue: 55,0:02:24.09,0:02:27.91,Main-207+,,0,0,0,,Görünüşe göre nasıl eğlence sunacağını iyi biliyorsun.Dialogue: 55,0:02:29.79,0:02:31.63,Main-207+,,0,0,0,,Hemen haklayın onu millet!Dialogue: 55,0:02:42.79,0:02:44.26,Main-207+,,0,0,0,,Tek Kılıç Stili...Dialogue: 55,0:02:48.80,0:02:51.06,Main-207+,,0,0,0,,Ejder Sarsıntısı!Dialogue: 55,0:03:14.88,0:03:17.09,Main-207+,,0,0,0,,Vay, bekleyin bir dakika, bayım!Dialogue: 55,0:03:17.39,0:03:22.99,Main-207+,,0,0,0,,Hayat dediğin tekle çift arasındaki ince çizgidir; aynen iyilikle kötülük gibi.Dialogue: 55,0:03:22.99,0:03:26.08,Main-207+,,0,0,0,,Haydi, buna bir son verelim.Dialogue: 55,0:03:26.08,0:03:26.97,Main-207+,,0,0,0,,Olur mu?!Dialogue: 55,0:03:29.00,0:03:34.65,Main-207+,,0,0,0,,Evet, sayın yönetici, son oyuna karşı bir itiraz oldu.Dialogue: 55,0:03:36.82,0:03:40.70,Main-207+,,0,0,0,,Kahretsin! Şunu alın ve gidin! Bir daha da geri dönmeyin sakın!Dialogue: 55,0:05:26.59,0:05:31.21,Main-207+,,0,0,0,,Öf, orada amma korktum! Siz de korktunuz mu, bayım?!Dialogue: 55,0:05:31.21,0:05:33.27,Main-207+,,0,0,0,,Çeneni kapatabilir misin?Dialogue: 55,0:05:33.27,0:05:36.48,Main-207+,,0,0,0,,Amanın! Çok düşüncelisiniz!Dialogue: 55,0:05:36.48,0:05:40.57,Main-207+,,0,0,0,,Sesim hakkında endişelendiniz. Ne kadar da düşüncelisiniz. Sağ olun!Dialogue: 55,0:05:40.57,0:05:44.69,Main-207+,,0,0,0,,Ah, kusura bakmayın, kendimi tanıtmayı unuttum. Benim adım Tonoyasu.Dialogue: 55,0:05:44.69,0:05:47.83,Main-207+,,0,0,0,,Herkes bana "Dalkavuk" Yasu der.Dialogue: 55,0:05:47.83,0:05:49.45,Main-207+,,0,0,0,,Tanıştığımıza memnun oldum!Dialogue: 55,0:05:50.50,0:05:54.37,Main-207+,,0,0,0,,Vay vay, konuşmadığın zaman bile büyüleyicisin!Dialogue: 55,0:05:54.37,0:05:58.25,Main-207+,,0,0,0,,Sizi gidi sizi! Hanımlar üzerinizden hiç inmiyor olmalı bayım!Dialogue: 55,0:05:59.35,0:06:01.43,Main-207+,,0,0,0,,Beni neden takip ediyorsun?Dialogue: 55,0:06:01.43,0:06:05.17,Main-207+,,0,0,0,,O kumarhanede kafama bir düşünce dank etti:Dialogue: 55,0:06:05.17,0:06:08.89,Main-207+,,0,0,0,,"Bu adamın peşinden gidersem her şey yolunda gider."Dialogue: 55,0:06:08.89,0:06:12.79,Main-207+,,0,0,0,,Normal biri onlara kesinlikle bulaşamazdı.Dialogue: 55,0:06:12.79,0:06:18.44,Main-207+,,0,0,0,,Onlar başkentin korkutucu Kyoshiro Ailesi'nin astlarıydı.Dialogue: 55,0:06:18.44,0:06:21.44,Main-207+,,0,0,0,,Ah, yaptığın şey çok şaşırtıcıydı!Dialogue: 55,0:06:21.44,0:06:24.78,Main-207+,,0,0,0,,Kadın olsaydım, dizlerim tir tir titriyor olurdu!Dialogue: 55,0:06:26.70,0:06:28.45,Main-207+,,0,0,0,,Sorun nedir, bayım?!Dialogue: 55,0:06:29.00,0:06:31.18,Main-207+,,0,0,0,,Şurası tanıdık geliyor.Dialogue: 55,0:06:31.18,0:06:36.20,Main-207+,,0,0,0,,O gördüğünüz yer, Çiçek Başkenti!Dialogue: 55,0:06:36.20,0:06:39.29,Main-207+,,0,0,0,,Hemen önünde de başkentin dışlanmış Ebisu Kasabası var!Dialogue: 55,0:06:39.29,0:06:41.29,Main-207+,,0,0,0,,Orası benim memleketim!Dialogue: 55,0:06:41.29,0:06:44.50,Main-207+,,0,0,0,,Ebisu mu...? Hani şu şans tanrısı olan mı?Dialogue: 55,0:06:44.98,0:06:49.43,Main-207+,,0,0,0,,Evet, adını ondan alıyor. Oraya varınca göreceksin!Dialogue: 55,0:06:55.43,0:06:57.29,Main-207+,,0,0,0,,Ben de bir tane alacağım!Dialogue: 55,0:06:57.29,0:06:58.23,Main-207+,,0,0,0,,Hemen geliyor!Dialogue: 55,0:06:59.20,0:07:01.49,Main-207+,,0,0,0,,Hiç tanıdık gelmiyor...Dialogue: 55,0:07:01.49,0:07:04.11,Main-207+,,0,0,0,,Ama kesinlikle işi iyi parladı diyebiliriz.Dialogue: 55,0:07:04.60,0:07:06.78,Main-207+,,0,0,0,,Aşağılık herif...Dialogue: 55,0:07:07.56,0:07:10.65,Main-207+,,0,0,0,,Buranın kimin bölgesi olduğunu bilmiyor mu yoksa?Dialogue: 55,0:07:11.80,0:07:14.81,Main-207+,,0,0,0,,İyisi mi ona bi' öğretelim.Dialogue: 55,0:07:21.42,0:07:23.92,Main-207+,,0,0,0,,Vurun demire!Dialogue: 55,0:07:29.84,0:07:32.93,Main-207+,,0,0,0,,Çekin taşları!Dialogue: 55,0:07:42.58,0:07:44.77,Main-207+,,0,0,0,,Çalışamayacaksanız...Dialogue: 55,0:07:44.77,0:07:47.52,Main-207+,,0,0,0,,geberin gidin de...Dialogue: 55,0:07:47.53,0:07:50.03,Main-207+,,0,0,0,,ayak bağı olmayın!Dialogue: 55,0:08:11.44,0:08:13.80,Main-207+,,0,0,0,,B-Bu kadar mı?Dialogue: 55,0:08:13.80,0:08:18.14,Main-207+,,0,0,0,,Çektiğin her beş blok taş için bir kibi dango kazanırsın.Dialogue: 55,0:08:18.70,0:08:23.90,Main-207+,,0,0,0,,Kendi yemeğini kazanamayacak kadar bir ayağın çukurda mı, İhtiyar Hyo?!Dialogue: 55,0:08:24.44,0:08:27.75,Main-207+,,0,0,0,,Sanırım artık sonun geldi.Dialogue: 55,0:08:30.49,0:08:33.53,Main-207+,,0,0,0,,Tüm gün çalıştım...Dialogue: 55,0:08:33.53,0:08:36.70,Main-207+,,0,0,0,,He?! Ne dedin sen?!Dialogue: 55,0:08:40.50,0:08:42.70,Main-207+,,0,0,0,,Bir muhafıza karşı cevap vermenin cezası...Dialogue: 55,0:08:43.21,0:08:45.17,Main-207+,,0,0,0,,ampütasyondur!Dialogue: 55,0:08:45.77,0:08:47.12,Main-207+,,0,0,0,,Sıradaki!Dialogue: 55,0:08:48.19,0:08:52.34,Main-207+,,0,0,0,,İhtiyar Hyo! Direnmeyin. Enerjinizi saklayın!Dialogue: 55,0:08:52.34,0:08:53.90,Main-207+,,0,0,0,,Yoksa öleceksiniz!Dialogue: 55,0:08:55.47,0:08:58.14,Main-207+,,0,0,0,,Oh, dört bilet!Dialogue: 55,0:08:58.14,0:09:00.20,Main-207+,,0,0,0,,Tebrikler!Dialogue: 55,0:09:08.52,0:09:11.11,Main-207+,,0,0,0,,Çekil! Çekil! Çekil! Çekil! Çekil!Dialogue: 55,0:09:11.11,0:09:13.32,Main-207+,,0,0,0,,Çekilin!Dialogue: 55,0:09:18.10,0:09:21.24,Main-207+,,0,0,0,,Çekilin lan! Ezilmek mi istiyorsunuz?!Dialogue: 55,0:09:21.24,0:09:23.87,Main-207+,,0,0,0,,Dikkat et, Dikenli!Dialogue: 55,0:09:24.62,0:09:26.62,Main-207+,,0,0,0,,Bana bak, seni de ezerim!Dialogue: 55,0:09:52.80,0:09:56.61,Main-207+,,0,0,0,,Bekleyin, bekleyin! Çoktan doldu! Bugün için bu kadar yeter!Dialogue: 55,0:09:59.03,0:10:01.41,Main-207+,,0,0,0,,O hâlde başka bir gemi getir!Dialogue: 55,0:10:01.41,0:10:02.70,Main-207+,,0,0,0,,Sizi kaplumbağalar!Dialogue: 55,0:10:03.80,0:10:05.25,Main-207+,,0,0,0,,Ö-Özür dilerim!Dialogue: 55,0:10:10.54,0:10:13.00,Main-207+,,0,0,0,,Ne kadar taş taşıdılar?Dialogue: 55,0:10:13.00,0:10:15.09,Main-207+,,0,0,0,,500'den sonrasını sayamadım...Dialogue: 55,0:10:15.09,0:10:17.43,Main-207+,,0,0,0,,Ne?! Deniz taşı kelepçeleri yok mu?!Dialogue: 55,0:10:17.43,0:10:18.26,Main-207+,,0,0,0,,Var.Dialogue: 55,0:10:20.69,0:10:24.10,Main-207+,,0,0,0,,Güçsüz düşmüş olmalarına rağmen mi?Dialogue: 55,0:10:24.70,0:10:29.02,Main-207+,,0,0,0,,Kelepçesiz hâllerini düşünemiyorum bile.Dialogue: 55,0:10:29.02,0:10:32.19,Main-207+,,0,0,0,,Çalışmamı bitirdim! Bana yemeğimi verin!Dialogue: 55,0:10:34.27,0:10:35.15,Main-207+,,0,0,0,,Ne?!Dialogue: 55,0:10:35.80,0:10:37.76,Main-207+,,0,0,0,,Neeeee?!Dialogue: 55,0:10:54.59,0:10:57.80,Main-207+,,0,0,0,,O kadar yiyeceği kapmak için ne kadar taş taşıdılar?!Dialogue: 55,0:11:02.55,0:11:04.14,Main-207+,,0,0,0,,Ne bakıyo'n lan?!Dialogue: 55,0:11:04.14,0:11:05.43,Main-207+,,0,0,0,,Asıl sen neye bakıyon?!Dialogue: 55,0:11:06.29,0:11:08.35,Main-207+,,0,0,0,,Senden bir tane fazla aldım!Dialogue: 55,0:11:08.35,0:11:10.39,Main-207+,,0,0,0,,Seni palyaço kılıklı! Seni geçtim!Dialogue: 55,0:11:10.39,0:11:13.65,Main-207+,,0,0,0,,Hadi be ordan! Beni yenmenin imkânı yok, Dikenli!Dialogue: 55,0:11:13.65,0:11:16.65,Main-207+,,0,0,0,,Saymayı bile beceremiyor musun, seni salak maymun?!Dialogue: 55,0:11:16.65,0:11:18.15,Main-207+,,0,0,0,,Ahmak!Dialogue: 55,0:11:18.15,0:11:20.15,Main-207+,,0,0,0,,Kahrolası!Dialogue: 55,0:11:22.90,0:11:26.20,Main-207+,,0,0,0,,İkisinin de çok kötü yaralandıklarını sanıyordum.Dialogue: 55,0:11:28.99,0:11:34.46,Main-207+,,0,0,0,,Çalışıp yiyorlar ve uyuyorlar. Sadece bir kaç gün oldu ama çok sağlıklılar.Dialogue: 55,0:11:34.46,0:11:36.67,Main-207+,,0,0,0,,Ne biçim bir vücutları var ki?!Dialogue: 55,0:11:37.45,0:11:40.67,Main-207+,,0,0,0,,Morallerini nasıl yerle bir edebileceğiz ki?!Dialogue: 55,0:11:41.74,0:11:43.01,Main-207+,,0,0,0,,Onlara bir şeyler söyle!Dialogue: 55,0:11:43.01,0:11:44.26,Main-207+,,0,0,0,,Ne?!Dialogue: 55,0:11:49.43,0:11:51.69,Main-207+,,0,0,0,,Y-Yemeğinizi çiğnemeden yutmayın!Dialogue: 55,0:11:51.69,0:11:53.31,Main-207+,,0,0,0,,Anneleri misin lan?!Dialogue: 55,0:12:07.58,0:12:10.16,Main-207+,,0,0,0,,Canım... dangolarım...Dialogue: 55,0:12:19.25,0:12:21.92,Main-207+,,0,0,0,,Hay sikeyim!Dialogue: 55,0:12:25.20,0:12:31.89,Main-207+,,0,0,0,,Kim depodaki tüm yemeği yedi?!Dialogue: 55,0:12:33.10,0:12:34.39,Main-207+,,0,0,0,,Dobon-sama!Dialogue: 55,0:12:36.52,0:12:38.35,Main-207+,,0,0,0,,Su aygırı!Dialogue: 55,0:12:39.19,0:12:42.82,Main-207+,,0,0,0,,Bunun sorumlusu kim?!Dialogue: 55,0:12:45.82,0:12:47.74,Main-207+,,0,0,0,,Yardım edin..!Dialogue: 55,0:12:47.74,0:12:50.20,Main-207+,,0,0,0,,Oh! İhtiyar Hyo yakalanmış!Dialogue: 55,0:12:50.20,0:12:51.95,Main-207+,,0,0,0,,Buraya doğru sürün, ihtiyar!Dialogue: 55,0:12:52.69,0:12:54.21,Main-207+,,0,0,0,,Dobon-sama!Dialogue: 55,0:12:54.21,0:12:55.92,Main-207+,,0,0,0,,Sorumluları içeri tıktık!Dialogue: 55,0:12:55.92,0:12:58.71,Main-207+,,0,0,0,,Ne?! Peki ya dango?!Dialogue: 55,0:12:58.71,0:13:01.09,Main-207+,,0,0,0,,Hepsini yediler.Dialogue: 55,0:13:01.09,0:13:04.19,Main-207+,,0,0,0,,Siz de sadece durup izlediniz mi?!Dialogue: 55,0:13:04.19,0:13:06.47,Main-207+,,0,0,0,,O yemek için çok çalıştılar...Dialogue: 55,0:13:06.47,0:13:10.48,Main-207+,,0,0,0,,bu yüzden çok da bir şey söyleyemedik.Dialogue: 55,0:13:11.40,0:13:15.49,Main-207+,,0,0,0,,Müdür yardımcısının sözünü hiçe saymaya nasıl cüret edersiniz?!Dialogue: 55,0:13:20.61,0:13:24.03,Main-207+,,0,0,0,,Su aygırı, ağzını kapattığı için onu pek de duyamıyorum.Dialogue: 55,0:13:24.03,0:13:25.20,Main-207+,,0,0,0,,Su aygırı?Dialogue: 55,0:13:25.78,0:13:27.20,Main-207+,,0,0,0,,Dobon-sama...Dialogue: 55,0:13:29.31,0:13:32.41,Main-207+,,0,0,0,,Derhal sorumluları buraya getirin!Dialogue: 55,0:13:41.00,0:13:43.30,Main-207+,,0,0,0,,Dobon-sama, işte buradalar!Dialogue: 55,0:13:45.42,0:13:47.30,Main-207+,,0,0,0,,Sorumlular bunlar.Dialogue: 55,0:13:56.86,0:13:58.77,Main-207+,,0,0,0,,– Tıka basa dolmuşlar! – Tıka basa dolmuşlar!Dialogue: 55,0:13:58.77,0:14:02.32,Main-207+,,0,0,0,,Buralarda bu kadar doyanı daha önce hiç görmemiştim!Dialogue: 55,0:14:02.32,0:14:04.19,Main-207+,,0,0,0,,Çok şanslılar!Dialogue: 55,0:14:04.19,0:14:05.99,Main-207+,,0,0,0,,Hay ben sizin!Dialogue: 55,0:14:05.99,0:14:09.57,Main-207+,,0,0,0,,Çok fazla yiyen birisiyim ama bana sadece üç dango bırakmışsınız...Dialogue: 55,0:14:09.57,0:14:11.45,Main-207+,,0,0,0,,sizi pis domuzlar!Dialogue: 55,0:14:11.45,0:14:14.58,Main-207+,,0,0,0,,Şunun ağzına bakın! Bu kadar dango yeter mi?!Dialogue: 55,0:14:14.58,0:14:16.75,Main-207+,,0,0,0,,Tabii ki yetmez!Dialogue: 55,0:14:17.70,0:14:19.82,Main-207+,,0,0,0,,Bekle bir dakika...Dialogue: 55,0:14:19.82,0:14:22.09,Main-207+,,0,0,0,,Bunu önce bir sindirmem gerek...Dialogue: 55,0:14:35.60,0:14:37.06,Main-207+,,0,0,0,,– Ne?! – Ne?!Dialogue: 55,0:14:43.94,0:14:47.36,Main-207+,,0,0,0,,Mahkûmların memnun olduklarını görmek istemiyorum!Dialogue: 55,0:14:48.00,0:14:52.35,Main-207+,,0,0,0,,O benim yemeğimdi!Dialogue: 55,0:14:56.88,0:15:00.25,Main-207+,,0,0,0,,Hey! Şansınızı zorlamayın, sizi böcekler!Dialogue: 55,0:15:00.25,0:15:06.00,Main-207+,,0,0,0,,Dinleyin! Eğer bir muhafıza bulaşırsanız...Dialogue: 55,0:15:06.00,0:15:08.55,Main-207+,,0,0,0,,ilk saldırışınız kollarınıza mâl olur!Dialogue: 55,0:15:09.84,0:15:12.26,Main-207+,,0,0,0,,İkinci saldırınızda bacaklarınızı alırız!Dialogue: 55,0:15:14.15,0:15:15.89,Main-207+,,0,0,0,,Ve üçüncü saldırınızda...Dialogue: 55,0:15:15.89,0:15:18.10,Main-207+,,0,0,0,,canınızdan olursunuz!Dialogue: 55,0:15:18.10,0:15:19.93,Main-207+,,0,0,0,,Kendinize gelin!Dialogue: 55,0:15:21.23,0:15:26.98,Main-207+,,0,0,0,,Doğru söylüyor! Bize saldırmak gibi bir seçeneğiniz yok!Dialogue: 55,0:15:26.98,0:15:32.70,Main-207+,,0,0,0,,Hey, şu an zaten güçsüz durumdayız, deniz taşı kelepçeleri sağ olsun.Dialogue: 55,0:15:33.30,0:15:35.70,Main-207+,,0,0,0,,Tek yaptığımız çok çalışmaktı.Dialogue: 55,0:15:37.10,0:15:40.16,Main-207+,,0,0,0,,Suçunuz...Dialogue: 55,0:15:45.61,0:15:49.59,Main-207+,,0,0,0,,tüm yemeğimi yemeniz!Dialogue: 55,0:15:52.84,0:15:54.26,Main-207+,,0,0,0,,Senin ben ta...Dialogue: 55,0:15:54.26,0:15:55.35,Main-207+,,0,0,0,,Dikenli!Dialogue: 55,0:16:01.56,0:16:03.81,Main-207+,,0,0,0,,Su aygırı!Dialogue: 55,0:16:04.44,0:16:09.15,Main-207+,,0,0,0,,Size iyi bir ders vereceğim!Dialogue: 55,0:16:10.40,0:16:12.40,Main-207+,,0,0,0,,Onları yedi!Dialogue: 55,0:16:12.40,0:16:14.61,Main-207+,,0,0,0,,Zavallı aptallar!Dialogue: 55,0:16:14.61,0:16:18.91,Main-207+,,0,0,0,,Dobon-sama'nın ağzının içi mezbaha gibidir!Dialogue: 55,0:16:40.70,0:16:42.64,Main-207+,,0,0,0,,Ne oldu öyle?!Dialogue: 55,0:16:42.64,0:16:46.44,Main-207+,,0,0,0,,Su aygırının bu şekilde yere düştüğünü hiç görmemiştin!Dialogue: 55,0:16:54.18,0:16:56.84,Main-207+,,0,0,0,,Müdür Yardımcısı Dobon?!Dialogue: 55,0:17:11.30,0:17:15.93,Main-207+,,0,0,0,,Ne yaptığınıza bakın! Kesinlikle ölüm cezası alacaksınız!Dialogue: 55,0:17:19.20,0:17:20.76,Main-207+,,0,0,0,,Kanıtlasana.Dialogue: 55,0:17:20.76,0:17:21.64,Main-207+,,0,0,0,,Ne?!Dialogue: 55,0:17:23.09,0:17:26.56,Main-207+,,0,0,0,,Sana kanıtla dedim.Dialogue: 55,0:17:33.03,0:17:35.70,Main-207+,,0,0,0,,Harikasınız be!Dialogue: 55,0:17:35.70,0:17:38.57,Main-207+,,0,0,0,,Biz mahkûmlar için birer kahramansınız!Dialogue: 55,0:17:57.41,0:18:02.60,Main-207+,,0,0,0,,Gelin ve özel sobanızı alın! Sangoro'nun özel sobası!Dialogue: 55,0:18:12.48,0:18:16.57,Main-207+,,0,0,0,,Sangoro'nun özel sobası!Dialogue: 55,0:18:19.16,0:18:21.12,Main-207+,,0,0,0,,Hemen istiyorum!Dialogue: 55,0:18:25.41,0:18:28.73,Main-207+,,0,0,0,,İşte! Beklediğiniz için teşekkür ederim!Dialogue: 55,0:18:28.73,0:18:31.25,Main-207+,,0,0,0,,Oh, çok lezzetli duruyor!Dialogue: 55,0:18:45.79,0:18:50.19,Main-207+,,0,0,0,,Çok iyi! İnanılmaz lezzetli!Dialogue: 55,0:18:50.19,0:18:52.27,Main-207+,,0,0,0,,Luffy'den haber var mı?Dialogue: 55,0:18:52.27,0:18:55.94,Main-207+,,0,0,0,,Udon'daki tutsak madeninde, değil mi?Dialogue: 55,0:18:55.94,0:19:01.89,Main-207+,,0,0,0,,Buradan epey bir uzak ama büyük gün gelmeden kaçacağına eminim.Dialogue: 55,0:19:02.87,0:19:08.62,Main-207+,,0,0,0,,Yemeklerini özlemişim, Sanji! Güvenle geri dönmene çok sevindim!Dialogue: 55,0:19:11.88,0:19:14.71,Main-207+,,0,0,0,,Düşüncelerin umurumda değil...Dialogue: 55,0:19:15.32,0:19:18.97,Main-207+,,0,0,0,,Orobi-chan! Sence nasıl?Dialogue: 55,0:19:19.50,0:19:21.80,Main-207+,,0,0,0,,Tadı inanılmaz!Dialogue: 55,0:19:21.80,0:19:25.35,Main-207+,,0,0,0,,Orobi-chan, geyşa olarak bi' harika!Dialogue: 55,0:19:26.89,0:19:28.14,Main-207+,,0,0,0,,Neyse...Dialogue: 55,0:19:28.61,0:19:31.98,Main-207+,,0,0,0,,soba harika evet ama sadece kızların ilgisini çekiyor.Dialogue: 55,0:19:31.98,0:19:36.11,Main-207+,,0,0,0,,Samurayları da buraya çekmeliyiz. Baharatlı ve sakeye uygun şeyler hazırla!Dialogue: 55,0:19:40.80,0:19:45.57,Main-207+,,0,0,0,,Bu bakış da ne? Daha fazla müttefik istemiyor musun, ahmak?!Dialogue: 55,0:19:49.31,0:19:52.73,Main-207+,,0,0,0,,Bekle, Franky! Bak erkek müşteriler geliyor!Dialogue: 55,0:19:53.67,0:19:55.33,Main-207+,,0,0,0,,Affedersiniz!Dialogue: 55,0:19:55.33,0:19:57.71,Main-207+,,0,0,0,,Bağışlayın, hanımlar!Dialogue: 55,0:19:57.71,0:20:00.80,Main-207+,,0,0,0,,Hey, araya kaynamayın!Dialogue: 55,0:20:01.90,0:20:06.01,Main-207+,,0,0,0,,He?! Bir şey mi söyledin?! Kapa' çeneni!Dialogue: 55,0:20:08.18,0:20:09.85,Main-207+,,0,0,0,,Kyoshira Ailesi'ndenler...Dialogue: 55,0:20:09.85,0:20:10.93,Main-207+,,0,0,0,,Ne?!Dialogue: 55,0:20:13.10,0:20:14.77,Main-207+,,0,0,0,,Hey, çekil yolumuzdan!Dialogue: 55,0:20:18.15,0:20:21.78,Main-207+,,0,0,0,,Bu mekan baya sükse yaptı gibi, genç adam!Dialogue: 55,0:20:21.78,0:20:24.32,Main-207+,,0,0,0,,Evet, aniden parladık.Dialogue: 55,0:20:24.32,0:20:29.08,Main-207+,,0,0,0,,Sizler de müşteri misiniz? Yemek istiyorsanız sıraya girin!Dialogue: 55,0:20:29.08,0:20:32.17,Main-207+,,0,0,0,,Hayır, sana burada...Dialogue: 55,0:20:32.17,0:20:36.46,Main-207+,,0,0,0,,iş yapma iznini kim verdi diye sormaya geldik.Dialogue: 55,0:20:39.67,0:20:43.19,Main-207+,,0,0,0,,Bizler Kyoshiro Ailesi'ndeniz ve burası bizim bölgemiz.Dialogue: 55,0:20:43.19,0:20:47.80,Main-207+,,0,0,0,,Haracını öde yoksa burada  satış yapmana izin vermeyiz!Dialogue: 55,0:20:47.80,0:20:50.68,Main-207+,,0,0,0,,Oh, öyle mi?Dialogue: 55,0:20:51.93,0:20:55.35,Main-207+,,0,0,0,,Sanırım kim olduklarını biliyorum.Dialogue: 55,0:20:56.67,0:20:58.48,Main-207+,,0,0,0,,Ne biliyorsun?Dialogue: 55,0:20:58.48,0:21:03.82,Main-207+,,0,0,0,,Evet, Kyoshiro adında bir adam beni kendi salonuna çağırttı.Dialogue: 55,0:21:04.45,0:21:08.28,Flashbacks-207+,,0,0,0,,Şogun Orochi ödleğin önde gideni!Dialogue: 55,0:21:12.83,0:21:16.12,Flashbacks-207+,,0,0,0,,Sake! Kadehim boş kalmasın!Dialogue: 55,0:21:19.46,0:21:24.84,Main-207+,,0,0,0,,Son derece kibirli bir samuraydı. Görünüşe göre bir yakuza patronu.Dialogue: 55,0:21:24.84,0:21:28.51,Main-207+,,0,0,0,,Bunlar muhtemelen onun adamları.Dialogue: 55,0:21:29.47,0:21:33.72,Main-207+,,0,0,0,,Hey, sağır mısın?! Dedim ki ödeme yapman gerekiyor!Dialogue: 55,0:21:33.72,0:21:34.68,Main-207+,,0,0,0,,Neden?Dialogue: 55,0:21:35.80,0:21:40.44,Main-207+,,0,0,0,,Neden mi? Çünkü ödemeni yapmazsan seni kötülüklerden koruyamayız.Dialogue: 55,0:21:41.29,0:21:45.28,Main-207+,,0,0,0,,Size ihtiyacım yok. Yeterince sertim.Dialogue: 55,0:21:47.20,0:21:49.20,Main-207+,,0,0,0,,İşte, beklediğin için teşekkür ederim!Dialogue: 55,0:21:49.20,0:21:50.74,Main-207+,,0,0,0,,Teşekkürler!Dialogue: 55,0:22:03.59,0:22:05.88,Main-207+,,0,0,0,,Sert olduğunu mu sanıyorsun?Dialogue: 55,0:22:05.88,0:22:09.34,Main-207+,,0,0,0,,O hâlde dükkanını korumayı dene bakalım!Dialogue: 55,0:22:10.68,0:22:12.14,Main-207+,,0,0,0,,Soba!Dialogue: 55,0:22:12.14,0:22:13.68,Main-207+,,0,0,0,,Hey!Dialogue: 55,0:22:13.68,0:22:16.10,Main-207+,,0,0,0,,Bu mekandan soba yemen yasak!Dialogue: 55,0:22:27.68,0:22:31.41,Main-207+,,0,0,0,,Ağlıyor mu yoksa gülüyor mu?Dialogue: 55,0:22:31.41,0:22:33.91,Main-207+,,0,0,0,,Sobam!Dialogue: 55,0:22:38.37,0:22:41.92,Main-207+,,0,0,0,,Olamaz! Tam da Sanji'nin sinirlerini hoplatacak cinsten hareketler!Dialogue: 55,0:22:41.92,0:22:45.51,Main-207+,,0,0,0,,Evinize gidin, sersemler! Bu dükkân kapandı!Dialogue: 55,0:22:47.67,0:22:50.64,Main-207+,,0,0,0,,Gidin, uzaklaşın! Tüm sobalar tükendi!Dialogue: 55,0:22:52.68,0:22:55.81,Main-207+,,0,0,0,,Haydi, kaybolun!Dialogue: 55,0:23:01.18,0:23:03.06,Main-207+,,0,0,0,,Olamaz! Uzaklaşsak iyi olacak!Dialogue: 55,0:23:04.40,0:23:05.57,Main-207+,,0,0,0,,Hey!Dialogue: 55,0:23:07.91,0:23:09.45,Main-207+,,0,0,0,,Ne istiyorsun?Dialogue: 55,0:23:10.76,0:23:13.45,Main-207+,,0,0,0,,Yemeğini bitirmeni rica edeceğim...Dialogue: 55,0:23:14.13,0:23:15.58,Main-207+,,0,0,0,,sayın müşterim.Dialogue: 55,0:23:15.58,0:23:18.75,Main-207+,,0,0,0,,Ha? Kavga mı istiyorsun, ahmak?!Dialogue: 55,0:23:18.75,0:23:21.04,Main-207+,,0,0,0,,Hey! Suke! Kaku!Dialogue: 55,0:23:21.04,0:23:22.50,Main-207+,,0,0,0,,Evet!Dialogue: 55,0:23:22.50,0:23:24.43,Main-207+,,0,0,0,,Hadi onu bi' güzel pataklayalım!Dialogue: 55,0:23:25.54,0:23:28.92,Main-207+,,0,0,0,,Hm?! Dövüş mü?!Dialogue: 55,0:23:28.92,0:23:30.80,Main-207+,,0,0,0,,Cehenneme kadar yolun var!Dialogue: 55,0:23:36.59,0:23:38.47,Main-207+,,0,0,0,,Seni piç!Dialogue: 55,0:23:48.37,0:23:50.72,Main-207+,,0,0,0,,Of, of, of...Dialogue: 55,0:23:58.90,0:24:00.12,Main-207+,,0,0,0,,Şerefsiz!Dialogue: 55,0:24:03.21,0:24:04.88,Main-207+,,0,0,0,,Geber!Dialogue: 55,0:24:23.69,0:24:25.21,Main-207+,,0,0,0,,Of, of, of...Dialogue: 55,0:24:27.80,0:24:29.82,Main-207+,,0,0,0,,Ağabey!Dialogue: 55,0:24:31.69,0:24:34.66,Main-207+,,0,0,0,,Bu soba aşçısı da ne böyle?! Çok güçlü!Dialogue: 55,0:24:34.66,0:24:37.16,Main-207+,,0,0,0,,Şu soba adam çok havalı!Dialogue: 55,0:24:37.16,0:24:40.87,Main-207+,,0,0,0,,Sanji, biraz bana da bırak!Dialogue: 55,0:24:45.17,0:24:47.08,Main-207+,,0,0,0,,İşte gidiyoruz!Dialogue: 55,0:24:47.08,0:24:50.80,Main-207+,,0,0,0,,Dur! Lanet olsun! Ne yapmaya çalışıyorsun?!Dialogue: 55,0:24:50.80,0:24:54.50,Main-207+,,0,0,0,,Franosuke Demir...Dialogue: 55,0:24:59.64,0:25:02.83,Main-207+,,0,0,0,,Supleksi!Dialogue: 55,0:25:11.15,0:25:12.95,Main-207+,,0,0,0,,Şu marangoz da mı?!Dialogue: 55,0:25:12.95,0:25:14.82,Main-207+,,0,0,0,,Bunu yapmamaları gerekirdi!Dialogue: 55,0:25:26.40,0:25:29.71,Main-207+,,0,0,0,,Şimdi her bir lokmayı yiyin.Dialogue: 55,0:25:29.71,0:25:33.46,Main-207+,,0,0,0,,Bu sobayı heba ettiniz! Bitirmek zorundasınız!Dialogue: 55,0:25:34.17,0:25:37.26,Main-207+,,0,0,0,,Al, ye bakalım! Tek bir lokma kalmasın!Dialogue: 55,0:25:35.14,0:25:37.26,Secondary-207+,,0,0,0,,Ağabey! Ağabey!Dialogue: 55,0:25:37.26,0:25:39.69,Main-207+,,0,0,0,,Ne? Sen de mi istiyorsun?!Dialogue: 55,0:25:40.35,0:25:43.12,Main-207+,,0,0,0,,Buna pişman olacaksın!Dialogue: 55,0:25:45.20,0:25:47.85,Main-207+,,0,0,0,,Gel bakalım, uyuyan güzel.Dialogue: 55,0:25:50.52,0:25:53.15,Main-207+,,0,0,0,,Sizinle iş yapmak güzeldi!Dialogue: 55,0:25:53.15,0:25:58.33,Main-207+,,0,0,0,,Yani, bunu bekliyordum ama onları bu kadar pataklamamız iyi mi oldu?Dialogue: 55,0:25:59.99,0:26:03.25,Main-207+,,0,0,0,,Onlara bulaşmamak daha akıllıca olurdu.Dialogue: 55,0:26:03.79,0:26:07.65,Main-207+,,0,0,0,,O uzun müşteri kuyruğu hamam böcekleri gibi dağıldı.Dialogue: 55,0:26:07.65,0:26:11.17,Main-207+,,0,0,0,,Bu genellikle belanın "Ben geliyorum" deme şekli.Dialogue: 55,0:26:16.42,0:26:18.97,Main-207+,,0,0,0,,Sobası dökülen kız.Dialogue: 55,0:26:18.97,0:26:22.22,Main-207+,,0,0,0,,Çok tuhaf biri. Aynı anda hem ağlayıp hem de gülüyor.Dialogue: 55,0:26:22.22,0:26:23.76,Main-207+,,0,0,0,,Hm? Bekle bir saniye.Dialogue: 55,0:26:23.76,0:26:25.02,Main-207+,,0,0,0,,Ne oldu?Dialogue: 55,0:26:25.02,0:26:28.48,Main-207+,,0,0,0,,Onu daha önce bir yerde görmüştüm...Dialogue: 55,0:26:34.70,0:26:36.57,Flashbacks-207+,,0,0,0,,Pekâlâ!Dialogue: 55,0:26:36.57,0:26:39.24,Flashbacks-207+,,0,0,0,,Çok iyi iş yaptım!Dialogue: 55,0:26:39.24,0:26:41.82,Flashbacks-207+,,0,0,0,,Hiç bu kadar satacağımı düşünmemiştim!Dialogue: 55,0:26:46.58,0:26:47.95,Flashbacks-207+,,0,0,0,,Ne istiyorsun?Dialogue: 55,0:26:48.50,0:26:52.29,Flashbacks-207+,,0,0,0,,Hey, bu ilaç gerçekten her türlü yarayı iyileştirir mi?Dialogue: 55,0:26:52.29,0:26:54.34,Flashbacks-207+,,0,0,0,,Ha? Elbette!Dialogue: 55,0:26:54.34,0:26:57.01,Flashbacks-207+,,0,0,0,,Kanamayı durdurur ve ağrıyı azaltır!Dialogue: 55,0:26:57.01,0:27:00.88,Flashbacks-207+,,0,0,0,,Bu kurbağa yağı, sorunlarına kesin bir çözüm olur!Dialogue: 55,0:27:01.84,0:27:04.45,Flashbacks-207+,,0,0,0,,Harika!Dialogue: 55,0:27:05.02,0:27:07.47,Main-207+,,0,0,0,,Onunla tapınağın orada tanışmıştım.Dialogue: 55,0:27:15.57,0:27:20.03,Main-207+,,0,0,0,,Sorun yarattığım için özür dilerim...Dialogue: 55,0:27:20.03,0:27:24.03,Main-207+,,0,0,0,,Hâlâ sobamız var! Al bakalım!Dialogue: 55,0:27:24.03,0:27:27.41,Main-207+,,0,0,0,,Vaay! Çok teşekkür ederim!Dialogue: 55,0:27:41.51,0:27:42.93,Main-207+,,0,0,0,,Bu...Dialogue: 55,0:27:42.93,0:27:47.28,Main-207+,,0,0,0,,Ç-Çok lezzetli!Dialogue: 55,0:27:53.23,0:27:56.44,Main-207+,,0,0,0,,Çok bulaşıcı bir gülüşün var!Dialogue: 55,0:27:56.44,0:27:58.01,Main-207+,,0,0,0,,Gerçekten mi?!Dialogue: 55,0:27:59.86,0:28:05.32,Main-207+,,0,0,0,,Özel soban gerçekten çok popüler, denemek için sabırsızlanıyordum...Dialogue: 55,0:28:05.32,0:28:09.62,Main-207+,,0,0,0,,ama kuyruk çok uzundu!Dialogue: 55,0:28:09.62,0:28:14.72,Main-207+,,0,0,0,,O kadar çok bekledim ki işe çoktan geç kaldım.Dialogue: 55,0:28:16.63,0:28:18.00,Main-207+,,0,0,0,,İş mi?Dialogue: 55,0:28:18.00,0:28:20.38,Main-207+,,0,0,0,,Çalışıyor musun?!Dialogue: 55,0:28:20.38,0:28:25.80,Main-207+,,0,0,0,,Hı hı! Soba alacak parayı biriktirmek için çok çalışmam gerekiyor.Dialogue: 55,0:28:25.80,0:28:28.22,Main-207+,,0,0,0,,Döküldüğünde çok üzülmüştüm!Dialogue: 55,0:28:28.22,0:28:29.27,Main-207+,,0,0,0,,Artık mutluyum ama!Dialogue: 55,0:28:33.00,0:28:35.48,Main-207+,,0,0,0,,Bu yediğim en iyi soba!Dialogue: 55,0:28:37.09,0:28:41.82,Main-207+,,0,0,0,,Oh, öyle mi?! O kadar sevdin mi? Teşekkürler!Dialogue: 55,0:28:41.82,0:28:43.95,Main-207+,,0,0,0,,Bu arada adın ne?Dialogue: 55,0:28:43.95,0:28:47.20,Main-207+,,0,0,0,,Ben Toko ama başına "O" saygı ekini koyarak söyleyin!Dialogue: 55,0:28:47.20,0:28:48.44,Main-207+,,0,0,0,,"O"?Dialogue: 55,0:28:48.87,0:28:50.59,Main-207+,,0,0,0,,Otoko-chan?Dialogue: 55,0:28:50.59,0:28:52.49,Main-207+,,0,0,0,,Oh! "Otoko", "erkek" demek değil mi?!Dialogue: 55,0:28:52.49,0:28:55.49,Main-207+,,0,0,0,,Ben erkek değilim! Adım Otoko sadece!Dialogue: 55,0:28:58.38,0:29:01.30,Main-207+,,0,0,0,,Ben bir kızım ama ismim Otoko!Dialogue: 55,0:29:03.01,0:29:06.47,Main-207+,,0,0,0,,Komik he? Çok komik, değil mi?Dialogue: 55,0:29:15.10,0:29:17.81,Main-207+,,0,0,0,,Herkes hatırlaması kolay der!Dialogue: 55,0:29:20.85,0:29:23.49,Main-207+,,0,0,0,,Yaa! Evet! Kesinlikle unutmayacağım!Dialogue: 55,0:29:23.49,0:29:25.28,Main-207+,,0,0,0,,Bu harika bir isim!Dialogue: 55,0:29:26.24,0:29:28.03,Main-207+,,0,0,0,,Tamamen öyle!Dialogue: 55,0:29:30.31,0:29:32.83,Main-207+,,0,0,0,,Oh, bu gerçekten çok lezizdi.Dialogue: 55,0:29:32.83,0:29:34.39,Main-207+,,0,0,0,,Teşekkür ederim.Dialogue: 55,0:29:34.39,0:29:37.20,Main-207+,,0,0,0,,Tamamdır! Tekrar uğra!Dialogue: 55,0:29:37.20,0:29:38.49,Main-207+,,0,0,0,,Tabii!Dialogue: 55,0:29:38.49,0:29:42.67,Main-207+,,0,0,0,,Olamaz! Geç kaldım!  Çok, çok geç kaldım!Dialogue: 55,0:29:44.13,0:29:47.55,Main-207+,,0,0,0,,Doğru ya! Bu sokaktan gün içinde tekrar geçeceğim!Dialogue: 55,0:29:47.55,0:29:49.76,Main-207+,,0,0,0,,Oiran'ın geçit töreni bugün!Dialogue: 55,0:29:49.76,0:29:51.30,Main-207+,,0,0,0,,Oiran mı?!Dialogue: 55,0:29:51.30,0:29:54.29,Main-207+,,0,0,0,,Toko-chan, yoksa kamuro musun?Dialogue: 55,0:29:54.29,0:29:56.99,Main-207+,,0,0,0,,Evet! Ben bir kamuro'yum!Dialogue: 55,0:29:56.99,0:30:01.11,Main-207+,,0,0,0,,Çoktan başladı bile! Koşmalıyım! Bay bay! Hoşça kalın!Dialogue: 55,0:30:01.60,0:30:04.82,Main-207+,,0,0,0,,Oiran gerçekten çok güzel, gelip bir görün!Dialogue: 55,0:30:08.37,0:30:10.59,Main-207+,,0,0,0,,Görüşürüz!Dialogue: 55,0:30:10.59,0:30:13.91,Main-207+,,0,0,0,,Vay be, ne komik kız ama!Dialogue: 55,0:30:15.32,0:30:18.25,Main-207+,,0,0,0,,Toko-chan çok neşeli. Çok sevimli!Dialogue: 55,0:30:18.25,0:30:22.50,Main-207+,,0,0,0,,Hakkında çok şey duyduğum  oiran'ın geçit töreni buradan mı geçecek?!Dialogue: 55,0:30:22.50,0:30:24.30,Main-207+,,0,0,0,,Oiran mı?Dialogue: 55,0:30:24.30,0:30:26.17,Main-207+,,0,0,0,,Kamuro mu?Dialogue: 55,0:30:29.13,0:30:32.05,Main-207+,,0,0,0,,Oiran...Dialogue: 55,0:30:33.01,0:30:36.43,Main-207+,,0,0,0,,Sen nereden çıktın, seni kandil yaşlı kadın!Dialogue: 55,0:30:36.43,0:30:37.48,Main-207+,,0,0,0,,Hanımım!Dialogue: 55,0:30:38.18,0:30:41.23,Main-207+,,0,0,0,,Kime kandil diyo'nuz lan?!Dialogue: 55,0:30:41.23,0:30:44.57,Main-207+,,0,0,0,,Seni kıçından aydınlatacağım, sümüklü!Dialogue: 55,0:30:46.77,0:30:51.78,Main-207+,,0,0,0,,Oiranlar Wano'daki en büyük idollerdir! Süper yıldızlardır!Dialogue: 55,0:30:53.19,0:30:54.78,Main-207+,,0,0,0,,– Hı-hı! Hı-hı! – Hı-hı! Hı-hı!Dialogue: 55,0:30:54.78,0:31:00.16,Main-207+,,0,0,0,,Şu anda ülkede tek bir oiran var! Seçilmiş kadının adı Komurasaki!Dialogue: 55,0:31:00.16,0:31:02.42,Main-207+,,0,0,0,,Erkeklerin rüyası! Kadınların idolü!Dialogue: 55,0:31:02.42,0:31:06.05,Main-207+,,0,0,0,,Zarafetin vücut bulmuş hali! Bir ülkeyi yerle bir edecek güzellik!Dialogue: 55,0:31:11.14,0:31:13.55,Main-207+,,0,0,0,,Tanrılar bile onun asaletine karşı çıkamaz!Dialogue: 55,0:31:13.55,0:31:17.05,Main-207+,,0,0,0,,Oiran KomurasakiDialogue: 55,0:31:17.78,0:31:21.06,Main-207+,,0,0,0,,Olamaz! Bu kadar harika bir kadın var olamaz!Dialogue: 55,0:31:21.06,0:31:23.44,Main-207+,,0,0,0,,Bana inanmıyorsanız kendi gözlerinizle görün!Dialogue: 55,0:31:26.86,0:31:29.53,Main-207+,,0,0,0,,İşte! Duydunuz mu?!Dialogue: 55,0:31:29.53,0:31:34.21,Main-207+,,0,0,0,,Onu çevreleyen tezahürata ve neşeli müziğe kulak kesilin.Dialogue: 55,0:31:35.49,0:31:38.59,Main-207+,,0,0,0,,Oiran töreni Orochi Kalesi'ne doğru ilerliyor!Dialogue: 55,0:31:38.59,0:31:42.29,Main-207+,,0,0,0,,Bu gece şogun için şatoda bir ziyafet düzenleniyor!Dialogue: 55,0:31:42.29,0:31:47.07,Main-207+,,0,0,0,,Önceden o gördüğünüz kız Kamuro, oiran'ın genç hizmetçisi.Dialogue: 55,0:31:47.07,0:31:49.92,Main-207+,,0,0,0,,Hmm, anlıyorum!Dialogue: 55,0:31:49.92,0:31:54.81,Main-207+,,0,0,0,,Orobi, sana iyi haberlerim var! Her yerde seni arıyordum!Dialogue: 55,0:31:54.81,0:31:55.72,Main-207+,,0,0,0,,Beni mi?!Dialogue: 55,0:31:57.27,0:31:59.71,Main-207+,,0,0,0,,Tebrik ederim!Dialogue: 55,0:31:59.71,0:32:00.77,Main-207+,,0,0,0,,Ne?!Dialogue: 55,0:32:00.77,0:32:03.73,Main-207+,,0,0,0,,Aynı ziyafete sen de çağırıldın!Dialogue: 55,0:32:03.73,0:32:07.59,Main-207+,,0,0,0,,Hedefin şogun Orochi-sama ile tanışmaktı, değil mi?!Dialogue: 55,0:32:07.59,0:32:08.44,Main-207+,,0,0,0,,Evet!Dialogue: 55,0:32:08.44,0:32:12.57,Main-207+,,0,0,0,,Vay! İşte bizim Robin-chan!Dialogue: 55,0:32:12.57,0:32:15.46,Main-207+,,0,0,0,,Şimdi, eve git ve hazırlan!Dialogue: 55,0:32:15.46,0:32:18.38,Main-207+,,0,0,0,,Tabii! Sabırsızlanıyorum!Dialogue: 55,0:32:30.48,0:32:32.22,Main-207+,,0,0,0,,Hey, hasır şapkalı!Dialogue: 55,0:32:32.22,0:32:35.20,Main-207+,,0,0,0,,Gerçekten iyisin! Hangi ailedensin?!Dialogue: 55,0:32:35.20,0:32:40.19,Main-207+,,0,0,0,,Dün yaptıklarını görmek çok iyi geldi! Herkes sizi konuşuyor!Dialogue: 55,0:32:40.19,0:32:41.56,Main-207+,,0,0,0,,Rahat bırakın beni.Dialogue: 55,0:32:41.56,0:32:46.58,Main-207+,,0,0,0,,Böyle davranma. Hepimiz sizi seviyoruz!Dialogue: 55,0:32:46.58,0:32:48.61,Main-207+,,0,0,0,,Öff! Amma da pislik!Dialogue: 55,0:32:49.57,0:32:51.61,Main-207+,,0,0,0,,Bay Hasır Şapka!Dialogue: 55,0:32:54.16,0:33:00.79,Main-207+,,0,0,0,,Dün değersiz hayatımı kurtardığınız için size minnettarım!Dialogue: 55,0:33:00.79,0:33:03.41,Main-207+,,0,0,0,,Zaten kaşınıyordu, dert etme.Dialogue: 55,0:33:04.59,0:33:06.96,Main-207+,,0,0,0,,Ah, evet. Bunları alabilirsin!Dialogue: 55,0:33:06.96,0:33:09.67,Main-207+,,0,0,0,,Sen yesen daha iyi, yoksa güç bulamayacaksın!Dialogue: 55,0:33:09.67,0:33:15.58,Main-207+,,0,0,0,,Oh, hayır! Lütfen yapmayın! Benim gibi işe yaramaz biri bunları kabul edemez!Dialogue: 55,0:33:15.58,0:33:18.26,Main-207+,,0,0,0,,Ah, hadi ama! Al şunları.Dialogue: 55,0:33:19.51,0:33:20.54,Main-207+,,0,0,0,,Görüşürüz!Dialogue: 55,0:33:21.14,0:33:24.23,Main-207+,,0,0,0,,K-Kesinlikle tadını çıkaracağım!Dialogue: 55,0:33:24.23,0:33:30.99,Main-207+,,0,0,0,,Teşekkür ederim! Çok teşekkür ederim!Dialogue: 55,0:33:30.99,0:33:32.87,Main-207+,,0,0,0,,Ne komik adam!Dialogue: 55,0:33:37.11,0:33:38.63,Main-207+,,0,0,0,,Luffy-dono!Dialogue: 55,0:33:39.49,0:33:42.08,Main-207+,,0,0,0,,Raizo! Nasıl gitti?!Dialogue: 55,0:33:42.08,0:33:43.20,Main-207+,,0,0,0,,Üzgünüm, beklettim.Dialogue: 55,0:33:43.20,0:33:48.49,Main-207+,,0,0,0,,Kelepçelerin anahtarının nerede olduğunu buldum ama...Dialogue: 55,0:33:48.49,0:33:50.36,Main-207+,,0,0,0,,sıkı güvenlikle korunuyorlar.Dialogue: 55,0:33:50.36,0:33:54.30,Main-207+,,0,0,0,,Etrafında bir kaç muhafız var ve deniz taşı kutusunda saklanıyor!Dialogue: 55,0:33:55.30,0:33:56.43,Main-207+,,0,0,0,,Yine de...Dialogue: 55,0:33:57.43,0:34:01.22,Main-207+,,0,0,0,,onları senin için alacağım. Sabırlı ol.Dialogue: 55,0:34:01.22,0:34:03.89,Main-207+,,0,0,0,,Tamam! Anlaşıldı!Dialogue: 55,0:34:07.80,0:34:09.81,Main-207+,,0,0,0,,Pekâlâ!Dialogue: 55,0:34:28.60,0:34:29.92,Main-207+,,0,0,0,,Yine mi sen?!Dialogue: 55,0:34:31.49,0:34:35.67,Main-207+,,0,0,0,,Çok sıkı çalışıyorsun, patron!Dialogue: 55,0:34:36.01,0:34:39.54,Main-207+,,0,0,0,,Kaç dango almayı hedefliyorsun, patron?Dialogue: 55,0:34:39.54,0:34:41.22,Main-207+,,0,0,0,,Sana vermem!Dialogue: 55,0:34:41.22,0:34:43.27,Main-207+,,0,0,0,,Kaybol, Caribou!Dialogue: 55,0:34:43.27,0:34:49.01,Main-207+,,0,0,0,,Böyle yapma! Biz eski dostuz, değil mi?Dialogue: 55,0:34:50.49,0:34:53.93,Narrator-207+,,0,0,0,,Caribou Korsanları'ndan Yağlı Saç Caribou.Dialogue: 55,0:34:53.93,0:35:00.20,Narrator-207+,,0,0,0,,Luffy, bu acımasız ama talihsiz korsanla Sabaody Takımadaları'nda tanıştı.Dialogue: 55,0:35:00.95,0:35:08.41,Narrator-207+,,0,0,0,,Balıkadam Adası'na giderken Hasır Şapkalar'ı pusuya düşürmeyi başaramadı!Dialogue: 55,0:35:08.96,0:35:14.25,Narrator-207+,,0,0,0,,Balıkadam Adası'na vardıklarında hain planlarını yürütmeye devam etti...Dialogue: 55,0:35:14.25,0:35:17.80,Narrator-207+,,0,0,0,,ta ki Luffy ve Pekoms tarafından bozguna uğratılana kadar.Dialogue: 55,0:35:18.88,0:35:24.14,Narrator-207+,,0,0,0,,Caribou sonunda Yeni Dünya'ya ulaşabildi ve çeşitli zorlukların üstesinden gelmeye çalıştı.Dialogue: 55,0:35:27.27,0:35:30.56,Narrator-207+,,0,0,0,,Orada yeni bir yaşam tarzı edindi...Dialogue: 55,0:35:31.71,0:35:34.27,Narrator-207+,,0,0,0,,sonra Drake tarafından aniden bozguna uğratıldı.Dialogue: 55,0:35:34.95,0:35:36.73,Narrator-207+,,0,0,0,,Ardından Wano'ya gönderildi,Dialogue: 55,0:35:36.73,0:35:42.50,Narrator-207+,,0,0,0,,ve Udon tutsak madenlerinde bir mahkûm olarak çalıştırıldı.Dialogue: 55,0:35:47.69,0:35:49.37,Main-207+,,0,0,0,,Hadi ama patron!Dialogue: 55,0:35:49.37,0:35:53.02,Main-207+,,0,0,0,,Bana da biraz ver!Dialogue: 55,0:35:53.02,0:35:57.00,Main-207+,,0,0,0,,Az kibi dango için yalvarıyorum!Dialogue: 55,0:35:57.00,0:35:59.61,Main-207+,,0,0,0,,Asla olmaz! Kendin çalış, kazan!Dialogue: 55,0:35:59.61,0:36:01.76,Main-207+,,0,0,0,,Çok zalimsin!Dialogue: 55,0:36:01.76,0:36:04.66,Main-207+,,0,0,0,,Duyduğum kadarıyla bu deniz taşı kelepçelerinin...Dialogue: 55,0:36:04.66,0:36:09.77,Main-207+,,0,0,0,,etkisini azaltmışlar ki mahkûmlar daha iyi çalışabilsin.Dialogue: 55,0:36:09.77,0:36:12.85,Main-207+,,0,0,0,,Buna rağmen resmen felç geçiriyor gibiyim.Dialogue: 55,0:36:12.85,0:36:15.20,Main-207+,,0,0,0,,Kendini zorla!Dialogue: 55,0:36:15.20,0:36:19.46,Main-207+,,0,0,0,,Çok sertsin, patron!Dialogue: 55,0:36:19.46,0:36:22.57,Main-207+,,0,0,0,,Biraz kibi dango verirsen senin uşağın olurum.Dialogue: 55,0:36:22.57,0:36:25.99,Main-207+,,0,0,0,,Senden uzun zamandır buradayım...Dialogue: 55,0:36:25.99,0:36:29.00,Main-207+,,0,0,0,,yani mekanı daha iyi biliyorum.Dialogue: 55,0:36:29.00,0:36:34.32,Main-207+,,0,0,0,,Yapacaksın, değil mi, patron?Dialogue: 55,0:36:36.71,0:36:38.63,Main-207+,,0,0,0,,Kes sesini!Dialogue: 55,0:36:40.31,0:36:44.59,Main-207+,,0,0,0,,Kaçmayı planlıyorsun, değil mi?Dialogue: 55,0:36:44.59,0:36:47.06,Main-207+,,0,0,0,,Hadi! Plana beni de dahil et!Dialogue: 55,0:36:47.06,0:36:48.14,Main-207+,,0,0,0,,Git başımdan!Dialogue: 55,0:36:49.60,0:36:51.89,Main-207+,,0,0,0,,Gevşemek yok!Dialogue: 55,0:36:55.80,0:36:58.65,Main-207+,,0,0,0,,Seni yenen bir soba aşçısı mıydı?Dialogue: 55,0:36:58.65,0:37:02.02,Main-207+,,0,0,0,,Evet! Epey güçlüydü!Dialogue: 55,0:37:02.02,0:37:05.11,Main-207+,,0,0,0,,Üçümüzü de alt etti.Dialogue: 55,0:37:05.89,0:37:08.28,Main-207+,,0,0,0,,Bugün meşgulüm.Dialogue: 55,0:37:08.75,0:37:12.96,Main-207+,,0,0,0,,Şogun Orochi'nin ziyafetine davetliyim.Dialogue: 55,0:37:13.38,0:37:15.08,Main-207+,,0,0,0,,Queen'e ulaşın.Dialogue: 55,0:37:15.79,0:37:19.84,Main-207+,,0,0,0,,Söyleyin de bir suikastçı göndersin.Dialogue: 55,0:37:19.84,0:37:22.39,Main-207+,,0,0,0,,Bu muhtemelen kargaşaya yol açacak.Dialogue: 55,0:37:22.39,0:37:24.34,Main-207+,,0,0,0,,Umurumda değil!Dialogue: 55,0:37:23.89,0:37:24.34,Secondary-207+,,0,0,0,,Başüstüne!Dialogue: 55,0:37:29.50,0:37:30.64,Main-207+,,0,0,0,,Orochi-sama...Dialogue: 55,0:37:30.64,0:37:34.39,Main-207+,,0,0,0,,oiran yolda.Dialogue: 55,0:37:35.20,0:37:36.78,Main-207+,,0,0,0,,Harikulade...Dialogue: 55,0:37:37.78,0:37:39.48,Main-207+,,0,0,0,,Komurasaki...Dialogue: 55,0:37:42.49,0:37:48.52,Main-207+,,0,0,0,,bugünden itibaren benim olacaksın!Dialogue: 0,0:05:40.61,0:05:49.45,Title-207+,,0,0,0,,Kamuro OtokoDialogue: 1,0:05:40.61,0:05:49.45,Title-207+,,0,0,0,,Kamuro OtokoDialogue: 0,0:05:26.59,0:05:33.27,Captions Wano,,0,0,0,,Kibi'nin Kalıntıları, WanoDialogue: 1,0:05:26.59,0:05:33.27,Captions Wano,,0,0,0,,Kibi'nin Kalıntıları, WanoDialogue: 0,0:07:54.07,0:07:54.12,Captions Wano,,0,0,0,,Tutsak MadenleriDialogue: 1,0:07:54.07,0:07:54.12,Captions Wano,,0,0,0,,Tutsak MadenleriDialogue: 0,0:07:54.12,0:07:54.16,Captions Wano,,0,0,0,,Tutsak MadenleriDialogue: 1,0:07:54.12,0:07:54.16,Captions Wano,,0,0,0,,Tutsak MadenleriDialogue: 0,0:07:54.16,0:07:54.20,Captions Wano,,0,0,0,,Tutsak MadenleriDialogue: 1,0:07:54.16,0:07:54.20,Captions Wano,,0,0,0,,Tutsak MadenleriDialogue: 0,0:07:54.20,0:07:54.24,Captions Wano,,0,0,0,,Tutsak MadenleriDialogue: 1,0:07:54.20,0:07:54.24,Captions Wano,,0,0,0,,Tutsak MadenleriDialogue: 0,0:07:54.24,0:07:54.28,Captions Wano,,0,0,0,,Tutsak MadenleriDialogue: 1,0:07:54.24,0:07:54.28,Captions Wano,,0,0,0,,Tutsak MadenleriDialogue: 0,0:07:54.28,0:07:56.99,Captions Wano,,0,0,0,,Tutsak MadenleriDialogue: 1,0:07:54.28,0:07:56.99,Captions Wano,,0,0,0,,Tutsak MadenleriDialogue: 0,0:07:54.07,0:07:54.12,Captions Wano,,0,0,0,,ve Silah fabrikasıDialogue: 1,0:07:54.07,0:07:54.12,Captions Wano,,0,0,0,,ve Silah fabrikasıDialogue: 0,0:07:54.12,0:07:54.16,Captions Wano,,0,0,0,,ve Silah