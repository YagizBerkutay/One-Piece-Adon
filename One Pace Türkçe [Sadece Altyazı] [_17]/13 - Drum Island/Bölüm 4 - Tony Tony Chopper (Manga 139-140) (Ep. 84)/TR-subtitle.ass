[Script Info]Title: Default Aegisub fileScriptType: v4.00+WrapStyle: 0ScaledBorderAndShadow: yesYCbCr Matrix: TV.709PlayResX: 1440PlayResY: 1080[V4+ Styles]Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, EncodingStyle: Credits-207-,FOT-Greco Std B Strp,50,&H00FFFFFF,&H00002EFF,&H00000000,&H00000000,-1,0,0,0,95,100,1.6,0,1,3,0,7,16,16,16,1Style: Title-207-,Gilroy,90.0,&H00FEFEFE,&H00002EFF,&H00000000,&H00000000,-1,0,0,0,100,100,0,0,1,2.2,0,2,23,23,383,1Style: Main-207-,Impress BT Pace,73.0,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.0,3.0,2,180,180,27,1Style: Thoughts-207-,Impress BT Pace,73.0,&H00FFFFFF,&H00FFFFFF,&H00525252,&H78000000,0,0,0,0,100,100,0,0,1,3.5,3.0,2,180,180,27,1Style: Flashbacks-207-,Impress BT Pace,73.0,&H00FFFFFF,&H00FFFFFF,&H00525252,&H78000000,0,-1,0,0,100,100,0,0,1,3.0,3.0,2,180,180,27,1Style: Captions-207-,Gilroy,75.0,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,-1,0,0,0,100,100,0,0,1,3.5,0,2,16,16,27,1Style: Note-207-,Impress BT Pace,50.0,&H00FFFFFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,3.75,3.75,8,180,180,27,1Style: Secondary-207-,Impress BT Pace,73.0,&H00D6D6D6,&H00FFFFFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.0,3.0,2,180,180,27,1Style: Author,Impress BT,28.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1,1,9,10,10,10,1Style: Attack,Duality,50.0,&H00FFD388,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1,1,7,12,12,12,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 50,0:01:56.74,0:01:58.30,Main-207-,,0,0,0,,Sen yanlış yönde...Dialogue: 50,0:01:59.34,0:02:00.51,Main-207-,,0,0,0,,...saklanıp da bakıyor değil misin?Dialogue: 50,0:02:07.59,0:02:11.04,Main-207-,,0,0,0,,Artık çok geç... Ayrıca seni hala rahatlıkla görebiliyorum.Dialogue: 50,0:02:11.04,0:02:12.36,Main-207-,,0,0,0,,Sen tam olarak nesin?Dialogue: 50,0:02:12.36,0:02:15.32,Main-207-,,0,0,0,,Ka-kapa çeneni, insan!Dialogue: 50,0:02:15.92,0:02:17.49,Main-207-,,0,0,0,,Ayrıca, ateşin nasıl?Dialogue: 50,0:02:17.49,0:02:18.49,Main-207-,,0,0,0,,Konuşuyor!Dialogue: 50,0:02:27.65,0:02:29.34,Main-207-,,0,0,0,,Sessiz ol, Chopper!Dialogue: 50,0:02:38.86,0:02:41.81,Main-207-,,0,0,0,,Ateşin bir tık düşmüş gibi duruyor, kızım.Dialogue: 50,0:02:43.31,0:02:44.02,Main-207-,,0,0,0,,Mutlu musun?Dialogue: 50,0:02:49.52,0:02:50.73,Main-207-,,0,0,0,,Sen kimsin?Dialogue: 50,0:02:51.87,0:02:54.95,Main-207-,,0,0,0,,Hmm,  38.2°... Fena sayılmaz.Dialogue: 50,0:02:55.70,0:03:00.70,Main-207-,,0,0,0,,Ben bir doktorum. Dr. Kureha. Bana direkt Doktorine diyebilirsin.Dialogue: 50,0:03:01.17,0:03:03.66,Main-207-,,0,0,0,,Doktor... O zaman ben...Dialogue: 50,0:03:04.21,0:03:05.75,Main-207-,,0,0,0,,Gençliğimin sırrı ne diye mi soruyorsun?Dialogue: 50,0:03:06.25,0:03:07.75,Main-207-,,0,0,0,,Hayır, onu sormadım.Dialogue: 50,0:03:13.36,0:03:16.39,Main-207-,,0,0,0,,Haklısın.  Dağın tepesindeki şatodasın.Dialogue: 50,0:03:16.39,0:03:19.55,Main-207-,,0,0,0,,O zaman benimle birlikte iki kişi daha vardı değil mi?Dialogue: 50,0:03:19.55,0:03:22.69,Main-207-,,0,0,0,,Evet, gayet gürültülü bir şekilde yan odada uyuyorlar.Dialogue: 50,0:03:22.69,0:03:24.35,Main-207-,,0,0,0,,Amma dayanıklı gençler...Dialogue: 50,0:03:26.10,0:03:27.02,Main-207-,,0,0,0,,Şuraya bak.Dialogue: 50,0:03:28.23,0:03:30.31,Main-207-,,0,0,0,,Sebebi buydu.Dialogue: 50,0:03:30.31,0:03:31.90,Main-207-,,0,0,0,,Bu... bu ne?Dialogue: 50,0:03:32.79,0:03:35.33,Main-207-,,0,0,0,,Bir kestia tarafından ısırılmışsın.Dialogue: 50,0:03:35.33,0:03:39.12,Main-207-,,0,0,0,,Sıcak ve nemli ormanlarda bulunan çok zehirli bir kene türüdür.Dialogue: 50,0:03:39.12,0:03:42.81,Main-207-,,0,0,0,,Onun tarafından ısırılmışsın, vücuduna bakteri girmiş...Dialogue: 50,0:03:42.81,0:03:46.25,Main-207-,,0,0,0,,...ve 5 gün boyunca kuluçkaya yatmış. Sana bütün o acıyı çektiren buydu.Dialogue: 50,0:03:47.68,0:03:50.40,Main-207-,,0,0,0,,Yüksek ateş, çoklu enfeksiyon, miyokardit, arterit ve sebebrit...Dialogue: 50,0:03:50.43,0:03:53.15,Main-207-,,0,0,0,,...ile birlikte 40°'nin üzerinde ateş sıklıkla görülen etkileridir.Dialogue: 50,0:03:53.15,0:03:57.76,Main-207-,,0,0,0,,Enfeksiyonun yayılma durumuna bakarsak, üç gün önce ısırılmışsın diyebilirim.Dialogue: 50,0:03:58.74,0:04:01.65,Main-207-,,0,0,0,,Dayanılmaz bir acı çekmiş olmalısın.Dialogue: 50,0:04:01.65,0:04:04.96,Main-207-,,0,0,0,,Ama tedavi uygulamamış da olsaydım acısı iki güne biterdi.Dialogue: 50,0:04:04.96,0:04:06.72,Main-207-,,0,0,0,,İki güne mi..?Dialogue: 50,0:04:06.73,0:04:10.69,Main-207-,,0,0,0,,Evet, iki güne ölmüş olacaktın.Dialogue: 50,0:04:10.69,0:04:11.64,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:04:13.34,0:04:15.09,Main-207-,,0,0,0,,Buna "Beş Gün Hastalığı" denir.Dialogue: 50,0:04:15.09,0:04:18.85,Main-207-,,0,0,0,,Kestia türünün yüzyıl önce yok olduğunu duymuştum.Dialogue: 50,0:04:18.85,0:04:21.83,Main-207-,,0,0,0,,Ne olur ne olmaz diye antibiyotiği elimde tutmam iyi olmuş.Dialogue: 50,0:04:21.83,0:04:24.17,Main-207-,,0,0,0,,Siz çocuklar nereden geliyorsunuz?Dialogue: 50,0:04:24.17,0:04:28.50,Main-207-,,0,0,0,,Tarih öncesi bir adada beli açık mı geziyordunuz sakın?Dialogue: 50,0:04:30.07,0:04:32.88,Main-207-,,0,0,0,,Çünkü bu çok aptalca olurdu...Dialogue: 50,0:04:31.75,0:04:32.88,Secondary-207-,,0,0,0,,Ah...Dialogue: 50,0:04:35.25,0:04:37.42,Main-207-,,0,0,0,,Bir çağrışım yaptı mı?Dialogue: 50,0:04:37.42,0:04:39.43,Main-207-,,0,0,0,,Ne deli bir kız ama...Dialogue: 50,0:04:39.85,0:04:40.93,Main-207-,,0,0,0,,Şimdi...Dialogue: 50,0:04:41.65,0:04:45.79,Main-207-,,0,0,0,,Yatakta kalmaya devam et. Tedavin henüz tamamlanmadı.Dialogue: 50,0:04:45.79,0:04:49.33,Main-207-,,0,0,0,,Yardımların için çok teşekkürler. Ama ateşim çoktan düştü.Dialogue: 50,0:04:49.33,0:04:51.23,Main-207-,,0,0,0,,Buradan sonra kendim iyileşebilirim, değil mi?Dialogue: 50,0:04:51.23,0:04:53.40,Main-207-,,0,0,0,,Fazla iyimsersin.Dialogue: 50,0:04:53.40,0:04:58.03,Main-207-,,0,0,0,,Bu hastalığın tamamen geçmesi için olan tedavi süresi çoğunlukla on gündür.Dialogue: 50,0:04:58.03,0:05:03.20,Main-207-,,0,0,0,,Elbette, ateşinin çıkmasını ve bu sefer seni kesin olarak öldürmesini istemiyorsan.Dialogue: 50,0:05:03.20,0:05:07.10,Main-207-,,0,0,0,,Benim ilacımla bile en az üç gün dinlenmelisin.Dialogue: 50,0:05:07.10,0:05:07.79,Main-207-,,0,0,0,,Ne...?Dialogue: 50,0:05:07.79,0:05:09.50,Main-207-,,0,0,0,,Burada üç gün kalamam!Dialogue: 50,0:05:10.16,0:05:11.83,Main-207-,,0,0,0,,Vivi'nin yakın zamanda Arabasta'ya ulaşması gerekiyor!Dialogue: 50,0:05:14.67,0:05:18.36,Main-207-,,0,0,0,,Hasta benden sadece iki yolla ayrılabilir:Dialogue: 50,0:05:19.80,0:05:21.25,Main-207-,,0,0,0,,Ya iyileşir ya da ölür.Dialogue: 50,0:05:21.25,0:05:22.64,Main-207-,,0,0,0,,Buradan ayrılmayacaksın.Dialogue: 50,0:05:50.48,0:05:53.06,Flashbacks-207-,,0,0,0,,Bu dağı çıplak elleriyle mi tırmandı?!Dialogue: 50,0:05:53.06,0:05:55.79,Flashbacks-207-,,0,0,0,,Bu 5.000 metre yüksekliğindeki Drum kayasını?Dialogue: 50,0:05:57.76,0:06:00.16,Flashbacks-207-,,0,0,0,,Neredeyse bütün vücudu buz kesiği olmuş.Dialogue: 50,0:06:00.16,0:06:02.38,Flashbacks-207-,,0,0,0,,Bu şekilde giyinerek ne olacağını bekliyordu ki?Dialogue: 50,0:06:02.38,0:06:04.47,Flashbacks-207-,,0,0,0,,Onu hemen ılık bir duşa sok.Dialogue: 50,0:06:05.17,0:06:10.05,Flashbacks-207-,,0,0,0,,Bu adamda ciddi kanama var. Altı kırık kaburga ve bir omurilik çatlağı var.Dialogue: 50,0:06:10.05,0:06:11.43,Flashbacks-207-,,0,0,0,,Onu ameliyata alabilir miyim?Dialogue: 50,0:06:13.06,0:06:18.03,Flashbacks-207-,,0,0,0,,Bu kız birinci önceliğimiz. Neredeyse ölü.Dialogue: 50,0:06:18.03,0:06:22.36,Flashbacks-207-,,0,0,0,,Chopper, biraz fenikol, kardiyotonik ve tialcillin hazırla.Dialogue: 50,0:06:22.36,0:06:24.19,Flashbacks-207-,,0,0,0,,Enfeksiyonu var mı?Dialogue: 50,0:06:24.19,0:06:27.03,Flashbacks-207-,,0,0,0,,Evet ve patojenik bulgular bu adadan olmadığına işaret ediyor.Dialogue: 50,0:06:33.89,0:06:37.85,Flashbacks-207-,,0,0,0,,Endişelenme. Kanaması olan çocuk ile kızı iyileştireceğim.Dialogue: 50,0:06:37.85,0:06:38.88,Flashbacks-207-,,0,0,0,,Rahatlayabilirsin.Dialogue: 50,0:06:41.19,0:06:43.38,Flashbacks-207-,,0,0,0,,Odla benim arkadadlalım..!Dialogue: 50,0:06:49.19,0:06:51.92,Flashbacks-207-,,0,0,0,,Şimdi anladım. Onlara yardım edeceğim.Dialogue: 50,0:06:51.92,0:06:53.89,Flashbacks-207-,,0,0,0,,Chopper! Tedaviye başlayalım!Dialogue: 50,0:07:00.35,0:07:02.86,Flashbacks-207-,,0,0,0,,Od-odla be-be-benim  ar-ar-arkadadlalım..!Dialogue: 50,0:07:04.25,0:07:05.60,Main-207-,,0,0,0,,Ben...Dialogue: 50,0:07:06.86,0:07:09.08,Main-207-,,0,0,0,,Ben çok acıktım...Dialogue: 50,0:07:13.77,0:07:15.22,Main-207-,,0,0,0,,Et...Dialogue: 50,0:07:19.50,0:07:23.20,Main-207-,,0,0,0,,Geyik etli güveç üç saat boyunca tencerede pişirilmeli...Dialogue: 50,0:07:23.20,0:07:25.38,Main-207-,,0,0,0,,...o zaman et tamamen yumuşak hale gelir.Dialogue: 50,0:07:28.02,0:07:30.14,Main-207-,,0,0,0,,Geyik eti...Dialogue: 50,0:07:39.10,0:07:42.73,Main-207-,,0,0,0,,Ahhhh! Yardım edin!Dialogue: 50,0:07:44.72,0:07:45.70,Main-207-,,0,0,0,,Bekle, et!Dialogue: 50,0:07:51.36,0:07:53.49,Main-207-,,0,0,0,,Bekle Luffy, onu senin için pişireceğim!Dialogue: 50,0:08:01.62,0:08:02.86,Main-207-,,0,0,0,,Nami!Dialogue: 50,0:08:02.86,0:08:03.55,Main-207-,,0,0,0,,Nami-san!Dialogue: 50,0:08:03.89,0:08:05.34,Main-207-,,0,0,0,,Daha iyi misin?Dialogue: 50,0:08:05.34,0:08:06.63,Main-207-,,0,0,0,,Evet, teşekkürler.Dialogue: 50,0:08:06.63,0:08:10.14,Main-207-,,0,0,0,,Tamam o zaman! Nami-san için besleyici bir geyik eti yemeği yapacağım.Dialogue: 50,0:08:13.48,0:08:16.31,Main-207-,,0,0,0,,– Bekle! – Bekle!Dialogue: 50,0:08:18.49,0:08:21.62,Main-207-,,0,0,0,,Şaşırdım! Şimdiden hareket etmeye başladılar mı?Dialogue: 50,0:08:21.62,0:08:25.19,Main-207-,,0,0,0,,Mavi burunlu doldurulmuş ve konuşan geyik de neyin nesi?Dialogue: 50,0:08:25.19,0:08:26.78,Main-207-,,0,0,0,,Bana mı soruyorsun?Dialogue: 50,0:08:26.78,0:08:28.45,Main-207-,,0,0,0,,Koşma, et!Dialogue: 50,0:08:28.45,0:08:31.46,Main-207-,,0,0,0,,Bekle, Luffy! Sana henüz onu yiyemezsin diyorum!Dialogue: 50,0:08:34.74,0:08:36.29,Main-207-,,0,0,0,,Durun artık, insanlar!Dialogue: 50,0:08:36.29,0:08:40.17,Main-207-,,0,0,0,,Onun adı Chopper. O sadece mavi burunlu bir ren geyiği.Dialogue: 50,0:08:41.69,0:08:43.63,Main-207-,,0,0,0,,Ren geyikleri konuşamaz.Dialogue: 50,0:08:43.63,0:08:45.63,Secondary-207-,,0,0,0,,Be-bekleyin, salaklar!Dialogue: 50,0:08:45.63,0:08:49.09,Secondary-207-,,0,0,0,,Yeter, dur!Dialogue: 50,0:08:46.32,0:08:49.09,Main-207-,,0,0,0,,Eğer sıradan bir ren geyiğinden bir şekilde farklıysa...Dialogue: 50,0:08:49.59,0:08:51.09,Main-207-,,0,0,0,,Eğer farklıysa..?Dialogue: 50,0:08:54.31,0:08:56.82,Main-207-,,0,0,0,,Ben yemek değilim!Dialogue: 50,0:08:59.46,0:09:02.90,Main-207-,,0,0,0,,...farklı çünkü İnsan-İnsan Meyvesi yedi. Hepsi bu.Dialogue: 50,0:09:02.90,0:09:04.36,Main-207-,,0,0,0,,Bir İnsan-İnsan Meyvesi...Dialogue: 50,0:09:04.93,0:09:06.28,Main-207-,,0,0,0,,Bir şeytan meyvesi...Dialogue: 50,0:09:07.86,0:09:13.79,Main-207-,,0,0,0,,Evet. İnsan yeteneklerine sahip bir ren geyiğine dönüştü.Dialogue: 50,0:09:14.45,0:09:16.45,Main-207-,,0,0,0,,Fareler! Fareler!Dialogue: 50,0:09:17.07,0:09:22.21,Main-207-,,0,0,0,,Ben de ona tıbbi bilim ile ilgili bildiğim her şeyi öğrettim.Dialogue: 50,0:09:25.63,0:09:28.05,Main-207-,,0,0,0,,Bu ne ya, şimdiden bitti mi?Dialogue: 50,0:09:32.89,0:09:34.97,Main-207-,,0,0,0,,Ne büyük hayal kırıklığı.Dialogue: 50,0:09:36.60,0:09:38.39,Main-207-,,0,0,0,,– O neydi öyle?! – Müthiş...Dialogue: 50,0:09:40.56,0:09:41.77,Main-207-,,0,0,0,,Müthiş...Dialogue: 50,0:09:42.73,0:09:46.77,Main-207-,,0,0,0,,Tamamdır! Harika işti, Zoro! Tam olarak dediğim buydu!Dialogue: 50,0:09:48.90,0:09:50.36,Main-207-,,0,0,0,,Haydi Dalton-san'ı bulalım!Dialogue: 50,0:09:50.36,0:09:51.36,Main-207-,,0,0,0,,Evet!Dialogue: 50,0:09:53.74,0:09:55.07,Main-207-,,0,0,0,,Teşekkür ederiz!Dialogue: 50,0:09:57.03,0:09:58.99,Main-207-,,0,0,0,,Çabuk! Her yeri kazın!Dialogue: 50,0:10:00.50,0:10:03.67,Main-207-,,0,0,0,,Peki, bu saçmalık da neydi?Dialogue: 50,0:10:03.67,0:10:06.59,Main-207-,,0,0,0,,Boşver, sonra anlatırım! Şimdi onlara yardım edelim!Dialogue: 50,0:10:06.96,0:10:09.55,Main-207-,,0,0,0,,Dalton-san! Lütfen hayatta olun!Dialogue: 50,0:10:20.06,0:10:23.06,Main-207-,,0,0,0,,Benim tayfama katıl! Lütfen, yaşlı teyze!Dialogue: 50,0:10:23.06,0:10:25.02,Main-207-,,0,0,0,,Gemimizde bir doktora ihtiyacımız var!Dialogue: 50,0:10:25.02,0:10:28.52,Main-207-,,0,0,0,,Luffy! İsmin buydu, değil mi?Dialogue: 50,0:10:28.52,0:10:29.94,Main-207-,,0,0,0,,Evet, yaşlı te...Dialogue: 50,0:10:30.36,0:10:33.40,Main-207-,,0,0,0,,Söylediğine... dikkat et!Dialogue: 50,0:10:35.82,0:10:40.04,Main-207-,,0,0,0,,Gençliğimin baharında 130'larımdayım.Dialogue: 50,0:10:40.04,0:10:42.04,Main-207-,,0,0,0,,Vaay. Amma koca karıymış.Dialogue: 50,0:10:44.42,0:10:46.79,Main-207-,,0,0,0,,Benim bir korsan olmamı mı istiyorsun?Dialogue: 50,0:10:47.71,0:10:51.80,Main-207-,,0,0,0,,Saçmalama! Benim değerli zamanıma yazık olur.Dialogue: 50,0:10:51.80,0:10:54.26,Main-207-,,0,0,0,,Denizler benim ilgi alanım değil.Dialogue: 50,0:10:55.05,0:10:58.10,Main-207-,,0,0,0,,Kimin umurunda? Hadi gidip bir maceraya atılalım, yaşlı teyze!Dialogue: 50,0:10:58.39,0:11:02.06,Main-207-,,0,0,0,,Hey hey. Daha az önce ağzından çıkanı kulağın duysun dedim, değil mi?Dialogue: 50,0:11:02.89,0:11:04.77,Thoughts-207-,,0,0,0,,Yani onlar korsan...Dialogue: 50,0:11:11.69,0:11:14.53,Main-207-,,0,0,0,,Bekle, et!Dialogue: 50,0:11:12.74,0:11:14.53,Secondary-207-,,0,0,0,,Bekle!Dialogue: 50,0:11:17.74,0:11:19.66,Main-207-,,0,0,0,,Durun, sizi veletler!Dialogue: 50,0:11:27.17,0:11:28.63,Main-207-,,0,0,0,,Bekle!Dialogue: 50,0:11:28.63,0:11:32.21,Main-207-,,0,0,0,,Bekle, Nami-san! Besleyici bir ren geyiği yemeği pişireceğim!Dialogue: 50,0:11:33.59,0:11:37.34,Main-207-,,0,0,0,,Ondan önce, ben sizi yiyeceğim!Dialogue: 50,0:11:37.72,0:11:39.05,Main-207-,,0,0,0,,– Koca karı! – Koca karı!Dialogue: 50,0:11:39.05,0:11:40.89,Main-207-,,0,0,0,,O nereden geldi birden?!Dialogue: 50,0:11:41.47,0:11:41.72,Main-207-,,0,0,0,,Geliyor! Geliyor! Geliyor! Geliyor!Dialogue: 50,0:11:41.72,0:11:42.01,Main-207-,,0,0,0,,Geliyor! Geliyor! Geliyor! Geliyor!Dialogue: 50,0:11:42.01,0:11:42.31,Main-207-,,0,0,0,,Geliyor! Geliyor! Geliyor! Geliyor!Dialogue: 50,0:11:42.31,0:11:43.47,Main-207-,,0,0,0,,Geliyor! Geliyor! Geliyor! Geliyor!Dialogue: 50,0:11:47.73,0:11:51.27,Main-207-,,0,0,0,,Yemeği boşverin.  Biraz sessizlik ve huzur istiyorum sadece.Dialogue: 50,0:11:57.49,0:12:00.74,Main-207-,,0,0,0,,Kar mı? Şatonun içinde olsak bile mi?Dialogue: 50,0:12:01.45,0:12:02.20,Main-207-,,0,0,0,,Çok soğuk!Dialogue: 50,0:12:05.16,0:12:07.83,Main-207-,,0,0,0,,Kapıyı kapasam iyi olur.Dialogue: 50,0:12:06.16,0:12:07.83,Secondary-207-,,0,0,0,,Hey! Yatakta kal!Dialogue: 50,0:12:10.21,0:12:12.21,Main-207-,,0,0,0,,Hala ateşin var!Dialogue: 50,0:12:12.21,0:12:15.71,Main-207-,,0,0,0,,Hayır yok. Çoğunlukla gitti gibi duruyor.Dialogue: 50,0:12:15.71,0:12:17.22,Main-207-,,0,0,0,,Görünüşe göre kaçmayı başardım.Dialogue: 50,0:12:17.22,0:12:18.18,Main-207-,,0,0,0,,Öyle de olsa, hayır.Dialogue: 50,0:12:18.93,0:12:22.97,Main-207-,,0,0,0,,Doktorine'nin ilaçları ateşi hemen düşürür.Dialogue: 50,0:12:22.97,0:12:25.68,Main-207-,,0,0,0,,Ama kestia bakterisi hala vücudunda.Dialogue: 50,0:12:26.31,0:12:29.40,Main-207-,,0,0,0,,Antibiyotiklerini almalı ve yatakta kalmaya devam etmelisin.Dialogue: 50,0:12:30.65,0:12:31.77,Main-207-,,0,0,0,,Teşekkürler.Dialogue: 50,0:12:32.94,0:12:35.32,Main-207-,,0,0,0,,Benimle sen ilgileniyordun, değil mi?Dialogue: 50,0:12:35.82,0:12:36.69,Main-207-,,0,0,0,,Ka...Dialogue: 50,0:12:38.07,0:12:39.57,Main-207-,,0,0,0,,Kapa çeneni!Dialogue: 50,0:12:39.86,0:12:43.33,Main-207-,,0,0,0,,Bir insan tarafından minnet duyulmasını istemiyorum!Dialogue: 50,0:12:44.58,0:12:47.45,Main-207-,,0,0,0,,Dalga geçme benimle! Seni ahmak!Dialogue: 50,0:12:47.45,0:12:49.00,Main-207-,,0,0,0,,Salak olma, sersem!Dialogue: 50,0:12:50.08,0:12:52.25,Main-207-,,0,0,0,,Ciddiyim, çok da şey olma...Dialogue: 51,0:12:50.08,0:12:52.25,Main-207-,,0,0,0,,Ciddiyim, çok da şey olma...Dialogue: 50,0:12:52.25,0:12:55.05,Main-207-,,0,0,0,,İçi nasılsa dışı da öyle biri, değil mi?Dialogue: 50,0:12:59.63,0:13:03.51,Main-207-,,0,0,0,,Şato çok tuhaf. Çok soğuk ve her yerde kar var.Dialogue: 50,0:13:03.51,0:13:04.68,Main-207-,,0,0,0,,Oh...?Dialogue: 50,0:13:07.56,0:13:08.85,Main-207-,,0,0,0,,Ahhh! Çok soğuk!Dialogue: 50,0:13:08.85,0:13:11.02,Main-207-,,0,0,0,,Amma da rahat takılıyorsun!Dialogue: 50,0:13:16.86,0:13:18.03,Main-207-,,0,0,0,,Şuna bak.Dialogue: 50,0:13:24.62,0:13:27.04,Main-207-,,0,0,0,,Şatonun her yerinde kar var.Dialogue: 50,0:13:29.20,0:13:32.04,Main-207-,,0,0,0,,Kullanılmayan odaların da hepsi donmuş.Dialogue: 50,0:13:48.27,0:13:49.93,Main-207-,,0,0,0,,Bekle! Bekle! Bekle!Dialogue: 50,0:13:56.52,0:14:00.19,Main-207-,,0,0,0,,Hop hop hop! Hey, Luffy! Şu yaşlı karıya bize katılmayı sormayı bırak!Dialogue: 50,0:14:00.19,0:14:03.28,Main-207-,,0,0,0,,O bir doktor değil, o bir katil!Dialogue: 50,0:14:08.29,0:14:10.00,Main-207-,,0,0,0,,Sizler korsan mısınız?Dialogue: 50,0:14:10.00,0:14:10.87,Main-207-,,0,0,0,,Evet...Dialogue: 50,0:14:12.08,0:14:13.25,Main-207-,,0,0,0,,Gerçek korsanlar mı..?Dialogue: 50,0:14:13.25,0:14:14.67,Main-207-,,0,0,0,,Evet gerçek korsan.Dialogue: 50,0:14:14.67,0:14:16.25,Main-207-,,0,0,0,,Bayrağınızda kuru kafa var mı?Dialogue: 50,0:14:16.25,0:14:19.59,Main-207-,,0,0,0,,Gemimizde asılı. Korsanlara ilgi mi duyuyorsun?Dialogue: 50,0:14:19.92,0:14:22.05,Main-207-,,0,0,0,,Hayır! Salak! Hayır!Dialogue: 50,0:14:22.88,0:14:24.05,Main-207-,,0,0,0,,Salak mısın?!Dialogue: 50,0:14:26.18,0:14:28.01,Main-207-,,0,0,0,,Peki, peki. Özür dilerim. Pardon.Dialogue: 50,0:14:29.97,0:14:32.02,Main-207-,,0,0,0,,Tamam...ama...Dialogue: 50,0:14:33.06,0:14:33.98,Main-207-,,0,0,0,,...gelmek de istiyor musun?Dialogue: 50,0:14:34.40,0:14:35.73,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:14:35.73,0:14:38.19,Main-207-,,0,0,0,,Denize! Bizle neden gelmiyorsun?Dialogue: 50,0:14:38.57,0:14:39.57,Main-207-,,0,0,0,,Hm?Dialogue: 50,0:14:39.57,0:14:41.90,Main-207-,,0,0,0,,Gelirsen, bana çok yardımı olur.Dialogue: 50,0:14:41.90,0:14:45.57,Main-207-,,0,0,0,,Gemide bir doktor olursa, burada üç gün kalmama gerek olmaz, değil mi?Dialogue: 50,0:14:45.57,0:14:47.24,Main-207-,,0,0,0,,Hepsinden öte, gemimizde, bizim de bir dok–Dialogue: 50,0:14:47.24,0:14:48.83,Main-207-,,0,0,0,,Saçmalama!Dialogue: 50,0:14:49.24,0:14:50.70,Main-207-,,0,0,0,,Ben bir ren geyiğiyim!Dialogue: 50,0:14:50.70,0:14:53.66,Main-207-,,0,0,0,,İnsanlarla yaşamamın hiçbir yolu yok!Dialogue: 50,0:14:55.62,0:14:59.17,Main-207-,,0,0,0,,Şöyle bir baktığında, beni görünce korkmuyor musun?Dialogue: 50,0:14:59.17,0:15:03.63,Main-207-,,0,0,0,,Ben bir ren geyiğiyim ama iki ayağımın üzerinde duruyor ve konuşuyorum.Dialogue: 50,0:15:04.84,0:15:07.76,Main-207-,,0,0,0,,Ne? Beni korkutmaya mı çalışıyorsun?Dialogue: 50,0:15:10.18,0:15:11.39,Main-207-,,0,0,0,,Ayrıca burnum da mavi...Dialogue: 50,0:15:21.61,0:15:22.82,Main-207-,,0,0,0,,İşte buradasın!Dialogue: 50,0:15:23.36,0:15:24.61,Main-207-,,0,0,0,,Ren geyiği!Dialogue: 50,0:15:26.03,0:15:27.32,Main-207-,,0,0,0,,– Bekle! – Bekle!Dialogue: 50,0:15:32.74,0:15:34.33,Main-207-,,0,0,0,,Şu veletler gerçekten de hızlı.Dialogue: 50,0:15:37.54,0:15:39.75,Main-207-,,0,0,0,,Senin yaptığını da beğenmedim.Dialogue: 50,0:15:39.75,0:15:40.75,Main-207-,,0,0,0,,Ne?Dialogue: 50,0:15:40.75,0:15:44.51,Main-207-,,0,0,0,,Ren geyiğini kışkırtma iznini sana kim verdi?Dialogue: 50,0:15:44.51,0:15:48.14,Main-207-,,0,0,0,,Oh? Bir adamın istediğini yapmasına yardım etmek için senin iznini mi almam gerek?Dialogue: 50,0:15:49.60,0:15:53.22,Main-207-,,0,0,0,,Hayır yok. Eğer öyle istiyorsan, önden buyur.Dialogue: 50,0:15:53.22,0:15:55.81,Main-207-,,0,0,0,,Ama kolay olmayacaktır.Dialogue: 50,0:15:56.23,0:16:01.23,Main-207-,,0,0,0,,Kalbinde kocaman bir yara var. Benim bile tedavi edemeyeceğim türden bir yara.Dialogue: 50,0:16:01.23,0:16:05.32,Main-207-,,0,0,0,,Bu dünyaya geldiğinde, sürüsü ve ailesi onu terk etti.Dialogue: 50,0:16:05.32,0:16:06.07,Main-207-,,0,0,0,,Ne?Dialogue: 50,0:16:07.32,0:16:09.66,Main-207-,,0,0,0,,Tek sebebi burnunun mavi olmasıydı.Dialogue: 50,0:16:09.99,0:16:14.87,Main-207-,,0,0,0,,Kendisi her zaman sürünün en sonundan yürürdü.Dialogue: 50,0:16:14.87,0:16:17.12,Main-207-,,0,0,0,,Hem de bir yeni doğan olmasına rağmen.Dialogue: 50,0:16:17.46,0:16:23.09,Main-207-,,0,0,0,,Şeytan meyvesini yedikten sonra, ona tamamen bir canavarmış gibi davranıldı.Dialogue: 50,0:16:35.56,0:16:38.64,Main-207-,,0,0,0,,Diğer geyikler onu sürüden dışladı.Dialogue: 50,0:16:39.19,0:16:43.82,Main-207-,,0,0,0,,Artık sıradan bir geyik olarak  sürüye dönmesinin bir yolu yoktu.Dialogue: 50,0:16:44.32,0:16:47.40,Main-207-,,0,0,0,,Yine de, arkadaş edinmek istedi...Dialogue: 50,0:16:47.40,0:16:50.32,Main-207-,,0,0,0,,Bu yüzden bir köye gitti, bu sefer bir insan olarak.Dialogue: 50,0:16:51.07,0:16:53.62,Flashbacks-207-,,0,0,0,,Hey! O yaratık da neyin nesi?!Dialogue: 50,0:16:53.62,0:16:57.87,Main-207-,,0,0,0,,Ama görünüşü tam bir  insan gibi de değildi.Dialogue: 50,0:16:57.87,0:17:01.08,Main-207-,,0,0,0,,Bir sebepten ötürü, burnu insan formunda da mavi kaldı.Dialogue: 50,0:17:01.08,0:17:02.58,Flashbacks-207-,,0,0,0,,Bu bir yeti olmalı!Dialogue: 50,0:17:02.58,0:17:05.63,Flashbacks-207-,,0,0,0,,Çok tehlikeli! Çabuk çocukları içeri sokun!Dialogue: 50,0:17:07.38,0:17:09.05,Flashbacks-207-,,0,0,0,,Silah! Bana bir silah getirin!Dialogue: 50,0:17:09.05,0:17:10.09,Flashbacks-207-,,0,0,0,,Öldürene kadar sıkın!Dialogue: 50,0:17:10.09,0:17:11.43,Flashbacks-207-,,0,0,0,,Seni pis yaratık!Dialogue: 50,0:17:11.43,0:17:13.05,Flashbacks-207-,,0,0,0,,Uzaklaş!Dialogue: 50,0:17:30.57,0:17:33.20,Main-207-,,0,0,0,,Neyi yanlış yaptığını bilmiyordu...Dialogue: 50,0:17:33.20,0:17:36.16,Main-207-,,0,0,0,,...veya kimi suçlayacağını.Dialogue: 50,0:17:36.41,0:17:38.25,Flashbacks-207-,,0,0,0,,Lanet canavar!!Dialogue: 50,0:17:38.25,0:17:40.12,Flashbacks-207-,,0,0,0,,Lanet canavar!!Dialogue: 50,0:17:40.12,0:17:44.71,Main-207-,,0,0,0,,Tek istediği arkadaş edinmekti ama tek elde ettiği canavar damgası oldu.Dialogue: 50,0:17:45.17,0:17:47.80,Main-207-,,0,0,0,,Artık bir ren geyiği değildi.Dialogue: 50,0:17:47.80,0:17:49.13,Main-207-,,0,0,0,,Bir insan da değildi.Dialogue: 50,0:17:50.97,0:17:55.35,Main-207-,,0,0,0,,Bu yüzden, yalnız yaşamak zorunda kaldı.Dialogue: 50,0:17:56.39,0:18:00.06,Main-207-,,0,0,0,,Siz çocuklar, onun kalbindeki yarayı iyileştirebilir misiniz?Dialogue: 50,0:18:02.48,0:18:07.07,Main-207-,,0,0,0,,Hey, Luffy. Şu girişteki kapıya bak. Sonuna kadar açık.Dialogue: 50,0:18:11.99,0:18:13.36,Main-207-,,0,0,0,,Neden soğuk olduğuna şaşmamalı.Dialogue: 50,0:18:13.36,0:18:15.20,Main-207-,,0,0,0,,Her halükarda, kapıyı kapatalım.Dialogue: 50,0:18:15.20,0:18:18.04,Main-207-,,0,0,0,,Yoksa ha içerideyiz ha dışarıda.Dialogue: 50,0:18:18.49,0:18:21.37,Main-207-,,0,0,0,,Hey! Durun! Sakın o kapıya dokunmayın!Dialogue: 50,0:18:24.08,0:18:27.00,Main-207-,,0,0,0,,Dediğini boşver. Kapatalım yoksa burada donarak öleceğiz.Dialogue: 50,0:18:27.00,0:18:27.84,Main-207-,,0,0,0,,Kesinlikle.Dialogue: 50,0:18:28.34,0:18:30.80,Main-207-,,0,0,0,,Hey! Ben size sakın o kapıya...Dialogue: 50,0:18:31.21,0:18:32.38,Main-207-,,0,0,0,,dokunmayın demedim mi?!Dialogue: 50,0:18:37.72,0:18:41.18,Main-207-,,0,0,0,,Onun nesi var? Neden sinirlendi?Dialogue: 50,0:18:43.19,0:18:45.90,Main-207-,,0,0,0,,Hey, Luffy. Buraya gel.Dialogue: 50,0:18:52.61,0:18:53.70,Main-207-,,0,0,0,,Yukarıya bak.Dialogue: 50,0:19:02.45,0:19:06.54,Main-207-,,0,0,0,,Yeni doğmuş kar ispinozları. Eğer kapıyı kapatırsak, düşerler.Dialogue: 50,0:19:07.17,0:19:09.50,Main-207-,,0,0,0,,Bu yüzden kapatamıyorlar.Dialogue: 50,0:19:20.93,0:19:22.64,Main-207-,,0,0,0,,– Çok soğuk! – Çok soğuk!Dialogue: 50,0:19:24.94,0:19:26.40,Main-207-,,0,0,0,,Bekle bir saniye.Dialogue: 50,0:19:26.40,0:19:27.44,Main-207-,,0,0,0,,Ne oldu?Dialogue: 50,0:19:26.73,0:19:27.44,Secondary-207-,,0,0,0,,Ah!Dialogue: 50,0:19:28.15,0:19:30.27,Main-207-,,0,0,0,,Az önce konuşuyor muydu o?Dialogue: 50,0:19:30.69,0:19:33.32,Main-207-,,0,0,0,,Şimdi farkettim de, bir de iki ayağının üzerinde duruyordu.Dialogue: 50,0:19:35.61,0:19:37.53,Main-207-,,0,0,0,,– O BİR CANAVAR!!! – O BİR CANAVAR!!!Dialogue: 50,0:19:39.66,0:19:41.49,Main-207-,,0,0,0,,O-o nasıl bir şey öyle?Dialogue: 50,0:19:42.16,0:19:44.20,Main-207-,,220,1,0,,İki ayağının üzerinde yürüyor...Dialogue: 50,0:19:44.20,0:19:45.21,Main-207-,,10,200,0,,Ren geyiği...Dialogue: 50,0:19:45.21,0:19:45.91,Main-207-,,200,10,0,,Kabarık tüylü...Dialogue: 50,0:19:45.91,0:19:46.87,Main-207-,,1,0,0,,Kısacık...Dialogue: 50,0:19:46.87,0:19:48.92,Main-207-,,200,1,0,,Ve kocaman oldu...Dialogue: 50,0:19:48.92,0:19:50.96,Main-207-,,0,0,0,,– Ve bir canavar! – Ve bir canavar!Dialogue: 50,0:20:05.35,0:20:07.89,Main-207-,,0,0,0,,Çoook havalı! Ona bayıldım!Dialogue: 50,0:20:08.19,0:20:12.11,Main-207-,,0,0,0,,Sanji! Hadi onu tayfamıza katalım!Dialogue: 0,0:01:49.96,0:01:53.30,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Zyrecon thx to onepace.netDialogue: 0,0:10:13.00,0:10:21.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Zyrecon thx to onepace.netDialogue: 0,0:20:00.00,0:20:06.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Zyrecon thx to onepace.netDialogue: 0,0:01:49.96,0:01:53.30,Title-207-,,0,0,290,,Tony Tony ChopperDialogue: 1,0:01:49.96,0:01:53.30,Title-207-,,0,0,290,,Tony Tony ChopperDialogue: 0,0:00:01.73,0:00:03.73,Credits-207-,,0,0,0,,Video EditingDialogue: 1,0:00:01.73,0:00:03.73,Credits-207-,,0,0,0,,Video EditingDialogue: 0,0:00:01.73,0:00:03.73,Credits-207-,,0,0,0,,Galaxy 9000 GigglebotDialogue: 1,0:00:01.73,0:00:03.73,Credits-207-,,0,0,0,,Galaxy 9000 GigglebotDialogue: 0,0:00:03.73,0:00:05.73,Credits-207-,,0,0,0,,TimingDialogue: 1,0:00:03.73,0:00:05.73,Credits-207-,,0,0,0,,TimingDialogue: 0,0