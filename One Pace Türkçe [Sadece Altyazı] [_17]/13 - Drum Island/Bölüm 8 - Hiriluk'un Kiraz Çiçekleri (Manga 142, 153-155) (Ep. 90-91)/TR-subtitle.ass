[Script Info]Title: Default Aegisub fileScriptType: v4.00+WrapStyle: 0ScaledBorderAndShadow: yesLayoutResX: 1440LayoutResY: 1080YCbCr Matrix: TV.709PlayResX: 1440PlayResY: 1080[V4+ Styles]Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, EncodingStyle: Credits-207-,FOT-Greco Std B Strp,50,&H00FFFFFF,&H00002EFF,&H00000000,&H00000000,-1,0,0,0,95,100,1.6,0,1,3,0,7,16,16,16,1Style: Title-207-,Gilroy,90.0,&H00FEFEFE,&H00002EFF,&H00000000,&H00000000,-1,0,0,0,100,100,0,0,1,2.2,0,2,23,23,383,1Style: Main-207-,Impress BT Pace,73.0,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.0,3.0,2,180,180,27,1Style: Thoughts-207-,Impress BT Pace,73.0,&H00FFFFFF,&H00FFFFFF,&H00525252,&H78000000,0,0,0,0,100,100,0,0,1,3.5,3.0,2,180,180,27,1Style: Flashbacks-207-,Impress BT Pace,73.0,&H00FFFFFF,&H00FFFFFF,&H00525252,&H78000000,0,-1,0,0,100,100,0,0,1,3.0,3.0,2,180,180,27,1Style: Captions-207-,Gilroy,75.0,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,-1,0,0,0,100,100,0,0,1,3.5,0,2,16,16,27,1Style: Note-207-,Impress BT Pace,50.0,&H00FFFFFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,3.75,3.75,8,180,180,27,1Style: Secondary-207-,Impress BT Pace,73.0,&H00D6D6D6,&H00FFFFFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.0,3.0,2,180,180,27,1Style: Author,Impress BT,28.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1,1,9,10,10,10,1Style: Attack,Duality,50.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.7,1.7,7,12,12,12,1Style: RogerMonologue,Impress BT Pace,73.0,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.0,3.0,2,180,180,27,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 50,0:01:55.22,0:01:56.01,Main-207-,,0,0,0,,Nami!Dialogue: 50,0:01:56.72,0:01:59.68,Main-207-,,0,0,0,,İyi olduğuna emin misin?Dialogue: 50,0:02:00.81,0:02:02.64,Main-207-,,0,0,0,,Evet iyiyim! Harika hissediyorum!Dialogue: 50,0:02:02.64,0:02:07.77,Main-207-,,0,0,0,,Hey, hadi doktor nine ve palamut dedeye hoşçakal diyelim.Dialogue: 50,0:02:07.77,0:02:09.14,Main-207-,,0,0,0,,Aptal olma.Dialogue: 50,0:02:09.14,0:02:11.36,Main-207-,,0,0,0,,Ona ve Doktorine'e biraz zaman ver.Dialogue: 50,0:02:03.23,0:02:06.44,Secondary-207-,,0,0,0,,Oldu! Gelişimizin anısına sizlere...Dialogue: 50,0:02:06.44,0:02:08.65,Secondary-207-,,0,0,0,,...Kar Kraliçesi V'i takdim ediyorum!Dialogue: 50,0:02:08.65,0:02:11.36,Secondary-207-,,0,0,0,,Hey! Kar Kraliçesi V'e tekme atmaya nasıl cürret edersin!Dialogue: 50,0:02:11.36,0:02:12.95,Secondary-207-,,0,0,0,,Davranışlarına dikkat et!Dialogue: 50,0:02:11.74,0:02:14.57,Main-207-,,0,0,0,,Onunla altı yıl boyunca birlikte yalnız yaşadı.Dialogue: 50,0:02:14.57,0:02:17.33,Main-207-,,0,0,0,,Eminim göz yaşlarına  boğulacağı bir veda olacaktır.Dialogue: 50,0:02:17.95,0:02:22.83,Main-207-,,0,0,0,,Doktorine sert görünebilir ama kalbi aslında yumuşacık.Dialogue: 50,0:02:23.54,0:02:24.83,Main-207-,,0,0,0,,Cidden mi?Dialogue: 50,0:02:24.83,0:02:28.34,Main-207-,,0,0,0,,Yani, tek bir kelime bile  etmeden direk ayrılıyoruz, he?Dialogue: 50,0:02:28.34,0:02:29.59,Main-207-,,0,0,0,,Doğru.Dialogue: 50,0:02:29.59,0:02:34.05,Main-207-,,0,0,0,,Chopper geri döndüğünde, dağdan ineceğiz ve  derhal Arabasta'ya yelken açacağız!Dialogue: 50,0:02:34.05,0:02:36.51,Main-207-,,0,0,0,,Senin için de tamam mıdır, Vivi?Dialogue: 50,0:02:36.51,0:02:39.26,Main-207-,,0,0,0,,Tabii, eğer doktor da bizimle geliyorsa...Dialogue: 50,0:02:39.26,0:02:39.97,Main-207-,,0,0,0,,Doktor mu?Dialogue: 50,0:02:39.97,0:02:43.18,Main-207-,,0,0,0,,Peki o halde. Ben teleferiği hazır edeyim.Dialogue: 50,0:02:43.56,0:02:45.44,Main-207-,,0,0,0,,Hey, Luffy.  Bana bir el at.Dialogue: 50,0:02:45.44,0:02:47.65,Main-207-,,0,0,0,,Vaay, teleferik mi var?!Dialogue: 50,0:02:47.65,0:02:50.78,Main-207-,,0,0,0,,Bu harika!Dialogue: 50,0:03:00.37,0:03:01.49,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:03:01.49,0:03:04.00,Main-207-,,0,0,0,,Görünüşe bakılırsa  bazı hastalar eksik.Dialogue: 50,0:03:04.50,0:03:05.83,Main-207-,,0,0,0,,Kaçtılar...Dialogue: 50,0:03:06.46,0:03:09.29,Main-207-,,0,0,0,,...senin emirlerini göz ardı ederek.Dialogue: 50,0:03:09.71,0:03:12.30,Main-207-,,0,0,0,,Anlıyorum... Baş belası veletler.Dialogue: 50,0:03:22.31,0:03:23.77,Main-207-,,0,0,0,,Doktorine!Dialogue: 50,0:03:25.35,0:03:26.94,Main-207-,,0,0,0,,Doktorine!Dialogue: 50,0:03:28.69,0:03:30.52,Main-207-,,0,0,0,,Seninle konuşmam gerek!Dialogue: 50,0:03:31.27,0:03:33.90,Main-207-,,0,0,0,,Chopper, nerelerdeydin?Dialogue: 50,0:03:33.90,0:03:37.16,Main-207-,,0,0,0,,Merdivenlerden aşağı in de  topların hazırlanmasına yardım et.Dialogue: 50,0:03:37.16,0:03:40.41,Main-207-,,0,0,0,,Dinle Doktorine! Ben bir korsan olacağım.Dialogue: 50,0:03:40.41,0:03:41.99,Main-207-,,0,0,0,,Onlarla birlikte gidiyorum.Dialogue: 50,0:03:42.37,0:03:43.66,Main-207-,,0,0,0,,Ne!?Dialogue: 50,0:03:43.66,0:03:45.25,Main-207-,,0,0,0,,Denizlere açılıyorum!Dialogue: 50,0:03:45.25,0:03:49.42,Main-207-,,0,0,0,,Gemilerinin doktoru olacağım  ve dünyayı gezeceğim!Dialogue: 50,0:03:49.42,0:03:51.29,Main-207-,,0,0,0,,Bu tam bir saçmalık!Dialogue: 50,0:03:52.00,0:03:56.09,Main-207-,,0,0,0,,Dinle beni.  Sen benim bir ve tek asistanımsın!Dialogue: 50,0:03:56.09,0:03:59.01,Main-207-,,0,0,0,,Sana tıbbı kimin  öğrettiğini unuttun mu yoksa?Dialogue: 50,0:03:59.01,0:04:02.47,Main-207-,,0,0,0,,Gerçekten bu kadar nankör müsün?Dialogue: 50,0:04:02.47,0:04:04.77,Main-207-,,0,0,0,,Ö-öyle değil..!Dialogue: 50,0:04:04.77,0:04:06.93,Main-207-,,0,0,0,,Sana gerçekten minnettarım, Doktorine.Dialogue: 50,0:04:07.31,0:04:11.27,Main-207-,,0,0,0,,Beni sen ve Doktor ile tanıştıran bu ülkeyi her zaman seveceğim.Dialogue: 50,0:04:12.44,0:04:14.44,Main-207-,,0,0,0,,O halde burada kal.Dialogue: 50,0:04:14.44,0:04:19.20,Main-207-,,0,0,0,,Bu kadar gösterişli bir şatoda yaşamak için  bir daha asla böyle bir fırsat bulamayacaksın.Dialogue: 50,0:04:19.66,0:04:21.78,Main-207-,,0,0,0,,Korsanlar ölümden başka şey getirmez.Dialogue: 50,0:04:21.78,0:04:24.58,Main-207-,,0,0,0,,Kısa sürede anında ölürsün.Dialogue: 50,0:04:24.58,0:04:26.20,Main-207-,,0,0,0,,Benim için sorun değil!Dialogue: 50,0:04:27.33,0:04:29.29,Main-207-,,0,0,0,,Kendini beğenmişlik yapma!Dialogue: 50,0:04:29.29,0:04:32.92,Main-207-,,0,0,0,,Bir ren geyiğinin denizlere açıldığı nerede görülmüş?Dialogue: 50,0:04:32.92,0:04:34.59,Main-207-,,0,0,0,,Bu doğru! Ben bir ren geyiğiyim!Dialogue: 50,0:04:34.59,0:04:35.38,Main-207-,,0,0,0,,Ama...Dialogue: 50,0:04:35.38,0:04:36.34,Main-207-,,0,0,0,,Ayrıca bir adamım da!Dialogue: 50,0:04:42.80,0:04:44.43,Main-207-,,0,0,0,,Çok büyük konuşuyorsun...Dialogue: 50,0:04:44.43,0:04:46.77,Main-207-,,0,0,0,,Durum her ne olursa olsun, izin vermiyorum.Dialogue: 50,0:04:46.77,0:04:50.44,Main-207-,,0,0,0,,Ayrılmayı o kadar da çok istiyorsan, önce beni geçmen gerek!Dialogue: 50,0:04:51.77,0:04:52.61,Main-207-,,0,0,0,,Doktorine...Dialogue: 50,0:04:56.73,0:04:59.90,Main-207-,,0,0,0,,Senin gibi ağlak bir bebe mi adammış?Dialogue: 50,0:05:00.66,0:05:02.41,Main-207-,,0,0,0,,Güldürme beni!Dialogue: 50,0:05:03.20,0:05:04.66,Main-207-,,0,0,0,,Doktorine...Dialogue: 50,0:05:04.66,0:05:06.37,Main-207-,,0,0,0,,Ama onlar...Dialogue: 50,0:05:06.37,0:05:07.33,Flashbacks-207-,,0,0,0,,Kes sesini!Dialogue: 50,0:05:07.33,0:05:09.96,Flashbacks-207-,,0,0,0,,Hadi gidelim!Dialogue: 50,0:05:11.33,0:05:12.42,Main-207-,,0,0,0,,..anladım.Dialogue: 50,0:05:12.42,0:05:13.63,Main-207-,,0,0,0,,Kes sesini!Dialogue: 50,0:05:15.42,0:05:17.76,Main-207-,,0,0,0,,Gitmene izin vermeyeceğim!Dialogue: 50,0:05:26.14,0:05:29.35,Main-207-,,0,0,0,,Geri gel, Chopper!Dialogue: 50,0:05:30.73,0:05:32.94,Main-207-,,0,0,0,,Bekle!Dialogue: 50,0:05:34.90,0:05:36.52,Main-207-,,0,0,0,,Bu kargaşa da neyin nesi?Dialogue: 50,0:05:36.52,0:05:38.65,Main-207-,,0,0,0,,Eh, her ne oluyorsa...Dialogue: 50,0:05:38.65,0:05:42.03,Main-207-,,0,0,0,,...bu topları bir an önce şatonun  dışına götürmemiz en iyisi.Dialogue: 50,0:05:42.03,0:05:45.16,Main-207-,,0,0,0,,Yoksa Dr. Kureha önce  bizi şişlemeye gelecek.Dialogue: 50,0:05:45.16,0:05:46.58,Main-207-,,0,0,0,,Aptal olma!Dialogue: 50,0:05:46.58,0:05:48.24,Main-207-,,0,0,0,,Bekle!Dialogue: 50,0:05:48.24,0:05:50.71,Main-207-,,0,0,0,,Gitmene izin vermeyeceğim!Dialogue: 50,0:05:50.71,0:05:53.29,Main-207-,,0,0,0,,Chopper!Dialogue: 50,0:05:53.29,0:05:55.04,Main-207-,,0,0,0,,Geri gel buraya!Dialogue: 50,0:05:56.54,0:05:59.26,Main-207-,,0,0,0,,Tüm bu gürültü de ne? Şatodan geliyor.Dialogue: 50,0:05:59.26,0:06:01.42,Main-207-,,0,0,0,,Hadi ama.  Biraz nezaket gösterin.Dialogue: 50,0:06:01.42,0:06:05.72,Main-207-,,0,0,0,,Diğerleri veda ederken  biraz sessiz olamazlar mı?Dialogue: 50,0:06:07.43,0:06:11.43,Thoughts-207-,,0,0,0,,Özür dilerim, Doktorine ama dünyayı görmek istiyorum!Dialogue: 50,0:06:17.57,0:06:20.57,Main-207-,,0,0,0,,Senin gibi biri denizlerde neyi başarmayı hedefliyor olabilir ki?Dialogue: 50,0:06:20.94,0:06:24.03,Main-207-,,0,0,0,,O şarlatan gibi sen de boş bir hayal  üzerine mi hayat kurmak istiyorsun?Dialogue: 50,0:06:25.99,0:06:27.03,Main-207-,,0,0,0,,Yanılıyorsun!Dialogue: 50,0:06:27.03,0:06:28.66,Main-207-,,0,0,0,,O boş bir hayal değildi!Dialogue: 50,0:06:28.66,0:06:32.46,Main-207-,,0,0,0,,Doktor'un araştırması tamamlanmıştı!Dialogue: 50,0:06:32.83,0:06:34.33,Main-207-,,0,0,0,,Hey, o geliy–Dialogue: 50,0:06:35.67,0:06:36.67,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:06:37.04,0:06:38.13,Main-207-,,0,0,0,,Ne oluyor?!Dialogue: 50,0:06:38.13,0:06:39.88,Main-207-,,0,0,0,,Biri onu kovalıyor!Dialogue: 50,0:06:40.50,0:06:41.51,Main-207-,,0,0,0,,Hey!Dialogue: 50,0:06:41.51,0:06:43.42,Main-207-,,0,0,0,,Hey teleferik haz–Dialogue: 50,0:06:44.72,0:06:46.14,Main-207-,,0,0,0,,Herkes kızağa atlasın!Dialogue: 50,0:06:46.14,0:06:48.14,Main-207-,,0,0,0,,Sizi dağdan aşağı indireceğim!Dialogue: 50,0:06:51.93,0:06:53.68,Main-207-,,0,0,0,,– Ne?! – Ne?!Dialogue: 50,0:07:00.78,0:07:02.15,Main-207-,,0,0,0,,Hey, şuraya bakın!Dialogue: 50,0:07:02.15,0:07:03.95,Main-207-,,0,0,0,,O şey de neyin nesi?Dialogue: 50,0:07:06.03,0:07:07.49,Main-207-,,0,0,0,,Bu cadının kızağı!Dialogue: 50,0:07:59.33,0:08:01.00,Main-207-,,0,0,0,,O da neydi?!Dialogue: 50,0:08:01.00,0:08:03.09,Main-207-,,0,0,0,,Dr. Kureha'nın ren geyiği!Dialogue: 50,0:08:03.09,0:08:05.30,Main-207-,,0,0,0,,Ve o korsanlar da kızağın içindeydi!Dialogue: 50,0:08:05.30,0:08:07.17,Main-207-,,0,0,0,,Ne oldu ki yukarıda?!Dialogue: 50,0:08:07.17,0:08:08.59,Main-207-,,0,0,0,,Wapol ne alemde?Dialogue: 50,0:08:08.59,0:08:10.68,Main-207-,,0,0,0,,Dalton-san iyi mi?!Dialogue: 50,0:08:14.68,0:08:18.31,Main-207-,,0,0,0,,Bu çok eğlenceliydi!  Haydi bir daha yapalım!Dialogue: 50,0:08:18.31,0:08:20.15,Main-207-,,0,0,0,,Artık yelken açıyoruz, moronlar!Dialogue: 50,0:08:20.15,0:08:22.02,Main-207-,,0,0,0,,Bu sefer kesin gittim sandım...Dialogue: 50,0:08:22.02,0:08:24.19,Main-207-,,0,0,0,,Ha? Neredeyim ben?!Dialogue: 50,0:08:24.19,0:08:27.65,Main-207-,,0,0,0,,Oh, Sanji-san! Uyandın mı?Dialogue: 50,0:08:32.12,0:08:34.99,Main-207-,,0,0,0,,Bu şekilde veda etmen iyi olacak mı?Dialogue: 50,0:08:38.21,0:08:40.71,Main-207-,,0,0,0,,Bakıcılığını yaptığım evcil hayvan sonunda birileri...Dialogue: 50,0:08:40.74,0:08:43.09,Main-207-,,0,0,0,,...tarafından sahiplenildi. Olan bu kadar basit.Dialogue: 50,0:08:45.42,0:08:48.42,Main-207-,,0,0,0,,Özlü veda hayranı değilimdir.Dialogue: 50,0:08:55.06,0:08:56.31,Main-207-,,0,0,0,,Haydi gel!Dialogue: 50,0:08:55.43,0:08:56.31,Secondary-207-,,0,0,0,,Of!Dialogue: 50,0:08:56.31,0:08:59.85,Main-207-,,0,0,0,,Hatırlaması şan olan bir  uğurlama hazırlayalım.Dialogue: 50,0:08:59.85,0:09:01.15,Main-207-,,0,0,0,,Oyy...Dialogue: 50,0:09:03.44,0:09:05.73,Flashbacks-207-,,0,0,0,,En sonunda... İşte bu!Dialogue: 50,0:09:05.73,0:09:09.11,Flashbacks-207-,,0,0,0,,Bu reaksiyon...  otuz yıl boyunca bunu bekledim.Dialogue: 50,0:09:09.57,0:09:12.74,Thoughts-207-,,0,0,0,,Doktor! bu sadece bir  hayal değildi, değil mi?!Dialogue: 50,0:09:12.74,0:09:15.99,Thoughts-207-,,0,0,0,,O zaman, araştırman gerçekten  tamamlanmıştı, değil mi?!Dialogue: 50,0:09:16.91,0:09:19.54,Thoughts-207-,,0,0,0,,Yoksa o da bir yalan mıydı?Dialogue: 50,0:09:19.54,0:09:21.29,Flashbacks-207-,,0,0,0,,Başardım, Chopper!Dialogue: 50,0:09:21.29,0:09:23.50,Flashbacks-207-,,0,0,0,,Araştırmamı nihayet tamamladım!Dialogue: 50,0:09:23.50,0:09:27.51,Thoughts-207-,,0,0,0,,Bilmelisin ki, eğer başarmamış olsaydın  bu yükün altında çoktan ezilmiştim!Dialogue: 50,0:09:27.51,0:09:30.26,Thoughts-207-,,0,0,0,,Kafatası bayrağını kaldıran biri için  hiçbir şey imkansız değildir!Dialogue: 50,0:09:30.26,0:09:32.47,Thoughts-207-,,0,0,0,,Keşke şunu senin ağzından bir  kere daha duyabilseydim, Doktor!Dialogue: 50,0:09:37.14,0:09:39.43,Main-207-,,0,0,0,,Hazır mısınız, gençler?!Dialogue: 50,0:09:39.43,0:09:40.48,Main-207-,,0,0,0,,– Evet, Hanımefendi! – Evet, Hanımefendi!Dialogue: 50,0:09:40.48,0:09:41.81,Main-207-,,0,0,0,,Ateş!Dialogue: 50,0:09:42.65,0:09:45.31,Flashbacks-207-,,0,0,0,,Dinle, Kureha. Bu toz...Dialogue: 50,0:09:50.03,0:09:52.28,Main-207-,,0,0,0,,Dr. Kureha! Sen ne–Dialogue: 50,0:09:52.28,0:09:53.86,Main-207-,,0,0,0,,Bi' kes de izle.Dialogue: 50,0:09:59.37,0:10:01.16,Main-207-,,0,0,0,,Sesler şatodan geliyor!Dialogue: 50,0:10:01.16,0:10:03.42,Main-207-,,0,0,0,,Ha?  Wapol havai fişek mi fırlatıyor?Dialogue: 50,0:10:03.42,0:10:05.13,Main-207-,,0,0,0,,Sersem! Bu top sesi!Dialogue: 50,0:10:05.13,0:10:06.38,Main-207-,,0,0,0,,Neler oluyor?!Dialogue: 50,0:10:06.38,0:10:07.59,Main-207-,,0,0,0,,Siper alın!Dialogue: 50,0:10:07.59,0:10:10.63,Main-207-,,0,0,0,,Kahretsin! Bir şeyler görmek için fazla karanlık!Dialogue: 50,0:10:10.63,0:10:13.38,Main-207-,,0,0,0,,Dr. Kureha, tüm mermileri kullandık.Dialogue: 50,0:10:13.38,0:10:14.93,Main-207-,,0,0,0,,Tutuşturun!Dialogue: 50,0:10:25.90,0:10:27.77,Main-207-,,0,0,0,,Harikulade...Dialogue: 50,0:10:27.77,0:10:28.86,Main-207-,,0,0,0,,Evet...Dialogue: 50,0:10:29.98,0:10:31.36,Main-207-,,0,0,0,,Çok güzel...Dialogue: 50,0:10:33.32,0:10:37.53,Flashbacks-207-,,0,0,0,,Bu otuz uzun yılın sonunda bulduğum cevap!Dialogue: 50,0:10:37.53,0:10:41.20,Main-207-,,0,0,0,,Gerçekten etkileyici bir manzara!Dialogue: 50,0:10:42.29,0:10:45.50,Main-207-,,0,0,0,,O yaşlı şarlatanın kafasından neler  geçiyordu hiçbir zaman anlayamayacağım.Dialogue: 50,0:10:46.13,0:10:48.50,Flashbacks-207-,,0,0,0,,Kiraz çiçeklerini bu ülkenin her yerinde açtıracağım!Dialogue: 50,0:10:48.50,0:10:52.46,Flashbacks-207-,,0,0,0,,Yarattığım şeyi tamamlayınca,  tüm ülke kurtulacak!Dialogue: 50,0:10:53.92,0:10:55.55,Flashbacks-207-,,0,0,0,,Çık git buradan şarlatan seni!Dialogue: 50,0:10:55.55,0:10:58.93,Flashbacks-207-,,0,0,0,,Kahretsin! Kertengele gözlerinin  işe yarayacağını düşünmüştüm!Dialogue: 50,0:11:00.89,0:11:04.98,Flashbacks-207-,,0,0,0,,Dinle. Bu kırmızı toz çok özel.Dialogue: 50,0:11:04.98,0:11:09.77,Flashbacks-207-,,0,0,0,,Havadaki beyaz karlara tutunacak...Dialogue: 50,0:11:10.15,0:11:13.24,Flashbacks-207-,,0,0,0,,...ve canlı renkte pembe kar tanelerinin yağmasını sağlayacak!Dialogue: 50,0:11:19.66,0:11:21.04,Thoughts-207-,,0,0,0,,Doktor!Dialogue: 50,0:11:21.99,0:11:23.83,Thoughts-207-,,0,0,0,,Doktorine!Dialogue: 50,0:11:58.49,0:12:01.03,Flashbacks-207-,,0,0,0,,Seni vurmayacağım!Dialogue: 50,0:12:01.03,0:12:03.33,Flashbacks-207-,,0,0,0,,Benim adım Dr. Hiriluk!Dialogue: 50,0:12:03.33,0:12:04.45,Flashbacks-207-,,0,0,0,,Ben bir doktorum!Dialogue: 50,0:12:05.16,0:12:06.83,Flashbacks-207-,,0,0,0,,Tony Tony Chopper.Dialogue: 50,0:12:06.83,0:12:10.42,Flashbacks-207-,,0,0,0,,Havalı bir isim, değil mi? Sana böyle sesleneceğim.Dialogue: 50,0:12:10.75,0:12:13.92,Flashbacks-207-,,0,0,0,,Chopper, iyi bir doktor olacaksın.Dialogue: 50,0:12:13.92,0:12:15.42,Flashbacks-207-,,0,0,0,,Buna garanti verebilirim.Dialogue: 50,0:12:21.89,0:12:25.14,Flashbacks-207-,,0,0,0,,Ben kaybolsam bile, rüyalarım gerçeğe dönüşecek.Dialogue: 50,0:12:25.14,0:12:27.85,Flashbacks-207-,,0,0,0,,Ne harikulade bir hayattı!Dialogue: 50,0:12:31.36,0:12:34.28,Flashbacks-207-,,0,0,0,,Teşekkürler, Chopper!Dialogue: 50,0:12:43.91,0:12:45.04,Main-207-,,0,0,0,,Artık...Dialogue: 50,0:12:45.54,0:12:47.25,Main-207-,,0,0,0,,...sana iyi yolculuklar...Dialogue: 50,0:12:47.25,0:12:48.66,Main-207-,,0,0,0,,...benim ahmak oğlum..!Dialogue: 50,0:12:59.84,0:13:01.18,Main-207-,,0,0,0,,Bu geçirdiğim en iyi gün!Dialogue: 50,0:13:01.18,0:13:03.72,Main-207-,,0,0,0,,Ay çıktı ve kiraz çiçekleri de açıyor.Dialogue: 50,0:13:03.72,0:13:05.56,Main-207-,,0,0,0,,Chopper! Hey, Chopper!Dialogue: 50,0:13:05.56,0:13:06.56,Main-207-,,0,0,0,,Seni serseri seni!Dialogue: 50,0:13:06.56,0:13:08.89,Main-207-,,0,0,0,,Ne kadar daha oraya oturup  uzaklara dalmaya devam edeceksin?Dialogue: 50,0:13:09.85,0:13:11.35,Main-207-,,0,0,0,,İç!Dialogue: 50,0:13:10.35,0:13:11.35,Secondary-207-,,0,0,0,,Ne?Dialogue: 50,0:13:11.35,0:13:13.65,Main-207-,,0,0,0,,Bi' şarkı patlat!Dialogue: 50,0:13:12.63,0:13:13.65,Secondary-207-,,0,0,0,,Ne?Dialogue: 50,0:13:13.65,0:13:15.94,Main-207-,,0,0,0,,Al, bu çubukları burnuna sok!Dialogue: 50,0:13:15.94,0:13:16.82,Main-207-,,0,0,0,,Ne?Dialogue: 50,0:13:16.82,0:13:19.19,Main-207-,,0,0,0,,Vay be, kiraz çiçeklerinin  manzarası ne kadar da hoş!Dialogue: 50,0:13:19.19,0:13:22.74,Main-207-,,0,0,0,,Böyle bir zamanda nasıl partilemeyelim?!Dialogue: 50,0:13:22.74,0:13:24.41,Main-207-,,0,0,0,,Şaşırdın mı?Dialogue: 50,0:13:24.41,0:13:28.12,Main-207-,,0,0,0,,Biliyor musun,  bayağı çılgın arkadaşlar edindin!Dialogue: 50,0:13:29.00,0:13:30.87,Main-207-,,0,0,0,,Arkadaşlar...Dialogue: 50,0:13:30.87,0:13:32.00,Main-207-,,0,0,0,,Evet.Dialogue: 50,0:13:32.00,0:13:35.13,Main-207-,,0,0,0,,İdare etmeleri epey zordur ama madem artık bizden birisin...Dialogue: 50,0:13:35.13,0:13:36.84,Main-207-,,0,0,0,,...yakında alışırsın.Dialogue: 50,0:13:38.76,0:13:42.68,Main-207-,,0,0,0,,Karoo!  Nehirde donmuş halde ne yapıyordun?Dialogue: 50,0:13:45.35,0:13:48.60,Main-207-,,0,0,0,,Muhtemelen kaydı ya da onun gibi bir şey oldu! O kadar sakar ki!Dialogue: 50,0:13:48.60,0:13:50.77,Main-207-,,0,0,0,,Sessiz olun, Bay Bushido!Dialogue: 50,0:13:51.39,0:13:53.02,Main-207-,,0,0,0,,Ya...Dialogue: 50,0:13:53.02,0:13:56.02,Main-207-,,0,0,0,,Dedi ki Zoro denen adam  yüzmeye gitmiş ve kaybolmuş.Dialogue: 50,0:13:56.02,0:13:59.74,Main-207-,,0,0,0,,Zoro'nun başının dertte olduğunu düşünmüş, o yüzden atlayıp yardım etmeye çalışmış ve donmuş.Dialogue: 50,0:13:59.74,0:14:01.82,Main-207-,,0,0,0,,Yani bu senin hatandı!Dialogue: 50,0:14:01.82,0:14:02.57,Main-207-,,0,0,0,,Ouvv..Dialogue: 50,0:14:02.57,0:14:05.87,Main-207-,,0,0,0,,Tony-kun, Karoo'nun  dediklerini anlayabiliyor musun?Dialogue: 50,0:14:05.87,0:14:10.37,Main-207-,,0,0,0,,Evet. Onlardan biri olduğum için  hayvanlarla iletişim kurabiliyorum.Dialogue: 50,0:14:10.37,0:14:12.21,Main-207-,,0,0,0,,Hayvanlarla konuşabiliyor musun?Dialogue: 50,0:14:12.21,0:14:14.21,Main-207-,,0,0,0,,Bu harika, Chopper!Dialogue: 50,0:14:14.21,0:14:17.13,Main-207-,,0,0,0,,Bir de tıbbi uzmanlığın yetmezmiş gibi..!Dialogue: 50,0:14:17.88,0:14:19.00,Main-207-,,0,0,0,,SERSEM!Dialogue: 50,0:14:19.00,0:14:22.42,Main-207-,,0,0,0,,Bana böyle iltifat etmen beni hiçbir  şekilde mutlu etmeyecek, seni ahmak!Dialogue: 50,0:14:22.42,0:14:23.76,Main-207-,,0,0,0,,– O kesinlikle mutlu duruyor. – O kesinlikle mutlu duruyor.Dialogue: 50,0:14:24.26,0:14:26.72,Main-207-,,0,0,0,,Nami, bu arada tıbbi uzmanlık  derken neyi kastediyorsun?Dialogue: 50,0:14:26.72,0:14:28.97,Main-207-,,0,0,0,,Chopper bir doktor!Dialogue: 50,0:14:28.97,0:14:33.44,Main-207-,,0,0,0,,Dr. Kureha onu birinci sınıf bir  doktor olması için kendisi bizzat eğitti.Dialogue: 50,0:14:33.44,0:14:34.94,Main-207-,,0,0,0,,– Ne?! – Ne?!Dialogue: 50,0:14:34.94,0:14:37.69,Main-207-,,0,0,0,,Chopper! Sen doktor musun?!Dialogue: 50,0:14:37.69,0:14:38.94,Main-207-,,0,0,0,,İnanılmaz!Dialogue: 50,0:14:38.94,0:14:39.73,Main-207-,,0,0,0,,Bu olamaz!Dialogue: 50,0:14:39.73,0:14:41.11,Main-207-,,0,0,0,,Ah, hadi ama!Dialogue: 50,0:14:41.11,0:14:44.07,Main-207-,,0,0,0,,Bize katılmasını istediğinizde  ne olduğunu sanıyordunuz ki?Dialogue: 50,0:14:44.07,0:14:46.62,Main-207-,,0,0,0,,Yedi-Form Dönüşümlü bir ren geyiği.Dialogue: 50,0:14:47.07,0:14:48.24,Main-207-,,0,0,0,,Acil durum yemeği.Dialogue: 50,0:14:48.24,0:14:49.03,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:14:50.16,0:14:55.29,Main-207-,,0,0,0,,Ah, hayır! Aceleden tıbbi  erzaklarımı almayı unuttum!Dialogue: 50,0:14:55.29,0:14:57.50,Main-207-,,0,0,0,,Emin misin?  O zaman, bu ne?Dialogue: 50,0:14:56.92,0:14:57.50,Secondary-207-,,0,0,0,,Ne?Dialogue: 50,0:14:58.50,0:14:59.63,Main-207-,,0,0,0,,Çantam!Dialogue: 50,0:14:59.63,0:15:01.51,Main-207-,,0,0,0,,Kızaktaydı.Dialogue: 50,0:15:02.38,0:15:03.59,Main-207-,,0,0,0,,Nasıl olur..?Dialogue: 50,0:15:03.59,0:15:05.01,Main-207-,,0,0,0,,Nasıl olur derken?Dialogue: 50,0:15:05.01,0:15:07.93,Main-207-,,0,0,0,,Yolculuk için kendin hazırlanmadın mı?Dialogue: 50,0:15:39.54,0:15:45.88,Main-207-,,0,0,0,,Sanırım seni sonuna kadar  bir kitap gibi okudu.Dialogue: 50,0:15:49.01,0:15:50.51,Main-207-,,0,0,0,,O harika biri.Dialogue: 50,0:15:50.35,0:15:52.10,Secondary-207-,,0,0,0,,Çubuklarıma sümük bulaştı!Dialogue: 50,0:15:52.10,0:15:53.14,Secondary-207-,,0,0,0,,O iş sende!Dialogue: 50,0:15:51.43,0:15:52.26,Main-207-,,0,0,0,,Evet...Dialogue: 50,0:15:57.31,0:16:00.19,Main-207-,,0,0,0,,Hey, Chopper! Sen de bir dene!Dialogue: 50,0:16:00.19,0:16:01.69,Main-207-,,0,0,0,,Ciddiydi!Dialogue: 50,0:16:00.86,0:16:02.69,Secondary-207-,,0,0,0,,Ne yapıyorsun?!Dialogue: 50,0:16:01.69,0:16:03.65,Main-207-,,0,0,0,,Senin o anılarını anlatırken...Dialogue: 50,0:16:03.65,0:16:05.53,Main-207-,,0,0,0,,...doğru değil mi, Chopper?Dialogue: 50,0:16:04.19,0:16:06.20,Secondary-207-,,0,0,0,,Durun ama artık! Buraya gelmeyin!Dialogue: 50,0:16:05.53,0:16:06.78,Main-207-,,0,0,0,,Chopper...?Dialogue: 50,0:16:06.78,0:16:08.41,Main-207-,,0,0,0,,Hayır, sen de mi!?Dialogue: 50,0:16:09.57,0:16:12.91,Main-207-,,0,0,0,,Pekala... millet!Dialogue: 50,0:16:12.91,0:16:15.37,Main-207-,,0,0,0,,Dikkat!Dialogue: 50,0:16:15.37,0:16:16.96,Main-207-,,0,0,0,,Seni şerefsiz!Dialogue: 50,0:16:15.87,0:16:20.25,Main-207-,,0,0,0,,Sizlere yeni tayfa üyemizi takdim etmek isterim...Dialogue: 50,0:16:20.25,0:16:22.13,Main-207-,,0,0,0,,Sanji! Yakala onu!Dialogue: 50,0:16:20.25,0:16:22.13,Main-207-,,0,0,0,,Tony Tony Chopper!Dialogue: 50,0:16:22.75,0:16:24.55,Main-207-,,0,0,0,,Ben...Dialogue: 50,0:16:22.13,0:16:25.26,Main-207-,,0,0,0,,O artık gemimizin doktoru olacak, ve bunu kutlamak için–Dialogue: 50,0:16:25.26,0:16:26.47,Main-207-,,0,0,0,,Dinleyin, sizi mankafalar!Dialogue: 50,0:16:26.47,0:16:28.51,Secondary-207-,,0,0,0,,Bırak şunu yapmayı!Dialogue: 50,0:16:28.51,0:16:30.51,Secondary-207-,,0,0,0,,Sorun yok, sorun yok!Dialogue: 50,0:16:31.85,0:16:33.72,Secondary-207-,,0,0,0,,Yaa öyle mi?!Dialogue: 50,0:16:33.72,0:16:35.93,Secondary-207-,,0,0,0,,Çocuklar! Durun ama!Dialogue: 50,0:16:35.93,0:16:38.64,Secondary-207-,,0,0,0,,Sana biraz gücümü tattırayım mı?!Dialogue: 50,0:16:39.39,0:16:40.44,Secondary-207-,,0,0,0,,Ooo başka bir çubuk!Dialogue: 50,0:16:29.13,0:16:30.51,Main-207-,,0,0,0,,Ben...Dialogue: 50,0:16:36.48,0:16:38.64,Main-207-,,0,0,0,,Ben daha önce hiç bu kadar eğlenmemiştim.Dialogue: 50,0:16:39.02,0:16:39.98,Main-207-,,0,0,0,,Evet!Dialogue: 50,0:16:41.02,0:16:43.98,Main-207-,,0,0,0,,Haydi yeni arkadaşımıza kadeh kaldıralım!Dialogue: 50,0:16:43.98,0:16:45.86,Main-207-,,0,0,0,,– Evet! – Evet!Dialogue: 50,0:16:45.86,0:16:50.99,Main-207-,,0,0,0,,– Şerefe! – Şerefe!Dialogue: 50,0:16:53.78,0:16:56.95,Main-207-,,0,0,0,,Acaba adadan ayrılabildiler mi merak ettim?Dialogue: 50,0:16:56.95,0:17:01.46,Main-207-,,0,0,0,,Birinci sınıf bir kalbe ve birinci sınıf doktor  yeteneklerine sahip bir ren geyiği...Dialogue: 50,0:17:01.46,0:17:06.71,Main-207-,,0,0,0,,Eğer Hiriluk'un hayatı pahasına yaptığı  kiraz çiçekleri bu mucizeye sebep olabilmişse...Dialogue: 50,0:17:08.38,0:17:13.47,Main-207-,,0,0,0,,Sanırım o beceriksiz ren geyiği de  denize açılmayı başarmıştır.Dialogue: 50,0:17:13.47,0:17:14.76,Main-207-,,0,0,0,,O çocuk...Dialogue: 50,0:17:15.26,0:17:17.89,Main-207-,,0,0,0,,sanki tamamen bir  yetişkinmiş gibi davranıyor...Dialogue: 50,0:17:18.31,0:17:20.89,Main-207-,,0,0,0,,Çok iyi bir gemi doktoru olacak.Dialogue: 50,0:17:21.73,0:17:25.73,Main-207-,,0,0,0,,Bundan sonra sen ne yapacaksın?Dialogue: 50,0:17:26.69,0:17:28.36,Main-207-,,0,0,0,,Tüm bu olanlardan önce...Dialogue: 50,0:17:28.74,0:17:32.24,Main-207-,,0,0,0,,...Wapol'un Kraliyet Baş Muhafızı'ydım.Dialogue: 50,0:17:32.24,0:17:35.41,Main-207-,,0,0,0,,Bu günahın kefaretini ödeyeceğim.Dialogue: 50,0:17:35.87,0:17:42.62,Main-207-,,0,0,0,,Bu yeni ülkeyi vatandaşlarına emanet edip ülkeyi terk etmeyi düşünmüştüm.Dialogue: 50,0:17:42.62,0:17:46.34,Main-207-,,0,0,0,,Anladım... Peki bu düşüncen hale geçerli mi?Dialogue: 50,0:17:46.84,0:17:47.88,Main-207-,,0,0,0,,Hayır...Dialogue: 50,0:17:47.88,0:17:51.93,Main-207-,,0,0,0,,Kefarete giden yolun bu  olmadığının farkına vardım.Dialogue: 50,0:17:52.34,0:17:54.64,Main-207-,,0,0,0,,Bu ülke, monarşinin  zincirlerinden kurtuluyor...Dialogue: 50,0:17:54.64,0:17:57.89,Main-207-,,0,0,0,,...ve halkın kendi eliyle yeniden  yarattığı yeni bir ülke doğuyor.Dialogue: 50,0:17:58.60,0:18:03.90,Main-207-,,0,0,0,,Belki burada kalıp bu doğuşa  katkı sağlamamın bir yolu vardır.Dialogue: 50,0:18:04.65,0:18:10.44,Main-207-,,0,0,0,,Bunun hatalarımı telafi edebilmemin bir yolu olduğunu hissediyorum.Dialogue: 50,0:18:11.40,0:18:13.07,Main-207-,,0,0,0,,Genç adam...Dialogue: 50,0:18:13.07,0:18:17.12,Main-207-,,0,0,0,,...bu ülkeyi gerçekten önemsiyorsun.Dialogue: 50,0:18:17.99,0:18:20.83,Main-207-,,0,0,0,,Ülkeyi önemsiyorum diyorsun demek...Dialogue: 50,0:18:21.79,0:18:27.54,Main-207-,,0,0,0,,Bunu bir keresinde yaklaşık  on yaşlarında bir kızdan öğrenmiştim.Dialogue: 50,0:18:28.42,0:18:30.42,Main-207-,,0,0,0,,Dünya Konferansı mı?Dialogue: 50,0:18:30.42,0:18:32.51,Main-207-,,0,0,0,,Ne kadar değersiz, yorucu bir etkinlik.Dialogue: 50,0:18:32.51,0:18:34.55,Main-207-,,0,0,0,,Çok doğru, efendimiz.Dialogue: 50,0:18:36.30,0:18:40.22,Thoughts-207-,,0,0,0,,Drum Krallığı bu şekilde  devam edebilir mi bilmiyorum...Dialogue: 50,0:18:40.56,0:18:43.60,Thoughts-207-,,0,0,0,,Kralı ve vatandaşları arasındaki  uçurum git gide büyüyor.Dialogue: 50,0:18:45.81,0:18:48.07,Main-207-,,0,0,0,,Arabasta'nın hükümdarı...Dialogue: 50,0:18:48.07,0:18:50.61,Main-207-,,0,0,5,,Kral Nefertari Cobra-sama!Dialogue: 50,0:18:53.40,0:18:56.78,Main-207-,,0,0,0,,Demek Arabasta'nın yardımsever  ve bilgili kralı bu.Dialogue: 50,0:18:58.37,0:19:00.24,Main-207-,,0,0,0,,Devrimci Dragon...Dialogue: 50,0:19:00.24,0:19:02.37,Main-207-,,0,0,0,,Onun ideolojisi çok tehlikeli.Dialogue: 50,0:19:03.00,0:19:06.33,Main-207-,,0,0,0,,Beş ya da altı yıl içinde, Dünya Hükümeti'ne...Dialogue: 50,0:19:06.75,0:19:11.80,Main-207-,,0,0,0,,...bir tehdit oluşturacak kapasiteye ulaşacağı aşikar.Dialogue: 50,0:19:14.13,0:19:15.63,Main-207-,,0,0,0,,Ne ahmakça...Dialogue: 50,0:19:15.63,0:19:18.26,Main-207-,,0,0,0,,Bunun benim ülkemle  zerre alakası yok.Dialogue: 50,0:19:18.26,0:19:22.64,Main-207-,,0,0,0,,Benim yönetme yöntemlerim,  devrimcilerin halkımı yanıltmasına izin vermez.Dialogue: 50,0:19:22.64,0:19:25.19,Main-207-,,0,0,0,,Onu yakalamak istiyorsan bana ne, git kendin yakala!Dialogue: 50,0:19:25.19,0:19:26.52,Main-207-,,0,0,0,,Wapol!Dialogue: 50,0:19:26.52,0:19:28.36,Main-207-,,0,0,0,,Bencilliği bırakınız!Dialogue: 50,0:19:28.36,0:19:31.07,Main-207-,,0,0,0,,Reverie'nin ne kadar önemli  olduğunun farkında değil misiniz?Dialogue: 50,0:19:31.07,0:19:33.90,Main-207-,,0,0,0,,Biraz öz farkındalık kazanınız!Dialogue: 50,0:19:34.57,0:19:36.41,Main-207-,,0,0,0,,Kahretsin, Nefertari Cobra!Dialogue: 50,0:19:38.66,0:19:40.83,Main-207-,,0,0,0,,Ne kadar tatsız bir konferanstı.Dialogue: 50,0:19:41.79,0:19:42.66,Main-207-,,0,0,0,,Bu...Dialogue: 50,0:19:44.08,0:19:46.12,Main-207-,,0,0,0,,...o iğrenç kobranın kızı!Dialogue: 50,0:19:49.58,0:19:51.67,Main-207-,,0,0,0,,Ops! Elim kaydı!Dialogue: 50,0:19:51.67,0:19:52.84,Main-207-,,0,0,0,,Wapol-sama!Dialogue: 50,0:19:53.63,0:19:54.51,Main-207-,,0,0,0,,Vivi-sama!Dialogue: 50,0:19:54.51,0:19:58.14,Main-207-,,0,0,0,,Özrümü kabul edin! Sizler  Arabasta Prensesi'siniz değil mi?Dialogue: 50,0:19:58.14,0:20:01.51,Main-207-,,0,0,0,,Zavallı velet, o umutsuz kralın kızı!Dialogue: 50,0:20:01.51,0:20:03.18,Main-207-,,0,0,0,,Seni aşağılık! Ne yapıyorsun?Dialogue: 50,0:20:03.18,0:20:05.31,Main-207-,,0,0,0,,Bekle, Igaram! Ben iyiyim!Dialogue: 50,0:20:07.19,0:20:09.94,Main-207-,,0,0,0,,Sizlerden de çok özür dilerim. Size çarptım.Dialogue: 50,0:20:11.77,0:20:13.98,Main-207-,,0,0,0,,Ne kadar sıradışı bir çocuk..!Dialogue: 50,0:20:13.98,0:20:16.40,Main-207-,,0,0,0,,Hükümdarlar Reverie için toplantığında...Dialogue: 50,0:20:16.40,0:20:19.78,Main-207-,,0,0,0,,En ufak bir tartışma  bile bir savaşı tetikleyebilir.Dialogue: 50,0:20:19.78,0:20:22.16,Main-207-,,0,0,0,,Bunun bilincinde olarak,  durumu hoşgörüyle karşıladı.Dialogue: 50,0:20:23.75,0:20:25.29,Main-207-,,0,0,0,,Ne zeki bir çocuk!Dialogue: 50,0:20:27.75,0:20:29.37,Main-207-,,0,0,0,,Ne gıcık bir çocuk!Dialogue: 50,0:20:29.37,0:20:30.88,Main-207-,,0,0,0,,Gidelim, Dalton.Dialogue: 50,0:20:31.38,0:20:32.38,Main-207-,,0,0,0,,Kusurumuza bakmayın.Dialogue: 50,0:20:36.21,0:20:39.13,Main-207-,,0,0,0,,Çok acıyor!Dialogue: 50,0:20:39.13,0:20:43.76,Main-207-,,0,0,0,,Sizler harikaydınız Vivi-sama!Dialogue: 50,0:20:43.85,0:20:46.77,Main-207-,,0,0,0,,Prensesin ülkesine olan sevgisi...Dialogue: 50,0:20:47.43,0:20:49.44,Main-207-,,0,0,0,,Asaleti...Dialogue: 50,0:20:49.44,0:20:51.48,Main-207-,,0,0,0,,Bir tık bile değişmemiş.Dialogue: 50,0:20:53.48,0:20:55.53,Main-207-,,0,0,0,,Ne kadar harika birine dönüşmüş.Dialogue: 50,0:20:58.32,0:20:59.74,Main-207-,,0,0,0,,Dalton-kun!Dialogue: 50,0:21:00.74,0:21:04.08,Main-207-,,0,0,0,,Bizler de bu ülkeyi umursuyoruz.Dialogue: 50,0:21:04.08,0:21:07.58,Main-207-,,0,0,0,,Ülkeyi yeniden ayaklandırmamıza izin verin.Dialogue: 50,0:21:14.17,0:21:16.05,Thoughts-207-,,0,0,0,,Hiriluk...Dialogue: 50,0:21:16.05,0:21:18.67,Thoughts-207-,,0,0,0,,Bu ülke kesinlikle yeniden doğacak...Dialogue: 50,0:21:18.67,0:21:21.80,Thoughts-207-,,0,0,0,,Tıpkı oğlun, Chopper gibi!Dialogue: 50,0:21:21.80,0:21:25.18,Main-207-,,0,0,0,,Dalton-san, kötü haber!Dialogue: 50,0:21:25.64,0:21:28.31,Main-207-,,0,0,0,,Şu an çok kötü bir şeyi hatırladım!Dialogue: 50,0:21:28.31,0:21:29.27,Main-207-,,0,0,0,,Nedir?Dialogue: 50,0:21:29.27,0:21:31.02,Main-207-,,0,0,0,,Şunu kontrol edin.Dialogue: 50,0:21:32.48,0:21:35.82,Main-207-,,0,0,0,,Bu o! Wapol'u yenen şu hasır şapka takan korsan!Dialogue: 50,0:21:35.82,0:21:37.44,Main-207-,,0,0,0,,Buna hiç şüphe yok!Dialogue: 50,0:21:37.82,0:21:41.28,Main-207-,,0,0,0,,Ödülü otuz milyon beli mi?  Kim bu insanlar?Dialogue: 50,0:21:41.28,0:21:42.57,Main-207-,,0,0,0,,Oo?Dialogue: 50,0:21:42.57,0:21:45.03,Main-207-,,0,0,0,,Görünüşe göre öyle  sıradan suçlular değillermiş.Dialogue: 50,0:21:45.99,0:21:47.29,Main-207-,,0,0,0,,Nereden buldun bunu?Dialogue: 50,0:21:47.29,0:21:50.96,Main-207-,,0,0,0,,Şey... bunu size rapor etmeyi  tamamen unutmuşum, fakat...Dialogue: 50,0:21:51.37,0:21:52.87,Main-207-,,0,0,0,,...yaklaşık bir hafta önce...Dialogue: 50,0:21:52.87,0:21:57.88,Main-207-,,0,0,0,,...Robelle Kasabası'nda  bir anda bir gezgin belirdi.Dialogue: 50,0:21:59.21,0:22:02.72,Main-207-,,0,0,0,,Tuhaf bir gündü. Bütün gün hiç kar yağmadı.Dialogue: 50,0:22:02.72,0:22:05.10,Main-207-,,0,0,0,,Nereye demir attı onu bile bilmiyoruz.Dialogue: 50,0:22:05.10,0:22:07.47,Main-207-,,0,0,0,,Her neyse, dedi ki...Dialogue: 50,0:22:07.47,0:22:12.85,Main-207-,,0,0,0,,...bu ülkeye saldıran o korsanın,  Karasakal'ın peşindeymiş...Dialogue: 50,0:22:12.85,0:22:16.19,Main-207-,,0,0,0,,Ama Karasakalın buradan çoktan  gittiğini farkettiğinde dedi ki...Dialogue: 50,0:22:16.19,0:22:18.53,Flashbacks-207-,,0,0,0,,O halde size bir soru  daha sormama müsaade edin.Dialogue: 50,0:22:18.53,0:22:21.99,Flashbacks-207-,,0,0,0,,Buralara hasır bir şapka  takan korsan geldi mi?Dialogue: 50,0:22:21.99,0:22:25.99,Main-207-,,0,0,0,,Bilmediğimizi söylediğimizde,  bize aranan posterini gösterdi ve dedi ki...Dialogue: 50,0:22:25.99,0:22:28.74,Flashbacks-207-,,0,0,0,,Eğer buraya gelirse...Dialogue: 50,0:22:30.33,0:22:31.37,Flashbacks-207-,,0,0,0,,Gelirse mi..?Dialogue: 50,0:22:31.75,0:22:37.00,Flashbacks-207-,,0,0,0,,Ona deyin ki onu Arabasta'da bekliyor olacağım ama sadece on gün kadar.Dialogue: 50,0:22:37.00,0:22:38.34,Flashbacks-207-,,0,0,0,,Anlaşıldı mı?Dialogue: 50,0:22:40.59,0:22:42.84,Flashbacks-207-,,0,0,0,,Hey!  Bekle bir saniye!Dialogue: 50,0:22:42.84,0:22:44.34,Flashbacks-207-,,0,0,0,,Senin adın ne?Dialogue: 50,0:22:44.34,0:22:47.30,Flashbacks-207-,,0,0,0,,Oh, evet.  Söylemeyi unuttum.Dialogue: 50,0:22:48.81,0:22:50.47,Flashbacks-207-,,0,0,0,,Benim adım Ace.Dialogue: 50,0:22:50.47,0:22:53.48,Flashbacks-207-,,0,0,0,,Ona bunu söylerseniz,  kim olduğumu direkt anlayacaktır.Dialogue: 50,0:22:59.61,0:23:01.36,Flashbacks-207-,,0,0,0,,Hey, yakalayın şu herifi!Dialogue: 50,0:23:01.36,0:23:03.32,Flashbacks-207-,,0,0,0,,Yemeğin parasını ödemeden tüyüyor!Dialogue: 50,0:23:03.32,0:23:05.49,Flashbacks-207-,,0,0,0,,Sadece bunu söyleyin, tamam mı?!Dialogue: 50,0:23:08.45,0:23:11.83,Main-207-,,0,0,0,,Onu Arabasta'da on gün bekleyecek demek?Dialogue: 50,0:23:14.16,0:23:16.79,Main-207-,,0,0,0,,Dr. Kureha. sorun nedir?Dialogue: 50,0:23:16.79,0:23:18.29,Main-207-,,0,0,0,,Bakakaldınız.Dialogue: 50,0:23:18.29,0:23:21.92,Main-207-,,0,0,0,,Hiç Gol D. Roger ismini duymuş muydun?Dialogue: 50,0:23:21.92,0:23:22.63,Main-207-,,0,0,0,,D.?Dialogue: 50,0:23:23.34,0:23:24.93,Main-207-,,0,0,0,,Gold Roger mı demek istiyorsunuz?Dialogue: 50,0:23:25.34,0:23:28.18,Main-207-,,0,0,0,,Bu günlerde ona böyle mi diyorlar?Dialogue: 50,0:23:29.89,0:23:31.81,Main-207-,,0,0,0,,Görünüşe bakılırsa...Dialogue: 50,0:23:32.27,0:23:37.73,Main-207-,,0,0,0,,...ren geyiğim baya sıradışı biriyle gitti.Dialogue: 50,0:23:38.15,0:23:40.02,Main-207-,,0,0,0,,Yani...Dialogue: 50,0:23:41.19,0:23:44.11,Main-207-,,0,0,0,,D.'nin İradesi hala yaşıyor!Dialogue: 50,0:23:51.03,0:23:53.04,Main-207-,,0,0,0,,Eee, Arabasta nedir?Dialogue: 50,0:23:53.04,0:23:55.00,Main-207-,,0,0,0,,Vivi'nin babasının hükmettiği ülke.Dialogue: 50,0:23:55.00,0:23:59.17,Main-207-,,0,0,0,,Şu anda Crocodile adında bir kötü adam,  Arabasta'yı ele geçirmeye çalışıyor.Dialogue: 50,0:23:59.17,0:24:02.50,Main-207-,,0,0,0,,Duyduğum kadarıyla  Crocodile bir Shichibukai.Dialogue: 0,0:23:59.17,0:24:02.50,Note-207-,,0,0,0,,Shichibukai: Denizin Yedi Savaş LorduDialogue: 50,0:24:02.50,0:24:04.26,Main-207-,,0,0,0,,Shichibukai mi?Dialogue: 50,0:24:04.26,0:24:07.51,Main-207-,,0,0,0,,Dünya Hükümeti tarafından  onaylanan bir takım korsanlar.Dialogue: 50,0:24:07.51,0:24:09.80,Main-207-,,0,0,0,,Hükümet tarafından  onaylanan korsanlar mı?Dialogue: 50,0:24:09.80,0:24:13.47,Main-207-,,0,0,0,,Evet. Son derece güçlülerdir.Dialogue: 50,0:24:17.56,0:24:21.19,Main-207-,,0,0,0,,Diğer korsanları bir bir ezerler..Dialogue: 50,0:24:21.19,0:24:26.03,Main-207-,,0,0,0,,...böylece hükümet korsanlık  aktivitelerine göz yumar.Dialogue: 50,0:24:26.53,0:24:29.36,Main-207-,,0,0,0,,Crocodile demek? Onunla tanışmak için sabırsızlanıyorum.Dialogue: 50,0:24:29.36,0:24:31.93,Main-207-,,0,0,0,,Crocodile Arabasta'da bir kahraman...Dialogue: 50,0:24:31.93,0:24:34.79,Main-207-,,0,0,0,,...çünkü orayı yağmalaya gelen  tüm korsanları durduruyor.Dialogue: 50,0:24:34.79,0:24:38.16,Main-207-,,0,0,0,,Ama bu sadece onun halka gösterdiği yüzü.Dialogue: 50,0:24:38.62,0:24:42.91,Main-207-,,0,0,0,,Arabasta'yı ele geçirmek için çıkan...Dialogue: 50,0:24:42.91,0:24:44.88,Main-207-,,0,0,0,,...iç savaşın iplerini elinde tutan beyin aslında o.Dialogue: 50,0:24:44.88,0:24:47.63,Main-207-,,0,0,0,,Kimse henüz farketmedi.Dialogue: 50,0:24:48.26,0:24:50.59,Main-207-,,0,0,0,,Ne vatandaşlar... ne de babam...Dialogue: 50,0:24:50.59,0:24:51.76,Main-207-,,0,0,0,,Tamamdır öyleyse!Dialogue: 50,0:24:51.76,0:24:55.02,Main-207-,,0,0,0,,Tek yapmam gereken Crocodile'ın poposuna tekmeyi basmak, değil mi?Dialogue: 50,0:24:55.39,0:24:56.27,Main-207-,,0,0,0,,Evet.Dialogue: 50,0:24:56.27,0:25:00.81,Main-207-,,0,0,0,,Öncelikle iç savaşı durdurur ve  Baroque Works'ü ifşa edersek...Dialogue: 50,0:25:00.81,0:25:02.23,Main-207-,,0,0,0,,Baroque Works?Dialogue: 50,0:25:03.02,0:25:05.90,Main-207-,,0,0,0,,Doğru.  Onları da bilmiyorsun, değil mi?Dialogue: 50,0:25:05.90,0:25:08.65,Main-207-,,0,0,0,,Dürüst olmak gerekirse, ipin ucu bende biraz kaçtı.Dialogue: 50,0:25:08.65,0:25:11.24,Main-207-,,0,0,0,,Baroque Works karmaşık bir sisteme sahip.Dialogue: 50,0:25:11.74,0:25:13.70,Main-207-,,0,0,0,,Sistem aslında oldukça basit.Dialogue: 50,0:25:14.08,0:25:16.95,Main-207-,,0,0,0,,En tepeden başlarsak, patron var, yani Crocodile...Dialogue: 50,0:25:16.95,0:25:19.25,Main-207-,,0,0,0,,Diğer bir adıyla Bay 0.Dialogue: 50,0:25:20.46,0:25:25.46,Main-207-,,0,0,0,,Patronun kendisinden direk emir alan  12 ajan ve bir hayvan var.Dialogue: 50,0:25:25.46,0:25:29.63,Main-207-,,0,0,0,,Her bir üst 12 adam bir  kadın ajanla eşleştirilir.Dialogue: 50,0:25:31.18,0:25:34.18,Main-207-,,0,0,0,,Bay 1 ve Bayan Doublefinger.Dialogue: 50,0:25:34.68,0:25:37.68,Main-207-,,0,0,0,,Bay 2'nin partneri yok gerçi.Dialogue: 50,0:25:38.02,0:25:41.35,Main-207-,,0,0,0,,Bay 3 Little Garden'da tanıştığımız  mum adam, doğru mu?Dialogue: 50,0:25:41.35,0:25:44.56,Main-207-,,0,0,0,,Evet. O Bayan Golden Week ile eş.Dialogue: 50,0:25:44.56,0:25:46.61,Main-207-,,0,0,0,,He, o kız.Dialogue: 50,0:25:47.15,0:25:50.36,Main-207-,,0,0,0,,Bay 4 Bayan Merry Christmas ile eş.Dialogue: 50,0:25:50.36,0:25:53.62,Main-207-,,0,0,0,,Ancak o ikisi hakkında  çok da bilgi sahibi değilim.Dialogue: 50,0:25:53.62,0:25:54.82,Main-207-,,0,0,0,,Ve o sümüklü adam!Dialogue: 50,0:25:54.82,0:25:55.74,Main-207-,,0,0,0,,Bay 5, değil mi?Dialogue: 50,0:25:55.74,0:25:56.45,Main-207-,,0,0,0,,Sümük mü?Dialogue: 50,0:25:56.45,0:25:58.20,Main-207-,,0,0,0,,Evet, sümükleri birer bombaydı.Dialogue: 50,0:25:58.20,0:26:00.58,Main-207-,,0,0,0,,Bay 5'in tüm vücudu bir silah.Dialogue: 50,0:26:01.12,0:26:04.33,Main-207-,,0,0,0,,Bayan Valentine'da  Kilo-Kilo Meyvesi güçleri var.Dialogue: 50,0:26:04.33,0:26:07.30,Main-207-,,0,0,0,,İstediği gibi ağırlığını  değiştirebilen kadın, değil mi?Dialogue: 50,0:26:07.30,0:26:11.84,Main-207-,,0,0,0,,"Bay 1'den Bay 5'e kadar olanlar "Rütbeli Ajanlar" olarak geçiyor.Dialogue: 50,0:26:11.84,0:26:14.39,Main-207-,,0,0,0,,Hepsinin şeytan meyvesi yetenekleri var...Dialogue: 50,0:26:14.39,0:26:17.01,Main-207-,,0,0,0,,...ve en önemli görevleri onlar alıyor.Dialogue: 50,0:26:17.51,0:26:22.19,Main-207-,,0,0,0,,Sonra Bay 6'dan Bay 13'e kadar var. Onların işi çalışanlara yol göstermek ve...Dialogue: 50,0:26:22.19,0:26:26.40,Main-207-,,0,0,0,,...Grand Line'nın girişinden para toplarlar.Dialogue: 50,0:26:26.40,0:26:28.90,Main-207-,,0,0,0,,Ayrıca, tuhaf bir maymun ve tavuk vardı.Dialogue: 50,0:26:29.82,0:26:32.74,Main-207-,,0,0,0,,Onlar Bay 13 ve Bayan Friday olmalılar.Dialogue: 50,0:26:32.74,0:26:37.49,Main-207-,,0,0,0,,Onlar görevlerinde başarısız olan diğer  ajanlarla öncelikle ilgilenen bir cezalandırma ekibi.Dialogue: 50,0:26:37.99,0:26:42.62,Main-207-,,0,0,0,,Ek olarak rütbeli ajanların 200 astı "Milyarlar" olarak adlandırılıyor.Dialogue: 50,0:26:42.62,0:26:46.38,Main-207-,,0,0,0,,Ve hudut ajanlarının 1.800 astı "Milyonlar" olarak adlandırılıyor.Dialogue: 50,0:26:47.13,0:26:50.21,Main-207-,,0,0,0,,İşte bu gizli suç örgütü: Baroque Works.Dialogue: 50,0:26:50.21,0:26:53.59,Main-207-,,0,0,0,,Bu demek oluyor ki... 1.800 artı 200, yani...Dialogue: 50,0:26:53.59,0:26:56.22,Main-207-,,0,0,0,,Toplam 2.000 ast mı var?!Dialogue: 50,0:26:55.18,0:26:56.22,Secondary-207-,,0,0,0,,2.000 var!Dialogue: 50,0:26:56.22,0:26:58.30,Main-207-,,0,0,0,,Tamam, şimdi anladım!Dialogue: 50,0:26:58.30,0:27:01.93,Main-207-,,0,0,0,,Tek yapmam gereken Crocodile denen  herifin poposuna tekmeyi basmak, değil mi?!Dialogue: 50,0:27:01.93,0:27:04.14,Main-207-,,0,0,0,,Bir kulağından giriyor diğerinden çıkıyor...Dialogue: 50,0:27:04.41,0:27:09.11,Main-207-,,0,0,0,,Eğer Baroque Works'ün nihai hedefi  bu ülkeyi kontrolü altına almaksa...Dialogue: 50,0:27:09.11,0:27:14.11,Main-207-,,0,0,0,,...geri kalan tüm  o rütbeli ajanların hepsi...Dialogue: 50,0:27:14.11,0:27:16.57,Main-207-,,0,0,0,,...Arabasta'da toplanacaklardır.Dialogue: 50,0:27:17.49,0:27:18.91,Main-207-,,0,0,0,,Evet.Dialogue: 50,0:27:18.91,0:27:22.16,Main-207-,,0,0,0,,Anlıyoruuum... Her neyse, tek yapmam gereken Crocodile denen herifi popo–Dialogue: 50,0:27:22.16,0:27:24.33,Main-207-,,0,0,0,,Yeter!  İlk seferinde de duymuştuk!Dialogue: 50,0:27:24.33,0:27:25.08,Main-207-,,0,0,0,,Oh, öyle mi?..Dialogue: 50,0:27:25.58,0:27:28.38,Main-207-,,0,0,0,,Bir, iki, SEN!Dialogue: 50,0:27:28.38,0:27:30.67,Main-207-,,0,0,0,,Bir, iki, O!Dialogue: 50,0:27:31.80,0:27:34.97,Main-207-,,0,0,0,,Özür dilerim, Bay 2 Bon Clay-sama!Dialogue: 50,0:27:35.76,0:27:37.76,Main-207-,,0,0,0,,Kimse soytarılık yapmasın!Dialogue: 50,0:27:37.76,0:27:40.56,Main-207-,,0,0,0,,Benim kim olduğumu sanıyorsunuz?Dialogue: 50,0:27:42.43,0:27:44.73,Main-207-,,0,0,5,,Baroque Works Rütbeli Ajanıyım!Dialogue: 50,0:27:44.73,0:27:47.19,Main-207-,,0,0,5,,Ben Bon Clay-sama,  kuğular bile benden korkar!Dialogue: 50,0:27:47.19,0:27:49.77,Main-207-,,0,0,5,,Hey, sen! Rotacı!Dialogue: 50,0:27:50.15,0:27:51.02,Main-207-,,0,0,0,,Evet efendim!Dialogue: 50,0:27:51.02,0:27:55.53,Main-207-,,0,0,0,,Tekrar söyle. Bay 0'ın emirleri nelerdi?!Dialogue: 50,0:27:55.53,0:28:00.99,Main-207-,,0,0,0,,Arabasta ile Little Garden arasında  kalan doğrudan yolda Bay 3'ü öldürmek.Dialogue: 50,0:28:00.99,0:28:04.87,Main-207-,,0,0,0,,Yani görevinin ne olduğunu hatırlıyorsun.Dialogue: 50,0:28:06.21,0:28:09.33,Main-207-,,0,0,0,,Doğrudan yol demek yolda düz bir  şekilde gitmek demek, doğru mu?Dialogue: 50,0:28:09.33,0:28:14.63,Main-207-,,0,0,0,,Bu yüzden Arabasta'dan bu Little Garden'a  dümdüz bir şekilde yol alarak geldik, doğru mu?!Dialogue: 50,0:28:14.63,0:28:17.18,Main-207-,,0,0,0,,O halde söyle bana. Şu an ne oldu?!Dialogue: 50,0:28:17.18,0:28:22.26,Main-207-,,0,0,0,,Arabasta'dan Little Garden'a dümdüz şekilde  yelken açtık ve Bay 3 ile hiç karşılaşmadık!Dialogue: 50,0:28:22.26,0:28:27.77,Main-207-,,0,0,0,,Bu, siz Bay 3'ün gemisini  kaçırdınız demek olmuyor mu?!Dialogue: 50,0:28:28.19,0:28:30.02,Main-207-,,0,0,0,,H-hayır..! Bu doğru olamaz..!Dialogue: 50,0:28:30.02,0:28:33.02,Main-207-,,0,0,0,,Oo, yani bana salak mı diyorsun?Dialogue: 50,0:28:33.02,0:28:34.28,Main-207-,,0,0,0,,Hayır Bay 2–Dialogue: 50,0:28:34.28,0:28:35.49,Main-207-,,0,0,0,,Kes sesini!Dialogue: 50,0:28:36.24,0:28:43.24,Main-207-,,0,0,0,,Her neyse, operasyon "Cılız Bay 3'ü Yok Et", aksamadan başarıya ulaşmak zorunda!Dialogue: 50,0:28:43.24,0:28:45.70,Main-207-,,0,0,0,,Başarısızlığa tahammül edemeyiz!Dialogue: 50,0:28:45.70,0:28:49.71,Main-207-,,0,0,0,,Yoksa, Bay 1 ve partneri beni öldürür.Dialogue: 50,0:28:50.71,0:28:52.96,Main-207-,,0,0,0,,Beni anladınız mı?!Dialogue: 50,0:28:52.96,0:28:58.68,Main-207-,,0,0,0,,Öfkemin tadına bakmak istemiyorsanız, Bay 3'ün yerini derhal tespit edin!Dialogue: 50,0:28:58.68,0:29:01.72,Main-207-,,0,0,0,,Yelkenler fora! Swanda ile Arabasta'ya yola koyuluyoruz!Dialogue: 50,0:29:01.72,0:29:02.80,Main-207-,,0,0,0,,Şimdi dinleyin!Dialogue: 50,0:29:02.80,0:29:05.56,Main-207-,,0,0,0,,Küçücük bir tekneyi bile  gözünüzden kaçırmayın!Dialogue: 50,0:29:05.56,0:29:06.18,Main-207-,,0,0,0,,Evet efendim!Dialogue: 50,0:29:06.18,0:29:08.85,Main-207-,,0,0,0,,– Bay 2 Bon Clay-sama! – Bay 2 Bon Clay-sama!Dialogue: 50,0:29:10.56,0:29:11.90,Main-207-,,0,0,0,,Ne?Dialogue: 50,0:29:11.90,0:29:15.11,Main-207-,,0,0,0,,Korsanlar krallıktaki  kasabalara mı saldırıyor?Dialogue: 50,0:29:15.11,0:29:17.86,Main-207-,,0,0,0,,Ülkenin benim korumam  altında olduğunu bilmiyorlar mı?Dialogue: 50,0:29:17.86,0:29:20.57,Main-207-,,0,0,0,,Kim bilir, Sayın Crocodile.Dialogue: 50,0:29:21.07,0:29:24.74,Main-207-,,0,0,0,,Sanıyorum karmaşa içindeki bir ülke,  korsanlar için cazip bir hedef haline geliyor.Dialogue: 50,0:29:28.04,0:29:29.08,Main-207-,,0,0,0,,Çıkıyor musunuz?Dialogue: 50,0:29:30.33,0:29:34.46,Main-207-,,0,0,0,,Evet.  Korumam gereken bir itibarım var.Dialogue: 50,0:29:34.46,0:29:36.50,Main-207-,,0,0,0,,Ne kadar tatlısınız.Dialogue: 50,0:29:39.22,0:29:40.84,Main-207-,,0,0,0,,Elbette.Dialogue: 50,0:29:40.84,0:29:44.89,Main-207-,,0,0,0,,Shichibukai diğer korsanları  parçalayan korsanlardır.Dialogue: 50,0:29:44.89,0:29:47.27,Main-207-,,0,0,0,,Biz kitlelerin kahramanıyız.Dialogue: 0,0:01:49.96,0:01:55.22,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Zyrecon thx to onepace.netDialogue: 0,0:16:51.00,0:17:01.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Zyrecon thx to onepace.netDialogue: 0,0:29:47.80,0:29:50.50,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Zyrecon thx to onepace.netDialogue: 1,0:01:49.96,0:01:55.22,Title-207-,,0,0,0,,Hiriluk'un Kiraz ÇiçekleriDialogue: 2,0:18:26.59,0:18:30.42,Captions-207-,,0,0,0,,Kutsal Toprak, Mary GeoiseDialogue: 2,0:18:48.11,0:18:50.61,Captions-207-,,0,0,0,,Nefertari Cobra Arabasta HükümdarıDialogue: 2,0:27:25.62,0:27:28.38,Captions-207-,,0,0,0,,Little Garden, Devlerin AdasıDialogue: 0,0:27:42.06,0:27:47.35,Captions-207-,,0,0,0,,Bay 2 Bon Clay Rütbeli Ajan, Baroque WorksDialogue: 50,0:28:35.74,0:28:43.24,Note-207-,,0,0,0,,Bon ClayDialogue: 0,0:00:01.73,0:00:03.73,Credits-207-,,0,0,0,,Video EditingDialogue: 1,0:00:01.73,0:00:03.73,Credits-207-,,0,0,0,,Video EditingDialogue: 0,0:00:01.73,0:00:03.73,Credits-207-,,0,0,0,,Galaxy 9000Dialogue: 1,0:00:01.73,0:00:03.73,Credits-207-,,0,0,0,,Galaxy 9000Dialogue: 0,0:00:03.73,0:00:05.73,Credits-207-,,0,0,0,,TimingDialogue: 1,0:00:03.73,0:00:05.73,Credits-207-,,0,0,0,,TimingDialogue: 0,0:00:03.73,0:00:05.73,Credits-207-,,0,0,0,,GabDialogue: 1,0:00:03.73,0:00:05.73,Credits-207-,,0,0,0,,GabDialogue: 0,0:00:05.73,0:00:07.73,Credits-207-,,0,0,0,,TypesettingDialogue: 1,0:00:05.73,0:00:07.73,Credits-207-,,0,0,0,,TypesettingDialogue: 0,0:00:05.73,0:00:07.73,Credits-207-,,0,0,0,,GabDialogue: 1,0