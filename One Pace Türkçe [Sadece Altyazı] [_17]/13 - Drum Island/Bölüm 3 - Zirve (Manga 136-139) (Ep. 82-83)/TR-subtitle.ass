[Script Info]Title: Default Aegisub fileScriptType: v4.00+WrapStyle: 0ScaledBorderAndShadow: yesYCbCr Matrix: TV.709PlayResX: 1440PlayResY: 1080[V4+ Styles]Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, EncodingStyle: Credits-207-,FOT-Greco Std B Strp,50,&H00FFFFFF,&H00002EFF,&H00000000,&H00000000,-1,0,0,0,95,100,1.6,0,1,3,0,7,16,16,16,1Style: Title-207-,Gilroy,90.0,&H00FEFEFE,&H00002EFF,&H00000000,&H00000000,-1,0,0,0,100,100,0,0,1,2.2,0,2,23,23,383,1Style: Main-207-,Impress BT Pace,73.0,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.0,3.0,2,180,180,27,1Style: Thoughts-207-,Impress BT Pace,73.0,&H00FFFFFF,&H00FFFFFF,&H00525252,&H78000000,0,0,0,0,100,100,0,0,1,3.5,3.0,2,180,180,27,1Style: Flashbacks-207-,Impress BT Pace,73.0,&H00FFFFFF,&H00FFFFFF,&H00525252,&H78000000,0,-1,0,0,100,100,0,0,1,3.0,3.0,2,180,180,27,1Style: Captions-207-,Gilroy,75.0,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,-1,0,0,0,100,100,0,0,1,3.5,0,2,16,16,27,1Style: Note-207-,Impress BT Pace,50.0,&H00FFFFFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,3.75,3.75,8,180,180,27,1Style: Secondary-207-,Impress BT Pace,73.0,&H00D6D6D6,&H00FFFFFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.0,3.0,2,180,180,27,1Style: Author,Impress BT,28.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1,1,9,10,10,10,1Style: Attack,Duality,50.0,&H00FFD388,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1,1,7,12,12,12,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 50,0:01:59.77,0:02:02.60,Main-207-,,0,0,0,,Sizi gidi tavşanlar... Sakın ola...Dialogue: 50,0:02:02.60,0:02:04.98,Main-207-,,0,0,0,,Hey, Sanji.  Sorun nedir?Dialogue: 50,0:02:04.98,0:02:06.98,Main-207-,,0,0,0,,Neler oluyor?Dialogue: 50,0:02:06.98,0:02:09.07,Main-207-,,0,0,0,,Hey! Kaçmamız gerek, Luffy!Dialogue: 50,0:02:09.07,0:02:11.53,Main-207-,,0,0,0,,K-kaçmak mı? Nereye?Dialogue: 50,0:02:14.49,0:02:17.28,Main-207-,,0,0,0,,Farketmez! Herhangi uzak bir yere!Dialogue: 50,0:02:17.95,0:02:19.45,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:02:19.45,0:02:22.83,Main-207-,,0,0,0,,Çığ..! Çığ geliyor!Dialogue: 50,0:02:28.59,0:02:32.26,Main-207-,,0,0,0,,Wapol...  Wapol geri döndü!Dialogue: 50,0:02:32.26,0:02:33.26,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:02:33.88,0:02:36.51,Main-207-,,0,0,0,,Dalton-san Bighorn'a doğru gidiyor!Dialogue: 50,0:02:36.51,0:02:39.51,Main-207-,,0,0,0,,Savaşabilenler, bir silah kuşanıp hemen Bighorn'a yola koyulsun!Dialogue: 50,0:02:39.85,0:02:42.31,Main-207-,,0,0,0,,Çabuk! Savaşabilecek olanlar hemen Bighorn'a!!Dialogue: 50,0:02:43.02,0:02:44.35,Main-207-,,0,0,0,,Dalton-san'ı takip edin!Dialogue: 50,0:02:44.85,0:02:46.23,Main-207-,,0,0,0,,Dalton-san'ı takip edin!Dialogue: 50,0:02:46.23,0:02:47.86,Main-207-,,0,0,0,,Wapol geri döndü!Dialogue: 50,0:02:47.86,0:02:51.44,Main-207-,,0,0,0,,Millet, silahlarınızı kuşanın! Ülkemizi korumak zorundayız!Dialogue: 50,0:02:51.44,0:02:53.82,Main-207-,,0,0,0,,Silahınızı alın!  Bighorn'a yola koyulun!Dialogue: 50,0:02:53.82,0:02:56.28,Main-207-,,0,0,0,,Evet!Dialogue: 50,0:02:59.28,0:03:03.75,Main-207-,,0,0,0,,Hey Vivi, cadının bulunduğu Gyasta'nın bu yönde olduğundan emin miyiz?Dialogue: 50,0:03:03.75,0:03:07.25,Main-207-,,0,0,0,,Hmm... Sen şimdi böyle deyince, ben de pek emin olamadım...Dialogue: 50,0:03:07.25,0:03:09.46,Main-207-,,0,0,0,,Emin değilsen, başımız belada demek.Dialogue: 50,0:03:09.46,0:03:14.01,Main-207-,,0,0,0,,Dinle, eğer Luffy ve Sanji vardıklarında doktorun gitmiş olduğunu görürlerse...Dialogue: 50,0:03:14.01,0:03:16.93,Main-207-,,0,0,0,,..."Peki bizim ne işimiz var burada?" diye düşüneceklerdir.Dialogue: 50,0:03:16.93,0:03:20.72,Main-207-,,0,0,0,,Tabii, doktoru onlardan önce bulup kaleye geri dönmesini sağlayamazsak.Dialogue: 50,0:03:20.72,0:03:22.64,Main-207-,,0,0,0,,Biliyorum, ama...Dialogue: 50,0:03:22.64,0:03:26.14,Main-207-,,0,0,0,,Biliyorsan bir şeyler yap. Sen prensessin, değil mi?Dialogue: 50,0:03:26.14,0:03:30.90,Main-207-,,0,0,0,,Bunun konuyla alakası yok. Bir prensesle bir cadıyı aynı kefeye koyma.Dialogue: 50,0:03:30.90,0:03:31.90,Main-207-,,0,0,0,,Ama...Dialogue: 50,0:03:31.90,0:03:34.11,Main-207-,,0,0,0,,O halde haritaya bak.Dialogue: 50,0:03:34.11,0:03:35.99,Main-207-,,0,0,0,,Ne?! Saçmalama!Dialogue: 50,0:03:35.99,0:03:38.57,Main-207-,,0,0,0,,Her yerde kar var. Haritadan hiçbir şey...Dialogue: 50,0:03:38.57,0:03:43.04,Main-207-,,0,0,0,,Her halükarda bu yol üzerinde mutlaka Gyasta'ya dair bir işaret olmalı.Dialogue: 50,0:03:43.04,0:03:44.50,Main-207-,,0,0,0,,O yüzden gözünü dört aç.Dialogue: 50,0:03:44.50,0:03:48.83,Main-207-,,0,0,0,,Anlaşıldı, o işi bana bırak! Tabelalara karşı gözümü dört açıyorum!Dialogue: 50,0:03:48.83,0:03:50.00,Main-207-,,0,0,0,,Oh, umursamazdan geliyorsun demek, he?..Dialogue: 50,0:04:01.72,0:04:03.64,Main-207-,,0,0,0,,Leziz!Dialogue: 50,0:04:04.06,0:04:06.06,Main-207-,,0,0,0,,Dinleyin, halkım!Dialogue: 50,0:04:06.06,0:04:10.52,Main-207-,,0,0,0,,Bu ülkedeki her şey benim atıştırmalığımdır!Dialogue: 50,0:04:10.52,0:04:14.11,Main-207-,,0,0,0,,Ben harikayım!  Ve sizce neden?Dialogue: 50,0:04:14.11,0:04:16.28,Main-207-,,0,0,0,,Kuromarimo, anlat onlara!Dialogue: 50,0:04:17.07,0:04:21.20,Main-207-,,0,0,0,,Çünkü siz kralsınız, ekselansları.Dialogue: 50,0:04:21.20,0:04:24.04,Main-207-,,0,0,0,,Doğru! Bu kesinlikle doğru!Dialogue: 50,0:04:24.04,0:04:26.79,Main-207-,,0,0,0,,Ne de olsa, iyi pişmiş bir ev kızartması gibisi yoktur!Dialogue: 50,0:04:26.79,0:04:28.33,Main-207-,,0,0,0,,Evet!Dialogue: 50,0:04:28.33,0:04:30.75,Main-207-,,0,0,0,,Wapol-sama. Size söyleyeceklerim var.Dialogue: 50,0:04:30.75,0:04:31.46,Main-207-,,0,0,0,,Nedir?Dialogue: 50,0:04:31.46,0:04:34.59,Main-207-,,0,0,0,,Bir kaç Hasır Şapka'nın umarsızca...Dialogue: 50,0:04:34.59,0:04:38.42,Main-207-,,0,0,0,,...sizin Drum Şato'nuza yol aldığına dair raporlar aldım.Dialogue: 50,0:04:38.42,0:04:40.68,Main-207-,,0,0,0,,Ne? Neden?!Dialogue: 50,0:04:41.09,0:04:44.51,Main-207-,,0,0,0,,Hasta bir kadını, yukarıdaki doktora göstermeye gitmişler gibi duruyor.Dialogue: 50,0:04:44.51,0:04:46.10,Main-207-,,0,0,0,,Ahmak mı bunlar?!Dialogue: 50,0:04:46.10,0:04:49.81,Main-207-,,0,0,0,,Benim şatomda kimse yaşamıyor, hele bir doktor hiç!Dialogue: 50,0:04:50.94,0:04:56.61,Main-207-,,0,0,0,,Ş-şey... Duyduğum kadarıyla acımasız Dr. Kureha...Dialogue: 50,0:04:56.61,0:04:59.24,Main-207-,,0,0,0,,...daha da acımasızlaşarak, Drum Şato'suna yerleşmiş.Dialogue: 50,0:05:00.99,0:05:06.29,Main-207-,,0,0,0,,Ne?! O kart zampara benim kaleme mi geçmiş?!Dialogue: 50,0:05:06.29,0:05:08.45,Main-207-,,0,0,0,,Ne kadar daha benimle alay edebilecğeini sanıyor?!Dialogue: 50,0:05:08.45,0:05:09.58,Main-207-,,0,0,0,,Derhal dışarı atın!Dialogue: 50,0:05:10.33,0:05:13.75,Main-207-,,0,0,0,,Hasır Şapka ile birlikte,  hepsini tek hamlede yutacağım!Dialogue: 50,0:05:13.75,0:05:16.42,Main-207-,,0,0,0,,Vay be, şatoya geri dönüyoruz!Dialogue: 50,0:05:16.42,0:05:19.01,Main-207-,,0,0,0,,Evet!Dialogue: 50,0:05:19.01,0:05:20.01,Main-207-,,0,0,0,,Olduğunuz yerde kalın!Dialogue: 50,0:05:23.64,0:05:24.76,Main-207-,,0,0,0,,O kim?!Dialogue: 50,0:05:26.72,0:05:29.68,Main-207-,,0,0,0,,Ahh! Beni kesti! Öleceğim!Dialogue: 50,0:05:30.31,0:05:31.44,Main-207-,,0,0,0,,Dalton-san!Dialogue: 50,0:05:31.44,0:05:35.77,Main-207-,,0,0,0,,Buraya seni öldürmeye geldim. Ölüyorsan işime gelir.Dialogue: 50,0:05:35.77,0:05:37.53,Main-207-,,0,0,0,,Dalton, seni gidi pislik!Dialogue: 50,0:05:37.53,0:05:40.03,Main-207-,,0,0,0,,Yaşıyorsun!Dialogue: 50,0:05:40.03,0:05:41.49,Main-207-,,0,0,0,,Kral Wapol-sama'ya nasıl zarar vermeye cüret edersin!Dialogue: 50,0:05:41.49,0:05:45.83,Main-207-,,0,0,0,,Bir problem mi var ki? Bütün doktorlar emrinize amade değil mi?Dialogue: 50,0:05:45.83,0:05:49.50,Main-207-,,0,0,0,,Hani şu meşhur şifa adası olarak nitelendirilen Drum Ülkesi'nin doktorları?Dialogue: 50,0:05:49.50,0:05:51.00,Main-207-,,0,0,0,,Doğru diyorsun!Dialogue: 50,0:05:51.00,0:05:54.46,Main-207-,,0,0,0,,Issie 20 Travma Birimi!  Öne çıkın!Dialogue: 50,0:05:54.46,0:05:56.63,Main-207-,,0,0,0,,Operasyona başlayınDialogue: 50,0:05:55.54,0:05:57.50,Secondary-207-,,0,0,0,,Operasyona başlayınDialogue: 50,0:05:56.63,0:05:58.50,Main-207-,,0,0,0,,Operasyona başlayınDialogue: 50,0:05:57.50,0:05:59.51,Secondary-207-,,0,0,0,,Operasyona başlayınDialogue: 50,0:05:58.50,0:06:00.59,Main-207-,,0,0,0,,Operasyona başlayınDialogue: 50,0:05:59.51,0:06:01.42,Secondary-207-,,0,0,0,,Operasyona başlayınDialogue: 50,0:06:00.59,0:06:01.42,Main-207-,,0,0,0,,Operasyona başlayınDialogue: 50,0:06:01.42,0:06:02.22,Main-207-,,0,0,0,,Neşter.Dialogue: 50,0:06:02.22,0:06:02.80,Main-207-,,0,0,0,,İğne.Dialogue: 50,0:06:02.80,0:06:03.76,Main-207-,,0,0,0,,Teneke.Dialogue: 50,0:06:03.76,0:06:04.68,Main-207-,,0,0,0,,Çekiç.Dialogue: 50,0:06:05.18,0:06:07.97,Main-207-,,0,0,0,,Vaav... gerçekten öleceğim sandım!Dialogue: 50,0:06:08.97,0:06:11.23,Main-207-,,0,0,0,,İşte demek istediğim şey!Dialogue: 50,0:06:11.23,0:06:14.23,Main-207-,,0,0,0,,Bir tek sen korunurken halk...Dialogue: 50,0:06:14.23,0:06:17.94,Main-207-,,0,0,0,,...hastalıklarına bakacak doktorlardan yoksun, Wapol!Dialogue: 50,0:06:17.94,0:06:22.78,Main-207-,,0,0,0,,Ben kralın Dalton, sadık yandaşım. Wapol-sama diye hitap edeceksin!Dialogue: 50,0:06:22.78,0:06:26.41,Main-207-,,0,0,0,,Kulaklarını aç ve dinle, saçmalamaya hakkın yok!Dialogue: 50,0:06:26.41,0:06:30.41,Main-207-,,0,0,0,,Üçümüz, sen de dahil olmak üzere, Kral Wapol-sama'nın en üst düzey askerleriydik.Dialogue: 50,0:06:30.41,0:06:32.87,Main-207-,,0,0,0,,Onun sadık kollarıydık, hatırladın mı?Dialogue: 50,0:06:34.21,0:06:37.04,Main-207-,,0,0,0,,Haklısınız, siz insanlara acı çektirirken...Dialogue: 50,0:06:37.04,0:06:41.34,Main-207-,,0,0,0,,...benim tek yaptığım orada öylece durup yaptıklarınızı izlemek oldu!Dialogue: 50,0:06:41.34,0:06:44.09,Main-207-,,0,0,0,,Bunun sorumluluğunu ben almak durumundayım.Dialogue: 50,0:06:44.09,0:06:47.47,Main-207-,,0,0,0,,Wapol... izin ver bu ülkeden birlikte ayrılalım.Dialogue: 50,0:06:47.47,0:06:50.26,Main-207-,,0,0,0,,Artık bu ülkede bulunmamamız gerekiyor.Dialogue: 50,0:06:50.26,0:06:53.52,Main-207-,,0,0,0,,Dalton-san! Sen hiçbir şeyi yanlış yapmadın!Dialogue: 50,0:06:53.52,0:06:54.52,Main-207-,,0,0,0,,Doğru!Dialogue: 50,0:06:54.52,0:07:00.02,Main-207-,,0,0,0,,Hükümetin içinde halkı için savaşan bir tek sensin!Dialogue: 50,0:07:00.02,0:07:01.28,Main-207-,,0,0,0,,Bu hayatın pahasına olsa da!Dialogue: 50,0:07:01.28,0:07:06.74,Main-207-,,0,0,0,,Hah! Sen Drum Adası'nın Kraliyet Muhafızları Lideri olarak ölmeliydin!Dialogue: 50,0:07:06.74,0:07:10.20,Main-207-,,0,0,0,,Bu ülkede hiç doktor kalmamış olmasına rağmen hayatta kalabilmiş olmana şaşırdım.Dialogue: 50,0:07:10.20,0:07:14.33,Main-207-,,0,0,0,,Drum uluslararası mecrada,  yetkin tıbbi bilgisiyle tanınır.Dialogue: 50,0:07:14.33,0:07:17.46,Main-207-,,0,0,0,,Ama kim bilebilirdi ki, aslında sadece...Dialogue: 50,0:07:17.46,0:07:22.21,Main-207-,,0,0,0,,...kralın kalesindeki araştırma tesisinde çalışan yirmi doktor dışındaki...Dialogue: 50,0:07:22.21,0:07:26.18,Main-207-,,0,0,0,,...tüm doktorların sürgün edildiğini?Dialogue: 50,0:07:26.18,0:07:31.64,Main-207-,,0,0,0,,Çok doğru! O hasta olanlar hayatları için yalvarmayı öğrenmeliler.Dialogue: 50,0:07:31.64,0:07:36.10,Main-207-,,0,0,0,,Eğer içimden gelirse, belki onlara Issie 20'nin tadına baktırabilirim.Dialogue: 50,0:07:36.10,0:07:41.11,Main-207-,,0,0,0,,Eğer ölmek istemiyorlarsa tek yapmaları gereken bana, krallarına, itaat etmek!Dialogue: 50,0:07:41.11,0:07:46.07,Main-207-,,0,0,0,,Bu sayede, hükmüm mutlaktır. İşte bu ülkenin hükümeti bu!Dialogue: 50,0:07:46.07,0:07:48.82,Main-207-,,0,0,0,,Buna hükümet denmez!Dialogue: 50,0:07:48.82,0:07:52.16,Main-207-,,0,0,0,,Heh! Düşüncelerini dile getirmekten  sakınmıyorsun, değil mi?Dialogue: 50,0:07:52.16,0:07:56.21,Main-207-,,0,0,0,,Öldürün onu!  Eski liderinizi hemen öldürün!Dialogue: 50,0:07:56.21,0:07:59.71,Main-207-,,0,0,0,,Tahmin etmiştim, ne dediğimi anlayamıyorsun değil mi...Dialogue: 50,0:08:04.09,0:08:08.34,Main-207-,,0,0,0,,Sen önceki kralın oğlusun ki bana göre müthiş biriydi.Dialogue: 50,0:08:08.34,0:08:11.26,Main-207-,,0,0,0,,Her zaman bir gün  aklın başına gelir diye umdum...Dialogue: 50,0:08:11.26,0:08:12.89,Main-207-,,0,0,0,,...ama görünen o ki kendimi kandırıyormuşum!Dialogue: 50,0:08:12.89,0:08:15.39,Main-207-,,0,0,0,,Ahh! İşte geliyor! Ushi Ushi no Mi!Dialogue: 0,0:08:12.89,0:08:16.64,Note-207-,,0,0,0,,Ushi Ushi no Mi, Model: Bison -> Öküz Öküz Meyvesi, Model: BizonDialogue: 50,0:08:15.39,0:08:16.64,Main-207-,,0,0,0,,Model: BisonDialogue: 50,0:08:18.14,0:08:20.69,Main-207-,,0,0,0,,Korkmayın! Ateş edin!Dialogue: 50,0:08:23.61,0:08:24.56,Main-207-,,0,0,0,,Ona isabet ettiremiyoruz!Dialogue: 50,0:08:24.56,0:08:25.48,Main-207-,,0,0,0,,Hepsinden kaçıyor!Dialogue: 50,0:08:25.48,0:08:27.78,Main-207-,,0,0,0,,Hiç kimseye merhamet göstermeyeceğim, eski asklerim olsa bile!Dialogue: 50,0:08:30.36,0:08:32.58,Main-207-,,0,0,0,attack,Fiddle Banff!Dialogue: 50,0:08:30.36,0:08:32.58,Attack,,0,0,0,attack,Keman SaldırısıDialogue: 50,0:08:41.33,0:08:43.25,Main-207-,,0,0,0,,İnanılmaz! Ne güç ama..!Dialogue: 50,0:08:43.92,0:08:47.21,Main-207-,,0,0,0,,Demek zoan türü bir şeytan meyvesine sahip birinin gücü böyle bir şey!Dialogue: 50,0:08:47.59,0:08:50.22,Main-207-,,0,0,0,,Yeter artık sizden!Dialogue: 50,0:08:50.22,0:08:53.10,Main-207-,,0,0,0,,Kriz anında deli dana gibi kaçmaya başlayan...Dialogue: 50,0:08:53.10,0:08:55.43,Main-207-,,0,0,0,,...ilk kişi olan bir kralın oracıkta gebermesi gerekir!Dialogue: 50,0:08:55.43,0:08:58.93,Main-207-,,0,0,0,,İkimizin karşısında hiçbir şansın yok.Dialogue: 50,0:08:58.93,0:08:59.89,Main-207-,,0,0,0,,Pes et gitsin.Dialogue: 50,0:09:00.90,0:09:03.36,Main-207-,,0,0,0,,Dalton-san!Dialogue: 50,0:09:03.82,0:09:04.87,Main-207-,,0,0,0,,Dalton-san!Dialogue: 50,0:09:04.87,0:09:06.26,Main-207-,,0,0,0,,Sana yardım etmeye geldik!Dialogue: 50,0:09:06.36,0:09:07.85,Main-207-,,0,0,0,,İzin ver seninle sırt sırta savaşalım!Dialogue: 50,0:09:07.85,0:09:10.49,Main-207-,,0,0,0,,Bu ülkeyi özgürlük adına koruyacağız!Dialogue: 50,0:09:12.32,0:09:14.78,Main-207-,,0,0,0,,İşin doğrusu, seni uzun zamandır tanıyorum...Dialogue: 50,0:09:19.58,0:09:21.08,Main-207-,,0,0,0,,...senin için ne kadar talihsiz bir durum.Dialogue: 50,0:09:21.08,0:09:22.00,Main-207-,,0,0,0,,Sakın...!Dialogue: 50,0:09:22.00,0:09:24.38,Main-207-,,0,0,0,,Senin zayıf noktan...Dialogue: 50,0:09:37.72,0:09:40.14,Main-207-,,0,0,0,,– Neden... – ...kendini bize kalkan ettin...?Dialogue: 50,0:09:40.14,0:09:41.06,Main-207-,,0,0,0,,Dalton-san!Dialogue: 50,0:09:44.61,0:09:46.02,Main-207-,,0,0,0,,Dalton-san!Dialogue: 50,0:09:46.02,0:09:51.36,Main-207-,,0,0,0,,İşte senin zayıf noktan, seni iyi yürekli Dalton-kun.Dialogue: 50,0:09:51.36,0:09:53.07,Main-207-,,0,0,0,,İşte sana yakışan bir ölüm.Dialogue: 50,0:09:56.70,0:09:58.04,Main-207-,,0,0,0,,Ne-neler oluyor?!Dialogue: 50,0:09:58.04,0:10:00.50,Main-207-,,0,0,0,,Hm? Bu da ne? Deprem mi?Dialogue: 50,0:10:03.46,0:10:07.25,Main-207-,,0,0,0,,Hey, bu hiç iyi değil, kar çok  derinleştiğinden daha da ilerleyemeyiz!Dialogue: 50,0:10:07.25,0:10:09.71,Main-207-,,0,0,0,,Görünüşe göre dağa çıkabildik...Dialogue: 50,0:10:11.55,0:10:12.59,Main-207-,,0,0,0,,Ha?Dialogue: 50,0:10:12.59,0:10:15.64,Main-207-,,0,0,0,,Bu... sallantı da ne?Dialogue: 50,0:10:16.72,0:10:19.39,Main-207-,,0,0,0,,Usopp-san! Bu şey olabilir mi...?Dialogue: 50,0:10:20.31,0:10:23.35,Main-207-,,0,0,0,,Aaa... Ç... Çığ...?Dialogue: 50,0:10:24.02,0:10:26.02,Main-207-,,0,0,0,,25.631...Dialogue: 50,0:10:26.02,0:10:27.31,Main-207-,,0,0,0,,25.632...Dialogue: 50,0:10:27.31,0:10:30.03,Main-207-,,0,0,0,,25.633...!Dialogue: 50,0:10:31.28,0:10:33.53,Main-207-,,0,0,0,,Hm? Ne oluyor orada?  Ne kadar da gürültü çıkarıyor...Dialogue: 50,0:10:42.62,0:10:45.50,Main-207-,,0,0,0,,25.634!Dialogue: 50,0:10:46.79,0:10:50.50,Main-207-,,0,0,0,,Aaa! Şu lanet tavşanlar! Bir elime geçireyim onları! Hay!Dialogue: 50,0:10:50.50,0:10:53.97,Main-207-,,0,0,0,,N-n-n-ne yapacağız?! N-n-n-ne yapacağız, Sanji?!Dialogue: 50,0:10:54.63,0:10:55.63,Main-207-,,0,0,0,,Ben nereden bileyim?!Dialogue: 50,0:10:55.63,0:10:57.01,Main-207-,,0,0,0,,İlk önceliğimiz Nami-san!Dialogue: 50,0:10:57.01,0:10:57.55,Main-207-,,0,0,0,,İkinci önceliğimiz Nami-san!Dialogue: 50,0:10:57.55,0:10:58.39,Main-207-,,0,0,0,,Üçüncü önceliğimiz Nami-san!Dialogue: 50,0:10:58.39,0:10:59.14,Main-207-,,0,0,0,,Dördüncü önceliğimiz Nami-san!Dialogue: 50,0:10:59.14,0:10:59.93,Main-207-,,0,0,0,,Ve beşinci Nami-san!Dialogue: 50,0:10:59.93,0:11:01.64,Main-207-,,0,0,0,,Anlaşıldı mı?!Dialogue: 50,0:11:01.64,0:11:03.43,Main-207-,,0,0,0,,Hayatına bile mâl olsa onu koru!Dialogue: 50,0:11:03.43,0:11:05.48,Main-207-,,0,0,0,,Anlaşıldı!Dialogue: 50,0:11:05.48,0:11:07.69,Main-207-,,0,0,0,,Ama nasıl?!Dialogue: 50,0:11:13.57,0:11:15.78,Main-207-,,0,0,0,,İşte! Orada! Şu tepe!Dialogue: 50,0:11:15.78,0:11:16.86,Main-207-,,0,0,0,,Tepe mi?!Dialogue: 50,0:11:16.86,0:11:19.74,Main-207-,,0,0,0,,Fırla! Çıkabildiğimiz kadar tepeye çıkmalıyız!Dialogue: 50,0:11:21.66,0:11:22.70,Main-207-,,0,0,0,,Geliyor!Dialogue: 50,0:11:32.55,0:11:35.22,Main-207-,,0,0,0,,Güzel, başar–  Ahh!Dialogue: 50,0:11:35.76,0:11:38.22,Main-207-,,0,0,0,,Hayır!  Yeteri kadar yüksekte değiliz!Dialogue: 50,0:11:47.19,0:11:48.85,Main-207-,,0,0,0,,Şimdi ne yapacağım?!Dialogue: 50,0:11:49.27,0:11:50.81,Main-207-,,0,0,0,,Ah, evet!Dialogue: 50,0:11:52.78,0:11:55.49,Main-207-,,0,0,0,,Sanji! Elimi tut!Dialogue: 50,0:11:58.20,0:11:59.16,Main-207-,,0,0,0,,Beni kurtarabildin!Dialogue: 50,0:11:59.16,0:12:00.74,Main-207-,,0,0,0,,Evet, ama...Dialogue: 50,0:12:00.74,0:12:02.70,Main-207-,,0,0,0,,...karın içine batmayacak olsak da...Dialogue: 50,0:12:02.70,0:12:06.29,Main-207-,,0,0,0,,...hiçbir şey yapmazsak doğruca  dağdan aşağı düşeceğiz!Dialogue: 50,0:12:06.29,0:12:07.50,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:12:07.50,0:12:11.42,Main-207-,,0,0,0,,Asla olmaz! Onca yolu geldik ve neredeyse...Dialogue: 50,0:12:11.42,0:12:13.84,Main-207-,,0,0,0,,...o bacanın tepesindeydik!Dialogue: 50,0:12:13.84,0:12:15.97,Main-207-,,0,0,0,,Doktordan sadece bir adım gerideyiz!Dialogue: 50,0:12:15.97,0:12:18.93,Main-207-,,0,0,0,,Luffy! Bunu durdurmanın bir yolunu bul!Dialogue: 50,0:12:19.64,0:12:22.30,Main-207-,,0,0,0,,Hay lanet... Şu uyuz tavşanlar!Dialogue: 50,0:12:22.30,0:12:24.72,Main-207-,,0,0,0,,Onları bir daha görecek olursam, hepsini bir tencerede kaynatacağım!Dialogue: 50,0:12:24.72,0:12:25.39,Main-207-,,0,0,0,,Ah...!Dialogue: 50,0:12:25.39,0:12:27.35,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:12:38.61,0:12:39.82,Main-207-,,0,0,0,,Ne yapacağız, Sanji?!Dialogue: 50,0:12:39.82,0:12:42.91,Main-207-,,0,0,0,,Tek bir yol var!Dialogue: 50,0:12:42.91,0:12:45.20,Main-207-,,0,0,0,,Koş!Dialogue: 50,0:12:47.04,0:12:50.17,Main-207-,,0,0,0,,Onların... problemi ne?!Dialogue: 50,0:12:55.09,0:12:57.97,Main-207-,,0,0,0,,Oh hayır, Luffy! Bak! Öndekine bak!Dialogue: 50,0:12:59.05,0:13:02.05,Main-207-,,0,0,0,,AAA! KAYA! ÇAKILACAĞIZ!Dialogue: 50,0:13:06.22,0:13:11.23,Main-207-,,0,0,0,,Sen çakılamazsın! Nami-san senin sırtında!Dialogue: 50,0:13:20.74,0:13:22.74,Main-207-,,0,0,0,,Çarpıyoruz!Dialogue: 50,0:13:24.74,0:13:28.95,Main-207-,,0,0,0,,Hanımlara...nazik...davranmalısın!Dialogue: 50,0:13:29.54,0:13:31.46,Main-207-,,0,0,0,,Sanji!Dialogue: 50,0:13:43.93,0:13:45.18,Main-207-,,0,0,0,,Sanji!Dialogue: 50,0:13:46.10,0:13:47.97,Main-207-,,0,0,0,,Off... Bana fena çarptı...! Aman be!Dialogue: 50,0:13:47.97,0:13:54.65,Main-207-,,0,0,0,,Ahmak! Bana söylemeden saçma sapan şeylere kalkışma!Dialogue: 50,0:13:57.65,0:13:59.86,Main-207-,,0,0,0,,AAAA! Sanji!Dialogue: 50,0:13:59.86,0:14:04.53,Secondary-207-,,0,0,0,,Sanji!Dialogue: 50,0:14:01.36,0:14:04.53,Secondary-207-,,0,0,0,,Sanji!Dialogue: 50,0:14:10.37,0:14:13.67,Main-207-,,0,0,0,,– Aah! geliyor! – Duracağı yok!Dialogue: 50,0:14:13.67,0:14:15.33,Main-207-,,0,0,0,,Tüm köyü yutacak!Dialogue: 50,0:14:15.33,0:14:16.34,Main-207-,,0,0,0,,Kaçın buradan!Dialogue: 50,0:14:19.80,0:14:23.26,Main-207-,,0,0,0,,Buradan hemen gidiyoruz! Chess! Kuromarimo! Atlayın!Dialogue: 50,0:14:23.26,0:14:24.55,Main-207-,,0,0,0,,Robson!Dialogue: 50,0:14:24.55,0:14:28.43,Main-207-,,0,0,0,,Robson, Ciddi Mod!Dialogue: 50,0:14:28.43,0:14:31.93,Main-207-,,0,0,0,,Wapol-sama!  Lütfen bizim de binmemize izin verin!Dialogue: 50,0:14:31.93,0:14:35.81,Main-207-,,0,0,0,,Kesin sesinizi! Kendi kendinizi kurtarmanın bir yolunu bulun!Dialogue: 50,0:14:36.61,0:14:40.28,Main-207-,,0,0,0,,Robson! Acele et! Çok yaklaştı!Dialogue: 50,0:14:42.40,0:14:46.99,Main-207-,,0,0,0,,İ-İ-İ-İ-İ-İ-İ-İ-İ-İ-İyi olacağız! Endişelenme, Vivi!Dialogue: 50,0:14:46.99,0:14:50.74,Main-207-,,0,0,0,,Yutulmuş olsak bile, seni kesin kurtaracağım!Dialogue: 50,0:14:50.74,0:14:53.91,Main-207-,,0,0,0,,Hey, Luffy-san ve diğerleri sence...Dialogue: 50,0:14:56.29,0:14:58.88,Main-207-,,0,0,0,,...çığ tarafından yutulmuş olabilirler mi?Dialogue: 50,0:14:59.75,0:15:02.92,Main-207-,,0,0,0,,Ahhh! Majesteleri!Dialogue: 50,0:15:02.92,0:15:04.51,Main-207-,,0,0,0,,Ahh!Dialogue: 50,0:15:03.30,0:15:04.51,Main-207-,,0,0,0,,Ahh!Dialogue: 50,0:15:03.67,0:15:04.51,Main-207-,,0,0,0,,Ahh!Dialogue: 50,0:15:04.51,0:15:06.72,Main-207-,,0,0,0,,Ahhhhh!Dialogue: 50,0:16:12.74,0:16:16.16,Main-207-,,0,0,0,,Nami, üşüyor musun? Biraz daha dayan.Dialogue: 50,0:16:17.29,0:16:20.79,Main-207-,,0,0,0,,Dinle. Şunu sıkıca tut. Burada dur ve beni biraz daha bekle.Dialogue: 50,0:16:45.73,0:16:47.95,Main-207-,,0,0,0,,Oh, demek sizdiniz.Dialogue: 50,0:16:47.95,0:16:50.78,Main-207-,,0,0,0,,Ağzıma neden tuhaf bi şurup tadı geldiğine şaşmamalı.Dialogue: 50,0:16:50.78,0:16:52.74,Main-207-,,0,0,0,,Bundan asla sıyrılamayacaklar!Dialogue: 50,0:16:52.74,0:16:53.99,Main-207-,,0,0,0,,Kimden bahsediyorsun?Dialogue: 50,0:16:53.99,0:16:56.79,Main-207-,,0,0,0,,Onlardan tabii ki!Dialogue: 50,0:16:56.79,0:16:58.46,Main-207-,,0,0,0,,"Onlar" dediğin...?Dialogue: 50,0:16:58.46,0:17:02.21,Main-207-,,0,0,0,,Bazı Hasır Şapkaların dağın tepesine...Dialogue: 50,0:17:02.21,0:17:05.17,Main-207-,,0,0,0,,...kaleye doğru gittiğini söylemiştin ve sonra bu oldu!Dialogue: 50,0:17:06.46,0:17:09.51,Main-207-,,0,0,0,,Olanlar yüzünden, aramızda bir husumet var...Dialogue: 50,0:17:09.51,0:17:12.47,Main-207-,,0,0,0,,...bu yüzden o kar kaplı dağdan çığ yağdırdılar!Dialogue: 50,0:17:14.05,0:17:16.60,Main-207-,,0,0,0,,Olamaz!  Olanlar bu yüzden miydi?Dialogue: 50,0:17:16.60,0:17:19.56,Main-207-,,0,0,0,,Yani, bu çığ onların suçuydu..Dialogue: 50,0:17:19.56,0:17:22.02,Main-207-,,0,0,0,,Haydi gidelim! Onları karlı dağlara kadar takip edeceğiz!Dialogue: 50,0:17:22.02,0:17:26.65,Main-207-,,0,0,0,,Onlara kar içinde savaşmak konusunda, iyi bir ders vereceğim.Dialogue: 50,0:18:32.01,0:18:34.68,Main-207-,,0,0,0,,Sizi kesinlikle oraya çıkaracağım.Dialogue: 50,0:18:34.68,0:18:37.05,Main-207-,,0,0,0,,Sakın öleyim demeyin...Dialogue: 50,0:18:38.26,0:18:39.60,Main-207-,,0,0,0,,İkiniz de...Dialogue: 50,0:18:45.06,0:18:46.06,Main-207-,,0,0,0,,İşte oradalar!Dialogue: 50,0:18:46.06,0:18:49.02,Main-207-,,0,0,0,,Bakın, Wapol-sama! Onları bulduk!Dialogue: 50,0:18:49.48,0:18:51.49,Main-207-,,0,0,0,,Bekle, velet!Dialogue: 50,0:18:51.49,0:18:54.24,Main-207-,,0,0,0,,Bu kadar saygısızlığın affedilemez!Dialogue: 50,0:18:54.24,0:18:56.20,Main-207-,,0,0,0,,Bunu ödeyeceksin!Dialogue: 50,0:19:04.71,0:19:05.75,Main-207-,,0,0,0,,Çekil yolumdan.Dialogue: 50,0:19:05.75,0:19:07.75,Main-207-,,0,0,0,,Hey! Aygır!Dialogue: 50,0:19:07.75,0:19:09.71,Main-207-,,0,0,0,,Neden yolundan çekilecekmişim?!Dialogue: 50,0:19:10.21,0:19:14.63,Main-207-,,0,0,0,,Görünüşe göre sırtındaki ve kolunun altındakiler yarı ölü.Dialogue: 50,0:19:22.31,0:19:23.27,Main-207-,,0,0,0,,Hey bekle!Dialogue: 50,0:19:23.27,0:19:25.44,Main-207-,,0,0,0,,Oh, evet biliyorum!Dialogue: 50,0:19:25.44,0:19:28.31,Main-207-,,0,0,0,,Chess!  Aklıma yeni bir yasa geldi.Dialogue: 50,0:19:28.31,0:19:29.65,Main-207-,,0,0,0,,Bunu hemen yaz!Dialogue: 50,0:19:29.06,0:19:29.65,Secondary-207-,,0,0,0,,Yes, efendim!Dialogue: 50,0:19:29.65,0:19:33.44,Main-207-,,0,0,0,,Kralın varlığını yok sayanlar idam edilecektir!Dialogue: 50,0:19:36.20,0:19:38.66,Main-207-,,0,0,0,,Kanun çıkar çıkmaz uymamaya mı başladın?!Dialogue: 50,0:19:38.66,0:19:43.83,Main-207-,,0,0,0,,İkiniz! Öncelikle hasta ve sakat olanı öldürün! En çok onlar beni umursamıyor!Dialogue: 50,0:19:43.83,0:19:44.75,Main-207-,,0,0,0,,–Evet, efendim! –Evet, efendim!Dialogue: 50,0:19:44.75,0:19:46.25,Main-207-,,0,0,0,,Ne dedin sen ?!Dialogue: 50,0:19:47.71,0:19:49.38,Main-207-,,0,0,0,,Ben sırtındaki kadını alırım!Dialogue: 50,0:19:49.38,0:19:51.09,Main-207-,,0,0,0,,Ben adamı alıyorum!Dialogue: 50,0:19:52.67,0:19:55.05,Main-207-,,0,0,0,,Al bakalım! Marimo's Surprise!Dialogue: 0,0:19:53.70,0:19:55.05,Attack,,0,0,0,,Marimo'nun Sürprizi!Dialogue: 50,0:19:59.76,0:20:00.76,Flashbacks-207-,,0,0,0,,Dinle, Luffy!Dialogue: 50,0:20:00.76,0:20:03.22,Flashbacks-207-,,0,0,0,,Sakın onlarla dövüşmeye kalkma!Dialogue: 50,0:20:03.22,0:20:07.14,Flashbacks-207-,,0,0,0,,Saldırır veya saldırı alırsan...Dialogue: 50,0:20:07.14,0:20:11.31,Flashbacks-207-,,0,0,0,,...Nami-san da aynı darbeyi hissedecektir!Dialogue: 50,0:20:14.57,0:20:16.32,Main-207-,,0,0,0,,Senin ben!Dialogue: 50,0:20:16.32,0:20:19.28,Main-207-,,0,0,0,,Buna pişman olacaksın!Dialogue: 50,0:20:19.28,0:20:21.16,Main-207-,,0,0,0,,Beni takip etmeyin!Dialogue: 50,0:20:22.53,0:20:26.04,Main-207-,,0,0,0,,Hıh. Ne korkak ama... Hiçbir faydası yok!Dialogue: 50,0:20:31.88,0:20:34.17,Main-207-,,0,0,0,,Ona göstereceğim...Dialogue: 50,0:20:34.17,0:20:37.17,Main-207-,,0,0,0,,Karda savaşmanın nasıl bir şey olduğunu ona göstereceğim...Dialogue: 50,0:20:44.89,0:20:48.02,Main-207-,,0,0,0,,He...? Gittiler...Dialogue: 50,0:20:48.02,0:20:50.98,Main-207-,,0,0,0,,Neler oluyor? Acaba pes mi ettiler...Dialogue: 50,0:20:55.53,0:20:57.53,Main-207-,,0,0,0,,İşte bu gerçek bir kar savaşı!Dialogue: 50,0:20:57.53,0:21:00.11,Main-207-,,0,0,0,,Beyaz kılık! Snow Powder Makeup!Dialogue: 0,0:20:57.53,0:21:00.11,Attack,,0,0,0,,Beyaz Pudra Makyajı!Dialogue: 50,0:21:00.11,0:21:03.78,Main-207-,,0,0,0,,Çok zayıflar, tek atışa ölmüş olacaklar.Dialogue: 50,0:21:05.12,0:21:06.66,Main-207-,,0,0,0,,Şah mat!Dialogue: 50,0:21:06.66,0:21:10.75,Main-207-,,0,0,0,,Durun!Dialogue: 50,0:21:16.55,0:21:18.05,Main-207-,,0,0,0,,Kutup ayıları...Dialogue: 50,0:21:21.38,0:21:23.35,Main-207-,,0,0,0,,Tavşanlar mı?!Dialogue: 50,0:21:25.76,0:21:27.77,Main-207-,,0,0,0,,Onu korudular mı?Dialogue: 50,0:21:27.77,0:21:32.65,Main-207-,,0,0,0,,Sadece tesadüf. Tavşanlar asla bir insan ile bağ kurmazlar.Dialogue: 50,0:21:44.37,0:21:46.33,Main-207-,,0,0,0,,Teşekkürler!  Beni kurtardınız!Dialogue: 50,0:21:50.37,0:21:51.75,Main-207-,,0,0,0,,Gitmesine izin vermeyin!Dialogue: 50,0:21:51.75,0:21:52.62,Main-207-,,0,0,0,,– Evet, majesteleri! – Evet, majesteleri!Dialogue: 50,0:22:04.30,0:22:07.85,Main-207-,,0,0,0,,Ne halt yediklerini sanıyor onlar!Dialogue: 50,0:22:23.49,0:22:25.49,Main-207-,,0,0,0,,Doktor...Dialogue: 50,0:22:28.99,0:22:30.20,Main-207-,,0,0,0,,Doktor...Dialogue: 50,0:22:33.50,0:22:35.21,Main-207-,,0,0,0,,Doktor...Dialogue: 50,0:22:43.17,0:22:45.72,Main-207-,,0,0,0,,Demek burası...Dialogue: 50,0:22:46.14,0:22:48.85,Main-207-,,0,0,0,,Ucunu göremiyorum.Dialogue: 50,0:22:53.52,0:22:57.65,Main-207-,,0,0,0,,Doktoru orada... tepede bulabilirim.Dialogue: 50,0:22:59.82,0:23:03.78,Main-207-,,0,0,0,,Biraz daha dayanın... Nami! Sanji!Dialogue: 50,0:23:53.50,0:23:54.83,Main-207-,,0,0,0,,Çığ...Dialogue: 50,0:23:57.33,0:23:59.92,Main-207-,,0,0,0,,Çığ tarafından yutulduk...Dialogue: 50,0:23:59.92,0:24:01.80,Main-207-,,0,0,0,,Ah! U... Usopp-san?!Dialogue: 50,0:24:01.80,0:24:03.92,Main-207-,,0,0,0,,Usopp-san!Dialogue: 50,0:24:06.51,0:24:10.80,Main-207-,,0,0,0,,Usopp-san! Hadi! Uyan!Dialogue: 50,0:24:12.31,0:24:14.14,Main-207-,,0,0,0,,Hala yaşıyor!Dialogue: 50,0:24:14.14,0:24:16.64,Main-207-,,0,0,0,,Usopp-san! Dayan!Dialogue: 50,0:24:20.90,0:24:22.86,Main-207-,,0,0,0,,Hadi! Usopp-san!Dialogue: 50,0:24:22.86,0:24:24.40,Main-207-,,0,0,0,,Usopp-san!Dialogue: 50,0:24:24.48,0:24:26.78,Main-207-,,0,0,0,,Oh, Vivi... Beni uyandırma.Dialogue: 50,0:24:26.78,0:24:28.99,Main-207-,,0,0,0,,Harika bir rüya görüyordum.Dialogue: 50,0:24:28.99,0:24:33.83,Main-207-,,0,0,0,,Bu dünyanın dışında, harika çiçekler ve harika bir dere... Oh?Dialogue: 50,0:24:33.83,0:24:35.91,Main-207-,,0,0,0,,NEREDEYSE SONRAKİ HAYATA GEÇMİŞSİN!Dialogue: 50,0:24:34.45,0:24:35.91,Secondary-207-,,0,0,0,,O derede yüzen Zoro değil mi...?Dialogue: 50,0:24:35.91,0:24:37.79,Main-207-,,0,0,0,,UYAN! SAKIN UYUMA! UYAN!Dialogue: 50,0:24:35.91,0:24:37.79,Secondary-207-,,0,0,0,,O derede yüzen Zoro değil mi...?Dialogue: 50,0:24:40.67,0:24:45.80,Main-207-,,0,0,0,,Bütün 74.000 Usopp Korsanları, yaklaşın!Dialogue: 50,0:24:45.80,0:24:51.89,Main-207-,,0,0,0,,Hayır! Uyan! Usopp-san, ölme! Usopp-san!Dialogue: 50,0:24:51.89,0:24:56.43,Main-207-,,0,0,0,,Usopp-san! Usopp-san! Usopp-san! Usopp-san! Usopp-san! Usopp-san!Dialogue: 50,0:24:56.43,0:24:59.39,Main-207-,,0,0,0,,Vaaay, beni gerçekten kurtardın, Vivi.Dialogue: 50,0:24:59.39,0:25:01.40,Main-207-,,0,0,0,,Tam olarak ölümün kıyısından döndüm.Dialogue: 50,0:25:01.40,0:25:03.19,Main-207-,,0,0,0,,Yaşadığıma minnettarım.Dialogue: 50,0:25:03.19,0:25:03.77,Main-207-,,0,0,0,,Ama...Dialogue: 50,0:25:03.77,0:25:06.57,Main-207-,,0,0,0,,Sence de yüzüm biraz şişmiş gibi değil mi?Dialogue: 50,0:25:06.57,0:25:08.57,Main-207-,,0,0,0,,B-b-buz kesmesi o! Buz kesmesi!Dialogue: 50,0:25:07.57,0:25:10.78,Secondary-207-,,0,0,0,,Kafam biraz ağırlaşmış gibi geliyor...Dialogue: 50,0:25:08.57,0:25:10.78,Main-207-,,0,0,0,,İşte bu yüzden karda olmak o kadar kolay bir şey değil.Dialogue: 50,0:25:10.78,0:25:12.32,Secondary-207-,,0,0,0,,Görüş açım da biraz dar duruyor, tuhaf...Dialogue: 50,0:25:12.32,0:25:13.28,Main-207-,,0,0,0,,Asıl şu var...Dialogue: 50,0:25:12.32,0:25:14.20,Secondary-207-,,0,0,0,,...dudaklarım kocaman...Dialogue: 50,0:25:14.20,0:25:16.75,Secondary-207-,,0,0,0,,Sanki... evet, kesinlikle...Dialogue: 50,0:25:13.28,0:25:15.83,Main-207-,,0,0,0,,...nerede olduğumuzu bulmak zorundayız.Dialogue: 50,0:25:20.46,0:25:23.71,Main-207-,,0,0,0,,AAAA! BU DA NE!Dialogue: 50,0:25:23.71,0:25:27.46,Main-207-,,0,0,0,,Of... Bu çok yakındı...harika çiçeklerin olduğu bir yer görüyordum.Dialogue: 50,0:25:30.55,0:25:34.14,Main-207-,,0,0,0,,Bir anda bu soğukta bir çığa yakalanmak... Şansım yavet gitmemiş gibi duruyor.Dialogue: 50,0:25:34.14,0:25:37.10,Main-207-,,0,0,0,,Ama sanıyorum, bu da kış yüzmesinin bir parçası oluyor.Dialogue: 50,0:25:37.10,0:25:38.06,Main-207-,,0,0,0,,Zoro.Dialogue: 50,0:25:38.06,0:25:40.06,Main-207-,,0,0,0,,Hm? Oh, Vivi.Dialogue: 50,0:25:41.14,0:25:42.02,Main-207-,,0,0,0,,Huh?Dialogue: 50,0:25:46.61,0:25:50.40,Main-207-,,0,0,0,,Oh, demek sensin Usopp! Burada ne arıyorsunuz?Dialogue: 50,0:25:50.40,0:25:52.20,Main-207-,,0,0,0,,– BUNU ASIL BEN SORUYORUM! – BUNU ASIL BEN SORUYORUM!Dialogue: 50,0:25:55.16,0:25:57.45,Main-207-,,0,0,0,,Amma da aptallar!Dialogue: 50,0:25:57.45,0:26:01.75,Main-207-,,0,0,0,,Kralınıza karşı gelirseniz alacağınız işte bu olur sizi ezik tavşanlar!Dialogue: 50,0:26:01.75,0:26:07.75,Main-207-,,0,0,0,,Hah! Yine de gerçek yıkıcı gücümü bir kısım tavşan için kullanmam gerekeceğini düşünmezdim.Dialogue: 50,0:26:07.75,0:26:12.09,Main-207-,,0,0,0,,Drum'daki en vahşi hayvan oldukları  düşünülürse, yapacak bir şey yoktu.Dialogue: 50,0:26:14.05,0:26:18.39,Main-207-,,0,0,0,,Bekle beni... Hasır Şapka!Dialogue: 50,0:26:26.94,0:26:29.28,Main-207-,,0,0,0,,Doktor...!Dialogue: 50,0:26:33.70,0:26:36.91,Main-207-,,0,0,0,,D... Doktor...!Dialogue: 50,0:26:53.30,0:26:55.93,Main-207-,,0,0,0,,Doktor...!Dialogue: 50,0:26:57.39,0:26:59.43,Main-207-,,0,0,0,,Ah! Off!Dialogue: 50,0:27:01.14,0:27:06.10,Main-207-,,0,0,0,,Sanji!!!Dialogue: 50,0:27:14.24,0:27:17.78,Main-207-,,0,0,0,,B-bu... Bu çok yakındı...Dialogue: 50,0:27:20.99,0:27:22.45,Main-207-,,0,0,0,,Kış yüzmesi mi?!Dialogue: 50,0:27:22.45,0:27:25.12,Main-207-,,0,0,0,,Evet. Derede biraz  yüzdükten sonra...Dialogue: 50,0:27:25.12,0:27:27.58,Main-207-,,0,0,0,,Nerede olduğum konusunda bir fikrim yoktu.Dialogue: 0,0:27:25.12,0:27:27.58,Note-207-,,0,0,0,,Ç.N: Bu sefer yüzerek kaybolmuş.Dialogue: 50,0:27:27.58,0:27:29.67,Main-207-,,0,0,0,,Geri dönüş yolu için yürürken, boş kalmayıp antrenmana devam edeyim dedim.Dialogue: 50,0:27:29.67,0:27:31.30,Main-207-,,0,0,0,,Ve sonra bi ormana rastladım.Dialogue: 50,0:27:31.30,0:27:34.38,Main-207-,,0,0,0,,Bu şekilde giyinmiş haldeyken mi? Salak mısın sen?Dialogue: 50,0:27:34.38,0:27:37.64,Main-207-,,0,0,0,,Her neyse işte,  ceketini ver, Usopp.Dialogue: 50,0:27:37.64,0:27:39.10,Main-207-,,0,0,0,,Asla!Dialogue: 50,0:27:39.10,0:27:43.18,Thoughts-207-,,0,0,0,,Nami-san mental yorgunluktan  dolayı hastalanmış olabilir...Dialogue: 50,0:27:43.18,0:27:45.10,Main-207-,,0,0,0,,O halde ayakkabılarını ver!Dialogue: 50,0:27:44.18,0:27:45.10,Secondary-207-,,0,0,0,,Hayır!Dialogue: 50,0:27:45.10,0:27:46.77,Main-207-,,0,0,0,,HERHANGİ BİR ŞEY VER!Dialogue: 50,0:27:45.56,0:27:46.77,Secondary-207-,,0,0,0,,HAYIR!Dialogue: 50,0:27:46.77,0:27:48.15,Main-207-,,0,0,0,,Bu senin hatandı, değil mi?!Dialogue: 50,0:27:49.15,0:27:51.32,Main-207-,,0,0,0,,Şuraya bakın!  İnsanlar var.Dialogue: 50,0:27:51.32,0:27:52.11,Main-207-,,0,0,0,,Hm?Dialogue: 50,0:27:53.69,0:27:57.86,Main-207-,,0,0,0,,Hey... o binaları hatırlıyorum...Dialogue: 50,0:27:57.86,0:27:59.12,Main-207-,,0,0,0,,Ne?Dialogue: 50,0:27:59.87,0:28:05.83,Main-207-,,0,0,0,,Haklısın! Burası Bighorn! Yani biz... bir daire çizdik!Dialogue: 50,0:28:06.50,0:28:08.83,Main-207-,,0,0,0,,Geri çekilin! Geri çekilin!Dialogue: 50,0:28:10.42,0:28:12.42,Main-207-,,0,0,0,,Dalton çoktan öldü!Dialogue: 50,0:28:12.42,0:28:15.42,Main-207-,,0,0,0,,Dalton-san'ın öyle bir saldırıdan ölmesinin imkanı yok!Dialogue: 50,0:28:15.42,0:28:18.26,Main-207-,,0,0,0,,Sizler eskiden Dalton'un emrinde hizmet ediyordunuz, değil mi?Dialogue: 50,0:28:18.26,0:28:19.89,Main-207-,,0,0,0,,Hiç mi umurunuzda değil?!Dialogue: 50,0:28:19.89,0:28:22.76,Main-207-,,0,0,0,,Bizler Kral Wapol'un emrindeki askerleriz!Dialogue: 50,0:28:22.76,0:28:25.60,Main-207-,,0,0,0,,Eğer Kral Wapol'un düşmanı olursanız, bu ölümünüz olur!Dialogue: 50,0:28:25.60,0:28:27.35,Main-207-,,0,0,0,,Hey, sorun ne?Dialogue: 50,0:28:27.35,0:28:29.31,Main-207-,,0,0,0,,So-sorun nedir mi?Dialogue: 50,0:28:30.31,0:28:33.27,Main-207-,,0,0,0,,Asıl senin sorunun ne, kıyafetlerin nerede?!Dialogue: 50,0:28:33.27,0:28:37.15,Main-207-,,0,0,0,,Dalton-san çığ yüzünden karlar altına gömüldü.Dialogue: 50,0:28:37.15,0:28:38.32,Main-207-,,0,0,0,,Ne?!Dialogue: 50,0:28:38.32,0:28:39.99,Main-207-,,0,0,0,,Dalton-san gömüldü?!Dialogue: 50,0:28:39.99,0:28:44.41,Main-207-,,0,0,0,,Evet. Şu adamlar yolumuzu kestiği için onu kazıp çıkaramıyoruz da.Dialogue: 50,0:28:44.41,0:28:46.83,Main-207-,,0,0,0,,Geri çekilin! Geri çekilin!Dialogue: 50,0:28:47.37,0:28:51.79,Main-207-,,0,0,0,,İtirazı olan varsa, çıksın ve kendini göstersin!Dialogue: 50,0:28:53.46,0:28:56.59,Main-207-,,0,0,0,,Usopp, kıyafetlerini hatırlıyorum.Dialogue: 50,0:28:56.59,0:28:59.93,Main-207-,,0,0,0,,Bize denizdeyken saldıran onlardı, değil mi?Dialogue: 50,0:29:00.64,0:29:01.43,Main-207-,,0,0,0,,Aynen?!Dialogue: 50,0:29:01.43,0:29:03.10,Main-207-,,0,0,0,,Evet, doğru.Dialogue: 50,0:29:03.10,0:29:04.39,Main-207-,,0,0,0,,Onlar düşman, değil mi?Dialogue: 50,0:29:03.89,0:29:04.39,Secondary-207-,,0,0,0,,Ha?Dialogue: 50,0:29:04.39,0:29:06.52,Main-207-,,0,0,0,,Düşman diyorum. Onlar düşman mı, değil mi?Dialogue: 50,0:29:05.18,0:29:06.06,Secondary-207-,,0,0,0,,Nasıl yani?Dialogue: 50,0:29:06.52,0:29:09.85,Main-207-,,0,0,0,,Evet, onlar bizim düşmanımız... ama neden bu kadar..?Dialogue: 50,0:29:12.77,0:29:15.78,Main-207-,,0,0,0,,Dalton olmadan o kadar da cesur değilsiniz, değil mi?Dialogue: 50,0:29:21.53,0:29:24.12,Main-207-,,0,0,0,,Ne?! Bay Bushido!Dialogue: 50,0:29:25.37,0:29:26.33,Main-207-,,0,0,0,,O kim?!Dialogue: 50,0:29:26.33,0:29:29.91,Main-207-,,0,0,0,,Hey sen! Orada dur! Onlara saldırırsan, sana...Dialogue: 50,0:29:32.79,0:29:34.88,Main-207-,,0,0,0,,Baya sıcak tutuyor! Bunu ödünç alıyorum.Dialogue: 50,0:29:35.42,0:29:37.84,Main-207-,,0,0,0,,Lan... bunun için mi o soruyu bana..?!Dialogue: 50,0:29:38.42,0:29:41.34,Main-207-,,0,0,0,,Bak! Çok sinirliler!Dialogue: 50,0:29:40.34,0:29:41.34,Secondary-207-,,0,0,0,,Sen!Dialogue: 50,0:29:41.34,0:29:43.80,Main-207-,,0,0,0,,Sen Wapol-sama'yı uçuranların gemisindeydin!Dialogue: 50,0:29:44.97,0:29:47.31,Main-207-,,0,0,0,,Oof.. Siz, beyler, asla öğrenmiyorsunuz, değil mi?Dialogue: 50,0:29:48.06,0:29:52.85,Main-207-,,0,0,0,,Doktor... Doktor...Dialogue: 50,0:29:53.98,0:29:56.73,Main-207-,,0,0,0,,Doktor...Dialogue: 50,0:30:49.79,0:30:53.96,Thoughts-207-,,0,0,0,,Dayanın. Neredeyse vardık.Dialogue: 50,0:30:53.96,0:30:56.92,Thoughts-207-,,0,0,0,,Sakın öleyim demeyin!Dialogue: 50,0:32:27.38,0:32:29.76,Main-207-,,0,0,0,,Başardık...Dialogue: 50,0:32:39.48,0:32:40.77,Main-207-,,0,0,0,,Doktor...Dialogue: 50,0:33:11.26,0:33:14.43,Main-207-,,0,0,0,,Doktorine... antibiyotikler etkisini gösteriyor.Dialogue: 50,0:33:14.43,0:33:18.10,Main-207-,,0,0,0,,Evet, o kadarını anladım.Dialogue: 50,0:33:18.10,0:33:21.90,Main-207-,,0,0,0,,O halde, sebep ne?  Açıkla bakalım.Dialogue: 50,0:33:21.90,0:33:23.56,Main-207-,,0,0,0,,Kestia.Dialogue: 0,0:33:21.90,0:33:23.56,Note-207-,,0,0,0,,Kestia: Bir tür kene.Dialogue: 50,0:33:24.98,0:33:27.11,Main-207-,,0,0,0,,Çok doğru. Bunu yapan bir kestia idi.Dialogue: 50,0:33:27.11,0:33:29.57,Main-207-,,0,0,0,,Sen git kızla ilgilen.Dialogue: 50,0:33:29.57,0:33:30.78,Main-207-,,0,0,0,,Tamamdır.Dialogue: 50,0:34:02.77,0:34:03.85,Main-207-,,0,0,0,,Kimsin..?Dialogue: 0,0:01:49.96,0:01:55.18,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Zyrecon thx to onepace.netDialogue: 0,0:15:16.00,0:15:26.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Zyrecon thx to onepace.netDialogue: 0,0:34:23.50,0:34:29.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Zyrecon thx to onepace.netDialogue: 0,0:01:49.96,0:01:55.18,Title