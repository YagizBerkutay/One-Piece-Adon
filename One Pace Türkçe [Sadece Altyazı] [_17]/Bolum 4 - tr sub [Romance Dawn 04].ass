8,23,23,23,1Style: Lyrics-furigana,Duality,36,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,2.95,0,2,23,23,34,1Style: Lyrics,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,2,23,23,34,1Style: Karaoke,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,23,1Style: Kanji,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,146,1Style: Roger-Monologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1Style: Romaji ED,Josefin Sans,82,&H00FFFFFF,&H003592BE,&H00000000,&H64000000,0,0,0,0,100,100,0,0,1,0,4,8,10,10,20,1Style: Translation ED,Josefin Sans,82,&H00FFFFFF,&H000000FF,&H00FFFFFF,&H64000000,0,0,0,0,100,100,0,0,1,0,4,2,10,10,20,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Your media player does not support the subtitle format used in this episode. Subtitles will likely not function properly. Please use one of the recommended video players, preferably mpv: https://mpv.ioDialogue: 0,0:02:16.16,0:02:26.17,Warning,,0,0,0,,Your media player does not support the subtitle format used in this episode. Subtitles will likely not function properly. Please use one of the recommended video players, preferably mpv: https://mpv.ioDialogue: 50,0:01:52.30,0:01:54.09,Main-207-,,0,0,0,,N-Ne?!Dialogue: 50,0:01:54.09,0:01:56.35,Main-207-,,0,0,0,,Korsanlar Kralı mı?!Dialogue: 50,0:01:56.35,0:01:59.02,Main-207-,,0,0,0,,Bunun ne anlama geldiğini biliyor musun?Dialogue: 50,0:01:59.39,0:02:01.06,Main-207-,,0,0,0,,Ben de şok oldum!Dialogue: 50,0:02:01.06,0:02:02.77,Main-207-,,0,0,0,,Ama Luffy-san ciddi!Dialogue: 50,0:02:02.77,0:02:04.31,Main-207-,,0,0,0,,O böyle biridir!Dialogue: 50,0:02:08.11,0:02:09.69,Main-207-,,0,0,0,,Al! İşte hazinen!Dialogue: 50,0:02:09.69,0:02:13.28,Main-207-,,0,0,0,,Hangisi senin? Bilemediğim için üçünü de getirdim.Dialogue: 50,0:02:13.28,0:02:15.24,Main-207-,,0,0,0,,Üçü de benim.Dialogue: 50,0:02:15.24,0:02:18.12,Main-207-,,0,0,0,,Ben üç-kılıç stili kullanırım.Dialogue: 50,0:02:18.12,0:02:20.04,Main-207-,,0,0,0,,Eğer birlikte dövüşürsek,...Dialogue: 50,0:02:20.06,0:02:22.62,Main-207-,,0,0,0,,...hükümete karşı çıkan bir hain olacaksın!Dialogue: 50,0:02:22.62,0:02:26.00,Main-207-,,0,0,0,,Yoksa Donanma tarafından öldürülmek mi istersin?Dialogue: 50,0:02:26.63,0:02:28.63,Main-207-,,0,0,0,,Şeytanın oğlusun sen!Dialogue: 50,0:02:28.63,0:02:31.51,Main-207-,,0,0,0,,Pekala, her neyse. Burada ölmektense...Dialogue: 50,0:02:31.51,0:02:34.80,Main-207-,,0,0,0,,...senin korsanın olurum.Dialogue: 50,0:02:34.80,0:02:38.18,Main-207-,,0,0,0,,Yaşasın! Yani tayfamdan biri mi olacaksın?!Dialogue: 50,0:02:38.43,0:02:40.93,Main-207-,,0,0,0,,Tamamdır! Harika!Dialogue: 50,0:02:40.93,0:02:44.02,Main-207-,,0,0,0,,Anladık be! Şu salak ipleri çöz artık!Dialogue: 50,0:02:41.81,0:02:44.02,Secondary-207-,,0,0,0,,Süper!Dialogue: 50,0:02:44.02,0:02:45.77,Main-207-,,0,0,0,,O herif neyin nesi?Dialogue: 50,0:02:45.77,0:02:47.81,Main-207-,,0,0,0,,Kurşunları geri fırlattı!Dialogue: 50,0:02:48.19,0:02:50.94,Main-207-,,0,0,0,,Sıradan bir insan değil, şu hasır şapka.Dialogue: 50,0:02:50.94,0:02:54.57,Main-207-,,0,0,0,,Şu ünlü şeytan meyvelerinden birini yemiş olmalı!Dialogue: 50,0:02:54.57,0:02:55.57,Main-207-,,0,0,0,,Şeytan meyvesi mi?!Dialogue: 50,0:02:55.57,0:02:57.28,Main-207-,,0,0,0,,Denizin gizli hazineleri mi?!Dialogue: 50,0:02:57.28,0:02:58.95,Main-207-,,0,0,0,,Çabuk! Çabuk!Dialogue: 50,0:02:58.95,0:03:02.75,Main-207-,,0,0,0,,Hay! Düğümler çok sıkı!Dialogue: 50,0:03:01.29,0:03:02.75,Secondary-207-,,0,0,0,,Hey! Zaman harcamayı bırak!Dialogue: 50,0:03:03.00,0:03:07.25,Main-207-,,0,0,0,,Kim olursa olsun, bana karşı gelen herkes infaz edilir!Dialogue: 50,0:03:07.25,0:03:09.71,Main-207-,,0,0,0,,Silahlar etkisizse kılıçlarınızı konuşturun!Dialogue: 50,0:03:14.09,0:03:16.59,Main-207-,,0,0,0,,Tuhaf, düğüm daha da sıkılaştı.Dialogue: 50,0:03:16.59,0:03:18.30,Main-207-,,0,0,0,,Çabuk, bana bir kılıç ver!Dialogue: 50,0:03:21.47,0:03:22.60,Main-207-,,0,0,0,,Luffy-san!Dialogue: 50,0:03:31.77,0:03:33.86,Main-207-,,0,0,0,,Roronoa Zoro!Dialogue: 50,0:03:35.15,0:03:36.49,Main-207-,,0,0,0,,Çok havalı!Dialogue: 50,0:03:38.20,0:03:39.87,Main-207-,,0,0,0,,Kıpırdayan ölür.Dialogue: 50,0:03:40.78,0:03:42.66,Main-207-,,0,0,0,,Çok korkunç!Dialogue: 50,0:03:46.66,0:03:49.08,Main-207-,,0,0,0,,Korsan olacağım. Söz veriyorum.Dialogue: 50,0:03:49.79,0:03:53.59,Main-207-,,0,0,0,,Donanmayla dövüştüğüme göre resmi olarak bir suçlu sayılırım.Dialogue: 50,0:03:53.59,0:03:56.22,Main-207-,,0,0,0,,Ama şunu açıklığa kavuşturalım.Dialogue: 50,0:03:56.22,0:03:58.80,Main-207-,,0,0,0,,Tek amacım hedefim.Dialogue: 50,0:03:58.80,0:03:59.59,Main-207-,,0,0,0,,Hedefin mi?Dialogue: 50,0:03:59.84,0:04:02.56,Main-207-,,0,0,0,,Dünyanın en büyük kılıç ustası olmak!Dialogue: 50,0:04:03.35,0:04:06.48,Main-207-,,0,0,0,,Eğer bundan vazgeçmek zorunda kalırsam,...Dialogue: 50,0:04:06.48,0:04:10.61,Main-207-,,0,0,0,,...sorumluluğu kabul edip özür olarak harakiri yapmak zorundasın!Dialogue: 50,0:04:10.61,0:04:12.86,Main-207-,,0,0,0,,Dünyanın en büyük kılıç ustası mı?Dialogue: 50,0:04:12.86,0:04:14.36,Main-207-,,0,0,0,,Kulağa harika geliyor!Dialogue: 50,0:04:14.36,0:04:18.07,Main-207-,,0,0,0,,Korsanlar kralının mürettebatında daha azı olamaz zaten!Dialogue: 50,0:04:18.82,0:04:20.20,Main-207-,,0,0,0,,Büyük konuşuyorsun.Dialogue: 50,0:04:20.20,0:04:23.08,Main-207-,,0,0,0,,Suçlu veya başka bir şey olsun...Dialogue: 50,0:04:23.08,0:04:25.70,Main-207-,,0,0,0,,...adımı dünyanın her yerinde duyuracağım!Dialogue: 50,0:04:25.95,0:04:28.21,Main-207-,,0,0,0,,Niye öylece dikiliyorsunuz?!Dialogue: 50,0:04:28.21,0:04:30.25,Main-207-,,0,0,0,,Hepsini hemen katledin!Dialogue: 50,0:04:31.67,0:04:33.25,Main-207-,,0,0,0,,Eğil, Zoro!Dialogue: 50,0:04:34.00,0:04:38.01,Main-207-,,0,0,0,,Lastik-Lastik Kırbaç!Dialogue: 50,0:04:40.64,0:04:43.26,Main-207-,,0,0,0,,B-Başardın! İnanılmaz!Dialogue: 50,0:04:43.26,0:04:45.01,Main-207-,,0,0,0,,Nesin lan sen?Dialogue: 50,0:04:45.52,0:04:47.98,Main-207-,,0,0,0,,Ben Lastik-Lastik meyvesini yedim.Dialogue: 50,0:04:48.23,0:04:49.69,Main-207-,,0,0,0,,Lastik-Lastik meyvesi mi?Dialogue: 50,0:04:49.69,0:04:51.40,Main-207-,,0,0,0,,Lastik adam!Dialogue: 50,0:04:51.40,0:04:53.90,Main-207-,,0,0,0,,Demek gerçekten şeytan meyvesi güçleri var!Dialogue: 50,0:04:53.90,0:04:56.40,Main-207-,,0,0,0,,Yüzbaşı! Ona karşı hiç şansımız yok!Dialogue: 50,0:04:56.40,0:04:58.03,Main-207-,,0,0,0,,Bu adamlar bizi aşıyor!Dialogue: 50,0:04:58.03,0:05:00.11,Main-207-,,0,0,0,,Zoro'yla bile tek başına başa çıkamıyoruz!Dialogue: 50,0:05:02.82,0:05:04.58,Main-207-,,0,0,0,,Bu doğrudan bir emirdir!Dialogue: 50,0:05:04.58,0:05:08.33,Main-207-,,0,0,0,,Zayıflıktan bahseden herkes kendi kafalarına sıkmalıdır!Dialogue: 50,0:05:08.33,0:05:11.62,Main-207-,,0,0,0,,Zayıf askerlere ihtiyacım yok!Dialogue: 50,0:05:14.04,0:05:16.88,Main-207-,,0,0,0,,Bu birlik kafayı yemiş!Dialogue: 50,0:05:17.46,0:05:18.76,Main-207-,,0,0,0,,Luffy-san!Dialogue: 50,0:05:20.63,0:05:23.34,Main-207-,,0,0,0,,Bu Donanmayı ezip geç!Dialogue: 50,0:05:32.27,0:05:36.90,Main-207-,,0,0,0,,Rütbesiz ayak takımı bana kafa tutamaz!Dialogue: 50,0:05:36.90,0:05:40.78,Main-207-,,0,0,0,,Ben Donanma Yüzbaşısı, "Balta-El" Morgan'ım.Dialogue: 50,0:05:40.78,0:05:42.53,Main-207-,,0,0,0,,Ben de Luffy!Dialogue: 50,0:05:42.53,0:05:43.41,Main-207-,,0,0,0,,Memnun oldum!Dialogue: 50,0:05:43.78,0:05:45.91,Main-207-,,0,0,0,,Geber!Dialogue: 50,0:05:55.13,0:05:56.67,Main-207-,,0,0,0,,Y-Yüzbaşı!Dialogue: 50,0:05:56.67,0:05:59.34,Main-207-,,0,0,0,,S-Seni velet...Dialogue: 50,0:06:01.17,0:06:03.18,Main-207-,,0,0,0,,Geber!Dialogue: 50,0:06:03.18,0:06:04.47,Main-207-,,0,0,0,,İstemem!Dialogue: 50,0:06:07.18,0:06:09.18,Main-207-,,0,0,0,,Y-Yüzbaşı Morgan...Dialogue: 50,0:06:11.56,0:06:12.89,Main-207-,,0,0,0,,Onunla kapışamıyor!Dialogue: 50,0:06:14.73,0:06:18.94,Main-207-,,0,0,0,,Kendinize denizci mi diyorsunuz?! Koby'nin hayalini mahvettiniz!Dialogue: 50,0:06:20.03,0:06:22.19,Main-207-,,0,0,0,,Dur! Hasır şapka!Dialogue: 50,0:06:22.19,0:06:23.36,Main-207-,,0,0,0,,Buraya bak!Dialogue: 50,0:06:25.28,0:06:27.62,Main-207-,,0,0,0,,Dur dedim! Aptal mısın?!Dialogue: 50,0:06:27.62,0:06:30.75,Main-207-,,0,0,0,,Dikkatini ver! Burada bir rehine var!Dialogue: 50,0:06:30.75,0:06:32.58,Main-207-,,0,0,0,,Helmeppo-sama!Dialogue: 50,0:06:32.58,0:06:33.75,Main-207-,,0,0,0,,Hey.Dialogue: 50,0:06:35.71,0:06:38.71,Main-207-,,0,0,0,,Bu çocuğun hayatına değer veriyorsan, kıpırdama!Dialogue: 50,0:06:38.71,0:06:41.92,Main-207-,,0,0,0,,Kıpırdarsan beynini dağıtırım!Dialogue: 50,0:06:45.76,0:06:47.14,Main-207-,,0,0,0,,Luffy-san!Dialogue: 50,0:06:47.14,0:06:50.85,Main-207-,,0,0,0,,Ölsem bile hayallerine engel olmak, istemiyorum.Dialogue: 50,0:06:51.27,0:06:53.27,Main-207-,,0,0,0,,Evet, biliyorum!Dialogue: 50,0:06:53.27,0:06:55.14,Main-207-,,0,0,0,,Pes et, salak çocuk!Dialogue: 50,0:06:55.14,0:06:57.77,Main-207-,,0,0,0,,Koby cidden ölmeye hazır!Dialogue: 50,0:06:58.90,0:07:00.02,Main-207-,,0,0,0,,Kıpırdama!Dialogue: 50,0:07:00.02,0:07:02.61,Main-207-,,0,0,0,,Kıpırdama dedim! Vur-Vururum!Dialogue: 50,0:07:03.49,0:07:05.20,Main-207-,,0,0,0,,A-Arkanda!Dialogue: 50,0:07:05.20,0:07:06.53,Main-207-,,0,0,0,,Lastik-Lastik...Dialogue: 50,0:07:06.53,0:07:11.04,Main-207-,,0,0,0,,Ben Donanma Yüzbaşısı "Balta-El" Morgan'ım!Dialogue: 50,0:07:12.33,0:07:14.29,Main-207-,,0,0,0,,Baba, çabuk öldür onu!Dialogue: 50,0:07:13.58,0:07:15.41,Main-207-,,0,0,0,,Tabanca!Dialogue: 50,0:07:19.96,0:07:21.38,Main-207-,,0,0,0,,Güzel!Dialogue: 50,0:07:30.51,0:07:31.35,Main-207-,,0,0,0,,Zoro.Dialogue: 50,0:07:31.85,0:07:35.02,Main-207-,,0,0,0,,Benim için şerefti, Kaptan!Dialogue: 50,0:07:42.19,0:07:43.61,Main-207-,,0,0,0,,Yüzbaşı Morgan yenildi!Dialogue: 50,0:07:43.61,0:07:44.74,Main-207-,,0,0,0,,İnanılmaz!Dialogue: 50,0:07:44.74,0:07:45.86,Main-207-,,0,0,0,,Manyak bunlar!Dialogue: 50,0:07:47.61,0:07:51.58,Main-207-,,0,0,0,,Hala bizi yakalamak isteyen varsa ileri çıksın!Dialogue: 50,0:07:55.66,0:07:57.71,Main-207-,,0,0,0,,Yaşasın! Yaşasın!Dialogue: 50,0:07:56.66,0:07:57.71,Secondary-207-,,0,0,0,,Özgürüz!Dialogue: 50,0:07:57.71,0:07:58.83,Main-207-,,0,0,0,,Oley!Dialogue: 50,0:07:58.83,0:08:00.50,Main-207-,,0,0,0,,Morgan'ın devri bitti!Dialogue: 50,0:08:00.50,0:08:02.67,Main-207-,,0,0,0,,Yaşasın Donanma!Dialogue: 50,0:08:02.92,0:08:03.67,Main-207-,,0,0,0,,Ne?Dialogue: 50,0:08:03.67,0:08:06.92,Main-207-,,0,0,0,,Yüzbaşıları yenildiği için herkes mutlu...Dialogue: 50,0:08:06.92,0:08:10.14,Main-207-,,0,0,0,,Herkes Morgan'dan korkuyordu!Dialogue: 50,0:08:14.43,0:08:16.06,Main-207-,,0,0,0,,Ne oldu, Zoro-san?!Dialogue: 50,0:08:16.06,0:08:17.18,Main-207-,,0,0,0,,Yaralandınız mı?!Dialogue: 50,0:08:17.94,0:08:18.89,Main-207-,,0,0,0,,Çok...Dialogue: 50,0:08:18.89,0:08:20.40,Main-207-,,0,0,0,,Açım...Dialogue: 50,0:08:25.82,0:08:27.36,Main-207-,,0,0,0,,Doldum!!Dialogue: 50,0:08:27.70,0:08:32.32,Main-207-,,0,0,0,,Neredeyse nalları dikecektim, üç hafta hiçbir şey yemedim!Dialogue: 50,0:08:36.08,0:08:38.54,Main-207-,,0,0,0,,Ne? Hemen bitirdin mi?Dialogue: 50,0:08:39.04,0:08:42.25,Main-207-,,0,0,0,,Nasıl olur da benden daha iştahlı olursun?!Dialogue: 50,0:08:42.25,0:08:44.80,Main-207-,,0,0,0,,Tadı güzel! Değil mi, Koby?Dialogue: 50,0:08:44.80,0:08:47.76,Main-207-,,0,0,0,,Bana da aynı davrandığınız için teşekkür ederim.Dialogue: 50,0:08:48.01,0:08:51.22,Main-207-,,0,0,0,,Önemli değil, kasabamızı kurtardınız sonuçta!Dialogue: 50,0:08:51.47,0:08:53.85,Main-207-,,0,0,0,,Gerçekten inanılmazsın, abi!Dialogue: 50,0:08:53.85,0:08:57.22,Main-207-,,0,0,0,,Evet, öyleyim! Çok daha fazlası olacağım!Dialogue: 50,0:08:57.22,0:09:00.02,Main-207-,,0,0,0,,Çünkü, Korsanlar Kralı olacağım!Dialogue: 50,0:09:00.31,0:09:02.10,Main-207-,,0,0,0,,Yoldaşım bile var!Dialogue: 50,0:09:02.48,0:09:06.69,Main-207-,,0,0,0,,Hey, hey! Abi şimdi nereye gideceksiniz?Dialogue: 50,0:09:06.69,0:09:09.95,Main-207-,,0,0,0,,Belli değil mi?! Grand Line'a gideceğiz!Dialogue: 50,0:09:11.53,0:09:13.66,Main-207-,,0,0,0,,Siz sadece iki kişisiniz!Dialogue: 50,0:09:13.66,0:09:16.58,Main-207-,,0,0,0,,Hayatta oraya gidemezsiniz! İmkansız! İmkansız!Dialogue: 50,0:09:16.83,0:09:20.29,Main-207-,,0,0,0,,Grand Line o kadar korkunç bir yer mi?Dialogue: 50,0:09:20.29,0:09:22.29,Main-207-,,0,0,0,,Elbette öyle!Dialogue: 50,0:09:22.29,0:09:26.63,Main-207-,,0,0,0,,Bu dünyada iki okyanus olduğunu biliyorsunuz, değil mi?Dialogue: 50,0:09:26.63,0:09:31.30,Main-207-,,0,0,0,,Ve aralarında, Red Line adında dev bir kıta olduğunu?Dialogue: 50,0:09:31.30,0:09:34.47,Main-207-,,0,0,0,,Söylenene göre, Red Line'ın tam ortasında bir şehir var...Dialogue: 50,0:09:34.47,0:09:39.06,Main-207-,,0,0,0,,...ve Grand Line bu şehri dik açıyla kesip...Dialogue: 50,0:09:39.06,0:09:42.02,Main-207-,,0,0,0,,...dünyayı çevreliyor.Dialogue: 50,0:09:42.56,0:09:48.57,Main-207-,,0,0,0,,Söylentiye göre, Korsan Kral Gold Roger, bu dünyanın sunduğu her şeyi elde etti...Dialogue: 50,0:09:48.57,0:09:55.45,Main-207-,,0,0,0,,...ve büyük hazine One Piece'i, Grand Line'da bıraktı.Dialogue: 50,0:09:55.45,0:09:59.29,Main-207-,,0,0,0,,Şimdi, her yerden korsanlar o denize doğru yelken açıyor!Dialogue: 50,0:09:59.29,0:10:04.96,Main-207-,,0,0,0,,Orası kanlı bir savaş alanı haline geldi. İnsanlar oraya Korsanlar Mezarlığı diyor!Dialogue: 50,0:10:09.30,0:10:15.89,Main-207-,,0,0,0,,Grand Line'dan hiç kimsenin sağ dönmediğini bana müşteriler söyledi.Dialogue: 50,0:10:16.14,0:10:21.10,Main-207-,,0,0,0,,Ama One Piece orada olmalı, o yüzden gidiyoruz!Dialogue: 50,0:10:21.60,0:10:23.06,Main-207-,,0,0,0,,Yapacak bir şey yok!Dialogue: 50,0:10:23.06,0:10:25.10,Main-207-,,0,0,0,,Zoro-san! Sen de mi?!Dialogue: 50,0:10:25.10,0:10:26.94,Main-207-,,0,0,0,,Sana ne ki? Sen gelmiyorsun zaten.Dialogue: 50,0:10:26.94,0:10:30.07,Main-207-,,0,0,0,,H-Hayır, ama sizin için endişeleniyorum!Dialogue: 50,0:10:30.07,0:10:31.74,Main-207-,,0,0,0,,Yanlış mı?!Dialogue: 50,0:10:31.74,0:10:36.49,Main-207-,,0,0,0,,Luffy’yle uzun zamandır tanışmıyoruz ama biz arkadaşız!Dialogue: 50,0:10:36.49,0:10:37.45,Main-207-,,0,0,0,,Değil mi?Dialogue: 50,0:10:37.83,0:10:41.41,Main-207-,,0,0,0,,Evet! Yollarımız ayrılacak ama hep arkadaş olacağız!Dialogue: 50,0:10:45.33,0:10:49.21,Main-207-,,0,0,0,,Ben küçükken hiç arkadaşım olmadı...Dialogue: 50,0:10:49.21,0:10:52.84,Main-207-,,0,0,0,,Hele ki benim için dövüşecek biri...Dialogue: 50,0:10:52.84,0:10:56.93,Main-207-,,0,0,0,,Gerçek şu ki asla hiçbir şey için dövüşmeye çalışmadım.Dialogue: 50,0:10:58.80,0:11:04.06,Main-207-,,0,0,0,,Ama siz bana, inandığım şey için nasıl yaşayacağımı öğrettiniz!Dialogue: 50,0:11:04.06,0:11:07.52,Main-207-,,0,0,0,,Çocukluk hayalimi gerçekleştirmeye karar verdim!Dialogue: 50,0:11:07.52,0:11:09.40,Main-207-,,0,0,0,,Donanmaya katılmak istiyorum!Dialogue: 50,0:11:09.40,0:11:12.61,Main-207-,,0,0,0,,O zaman kendin için endişelenmen gerekmez mi?Dialogue: 50,0:11:13.24,0:11:13.82,Main-207-,,0,0,0,,Ne...?Dialogue: 50,0:11:14.49,0:11:15.74,Main-207-,,0,0,0,,Kamarot olsan da,...Dialogue: 50,0:11:15.74,0:11:19.53,Main-207-,,0,0,0,,...Alvida'nın korsan gemisinde iki yıl geçirdin.Dialogue: 50,0:11:21.83,0:11:24.50,Main-207-,,0,0,0,,Donanmanın istihbarat gücünü hafife alma.Dialogue: 50,0:11:24.50,0:11:27.29,Main-207-,,0,0,0,,Eğer bunu öğrenirlerse, asla onlara katılamazsın.Dialogue: 50,0:11:27.96,0:11:29.84,Main-207-,,0,0,0,,D-Doğru ya...Dialogue: 50,0:11:30.88,0:11:32.00,Main-207-,,0,0,0,,İzninizle!Dialogue: 50,0:11:36.34,0:11:39.30,Main-207-,,0,0,0,,Korsan olduğunuz doğru mu?!Dialogue: 50,0:11:39.55,0:11:44.56,Main-207-,,0,0,0,,Evet. Şimdi bir yoldaş daha katıldı ve korsan tayfası olduk!Dialogue: 50,0:11:44.81,0:11:50.44,Main-207-,,0,0,0,,Üssümüzü ve bu kasabayı o zalimden kurtardığınız için minnettarız.Dialogue: 50,0:11:50.44,0:11:53.28,Main-207-,,0,0,0,,Ne var ki, şimdi korsan olduğunuzu bildiğimize göre...Dialogue: 50,0:11:53.28,0:11:56.07,Main-207-,,0,0,0,,Donanma adına, sessizce duramayız!Dialogue: 50,0:11:56.95,0:11:59.82,Main-207-,,0,0,0,,Bu kasabayı derhal terk edeceksiniz!Dialogue: 50,0:11:59.82,0:12:03.58,Main-207-,,0,0,0,,Size borçlu olduğumuz için karargahla iletişime geçmeyeceğiz.Dialogue: 50,0:12:03.58,0:12:04.54,Main-207-,,0,0,0,,Hey, denizci!Dialogue: 50,0:12:05.04,0:12:06.58,Main-207-,,0,0,0,,Nasıl öyle konuşursun?!Dialogue: 50,0:12:06.58,0:12:10.29,Main-207-,,0,0,0,,Siz bile Morgan'ın baskısı altında korkuyordunuz!Dialogue: 50,0:12:10.29,0:12:13.50,Main-207-,,0,0,0,,Bu insanlara hayatlarımızı borçluyuz!Dialogue: 50,0:12:13.50,0:12:15.09,Main-207-,,0,0,0,,– Doğru! Doğru! – Evet, doğru!Dialogue: 50,0:12:18.59,0:12:20.01,Main-207-,,0,0,0,,Pekala, gidelim!Dialogue: 50,0:12:20.59,0:12:22.10,Main-207-,,0,0,0,,Yemek için teşekkürler, teyze!Dialogue: 50,0:12:22.39,0:12:25.02,Main-207-,,0,0,0,,Hemen gidiyor musunuz?Dialogue: 50,0:12:25.31,0:12:26.39,Main-207-,,0,0,0,,Evet.Dialogue: 50,0:12:33.82,0:12:35.69,Main-207-,,0,0,0,,Sen de onların tayfasından değil misin?Dialogue: 50,0:12:35.69,0:12:37.65,Main-207-,,0,0,0,,Şey? B...Dialogue: 50,0:12:37.65,0:12:38.95,Main-207-,,0,0,0,,Ben...Dialogue: 50,0:12:43.33,0:12:44.16,Main-207-,,0,0,0,,Bekleyin!Dialogue: 50,0:12:44.41,0:12:46.16,Main-207-,,0,0,0,,Sizinle mi?Dialogue: 50,0:12:46.95,0:12:50.17,Main-207-,,0,0,0,,Şimdiye kadar ne yaptığını iyi biliyorum.Dialogue: 50,0:12:51.17,0:12:52.92,Thoughts-207-,,0,0,0,,Luffy-san! Yapamazsın!Dialogue: 50,0:12:53.25,0:12:56.38,Main-207-,,0,0,0,,Gerçekten çoook şişman bir korsan kadın vardı.Dialogue: 50,0:12:56.38,0:12:58.13,Main-207-,,0,0,0,,Sanırım adı Ahilda'ydı.Dialogue: 50,0:12:58.13,0:13:00.13,Main-207-,,0,0,0,,Luffy-san!Dialogue: 50,0:13:00.68,0:13:02.80,Thoughts-207-,,0,0,0,,Eğer korsan gemisinde olduğumu öğrenirlerse,...Dialogue: 50,0:13:02.80,0:13:05.39,Thoughts-207-,,0,0,0,,...asla Donanmaya katılamam!Dialogue: 50,0:13:05.39,0:13:07.39,Main-207-,,0,0,0,,Ve demir bir sopası vardı.Dialogue: 50,0:13:07.39,0:13:10.02,Main-207-,,0,0,0,,Ne çirkin bir kocakarıydı!Dialogue: 50,0:13:10.94,0:13:14.44,Main-207-,,0,0,0,,Ve tam iki yıl boyunca, bu çocuk onun–Dialogue: 50,0:13:15.07,0:13:19.65,Thoughts-207-,,0,0,0,,Lütfen yapma! Lütfen yapma, Luffy-san!Dialogue: 50,0:13:19.65,0:13:20.86,Main-207-,,0,0,0,,Kes sesini!Dialogue: 50,0:13:28.16,0:13:29.79,Main-207-,,0,0,0,,Şimdi yaptın işte, seni pislik!Dialogue: 50,0:13:30.37,0:13:33.29,Main-207-,,0,0,0,,Pislik! Pislik! Al sana!Dialogue: 50,0:13:35.50,0:13:36.88,Main-207-,,0,0,0,,Yeter!Dialogue: 50,0:13:36.88,0:13:40.47,Main-207-,,0,0,0,,Bu kasabada daha fazla huzursuzluk çıkarmanıza izin vermeyeceğiz!Dialogue: 50,0:13:40.88,0:13:41.43,Main-207-,,0,0,0,,Hey!Dialogue: 50,0:13:41.80,0:13:43.34,Main-207-,,0,0,0,,Çok ileri gittin.Dialogue: 50,0:13:43.34,0:13:44.85,Main-207-,,0,0,0,,Bu kadar yeter.Dialogue: 50,0:13:49.77,0:13:52.52,Main-207-,,0,0,0,,Sizden biri olmadığı açıkça ortada!Dialogue: 50,0:13:52.52,0:13:55.02,Main-207-,,0,0,0,,Şimdi, bu kasabayı hemen terk edin!Dialogue: 50,0:14:00.94,0:14:02.24,Thoughts-207-,,0,0,0,,Bilerek...Dialogue: 50,0:14:04.20,0:14:06.28,Thoughts-207-,,0,0,0,,Bilerek yaptı...Dialogue: 50,0:14:10.16,0:14:12.21,Thoughts-207-,,0,0,0,,Benim için...Dialogue: 50,0:14:12.71,0:14:15.96,Thoughts-207-,,0,0,0,,Bilerek ona yumruk atmamı sağladı...Dialogue: 50,0:14:17.67,0:14:22.63,Thoughts-207-,,0,0,0,,En sonunda bile, onun yardımına ihtiyaç duydum!Dialogue: 50,0:14:25.89,0:14:28.85,Thoughts-207-,,0,0,0,,Hiçbir şey değişmedi!Dialogue: 50,0:14:31.27,0:14:33.56,Thoughts-207-,,0,0,0,,Ben aptal mıyım?!Dialogue: 50,0:14:34.06,0:14:35.27,Main-207-,,0,0,0,,Ben...Dialogue: 50,0:14:36.11,0:14:38.94,Main-207-,,0,0,0,,Ben... Donanmaya katılmak istiyorum!Dialogue: 50,0:14:38.94,0:14:42.07,Main-207-,,0,0,0,,Denizci olabilmek için, kamarot ya da...Dialogue: 50,0:14:42.07,0:14:44.49,Main-207-,,0,0,0,,...ne isterseniz olurum!Dialogue: 50,0:14:47.74,0:14:48.74,Main-207-,,0,0,0,,Kumandan!Dialogue: 50,0:14:48.74,0:14:50.45,Main-207-,,0,0,0,,Bu fikre karşı çıkıyorum!Dialogue: 50,0:14:51.37,0:14:54.00,Main-207-,,0,0,0,,Daha bu çocuğa tam olarak güvenmiyorum.Dialogue: 50,0:14:54.00,0:14:57.08,Main-207-,,0,0,0,,Denizcilerin korsan casusu olduğu vakalar oldu!Dialogue: 50,0:14:57.58,0:15:00.09,Main-207-,,0,0,0,,İlk olarak geçmişini araştırmalıyız–Dialogue: 50,0:15:00.55,0:15:04.09,Main-207-,,0,0,0,,Ben Donanma Subayı olacak adamım!Dialogue: 50,0:15:11.14,0:15:14.27,Main-207-,,0,0,0,,Sayısız yoldaşımız korsanlar tarafından öldürüldü.Dialogue: 50,0:15:14.27,0:15:15.94,Main-207-,,0,0,0,,Donanma'yı hafife alma!Dialogue: 50,0:15:17.19,0:15:17.90,Main-207-,,0,0,0,,Öyleyse...Dialogue: 50,0:15:18.27,0:15:20.15,Main-207-,,0,0,0,,Katılım izni verildi!Dialogue: 50,0:15:22.32,0:15:23.15,Main-207-,,0,0,0,,Başüstüne!Dialogue: 50,0:15:24.78,0:15:27.11,Main-207-,,0,0,0,,Leş gibi rol yaptın.Dialogue: 50,0:15:27.11,0:15:28.87,Main-207-,,0,0,0,,Farkına varırlarsa hiç şaşırmam.Dialogue: 50,0:15:29.45,0:15:32.91,Main-207-,,0,0,0,,Artık her şey Koby'ye bağlı. Başaracağına inanıyorum.Dialogue: 50,0:15:32.91,0:15:34.66,Main-207-,,0,0,0,,Ayrılmak için iyi bir yoldu...Dialogue: 50,0:15:34.66,0:15:36.87,Main-207-,,0,0,0,,Herkes sana kızgınken ayrılmak...Dialogue: 50,0:15:37.12,0:15:38.63,Main-207-,,0,0,0,,Korsan gibi!Dialogue: 50,0:15:40.09,0:15:41.13,Main-207-,,0,0,0,,Doğru!Dialogue: 50,0:15:41.13,0:15:42.55,Main-207-,,0,0,0,,Luffy-san!Dialogue: 50,0:15:41.88,0:15:42.55,Secondary-207-,,0,0,0,,Ha?Dialogue: 50,0:15:44.55,0:15:48.89,Main-207-,,0,0,0,,Teşekkür ederim! Benim için yaptıklarını asla unutmayacağım!Dialogue: 50,0:15:49.68,0:15:53.27,Main-207-,,0,0,0,,Daha önce bir korsana teşekkür eden denizci hiç duymamıştım.Dialogue: 50,0:15:56.39,0:15:58.85,Main-207-,,0,0,0,,Tekrar görüşelim, Koby!Dialogue: 50,0:15:59.10,0:16:00.86,Main-207-,,0,0,0,,Luffy-san...Dialogue: 50,0:16:00.11,0:16:02.32,Main-207-,,0,0,0,,Güle güle, abi!Dialogue: 50,0:16:02.57,0:16:05.03,Main-207-,,0,0,0,,Asker, selam dur!Dialogue: 50,0:16:07.99,0:16:10.95,Main-207-,,0,0,0,,Görüşürüz!Dialogue: 50,0:16:11.74,0:16:13.91,Main-207-,,0,0,0,,İyi bir arkadaşın var.Dialogue: 50,0:16:18.83,0:16:19.96,Main-207-,,0,0,0,,Evet, efendim!Dialogue: 50,0:16:21.17,0:16:25.80,Main-207-,,0,0,0,,Az önceki selamımız denizci hukukuna aykırıdır!Dialogue: 50,0:16:25.80,0:16:28.68,Main-207-,,0,0,0,,Ceza olarak, üç gün boyunca yiyecek yok!Dialogue: 50,0:16:28.68,0:16:29.68,Main-207-,,0,0,0,,Anlaşıldı mı?!Dialogue: 50,0:16:29.68,0:16:30.72,Main-207-,,0,0,0,,– Başüstüne! – Başüstüne!Dialogue: 50,0:16:33.81,0:16:36.35,Main-207-,,0,0,0,,Pekala! Gidelim!Dialogue: 50,0:16:36.35,0:16:40.77,Main-207-,,0,0,0,,Grand Line'a doğru yelken açın!Dialogue: 0,0:02:07.57,0:02:13.28,Title-207-,,0,0,0,,Bir NumaraDialogue: 1,0:02:07.57,0:02:13.28,Title-207-,,0,0,0,,Bir NumaraDialogue: 0,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 1,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 0,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Feeso Galaxy 9000Dialogue: 1,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Feeso Galaxy 9000Dialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,MüzikDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,MüzikDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,HaleeDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,HaleeDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,GrafikDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,GrafikDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,DatenshiDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,DatenshiDialogue: 0,0:00:06.78,0:00:10.78,Credits-207-,,0,0,0,,Kalite KontrolDialogue: 1,0:00:06.78,0:00:10.78,Credits-207-,,0,0,0,,Kalite KontrolDialogue: 0,0:00:06.78,0:00:10.78,Credits-207-,,0,0,0,,Gab Gol D. Rocks Pepperjack Westfal ZenefDialogue: 1,0:00:06.78,0:00:10.78,Credits-207-,,0,0,0,,Gab Gol D. Rocks Pepperjack Westfal ZenefDialogue: 0,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,KaraokeDialogue: 1,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,KaraokeDialogue: 0,0:00:10.78,0:00:13.2