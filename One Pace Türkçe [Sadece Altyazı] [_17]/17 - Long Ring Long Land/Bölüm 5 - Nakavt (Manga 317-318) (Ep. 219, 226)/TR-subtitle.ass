Dialogue: 0,0:00:04.03,0:00:08.12,Lyrics,,0,0,0,,{\fad(75,75)}♪ Sıkıntı yok! Hadi ilerleyelim...
Dialogue: 0,0:00:08.37,0:00:11.59,Lyrics,,0,0,0,,...sürekli kalplerimizin içindeki güneşle. ♪
Dialogue: 0,0:00:11.76,0:00:15.03,Lyrics,,0,0,0,,♪ Güç kenetli ellerimizden geçerken... ♪
Dialogue: 0,0:00:15.18,0:00:18.68,Lyrics,,0,0,0,,♪ Dileklerimizi avuçlayalım. ♪
Dialogue: 0,0:00:26.32,0:00:32.51,Lyrics,,0,0,0,,♪ Devasa dalgaları aşalım, güçlerimizi birleştirerek. ♪
Dialogue: 0,0:00:33.85,0:00:40.33,Lyrics,,0,0,1,,♪ Heyecana doğru acele edelim...\N bu bir başlama işareti. ♪
Dialogue: 0,0:00:41.01,0:00:47.14,Lyrics,,0,0,0,,♪ İşte şimdi yelken açma zamanı... çapayı kaldıralım. ♪
Dialogue: 0,0:00:47.99,0:00:55.00,Lyrics,,0,0,1,,♪ Gökkuşağı renkli rüzgarı kes ve maceralar denizine yönel. ♪
Dialogue: 0,0:00:55.13,0:00:58.57,Lyrics,,0,0,0,,♪ Yaralarla dolu bir yolculuk olacak...
Dialogue: 0,0:00:58.65,0:01:02.30,Lyrics,,0,0,0,,...ama en önemlisi de tam orada olacak. ♪
Dialogue: 0,0:01:02.50,0:01:06.43,Lyrics,,0,0,0,,♪ Bir sıkışıklığa girsek bile önemi yok. ♪
Dialogue: 0,0:01:06.50,0:01:08.38,Lyrics,,0,0,0,,♪ Çünkü seni koruyacağım. ♪
Dialogue: 0,0:01:09.53,0:01:13.36,Lyrics,,0,0,0,,♪ Sıkıntı yok! Hadi ilerleyelim...
Dialogue: 0,0:01:13.71,0:01:16.85,Lyrics,,0,0,0,,...sürekli kalplerimizin içindeki güneşle. ♪
Dialogue: 0,0:01:17.23,0:01:20.35,Lyrics,,0,0,1,,♪ Eğer bir gün fırtına gelirse omuz omuza duralım...
Dialogue: 0,0:01:20.46,0:01:24.23,Lyrics,,0,0,0,,...ve daha önceki ışığa bakalım ♪
Dialogue: 0,0:01:24.72,0:01:27.97,Lyrics,,0,0,0,,♪ Hayallerimizin parçalarını toplarsak...
Dialogue: 0,0:01:28.47,0:01:31.58,Lyrics,,0,0,0,,...geleceğe ulaşan bir harita olurlar. ♪
Dialogue: 0,0:01:31.73,0:01:34.75,Lyrics,,0,0,0,,♪ O yüzden hep beraber aynı bayrak altında duralım...
Dialogue: 0,0:01:35.22,0:01:40.48,Lyrics,,0,0,0,,...ve dileklerimizi avuçlayalım, hepimiz biriz. ♪
