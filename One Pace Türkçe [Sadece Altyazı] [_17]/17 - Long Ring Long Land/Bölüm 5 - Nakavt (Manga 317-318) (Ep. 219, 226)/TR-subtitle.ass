Dialogue: 0,0:01:50.25,0:01:58.25,Author,,0,0,0,,{\fad(600,0)\fs18} Türkçeleştirme & Çevirmen  {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&} - {\c&H01BAFF&}{\b1}Kaşgarlı{\b0}{\c&HFFFFFF&}\N{\fs17}thx to onepace.net
Dialogue: 0,0:15:28.70,0:15:31.50,Author,,0,0,0,,{\fad(0,0)\fs18} Türkçeleştirme & Çevirmen  {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&} - {\c&H01BAFF&}{\b1}Kaşgarlı{\b0}{\c&HFFFFFF&}\N{\fs17}thx to onepace.net
Dialogue: 0,0:01:51.71,0:01:56.13,Main,,0,0,0,,Muhteşem bir gayret ile tekrar ayağı kalkmayı başarıyor! Hasır Şapka Luffy!
Dialogue: 0,0:01:56.27,0:01:58.96,Main,,0,0,0,,Yıkılsa bile ayağa kalkıyor!
Dialogue: 0,0:01:58.96,0:02:00.00,Main,,0,0,0,,Luffy...!
Dialogue: 0,0:02:00.81,0:02:04.41,Main,,0,0,0,,Nesin sen?!
Dialogue: 0,0:02:06.33,0:02:07.98,Main,,0,0,0,,Luffy!
Dialogue: 0,0:02:07.98,0:02:10.04,Main,,0,0,0,,Ayakta zar zor duruyor!
Dialogue: 0,0:02:10.04,0:02:11.11,Main,,0,0,0,,Luffy!
Dialogue: 0,0:02:11.45,0:02:13.47,Main,,0,0,0,,Zar zor nefes alıyor!
Dialogue: 0,0:02:13.47,0:02:15.03,Main,,0,0,0,,Nasıl bir adam bu?!
Dialogue: 0,0:02:15.77,0:02:17.15,Main,,0,0,0,,Ama...
Dialogue: 0,0:02:17.15,0:02:20.55,Main,,0,0,0,,Yine de gözlerindeki parıltı ile dimdik ayakta duruyor!
Dialogue: 0,0:02:23.37,0:02:25.12,Main,,0,0,0,,Arkadaşları için!
Dialogue: 0,0:02:25.12,0:02:28.16,Main,,0,0,0,,Evet! İşte bu Davy Back Fight!
Dialogue: 0,0:02:28.16,0:02:32.15,Main,,0,0,0,,Gözlerim doldu... Gözlerim o kadar doldu ki önümü göremiyorum!
Dialogue: 0,0:02:33.81,0:02:35.61,Main,,0,0,0,,Luffy!
Dialogue: 0,0:02:35.61,0:02:37.48,Main,,0,0,0,,Luffy!!
Dialogue: 0,0:02:37.48,0:02:38.96,Main,,0,0,0,,Ağlayacağım!
Dialogue: 0,0:02:38.96,0:02:41.29,Main,,0,0,0,,Afro pislik!
Dialogue: 0,0:02:41.29,0:02:45.75,Main,,0,0,0,,Luffy! Luffy! Luffy!...
Dialogue: 0,0:02:45.75,0:02:48.61,Main,,0,0,0,,Luffy için tezahürat yapılıyor!
Dialogue: 0,0:02:49.13,0:02:54.21,Main,,0,0,0,,Patronumuza bu kadar sıkıntı yaşatan başka bir rakip oldu mu ki?!
Dialogue: 0,0:02:55.51,0:03:00.67,Main,,0,0,0,,Aptallar! Neden rakibe tezahürat yapıyorsunuz?!
Dialogue: 0,0:03:02.85,0:03:04.18,Main,,0,0,0,,Patron...!
Dialogue: 0,0:03:04.18,0:03:05.16,Main,,0,0,0,,Patron!
Dialogue: 0,0:03:05.16,0:03:10.40,Main,,0,0,0,,Patron! Patron! Patron! Patron!
Dialogue: 0,0:03:10.40,0:03:13.31,Main,,0,0,0,,Bekle de gör. Bunu hemen bitireceğim!
Dialogue: 0,0:03:10.45,0:03:15.79,Secondary,,0,0,0,,Patron! Patron! Patron! Patron!
Dialogue: 0,0:03:15.79,0:03:18.71,Main,,0,0,0,,{\fad(150,150)}Noro-Noro Beam Sword! {Yavaş-Yavaş Işın Kılıcı!}
Dialogue: 0,0:03:15.79,0:03:18.71,Attack,,0,0,0,,{\fad(150,150)}Yavaş-Yavaş Işın Kılıcı
Dialogue: 0,0:03:19.71,0:03:21.35,Main,,0,0,0,,Bundan daha iyisini yapman gerek!
Dialogue: 0,0:03:23.79,0:03:28.00,Main,,0,0,0,,Kahretsin! Kaçmak için bile gücü kalmadı mı?!
Dialogue: 0,0:03:28.00,0:03:30.21,Main,,0,0,0,,Pekala! Bununla beraber sona eriyor!
Dialogue: 0,0:03:30.88,0:03:32.62,Main,,0,0,0,,{\fad(150,150)}Noro-Noro Beam! {Yavaş-Yavaş Işın!}
Dialogue: 0,0:03:30.88,0:03:32.62,Attack,,0,0,0,,{\fad(150,150)}Yavaş-Yavaş Işın
Dialogue: 0,0:03:32.62,0:03:36.37,Main,,0,0,0,,İlk hareket patronumuzdan geliyor! \NBir top mermisini yavaşlatarak başlıyor!
Dialogue: 0,0:03:38.05,0:03:39.83,Main,,0,0,0,,{\fad(150,150)}Foxy Fighter! {Dövüşçü Foxy!}
Dialogue: 0,0:03:38.05,0:03:39.83,Attack,,0,0,0,,{\fad(150,150)}Dövüşçü Foxy
Dialogue: 0,0:03:40.99,0:03:43.11,Main,,0,0,0,,Top mermisi hızında bir Megaton Yumruğu!
Dialogue: 0,0:03:43.45,0:03:45.13,Main,,0,0,0,,Kesinlikle nakavt olacak!
Dialogue: 0,0:03:45.99,0:03:49.84,Main,,0,0,0,,İşte! Patronumuzun top numarası uçuyor!
Dialogue: 0,0:03:49.84,0:03:52.23,Main,,0,0,0,,Foxy Fighter'ın üstünde bitirme vuruşuna doğru gidiyor!
Dialogue: 0,0:03:53.01,0:03:56.47,Main,,0,0,0,,Luffy! Toptan hemen önce senin üstünde bir ışın kullandı!
Dialogue: 0,0:03:56.83,0:03:59.05,Main,,0,0,0,,Hareket edebildiğin anda savuştur!
Dialogue: 0,0:04:04.75,0:04:06.02,Main,,0,0,0,,Ah! Hareket edebiliyorum!
Dialogue: 0,0:04:06.02,0:04:09.40,Main,,0,0,0,,Hasır Şapka tam zamanında ışının etkisinden kurtuluyor!
Dialogue: 0,0:04:09.95,0:04:10.71,Main,,0,0,0,,Faydası yok!
Dialogue: 0,0:04:11.13,0:04:12.59,Main,,0,0,0,,Kaçış yok!
Dialogue: 0,0:04:18.85,0:04:20.89,Main,,0,0,0,,Luffy! Dikkat et!
Dialogue: 0,0:04:23.41,0:04:25.33,Main,,0,0,0,,İşte sana bir hediye!
Dialogue: 0,0:04:26.69,0:04:31.06,Main,,0,0,0,,Bitti! Tüm saldırıları Hasır Şapka'nın işini bitiriyor!
Dialogue: 0,0:04:31.06,0:04:35.81,Main,,0,0,0,,Patron! Patron! Patron!
Dialogue: 0,0:04:35.81,0:04:38.43,Main,,0,0,0,,Ne oldu?! O kadar ileri gitmek zorunda değildi!
Dialogue: 0,0:04:45.47,0:04:48.43,Main,,0,0,0,,A-A-Ayağa kalktı!
Dialogue: 0,0:04:50.77,0:04:52.05,Main,,0,0,0,,Nasıl...?!
Dialogue: 0,0:05:10.65,0:05:13.33,Main,,0,0,0,,Ben... kazandım.
Dialogue: 0,0:05:15.15,0:05:19.59,Main,,0,0,0,,Ne?! Daha zar zor ayakta duruyorsun!
Dialogue: 0,0:05:20.30,0:05:24.57,Main,,0,0,0,,Ama eğer istediğin buysa, sen yerde kalana kadar seni pataklayacağım!
Dialogue: 0,0:05:24.99,0:05:27.54,Main,,0,0,0,,{\fad(150,150)}Megaton Kyubi...!\N{Megaton Dokuz Kuyruk...!}
Dialogue: 0,0:05:24.99,0:05:27.54,Attack,,0,0,0,,{\fad(150,150)}Megaton Dokuz Kuyruk...
Dialogue: 0,0:05:27.54,0:05:29.93,Main,,0,0,0,,{\fad(150,150)}Gomu-Gomu no...\N{Lastik-Lastik...}
Dialogue: 0,0:05:29.93,0:05:32.42,Main,,0,0,0,,{\fad(150,150)}Rush!\N{Saldırısı!}
Dialogue: 0,0:05:29.93,0:05:32.42,Attack,,0,0,0,,{\fad(150,150)}...Saldırısı
Dialogue: 0,0:05:32.42,0:05:36.03,Main,,0,0,0,,{\fad(150,150)}Gatling! {Mitralyöz!}
Dialogue: 0,0:05:32.42,0:05:36.03,Attack,,0,0,0,,{\fad(150,150)}...Mitralyöz
Dialogue: 0,0:05:39.89,0:05:41.41,Main,,0,0,0,,Ne gerilim ama!
Dialogue: 0,0:05:41.41,0:05:45.53,Main,,0,0,0,,Artık dövüşçüler çok daha şiddetli yumruklar atıyorlar!
Dialogue: 0,0:05:45.53,0:05:47.95,Main,,0,0,0,,Luffy! Bitir işini!
Dialogue: 0,0:05:47.95,0:05:50.81,Main,,0,0,0,,Durmuyor! Saldırıları, durmuyor!
Dialogue: 0,0:05:56.21,0:05:57.77,Main,,0,0,0,,Luffy!
Dialogue: 0,0:06:01.31,0:06:04.81,Main,,0,0,0,,{\fad(150,150)}Noro-Noro Beam! {Yavaş-Yavaş Işın!}
Dialogue: 0,0:06:01.31,0:06:04.81,Attack,,0,0,0,,{\fad(150,150)}Yavaş-Yavaş Işın
Dialogue: 0,0:06:07.65,0:06:08.97,Main,,0,0,0,,Ne...?!
Dialogue: 0,0:06:08.97,0:06:10.28,Main,,0,0,0,,Bu da ne...?
Dialogue: 0,0:06:10.61,0:06:11.75,Main,,0,0,0,,Hareket etmiyor...
Dialogue: 0,0:06:28.07,0:06:30.27,Main,,0,0,0,,Yere serilen kişi Hasır Şapka!
Dialogue: 0,0:06:30.81,0:06:32.71,Main,,0,0,0,,Hayır! Tam tersi!
Dialogue: 0,0:06:32.71,0:06:34.55,Main,,0,0,0,,Hareket eden Hasır Şapka!
Dialogue: 0,0:06:34.55,0:06:37.12,Main,,0,0,0,,Bu da ne demek oluyor acaba?!
Dialogue: 0,0:06:37.12,0:06:40.31,Main,,0,0,0,,Lanet... olsun...
Dialogue: 0,0:06:40.31,0:06:41.19,Main,,0,0,0,,Nasıl?!
Dialogue: 0,0:06:42.35,0:06:43.87,Main,,0,0,0,,Patron?!
Dialogue: 0,0:06:46.83,0:06:51.12,Main,,0,0,0,,Ayna! Hasır Şapka'nın elinden bir ayna parçası düştü!
Dialogue: 0,0:06:51.12,0:06:55.25,Main,,0,0,0,,Afromun içinde... saklıyordum...
Dialogue: 0,0:06:55.25,0:06:57.64,Main,,0,0,0,,Odandaki aynadan!
Dialogue: 0,0:06:57.64,0:07:01.04,Main,,0,0,0,,Lanet... olsun...!
Dialogue: 0,0:07:01.04,0:07:03.35,Main,,0,0,0,,{\fad(150,150)}Gomu-Gomu no...\N{Lastik-Lastik...}
Dialogue: 0,0:07:10.75,0:07:13.61,Main,,0,0,0,,{\fad(150,150)}Flail!\N{Zincirli Gürz!}
Dialogue: 0,0:07:10.75,0:07:13.61,Attack,,0,0,0,,{\fad(150,150)}Zincirli Gürz
Dialogue: 0,0:07:39.03,0:07:40.05,Main,,0,0,0,,Olamaz...!
Dialogue: 0,0:07:41.01,0:07:42.36,Main,,0,0,0,,Sekiz saniye kaldı.
Dialogue: 0,0:07:42.36,0:07:42.95,Main,,0,0,0,,Ha?
Dialogue: 0,0:07:43.59,0:07:44.41,Main,,0,0,0,,Ha?!
Dialogue: 0,0:07:44.87,0:07:47.57,Main,,0,0,0,,Yoksa bu...?!
Dialogue: 0,0:07:47.89,0:07:49.24,Main,,0,0,0,,Yedi.
Dialogue: 0,0:07:49.24,0:07:50.15,Main,,0,0,0,,Ne?
Dialogue: 0,0:07:50.83,0:07:51.71,Main,,0,0,0,,Altı.
Dialogue: 0,0:07:52.47,0:07:54.44,Main,,0,0,0,,Patron!
Dialogue: 0,0:07:59.87,0:08:00.87,Main,,0,0,0,,Beş!
Dialogue: 0,0:08:01.43,0:08:06.39,Main,,0,0,0,,Ne yapıyorsunuz siz?! Siz de saymaya başlayın! Dört!
Dialogue: 0,0:08:06.55,0:08:07.36,Main,,0,0,0,,Ne?
Dialogue: 0,0:08:07.36,0:08:08.97,Main,,0,0,0,,Bilmem! Ama eğlenceli duruyor!
Dialogue: 0,0:08:11.95,0:08:13.29,Main,,0,0,0,,Üç!
Dialogue: 0,0:08:13.61,0:08:14.61,Main,,0,0,0,,İki!
Dialogue: 0,0:08:15.09,0:08:15.99,Main,,0,0,0,,Bir!
Dialogue: 0,0:08:16.53,0:08:18.75,Main,,0,0,0,,Sıfır!
Dialogue: 0,0:08:29.69,0:08:31.21,Main,,0,0,0,,Oley!
Dialogue: 0,0:08:32.89,0:08:35.33,Main,,0,0,0,,Patron!
Dialogue: 0,0:08:36.77,0:08:40.04,Main,,0,0,0,,Patronumuz, uçtu!
Dialogue: 0,0:08:52.59,0:08:54.19,Main,,0,0,0,,Düştüğü yer...
Dialogue: 0,0:08:57.28,0:08:59.86,Main,,0,0,0,,...alanın dışı!
Dialogue: 0,0:08:59.86,0:09:01.74,Main,,0,0,0,,Davy Back Dövüşü'nün son turu
Dialogue: 0,0:09:01.74,0:09:04.95,Main,,0,0,0,,iki kaptan arasındaki kızışmış, destansı bir dövüş ile sona erdi!
Dialogue: 0,0:09:05.27,0:09:09.14,Main,,0,0,0,,Patronumuzun 920 galibiyet ve 0 mağlubiyet rekoru bununla birlikte bozuldu!
Dialogue: 0,0:09:09.14,0:09:11.73,Main,,0,0,0,,Oyunu kazanan...
Dialogue: 0,0:09:18.41,0:09:25.68,Flashbacks,,0,0,0,,Benim... arkadaşlarımın birini bile... ölsem de vermem!
Dialogue: 0,0:09:25.68,0:09:30.55,Main,,0,0,0,,...Hasır Şapka Luffy!
Dialogue: 0,0:09:35.49,0:09:37.74,Main,,0,0,0,,Patron... kaybetti...
Dialogue: 0,0:09:37.74,0:09:40.00,Main,,0,0,0,,Foxy Korsanları karşısında...
Dialogue: 0,0:09:40.00,0:09:44.05,Main,,0,0,0,,Hey! Oturup durmayın! Patronun yardımımıza ihtiyacı var!
Dialogue: 0,0:09:44.39,0:09:46.02,Main,,0,0,0,,Tamamdır! Ben giderim!
Dialogue: 0,0:09:46.02,0:09:47.50,Main,,0,0,0,,...Hasır Şapka tayfası!
Dialogue: 0,0:09:47.50,0:09:48.81,Main,,0,0,0,,Ben de gidiyorum! Çekil!
Dialogue: 0,0:09:48.81,0:09:49.86,Main,,0,0,0,,Ben de gidiyorum!
Dialogue: 0,0:09:49.86,0:09:58.23,Main,,0,0,0,,Bu geleneksel kurallı üç bozuklukluk oyun Davy Back Dövüşü böylece sona eriyor!
Dialogue: 0,0:10:02.95,0:10:05.47,Main,,0,0,0,,Patron!
Dialogue: 0,0:10:07.03,0:10:09.73,Main,,0,0,0,,Patron!
Dialogue: 0,0:10:16.51,0:10:19.37,Main,,0,0,0,,Kahretsin, nasıl bu kadar umursamaz olabilirsin?!
Dialogue: 0,0:10:19.77,0:10:21.04,Main,,0,0,0,,Ye bunu! Bunu da!
Dialogue: 0,0:10:21.04,0:10:24.81,Main,,0,0,0,,Onu dürtmeyi bırak! O ağır yaralı, aptal!
Dialogue: 0,0:10:24.81,0:10:26.64,Main,,0,0,0,,Bizi sürekli endişelendirdi...
Dialogue: 0,0:10:26.64,0:10:28.33,Main,,0,0,0,,Afro gücü de neymiş.
Dialogue: 0,0:10:28.97,0:10:32.34,Main,,0,0,0,,Nami-san! Afrolar cidden güçlü!
Dialogue: 0,0:10:33.89,0:10:35.71,Main,,0,0,0,,Ah! Kendine geldi!
Dialogue: 0,0:10:36.51,0:10:38.42,Main,,0,0,0,,N-N-Ne?!
Dialogue: 0,0:10:38.85,0:10:40.62,Main,,0,0,0,,Oyun! Oyuna ne oldu?!
Dialogue: 0,0:10:41.15,0:10:44.11,Main,,0,0,0,,Kazandığımı düşündüm ama... Rüya mıydı?!
Dialogue: 0,0:10:44.45,0:10:46.53,Main,,0,0,0,,Sıkıntı yok. Kazandın.
Dialogue: 0,0:10:50.65,0:10:51.93,Main,,0,0,0,,Şükürler olsun...
Dialogue: 0,0:10:53.87,0:10:56.59,Main,,0,0,0,,Ben hiç endişelenmedim zaten!
Dialogue: 0,0:10:56.95,0:10:58.22,Main,,0,0,0,,Yalancı.
Dialogue: 0,0:10:58.22,0:11:03.33,Main,,0,0,0,,Şimdi düşününce, başka bir gemide korsanlık yapmak için bir sebebim yok.
Dialogue: 0,0:11:03.85,0:11:04.73,Main,,0,0,0,,Patron!
Dialogue: 0,0:11:04.73,0:11:06.23,Main,,0,0,0,,Daha hareket etmemelisin!
Dialogue: 0,0:11:06.61,0:11:08.14,Main,,0,0,0,,Hey Hasır Şapka!
Dialogue: 0,0:11:08.14,0:11:13.00,Main,,0,0,0,,Pislik! Ne cüretle benim efsanevi yenilmezlik serimi mahvedersin?!
Dialogue: 0,0:11:13.00,0:11:14.15,Main,,0,0,0,,Patron!
Dialogue: 0,0:11:15.81,0:11:17.65,Main,,0,0,0,,El sıkışalım, kardeşim!
Dialogue: 0,0:11:18.33,0:11:19.89,Main,,0,0,0,,Patron!
Dialogue: 0,0:11:20.25,0:11:22.13,Main,,0,0,0,,Evet Patron!
Dialogue: 0,0:11:25.91,0:11:27.75,Main,,0,0,0,,{\fad(150,150)}Kuyashimagire Ipponzeoi! \N{İntikamın Omuz Üstü Atışı!}
Dialogue: 0,0:11:25.91,0:11:27.75,Attack,,0,0,0,,{\fad(150,150)}İntikamın Omuz Üstü Atışı
Dialogue: 0,0:11:28.89,0:11:30.01,Main,,0,0,0,,Patron!
Dialogue: 0,0:11:30.57,0:11:31.91,Main,,0,0,0,,Aptal mısın sen?
Dialogue: 0,0:11:32.83,0:11:33.97,Main,,0,0,0,,Kuralları unuttun mu?
Dialogue: 0,0:11:34.57,0:11:37.12,Main,,0,0,0,,Hadi! İstediğin 500 kişiyi seç artık!
Dialogue: 0,0:11:37.12,0:11:40.23,Main,,0,0,0,,Evet! Son değiş tokuş bekliyor!
Dialogue: 0,0:11:40.65,0:11:42.02,Main,,0,0,0,,Korsan bayrağınızı verin!
Dialogue: 0,0:11:42.02,0:11:43.69,Main,,0,0,0,,Ne?!
Dialogue: 0,0:11:44.11,0:11:48.81,Main,,0,0,0,,Bu olamaz! Gururumuzu öylece elimizden mi alacaksın?!
Dialogue: 0,0:11:48.81,0:11:52.91,Main,,0,0,0,,Yelkeninize gerek yok. Başka yerlere gidebilmeniz için size lazım sonuçta.
Dialogue: 0,0:11:53.97,0:11:55.79,Main,,0,0,0,,Ne kadar da merhametli!
Dialogue: 0,0:11:55.79,0:11:58.55,Main,,0,0,0,,Ama bizim sembolümüz onun üstünde!
Dialogue: 0,0:11:58.55,0:12:00.63,Main,,0,0,0,,Yelkeni nasıl kullanmamızı bekliyorsun?
Dialogue: 0,0:12:01.21,0:12:04.41,Main,,0,0,0,,Acımana ihtiyacımız yok! Senin olanı al!
Dialogue: 0,0:12:05.09,0:12:05.78,Main,,0,0,0,,Tamam.
Dialogue: 0,0:12:06.19,0:12:11.70,Main,,0,0,0,,İhtiyacımız olan şey sadece işaretiniz olduğundan dolayı tek yapmam gereken üstüne yeni bir tane çizmek.
Dialogue: 0,0:12:12.19,0:12:14.11,Main,,0,0,0,,Böylece yelkeninizi vermenize gerek kalmaz.
Dialogue: 0,0:12:14.99,0:12:18.21,Main,,0,0,0,,Hasır Şapka... Sen çok...!
Dialogue: 0,0:12:17.11,0:12:22.09,Note,,0,0,0,,Yelken: Tilki
Dialogue: 0,0:12:18.27,0:12:19.13,Main,,0,0,0,,İşte böyle!
Dialogue: 0,0:12:20.45,0:12:22.11,Main,,0,0,0,,Bu berbat...!
Dialogue: 0,0:12:22.59,0:12:24.80,Main,,0,0,0,,Bana cidden çok minnettarlar!
Dialogue: 0,0:12:24.80,0:12:25.91,Main,,0,0,0,,Değiliz!
Dialogue: 0,0:12:26.55,0:12:28.71,Main,,0,0,0,,Hey! Hasır Şapka!
Dialogue: 0,0:12:29.43,0:12:32.25,Main,,0,0,0,,Bunu hatırlayacağım!
Dialogue: 0,0:12:33.11,0:12:35.21,Main,,0,0,0,,Ne zamana kadar gülünç olmaya devam edecekler?
Dialogue: 0,0:12:41.39,0:12:45.33,Main,,0,0,0,,İşte işte. Bir daha ayaklıklara çıkmayacağım.
Dialogue: 0,0:12:45.33,0:12:49.33,Main,,0,0,0,,Kaç yıl sürerse sürsün farketmez, beraber köyün peşinden gidebiliriz.
Dialogue: 0,0:12:52.09,0:12:53.41,Main,,0,0,0,,Çocuklar...!
Dialogue: 0,0:12:58.41,0:12:59.77,Main,,0,0,0,,Kıçlarını tekmeledim ve geldim!
Dialogue: 0,0:13:04.77,0:13:06.51,Main,,0,0,0,,Feci yaralanmışsın...
Dialogue: 0,0:13:07.89,0:13:09.21,Main,,0,0,0,,Bu her zamanki halim.
Dialogue: 0,0:13:11.61,0:13:12.95,Main,,0,0,0,,Sağol...
Dialogue: 0,0:13:18.09,0:13:21.21,Main,,0,0,0,,Anlıyorum. Demek ki bu yüzden kabul ettin.
Dialogue: 0,0:13:21.77,0:13:24.20,Main,,0,0,0,,Hiçbir sebep olmasa da kabul ederdin gerçi.
Dialogue: 0,0:13:24.20,0:13:25.77,Main,,0,0,0,,Çok kabasın!
Dialogue: 0,0:13:33.21,0:13:34.83,Main,,0,0,0,,B-Bu da ne?!
Dialogue: 0,0:13:37.39,0:13:38.87,Main,,0,0,0,,
Dialogue: 0,0:13:40.73,0:13:43.79,Main,,0,0,0,,Şampiyon benim!
Dialogue: 0,0:13:44.37,0:13:45.71,Main,,0,0,0,,Yine garip biri...
Dialogue: 0,0:13:46.03,0:13:47.61,Main,,0,0,0,,Neyin şampiyonu?!
Dialogue: 0,0:13:47.61,0:13:50.74,Main,,0,0,0,,Ben delik kazmada dünya şampiyonuyum!
Dialogue: 0,0:13:50.74,0:13:54.04,Main,,0,0,0,,Konuştuğumuz sırada bile kendi rekoruma meydan okuyorum!
Dialogue: 0,0:13:54.30,0:13:58.84,Main,,0,0,0,,Ayaklıklı amcanın evini yıkarak, ne meydan okuması yaptığını sanıyorsun?!
Dialogue: 0,0:14:02.30,0:14:05.99,Main,,0,0,0,,"Ayaklıklı amca" mı...?
Dialogue: 0,0:14:08.12,0:14:09.80,Flashbacks,,0,0,0,,İdare edebilecek misin?
Dialogue: 0,0:14:09.80,0:14:14.96,Flashbacks,,0,0,0,,Tabii ki. Ama kesinlikle bir şampiyon ol ve geri dön!
Dialogue: 0,0:14:14.96,0:14:17.41,Flashbacks,,0,0,0,,Geri döneceğim! Kesinlikle!
Dialogue: 0,0:14:17.92,0:14:19.02,Flashbacks,,0,0,0,,Söz veriyorum!
Dialogue: 0,0:14:20.44,0:14:23.31,Main,,0,0,0,,Sen... Yoksa...?!
Dialogue: 0,0:14:23.94,0:14:25.06,Main,,0,0,0,,Benim!
Dialogue: 0,0:14:26.08,0:14:27.38,Main,,0,0,0,,Dede!
Dialogue: 0,0:14:26.80,0:14:28.45,Main,,0,0,0,,Littonto!
Dialogue: 0,0:14:28.45,0:14:32.28,Main,,0,0,0,,Seni özledim! Seni çok özledim!
Dialogue: 0,0:14:32.70,0:14:36.89,Main,,0,0,0,,Seni son gördüğümden beri çok fazla büyümüşsün...!
Dialogue: 0,0:14:38.34,0:14:40.50,Main,,0,0,0,,Endişelendirdiğim için üzgünüm...
Dialogue: 0,0:14:41.92,0:14:43.68,Main,,0,0,0,,O senin torunun mu?
Dialogue: 0,0:14:45.00,0:14:48.72,Main,,0,0,0,,Dedemi çok özledim ve bu bağlılıkla delik kazmaya başladım!
Dialogue: 0,0:14:48.72,0:14:55.16,Main,,0,0,0,,Ve ben daha farkedemeden dünyanın en büyük kazıcısı olmak hayatımdaki en büyük hedef oldu...
Dialogue: 0,0:14:58.62,0:15:00.51,Main,,0,0,0,,Bu çok iyi değil mi, amca?!
Dialogue: 0,0:15:00.51,0:15:03.35,Main,,0,0,0,,Evet. Size nasıl teşekkür etmeliyim acaba...
Dialogue: 0,0:15:04.82,0:15:08.28,Main,,0,0,0,,Bizim için yaptıklarınızı, unutmayacağım!
Dialogue: 0,0:15:09.70,0:15:11.44,Main,,0,0,0,,Teşekkürler!
Dialogue: 0,0:15:11.44,0:15:14.74,Main,,0,0,0,,Eve dönerken dikkatli olun!
Dialogue: 0,0:15:14.74,0:15:18.98,Main,,0,0,0,,Siz de! Yolculuğunuzun güvenliği için dua edeceğim!
Dialogue: 0,0:15:21.45,0:15:24.50,Main,,0,0,0,,Pekala, millet!
Dialogue: 0,0:15:24.96,0:15:28.57,Main,,0,0,0,,Gidip bir gemi ustası bulalım!
Dialogue: 0,0:15:28.92,0:15:30.47,Main,,0,0,0,,Evet!
Dialogue: 0,0:00:26.30,0:00:31.85,OP11 Credits,,50,0,230,,Translation\N FUNimation
Dialogue: 0,0:00:32.55,0:00:37.02,OP11 Credits,,450,0,280,,Soundtracking\NHalee
Dialogue: 0,0:00:32.55,0:00:37.02,OP11 Credits,,0,460,350,,Infoboxes/Title Card\N BernieCrane
