0,10,10,1Style: OP11 Credits,FOT-Greco Std B,34,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,95,100,1,0,1,2.2,0,2,0,0,0,1Style: Author,Impress BT,20.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.7,0.7,9,10,10,10,1Style: Attack,Duality,37.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.4,1.6,7,20,20,15,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:26.30,0:00:31.85,OP11 Credits,,50,0,230,,Translation  FUNimationDialogue: 0,0:00:32.55,0:00:37.02,OP11 Credits,,450,0,280,,Soundtracking HaleeDialogue: 0,0:00:32.55,0:00:37.02,OP11 Credits,,0,450,350,,Infoboxes/Title Card  BernieCraneDialogue: 0,0:00:37.14,0:00:41.03,OP11 Credits,,0,100,420,,Editing FeesoDialogue: 0,0:00:42.51,0:00:47.12,OP11 Credits,,470,0,290,,Quality Checking  Alasta Galaxy 9000 Mr. LuffyDialogue: 0,0:01:02.50,0:01:06.47,OP11 Credits,,0,30,410,,Timing Galaxy 9000Dialogue: 0,0:00:04.03,0:00:08.12,Lyrics,,0,0,0,,♪ Sıkıntı yok! Hadi ilerleyelim...Dialogue: 0,0:00:08.37,0:00:11.59,Lyrics,,0,0,0,,...sürekli kalplerimizin içindeki güneşle. ♪Dialogue: 0,0:00:11.76,0:00:15.03,Lyrics,,0,0,0,,♪ Güç kenetli ellerimizden geçerken... ♪Dialogue: 0,0:00:15.18,0:00:18.68,Lyrics,,0,0,0,,♪ Dileklerimizi avuçlayalım. ♪Dialogue: 0,0:00:26.32,0:00:32.51,Lyrics,,0,0,0,,♪ Devasa dalgaları aşalım, güçlerimizi birleştirerek. ♪Dialogue: 0,0:00:33.85,0:00:40.33,Lyrics,,0,0,1,,♪ Heyecana doğru acele edelim...  bu bir başlama işareti. ♪Dialogue: 0,0:00:41.01,0:00:47.14,Lyrics,,0,0,0,,♪ İşte şimdi yelken açma zamanı... çapayı kaldıralım. ♪Dialogue: 0,0:00:47.99,0:00:55.00,Lyrics,,0,0,1,,♪ Gökkuşağı renkli rüzgarı kes ve maceralar denizine yönel. ♪Dialogue: 0,0:00:55.13,0:00:58.57,Lyrics,,0,0,0,,♪ Yaralarla dolu bir yolculuk olacak...Dialogue: 0,0:00:58.65,0:01:02.30,Lyrics,,0,0,0,,...ama en önemlisi de tam orada olacak. ♪Dialogue: 0,0:01:02.50,0:01:06.43,Lyrics,,0,0,0,,♪ Bir sıkışıklığa girsek bile önemi yok. ♪Dialogue: 0,0:01:06.50,0:01:08.38,Lyrics,,0,0,0,,♪ Çünkü seni koruyacağım. ♪Dialogue: 0,0:01:09.53,0:01:13.36,Lyrics,,0,0,0,,♪ Sıkıntı yok! Hadi ilerleyelim...Dialogue: 0,0:01:13.71,0:01:16.85,Lyrics,,0,0,0,,...sürekli kalplerimizin içindeki güneşle. ♪Dialogue: 0,0:01:17.23,0:01:20.35,Lyrics,,0,0,1,,♪ Eğer bir gün fırtına gelirse omuz omuza duralım...Dialogue: 0,0:01:20.46,0:01:24.23,Lyrics,,0,0,0,,...ve daha önceki ışığa bakalım ♪Dialogue: 0,0:01:24.72,0:01:27.97,Lyrics,,0,0,0,,♪ Hayallerimizin parçalarını toplarsak...Dialogue: 0,0:01:28.47,0:01:31.58,Lyrics,,0,0,0,,...geleceğe ulaşan bir harita olurlar. ♪Dialogue: 0,0:01:31.73,0:01:34.75,Lyrics,,0,0,0,,♪ O yüzden hep beraber aynı bayrak altında duralım...Dialogue: 0,0:01:35.22,0:01:40.48,Lyrics,,0,0,0,,...ve dileklerimizi avuçlayalım, hepimiz biriz. ♪Dialogue: 0,0:01:50.30,0:01:55.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Kaşgarlı thx to onepace.netDialogue: 0,0:13:43.50,0:13:53.50,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Kaşgarlı thx to onepace.netDialogue: 0,0:25:28.50,0:25:32.70,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Kaşgarlı thx to onepace.netDialogue: 0,0:01:50.30,0:01:55.00,Title,,0,0,420,,Sersem Halka!!Dialogue: 0,0:01:52.05,0:01:55.55,Main,,0,0,0,,Güçlü Sersem Halka dövüşçülerimiz sahaya indi!Dialogue: 0,0:01:55.55,0:01:56.93,Main,,0,0,0,,Karşılarında ise...Dialogue: 0,0:01:57.15,0:02:00.35,Main,,0,0,0,,...1. Tur'da müdahale ekiplerimizin kıçını tekmelemiş olanDialogue: 0,0:02:00.35,0:02:02.77,Main,,0,0,0,,şiddete eğilimli aşçı; Sanji!Dialogue: 0,0:02:02.77,0:02:04.77,Main,,0,0,0,,"Birinci sınıf aşçı" de.Dialogue: 0,0:02:05.90,0:02:12.18,Main,,0,0,0,,Ve başında 60 milyon ödül olan, Korsan Avcısı; Roronoa Zoro!Dialogue: 0,0:02:12.18,0:02:16.31,Main,,0,0,0,,Bizi buraya bunun için mi çağırdılar? Ne gülünç ama!Dialogue: 0,0:02:17.16,0:02:18.54,Main,,0,0,0,,Değil mi Big Pan?Dialogue: 0,0:02:20.54,0:02:22.08,Main,,0,0,0,,Ha?Dialogue: 0,0:02:23.09,0:02:24.06,Main,,0,0,0,,Seni duymadı.Dialogue: 0,0:02:24.06,0:02:25.74,Main,,0,0,0,,Nesi var bunların?Dialogue: 0,0:02:25.74,0:02:27.90,Main,,0,0,0,,Seçime bozukluk karar verecek.Dialogue: 0,0:02:30.22,0:02:31.01,Main,,0,0,0,,Yazı.Dialogue: 0,0:02:31.66,0:02:33.06,Main,,0,0,0,,Yazı.Dialogue: 0,0:02:33.50,0:02:35.43,Main,,0,0,0,,Saha mı, top mu?Dialogue: 0,0:02:35.43,0:02:36.60,Main,,0,0,0,,Top.Dialogue: 0,0:02:36.60,0:02:39.94,Main,,0,0,0,,Sersem Canavarlarımız topu seçtiler!Dialogue: 0,0:02:40.64,0:02:44.24,Main,,0,0,0,,Hasır Şapka'ların top adamı diğer takımın orta çizgisine girecek!Dialogue: 0,0:02:44.24,0:02:45.00,Main,,0,0,0,,Nereyi istiyorsun?Dialogue: 0,0:02:45.00,0:02:45.97,Main,,0,0,0,,Farketmez.Dialogue: 0,0:02:45.97,0:02:49.81,Main,,0,0,0,,Oyun sırasında kafasında top bulunan iki "top adam" vardır!Dialogue: 0,0:02:49.81,0:02:53.94,Main,,0,0,0,,Rakibinizin top adamını rakibinizin halkasının içine atın ve kazanın!Dialogue: 0,0:02:53.94,0:02:55.59,Main,,0,0,0,,Hadi başlayın artık!Dialogue: 0,0:02:56.81,0:02:59.14,Main,,0,0,0,,Hemen pozisyon al top adam!Dialogue: 0,0:02:59.14,0:03:00.16,Main,,0,0,0,,Hey hey.Dialogue: 0,0:03:00.16,0:03:02.73,Main,,0,0,0,,Buna sadece kendin karar verdin.Dialogue: 0,0:03:02.73,0:03:06.50,Main,,0,0,0,,Hala daha top olmayı kabul etmedim.Dialogue: 0,0:03:06.50,0:03:08.80,Main,,0,0,0,,Bu aptal şeyi takmayı reddediyorum!Dialogue: 0,0:03:08.80,0:03:10.60,Main,,0,0,0,,Sızlanmayı kes!Dialogue: 0,0:03:12.79,0:03:14.80,Main,,0,0,0,,Oh! Sana yakışmış!Dialogue: 0,0:03:14.80,0:03:16.54,Main,,0,0,0,,Öyle bir şeye kanmam, aptal!Dialogue: 0,0:03:16.54,0:03:20.47,Main,,0,0,0,,Zoro! Sanji! Size güveniyoruz!Dialogue: 0,0:03:20.47,0:03:24.30,Main,,0,0,0,,Chopper'ı geri kazanın! Şu anda kaybedemeyiz!Dialogue: 0,0:03:24.30,0:03:26.29,Main,,0,0,0,,Gerçekten üzgünüm! Size güveniyoruz!Dialogue: 0,0:03:26.89,0:03:29.98,Main,,0,0,0,,Wotan... İlk kez görüyorum.Dialogue: 0,0:03:29.98,0:03:33.40,Main,,0,0,0,,Sanırım saf kan devler kadar büyük değiller.Dialogue: 0,0:03:35.86,0:03:38.53,Main,,0,0,0,,İstediğiniz kadar tezahürat yapın, işe yaramaz!Dialogue: 0,0:03:38.84,0:03:42.25,Main,,0,0,0,,Takımımızdaki herkes Sersem Halka uzmanı!Dialogue: 0,0:03:43.32,0:03:45.67,Main,,0,0,0,,Bir şey mi istiyorsun, Yarık Kafa?Dialogue: 0,0:03:47.37,0:03:48.90,Main,,0,0,0,,Tekrar dedi...Dialogue: 0,0:03:49.89,0:03:51.84,Main,,0,0,0,,Olamaz, Patron!Dialogue: 0,0:03:52.52,0:03:55.50,Main,,0,0,0,,Şunu yapmaktan vazgeç Hasır Şapka!Dialogue: 0,0:03:57.43,0:04:01.28,Main,,0,0,0,,Bu oyunda araya girmem gerekeceğinden şüpheliyim,Dialogue: 0,0:04:01.28,0:04:03.47,Main,,0,0,0,,o yüzden ben de izleyeceğim.Dialogue: 0,0:04:03.47,0:04:04.84,Main,,0,0,0,,Bir sakıncası var mı?Dialogue: 0,0:04:04.84,0:04:07.05,Main,,0,0,0,,Araya girmek bu oyunda da mı serbest?!Dialogue: 0,0:04:07.05,0:04:09.96,Main,,0,0,0,,Aptal! Her oyunda serbest!Dialogue: 0,0:04:09.96,0:04:14.40,Main,,0,0,0,,Sadece bazıları takımının kazanması için alçalabilirken,Dialogue: 0,0:04:14.40,0:04:17.64,Main,,0,0,0,,bazıları da oyunu doğru dürüst bir şekilde kazanmakta ısrar eder.Dialogue: 0,0:04:17.64,0:04:19.70,Main,,0,0,0,,O yüzden duruma bağlı.Dialogue: 0,0:04:22.33,0:04:25.71,Main,,0,0,0,,Ama küçük bir müdahaleye bile karşı koyamıyorsanızDialogue: 0,0:04:25.71,0:04:28.49,Main,,0,0,0,,denizde bir korsan olarak nasıl hayatta kalmayı umuyorsunuz?Dialogue: 0,0:04:28.49,0:04:31.05,Main,,0,0,0,,Karakter meselesi işte.Dialogue: 0,0:04:31.05,0:04:32.82,Main,,0,0,0,,Böyle mi savunuyorsun?Dialogue: 0,0:04:32.82,0:04:35.44,Main,,0,0,0,,Sizin o takımınız da ne öyle?!Dialogue: 0,0:04:36.03,0:04:38.12,Main,,0,0,0,,Takım bile denmez buna!Dialogue: 0,0:04:38.69,0:04:42.43,Main,,0,0,0,,İstediğin kadar konuş! Maç başladığı anda neler yapabileceklerini gör--!Dialogue: 0,0:04:42.43,0:04:45.76,Main,,0,0,0,,Hey, pislik! Az önce erken başladın!Dialogue: 0,0:04:45.76,0:04:48.10,Main,,0,0,0,,Erken başlamadım! Ben kazandım!Dialogue: 0,0:04:48.63,0:04:49.73,Main,,0,0,0,,Her şeyde.Dialogue: 0,0:04:51.39,0:04:53.83,Main,,0,0,0,,Ne diyorsun sen onca şeyin arasında?!Dialogue: 0,0:04:53.83,0:04:55.35,Main,,0,0,0,,Taş-kağıt-makas'dan bahsediyoruz burada!Dialogue: 0,0:04:55.35,0:04:56.68,Main,,0,0,0,,Kaybettin ama!Dialogue: 0,0:04:56.68,0:05:00.05,Main,,0,0,0,,Top adamınıza karar verin artık!Dialogue: 0,0:05:00.05,0:05:02.64,Main,,0,0,0,,Hala ona karar vermediler...Dialogue: 0,0:05:03.62,0:05:06.03,Main,,0,0,0,,Sanji-kun! O top sana çok yakışmış!Dialogue: 0,0:05:06.36,0:05:10.29,Main,,0,0,0,,Top adam olacağım! Buna en layık kişi benim!Dialogue: 0,0:05:10.29,0:05:14.43,Main,,0,0,0,,Cidden sana yakışıyor. Bir prense benziyorsun.Dialogue: 0,0:05:14.43,0:05:16.39,Main,,0,0,0,,Aptal Krallığı'nın.Dialogue: 0,0:05:18.60,0:05:20.80,Main,,0,0,0,,Oyunu başlatın artık!Dialogue: 0,0:05:22.28,0:05:26.75,Main,,0,0,0,,Bekleyin! Silahlar kurallara aykırı! Kılıçları bırak!Dialogue: 0,0:05:26.75,0:05:28.41,Main,,0,0,0,,Ha? Cidden mi?Dialogue: 0,0:05:28.41,0:05:31.16,Main,,0,0,0,,Evet, bu bir top oyunu!Dialogue: 0,0:05:31.16,0:05:33.75,Main,,0,0,0,,Eğer silahlara izin verilseydi öyle olmazdı!Dialogue: 0,0:05:34.70,0:05:38.25,Main,,0,0,0,,Doğrusu bana hiç farketmez!Dialogue: 0,0:05:38.25,0:05:40.25,Main,,0,0,0,,Hey, sıkıntı olacak mı?Dialogue: 0,0:05:40.25,0:05:42.71,Main,,0,0,0,,Kılıçları olmadan usta bir kılıç ustası...Dialogue: 0,0:05:42.71,0:05:43.76,Main,,0,0,0,,Ne?Dialogue: 0,0:05:44.78,0:05:47.66,Main,,0,0,0,,...değersiz pısırığın teki demektir.Dialogue: 0,0:05:51.60,0:05:55.27,Main,,0,0,0,,Kesin şunu artık!Dialogue: 0,0:05:55.53,0:05:57.28,Main,,0,0,0,,Peki! Ya şimdi ya hiç!Dialogue: 0,0:05:57.28,0:06:01.41,Main,,0,0,0,,Hasır Şapkalar'ın top adamı Sanji rakibin çemberine girdi!Dialogue: 0,0:06:01.41,0:06:03.92,Main,,0,0,0,,Hey aşçı, umarım ezilirsin.Dialogue: 0,0:06:03.92,0:06:04.48,Main,,0,0,0,,Kapa çeneni!Dialogue: 0,0:06:04.48,0:06:07.02,Main,,0,0,0,,Ez onu Big Pan!Dialogue: 0,0:06:07.45,0:06:09.75,Main,,0,0,0,,Kalabalık çok heyecanlı!Dialogue: 0,0:06:09.75,0:06:12.95,Main,,0,0,0,,Big Pan! Gidelim ve ezelim şunları!Dialogue: 0,0:06:15.71,0:06:16.32,Main,,0,0,0,,Ha?Dialogue: 0,0:06:18.76,0:06:20.26,Main,,0,0,0,,Seni duymadı!Dialogue: 0,0:06:20.26,0:06:22.34,Main,,0,0,0,,A-Ahh...Dialogue: 0,0:06:23.98,0:06:25.65,Main,,0,0,0,,Hadi ama...Dialogue: 0,0:06:26.18,0:06:27.29,Main,,0,0,0,,Dikkatini ver!Dialogue: 0,0:06:35.57,0:06:37.61,Main,,0,0,0,,Dialogue: 0,0:06:38.69,0:06:42.61,Main,,0,0,0,,Sersem Canavarlar her zamanki gibi eğleniyorlar!Dialogue: 0,0:06:42.82,0:06:45.78,Main,,0,0,0,,O zaman hadi, eğlence başlasın!Dialogue: 0,0:06:46.11,0:06:49.09,Main,,0,0,0,,Zaman sınırı yok ve ilk skor yapan kazanır!Dialogue: 0,0:06:49.75,0:06:55.03,Main,,0,0,0,,Yani büyük olanın kafasını diğer halkanın içine düşürürsek kazanırız...Dialogue: 0,0:06:58.98,0:07:02.92,Main,,0,0,0,,Ve aşçının kafası bizim halkamıza düşerse kaybederiz...Dialogue: 0,0:07:06.25,0:07:10.60,Main,,0,0,0,,Hasır Şapka Takımı 1. Tur'da kaybettikleri ren geyiğini geri kazanabilecekler mi?!Dialogue: 0,0:07:10.60,0:07:12.14,Main,,0,0,0,,Ezin onları!Dialogue: 0,0:07:12.14,0:07:16.45,Main,,0,0,0,,Yoksa Foxy Takımı bir üyelerini daha mı alacak?!Dialogue: 0,0:07:16.45,0:07:18.92,Main,,0,0,0,,Sersem Halka'da karşılaşmak üzereler!Dialogue: 0,0:07:19.45,0:07:21.20,Main,,0,0,0,,Düdük ötmek üzere!Dialogue: 0,0:07:28.28,0:07:30.28,Main,,0,0,0,,Oyun başlasın!Dialogue: 0,0:07:30.96,0:07:34.20,Main,,0,0,0,,Düşman bölgesinde top adam Sanji ne yapacak acaba?!Dialogue: 0,0:07:34.36,0:07:35.97,Main,,0,0,0,,Geri mi çekilecek yoksa saldıracak mı?!Dialogue: 0,0:07:35.97,0:07:37.79,Main,,0,0,0,,Yapalım şunu!Dialogue: 0,0:07:38.50,0:07:41.87,Main,,0,0,0,,İşte geliyor, "Müdahale Makinesi" Pickles!Dialogue: 0,0:07:41.87,0:07:45.18,Main,,0,0,0,,Tamamdır. Bunun icabına kendim bakacağım.Dialogue: 0,0:07:45.61,0:07:47.51,Main,,0,0,0,,Sling Tackle! Dialogue: 0,0:07:45.61,0:07:47.51,Attack,,0,0,0,,Askı MüdahalesiDialogue: 0,0:07:47.81,0:07:49.17,Main,,0,0,0,,Sen umurumda değilsin!Dialogue: 0,0:07:49.17,0:07:50.98,Main,,0,0,0,,Hedefim sadece sensin!Dialogue: 0,0:07:50.98,0:07:53.69,Main,,0,0,0,,Kazanmak için tek yapmamız gereken seni indirmek!Dialogue: 0,0:07:53.69,0:07:55.82,Main,,0,0,0,,Top adam dövüşü!Dialogue: 0,0:07:56.10,0:07:57.39,Main,,0,0,0,,Collier...! Dialogue: 0,0:07:56.10,0:07:57.39,Attack,,0,0,0,,Boyun...Dialogue: 0,0:08:02.36,0:08:06.40,Main,,0,0,0,,Ne?! Bu da ne...?! Çok kaygan!Dialogue: 0,0:08:06.40,0:08:10.28,Main,,0,0,0,,Aşçı Sanji Big Pan'in kolunun üstünde kayıyor!Dialogue: 0,0:08:10.28,0:08:12.20,Main,,0,0,0,,Çok normal tabii...Dialogue: 0,0:08:12.45,0:08:17.24,Main,,0,0,0,,...Big Pan kaygan derili, çopra balığı olan bir wotan!Dialogue: 0,0:08:17.55,0:08:20.31,Main,,0,0,0,,Ne halt yiyorsun sen?!Dialogue: 0,0:08:20.31,0:08:21.48,Main,,0,0,0,,Hücum!Dialogue: 0,0:08:21.48,0:08:23.32,Main,,0,0,0,,Aptal mısın?!Dialogue: 0,0:08:23.32,0:08:26.32,Main,,0,0,0,,Kime aptal diyorsun sen?!Dialogue: 0,0:08:28.82,0:08:30.26,Main,,0,0,0,,Punk Pass! Dialogue: 0,0:08:28.82,0:08:30.26,Attack,,0,0,0,,Serseri PasDialogue: 0,0:08:36.23,0:08:40.23,Main,,0,0,0,,İşte! Big Pan'ın muhteşem uzun pası!Dialogue: 0,0:08:41.44,0:08:42.90,Main,,0,0,0,,Sanji!Dialogue: 0,0:08:43.58,0:08:47.61,Main,,0,0,0,,Liderleri Hamburg iniş noktasına gidiyor!Dialogue: 0,0:08:47.61,0:08:50.34,Main,,0,0,0,,Yanında Roronoa Zoro da var!Dialogue: 0,0:08:50.34,0:08:53.70,Main,,0,0,0,,Eğer gol atarlarsa seni doğrarım!Dialogue: 0,0:08:53.70,0:08:56.51,Main,,0,0,0,,Kapa çeneni! Sızlanıp duruyorsun!Dialogue: 0,0:08:57.51,0:08:58.85,Main,,0,0,0,,Osoji Tackle! Dialogue: 0,0:08:57.51,0:08:58.85,Attack,,0,0,0,,Süpürme MüdahalesiDialogue: 0,0:08:59.35,0:09:02.72,Main,,0,0,0,,Pickles düşman bölgesine giriyor!Dialogue: 0,0:09:02.72,0:09:05.83,Main,,0,0,0,,Bu sırada Hamburg Sanji'yi havada yakalayabilecek mi?!Dialogue: 0,0:09:06.19,0:09:08.43,Main,,0,0,0,,Evet! Ve sonra...!Dialogue: 0,0:09:08.43,0:09:10.13,Main,,0,0,0,,Gorilla Throw! Dialogue: 0,0:09:08.43,0:09:10.13,Attack,,0,0,0,,Goril AtışıDialogue: 0,0:09:11.40,0:09:12.84,Main,,0,0,0,,Ben de! Ben de!Dialogue: 0,0:09:12.84,0:09:14.60,Main,,0,0,0,,Şimdi onu bekleyen Pickles!Dialogue: 0,0:09:14.83,0:09:16.87,Main,,0,0,0,,Bekle seni pislik! Ne cüretle...!Dialogue: 0,0:09:17.34,0:09:19.43,Main,,0,0,0,,Roronoa yakalamaya çalışıyor ama...!Dialogue: 0,0:09:21.04,0:09:23.02,Main,,0,0,0,,Spinning Tackle! Dialogue: 0,0:09:21.04,0:09:23.02,Attack,,0,0,0,,Dönen MüdahaleDialogue: 0,0:09:25.60,0:09:26.41,Main,,0,0,0,,Ne?!Dialogue: 0,0:09:26.65,0:09:30.88,Main,,0,0,0,,Top adam Sanji de gökyüzüne doğru gönderildi!Dialogue: 0,0:09:32.15,0:09:33.59,Main,,0,0,0,,Sanji!Dialogue: 0,0:09:33.59,0:09:36.76,Main,,0,0,0,,Sonuncu gelen Big Pan!Dialogue: 0,0:09:36.76,0:09:38.37,Main,,0,0,0,,Düşen Hamburg'a doğru koşuyor!Dialogue: 0,0:09:38.37,0:09:39.41,Main,,0,0,0,,Punk Receive! Dialogue: 0,0:09:38.37,0:09:39.41,Attack,,0,0,0,,Serseri AlmasıDialogue: 0,0:09:40.95,0:09:45.60,Main,,0,0,0,,Hamburg Sanji'yi düşman bölgesinin üstünde yakalıyor! İnanılmaz!Dialogue: 0,0:09:48.11,0:09:50.60,Main,,0,0,0,,Halkanın menzilindeler!Dialogue: 0,0:09:52.13,0:09:53.61,Main,,0,0,0,,Aptal kaş!Dialogue: 0,0:09:53.61,0:09:56.43,Main,,0,0,0,,İşte geliyor! Hamburger Smaçı!Dialogue: 0,0:10:01.47,0:10:02.71,Main,,0,0,0,,Ne yapıyorsun?!Dialogue: 0,0:10:02.94,0:10:07.12,Main,,0,0,0,,Bir şey yapın! Zoro! Sanji!Dialogue: 0,0:10:07.12,0:10:09.23,Main,,0,0,0,,Bu kadar çabuk mu bitecek?!Dialogue: 0,0:10:09.23,0:10:11.96,Main,,0,0,0,,Söylemene gerek yok...!Dialogue: 0,0:10:15.43,0:10:20.57,Main,,0,0,0,,Gol atmalarına... izin vermeyeceğim!Dialogue: 0,0:10:26.81,0:10:28.60,Main,,0,0,0,,Skor yapamayacaksın!Dialogue: 0,0:10:29.29,0:10:31.98,Main,,0,0,0,,Hala sapasağlamım!Dialogue: 0,0:10:32.32,0:10:35.45,Main,,0,0,0,,O pislik kılıç ustasının beni kurtararak...Dialogue: 0,0:10:35.88,0:10:37.92,Main,,0,0,0,,...küçük düşürmesine...Dialogue: 0,0:10:38.23,0:10:40.42,Main,,0,0,0,,...izin vermeyeceğim!Dialogue: 0,0:10:48.35,0:10:50.35,Main,,0,0,0,,Gol yok!Dialogue: 0,0:10:50.35,0:10:54.43,Main,,0,0,0,,Top adam Sanji, halkadan o kadar kolay geçmeyecek gibi görünüyor!Dialogue: 0,0:10:59.05,0:11:01.61,Main,,0,0,0,,Öyle gereksiz şeyler yapma!Dialogue: 0,0:11:02.18,0:11:04.44,Main,,0,0,0,,Çok kolay fırlatılıyorsun aptal!Dialogue: 0,0:11:04.97,0:11:08.93,Main,,0,0,0,,Sersem Canavarlar kadar güçlü olan ikili!Dialogue: 0,0:11:08.93,0:11:11.84,Main,,0,0,0,,Elimizde destansı bir oyun var!Dialogue: 0,0:11:12.89,0:11:16.42,Main,,0,0,0,,Bu daha önce hiç olmamıştı! Bir kere bile!Dialogue: 0,0:11:16.69,0:11:19.89,Main,,0,0,0,,Bu canavarlar havaya uçuruldular!Dialogue: 0,0:11:19.89,0:11:24.14,Main,,0,0,0,,Kalabalık afalladı! Hasır Şapka Takımı güçlü!Dialogue: 0,0:11:25.07,0:11:28.91,Main,,0,0,0,,Bana destek çıkman için daha yüz yıl erken!Dialogue: 0,0:11:28.91,0:11:31.24,Main,,0,0,0,,Sana hiç güvenmiyorum çünkü!Dialogue: 0,0:11:31.24,0:11:33.02,Main,,0,0,0,,Harikalar!Dialogue: 0,0:11:33.02,0:11:35.54,Main,,0,0,0,,Pickles'ı gerçekten de fırlattılar!Dialogue: 0,0:11:35.54,0:11:37.64,Main,,0,0,0,,Hamburg-san'ı uçurdular!Dialogue: 0,0:11:43.94,0:11:46.72,Main,,0,0,0,,Senden kim yardım istedi ki?!Dialogue: 0,0:11:46.72,0:11:48.52,Main,,0,0,0,,Ortalıkta çok geziniyorsun!Dialogue: 0,0:11:48.52,0:11:51.46,Main,,0,0,0,,Olamaz! Ne yapıyorsun Hamburg?!Dialogue: 0,0:11:51.46,0:11:53.49,Main,,0,0,0,,Kaybedersen sana bedelini ödetirim!Dialogue: 0,0:11:53.49,0:11:57.74,Main,,0,0,0,,O da ne?! Hasır Şapka takımı garip davranıyor!Dialogue: 0,0:11:57.74,0:12:01.26,Main,,0,0,0,,İki top adam da sınırların içinde ve oyun hala devam ediyorDialogue: 0,0:12:01.26,0:12:03.97,Main,,0,0,0,,ama bu iki takım arkadaşı oynamak yerine tartışıyorlar!Dialogue: 0,0:12:05.15,0:12:07.04,Main,,0,0,0,,Çok komikler!Dialogue: 0,0:12:07.37,0:12:09.34,Main,,0,0,0,,Aptallar! Zoro! Sanji!Dialogue: 0,0:12:09.34,0:12:11.96,Main,,0,0,0,,Ne yapıyorsunuz siz?! İşte şans!Dialogue: 0,0:12:11.96,0:12:13.81,Main,,0,0,0,,Karşı top adam tek başına!Dialogue: 0,0:12:13.81,0:12:16.29,Main,,0,0,0,,Beraber saldırın ve onu halkaya düşürün!Dialogue: 0,0:12:16.29,0:12:17.00,Main,,0,0,0,,Ha?Dialogue: 0,0:12:19.45,0:12:22.92,Main,,0,0,0,,Big Pan sürpriz bir saldırı yapıyor!Dialogue: 0,0:12:26.35,0:12:28.92,Main,,0,0,0,,Too Bad Dance! Dialogue: 0,0:12:26.35,0:12:28.92,Attack,,0,0,0,,Çok Yazık DansıDialogue: 0,0:12:31.77,0:12:34.36,Main,,0,0,0,,Neden kaçıyorsunuz?! Top adam o!Dialogue: 0,0:12:34.78,0:12:39.47,Main,,0,0,0,,Onu biz de biliyoruz! Ama bekle biraz, ayakkabılarının altında kazıklar var!Dialogue: 0,0:12:42.94,0:12:43.84,Main,,0,0,0,,Hey, Hakem!Dialogue: 0,0:12:44.75,0:12:46.89,Main,,0,0,0,,"Silahlar yasak" kuralına ne oldu?!Dialogue: 0,0:12:53.65,0:12:57.74,Main,,0,0,0,,Daha çok belli edemez miydin?!Dialogue: 0,0:12:57.74,0:13:00.37,Main,,0,0,0,,Tesadüfen oraya bakmıyorsa yapacak bir şey yok!Dialogue: 0,0:13:01.01,0:13:03.36,Main,,0,0,0,,Dalga mı geçiyorsun?!Dialogue: 0,0:13:08.80,0:13:10.44,Main,,0,0,0,,Bekle Sanji-kun!Dialogue: 0,0:13:10.44,0:13:14.53,Main,,0,0,0,,Onu sen de gördün!  O şelale gibi terleme de neyin nesi?!Dialogue: 0,0:13:14.53,0:13:19.64,Main,,0,0,0,,H-Hiçbir şey... g-gör... görmedim...Dialogue: 0,0:13:19.64,0:13:20.74,Main,,0,0,0,,Yalancı!Dialogue: 0,0:13:20.74,0:13:23.18,Main,,0,0,0,,Hey bekle! Hakem o!Dialogue: 0,0:13:24.97,0:13:27.79,Main,,0,0,0,,Hasır Şapka Takımı'ndan Sanji'ye sarı kart!Dialogue: 0,0:13:27.79,0:13:29.29,Main,,0,0,0,,Ne dedin sen?!Dialogue: 0,0:13:30.33,0:13:32.79,Main,,0,0,0,,B-Bekle! Bekle! Bekle!Dialogue: 0,0:13:32.79,0:13:36.80,Main,,0,0,0,,Ve işte sarı uyarı kartı!Dialogue: 0,0:13:36.80,0:13:41.20,Main,,0,0,0,,Aşçı Sanji bir tane daha alırsa kırmızı atılma kartı alacak!Dialogue: 0,0:13:41.37,0:13:43.37,Main,,0,0,0,,Ne atılması?!Dialogue: 0,0:13:44.43,0:13:48.35,Main,,0,0,0,,Hakeme saldıracak kadar adi olduğuna inanamıyorum!Dialogue: 0,0:13:48.35,0:13:51.10,Main,,0,0,0,,Kapa çeneni! Aşağıya düşüreceğim seni!Dialogue: 0,0:13:51.10,0:13:52.78,Main,,0,0,0,,Tam bir gokudo!Dialogue: 0,0:13:51.10,0:13:52.78,Note,,0,0,0,,Gokudo: YakuzaDialogue: 0,0:13:52.78,0:13:54.81,Main,,0,0,0,,Her neyse. Onun silahları...Dialogue: 0,0:13:55.23,0:13:57.98,Main,,0,0,0,,Bekle bir saniye! Buna izin var mı?!Dialogue: 0,0:13:59.99,0:14:01.72,Main,,0,0,0,,Tesadüfen görmüyorum...Dialogue: 0,0:14:01.72,0:14:03.53,Main,,0,0,0,,Hey Hakem, bak şuna!Dialogue: 0,0:14:03.53,0:14:06.43,Main,,0,0,0,,O aptal balta kullanıyor! Bir balta!Dialogue: 0,0:14:06.43,0:14:09.36,Main,,0,0,0,,Hayır! Dur! Atılmayı göze alamazsın!Dialogue: 0,0:14:09.36,0:14:13.09,Main,,0,0,0,,Dalga mı geçiyorsun?! Bu kadar delirmişken bunu görmezden gelemem!Dialogue: 0,0:14:13.09,0:14:15.98,Main,,0,0,0,,Görmezden gelmene gerek yok! Amaçları seni sinirlendirmek zaten!Dialogue: 0,0:14:15.98,0:14:18.14,Main,,0,0,0,,Sakinleş! Chopper'ın iyiliği için!Dialogue: 0,0:14:18.14,0:14:20.39,Main,,0,0,0,,Tamamdır! O zaman ben gidip yumruklayacağım!Dialogue: 0,0:14:20.39,0:14:23.51,Main,,0,0,0,,Gidip de işleri daha da sıkıntıya sokma!Dialogue: 0,0:14:23.51,0:14:25.81,Main,,0,0,0,,Sanji-kun! Git ve kazan!Dialogue: 0,0:14:26.37,0:14:27.72,Main,,0,0,0,,Kazanacağım!Dialogue: 0,0:14:26.37,0:14:27.72,Note,,0,0,0,,Aşk PozuDialogue: 0,0:14:29.27,0:14:30.61,Main,,0,0,0,,Seni anlamıyorum...Dialogue: 0,0:14:31.15,0:14:33.66,Main,,0,0,0,,Tamamdır! Tekrardan oyuna!Dialogue: 0,0:14:38.72,0:14:41.33,Main,,0,0,0,,Tekrar başlamayın şuna!Dialogue: 0,0:14:41.54,0:14:43.54,Main,,0,0,0,,Bu hiçbir işe yaramıyor!Dialogue: 0,0:14:43.54,0:14:47.53,Main,,0,0,0,,Ama artık silahları olduğunu bildiğimize göre oyun planımızı değiştirebiliriz!Dialogue: 0,0:14:47.92,0:14:51.20,Main,,0,0,0,,İşini bitirme zamanı!Dialogue: 0,0:14:51.63,0:14:55.07,Main,,0,0,0,,Yoluma çıkma! Ben tek başıma yeterim!Dialogue: 0,0:14:55.07,0:14:58.04,Main,,0,0,0,,Birlikte çalışın! Takımsınız siz!Dialogue: 0,0:14:58.39,0:15:01.47,Main,,0,0,0,,İşte gidiyorlar! Üçü çarpışmak üzere!Dialogue: 0,0:15:03.98,0:15:09.19,Main,,0,0,0,,Derisinin açıkta olduğu yerden saldıramayız! Fazla kaygan!Dialogue: 0,0:15:09.19,0:15:12.92,Main,,0,0,0,,Geriye elleri, maskesi ve mayosu kalıyor...Dialogue: 0,0:15:13.66,0:15:15.39,Main,,0,0,0,,Dojo Sukui Sliding! Dialogue: 0,0:15:13.66,0:15:15.39,Attack,,0,0,0,,Çopra Kaygan KayışDialogue: 0,0:15:15.95,0:15:17.12,Main,,0,0,0,,Kahretsin!Dialogue: 0,0:15:18.36,0:15:20.73,Main,,0,0,0,,Loach Racing Circus! Dialogue: 0,0:15:18.36,0:15:20.73,Attack,,0,0,0,,Çopra Yarışma SirkiDialogue: 0,0:15:23.37,0:15:26.71,Main,,0,0,0,,İşte! Yarışma Sirki hareketleri!Dialogue: 0,0:15:26.71,0:15:29.14,Main,,0,0,0,,İki rakibi de geniş sırtından kayacaklar!Dialogue: 0,0:15:29.14,0:15:32.58,Main,,0,0,0,,Ha! Bu sefer işe yaramayacak! Biraz kayma ile başa çıkabilirim!Dialogue: 0,0:15:32.58,0:15:34.54,Main,,0,0,0,,Şimdi kaçamazlar!Dialogue: 0,0:15:35.17,0:15:38.55,Main,,0,0,0,,Başım dönüyor...!Dialogue: 0,0:15:36.02,0:15:38.55,Main,,0,0,650,,Hadi ama çocuklar! Ciddiyim!Dialogue: 0,0:15:39.01,0:15:42.97,Main,,0,0,0,,Bu sırada diğer iki oyuncu da oyuna yeniden katıldı!Dialogue: 0,0:15:42.97,0:15:46.43,Main,,0,0,0,,Ah! Geri geldiler! Bitirin işlerini!Dialogue: 0,0:15:46.43,0:15:49.49,Main,,0,0,0,,O da ne? Artık giysileri farklı!Dialogue: 0,0:15:49.49,0:15:54.57,Main,,0,0,0,,Liderleri Hamburg, demir muştalar ve demir dirseklikler takıyor!Dialogue: 0,0:15:54.98,0:15:58.37,Main,,0,0,0,,Bu sırada Pickles da dikenli omuz koruyucuları takmış!Dialogue: 0,0:15:58.37,0:16:00.87,Main,,0,0,0,,Bu kesinlikle "silah yok" kuralını çiğniyor!Dialogue: 0,0:16:00.87,0:16:05.34,Main,,0,0,0,,Ah, ama şu anda hakem tesadüfen gerinme hareketlerini yapıyor,Dialogue: 0,0:16:05.34,0:16:08.28,Main,,0,0,0,,ve arkası tamamen dönük!Dialogue: 0,0:16:10.42,0:16:13.05,Main,,0,0,0,,Şimdi kızdım işte Lider!Dialogue: 0,0:16:14.89,0:16:15.89,Main,,0,0,0,,Geliyor!Dialogue: 0,0:16:15.89,0:16:18.27,Main,,0,0,0,,Dojo Coaster! Dialogue: 0,0:16:15.89,0:16:18.27,Attack,,0,0,0,,Çopra Hız TreniDialogue: 0,0:16:21.51,0:16:22.79,Main,,0,0,0,,Her şey dönüyor...!Dialogue: 0,0:16:22.79,0:16:25.06,Main,,0,0,0,,Lider, hadi!Dialogue: 0,0:16:25.06,0:16:26.22,Main,,0,0,0,,Gidelim!Dialogue: 0,0:16:26.22,0:16:27.97,Main,,0,0,0,,Spinning Tackle! Dialogue: 0,0:16:26.22,0:16:27.97,Attack,,0,0,0,,Dönen MüdahaleDialogue: 0,0:16:28.94,0:16:30.81,Main,,0,0,0,,Kendilerine gelmiş oyunculardan bir saldırı!Dialogue: 0,0:16:30.81,0:16:33.77,Main,,0,0,0,,Ama hedefler top adam değil... Kılıç ustası Roronoa!Dialogue: 0,0:16:33.77,0:16:35.61,Main,,0,0,0,,Demir muştalar ile onu hedefliyorlar!Dialogue: 0,0:16:35.61,0:16:37.74,Main,,0,0,0,,Hamburger Hammer! Dialogue: 0,0:16:35.61,0:16:37.74,Attack,,0,0,0,,Hamburger ÇekiciDialogue: 0,0:16:42.95,0:16:44.32,Main,,0,0,0,,Zoro!Dialogue: 0,0:16:44.63,0:16:49.09,Main,,0,0,0,,Saldırı daha bitmedi! Big Pan anında bir saldırı pozisyonu alıyor!Dialogue: 0,0:16:49.09,0:16:53.89,Main,,0,0,0,,Hamburg dirsekliklerini kullanmaya hazırlanıyor!Dialogue: 0,0:16:53.89,0:16:54.52,Main,,0,0,0,,Olamaz!Dialogue: 0,0:16:54.52,0:16:56.25,Main,,0,0,0,,Yoksa...Dialogue: 0,0:16:56.25,0:16:58.83,Main,,0,0,0,,Bu çok tehlikeli! Korkutucu kombo!Dialogue: 0,0:17:01.80,0:17:03.43,Main,,0,0,0,,Tıpkı bir...Dialogue: 0,0:17:03.43,0:17:05.00,Main,,0,0,0,,...ok gibi!Dialogue: 0,0:17:07.06,0:17:09.44,Main,,0,0,0,,Punk Attack! Dialogue: 0,0:17:07.06,0:17:09.44,Attack,,0,0,0,,Serseri SaldırısıDialogue: 0,0:17:22.22,0:17:24.12,Main,,0,0,0,,Zoro!Dialogue: 0,0:17:24.12,0:17:26.83,Main,,0,0,0,,Tuttu! Tam isabet!Dialogue: 0,0:17:26.83,0:17:31.22,Main,,0,0,0,,Sersem Halka'da ölümler beklenen şeylerdir ve bizi ilgilendirmezler.Dialogue: 0,0:17:31.22,0:17:33.22,Main,,0,0,0,,Başım... dönüyor...Dialogue: 0,0:17:33.22,0:17:36.80,Main,,0,0,0,,Foxy Takımı'nın saldırmayı durdurmaya niyeti yok gibi duruyor!Dialogue: 0,0:17:37.44,0:17:38.50,Main,,0,0,0,,Ningen... Dialogue: 0,0:17:37.44,0:17:38.50,Attack,,0,0,0,,İnsan...Dialogue: 0,0:17:39.11,0:17:40.84,Main,,0,0,0,,Taiho! Dialogue: 0,0:17:39.11,0:17:40.84,Attack,,0,0,0,,...TopuDialogue: 0,0:17:40.84,0:17:42.33,Main,,0,0,0,,Ah... Kusacağım...Dialogue: 0,0:17:42.33,0:17:44.78,Main,,0,0,0,,Dikenli omuz koruması yaklaşıyor!Dialogue: 0,0:17:44.78,0:17:47.20,Main,,0,0,0,,Sanji! Çekil oradan!Dialogue: 0,0:17:49.31,0:17:51.26,Main,,0,0,0,,Sling Tackle! Dialogue: 0,0:17:49.31,0:17:51.26,Attack,,0,0,0,,Askı MüdahalesiDialogue: 0,0:17:52.27,0:17:55.25,Main,,0,0,0,,Top adam Sanji'yi ayarlıyorlar!Dialogue: 0,0:17:55.86,0:17:58.65,Main,,0,0,0,,Size Attack: S! Dialogue: 0,0:17:55.86,0:17:58.65,Attack,,0,0,0,,Boyut Saldırısı: SDialogue: 0,0:17:59.32,0:18:03.83,Main,,0,0,0,,Hamburg onu uçarak gönderiyor! Hedefleri skor değil gibi görünüyor!Dialogue: 0,0:18:03.83,0:18:04.28,Main,,0,0,0,,M!Dialogue: 0,0:18:07.87,0:18:08.99,Main,,0,0,0,,L!Dialogue: 0,0:18:11.45,0:18:16.64,Main,,0,0,0,,Sersem Canavarlar muhteşem bir takım saldırısı ortaya çıkarıyor!Dialogue: 0,0:18:17.60,0:18:19.44,Main,,0,0,0,,Ne kadar da kötü...Dialogue: 0,0:18:20.31,0:18:21.23,Main,,0,0,0,,Zoro!Dialogue: 0,0:18:22.98,0:18:24.08,Main,,0,0,0,,Sanji!Dialogue: 0,0:18:27.61,0:18:31.61,Main,,0,0,0,,Hasır Şapka Takımı bundan sonra ayağa kalkamaz gibi duruyor!Dialogue: 0,0:18:31.61,0:18:32.95,Main,,0,0,0,,Çocuk oyuncağı!Dialogue: 0,0:18:34.37,0:18:37.79,Main,,0,0,0,,Rakipler gerçekten de "sersem"!Dialogue: 0,0:18:37.79,0:18:42.33,Main,,0,0,0,,Şimdi geriye kalan tek şey top adamı halkanın içine atmak,Dialogue: 0,0:18:42.33,0:18:45.57,Main,,0,0,0,,ve böylece art arda iki galibiyet oluyor!Dialogue: 0,0:18:46.00,0:18:50.25,Main,,0,0,0,,Yenilmez, fazla güçlü Sersem Canavarlar!Dialogue: 0,0:18:50.25,0:18:51.94,Main,,0,0,0,,Yine kazandık!Dialogue: 0,0:18:56.26,0:18:57.99,Main,,0,0,0,,Hey aşçı...Dialogue: 0,0:18:58.87,0:19:01.04,Main,,0,0,0,,On saniyeliğine bana bir el at...Dialogue: 0,0:19:04.15,0:19:07.78,Main,,0,0,0,,Makul bir... süre...Dialogue: 0,0:19:09.60,0:19:11.51,Main,,0,0,0,,Hey! Şuna bakın!Dialogue: 0,0:19:11.51,0:19:12.53,Main,,0,0,0,,Ne?!Dialogue: 0,0:19:13.23,0:19:16.90,Main,,0,0,0,,Kalktılar! Hasır Şapka Takımı tekrar ayakta!Dialogue: 0,0:19:17.90,0:19:22.45,Main,,0,0,0,,Korkunç derecede çetin ikili,  kılıç ustası Roronoa ve aşçı Sanji!Dialogue: 0,0:19:22.45,0:19:25.08,Main,,0,0,0,,Oyunu nasıl ilginçleştireceklerini biliyorlar!Dialogue: 0,0:19:26.97,0:19:30.82,Main,,0,0,0,,Kalktılar! Şimdi bitirin işlerini!Dialogue: 0,0:19:31.63,0:19:36.99,Main,,0,0,0,,Ama bu ikilinin dövüşecek güçleri kaldı mı acaba?!Dialogue: 0,0:19:36.99,0:19:39.19,Main,,0,0,0,,Hey, beyler...Dialogue: 0,0:19:42.66,0:19:45.60,Main,,0,0,0,,Bir Canavar Burger lütfen!Dialogue: 0,0:19:50.46,0:19:51.42,Main,,0,0,0,,N-Ne?!Dialogue: 0,0:19:51.42,0:19:52.42,Main,,0,0,0,,Ne acaba?Dialogue: 0,0:19:52.42,0:19:57.94,Main,,0,0,0,,Az önce patronumuz bir Canavar Burger sipariş etti!Dialogue: 0,0:20:18.23,0:20:21.93,Main,,0,0,0,,Hey, bu da ne?! Açık açık silah kullanıyorlar!Dialogue: 0,0:20:21.93,0:20:24.40,Main,,0,0,0,,Burger köftesi gibi ezelim...Dialogue: 0,0:20:24.40,0:20:27.11,Main,,0,0,0,,Turşu gibi doğrayalım...Dialogue: 0,0:20:27.11,0:20:28.57,Main,,0,0,0,,Misafirler kim?!Dialogue: 0,0:20:28.57,0:20:31.54,Main,,0,0,0,,Yeşil marul ile sarı peynir!Dialogue: 0,0:20:33.34,0:20:36.33,Main,,0,0,0,,Büyük tavalar arasında ezersen olur sana bir...Dialogue: 0,0:20:39.06,0:20:41.76,Main,,0,0,0,,...Canavar Burger!Dialogue: 0,0:20:41.76,0:20:46.52,Main,,0,0,0,,İşte! Çok korkunç üçlü silah saldırıları!Dialogue: 0,0:20:50.05,0:20:53.76,Main,,0,0,0,,Bundan kaçış yok! Böyle bir şey kesinlikle bir kırmızı kart gerektiriyor!Dialogue: 0,0:20:53.76,0:20:56.97,Main,,0,0,0,,Hasır Şapka Takımı için kaçınılmaz bir mağlubiyet!Dialogue: 0,0:21:01.91,0:21:04.41,Main,,0,0,0,,Ama, o da ne?!Dialogue: 0,0:21:04.41,0:21:10.07,Main,,0,0,0,,Hakem gerinme hareketlerini yaparken tesadüfen arkasını dönmüş!Dialogue: 0,0:21:10.07,0:21:11.95,Main,,0,0,0,,Ne yapıyorsun sen?!Dialogue: 0,0:21:11.95,0:21:12.92,Main,,0,0,0,,Dur Luffy!Dialogue: 0,0:21:12.92,0:21:13.81,Main,,0,0,0,,Olmaz!Dialogue: 0,0:21:13.81,0:21:16.49,Main,,0,0,0,,Eğer sakinleşmezsen rakibin planına uymuş olursun!Dialogue: 0,0:21:16.94,0:21:19.22,Main,,0,0,0,,Dayanmamız gerek Luffy!Dialogue: 0,0:21:19.68,0:21:24.66,Main,,0,0,0,,Her şey hazır! Sersem Canavarlar'ın saldırısı başladı!Dialogue: 0,0:21:24.66,0:21:28.43,Main,,0,0,0,,Oyunda yaşanan hiçbir şey beni ilgilendirmez artık!Dialogue: 0,0:21:29.14,0:21:31.68,Main,,0,0,0,,Doğal olarak top adam Sanji'nin peşinden gidiyorlar!Dialogue: 0,0:21:31.68,0:21:37.94,Main,,0,0,0,,Ezilip, kesilip, dümdüz edilip, bir burger köftesi mi olacak?!Dialogue: 0,0:21:39.55,0:21:44.20,Main,,0,0,0,,Sizin gibi üçüncü sınıf malzemelerden düzgün bir şey yapamam amaDialogue: 0,0:21:44.20,0:21:46.58,Main,,0,0,0,,yinede hepinizi pişireceğim!Dialogue: 0,0:21:47.65,0:21:49.12,Main,,0,0,0,,Kıyma olacaksın!Dialogue: 0,0:21:49.48,0:21:51.12,Main,,0,0,0,,Troisième...Dialogue: 0,0:21:49.48,0:21:51.12,Attack,,0,0,0,,Üçüncü Sınıf...Dialogue: 0,0:21:51.12,0:21:51.92,Main,,0,0,0,,Hızlı!Dialogue: 0,0:21:51.92,0:21:52.92,Main,,0,0,0,,...Haché!Dialogue: 0,0:21:51.92,0:21:52.92,Attack,,0,0,0,,...KıymaDialogue: 0,0:22:07.51,0:22:09.47,Main,,0,0,0,,Bouquetière...Dialogue: 0,0:22:07.51,0:22:09.47,Attack,,0,0,0,,Karışık Sebze...Dialogue: 0,0:22:09.47,0:22:11.26,Main,,0,0,0,,...Shot! Dialogue: 0,0:22:09.47,0:22:11.26,Attack,,0,0,0,,...VuruşuDialogue: 0,0:22:17.69,0:22:19.02,Main,,0,0,0,,Olamaz!Dialogue: 0,0:22:19.02,0:22:21.29,Main,,0,0,0,,Ezmeyi bırak!Dialogue: 0,0:22:24.64,0:22:26.09,Main,,0,0,0,,Lider!Dialogue: 0,0:22:32.50,0:22:34.41,Main,,0,0,0,,Sen ne cüretle...?!Dialogue: 0,0:22:40.26,0:22:42.84,Main,,0,0,0,,Bunun bir takım dövüşü olduğunu unutma.Dialogue: 0,0:22:43.76,0:22:45.38,Main,,0,0,0,,Seni...!Dialogue: 0,0:22:45.38,0:22:48.38,Main,,0,0,0,,Seni doğrayacağım!Dialogue: 0,0:22:50.13,0:22:52.05,Main,,0,0,0,,Mutoryu... Dialogue: 0,0:22:50.13,0:22:52.05,Attack,,0,0,0,,Kılıçsız Stil...Dialogue: 0,0:22:53.32,0:22:54.89,Main,,0,0,0,,...Tatsu Dialogue: 0,0:22:53.32,0:22:54.89,Attack,,0,0,0,,...Ejderha...Dialogue: 0,0:22:55.61,0:22:57.63,Main,,0,0,0,,...Maki! Dialogue: 0,0:22:55.61,0:22:57.63,Attack,,0,0,0,,...KasırgasıDialogue: 0,0:23:02.58,0:23:08.82,Main,,0,0,0,,B-Bu da ne?! Big Pan Pickles'ın dönen kılıçlarının kurbanı oldu!Dialogue: 0,0:23:09.85,0:23:13.34,Main,,0,0,0,,Olamaz! Kahretsin!Dialogue: 0,0:23:16.77,0:23:19.04,Main,,0,0,0,,Anti-Manner... Dialogue: 0,0:23:16.77,0:23:19.04,Attack,,0,0,0,,Adapsız...Dialogue: 0,0:23:23.18,0:23:26.68,Main,,0,0,0,,...Kick Course! Dialogue: 0,0:23:23.18,0:23:26.68,Attack,,0,0,0,,...Tekme ServisiDialogue: 0,0:23:30.30,0:23:32.57,Main,,0,0,0,,B-B-B-Bu da ne?!Dialogue: 0,0:23:32.57,0:23:36.33,Main,,0,0,0,,Düşen Big Pan'ın vücudu tekrar yukarı kalktı!Dialogue: 0,0:23:36.33,0:23:42.03,Main,,0,0,0,,Muazzam bir tekme yiyen Big Pan ayakta duruyor ve sersemlemiş durumda!Dialogue: 0,0:23:42.03,0:23:45.50,Main,,0,0,0,,Ah! Şimdi de kılıç ustası Zoro geliyor!Dialogue: 0,0:23:45.50,0:23:49.41,Main,,0,0,0,,Doğal olarak hedefi top adam Big Pan!Dialogue: 0,0:23:50.05,0:23:51.74,Main,,0,0,0,,Beni geçemezsin!Dialogue: 0,0:24:00.52,0:24:03.62,Main,,0,0,0,,Yettiniz artık! Sen de hakem de!Dialogue: 0,0:24:03.94,0:24:08.59,Main,,0,0,0,,Kalabalık-  Hayır, Hakem'e tam isabet!Dialogue: 0,0:24:09.64,0:24:12.69,Main,,0,0,0,,Bilerek yaptı...!Dialogue: 0,0:24:12.69,0:24:15.63,Main,,0,0,0,,Hakemi... ne cüretle...?!Dialogue: 0,0:24:15.63,0:24:18.27,Main,,0,0,0,,Kırmızı kart!Dialogue: 0,0:24:18.58,0:24:20.13,Main,,0,0,0,,Ha?Dialogue: 0,0:24:20.13,0:24:23.94,Main,,0,0,0,,Kartlarım, düdüğüm... Yoklar...Dialogue: 0,0:24:24.95,0:24:26.28,Main,,0,0,0,,Ne kötü bir kızsın.Dialogue: 0,0:24:27.52,0:24:29.85,Main,,0,0,0,,Eski bir alışkanlığım yüzünden.Dialogue: 0,0:24:35.67,0:24:37.38,Main,,0,0,0,,Ah, ne oldu...Dialogue: 0,0:24:37.38,0:24:42.86,Main,,0,0,0,,...Hasır Şapka Takımı'na?! Tek başına kalan Big Pan'ın önünde yine mi tartışıyorlar?!Dialogue: 0,0:24:47.56,0:24:51.70,Main,,0,0,0,,Armée de L'Air Power Shoot!Dialogue: 0,0:24:47.56,0:24:51.70,Attack,,0,0,0,,Hava Kuvveti Güç VuruşuDialogue: 0,0:24:55.47,0:24:57.58,Main,,0,0,0,,B-Bu da ne?!Dialogue: 0,0:24:57.90,0:24:58.81,Main,,0,0,0,,Wotan...Dialogue: 0,0:24:58.98,0:24:59.51,Main,,0,0,0,,Ne?!Dialogue: 0,0:24:59.51,0:25:00.18,Main,,0,0,0,,Olamaz!Dialogue: 0,0:25:00.18,0:25:02.68,Main,,0,0,0,,devasa Big Pan...Dialogue: 0,0:25:02.68,0:25:05.65,Main,,0,0,0,,havalandı!Dialogue: 0,0:25:05.65,0:25:07.15,Main,,0,0,0,,Gidin!Dialogue: 0,0:25:07.15,0:25:08.99,Main,,0,0,0,,Hedefleri gol halkası!Dialogue: 0,0:25:08.99,0:25:09.99,Main,,0,0,0,,Olamaz!Dialogue: 0,0:25:24.50,0:25:28.44,Main,,0,0,0,,Goool!!!