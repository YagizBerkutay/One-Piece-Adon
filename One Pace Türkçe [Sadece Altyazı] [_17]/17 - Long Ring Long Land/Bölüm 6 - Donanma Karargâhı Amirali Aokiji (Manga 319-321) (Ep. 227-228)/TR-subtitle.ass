,100,0,0,1,2,0,2,10,10,10,1Style: OP11 Credits,FOT-Greco Std B,34,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,95,100,1,0,1,2.2,0,2,0,0,0,1Style: Author,Impress BT,20.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.7,0.7,9,10,10,10,1Style: Attack,Duality,35.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.4,1.6,7,20,20,15,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:01.77,0:00:04.23,Main,,0,0,0,,Millet! Bir ada görüyorum!Dialogue: 0,0:00:04.48,0:00:06.22,Main,,0,0,0,,Dialogue: 0,0:00:06.82,0:00:08.60,Main,,0,0,0,,Issız bir ada gibi duruyor.Dialogue: 0,0:00:08.74,0:00:11.58,Main,,0,0,0,,Çapayı hazırlayın! Adaya çıkacağız!Dialogue: 0,0:00:12.03,0:00:14.54,Main,,0,0,0,,O zaman, gidip biraz yiyecek bulalım.Dialogue: 0,0:00:14.79,0:00:15.86,Main,,0,0,0,,Evet!Dialogue: 0,0:00:16.02,0:00:18.41,Main,,0,0,0,,Dinleyin. Fare ya da kurbağa getirmek yok, tamam mı?Dialogue: 0,0:00:18.46,0:00:22.71,Main,,0,0,0,,Ne kadar da bencil birisin. Yedikten sonra, hepsi aynı zaten.Dialogue: 0,0:00:30.90,0:00:33.56,Main,,0,0,0,,Hey, Chopper. Hiç şifalı ot bulabildin mi?Dialogue: 0,0:00:33.74,0:00:38.86,Main,,0,0,0,,Bayağı bir topladım ama bu adada daha ender bitkiler de olabilir.Dialogue: 0,0:00:39.50,0:00:42.06,Main,,0,0,0,,Ayrıca, bir şey beni bir süredir rahatsız ediyor.Dialogue: 0,0:00:42.56,0:00:46.12,Main,,0,0,0,,Bu yol boyunca giden garip oluk da neyin nesi acaba...Dialogue: 0,0:00:46.22,0:00:48.22,Main,,0,0,0,,Cidden bu ne ki acaba?Dialogue: 0,0:00:48.54,0:00:50.90,Main,,0,0,0,,Bir tür bisiklet geçmiş gibi duruyor.Dialogue: 0,0:00:51.22,0:00:53.49,Main,,0,0,0,,Hey, hey. Burası ıssız bir ada değil mi?Dialogue: 0,0:00:53.62,0:00:56.36,Main,,0,0,0,,Burada kimse olmadığından dolayı bu bir bisiklet izi olamaz.Dialogue: 0,0:00:57.14,0:00:58.40,Main,,0,0,0,,Doğru ya.Dialogue: 0,0:00:59.12,0:01:01.87,Main,,0,0,0,,Hey, ormanı geçtik sayılır!Dialogue: 0,0:01:04.96,0:01:07.68,Main,,0,0,0,,Bir anda açık bir alana çıktık.Dialogue: 0,0:01:08.30,0:01:09.02,Main,,0,0,0,,Dialogue: 0,0:01:10.20,0:01:12.30,Main,,0,0,0,,Nesi var Chopper'ın?Dialogue: 0,0:01:12.54,0:01:15.30,Main,,0,0,0,,O kayaya doğru gidiyor. Bir şey mi var orada?Dialogue: 0,0:01:16.20,0:01:17.20,Main,,0,0,0,,Dialogue: 0,0:01:18.60,0:01:19.93,Main,,0,0,0,,Lanet Chopper!Dialogue: 0,0:01:19.98,0:01:22.68,Main,,0,0,0,,O devasa mantarı kendine saklamak istiyor olmalı!Dialogue: 0,0:01:22.78,0:01:23.72,Main,,0,0,0,,Bekle!Dialogue: 0,0:01:26.61,0:01:28.06,Main,,0,0,0,,Ne oldu, Chopper?!Dialogue: 0,0:01:28.70,0:01:30.53,Main,,0,0,0,,Bir şey olmuş gibi duruyor. Gidelim!Dialogue: 0,0:01:30.78,0:01:32.99,Main,,0,0,0,,Dialogue: 0,0:01:32.85,0:01:36.80,Captions,,0,930,80,,Donanma Karargahı Amirali                AokijiDialogue: 0,0:01:33.20,0:01:35.07,Main,,0,0,0,,Bu da ne?!Dialogue: 0,0:01:39.24,0:01:41.92,Main,,0,0,0,,Dialogue: 0,0:01:42.20,0:01:43.25,Main,,0,0,0,,Tanuki?Dialogue: 0,0:01:44.10,0:01:45.87,Main,,0,0,0,,Ren geyiğiyim ben! Bak! Boynuzlarım var!Dialogue: 0,0:01:46.08,0:01:48.13,Main,,0,0,0,,İyi misin, Chopper?!Dialogue: 0,0:01:48.96,0:01:50.42,Main,,0,0,0,,Bu da kim?!Dialogue: 0,0:01:51.46,0:01:52.63,Main,,0,0,0,,Ne oldu?!Dialogue: 0,0:01:53.13,0:01:54.68,Main,,0,0,0,,Ne oldu, Luffy?!Dialogue: 0,0:01:55.34,0:01:56.80,Main,,0,0,0,,Siz kimsiniz, beyler?Dialogue: 0,0:01:57.26,0:01:58.51,Main,,0,0,0,,Asıl sen kimsin?!Dialogue: 0,0:01:59.47,0:02:01.48,Main,,0,0,0,,O dev adam da kim?Dialogue: 0,0:02:01.60,0:02:03.48,Main,,0,0,0,,O adam da kim?!Dialogue: 0,0:02:11.86,0:02:12.86,Main,,0,0,0,,Robin!Dialogue: 0,0:02:14.66,0:02:15.99,Main,,0,0,0,,Ne oldu, Robin-chan?!Dialogue: 0,0:02:16.38,0:02:17.22,Main,,0,0,0,,Robin!Dialogue: 0,0:02:17.52,0:02:20.41,Main,,0,0,0,,N-N-Neden öyle kaskatı kesildin?!Dialogue: 0,0:02:20.99,0:02:21.92,Main,,0,0,0,,Robin...Dialogue: 0,0:02:22.62,0:02:24.04,Main,,0,0,0,,Dialogue: 0,0:02:24.20,0:02:27.62,Main,,0,0,0,,Hey hey, bu kadar şiddet yanlısı olmayın, beyler.Dialogue: 0,0:02:28.13,0:02:30.54,Main,,0,0,0,,Buraya emirler doğrultusuyla gelmedim sonuçta.Dialogue: 0,0:02:30.92,0:02:33.38,Main,,0,0,0,,Hava güzel olduğu için, bir gezintiye çıkayım dedim.Dialogue: 0,0:02:33.66,0:02:36.17,Main,,0,0,0,,Emirler mi?! Hangi örgüttensin?!Dialogue: 0,0:02:40.96,0:02:45.22,Main,,0,0,0,,İyi bir kadın olmuşsun...Dialogue: 0,0:02:45.72,0:02:46.94,Main,,0,0,0,,Nico Robin.Dialogue: 0,0:04:37.57,0:04:40.48,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Kaşgarlı thx to onepace.netDialogue: 0,0:13:33.70,0:13:41.70,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Kaşgarlı thx to onepace.netDialogue: 0,0:30:31.70,0:30:34.60,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Kaşgarlı thx to onepace.netDialogue: 0,0:04:37.57,0:04:40.48,Title,,0,0,230,,Donanma Karargahı Amirali AokijiDialogue: 0,0:04:52.28,0:04:55.20,Main,,0,0,0,,Robin'in bu kadar sarsılmış olması...Dialogue: 0,0:04:55.46,0:04:56.18,Main,,0,0,0,,Kim o?Dialogue: 0,0:05:04.46,0:05:05.59,Main,,0,0,0,,Denizci.Dialogue: 0,0:05:06.52,0:05:09.66,Main,,0,0,0,,Donanma Karargahı Amirali... Aokiji.Dialogue: 0,0:05:10.10,0:05:11.26,Main,,0,0,0,,Amiral mi?!Dialogue: 0,0:05:11.26,0:05:15.43,Main,,0,0,0,,A-Amiral mi? O kadar yüksekte mi?Dialogue: 0,0:05:17.66,0:05:22.57,Main,,0,0,0,,Donanma'nın içinde Amiral rütbesine sahip sadece üç kişi var.Dialogue: 0,0:05:24.64,0:05:25.80,Main,,0,0,0,,Akainu...Dialogue: 0,0:05:26.12,0:05:27.50,Main,,0,0,0,,Aokiji...Dialogue: 0,0:05:27.94,0:05:29.30,Main,,0,0,0,,Kizaru...Dialogue: 0,0:05:30.24,0:05:34.56,Main,,0,0,0,,Onların üstündeki tek kişi ise Donanma'nın en üst yetkilisi olarak hüküm süren Filo Amirali Sengoku.Dialogue: 0,0:05:34.72,0:05:40.74,Main,,0,0,0,,O adam Dünya Hükümeti'nin en güçlüleri olarak anılan üç adamdan biri.Dialogue: 0,0:05:41.62,0:05:44.00,Main,,0,0,0,,N-Neden senin gibi biri burada?!Dialogue: 0,0:05:44.20,0:05:48.36,Main,,0,0,0,,Neden gidip birkaç milyon beli ödüllü büyük korsanlarla uğraşmıyorsun?!Dialogue: 0,0:05:48.70,0:05:50.14,Main,,0,0,0,,B-Başka bir yere git!Dialogue: 0,0:05:50.14,0:05:50.68,Main,,0,0,0,,Dialogue: 0,0:05:52.34,0:05:53.72,Main,,0,0,0,,Dialogue: 0,0:05:53.86,0:05:58.12,Main,,0,0,0,,Süper iri göğüslü seksi bir bayan daha! Bu akşam boş musun?Dialogue: 0,0:05:58.33,0:06:00.47,Main,,0,0,0,,Ne yapıyorsun sen sırık pislik?!Dialogue: 0,0:06:00.67,0:06:02.53,Main,,0,0,0,,Dediklerimizi dinle, pislik!Dialogue: 0,0:06:03.23,0:06:06.43,Main,,0,0,0,,Bekleyin biraz, beyler...Dialogue: 0,0:06:06.59,0:06:08.79,Main,,0,0,0,,Dediklerimi dinlemediniz mi?Dialogue: 0,0:06:09.63,0:06:13.56,Main,,0,0,0,,Sadece gezintiye çıktığımı söyledim, değil mi? Bu kadar gaza gelmeyin.Dialogue: 0,0:06:14.57,0:06:17.40,Main,,0,0,0,,Sonuçta siz şeysiniz... şey... anlarsın ya...Dialogue: 0,0:06:17.67,0:06:18.85,Main,,0,0,0,,"Şey" mi?Dialogue: 0,0:06:19.05,0:06:20.31,Main,,0,0,0,,Dialogue: 0,0:06:21.31,0:06:22.91,Main,,0,0,0,,Unuttum. Boş verin.Dialogue: 0,0:06:23.13,0:06:25.35,Main,,0,0,0,,Dediğin hiçbir şey mantıklı değil!Dialogue: 0,0:06:25.47,0:06:26.83,Main,,0,0,0,,Bu adamın nesi var?!Dialogue: 0,0:06:26.95,0:06:29.41,Main,,0,0,0,,Hey, Robin, onu başkasıyla karıştırmadığına emin misin?Dialogue: 0,0:06:29.56,0:06:31.73,Main,,0,0,0,,Onun gibi birinin Donanma Amirali olmasının imkanı yok!Dialogue: 0,0:06:31.93,0:06:36.21,Main,,0,0,0,,Hey, hey... Başkalarını dış görünüşlerine göre yargılamayın.Dialogue: 0,0:06:37.81,0:06:42.13,Main,,0,0,0,,Bir denizci olarak benim mottom "tembel adalet."Dialogue: 0,0:06:42.41,0:06:44.05,Main,,0,0,0,,Görünüşüne tamamen uyuyor!Dialogue: 0,0:06:44.21,0:06:46.21,Main,,0,0,0,,Bu durumda, şey...Dialogue: 0,0:06:46.63,0:06:48.67,Main,,0,0,0,,Dialogue: 0,0:06:49.34,0:06:49.34,Main,,0,0,0,,Ah, bir saniye izin verin...Dialogue: 0,0:06:49.42,0:06:51.59,Main,,0,0,0,,Ayakta durmak beni yordu.Dialogue: 0,0:06:52.51,0:06:55.34,Main,,0,0,0,,O zaman neden deminden beri ayakta uyuyordun?Dialogue: 0,0:06:55.85,0:06:58.23,Main,,0,0,0,,Her neyse, uzun lafın kısası,Dialogue: 0,0:06:58.37,0:07:01.55,Main,,0,0,0,,sizi yakalamak gibi bir niyetim yok, o yüzden endişelenmeyin.Dialogue: 0,0:07:02.43,0:07:07.69,Main,,0,0,0,,Arabasta olayından sonra ortadan kaybolan  Nico Robin'in nerede olduğunu bulmak için geldim sadece.Dialogue: 0,0:07:07.97,0:07:10.29,Main,,0,0,0,,Tahmin ettiğim gibi, sizinle berabermiş.Dialogue: 0,0:07:10.99,0:07:12.60,Main,,0,0,0,,Harbiden duyarsız bir adam, değil mi?Dialogue: 0,0:07:13.21,0:07:15.44,Main,,0,0,0,,Küstah konuşma şekli bir lider olduğunu gösteriyor.Dialogue: 0,0:07:15.83,0:07:19.31,Main,,0,0,0,,Bunu en azından Karargah'a bildirmem gerekecek.Dialogue: 0,0:07:19.47,0:07:24.91,Main,,0,0,0,,Bir tane daha aranan kişi ile, başınızdaki toplam ödülünüz değişti.Dialogue: 0,0:07:25.43,0:07:31.19,Main,,0,0,0,,100 milyon... artı 60 milyon... artı 79 milyon eşittir...Dialogue: 0,0:07:33.55,0:07:35.89,Main,,0,0,0,,Bilmiyorum ama eminim çok düşük değildir.Dialogue: 0,0:07:36.01,0:07:37.34,Main,,0,0,0,,Neden hesaplamıyorsun?Dialogue: 0,0:07:39.03,0:07:41.05,Main,,0,0,0,,Gomu Gomu no...! Dialogue: 0,0:07:41.33,0:07:42.61,Main,,0,0,0,,Bekle biraz! Bekle, Luffy!Dialogue: 0,0:07:42.76,0:07:44.81,Main,,0,0,0,,Dur! Dur!Dialogue: 0,0:07:44.97,0:07:47.35,Main,,0,0,0,,Bırakın beni! Siz ne yapıyorsunuz?!Dialogue: 0,0:07:47.53,0:07:49.15,Main,,0,0,0,,Onunla dövüşmenin ne anlamı var?!Dialogue: 0,0:07:49.27,0:07:51.23,Main,,0,0,0,,O en güçlü denizcilerden!Dialogue: 0,0:07:51.29,0:07:54.55,Main,,0,0,0,,Ne olmuş yani?! Robin'i dövüşmeden öylece teslim edeceğimizi mi söylüyorsun?!Dialogue: 0,0:07:54.65,0:07:55.82,Main,,0,0,0,,Seni pislik!Dialogue: 0,0:07:55.87,0:07:59.28,Main,,0,0,0,,Beyler, şey... Hiçbir şey yapmayacağımı söyledim ya.Dialogue: 0,0:07:59.97,0:08:01.67,Main,,0,0,0,,İşini bitireceğim!Dialogue: 0,0:08:01.82,0:08:02.99,Main,,0,0,0,,Kes şunu, Luffy!Dialogue: 0,0:08:03.13,0:08:06.01,Main,,0,0,0,,Kaç kere size gezintiye çıktığımı söyledim.Dialogue: 0,0:08:06.19,0:08:09.61,Main,,0,0,0,,Ne, gezinti mi? O zaman buradan geçme! Git buradan!Dialogue: 0,0:08:10.01,0:08:11.57,Main,,0,0,0,,Mantıksız konuşuyorsun.Dialogue: 0,0:08:11.83,0:08:13.88,Main,,0,0,0,,Garip bir şekilde Luffy üstün çıktı.Dialogue: 0,0:08:19.29,0:08:23.01,Main,,0,0,0,,D-Denizciydin demek... Keşke daha önce söyleseydin.Dialogue: 0,0:08:23.23,0:08:25.01,Main,,0,0,0,,Bu insanlar da kim?Dialogue: 0,0:08:26.23,0:08:27.51,Main,,0,0,0,,Hey, sakin olun.Dialogue: 0,0:08:27.69,0:08:29.55,Main,,0,0,0,,Burası ıssız bir ada değil mi yani?Dialogue: 0,0:08:29.97,0:08:36.41,Main,,0,0,0,,Hayır. Onlar muhtemelen batan bir gemiden buraya sürüklenen yolcular.Dialogue: 0,0:08:37.13,0:08:43.23,Main,,0,0,0,,Yaklaşık bir ay önce, bu bölgede bir yolcu gemisinin kaybolduğuna dair bir ihbar almıştık.Dialogue: 0,0:08:48.37,0:08:52.57,Main,,0,0,0,,Şey... Tamam. Gideceğim ama ondan önce...Dialogue: 0,0:08:53.11,0:08:56.41,Main,,0,0,0,,Siz, hepiniz hemen yola çıkmaya hazırlanın.Dialogue: 0,0:08:57.37,0:09:01.17,Main,,0,0,0,,Neyse ki, buradan çok uzak olmayan, ıssız bir ada var.Dialogue: 0,0:09:02.05,0:09:04.55,Main,,0,0,0,,İhtiyaç duyduğunuz şeyler için oraya gidebilirsiniz.Dialogue: 0,0:09:05.71,0:09:10.80,Main,,0,0,0,,Hey, millet! Bu adamın dediklerini dinlemek zorunda değilsiniz! O bir denizci!Dialogue: 0,0:09:14.27,0:09:16.21,Main,,0,0,0,,Bu bir sorun mu?Dialogue: 0,0:09:19.67,0:09:22.93,Main,,0,0,0,,Ah... Evet. Evet, doğru. Doğru. Evet. Evet.Dialogue: 0,0:09:23.05,0:09:26.59,Main,,0,0,0,,Normalde, denizciler müttefikiniz ve biz de kötü adamlarız, değil mi?Dialogue: 0,0:09:27.19,0:09:28.55,Main,,0,0,0,,Gülecek zaman mı şimdi?!Dialogue: 0,0:09:28.97,0:09:31.25,Main,,0,0,0,,Onlara yardım edeceğini söyledi.Dialogue: 0,0:09:31.46,0:09:34.05,Main,,0,0,0,,Öyle dese bile, bir gemisi var mı ki?Dialogue: 0,0:09:34.19,0:09:37.19,Main,,0,0,0,,Bizimkinin dışında, başka hiçbir gemi görmedim.Dialogue: 0,0:09:37.43,0:09:39.95,Main,,0,0,0,,Gemi yok. Seyir Pusulaları da yok.Dialogue: 0,0:09:40.13,0:09:43.79,Main,,0,0,0,,O yakındaki adaya nasıl gidecekler ki?Dialogue: 0,0:09:43.89,0:09:45.15,Main,,0,0,0,,Ah, sıkıntı yok.Dialogue: 0,0:09:45.89,0:09:47.91,Main,,0,0,0,,Dediğin hiçbir şey güvenilir gelmiyor.Dialogue: 0,0:09:48.99,0:09:49.90,Main,,0,0,0,,Bu doğru...Dialogue: 0,0:09:50.36,0:09:50.90,Main,,0,0,0,,Dialogue: 0,0:09:52.27,0:09:55.19,Main,,0,0,0,,O adam bunu yapabilir.Dialogue: 0,0:10:05.96,0:10:07.53,Main,,0,0,0,,Tamamdır, bitti!Dialogue: 0,0:10:07.65,0:10:11.39,Main,,0,0,0,,Yiyecek ve su yükledik. Bu kadarı ile bir süre idare edersiniz.Dialogue: 0,0:10:11.73,0:10:14.01,Main,,0,0,0,,Arada bir çalışmak iyi hissettiriyor.Dialogue: 0,0:10:14.11,0:10:17.47,Main,,0,0,0,,Evet, iyi hissettiriyor! Harbiden anlayışlı bir insansın!Dialogue: 0,0:10:18.21,0:10:20.26,Main,,0,0,0,,Sonunda anlaşabildiler gibi görünüyor.Dialogue: 0,0:10:20.47,0:10:21.61,Main,,0,0,0,,Peki, ne yapacaksın?Dialogue: 0,0:10:21.73,0:10:24.85,Main,,0,0,0,,Bu insanları ve eşyalarını ççekerek yüzecek misin?Dialogue: 0,0:10:25.11,0:10:26.69,Main,,0,0,0,,Bunu yapabilmemin imkanı yok.Dialogue: 0,0:10:29.27,0:10:31.05,Main,,0,0,0,,Biraz geri çekilin.Dialogue: 0,0:10:54.65,0:10:55.89,Main,,0,0,0,,B-Bu da ne?!Dialogue: 0,0:10:56.03,0:10:59.85,Main,,0,0,0,,Deniz canavarı! O muhtemelen denizin bu bölgesinin muhafızı!Dialogue: 0,0:11:06.53,0:11:08.71,Main,,0,0,0,,Ne?! Hey, sen! Kaç!Dialogue: 0,0:11:08.97,0:11:09.85,Main,,0,0,0,,Dikkat et!Dialogue: 0,0:11:10.01,0:11:11.57,Main,,0,0,0,,Gomu Gomu no... Dialogue: 0,0:11:13.67,0:11:15.83,Main,,0,0,0,,Ice Age! Dialogue: 0,0:11:13.67,0:11:15.83,Attack,,0,0,0,,Buz DevriDialogue: 0,0:11:29.87,0:11:31.13,Main,,0,0,0,,Şeytan Meyvesi...!Dialogue: 0,0:11:39.81,0:11:42.75,Main,,0,0,0,,D-Deniz... dondu!Dialogue: 0,0:11:45.27,0:11:48.61,Main,,0,0,0,,Bu bir Denizci Karargahı Amirali'nin gücü.Dialogue: 0,0:12:07.79,0:12:10.02,Main,,0,0,0,,Bu muhtemelen bir hafta dayanır.Dialogue: 0,0:12:14.57,0:12:17.78,Main,,0,0,0,,Bu yönde acele etmeden ilerleyebilirsiniz.Dialogue: 0,0:12:18.23,0:12:20.93,Main,,0,0,0,,Dört günde ıssız bir adaya varacaksınız.Dialogue: 0,0:12:24.71,0:12:28.73,Main,,0,0,0,,Biraz soğuk, o yüzden yürürken sıcak bir şeyler giyin.Dialogue: 0,0:12:29.57,0:12:32.53,Main,,0,0,0,,Rüya mı... bu?Dialogue: 0,0:12:34.39,0:12:37.41,Main,,0,0,0,,Deniz karaya dönüştü!Dialogue: 0,0:12:37.67,0:12:41.79,Main,,0,0,0,,Artık denizi geçebiliriz! Bu adadan ayrılabiliriz!Dialogue: 0,0:12:41.91,0:12:44.89,Main,,0,0,0,,Denizci-san! Teşekkürler!Dialogue: 0,0:12:45.85,0:12:49.52,Main,,0,0,0,,Bu bir mucize! Bu kesinlikle bir mucize!Dialogue: 0,0:13:01.97,0:13:04.23,Main,,0,0,0,,O zaman, biz gidelim artık.Dialogue: 0,0:13:04.35,0:13:06.49,Main,,0,0,0,,Evet. Şükürler olsun millet.Dialogue: 0,0:13:06.83,0:13:07.81,Main,,0,0,0,,Dikkatli olun.Dialogue: 0,0:13:08.54,0:13:10.53,Main,,0,0,0,,Korsanlar bile farklı farklı oluyor, değil mi?Dialogue: 0,0:13:10.77,0:13:13.47,Main,,0,0,0,,Size nasıl teşekkür etsem bilemiyorum.Dialogue: 0,0:13:13.93,0:13:18.51,Main,,0,0,0,,Yaralarımızı tedavi etmenizin üstüne, bir de yiyecek ve suyunuzu bizimle paylaştınız.Dialogue: 0,0:13:18.63,0:13:20.27,Main,,0,0,0,,Sıkıntı etmeyin.Dialogue: 0,0:13:21.15,0:13:23.97,Main,,0,0,0,,İyi tesadüfler önceki hayattan kalma bir karma yüzündendir sonuçta.Dialogue: 0,0:13:24.43,0:13:27.43,Main,,0,0,0,,Çocuklara iyi bakın ki üşütmesinler.Dialogue: 0,0:13:27.81,0:13:31.15,Main,,0,0,0,,Bu durumda, yiyecekler bir süre taze kalacaktır.Dialogue: 0,0:13:31.55,0:13:35.33,Secondary,,0,0,0,,Güle güle! Teşekkürler!Dialogue: 0,0:13:31.87,0:13:33.52,Main,,0,0,0,,Çok teşekkür ederim.Dialogue: 0,0:13:33.57,0:13:37.65,Main,,0,0,0,,Nazikliğinizi asla unutmayacağız, Hasır Şapka Korsanları!Dialogue: 0,0:13:38.01,0:13:41.51,Main,,0,0,0,,Görüşürüz! Kendinize iyi bakın!Dialogue: 0,0:13:42.11,0:13:44.62,Main,,0,0,0,,Yolculuğunuzda dikkatli olun!Dialogue: 0,0:13:46.23,0:13:47.81,Main,,0,0,0,,Güzel, güzel.Dialogue: 0,0:13:47.99,0:13:50.25,Main,,0,0,0,,Soğuk. Soğuk.Dialogue: 0,0:13:50.35,0:13:51.83,Main,,0,0,0,,Bu tamamen kış gibi.Dialogue: 0,0:13:52.23,0:13:54.04,Main,,0,0,0,,Buz pateni yapabiliyorum!Dialogue: 0,0:13:54.17,0:13:56.01,Main,,0,0,0,,Bu harika, Chopper!Dialogue: 0,0:13:57.19,0:13:58.43,Main,,0,0,0,,Soğuk! Soğuk!Dialogue: 0,0:13:58.55,0:13:59.41,Main,,0,0,0,,Donacağım!Dialogue: 0,0:14:00.45,0:14:00.87,Main,,0,0,0,,Dialogue: 0,0:14:03.37,0:14:04.79,Main,,0,0,0,,Dialogue: 0,0:14:06.29,0:14:07.01,Main,,0,0,0,,Ne var?Dialogue: 0,0:14:07.79,0:14:12.07,Main,,0,0,0,,Nasıl desem bilmiyorum...  Dedene tıpatıp benziyorsun, Monkey D. Luffy...Dialogue: 0,0:14:12.59,0:14:13.67,Main,,0,0,0,,Dialogue: 0,0:14:14.09,0:14:18.14,Main,,0,0,0,,Özgür ruhlusun, yoksa tahmin edilmesi zor mu demeliyim?Dialogue: 0,0:14:19.73,0:14:21.52,Main,,0,0,0,,D-Dedem...Dialogue: 0,0:14:21.99,0:14:24.27,Main,,0,0,0,,Dede mi?! Luffy'nin mi?!Dialogue: 0,0:14:28.09,0:14:30.41,Main,,0,0,0,,Hey, ne oldu, Luffy? Ter içinde kalmışsın.Dialogue: 0,0:14:30.47,0:14:33.28,Main,,0,0,0,,Şey... H-H-Hiçbir şey. Hayır... şey...Dialogue: 0,0:14:33.63,0:14:38.49,Main,,0,0,0,,Deden bana eskiden çok yardımcı oldu.Dialogue: 0,0:14:38.95,0:14:43.85,Main,,0,0,0,,Buraya gelme sebebim Nico Robin'e ve sana bir bakmaktı.Dialogue: 0,0:14:44.37,0:14:48.91,Main,,0,0,0,,Şimdi düşününce... belki de burada ölmelisiniz.Dialogue: 0,0:14:50.19,0:14:53.59,Main,,0,0,0,,Hükümet hala sizi hafife alıyor amaDialogue: 0,0:14:54.01,0:14:57.61,Main,,0,0,0,,geçmişinizi biraz eşelediğimde, güçlü bir ekipsiniz.Dialogue: 0,0:14:58.31,0:15:02.63,Main,,0,0,0,,Ekibiniz küçük olsa bile, bu şekilde becerikli üyeler almaya devam ederseniz,Dialogue: 0,0:15:02.87,0:15:05.21,Main,,0,0,0,,daha sonra muhtemelen bir sorun olursunuz.Dialogue: 0,0:15:05.81,0:15:08.11,Main,,0,0,0,,Başlangıçta aranmanıza yol açan koşullar...Dialogue: 0,0:15:08.57,0:15:11.87,Main,,0,0,0,,Şimdiye kadar yaptığınız eylemlerin her biri...Dialogue: 0,0:15:12.15,0:15:14.01,Main,,0,0,0,,Gelişmenizin hızı...Dialogue: 0,0:15:14.75,0:15:18.07,Main,,0,0,0,,Uzun zamandır kanun kaçakları ile uğraşıyorum ama...Dialogue: 0,0:15:18.57,0:15:20.32,Main,,0,0,0,,geleceğiniz beni endişelendiriyor.Dialogue: 0,0:15:20.51,0:15:22.71,Main,,0,0,0,,B-Bu çok ani oldu!Dialogue: 0,0:15:22.89,0:15:25.33,Main,,0,0,0,,Daha önce sadece bir bakmak için geldiğini söylemiştin!Dialogue: 0,0:15:25.45,0:15:28.49,Main,,0,0,0,,Sizi tehlikeli saymamın sebebi...Dialogue: 0,0:15:28.77,0:15:31.19,Main,,0,0,0,,Sensin, Nico Robin.Dialogue: 0,0:15:31.93,0:15:35.79,Main,,0,0,0,,Başından beri Robin'in peşindeydin demek ki! Seni pataklayacağım!Dialogue: 0,0:15:36.03,0:15:41.43,Main,,0,0,0,,Onun başındaki ödülün anlamı, sadece gücünün bir göstergesi değil.Dialogue: 0,0:15:41.79,0:15:45.63,Main,,0,0,0,,Aynı zamanda hükümete karşı oluşturduğu tehdit seviyesinin bir göstergesi.Dialogue: 0,0:15:46.41,0:15:52.43,Main,,0,0,0,,İşte bu yüzden sadece sekiz yaşında, başına 79 milyon Beli değerinde bir ödül konuldu.Dialogue: 0,0:15:53.73,0:15:56.35,Main,,0,0,0,,Çocuk halinle hayatta kalmış olman çok etkileyici.Dialogue: 0,0:15:56.75,0:16:00.87,Main,,0,0,0,,İnsanlara ihanet ettin ve kaçtın. İyiliklerinden yararlanıp onları kullandın.Dialogue: 0,0:16:01.45,0:16:05.65,Main,,0,0,0,,Yeraltı dünyasında hızlı taraf değiştirebilmesiyle hayatta kalan senin,Dialogue: 0,0:16:05.90,0:16:09.32,Main,,0,0,0,,şimdi de gizlenme yeri bu tayfa mı?Dialogue: 0,0:16:10.53,0:16:14.49,Main,,0,0,0,,Hey, pislik! Ne kadar da aşağılayıcı bir konuşma şeklin var!Dialogue: 0,0:16:14.73,0:16:17.03,Main,,0,0,0,,Robin-chan'a karşı ne tür bir garezin var?!Dialogue: 0,0:16:17.54,0:16:18.49,Main,,0,0,0,,Kes şunu, Sanji!Dialogue: 0,0:16:18.57,0:16:20.79,Main,,0,0,0,,Ona karşı bir garezim yok.Dialogue: 0,0:16:21.17,0:16:23.45,Main,,0,0,0,,Eğer bir bağlantımız varsa bile...Dialogue: 0,0:16:23.87,0:16:27.05,Main,,0,0,0,,Sadece onun bir kere kaçmasına izin verdim o kadar.Dialogue: 0,0:16:27.39,0:16:28.84,Main,,0,0,0,,Bu uzun zaman önceydi.Dialogue: 0,0:16:29.93,0:16:32.03,Main,,0,0,0,,Siz de yakında anlayacaksınız.Dialogue: 0,0:16:32.21,0:16:36.87,Main,,0,0,0,,Çok da uzak olmayan bir gelecekte, bu kadar belalı bir kadını yanınıza aldığınıza pişman olacaksınız.Dialogue: 0,0:16:37.53,0:16:43.19,Main,,0,0,0,,Kanıt olarak, bugüne kadar Nico Robin'in katıldığı örgütlerinDialogue: 0,0:16:43.37,0:16:47.65,Main,,0,0,0,,hepsi yok edildi... Geriye sadece o kaldı.Dialogue: 0,0:16:48.57,0:16:51.19,Main,,0,0,0,,Acaba neden... Nico Robin?Dialogue: 0,0:16:52.49,0:16:54.93,Main,,0,0,0,,Kes şunu! Onun geçmişi bizi ilgilendirmez!Dialogue: 0,0:16:56.63,0:17:00.46,Main,,0,0,0,,Anladım... Tayfayı bir arada tutmakta iyi bir iş çıkarıyorsun.Dialogue: 0,0:17:01.19,0:17:04.95,Main,,0,0,0,,Ne demeye çalışıyorsun?! Eğer beni yakalamak istiyorsan, yap gitsin!Dialogue: 0,0:17:05.49,0:17:07.38,Main,,0,0,0,,Treinta Fleurs! Dialogue: 0,0:17:05.49,0:17:07.38,Attack,,0,0,0,,Otuz ÇiçekDialogue: 0,0:17:07.57,0:17:09.57,Main,,0,0,0,,Robin! Dur!Dialogue: 0,0:17:09.73,0:17:13.01,Main,,0,0,0,,Sanırım biraz fazla konuştum.Dialogue: 0,0:17:13.25,0:17:13.97,Main,,0,0,0,,Yazık oldu!Dialogue: 0,0:17:14.15,0:17:17.05,Main,,0,0,0,,Bundan biraz daha akıllı bir kadın olduğunu düşünmüştüm.Dialogue: 0,0:17:17.17,0:17:18.03,Main,,0,0,0,,Clutch! Dialogue: 0,0:17:17.17,0:17:18.03,Attack,,0,0,0,,KavramaDialogue: 0,0:17:18.67,0:17:21.43,Main,,0,0,0,,Parçalara ayrılıp öldü!Dialogue: 0,0:17:29.19,0:17:30.97,Main,,0,0,0,,H-Hayır... Bu imkansız...Dialogue: 0,0:17:34.07,0:17:37.01,Main,,0,0,0,,H-Hey! Millet! Kaçın! Kaçalım!Dialogue: 0,0:17:44.31,0:17:46.75,Main,,0,0,0,,Ne kadar da kötü bir şey yaptın.Dialogue: 0,0:18:02.79,0:18:04.19,Main,,0,0,0,,Ice Saber! Dialogue: 0,0:18:02.79,0:18:04.19,Attack,,0,0,0,,Buz KılıcıDialogue: 0,0:18:04.75,0:18:07.69,Main,,0,0,0,,Seni öldürme gibi bir niyetim yoktu ama...Dialogue: 0,0:18:20.83,0:18:22.71,Main,,0,0,0,,Slice Shoot! Dialogue: 0,0:18:20.83,0:18:22.71,Attack,,0,0,0,,Dilimleme VuruşuDialogue: 0,0:18:24.43,0:18:26.49,Main,,0,0,0,,Gomu Gomu no... Dialogue: 0,0:18:29.65,0:18:31.83,Main,,0,0,0,,Pistol! Dialogue: 0,0:18:29.65,0:18:31.83,Attack,,0,0,0,,TabancaDialogue: 0,0:18:34.57,0:18:35.63,Main,,0,0,0,,Soğuk!Dialogue: 0,0:18:43.73,0:18:45.18,Main,,0,0,0,,Onu dondurdu!Dialogue: 0,0:18:45.33,0:18:47.35,Main,,0,0,0,,O üçü... aynı anda...Dialogue: 0,0:19:02.59,0:19:05.75,Main,,0,0,0,,O-Olamaz! Hemen tedavi edilmeleri gerek!Dialogue: 0,0:19:05.95,0:19:08.89,Main,,0,0,0,,Eğer soğuk ısırması olurlarsa, uzuvları kangren olur!Dialogue: 0,0:19:09.58,0:19:11.95,Main,,0,0,0,,Ne yapıyorsun, Usopp?! O üçüne yardım etmemiz gerek!Dialogue: 0,0:19:12.07,0:19:17.33,Main,,0,0,0,,C-Cidden yardım etmek isterim ama vücudum hareket etmiyor. Bende mi dondum acaba?Dialogue: 0,0:19:17.57,0:19:20.19,Main,,0,0,0,,Hayır! Sadece hareket etmek için fazla korkmuşsun!Dialogue: 0,0:19:20.73,0:19:21.99,Main,,0,0,0,,Luffy!Dialogue: 0,0:19:21.71,0:19:23.65,Main,,0,0,0,,Sanji! Zoro!Dialogue: 0,0:19:23.77,0:19:25.67,Main,,0,0,0,,Robin! Kaç!Dialogue: 0,0:19:27.47,0:19:29.51,Main,,0,0,0,,İyi arkadaşlar edinmişsin.Dialogue: 0,0:19:29.63,0:19:32.45,Main,,0,0,0,,Ama sen hala sensin, Nico Robin!Dialogue: 0,0:19:32.81,0:19:35.12,Main,,0,0,0,,Hayır...! Ben artık...Dialogue: 0,0:19:38.77,0:19:41.29,Main,,0,0,0,,Robin! Dikkat et! Kaç!Dialogue: 0,0:19:44.55,0:19:46.43,Main,,0,0,0,,Ben...Dialogue: 0,0:19:46.89,0:19:47.93,Main,,0,0,0,,Robin-chan!Dialogue: 0,0:19:53.69,0:19:55.31,Main,,0,0,0,,Robin!Dialogue: 0,0:20:24.53,0:20:26.15,Main,,0,0,0,,Pislik!Dialogue: 0,0:20:27.50,0:20:31.75,Main,,0,0,0,,Bağırma... Eğer dikkatli bir şekilde buzunu çözerseniz hala yaşayabilir.Dialogue: 0,0:20:32.67,0:20:36.29,Main,,0,0,0,,Ama vücudu kırılganlaştı, o yüzden dikkatli olun.Dialogue: 0,0:20:36.41,0:20:37.81,Main,,0,0,0,,Eğer kırılırsa ölür.Dialogue: 0,0:20:39.34,0:20:39.59,Main,,0,0,0,,Örneğin...Dialogue: 0,0:20:39.71,0:20:42.53,Main,,0,0,0,,Bu şekilde vurursanız...Dialogue: 0,0:20:44.71,0:20:46.12,Main,,0,0,0,,Robin!Dialogue: 0,0:20:46.27,0:20:47.83,Main,,0,0,0,,Hayır!Dialogue: 0,0:20:49.85,0:20:52.46,Main,,0,0,0,,Dur!Dialogue: 0,0:21:00.67,0:21:01.26,Main,,0,0,0,,Dialogue: 0,0:21:05.01,0:21:06.37,Main,,0,0,0,,Yakındı...Dialogue: 0,0:21:14.57,0:21:15.39,Main,,0,0,0,,Yaşasın!Dialogue: 0,0:21:15.51,0:21:16.86,Main,,0,0,0,,Harikasın, Usopp!Dialogue: 0,0:21:16.93,0:21:19.11,Main,,0,0,0,,Bu da ne oluyor?Dialogue: 0,0:21:19.21,0:21:20.65,Main,,0,0,0,,Usopp! Chopper!Dialogue: 0,0:21:20.97,0:21:24.49,Main,,0,0,0,,Hemen gemiye koşun! Robin'i tedavi edin ve kurtarın!Dialogue: 0,0:21:24.67,0:21:26.19,Main,,0,0,0,,A-Anlaşıldı!Dialogue: 0,0:21:26.61,0:21:28.75,Main,,0,0,0,,Acele et! Ama nazikçe, tamam mı?Dialogue: 0,0:21:28.87,0:21:29.53,Main,,0,0,0,,Soğuk!Dialogue: 0,0:21:29.59,0:21:32.04,Main,,0,0,0,,Aptal! Robin için ne kadar soğuk olduğunu düşün!Dialogue: 0,0:21:33.15,0:21:34.33,Main,,0,0,0,,Hiç uğraşmayın...Dialogue: 0,0:21:35.75,0:21:38.76,Main,,0,0,0,,O kadını kurtarmamak dünya için daha iyi olur.Dialogue: 0,0:21:42.41,0:21:47.09,Main,,0,0,0,,Boşboğazlık etmek istemem ama korsan dediğin bu tip insanlardan olur.Dialogue: 0,0:21:48.11,0:21:51.31,Main,,0,0,0,,Çok iyi dedin, bayan.Dialogue: 0,0:21:52.07,0:21:53.79,Main,,0,0,0,,Yolumdan çekilir misin?Dialogue: 0,0:21:54.23,0:21:55.23,Main,,0,0,0,,Nami-san!Dialogue: 0,0:21:55.63,0:21:56.43,Main,,0,0,0,,Öylece...Dialogue: 0,0:21:56.47,0:21:57.57,Main,,0,0,0,,İzin veremeyiz...Dialogue: 0,0:21:57.71,0:21:59.23,Main,,0,0,0,,Bekleyin, siz ikiniz!Dialogue: 0,0:22:05.17,0:22:08.70,Main,,0,0,0,,Siz karışmayın. Onunla birebir dövüşmek istiyorum.Dialogue: 0,0:22:13.87,0:22:17.46,Main,,0,0,0,,Bu dövüşü, sadece ikimiz halledelim!Dialogue: 0,0:22:18.13,0:22:20.05,Main,,0,0,0,,Bana farketmez ama...Dialogue: 0,0:22:20.19,0:22:24.51,Main,,0,0,0,,...seni götürmek için bir gemim olmadığından, seni öldüreceğim.Dialogue: 0,0:22:28.73,0:22:31.13,Main,,0,0,0,,Nefes... alamıyor, değil mi?Dialogue: 0,0:22:31.33,0:22:33.51,Main,,0,0,0,,Şu anda muhtemelen geçici ölüm halinde.Dialogue: 0,0:22:33.63,0:22:36.05,Main,,0,0,0,,O-O zaman acele etmezsek ölmez mi?Dialogue: 0,0:22:36.19,0:22:38.79,Main,,0,0,0,,Ama eğer onu hızlı ısıtırsak, vücudu kırılır.Dialogue: 0,0:22:38.98,0:22:40.87,Main,,0,0,0,,Vücut ısısının içerden yenilenmesi lazım.Dialogue: 0,0:22:42.71,0:22:44.89,Main,,0,0,0,,İ-İşe yarayacak mı bu gerçekten?Dialogue: 0,0:22:45.87,0:22:48.12,Main,,0,0,0,,Bilmiyorum... ama bundan başka bir yol...Dialogue: 0,0:22:48.41,0:22:51.81,Main,,0,0,0,,Öylece bilmiyorum diyemezsin! Robin'in hayatı sana bağlı!Dialogue: 0,0:22:52.51,0:22:56.88,Main,,0,0,0,,Ama ben hayatımda tüm vücudu bu şekilde donmuş bir insan görmedim!Dialogue: 0,0:22:57.41,0:23:00.37,Main,,0,0,0,,Tabii ki, Aokiji hala hayatta olduğunu söyledi amaDialogue: 0,0:23:00.49,0:23:02.33,Main,,0,0,0,,bana göre, hala hayatta olması çok şaşırtıcı bir şey!Dialogue: 0,0:23:02.47,0:23:07.75,Main,,0,0,0,,Sızlanmayı bırak! Eğer sen bir şey yapamazsan, o zaman onu kurtarabilecek başka biri yok!Dialogue: 0,0:23:08.17,0:23:10.31,Main,,0,0,0,,Sen bu geminin doktorusun!Dialogue: 0,0:23:10.43,0:23:13.17,Main,,0,0,0,,Biliyorum! Lütfen biraz sessiz ol!Dialogue: 0,0:23:31.19,0:23:32.08,Main,,0,0,0,,Chopper!Dialogue: 0,0:23:36.89,0:23:39.95,Main,,0,0,0,,Ah... Ne?! Neden?! Neden sadece üçünüz...?!Dialogue: 0,0:23:40.37,0:23:41.67,Main,,0,0,0,,Sonra açıklarız!Dialogue: 0,0:23:41.85,0:23:43.41,Main,,0,0,0,,Hemen geri döneceğiz!Dialogue: 0,0:23:43.61,0:23:45.80,Main,,0,0,0,,Donmuş bacak ve kolumuz konusunda bir şey yap!Dialogue: 0,0:23:46.27,0:23:48.45,Main,,0,0,0,,Ah, tamam. Şey...Dialogue: 0,0:23:48.64,0:23:51.23,Main,,0,0,0,,O donmuş bölgeleri derhal su ile eritmemiz gerek.Dialogue: 0,0:23:51.85,0:23:53.85,Main,,0,0,0,,Ama banyoyu şu anda Robin için kullanıyoruz.Dialogue: 0,0:23:54.01,0:23:55.64,Main,,0,0,0,,Robin iyi mi?!Dialogue: 0,0:23:56.77,0:23:58.15,Main,,0,0,0,,Daha bilemiyorum.Dialogue: 0,0:23:58.81,0:23:59.65,Main,,0,0,0,,Ne?Dialogue: 0,0:24:02.09,0:24:03.32,Main,,0,0,0,,Bu olur mu?Dialogue: 0,0:24:07.63,0:24:11.75,Main,,0,0,0,,Düşük sıcaklıkta buzu erittikten sonra, etkilenen bölgeleri ovarak gemiye gelin!Dialogue: 0,0:24:12.73,0:24:15.04,Main,,0,0,0,,Nami! Robin'i tedavi etmemize yardım et!Dialogue: 0,0:24:15.07,0:24:15.61,Main,,0,0,0,,Tamam!Dialogue: 0,0:24:21.87,0:24:25.09,Main,,0,0,0,,Siz neden buradasınız? Luffy nerede?! Aokiji'ye ne oldu?!Dialogue: 0,0:24:26.27,0:24:27.95,Main,,0,0,0,,Luffy birebir dövüşmek istediğini söyledi.Dialogue: 0,0:24:28.37,0:24:32.41,Main,,0,0,0,,Birebir mi?! Ve sizde Luffy'i orada bırakıp öylece geldiniz mi?!Dialogue: 0,0:24:34.26,0:24:35.69,Main,,0,0,0,,Kaptanın emirleri.Dialogue: 0,0:24:36.13,0:24:39.17,Main,,0,0,0,,Hey! Kaptanın emirleri olsa bile, bunu yapamazsınız!Dialogue: 0,0:24:39.49,0:24:41.83,Main,,0,0,0,,Biraz fazla duygusuz davranmıyor musunuz?! Luffy...Dialogue: 0,0:24:41.85,0:24:42.89,Main,,0,0,0,,Kapa çeneni!Dialogue: 0,0:24:43.39,0:24:45.94,Main,,0,0,0,,Birebir bu! Anlamıyor musun?!Dialogue: 0,0:24:46.25,0:24:48.20,Main,,0,0,0,,Kesin şunu! Böyle bir zamanda...!Dialogue: 0,0:24:50.51,0:24:53.43,Main,,0,0,0,,Şu anda... bir kriz anındayız.Dialogue: 0,0:24:54.99,0:24:58.37,Main,,0,0,0,,Verdiği bu karar onun sadece geçici bir hevesi olsa da olmasa da,Dialogue: 0,0:24:58.83,0:25:02.99,Main,,0,0,0,,bir şey olacaksa, bu olacak şeye karşılık vermeye hazır olun!Dialogue: 0,0:25:11.13,0:25:14.05,Main,,0,0,0,,Tam da düşündüğüm gibi, değişik birisin.Dialogue: 0,0:25:37.91,0:25:40.05,Main,,0,0,0,,Gomu Gomu no... Dialogue: 0,0:25:40.62,0:25:44.08,Main,,0,0,0,,Storm! Dialogue: 0,0:25:40.62,0:25:44.08,Attack,,0,0,0,,FırtınaDialogue: 0,0:25:54.15,0:25:56.47,Main,,0,0,0,,Ice Time... Dialogue: 0,0:25:54.15,0:25:56.47,Attack,,0,0,0,,Buz Zamanı...Dialogue: 0,0:26:15.02,0:26:18.65,Flashbacks,,0,0,0,,Bu dövüşü, sadece ikimiz halledelim!Dialogue: 0,0:26:19.48,0:26:22.49,Main,,0,0,0,,Kahretsin... Beni kandırdı.Dialogue: 0,0:26:23.86,0:26:29.01,Main,,0,0,0,,Birebiri kabul ettiğimden dolayı, ben kazandığımda bu dövüş bitiyor.Dialogue: 0,0:26:29.20,0:26:30.45,Main,,0,0,0,,Şimdi anlıyorum...Dialogue: 0,0:26:31.04,0:26:35.47,Main,,0,0,0,,Şimdi diğerlerine bulaşırsam, buradaki duyarsız kişi ben olurum...Dialogue: 0,0:26:35.67,0:26:37.13,Main,,0,0,0,,Değil mi, Kaptan?Dialogue: 0,0:26:39.25,0:26:40.34,Main,,0,0,0,,Ya da...Dialogue: 0,0:26:41.21,0:26:43.79,Main,,0,0,0,,Cidden beni yenmeye niyetli miydin?Dialogue: 0,0:26:49.41,0:26:51.15,Main,,0,0,0,,Bir kere söyleyeceğim.Dialogue: 0,0:26:51.48,0:26:53.79,Main,,0,0,0,,Siz bundan sonra, Nico Robin'i...Dialogue: 0,0:26:55.09,0:26:57.77,Main,,0,0,0,,O kadını kesinlikle zapt edemeyeceksiniz.Dialogue: 0,0:27:01.97,0:27:06.16,Main,,0,0,0,,Nico Robin denilen kadının doğduğu o acımasız kaderin yükünü,Dialogue: 0,0:27:06.93,0:27:09.29,Main,,0,0,0,,artık taşıyamayacak hale geleceksiniz.Dialogue: 0,0:27:16.29,0:27:19.73,Main,,0,0,0,,O kadını gemine alman...Dialogue: 0,0:27:20.37,0:27:22.61,Main,,0,0,0,,...işte bu anlama geliyor...Dialogue: 0,0:27:23.85,0:27:26.51,Main,,0,0,0,,...Monkey D. Luffy!Dialogue: 0,0:27:32.22,0:27:37.71,Main,,0,0,0,,Seni burada, öylece kırarak öldürmek çok kolay olurdu amaDialogue: 0,0:27:37.99,0:27:39.15,Main,,0,0,0,,sana borçluyum.Dialogue: 0,0:27:43.99,0:27:48.20,Main,,0,0,0,,Bu Crocodile'ı yendiğin için sana olan borcumuzu ödemiş olur.Dialogue: 0,0:27:49.74,0:27:50.85,Main,,0,0,0,,Ayrıca...Dialogue: 0,0:27:51.58,0:27:56.11,Main,,0,0,0,,Ah... Her neyse. Smoker aptalı hakkında konuşmama gerek yok.Dialogue: 0,0:27:56.43,0:27:57.31,Main,,0,0,0,,Görüşürüz!Dialogue: 0,0:28:04.37,0:28:05.01,Main,,0,0,0,,İşte orada!Dialogue: 0,0:28:05.15,0:28:05.93,Main,,0,0,0,,Luffy!Dialogue: 0,0:28:07.35,0:28:08.81,Main,,0,0,0,,Parçalara ayrılmamış!Dialogue: 0,0:28:09.47,0:28:10.68,Main,,0,0,0,,Çok şükür...Dialogue: 0,0:28:10.95,0:28:12.09,Main,,0,0,0,,Onu taşıyalım!Dialogue: 0,0:28:12.51,0:28:13.53,Main,,0,0,0,,Gemiye acele edelim!Dialogue: 0,0:28:13.73,0:28:14.75,Main,,0,0,0,,Aynı şeyleri söyleme!Dialogue: 0,0:28:24.86,0:28:29.47,Main,,0,0,0,,Bu adanın kaydına göre, bir sonraki istikametleri...Dialogue: 0,0:28:29.85,0:28:30.53,Main,,0,0,0,,Dialogue: 0,0:28:31.16,0:28:34.69,Main,,0,0,0,,Water Seven... Su şehri, ha?Dialogue: 0,0:28:35.33,0:28:41.35,Main,,0,0,0,,Böylece, Karargah'a cidden yaklaşıyorlar.Dialogue: 0,0:28:52.49,0:28:54.18,Main,,0,0,0,,Ah, kusura bakma.Dialogue: 0,0:29:05.11,0:29:06.65,Main,,0,0,0,,İkisinin de...Dialogue: 0,0:29:07.24,0:29:08.71,Main,,0,0,0,,Kalpleri...Dialogue: 0,0:29:09.85,0:29:11.15,Main,,0,0,0,,...atmaya başladı!Dialogue: 0,0:29:11.45,0:29:13.33,Main,,0,0,0,,Yaşasın!Dialogue: 0,0:29:14.25,0:29:15.33,Main,,0,0,0,,Luffy!Dialogue: 0,0:29:15.33,0:29:16.31,Main,,0,0,0,,Robin-chan!Dialogue: 0,0:29:16.01,0:29:17.50,Main,,0,0,0,,Hayır! Daha giremezsiniz!Dialogue: 0,0:29:17.50,0:29:19.13,Main,,0,0,0,,Gürültü yapacaksınız, değil mi?Dialogue: 0,0:29:19.67,0:29:22.55,Main,,0,0,0,,Hey, Doktor Chopper. Onlar için bir şey pişireceğim.Dialogue: 0,0:29:23.07,0:29:27.47,Main,,0,0,0,,B-Bana "doktor" desen de bu beni mutlu etmiyor, seni pislik!Dialogue: 0,0:29:27.89,0:29:31.71,Main,,0,0,0,,Ah, uyandıkları zaman, vücutlarını ısıtacak içecekler iyi olur.Dialogue: 0,0:29:31.83,0:29:33.55,Main,,0,0,0,,Ben onları sonra oturma odasına taşırım.Dialogue: 0,0:29:33.59,0:29:34.98,Main,,0,0,0,,Hayhay efendim!Dialogue: 0,0:29:35.33,0:29:37.21,Main,,0,0,0,,Nami, yelken açacak mıyız?Dialogue: 0,0:29:37.47,0:29:40.01,Main,,0,0,0,,Açamayız, kaptanımız böyleyken.Dialogue: 0,0:29:40.27,0:29:43.15,Main,,0,0,0,,Pusula halloldu ama yine de bugünlük burada kalalım.Dialogue: 0,0:29:44.53,0:29:45.07,Main,,0,0,0,,Dialogue: 0,0:29:48.11,0:29:50.57,Main,,0,0,0,,Ne oldu, Usopp? Bitkin mi düştün?Dialogue: 0,0:29:51.25,0:29:55.75,Main,,0,0,0,,Bundan sonra onun gibi güçlü adamlar peşimize düşer mi acaba...Dialogue: 0,0:29:58.27,0:30:02.11,Main,,0,0,0,,Tek yaptığım paniklemekti.Dialogue: 0,0:30:03.13,0:30:05.93,Main,,0,0,0,,Biraz uyu, aptal. Yorulmuşsun.Dialogue: 0,0:03:13.57,0:03:19.11,OP11 Credits,,50,0,230,,Translation  FUNimationDialogue: 0,0:03:19.84,0:03:24.33,OP11 Credits,,450,0,280,,Soundtracking HaleeDialogue: 0,0:03:19.84,0:03:24.33,OP11 Credits,,0,460,350,,Infoboxes/Title Card  BernieCraneDialogue: 0,0:03:24.42,0:03:28.32,OP11 Credits,,0,100,420,,Editing FeesoDialogue: 0,0:03:29.82,0:03:34.39,OP11 Credits,,470,0,300,,Quality Checking Galaxy 9000 Mr. LuffyDialogue: 0,0:03:49.78,0:03:53.75,OP11 Credits,,0,30,410,,Timing DatenshiDialogue: 0,0:02:51.32,0:02:55.41,Lyrics,,0,0,0,,♪ Sıkıntı yok! Hadi ilerleyelim...Dialogue: 0,0:02:55.66,0:02:58.88,Lyrics,,0,0,0,,...sürekli kalplerimizin içindeki güneşle. ♪Dialogue: 0,0:02:59.05,0:03:02.32,Lyrics,,0,0,0,,♪ Güç kenetli ellerimizden geçerken... ♪Dialogue: 0,0:03:02.47,0:03:05.97,Lyrics,,0,0,0,,♪ Dileklerimizi avuçlayalım. ♪Dialogue: 0,0:03:13.61,0:03:19.80,Lyrics,,0,0,0,,♪ Devasa dalgaları aşalım, güçlerimizi birleştirerek. ♪Dialogue: 0,0:03:21.14,0:03:27.62,Lyrics,,0,0,1,,♪ Heyecana doğru acele edelim...  bu bir başlama işareti. ♪Dialogue: 0,0:03:28.30,0:03:34.43,Lyrics,,0,0,0,,♪ İşte şimdi yelken açma zamanı... çapayı kaldıralım. ♪Dialogue: 0,0:03:35.28,0:03:42.29,Lyrics,,0,0,1,,♪ Gökkuşağı renkli rüzgarı kes ve maceralar denizine yönel. ♪Dialogue: 0,0:03:42.42,0:03:45.86,Lyrics,,0,0,0,,♪ Yaralarla dolu bir yolculuk olacak...Dialogue: 0,0:03:45.94,0:03:49.59,Lyrics,,0,0,0,,...ama en önemlisi de tam orada olacak. ♪Dialogue: 0,0:03:49.79,0:03:53.72,Lyrics,,0,0,0,,♪ Bir sıkışıklığa girsek bile önemi yok. ♪Dialogue: 0,0:03:53.79,0:03:55.67,Lyrics,,0,0,0,,♪ Çünkü seni koruyacağım. ♪Dialogue: 0,0:03:56.82,0:04:00.65,Lyrics,,0,0,0,,♪ Sıkıntı yok! Hadi ilerleyelim...Dialogue: 0,0:04:01.00,0:04:04.14,Lyrics,,0,0,0,,...sürekli kalplerimizin içindeki güneşle. ♪Dialogue: 0,0:04:04.52,0:04:07.64,Lyrics,,0,0,1,,♪ Eğer bir gün fırtına gelirse omuz omuza duralım...Dialogue: 0,0:04:07.75,0:04:11.52,Lyrics,,0,0,0,,...ve daha önceki ışığa bakalım ♪Dialogue: 0,0:04:12.01,0:04:15.26,Lyrics,,0,0,0,,♪ Hayallerimizin parçalarını toplarsak...Dialogue: 0,0:04:15.76,0:04:18.87,Lyrics,,0,0,0,,...geleceğe ulaşan bir harita olurlar. ♪Dialogue: 0,0:04:19.02,0:04:22.04,Lyrics,,0,0,0,,♪ O yüzden hep beraber aynı bayrak altında duralım...Dialogue: 0,0:04:22.51,0:04:27.77,Lyrics,,0,0,0,,...ve dileklerimizi avuçlayalım, hepimiz biriz. ♪