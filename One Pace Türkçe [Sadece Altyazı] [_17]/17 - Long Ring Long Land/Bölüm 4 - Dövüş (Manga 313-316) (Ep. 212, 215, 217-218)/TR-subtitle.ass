Dialogue: 0,0:01:50.47,0:01:56.00,Title,,0,0,420,,{\fad(250,250)}Dövüş
Dialogue: 0,0:01:56.13,0:02:00.41,Main,,0,0,0,,Girdi! Gol! Gol! Gol!
Dialogue: 0,0:02:00.85,0:02:05.71,Main,,0,0,0,,Helal olsun! Zoro! Sanji! Harikasınız!
Dialogue: 0,0:02:05.77,0:02:08.91,Main,,0,0,0,,Gerçekten başardınız!
Dialogue: 0,0:02:09.05,0:02:11.71,Main,,0,0,0,,B-Başardınız!
Dialogue: 0,0:02:11.83,0:02:15.41,Main,,0,0,0,,Ah! Ama ben Choppy'i geri vermek istemiyorum!
Dialogue: 0,0:02:15.51,0:02:18.79,Main,,0,0,0,,Zoro! Sanji! Aferin!
Dialogue: 0,0:02:19.13,0:02:21.61,Main,,0,0,0,,Vay canına! İnanılmazlar!
Dialogue: 0,0:02:21.71,0:02:23.79,Main,,0,0,0,,Bravo! Bravo!
Dialogue: 0,0:02:24.91,0:02:26.91,Main,,0,0,0,,O kadar duygulandım ki ağlayacağım!
Dialogue: 0,0:02:26.99,0:02:29.17,Main,,0,0,0,,Siz cidden en iyisisiniz!
Dialogue: 0,0:02:29.53,0:02:33.19,Main,,0,0,0,,Aptallar! Düşmanını kim yüceltir ki?!
Dialogue: 0,0:02:35.21,0:02:39.59,Main,,0,0,0,,İnanamıyorum! Kimse Sersem Canavarlar'ı yenemez...!
Dialogue: 0,0:02:42.65,0:02:44.69,Main,,0,0,0,,Merhaba Hakem. Günaydın.
Dialogue: 0,0:02:44.97,0:02:48.45,Main,,0,0,0,,Hemen düdüğü çal! Hadi, çabuk!
Dialogue: 0,0:02:48.75,0:02:50.31,Main,,0,0,0,,A-Ah evet.
Dialogue: 0,0:02:50.61,0:02:53.55,Main,,0,0,0,,Bana karşı olan tavrı tamamen sportmenlik dışıydı!
Dialogue: 0,0:02:54.91,0:02:56.19,Main,,0,0,0,,Onu oyundan attıracağım!
Dialogue: 0,0:02:59.95,0:03:03.05,Main,,0,0,0,,Ve işte son düdük çalındı!
Dialogue: 0,0:03:03.21,0:03:05.91,Main,,0,0,0,,Sersem Halka maçı sona erdi!
Dialogue: 0,0:03:06.09,0:03:07.81,Main,,0,0,0,,Elinize sağlık!
Dialogue: 0,0:03:15.35,0:03:17.53,Main,,0,0,0,,Davy Back Dövüşü'nün 2. Turu'nda,
Dialogue: 0,0:03:17.83,0:03:23.17,Main,,0,0,0,,yenilmez takım, Sersem Canavarlar'ı yenerek oyunu kendi lehine çeviren
Dialogue: 0,0:03:23.29,0:03:26.75,Main,,0,0,0,,Hasır Şapka Takımı kazanıyor!
Dialogue: 0,0:03:32.69,0:03:36.11,Main,,0,0,0,,Tabii ki! Zoro ve Sanji kaybetmez!
Dialogue: 0,0:03:36.49,0:03:39.35,Main,,0,0,0,,Nami-san! Robin-chan!
Dialogue: 0,0:03:39.47,0:03:42.25,Main,,0,0,0,,Gördünüz mü?! Etkilendiniz mi?!
Dialogue: 0,0:03:42.51,0:03:43.73,Main,,0,0,0,,Çok iyiydi!
Dialogue: 0,0:03:44.03,0:03:46.90,Main,,0,0,0,,Sizi aptallar! Beni öyle korkutmayın!
Dialogue: 0,0:03:47.33,0:03:48.77,Main,,0,0,0,,Acıyor, acıyor.
Dialogue: 0,0:03:49.09,0:03:51.41,Main,,0,0,0,,Benim dediklerimi dinleyerek iyi ettiniz!
Dialogue: 0,0:03:51.41,0:03:53.09,Main,,0,0,0,,Sen hiçbir şey yapmadın.
Dialogue: 0,0:03:54.85,0:03:59.65,Main,,0,0,0,,Şimdi 2. Tur Sersem Halka'nın kazananları Hasır Şapka Takımı,
Dialogue: 0,0:03:59.75,0:04:03.07,Main,,0,0,0,,Foxy Korsanları'ndan bir tayfa üyesi veya
Dialogue: 0,0:04:03.07,0:04:05.85,Main,,0,0,0,,sembollerini alma hakkına sahipler!
Dialogue: 0,0:04:06.07,0:04:10.39,Main,,0,0,0,,Hasır Şapkalar'ın kaptanı ne istiyor acaba?!
Dialogue: 0,0:04:15.77,0:04:17.77,Main,,0,0,0,,Belli değil mi?
Dialogue: 0,0:04:18.45,0:04:20.49,Thoughts,,0,0,0,,Ha?! Yoksa, ben miyim...?
Dialogue: 0,0:04:21.19,0:04:24.75,Thoughts,,0,0,0,,Başından beri beni istiyorlardı belki de...!
Dialogue: 0,0:04:24.87,0:04:28.65,Thoughts,,0,0,0,,Hey... Daha ayrılmaya hazır değilim...
Dialogue: 0,0:04:28.73,0:04:32.45,Thoughts,,0,0,0,,Göz göze geldik! Olamaz! Benim...
Dialogue: 0,0:04:33.65,0:04:36.35,Thoughts,,0,0,0,,Bahse varım beni alacaklar...
Dialogue: 0,0:04:36.71,0:04:37.96,Thoughts,,0,0,0,,Ben olabilirim!
Dialogue: 0,0:04:38.35,0:04:41.59,Thoughts,,0,0,0,,Eğer seçilirsem, gülümseyerek onlara veda edeceğim...
Dialogue: 0,0:04:42.55,0:04:45.11,Thoughts,,0,0,0,,Buna eminim, beni seviyorlar...
Dialogue: 0,0:04:45.87,0:04:47.31,Thoughts,,0,0,0,,Luffy... Çabuk...
Dialogue: 0,0:04:48.18,0:04:49.54,Main,,0,0,0,,Tamamdır! O zaman-
Dialogue: 0,0:04:49.42,0:04:50.34,Main,,0,0,0,,Bekle!
Dialogue: 0,0:04:52.52,0:04:53.48,Main,,0,0,0,,Ne oldu, Nami?
Dialogue: 0,0:04:53.70,0:04:56.96,Main,,0,0,0,,Patronları bir sonraki turda yer alacak, değil mi?
Dialogue: 0,0:04:57.44,0:05:02.06,Main,,0,0,0,,Chopper'ı geri alsak bile, bir sonraki turda kaybedersek
Dialogue: 0,0:05:02.16,0:05:04.18,Main,,0,0,0,,onu tekrar alabilirler!
Dialogue: 0,0:05:04.94,0:05:07.38,Main,,0,0,0,,O yüzden eğer şimdi patronlarını alırsak
Dialogue: 0,0:05:07.38,0:05:10.24,Main,,0,0,0,,Chopper'ı kesinlikle geri alma şansımız olmaz mı?
Dialogue: 0,0:05:11.64,0:05:17.78,Main,,0,0,0,,B-B-Bu da ne?! Patron Foxy'i mi isteyecek?!
Dialogue: 0,0:05:18.50,0:05:20.18,Main,,0,0,0,,Bu Fıstık Taktiği!
Dialogue: 0,0:05:20.58,0:05:22.60,Main,,0,0,0,,Çok aşağılıksınız!
Dialogue: 0,0:05:22.86,0:05:25.42,Main,,0,0,0,,Sizi Fıstıkçı pislikler!
Dialogue: 0,0:05:25.54,0:05:27.74,Main,,0,0,0,,Bizimle doğru dürüst kapışın!
Dialogue: 0,0:05:28.18,0:05:30.52,Main,,0,0,0,,Buna karşı bir kural yok ama
Dialogue: 0,0:05:30.72,0:05:34.42,Main,,0,0,0,,ikinci turdan hemen sonra rakibin liderini istemek
Dialogue: 0,0:05:34.52,0:05:39.08,Main,,0,0,0,,kurallara uygun bir maçtan kaçınmak için yapılmış bariz bir girişimdir!
Dialogue: 0,0:05:39.40,0:05:44.60,Main,,0,0,0,,İnanamıyorum! Bu merhametsiz bir kadının kötücül fikri!
Dialogue: 0,0:05:45.00,0:05:48.66,Main,,0,0,0,,Onun adı, vicdansız rotacı Nami!
Dialogue: 0,0:05:48.90,0:05:52.31,Main,,0,0,0,,Ne cüretle Nami-san'a hakaret edersiniz?! Doğrarım sizi!
Dialogue: 0,0:05:52.50,0:06:07.18,Secondary,,0,0,0,,Fıstıklar! Fıstıklar! Fıstıklar!
Dialogue: 0,0:05:53.54,0:05:55.34,Main,,0,0,0,,Onlardan nefret ediyorum...
Dialogue: 0,0:05:55.50,0:05:57.32,Main,,0,0,0,,Bu kurallara aykırı olmasa bile,
Dialogue: 0,0:05:57.50,0:06:00.20,Main,,0,0,0,,korsan ahlakına aykırı gibi duruyor.
Dialogue: 0,0:06:01.10,0:06:02.48,Main,,0,0,0,,Ben Nami'nin tarafındayım!
Dialogue: 0,0:06:02.76,0:06:06.28,Main,,0,0,0,,Tepkileri gayet normal. Nami, bu senin hatan.
Dialogue: 0,0:06:07.60,0:06:11.42,Main,,0,0,0,,Çenenizi kapatır mısınız artık?! Kendinizi bir şey sanmayın!
Dialogue: 0,0:06:11.60,0:06:12.76,Main,,0,0,0,,Özür dileriz!
Dialogue: 0,0:06:13.22,0:06:17.50,Main,,0,0,0,,Pekala, sevseniz de sevmeseniz de, \Nbu oyunun nasıl ilerleyeceğini
Dialogue: 0,0:06:17.64,0:06:21.98,Main,,0,0,0,,kazanan takımın kaptanı Monkey D. Luffy karar verecek!
Dialogue: 0,0:06:22.14,0:06:25.58,Main,,0,0,0,,Foxy Takımı'ndan istediği kişiyi seçmekte özgür!
Dialogue: 0,0:06:25.88,0:06:27.89,Thoughts,,0,0,0,,Kesin beni seçecek...
Dialogue: 0,0:06:28.22,0:06:31.20,Thoughts,,0,0,0,,Nereden bakarsan bak, buradaki tek seçenek benim..
Dialogue: 0,0:06:31.42,0:06:34.78,Thoughts,,0,0,0,,Beni mi seçecek? Çok havalılar!
Dialogue: 0,0:06:35.42,0:06:36.98,Main,,0,0,0,,Söylesene, Rotacı-san.
Dialogue: 0,0:06:37.36,0:06:40.74,Main,,0,0,0,,Teklifin bize gerçekten ezici bir avantaj kazandırabilir,
Dialogue: 0,0:06:40.90,0:06:43.45,Main,,0,0,0,,ama bu aynı zamanda patronlarını tayfadan yapar.
Dialogue: 0,0:06:44.86,0:06:45.90,Main,,0,0,0,,Hayır, istemiyorum.
Dialogue: 0,0:06:48.58,0:06:52.22,Main,,0,0,0,,Hasır Şapka Takımı'nın patronumuza hakaret etmesi bittiğine göre,
Dialogue: 0,0:06:52.36,0:06:54.04,Main,,0,0,0,,birini seçme zamanı!
Dialogue: 0,0:06:54.52,0:06:57.28,Main,,0,0,0,,Kimi seçecek acaba?!
Dialogue: 0,0:07:01.02,0:07:04.28,Main,,0,0,0,,Tamam o zaman. Geri alıyorum...
Dialogue: 0,0:07:05.76,0:07:07.82,Main,,0,0,0,,Chopper! Geri gel!
Dialogue: 0,0:07:09.84,0:07:11.60,Main,,0,0,0,,Olamaz! Choppy!
Dialogue: 0,0:07:12.54,0:07:15.90,Main,,0,0,0,,Teşekkür ederim! Çok mutluyum!
Dialogue: 0,0:07:16.34,0:07:19.54,Main,,0,0,0,,Ağlama! Kaybetmemizin imkanı yoktu zaten!
Dialogue: 0,0:07:22.94,0:07:26.96,Main,,0,0,0,,Patronumuz hislerinin ağırlığından dolayı yere çöktü!
Dialogue: 0,0:07:27.28,0:07:30.20,Main,,0,0,0,,Onların öylece patronumuzu istemediklerini söylediklerine inanamıyorum!
Dialogue: 0,0:07:30.36,0:07:34.22,Main,,0,0,0,,Hayır, Patron! Sen bize gereklisin!
Dialogue: 0,0:07:34.38,0:07:36.00,Main,,0,0,0,,Aynen öyle, Patron!
Dialogue: 0,0:07:36.60,0:07:37.92,Main,,0,0,0,,M-Millet...
Dialogue: 0,0:07:38.20,0:07:40.46,Main,,0,0,0,,Hadi şunlara derslerini verelim!
Dialogue: 0,0:07:40.68,0:07:42.74,Main,,0,0,0,,Evet! Sonraki tur için çok heyecanlıyım!
Dialogue: 0,0:07:42.92,0:07:44.72,Main,,0,0,0,,Seni seviyoruz, Patron!
Dialogue: 0,0:07:44.86,0:07:45.80,Main,,0,0,0,,Patron!
Dialogue: 0,0:07:46.92,0:07:47.98,Main,,0,0,0,,Millet...
Dialogue: 0,0:07:48.56,0:07:52.68,Main,,0,0,0,,Evet! Benim yoldaşlarım, bir tek sizsiniz!
Dialogue: 0,0:07:53.00,0:07:53.88,Main,,0,0,0,,Teşekkürler!
Dialogue: 0,0:07:54.24,0:07:55.78,Main,,0,0,0,,Şu saçmalığı keser misin?
Dialogue: 0,0:07:56.08,0:07:57.36,Main,,0,0,0,,Patron!
Dialogue: 0,0:07:58.32,0:08:01.46,Main,,0,0,0,,Hepinizin kendinizi hazırlasanız iyi edersiniz!
Dialogue: 0,0:08:01.56,0:08:04.50,Main,,0,0,0,,Ne?! Sana bir dövüşte asla kaybetmem!
Dialogue: 0,0:08:07.10,0:08:08.90,Main,,0,0,0,,Kendimi tekrar mı etmek zorundayım?
Dialogue: 0,0:08:09.50,0:08:12.88,Main,,0,0,0,,Dövüş ve oyun, farklı şeylerdir...
Dialogue: 0,0:08:17.98,0:08:20.12,Main,,0,0,0,,Sonunda son dövüş turu!
Dialogue: 0,0:08:20.24,0:08:22.34,Main,,0,0,0,,İlk olarak: alanın belirlenmesi!
Dialogue: 0,0:08:22.70,0:08:26.02,Main,,0,0,0,,İki yarışmacı topu döndürür!
Dialogue: 0,0:08:26.14,0:08:27.12,Main,,0,0,0,,Sonra da...
Dialogue: 0,0:08:27.94,0:08:30.16,Main,,0,0,0,,...nerede durursa orada--!
Dialogue: 0,0:08:31.34,0:08:34.28,Main,,0,0,0,,Bekle bir saniye! O duruş şekli nereden baksan anormaldi!
Dialogue: 0,0:08:36.60,0:08:38.92,Main,,0,0,0,,Savaş alanı belirlendi!
Dialogue: 0,0:08:39.08,0:08:43.30,Main,,0,0,0,,Tesadüfen, bizim Seksi Foxy'mizin güvertesinde!
Dialogue: 0,0:08:43.44,0:08:45.70,Main,,0,0,0,,Bunun neresi tesadüf?! Aptal mısın?!
Dialogue: 0,0:08:45.94,0:08:48.95,Main,,0,0,0,,Şimdi de dövüşün kurallarını açıklayacağım!
Dialogue: 0,0:08:49.48,0:08:54.52,Main,,0,0,0,,Topun düştüğü yerin 50 metre etrafındaki her yer savaş alanıdır!
Dialogue: 0,0:08:54.70,0:08:58.34,Main,,0,0,0,,Başka bir deyişle, 100 metrelik çemberin içindeki her yer savaş alanı!
Dialogue: 0,0:08:58.86,0:09:02.76,Main,,0,0,0,,Silahlarla beraber çemberin içindeki diğer her şey de serbest!
Dialogue: 0,0:09:03.00,0:09:06.36,Main,,0,0,0,,Sadece bu iki yarışmacı çemberin içine girebilir!
Dialogue: 0,0:09:06.60,0:09:09.32,Main,,0,0,0,,Rakibinizi çemberin dışına atarsanız kazanırsınız! Bu kadar!
Dialogue: 0,0:09:09.74,0:09:13.66,Main,,0,0,0,,Çemberin içindeki hava ve\N suyun da içerde sayıldığını unutmayın!
Dialogue: 0,0:09:14.20,0:09:16.86,Main,,0,0,0,,F! O! X! Y!
Dialogue: 0,0:09:16.98,0:09:18.34,Main,,0,0,0,,Foxy!
Dialogue: 0,0:09:18.76,0:09:24.02,Main,,0,0,0,,Şuanda sahnede Çiçek Amigo Kızlar patron için tezahürat dansı yaparken,
Dialogue: 0,0:09:24.14,0:09:28.62,Main,,0,0,0,,Foxy'nin üstünde bir açılış dövüşü yapılıyor!
Dialogue: 0,0:09:29.46,0:09:34.14,Main,,0,0,0,,Ayrıca, Koltuklar Derneği sınırlı üretim Davy Back Dövüşü ürünleri satıyor
Dialogue: 0,0:09:34.22,0:09:35.82,Main,,0,0,0,,o yüzden bir bakmayı unutmayın!
Dialogue: 0,0:09:36.14,0:09:38.46,Main,,0,0,0,,İstemiyoruz, o yüzden başlayın artık!
Dialogue: 0,0:09:37.96,0:09:43.38,Note,,0,0,0,,Tabela: "Foxy Rozetleri"
Dialogue: 0,0:09:38.54,0:09:39.08,Main,,0,0,0,,...lütfen!
Dialogue: 0,0:09:39.14,0:09:41.88,Main,,0,0,0,,Tamamdır! İşte sınırlı üretim Foxy Rozetleri!
Dialogue: 0,0:09:42.38,0:09:43.90,Main,,0,0,0,,Almayın onları!
Dialogue: 0,0:09:44.00,0:09:45.80,Main,,0,0,0,,Affedersiniz. Yarışmacı nerede...?
Dialogue: 0,0:09:45.86,0:09:48.18,Main,,0,0,0,,Orada! Alın onu artık!
Dialogue: 0,0:09:48.26,0:09:51.04,Main,,0,0,0,,Patlamış mısır ve kola neden bu kadar pahalı?!
Dialogue: 0,0:09:51.22,0:09:53.06,Main,,0,0,0,,Beğenmiyorsan, almayabilirsin.
Dialogue: 0,0:09:53.42,0:09:54.60,Main,,0,0,0,,80% indirim yap!
Dialogue: 0,0:09:54.68,0:09:55.56,Main,,0,0,0,,Kapa çeneni!
Dialogue: 0,0:09:56.30,0:09:58.00,Main,,0,0,0,,Sınırlar yerinde!
Dialogue: 0,0:09:58.12,0:10:01.26,Main,,0,0,0,,Sabrınız için teşekkürler!\NAçılış eğlencesi sona erdi!
Dialogue: 0,0:10:02.34,0:10:04.76,Main,,0,0,0,,Şimdi bugünün ana etkinliği...
Dialogue: 0,0:10:06.56,0:10:09.30,Main,,0,0,0,,Dövüş, zil ile başlayacak!
Dialogue: 0,0:10:14.54,0:10:17.42,Main,,0,0,0,,Herkes izleyici tribününe acele etsin!
Dialogue: 0,0:10:17.54,0:10:18.34,Main,,0,0,0,,Ne oluyor?
Dialogue: 0,0:10:18.94,0:10:20.50,Main,,0,0,0,,Gökyüzü karanlıklaşıyor...
Dialogue: 0,0:10:22.24,0:10:27.00,Main,,0,0,0,,Bu sefer dövüşümüz bu ikisinden oluşuyor! Kaptan kaptana karşı!
Dialogue: 0,0:10:28.56,0:10:32.92,Main,,0,0,0,,İlk olarak, gemi başının sol köşesinde...!
Dialogue: 0,0:10:33.12,0:10:37.36,Main,,0,0,0,,Efsanevi bir yenilmezlik rekoru ile 920 galibiyeti ve 0 mağlubiyete sahip,
Dialogue: 0,0:10:37.48,0:10:40.00,Main,,0,0,0,,karşısına çıkan herkesi yenen adam!
Dialogue: 0,0:10:40.14,0:10:44.92,Main,,0,0,0,,Bizim patronumuz, Gümüş Tilki Foxy!
Dialogue: 0,0:10:48.36,0:10:49.36,Main,,0,0,0,,Tamamdır...
Dialogue: 0,0:10:50.00,0:10:54.20,Main,,0,0,0,,Dinle Luffy. Artık sen eski sen değilsin.
Dialogue: 0,0:10:54.26,0:10:58.70,Main,,0,0,0,,O saç stili bir erkeğin içindeki gerçek vahşiliği ortaya çıkarır.
Dialogue: 0,0:10:59.24,0:11:03.64,Main,,0,0,0,,Bazıları sorar, şampiyon mu afroyu yapar yoksa afro mu şampiyonu yapar...
Dialogue: 0,0:11:04.04,0:11:07.60,Main,,0,0,0,,Bu modern bilim tarafından bile hala daha çözülemedi.
Dialogue: 0,0:11:07.74,0:11:12.42,Main,,0,0,0,,Luffy... Afro ile beraber, yumruklarının gücü fena artacak.
Dialogue: 0,0:11:12.66,0:11:14.32,Main,,0,0,0,,Hasır Şapka nerede?!
Dialogue: 0,0:11:14.42,0:11:16.04,Main,,0,0,0,,Korkup kaçtı mı yoksa?!
Dialogue: 0,0:11:18.56,0:11:20.96,Main,,0,0,0,,Ve sağ köşeden doğru geliyor!
Dialogue: 0,0:11:21.48,0:11:27.74,Main,,0,0,0,,Doğu Mavi'den gelen, küçük bir korsan tayfasının kaptanı, ödülü 100 milyon beli olan adam...
Dialogue: 0,0:11:27.94,0:11:33.54,Main,,0,0,0,,..."Hasır Şapka" Monkey D. Luffy!
Dialogue: 0,0:11:37.14,0:11:41.62,Main,,0,0,0,,Sağ köşede Luffy afrosu ile birlikte gaza gelmiş durumda!
Dialogue: 0,0:11:42.18,0:11:44.34,Main,,0,0,0,,İyi görünüyorsun Luffy!
Dialogue: 0,0:11:45.10,0:11:46.20,Main,,0,0,0,,O da kim?
Dialogue: 0,0:11:46.58,0:11:48.80,Main,,0,0,0,,Luffy çok havalı!
Dialogue: 0,0:11:49.73,0:11:50.69,Main,,0,0,0,,Gerçekten.
Dialogue: 0,0:11:51.27,0:11:54.31,Main,,0,0,0,,İki dövüşçü de savaş alanına ayak bastı!
Dialogue: 0,0:11:54.63,0:12:01.37,Main,,0,0,0,,Hasır Şapka başarılı bir şekilde patronumuzu çemberden atarak tayfasını ve onurunu mu koruyacak?!
Dialogue: 0,0:12:01.89,0:12:06.51,Main,,0,0,0,,Yoksa, patronumuzun efsanevi yenilmezlik serisi onun elinden her şeyini mi alacak?!
Dialogue: 0,0:12:06.71,0:12:11.53,Main,,0,0,0,,Davy Back Dövüşü'nün bu son ve can alıcı dövüş turu başlamak üzere!
Dialogue: 0,0:12:16.49,0:12:17.99,Main,,0,0,0,,Bunlar da ne?!
Dialogue: 0,0:12:18.05,0:12:19.59,Main,,0,0,0,,Burası giyinme odası.
Dialogue: 0,0:12:19.95,0:12:23.29,Main,,0,0,0,,Dövüşte sadece eldiven gerekli, o yüzden istediğinizi seçin.
Dialogue: 0,0:12:23.61,0:12:25.28,Main,,0,0,0,,Harika!
Dialogue: 0,0:12:26.25,0:12:30.67,Main,,0,0,0,,Vay canına. Burası giyinme odasından çok bir kostüm odası gibi...
Dialogue: 0,0:12:30.99,0:12:34.87,Main,,0,0,0,,Ne kadar çok şey var! Ve istediğim her şeyi kullanabilirim Usopp!
Dialogue: 0,0:12:38.75,0:12:41.84,Main,,0,0,0,,Hey, bu nasıl? Yakıştı mı?
Dialogue: 0,0:12:43.57,0:12:46.09,Main,,0,0,0,,Hayır... İşte bu...
Dialogue: 0,0:12:53.97,0:12:56.71,Main,,0,0,0,,Hey, Hasır Şapka! Güzel tarz!
Dialogue: 0,0:12:58.37,0:13:00.05,Main,,0,0,0,,İşin bitti!
Dialogue: 0,0:13:00.15,0:13:04.01,Main,,0,0,0,,Kollarını içeride tut ve ona altın sağ kroşeni göster!
Dialogue: 0,0:13:04.25,0:13:04.83,Main,,0,0,0,,Evet!
Dialogue: 0,0:13:05.15,0:13:08.91,Main,,0,0,0,,Vay canına! Kardeşlik ruhu cayır cayır yanıyor!
Dialogue: 0,0:13:09.17,0:13:12.37,Main,,0,0,0,,Usopp'un onun köşe adamı olmasına izin vermek bir hataydı.
Dialogue: 0,0:13:12.47,0:13:14.49,Main,,0,0,0,,Keşke şu işi ciddiye alsa...
Dialogue: 0,0:13:14.69,0:13:18.03,Main,,0,0,0,,Senin yerinde olsam bu kadar kendimden emin olmazdım, Şampiyon!
Dialogue: 0,0:13:18.13,0:13:21.41,Main,,0,0,0,,Kafanı koparabilme ihtimali var! Dikkat et o yüzden!
Dialogue: 0,0:13:21.53,0:13:24.67,Main,,0,0,0,,Tamamdır, köşe adamı! Ayak bağısın o yüzden çekil artık!
Dialogue: 0,0:13:24.89,0:13:27.73,Main,,0,0,0,,Hey bu kadar mı?! Köşe adamı olarak işim çoktan bitti mi?!
Dialogue: 0,0:13:27.81,0:13:28.95,Main,,0,0,0,,Köşe adamı çıktı!
Dialogue: 0,0:13:30.27,0:13:32.03,Main,,0,0,0,,Başlayın artık!
Dialogue: 0,0:13:32.13,0:13:33.41,Main,,0,0,0,,Kesinlikle haklısınız!
Dialogue: 0,0:13:33.53,0:13:36.53,Main,,0,0,0,,Benim de burada kalmam için bir sebep kalmadı! Ben de gidiyorum!
Dialogue: 0,0:13:41.29,0:13:43.63,Main,,0,0,0,,Ne? Tribün...!
Dialogue: 0,0:13:44.37,0:13:47.89,Main,,0,0,0,,Ah, harika! Böyle bir şeyleri bile varmış!
Dialogue: 0,0:13:50.97,0:13:54.25,Main,,0,0,0,,Pekala, Hasır Şapka Luffy. Hadi biraz eğlenelim!
Dialogue: 0,0:13:54.99,0:13:59.87,Main,,0,0,0,,Bütün gemi savaş alanı! İstediğin kadar yakıp yıkabilirsin!
Dialogue: 0,0:14:00.63,0:14:04.63,Main,,0,0,0,,Bir sürü yetenekli gemi ustamız var zaten!
Dialogue: 0,0:14:08.77,0:14:12.23,Main,,0,0,0,,Tamamen tesadüf sonucu bu müsabaka Seksi Foxy'de yer alacak!
Dialogue: 0,0:14:12.33,0:14:15.02,Main,,0,0,0,,Ne tür ölümcül bir mücadele ortaya çıkacak acaba?!
Dialogue: 0,0:14:15.87,0:14:19.33,Main,,0,0,0,,Geniş savaş alanında artık sadece iki dövüşçü var!
Dialogue: 0,0:14:19.73,0:14:21.01,Main,,0,0,0,,Patron!
Dialogue: 0,0:14:21.13,0:14:23.41,Main,,0,0,0,,Yenilmeme rekorunu devam ettir!
Dialogue: 0,0:14:23.63,0:14:26.29,Main,,0,0,0,,Luffy, kazan! Kazanman gerek!
Dialogue: 0,0:14:26.43,0:14:28.71,Main,,0,0,0,,Işınına karşı dikkatlı ol! Işınına!
Dialogue: 0,0:14:29.01,0:14:32.15,Main,,0,0,0,,Heyecan tribünleri kaplıyor!
Dialogue: 0,0:14:32.33,0:14:34.15,Main,,0,0,0,,Yağmala ya da yağmalan!
Dialogue: 0,0:14:34.51,0:14:36.75,Main,,0,0,0,,Zaman sınırı olmayan tek bir maç olacak!
Dialogue: 0,0:14:36.81,0:14:40.09,Main,,0,0,0,,Gümüş Tilki Foxy karşısında Hasır Şapka Luffy!
Dialogue: 0,0:14:40.25,0:14:43.93,Main,,0,0,0,,Bu iki güçlü korsan arasında kafa kafaya bir mücadele!
Dialogue: 0,0:14:44.07,0:14:46.03,Main,,0,0,0,,Her şeyin kaderi buna bağlı!
Dialogue: 0,0:14:46.47,0:14:47.69,Main,,0,0,0,,İşte şimdi...
Dialogue: 0,0:14:49.89,0:14:51.63,Main,,0,0,0,,...başlama zili!
Dialogue: 0,0:14:52.29,0:14:53.09,Main,,0,0,0,,Hadi bakalım!
Dialogue: 0,0:14:53.19,0:14:53.69,Main,,0,0,0,,Evet!
Dialogue: 0,0:14:53.85,0:14:57.17,Main,,0,0,0,,{\fad(150,150)}Gomu-Gomu no... Pistol!\N{Lastik Lastik... Tabanca!}
Dialogue: 0,0:14:53.85,0:14:57.17,Attack,,0,0,0,,{\fad(150,150)}Lastik Lastik... Tabanca
Dialogue: 0,0:14:54.85,0:14:56.67,Secondary,,0,0,0,,{\fad(150,150)}Noro-Noro Beam! {Yavaş-Yavaş Işın!}
Dialogue: 0,0:14:54.85,0:14:56.67,Attack,,0,0,0,,{\fad(150,150)}Yavaş-Yavaş Işın
Dialogue: 0,0:15:03.19,0:15:05.13,Main,,0,0,0,,Sadece yumruğum yavaşladı!
Dialogue: 0,0:15:07.17,0:15:09.99,Main,,0,0,0,,Güçlü olanın kim olduğu belli oldu!
Dialogue: 0,0:15:10.31,0:15:11.47,Main,,0,0,0,,Ne?!
Dialogue: 0,0:15:11.95,0:15:13.19,Main,,0,0,0,,Geri dön!
Dialogue: 0,0:15:16.19,0:15:19.41,Main,,0,0,0,,{\fad(150,150)}Noro-Noro... {Yavaş-Yavaş...}
Dialogue: 0,0:15:16.19,0:15:19.41,Attack,,0,0,0,,{\fad(150,150)}Yavaş-Yavaş...
Dialogue: 0,0:15:18.19,0:15:19.07,Secondary,,0,0,0,,Olamaz!
Dialogue: 0,0:15:20.17,0:15:21.45,Main,,0,0,0,,Yalandı!
Dialogue: 0,0:15:21.55,0:15:22.79,Main,,0,0,0,,Ne...?!
Dialogue: 0,0:15:23.07,0:15:25.19,Main,,0,0,0,,{\fad(150,150)}Noro-Noro Beam! {Yavaş-Yavaş Işın!}
Dialogue: 0,0:15:23.07,0:15:25.19,Attack,,0,0,0,,{\fad(150,150)}Yavaş-Yavaş Işın
Dialogue: 0,0:15:27.41,0:15:28.23,Main,,0,0,0,,Luffy!
Dialogue: 0,0:15:31.95,0:15:35.53,Main,,0,0,0,,Asılı kaldı! Düşerken de mi yavaşlıyor?
Dialogue: 0,0:15:35.99,0:15:39.05,Main,,0,0,0,,Ona söyledim dikkatli ol diye!
Dialogue: 0,0:15:39.23,0:15:44.69,Main,,0,0,0,,Kah...ret...sin...
Dialogue: 0,0:15:46.81,0:15:50.35,Main,,0,0,0,,Ne oldu Hasır Şapka? Şimdiden bitirmek istediğine emin misin?!
Dialogue: 0,0:15:50.91,0:15:54.07,Main,,0,0,0,,Ne...?
Dialogue: 0,0:15:56.81,0:15:59.43,Main,,0,0,0,,{\fad(150,150)}Kyubi Rush! {Dokuz Kuyruk Saldırısı!}
Dialogue: 0,0:15:56.81,0:15:59.43,Attack,,0,0,0,,{\fad(150,150)}Dokuz Kuyruk Saldırısı
Dialogue: 0,0:16:02.35,0:16:05.17,Main,,0,0,0,,Oh! Patronumuz direkt şiddetli bir saldırıya başvuruyor!
Dialogue: 0,0:16:05.47,0:16:07.23,Main,,0,0,0,,Hasır Şapka hiçbir şey yapamıyor!
Dialogue: 0,0:16:10.39,0:16:13.17,Main,,0,0,0,,Ne? Tepki bile vermiyor...
Dialogue: 0,0:16:13.49,0:16:14.51,Main,,0,0,0,,Hayır, öyle değil!
Dialogue: 0,0:16:14.91,0:16:16.71,Main,,0,0,0,,Tepkileri bile ağır çekim o kadar!
Dialogue: 0,0:16:27.15,0:16:29.05,Main,,0,0,0,,Bu sadece küçük bir selamlamaydı.
Dialogue: 0,0:16:29.35,0:16:32.19,Main,,0,0,0,,Yumrukların kendisi canını çok yakmadı.
Dialogue: 0,0:16:32.73,0:16:34.78,Main,,0,0,0,,O kadarını biliyorum, lastik adam!
Dialogue: 0,0:16:35.13,0:16:38.41,Main,,0,0,0,,Lanet... olsun...
Dialogue: 0,0:16:38.81,0:16:40.78,Main,,0,0,0,,Pekala, otuz saniyen dolmak üzere!
Dialogue: 0,0:16:41.85,0:16:42.97,Main,,0,0,0,,Hepsi bir anda vuruyor!
Dialogue: 0,0:16:42.99,0:16:44.68,Main,,0,0,0,,Olamaz! Gemiden düşüyor!
Dialogue: 0,0:16:45.17,0:16:46.37,Main,,0,0,0,,Luffy!
Dialogue: 0,0:16:54.75,0:16:58.79,Main,,0,0,0,,Kahretsin! Düşündüğümden daha tehlikeliymiş, Noro-Noro Beam!
Dialogue: 0,0:16:59.03,0:17:01.74,Main,,0,0,0,,Işınlar cidden iyi...
Dialogue: 0,0:17:02.23,0:17:04.81,Main,,0,0,0,,Gerektiğinden çok uzamamam gerek sanırım...
Dialogue: 0,0:17:05.75,0:17:07.87,Main,,0,0,0,,Nereye kayboldu o pislik?!
Dialogue: 0,0:17:10.19,0:17:12.83,Main,,0,0,0,,Kahretsin! Artık onun tarafından vurulmayacağım!
Dialogue: 0,0:17:15.13,0:17:17.01,Main,,0,0,0,,Ortaya çık, Yarık Kafa!
Dialogue: 0,0:17:17.59,0:17:20.41,Main,,0,0,0,,Sinirlenseniz de kulakları kırmayın lütfen!
Dialogue: 0,0:17:25.45,0:17:27.37,Main,,0,0,0,,Y-Yine mi Noro-Noro?!
Dialogue: 0,0:17:31.31,0:17:33.49,Main,,0,0,0,,Gemime hoşgeldin!
Dialogue: 0,0:17:33.65,0:17:34.99,Main,,0,0,0,,Seni...!
Dialogue: 0,0:17:35.81,0:17:37.23,Main,,0,0,0,,Ah! Vurdu!
Dialogue: 0,0:17:39.53,0:17:41.59,Main,,0,0,0,,Hey, biraz sakinleş.
Dialogue: 0,0:17:41.79,0:17:44.37,Main,,0,0,0,,Sana biraz misafirperverlik göstermeye çalışıyorum burada...
Dialogue: 0,0:17:44.95,0:17:47.08,Main,,0,0,0,,O toplar da Noro-Noro'landı demek...
Dialogue: 0,0:17:47.69,0:17:51.07,Main,,0,0,0,,Eğer sen onlardan birini sürebiliyorsan, ben de sürerim!
Dialogue: 0,0:17:51.29,0:17:53.79,Main,,0,0,0,,Ah...! Yerinde olsam bunu yapmazdım...
Dialogue: 0,0:17:55.75,0:17:57.63,Main,,0,0,0,,Ah, o da.
Dialogue: 0,0:18:03.39,0:18:05.03,Main,,0,0,0,,Söylemiştim oysa ki!
Dialogue: 0,0:18:12.47,0:18:13.57,Main,,0,0,0,,Kahretsin...
Dialogue: 0,0:18:14.45,0:18:18.71,Main,,0,0,0,,Onun sorunu ne?! Kendi gemisini paramparça ediyor...
Dialogue: 0,0:18:20.01,0:18:21.19,Main,,0,0,0,,Daha yeni başlıyorum!
Dialogue: 0,0:18:21.43,0:18:23.77,Main,,0,0,0,,{\fad(150,150)}Noro-Noro Foxy Face Bombs!\N{Yavaş-Yavaş Foxy Yüz Bombaları!}
Dialogue: 0,0:18:21.43,0:18:23.77,Attack,,0,0,0,,{\fad(150,150)}Yavaş-Yavaş Foxy Yüz Bombaları
Dialogue: 0,0:18:29.33,0:18:30.25,Main,,0,0,0,,Korkunç!
Dialogue: 0,0:18:31.43,0:18:35.15,Main,,0,0,0,,Ha? Rozet armaları mı? Benim aldıklarımdan daha büyükler!
Dialogue: 0,0:18:35.57,0:18:38.39,Main,,0,0,0,,Tabii ki öyle! Bombayız biz!
Dialogue: 0,0:18:38.89,0:18:40.83,Main,,0,0,0,,Öyle mi?! Hadi ya!
Dialogue: 0,0:18:41.15,0:18:43.23,Main,,0,0,0,,Ha? Bomba konuştu!
Dialogue: 0,0:18:43.89,0:18:46.53,Main,,0,0,0,,Ben... gerçek olanım!
Dialogue: 0,0:18:48.91,0:18:50.65,Main,,0,0,0,,Üzgünüm Hasır Şapka...
Dialogue: 0,0:18:51.63,0:18:53.31,Main,,0,0,0,,Eldivenlerimi geliştirdim!
Dialogue: 0,0:18:53.53,0:18:56.51,Main,,0,0,0,,Ve Yüz Bombaları'nın otuz saniyesi doldu!
Dialogue: 0,0:19:00.73,0:19:03.35,Main,,0,0,0,,Evet! Luffy! Gövde! Gövde!
Dialogue: 0,0:19:03.49,0:19:04.61,Main,,0,0,0,,Ah Usopp!
Dialogue: 0,0:19:05.45,0:19:07.57,Main,,0,0,0,,Hey, dövüşte ne oluyor?
Dialogue: 0,0:19:07.75,0:19:09.38,Main,,0,0,0,,Bilmem. Bilmiyorum.
Dialogue: 0,0:19:09.81,0:19:10.89,Main,,0,0,0,,O da ne demek?!
Dialogue: 0,0:19:25.17,0:19:28.91,Main,,0,0,0,,P-Patlamalar anında gemimizi sarstı..
Dialogue: 0,0:19:29.79,0:19:32.35,Main,,0,0,0,,...tesadüf eseri savaş alanı olan gemide...
Dialogue: 0,0:19:32.63,0:19:36.35,Main,,0,0,0,,yine tesadüf eseri doldurulmuş Foxy Yüz Bombaları yüzünden...!
Dialogue: 0,0:19:36.81,0:19:41.01,Main,,0,0,0,,Kendi gemilerini savaş alanı yapmak ne kadar da adice bir numara!
Dialogue: 0,0:19:41.13,0:19:44.43,Main,,0,0,0,,Hey! Luffy! Ne oldu?!
Dialogue: 0,0:19:43.33,0:19:44.43,Secondary,,0,0,0,,Sakinleş!
Dialogue: 0,0:19:44.71,0:19:50.43,Main,,0,0,0,,Patronumuzun bunu kendi lehine kullanarak yaptığı top atışı, Hasır Şapka Luffy'i patlatmakta başarılı oldu!
Dialogue: 0,0:19:52.19,0:19:55.97,Main,,0,0,0,,Hepsi buraya kadar mı?! Nerede?!
Dialogue: 0,0:19:56.35,0:19:58.13,Main,,0,0,0,,Bu yakındı!
Dialogue: 0,0:19:58.61,0:20:00.97,Main,,0,0,0,,Gerçekten yakın bir saldırıydı--!
Dialogue: 0,0:20:02.59,0:20:04.23,Main,,0,0,0,,Ne?!
Dialogue: 0,0:20:04.77,0:20:06.21,Main,,0,0,0,,Ne oldu?! Bir susmadın!
Dialogue: 0,0:20:07.59,0:20:11.11,Main,,0,0,0,,Hasır Şapka Luffy... yaşıyor!
Dialogue: 0,0:20:12.49,0:20:13.75,Main,,0,0,0,,C-Ciddi misin?!
Dialogue: 0,0:20:13.85,0:20:14.91,Main,,0,0,0,,İnanamıyorum!
Dialogue: 0,0:20:15.91,0:20:18.91,Main,,0,0,0,,Bir şekilde yakın mesafe top saldırısından kaçınmayı başardı!
Dialogue: 0,0:20:19.29,0:20:24.83,Main,,0,0,0,,Bu nasıl bir hız?! Y-Yoksa bu, 100 milyon değerindeki bir adamın gerçek gücü mü?!
Dialogue: 0,0:20:25.21,0:20:27.69,Main,,0,0,0,,Tabii ki öyle!
Dialogue: 0,0:20:26.21,0:20:27.69,Secondary,,0,0,0,,Bitir şunun işini artık!
Dialogue: 0,0:20:42.43,0:20:47.93,Main,,0,0,0,,Ama patronun bir sonraki saldırısı şimdiden başlıyor gibi duruyor!
Dialogue: 0,0:20:52.21,0:20:56.99,Main,,0,0,0,,Bu yoğun sis perdesinin ardından gelen patronumuzun rahatsız edici kahkahası!
Dialogue: 0,0:20:57.45,0:20:59.15,Main,,0,0,0,,Nereden geldi acaba?!
Dialogue: 0,0:20:59.63,0:21:02.75,Main,,0,0,0,,Daha ne tür numaralar saklıyor acaba, Gümüş Tilki Foxy?!
Dialogue: 0,0:21:04.01,0:21:05.25,Main,,0,0,0,,İşte orada!
Dialogue: 0,0:21:13.57,0:21:15.73,Main,,0,0,0,,Tamamdır, umarım hazırsındır!
Dialogue: 0,0:21:15.91,0:21:18.11,Main,,0,0,0,,Patladın mı sen?!
Dialogue: 0,0:21:18.67,0:21:21.61,Main,,0,0,0,,Patlamadım! Aptal!
Dialogue: 0,0:21:21.71,0:21:23.17,Main,,0,0,0,,Yalancı!
Dialogue: 0,0:21:23.29,0:21:26.75,Main,,0,0,0,,Bu savaş alanından canlı çıkabileceğini bir saniye olsun düşünme!
Dialogue: 0,0:21:27.07,0:21:27.99,Main,,0,0,0,,{\fad(150,150)}Noro-Noro Beam--! {Yavaş-Yavaş Işın--!}
Dialogue: 0,0:21:27.07,0:21:27.99,Attack,,0,0,0,,{\fad(150,150)}Yavaş-Yavaş Işın--
Dialogue: 0,0:21:27.99,0:21:28.73,Main,,0,0,0,,
Dialogue: 0,0:21:28.25,0:21:29.27,Main,,0,0,0,,{\fad(150,150)}Gomu Hook! {Lastik Kanca!}
Dialogue: 0,0:21:28.25,0:21:29.27,Attack,,0,0,0,,{\fad(150,150)}Lastik Kanca
Dialogue: 0,0:21:31.65,0:21:34.19,Main,,0,0,0,,O kolunu bir daha ışın atamayacak hale getireceğim!
Dialogue: 0,0:21:35.95,0:21:37.57,Main,,0,0,0,,Yine dumanın içine girdi!
Dialogue: 0,0:21:39.15,0:21:41.61,Main,,0,0,0,,Ha?! İşte oradasın!
Dialogue: 0,0:21:43.67,0:21:45.13,Main,,0,0,0,,Ne? Tahta mı?!
Dialogue: 0,0:21:45.33,0:21:47.54,Main,,0,0,0,,{\fad(150,150)}Noro-Noro Beam! {Yavaş-Yavaş Işın!}
Dialogue: 0,0:21:45.33,0:21:47.54,Attack,,0,0,0,,{\fad(150,150)}Yavaş-Yavaş Işın
Dialogue: 0,0:21:57.85,0:22:03.35,Main,,0,0,0,,Pekala! Hangisi benim? Işın ne taraftan gelecek?!
Dialogue: 0,0:22:03.77,0:22:08.49,Main,,0,0,0,,Kahretsin! Bunu nasıl bilebilirim ki?! Hepsinin aptal görünümlü kafaları var!
Dialogue: 0,0:22:10.47,0:22:12.25,Main,,0,0,0,,Aptal görünümlü kafa...
Dialogue: 0,0:22:15.29,0:22:16.32,Main,,0,0,0,,Oradasın!
Dialogue: 0,0:22:23.11,0:22:26.03,Main,,0,0,0,,Pislik! Sen kendine iyi kalpli bir insan mı diyorsun?!
Dialogue: 0,0:22:26.41,0:22:28.51,Main,,0,0,0,,Bu kadar yeter! Yukarı bak!
Dialogue: 0,0:22:28.55,0:22:29.08,Main,,0,0,0,,Ha?
Dialogue: 0,0:22:35.75,0:22:37.45,Main,,0,0,0,,Kahretsin! Tuzak kapısı!
Dialogue: 0,0:22:37.59,0:22:39.57,Main,,0,0,0,,Dikkatin dağılırsa böyle olur işte!
Dialogue: 0,0:22:40.15,0:22:42.61,Main,,0,0,0,,Yukarı bakmamı söyleyen sendin!
Dialogue: 0,0:22:44.45,0:22:46.19,Main,,0,0,0,,Daha çok dikkat etmelisin!
Dialogue: 0,0:22:46.37,0:22:47.10,Main,,0,0,0,,
Dialogue: 0,0:22:47.25,0:22:50.13,Main,,0,0,0,,B-Bu da ne...?! Y-Y-Yer hareket ediyor!
Dialogue: 0,0:22:50.25,0:22:52.01,Main,,0,0,0,,Beni geri çekiyor!
Dialogue: 0,0:22:55.67,0:22:56.59,Main,,0,0,0,,Luffy!
Dialogue: 0,0:22:56.67,0:22:58.02,Main,,0,0,0,,Neden oradan çıktı?!
Dialogue: 0,0:22:58.47,0:23:00.67,Main,,0,0,0,,Olamaz! Suya düşerse kaybeder!
Dialogue: 0,0:23:01.45,0:23:04.45,Main,,0,0,0,,Düşmeyeceğim...!
Dialogue: 0,0:23:07.41,0:23:08.45,Main,,0,0,0,,Yakındı!
Dialogue: 0,0:23:10.77,0:23:13.49,Main,,0,0,0,,Hayır, hayır! O kadar çabuk bitseydi eğlenceli olmazdı zaten!
Dialogue: 0,0:23:13.63,0:23:15.99,Main,,0,0,0,,Biraz daha dayan, Hasır Şapka!
Dialogue: 0,0:23:17.75,0:23:20.21,Main,,0,0,0,,Bu gemi de neyin nesi böyle?!
Dialogue: 0,0:23:20.55,0:23:22.55,Main,,0,0,0,,Nereye kayboldun, tilki?!
Dialogue: 0,0:23:25.45,0:23:26.57,Main,,0,0,0,,Bu da ne?!
Dialogue: 0,0:23:26.77,0:23:31.37,Main,,0,0,0,,Zar zor kurtulan Hasır Şapka Luffy'i, \Nbir Foxy Rozeti gizemli bir şekilde kışkırtıyor!
Dialogue: 0,0:23:32.91,0:23:34.49,Main,,0,0,0,,Orada!
Dialogue: 0,0:23:34.57,0:23:38.01,Main,,0,0,0,,Geminin içi patronumuzun oyun alanı!\NHasır Şapka Luffy içeri çekilecek mi acaba?!
Dialogue: 0,0:23:38.23,0:23:40.39,Main,,0,0,0,,Luffy, yapma! Kesinlikle bir tuzak!
Dialogue: 0,0:23:40.49,0:23:42.53,Main,,0,0,0,,İçerde bir sürü bubi tuzağı olduğu çok belli!
Dialogue: 0,0:23:46.07,0:23:47.89,Main,,0,0,0,,Pislik! Kıçını tekmeleyeceğim!
Dialogue: 0,0:23:48.37,0:23:50.33,Main,,0,0,0,,Hasır Şapka Luffy direkt içeri yöneliyor!
Dialogue: 0,0:23:50.47,0:23:53.75,Main,,0,0,0,,Dövüş içeriye taşındı ama size bilgileri aktarmak için içeriye giremem!
Dialogue: 0,0:23:53.83,0:23:59.17,Main,,0,0,0,,Bu turun aslı bu:\Niki dövüşçü arasında yalnız bir dövüş!
Dialogue: 0,0:23:59.67,0:24:04.75,Main,,0,0,0,,Kalk! Ayağa kalk Luffy! Acı verici eğitimini hatırla!
Dialogue: 0,0:24:04.89,0:24:06.99,Main,,0,0,0,,Ne eğitimden bahsediyorsun?! Otur yerine.
Dialogue: 0,0:24:07.47,0:24:08.87,Main,,0,0,0,,Top güvertesi demek ha!
Dialogue: 0,0:24:09.45,0:24:12.83,Main,,0,0,0,,Çok büyük! Usopp bunu görseydi çok mutlu olurdu!
Dialogue: 0,0:24:13.41,0:24:15.13,Main,,0,0,0,,Nerede bu?!
Dialogue: 0,0:24:17.23,0:24:18.31,Main,,0,0,0,,İşte orada!
Dialogue: 0,0:24:24.85,0:24:26.86,Main,,0,0,0,,Tamamdır! Peşimden geliyor...!
Dialogue: 0,0:24:26.95,0:24:30.29,Main,,0,0,0,,Şimdi de aşırı süratle kapıdan girecek!
Dialogue: 0,0:24:31.13,0:24:33.45,Main,,0,0,0,,Bilmediği şu ki...
Dialogue: 0,0:24:34.85,0:24:38.21,Main,,0,0,0,,...burası dikenlerle dolu bir oda!
Dialogue: 0,0:24:40.23,0:24:42.25,Main,,0,0,0,,Şimdi, içeri dal ve şişle--
Dialogue: 0,0:24:54.45,0:24:55.60,Main,,0,0,0,,Ah. İşte orada.
Dialogue: 0,0:24:56.41,0:24:58.31,Main,,0,0,0,,Ha? O oda da ne?
Dialogue: 0,0:24:58.79,0:25:01.99,Main,,0,0,0,,Kim başkasının gemisinin içinde top ateşler ki?!
Dialogue: 0,0:25:05.71,0:25:06.95,Main,,0,0,0,,Ah. Geri geliyor.
Dialogue: 0,0:25:12.75,0:25:15.05,Main,,0,0,0,,Amma da yüzsüzsün sen! Beni öldürmeye mi çalışıyorsun?!
Dialogue: 0,0:25:15.93,0:25:17.66,Main,,0,0,0,,Kahretsin!
Dialogue: 0,0:25:18.11,0:25:19.62,Main,,0,0,0,,Sana göstereceğim!
Dialogue: 0,0:25:20.19,0:25:21.58,Main,,0,0,0,,Ah! Kaçtı!
Dialogue: 0,0:25:22.19,0:25:24.54,Main,,0,0,0,,Bekle!
Dialogue: 0,0:25:22.05,0:25:24.84,Note,,0,0,0,,"Revir"
Dialogue: 0,0:25:27.25,0:25:30.01,Main,,0,0,0,,Hiç sağduyusu yok mu bu veledin?!
Dialogue: 0,0:25:30.99,0:25:34.05,Main,,0,0,0,,Buraya kadar! Foxy Yüz Dönüşümü!
Dialogue: 0,0:25:36.43,0:25:38.03,Main,,0,0,0,,Dur orada, tilki!
Dialogue: 0,0:25:39.57,0:25:40.31,Main,,0,0,0,,Biri?
Dialogue: 0,0:25:40.43,0:25:41.10,Main,,0,0,0,,Amanın!
Dialogue: 0,0:25:41.41,0:25:43.89,Main,,0,0,0,,Ne oldu? Hasta mı hissediyorsun?
Dialogue: 0,0:25:44.15,0:25:47.57,Main,,0,0,0,,Neren hasta? Kafan mı? Kafanda mı sıkıntı var?
Dialogue: 0,0:25:47.97,0:25:50.15,Main,,0,0,0,,H-Ha?! Az önce buraya birisi geldi mi?
Dialogue: 0,0:25:50.69,0:25:52.95,Main,,0,0,0,,Hayır, bilmiyorum. Ama onu boşver de...
Dialogue: 0,0:25:53.73,0:25:56.13,Main,,0,0,0,,Sıkıntılı yer neresi? Yüzün mü?
Dialogue: 0,0:25:58.45,0:26:00.85,Main,,0,0,0,,Garip... Onu gördüğüme emin--
Dialogue: 0,0:26:01.05,0:26:03.89,Main,,0,0,0,,Bekle! O kadın ona benziyor!
Dialogue: 0,0:26:09.31,0:26:10.09,Main,,0,0,0,,Yoksa...
Dialogue: 0,0:26:10.81,0:26:13.31,Main,,0,0,0,,Hey sen! Sen o adamın kız kardeşisin değil mi?!
Dialogue: 0,0:26:13.47,0:26:15.33,Main,,0,0,0,,{\fad(150,150)}Counter Fox Blow! {Karşı Tilki Vuruşu!}
Dialogue: 0,0:26:13.47,0:26:15.33,Attack,,0,0,0,,{\fad(150,150)}Karşı Tilki Vuruşu
Dialogue: 0,0:26:18.17,0:26:19.23,Main,,0,0,0,,Aptal!
Dialogue: 0,0:26:21.23,0:26:22.47,Main,,0,0,0,,Bu şey de ne?!
Dialogue: 0,0:26:26.67,0:26:30.51,Main,,0,0,0,,Çok garip! Gerçekten de bu odadaydı!
Dialogue: 0,0:26:31.27,0:26:33.16,Main,,0,0,0,,Dövüşmeye çalışıyor mu ki?!
Dialogue: 0,0:26:34.49,0:26:35.78,Main,,0,0,0,,Ah! Mutfak!
Dialogue: 0,0:26:37.73,0:26:42.77,Main,,0,0,0,,Balık balık! Kes ve karıştır! Carpaccio!
Dialogue: 0,0:26:42.85,0:26:45.97,Main,,0,0,0,,Kızart o dilbalığını fa-mi-re-do!
Dialogue: 0,0:26:46.93,0:26:48.65,Main,,0,0,0,,Ne oldu?
Dialogue: 0,0:26:48.95,0:26:52.79,Main,,0,0,0,,Kafası ikiye yarılmış aptala benzeyen bir tilki gördünüz mü?!
Dialogue: 0,0:26:54.33,0:26:56.21,Main,,0,0,0,,Çok ileri gidiyorsun...!
Dialogue: 0,0:26:56.73,0:26:57.85,Main,,0,0,0,,Sensin!
Dialogue: 0,0:26:59.33,0:27:01.41,Main,,0,0,0,,Revirdeki kadın da bendim!
Dialogue: 0,0:27:01.47,0:27:02.99,Main,,0,0,0,,O da mı?!
Dialogue: 0,0:27:03.45,0:27:05.69,Main,,0,0,0,,{\fad(150,150)}Noro-Noro Beam! {Yavaş-Yavaş Işını!}
Dialogue: 0,0:27:03.45,0:27:05.69,Attack,,0,0,0,,{\fad(150,150)}Yavaş-Yavaş Işını
Dialogue: 0,0:27:05.75,0:27:07.87,Main,,0,0,0,,Kah... ret--!
Dialogue: 0,0:27:09.15,0:27:10.31,Main,,0,0,0,,{\fad(150,150)}Kyubi Rush! {Dokuz Kuyruk Saldırısı!}
Dialogue: 0,0:27:09.15,0:27:10.31,Attack,,0,0,0,,{\fad(150,150)}Dokuz Kuyruk Saldırısı
Dialogue: 0,0:27:15.51,0:27:18.39,Main,,0,0,0,,Seni buraya sebepsiz yere çektiğimi düşünme.
Dialogue: 0,0:27:20.49,0:27:25.91,Main,,0,0,0,,Geriye doğru uçtuğunda seni neyin beklediğine bak bakalım!
Dialogue: 0,0:27:26.19,0:27:27.65,Main,,0,0,0,,Bir canlı değil.
Dialogue: 0,0:27:28.37,0:27:30.67,Main,,0,0,0,,Bu kural ihlali olurdu sonuçta.
Dialogue: 0,0:27:39.75,0:27:45.57,Main,,0,0,0,,Noro-Noro Beam aktifken tüm saldırılar depolanır ve sonra da hepsi aynı anda salıverilir.
Dialogue: 0,0:27:50.19,0:27:54.71,Main,,0,0,0,,Hadi git bakalım! İlerisi senin hayatının son durağı!
Dialogue: 0,0:27:55.65,0:27:57.23,Main,,0,0,0,,Otuz saniye geçti.
Dialogue: 0,0:28:13.27,0:28:14.99,Main,,0,0,0,,Ha? Nerede o?
Dialogue: 0,0:28:15.51,0:28:18.49,Main,,0,0,0,,Ben... tam buradayım!
Dialogue: 0,0:28:27.67,0:28:31.09,Main,,0,0,0,,
Dialogue: 0,0:28:32.15,0:28:33.41,Main,,0,0,0,,
Dialogue: 0,0:28:35.89,0:28:39.13,Main,,0,0,0,,Ben Pilot Foxy! Ve...
Dialogue: 0,0:28:39.59,0:28:42.49,Main,,0,0,0,,...tanıtmama izin ver. Gorilla Puncher 13!
Dialogue: 0,0:28:42.71,0:28:48.03,Main,,0,0,0,,Sürekli geliştirilerek her kusurundan arındırılmış goril gibi yumruk atan bir makine!
Dialogue: 0,0:28:48.35,0:28:50.61,Main,,0,0,0,,Goril yüzü gerçekten gerekli miydi?!
Dialogue: 0,0:28:57.29,0:28:59.51,Main,,0,0,0,,İyi bir noktaya parmak bastın!
Dialogue: 0,0:28:59.81,0:29:02.81,Main,,0,0,0,,Kapa çeneni! Fikrini kim sordu?!
Dialogue: 0,0:29:02.97,0:29:06.41,Main,,0,0,0,,Hadi, Gorilla Puncher 13!
Dialogue: 0,0:29:12.53,0:29:14.45,Main,,0,0,0,,Nasıl kendi başına hareket ediyor?
Dialogue: 0,0:29:15.15,0:29:16.55,Main,,0,0,0,,Bu bir sır...!
Dialogue: 0,0:29:16.79,0:29:18.59,Main,,0,0,0,,Cidden fena terliyorsun...
Dialogue: 0,0:29:18.87,0:29:19.75,Main,,0,0,0,,Kapa çeneni!
Dialogue: 0,0:29:23.15,0:29:27.85,Main,,0,0,0,,Böyle yumrukları cidden savuşturabileceğini düşünmüyorsun değil mi?
Dialogue: 0,0:29:28.23,0:29:30.51,Main,,0,0,0,,{\fad(150,150)}Noro-Noro Beam! {Yavaş-Yavaş Işın!}
Dialogue: 0,0:29:28.23,0:29:30.51,Attack,,0,0,0,,{\fad(150,150)}Yavaş-Yavaş Işın
Dialogue: 0,0:29:30.65,0:29:32.15,Main,,0,0,0,,Ne? Nereye nişan alıyor--?
Dialogue: 0,0:29:33.49,0:29:34.85,Main,,0,0,0,,Arkana iyice bir bak!
Dialogue: 0,0:29:34.95,0:29:37.11,Main,,0,0,0,,Ha? O da kim?! Ayna mı?!
Dialogue: 0,0:29:37.29,0:29:40.47,Main,,0,0,0,,Evet! Noroma Fotonlar'ı aynalar tarafından yansıtılabilir!
Dialogue: 0,0:29:40.97,0:29:42.28,Main,,0,0,0,,Yakaladım!
Dialogue: 0,0:29:50.05,0:29:51.21,Main,,0,0,0,,
Dialogue: 0,0:29:53.73,0:29:55.87,Main,,0,0,0,,Sıcak mıydı? Sıcak mıydı?
Dialogue: 0,0:29:56.11,0:29:59.27,Main,,0,0,0,,Hatırlatmayı unuttum ama, bu yumruklar yanıyor!
Dialogue: 0,0:29:59.59,0:30:02.43,Main,,0,0,0,,Dikkat et! Deniz Kralları bile buna karşı duramaz!
Dialogue: 0,0:30:02.83,0:30:05.25,Main,,0,0,0,,{\fad(150,150)}Kagami Racket! {Ayna Raketi!}
Dialogue: 0,0:30:02.83,0:30:05.25,Attack,,0,0,0,,{\fad(150,150)}Ayna Raketi
Dialogue: 0,0:30:25.91,0:30:27.63,Main,,0,0,0,,Daha yeni başlıyoruz!
Dialogue: 0,0:30:29.09,0:30:33.57,Main,,0,0,0,,Hantal Top Şeytanı Arabası! Seken ışınlardan ve yumruklardan oluşan iki taraflı bir saldırı!
Dialogue: 0,0:30:40.55,0:30:43.43,Thoughts,,0,0,0,,Kahretsin, bu sinir bozucu! Eğer ona yaklaşabilirsem...!
Dialogue: 0,0:30:46.33,0:30:50.05,Main,,0,0,0,,Ne kadar kaçarsan kaç, önünde sonunda goril ve ayna arasında ezileceksin!
Dialogue: 0,0:30:52.85,0:30:53.45,Thoughts,,0,0,0,,İşte bu!
Dialogue: 0,0:30:58.65,0:31:01.15,Main,,0,0,0,,Bunu hiç düşünmemiştim!
Dialogue: 0,0:31:03.85,0:31:05.17,Main,,0,0,0,,Ne?!
Dialogue: 0,0:31:05.25,0:31:07.89,Main,,0,0,0,,{\fad(150,150)}Gomu-Gomu no Pistol! {Lastik-Lastik Tabanca!}
Dialogue: 0,0:31:05.25,0:31:07.89,Attack,,0,0,0,,{\fad(150,150)}Lastik-Lastik Tabanca
Dialogue: 0,0:31:12.75,0:31:14.07,Main,,0,0,0,,Hallettim!
Dialogue: 0,0:31:16.91,0:31:21.45,Main,,0,0,0,,{\fad(150,150)}Noro-Noro Beam! Beam! Beam! {Yavaş-Yavaş Işın! Işın! Işın!}
Dialogue: 0,0:31:16.91,0:31:21.45,Attack,,0,0,0,,{\fad(150,150)}Yavaş-Yavaş Işın! Işın! Işın!
Dialogue: 0,0:31:22.85,0:31:23.59,Main,,0,0,0,,Aptal!
Dialogue: 0,0:31:27.81,0:31:30.25,Main,,0,0,0,,{\fad(150,150)}Gorilla Punch Golden Hits! {Goril Yumruğu Altın Vuruşlar!}
Dialogue: 0,0:31:27.81,0:31:30.25,Attack,,0,0,0,,{\fad(150,150)}Goril Yumruğu Altın Vuruşlar
Dialogue: 0,0:31:48.21,0:31:51.23,Main,,0,0,0,,Davy Back Dövüşü'nün üçüncü turu, dövüş devam ediyor!
Dialogue: 0,0:31:51.39,0:31:54.53,Main,,0,0,0,,İçerde neler döndüğünü kimse bilmiyor ama içeride
Dialogue: 0,0:31:54.59,0:31:57.45,Main,,0,0,0,,gerçekten destansı bir dövüşün yaşandığına hiç şüphe yok!
Dialogue: 0,0:31:57.55,0:32:00.83,Main,,0,0,0,,Onu görememelerine rağmen, kalabalık patronumuza tezahürat yapıyor!
Dialogue: 0,0:32:00.95,0:32:02.19,Main,,0,0,0,,Kaybetmesi imkansız!
Dialogue: 0,0:32:02.37,0:32:05.33,Main,,0,0,0,,Tabii ki! O Luffy! Ve bir afrosu var!
Dialogue: 0,0:32:05.67,0:32:07.58,Main,,0,0,0,,Luffy olması yeter de artar bile.
Dialogue: 0,0:32:07.77,0:32:09.13,Main,,0,0,0,,O lanet tilki...
Dialogue: 0,0:32:09.57,0:32:12.17,Main,,0,0,0,,Afro neden bu kadar özel?
Dialogue: 0,0:32:12.61,0:32:15.11,Main,,0,0,0,,Güçlenmekle falan bir alakası mı var?!
Dialogue: 0,0:32:15.49,0:32:17.85,Main,,0,0,0,,Bu normalden daha çok zaman alıyor...
Dialogue: 0,0:32:18.21,0:32:19.79,Main,,0,0,0,,Lastik adam olduğu için.
Dialogue: 0,0:32:19.91,0:32:22.19,Main,,0,0,0,,Lastik adam ve afrosu var!
Dialogue: 0,0:32:22.61,0:32:24.95,Main,,0,0,0,,Cidden, bunun ne alakası var?!
Dialogue: 0,0:32:27.75,0:32:30.13,Main,,0,0,0,,Amanın! Güvertede bir hareketlenme var!
Dialogue: 0,0:32:30.35,0:32:35.33,Main,,0,0,0,,Kim üstün geliyor acaba?!\NYoksa dövüş çoktan bitti mi?!
Dialogue: 0,0:32:36.07,0:32:38.41,Main,,0,0,0,,İki gölge görüyorum!
Dialogue: 0,0:32:48.03,0:32:51.15,Main,,0,0,0,,Ayakta duran, Patron!
Dialogue: 0,0:32:51.45,0:32:53.93,Main,,0,0,0,,Patron!
Dialogue: 0,0:32:59.01,0:33:01.23,Main,,0,0,0,,Bu sırada Hasır Şapka simsiyah olmuş!
Dialogue: 0,0:33:01.33,0:33:04.11,Main,,0,0,0,,Çok ağır yumruklar yemiş gibi görünüyor!
Dialogue: 0,0:33:04.25,0:33:05.93,Main,,0,0,0,,Luffy!
Dialogue: 0,0:33:08.11,0:33:09.05,Main,,0,0,0,,Mümkün değil...
Dialogue: 0,0:33:09.41,0:33:12.39,Main,,0,0,0,,Basit birkaç tane yumruk nasıl \Nonu yakabilir?! Ne yaptı o?!
Dialogue: 0,0:33:13.15,0:33:13.89,Main,,0,0,0,,Bakın!
Dialogue: 0,0:33:20.69,0:33:23.35,Main,,0,0,0,,Kalktı, Hasır Şapka Luffy!
Dialogue: 0,0:33:23.73,0:33:27.47,Main,,0,0,0,,Tam nakavt olmuş gibi göründüğü anda yeniden ayağa kalktı!
Dialogue: 0,0:33:30.23,0:33:33.17,Main,,0,0,0,,Zar zor ayakta duruyorsun, Hasır Şapka...
Dialogue: 0,0:33:38.01,0:33:40.41,Main,,0,0,0,,Kardeşlik ruhu bu! Afro gücü!
Dialogue: 0,0:33:40.47,0:33:42.03,Main,,0,0,0,,Bitir işini, Patron!
Dialogue: 0,0:33:45.21,0:33:46.33,Main,,0,0,0,,Al bunu!
Dialogue: 0,0:33:53.55,0:33:55.01,Main,,0,0,0,,Bu Noro-Noro Beam Kılıcı!
Dialogue: 0,0:33:55.37,0:33:59.31,Main,,0,0,0,,Kollarını ve bacaklarını zapt ettim! Ama diğer yerleri oynatmakta özgürsün!
Dialogue: 0,0:34:04.27,0:34:06.81,Main,,0,0,0,,{\fad(150,150)}Megaton Kyubi Rush! {Megaton Dokuz Kuyruk Saldırısı!}
Dialogue: 0,0:34:04.27,0:34:06.81,Attack,,0,0,0,,{\fad(150,150)}Megaton Dokuz Kuyruk Saldırısı
Dialogue: 0,0:34:07.27,0:34:08.63,Main,,0,0,0,,{\fad(150,150)}Rush! {Saldırısı!}
Dialogue: 0,0:34:07.27,0:34:08.63,Attack,,0,0,0,,{\fad(150,150)}Saldırısı
Dialogue: 0,0:34:09.37,0:34:10.81,Main,,0,0,0,,{\fad(150,150)}Rush! {Saldırısı!}
Dialogue: 0,0:34:11.59,0:34:12.95,Main,,0,0,0,,{\fad(150,150)}Rush! {Saldırısı!}
Dialogue: 0,0:34:13.03,0:34:13.99,Main,,0,0,0,,{\fad(150,150)}Rush! {Saldırısı!}
Dialogue: 0,0:34:14.79,0:34:16.29,Main,,0,0,0,,Otuz saniye.
Dialogue: 0,0:34:23.03,0:34:25.95,Main,,0,0,0,,Bu sefer... Hayır, daha değil!
Dialogue: 0,0:34:27.01,0:34:28.10,Main,,0,0,0,,Luffy!
Dialogue: 0,0:34:33.93,0:34:36.33,Main,,0,0,0,,Kalktı, Hasır Şapka Luffy!
Dialogue: 0,0:34:38.25,0:34:40.53,Main,,0,0,0,,İnanılmaz! Bu adam da kim?!
Dialogue: 0,0:34:40.67,0:34:43.71,Main,,0,0,0,,Bu afro olmalı! Afronun vahşiliği yüzünden mi?!
Dialogue: 0,0:34:46.57,0:34:48.13,Main,,0,0,0,,İnatçı...!
Dialogue: 0,0:34:48.69,0:34:49.43,Main,,0,0,0,,Al bunu!
Dialogue: 0,0:34:49.61,0:34:50.89,Main,,0,0,0,,{\fad(150,150)}Noro-Noro Beam! {Yavaş-Yavaş Işın!}
Dialogue: 0,0:34:49.61,0:34:50.89,Attack,,0,0,0,,{\fad(150,150)}Yavaş-Yavaş Işın
Dialogue: 0,0:34:53.23,0:34:55.27,Main,,0,0,0,,{\fad(150,150)}Megaton Kyubi Rush! {Megaton Dokuz Kuyruk Saldırısı!}
Dialogue: 0,0:34:53.23,0:34:55.27,Attack,,0,0,0,,{\fad(150,150)}Megaton Dokuz Kuyruk Saldırısı
Dialogue: 0,0:34:58.59,0:35:02.11,Main,,0,0,0,,Bu adil değil, lanet olsun! O ışın kurallara aykırı!
Dialogue: 0,0:35:02.21,0:35:02.99,Main,,0,0,0,,Usopp!
Dialogue: 0,0:35:03.57,0:35:06.39,Main,,0,0,0,,Bu artık...!
Dialogue: 0,0:35:21.41,0:35:23.97,Main,,0,0,0,,Yumruklamak da kolay değil!
Dialogue: 0,0:35:25.43,0:35:28.19,Main,,0,0,0,,Ölümüne dövüyor onu!
Dialogue: 0,0:35:31.47,0:35:33.65,Main,,0,0,0,,Ha?! Tekrar mı...?!
Dialogue: 0,0:35:35.31,0:35:36.69,Main,,0,0,0,,T-Tekrar mı...?!
Dialogue: 0,0:35:41.49,0:35:42.29,Main,,0,0,0,,Luffy...!
Dialogue: 0,0:35:48.47,0:35:49.89,Main,,0,0,0,,Benim...
Dialogue: 0,0:35:50.11,0:35:52.43,Main,,0,0,0,,...arkadaşlarımın birini bile...
Dialogue: 0,0:35:52.73,0:35:55.19,Main,,0,0,0,,...ölsem de almanıza izin vermem!
Dialogue: 0,0:36:05.03,0:36:06.53,Main,,0,0,0,,Luffy...
Dialogue: 0,0:36:07.13,0:36:12.67,Main,,0,0,0,,Yine... Yine kalktı! Hasır Şapka Luffy!
