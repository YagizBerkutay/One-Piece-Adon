,2,0,2,10,10,10,1Style: OP11 Credits,FOT-Greco Std B,34,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,95,100,1,0,1,2.2,0,2,0,0,0,1Style: Author,Impress BT,20.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.7,0.7,9,10,10,10,1Style: Attack,Duality,35.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.4,1.6,7,20,20,15,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:01:51.61,0:01:59.70,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Kaşgarlı thx to onepace.netDialogue: 0,0:17:30.00,0:17:40.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Kaşgarlı thx to onepace.netDialogue: 0,0:32:48.05,0:32:51.05,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Kaşgarlı thx to onepace.netDialogue: 0,0:01:51.61,0:01:59.70,Title,,0,0,470,,Uzun Bir Adada MaceraDialogue: 0,0:02:00.49,0:02:03.35,Main,,0,0,0,,Acil durum raporu! Acil durum raporu!Dialogue: 0,0:02:03.35,0:02:05.42,Main,,0,0,0,,Saat 12 yönünde gemi tespit edildi!Dialogue: 0,0:02:05.42,0:02:08.34,Main,,0,0,0,,Ne? Düşmanlar mı?! Böyle bir zamanda...Dialogue: 0,0:02:08.47,0:02:13.85,Main,,0,0,0,,Aslında üstünde ne bayrak var ne de yelken! Ne tür bir gemi olduğunu bilmiyorum!Dialogue: 0,0:02:13.97,0:02:18.44,Main,,0,0,0,,O da ne öyle?! Hiçbir şeyleri yok mu cidden?! Neden denizdeler ki o zaman?!Dialogue: 0,0:02:18.52,0:02:20.19,Main,,0,0,0,,Bilmiyorum!Dialogue: 0,0:02:20.19,0:02:24.40,Main,,0,0,0,,Dahası, mürettebat da ilginç bir şekilde küçük görünüyor...Dialogue: 0,0:02:24.81,0:02:25.82,Main,,0,0,0,,Ayrıca...!Dialogue: 0,0:02:26.35,0:02:30.37,Main,,0,0,0,,Oldukça durgun gözüküyorlar! Sanki yaşam enerjileri yok gibi!Dialogue: 0,0:02:35.60,0:02:37.99,Main,,0,0,0,,Kaçın! Deniz Maymunları!Dialogue: 0,0:02:37.99,0:02:40.18,Main,,0,0,0,,Yine mi?! Bizi takip mi ettiler?!Dialogue: 0,0:02:40.18,0:02:42.77,Main,,0,0,0,,Kahretsin! Rüzgar yok! Çabuk! Yelkenleri toplayın!Dialogue: 0,0:02:42.77,0:02:44.27,Main,,0,0,0,,Çekin! Çekin!Dialogue: 0,0:02:48.57,0:02:51.86,Main,,0,0,0,,Bu da ne...?! O gemi iyi olacak mı?!Dialogue: 0,0:02:51.86,0:02:54.11,Main,,0,0,0,,Dalga onları yutacak!Dialogue: 0,0:02:54.41,0:02:56.62,Main,,0,0,0,,Hey! Siz!Dialogue: 0,0:02:56.83,0:03:01.09,Main,,0,0,0,,Devasa bir dalga ve maymunlar geliyor! Geri dönün!Dialogue: 0,0:03:01.54,0:03:04.33,Main,,0,0,0,,Oh! Hey! Bir gemi!Dialogue: 0,0:03:04.33,0:03:05.63,Main,,0,0,0,,Bir korsan gemisi!Dialogue: 0,0:03:05.79,0:03:09.85,Main,,0,0,0,,Beyler! Kalkın! Bir düşman gemisi! Hadi hazinelerini alalım!Dialogue: 0,0:03:09.85,0:03:12.75,Main,,0,0,0,,Bekle! Devasa bir dalga geliyor! Önce kaçmamız lazım!Dialogue: 0,0:03:12.75,0:03:15.37,Main,,0,0,0,,O geminin kaçmasına izin veremeyiz! Topları hazırlayın!Dialogue: 0,0:03:15.37,0:03:17.36,Main,,0,0,0,,Kime emir veriyorsun sen?! Kendin yap!Dialogue: 0,0:03:17.36,0:03:19.56,Main,,0,0,0,,Döndürün! Biri döndürsün!Dialogue: 0,0:03:19.56,0:03:21.89,Main,,0,0,0,,Ne kadar da düzensiz bir gemi...Dialogue: 0,0:03:21.89,0:03:25.19,Main,,0,0,0,,Hazinemizi çalmak istiyorlar. Düşman bunlar.Dialogue: 0,0:03:25.55,0:03:27.65,Main,,0,0,0,,Ne tarafa döneceğiz?! Ben nereden bileyim?!Dialogue: 0,0:03:27.65,0:03:31.21,Main,,0,0,0,,Biri emir versin! Rotacı! Yok!Dialogue: 0,0:03:31.21,0:03:33.24,Main,,0,0,0,,Kaptan! Yok!Dialogue: 0,0:03:36.66,0:03:38.70,Main,,0,0,0,,Onu ateşleyen de kim?!Dialogue: 0,0:03:38.87,0:03:40.62,Main,,0,0,0,,Dialogue: 0,0:03:40.70,0:03:45.09,Main,,0,0,0,,Faydası yok! Bizi yutacak! Kahretsin! Hepiniz beceriksizsiniz!Dialogue: 0,0:03:45.09,0:03:49.25,Main,,0,0,0,,Konuşana bak! Bir tane dalga ile bile baş edemiyor muyuz?!Dialogue: 0,0:04:08.78,0:04:10.13,Main,,0,0,0,,Sonunda sakinledi.Dialogue: 0,0:04:10.40,0:04:13.78,Main,,0,0,0,,O dalgalar aslında Deniz Maymunları'nın işi.Dialogue: 0,0:04:13.78,0:04:16.29,Main,,0,0,0,,Nem oranı ve sıcaklık oldukça sabit gibi duruyor,Dialogue: 0,0:04:16.54,0:04:19.44,Main,,0,0,0,,o yüzden çoktan bir sonraki adanın iklim kuşağına girmiş olmalıyız!Dialogue: 0,0:04:19.94,0:04:22.76,Main,,0,0,0,,Hey Robin. Bir şey görüyor musun?Dialogue: 0,0:04:22.76,0:04:24.43,Main,,0,0,0,,Bir süredir bir ada görünüyor.Dialogue: 0,0:04:25.18,0:04:26.70,Main,,0,0,0,,Neden daha erken söylemedin?!Dialogue: 0,0:04:26.80,0:04:29.67,Main,,0,0,0,,Dinleyin! Bir ada gördüğünüzde bunu söyleyin!Dialogue: 0,0:04:29.67,0:04:30.92,Main,,0,0,0,,Buyur!Dialogue: 0,0:04:30.92,0:04:36.76,Main,,0,0,0,,Millet! Bir ada görüyorum! Oley!Dialogue: 0,0:04:37.05,0:04:37.97,Main,,0,0,0,,Söyleyin!Dialogue: 0,0:04:38.30,0:04:39.70,Main,,0,0,0,,Sis oldukça yoğun.Dialogue: 0,0:04:39.88,0:04:42.30,Main,,0,0,0,,Sis mi? Dikkatli olmalıyız.Dialogue: 0,0:04:42.66,0:04:46.00,Main,,0,0,0,,Chopper! İleriyi izlemeyi sana bırakıyorum! Tamam!Dialogue: 0,0:04:46.00,0:04:49.88,Main,,0,0,0,,Hey! Bir ada görmek için ne kadardır beklediğimizi biliyor musun sen?!Dialogue: 0,0:04:49.88,0:04:51.81,Main,,0,0,0,,Özür dilerim. Daha dikkatli olurum.Dialogue: 0,0:04:51.81,0:04:54.17,Main,,0,0,0,,Cidden mi? Dikkatli olacaksan, tamam o zaman.Dialogue: 0,0:04:54.37,0:04:58.04,Main,,0,0,0,,Az önceki gemi sizi de endişelendirmiyor mu?Dialogue: 0,0:04:58.04,0:05:00.00,Main,,0,0,0,,Kaptanlarının ve rotacılarının olmadığını söylediler,Dialogue: 0,0:05:00.00,0:05:03.17,Main,,0,0,0,,ne bayrakları ve yelkenleri vardı ne de bir düzenleri...Dialogue: 0,0:05:03.63,0:05:06.51,Main,,0,0,0,,Ne tür bir korsan tayfası etrafta bu şekilde gezer ki?!Dialogue: 0,0:05:06.89,0:05:09.10,Main,,0,0,0,,Muhtemelen bir savaşa girip kaybetmişlerdir.Dialogue: 0,0:05:09.10,0:05:11.97,Main,,0,0,0,,Sonra da kaptanları ölmüştür ve yağmalanmışlardır...Dialogue: 0,0:05:12.39,0:05:15.85,Main,,0,0,0,,Hayır bu olamaz! Gemilerini iyice inceledim!Dialogue: 0,0:05:15.85,0:05:18.10,Main,,0,0,0,,Üstünde hiçbir savaş izi yoktu!Dialogue: 0,0:05:18.10,0:05:22.48,Main,,0,0,0,,Ayrıca gemide korsanların ihtiyacı olabileceği hiçbir şey yoktu!Dialogue: 0,0:05:22.73,0:05:26.44,Main,,0,0,0,,Korsan değillerdi o zaman. Kafana takma.Dialogue: 0,0:05:27.66,0:05:31.87,Main,,0,0,0,,Bana cidden korsan gibi görünmüşlerdi ama...Dialogue: 0,0:05:31.87,0:05:34.20,Main,,0,0,0,,İçimde kötü bir his var...Dialogue: 0,0:05:34.20,0:05:35.46,Main,,0,0,0,,Her zamanki halin.Dialogue: 0,0:05:35.46,0:05:38.63,Main,,0,0,0,,Tamam! Bir kasaba var mı acaba! Umarım bir tersaneleri vardır!Dialogue: 0,0:05:38.63,0:05:40.96,Main,,0,0,0,,Luffy! Hemen atlama sakın!Dialogue: 0,0:05:46.38,0:05:49.38,Main,,0,0,0,,Umarım bize katılacak iyi bir gemi ustası buluruz!Dialogue: 0,0:05:49.93,0:05:53.01,Main,,0,0,0,,Kıyıya yaklaştık! Çapayı hazırlayın!Dialogue: 0,0:05:54.02,0:05:56.02,Main,,0,0,0,,Çocuklar... Beni dinleyin...Dialogue: 0,0:05:56.02,0:05:59.63,Main,,0,0,0,,Chopper! Usopp "Adaya Gidemem" hastalığına yakalandı!Dialogue: 0,0:06:00.54,0:06:01.98,Main,,0,0,0,,Onu iyileştiremem.Dialogue: 0,0:06:02.27,0:06:04.35,Main,,0,0,0,,Geldik! Geldik! Geldik! Geldik! Geldik!Dialogue: 0,0:06:07.65,0:06:10.11,Main,,0,0,0,,Hiçbir şey yok!Dialogue: 0,0:06:11.11,0:06:13.57,Main,,0,0,0,,Burası da neresi?! Harika!Dialogue: 0,0:06:13.87,0:06:16.37,Main,,0,0,0,,Görebildiğim kadarıyla tamamen çimenle dolu!Dialogue: 0,0:06:18.83,0:06:21.17,Main,,0,0,0,,Ne kadar da sıkıcı bir yer burası.Dialogue: 0,0:06:21.41,0:06:23.38,Main,,0,0,0,,Burada birisi yaşıyor mudur acaba?Dialogue: 0,0:06:23.58,0:06:25.79,Main,,0,0,0,,Oley! Hey!Dialogue: 0,0:06:25.79,0:06:26.65,Main,,0,0,0,,Ben de!Dialogue: 0,0:06:32.22,0:06:36.16,Main,,0,0,0,,Şunlar yok mu... Hiçbir şey yokmuş gibi keşfedilmemiş toprağa dalıyorlar...Dialogue: 0,0:06:36.76,0:06:39.98,Main,,0,0,0,,Göründüğü üzere tehlike olmadığı çok belli.Dialogue: 0,0:06:45.75,0:06:47.14,Main,,0,0,0,,Ne oldu Choppe-?Dialogue: 0,0:06:53.56,0:06:54.80,Main,,0,0,0,,İnsan?Dialogue: 0,0:06:55.22,0:06:58.30,Main,,0,0,0,,Böyle pofuduk ve kıllı bir insan olamaz!Dialogue: 0,0:06:58.30,0:06:59.51,Main,,0,0,0,,Ayı bu!Dialogue: 0,0:07:03.06,0:07:06.03,Main,,0,0,0,,Çok uzun! Uzun bir ayı!Dialogue: 0,0:07:06.03,0:07:07.67,Main,,0,0,0,,Çok yüksek!Dialogue: 0,0:07:11.52,0:07:14.27,Main,,0,0,0,,Hey! Elma bu! Çok uzun!Dialogue: 0,0:07:14.27,0:07:16.24,Main,,0,0,0,,Yeme! Nefis!Dialogue: 0,0:07:17.28,0:07:20.24,Main,,0,0,0,,Diğer ağaçlarda aşırı uzunlar!Dialogue: 0,0:07:26.79,0:07:28.71,Main,,0,0,0,,Hey bakın! O bir ev mi?!Dialogue: 0,0:07:30.50,0:07:32.70,Main,,0,0,0,,Öyle görünüyor.Dialogue: 0,0:07:34.34,0:07:35.22,Main,,0,0,0,,Gidip bir bakalım!Dialogue: 0,0:07:42.10,0:07:43.35,Main,,0,0,0,,Akraban! Akraban!Dialogue: 0,0:07:43.35,0:07:45.39,Main,,0,0,0,,O bir geyik! Ben ren geyiğiyim!Dialogue: 0,0:08:00.31,0:08:04.69,Main,,0,0,0,,Ne kadar da uzun...Dialogue: 0,0:08:05.07,0:08:08.91,Main,,0,0,0,,Buradaki her şey neden bu kadar uzuun?Dialogue: 0,0:08:09.20,0:08:13.12,Main,,0,0,0,,Sadece onlara bakmak bile beni uzuuun yapacak gibi hissediyorum...Dialogue: 0,0:08:13.49,0:08:17.12,Main,,0,0,0,,Burası nasıl bir ada böyle?Dialogue: 0,0:08:17.12,0:08:19.39,Main,,0,0,0,,Merhaba! Rahatsız ediyorum!Dialogue: 0,0:08:19.39,0:08:21.04,Main,,0,0,0,,Öylece mi?!Dialogue: 0,0:08:21.04,0:08:24.85,Main,,0,0,0,,B-Bekle Luffy! Burası bahse varım adanın patronunun yaşadığı yerdir!Dialogue: 0,0:08:24.85,0:08:28.47,Main,,0,0,0,,Kesinlikle dehşet verici upuzun bir  canavar yılan-adamdır!Dialogue: 0,0:08:29.05,0:08:30.72,Main,,0,0,0,,Kimse yok burada.Dialogue: 0,0:08:32.47,0:08:35.85,Main,,0,0,0,,Hey! Luffy! Usopp! Zürafa buldum!Dialogue: 0,0:08:35.85,0:08:36.89,Main,,0,0,0,,Ne?!Dialogue: 0,0:08:42.94,0:08:45.07,Main,,0,0,0,,O bir zürafa değil...Dialogue: 0,0:08:45.07,0:08:47.99,Main,,0,0,0,,Uzun bir boynu var ama o bir at. Bir uzun-at...Dialogue: 0,0:08:47.99,0:08:49.23,Main,,0,0,0,,At mısın sen?Dialogue: 0,0:08:50.53,0:08:53.21,Main,,0,0,0,,Ne kadar da güzel bir at!Dialogue: 0,0:08:53.87,0:08:56.41,Main,,0,0,0,,Adı Shelly'miş! Bir dişi!Dialogue: 0,0:08:56.41,0:09:00.20,Main,,0,0,0,,Bu eyer burada birinin olduğunu gösterir...Dialogue: 0,0:09:01.75,0:09:03.07,Main,,0,0,0,,Ne oldu Luffy?Dialogue: 0,0:09:03.84,0:09:04.75,Main,,0,0,0,,Usopp.Dialogue: 0,0:09:05.13,0:09:08.47,Main,,0,0,0,,Şu iki bambu ağacını görüyor musun? Evet.Dialogue: 0,0:09:08.80,0:09:12.95,Main,,0,0,0,,Vay! Tepelerini göremiyorum! Nasıl bir uzunluk bu!Dialogue: 0,0:09:13.35,0:09:15.01,Main,,0,0,0,,Daha yakından bak...Dialogue: 0,0:09:16.14,0:09:16.85,Main,,0,0,0,,Tamam...Dialogue: 0,0:09:19.10,0:09:20.14,Main,,0,0,0,,Kaçıyor!Dialogue: 0,0:09:20.19,0:09:23.27,Main,,0,0,0,,Ne?! Bu bir başka uzun hayvan olmalı!Dialogue: 0,0:09:24.36,0:09:26.03,Main,,0,0,0,,Bambu ağaçları Luffy'e saldırıyor!Dialogue: 0,0:09:26.03,0:09:27.03,Main,,0,0,0,,H-Hey! İyi misin?!Dialogue: 0,0:09:28.49,0:09:30.61,Main,,0,0,0,,Bir bambuya kaybetmeyeceğim!Dialogue: 0,0:09:30.61,0:09:32.16,Main,,0,0,0,,Dikkatli ol Luffy!Dialogue: 0,0:09:32.20,0:09:36.56,Main,,0,0,0,,Gomu Gomu no Muchi! Dialogue: 0,0:09:32.20,0:09:36.56,Attack,,0,0,0,,Lastik-Lastik KırbaçDialogue: 0,0:09:40.87,0:09:42.85,Main,,0,0,0,,Tamam! Kazandın!Dialogue: 0,0:09:42.85,0:09:45.04,Main,,0,0,0,,Evet! Kestim onu!Dialogue: 0,0:09:45.40,0:09:47.64,Main,,0,0,0,,Sahibin nerede senin?Dialogue: 0,0:09:48.92,0:09:52.68,Main,,0,0,0,,Bilmiyor musun? Kulağa yalnız geliyor...Dialogue: 0,0:09:57.98,0:10:00.65,Main,,0,0,0,,Düşman olabilir! Orada kal ve saklan!Dialogue: 0,0:10:02.03,0:10:03.53,Main,,0,0,0,,Ne oldu?!Dialogue: 0,0:10:04.57,0:10:05.65,Main,,0,0,0,,Şey...Dialogue: 0,0:10:06.95,0:10:10.26,Main,,0,0,0,,...bir bambu ağacı kestim ve bir ruh ortaya çıktı!Dialogue: 0,0:10:16.13,0:10:18.86,Main,,0,0,0,,Gemimizin... gitmesi mi engellendi?Dialogue: 0,0:10:19.61,0:10:21.09,Main,,0,0,0,,Ne planlıyorlar?!Dialogue: 0,0:10:21.65,0:10:23.64,Thoughts,,0,0,0,,O az önce gördüğüm gemi...Dialogue: 0,0:10:24.53,0:10:26.33,Main,,0,0,0,,Siz de kimsiniz?!Dialogue: 0,0:10:26.99,0:10:28.83,Main,,0,0,0,,İstediğiniz dövüşse aşağı inin!Dialogue: 0,0:10:29.66,0:10:32.33,Main,,0,0,0,,Bizler, Foxy Korsanları'yız!Dialogue: 0,0:10:32.33,0:10:36.34,Main,,0,0,0,,Acele etmeyin! Tek istediğimiz... bir müsabaka!Dialogue: 0,0:10:38.96,0:10:40.17,Main,,0,0,0,,Ruh mu?Dialogue: 0,0:10:40.17,0:10:43.00,Main,,0,0,0,,Evet. Bambu ağacını kestikten sonra ortaya çıktı.Dialogue: 0,0:10:44.05,0:10:46.63,Main,,0,0,0,,Hey. Bir şey söyle.Dialogue: 0,0:10:48.80,0:10:50.85,Main,,0,0,0,,Tabii ki seni hatırlıyorum.Dialogue: 0,0:10:50.85,0:10:54.06,Main,,0,0,0,,Uzun zaman oldu. Nasılsınız çocuklar?Dialogue: 0,0:10:55.10,0:10:56.23,Main,,0,0,0,,Birinizin tanıdığı mı?Dialogue: 0,0:10:56.48,0:10:58.81,Main,,0,0,0,,Ben tanımıyorum. Ben de...Dialogue: 0,0:10:58.81,0:11:02.28,Main,,0,0,0,,Ah, yüzünüzü daha önce görmediğimi biliyordum.Dialogue: 0,0:11:02.28,0:11:04.45,Main,,0,0,0,,Ne acayip biri! Sen de kimsin yaşlı amca?!Dialogue: 0,0:11:04.66,0:11:11.33,Captions,,0,0,0,,Göçebe TonjitDialogue: 0,0:11:08.07,0:11:12.11,Main,,0,0,0,,Benim adım Tonjit. Teşekkürlerimi sunuyorum.Dialogue: 0,0:11:12.11,0:11:16.04,Main,,0,0,0,,Beni ayaklıklarımdan sizin attığınızı varsayıyorum?Dialogue: 0,0:11:16.04,0:11:17.37,Main,,0,0,0,,Ayaklıklar mı?Dialogue: 0,0:11:19.50,0:11:21.31,Main,,0,0,0,,Ah! Harbiden!Dialogue: 0,0:11:22.34,0:11:26.54,Main,,0,0,0,,Ama o kadar uzunlardı ki tepesini göremedik!Dialogue: 0,0:11:27.01,0:11:30.22,Main,,0,0,0,,Evet. En tepesinde de ben vardım!Dialogue: 0,0:11:30.55,0:11:34.64,Main,,0,0,0,,Ne? Yani sen bambu ağacını kestiğim için ortaya çıkan bir ruh değilsin,Dialogue: 0,0:11:34.64,0:11:37.94,Main,,0,0,0,,ayaklıkları kırıldığı için düşen bir yaşlı amca mısın?Dialogue: 0,0:11:38.15,0:11:41.23,Main,,0,0,0,,Neden o kadar uzun ayaklıkların üstündeydin ki zaten?Dialogue: 0,0:11:41.23,0:11:43.90,Main,,0,0,0,,Ayaklıklara her zaman düşkündüm,Dialogue: 0,0:11:43.90,0:11:49.70,Main,,0,0,0,,o yüzden bu adanın bambusunu kullanarak dünyanın en uzun ayaklıklarını yapmaya çalıştım!Dialogue: 0,0:11:49.82,0:11:54.66,Main,,0,0,0,,Üstlerine çıkmayı başardım ama  sonra da o kadar korktum ki inemedim!Dialogue: 0,0:11:54.66,0:11:56.16,Main,,0,0,0,,Aptal mısın yaşlı amca?!Dialogue: 0,0:11:56.16,0:11:58.50,Main,,0,0,0,,On yıldır oradayım!Dialogue: 0,0:11:58.50,0:11:59.67,Main,,0,0,0,,Gerçekten aptalsın!Dialogue: 0,0:11:59.92,0:12:02.71,Main,,0,0,0,,On yıldır ayaklıkların üstünde miydin?!Dialogue: 0,0:12:02.71,0:12:07.38,Main,,0,0,0,,Evet. Bu süre içinde bambu da sürekli uzamaya devam etti ve...Dialogue: 0,0:12:07.38,0:12:10.68,Main,,0,0,0,,inmemi daha da zor bir hale getirdi.Dialogue: 0,0:12:11.67,0:12:13.81,Main,,0,0,0,,Çok korkunçtu...Dialogue: 0,0:12:13.81,0:12:15.85,Main,,0,0,0,,On yıl sonra tek söyleyeceğin bu mu?!Dialogue: 0,0:12:16.14,0:12:20.35,Main,,0,0,0,,Bu adada ayaklıklar kadar uzun ağaçlar da var.Dialogue: 0,0:12:20.35,0:12:23.32,Main,,0,0,0,,Bulabildiğim meyvelerle hayatta kalabildim.Dialogue: 0,0:12:23.44,0:12:27.40,Main,,0,0,0,,Çok sıradan bir şeymiş gibi bahsediyor. Özellikle o kadar uzun zamana rağmen...Dialogue: 0,0:12:27.40,0:12:29.15,Main,,0,0,0,,Uzun demişken, yaşlı amca...Dialogue: 0,0:12:29.15,0:12:32.78,Main,,0,0,0,,Neden bu adada ki her şey bu kadar uzun?Dialogue: 0,0:12:32.99,0:12:37.04,Main,,0,0,0,,Dışardan gelen biri için öyle gözükebilir ama bunun bir sebebi var.Dialogue: 0,0:12:37.04,0:12:40.25,Main,,0,0,0,,Gördüğünüz gibi bu ada dev bir çimenlik arazi ile kaplı.Dialogue: 0,0:12:40.25,0:12:44.17,Main,,0,0,0,,Kısacası buradaki her şey eğlenceye hasret kaldıkları için uzunlar.Dialogue: 0,0:12:44.17,0:12:45.88,Main,,0,0,0,,Vay. Cidden dedi.Dialogue: 0,0:12:46.01,0:12:47.55,Main,,0,0,0,,Örneğin oradaki bir...Dialogue: 0,0:12:50.80,0:12:54.14,Main,,0,0,0,,..ooornitorenk. Uzattın sadece!Dialogue: 0,0:12:54.14,0:12:56.80,Main,,0,0,0,,O bir Daaaksund.Dialogue: 0,0:12:56.99,0:12:59.41,Main,,0,0,0,,Yırtıcı hayvanlar da var o yüzden dikkatli olun.Dialogue: 0,0:12:59.41,0:13:03.70,Main,,0,0,0,,Bak, o bir kar leoooparı. Seni ısırmasına izin verme!Dialogue: 0,0:13:03.70,0:13:04.85,Main,,0,0,0,,Leopar mı?!Dialogue: 0,0:13:05.91,0:13:08.17,Main,,0,0,0,,Neden sadece yana doğru uzun?!Dialogue: 0,0:13:08.49,0:13:12.45,Main,,0,0,0,,Evime gelin! Size borçluyum! Sizi ağırlayayım!Dialogue: 0,0:13:12.45,0:13:15.28,Main,,0,0,0,,Evet! Yemek! Evet!Dialogue: 0,0:13:15.76,0:13:20.32,Main,,0,0,0,,Bu köyde ziyaretçilere hayvanlarımızın sütünden ikram etmek bir gelenektir.Dialogue: 0,0:13:20.83,0:13:23.45,Main,,0,0,0,,Köy mü? Köy nerede?Dialogue: 0,0:13:23.45,0:13:24.65,Main,,0,0,0,,Ve hayvanların...Dialogue: 0,0:13:26.40,0:13:29.59,Main,,0,0,0,,Köy gitmiş! Hayvanlar da gitmiş!Dialogue: 0,0:13:29.59,0:13:33.70,Main,,0,0,0,,Hadi ama. Köyler on yılda bir öylece yok olmazlar.Dialogue: 0,0:13:34.45,0:13:36.16,Main,,0,0,0,,Ah, aslında...Dialogue: 0,0:13:36.16,0:13:40.45,Main,,0,0,0,,Şey, size sonra açıklarım. Şimdilik, sizi ağırlamama izin verin.Dialogue: 0,0:13:40.89,0:13:43.96,Main,,0,0,0,,Bir yerde biraz süt saklamış olmam lazım...Dialogue: 0,0:13:45.67,0:13:49.84,Main,,0,0,0,,Saklamak mı? On yıldır o ayaklıkların üstündeydin!Dialogue: 0,0:13:54.30,0:13:56.60,Main,,0,0,0,,Umarım bu peynir hoşunuza gider...Dialogue: 0,0:13:56.60,0:14:00.47,Main,,0,0,0,,Gözlerini kaçırma!  Onun on yıllık süt olduğu çok belli!Dialogue: 0,0:14:00.87,0:14:02.94,Main,,0,0,0,,Anlıyorum. Çok yazık.Dialogue: 0,0:14:03.65,0:14:05.81,Main,,0,0,0,,Kendi evinizde gibi davranın o zaman.Dialogue: 0,0:14:06.30,0:14:08.61,Main,,0,0,0,,Ha? Yaşlı amca o peynir yenilebilir mi?Dialogue: 0,0:14:08.61,0:14:09.97,Main,,0,0,0,,Deneme bile!Dialogue: 0,0:14:10.85,0:14:14.45,Main,,0,0,0,,Sıkıntı yok! Sadece on yıllık bir peynir!Dialogue: 0,0:14:14.45,0:14:18.75,Main,,0,0,0,,Sizin aksinize ben bu adada rahat bir yaşam sürüyorum,Dialogue: 0,0:14:18.75,0:14:21.29,Main,,0,0,0,,bu yüzden benim midem sizinkilerden farklı.Dialogue: 0,0:14:21.29,0:14:25.57,Main,,0,0,0,,Dürüst olmam gerekirse, günümüz çocukları çok zayıf...Dialogue: 0,0:14:27.68,0:14:29.98,Main,,0,0,0,,Doktor... çağırın...Dialogue: 0,0:14:29.98,0:14:32.13,Main,,0,0,0,,Sana söylemiştim aptal!Dialogue: 0,0:14:32.13,0:14:33.63,Main,,0,0,0,,Doktor! Doktor!Dialogue: 0,0:14:34.55,0:14:35.43,Main,,0,0,0,,B-Benim!Dialogue: 0,0:14:37.14,0:14:38.26,Main,,0,0,0,,Gıda zehirlenmesi.Dialogue: 0,0:14:38.26,0:14:39.22,Main,,0,0,0,,Besbelli!Dialogue: 0,0:14:40.47,0:14:42.06,Main,,0,0,0,,Çok komiksin yaşlı amca!Dialogue: 0,0:14:43.23,0:14:44.77,Main,,0,0,0,,Göçebe misiniz?Dialogue: 0,0:14:44.77,0:14:49.57,Main,,0,0,0,,Evet. Biz sürekli hareket eden gamsız göçebeleriz.Dialogue: 0,0:14:49.83,0:14:54.70,Main,,0,0,0,,Demek ki on yıl sonra köyün böyle ortadan kayboldu...Dialogue: 0,0:14:55.20,0:15:00.24,Main,,0,0,0,,Burası Long Ring Long Land adlı ada. Hoşgeldiniz.Dialogue: 0,0:15:00.55,0:15:04.36,Main,,0,0,0,,Burası teknik olarak halka şeklinde tek bir adaDialogue: 0,0:15:04.36,0:15:08.19,Main,,0,0,0,,ama deniz yüzünden on ayrı adaya ayrılmış durumda.Dialogue: 0,0:15:08.69,0:15:12.61,Main,,0,0,0,,Ama her yıl bir gün oldukça alçalırDialogue: 0,0:15:12.61,0:15:18.62,Main,,0,0,0,,ve bir kaç saat boyunca ada gerçek, tekli halini alır.Dialogue: 0,0:15:19.00,0:15:24.75,Main,,0,0,0,,Biz de bunu her üç yılda bir adadan adaya göç etmek için kullanırız.Dialogue: 0,0:15:26.09,0:15:29.98,Main,,0,0,0,,Yani sen köy taşındıktan sonra arkada mı kaldın?Dialogue: 0,0:15:30.84,0:15:33.76,Main,,0,0,0,,Tam bir aptalsın! Seni sevdim yaşlı amca!Dialogue: 0,0:15:33.76,0:15:36.07,Main,,0,0,0,,Eğer her adada üç yıl kalırlarsa,Dialogue: 0,0:15:36.07,0:15:40.27,Main,,0,0,0,,o zaman bu adaya kadar gelmeleri otuz yıllarını alır.Dialogue: 0,0:15:40.27,0:15:43.88,Main,,0,0,0,,O ayaklıkların üstünde mahsur kaldığın süreyi çıkarırsakDialogue: 0,0:15:43.88,0:15:46.73,Main,,0,0,0,,onları yaklaşık yirmi yıl daha göremeyeceksin...Dialogue: 0,0:15:47.16,0:15:48.86,Main,,0,0,0,,Sanırım öyle.Dialogue: 0,0:15:48.86,0:15:52.95,Main,,0,0,0,,Keşke bir aaatım olsaydı.Dialogue: 0,0:15:53.18,0:15:56.18,Main,,0,0,0,,Beş yıl içinde diğerlerine yetişebilirdim...Dialogue: 0,0:15:56.18,0:15:59.14,Main,,0,0,0,,Her yıl bir sonraki adaya geçerek...Dialogue: 0,0:15:59.14,0:16:01.12,Main,,0,0,0,,"Aaat" mı?Dialogue: 0,0:16:01.51,0:16:05.79,Main,,0,0,0,,Evet. Bu adadaki en güzel hayvanlar.Dialogue: 0,0:16:05.79,0:16:09.96,Main,,0,0,0,,Çimenli arazilerde zarif bir şekilde dört nala koşarlar...Dialogue: 0,0:16:10.13,0:16:14.43,Main,,0,0,0,,Bir adadan diğer adaya  göç etmek için kesinlikle gerekliler.Dialogue: 0,0:16:14.73,0:16:18.21,Main,,0,0,0,,Güçlüler ve ağır yükler taşıyabilirler.Dialogue: 0,0:16:18.21,0:16:20.56,Main,,0,0,0,,Yürüyerek göç edemem.Dialogue: 0,0:16:20.56,0:16:24.98,Main,,0,0,0,,Ben daha bir sonraki adaya geçemeden gelgit geri dönmüş olur.Dialogue: 0,0:16:24.98,0:16:26.65,Main,,0,0,0,,Gemi ile gidemez misin?Dialogue: 0,0:16:27.19,0:16:30.30,Main,,0,0,0,,Biz nasıl denize açılacağımızı bilmiyoruz.Dialogue: 0,0:16:30.30,0:16:33.03,Main,,0,0,0,,Hem burada bir Seyir Pusulası kullansaydık bile,Dialogue: 0,0:16:33.03,0:16:36.22,Main,,0,0,0,,çemberdeki bir sonraki adayı işaret etmezdi.Dialogue: 0,0:16:36.66,0:16:39.99,Main,,0,0,0,,On adanın hepsi aslında büyük tek bir ada sonuçta.Dialogue: 0,0:16:40.47,0:16:42.93,Main,,0,0,0,,Sadece burada yirmi yıl boyunca bekleyeceğim.Dialogue: 0,0:16:43.41,0:16:45.63,Main,,0,0,0,,Emin misin? Çok yalnız olacak...Dialogue: 0,0:16:47.04,0:16:49.09,Main,,0,0,0,,Ha? Bekle bir saniye!Dialogue: 0,0:16:49.62,0:16:52.13,Main,,0,0,0,,"Aaat" dediğiniz "at" mı?Dialogue: 0,0:16:53.01,0:16:55.89,Main,,0,0,0,,Ah evet! At! Bir tane at vardı!Dialogue: 0,0:17:01.19,0:17:05.27,Main,,0,0,0,,Ah! Shelly! Beni bekledin mi?!Dialogue: 0,0:17:05.53,0:17:10.23,Main,,0,0,0,,Ah Shelly! Çok şirinsin! Bu anılarımı canlandırıyor!Dialogue: 0,0:17:10.23,0:17:14.15,Main,,0,0,0,,Seni en son gördüğümden beri çok uzamışsın!Dialogue: 0,0:17:14.15,0:17:15.45,Main,,0,0,0,,Aferin kızıma!Dialogue: 0,0:17:15.45,0:17:19.58,Main,,0,0,0,,Bunca yıldır kendi başına yalnız kalmış olmalısın!Dialogue: 0,0:17:19.94,0:17:22.87,Main,,0,0,0,,Teşekkür ederim! Teşekkür ederim!Dialogue: 0,0:17:22.87,0:17:25.65,Main,,0,0,0,,Seni bir daha bırakmayacağım!Dialogue: 0,0:17:42.78,0:17:47.89,Main,,0,0,0,,Anladım, demek ki o at  bunca zamandır onu bekliyormuş...Dialogue: 0,0:17:47.89,0:17:49.65,Main,,0,0,0,,Çok iyi biri!Dialogue: 0,0:17:49.89,0:17:53.37,Main,,0,0,0,,Onu gerçekten çok seviyor olmalı!Dialogue: 0,0:17:57.99,0:18:02.25,Main,,0,0,0,,O at cidden çok hızlı! Ben de sürmek istiyorum!Dialogue: 0,0:18:02.25,0:18:04.67,Main,,0,0,0,,Gerçekten de çok zarif!Dialogue: 0,0:18:05.21,0:18:09.63,Main,,0,0,0,,Shelly. Bir sonraki alçak gelgit gününde beraber denizi geçelim!Dialogue: 0,0:18:10.30,0:18:12.09,Main,,0,0,0,,Yağmurlu günler de oldu değil mi?Dialogue: 0,0:18:12.09,0:18:14.26,Main,,0,0,0,,Karlı günler de oldu değil mi?Dialogue: 0,0:18:14.26,0:18:16.76,Main,,0,0,0,,Hepsini atlatıp beni beklediğin için sağol!Dialogue: 0,0:18:25.88,0:18:29.90,Flashbacks,,0,0,0,,Shelly... Gerçekten Tonjit-san'ı beklemekte ısrarcı mısın?Dialogue: 0,0:18:30.29,0:18:32.20,Flashbacks,,0,0,0,,Bütün arkadaşlarını bizimle beraber götüreceğiz...Dialogue: 0,0:18:32.20,0:18:33.60,Flashbacks,,0,0,0,,Gerçekten emin misin?Dialogue: 0,0:18:34.07,0:18:37.81,Flashbacks,,0,0,0,,Yirmi yedi yıl boyunca buraya geri dönmeyeceğizDialogue: 0,0:18:38.14,0:18:40.59,Flashbacks,,0,0,0,,ve Tonjit-san'ın da nerede olduğunu bilmiyoruz.Dialogue: 0,0:18:42.03,0:18:43.92,Flashbacks,,0,0,0,,Kendi başına kalacaksın!Dialogue: 0,0:18:44.24,0:18:46.54,Flashbacks,,0,0,0,,Beni dinle ve bizimle gel!Dialogue: 0,0:18:46.81,0:18:49.04,Flashbacks,,0,0,0,,İyice yaşa Shelly!Dialogue: 0,0:19:24.01,0:19:25.59,Main,,0,0,0,,Dur Shelly!Dialogue: 0,0:19:25.76,0:19:28.62,Main,,0,0,0,,Yüksek yerlerden korktuğumu biliyorsun!Dialogue: 0,0:20:02.34,0:20:03.34,Main,,0,0,0,,At!Dialogue: 0,0:20:03.87,0:20:04.90,Main,,0,0,0,,Yaşlı amca!Dialogue: 0,0:20:15.10,0:20:16.46,Main,,0,0,0,,Shelly!Dialogue: 0,0:20:16.77,0:20:19.40,Main,,0,0,0,,İyi misin?! Silah sesi duyduk!Dialogue: 0,0:20:27.32,0:20:28.74,Main,,0,0,0,,Bu ağ da ne?!Dialogue: 0,0:20:28.74,0:20:29.66,Main,,0,0,0,,Yaşlı amca!Dialogue: 0,0:20:33.79,0:20:36.39,Main,,0,0,0,,O at artık bana ait!Dialogue: 0,0:20:36.39,0:20:39.75,Main,,0,0,0,,Evet! Evet! O at artık patronun!Dialogue: 0,0:20:40.47,0:20:43.50,Main,,0,0,0,,Siz de kimsiniz?!Dialogue: 0,0:20:43.82,0:20:46.15,Main,,0,0,0,,Kim olduğumu mu soruyorsun?Dialogue: 0,0:20:46.60,0:20:48.67,Main,,0,0,0,,Çok kabalar!Dialogue: 0,0:20:52.08,0:20:55.12,Main,,0,0,0,,Bu yüzü tanımıyorsun gibi davranma!Dialogue: 0,0:20:55.65,0:20:58.50,Main,,0,0,0,,Yüzünü tanımıyorum! Seni döveceğim!Dialogue: 0,0:20:59.63,0:21:01.76,Main,,0,0,0,,B-Beni tanımıyorlar...Dialogue: 0,0:21:01.76,0:21:04.30,Main,,0,0,0,,Hayır! Patron! Canını sıkma!Dialogue: 0,0:21:04.30,0:21:07.06,Main,,0,0,0,,Bu bir yalan! Eminim öylesine söylüyor!Dialogue: 0,0:21:07.06,0:21:08.51,Main,,0,0,0,,Onu tanımasının imkanı yok.Dialogue: 0,0:21:10.22,0:21:12.10,Main,,0,0,0,,Gülmeyi kes Hamburg!Dialogue: 0,0:21:12.51,0:21:18.09,Main,,0,0,0,,Benim adım Foxy! İstediği her şeyi alan adamım!Dialogue: 0,0:21:19.33,0:21:21.27,Main,,0,0,0,,Öğrenin bunu sizi aptallar!Dialogue: 0,0:21:21.27,0:21:24.14,Main,,0,0,0,,Sadece bir at için neden bu kadar sinirleniyorsunuz ki?!Dialogue: 0,0:21:24.14,0:21:26.74,Main,,0,0,0,,Avlanmak eğlenceden başka bir şey değildir!Dialogue: 0,0:21:26.94,0:21:28.45,Main,,0,0,0,,Seni pislik!Dialogue: 0,0:21:28.74,0:21:30.28,Main,,0,0,0,,Gomu Gomu no...Dialogue: 0,0:21:30.45,0:21:31.87,Main,,0,0,0,,Bekle Hasır Şapka Luffy!Dialogue: 0,0:21:33.24,0:21:34.74,Main,,0,0,0,,Adımı nasıl biliyorsun?!Dialogue: 0,0:21:35.45,0:21:38.18,Main,,0,0,0,,Kim olduğunu tabii ki de biliyoruz!Dialogue: 0,0:21:38.75,0:21:42.03,Main,,0,0,0,,Ödül 100 milyon beli, Monkey D. LuffyDialogue: 0,0:21:42.03,0:21:44.71,Main,,0,0,0,,60 milyon beli, Roronoa Zoro.Dialogue: 0,0:21:45.17,0:21:48.77,Main,,0,0,0,,Sadece yedi kişi ile toplam 160 milyon...Dialogue: 0,0:21:48.77,0:21:49.97,Main,,0,0,0,,Oldukça etkileyici.Dialogue: 0,0:21:50.72,0:21:56.47,Main,,0,0,0,,Biz Foxy Korsanları siz Hasır Şapka tayfasına Davy Back Dövüşü'nde meydan okuyoruz!Dialogue: 0,0:21:56.90,0:22:01.19,Main,,0,0,0,,Deminden beri ne diyorsun sen?! Gel artık! Eğer dövüşmek istiyorsan dövüşelim!Dialogue: 0,0:22:02.62,0:22:06.42,Main,,0,0,0,,Bekle Luffy... Davy Back Dövüşü...Dialogue: 0,0:22:06.42,0:22:09.15,Main,,0,0,0,,Ah! Bu buranın yakınında gördüğümüz gemiyi açıklıyor!Dialogue: 0,0:22:11.76,0:22:14.00,Main,,0,0,0,,Ne tarafa döneceğiz?! Ben nereden bileyim?!Dialogue: 0,0:22:14.00,0:22:17.51,Main,,0,0,0,,Biri emir versin! Rotacı!  Yok!Dialogue: 0,0:22:17.51,0:22:19.46,Main,,0,0,0,,Kaptan! Yok!Dialogue: 0,0:22:20.33,0:22:23.50,Main,,0,0,0,,Hey Luffy! O oyun...!Dialogue: 0,0:22:23.50,0:22:26.17,Main,,0,0,0,,Yapma! Tayfamızı kaybedeceğiz!Dialogue: 0,0:22:26.59,0:22:28.05,Main,,0,0,0,,Ne oldu Usopp?!Dialogue: 0,0:22:28.05,0:22:30.97,Main,,0,0,0,,Oyunu kabul etmemen gerektiğini söylüyorum!Dialogue: 0,0:22:34.01,0:22:38.06,Main,,0,0,0,,Aptal! Söylediğini duydum Hasır Şapka Luffy!Dialogue: 0,0:22:38.06,0:22:40.30,Main,,0,0,660,,Az önce meydan okumayı açıkça kabul ettin!Dialogue: 0,0:22:40.07,0:22:41.23,Captions,,0,0,230,,Foxy Korsanları Gümüş Tilki Foxy Ödül: 24 Milyon BeliDialogue: 0,0:22:40.30,0:22:41.76,Main,,0,0,660,,Değil mi Porche-chan?!Dialogue: 0,0:22:42.02,0:22:43.36,Captions,,250,0,160,,Foxy Korsanları Dövüşçü PorcheDialogue: 0,0:22:41.76,0:22:44.23,Main,,0,0,660,,Evet Patron! Ben de duydum!Dialogue: 0,0:22:44.23,0:22:47.33,Main,,0,0,660,,Cidden şu anda vazgeçebileceğini düşünüyor musun?Dialogue: 0,0:22:47.86,0:22:49.55,Main,,0,0,0,,Vazgeçemezsin.Dialogue: 0,0:22:48.15,0:22:49.57,Captions,,220,0,300,,Foxy Korsanları Dövüşçü HamburgDialogue: 0,0:22:51.20,0:22:54.37,Main,,0,0,0,,Ne oldu? Sözünün arkasında durabilecek kadar adam değil misin?Dialogue: 0,0:22:54.62,0:22:55.78,Main,,0,0,0,,Öyleyim!Dialogue: 0,0:22:56.91,0:23:00.20,Main,,0,0,0,,Hemen ikna olma! Ama... at!Dialogue: 0,0:23:00.78,0:23:02.36,Main,,0,0,0,,Shelly...Dialogue: 0,0:23:02.36,0:23:04.79,Main,,0,0,0,,Sırtını çok sert vurdun! Kendini zorlama!Dialogue: 0,0:23:10.63,0:23:13.26,Main,,0,0,0,,Siz ikiniz! Çekilin oradan! Yaşlı amca!Dialogue: 0,0:23:15.22,0:23:19.31,Main,,0,0,0,,Shelly on yıl boyunca sadık bir şekilde beni bekledi! Ne cüretle!Dialogue: 0,0:23:19.68,0:23:22.60,Main,,0,0,0,,Bekle yaşlı amca! Onlar korsan!Dialogue: 0,0:23:24.69,0:23:26.65,Main,,0,0,0,,Davy Back Dövüşü mü?Dialogue: 0,0:23:26.73,0:23:32.81,Main,,0,0,0,,Evet! Dövüş iki kaptanın anlaştığı an başlar!Dialogue: 0,0:23:26.73,0:23:28.36,Note,,0,0,0,,"İtaatsiz"Dialogue: 0,0:23:32.81,0:23:35.61,Main,,0,0,0,,Biz konuştuğumuz sırada kaptanımız sizin kaptanınızDialogue: 0,0:23:35.61,0:23:38.62,Main,,0,0,0,,Monkey D. Luffy'e meydan okuyor!Dialogue: 0,0:23:39.10,0:23:42.53,Main,,0,0,0,,Meydan okumak mı? Neden öyle bir şey yapıyor ki?Dialogue: 0,0:23:42.53,0:23:44.87,Main,,0,0,0,,Eğer dövüş istiyorsan başlat bir tane!Dialogue: 0,0:23:44.87,0:23:48.17,Main,,0,0,0,,Hey, bilmiyor musun?Dialogue: 0,0:23:48.17,0:23:50.99,Main,,0,0,0,,Bu bir dövüş değil.  Davy Back Dövüşü bir korsan oyunu.Dialogue: 0,0:23:51.90,0:23:56.63,Main,,0,0,0,,Denizin bir yerinde korsanların cenneti denilenDialogue: 0,0:23:56.63,0:23:59.83,Main,,0,0,0,,Korsan Adası'nda doğduğu iddia edilen bir oyun.Dialogue: 0,0:24:00.54,0:24:05.85,Main,,0,0,0,,Birinci sınıf korsanlar elde edebilmek için, korsanlar birbirlerini yağmalarlar.Dialogue: 0,0:24:06.52,0:24:09.19,Main,,0,0,0,,Korsanlar birbirlerini mi yağmalıyor?! Evet.Dialogue: 0,0:24:09.19,0:24:12.57,Main,,0,0,0,,Bunu bile bilmeden bu kadar uzun süre hayatta kalabilmenize şaşırdım!Dialogue: 0,0:24:12.57,0:24:15.15,Main,,0,0,0,,Davy Back Dövüşü tayfa üyeleri aşırmakla ilgilidir!Dialogue: 0,0:24:15.65,0:24:17.62,Main,,0,0,0,,Her karşılaşmanın sonunda kazanan...Dialogue: 0,0:24:17.62,0:24:21.16,Main,,0,0,0,,karşı takımdan istediği tayfa üyesini seçebilir!Dialogue: 0,0:24:21.54,0:24:26.19,Main,,0,0,0,,Seçilen kişi yeni kaptanına  derhal bağlılık yemini etmelidir!Dialogue: 0,0:24:26.52,0:24:30.13,Main,,0,0,0,,Derinlerin korsanı, Davy Jones adına!Dialogue: 0,0:24:30.59,0:24:33.51,Main,,0,0,0,,Yani kaybedersen... tayfa üyesi mi kaybediyorsun?!Dialogue: 0,0:24:33.72,0:24:35.09,Main,,0,0,0,,Aynen öyle!Dialogue: 0,0:24:35.09,0:24:38.89,Main,,0,0,0,,Ayrıca... eğer düşman gemide istenen biri yoksa...Dialogue: 0,0:24:38.89,0:24:43.70,Main,,0,0,0,,Geminin canı olan, korsan bayraklarını tamamen kaybederler!Dialogue: 0,0:24:44.90,0:24:47.47,Main,,0,0,0,,Tehlikede olan şeyler tayfa üyeleri ve onur.Dialogue: 0,0:24:47.77,0:24:52.08,Main,,0,0,0,,Kazanırsan güçleniyorsun ama yenildiğinde kaybedeceklerin büyük.Dialogue: 0,0:24:52.62,0:24:54.40,Main,,0,0,0,,Ne kötü bir oyun.Dialogue: 0,0:24:54.40,0:24:57.46,Main,,0,0,0,,Bekle... Bu denizde karşılaştığımızDialogue: 0,0:24:57.46,0:25:02.24,Main,,0,0,0,,o düzenli bir tayfası  ve hatta kaptanı olmayan geminin...?Dialogue: 0,0:25:02.72,0:25:06.54,Main,,0,0,0,,Ha? Dişli Kurbağa Korsanları'nın gemisine mi denk geldiniz?!Dialogue: 0,0:25:06.54,0:25:10.00,Main,,0,0,0,,O gemi de daha önce oyunumuzun avı oldu!Dialogue: 0,0:25:10.00,0:25:13.14,Main,,0,0,0,,Bakın! Bunlar bizim yeni tayfa üyelerimiz!Dialogue: 0,0:25:13.14,0:25:15.56,Main,,0,0,0,,Evet! Yaşasın Foxy Korsanları!Dialogue: 0,0:25:15.93,0:25:19.02,Main,,0,0,0,,Ben o gördüğünüz geminin eski kaptanı!Dialogue: 0,0:25:19.34,0:25:21.46,Main,,0,0,0,,Eski doktoru! Eski rotacısı!Dialogue: 0,0:25:21.46,0:25:22.73,Main,,0,0,0,,Eski gemi ustası!Dialogue: 0,0:25:23.07,0:25:26.57,Main,,0,0,0,,Beş tane üç-bozukluk oyunu denedik ama hepsini kaybettik!Dialogue: 0,0:25:26.57,0:25:28.99,Main,,0,0,0,,On dört adamımız ve bayrağımız öylece alındı!Dialogue: 0,0:25:29.63,0:25:31.74,Main,,0,0,0,,Gemilerini terk eden bu kadar fazla insan olunca,Dialogue: 0,0:25:31.74,0:25:33.54,Main,,0,0,0,,bu daha çok bir birleşme sayılır!Dialogue: 0,0:25:33.54,0:25:34.53,Main,,0,0,0,,Evet!Dialogue: 0,0:25:36.20,0:25:37.73,Main,,0,0,0,,Konuşmak faydasız!Dialogue: 0,0:25:37.73,0:25:41.54,Main,,0,0,0,,Ama bu kadar saçma bir oyuna biz katılmayı asla kabul etmeyeceğiz!Dialogue: 0,0:25:42.04,0:25:45.51,Main,,0,0,0,,Aptal seni! Bu sıradan bir tayfa üyesinin karar verebileceği bir şey değil!Dialogue: 0,0:25:45.51,0:25:49.66,Main,,0,0,0,,Bu oyun sadece iki kaptan aralarında bir anlaşmaya varırlarsa başlar!Dialogue: 0,0:25:49.66,0:25:57.47,Main,,0,0,0,,Sevseniz de sevmeseniz de, kaptanınız kafasını sallasa bile bu oyunun içindesiniz!Dialogue: 0,0:25:58.85,0:26:00.59,Main,,0,0,0,,Aynen öyle Nami-san.Dialogue: 0,0:26:02.23,0:26:05.48,Main,,0,0,0,,Bu korsan dünyasının yazılı olmayan bir kuralıdır.Dialogue: 0,0:26:06.06,0:26:09.40,Main,,0,0,0,,Kaçarsak eğer dünyanın dört bir yanında alay konusu oluruz.Dialogue: 0,0:26:10.49,0:26:12.86,Main,,0,0,0,,Alay ederlerse ne olmuş?!Dialogue: 0,0:26:14.33,0:26:17.33,Main,,0,0,0,,Utanç içinde yaşamaktansa ölmeyi tercih ederim.Dialogue: 0,0:26:18.58,0:26:19.83,Main,,0,0,0,,Onun dediğinden.Dialogue: 0,0:26:20.04,0:26:21.87,Main,,0,0,0,,Siz ikiniz, bu da ne demek oluyor?!Dialogue: 0,0:26:23.41,0:26:26.88,Main,,0,0,0,,Boş ver. Erkekler böyle canlılardır.Dialogue: 0,0:26:27.13,0:26:29.72,Main,,0,0,0,,O zaman Luffy'i durdurmam lazım!Dialogue: 0,0:26:29.97,0:26:32.14,Main,,0,0,0,,Faydasız. Deneme bile.Dialogue: 0,0:26:32.14,0:26:33.98,Main,,0,0,0,,Kaptanlar dövüşün başladığını,Dialogue: 0,0:26:33.98,0:26:36.22,Main,,0,0,0,,aynı anda silah ateşleyerek işaret edecekler!Dialogue: 0,0:26:36.22,0:26:37.55,Main,,0,0,0,,Bekle ve...!Dialogue: 0,0:26:42.14,0:26:43.56,Main,,0,0,0,,O-Olamaz...!Dialogue: 0,0:26:44.90,0:26:45.90,Main,,0,0,0,,Kabul etti...Dialogue: 0,0:26:46.29,0:26:47.98,Main,,0,0,0,,Bana uyar.Dialogue: 0,0:26:48.58,0:26:49.81,Main,,0,0,0,,İlginç olacak gibi.Dialogue: 0,0:26:50.19,0:26:52.83,Main,,0,0,0,,Oyunu kabul etti!Dialogue: 0,0:27:03.33,0:27:05.92,Main,,0,0,0,,Salak! Salak! Salak!Dialogue: 0,0:27:05.92,0:27:07.59,Main,,0,0,0,,Neden kabul ettin ki?!Dialogue: 0,0:27:07.59,0:27:10.26,Main,,0,0,0,,Bunun ne kadar korkunç bir oyun olduğu hakkında hiçbir fikrin yok!Dialogue: 0,0:27:10.26,0:27:11.88,Main,,0,0,0,,Kaybetmeyiz biz de o zaman!Dialogue: 0,0:27:12.34,0:27:15.50,Main,,0,0,0,,Meydan okumamız resmi olarak kabul edildi!Dialogue: 0,0:27:15.50,0:27:19.06,Main,,0,0,0,,Evet! Kıçını tekmeleyeceğim!Dialogue: 0,0:27:19.85,0:27:21.85,Main,,0,0,0,,Yapsan iyi olur!Dialogue: 0,0:27:22.02,0:27:24.23,Main,,0,0,0,,Yapacağım, seni Yarık Kafa!Dialogue: 0,0:27:24.90,0:27:27.61,Main,,0,0,0,,Yarık Kafa mı...? Patron!Dialogue: 0,0:27:27.61,0:27:31.58,Main,,0,0,0,,Sen buna nasıl cüret edersin?!  Patronumuz hassas biridir!Dialogue: 0,0:27:31.58,0:27:34.79,Main,,0,0,0,,Camdan bir kalbi vardır. Ona ne kadar uymasa da.Dialogue: 0,0:27:36.66,0:27:39.04,Main,,0,0,0,,Hey! Sana gülme demedim mi?!Dialogue: 0,0:27:39.45,0:27:40.91,Main,,0,0,0,,Hey Luffy!Dialogue: 0,0:27:40.91,0:27:44.08,Main,,0,0,0,,At ve yaşlı adam hakkında düşünmek beni de sinirlendiriyor ama...!Dialogue: 0,0:27:44.55,0:27:46.54,Main,,0,0,0,,O siniri onları ezmeye kullan!Dialogue: 0,0:27:46.71,0:27:48.63,Main,,0,0,0,,Fazla hızlı ayağa kalktı!Dialogue: 0,0:27:48.63,0:27:49.85,Main,,0,0,0,,Bana bırak!Dialogue: 0,0:27:53.99,0:27:56.18,Main,,0,0,0,,Size bir ders vereceğim!Dialogue: 0,0:28:01.02,0:28:03.22,Main,,0,0,0,,Evet! Frankfurter'larınızı alın!Dialogue: 0,0:28:01.02,0:28:03.22,Note,,0,0,0,,Ç.N.: Frankfurter, ince uzun, klasik Alman sosis türüne verilen isimdir.Dialogue: 0,0:28:03.22,0:28:05.99,Main,,0,0,0,,Rom ve peynir! Bisküvi ve tuzlu et!Dialogue: 0,0:28:05.99,0:28:07.48,Main,,0,0,0,,Yakisoba da var!Dialogue: 0,0:28:05.99,0:28:07.48,Note,,0,0,0,,Yakisoba: Bir Japon yemeği.Dialogue: 0,0:28:07.78,0:28:11.48,Main,,0,0,0,,Açılış töreni başlıyor!  Herkes, sessiz olun! Sessiz olun!Dialogue: 0,0:28:11.48,0:28:13.82,Main,,0,0,0,,Sessiz olun! Sessiz olun! Kapayın çenenizi! Sessiz olun!Dialogue: 0,0:28:13.82,0:28:17.11,Main,,0,0,0,,Hadi! Karşılaşmaları duyalım! Tüm katılımcılar hazır olsun!Dialogue: 0,0:28:18.27,0:28:20.92,Main,,0,0,0,,Gerçekten eğlenceli şeyler dönüyor burada!Dialogue: 0,0:28:20.92,0:28:23.16,Main,,0,0,0,,Bunların hepsi Yarık Kafa'nın tayfa üyeleri mi?Dialogue: 0,0:28:23.16,0:28:25.22,Main,,0,0,0,,Vay canına! Çok fazlalar!Dialogue: 0,0:28:25.69,0:28:28.12,Main,,0,0,0,,Affedersiniz. Beş büyük boy yakisoba lütfen.Dialogue: 0,0:28:26.50,0:28:28.60,Captions,,0,560,180,,Pamuk ŞekerDialogue: 0,0:28:26.50,0:28:30.06,Captions,,350,0,400,,YakisobaDialogue: 0,0:28:28.58,0:28:30.06,Main,,0,0,0,,Hey, yaşlı amca!Dialogue: 0,0:28:31.59,0:28:34.54,Main,,0,0,0,,Tamam beyler! Sakin olun!Dialogue: 0,0:28:34.54,0:28:36.84,Main,,0,0,0,,Porche-chan! Seksi!Dialogue: 0,0:28:36.84,0:28:40.05,Main,,0,0,0,,Kaybetmekle alakalı bu üç kuralı açıklayacağım!Dialogue: 0,0:28:41.04,0:28:46.25,Main,,0,0,0,,İlk olarak, Davy Back Dövüşü'nde kaybedilen tüm tayfa üyeleri, korsan bayrakları ve diğer her şeyDialogue: 0,0:28:46.25,0:28:50.02,Main,,0,0,0,,sadece başka bir Davy Back Dövüşü ile geri alınabilir!Dialogue: 0,0:28:50.59,0:28:53.86,Main,,0,0,0,,İkinci, kazanan tarafından alınan her kişi...Dialogue: 0,0:28:53.86,0:28:57.49,Main,,0,0,0,,derhal o geminin kaptanına bağlılık yemini etmelidir!Dialogue: 0,0:28:58.01,0:29:02.33,Main,,0,0,0,,Üçüncü, eğer korsan bayrağınız elinizden alınırsa onu bir daha sergileyemezsiniz!Dialogue: 0,0:29:02.33,0:29:04.75,Main,,0,0,0,,Nami-san! Biraz pamuk şeker aldım!Dialogue: 0,0:29:04.75,0:29:08.08,Main,,0,0,0,,Bu konu hakkında nasıl bu kadar sakin olabiliyorsunuz?Dialogue: 0,0:29:09.54,0:29:12.04,Main,,0,0,0,,Hala ona mı sızlanıyorsun?Dialogue: 0,0:29:12.32,0:29:15.88,Main,,0,0,0,,Bu kuralları çiğneyenler onursuz korsanlar olarak kabul edilecekDialogue: 0,0:29:15.88,0:29:18.76,Main,,0,0,0,,ve Davy Jones'un Sandığı'na gönderilecek!Dialogue: 0,0:29:18.76,0:29:20.55,Main,,0,0,0,,Buna yemin ediyor musunuz?Dialogue: 0,0:29:20.55,0:29:22.35,Main,,0,0,0,,Yemin ediyorum! Yemin ediyorum!Dialogue: 0,0:29:28.00,0:29:32.55,Main,,0,0,0,,Burada, bu üç-bozukluk geleneksel oyunu...Dialogue: 0,0:29:33.50,0:29:36.38,Main,,0,0,0,,...Davy Jones'a adıyorum!Dialogue: 0,0:29:42.51,0:29:44.75,Main,,0,0,0,,Davy Jones da kim?Dialogue: 0,0:29:45.05,0:29:46.62,Main,,0,0,0,,Şeytan tarafından lanetlenen,Dialogue: 0,0:29:46.62,0:29:50.02,Main,,0,0,0,,denizlerin derinliklerinde bugüne kadar yaşadığı söylenen eski bir korsan.Dialogue: 0,0:29:50.02,0:29:52.39,Main,,0,0,0,,Denizin dibinde mi yaşıyor?!Dialogue: 0,0:29:52.39,0:29:53.90,Main,,0,0,0,,Efsane böyle diyor.Dialogue: 0,0:29:53.90,0:29:56.28,Main,,0,0,0,,Denize batan tüm gemiler ve hazinelerinDialogue: 0,0:29:56.28,0:29:59.44,Main,,0,0,0,,hepsi denilene göre onun gemisine, başka bir deyişle "sandığına" gider.Dialogue: 0,0:30:00.28,0:30:02.59,Main,,0,0,0,,Denizin dibi korkunç bir yer...Dialogue: 0,0:30:03.33,0:30:03.95,Main,,0,0,0,,Tatlı!Dialogue: 0,0:30:04.65,0:30:07.61,Main,,0,0,0,,Denize batan ve önüne gelen her şeyi kendinin yapanDialogue: 0,0:30:07.61,0:30:11.66,Main,,0,0,0,,Davy gibi, düşmanlarından istedikleri her şeyi aldıkları içinDialogue: 0,0:30:11.66,0:30:13.96,Main,,0,0,0,,korsanlar buna Davy Back diyorlar.Dialogue: 0,0:30:15.96,0:30:19.48,Main,,0,0,0,,Kaptan, kılıç ustası, rotacı, keskin nişancı,Dialogue: 0,0:30:19.48,0:30:21.56,Main,,0,0,0,,aşçı, doktor ve arkeolojist, ha?Dialogue: 0,0:30:21.97,0:30:25.56,Main,,0,0,0,,Tamam o zaman. Önce kimi alsam acaba?Dialogue: 0,0:30:26.04,0:30:27.86,Main,,0,0,0,,Sanırım onu alacağım!Dialogue: 0,0:30:30.70,0:30:31.86,Main,,0,0,0,,Kahretsin!Dialogue: 0,0:30:31.86,0:30:34.45,Main,,0,0,0,,Bizi çok berbat bir duruma soktun Luffy!Dialogue: 0,0:30:35.12,0:30:37.29,Main,,0,0,0,,Tek yapmamız gereken kazanmak!Dialogue: 0,0:30:37.58,0:30:39.00,Main,,0,0,0,,Hey! Bunu unuttunuz!Dialogue: 0,0:30:39.52,0:30:43.32,Main,,0,0,0,,Kadrolarınızı yazın ve parti düzenleyicimize verin!Dialogue: 0,0:30:43.87,0:30:46.65,Main,,0,0,0,,Kadronuzu bir kere belirlediniz mi geri dönüş yok!Dialogue: 0,0:30:46.94,0:30:50.24,Main,,0,0,0,,Hey, kaybedersek ne yapacağız?Dialogue: 0,0:30:50.24,0:30:53.07,Main,,0,0,0,,Bahse varım ilk olarak ben  Kaptan Usopp'u isteyecekler...Dialogue: 0,0:30:53.07,0:30:56.58,Main,,0,0,0,,Hayır bahse varım ben olacağım.  Sevimliyim çünkü...Dialogue: 0,0:30:57.05,0:31:02.00,Main,,0,0,0,,Şimdi iki takım tarafından da teslim edilen kadroları duyuracağım!Dialogue: 0,0:31:02.41,0:31:04.92,Main,,0,0,0,,Aslında benim "Yarışmada Olamam" hastalığım baş gösterdi...Dialogue: 0,0:31:02.41,0:31:07.35,Captions,,880,0,355,,1. Tur: Donut YarışıDialogue: 0,0:31:02.41,0:31:07.35,Captions,,0,850,350,,Yarışmacılar: Usopp, Nami,  Nico RobinDialogue: 0,0:31:04.92,0:31:07.85,Main,,0,0,0,,Bunu yapmayı ben de istemiyorum! Kabullen!Dialogue: 0,0:31:07.85,0:31:09.40,Main,,0,0,0,,Ayak bağı olayım deme!Dialogue: 0,0:31:08.35,0:31:13.00,Captions,,750,0,460,,2. Tur: Sersem HalkaDialogue: 0,0:31:08.35,0:31:13.00,Captions,,0,900,430,,Yarışmacılar: Zoro, Sanji, ChopperDialogue: 0,0:31:09.40,0:31:10.86,Main,,0,0,0,,Asıl sen olma!Dialogue: 0,0:31:10.86,0:31:13.82,Main,,0,0,0,,Elimden... geleni... yapacağım!Dialogue: 0,0:31:15.00,0:31:17.00,Main,,0,0,0,,Farketmez! Yapalım şunu!Dialogue: 0,0:31:14.02,0:31:17.70,Captions,,780,0,590,,3. Tur: DövüşDialogue: 0,0:31:14.02,0:31:17.70,Captions,,0,900,590,,Yarışmacı: Monkey D. LuffyDialogue: 0,0:31:17.70,0:31:20.62,Main,,0,0,0,,Bu yarışmada yorumcunuz olacak kişi ben, Foxy Korsanları'nınDialogue: 0,0:31:20.62,0:31:23.98,Main,,0,0,0,,parti düzenleyicisi Itomimizu!Dialogue: 0,0:31:24.19,0:31:28.01,Main,,0,0,0,,İlk olarak 1. Tur; Donut Yarışı!Dialogue: 0,0:31:29.96,0:31:32.58,Main,,0,0,0,,Donut Yarışı'nda kullanılacak olan botlar için kullanılması gereken malzemelerDialogue: 0,0:31:32.58,0:31:35.29,Main,,0,0,0,,iki kürek ve üç boş varil!Dialogue: 0,0:31:35.29,0:31:38.55,Main,,0,0,0,,Başka herhangi bir malzemenin kullanımı anında diskalifiye anlamına gelir!Dialogue: 0,0:31:38.55,0:31:40.93,Main,,0,0,0,,Bu gemi ustalarının kendilerini gösterecekleri yer!Dialogue: 0,0:31:43.15,0:31:46.91,Main,,0,0,0,,Zaman neredeyse doldu! Herkes hazır mı?Dialogue: 0,0:31:46.96,0:31:49.00,Main,,0,0,0,,Hasır Şapka takımından Rotacı Nami,Dialogue: 0,0:31:49.00,0:31:52.84,Main,,0,0,0,,Keskin Nişancı Usopp ve Arkeolog Robin!Dialogue: 0,0:31:52.84,0:31:55.59,Main,,0,0,0,,Sürecekleri bot ise Varil Kaplan!Dialogue: 0,0:31:55.67,0:31:58.73,Main,,0,0,0,,O turuncu saçlı kız çok ateşli!Dialogue: 0,0:31:58.73,0:32:01.46,Main,,0,0,0,,O koyu saçlı kızı tayfaya istiyorum!Dialogue: 0,0:32:01.46,0:32:03.50,Main,,0,0,0,,Diğer adama gerek yok! Evet. Onu boşverin.Dialogue: 0,0:32:04.01,0:32:07.71,Main,,0,0,0,,Oh! Son karşılaşmalar geldi!Dialogue: 0,0:32:08.51,0:32:10.33,Main,,0,0,0,,En üst nokta tabii ki de idolümüz,Dialogue: 0,0:32:10.33,0:32:13.31,Main,,0,0,0,,güçlü Foxy Takımı'ndan, Porche-chan'a gidiyor!Dialogue: 0,0:32:13.31,0:32:15.39,Main,,0,0,0,,Evet! Bana bırakın!Dialogue: 0,0:32:15.39,0:32:19.64,Main,,0,0,0,,Onunla beraber olan kılıçbalığı balıkadam Capote ve yıldız köpekbalığı Monda!Dialogue: 0,0:32:19.64,0:32:22.74,Main,,0,0,0,,Sürecekleri bot ise Tatlış Vagon!Dialogue: 0,0:32:24.18,0:32:26.74,Main,,0,0,0,,Bu çantada keklik olacak! Yapabilirsiniz!Dialogue: 0,0:32:27.16,0:32:29.79,Main,,0,0,0,,Bekle! Siz balık kullanıyorsunuz!Dialogue: 0,0:32:29.79,0:32:32.75,Main,,0,0,0,,Balıkların yasak olduğunu söyleyen bir kural yok!Dialogue: 0,0:32:32.89,0:32:35.10,Main,,0,0,0,,Yorumlamayı Güney Mavi SerçesiDialogue: 0,0:32:35.10,0:32:40.36,Main,,0,0,0,,çok ender olan Cik-Cik'in üstünde, gökyüzündeyken yapacağım!Dialogue: 0,0:32:42.52,0:32:44.73,Main,,0,0,0,,Bu batmayacak mı?! Sana söyledim...Dialogue: 0,0:32:45.11,0:32:47.24,Main,,0,0,0,,Ben gemi ustası değilim!Dialogue: 0,0:32:47.36,0:32:49.82,Main,,0,0,0,,Tamam! Yerlerinize!Dialogue: 0,0:00:26.30,0:00:31.85,OP11 Credits,,50,0,230,,Translation  FUNimationDialogue: 0,0:00:32.55,0:00:37.02,OP11 Credits,,450,0,280,,Soundtracking HaleeDialogue: 0,0:00:32.55,0:00:37.02,OP11 Credits,,0,450,350,,Infoboxes/Title Card  BernieCraneDialogue: 0,0:00:37.14,0:00:41.03,OP11 Credits,,0,100,420,,Editing FeesoDialogue: 0,0:00:42.51,0:00:47.12,OP11 Credits,,470,0,290,,Quality Checking  Alasta Galaxy 9000 Mr. LuffyDialogue: 0,0:01:02.50,0:01:06.47,OP11 Credits,,0,30,410,,Timing Galaxy 9000Dialogue: 0,0:00:04.03,0:00:08.12,Lyrics,,0,0,0,,♪ Sıkıntı yok! Hadi ilerleyelim...Dialogue: 0,0:00:08.37,0:00:11.59,Lyrics,,0,0,0,,...sürekli kalplerimizin içindeki güneşle. ♪Dialogue: 0,0:00:11.76,0:00:15.03,Lyrics,,0,0,0,,♪ Güç kenetli ellerimizden geçerken... ♪Dialogue: 0,0:00:15.18,0:00:18.68,Lyrics,,0,0,0,,♪ Dileklerimizi avuçlayalım. ♪Dialogue: 0,0:00:26.32,0:00:32.51,Lyrics,,0,0,0,,♪ Devasa dalgaları aşalım, güçlerimizi birleştirerek. ♪Dialogue: 0,0:00:33.85,0:00:40.33,Lyrics,,0,0,1,,♪ Heyecana doğru acele edelim...  bu bir başlama işareti. ♪Dialogue: 0,0:00:41.01,0:00:47.14,Lyrics,,0,0,0,,♪ İşte şimdi yelken açma zamanı... çapayı kaldıralım. ♪Dialogue: 0,0:00:47.99,0:00:55.00,Lyrics,,0,0,1,,♪ Gökkuşağı renkli rüzgarı kes ve maceralar denizine yönel. ♪Dialogue: 0,0:00:55.13,0:00:58.57,Lyrics,,0,0,0,,♪ Yaralarla dolu bir yolculuk olacak...Dialogue: 0,0:00:58.65,0:01:02.30,Lyrics,,0,0,0,,...ama en önemlisi de tam orada olacak. ♪Dialogue: 0,0:01:02.50,0:01:06.43,Lyrics,,0,0,0,,♪ Bir sıkışıklığa girsek bile önemi yok. ♪Dialogue: 0,0:01:06.50,0:01:08.38,Lyrics,,0,0,0,,♪ Çünkü seni koruyacağım. ♪Dialogue: 0,0:01:09.53,0:01:13.36,Lyrics,,0,0,0,,♪ Sıkıntı yok! Hadi ilerleyelim...Dialogue: 0,0:01:13.71,0:01:16.85,Lyrics,,0,0,0,,...sürekli kalplerimizin içindeki güneşle. ♪Dialogue: 0,0:01:17.23,0:01:20.35,Lyrics,,0,0,1,,♪ Eğer bir gün fırtına gelirse omuz omuza duralım...Dialogue: 0,0:01:20.46,0:01:24.23,Lyrics,,0,0,0,,...ve daha önceki ışığa bakalım ♪Dialogue: 0,0:01:24.72,0:01:27.97,Lyrics,,0,0,0,,♪ Hayallerimizin parçalarını toplarsak...Dialogue: 0,0:01:28.47,0:01:31.58,Lyrics,,0,0,0,,...geleceğe ulaşan bir harita olurlar. ♪Dialogue: 0,0:01:31.73,0:01:34.75,Lyrics,,0,0,0,,♪ O yüzden hep beraber aynı bayrak altında duralım...Dialogue: 0,0:01:35.22,0:01:40.48,Lyrics,,0,0,0,,...ve dileklerimizi avuçlayalım, hepimiz biriz. ♪