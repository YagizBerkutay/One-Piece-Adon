tyle: OP11 Credits,FOT-Greco Std B,34,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,95,100,1,0,1,2.2,0,2,0,0,0,1Style: Author,Impress BT,20.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0.7,0.7,9,10,10,10,1Style: Attack,Duality,35.0,&H0086ECFF,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1.4,1.6,7,20,20,15,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:01:50.08,0:01:51.97,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Kaşgarlı thx to onepace.netDialogue: 0,0:12:22.30,0:12:32.30,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Kaşgarlı thx to onepace.netDialogue: 0,0:24:33.05,0:24:35.95,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - Kaşgarlı thx to onepace.netDialogue: 0,0:01:50.08,0:01:51.97,Title,,0,0,420,,Donut Yarışı!Dialogue: 0,0:01:50.09,0:01:54.59,Main,,0,0,0,,Tamam! Herkes tekneleri ile meşgulken,  ben de yarışın nasıl çalıştığını açıklayacağım!Dialogue: 0,0:01:55.03,0:01:58.42,Main,,0,0,0,,Rota Long Ring Long Land'ın etrafında bir etaptan oluşacak!Dialogue: 0,0:01:58.42,0:02:01.71,Main,,0,0,0,,Kulağa kolay gelebilir ama kesinlikle değil!Dialogue: 0,0:02:02.49,0:02:06.05,Main,,0,0,0,,Bir takım tekneleri battığında anında oyundan çıkar!Dialogue: 0,0:02:06.05,0:02:08.84,Main,,0,0,0,,Ayrıca, ateşli silah, top, patlayıcı,Dialogue: 0,0:02:08.84,0:02:11.64,Main,,0,0,0,,kılıç veya herhangi bir şey tamamen serbest!Dialogue: 0,0:02:11.64,0:02:15.39,Main,,0,0,0,,Kim adaletsizlik hakkında şikayet ederse bir korsan olarak utanmalıdır!Dialogue: 0,0:02:16.89,0:02:18.59,Main,,0,0,0,,Porche-chan!Dialogue: 0,0:02:18.59,0:02:20.13,Main,,0,0,0,,Burun adamı batır!Dialogue: 0,0:02:20.34,0:02:21.51,Main,,0,0,0,,Ben mi?!Dialogue: 0,0:02:21.51,0:02:23.91,Main,,0,0,0,,Şimdi kazanmamız gerekiyor!Dialogue: 0,0:02:23.91,0:02:26.15,Main,,0,0,0,,Rakipleri batırmak serbest.Dialogue: 0,0:02:26.15,0:02:27.45,Main,,0,0,0,,Heyecanlanmaya başladım!Dialogue: 0,0:02:27.45,0:02:28.74,Main,,0,0,0,,Hiç şansımız var mı ki?Dialogue: 0,0:02:28.86,0:02:33.49,Main,,0,0,0,,Hey, dinle Usopp! Eğer bayanlara bir şey olursa seni doğrarım!Dialogue: 0,0:02:34.09,0:02:36.41,Main,,0,0,0,,Kesinlikle kazanacağız!Dialogue: 0,0:02:36.59,0:02:39.19,Main,,0,0,0,,Amanın, ne kadar da saçma konuşuyorlar.Dialogue: 0,0:02:39.19,0:02:43.26,Main,,0,0,0,,Bırak konuşsunlar Porche-chan. Onları üç dakikada batıracağız!Dialogue: 0,0:02:43.26,0:02:45.32,Main,,0,0,0,,Değil mi Monda?!Dialogue: 0,0:02:47.33,0:02:51.60,Main,,0,0,0,,Aptal! Kimse bizi bir geleneksel oyunda yenemedi!Dialogue: 0,0:02:53.46,0:02:56.50,Main,,0,0,0,,Sence bu yarış beş dakika sürer mi, Hamburg?Dialogue: 0,0:02:57.63,0:02:58.59,Main,,0,0,0,,Sürmez.Dialogue: 0,0:02:59.71,0:03:04.60,Main,,0,0,0,,Şimdi bu Daimi Pusula'ları alın böylece kaybolmazsınız!Dialogue: 0,0:03:06.31,0:03:07.22,Main,,0,0,0,,Kaybolmak mı?Dialogue: 0,0:03:08.33,0:03:11.70,Main,,0,0,0,,Adadan uzaklaşmak mı?  Neden böyle bir şey yapalım ki?Dialogue: 0,0:03:11.95,0:03:14.20,Main,,0,0,0,,İç hattan doğru en kısa olan rotayı kullanacağız!Dialogue: 0,0:03:14.20,0:03:16.12,Main,,0,0,0,,O kadar basit olacağını düşünmüyorum...Dialogue: 0,0:03:16.33,0:03:18.79,Main,,0,0,0,,Peki! Yerlerinize!Dialogue: 0,0:03:19.13,0:03:21.75,Main,,0,0,0,,Hazır!Dialogue: 0,0:03:20.44,0:03:22.54,Secondary,,0,0,650,,O kadar basit olamaz da ne demek?!Dialogue: 0,0:03:22.54,0:03:23.46,Main,,0,0,0,,Güven bana!Dialogue: 0,0:03:23.46,0:03:25.30,Main,,0,0,0,,Başladığımız gibi kıyıyı terk edin!Dialogue: 0,0:03:25.82,0:03:26.54,Main,,0,0,0,,Neden?!Dialogue: 0,0:03:26.80,0:03:27.70,Main,,0,0,0,,Benimsiniz.Dialogue: 0,0:03:29.57,0:03:31.12,Main,,0,0,0,,Donut!Dialogue: 0,0:03:32.21,0:03:33.69,Main,,0,0,0,,İçimde kötü bir his var!Dialogue: 0,0:03:33.69,0:03:35.00,Main,,0,0,0,,Tamam da neden?!Dialogue: 0,0:03:35.00,0:03:38.59,Main,,0,0,0,,İtin! İtin! İtin!Dialogue: 0,0:03:40.15,0:03:44.51,Main,,0,0,0,,Size bu teknenin var olmasının nedenini göstereceğiz!Dialogue: 0,0:03:48.35,0:03:50.35,Main,,0,0,0,,Olamaz! Çok geç kaldık!Dialogue: 0,0:03:50.35,0:03:51.10,Main,,0,0,0,,Bunlar da ne?Dialogue: 0,0:03:51.48,0:03:52.57,Main,,0,0,0,,Tuzak mı bu?Dialogue: 0,0:03:53.23,0:03:54.56,Main,,0,0,0,,N-Nami! Yapma...!Dialogue: 0,0:04:03.50,0:04:08.38,Main,,0,0,0,,İşte buradalar! Ana Kıyı Gemisi'nin kötü şöhretli Varil Mayınları!Dialogue: 0,0:04:13.52,0:04:15.17,Main,,0,0,0,,Sonra görüşürüz!Dialogue: 0,0:04:15.17,0:04:18.01,Main,,0,0,0,,Hemen batmayın ama! Biraz eğlendirin bizi!Dialogue: 0,0:04:22.23,0:04:25.72,Main,,0,0,0,,Capote! Balıkadam Karate'ni göster onlara!Dialogue: 0,0:04:25.72,0:04:26.18,Main,,0,0,0,,Tamam!Dialogue: 0,0:04:27.10,0:04:28.82,Main,,0,0,0,,Kaimen Wari! Dialogue: 0,0:04:27.10,0:04:28.82,Attack,,0,0,0,,Yüzey YarıcıDialogue: 0,0:04:32.61,0:04:34.43,Main,,0,0,0,,Teknemiz parçalandı!Dialogue: 0,0:04:36.76,0:04:38.55,Main,,0,0,0,,Dengemiz...!Dialogue: 0,0:04:39.01,0:04:39.80,Main,,0,0,0,,Al bunu!Dialogue: 0,0:04:40.01,0:04:41.93,Main,,0,0,0,,Hissatsu: Kaen Boshi! Dialogue: 0,0:04:40.01,0:04:41.93,Attack,,0,0,0,,Öldürücü: Alev YıldızıDialogue: 0,0:04:42.59,0:04:43.72,Main,,0,0,0,,İşlemez!Dialogue: 0,0:04:44.35,0:04:45.81,Main,,0,0,0,,Ocho Fleur!Dialogue: 0,0:04:44.35,0:04:45.81,Attack,,0,0,0,,Sekiz ÇiçekDialogue: 0,0:04:47.47,0:04:48.12,Main,,0,0,0,,Bu da ne?!Dialogue: 0,0:04:48.26,0:04:50.08,Main,,0,0,0,,Capote!Dialogue: 0,0:04:50.48,0:04:51.62,Main,,0,0,0,,Flip! Dialogue: 0,0:04:50.48,0:04:51.62,Attack,,0,0,0,,DöndürDialogue: 0,0:04:52.60,0:04:53.66,Main,,0,0,0,,Hayır!Dialogue: 0,0:04:54.36,0:04:56.11,Main,,0,0,0,,Evet! İşte şansımız!Dialogue: 0,0:04:56.11,0:04:59.03,Main,,0,0,0,,Usopp, yüz ve gemiyi ittir!Dialogue: 0,0:04:59.03,0:05:00.07,Main,,0,0,0,,Saçma sapan konuşma!Dialogue: 0,0:05:00.30,0:05:02.80,Main,,0,0,0,,Capote! Monda! Kendinize gelin!Dialogue: 0,0:05:02.80,0:05:04.03,Main,,0,0,0,,Çekin! Çekin!Dialogue: 0,0:05:04.03,0:05:06.70,Main,,0,0,0,,Hadi gidelim artık, Hamburg.Dialogue: 0,0:05:06.70,0:05:09.84,Main,,0,0,0,,Gidiyor muyuz? Sonunda zamanı geldi mi, Patron?Dialogue: 0,0:05:10.30,0:05:15.52,Main,,0,0,0,,Pekala! Şu anda liderliği elinde taşıyanlar şirin Tatlış Vagon!Dialogue: 0,0:05:15.52,0:05:17.28,Main,,0,0,0,,İkincilikte ise Varil Kaplan var.Dialogue: 0,0:05:17.56,0:05:20.14,Main,,0,0,0,,Evet! Usopp! Bir kadran kullan!Dialogue: 0,0:05:20.15,0:05:21.23,Main,,0,0,0,,A-Ah evet!Dialogue: 0,0:05:21.23,0:05:23.26,Main,,0,0,0,,Pekala! Bu Esinti Kadranı ile...!Dialogue: 0,0:05:25.36,0:05:27.25,Main,,0,0,0,,Kürek çekmek daha hızlı olur!Dialogue: 0,0:05:27.57,0:05:29.39,Main,,0,0,0,,Jet Kadranı'n yok mu?!Dialogue: 0,0:05:29.39,0:05:31.44,Main,,0,0,0,,Onları alması imkansız!Dialogue: 0,0:05:31.44,0:05:33.42,Main,,0,0,0,,Tayfa üyelerimizden biri tehlikede burada!Dialogue: 0,0:05:33.42,0:05:36.30,Main,,0,0,0,,Evet! Sorun bu işte!Dialogue: 0,0:05:36.30,0:05:41.97,Main,,0,0,0,,Eğer kaybedersek, kesinlikle önce beni alacaklar!Dialogue: 0,0:05:41.97,0:05:46.35,Main,,0,0,0,,Fazla şirinim, bunun olmasına izin veremem!Dialogue: 0,0:05:46.35,0:05:48.19,Main,,0,0,0,,Sen öyle san. Şimdi kürek çek.Dialogue: 0,0:05:52.11,0:05:54.80,Main,,0,0,0,,Robin! Kitap okuyarak ne yapıyorsun?!Dialogue: 0,0:05:54.80,0:05:55.70,Main,,0,0,0,,Ben de kürek çekiyorum.Dialogue: 0,0:05:55.70,0:05:59.32,Main,,0,0,0,,Ellerin çekiyor ama sen pek öyle görünmüyorsun.Dialogue: 0,0:05:59.32,0:06:00.85,Main,,0,0,0,,Evet, Robin...Dialogue: 0,0:06:00.85,0:06:03.50,Main,,0,0,0,,Eğer sıkı çalışmazsan sonun benim gibi olur...Dialogue: 0,0:06:03.88,0:06:05.46,Main,,0,0,0,,Sıkı çalışıyorum zaten.Dialogue: 0,0:06:05.46,0:06:08.07,Main,,0,0,0,,Düşündüğümden daha incesin.Dialogue: 0,0:06:09.79,0:06:14.23,Main,,0,0,0,,Bu şekilde direkt hedefe mi gitmeliyiz, yoksa onları mı batırmalıyız?Dialogue: 0,0:06:14.59,0:06:17.59,Main,,0,0,0,,Ara sıra hedef çizgisi boyunca yavaş yavaş seyahat etmeyi severim.Dialogue: 0,0:06:17.59,0:06:19.64,Main,,0,0,0,,Ama o kadına gününü göstermek istiyorum!Dialogue: 0,0:06:20.51,0:06:23.27,Main,,0,0,0,,Kazanmak artık benim için yeterli değil!Dialogue: 0,0:06:23.57,0:06:24.70,Main,,0,0,0,,Ne?!Dialogue: 0,0:06:25.12,0:06:27.62,Main,,0,0,0,,Bu nasıl? Harika, Robin!Dialogue: 0,0:06:27.79,0:06:29.54,Main,,0,0,0,,Seni hileci!Dialogue: 0,0:06:30.75,0:06:31.74,Main,,0,0,0,,Bırak!Dialogue: 0,0:06:32.37,0:06:34.38,Main,,0,0,0,,Çok yazık. Şimdiden farkına vardılar.Dialogue: 0,0:06:34.67,0:06:36.01,Main,,0,0,0,,Capote!Dialogue: 0,0:06:38.21,0:06:39.17,Main,,0,0,0,,Onlar...Dialogue: 0,0:06:39.36,0:06:44.11,Main,,0,0,0,,Hadi ilerlemeye devam edelim! Daha fazla öne geçmelerine izin veremeyiz!Dialogue: 0,0:06:44.34,0:06:47.60,Main,,0,0,0,,Sanırım onları batıracağım.Dialogue: 0,0:06:47.60,0:06:48.73,Main,,0,0,0,,Oh!Dialogue: 0,0:06:49.14,0:06:50.60,Main,,0,0,0,,Ahh!Dialogue: 0,0:06:51.07,0:06:55.88,Main,,0,0,0,,İlerdekiler rotadaki en büyük engel: Uzun Mercan ResifiDialogue: 0,0:06:55.88,0:07:01.51,Main,,0,0,0,,ve ilerisinde Uzun Burun ve onun yanında da Long Ring Girdabı!Dialogue: 0,0:07:01.51,0:07:03.93,Main,,0,0,0,,Bunları nasıl aşacaklar?! Ve...Dialogue: 0,0:07:03.93,0:07:05.68,Main,,0,0,0,,Oh! Yoksa o...?!Dialogue: 0,0:07:05.89,0:07:06.81,Main,,0,0,0,,Ne?Dialogue: 0,0:07:07.10,0:07:09.10,Main,,0,0,0,,Adanın üzerinde biri var!Dialogue: 0,0:07:11.31,0:07:13.11,Main,,0,0,0,,Bu "Tam Koşu" Hamburg'un üstünde,Dialogue: 0,0:07:13.11,0:07:17.31,Main,,0,0,0,,sonunda kendini gösteren... Engel Ustası,Dialogue: 0,0:07:17.31,0:07:21.11,Main,,0,0,0,,adaletten nefret eden büyük alçak; bizim patronumuz,Dialogue: 0,0:07:21.66,0:07:24.28,Main,,0,0,0,,"Gümüş Tilki" Foxy!Dialogue: 0,0:07:24.77,0:07:25.83,Main,,0,0,0,,Bu o!Dialogue: 0,0:07:26.19,0:07:28.50,Main,,0,0,0,,Aklıma çok fena bir fikir geldi!Dialogue: 0,0:07:29.67,0:07:31.53,Main,,0,0,0,,Yarış cidden kızışıyor!Dialogue: 0,0:07:31.53,0:07:34.41,Main,,0,0,0,,Uzun Mercan Resifi ilerideki rotayı tamamen engelliyor!Dialogue: 0,0:07:34.41,0:07:37.07,Main,,0,0,0,,Önde giden Porche-chan'ın Tatlış Vagon'u!Dialogue: 0,0:07:37.28,0:07:40.98,Main,,0,0,0,,Bak! Garip akıntılara sebep oluyor!Dialogue: 0,0:07:41.98,0:07:44.32,Main,,0,0,0,,Oraya öylece dalamayız...Dialogue: 0,0:07:44.48,0:07:48.11,Main,,0,0,0,,Iyy! Bu yarışın bu kadar uzun sürdüğüne inanamıyorum...Dialogue: 0,0:07:48.65,0:07:50.07,Main,,0,0,0,,Monda! Sana güveniyoruz!Dialogue: 0,0:07:50.95,0:07:54.60,Main,,0,0,0,,Ama karada müdahale etmeyi uman biri olduğunu unutmayalım:Dialogue: 0,0:07:54.60,0:07:58.12,Main,,0,0,0,,patronumuz, "Gümüş Tilki" Foxy!Dialogue: 0,0:07:58.29,0:08:01.58,Main,,0,0,0,,Neler yapmayı planlıyor acaba?!Dialogue: 0,0:08:03.69,0:08:06.73,Main,,0,0,0,,İşte! *Inari sushi ve *kitsune udon! Bedava!Dialogue: 0,0:08:06.73,0:08:08.70,Main,,0,0,0,,Cidden mi?! Teşekkürler! Leziz!Dialogue: 0,0:08:12.17,0:08:15.42,Main,,0,0,0,,Senin gibi bir aşçının bize katılmasını çok isteriz!Dialogue: 0,0:08:15.42,0:08:17.59,Main,,0,0,0,,Dönen kaşların çok tatlı!Dialogue: 0,0:08:18.33,0:08:22.31,Main,,0,0,0,,Ah! Belki de hemen Davy Back'lenmeliyim!Dialogue: 0,0:08:23.28,0:08:25.91,Main,,0,0,0,,Hey! Buraya biraz daha içki lazım!Dialogue: 0,0:08:25.91,0:08:27.91,Main,,0,0,0,,Ne kadar istiyorsan al!Dialogue: 0,0:08:27.91,0:08:29.25,Main,,0,0,0,,Teşekkürler!Dialogue: 0,0:08:29.89,0:08:33.42,Main,,0,0,0,,Bitir işlerini, Patron!  Oley! Artık sadece zaman meselesi!Dialogue: 0,0:08:33.42,0:08:34.93,Main,,0,0,0,,Vay vay, bu da ne?!Dialogue: 0,0:08:36.05,0:08:38.62,Main,,0,0,0,,Hey Nami ne oldu?! Kürek çek! Daha değil!Dialogue: 0,0:08:38.62,0:08:40.74,Main,,0,0,0,,Ama öne geçiyorlar!Dialogue: 0,0:08:40.74,0:08:42.95,Main,,0,0,0,,Daha değil dedim ya!Dialogue: 0,0:08:42.97,0:08:48.32,Main,,0,0,0,,Tatlış Vagon ilerleme şanslarını kullanıyor ve Uzun Mercan Resifi'ne dalıyorlar!Dialogue: 0,0:08:48.32,0:08:50.01,Main,,0,0,0,,Gidelim, Monda!Dialogue: 0,0:08:51.62,0:08:54.60,Main,,0,0,0,,Bekle! Amanın! Ne oluyor?!Dialogue: 0,0:08:54.60,0:08:55.60,Main,,0,0,0,,Monda!Dialogue: 0,0:08:57.73,0:08:59.15,Main,,0,0,0,,Ah... Geri geldiler.Dialogue: 0,0:08:59.15,0:09:01.86,Main,,0,0,0,,Vay! Tatlış Vagon geri gönderildi!Dialogue: 0,0:09:01.86,0:09:03.28,Main,,0,0,0,,Bu da neyin nesi böyle?!Dialogue: 0,0:09:03.65,0:09:04.95,Main,,0,0,0,,Hayır! Neden?!Dialogue: 0,0:09:05.36,0:09:08.54,Main,,0,0,0,,Gördün mü? Bu akıntılarda bir şeyler döndüğünü biliyordum.Dialogue: 0,0:09:10.01,0:09:12.09,Main,,0,0,0,,Peki! Hızı arttıralım!Dialogue: 0,0:09:12.09,0:09:13.05,Main,,0,0,0,,T-Tamam!Dialogue: 0,0:09:13.16,0:09:15.03,Main,,0,0,0,,Bir kere daha, Monda!Dialogue: 0,0:09:15.03,0:09:16.00,Main,,0,0,0,,Bu taraftan!Dialogue: 0,0:09:19.97,0:09:21.44,Main,,0,0,0,,N-Ne...?!Dialogue: 0,0:09:25.68,0:09:27.85,Main,,0,0,0,,Ahh! Geldi sonunda!Dialogue: 0,0:09:27.85,0:09:31.11,Main,,0,0,0,,Malum kişiden gelen, şeytanca bir müdahale!Dialogue: 0,0:09:31.27,0:09:32.79,Main,,0,0,0,,Sis perdesi...!Dialogue: 0,0:09:34.33,0:09:35.91,Main,,0,0,0,,Amanın!Dialogue: 0,0:09:38.06,0:09:41.93,Main,,0,0,0,,Operasyon Bembeyaz tamamen başarılı!Dialogue: 0,0:09:41.93,0:09:45.49,Main,,0,0,0,,Bakalım bu resif labirentinde yolunuzu körken bulabilecek misiniz!Dialogue: 0,0:09:45.90,0:09:47.36,Main,,0,0,0,,Başarılı mı?Dialogue: 0,0:09:50.23,0:09:51.53,Main,,0,0,0,,Nasıl...?!Dialogue: 0,0:09:52.65,0:09:56.23,Main,,0,0,0,,Geçtiler! Hiçbir sorun yaşamadan!  Bunu nasıl yaptılar?!Dialogue: 0,0:09:56.23,0:09:57.67,Main,,0,0,0,,Tahmin ettiğim gibi!Dialogue: 0,0:09:57.68,0:09:59.19,Main,,0,0,0,,Bu sırada Tatlış Vagon...Dialogue: 0,0:09:59.28,0:10:02.57,Main,,0,0,0,,Olamaz! ...tekrar geri gönderildi!Dialogue: 0,0:10:03.24,0:10:06.18,Main,,0,0,0,,Tekne kendi kendine ilerliyor! Ne oluyor?!Dialogue: 0,0:10:06.39,0:10:09.37,Main,,0,0,0,,Bu bir deniz akıntıları labirenti. Deniz akıntıları mı?Dialogue: 0,0:10:09.66,0:10:12.29,Main,,0,0,0,,Evet. İlerideki girdap yüzünden,Dialogue: 0,0:10:12.29,0:10:14.62,Main,,0,0,0,,bu resifde küçük girdaplardan oluşan,Dialogue: 0,0:10:14.62,0:10:16.67,Main,,0,0,0,,garip akıntılar oluşuyor.Dialogue: 0,0:10:16.67,0:10:19.25,Main,,0,0,0,,O yüzden ileriyi görmemize gerek yok!Dialogue: 0,0:10:20.16,0:10:24.26,Main,,0,0,0,,Doğru girişi seçtiğimiz sürece... akıntılar tekneyi taşıyacaktır!Dialogue: 0,0:10:24.26,0:10:28.30,Main,,0,0,0,,Muhteşem! İşte bu rotacımızın gücü!Dialogue: 0,0:10:28.30,0:10:29.92,Main,,0,0,0,,Oley!Dialogue: 0,0:10:30.36,0:10:32.68,Main,,0,0,0,,Kahretsin!Dialogue: 0,0:10:35.12,0:10:40.58,Main,,0,0,0,,Ama eğlenceleri kısa ömürlü! Mercan ormanının ötesindeki Long Ring!Dialogue: 0,0:10:40.74,0:10:42.99,Main,,0,0,0,,Usopp! Çıldırmayı bırak ve ateşle!Dialogue: 0,0:10:42.99,0:10:45.29,Main,,0,0,0,,Neyi?! Darbe!Dialogue: 0,0:10:45.74,0:10:50.03,Main,,0,0,0,,S-Sana bizde olmadığını söyledim! Yok! Yok! Öyle mi? O zaman bu ne?Dialogue: 0,0:10:51.20,0:10:52.75,Main,,0,0,0,,Sen, ne zaman...?!Dialogue: 0,0:10:53.36,0:10:56.81,Main,,0,0,0,,Çabuk! Hemen yapmazsan  girdap tarafından yutulacağız!Dialogue: 0,0:10:56.89,0:11:00.23,Main,,0,0,0,,- Benim için sıkıntı yok! - Benim omzum çünkü!Dialogue: 0,0:11:00.23,0:11:03.88,Main,,0,0,0,,Bu kadar sakin olmana şaşmamalı!Dialogue: 0,0:11:03.88,0:11:06.34,Main,,0,0,0,,Başından beri aklında bu vardı...Dialogue: 0,0:11:06.57,0:11:07.62,Main,,0,0,0,,Kahretsin!Dialogue: 0,0:11:08.98,0:11:10.85,Main,,0,0,0,,Varil Kaplan...Dialogue: 0,0:11:10.92,0:11:13.80,Main,,0,0,0,,Hayır, daha da fazlası! Uçuyorlar!Dialogue: 0,0:11:14.15,0:11:16.65,Main,,0,0,0,,Varil Kaplan mucizevi bir büyüklük ile öne geçiyor!Dialogue: 0,0:11:17.58,0:11:22.00,Main,,0,0,0,,Bu yenilmez Tatlış Vagon için yenilgi mi demek?!Dialogue: 0,0:11:22.16,0:11:24.25,Main,,0,0,0,,Onları biraz küçümsedik!Dialogue: 0,0:11:24.39,0:11:25.21,Main,,0,0,0,,Sana güveniyoruz!Dialogue: 0,0:11:26.65,0:11:27.65,Main,,0,0,0,,Combine! Dialogue: 0,0:11:26.65,0:11:27.65,Attack,,0,0,0,,BirleşDialogue: 0,0:11:28.19,0:11:30.66,Main,,0,0,0,,Two Fish Engine! Dialogue: 0,0:11:28.19,0:11:30.66,Attack,,0,0,0,,İki Balık MotoruDialogue: 0,0:11:31.33,0:11:33.20,Main,,0,0,0,,Hayır, daha kaybetmediler!Dialogue: 0,0:11:33.20,0:11:36.92,Main,,0,0,0,,Balık adam kası ve köpek balığı yüzgeci beraber motor hızlarını ikiye katlıyor!Dialogue: 0,0:11:36.92,0:11:40.77,Main,,0,0,0,,Mercanları ve sarsıntılı dalgaları çabucak geçerek arayı kapatıyorlar!Dialogue: 0,0:11:43.21,0:11:44.72,Main,,0,0,0,,Yarışın yarısı bitti!Dialogue: 0,0:11:44.72,0:11:47.80,Main,,0,0,0,,Bu sırada Varil Kaplan ümitsizce kürek çekiyor!Dialogue: 0,0:11:47.80,0:11:49.18,Main,,0,0,0,,Usopp, uyan!Dialogue: 0,0:11:50.68,0:11:52.68,Main,,0,0,0,,Neredeyim? Hemen kürek çekmeye başla!Dialogue: 0,0:11:53.08,0:11:55.16,Main,,0,0,0,,Kolun garip bir yöne doğru bükülmüş.Dialogue: 0,0:11:57.69,0:11:58.69,Main,,0,0,0,,O da ne?Dialogue: 0,0:11:58.86,0:12:01.09,Main,,0,0,0,,Bu bir rota işareti. Sağa gidin diyor.Dialogue: 0,0:12:01.19,0:12:03.48,Main,,0,0,0,,Tamam! Sağa gidiyoruz!Dialogue: 0,0:12:03.65,0:12:04.99,Main,,0,0,0,,Sanki buna kanarız da!Dialogue: 0,0:12:06.32,0:12:11.77,Main,,0,0,0,,Başarısız oldu! Patronumuzun 18. Taktiği, "Operasyon Yalan Söylemek"!Dialogue: 0,0:12:12.70,0:12:17.21,Main,,0,0,0,,Gerçekten zorlu!  Bu kız hiçbir şeye inanmıyor mu?!Dialogue: 0,0:12:17.21,0:12:18.85,Main,,0,0,0,,Kapa çeneni!Dialogue: 0,0:12:19.12,0:12:20.42,Main,,0,0,0,,Ağzı da bozuk!Dialogue: 0,0:12:21.04,0:12:25.50,Main,,0,0,0,,Yarış devam ediyor! Varil Kaplan hala önde!Dialogue: 0,0:12:27.88,0:12:31.33,Main,,0,0,0,,Bu su sütunları da ne?!Dialogue: 0,0:12:31.33,0:12:35.36,Main,,0,0,0,,Ayrıca gökyüzüne ulaşan uzun dalgaları da geçiyorlar!Dialogue: 0,0:12:35.36,0:12:36.89,Main,,0,0,0,,Doğa olayı mı?!Dialogue: 0,0:12:37.10,0:12:38.41,Main,,0,0,0,,Babaanne...Dialogue: 0,0:12:38.84,0:12:40.91,Main,,0,0,0,,Patro-, hayır, Babaanne...Dialogue: 0,0:12:40.98,0:12:44.19,Main,,0,0,0,,Evet... Sanırım artık işim bitti...Dialogue: 0,0:12:44.19,0:12:47.53,Main,,0,0,0,,Patronumuz üçüncü  fena numarasını ortaya çıkarıyor!Dialogue: 0,0:12:47.53,0:12:51.91,Main,,0,0,0,,Ah! Siz teknedekiler!  Lütfen yardım eder misiniz?!Dialogue: 0,0:12:51.91,0:12:56.25,Main,,0,0,0,,İnanılmaz! Tamamen yardıma muhtaç, hasta bir nineyi görmezden geldi!Dialogue: 0,0:12:56.25,0:12:59.18,Main,,0,0,0,,O kalpsiz mi, yoksa sadece kendisini mi önemsiyor?!Dialogue: 0,0:12:59.18,0:13:01.92,Main,,0,0,0,,Durum ne olursa olsun, Rotacı Nami'nin buzdan bir kalbi var!Dialogue: 0,0:13:01.92,0:13:06.30,Main,,0,0,0,,Çeneni kapar mısın artık?! Öyle saçmalıklara asla kanmam!Dialogue: 0,0:13:06.30,0:13:07.97,Main,,0,0,0,,Ağzı da bozuk!Dialogue: 0,0:13:11.15,0:13:12.93,Main,,0,0,0,,Bakın! Bitiş çizgisi!Dialogue: 0,0:13:15.39,0:13:17.77,Main,,0,0,0,,Bitiş çizgisi çok yakınlarında!Dialogue: 0,0:13:17.77,0:13:19.69,Main,,0,0,0,,Durun bakalım!Dialogue: 0,0:13:20.63,0:13:22.41,Main,,0,0,0,,Tatlış Vagon yetişti!Dialogue: 0,0:13:22.41,0:13:25.35,Main,,0,0,0,,1. Tur: Donut Yarışı!Dialogue: 0,0:13:25.70,0:13:28.77,Main,,0,0,0,,Kazanan kim olacak?!Dialogue: 0,0:13:30.88,0:13:32.15,Main,,0,0,0,,Dediğim gibi...Dialogue: 0,0:13:32.63,0:13:34.67,Main,,0,0,0,,Kes şunu! Sinir bozucusun!Dialogue: 0,0:13:35.73,0:13:39.48,Main,,0,0,0,, "Operasyon Sahte Bitiş Çizgisi"'nin bile farkına vardı !Dialogue: 0,0:13:39.48,0:13:41.64,Main,,0,0,0,,Zorlu! Gerçekten zorlu!Dialogue: 0,0:13:41.80,0:13:46.86,Main,,0,0,0,,Onun için bir sorum var! "İnanmak" ne demek?Dialogue: 0,0:13:46.86,0:13:47.96,Main,,0,0,0,,Umurumda değil!Dialogue: 0,0:13:47.96,0:13:51.86,Main,,0,0,0,,Ah çok geç! Kalbi çoktan kapandı! Tam bir kalpsiz!Dialogue: 0,0:13:52.21,0:13:54.07,Main,,0,0,0,,Gerçek bitiş çizgisi yakın.Dialogue: 0,0:13:54.07,0:13:57.82,Main,,0,0,0,,Daha fazla Darbe yok! Biliyorum!Dialogue: 0,0:13:58.06,0:14:02.94,Main,,0,0,0,,Bu sırada Porche-chan'ın takımı sahte bitiş çizgisinde durdu!Dialogue: 0,0:14:02.94,0:14:06.71,Main,,0,0,0,,Yarışa ne oldu? Hey! Herkes nerede?!Dialogue: 0,0:14:07.36,0:14:09.63,Main,,0,0,0,,Kalbinizin saflığı göz kamaştırıcı!Dialogue: 0,0:14:09.63,0:14:11.97,Main,,0,0,0,,Kandırıldınız! Dikkatini ver Porche-chan!Dialogue: 0,0:14:12.12,0:14:13.96,Main,,0,0,0,,Her yer aptal dolu!Dialogue: 0,0:14:13.96,0:14:17.35,Main,,0,0,0,,Eğer bunlara kaybedersek  o kadar utanırım ki yaşayamam!Dialogue: 0,0:14:17.35,0:14:19.73,Main,,0,0,0,,Tayfamızı da alacaklar! O daha kötü!Dialogue: 0,0:14:20.29,0:14:22.57,Main,,0,0,0,,Olamaz! Bu bitiş çizgisi sahte!Dialogue: 0,0:14:22.85,0:14:25.48,Main,,0,0,0,,Ne?! Kim böyle kötü bir şey yapabilir?!Dialogue: 0,0:14:25.48,0:14:26.15,Main,,0,0,0,,Dialogue: 0,0:14:26.73,0:14:31.07,Main,,0,0,0,,Varil Kaplan sonunda Uzun Bambu Burnu'na ulaştı!Dialogue: 0,0:14:31.39,0:14:34.31,Main,,0,0,0,,Bitiş çizgisi bunun hemen ardında! Bu son aşama!Dialogue: 0,0:14:35.08,0:14:37.41,Main,,0,0,0,,Evet! Bitiş çizgisini görebiliyorum!Dialogue: 0,0:14:37.58,0:14:39.00,Main,,0,0,0,,Durun!Dialogue: 0,0:14:39.43,0:14:41.72,Main,,0,0,0,,Ama bize yetişiyorlar!Dialogue: 0,0:14:41.72,0:14:43.38,Main,,0,0,0,,Onların hızına denk değiliz!Dialogue: 0,0:14:43.72,0:14:46.23,Main,,0,0,0,,İşte bu Usopp!  Şuradaki bambuyu indirebilir misin?!Dialogue: 0,0:14:46.23,0:14:46.97,Main,,0,0,0,,Bambu mu?!Dialogue: 0,0:14:47.47,0:14:48.59,Main,,0,0,0,,Tamam!Dialogue: 0,0:14:50.80,0:14:52.55,Main,,0,0,0,,Böyle mi?! Daha çok! Daha çok!Dialogue: 0,0:14:52.86,0:14:55.47,Main,,0,0,0,,Tam hız Capote! Monda!Dialogue: 0,0:14:55.47,0:14:57.89,Main,,0,0,0,,Onları batırmalıyız!Dialogue: 0,0:15:02.80,0:15:04.55,Main,,0,0,0,,Vay! Bingo!Dialogue: 0,0:15:05.89,0:15:08.04,Main,,0,0,0,,Hayır! Capote!Dialogue: 0,0:15:08.04,0:15:10.52,Main,,0,0,0,,Bunun bedelini ödeyecekler!Dialogue: 0,0:15:10.77,0:15:13.20,Main,,0,0,0,,Cutie Baton! Dialogue: 0,0:15:10.77,0:15:13.20,Attack,,0,0,0,,Tatlış AsaDialogue: 0,0:15:14.27,0:15:16.44,Main,,0,0,0,,O da ne? Çiçek büyüsü mü?Dialogue: 0,0:15:16.87,0:15:19.48,Main,,0,0,0,,Ohana Shuriken! Dialogue: 0,0:15:16.87,0:15:19.48,Attack,,0,0,0,,Çiçek Ninja YıldızıDialogue: 0,0:15:20.78,0:15:23.08,Main,,0,0,0,,Ah ninja yıldızı fırlatıyor... Dikkat edin!Dialogue: 0,0:15:25.28,0:15:26.99,Main,,0,0,0,,Olamaz! Teknede delik açıldı!Dialogue: 0,0:15:26.99,0:15:30.12,Main,,0,0,0,,Sıkıntı yok! Başarabiliriz! Bitiş çizgisi tam orada!Dialogue: 0,0:15:30.12,0:15:30.87,Main,,0,0,0,,Hemen gidelim!Dialogue: 0,0:15:31.12,0:15:35.92,Main,,0,0,0,,Davy Back Dövüşü'nün 1. Turu; Donut Yarışı...Dialogue: 0,0:15:36.41,0:15:40.15,Main,,0,0,0,,Bir sonuca varmak üzere!Dialogue: 0,0:15:40.26,0:15:43.73,Main,,0,0,0,,Monda, dayan!  Bizi yenmelerine izin veremeyiz!Dialogue: 0,0:15:44.85,0:15:48.42,Main,,0,0,0,,Onlarla hizalan! Bir şey yapmazsak kaybedeceğiz!Dialogue: 0,0:15:48.42,0:15:49.45,Main,,0,0,0,,Emredersin Patron!Dialogue: 0,0:15:50.33,0:15:53.56,Main,,0,0,0,,Nami-san! Robin-chan!Dialogue: 0,0:15:53.56,0:15:55.45,Main,,0,0,0,,Siz hızlı bayanlar çok güzelsiniz!Dialogue: 0,0:15:55.45,0:15:57.29,Main,,0,0,0,,Az daha kazanıyordunuz...Dialogue: 0,0:15:57.50,0:15:59.33,Main,,0,0,0,,N-Ne? Kazanıyoruz!Dialogue: 0,0:16:00.58,0:16:02.79,Main,,0,0,0,,Şimdilik! Ama bak!Dialogue: 0,0:16:02.92,0:16:07.13,Main,,0,0,0,,- Patronumuz orada! - Öyleyse ne olmuş?! Ne yapabilir ki şu anda?!Dialogue: 0,0:16:07.13,0:16:09.19,Main,,0,0,0,,Bizim patronumuz da senin gibi.Dialogue: 0,0:16:09.19,0:16:11.76,Main,,0,0,0,,Şeytan Meyvesi güçleri var.Dialogue: 0,0:16:14.11,0:16:15.71,Main,,0,0,0,,Noro-Noro Beam! Dialogue: 0,0:16:14.11,0:16:15.71,Attack,,0,0,0,,Yavaş-Yavaş IşınDialogue: 0,0:16:25.44,0:16:28.57,Main,,0,0,0,,Kazanan Tatlış Vagon!Dialogue: 0,0:16:28.57,0:16:34.96,Main,,0,0,0,,Davy Back Dövüşü'nün ilk turunu idolümüz Porche-chan kazandı!Dialogue: 0,0:16:34.96,0:16:36.95,Main,,0,0,0,,İşte böyle sizi pislikler!Dialogue: 0,0:16:36.95,0:16:39.12,Main,,0,0,0,,Amanın! Herkese teşekkür ederim!Dialogue: 0,0:16:39.12,0:16:42.87,Main,,0,0,0,,- Sen en iyisisin Porche-chan! - Kazanmam çok normal!Dialogue: 0,0:16:43.36,0:16:46.15,Main,,0,0,0,,Hadi şimdi kendimize bir üye alalım!Dialogue: 0,0:16:46.85,0:16:49.80,Main,,0,0,0,,Kimse Foxy Korsanları'nın dengi değildir!Dialogue: 0,0:16:54.30,0:16:55.23,Main,,0,0,0,,Ne...?Dialogue: 0,0:16:59.60,0:17:04.10,Main,,0,0,0,,Tamamdır! Tayfa üyelerinizden birini verin şimdi!Dialogue: 0,0:17:04.43,0:17:07.12,Main,,0,0,0,,İyi misiniz?! Yaralandınız mı?!Dialogue: 0,0:17:07.12,0:17:08.68,Main,,0,0,0,,Evet, iyiyiz.Dialogue: 0,0:17:09.00,0:17:10.99,Main,,0,0,0,,Ne oldu öyle?Dialogue: 0,0:17:10.99,0:17:12.66,Main,,0,0,0,,Ne oldu acaba...Dialogue: 0,0:17:12.66,0:17:16.09,Main,,0,0,0,,Biz de bunu bilmek istiyoruz! Biz cidden kaybettik mi?Dialogue: 0,0:17:16.41,0:17:20.44,Main,,0,0,0,,Kazanacağınızı sandım ama  bir anda yavaşladınız ve sizi geçtiler!Dialogue: 0,0:17:23.50,0:17:25.58,Main,,0,0,0,,Ortada garip bir şey yok!Dialogue: 0,0:17:25.58,0:17:28.04,Main,,0,0,0,,Bunların sebebi Noroma Fotonları!Dialogue: 0,0:17:28.04,0:17:30.80,Main,,0,0,0,,Hey pislik! Nami-san'lara ne yaptın?!Dialogue: 0,0:17:31.37,0:17:32.76,Main,,0,0,0,,Noroma Fotonları mı...?Dialogue: 0,0:17:33.10,0:17:36.31,Main,,0,0,0,,Şuana kadar olan hiçbir şeye benzemeyen bir tür tanecik.Dialogue: 0,0:17:37.35,0:17:39.36,Main,,0,0,0,,Bu ışığa dokunanlar--Dialogue: 0,0:17:39.36,0:17:41.36,Main,,0,0,0,,canlı olsun, sıvı olsun, gaz olsun--Dialogue: 0,0:17:41.70,0:17:44.50,Main,,0,0,0,,fiziksel olarak belli bir miktar hız kaybederDialogue: 0,0:17:44.50,0:17:47.30,Main,,0,0,0,,ve diğer tüm enerjilerden mahrum kalır.Dialogue: 0,0:17:47.69,0:17:49.82,Main,,0,0,0,,Anlamadım! Aptal mısın sen?!Dialogue: 0,0:17:49.94,0:17:52.78,Main,,0,0,0,,Bana hakaret etti... Olamaz! Patron!Dialogue: 0,0:17:52.86,0:17:55.74,Main,,0,0,0,,Ama böyle aptalca bir şey...Dialogue: 0,0:17:55.86,0:17:58.74,Main,,0,0,0,,...olamaz mı demek istiyorsun?Dialogue: 0,0:17:58.74,0:18:03.46,Main,,0,0,0,,Biliyor olman lazım. Böyle çocukça iddiaların bu sularda hiçbir önemi yok!Dialogue: 0,0:18:03.83,0:18:05.96,Main,,0,0,0,,Dokundukları her şey yavaşlar!Dialogue: 0,0:18:05.96,0:18:07.63,Main,,0,0,0,,İşte bu Noroma Fotonları'nın gücü!Dialogue: 0,0:18:07.63,0:18:10.21,Main,,0,0,0,,Ah işte şimdi anladım ne dediğini!Dialogue: 0,0:18:10.42,0:18:14.05,Main,,0,0,0,,Yavaş Yavaş Meyvesi'ni yedim ve vücudumla bu parçacıkları üretebilerekDialogue: 0,0:18:14.05,0:18:16.10,Main,,0,0,0,,"yavaş insan" oldum!Dialogue: 0,0:18:16.13,0:18:17.26,Main,,0,0,0,,Şu güce bakın!Dialogue: 0,0:18:20.64,0:18:22.68,Main,,0,0,0,,Havadaki top mermisi...!Dialogue: 0,0:18:23.18,0:18:24.80,Main,,0,0,0,,Noro-Noro Beam! Dialogue: 0,0:18:23.18,0:18:24.80,Attack,,0,0,0,,Yavaş-Yavaş Işın!Dialogue: 0,0:18:26.30,0:18:28.96,Main,,0,0,0,,Bu etki yaklaşık otuz saniye sürüyor.Dialogue: 0,0:18:28.96,0:18:33.15,Main,,0,0,0,,Sonrasında eski halini geri alacak, sanki hiçbir şey olmamış gibi.Dialogue: 0,0:18:36.11,0:18:38.20,Main,,0,0,0,,Gözlerinize inanamıyorsunuz değil mi? Bu--!Dialogue: 0,0:18:39.83,0:18:41.45,Main,,0,0,0,,Patron!Dialogue: 0,0:18:42.01,0:18:44.79,Main,,0,0,0,,Kahretsin! Biz buna mı kaybettik?!Dialogue: 0,0:18:45.26,0:18:48.88,Main,,0,0,0,,Demek ki bu oyun hakkında ilginç derecede emin olmalarının sebebi bu.Dialogue: 0,0:18:48.88,0:18:50.54,Main,,0,0,0,,Ne kadar da saçma bir güç...Dialogue: 0,0:18:50.54,0:18:55.27,Main,,0,0,0,,Şimdi anlıyor musunuz?! Siz kaybettiniz!Dialogue: 0,0:18:55.27,0:18:57.13,Main,,0,0,0,,1. Tur Donut Yarışı...Dialogue: 0,0:18:57.53,0:18:59.14,Main,,0,0,0,,bizim zaferimiz!Dialogue: 0,0:18:59.22,0:19:01.72,Main,,0,0,0,,Amanın! Çok da yakındınız oysa ki!Dialogue: 0,0:19:01.89,0:19:04.31,Main,,0,0,0,,1. Tur sonuçlandı!Dialogue: 0,0:19:04.31,0:19:07.23,Main,,0,0,0,,Şimdi de çok beklenen savaş ganimetleri!Dialogue: 0,0:19:07.23,0:19:10.25,Main,,0,0,0,,Karşı tayfadan bir tayfa üyesi çağırma zamanı!Dialogue: 0,0:19:19.36,0:19:22.70,Main,,0,0,0,,İlk olarak istediğim kişi...Dialogue: 0,0:19:23.49,0:19:24.20,Main,,0,0,0,,sensin!Dialogue: 0,0:19:24.53,0:19:27.22,Main,,0,0,0,,Geminin doktoru! Tony Tony Chopper!Dialogue: 0,0:19:27.95,0:19:28.92,Main,,0,0,0,,Ben mi?!Dialogue: 0,0:19:29.00,0:19:31.12,Main,,0,0,0,,Evet! Hemen onu buraya getirin!Dialogue: 0,0:19:31.38,0:19:33.09,Main,,0,0,0,,Olamaz! Chopper!Dialogue: 0,0:19:34.21,0:19:38.95,Main,,0,0,0,,Ne kadar da nadir bir yaratık! Düşündüğümden daha yumuşaksın!Dialogue: 0,0:19:38.95,0:19:42.04,Main,,0,0,0,,Ah Patron! Benimde dokunmama izin verin!Dialogue: 0,0:19:42.04,0:19:43.51,Main,,0,0,0,,Baş döndürecek kadar şirin!Dialogue: 0,0:19:43.68,0:19:45.08,Main,,0,0,0,,O bizim artık!Dialogue: 0,0:19:48.10,0:19:49.26,Main,,0,0,0,,Chopper!Dialogue: 0,0:19:51.32,0:19:54.10,Main,,0,0,0,,O pisliğin hedefi Chopper mıydı?Dialogue: 0,0:19:54.10,0:19:57.58,Main,,0,0,0,,Sanırım o cidden ender hayvanlar arasında en enderi...Dialogue: 0,0:19:57.58,0:19:59.20,Main,,0,0,0,,Şirin şeylere mi düşkün?Dialogue: 0,0:19:59.20,0:20:00.86,Main,,0,0,0,,Kürklere düşkündür belkide?Dialogue: 0,0:20:00.86,0:20:02.71,Main,,0,0,0,,Konuşacak zaman değil!Dialogue: 0,0:20:02.71,0:20:05.37,Main,,0,0,0,,Bu çok ciddi! Arkadaşımızı aldılar!Dialogue: 0,0:20:06.10,0:20:07.70,Main,,0,0,0,,Millet...Dialogue: 0,0:20:08.56,0:20:13.24,Main,,0,0,0,,Hey, Doktor Chopper. Artık benim tayfamın bir üyesisin.Dialogue: 0,0:20:13.62,0:20:17.21,Main,,0,0,0,,Bana bağlılık yemini etmelisin! Şimdi, bu maskeyi tak...Dialogue: 0,0:20:19.84,0:20:21.15,Main,,0,0,0,,Millet...!Dialogue: 0,0:20:22.01,0:20:25.67,Main,,0,0,0,,Kaybettiğimiz için çok üzgünüm Chopper...!Dialogue: 0,0:20:25.67,0:20:26.70,Main,,0,0,0,,Kahretsin!Dialogue: 0,0:20:28.56,0:20:30.73,Main,,0,0,0,,Bu cidden çok nadir!Dialogue: 0,0:20:31.10,0:20:34.06,Main,,0,0,0,,Harika! Konuşan bir ren geyiği!Dialogue: 0,0:20:34.69,0:20:36.23,Main,,0,0,0,,Hadi arkadaş olalım!Dialogue: 0,0:20:37.34,0:20:38.61,Main,,0,0,0,,Hey! Yoldaş!Dialogue: 0,0:20:42.91,0:20:44.24,Main,,0,0,0,,Millet!Dialogue: 0,0:20:44.91,0:20:48.87,Main,,0,0,0,,Sadece sizinle olabilmek için denize açıldım!Dialogue: 0,0:20:49.33,0:20:53.25,Main,,0,0,0,,İstemiyorum! B-Ben bunu istemiyorum!Dialogue: 0,0:20:53.42,0:20:58.09,Main,,0,0,0,,Luffy! Sadece sen beni  davet ettin diye denize açıldım!Dialogue: 0,0:20:58.09,0:21:00.51,Main,,0,0,0,,Bunlarla beraber gitmek istemiyorum...!Dialogue: 0,0:21:00.75,0:21:07.56,Main,,0,0,0,,İstemiyorum! Ben Hasır Şapka Korsanları'nın doktoru, Tony Tony Chopper'ım!Dialogue: 0,0:21:09.47,0:21:11.31,Main,,0,0,0,,İstemiyorum!Dialogue: 0,0:21:13.16,0:21:15.11,Main,,0,0,0,,Sızlanmayı bırak, Chopper!Dialogue: 0,0:21:15.81,0:21:17.32,Main,,0,0,0,,Sinir bozucusun!Dialogue: 0,0:21:18.05,0:21:19.16,Main,,0,0,0,,Zoro...Dialogue: 0,0:21:19.16,0:21:22.11,Main,,0,0,0,,Denize açılmaya karar veren sendin!Dialogue: 0,0:21:22.11,0:21:24.56,Main,,0,0,0,,Bir yerde öldüğün zaman kendin dışında suçlayabileceğin...Dialogue: 0,0:21:24.56,0:21:25.99,Main,,0,0,0,,kimse yok!Dialogue: 0,0:21:26.45,0:21:28.34,Main,,0,0,0,,Bu oyunu kabul ettik.Dialogue: 0,0:21:28.73,0:21:31.65,Main,,0,0,0,,Usopp'lar da, sen de elinizden gelenin en iyisini yaptınız!Dialogue: 0,0:21:32.84,0:21:36.38,Main,,0,0,0,,Korsan dünyasında o gözyaşlarına kimse merhamet etmez!Dialogue: 0,0:21:37.13,0:21:38.31,Main,,0,0,0,,Eğer adamsan...Dialogue: 0,0:21:38.88,0:21:41.47,Main,,0,0,0,,...kollarını sıva ve yarışmanın geri kalanını sessizce izle!Dialogue: 0,0:21:43.13,0:21:46.67,Main,,0,0,0,,Bunu nasıl dersin?! Onun hislerini bilmiyor musun?!Dialogue: 0,0:21:51.22,0:21:54.45,Main,,0,0,0,,Tamamdır! Benimle istediğinizi yapın!Dialogue: 0,0:21:55.73,0:21:56.77,Main,,0,0,0,,Chopper...Dialogue: 0,0:21:57.24,0:21:58.32,Main,,0,0,0,,Tamamdır!Dialogue: 0,0:21:58.32,0:22:01.09,Main,,0,0,0,,Vay! O kılıç ustası bir harika!Dialogue: 0,0:22:01.09,0:22:03.59,Main,,0,0,0,,Evet Zoro! Bitir işlerini!Dialogue: 0,0:22:03.59,0:22:05.24,Main,,0,0,0,,Chopper'ı geri al!Dialogue: 0,0:22:05.24,0:22:08.77,Main,,0,0,0,,Patron, bir sonrakinde onu alalım! Bu ren geyiği çok cesur!Dialogue: 0,0:22:08.77,0:22:10.66,Main,,0,0,0,,Hadi artık başlayalım şu ikinci tura.Dialogue: 0,0:22:11.01,0:22:13.33,Main,,0,0,0,,Çok duygulandırıcı! Gözlerim doldu!Dialogue: 0,0:22:13.73,0:22:16.25,Main,,0,0,0,,Evet. Daha iki tur var.Dialogue: 0,0:22:17.00,0:22:20.67,Main,,0,0,0,,Değerli acil durum yemeğimizi geri alacağız...Dialogue: 0,0:22:20.67,0:22:22.61,Main,,0,0,0,,Sanji! Sana güveniyoruz!Dialogue: 0,0:22:22.61,0:22:26.86,Main,,0,0,0,,Davy Back Dövüşü bir anda heyecan ile patlarken takas sona erdi!Dialogue: 0,0:22:27.22,0:22:30.20,Main,,0,0,0,,Ne? Bekle, Chopper ikinci turun üyesi.Dialogue: 0,0:22:30.20,0:22:32.56,Main,,0,0,0,,Ama onu aldılar. Haklısın.Dialogue: 0,0:22:33.29,0:22:34.98,Main,,0,0,0,,İşte bu, bu oyunun asıl heyecanı!Dialogue: 0,0:22:35.27,0:22:36.43,Main,,0,0,0,,Söylemiştik!Dialogue: 0,0:22:36.43,0:22:39.73,Main,,0,0,0,,Kadronuzu değiştiremezsiniz! Yer değiştirme yasak!Dialogue: 0,0:22:39.82,0:22:42.19,Main,,0,0,0,,Başka bir deyişle, 2. Tur Sersem Halka'daDialogue: 0,0:22:42.19,0:22:44.75,Main,,0,0,0,,sadece iki Hasır Şapka yarışmacısı kaldı!Dialogue: 0,0:22:44.75,0:22:47.39,Main,,0,0,0,,Foxy Takımı şimdiden avantajlı!Dialogue: 0,0:22:47.39,0:22:48.20,Main,,0,0,0,,Ne?!Dialogue: 0,0:22:48.58,0:22:50.83,Main,,0,0,0,,İstersen sen de geri çekilebilirsin.Dialogue: 0,0:22:50.83,0:22:53.41,Main,,0,0,0,,Hayır, asıl sen buyur, pislik.Dialogue: 0,0:22:53.74,0:22:57.13,Main,,0,0,0,,Onların bir takım halinde çalışacaklarına inanmakta zorlanıyorum...Dialogue: 0,0:22:57.48,0:22:59.25,Main,,0,0,0,,Ne dedin sen?! Kesin şunu!Dialogue: 0,0:22:59.59,0:23:03.31,Main,,0,0,0,,Şimdi Sersem Halka'nın kurallarını açıklayacağım!Dialogue: 0,0:23:03.31,0:23:05.47,Main,,0,0,0,,Bir saha ve iki hedef var!Dialogue: 0,0:23:05.47,0:23:07.48,Main,,0,0,0,,Topları onların içine atın ve kazanın!Dialogue: 0,0:23:07.48,0:23:10.20,Main,,0,0,0,,Ama, toplar sıradan toplar değiller!Dialogue: 0,0:23:10.20,0:23:11.58,Main,,0,0,0,,İnsanlar!Dialogue: 0,0:23:11.58,0:23:15.23,Main,,0,0,0,,İki takım da top olması için birini seçsin!Dialogue: 0,0:23:15.23,0:23:17.98,Main,,0,0,0,,Hanginiz top olacak?!Dialogue: 0,0:23:19.72,0:23:20.81,Main,,0,0,0,,İşte top işareti!Dialogue: 0,0:23:21.02,0:23:24.57,Main,,0,0,0,,Kendi kafana göre karar verme! Top sensin, Marimo!Dialogue: 0,0:23:25.03,0:23:28.97,Main,,0,0,0,,İşte burada! Onların giriş şarkıları!Dialogue: 0,0:23:28.97,0:23:32.16,Main,,0,0,0,,Sersem Halka'nın yenilmez seçkinleri!Dialogue: 0,0:23:32.16,0:23:36.04,Main,,0,0,0,,Evet! Onlar için kaybetmek imkansız!Dialogue: 0,0:23:38.08,0:23:38.96,Main,,0,0,0,,Ezin onları!Dialogue: 0,0:23:39.33,0:23:45.93,Main,,0,0,0,,Ünlü Sersem Canavarlar sahaya çıktı!Dialogue: 0,0:23:48.03,0:23:50.51,Main,,0,0,0,,Önde "Tam Koşu" Hamburg!Dialogue: 0,0:23:50.89,0:23:54.56,Main,,0,0,0,,Ondan sonraki de "Müdahale Makinesi" Pickles!Dialogue: 0,0:23:55.21,0:24:01.15,Main,,0,0,0,,En sondaki ise yarı balık adam yarı dev; wotan, Big Pan!Dialogue: 0,0:24:01.61,0:24:05.07,Main,,0,0,0,,Bu gerçekten canavar gibi bir yürüyüş!Dialogue: 0,0:24:05.07,0:24:08.53,Main,,0,0,0,,Peki, peki, peki!Dialogue: 0,0:24:11.65,0:24:12.78,Main,,0,0,0,,O da ne öyle?!Dialogue: 0,0:24:14.26,0:24:16.29,Main,,0,0,0,,O dev balık adam da ne?!Dialogue: 0,0:24:17.25,0:24:19.21,Main,,0,0,0,,Top işaretini onun üstüne koyuyorlar!Dialogue: 0,0:24:20.83,0:24:22.04,Main,,0,0,0,,Kazanın da görelim!Dialogue: 0,0:24:27.51,0:24:28.40,Main,,0,0,0,,Şikayetin var mı?Dialogue: 0,0:24:31.17,0:24:32.30,Main,,0,0,0,,Yok.Dialogue: 0,0:00:26.30,0:00:31.85,OP11 Credits,,50,0,230,,Translation  FUNimationDialogue: 0,0:00:32.55,0:00:37.02,OP11 Credits,,450,0,280,,Soundtracking HaleeDialogue: 0,0:00:32.55,0:00:37.02,OP11 Credits,,0,450,350,,Infoboxes/Title Card  BernieCraneDialogue: 0,0:00:37.14,0:00:41.03,OP11 Credits,,0,100,420,,Editing FeesoDialogue: 0,0:00:42.51,0:00:47.12,OP11 Credits,,470,0,290,,Quality Checking  Alasta Galaxy 9000 Mr. LuffyDialogue: 0,0:01:02.50,0:01:06.47,OP11 Credits,,0,30,410,,Timing Galaxy 9000Dialogue: 0,0:00:04.03,0:00:08.12,Lyrics,,0,0,0,,♪ Sıkıntı yok! Hadi ilerleyelim...Dialogue: 0,0:00:08.37,0:00:11.59,Lyrics,,0,0,0,,...sürekli kalplerimizin içindeki güneşle. ♪Dialogue: 0,0:00:11.76,0:00:15.03,Lyrics,,0,0,0,,♪ Güç kenetli ellerimizden geçerken... ♪Dialogue: 0,0:00:15.18,0:00:18.68,Lyrics,,0,0,0,,♪ Dileklerimizi avuçlayalım. ♪Dialogue: 0,0:00:26.32,0:00:32.51,Lyrics,,0,0,0,,♪ Devasa dalgaları aşalım, güçlerimizi birleştirerek. ♪Dialogue: 0,0:00:33.85,0:00:40.33,Lyrics,,0,0,1,,♪ Heyecana doğru acele edelim...  bu bir başlama işareti. ♪Dialogue: 0,0:00:41.01,0:00:47.14,Lyrics,,0,0,0,,♪ İşte şimdi yelken açma zamanı... çapayı kaldıralım. ♪Dialogue: 0,0:00:47.99,0:00:55.00,Lyrics,,0,0,1,,♪ Gökkuşağı renkli rüzgarı kes ve maceralar denizine yönel. ♪Dialogue: 0,0:00:55.13,0:00:58.57,Lyrics,,0,0,0,,♪ Yaralarla dolu bir yolculuk olacak...Dialogue: 0,0:00:58.65,0:01:02.30,Lyrics,,0,0,0,,...ama en önemlisi de tam orada olacak. ♪Dialogue: 0,0:01:02.50,0:01:06.43,Lyrics,,0,0,0,,♪ Bir sıkışıklığa girsek bile önemi yok. ♪Dialogue: 0,0:01:06.50,0:01:08.38,Lyrics,,0,0,0,,♪ Çünkü seni koruyacağım. ♪Dialogue: 0,0:01:09.53,0:01:13.36,Lyrics,,0,0,0,,♪ Sıkıntı yok! Hadi ilerleyelim...Dialogue: 0,0:01:13.71,0:01:16.85,Lyrics,,0,0,0,,...sürekli kalplerimizin içindeki güneşle. ♪Dialogue: 0,0:01:17.23,0:01:20.35,Lyrics,,0,0,1,,♪ Eğer bir gün fırtına gelirse omuz omuza duralım...Dialogue: 0,0:01:20.46,0:01:24.23,Lyrics,,0,0,0,,...ve daha önceki ışığa bakalım ♪Dialogue: 0,0:01:24.72,0:01:27.97,Lyrics,,0,0,0,,♪ Hayallerimizin parçalarını toplarsak...Dialogue: 0,0:01:28.47,0:01:31.58,Lyrics,,0,0,0,,...geleceğe ulaşan bir harita olurlar. ♪Dialogue: 0,0:01:31.73,0:01:34.75,Lyrics,,0,0,0,,♪ O yüzden hep beraber aynı bayrak altında duralım...Dialogue: 0,0:01:35.22,0:01:40.48,Lyrics,,0,0,0,,...ve dileklerimizi avuçlayalım, hepimiz biriz. ♪