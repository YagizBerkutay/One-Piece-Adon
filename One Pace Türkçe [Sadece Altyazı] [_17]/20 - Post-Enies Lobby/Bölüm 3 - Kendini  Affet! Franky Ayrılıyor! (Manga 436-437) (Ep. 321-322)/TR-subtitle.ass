0000000,0,0,0,0,100,100,0,0,1,2,0,2,10,10,10,1Style: Attack,Duality,40.0,&H00FFD388,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1,1,7,12,12,12,1Style: Author,Impress BT,20.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1,1,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:23.94,0:00:29.23,Credits,,0,0,0,,Translation Cornman @ Vegapunk FansubsDialogue: 0,0:00:34.11,0:00:37.70,Credits,,0,0,0,,Initial timing Hedi @ Vegapunk FansubsDialogue: 0,0:00:37.91,0:00:41.41,Credits,,0,0,0,,Timing Galaxy 9000Dialogue: 0,0:00:41.62,0:00:45.00,Credits,,0,0,0,,Quality checking SewilDialogue: 0,0:00:45.25,0:00:48.84,Credits,,0,0,0,,Editing SewilDialogue: 0,0:00:54.76,0:00:58.68,Credits,,0,0,0,,Soundtracking MaideV and HaleeDialogue: 0,0:01:00.14,0:01:03.93,Credits,,0,0,0,,Raw providing SOFCJ-RawsDialogue: 0,0:00:14.43,0:00:19.27,Rainbow Star lyrics,,0,0,0,,♪ Kobalt mavisi gökte süzülen bulutlar,...Dialogue: 0,0:00:24.57,0:00:29.25,Rainbow Star lyrics,,0,0,0,,...kayboldu ve yarın hepimizi sırılsıklam edecek. ♪Dialogue: 0,0:00:33.96,0:00:39.09,Rainbow Star lyrics,,0,0,0,,♪ Günbatımından önce sadece gülümsersek her şey iyi olacak. ♪Dialogue: 0,0:00:39.09,0:00:43.48,Rainbow Star lyrics,,0,0,0,,♪ Eğer isteğin buysa, sadece yapabilirsin... ♪Dialogue: 0,0:00:43.60,0:00:45.94,Rainbow Star lyrics,,0,0,0,,♪ Göğsünde bir büyü söyle. ♪Dialogue: 0,0:00:46.52,0:00:49.32,Rainbow Star lyrics,,0,0,0,,♪ Umutlarınız için... ♪Dialogue: 0,0:00:54.79,0:00:56.62,Rainbow Star lyrics,,0,0,0,,♪ Hızlı önsezimiz...Dialogue: 0,0:00:56.62,0:00:59.46,Rainbow Star lyrics,,0,0,0,,...gökkuşağı renkli müzik notalarında gösteriliyor. ♪Dialogue: 0,0:01:02.34,0:01:04.84,Rainbow Star lyrics,,0,0,0,,♪ Benimle gelmeyecek misin? ♪Dialogue: 0,0:01:04.84,0:01:06.68,Rainbow Star lyrics,,0,0,0,,♪ Bizler düşmüş,...Dialogue: 0,0:01:06.68,0:01:09.43,Rainbow Star lyrics,,0,0,0,,...ateşli oklarımızı senin hayallerine yollayacağız. ♪Dialogue: 0,0:01:42.77,0:01:44.61,Rainbow Star lyrics,,0,0,0,,♪ Hangi rengi eklemeliyiz...Dialogue: 0,0:01:44.61,0:01:47.45,Rainbow Star lyrics,,0,0,0,,...kobalt mavisine? ♪Dialogue: 0,0:01:52.87,0:01:57.55,Rainbow Star lyrics,,0,0,0,,♪ Gözlerinde yansıyan üzücü gerçeği yok et. ♪Dialogue: 0,0:01:57.88,0:02:02.80,Rainbow Star lyrics,,0,0,0,,♪ Tüylerimizi sıcaklıkla dolu bir şekilde kaldıralım. ♪Dialogue: 0,0:02:02.80,0:02:04.76,Rainbow Star lyrics,,0,0,0,,♪ Sürreal düşmüş melekler,...Dialogue: 0,0:02:04.76,0:02:07.64,Rainbow Star lyrics,,0,0,0,,...kalbimizden şarkı söylüyorlar. ♪Dialogue: 0,0:02:30.52,0:02:39.20,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - BloodOmen thx to onepace.netDialogue: 0,0:15:07.00,0:15:17.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - BloodOmen thx to onepace.netDialogue: 0,0:29:22.10,0:29:31.80,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - BloodOmen thx to onepace.netDialogue: 0,0:02:30.52,0:02:39.20,Title,,0,0,0,,Kendini  Affet! Franky Ayrılıyor!Dialogue: 0,0:02:41.18,0:02:44.56,Main,Zoro,0,0,0,,Usopp konusunda kararınızı verdiniz mi?Dialogue: 0,0:02:45.35,0:02:46.77,Main,Zoro,0,0,0,,Bu bir gurur meselesi...Dialogue: 0,0:02:47.12,0:02:48.18,Main,Luffy,0,0,0,,Biliyorum.Dialogue: 0,0:02:48.48,0:02:50.98,Main,Luffy,0,0,0,,Ne zamana kadar depresif kalacaksın?Dialogue: 0,0:02:50.98,0:02:52.09,Main,Sanji,0,0,0,,Kapa çeneni!Dialogue: 0,0:02:52.09,0:02:54.25,Main,Sanji,0,0,0,,Neden sadece çizilen tek kişi benim?Dialogue: 0,0:02:54.25,0:02:56.38,Main,Luffy,0,0,0,,Bence ilk ödüle göre ödülün gayet iyi.Dialogue: 0,0:02:57.74,0:03:00.78,Main,Sanji,0,0,0,,Bunun neresi benim?Dialogue: 0,0:03:00.78,0:03:01.97,Main,Zoro,0,0,0,,Aynı sana benziyor...Dialogue: 0,0:03:01.97,0:03:03.15,Secondary,Sanji,0,0,0,,Hangi kısmı benim lan?Dialogue: 0,0:03:03.15,0:03:04.62,Main,Sanji,0,0,0,,∆ □ x ∑ ≠ € җ Ө ☼Dialogue: 0,0:03:04.62,0:03:06.16,Main,Zoro,0,0,0,,Dediklerini anlamıyorum..Dialogue: 0,0:03:08.31,0:03:10.47,Main,Sanji,0,0,0,,Dünyadaki bütün kadınların alay konusu olacağım...Dialogue: 0,0:03:11.65,0:03:13.34,Main,Nami,0,0,0,,Tuzağa düştüm...Dialogue: 0,0:03:13.34,0:03:15.43,Main,Nami,0,0,0,,O bana bir magazin gazetecisi olduğunu söylemişti.Dialogue: 0,0:03:16.22,0:03:18.47,Main,Nami,0,0,0,,Fotoğrafta sevimli çıkmışım ama...Dialogue: 0,0:03:18.47,0:03:20.89,Main,Nami,0,0,0,,Sonuçta başıma konulan bir ödül var...Dialogue: 0,0:03:20.89,0:03:22.77,Main,Chopper,0,0,0,,Ben de korsanım!Dialogue: 0,0:03:22.77,0:03:24.86,Main,Chopper,0,0,0,,Gerçek bir erkek gibi savaştım!Dialogue: 0,0:03:24.86,0:03:27.13,Main,Chopper,0,0,0,,Bu 50 beli'ye itiraz etmeliyim!Dialogue: 0,0:03:27.13,0:03:29.39,Main,Luffy,0,0,0,,Boş ver, bir dahaki sefer elinden geleni yap olur!Dialogue: 0,0:03:29.39,0:03:31.06,Main,Mozu and Kiwi,0,0,0,,Acele edin!Dialogue: 0,0:03:31.47,0:03:33.11,Main,Luffy,0,0,0,,Hiçbir şey unutmayın!Dialogue: 0,0:03:33.11,0:03:35.48,Main,Luffy,0,0,0,,Gemi ve Franky gelir gelmez hemen kalkış yapacağız.Dialogue: 0,0:03:35.84,0:03:37.98,Main,Chopper,0,0,0,,Luffy, Sanji hareket etmiyor.Dialogue: 0,0:03:37.98,0:03:40.44,Main,Zoro,0,0,0,,Sadece o kıvırcık adama takılma.Dialogue: 0,0:03:40.44,0:03:43.66,Main,Chimney,0,0,0,,Şimdiden gidiyor musunuz, korsan ablalar?Dialogue: 0,0:03:44.97,0:03:47.49,Main,Marine,0,0,0,,İstisnalar arasındaki istisnalar, öyle değil mi?Dialogue: 0,0:03:47.91,0:03:52.87,Main,Marine,0,0,0,,Böyle küçük bir mürettebatın hepsinin arananlar listesinde olması...Dialogue: 0,0:03:53.41,0:03:56.63,Main,Marine,0,0,0,,Toplam ödül 600 milyonun üzerinde.Dialogue: 0,0:03:57.12,0:03:58.42,Main,Marine,0,0,0,,Bu arada...Dialogue: 0,0:03:58.93,0:04:01.20,Main,Marine,0,0,0,,Bu Kara Bacak denilen adam...Dialogue: 0,0:04:01.20,0:04:02.84,Main,Marine,0,0,0,,Neden fotoğrafı yok?Dialogue: 0,0:04:04.09,0:04:05.09,Main,Attach,0,0,0,,Bu...Dialogue: 0,0:04:05.09,0:04:07.22,Main,Attach,0,0,0,,Ben çekmiştim, ama...Dialogue: 0,0:04:07.22,0:04:09.48,Main,Attach,0,0,0,,Filme baktığımda şaşırdım...Dialogue: 0,0:04:09.48,0:04:11.27,Main,Attach,0,0,0,,Resim bu...Dialogue: 0,0:04:11.54,0:04:13.81,Main,Attach,0,0,0,,Garip bir şeye dönüştü..!Dialogue: 0,0:04:15.15,0:04:17.27,Main,Marine,0,0,0,,Kameranın lens kapağını...Dialogue: 0,0:04:18.07,0:04:19.59,Main,Marine,0,0,0,,...çıkardın mı peki?Dialogue: 0,0:04:22.05,0:04:24.17,Main,Mozu or Kiwi,0,0,0,,Abi!Dialogue: 0,0:04:24.17,0:04:26.24,Main,Mozu or Kiwi,0,0,0,,Onları çağırdık!Dialogue: 0,0:04:34.57,0:04:37.45,Main,Mozu or Kiwi,0,0,0,,Abi, nerelerdesin?Dialogue: 0,0:04:37.45,0:04:38.45,Main,Iceburg,0,0,0,,Geldiler mi?Dialogue: 0,0:04:39.08,0:04:41.41,Main,Luffy,0,0,0,,Oh! Orada kocaman bir şey var!Dialogue: 0,0:04:41.41,0:04:42.52,Main,Chopper,0,0,0,,O mu acaba?Dialogue: 0,0:04:42.52,0:04:44.42,Main,Luffy,0,0,0,,Hey! Biz geldik, Franky!Dialogue: 0,0:04:44.42,0:04:45.78,Main,Luffy,0,0,0,,Lütfen bize gemiyi ver!Dialogue: 0,0:04:45.78,0:04:47.34,Main,Luffy,0,0,0,,Oh! Buz amca!Dialogue: 0,0:04:47.34,0:04:48.34,Main,Iceburg,0,0,0,,Geldiniz he...Dialogue: 0,0:04:48.34,0:04:50.35,Main,Iceburg,0,0,0,,Ne yazık ki, Franky buralarda değil...Dialogue: 0,0:04:50.35,0:04:51.99,Main,Iceburg,0,0,0,,Ama, gemi tamamlandı.Dialogue: 0,0:04:51.99,0:04:53.58,Main,Iceburg,0,0,0,,Ben onun yerine size göstereceğim.Dialogue: 0,0:04:55.21,0:04:57.17,Main,Iceburg,0,0,0,,Bu gemi muhteşem.Dialogue: 0,0:04:57.17,0:05:01.40,Main,Iceburg,0,0,0,,Muhteşem planları gördüğümde gözlerim şok oldu; her denizde seyahat edebilecek bir gemi bu.Dialogue: 0,0:05:02.14,0:05:04.80,Main,Iceburg,0,0,0,,Bu gemiyle beraber dünyanın sonuna seyahat etmek artık bir hayal olmayacak.Dialogue: 0,0:05:04.80,0:05:06.58,Main,Luffy,0,0,0,,Acele et ve göster bize!Dialogue: 0,0:05:06.58,0:05:07.66,Main,Chopper,0,0,0,,Lütfen!Dialogue: 0,0:05:08.12,0:05:10.91,Main,Iceburg,0,0,0,,Bu Franky'nin mesajıydı, Hasır Şapka.Dialogue: 0,0:05:10.91,0:05:13.50,Main,Iceburg,0,0,0,,Eğer bir gün korsanlar kralı olacaksa...Dialogue: 0,0:05:16.38,0:05:19.20,Main,Iceburg,0,0,0,,Bu canavarlar kralını sürmelisiniz!Dialogue: 0,0:05:21.30,0:05:22.32,Main,Nami,0,0,0,,İnanılmaz!Dialogue: 0,0:05:22.32,0:05:23.60,Main,Sanji,0,0,0,,Bu...?Dialogue: 0,0:05:25.36,0:05:26.37,Main,Robin,0,0,0,,Anladım.Dialogue: 0,0:05:27.12,0:05:29.60,Main,Luffy,0,0,0,,Oh! Çok büyük ve havalı!Dialogue: 0,0:05:30.02,0:05:31.77,Main,Luffy,0,0,0,,Çok fazla yerden kaçabiliriz!Dialogue: 0,0:05:31.77,0:05:34.14,Main,Chopper,0,0,0,,Oh! Gerçekten bize bunu mu vereceksiniz?Dialogue: 0,0:05:35.95,0:05:37.82,Main,Zoro,0,0,0,,Merry'nin en az 2 katı!Dialogue: 0,0:05:37.82,0:05:39.63,Main,Nami,0,0,0,,Ne büyük bir yelken!Dialogue: 0,0:05:39.63,0:05:40.63,Main,Nami,0,0,0,,Bu bir yelkenli mi?Dialogue: 0,0:05:40.72,0:05:42.70,Main,Sanji,0,0,0,,Bana mutfağı göster! Mutfağı!Dialogue: 0,0:05:43.04,0:05:44.81,Main,Robin,0,0,0,,Muhteşem bir gemi!Dialogue: 0,0:05:44.81,0:05:46.98,Main,Robin,0,0,0,,Acaba geminin burnundaki şey bir çicek mi?Dialogue: 0,0:05:46.98,0:05:49.95,Main,Iceburg,0,0,0,,Bariz olarak, o bir aslan.Dialogue: 0,0:05:49.95,0:05:52.12,Main,Luffy,0,0,0,,İçi bile muhteşem!Dialogue: 0,0:05:52.33,0:05:53.87,Main,Luffy,0,0,0,,Çimden güvertesi var!Dialogue: 0,0:05:53.87,0:05:54.83,Main,Luffy,0,0,0,,Çok iyi hissettiriyor!Dialogue: 0,0:05:54.83,0:05:56.51,Main,Chopper,0,0,0,,Bir kaydırak!Dialogue: 0,0:05:56.94,0:05:58.71,Main,Robin,0,0,0,,Bahçesi bile var.Dialogue: 0,0:05:59.13,0:06:00.42,Main,Zoro,0,0,0,,Rahatlamak için çok iyi.Dialogue: 0,0:06:00.96,0:06:02.72,Main,Sanji,0,0,0,,Mutfak nerede?Dialogue: 0,0:06:03.26,0:06:06.40,Main,Nami,0,0,0,,O devasa yelkeniyle gerçekten çok iyi bir hareket kabiliyetine sahip olmalı!Dialogue: 0,0:06:06.40,0:06:08.59,Main,Iceburg,0,0,0,,Buna "Brigantin Yelkeni" denir.Dialogue: 0,0:06:09.15,0:06:13.12,Main,Iceburg,0,0,0,,Bir yelkenli, insanların hayal güçlerinin ötesinde seyahat edebilen bir gemidir.Dialogue: 0,0:06:13.12,0:06:15.52,Main,Iceburg,0,0,0,,Bir yelkenli, rotacının emrine göre yaşar ve ölür..Dialogue: 0,0:06:17.01,0:06:19.11,Main,Iceburg,0,0,0,,Becerilerimi coşturacağım! Elimden gelenin en iyisini yapacağım!Dialogue: 0,0:06:19.13,0:06:20.71,Main,Nami,0,0,0,,Ben de bir göz atmak istiyorum.Dialogue: 0,0:06:22.23,0:06:25.30,Main,Sanji,0,0,0,,Rüyamda gördüğüm kilitli buzdolabı da var!Dialogue: 0,0:06:25.30,0:06:27.24,Main,Sanji,0,0,0,,Devasa bir fırın bile var!Dialogue: 0,0:06:27.24,0:06:28.79,Main,Sanji,0,0,0,,Franky, teşekkür ederiz!Dialogue: 0,0:06:28.79,0:06:31.16,Main,Sanji,0,0,0,,Bu gemi harbi en iyisi!Dialogue: 0,0:06:31.84,0:06:33.85,Main,Luffy,0,0,0,,Hey, Buz amca.Dialogue: 0,0:06:33.85,0:06:35.34,Main,Luffy,0,0,0,,Franky nerede?Dialogue: 0,0:06:35.34,0:06:36.54,Main,Luffy,0,0,0,,Ona teşekkür etmek istiyorum.Dialogue: 0,0:06:37.87,0:06:40.17,Main,Iceburg,0,0,0,,Görüşüne göre o seni görmek istemiyor.Dialogue: 0,0:06:41.21,0:06:44.05,Main,Iceburg,0,0,0,,Onu tayfana davet edeceksin, değil mi?Dialogue: 0,0:06:44.05,0:06:44.96,Main,Luffy,0,0,0,,Evet.Dialogue: 0,0:06:44.96,0:06:46.41,Main,Luffy,0,0,0,,İyi anladın he.Dialogue: 0,0:06:46.41,0:06:49.22,Main,Luffy,0,0,0,,Onu marangozum olarak seçtim!Dialogue: 0,0:06:49.45,0:06:50.81,Main,Iceburg,0,0,0,,Bu sorun olabilir.Dialogue: 0,0:06:50.81,0:06:52.41,Main,Luffy,0,0,0,,O istemiyor mu?Dialogue: 0,0:06:52.41,0:06:53.71,Main,Iceburg,0,0,0,,Tam tersi.Dialogue: 0,0:06:53.71,0:06:57.41,Main,Iceburg,0,0,0,,Yüz yüze davet edilseydi reddedemezdi.Dialogue: 0,0:06:57.41,0:06:59.07,Main,Iceburg,0,0,0,,Bu yüzden saklanıyor.Dialogue: 0,0:06:59.07,0:07:03.94,Main,Iceburg,0,0,0,,Evet, belki de gerçek hisleri sizinle birlikte denize açılmaya yöneliktir.Dialogue: 0,0:07:03.94,0:07:09.05,Main,Iceburg,0,0,0,,Bu rüyalarının gemisine ne kadar önem verdiğini iyice anlamışsınızdır.Dialogue: 0,0:07:09.05,0:07:12.08,Main,Chopper,0,0,0,,Oh! Burada akvaryum mu var?Dialogue: 0,0:07:12.08,0:07:14.53,Main,Nami,0,0,0,,Akvaryum mu? İnanılmaz!Dialogue: 0,0:07:15.33,0:07:18.79,Main,Iceburg,0,0,0,,Franky, gerçekten tüm kalbiyle hepinize bağlı.Dialogue: 0,0:07:19.35,0:07:24.12,Main,Iceburg,0,0,0,,Ancak o her zaman bu adada kalmayı bir görev olarak düşünmüştü.Dialogue: 0,0:07:24.12,0:07:25.32,Main,Luffy,0,0,0,,Görev?Dialogue: 0,0:07:25.32,0:07:30.75,Main,Iceburg,0,0,0,,Aynen, bana sorucak olursan, sadece aptalca bir takıntı.Dialogue: 0,0:07:30.75,0:07:35.72,Main,Iceburg,0,0,0,,Eğer gerçekten onun sizinle gelmesini istiyorsanız...Dialogue: 0,0:07:36.20,0:07:38.18,Main,Iceburg,0,0,0,,Seçebileceğiniz tek yöntem...Dialogue: 0,0:07:38.18,0:07:40.40,Main,Iceburg,0,0,0,,Onu zorla götürmek.Dialogue: 0,0:07:40.40,0:07:44.35,Main,Iceburg,0,0,0,,Bu onu kıracak tek yöntem.Dialogue: 0,0:07:44.35,0:07:45.98,Main,Luffy,0,0,0,,Zorla?Dialogue: 0,0:07:46.80,0:07:48.82,Main,Luffy,0,0,0,,Gitmek istiyor, ama...Dialogue: 0,0:07:48.82,0:07:51.70,Main,Luffy,0,0,0,,Bunu yapmak gerçekten doğru mu?Dialogue: 0,0:07:55.61,0:07:57.49,Main,Zambai,0,0,0,,Abi! Neden geri döndün?Dialogue: 0,0:07:58.37,0:08:00.36,Main,Franky,0,0,0,,Bir sebebe mi ihtiyacım var?Dialogue: 0,0:08:00.36,0:08:02.00,Main,Franky,0,0,0,,Burası Franky'nin Evi!Dialogue: 0,0:08:02.00,0:08:03.00,Main,Franky,0,0,0,,Benim evim!Dialogue: 0,0:08:03.16,0:08:04.58,Main,Kiev,0,0,0,,Ama...Dialogue: 0,0:08:04.58,0:08:06.71,Main,Zambai,0,0,0,,Abi, Bu konuda gerçekten samimi misin?Dialogue: 0,0:08:07.19,0:08:11.16,Main,Zambai,0,0,0,,Abi, Hasır Şapkalı-san ve diğerleriyle gitmek istemiyor musun?Dialogue: 0,0:08:12.32,0:08:14.24,Main,Franky,0,0,0,,Ne aptalca şeyler söylüyorsun...Dialogue: 0,0:08:14.87,0:08:17.42,Main,Franky,0,0,0,,Tabii ki de hayır...!Dialogue: 0,0:08:17.42,0:08:18.65,Main,Iceburg,0,0,0,,Hey bakın!Dialogue: 0,0:08:18.65,0:08:22.43,Main,Franky,0,0,0,,Sizin gibi beceriye sahip insanlar bir ev bile yapamaz.Dialogue: 0,0:08:22.43,0:08:26.39,Main,Zambai,0,0,0,,Daha demin bu konu hakkında Hasır Şapka-san ve diğerlerine söyledik,Dialogue: 0,0:08:26.39,0:08:28.67,Main,Zambai,0,0,0,,Abimizle beraber denize açılın diye!Dialogue: 0,0:08:29.18,0:08:30.19,Main,Franky,0,0,0,,Aptallar!Dialogue: 0,0:08:30.19,0:08:31.19,Main,Franky,0,0,0,,Bu işe burnunuzu sokmayın!Dialogue: 0,0:08:31.19,0:08:35.61,Main,Zambai,0,0,0,,Ama o adam seni zaten gemi marangozu olarak seçti!Dialogue: 0,0:08:36.34,0:08:39.24,Main,Franky,0,0,0,,Neden benim korsan olmam gerekiyor ki?Dialogue: 0,0:08:39.74,0:08:41.20,Main,Zambai,0,0,0,,Bunu anlaması çok kolay!Dialogue: 0,0:08:41.65,0:08:45.58,Main,Zambai,0,0,0,,Bizim seni gemi yaparken ilk görüşümüz, ama...Dialogue: 0,0:08:45.58,0:08:49.65,Main,Zambai,0,0,0,,Böyle mutlu bir yüze sahip olabileceğine şaşırdık.Dialogue: 0,0:08:50.56,0:08:53.76,Main,Zambai,0,0,0,,Abimizi hiç bu kadar eğlenirken görmedik.Dialogue: 0,0:08:55.41,0:08:56.41,Main,Zambai,0,0,0,,Abi.Dialogue: 0,0:08:58.57,0:09:02.72,Main,Zambai,0,0,0,,Hasır Şapkaların bir marangoz aradığını biliyordun değil mi?Dialogue: 0,0:09:02.72,0:09:04.89,Main,Zambai,0,0,0,,Bu yüzden kaçtın, değil mi?Dialogue: 0,0:09:06.38,0:09:08.18,Main,Zambai,0,0,0,,Buna bak, Abi!Dialogue: 0,0:09:08.18,0:09:09.54,Main,Franky,0,0,0,,Aranma posteri!Dialogue: 0,0:09:09.54,0:09:11.36,Main,Franky,0,0,0,,Düşündüğüm gibi, başıma ödül çıkarmışlar.Dialogue: 0,0:09:11.36,0:09:14.03,Main,Zambai,0,0,0,,Artık bizimle beraber kalamazsın!Dialogue: 0,0:09:14.03,0:09:18.45,Main,Zambai,0,0,0,,Sana yük olmak istemiyoruz!Dialogue: 0,0:09:18.45,0:09:20.82,Main,Franky,0,0,0,,Kibirlenmeyi bırakın!Dialogue: 0,0:09:20.82,0:09:22.54,Main,Franky,0,0,0,,Donanma dediğin nedir?Dialogue: 0,0:09:22.54,0:09:27.66,Main,Franky,0,0,0,,Sizi bu kötü yollardan çekip çıkaran benim!Dialogue: 0,0:09:27.66,0:09:31.17,Main,Franky,0,0,0,,Eğer ben burada olmasam, muhtemelen kendi başınıza hayatta kalamazsınız...Dialogue: 0,0:09:33.17,0:09:35.39,Main,Tamagon,0,0,0,,Donunu aldım!Dialogue: 0,0:09:35.39,0:09:36.39,Main,Kiev,0,0,0,,Don mu?Dialogue: 0,0:09:36.39,0:09:37.89,Main,Kiev,0,0,0,,Neden adamın donunu...?Dialogue: 0,0:09:37.89,0:09:39.30,Main,Random FF Member,0,0,0,,Anladım!Dialogue: 0,0:09:39.30,0:09:39.98,Main,Random FF Member,0,0,0,,Ona geri vermeyeceğiz!Dialogue: 0,0:09:39.98,0:09:40.67,Main,Random FF Member,0,0,0,,Donunu elden ele dolaştırın!Dialogue: 0,0:09:40.67,0:09:41.87,Main,Random FF Member,0,0,0,,Ne olursa olsun geri vermeyin!Dialogue: 0,0:09:42.97,0:09:44.47,Main,Franky,0,0,0,,Donumu geri verin, hıyarlar!Dialogue: 0,0:09:46.27,0:09:49.00,Main,Franky,0,0,0,,O benim favori donum!Dialogue: 0,0:09:49.00,0:09:49.98,Main,FF Members,0,0,0,,Dağılın!Dialogue: 0,0:09:49.98,0:09:51.90,Main,FF Members,0,0,0,,Gidelim!Dialogue: 0,0:09:53.59,0:09:55.24,Main,Franky,0,0,0,,Öyle olsun!Dialogue: 0,0:09:56.37,0:09:57.84,Main,FF Members,0,0,0,,Peşimizden geliyor!Dialogue: 0,0:09:58.44,0:10:02.77,Main,Franky,0,0,0,,Benim karşımda hiçbir şey yapamacağınızı biliyorsunuz!Dialogue: 0,0:10:03.50,0:10:05.69,Main,Zambai,0,0,0,,Bir kişi ayakta kalsa bile yeter!Dialogue: 0,0:10:05.69,0:10:07.56,Main,Zambai,0,0,0,,Donu Hasır Şapka'ya teslim edin!Dialogue: 0,0:10:07.56,0:10:09.99,Main,Zambai,0,0,0,,Donu adanın hurdacı kısmına götürün!Dialogue: 0,0:10:15.67,0:10:17.67,Main,Franky,0,0,0,,Strong Right!Dialogue: 0,0:10:15.67,0:10:17.67,Attack,Franky,0,0,0,,Güçlü Sağ!Dialogue: 0,0:10:22.56,0:10:23.42,Main,FF Guy,0,0,0,,Koşun!Dialogue: 0,0:10:23.42,0:10:24.42,Main,FF Guy,0,0,0,,Güneydoğuya!Dialogue: 0,0:10:32.29,0:10:33.52,Main,Citizen,0,0,0,,Bu neyin sesi böyle?Dialogue: 0,0:10:33.52,0:10:34.94,Main,Rich Citizen/Uncle Sam,0,0,0,,Sapık...!Dialogue: 0,0:10:35.38,0:10:37.65,Main,Rich Citizen/Uncle Sam,0,0,0,,Franky çılgınca davranıyor!Dialogue: 0,0:10:39.84,0:10:40.79,Main,Fat Citizen,0,0,0,,Yine mi?Dialogue: 0,0:10:40.79,0:10:43.39,Main,Woman,0,0,0,,Hayır! Şehir yok oluyor!Dialogue: 0,0:10:47.02,0:10:48.52,Main,Franky,0,0,0,,Bekleyin, yavşaklar!Dialogue: 0,0:10:49.07,0:10:51.36,Main,Citizen,0,0,0,,Hey! O herif hiçbir şey giymiyor!Dialogue: 0,0:11:02.49,0:11:04.00,Main,Little Girl,0,0,0,,Ah! Bak...!Dialogue: 0,0:11:04.38,0:11:05.62,Main,Citizen,0,0,0,,Çocukları eve götürün!Dialogue: 0,0:11:05.62,0:11:07.04,Main,Stache Man,0,0,0,,Sapığı görmesine izin vermeyin!Dialogue: 0,0:11:07.41,0:11:09.24,Main,Franky,0,0,0,,Strong Raito!Dialogue: 0,0:11:07.41,0:11:09.24,Attack,Franky,0,0,0,,Güçlü Sağ!Dialogue: 0,0:11:18.24,0:11:21.70,Main,Policeman,0,0,0,,O bir suç işliyor, tutuklayın!Dialogue: 0,0:11:31.81,0:11:34.92,Main,FF Member,0,0,0,,Donu teslim et!Dialogue: 0,0:11:39.28,0:11:40.99,Main,FF Member,0,0,0,,Kornet balığına binin!Dialogue: 0,0:11:40.99,0:11:42.39,Main,FF Member,0,0,0,,Tamamdır! Gidelim!Dialogue: 0,0:11:46.41,0:11:49.90,Main,Person,0,0,0,,Arka sokaklar savaş alanına döndü!Dialogue: 0,0:11:49.90,0:11:51.15,Main,FF Member,0,0,0,,Kahretsin, bacağım...!Dialogue: 0,0:11:52.61,0:11:53.69,Main,FF Member,0,0,0,,Olamaz!Dialogue: 0,0:11:53.69,0:11:55.18,Main,FF Member,0,0,0,,Buraya kadar mıymış?Dialogue: 0,0:11:55.18,0:11:57.65,Main,Luffy,0,0,0,,Hey! Buraya pas ver!Dialogue: 0,0:12:03.47,0:12:04.47,Main,Luffy,0,0,0,,Buraya fırlat!Dialogue: 0,0:12:06.07,0:12:07.36,Main,FF Member,0,0,0,,Hasır Şapka-san!Dialogue: 0,0:12:08.54,0:12:10.27,Main,Franky,0,0,0,,Hasır Şapka!Dialogue: 0,0:12:16.36,0:12:18.00,Main,Luffy,0,0,0,,Yakaladım!Dialogue: 0,0:12:18.71,0:12:20.51,Main,Franky,0,0,0,,Seni...!Dialogue: 0,0:12:21.47,0:12:23.55,Main,Franky,0,0,0,,Hasır Şapka!Dialogue: 0,0:12:24.77,0:12:26.22,Main,Franky,0,0,0,,Gemiyi beğendin mi?Dialogue: 0,0:12:26.68,0:12:27.68,Main,Luffy,0,0,0,,Evet!Dialogue: 0,0:12:28.32,0:12:31.12,Main,Luffy,0,0,0,,Daha önce hiç bu kadar muhteşem bir gemi görmemiştim.Dialogue: 0,0:12:31.12,0:12:32.23,Main,Luffy,0,0,0,,Teşekkürler!Dialogue: 0,0:12:33.48,0:12:35.24,Main,Woman,0,0,0,,Sapık! Defol git!Dialogue: 0,0:12:35.24,0:12:36.26,Main,Man,0,0,0,,Kendinden utanmalısın!Dialogue: 0,0:12:36.26,0:12:37.26,Main,Man,0,0,0,,Sapık piç!Dialogue: 0,0:12:38.49,0:12:40.24,Main,Franky,0,0,0,,Öyle tabi!Dialogue: 0,0:12:40.24,0:12:42.51,Main,Franky,0,0,0,,İçinde süper tasarımım var!Dialogue: 0,0:12:42.90,0:12:45.91,Main,Franky,0,0,0,,Bütün isteklerinizi karşılayabilir.Dialogue: 0,0:12:45.91,0:12:48.79,Main,Franky,0,0,0,,Benim icat ettiğim  Askeri Liman Sistemi'ni gördün mü?!Dialogue: 0,0:12:50.96,0:12:52.34,Main,Luffy,0,0,0,,Daha değil!Dialogue: 0,0:12:52.34,0:12:54.84,Main,Franky,0,0,0,,Bu kesinlikle en çok seveceğiniz şey olacak!Dialogue: 0,0:12:56.63,0:12:57.68,Main,Franky,0,0,0,,Akvaryum hakkında ne düşünüyorsun?Dialogue: 0,0:12:57.68,0:12:58.68,Main,Luffy,0,0,0,,Onu gördüm!Dialogue: 0,0:12:58.88,0:13:03.58,Main,Franky,0,0,0,,Tuttuğunuz balıkları balık havuzuna koyarsanız, onları alt kattaki büyük akvaryumda görebilirsiniz.Dialogue: 0,0:13:03.58,0:13:06.38,Main,Franky,0,0,0,,Akvaryum izleme odası!Dialogue: 0,0:13:06.38,0:13:08.88,Main,Franky,0,0,0,,Herkes bir kere oradan yemek yemeli.Dialogue: 0,0:13:08.88,0:13:11.19,Main,Franky,0,0,0,,Her zaman taze balık yiyebilirsiniz!Dialogue: 0,0:13:11.19,0:13:12.47,Main,Luffy,0,0,0,,Dört gözle bekliyorum!Dialogue: 0,0:13:15.08,0:13:18.16,Main,Franky,0,0,0,,Bu gemi, hem sizin için hem benim için...Dialogue: 0,0:13:18.16,0:13:19.77,Main,Franky,0,0,0,,En iyi "Rüyaların Gemisi"!Dialogue: 0,0:13:20.25,0:13:22.56,Main,Franky,0,0,0,,Buna rağmen şerefsiz...!Dialogue: 0,0:13:23.40,0:13:25.74,Main,Franky,0,0,0,,Donumu geri ver!Dialogue: 0,0:13:28.81,0:13:30.08,Main,Luffy,0,0,0,,Chopper!Dialogue: 0,0:13:30.08,0:13:31.37,Main,Chopper,0,0,0,,Ben de!Dialogue: 0,0:13:36.21,0:13:37.38,Main,Kiev,0,0,0,,Geliyor!Dialogue: 0,0:13:37.38,0:13:39.26,Main,Kiev,0,0,0,,Roronoa-san ve diğer arkadaşlarına güveniyoruz!Dialogue: 0,0:13:39.33,0:13:40.33,Main,Sanji and Zoro,0,0,0,,Bize bırakın!Dialogue: 0,0:13:45.19,0:13:46.55,Main,Sanji and Zoro,0,0,0,,Gir şuraya!Dialogue: 0,0:13:50.52,0:13:53.06,Main,Kiev,0,0,0,,Hedef; Hurdalık!Dialogue: 0,0:13:53.06,0:13:54.52,Main,Franky,0,0,0,,Ne yapmaya çalışıyorsunuz?!Dialogue: 0,0:13:54.91,0:13:56.62,Main,FF Member,0,0,0,,Franky Ailesi'nin özel üretimi!Dialogue: 0,0:13:56.62,0:13:58.81,Main,Kiev,0,0,0,,Her şeyi Fırlatan Top!Dialogue: 0,0:13:58.81,0:14:00.95,Main,Franky,0,0,0,,Hey, hey sen!Dialogue: 0,0:14:00.95,0:14:02.49,Main,Franky,0,0,0,,Dalga geçmeyi kesin...!Dialogue: 0,0:14:12.46,0:14:14.96,Main,Chopper,0,0,0,,Donu yerine, o önceden gitti!Dialogue: 0,0:14:14.96,0:14:16.66,Main,Luffy,0,0,0,,Bana tutun, Chopper!Dialogue: 0,0:14:17.26,0:14:19.67,Main,Luffy,0,0,0,,Gomu Gomu no...Dialogue: 0,0:14:19.67,0:14:21.88,Main,Luffy,0,0,0,,Rocket!Dialogue: 0,0:14:19.67,0:14:21.88,Attack,Luffy,0,0,0,,...Roket!Dialogue: 0,0:14:23.09,0:14:24.54,Main,Old Man,0,0,0,,Uğursuzun teki!Dialogue: 0,0:14:24.54,0:14:26.84,Main,Citizen,0,0,0,,Aptal! Bu sadece sıradan bir sapık!Dialogue: 0,0:14:29.80,0:14:32.76,Main,Chimney,0,0,0,,(Bir koza! Bir koza! Bir koza!Dialogue: 0,0:14:30.47,0:14:32.29,Secondary,Mozu and Kiwi,0,0,0,,Abi!Dialogue: 0,0:14:33.35,0:14:34.68,Main,Iceburg,0,0,0,,Bu durum da ne böyle?!Dialogue: 0,0:14:40.78,0:14:41.80,Main,Luffy,0,0,0,,Franky!Dialogue: 0,0:14:43.09,0:14:45.48,Main,Luffy,0,0,0,,Gemi için teşekkür ederim!Dialogue: 0,0:14:45.48,0:14:47.16,Main,Luffy,0,0,0,,Bu gemi en iyisi!Dialogue: 0,0:14:47.16,0:14:48.74,Main,Luffy,0,0,0,,Değerini bileceğiz!Dialogue: 0,0:14:49.84,0:14:51.18,Main,Franky,0,0,0,,Evet!Dialogue: 0,0:14:51.18,0:14:54.20,Main,Franky,0,0,0,,Size güvenli bir yolculuk dilerim.Dialogue: 0,0:14:55.08,0:14:57.87,Main,Luffy,0,0,0,,Eğer donunu geri almak istiyorsan,Dialogue: 0,0:14:58.28,0:15:00.83,Main,Luffy,0,0,0,,Tayfamıza katılman gerekiyor!Dialogue: 0,0:15:17.02,0:15:18.65,Main,Citizen,0,0,0,,Donunu giy!Dialogue: 0,0:15:18.65,0:15:19.52,Main,Citizen,0,0,0,,Sapık!Dialogue: 0,0:15:19.52,0:15:22.03,Main,Citizen,0,0,0,,Şehri tekrar mahvetti!Dialogue: 0,0:15:22.03,0:15:23.65,Main,Citizen,0,0,0,,Git buradan, sapık!Dialogue: 0,0:15:23.65,0:15:25.49,Main,Citizen,0,0,0,,Seni mal herif!Dialogue: 0,0:15:28.16,0:15:30.03,Main,Franky,0,0,0,,Donumu geri ver, Hasır Şapka.Dialogue: 0,0:15:30.79,0:15:32.79,Main,Luffy,0,0,0,,O zaman, tayfaya katıl.Dialogue: 0,0:15:32.79,0:15:34.00,Main,Franky,0,0,0,,Saçmalama!Dialogue: 0,0:15:34.00,0:15:38.42,Main,Franky,0,0,0,,Donumu aldığın için beni tayfandan biri olarak düşüneceğini sanma!Dialogue: 0,0:15:46.86,0:15:54.43,Main,,0,0,0,,Ne tür bir adam çıplak olsa bile, başı dik ve yüzsüz, dalgaları bir aslan gibi.Dialogue: 0,0:15:59.27,0:16:02.14,Main,Citizen,0,0,0,,Altı açıkta poz verme kararı aldı!Dialogue: 0,0:16:02.40,0:16:03.77,Main,Citizen,0,0,0,,Bakmayın!Dialogue: 0,0:16:03.77,0:16:04.97,Main,Citizen,0,0,0,,En kötüsüydü!Dialogue: 0,0:16:04.97,0:16:06.24,Main,Citizen,0,0,0,,En kötüsü!Dialogue: 0,0:16:06.65,0:16:07.88,Main,Luffy,0,0,0,,Onu hafife aldım!Dialogue: 0,0:16:07.88,0:16:10.18,Main,Luffy,0,0,0,,Ne kararlı!Dialogue: 0,0:16:10.18,0:16:12.15,Main,Luffy,0,0,0,,Adamın içinde bir adam daha var!Dialogue: 0,0:16:13.17,0:16:15.24,Main,Nami,0,0,0,,O sadece bir sapık!Dialogue: 0,0:16:17.62,0:16:18.85,Main,Robin,0,0,0,,Biraz sert olursam eğer...Dialogue: 0,0:16:18.85,0:16:20.20,Main,Robin,0,0,0,,Ben de bir el atayım bari.Dialogue: 0,0:16:23.39,0:16:25.17,Main,Robin,0,0,0,,Dos Fleur:Dialogue: 0,0:16:23.39,0:16:25.17,Attack,Robin,0,0,0,,2 ÇiçekDialogue: 0,0:16:41.03,0:16:42.28,Main,Robin,0,0,0,,Grab!Dialogue: 0,0:16:41.03,0:16:42.28,Attack,Robin,0,0,0,,Kavra!Dialogue: 0,0:16:47.30,0:16:49.06,Main,Nami,0,0,0,,Eh? Biraz bekle, Robin!Dialogue: 0,0:16:49.06,0:16:51.91,Main,Luffy,0,0,0,,Onları yakaladı! Çok acıtmış olmalı!Dialogue: 0,0:16:51.91,0:16:54.91,Main,Chopper,0,0,0,,Ezilecekler, Robin!Dialogue: 0,0:17:00.65,0:17:02.84,Main,One of Square Sist.,0,0,0,,Kopacaklar!Dialogue: 0,0:17:03.10,0:17:05.21,Main,One of Square Sist.,0,0,0,,Yerinden çıkacaklar!Dialogue: 0,0:17:05.65,0:17:07.67,Main,Mozu and Kiwi,0,0,0,,Aynı portakal sıkar gibi!Dialogue: 0,0:17:07.67,0:17:08.93,Main,Luffy,0,0,0,,Hey, Robin!Dialogue: 0,0:17:08.93,0:17:11.43,Main,Luffy,0,0,0,,Onun bizim tayfamızdan biri olacağı zaman hala bir erkek olmasını istiyorum!Dialogue: 0,0:17:11.43,0:17:12.83,Main,Luffy,0,0,0,,Onları alma!Dialogue: 0,0:17:12.83,0:17:14.59,Main,Chopper,0,0,0,,Sadece bakması bile acı veriyor!Dialogue: 0,0:17:18.71,0:17:19.61,Main,Citizen,0,0,0,,Ne oluyor?Dialogue: 0,0:17:19.61,0:17:22.48,Main,Citizen,0,0,0,,Franky hasar alıyor!Dialogue: 0,0:17:22.48,0:17:25.73,Main,Citizen,0,0,0,,Ne? Tıpkı tavuğun başı bağlanırken çığlık atması gibi!Dialogue: 0,0:17:25.99,0:17:28.72,Main,Citizen,0,0,0,,Nedense acıdım.Dialogue: 0,0:17:28.72,0:17:29.90,Main,Citizen,0,0,0,,Bir sapık olsa bile.Dialogue: 0,0:17:30.41,0:17:34.12,Main,Robin,0,0,0,,Tam da bir korsanın önünde hazine olduğunda ve onu bırakmak istememesi gibi!Dialogue: 0,0:17:34.12,0:17:36.71,Main,Robin,0,0,0,,Eğer bize iyi bir sebep söylemezsen,Dialogue: 0,0:17:36.71,0:17:38.36,Main,Robin,0,0,0,,Onları bırakmayacağım.Dialogue: 0,0:17:39.24,0:17:40.74,Main,Franky,0,0,0,,Bu yüzden...!Dialogue: 0,0:17:42.71,0:17:45.94,Main,Franky,0,0,0,,Bu adadan gidemeyeceğimi söylemiştim...Dialogue: 0,0:17:48.21,0:17:50.27,Main,Franky,0,0,0,,Size minnettarım...Dialogue: 0,0:17:50.27,0:17:53.53,Main,Franky,0,0,0,,Ama bu benim için yapması imkansız bir şey.Dialogue: 0,0:17:53.53,0:17:55.70,Main,Franky,0,0,0,,Ben de sizle gitmek istiyorum ama...Dialogue: 0,0:17:55.70,0:17:59.64,Main,Franky,0,0,0,,Burada hala yapmam gereken şeyler var.Dialogue: 0,0:18:01.21,0:18:04.28,Main,Franky,0,0,0,,Bu yüzden size gemiyi verdim.Dialogue: 0,0:18:04.28,0:18:07.57,Main,Franky,0,0,0,,Hem marangoz olmayı çoktan bırakmıştım.Dialogue: 0,0:18:07.57,0:18:12.22,Main,Franky,0,0,0,,İşte bu yüzden, o gemi benim inşa edeceğim tek gemi olacak.Dialogue: 0,0:18:12.22,0:18:13.74,Main,Franky,0,0,0,,Benim sadece bir hayalim daha vardı...Dialogue: 0,0:18:13.90,0:18:16.57,Main,Franky,0,0,0,,Bu gördüğünüz.. Rüyaların Gemisi!Dialogue: 0,0:18:16.57,0:18:18.52,Main,Iceburg,0,0,0,,Bekle, Franky...Dialogue: 0,0:18:18.52,0:18:23.37,Main,Iceburg,0,0,0,,Hala bahsettiğiniz rüyalar gemisine dönüşmedi.Dialogue: 0,0:18:25.84,0:18:27.65,Flashbacks,Young Iceburg,0,0,0,,Rüyaların gemisi?Dialogue: 0,0:18:27.65,0:18:28.67,Flashbacks,Young Franky,0,0,0,,Evet!Dialogue: 0,0:18:28.67,0:18:32.09,Flashbacks,Young Franky,0,0,0,,O gemi, sadece planlarla tamamlanacak bir gemi olmayacak.Dialogue: 0,0:18:32.55,0:18:35.70,Flashbacks,Young Franky,0,0,0,,Çok fazla deniz görecek.Dialogue: 0,0:18:35.70,0:18:38.05,Flashbacks,Young Franky,0,0,0,,Pek çok savaştan ve zorluklardan geçecek...Dialogue: 0,0:18:39.75,0:18:41.65,Flashbacks,Young Franky,0,0,0,,Ve denizlerin sonuna ulaşacak...Dialogue: 0,0:18:41.65,0:18:45.27,Flashbacks,Young Franky,0,0,0,,İşte o zaman rüyaların gemisi olacak!Dialogue: 0,0:18:46.95,0:18:51.57,Flashbacks,Young Franky,0,0,0,,Ve bir gün, bu gemi tamamlandığında,Dialogue: 0,0:18:51.57,0:18:54.95,Flashbacks,Young Franky,0,0,0,,O gemiye binip geminin marangozu olacağım!Dialogue: 0,0:18:54.95,0:18:57.98,Flashbacks,Young Franky,0,0,0,,O kader gününü görmeyi dört gözle bekliyorum!Dialogue: 0,0:18:57.98,0:19:01.01,Flashbacks,Young Franky,0,0,0,,O zamana kadar gemi tamamen yıpranmış olabilir, fakat...Dialogue: 0,0:19:01.01,0:19:05.50,Flashbacks,Young Franky,0,0,0,,Eminim ki, diğer tüm gemilerden çok daha fazla parlayacak!Dialogue: 0,0:19:05.95,0:19:08.18,Flashbacks,Young Franky,0,0,0,,Nasıl? Muhteşem, değil mi, Tom-san?Dialogue: 0,0:19:08.18,0:19:09.88,Flashbacks,Tom,0,0,0,,Evet, muhteşem.Dialogue: 0,0:19:09.88,0:19:12.35,Flashbacks,Tom,0,0,0,,Ve eğer ona biner ve ona iyi bakarsanız...Dialogue: 0,0:19:12.35,0:19:13.66,Flashbacks,Tom,0,0,0,,Beni geçmiş olacaksınız!Dialogue: 0,0:19:15.22,0:19:16.96,Flashbacks,Young Kokoro,0,0,0,,İşte bu sendeki korsan kanı.Dialogue: 0,0:19:17.85,0:19:21.51,Flashbacks,Young Iceburg,0,0,0,,Aptal-Franky, Gerçekten Tom-san'ı geçebileceğini düşünüyor musun?Dialogue: 0,0:19:21.51,0:19:22.51,Flashbacks,Young Franky,0,0,0,,Ne dedin?Dialogue: 0,0:19:22.56,0:19:23.87,Flashbacks,Young Iceburg,0,0,0,,Şerefsiz! Ne yapıyorsun?Dialogue: 0,0:19:23.87,0:19:25.45,Flashbacks,Young Iceburg,0,0,0,,Kahrolası aptal-Franky!Dialogue: 0,0:19:27.50,0:19:30.71,Flashbacks,Tom,0,0,0,,Ne derler, eğer yapacak isen "Don" ile yap!Dialogue: 0,0:19:33.79,0:19:36.27,Main,Franky,0,0,0,,Yapmak istediğim şeyler değişti!Dialogue: 0,0:19:36.63,0:19:37.73,Main,Iceburg,0,0,0,,Yapmak istediklerin mi?Dialogue: 0,0:19:37.73,0:19:39.06,Main,Iceburg,0,0,0,,Bu yanlış.Dialogue: 0,0:19:40.43,0:19:44.21,Main,Iceburg,0,0,0,,Artık bu adada yapman gereken her şeyi yaptın.Dialogue: 0,0:19:45.22,0:19:46.62,Main,Iceburg,0,0,0,,Senin yaptığın kendini affedememek!Dialogue: 0,0:19:52.47,0:19:53.87,Main,Iceburg,0,0,0,,O gün...Dialogue: 0,0:19:53.87,0:19:58.88,Main,Iceburg,0,0,0,,Kendini suçladın ve Tom-san'ın yakalanmasından pişmanlık duydun.Dialogue: 0,0:20:03.46,0:20:06.81,Main,Iceburg,0,0,0,,Ama Tom-san çoktan seni affetmişti.Dialogue: 0,0:20:08.33,0:20:09.90,Main,Iceburg,0,0,0,,Sana yeni bir yol göstermişti.Dialogue: 0,0:20:11.07,0:20:15.60,Main,Iceburg,0,0,0,,Arka sokaklardan insan topladın,Dialogue: 0,0:20:16.55,0:20:18.58,Main,Iceburg,0,0,0,,Ödül avcıları olarak adınızı duyurdunuz,Dialogue: 0,0:20:18.58,0:20:21.78,Main,Iceburg,0,0,0,,Bu adayı yağmacılardan korudunuz,Dialogue: 0,0:20:22.56,0:20:26.55,Main,Iceburg,0,0,0,,Bu Su Metropolü'nde Tom-san'ın sevdiği her şeyi korudunuz,Dialogue: 0,0:20:26.55,0:20:29.49,Main,Iceburg,0,0,0,,Tüm yaptıklarınız suçlarınızın karşılığını ödemekti.Dialogue: 0,0:20:29.89,0:20:33.21,Main,Iceburg,0,0,0,,Belki o açıdan göremeyebilirsin.Dialogue: 0,0:20:33.60,0:20:35.94,Main,Franky,0,0,0,,Tabii ki göremiyorum...Dialogue: 0,0:20:35.94,0:20:38.87,Main,Franky,0,0,0,,Benim böyle en ufak bir niyetim bile yoktu.Dialogue: 0,0:20:39.40,0:20:43.90,Main,Iceburg,0,0,0,,Yaşamaya devam etmek için sevdiğin o gemileri yapmayı bıraktın.Dialogue: 0,0:20:43.90,0:20:45.93,Main,Iceburg,0,0,0,,Bundan sonra da böyle yapmayı düşünüyor musunuz?Dialogue: 0,0:20:45.93,0:20:48.05,Main,Iceburg,0,0,0,,Tom-san sizi zaten affetmiş olsa bile,Dialogue: 0,0:20:48.05,0:20:50.16,Main,Iceburg,0,0,0,,Ben seni affetmiş olsam bile,Dialogue: 0,0:20:50.16,0:20:52.03,Main,Iceburg,0,0,0,,Bu hiçbir şeyi değiştirmedi, değil mi?Dialogue: 0,0:20:52.37,0:20:53.64,Main,Iceburg,0,0,0,,Artık...Dialogue: 0,0:20:55.95,0:20:58.66,Main,Iceburg,0,0,0,,Kendini affet, Franky!Dialogue: 0,0:21:07.30,0:21:09.79,Main,Iceburg,0,0,0,,Hayallerin için yaşama zamanın geldi!Dialogue: 0,0:21:26.89,0:21:27.89,Main,Franky,0,0,0,,Ne düştü...?!Dialogue: 0,0:21:31.43,0:21:32.56,Main,Franky,0,0,0,,Çanta mı?Dialogue: 0,0:21:33.44,0:21:36.22,Main,Zambai,0,0,0,,Bu seyahat için bir bavul, Abim!Dialogue: 0,0:21:36.22,0:21:37.28,Main,FF Member,0,0,0,,İlerleyin lan!Dialogue: 0,0:21:37.28,0:21:39.31,Main,Citizens,0,0,0,,Ah! Franky Ailesi!Dialogue: 0,0:21:39.31,0:21:40.62,Main,FF Member,0,0,0,,Abi!Dialogue: 0,0:21:40.62,0:21:41.62,Main,FF Member,0,0,0,,Abi!Dialogue: 0,0:21:43.53,0:21:44.95,Main,Franky,0,0,0,,Bu herifler...!Dialogue: 0,0:21:48.09,0:21:51.67,Main,Zambai,0,0,0,,Abi, her şey için bizi affet!Dialogue: 0,0:21:51.67,0:21:53.04,Main,Zambai,0,0,0,,Gerçekten üzgünüz!Dialogue: 0,0:21:53.04,0:21:54.73,Main,Franky Family,0,0,0,,Gerçekten üzgünüz!Dialogue: 0,0:21:54.73,0:21:57.23,Main,Zambai,0,0,0,,Her türlü cezaya razıyız.Dialogue: 0,0:21:57.23,0:21:59.01,Main,Zambai,0,0,0,,Aptallar ordusuyuz, bu yüzden...!Dialogue: 0,0:21:59.01,0:22:02.63,Main,Zambai,0,0,0,,Bu kadarını planlayabildik!Dialogue: 0,0:22:03.43,0:22:06.65,Main,Franky,0,0,0,,O kafalarınızla neyi planladınız?!Dialogue: 0,0:22:06.65,0:22:09.03,Main,Franky,0,0,0,,Donumu çalmayı mı?Dialogue: 0,0:22:10.42,0:22:12.80,Main,Franky,0,0,0,,Beni korsana çevirmenin yolunu mu?Dialogue: 0,0:22:12.80,0:22:14.61,Main,Franky,0,0,0,,Karışmayın!Dialogue: 0,0:22:14.61,0:22:16.08,Main,Franky,0,0,0,,Bu benim hayatım!Dialogue: 0,0:22:16.08,0:22:18.56,Main,Franky,0,0,0,,Her şeye ben karar veririm!Dialogue: 0,0:22:19.40,0:22:24.62,Main,Franky,0,0,0,,Adamlarım, sizi bırakıp gitmem sizi mutlu mu ediyor?Dialogue: 0,0:22:24.62,0:22:26.23,Main,Franky,0,0,0,,Kabul edilemez!Dialogue: 0,0:22:26.23,0:22:28.05,Main,Franky,0,0,0,,Eğer bunu düşünürseniz,Dialogue: 0,0:22:28.05,0:22:30.93,Main,Franky,0,0,0,,Bunu en baştan zaten yapmazsınız!Dialogue: 0,0:22:31.49,0:22:33.67,Main,Zambai,0,0,0,,Bahanemiz yok ama...Dialogue: 0,0:22:34.45,0:22:37.39,Main,Zambai,0,0,0,,Seni biraz bile olsa önemsemek kötü bir şey mi?Dialogue: 0,0:22:37.39,0:22:41.43,Main,Zambai,0,0,0,,Yağmacılardan daha fazlası olmadığımız zamanlarda bir araya topladın...Dialogue: 0,0:22:41.67,0:22:46.03,Main,Zambai,0,0,0,,Senin mutluluğunu düşünmek kötü bir şey mi?!Dialogue: 0,0:22:53.15,0:22:55.36,Main,Kokoro,0,0,0,,Aptal olan kim?Dialogue: 0,0:22:56.61,0:22:58.64,Main,Franky,0,0,0,,Hepiniz varya...Dialogue: 0,0:23:04.06,0:23:05.49,Main,Mozu and Kiwi,0,0,0,,Abi...Dialogue: 0,0:23:09.08,0:23:10.52,Main,Luffy,0,0,0,,Hey! Robin!Dialogue: 0,0:23:10.52,0:23:12.68,Main,Luffy,0,0,0,,Aşırıya kaçma! Lütfen!Dialogue: 0,0:23:12.68,0:23:14.23,Main,Luffy,0,0,0,,Kadın olacak!Dialogue: 0,0:23:14.23,0:23:15.70,Main,Chopper,0,0,0,,Ağlıyor!Dialogue: 0,0:23:16.00,0:23:18.44,Main,Franky,0,0,0,,Lanet olsun, Nico Robin!Dialogue: 0,0:23:18.44,0:23:20.08,Main,Franky,0,0,0,,Seni affetmeyeceğim!Dialogue: 0,0:23:20.64,0:23:24.32,Main,Franky,0,0,0,,O kadar çok acıyor ki ağlamamı durduramıyorum!Dialogue: 0,0:23:24.32,0:23:25.32,Main,Luffy,0,0,0,,Robin!Dialogue: 0,0:23:27.83,0:23:29.59,Main,Luffy,0,0,0,,Sen hiçbir şey yapmıyor muydun?Dialogue: 0,0:23:31.52,0:23:35.14,Main,Robin,0,0,0,,Sadece başta bir kere yapmıştım.Dialogue: 0,0:23:36.27,0:23:37.69,Main,Robin,0,0,0,,O zeki biri.Dialogue: 0,0:23:37.69,0:23:40.17,Main,Robin,0,0,0,,Gözyaşlarının sebebinin benim yaptığım şeymiş gibi göstermesi.Dialogue: 0,0:23:40.95,0:23:42.57,Main,Nami,0,0,0,,Sadece bir kere mi?Dialogue: 0,0:23:43.35,0:23:44.61,Main,Franky,0,0,0,,Lanet olsun!Dialogue: 0,0:23:49.22,0:23:50.87,Main,Franky,0,0,0,,Ağlamayı kesemiyorum!Dialogue: 0,0:23:53.82,0:23:55.89,Main,Franky Family,0,0,0,,Abi!Dialogue: 0,0:23:55.89,0:23:58.13,Main,Zambai,0,0,0,,İyi misin?!Dialogue: 0,0:23:59.58,0:24:02.55,Main,Franky,0,0,0,,İyi olmama imkan yok!Dialogue: 0,0:24:03.15,0:24:05.04,Flashbacks,Past FF,0,0,0,,Demek ki daha farketmemişsin...Dialogue: 0,0:24:05.50,0:24:07.97,Flashbacks,Young Zambai,0,0,0,,Bu donla gezen adam da kimin nesi?Dialogue: 0,0:24:07.97,0:24:11.26,Flashbacks,Young Zambai,0,0,0,,Böyle arka sokaklara gelmemeliydin.Dialogue: 0,0:24:13.80,0:24:14.80,Flashbacks,Thug,0,0,0,,Zambai!Dialogue: 0,0:24:16.73,0:24:22.64,Flashbacks,Franky,0,0,0,,Bundan böyle, Water 7'ın arka sokakları Franky tarafından kontrol edilecek!Dialogue: 0,0:24:22.64,0:24:23.69,Flashbacks,Franky,0,0,0,,Memnum oldum!Dialogue: 0,0:24:23.99,0:24:25.65,Flashbacks,Young Zambai,0,0,0,,Evet!Dialogue: 0,0:24:28.98,0:24:30.30,Main,Mozu and Kiwi,0,0,0,,Abi!Dialogue: 0,0:24:32.91,0:24:35.12,Flashbacks,Young Square Sis,0,0,0,,Ah! Bu çok iyidi!Dialogue: 0,0:24:38.14,0:24:40.17,Flashbacks,Young Square Sis,0,0,0,,Tekrar gelmeliyiz.Dialogue: 0,0:24:40.87,0:24:43.55,Flashbacks,Young Square Sis,0,0,0,,Bu dışarıda donla gezen kişi de kim?Dialogue: 0,0:24:43.55,0:24:46.13,Flashbacks,Young Square Sis,0,0,0,,Bizimle içmek ister misin?Dialogue: 0,0:24:46.13,0:24:48.84,Flashbacks,Young Square Sis,0,0,0,,Sana barın yolunu gösteririz.Dialogue: 0,0:24:53.38,0:24:55.10,Flashbacks,Young Square Sis,0,0,0,,Ne yapıyorsun?!Dialogue: 0,0:24:55.10,0:24:56.37,Flashbacks,Young Square Sis,0,0,0,,Bırak bizi!Dialogue: 0,0:24:56.37,0:25:00.48,Flashbacks,Franky,0,0,0,,Genç kızlar gün doğana kadar içmemeli!Dialogue: 0,0:25:02.81,0:25:05.74,Flashbacks,Franky,0,0,0,,İyi bir kola içebileceğimiz güzel bir dükkân biliyorum.Dialogue: 0,0:25:06.45,0:25:07.16,Flashbacks,Franky,0,0,0,,Ne dersiniz?Dialogue: 0,0:25:07.16,0:25:08.45,Flashbacks,Franky,0,0,0,,Beraber gitmek ister misiniz?Dialogue: 0,0:25:08.45,0:25:12.40,Main,Franky Family,0,0,0,,Abi! Abi!Dialogue: 0,0:25:19.62,0:25:22.33,Flashbacks,Homeless Man,0,0,0,,Yemek... lütfen...Dialogue: 0,0:25:23.70,0:25:26.84,Flashbacks,Franky,0,0,0,,Aç olanlar, beni takip edin!Dialogue: 0,0:25:34.01,0:25:36.28,Flashbacks,Franky,0,0,0,,İstediğinizi yapın!Dialogue: 0,0:25:36.28,0:25:38.72,Flashbacks,Franky,0,0,0,,Bu Franky Ailesinin yükselişi!Dialogue: 0,0:25:43.15,0:25:51.15,Flashbacks,Franky Family,0,0,0,,Franky! Franky! Franky!Dialogue: 0,0:26:01.69,0:26:02.83,Main,Franky,0,0,0,,Sen...Dialogue: 0,0:26:02.83,0:26:06.69,Main,Franky,0,0,0,,Eğer ben burada olmasaydım, nasıl hayatta kalacaktınız...?Dialogue: 0,0:26:06.69,0:26:08.08,Main,FF Member,0,0,0,,Abi...Dialogue: 0,0:26:08.70,0:26:12.76,Main,Zambai,0,0,0,,Water 7'de yeni görevlerle gücümüzü test edeceğiz...!Dialogue: 0,0:26:12.76,0:26:15.13,Main,Zambai,0,0,0,,Kesinlikle kazanacağız!Dialogue: 0,0:26:15.13,0:26:16.47,Main,FF Member,0,0,0,,Lütfen rahat olun!Dialogue: 0,0:26:16.47,0:26:17.73,Main,FF Member,0,0,0,,Abim, ağlama!Dialogue: 0,0:26:17.73,0:26:19.10,Main,FF Member,0,0,0,,Abi!Dialogue: 0,0:26:19.10,0:26:21.92,Main,FF Member,0,0,0,,Abimiz uzaklara gitse bile...Dialogue: 0,0:26:21.92,0:26:25.49,Main,FF Member,0,0,0,,Biz her zaman senin takipçilerin olacağız!Dialogue: 0,0:26:25.49,0:26:27.06,Main,Franky Family,0,0,0,,Abi!Dialogue: 0,0:26:31.82,0:26:33.55,Main,Franky,0,0,0,,Ağlamayı durduramıyorum...!Dialogue: 0,0:26:37.17,0:26:38.14,Main,Zoro,0,0,0,,Acele et!Dialogue: 0,0:26:38.14,0:26:39.37,Main,Sanji,0,0,0,,Bu kötü!Dialogue: 0,0:26:40.36,0:26:41.87,Main,Zoro and Sanji,0,0,0,,Luffy!Dialogue: 0,0:26:44.39,0:26:45.81,Main,Luffy,0,0,0,,Zoro, Sanji.Dialogue: 0,0:26:46.43,0:26:47.79,Main,Sanji,0,0,0,,Başımız belada!Dialogue: 0,0:26:48.15,0:26:51.31,Main,Zoro,0,0,0,,Deden geri geldi, Luffy!Dialogue: 0,0:26:51.31,0:26:55.51,Main,Zoro,0,0,0,,O, saldırı düzenlemek için karşı kıyıda ve bizi arıyor!Dialogue: 0,0:26:55.51,0:26:57.40,Main,Luffy,0,0,0,,Ha? Neden?Dialogue: 0,0:26:57.40,0:26:59.47,Main,Luffy,0,0,0,,Bizi yakalamaktan vazgeçmemiş miydi?!Dialogue: 0,0:26:59.94,0:27:01.57,Main,Sanji,0,0,0,,Nerden bilelim?Dialogue: 0,0:27:01.57,0:27:03.35,Main,Sanji,0,0,0,,Acele edin ve çıkmaya hazırlanın!Dialogue: 0,0:27:04.44,0:27:07.39,Main,Sanji,0,0,0,,Franky! Şerefsiz, hala donunu giymedin mi?Dialogue: 0,0:27:08.39,0:27:09.39,Main,Luffy,0,0,0,,Yakala!Dialogue: 0,0:27:13.80,0:27:15.98,Main,Luffy,0,0,0,,Öyleyse, bin, Franky.Dialogue: 0,0:27:15.98,0:27:17.53,Main,Luffy,0,0,0,,Gemime.Dialogue: 0,0:27:18.89,0:27:21.48,Main,Franky,0,0,0,,Kendini bir şeymiş gibi gösterme.Dialogue: 0,0:27:21.48,0:27:24.76,Main,Franky,0,0,0,,Sadece amatörlerin yapabileceği onarımlar ucuz gemilerdir.Dialogue: 0,0:27:24.76,0:27:28.85,Main,Franky,0,0,0,,Eğer bu muhteşem gemide bir tane bile gemi marangozu yoksa...Dialogue: 0,0:27:28.85,0:27:30.41,Main,Franky,0,0,0,,O gemiye acırım.Dialogue: 0,0:27:30.68,0:27:31.81,Main,Franky,0,0,0,,Başka seçenek yok.Dialogue: 0,0:27:31.81,0:27:33.37,Main,Franky,0,0,0,,Sana yardım edeceğim!Dialogue: 0,0:27:33.37,0:27:35.65,Main,Franky,0,0,0,,Senin geminin marangozu...Dialogue: 0,0:27:35.65,0:27:38.09,Main,Franky,0,0,0,,Muhteşem Franky olacak!Dialogue: 0,0:27:38.47,0:27:41.55,Main,Luffy,0,0,0,,Oley! Yeni bir tayfa üyesi!Dialogue: 0,0:27:42.80,0:27:44.10,Main,Chopper,0,0,0,,Başardık!Dialogue: 0,0:27:47.60,0:27:48.80,Main,Mozu and Kiwi,0,0,0,,Abi!Dialogue: 0,0:27:49.21,0:27:49.98,Main,Zambai,0,0,0,,Ağlama...!Dialogue: 0,0:27:49.98,0:27:51.33,Main,Zambai,0,0,0,,Ağlama!Dialogue: 0,0:27:51.33,0:27:54.27,Main,Zambai,0,0,0,,Hasır Şapka-san güvenilir biri!Dialogue: 0,0:28:02.61,0:28:03.94,Main,Franky,0,0,0,,Tom-san...Dialogue: 0,0:28:03.94,0:28:06.67,Main,Franky,0,0,0,,Ben... Bu adadan gidiyorum...Dialogue: 0,0:28:10.85,0:28:14.81,Main,Franky,0,0,0,,Ben sadece baş belası bir öğrenciydim, ancak...Dialogue: 0,0:28:15.05,0:28:18.56,Flashbacks,Citizen,0,0,0,,Duydunuz mu, hurdalıkta olanları?!Dialogue: 0,0:28:18.56,0:28:22.11,Flashbacks,Citizen,0,0,0,,Tom'un çalışanları deniz trenini tamamlamış.Dialogue: 0,0:28:23.22,0:28:25.74,Main,Franky,0,0,0,,Bana göz kulak olduğun için teşekkür ederim!Dialogue: 0,0:28:29.48,0:28:32.06,Main,Franky,0,0,0,,Galley-La marangozları.Dialogue: 0,0:28:32.81,0:28:35.02,Main,Franky,0,0,0,,Iceburg, size emanet!Dialogue: 0,0:28:35.58,0:28:38.99,Main,Franky,0,0,0,,Sen de baş belası bir öğrenciydin...Dialogue: 0,0:28:40.24,0:28:41.62,Main,Franky,0,0,0,,Kokoro nine...Dialogue: 0,0:28:41.62,0:28:42.95,Main,Franky,0,0,0,,Afacanlar...Dialogue: 0,0:28:44.47,0:28:45.47,Main,Franky,0,0,0,,Yokozuna...Dialogue: 0,0:28:45.85,0:28:46.85,Main,Citizens,0,0,0,,Sapık!Dialogue: 0,0:28:46.89,0:28:48.65,Main,Franky,0,0,0,,Hayat dolu şehir insanları...Dialogue: 0,0:28:46.89,0:28:48.24,Secondary,Citizens,0,0,0,,Nereye gidiyorsun?Dialogue: 0,0:28:48.24,0:28:49.41,Secondary,Citizens,0,0,0,,Geri geleceksin, değil mi?Dialogue: 0,0:28:50.20,0:28:51.28,Main,Franky,0,0,0,,Benim kız kardeşlerim...Dialogue: 0,0:28:54.42,0:28:55.82,Main,Franky,0,0,0,,Sodom.Dialogue: 0,0:28:55.82,0:28:56.84,Main,Franky,0,0,0,,Gomorrah.Dialogue: 0,0:28:57.82,0:28:58.82,Main,Franky,0,0,0,,Ve..Dialogue: 0,0:28:59.81,0:29:01.80,Main,Franky,0,0,0,,Çok sevdiğim adamlarım!Dialogue: 0,0:29:24.82,0:29:28.08,Main,Franky,0,0,0,,Bir süreliğine ayrılıyorum!Dialogue: 0,0:29:32.64,0:29:34.30,Main,Sanji,0,0,0,,Donunu giy.