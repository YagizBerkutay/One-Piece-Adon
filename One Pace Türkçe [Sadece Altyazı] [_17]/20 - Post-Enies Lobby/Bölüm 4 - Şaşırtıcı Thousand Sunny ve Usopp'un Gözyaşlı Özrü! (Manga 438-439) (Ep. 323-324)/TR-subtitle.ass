0,0,0,1,1,1,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:23.89,0:00:29.17,Credits,,0,0,0,,Translation Cornman @ Vegapunk FansubsDialogue: 0,0:00:34.07,0:00:37.70,Credits,,0,0,0,,Initial timing Hedi @ Vegapunk FansubsDialogue: 0,0:00:37.91,0:00:41.41,Credits,,0,0,0,,Timing Galaxy 9000Dialogue: 0,0:00:41.58,0:00:44.96,Credits,,0,0,0,,Quality checking SewilDialogue: 0,0:00:45.21,0:00:48.84,Credits,,0,0,0,,Editing SewilDialogue: 0,0:00:54.76,0:00:58.68,Credits,,0,0,0,,Soundtracking MaideV and HaleeDialogue: 0,0:01:00.09,0:01:03.93,Credits,,0,0,0,,Raw providing SOFCJ-RawsDialogue: 0,0:00:14.43,0:00:19.27,Rainbow Star lyrics,,0,0,0,,♪ Kobalt mavisi gökte süzülen bulutlar,...Dialogue: 0,0:00:24.57,0:00:29.25,Rainbow Star lyrics,,0,0,0,,...kayboldu ve yarın hepimizi sırılsıklam edecek. ♪Dialogue: 0,0:00:33.96,0:00:39.09,Rainbow Star lyrics,,0,0,0,,♪ Günbatımından önce sadece gülümsersek her şey iyi olacak. ♪Dialogue: 0,0:00:39.09,0:00:43.48,Rainbow Star lyrics,,0,0,0,,♪ Eğer isteğin buysa, sadece yapabilirsin... ♪Dialogue: 0,0:00:43.60,0:00:45.94,Rainbow Star lyrics,,0,0,0,,♪ Göğsünde bir büyü söyle. ♪Dialogue: 0,0:00:46.52,0:00:49.32,Rainbow Star lyrics,,0,0,0,,♪ Umutlarınız için... ♪Dialogue: 0,0:00:54.79,0:00:56.62,Rainbow Star lyrics,,0,0,0,,♪ Hızlı önsezimiz...Dialogue: 0,0:00:56.62,0:00:59.46,Rainbow Star lyrics,,0,0,0,,...gökkuşağı renkli müzik notalarında gösteriliyor. ♪Dialogue: 0,0:01:02.34,0:01:04.84,Rainbow Star lyrics,,0,0,0,,♪ Benimle gelmeyecek misin? ♪Dialogue: 0,0:01:04.84,0:01:06.68,Rainbow Star lyrics,,0,0,0,,♪ Bizler düşmüş,...Dialogue: 0,0:01:06.68,0:01:09.43,Rainbow Star lyrics,,0,0,0,,...ateşli oklarımızı senin hayallerine yollayacağız. ♪Dialogue: 0,0:01:42.77,0:01:44.61,Rainbow Star lyrics,,0,0,0,,♪ Hangi rengi eklemeliyiz...Dialogue: 0,0:01:44.61,0:01:47.45,Rainbow Star lyrics,,0,0,0,,...kobalt mavisine? ♪Dialogue: 0,0:01:52.87,0:01:57.55,Rainbow Star lyrics,,0,0,0,,♪ Gözlerinde yansıyan üzücü gerçeği yok et. ♪Dialogue: 0,0:01:57.88,0:02:02.80,Rainbow Star lyrics,,0,0,0,,♪ Tüylerimizi sıcaklıkla dolu bir şekilde kaldıralım. ♪Dialogue: 0,0:02:02.80,0:02:04.76,Rainbow Star lyrics,,0,0,0,,♪ Sürreal düşmüş melekler,...Dialogue: 0,0:02:04.76,0:02:07.64,Rainbow Star lyrics,,0,0,0,,...kalbimizden şarkı söylüyorlar. ♪Dialogue: 0,0:05:49.29,0:05:57.29,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - BloodOmen thx to onepace.netDialogue: 0,0:11:44.00,0:11:54.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - BloodOmen thx to onepace.netDialogue: 0,0:26:55.70,0:26:58.70,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - BloodOmen thx to onepace.netDialogue: 0,0:02:31.62,0:02:33.46,Flashbacks,Luffy,0,0,0,,Usopp geri mi geliyor?!Dialogue: 0,0:02:33.94,0:02:34.91,Flashbacks,Sanji,0,0,0,,Evet.Dialogue: 0,0:02:34.91,0:02:37.97,Flashbacks,Sanji,0,0,0,,Sahilde pratik yapıyordu.Dialogue: 0,0:02:41.01,0:02:42.26,Flashbacks,Luffy,0,0,0,,Harbi mi?Dialogue: 0,0:02:42.26,0:02:44.64,Flashbacks,Luffy,0,0,0,,Demek öyle olmuş.Dialogue: 0,0:02:44.64,0:02:46.77,Flashbacks,Luffy,0,0,0,,Öyleyse, onu geri almaya gidiyorum!Dialogue: 0,0:02:48.03,0:02:50.10,Flashbacks,Nami,0,0,0,,Hiçbir şey olmamış gibisin.Dialogue: 0,0:02:51.54,0:02:53.55,Flashbacks,Luffy,0,0,0,,Usopp geri geliyor!Dialogue: 0,0:02:54.72,0:02:55.72,Flashbacks,Zoro,0,0,0,,Bekleyin lan!Dialogue: 0,0:02:56.69,0:03:01.06,Flashbacks,Zoro,0,0,0,,Onu buraya geri getirmeye çalışan hiç kimseyi affetmeyeceğim.Dialogue: 0,0:03:01.06,0:03:02.06,Flashbacks,Luffy,0,0,0,,Neden?Dialogue: 0,0:03:03.37,0:03:06.87,Flashbacks,Zoro,0,0,0,,Ne olursa olsun, alttan alması gereken kişi sen değilsin, Luffy.Dialogue: 0,0:03:06.87,0:03:10.96,Flashbacks,Zoro,0,0,0,,O gelip yalvarana kadar onu kabul etmeyeceğim.Dialogue: 0,0:03:11.28,0:03:12.45,Flashbacks,Chopper,0,0,0,,Zoro!Dialogue: 0,0:03:12.45,0:03:14.44,Flashbacks,Nami,0,0,0,,Hey! Neden bu kadar...Dialogue: 0,0:03:12.45,0:03:14.44,Secondary,Chopper,0,0,0,,Neyin peşindesin?Dialogue: 0,0:03:14.44,0:03:15.44,Flashbacks,Zoro,0,0,0,,Kesin sesinizi!Dialogue: 0,0:03:17.60,0:03:22.17,Flashbacks,Zoro,0,0,0,,Luffy ve Usopp kavga etmeye başladıklarında hissettikleri ne olursa olsun...Dialogue: 0,0:03:22.17,0:03:24.30,Flashbacks,Zoro,0,0,0,,Kim haklı olursa olsun...!Dialogue: 0,0:03:24.62,0:03:26.68,Flashbacks,Zoro,0,0,0,,2 erkek arasında düelloyu talep ettikten sonra,Dialogue: 0,0:03:27.51,0:03:30.18,Flashbacks,Zoro,0,0,0,,mücadelenin sonucuna kendini adamış olmalısın!Dialogue: 0,0:03:34.24,0:03:36.61,Flashbacks,Zoro,0,0,0,,Kaybettikten sonra,Dialogue: 0,0:03:36.61,0:03:38.95,Flashbacks,Zoro,0,0,0,,kendi iradesiyle ayrıldı.Dialogue: 0,0:03:40.04,0:03:41.60,Flashbacks,Zoro,0,0,0,,Herkes dinlesin!Dialogue: 0,0:03:41.60,0:03:43.86,Flashbacks,Zoro,0,0,0,,O bir aptal olsa da, "Kaptan" unvanına sahip.Dialogue: 0,0:03:44.76,0:03:49.62,Flashbacks,Zoro,0,0,0,,Tayfamız, bu adama saygı göstermeyen biri olmadan daha iyi bir yer olur.Dialogue: 0,0:03:50.08,0:03:55.08,Flashbacks,Zoro,0,0,0,,Kaptanlarına saygıyı yitiren bir tayfa, kesinlikle çöker.Dialogue: 0,0:03:59.40,0:04:00.61,Flashbacks,Zoro,0,0,0,,Dinle!Dialogue: 0,0:04:00.61,0:04:02.90,Flashbacks,Zoro,0,0,0,,Her zamanki gibi rahat davranabilirsin amaDialogue: 0,0:04:02.90,0:04:06.80,Flashbacks,Zoro,0,0,0,,eğer liderim bile bir an için başkalarının onun üzerinden geçinmesine izin verirse,Dialogue: 0,0:04:07.15,0:04:09.73,Flashbacks,Zoro,0,0,0,,sonraki sefere, bu tayfadan ayrılan kişi ben olacağım.Dialogue: 0,0:04:09.97,0:04:12.98,Flashbacks,Nami,0,0,0,,Eh! Bu olayı bitirmeyecek ki!Dialogue: 0,0:04:15.41,0:04:19.98,Flashbacks,Zoro,0,0,0,,O aptal geri gelmek istiyorsa, sorun yok.Dialogue: 0,0:04:19.98,0:04:24.60,Flashbacks,Zoro,0,0,0,,Ancak, eğer şu anki konularda bir ayrım yapmazsaDialogue: 0,0:04:24.60,0:04:26.85,Flashbacks,Zoro,0,0,0,,ve kendi çıkarı için hareket ediyorsa,Dialogue: 0,0:04:26.85,0:04:29.24,Flashbacks,Zoro,0,0,0,,o zaman onu asla affetmeyeceğim!Dialogue: 0,0:04:30.29,0:04:33.46,Flashbacks,Zoro,0,0,0,,Eğer öyle olursa, Usopp'u bu adada bırakmak daha iyi olur!Dialogue: 0,0:04:33.89,0:04:35.60,Flashbacks,Nami,0,0,0,,Bekle, Zoro.Dialogue: 0,0:04:35.60,0:04:37.62,Flashbacks,Nami,0,0,0,,Evet doğru bazı hatalar yapmış olabilir amaDialogue: 0,0:04:37.62,0:04:39.98,Flashbacks,Nami,0,0,0,,eğer ona geri döndüğünde şimdi söylediğinizi söylerseniz...Dialogue: 0,0:04:43.71,0:04:47.44,Flashbacks,Zoro,0,0,0,,Tayfayı terk etmek bu kadar kolay mı?Dialogue: 0,0:04:47.44,0:04:49.28,Flashbacks,Nami,0,0,0,,Hayır...Dialogue: 0,0:04:49.28,0:04:50.46,Flashbacks,Nami,0,0,0,,Ama...Dialogue: 0,0:04:50.46,0:04:51.89,Flashbacks,Sanji,0,0,0,,Nami-san.Dialogue: 0,0:04:53.04,0:04:54.99,Flashbacks,Sanji,0,0,0,,Ne yazık ki,Dialogue: 0,0:04:55.73,0:04:57.72,Flashbacks,Sanji,0,0,0,,Sadece bu seferlik, söylediklerinde haklı.Dialogue: 0,0:04:59.12,0:05:04.47,Flashbacks,Zoro,0,0,0,,Bir hevesle böyle bir şey başlatan bir adama da güvenemeyiz.Dialogue: 0,0:05:05.32,0:05:07.55,Flashbacks,Zoro,0,0,0,,Gayet basit bir denklem...Dialogue: 0,0:05:07.55,0:05:10.95,Flashbacks,Zoro,0,0,0,,Eğer Usopp'un ilk söyleyeceği şey derin bir özürse, tamam.Dialogue: 0,0:05:11.40,0:05:12.54,Flashbacks,Zoro,0,0,0,,Eğer öyle olmazsa...Dialogue: 0,0:05:13.52,0:05:15.12,Flashbacks,Zoro,0,0,0,,O zaman, dönecek bir yeri yok.Dialogue: 0,0:05:18.43,0:05:22.13,Flashbacks,Zoro,0,0,0,,Yaptığımız şey çocukça bir korsan oyunu değil!Dialogue: 0,0:05:29.74,0:05:32.00,Flashbacks,Luffy,0,0,0,,Görüşürüz, Usopp.Dialogue: 0,0:05:32.00,0:05:34.19,Flashbacks,Luffy,0,0,0,,Bu zamana kadar geçirdiğimiz vakit güzeldi.Dialogue: 0,0:05:37.33,0:05:38.69,Flashbacks,Luffy,0,0,0,,Haklısın...Dialogue: 0,0:05:39.00,0:05:41.67,Flashbacks,Luffy,0,0,0,,Bir kere tamamen ayrılmıştık.Dialogue: 0,0:05:41.67,0:05:45.42,Flashbacks,Luffy,0,0,0,,Gemi hazır olana kadar hala çok gün var.Dialogue: 0,0:05:46.83,0:05:48.70,Flashbacks,Luffy,0,0,0,,Onu sessizce bekleyeceğiz.Dialogue: 0,0:05:49.29,0:05:57.29,Title,,0,0,0,,Şaşırtıcı Thousand Sunny ve Usopp'un Gözyaşlı Özrü!Dialogue: 0,0:05:57.92,0:05:59.46,Main,Marine,0,0,0,,Koramiral Garp!Dialogue: 0,0:06:00.33,0:06:02.36,Main,Marine,0,0,0,,Hasır Şapka Tayfası'nın yerini tespit ettik!Dialogue: 0,0:06:02.36,0:06:03.67,Main,Marine,0,0,0,,Onlar güneydoğu sahilinde!Dialogue: 0,0:06:03.67,0:06:06.71,Main,Marine,0,0,0,,Şu anda, hurdaların orada kalkış için düzenlemeler yapıyorlar!Dialogue: 0,0:06:06.71,0:06:08.31,Main,Garp,0,0,0,,Hemen peşlerinden gidiyoruz!Dialogue: 0,0:06:08.31,0:06:09.84,Main,Garp,0,0,0,,Herkes gemiye binsin!Dialogue: 0,0:06:09.84,0:06:10.84,Main,Marine,0,0,0,,Emredersiniz!Dialogue: 0,0:06:13.18,0:06:19.24,Main,Coby,0,0,0,,Koramiral Garp, Luffy-san ve diğerleriyle böylesine duygusal bir veda sonrasında yaptığımız utanç verici.Dialogue: 0,0:06:19.24,0:06:21.30,Main,Garp,0,0,0,,Eğer herhangi sorunun varsa, Sengoku'ya anlat!Dialogue: 0,0:06:21.30,0:06:24.21,Main,Garp,0,0,0,,O, bize buraya kızdıktan sonra gönderen kişi!Dialogue: 0,0:06:24.84,0:06:26.35,Main,Garp,0,0,0,,Kendini çok beğeniyor...Dialogue: 0,0:06:27.37,0:06:30.82,Main,Aokiji,0,0,0,,Sonuçta, Den-Den Mushi'de "Çünkü o benim torunum" diyen sensin.Dialogue: 0,0:06:31.26,0:06:34.74,Main,Garp,0,0,0,,Çeneni kapa! Amatör.Dialogue: 0,0:06:34.94,0:06:39.23,Main,Marine,0,0,0,,Amiral, bu şekilde durmanız sizin için uygun mu?Dialogue: 0,0:06:39.23,0:06:41.72,Main,AoKiji,0,0,0,,Bisikletimle geri dönmek zahmetli olur...Dialogue: 0,0:06:41.72,0:06:43.63,Main,AoKiji,0,0,0,,Neyse, bu durumdan uzak duracağım.Dialogue: 0,0:06:44.85,0:06:48.42,Main,Marine,0,0,0,,Sanırım bu iyi bir fikir değil çünkü sonuçta savaşmaya gidiyoruz.Dialogue: 0,0:06:53.64,0:06:57.22,Main,Usopp,0,0,0,,Hadi bakalım! Arkadaşlarımın yanına geri dönüyorum!Dialogue: 0,0:06:57.60,0:06:59.37,Main,Usopp,0,0,0,,Gemi çoktan hazır olmalı.Dialogue: 0,0:06:59.37,0:07:01.23,Main,Usopp,0,0,0,,Herkes beni bekliyordur!Dialogue: 0,0:07:01.89,0:07:04.77,Main,Usopp,0,0,0,,Tek yapılması gereken en doğal şekilde tayfaya geri dönmek.Dialogue: 0,0:07:04.77,0:07:07.42,Main,Usopp,0,0,0,,Evet, sonuçta onlar benim dostlarım.Dialogue: 0,0:07:07.42,0:07:09.57,Main,Usopp,0,0,0,,Sonuçta 100 farklı plan ve stratejim var.Dialogue: 0,0:07:10.29,0:07:14.02,Main,Usopp,0,0,0,,Düşündüğüm üzere, bu "ilk söyleyeceğim şey" konuşmam için en etkili olanı.Dialogue: 0,0:07:14.38,0:07:20.08,Main,Usopp,0,0,0,,Hepiniz sulugöz olduğunuz için, ben de kaptan yardımcısı olarak geri dönmekten mutlu olacağım!Dialogue: 0,0:07:20.08,0:07:22.37,Main,Usopp,0,0,0,,Teşekkür ederiz, yardımcı kaptan Usopp!Dialogue: 0,0:07:24.01,0:07:27.52,Main,Usopp,0,0,0,,Söylediğim her şey geri dönmeye ikna eden sözler!Dialogue: 0,0:07:28.96,0:07:31.22,Main,Usopp,0,0,0,,Benden beklendiği gibi!Dialogue: 0,0:07:31.22,0:07:33.97,Main,Usopp,0,0,0,,Gerçekten, düşenleri ayağa kaldırabilen bir adam!Dialogue: 0,0:07:35.19,0:07:38.16,Main,Usopp,0,0,0,,Herkesin bana olan sevgisi bu olay sonrasında daha fazla artacak!Dialogue: 0,0:07:38.16,0:07:40.86,Main,Usopp,0,0,0,,Mutlu bir şekilde yaşayacağız!Dialogue: 0,0:07:40.86,0:07:43.81,Main,Usopp,0,0,0,,Haydi! Acele edelim!Dialogue: 0,0:07:44.08,0:07:45.77,Main,Usopp,0,0,0,,Bu hüzünlü bir veda!Dialogue: 0,0:07:46.34,0:07:49.49,Main,Usopp,0,0,0,,Su Metropolisi, Water 7!Dialogue: 0,0:07:49.77,0:07:51.99,Main,Luffy,0,0,0,,Ayrılıyoruz!Dialogue: 0,0:07:54.66,0:07:57.59,Main,Franky Family,0,0,0,,Abi!Dialogue: 0,0:07:57.59,0:08:00.62,Main,Franky Family,0,0,0,,Franky Ailesi ölümsüzdür!Dialogue: 0,0:08:00.62,0:08:02.74,Main,Nami,0,0,0,,Hey! Luffy!Dialogue: 0,0:08:02.74,0:08:04.12,Main,Chopper,0,0,0,,Luffy!Dialogue: 0,0:08:04.12,0:08:06.62,Main,Franky,0,0,0,,Bundan emin misin, Hasır Şapka?Dialogue: 0,0:08:06.62,0:08:08.50,Main,Franky,0,0,0,,1 kişiyi hala bekliyoruz.Dialogue: 0,0:08:09.06,0:08:10.69,Main,Luffy,0,0,0,,Bekledik...Dialogue: 0,0:08:10.69,0:08:16.73,Main,Luffy,0,0,0,,O Galley-la odasında her şeyi Sanji'den duyduğumdan beri...Dialogue: 0,0:08:16.73,0:08:20.14,Main,Luffy,0,0,0,,Tüm süre boyunca orada onu bekledik ama gelmedi.Dialogue: 0,0:08:20.14,0:08:21.85,Main,Luffy,0,0,0,,Demek cevabı buymuş.Dialogue: 0,0:08:22.17,0:08:25.35,Main,Luffy,0,0,0,,Sanırım o da bundan memnun olacak.Dialogue: 0,0:08:25.35,0:08:31.03,Main,Luffy,0,0,0,,O bir korsan olmaktan vazgeçmediği için, gelecekte denizlerde onunla karşılaşabiliriz.Dialogue: 0,0:08:35.18,0:08:37.87,Main,Franky,0,0,0,,Lanet olsun! Donanma bizi zaten buldu!Dialogue: 0,0:08:39.43,0:08:40.62,Main,Luffy,0,0,0,,Dede?!Dialogue: 0,0:08:41.13,0:08:43.16,Main,Franky Family,0,0,0,,Bu Koramiral Garp'ın gemisi!Dialogue: 0,0:08:43.16,0:08:46.25,Main,Franky Family,0,0,0,,Abi! Arkanıza bakmadan, kaçın!Dialogue: 0,0:08:47.44,0:08:51.21,Main,Garp,0,0,0,,Hey Luffy! Beni duyuyor musun?Dialogue: 0,0:08:51.21,0:08:53.53,Main,Garp,0,0,0,,Deden burada! Deden!Dialogue: 0,0:08:53.53,0:08:55.59,Main,Garp,0,0,0,,Duyuyorsan cevap ver!Dialogue: 0,0:08:55.86,0:08:57.94,Main,Luffy,0,0,0,,Hey dede! Ne var be?Dialogue: 0,0:08:57.94,0:09:01.58,Main,Luffy,0,0,0,,Burada bizi yakalamayacağını söylemiştin değil mi?!Dialogue: 0,0:09:01.58,0:09:04.04,Main,Garp,0,0,0,,Öyle demiştim ama çok fazla şey oldu!Dialogue: 0,0:09:04.04,0:09:06.83,Main,Garp,0,0,0,,Üzgünüm ama bu denizde öleceksin!Dialogue: 0,0:09:08.40,0:09:10.34,Main,Garp,0,0,0,,Sana verebileceğim bir özür yok amaDialogue: 0,0:09:10.34,0:09:13.40,Main,Garp,0,0,0,,sizi tek başıma halledeceğim!Dialogue: 0,0:09:13.92,0:09:15.08,Main,Garp,0,0,0,,Bana biraz top mermisi verin.Dialogue: 0,0:09:15.89,0:09:17.66,Main,Marine,0,0,0,,Tabii ki.Dialogue: 0,0:09:19.00,0:09:20.08,Main,Sanji,0,0,0,,Ne yapmaya çalışıyor?Dialogue: 0,0:09:21.27,0:09:23.03,Main,Garp,0,0,0,,Genkotsu...Dialogue: 0,0:09:21.27,0:09:23.03,Attack,Garp,0,0,0,,Yumruk...Dialogue: 0,0:09:23.03,0:09:24.53,Main,Garp,0,0,0,,Meteor!Dialogue: 0,0:09:23.03,0:09:24.53,Attack,Garp,0,0,0,,Meteoru!Dialogue: 0,0:09:28.15,0:09:31.11,Main,Sanji,0,0,0,,O-O eliyle bize top mermisi attı!Dialogue: 0,0:09:31.81,0:09:34.03,Main,Zoro,0,0,0,,Bu normal bir topla atılandan çok daha hızlı geldi!Dialogue: 0,0:09:34.03,0:09:35.72,Main,Zoro,0,0,0,,Adeta bir beyzbol atışı gibi!Dialogue: 0,0:09:39.78,0:09:42.31,Main,Garp,0,0,0,,Son zamanlarda gücüm azaldı.Dialogue: 0,0:09:44.33,0:09:46.87,Main,Nami,0,0,0,,Seçeneğimiz yok! Kaçmak durumundayız!Dialogue: 0,0:09:46.87,0:09:49.19,Main,Nami,0,0,0,,Yeni gemimiz patlayabilir!Dialogue: 0,0:09:49.64,0:09:51.37,Main,Garp,0,0,0,,1000 tane daha top mermisi getirin!Dialogue: 0,0:09:51.37,0:09:52.61,Main,Marine,0,0,0,,Emredersiniz!Dialogue: 0,0:09:52.96,0:09:54.10,Main,Franky,0,0,0,,Bu kötü oldu!Dialogue: 0,0:09:54.10,0:09:55.82,Main,Franky,0,0,0,,Bu sefer çok daha fazlası geliyor!Dialogue: 0,0:09:56.10,0:09:57.80,Main,Coby,0,0,0,,Yumruk Meteor Yağmuru mu?!Dialogue: 0,0:09:56.10,0:09:57.80,Note,Coby,0,0,0,,Genkotsu RyuseigunDialogue: 0,0:09:57.80,0:09:58.81,Main,Helmeppo,0,0,0,,Evet.Dialogue: 0,0:09:58.81,0:10:02.87,Main,Helmeppo,0,0,0,,Onu kullanınca buna dayanabilecek hiçbir gemi yok!Dialogue: 0,0:10:05.42,0:10:08.46,Main,Garp,0,0,0,,Öyleyse, başlayalım, veletler.Dialogue: 0,0:10:08.46,0:10:10.29,Main,Luffy,0,0,0,,Son hızda gidelim!Dialogue: 0,0:10:10.29,0:10:12.41,Main,Luffy,0,0,0,,Yoksa top mermileri tarafından vurulacağız!Dialogue: 0,0:10:12.41,0:10:13.41,Main,Zoro,0,0,0,,Anlaşıldı!Dialogue: 0,0:10:14.46,0:10:17.47,Main,Sanji,0,0,0,,Lanet olsun! Gerçekten gelmeyecek mi?Dialogue: 0,0:10:17.90,0:10:19.35,Main,Sanji,0,0,0,,Ne yapıyor?Dialogue: 0,0:10:20.45,0:10:22.60,Main,Chopper,0,0,0,,Orada!Dialogue: 0,0:10:24.08,0:10:26.03,Main,Chopper,0,0,0,,Usopp geldi!Dialogue: 0,0:10:27.08,0:10:30.75,Main,Chopper,0,0,0,,Hey, millet! Usopp geldi!Dialogue: 0,0:10:30.75,0:10:32.02,Main,Robin,0,0,0,,Harbi mi?Dialogue: 0,0:10:32.02,0:10:33.02,Main,Chopper,0,0,0,,Evet!Dialogue: 0,0:10:34.67,0:10:35.76,Main,Usopp,0,0,0,,Yol açın! Yolu açın!Dialogue: 0,0:10:35.76,0:10:36.76,Main,Usopp,0,0,0,,Çekilir misiniz?Dialogue: 0,0:10:37.67,0:10:40.01,Main,Usopp,0,0,0,,Birazcık daha lütfen!Dialogue: 0,0:10:40.01,0:10:41.79,Main,Franky Family,0,0,0,,Hey, burun-abi!Dialogue: 0,0:10:41.79,0:10:43.54,Main,Franky Family,0,0,0,,Burada ne yapıyorsun?Dialogue: 0,0:10:47.62,0:10:48.81,Main,Usopp,0,0,0,,Neler oluyor?Dialogue: 0,0:10:49.72,0:10:52.99,Main,Usopp,0,0,0,,Denizciler gelir gelmez, gemi neden hareket ediyor?!Dialogue: 0,0:10:52.99,0:10:54.80,Main,Franky Family,0,0,0,,Senin gemide olduğundan emindim!Dialogue: 0,0:10:54.80,0:10:57.11,Main,Usopp,0,0,0,,Ne yapıyorsunuz?Dialogue: 0,0:10:57.11,0:10:59.93,Main,Usopp,0,0,0,,Ben hala buradayım!Dialogue: 0,0:11:00.27,0:11:01.35,Main,Usopp,0,0,0,,Neden?Dialogue: 0,0:11:01.35,0:11:02.33,Main,Usopp,0,0,0,,Neden?Dialogue: 0,0:11:02.33,0:11:04.28,Main,Usopp,0,0,0,,Neden?Dialogue: 0,0:11:04.28,0:11:07.77,Main,Usopp,0,0,0,,Kavga ettikten sonra bile sürekli sizinle birlikte savaşıyordum!Dialogue: 0,0:11:13.82,0:11:15.86,Main,Usopp,0,0,0,,Beni unutmanıza imkan yok...Dialogue: 0,0:11:15.86,0:11:20.20,Main,Usopp,0,0,0,,O olayların altında gizlenen keskin nişancı kralı, Sogeking, benim!Dialogue: 0,0:11:22.45,0:11:26.71,Main,Usopp,0,0,0,,Sadece görünüşümü değiştirdiğim için beni unuttunuz mu?Dialogue: 0,0:11:27.43,0:11:28.80,Main,Usopp,0,0,0,,Bekleyin!Dialogue: 0,0:11:30.91,0:11:34.09,Main,Franky Family,0,0,0,,Hey! Merdivenler kırık, dikkatli ol!Dialogue: 0,0:11:34.48,0:11:35.80,Main,Usopp,0,0,0,,Ne oldu? Hey!Dialogue: 0,0:11:39.01,0:11:47.01,Main,Usopp,0,0,0,,Hey arkadaşlar! Sakin olun, hemen geri dönüyorum!Dialogue: 0,0:11:57.36,0:11:58.54,Main,Usopp,0,0,0,,Aptallar!Dialogue: 0,0:12:00.79,0:12:02.65,Main,Usopp,0,0,0,,Durun artık!Dialogue: 0,0:12:12.96,0:12:14.79,Main,Luffy,0,0,0,,Gomu Gomu no...Dialogue: 0,0:12:14.79,0:12:16.14,Main,Luffy,0,0,0,,Fusen!Dialogue: 0,0:12:14.79,0:12:16.14,Attack,Luffy,0,0,0,,Balon!Dialogue: 0,0:12:30.23,0:12:32.00,Main,Chopper,0,0,0,,Usopp geldi, Luffy!Dialogue: 0,0:12:32.00,0:12:33.40,Main,Chopper,0,0,0,,Usopp geldi!Dialogue: 0,0:12:34.32,0:12:36.53,Main,Luffy,0,0,0,,Gemiyi koruyun!Dialogue: 0,0:12:39.60,0:12:43.05,Main,Usopp,0,0,0,,Hey! Neşelenin, ben geldim!Dialogue: 0,0:12:43.76,0:12:46.53,Main,Usopp,0,0,0,,Chopper, bugün hava güzelmiş ya.Dialogue: 0,0:12:46.53,0:12:47.96,Main,Usopp,0,0,0,,Balığa gidelim!Dialogue: 0,0:12:48.96,0:12:50.46,Main,Usopp,0,0,0,,Sanırım bu iş böyle olmayacak.Dialogue: 0,0:12:52.20,0:12:54.58,Main,Usopp,0,0,0,,Bu arada, iyi haberlerim var!Dialogue: 0,0:12:54.58,0:12:59.57,Main,Usopp,0,0,0,,Geri döndüğümde kaptan yardımcısı pozisyonunu alsam bile yeter!Dialogue: 0,0:12:59.57,0:13:01.00,Main,Usopp,0,0,0,,Nasıl olur? Hey!Dialogue: 0,0:13:01.38,0:13:04.96,Main,Usopp,0,0,0,,Hey! Luffy! Millet!Dialogue: 0,0:13:04.96,0:13:06.06,Main,Usopp,0,0,0,,Anladım!Dialogue: 0,0:13:06.69,0:13:09.56,Main,Usopp,0,0,0,,Çok mutlu olduğun için ağlamayı durduramıyorsun, değil mi?Dialogue: 0,0:13:10.18,0:13:12.27,Main,Usopp,0,0,0,,Öyle, değil mi?Dialogue: 0,0:13:13.01,0:13:14.21,Flashbacks,Usopp,0,0,0,,Luffy.Dialogue: 0,0:13:14.21,0:13:17.39,Flashbacks,Usopp,0,0,0,,Artık senle beraber olamam,Dialogue: 0,0:13:17.39,0:13:20.32,Flashbacks,Usopp,0,0,0,,sonuç olarak sana sadece sorun getirdim.Dialogue: 0,0:13:20.90,0:13:24.91,Main,Usopp,0,0,0,,Sizler, o zaman gerçekten o şakaya inandınız mı?!Dialogue: 0,0:13:25.38,0:13:26.96,Main,Usopp,0,0,0,,Uzun zamandır birbirimizi tanıyoruz.Dialogue: 0,0:13:26.96,0:13:30.07,Main,Usopp,0,0,0,,Böyle bir şey hakkında ciddi olmam mümkün değil!Dialogue: 0,0:13:30.07,0:13:32.58,Main,Usopp,0,0,0,,Epeyce tartıştık ama hala arkadaşız!Dialogue: 0,0:13:32.58,0:13:34.92,Main,Usopp,0,0,0,,Bunları arkamızda bırakalım!Dialogue: 0,0:13:35.42,0:13:38.93,Main,Usopp,0,0,0,,Hey! Bir şey söyle!Dialogue: 0,0:13:49.79,0:13:52.27,Main,Usopp,0,0,0,,Benle uğraşmayı kesin!Dialogue: 0,0:14:02.70,0:14:04.65,Main,Chopper,0,0,0,,Luffy, Usopp bizi çağırıyor!Dialogue: 0,0:14:05.55,0:14:06.70,Main,Luffy,0,0,0,,Ben duymuyorum.Dialogue: 0,0:14:08.98,0:14:10.18,Main,Chopper,0,0,0,,Zoro!Dialogue: 0,0:14:10.18,0:14:11.29,Main,Zoro,0,0,0,,Ben hiçbir şey duyamıyorum!Dialogue: 0,0:14:11.29,0:14:13.16,Main,Chopper,0,0,0,,Yalancı! Onu duyabiliyorsun!Dialogue: 0,0:14:14.01,0:14:16.83,Main,Usopp,0,0,0,,Şakayı kesin.Dialogue: 0,0:14:18.19,0:14:19.19,Main,Usopp,0,0,0,,Ne oluyor...Dialogue: 0,0:14:19.53,0:14:21.95,Main,Usopp,0,0,0,,Gerçekten beni bırakacak mısınız?Dialogue: 0,0:14:22.60,0:14:24.80,Main,Usopp,0,0,0,,Anladım... Bu yeterli.Dialogue: 0,0:14:28.17,0:14:29.88,Main,Usopp,0,0,0,,Eğer öyle istiyorsanız,Dialogue: 0,0:14:30.74,0:14:34.79,Main,Usopp,0,0,0,,Size söyleyeceğim sadece bir şey daha var...Dialogue: 0,0:14:35.33,0:14:37.61,Flashbacks,Usopp,0,0,0,,Nereye gideceğim bundan sonra sadece beni ilgilendirir...Dialogue: 0,0:14:37.95,0:14:40.76,Flashbacks,Usopp,0,0,0,,Sizi alakadar etmez.Dialogue: 0,0:14:41.83,0:14:47.28,Flashbacks,Usopp,0,0,0,,Tayfadan ayrılıyorum!Dialogue: 0,0:14:49.11,0:14:52.49,Main,Usopp,0,0,0,,Üzgünüm!Dialogue: 0,0:14:52.49,0:14:55.36,Main,Usopp,0,0,0,,Inatçılığım için özür dilerim!Dialogue: 0,0:14:55.36,0:14:59.21,Main,Usopp,0,0,0,,Hatalıydım!Dialogue: 0,0:15:03.42,0:15:04.71,Main,Zoro,0,0,0,,Usopp!Dialogue: 0,0:15:07.98,0:15:10.44,Main,Usopp,0,0,0,,Şimdiye kadar inatçı olsam da...!Dialogue: 0,0:15:10.44,0:15:13.72,Main,Usopp,0,0,0,,Tayfayı terk edeceğimi söylememe rağmen...!Dialogue: 0,0:15:15.66,0:15:19.18,Main,Usopp,0,0,0,,Her şeyi değiştirmek istiyorum, ama yapamıyorum!Dialogue: 0,0:15:19.82,0:15:23.89,Main,Usopp,0,0,0,,Yapamıyorum, bu yüzden yalvarıyorum!Dialogue: 0,0:15:26.96,0:15:33.28,Main,Usopp,0,0,0,,Lütfen beni aranıza geri alın!Dialogue: 0,0:15:33.83,0:15:35.73,Main,Usopp,0,0,0,,Bir kez daha...!Dialogue: 0,0:15:35.73,0:15:40.16,Main,Usopp,0,0,0,,Tayfaya beni de katın!Dialogue: 0,0:15:52.40,0:15:54.28,Main,Usopp,0,0,0,,Luffy...Dialogue: 0,0:15:54.28,0:15:56.35,Main,Luffy,0,0,0,,Aptal!Dialogue: 0,0:15:56.35,0:15:58.72,Main,Luffy,0,0,0,,Acele et ve tutun!Dialogue: 0,0:16:03.71,0:16:05.23,Main,Zoro,0,0,0,,Aptal olan sensin!Dialogue: 0,0:16:08.02,0:16:10.19,Main,Nami,0,0,0,,İkinizde acınasınız.Dialogue: 0,0:16:11.58,0:16:14.24,Main,Luffy,0,0,0,,Sonunda hepimiz toplandık!Dialogue: 0,0:16:14.24,0:16:18.83,Main,Luffy,0,0,0,,Haydi hemen bu bombardmandan kaçıp daha fazla maceraya atılalım, millet!Dialogue: 0,0:16:27.70,0:16:30.20,Main,Citizens,0,0,0,,Elinizden geleni yapın, şehrin kahramanları!Dialogue: 0,0:16:30.20,0:16:32.55,Main,Citizen,0,0,0,,Kaçamadan ezilecekler!Dialogue: 0,0:16:32.55,0:16:35.30,Main,Citizen,0,0,0,,Hey! Onları teşvik etmemelisiniz!Dialogue: 0,0:16:35.30,0:16:38.22,Main,Zambai,0,0,0,,Vazgeçmeyin! Hasır Şapkalar!Dialogue: 0,0:16:38.22,0:16:40.79,Main,FF,0,0,0,,Kaçın! Kaçın! Kaçın!Dialogue: 0,0:16:40.79,0:16:43.66,Main,ff,0,0,0,,Abi!Dialogue: 0,0:16:53.07,0:16:54.22,Main,Coby,0,0,0,,Bu ne...?Dialogue: 0,0:16:54.22,0:16:56.14,Main,Helmeppo,0,0,0,,Bu ne demek oluyor?Dialogue: 0,0:16:56.14,0:16:57.49,Main,Helmeppo,0,0,0,,Yelkenleri sarmaya başladılar mı?Dialogue: 0,0:16:59.63,0:17:01.67,Main,Marine,0,0,0,,Pes mi ettiler?Dialogue: 0,0:17:01.67,0:17:02.87,Main,Garp,0,0,0,,Pes mi?Dialogue: 0,0:17:04.75,0:17:06.86,Main,Garp,0,0,0,,Bu değil, ama...Dialogue: 0,0:17:06.86,0:17:09.31,Main,Garp,0,0,0,,Neyin peşindesin, Luffy?Dialogue: 0,0:17:09.31,0:17:12.14,Main,Franky,0,0,0,,Acele edin! Yelkenleri kapatın!Dialogue: 0,0:17:12.14,0:17:14.85,Main,Zoro,0,0,0,,Hey! Bundan emin misin, Franky?Dialogue: 0,0:17:14.85,0:17:17.36,Main,Franky,0,0,0,,Aptal! Bu gemiye inan!Dialogue: 0,0:17:17.36,0:17:19.75,Main,Luffy,0,0,0,,Evet öyle! İnanmalısın, aptal!Dialogue: 0,0:17:19.75,0:17:21.59,Main,Usopp,0,0,0,,Salak! Moron!Dialogue: 0,0:17:22.63,0:17:26.12,Main,Nami,0,0,0,,Usopp, sadece biraz önce sen...Dialogue: 0,0:17:26.12,0:17:27.13,Main,Nami,0,0,0,,Neyse... Öyle olsun...Dialogue: 0,0:17:27.13,0:17:28.27,Main,Zoro,0,0,0,,Yardım edin, yavşaklar!Dialogue: 0,0:17:29.79,0:17:30.81,Main,Sanji,0,0,0,,Adı mı?!Dialogue: 0,0:17:30.81,0:17:31.78,Main,Sanji,0,0,0,,Böyle bir zamanda mı?!Dialogue: 0,0:17:31.78,0:17:35.86,Main,Franky,0,0,0,,Evet, adı olmayan bir gemi iyi bir şekilde yol alamaz.Dialogue: 0,0:17:38.47,0:17:40.49,Main,Sanji,0,0,0,,Bakalım, aslanlı bir şey olması gerekiyor.Dialogue: 0,0:17:40.49,0:17:41.42,Main,Luffy,0,0,0,,Tamamdır!Dialogue: 0,0:17:41.42,0:17:43.70,Main,Luffy,0,0,0,,Ben çok iyi bir isim düşündüm!Dialogue: 0,0:17:43.70,0:17:44.31,Main,Luffy,0,0,0,,Ayı!Dialogue: 0,0:17:44.31,0:17:45.97,Main,Luffy,0,0,0,,Kutup Ayı Aslanı!Dialogue: 0,0:17:45.97,0:17:48.64,Main,Usopp,0,0,0,,Gemiye garip isimler verme!Dialogue: 0,0:17:48.64,0:17:50.56,Main,Luffy,0,0,0,,Öyleyse, Kaplan Kurt Aslanı!Dialogue: 0,0:17:50.56,0:17:52.40,Main,Usopp,0,0,0,,Şu hayvanları kombine etmeyi kes!Dialogue: 0,0:17:52.40,0:17:53.49,Main,Usopp,0,0,0,,Sanki bir lanet gibi!Dialogue: 0,0:17:53.49,0:17:54.96,Main,Luffy,0,0,0,,Kalamar! Ahtapot! Şempanze!Dialogue: 0,0:17:54.96,0:17:56.41,Main,Usopp,0,0,0,,İçinde aslan olmadan mı?Dialogue: 0,0:17:57.33,0:17:59.99,Main,Franky,0,0,0,,Düşünüce, aslan bir gemi için iyi bir isim.Dialogue: 0,0:17:59.99,0:18:03.05,Main,Franky,0,0,0,,Galley-La'dan adamlar bile anlamadılar.Dialogue: 0,0:18:03.05,0:18:05.16,Flashbacks,Paulie,0,0,0,,Bu büyük kafa iyi iş görür.Dialogue: 0,0:18:05.16,0:18:07.37,Flashbacks,Tilestone,0,0,0,,Evet, ayçiceği güzel duruyor!Dialogue: 0,0:18:07.37,0:18:09.02,Flashbacks,Franky,0,0,0,,Öyle değil, aptallar!Dialogue: 0,0:18:10.74,0:18:13.57,Flashbacks,Iceburg,0,0,0,,Yani, hatalı olduğunuz için sizi suçlayamam...Dialogue: 0,0:18:14.13,0:18:16.94,Flashbacks,Iceburg,0,0,0,,Ama bu gemi ileride korsanlar kralının gemisi olacak.Dialogue: 0,0:18:16.94,0:18:19.41,Flashbacks,Iceburg,0,0,0,,Evet, bunu umuyordun değil mi Franky?Dialogue: 0,0:18:19.41,0:18:20.55,Flashbacks,Franky,0,0,0,,Öyle.Dialogue: 0,0:18:20.55,0:18:25.39,Flashbacks,Franky,0,0,0,,Vahşi bir hayvan gibi denizleri dolaşmak ve zirveye ulaşmak için uygun bir gemi!Dialogue: 0,0:18:25.39,0:18:26.76,Flashbacks,Iceburg,0,0,0,,Gerçekten harika bir güneş.Dialogue: 0,0:18:26.76,0:18:28.32,Flashbacks,Franky,0,0,0,,O değil, aptal!Dialogue: 0,0:18:28.32,0:18:35.49,Flashbacks,Iceburg,0,0,0,,1000 denizi neşeyle aşabilen, güneş kadar parlak ve güçlü bir gemi..Dialogue: 0,0:18:35.49,0:18:36.90,Flashbacks,Iceburg,0,0,0,,Bu sözlere uyan bir gemi.Dialogue: 0,0:18:36.90,0:18:39.09,Flashbacks,Franky,0,0,0,,Öyle olmadığını söyledim ya, aptal-burg!Dialogue: 0,0:18:39.61,0:18:42.18,Flashbacks,Iceburg,0,0,0,,Gemi için bu isim nasıl sence, Franky?Dialogue: 0,0:18:44.43,0:18:45.43,Flashbacks,Iceburg,0,0,0,,Korsan Gemisi...Dialogue: 0,0:18:46.87,0:18:49.16,Flashbacks,Iceburg,0,0,0,,Thousand Sunny!Dialogue: 0,0:18:46.87,0:18:49.16,Note,Iceburg,0,0,0,,Bin GüneşliDialogue: 0,0:18:50.14,0:18:51.92,Main,Chopper,0,0,0,,Çok havalı!Dialogue: 0,0:18:51.92,0:18:55.76,Main,Luffy,0,0,0,,Şu anda aklıma gelen  Dango Goril Aslan isminden çok daha iyi!Dialogue: 0,0:18:55.76,0:18:57.15,Main,Usopp,0,0,0,,Scrabble mi oynuyorsun?Dialogue: 0,0:18:57.60,0:19:01.82,Main,Zoro,0,0,0,,Bu, düşündüğüm  "Aslan Usta" isminden bile daha iyi.Dialogue: 0,0:19:01.82,0:19:04.20,Main,Robin,0,0,0,,Benim "Karanlığın Varlığım" dan daha iyi...Dialogue: 0,0:19:04.20,0:19:06.17,Main,Sanji,0,0,0,,Ve benim "Mösyö Ayçiçeğim" den daha iyi.Dialogue: 0,0:19:06.17,0:19:08.14,Main,Usopp,0,0,0,,Aklınızı mı kaçırdınız!Dialogue: 0,0:19:08.76,0:19:12.33,Main,Robin,0,0,0,,Bin denizi aşabilen bir gemi kulağa güzel geliyor...Dialogue: 0,0:19:12.33,0:19:14.02,Main,Robin,0,0,0,,Güneşli kısım da öyle.Dialogue: 0,0:19:14.02,0:19:15.63,Main,Franky,0,0,0,,Bekleyin millet!Dialogue: 0,0:19:15.63,0:19:17.33,Main,Franky,0,0,0,,Bu sadece bir başlangıç.Dialogue: 0,0:19:17.33,0:19:19.91,Main,Franky,0,0,0,,Onun için belirlediğim kesin isim bu...Dialogue: 0,0:19:19.91,0:19:20.56,Main,Franky,0,0,0,,Dinleyin!Dialogue: 0,0:19:20.56,0:19:22.01,Main,Franky,0,0,0,,Bu geminin ismi...!Dialogue: 0,0:19:22.25,0:19:25.64,Main,Luffy,0,0,0,,Buz Amca'nın ismiyle devam edelim, hoşuma gitti!Dialogue: 0,0:19:22.25,0:19:25.65,Secondary,Franky,0,0,0,,Yeni Savaş Franky Lion Çetesi Şampiyonu!Dialogue: 0,0:19:25.65,0:19:27.85,Main,Sanji,0,0,0,,Thousand Sunny, iyi isim.Dialogue: 0,0:19:26.09,0:19:27.85,Secondary,Franky,0,0,0,,Lion Çetesi Şampiyonu!Dialogue: 0,0:19:27.85,0:19:28.70,Main,Usopp and Nami,0,0,0,,Katılıyorum!Dialogue: 0,0:19:28.70,0:19:30.12,Main,Chopper,0,0,0,,Tanıştığımıza memnun oldum, Sunny!Dialogue: 0,0:19:30.12,0:19:33.77,Main,Zoro,0,0,0,,Şimdi ad belirlendiğine göre, seyahatimiz sonunda başlamış durumda.Dialogue: 0,0:19:33.77,0:19:35.08,Main,Robin,0,0,0,,Öyle evet.Dialogue: 0,0:19:36.58,0:19:37.86,Main,Sanji,0,0,0,,Hey, Franky!Dialogue: 0,0:19:37.86,0:19:39.88,Main,Sanji,0,0,0,,Orada ne için mızmızlık ediyorsun?Dialogue: 0,0:19:39.88,0:19:42.90,Main,Sanji,0,0,0,,Elini çabuk tut ve bu sözde gizli silahı ortaya çıkar!Dialogue: 0,0:19:42.90,0:19:44.23,Main,Zoro,0,0,0,,Evet, acele et!Dialogue: 0,0:19:44.23,0:19:46.07,Main,Zoro,0,0,0,,Savaş gemisi neredeyse bize yetişti!Dialogue: 0,0:19:46.07,0:19:47.64,Main,Franky,0,0,0,,Biliyorum! Anladık!Dialogue: 0,0:19:48.03,0:19:52.09,Main,Franky,0,0,0,,Bu güzel Su Metropolü'ne son bir kez bakın.Dialogue: 0,0:19:52.09,0:19:55.60,Main,Franky,0,0,0,,Saniyeler içinde, bu adanın gölgesini bile göremeyeceksiniz!Dialogue: 0,0:19:55.60,0:19:56.86,Main,Luffy,0,0,0,,Anladım.Dialogue: 0,0:19:57.70,0:20:00.13,Main,Luffy,0,0,0,,Dedem!Dialogue: 0,0:20:00.84,0:20:03.58,Main,Luffy,0,0,0,,Bir de, Coby ve...!Dialogue: 0,0:20:04.65,0:20:06.88,Main,Luffy,0,0,0,,Uzun zaman sonra sizi görmek beni çok mutlu etti!Dialogue: 0,0:20:06.88,0:20:08.56,Main,Helmeppo,0,0,0,,Adımı söylesene!Dialogue: 0,0:20:09.24,0:20:10.88,Main,Garp,0,0,0,,Ne diyorsun, Luffy?!Dialogue: 0,0:20:10.88,0:20:13.02,Main,Garp,0,0,0,,Hala topum var!Dialogue: 0,0:20:13.02,0:20:15.07,Main,Garp,0,0,0,,Genkotsu...Dialogue: 0,0:20:13.02,0:20:15.07,Attack,Garp,0,0,0,,Yumruk...Dialogue: 0,0:20:15.07,0:20:16.31,Main,Garp,0,0,0,,Meteor!Dialogue: 0,0:20:15.07,0:20:16.31,Attack,Garp,0,0,0,,Meteoru!Dialogue: 0,0:20:20.71,0:20:21.76,Main,Luffy,0,0,0,,İşe yaramaz!Dialogue: 0,0:20:23.07,0:20:25.74,Main,Luffy,0,0,0,,Artık kaçma konusunda ciddi olacağız!Dialogue: 0,0:20:27.24,0:20:29.45,Main,Luffy,0,0,0,,Bir gün tekrar görüşelim!Dialogue: 0,0:20:29.45,0:20:31.49,Thoughts,Coby,0,0,0,,Luffy-san çok havalı!Dialogue: 0,0:20:31.49,0:20:32.45,Main,Garp,0,0,0,,Şerefsiz!Dialogue: 0,0:20:32.45,0:20:36.95,Main,Garp,0,0,0,,Sen benim oğlumun oğlusun ama yine de beni küçümsemeye cüret ediyorsun, Luffy!Dialogue: 0,0:20:36.95,0:20:39.29,Main,Helmeppo,0,0,0,,Koramiral Garp, lütfen sakin olun!Dialogue: 0,0:20:39.29,0:20:41.41,Main,Luffy,0,0,0,,Buz Amca!Dialogue: 0,0:20:41.41,0:20:43.74,Main,Luffy,0,0,0,,Gemiye isim verdik sonunda!Dialogue: 0,0:20:43.74,0:20:46.00,Main,Luffy,0,0,0,,Bu kadar iyi isim önerisinde bulunduğun için teşekkür ederiz!Dialogue: 0,0:20:46.00,0:20:49.00,Main,Luffy,0,0,0,,Millet! Her şey için teşekkür ederiz!Dialogue: 0,0:20:49.00,0:20:50.89,Main,Luffy,0,0,0,,Gidiyoruz!Dialogue: 0,0:20:51.51,0:20:53.39,Main,Chimney,0,0,0,,Sanki bir şeyler söylüyor!Dialogue: 0,0:20:55.18,0:20:57.30,Main,Kokoro,0,0,0,,Onu duyamıyorum.Dialogue: 0,0:20:57.30,0:21:00.35,Main,Iceburg,0,0,0,,Görünüşe göre korsan olanlar sessizce yola çıkamazlar.Dialogue: 0,0:21:01.38,0:21:03.30,Main,Franky,0,0,0,,Hadi, gidelim artık!Dialogue: 0,0:21:03.30,0:21:06.94,Main,Franky,0,0,0,,Adem odunu ile güçlendirilmiş dev hava topu!Dialogue: 0,0:21:06.94,0:21:09.95,Main,Franky,0,0,0,,Mucizevi Acil Hızlandırma Cihazı!Dialogue: 0,0:21:10.66,0:21:12.79,Main,Garp,0,0,0,,Beni küçümsemeye cüret edersen...!Dialogue: 0,0:21:14.15,0:21:16.81,Main,Coby,0,0,0,,Kaçın! Luffy-san!Dialogue: 0,0:21:16.81,0:21:18.70,Main,Coby,0,0,0,,Harbi öleceksiniz!Dialogue: 0,0:21:19.55,0:21:21.05,Main,Luffy,0,0,0,,Franky, acele et!Dialogue: 0,0:21:22.83,0:21:24.33,Main,Garp,0,0,0,,Bu acıtacak!Dialogue: 0,0:21:32.43,0:21:34.14,Main,SH Crew,0,0,0,,Öleceğiz!Dialogue: 0,0:21:34.39,0:21:36.41,Main,Franky,0,0,0,,Coup deDialogue: 0,0:21:34.39,0:21:36.41,Attack,Franky,0,0,0,,PatlamaDialogue: 0,0:21:36.41,0:21:38.52,Main,Franky,0,0,0,,Burst!Dialogue: 0,0:21:36.41,0:21:38.52,Attack,Franky,0,0,0,,Vuruşu!Dialogue: 0,0:21:50.86,0:21:52.54,Main,Marines,0,0,0,,Gemi...!Dialogue: 0,0:21:52.54,0:21:54.28,Main,Marines,0,0,0,,Uçarak kaçtı!Dialogue: 0,0:22:04.59,0:22:06.49,Main,Garp,0,0,0,,Başardılar...Dialogue: 0,0:22:13.56,0:22:16.21,Main,Luffy,0,0,0,,İnanılmaz!Dialogue: 0,0:22:16.21,0:22:18.83,Main,Usopp,0,0,0,,Bu hissi hatırlıyorum!Dialogue: 0,0:22:23.35,0:22:24.54,Main,Usopp,0,0,0,,Merry.Dialogue: 0,0:22:25.17,0:22:28.45,Main,Franky,0,0,0,,Bu hareket üç varil kola kullanır ancak bizi 1 km uzağa fırlatabilir.Dialogue: 0,0:22:28.79,0:22:34.45,Main,Franky,0,0,0,,Bindiğiniz Going Merry adlı geminin yapıp, bunun yapamayacağı hiçbir şey yok.Dialogue: 0,0:22:34.45,0:22:35.92,Main,Franky,0,0,0,,Birçok konuda daha iyi!Dialogue: 0,0:22:36.51,0:22:41.58,Main,Franky,0,0,0,,Ancak, o geminin cesur ruhu Thousand Sunny'de yaşıyor!Dialogue: 0,0:22:42.19,0:22:44.71,Main,Franky,0,0,0,,Eğer hasar alırsa, onu tamamen yenileyip, düzelteceğim!Dialogue: 0,0:22:45.25,0:22:48.01,Main,Franky,0,0,0,,Gemi bakımı ve silahlarla ilgili her şeyi bana bırakabilirsin!Dialogue: 0,0:22:48.01,0:22:51.68,Main,Franky,0,0,0,,Bugünden itibaren, bu sizin geminiz!Dialogue: 0,0:23:01.33,0:23:03.21,Main,Garp,0,0,0,,Aman be...Dialogue: 0,0:23:03.21,0:23:04.79,Main,Garp,0,0,0,,Kaçtılar...Dialogue: 0,0:23:08.09,0:23:10.47,Main,Garp,0,0,0,,Torunumdan bekleneceği gibi.Dialogue: 0,0:23:21.38,0:23:24.27,Main,Kashi,0,0,0,,Bizimle gelmemeyi tercih etti sonuçta.Dialogue: 0,0:23:24.27,0:23:25.82,Main,Oimo,0,0,0,,Öyle oldu.Dialogue: 0,0:23:25.82,0:23:30.75,Main,Oimo,0,0,0,,Ancak Keskin Nişancı Kralı bir gün Elbaf'ı ziyaret edeceğine söz verdi.Dialogue: 0,0:23:30.75,0:23:31.79,Main,Kashi,0,0,0,,Dört gözle bekliyorum.Dialogue: 0,0:23:31.79,0:23:35.51,Main,Oimo,0,0,0,,Sabırlı bir şekilde bekleyebiliriz; sonuçta bir Dev'in ömrü 300 yıldır.Dialogue: 0,0:23:36.65,0:23:38.29,Main,Tilestone,0,0,0,,İyi iş yaptık he!Dialogue: 0,0:23:38.29,0:23:39.79,Main,Paulie,0,0,0,,Aynen.Dialogue: 0,0:23:39.79,0:23:41.49,Main,Paulie,0,0,0,,Öyleyse o zaman karargaha geri dönme vakti geldi.Dialogue: 0,0:23:41.49,0:23:43.47,Main,People,0,0,0,,Hep beraber gidelim!Dialogue: 0,0:23:43.47,0:23:44.59,Main,Lulu,0,0,0,,Hala yapacak çok işimiz var!Dialogue: 0,0:23:48.75,0:23:50.74,Main,Kokoro,0,0,0,,İstasyona geri dönelim.Dialogue: 0,0:23:50.74,0:23:52.20,Main,Kokoro,0,0,0,,Chimney, Gonbe.Dialogue: 0,0:23:53.11,0:23:54.52,Main,Zambai,0,0,0,,Öyleyse...Dialogue: 0,0:23:54.52,0:23:56.19,Main,Zambai,0,0,0,,Abimiz yokken ne yapacağız acaba?Dialogue: 0,0:23:56.19,0:23:57.72,Main,Person,0,0,0,,Hiçbir fikrim yok.Dialogue: 0,0:23:57.72,0:24:00.51,Main,FF,0,0,0,,Şimdiye kadar sadece abimiz ne derse onu yaptık.Dialogue: 0,0:24:01.24,0:24:02.96,Main,FF,0,0,0,,Açlıktan öleceğiz.Dialogue: 0,0:24:03.18,0:24:04.74,Main,Zambai,0,0,0,,Iceburg!Dialogue: 0,0:24:05.88,0:24:07.40,Main,Iceburg,0,0,0,,Bunun olacağını düşünmüştüm...Dialogue: 0,0:24:07.40,0:24:08.65,Main,Zambai,0,0,0,,Ne istiyorsun?Dialogue: 0,0:24:08.65,0:24:09.84,Main,Zambai,0,0,0,,Neden buraya geldin?Dialogue: 0,0:24:10.40,0:24:12.49,Main,Iceburg,0,0,0,,Eğer iş arıyorsanuz, size bunu verebilirim.Dialogue: 0,0:24:12.49,0:24:15.16,Main,Iceburg,0,0,0,,Günde bir kişiyi Galley-La ofisine gönderin.Dialogue: 0,0:24:15.16,0:24:17.95,Main,Zambai,0,0,0,,Emin misin, Ice...?!Dialogue: 0,0:24:17.95,0:24:18.67,Main,Zambai,0,0,0,,Hayır!Dialogue: 0,0:24:18.67,0:24:19.85,Main,Zambai,0,0,0,,Abi!Dialogue: 0,0:24:19.85,0:24:21.84,Main,Franky Family,0,0,0,,Yeni abimiz!Dialogue: 0,0:24:21.84,0:24:22.89,Main,Iceburg,0,0,0,,Kesin şunu.Dialogue: 0,0:24:25.07,0:24:29.63,Captions small,TL,0,0,270,, Grand Line'daDialogue: 0,0:24:25.07,0:24:29.63,Captions small,TL,0,0,135,,bir adanın bir yerindeDialogue: 0,0:24:27.41,0:24:28.36,Main,Marine,0,0,0,,Albay Smoker!Dialogue: 0,0:24:28.36,0:24:29.63,Main,Marine,0,0,0,,İyi iş!Dialogue: 0,0:24:30.82,0:24:33.02,Main,Smoker,0,0,0,,Bu korsanın ödülünün 50 milyon mu olduğunu söylüyorsun?Dialogue: 0,0:24:34.04,0:24:35.20,Main,Smoker,0,0,0,,Fazla kolay...Dialogue: 0,0:24:35.20,0:24:37.51,Main,Smoker,0,0,0,,Donanma'nın standardlarına ne oldu böyle?Dialogue: 0,0:24:37.51,0:24:38.08,Main,Smoker,0,0,0,,Aman...Dialogue: 0,0:24:38.08,0:24:39.64,Main,Smoker,0,0,0,,Her gün aynı şey...Dialogue: 0,0:24:39.89,0:24:41.21,Main,Tashigi,0,0,0,,Smoker-san!Dialogue: 0,0:24:41.21,0:24:42.25,Main,Tashigi,0,0,0,,Asteğmen Tashigi!Dialogue: 0,0:24:43.15,0:24:45.12,Main,Tashigi,0,0,0,,Arama posterlerini gördünüz mü?Dialogue: 0,0:24:45.12,0:24:46.12,Main,Tashigi,0,0,0,,Hasır Şapkalar...Dialogue: 0,0:24:46.24,0:24:47.98,Main,Smoker,0,0,0,,Kiminle konuşuyorsun?Dialogue: 0,0:24:49.14,0:24:50.57,Main,Tashigi,0,0,0,,Pardon.Dialogue: 0,0:24:50.57,0:24:52.42,Main,Smoker,0,0,0,,Gözlüklerini tak, aptal!Dialogue: 0,0:24:52.45,0:24:57.42,Captions small,TL,0,0,0,, Grand LineDialogue: 0,0:24:52.45,0:24:57.42,Captions small,TL,0,0,0,,Çöl Krallığı ArabastaDialogue: 0,0:24:55.56,0:24:57.42,Main,Igaram,0,0,0,,Ne...?!Dialogue: 0,0:24:57.78,0:24:59.08,Main,Igaram,0,0,0,,Nico Robin?!Dialogue: 0,0:24:59.08,0:25:02.59,Main,Igaram,0,0,0,,"Bayan All Sunday", Luffy-kun'un tayfasında ne yapıyor?!Dialogue: 0,0:25:02.94,0:25:06.73,Main,Igaram,0,0,0,,Evet kesinlikle gizemli bir kadındı ama...Dialogue: 0,0:25:07.49,0:25:11.67,Main,Igaram,0,0,0,,Eğer bu Vivi-sama'nın kulağına ulaşırsa, gerçekten üzülecektir.Dialogue: 0,0:25:12.06,0:25:14.52,Main,Vivi,0,0,0,,Oh? Bu mu? Biliyordum ama...Dialogue: 0,0:25:14.52,0:25:15.52,Main,Vivi,0,0,0,,Önemli değil.Dialogue: 0,0:25:15.96,0:25:17.24,Main,Igaram,0,0,0,,Önemli değil mi?Dialogue: 0,0:25:17.24,0:25:19.33,Main,Igaram,0,0,0,,Biz en çok senin şaşıracağını düşünmüştük!Dialogue: 0,0:25:20.55,0:25:24.23,Main,Vivi,0,0,0,,Luffy-san'ın ne düşündüğünü, çok yakın birisi olsanız bile anlamazsınız.Dialogue: 0,0:25:25.25,0:25:27.00,Main,Vivi,0,0,0,,Düşünmeye gerek yok.Dialogue: 0,0:25:27.00,0:25:30.26,Main,Vivi,0,0,0,,Ancak, onun yaptığı her şeye inanıyorum.Dialogue: 0,0:25:30.82,0:25:33.48,Main,Vivi,0,0,0,,O korsanlar kralı olacak kişi.Dialogue: 0,0:25:34.63,0:25:36.66,Main,Vivi,0,0,0,,Bizden farklı bir seviyede.Dialogue: 0,0:25:37.59,0:25:39.00,Main,Igaram,0,0,0,,Ne kadar anlayışlı!Dialogue: 0,0:25:39.00,0:25:41.55,Main,Igaram,0,0,0,,Büyümüşsün, Vivi-sama!Dialogue: 0,0:25:42.56,0:25:44.65,Main,Vivi,0,0,0,,Hey, neden ağlıyorsun?Dialogue: 0,0:25:50.69,0:25:52.23,Main,Smoker,0,0,0,,Donanma donanmadır...Dialogue: 0,0:25:52.71,0:25:57.82,Main,Smoker,0,0,0,,Deniz Kuvvetleri bir kuruluş olduğu sürece, istediğimi yapma konusunda bir sınır var.Dialogue: 0,0:25:58.15,0:26:00.16,Main,Smoker,0,0,0,,Şu anda en önemli şey rütbe.Dialogue: 0,0:26:00.85,0:26:06.12,Main,Smoker,0,0,0,,Enies Lobby olaylarından sonra, dünyadaki tüm korsanlar Hasır Şapka Korsanlarına saygı göstermeye başlayacaklar.Dialogue: 0,0:26:07.15,0:26:08.15,Main,Tashigi,0,0,0,,Evet.Dialogue: 0,0:26:10.22,0:26:12.52,Main,Smoker,0,0,0,,Onurum adına yemin ederim ki...Dialogue: 0,0:26:12.52,0:26:15.25,Main,Smoker,0,0,0,,Onu Yeni Dünya'da ezeceğim!Dialogue: 0,0:26:19.20,0:26:20.63,Main,Luffy,0,0,0,,Millet!Dialogue: 0,0:26:23.54,0:26:24.54,Main,Luffy,0,0,0,,Hazır mısınız?!Dialogue: 0,0:26:24.66,0:26:26.07,Main,Crew,0,0,0,,Evet!Dialogue: 0,0:26:26.07,0:26:29.83,Main,Luffy,0,0,0,,Öyleyse, Robin ve Usopp'un geri dönüşü içinDialogue: 0,0:26:29.83,0:26:33.09,Main,Luffy,0,0,0,,ve yeni üyelerimiz adına, Franky ve...Dialogue: 0,0:26:33.09,0:26:36.74,Main,Luffy,0,0,0,,Korsan gemisi Thousand Sunny!Dialogue: 0,0:26:37.01,0:26:38.80,Main,Luffy,0,0,0,,Şerefe!Dialogue: 0,0:26:38.80,0:26:40.45,Main,Crew,0,0,0,,Şerefe!Dialogue: 0,0:26:50.15,0:26:53.42,Main,Luffy,0,0,0,,Gidelim! Sonraki durağımız Balıkadam Adası!