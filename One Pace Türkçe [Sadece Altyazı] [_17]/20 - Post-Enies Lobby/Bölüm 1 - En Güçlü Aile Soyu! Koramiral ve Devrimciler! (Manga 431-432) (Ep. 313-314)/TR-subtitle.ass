Dialogue: 0,0:02:41.57,0:02:50.27,Title,,0,0,0,,{\fad(2000,2000)}En Güçlü Aile Soyu?!\NKoramiral ve Devrimciler!
Dialogue: 0,0:02:53.36,0:02:57.57,Narrator,Conductor,0,0,0,,Water 7, Mavi İstasyon, Mavi İstasyon...
Dialogue: 0,0:02:57.81,0:03:02.18,Narrator,Conductor,0,0,0,,Lütfen unuttuğunuz bir şeyiniz olmadığına emin olun.
Dialogue: 0,0:03:02.24,0:03:05.50,Flashbacks,Sword Guy,0,0,0,,Parasını boşver. Sadece al ve git!
Dialogue: 0,0:03:08.23,0:03:10.09,Main,Zoro,0,0,0,,Berbat bir durum...
Dialogue: 0,0:03:10.82,0:03:14.76,Main,Man,0,0,0,,Ama adamım... Bu yıl ki Aqua Laguna çok güçlüydü.
Dialogue: 0,0:03:14.76,0:03:18.96,Main,Man,0,0,0,,Bu kendi başımıza yapabileceğimiz bir tamir gibi gözükmüyor...
Dialogue: 0,0:03:20.02,0:03:21.09,Main,Man,0,0,0,,Bunlar...
Dialogue: 0,0:03:23.91,0:03:25.96,Main,Man,0,0,0,,1. iskeleden Paulie.
Dialogue: 0,0:03:25.96,0:03:27.41,Main,Man,0,0,0,,Neden şehre gelmiş ki?
Dialogue: 0,0:03:27.61,0:03:29.91,Main,Girls,0,0,0,,Paulie-san!
Dialogue: 0,0:03:31.17,0:03:34.49,Main,Paulie,0,0,0,,Kıpırdayın! Dağılın ayak altında dolaşmayın!
Dialogue: 0,0:03:37.75,0:03:40.49,Main,Paulie,0,0,0,,Bu bölgeyi size bırakıyorum 3. iskeledekiler.
Dialogue: 0,0:03:40.49,0:03:41.69,Main,guys,0,0,0,,Tamamdır!
Dialogue: 0,0:03:41.69,0:03:44.81,Main,Paulie,0,0,0,,5. iskeledekiler, eski tren yolunun başındaki evlerden itibaren sizindir.
Dialogue: 0,0:03:44.81,0:03:45.68,Main,Paulie,0,0,0,,Tamamdır!
Dialogue: 0,0:03:46.00,0:03:51.46,Main,Paulie,0,0,0,,Hala yapacak işlerimiz var, bu şehri 1 ay içinde yepyeni yapmanızı istiyorum!
Dialogue: 0,0:03:51.46,0:03:52.23,Main,Guys,0,0,0,,Baş üstüne!
Dialogue: 0,0:03:52.60,0:03:53.69,Main,Paulie,0,0,0,,Hemen başlayın!
Dialogue: 0,0:03:54.17,0:03:55.91,Main,Guys,0,0,0,,Tabii ki!
Dialogue: 0,0:03:56.25,0:03:58.78,Main,Man,0,0,0,,İnanılmaz! Onlar çok fazla güven veriyor.
Dialogue: 0,0:03:58.78,0:04:01.03,Main,Man,0,0,0,, Galley-La Şirketi'nden beklendiği gibi!
Dialogue: 0,0:04:01.31,0:04:05.05,Captions,,0,0,180,,{\fad(1000,0)}Kuzey Sahili: Franky Evi Harabeleri
Dialogue: 0,0:04:12.26,0:04:14.73,Main,Zanbai,0,0,0,,Aman be... Yeniden inşa etmek harbi çok zormuş.
Dialogue: 0,0:04:15.28,0:04:17.81,Main,Guy,0,0,0,,Çünkü biz bir şeyleri kırmaya dökmeye alışığız değil mi?
Dialogue: 0,0:04:17.81,0:04:19.34,Main,Guy,0,0,0,,Yine kamp yapıyoruz, ha?
Dialogue: 0,0:04:21.57,0:04:22.66,Main,Guy,0,0,0,,Tamam tamam.
Dialogue: 0,0:04:23.10,0:04:25.30,Main,Guy,0,0,0,,Sodom ve Gomorah,...
Dialogue: 0,0:04:25.30,0:04:27.29,Main,Guy,0,0,0,,Şimdi istediğiniz kadar dinlenebilirsiniz.
Dialogue: 0,0:04:30.44,0:04:34.71,Main,Guy,0,0,0,,Ren geyiği, Gomorah'ın görme yeteneği, yeterince dinlendiğinde geri döneceğini söyledi.
Dialogue: 0,0:04:34.71,0:04:36.51,Main,Guy,0,0,0,,Harbi mi? Çok şükür.
Dialogue: 0,0:04:36.78,0:04:44.48,Captions,,0,0,180,,{\fad(1000,0)}Tersane: 1. İskele
Dialogue: 0,0:04:39.93,0:04:41.87,Main,People,0,0,0,,{\an8}Korsanları görmemize izin verin!
Dialogue: 0,0:04:41.87,0:04:44.48,Main,People,0,0,0,,{\an8}Onları suikastçi olarak suçladığımız için özür dilemek istiyoruz!
Dialogue: 0,0:04:44.82,0:04:47.16,Main,Guard,0,0,0,,Hayır, korsanları kimse görmeyecek.
Dialogue: 0,0:04:47.49,0:04:50.58,Main,Guy,0,0,0,,En azından, Iceberg'i\Nkurtaran kişiye teşekkür edelim!
Dialogue: 0,0:04:50.91,0:04:55.08,Main,Reporter,0,0,0,,Water 7 Gazetesi! Belediye başkanını kurtaran\Nkahramanlardan bir yorum alabilir miyiz?
Dialogue: 0,0:04:55.08,0:04:57.30,Main,Guard,0,0,0,,Vazgeçin, şu anda imkansız.
Dialogue: 0,0:04:57.30,0:04:58.50,Main,Guy,0,0,0,,En azından fotoğraf çekelim!
Dialogue: 0,0:04:58.50,0:04:59.49,Main,Guard,0,0,0,,Sana hayır dedim!
Dialogue: 0,0:04:59.49,0:05:01.13,Main,Woman,0,0,0,,Eğer Kalifa için bir başka sekretere\Nihtiyacınız olursa, ben olurum!
Dialogue: 0,0:05:01.13,0:05:02.49,Main,Woman,0,0,0,,Herhangi bir şeye yardımcı olurum!
Dialogue: 0,0:05:07.27,0:05:09.60,Main,Guy,0,0,0,,İnanılmaz! Ne insanüstü bir güç ama!
Dialogue: 0,0:05:10.10,0:05:11.33,Main,Kaashi,0,0,0,,Bu kadarı yeterli değil mi?
Dialogue: 0,0:05:11.33,0:05:12.82,Main,People,0,0,0,,Evet, teşekkür ederiz!
Dialogue: 0,0:05:12.82,0:05:14.83,Main,People,0,0,0,,Dev ırkından tam beklenildiği gibi.
Dialogue: 0,0:05:14.83,0:05:19.00,Main,Oimo,0,0,0,,Eğer yine böyle bir iş\Nçıkarsa bizi haber edin!
Dialogue: 0,0:05:21.87,0:05:24.33,Main,Kaashi,0,0,0,,Öyle değil mi, Soge King?
Dialogue: 0,0:05:24.98,0:05:27.05,Main,Kaashi,0,0,0,,Burada kalmakta emin misin?
Dialogue: 0,0:05:27.05,0:05:33.28,Main,Oimo,0,0,0,,Patronlarımızın kavgası\Nbitmediyse, o tarafa gidemeyiz.
Dialogue: 0,0:05:33.28,0:05:38.70,Main,Oimo,0,0,0,,Bu adaya yardım edeceğiz ve\Nsonra yavaştan Elbaf'a döneceğiz.
Dialogue: 0,0:05:38.70,0:05:42.07,Main,Kaashi,0,0,0,,Eğer istiyorsan seni de yanımızda götürebiliriz.
Dialogue: 0,0:05:43.69,0:05:46.03,Main,Usopp,0,0,0,,Ben...
Dialogue: 0,0:05:46.37,0:05:49.58,Captions,,0,0,240,,{\fad(1000,0)}Galley-La Şirketinin Ana Ofisi\NIceberg'in Evinin Kalıntıları
Dialogue: 0,0:05:49.84,0:05:55.21,Captions,Text,0,0,180,,{\fad(1000,0)}Geçici Ana Karargah.
Dialogue: 0,0:05:51.56,0:05:55.21,Main,Iceburg,0,0,0,,{\an8}Anladım demek ki planları yaktın...
Dialogue: 0,0:05:56.47,0:05:57.73,Main,Iceburg,0,0,0,,Böyle olması daha iyi.
Dialogue: 0,0:06:00.31,0:06:02.68,Main,Iceburg,0,0,0,,Dünya Hükümeti'nin tepkisini de kazandın.
Dialogue: 0,0:06:06.45,0:06:07.94,Main,Franky,0,0,0,,Evet, öyle oldu sanırım.
Dialogue: 0,0:06:07.94,0:06:11.57,Main,Franky,0,0,0,,Hey, bunca zamandır ne çiziyorsun?
Dialogue: 0,0:06:12.38,0:06:14.71,Main,Iceburg,0,0,0,,Bu sefer Aqua Laguna geldiğinde...
Dialogue: 0,0:06:14.71,0:06:17.09,Main,Iceburg,0,0,0,,Yer endişe verici şekilde titriyordu...
Dialogue: 0,0:06:17.09,0:06:20.38,Main,Iceburg,0,0,0,,Bu adanın tamamen deniz tarafından yutulacağı\Ngünün yakın olduğunu düşünüyorum.
Dialogue: 0,0:06:21.07,0:06:22.50,Main,Franky,0,0,0,,Öyleyse, ne yapmayı düşünüyorsun?
Dialogue: 0,0:06:22.96,0:06:25.02,Main,Iceburg,0,0,0,,Bu adayı bir gemiye çevireceğim.
Dialogue: 0,0:06:25.02,0:06:29.14,Main,Franky,0,0,0,,Ne!? Water 7'i gemiye mi çevireceksin?!
Dialogue: 0,0:06:29.46,0:06:31.26,Main,Franky,0,0,0,,B-Bu yapılabilir mi ki?!
Dialogue: 0,0:06:31.26,0:06:32.69,Main,Iceburg,0,0,0,,Unuttun mu?
Dialogue: 0,0:06:33.44,0:06:36.68,Main,Iceburg,0,0,0,,Bizler imkansızı başaran\Nkişinin arkasından geliyoruz.
Dialogue: 0,0:06:36.68,0:06:38.40,Main,Iceburg,0,0,0,,Biz her zaman onu izledik.
Dialogue: 0,0:06:38.40,0:06:40.36,Main,Iceburg,0,0,0,,Eğer adamsan...
Dialogue: 0,0:06:40.36,0:06:41.75,Main,Iceburg,0,0,0,,"Don" ile yap.
Dialogue: 0,0:06:43.93,0:06:45.33,Main,Franky,0,0,0,,Öyleydi değil mi?
Dialogue: 0,0:06:48.55,0:06:49.45,Main,Franky,0,0,0,,Alo?
Dialogue: 0,0:06:49.45,0:06:51.11,Main,Zanbai,0,0,0,,He abi sen misin?
Dialogue: 0,0:06:51.43,0:06:56.39,Main,Zanbai,0,0,0,,İyi haberim var. Sonunda geldi.\NDeniz treninden indiğimiz yerdeyiz.
Dialogue: 0,0:06:56.74,0:06:58.65,Main,Zanbai,0,0,0,,Senin 200 milyon beli'lik siparişin.
Dialogue: 0,0:06:59.76,0:07:02.11,Main,Franky,0,0,0,,Sonunda geldi demek he...
Dialogue: 0,0:07:02.44,0:07:05.64,Captions small,Text,0,0,240,,{\fad(1000,0)}Geçici Karargah.\NÖzel Korsanlar Odası,\NTuvalet, Banyo ve Mutfak Dahil.
Dialogue: 0,0:07:07.21,0:07:08.62,Main,Kokoro,0,0,0,,Geldim çocuklar.
Dialogue: 0,0:07:08.62,0:07:09.87,Main,Sanji,0,0,0,,Kokoro nine!
Dialogue: 0,0:07:09.87,0:07:11.46,Main,Chimeny,0,0,0,,Merhaba ben de geldim!
Dialogue: 0,0:07:11.46,0:07:12.65,Main,Sanji,0,0,0,,Sizde mi geliyorsunuz?
Dialogue: 0,0:07:22.40,0:07:24.64,Main,Kokoro,0,0,0,,Sen, dışarıdan bakarsın.
Dialogue: 0,0:07:24.64,0:07:27.60,Main,Kokoro,0,0,0,,Sonunda hepiniz uyanmışsınız.
Dialogue: 0,0:07:27.60,0:07:30.99,Main,Kokoro,0,0,0,,İki gün boyunca uyumak gerçekten\Nyorulmuş olduğunuzu gösteriyor.
Dialogue: 0,0:07:30.99,0:07:32.10,Main,Kokoro,0,0,0,,Normal olarak tabii.
Dialogue: 0,0:07:32.10,0:07:35.86,Main,Kokoro,0,0,0,,Ah, bizim Korsanlar Kralı da iyi durumda.
Dialogue: 0,0:07:35.86,0:07:38.37,Main,Sanji,0,0,0,,Oh? Öyle değil.
Dialogue: 0,0:07:38.37,0:07:39.87,Main,Kokoro,0,0,0,,Öyle olmayan ne?
Dialogue: 0,0:07:39.87,0:07:44.49,Main,Sanji,0,0,0,,Dövüşten sonra yere yığılmasına\Nrağmen yemek yemeye can atıyordu.
Dialogue: 0,0:07:48.03,0:07:50.64,Main,Sanji,0,0,0,,Uyurken yemek yemek için bir\Nteknik icat etmiş gibi görünüyor.
Dialogue: 0,0:07:50.64,0:07:52.34,Main,Kokoro,0,0,0,,Uyuyor mu şu an?!
Dialogue: 0,0:07:52.59,0:07:54.85,Main,Chimeny,0,0,0,,Muhteşem, korsan abi!
Dialogue: 0,0:07:56.03,0:07:58.06,Main,Kokoro,0,0,0,,O oldukça yetenekli bir adam.
Dialogue: 0,0:08:00.57,0:08:04.86,Main,Kokoro,0,0,0,,Bu arada, Seyir Pusulanız 2\Nveya 3 gün sonra düzelir herhalde.
Dialogue: 0,0:08:06.12,0:08:07.87,Main,Kokoro,0,0,0,,Sana ne olmuş böyle?!
Dialogue: 0,0:08:07.87,0:08:13.00,Main,Nami,0,0,0,,Seyir Pusulası ayarlansa\Nbile artık ilerleyemeyiz...
Dialogue: 0,0:08:14.45,0:08:18.76,Main,Nami,0,0,0,,Bize yeni bir gemi almak için\Nçok uğraştığımız 100 Milyon beli...
Dialogue: 0,0:08:18.76,0:08:23.23,Main,Nami,0,0,0,,Kıyafetlerimiz... mobilyalarımız...\NBellemere-san'ın portakal ağaçları... hepsi...
Dialogue: 0,0:08:23.23,0:08:25.73,Main,Nami,0,0,0,,Aqua Laguna hepsini aldı götürdü...
Dialogue: 0,0:08:25.73,0:08:27.65,Main,Nami,0,0,0,,Artık başka yere gidemeyiz...
Dialogue: 0,0:08:27.65,0:08:30.59,Main,Sanji,0,0,0,,Hepsini arka sokaktaki hanede bıraktık.
Dialogue: 0,0:08:32.15,0:08:34.78,Main,Kokoro,0,0,0,,Anlaşılan o zaman ön\Ntaraftaki ziyaretçiler bu yüzdendi.
Dialogue: 0,0:08:35.27,0:08:36.27,Main,Sanji,0,0,0,,Ziyaretçiler?
Dialogue: 0,0:08:36.92,0:08:38.26,Main,Nami,0,0,0,,Benim portakal ağaçlarım!
Dialogue: 0,0:08:38.26,0:08:40.84,Main,Nami,0,0,0,,Bir daha hiç gelmeyeceklerini düşünmüştüm!
Dialogue: 0,0:08:41.32,0:08:42.32,Main,Nami,0,0,0,,Rahatladım!
Dialogue: 0,0:08:42.32,0:08:46.37,Main,Guy,0,0,0,,Aslında, Iceburg'un suikastinden\Nsizin sorumlu olduğunuzu düşünürken,...
Dialogue: 0,0:08:42.32,0:08:44.59,Secondary,Nami,0,0,0,,Çok şükür!
Dialogue: 0,0:08:46.37,0:08:49.89,Main,Guy,0,0,0,,...eşyalarınız aklımıza geldi,\Nbu yüzden hepsine el koyduk.
Dialogue: 0,0:08:50.38,0:08:51.51,Main,Guy,0,0,0,,Bunun için kusura bakmayın.
Dialogue: 0,0:08:51.51,0:08:53.48,Main,Nami,0,0,0,,Önemli değil! Teşekkür ederim!
Dialogue: 0,0:08:54.73,0:08:55.98,Main,Kokoro,0,0,0,,Hadi iyisiniz he.
Dialogue: 0,0:08:56.53,0:08:59.30,Main,Chopper,0,0,0,,Biz geldik.
Dialogue: 0,0:08:59.30,0:09:00.18,Main,Robin,0,0,0,,Döndük sonunda.
Dialogue: 0,0:09:00.18,0:09:01.20,Main,Sanji,0,0,0,,Oh, Chopper.
Dialogue: 0,0:09:01.20,0:09:03.53,Main,Sanji,0,0,0,,Ve Robin-chwan~!
Dialogue: 0,0:09:03.53,0:09:06.06,Main,Sanji,0,0,0,,Poşetleriniz bayağı ağırdı değil mi?\NŞimdi lütfen, hemen buradan içeri...
Dialogue: 0,0:09:06.06,0:09:07.06,Main,Robin,0,0,0,,Teşekkürler.
Dialogue: 0,0:09:07.37,0:09:09.70,Main,Chopper,0,0,0,,Gidip Franky'nin adamlarının\Nyaralarını kontrol ettim.
Dialogue: 0,0:09:09.70,0:09:12.33,Main,Chopper,0,0,0,,Ve Robin'i hiç gözümün önünden ayırmadım!
Dialogue: 0,0:09:12.33,0:09:13.82,Main,Sanji,0,0,0,,İyi iş!
Dialogue: 0,0:09:15.64,0:09:17.48,Main,Robin,0,0,0,,Sana zaten hiçbir yere\Nkaçmayacağımı söyledim.
Dialogue: 0,0:09:17.58,0:09:18.85,Main,Chopper,0,0,0,,Söz mü?
Dialogue: 0,0:09:18.85,0:09:20.19,Main,Robin,0,0,0,,Söz.
Dialogue: 0,0:09:20.19,0:09:24.12,Main,Nami,0,0,0,,Bakın ikiniz, portakal ağaçlarıma\Nbir şey olmadan geri gelmişler.
Dialogue: 0,0:09:24.12,0:09:26.16,Main,Nami,0,0,0,,Tüm paramız ve eşyalarımız geri döndü!
Dialogue: 0,0:09:26.16,0:09:27.26,Main,Chopper,0,0,0,,Harbi mi?
Dialogue: 0,0:09:27.26,0:09:29.02,Main,Nami,0,0,0,,Artık maceralarımıza devam edebiliriz!
Dialogue: 0,0:09:29.02,0:09:30.28,Main,Chopper,0,0,0,,Bu çok iyi oldu!
Dialogue: 0,0:09:40.42,0:09:43.10,Main,Franky,0,0,0,,Herkes kendini süper hissediyor mu...?
Dialogue: 0,0:09:43.90,0:09:46.80,Main,Franky,0,0,0,,Herkes toplanmamış daha ama... neyse...
Dialogue: 0,0:09:47.24,0:09:49.20,Main,Sanji,0,0,0,,Franky, Neden aniden\Nböyle bir giriş yaptın ki?
Dialogue: 0,0:09:49.20,0:09:49.98,Main,Franky,0,0,0,,Dinleyin!
Dialogue: 0,0:09:49.98,0:09:52.18,Main,Franky,0,0,0,,Size önemli bir şey söylemem gerekiyor.
Dialogue: 0,0:09:52.18,0:09:55.15,Main,Franky,0,0,0,,Zamanında savaş\Nhalinde olan bir ada vardı...
Dialogue: 0,0:09:55.15,0:09:56.98,Main,Sanji,0,0,0,,Nerden çıktı şimdi bu?
Dialogue: 0,0:09:56.98,0:09:59.61,Main,Sanji,0,0,0,,Sadece içeri girip konuşmaya başlıyorsunuz,\Neğer bir özür değilse ilgilenmiyoruz.
Dialogue: 0,0:09:59.61,0:10:01.85,Main,Franky,0,0,0,,Kes sesini! Kapa çeneni de dinle.
Dialogue: 0,0:10:03.52,0:10:08.68,Main,Franky,0,0,0,,Savaş başladığından beri, bir adada o bomba\Nyağmuruna rağmen yaşamaya devam eden bir şey vardı...
Dialogue: 0,0:10:09.51,0:10:13.63,Main,Franky,0,0,0,,İnsanlar ölürse, kasaba da ölür.\NHerkes kasabayla ile beraber yok olurdu.
Dialogue: 0,0:10:14.59,0:10:18.10,Main,Franky,0,0,0,,Ama bir şey vardı. Bir ağaç.
Dialogue: 0,0:10:19.30,0:10:21.89,Main,Franky,0,0,0,,Ne yaparsan yap bir şey olmazdı.
Dialogue: 0,0:10:21.89,0:10:26.62,Main,Franky,0,0,0,,Sonra insanlar ağacın yakınında toplandı ve\Nbir şehir... Ve bir ülke yeniden kuruldu.
Dialogue: 0,0:10:27.82,0:10:30.07,Main,Franky,0,0,0,,Dünyada onlardan sadece birkaç tane var.
Dialogue: 0,0:10:31.26,0:10:33.79,Main,Franky,0,0,0,,Bu çok güçlü ağacın ismi...
Dialogue: 0,0:10:34.82,0:10:36.99,Main,Franky,0,0,0,,Adem Ağacı.
Dialogue: 0,0:10:37.91,0:10:38.96,Main,Sanji,0,0,0,,Ağaç mı?
Dialogue: 0,0:10:39.29,0:10:41.84,Main,Chopper,0,0,0,,Ne ağacı?
Dialogue: 0,0:10:41.84,0:10:46.43,Main,Franky,0,0,0,,Rotanızda o ağacın bir parçasının\Nbile ortaya çıkması son derece nadirdir.
Dialogue: 0,0:10:46.96,0:10:49.40,Main,Franky,0,0,0,,O ağacı istiyordum ama...
Dialogue: 0,0:10:49.40,0:10:51.72,Main,Franky,0,0,0,,...o ağacın keresteleri\Npiyasada 200 milyona satılıyordu.
Dialogue: 0,0:10:52.14,0:10:54.28,Main,Franky,0,0,0,,O yüzden hiç alamadım.
Dialogue: 0,0:10:54.28,0:10:59.08,Main,Franky,0,0,0,,Ve önüme ne çıktı dersiniz? Tam bir\Nton para taşıyan korsan bir grubu, sizler!
Dialogue: 0,0:10:59.08,0:11:02.71,Main,Sanji,0,0,0,,Yoksa sen bizim paramızı\Nböyle bir şeye mi yatırdın?!
Dialogue: 0,0:11:02.71,0:11:04.38,Main,Franky,0,0,0,,Daha lafımı bitirmedim!
Dialogue: 0,0:11:07.60,0:11:12.94,Main,Franky,0,0,0,,Çok uzun zaman önce bir daha\Nasla gemi yapmama kararı aldım.
Dialogue: 0,0:11:13.76,0:11:17.86,Main,Franky,0,0,0,,Ancak uzun sürmeden, hayranlık duyduğum bir\Nadamı yakalamak ve kendi hedefime ulaşmak için...
Dialogue: 0,0:11:17.86,0:11:20.49,Main,Franky,0,0,0,,Bir geminin planlarını çizdim...
Dialogue: 0,0:11:23.99,0:11:28.09,Main,Franky,0,0,0,,Benim hayalim o hazine değerinde ağacı, bir\Nkez daha kullanmak, sadece bir kez daha..
Dialogue: 0,0:11:28.48,0:11:34.03,Main,Franky,0,0,0,,Her türlü denizi aşabilecek\Nbir gemi, "Hayallerimin Gemisi".
Dialogue: 0,0:11:43.23,0:11:49.70,Main,Franky,0,0,0,,Zaten ağacım ve taslaklarım var. \NBununla onu yapabilirim.
Dialogue: 0,0:11:50.67,0:11:54.12,Main,Franky,0,0,0,,Ve bittiğinde...
Dialogue: 0,0:11:54.80,0:12:00.92,Main,Franky,0,0,0,,O yaptığım gemiyi kullanır mısınız?!
Dialogue: 0,0:12:03.93,0:12:04.82,Main,Chopper,0,0,0,,Öyleyse?
Dialogue: 0,0:12:04.82,0:12:07.69,Main,Sanji,0,0,0,,Sen bize böyle bir gemi mi vericeksin!?
Dialogue: 0,0:12:08.21,0:12:09.27,Main,Franky,0,0,0,,Evet.
Dialogue: 0,0:12:09.27,0:12:12.09,Main,Franky,0,0,0,,Sevdiğim insanlar yelken açıyorsa.
Dialogue: 0,0:12:12.09,0:12:13.81,Main,Franky,0,0,0,,Beni en çok mutlu edecek şey bu.
Dialogue: 0,0:12:14.60,0:12:17.58,Main,Franky,0,0,0,,Sonuçta, Bu sadece sizin "yatırımınız"\Nsayesinde yapabildiğim bir şey.
Dialogue: 0,0:12:17.99,0:12:25.67,Main,Franky,0,0,0,,Bütün dünyayı dolaşan tek gemi, \NGold Roger'ın Oro Jackson'ı bu ağaçtan yapılmıştı.
Dialogue: 0,0:12:26.32,0:12:27.62,Main,Franky,0,0,0,,Kesinlikle...
Dialogue: 0,0:12:28.02,0:12:30.47,Main,Franky,0,0,0,,Size muhteşem bir gemi yapacağım.
Dialogue: 0,0:12:32.86,0:12:36.74,Main,Kokoro,0,0,0,,Neyse ki, sonuçta siz\Nve Tom-san aynı şeysiniz.
Dialogue: 0,0:12:36.74,0:12:39.10,Main,Kokoko,0,0,0,,Bir marangoz.
Dialogue: 0,0:12:42.15,0:12:44.70,Main,Franky,0,0,0,,Öyle değil mi, şimdi...
Dialogue: 0,0:12:47.91,0:12:54.62,Main,Franky,0,0,0,,Şimdi Tom-san'ın gururuyla\Nöldüğü hislerini ben de anlıyorum.
Dialogue: 0,0:12:57.59,0:13:01.83,Main,Chopper,0,0,0,,Gerçekten iyi bir adamsın! Onu\Nalacağız! Teşekkür ederim Franky!
Dialogue: 0,0:13:02.61,0:13:04.36,Main,Sanji,0,0,0,,Sonraki adaya doğru yol alalım!
Dialogue: 0,0:13:04.36,0:13:07.61,Main,Nami,0,0,0,,Harika! Luffy! Artık bir gemimiz var!
Dialogue: 0,0:13:18.87,0:13:24.63,Main,Zoro,0,0,0,,Bu kötü, çok çabuk\Nbulunduk ve Luffy hala uyuyor!
Dialogue: 0,0:13:24.63,0:13:26.34,Main,Zoro,0,0,0,,Hızlıca onlara haber vermem gerekiyor!
Dialogue: 0,0:13:26.87,0:13:27.87,Main,Zoro,0,0,0,,Ne?
Dialogue: 0,0:13:29.52,0:13:32.22,Main,People,0,0,0,,Onlar... korsanları\Nyakalamak için buradalar.
Dialogue: 0,0:13:32.48,0:13:35.40,Main,Person,0,0,0,,Iceburg'un hayatını kurtaran\Nkahramanlar olmalarına rağmen.
Dialogue: 0,0:13:35.91,0:13:37.90,Main,Guy,0,0,0,,Hey, şuna bak!
Dialogue: 0,0:13:39.16,0:13:42.15,Main,Guy,0,0,0,,Bu, denizci koramirallerinden biri olan \NGarp'ın savaş gemisi.
Dialogue: 0,0:13:42.15,0:13:44.17,Main,Guy,0,0,0,,Garp'mı dedin?
Dialogue: 0,0:13:44.17,0:13:49.59,Main,Guy,0,0,0,,O, Gold Roger'ı sayısız kez köşeye\Nsıkıştıran efsanevi denizci değil mi?
Dialogue: 0,0:13:49.92,0:13:52.58,Main,Someone,0,0,0,,Niye böyle muhteşem bir denizci...
Dialogue: 0,0:13:52.58,0:13:54.68,Main,Guy,0,0,0,,Bu korsanlar için çok kötü oldu.
Dialogue: 0,0:13:54.68,0:13:55.86,Main,Zoro,0,0,0,,Deniz mi?
Dialogue: 0,0:13:59.01,0:14:01.73,Main,Zoro,0,0,0,,Kahretsin, yanlış yoldan mı gelmişim?
Dialogue: 0,0:14:17.30,0:14:21.06,Main,Person,0,0,0,,D-Durun bir dakika askerler. Burada\Nsadece bizim başkandan başka kimse yok-
Dialogue: 0,0:14:21.06,0:14:24.15,Main,Garp,0,0,0,,Koftiden atmayın! Korsanlar burada olmalı.
Dialogue: 0,0:14:24.15,0:14:25.48,Main,Guy,0,0,0,,Burada değiller dedik!
Dialogue: 0,0:14:25.48,0:14:26.73,Main,Guy,0,0,0,,Bekleyin yapamazsınız!
Dialogue: 0,0:14:26.73,0:14:28.80,Main,Guy,0,0,0,,Bekleyin, burada Hasır-
Dialogue: 0,0:14:28.80,0:14:29.98,Main,Guy,0,0,0,,Mal!
Dialogue: 0,0:14:44.51,0:14:46.57,Main,Garp,0,0,0,,Siz ikiniz, burada bekleyin.
Dialogue: 0,0:14:46.57,0:14:47.57,Main,Garp,0,0,0,,Emredersiniz!
Dialogue: 0,0:14:53.52,0:14:54.71,Main,Franky,0,0,0,,Ne oluyor?
Dialogue: 0,0:14:54.71,0:14:55.71,Main,Chopper,0,0,0,,Kim lan bu?
Dialogue: 0,0:15:00.49,0:15:04.28,Main,Garp,0,0,0,,Siz Hasır Şapkalar mısınız?
Dialogue: 0,0:15:04.94,0:15:09.24,Main,Garp,0,0,0,,Burada, Monkey D. Luffy ile\Ngörüşmek isteyen bazı kişiler var.
Dialogue: 0,0:15:09.82,0:15:11.20,Main,Others,0,0,0,,Donanma?
Dialogue: 0,0:15:12.98,0:15:13.98,Main,Garp,0,0,0,,Zıbarmayı kes!
Dialogue: 0,0:15:19.55,0:15:20.55,Main,Chopper,0,0,0,,Luffy!
Dialogue: 0,0:15:21.92,0:15:24.10,Main,Luffy,0,0,0,,Acıttı! Acıttı!
Dialogue: 0,0:15:24.47,0:15:29.11,Main,Sanji,0,0,0,,"Acıttı"? Ne demek istiyorsun? Bu sadece bir\Nyumruktu. Lastikten oluşan birisi bunu hissedemez.
Dialogue: 0,0:15:29.11,0:15:33.24,Main,Garp,0,0,0,,Bir aşk yumruğuna karşı savunma yoktur.
Dialogue: 0,0:15:33.24,0:15:35.83,Main,Garp,0,0,0,,Anladığım kadarıyla oldukça\Ndüşüncesizce davranıyormuşsunuz...
Dialogue: 0,0:15:35.83,0:15:36.83,Main,Garp,0,0,0,,Luffy.
Dialogue: 0,0:15:37.51,0:15:39.33,Main,Luffy,0,0,0,,D- D-D-
Dialogue: 0,0:15:39.73,0:15:41.23,Main,Luffy,0,0,0,,Dedem?
Dialogue: 0,0:15:49.92,0:15:51.64,Main,Garp,0,0,0,,Hey Luffy,
Dialogue: 0,0:15:54.62,0:15:58.73,Main,Garp,0,0,0,,Bana bir özür borçlu olduğunu düşünmüyor musun?
Dialogue: 0,0:15:55.78,0:15:58.73,Captions small,Text,0,0,140,,{\fad(500,0)\pos(1078,600)}Donanma Koramirali\NMonkey D. Garp\N"Yumruk Garp"
Dialogue: 0,0:15:58.73,0:16:01.74,Main,Nami,0,0,0,,Evet, Garp... o, o denizci\Nkahramanının adı değil mi!?
Dialogue: 0,0:16:01.74,0:16:04.25,Main,Sanji,0,0,0,,Luffy, harbi o senin deden mi?
Dialogue: 0,0:16:04.25,0:16:07.33,Main,Luffy,0,0,0,,Evet öyle. Onunla savaşmaya çalışmayın.
Dialogue: 0,0:16:07.33,0:16:11.29,Main,Luffy,0,0,0,,Geçmişte defalarca dedem\Ntarafından neredeyse öldürülüyordum.
Dialogue: 0,0:16:21.98,0:16:25.06,Main,Garp,0,0,0,,Haydi, şimdi benim hakkımda\Nkötü imaj yaratmaya çalışma.
Dialogue: 0,0:16:27.24,0:16:30.45,Main,Garp,0,0,0,,Seni o dipsiz kuyuya attığımda,...
Dialogue: 0,0:16:33.07,0:16:35.54,Main,Garp,0,0,0,,Seni geceleyin yalnız\Nbaşına ormanda bıraktığımda,...
Dialogue: 0,0:16:38.22,0:16:40.83,Main,Garp,0,0,0,,Seni balonlara bağlayıp\Ngökyüzüne uçurduğumda,...
Dialogue: 0,0:16:43.72,0:16:46.98,Main,Garp,0,0,0,,Hepsi seni güçlü bir adam yapmak içindi.
Dialogue: 0,0:16:55.70,0:17:01.32,Main,Sanji,0,0,0,,Sanırım şimdi Luffy'nin sonsuz yaşama\Nisteğinin neden olduğunu anladım...
Dialogue: 0,0:17:01.73,0:17:06.79,Main,Garp,0,0,0,,Sonunda seni Ace ile birlikte eğitimine devam\Netmesi için yakın bir arkadaşıma bıraktım.
Dialogue: 0,0:17:10.93,0:17:13.56,Main,Garp,0,0,0,,Ve sen gözümün önünde\Ndeğilken bu hale geldin...
Dialogue: 0,0:17:14.21,0:17:18.40,Main,Garp,0,0,0,,Seni güçlü bir denizci\Nyapmak için bunları yaptım!
Dialogue: 0,0:17:19.15,0:17:22.65,Main,Luffy,0,0,0,,Sana hep korsan olmak\Nistediğimi söyledim değil mi?
Dialogue: 0,0:17:22.95,0:17:25.45,Main,Garp,0,0,0,,Sen "Kızıl Saçlı" tarafından\Nkötü yola düşürüldün!
Dialogue: 0,0:17:25.45,0:17:26.03,Main,Garp,0,0,0,,Saçmalık!
Dialogue: 0,0:17:26.31,0:17:29.48,Main,Luffy,0,0,0,,Ben Shanks'a hayatımı borçluyum!
Dialogue: 0,0:17:29.48,0:17:30.88,Main,Luffy,0,0,0,,Onu aşağılama!
Dialogue: 0,0:17:32.08,0:17:35.93,Main,Garp,0,0,0,,Kendi dedene ne yapması\Ngerektiğini mi söylüyorsun?
Dialogue: 0,0:17:35.93,0:17:36.79,Main,Luffy,0,0,0,,Özür dilerim!
Dialogue: 0,0:17:36.79,0:17:40.47,Main,Chopper,0,0,0,,Acil durum! Luffy donanma\Ntarafından yakalandı!
Dialogue: 0,0:17:40.47,0:17:41.47,Main,Nami,0,0,0,,Luffy!
Dialogue: 0,0:17:43.66,0:17:48.23,Main,Sanji,0,0,0,,Bu kötü oldu, eğer savaşmaya\Nkalkarsak hemen üzerimize atlayacaklar!
Dialogue: 0,0:17:51.88,0:17:53.19,Main,All,0,0,0,,Uyuya mı kaldılar?!
Dialogue: 0,0:17:54.14,0:17:57.75,Main,Franky,0,0,0,,Peki, şimdi ne yapacağız?
Dialogue: 0,0:17:57.75,0:17:59.91,Main,Franky,0,0,0,,Hiç böyle bir durumun içinde kalmamıştım!
Dialogue: 0,0:18:01.17,0:18:03.21,Main,Garp,0,0,0,,Ah be, uyuyakalmışım...
Dialogue: 0,0:18:06.35,0:18:09.22,Main,Garp,0,0,0,,Kalk lan Luffy!
Dialogue: 0,0:18:09.73,0:18:13.44,Main,Garp,0,0,0,,Seni azarlayan birine\Nböyle mi davranırsın?!
Dialogue: 0,0:18:15.02,0:18:20.49,Main,Garp,0,0,0,,Öncelikle, sen nereden, hangi\Ncesaretle dedenle böyle konuşursun?
Dialogue: 0,0:18:21.67,0:18:24.33,Main,All,0,0,0,,Oh, neyse, istediğinizi yapın...
Dialogue: 0,0:18:29.04,0:18:32.61,Main,Usopp,0,0,0,,Evet, Luffy'nin dedesi Donanmadan mıymış?
Dialogue: 0,0:18:32.61,0:18:34.55,Main,Usopp,0,0,0,,Bu iş iyice ilginçleşiyor.
Dialogue: 0,0:18:37.38,0:18:40.14,Main,Luffy,0,0,0,,A-A-Acıttı...
Dialogue: 0,0:18:40.72,0:18:46.41,Main,Garp,0,0,0,,"Kızıl Saçlı" diye bahsettiğin korsanın\Nne seviyede olduğunu biliyor musun?!
Dialogue: 0,0:18:47.54,0:18:49.63,Main,Luffy,0,0,0,,Shanks ve tayfası?
Dialogue: 0,0:18:49.63,0:18:52.66,Main,Luffy,0,0,0,,Shanks ve diğerleri iyiler mi? Onlar nerede?
Dialogue: 0,0:18:52.66,0:18:54.37,Main,Garp,0,0,0,,İyi olup olmamaları önemli değil...
Dialogue: 0,0:18:54.85,0:18:58.73,Main,Garp,0,0,0,,Artık denizlerde bir yıldız kadar\Nparlayan çok korsan varken,...
Dialogue: 0,0:18:58.73,0:19:03.14,Main,Garp,0,0,0,,...Beyazsakal gibi, \No da dört büyük korsandan biri!
Dialogue: 0,0:19:03.80,0:19:10.22,Main,Garp,0,0,0,,Onlar, Grand Line'ın ikinci yarısını\Nimparatorlar gibi yönetenlerdir.
Dialogue: 0,0:19:10.24,0:19:12.29,Main,Garp,0,0,0,,Bu yüzden onlara Yonkou deriz!
Dialogue: 0,0:19:10.24,0:19:12.29,Note,Garp,0,0,0,,Yonkou: Dört İmparator
Dialogue: 0,0:19:12.29,0:19:20.21,Main,Garp,0,0,0,,Bu dört adamla başa çıkabilmek için, \NKarargah Denizcileri ve Shichibukai'ler bir araya getirildi.
Dialogue: 0,0:19:12.29,0:19:20.21,Note,Garp,0,0,0,,Shichibukai: Denizin 7 Savaş Ağası
Dialogue: 0,0:19:20.21,0:19:26.92,Main,Garp,0,0,0,,Bu üç büyük güç, dünya çapında barışın\Nçökmemesi için hassas bir denge oluşturuyor.
Dialogue: 0,0:19:30.38,0:19:33.78,Main,Luffy,0,0,0,,Pek anlamadım ama iyiyse sorun yok.
Dialogue: 0,0:19:33.78,0:19:37.01,Main,Luffy,0,0,0,,Evet, gerçekten\Nhatıralarımı canlandırıyor...
Dialogue: 0,0:19:37.86,0:19:40.71,Main,Robin,0,0,0,,Kızıl Saç ile ne tür bir bağlantısı var?
Dialogue: 0,0:19:40.71,0:19:45.79,Main,Luffy,0,0,0,,Luffy, ona o zaman şapkasını\Nemanet ettiğini söyledi.
Dialogue: 0,0:19:45.79,0:19:48.79,Main,Nami,0,0,0,,Onun ne kadar büyük bir\Nkişi olduğunu bilmiyordum.
Dialogue: 0,0:19:52.60,0:19:55.14,Main,Micheal,0,0,0,,Bu tarafa, Zoro-san!
Dialogue: 0,0:19:55.14,0:19:57.38,Main,Zoro,0,0,0,,Kahretsin, Donanma çoktan gelmiş bile!
Dialogue: 0,0:19:57.38,0:19:58.85,Main,Hoichael,0,0,0,,Lütfen devam edin.
Dialogue: 0,0:20:00.09,0:20:01.77,Main,Hoichael,0,0,0,,Biz gerçekten...
Dialogue: 0,0:20:01.77,0:20:04.39,Main,Micheal,0,0,0,,Seni soymaya çalıştığımız için çok üzgünüz!
Dialogue: 0,0:20:04.88,0:20:07.48,Main,Zoro,0,0,0,,Boş verin, kafaya takmayın.\NYolumu gösterdiğiniz için teşekkürler.
Dialogue: 0,0:20:07.63,0:20:08.85,Main,Zoro,0,0,0,,Görüşürüz.
Dialogue: 0,0:20:12.07,0:20:14.58,Main,Garp,0,0,0,,Oh? Ne oluyor?
Dialogue: 0,0:20:16.27,0:20:19.73,Main,Marine,0,0,0,,Bu, ödül avcısı Zoro, korsan avcısı.
Dialogue: 0,0:20:19.73,0:20:22.89,Main,Garp,0,0,0,,Öyle mi? Luffy'nin tayfasından mı?
Dialogue: 0,0:20:22.89,0:20:24.05,Main,Garp,0,0,0,,Epey güçlü görünüyor.
Dialogue: 0,0:20:25.30,0:20:27.06,Main,Garp,0,0,0,,Hey, siz ikiniz onu durdurmaya çalışın!
Dialogue: 0,0:20:27.47,0:20:28.47,Main,Two,0,0,0,,Emredersiniz!
Dialogue: 0,0:20:37.96,0:20:40.87,Main,Zoro,0,0,0,,Kukri bıçakları, he? \NOldukça alışılmadık bir şey kullanıyorsunuz.
Dialogue: 0,0:20:43.58,0:20:45.92,Main,Luffy,0,0,0,,Hey, Zoro dur! Savaşacak bir neden yo-
Dialogue: 0,0:20:47.74,0:20:49.37,Main,Luffy,0,0,0,,Ne oldu pislik?
Dialogue: 0,0:20:49.37,0:20:50.37,Main,Coby,0,0,0,,Soru!
Dialogue: 0,0:20:49.37,0:20:50.37,Attack,Coby,0,0,0,,Kazı!
Dialogue: 0,0:20:51.84,0:20:52.84,Main,Luffy,0,0,0,,Bu teknik...
Dialogue: 0,0:21:06.02,0:21:07.19,Main,Marines,0,0,0,,Başçavuş!
Dialogue: 0,0:21:07.19,0:21:08.19,Main,Maine,0,0,0,,Çavuşum!
Dialogue: 0,0:21:10.54,0:21:12.79,Main,Garp,0,0,0,,Harbi, aranızda güç olarak uçurum var.
Dialogue: 0,0:21:13.41,0:21:16.55,Main,Coby,0,0,0,,Beklediğim gibi çok güçlüsün.\NTam da beklediğim gibi.
Dialogue: 0,0:21:18.79,0:21:19.96,Main,Coby,0,0,0,,Kaybettim.
Dialogue: 0,0:21:23.61,0:21:25.01,Main,Coby,0,0,0,,Luffy-san, Zoro-san.
Dialogue: 0,0:21:26.27,0:21:27.71,Main,Coby,0,0,0,,Uzun zaman oldu.
Dialogue: 0,0:21:27.71,0:21:28.97,Main,Coby,0,0,0,,Kim olduğumu anladın mı?
Dialogue: 0,0:21:30.72,0:21:31.72,Main,Luffy,0,0,0,,Kimsin sen?
Dialogue: 0,0:21:32.04,0:21:33.90,Main,Coby,0,0,0,,Benim, Koby!
Dialogue: 0,0:21:34.73,0:21:36.41,Main,Coby,0,0,0,,Hatırlamayadın mı?
Dialogue: 0,0:21:36.41,0:21:37.70,Main,Luffy,0,0,0,,Koby?
Dialogue: 0,0:21:42.24,0:21:44.05,Main,Luffy,0,0,0,,Koby?
Dialogue: 0,0:21:44.46,0:21:50.59,Main,Luffy,0,0,0,,Koby benim arkadaşım... \NAma benim bildiğim Koby daha kısaydı.
Dialogue: 0,0:21:51.11,0:21:52.79,Main,Coby,0,0,0,,Ben o Koby'yim işte!
Dialogue: 0,0:21:52.79,0:21:55.10,Main,Coby,0,0,0,,Aynı sürekli ağlayan bebek,\Nhiçbir işe yaramaz Koby.
Dialogue: 0,0:21:56.82,0:21:58.56,Main,Luffy,0,0,0,,Harbi mi?
Dialogue: 0,0:21:58.97,0:22:02.11,Main,Zoro,0,0,0,,O Koby... Neden o Grand Line'da?
Dialogue: 0,0:22:02.70,0:22:05.71,Main,Coby,0,0,0,,Hala asker olmaya alışamadım ama,...
Dialogue: 0,0:22:05.71,0:22:09.99,Main,Coby,0,0,0,,...sizin yakınlarda olduğunuzu\Nduyunca, sizi görmeden edemedim.
Dialogue: 0,0:22:14.47,0:22:17.47,Captions small,Text,0,0,0,,{\fad(500,0)}{\pos(1078,600)}Donanma \NBaşçavuş Koby
Dialogue: 0,0:22:14.07,0:22:17.47,Main,Coby,0,0,0,,{\an8}Siz ikiniz sayesinde biz\Nkim olduğumuzu bulduk!
Dialogue: 0,0:22:18.50,0:22:21.51,Captions small,Text,0,0,0,,{\fad(500,0)}{\pos(1078,600)}Donanma \NÇavuş Helmeppo
Dialogue: 0,0:22:19.06,0:22:21.51,Main,Helmeppo,0,0,0,,Yani, bu konuda haklarını vermem gerek.
Dialogue: 0,0:22:21.90,0:22:27.27,Main,Coby,0,0,0,,Bir çok şey oldu... Şu anda Karargah'ta\NKoramiral Garp tarafından eğitim alıyoruz.
Dialogue: 0,0:22:27.37,0:22:29.03,Main,Luffy,0,0,0,,He öyle mi oldu?
Dialogue: 0,0:22:29.49,0:22:35.15,Main,Luffy,0,0,0,,Ama dostum, ne kadar hızlı büyüdüğünün\Nbir sınırı olmalı, beni şaşırttın.
Dialogue: 0,0:22:35.15,0:22:37.99,Main,Luffy,0,0,0,,O zamanlar biraz daha\Nenine büyümüş birisiydin.
Dialogue: 0,0:22:37.99,0:22:40.50,Main,Coby,0,0,0,,Olaydan sonra oldukça yorgunsunuzdur,\Nsizi rahatsız ettiğim için özür dilerim.
Dialogue: 0,0:22:40.50,0:22:44.26,Main,Luffy,0,0,0,,Sorun değil. Uzun zaman\Noldu, hadi bir parti yapalım!
Dialogue: 0,0:22:45.82,0:22:48.63,Main,Helmeppo,0,0,0,,Hey bekleyin lan!
Dialogue: 0,0:22:49.08,0:22:51.10,Main,Helmeppo,0,0,0,,Beni tanıyamadınız mı?!
Dialogue: 0,0:22:51.42,0:22:52.42,Main,Zoro,0,0,0,,Kimsin sen?
Dialogue: 0,0:22:52.88,0:22:55.99,Main,Helmeppo,0,0,0,,Benim ben! B-E-N!
Dialogue: 0,0:22:55.99,0:22:57.52,Main,Luffy,0,0,0,,Hiçbir fikrim yok, kimsin sen?
Dialogue: 0,0:22:57.52,0:22:59.30,Main,Helmeppo,0,0,0,,Cevap ise...
Dialogue: 0,0:23:01.29,0:23:03.07,Main,Helmeppo,0,0,0,,Helmeppo.
Dialogue: 0,0:23:03.07,0:23:07.88,Main,Helmeppo,0,0,0,,Morgan'ın oğlu, Helmeppo.
Dialogue: 0,0:23:07.88,0:23:14.14,Main,Helmeppo,0,0,0,,Benim seni idam cezasına kadar\Nsürükleyen adamım, Roronoa Zoro!
Dialogue: 0,0:23:16.47,0:23:20.15,Main,Helmeppo,0,0,0,,Yeter artık, şakayı kesin.
Dialogue: 0,0:23:20.92,0:23:23.15,Main,Helmeppo,0,0,0,,Artık insanları korkutmana izin veremeyiz.
Dialogue: 0,0:23:25.47,0:23:29.41,Main,Helmeppo,0,0,0,,Bir ceset için oldukça neşeli\Ngörünüyorsun, Roronoa Zoro.
Dialogue: 0,0:23:30.24,0:23:31.24,Main,Girl,0,0,0,,Durun!
Dialogue: 0,0:23:32.42,0:23:35.88,Main,Helmeppo,0,0,0,,Ben, babasının ününden\Nyararlanan o aptalım!
Dialogue: 0,0:23:37.84,0:23:39.63,Main,Luffy/Zoro,0,0,0,,Of? Sen miydin ya o?
Dialogue: 0,0:23:39.63,0:23:41.54,Main,Helmeppo,0,0,0,,Hey!
Dialogue: 0,0:23:41.54,0:23:45.22,Main,Luffy,0,0,0,,Evet, öyle biri vardı... Sen miydin?
Dialogue: 0,0:23:46.08,0:23:51.36,Main,Helmeppo,0,0,0,,Bunu biliyordum... Hala bu\Nadamları affedemiyorum, Koby!
Dialogue: 0,0:23:51.36,0:23:54.19,Main,Coby,0,0,0,,Kaçınılmaz bir şey Helmeppo-san,\Ngeçmişinden kaçamazsın.
Dialogue: 0,0:23:54.81,0:23:56.04,Main,Zoro,0,0,0,,O muydu?
Dialogue: 0,0:23:56.04,0:23:57.12,Main,Luffy,0,0,0,,Oydu.
Dialogue: 0,0:23:57.12,0:23:59.49,Main,Garp,0,0,0,,Öyleyse, Askerler.
Dialogue: 0,0:23:59.49,0:24:00.16,Main,Guys,0,0,0,,Emredin!
Dialogue: 0,0:24:00.16,0:24:02.13,Main,Garp,0,0,0,,Şu duvarı tamir edin.
Dialogue: 0,0:24:03.27,0:24:04.83,Main,Marines,0,0,0,,Ama bunu siz kendi\Nkeyfiniz için yaptınız...
Dialogue: 0,0:24:04.85,0:24:07.84,Main,Marines,0,0,0,,Onu düzeltmemizi\Nistiyorsan, neden onu kırdın ki?
Dialogue: 0,0:24:07.84,0:24:10.41,Main,Garp,0,0,0,,Öyle girmesi daha havalıydı çünkü.
Dialogue: 0,0:24:10.41,0:24:13.10,Main,Marine,0,0,0,,Böyle bir sebep için bir\Nşeyleri kırmayın lüften!
Dialogue: 0,0:24:13.10,0:24:16.14,Main,Marine,0,0,0,,Öyle olsun ama tamir etmemizi\Nistiyorsan, o zaman sen de yardım ediceksin.
Dialogue: 0,0:24:17.94,0:24:18.94,Main,Garp,0,0,0,,Kabul.
Dialogue: 0,0:24:21.40,0:24:24.49,Main,Sanji,0,0,0,,Senin deden çok önemli biri değil miydi?
Dialogue: 0,0:24:24.49,0:24:27.45,Main,Luffy,0,0,0,,Sanırım öyle, ama ne iş yaptığı\Nhakkında pek bir şey bilmiyorum.
Dialogue: 0,0:24:28.63,0:24:32.88,Main,Garp,0,0,0,,Bu arada Luffy, \Nduydum ki babanla karşılamışsın.
Dialogue: 0,0:24:32.88,0:24:34.63,Main,Luffy,0,0,0,,Ne? Babam mı?
Dialogue: 0,0:24:34.63,0:24:36.55,Main,Luffy,0,0,0,,Ne demek babam?
Dialogue: 0,0:24:36.55,0:24:38.56,Main,Luffy,0,0,0,,Benim babam mı var?
Dialogue: 0,0:24:38.56,0:24:42.16,Main,Garp,0,0,0,,Ne? Demek ki kendini\Nsize tanıtmamış demek ki.
Dialogue: 0,0:24:42.16,0:24:44.86,Main,Garp,0,0,0,,Loguetown'da seni görmüş.
Dialogue: 0,0:24:44.86,0:24:48.30,Main,Sanji,0,0,0,,Luffy'nin babası o şehirde miydi?
Dialogue: 0,0:24:49.66,0:24:52.58,Main,Luffy,0,0,0,,Benim babam nasıl birisi?
Dialogue: 0,0:24:53.62,0:24:56.85,Main,Nami,0,0,0,,Acaba Luffy'nin babası nasıl biri...
Dialogue: 0,0:24:57.33,0:25:00.32,Main,Garp,0,0,0,,Senin babanın ismi...
Dialogue: 0,0:25:00.32,0:25:02.51,Main,Garp,0,0,0,,Monkey D. Dragon.
Dialogue: 0,0:25:02.51,0:25:03.72,Main,Garp,0,0,0,,O bir devrimci.
Dialogue: 0,0:25:04.61,0:25:06.09,Main,Luffy,0,0,0,,Dragon?
Dialogue: 0,0:25:15.03,0:25:19.26,Main,Marine,0,0,0,,Devrimci Dragon'un oğlu mu varmış???
Dialogue: 0,0:25:19.26,0:25:21.89,Main,Coby,0,0,0,,Luffy-san'ın Dragon'un oğlu olması...
Dialogue: 0,0:25:21.89,0:25:26.00,Main,Sherlock,0,0,0,,Bu demek ki... \NDragon Koramiral Garp'ın oğlu...
Dialogue: 0,0:25:26.00,0:25:28.50,Main,Helmeppo,0,0,0,,Bu ailenin derdi ne böyle?
Dialogue: 0,0:25:28.50,0:25:31.68,Main,Marine,0,0,0,,Dragon'un tam ismini ilk defa duyuyorum!
Dialogue: 0,0:25:32.39,0:25:35.43,Main,Luffy,0,0,0,,Hey çocuklar, Niye bu kadar...
Dialogue: 0,0:25:35.68,0:25:39.88,Main,Sanji,0,0,0,,Aptal! Dragon'un kim olduğunu bilmiyor musun?
Dialogue: 0,0:25:39.91,0:25:43.34,Main,Nami,0,0,0,,Senin baban inanılmaz büyük bir adam!
Dialogue: 0,0:25:46.06,0:25:47.40,Main,Luffy,0,0,0,,Hey, Robin...
Dialogue: 0,0:25:48.27,0:25:51.16,Main,Robin,0,0,0,,Nasıl açıklasam acaba...
Dialogue: 0,0:25:51.66,0:25:57.04,Main,Robin,0,0,0,,Korsanlar genellikle tek başlarına hükümete\Nveya denizcilere saldırmaya çalışmazlar...
Dialogue: 0,0:25:57.77,0:26:03.00,Main,Robin,0,0,0,,Ancak şu anda Dünya Hükümeti'ni\Ndoğrudan yok etmeye çalışan bir güç var.
Dialogue: 0,0:26:03.00,0:26:07.60,Main,Robin,0,0,0,,Bunu karşı çıkışını Devrimci Ordusu oluşturuyor.\NVe onun merkezindeki adam da Dragon.
Dialogue: 0,0:26:08.86,0:26:13.06,Main,Robin,0,0,0,,Şu anda dünya genelinde\Nbu ideoloji yayılıyor.
Dialogue: 0,0:26:13.06,0:26:14.96,Main,Robin,0,0,0,,Ülkeleri monarşilerini\Ndevirmeye teşvik ediyorlar.
Dialogue: 0,0:26:14.96,0:26:16.94,Main,Robin,0,0,0,,Sayısız ülke zaten düşmüş durumda.
Dialogue: 0,0:26:17.47,0:26:19.16,Main,Robin,0,0,0,,Beklendiği gibi, \NDünya Hükümeti bu duruma sinirlendi,...
Dialogue: 0,0:26:19.16,0:26:22.79,Main,Robin,0,0,0,,...ve Dragon'u dünyanın en\Ntehlikeli suçlusu olarak etiketledi.
Dialogue: 0,0:26:22.79,0:26:24.92,Main,Robin,0,0,0,,Onu sürekli olarak takip etmekteler, ama...
Dialogue: 0,0:26:26.17,0:26:29.38,Main,Robin,0,0,0,,Nereden geldiğine dair\Nbir iz bile bulamadılar.
Dialogue: 0,0:26:29.38,0:26:30.76,Main,Robin,0,0,0,,O çok gizemli biri...
Dialogue: 0,0:26:31.78,0:26:32.72,Main,Robin,0,0,0,,Buna rağmen...
Dialogue: 0,0:26:32.72,0:26:34.39,Main,Luffy,0,0,0,,Buna rağmen...?
Dialogue: 0,0:26:35.98,0:26:40.02,Main,Garp,0,0,0,,Sanırım bunu söylememeliydim.
Dialogue: 0,0:26:44.72,0:26:45.53,Main,Garp,0,0,0,,O zaman...
Dialogue: 0,0:26:45.53,0:26:47.16,Main,Garp,0,0,0,,Hiç olmamış gibi davranalım!
