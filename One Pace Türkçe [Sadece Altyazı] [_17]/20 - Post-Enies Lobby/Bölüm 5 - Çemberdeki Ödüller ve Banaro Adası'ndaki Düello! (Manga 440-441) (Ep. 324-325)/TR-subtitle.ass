,0,0,100,100,0,0,1,2,0,2,10,10,10,1Style: Attack,Duality,40.0,&H00FFD388,&H00FFFFFF,&H00000000,&H96000000,0,-1,0,0,100,100,0,0,1,1,1,7,12,12,12,1Style: Author,Impress BT,20.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1,1,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:23.89,0:00:29.17,Credits,,0,0,0,,Translation Cornman @ Vegapunk FansubsDialogue: 0,0:00:34.07,0:00:37.66,Credits,,0,0,0,,Initial timing Hedi @ Vegapunk FansubsDialogue: 0,0:00:37.87,0:00:41.41,Credits,,0,0,0,,Timing Galaxy 9000Dialogue: 0,0:00:41.58,0:00:44.96,Credits,,0,0,0,,Quality checking SewilDialogue: 0,0:00:45.21,0:00:48.84,Credits,,0,0,0,,Editing SewilDialogue: 0,0:00:54.72,0:00:58.68,Credits,,0,0,0,,Soundtracking MaideV and HaleeDialogue: 0,0:01:00.10,0:01:03.89,Credits,,0,0,0,,Raw providing SOFCJ-RawsDialogue: 0,0:00:14.43,0:00:19.27,Rainbow Star lyrics,,0,0,0,,♪ Kobalt mavisi gökte süzülen bulutlar,...Dialogue: 0,0:00:24.57,0:00:29.25,Rainbow Star lyrics,,0,0,0,,...kayboldu ve yarın hepimizi sırılsıklam edecek. ♪Dialogue: 0,0:00:33.96,0:00:39.09,Rainbow Star lyrics,,0,0,0,,♪ Günbatımından önce sadece gülümsersek her şey iyi olacak. ♪Dialogue: 0,0:00:39.09,0:00:43.48,Rainbow Star lyrics,,0,0,0,,♪ Eğer isteğin buysa, sadece yapabilirsin... ♪Dialogue: 0,0:00:43.60,0:00:45.94,Rainbow Star lyrics,,0,0,0,,♪ Göğsünde bir büyü söyle. ♪Dialogue: 0,0:00:46.52,0:00:49.32,Rainbow Star lyrics,,0,0,0,,♪ Umutlarınız için... ♪Dialogue: 0,0:00:54.79,0:00:56.62,Rainbow Star lyrics,,0,0,0,,♪ Hızlı önsezimiz...Dialogue: 0,0:00:56.62,0:00:59.46,Rainbow Star lyrics,,0,0,0,,...gökkuşağı renkli müzik notalarında gösteriliyor. ♪Dialogue: 0,0:01:02.34,0:01:04.84,Rainbow Star lyrics,,0,0,0,,♪ Benimle gelmeyecek misin? ♪Dialogue: 0,0:01:04.84,0:01:06.68,Rainbow Star lyrics,,0,0,0,,♪ Bizler düşmüş,...Dialogue: 0,0:01:06.68,0:01:09.43,Rainbow Star lyrics,,0,0,0,,...ateşli oklarımızı senin hayallerine yollayacağız. ♪Dialogue: 0,0:01:42.77,0:01:44.61,Rainbow Star lyrics,,0,0,0,,♪ Hangi rengi eklemeliyiz...Dialogue: 0,0:01:44.61,0:01:47.45,Rainbow Star lyrics,,0,0,0,,...kobalt mavisine? ♪Dialogue: 0,0:01:52.87,0:01:57.55,Rainbow Star lyrics,,0,0,0,,♪ Gözlerinde yansıyan üzücü gerçeği yok et. ♪Dialogue: 0,0:01:57.88,0:02:02.80,Rainbow Star lyrics,,0,0,0,,♪ Tüylerimizi sıcaklıkla dolu bir şekilde kaldıralım. ♪Dialogue: 0,0:02:02.80,0:02:04.76,Rainbow Star lyrics,,0,0,0,,♪ Sürreal düşmüş melekler,...Dialogue: 0,0:02:04.76,0:02:07.64,Rainbow Star lyrics,,0,0,0,,...kalbimizden şarkı söylüyorlar. ♪Dialogue: 0,0:02:29.87,0:02:38.27,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - BloodOmen thx to onepace.netDialogue: 0,0:13:09.00,0:13:19.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - BloodOmen thx to onepace.netDialogue: 0,0:22:46.00,0:22:55.70,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - BloodOmen thx to onepace.netDialogue: 0,0:02:29.87,0:02:38.27,Title,,0,0,0,,Çemberdeki Ödüller ve  Banaro Adası'ndaki Düello!Dialogue: 0,0:02:38.72,0:02:41.64,Main,Zeff,0,0,0,,Yargı adası olarak da bilinen Ennies Lobby ile ilgili konuşulurken,Dialogue: 0,0:02:41.87,0:02:44.64,Main,Zeff,0,0,0,,Dünya Hükümeti'nin yerinde bir karışıklık çıktıktan sonra,Dialogue: 0,0:02:44.64,0:02:48.60,Main,Zeff,0,0,0,,Hem denizciler hem de korsanlar sessiz kalamayacaklar.Dialogue: 0,0:02:49.02,0:02:53.15,Main,Zeff,0,0,0,,Şu anda, Hasır Şapkalı korsanların adı tüm dünyada yankılanıyor.Dialogue: 0,0:02:53.15,0:02:55.13,Main,Zeff,0,0,0,,Hem de bu posterle.Dialogue: 0,0:02:57.51,0:02:59.25,Main,Pattie,0,0,0,,Sanji çok iyi ya!Dialogue: 0,0:03:00.42,0:03:04.24,Captions small,TL,0,0,0,,Doğu MaviDialogue: 0,0:03:00.42,0:03:04.24,Captions small,tl,0,0,0,, Yüzen Restoran Baratie.Dialogue: 0,0:03:00.82,0:03:02.84,Main,Chef,0,0,0,,Harika değil mi, müşterilerimiz?!Dialogue: 0,0:03:02.84,0:03:04.24,Main,Chef,0,0,0,,Gerçeğine çok benziyor!Dialogue: 0,0:03:04.24,0:03:09.07,Main,Pattie,0,0,0,,Burası, 77 milyon beli ödüllü Kara Bacak Sanji'nin evidir!Dialogue: 0,0:03:09.07,0:03:13.24,Main,Chef,0,0,0,,Yüzen Restoran Baratie'ye hoşgeldiniz!Dialogue: 0,0:03:13.25,0:03:17.16,Captions small,TL,0,0,0,,Doğu MaviDialogue: 0,0:03:13.24,0:03:17.16,Captions small,TL,0,0,0,,Fuusha Kasabası Luffy'nin MemleketiDialogue: 0,0:03:14.68,0:03:16.36,Main,Citizen,0,0,0,,Kutlama!Dialogue: 0,0:03:16.36,0:03:18.00,Main,Citizen,0,0,0,,Bugünü kutluyoruz!Dialogue: 0,0:03:18.00,0:03:20.24,Main,Citizen,0,0,0,,Doğudaki en yüksek ödüllü kişi adına!Dialogue: 0,0:03:20.24,0:03:22.02,Main,Citizen,0,0,0,,300 milyonluk ödül!Dialogue: 0,0:03:22.02,0:03:25.38,Main,Citizens,0,0,0,,Luffy'miz için şerefe!Dialogue: 0,0:03:29.37,0:03:31.73,Main,Woop Slap,0,0,0,,Susun lan!Dialogue: 0,0:03:31.73,0:03:33.61,Main,Woop Slap,0,0,0,,Utanın kendinizden! Utanın!Dialogue: 0,0:03:33.61,0:03:35.20,Main,Citizens,0,0,0,,Şerefe!Dialogue: 0,0:03:35.20,0:03:36.52,Main,Woop Slap,0,0,0,,Hey!Dialogue: 0,0:03:37.61,0:03:38.61,Main,Woop Slap,0,0,0,,Aman be...Dialogue: 0,0:03:39.02,0:03:41.94,Main,Woop Slap,0,0,0,,Kimse bir muhtarın dediğini takmıyor.Dialogue: 0,0:03:43.15,0:03:44.59,Main,Makino,0,0,0,,Görünüşe göre eğleniyor gibi.Dialogue: 0,0:03:44.59,0:03:47.34,Main,Makino,0,0,0,,Sevimli bir evcil hayvanı bile var.Dialogue: 0,0:03:47.34,0:03:49.28,Main,Makino,0,0,0,,Diğerleri de Luffy'nin arkadaşları olmalı.Dialogue: 0,0:03:49.52,0:03:52.23,Main,Woop Slap,0,0,0,,O suçluları arkadaş olarak değerlendirmek mi?Dialogue: 0,0:03:55.18,0:03:59.13,Main,Woop Slap,0,0,0,,Bütün dünyanın düşmanı köyümüzden çıktı!Dialogue: 0,0:03:59.99,0:04:03.68,Main,Woop Slap,0,0,0,,Hiç Dünya Hükümeti'ne karşı savaş ilan eden bir korsan görmemiştim!Dialogue: 0,0:04:03.68,0:04:04.68,Main,Makino,0,0,0,,Orası öyle...Dialogue: 0,0:04:04.80,0:04:07.70,Main,Woop Slap,0,0,0,,Garp ne yaptığını sanıyor?Dialogue: 0,0:04:07.70,0:04:10.65,Main,Woop Slap,0,0,0,,Torununun böyle bir şeye sebep olması korkunç bir olay.Dialogue: 0,0:04:10.65,0:04:12.87,Main,Woop Slap,0,0,0,,O üçünde bir sorun var...Dialogue: 0,0:04:12.87,0:04:14.72,Main,Woop Slap,0,0,0,,Acaba Dadan bunu biliyor mu...Dialogue: 0,0:04:15.09,0:04:16.58,Main,Citizens,0,0,0,,Şerefe!Dialogue: 0,0:04:16.58,0:04:18.18,Main,Woop Slap,0,0,0,,Size sessiz olun dedim!Dialogue: 0,0:04:18.18,0:04:22.14,Captions small,TL,0,0,0,,Doğu MaviDialogue: 0,0:04:18.18,0:04:22.14,Captions small,TL,0,0,0,, Syrup (Şurup) Kasabası Usopp'un MemleketiDialogue: 0,0:04:22.99,0:04:24.96,Main,Kaya,0,0,0,,Sogeking, keskin nişancıların kralı...Dialogue: 0,0:04:24.96,0:04:25.94,Main,Kaya,0,0,0,,Doğru!Dialogue: 0,0:04:25.94,0:04:27.13,Main,Kaya,0,0,0,,Kesinlikle bu o!Dialogue: 0,0:04:27.13,0:04:28.37,Main,Kaya,0,0,0,,Bu kişi Usopp-san!Dialogue: 0,0:04:28.37,0:04:29.00,Main,Little Boy,0,0,0,,Değil mi?!Dialogue: 0,0:04:29.00,0:04:31.11,Main,Little Boy,0,0,0,,Bu kaptanımızın burnu değil mi?!Dialogue: 0,0:04:31.99,0:04:34.20,Main,Piiman,0,0,0,,Köylüler bize inanmıyor!Dialogue: 0,0:04:34.20,0:04:36.02,Main,Ninjin,0,0,0,,30 milyon değerinde!Dialogue: 0,0:04:36.02,0:04:38.25,Main,Tamanegi,0,0,0,,Ama Kaya-san'ın anlayacağını düşünmüştük!Dialogue: 0,0:04:38.51,0:04:40.83,Main,Ninjin,0,0,0,,Kaptan'ın harikalığını kimse bilmiyor!Dialogue: 0,0:04:40.83,0:04:44.45,Main,Piiman,0,0,0,,Kaptan, tüm yalanları gerçeğe dönüştüren bir adamdır!Dialogue: 0,0:04:45.66,0:04:47.74,Main,Ninjin,0,0,0,,Maskesi çok havalı!Dialogue: 0,0:04:47.74,0:04:49.16,Main,Piiman,0,0,0,,Hadi gidip benzerini yapalım.Dialogue: 0,0:04:50.18,0:04:51.97,Main,Piiman,0,0,0,,Nereye gidiyorsun Kaya-san?Dialogue: 0,0:04:53.57,0:04:56.21,Main,Kaya,0,0,0,,Tıp çalışmalarıma devam etmeye...Dialogue: 0,0:04:56.21,0:04:58.33,Main,Kaya,0,0,0,,Ben de bir gün muhteşem bir doktor olacağım!Dialogue: 0,0:04:58.33,0:05:02.56,Main,Kaya,0,0,0,,Bu yüzden Usopp-san yaralı dönse bile, tüm yaralarını iyileştirebilirim!Dialogue: 0,0:05:05.80,0:05:07.74,Main,Little Boy,0,0,0,,Kaptanı kıskandım...Dialogue: 0,0:05:07.74,0:05:10.10,Main,Little Boy,0,0,0,,Kaya-san'ı üzerse onu dövelim.Dialogue: 0,0:05:11.40,0:05:15.86,Captions small,TL,0,0,0,,Doğu MaviDialogue: 0,0:05:11.40,0:05:15.86,Captions small,TL,0,0,0,,Shimotsuki Köyü Zoro'nun MemleketiDialogue: 0,0:05:11.85,0:05:12.95,Main,Kid,0,0,0,,Sensei! Sensei!Dialogue: 0,0:05:12.95,0:05:15.86,Main,Kid,0,0,0,,Korsan Avcısı Zoro'nun bu dojo da eğitim aldığı doğru mu?!Dialogue: 0,0:05:16.18,0:05:18.00,Main,Koshiro,0,0,0,,Evet, bu doğru.Dialogue: 0,0:05:18.00,0:05:20.84,Main,Koshiro,0,0,0,,Ama ona özenmenizi yasaklıyorum size!Dialogue: 0,0:05:22.10,0:05:23.88,Main,Kid,0,0,0,,Neden?! O çok havalı!Dialogue: 0,0:05:23.88,0:05:26.27,Main,Kid,0,0,0,,Lütfen bize nasıl korsan olacağını öğretin!Dialogue: 0,0:05:26.27,0:05:28.25,Main,Koshiro,0,0,0,,Ona korsan olmayı öğretmedim ki.Dialogue: 0,0:05:28.52,0:05:29.43,Main,Kid,0,0,0,,Harbi mi?!Dialogue: 0,0:05:29.43,0:05:31.09,Main,Kid,0,0,0,,Yalan söyleme, sensei!Dialogue: 0,0:05:31.09,0:05:34.01,Thoughts,Koshiro,0,0,0,,Vay canına, kendilerine baş belası bir senpai seçmişler.Dialogue: 0,0:05:31.09,0:05:34.01,Secondary,Kid,0,0,0,,Ben de böyle harika bir kılıç ustası olmak istiyorum!Dialogue: 0,0:05:34.01,0:05:36.99,Thoughts,Koshiro,0,0,0,,Ennies Lobby'deki olaylardan dolayı şaşırdım, ama...Dialogue: 0,0:05:34.01,0:05:35.01,Secondary,Kid,0,0,0,,Ben de!Dialogue: 0,0:05:36.99,0:05:40.49,Thoughts,Koshiro,0,0,0,,Zoro-kun, görüşüne göre bir pişmanlığın yok.Dialogue: 0,0:05:40.49,0:05:42.28,Thoughts,Koshiro,0,0,0,,Nasıl birisi olursan ol,Dialogue: 0,0:05:42.28,0:05:45.56,Thoughts,Koshiro,0,0,0,,kılıcın yoluna değer verdiğin sürece sorun yok.Dialogue: 0,0:05:45.56,0:05:50.02,Captions small,TL,0,0,0,,Doğu MaviDialogue: 0,0:05:45.56,0:05:50.02,Captions small,TL,0,0,0,,Cocoyashi Köyü Nami'nin MemleketiDialogue: 0,0:05:48.35,0:05:50.02,Main,Nojiko,0,0,0,,Gen-san!Dialogue: 0,0:05:50.02,0:05:51.48,Main,Nojiko,0,0,0,,Portakalları getirdim.Dialogue: 0,0:05:51.48,0:05:53.99,Main,Genzo,0,0,0,,Ne oldu, yine mi getirdin onları, Nojiko?!Dialogue: 0,0:05:53.99,0:05:55.64,Main,Genzo,0,0,0,,Sana dükkândan alacağımı söylememe rağmen.Dialogue: 0,0:05:55.64,0:05:58.70,Main,Nojiko,0,0,0,,Neyse, sadece kabul et, mütevazı olma.Dialogue: 0,0:05:58.70,0:06:01.71,Main,Nojiko,0,0,0,,Nami ve benim için bir baba gibi olduğunu biliyorsun.Dialogue: 0,0:06:02.21,0:06:03.97,Main,Genzo,0,0,0,,Eğer öyle diyorsan.Dialogue: 0,0:06:03.97,0:06:05.02,Main,Genzo,0,0,0,,Ne yapıyorsun?Dialogue: 0,0:06:05.46,0:06:06.61,Main,Genzo,0,0,0,,Ya...Dialogue: 0,0:06:07.21,0:06:10.41,Main,Genzo,0,0,0,,Den Den Mushi kullanarak Denizci Karargahı'nı arayıp şikayette bulunmaya çalışıyorum.Dialogue: 0,0:06:10.41,0:06:12.10,Main,Genzo,0,0,0,,Ama bir kere bile bağlanamadım!Dialogue: 0,0:06:13.49,0:06:14.48,Main,Nojiko,0,0,0,,Şikayet?Dialogue: 0,0:06:14.48,0:06:15.48,Main,Genzo,0,0,0,,Aynen!Dialogue: 0,0:06:16.01,0:06:20.26,Main,Genzo,0,0,0,,Bu uygunsuz posteri gerçekten tüm dünyaya dağıtabileceklerini mi sanıyorlar?Dialogue: 0,0:06:20.26,0:06:24.02,Main,Genzo,0,0,0,,Ödül avcıları yerine aşık takipçiler peşinden sürüklenecek! Kabul edilemez!Dialogue: 0,0:06:24.02,0:06:26.36,Main,Nojiko,0,0,0,,Fotoğrafı beğendin ama değil mi?Dialogue: 0,0:06:26.36,0:06:28.24,Main,Nojiko,0,0,0,,Onu büyütüp asmışsın bir de.Dialogue: 0,0:06:29.42,0:06:31.27,Main,Nojiko,0,0,0,,Neyse, sorun değil, üstelik...Dialogue: 0,0:06:31.27,0:06:33.07,Main,Nojiko,0,0,0,,Sana verdikleri sözü tutuyorlar...Dialogue: 0,0:06:33.79,0:06:37.99,Flashbacks,Genzo,0,0,0,,Eğer Nami'nin gülümsemesini çalarsan,Dialogue: 0,0:06:37.99,0:06:39.98,Flashbacks,Genzo,0,0,0,,bizzat seni öldürmeye gelirim!Dialogue: 0,0:06:41.13,0:06:43.06,Main,Nojiko,0,0,0,,Bu da kanıtı.Dialogue: 0,0:06:43.06,0:06:44.74,Main,Genzo,0,0,0,,Evet, öyle tabii ki ama...Dialogue: 0,0:06:45.13,0:06:47.20,Main,Genzo,0,0,0,,Bu korsanların sorunu!Dialogue: 0,0:06:47.20,0:06:49.10,Main,Nojiko,0,0,0,,Öyleyse, çirkin bir fotoğrafı mı tercih edersin?Dialogue: 0,0:06:49.10,0:06:51.71,Main,Genzo,0,0,0,,Hayır! Bu kabul edilemez!Dialogue: 0,0:06:51.71,0:06:56.67,Captions small,TL,0,0,0,, Grand LineDialogue: 0,0:06:51.71,0:06:56.67,Captions small,TL,0,0,0,,Sakura Krallığı            Chopper'ın MemleketiDialogue: 0,0:07:07.37,0:07:08.60,Main,Dalton,0,0,0,,Doktor Kureha.Dialogue: 0,0:07:09.15,0:07:11.81,Main,Kureha,0,0,0,,Dalton, beni niye çağırdın?Dialogue: 0,0:07:11.81,0:07:13.78,Main,Kureha,0,0,0,,Ben meşgul bir insanım!Dialogue: 0,0:07:13.78,0:07:15.58,Main,Dalton,0,0,0,,Kusura bakma.Dialogue: 0,0:07:15.58,0:07:17.38,Main,Dalton,0,0,0,,Sana bunu göstermeliydim.Dialogue: 0,0:07:17.38,0:07:19.83,Main,Kureha,0,0,0,,Ne istiyorsun? Gençliğimin sırrını mı?Dialogue: 0,0:07:20.14,0:07:24.73,Main,Kureha,0,0,0,,Neyse, Dalton, neden kral olarak kalede yaşamıyorsun?Dialogue: 0,0:07:24.73,0:07:26.00,Main,Kureha,0,0,0,,Sana oda veririm.Dialogue: 0,0:07:26.38,0:07:29.68,Main,Dalton,0,0,0,,Hayır, teşekkür ederim, zaten bu köyde yaşamaya alıştım.Dialogue: 0,0:07:29.68,0:07:31.76,Main,Dalton,0,0,0,,Ayrıca, kestane yemeyi severim.Dialogue: 0,0:07:34.44,0:07:37.47,Main,Kureha,0,0,0,,Hasır Şapka ve diğer veletler...Dialogue: 0,0:07:37.85,0:07:40.72,Main,Dalton,0,0,0,,Son olaydan sonra aranıyor posterleri ortaya çıktı.Dialogue: 0,0:07:42.62,0:07:43.89,Main,Kureha,0,0,0,,Chopper.Dialogue: 0,0:07:43.89,0:07:46.27,Main,Dalton,0,0,0,,Sanırım miktar konusunda bir hata yaptılar.Dialogue: 0,0:07:47.53,0:07:50.39,Main,Kureha,0,0,0,,Yüzünü görebildiğim için sorun değil.Dialogue: 0,0:07:50.68,0:07:52.05,Main,Kureha,0,0,0,,Öyle mi...Dialogue: 0,0:07:52.05,0:07:54.59,Main,Kureha,0,0,0,,Bu, uzun süredir aldığım en iyi haber.Dialogue: 0,0:07:56.42,0:08:02.33,Captions small,TL,0,0,0,, Grand LineDialogue: 0,0:07:56.42,0:08:02.33,Captions small,TL,0,0,0,, Beyaz Toprak Adası, Baltigo.Dialogue: 0,0:07:58.22,0:08:02.33,Main,Terry Gilteo,0,0,0,,Devrim, Güney Mavi'de Santa Urea'da başarılı oldu!Dialogue: 0,0:08:02.77,0:08:04.71,Main,Dragon,0,0,0,,Bir krallık daha düştü demek he...Dialogue: 0,0:08:04.96,0:08:06.14,Main,Rev Army Guy,0,0,0,,Başardılar!Dialogue: 0,0:08:06.14,0:08:07.73,Main,Rev Army Guy,0,0,0,,Bu sayede, diğer gün Kuzey Mavi ile ilgili haberler...Dialogue: 0,0:08:07.73,0:08:09.53,Main,Dragon,0,0,0,,Bir zaferden memnun olma!Dialogue: 0,0:08:09.53,0:08:10.65,Main,Dragon,0,0,0,,Bu bir savaş.Dialogue: 0,0:08:10.65,0:08:12.89,Main,Rev Army Guy,0,0,0,,Kusura bakmayın efendim...Dialogue: 0,0:08:14.76,0:08:15.82,Main,Dragon,0,0,0,,Bu nedir?Dialogue: 0,0:08:17.27,0:08:18.47,Main,Terry Gilteo,0,0,0,,Bu Hasır Şapkalı Luffy.Dialogue: 0,0:08:19.19,0:08:22.70,Main,Terry Gilteo,0,0,0,,Arabasta'da Crocodile'ı deviren kişi.Dialogue: 0,0:08:22.70,0:08:28.02,Main,Terry Gilteo,0,0,0,,Enies Lobby'deki olaylardan sonra, hükümet bu büyük korsan grubunu gizlemeye devam edemedi.Dialogue: 0,0:08:28.29,0:08:33.98,Main,Terry Gilteo,0,0,0,,Tayfanın toplam ödülü 667 milyon 50 beli.Dialogue: 0,0:08:33.98,0:08:36.82,Main,Terry Gilteo,0,0,0,,Kaptanları denizci Garp'ın...Dialogue: 0,0:08:37.47,0:08:38.56,Main,Terry Gilteo,0,0,0,,Nere gidiyorsunuz efendim?Dialogue: 0,0:08:38.56,0:08:40.83,Main,Dragon,0,0,0,,Biraz hava almaya.Dialogue: 0,0:08:44.41,0:08:47.95,Main,Dragon,0,0,0,,İstediğin gibi yaşa, Luffy.Dialogue: 0,0:08:47.95,0:08:52.60,Main,Dragon,0,0,0,,Bazı dönemlerdeki olaylar aniden her şeyi belirleyebilir...Dialogue: 0,0:08:55.53,0:08:58.11,Main,Dragon,0,0,0,,Dünyayı sorgula!Dialogue: 0,0:08:58.11,0:09:01.72,Main,Dragon,0,0,0,,Buluşacağımız zaman gelecek.Dialogue: 0,0:08:54.86,0:09:02.86,Captions small,TL,0,0,0,,Dünyanın En Çok Aranan SuçlusuDialogue: 0,0:08:54.86,0:09:02.86,Captions small,TL,0,0,0,, DevrimciDialogue: 0,0:08:54.86,0:09:02.86,Captions small,TL,0,0,0,,DragonDialogue: 0,0:08:54.86,0:09:02.86,Captions small,TL,0,0,0,,Monkey D. DragonDialogue: 0,0:09:04.29,0:09:06.90,Main,Blackbeard,0,0,0,,Oh! Ace!Dialogue: 0,0:09:12.34,0:09:19.62,Narrator,Narrator,0,0,0,,Hasır Şapka tayfasının ödüllerinin tüm dünyayı şaşırttığı günün üç gün öncesine geri dönüyoruz.Dialogue: 0,0:09:20.17,0:09:24.10,Narrator,Narrator,0,0,0,,Belirli bir adada bir olay meydana geldi...Dialogue: 0,0:09:24.10,0:09:27.58,Narrator,Narrator,0,0,0,,Burası Grand Line'daki, Banaro Adası.Dialogue: 0,0:09:27.58,0:09:28.88,Main,Blackbeard,0,0,0,,Kumandanım.Dialogue: 0,0:09:29.23,0:09:35.21,Main,Ace,0,0,0,,Kes şunu! Kumandanım kelimesini sadece o kişiye saygı duyanlar kullanabilir.Dialogue: 0,0:09:35.21,0:09:36.75,Main,Ace,0,0,0,,Alay etmeyi kes.Dialogue: 0,0:09:37.73,0:09:39.88,Main,BB Crew,0,0,0,,Siz çok ünlü birisiniz Ateş Yumruk Ace...Dialogue: 0,0:09:39.88,0:09:40.73,Main,Ace,0,0,0,,Evet, öyle.Dialogue: 0,0:09:40.73,0:09:41.81,Main,Ace,0,0,0,,Memnun oldum.Dialogue: 0,0:09:41.81,0:09:45.73,Main,Ace,0,0,0,,Sen de bayağı sağlam bir kaptan oldun, değil mi?Dialogue: 0,0:09:45.73,0:09:49.89,Main,Ace,0,0,0,,Karasakal Korsanları Kaptanı, Marshall D. Teach.Dialogue: 0,0:09:51.99,0:09:53.77,Main,Blackbeard,0,0,0,,Ne oldu, Ace?!Dialogue: 0,0:09:53.77,0:09:55.39,Main,Blackbeard,0,0,0,,Uzun zaman oldu!Dialogue: 0,0:09:55.39,0:09:57.41,Main,Blackbeard,0,0,0,,Burada olduğumu nereden bildin?Dialogue: 0,0:09:57.41,0:10:00.30,Main,Ace,0,0,0,,Teach, gereksiz sorular sormayı kes.Dialogue: 0,0:10:00.30,0:10:02.77,Main,Ace,0,0,0,,Sen birisinin canını aldın.Dialogue: 0,0:10:02.77,0:10:06.08,Main,Ace,0,0,0,,Mevcut durumu anlama yeteneğine sahip olmalısın.Dialogue: 0,0:10:06.08,0:10:07.76,Main,Ace,0,0,0,,Öyle değil mi?Dialogue: 0,0:10:07.76,0:10:09.50,Main,Blackbeard,0,0,0,,Evet, biliyorum.Dialogue: 0,0:10:09.50,0:10:12.10,Main,Blackbeard,0,0,0,,Öyleyse, o zaman sadece bir şey söylememe izin ver.Dialogue: 0,0:10:12.10,0:10:15.88,Main,Blackbeard,0,0,0,,Ace, tayfama katılır mısın?!Dialogue: 0,0:10:16.20,0:10:18.37,Main,Blackbeard,0,0,0,,Birlikte dünyayı ele geçirelim!Dialogue: 0,0:10:18.37,0:10:21.09,Main,Blackbeard,0,0,0,,Her şeyi çoktan planladım.Dialogue: 0,0:10:21.31,0:10:24.12,Main,Blackbeard,0,0,0,,Beyazsakal'ın zamanı bitti.Dialogue: 0,0:10:24.12,0:10:26.06,Main,Blackbeard,0,0,0,,Korsanlar Kralı ben olacağım!Dialogue: 0,0:10:26.47,0:10:33.49,Main,Blackbeard,0,0,0,,İlk olarak, Water 7'a gidip Hasır Şapka'yı öldürüp hükümete kellesini teslim edeceğim.Dialogue: 0,0:10:34.21,0:10:35.73,Main,Ace,0,0,0,,Luffy...?!Dialogue: 0,0:10:35.73,0:10:36.65,Main,Ace,0,0,0,,Ne diyorsun...?Dialogue: 0,0:10:36.65,0:10:39.06,Main,Blackbeard,0,0,0,,Oh, onu tanıyorsun?Dialogue: 0,0:10:39.06,0:10:41.66,Main,Ace,0,0,0,,Ona parmağını bile süremezsin.Dialogue: 0,0:10:41.66,0:10:43.24,Main,Ace,0,0,0,,O benim küçük kardeşim!Dialogue: 0,0:10:44.45,0:10:48.50,Main,Ace,0,0,0,,Ve tabii ki katılmayacağım...Dialogue: 0,0:10:50.06,0:10:51.06,Main,Ace,0,0,0,,Senin tayfana.Dialogue: 0,0:10:52.90,0:10:55.30,Main,Ace,0,0,0,,Burada kendini bilmez adam var gibi görünüyor.Dialogue: 0,0:10:55.61,0:10:56.61,Main,Ace,0,0,0,,Fire Gun!Dialogue: 0,0:10:55.61,0:10:56.61,Attack,Ace,0,0,0,,Ateş SilahıDialogue: 0,0:11:02.05,0:11:03.14,Main,Ace,0,0,0,,Henkai...Dialogue: 0,0:11:02.05,0:11:03.14,Attack,Ace,0,0,0,,Ateş EmriDialogue: 0,0:11:04.28,0:11:05.28,Main,Ace,0,0,0,,NibashiraDialogue: 0,0:11:04.28,0:11:05.28,Attack,Ace,0,0,0,,Alev SütunuDialogue: 0,0:11:12.44,0:11:14.19,Main,Blackbeard,0,0,0,,Auger, Burgess.Dialogue: 0,0:11:14.19,0:11:16.28,Main,Blackbeard,0,0,0,,Kafanıza göre iş yapmayın!Dialogue: 0,0:11:16.28,0:11:18.50,Main,Blackbeard,0,0,0,,Onla yarışamazsınız!Dialogue: 0,0:11:18.50,0:11:19.58,Main,Blackbeard,0,0,0,,Geri durun!Dialogue: 0,0:11:19.58,0:11:20.28,Main,BB Crew,0,0,0,,Pardon.Dialogue: 0,0:11:20.42,0:11:21.42,Main,Ace,0,0,0,,Hiken!Dialogue: 0,0:11:20.42,0:11:21.42,Attack,Ace,0,0,0,,Ateş YumruğuDialogue: 0,0:11:27.43,0:11:28.70,Main,BB Crew,0,0,0,,Kaptan!Dialogue: 0,0:11:29.71,0:11:30.71,Main,BB Crew,0,0,0,,Kaptan!Dialogue: 0,0:11:36.57,0:11:37.57,Main,BB Crew,0,0,0,,Kaptan.Dialogue: 0,0:11:41.76,0:11:43.62,Main,Blackbeard,0,0,0,,Kesin şunu, yavşaklar!Dialogue: 0,0:11:43.62,0:11:44.74,Main,Blackbeard,0,0,0,,Geri durun!Dialogue: 0,0:11:51.24,0:11:53.93,Main,Blackbeard,0,0,0,,Anladım, Ace.Dialogue: 0,0:11:53.93,0:11:56.15,Main,Blackbeard,0,0,0,,Beni öldürmek istiyorsun, değil mi?Dialogue: 0,0:11:56.15,0:11:59.94,Main,Blackbeard,0,0,0,,Evet öyle, tayfa üyesinin öldürülmesi büyük bir suç.Dialogue: 0,0:12:00.31,0:12:04.32,Main,Blackbeard,0,0,0,,4.filo kumandanını benim öldürdüğüm doğru!Dialogue: 0,0:12:04.32,0:12:06.48,Main,Blackbeard,0,0,0,,Seçeneğim yoktu!Dialogue: 0,0:12:06.48,0:12:09.75,Main,Blackbeard,0,0,0,,Onda benim istediğim şeytan meyvesi vardı.Dialogue: 0,0:12:10.38,0:12:14.54,Main,Blackbeard,0,0,0,,Geminin kuralı şuydu:  Bulan kişinin yemesine izin verilir.Dialogue: 0,0:12:14.54,0:12:18.13,Main,Blackbeard,0,0,0,,Bir kitaptan tüm şeytan meyvesi görünüşlerini ezberledim, bu yüzden...Dialogue: 0,0:12:18.13,0:12:22.13,Main,Blackbeard,0,0,0,,hemen onun aradığım şeytan meyvesi olduğunu anladım.Dialogue: 0,0:12:22.13,0:12:30.10,Main,Blackbeard,0,0,0,,O şeytan meyvesine rastlama şansını artıracağını düşünerek tüm o on yılları Beyazsakal'ın gemisinde geçirdim.Dialogue: 0,0:12:31.49,0:12:34.10,Main,Blackbeard,0,0,0,,Şansım tükenmiş olsaydı vazgeçerdim, ama...Dialogue: 0,0:12:34.53,0:12:37.44,Main,Blackbeard,0,0,0,,O meyve arkadaşımın eline geçti!Dialogue: 0,0:12:40.00,0:12:44.15,Main,Ace,0,0,0,,Ve Thatch'i öldürdükten sonra... Çaldın.Dialogue: 0,0:12:44.43,0:12:46.15,Main,Blackbeard,0,0,0,,Neyse, anlık bir dürtüydü sadece.Dialogue: 0,0:12:47.30,0:12:51.43,Main,Blackbeard,0,0,0,,Bu yetenek beni seçti, Ace!Dialogue: 0,0:12:53.91,0:12:57.17,Main,Blackbeard,0,0,0,,Bunun sayesinde en güçlü adam oldum, Ace!Dialogue: 0,0:12:58.05,0:12:58.93,Main,Blackbeard,0,0,0,,Bak!Dialogue: 0,0:12:58.93,0:13:01.70,Main,Blackbeard,0,0,0,,Bu logialar arasında bile nadir meyve!Dialogue: 0,0:13:06.35,0:13:09.41,Main,Blackbeard,0,0,0,,Ace, senin bedenin ateşti, değil mi?Dialogue: 0,0:13:16.17,0:13:17.94,Main,Blackbeard,0,0,0,,Ben ise...Dialogue: 0,0:13:17.94,0:13:19.11,Main,Blackbeard,0,0,0,,Karanlığım!Dialogue: 0,0:13:20.30,0:13:23.43,Main,Villagers,0,0,0,,Bak! İşte önceki siyah duman!Dialogue: 0,0:13:23.43,0:13:25.70,Main,Villagers,0,0,0,,O korsanlar hala şehirde mi?Dialogue: 0,0:13:25.96,0:13:28.39,Main,Villagers,0,0,0,,Hala bir şeylerin peşindeler!Dialogue: 0,0:13:28.39,0:13:30.61,Main,Villagers,0,0,0,,Bu gidişle kasaba yok olur!Dialogue: 0,0:13:30.61,0:13:31.86,Main,Villagers,0,0,0,,Yaklaşmayın!Dialogue: 0,0:13:31.86,0:13:33.51,Main,Villagers,0,0,0,,Sadece kaçın!Dialogue: 0,0:13:40.49,0:13:41.92,Main,Ace,0,0,0,,Karanlık?Dialogue: 0,0:13:42.61,0:13:45.37,Main,Blackbeard,0,0,0,,Evet, Kumandan Ace.Dialogue: 0,0:13:45.37,0:13:48.25,Main,Blackbeard,0,0,0,,Senin tarafından öldürülemem!Dialogue: 0,0:13:48.25,0:13:52.59,Main,Blackbeard,0,0,0,,Tarihe geçen tüm şeytan meyveleri arasında, bu güce sahip olan en korkutucu olarak bilinir!Dialogue: 0,0:13:53.12,0:13:56.12,Main,Blackbeard,0,0,0,,Logia, Karanlık Karanlık Meyvesi.Dialogue: 0,0:13:56.12,0:13:59.05,Main,Blackbeard,0,0,0,,Karanlık insan oldum!Dialogue: 0,0:13:59.05,0:14:03.32,Main,Blackbeard,0,0,0,,Şimdi sana gücümün tadını tattıracağım!Dialogue: 0,0:14:05.51,0:14:06.98,Main,Ace,0,0,0,,Dilediğin gibi yap.Dialogue: 0,0:14:10.80,0:14:12.36,Main,BB Crew,0,0,0,,Ne yapıyorsun? Acele et!Dialogue: 0,0:14:12.36,0:14:13.85,Main,BB Crew,0,0,0,,Kaptan delirdi!Dialogue: 0,0:14:13.85,0:14:15.03,Main,BB Crew,0,0,0,,Acele et ve saklan!Dialogue: 0,0:14:15.03,0:14:18.13,Main,BB Crew,0,0,0,,Biz bile arada kaynayıp gidebiliriz!Dialogue: 0,0:14:18.13,0:14:19.56,Main,BB Crew,0,0,0,,Kalksana!Dialogue: 0,0:14:35.61,0:14:37.44,Main,Villagers,0,0,0,,Bir şey yerde yayılıyor.Dialogue: 0,0:14:37.44,0:14:40.24,Main,Villagers,0,0,0,,O vücudundan çıkan şey.Dialogue: 0,0:14:40.24,0:14:41.36,Main,Villagers,0,0,0,,Çok korkutucu!Dialogue: 0,0:14:41.36,0:14:44.03,Main,Villagers,0,0,0,,Yere açılan bir simsiyah delik gibi!Dialogue: 0,0:14:44.03,0:14:45.86,Main,Villagers,0,0,0,,Görünüşe göre içine çekilebiliriz!Dialogue: 0,0:14:46.25,0:14:47.50,Main,Villagers,0,0,0,,Acele edip kaçalım!Dialogue: 0,0:14:47.50,0:14:48.71,Main,Villagers,0,0,0,,Sığınacak bir yer bulun!Dialogue: 0,0:14:50.41,0:14:52.24,Main,Villagers,0,0,0,,Ormana gidin!Dialogue: 0,0:14:52.24,0:14:53.88,Main,Villagers,0,0,0,,Sahile kadar kaçalım!Dialogue: 0,0:14:59.84,0:15:01.87,Main,Blackbeard,0,0,0,,Karanlık kütle çekimidir.Dialogue: 0,0:15:01.87,0:15:04.55,Main,Blackbeard,0,0,0,,Her şeyi içine çeken bir güç..Dialogue: 0,0:15:04.55,0:15:06.64,Main,Blackbeard,0,0,0,,Işık bile bundan kaçamaz,Dialogue: 0,0:15:06.64,0:15:09.21,Main,Blackbeard,0,0,0,,sonsuz kütle çekimi.Dialogue: 0,0:15:11.06,0:15:15.14,Main,Ace,0,0,0,,Yine de, bana ulaşmıyor gibi görünüyor.Dialogue: 0,0:15:15.65,0:15:18.27,Main,Blackbeard,0,0,0,,Henüz senin peşine düşmüyorum...Dialogue: 0,0:15:18.77,0:15:21.79,Main,Blackbeard,0,0,0,,Sadece dur ve kasabaya bir bak.Dialogue: 0,0:15:23.62,0:15:25.10,Main,Blackbeard,0,0,0,,Black Hole!Dialogue: 0,0:15:23.62,0:15:25.10,Attack,Blackbeard,0,0,0,,Kara DelikDialogue: 0,0:15:45.42,0:15:48.43,Main,Villagers,0,0,0,,Kasaba... yerin içine yutuluyor!Dialogue: 0,0:15:48.43,0:15:49.56,Main,Villagers,0,0,0,,Neden?Dialogue: 0,0:15:49.56,0:15:51.44,Main,Villagers,0,0,0,,Neler oluyor?!Dialogue: 0,0:15:57.32,0:16:02.69,Main,Blackbeard,0,0,0,,Karanlığın çekim gücü sonsuz gücüyle her nesneyi yoğunlaştırır.Dialogue: 0,0:16:02.69,0:16:03.98,Main,Blackbeard,0,0,0,,Onları ezer!Dialogue: 0,0:16:18.10,0:16:21.25,Main,Villagers,0,0,0,,Rüya mı görüyorum?Dialogue: 0,0:16:21.25,0:16:23.25,Main,Villagers,0,0,0,,Şehrimiz...Dialogue: 0,0:16:30.93,0:16:33.05,Main,Blackbeard,0,0,0,,Kayboldu!Dialogue: 0,0:16:33.05,0:16:34.60,Main,Blackbeard,0,0,0,,Şimdi sana göstereceğim...Dialogue: 0,0:16:35.34,0:16:38.40,Main,Blackbeard,0,0,0,,Neye dönüştüğümü!Dialogue: 0,0:16:38.40,0:16:39.40,Main,Blackbeard,0,0,0,,Liberation!Dialogue: 0,0:16:38.40,0:16:39.40,Attack,Blackbeard,0,0,0,,Özgürlük!!Dialogue: 0,0:16:53.76,0:16:54.76,Main,Villagers,0,0,0,,Şehir...Dialogue: 0,0:16:55.63,0:16:57.26,Main,Villagers,0,0,0,,Sadece kereste yığınına döndü.Dialogue: 0,0:17:00.40,0:17:02.24,Main,Blackbeard,0,0,0,,Anladın mı, Ace?!Dialogue: 0,0:17:02.24,0:17:05.04,Main,Blackbeard,0,0,0,,Kazandığım güç bu işte!Dialogue: 0,0:17:07.41,0:17:08.41,Main,Ace,0,0,0,,Hotaru...Dialogue: 0,0:17:07.41,0:17:08.41,Attack,Ace,0,0,0,,Ateş BöceğiDialogue: 0,0:17:08.88,0:17:09.95,Main,Ace,0,0,0,,Hidaruma!Dialogue: 0,0:17:08.88,0:17:09.95,Attack,Ace,0,0,0,,Alevli OyuncakDialogue: 0,0:17:12.90,0:17:14.81,Main,Blackbeard,0,0,0,,Sıcak!Dialogue: 0,0:17:18.70,0:17:21.70,Main,Ace,0,0,0,,Karanlığın gücünün büyüklüğünü oldukça iyi anlıyorum.Dialogue: 0,0:17:21.70,0:17:23.20,Main,Ace,0,0,0,,Ama bu oldukça garip...Dialogue: 0,0:17:23.20,0:17:27.35,Main,Ace,0,0,0,,Eğer bir logia isen, böyle bir saldırıdan kaçınabilirsin.Dialogue: 0,0:17:39.39,0:17:41.14,Main,Blackbeard,0,0,0,,Sana önceden söyledim...Dialogue: 0,0:17:41.14,0:17:43.41,Main,Blackbeard,0,0,0,,Karanlık her şeyi içine çeker.Dialogue: 0,0:17:43.41,0:17:46.09,Main,Blackbeard,0,0,0,,Kurşunlar, bıçaklar, darbeler, ateş ve hatta yıldırımlar.Dialogue: 0,0:17:46.88,0:17:50.55,Main,Blackbeard,0,0,0,,Diğerlerinin yaptığı gibi saldırılardan kaçamam.Dialogue: 0,0:17:50.55,0:17:54.92,Main,Blackbeard,0,0,0,,Vücudum normal bir insandan çok daha fazla acıyı emer.Dialogue: 0,0:17:56.90,0:18:02.97,Main,Blackbeard,0,0,0,,Ama bu riskin karşılığında emebileceğim bir şey daha var!Dialogue: 0,0:18:02.97,0:18:04.21,Main,Blackbeard,0,0,0,,Kurozu!Dialogue: 0,0:18:02.97,0:18:04.21,Attack,Blackbeard,0,0,0,,Karanlık GirdapDialogue: 0,0:18:08.72,0:18:12.64,Main,Blackbeard,0,0,0,,Karanlığın çekim gücü, bir şeytan meyvesi kullanıcısının "varlığını" kesinlikle emebilir!Dialogue: 0,0:18:17.24,0:18:18.58,Main,Ace,0,0,0,,Kütle çekimi?!Dialogue: 0,0:18:22.44,0:18:24.09,Main,Blackbeard,0,0,0,,Ve böylece, vücudum...!Dialogue: 0,0:18:28.63,0:18:30.10,Main,Blackbeard,0,0,0,,Nasıl?Dialogue: 0,0:18:30.10,0:18:33.42,Main,Blackbeard,0,0,0,,Fark edebildin mi, Ace?Dialogue: 0,0:18:35.11,0:18:36.11,Main,Ace,0,0,0,,Sakın...!Dialogue: 0,0:19:01.47,0:19:05.84,Main,Blackbeard,0,0,0,,Sana gerçekten birisi vuralı uzun zaman geçti, değil mi?Dialogue: 0,0:19:05.84,0:19:07.01,Main,Blackbeard,0,0,0,,Ace.Dialogue: 0,0:19:07.80,0:19:12.01,Main,Blackbeard,0,0,0,,Seni yakaladığım an anladın.Dialogue: 0,0:19:13.65,0:19:17.09,Main,Blackbeard,0,0,0,,Karanlığımın emebileceği diğer şey ise...Dialogue: 0,0:19:17.09,0:19:18.76,Main,Blackbeard,0,0,0,,Şeytan meyvesi güçleri!Dialogue: 0,0:19:20.16,0:19:25.94,Main,Blackbeard,0,0,0,,Başka bir deyişle, dokunuldukları an şeytan meyvesi güçlerini kullanamazlar!Dialogue: 0,0:19:27.04,0:19:30.17,Main,Blackbeard,0,0,0,,Logia, zoan, paramecia...Dialogue: 0,0:19:30.17,0:19:34.69,Main,Blackbeard,0,0,0,,Dünyadaki tüm kendine aşırı güvenen şeytan meyvesi kullanıcıları...Dialogue: 0,0:19:34.69,0:19:37.61,Main,Blackbeard,0,0,0,,Onların zayıflıklarını açığa çıkarma yeteneğini elde ettim!Dialogue: 0,0:19:39.18,0:19:40.70,Main,Ace,0,0,0,,O zaman yakalanmazsam sorun yok.Dialogue: 0,0:19:41.19,0:19:45.33,Main,Blackbeard,0,0,0,,Sana sadece karanlığın çekim gücünden kaçamayacağını kanıtladım!Dialogue: 0,0:19:45.58,0:19:46.58,Main,Blackbeard,0,0,0,,KurozuDialogue: 0,0:19:45.58,0:19:46.58,Attack,Blackbeard,0,0,0,,Karanlık GirdapDialogue: 0,0:19:51.01,0:19:53.13,Main,Ace,0,0,0,,Shinka ShiranuiDialogue: 0,0:19:51.01,0:19:53.13,Attack,Ace,0,0,0,,Kutsal Ateş: Denizdeki Gizemli IşıkDialogue: 0,0:19:54.02,0:19:55.02,Main,Blackbeard,0,0,0,,Ace...!Dialogue: 0,0:20:10.23,0:20:11.28,Main,Blackbeard,0,0,0,,Kahretsin!Dialogue: 0,0:20:11.28,0:20:14.48,Main,Blackbeard,0,0,0,,Alev mızrağı mı?Dialogue: 0,0:20:14.50,0:20:16.46,Main,Ace,0,0,0,,Az kalsın boynumu kırıyordu!Dialogue: 0,0:20:18.43,0:20:21.26,Main,Ace,0,0,0,,Oldukça baş belası bir yeteneği var.Dialogue: 0,0:20:22.15,0:20:23.18,Main,Ace,0,0,0,,Jujika!Dialogue: 0,0:20:22.15,0:20:23.18,Attack,Ace,0,0,0,,Çapraz AteşDialogue: 0,0:20:36.00,0:20:38.46,Main,Villagers,0,0,0,,Başka bir muz kayası daha yok oluyor...Dialogue: 0,0:20:40.05,0:20:42.01,Main,Villagers,0,0,0,,Neler oluyor?Dialogue: 0,0:20:42.01,0:20:44.05,Main,Villagers,0,0,0,,Bu bir insanın işi değil.Dialogue: 0,0:20:45.64,0:20:49.68,Main,Villagers,0,0,0,,Sadece şehir değil...Dialogue: 0,0:20:49.68,0:20:51.15,Main,Villagers,0,0,0,,Bütün ada...!Dialogue: 0,0:20:57.52,0:21:03.21,Main,BB Crew,0,0,0,,Ben her zaman şeytan meyvesi kullanıcılarının yeteneklerine fazlasıyla güvendiklerini düşünürdüm.Dialogue: 0,0:21:03.21,0:21:06.73,Main,BB Crew,0,0,0,,Ve eğer onları kaybetmiş olsalar, oldukça kırılgan hale geleceklerini düşünürdüm ama...Dialogue: 0,0:21:07.28,0:21:10.82,Main,BB Crew,0,0,0,,beklendiği gibi, Beyazsakalın'ın gemisindeki bir kumandanın...Dialogue: 0,0:21:10.82,0:21:13.25,Main,BB Crew,0,0,0,,Temel dövüş yetenekleri oldukça korkutucu.Dialogue: 0,0:21:13.25,0:21:15.75,Main,BB Crew,0,0,0,,Öyleyse, bugün bir kez daha...Dialogue: 0,0:21:15.75,0:21:18.67,Main,BB Crew,0,0,0,,Kader bizi ayıracak.Dialogue: 0,0:21:25.38,0:21:28.61,Main,Blackbeard,0,0,0,,Karanlığın karşısında her şey faydasız.Dialogue: 0,0:21:28.61,0:21:31.01,Main,Blackbeard,0,0,0,,Senin gücünde dahil.Dialogue: 0,0:21:31.83,0:21:35.22,Main,Blackbeard,0,0,0,,Ancak, o gücü boşa harcamak yazık olurdu.Dialogue: 0,0:21:36.12,0:21:39.16,Main,Blackbeard,0,0,0,,Ace! Tayfama katıl!Dialogue: 0,0:21:42.48,0:21:47.01,Main,Ace,0,0,0,,Eğer gücümü sana teslim edersem, o zaman bir adam olmamın hiçbir anlamı olmaz.Dialogue: 0,0:21:48.09,0:21:51.62,Main,Ace,0,0,0,,Kesinlikle pişmanlıkla yaşamayacağım.Dialogue: 0,0:21:51.62,0:21:53.38,Main,Ace,0,0,0,,Anladın mı, aptal?Dialogue: 0,0:21:54.96,0:21:57.39,Main,Blackbeard,0,0,0,,Bu dünyada böyle ne kadar daha yaşayabilirsin...Dialogue: 0,0:21:57.95,0:22:00.79,Main,Blackbeard,0,0,0,,Yazık oldu, Ace.Dialogue: 0,0:22:02.87,0:22:04.75,Main,Blackbeard,0,0,0,,Karanlıkla öl!Dialogue: 0,0:22:05.58,0:22:07.37,Main,Ace,0,0,0,,Dai Enkai!Dialogue: 0,0:22:05.58,0:22:07.37,Attack,Ace,0,0,0,,Büyük Alev EmriDialogue: 0,0:22:15.73,0:22:17.31,Main,Ace,0,0,0,,Entei!Dialogue: 0,0:22:15.73,0:22:17.31,Attack,Ace,0,0,0,,Alev İmparatoruDialogue: 0,0:22:25.78,0:22:27.80,Main,Blackbeard,0,0,0,,Güneş yada karanlık.Dialogue: 0,0:22:27.80,0:22:29.28,Main,Blackbeard,0,0,0,,Sadece bir tane kazanan olabilir!Dialogue: 0,0:22:30.34,0:22:32.85,Main,Ace,0,0,0,,Beyazsakal'ı...Dialogue: 0,0:22:32.85,0:22:34.29,Main,Ace,0,0,0,,Kral yapacağım.Dialogue: 0,0:22:52.11,0:22:55.31,Narrator,Narrator,0,0,0,,Grand Line'daki Banaro Adası'ndaki düello...Dialogue: 0,0:22:56.24,0:22:58.88,Narrator,Narrator,0,0,0,,İki korsan arasındaki savaş,Dialogue: 0,0:22:58.88,0:23:06.60,Narrator,Narrator,0,0,0,,henüz gelmemiş büyük bir olayın tetikleyicisi olarak hatırlanacak.