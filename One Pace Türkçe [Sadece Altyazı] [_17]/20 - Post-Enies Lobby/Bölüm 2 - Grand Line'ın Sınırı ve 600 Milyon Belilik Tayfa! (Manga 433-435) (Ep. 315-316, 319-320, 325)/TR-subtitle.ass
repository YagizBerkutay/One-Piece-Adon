Dialogue: 0,0:02:29.92,0:02:34.43,Main,Garp,0,0,0,,Sen benim torunumsun, Seni\Nbu adada yakalamayacağım.
Dialogue: 0,0:02:34.43,0:02:39.67,Main,Garp,0,0,0,,Denizciler için endişelenmeyin,\Nonlara bir bahane bulacağım.
Dialogue: 0,0:02:39.67,0:02:42.64,Main,Suit-guy,0,0,0,,Bahane bulmak yerine,\Nsadece onlar kaçtı diyelim.
Dialogue: 0,0:02:43.58,0:02:47.86,Main,Garp,0,0,0,,Neyse, ben daha çok bir refakatçi gibiyim.
Dialogue: 0,0:02:47.86,0:02:50.80,Main,Garp,0,0,0,,Bu ikisini al ve güzel bir uzun sohbet yap.
Dialogue: 0,0:02:50.80,0:02:51.98,Main,Garp,0,0,0,,Ben geri dönüyorum.
Dialogue: 0,0:02:51.98,0:02:53.02,Main,Luffy,0,0,0,,Tamam, görüşürüz.
Dialogue: 0,0:02:53.53,0:02:54.92,Main,Garp,0,0,0,,Biraz hızlı veda ettin sanki!
Dialogue: 0,0:02:56.40,0:02:58.36,Main,Garp,0,0,0,,Daha fazla dikkat et böyle şeylere aptal!
Dialogue: 0,0:02:58.36,0:03:00.54,Main,Garp,0,0,0,,Ben senin uzun zamandır görmediğin dedenim!
Dialogue: 0,0:03:00.54,0:03:01.89,Main,Luffy,0,0,0,,Ne yapmalıydım?
Dialogue: 0,0:03:01.89,0:03:03.95,Main,Luffy,0,0,0,,Tek yaptığın şey sadece bana vurmak!
Dialogue: 0,0:03:03.95,0:03:08.51,Main,Garp,0,0,0,,Yine de, hala torunum tarafından\Nsevilmek istiyorum, aptal!
Dialogue: 0,0:03:09.68,0:03:13.32,Main,Nami,0,0,0,,Bu bencil tavır\Nkesinlikle ailevi bir özellik.
Dialogue: 0,0:03:14.71,0:03:22.71,Title,,0,0,0,,{\fad(2000,2000)}Grand Line'ın Sınırı\Nve 600.000.000 Belilik Tayfa!
Dialogue: 0,0:03:24.17,0:03:26.77,Main,Sanji,0,0,0,,Vay canına, onun oldukça çılgın bir dedesi var.
Dialogue: 0,0:03:27.29,0:03:30.53,Main,Robin,0,0,0,,Dragon kısmı beni harbi çok şaşırttı.
Dialogue: 0,0:03:30.53,0:03:33.03,Main,Robin,0,0,0,,Sanırım ailede sıradan bir kişi bile yok.
Dialogue: 0,0:03:33.92,0:03:34.96,Main,Chopper,0,0,0,,Luffy nerede?
Dialogue: 0,0:03:35.29,0:03:37.07,Main,Zoro,0,0,0,,Koby ile konuşmak için dışarı çıktı.
Dialogue: 0,0:03:37.88,0:03:39.50,Main,Sanji,0,0,0,,Senin burada durman sorun değil mi?
Dialogue: 0,0:03:39.50,0:03:40.54,Main,Sanji,0,0,0,,Siz arkadaşsınız değil mi?
Dialogue: 0,0:03:40.75,0:03:42.66,Main,Zoro,0,0,0,,Nostaljik hissettiriyor ama..
Dialogue: 0,0:03:43.33,0:03:46.12,Main,Zoro,0,0,0,,Koby'yi kurtaran Luffy'di.
Dialogue: 0,0:03:47.18,0:03:51.13,Main,Chopper,0,0,0,,Denizcilerin ne söylediğini duyduğundan beri, \NNami de gitmiş durumda...
Dialogue: 0,0:03:51.93,0:03:53.08,Main,Chopper,0,0,0,,Belki utanmıştır.
Dialogue: 0,0:03:53.61,0:03:56.32,Main,Robin,0,0,0,,Kokoro-san ile birlikte havuza gittiler.
Dialogue: 0,0:03:56.32,0:03:57.57,Main,Chopper,0,0,0,,Havuz?
Dialogue: 0,0:03:57.57,0:04:00.46,Main,Robin,0,0,0,,The Galley-La Şirketi'nin\Nçalışanlarının havuzu.
Dialogue: 0,0:04:01.08,0:04:02.89,Main,Sanji,0,0,0,,Nami-san bikineli mi?
Dialogue: 0,0:04:02.89,0:04:05.02,Main,Sanji,0,0,0,,Gidip içecek bir şey götüreyim!
Dialogue: 0,0:04:05.56,0:04:09.01,Main,Luffy,0,0,0,,Öyleyse, siz de Grand Line'a girmek\Niçin o dağın üzerinden geçtiniz, değil mi?
Dialogue: 0,0:04:09.01,0:04:10.26,Main,Coby,0,0,0,,Ah, hayır.
Dialogue: 0,0:04:10.26,0:04:12.14,Main,Coby,0,0,0,,Reverse Mountain'dan geçmedik..
Dialogue: 0,0:04:13.02,0:04:16.45,Main,Coby,0,0,0,,Donanmanın, Calm Belt üzerinden\Nhareket edebilen gemileri var -
Dialogue: 0,0:04:16.45,0:04:18.97,Main,Luffy,0,0,0,,Ne? Bu hiç adil değil!
Dialogue: 0,0:04:18.97,0:04:21.74,Main,Coby,0,0,0,,Tabii ki, %100 mükemmel değiller, ancak-
Dialogue: 0,0:04:21.74,0:04:23.51,Main,Luffy,0,0,0,,Ama nasıl?
Dialogue: 0,0:04:23.51,0:04:28.24,Main,Luffy,0,0,0,,Orada savaş gemilerinden\Ndaha büyük deniz canavarları var.
Dialogue: 0,0:04:31.24,0:04:33.46,Main,Luffy,0,0,0,,Gerçekten bizi çok zora soktular!
Dialogue: 0,0:04:34.18,0:04:39.72,Main,Coby,0,0,0,,Aslında, gemilerin alt kısımları deniz taşı\Nolarak bilinen bir kaya ile kaplanmış durumda.
Dialogue: 0,0:04:39.72,0:04:40.97,Main,Luffy,0,0,0,,O da ne öyle?
Dialogue: 0,0:04:41.79,0:04:42.79,Main,Coby,0,0,0,,Aslında demek istediğim,
Dialogue: 0,0:04:43.32,0:04:46.81,Main,Coby,0,0,0,,deniz taşı, denizle\Naynı tür enerjiyi yayıyor.
Dialogue: 0,0:04:46.81,0:04:49.21,Main,Coby,0,0,0,,Bu yüzden okyanustaki tüm\Nbalıklar için gemi, görünüşe göre-
Dialogue: 0,0:04:49.43,0:04:51.65,Main,Nami,0,0,0,,Denizin enerjisi?
Dialogue: 0,0:04:51.65,0:04:52.92,Main,Nami,0,0,0,,Anladım!
Dialogue: 0,0:04:52.92,0:04:55.75,Main,Nami,0,0,0,,Demek ki, yaratıkların yaşam\Nalanlarından geçseler bile
Dialogue: 0,0:04:55.75,0:04:59.16,Main,Nami,0,0,0,,Deniz Kral'ları bile geminin\Nvarlığını fark etmeyecek!
Dialogue: 0,0:05:01.77,0:05:05.77,Main,Nami,0,0,0,,Böylece, Reverse Mountain'daki\Ngirişten gitmeseler bile,
Dialogue: 0,0:05:05.77,0:05:08.91,Main,Nami,0,0,0,,Grand Line'a özgürce girebiliyorlar.
Dialogue: 0,0:05:12.06,0:05:14.67,Main,Nami,0,0,0,,Donanmanın teknolojisi çok iyi.
Dialogue: 0,0:05:14.67,0:05:16.37,Main,Nami,0,0,0,,Güzel bilgi elde ettim.
Dialogue: 0,0:05:16.37,0:05:17.66,Main,Chimney,0,0,0,,Abla, abla!
Dialogue: 0,0:05:17.66,0:05:19.14,Main,Chimney,0,0,0,,Yüzmeyecek misin?
Dialogue: 0,0:05:20.61,0:05:22.49,Main,Chimney,0,0,0,,Hey!
Dialogue: 0,0:05:22.49,0:05:24.46,Main,Nami,0,0,0,,2 dakika dur be Chimney!
Dialogue: 0,0:05:24.46,0:05:26.18,Main,Nami,0,0,0,,Bu nadir bir şans!
Dialogue: 0,0:05:27.59,0:05:29.94,Main,Chimney,0,0,0,,Korsan abla çok bencil!
Dialogue: 0,0:05:31.47,0:05:35.60,Main,Nami,0,0,0,,Şu anda casusluk yapıyorum!
Dialogue: 0,0:05:35.60,0:05:37.74,Main,Kokoro,0,0,0,,Bu senin bağırarak\Nsöylemen gereken bir şey mi?
Dialogue: 0,0:05:38.60,0:05:42.54,Main,Coby,0,0,0,,Bu çığır açan araştırmadan sorumlu kişi\Nmuhtemelen denizcilerin bilim insanı...
Dialogue: 0,0:05:42.54,0:05:44.27,Main,Coby,0,0,0,,Dr. Vegapunk.
Dialogue: 0,0:05:44.27,0:05:45.89,Main,Coby,0,0,0,,O inanılmaz biri.
Dialogue: 0,0:05:45.89,0:05:48.57,Main,Helmeppo,0,0,0,,Katılıyorum, o harbi inanılmaz bir insan.
Dialogue: 0,0:05:48.57,0:05:51.55,Main,Helmeppo,0,0,0,,Hasır Şapka, sizin yediğiniz\Nşeytan meyveleri varya,
Dialogue: 0,0:05:51.55,0:05:55.51,Main,Helmeppo,0,0,0,,O, içerdiği gücü tanımlayan kişidir.
Dialogue: 0,0:05:55.51,0:05:59.26,Main,Helmeppo,0,0,0,,Ve o, nesnelerin şeytan meyvelerini tüketmelerine\Nizin veren yeni teknolojiyi icat etti.
Dialogue: 0,0:05:59.26,0:06:01.14,Main,Helmeppo,0,0,0,,Ve bunlar sadece geçtiğimiz\Nbirkaç sene içinde mümkün oldu.
Dialogue: 0,0:06:01.14,0:06:02.90,Main,Nami,0,0,0,,Dr. Vegapunk...
Dialogue: 0,0:06:02.90,0:06:05.85,Main,Luffy,0,0,0,,Hmm, görüşüne göre muhteşem biri.
Dialogue: 0,0:06:06.19,0:06:09.13,Main,Coby,0,0,0,,Evet, dünya inanılmaz insanlarla kaynıyor.
Dialogue: 0,0:06:10.58,0:06:17.85,Main,Coby,0,0,0,,Eğer o zamanlar Luffy-san ile tanışmasaydım, acaba ne\Nkadar sınırlı bir dünyada yaşardım diye merak ediyorum.
Dialogue: 0,0:06:18.57,0:06:20.36,Main,Coby,0,0,0,,Luffy-san gözümü açmamı sağladı.
Dialogue: 0,0:06:20.36,0:06:22.70,Main,Coby,0,0,0,,O gün, eğer o fıçıdan\Npatlayarak çıkmamış olsaydın...
Dialogue: 0,0:06:26.55,0:06:31.62,Main,Coby,0,0,0,,Ben hala Alvida'nın\Ngemisinde sıkışıp kalmıştım.
Dialogue: 0,0:06:33.28,0:06:34.15,Main,Luffy,0,0,0,,Harbi öyle!
Dialogue: 0,0:06:34.15,0:06:36.09,Main,Luffy,0,0,0,,Sen Alvida'nın gemisindeydin değil mi?
Dialogue: 0,0:06:36.09,0:06:38.25,Main,Luffy,0,0,0,,Çok komikti değil mi?
Dialogue: 0,0:06:38.25,0:06:40.50,Main,Luffy,0,0,0,,İlk başta o gemiye nasıl bindiğinin nedeni...
Dialogue: 0,0:06:41.50,0:06:43.01,Main,Helmeppo,0,0,0,,Ney?
Dialogue: 0,0:06:43.01,0:06:44.59,Main,Helmeppo,0,0,0,,Ben bu hikayeyi duymadım.
Dialogue: 0,0:07:02.82,0:07:04.65,Main,Coby,0,0,0,,Sana çok minnettarız.
Dialogue: 0,0:07:04.98,0:07:09.01,Main,Coby,0,0,0,,Bu yüzden, Koramiralliğe terfi etmiş Garp'a\Nborcumuzu ödemeye çalışıyoruz.
Dialogue: 0,0:07:09.01,0:07:10.26,Main,Helmeppo,0,0,0,,Hayır.
Dialogue: 0,0:07:10.26,0:07:13.09,Main,Helmeppo,0,0,0,,O'na bizim gözümüzden nasıl olduğunu \Ngöstermek istiyorum.
Dialogue: 0,0:07:13.09,0:07:15.00,Main,Luffy,0,0,0,,Oh, bu kulağa hoş geliyor kötü aptal!
Dialogue: 0,0:07:15.00,0:07:15.78,Main,Helmeppo,0,0,0,,Ne dedin?
Dialogue: 0,0:07:15.78,0:07:18.94,Main,Luffy,0,0,0,,Ne? Geri mi dönüyorsunuz?
Dialogue: 0,0:07:18.94,0:07:21.25,Main,Luffy,0,0,0,,Yemeğe kalın! Beraber yemek yiyelim!
Dialogue: 0,0:07:21.25,0:07:24.10,Main,Coby,0,0,0,,Biz aslında düşmanız...
Dialogue: 0,0:07:24.10,0:07:26.18,Main,Coby,0,0,0,,Birbirimize dostça davranamayız.
Dialogue: 0,0:07:26.47,0:07:27.71,Main,Coby,0,0,0,,Luffy-san!
Dialogue: 0,0:07:27.71,0:07:31.68,Main,Coby,0,0,0,,Grand Line'ın ikinci yarısı\Nhakkında ne biliyorsun?
Dialogue: 0,0:07:33.30,0:07:37.15,Main,Coby,0,0,0,,Red Line'ın ötesinde,\Ndeniz daha da enginleşir.
Dialogue: 0,0:07:37.15,0:07:40.60,Main,Coby,0,0,0,,Son bir deniz, insanlar buraya\Nbir isim daha vermişlerdir...
Dialogue: 0,0:07:41.11,0:07:42.37,Main,Coby,0,0,0,,Yeni Dünya.
Dialogue: 0,0:07:48.58,0:07:50.54,Main,Luffy,0,0,0,,Yeni Dünya.
Dialogue: 0,0:07:54.46,0:07:57.95,Main,Coby,0,0,0,,Yeni bir çağın başlangıcını\Narzulayanların toplandığı deniz!
Dialogue: 0,0:07:58.75,0:08:01.28,Main,Coby,0,0,0,,Bu denizi kontrol eden kişi ise...
Dialogue: 0,0:08:01.28,0:08:02.83,Main,Coby,0,0,0,,Korsanlar Kralı!
Dialogue: 0,0:08:12.95,0:08:14.25,Main,Coby,0,0,0,,Luffy-san!
Dialogue: 0,0:08:14.25,0:08:17.44,Main,Coby,0,0,0,,Tekrar orada buluşalım!
Dialogue: 0,0:08:18.02,0:08:20.49,Main,Coby,0,0,0,,Bir dahaki sefer seni yakalacağım!
Dialogue: 0,0:08:20.49,0:08:22.61,Main,Coby,0,0,0,,Daha güçlü olacağım!
Dialogue: 0,0:08:22.99,0:08:26.36,Main,Coby,0,0,0,,Bir gün, donanma da...
Dialogue: 0,0:08:27.61,0:08:28.61,Main,Coby,0,0,0,,Olacağım...
Dialogue: 0,0:08:29.57,0:08:31.57,Main,Coby,0,0,0,,Donanma Amirali olacağım!
Dialogue: 0,0:08:36.45,0:08:37.45,Main,Coby,0,0,0,,Hayır...
Dialogue: 0,0:08:37.92,0:08:39.34,Main,Coby,0,0,0,,Pardon.
Dialogue: 0,0:08:39.34,0:08:41.16,Main,Coby,0,0,0,,Pardon, fazla gaza geldim.
Dialogue: 0,0:08:41.16,0:08:44.79,Main,Coby,0,0,0,,Mahçupum, sadece hep böyle bir şey\Nolmak istediğimi söylemekle kalıyorum.
Dialogue: 0,0:08:44.79,0:08:47.80,Main,Coby,0,0,0,,Seni gördüğümüzden beri, biraz\Nilham almış gibi hissediyorum ve...
Dialogue: 0,0:08:47.80,0:08:48.80,Main,Luffy,0,0,0,,Koby!
Dialogue: 0,0:08:49.64,0:08:51.57,Main,Luffy,0,0,0,,Eğer benimle savaşacaksan,\N öyle olman gerekmez mi?
Dialogue: 0,0:08:51.57,0:08:53.63,Main,Luffy,0,0,0,,Öyleyse tabii ki daha güçlü olacaksın!
Dialogue: 0,0:08:53.63,0:08:54.63,Main,Luffy,0,0,0,,Doğal değil mi?
Dialogue: 0,0:08:57.46,0:08:59.85,Main,Coby,0,0,0,,Ama bir Amiral olmak?
Dialogue: 0,0:09:00.24,0:09:03.38,Main,Luffy,0,0,0,,Sıradaki karşılaşmamızda,\Nbiz de çok daha güçlü olacağız.
Dialogue: 0,0:09:03.92,0:09:04.98,Main,Luffy,0,0,0,,Daha muhteşem biri!
Dialogue: 0,0:09:10.63,0:09:11.91,Thoughts,Coby,0,0,0,,Neden?
Dialogue: 0,0:09:19.99,0:09:26.67,Thoughts,Coby,0,0,0,,Ağzımdan çıkan, sadece savruk bir hayal ama...
Dialogue: 0,0:09:29.18,0:09:32.88,Thoughts,Coby,0,0,0,,Bana neden tüm kalbiyle inanabiliyor?
Dialogue: 0,0:09:33.54,0:09:34.90,Main,Zoro,0,0,0,,Ne oldu?
Dialogue: 0,0:09:34.90,0:09:37.76,Main,Zoro,0,0,0,,Hala sulu gözlü müsün, Koby?
Dialogue: 0,0:09:42.80,0:09:44.91,Main,Coby,0,0,0,,Bugün ikinizle de karşılaşabildim...
Dialogue: 0,0:09:44.91,0:09:46.52,Main,Coby,0,0,0,,Çok şükür!
Dialogue: 0,0:09:50.80,0:09:54.82,Thoughts,Coby,0,0,0,,Bu ikisinin peşinden\Ngitmek gerçekten zor olacak!
Dialogue: 0,0:09:58.37,0:10:01.77,Main,Coby,0,0,0,,Biz de gittikçe daha güçlü olacağız!
Dialogue: 0,0:10:01.77,0:10:05.04,Main,Coby,0,0,0,,Yeni Dünya'da tekrar buluşalım!
Dialogue: 0,0:10:05.04,0:10:06.10,Main,Coby,0,0,0,,Gidelim!
Dialogue: 0,0:10:06.10,0:10:07.13,Main,Helmeppo,0,0,0,,Oh, hey!
Dialogue: 0,0:10:08.23,0:10:10.13,Main,Helmeppo,0,0,0,,Kendinizi hazırlasanız iyi edersiniz!
Dialogue: 0,0:10:10.13,0:10:11.98,Main,Helmeppo,0,0,0,,Sizi aşma cesaretine sahibiz!
Dialogue: 0,0:10:13.39,0:10:14.76,Main,Helmeppo,0,0,0,,Hey, bekle!
Dialogue: 0,0:10:15.04,0:10:16.31,Main,Coby,0,0,0,,Tamamdır!
Dialogue: 0,0:10:16.31,0:10:17.92,Main,Coby,0,0,0,,Bizi artık kimse durduramaz!
Dialogue: 0,0:10:17.92,0:10:18.52,Main,Helmeppo,0,0,0,,Ne diyon len?
Dialogue: 0,0:10:18.52,0:10:19.52,Main,Helmeppo,0,0,0,,Aklını mı kaçırdın!
Dialogue: 0,0:10:21.15,0:10:26.48,Main,Zoro,0,0,0,,Luffy, kendine yine inanılmaz\Nbir rakip yarattın, değil mi?
Dialogue: 0,0:10:27.35,0:10:31.11,Main,Luffy,0,0,0,,Koby yetenekli birisi.\NBunu biliyordum sadece.
Dialogue: 0,0:10:39.72,0:10:41.07,Main,Sanji,0,0,0,,Nami-san!
Dialogue: 0,0:10:41.07,0:10:43.08,Main,Sanji,0,0,0,,Su-su eti hazır!
Dialogue: 0,0:10:43.36,0:10:44.36,Main,Nami,0,0,0,,Tamamdır!
Dialogue: 0,0:10:47.72,0:10:48.95,Main,Chimney,0,0,0,,Nine, sen inanılmazsın!
Dialogue: 0,0:10:51.56,0:10:52.84,Main,Kokoro,0,0,0,,Güzel kokuyor!
Dialogue: 0,0:10:53.25,0:10:54.48,Main,Sanji,0,0,0,,Değil mi?
Dialogue: 0,0:10:54.48,0:10:55.73,Main,Sanji,0,0,0,,Şimdi, 'aaaa' de.
Dialogue: 0,0:11:00.88,0:11:03.33,Main,Luffy,0,0,0,,Lezzetli!
Dialogue: 0,0:11:03.33,0:11:05.44,Main,Usopp,0,0,0,,Lezzetli!
Dialogue: 0,0:11:05.44,0:11:07.55,Main,Usopp,0,0,0,,Su-Su et barbeküsü!
Dialogue: 0,0:11:08.23,0:11:09.00,Main,Zoro,0,0,0,,Sogeking!
Dialogue: 0,0:11:09.00,0:11:10.00,Main,Zoro,0,0,0,,Ne zaman geldin-
Dialogue: 0,0:11:10.36,0:11:13.49,Main,Sanji,0,0,0,,Tamam iş, istediğiniz kadar yiyin!
Dialogue: 0,0:11:13.49,0:11:14.70,Main,Zoro,0,0,0,,Niye ağlıyon lan?
Dialogue: 0,0:11:15.15,0:11:15.95,Main,Sanji,0,0,0,,Kapa çeneni!
Dialogue: 0,0:11:15.95,0:11:18.45,Main,Sanji,0,0,0,,Gözüme duman kaçtı sadece.
Dialogue: 0,0:11:18.45,0:11:20.02,Main,Sanji,0,0,0,,Nasıl olmuş, Robin-chwan~?
Dialogue: 0,0:11:20.02,0:11:21.81,Main,Sanji,0,0,0,,Stoklanmış yiyeceklerden farklı, değil mi?
Dialogue: 0,0:11:21.81,0:11:23.46,Main,Robin,0,0,0,,Evet, lezzetli.
Dialogue: 0,0:11:23.49,0:11:24.70,Main,Zanbai,0,0,0,,Oh, onlar harbi!
Dialogue: 0,0:11:25.03,0:11:26.12,Main,Zanbai,0,0,0,,Hasır Şapka-san!
Dialogue: 0,0:11:26.12,0:11:27.38,Main,Zanbai,0,0,0,,Sonunda uyanmışsın?
Dialogue: 0,0:11:27.67,0:11:29.23,Main,Luffy,0,0,0,,Oh, Franky ailesi!
Dialogue: 0,0:11:29.23,0:11:30.34,Main,Luffy,0,0,0,,Gelin de yiyin!
Dialogue: 0,0:11:31.59,0:11:33.01,Main,Zanbai,0,0,0,,Barbekü lan!
Dialogue: 0,0:11:33.01,0:11:34.84,Main,Familyi,0,0,0,,Benim favorim!
Dialogue: 0,0:11:34.84,0:11:38.03,Main,Luffy,0,0,0,,Hey, çok fazla kişiyiz,\Ndaha fazla et almamız lazım!
Dialogue: 0,0:11:41.53,0:11:43.31,Main,Chopper,0,0,0,,Sodom ile Gomorrah!
Dialogue: 0,0:11:47.21,0:11:48.95,Main,Kashi,0,0,0,,Ben de acıktım.
Dialogue: 0,0:11:48.95,0:11:50.02,Main,Oimo,0,0,0,,Aynen ben de.
Dialogue: 0,0:11:50.02,0:11:52.73,Main,Oimo,0,0,0,,Devler! Heey!
Dialogue: 0,0:11:53.93,0:11:54.76,Main,Tileston,0,0,0,,Hasır Şapka!
Dialogue: 0,0:11:54.76,0:11:56.20,Main,Tileston,0,0,0,,Uyanmışsın?
Dialogue: 0,0:11:56.45,0:11:58.40,Main,Luffy,0,0,0,,Galley-La Şirketi!
Dialogue: 0,0:11:58.40,0:12:00.19,Main,Paulie,0,0,0,,Siz havuzda ne yapıyorsunuz...
Dialogue: 0,0:12:01.35,0:12:03.76,Main,Paulie,0,0,0,,Seni utanmaz kız!
Dialogue: 0,0:12:03.76,0:12:05.49,Main,Nami,0,0,0,,Burası havuz ya, bildiğin gibi abi.
Dialogue: 0,0:12:06.75,0:12:09.20,Main,Iceburg,0,0,0,,Oh, güzel bir şey kokuyor.
Dialogue: 0,0:12:09.20,0:12:10.20,Main,Paulie,0,0,0,,Iceburg-san!
Dialogue: 0,0:12:10.40,0:12:13.67,Main,Paulie,0,0,0,,Kesinlikle buna izin veremem,\Nbu kadın bir tür sapkın!
Dialogue: 0,0:12:14.03,0:12:15.13,Main,Nami,0,0,0,,Ne diyon lan ayı!
Dialogue: 0,0:12:15.73,0:12:18.00,Main,Kiwi/Mozu,0,0,0,,Gemi yaparken ara veremeyiz.
Dialogue: 0,0:12:18.00,0:12:20.81,Main,Franky,0,0,0,,Doğru!\NÖyleyse şimdi o pozu yakalayacağız!
Dialogue: 0,0:12:21.26,0:12:23.31,Main,Franky,0,0,0,,Benim sorumluluğumda var değil mi?
Dialogue: 0,0:12:23.31,0:12:24.60,Main,Kiwi/Mozu,0,0,0,,Değil mi? Değil mi?
Dialogue: 0,0:12:26.89,0:12:29.06,Main,Zanbai,0,0,0,,Seni bekliyorduk abi!
Dialogue: 0,0:12:31.16,0:12:33.24,Main,Usopp,0,0,0,,Haydi, başlayalım!
Dialogue: 0,0:12:34.01,0:12:35.79,Main,Usopp,0,0,0,,Bir numara: Sogeking!
Dialogue: 0,0:12:35.79,0:12:38.24,Main,Usopp,0,0,0,,Şarkı söyleyeceğim!
Dialogue: 0,0:12:39.66,0:12:42.16,Main,Luffy,0,0,0,,Hadi bakalım! Parti yapalım!
Dialogue: 0,0:12:42.96,0:12:46.56,Note,Usopp,0,0,0,,{\an8}Keskin Nişancı adasında,
Dialogue: 0,0:12:46.56,0:12:50.25,Note,Usopp,0,0,0,,{\an8}Doğdum.
Dialogue: 0,0:12:58.88,0:13:01.22,Main,Kuzan,0,0,0,,Bu şekilde beni dinle, Nico Robin.
Dialogue: 0,0:13:01.57,0:13:02.80,Main,Robin,0,0,0,,Yoksa bu ses...
Dialogue: 0,0:13:03.49,0:13:04.72,Main,Robin,0,0,0,,Aokiji?
Dialogue: 0,0:13:07.01,0:13:10.26,Main,Kuzan,0,0,0,,Neden her zamanki gibi kaçmadın?
Dialogue: 0,0:13:10.26,0:13:13.81,Main,Kuzan,0,0,0,,Tek başına olsaydın CP9'dan kaçabilirdin.
Dialogue: 0,0:13:14.36,0:13:17.36,Main,Robin,0,0,0,,Çünkü geçen seferkilerden farklıydı.
Dialogue: 0,0:13:17.36,0:13:18.81,Main,Robin,0,0,0,,Onların ölmesine izin vermek...
Dialogue: 0,0:13:20.06,0:13:21.36,Main,Robin,0,0,0,,Bunu yapamadım.
Dialogue: 0,0:13:23.80,0:13:29.70,Main,Kuzan,0,0,0,,20 yıl önce Ohara için\Nsavaşan dev, Jaguar D. Saul...
Dialogue: 0,0:13:30.00,0:13:31.89,Main,Kuzan,0,0,0,,{\fad(0,400)}O benim yakın arkadaşımdı.
Dialogue: 0,0:13:32.27,0:13:39.94,Main,Kuzan,0,0,0,,O gün onun isteklerine saygı\Nduydum ve hayatını bağışladım.
Dialogue: 0,0:13:41.90,0:13:45.90,Main,Kuzan,0,0,0,,Bu nedenle, hayatını nasıl geliştiğini\Ngözlemleme sorumluluğu hissediyorum.
Dialogue: 0,0:13:45.90,0:13:48.65,Main,Ao,0,0,0,,Ancak yirmi yıl boyunca\Nkendi yerin olmadan,
Dialogue: 0,0:13:48.65,0:13:51.69,Main,Ao,0,0,0,,tehlikeli bir bombanın serbestçe\Ndolaşmaya devam etmesini çok riskli buldum.
Dialogue: 0,0:13:52.11,0:13:56.69,Main,Ao,0,0,0,,Gerçekten, sonunda\Nölmen gerektiğini hissettim.
Dialogue: 0,0:13:57.54,0:14:01.94,Main,Ao,0,0,0,,Bu sefer, Ohara'da olanları\Nsonunda bitirmek istedim.
Dialogue: 0,0:14:02.65,0:14:07.57,Main,Ao,0,0,0,,Tabii ki, CP9'un yenileceğini\Nöngörmek mümkün değildi.
Dialogue: 0,0:14:07.97,0:14:11.17,Main,Ao,0,0,0,,Sonunda ait olduğun yeri buldun mu?
Dialogue: 0,0:14:12.03,0:14:13.03,Main,Robin,0,0,0,,Evet.
Dialogue: 0,0:14:13.30,0:14:18.54,Main,Ao,0,0,0,,Saul'un sana söyledikleri,\Nyanlış veya doğru olsun...
Dialogue: 0,0:14:19.01,0:14:22.98,Main,Ao,0,0,0,,Buradan itibaren, \Nbu cevabı bana gösterecek misin?
Dialogue: 0,0:14:22.98,0:14:24.34,Main,Robin,0,0,0,,Benim niyetim de bu.
Dialogue: 0,0:14:25.26,0:14:28.73,Main,Ao,0,0,0,,Durum böyle ise, hayata sıkı tutun.
Dialogue: 0,0:14:28.73,0:14:31.86,Main,Ao,0,0,0,,Ohara henüz unutulmadı.
Dialogue: 0,0:14:37.49,0:14:38.81,Main,Robin,0,0,0,,Aokiji!
Dialogue: 0,0:14:39.10,0:14:40.64,Main,Luffy,0,0,0,,Hey, Robin!
Dialogue: 0,0:14:40.64,0:14:41.97,Main,Luffy,0,0,0,,Buraya bak!
Dialogue: 0,0:14:41.97,0:14:43.60,Main,Chopper,0,0,0,,Robin! Bu tarafa!
Dialogue: 0,0:14:43.60,0:14:45.06,Main,Usopp,0,0,0,,Robin!
Dialogue: 0,0:14:47.01,0:14:49.35,Main,Luffy,0,0,0,,Ne kadar eti ağzına alabilirsin?
Dialogue: 0,0:14:51.20,0:14:53.15,Main,Chopper,0,0,0,,Tabii ki bu konuda en iyisi Luffy!
Dialogue: 0,0:14:54.51,0:14:57.10,Main,Nami,0,0,0,,Gerçekten,\Nbiraz nezaket göstermeye çalışın.
Dialogue: 0,0:14:57.10,0:15:00.19,Main,Luffy,0,0,0,,Sadece birkaç saniye\Nönce kendini doyuruyordun.
Dialogue: 0,0:15:00.19,0:15:01.12,Main,Luffy,0,0,0,,Denemek mi istiyorsun?
Dialogue: 0,0:15:01.12,0:15:02.12,Main,Nami,0,0,0,,Hayır tabii ki!
Dialogue: 0,0:15:04.74,0:15:07.00,Main,Luffy,0,0,0,,Hey, Robin!
Dialogue: 0,0:15:10.97,0:15:13.05,Main,Guy,0,0,0,,Hey, bu tarafa.
Dialogue: 0,0:15:15.27,0:15:17.42,Main,Robin,0,0,0,,Ben de mi denesem acaba?
Dialogue: 0,0:15:17.76,0:15:19.93,Main,Luffy,0,0,0,,Evet, dene bakalım Robin!
Dialogue: 0,0:15:20.46,0:15:23.69,Main,Sanji,0,0,0,,Lüften dur, Robin-chwan!
Dialogue: 0,0:15:24.27,0:15:25.94,Main,Someone,0,0,0,,Henüz hiçbir şey yapmadı...
Dialogue: 0,0:15:42.16,0:15:43.22,Main,Soldier,0,0,0,,Gorosei!
Dialogue: 0,0:15:42.16,0:15:43.22,Note,Soldier,0,0,0,,Beş Büyükler
Dialogue: 0,0:15:43.22,0:15:45.32,Main,Soldier,0,0,0,,Gorosei, çok kötü bir şey oldu!
Dialogue: 0,0:15:45.32,0:15:46.80,Main,Five Elders,0,0,0,,Ne oldu?
Dialogue: 0,0:15:48.68,0:15:52.30,Main,Soldier,0,0,0,,Yeni Dünya'da, birkaç gün önce\Ngönderdiğimiz filo mağlup oldu.
Dialogue: 0,0:15:52.79,0:15:57.88,Main,Soldier,0,0,0,,Yonkou "Kızıl Saçlı" Shanks ve\NYonkou "Beyazsakal" Edward Newgate...
Dialogue: 0,0:15:52.79,0:15:57.88,Note,Soldier,0,0,0,,Yonkou - Dört İmparator
Dialogue: 0,0:15:57.88,0:15:59.72,Main,Soldier,0,0,0,,Sonunda birbileriyle\Ndirekt iletişim kurdular!
Dialogue: 0,0:16:00.40,0:16:01.85,Main,Gorosei,0,0,0,,Ne?
Dialogue: 0,0:16:02.35,0:16:03.26,Main,Pirate,0,0,0,,Babalık!
Dialogue: 0,0:16:03.26,0:16:04.35,Main,Pirate,0,0,0,,Babalık!
Dialogue: 0,0:16:04.35,0:16:06.85,Main,Pirate,0,0,0,,Kızıl Saç senle görüşmek istiyor.
Dialogue: 0,0:16:06.85,0:16:09.82,Main,Whitebeard,0,0,0,,Tabii ki, bırakın gelsin.
Dialogue: 0,0:16:13.56,0:16:17.78,Main,Whitebeard,0,0,0,,Ama bu serseri yanında\Niyi bir içki getirmiş olmalı.
Dialogue: 0,0:16:18.84,0:16:20.91,Main,Marine,0,0,0,,Bütün filonun yenildiği doğru mu?
Dialogue: 0,0:16:22.98,0:16:24.96,Main,Marine,0,0,0,,Evet, öyle görünüyor.
Dialogue: 0,0:16:25.63,0:16:27.82,Main,Marine,0,0,0,,Kızıl Saç ile Beyazsakal görüşüyorlar mı?
Dialogue: 0,0:16:29.51,0:16:31.58,Main,Captain,0,0,0,,Dikkat!
Dialogue: 0,0:16:32.28,0:16:33.26,Main,Captain,0,0,0,,Dinleyin!
Dialogue: 0,0:16:33.26,0:16:35.29,Main,Captain,0,0,0,,Burdan sonra ne olucak bilmiyorum.
Dialogue: 0,0:16:35.29,0:16:37.60,Main,Captain,0,0,0,,Sıkı bir şekilde gardınızı\Nkoruyun ve emirleri bekleyin!
Dialogue: 0,0:16:37.60,0:16:38.60,Main,Captain,0,0,0,,Evet efendim!
Dialogue: 0,0:16:38.88,0:16:40.48,Main,Pirate,0,0,0,,Güzergahı durdurun!
Dialogue: 0,0:16:40.48,0:16:42.31,Main,Pirate,0,0,0,,Yelkenleri açın!
Dialogue: 0,0:16:59.70,0:17:00.41,Main,Pirate,0,0,0,,Kaptan!
Dialogue: 0,0:17:00.69,0:17:01.91,Main,Pirate,0,0,0,,Kızıl Saç'ı görüyoruz.
Dialogue: 0,0:17:03.69,0:17:05.53,Main,Jozu,0,0,0,,Geliyor... Kızıl Saç.
Dialogue: 0,0:17:06.66,0:17:08.96,Main,Marco,0,0,0,,Zayıf olanlar geride dursa iyi olur.
Dialogue: 0,0:17:08.96,0:17:10.82,Main,Marco,0,0,0,,Bunla başa çıkamazsınız.
Dialogue: 0,0:17:12.36,0:17:14.42,Main,Pirate,0,0,0,,Ne demek istiyorsun?
Dialogue: 0,0:17:14.90,0:17:17.48,Main,Marco,0,0,0,,Boş verin, sadece içeri girin.
Dialogue: 0,0:17:23.13,0:17:25.13,Main,ReviseSanji,0,0,0,,Ne oldu?
Dialogue: 0,0:17:25.13,0:17:26.54,Main,Pirate,0,0,0,,Ne oluyor?
Dialogue: 0,0:17:27.64,0:17:29.06,Main,Marco,0,0,0,,Artık bunun için çok geç.
Dialogue: 0,0:17:32.52,0:17:35.74,Main,Marco,0,0,0,,Panik yapmayın, sadece bayılıyorlar.
Dialogue: 0,0:17:35.74,0:17:41.22,Main,Jozu,0,0,0,,Eğer yarı hazırlıklıysan bile, o adamın\Niradesi karşısında dayanamazsın.
Dialogue: 0,0:17:45.21,0:17:47.12,Main,Jozu,0,0,0,,Her zamanki gibi...
Dialogue: 0,0:17:47.99,0:17:49.62,Main,Jozu,0,0,0,,Ne üstün bir Haki.
Dialogue: 0,0:17:59.00,0:18:00.10,Main,Shanks,0,0,0,,Kusura bakmayın.
Dialogue: 0,0:18:00.80,0:18:03.81,Main,Shanks,0,0,0,,Düşman bir gemi olduğu\Niçin biraz tehditkar olmalıydım.
Dialogue: 0,0:18:04.50,0:18:10.22,Main,Whitebeard,0,0,0,,Sadece senin yüzünü görmek bile, o piç\Ntarafından verilen yarayı tekrar ağrıtıyor.
Dialogue: 0,0:18:10.22,0:18:13.27,Main,Shanks,0,0,0,,Bazı iyileştirici içki getirdim,\Ndövüşmek niyetinde değilim.
Dialogue: 0,0:18:13.81,0:18:15.90,Main,Shanks,0,0,0,,Konuşmak istediğim bir şey var.
Dialogue: 0,0:18:15.90,0:18:20.08,Main,Whitebeard,0,0,0,,Haki'sini demin gösteren\Nkişi mi söylüyor bunu?
Dialogue: 0,0:18:20.08,0:18:21.62,Main,Whitebeard,0,0,0,,Seni aptal.
Dialogue: 0,0:18:23.28,0:18:24.96,Main,Marco,0,0,0,,Hey! Kızıl Saç!
Dialogue: 0,0:18:24.96,0:18:26.75,Main,Marco,0,0,0,,Yavşak, ne yaptığına bir bak!
Dialogue: 0,0:18:26.75,0:18:29.45,Main,Shanks,0,0,0,,1.Kumandan Marco değil mi?
Dialogue: 0,0:18:29.45,0:18:31.21,Main,Shanks,0,0,0,,Benim tayfama katılır mısın?
Dialogue: 0,0:18:31.21,0:18:32.42,Main,Marco,0,0,0,,Kes sesini!
Dialogue: 0,0:18:32.75,0:18:35.17,Main,Jozu,0,0,0,,Babalık, yapmamalı mıyız...?
Dialogue: 0,0:18:35.17,0:18:38.38,Main,Whitebeard,0,0,0,,Evet, görüşüne göre savaşmak istemiyor.
Dialogue: 0,0:18:38.38,0:18:39.97,Main,Whitebeard,0,0,0,,Bizi yanlız bırakın.
Dialogue: 0,0:18:46.04,0:18:50.02,Main,Whitebeard,0,0,0,,Batı Mavi'nin içkisi, pek iyi değildir.
Dialogue: 0,0:18:50.53,0:18:56.49,Main,Shanks,0,0,0,,Ben bulunduğum tüm denizlerde, bu içkinin cilt\Niyileştirme özelliklerinden daha iyi bir içkiye rastlamadım.
Dialogue: 0,0:18:56.49,0:18:58.54,Main,Shanks,0,0,0,,Benim memleketimin içkisi.
Dialogue: 0,0:18:59.09,0:19:00.11,Main,Shanks,0,0,0,,Lüften, için.
Dialogue: 0,0:19:09.89,0:19:11.42,Main,Whitebeard,0,0,0,,Çok kötü değil...
Dialogue: 0,0:19:14.29,0:19:15.37,Main,Whitebeard,0,0,0,,Roger,
Dialogue: 0,0:19:15.37,0:19:16.11,Main,Whitebeard,0,0,0,,Garp,
Dialogue: 0,0:19:16.11,0:19:17.48,Main,Whitebeard,0,0,0,,Sengoku...
Dialogue: 0,0:19:17.48,0:19:21.44,Main,Whitebeard,0,0,0,,O zamanlar denizleri\Nbilenlerin sadece birkaçı kaldı.
Dialogue: 0,0:19:21.44,0:19:24.55,Main,Shanks,0,0,0,,22 yıl geçti normal böyle olması.
Dialogue: 0,0:19:24.86,0:19:28.02,Main,Whitebeard,0,0,0,,Sen de baya üst seviyeye yükselmişsin...
Dialogue: 0,0:19:28.38,0:19:32.94,Main,Whitebeard,0,0,0,,Sen sadece Gol D. Roger'ın\Ngemisinde bir çıraktın.
Dialogue: 0,0:19:33.36,0:19:36.50,Main,Whitebeard,0,0,0,,Roger'ın gemisinde oldukça iyiydin,
Dialogue: 0,0:19:36.50,0:19:39.67,Main,ReviseSanji,0,0,0,,O garip yüzlü ortağınla birlikte.
Dialogue: 0,0:19:40.12,0:19:42.21,Flashbacks,Shanks,0,0,0,,Biz geldik, Beyazsakal!
Dialogue: 0,0:19:42.21,0:19:44.12,Flashbacks,Buggy,0,0,0,,Umarım buna hazırsındır!
Dialogue: 0,0:19:44.12,0:19:48.38,Flashbacks,Buggy,0,0,0,,Bıyıklarını keseceğim!
Dialogue: 0,0:19:48.38,0:19:50.43,Flashbacks,Buggy,0,0,0,,Sen kimi kırmızı burun diye çağırıyorsun?
Dialogue: 0,0:19:52.47,0:19:54.47,Main,Whitebeard,0,0,0,,Sürekli senle beraber olan.
Dialogue: 0,0:19:54.47,0:19:57.42,Main,Whitebeard,0,0,0,,Kırmızı burunlu öldü mü?
Dialogue: 0,0:19:58.00,0:19:59.40,Main,Shanks,0,0,0,,Buggy?
Dialogue: 0,0:19:59.40,0:20:00.80,Main,Shanks,0,0,0,,Nostaljik hissettirdi...
Dialogue: 0,0:20:01.11,0:20:05.82,Main,Shanks,0,0,0,,Kaptanın idam gününde,\NLoguetown'da yollarımızı ayırdık.
Dialogue: 0,0:20:07.73,0:20:10.32,Flashbacks,Shanks,0,0,0,,Benimle gel, Buggy!
Dialogue: 0,0:20:10.32,0:20:13.32,Flashbacks,Buggy,0,0,0,,Senin astın olacağımı mı zannediyorsun, aptal!
Dialogue: 0,0:20:15.27,0:20:18.91,Main,Shanks,0,0,0,,Hala korsanlık yaptığına\Ndair söylentiler duyuyorum.
Dialogue: 0,0:20:20.37,0:20:23.97,Main,Whitebeard,0,0,0,,Bana hepsi daha dünmüş gibi geliyor.
Dialogue: 0,0:20:23.97,0:20:26.88,Main,Whitebeard,0,0,0,,Efsane olanlardan sadece birkaçı kaldı.
Dialogue: 0,0:20:26.88,0:20:31.67,Main,Whitebeard,0,0,0,,Senin ve Şahin Göz arasındaki günlük\Ndüellolar hala kulağıma yeni gibi geliyor.
Dialogue: 0,0:20:32.98,0:20:40.42,Main,Whitebeard,0,0,0,,Senin gibi bir adam Doğu Mavi'den kayıp\Nbir kol ile döndüğünde, herkes şaşırmıştı.
Dialogue: 0,0:20:41.21,0:20:44.19,Main,Whitebeard,0,0,0,,Nasıl bir düşmana kaybettin kolunu?
Dialogue: 0,0:20:44.19,0:20:45.89,Main,Whitebeard,0,0,0,,O sol kolunu.
Dialogue: 0,0:20:50.78,0:20:51.78,Main,Shanks,0,0,0,,Bu mu...
Dialogue: 0,0:20:53.47,0:20:55.57,Flashbacks,Shanks,0,0,0,,İstesen bile zaten seni götürmezdim.
Dialogue: 0,0:20:55.87,0:20:57.99,Flashbacks,Shanks,0,0,0,,Senin gibi biri korsan olabilir sanki de.
Dialogue: 0,0:20:59.36,0:21:00.36,Flashbacks,Luffy,0,0,0,,Olacağım!
Dialogue: 0,0:21:00.56,0:21:03.99,Flashbacks,Luffy,0,0,0,,Bir gün, bu tayfayı geride\Nbırakacak tayfa bulacağım.
Dialogue: 0,0:21:04.41,0:21:06.44,Flashbacks,Luffy,0,0,0,,Dünyanın en büyük hazinesini bulacağım.
Dialogue: 0,0:21:06.84,0:21:10.20,Flashbacks,Luffy,0,0,0,,Ve Korsanlar Kralı olacağım!
Dialogue: 0,0:21:11.17,0:21:12.71,Main,Shanks,0,0,0,,Yeni bir çağ üzerine...
Dialogue: 0,0:21:13.96,0:21:15.25,Main,Shanks,0,0,0,,bahis oynadım.
Dialogue: 0,0:21:16.75,0:21:19.39,Main,Whitebeard,0,0,0,,Bakalım, eğer buna değdiyse sorun yok.
Dialogue: 0,0:21:19.39,0:21:20.39,Main,Shanks,0,0,0,,Beyazsakal.
Dialogue: 0,0:21:20.73,0:21:25.78,Main,Shanks,0,0,0,,Birçok savaştan geçtim\Nve pek çok yara aldım ama...
Dialogue: 0,0:21:26.22,0:21:29.10,Main,Shanks,0,0,0,,Şu anda, ağrıyan tek yara...
Dialogue: 0,0:21:30.31,0:21:31.94,Main,Shanks,0,0,0,,bu yara.
Dialogue: 0,0:21:32.75,0:21:38.44,Main,Shanks,0,0,0,,Bu, bir maceradan veya\NŞahin Göz'den aldığım bir yara değil.
Dialogue: 0,0:21:38.76,0:21:42.07,Main,Shanks,0,0,0,,Bana bu yarayı açan senin\Neski adamlarından biriydi...
Dialogue: 0,0:21:42.07,0:21:43.94,Main,Shanks,0,0,0,,Karasakal, Teach!
Dialogue: 0,0:21:47.23,0:21:49.49,Main,Shanks,0,0,0,,Dikkatsiz falan da değildim.
Dialogue: 0,0:21:50.14,0:21:52.00,Main,Shanks,0,0,0,,Ne demek istediğimi anlıyor musun?
Dialogue: 0,0:21:52.88,0:21:53.95,Main,Shanks,0,0,0,,Beyazsakal.
Dialogue: 0,0:21:55.10,0:21:57.76,Main,Shanks,0,0,0,,O sadece bir şans bekliyordu.
Dialogue: 0,0:21:58.25,0:22:01.04,Main,Shanks,0,0,0,,O, komutan unvanını\Nünlü olur diye almadı bile.
Dialogue: 0,0:22:01.04,0:22:03.07,Main,Shanks,0,0,0,,Kendisini gizlemek istedi.
Dialogue: 0,0:22:03.07,0:22:07.45,Main,Shanks,0,0,0,,Şimdiye kadar Beyazsakal adının\Ngölgesi altında gizlenmeyi sürdürdü.
Dialogue: 0,0:22:08.36,0:22:11.58,Main,Shanks,0,0,0,,Güç elde etmek için hamle yaptı.
Dialogue: 0,0:22:12.76,0:22:15.40,Main,Shanks,0,0,0,,Sonunda, zirveye ulaşmayı hedefliyor,
Dialogue: 0,0:22:15.40,0:22:16.77,Main,Shanks,0,0,0,,Kendi istekleri için.
Dialogue: 0,0:22:17.48,0:22:19.99,Main,Shanks,0,0,0,,Senin ünvanını bile almaya gelebilir.
Dialogue: 0,0:22:25.41,0:22:27.91,Main,Whitebeard,0,0,0,,Ne yapmamı istiyorsun?
Dialogue: 0,0:22:28.25,0:22:30.92,Main,Whitebeard,0,0,0,,Esas soru bu.
Dialogue: 0,0:22:30.92,0:22:32.50,Main,Shanks,0,0,0,,Ace'i durdur!
Dialogue: 0,0:22:35.21,0:22:39.97,Main,Shanks,0,0,0,,Genç olmasına rağmen, 2. bölük komutanınıza güven duyuyorsunuz.
Dialogue: 0,0:22:39.97,0:22:43.17,Main,Shanks,0,0,0,,Ace güçlü, bunu biliyorum.
Dialogue: 0,0:22:53.14,0:22:56.89,Main,Shanks,0,0,0,,Ancak, o ün ve güven\Nbir şeyleri saptırabilir.
Dialogue: 0,0:22:56.89,0:23:00.07,Main,Shanks,0,0,0,,İkisinin dövüşmesi için\Nuygun bir zaman değil!
Dialogue: 0,0:23:01.07,0:23:03.69,Main,Shanks,0,0,0,,Karasakal Teach'den elini çek.
Dialogue: 0,0:23:04.83,0:23:07.16,Main,Shanks,0,0,0,,Tek isteğim bu.
Dialogue: 0,0:23:16.08,0:23:17.79,Main,Sherlock,0,0,0,,Babalık gülüyor.
Dialogue: 0,0:23:18.35,0:23:21.33,Main,Whitebeard,0,0,0,,Bu, o komik burunlu adamın\Nkonuşma tarzına benziyor.
Dialogue: 0,0:23:21.83,0:23:28.27,Main,Whitebeard,0,0,0,,Onun suçu... bir korsan gemisinde hiçbir şekilde yapılmaması\Ngereken bir şey, diğer bir tayfa arkadaşını öldürmek!
Dialogue: 0,0:23:28.27,0:23:31.03,Main,Whitebeard,0,0,0,,Demir kuralı çiğnedi.
Dialogue: 0,0:23:31.03,0:23:35.51,Main,Whitebeard,0,0,0,,Gemiye bindiği günden beri, ne kadar\Naptal olursa olsun, o benim oğlum oldu.
Dialogue: 0,0:23:35.89,0:23:39.69,Main,Whitebeard,0,0,0,,Öldürülen bir oğlun ruhu nereye gider?
Dialogue: 0,0:23:39.69,0:23:45.22,Main,Whitebeard,0,0,0,,Bu adama, ahlaki değerler olmadan\Nbu dünyayı aşamayacağını göstermeliyim!
Dialogue: 0,0:23:45.22,0:23:49.69,Main,Whitebeard,0,0,0,,O akılsızlığını Teach'e\Ngöstermek benim sorumluluğum!
Dialogue: 0,0:23:54.23,0:23:56.79,Main,Whitebeard,0,0,0,,Kaptın mı olayı, moron?
Dialogue: 0,0:23:56.79,0:23:59.34,Main,Whitebeard,0,0,0,,Beni yönlendirmek için\Nen az yüz yıl geçmesi lazım!
Dialogue: 0,0:24:13.52,0:24:16.10,Main,Shanks,0,0,0,,Kimse bunu durduramaz...
Dialogue: 0,0:24:16.10,0:24:17.81,Main,Shanks,0,0,0,,Bu çağın zıplama noktası!
Dialogue: 0,0:24:18.97,0:24:21.14,Main,Whitebeard,0,0,0,,Beni korkutmak için yeterli değil!
Dialogue: 0,0:24:21.14,0:24:24.35,Main,Whitebeard,0,0,0,,Ben Beyazsakalım!
Dialogue: 0,0:24:35.41,0:24:38.13,Main,Pirate,0,0,0,,O kızıl saçlı pislik! Babalığa ne yapıyor?!
Dialogue: 0,0:24:38.13,0:24:39.53,Main,Marco,0,0,0,,Bekle bekle.
Dialogue: 0,0:24:39.53,0:24:42.88,Main,Marco,0,0,0,,O, aptalca şeyler yapan bir adam değil.
Dialogue: 0,0:24:42.88,0:24:46.57,Main,Jozu,0,0,0,,Ama, görünüşe göre\Nkonuşmalarında bir şey yanlış gitmiş.
Dialogue: 0,0:24:46.57,0:24:48.14,Main,Jozu,0,0,0,,Gökyüzüne bak.
Dialogue: 0,0:24:49.15,0:24:50.49,Main,Jozu,0,0,0,,Bulutlar...
Dialogue: 0,0:24:50.49,0:24:52.72,Main,Jozu,0,0,0,,Hayır, gökyüzü ikiye ayrılmış!
Dialogue: 0,0:25:00.38,0:25:02.81,Main,Kiwi,0,0,0,,Abi, Iceburg değil mi?
Dialogue: 0,0:25:02.81,0:25:04.08,Main,Mozu,0,0,0,,Değil mi?
Dialogue: 0,0:25:04.08,0:25:05.85,Main,Iceburg,0,0,0,,Yapıyorsun demek he, Franky.
Dialogue: 0,0:25:07.37,0:25:09.59,Main,Franky,0,0,0,,Hey, neden buraya geldin?
Dialogue: 0,0:25:09.59,0:25:11.12,Main,Iceburg,0,0,0,,Aah, Ne oldu?
Dialogue: 0,0:25:11.12,0:25:13.89,Main,Iceburg,0,0,0,,Ben de bir el atayım dedim kötü mü ettim?
Dialogue: 0,0:25:16.87,0:25:20.30,Main,ReviseFranky,0,0,0,,Haysiyetsiz, benim planıma\Nmüdahale etmek için mi geldin?
Dialogue: 0,0:25:20.30,0:25:24.36,Main,Iceburg,0,0,0,,Uzun süredir sadece parçalama\Nyapıyorsun becerilerin körelmiş değil mi?
Dialogue: 0,0:25:24.36,0:25:25.50,Main,Iceburg,0,0,0,,Planlarını göster.
Dialogue: 0,0:25:26.61,0:25:28.73,Main,Paulie,0,0,0,,Tom'un bütün çalışanları bir araya gelmiş...
Dialogue: 0,0:25:29.43,0:25:31.93,Main,Paulie,0,0,0,,Bu bomboş yerde gemi\Nyapmak durumunda olsak bile.
Dialogue: 0,0:25:33.94,0:25:36.93,Main,Tilestone,0,0,0,,Bu Hasır Şapkalar için!
Dialogue: 0,0:25:36.93,0:25:38.68,Main,Tilestone,0,0,0,,Yardım lazım mı?
Dialogue: 0,0:25:38.68,0:25:41.89,Main,Peepley Lulu,0,0,0,,Böylesine aceleye getirilmiş bir\Nişi tek başına halletmek zor olmalı.
Dialogue: 0,0:25:42.49,0:25:45.35,Main,Iceburg,0,0,0,,Kasabada değil de burada\Nyapmak sorun olur mu?
Dialogue: 0,0:25:46.77,0:25:49.86,Main,Paulie,0,0,0,,Eğer o yanmış geminin\Nyerine bir gemi yapıyorsak,
Dialogue: 0,0:25:50.47,0:25:53.82,Main,Paulie,0,0,0,,Tüm çalışanlar ne olursa\Nolsun yardıma gelmesi gerek.
Dialogue: 0,0:25:53.82,0:25:55.33,Main,Franky,0,0,0,,Sizler!
Dialogue: 0,0:25:55.33,0:25:57.16,Main,Franky,0,0,0,,Hepiniz var ya...!
Dialogue: 0,0:25:57.40,0:25:59.67,Main,Mozu,0,0,0,,Çok iyi insanlarsınız.
Dialogue: 0,0:25:59.67,0:26:00.67,Main,Kiwi,0,0,0,,Öyleler.
Dialogue: 0,0:26:02.02,0:26:04.09,Main,Franky,0,0,0,,Kesinlikle gevşememeniz gerek!
Dialogue: 0,0:26:07.46,0:26:11.63,Main,Tilestone,0,0,0,,Tamam! Hadi onlara 1. İskeledekilerin\Nneler yapabileceğini gösterelim!
Dialogue: 0,0:26:15.61,0:26:16.92,Main,Redondin,0,0,0,,Hey!
Dialogue: 0,0:26:17.94,0:26:18.93,Main,Redondin,0,0,0,,Bak!
Dialogue: 0,0:26:18.93,0:26:21.18,Main,Redondin,0,0,0,,Bugünkü haberler!
Dialogue: 0,0:26:21.81,0:26:24.24,Main,Redondin,0,0,0,,Enies Lobby'deki olayları anlatıyor.
Dialogue: 0,0:26:24.24,0:26:26.37,Main,Zambai,0,0,0,,Sonunda oldu!
Dialogue: 0,0:26:26.37,0:26:28.10,Main,Zambai,0,0,0,,Hey! Ne yazıyor?
Dialogue: 0,0:26:28.55,0:26:30.81,Main,Zambai,0,0,0,,Bu, kaderimizi belirleyebilecek bir yazı!
Dialogue: 0,0:26:31.45,0:26:32.49,Main,Redondin,0,0,0,,Bakalım... Bu...
Dialogue: 0,0:26:32.49,0:26:34.08,Main,Zambai,0,0,0,,B-Bu...
Dialogue: 0,0:26:34.08,0:26:36.11,Main,Redondin,0,0,0,,Bizim hakkımızda...
Dialogue: 0,0:26:36.64,0:26:38.61,Main,Redondin,0,0,0,,Hiçbir şey yazmıyor.
Dialogue: 0,0:26:38.61,0:26:40.72,Main,Zambai,0,0,0,,H-harbi mi?
Dialogue: 0,0:26:40.72,0:26:42.14,Main,Guy,0,0,0,,Hiç mi?
Dialogue: 0,0:26:42.14,0:26:43.21,Main,Guy2,0,0,0,,Hata yok!
Dialogue: 0,0:26:43.21,0:26:46.91,Main,Zambai,0,0,0,,Ve biz kalıcı bir kaçak\Nhayatı için hazırlanıyorduk!
Dialogue: 0,0:26:46.91,0:26:48.83,Main,Zambai,0,0,0,,Çok şükür!
Dialogue: 0,0:26:51.56,0:26:53.74,Main,Blackbeard,0,0,0,,Çok beklenmedik büyük bir şey yapmışlar.
Dialogue: 0,0:26:54.50,0:26:55.53,Main,Blackbeard,0,0,0,,Hey, bakın!
Dialogue: 0,0:26:55.53,0:26:56.97,Main,Blackbeard,0,0,0,,Bu, Hasır Şapka hakkında bir makale!
Dialogue: 0,0:26:57.27,0:26:59.21,Main,Blackbeard,0,0,0,,Görünüşe göre o, yargı\Nadasını ele geçirmiş.
Dialogue: 0,0:26:59.21,0:27:01.72,Main,Blackbeard,0,0,0,,Bununla birlikte, kesinlikle\Nonun ödülünü yükselecek!
Dialogue: 0,0:27:04.65,0:27:08.64,Main,BB Crew,0,0,0,,Enies Lobby, Water 7 deniz\Ntreni hattının olduğu ünlü bir yerdir.
Dialogue: 0,0:27:08.98,0:27:10.66,Main,BB Crew,0,0,0,,Buradan uzakta değil.
Dialogue: 0,0:27:11.73,0:27:14.01,Main,BB Crew,0,0,0,,Onunla tekrar karşılaşabiliriz.
Dialogue: 0,0:27:15.03,0:27:18.03,Main,BB Crew,0,0,0,,Bizim ateş menzilimizin içinde...
Dialogue: 0,0:27:18.03,0:27:20.84,Main,BB Crew,0,0,0,,Ne kadar acınası... \NOnlar oldukça talihsiz bir grup...
Dialogue: 0,0:27:26.30,0:27:27.48,Main,BB Crew,0,0,0,,Gidelim, Kaptan!
Dialogue: 0,0:27:28.76,0:27:30.60,Main,Blackbeard,0,0,0,,Tabii ki gideceğiz!
Dialogue: 0,0:27:33.42,0:27:35.92,Main,Blackbeard,0,0,0,,Öyleyse, gitmek için hazırlanın!
Dialogue: 0,0:27:35.92,0:27:37.83,Main,Blackbeard,0,0,0,,Acele edin.
Dialogue: 0,0:27:37.83,0:27:38.83,Main,Ace,0,0,0,,Hey!
Dialogue: 0,0:27:39.20,0:27:41.12,Main,Ace,0,0,0,,Bekle 2 dakika, Teach.
Dialogue: 0,0:27:41.12,0:27:42.42,Main,Ace,0,0,0,,Seni arıyordum.
Dialogue: 0,0:28:07.91,0:28:09.55,Main,Zoro,0,0,0,,Bu ne demek oluyor?
Dialogue: 0,0:28:09.55,0:28:11.97,Main,Zoro,0,0,0,,Franky Ailesi'nin neden\Nolduğu tüm sıkıntılardan sonra.
Dialogue: 0,0:28:11.97,0:28:17.65,Main,Sanji,0,0,0,,Acaba deden, sıradan insanları dahil\Netmek istemediği için mi onları bildirmedi?
Dialogue: 0,0:28:17.65,0:28:20.25,Main,Luffy,0,0,0,,Hayır... böyle bir yapacağını...
Dialogue: 0,0:28:20.25,0:28:21.81,Main,Nami-Chopper,0,0,0,,Düşünmüyorum.
Dialogue: 0,0:28:25.86,0:28:27.25,Thoughts,Robin,0,0,0,,Aokiji'nin parmağı varmış gibi...
Dialogue: 0,0:28:27.25,0:28:28.46,Thoughts,Robin,0,0,0,,Ne kadar öngörülemez bir adam.
Dialogue: 0,0:28:28.46,0:28:30.22,Main,Sanji,0,0,0,,Ne olursa olsun, rahatladım.
Dialogue: 0,0:28:30.89,0:28:36.80,Main,ReviseSanji,0,0,0,,Bizim için sorun olmayabilir, ancak onların\Nkaçak olmaları oldukça talihsiz olurdu.
Dialogue: 0,0:28:36.80,0:28:40.02,Main,Zoro,0,0,0,,Ve onların yerine, yaptıklarımızla\Nilgili korkunç şeyler söyleniyor.
Dialogue: 0,0:28:40.44,0:28:43.18,Main,Zoro,0,0,0,,"Dünya Hükümetine karşı savaş ilanı".
Dialogue: 0,0:28:43.18,0:28:46.10,Main,Zoro,0,0,0,,Yanan ada için bile bizi suçluyorlar.
Dialogue: 0,0:28:46.10,0:28:49.35,Main,Zoro,0,0,0,,Bununla beraber ödüllerimiz artıcak.
Dialogue: 0,0:28:50.57,0:28:53.74,Main,Chopper,0,0,0,,Ben de ödül alacak mıyım?
Dialogue: 0,0:28:53.74,0:28:56.12,Main,Sanji,0,0,0,,Bakalım, büyük ihtimalle ama...
Dialogue: 0,0:28:56.60,0:28:58.53,Main,Sanji,0,0,0,,En havalı olan ben olacağım.
Dialogue: 0,0:28:58.53,0:29:01.19,Main,Sanji,0,0,0,,"Büyük Yıldız Göründü".
Dialogue: 0,0:29:01.19,0:29:03.12,Main,Nami,0,0,0,,Ne için heyecanlanıyorsun böyle?
Dialogue: 0,0:29:05.84,0:29:08.70,Main,Luffy,0,0,0,,Franky bizim için gemi mi yapıyor?
Dialogue: 0,0:29:08.70,0:29:11.21,Main,Sanji,0,0,0,,Oh sen o sırada uyukluyordun değil mi?
Dialogue: 0,0:29:11.21,0:29:13.02,Main,Luffy,0,0,0,,Oley, Bu çok iyi oldu!
Dialogue: 0,0:29:13.02,0:29:15.58,Main,ReviseLuffy,0,0,0,,Gördünüz sonuçta o iyi bir insan.
Dialogue: 0,0:29:15.58,0:29:17.89,Main,Chopper,0,0,0,,Ne tür bir gemi olacak?\NBunu sabırsızlıkla bekliyorum!
Dialogue: 0,0:29:17.89,0:29:21.31,Main,Nami,0,0,0,,Öyleyse, kalan parayı erzak\Nsatın almak için kullanalım.
Dialogue: 0,0:29:15.58,0:29:21.31,Secondary,Luffy,0,0,0,,O iyi bir adam, iyi bir adam...
Dialogue: 0,0:29:21.78,0:29:24.42,Main,Luffy,0,0,0,,Hey, gemi büyük olacak mı acaba?
Dialogue: 0,0:29:24.42,0:29:27.06,Main,Zoro,0,0,0,,Evet, buraya geldiğimizden\Nberi daha geniş alanlar istiyordum.
Dialogue: 0,0:29:27.06,0:29:29.23,Main,Nami,0,0,0,,Buraya koyduğumuz 100 milyon beli nerede?
Dialogue: 0,0:29:29.23,0:29:33.78,Main,Luffy,0,0,0,,O mu, parti verdiğimizde\Nyemeklere ve içeceklere gitti o para.
Dialogue: 0,0:29:33.78,0:29:34.78,Main,Nami,0,0,0,,Harcadığımız...?
Dialogue: 0,0:29:34.78,0:29:36.68,Main,Nami,0,0,0,,Bizim paramız?
Dialogue: 0,0:29:36.68,0:29:38.78,Main,Luffy,0,0,0,,Partimiz için değil miydi?
Dialogue: 0,0:29:39.78,0:29:42.45,Main,Nami,0,0,0,,Neredeyse hiçbir şey kalmamış!
Dialogue: 0,0:29:42.45,0:29:43.70,Main,Luffy,0,0,0,,Evet, Tabii ki!
Dialogue: 0,0:29:43.70,0:29:47.92,Main,Luffy,0,0,0,,Şehirdeki neredeyse herkes\Npartiye sonuna kadar katıldı.
Dialogue: 0,0:29:47.92,0:29:49.54,Main,Luffy,0,0,0,,Çok eğlenceliydi!
Dialogue: 0,0:29:57.04,0:30:01.22,Main,Luffy,0,0,0,,Eh, gemimizi alacağımız\Niçin artık önemli değil.
Dialogue: 0,0:30:01.52,0:30:05.46,Main,Nami,0,0,0,,Gemi için harika mobilyalar\Nalmayı düşünüyordum...
Dialogue: 0,0:30:06.22,0:30:08.22,Main,Robin,0,0,0,,Kanala gidip biraz bir\Nşeyler var mı diye bakalım.
Dialogue: 0,0:30:08.79,0:30:12.07,Main,Luffy,0,0,0,,Hey, Robin, ben eğlenmeye çıkmak istiyorum,\Nbana biraz para ödünç verebilir misin?
Dialogue: 0,0:30:12.80,0:30:14.77,Main,Nami,0,0,0,,Bunu daha fazla kaldıramıyorum!
Dialogue: 0,0:30:15.34,0:30:17.26,Main,Nami,0,0,0,,Hiçbir şey almayacaksın!
Dialogue: 0,0:30:17.26,0:30:19.78,Main,Luffy,0,0,0,,Anlaşıldı!
Dialogue: 0,0:30:45.72,0:30:46.91,Main,Sanji,0,0,0,,Usopp?
Dialogue: 0,0:30:48.26,0:30:49.47,Main,Usopp,0,0,0,,Ne oldu?
Dialogue: 0,0:30:49.47,0:30:52.57,Main,Usopp,0,0,0,,Luffy, geri gelmemi mi istiyorsun?
Dialogue: 0,0:30:53.02,0:30:55.53,Main,Usopp,0,0,0,,Aman be, sizinle ne\Nyapacağımı hiç bilmiyorum.
Dialogue: 0,0:30:55.87,0:30:58.77,Main,Usopp,0,0,0,,Eğer burada değilsem,\Nhiçbir şeyi beceremiyorsunuz.
Dialogue: 0,0:30:59.06,0:31:02.81,Main,Usopp,0,0,0,,Kabul, ısrarcıysanız tayfaya geri döneceğim.
Dialogue: 0,0:31:03.65,0:31:05.77,Main,Usopp,0,0,0,,Böyle söylemem daha iyi gibi.
Dialogue: 0,0:31:06.31,0:31:08.62,Main,Usopp,0,0,0,,Bu 23. model...
Dialogue: 0,0:31:08.62,0:31:11.00,Main,Usopp,0,0,0,,Hey, Chopper, bugün güzel bir hava var.
Dialogue: 0,0:31:11.00,0:31:12.23,Main,Usopp,0,0,0,,Balık tutmaya gidelim!
Dialogue: 0,0:31:13.82,0:31:15.55,Main,Usopp,0,0,0,,Hey, Luffy, peki ya sen?
Dialogue: 0,0:31:16.04,0:31:17.37,Main,Usopp,0,0,0,,Bu da iyi aslında.
Dialogue: 0,0:31:17.37,0:31:21.32,Main,Usopp,0,0,0,,"Hiçbir şey olmamış\Ngibi davranma" stratejisi.
Dialogue: 0,0:31:21.32,0:31:22.32,Main,Usopp,0,0,0,,Ya da...
Dialogue: 0,0:31:22.37,0:31:24.95,Main,Usopp,0,0,0,,Elbaf'a gitme kararı aldık!
Dialogue: 0,0:31:24.95,0:31:27.37,Main,Usopp,0,0,0,,Ne? Lüften gitmeyin!
Dialogue: 0,0:31:27.37,0:31:28.44,Main,Usopp,0,0,0,,Şaka yapıyordum.
Dialogue: 0,0:31:28.44,0:31:30.44,Main,Usopp,0,0,0,,Duygularını anlıyorum.
Dialogue: 0,0:31:31.01,0:31:33.85,Main,Usopp,0,0,0,,Geri mi dönüyorsun, Usopp?
Dialogue: 0,0:31:35.41,0:31:36.94,Main,Usopp,0,0,0,,Tabii ki, gerizekalı!
Dialogue: 0,0:31:37.53,0:31:41.20,Main,Usopp,0,0,0,,Tabii ki, sizler beni çok seviyorsunuz!
Dialogue: 0,0:31:42.32,0:31:43.60,Main,Sanji,0,0,0,,Ne yapıyor o?
Dialogue: 0,0:31:43.60,0:31:45.03,Main,Sanji,0,0,0,,O mal.
Dialogue: 0,0:31:50.18,0:31:54.10,Main,Franky,0,0,0,,Iceburg-san, yorulmuş\Ngörünüyorsun, biraz uyusan nasıl olur?
Dialogue: 0,0:31:54.10,0:31:55.18,Main,Iceburg,0,0,0,,Kendine bak!
Dialogue: 0,0:31:57.09,0:31:58.93,Flashbacks,Franky,0,0,0,,Kaybettim...
Dialogue: 0,0:31:58.93,0:32:01.42,Flashbacks,Franky,0,0,0,,Vicudum... hala sıcak...
Dialogue: 0,0:32:02.26,0:32:04.76,Flashbacks,Franky,0,0,0,,Hala yaşıyorum...
Dialogue: 0,0:32:06.01,0:32:08.81,Flashbacks,Franky,0,0,0,,Bu gidişle... Öleceğim gibi...
Dialogue: 0,0:32:21.39,0:32:22.75,Flashbacks,Franky,0,0,0,,Kimse de yok.
Dialogue: 0,0:32:23.53,0:32:25.70,Flashbacks,Franky,0,0,0,,Terkedilmiş bir gemi.
Dialogue: 0,0:32:26.40,0:32:27.67,Flashbacks,Franky,0,0,0,,Hurda...
Dialogue: 0,0:32:27.67,0:32:29.66,Flashbacks,Franky,0,0,0,,Demir parçaları...
Dialogue: 0,0:32:30.47,0:32:34.67,Flashbacks,Franky,0,0,0,,Beni sakinleştirecek bir yer...
Dialogue: 0,0:32:35.23,0:32:41.09,Flashbacks,Franky,0,0,0,,İlk olarak, Eğer bu hareket edemeyen\Nvücut hakkında bir şey yapmazsam...
Dialogue: 0,0:32:48.29,0:32:49.60,Main,Nami,0,0,0,,Seyir pusulası hazır.
Dialogue: 0,0:32:49.81,0:32:52.26,Main,Nami,0,0,0,,Seyir Pusulası sıradaki\Nadaya işaret ediyor.
Dialogue: 0,0:32:53.14,0:32:54.99,Main,Luffy,0,0,0,,Öyleyse, yapmamız gereken\Ntek şey gemiye binmek..
Dialogue: 0,0:32:54.99,0:32:56.11,Main,Luffy,0,0,0,,Eğlenceli olacak!
Dialogue: 0,0:32:56.38,0:33:00.44,Main,Nami,0,0,0,,Evet, sürpriz olacak, bize gelmeyin\Ndeyip, bitene kadar görmememizi söyledi.
Dialogue: 0,0:33:00.69,0:33:05.95,Main,Kokoro,0,0,0,,Arkadaşlar, eğer o iğneyi takip ederseniz,\Nnereye varacağınızı biliyor musunuz?
Dialogue: 0,0:33:05.95,0:33:07.83,Main,Nami,0,0,0,,Hayır, nereye?
Dialogue: 0,0:33:08.65,0:33:11.25,Main,Nami,0,0,0,,Görünüşe göre biraz aşağıyı gösteriyor.
Dialogue: 0,0:33:12.90,0:33:14.33,Main,Kokoro,0,0,0,,Bu doğru.
Dialogue: 0,0:33:14.33,0:33:15.68,Main,Kokoro,0,0,0,,Sıradaki ada...
Dialogue: 0,0:33:15.68,0:33:17.04,Main,Kokoro,0,0,0,,Denizin dibindeki cennet,
Dialogue: 0,0:33:17.45,0:33:19.38,Main,Kokoro,0,0,0,,Balık adam Adası.
Dialogue: 0,0:33:28.51,0:33:32.26,Main,Sanji,0,0,0,,Balık adam adası? Sonunda?
Dialogue: 0,0:33:32.26,0:33:34.18,Main,Chopper,0,0,0,,Eh? Ne oldu, Sanji?
Dialogue: 0,0:33:35.18,0:33:36.96,Main,Nami,0,0,0,,Balık adam adası demek he?
Dialogue: 0,0:33:36.96,0:33:38.64,Main,Nami,0,0,0,,Çok kafa karıştırıcı...
Dialogue: 0,0:33:38.64,0:33:42.15,Main,Luffy,0,0,0,,Evet, köyünde olanlar yüzünden...
Dialogue: 0,0:33:45.41,0:33:48.86,Main,Zoro,0,0,0,,Ama, o balık adam bir korsandı, değil mi?
Dialogue: 0,0:33:48.86,0:33:52.53,Main,Sanji,0,0,0,,Evet, doğru, gerçekten\Nanladın, değil mi, aptal?
Dialogue: 0,0:33:52.53,0:33:53.81,Main,Sanji,0,0,0,,Malın önde gideni olmana rağmen.
Dialogue: 0,0:33:54.08,0:33:56.80,Main,Sanji,0,0,0,,Balık adam Adası \NGrand Line üzerindeki ünlü bir durak.
Dialogue: 0,0:33:56.80,0:34:00.27,Main,Sanji,0,0,0,,Dünyanın en güzel deniz\Nkızları, denizde yaylar çiziyorlar.
Dialogue: 0,0:34:00.27,0:34:03.95,Main,Sanji,0,0,0,,Balıklarla bir arada\Nyaşayabileceğiniz bir hayal krallığı.
Dialogue: 0,0:34:03.95,0:34:04.85,Main,Chopper,0,0,0,,Öyle mi?
Dialogue: 0,0:34:04.85,0:34:05.85,Main,Chopper,0,0,0,,İnanılmaz!
Dialogue: 0,0:34:12.60,0:34:15.07,Main,Sanji,0,0,0,,Ama, hayal kuramaz mıyız?
Dialogue: 0,0:34:15.07,0:34:16.40,Main,Sanji,0,0,0,,İşte bunu korsanlar olarak yapıyoruz!
Dialogue: 0,0:34:16.40,0:34:18.60,Main,Kokoro,0,0,0,,Genç olanlar da var!
Dialogue: 0,0:34:19.14,0:34:23.78,Main,Kokoro,0,0,0,,Velakin, O cennete ulaşmak kolay değil.
Dialogue: 0,0:34:24.26,0:34:26.74,Main,Kokoro,0,0,0,,Ama yine de "denizin dibinde"\Nkavramı hakkında endişeliyim...
Dialogue: 0,0:34:27.17,0:34:29.58,Main,Luffy,0,0,0,,Oraya gidince öğreneceğiz artık.
Dialogue: 0,0:34:30.11,0:34:32.02,Main,Kokoro,0,0,0,,Sorun o değil.
Dialogue: 0,0:34:32.61,0:34:36.00,Main,Kokoro,0,0,0,,En son gazetenin ilk\Nsayfasına bir göz atın.
Dialogue: 0,0:34:36.92,0:34:38.55,Main,Nami,0,0,0,,Bu da ne...?
Dialogue: 0,0:34:38.55,0:34:42.75,Main,Nami,0,0,0,,"Tekrar oldu, Bu hafta\N14 gemi ortadan kayboldu."
Dialogue: 0,0:34:42.75,0:34:43.95,Main,,0,0,0,,Bu da ne demek oluyor?
Dialogue: 0,0:34:43.95,0:34:46.22,Main,,0,0,0,,O üçgen bölgeye...
Dialogue: 0,0:34:46.22,0:34:48.47,Main,,0,0,0,,Florian Üçgeni deniyor.
Dialogue: 0,0:34:49.22,0:34:53.21,Main,,0,0,0,,Cennete ulaşmak için zorunlu\Nolarak geçmeniz gereken bir bölge.
Dialogue: 0,0:34:55.38,0:35:00.73,Main,,0,0,0,,Her sene sebepsiz yere 100'den\Nfazla gemi orada kayboluyor...
Dialogue: 0,0:35:01.48,0:35:07.72,Main,,0,0,0,,Sonra, çok daha sonra, gemiler\Nmürettebatı olmadan bulunur.
Dialogue: 0,0:35:07.72,0:35:14.44,Main,,0,0,0,,O denizde seyahat eden ölülerin kontrol ettiği\Nhayalet gemileriyle ilgili görgü tanığı raporları var.
Dialogue: 0,0:35:14.69,0:35:17.48,Main,,0,0,0,,Hayaletler mi beliriyor? Bu çok korkutucu!
Dialogue: 0,0:35:17.82,0:35:20.41,Main,,0,0,0,,Yaşayan iskeletler mi göreceğiz?
Dialogue: 0,0:35:20.66,0:35:23.29,Main,,0,0,0,,Ne hayal ediyorsun böyle?
Dialogue: 0,0:35:23.46,0:35:24.29,Main,,0,0,0,,Hayır!
Dialogue: 0,0:35:24.29,0:35:26.64,Main,,0,0,0,,Kesinlikle onlarla karşılaşmak\Nveya görmek istemem.
Dialogue: 0,0:35:26.64,0:35:28.61,Main,,0,0,0,,Böyle korkunç gemileri!
Dialogue: 0,0:35:28.61,0:35:30.48,Main,,0,0,0,,O denizde neler oluyor öyle?
Dialogue: 0,0:35:31.86,0:35:33.23,Main,,0,0,0,,Ne bileyim...
Dialogue: 0,0:35:33.23,0:35:35.78,Main,,0,0,0,,Orada her şey olabilir.
Dialogue: 0,0:35:35.78,0:35:40.08,Main,,0,0,0,,O denize girenler geri\Ndönmez, bu yüzden bilmiyorum...
Dialogue: 0,0:35:40.08,0:35:42.53,Main,,0,0,0,,Sisli, derin, karanlık bir deniz...
Dialogue: 0,0:35:42.53,0:35:43.76,Main,,0,0,0,,Dikkatli olun...
Dialogue: 0,0:35:46.59,0:35:54.07,Main,,0,0,0,,Neyse ki, o son derece felaketli ve tehlikeli denize\Ngirmeden önce iyice hazırlıklı olmanız daha iyi olur.
Dialogue: 0,0:35:54.50,0:35:59.07,Main,,0,0,0,,Bir zamanlar ticaret gemileri veya korsan gemileri\Nolanların sadece gölgesi olan hayalet gemiler...
Dialogue: 0,0:36:00.32,0:36:02.83,Main,,0,0,0,,Hazine gemileri efsanelerinin\Nvazgeçilmez parçalarıdır.
Dialogue: 0,0:36:04.08,0:36:05.96,Main,,0,0,0,,Hadi hayalet gemileri araştıralım!
Dialogue: 0,0:36:05.96,0:36:07.46,Main,,0,0,0,,Bana bırak bu işi!
Dialogue: 0,0:36:07.70,0:36:09.96,Main,,0,0,0,,Eh? Ben istemiyorum!
Dialogue: 0,0:36:10.70,0:36:15.58,Main,,0,0,0,,Kaza yaşarsak diye bol miktarda erzak stoklamayı\Nniyet ediyorum, o yüzden endişelenmeyin.
Dialogue: 0,0:36:15.58,0:36:17.29,Main,,0,0,0,,Hazine gemisi?
Dialogue: 0,0:36:17.29,0:36:18.43,Main,,0,0,0,,Orada kılıç da olabilir.
Dialogue: 0,0:36:18.82,0:36:21.22,Main,,0,0,0,,Korsan abiler!
Dialogue: 0,0:36:21.22,0:36:22.33,Main,,0,0,0,,Hasır Şapka!
Dialogue: 0,0:36:25.93,0:36:26.93,Main,,0,0,0,,Bir şey mi lazım?
Dialogue: 0,0:36:28.13,0:36:32.53,Main,,0,0,0,,Franky abi herkesi\Noraya toplamamızı istedi!
Dialogue: 0,0:36:32.53,0:36:35.62,Main,,0,0,0,,Hayallerin gemisi tamamlandı!
Dialogue: 0,0:36:35.62,0:36:38.12,Main,,0,0,0,,Muhteşem görünüyor!
Dialogue: 0,0:36:40.07,0:36:41.32,Main,,0,0,0,,Çoktan tamamlandı mı?
Dialogue: 0,0:36:41.32,0:36:42.89,Main,,0,0,0,,Bu çabuk oldu!
Dialogue: 0,0:36:42.89,0:36:47.40,Main,,0,0,0,,Beş üst düzey gemi tamircisi\Ngece boyunca onu inşa etti!
Dialogue: 0,0:36:47.40,0:36:48.46,Main,,0,0,0,,İnşa ettiler!
Dialogue: 0,0:36:48.46,0:36:50.17,Main,,0,0,0,,Anlaşıldı! O zaman gidelim!
Dialogue: 0,0:36:50.17,0:36:51.17,Main,,0,0,0,,Evet!
Dialogue: 0,0:36:51.20,0:36:53.34,Main,,0,0,0,,Hasır Şapka-san!
Dialogue: 0,0:36:54.38,0:36:56.64,Main,,0,0,0,,Hasır Şapka-san!
Dialogue: 0,0:36:57.35,0:36:58.64,Main,,0,0,0,,Franky ailesi!
Dialogue: 0,0:36:59.01,0:37:01.53,Main,,0,0,0,,Ne oldu çocuklar?
Dialogue: 0,0:37:01.53,0:37:02.75,Main,,0,0,0,,Nefesiniz kesilmiş.
Dialogue: 0,0:37:07.19,0:37:10.38,Main,,0,0,0,,Dürüst olmak gerekirse, daha demin duyduk!
Dialogue: 0,0:37:10.38,0:37:11.78,Main,,0,0,0,,Aranma posterlerinizi gördünüz mü?
Dialogue: 0,0:37:12.03,0:37:13.02,Main,,0,0,0,,Aranma Posterleri?
Dialogue: 0,0:37:13.02,0:37:16.78,Main,,0,0,0,,Sana inanılmaz bir ödül\Nverilmiş, Hasır Şapka-san!
Dialogue: 0,0:37:17.50,0:37:21.15,Main,,0,0,0,,Ayrıca, herkesin ödülü artmış!
Dialogue: 0,0:37:21.71,0:37:22.71,Main,,0,0,0,,Benim de mi?!
Dialogue: 0,0:37:22.71,0:37:23.27,Main,,0,0,0,,Evet!
Dialogue: 0,0:37:23.27,0:37:24.53,Main,,0,0,0,,Benim de?!
Dialogue: 0,0:37:24.53,0:37:25.83,Main,,0,0,0,,Benim de mi?!
Dialogue: 0,0:37:25.83,0:37:28.29,Main,,0,0,0,,Gevezelik yerine, kendiniz\Ngörseniz daha iyi olur.
Dialogue: 0,0:37:29.01,0:37:32.04,Main,,0,0,0,,Artık yedinizin birden ödülü var!
Dialogue: 0,0:37:35.55,0:37:38.71,Main,,0,0,0,,Hasır Şapkalı Luffy\Nödül 300,000,000 beli.
Dialogue: 0,0:37:40.85,0:37:42.18,Main,,0,0,0,,Artmış!
Dialogue: 0,0:37:42.75,0:37:46.65,Main,,0,0,0,,Korsan Avcısı Zoro\NÖdül 120,000,000 beli.
Dialogue: 0,0:37:48.99,0:37:52.56,Main,,0,0,0,,Hırsız Kedi Nami\NÖdül 16,000,000 beli.
Dialogue: 0,0:37:52.56,0:37:54.24,Main,,0,0,0,,Olamaz-
Dialogue: 0,0:37:54.70,0:37:58.90,Main,,0,0,0,,Pamuk Şeker Seven Chopper (Evcil Hayvan)\NÖdül 50 beli.
Dialogue: 0,0:37:59.41,0:38:00.65,Main,,0,0,0,,50 mi...?
Dialogue: 0,0:38:01.22,0:38:05.16,Main,,0,0,0,,Şeytanın Çocuğu Nico Robin\NÖdül 80,000,000 beli.
Dialogue: 0,0:38:10.61,0:38:11.75,Main,,0,0,0,,Bu kim...?
Dialogue: 0,0:38:12.68,0:38:17.72,Main,,0,0,0,,Kara Bacak Sanji (Fotoğraf çekme girişimi\Nbaşarısız oldu) ödül 77,000,000 beli.
Dialogue: 0,0:38:17.72,0:38:19.93,Main,,0,0,0,,Sogeking içinde var.
Dialogue: 0,0:38:19.93,0:38:26.19,Main,,0,0,0,,Üzgünüm, birbirinize söyleyeceğiniz\Nçok şey var gibi görünüyor ama
Dialogue: 0,0:38:26.19,0:38:27.44,Main,,0,0,0,,Lütfen bekleyin.
Dialogue: 0,0:38:27.86,0:38:29.81,Main,,0,0,0,,Bizim talebimiz, bunla ilgili.
Dialogue: 0,0:38:29.81,0:38:30.98,Main,,0,0,0,,Buna bakın Lütfen.
Dialogue: 0,0:38:30.98,0:38:32.02,Main,,0,0,0,,Franky!
Dialogue: 0,0:38:32.81,0:38:36.99,Main,,0,0,0,,Cyborg Franky\NÖdül 44,000,000 beli.
Dialogue: 0,0:38:36.99,0:38:40.12,Main,,0,0,0,,Bu korkunç, abimizin başında bir ödül var!
Dialogue: 0,0:38:40.12,0:38:41.63,Main,,0,0,0,,Korkunç bir olay!
Dialogue: 0,0:38:41.63,0:38:43.25,Main,,0,0,0,,Evet öyle.
Dialogue: 0,0:38:43.25,0:38:47.76,Main,,0,0,0,,Biz bir şekilde bundan kurtulduk,\NAma Abimiz kurtulamadı...
Dialogue: 0,0:38:48.34,0:38:52.30,Main,,0,0,0,,Water 7'da kaldığı sürece\Nhayatı tehlikede olacak.
Dialogue: 0,0:38:52.30,0:38:56.21,Main,,0,0,0,,Bir daha yakalanırsa, onu kurtarmak\Niçin yeterli gücümüz olmayacak!
Dialogue: 0,0:38:56.80,0:39:01.23,Main,,0,0,0,,Abimiz kesinlikle bizim hakkımızda endişeleniyordur\Nve bu yüzden adayı terk etmek istemiyor.
Dialogue: 0,0:39:03.51,0:39:06.90,Main,,0,0,0,,Bu yüzden sizinle konuşmak istedik...
Dialogue: 0,0:39:07.31,0:39:08.75,Main,,0,0,0,,Hasır Şapkalı-san, sana yalvarıyorum!
Dialogue: 0,0:39:08.75,0:39:12.66,Main,,0,0,0,,Kendisinin isteğine karşı olsa bile,\Nabimize birlikte denize yelken açma fırsatı verin!
Dialogue: 0,0:39:12.66,0:39:15.36,Main,,0,0,0,,O adam zaten bir korsanın çocuğuydu!
