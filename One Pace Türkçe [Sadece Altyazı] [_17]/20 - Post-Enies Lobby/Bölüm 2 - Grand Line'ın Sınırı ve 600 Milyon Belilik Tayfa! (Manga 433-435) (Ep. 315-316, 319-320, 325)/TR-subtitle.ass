Dialogue: 0,0:00:14.43,0:00:19.27,Rainbow Star lyrics,,0,0,0,,{\fad(50,0)}♪ Kobalt mavisi gökte süzülen bulutlar,...
Dialogue: 0,0:00:24.57,0:00:29.25,Rainbow Star lyrics,,0,0,0,,...kayboldu ve yarın hepimizi sırılsıklam edecek. ♪
Dialogue: 0,0:00:33.96,0:00:39.09,Rainbow Star lyrics,,0,0,0,,♪ Günbatımından önce sadece gülümsersek her şey iyi olacak. ♪
Dialogue: 0,0:00:39.09,0:00:43.48,Rainbow Star lyrics,,0,0,0,,♪ Eğer isteğin buysa, sadece yapabilirsin... ♪
Dialogue: 0,0:00:43.60,0:00:45.94,Rainbow Star lyrics,,0,0,0,,♪ Göğsünde bir büyü söyle. ♪
Dialogue: 0,0:00:46.52,0:00:49.32,Rainbow Star lyrics,,0,0,0,,{\fad(0,50)}♪ Umutlarınız için... ♪
Dialogue: 0,0:00:54.79,0:00:56.62,Rainbow Star lyrics,,0,0,0,,♪ Hızlı önsezimiz...
Dialogue: 0,0:00:56.62,0:00:59.46,Rainbow Star lyrics,,0,0,0,,...gökkuşağı renkli müzik notalarında gösteriliyor. ♪
Dialogue: 0,0:01:02.34,0:01:04.84,Rainbow Star lyrics,,0,0,0,,♪ Benimle gelmeyecek misin? ♪
Dialogue: 0,0:01:04.84,0:01:06.68,Rainbow Star lyrics,,0,0,0,,♪ Bizler düşmüş,...
Dialogue: 0,0:01:06.68,0:01:09.43,Rainbow Star lyrics,,0,0,0,,...ateşli oklarımızı senin hayallerine yollayacağız. ♪
Dialogue: 0,0:01:42.77,0:01:44.61,Rainbow Star lyrics,,0,0,0,,{\fad(0,50)}♪ Hangi rengi eklemeliyiz...
Dialogue: 0,0:01:44.61,0:01:47.45,Rainbow Star lyrics,,0,0,0,,...kobalt mavisine? ♪
Dialogue: 0,0:01:52.87,0:01:57.55,Rainbow Star lyrics,,0,0,0,,♪ Gözlerinde yansıyan üzücü gerçeği yok et. ♪
Dialogue: 0,0:01:57.88,0:02:02.80,Rainbow Star lyrics,,0,0,0,,♪ Tüylerimizi sıcaklıkla dolu bir şekilde kaldıralım. ♪
Dialogue: 0,0:02:02.80,0:02:04.76,Rainbow Star lyrics,,0,0,0,,♪ Sürreal düşmüş melekler,...
Dialogue: 0,0:02:04.76,0:02:07.64,Rainbow Star lyrics,,0,0,0,,...kalbimizden şarkı söylüyorlar. ♪
