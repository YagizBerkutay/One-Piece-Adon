Dialogue: 0,0:39:06.00,0:39:13.00,Author,,0,0,0,,{\fad(500,500)\fs17} Türkçeleştirme & Çevirmen  {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&} - {\c&H01BAFF&}{\b1}kazasker{\b0}{\c&HFFFFFF&}\N{\fs18}thx to onepace.net
Dialogue: 0,0:00:26.80,0:00:32.18,Main,,0,0,0,,Hükümet bana korsanlardan\Nnefret eden korsan diyor...
Dialogue: 0,0:00:32.42,0:00:34.86,Main,,0,0,0,,...ama sizin grubunuz farklı mevzu.
Dialogue: 0,0:00:34.86,0:00:37.64,Main,,0,0,0,,"Korsanlardan nefret eden" mi? Sen mi?
Dialogue: 0,0:00:37.64,0:00:40.35,Main,,0,0,0,,Senin için şaşırtıcı olmalı...
Dialogue: 0,0:00:41.09,0:00:44.44,Main,,0,0,0,,Beyazsakal'ın gemisinde\Nçok vakit geçirdim ama...
Dialogue: 0,0:00:44.76,0:00:49.11,Main,,0,0,0,,...konumum itibariyle oraya gitmek için\Nsu altında yolculuk etmek zorunda kaldım.
Dialogue: 0,0:00:49.84,0:00:52.60,Main,,0,0,0,,Sizi seviyorum.
Dialogue: 0,0:00:55.58,0:00:59.81,Main,,0,0,0,,Bir keresinde beni neredeyse\Nöldürdüğünü hatırlıyor gibiyim ama...
Dialogue: 0,0:01:00.34,0:01:02.98,Main,,0,0,0,,Evet, sen de neredeyse\Nbeni öldürüyordun, değil mi?
Dialogue: 0,0:01:04.02,0:01:07.52,Main,,0,0,0,,Sadece ona yardım etmek istedim.
Dialogue: 0,0:01:08.38,0:01:14.72,Main,,0,0,0,,Sonuçta Balık Adam Adası,\NBeyazsakal sayesinde barış içinde.
Dialogue: 0,0:01:16.04,0:01:21.19,Main,,0,0,0,,Grand Line'da yolculuk eden tüm\Nkorsanlar Balık Adam Adası'ndan geçer.
Dialogue: 0,0:01:22.24,0:01:27.28,Main,,0,0,0,,Büyük Korsan Çağı başladıktan kısa süre\Nsonra Balık Adam Adası kaosa sürüklendi.
Dialogue: 0,0:01:28.04,0:01:32.42,Main,,0,0,0,,Tutamayacağımız kadar çok insan\Nkorsanın ve onların peşinden gelen...
Dialogue: 0,0:01:32.91,0:01:34.91,Main,,0,0,0,,...denizcilerin akınına uğramıştı.
Dialogue: 0,0:01:35.82,0:01:40.78,Main,,0,0,0,,Sayısız deniz kızı ve balık\Nadam kaçırılıp satıldı...
Dialogue: 0,0:01:41.18,0:01:44.38,Main,,0,0,0,,...ve herkes umutsuzluk\Nkarşısında gözlerini kaparken...
Dialogue: 0,0:01:45.72,0:01:48.10,Main,,0,0,0,,...Beyazsakal ortaya çıktı.
Dialogue: 0,0:01:51.10,0:01:54.74,Flashbacks,,0,0,0,,Bu ada artık bana ait!
Dialogue: 0,0:01:55.36,0:01:57.79,Main,,0,0,0,,Tüm gereken o sözlerdi.
Dialogue: 0,0:01:57.79,0:02:02.60,Main,,0,0,0,,Bunun ardından kimse Balık Adam\NAdası'na el süremedi.
Dialogue: 0,0:02:02.60,0:02:05.26,Main,,0,0,0,,Ne güç ama!
Dialogue: 0,0:02:05.86,0:02:08.51,Main,,0,0,0,,O günü asla unutmayacağım!
Dialogue: 0,0:02:09.36,0:02:13.86,Main,,0,0,0,,Bu şekilde kendinin olduğunu iddia\Nederek sayısız adayı korudu.
Dialogue: 0,0:02:14.68,0:02:19.18,Main,,0,0,0,,O korsan patronu, bu yüzden\Ndüşmesine izin veremeyiz!
Dialogue: 0,0:02:19.49,0:02:23.50,Main,,0,0,0,,Ölseydi okyanuslara ne olurdu dersin?!
Dialogue: 0,0:02:23.99,0:02:26.53,Main,,0,0,0,,Kaos çağı geri dönerdi.
Dialogue: 0,0:02:26.54,0:02:28.28,Main,,0,0,0,,Bunu kim olsa anlayabilir!
Dialogue: 0,0:02:28.39,0:02:31.28,Main,,0,0,0,,Hükümet de bunu fark etmiş olmalı!
Dialogue: 0,0:02:33.90,0:02:37.40,Main,,0,0,0,,Hayatıma mal olsa bile\Nbu savaşı durdurmak istedim.
Dialogue: 0,0:02:38.04,0:02:42.23,Main,,0,0,0,,Seni kurtarmak istedim, Ace-san.
Dialogue: 0,0:02:45.06,0:02:47.95,Main,,0,0,0,,Jinbei... lütfen kes şunu.
Dialogue: 0,0:02:48.45,0:02:50.12,Main,,0,0,0,,Kendine çok yükleniyorsun.
Dialogue: 0,0:02:51.18,0:02:54.19,Main,,0,0,0,,Hâlâ umudumu kaybetmedim.
Dialogue: 0,0:02:54.56,0:02:58.19,Main,,0,0,0,,Mucizelere ve fırsatlara inancım var.
Dialogue: 0,0:03:03.32,0:03:07.60,Main,,0,0,0,,Dışarıda işler oldukça ilginç\Nbir hâl almış gibi görünüyor.
Dialogue: 0,0:03:12.27,0:03:16.60,Main,,0,0,0,,Bu, Beyazsakal'ı devirmek için\Nmükemmel bir fırsatmış gibi geliyor.
Dialogue: 0,0:03:17.28,0:03:20.54,Main,,0,0,0,,Düşüncesi bile kanımı kaynatıyor.
Dialogue: 0,0:03:21.06,0:03:22.28,Main,,0,0,0,,Pislik!
Dialogue: 0,0:03:24.12,0:03:27.25,Main,,0,0,0,,Yaşlı adamın başını almak\Nistediğini mi söylüyorsun?
Dialogue: 0,0:03:29.14,0:03:30.89,Main,,0,0,0,,Sadece ben değil.
Dialogue: 0,0:03:33.90,0:03:35.96,Main,,0,0,0,,Beyazsakal'ı öldür!
Dialogue: 0,0:03:36.26,0:03:38.22,Main,,0,0,0,,O pislik ölecek mi diyorsun?!
Dialogue: 0,0:03:39.73,0:03:41.47,Main,,0,0,0,,Bu hoşuma gitti! Kulağa hoş geliyor!
Dialogue: 0,0:03:41.79,0:03:43.37,Main,,0,0,0,,Bırakın denize açılayım!
Dialogue: 0,0:03:43.48,0:03:45.40,Main,,0,0,0,,Onun kafasını kesen ben olacağım!
Dialogue: 0,0:03:45.66,0:03:47.41,Main,,0,0,0,,Ben de dövüşeyim!
Dialogue: 0,0:03:47.41,0:03:49.94,Main,,0,0,0,,Beyazsakal çağına son vereceğim!
Dialogue: 0,0:03:53.48,0:03:55.41,Main,,0,0,0,,Sessiz olun, ahmaklar!
Dialogue: 0,0:03:56.92,0:03:58.66,Main,,0,0,0,,Jinbei. Ateş Yumruk.
Dialogue: 0,0:03:58.66,0:04:00.35,Main,,0,0,0,,Şunu unutmayın.
Dialogue: 0,0:04:01.22,0:04:06.36,Main,,0,0,0,,Beyazsakal'ı veya Roger'ı yenemedikleri için gözyaşlarını\Nyutmak zorunda kalanları saymayı deneyin...
Dialogue: 0,0:04:07.20,0:04:10.06,Main,,0,0,0,,...ve denizin ötesinde\Nbinlercesini bulacaksınız.
Dialogue: 0,0:04:20.72,0:04:22.69,Main,,0,0,0,,Bu niye onlarla bağlantı\Nkuramadığımızı açıklıyor.
Dialogue: 0,0:04:22.84,0:04:26.45,Main,,0,0,0,,Seviye 2'deki gözlem odası\Nbasilisk tarafından ezilmiş!
Dialogue: 0,0:04:26.84,0:04:28.76,Main,,0,0,0,,Basiliski yenmişler mi?!
Dialogue: 0,0:04:29.14,0:04:30.32,Main,,0,0,0,,Kim bu ikisi?!
Dialogue: 0,0:04:30.86,0:04:32.89,Main,,0,0,0,,Seviye 2'de neler oluyor?
Dialogue: 0,0:04:40.03,0:04:41.69,Main,,0,0,0,,Orada biri var!
Dialogue: 0,0:04:41.80,0:04:42.70,Main,,0,0,0,,Buldun mu onları?
Dialogue: 0,0:04:43.03,0:04:44.03,Main,,0,0,0,,Evet ama...
Dialogue: 0,0:04:44.20,0:04:46.00,Main,,0,0,0,,...görünüşe bakılırsa şimdi üç kişiler.
Dialogue: 0,0:04:46.00,0:04:47.33,Main,,0,0,0,,Ne?!
Dialogue: 0,0:04:47.36,0:04:50.32,Captions,,0,0,27,,{\fad(500,500)}Şeytani Canavar Katı
Dialogue: 0,0:04:53.52,0:04:54.52,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:04:54.67,0:04:55.50,Main,,0,0,0,,{\fad(150,150)}Bara Bara...
Dialogue: 0,0:04:55.67,0:04:56.54,Main,,0,0,0,,{\fad(150,150)}Mum...
Dialogue: 0,0:04:56.76,0:04:58.24,Main,,0,0,0,,{\fad(150,150)}...Tabanca!\N...Top!\N...Kilit!
Dialogue: 0,0:05:05.78,0:05:07.89,Main,,0,0,0,,Dev çıyan patladı!
Dialogue: 0,0:05:08.06,0:05:10.90,Main,,0,0,0,,Çok sayıda yapboz akrepten yapılmış!
Dialogue: 0,0:05:11.04,0:05:12.66,Main,,0,0,0,,Zehirliler!
Dialogue: 0,0:05:13.04,0:05:14.73,Main,,0,0,0,,Gelmeye devam ediyorlar!
Dialogue: 0,0:05:24.10,0:05:25.24,Main,,0,0,0,,Gördünüz mü, söylemiştim.
Dialogue: 0,0:05:25.74,0:05:30.14,Main,,0,0,0,,"Sahte Bacaklar Usta Planı"ma\Ntamamen kandılar!
Dialogue: 0,0:05:33.45,0:05:35.08,Main,,0,0,0,,Gizliliğimizi açığa çıkardın!
Dialogue: 0,0:05:37.08,0:05:38.28,Main,,0,0,0,,Lanet olsun!
Dialogue: 0,0:05:38.78,0:05:42.79,Main,,0,0,0,,Ah, Seviye 2'deki hayvanların patronunun\Naslan benzeri bir şey olduğunu duymuştum.
Dialogue: 0,0:05:42.79,0:05:43.79,Main,,0,0,0,,Onlar mı yoksa?
Dialogue: 0,0:05:43.99,0:05:48.66,Main,,0,0,0,,Hayır! Onlar insan yüzlü aslan, mantikor*!
Dialogue: 0,0:05:48.66,0:05:52.00,Captions,,0,0,0,,{\pos(770,476.667)}Muhafız
Dialogue: 0,0:05:48.96,0:05:52.00,Main,,0,0,5,,Yakalarlarsa bizi yiyecekler, hatta kemiklerimizi bile!
Dialogue: 0,0:05:52.00,0:05:53.72,Main,,0,0,0,,Kemiklerimizi de mi?!
Dialogue: 0,0:05:53.72,0:05:54.50,Main,,0,0,0,,Anahtarlar...
Dialogue: 0,0:05:55.00,0:05:56.77,Main,,0,0,0,,Lütfen bize anahtarları verin.
Dialogue: 0,0:05:57.17,0:05:58.17,Main,,0,0,0,,Boş verin onları!
Dialogue: 0,0:05:58.17,0:06:02.01,Main,,0,0,0,,Yüzleri insana benzediği için\Ninsan konuşmasını taklit edebilirler!
Dialogue: 0,0:06:02.01,0:06:03.98,Main,,0,0,0,,Lütfen yardım edin!
Dialogue: 0,0:06:03.98,0:06:05.71,Main,,0,0,0,,Acıyor... Çok acı verici!
Dialogue: 0,0:06:05.88,0:06:10.82,Main,,0,0,0,,Sadece mahkumların söylediklerini taklit ediyorlar.\NNe anlama geldiğini bile bilmezler!
Dialogue: 0,0:06:10.82,0:06:12.48,Main,,0,0,0,,Ü-Ürkütücü...
Dialogue: 0,0:06:12.76,0:06:14.76,Main,,0,0,0,,Peştamal! Peştamal!
Dialogue: 0,0:06:14.76,0:06:15.90,Main,,0,0,0,,Çilek baskılı külot!
Dialogue: 0,0:06:15.90,0:06:18.19,Main,,0,0,0,,Sadece aptalca şeyleri tekrarlıyorlar!
Dialogue: 0,0:06:18.19,0:06:20.19,Main,,0,0,0,,Dana biftek!
Dialogue: 0,0:06:21.03,0:06:22.03,Main,,0,0,0,,Tepki verme!
Dialogue: 0,0:06:22.84,0:06:23.90,Main,,0,0,0,,Hey, sen!
Dialogue: 0,0:06:24.90,0:06:27.00,Main,,0,0,0,,Bize yardım edeceğini söyledin, değil mi?
Dialogue: 0,0:06:28.00,0:06:29.90,Main,,0,0,0,,Elbette söyledim!
Dialogue: 0,0:06:30.17,0:06:34.17,Main,,0,0,0,,Sonuçta buradan kaçmak için\Nkaynaklarımızı birleştirmeliyiz, değil mi?!
Dialogue: 0,0:06:34.46,0:06:35.68,Main,,0,0,0,,Daha aşağı nasıl inerim?
Dialogue: 0,0:06:35.98,0:06:37.58,Main,,0,0,0,,Seviye 3'e gidiyorum!
Dialogue: 0,0:06:38.00,0:06:40.70,Main,,0,0,0,,Ne? Kaçma niyetinde değil misin?!
Dialogue: 0,0:06:40.88,0:06:43.15,Main,,0,0,0,,Seviye 1'e çıkmıyor musun?!
Dialogue: 0,0:06:44.00,0:06:47.05,Main,,0,0,0,,Hasır Şapka, abisi Ace'i\Nkurtarmayı planlıyor.
Dialogue: 0,0:06:47.22,0:06:49.34,Main,,0,0,0,,Ne?! Abin mi?!
Dialogue: 0,0:06:49.49,0:06:51.90,Main,,0,0,0,,Hasır Şapka, sen ve \NAteş Yumruk Ace kardeş misiniz?!
Dialogue: 0,0:06:52.04,0:06:54.45,Main,,0,0,0,,Ve onu kurtaracak mısın?!
Dialogue: 0,0:06:55.33,0:06:56.40,Main,,0,0,0,,Acelem var!
Dialogue: 0,0:06:57.00,0:07:01.66,Thoughts,,0,0,0,,Ace burada tutuluyorsa Seviye 5'te olmalı.
Dialogue: 0,0:07:01.72,0:07:03.34,Thoughts,,0,0,0,,Öyle bir yere gidiyorsun.
Dialogue: 0,0:07:03.54,0:07:05.04,Main,,0,0,0,,ŞAKAYI BIRAK!
Dialogue: 0,0:07:05.24,0:07:06.67,Main,,0,0,0,,DELİRMİŞ OLMALISIN!
Dialogue: 0,0:07:06.67,0:07:07.67,Main,,0,0,0,,BEN BURADAN ÇIKIYORUM!
Dialogue: 0,0:07:07.78,0:07:08.68,Main,,0,0,0,,Dur!
Dialogue: 0,0:07:09.68,0:07:12.72,Main,,0,0,0,,O zaman en azından merdivenlerin\Nnerede olduğunu gösterebilir misin?
Dialogue: 0,0:07:12.88,0:07:14.21,Thoughts,,0,0,0,,Merdivenler?
Dialogue: 0,0:07:14.32,0:07:15.72,Thoughts,,0,0,0,,Evet!
Dialogue: 0,0:07:16.22,0:07:19.38,Thoughts,,0,0,0,,Seviye 1'e çıkan merdivenler aynı\Nzamanda da Seviye 3'e iniyor!
Dialogue: 0,0:07:19.58,0:07:24.10,Thoughts,,0,0,0,,Merdivenlerdeki hayvan muhafızın dikkatini\Ndağıtmak için Hasır Şapka'yı kullanabilirim!
Dialogue: 0,0:07:25.46,0:07:27.98,Thoughts,,0,0,0,,O noktada yollarımız ayrılacak.
Dialogue: 0,0:07:28.40,0:07:31.74,Main,,0,0,0,,Tamam, Hasır Şapka. Birlikte gidelim!
Dialogue: 0,0:07:34.76,0:07:37.08,Main,,0,0,0,,Bana bırak, Hasır Şapka!
Dialogue: 0,0:07:37.16,0:07:38.66,Main,,0,0,0,,Peşimden ge-
Dialogue: 0,0:07:44.32,0:07:46.77,Main,,0,0,0,,Burada bir şey var.
Dialogue: 0,0:07:51.28,0:07:54.75,Main,,0,0,0,,{\a6}Merdivenlerin muhafızı, Sfenks!
Dialogue: 0,0:07:53.94,0:07:57.08,Captions,,0,0,0,,{\fad(500,0)\pos(768,426.667)}Muhafız
Dialogue: 0,0:07:53.94,0:07:57.08,Captions,,0,0,27,,{\fad(500,0)}(İnsan yüzlü tüylü Aslan)
Dialogue: 0,0:07:57.42,0:08:00.69,Main,,0,0,0,,A-Aslan? Hayır, yaşlı bir adam?
Dialogue: 0,0:08:04.60,0:08:06.63,Main,,0,0,0,,Omlet pirinç!
Dialogue: 0,0:08:05.10,0:08:06.63,Secondary,,0,0,0,,Dana biftek!
Dialogue: 0,0:08:11.00,0:08:12.27,Main,,0,0,0,,Beyaz erişte.
Dialogue: 0,0:08:12.54,0:08:14.35,Main,,0,0,0,,B-beyaz erişte?!
Dialogue: 0,0:08:16.35,0:08:17.82,Main,,0,0,0,,Çekilmiş erişte!
Dialogue: 0,0:08:21.32,0:08:23.02,Main,,0,0,0,,Baharatlı erişte!
Dialogue: 0,0:08:23.62,0:08:26.35,Main,,0,0,0,,Tüm erişte çeşitlerini öğrenmiş!
Dialogue: 0,0:08:26.74,0:08:28.89,Main,,0,0,0,,Domuz etli erişte!
Dialogue: 0,0:08:29.40,0:08:30.49,Main,,0,0,0,,Yakışıklı erkekler!
Dialogue: 0,0:08:32.00,0:08:33.02,Main,,0,0,0,,Bize mi seslendin?
Dialogue: 0,0:08:35.32,0:08:36.80,Main,,0,0,0,,Bu herif tehlikeli!
Dialogue: 0,0:08:38.81,0:08:40.18,Main,,0,0,0,,B-Bu...
Dialogue: 0,0:08:41.06,0:08:44.18,Main,,0,0,0,,Sfenks, uzakta bir yerde kendini kaybetmiş!
Dialogue: 0,0:08:44.38,0:08:48.24,Main,,0,0,0,,Buradan kaçabilmemiz mümkün değil!
Dialogue: 0,0:08:48.38,0:08:50.34,Main,,0,0,0,,Siyah soslu Kore eriştesi!
Dialogue: 0,0:08:50.48,0:08:53.14,Main,,0,0,0,,Lanet olsun, bu şey ne kadar güçlü?!
Dialogue: 0,0:08:54.08,0:08:58.36,Main,,0,0,0,,Sahi, burada olmamız\Nzaten onun hatası değil mi?
Dialogue: 0,0:08:58.36,0:09:00.49,Main,,0,0,0,,Ben de aynısını düşünüyordum.
Dialogue: 0,0:09:01.36,0:09:05.82,Main,,0,0,0,,Tamam! O zaman "Kaçış İttifakı"mız\Nburada kuruluyor!
Dialogue: 0,0:09:05.92,0:09:08.96,Main,,0,0,0,,Burada özgürlüğe gerçekten değer\Nveren biri olduğuna memnun oldum!
Dialogue: 0,0:09:09.61,0:09:13.70,Main,,0,0,0,,O zaman "Hasır Şapka Yemimiz Planı"na\Nbaşlayalım!
Dialogue: 0,0:09:15.49,0:09:17.94,Main,,0,0,0,,Hey, ne yapıyorsunuz siz?
Dialogue: 0,0:09:19.94,0:09:22.46,Main,,0,0,0,,G-Geliyor, Hasır Şapka!
Dialogue: 0,0:09:26.92,0:09:31.00,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no Bazuka!
Dialogue: 0,0:09:37.64,0:09:40.65,Main,,0,0,0,,Niye bilerek kızdırdın?!
Dialogue: 0,0:09:40.76,0:09:42.15,Main,,0,0,0,,Eyvah!
Dialogue: 0,0:09:44.04,0:09:45.86,Main,,0,0,0,,İkiniz hiç adil değilsiniz!
Dialogue: 0,0:09:45.96,0:09:47.90,Main,,0,0,0,,Öyle yüksek yerlere kaçıyorsunuz!
Dialogue: 0,0:09:51.56,0:09:53.78,Main,,0,0,0,,Çekilmiş erişte!
Dialogue: 0,0:10:02.06,0:10:04.64,Main,,0,0,0,,Numarayı yedin, yarım akıllı yaratık!
Dialogue: 0,0:10:04.64,0:10:09.05,Main,,0,0,0,,O, Doru Doru güçlerimi kullanarak\Noluşturduğum bir mum heykel!
Dialogue: 0,0:10:09.18,0:10:10.66,Main,,0,0,0,,Güveç erişte...
Dialogue: 0,0:10:10.86,0:10:14.81,Main,,0,0,0,,Bayan Altınhafta'nın parlak renkleri yok...
Dialogue: 0,0:10:15.21,0:10:19.56,Main,,0,0,0,,...ama senin gibi bir hayvanı\Nkandırmak için yeter de artar bile!
Dialogue: 0,0:10:23.83,0:10:26.40,Main,,0,0,0,,Hangisi gerçek?
Dialogue: 0,0:10:31.40,0:10:32.94,Main,,0,0,0,,Yanlış!
Dialogue: 0,0:10:33.91,0:10:35.65,Main,,0,0,0,,Yanlış!
Dialogue: 0,0:10:36.44,0:10:38.44,Main,,0,0,0,,Yanlış!
Dialogue: 0,0:10:39.77,0:10:41.99,Main,,0,0,0,,Bu harika! Köstebeğe vurma oyunu!
Dialogue: 0,0:10:42.49,0:10:43.31,Main,,0,0,0,,Yanlış!
Dialogue: 0,0:10:43.79,0:10:44.62,Main,,0,0,0,,Yanlış!
Dialogue: 0,0:10:44.62,0:10:45.69,Main,,0,0,0,,İşte orada!
Dialogue: 0,0:10:46.12,0:10:46.77,Main,,0,0,0,,Yanlış!
Dialogue: 0,0:10:47.53,0:10:49.59,Main,,0,0,0,,Yanlış. Şuna ne dersin?
Dialogue: 0,0:10:49.89,0:10:50.59,Main,,0,0,0,,Yanlış!
Dialogue: 0,0:10:50.95,0:10:51.71,Main,,0,0,0,,Yanlış!
Dialogue: 0,0:10:53.47,0:10:55.96,Main,,0,0,0,,Sfenks'le oynuyor!
Dialogue: 0,0:10:56.29,0:11:00.31,Main,,0,0,0,,Hasır Şapka, ne kadar neşeli olabilirsin?!
Dialogue: 0,0:11:03.01,0:11:05.01,Main,,0,0,0,,Sen de mi eğleniyorsun?
Dialogue: 0,0:11:06.11,0:11:09.71,Main,,0,0,0,,Bundan düşündüğümden daha çok keyif\Nalıyorlar... Peki, şimdi benim şansım!
Dialogue: 0,0:11:11.68,0:11:14.91,Main,,0,0,0,,Hey, bu tuhaf titremeler de neyin nesi?
Dialogue: 0,0:11:15.21,0:11:18.22,Main,,0,0,0,,Sfenks'i kızdırmaya daha\Nne kadar devam edecekler?
Dialogue: 0,0:11:26.45,0:11:27.45,Main,,0,0,0,,Ne?!
Dialogue: 0,0:11:27.53,0:11:29.61,Main,,0,0,0,,Bu kat bu kadar şeye dayanabilir mi?
Dialogue: 0,0:11:31.50,0:11:32.85,Main,,0,0,0,,Burası Seviye Üç!
Dialogue: 0,0:11:33.05,0:11:36.60,Main,,0,0,0,,Birkaç ekranla irtibatı yitirdik!\NYukarıdan büyük gürültüler duyuyoruz!
Dialogue: 0,0:11:38.74,0:11:40.97,Main,,0,0,0,,Bay Üç! Şimdi bizim fırsatımız!
Dialogue: 0,0:11:42.64,0:11:44.48,Main,,0,0,0,,Görünüşe göre operasyon başarılıydı!
Dialogue: 0,0:11:44.48,0:11:46.43,Main,,0,0,0,,Hiç de planladığım gibi olmadı!
Dialogue: 0,0:11:46.62,0:11:47.91,Main,,0,0,0,,Yine de kaçalım!
Dialogue: 0,0:11:48.73,0:11:50.85,Main,,0,0,0,,Merdivenlere giden kapı o mu?
Dialogue: 0,0:11:50.95,0:11:53.13,Main,,0,0,0,,Mumdan bir anahtar yapacağım!
Dialogue: 0,0:11:53.43,0:11:55.09,Main,,0,0,0,,Burası gözlem odası!
Dialogue: 0,0:11:55.32,0:11:58.15,Main,,0,0,0,,Hala Seviye 2'den yanıt alamıyoruz!
Dialogue: 0,0:11:58.33,0:12:00.53,Main,,0,0,0,,Neler olduğu hakkında hiçbir fikrimiz yok!
Dialogue: 0,0:12:07.59,0:12:09.30,Main,,0,0,0,,O APTAL CANAVAR!
Dialogue: 0,0:12:09.51,0:12:11.93,Main,,0,0,0,,Tüm katın çatlamasına neden oldu!
Dialogue: 0,0:12:12.63,0:12:14.04,Main,,0,0,0,,Burası Seviye 3!
Dialogue: 0,0:12:14.97,0:12:16.65,Main,,0,0,0,,Tavandan bir canavar düşüyor!
Dialogue: 0,0:12:25.61,0:12:27.26,Main,,0,0,0,,Eyvah!
Dialogue: 0,0:12:28.96,0:12:32.63,Main,,0,0,0,,Hey! Altımızdaki Seviye 3!
Dialogue: 0,0:12:32.99,0:12:36.57,Main,,0,0,0,,Üzgün erişte!
Dialogue: 0,0:12:38.53,0:12:40.67,Main,,0,0,0,,Burası gözlem odası. Seviye 2'yle\Nirtibat kurduk.
Dialogue: 0,0:12:41.09,0:12:42.67,Main,,0,0,0,,{\i1}Görüntü alıyor musunuz?{\i0}
Dialogue: 0,0:12:43.59,0:12:46.12,Main,,0,0,0,,Evet. Lütfen durumu açıklayın.
Dialogue: 0,0:12:46.12,0:12:47.01,Main,,0,0,0,,{\i1}Anlaşıldı.{\i0}
Dialogue: 0,0:12:47.63,0:12:49.85,Main,,0,0,0,,Burada ne oldu?
Dialogue: 0,0:12:50.34,0:12:53.92,Main,,0,0,0,,Bu delik Sfenks'in bile\Ndüşebileceği kadar büyük!
Dialogue: 0,0:12:54.73,0:12:57.42,Main,,0,0,0,,Hasır Şapkalı Luffy neyin peşinde?
Dialogue: 0,0:13:14.99,0:13:16.48,Main,,0,0,0,,Hey, bakın! Durum kötü!
Dialogue: 0,0:13:16.64,0:13:20.48,Main,,0,0,0,,Seviye 2'deki mahkumlar hücrelerinden\Nçıkmış! Anahtarları nasıl aldılar?!
Dialogue: 0,0:13:20.79,0:13:23.29,Main,,0,0,0,,Bunun da sorumlusu onlar mı?!
Dialogue: 0,0:13:23.48,0:13:24.85,Main,,0,0,0,,O muhafızların başı dertte!
Dialogue: 0,0:13:28.32,0:13:30.61,Main,,0,0,0,,Kaptan Buggy'e karşı minnettarlığımızı\Nve saygımızı sunuyoruz.
Dialogue: 0,0:13:31.27,0:13:32.79,Main,,0,0,0,,Kurtarıcımız!
Dialogue: 0,0:13:36.76,0:13:39.93,Main,,0,0,0,,B-Burası Seviye 2! Destek istiyoruz!
Dialogue: 0,0:13:39.95,0:13:41.23,Main,,0,0,0,,Mahkûmlar...
Dialogue: 0,0:13:41.39,0:13:43.53,Main,,0,0,0,,...ayaklanıyor!
Dialogue: 0,0:13:47.91,0:13:49.87,Main,,0,0,0,,Blugoriler'i Seviye 2'ye gönderin!s
Dialogue: 0,0:13:50.17,0:13:53.53,Main,,0,0,0,,Hey! Hasır Şapkalı Luffy'nin ne\Nyapmaya çalıştığını öğrendik!
Dialogue: 0,0:13:53.62,0:13:55.42,Main,,0,0,0,,Öğrendiniz mi? Nasıl?
Dialogue: 0,0:13:56.19,0:13:59.35,Main,,0,0,0,,Denizci Karargâhı'ndaki Filo Amirali\NSengoku buna şüphe olmadığını söylüyor.
Dialogue: 0,0:14:00.30,0:14:06.29,Main,,0,0,0,,İstilacı Monkey D. Luffy ve infazını\Nbekleyen mahkum Portgas D. Ace...
Dialogue: 0,0:14:06.29,0:14:09.13,Main,,0,0,0,,...kardeşmiş!
Dialogue: 0,0:14:10.15,0:14:11.05,Main,,0,0,0,,Ne?!
Dialogue: 0,0:14:11.30,0:14:16.30,Main,,0,0,0,,Yani infazından önce onu\Nburadan çıkarmaya mı çalışıyor?
Dialogue: 0,0:14:16.55,0:14:18.31,Main,,0,0,0,,Evet, hiç şüphesiz!
Dialogue: 0,0:14:18.31,0:14:21.01,Main,,0,0,0,,Bu, neden aşağı inmeye\Nçalıştığını açıklıyor!
Dialogue: 0,0:14:21.01,0:14:23.69,Main,,0,0,0,,Beyazsakal'ın bize saldırma olasılığına\Nodaklanmakla çok meşguldük.
Dialogue: 0,0:14:23.69,0:14:27.61,Main,,0,0,0,,Bir şekilde başarılı olursa durum\Ntamamiyle tersine dönecek!
Dialogue: 0,0:14:27.61,0:14:29.75,Main,,0,0,0,,Bunu hemen Müdür Magellan'a bildirin!
Dialogue: 0,0:14:29.75,0:14:32.28,Main,,0,0,0,,Seviye 2'deki isyanı bastırmalıyız!
Dialogue: 0,0:14:40.66,0:14:43.63,Captions,,0,0,580,,{\fs120\c&H171414&\3c&H8B645C&\pos(603.2,151.2)\frz14.48}Donanma
Dialogue: 0,0:14:44.23,0:14:46.13,Main,,0,0,0,,O kadar komik olan ne, Garp?!
Dialogue: 0,0:14:51.93,0:14:54.99,Main,,0,0,0,,Dünyayı değiştirebilecek bir\Nyol ayrımında duruyoruz.
Dialogue: 0,0:14:54.99,0:14:59.38,Main,,0,0,0,,...ama o sürekli sorun\Nçıkarmaya devam ediyor!
Dialogue: 0,0:14:59.53,0:15:00.88,Main,,0,0,0,,Önce Enies Lobby'de...
Dialogue: 0,0:15:01.55,0:15:03.45,Main,,0,0,0,,Sonra Kutsal Ejderler olayı var.
Dialogue: 0,0:15:08.53,0:15:12.09,Main,,0,0,0,,Tüm bunların eşi benzeri görülmemişti!
Dialogue: 0,0:15:13.73,0:15:19.60,Main,,0,0,0,,Şimdiyse 20 yıl önceki iğrenç\NAltın Aslan'dan beri...
Dialogue: 0,0:15:19.60,0:15:26.60,Main,,0,0,0,,...hiç istila ve kaçış olmadan\Nbinlerce mahkumu barındırmış olan...
Dialogue: 0,0:15:27.89,0:15:37.01,Main,,0,0,0,,...delinmez Impel Down'ın\Nitibarını mahveden çocuk...
Dialogue: 0,0:15:37.01,0:15:40.12,Main,,0,0,0,,...niye senin torunun, Garp?!
Dialogue: 0,0:15:41.09,0:15:44.09,Main,,0,0,0,,Etkileyici! Torunumdan\Ndaha azını beklemezdim!
Dialogue: 0,0:15:45.07,0:15:46.93,Main,,0,0,0,,Lanet olası Bartholomew Kuma.
Dialogue: 0,0:15:46.93,0:15:51.23,Main,,0,0,0,,Sabaody Takımadaları'nda Hasır Şapkalar'ın\Nişini bitirdiğini iddia etmişti.
Dialogue: 0,0:15:51.23,0:15:53.53,Main,,0,0,0,,Yalan söylediğini biliyordum!
Dialogue: 0,0:15:53.77,0:15:57.77,Main,,0,0,0,,Bir Shichibukai'nun sözüne\Ngüvenmeyeceksin, değil mi?
Dialogue: 0,0:15:53.77,0:15:57.77,Note,,0,0,0,,Shichibukai - Denizin Yedi Savaş Ağası
Dialogue: 0,0:15:57.77,0:16:02.04,Main,,0,0,0,,Yine de donanmanın savunmasını\Nnasıl aştığını merak ediyorum...
Dialogue: 0,0:16:02.54,0:16:04.78,Main,,0,0,0,,Belki de oradan uçmuştur.
Dialogue: 0,0:16:05.13,0:16:10.11,Main,,0,0,0,,Şakayı bırak! Donanma\Nkahramanı olmasaydın...
Dialogue: 0,0:16:10.11,0:16:14.62,Main,,0,0,0,,...ailenin yaptıklarından\Nseni sorumlu tutardım Garp!
Dialogue: 0,0:16:15.75,0:16:21.63,Main,,0,0,0,,Durum, suçu sadece tek bir yaşlı adamın\Nüstlenemeyeceği kadar vahim!
Dialogue: 0,0:16:23.29,0:16:24.80,Main,,0,0,0,,Gülünecek bir şey değil!
Dialogue: 0,0:16:25.37,0:16:28.69,Main,,0,0,0,,Bütün bunlar donanmanın sarsaklığından!
Dialogue: 0,0:16:28.69,0:16:33.30,Main,,0,0,0,,Tsuru ve benim, sonuçlarla başa çıkmak\Niçin ne kadar çalıştığımızın farkında mısın?!
Dialogue: 0,0:16:33.30,0:16:35.81,Main,,0,0,0,,Hey! Onlar benim! Geri ver!
Dialogue: 0,0:16:35.81,0:16:37.31,Main,,0,0,0,,Sessiz ol!
Dialogue: 0,0:16:50.22,0:16:51.72,Main,,0,0,0,,SICAK!
Dialogue: 0,0:16:53.89,0:16:55.75,Main,,0,0,0,,
Dialogue: 0,0:16:56.10,0:16:59.41,Main,,0,0,0,,Yer kızartma tavası kadar sıcak!
Dialogue: 0,0:17:08.91,0:17:12.48,Main,,0,0,0,,Burası çöl mü? Çok sıcak.
Dialogue: 0,0:17:14.18,0:17:15.81,Main,,0,0,0,,Neden bu kadar sessiz?
Dialogue: 0,0:17:17.25,0:17:21.25,Main,,0,0,0,,Seviye 3... Ah, buraya hiç\Ngelmek istememiştim!
Dialogue: 0,0:17:21.82,0:17:25.82,Main,,0,0,0,,Hasır Şapka! Niye yine bizi de sürükledin?!
Dialogue: 0,0:17:25.82,0:17:27.96,Main,,0,0,0,,Aslan kendinden geçmiş.
Dialogue: 0,0:17:31.29,0:17:36.27,Main,,0,0,0,,Burası mum güçlerine sahip olan\Nbenim için çok acımasız bir yer.
Dialogue: 0,0:17:37.30,0:17:39.14,Main,,0,0,0,,Neyse, yola koyulalım.
Dialogue: 0,0:17:46.52,0:17:48.78,Main,,0,0,0,,Izgara tavuk servis ettiler!
Dialogue: 0,0:17:49.02,0:17:50.11,Main,,0,0,0,,Saçmalama!
Dialogue: 0,0:17:50.41,0:17:55.26,Main,,0,0,0,,Üst kattaki bir kuş kaybolmuş ve aşağı\Ninerken sıcak havada pişmiş olmalı.
Dialogue: 0,0:17:55.49,0:17:56.92,Main,,0,0,0,,Burası o kadar sıcak değil!
Dialogue: 0,0:18:00.83,0:18:02.16,Main,,0,0,0,,Hey, burada ne var?
Dialogue: 0,0:18:07.33,0:18:10.17,Main,,0,0,0,,Ne acınası bir manzara.
Dialogue: 0,0:18:10.45,0:18:18.88,Main,,0,0,0,,Seviye 3'teki mahkumlar, bir zamanlar\Nödülü 50 milyondan fazla olan ünlü suçlulardır.
Dialogue: 0,0:18:19.05,0:18:22.50,Main,,0,0,0,,Sıcaklık buraya altımızdaki\NYakıcı Gazap Cehennemi'nden geliyor.
Dialogue: 0,0:18:22.75,0:18:30.89,Main,,0,0,0,,Neredeyse hiç yiyecek ve su verilmiyor olması\Nburadaki tüm mahkumları yarı ölü hale getiriyor.
Dialogue: 0,0:18:35.89,0:18:39.80,Main,,0,0,0,,Burası Seviye 3, Açlık Cehennemi.
Dialogue: 0,0:18:41.00,0:18:45.54,Main,,0,0,0,,En azından şimdi bu katın niye kumla\Nkaplı olduğunu anlayabilirsiniz.
Dialogue: 0,0:18:46.73,0:18:54.15,Main,,0,0,0,,Muhtemelen altımızdaki kum\Nkurumuş bir mahkumun kalıntılarıdır.
Dialogue: 0,0:18:57.63,0:19:04.12,Main,,0,0,0,,Burada uzun süre kalırsak farkına\Nvarmadan onlardan biri olabiliriz.
Dialogue: 0,0:19:07.59,0:19:11.25,Main,,0,0,0,,Henüz ısıyı terleyerek\Natabiliyorken kaçmalıyız.
Dialogue: 0,0:19:13.35,0:19:15.39,Main,,0,0,0,,O zaman hemen Seviye 4'e gidelim!
Dialogue: 0,0:19:15.39,0:19:16.37,Main,,0,0,0,,ORAYA MI GİDECEKSİN?!
Dialogue: 0,0:19:16.37,0:19:19.21,Main,,0,0,0,,Hey, o yönde değil!\NSoldaki merdivenleri kullanmalıyız.
Dialogue: 0,0:19:19.21,0:19:20.01,Main,,0,0,0,,Öyle mi?
Dialogue: 0,0:19:20.01,0:19:21.87,Main,,0,0,0,,Hayır, sağdaki geçitten aşağı.
Dialogue: 0,0:19:21.87,0:19:23.88,Main,,0,0,0,,Hangisi?!
Dialogue: 0,0:19:27.03,0:19:28.70,Main,,0,0,0,,Niye...
Dialogue: 0,0:19:28.70,0:19:31.29,Main,,0,0,0,,...başladığımız yere geri döndük?!
Dialogue: 0,0:19:31.29,0:19:34.25,Main,,0,0,0,,Umarım en kısa zamanda 4. seviyeye gideriz.
Dialogue: 0,0:19:34.49,0:19:36.79,Main,,0,0,0,,Dediğimiz gibi biz gitmiyoruz!
Dialogue: 0,0:19:37.06,0:19:38.79,Main,,0,0,0,,Bana yolu gösterin!
Dialogue: 0,0:19:38.79,0:19:41.89,Main,,0,0,0,,Ace'i kurtarmama yardım\Nedeceğinizi söylediniz, değil mi?
Dialogue: 0,0:19:41.89,0:19:44.50,Main,,0,0,0,,Bunu asla söylemedik!
Dialogue: 0,0:19:44.50,0:19:48.17,Main,,0,0,0,,Her şeyi olmasını istediğin\Ngibi hayal etmeyi bırak!
Dialogue: 0,0:19:48.17,0:19:49.80,Main,,0,0,0,,Yapacağınızı söylemediniz mi?
Dialogue: 0,0:19:49.80,0:19:51.30,Main,,0,0,0,,Tam yerindeler.
Dialogue: 0,0:19:51.67,0:19:53.40,Main,,0,0,0,,Pekala, ağı çekin!
Dialogue: 0,0:19:53.40,0:19:54.41,Main,,0,0,0,,Anlaşıldı!
Dialogue: 0,0:20:00.67,0:20:02.13,Main,,0,0,0,,Tamam, o zaman yalnız giderim.
Dialogue: 0,0:20:02.77,0:20:03.29,Main,,0,0,0,,
Dialogue: 0,0:20:14.03,0:20:15.28,Main,,0,0,0,,Bu da ne?!
Dialogue: 0,0:20:15.40,0:20:19.10,Main,,0,0,0,,Kahretsin! Bu bir tuzak!\NBizi yakaladılar!
Dialogue: 0,0:20:20.77,0:20:21.94,Main,,0,0,0,,Bu demirden yapılmış!
Dialogue: 0,0:20:21.94,0:20:25.44,Main,,0,0,0,,Kahretsin! Bara Bara Meyvesi\Ngüçlerimi kullanamıyorum!
Dialogue: 0,0:20:25.65,0:20:27.57,Main,,0,0,0,,İçinde Deniz Taşı var!
Dialogue: 0,0:20:27.65,0:20:31.85,Main,,0,0,0,,Kaçmaya çalıştığımız için\Nbize işkence edecekler.
Dialogue: 0,0:20:32.45,0:20:33.95,Main,,0,0,0,,İşimiz bitti.
Dialogue: 0,0:20:34.61,0:20:37.95,Main,,0,0,0,,İstilacı Hasır Şapkalı Luffy ve\Ndiğer ikisi birlikte yakalandı!
Dialogue: 0,0:20:38.13,0:20:39.99,Main,,0,0,0,,"Diğer ikisi" derken ne demek istiyorsun?!
Dialogue: 0,0:20:40.19,0:20:43.69,Main,,0,0,0,,Onları kışkırtma Buggy-kun!
Dialogue: 0,0:20:43.93,0:20:46.09,Main,,0,0,0,,Sonumuz geldi.
Dialogue: 0,0:20:46.49,0:20:49.60,Main,,0,0,0,,Kahretsin! Bu ağı yırtmalıyım!
Dialogue: 0,0:20:49.83,0:20:51.99,Main,,0,0,0,,Gardiyanlar ve Blugoriler geldi!
Dialogue: 0,0:20:52.21,0:20:54.20,Main,,0,0,0,,Onları Deniz Taşı kelepçeleriyle zaptedin!
Dialogue: 0,0:20:54.35,0:20:55.11,Main,,0,0,0,,Anlaşıldı!
Dialogue: 0,0:20:55.81,0:20:58.51,Main,,0,0,0,,Lanet olsun! Lanet olsun! Lanet olsun!
Dialogue: 0,0:21:02.37,0:21:03.35,Main,,0,0,0,,Sen de kimsin?
Dialogue: 0,0:21:03.55,0:21:05.81,Note,,0,0,0,,Saldeath söylenirken, "Ben maymunum"\Nanlamına gelen "saru desu" gibi çıkıyor.
Dialogue: 0,0:21:03.55,0:21:05.81,Main,,0,0,0,,Ben Saldeath.
Dialogue: 0,0:21:05.81,0:21:09.55,Main,,0,0,0,,Öyle mi? Gerçi maymuna benzemiyorsun.
Dialogue: 0,0:21:09.55,0:21:10.25,Main,,0,0,0,,Hayır!
Dialogue: 0,0:21:10.25,0:21:12.25,Main,,0,0,0,,Yanlış anlıyorsun.
Dialogue: 0,0:21:12.25,0:21:14.56,Main,,0,0,0,,Ben Saldeath!
Dialogue: 0,0:21:14.56,0:21:16.55,Main,,0,0,0,,Öyle mi?
Dialogue: 0,0:21:16.55,0:21:19.35,Main,,0,0,0,,YANLIŞ! Biraz kafanı kullan!\NBu benim adım!
Dialogue: 0,0:21:21.37,0:21:22.56,Main,,0,0,0,,Pes et artık.
Dialogue: 0,0:21:23.39,0:21:30.66,Captions,,0,0,270,,{\fad(0,550)}Baş Muhafız\NSaldeath
Dialogue: 0,0:21:23.39,0:21:30.66,Captions,,0,0,30,,{\fad(0,550)}(Blugori Komutanı)
Dialogue: 0,0:21:23.39,0:21:25.51,Main,,0,0,0,,{\an8}Karşı koymak faydasız.
Dialogue: 0,0:21:25.71,0:21:30.79,Main,,0,0,0,,{\an8}Zaten bu hapishaneden\Nkaçmak için hiç şansınız yoktu.
Dialogue: 0,0:21:32.28,0:21:35.37,Main,,0,0,0,,Benim tarafımdan yakalandığınız\Niçin şanslısınız.
Dialogue: 0,0:21:35.78,0:21:41.21,Main,,0,0,0,,Çünkü alt seviyelerde dört\Nşeytan muhafız bekliyor.
Dialogue: 0,0:21:41.42,0:21:42.05,Main,,0,0,0,,Ne?!
Dialogue: 0,0:21:50.27,0:21:54.63,Main,,0,0,0,,Doğru, onlara ya da hapishane\Nmüdürüne rastlamak istemiyorum.
Dialogue: 0,0:21:57.36,0:21:59.03,Main,,0,0,0,,Beyaz istiridye!
Dialogue: 0,0:21:59.03,0:22:00.65,Main,,0,0,0,,Baş Gardiyan!
Dialogue: 0,0:22:00.65,0:22:02.98,Main,,0,0,0,,Spagetti çorbası!
Dialogue: 0,0:22:03.14,0:22:05.35,Main,,0,0,0,,Şimdi de makarnaları\Nisimlendirmeye başladı!
Dialogue: 0,0:22:06.92,0:22:09.04,Main,,0,0,0,,Ezileceğiz!
Dialogue: 0,0:22:09.04,0:22:10.21,Main,,0,0,0,,Spagetti!
Dialogue: 0,0:22:10.21,0:22:11.61,Main,,0,0,0,,Sfenks uyandı!
Dialogue: 0,0:22:11.94,0:22:13.94,Main,,0,0,0,,Durum kötü! Ağ parçalanacak!
Dialogue: 0,0:22:14.27,0:22:18.05,Main,,0,0,0,,O üçünün kaçmasına izin veremeyiz,\NÖzellikle de Hasır Şapka'nın!
Dialogue: 0,0:22:19.75,0:22:24.12,Main,,0,0,0,,Kızarmış erişte!
Dialogue: 0,0:22:24.12,0:22:25.93,Main,,0,0,0,,Eriştelere geri döndü!
Dialogue: 0,0:22:25.93,0:22:28.06,Main,,0,0,0,,Bir aşamadan geçiyor olmalı!
Dialogue: 0,0:22:28.06,0:22:29.59,Main,,0,0,0,,Başardık!
Dialogue: 0,0:22:32.19,0:22:34.45,Main,,0,0,0,,Bu harika! Şimdi kaçabiliriz!
Dialogue: 0,0:22:34.45,0:22:35.39,Main,,0,0,0,,Yakalayın onları!
Dialogue: 0,0:22:38.71,0:22:40.21,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:22:40.37,0:22:42.37,Main,,0,0,0,,{\fad(150,150)}...Makineli!
Dialogue: 0,0:22:52.61,0:22:54.28,Main,,0,0,0,,Ah? O ikisi nereye gitti?
Dialogue: 0,0:22:56.77,0:22:58.54,Main,,0,0,0,,Acele et, Bay 3!
Dialogue: 0,0:22:58.67,0:23:01.39,Main,,0,0,0,,Bu sıcaktan dolayı hızlı\Nhareket edemiyorum...
Dialogue: 0,0:23:02.63,0:23:05.06,Main,,0,0,0,,Ah! Ağa tırmanmışlar!
Dialogue: 0,0:23:06.89,0:23:08.29,Main,,0,0,0,,Hasır Şapka!
Dialogue: 0,0:23:08.60,0:23:13.07,Main,,0,0,0,,Ace'i görünce benden selam ve hayatta\Nkalırsa onunla yine içmek istediğimi söyle.
Dialogue: 0,0:23:14.59,0:23:18.41,Main,,0,0,0,,Bizim için iyi bir canlı yem ol, ahmak!
Dialogue: 0,0:23:19.20,0:23:22.58,Main,,0,0,0,,Sizin iyi olduğunuzu gördüğüme sevindim ama...\NTamam! Sonra görüşürüz!
Dialogue: 0,0:23:22.58,0:23:25.12,Main,,0,0,0,,Buraya kadar gelmeme yardım\Nettiğiniz için teşekkürler!
Dialogue: 0,0:23:25.12,0:23:27.13,Main,,0,0,0,,Ah! Ne kadar tatlı!
Dialogue: 0,0:23:27.13,0:23:29.09,Main,,0,0,0,,Acı veriyor... Kalbim acı içinde!
Dialogue: 0,0:23:29.38,0:23:32.62,Main,,0,0,0,,Tedbiri elden bırakmayın!\NOnun ödülü 300 milyon!
Dialogue: 0,0:23:38.45,0:23:40.13,Main,,0,0,0,,Fırsatımız varken kaçalım!
Dialogue: 0,0:23:40.39,0:23:41.79,Main,,0,0,0,,Anlaşıldı!
Dialogue: 0,0:23:43.69,0:23:46.41,Main,,0,0,0,,Hepinizle dövüşecek zamanım yok!
Dialogue: 0,0:23:46.85,0:23:49.21,Main,,0,0,0,,Karabuğday eriştesi!
Dialogue: 0,0:23:49.23,0:23:51.29,Main,,0,0,0,,Eyvah! O hâlâ burada mı?!
Dialogue: 0,0:23:53.77,0:23:55.07,Main,,0,0,0,,Pislik!
Dialogue: 0,0:23:58.87,0:24:00.51,Main,,0,0,0,,Kaçıyor! Yakalayın!
Dialogue: 0,0:24:00.62,0:24:02.75,Main,,0,0,0,,Aşağı inen merdivenler... Aşağı\Ninen merdivenler nerede?!
Dialogue: 0,0:24:14.27,0:24:15.45,Main,,0,0,0,,Çok sıcak...
Dialogue: 0,0:24:16.49,0:24:20.61,Main,,0,0,0,,Burada güvendeyiz! İstediğimiz gibi\NHasır Şapka'nın peşindeler.
Dialogue: 0,0:24:20.77,0:24:23.49,Main,,0,0,0,,Yukarı çıkan merdiveni kapattılar.
Dialogue: 0,0:24:23.63,0:24:27.43,Main,,0,0,0,,Sırf burada kalmak bile işkence.
Dialogue: 0,0:24:27.43,0:24:31.15,Secondary,,0,0,0,,Bir, iki, bayılıyor!
Dialogue: 0,0:24:31.31,0:24:34.96,Secondary,,0,0,0,,Bir, iki, hadi!
Dialogue: 0,0:24:35.07,0:24:38.99,Secondary,,0,0,0,,Bir, iki, bayılıyor!
Dialogue: 0,0:24:35.23,0:24:36.95,Secondary,,0,0,0,,Kim şarkı söylüyor?
Dialogue: 0,0:24:39.27,0:24:42.45,Secondary,,0,0,0,,Bir, iki, hadi!
Dialogue: 0,0:24:42.91,0:24:45.99,Main,,0,0,0,,Bir, iki, bayılıyor!
Dialogue: 0,0:24:46.59,0:24:50.27,Secondary,,0,0,0,,Bir, iki, hadi!
Dialogue: 0,0:24:51.95,0:24:57.78,Main,,0,0,0,,Bu dünya kadınlardan ve\Nerkeklerden kurulmuştur!
Dialogue: 0,0:24:58.21,0:25:03.39,Main,,0,0,0,,Ama bir *okamaysan\Nikisinden de biraz olursun!
Dialogue: 0,0:25:03.39,0:25:07.25,Main,,0,0,0,,Bu yüzden en iyisi biziz!
Dialogue: 0,0:25:06.75,0:25:08.51,Secondary,,0,0,0,,En iyisi!
Dialogue: 0,0:25:07.75,0:25:09.72,Main,,0,0,0,,En iyisi!
Dialogue: 0,0:25:09.02,0:25:10.72,Secondary,,0,0,0,,En iyisi!
Dialogue: 0,0:25:09.91,0:25:13.06,Main,,0,0,0,,Okama yolu! En iyisi!
Dialogue: 0,0:25:12.55,0:25:14.11,Secondary,,0,0,0,,En iyisi!
Dialogue: 0,0:25:13.56,0:25:15.86,Main,,0,0,0,,En iyisi!
Dialogue: 0,0:25:14.86,0:25:16.36,Secondary,,0,0,0,,En iyisi!
Dialogue: 0,0:25:16.55,0:25:19.31,Main,,0,0,0,,Okama yolu!
Dialogue: 0,0:25:19.56,0:25:24.10,Main,,0,0,0,,Okama yolu!
Dialogue: 0,0:25:24.60,0:25:26.33,Main,,0,0,0,,İyi iş çıkarıyorsunuz!
Dialogue: 0,0:25:26.90,0:25:31.14,Secondary,,0,0,0,,Dönüyorum, dönüyorum, dönüyorum,\Nzamanın dalgalarına yakalanmış gibi!
Dialogue: 0,0:25:31.14,0:25:31.83,Main,,0,0,0,,Bu taraftan!
Dialogue: 0,0:25:33.41,0:25:36.11,Main,,0,0,0,,Bekle! Beni dinle! Bu...
Dialogue: 0,0:25:40.32,0:25:43.29,Main,,0,0,0,,Siz! O kadar yorulmuş olamazsınız!
Dialogue: 0,0:25:43.83,0:25:46.26,Main,,0,0,0,,Bu boğucu sıcak hiçbir şey!
Dialogue: 0,0:25:46.63,0:25:50.26,Main,,0,0,0,,Daha da boğucu olabilirim!
Dialogue: 0,0:25:55.77,0:25:58.37,Main,,0,0,0,,Ah, bu Bay 3 değil mi?
Dialogue: 0,0:26:01.94,0:26:03.81,Main,,0,0,0,,Demek gerçekten sensin.
Dialogue: 0,0:26:09.97,0:26:12.65,Main,,0,0,0,,NE?! BAY 3?!
Dialogue: 0,0:26:13.13,0:26:16.61,Main,,0,0,0,,Hey, sen! Burada ne yapıyorsun?
Dialogue: 0,0:26:16.93,0:26:20.13,Main,,0,0,0,,Parmaklıkların arkasındasın\Nyani yakalandın mı?!
Dialogue: 0,0:26:20.52,0:26:23.97,Main,,0,0,0,,Hayır, hayır. Yakalanan benim!
Dialogue: 0,0:26:23.97,0:26:28.11,Main,,0,0,0,,O kadar şaşırdım ki "Okama Yumruk Stili"nden\Nbir hareketle ile iki kez kontrol etmem gerekti:
Dialogue: 0,0:26:28.11,0:26:31.77,Main,,0,0,0,,"O Sonbahar Gecesi Rüyasına Geri Dönmek"!
Dialogue: 0,0:26:32.27,0:26:36.27,Main,,0,0,0,,Hey... Bu tuhaf yaratık da neyin nesi?
Dialogue: 0,0:26:36.61,0:26:39.54,Main,,0,0,0,,Onu dışarı çıkarmadığımızdan emin olalım.
Dialogue: 0,0:26:39.54,0:26:45.32,Main,,0,0,0,,Ne diyorsun?! Hemen çıkarın beni buradan!
Dialogue: 0,0:26:46.88,0:26:51.32,Main,,0,0,0,,Herkes alarm durumundayken\Nsavunmamızı nasıl geçti?
Dialogue: 0,0:26:51.73,0:26:54.15,Main,,0,0,0,,Sadece bir tane davetsiz\Nmisafir vardı...
Dialogue: 0,0:26:54.15,0:26:58.52,Main,,0,0,0,,...ama Ace'i serbest bırakmayı başarırsa \NImpel Down'a utanç getirecek...
Dialogue: 0,0:26:58.54,0:27:02.91,Main,,0,0,0,,...ve Dünya Hükümeti\Ntüm dünyada alay konusu olacak!
Dialogue: 0,0:27:02.91,0:27:04.60,Main,,0,0,0,,O hapishaneye girip...
Dialogue: 0,0:27:05.77,0:27:10.11,Main,,0,0,0,,Hasır Şapkalı Luffy'i yakalayıp, \NDonanma Karargâhı'nın şerefini geri kazanacağız!
Dialogue: 0,0:27:14.31,0:27:15.48,Main,,0,0,0,,Biraz bekleyin canlarım.
Dialogue: 0,0:27:18.08,0:27:19.32,Main,,0,0,0,,S-Sen kimsin?
Dialogue: 0,0:27:24.16,0:27:26.88,Main,,0,0,0,,Ben Sadi-chan, insanlara\Nişkence etmeyi severim.
Dialogue: 0,0:27:26.86,0:27:33.85,Captions,,0,0,275,,{\fad(1000,1000)}Impel Down\NBaş Gardiyan
Dialogue: 0,0:27:26.86,0:27:33.85,Captions,,0,0,30,,{\fad(1000,1000)}Sadi-chan
Dialogue: 0,0:27:27.36,0:27:31.12,Main,,0,0,0,,{\an8}Davetsiz bir misafir tarafından ihlal\Nedildikten sonra donanmadan yardım almak...
Dialogue: 0,0:27:31.12,0:27:35.00,Main,,0,0,0,,{\an8}Impel Down'ın adını daha da\Nlekelemekten başka bir işe yaramaz!
Dialogue: 0,0:27:36.27,0:27:39.10,Main,,0,0,0,,Kendinden söz ederken -chan\Neki kullanıyor. Ciddi mi bu?
Dialogue: 0,0:27:39.36,0:27:40.32,Main,,0,0,0,,Sessizlik!
Dialogue: 0,0:27:41.98,0:27:43.60,Main,,0,0,0,,Bana "Sadi-chan" diye hitap et!
Dialogue: 0,0:27:51.52,0:27:53.92,Main,,0,0,0,,Oh, çığlık seslerini çok seviyorum!
Dialogue: 0,0:27:55.36,0:27:56.22,Main,,0,0,0,,Sürtük!
Dialogue: 0,0:27:56.38,0:28:00.09,Main,,0,0,0,,Dur! Bize ihtiyaç olmadığını mı söylüyorsun?
Dialogue: 0,0:28:00.34,0:28:03.94,Main,,0,0,0,,Evet. Bu hapishane\Ncehennemdeki bir labirenttir.
Dialogue: 0,0:28:03.94,0:28:07.30,Main,,0,0,0,,Yolunuzu bilmezseniz hiç yardımınız olmaz.
Dialogue: 0,0:28:08.17,0:28:11.94,Main,,0,0,0,,Siz sadece burada kalıp \Ndış savunmamızı güçlendirmelisiniz.
Dialogue: 0,0:28:13.20,0:28:18.21,Main,,0,0,0,,Şimdi buradan tek çıkış yolu olan\Naçılır köprüyü kaldıracağız ve...
Dialogue: 0,0:28:19.20,0:28:21.41,Main,,0,0,0,,...Impel Down'ı tamamen kapatacağız.
Dialogue: 0,0:28:21.76,0:28:25.42,Main,,0,0,0,,Endişelenmeyin. \NBu su altı hapishanesinden...
Dialogue: 0,0:28:26.56,0:28:28.59,Main,,0,0,0,,...kaçış yok.
Dialogue: 0,0:28:30.58,0:28:33.46,Main,,0,0,0,,Anlaşıldı. Dışarıyı koruyacağız.
Dialogue: 0,0:28:33.89,0:28:35.79,Main,,0,0,0,,Evet, iyi bir çocuk olun.
Dialogue: 0,0:28:39.16,0:28:40.00,Main,,0,0,0,,Koala?
Dialogue: 0,0:28:42.24,0:28:44.04,Main,,0,0,0,,Ne... Şaka mı yapıyorsun?
Dialogue: 0,0:28:44.22,0:28:45.34,Main,,0,0,0,,Bir koala...
Dialogue: 0,0:28:47.18,0:28:48.32,Main,,0,0,0,,Koala?
Dialogue: 0,0:28:48.52,0:28:49.36,Main,,0,0,0,,Koala.
Dialogue: 0,0:29:02.94,0:29:05.44,Main,,0,0,0,,Impel Down tamamen kapatıldı.
Dialogue: 0,0:29:19.12,0:29:20.67,Main,,0,0,0,,Hannyabal?!
Dialogue: 0,0:29:21.17,0:29:23.67,Main,,0,0,0,,Magellan da burada... Neler oluyor?
Dialogue: 0,0:29:30.11,0:29:33.12,Main,,0,0,0,,Özel bir ziyaretçin var, Ace.
Dialogue: 0,0:29:34.62,0:29:36.62,Main,,0,0,0,,Kim geldi dersin?
Dialogue: 0,0:29:37.12,0:29:41.42,Main,,0,0,0,,Jinbe! Sen bile onunla daha\Nönce hiç tanışmadın,...
Dialogue: 0,0:29:41.42,0:29:43.62,Main,,0,0,0,,...bu yüzden Ace'in onun kim\Nolduğunu tahmin etmesine imkan yok.
Dialogue: 0,0:29:44.62,0:29:50.27,Main,,0,0,0,,Çok az kişi görmüş olsa da adı biliniyor!\NSavaşçı kabilesi olan Kuja'ya liderlik ediyor.
Dialogue: 0,0:29:50.57,0:29:52.80,Main,,0,0,0,,Shichibukai'lerden biri.
Dialogue: 0,0:29:53.30,0:29:57.31,Main,,0,0,0,,Güçlü, onurlu ve dünyadaki en güzel kadın!\NKorsan İmparatoriçe...
Dialogue: 0,0:29:57.31,0:29:59.61,Main,,0,0,0,,...Boa Hancock!
Dialogue: 0,0:30:03.11,0:30:07.45,Main,,0,0,0,,Yaşasın, yaşasın Hancock! Hancock-sama!
Dialogue: 0,0:30:07.45,0:30:12.62,Main,,0,0,0,,Hey, tanrıça! Müdür olunca\Nbenimle evlenir misin?!
Dialogue: 0,0:30:13.02,0:30:14.23,Main,,0,0,0,,Lütfen!
Dialogue: 0,0:30:15.56,0:30:17.64,Main,,0,0,0,,Acıdı! Şimdi gerçekten\NMüdür olmak istiyorum!
Dialogue: 0,0:30:17.64,0:30:20.80,Main,,0,0,0,,Ah! Yanlış dedim! Demek istediğim, müdür\Ntarafından dövülmek gerçekten acıtıyor!
Dialogue: 0,0:30:20.80,0:30:23.14,Main,,0,0,0,,Ne yapıyorsun?!
Dialogue: 0,0:30:23.27,0:30:28.14,Main,,0,0,0,,Vay! Gerçekten mi? O kadar güzel ki!
Dialogue: 0,0:30:28.47,0:30:32.30,Main,,0,0,0,,Yani Kuja klanının Yılan Prensesi o mu?\NArkanı dön!
Dialogue: 0,0:30:32.48,0:30:34.12,Secondary,,0,0,0,,Hancock-chan!
Dialogue: 0,0:30:34.12,0:30:37.32,Secondary,,0,0,0,,Şuna bakın! Ne kadar seksi!
Dialogue: 0,0:30:37.32,0:30:39.82,Secondary,,0,0,0,,Hey, güzel bayan! Hücremize gel!
Dialogue: 0,0:30:39.82,0:30:42.52,Secondary,,0,0,0,,Seni nazikçe seveceğiz!
Dialogue: 0,0:30:43.16,0:30:48.09,Secondary,,0,0,0,,Çok güzel kokuyor! \NKadınlar Adası'na gitmek istiyorum!
Dialogue: 0,0:30:48.09,0:30:52.00,Secondary,,0,0,0,,Kadınlardan başka bir şey yok.\NEminim hepsi de çıplaktır!
Dialogue: 0,0:30:57.42,0:30:59.57,Main,,0,0,0,,Benden ne istiyorsun?
Dialogue: 0,0:31:00.32,0:31:03.71,Main,,0,0,0,,Hiçbir şey. Sadece seni kendi\Ngözlerimle görmek istedim.
Dialogue: 0,0:31:04.40,0:31:08.71,Main,,0,0,0,,Katılmak üzere olduğum\Nsavaşın tetikleyicisi olan adam.
Dialogue: 0,0:31:09.26,0:31:10.91,Main,,0,0,0,,O zaman bakmaya değer miyim?
Dialogue: 0,0:31:11.18,0:31:14.92,Secondary,,0,0,0,,Boa Hancock! \NBizi görmezden mi geliyorsun?!
Dialogue: 0,0:31:15.12,0:31:16.94,Secondary,,0,0,0,,Buraya gel!
Dialogue: 0,0:31:18.89,0:31:24.26,Main,,0,0,0,,Her zaman hiçbir çağrıya uymayan,\Niradesi güçlü bir imparatoriçe oldun...
Dialogue: 0,0:31:24.26,0:31:27.03,Main,,0,0,0,,Ama bu savaşa mı katılıyorsun?
Dialogue: 0,0:31:27.20,0:31:30.03,Main,,0,0,0,,Shichibukai konumunu korumayı\Nbu kadar çok mu istiyorsun?!
Dialogue: 0,0:31:31.90,0:31:35.34,Main,,0,0,0,,Demek sen Jinbei'sin. Bana hırlama.
Dialogue: 0,0:31:35.34,0:31:37.71,Main,,0,0,0,,Bayan! Hey, bayan!
Dialogue: 0,0:31:37.71,0:31:40.91,Main,,0,0,0,,Burada konuşuyoruz! Sessiz olun!
Dialogue: 0,0:31:40.91,0:31:44.58,Main,,0,0,0,,Kapa çeneni Magellan, \Nseni 24 saat ishal olan adam!
Dialogue: 0,0:31:45.04,0:31:46.43,Main,,0,0,0,,Evet, bu doğru!
Dialogue: 0,0:31:46.58,0:31:48.09,Main,,0,0,0,,Hey, Yılan Prenses!
Dialogue: 0,0:31:48.09,0:31:51.09,Main,,0,0,0,,Kadınlar Adası'nın erkek özlemi\Nçekmediğinden emin misin?!
Dialogue: 0,0:31:51.09,0:31:54.19,Main,,0,0,0,,Hey! Bana müdürlüğü devret!
Dialogue: 0,0:31:54.19,0:31:55.56,Main,,0,0,0,,Müdür Yardımcısı...
Dialogue: 0,0:31:56.36,0:31:57.56,Main,,0,0,0,,Siz...
Dialogue: 0,0:31:57.56,0:31:58.80,Main,,0,0,0,,Bize bakıyor!
Dialogue: 0,0:31:59.20,0:32:01.53,Main,,0,0,0,,...terbiyesiz seslerle benimle\Nalay edip duruyorsunuz.
Dialogue: 0,0:32:02.52,0:32:05.07,Main,,0,0,0,,Çok korkuyorum!
Dialogue: 0,0:32:05.24,0:32:07.77,Main,,0,0,0,,Aman Tanrım! Karşı koyamıyorum!
Dialogue: 0,0:32:08.10,0:32:12.38,Main,,0,0,0,,Daha ne kadar mükemmel olabilir?!\NBayanı bize ver, ishal adam!
Dialogue: 0,0:32:12.61,0:32:17.21,Main,,0,0,0,,Burası dünyanın en aşağılık yeri olmalı!\NBu insanlar beni tiksindiriyor.
Dialogue: 0,0:32:17.21,0:32:22.22,Main,,0,0,0,,Mahkumların sana "ishal adam" demesini\Nyanlarına bırakacak mısın, Müdür?
Dialogue: 0,0:32:22.56,0:32:26.22,Main,,0,0,0,,Sanırım çok paslanmışsın, artık müdür\Nolmaya bile uygun değil misin?
Dialogue: 0,0:32:26.22,0:32:28.23,Main,,0,0,0,,Vay! O karşı konulamaz!
Dialogue: 0,0:32:28.23,0:32:30.43,Main,,0,0,0,,Yazıklar olsun, ishal adam!
Dialogue: 0,0:32:32.43,0:32:33.66,Main,,0,0,0,,Yine de...
Dialogue: 0,0:32:33.66,0:32:36.53,Main,,0,0,0,,Onu almama izin ver, ishal adam!
Dialogue: 0,0:32:36.53,0:32:39.00,Main,,0,0,0,,İshal adam! Bize Hancock'u ver!
Dialogue: 0,0:32:40.00,0:32:44.88,Main,,0,0,0,,Doğru, bu küstahlığa göz yummayacağım!
Dialogue: 0,0:32:51.72,0:32:53.95,Main,,0,0,0,,M-Müdür Bey, dur bir dakika!
Dialogue: 0,0:32:53.95,0:32:57.29,Main,,0,0,0,,Bu bize de zarar verecek! HAYIR!
Dialogue: 0,0:33:03.09,0:33:05.06,Main,,0,0,0,,Fazla ileri gitmeyin, pislikler!
Dialogue: 0,0:33:05.34,0:33:07.08,Main,,0,0,0,,Eyvah!
Dialogue: 0,0:33:09.23,0:33:12.50,Main,,0,0,0,,Galiba bu hapishanenin patronunun...
Dialogue: 0,0:33:14.12,0:33:17.64,Main,,0,0,0,,...kim olduğunu size öğretmem lazım!
Dialogue: 0,0:33:26.20,0:33:27.60,Main,,0,0,0,,Ne yapıyor bu?!
Dialogue: 0,0:33:27.60,0:33:29.49,Main,,0,0,0,,Kes şunu, Magellan!
Dialogue: 0,0:33:29.49,0:33:33.09,Main,,0,0,0,,Hey, sersem! Şaka yapıyorsun, değil mi?!\NKes şunu!
Dialogue: 0,0:33:50.96,0:33:53.92,Main,,0,0,0,,Lanet olası! Gerçekten yaptı!
Dialogue: 0,0:33:57.29,0:33:59.96,Main,,0,0,0,,Faydasız! Öleceksin!
Dialogue: 0,0:34:01.02,0:34:04.25,Main,,0,0,0,,P-Panzehir! Bana panzehir verin!\NLanet olsun!
Dialogue: 0,0:34:10.16,0:34:17.90,Main,,0,0,0,,Her birinizi anında öldürme yetkisine\Nve gücüne sahibi olduğumu unutmayın.
Dialogue: 0,0:34:26.11,0:34:30.31,Main,,0,0,0,,Pekâlâ, Hancock-dono.\NArtık özgürce konuşabilirsiniz.
Dialogue: 0,0:34:30.31,0:34:31.82,Main,,0,0,0,,Burada işim bitti.
Dialogue: 0,0:34:32.41,0:34:34.79,Main,,0,0,0,,Hey! Demin söylediğin... doğru muydu?!
Dialogue: 0,0:34:34.79,0:34:37.35,Main,,0,0,0,,Yalan söylemek için sebebim yok.
Dialogue: 0,0:34:37.87,0:34:38.84,Main,,0,0,0,,Evet.
Dialogue: 0,0:34:39.56,0:34:42.49,Main,,0,0,0,,Kızabileceğinden korkuyordu.
Dialogue: 0,0:34:44.07,0:34:45.66,Main,,0,0,0,,Hepsi bu muydu?
Dialogue: 0,0:34:46.57,0:34:48.67,Main,,0,0,0,,Ne hakkında konuşuyorlardı?
Dialogue: 0,0:34:48.67,0:34:52.37,Main,,0,0,0,,Bilmem. Senden kaçmakla çok meşguldüm.
Dialogue: 0,0:34:54.05,0:34:55.61,Main,,0,0,0,,Ace-san.
Dialogue: 0,0:34:56.39,0:34:59.04,Main,,0,0,0,,O kadın sana ne dedi?
Dialogue: 0,0:35:02.51,0:35:06.05,Main,,0,0,0,,Kardeşimin buraya geldiğini söyledi.
Dialogue: 0,0:35:06.05,0:35:10.55,Main,,0,0,0,,Ne?! Bahsedip durduğun\NHasır Şapkalı çocuk mu?!
Dialogue: 0,0:35:10.55,0:35:12.02,Main,,0,0,0,,Delilik bu!
Dialogue: 0,0:35:16.36,0:35:20.96,Main,,0,0,0,,Ha? Yukarı çıkmaya ne zaman başladım?\NAşağı inmeye çalışıyordum.
Dialogue: 0,0:35:20.96,0:35:24.84,Main,,0,0,0,,Ama sanırım devam edersem,\Nbir noktada aşağı doğru gidecek!
Dialogue: 0,0:35:25.34,0:35:27.30,Main,,0,0,0,,Acıktım!
Dialogue: 0,0:35:27.30,0:35:30.01,Main,,0,0,0,,Onu bulduk. Sektör C'ye giriyor.
Dialogue: 0,0:35:32.31,0:35:33.81,Main,,0,0,0,,Evet, görüyorum.
Dialogue: 0,0:35:45.86,0:35:48.09,Main,,0,0,0,,Daha fazla Deniz Taşı ağı, ha?
Dialogue: 0,0:35:48.86,0:35:50.73,Main,,0,0,0,,Çok yakındı!
Dialogue: 0,0:35:56.13,0:35:58.03,Main,,0,0,0,,Eyvah! Aslan?!
Dialogue: 0,0:35:58.54,0:35:59.77,Main,,0,0,0,,K-Kahretsin!
Dialogue: 0,0:36:03.47,0:36:05.28,Main,,0,0,0,,Dur bakalım, aslan!
Dialogue: 0,0:36:09.78,0:36:11.48,Main,,0,0,0,,Yardım etmeye geldim!
Dialogue: 0,0:36:14.48,0:36:15.25,Main,,0,0,0,,Zoro?!
Dialogue: 0,0:36:19.38,0:36:21.16,Main,,0,0,0,,Sadece şakaydı!
Dialogue: 0,0:36:23.13,0:36:25.93,Main,,0,0,0,,{\fad(150,150)}Kuğu Arabeski!
Dialogue: 0,0:36:34.52,0:36:36.67,Main,,0,0,0,,Kuğu! Kuğu!
Dialogue: 0,0:36:36.02,0:36:36.67,Main,,0,0,0,,Ha?
Dialogue: 0,0:36:40.02,0:36:43.23,Main,,0,0,0,,Dön, dön... Dönüyorum!
Dialogue: 0,0:36:44.27,0:36:47.61,Main,,0,0,0,,Zoro değil ama sesi tanıdık geliyor...
Dialogue: 0,0:36:49.79,0:36:53.96,Main,,0,0,0,,Uzun zaman oldu, Hasır-chan! Benim!
Dialogue: 0,0:37:01.43,0:37:03.41,Main,,0,0,0,,Bon-chan!
Dialogue: 0,0:37:03.61,0:37:08.71,Main,,0,0,0,,Zoro olmadığın için gerçekten hayal kırıklığına\Nuğradım ama en azından hâlâ hayattasın!
Dialogue: 0,0:37:09.12,0:37:10.99,Main,,0,0,0,,Şimdi! Hasır Şapka'yı yakalayın!
Dialogue: 0,0:37:10.99,0:37:12.43,Main,,0,0,0,,ÇEKİLİN!
Dialogue: 0,0:37:15.31,0:37:20.98,Main,,0,0,0,,Sizi pislikler! Arkadaşıma ne\Nyaptığınızı sanıyorsunuz?!
Dialogue: 0,0:37:24.69,0:37:27.32,Main,,0,0,0,,İşte bu, Sfenks! Hakla onları!
Dialogue: 0,0:37:33.65,0:37:37.61,Main,,0,0,0,,Tamam! Onları bu kadar kötü\Npatakladığımıza göre bir daha gelmezler.
Dialogue: 0,0:37:37.61,0:37:41.77,Main,,0,0,0,,Vahşi bir hayvana ders\Nvermek için sert davranmalısın!
Dialogue: 0,0:37:43.97,0:37:46.11,Main,,0,0,0,,Kızarmış erişteli ekmek...
Dialogue: 0,0:37:46.11,0:37:50.83,Main,,0,0,0,,Hey Bon-chan! Bizim için\Nkendini feda ettikten...
Dialogue: 0,0:37:50.83,0:37:53.15,Main,,0,0,0,,...sonra öldüğünü sandım!
Dialogue: 0,0:37:55.26,0:38:00.16,Main,,0,0,0,,Şakayı bırak! Okamalar asla ölmez!
Dialogue: 0,0:38:00.51,0:38:01.91,Main,,0,0,0,,Dur, bu doğru mu?
Dialogue: 0,0:38:08.11,0:38:11.63,Main,,0,0,0,,{\a6\i1}Bay 2, Bon Kurei'nin güçlerinin açıklaması.
Dialogue: 0,0:38:11.63,0:38:13.73,Main,,0,0,0,,{\a6\i1}Mane Mane meyvesi yemiş olan kopya adamdır.
Dialogue: 0,0:38:13.73,0:38:18.67,Main,,0,0,0,,{\a6\i1}Sağ eliyle yüzüne\Ndokunduğu herkese dönüşebilir.
Dialogue: 0,0:38:18.67,0:38:23.38,Main,,0,0,0,,{\a6\i1}Daha önce Zoro'ya\Ndokunduğu için ona dönüşebildi.
Dialogue: 0,0:38:26.45,0:38:29.37,Main,,0,0,0,,Bir başkası daha kaçmaya çalışıyor.
Dialogue: 0,0:38:29.37,0:38:33.06,Main,,0,0,0,,Daha derine indikçe daha\Nfazla yandaş ediniyor, değil mi?!
Dialogue: 0,0:38:36.39,0:38:40.03,Main,,0,0,0,,Blugori takımı! Sakın bu\Nadamları elinizden kaçırmayın!
Dialogue: 0,0:38:46.40,0:38:51.07,Main,,0,0,0,,Hazır laf açılmışken, Hasır-chan,\NSeviye 5'e gitmek istediğin doğru mu?
Dialogue: 0,0:38:51.25,0:38:54.39,Main,,0,0,0,,Evet. Oraya nasıl gideceğimi\Nsöylemek ister misin?
Dialogue: 0,0:38:54.39,0:38:56.61,Main,,0,0,0,,O zaman sana eşlik edeyim mi?
Dialogue: 0,0:38:56.83,0:39:01.02,Main,,0,0,0,,Sonuçta benim de Seviye 5'te\Ngörüşmek istediğim biri var!
Dialogue: 0,0:39:01.02,0:39:02.52,Main,,0,0,0,,Gerçekten mi?!
Dialogue: 0,0:39:03.09,0:39:04.95,Main,,0,0,0,,Evet, bu yüzden beraber gidelim!
Dialogue: 0,0:39:04.95,0:39:06.02,Main,,0,0,0,,Evet!
Dialogue: 0,0:39:06.99,0:39:08.89,Main,,0,0,0,,Gidelim!
Dialogue: 0,0:39:08.89,0:39:10.36,Main,,0,0,0,,Tamam!
