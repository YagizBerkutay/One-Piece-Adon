100,100,0,0,1,1.5,1.5,8,120,120,18,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:02.14,0:00:05.48,Credits,,100,0,80,,Editor SewilDialogue: 0,0:00:05.48,0:00:08.92,Credits,,100,0,80,,Timer SewilDialogue: 0,0:00:08.92,0:00:14.94,Credits,,100,0,60,,Quality checker Grug FeesoDialogue: 0,0:00:00.00,0:00:10.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:18:14.50,0:18:24.50,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:32:03.00,0:32:13.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:00:21.58,0:00:22.90,Main,,0,0,0,,Kahretsin...Dialogue: 0,0:00:26.14,0:00:27.50,Main,,0,0,0,,Nereye kayboldun?!Dialogue: 0,0:00:29.04,0:00:31.12,Main,,0,0,0,,Burası çok sıcak!Dialogue: 0,0:00:31.12,0:00:32.86,Main,,0,0,0,,Sanki Cehennem'de gibiyiz!Dialogue: 0,0:00:32.86,0:00:34.20,Main,,0,0,0,,Ne... ?! O...?!Dialogue: 0,0:00:34.20,0:00:36.51,Main,,0,0,0,,Tam benim tipim!Dialogue: 0,0:00:36.51,0:00:39.63,Main,,0,0,0,,Sağlıklı, genç ve kusursuz güzellik!Dialogue: 0,0:00:39.63,0:00:41.99,Main,,0,0,0,,Ama dur... Ne?Dialogue: 0,0:00:41.99,0:00:48.13,Main,,0,0,0,,Tüm muhafızları mahveden Okama'ya ne oldu?Dialogue: 0,0:00:48.13,0:00:49.94,Main,,0,0,0,,Ha? Sen ne...Dialogue: 0,0:00:49.94,0:00:51.96,Main,,0,0,0,,Bunun önemi yok, değil mi, koca adam?Dialogue: 0,0:00:51.96,0:00:54.02,Main,,0,0,0,,Bir saniye buraya gel...Dialogue: 0,0:00:54.02,0:00:54.97,Main,,0,0,0,,Eh?Dialogue: 0,0:00:55.36,0:00:58.04,Main,,0,0,0,,Çok terledim, gömleğim tenime yapıştı.Dialogue: 0,0:00:58.04,0:01:00.68,Main,,0,0,0,,Bunu çıkarmama yardım edebilir misin?Dialogue: 0,0:01:01.01,0:01:01.85,Main,,0,0,0,,Hadi ama...Dialogue: 0,0:01:04.48,0:01:06.42,Main,,0,0,0,,Peki kapıyı benim için açabilir misin?!Dialogue: 0,0:01:06.42,0:01:08.19,Main,,0,0,0,,Tabii, elbette!Dialogue: 0,0:01:08.74,0:01:10.44,Main,,0,0,0,,Buyur!Dialogue: 0,0:01:12.75,0:01:16.83,Main,,0,0,0,,Tamam o zaman, bırak da çıkarmana yardım edeyim.Dialogue: 0,0:01:16.83,0:01:19.07,Main,,0,0,0,,Yanında yedek kıyafet var mı?Dialogue: 0,0:01:19.46,0:01:21.19,Main,,0,0,0,,Kandırdım seni!Dialogue: 0,0:01:24.40,0:01:25.59,Main,,0,0,0,,Affedilemez...Dialogue: 0,0:01:25.59,0:01:27.91,Main,,0,0,0,,Okama'nın yaptığı affedilemez!Dialogue: 0,0:01:27.91,0:01:32.63,Main,,0,0,0,,Bunun için müdürü suçlamak hoşuma giderdi ama kurnazlıkla yenilmeye dayanamıyorum!Dialogue: 0,0:01:34.95,0:01:37.88,Main,,0,0,0,,Üstelik müdür olmak istiyorum.Dialogue: 0,0:01:45.68,0:01:47.88,Main,,0,0,0,,Çok fazla zehir kullandım.Dialogue: 0,0:01:47.88,0:01:50.56,Main,,0,0,0,,Midem...Dialogue: 0,0:01:54.14,0:01:56.88,Main,,0,0,0,,Nihayet tüm kargaşayı bastırdık.Dialogue: 0,0:01:56.88,0:02:01.70,Main,,0,0,0,,Tüm mahkûmları hücrelerine geri koyduk ve çalınan anahtarları da aldık ama...Dialogue: 0,0:02:01.70,0:02:04.02,Main,,0,0,0,,...birkaç tanesi eksik.Dialogue: 0,0:02:04.02,0:02:06.45,Main,,0,0,0,,Bu gerçekten can sıkıcı.Dialogue: 0,0:02:06.45,0:02:08.85,Main,,0,0,0,,Nasıl olur da...Dialogue: 0,0:02:08.85,0:02:09.79,Main,,0,0,0,,...onu bulamazsınız?!Dialogue: 0,0:02:11.30,0:02:13.32,Main,,0,0,0,,Hemen onu bana getirin, canlı olarak!Dialogue: 0,0:02:13.32,0:02:15.88,Main,,0,0,0,,Okama mahkum hiç şüphesiz...Dialogue: 0,0:02:16.64,0:02:17.67,Main,,0,0,0,,...bu katta!Dialogue: 0,0:02:17.67,0:02:18.30,Main,,0,0,0,,Dialogue: 0,0:02:19.14,0:02:23.26,Main,,0,0,0,,Zaman geçtikçe Bay 2 Bon Kurei kendine gelir...Dialogue: 0,0:02:27.20,0:02:30.08,Main,,0,0,0,,Ah, demek sonunda uyandın, kardeş!Dialogue: 0,0:02:30.08,0:02:32.40,Main,,0,0,0,,Epeydir uyuyordun. Bir şeyler içmek ister misin?Dialogue: 0,0:02:36.56,0:02:38.95,Main,,0,0,0,,Newkama için şerefe!Dialogue: 0,0:02:39.41,0:02:40.49,Main,,0,0,0,,Şerefe!Dialogue: 0,0:02:40.85,0:02:42.47,Main,,0,0,0,,Ekranlardan her şeyi gördük.Dialogue: 0,0:02:42.47,0:02:46.00,Main,,0,0,0,,İsyanınız gerçekten görülmeye değerdi!Dialogue: 0,0:02:46.36,0:02:48.17,Main,,0,0,0,,Burası da ne böyle?Dialogue: 0,0:02:48.75,0:02:50.08,Main,,0,0,0,,Seni koltuğuna götüreyim.Dialogue: 0,0:02:50.08,0:02:52.46,Main,,0,0,0,, Hangi kattan geldin?Dialogue: 0,0:02:52.46,0:02:54.55,Main,,0,0,0,,Bol bol yiyeceğimiz var!Dialogue: 0,0:02:54.55,0:02:56.35,Main,,0,0,0,,Açlıktan ölüyor olmalısın.Dialogue: 0,0:02:57.52,0:02:59.51,Main,,0,0,0,,Burası neresi? Hasır-chan nerede?!Dialogue: 0,0:03:01.18,0:03:04.67,Main,,0,0,0,,Dış dünyaya kaçtığını mı sanıyorsun?Dialogue: 0,0:03:04.67,0:03:06.20,Main,,0,0,0,,Endişelenme.Dialogue: 0,0:03:06.20,0:03:08.10,Main,,0,0,0,,Hâlâ Impel Down'dayız.Dialogue: 0,0:03:08.85,0:03:10.88,Main,,0,0,0,,Hiç de bile!Dialogue: 0,0:03:10.88,0:03:12.65,Main,,0,0,0,,Kimse mahkûm kıyafeti giymiyor.Dialogue: 0,0:03:12.65,0:03:15.97,Main,,0,0,0,,Herkes leziz yemekler yiyip içki içiyor.Dialogue: 0,0:03:15.97,0:03:17.49,Main,,0,0,0,,Cennet mi burası?!Dialogue: 0,0:03:17.49,0:03:19.45,Main,,0,0,0,,Evet! Ben...Dialogue: 0,0:03:20.27,0:03:24.80,Main,,0,0,0,,Kurtlar tarafından kovalanıyordum ve Hasır-chan'ın gizemli gücü sayesinde kurtulmuştum.Dialogue: 0,0:03:24.80,0:03:27.50,Main,,0,0,0,,Sonra kendimden geçtim.Dialogue: 0,0:03:28.96,0:03:31.34,Main,,0,0,0,,O zaman bu bir rüya mı?Dialogue: 0,0:03:31.34,0:03:34.88,Main,,0,0,0,,Hayır, durun! Ölümüne donmuş olmalıyım!Dialogue: 0,0:03:34.88,0:03:37.88,Main,,0,0,0,,Bu ölümden sonraki hayat mı?Dialogue: 0,0:03:37.88,0:03:40.31,Main,,0,0,0,,Ah, uyandın mı?Dialogue: 0,0:03:40.31,0:03:42.53,Main,,0,0,0,,Gerçekten uzun süre uyudun.Dialogue: 0,0:03:42.53,0:03:44.72,Main,,0,0,0,,En azından 10 saat olmalı.Dialogue: 0,0:03:45.20,0:03:46.14,Main,,0,0,0,,10 saat mi?!Dialogue: 0,0:03:46.14,0:03:47.40,Main,,0,0,0,,Neden bahsediyorsun?Dialogue: 0,0:03:47.40,0:03:48.15,Main,,0,0,0,,Kimsin sen?!Dialogue: 0,0:03:48.50,0:03:50.80,Main,,0,0,0,,Adım Inazuma.Dialogue: 0,0:03:51.80,0:03:53.28,Main,,0,0,0,,Bu kadar kaba olma.Dialogue: 0,0:03:53.78,0:03:58.49,Main,,0,0,0,,Donarak ölmenin eşiğindeyken ikinizi buraya taşıyan bendim.Dialogue: 0,0:03:59.43,0:04:01.36,Main,,0,0,0,,İkimizi derken...Dialogue: 0,0:04:01.36,0:04:03.32,Main,,0,0,0,,Yani Hasır-chan da mı burada?Dialogue: 0,0:04:03.32,0:04:05.07,Main,,0,0,0,,Nerede? Güvende mi?!Dialogue: 0,0:04:05.07,0:04:06.72,Main,,0,0,0,,Hapishane personeli misiniz siz?Dialogue: 0,0:04:06.72,0:04:08.50,Main,,0,0,0,,Burası neresi? Neresi?!Dialogue: 0,0:04:08.83,0:04:10.96,Main,,0,0,0,,Hadi ama, sakin ol.Dialogue: 0,0:04:11.70,0:04:13.87,Main,,0,0,0,,Bilmen gereken her şeyi o anlatacak.Dialogue: 0,0:04:14.92,0:04:16.58,Main,,0,0,0,,O mu?Dialogue: 0,0:04:17.89,0:04:19.20,Main,,0,0,0,,Işıklar söndü!Dialogue: 0,0:04:19.20,0:04:21.25,Main,,0,0,0,,Gösteri başlıyor!Dialogue: 0,0:04:21.66,0:04:23.35,Main,,0,0,0,,Ön tarafa gidelim.Dialogue: 0,0:04:24.97,0:04:27.97,Main,,0,0,0,,İyi uyudun mu, Şeker Çocuk?Dialogue: 0,0:04:28.89,0:04:32.73,Main,,0,0,0,,Ya da Bay 2 Bon Çocuk mu desem?Dialogue: 0,0:04:32.94,0:04:35.48,Main,,0,0,0,,Ne? Adımı nereden biliyorsun?Dialogue: 0,0:04:38.40,0:04:40.30,Main,,0,0,0,,Buraya gelmeyi başarmandan etkilendim.Dialogue: 0,0:04:41.91,0:04:42.86,Main,,0,0,0,,Burası...Dialogue: 0,0:04:45.53,0:04:47.74,Main,,0,0,0,,Harikasın! Çok seksisin!Dialogue: 0,0:04:48.86,0:04:50.83,Main,,0,0,0,,Burası...Dialogue: 0,0:04:51.60,0:04:54.62,Main,,0,0,0,,...Impel Down'ın lağımları boyunca...Dialogue: 0,0:04:56.90,0:05:01.75,Main,,0,0,0,,...olmaması gereken bir yolu seçerek gelebileceğin bir yer.Dialogue: 0,0:05:01.75,0:05:05.84,Main,,0,0,0,,Mahkûmların cenneti!!Dialogue: 0,0:05:07.96,0:05:11.07,Main,,0,0,0,,Burada her türlü eğlence var!Dialogue: 0,0:05:11.72,0:05:12.97,Main,,0,0,0,,İçki,...Dialogue: 0,0:05:14.44,0:05:15.45,Main,,0,0,0,,...silah,...Dialogue: 0,0:05:16.46,0:05:18.20,Main,,0,0,0,,...oyun...Dialogue: 0,0:05:18.60,0:05:22.11,Main,,0,0,0,,...ve her şeyden öte ÖZGÜRLÜK!Dialogue: 0,0:05:22.58,0:05:25.99,Main,,0,0,0,,EVET! DOĞRU! HEPİMİZ ÖZGÜRÜZ!Dialogue: 0,0:05:26.98,0:05:28.12,Main,,0,0,0,,Evet.Dialogue: 0,0:05:28.12,0:05:30.78,Main,,0,0,0,,Muhafızlar bugün yaygara yapıyordu.Dialogue: 0,0:05:30.78,0:05:36.48,Main,,0,0,0,,"Mahkûmlar yeraltı dünyasına çekildi" diyerek, değil mi?Dialogue: 0,0:05:36.48,0:05:41.54,Main,,0,0,0,,Ama çok yazık! Hepimiz buradayız!Dialogue: 0,0:05:41.84,0:05:43.39,Main,,0,0,0,,Harikasın!Dialogue: 0,0:05:43.39,0:05:44.17,Main,,0,0,0,,Evet!Dialogue: 0,0:05:47.02,0:05:49.10,Main,,0,0,0,,Burası yeraltı dünyası değil,...Dialogue: 0,0:05:51.46,0:05:54.40,Main,,0,0,0,,...daha çok Okama dünyası!Dialogue: 0,0:05:56.99,0:06:00.99,Main,,0,0,0,,Kimsenin bilmediği gizli toplum!Dialogue: 0,0:06:01.36,0:06:04.07,Main,,0,0,0,,Mahkumların...Dialogue: 0,0:06:07.42,0:06:13.08,Main,,0,0,0,,...gizli mekânı Impel Down 5.5'e hoşgeldin!Dialogue: 0,0:06:14.12,0:06:17.24,Main,,0,0,0,,NEWKAMA MEKÂNI!Dialogue: 0,0:06:23.12,0:06:26.05,Main,,0,0,0,,Bu sapıklar ordusu da ne?Dialogue: 0,0:06:26.05,0:06:32.88,Main,,0,0,0,,Iva-sama!Dialogue: 0,0:06:35.72,0:06:37.06,Main,,0,0,0,,Iva-san mı?!Dialogue: 0,0:06:49.06,0:06:51.74,Main,,0,0,0,,Buradaki gerilim biraz fazla.Dialogue: 0,0:06:51.74,0:06:53.29,Main,,0,0,0,,Ba... Bayılacağım.Dialogue: 0,0:06:53.29,0:06:54.92,Main,,0,0,0,,Iva-sama, iyi misin?Dialogue: 0,0:06:54.92,0:06:58.79,Main,,0,0,0,,İyi... İyi...Dialogue: 0,0:06:58.79,0:07:00.61,Main,,0,0,0,,İyi olacağım!Dialogue: 0,0:07:01.05,0:07:02.42,Main,,0,0,0,,Sadece şaka mıydı?!Dialogue: 0,0:07:02.42,0:07:04.78,Main,,0,0,0,,Beni kandırdın!Dialogue: 0,0:07:05.27,0:07:09.80,Main,,0,0,0,,Sen gerçekten Iva-san mısın?Dialogue: 0,0:07:10.09,0:07:14.50,Main,,0,0,0,,Ah, demek kim olduğumu biliyorsun.Dialogue: 0,0:07:14.78,0:07:18.52,Main,,0,0,0,,Hey, dikkat et! Biraz daha saygı göster! Ona "Iva-san" deme!Dialogue: 0,0:07:18.52,0:07:22.47,Main,,0,0,0,,Evet, doğru! O Iva-sama, Newkama'nın Kralı!Dialogue: 0,0:07:22.47,0:07:26.78,Main,,0,0,0,,Iva-sama!  Iva-sama!Dialogue: 0,0:07:26.78,0:07:28.74,Main,,0,0,0,,Sessiz olun, şekerciklerim!Dialogue: 0,0:07:28.74,0:07:32.07,Main,,0,0,0,,Sadece bir isim. Bu kadar sorun etmeye gerek yok.Dialogue: 0,0:07:32.07,0:07:34.75,Main,,0,0,0,,Bana nasıl hitap ettiğiniz önemli değil.Dialogue: 0,0:07:34.75,0:07:38.91,Main,,0,0,0,,Nasıl isterseniz öyle hitap edin. "Kaka" deseniz bile farketmez!Dialogue: 0,0:07:38.91,0:07:41.12,Main,,0,0,0,,Ama demeseniz daha iyi!Dialogue: 0,0:07:41.12,0:07:42.35,Main,,0,0,0,,Sana kaka diyemez miyiz?!Dialogue: 0,0:07:42.35,0:07:44.08,Main,,0,0,0,,Beni kandırdın!Dialogue: 0,0:07:45.07,0:07:47.98,Main,,0,0,0,,B-Bu kişi, "mucize işçisi" mi?Dialogue: 0,0:07:47.98,0:07:51.26,Main,,0,0,0,,Hep örnek aldığım kişi mi?!Dialogue: 0,0:07:52.05,0:07:54.89,Main,,0,0,0,,Emporio Ivankov!Dialogue: 0,0:08:01.05,0:08:05.52,Main,,0,0,0,,Kama Kraliçeliği'nin Kraliçesi olduğunu duydum!Dialogue: 0,0:08:06.94,0:08:11.72,Main,,0,0,0,,Babam on beş yıl önce bir kraldı,...Dialogue: 0,0:08:11.72,0:08:14.76,Main,,0,0,0,,...ta ki Kamabakka'ya ayak basana kadar...Dialogue: 0,0:08:15.69,0:08:17.83,Main,,0,0,0,,...VE OKAMA OLARAK GERİ DÖNDÜ!Dialogue: 0,0:08:19.25,0:08:24.67,Main,,0,0,0,,Kral okama olduğu için gururumuzu ve kraliyetimizi yitirdik.Dialogue: 0,0:08:25.05,0:08:29.21,Main,,0,0,0,,Bense prensken korsan oldum!Dialogue: 0,0:08:30.06,0:08:32.49,Main,,0,0,0,,İntikamımı burada almayı hiç beklemiyordum!Dialogue: 0,0:08:32.49,0:08:37.72,Main,,0,0,0,,Hayatımı mahvetmenin bedelini ödeyeceksin!Dialogue: 0,0:08:40.54,0:08:43.86,Main,,0,0,0,,D-D-Dur lütfen!Dialogue: 0,0:08:43.86,0:08:45.42,Main,,0,0,0,,Ne tehlikeli bir silah!Dialogue: 0,0:08:46.79,0:08:50.07,Main,,0,0,0,,Tehlikeli! Çok tehlikeli diyorum!Dialogue: 0,0:08:50.60,0:08:53.28,Main,,0,0,0,,Öleceğim! Öleceğim!Dialogue: 0,0:08:53.70,0:08:56.99,Main,,0,0,0,,Ateş edersen, ben... ben...Dialogue: 0,0:08:56.99,0:08:58.99,Main,,0,0,0,,...ölmeyeceğim!Dialogue: 0,0:08:58.99,0:09:00.65,Main,,0,0,0,,Ölmeyecek misin?Dialogue: 0,0:09:00.65,0:09:02.81,Main,,0,0,0,,Cidden kandırdın beni!Dialogue: 0,0:09:09.74,0:09:12.94,Main,,0,0,0,,Ölüm Göz Kırpışı!Dialogue: 0,0:09:27.94,0:09:32.50,Main,,0,0,0,,İşte! Iva-sama'nın basit göz kırpması, Ölüm Göz Kırpışı!Dialogue: 0,0:09:36.99,0:09:40.29,Main,,0,0,0,,S-Sadece göz kırparak gülleyi geri mi püskürttü?!Dialogue: 0,0:09:45.82,0:09:48.52,Main,,0,0,0,,Emporio Kadın Hormonu!Dialogue: 0,0:09:59.12,0:10:00.76,Main,,0,0,0,,Ne yaptın sen?!Dialogue: 0,0:10:06.30,0:10:09.09,Main,,0,0,0,,Pislik... Olamaz!Dialogue: 0,0:10:09.09,0:10:13.34,Main,,0,0,0,,Demek baban kadın olmak istedi.Dialogue: 0,0:10:13.34,0:10:15.59,Main,,0,0,0,,Bunun nesi yanlış?Dialogue: 0,0:10:16.49,0:10:18.47,Main,,0,0,0,,K-K-Kes şunu!Dialogue: 0,0:10:18.47,0:10:20.68,Main,,0,0,0,,K-K-K... Küçülüyor!Dialogue: 0,0:10:21.45,0:10:24.32,Main,,0,0,0,,İki anne ve bir kız.Dialogue: 0,0:10:24.32,0:10:26.64,Main,,0,0,0,,Kulağa hoş gelmiyor mu?Dialogue: 0,0:10:26.64,0:10:28.15,Main,,0,0,0,,Alışacağını umuyorum.Dialogue: 0,0:10:28.15,0:10:31.15,Main,,0,0,0,,Hayır! Hayır, kes şunu!Dialogue: 0,0:10:31.66,0:10:33.12,Main,,0,0,0,,Kes şunu!Dialogue: 0,0:10:41.88,0:10:45.39,Main,,0,0,0,,Erkek, kadın...Dialogue: 0,0:10:46.77,0:10:49.13,Main,,0,0,0,,...ya da okama.Dialogue: 0,0:10:49.13,0:10:53.68,Main,,0,0,0,,Olmak istediğini olmalısın, değil mi?!Dialogue: 0,0:10:53.68,0:10:57.99,Main,,0,0,0,,Burada cinsiyetin önemi yok!Dialogue: 0,0:10:57.99,0:11:08.82,Main,,0,0,0,,Ben... Hayır! Biz, böyle küçük şeyleri önemsemeyen yeni ırkız!Dialogue: 0,0:11:08.82,0:11:11.00,Main,,0,0,0,,Newkama!Dialogue: 0,0:11:13.96,0:11:19.26,Main,,0,0,0,,Burası özgürlük bahçesi, Newkama Mekânı!Dialogue: 0,0:11:22.91,0:11:24.48,Main,,0,0,0,,Iva-sama!Dialogue: 0,0:11:24.48,0:11:27.56,Main,,0,0,0,,Bir erkeği kadına çevirdi!Dialogue: 0,0:11:27.56,0:11:31.16,Main,,0,0,0,,Gerçekten bir mucize işçisi!Dialogue: 0,0:11:33.23,0:11:37.78,Main,,0,0,0,,Newkama Mekânı'ma hoşgeldin!Dialogue: 0,0:11:42.38,0:11:47.21,Main,,0,0,0,,ÇOK UTANÇ VERİCİ!Dialogue: 0,0:11:49.47,0:11:51.31,Main,,0,0,0,,Çok fazla utandı.Dialogue: 0,0:11:51.31,0:11:55.13,Main,,0,0,0,,O zaman Newkama olmadan önce katetmen gereken uzun bir yol var.Dialogue: 0,0:11:58.14,0:12:00.76,Main,,0,0,0,,Mucize işçisi, Emporio Ivankov!Dialogue: 0,0:12:00.76,0:12:03.04,Main,,0,0,0,,Seninle tanışmak büyük onur!Dialogue: 0,0:12:03.04,0:12:06.77,Main,,0,0,0,,Tanıştığımıza çok memnun oldum! Gerçekten!Dialogue: 0,0:12:06.77,0:12:09.92,Main,,0,0,0,,Küstahlığımı bağışla ama bir iyilik isteyeceğim!Dialogue: 0,0:12:09.92,0:12:11.27,Main,,0,0,0,,İyilik?Dialogue: 0,0:12:11.27,0:12:15.76,Main,,0,0,0,,Arkadaşım Magellan tarafından zehirlendi, onun hayatını kurtarmanı istiyorum!Dialogue: 0,0:12:15.76,0:12:21.12,Main,,0,0,0,,Tedavi edilemeyecek durumda ve ölümü hızla yaklaşıyor!Dialogue: 0,0:12:21.12,0:12:24.73,Main,,0,0,0,,Onu kurtarırsan senin için her şeyi yaparım!Dialogue: 0,0:12:24.73,0:12:27.87,Main,,0,0,0,,Hasır Şapkalı çocuktan mı bahsediyorsun?Dialogue: 0,0:12:33.90,0:12:35.62,Main,,0,0,0,,Bon çocuk?Dialogue: 0,0:12:36.19,0:12:40.32,Main,,0,0,0,,Niye yaralarını tedavi ettiğimi biliyor musun?Dialogue: 0,0:12:40.32,0:12:42.63,Main,,0,0,0,,Sahi... ne zaman...Dialogue: 0,0:12:43.40,0:12:45.81,Main,,0,0,0,,Biz mahkûmuz.Dialogue: 0,0:12:45.81,0:12:51.93,Main,,0,0,0,,Karşılaştığımız her insanı iyileştirecek kadar iyi kimseler değiliz.Dialogue: 0,0:12:52.60,0:12:57.36,Main,,0,0,0,,Çünkü bahsettiğin Hasır Şapkalı çocuk, senin canının bağışlanması için yalvardı.Dialogue: 0,0:12:57.36,0:12:59.11,Main,,0,0,0,,Hasır-chan mı?!Dialogue: 0,0:13:04.91,0:13:06.62,Main,,0,0,0,,Bon-chan...Dialogue: 0,0:13:06.62,0:13:08.77,Main,,0,0,0,,...beni kurtarmaya çalıştı.Dialogue: 0,0:13:08.77,0:13:10.97,Main,,0,0,0,,Kurtların saldırısına uğradı!Dialogue: 0,0:13:10.97,0:13:12.17,Main,,0,0,0,,Lütfen ona yardım edin!Dialogue: 0,0:13:16.89,0:13:18.20,Main,,0,0,0,,Lütfen!Dialogue: 0,0:13:18.20,0:13:21.00,Main,,0,0,0,,O benim arkadaşım!!Dialogue: 0,0:13:23.33,0:13:27.27,Main,,0,0,0,,Kendisi ölüme çok yakın olan birçok insan asla böyle bir şey demezdi.Dialogue: 0,0:13:27.80,0:13:31.26,Main,,0,0,0,,Galiba arkadaşlık çiçekleri hapishanede bile açabiliyor.Dialogue: 0,0:13:31.73,0:13:36.61,Main,,0,0,0,,Bu isteği görmezden gelseydim şeytandan farkım kalmazdı.Dialogue: 0,0:13:37.33,0:13:38.98,Main,,0,0,0,,Hasır-chan!Dialogue: 0,0:13:38.98,0:13:43.57,Main,,0,0,0,,Hasır Şapkalı çocuğun tedavisi 10 saattir devam ediyor.Dialogue: 0,0:13:43.57,0:13:44.62,Main,,0,0,0,,Gerçekten mi?!Dialogue: 0,0:13:56.98,0:13:59.09,Main,,0,0,0,,Gerçi dayanılmaz acı veren bir işlem.Dialogue: 0,0:14:04.14,0:14:06.10,Main,,0,0,0,,Orada neler oluyor?!Dialogue: 0,0:14:06.10,0:14:08.41,Main,,0,0,0,,Buna tedavi mi diyorsun?!Dialogue: 0,0:14:08.83,0:14:14.51,Main,,0,0,0,,On saattir mağarada kilitli ve bunca zamandır bağırıyor.Dialogue: 0,0:14:14.51,0:14:18.14,Main,,0,0,0,,Tedavisinin bitmesine iki gün daha var.Dialogue: 0,0:14:18.14,0:14:18.89,Main,,0,0,0,,Ne?!Dialogue: 0,0:14:25.56,0:14:27.98,Main,,0,0,0,,Hayatının on yılı.Dialogue: 0,0:14:27.98,0:14:36.04,Main,,0,0,0,,Ömrünün on yılını eksiltmiş olacağım, Hasır Şapkalı çocuk.Dialogue: 0,0:14:38.06,0:14:39.33,Main,,0,0,0,,Tamam.Dialogue: 0,0:14:39.59,0:14:44.70,Main,,0,0,0,,Ancak on yılı kullanarak bile hayatta kalacağını garanti edemem.Dialogue: 0,0:14:44.70,0:14:53.32,Main,,0,0,0,,Sadece yaşama ihtimalini sıfırdan yüzde iki ya da üçe çıkaracak.Dialogue: 0,0:14:53.32,0:14:57.36,Main,,0,0,0,,Hayatta kalmanın mümkün olup olmaması...Dialogue: 0,0:14:57.36,0:15:00.64,Main,,0,0,0,,...tamamen kendi yaşama azmine bağlı.Dialogue: 0,0:15:00.64,0:15:03.15,Main,,0,0,0,,Ölürsen zehir kazanır.Dialogue: 0,0:15:04.12,0:15:08.30,Main,,0,0,0,,Canlı kurtulursan kazanırsın!Dialogue: 0,0:15:08.96,0:15:13.95,Main,,0,0,0,,Ölümün eşiğine doğru iyi yolculuklar!Dialogue: 0,0:15:13.95,0:15:19.56,Main,,0,0,0,,Emporio İyileştirici Hormon!Dialogue: 0,0:15:53.23,0:15:55.89,Main,,0,0,0,,O-On saat?!Dialogue: 0,0:15:56.42,0:16:00.45,Main,,0,0,0,,On saattir böyle acı ççekerek bağırıyor muydun, Hasır-chan?!Dialogue: 0,0:16:00.75,0:16:02.60,Main,,0,0,0,,Ruh ve hormonlar.Dialogue: 0,0:16:02.60,0:16:05.25,Main,,0,0,0,,Bunlar vücudun yaşamsal güçlerini oluşturur.Dialogue: 0,0:16:09.17,0:16:15.42,Main,,0,0,0,,Hasır Şapkalı çocuğun bağışıklık sistemini, bedenini zehre dayanabilecek şekilde...Dialogue: 0,0:16:15.42,0:16:18.87,Main,,0,0,0,,...yeniden yapılandırması için normal sınırının ötesine geçmeye zorladım.Dialogue: 0,0:16:18.87,0:16:24.37,Main,,0,0,0,,İç organları sürekli hızlıca parçalanıp yeniden oluşuyor.Dialogue: 0,0:16:25.30,0:16:30.65,Main,,0,0,0,,Acılı çığlıkları durursa tedavi hayatına mal olmuş demektir.Dialogue: 0,0:16:35.48,0:16:38.54,Main,,0,0,0,,Endişelendiysen gidip ona bakabilirsin.Dialogue: 0,0:16:41.26,0:16:44.00,Main,,0,0,0,,Nerede? Nerede?Dialogue: 0,0:16:47.97,0:16:49.42,Main,,0,0,0,,Hasır-cha-Dialogue: 0,0:16:54.80,0:16:57.85,Main,,0,0,0,,Ölecek!Dialogue: 0,0:16:57.85,0:16:59.91,Main,,0,0,0,,Bedeni tamamen hırpalanmış...Dialogue: 0,0:16:59.91,0:17:02.73,Main,,0,0,0,,Onu kırıp parçalayacak...Dialogue: 0,0:17:02.73,0:17:07.19,Main,,0,0,0,,Çoktan ölmüş! Bu korkunç!Dialogue: 0,0:17:07.35,0:17:12.14,Main,,0,0,0,,Ona yardım et! Lütfen Hasır-chan'ı kurtar!Dialogue: 0,0:17:12.14,0:17:15.54,Main,,0,0,0,,Zincirleri çıkar ve kanamasını durdur!Dialogue: 0,0:17:16.94,0:17:21.02,Main,,0,0,0,,Lütfen bir şey yap... Ne olursa olsun!Dialogue: 0,0:17:21.02,0:17:23.08,Main,,0,0,0,,Yalvarırım!Dialogue: 0,0:17:23.08,0:17:24.92,Main,,0,0,0,,Sessiz ol!Dialogue: 0,0:17:26.80,0:17:29.47,Main,,0,0,0,,Zaten onu kurtarmaya çalışıyorum!Dialogue: 0,0:17:29.88,0:17:32.41,Main,,0,0,0,,Sakın yaşamı hafife alma!Dialogue: 0,0:17:33.42,0:17:39.43,Main,,0,0,0,,Zaten kaderinde ölüm varken ölüme karşı savaşmanın ne demek olduğunu anlıyor musun?!Dialogue: 0,0:17:41.00,0:17:44.16,Main,,0,0,0,,Ben Kami ya da Buddha değilim.Dialogue: 0,0:17:44.16,0:17:45.74,Main,,0,0,0,,Mucize işçisi?Dialogue: 0,0:17:45.74,0:17:49.32,Main,,0,0,0,,Bana ne isterseniz diyebilirsiniz ama...Dialogue: 0,0:17:49.32,0:17:53.91,Main,,0,0,0,,...hiçbir zaman her konuda başkasına güvenecek kadar ahmak birini kurtarmadım.Dialogue: 0,0:17:53.91,0:17:58.78,Main,,0,0,0,,Hayatta kalacak gücü olmayan yıkımın eşiğindeki o ülkelere bile...Dialogue: 0,0:17:58.78,0:18:02.71,Main,,0,0,0,,...tüm yaptığım yaşama azimlerinin olup olmadığını sormaktı.Dialogue: 0,0:18:03.68,0:18:08.04,Main,,0,0,0,,Mucizeler sadece denemekten asla vazgeçmeme kararlılığında olanlar için gerçekleşir!Dialogue: 0,0:18:08.04,0:18:10.96,Main,,0,0,0,,Mucizeleri sakın hafife alma!Dialogue: 0,0:18:27.12,0:18:32.86,Main,,0,0,0,,Kısacası Horu Horu Meyvesi yedim. Hormon değiştiren bir adamım. Dialogue: 0,0:18:27.12,0:18:32.86,Note,,0,0,0,,Horu: Hormon'un kısaltılmışıDialogue: 0,0:18:33.61,0:18:37.99,Main,,0,0,0,,Cinsiyet, vücut ısısı, ten rengi, büyüme ve heyecan.Dialogue: 0,0:18:37.99,0:18:42.74,Main,,0,0,0,,İnsanları içeriden değiştirebilen bir insan vücudu mühendisiyim.Dialogue: 0,0:18:43.45,0:18:47.24,Main,,0,0,0,,Sen de Newkama kokusu var ama...Dialogue: 0,0:18:47.24,0:18:51.04,Main,,0,0,0,,...buradaki şekercikler cinsiyet bariyerlerini aştı.Dialogue: 0,0:18:51.04,0:18:53.79,Main,,0,0,0,,Erkekler kadın olabilir.Dialogue: 0,0:18:54.88,0:18:57.71,Main,,0,0,0,,Çünkü bildiğin gibi, kadınlar bir zamanlar erkekti.Dialogue: 0,0:18:57.71,0:18:59.22,Main,,0,0,0,,Bu bir mucize.Dialogue: 0,0:19:00.26,0:19:02.93,Main,,0,0,0,,Kesinlikle inanılmaz bir mucize!Dialogue: 0,0:19:04.01,0:19:05.26,Main,,0,0,0,,Anlıyorum!Dialogue: 0,0:19:06.85,0:19:10.52,Main,,0,0,0,,Bu hormonları daha önce o adamı bir kadına dönüştürmek için kullandın.Dialogue: 0,0:19:13.39,0:19:14.76,Main,,0,0,0,,Ama şuraya bak.Dialogue: 0,0:19:14.76,0:19:16.68,Main,,0,0,0,,Hapishane olduğuna inanamıyorum!Dialogue: 0,0:19:16.68,0:19:18.15,Main,,0,0,0,,Rüya olmalı!Dialogue: 0,0:19:18.15,0:19:21.82,Main,,0,0,0,,Rüya değil! Rüyalar ülkesi!Dialogue: 0,0:19:23.30,0:19:26.74,Main,,0,0,0,,Buradaki tüm şekercikler kayıp mahkûmlardı.Dialogue: 0,0:19:27.14,0:19:29.83,Main,,0,0,0,,Sadece şans eseri buraya geldiler.Dialogue: 0,0:19:30.20,0:19:36.24,Main,,0,0,0,,Her katta Newkama Mekanı'na girişler vardır.Dialogue: 0,0:19:36.24,0:19:38.79,Main,,0,0,0,,Kana bulanmış iğneler ormanında,...Dialogue: 0,0:19:38.79,0:19:40.96,Main,,0,0,0,,...canavarlar ininde,...Dialogue: 0,0:19:40.96,0:19:43.42,Main,,0,0,0,,...kavurucu cehennem ateşinde...Dialogue: 0,0:19:43.42,0:19:45.54,Main,,0,0,0,,...ve ceset yığınları arasında.Dialogue: 0,0:19:45.54,0:19:50.59,Main,,0,0,0,,Bu yolları kullanarak istediğimizi alabiliriz.Dialogue: 0,0:19:54.36,0:19:57.02,Main,,0,0,0,,Gardiyanlar hiçbir şey farketmedi.Dialogue: 0,0:19:57.02,0:20:00.46,Main,,0,0,0,,Neticede cehennemde böyle bir cennet saklı olabileceği kimin aklına gelirdi ki?Dialogue: 0,0:20:00.46,0:20:04.81,Main,,0,0,0,,Dış dünya ile ilgili her türlü bilgiyi öğrenebiliyoruz.Dialogue: 0,0:20:04.81,0:20:10.03,Main,,0,0,0,,Gözetleme odalarındaki gibi Den Den Mushi ekranlarımız var.Dialogue: 0,0:20:10.03,0:20:13.03,Main,,0,0,0,,Bu şekilde hapishanede olan her şeyden haberimiz oluyor.Dialogue: 0,0:20:13.03,0:20:17.87,Main,,0,0,0,,Çöp tenekelerinden gazeteleri toplayıp dış dünyadaki gündemi takip edebiliyoruz.Dialogue: 0,0:20:17.87,0:20:22.76,Main,,0,0,0,,Hasır Şapkalı çocuğun yol açtığı küçük kargaşanız, bu hapishane tarihindeki ilk sızma hareketini...Dialogue: 0,0:20:22.76,0:20:25.20,Main,,0,0,0,,...izlemek çok eğlenceliydi.Dialogue: 0,0:20:25.20,0:20:27.80,Main,,0,0,0,,Gerçekten ilgi çekiciydi.Dialogue: 0,0:20:27.80,0:20:30.09,Main,,0,0,0,,Bu arada biz neredeyiz?Dialogue: 0,0:20:30.09,0:20:31.97,Main,,0,0,0,,Bu kadar büyük bir yer nasıl var olabilir?Dialogue: 0,0:20:31.97,0:20:35.46,Main,,0,0,0,,Önceleri yoktu.Dialogue: 0,0:20:35.46,0:20:39.89,Main,,0,0,0,,Uzun zaman önce tünel kazıcı Şeytan Meyvesi yemiş bir mahkûm vardı.Dialogue: 0,0:20:40.27,0:20:46.31,Main,,0,0,0,,Bu şekerciğin mahkûmların cenneti için çalışmaya başlayan ilk kişi olduğunu duydum.Dialogue: 0,0:20:46.31,0:20:51.31,Main,,0,0,0,,Burası muazzam bir kayaya oyulmuş bir karınca yuvası gibi.Dialogue: 0,0:20:51.31,0:20:57.49,Main,,0,0,0,,Hangi katta olduğunu bilmek istiyorsan Seviye 5'le 6 arasında.Dialogue: 0,0:20:57.49,0:20:59.95,Main,,0,0,0,,Hey, dur biraz! Seviye 6 mı?!Dialogue: 0,0:20:59.95,0:21:02.00,Main,,0,0,0,,O kat var mı?!Dialogue: 0,0:21:03.00,0:21:06.64,Main,,0,0,0,,Evet, insanların çoğu bilmese de...Dialogue: 0,0:21:07.79,0:21:09.10,Main,,0,0,0,,...var.Dialogue: 0,0:21:09.10,0:21:11.47,Main,,0,0,0,,Gerçekten tehlikeli mahkûmların tutulduğu yer.Dialogue: 0,0:21:11.94,0:21:15.64,Main,,0,0,0,,Müebbet hapis veya idam cezasına çarptırılmış olanların.Dialogue: 0,0:21:15.64,0:21:18.39,Main,,0,0,0,,Seviye 6, Sonsuz Cehennem.Dialogue: 0,0:21:18.39,0:21:22.23,Main,,0,0,0,,Bu mahkumların vahşiliği, hükümeti o katın varlığını gizlemek zorunda bırakıyor.Dialogue: 0,0:21:23.34,0:21:26.86,Main,,0,0,0,,Bir kez daha onlar için rahatsızlık veren her şeyi gizliyorlar.Dialogue: 0,0:21:27.27,0:21:32.74,Main,,0,0,0,,Örneğin hapishaneyi Seviye 4'e kadar yarıp geçtiniz.Dialogue: 0,0:21:32.74,0:21:37.79,Main,,0,0,0,,Ama biraz erken gelseydiniz bunu yapabileceğinizi hiç sanmıyorum.Dialogue: 0,0:21:38.37,0:21:43.12,Main,,0,0,0,,Çünkü bu hapishanede başka bir büyük güç vardı.Dialogue: 0,0:21:43.12,0:21:47.26,Main,,0,0,0,,Impel Down Baş Gardiyanı, Yağmur Shiryuu.Dialogue: 0,0:21:47.26,0:21:51.55,Main,,0,0,0,,Gücü Müdür Magellan'ınkine denkti...Dialogue: 0,0:21:51.55,0:21:57.48,Main,,0,0,0,,...ve Magellan'ın deneyim eksikliğini ele alırsak Shiryuu daha da tehlikeliydi.Dialogue: 0,0:21:58.64,0:22:02.65,Main,,0,0,0,,M-Magellan'dan daha tehlikeli mi!?Dialogue: 0,0:22:02.65,0:22:07.42,Main,,0,0,0,,Impel Down, o ikisi yüzünden delinmez olmakla övünürdü.Dialogue: 0,0:22:09.69,0:22:11.07,Main,,0,0,0,,Baş Gardiyan...Dialogue: 0,0:22:11.82,0:22:14.46,Main,,0,0,0,,...Yağmur Shiryuu?!Dialogue: 0,0:22:21.34,0:22:23.75,Flashbacks,,0,0,0,,Shiryuu! Ne yapıyorsun?!Dialogue: 0,0:22:24.87,0:22:26.34,Flashbacks,,0,0,0,,Ne mi yapıyorum?Dialogue: 0,0:22:26.34,0:22:31.28,Flashbacks,,0,0,0,,Mahkûmlar senin eğlenmen için burada değil, Shiryuu!Dialogue: 0,0:22:33.12,0:22:35.93,Flashbacks,,0,0,0,,Bu pisliği doğramak kime rahatsızlık verir ki?!Dialogue: 0,0:22:36.22,0:22:38.39,Flashbacks,,0,0,0,,Artık tavırlarını görmezden gelemem.Dialogue: 0,0:22:38.39,0:22:41.73,Flashbacks,,0,0,0,,Yaptıklarınla ilgili dışarı bir şey sızarsa...Dialogue: 0,0:22:41.73,0:22:44.86,Flashbacks,,0,0,0,,...Impel Down'ın itibarını lekelenir!Dialogue: 0,0:22:44.86,0:22:48.95,Flashbacks,,0,0,0,,Müdürlük yetkimi kullanarak seni tutukluyorum!Dialogue: 0,0:23:00.12,0:23:06.29,Main,,0,0,0,,Bir sürü mahkûmu sırf kaprislerinden ötürü katlettiği için...Dialogue: 0,0:23:06.29,0:23:11.68,Main,,0,0,0,,...tehdit olarak görüldü ve şimdi Seviye 6'da hapsedilmiş durumda.Dialogue: 0,0:23:12.47,0:23:15.35,Main,,0,0,0,,Bu konuda hiçbir şey duymamıştım!Dialogue: 0,0:23:15.35,0:23:17.85,Main,,0,0,0,,Ben buraya konulmadan önce olmuş olsa bile...Dialogue: 0,0:23:17.85,0:23:23.23,Main,,0,0,0,,Korsanlık tarihindeki en korkutucu kadın Katarina Devon,...Dialogue: 0,0:23:23.23,0:23:25.73,Main,,0,0,0,,...Dev Savaş Gemisi San Juan Wolf,...Dialogue: 0,0:23:25.73,0:23:28.04,Main,,0,0,0,,ve Ayyaş Vasco Shot...Dialogue: 0,0:23:28.04,0:23:31.82,Main,,0,0,0,,İsimleri tüyler ürperten bu korsanların hepsi.Dialogue: 0,0:23:34.28,0:23:39.06,Main,,0,0,0,,Ama onların en acımasız suçları asla gazetelerde yer almadı.Dialogue: 0,0:23:39.06,0:23:42.67,Main,,0,0,0,,Bunlar, Seviye 6'da hapsedilen türden efsanevi korsanlar!Dialogue: 0,0:23:43.08,0:23:45.90,Main,,0,0,0,,Eski patronun da orada.Dialogue: 0,0:23:45.90,0:23:48.13,Main,,0,0,0,,O da epey deliydi.Dialogue: 0,0:23:48.13,0:23:50.97,Main,,0,0,0,,Ha? Zero-chan? Crocodile?!Dialogue: 0,0:23:53.30,0:23:57.97,Main,,0,0,0,,Hasır Şapkalı çocuk ve sizin örgütünüz Arabasta'da düşmandı, değil mi?Dialogue: 0,0:23:57.97,0:23:59.68,Main,,0,0,0,,Oldukça ilginç bir ilişkiniz var.Dialogue: 0,0:24:01.31,0:24:05.65,Main,,0,0,0,,Sadakat, arkadaşlıkta hiçbir şey ifade etmez!Dialogue: 0,0:24:07.72,0:24:09.22,Main,,0,0,0,,Doğru.Dialogue: 0,0:24:09.22,0:24:12.18,Main,,0,0,0,,Bir de Shichibukai'lerden biri olan Denizin Şövalyesi Jinbei var.Dialogue: 0,0:24:13.03,0:24:16.45,Main,,0,0,0,,Bir de Hasır Şapkalı çocuğun kurtarmaya çalıştığı kişi var, değil mi?Dialogue: 0,0:24:16.74,0:24:22.17,Main,,0,0,0,,Beyaz Sakal Korsanları İkinci Bölüm Kaptanı, Portgas D. Ace.Dialogue: 0,0:24:22.17,0:24:26.46,Main,,0,0,0,,Hapishane iletişimleri vasıtasıyla ikisinin kardeş olduğunu duydum.Dialogue: 0,0:24:27.96,0:24:32.68,Main,,0,0,0,,Evet. Hasır-chan buraya kadar onu kurtarmaya geldi.Dialogue: 0,0:24:33.59,0:24:37.14,Main,,0,0,0,,Hapishaneye ulaşıp içeri sızmak bile Kamisel bir davranıştı.Dialogue: 0,0:24:37.76,0:24:40.85,Main,,0,0,0,,Ama artık bundan vazgeçmek zorunda.Dialogue: 0,0:24:42.49,0:24:45.06,Main,,0,0,0,,Neticede öncelik kendi hayatında olmalı.Dialogue: 0,0:24:45.06,0:24:47.42,Main,,0,0,0,,Vakit gece yarısını geçti.Dialogue: 0,0:24:47.42,0:24:50.46,Main,,0,0,0,,Ace çocuk bugün öğleden sonra 3'te idam edilecek.Dialogue: 0,0:24:50.46,0:24:54.24,Main,,0,0,0,,Sabah Donanma Karargâhı'na götürüleceğini farzediyorum.Dialogue: 0,0:24:54.58,0:24:55.92,Main,,0,0,0,,Yani, bir bakalım...Dialogue: 0,0:24:55.92,0:25:01.47,Main,,0,0,0,,Ace çocuğun Impel Down'dan götürülmesi için 7 ya da 8 saat daha var.Dialogue: 0,0:25:03.58,0:25:08.19,Main,,0,0,0,,Hasır Şapkalı çocuğun tedavisi iki gün daha sürecek.Dialogue: 0,0:25:08.19,0:25:13.07,Main,,0,0,0,,Hayatta kalmayı başarsa bile gücünü kazanması için üç günlük uyku süreci daha gerekiyor.Dialogue: 0,0:25:13.07,0:25:15.76,Main,,0,0,0,,Uyandığında her şey sona ermiş olacak.Dialogue: 0,0:25:16.57,0:25:21.22,Main,,0,0,0,,Asıl önemlisi, şu durumda Hasır-chan iki gün daha hayatta kalabilecek mi?!Dialogue: 0,0:25:21.22,0:25:26.37,Main,,0,0,0,,Normalde hayatta kalmazlar. Kalırlarsa mucize olur dememiş miydim?Dialogue: 0,0:25:30.08,0:25:33.38,Main,,0,0,0,,Sen de dinlenmelisin.Dialogue: 0,0:25:33.38,0:25:36.55,Main,,0,0,0,,Bir şeyler ye ve uyu.Dialogue: 0,0:25:36.55,0:25:39.45,Main,,0,0,0,,Seni sessiz bir odaya götüreceğim.Dialogue: 0,0:25:40.60,0:25:42.87,Main,,0,0,0,,Hasır-chan'ın odasının dışında olacağım!Dialogue: 0,0:25:42.87,0:25:45.35,Main,,0,0,0,,Hey, kes şunu! O...Dialogue: 0,0:25:45.35,0:25:47.27,Main,,0,0,0,,Pek şansı olduğunu sanmıyorum.Dialogue: 0,0:25:47.27,0:25:49.44,Main,,0,0,0,,Ne yapabilirsin ki?Dialogue: 0,0:26:02.41,0:26:05.32,Main,,0,0,0,,Ne yapıyor acaba?Dialogue: 0,0:26:05.32,0:26:07.48,Main,,0,0,0,,Beklemekten başka yapacak bir şey yok.Dialogue: 0,0:26:11.46,0:26:13.42,Main,,0,0,0,,DAYAN!Dialogue: 0,0:26:13.42,0:26:17.67,Main,,0,0,0,,DAYAN, HASIR-CHAN!Dialogue: 0,0:26:19.63,0:26:21.97,Main,,0,0,0,,DAYAN!Dialogue: 0,0:26:21.97,0:26:25.22,Main,,0,0,0,,D-DAYAN!Dialogue: 0,0:26:25.22,0:26:27.39,Main,,0,0,0,,DAYAN!Dialogue: 0,0:26:27.39,0:26:30.14,Main,,0,0,0,,Bunca zamandır bunu mu yapıyordu?Dialogue: 0,0:26:28.62,0:26:33.85,Secondary,,0,0,0,,Dayan!Dialogue: 0,0:26:30.14,0:26:33.85,Main,,0,0,0,,Ne aptal ama. Bunun hiç yardımı olmayacak.Dialogue: 0,0:26:37.48,0:26:39.77,Main,,0,0,0,,Niye tek bir okamayı bile...Dialogue: 0,0:26:41.56,0:26:42.86,Main,,0,0,0,,...bulamıyorsunuz?!Dialogue: 0,0:26:42.86,0:26:45.19,Main,,0,0,0,,Bir kez daha arayın!Dialogue: 0,0:26:58.33,0:27:01.21,Main,,0,0,0,,D-Dayan!Dialogue: 0,0:27:01.21,0:27:02.96,Main,,0,0,0,,Dayan...Dialogue: 0,0:27:03.88,0:27:06.66,Main,,0,0,0,,Dayan, Hasır-chan!Dialogue: 0,0:27:06.66,0:27:11.81,Main,,0,0,0,,Hasır-chan!  Yaşa!Dialogue: 0,0:27:12.39,0:27:24.44,Main,,0,0,0,,Dayan!Dialogue: 0,0:27:24.44,0:27:26.31,Main,,0,0,0,,Dayan!Dialogue: 0,0:27:27.49,0:27:47.96,Main,,0,0,0,,Dayan, Hasır-chan!Dialogue: 0,0:27:51.76,0:27:52.46,Main,,0,0,0,,Müdür Bey!Dialogue: 0,0:27:53.35,0:27:57.88,Main,,0,0,0,,Seviye 5'teki mutfak personelinden bir mesaj aldık!Dialogue: 0,0:27:57.88,0:27:59.85,Main,,0,0,0,,Hasır Şapkalı Luffy...Dialogue: 0,0:28:01.27,0:28:02.73,Main,,0,0,0,,...yok olmuş!Dialogue: 0,0:28:02.73,0:28:03.51,Main,,0,0,0,,Ne?!Dialogue: 0,0:28:09.74,0:28:11.62,Main,,0,0,0,,M-Müdür Yardımcısı Hannyabal!Dialogue: 0,0:28:11.62,0:28:13.41,Main,,0,0,0,,Burada ne yapıyorsunuz?!Dialogue: 0,0:28:19.53,0:28:23.72,Main,,0,0,0,,Dayan!Dialogue: 0,0:28:23.72,0:28:27.64,Main,,0,0,0,,Dayan, Hasır-chan!Dialogue: 0,0:28:35.64,0:28:37.05,Main,,0,0,0,,Ace-san...Dialogue: 0,0:28:37.05,0:28:40.76,Main,,0,0,0,,O kadınla ilgili bir şey bilmiyorum ama...Dialogue: 0,0:28:41.31,0:28:44.65,Main,,0,0,0,,...yalan söylediğini farzetmek daha iyi olmaz mıydı?Dialogue: 0,0:28:46.20,0:28:49.91,Main,,0,0,0,,O zaman buraya kadar bana yalan söylemek için geldiğini mi söylüyorsun?!Dialogue: 0,0:28:55.36,0:28:57.96,Main,,0,0,0,,Hayır, üzgünüm...Dialogue: 0,0:28:57.96,0:29:00.67,Main,,0,0,0,,Ama biliyor musun, Jinbei...Dialogue: 0,0:29:00.67,0:29:02.84,Main,,0,0,0,,Kardeşim aynen öyle biridir.Dialogue: 0,0:29:02.84,0:29:05.43,Main,,0,0,0,,Sürekli pervasızca şeyler yapar durur!Dialogue: 0,0:29:05.43,0:29:10.13,Main,,0,0,0,,O aptal, çocukluğumuzdan beri beni endişelendirir durur!Dialogue: 0,0:29:18.37,0:29:19.62,Main,,0,0,0,,B-Bu kan!Dialogue: 0,0:29:22.50,0:29:23.42,Main,,0,0,0,,Sesi...Dialogue: 0,0:29:23.71,0:29:26.96,Main,,0,0,0,,Tedavisi sırasında bağırmayı bırakması mümkün değil.Dialogue: 0,0:29:28.11,0:29:31.51,Main,,0,0,0,,Sonu gelmeden sessizleşirse...Dialogue: 0,0:29:36.75,0:29:38.30,Thoughts,,0,0,0,,Çok yazık.Dialogue: 0,0:29:38.30,0:29:41.64,Thoughts,,0,0,0,,Ama 20 saat boyunca iyi mücadele ettin.Dialogue: 0,0:29:45.14,0:29:46.77,Main,,0,0,0,,Hasır-chan!Dialogue: 0,0:30:02.31,0:30:07.33,Main,,0,0,0,,YEMEK!!!Dialogue: 0,0:30:09.11,0:30:11.52,Main,,0,0,0,,H-HASIR-CHAN!!!Dialogue: 0,0:30:17.70,0:30:19.58,Main,,0,0,0,,Hasır Şapkalı çocuk!Dialogue: 0,0:30:19.58,0:30:22.75,Thoughts,,0,0,0,,O-Olamaz!Dialogue: 0,0:30:23.17,0:30:25.55,Thoughts,,0,0,0,,Neler oluyor?!Dialogue: 0,0:30:25.55,0:30:29.85,Thoughts,,0,0,0,,Daha bir gün bile olmadı!Dialogue: 0,0:30:32.40,0:30:34.64,Main,,0,0,0,,Müdür Bey. Müdür Magellan!Dialogue: 0,0:30:35.01,0:30:36.26,Main,,0,0,0,,Günaydın.Dialogue: 0,0:30:36.26,0:30:37.89,Main,,0,0,0,,İshalim.Dialogue: 0,0:30:37.89,0:30:39.10,Main,,0,0,0,,O zaman acele edin.Dialogue: 0,0:30:39.48,0:30:43.10,Main,,0,0,0,,Portgas D. Ace'in idamına götürülme vakti geldi.Dialogue: 0,0:30:45.11,0:30:48.36,Main,,0,0,0,,Yemek getirin! Çabuk!Dialogue: 0,0:30:48.36,0:30:50.40,Main,,0,0,0,,Çiğ olsa da önemli değil, mümkün olduğunca çok getirin!Dialogue: 0,0:30:51.53,0:30:54.24,Main,,0,0,0,,Çabuk! Kapının yanına koyun!Dialogue: 0,0:30:54.24,0:30:57.66,Main,,0,0,0,,Müthiş... Karınca aslanı çukuru gibi hepsini çekiyor!Dialogue: 0,0:30:57.66,0:31:00.41,Main,,0,0,0,,Daha ne kadar yiyecek?Dialogue: 0,0:31:00.41,0:31:04.00,Main,,0,0,0,,Yarım saattir bu şekilde devam ediyor!Dialogue: 0,0:31:06.55,0:31:09.26,Main,,0,0,0,,Kama Mekânı'nın birkaç günlük yiyecek stoğunu yedi.Dialogue: 0,0:31:11.22,0:31:13.68,Main,,0,0,0,,Epey etkileyici bir canlılık!Dialogue: 0,0:31:18.93,0:31:20.39,Main,,0,0,0,,Dışarı çıkıyor!Dialogue: 0,0:31:23.73,0:31:25.36,Main,,0,0,0,,O yaratık da ne?Dialogue: 0,0:31:26.11,0:31:28.63,Main,,0,0,0,,O şey insan değil!Dialogue: 0,0:31:56.39,0:31:59.95,Main,,0,0,0,,TAMAMEN...Dialogue: 0,0:32:01.64,0:32:04.52,Main,,0,0,0,,...İYİLEŞTİM!!!