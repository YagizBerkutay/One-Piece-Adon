000,&H78000000,0,-1,0,0,100,100,0,0,1,1.5,1.5,8,120,120,18,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:19.37,0:00:21.81,Main,,0,0,0,,Bara Bara Acil Kaçış!Dialogue: 0,0:00:35.87,0:00:38.98,Main,,0,0,0,,Düş ve beyninin yere yapışmasına hazır ol!Dialogue: 0,0:00:38.98,0:00:42.33,Main,,0,0,0,,Havada Dönen Sirk Çadırı!Dialogue: 0,0:00:45.47,0:00:48.52,Main,,0,0,0,,Bunu nasıl buldun, koca deniz gorili!Dialogue: 0,0:00:50.00,0:00:51.39,Main,,0,0,0,,Ne?! İşe yaramadı mı?!Dialogue: 0,0:00:52.12,0:00:53.43,Main,,0,0,0,,Çok tehlikeli!Dialogue: 0,0:00:53.43,0:00:55.30,Main,,0,0,0,,Y-Yumruklamayı kes!Dialogue: 0,0:01:10.36,0:01:13.31,Main,,0,0,0,,Ş-Şimdi biraz daha güçlü görünüyorsun.Dialogue: 0,0:01:13.86,0:01:15.64,Main,,0,0,0,,Bunlar çok zorlu!Dialogue: 0,0:01:15.64,0:01:16.81,Main,,0,0,0,,Nedir bu hayvanlar?Dialogue: 0,0:01:16.81,0:01:19.09,Main,,0,0,0,,Deniz Güreşçileri Mavi Goriller!Dialogue: 0,0:01:19.09,0:01:20.72,Main,,0,0,0,,Ya da sadece Magori.Dialogue: 0,0:01:20.72,0:01:23.26,Main,,0,0,0,,Tedbiri elden bırakma! Dört tane daha var.Dialogue: 0,0:01:23.81,0:01:26.73,Main,,0,0,0,,Onları çoktan yenmişsin!Dialogue: 0,0:01:27.34,0:01:31.67,Main,,0,0,0,,Ama bunların hepsiyle dövüşecek zamanımız yok.Dialogue: 0,0:01:31.67,0:01:34.30,Main,,0,0,0,,Bu herif müthiş! Magorileri yendi!Dialogue: 0,0:01:34.30,0:01:36.14,Main,,0,0,0,,Hey, nesin sen?!Dialogue: 0,0:01:36.14,0:01:38.01,Main,,0,0,0,,Lütfen kilidi bizim için aç!Dialogue: 0,0:01:42.60,0:01:43.37,Main,,0,0,0,,Ne var?Dialogue: 0,0:01:43.88,0:01:46.67,Main,,0,0,0,,Sadece tek mahkum serbest kalmamış mıydı?Dialogue: 0,0:01:47.70,0:01:49.09,Main,,0,0,0,,Tek kişi olduğundan gayet eminim.Dialogue: 0,0:01:49.55,0:01:53.67,Main,,0,0,0,,Belki de bana öyle geliyor, ama iki gölge gördüğüme yemin edebilirim.Dialogue: 0,0:01:53.67,0:01:57.52,Main,,0,0,0,,Neyse, Ortak Hücre 10'un önünde beş Magori yenik düştü.Dialogue: 0,0:01:57.52,0:02:00.25,Main,,0,0,0,,Beş mi? Mümkün değil!Dialogue: 0,0:02:00.25,0:02:04.48,Main,,0,0,0,,Magorileri yenebilecek Seviye Bir korsan yok!Dialogue: 0,0:02:04.48,0:02:07.27,Main,,0,0,0,,NE?!?!?!?!Dialogue: 0,0:02:07.27,0:02:09.98,Main,,0,0,0,,Ace'i kurtarmak mı istiyorsun?!Dialogue: 0,0:02:09.98,0:02:10.73,Main,,0,0,0,,Evet.Dialogue: 0,0:02:13.03,0:02:14.49,Main,,0,0,0,,Sessiz ol!Dialogue: 0,0:02:14.49,0:02:16.04,Main,,0,0,0,,Bağıran sensin.Dialogue: 0,0:02:16.04,0:02:18.94,Main,,0,0,0,,Hey, hadi ama!  Hücrenin anahtarlarını alın...Dialogue: 0,0:02:18.94,0:02:20.17,Main,,0,0,0,,Yeter artık!Dialogue: 0,0:02:20.17,0:02:21.54,Main,,0,0,0,,Kapayın çenenizi!Dialogue: 0,0:02:21.54,0:02:23.69,Main,,0,0,0,,Ace'i tanıyor musun?Dialogue: 0,0:02:24.22,0:02:25.09,Main,,0,0,0,,Tabii.Dialogue: 0,0:02:25.09,0:02:28.79,Main,,0,0,0,,Senin aksine kardeşin bir centilmen.Dialogue: 0,0:02:32.18,0:02:36.83,Main,,0,0,0,,Sonra kaynaştık ve içki arkadaşı olduk...Dialogue: 0,0:02:36.83,0:02:39.90,Main,,0,0,0,,Ona olanlar çok kötü.Dialogue: 0,0:02:40.56,0:02:44.22,Main,,0,0,0,,Beyazsakal'ın tayfasına el sürme cüretini gösterdiler. Donanma gerçekten aptal.Dialogue: 0,0:02:44.22,0:02:46.42,Main,,0,0,0,,Seviye 5'e gitmek istiyorum.Dialogue: 0,0:02:46.42,0:02:47.88,Main,,0,0,0,,Ace orada, değil mi?Dialogue: 0,0:02:47.88,0:02:50.34,Main,,0,0,0,,Umrumda değil!  Gitmek istiyorsan kendi başına git.Dialogue: 0,0:02:50.34,0:02:52.31,Main,,0,0,0,,Arkadaş falan olduğumuzu mu sanıyorsun?!Dialogue: 0,0:02:52.31,0:02:55.48,Main,,0,0,0,,O kadar tehlikeli bir yere gitmem mümkün değil.Dialogue: 0,0:02:55.48,0:02:56.98,Main,,0,0,0,,Görüşürüz.Dialogue: 0,0:02:57.82,0:03:01.89,Main,,0,0,0,,Gelmiyorsan kendim kaçacağım.Dialogue: 0,0:03:01.89,0:03:04.67,Main,,0,0,0,,Dışarıda bir düzineden fazla savaş gemisi varken mi?Dialogue: 0,0:03:04.67,0:03:05.99,Main,,0,0,0,,Gerçekten kaçabileceğini düşünüyor musun?Dialogue: 0,0:03:07.69,0:03:09.36,Main,,0,0,0,,B-Bir düzine mi?Dialogue: 0,0:03:09.36,0:03:10.92,Main,,0,0,0,,Anlıyorum.Dialogue: 0,0:03:10.92,0:03:13.10,Main,,0,0,0,,Beyazsakal'ın saldırısına hazırlanıyorlar.Dialogue: 0,0:03:14.73,0:03:16.65,Main,,0,0,0,,Belki de gitmek için kötü bir zaman.Dialogue: 0,0:03:16.65,0:03:20.04,Main,,0,0,0,,Sanırım aşağıda biraz vakit öldürebilirim.Dialogue: 0,0:03:21.35,0:03:23.77,Main,,0,0,0,,Neyse. Başkasına soracağım o zaman.Dialogue: 0,0:03:23.77,0:03:25.26,Main,,0,0,0,,Lütfen bize anahtarı ver!Dialogue: 0,0:03:27.56,0:03:29.41,Main,,0,0,0,,Hayır, mümkün değil!Dialogue: 0,0:03:29.41,0:03:32.03,Main,,0,0,0,,Olamaz!Dialogue: 0,0:03:33.50,0:03:35.50,Thoughts,,0,0,0,,Yoksa...Dialogue: 0,0:03:40.90,0:03:43.26,Main,,0,0,0,,Görüşürüz. Kaçarken iyi şanslar.Dialogue: 0,0:03:45.65,0:03:48.27,Thoughts,,0,0,0,,Hiç şüphesiz.Dialogue: 0,0:03:48.27,0:03:51.01,Main,,0,0,0,,Hey, dur, Hasır Şapka!Dialogue: 0,0:03:51.41,0:03:52.65,Main,,0,0,0,,Bu da ne?!Dialogue: 0,0:03:52.65,0:03:54.13,Main,,0,0,0,,Oradalar! Yukarıda!Dialogue: 0,0:03:54.13,0:03:55.36,Main,,0,0,0,,Bizi buldular!Dialogue: 0,0:03:55.36,0:03:58.00,Main,,0,0,0,,Niye bağırmak zorundasın?!Dialogue: 0,0:03:58.00,0:04:00.77,Main,,0,0,0,,Şu bileziğin gerçekten güzel!Dialogue: 0,0:04:00.77,0:04:01.91,Main,,0,0,0,,Bana ver!Dialogue: 0,0:04:01.91,0:04:03.24,Main,,0,0,0,,Neden bahsediyorsun?Dialogue: 0,0:04:03.24,0:04:04.62,Main,,0,0,0,,Bunu Nami'den aldım!Dialogue: 0,0:04:04.62,0:04:07.99,Main,,0,0,0,,Ace'in olduğu yere nasıl gideceğini söyleyeceğim!Dialogue: 0,0:04:10.00,0:04:10.85,Main,,0,0,0,,Cidden mi?Dialogue: 0,0:04:10.85,0:04:13.17,Main,,0,0,0,,Tabii. O bileziği verecek misin?Dialogue: 0,0:04:13.17,0:04:14.80,Main,,0,0,0,,Yardım edersen evet.Dialogue: 0,0:04:14.80,0:04:16.70,Main,,0,0,0,,Tamamdır!Dialogue: 0,0:04:17.27,0:04:19.40,Main,,0,0,0,,Önce peşimizdekilerden kurtulalım!Dialogue: 0,0:04:19.40,0:04:21.20,Main,,0,0,0,,Ayaklarımı taşı!Dialogue: 0,0:04:21.20,0:04:22.72,Main,,0,0,0,,Ayak mı?Dialogue: 0,0:04:22.72,0:04:25.04,Main,,0,0,0,,Koş, Hasır Şapka!Dialogue: 0,0:04:28.48,0:04:31.95,Main,,0,0,0,,Palyaço Buggy'nin Bara Bara Meyvesi güçlerinin açıklaması.Dialogue: 0,0:04:33.00,0:04:37.46,Main,,0,0,0,,Bedenini bölebilir ve her parçasını ayrı kontrol edebilir.Dialogue: 0,0:04:37.46,0:04:40.40,Main,,0,0,0,,Ancak kontrolü küçük bir alanla sınırlıdır.Dialogue: 0,0:04:40.40,0:04:44.85,Main,,0,0,0,,Ayrıca gücünü kullanırken ayaklarının yerde kalması gerekir.Dialogue: 0,0:04:48.49,0:04:51.10,Thoughts,,0,0,0,,Ne büyük bir şans!Dialogue: 0,0:04:57.08,0:05:00.07,Main,,0,0,0,,Kaptan! Kaptan!Dialogue: 0,0:05:01.94,0:05:03.41,Main,,0,0,0,,Ne var?Dialogue: 0,0:05:04.61,0:05:07.50,Main,,0,0,0,,Yerin burası olduğundan emin misin?Dialogue: 0,0:05:07.50,0:05:15.55,Main,,0,0,0,,Geçmişte acımasızca koruduğu hazinesini gizlemek için Kaptan John'un kazdığı efsanevi mağara?Dialogue: 0,0:05:15.55,0:05:18.25,Main,,0,0,0,,Evet, burası. Devam edin.Dialogue: 0,0:05:18.25,0:05:19.51,Main,,0,0,0,,Tamam.Dialogue: 0,0:05:20.72,0:05:22.40,Main,,0,0,0,,Dinleyin!Dialogue: 0,0:05:22.40,0:05:24.99,Main,,0,0,0,,Hazineler korumalıdır,...Dialogue: 0,0:05:24.99,0:05:27.51,Main,,0,0,0,,...bu yüzden tedbiri elden bırakırsanız, fazla uzun yaşamayabilirsiniz!Dialogue: 0,0:05:27.51,0:05:30.61,Main,,0,0,0,,Bize saldıracak canavarlarla mı karşılaşacağız?Dialogue: 0,0:05:30.61,0:05:33.11,Main,,0,0,0,,Yoksa cehennemde göreceğiniz tuzaklarla mı?Dialogue: 0,0:05:37.61,0:05:41.19,Main,,0,0,0,,Evet, bugün de kazmak için elimizden geleni yapalım!Dialogue: 0,0:05:41.19,0:05:42.28,Main,,0,0,0,,Evet patron!Dialogue: 0,0:05:42.61,0:05:44.62,Main,,0,0,0,,Oh? Siz yeni elemanlar mısınız?Dialogue: 0,0:05:46.95,0:05:50.86,Main,,0,0,0,,Ah, ter atmak gibisi yok!Dialogue: 0,0:05:50.86,0:05:57.03,Main,,0,0,0,,Kesinlikle! Terimiz er ya da geç bir tünel oluşturacak ve insanları gülümsetecek!Dialogue: 0,0:05:57.03,0:06:01.19,Main,,0,0,0,,Evet, evet! Zorlu bir çalışmanın ardından sakenin tadı biraz daha iyi oluyor!Dialogue: 0,0:06:01.95,0:06:05.46,Main,,0,0,0,,BANA BURADA NE YAPTIRIYORSUNUZ?!Dialogue: 0,0:06:07.22,0:06:12.38,Main,,0,0,0,,Daha sonra hazineyi aramak için Grand Line'a gidip geldik...Dialogue: 0,0:06:12.38,0:06:15.20,Main,,0,0,0,,...ama tek bir ipucu bile bulamadık.Dialogue: 0,0:06:15.20,0:06:20.43,Main,,0,0,0,,Ciddi anlamda yüzüme gözüme bulaştırıp, donanma üssüne daldıktan sonra tutuklandım...Dialogue: 0,0:06:20.43,0:06:24.16,Main,,0,0,0,,...ve sonra da bu hapisaneye atıldım.Dialogue: 0,0:06:26.07,0:06:30.33,Thoughts,,0,0,0,,Ama galiba şansım henüz tükenmemiş!Dialogue: 0,0:06:30.33,0:06:33.67,Main,,0,0,0,,Olabildiğince hızlı koşmaya devam et, Hasır Şapka!Dialogue: 0,0:06:33.67,0:06:36.40,Main,,0,0,0,,Seni Seviye 2'ye götüreceğim!Dialogue: 0,0:06:36.40,0:06:38.84,Main,,0,0,0,,Seviye 2? Orası değil!Dialogue: 0,0:06:38.84,0:06:41.61,Main,,0,0,0,,Ben Seviye 5'e gitmek istiyorum!Dialogue: 0,0:06:41.61,0:06:45.35,Main,,0,0,0,,Bu yüzden seni oraya götürüyorum! Doğrudan Seviye 5'e gidemezsin!Dialogue: 0,0:06:45.85,0:06:52.01,Main,,0,0,0,,Dinle. Impel Down'ın ilk su altı seviyesi, bizim bulunduğumuz Seviye 1.Dialogue: 0,0:06:52.01,0:06:55.68,Main,,0,0,0,,Seviye 2'ye, 3'e ve daha aşağı indikçe...Dialogue: 0,0:06:55.68,0:06:59.11,Main,,0,0,0,,...mahkumlar daha da sert olacak.Dialogue: 0,0:07:00.30,0:07:04.72,Main,,0,0,0,,Seviye Dört'e kadar gönderildim ve Cehennem'e maruz kaldım,...Dialogue: 0,0:07:04.72,0:07:07.50,Main,,0,0,0,,...ama onun altındaki katlar hakkında bir şey bilmiyorum.Dialogue: 0,0:07:08.06,0:07:13.87,Main,,0,0,0,,Doğru hatırlıyorsam Seviye 5, özellikle 100 milyondan fazla ödülü olan berbat suçluların tutulduğu yer.Dialogue: 0,0:07:18.29,0:07:22.58,Main,,0,0,0,,Ama mahkumların bazıları, onun altında da bir seviye olduğunu söylüyor!Dialogue: 0,0:07:22.92,0:07:27.99,Main,,0,0,0,,Tarihten silinmesi gerekecek kadar kötü adamların orada tutulduğunu söylüyorlar.Dialogue: 0,0:07:28.57,0:07:32.73,Main,,0,0,0,,Sadece bir söylenti ama Ace orada olabilir.Dialogue: 0,0:07:33.10,0:07:36.85,Main,,0,0,0,,Neyse, seni Seviye 4'ten daha aşağı götüremem.Dialogue: 0,0:07:36.85,0:07:39.90,Main,,0,0,0,,Öyle mi? Artık iyi biri misin?Dialogue: 0,0:07:41.29,0:07:47.34,Main,,0,0,0,,Elbette! Yani, bana Kaptan John'un hazinesine götürecek olan Hazine İşareti'ni veriyorsun!Dialogue: 0,0:07:48.50,0:07:50.85,Thoughts,,0,0,0,,Ona... söyledim!Dialogue: 0,0:07:51.32,0:07:53.03,Main,,0,0,0,,Sen güçsüz olduğun için buradasın, değil mi?Dialogue: 0,0:07:53.03,0:07:54.78,Main,,0,0,0,,Başkasının işine burnunu sokma! Beni rahat bırak!Dialogue: 0,0:07:56.02,0:07:57.98,Thoughts,,0,0,0,,Fark etmedi!Dialogue: 0,0:07:57.98,0:08:00.52,Thoughts,,0,0,0,,Bu herifin kalın kafalı olması iyi.Dialogue: 0,0:08:00.52,0:08:04.70,Main,,0,0,0,,Anlıyorum. Demek bu bilezik hazine haritası gibi bir şey, öyle mi?Dialogue: 0,0:08:04.70,0:08:07.02,Main,,0,0,0,,Bilmiyordum!Dialogue: 0,0:08:09.23,0:08:11.35,Main,,0,0,0,,Demek dikkat ediyordun, lanet olsun!Dialogue: 0,0:08:11.35,0:08:12.60,Main,,0,0,0,,O zaman başka çarem yok!Dialogue: 0,0:08:13.13,0:08:15.20,Main,,0,0,0,,Şimdi almana izin vereceğim.Dialogue: 0,0:08:16.27,0:08:21.02,Main,,0,0,0,,Ne kadar değerli olduğunu bilmene rağmen bana mı veriyorsun?Dialogue: 0,0:08:21.02,0:08:23.98,Main,,0,0,0,,Tabii. Ace'i kurtarmak benim için daha önemli.Dialogue: 0,0:08:23.98,0:08:28.95,Main,,0,0,0,,A-Ama onu bana şimdi verirsen, kaçıp seni burada bırakabilirim.Dialogue: 0,0:08:29.40,0:08:32.79,Main,,0,0,0,,Yapabilirsin ama bana yolu göstereceğini söyledin, değil mi?Dialogue: 0,0:08:34.60,0:08:38.84,Thoughts,,0,0,0,,Bana öyle dürüst gözlerle bakma!Dialogue: 0,0:08:38.84,0:08:43.25,Thoughts,,0,0,0,,Ben ucuz, değersiz pisliğin tekiyim!Dialogue: 0,0:08:43.25,0:08:50.44,Thoughts,,0,0,0,,Sözüme güvenemezsin!Dialogue: 0,0:08:51.72,0:08:53.60,Thoughts,,0,0,0,,Hayallerimin hazinesine giden harita,...Dialogue: 0,0:08:53.60,0:08:55.53,Thoughts,,0,0,0,,...Kaptan John'un Hazine İşaretiDialogue: 0,0:08:55.53,0:08:58.01,Thoughts,,0,0,0,,Teklifini kabul ediyorum!Dialogue: 0,0:08:58.62,0:09:00.85,Thoughts,,0,0,0,,Sana borçluyum, Hasır Şapka!Dialogue: 0,0:09:03.52,0:09:07.34,Thoughts,,0,0,0,,Şimdi bu heriften nasıl uzaklaşacağım?Dialogue: 0,0:09:12.29,0:09:14.82,Main,,0,0,0,,Ah? Duvarı yıkınca oraya daha kolay mı gideceğiz?Dialogue: 0,0:09:14.82,0:09:15.99,Main,,0,0,0,,Tamam! Ben hallederim!Dialogue: 0,0:09:15.99,0:09:17.43,Main,,0,0,0,,Hayır!Dialogue: 0,0:09:28.58,0:09:30.54,Main,,0,0,0,,Bunlar da kim?!Dialogue: 0,0:09:30.54,0:09:32.46,Main,,0,0,0,,Hücresinden kaçan Palyaço Buggy ve...Dialogue: 0,0:09:32.92,0:09:34.51,Main,,0,0,0,,O kim?! İki kişiler!Dialogue: 0,0:09:34.51,0:09:36.49,Thoughts,,0,0,0,,Burası gözlem odası!Dialogue: 0,0:09:36.49,0:09:39.18,Thoughts,,0,0,0,,Yani buradan çıkmak cidden kötü fikir olur!Dialogue: 0,0:09:39.18,0:09:41.68,Main,,0,0,0,,Dur! Hasır Şap- ah...Dialogue: 0,0:09:49.09,0:09:50.76,Main,,0,0,0,,Burası da ne böyle?!Dialogue: 0,0:09:50.76,0:09:52.57,Main,,0,0,0,,Hapishanede orman mı var?Dialogue: 0,0:10:39.16,0:10:44.92,Captions,,0,0,230,,Impel Down, Su Altı Hapishanesi  -  Seviye 1 Kızıl CehennemDialogue: 0,0:09:57.18,0:09:58.70,Main,,0,0,0,,Kırmızı bir orman?Dialogue: 0,0:09:59.09,0:10:01.41,Main,,0,0,0,,Orada da bir sürü insan var!Dialogue: 0,0:10:01.41,0:10:03.31,Main,,0,0,0,,Onlar mahkumlar!Dialogue: 0,0:10:03.31,0:10:05.95,Main,,0,0,0,,Burası sıradan bir orman değil!Dialogue: 0,0:10:05.95,0:10:09.24,Main,,0,0,0,,Ağaçlardaki bıçaklar jilet gibidir.Dialogue: 0,0:10:09.24,0:10:10.83,Main,,0,0,0,,Onlar kılıç dikenli ağaçlar!Dialogue: 0,0:10:11.48,0:10:13.91,Main,,0,0,0,,Yerden çıkan otlar,...Dialogue: 0,0:10:13.91,0:10:17.95,Main,,0,0,0,,...bedenini çivi gibi delen iğne çimenlerdir!Dialogue: 0,0:10:17.95,0:10:23.00,Main,,0,0,0,,Zehirli örümcekler ve gardiyanlar tarafından kovalanan mahkumlar,...Dialogue: 0,0:10:23.00,0:10:30.40,Main,,0,0,0,,...kendi kanlarına bulanmış yapraklar ve çimenler tarafından kesilip etrafta koşuştururlar!Dialogue: 0,0:10:30.40,0:10:33.86,Main,,0,0,0,,Cezaları, dilim dilim doğranıp kanla kaplanmak.Dialogue: 0,0:10:33.86,0:10:37.74,Main,,0,0,0,,Orası Seviye Bir, Kızıl Cehennem!Dialogue: 0,0:10:37.74,0:10:39.15,Main,,0,0,0,,İşte Impel Down böyledir!Dialogue: 0,0:10:39.33,0:10:41.75,Main,,0,0,0,,Kurtarın!Dialogue: 0,0:10:41.75,0:10:44.87,Main,,0,0,0,,Acıyor!Dialogue: 0,0:10:45.32,0:10:47.37,Main,,0,0,0,,Burası gerçekten Cehennem!Dialogue: 0,0:10:47.37,0:10:49.41,Main,,0,0,0,,Ace de bunlardan geçti mi?Dialogue: 0,0:10:49.41,0:10:52.07,Main,,0,0,0,,Anladım! Böyle düşmeye devam edebiliriz!Dialogue: 0,0:10:52.07,0:10:54.63,Main,,0,0,0,,Niye?! Delik deşik oluruz!Dialogue: 0,0:10:54.63,0:10:56.34,Main,,0,0,0,,Olmayacağım!Dialogue: 0,0:10:56.34,0:10:58.25,Main,,0,0,0,,Kapa çeneni ve tutun!Dialogue: 0,0:10:58.84,0:11:01.24,Main,,0,0,0,,Hasır Şapka! Ayaklarım!Dialogue: 0,0:11:01.24,0:11:03.50,Main,,0,0,0,,Ayaklarımı aşağı at!Dialogue: 0,0:11:03.50,0:11:05.08,Main,,0,0,0,,Ayakların?Dialogue: 0,0:11:05.08,0:11:06.08,Main,,0,0,0,,Tamam!Dialogue: 0,0:11:16.49,0:11:18.94,Main,,0,0,0,,O da ne?Dialogue: 0,0:11:18.94,0:11:21.02,Main,,0,0,0,,Çok yakındı!Dialogue: 0,0:11:22.19,0:11:25.08,Main,,0,0,0,,Ayaklarım yere bastığı sürece iyi olacağız!Dialogue: 0,0:11:25.08,0:11:28.78,Main,,0,0,0,,Bu kattan diğerine gitmek için merdivene ihtiyacımız yok!Dialogue: 0,0:11:28.78,0:11:31.58,Main,,0,0,0,,Giriş anahtarına da ihtiyacımız olmayacak!Dialogue: 0,0:11:31.96,0:11:37.81,Main,,0,0,0,,Kızıl Cehennem'de acıdan kaçmak isteyenler için hazırlanmış bir kaçış yolu olduğunu hatırladım.Dialogue: 0,0:11:37.81,0:11:39.96,Main,,0,0,0,,Cehennem'de kaçış yolu mu var?Dialogue: 0,0:11:42.65,0:11:44.56,Main,,0,0,0,,Şuna bak! İşte bu!Dialogue: 0,0:11:44.56,0:11:45.89,Main,,0,0,0,,Bir çukur?Dialogue: 0,0:11:49.55,0:11:51.16,Main,,0,0,0,,Zifiri karanlık!Dialogue: 0,0:11:51.97,0:11:56.50,Main,,0,0,0,,Bir kaçış yolu var ama buradan kaçmaya çalışan hiç kimse yok.Dialogue: 0,0:11:56.50,0:11:59.58,Main,,0,0,0,,Neden bilmek ister misin, Hasır Şapka?Dialogue: 0,0:11:59.58,0:12:03.29,Main,,0,0,0,,Çünkü bu kaçış yolu Seviye 2'ye gidiyor!Dialogue: 0,0:12:03.29,0:12:06.80,Main,,0,0,0,,Bundan daha korkunç bir Cehennem'e bağlanıyor!Dialogue: 0,0:12:07.23,0:12:10.67,Main,,0,0,0,,Cehennem'den kaçıp yüzeye çıkmak isteyen bazıları olabilir...Dialogue: 0,0:12:10.67,0:12:15.36,Main,,0,0,0,,...ama yüzeyden Cehennem'e atlayacak kadar aptal kimse yoktur!Dialogue: 0,0:12:15.36,0:12:17.82,Main,,0,0,0,,Anlıyorum!  Bu, işleri daha da kolaylaştırıyor!Dialogue: 0,0:12:17.82,0:12:19.28,Main,,0,0,0,,Sadece atlamamız gerekiyor, değil mi?Dialogue: 0,0:12:19.28,0:12:20.94,Main,,0,0,0,,Evet ama dibe varınca...Dialogue: 0,0:12:20.94,0:12:23.53,Main,,0,0,0,,HEY! HEY!Dialogue: 0,0:12:24.11,0:12:26.99,Main,,0,0,0,,Çukur cidden derin! Aşağıda ne var?Dialogue: 0,0:12:31.75,0:12:33.71,Main,,0,0,0,,Kendine hiç hakim olamıyor.Dialogue: 0,0:12:33.71,0:12:36.63,Main,,0,0,0,,Hiçbir şeyden korkmuyor mu?Dialogue: 0,0:12:37.53,0:12:38.70,Main,,0,0,0,,Neyse,...Dialogue: 0,0:12:38.70,0:12:42.18,Main,,0,0,0,,...şimdi kaçarsam peşimden gelmeyecek!Dialogue: 0,0:12:51.07,0:12:52.46,Main,,0,0,0,,Ondan kurtuldum!Dialogue: 0,0:12:52.46,0:12:55.95,Main,,0,0,0,,Nihayet hayallerimin hazinesinin işaretini ele geçirdim!Dialogue: 0,0:12:55.95,0:12:58.01,Main,,0,0,0,,Oraya giden yolu kim göstermek ister ki?Dialogue: 0,0:12:58.01,0:12:59.99,Main,,0,0,0,,Görüşürüz, Hasır Şapka!Dialogue: 0,0:12:59.99,0:13:03.87,Main,,0,0,0,,Kendi başına Seviye 3'e, 4'e ya da her nereye istersen git ve geber!Dialogue: 0,0:13:08.36,0:13:09.79,Main,,0,0,0,,Sersem Magori!Dialogue: 0,0:13:09.79,0:13:12.79,Main,,0,0,0,,Ben bölünen adamım. Kessen de bir şey olmaz!Dialogue: 0,0:13:21.86,0:13:24.59,Main,,0,0,0,,Ayaklarım...?Dialogue: 0,0:13:31.04,0:13:33.47,Main,,0,0,0,,Şaka yapıyorsun!Dialogue: 0,0:13:39.46,0:13:40.32,Main,,0,0,0,,Burası gözlem odası!Dialogue: 0,0:13:40.32,0:13:41.89,Main,,0,0,0,,Gerçekten başka biri daha vardı!Dialogue: 0,0:13:41.89,0:13:43.94,Main,,0,0,0,,İkisi de Seviye 2'ye doğru düşüyor!Dialogue: 0,0:13:43.94,0:13:45.18,Main,,0,0,0,,Lütfen teyit edin!Dialogue: 0,0:13:45.18,0:13:46.13,Main,,0,0,0,,Anlaşıldı!Dialogue: 0,0:13:58.31,0:14:04.77,Captions,,0,0,230,,Impel Down, Su Altı Hapishanesi  -  Seviye 2 Şeytani Canavar KatıDialogue: 0,0:13:58.99,0:14:03.18,Main,,0,0,0,,N-Ne? Nedense canavarlar heyecanlandı.Dialogue: 0,0:14:03.18,0:14:05.46,Main,,0,0,0,,S-Sence acıktılar mı?Dialogue: 0,0:14:14.33,0:14:19.30,Main,,0,0,0,,Artık korkacak gücüm kalmadı.Dialogue: 0,0:14:19.30,0:14:23.80,Main,,0,0,0,,Er ya da geç hepimiz onların yemi olacağız.Dialogue: 0,0:14:32.93,0:14:36.85,Main,,0,0,0,,ÇOK BÜYÜK! LANETLİ BİR CANAVAR!Dialogue: 0,0:14:38.53,0:14:39.48,Main,,0,0,0,,Bu adam...Dialogue: 0,0:14:41.43,0:14:44.78,Main,,0,0,0,,Lanet olsun! Demek söylentiler doğruymuş!Dialogue: 0,0:14:44.78,0:14:47.12,Main,,0,0,0,,Öleceğiz!Dialogue: 0,0:14:47.12,0:14:49.76,Main,,0,0,0,,Seviye 2'ye gelmek bile istememiştim!Dialogue: 0,0:14:49.76,0:14:53.10,Main,,0,0,0,,Seni geride bırakıp kaçmayı planlıyordum!Dialogue: 0,0:14:53.10,0:14:54.83,Main,,0,0,0,,Bir şey mi dedin, Buggy?Dialogue: 0,0:14:54.83,0:14:55.95,Main,,0,0,0,,Hey, o da ne öyle?!Dialogue: 0,0:14:55.95,0:14:59.66,Main,,0,0,0,,Sanırım mutantların en nadiri!Dialogue: 0,0:15:02.99,0:15:05.96,Captions,,0,0,0,,Muhafız CanavarDialogue: 0,0:14:59.66,0:15:02.96,Main,,0,0,0,,Tavuk yumurtasından çıkmış bir yılan: Basilisk!Dialogue: 0,0:15:05.95,0:15:08.37,Main,,0,0,0,,O şeyler tavuktan mı geliyor?!Dialogue: 0,0:15:08.37,0:15:10.89,Main,,0,0,0,,DALGA MI GEÇİYORSUN? BU YÜZDEN CANAVAR DENİYOR!Dialogue: 0,0:15:10.89,0:15:15.68,Main,,0,0,0,,Yüzeydeyken sadece insanlara saldırıp onları yerdi, bu yüzden muhafız olarak buraya getirmişler.Dialogue: 0,0:15:21.31,0:15:22.50,Main,,0,0,0,,Ne yapıyorsun?!Dialogue: 0,0:15:22.50,0:15:24.28,Main,,0,0,0,,Bunun için vaktim yok!Dialogue: 0,0:15:24.28,0:15:26.22,Main,,0,0,0,,Tamam, gel bakalım!Dialogue: 0,0:15:33.83,0:15:35.24,Main,,0,0,0,,Epey sıcak.Dialogue: 0,0:15:35.24,0:15:39.09,Main,,0,0,0,,Evet, Müdür Yardımcısı'nın demin söylediği gibi...Dialogue: 0,0:15:39.09,0:15:42.14,Main,,0,0,0,,...Müdür, Seviye 4 - Cehennem'de bulunuyor.Dialogue: 0,0:15:42.14,0:15:44.63,Main,,0,0,0,,Bu odayı saran muazzam bir ateş var.Dialogue: 0,0:15:46.04,0:15:47.79,Main,,0,0,0,,Geldik.Dialogue: 0,0:15:51.24,0:15:53.41,Main,,0,0,0,,Müdür nerede?Dialogue: 0,0:15:53.41,0:16:00.54,Main,,0,0,0,,Müdür Magellan'ın sindirim sorunları var ve günün on saatini midesini yatıştırmak için tuvalette geçiriyor.Dialogue: 0,0:16:00.54,0:16:02.97,Main,,0,0,0,,Uyumakla geçirdiği sekiz saatini,...Dialogue: 0,0:16:02.97,0:16:04.82,Main,,0,0,0,,...yemeğini ve molalarını da hesaba katarsak...Dialogue: 0,0:16:04.82,0:16:07.09,Main,,0,0,0,,...günde dört saat kadar çalışıyor.Dialogue: 0,0:16:07.09,0:16:09.60,Main,,0,0,0,,Buna rağmen müdürlük konumunu korumayı başarıyor mu?Dialogue: 0,0:16:09.60,0:16:11.92,Main,,0,0,0,,İş yapmaya geldiğinde çok güvenilir biridir.Dialogue: 0,0:16:12.88,0:16:15.58,Main,,0,0,0,,Beklettiğim için üzgünüm. İşte geliyor.Dialogue: 0,0:16:15.58,0:16:19.20,Main,,0,0,0,,Bahsetmeyi unuttum.  Müdür, Doku Doku Meyvesi yemiştir.Dialogue: 0,0:16:15.58,0:16:19.20,Note,,0,0,0,,Doku: ZehirDialogue: 0,0:16:19.20,0:16:20.16,Main,,0,0,0,,O, bir zehir adam.Dialogue: 0,0:16:20.16,0:16:21.55,Main,,0,0,0,,Zehir adam mı?Dialogue: 0,0:16:21.55,0:16:23.52,Main,,0,0,0,,Lütfen dikkatli olun.Dialogue: 0,0:16:27.19,0:16:28.70,Main,,0,0,0,,Sıkı çalışmanız için teşekkürler!Dialogue: 0,0:16:28.70,0:16:31.22,Main,,0,0,0,,Soylu görevinizden hoş geldiniz, Müdür Bey!!Dialogue: 0,0:16:35.49,0:16:38.31,Main,,0,0,0,,Her zamanki gibi acayip bir dövüştü.Dialogue: 0,0:16:38.31,0:16:39.79,Main,,0,0,0,,Siz, ziyaretçiler olmalısınız.Dialogue: 0,0:16:39.79,0:16:41.49,Main,,0,0,0,,Ben Müdür Magellan.Dialogue: 0,0:16:41.49,0:16:43.61,Captions,,0,0,270,,Impel Down Müdürü, MagellanDialogue: 0,0:16:41.49,0:16:43.61,Captions,,0,0,30,,(Doku Doku Meyvesi yemiş olan zehir adam)Dialogue: 0,0:16:43.61,0:16:46.94,Main,,0,0,0,,Ah, çok parlak! Çok parlak bir oda!Dialogue: 0,0:16:46.94,0:16:49.49,Main,,0,0,0,,Daha karanlık ve kapalı bir odada olmak istiyorum!Dialogue: 0,0:16:49.49,0:16:51.65,Main,,0,0,0,,Mümkünse kalbimi de kapalı tutmak isterim!Dialogue: 0,0:16:51.65,0:16:53.36,Main,,0,0,0,,Saçmalama!Dialogue: 0,0:16:53.36,0:16:58.45,Main,,0,0,0,,Müdür Bey, Koramiral Momonga ve  Shichibukai Boa Hancock-dono seni görmeye geldi.Dialogue: 0,0:16:58.45,0:17:00.59,Main,,0,0,0,,Acelemiz var, Müdür Magellan.Dialogue: 0,0:17:01.11,0:17:02.73,Main,,0,0,0,,Ah, özür dilerim.Dialogue: 0,0:17:02.73,0:17:05.35,Main,,0,0,0,,Biraz cıvık dışkı problemim var.Dialogue: 0,0:17:05.35,0:17:08.98,Main,,0,0,0,,Galiba öğlen yemeğinde yediğim zehir çorbası bana yaramadı.Dialogue: 0,0:17:08.98,0:17:10.95,Main,,0,0,0,,Başka ne bekliyorsun ki? Sonuçta zehir yedin!Dialogue: 0,0:17:10.95,0:17:14.24,Main,,0,0,0,,Zehir adam olduğum için zehirler favorimdir!Dialogue: 0,0:17:14.24,0:17:17.91,Main,,0,0,0,,Ayrıca "zehir zehiri bastırır" demezler mi?Dialogue: 0,0:17:17.91,0:17:20.65,Main,,0,0,0,,O zaman çok iyi bastırdığı için mi ishal oldun?Dialogue: 0,0:17:20.65,0:17:23.71,Main,,0,0,0,,Ah, her zamanki gibi zehir dillisin, Hannyabal.Dialogue: 0,0:17:23.71,0:17:26.31,Main,,0,0,0,,Bir an önce emekli ol da yerini alabileyim lüt-Dialogue: 0,0:17:26.31,0:17:30.50,Main,,0,0,0,,Ah, karıştırdım! Lütfen onları hemen Ateş Yumruk Ace'e götür demek istedim!Dialogue: 0,0:17:30.50,0:17:33.47,Main,,0,0,0,,Çok acımasızca!  Yaptığın hata çok acımasızcaydı!Dialogue: 0,0:17:33.47,0:17:37.33,Main,,0,0,0,,Kalpsiz bir adamım var!Dialogue: 0,0:17:39.34,0:17:40.74,Main,,0,0,0,,Bunları alın.Dialogue: 0,0:17:40.74,0:17:45.48,Main,,0,0,0,,H-Hey! N-Nefes alıp verirken dikkatli ol!Dialogue: 0,0:17:45.48,0:17:48.92,Main,,0,0,0,,Nefesinin zehirli olduğunu biliyorsun.Dialogue: 0,0:17:49.98,0:17:52.48,Main,,0,0,0,,Niye gülüyorsun?!Dialogue: 0,0:17:52.48,0:17:54.92,Main,,0,0,0,,Bunu hak ettin, ahmak adam.Dialogue: 0,0:17:54.92,0:17:57.15,Main,,0,0,0,,Nefesin de tavrın da zehirli!Dialogue: 0,0:17:59.47,0:18:03.23,Main,,0,0,0,,Tam olarak zehir solumamı sağlamaya mı çalışıyordun?!Dialogue: 0,0:18:03.23,0:18:04.05,Main,,0,0,0,,Bu ne küstahlık!Dialogue: 0,0:18:04.05,0:18:06.93,Main,,0,0,0,,Oh! Bu ne güzellik! Aşık oldum!Dialogue: 0,0:18:07.96,0:18:09.49,Main,,0,0,0,,Çok kıskanıyorum.Dialogue: 0,0:18:09.49,0:18:10.39,Main,,0,0,0,,Müdür Yardımcısı.Dialogue: 0,0:18:10.39,0:18:12.20,Main,,0,0,0,,Orası Müdür koltuğu.Dialogue: 0,0:18:12.20,0:18:13.99,Main,,0,0,0,,Er ya da geç benim olacak.Dialogue: 0,0:18:13.99,0:18:15.10,Main,,0,0,0,,Acelemiz var!Dialogue: 0,0:18:16.46,0:18:18.65,Main,,0,0,0,,Evet, ben müdürüm.Dialogue: 0,0:18:18.65,0:18:20.92,Main,,0,0,0,,Niye sen cevap veriyorsun?!Dialogue: 0,0:18:21.73,0:18:24.61,Main,,0,0,0,,Ahhh! Ölüyorum! Lanet olsun!Dialogue: 0,0:18:24.61,0:18:27.58,Main,,0,0,0,,Hep Müdür olmak istemiştim!Dialogue: 0,0:18:28.22,0:18:30.06,Main,,0,0,0,,Müdür Yardımcısı için panzehir hazırlayın.Dialogue: 0,0:18:30.06,0:18:31.21,Main,,0,0,0,,Emredersiniz!Dialogue: 0,0:18:31.57,0:18:32.93,Main,,0,0,0,,Ne?!Dialogue: 0,0:18:32.93,0:18:35.20,Main,,0,0,0,,Impel Down'ımda davetsiz misafirler mi var?!Dialogue: 0,0:18:35.20,0:18:36.24,Main,,0,0,0,,İmkansız!Dialogue: 0,0:18:36.24,0:18:42.43,Main,,0,0,0,,Kurulduğundan beri hiç güvenlik ihlali olmamış Impel Down'a biri mi girmiş?!Dialogue: 0,0:18:42.43,0:18:44.18,Main,,0,0,0,,Bu korkunç bir kriz!Dialogue: 0,0:18:44.18,0:18:45.91,Main,,0,0,0,,Sorumluluk müdürün!Dialogue: 0,0:18:45.91,0:18:47.18,Thoughts,,0,0,0,,Tespit edilmiş olabilir mi?!Dialogue: 0,0:18:47.18,0:18:50.10,Main,,0,0,0,,Tüm kamera verilerini bana aktarın!Dialogue: 0,0:18:50.10,0:18:51.52,Main,,0,0,0,,Müdür bey...Dialogue: 0,0:18:51.52,0:18:56.02,Main,,0,0,0,,...hemen mahkumu görmeye gitmek istiyorum.Dialogue: 0,0:18:56.02,0:18:58.57,Main,,0,0,0,,Tamam, gidelim! Hemen gidiyoruz!Dialogue: 0,0:18:58.57,0:19:02.86,Main,,0,0,0,,M-Müdür bey! Bu büyük bir olay!Dialogue: 0,0:19:07.05,0:19:08.43,Main,,0,0,0,,Tuhaf.Dialogue: 0,0:19:08.43,0:19:10.91,Main,,0,0,0,,Müdür Magellan'la bağlantıyı kaybettim.Dialogue: 0,0:19:10.91,0:19:15.08,Main,,0,0,0,,Neyse, bunu tüm katlara ve Donanma Karargâhı'na bildirin.Dialogue: 0,0:19:15.69,0:19:18.80,Main,,0,0,0,,Buraya nasıl girdiğini veya ne istediğini bilmiyorum...Dialogue: 0,0:19:18.80,0:19:22.82,Main,,0,0,0,,...ama Seviye 2'de  Palyaço Buggy'yle koşturan adam...Dialogue: 0,0:19:22.82,0:19:25.72,Main,,0,0,0,,...hiç şüphesiz korsan Hasır Şapkalı Luffy!Dialogue: 0,0:19:26.09,0:19:29.17,Main,,0,0,0,,Seviye 2'deki gözlem odasıyla bağlantı kuramıyorsuz!Dialogue: 0,0:19:29.17,0:19:30.34,Main,,0,0,0,,Ne?!Dialogue: 0,0:19:30.97,0:19:33.45,Main,,0,0,0,,Seviye 2 gözlem odası! Bir şey mi oldu?Dialogue: 0,0:19:33.45,0:19:35.75,Main,,0,0,0,,Yanıt verin, gözlem odası!Dialogue: 0,0:19:40.17,0:19:41.11,Main,,0,0,0,,Tamam!Dialogue: 0,0:19:41.11,0:19:43.46,Main,,0,0,0,,Eli kocaman oldu!Dialogue: 0,0:19:45.65,0:19:47.56,Main,,0,0,0,,Demin ne yaptın öyle?!Dialogue: 0,0:19:47.56,0:19:49.11,Main,,0,0,0,,Üçüncü Vites.Dialogue: 0,0:19:50.47,0:19:52.28,Main,,0,0,0,,Nasılsa onu yenmeyi başardık.Dialogue: 0,0:19:53.04,0:19:56.03,Main,,0,0,0,,Tamam, normale döndüm!Dialogue: 0,0:19:56.03,0:19:57.59,Main,,0,0,0,,Hemen Seviye 3'e gidelim!Dialogue: 0,0:19:57.59,0:20:00.86,Main,,0,0,0,,Kamiler bizi Cehennem'den kurtarmaya gelmiş!Dialogue: 0,0:20:00.86,0:20:03.72,Main,,0,0,0,,Müthiş, o canavarı yendiler!Dialogue: 0,0:20:05.02,0:20:07.06,Main,,0,0,0,,Basilisk'i yendiler!Dialogue: 0,0:20:07.06,0:20:08.78,Main,,0,0,0,,Başardınız!Dialogue: 0,0:20:08.78,0:20:10.45,Main,,0,0,0,,Müthişsiniz!Dialogue: 0,0:20:10.45,0:20:12.86,Main,,0,0,0,,Üstelik onu gözlem odasına çarptınız!Dialogue: 0,0:20:12.86,0:20:15.54,Main,,0,0,0,,İnanılmaz! Siz kami-sama'sınız!Dialogue: 0,0:20:17.83,0:20:20.81,Main,,0,0,0,,Kim olduğunuzu bilmiyorum ama sağolun!Dialogue: 0,0:20:20.81,0:20:23.01,Main,,0,0,0,,Bizim için anahtarları alabilir misiniz?Dialogue: 0,0:20:23.01,0:20:25.16,Main,,0,0,0,,Hücrelerin ve kelepçelerin anahtarları!Dialogue: 0,0:20:25.16,0:20:28.13,Main,,0,0,0,,Oradalar!Dialogue: 0,0:20:28.13,0:20:29.87,Main,,0,0,0,,O...Dialogue: 0,0:20:30.19,0:20:32.16,Main,,0,0,0,,Devam edelim!Dialogue: 0,0:20:32.16,0:20:33.91,Main,,0,0,0,,Sabırsızlanma.Dialogue: 0,0:20:33.91,0:20:35.21,Main,,0,0,0,,Acelem var!Dialogue: 0,0:20:36.47,0:20:38.34,Main,,0,0,0,,Hasır Şapkalı Luffy!Dialogue: 0,0:20:38.34,0:20:40.07,Main,,0,0,0,,O niye burada?!Dialogue: 0,0:20:40.07,0:20:45.18,Main,,0,0,0,,Hayır, hücresinden çıkmış olması özgürlüğünü geri almaya çalıştığı anlamına gelir!Dialogue: 0,0:20:45.62,0:20:50.45,Main,,0,0,0,,Bundan faydanalanabilir ve özgürlüğümü geri almak için kullanabilirim!Dialogue: 0,0:20:50.45,0:20:54.35,Main,,0,0,0,,Görünüşe göre İyi Talih Kamisi beni henüz terk etmemiş!Dialogue: 0,0:20:57.02,0:20:59.15,Main,,0,0,0,,Bunu istiyorsunuz, değil mi?!Dialogue: 0,0:20:59.15,0:21:01.15,Main,,0,0,0,,EVET!Dialogue: 0,0:21:01.15,0:21:02.70,Main,,0,0,0,,Elbette istiyoruz!Dialogue: 0,0:21:02.70,0:21:04.53,Main,,0,0,0,,Hemen onu bize ver!Dialogue: 0,0:21:05.85,0:21:08.70,Main,,0,0,0,,Birinden iyilik isterken takınmanız gereken tavır bu mu?Dialogue: 0,0:21:09.18,0:21:10.13,Main,,0,0,0,,Üzgünüz!Dialogue: 0,0:21:10.13,0:21:12.66,Main,,0,0,0,,Tamam, anahtarları size vereceğim!Dialogue: 0,0:21:12.66,0:21:17.21,Main,,0,0,0,,Bana, büyük Kaptan Buggy-sama'ya minnettar olmalısınız!Dialogue: 0,0:21:21.93,0:21:24.10,Main,,0,0,0,,Tamam! Açıldı!Dialogue: 0,0:21:26.41,0:21:28.52,Main,,0,0,0,,Minnettar olun, sizi ahmaklar!Dialogue: 0,0:21:28.52,0:21:31.45,Main,,0,0,0,,Sizi özgür bırakan adamın adını söyleyin!Dialogue: 0,0:21:31.45,0:21:32.95,Main,,0,0,0,,Kaptan Buggy!Dialogue: 0,0:21:32.95,0:21:34.90,Main,,0,0,0,,Bizim için yaptığını asla unutmayacağız!Dialogue: 0,0:21:34.90,0:21:37.65,Main,,0,0,0,,Kaptan Buggy, kurtarıcımızsın!Dialogue: 0,0:21:39.38,0:21:42.42,Main,,0,0,0,,Evet! O adı kalplerinize kazıyın!Dialogue: 0,0:21:42.42,0:21:45.97,Main,,0,0,0,,Şimdi tüm hücreleri açın!Dialogue: 0,0:21:46.38,0:21:48.24,Thoughts,,0,0,0,,Buraya düşmem bir kazaydı...Dialogue: 0,0:21:48.24,0:21:51.51,Thoughts,,0,0,0,,...ama burada ayaklanma çıkarırsam kaçmam daha kolay olacak!Dialogue: 0,0:21:54.24,0:21:56.56,Main,,0,0,0,,Şimdi tatmin oldun mu?Dialogue: 0,0:21:56.27,0:21:57.58,Secondary,,0,0,0,,Bırak beni!Dialogue: 0,0:21:57.58,0:21:59.55,Secondary,,0,0,0,,Hey, Hasır Şapka!Dialogue: 0,0:21:56.56,0:21:58.32,Main,,0,0,0,,Şimdi bana yardım etmelisin!Dialogue: 0,0:21:58.32,0:22:00.64,Main,,0,0,0,,Hemen bana yolu göster!Dialogue: 0,0:22:00.64,0:22:03.41,Main,,0,0,0,,Önceki gibi bizi aşağı götürecek bir çukur mu var?Dialogue: 0,0:22:03.41,0:22:06.07,Main,,0,0,0,,Seviye 3'e nasıl gidileceğini bilmiyorum!Dialogue: 0,0:22:06.07,0:22:10.08,Main,,0,0,0,,Bu hapisane labirentindeki tüm geçitleri hatırlamam mümkün değil!Dialogue: 0,0:22:11.52,0:22:13.87,Main,,0,0,0,,Sağolun, Kaptan Buggy!Dialogue: 0,0:22:13.87,0:22:16.21,Main,,0,0,0,,Artık biz de özgürüz!Dialogue: 0,0:22:27.85,0:22:29.68,Main,,0,0,0,,Kes şunu, Hasır Şapka!Dialogue: 0,0:22:29.68,0:22:30.74,Main,,0,0,0,,Ne diyorsun?!Dialogue: 0,0:22:30.74,0:22:33.90,Main,,0,0,0,,Beni Seviye 4'e götüreceğini söylemiştin!Dialogue: 0,0:22:33.90,0:22:35.10,Main,,0,0,0,,Yalandı! Yalan!Dialogue: 0,0:22:35.10,0:22:37.58,Main,,0,0,0,,Hazineyi almak için yalan söyledim!Dialogue: 0,0:22:38.28,0:22:42.35,Main,,0,0,0,,Tüm mahkumlar benim menfaatime bu katta kargaşa çıkaracak!Dialogue: 0,0:22:43.44,0:22:45.49,Main,,0,0,0,,Bana yalan mı söyledin?!Dialogue: 0,0:22:54.04,0:22:56.23,Main,,0,0,0,,Neyiniz var sizin?!Dialogue: 0,0:22:56.23,0:22:58.71,Main,,0,0,0,,Bu, kaçmanız için büyük bir fırsat değil miydi?!Dialogue: 0,0:22:59.08,0:23:02.13,Main,,0,0,0,,Ah, galiba biraz çizgiyi aştık.Dialogue: 0,0:23:02.13,0:23:03.66,Main,,0,0,0,,Burada fırsatımız yok.Dialogue: 0,0:23:03.66,0:23:05.90,Main,,0,0,0,,Bu katın patronu burada olduğu sürece fırsatımız yok.Dialogue: 0,0:23:05.90,0:23:08.68,Main,,0,0,0,,Evet, hücremizde olsak daha iyi.Dialogue: 0,0:23:10.34,0:23:13.77,Main,,0,0,0,,Tamam, Hasır Şapka! Sana Seviye 3'e nasıl gidileceğini söyleyeceğim.Dialogue: 0,0:23:14.19,0:23:17.54,Main,,0,0,0,,HEY! DEMİN BİLMEDİĞİNİ SÖYLEMEDİN Mİ, KOCA BURUN?!Dialogue: 0,0:23:17.54,0:23:19.96,Main,,0,0,0,,SEN KİME KOCA BURUN DİYORSUN?!Dialogue: 0,0:23:19.96,0:23:24.11,Main,,0,0,0,,Bu katta yolunuzu bulmakta sıkıntı çekiyorsanız size yardım etmeme ne dersiniz?Dialogue: 0,0:23:25.38,0:23:26.95,Main,,0,0,0,,O da kim?Dialogue: 0,0:23:28.12,0:23:30.82,Main,,0,0,0,,Epey uzun zaman oldu, Hasır Şapkalı Luffy.Dialogue: 0,0:23:30.82,0:23:34.26,Main,,0,0,0,,Görünüşe göre sayende özgür bir adam oldum.Dialogue: 0,0:23:34.26,0:23:37.14,Main,,0,0,0,,Ben her zaman borcunu ödeyen bir adamım.Dialogue: 0,0:23:37.14,0:23:38.31,Main,,0,0,0,,Sen kimsin?Dialogue: 0,0:23:40.50,0:23:42.42,Main,,0,0,0,,Ah, o "3" ün anlamı...Dialogue: 0,0:23:45.39,0:23:48.64,Main,,0,0,0,,Sen devlerin adasındaki adamsın!Dialogue: 0,0:23:48.64,0:23:49.46,Main,,0,0,0,,Üç!Dialogue: 0,0:23:49.46,0:23:50.73,Main,,0,0,0,,Bay Üç!Dialogue: 0,0:23:54.33,0:23:58.38,Captions,,0,0,280,,Mahkum Numarası D-0464 Eski Baroque Works Ajanı Bay 3Dialogue: 0,0:24:09.39,0:24:10.38,Main,,0,0,0,,Kimsenin...Dialogue: 0,0:24:13.88,0:24:16.15,Main,,0,0,0,,...kaçtığı yok!Dialogue: 0,0:24:23.90,0:24:26.45,Main,,0,0,0,,Kaşınan yere bile vurmadı.Dialogue: 0,0:24:27.50,0:24:32.00,Main,,0,0,0,,Epey hırpalanmışsın, değil mi patron?Dialogue: 0,0:24:33.59,0:24:36.12,Main,,0,0,0,,Acı içinde olan bedenim değil.Dialogue: 0,0:24:36.12,0:24:37.44,Main,,0,0,0,,Ace-san...Dialogue: 0,0:24:37.44,0:24:38.67,Main,,0,0,0,,...acı...Dialogue: 0,0:24:40.05,0:24:44.87,Main,,0,0,0,,...içinde olan, doğru olanı yapamadığım için, kalbim.Dialogue: 0,0:24:43.90,0:24:47.36,Captions,,0,0,340,,Shichibukai Denizin İlk Oğlu, Jinbei (Balina Köpekbalığı Balık Adam, Ödül: 250 milyon beli)Dialogue: 0,0:24:48.20,0:24:49.22,Main,,0,0,0,,Jinbei...Dialogue: 0,0:24:49.22,0:24:53.48,Main,,0,0,0,,İşler bu durumdayken ölümü kabul edemem!Dialogue: 0,0:24:53.48,0:24:56.34,Main,,0,0,0,,Shichibukai unvanımı alırlarsa ne olmuş?Dialogue: 0,0:24:56.34,0:24:58.19,Main,,0,0,0,,Ona ihtiyacım yok!Dialogue: 0,0:25:00.15,0:25:02.74,Main,,0,0,0,,Bu savaşı engelleyebilseydim...Dialogue: 0,0:25:04.50,0:25:08.57,Main,,0,0,0,,...canımı seve seve verirdim.Dialogue: 0,0:25:08.60,0:25:13.60,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.net