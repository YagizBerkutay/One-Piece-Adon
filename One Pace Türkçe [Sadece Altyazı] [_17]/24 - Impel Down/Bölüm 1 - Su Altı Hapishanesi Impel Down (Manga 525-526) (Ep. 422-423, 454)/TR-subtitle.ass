0,100,0,0,1,1.5,1.5,8,120,120,18,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:03.62,0:00:08.88,Captions,,0,0,230,,Grand Line Momoiro Adası (Kamabakka Krallığı)Dialogue: 0,0:00:11.78,0:00:13.78,Main,,0,0,0,,Burası neresi?Dialogue: 0,0:00:13.78,0:00:15.49,Main,,0,0,0,,Ve daha önemlisi...Dialogue: 0,0:00:16.37,0:00:18.62,Main,,0,0,0,,Bu adamların nesi var!?Dialogue: 0,0:00:34.32,0:00:36.30,Main,,0,0,0,,Kahretsin...Dialogue: 0,0:00:41.56,0:00:45.06,Thoughts,,0,0,0,,Sevgili Nami-san, Robin-chan...Dialogue: 0,0:00:45.06,0:00:47.09,Thoughts,,0,0,0,,İyi misiniz?Dialogue: 0,0:00:47.09,0:00:50.36,Thoughts,,0,0,0,,Sizi görmek için sabırsızlanıyorum.Dialogue: 0,0:00:52.00,0:00:56.57,Thoughts,,0,0,0,,Görüştüğümüzde çok iyi arkadaş olacağımızdan eminim.Dialogue: 0,0:03:00.88,0:03:15.98,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:13:59.00,0:14:09.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:27:31.30,0:27:34.40,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazasker thx to onepace.netDialogue: 0,0:03:00.88,0:03:15.98,Title,,0,0,580,,Su Altı HapishanesiDialogue: 0,0:03:00.88,0:03:15.98,Title,,0,0,150,,Impel DownDialogue: 0,0:03:20.27,0:03:25.81,Main,,0,0,0,,Senin ve Luffy'nin büyük denizciler olmanızı istemiştim...Dialogue: 0,0:03:25.81,0:03:32.10,Main,,0,0,0,,Denizciler bir yana, iki kardeş kötülüğüyle nam salmış haydutlar oldunuz.Dialogue: 0,0:03:32.10,0:03:35.75,Main,,0,0,0,,Eminim Luffy hakkındaki söylentileri de duymuşsundur.Dialogue: 0,0:03:35.75,0:03:39.58,Main,,0,0,0,,Water 7'da, Dünya Hükümeti'yle kavga etti...Dialogue: 0,0:03:39.58,0:03:43.75,Main,,0,0,0,,...ve bir şekilde Kanun Adası Enies Lobby'yi istila etmeyi başardı.Dialogue: 0,0:03:48.87,0:03:54.16,Main,,0,0,0,,Ah, evet. Luffy'ye babasından da bahsettim.Dialogue: 0,0:03:57.31,0:04:01.37,Main,,0,0,0,,Babası olduğunu duyunca gerçekten çok şaşırdı.Dialogue: 0,0:04:02.20,0:04:04.05,Main,,0,0,0,,Önemi yok...Dialogue: 0,0:04:04.05,0:04:06.11,Main,,0,0,0,,Bunun ne kadar sinir bozucu...Dialogue: 0,0:04:06.11,0:04:07.95,Main,,0,0,0,,...olduğunu bilsek de bilmesek de,...Dialogue: 0,0:04:07.95,0:04:12.48,Main,,0,0,0,,...Luffy ve ben, dünya çapında meşhur suçluların kanını taşıyoruz.Dialogue: 0,0:04:12.48,0:04:15.65,Main,,0,0,0,,Denizci olabilmemiz mümkün değildi.Dialogue: 0,0:04:16.53,0:04:21.32,Main,,0,0,0,,Anneme bir minnet borcum olmasına ve "Portgas" adını almama rağmen,...Dialogue: 0,0:04:21.32,0:04:25.81,Main,,0,0,0,,...hala değersiz babamın kanını taşıdığım düşüncesine dayanamıyorum.Dialogue: 0,0:04:25.81,0:04:29.89,Main,,0,0,0,,Onu hiç hatırlamıyorum ve ona hiç de bir şey borçlu değilim.Dialogue: 0,0:04:29.89,0:04:34.96,Main,,0,0,0,,Evet, demek istediğini anlıyorum, ama o sadece...Dialogue: 0,0:04:33.40,0:04:34.96,Secondary,,0,0,0,,Bu yüzden...Dialogue: 0,0:04:37.61,0:04:39.00,Main,,0,0,0,,Yaşlı adam...Dialogue: 0,0:04:42.11,0:04:45.85,Main,,0,0,0,,Şu anda ölüşünü görmek hoşuma gitmez, evlat.Dialogue: 0,0:04:49.26,0:04:54.35,Main,,0,0,0,,Adımı alıp denizlerde çılgınca ve özgürce dolaş!Dialogue: 0,0:04:54.35,0:04:56.79,Main,,0,0,0,,Oğlum ol!Dialogue: 0,0:05:01.80,0:05:03.94,Main,,0,0,0,,Benim babam...Dialogue: 0,0:05:06.74,0:05:08.87,Main,,0,0,0,,...Beyazsakal, başkası değil.Dialogue: 0,0:05:18.33,0:05:19.48,Main,,0,0,0,,Koramiral Momonga!Dialogue: 0,0:05:19.48,0:05:21.01,Main,,0,0,0,,Bir korsan gemisi tespit ettik.Dialogue: 0,0:05:21.01,0:05:22.93,Main,,0,0,0,,Kimin gemisi?Dialogue: 0,0:05:22.93,0:05:26.36,Main,,0,0,0,,O işareti daha daha önce gördüğümü biliyorum...Dialogue: 0,0:05:26.36,0:05:27.77,Main,,0,0,0,,Hemen araştıracağım!Dialogue: 0,0:05:27.77,0:05:29.97,Main,,0,0,0,,Düşünmeden hatırlayamıyorsan...Dialogue: 0,0:05:29.97,0:05:32.31,Main,,0,0,0,,...önemli biri olamaz.Dialogue: 0,0:05:32.31,0:05:33.82,Main,,0,0,0,,Boş verin.Dialogue: 0,0:05:33.82,0:05:36.71,Main,,0,0,0,,Hemen hedefimize ulaşmalıyız.Dialogue: 0,0:05:36.71,0:05:37.65,Main,,0,0,0,,Emredersiniz!Dialogue: 0,0:05:41.69,0:05:44.24,Main,,0,0,0,,İşte! Dev bir Deniz Kralı!Dialogue: 0,0:05:44.24,0:05:48.62,Main,,0,0,0,,O şey bizi tespit ederse tüm gemiyi yutabilir!Dialogue: 0,0:05:50.30,0:05:52.31,Main,,0,0,0,,Lütfen bu tarafa bakma.Dialogue: 0,0:05:54.35,0:05:56.13,Main,,0,0,0,,Gitti.Dialogue: 0,0:05:56.13,0:05:59.59,Main,,0,0,0,,Bu kadar geldik...Dialogue: 0,0:05:59.59,0:06:02.53,Main,,0,0,0,,...ama devam edersek ne yapabiliriz bilmiyorum!Dialogue: 0,0:06:02.53,0:06:07.60,Main,,0,0,0,,Şimdi ne yapacağız, Alvida abla?Dialogue: 0,0:06:08.39,0:06:10.39,Main,,0,0,0,,Bana bakmayın.Dialogue: 0,0:06:10.39,0:06:14.21,Main,,0,0,0,,Buraya gelmek isteyen sizdiniz, değil mi?Dialogue: 0,0:06:14.21,0:06:17.57,Main,,0,0,0,,O Daimi Seyir'e de çok para harcadınız.Dialogue: 0,0:06:17.57,0:06:24.25,Main,,0,0,0,,Ama Impel Down'a götürülen Kaptan Buggy'yi kurtarmalıyız!Dialogue: 0,0:06:27.23,0:06:28.66,Main,,0,0,0,,Denize bir bakın.Dialogue: 0,0:06:28.66,0:06:30.93,Main,,0,0,0,,Sükunet Kuşağı buranın biraz ilerisinde yer alır.Dialogue: 0,0:06:30.93,0:06:32.67,Main,,0,0,0,,Orası canavar yuvası.Dialogue: 0,0:06:32.67,0:06:35.59,Main,,0,0,0,,Gerçekten bu gemiyle geçmeyi başarabileceğimizi düşünüyor musunuz?Dialogue: 0,0:06:35.59,0:06:41.26,Main,,0,0,0,,Tek yol oraya bir donanma gemisi ile gitmek.Dialogue: 0,0:06:41.26,0:06:45.97,Main,,0,0,0,,Sonuçta Adalet Kapıları bir korsan gemisi için açılmaz.Dialogue: 0,0:06:45.97,0:06:49.36,Main,,0,0,0,,Olamaz! Yani oraya giremeyiz mi?Dialogue: 0,0:06:49.36,0:06:53.47,Main,,0,0,0,,Bu durumda Kaptan Buggy ölüme mahkum olacak!Dialogue: 0,0:06:53.47,0:06:57.47,Main,,0,0,0,,Yeni arkadaşımız Ace-kun'la birlikte!Dialogue: 0,0:06:59.53,0:07:06.31,Main,,0,0,0,,Impel Down, zorla girmenin veya kaçmanın imkansız olduğu, dünyanın en büyük hapishanesidir.Dialogue: 0,0:07:07.13,0:07:10.37,Main,,0,0,0,,Vazgeçmelisiniz artık.Dialogue: 0,0:07:10.37,0:07:14.17,Main,,0,0,0,,Bu, Palyaço Buggy'nin korsan olarak şansının tükendiği anlamına geliyor.Dialogue: 0,0:07:15.07,0:07:17.03,Main,,0,0,0,,Bu doğru değil!Dialogue: 0,0:07:17.03,0:07:21.43,Main,,0,0,0,,Kaptan Buggy böyle bir şeyden ötürü ölmezdi!Dialogue: 0,0:07:21.43,0:07:24.72,Main,,0,0,0,,Evet! Nihayet aradığımız şeyi bulana kadar...Dialogue: 0,0:07:24.72,0:07:28.10,Main,,0,0,0,,...Kaptan Buggy'yi takip etmeye yemin ettik:Dialogue: 0,0:07:28.10,0:07:31.51,Main,,0,0,0,,Kaptan John'un hazine adası!Dialogue: 0,0:07:35.44,0:07:37.88,Main,,0,0,0,,Richie!Dialogue: 0,0:07:37.88,0:07:39.93,Main,,0,0,0,,Ne isterseniz yapın o zaman.Dialogue: 0,0:07:40.77,0:07:43.72,Main,,0,0,0,,Big Top'u ben alacağım.Dialogue: 0,0:07:43.72,0:07:45.99,Main,,0,0,0,,Siz kayıkla gidebilirsiniz.Dialogue: 0,0:07:47.14,0:07:50.41,Main,,0,0,0,,Olmaz! Bu Kaptan Buggy'nin gemisi!Dialogue: 0,0:07:51.79,0:07:54.33,Main,,0,0,0,,Buggy burada değil, değil mi?!Dialogue: 0,0:07:55.17,0:07:56.83,Main,,0,0,0,,Evet. Haklısın.Dialogue: 0,0:07:57.63,0:08:01.65,Main,,0,0,0,,Oraya gidersek hepimizin öleceğini biliyorum, bu yüzden gitmiyorum.Dialogue: 0,0:08:01.65,0:08:03.71,Main,,0,0,0,,Gemiyi götürmek de büyük kayıp olurdu.Dialogue: 0,0:08:04.36,0:08:09.30,Main,,0,0,0,,Tatmin olana dek kayıkla Buggy'nin peşinden gidebilirsiniz.Dialogue: 0,0:08:10.05,0:08:12.27,Main,,0,0,0,,Evet!Dialogue: 0,0:08:12.27,0:08:16.60,Main,,0,0,0,,Muhtemelen Impel Down'u bile göremeden öleceksiniz.Dialogue: 0,0:08:18.60,0:08:24.03,Main,,0,0,0,,Kaptan Buggy! Her şey için çok sağol!Dialogue: 0,0:08:24.03,0:08:27.66,Main,,0,0,0,,Bizim için yaptıklarını asla unutmayacağız!Dialogue: 0,0:08:29.41,0:08:31.39,Main,,0,0,0,,İdamının çabuk ve acısız olması için dua edeceğiz!Dialogue: 0,0:08:31.39,0:08:32.87,Main,,0,0,0,,Elveda!Dialogue: 0,0:08:32.87,0:08:35.39,Main,,0,0,0,,Sonraki hayatta yeniden buluşalım!Dialogue: 0,0:08:39.88,0:08:41.23,Main,,0,0,0,,Ben Momonga.Dialogue: 0,0:08:41.23,0:08:44.13,Main,,0,0,0,,Denizci kodu G-1-0-0-6-6-0.Dialogue: 0,0:08:44.13,0:08:46.00,Main,,0,0,0,,Birazdan akıntıya gireceğim.Dialogue: 0,0:08:46.00,0:08:47.59,Main,,0,0,0,,Kapıları açmaya hazırlanın!Dialogue: 0,0:08:47.09,0:08:58.52,Captions,,0,0,0,,Enies LobbyDialogue: 0,0:08:47.09,0:08:58.52,Captions,,0,0,0,,Donanma Karargâhı (Marineford)Dialogue: 0,0:08:47.09,0:08:58.52,Captions,,0,0,0,,MariejoisDialogue: 0,0:08:47.09,0:08:58.52,Captions,,0,0,0,,Sabaody TakımadalarıDialogue: 0,0:08:47.09,0:08:58.52,Captions,,0,0,0,,Büyük Hapishane Impel DownDialogue: 0,0:08:47.09,0:08:58.52,Captions,,0,0,0,,Mevcut konumDialogue: 0,0:08:47.09,0:08:58.52,Captions,,0,0,0,,Amazon LilyDialogue: 0,0:08:48.97,0:08:51.35,Narrator,,0,0,0,,Luffy ve Hancock'ı taşıyan gemi...Dialogue: 0,0:08:51.35,0:08:54.35,Narrator,,0,0,0,,...Dünya Hükümeti'nin üç ana tesisini birbirine bağlayan,...Dialogue: 0,0:08:54.35,0:08:55.84,Narrator,,0,0,0,,...sadece donanmanın kullanabildiği...Dialogue: 0,0:08:55.84,0:08:58.52,Narrator,,0,0,0,,...Tarai Akıntısı'na girmek üzere.Dialogue: 0,0:08:58.94,0:09:04.90,Captions,,0,0,240,,Büyük Su Altı HapishanesiDialogue: 0,0:08:58.94,0:09:04.90,Captions,,0,0,0,,Impel DownDialogue: 0,0:09:20.75,0:09:22.71,Main,,0,0,0,,Lütfen beni öldürün!Dialogue: 0,0:09:25.17,0:09:27.09,Main,,0,0,0,,Hey! Çaylak!Dialogue: 0,0:09:28.13,0:09:29.55,Main,,0,0,0,,Niye önce bu hücrenin...Dialogue: 0,0:09:29.55,0:09:33.55,Main,,0,0,0,,...patronunu selamlamadan, orada oturmuş ekmeğini zıkkımlanıyorsun?Dialogue: 0,0:09:34.77,0:09:40.42,Main,,0,0,0,,Çaylakların yemeklerini patrona sunmaları burada kuraldır!Dialogue: 0,0:09:50.57,0:09:52.81,Main,,0,0,0,,Henüz dersini almadın mı?Dialogue: 0,0:10:14.85,0:10:17.34,Main,,0,0,0,,Hey! Dur!Dialogue: 0,0:10:17.34,0:10:19.38,Main,,0,0,0,,Sadece ufak bir kavga yapıyorduk!Dialogue: 0,0:10:19.38,0:10:21.72,Main,,0,0,0,,İdam mahkumu falan değiliz!Dialogue: 0,0:10:21.72,0:10:22.60,Main,,0,0,0,,Çıkar bizi!Dialogue: 0,0:10:52.10,0:10:55.11,Narrator,,0,0,0,,Kadınlar Adası Amazon Lily'den...Dialogue: 0,0:10:55.11,0:10:58.47,Narrator,,0,0,0,,...çıktıktan bu yana dört buçuk gün geçti.Dialogue: 0,0:11:02.48,0:11:03.90,Main,,0,0,0,,Koramiral Momonga!Dialogue: 0,0:11:03.90,0:11:07.09,Main,,0,0,0,,Pruva rüzgarı bizi biraz yavaşlattı...Dialogue: 0,0:11:07.09,0:11:09.83,Main,,0,0,0,,...ama nihayet Impel Down'a ulaştık!Dialogue: 0,0:11:11.54,0:11:13.90,Main,,0,0,0,,Durum kötü. Acele etmeliyiz.Dialogue: 0,0:11:13.90,0:11:15.97,Main,,0,0,0,,Hancock'u getirin!Dialogue: 0,0:11:15.97,0:11:16.95,Main,,0,0,0,,Emredersiniz!Dialogue: 0,0:11:16.95,0:11:19.62,Main,,0,0,0,,Hancock-dono! Geldik!Dialogue: 0,0:11:19.62,0:11:20.82,Main,,0,0,0,,Birazdan orada olacağım.Dialogue: 0,0:11:20.82,0:11:22.40,Main,,0,0,0,,Bu da ne?Dialogue: 0,0:11:22.40,0:11:25.04,Main,,0,0,0,,Burada Yıkım Çağrısı'ndakinden daha fazla savaş gemisi var!Dialogue: 0,0:11:25.83,0:11:29.50,Main,,0,0,0,,Şu anda burası dünyadaki en tehlikeli yer.Dialogue: 0,0:11:29.50,0:11:31.60,Main,,0,0,0,,İyi korunacağı aşikar.Dialogue: 0,0:11:32.63,0:11:35.34,Main,,0,0,0,,Peki Ace içeride mi?Dialogue: 0,0:11:35.90,0:11:38.95,Main,,0,0,0,,Muhtemelen yüzeyin çok altında.Dialogue: 0,0:11:38.95,0:11:41.18,Main,,0,0,0,,Şimdi elbiselerimin altına saklan.Dialogue: 0,0:11:46.13,0:11:49.19,Main,,0,0,0,,Hoşgeldiniz, Koramiral Momonga!Dialogue: 0,0:11:56.46,0:11:59.03,Main,,0,0,0,,Ş-Şuna bakın!Dialogue: 0,0:11:59.03,0:12:01.05,Main,,0,0,0,,Korsan İmparatoriçesi!Dialogue: 0,0:12:01.05,0:12:02.79,Main,,0,0,0,,Herkesten daha güzel!Dialogue: 0,0:12:02.79,0:12:05.33,Main,,0,0,0,,Güzelliğinin sınırı yok!Dialogue: 0,0:12:05.33,0:12:09.99,Main,,0,0,0,,Güzellik Gücü ne kadar yükselebilir? On bin watt mı? Milyon mu?Dialogue: 0,0:12:11.65,0:12:13.86,Main,,0,0,0,,Bu yaygara da neyin nesi?Dialogue: 0,0:12:13.86,0:12:15.81,Main,,0,0,0,,Ne gürültücü bir topluluk.Dialogue: 0,0:12:15.81,0:12:17.29,Main,,0,0,0,,Onları taşa çevirebilir miyim?Dialogue: 0,0:12:18.40,0:12:20.05,Main,,0,0,0,,Lütfen yapma.Dialogue: 0,0:12:20.05,0:12:24.13,Main,,0,0,0,,Donanmanın daha fazla küçük düşürülmeye ihtiyacı yok.Dialogue: 0,0:12:24.72,0:12:28.54,Main,,0,0,0,,Bize yardım etmek için öne sürdüğün şart;  bu olayların merkezindeki adamı,...Dialogue: 0,0:12:28.54,0:12:31.77,Main,,0,0,0,,...Portgas D. Ace'i görmek istemendi, değil mi?Dialogue: 0,0:12:31.77,0:12:33.33,Main,,0,0,0,,Daha önce söylemiştim,...Dialogue: 0,0:12:33.33,0:12:37.32,Main,,0,0,0,,...genelde burası korsanlar için,  hatta Shichibukai için bile kesinlikle yasaktır.Dialogue: 0,0:12:33.33,0:12:37.32,Note,,0,0,0,,Shichibukai: Denizin Yedi Savaş AğasıDialogue: 0,0:12:38.53,0:12:40.51,Main,,0,0,0,,İçeri girince...Dialogue: 0,0:12:40.51,0:12:42.97,Main,,0,0,0,,...Deniz Taşı'ndan kelepçelerle kelepçeleneceksin.Dialogue: 0,0:12:42.97,0:12:47.66,Main,,0,0,0,,Ayrıca girişte tam bir üst aramasından geçmek zorundasın.Dialogue: 0,0:12:48.29,0:12:53.73,Main,,0,0,0,,Nihayetinde tutsaklardan herhangi birini serbest bırakmana izin veremeyiz.Dialogue: 0,0:12:55.14,0:12:58.09,Main,,0,0,0,,Luffy. İçeri girince üst araması yapacaklar.Dialogue: 0,0:12:58.09,0:13:00.92,Main,,0,0,0,,Bir şeyler düşünürüz. Sen devam et!Dialogue: 0,0:13:02.78,0:13:04.93,Main,,0,0,0,,Umurumda değil.Dialogue: 0,0:13:04.93,0:13:06.36,Main,,0,0,0,,Ne?!Dialogue: 0,0:13:06.36,0:13:07.80,Main,,0,0,0,,Palyaço Buggy mi?!Dialogue: 0,0:13:07.80,0:13:09.35,Main,,0,0,0,,Hücresinden mi kaçmış?!Dialogue: 0,0:13:09.35,0:13:10.69,Main,,0,0,0,,Şeytan Meyvesi kullanıcısı mı?Dialogue: 0,0:13:12.45,0:13:13.78,Main,,0,0,0,,Müdür Yardımcısı.Dialogue: 0,0:13:13.78,0:13:18.23,Main,,0,0,0,,Teğmen Momonga ve Shichibukai Hancock-dono geldi.Dialogue: 0,0:13:18.23,0:13:20.11,Main,,0,0,0,,Tamam. Hemen geliyorum.Dialogue: 0,0:13:21.70,0:13:25.36,Main,,0,0,0,,Çok gü... ah... kapıları açın!Dialogue: 0,0:13:25.36,0:13:28.41,Main,,0,0,0,,Ona istediği hizmeti verin!Dialogue: 0,0:13:31.79,0:13:34.33,Narrator,,0,0,0,,Ace'in infazına kalan süre...Dialogue: 0,0:13:34.33,0:13:37.67,Narrator,,0,0,0,,33 saat.Dialogue: 0,0:13:40.66,0:13:42.46,Thoughts,,0,0,0,,Gidiyoruz, Luffy.Dialogue: 0,0:13:46.71,0:13:48.27,Main,,0,0,0,,Dikkatli olun!Dialogue: 0,0:13:48.27,0:13:52.39,Main,,0,0,0,,Hancock-sama! İyi yolculuklar!Dialogue: 0,0:13:52.39,0:13:53.81,Main,,0,0,0,,Vızıldamayı kesin, küçük sinekler!Dialogue: 0,0:13:53.81,0:13:57.19,Main,,0,0,0,,Acımasız olma! Dikkatli ol!Dialogue: 0,0:14:03.24,0:14:05.62,Secondary,,0,0,0,,Yardım edin!Dialogue: 0,0:14:05.62,0:14:07.70,Secondary,,0,0,0,,Yardım!Dialogue: 0,0:14:07.70,0:14:10.37,Thoughts,,0,0,0,,Ne bunaltıcı bir atmosfer.Dialogue: 0,0:14:10.37,0:14:12.92,Thoughts,,0,0,0,,Cehennem böyle bir yer mi?Dialogue: 0,0:14:13.63,0:14:15.30,Thoughts,,0,0,0,,Nihayet içeri girdik.Dialogue: 0,0:14:15.75,0:14:17.88,Thoughts,,0,0,0,,Ancak henüz rahatlayamayız.Dialogue: 0,0:14:20.47,0:14:24.34,Main,,0,0,0,,Impel Down'ıma hoşgeldiniz!Dialogue: 0,0:14:24.34,0:14:26.32,Main,,0,0,0,,Ah! Karıştırdım!Dialogue: 0,0:14:26.32,0:14:29.41,Main,,0,0,0,,"Impel Down'ım" demek biraz fazla hırs yapmak olur!Dialogue: 0,0:14:29.41,0:14:32.61,Main,,0,0,0,,Ben sadece Müdür Yardımcısı Hannyabal'ım!Dialogue: 0,0:14:32.61,0:14:35.00,Main,,0,0,0,,Memnun oldum!Dialogue: 0,0:14:35.68,0:14:36.90,Main,,0,0,0,,Ben Momonga.Dialogue: 0,0:14:36.90,0:14:38.78,Main,,0,0,0,,Niçin geldiğini duydum.Dialogue: 0,0:14:38.78,0:14:42.17,Main,,0,0,0,,Siz de İmparatoriçe Hancock-dono olmalısınız?Dialogue: 0,0:14:42.17,0:14:45.32,Main,,0,0,0,,İmparatoriçem, Hancock-dono?Dialogue: 0,0:14:45.32,0:14:46.80,Main,,0,0,0,,Ah, beni bağışlayın!Dialogue: 0,0:14:46.80,0:14:48.37,Main,,0,0,0,,Yine fazla hırslı davranıyorum!Dialogue: 0,0:14:48.37,0:14:50.08,Main,,0,0,0,,Kokuşmuş Müdür...Dialogue: 0,0:14:50.08,0:14:52.08,Main,,0,0,0,,Ah! Hata ettim.Dialogue: 0,0:14:52.08,0:14:57.27,Main,,0,0,0,,Müdür Magellan, 4. Seviye'deki ofisinde.Dialogue: 0,0:14:57.27,0:14:59.62,Main,,0,0,0,,Şimdi oraya götürüleceksiniz.Dialogue: 0,0:14:59.62,0:15:04.55,Main,,0,0,0,,Baş Gardiyan Yardımcısı Domino ve ben, size eşlik edeceğiz.Dialogue: 0,0:15:04.55,0:15:07.67,Main,,0,0,0,,Zamanınız az gibi görünüyor, lütfen bu taraftan buyurun.Dialogue: 0,0:15:07.67,0:15:12.14,Main,,0,0,0,,Koramiral, oraya gidin ve üst aramasından geçin.Dialogue: 0,0:15:14.06,0:15:19.73,Main,,0,0,0,,Mahkumlarımızın hepsi elbiselerinin çıkarıldığı bu kafese gönderilir...Dialogue: 0,0:15:19.73,0:15:24.79,Main,,0,0,0,,...ve kaynar su kazanlarına indirilir. Bu işleme "Cehennem'in Ilık Banyosu" diyoruz.Dialogue: 0,0:15:24.79,0:15:29.33,Main,,0,0,0,,Bunu, hücrelerine konmadan önce mahkumları "dezenfekte" ve vaftiz etmek için kullanıyoruz.Dialogue: 0,0:15:30.04,0:15:33.02,Main,,0,0,0,,O mahkumlar arasında bile diğerlerinden daha zorlu olanlar var.Dialogue: 0,0:15:33.02,0:15:37.08,Main,,0,0,0,,Son zamanlardaki mahkumlarımızdan birkaçı, Ateş Yumruk Ace...Dialogue: 0,0:15:37.91,0:15:40.50,Main,,0,0,0,,...Shichibukai Jinbei...Dialogue: 0,0:15:40.50,0:15:43.59,Main,,0,0,0,,...ve eski Shichibukai Crocodile.Dialogue: 0,0:15:43.59,0:15:48.60,Main,,0,0,0,,Hepsi, göz bile kırpmadan vaftizden geçtiler.Dialogue: 0,0:15:53.18,0:15:54.70,Main,,0,0,0,,Buyrun.Dialogue: 0,0:15:54.70,0:15:57.06,Main,,0,0,0,,Misafirlerin üstü bu özel odada aranır.Dialogue: 0,0:15:57.06,0:15:58.29,Main,,0,0,0,,Endişelenmeyin.Dialogue: 0,0:16:06.02,0:16:09.03,Main,,0,0,0,,Lütfen o pelerini çıkarın.Dialogue: 0,0:16:09.67,0:16:12.53,Main,,0,0,0,,Birini gizlemenin en kolay yolu...Dialogue: 0,0:16:12.53,0:16:14.46,Main,,0,0,0,,...bu yüzden lütfen onu bana verin.Dialogue: 0,0:16:15.03,0:16:17.55,Main,,0,0,0,,Sizden şüphelenmek için sebebim yok...Dialogue: 0,0:16:17.55,0:16:20.15,Main,,0,0,0,,...ama şüphe çekici bir şey yapmayı düşünüyorsanız...Dialogue: 0,0:16:20.71,0:16:26.05,Main,,0,0,0,,...Impel Down'ın her yerini  Den Den Mushi'lerle gözetliyoruz.Dialogue: 0,0:16:26.05,0:16:29.97,Main,,0,0,0,,Gördükleri her şeyi güvenlik monitörlerine iletiyorlar.Dialogue: 0,0:16:33.68,0:16:35.98,Main,,0,0,0,,Pekâlâ, her şey sırayla...Dialogue: 0,0:16:36.53,0:16:38.83,Main,,0,0,0,,Deniz Taşı kelepçelerini takın.Dialogue: 0,0:16:39.52,0:16:42.63,Main,,0,0,0,,Mahkum olmamama rağmen  kelepçe takmam gerekiyor.Dialogue: 0,0:16:42.63,0:16:44.49,Main,,0,0,0,,Çok ihtiyatlısınız.Dialogue: 0,0:16:49.88,0:16:51.74,Main,,0,0,0,,Lütfen bana nazik davranın.Dialogue: 0,0:16:56.07,0:16:57.04,Main,,0,0,0,,Ne?!Dialogue: 0,0:17:01.34,0:17:03.17,Main,,0,0,0,,Çıkabilirsin, Luffy.Dialogue: 0,0:17:06.88,0:17:08.22,Main,,0,0,0,,Çok yakındı!Dialogue: 0,0:17:08.71,0:17:13.18,Main,,0,0,0,,Onlar bakmıyorken bir yolunu bulmam gerekiyor diye düşünmüştüm.Dialogue: 0,0:17:13.18,0:17:16.06,Main,,0,0,0,,Her şeyi taşa çevirebiliyorsun, ha?Dialogue: 0,0:17:16.06,0:17:20.52,Main,,0,0,0,,Seni en fazla buraya kadar götürebilirim.Dialogue: 0,0:17:20.52,0:17:24.31,Main,,0,0,0,,Bunun ardından yeteneklerim Deniz Taşı'yla engellenecek.Dialogue: 0,0:17:24.31,0:17:26.86,Main,,0,0,0,,Pelerinimi aldıkları zaman saklanamayacaksın.Dialogue: 0,0:17:28.01,0:17:31.21,Main,,0,0,0,,Sana daha fazla yardımcı olmayı umuyordum...Dialogue: 0,0:17:31.21,0:17:32.88,Main,,0,0,0,,Ne diyorsun?Dialogue: 0,0:17:32.88,0:17:36.41,Main,,0,0,0,,Kendi başıma buraya gelebilmem mümkün değildi!Dialogue: 0,0:17:36.41,0:17:39.96,Main,,0,0,0,,Beni savaş gemileriyle çevrili bir binaya soktun.Dialogue: 0,0:17:39.96,0:17:41.38,Main,,0,0,0,,Bana baya yardımcı oldun!Dialogue: 0,0:17:42.51,0:17:43.79,Main,,0,0,0,,Luffy...Dialogue: 0,0:17:46.34,0:17:49.53,Main,,0,0,0,,Burası insanları hapsetmek için yapılmış bir kale.Dialogue: 0,0:17:49.53,0:17:52.94,Main,,0,0,0,,Ne olursa olsun, lütfen burada kargaşa çıkarma.Dialogue: 0,0:17:52.94,0:17:56.59,Main,,0,0,0,,Yakalanırsan asla çıkamazsın.Dialogue: 0,0:17:58.64,0:18:04.57,Main,,0,0,0,,Güçlü olsan da, huzursuzluk çıkarmayacağına dair bana söz verir misin?Dialogue: 0,0:18:06.69,0:18:08.91,Main,,0,0,0,,Tamam, anladım! Söz veriyorum!Dialogue: 0,0:18:08.91,0:18:10.78,Main,,0,0,0,,Gerçekten çok sağol, Hancock!Dialogue: 0,0:18:12.24,0:18:13.99,Main,,0,0,0,,Benim için yaptıklarını asla unutmaycağım!Dialogue: 0,0:18:13.99,0:18:15.70,Main,,0,0,0,,Bir gün kesinlikle karşılığını vereceğim!Dialogue: 0,0:18:16.33,0:18:18.50,Thoughts,,0,0,0,,Demin... sen...Dialogue: 0,0:18:18.50,0:18:22.97,Thoughts,,0,0,0,,...bana Hancock mu dedin?!Dialogue: 0,0:18:24.25,0:18:26.75,Flashbacks,,0,0,0,,Tabii, Hammock!Dialogue: 0,0:18:26.75,0:18:28.96,Flashbacks,,0,0,0,,Hammock, biraz daha yemek istiyorum!Dialogue: 0,0:18:28.96,0:18:31.05,Flashbacks,,0,0,0,,Ne oldu, Hammock?Dialogue: 0,0:18:34.81,0:18:36.49,Main,,0,0,0,,Hancock!Dialogue: 0,0:18:45.06,0:18:49.11,Main,,0,0,0,,Artık hayatım tamamlandı!Dialogue: 0,0:18:51.70,0:18:53.91,Main,,0,0,0,,Hey, onları artık normale döndürebilirsin.Dialogue: 0,0:18:53.91,0:18:55.12,Main,,0,0,0,,İyi olacağım!Dialogue: 0,0:18:56.30,0:18:59.49,Main,,0,0,0,,Bu... karşılıklı bir sevgi olmalı!Dialogue: 0,0:18:59.49,0:19:01.16,Main,,0,0,0,,Geciktiler...Dialogue: 0,0:19:01.16,0:19:05.53,Main,,0,0,0,,Güvenlik kontrolünü tam olarak yapmalıyız.Dialogue: 0,0:19:07.34,0:19:09.35,Main,,0,0,0,,O bölümleri de mi?!Dialogue: 0,0:19:10.09,0:19:12.22,Main,,0,0,0,,Ne hayal ediyorsun?Dialogue: 0,0:19:14.41,0:19:16.01,Main,,0,0,0,,Müdür Yardımcısı Hannyabal!Dialogue: 0,0:19:16.01,0:19:19.79,Main,,0,0,0,,Gözetleme Den Den Mushisi hiçbir şey göstermiyor.Dialogue: 0,0:19:19.79,0:19:21.35,Main,,0,0,0,,Orada her şey yolunda mı?Dialogue: 0,0:19:23.94,0:19:26.65,Main,,0,0,0,,Domino! Bir sorun mu var?Dialogue: 0,0:19:33.35,0:19:35.32,Main,,0,0,0,,Üst araması tamamlandı.Dialogue: 0,0:19:37.73,0:19:40.29,Main,,0,0,0,,Gizli kamera tekrardan çalışıyor. Sorun yok.Dialogue: 0,0:19:40.29,0:19:42.05,Main,,0,0,0,,Çok üzgünüm.Dialogue: 0,0:19:42.05,0:19:43.62,Main,,0,0,0,,O kadar uzun mu sürdü?Dialogue: 0,0:19:44.41,0:19:46.00,Main,,0,0,0,,Hiç de bile!Dialogue: 0,0:19:46.00,0:19:47.54,Main,,0,0,0,,Burada da sorun yok.Dialogue: 0,0:19:48.59,0:19:52.36,Main,,0,0,0,,Mahkum olmayan birine karşı ne tatsız bir muamele.Dialogue: 0,0:19:52.36,0:19:54.52,Main,,0,0,0,,Benim kim olduğumu sanıyorsunuz?Dialogue: 0,0:19:54.52,0:19:55.96,Main,,0,0,0,,Lütfen anlayış gösterin.Dialogue: 0,0:19:55.96,0:19:59.64,Main,,0,0,0,,Bu, Impel Down'ın kurallarından biri.Dialogue: 0,0:19:59.64,0:20:01.13,Thoughts,,0,0,0,,Tuhaf.Dialogue: 0,0:20:01.13,0:20:03.39,Thoughts,,0,0,0,,Hafızam biraz bulanık gibi.Dialogue: 0,0:20:03.39,0:20:05.27,Main,,0,0,0,,Lütfen yolu gösterin.Dialogue: 0,0:20:05.27,0:20:09.31,Main,,0,0,0,,Nasıl isterseniz. Oradaki büyük asansöre doğru gidin.Dialogue: 0,0:20:12.19,0:20:15.03,Main,,0,0,0,,Bu asansörü kullanarak su altındaki dördüncü seviyeye ineceğiz.Dialogue: 0,0:20:15.03,0:20:20.13,Main,,0,0,0,,Bu bizi, Hapisane Müdürü Magellan'ın ofisinin olduğu cehenneme götürecek.Dialogue: 0,0:20:20.13,0:20:22.73,Main,,0,0,0,,Sizi uyarmalıyım, orası çok sıcaktır.Dialogue: 0,0:20:27.00,0:20:28.63,Thoughts,,0,0,0,,Luffy?!Dialogue: 0,0:20:30.55,0:20:32.10,Thoughts,,0,0,0,,Şanslı olman için dua edeceğim.Dialogue: 0,0:20:33.90,0:20:35.76,Note,,0,0,0,,(Çok sağol!)Dialogue: 0,0:20:37.31,0:20:39.47,Thoughts,,0,0,0,,"Seni seviyorum" dedi!Dialogue: 0,0:20:41.18,0:20:42.14,Main,,0,0,0,,Hey!Dialogue: 0,0:20:42.14,0:20:44.62,Main,,0,0,0,,Hancock-dono! Sorun nedir?Dialogue: 0,0:20:44.62,0:20:45.56,Main,,0,0,0,,Ona dikkat edin.Dialogue: 0,0:20:45.56,0:20:48.10,Main,,0,0,0,,Ne oldu aniden?Dialogue: 0,0:20:56.21,0:20:58.65,Main,,0,0,0,,Şimdi nereye gideceğim?Dialogue: 0,0:20:58.65,0:21:01.57,Main,,0,0,0,,O asansör aşağı gidiyor...Dialogue: 0,0:21:01.57,0:21:05.32,Main,,0,0,0,,...ve Hancock, Ace'in muhtemelen denizin dibinde olduğunu söyledi.Dialogue: 0,0:21:05.32,0:21:06.65,Main,,0,0,0,,Tabii ya!Dialogue: 0,0:21:06.65,0:21:08.54,Main,,0,0,0,,Bu yüzden Yaşam Kartım var.Dialogue: 0,0:21:31.10,0:21:33.19,Main,,0,0,0,,Blugori gardiyanları geri dönüyor.Dialogue: 0,0:21:33.19,0:21:35.08,Main,,0,0,0,,Yiyecek temin ettiler.Dialogue: 0,0:21:35.08,0:21:36.23,Main,,0,0,0,,Kapakları açın.Dialogue: 0,0:21:40.02,0:21:41.71,Main,,0,0,0,,İyi iş.Dialogue: 0,0:21:41.71,0:21:43.86,Main,,0,0,0,,Etleri donduruculara taşıyın.Dialogue: 0,0:21:47.25,0:21:48.91,Main,,0,0,0,,Onu bulduk!Dialogue: 0,0:21:48.91,0:21:52.83,Main,,0,0,0,,Birinci Seviye'deki Ortak Hücre 4'ten kaçan mahkum, Palyaço Buggy.Dialogue: 0,0:21:52.83,0:21:55.30,Main,,0,0,0,,İzolasyon Hücresi 22'nin yanındaki koridorda durduğunu doğruladık!Dialogue: 0,0:21:55.30,0:21:57.08,Main,,0,0,0,,Derhâl yakalayın!Dialogue: 0,0:21:57.08,0:21:59.22,Main,,0,0,0,,Kahretsin, beni buldular, ha?Dialogue: 0,0:21:59.22,0:22:01.43,Main,,0,0,0,,PİSLİKLER!Dialogue: 0,0:22:04.25,0:22:07.52,Main,,0,0,0,,Gözetleme Den Den Mushisi 71'le olan bağlantıyı yitirdik!Dialogue: 0,0:22:07.52,0:22:09.56,Main,,0,0,0,,Duydunuz mu? Bu, Buggy!Dialogue: 0,0:22:09.56,0:22:13.54,Main,,0,0,0,,Kendi başına kaçmaya çalışarak bunu hak etti!Dialogue: 0,0:22:13.54,0:22:16.23,Main,,0,0,0,,Onu bekleyen korkunç bir ceza var!Dialogue: 0,0:22:19.24,0:22:20.99,Main,,0,0,0,,İşte oradalar! Blugoriler!Dialogue: 0,0:22:20.99,0:22:22.41,Main,,0,0,0,,Hadi!Dialogue: 0,0:22:22.41,0:22:23.91,Main,,0,0,0,,Yakalayın onu!Dialogue: 0,0:22:29.71,0:22:32.37,Main,,0,0,0,,Yaşam Kartı aşağı gitmemi söylüyor ama...Dialogue: 0,0:22:32.37,0:22:34.57,Main,,0,0,0,,...burası çıkmaz yol gibi.Dialogue: 0,0:22:39.57,0:22:42.05,Main,,0,0,0,,Mahkum numarası 8200.Dialogue: 0,0:22:42.05,0:22:44.01,Main,,0,0,0,,Ne? Kaçmasına izin vermiyoruz!Dialogue: 0,0:22:45.80,0:22:47.91,Main,,0,0,0,,Şeytan Meyvesi kullanıcısı olduğunu teyit ettiler!Dialogue: 0,0:22:47.91,0:22:49.61,Main,,0,0,0,,Deniz Taşı'nı unutmayın!Dialogue: 0,0:22:51.77,0:22:52.65,Main,,0,0,0,,Çabuk!Dialogue: 0,0:22:53.19,0:22:54.91,Main,,0,0,0,,Ayrılıp etrafını saracağız!Dialogue: 0,0:22:58.69,0:22:59.90,Main,,0,0,0,,Tamam! Girdim!Dialogue: 0,0:22:59.90,0:23:01.13,Main,,0,0,0,,Çabuk!Dialogue: 0,0:23:02.81,0:23:04.20,Main,,0,0,0,,O da ne?Dialogue: 0,0:23:04.19,0:23:08.56,Captions,,0,0,170,,Seviye 1 - Kızıl KatDialogue: 0,0:23:10.42,0:23:12.25,Main,,0,0,0,,Bu odaların hepsi hücre mi?Dialogue: 0,0:23:14.94,0:23:15.97,Main,,0,0,0,,Çığlıklar?Dialogue: 0,0:23:15.97,0:23:18.25,Main,,0,0,0,,Neyse, devam etmeliyim!Dialogue: 0,0:23:20.71,0:23:22.71,Main,,0,0,0,,Hey, hey, hey, hey!Dialogue: 0,0:23:22.71,0:23:23.79,Main,,0,0,0,,Ha?Dialogue: 0,0:23:23.80,0:23:25.68,Main,,0,0,0,,Kardeş! Kardeş!Dialogue: 0,0:23:25.68,0:23:26.55,Main,,0,0,0,,Ne var?Dialogue: 0,0:23:26.55,0:23:28.07,Main,,0,0,0,,Dur biraz!Dialogue: 0,0:23:28.07,0:23:30.36,Main,,0,0,0,,Kafesin dışında ne yapıyorsun?Dialogue: 0,0:23:30.36,0:23:31.98,Main,,0,0,0,,Ha? Neler oluyor?Dialogue: 0,0:23:31.98,0:23:35.31,Main,,0,0,0,,Kafesin dışında mı? Ben dışarıdan geldim.Dialogue: 0,0:23:35.31,0:23:36.22,Main,,0,0,0,,Görüşürüz!Dialogue: 0,0:23:36.22,0:23:39.06,Main,,0,0,0,,Dur! Yalan söyleme, lanet olsun!Dialogue: 0,0:23:39.06,0:23:40.79,Main,,0,0,0,,Yalan söylemiyorum!Dialogue: 0,0:23:40.79,0:23:42.29,Main,,0,0,0,,Kimsin sen?Dialogue: 0,0:23:42.29,0:23:44.81,Main,,0,0,0,,Gardiyan veya işkenceci değilsin, değil mi?Dialogue: 0,0:23:44.81,0:23:47.66,Main,,0,0,0,,Nasıl kafesin dışında olabilirsin?!Dialogue: 0,0:23:47.66,0:23:50.49,Main,,0,0,0,,Çok gürültü çıkarıyorsunuz!Dialogue: 0,0:23:50.49,0:23:52.66,Main,,0,0,0,,Sahi! Ace'in nerede olduğunu biliyor musunuz?Dialogue: 0,0:23:52.66,0:23:54.49,Main,,0,0,0,,Ace?Dialogue: 0,0:23:54.49,0:23:57.88,Main,,0,0,0,,Ace derken...Dialogue: 0,0:23:58.99,0:24:00.96,Main,,0,0,0,,...Ateş Yumruk Ace'i mi kastediyorsun?Dialogue: 0,0:24:00.96,0:24:03.67,Main,,0,0,0,,Evet. Ace'i kurtarmak istiyorum!Dialogue: 0,0:24:04.80,0:24:06.47,Main,,0,0,0,,Gözü karalık etme!Dialogue: 0,0:24:06.47,0:24:10.18,Main,,0,0,0,,Buraya gönderildiğini duydum...Dialogue: 0,0:24:10.18,0:24:13.45,Main,,0,0,0,,Eğer öyleyse muhtemelen 5. seviyededir.Dialogue: 0,0:24:13.45,0:24:15.16,Main,,0,0,0,,Oraya yaklaşabilmen mümkün değil.Dialogue: 0,0:24:15.16,0:24:15.98,Main,,0,0,0,,İmkansız!Dialogue: 0,0:24:15.98,0:24:21.24,Main,,0,0,0,,Orası 100 milyonun üstünde ödülü olanları tuttukları yer!Dialogue: 0,0:24:22.44,0:24:24.24,Main,,0,0,0,,Seviye 5?Dialogue: 0,0:24:24.24,0:24:25.68,Main,,0,0,0,,Neyse, kardeş.Dialogue: 0,0:24:25.68,0:24:29.68,Main,,0,0,0,,Gardiyanın odasına gidip anahtarları çalabilir misin?Dialogue: 0,0:24:30.34,0:24:32.66,Main,,0,0,0,,Evet! Lütfen kardeş!Dialogue: 0,0:24:32.66,0:24:39.46,Main,,0,0,0,,Sence de koskaca dünya dururken burada karşılaşmamız kader değil mi?Dialogue: 0,0:24:43.68,0:24:45.13,Main,,0,0,0,,O da ne?Dialogue: 0,0:24:45.72,0:24:47.05,Main,,0,0,0,,Blugori!Dialogue: 0,0:24:47.05,0:24:48.27,Main,,0,0,0,,Blugori?Dialogue: 0,0:24:48.27,0:24:49.58,Main,,0,0,0,,Kaç, kardeş!Dialogue: 0,0:24:49.58,0:24:50.68,Main,,0,0,0,,Seni öldürecekler!Dialogue: 0,0:25:00.86,0:25:02.82,Main,,0,0,0,,Bu heriflerin nesi var böyle?!Dialogue: 0,0:25:02.82,0:25:05.28,Main,,0,0,0,,Sağa!Dialogue: 0,0:25:05.28,0:25:07.45,Main,,0,0,0,,Sola!Dialogue: 0,0:25:11.41,0:25:13.03,Main,,0,0,0,,Ahmaklar!Dialogue: 0,0:25:13.03,0:25:15.79,Main,,0,0,0,,Bara Bara Meyvesi'nin gücüne sahip birini hafife almayın!Dialogue: 0,0:25:13.03,0:25:15.79,Note,,0,0,0,,Bara Bara - Parça ParçaDialogue: 0,0:25:19.76,0:25:21.58,Main,,0,0,0,,HASIR ŞAPKA?!Dialogue: 0,0:25:21.58,0:25:23.91,Main,,0,0,0,,Niye buradasın?!Dialogue: 0,0:25:25.60,0:25:27.50,Main,,0,0,0,,Ah. Buggy mi?Dialogue: 0,0:25:27.50,0:25:30.97,Main,,0,0,0,,Pislik... benimle uğraşma, seni aşağılık!Dialogue: 0,0:25:30.97,0:25:33.22,Main,,0,0,0,,Her zamanki gibi küstahsın!Dialogue: 0,0:25:33.22,0:25:36.56,Main,,0,0,0,,Senin de yakalandığını bilmiyordum!Dialogue: 0,0:25:36.56,0:25:39.13,Main,,0,0,0,,Buraya kendim geldim!Dialogue: 0,0:25:39.13,0:25:40.86,Main,,0,0,0,,Yakalanmadım!Dialogue: 0,0:25:41.65,0:25:44.48,Main,,0,0,0,,Ne tür bir aptal isteyerek hapishaneye girer?Dialogue: 0,0:25:45.32,0:25:49.07,Main,,0,0,0,,Dur, yoksa mahkumiyetimi duydun...Dialogue: 0,0:25:49.07,0:25:51.94,Main,,0,0,0,,...ve beni kurtarmaya mı geldin?Dialogue: 0,0:25:51.94,0:25:53.49,Main,,0,0,0,,Hiç de bile!Dialogue: 0,0:25:53.49,0:25:56.49,Main,,0,0,0,,Sersem! Bunu düşünmek bile beni hasta ediyor.Dialogue: 0,0:25:55.16,0:25:57.86,Secondary,,0,0,0,,NEDEN BAHSEDİYORSUN SEN?!Dialogue: 0,0:25:58.16,0:26:01.92,Main,,0,0,0,,Burada kargaşa çıkarmayacağıma dair Hancock'a söz verdim...Dialogue: 0,0:26:01.92,0:26:03.42,Main,,0,0,0,,...ama beni buna sen sürükledin!Dialogue: 0,0:26:03.42,0:26:05.75,Main,,0,0,0,,Karışmanı ben istemedim!Dialogue: 0,0:26:13.96,0:26:20.06,Main,,0,0,0,,Ben sadece "Buggy'nin Müthiş Hapishane Kaçışı Planı" umut bağlamıştım!Dialogue: 0,0:26:20.06,0:26:21.79,Main,,0,0,0,,Kimin umrunda?!Dialogue: 0,0:26:24.40,0:26:26.32,Main,,0,0,0,,Önden de geliyorlar!Dialogue: 0,0:26:26.32,0:26:28.28,Main,,0,0,0,,LANET OLSUN!Dialogue: 0,0:26:28.28,0:26:30.57,Main,,0,0,0,,Hey! Sahi, neden kaçıyorsun?Dialogue: 0,0:26:30.57,0:26:33.49,Main,,0,0,0,,Neden bahsediyorsun, aptal?!Dialogue: 0,0:26:33.49,0:26:36.83,Main,,0,0,0,,Bana nasıl işkenceler ettiklerini bilmiyorsun!Dialogue: 0,0:26:36.83,0:26:40.07,Main,,0,0,0,,Bunlar soğuk kanlı canavarlar!Dialogue: 0,0:26:40.07,0:26:42.04,Main,,0,0,0,,O zaman yakalanmamalısın, değil mi?Dialogue: 0,0:26:42.04,0:26:43.88,Main,,0,0,0,,N-N-Neden bahsediyorsun sen?!Dialogue: 0,0:26:43.88,0:26:45.71,Main,,0,0,0,,Acelem var!Dialogue: 0,0:26:45.71,0:26:48.92,Main,,0,0,0,,Sahi, sanırım çoktan kargaşa çıkardım.Dialogue: 0,0:26:51.17,0:26:55.05,Main,,0,0,0,,Sen ve Kızıl Saç konusunda dayanamadığım şey bu işte.Dialogue: 0,0:26:55.05,0:26:59.41,Main,,0,0,0,,Her zaman olumlu düşünüyorsunuz ama kötü bir şekilde.Dialogue: 0,0:27:02.89,0:27:05.95,Main,,0,0,0,,İyi. Yapalım o zaman!Dialogue: 0,0:27:05.95,0:27:07.82,Main,,0,0,0,,Yapmak zorundayız, değil mi?!Dialogue: 0,0:27:10.23,0:27:11.78,Main,,0,0,0,,Büyük, gösterişli bir şekilde...Dialogue: 0,0:27:13.91,0:27:16.03,Main,,0,0,0,,...planları değiştirme zamanı!Dialogue: 0,0:27:16.03,0:27:17.90,Main,,0,0,0,,Katılıyorum!Dialogue: 0,0:01:09.57,0:01:18.18,Lyrics,,0,0,0,,♪ Orada beni beklerken ileri bak, kıymetlim! ♪Dialogue: 0,0:01:21.72,0:01:31.13,Lyrics,,0,0,0,,♪ Uzun yolculuğumuza çıktığımızda, aşk, cesaret, arkadaşlık ve...Dialogue: 0,0:01:32.83,0:01:43.54,Lyrics,,0,0,0,,...biraz da neşe, sonsuza dek kalplerimizde kalacak olan şeylerdir. ♪Dialogue: 0,0:01:45.93,0:01:51.71,Lyrics,,0,0,0,,♪ Birini bulmak için maceraya çıktık. ♪Dialogue: 0,0:01:52.07,0:02:02.68,Lyrics,,0,0,0,,♪ Asla durmayacağız! Orada beni beklerken ileri bak, kıymetlim! ♪Dialogue: 0,0:02:04.21,0:02:08.87,Lyrics,,0,0,0,,♪ Döktüğümüz her gözyaşıyla daha da güçleneceğiz...Dialogue: 0,0:02:10.35,0:02:13.14,Lyrics,,0,0,0,,...ve her gözyaşıyla anılarımız...Dialogue: 0,0:02:13.14,0:02:23.83,Lyrics,,0,0,0,,...daha, daha, çok daha güçlü olacak! (Evet!) ♪Dialogue: 0,0:02:24.02,0:02:29.66,Lyrics,,0,0,0,,♪ Bu yüzden rüzgârı hissedince, estiğini de hissetmelisin. ♪Dialogue: 0,0:02:30.05,0:02:35.80,Lyrics,,0,0,0,,♪ Gidip gözyaşlarımızı kurutan rüzgârı arayalım! ♪Dialogue: 0,0:02:36.07,0:02:41.73,Lyrics,,0,0,0,,♪ Birini bulmak için maceraya çıktık. ♪Dialogue: 0,0:02:42.21,0:02:54.15,Lyrics,,0,0,0,,♪ Asla durmayacağız! Orada beni beklerken ileri bak, kıymetlim! ♪