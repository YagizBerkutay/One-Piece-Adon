Dialogue: 0,0:00:15.27,0:00:23.64,Main,,0,0,0,,Duyduğum kadarıyla şuradaki eski Shichibukai Crocodile'ı deviren sendin, değil mi?
Dialogue: 0,0:00:23.64,0:00:25.66,Main,,0,0,0,,Hasır Şapkalı Luffy!
Dialogue: 0,0:00:27.40,0:00:31.80,Main,,0,0,0,,O sırada hâlâ Shichibukai\Nolmaya çalışırken...
Dialogue: 0,0:00:31.80,0:00:37.17,Main,,0,0,0,,...seni öldürmenin Dünya Hükümeti'ne gücümü\Nkanıtlamak için iyi bir fikir olduğunu düşünüyordum.
Dialogue: 0,0:00:43.18,0:00:48.05,Flashbacks,,0,0,0,,Beyazsakal'ın devri sona erdi!\NKorsanlar Kralı olacak kişi benim!
Dialogue: 0,0:00:48.30,0:00:53.14,Flashbacks,,0,0,0,,Önce Water Seven'daki Hasır\NŞapkalı Luffy'yi öldüreceğim...
Dialogue: 0,0:00:53.14,0:00:55.96,Flashbacks,,0,0,0,,...ve onu Hükümet'e sunacağım!
Dialogue: 0,0:00:56.67,0:00:58.98,Flashbacks,,0,0,0,,Seni serbest bırakmamamın bir nedeni daha!
Dialogue: 0,0:00:59.74,0:01:01.60,Flashbacks,,0,0,0,,O benim kardeşim!
Dialogue: 0,0:01:02.55,0:01:07.14,Main,,0,0,0,,Ama görünüşe göre kader senden yanaydı!
Dialogue: 0,0:01:07.74,0:01:12.83,Main,,0,0,0,,Beyazsakal'ın gemisinin kuralını\Nbozduğumdan beri beni takip eden Ace,...
Dialogue: 0,0:01:12.83,0:01:15.15,Main,,0,0,0,,...senin abinmiş!
Dialogue: 0,0:01:15.44,0:01:19.61,Main,,0,0,0,,Kardeşini öldürmeyi\Nplanladığımızı fark edince...
Dialogue: 0,0:01:19.61,0:01:22.03,Main,,0,0,0,,...bizimle kendisi dövüşmek zorunda kaldı!
Dialogue: 0,0:01:30.53,0:01:32.22,Main,,0,0,0,,Anlıyor musun?
Dialogue: 0,0:01:32.22,0:01:36.72,Main,,0,0,0,,Gitmemize izin verseydi sadece\NBeyazsakal'ı rezil etmekle kalmayacaktı.
Dialogue: 0,0:01:36.72,0:01:40.41,Main,,0,0,0,,Kardeşi de öldürülecekti!
Dialogue: 0,0:01:40.71,0:01:43.65,Main,,0,0,0,,İnsanın kaderinde\Ntesadüf diye bir şey yoktur.
Dialogue: 0,0:01:43.65,0:01:44.67,Main,,0,0,0,,Yani...
Dialogue: 0,0:01:46.49,0:01:49.13,Main,,0,0,0,,...gerçekten şanslısın!
Dialogue: 0,0:01:50.92,0:01:56.97,Main,,0,0,0,,Kaptanımız Shichibukai olduğu için\Nartık canını alması gerekmiyor.
Dialogue: 0,0:01:59.91,0:02:03.93,Main,,0,0,0,,Abin takdire şayan bir mücadele sergiledi!
Dialogue: 0,0:02:04.58,0:02:08.48,Main,,0,0,0,,Ace araya girdiği için minnettar olmalısın.
Dialogue: 0,0:02:09.90,0:02:13.82,Main,,0,0,0,,Karışmasaydı bugün ölecek olan kişi...
Dialogue: 0,0:02:14.18,0:02:16.55,Main,,0,0,0,,...sen olurdun, Hasır Şapka.
Dialogue: 0,0:02:19.99,0:02:21.47,Main,,0,0,0,,O zaman...
Dialogue: 0,0:02:22.54,0:02:24.10,Main,,0,0,0,,...NİYE ŞİMDİ BENİ\NÖLDÜRMEYE ÇALIŞMIYORSUN?!
Dialogue: 0,0:02:36.72,0:02:37.77,Main,,0,0,0,,Kaptan!
Dialogue: 0,0:02:44.71,0:02:46.79,Main,,0,0,0,,Ace'in ölmesine izin vermeyeceğim!
Dialogue: 0,0:02:56.97,0:02:58.93,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no Jet...
Dialogue: 0,0:02:59.18,0:03:01.14,Main,,0,0,0,,{\fad(200,200)}Kara Girdap!
Dialogue: 0,0:03:08.17,0:03:08.94,Main,,0,0,0,,Hasır-chan!
Dialogue: 0,0:03:18.72,0:03:21.33,Main,,0,0,0,,Kan? O lastik adam değil mi?
Dialogue: 0,0:03:35.55,0:03:39.15,Main,,0,0,0,,Şeytan Meyvesi güçleri\Nbana karşı işe yaramaz!
Dialogue: 0,0:03:45.29,0:03:48.68,Main,,0,0,0,,Ne olmuş?!
Dialogue: 0,0:03:57.21,0:04:00.01,Main,,0,0,0,,Dur, Luffy-kun! Dur!
Dialogue: 0,0:04:00.01,0:04:01.75,Main,,0,0,0,,Bırak beni!
Dialogue: 0,0:04:01.75,0:04:03.48,Main,,0,0,0,,Şimdi sırası değil! Dayanmaya çalış!
Dialogue: 0,0:04:03.80,0:04:05.12,Main,,0,0,0,,Bırak beni!
Dialogue: 0,0:04:05.12,0:04:06.88,Main,,0,0,0,,Olmaz, Luffy-kun!
Dialogue: 0,0:04:06.88,0:04:08.78,Main,,0,0,0,,Burada önemli olan ne?!
Dialogue: 0,0:04:08.78,0:04:11.45,Main,,0,0,0,,Düşün! Luffy-kun!
Dialogue: 0,0:04:15.99,0:04:21.88,Main,,0,0,0,,Yaşlı Beyazsakal'ın gemisinde olduğundan\Nberi kimse onun gerçek doğasını bilmiyor.
Dialogue: 0,0:04:22.62,0:04:30.80,Main,,0,0,0,,Nasıl bir numara kullandığını bilmiyorum ama\Ngerçekten Ace-san'ı yenecek güce sahip!
Dialogue: 0,0:04:31.76,0:04:35.44,Main,,0,0,0,,Burada zaman ve enerji\Nkaybetmeyi göze alamayız!
Dialogue: 0,0:04:35.44,0:04:38.29,Main,,0,0,0,,Kendini kaptırıp onunla dövüşürsen...
Dialogue: 0,0:04:38.29,0:04:40.48,Main,,0,0,0,,...Ace-san'ı kurtaracak vaktimiz olmayacak!
Dialogue: 0,0:04:46.76,0:04:49.65,Main,,0,0,0,,Tahmin ettiğimden daha güçlüsün.
Dialogue: 0,0:04:49.65,0:04:52.58,Main,,0,0,0,,Hakin de artmış.
Dialogue: 0,0:04:52.58,0:04:54.20,Main,,0,0,0,,Karasakal olduğunu söyledin, değil mi?
Dialogue: 0,0:04:56.29,0:05:04.00,Main,,0,0,0,,Beyazsakal tayfasından duyulmamış bir korsanın\NShichibukai konumumu aldığını duymuştum.
Dialogue: 0,0:05:04.59,0:05:06.62,Main,,0,0,0,,Ama tuhaf değil mi?
Dialogue: 0,0:05:06.62,0:05:11.93,Main,,0,0,0,,Donanma Karargâhı'na çağırılan\Nbiri, neden şimdi burada?
Dialogue: 0,0:05:12.42,0:05:18.85,Main,,0,0,0,,Fazlasıyla istediğin Shichibukai\Nrütbesini fırlatıp atıyor gibisin.
Dialogue: 0,0:05:20.74,0:05:23.13,Main,,0,0,0,,Hepsi planımın bir parçası.
Dialogue: 0,0:05:23.13,0:05:26.78,Main,,0,0,0,,Sana bir şey anlatmak zorunda değilim,...
Dialogue: 0,0:05:26.78,0:05:29.59,Main,,0,0,0,,...Bay Crocodile.
Dialogue: 0,0:05:29.59,0:05:33.34,Main,,0,0,0,,Doğru ve işin aslı umrumda değil.
Dialogue: 0,0:05:34.31,0:05:36.58,Main,,0,0,0,,Epey alıngansın, değil mi?
Dialogue: 0,0:05:38.00,0:05:41.48,Main,,0,0,0,,D-Durun! Neler oluyor?!
Dialogue: 0,0:05:42.83,0:05:46.38,Main,,0,0,0,,Magellan geldi!
Dialogue: 0,0:05:47.13,0:05:48.48,Main,,0,0,0,,Durum kötü!
Dialogue: 0,0:05:49.02,0:05:50.09,Main,,0,0,0,,Hasır Şapkalı çocuk!
Dialogue: 0,0:05:50.09,0:05:51.55,Main,,0,0,0,,Hemen git!
Dialogue: 0,0:05:51.88,0:05:57.89,Main,,0,0,0,,Magellan'ın zehrine daha fazla maruz\Nkalırsan seni bir daha geri getiremem!
Dialogue: 0,0:05:57.89,0:06:00.28,Main,,0,0,0,,Hapishane Müdürü Magellan!
Dialogue: 0,0:06:00.28,0:06:02.44,Main,,0,0,0,,Eyvah... Hemen kaçın!
Dialogue: 0,0:06:02.44,0:06:05.01,Main,,0,0,0,,Müdür... Magellan!
Dialogue: 0,0:06:05.01,0:06:07.19,Main,,0,0,0,,Hele şükür... Müdür geldi!
Dialogue: 0,0:06:09.35,0:06:13.03,Main,,0,0,0,,Magellan... Demek sonunda ortaya çıkıyor?
Dialogue: 0,0:06:13.03,0:06:16.57,Main,,0,0,0,,Merdivenleri çıkın! Bazuka timi gitmiş!
Dialogue: 0,0:06:16.57,0:06:18.79,Main,,0,0,0,,Yol açık!
Dialogue: 0,0:06:19.25,0:06:23.84,Main,,0,0,0,,Hasır Şapka! Hemen Seviye 3'e çık!
Dialogue: 0,0:06:33.00,0:06:38.93,Main,,0,0,0,,Merdivenleri tutan muhafızların işini\Nbitirmişsin. Bu işimizi kolaylaştırır.
Dialogue: 0,0:06:40.69,0:06:45.69,Main,,0,0,0,,Siz de bize yardım ettiniz. Bu panik\Nhavası bizim için büyük rahatlık.
Dialogue: 0,0:06:48.98,0:06:51.16,Main,,0,0,0,,Tamamdır! İşte Seviye 3'e\Ngiden merdivenler!
Dialogue: 0,0:06:51.69,0:06:54.16,Main,,0,0,0,,Gidelim!
Dialogue: 0,0:07:10.66,0:07:13.31,Main,,0,0,0,,Bir Şeytan Muhafız daha!
Dialogue: 0,0:07:13.31,0:07:16.28,Main,,0,0,0,,Bu kez Minotor!
Dialogue: 0,0:07:16.28,0:07:18.78,Main,,0,0,0,,Ne?! Minotor mu?!
Dialogue: 0,0:07:22.60,0:07:26.87,Main,,0,0,0,,O şeyi Seviye 3'te yenmemiş miydik?!
Dialogue: 0,0:07:26.87,0:07:28.91,Main,,0,0,0,,Tabii ki iyileşmiş.
Dialogue: 0,0:07:30.10,0:07:33.56,Main,,0,0,0,,Onlar uyanmış Zoan\Ntipi meyve kullanıcılarıdır.
Dialogue: 0,0:07:33.56,0:07:37.29,Main,,0,0,0,,Normal bir insandan çok daha\Nserttirler ve daha hızlı iyileşirler.
Dialogue: 0,0:07:38.27,0:07:41.03,Main,,0,0,0,,O şeyler de mi Şeytan Meyvesi kullanıcısı?!
Dialogue: 0,0:07:41.68,0:07:46.70,Main,,0,0,0,,Burada çok fazla kalırsak\Ndiğer üçü de uyanacak.
Dialogue: 0,0:07:47.88,0:07:51.87,Main,,0,0,0,,Ama o şeylerden korkacak zaman değil.
Dialogue: 0,0:07:51.87,0:07:54.42,Main,,0,0,0,,Cehennem'in patronu gelmek üzere.
Dialogue: 0,0:08:00.47,0:08:01.97,Main,,0,0,0,,Müdür Magellan!
Dialogue: 0,0:08:01.97,0:08:08.41,Main,,0,0,0,,Karasakal'ın bu katta, Seviye 3'e çıkan\Nmerdivenlerde olduğu haberini aldık!
Dialogue: 0,0:08:08.41,0:08:11.51,Main,,0,0,0,,Shiryuu çoktan Karasakal'ın\Nicabına bakmış olmalıydı!
Dialogue: 0,0:08:11.51,0:08:13.00,Main,,0,0,0,,Yenilmiş mi?
Dialogue: 0,0:08:13.00,0:08:14.63,Main,,0,0,0,,Burası gözlem odası!
Dialogue: 0,0:08:14.63,0:08:15.44,Main,,0,0,0,,Neler oluyor?!
Dialogue: 0,0:08:15.44,0:08:17.60,Main,,0,0,0,,B-Bu korkunç!
Dialogue: 0,0:08:17.60,0:08:20.25,Main,,0,0,0,,Ana Gözlem Den Den\NMushileri etkisiz hale getirildi!
Dialogue: 0,0:08:20.25,0:08:23.24,Main,,0,0,0,,Tüm hapishanenin gözlem sistemi çöktü!
Dialogue: 0,0:08:23.24,0:08:28.95,Main,,0,0,0,,Dahası, Donanma Karagâhı ve\NHükümet ile olan bağlantılar koptu!
Dialogue: 0,0:08:33.58,0:08:35.71,Main,,0,0,0,,Bağlantıyı tamamiyle{\fscx250}-{\r}
Dialogue: 0,0:08:36.84,0:08:38.29,Main,,0,0,0,,Bu da ne?!
Dialogue: 0,0:08:41.58,0:08:44.26,Main,,0,0,0,,Hey! Sorun nedir?! Ne oldu?!
Dialogue: 0,0:08:44.26,0:08:46.93,Main,,0,0,0,,Bunu kim yaptı?!
Dialogue: 0,0:08:47.82,0:08:50.23,Main,,0,0,0,,Beni gammazlama.
Dialogue: 0,0:08:51.80,0:08:54.85,Main,,0,0,0,,Yoksa Magellan burada olduğumu bilecek.
Dialogue: 0,0:08:58.03,0:08:59.56,Main,,0,0,0,,Bağlantıyı yitirdik!
Dialogue: 0,0:08:59.88,0:09:01.94,Main,,0,0,0,,Durumu teyit edecek birini gönderin!
Dialogue: 0,0:09:01.94,0:09:02.85,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:09:02.85,0:09:04.17,Main,,0,0,0,,Durum kötü.
Dialogue: 0,0:09:04.17,0:09:07.52,Main,,0,0,0,,Karasakal bu kattaysa...
Dialogue: 0,0:09:07.52,0:09:12.38,Main,,0,0,0,,...Seviye 2'deki kapattığım\Nkapıyı açmış demektir!
Dialogue: 0,0:09:13.18,0:09:15.76,Main,,0,0,0,,Her şey ters gidiyor gibi görünüyor!
Dialogue: 0,0:09:15.76,0:09:20.76,Main,,0,0,0,,Tüm bu kargaşa, küçük bir farenin içeri\Ngirmesine izin verdiğimiz için patlak verdi.
Dialogue: 0,0:09:20.76,0:09:21.99,Main,,0,0,0,,Buggy!
Dialogue: 0,0:09:21.99,0:09:23.10,Main,,0,0,0,,Bay 3!
Dialogue: 0,0:09:23.10,0:09:24.00,Main,,0,0,0,,Buggy!
Dialogue: 0,0:09:24.00,0:09:24.73,Main,,0,0,0,,Bay 3!
Dialogue: 0,0:09:24.73,0:09:29.44,Main,,0,0,0,,Evet! Acayip şanslıyız!
Dialogue: 0,0:09:29.44,0:09:33.61,Main,,0,0,0,,Beyler! Sonunda Seviye 1'deyiz!
Dialogue: 0,0:09:36.07,0:09:40.56,Main,,0,0,0,,Arkadaşlar! Dışarıya, güneşin\Nparıldadığı yere ulaşmak üzereyiz!
Dialogue: 0,0:09:40.56,0:09:45.25,Main,,0,0,0,,Büyük kurtarıcımız, Kaptan Buggy!
Dialogue: 0,0:09:46.76,0:09:49.33,Main,,0,0,0,,Ace'i kesinlikle kurtaracağım!
Dialogue: 0,0:09:51.80,0:09:54.21,Main,,0,0,0,,Tabii, boşa olduğunu söylemeyeceğim.
Dialogue: 0,0:09:54.87,0:09:58.92,Main,,0,0,0,,Sonuçta, bu dünyada\N"imkansız" diye bir şey yoktur.
Dialogue: 0,0:10:02.72,0:10:05.17,Main,,0,0,0,,Gökyüzü Adası gerçekten vardı, değil mi?
Dialogue: 0,0:10:09.47,0:10:12.94,Flashbacks,,0,0,0,,Korsanların hayal kurduğu devir bitti mi?!
Dialogue: 0,0:10:12.94,0:10:14.83,Flashbacks,,0,0,0,,Ha?!
Dialogue: 0,0:10:21.21,0:10:23.64,Flashbacks,,0,0,0,,İnsanların hayalleri...
Dialogue: 0,0:10:24.41,0:10:26.25,Flashbacks,,0,0,0,,...ASLA SON BULMAZ!
Dialogue: 0,0:10:28.16,0:10:30.92,Flashbacks,,0,0,0,,Doğru değil mi?!
Dialogue: 0,0:10:31.97,0:10:34.28,Main,,0,0,0,,One Piece de öyle.
Dialogue: 0,0:10:34.28,0:10:36.59,Main,,0,0,0,,Kesinlikle var!
Dialogue: 0,0:10:40.87,0:10:43.77,Main,,0,0,0,,Dört gözle bekleyin!
Dialogue: 0,0:10:44.62,0:10:48.53,Main,,0,0,0,,Birkaç saat içinde...
Dialogue: 0,0:10:48.53,0:10:53.70,Main,,0,0,0,,...size tüm dünyayı iliklerine kadar\Nsarsacak bir gösteri sunacağız!
Dialogue: 0,0:10:54.05,0:10:56.22,Main,,0,0,0,,Onu boş ver, Luffy-kun!
Dialogue: 0,0:11:09.67,0:11:11.13,Main,,0,0,0,,İlerleyin!
Dialogue: 0,0:11:11.71,0:11:13.58,Main,,0,0,0,,Seviye 3'e!
Dialogue: 0,0:11:18.29,0:11:20.30,Main,,0,0,0,,Müdür Bey!
Dialogue: 0,0:11:21.44,0:11:25.19,Main,,0,0,0,,Yardım et, Müdür Bey!
Dialogue: 0,0:11:25.53,0:11:28.15,Main,,0,0,0,,Sadi-chan! Ne oldu böyle?!
Dialogue: 0,0:11:28.15,0:11:30.13,Main,,0,0,0,,Okamakov...
Dialogue: 0,0:11:30.70,0:11:32.63,Main,,0,0,0,,...beni yendi!
Dialogue: 0,0:11:32.63,0:11:34.05,Main,,0,0,0,,Çok utanıyorum!
Dialogue: 0,0:11:34.05,0:11:37.44,Main,,0,0,0,,İnsanlara işkence edemiyorsam\Nyaşamamın bir anlamı yok!
Dialogue: 0,0:11:37.44,0:11:38.87,Main,,0,0,0,,İndirin onu.
Dialogue: 0,0:11:38.87,0:11:40.43,Main,,0,0,0,,Ben önden gidiyorum.
Dialogue: 0,0:11:40.43,0:11:42.22,Main,,0,0,0,,Ah, emredersiniz! Derhal!
Dialogue: 0,0:11:59.54,0:12:01.30,Main,,0,0,0,,Demek sen Magellan'sın?
Dialogue: 0,0:12:02.33,0:12:03.94,Main,,0,0,0,,Sen de Karasakal olmalısın?
Dialogue: 0,0:12:04.61,0:12:06.61,Main,,0,0,0,,Aynen öyle.
Dialogue: 0,0:12:06.94,0:12:07.62,Main,,0,0,0,,{\fad(150,150)}Hidra!
Dialogue: 0,0:12:23.02,0:12:27.20,Main,,0,0,0,,Neden burada olduğunu soracak zamanım yok.
Dialogue: 0,0:12:32.44,0:12:36.26,Main,,0,0,0,,Acıyor! Bu da ne?!
Dialogue: 0,0:12:38.23,0:12:43.06,Main,,0,0,0,,Zehir mi? Lanet olası pislik...!
Dialogue: 0,0:12:46.14,0:12:47.48,Main,,0,0,0,,Hannyabal.
Dialogue: 0,0:12:48.67,0:12:51.11,Main,,0,0,0,,Onları bu kadar uzun süre\Ntutarak iyi iş çıkardın.
Dialogue: 0,0:12:52.47,0:12:54.20,Main,,0,0,0,,Gerisini bana bırak.
Dialogue: 0,0:12:55.65,0:12:57.07,Main,,0,0,0,,Müdür Yardımcısı!
Dialogue: 0,0:12:58.00,0:13:00.50,Main,,0,0,0,,Ne utanç verici bir görünüş!
Dialogue: 0,0:13:00.50,0:13:02.26,Main,,0,0,0,,Benim için onunla ilgilenin.
Dialogue: 0,0:13:02.26,0:13:03.53,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:13:05.82,0:13:09.09,Main,,0,0,0,,Müdür Yardımcısı! Dayanın!\NMüdür Yardımcısı!
Dialogue: 0,0:13:09.85,0:13:12.05,Thoughts,,0,0,0,,Ölme sakın.
Dialogue: 0,0:13:12.05,0:13:16.14,Thoughts,,0,0,0,,Senden başkasını vârisim\Nolarak kabul etmeyeceğim.
Dialogue: 0,0:13:27.75,0:13:29.26,Thoughts,,0,0,0,,Hasır Şapka...
Dialogue: 0,0:13:29.26,0:13:32.98,Thoughts,,0,0,0,,...zehrimden nasıl kurtuldun?
Dialogue: 0,0:13:33.55,0:13:36.67,Thoughts,,0,0,0,,Tüm bu olaydan onun\Nsorumlu olduğundan eminim.
Dialogue: 0,0:13:36.67,0:13:40.87,Thoughts,,0,0,0,,Bu kez işini kesinlikle bitireceğim!
Dialogue: 0,0:13:47.90,0:13:54.13,Main,,0,0,0,,HASIR ŞAPKA!!!
Dialogue: 0,0:13:55.18,0:13:57.44,Main,,0,0,0,,O da kim?! Bu Magellan'ın sesi mi?!
Dialogue: 0,0:13:57.44,0:14:01.39,Main,,0,0,0,,Merdivenlerin dibinde!\NBizi yakalarsa işimiz biter!
Dialogue: 0,0:14:02.95,0:14:04.69,Main,,0,0,0,,Zehir adam!
Dialogue: 0,0:14:09.33,0:14:13.39,Main,,0,0,0,,Asla kaçmana izin vermeyeceğim!
Dialogue: 0,0:14:31.74,0:14:35.62,Main,,0,0,0,,Hasır-chan! Ardına bakma, koşmaya devam et!
Dialogue: 0,0:14:39.37,0:14:41.53,Main,,0,0,0,,Kaçmana izin vermeyeceğim.
Dialogue: 0,0:14:43.18,0:14:44.36,Main,,0,0,0,,Harekete geç!
Dialogue: 0,0:14:44.78,0:14:47.78,Main,,0,0,0,,Acele edin! Magellan yaklaştı!
Dialogue: 0,0:14:47.78,0:14:49.88,Main,,0,0,0,,Hemen Seviye 2'ye!
Dialogue: 0,0:14:55.54,0:14:57.25,Main,,0,0,0,,Bu son gruptu.
Dialogue: 0,0:14:58.00,0:15:04.02,Main,,0,0,0,,Onlardan başka ardımızda\Ntek bir kişi bile ayakta kalmadı.
Dialogue: 0,0:15:13.40,0:15:14.36,Main,,0,0,0,,Inazuma.
Dialogue: 0,0:15:16.70,0:15:17.64,Main,,0,0,0,,Anlaşıldı.
Dialogue: 0,0:15:19.80,0:15:21.16,Main,,0,0,0,,{\fad(150,150)}Büyük Makas!
Dialogue: 0,0:15:37.38,0:15:38.70,Main,,0,0,0,,Inazuma-san!
Dialogue: 0,0:15:40.07,0:15:42.01,Main,,0,0,0,,Niye merdivenleri kestiniz?!
Dialogue: 0,0:15:42.01,0:15:44.66,Main,,0,0,0,,Iva-sama hâlâ aşağıda!
Dialogue: 0,0:15:44.66,0:15:47.18,Main,,0,0,0,,Boş ver, hemen bu kattan git!
Dialogue: 0,0:15:50.56,0:15:52.98,Main,,0,0,0,,Lütfen hayatta kal!
Dialogue: 0,0:16:07.61,0:16:09.40,Main,,0,0,0,,Allah aşkına bu...
Dialogue: 0,0:16:09.99,0:16:11.47,Main,,0,0,0,,...ne anlama geliyor?!
Dialogue: 0,0:16:12.05,0:16:14.07,Main,,0,0,0,,Ne anlama mı geliyor?
Dialogue: 0,0:16:15.97,0:16:18.73,Main,,0,0,0,,O hareketin ne demek\Nolduğunu anlamıyorsan...
Dialogue: 0,0:16:30.60,0:16:33.02,Main,,0,0,0,,...tam bir...
Dialogue: 0,0:16:34.41,0:16:36.52,Main,,0,0,0,,...APTALSIN, DEĞİL Mİ?!
Dialogue: 0,0:16:37.16,0:16:40.44,Main,,0,0,0,,{\fad(150,150)}Ölüm Göz Kırpışı!
Dialogue: 0,0:16:45.66,0:16:52.25,Main,,0,0,0,,Zaman kazanmak için beni oyalarken Hasır Şapka\Nve diğerlerinin kaçmasına izin vermeyeceğim!
Dialogue: 0,0:16:52.55,0:16:54.47,Main,,0,0,0,,Zaman kazanmak için oyalamak mı?
Dialogue: 0,0:16:56.19,0:17:00.57,Main,,0,0,0,,Beni gerçekten yenebileceğini\Ndüşünmüyorsun, değil mi?
Dialogue: 0,0:17:03.46,0:17:09.84,Main,,0,0,0,,Yüce Kamabakka tapınağı Newkama\NKenposu'nun gerçek gücünü sana göstereceğim!
Dialogue: 0,0:17:29.54,0:17:32.83,Main,,0,0,0,,Hadi çıkın! Dış dünya sizi bekliyor!
Dialogue: 0,0:17:32.83,0:17:35.57,Main,,0,0,0,,Sağol, Kaptan Buggy!
Dialogue: 0,0:17:35.57,0:17:36.45,Main,,0,0,0,,Tamam!
Dialogue: 0,0:17:36.45,0:17:37.81,Main,,0,0,0,,Özgürüz!
Dialogue: 0,0:17:37.81,0:17:39.34,Main,,0,0,0,,Çok çalışın bakalım, tamam mı?
Dialogue: 0,0:17:39.78,0:17:40.38,Main,,0,0,0,,Al.
Dialogue: 0,0:17:40.38,0:17:40.88,Main,,0,0,0,,Sağol.
Dialogue: 0,0:17:40.88,0:17:42.05,Main,,0,0,0,,Al bunu.
Dialogue: 0,0:17:49.65,0:17:53.19,Main,,0,0,0,,İlerleyin! Devam edin!
Dialogue: 0,0:17:53.71,0:17:58.73,Narrator,,0,0,0,,Daha önce Seviye 2'de Magellan'ın zehriyle\Ntuzağa düşen ama şans eseri kaçmayı başaran...
Dialogue: 0,0:17:58.73,0:18:02.99,Narrator,,0,0,0,,...Kaptan Buggy ve neşeli\Nmahkumları, şimdi ön girişe ilerliyor.
Dialogue: 0,0:18:02.99,0:18:04.49,Narrator,,0,0,0,,Şu anda Seviye 1'deler.
Dialogue: 0,0:18:05.72,0:18:09.36,Narrator,,0,0,0,,Seviye 4 Yanan Cehennem'den\Nve Seviye 3 Kıtlık Cehennemi'nden geçen...
Dialogue: 0,0:18:09.36,0:18:12.42,Narrator,,0,0,0,,...Hasır Şapkalı Luffy, emrindeki Newkama\Nbirlikleri ve serbest kalan mahkumlar,...
Dialogue: 0,0:18:12.42,0:18:18.17,Narrator,,0,0,0,,...şu anda Seviye 2 Lanetli Canavarlar\NKatı boyunca koşturuyorlar.
Dialogue: 0,0:18:19.00,0:18:22.81,Narrator,,0,0,0,,Onları yakalamaya çalışan Cehennem'in\NHükümdarı Müdür Magellan,...
Dialogue: 0,0:18:22.81,0:18:26.60,Narrator,,0,0,0,,...Seviye 3'te Okama\NKraliçesi Ivankov ile dövüşüyor.
Dialogue: 0,0:18:29.79,0:18:31.65,Main,,0,0,0,,Omurgamı...
Dialogue: 0,0:18:32.53,0:18:34.52,Main,,0,0,0,,...kırdı.
Dialogue: 0,0:18:34.80,0:18:37.23,Main,,0,0,0,,L-Lanet olası Ivankov!
Dialogue: 0,0:18:44.55,0:18:46.32,Main,,0,0,0,,Seni affetmeyeceğim!
Dialogue: 0,0:18:55.80,0:18:57.21,Main,,0,0,0,,Kıpırdayın!
Dialogue: 0,0:18:58.61,0:18:59.88,Main,,0,0,0,,Daha ne kadar...
Dialogue: 0,0:19:00.51,0:19:01.84,Main,,0,0,0,,...uyuyacaksınız?!
Dialogue: 0,0:19:06.82,0:19:11.85,Narrator,,0,0,0,,Yedikleri dayağın etkisinden yeni\Nkurtulan Şeytan Muhafızlar,...
Dialogue: 0,0:19:11.85,0:19:14.36,Narrator,,0,0,0,,...asansörle Seviye 1'e gidiyor.
Dialogue: 0,0:19:16.78,0:19:21.96,Narrator,,0,0,0,,Hain Baş Gardiyan Shiryuu, dış\Ndünya ile olan tüm iletişimi engelledi.
Dialogue: 0,0:19:21.96,0:19:25.86,Narrator,,0,0,0,,Hapishanenin şu anki durumundan\Nkimsenin haberi yok.
Dialogue: 0,0:19:27.16,0:19:32.83,Narrator,,0,0,0,,Denizin altındaki bu beklenmedik\Nolay kızışmaya devam ederken...
Dialogue: 0,0:19:33.96,0:19:38.46,Main,,0,0,0,,Savaş gemileri ve hapishane gemileri\Nhapishanenin etrafında konuşlanmış durumda!
Dialogue: 0,0:19:38.46,0:19:44.17,Main,,0,0,0,,Onlardan birini kaçırabilirsek Ace-san idam\Nedilmeden önce Marineford'a ulaşabiliriz!
Dialogue: 0,0:19:44.17,0:19:46.05,Main,,0,0,0,,Tamam!
Dialogue: 0,0:19:46.05,0:19:48.53,Main,,0,0,0,,Beni bekle, Ace!
Dialogue: 0,0:19:49.61,0:19:55.49,Narrator,,0,0,0,,Ace'in hızla yaklaşan idamına\Ndört buçuk saat kaldı.
Dialogue: 0,0:20:11.57,0:20:13.17,Main,,0,0,0,,Paçalı don!
Dialogue: 0,0:20:13.17,0:20:14.88,Main,,0,0,0,,Kombinezon!
Dialogue: 0,0:20:15.93,0:20:17.08,Main,,0,0,0,,Tuhaf.
Dialogue: 0,0:20:17.08,0:20:19.92,Main,,0,0,0,,Zehir adam daha demin ardımızdaydı.
Dialogue: 0,0:20:19.92,0:20:23.89,Main,,0,0,0,,Iva-san ve Inazuma, onu\Nmerdivenlerin dibinde durdurdu!
Dialogue: 0,0:20:24.92,0:20:28.73,Main,,0,0,0,,O zaman şu anda zehir\Nadamla mı dövüşüyorlar?
Dialogue: 0,0:20:28.73,0:20:29.52,Main,,0,0,0,,Geri dönelim!
Dialogue: 0,0:20:29.52,0:20:32.06,Main,,0,0,0,,Şakayı bırak!
Dialogue: 0,0:20:32.06,0:20:35.19,Main,,0,0,0,,Dövüşüyorlarsa ilerlememiz daha da\Nönemli hâle geliyor demektir!
Dialogue: 0,0:20:35.19,0:20:38.53,Main,,0,0,0,,Mucize İşçisi'nin gücüne inanalım!
Dialogue: 0,0:20:41.73,0:20:42.95,Main,,0,0,0,,Dön, dön!
Dialogue: 0,0:20:42.95,0:20:45.46,Main,,0,0,0,,Bu katın nesi var böyle?
Dialogue: 0,0:20:45.46,0:20:47.66,Main,,0,0,0,,Tamamen terk edilmiş.
Dialogue: 0,0:20:47.66,0:20:49.18,Main,,0,0,0,,Tuhaf...
Dialogue: 0,0:20:49.18,0:20:52.85,Main,,0,0,0,,Hücrelerde mahkûmlardan iz yok.
Dialogue: 0,0:20:52.85,0:20:55.41,Main,,0,0,0,,Hepsi çoktan açılmış!
Dialogue: 0,0:20:56.50,0:20:59.31,Main,,0,0,0,,Kim çıkardı onları acaba?
Dialogue: 0,0:21:17.43,0:21:19.06,Main,,0,0,0,,Yüzüm...
Dialogue: 0,0:21:19.06,0:21:23.14,Main,,0,0,0,,YÜZÜM ERİYOR!
Dialogue: 0,0:21:27.72,0:21:34.66,Main,,0,0,0,,Yüzüm... Yüzüm...!
Dialogue: 0,0:21:34.66,0:21:39.29,Main,,0,0,0,,Yüzüm... Yüzüm... Yüzüm...
Dialogue: 0,0:21:39.29,0:21:40.97,Main,,0,0,0,,...ERİMİYOR!
Dialogue: 0,0:21:40.97,0:21:42.84,Main,,0,0,0,,Sadece aşırı makyaj yapmıştım!
Dialogue: 0,0:21:43.08,0:21:45.79,Main,,0,0,0,,Ne saçma bir zaman kaybı!
Dialogue: 0,0:21:46.25,0:21:47.67,Main,,0,0,0,,Öyle mi?
Dialogue: 0,0:21:47.67,0:21:50.42,Main,,0,0,0,,Bence komik ama.
Dialogue: 0,0:21:50.42,0:21:54.00,Main,,0,0,0,,O zaman buna son vermemize ne dersin?
Dialogue: 0,0:21:54.70,0:21:59.11,Main,,0,0,0,,Aramızdaki dövüşe...?!
Dialogue: 0,0:22:02.40,0:22:04.24,Main,,0,0,0,,{\fad(150,150)}Newkama Kenpo...
Dialogue: 0,0:22:04.24,0:22:06.60,Main,,0,0,0,,{\fad(150,200)}...Estetik Sanatı 44 - Gizli Teknik!
Dialogue: 0,0:22:11.33,0:22:13.50,Main,,0,0,0,,{\fad(150,200)}İstenmeyen Tüylerden Kurtulma Yumruğu!
Dialogue: 0,0:22:26.04,0:22:27.21,Main,,0,0,0,,Iva-san!
Dialogue: 0,0:22:47.94,0:22:49.50,Flashbacks,,0,0,0,,Iva-san...!
Dialogue: 0,0:22:52.33,0:22:53.63,Flashbacks,,0,0,0,,İşe yaramadı mı?!
Dialogue: 0,0:22:54.78,0:22:56.27,Main,,0,0,0,,{\fad(150,150)}Dışarıda Bırak!
Dialogue: 0,0:23:01.29,0:23:03.43,Main,,0,0,0,,Oyalamak için bir girişim daha mı?
Dialogue: 0,0:23:08.10,0:23:10.48,Main,,0,0,0,,Geldiler!
Dialogue: 0,0:23:14.11,0:23:19.90,Main,,0,0,0,,Nihayet buraya gelebildik ama\NŞeytan Muhafızlar'ın dördü de burada!
Dialogue: 0,0:23:20.34,0:23:21.67,Main,,0,0,0,,Koş!
Dialogue: 0,0:23:22.91,0:23:27.12,Main,,0,0,0,,Buraya kadar! Geri dönelim! Kazanamayız!
Dialogue: 0,0:23:27.12,0:23:29.79,Main,,0,0,0,,Kaçmaktan vazgeçelim!
Dialogue: 0,0:23:29.79,0:23:31.37,Main,,0,0,0,,NEEEEEE?!
Dialogue: 0,0:23:34.54,0:23:36.41,Main,,0,0,0,,İyi misin?
Dialogue: 0,0:23:36.41,0:23:38.88,Main,,0,0,0,,Hey! Dikkat etsene, lanet croco{\fscx250}-{\r}
Dialogue: 0,0:23:38.88,0:23:40.81,Main,,0,0,0,,-DILE?!
Dialogue: 0,0:23:40.81,0:23:43.77,Main,,0,0,0,,P-P-P-P-Patron?!
Dialogue: 0,0:23:44.67,0:23:48.17,Main,,0,0,0,,Demek sensin, Bay 3.
Dialogue: 0,0:23:48.17,0:23:51.27,Main,,0,0,0,,Senin gibi beş para etmez\Nbirinin burada ne işi var?
Dialogue: 0,0:23:52.12,0:23:54.98,Main,,0,0,0,,Epey okkalı birini salmışlar.
Dialogue: 0,0:23:55.41,0:23:57.78,Main,,0,0,0,,K-Kaptan Buggy!
Dialogue: 0,0:23:59.83,0:24:03.00,Main,,0,0,0,,Şeytan Muhafızları hakladılar!
Dialogue: 0,0:24:04.53,0:24:06.54,Main,,0,0,0,,H-Hasır Şapka?!
Dialogue: 0,0:24:06.54,0:24:09.65,Main,,0,0,0,,O Shichibukai Jinbei mi?!
Dialogue: 0,0:24:10.79,0:24:13.67,Main,,0,0,0,,Hele şükür! Demek iyisiniz?
Dialogue: 0,0:24:14.04,0:24:16.42,Note,,0,0,0,,{\fad(100,100)}Yazılar: Hele şükür! Demek iyisiniz?
Dialogue: 0,0:24:17.38,0:24:19.43,Main,,0,0,0,,Kalbim!
Dialogue: 0,0:24:19.43,0:24:21.09,Main,,0,0,0,,Acıyor!
Dialogue: 0,0:24:21.65,0:24:23.00,Main,,0,0,0,,Kaptan Buggy!
Dialogue: 0,0:24:23.00,0:24:27.73,Main,,0,0,0,,Seviye 2'den mahkûmlar ve\Nsapıklar gelmeye devam ediyor!
Dialogue: 0,0:24:27.73,0:24:29.07,Main,,0,0,0,,Sapıklar da mı?!
Dialogue: 0,0:24:29.07,0:24:29.93,Main,,0,0,0,,O da ne?!
Dialogue: 0,0:24:29.93,0:24:31.98,Main,,0,0,0,,Siz kime sapık diyorsunuz?!
Dialogue: 0,0:24:32.49,0:24:37.10,Main,,0,0,0,,Siz... Bizi orada nasıl terk edersiniz?!
Dialogue: 0,0:24:37.10,0:24:39.10,Main,,0,0,0,,Sen de mi buradasın, Bay 2?!
Dialogue: 0,0:24:39.10,0:24:41.28,Main,,0,0,0,,Kaptan Buggy'ye ne yapıyorsun?!
Dialogue: 0,0:24:42.61,0:24:44.34,Main,,0,0,0,,Durum kötü!
Dialogue: 0,0:24:44.34,0:24:48.58,Main,,0,0,0,,Seviye 4'teki mahkûmlar buraya gelmişler!
Dialogue: 0,0:24:48.58,0:24:50.97,Main,,0,0,0,,Müdür Magellan'dan kaçmayı başarmışlar mı?
Dialogue: 0,0:24:50.97,0:24:52.26,Main,,0,0,0,,Nasıl olabilir?
Dialogue: 0,0:24:52.26,0:24:55.11,Main,,0,0,0,,İki isyancı grubu güç birliği yaptı!
Dialogue: 0,0:24:55.11,0:24:56.82,Main,,0,0,0,,Müdür nerede?!
Dialogue: 0,0:24:56.82,0:24:57.66,Main,,0,0,0,,{\fad(150,150)}Hidra!
Dialogue: 0,0:25:07.09,0:25:09.26,Main,,0,0,0,,MAGELLAN DA MI?!
Dialogue: 0,0:25:09.26,0:25:11.56,Main,,0,0,0,,BU KATTA NELER OLUYOR?!
Dialogue: 0,0:25:11.56,0:25:14.55,Main,,0,0,0,,Ha?! O zaman Iva-chan ve Yengeç-chan...
Dialogue: 0,0:25:22.99,0:25:24.91,Main,,0,0,0,,Lanet olsun!
Dialogue: 0,0:25:29.01,0:25:30.46,Main,,0,0,0,,Olmaz, Hasır-chan!
Dialogue: 0,0:25:30.46,0:25:33.54,Main,,0,0,0,,Magellan'dan kaçmaktan başka çaremiz yok!
Dialogue: 0,0:25:34.64,0:25:36.74,Main,,0,0,0,,Bırak beni, Bon-chan!
Dialogue: 0,0:25:36.74,0:25:39.18,Main,,0,0,0,,Onun canına okuyacağım!
Dialogue: 0,0:25:40.58,0:25:42.41,Main,,0,0,0,,Emin misin?
Dialogue: 0,0:25:42.97,0:25:45.25,Main,,0,0,0,,Anlıyorum, ama gerçekten\Nyapmamızı istiyor musunuz?
Dialogue: 0,0:25:45.25,0:25:50.65,Main,,0,0,0,,Evet. Emirlerime uyun ve hemen yapın!
Dialogue: 0,0:25:50.65,0:25:51.44,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:25:53.24,0:25:56.66,Main,,0,0,0,,Olamaz, planları bu muydu?
Dialogue: 0,0:25:59.68,0:26:06.00,Main,,0,0,0,,Onun yüzünden neredeyse\Nölüyordun, unuttun mu?!
Dialogue: 0,0:26:06.00,0:26:07.92,Main,,0,0,0,,Ama hâlâ hayattayım, değil mi?
Dialogue: 0,0:26:08.72,0:26:13.76,Main,,0,0,0,,Mucizelere ikince kez\Nolmadığı için öyle denir.
Dialogue: 0,0:26:15.46,0:26:17.81,Main,,0,0,0,,İkiniz hemen diğer kata gidin!
Dialogue: 0,0:26:18.94,0:26:20.52,Main,,0,0,0,,Luffy-kun!
Dialogue: 0,0:26:20.52,0:26:23.90,Main,,0,0,0,,Hemen ana girişe gitmeliyiz!
Dialogue: 0,0:26:24.21,0:26:26.20,Main,,0,0,0,,Durum daha da kötüleşti.
Dialogue: 0,0:26:26.20,0:26:29.14,Main,,0,0,0,,Magellan'a çok fazla odaklandık!
Dialogue: 0,0:26:29.62,0:26:30.42,Main,,0,0,0,,{\fad(150,150)}Hidra!
Dialogue: 0,0:26:32.47,0:26:34.51,Main,,0,0,0,,Herkes önünden çekilsin!
Dialogue: 0,0:26:48.20,0:26:50.26,Main,,0,0,0,,{\fad(150,150)}Mum Duvar!
Dialogue: 0,0:26:50.92,0:26:51.67,Main,,0,0,0,,Üç!
Dialogue: 0,0:26:53.47,0:26:56.05,Main,,0,0,0,,Magellan'ın hidrasını durdurdu!
Dialogue: 0,0:26:56.80,0:27:00.89,Main,,0,0,0,,İyimserliğin beni kusturacak!
Dialogue: 0,0:27:01.38,0:27:05.58,Main,,0,0,0,,Tedbiri elden bıraktığım anda\Nseni arkadaş olarak düşünüyorum.
Dialogue: 0,0:27:06.24,0:27:08.02,Main,,0,0,0,,Üfff...
Dialogue: 0,0:27:08.69,0:27:11.82,Main,,0,0,0,,Başkalarına borçlu\Nolmaktan nefret ediyorum!
Dialogue: 0,0:27:12.26,0:27:14.24,Main,,0,0,0,,Seni hafife almışız, Üç Kardeş!
Dialogue: 0,0:27:15.69,0:27:19.12,Main,,0,0,0,,Anlıyorum. Mum, öyle mi?
Dialogue: 0,0:27:19.12,0:27:20.83,Main,,0,0,0,,Evet.
Dialogue: 0,0:27:20.83,0:27:23.54,Main,,0,0,0,,Doru Doru Meyvesi yedim. Ben mum adamım.
Dialogue: 0,0:27:23.99,0:27:29.52,Main,,0,0,0,,Zehrin çelik kadar sert\Nmum duvarımı asla geçemez!
Dialogue: 0,0:27:30.48,0:27:34.04,Main,,0,0,0,,Bazı güçlerin ne kadar uygun\Nolacağını asla bilemezsin.
Dialogue: 0,0:27:34.04,0:27:36.27,Main,,0,0,0,,Hadi, gidin hemen!
Dialogue: 0,0:27:36.27,0:27:38.95,Main,,0,0,0,,Kolay vazgeçtiğimi biliyorsunuz!
Dialogue: 0,0:27:38.95,0:27:40.04,Main,,0,0,0,,Üç!
Dialogue: 0,0:27:40.04,0:27:41.37,Main,,0,0,0,,Ne sinir bozucu.
Dialogue: 0,0:27:46.96,0:27:50.34,Main,,0,0,0,,Tereddüt edecek zaman değil!\NOnu uzun süre tutamam!
Dialogue: 0,0:27:50.34,0:27:52.85,Main,,0,0,0,,Tamam. Gidiyoruz o zaman.
Dialogue: 0,0:27:52.85,0:27:54.98,Main,,0,0,0,,Gidelim beyler!
Dialogue: 0,0:27:56.37,0:27:57.96,Main,,0,0,0,,Hep bu kadar iyi miydin?!
Dialogue: 0,0:27:57.96,0:28:00.04,Main,,0,0,0,,Evet, sıcak katta olmadığım sürece.
Dialogue: 0,0:28:00.04,0:28:02.10,Main,,0,0,0,,Hepiniz bir an önce gidin!
Dialogue: 0,0:28:02.10,0:28:04.52,Main,,0,0,0,,Ben de kaçmak istiyorum!
Dialogue: 0,0:28:04.52,0:28:07.58,Main,,0,0,0,,Luffy-kun. Biz de acele etmeliyiz!
Dialogue: 0,0:28:07.58,0:28:11.63,Main,,0,0,0,,Sahi, savaş gemisi çalacağımızı\Nsöylemiştin, değil mi?
Dialogue: 0,0:28:11.63,0:28:12.89,Main,,0,0,0,,Evet.
Dialogue: 0,0:28:12.89,0:28:15.25,Main,,0,0,0,,O zaman diğerleriyle önden gitmelisin.
Dialogue: 0,0:28:15.25,0:28:17.45,Main,,0,0,0,,Ben de bu arada zehir adamı\Ndurdurmaya çalışacağım.
Dialogue: 0,0:28:17.99,0:28:21.32,Main,,0,0,0,,Demek istediğim, o peşimizde\Nolunca çalması zor olacak.
Dialogue: 0,0:28:21.32,0:28:23.16,Main,,0,0,0,,Evet, doğru.
Dialogue: 0,0:28:23.16,0:28:24.92,Main,,0,0,0,,Bir fikrim var.
Dialogue: 0,0:28:25.54,0:28:27.17,Main,,0,0,0,,Şansı var mı bari?
Dialogue: 0,0:28:27.46,0:28:29.54,Main,,0,0,0,,Evet, bana bırak!
Dialogue: 0,0:28:29.54,0:28:33.34,Main,,0,0,0,,Tamam. Pervasızca bir şey yapma sakın!
Dialogue: 0,0:28:34.34,0:28:36.92,Main,,0,0,0,,Tamam, Üç! Birlikte dövüşelim!
Dialogue: 0,0:28:36.92,0:28:39.99,Main,,0,0,0,,Hayır, bu yanlış! Kesinlikle\Ndövüşmeye niyetim yok!
Dialogue: 0,0:28:39.99,0:28:42.27,Main,,0,0,0,,Tek amacım olabildiğince\Nkendimizi korumak ve kaçmaktı.
Dialogue: 0,0:28:42.27,0:28:45.87,Main,,0,0,0,,Üç Kardeş! Biz de kalıp yardım edeceğiz!
Dialogue: 0,0:28:45.87,0:28:48.47,Main,,0,0,0,,O kadar istekli değilim diyorum!
Dialogue: 0,0:28:50.00,0:28:51.89,Main,,0,0,0,,ÇOK HAVALI!
Dialogue: 0,0:28:52.28,0:28:54.35,Main,,0,0,0,,Mükemmel!
Dialogue: 0,0:28:54.35,0:28:55.93,Main,,0,0,0,,Karşındakine odaklan!
Dialogue: 0,0:28:55.93,0:28:58.15,Main,,0,0,0,,Böyle bir zamanda neden bahsediyorsun?!
Dialogue: 0,0:28:58.15,0:29:01.83,Main,,0,0,0,,Gözyaşlarıma engel olamıyorum!
Dialogue: 0,0:29:01.83,0:29:05.91,Main,,0,0,0,,Beni bu kadar müthiş yaptığın için sağol!
Dialogue: 0,0:29:05.91,0:29:07.70,Main,,0,0,0,,Umrumda değil! Hemen dövüş onunla!
Dialogue: 0,0:29:09.44,0:29:10.91,Main,,0,0,0,,G-Geliyor!
Dialogue: 0,0:29:12.10,0:29:12.74,Main,,0,0,0,,{\fad(150,150)}Hidra!
Dialogue: 0,0:29:17.34,0:29:19.62,Main,,0,0,0,,{\fad(150,150)}Mum Duvar!
Dialogue: 0,0:29:14.50,0:29:15.37,Main,,0,0,0,,Üç!
Dialogue: 0,0:29:15.37,0:29:17.29,Main,,0,0,0,,Bana bırak!
Dialogue: 0,0:29:21.00,0:29:23.54,Main,,0,0,0,,Kaç kez denersen dene, işe yaramayacak!
Dialogue: 0,0:29:34.04,0:29:36.30,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:29:36.98,0:29:41.02,Main,,0,0,0,,{\fad(150,150)}...Şampiyon Tüfek!
Dialogue: 0,0:29:44.52,0:29:46.64,Main,,0,0,0,,Tamam! Ona dokunabiliyorum!
Dialogue: 0,0:29:47.77,0:29:49.57,Main,,0,0,0,,Topları hazırladık!
Dialogue: 0,0:29:49.57,0:29:51.65,Main,,0,0,0,,Mum duvar bizi koruyor!
Dialogue: 0,0:29:56.49,0:29:58.97,Main,,0,0,0,,Müthiş! Vurduk onu!
Dialogue: 0,0:29:58.97,0:30:00.70,Main,,0,0,0,,Başarabiliriz!
Dialogue: 0,0:30:02.32,0:30:03.67,Main,,0,0,0,,Tamamdır!
Dialogue: 0,0:30:09.32,0:30:11.88,Main,,0,0,0,,Neredeyse vardık! Yüzeye doğru ilerleyin!
Dialogue: 0,0:30:11.88,0:30:13.09,Main,,0,0,0,,Sadece biraz daha!
Dialogue: 0,0:30:13.09,0:30:14.42,Main,,0,0,0,,Nihayet çıkabiliriz!
Dialogue: 0,0:30:27.25,0:30:31.13,Main,,0,0,0,,Buraya kadar geldiğimize göre kendilerine\Ndüşmanımız diyebilecek kimse kalmadı.
Dialogue: 0,0:30:31.13,0:30:35.28,Main,,0,0,0,,Tedbiri elden bırakma, amatör.
Dialogue: 0,0:30:35.28,0:30:36.41,Main,,0,0,0,,Ne?!
Dialogue: 0,0:30:36.41,0:30:40.89,Main,,0,0,0,,Bu duvarların ardında\Nen azından on savaş gemisi var.
Dialogue: 0,0:30:41.75,0:30:44.69,Main,,0,0,0,,Her gemide de sekiz yüz kadar denizci.
Dialogue: 0,0:30:44.69,0:30:47.85,Main,,0,0,0,,Bizi durdurmak için ne tür\Nplanları olduğunu bilmiyorum...
Dialogue: 0,0:30:47.85,0:30:53.40,Main,,0,0,0,,...ama gemilerden birini çalarak\Ndiğerlerini düşman edineceğimiz kesin.
Dialogue: 0,0:30:54.60,0:30:56.53,Main,,0,0,0,,Hafife alacak zaman değil.
Dialogue: 0,0:30:57.89,0:31:00.04,Main,,0,0,0,,A-Anlıyorum.
Dialogue: 0,0:31:00.04,0:31:02.86,Main,,0,0,0,,Tek sorun bu değil.
Dialogue: 0,0:31:05.27,0:31:07.24,Main,,0,0,0,,Hiç muhafız kalmadı!
Dialogue: 0,0:31:07.24,0:31:09.31,Main,,0,0,0,,Sadece bu kapıdan geçmemiz lazım!
Dialogue: 0,0:31:14.26,0:31:17.79,Main,,0,0,0,,Tamam! Silahlarınızı hazırlayın!
Dialogue: 0,0:31:17.79,0:31:20.21,Main,,0,0,0,,Kapıyı açalım!
Dialogue: 0,0:31:23.70,0:31:27.11,Main,,0,0,0,,Yapalım! Hazır, itin!
Dialogue: 0,0:31:29.95,0:31:32.16,Main,,0,0,0,,Nihayet dış dünyanın ışığını göreceğiz!
Dialogue: 0,0:31:32.16,0:31:35.42,Main,,0,0,0,,Aptal! Daha bu işten yakamızı sıyırmadık!
Dialogue: 0,0:31:35.42,0:31:38.01,Main,,0,0,0,,Donanma birlikleri bu\Nkapının ardında bekliyor.
Dialogue: 0,0:31:38.01,0:31:41.79,Main,,0,0,0,,Kazanırsak Cennet'e ulaşacağız!\NYenilirsek Cehennem'e gideceğiz!
Dialogue: 0,0:31:50.68,0:31:52.12,Main,,0,0,0,,Işık!
Dialogue: 0,0:31:52.12,0:31:53.95,Main,,0,0,0,,Buradan çıkıyoruz!
Dialogue: 0,0:31:53.95,0:31:56.12,Main,,0,0,0,,Herkes biraz daha gayret etsin!
Dialogue: 0,0:31:56.12,0:32:01.75,Main,,0,0,0,,Kaç birliğin bizi beklediğini bilmiyorum\Nama onları yenip denize döneceğiz!
Dialogue: 0,0:32:07.72,0:32:12.13,Main,,0,0,0,,Gidelim beyler!
Dialogue: 0,0:32:35.06,0:32:38.49,Main,,0,0,0,,Gidelim beyler!
Dialogue: 0,0:32:39.99,0:32:43.02,Main,,0,0,0,,Peşimden gelin!
Dialogue: 0,0:32:55.42,0:32:58.80,Main,,0,0,0,,Neler oluyor?!
Dialogue: 0,0:32:59.35,0:33:01.86,Main,,0,0,0,,Hiç savaş gemisi yok!
Dialogue: 0,0:33:03.42,0:33:06.72,Main,,0,0,0,,Çalabileceğimiz tek bir\Nsavaş gemisi bile yok!
Dialogue: 0,0:33:06.72,0:33:09.69,Main,,0,0,0,,Bir tek denizci de yok!
Dialogue: 0,0:33:10.39,0:33:12.67,Main,,0,0,0,,Olamaz. Bunun anlamı....
Dialogue: 0,0:33:13.19,0:33:15.41,Main,,0,0,0,,...kaçmak mümkün değil, değil mi?!
Dialogue: 0,0:33:17.92,0:33:19.96,Main,,0,0,0,,Ne yapacağız?
Dialogue: 0,0:33:21.26,0:33:23.13,Main,,0,0,0,,Âciz bir şekilde Magellan'ın...
Dialogue: 0,0:33:23.13,0:33:26.50,Main,,0,0,0,,...gelişini beklemekten\Nbaşka çaremiz yok mu?
Dialogue: 0,0:33:26.81,0:33:29.92,Main,,0,0,0,,Lanet olsun! Şaka olmalı!
Dialogue: 0,0:33:30.99,0:33:35.89,Main,,0,0,0,,Anlıyorum. Demek düşman\Ndüşündüğümüz kadar aptal değildi.
Dialogue: 0,0:33:36.86,0:33:39.90,Main,,0,0,0,,Okyanusun dibinde\Nbüyük Deniz Kralları dolaşıyor.
Dialogue: 0,0:33:39.90,0:33:44.77,Main,,0,0,0,,Calm Belt gerçekten Impel\NDown'ın en büyük savunması.
Dialogue: 0,0:33:45.44,0:33:49.76,Main,,0,0,0,,Sonunda cehennemin derinliklerinden\Nburaya kadar gelmeyi başarmıştık!
Dialogue: 0,0:33:49.76,0:33:53.44,Main,,0,0,0,,Kahretsin! Bu durumda doğruca\NCehennem'e geri düşeceğiz!
Dialogue: 0,0:33:54.02,0:33:56.41,Main,,0,0,0,,Ağlayıp sızlanacak zamanımız yok!
Dialogue: 0,0:33:56.71,0:34:01.70,Main,,0,0,0,,Magellen birkaç dakika önce\Nonlara yola çıkmalarını emretti.
Dialogue: 0,0:34:01.70,0:34:02.83,Main,,0,0,0,,İyi bakın!
Dialogue: 0,0:34:03.73,0:34:07.25,Main,,0,0,0,,Sisin içindeki gölgelerini\Nzor da olsa görebilirsiniz!
Dialogue: 0,0:34:07.39,0:34:09.37,Main,,0,0,0,,H-Haklısın!
Dialogue: 0,0:34:10.16,0:34:13.76,Main,,0,0,0,,Ama onları uzaktan görebilmenin\Nbize ne faydası olacak?!
Dialogue: 0,0:34:13.76,0:34:15.34,Main,,0,0,0,,Endişelenmeyin!
Dialogue: 0,0:34:16.02,0:34:20.01,Main,,0,0,0,,Ben varım! Bu meseleyi\Nbana bırakabilirsiniz!
Dialogue: 0,0:34:22.46,0:34:24.10,Main,,0,0,0,,Gerçekten mi?!
Dialogue: 0,0:34:24.10,0:34:26.31,Main,,0,0,0,,Aşırı derecede güçlü!
Dialogue: 0,0:34:26.31,0:34:28.38,Main,,0,0,0,,Savaşma kararlılığına\Nsahip olan herkes binsin!
Dialogue: 0,0:34:34.17,0:34:36.09,Main,,0,0,0,,Hey, hemen bin.
Dialogue: 0,0:34:36.38,0:34:38.55,Main,,0,0,0,,Pekâlâ! Acele edelim!
Dialogue: 0,0:34:44.35,0:34:47.23,Main,,0,0,0,,Ağır kapıyı taşırken son sürat ilerliyor!
Dialogue: 0,0:34:47.89,0:34:50.81,Main,,0,0,0,,Balık Adam Korsanları'ndan da bu beklenir!
Dialogue: 0,0:34:51.65,0:34:54.40,Main,,0,0,0,,Gerçekten heyecanlanıyorum!
Dialogue: 0,0:34:54.40,0:34:56.61,Main,,0,0,0,,Bir Shichibukai'yi hareket halinde\Ngöreceğimi hiç düşünmemiştim!
Dialogue: 0,0:34:56.61,0:35:00.53,Main,,0,0,0,,Üstelik kurtarıcımız\NKaptan Buggy de onlarla.
Dialogue: 0,0:35:00.53,0:35:03.08,Main,,0,0,0,,Bizim için hâlâ umut var!
Dialogue: 0,0:35:07.04,0:35:08.54,Main,,0,0,0,,Sersemler!
Dialogue: 0,0:35:08.54,0:35:14.42,Main,,0,0,0,,Bu Shichibukai'lerle kalmak, orada Magellan'ın\Nkorkusuyla beklemekten daha güvenli!
Dialogue: 0,0:35:14.42,0:35:15.92,Main,,0,0,0,,Ahmaklar!
Dialogue: 0,0:35:18.94,0:35:20.66,Main,,0,0,0,,Ateş ediyorlar!
Dialogue: 0,0:35:23.45,0:35:25.16,Main,,0,0,0,,Demek bizi fark ettiler.
Dialogue: 0,0:35:25.16,0:35:27.58,Main,,0,0,0,,Kurtuldu! Çok hızlı!
Dialogue: 0,0:35:27.58,0:35:31.00,Main,,0,0,0,,Onun sıradan bir balık adam olduğunu\Nsanmayın! O, Denizin Şövalyesi Jinbei!
Dialogue: 0,0:35:31.00,0:35:33.38,Main,,0,0,0,,Tüm gemiler, ateş!
Dialogue: 0,0:35:33.38,0:35:37.46,Main,,0,0,0,,Jinbei'yi batırırsak işleri biter!
Dialogue: 0,0:35:38.76,0:35:41.89,Main,,0,0,0,,Savaş gemileri hızla geliyor!
Dialogue: 0,0:35:47.64,0:35:51.48,Main,,0,0,0,,Sizi gemilerden birinin güvertesine\Nfırlatacağım! Sıkı tutunun!
Dialogue: 0,0:35:52.31,0:35:54.86,Main,,0,0,0,,Ne?! Ne dedin?!
Dialogue: 0,0:35:54.86,0:35:56.07,Main,,0,0,0,,Lanet olası balık!
Dialogue: 0,0:35:56.57,0:35:59.24,Main,,0,0,0,,Dinliyor musun, pislik?!
Dialogue: 0,0:35:59.24,0:36:01.82,Main,,0,0,0,,NELER OLUYOR?!
Dialogue: 0,0:36:01.82,0:36:06.45,Main,,0,0,0,,Anlıyorum! Bizi terk edip\Nkendi başına kaçtı!
Dialogue: 0,0:36:06.45,0:36:10.41,Main,,0,0,0,,HAİN! HAİN! HAİN! HAİN!
Dialogue: 0,0:36:09.04,0:36:10.41,Secondary,,0,0,0,,Zaten niye geldin ki?
Dialogue: 0,0:36:10.87,0:36:13.92,Main,,0,0,0,,Böyle giderse bizi vuracaklar!
Dialogue: 0,0:36:13.92,0:36:16.50,Main,,0,0,0,,Sakin ol lanet olası.
Dialogue: 0,0:36:18.09,0:36:20.55,Main,,0,0,0,,{\fad(0,150)}Balık Adam Jujutsusu...
Dialogue: 0,0:36:25.43,0:36:27.85,Main,,0,0,0,,{\fad(150,150)}Su Kalbi...
Dialogue: 0,0:36:34.52,0:36:36.65,Main,,0,0,0,,BU TARAFA GELİYOR!
Dialogue: 0,0:36:42.07,0:36:47.91,Main,,0,0,0,,{\fad(150,150)}Deniz Akıntısı Yükseltici!
Dialogue: 0,0:36:57.09,0:37:00.21,Main,,0,0,0,,UÇUYORUZ!
Dialogue: 0,0:37:02.34,0:37:04.05,Main,,0,0,0,,O su kolonu da ne öyle?
Dialogue: 0,0:37:04.05,0:37:05.72,Main,,0,0,0,,Sanki canlı bir varlık gibi!
Dialogue: 0,0:37:06.18,0:37:08.76,Main,,0,0,0,,O ne olabilir?!
Dialogue: 0,0:37:08.76,0:37:10.27,Main,,0,0,0,,Bilmiyorum.
Dialogue: 0,0:37:10.77,0:37:14.31,Main,,0,0,0,,Ama üstünde biri var... Bu Crocodile!
Dialogue: 0,0:37:24.15,0:37:25.45,Main,,0,0,0,,Geldiler!
Dialogue: 0,0:37:28.58,0:37:30.45,Main,,0,0,0,,Gemiyi çalmaya geldiler!
Dialogue: 0,0:37:30.45,0:37:32.58,Main,,0,0,0,,Almalarına izin vermeyin!
Dialogue: 0,0:37:32.58,0:37:35.71,Main,,0,0,0,,Şeytan Meyvesi kullanıcılarını\Ndenize itebilirsek biz kazanırız!
Dialogue: 0,0:37:37.42,0:37:39.67,Main,,0,0,0,,Ha?
