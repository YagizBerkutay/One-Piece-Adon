Dialogue: 0,0:00:37.55,0:00:38.65,Main,,0,0,0,,Hey.
Dialogue: 0,0:00:39.27,0:00:41.58,Main,,0,0,0,,Kimi denize iteceksiniz?
Dialogue: 0,0:00:42.66,0:00:45.20,Main,,0,0,0,,Rakiplerinizi tanımıyor gibisiniz.
Dialogue: 0,0:00:49.08,0:00:51.29,Main,,0,0,0,,Durmayın! Onları denize atın!
Dialogue: 0,0:01:05.20,0:01:06.10,Main,,0,0,0,,O da ne?
Dialogue: 0,0:01:09.81,0:01:10.90,Main,,0,0,0,,Bu Jinbei!
Dialogue: 0,0:01:11.38,0:01:13.34,Main,,0,0,0,,{\fad(150,150)}Balık Adam Karate!
Dialogue: 0,0:01:16.48,0:01:19.03,Main,,0,0,0,,{\fad(150,150)}Mızrak Dalgası!
Dialogue: 0,0:01:36.89,0:01:37.97,Main,,0,0,0,,Hey!
Dialogue: 0,0:01:41.33,0:01:43.57,Main,,0,0,0,,Oh, ne kadar dikkatsizim.
Dialogue: 0,0:01:43.57,0:01:47.31,Main,,0,0,0,,Kullanacağımız gemi oydu, değil mi?
Dialogue: 0,0:02:17.52,0:02:20.64,Main,,0,0,0,,Eyvah! Eyvah! Kaç, Hasır Şapka!
Dialogue: 0,0:02:15.09,0:02:17.52,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:02:21.93,0:02:25.81,Main,,0,0,0,,{\fad(150,150)}...Şampiyon Damgası!
Dialogue: 0,0:02:26.95,0:02:30.19,Main,,0,0,0,,Faydasız! Mumum artık\Nona karşı işe yaramaz!
Dialogue: 0,0:02:35.66,0:02:38.49,Main,,0,0,0,,{\fad(150,150)}Doru Doru İptal!
Dialogue: 0,0:02:44.41,0:02:45.39,Main,,0,0,0,,Çok yakındı!
Dialogue: 0,0:02:45.83,0:02:50.45,Main,,0,0,0,,{\fad(150,150)}Zehir Şeytanı!
Dialogue: 0,0:03:13.22,0:03:14.54,Main,,0,0,0,,Gidelim buradan!
Dialogue: 0,0:03:14.54,0:03:16.26,Main,,0,0,0,,Çabuk!
Dialogue: 0,0:03:24.13,0:03:25.97,Main,,0,0,0,,{\fad(150,150)}Cehennem'in Hükmü!
Dialogue: 0,0:03:30.76,0:03:32.43,Main,,0,0,0,,Kahretsin!
Dialogue: 0,0:03:32.85,0:03:34.80,Main,,0,0,0,,Hey... Yardım edin!
Dialogue: 0,0:03:34.80,0:03:36.02,Main,,0,0,0,,Beni de götürün!
Dialogue: 0,0:03:36.90,0:03:38.93,Main,,0,0,0,,Aptal! Bana dokunma!
Dialogue: 0,0:03:40.24,0:03:42.35,Main,,0,0,0,,Zehir yayılıyor!
Dialogue: 0,0:03:48.75,0:03:50.81,Main,,0,0,0,,Mum ya da taş olması önemli değil.
Dialogue: 0,0:03:50.81,0:03:55.07,Main,,0,0,0,,Zehir enfeksiyon gibi yayılıyor!
Dialogue: 0,0:03:55.07,0:03:59.53,Main,,0,0,0,,Lanet olsun! Doru Doru zırhı\Nartık tamamen faydasız!
Dialogue: 0,0:04:04.28,0:04:06.41,Captions,,0,0,40,,Impel Down Yüzey Katı - Ana Giriş
Dialogue: 0,0:04:08.87,0:04:11.99,Main,,0,0,0,,Hasır-chan ve diğerlerine ne oldu?
Dialogue: 0,0:04:13.84,0:04:15.47,Main,,0,0,0,,Savaş gemileri ne durumda?
Dialogue: 0,0:04:15.47,0:04:21.12,Main,,0,0,0,,Silah sesi duyabiliyorum ama\Nbu siste ne olduğu tam anlaşılmıyor!
Dialogue: 0,0:04:21.12,0:04:26.52,Main,,0,0,0,,Savaş gemilerinden birini\Nçalabileceklerinden eminim ama...
Dialogue: 0,0:04:27.93,0:04:30.08,Main,,0,0,0,,Yine de çok uzaktalar.
Dialogue: 0,0:04:30.08,0:04:34.14,Main,,0,0,0,,Birini çalıp geri getirmeleri zaman alacak.
Dialogue: 0,0:04:34.14,0:04:38.14,Main,,0,0,0,,Bu daha önce Magellan buraya\Ngelebilir demek olmuyor mu?
Dialogue: 0,0:04:39.47,0:04:42.53,Main,,0,0,0,,Hasır Şapkalı Luffy güçlü ama...
Dialogue: 0,0:04:42.53,0:04:46.79,Main,,0,0,0,,...Magellan'ı uzun süre\Ntutabileceğinden şüpheliyim.
Dialogue: 0,0:04:48.24,0:04:49.96,Main,,0,0,0,,Hasır-chan...
Dialogue: 0,0:04:50.32,0:04:55.09,Main,,0,0,0,,Lanet olsun! Lütfen acele et, Jinbei!
Dialogue: 0,0:05:05.60,0:05:08.93,Main,,0,0,0,,Onları denize doğru zorlayın!\NGemiyi almalarına izin vermeyin!
Dialogue: 0,0:05:16.94,0:05:18.89,Main,,0,0,0,,Bu herifin bedeni de ne öyle?!
Dialogue: 0,0:05:18.89,0:05:20.82,Main,,0,0,0,,Tüm vücudu bıçaklardan yapılmış!
Dialogue: 0,0:05:21.54,0:05:22.99,Main,,0,0,0,,Supa Supa Meyvesi yüzünden.
Dialogue: 0,0:05:21.54,0:05:22.99,Note,,0,0,0,,{\fad(100,100)}Supa Supa = Kesme sesi
Dialogue: 0,0:05:26.88,0:05:28.90,Main,,0,0,0,,Bu adamı şimdi hatırladım!
Dialogue: 0,0:05:28.90,0:05:31.68,Main,,0,0,0,,Batı Mavi suikastçisi, Daz!
Dialogue: 0,0:05:34.28,0:05:35.52,Main,,0,0,0,,{\fad(150,150)}Kum Fırtınası!
Dialogue: 0,0:05:42.35,0:05:45.26,Main,,0,0,0,,Gemiyi ele geçirmeleri an meselesi!
Dialogue: 0,0:05:45.26,0:05:47.45,Main,,0,0,0,,Bu Donanma için büyük bir\Nutanç kaynağı olurdu!
Dialogue: 0,0:05:47.45,0:05:48.81,Main,,0,0,0,,Hemen onu batırın!
Dialogue: 0,0:05:48.81,0:05:49.51,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:05:49.51,0:05:51.87,Main,,0,0,0,,Saldırıya hazırlanın!
Dialogue: 0,0:05:55.82,0:05:57.20,Main,,0,0,0,,Bu deminki şey!
Dialogue: 0,0:06:03.76,0:06:05.33,Main,,0,0,0,,Kahretsin, barutumuz ıslandı!
Dialogue: 0,0:06:05.76,0:06:06.62,Main,,0,0,0,,Jinbei mi?!
Dialogue: 0,0:06:09.04,0:06:11.46,Main,,0,0,0,,Bir batarya daha doldurup onu vurun!
Dialogue: 0,0:06:13.42,0:06:16.92,Main,,0,0,0,,Çabuk! Çabuk! Hemen arkamızda!
Dialogue: 0,0:06:34.55,0:06:38.70,Main,,0,0,0,,Hey! Herkes orada mı?!
Dialogue: 0,0:06:39.76,0:06:41.07,Main,,0,0,0,,Bu Hasır-chan'ın sesi!
Dialogue: 0,0:06:43.47,0:06:45.00,Main,,0,0,0,,Kaçmamız lazım!
Dialogue: 0,0:06:52.04,0:06:55.04,Main,,0,0,0,,Peşlerinden canavarımsı bir şey geliyor!
Dialogue: 0,0:06:55.04,0:06:57.63,Main,,0,0,0,,Bu Magellan! Kaçacak yer yok!
Dialogue: 0,0:07:00.15,0:07:01.93,Main,,0,0,0,,Daha savaş gemisi bulamadık mı?!
Dialogue: 0,0:07:01.93,0:07:05.70,Main,,0,0,0,,Hasır-chan! Hala bineceğimiz\Ngeminin gelmesini bekliyoruz!
Dialogue: 0,0:07:05.70,0:07:07.27,Main,,0,0,0,,Ne?!
Dialogue: 0,0:07:11.86,0:07:14.66,Main,,0,0,0,,{\fad(150,150)}Cehennem Göz Kırpışı!
Dialogue: 0,0:07:29.71,0:07:31.06,Main,,0,0,0,,Iva-chan?!
Dialogue: 0,0:07:33.42,0:07:35.42,Main,,0,0,0,,Bu ne sürpriz!
Dialogue: 0,0:07:35.42,0:07:39.68,Main,,0,0,0,,Galiba zamanında gelebildim.
Dialogue: 0,0:07:39.68,0:07:42.28,Main,,0,0,0,,Kafasını o kadar sert çarpmış ki bayıldı!
Dialogue: 0,0:07:44.49,0:07:48.58,Main,,0,0,0,,Iva-san! Inazuma da! Hayattasınız!
Dialogue: 0,0:07:48.58,0:07:51.00,Main,,0,0,0,,Hele şükür!
Dialogue: 0,0:07:49.95,0:07:52.17,Main,,0,0,0,,Iva-sama!
Dialogue: 0,0:07:52.96,0:07:54.50,Main,,0,0,0,,O ikisi!
Dialogue: 0,0:07:55.90,0:07:58.01,Main,,0,0,0,,Hasır Şapka! Bu Jinbei'den!
Dialogue: 0,0:08:00.83,0:08:01.89,Main,,0,0,0,,Bebek Den Den Mushi!
Dialogue: 0,0:08:03.95,0:08:06.03,Main,,0,0,0,,İyi iş çıkardınız!
Dialogue: 0,0:08:06.03,0:08:07.55,Main,,0,0,0,,Sen niye geldin ki?
Dialogue: 0,0:08:08.90,0:08:11.01,Main,,0,0,0,,Luffy-kun, başardın mı?
Dialogue: 0,0:08:11.01,0:08:13.56,Main,,0,0,0,,Geldim! Ama hâlâ peşimizde!
Dialogue: 0,0:08:13.56,0:08:16.63,Main,,0,0,0,,Çıkışa varınca gidecek yerimiz kalmayacak!
Dialogue: 0,0:08:16.63,0:08:22.11,Main,,0,0,0,,Kusura bakma. Gemi çaldık\Nama sizden çok uzaktayız!
Dialogue: 0,0:08:22.11,0:08:23.73,Main,,0,0,0,,Ama ilerlemeye devam edin!
Dialogue: 0,0:08:23.73,0:08:26.00,Main,,0,0,0,,Denize atlayın!
Dialogue: 0,0:08:26.00,0:08:28.51,Main,,0,0,0,,Herkes kendini okyanusa atsın!
Dialogue: 0,0:08:28.51,0:08:30.44,Main,,0,0,0,,Ne diyorsun, Jinbei?!
Dialogue: 0,0:08:30.44,0:08:32.04,Main,,0,0,0,,Sükûnet Kuşağı'nda olduğumuzu biliyorsun!
Dialogue: 0,0:08:32.04,0:08:35.12,Main,,0,0,0,,Gerisini ben halledebilirim!
Dialogue: 0,0:08:37.82,0:08:38.96,Main,,0,0,0,,Söylediğini yapın!
Dialogue: 0,0:08:38.96,0:08:39.61,Main,,0,0,0,,Ne{\fscx250}-{\r}?!
Dialogue: 0,0:08:39.61,0:08:41.49,Main,,0,0,0,,Üç! Bir kez daha bana yardım et!
Dialogue: 0,0:08:41.49,0:08:45.64,Main,,0,0,0,,Delirdin mi sen?! Okyanusa\Natlarsak kesinlikle öleceğiz!
Dialogue: 0,0:08:45.64,0:08:49.04,Main,,0,0,0,,O Hükümet için çalışıyor!\NGüvenimizi hak etmiyor!
Dialogue: 0,0:08:49.04,0:08:50.70,Main,,0,0,0,,Lanet olası Balık Adam!
Dialogue: 0,0:08:50.70,0:08:52.97,Main,,0,0,0,,O Ace'in arkadaşı!
Dialogue: 0,0:08:52.97,0:08:53.98,Main,,0,0,0,,Ona güveniyorum!
Dialogue: 0,0:08:59.19,0:09:01.88,Main,,0,0,0,,Denize mi? Yapabileceğinizi\Nsanıyorsanız kaçmaya çalışın bakalım!
Dialogue: 0,0:09:01.88,0:09:04.43,Main,,0,0,0,,Suya değdiğiniz anda Deniz\NKralları yuvasında olacaksınız!
Dialogue: 0,0:09:05.84,0:09:09.33,Main,,0,0,0,,Dikkatli olun! Zehrinin bir damlasının\Nbile size dokunmasına izin vermeyin!
Dialogue: 0,0:09:10.53,0:09:12.57,Main,,0,0,0,,Bu imkansız!
Dialogue: 0,0:09:11.54,0:09:13.25,Main,,0,0,0,,Her şey bitti!
Dialogue: 0,0:09:15.44,0:09:17.34,Main,,0,0,0,,{\fad(150,150)}Cehennem'in Hükmü!
Dialogue: 0,0:09:20.44,0:09:22.02,Main,,0,0,0,,{\fad(150,150)}Üçüncü Düzen!
Dialogue: 0,0:09:23.40,0:09:25.45,Main,,0,0,0,,Bu özel servis!
Dialogue: 0,0:09:25.45,0:09:28.32,Main,,0,0,0,,{\fad(150,150)}Mum Duvar!
Dialogue: 0,0:09:30.60,0:09:32.36,Main,,0,0,0,,Anlamsız!
Dialogue: 0,0:09:36.48,0:09:38.44,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:09:40.06,0:09:43.60,Main,,0,0,0,,{\fad(150,150)}...Dev Damga!
Dialogue: 0,0:10:02.84,0:10:05.63,Main,,0,0,0,,Onu geri püskürttü!
Dialogue: 0,0:10:19.16,0:10:21.24,Main,,0,0,0,,Zehir hâlâ bize doğru geliyor!
Dialogue: 0,0:10:21.24,0:10:23.79,Main,,0,0,0,,Denize atlamak tek umudumuz mu?!
Dialogue: 0,0:10:27.55,0:10:29.11,Main,,0,0,0,,İşte geliyor!
Dialogue: 0,0:10:29.11,0:10:31.87,Main,,0,0,0,,Iva-chan! Iva-chan, uyan!
Dialogue: 0,0:10:32.15,0:10:33.42,Main,,0,0,0,,Başımız dertte!
Dialogue: 0,0:10:33.42,0:10:35.99,Main,,0,0,0,,Iva-chan! Uyan!
Dialogue: 0,0:10:35.99,0:10:38.54,Main,,0,0,0,,Hey! Hemen uyan!
Dialogue: 0,0:10:38.54,0:10:39.89,Main,,0,0,0,,Hmm? Ne?
Dialogue: 0,0:10:39.89,0:10:41.39,Main,,0,0,0,,Acele etmeliyiz!
Dialogue: 0,0:10:41.39,0:10:43.89,Main,,0,0,0,,Sen kimsin? Hasır Şapkalı Çocuk'un oğlu mu?
Dialogue: 0,0:10:42.28,0:10:43.89,Secondary,,0,0,0,,Şu hareketini kullan!
Dialogue: 0,0:10:43.89,0:10:45.06,Main,,0,0,0,,Göz Kırpması!
Dialogue: 0,0:10:45.06,0:10:45.80,Main,,0,0,0,,Tamam o zaman.
Dialogue: 0,0:10:46.29,0:10:49.05,Main,,0,0,0,,Hey, ciddi olamazsın! Bunu yaparsak...
Dialogue: 0,0:10:49.39,0:10:50.43,Main,,0,0,0,,Başlıyorum!
Dialogue: 0,0:10:50.43,0:10:52.47,Main,,0,0,0,,Hey, dur biraz, Iva-sama!
Dialogue: 0,0:10:53.47,0:10:55.08,Main,,0,0,0,,Planınız anlamsız!
Dialogue: 0,0:10:55.08,0:10:59.18,Main,,0,0,0,,Gemi olmadan denize girerseniz\Nhiç umudunuz kalmaz!
Dialogue: 0,0:11:00.08,0:11:02.40,Main,,0,0,0,,Herkes onun yüzüne tutunsun!
Dialogue: 0,0:11:02.40,0:11:03.65,Main,,0,0,0,,Yüzüne mi?!
Dialogue: 0,0:11:03.65,0:11:05.82,Main,,0,0,0,,Kaçmanıza izin vermeyeceğim!
Dialogue: 0,0:11:08.14,0:11:09.32,Main,,0,0,0,,{\fad(150,150)}Cehennem...
Dialogue: 0,0:11:11.38,0:11:12.82,Main,,0,0,0,,{\fad(150,150)}...Göz Kırpışı!
Dialogue: 0,0:11:16.34,0:11:18.12,Main,,0,0,0,,Kaçamayacaksınız!
Dialogue: 0,0:11:32.58,0:11:36.25,Main,,0,0,0,,DÜŞÜYORUZ!
Dialogue: 0,0:11:38.48,0:11:40.10,Main,,0,0,0,,Gemilerin altında bir şey var!
Dialogue: 0,0:11:40.66,0:11:42.40,Main,,0,0,0,,Ne?!
Dialogue: 0,0:11:47.08,0:11:48.07,Main,,0,0,0,,Ne?
Dialogue: 0,0:11:48.98,0:11:51.27,Main,,0,0,0,,B-Bir şeyin üstüne indik!
Dialogue: 0,0:11:51.27,0:11:53.83,Main,,0,0,0,,Hey! Şuna bakın!
Dialogue: 0,0:11:53.83,0:11:55.45,Main,,0,0,0,,Bu da ne?!
Dialogue: 0,0:11:55.45,0:11:57.86,Main,,0,0,0,,Demek zamanında geldiniz.
Dialogue: 0,0:11:57.86,0:12:01.38,Main,,0,0,0,,Sizi böyle tehlikeli bir denize\Nçağırdığım için üzgünüm!
Dialogue: 0,0:12:25.13,0:12:27.20,Main,,0,0,0,,Bu bir balina köpekbalığı sürüsü!
Dialogue: 0,0:12:27.20,0:12:29.92,Main,,0,0,0,,Jinbei onları buraya çağırmış!
Dialogue: 0,0:12:33.22,0:12:34.86,Main,,0,0,0,,Müthiş!
Dialogue: 0,0:12:55.45,0:12:57.57,Main,,0,0,0,,O müthiş biri!
Dialogue: 0,0:13:12.46,0:13:14.20,Main,,0,0,0,,Müthiş!
Dialogue: 0,0:13:42.97,0:13:47.05,Main,,0,0,0,,Başardık! Sonunda savaş gemisine ulaştık!
Dialogue: 0,0:13:47.75,0:13:49.76,Main,,0,0,0,,Kaçmayı başardık!
Dialogue: 0,0:13:49.76,0:13:53.92,Main,,0,0,0,,Hayal görüyor gibiyim! Impel Down'dan\Nçıkabileceğimi hiç düşünmemiştim.
Dialogue: 0,0:13:54.29,0:13:56.38,Main,,0,0,0,,Henüz kutlayacak vaktimiz yok!
Dialogue: 0,0:13:56.38,0:13:58.09,Main,,0,0,0,,Hemen buradan çıkmalıyız!
Dialogue: 0,0:14:03.89,0:14:05.49,Main,,0,0,0,,Başardık!
Dialogue: 0,0:14:05.49,0:14:08.50,Main,,0,0,0,,Sağolun, balina köpekbalıkları!
Dialogue: 0,0:14:08.50,0:14:10.08,Main,,0,0,0,,Bizi kurtardınız!
Dialogue: 0,0:14:13.27,0:14:15.00,Main,,0,0,0,,Geri dönerken dikkatli olun!
Dialogue: 0,0:14:18.99,0:14:21.19,Main,,0,0,0,,Inazuma'yı zehirden kurtarmalıyız.
Dialogue: 0,0:14:21.19,0:14:23.36,Main,,0,0,0,,Revirde bulabileceğiniz tüm ilaçları getirin.
Dialogue: 0,0:14:23.36,0:14:24.26,Main,,0,0,0,,Tamam!
Dialogue: 0,0:14:27.66,0:14:31.21,Main,,0,0,0,,O Cehennem'e bir daha dönmeyeceğim!
Dialogue: 0,0:14:31.21,0:14:35.42,Main,,0,0,0,,Ben de! Yeni bir sayfa açıyorum!\NEve gidip ailemle olacağım!
Dialogue: 0,0:14:35.42,0:14:39.90,Main,,0,0,0,,ÖZGÜRÜZ!
Dialogue: 0,0:14:39.90,0:14:42.22,Main,,0,0,0,,Bunun için kime teşekkür etmeniz gerekiyor?
Dialogue: 0,0:14:43.04,0:14:43.80,Main,,0,0,0,,Söyleyin!
Dialogue: 0,0:14:43.80,0:14:45.56,Main,,0,0,0,,KAPTAN BUGGY!
Dialogue: 0,0:14:49.10,0:14:51.52,Main,,0,0,0,,Bu kadar ilerleyebileceklerini\Nhiç düşünmemiştim.
Dialogue: 0,0:14:51.52,0:14:54.43,Main,,0,0,0,,Denizciler, gemilerinizden\Nbirini buraya gönderin.
Dialogue: 0,0:14:54.43,0:14:57.16,Main,,0,0,0,,Sizinle gelip onları kendim haklayacağım.
Dialogue: 0,0:14:57.16,0:14:58.13,Main,,0,0,0,,Anlaşıldı.
Dialogue: 0,0:14:58.13,0:15:03.39,Main,,0,0,0,,Görünüşe göre tuzağa\Ndüştüklerini henüz fark etmediler.
Dialogue: 0,0:15:04.74,0:15:09.13,Main,,0,0,0,,Tuğamiral! Jinbei'nin etkisiz hale\Ngetirdiği topları tamir ettik.
Dialogue: 0,0:15:09.13,0:15:09.87,Main,,0,0,0,,Çok iyi.
Dialogue: 0,0:15:10.77,0:15:13.25,Main,,0,0,0,,Tüm gemiler ateş açsın!
Dialogue: 0,0:15:24.05,0:15:25.49,Main,,0,0,0,,Ateşe başladılar!
Dialogue: 0,0:15:26.60,0:15:27.90,Main,,0,0,0,,Bu gerçekten kötü!
Dialogue: 0,0:15:27.90,0:15:29.64,Main,,0,0,0,,Bunların kaç gemisi var?!
Dialogue: 0,0:15:32.01,0:15:34.08,Main,,0,0,0,,Tüm filo peşimizden geliyor!
Dialogue: 0,0:15:35.73,0:15:37.05,Main,,0,0,0,,Vurulduk!
Dialogue: 0,0:15:38.24,0:15:43.46,Main,,0,0,0,,Tüm koramiral ya da daha üst\Nrütbeliler Marineford'a çağırıldı...
Dialogue: 0,0:15:43.46,0:15:46.78,Main,,0,0,0,,...ama savaş gemisi savaş gemisidir.\Nİçinde kim olursa olsun zor olacak.
Dialogue: 0,0:15:53.16,0:15:55.41,Main,,0,0,0,,İşe yaramayacağını fark etmiyor musunuz?!
Dialogue: 0,0:15:55.41,0:15:57.12,Main,,0,0,0,,Sizin gibi pis korsanlar için...
Dialogue: 0,0:15:57.12,0:15:59.80,Main,,0,0,0,,...ADALETİN KAPILARI AÇILMAYACAK!
Dialogue: 0,0:16:07.77,0:16:10.22,Main,,0,0,0,,Sahi! Bunu unutmuştum!
Dialogue: 0,0:16:10.22,0:16:13.46,Main,,0,0,0,,Olamaz! Bu kapılar asla bizim için açılmaz!
Dialogue: 0,0:16:14.40,0:16:17.06,Main,,0,0,0,,Buraya kadar geldik ve çıkış yok mu?!
Dialogue: 0,0:16:17.06,0:16:19.27,Main,,0,0,0,,Beni taklit etme!
Dialogue: 0,0:16:19.79,0:16:21.44,Main,,0,0,0,,Ne yapacaksın, lanet olası köpekbalığı?!
Dialogue: 0,0:16:21.44,0:16:22.19,Main,,0,0,0,,Yarıp geçeceğiz!
Dialogue: 0,0:16:22.19,0:16:23.57,Main,,0,0,0,,İmkânsız!
Dialogue: 0,0:16:23.57,0:16:25.11,Main,,0,0,0,,Bu olası en kötü durum!
Dialogue: 0,0:16:25.11,0:16:28.54,Main,,0,0,0,,Nasıl bu kadar sakin olabilirsin?!
Dialogue: 0,0:16:38.91,0:16:42.56,Main,,0,0,0,,Önce gemiyi korumalıyız!\NBatmasına izin vermeyin!
Dialogue: 0,0:16:46.02,0:16:48.16,Main,,0,0,0,,Öylece durup saldırılarına\Nboyun mu eğeceksiniz?
Dialogue: 0,0:16:48.16,0:16:49.79,Main,,0,0,0,,Bu da savaş gemisi, unuttunuz mu?
Dialogue: 0,0:16:49.79,0:16:51.64,Main,,0,0,0,,Karşılık vermeyecek misiniz, \Ndeğersiz ahmaklar?!
Dialogue: 0,0:16:51.64,0:16:53.36,Main,,0,0,0,,Bu benim tavsiyem olacaktı!
Dialogue: 0,0:16:53.64,0:16:56.53,Main,,0,0,0,,Onlara karşılık verelim beyler!
Dialogue: 0,0:16:56.83,0:16:58.57,Main,,0,0,0,,ANLAŞILDI, KAPTAN BUGGY!
Dialogue: 0,0:17:07.70,0:17:09.38,Main,,0,0,0,,{\fad(150,150)}Kum Fırtınası!
Dialogue: 0,0:17:10.06,0:17:12.42,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no Balon!
Dialogue: 0,0:17:12.88,0:17:14.67,Main,,0,0,0,,Bunu nasıl buldunuz?!
Dialogue: 0,0:17:21.26,0:17:22.81,Main,,0,0,0,,Lanet olası mahkûmlar...
Dialogue: 0,0:17:22.81,0:17:27.14,Main,,0,0,0,,Tuzağa düştüklerini fark etmiş olmalılar, \Npeki niye hala Adaletin Kapıları'na gidiyorlar?
Dialogue: 0,0:17:27.14,0:17:31.21,Main,,0,0,0,,Kapılar yalnızca Impel Down'daki\Noperatörler tarafından açılabilir.
Dialogue: 0,0:17:31.21,0:17:33.71,Main,,0,0,0,,Onları açmanın başka yolu yok!
Dialogue: 0,0:17:39.21,0:17:42.39,Main,,0,0,0,,Ateş! Onları denizin dibine gönderin!
Dialogue: 0,0:17:45.36,0:17:49.03,Main,,0,0,0,,Adaletin Kapıları açılıyor!
Dialogue: 0,0:17:49.03,0:17:51.29,Main,,0,0,0,,Nasıl olur? Neler oluyor?!
Dialogue: 0,0:17:51.29,0:17:52.87,Main,,0,0,0,,Kapılar neden açılıyor?!
Dialogue: 0,0:17:55.78,0:17:58.62,Main,,0,0,0,,AÇILDI!
Dialogue: 0,0:18:01.25,0:18:03.99,Main,,0,0,0,,N-Nasıl olabilir?
Dialogue: 0,0:18:03.99,0:18:04.97,Main,,0,0,0,,Tuzak mı?!
Dialogue: 0,0:18:06.42,0:18:10.81,Main,,0,0,0,,Tamam! Niye bilmiyorum\Nama kapılar açılıyor!
Dialogue: 0,0:18:17.65,0:18:18.90,Main,,0,0,0,,Ne?!
Dialogue: 0,0:18:21.02,0:18:23.62,Main,,0,0,0,,Müdür Magellan! Hemen binin!
Dialogue: 0,0:18:24.16,0:18:25.70,Main,,0,0,0,,Hayır, durun!
Dialogue: 0,0:18:31.60,0:18:35.06,Main,,0,0,0,,İmkânsız! Kapılar neden açılıyor?!
Dialogue: 0,0:18:38.88,0:18:43.21,Main,,0,0,0,,Kapıları açmanın iyi fikir\Nolduğuna emin misiniz,...
Dialogue: 0,0:18:43.87,0:18:45.63,Main,,0,0,0,,...Müdür Magellan!
Dialogue: 0,0:18:45.63,0:18:49.24,Main,,0,0,0,,Evet, işe yarayacak. Emirlerimin\Nyanlış çıktığı oldu mu hiç?
Dialogue: 0,0:18:49.24,0:18:51.27,Main,,0,0,0,,Hayır, şüphe ettiğimden değil.
Dialogue: 0,0:18:52.62,0:18:56.42,Main,,0,0,0,,Onların gemisi çıkar çıkmaz\Nhemen kapıyı kapatın.
Dialogue: 0,0:18:56.42,0:18:57.35,Main,,0,0,0,,Anlaşıldı mı?
Dialogue: 0,0:18:57.80,0:18:59.06,Main,,0,0,0,,Emredersiniz efendim.
Dialogue: 0,0:19:03.94,0:19:05.06,Main,,0,0,0,,Kaçmalarına izin vermeyin!
Dialogue: 0,0:19:05.06,0:19:07.49,Main,,0,0,0,,Kaçmalarına izin vermek\Naffedilemez! Ateş!
Dialogue: 0,0:19:09.16,0:19:11.83,Main,,0,0,0,,Bunlar Magellan'ın emirleri mi?\NAklından ne geçiyor?
Dialogue: 0,0:19:12.98,0:19:14.99,Main,,0,0,0,,Bunu yaparak ne elde etmeye\Nçalıştığını anlamıyorum.
Dialogue: 0,0:19:14.99,0:19:16.50,Main,,0,0,0,,Müdür Magellan ne düşünüyor?!
Dialogue: 0,0:19:16.50,0:19:20.83,Main,,0,0,0,,Ah, şey, bunun müdür tarafından\Nyapıldığını sanmıyorum.
Dialogue: 0,0:19:20.83,0:19:24.92,Main,,0,0,0,,Kendisi ana girişteki köprüde duruyordu.
Dialogue: 0,0:19:27.66,0:19:30.76,Thoughts,,0,0,0,,Niye? Neler oluyor?!
Dialogue: 0,0:19:32.86,0:19:35.61,Main,,0,0,0,,Kontrol Odası! Ne yapıyorsunuz?!
Dialogue: 0,0:19:35.61,0:19:38.60,Main,,0,0,0,,Adaletin Kapıları'nı açmanızı kim söyledi?!
Dialogue: 0,0:19:38.60,0:19:40.60,Main,,0,0,0,,M-Müdür?!
Dialogue: 0,0:19:43.31,0:19:44.82,Main,,0,0,0,,Ah.
Dialogue: 0,0:19:53.38,0:19:55.25,Main,,0,0,0,,Bu gerçekten doğru mu?
Dialogue: 0,0:19:56.82,0:19:58.26,Main,,0,0,0,,Bon-chan...?
Dialogue: 0,0:20:00.62,0:20:02.38,Main,,0,0,0,,Sen!
Dialogue: 0,0:20:02.38,0:20:04.21,Main,,0,0,0,,Evet!
Dialogue: 0,0:20:05.30,0:20:07.48,Main,,0,0,0,,Benim!
Dialogue: 0,0:20:09.76,0:20:12.35,Main,,0,0,0,,Sizi yine kandırdım!
Dialogue: 0,0:20:12.35,0:20:13.68,Main,,0,0,0,,Sahte miydi?!
Dialogue: 0,0:20:21.25,0:20:23.67,Main,,0,0,0,,Bakın! Kapılar kapanıyor!
Dialogue: 0,0:20:23.67,0:20:24.83,Main,,0,0,0,,Kapanıyor!
Dialogue: 0,0:20:24.83,0:20:28.89,Main,,0,0,0,,Eğer geçebilirsek Donanma\Ndiğer tarafta sıkışıp kalacak!
Dialogue: 0,0:20:28.89,0:20:31.46,Main,,0,0,0,,Çıkışta yanımızdaydı!
Dialogue: 0,0:20:31.82,0:20:34.54,Main,,0,0,0,,Iva-chan ve diğerleriyle\Nkarşılaşmamızın ve buradan...
Dialogue: 0,0:20:34.54,0:20:36.69,Main,,0,0,0,,...kaçmamızın tek sebebi\NBon-chan bizimle olduğu içindi!
Dialogue: 0,0:20:36.69,0:20:39.30,Main,,0,0,0,,Onsuz gitmemiz gerektiğini mi söylüyorsun?!
Dialogue: 0,0:20:39.67,0:20:41.05,Main,,0,0,0,,Kaybedecek zaman yok.
Dialogue: 0,0:20:41.05,0:20:43.06,Main,,0,0,0,,Onu terk mi edeceğiz?!
Dialogue: 0,0:20:43.06,0:20:49.40,Main,,0,0,0,,Zaten yol boyunca sayısız\Nkişiyi terk ettik!
Dialogue: 0,0:20:49.40,0:20:52.01,Main,,0,0,0,,Oraya dönüp tekrar Magellan\Nile tekrar dövüşmek niyetinde misin?
Dialogue: 0,0:20:52.01,0:20:53.92,Main,,0,0,0,,O zaman daha fazla kurban olacak!
Dialogue: 0,0:20:53.92,0:20:55.35,Main,,0,0,0,,Hem de daha fazla vakit kaybederiz!
Dialogue: 0,0:20:55.35,0:20:59.48,Main,,0,0,0,,Biri geride kalmasaydı kapılar\Nbizim için asla açılmazdı!
Dialogue: 0,0:21:03.26,0:21:06.14,Flashbacks,,0,0,0,,Bu işin üstesinden en\Niyi gelebilecek kişi benim.
Dialogue: 0,0:21:06.14,0:21:08.50,Flashbacks,,0,0,0,,Adaletin Kapıları'nı açacağım!
Dialogue: 0,0:21:11.40,0:21:14.84,Flashbacks,,0,0,0,,Sonra ne yapmak niyetindesin?
Dialogue: 0,0:21:15.09,0:21:17.67,Flashbacks,,0,0,0,,Söyleseydim o kadar\Nhavalı olmazdı, değil mi?
Dialogue: 0,0:21:19.58,0:21:23.26,Flashbacks,,0,0,0,,Ayrılmadan önce sakın\NHasır-chan'a bir şey deme!
Dialogue: 0,0:21:24.78,0:21:28.48,Flashbacks,,0,0,0,,Bir Okama'nın vedası için söze gerek yok.
Dialogue: 0,0:21:33.79,0:21:35.69,Main,,0,0,0,,Hâlâ bağlı.
Dialogue: 0,0:21:38.19,0:21:41.07,Main,,0,0,0,,Bebek Den Den Mushi'nin\Nçok kısa menzili vardır.
Dialogue: 0,0:21:41.07,0:21:44.81,Main,,0,0,0,,Kapılar kapanır kapanmaz\Nonunla bağlantıyı yitireceğiz.
Dialogue: 0,0:21:50.18,0:21:52.33,Main,,0,0,0,,Müdüre dönüşmeye nasıl cüret edersin?!
Dialogue: 0,0:21:52.33,0:21:55.46,Main,,0,0,0,,O sırada yüzünü kaydetmem iyi olmuş!
Dialogue: 0,0:21:56.75,0:21:58.57,Flashbacks,,0,0,0,,Aç gözlerini, Hannyabal!
Dialogue: 0,0:21:58.57,0:22:00.59,Flashbacks,,0,0,0,,Ne oldu burada?!
Dialogue: 0,0:22:01.65,0:22:04.47,Flashbacks,,0,0,0,,M-Müdür Bey! Bırakın beni!
Dialogue: 0,0:22:04.47,0:22:05.42,Thoughts,,0,0,0,,Dokun.
Dialogue: 0,0:22:07.09,0:22:08.81,Main,,0,0,0,,Bu ne cüret?!
Dialogue: 0,0:22:09.76,0:22:11.10,Main,,0,0,0,,Bon-chan!
Dialogue: 0,0:22:11.72,0:22:13.20,Thoughts,,0,0,0,,Hasır-chan?!
Dialogue: 0,0:22:13.72,0:22:16.27,Main,,0,0,0,,Hey! Beni duyabiliyor musun? Bon-chan?!
Dialogue: 0,0:22:16.87,0:22:19.51,Main,,0,0,0,,Geçen sefer yaptığın gibi...
Dialogue: 0,0:22:20.64,0:22:22.37,Main,,0,0,0,,...neden bunu tekrar yapıyorsun?
Dialogue: 0,0:22:22.37,0:22:27.79,Thoughts,,0,0,0,,Jinbei! Bağlantıyı yitirmeden önce ona\Nsöylemeyeceğine dair söz vermemiş miydin?!
Dialogue: 0,0:22:29.47,0:22:32.33,Main,,0,0,0,,Birlikte kaçmayacak mıydık?!
Dialogue: 0,0:22:33.02,0:22:36.04,Main,,0,0,0,,Beni tekrar tekrar kurtarıp duruyorsun!
Dialogue: 0,0:22:39.21,0:22:42.48,Main,,0,0,0,,Oradaysan cevap ver, Bon-chan!
Dialogue: 0,0:22:42.48,0:22:44.35,Main,,0,0,0,,Demek öyle...
Dialogue: 0,0:22:44.35,0:22:46.28,Main,,0,0,0,,Şu Okama...
Dialogue: 0,0:22:46.28,0:22:48.60,Main,,0,0,0,,...bizim için tek başına geride mi kalmış?
Dialogue: 0,0:22:48.60,0:22:50.10,Main,,0,0,0,,Bon-chan!
Dialogue: 0,0:22:50.10,0:22:52.53,Main,,0,0,0,,Bize cevap ver, Bon Kardeş!
Dialogue: 0,0:22:52.53,0:22:54.77,Main,,0,0,0,,Niye cevap vermiyorsun?!
Dialogue: 0,0:22:55.18,0:22:56.83,Main,,0,0,0,,Bon-chan!
Dialogue: 0,0:23:01.40,0:23:03.61,Main,,0,0,0,,Bay 2!
Dialogue: 0,0:23:03.61,0:23:06.84,Main,,0,0,0,,Bay 2, sen...
Dialogue: 0,0:23:06.84,0:23:09.29,Main,,0,0,0,,Her şey için üzgünüm!
Dialogue: 0,0:23:11.75,0:23:12.94,Main,,0,0,0,,Bon-çocuk!
Dialogue: 0,0:23:12.94,0:23:14.83,Main,,0,0,0,,Ateş!
Dialogue: 0,0:23:14.83,0:23:16.86,Main,,0,0,0,,Kaçmalarına izin vermeyin!
Dialogue: 0,0:23:16.86,0:23:18.49,Main,,0,0,0,,Parçalayın onları!
Dialogue: 0,0:23:18.49,0:23:19.85,Main,,0,0,0,,Bon-chan!
Dialogue: 0,0:23:20.95,0:23:23.04,Main,,0,0,0,,BON-CHAN!
Dialogue: 0,0:23:24.82,0:23:28.26,Main,,0,0,0,,Bon-chan... Kapılar kapanıyor.
Dialogue: 0,0:23:32.18,0:23:34.71,Main,,0,0,0,,Gidiyoruz.
Dialogue: 0,0:23:41.93,0:23:43.90,Main,,0,0,0,,Sağol!
Dialogue: 0,0:23:53.45,0:23:56.94,Main,,0,0,0,,Bon Kardeş! Sağol!
Dialogue: 0,0:23:56.94,0:24:00.29,Main,,0,0,0,,Sağol!
Dialogue: 0,0:24:05.13,0:24:08.96,Main,,0,0,0,,Hasır-chan!
Dialogue: 0,0:24:08.03,0:24:08.96,Main,,0,0,0,,Bon-chan!
Dialogue: 0,0:24:08.96,0:24:09.72,Main,,0,0,0,,Hasır-chan...
Dialogue: 0,0:24:11.20,0:24:14.31,Main,,0,0,0,,Ne olursa olsun kardeşini kurtarmalısın!
Dialogue: 0,0:24:19.87,0:24:22.89,Main,,0,0,0,,Eminim abini...
Dialogue: 0,0:24:22.89,0:24:25.46,Main,,0,0,0,,...kurtarabilirsin!
Dialogue: 0,0:24:25.46,0:24:28.16,Main,,0,0,0,,Bon-chan!
Dialogue: 0,0:24:29.06,0:24:31.12,Main,,0,0,0,,Kapılar kapanıyor!
Dialogue: 0,0:24:31.12,0:24:32.95,Main,,0,0,0,,Batırın onları!
Dialogue: 0,0:24:40.09,0:24:41.75,Flashbacks,,0,0,0,,Görüşmeyeli uzun zaman oldu!
Dialogue: 0,0:24:42.91,0:24:45.13,Flashbacks,,0,0,0,,Tamamen iyiyim!
Dialogue: 0,0:24:46.03,0:24:48.59,Flashbacks,,0,0,0,,Şakayı bırak!
Dialogue: 0,0:24:53.13,0:24:56.64,Flashbacks,,0,0,0,,Hasır-chan! Seni kurtarmaya geldim!
Dialogue: 0,0:24:59.69,0:25:03.15,Flashbacks,,0,0,0,,Arkadaşlığımız adına!
Dialogue: 0,0:25:05.07,0:25:09.14,Flashbacks,,0,0,0,,Dayan, Hasır-chan!
Dialogue: 0,0:25:09.14,0:25:11.37,Flashbacks,,0,0,0,,Dayan!
Dialogue: 0,0:25:13.48,0:25:18.21,Flashbacks,,0,0,0,,Bir Okama'nın vedası için söze gerek yok.
Dialogue: 0,0:25:20.54,0:25:23.40,Main,,0,0,0,,Bon-chan!
Dialogue: 0,0:25:29.68,0:25:31.43,Main,,0,0,0,,Bu nasıl olabilir?
Dialogue: 0,0:25:31.90,0:25:34.09,Main,,0,0,0,,Kaçtılar!
Dialogue: 0,0:25:34.63,0:25:41.52,Main,,0,0,0,,O olmasaydı şimdiye dek\Nokyanusun dibini boylamıştık!
Dialogue: 0,0:25:42.36,0:25:49.11,Thoughts,,0,0,0,,Cehennem'de bile açan\Nbir arkadaşlık çiçeği var.
Dialogue: 0,0:25:49.11,0:25:52.45,Thoughts,,0,0,0,,Dalgaların üzerinde\Nileri geri sallanıyor...
Dialogue: 0,0:25:52.82,0:25:57.08,Thoughts,,0,0,0,,...ve geride hatıra olarak\Ntek bir yaprak bırakıyor.
Dialogue: 0,0:25:57.55,0:26:01.33,Thoughts,,0,0,0,,Bir gün mutlaka çiçek açacak.
Dialogue: 0,0:26:01.33,0:26:03.96,Thoughts,,0,0,0,,Okama Yolu!
Dialogue: 0,0:26:05.85,0:26:07.31,Main,,0,0,0,,Bon-chan!
Dialogue: 0,0:26:07.31,0:26:09.90,Main,,0,0,0,,Bon Kardeş!
Dialogue: 0,0:26:09.90,0:26:11.79,Main,,0,0,0,,Bon-çocuk!
Dialogue: 0,0:26:11.79,0:26:13.51,Main,,0,0,0,,Bay 2!
Dialogue: 0,0:26:21.46,0:26:23.81,Main,,0,0,0,,Son bir sözün var mı?!
Dialogue: 0,0:26:24.58,0:26:26.27,Main,,0,0,0,,Memnuniyet!
Dialogue: 0,0:26:27.57,0:26:31.29,Thoughts,,0,0,0,,Okama arazisinde yeniden buluşalım.
Dialogue: 0,0:26:33.92,0:26:42.40,Main,,0,0,0,,{\i1}Dünyanın en korkulan hapishanesi \NImpel Down'dan o gün kaçan mahkûmların sayısı...{\i0}
Dialogue: 0,0:26:42.40,0:26:44.86,Main,,0,0,0,,{\i1}...241'di.{\i0}
Dialogue: 0,0:26:45.24,0:26:48.39,Main,,0,0,0,,{\i1}Bu, Impel Down'ın tüm tarihi\Nboyunca yaşadığı en büyük utançtı...{\i0}
Dialogue: 0,0:26:48.39,0:26:51.33,Main,,0,0,0,,{\i1}...ancak bu olay hâlâ bitmedi.{\i0}
Dialogue: 0,0:26:52.76,0:26:56.83,Main,,0,0,0,,{\i1}Portgas D. Ace'in idamı için kalan süre...{\i0}
Dialogue: 0,0:26:56.83,0:26:59.20,Main,,0,0,0,,{\i1}...4 saat.{\i0}
