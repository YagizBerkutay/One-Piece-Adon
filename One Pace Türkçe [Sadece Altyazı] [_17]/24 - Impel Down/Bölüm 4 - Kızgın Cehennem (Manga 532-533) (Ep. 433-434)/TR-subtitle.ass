Dialogue: 0,0:00:16.99,0:00:22.41,Main,,0,0,0,,Hasır Şapkalı Luffy'ye yardım ettiğinden\Nşüphelendiğimiz mahkumlar şu şekilde:..
Dialogue: 0,0:00:23.86,0:00:27.04,Main,,0,0,0,,Mahkum numarası E 8200,...
Dialogue: 0,0:00:27.04,0:00:29.01,Main,,0,0,0,,...korsan Palyaço Buggy.
Dialogue: 0,0:00:30.57,0:00:33.61,Main,,0,0,0,,Mahkum numarası D 0464,...
Dialogue: 0,0:00:33.61,0:00:35.48,Main,,0,0,0,,...eski Baroque Works ajanı...
Dialogue: 0,0:00:35.48,0:00:38.80,Main,,0,0,0,,...Bay 3 lakaplı Galdino.
Dialogue: 0,0:00:40.29,0:00:42.99,Main,,0,0,0,,Mahkum Numarası C 9915,...
Dialogue: 0,0:00:42.99,0:00:45.47,Main,,0,0,0,,...eski bir Baroque Works ajanı daha...
Dialogue: 0,0:00:45.47,0:00:48.77,Main,,0,0,0,,...Bay 2 Bon Kurei lakaplı Bentham.
Dialogue: 0,0:00:49.43,0:00:54.34,Main,,0,0,0,,Şu anda Hasır Şapkalı Luffy ve Bay 2 Bon Kurei,\NSeviye 3'teki N-Sektörü'nde karışıklık çıkarıyor.
Dialogue: 0,0:00:54.34,0:00:56.53,Main,,0,0,0,,Blugoriler onlarla başa çıkamıyor!
Dialogue: 0,0:01:06.26,0:01:09.63,Main,,0,0,0,,Görünüşe göre ikisi Seviye 4'e\Ninen merdivenlere gidiyor.
Dialogue: 0,0:01:10.53,0:01:17.61,Main,,0,0,0,,{\i1}Ancak henüz korsan Palyaço Buggy'nin ve\NBay 3 Galdino'nun yerini tespit edemedik.{\i0}
Dialogue: 0,0:01:17.61,0:01:19.76,Main,,0,0,0,,Seviye 2'de isyan var...
Dialogue: 0,0:01:19.76,0:01:21.92,Main,,0,0,0,,...ve izinsiz giriş yapanlar tüm\Nhapishanede taşkınlık çıkarıyor.
Dialogue: 0,0:01:23.16,0:01:25.80,Main,,0,0,0,,Buralarda işler epey ilginçleşti.
Dialogue: 0,0:01:25.80,0:01:28.27,Main,,0,0,0,,Biraz vakit öldürmek için müthiş bir yol.
Dialogue: 0,0:01:28.27,0:01:31.23,Main,,0,0,0,,Yakalanınca onlar için\Nher şey bitmiş olacak zaten.
Dialogue: 0,0:01:31.23,0:01:33.05,Main,,0,0,0,,Saldeath'e ne oldu?
Dialogue: 0,0:01:33.05,0:01:37.52,Main,,0,0,0,,Blugoriler, Hasır Şapkalı Luffy ve\NBay 2'yi durduramadı, bu yüzden...
Dialogue: 0,0:01:37.52,0:01:39.94,Main,,0,0,0,,...Seviye 2'deki isyanı bastırmaya gitti.
Dialogue: 0,0:01:47.86,0:01:51.77,Main,,0,0,0,,Niye bu kadar kötüleşmeden kimse\Ndurumu bana haber vermedi?!
Dialogue: 0,0:01:51.77,0:01:55.88,Main,,0,0,0,,Kafan Hancock-dono'yla o kadar doluydu ki,\Nraporları duymazdan geldin, unuttun mu?
Dialogue: 0,0:01:55.88,0:01:58.08,Main,,0,0,0,,Raporları görmezden\Ngeldiğimi mi söylüyorsun?!
Dialogue: 0,0:02:03.47,0:02:06.03,Main,,0,0,0,,Misafirler gitti mi, Müdür Bey?
Dialogue: 0,0:02:06.03,0:02:07.74,Main,,0,0,0,,Oh, Sadi-chan.
Dialogue: 0,0:02:08.00,0:02:10.49,Main,,0,0,0,,Gardiyana selam verin!
Dialogue: 0,0:02:11.26,0:02:15.01,Main,,0,0,0,,Av hazırlıklarını tamamladık.
Dialogue: 0,0:02:15.86,0:02:17.08,Main,,0,0,0,,Ne yapalım?
Dialogue: 0,0:02:25.65,0:02:29.57,Main,,0,0,0,,Mükemmel zamanlama.\NSeviye 3'te kimse var mı?
Dialogue: 0,0:02:29.57,0:02:31.62,Main,,0,0,0,,Minotor...
Dialogue: 0,0:02:32.18,0:02:33.23,Main,,0,0,0,,...oraya gitti.
Dialogue: 0,0:02:39.97,0:02:43.88,Main,,0,0,0,,Anlıyorum. Ama Seviye 3'ten\Nbir çıkış yolu var.
Dialogue: 0,0:02:43.88,0:02:46.39,Main,,0,0,0,,Sanırım peşlerine düşemeyecek.
Dialogue: 0,0:02:46.39,0:02:49.39,Main,,0,0,0,,Seviye 2'deki arbedeyi\NSaldeath'e bırakıyorum.
Dialogue: 0,0:02:49.95,0:02:53.77,Main,,0,0,0,,Geriye kalan tüm Impel Down\Npersonelini Seviye 4'e gönderin!
Dialogue: 0,0:02:53.77,0:02:55.27,Main,,0,0,0,,Anlaşıldı efendim!
Dialogue: 0,0:02:56.27,0:02:59.60,Main,,0,0,0,,Minotor'dan kaçmayı\Nbaşarıp buraya düşerlerse...
Dialogue: 0,0:02:59.60,0:03:04.37,Main,,0,0,0,,...Yanan Cehennem'de\Nişlerini şahsen bitireceğim!
Dialogue: 0,0:03:05.58,0:03:09.75,Main,,0,0,0,,Büyük Hapishane\NImpel Down'ı hafife aldılar!
Dialogue: 0,0:03:23.96,0:03:27.90,Main,,0,0,0,,B-Bu şeyin nesi var? Gerçekten hızlı!
Dialogue: 0,0:03:27.90,0:03:30.05,Main,,0,0,0,,Minotor!
Dialogue: 0,0:03:30.05,0:03:31.87,Main,,0,0,0,,Minotor?
Dialogue: 0,0:03:34.20,0:03:36.90,Main,,0,0,0,,Soğukkanlı Şeytan Muhafız!
Dialogue: 0,0:03:36.90,0:03:40.06,Main,,0,0,0,,İnsanları çöp gibi atan bir canavar!
Dialogue: 0,0:03:44.14,0:03:46.07,Main,,0,0,0,,İşte bu o!
Dialogue: 0,0:03:46.07,0:03:50.09,Captions,,0,0,220,,{\fad(600,0)}Canavar Gardiyan
Dialogue: 0,0:03:46.08,0:03:50.09,Captions,,0,0,35,,{\fad(600,0)}Minotor
Dialogue: 0,0:03:47.66,0:03:50.09,Main,,0,0,0,,{\an8}Canavar? Şeytan Meyvesi kullanıcısı?
Dialogue: 0,0:03:55.91,0:03:57.83,Main,,0,0,0,,Bon-chan!
Dialogue: 0,0:03:58.57,0:04:00.00,Main,,0,0,0,,Acıyor!
Dialogue: 0,0:04:00.41,0:04:01.54,Main,,0,0,0,,O şey çok hızlı!
Dialogue: 0,0:04:10.89,0:04:12.54,Main,,0,0,0,,Hasır-chan, dikkat et!
Dialogue: 0,0:04:13.21,0:04:15.32,Main,,0,0,0,,{\fad(150,150)}Terbiyecinin Kamçısı!
Dialogue: 0,0:04:31.10,0:04:33.09,Main,,0,0,0,,Ölüyorum...
Dialogue: 0,0:04:35.22,0:04:37.28,Main,,0,0,0,,{\fad(150,150)}İkinci Vites!
Dialogue: 0,0:04:38.10,0:04:40.32,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:04:41.14,0:04:42.44,Main,,0,0,0,,{\fad(150,150)}...Jet...
Dialogue: 0,0:04:43.73,0:04:46.96,Main,,0,0,0,,{\fad(150,150)}...Bazuka!
Dialogue: 0,0:05:14.27,0:05:16.36,Main,,0,0,0,,İyi misin, Bon-chan?
Dialogue: 0,0:05:16.36,0:05:19.58,Main,,0,0,0,,Ö-Ölüyorum sandım.
Dialogue: 0,0:05:19.58,0:05:22.84,Main,,0,0,0,,Gözlerimin önünde bir Okama tarlası gördüm.
Dialogue: 0,0:05:27.78,0:05:30.79,Main,,0,0,0,,Gerçekten güçlüsün.
Dialogue: 0,0:05:32.97,0:05:37.36,Main,,0,0,0,,O canavarın hâlâ hayatta olduğundan\Neminim ama yaralanmış olmalı.
Dialogue: 0,0:05:37.36,0:05:39.40,Main,,0,0,0,,Ha? Ne?!
Dialogue: 0,0:05:40.26,0:05:41.86,Main,,0,0,0,,Çok kızgınım! Bu berbat!
Dialogue: 0,0:05:41.86,0:05:43.95,Main,,0,0,0,,Makyajım bozulmuş!
Dialogue: 0,0:05:43.95,0:05:46.33,Main,,0,0,0,,Makyaj malzemesi, makyaj malzemesi!\NMakyaj malzemesine ihtiyacım var!
Dialogue: 0,0:05:46.33,0:05:48.72,Main,,0,0,0,,O ve ayakkabılarım, kıyafetlerim, silahlarım ve...
Dialogue: 0,0:05:49.82,0:05:52.71,Main,,0,0,0,,...içkim, gözyaşlarım ve Okama Yolu!
Dialogue: 0,0:05:52.71,0:05:56.61,Main,,0,0,0,,Buradan aşağı inmek istiyorum.\NSusadım ve acıktım!
Dialogue: 0,0:05:56.61,0:05:59.31,Main,,0,0,0,,Endişelenmeye gerek yok, Hasır-chan!
Dialogue: 0,0:05:59.31,0:06:04.15,Main,,0,0,0,,Seviye 3'ten Seviye 4'e\Ninmek kusmak kadar kolay!
Dialogue: 0,0:06:04.65,0:06:05.81,Main,,0,0,0,,Gerçekten mi?!
Dialogue: 0,0:06:05.81,0:06:09.41,Main,,0,0,0,,Evet! Çok, çok kolay! Çok fazla kolay!
Dialogue: 0,0:06:09.41,0:06:11.46,Main,,0,0,0,,İşte orada, Hasır-chan.
Dialogue: 0,0:06:12.45,0:06:15.51,Main,,0,0,0,,Sadece oradaki büyük duvara tırman.
Dialogue: 0,0:06:15.51,0:06:17.43,Main,,0,0,0,,Duvar? Orayı mı kastediyorsun?
Dialogue: 0,0:06:17.43,0:06:18.61,Main,,0,0,0,,Evet.
Dialogue: 0,0:06:18.61,0:06:20.99,Main,,0,0,0,,Ama fazla heyecana kapılıp üstünden atlama.
Dialogue: 0,0:06:20.99,0:06:22.29,Main,,0,0,0,,Tamam!
Dialogue: 0,0:06:24.19,0:06:26.55,Main,,0,0,0,,Sıcak, sıcak, sıcak, SICAK!
Dialogue: 0,0:06:27.42,0:06:28.89,Main,,0,0,0,,O duvarın nesi var?
Dialogue: 0,0:06:28.89,0:06:30.66,Main,,0,0,0,,Bir tava kadar sıcak!
Dialogue: 0,0:06:30.66,0:06:34.32,Main,,0,0,0,,Tava, ha? Aynen öyle, Hasır-chan!
Dialogue: 0,0:06:34.32,0:06:35.37,Main,,0,0,0,,Peki iyi misin?
Dialogue: 0,0:06:35.37,0:06:36.95,Main,,0,0,0,,Hazır...
Dialogue: 0,0:06:40.77,0:06:42.02,Main,,0,0,0,,Sıcak!
Dialogue: 0,0:06:45.23,0:06:48.41,Main,,0,0,0,,Şuna bak, Hasır-chan? Aşağıya bak.
Dialogue: 0,0:07:03.87,0:07:05.33,Main,,0,0,0,,Burası da ne böyle?
Dialogue: 0,0:07:05.33,0:07:07.32,Main,,0,0,0,,Çok fazla sıcak hava ve duman var!
Dialogue: 0,0:07:07.32,0:07:09.35,Main,,0,0,0,,Dayanılmayacak kadar sıcak!
Dialogue: 0,0:07:09.35,0:07:10.49,Main,,0,0,0,,Değil mi?
Dialogue: 0,0:07:10.49,0:07:17.11,Main,,0,0,0,,Ancak altımızdaki yer, kesinlikle gitmek\Nistediğin yer: Seviye 4, Yanan Cehennem!
Dialogue: 0,0:07:17.54,0:07:20.61,Main,,0,0,0,,Yanan Cehennem. Buranın altında mı?
Dialogue: 0,0:07:20.61,0:07:23.83,Main,,0,0,0,,Evet. Demin de dediğin gibi,...
Dialogue: 0,0:07:23.83,0:07:26.62,Main,,0,0,0,,...Seviye 4 dev bir tavadır.
Dialogue: 0,0:07:27.23,0:07:32.63,Main,,0,0,0,,Aşağıda seni bekleyen şey,\Nkaynayan kan ve ateş denizi.
Dialogue: 0,0:07:33.19,0:07:35.82,Main,,0,0,0,,İstersen aşağıya atlamayı deneyebilirsin...
Dialogue: 0,0:07:35.82,0:07:38.66,Main,,0,0,0,,...ama inerken dikkatli olmazsan\Nsadece bir yanık ile kurtulamazsın.
Dialogue: 0,0:07:39.07,0:07:42.14,Main,,0,0,0,,Bu noktadan sonra attığın her\Nadım hayatını riske atmaktır.
Dialogue: 0,0:07:47.19,0:07:48.66,Main,,0,0,0,,Bon-chan,...
Dialogue: 0,0:07:49.14,0:07:52.69,Main,,0,0,0,,...görmek istediğin biri olduğunu\Nsöylemiştin, değil mi?
Dialogue: 0,0:07:52.69,0:07:55.80,Main,,0,0,0,,Görmek için hayatını riske attığın\Nbu kişinin kim olduğunu bilmek istiyorum.
Dialogue: 0,0:07:57.76,0:08:00.80,Main,,0,0,0,,İnsanlar ona "Mucize Adam" der.
Dialogue: 0,0:08:00.80,0:08:04.92,Main,,0,0,0,,Yapmadığı bir suçtan ötürü\Nhapsedildi, Iva-san olarak bilinir!
Dialogue: 0,0:08:05.95,0:08:10.30,Main,,0,0,0,,Grand Line olan Momoiro Adası'ndaki\NKamabakka Kraliçeliği Kraliçesi!
Dialogue: 0,0:08:10.80,0:08:15.39,Main,,0,0,0,,Dünyadaki tüm okamaların\Nhayran olduğu büyük Okama Kraliçesi!
Dialogue: 0,0:08:16.71,0:08:18.14,Main,,0,0,0,,Okama Kraliçesi?
Dialogue: 0,0:08:18.14,0:08:20.94,Main,,0,0,0,,Okamaların kraliçesi mi var? Müthiş!
Dialogue: 0,0:08:20.94,0:08:22.64,Main,,0,0,0,,Evet!
Dialogue: 0,0:08:22.64,0:08:24.86,Main,,0,0,0,,Onunla tanışmak istiyorum!
Dialogue: 0,0:08:24.86,0:08:27.36,Main,,0,0,0,,Yapabilirsem onu kurtarmak istiyorum!
Dialogue: 0,0:08:44.79,0:08:48.59,Main,,0,0,0,,Hey! Tam da keyfimiz yerindeyken\No şeyi buraya mı geri getirdiniz?!
Dialogue: 0,0:08:50.20,0:08:53.57,Main,,0,0,0,,Kaçmaya çalıştığınızı sanıyordum!
Dialogue: 0,0:08:53.57,0:08:55.35,Main,,0,0,0,,HASIR ŞAPKA!
Dialogue: 0,0:08:55.35,0:08:57.57,Main,,0,0,0,,Demek gelmek istiyorsunuz, öyle mi?
Dialogue: 0,0:08:57.57,0:08:59.69,Main,,0,0,0,,Kim Cehennem'e gitmek ister ki?!
Dialogue: 0,0:09:02.06,0:09:05.44,Main,,0,0,0,,Saklanıyorduk ve bu şey uçarak bize geldi!
Dialogue: 0,0:09:05.44,0:09:07.79,Main,,0,0,0,,Ama niye bilmiyorum.
Dialogue: 0,0:09:07.79,0:09:09.16,Main,,0,0,0,,Ah, onu size doğru ben uçurdum.
Dialogue: 0,0:09:09.16,0:09:11.07,Main,,0,0,0,,Oh, demek sendin. DUR BİRAZ!
Dialogue: 0,0:09:11.79,0:09:13.57,Main,,0,0,0,,Bıktım bu işlerden...
Dialogue: 0,0:09:14.10,0:09:18.58,Main,,0,0,0,,Yakalanmayı tercih ederdim...
Dialogue: 0,0:09:18.58,0:09:23.31,Main,,0,0,0,,Minotor, seni kahrolası canavar.
Dialogue: 0,0:09:23.31,0:09:25.97,Main,,0,0,0,,Burada hayatım söz konusu.
Dialogue: 0,0:09:25.97,0:09:29.07,Main,,0,0,0,,Kozumu kullanmaktan başka çarem yok!
Dialogue: 0,0:09:29.72,0:09:31.23,Main,,0,0,0,,Hey, Hasır Şapka!
Dialogue: 0,0:09:31.23,0:09:34.41,Main,,0,0,0,,Süper güçlü silahımı hatırlıyor musun?
Dialogue: 0,0:09:34.41,0:09:39.13,Main,,0,0,0,,Kalbinize korku salmak için\Nkullandığım Özel Buggy Topu'nu?
Dialogue: 0,0:09:39.13,0:09:39.82,Main,,0,0,0,,Hayır.
Dialogue: 0,0:09:45.61,0:09:50.55,Main,,0,0,0,,"Hayır?" Bu nasıl olabilir?
Dialogue: 0,0:09:50.55,0:09:55.70,Main,,0,0,0,,Buggy topu adında gerçekten\Nçok güçlü bir güllem var.
Dialogue: 0,0:09:55.70,0:09:59.18,Main,,0,0,0,,En sevdiğim silahım gibiydi...
Dialogue: 0,0:09:59.18,0:10:01.12,Main,,0,0,0,,Buggy Topu...
Dialogue: 0,0:10:01.12,0:10:03.45,Main,,0,0,0,,Kendi adını verdiysen...
Dialogue: 0,0:10:03.45,0:10:07.33,Main,,0,0,0,,...Buggy topuna çok fazla\Ngüveniyorsun demektir, değil mi?
Dialogue: 0,0:10:07.69,0:10:08.76,Main,,0,0,0,,Aynen!
Dialogue: 0,0:10:08.76,0:10:13.85,Main,,0,0,0,,Aynı güçteki minyatür versiyonunu vücudumda\Ndepolamamı sağlayan yeni bir silah geliştirdim.
Dialogue: 0,0:10:13.85,0:10:15.01,Main,,0,0,0,,Muggy Topu!
Dialogue: 0,0:10:15.01,0:10:16.72,Main,,0,0,0,,Adını mı değiştirdin?!
Dialogue: 0,0:10:17.04,0:10:18.13,Main,,0,0,0,,Al bakalım!
Dialogue: 0,0:10:18.30,0:10:20.67,Main,,0,0,0,,{\fad(150,150)}Özel Muggy Topu
Dialogue: 0,0:10:33.47,0:10:34.51,Main,,0,0,0,,Müthiş!
Dialogue: 0,0:10:34.51,0:10:35.90,Main,,0,0,0,,İşe yaradı!
Dialogue: 0,0:10:39.66,0:10:42.02,Main,,0,0,0,,Evet, böyle işe yarıyor.
Dialogue: 0,0:10:42.02,0:10:46.17,Main,,0,0,0,,Nasıl? Hâlâ hatırlamadın mı, Hasır Şapka?
Dialogue: 0,0:11:01.79,0:11:05.13,Main,,0,0,0,,KAHRETSİN! Hala kendinde mi?!
Dialogue: 0,0:11:05.66,0:11:07.92,Main,,0,0,0,,Hadi yapalım, Hasır-chan!
Dialogue: 0,0:11:07.92,0:11:11.43,Main,,0,0,0,,Hey, Üç! Mum güçlerini gerçekten\Nburada kullanamıyor musun?
Dialogue: 0,0:11:12.14,0:11:14.25,Main,,0,0,0,,Sadece üç saniyede erir!
Dialogue: 0,0:11:14.25,0:11:16.03,Main,,0,0,0,,O zaman bunu üç saniye\Niçinde yapmam gerekecek.
Dialogue: 0,0:11:16.03,0:11:19.44,Main,,0,0,0,,Uçuyor, uçuyorum! Uçan Okama Kenpom!
Dialogue: 0,0:11:19.73,0:11:23.03,Main,,0,0,0,,{\fad(150,150)}O Kış Göğünün Hatırası
Dialogue: 0,0:11:28.60,0:11:30.62,Main,,0,0,0,,Geliyorum, Hasır Şapka!
Dialogue: 0,0:11:30.62,0:11:32.29,Main,,0,0,0,,{\fad(150,150)}Mum Kilidi
Dialogue: 0,0:11:32.29,0:11:32.87,Main,,0,0,0,,Tamam!
Dialogue: 0,0:11:32.87,0:11:34.74,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:11:36.42,0:11:39.50,Main,,0,0,0,,{\fad(150,150)}...Tonkachi Raifuru!\N[Dönen Mermi Çekici]
Dialogue: 0,0:12:07.55,0:12:09.84,Main,,0,0,0,,BAŞARDIK!
Dialogue: 0,0:12:09.84,0:12:14.13,Main,,0,0,0,,Cehennemden bir canavarı yendik!
Dialogue: 0,0:12:14.13,0:12:18.88,Main,,0,0,0,,Şimdi Seviye 4'e gidelim!
Dialogue: 0,0:12:34.54,0:12:36.85,Main,,0,0,0,,Burası Seviye 4.
Dialogue: 0,0:12:36.85,0:12:41.90,Main,,0,0,0,,Müdür Magellan dışındaki tüm\Nkuvvetlerimiz burada toplandı.
Dialogue: 0,0:12:48.42,0:12:49.85,Main,,0,0,0,,Gelme...
Dialogue: 0,0:12:51.97,0:12:53.80,Main,,0,0,0,,...Luffy!
Dialogue: 0,0:13:03.31,0:13:06.34,Main,,0,0,0,,İdamına ne kadar kaldı?
Dialogue: 0,0:13:06.95,0:13:08.43,Main,,0,0,0,,29 saat.
Dialogue: 0,0:13:09.09,0:13:11.82,Main,,0,0,0,,Yarın öğleden sonra 3'te\Nbu iş bitmiş olacak.
Dialogue: 0,0:13:12.11,0:13:16.24,Main,,0,0,0,,Tabii her şeyin yolunda\Ngideceğini farz edersek.
Dialogue: 0,0:13:16.64,0:13:20.41,Main,,0,0,0,,Yarın sabah Portgas D. Ace'i nakledeceğiz.
Dialogue: 0,0:13:25.66,0:13:27.20,Thoughts,,0,0,0,,Luffy...
Dialogue: 0,0:13:27.20,0:13:30.79,Thoughts,,0,0,0,,Sen iyi olduğun sürece, ben...
Dialogue: 0,0:13:37.40,0:13:38.71,Main,,0,0,0,,Koramiral Momonga!
Dialogue: 0,0:13:40.60,0:13:42.07,Main,,0,0,0,,Ne oldu?
Dialogue: 0,0:13:42.07,0:13:45.88,Main,,0,0,0,,Görünüşe göre Kızıl Saç, Yeni\NDünya'da bir dövüşe karışmış!
Dialogue: 0,0:13:45.88,0:13:47.59,Main,,0,0,0,,Kızıl Saç?
Dialogue: 0,0:13:47.59,0:13:50.10,Main,,0,0,0,,Bir yanlışlık olmasın?
Dialogue: 0,0:13:50.10,0:13:51.66,Main,,0,0,0,,Neden şimdi?
Dialogue: 0,0:13:51.66,0:13:53.12,Main,,0,0,0,,Kime karşı?
Dialogue: 0,0:13:53.12,0:13:56.37,Main,,0,0,0,,Şey... Dört İmparator'dan Kaidou!
Dialogue: 0,0:13:57.05,0:13:58.31,Main,,0,0,0,,Kaidou mu dedin?!
Dialogue: 0,0:13:58.63,0:14:05.08,Main,,0,0,0,,Karargâha göre Kaidou, Beyazsakal'ı\Ndevireceğini söylemiş ve Kızıl Saç onu durdurmuş.
Dialogue: 0,0:14:05.08,0:14:07.27,Main,,0,0,0,,Ancak pek büyük bir dövüş olmamış.
Dialogue: 0,0:14:07.27,0:14:10.46,Main,,0,0,0,,Bu tür bir şeyin olması kaçınılmazdı!
Dialogue: 0,0:14:10.46,0:14:13.33,Main,,0,0,0,,Bu deniz ne kadar huzursuz oldu böyle.
Dialogue: 0,0:14:13.33,0:14:18.53,Main,,0,0,0,,Bunca olup biten şeyin yanı sıra, bir de Dört\Nİmparator arasındaki dövüşlerle uğraşamayız.
Dialogue: 0,0:14:19.14,0:14:26.09,Main,,0,0,0,,Beyazsakal'la olacak mücadeleden\Nkaçınmanın bir yolu olmadığı kesin.
Dialogue: 0,0:14:27.91,0:14:32.41,Main,,0,0,0,,Kim kazanırsa kazansın, bu dövüş tarihe geçecek.
Dialogue: 0,0:14:34.47,0:14:36.10,Main,,0,0,0,,Hemen Marineford'a yelken açın!
Dialogue: 0,0:14:36.10,0:14:37.58,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:14:37.58,0:14:41.60,Captions,,0,0,0,,{\fad(0,500)\fs50\pos(490,496.667)}Impel Down
Dialogue: 0,0:14:37.58,0:14:41.60,Captions,,0,0,30,,{\fad(0,500)\fs40}Havalandırma Kulesinin İçi
Dialogue: 0,0:14:45.85,0:14:49.77,Main,,0,0,0,,Kaç kez açıklamak zorundayım,\Nkahrolası sersem?
Dialogue: 0,0:14:49.77,0:14:52.10,Main,,0,0,0,,Şu duman sütununu göremiyor musun?!
Dialogue: 0,0:14:49.77,0:14:55.60,Secondary,,0,0,0,,Dönüyor, dönüyor, dönüyor-yor-yor!
Dialogue: 0,0:14:52.10,0:14:53.97,Main,,0,0,0,,Aşağısı Yanan Cehennem!
Dialogue: 0,0:14:53.97,0:14:55.60,Main,,0,0,0,,Biz gitmiyoruz!
Dialogue: 0,0:14:55.60,0:14:57.29,Main,,0,0,0,,Seviye 4 gibi bir yere olmaz!
Dialogue: 0,0:14:57.70,0:14:59.26,Main,,0,0,0,,Neden?
Dialogue: 0,0:14:59.26,0:15:01.14,Main,,0,0,0,,NEDEN DİYE Mİ SORUYORSUN?!
Dialogue: 0,0:15:01.14,0:15:02.85,Main,,0,0,0,,Kaçmaya çalışıyoruz!
Dialogue: 0,0:15:02.85,0:15:04.49,Main,,0,0,0,,Kaç-ma-ya.
Dialogue: 0,0:15:04.49,0:15:07.16,Main,,0,0,0,,Yukarı çıkmak istiyoruz!
Dialogue: 0,0:15:07.16,0:15:08.79,Main,,0,0,0,,Yukarı, ahmak!
Dialogue: 0,0:15:08.79,0:15:12.15,Main,,0,0,0,,Vay canına, ne büyük sümük.
Dialogue: 0,0:15:13.41,0:15:15.08,Main,,0,0,0,,HEY, DİNLİYOR MUSUN?!
Dialogue: 0,0:15:18.44,0:15:20.56,Main,,0,0,0,,Vazgeç, Hasır-chan.
Dialogue: 0,0:15:20.56,0:15:23.39,Main,,0,0,0,,O omurgasız pısırıklara ihtiyacımız yok.
Dialogue: 0,0:15:23.39,0:15:25.45,Main,,0,0,0,,SİZ KİME KOCA BURUNLU PISIRIK DİYORSUN?!
Dialogue: 0,0:15:25.73,0:15:30.47,Main,,0,0,0,,Ne?! Söylediğimi bununla\Nnasıl karıştırabilirsin?!
Dialogue: 0,0:15:30.47,0:15:33.52,Main,,0,0,0,,Karar verdim! Dönüyorum, dönüyorum!
Dialogue: 0,0:15:34.31,0:15:36.14,Main,,0,0,0,,Bu şaka değil!
Dialogue: 0,0:15:42.60,0:15:46.55,Main,,0,0,0,,Hey, tavan gitgide yükseliyor...
Dialogue: 0,0:15:47.59,0:15:49.82,Main,,0,0,0,,Haklısın.
Dialogue: 0,0:15:49.82,0:15:54.92,Main,,0,0,0,,Bu çatırtı sesini çıkarmak için ne tür bir\Nnumara kullandıklarını merak ediyordum.
Dialogue: 0,0:15:55.43,0:15:58.56,Main,,0,0,0,,DÜŞEN BİZİZ!
Dialogue: 0,0:16:01.06,0:16:05.75,Main,,0,0,0,,Kahretsin! Muggy Topu'm çok güçlüydü\Nve zeminin çökmesine neden oldu!
Dialogue: 0,0:16:05.75,0:16:09.26,Main,,0,0,0,,Hayır, hayır. Tekmelerim\Nçok sert olduğu için çöktü.
Dialogue: 0,0:16:09.26,0:16:13.47,Main,,0,0,0,,Yanılıyorsunuz, yumruğum çok güçlüydü!
Dialogue: 0,0:16:13.47,0:16:16.57,Main,,0,0,0,,Hayır, hayır, hayır... Çünkü mum güçlerim-
Dialogue: 0,0:16:16.57,0:16:19.27,Main,,0,0,0,,Ah, doğru, boş ver.
Dialogue: 0,0:16:19.55,0:16:20.51,Main,,0,0,0,,SEN DEĞİLDİN, TAMAM MI?!
Dialogue: 0,0:16:23.18,0:16:25.93,Main,,0,0,0,,ATEŞE DÜŞÜYORUZ!
Dialogue: 0,0:16:25.93,0:16:28.10,Main,,0,0,0,,YARDIM EDİN!
Dialogue: 0,0:16:40.54,0:16:44.88,Captions,,0,0,0,,{\fad(700,0)\fs50\pos(867,701.666)}“Kan Havuzu“
Dialogue: 0,0:16:49.81,0:16:52.41,Main,,0,0,0,,Hey, kes şunu!
Dialogue: 0,0:16:52.41,0:16:53.99,Main,,0,0,0,,Öleceğiz!
Dialogue: 0,0:16:53.99,0:16:56.44,Main,,0,0,0,,Başınıza gelene rıza göstereceksiniz.
Dialogue: 0,0:16:56.44,0:17:01.36,Main,,0,0,0,,Bu zamana dek kaç kişi öldürdünüz?
Dialogue: 0,0:17:01.36,0:17:02.17,Main,,0,0,0,,Yap.
Dialogue: 0,0:17:02.56,0:17:05.02,Main,,0,0,0,,Yaptıklarımızı düşünecek çok zamanımız oldu!
Dialogue: 0,0:17:05.02,0:17:07.66,Main,,0,0,0,,Evet! Üzgünüz!
Dialogue: 0,0:17:07.66,0:17:09.12,Main,,0,0,0,,Kes şunu!
Dialogue: 0,0:17:19.56,0:17:21.46,Main,,0,0,0,,SICAK! ÇOK SICAK!
Dialogue: 0,0:17:21.46,0:17:23.52,Main,,0,0,0,,KURTARIN BİZİ!
Dialogue: 0,0:17:24.09,0:17:26.17,Main,,0,0,0,,Kütükleri oraya taşıyın!
Dialogue: 0,0:17:26.17,0:17:28.28,Main,,0,0,0,,Tembellik yok!
Dialogue: 0,0:17:29.18,0:17:34.05,Main,,0,0,0,,Çok sıcak... Organlarım kaynıyor sanki!
Dialogue: 0,0:17:34.05,0:17:36.94,Main,,0,0,0,,Bu kat ölmekten daha acı verici!
Dialogue: 0,0:17:36.94,0:17:38.58,Main,,0,0,0,,Yeter artık!
Dialogue: 0,0:17:40.05,0:17:42.90,Main,,0,0,0,,Yol açın! Çekilin!
Dialogue: 0,0:17:44.66,0:17:46.54,Main,,0,0,0,,Mahkumun biri kaçmaya çalışıyor!
Dialogue: 0,0:17:47.79,0:17:49.22,Main,,0,0,0,,Hey, çekil!
Dialogue: 0,0:17:50.15,0:17:53.35,Main,,0,0,0,,Ateş denizine mi atılmak istiyorsun?!
Dialogue: 0,0:18:05.33,0:18:08.93,Main,,0,0,0,,Seni pislik! Mahkumların diğer\Nmahkumlara zarar vermesine izin verilmez!
Dialogue: 0,0:18:08.93,0:18:10.53,Main,,0,0,0,,Hemen infaz mı edilmek istiyorsun?!
Dialogue: 0,0:18:12.62,0:18:15.57,Captions,,0,0,270,,{\fad(500,0)}Eski Baroque Works Ajanı\NSuikastçı, Daz Bones
Dialogue: 0,0:18:12.62,0:18:15.57,Captions,,0,0,0,,{\fad(500,0)\fs32\pos(540,686.666)}Kod Adı           Bay 1
Dialogue: 0,0:18:19.01,0:18:20.61,Main,,0,0,0,,Neler oluyor?
Dialogue: 0,0:18:20.61,0:18:25.30,Main,,0,0,0,,Magellan, Hannybal ve tüm Şeytan\NMuhafızlar burada toplanmış.
Dialogue: 0,0:18:25.30,0:18:27.98,Main,,0,0,0,,Bu katta neler olacak?
Dialogue: 0,0:18:27.99,0:18:30.75,Captions,,0,0,30,,Seviye 3'ü ve Seviye 4'e Bağlayan Geçit
Dialogue: 0,0:18:28.72,0:18:30.74,Main,,0,0,0,,{\an8}Burası cidden çok sıcak!
Dialogue: 0,0:18:30.97,0:18:32.88,Main,,0,0,0,,Koruyucu elbiselerinizi giyin!
Dialogue: 0,0:18:32.88,0:18:35.63,Main,,0,0,0,,Hasır Şapkalı Luffy ve diğerleri\Nburaya gelirse bu kapıdan geçecekler.
Dialogue: 0,0:18:36.29,0:18:38.30,Main,,0,0,0,,Hâlâ haber yok mu?
Dialogue: 0,0:18:38.30,0:18:40.94,Main,,0,0,0,,Minotor onları öldürmüş olabilir mi?
Dialogue: 0,0:18:41.55,0:18:44.17,Main,,0,0,0,,Müdür Bey, orada saklanarak ne yapıyorsun?
Dialogue: 0,0:18:44.17,0:18:45.78,Main,,0,0,0,,Hemen çık dışarı.
Dialogue: 0,0:18:47.44,0:18:49.68,Main,,0,0,0,,Aniden açmasana!
Dialogue: 0,0:18:49.68,0:18:51.04,Main,,0,0,0,,Çok parlak!
Dialogue: 0,0:18:51.04,0:18:52.95,Main,,0,0,0,,Müdür Bey, şu müdürlük koltuğunu...
Dialogue: 0,0:18:52.95,0:18:56.00,Main,,0,0,0,,...senin işini devraldığımda\Ndaha açığıyla değiştir lütfen.
Dialogue: 0,0:18:56.00,0:18:58.83,Main,,0,0,0,,Kapa çeneni. Bu müdürün özel koltuğu.
Dialogue: 0,0:18:58.83,0:19:01.42,Main,,0,0,0,,Kapalı bir alanda kalmak istiyorum.
Dialogue: 0,0:19:01.75,0:19:04.70,Main,,0,0,0,,Kalbimi de sana kapatmayı tercih ederim.
Dialogue: 0,0:19:06.20,0:19:10.59,Main,,0,0,0,,Madem bu kadar uzun bekleyecektik,\Ndirekt Seviye 3'e gitmemiz...
Dialogue: 0,0:19:11.29,0:19:12.69,Main,,0,0,0,,...daha iyi olurdu.
Dialogue: 0,0:19:12.69,0:19:15.27,Main,,0,0,0,,Bu kadar sabırsızlanma, Sadi-chan.
Dialogue: 0,0:19:15.27,0:19:18.03,Main,,0,0,0,,Ben değil, bu çocukları kastediyorum.
Dialogue: 0,0:19:19.04,0:19:21.10,Main,,0,0,0,,Kana susamışlıklarını çok uzun süre...
Dialogue: 0,0:19:22.20,0:19:24.82,Main,,0,0,0,,...dizginleyemiyorlar.
Dialogue: 0,0:19:30.29,0:19:34.30,Captions,,0,0,255,,{\fad(1000,0)}Şeytan Muhafız
Dialogue: 0,0:19:30.29,0:19:34.30,Captions,,0,0,30,,{\fad(1000,0)}Minokoala (Saldırgan)
Dialogue: 0,0:19:38.46,0:19:42.42,Captions,,0,0,255,,{\fad(1000,0)}Şeytan Muhafız
Dialogue: 0,0:19:38.46,0:19:42.42,Captions,,0,0,30,,{\fad(1000,0)}Minorhinoceros (Utangaç)
Dialogue: 0,0:19:47.34,0:19:51.32,Captions,,0,0,255,,{\fad(1000,0)}Şeytan Muhafız
Dialogue: 0,0:19:47.34,0:19:51.32,Captions,,0,0,30,,{\fad(1000,0)}Minozebra (Çekingen)
Dialogue: 0,0:19:54.32,0:19:55.65,Main,,0,0,0,,Rapor veriyorum!
Dialogue: 0,0:19:57.42,0:20:02.49,Main,,0,0,0,,Görünüşe göre Hasır Şapkalı Luffy,\NSeviye 3'teki havalandırmaya girmiş.
Dialogue: 0,0:20:02.49,0:20:04.41,Main,,0,0,0,,Gerçi kameralarla bağlantı kuramadık.
Dialogue: 0,0:20:06.91,0:20:12.25,Main,,0,0,0,,O zaman buraya düşerse\Nbizi büyük sıkıntıdan kurtaracak.
Dialogue: 0,0:20:12.47,0:20:14.64,Main,,0,0,0,,Altındaki yer Kan Havuzu.
Dialogue: 0,0:20:15.40,0:20:18.06,Main,,0,0,0,,Hepsinin Şeytan Meyvesi gücü var.
Dialogue: 0,0:20:18.06,0:20:20.84,Main,,0,0,0,,İçine düşerlerse ölürler.
Dialogue: 0,0:20:29.32,0:20:32.11,Main,,0,0,0,,Müdür Magellan! Rapor veriyorum!
Dialogue: 0,0:20:35.10,0:20:38.61,Main,,0,0,0,,İstilacı Hasır Şapkalı Luffy,\Nçoktan bu kata ulaşmış!
Dialogue: 0,0:20:38.96,0:20:40.25,Main,,0,0,0,,Ne?!
Dialogue: 0,0:20:40.83,0:20:42.33,Main,,0,0,0,,Ne demek istiyorsun?!
Dialogue: 0,0:20:43.33,0:20:45.34,Main,,0,0,0,,Görünüşe göre havalandırmadan düşmüş.
Dialogue: 0,0:20:48.04,0:20:50.83,Main,,0,0,0,,Ama hemen altında Kan Havuzu vardı!
Dialogue: 0,0:20:50.83,0:20:52.68,Main,,0,0,0,,Nasıl hayatta kaldı?!
Dialogue: 0,0:20:52.68,0:20:58.52,Main,,0,0,0,,Sadece tahmin ediyorum ama onlarla birlikte\Ndüşen dev kayadan güvenli bir yere atlamış olabilir.
Dialogue: 0,0:20:59.25,0:21:01.60,Main,,0,0,0,,Şansları varmış.
Dialogue: 0,0:21:01.60,0:21:02.90,Main,,0,0,0,,Ayrıca...
Dialogue: 0,0:21:02.90,0:21:03.55,Main,,0,0,0,,Ne?
Dialogue: 0,0:21:03.55,0:21:05.34,Main,,0,0,0,,Müdür Bey, berbatsın!
Dialogue: 0,0:21:05.34,0:21:06.81,Main,,0,0,0,,Ah, karıştırdım.
Dialogue: 0,0:21:06.81,0:21:09.32,Main,,0,0,0,,Bu durum gerçekten\Nberbat demek istemiştim!
Dialogue: 0,0:21:09.81,0:21:14.53,Main,,0,0,0,,Şeytan Muhafız Minotor etkisiz hale gelip\Nonlarla birlikte düşmüş gibi görünüyor.
Dialogue: 0,0:21:14.53,0:21:16.96,Main,,0,0,0,,Olamaz?! Onu yenmişler mi?!
Dialogue: 0,0:21:19.97,0:21:21.14,Main,,0,0,0,,Muhtemelen.
Dialogue: 0,0:21:21.14,0:21:24.02,Main,,0,0,0,,Bu olamaz! Buna inanmayı reddediyorum!
Dialogue: 0,0:21:25.29,0:21:26.84,Main,,0,0,0,,Sakin ol!
Dialogue: 0,0:21:30.45,0:21:33.67,Main,,0,0,0,,Seviye 4'ten kaçmak niyetindelerse...
Dialogue: 0,0:21:33.67,0:21:38.17,Main,,0,0,0,,...güvenlik onayı olmadan\Nkullanabilecekleri sadece iki merdiven var.
Dialogue: 0,0:21:39.07,0:21:42.54,Main,,0,0,0,,Güçlerimizi üç kısıma ayıracağız.
Dialogue: 0,0:21:42.54,0:21:47.81,Main,,0,0,0,,Hannybal, Seviye 3'e giden bu merdivenlerin\Nkorunmasını sana bırakıyorum.
Dialogue: 0,0:21:47.81,0:21:53.00,Main,,0,0,0,,Sadi-chan, Şeytan Muhafızları al ve\NSeviye 5'e giden merdivenleri koru.
Dialogue: 0,0:21:53.00,0:21:56.14,Main,,0,0,0,,Şaka yapıyorsun!\NNöbet tutmak istemiyorum...
Dialogue: 0,0:21:56.14,0:21:58.00,Main,,0,0,0,,Onlara saldırmak istiyorum!
Dialogue: 0,0:21:58.00,0:22:01.18,Main,,0,0,0,,Onlara saldıramazsam hayatımın\Nbir anlamı yok, Müdür Bey!
Dialogue: 0,0:22:01.18,0:22:04.90,Main,,0,0,0,,Buraya gelirlerse, kaçmalarına izin\Nverip ve suçu müdüre atacağım.
Dialogue: 0,0:22:04.90,0:22:07.02,Main,,0,0,0,,Şikayetin mi var?
Dialogue: 0,0:22:08.16,0:22:10.41,Main,,0,0,0,,Ah, lütfen iç çekmeyi...
Dialogue: 0,0:22:10.41,0:22:12.04,Main,,0,0,0,,...bırak!
Dialogue: 0,0:22:12.04,0:22:14.31,Main,,0,0,0,,Niye bana da nefes veriyorsun?
Dialogue: 0,0:22:14.31,0:22:16.78,Main,,0,0,0,,İçgüdülerim bana kötü\Nniyetlerin olduğunu söyledi.
Dialogue: 0,0:22:18.49,0:22:22.58,Main,,0,0,0,,Onları yakalayınca ne\Nisterseniz yapabilirsiniz.
Dialogue: 0,0:22:23.72,0:22:26.67,Main,,0,0,0,,Bu harika! Sabırsızlanıyorum!
Dialogue: 0,0:22:26.67,0:22:31.37,Main,,0,0,0,,Geri kalan tüm gardiyanlar peşimden gelsin!
Dialogue: 0,0:22:31.37,0:22:33.01,Main,,0,0,0,,Onları öldürme iznine sahipsiniz!
Dialogue: 0,0:22:33.01,0:22:34.22,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:22:35.27,0:22:36.93,Main,,0,0,0,,Ama lütfen onları tamamen öldürmeyin!
Dialogue: 0,0:22:36.93,0:22:39.80,Main,,0,0,0,,Beni hafife almayın,\NHasır Şapkalı Luffy ve çetesi!
Dialogue: 0,0:22:39.80,0:22:41.97,Main,,0,0,0,,Artık yolunuza devam\Netmenize izin vermeyeceğim!
Dialogue: 0,0:22:41.97,0:22:45.27,Main,,0,0,0,,Bu işi Yanan Cehennem'de bitireceğim!
Dialogue: 0,0:22:59.20,0:23:00.29,Main,,0,0,0,,Sıcak!
Dialogue: 0,0:23:01.04,0:23:03.54,Main,,0,0,0,,Bu koridorun nesi var, aşırı sıcak!
Dialogue: 0,0:23:03.58,0:23:09.99,Captions,,0,0,25,,{\fad(1000,1000)}"Kan Havuzu"nun Yanı
Dialogue: 0,0:23:03.81,0:23:06.03,Main,,0,0,0,,{\an8}Hava çok sıcak, ciğerlerim\Nbile sıcaklığı hissediyor.
Dialogue: 0,0:23:06.03,0:23:08.49,Main,,0,0,0,,{\an8}Çabuk! Hemen buradan çıkmalıyız!
Dialogue: 0,0:23:08.57,0:23:10.18,Main,,0,0,0,,{\an8}Ne tarafa gitmeliyiz?
Dialogue: 0,0:23:11.99,0:23:14.71,Main,,0,0,0,,Umutsuz vakasınız!
Dialogue: 0,0:23:14.71,0:23:18.38,Main,,0,0,0,,Zihninizi boşaltırsanız ateş\Nsadece başka bir Okama olur.
Dialogue: 0,0:23:18.38,0:23:20.85,Main,,0,0,0,,Gerçi hissettiklerinizi anlamıyor değilim.
Dialogue: 0,0:23:20.85,0:23:24.47,Main,,0,0,0,,Buradaki zemin yukarıdakinden\Nbile daha sıcak.
Dialogue: 0,0:23:25.70,0:23:28.09,Main,,0,0,0,,Biraz sıcak.
Dialogue: 0,0:23:28.09,0:23:30.81,Main,,0,0,0,,Burada kızardığımı hissediyorum.
Dialogue: 0,0:23:31.96,0:23:33.96,Main,,0,0,0,,SICAK!!!
Dialogue: 0,0:23:33.96,0:23:36.04,Main,,0,0,0,,SICAĞA DAYANAMAYAN SENSİN!
Dialogue: 0,0:23:39.40,0:23:42.44,Main,,0,0,0,,Orada! Gidelim!
Dialogue: 0,0:23:42.44,0:23:45.14,Main,,0,0,0,,Nereye gidiyorsun?!
Dialogue: 0,0:23:45.14,0:23:46.64,Main,,0,0,0,,SICAK!!!
Dialogue: 0,0:23:46.64,0:23:48.94,Main,,0,0,0,,Sessiz ol!
Dialogue: 0,0:23:46.64,0:23:48.36,Secondary,,0,0,0,,SICAK!!!
Dialogue: 0,0:23:50.57,0:23:53.95,Main,,0,0,0,,Dur... Hasır-chan'ın gittiği yer...
Dialogue: 0,0:23:57.57,0:23:59.42,Captions,,0,0,0,,{\fs30\pos(643.334,370)}Kan Havuzu
Dialogue: 0,0:23:57.57,0:23:59.42,Captions,,0,0,0,,{\fs30\pos(530.001,488.333)}Mevcut konum
Dialogue: 0,0:23:57.57,0:23:59.42,Captions,,0,0,0,,{\fs30\pos(808.334,163.333)}Asansör
Dialogue: 0,0:23:57.57,0:23:59.42,Captions,,0,0,0,,{\pos(870.001,383.333)}Yanan Cehennem
Dialogue: 0,0:23:57.57,0:23:59.42,Captions,,0,0,0,,{\pos(1126.668,428.333)}Merdiven
Dialogue: 0,0:23:57.57,0:23:59.42,Captions,,0,0,0,,{\pos(1126.668,553.333)}Sadece Personel
Dialogue: 0,0:23:57.57,0:23:59.42,Captions,,0,0,0,,{\pos(960.001,688.333)}Bon-chan'ın Seviye 4 Bölümleri
Dialogue: 0,0:23:57.57,0:23:59.42,Captions,,0,0,0,,{\pos(270.001,630)}Merdiven
Dialogue: 0,0:23:57.57,0:23:59.42,Captions,,0,0,0,,{\pos(216.668,385)}Merdiven
Dialogue: 0,0:23:57.57,0:23:59.42,Captions,,0,0,0,,{\pos(311.668,55)}Yiyecek ve Malzeme Deposu
Dialogue: 0,0:23:57.57,0:23:59.42,Captions,,0,0,0,,{\pos(631.668,75)}Mutfak
Dialogue: 0,0:23:57.57,0:23:59.42,Captions,,0,0,0,,{\pos(1065.001,170)}Müdür Magellan'ın Ofisi
Dialogue: 0,0:23:57.57,0:23:59.42,Captions,,0,0,0,,{\pos(160.001,546.667)}Mahkumların Bölgesi
Dialogue: 0,0:24:00.04,0:24:02.07,Main,,0,0,0,,Mutfak orada!
Dialogue: 0,0:24:03.04,0:24:07.91,Main,,0,0,0,,Ben de acıktım! Hasır-chan, beni bekle!
Dialogue: 0,0:24:08.66,0:24:12.55,Main,,0,0,0,,Harika! İçkileri varsa mükemmel olacak!
Dialogue: 0,0:24:12.55,0:24:14.58,Main,,0,0,0,,Dur, Buggy!
Dialogue: 0,0:24:16.34,0:24:18.52,Main,,0,0,0,,Sıcak, sıcak, sıcak, sıcak, sıcak!!!
Dialogue: 0,0:24:18.52,0:24:20.36,Main,,0,0,0,,Güzel kokuyor...
Dialogue: 0,0:24:20.36,0:24:23.65,Main,,0,0,0,,Sıcak, sıcak! Güzel kokuyor...
Dialogue: 0,0:24:22.06,0:24:23.65,Secondary,,0,0,0,,Bulduk onu!
Dialogue: 0,0:24:23.65,0:24:25.26,Main,,0,0,0,,Bu Hasır Şapkalı Luffy!
Dialogue: 0,0:24:27.90,0:24:30.39,Main,,0,0,0,,Çok fazlalar!
Dialogue: 0,0:24:31.54,0:24:36.18,Main,,0,0,0,,Burası üst kattan daha sıcak ama bir şey yer\Nyemez kendimi 100 kat daha iyi hissedeceğim!
Dialogue: 0,0:24:36.46,0:24:37.52,Main,,0,0,0,,Durdurun onu!
Dialogue: 0,0:24:42.66,0:24:45.13,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:24:49.22,0:24:51.42,Main,,0,0,0,,{\fad(150,150)}...Havai Fişek
Dialogue: 0,0:24:57.90,0:24:59.90,Main,,0,0,0,,Sorun nedir, ortak?!
Dialogue: 0,0:24:59.90,0:25:02.21,Main,,0,0,0,,Dikkatlice bak.
Dialogue: 0,0:25:02.48,0:25:04.71,Main,,0,0,0,,Düşman patır patır dökülüyor.
Dialogue: 0,0:25:04.71,0:25:08.21,Main,,0,0,0,,Seviye 4, çığlıkları ve\Nişkenceleriyle de bilinir...
Dialogue: 0,0:25:08.21,0:25:11.43,Main,,0,0,0,,...ama ürkütücü işkence çukurlarına\Nmuhafızlık eden tek bir gardiyan bile yok.
Dialogue: 0,0:25:18.25,0:25:20.48,Main,,0,0,0,,Yukarıda! Yukarıdalar!
Dialogue: 0,0:25:20.48,0:25:23.59,Main,,0,0,0,,Fırsatımız varken çıkışın\Nnerede olduğunu bulmalıyız!
Dialogue: 0,0:25:23.59,0:25:28.74,Main,,0,0,0,,Bu katta tuzağa düşüp mahsur kalabiliriz!
Dialogue: 0,0:25:29.87,0:25:32.26,Main,,0,0,0,,Seviye 4'te tuzağa düşmek mi?!
Dialogue: 0,0:25:32.26,0:25:34.40,Main,,0,0,0,,Ama Hasır Şapka'nın peşindeler, değil mi?!
Dialogue: 0,0:25:34.40,0:25:36.63,Main,,0,0,0,,Bizim buraya gelmemiz sadece kazaydı!
Dialogue: 0,0:25:36.90,0:25:42.00,Main,,0,0,0,,Yine de kaçmaya çalıştığımız için\Nisimlerimiz ve yüzlerimiz ortaya çıktı.
Dialogue: 0,0:25:42.00,0:25:44.47,Main,,0,0,0,,Korkarım ki...
Dialogue: 0,0:25:45.11,0:25:47.72,Main,,0,0,0,,...isyanı bastırmak için Impel Down'ın...
Dialogue: 0,0:25:47.72,0:25:53.68,Main,,0,0,0,,...bütün meşhur yüzlerini buraya\Ntoplamış olma olasılıkları yüksek.
Dialogue: 0,0:25:54.18,0:25:57.31,Main,,0,0,0,,Kalan üç Şeytan Muhafız muhakkak gelir...
Dialogue: 0,0:25:59.05,0:26:04.60,Main,,0,0,0,,...ama Müdür Magellan da\Ngelirse işimiz biter!
Dialogue: 0,0:26:04.80,0:26:06.87,Main,,0,0,0,,Çekilin yolumdan!
Dialogue: 0,0:26:12.80,0:26:16.61,Main,,0,0,0,,Kahretsin... Mızrak falan\Nolduğunu sanmıştım.
Dialogue: 0,0:26:16.61,0:26:17.91,Main,,0,0,0,,Nedir o?
Dialogue: 0,0:26:17.91,0:26:18.84,Main,,0,0,0,,Jöle mi? Kaka mı?
Dialogue: 0,0:26:20.34,0:26:22.34,Main,,0,0,0,,Hasır-chan, yukarı bak!
Dialogue: 0,0:26:30.24,0:26:34.30,Main,,0,0,0,,Uzun süredir özgürce koşturuyordun!
Dialogue: 0,0:26:34.91,0:26:35.97,Main,,0,0,0,,Kimsin sen?!
Dialogue: 0,0:26:37.98,0:26:40.06,Main,,0,0,0,,M-Magellan!
Dialogue: 0,0:26:42.19,0:26:46.31,Main,,0,0,0,,Sonun geldi, inatçı fare!
