Dialogue: 0,0:02:33.00,0:02:42.42,Title,,0,0,0,,{\fad(1800,1700)}Donanma Karargâhı
Dialogue: 0,0:02:55.09,0:02:58.92,Main,,0,0,0,,Canınızı ucu ucuna kurtarmış gibisiniz.
Dialogue: 0,0:02:59.61,0:03:04.65,Captions,,0,0,0,,{\fad(1000,1000)\pos(885,540)\fs65}Impel Down
Dialogue: 0,0:02:59.61,0:03:04.65,Main,,0,0,0,,{\fad(1000,1000)}- Seviye 4 - Kavurucu Sıcaklık Cehennemi -
Dialogue: 0,0:02:59.02,0:03:02.08,Main,,0,0,0,,{\an8}Panzehirle birlikte gelmeseydim,...
Dialogue: 0,0:03:02.08,0:03:05.44,Main,,0,0,0,,{\an8}...hayatta kalamazdınız.
Dialogue: 0,0:03:05.44,0:03:07.43,Main,,0,0,0,,{\an8}Magellan'ı hafife aldınız.
Dialogue: 0,0:03:09.92,0:03:11.43,Main,,0,0,0,,Ama hayattayız!
Dialogue: 0,0:03:11.43,0:03:16.45,Main,,0,0,0,,Buraya gelmen kaderin işiydi.
Dialogue: 0,0:03:18.71,0:03:22.10,Main,,0,0,0,,Yine de... Gerçekten öleceğimizi sandım.
Dialogue: 0,0:03:22.10,0:03:24.60,Main,,0,0,0,,Görünüşe bakılırsa...
Dialogue: 0,0:03:24.60,0:03:26.89,Main,,0,0,0,,...bu kez şanslıyız.
Dialogue: 0,0:03:31.56,0:03:34.25,Main,,0,0,0,,Yaşamamız ya da ölmemiz göklerin karar vereceği bir şey.
Dialogue: 0,0:03:34.25,0:03:36.92,Main,,0,0,0,,Korkuya teslim olan kişi yenilir.
Dialogue: 0,0:03:39.88,0:03:42.57,Main,,0,0,0,,Görünüşe göre biraz daha yaşamamız gerekiyormuş.
Dialogue: 0,0:03:43.33,0:03:44.79,Main,,0,0,0,,Hey, Shiryuu!
Dialogue: 0,0:03:57.16,0:04:01.29,Main,,0,0,0,,Bizi kurtarman ne hoş. Çok sağol.
Dialogue: 0,0:04:01.29,0:04:03.61,Main,,0,0,0,,Bir kez daha seni davet ediyorum.
Dialogue: 0,0:04:03.61,0:04:05.66,Main,,0,0,0,,Tayfamız için iyi bir ilave olursun.
Dialogue: 0,0:04:05.66,0:04:09.18,Main,,0,0,0,,Burada kalmakla bir geleceğimin olacağına inanmıyorum.
Dialogue: 0,0:04:09.18,0:04:12.76,Main,,0,0,0,,Senin gibi bir adamla karşılaşmayı bekliyordum.
Dialogue: 0,0:04:21.02,0:04:25.49,Captions,,0,0,0,,{\fad(900,700)\fs45\pos(460,555)}Özel Hükümet Rotası:
Dialogue: 0,0:04:21.02,0:04:25.49,Captions,,0,0,0,,{\fad(900,700)\pos(950,555)\fs45}Tarai Akıntısı
Dialogue: 0,0:04:24.72,0:04:27.49,Main,,0,0,0,,{\an8}Inazuma burada dinlensin.
Dialogue: 0,0:04:27.49,0:04:31.06,Main,,0,0,0,,Ne? Yani zehir onu bu kadar etkiledi mi?
Dialogue: 0,0:04:31.06,0:04:38.66,Main,,0,0,0,,Bana attığı zehri İyileştirme ve Gerilim\NHormonları'nı kullanarak tedavi edebildim...
Dialogue: 0,0:04:44.36,0:04:50.47,Main,,0,0,0,,...ama bu insanın ömrünü kısaltan bir teknik, sonrasında ortaya çıkan kötü yan etkilerinden bahsetmiyorum bile.
Dialogue: 0,0:04:50.78,0:04:55.97,Main,,0,0,0,,Mümkünse bekleyip normal olarak iyileşmesi onun için daha iyi olur.
Dialogue: 0,0:04:56.50,0:05:00.45,Main,,0,0,0,,Yaşam süren kısalınca, kaybettiğin yılları asla telafi edemezsin.
Dialogue: 0,0:05:00.45,0:05:03.92,Main,,0,0,0,,Inazuma, Devrim Ordusu için önemli bir Yenikama.
Dialogue: 0,0:05:04.29,0:05:08.72,Main,,0,0,0,,Bedenini mahvetmek için uygun zaman değil.
Dialogue: 0,0:05:17.31,0:05:20.67,Main,,0,0,0,,Düşünüyorum da, fena bir arkadaş değildi.
Dialogue: 0,0:05:22.05,0:05:24.33,Main,,0,0,0,,Nihayet yeniden buluşmuştuk...
Dialogue: 0,0:05:24.33,0:05:26.80,Main,,0,0,0,,...ve sonuçta beni yine kurtardı.
Dialogue: 0,0:05:31.58,0:05:32.90,Main,,0,0,0,,Bon-{\i1}chan!{\i0}
Dialogue: 0,0:05:32.90,0:05:33.80,Main,,0,0,0,,Bon kardeş!
Dialogue: 0,0:05:33.80,0:05:34.91,Main,,0,0,0,,Bon-{\i1}chan!{\i0}
Dialogue: 0,0:05:34.91,0:05:38.52,Main,,0,0,0,,Bon-{\i1}chan!{\i0}
Dialogue: 0,0:05:39.85,0:05:44.13,Main,,0,0,0,,Hey, daha ne kadar hıçkırıp duracaksınız?
Dialogue: 0,0:05:44.77,0:05:47.81,Main,,0,0,0,,İyi biriydi, ama artık öldü ve yapabileceğimiz bir şey yok.
Dialogue: 0,0:05:47.81,0:05:50.49,Main,,0,0,0,,Kutlayalım gitsin!
Dialogue: 0,0:05:50.88,0:05:52.63,Main,,0,0,0,,Özgürlüğümüzü kutlayalım!
Dialogue: 0,0:05:55.18,0:05:58.72,Main,,0,0,0,,Ya da isterseniz, bunu Bay 2'nin cenaze töreni yapabiliriz.
Dialogue: 0,0:06:02.68,0:06:05.36,Main,,0,0,0,,Ne kadar güzel kanlı bir servis!
Dialogue: 0,0:06:06.65,0:06:11.15,Main,,0,0,0,,Bon-chan'ın öldüğünü kesin\Nolarak bilmiyoruz, seni koca burun!
Dialogue: 0,0:06:11.15,0:06:13.53,Main,,0,0,0,,Sen kime koca burun diyorsun?!
Dialogue: 0,0:06:13.53,0:06:17.04,Main,,0,0,0,,Sen, kırmızı burunlu, yuvarlak burunlu, aptal burunlu aptal!
Dialogue: 0,0:06:17.04,0:06:21.26,Main,,0,0,0,,Senin de lastik gibi uzayan, aptal bir suratın var!
Dialogue: 0,0:06:21.26,0:06:22.75,Main,,0,0,0,,Ne dedin?!
Dialogue: 0,0:06:23.48,0:06:26.30,Main,,0,0,0,,Oh, ne isterseniz yapın.
Dialogue: 0,0:06:31.84,0:06:39.86,Main,,0,0,0,,Balıklarla konuşmanın Balıkadamların\Nözel yeteneği olduğunu duymuştum,...
Dialogue: 0,0:06:39.86,0:06:42.98,Main,,0,0,0,,...ama o köpekbalıklarını çağırabilmenden etkilendim.
Dialogue: 0,0:06:42.98,0:06:46.82,Main,,0,0,0,,Balıkadamların balıklarla anlaşabiliyor olması tuhaf mı?
Dialogue: 0,0:06:47.54,0:06:50.24,Main,,0,0,0,,Şey, bana biraz tuhaf görünüyor.
Dialogue: 0,0:06:50.24,0:06:52.29,Main,,0,0,0,,Epey vahşi türlerden geliyorsun,...
Dialogue: 0,0:06:53.34,0:06:55.82,Main,,0,0,0,,...ama sanırım sen tuhaf olanlardan değilsin.
Dialogue: 0,0:06:55.82,0:06:59.09,Main,,0,0,0,,Bunu iltifat olarak kabul edeceğim.
Dialogue: 0,0:06:59.94,0:07:03.17,Main,,0,0,0,,Balıkadamların çoğunun vahşi olduğunu reddedemem.
Dialogue: 0,0:07:03.46,0:07:05.25,Main,,0,0,0,,Bon-chan ölmedi!
Dialogue: 0,0:07:07.46,0:07:09.94,Main,,0,0,0,,Kaptan Buggy'nin ikinci bir kırmızı burnu oldu!
Dialogue: 0,0:07:12.66,0:07:14.51,Main,,0,0,0,,Luffy-{\i1}kun.{\i0}
Dialogue: 0,0:07:14.84,0:07:20.09,Main,,0,0,0,,Sayende Ace-san'ı kurtarma fırsatım var.
Dialogue: 0,0:07:21.08,0:07:23.00,Main,,0,0,0,,Sana borçluyum.
Dialogue: 0,0:07:23.00,0:07:25.26,Main,,0,0,0,,Oh, öyle deme. Hiç sorun değil.
Dialogue: 0,0:07:26.60,0:07:30.76,Main,,0,0,0,,Sen de burada olunca kendimi daha\Niyi hissediyorum. Çok güçlüsün!
Dialogue: 0,0:07:31.16,0:07:38.10,Thoughts,,0,0,0,,Sana teşekkür ve özür borçlu olduğum tek olay bu değil,...
Dialogue: 0,0:07:38.10,0:07:40.60,Thoughts,,0,0,0,,...ama şimdi bunu konuşacak zaman değil.
Dialogue: 0,0:07:40.60,0:07:43.41,Thoughts,,0,0,0,,Şu anda tek bir amacımız var.
Dialogue: 0,0:07:44.10,0:07:47.19,Main,,0,0,0,,Bana Jinbei diyebilirsin.
Dialogue: 0,0:07:47.19,0:07:52.48,Main,,0,0,0,,Eskiden Denizin Yedi Savaş Lordu'ndan\Nbiriydim, ama o unvanı terkettim!
Dialogue: 0,0:07:52.48,0:07:56.24,Main,,0,0,0,,Denizci Karargâhı'na cehennemi yaşatalım!
Dialogue: 0,0:07:57.24,0:08:03.00,Main,,0,0,0,,Ace-san'ı kurtarmalıyız ki,\NOkama-kun'un çabaları boşa gitmesin!
Dialogue: 0,0:08:03.28,0:08:04.62,Main,,0,0,0,,Savaş Lordları'ndan biri mi?
Dialogue: 0,0:08:04.62,0:08:06.80,Main,,0,0,0,,Denizci Karargâhı mı?
Dialogue: 0,0:08:06.80,0:08:08.97,Main,,0,0,0,,HA?!
Dialogue: 0,0:08:08.97,0:08:12.54,Main,,0,0,0,,Hey, hey! Yedi Savaş Lordu'nda biri miydin sen?!
Dialogue: 0,0:08:12.54,0:08:14.54,Main,,0,0,0,,Bu kadar güçlü olmana şaşmamalı!
Dialogue: 0,0:08:17.40,0:08:20.62,Main,,0,0,0,,Kusura bakma. Kendimi daha erken tanıtmalıydım.
Dialogue: 0,0:08:20.62,0:08:22.56,Main,,0,0,0,,Bilmiyor olman çok daha şaşırtıcı.
Dialogue: 0,0:08:22.56,0:08:26.39,Main,,0,0,0,,Hey! "Denizci Karargâhı" da ne demek oluyor?!
Dialogue: 0,0:08:26.39,0:08:30.72,Main,,0,0,0,,Bu geminin Denizci Karargâhı'na gitmediğini söylesen iyi olur!
Dialogue: 0,0:08:30.72,0:08:35.56,Main,,0,0,0,,Denizciler'le Beyazsakal Korsanları\Narasındaki savaştan haberin var, değil mi?!
Dialogue: 0,0:08:36.25,0:08:37.53,Main,,0,0,0,,Ah, ne?
Dialogue: 0,0:08:37.53,0:08:38.54,Main,,0,0,0,,Denizci Karargâhı?
Dialogue: 0,0:08:38.54,0:08:43.02,Main,,0,0,0,,Ne diyorsun? Bu kadar aptal olman bizim hatamız değil.
Dialogue: 0,0:08:43.02,0:08:44.07,Main,,0,0,0,,NE?!
Dialogue: 0,0:08:44.07,0:08:50.82,Main,,0,0,0,,Adaletin Kapıları'ndan geçtiğimize göre, gidebileceğimiz yerler sadece Enies Lobby ve Denizci Karargâhı.
Dialogue: 0,0:08:49.69,0:08:54.36,Captions,,0,0,0,,{\fad(1000,1000)\pos(205,585)\fs25}Denizci Karargâhı\N(Marineford)
Dialogue: 0,0:08:49.69,0:08:54.36,Captions,,0,0,0,,{\fad(1000,1000)\fs25\pos(1145,565)}Enies Lobby
Dialogue: 0,0:08:49.69,0:08:54.36,Captions,,0,0,0,,{\fad(1000,1000)\fs25\pos(830,90)}Büyük Hapisane\NImpel Down
Dialogue: 0,0:08:49.69,0:08:54.36,Captions,,0,0,0,,{\fad(1000,1000)\fs25\pos(350,385)}Mariejoa
Dialogue: 0,0:08:50.82,0:08:54.65,Main,,0,0,0,,Şu anda Hükümet'in özel rotası Tarai Akıntısı'nda yol alıyoruz.
Dialogue: 0,0:08:54.65,0:08:58.44,Main,,0,0,0,,Hükümet'in üç ana üssünü birbirine bağlayan muazzam anafor.
Dialogue: 0,0:08:58.44,0:09:04.07,Main,,0,0,0,,Zaten kaçmamızın tek nedeni savaşa katılmaktı.
Dialogue: 0,0:09:04.92,0:09:08.32,Main,,0,0,0,,Evet! Savaş şimdi başlıyor!
Dialogue: 0,0:09:08.32,0:09:11.16,Main,,0,0,0,,Evet, savaş şimdi başlıyor diyorsun...
Dialogue: 0,0:09:11.16,0:09:14.12,Main,,0,0,0,,K-KİMSE BİZE BUNDAN BAHSETMEDİ!
Dialogue: 0,0:09:14.12,0:09:16.76,Main,,0,0,0,,Gemiyi hemen durdur lanet olası!
Dialogue: 0,0:09:16.76,0:09:18.00,Main,,0,0,0,,Durdur şunu!
Dialogue: 0,0:09:18.00,0:09:22.00,Main,,0,0,0,,Deniz akıntısına girdiğimiz için,\Nartık durdurmam mümkün değil!
Dialogue: 0,0:09:22.00,0:09:24.30,Main,,0,0,0,,Niye ikiniz inmiyorsunuz?
Dialogue: 0,0:09:24.30,0:09:27.65,Main,,0,0,0,,{\fscx300}-{\r}Tamam, hoşçakalın!\N{\fscx300}-{\r}Görüşürüz!
Dialogue: 0,0:09:27.65,0:09:32.48,Main,,0,0,0,,CİDDEN İNECEĞİMİZİ Mİ SANIYORSUN?! İKİMİZ DE\NŞEYTAN MEYVESİ KULLANICISIYIZ! İNERSEK ÖLÜRÜZ!
Dialogue: 0,0:09:32.48,0:09:39.62,Main,,0,0,0,,Denizci Karargâhı ve Savaş Lordları, Beyazsakal Korsanları'na karşı... bu savaş Cehennem'den de korkunç!
Dialogue: 0,0:09:50.95,0:09:55.21,Main,,0,0,0,,Öyle bir yere gideceksek, hapisaneye dönmeyi tercih ederim!
Dialogue: 0,0:09:56.54,0:09:58.71,Main,,0,0,0,,Biz Kama Mekânı'ndan gelenler bunu biliyorduk.
Dialogue: 0,0:10:05.58,0:10:09.49,Main,,0,0,0,,Hey, bir şey duyuyor musunuz?
Dialogue: 0,0:10:30.64,0:10:33.15,Main,,0,0,0,,B-Burada değilmiş gibi davranmalıyız belki de.
Dialogue: 0,0:10:36.22,0:10:37.53,Main,,0,0,0,,Ah, efendim?
Dialogue: 0,0:10:37.53,0:10:39.02,Main,,0,0,0,,CEVAP VERDİ!
Dialogue: 0,0:10:39.02,0:10:41.02,Main,,0,0,0,,{\i1}Burası Denizci Karargâhı.{\i0}
Dialogue: 0,0:10:41.02,0:10:42.75,Main,,0,0,0,,Evet, ben de Luffy.
Dialogue: 0,0:10:42.75,0:10:44.52,Main,,0,0,0,,ONA ADINI SÖYLEME! SEN KORSANSIN!
Dialogue: 0,0:10:44.52,0:10:52.46,Main,,0,0,0,,{\i1}Impel Down konvoyundan, bu geminin kaçaklar tarafından ele geçirildiği haberini aldık.{\i0}
Dialogue: 0,0:10:53.01,0:10:57.16,Main,,0,0,0,,{\i1}Impel Down'la bağlantıyı yitirmeden\Nönce aldığımız bilgiye göre,...{\i0}
Dialogue: 0,0:10:57.16,0:11:00.51,Main,,0,0,0,,{\i1}...bu kaçıştan iki kişinin sorumlu olduğuna hükmettik.{\i0}
Dialogue: 0,0:11:01.67,0:11:02.64,Main,,0,0,0,,İki kişi?
Dialogue: 0,0:11:02.64,0:11:05.33,Main,,0,0,0,,{\i1}Korsan Hasır Şapkalı Luffy...{\i0}
Dialogue: 0,0:11:06.13,0:11:08.00,Main,,0,0,0,,{\i1}...ve korsan arkadaşı...{\i0}
Dialogue: 0,0:11:08.00,0:11:09.51,Main,,0,0,0,,{\i1}...Palyaço Buggy.{\i0}
Dialogue: 0,0:11:11.63,0:11:13.66,Main,,0,0,0,,{\fscx300}-{\r}Ha?!\N{\fscx300}-{\r}N-Ne?!
Dialogue: 0,0:11:13.66,0:11:14.56,Main,,0,0,0,,Cidden mi?!
Dialogue: 0,0:11:14.56,0:11:18.32,Main,,0,0,0,,Kaptan Buggy'nin Savaş Lordları'ndan\Ndaha önemli olduğunu mu düşünüyorlar?!
Dialogue: 0,0:11:18.32,0:11:20.82,Main,,0,0,0,,Kimsin sen?!
Dialogue: 0,0:11:21.37,0:11:23.13,Main,,0,0,0,,Niye ben?
Dialogue: 0,0:11:23.65,0:11:24.99,Main,,0,0,0,,Kâğıtları verin.
Dialogue: 0,0:11:24.99,0:11:26.57,Main,,0,0,0,,Emredersiniz. İşte.
Dialogue: 0,0:11:26.57,0:11:30.48,Main,,0,0,0,,Namsız bir korsan olduğunu düşünerek seni hafife aldık.
Dialogue: 0,0:11:30.48,0:11:33.54,Main,,0,0,0,,Palyaço Buggy, Korsanlar Kralı Gold Roger'ın...
Dialogue: 0,0:11:33.54,0:11:38.49,Main,,0,0,0,,...tayfasından olduğunu hiç düşünmemiştik.
Dialogue: 0,0:11:39.09,0:11:40.68,Main,,0,0,0,,Nasıl öğrendiler?!
Dialogue: 0,0:11:42.31,0:11:44.47,Main,,0,0,0,,Oro Jackson tayfasından biri miydin?!
Dialogue: 0,0:11:44.47,0:11:45.71,Main,,0,0,0,,Bu çok büyük!
Dialogue: 0,0:11:45.71,0:11:48.51,Main,,0,0,0,,B-Bir yıldız! Bir korsan yıldızı!
Dialogue: 0,0:11:48.51,0:11:54.91,Main,,0,0,0,,{\i1}Dört İmparator'dan biri olan Kızıl Saçlı Shanks'le kardeş gibi olduğun haberini de aldık.{\i0}
Dialogue: 0,0:11:54.91,0:11:56.49,Main,,0,0,0,,NE DEDİN?!
Dialogue: 0,0:11:56.49,0:12:03.23,Main,,0,0,0,,{\i1}Senin gibi birinin bu olay meydana gelene kadar\Nsu yüzüne çıkmamış olmasından etkilendim.{\i0}
Dialogue: 0,0:12:03.23,0:12:05.87,Main,,0,0,0,,{\i1}Ama buraya geldiğin için, gerçek gücünü ortaya çıkardın.{\i0}
Dialogue: 0,0:12:07.31,0:12:08.57,Main,,0,0,0,,Ah, hayır...
Dialogue: 0,0:12:08.57,0:12:12.03,Main,,0,0,0,,{\i1}Henüz Ateş Yumruk Ace'le aranda bir bağlantı kuramadık,...{\i0}
Dialogue: 0,0:12:12.03,0:12:17.37,Main,,0,0,0,,{\i1}...ama amacının Hasır Şapkalı Luffy ile\Naynı olduğundan eminim, Ace'i kurtarmak.{\i0}
Dialogue: 0,0:12:17.37,0:12:22.25,Main,,0,0,0,,{\i1}Jinbei, Crocodile, Ivankov ve 200'den...{\i0}
Dialogue: 0,0:12:22.25,0:12:27.54,Main,,0,0,0,,{\i1}...fazla kaçağın da gemide olduğunu teyit ettik.{\i0}
Dialogue: 0,0:12:27.54,0:12:29.36,Main,,0,0,0,,Sizi şimdi uyarıyorum.
Dialogue: 0,0:12:29.98,0:12:35.45,Main,,0,0,0,,{\i1}Biz Adaletin Kapıları'nı açmadıkça ne Marineford'a ulaşabilirsiniz,...{\i0}
Dialogue: 0,0:12:35.45,0:12:39.04,Main,,0,0,0,,{\i1}...ne de Tarai Akıntısı'ndan kaçabilirsiniz.{\i0}
Dialogue: 0,0:12:39.04,0:12:43.61,Main,,0,0,0,,{\i1}Kaçacak bir deniz ya da gidecek bir yer yok.{\i0} {.}
Dialogue: 0,0:12:45.13,0:12:47.24,Main,,0,0,0,,{\i1}Buna razı olsanız iyi olur.{\i0}
Dialogue: 0,0:12:47.24,0:12:48.10,Main,,0,0,0,,{\i1}Hepsi bu.{\i0}
Dialogue: 0,0:12:48.10,0:12:49.44,Main,,0,0,0,,Hey, durun, Denizciler!
Dialogue: 0,0:12:53.25,0:12:55.62,Main,,0,0,0,,Ace'i kesinlikle kurtaracağım!
Dialogue: 0,0:12:57.15,0:12:59.46,Main,,0,0,0,,Patateslerinizi yıkayıp bekleyin!
Dialogue: 0,0:13:00.65,0:13:01.93,Main,,0,0,0,,Patates?
Dialogue: 0,0:13:07.28,0:13:09.95,Main,,0,0,0,,"Kendiniz"!  "Kendinize dikkat edin" diyecektin, Hasır Şapka-san!
Dialogue: 0,0:13:09.95,0:13:13.19,Main,,0,0,0,,Sanki patates yıkayıp kaynatacak zamanmış gibi!
Dialogue: 0,0:13:13.65,0:13:17.72,Main,,0,0,0,,Hey, bu herif neden Denizci Karargâhı ile kavga ediyor ki?
Dialogue: 0,0:13:17.72,0:13:20.41,Main,,0,0,0,,Hayır, durun! Asıl önemlisi, Kaptan Buggy...
Dialogue: 0,0:13:20.41,0:13:23.10,Main,,0,0,0,,Korsanlar Kralı'nın tayfasında mıydın?!
Dialogue: 0,0:13:23.10,0:13:25.65,Main,,0,0,0,,Kızıl Saçla da kardeş gibi misin?!
Dialogue: 0,0:13:25.65,0:13:30.40,Main,,0,0,0,,Kurtarıcımız gerçekten müthiş bir korsan!
Dialogue: 0,0:13:30.40,0:13:31.27,Main,,0,0,0,,Hayır, durun!
Dialogue: 0,0:13:31.81,0:13:36.65,Thoughts,,0,0,0,,{\i1}Eyvah! Her şeyi bildiklerine göre,\NHükümet artık peşime düşecektir!{\i0}
Dialogue: 0,0:13:36.65,0:13:39.26,Main,,0,0,0,,Böyle bir geçmişi olduğunu hiç düşünmemiştim.
Dialogue: 0,0:13:39.26,0:13:41.28,Main,,0,0,0,,Buna rağmen çok güçsüz.
Dialogue: 0,0:13:43.16,0:13:46.12,Main,,0,0,0,,Peki nasıl böyle bir korkak olabilir?
Dialogue: 0,0:13:46.12,0:13:49.46,Main,,0,0,0,,Demek ki herkesin eksik bir yanı oluyor.
Dialogue: 0,0:13:51.28,0:13:52.84,Main,,0,0,0,,KAPAYIN ÇENENİZİ!
Dialogue: 0,0:13:52.84,0:13:55.38,Main,,0,0,0,,Öyle mi? Sahi...
Dialogue: 0,0:13:55.80,0:13:59.51,Flashbacks,,0,0,0,,Doğu Mavi'den geliyorsan, Buggy adında bir korsanı da tanıyor olabilirsin.
Dialogue: 0,0:13:59.95,0:14:03.19,Main,,0,0,0,,Yaşlı Yardımcı Kaptan da buna benzer bir şeyden bahsetmişti.
Dialogue: 0,0:14:03.47,0:14:05.35,Main,,0,0,0,,Ha? Yardımcı Kaptan?
Dialogue: 0,0:14:06.36,0:14:09.52,Main,,0,0,0,,Rayleigh adında yaşlı bir adam.\NOnu tanıyorsun, değil mi?
Dialogue: 0,0:14:09.52,0:14:13.17,Main,,0,0,0,,NE?! Rayleigh-san'la mı karşılaştın?!
Dialogue: 0,0:14:13.17,0:14:15.67,Main,,0,0,0,,Oh, anılarım canlandı! Yardımcı Kaptan, öyle mi?
Dialogue: 0,0:14:15.67,0:14:16.53,Main,,0,0,0,,Nerede karşılaştın?
Dialogue: 0,0:14:16.53,0:14:18.99,Main,,0,0,0,,Kara Kral Rayleigh'in adı dile geldi!
Dialogue: 0,0:14:18.99,0:14:20.49,Main,,0,0,0,,Ne inanılmaz bir konuşma!
Dialogue: 0,0:14:21.41,0:14:26.08,Main,,0,0,0,,Kaptan Buggy! Gerçekten ürkütücü bir adamsın!
Dialogue: 0,0:14:26.08,0:14:28.81,Main,,0,0,0,,Hayır, hayır, durun biraz!
Dialogue: 0,0:14:28.81,0:14:30.82,Main,,0,0,0,,Yani bu doğru, ama...
Dialogue: 0,0:14:30.82,0:14:33.25,Main,,0,0,0,,...şimdiye dek sürdüğüm hayat...
Dialogue: 0,0:14:33.25,0:14:35.52,Main,,0,0,0,,...şimdiye dek sürdüğüm hayat...
Dialogue: 0,0:14:35.52,0:14:39.67,Main,,0,0,0,,Müthişsin! Efsanevi korsan tayfasının bir üyesiymişsin!
Dialogue: 0,0:14:39.67,0:14:42.01,Main,,0,0,0,,Buggy! Buggy!
Dialogue: 0,0:14:42.01,0:14:43.93,Main,,0,0,0,,Sizi aptallar!
Dialogue: 0,0:14:45.26,0:14:48.73,Main,,0,0,0,,Tezahüratı bırakın! Sadece miçoydum!
Dialogue: 0,0:14:48.73,0:14:52.84,Main,,0,0,0,,Özgürlüğünüz için bana teşekkür etmek\Nzorunda olsanız bile, yine de ben...
Dialogue: 0,0:14:52.84,0:14:56.32,Main,,0,0,0,,Hayır, size diyorum, yanlış anladınız!
Dialogue: 0,0:14:57.01,0:15:00.19,Thoughts,,0,0,0,,{\i1}Gerçi hepsi yanlış değil.{\i0}
Dialogue: 0,0:15:00.19,0:15:02.05,Thoughts,,0,0,0,,{\i1}Tabii ya! Dur biraz...{\i0}
Dialogue: 0,0:15:02.05,0:15:07.13,Thoughts,,0,0,0,,{\i1}Denizciler'in beni abarttığı doğru, ama bu işime yarayabilir!{\i0}
Dialogue: 0,0:15:07.13,0:15:10.83,Thoughts,,0,0,0,,{\i1}Evet! Söyledikleri hiçbir şey yalan değildi!{\i0}
Dialogue: 0,0:15:10.83,0:15:13.96,Thoughts,,0,0,0,,{\i1}İtibarımın tavan yaptığına şüphe yok!{\i0}
Dialogue: 0,0:15:13.96,0:15:16.17,Thoughts,,0,0,0,,{\i1}Kazara birisi...{\i0}
Dialogue: 0,0:15:16.17,0:15:17.46,Thoughts,,0,0,0,,{\i1}Ben...{\i0}
Dialogue: 0,0:15:18.92,0:15:23.89,Thoughts,,0,0,0,,{\i1}Biri bugün Beyazsakal'ın başını alsaydı, o zaman onlar...{\i0}
Dialogue: 0,0:15:23.89,0:15:25.22,Thoughts,,0,0,0,,{\i1}Dört İmparator'dan biri olabilir miyim?!{\i0}
Dialogue: 0,0:15:25.22,0:15:27.72,Thoughts,,0,0,0,,{\i1}Hayır, ondan da fazlası.{\i0}
Dialogue: 0,0:15:28.68,0:15:31.48,Thoughts,,0,0,0,,{\i1}Korsanlar Kralı olabilirim!{\i0}
Dialogue: 0,0:15:31.48,0:15:36.67,Thoughts,,0,0,0,,{\i1}Evet! Kaçakların hepsinin benden yüksek ödülü var!{\i0}
Dialogue: 0,0:15:36.67,0:15:38.90,Thoughts,,0,0,0,,{\i1}Onları kullanabilirim!{\i0}
Dialogue: 0,0:15:42.11,0:15:43.15,Thoughts,,0,0,0,,{\i1}Yapabilirim!{\i0}
Dialogue: 0,0:15:43.15,0:15:47.89,Main,,0,0,0,,Kaptan Buggy! Peşinden her yere geleceğiz!
Dialogue: 0,0:15:49.58,0:15:54.50,Main,,0,0,0,,Sadece emret! Denizci Karargâhı'na\Ngitmek isteyenlerden gemiyi çalacağız!
Dialogue: 0,0:15:54.50,0:15:57.30,Main,,0,0,0,,Sonra da özgür olacağız!
Dialogue: 0,0:15:57.89,0:16:00.07,Main,,0,0,0,,Şimdi, Hasır Şapka...
Dialogue: 0,0:16:00.07,0:16:02.31,Main,,0,0,0,,...gemiyi bize vermeye ne dersin?!
Dialogue: 0,0:16:02.31,0:16:06.24,Main,,0,0,0,,Sonunda kaçtık! Denizci Karargâhı'na\Ngideceğimizi mi sanıyorsun?!
Dialogue: 0,0:16:06.24,0:16:09.85,Main,,0,0,0,,Kaptan Buggy bizden yana!
Dialogue: 0,0:16:09.85,0:16:11.99,Main,,0,0,0,,Sana güveniyoruz, Kaptan Buggy!
Dialogue: 0,0:16:13.23,0:16:14.25,Main,,0,0,0,,Buggy! Buggy!
Dialogue: 0,0:16:14.25,0:16:25.95,Secondary,,0,0,0,,{\an8}Buggy! Buggy!
Dialogue: 0,0:16:14.25,0:16:16.19,Main,,0,0,0,,Bu sorun olacak.
Dialogue: 0,0:16:17.69,0:16:20.09,Main,,0,0,0,,Hepsini öldürmemiz lazım.
Dialogue: 0,0:16:22.79,0:16:25.95,Main,,0,0,0,,Evet, bunu yapabileceğimi hissetmeye başlıyorum!
Dialogue: 0,0:16:25.95,0:16:39.46,Main,,0,0,0,,Buggy! Buggy!
Dialogue: 0,0:16:39.46,0:16:41.81,Main,,0,0,0,,Sessiz olun, sizi gösterişli ahmaklar!
Dialogue: 0,0:16:42.34,0:16:45.72,Main,,0,0,0,,Kendinizi duygularınıza kaptırıyorsunuz.
Dialogue: 0,0:16:45.72,0:16:48.03,Main,,0,0,0,,Bu gemi durmayacak!
Dialogue: 0,0:16:48.03,0:16:50.27,Main,,0,0,0,,Doğruca savaş alanına gidecek!
Dialogue: 0,0:16:50.27,0:16:53.68,Main,,0,0,0,,Hepimiz gemideyiz.
Dialogue: 0,0:16:53.68,0:16:55.68,Main,,0,0,0,,Bunu iyice düşünün!
Dialogue: 0,0:16:56.27,0:17:01.90,Main,,0,0,0,,Dünyanın en iyilerinin kendini\Ngöstereceği yere bir adım mesafedeyiz!
Dialogue: 0,0:17:01.90,0:17:05.39,Main,,0,0,0,,Hayatımız boyunca bir daha böyle şansımız olmayacak!
Dialogue: 0,0:17:06.36,0:17:10.30,Main,,0,0,0,,Gerçekten erkekseniz, benimle gelip\Nhayallerinizi gerçekleştirmeyecek misiniz?
Dialogue: 0,0:17:10.30,0:17:16.25,Main,,0,0,0,,Bugün... Beyazsakal'ın başını ve\Nonunla birlikte tüm dünyayı alacağım!
Dialogue: 0,0:17:16.25,0:17:18.92,Main,,0,0,0,,EVET! KAPTAN BUGGY!
Dialogue: 0,0:17:25.33,0:17:27.49,Main,,0,0,0,,Kaptan Buggy!
Dialogue: 0,0:17:28.72,0:17:32.00,Main,,0,0,0,,Cehennem'in en karanlık derinliklerine saplandık...
Dialogue: 0,0:17:32.00,0:17:36.53,Main,,0,0,0,,...ve bir noktada önemli bir şey yitirdik!
Dialogue: 0,0:17:36.53,0:17:40.94,Main,,0,0,0,,Eskiden ona sahiptik! "Hayaller" olarak bilinen ruhsal cevhere!
Dialogue: 0,0:17:40.94,0:17:43.62,Main,,0,0,0,,Peşinden geleceğim!
Dialogue: 0,0:17:43.62,0:17:45.86,Main,,0,0,0,,Zaten kimin barış içinde\Nyaşamaya ihtiyacı var ki?!
Dialogue: 0,0:17:47.89,0:17:51.27,Main,,0,0,0,,Kesinlikle! Gidelim beyler!
Dialogue: 0,0:17:51.27,0:17:53.62,Main,,0,0,0,,Denizci Karargâhı'na!
Dialogue: 0,0:17:56.54,0:18:12.75,Secondary,,0,0,0,,{\an8}Buggy! Buggy!
Dialogue: 0,0:17:56.54,0:17:58.56,Main,,0,0,0,,Görünüşe göre anlaşmaya vardılar.
Dialogue: 0,0:17:58.56,0:18:01.29,Main,,0,0,0,,En azından insanları ikna etme yeteneği var gibi.
Dialogue: 0,0:18:01.29,0:18:04.86,Main,,0,0,0,,Kaptan Buggy, sen dünyanın liderisin!
Dialogue: 0,0:18:04.86,0:18:07.47,Main,,0,0,0,,Peşinden her yere geleceğiz!
Dialogue: 0,0:18:08.75,0:18:10.87,Main,,0,0,0,,Beni takip edin!
Dialogue: 0,0:18:12.75,0:18:14.92,Main,,0,0,0,,Ne isterseniz yapın.
Dialogue: 0,0:18:21.45,0:18:24.92,Main,,0,0,0,,{\an8\i1}Denizci Karargâhı adası Marineford'da...{\i0}
Dialogue: 0,0:18:24.92,0:18:29.65,Main,,0,0,0,,{\an8\i1}...Denizci ailelerinin yaşadığı bir köy var.{\i0}
Dialogue: 0,0:18:37.73,0:18:42.92,Main,,0,0,0,,{\an8\i1}Tüm vatandaşların tahliye edilmesi emredildi.{\i0}
Dialogue: 0,0:18:47.33,0:18:55.05,Main,,0,0,0,,{\an8\i1}Sabaody Takımadası'ndaki yeni sığınaklarından vatandaşlar, ekranlar aracılığıyla hevesle idamı seyrediyor.{\i0}
Dialogue: 0,0:18:59.62,0:19:02.68,Main,,0,0,0,,{\an8\i1}Muhabirler ve kameramanlar,...{\i0}
Dialogue: 0,0:19:02.68,0:19:07.66,Main,,0,0,0,,{\an8\i1}...izlemek ve dünyanın kalanını bilgilendirmek için, dünyanın her yerinden geldiler. {\i0}
Dialogue: 0,0:19:08.91,0:19:12.69,Main,,0,0,0,,Denizci Karargâhı tüm gücünü bu işe ayırmış.
Dialogue: 0,0:19:12.69,0:19:16.15,Main,,0,0,0,,Elbette. Beyazsakal'ın da bundan haberi olduğuna eminim.
Dialogue: 0,0:19:16.80,0:19:19.67,Main,,0,0,0,,Peki gerçekten ortaya çıkacak mı?
Dialogue: 0,0:19:20.89,0:19:26.15,Main,,0,0,0,,{\an8\i1}Devriye için gönderilen tüm Denizci gemileri batırıldı.{\i0}
Dialogue: 0,0:19:26.82,0:19:29.73,Main,,0,0,0,,{\an8\i1}Kimse Beyazsakal'ın izine rastlamadı.{\i0}
Dialogue: 0,0:19:30.48,0:19:34.33,Main,,0,0,0,,{\an8\i1}Marineford'daki gerilim artmaya devam ediyor.{\i0}
Dialogue: 0,0:19:37.20,0:19:42.78,Main,,0,0,0,,{\an8\i1}İdama üç saatten az bir süre kaldı.{\i0}
Dialogue: 0,0:20:10.05,0:20:11.14,Main,,0,0,0,,Çık.
Dialogue: 0,0:20:32.92,0:20:35.21,Flashbacks,,0,0,0,,Dinle, Luffy!
Dialogue: 0,0:20:35.91,0:20:40.69,Flashbacks,,0,0,0,,Kesinlikle hayatı pişmanlık duymadan yaşayacağız!
Dialogue: 0,0:20:40.69,0:20:42.22,Flashbacks,,0,0,0,,Evet!
Dialogue: 0,0:21:05.12,0:21:07.65,Flashbacks,,0,0,0,,Bir gün denize açılacağız...
Dialogue: 0,0:21:07.65,0:21:09.85,Flashbacks,,0,0,0,,...ve hayatı istediğimiz şekilde yaşayacağız!
Dialogue: 0,0:21:12.91,0:21:14.71,Flashbacks,,0,0,0,,Herkesten daha fazla özgürce!
Dialogue: 0,0:21:35.38,0:21:39.78,Captions,,0,0,0,,{\fad(900,0)\fs50\pos(640,545)}South Blue (Güney Mavi)
Dialogue: 0,0:21:40.95,0:21:44.81,Main,,0,0,0,,Üç saat kaldı. Acaba Beyazsakal'ın kendisi ortaya çıkacak mı?
Dialogue: 0,0:21:44.81,0:21:48.02,Main,,0,0,0,,Kim bilir... Ortaya çıkacağına emin misin?
Dialogue: 0,0:21:48.27,0:21:51.32,Main,,0,0,0,,Bahsettiğimiz kişi Beyazsakal olsa bile, şimdiye kadar epey yaşlanmıştır, değil mi?
Dialogue: 0,0:21:52.51,0:21:54.29,Main,,0,0,0,,Öyle mi dersin?
Dialogue: 0,0:21:54.29,0:21:57.63,Main,,0,0,0,,Büyük Korsan Çağından önce kalma antikanın biri.
Dialogue: 0,0:21:57.63,0:21:59.92,Main,,0,0,0,,Muhtemelen şimdiye dek bunamıştır.
Dialogue: 0,0:21:59.92,0:22:03.63,Main,,0,0,0,,Son birkaç yıldır sesi soluğu çıkmadı.
Dialogue: 0,0:22:04.66,0:22:09.71,Captions,,0,0,0,,{\fad(900,0)\fs50\pos(640,545)}East Blue (Doğu Mavi)
Dialogue: 0,0:22:10.42,0:22:13.13,Main,,0,0,0,,Asırlardır gündemde oldu.
Dialogue: 0,0:22:13.85,0:22:17.18,Main,,0,0,0,,Denizci Karargâhı'nın yenileceğini gerçekten düşünüyor musun?
Dialogue: 0,0:22:17.18,0:22:21.81,Main,,0,0,0,,Kim kazanırsa kazansın, ağır kayıplar olacak.
Dialogue: 0,0:22:25.29,0:22:31.93,Main,,0,0,0,,Ortaya çıkmaması en iyisi olurdu. Olabilecek en iyi şey, olaysız geçen başarılı bir idam.
Dialogue: 0,0:22:32.65,0:22:35.83,Captions,,0,0,0,,{\fad(900,0)\fs50\pos(640,545)}North Blue (Kuzey Mavi)
Dialogue: 0,0:22:38.73,0:22:42.14,Main,,0,0,0,,Hey! Hey! Biraz içki istiyorum! Yaşlı adam!
Dialogue: 0,0:22:42.14,0:22:44.85,Main,,0,0,0,,Böyle bir günde meyhaneyi çalıştırır mıyım sanıyorsun?!
Dialogue: 0,0:22:44.85,0:22:47.79,Main,,0,0,0,,Savaş patlak verebilir!
Dialogue: 0,0:22:47.79,0:22:51.58,Main,,0,0,0,,Evinize gidin! Yarın dünya hala\Nyerinde durursa, barı açacağım!
Dialogue: 0,0:22:51.58,0:22:53.98,Main,,0,0,0,,O zaman bana biraz içki sat!
Dialogue: 0,0:22:53.98,0:22:57.39,Main,,0,0,0,,Sanki idamla yüzleşecek olan biz gibiyiz!
Dialogue: 0,0:22:57.39,0:23:00.17,Main,,0,0,0,,Buna dayanmak için içmemiz lazım!
Dialogue: 0,0:23:02.84,0:23:06.50,Captions,,0,0,0,,{\fad(900,0)\fs50\pos(640,545)}West Blue (Batı Mavi)
Dialogue: 0,0:23:01.39,0:23:06.50,Main,,0,0,0,,{\an8}Onu sadece yaşlı adamın teki olarak\Ndüşünmeyin. Her zamanki gibi güçlü.
Dialogue: 0,0:23:06.50,0:23:13.87,Main,,0,0,0,,Onu bir yıl önce gördük, şurada oturuyordu...
Dialogue: 0,0:23:19.23,0:23:21.11,Main,,0,0,0,,...ve hepimiz kendi canlarımızdan umudu kestik.
Dialogue: 0,0:23:21.86,0:23:25.78,Captions,,0,0,0,,{\fad(900,0)\fs50\pos(640,545)}Grand Line
Dialogue: 0,0:23:22.44,0:23:25.78,Main,,0,0,0,,{\an8}Beyazsakal gerçekten o kadar korkunç bir korsan mı?
Dialogue: 0,0:23:26.75,0:23:28.70,Main,,0,0,0,,Şu çocuklar bile biliyor.
Dialogue: 0,0:23:28.70,0:23:30.62,Main,,0,0,0,,İp atlarken onunla ilgili şarkı söylüyorlar.
Dialogue: 0,0:23:30.62,0:23:35.49,Main,,0,0,0,,♪ Korsan Beyazsakal, Şeytan'dan daha korkutucu! ♪
Dialogue: 0,0:23:36.01,0:23:37.85,Main,,0,0,0,,Ey büyük Tanrı'm,...
Dialogue: 0,0:23:38.50,0:23:42.87,Main,,0,0,0,,...dünya nereye gidiyor?
Dialogue: 0,0:23:51.74,0:23:55.45,Captions,,0,0,0,,{\fad(900,0)\fs45\pos(640,535)}Marineford\NDenizci Karargâhı, Grand Line
Dialogue: 0,0:24:01.22,0:24:02.81,Main,,0,0,0,,Hemen hazırlanın!
Dialogue: 0,0:24:02.81,0:24:04.46,Main,,0,0,0,,Sen! Çek şunu!
Dialogue: 0,0:24:13.23,0:24:15.48,Main,,0,0,0,,Korkmayın!
Dialogue: 0,0:24:15.48,0:24:18.44,Main,,0,0,0,,Ne olursa olsun, sadece üç saat kaldı.
Dialogue: 0,0:24:19.80,0:24:22.14,Main,,0,0,0,,Sonra her şey bitecek!
Dialogue: 0,0:24:27.78,0:24:34.02,Main,,0,0,0,,{\an8}{\i1}Toplamda, dünyanın her yerinden\N100 binden fazla Denizci toplandı.{\i0}
Dialogue: 0,0:24:36.16,0:24:41.56,Main,,0,0,0,,{\an8\i1}Elli savaş gemisi, hilal şeklindeki koyu çevreliyor...{\i0}
Dialogue: 0,0:24:42.04,0:24:45.96,Main,,0,0,0,,{\an8\i1}...ve koyun içinde sayısız top hazır bekliyor.{\i0}
Dialogue: 0,0:24:47.12,0:24:51.34,Main,,0,0,0,,{\an8\i1}Bu savaşın sonucunu belirleyecek beş kişi,...{\i0}
Dialogue: 0,0:24:54.06,0:24:57.20,Main,,0,0,0,,{\an8\i1}...yani Denizin Yedi Savaş Lordu üyeleri de dahil olmak üzere...{\i0}
Dialogue: 0,0:24:57.20,0:24:59.78,Main,,0,0,0,,{\an8\i1}...birliklerin ön sırası limandan görülebiliyor.{\i0}
Dialogue: 0,0:25:00.59,0:25:06.95,Main,,0,0,0,,{\an8\i1}İdam sehpasının aşağısında, Denizci Karargâhı'nın\Nen kuvvetli dövüş gücü nöbet tutuyor.{\i0}
Dialogue: 0,0:25:07.34,0:25:10.59,Main,,0,0,0,,{\an8}{\i1}Üç Denizci Amirali!{\i0} {.}
Dialogue: 0,0:25:14.48,0:25:17.48,Captions,,0,0,0,,{\fad(900,0)\fs50\pos(640,480)}Denizci Amirali Aokiji (Kuzan)
Dialogue: 0,0:25:18.95,0:25:21.92,Captions,,0,0,0,,{\fad(900,0)\fs50\pos(640,480)}Denizci Amirali Akainu (Sakazuki)
Dialogue: 0,0:25:23.33,0:25:26.30,Captions,,0,0,0,,{\fad(900,0)\fs50\pos(640,480)}Denizci Amirali Kizaru (Borsalino)
Dialogue: 0,0:25:29.96,0:25:31.21,Main,,0,0,0,,{\an8}{\i1}Şu anda...{\i0} {.}
Dialogue: 0,0:25:31.21,0:25:34.47,Main,,0,0,0,,{\an8}{\i1}...dünyanın tüm adalet güçleri,...{\i0} {.}
Dialogue: 0,0:25:34.47,0:25:37.10,Main,,0,0,0,,{\an8}{\i1}...Beyazsakal Korsanları'nın Ace'i...{\i0} {.}
Dialogue: 0,0:25:37.10,0:25:40.41,Main,,0,0,0,,{\an8}{\i1}...kurtarmasını engellemek için bekliyor.{\i0} {.}
Dialogue: 0,0:25:58.44,0:26:00.06,Main,,0,0,0,,Görüyorum!
Dialogue: 0,0:26:00.06,0:26:02.87,Main,,0,0,0,,Hey! Jinbei!
Dialogue: 0,0:26:02.87,0:26:06.07,Main,,0,0,0,,Adalet Kapısı'nı görebiliyorum!
Dialogue: 0,0:26:06.07,0:26:07.41,Main,,0,0,0,,Çok hızlı oldu!
Dialogue: 0,0:26:07.41,0:26:09.40,Main,,0,0,0,,Hayır, aslında epey geciktik!
Dialogue: 0,0:26:09.40,0:26:12.48,Main,,0,0,0,,Rüzgâr daha uygun olsaydı, daha erken gelebilirdik!
Dialogue: 0,0:26:14.14,0:26:17.69,Main,,0,0,0,,Peki o kapıdan nasıl geçeceğiz?
Dialogue: 0,0:26:18.22,0:26:21.49,Main,,0,0,0,,Beyler! Neredeyse zamanı geldi!
Dialogue: 0,0:26:22.27,0:26:24.03,Main,,0,0,0,,Neyin zamanı?
Dialogue: 0,0:26:24.03,0:26:27.48,Main,,0,0,0,,KAPTAN BUGGY'NİN DÜNYAYA HÜKMETME ZAMANI!
Dialogue: 0,0:26:28.40,0:26:29.93,Main,,0,0,0,,Kesinlikle yoldaşlarım!
Dialogue: 0,0:26:29.93,0:26:32.80,Main,,0,0,0,,Denizci Karargâhı kimin umrunda?!
Dialogue: 0,0:26:43.48,0:26:46.85,Main,,0,0,0,,Hey, bakın! İşte Ateş Yumruk Ace!
Dialogue: 0,0:26:50.15,0:26:57.53,Main,,0,0,0,,O... dünyayı değiştirecek bir savaşa neden olabilecek bir adam.
Dialogue: 0,0:27:01.13,0:27:06.54,Main,,0,0,0,,Dünyanın kaderini de ellerinde tutuyor!
Dialogue: 0,0:27:33.20,0:27:36.51,Main,,0,0,0,,Bir duyuru yapacağım. Sana uyar mı, Garp?
Dialogue: 0,0:27:36.51,0:27:39.94,Main,,0,0,0,,Ne istersen yap. Orada olacağım.
Dialogue: 0,0:27:46.10,0:27:47.46,Main,,0,0,0,,Bize biraz yer açın.
Dialogue: 0,0:27:47.46,0:27:48.38,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:27:49.05,0:27:50.97,Main,,0,0,0,,Filo Amirali Sengoku!
Dialogue: 0,0:27:50.97,0:27:52.05,Main,,0,0,0,,Ne?
Dialogue: 0,0:27:52.05,0:27:53.72,Main,,0,0,0,,Bana Den Den Mushi verin.
Dialogue: 0,0:28:03.24,0:28:06.43,Main,,0,0,0,,Hepinize bir duyurum var.
Dialogue: 0,0:28:11.13,0:28:13.18,Main,,0,0,0,,Portgas D. Ace...
Dialogue: 0,0:28:13.18,0:28:18.04,Main,,0,0,0,,Bugün bu adamın ölümü büyük önem arz ediyor.
Dialogue: 0,0:28:19.71,0:28:22.02,Main,,0,0,0,,Sen yanlış bir şey yapmadın.
Dialogue: 0,0:28:24.60,0:28:28.24,Main,,0,0,0,,Kadınların böyle zamanlarda anlayışlı olması gerekir, Tsuru-chan.
Dialogue: 0,0:28:28.62,0:28:32.62,Main,,0,0,0,,Ace. Bana babanın adını söyle!
Dialogue: 0,0:28:37.02,0:28:38.01,Main,,0,0,0,,Babası mı?
Dialogue: 0,0:28:38.01,0:28:39.83,Main,,0,0,0,,Bu da ne demek oluyor?
Dialogue: 0,0:28:42.80,0:28:44.64,Main,,0,0,0,,Babam Beyazsakal'dır.
Dialogue: 0,0:28:44.64,0:28:45.67,Main,,0,0,0,,Yanlış!
Dialogue: 0,0:28:45.67,0:28:49.84,Main,,0,0,0,,O! Babam Beyazsakal! Başka babam yok!
Dialogue: 0,0:28:50.66,0:28:55.45,Main,,0,0,0,,Yıllar önce, tüm kaynaklarımızı bir adamı aramak için kullandık.
Dialogue: 0,0:28:55.45,0:28:59.83,Main,,0,0,0,,Malum bir adada çocuğu olduğundan şüphelendik.
Dialogue: 0,0:28:59.83,0:29:05.23,Main,,0,0,0,,Tümüyle bu olasılığa ve Cipher Pol'ün şüpheli bilgisine bel bağladık.
Dialogue: 0,0:29:05.23,0:29:07.80,Main,,0,0,0,,Yeni doğmuş çocuklar...
Dialogue: 0,0:29:08.31,0:29:10.76,Main,,0,0,0,,Doğmak üzere olan çocuklar...
Dialogue: 0,0:29:10.76,0:29:16.23,Main,,0,0,0,,Tüm anneleri iyiden iyiye araştırdık, ama onu bulamadık.
Dialogue: 0,0:29:17.04,0:29:18.81,Main,,0,0,0,,Ama sanırım bu beklendik bir şeydi.
Dialogue: 0,0:29:18.81,0:29:23.02,Main,,0,0,0,,Annen seni güvenle doğurmak için canını tehlikeye attı.
Dialogue: 0,0:29:23.02,0:29:26.71,Main,,0,0,0,,Tamamen irade gücüyle özel bir numara yaptı.
Dialogue: 0,0:29:31.20,0:29:38.03,Main,,0,0,0,,Gözümüzü boyadı... Hayır, tüm dünyanın gözünü boyadı!
Dialogue: 0,0:29:38.03,0:29:41.66,Main,,0,0,0,,Güney Mavi'de Baterilla adında bir ada var.
Dialogue: 0,0:29:42.88,0:29:47.90,Main,,0,0,0,,Annenin adı Portgas D. Rouge.
Dialogue: 0,0:29:48.40,0:29:54.84,Main,,0,0,0,,Çocuğunu korumak için, sırf irade gücüyle sağduyuya karşı koydu.
Dialogue: 0,0:29:54.84,0:29:59.71,Main,,0,0,0,,Yirmi ay boyunca çocuğunu karnında taşıdı.
Dialogue: 0,0:30:02.11,0:30:04.11,Main,,0,0,0,,Ne diyor bu?
Dialogue: 0,0:30:04.11,0:30:10.29,Main,,0,0,0,,Tüm gücünü kullandı ve seni doğurur doğurmaz öldü.
Dialogue: 0,0:30:13.78,0:30:17.19,Main,,0,0,0,,Babasının ölümünden bir yıl üç ay sonra...
Dialogue: 0,0:30:17.19,0:30:22.25,Main,,0,0,0,,...dünyadaki en kötü adamın kanını taşıyan bir çocuk doğmuştu.
Dialogue: 0,0:30:25.66,0:30:27.37,Main,,0,0,0,,O çocuk sendin!
Dialogue: 0,0:30:30.34,0:30:33.18,Main,,0,0,0,,Çoktan bildiğine eminim...
Dialogue: 0,0:30:40.85,0:30:44.32,Flashbacks,,0,0,0,,Yeni doğmuş bir çocuk günahsızdır.
Dialogue: 0,0:30:44.89,0:30:46.73,Flashbacks,,0,0,0,,Garp.
Dialogue: 0,0:30:47.48,0:30:49.53,Flashbacks,,0,0,0,,Çocuğuma iyi bak.
Dialogue: 0,0:30:51.96,0:30:54.80,Main,,0,0,0,,Senin baban...
Dialogue: 0,0:30:57.68,0:31:02.34,Main,,0,0,0,,...Korsanlar Kralı Gold Roger!
Dialogue: 0,0:00:25.37,0:00:30.62,OP13-Translation,,0,0,0,karaoke,{\i1}♪ Her seferinde yağmurdan sonra gökyüzüne bakıyorum. ♪{\i0}
Dialogue: 0,0:00:30.62,0:00:36.13,OP13-Translation,,0,0,0,karaoke,{\i1}♪ Henüz sulugöz olduğum zamanları düşünüyorum. ♪{\i0}
Dialogue: 0,0:00:36.13,0:00:43.87,OP13-Translation,,0,0,0,karaoke,{\i1}♪ Umutsuzca birinin arkasından koşuyorum,... ♪{\i0}
Dialogue: 0,0:00:43.94,0:00:46.85,OP13-Translation,,0,0,0,karaoke,{\i1}♪ ..."Daha güçlü olmak istiyorum," diye düşünerek. ♪{\i0}
Dialogue: 0,0:00:46.85,0:00:52.03,OP13-Translation,,0,0,0,karaoke,{\i1}♪ "Teşekkürüm" şimdi rüzgârda kayboldu,... ♪{\i0}
Dialogue: 0,0:00:52.20,0:00:57.21,OP13-Translation,,0,0,0,karaoke,{\i1}♪ ...daha güçlü olabilir miyim? ♪{\i0}
Dialogue: 0,0:00:57.41,0:01:02.88,OP13-Translation,,0,0,0,karaoke,{\i1}♪ Cevabımı bulamıyorum. ♪{\i0}
Dialogue: 0,0:01:03.01,0:01:08.40,OP13-Translation,,0,0,0,karaoke,{\i1}♪ Bu yüzden ilerlemeye devam edeceğim. ♪{\i0}
Dialogue: 0,0:01:08.55,0:01:11.03,OP13-Translation,,0,0,0,karaoke,{\i1}♪ Gel hadi, gidelim. ♪{\i0}
Dialogue: 0,0:01:11.03,0:01:14.24,OP13-Translation,,0,0,0,karaoke,{\i1}♪ Asla pes etmeyeceğiz. ♪{\i0}
Dialogue: 0,0:01:14.24,0:01:19.48,OP13-Translation,,0,0,0,karaoke,{\i1}♪ Zamanın dalgalarına yenik düşmeyeceğiz. ♪{\i0}
Dialogue: 0,0:01:19.48,0:01:25.09,OP13-Translation,,0,0,0,karaoke,{\i1}♪ Tekrar tekrar ayağa kalkacağız. ♪{\i0}
Dialogue: 0,0:01:25.10,0:01:30.73,OP13-Translation,,0,0,0,karaoke,{\i1}♪ Çünkü bizim için önemli olanı kaybetmek istemiyoruz. ♪{\i0}
Dialogue: 0,0:01:30.74,0:01:35.85,OP13-Translation,,0,0,0,karaoke,{\i1}♪ Beni sürekli, sürekli ilerlemeye zorlayan... ♪{\i0}
Dialogue: 0,0:01:35.86,0:01:41.25,OP13-Translation,,0,0,0,karaoke,{\i1}♪ ...kafamdaki sesi duyabiliyorum. ♪{\i0}
Dialogue: 0,0:01:41.25,0:01:46.38,OP13-Translation,,0,0,0,karaoke,{\i1}♪ Haylaz yağmur bana engel olurken bile... ♪{\i0}
Dialogue: 0,0:01:46.39,0:01:51.32,OP13-Translation,,0,0,0,karaoke,{\i1}♪ ...kaçmaya çalışmayacağım. ♪{\i0}
Dialogue: 0,0:01:54.42,0:01:56.78,OP13-Translation,,0,0,0,karaoke,{\i1}♪ Gel hadi, gidelim. ♪{\i0}
Dialogue: 0,0:01:56.78,0:02:00.06,OP13-Translation,,0,0,0,karaoke,{\i1}♪ Asla pes etmeyeceğiz. ♪{\i0}
Dialogue: 0,0:02:00.06,0:02:05.35,OP13-Translation,,0,0,0,karaoke,{\i1}♪ Zamanın dalgalarına yenik düşmeyeceğiz. ♪{\i0}
Dialogue: 0,0:02:05.36,0:02:10.99,OP13-Translation,,0,0,0,karaoke,{\i1}♪ Tekrar tekrar ayağa kalkacağız. ♪{\i0}
Dialogue: 0,0:02:10.99,0:02:16.35,OP13-Translation,,0,0,0,karaoke,{\i1}♪ Çünkü bizim için önemli olanı kaybetmek istemiyoruz. ♪{\i0}
Dialogue: 0,0:02:16.36,0:02:22.05,OP13-Translation,,0,0,0,karaoke,{\i1}♪ İnandığımız geleceğe doğru ilerleyelim. ♪{\i0}
