00000000,0,0,0,0,100,100,0,0,1,2,0,8,10,10,80,1Style: OP13-Karaoke,Duality,60,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,8,10,10,10,1Style: OP13-Translation,Duality,45.0,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,2,10,10,18,1Style: OP13-Kanji,Duality,60,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,8,10,10,110,1Style: OP13-Credits,FOT-Greco Std B,40,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,95,100,1,0,1,2.2,0,1,80,10,100,1Style: Pekoms - Infobox,Roboto,39,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,2,2,2,10,10,10,1Style: Map,Roboto,39,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,2,2,2,10,10,10,1Style: Author,Impress BT,25,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1,1,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:02:31.20,0:02:41.20,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazaskerDialogue: 0,0:14:14.00,0:14:24.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazaskerDialogue: 0,0:26:12.00,0:26:22.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazaskerDialogue: 0,0:02:31.20,0:02:38.15,Title,,0,0,230,,Yeni Bir Çağa HediyeDialogue: 0,0:02:41.07,0:02:43.68,Narrator,,0,0,0,,Haberler hızla tüm düyaya yayılıyor.Dialogue: 0,0:02:43.68,0:02:47.98,Narrator,,0,0,0,,Beyazsakal Korsanları'nın, Roger'ın oğlu Ace'i kurtarma girişimi başarısız oldu.Dialogue: 0,0:02:47.98,0:02:52.37,Narrator,,0,0,0,,Efsanevi kaptanları Beyazsakal ise öldü.Dialogue: 0,0:02:52.37,0:02:55.42,Main,,0,0,0,,Ekstra baskı hazırlıyoruz! İşe koyulun!Dialogue: 0,0:02:55.42,0:02:57.56,Main,,0,0,0,,Bu acil bir duyurudur!Dialogue: 0,0:02:57.56,0:03:01.83,Main,,0,0,0,,Ateş Yumruk Ace'in ardından, Beyazsakal'ın ölümünü de teyit ettik!Dialogue: 0,0:03:01.83,0:03:03.54,Main,,0,0,0,,Tekrar ediyorum:...Dialogue: 0,0:03:03.54,0:03:05.43,Main,,0,0,0,,...Marineford'da Beyazsakal...Dialogue: 0,0:03:03.96,0:03:05.43,Secondary,,0,0,0,,Beyazsakal...Dialogue: 0,0:03:05.43,0:03:07.03,Main,,0,0,0,,...öldü!Dialogue: 0,0:03:07.03,0:03:10.37,Main,,0,0,0,,Beyazsakal Korsanlarının da işi bitti!Dialogue: 0,0:03:10.37,0:03:12.18,Main,,0,0,0,,Artık savaş bitti!Dialogue: 0,0:03:12.18,0:03:14.27,Main,,0,0,0,,Nihayet huzur içinde yaşayabiliriz!Dialogue: 0,0:03:15.29,0:03:21.21,Narrator,,0,0,0,,Asırlar boyunca konuşulacak bu tarihi olaya tanıklık eden insanlar...Dialogue: 0,0:03:21.21,0:03:26.39,Narrator,,0,0,0,,...şu anda tek bir kelime edemiyorlar.Dialogue: 0,0:03:33.37,0:03:36.09,Main,,0,0,0,,Demek artık göçtün, Beyazsakal.Dialogue: 0,0:03:39.52,0:03:42.58,Narrator,,0,0,0,,72 yaşında öldü...Dialogue: 0,0:03:42.58,0:03:46.54,Narrator,,0,0,0,,Bir zamanlar okyanuslarda Korsanlar Kralı'na rakip olan adam,....Dialogue: 0,0:03:46.54,0:03:49.16,Narrator,,0,0,0,,...Beyazsakal Korsanları'nın kaptanı,...Dialogue: 0,0:03:49.16,0:03:52.03,Narrator,,0,0,0,,...büyük korsan Edward Newgate...Dialogue: 0,0:03:52.03,0:03:54.66,Narrator,,0,0,0,,...Beyazsakal olarak da bilinir.Dialogue: 0,0:03:54.66,0:03:59.63,Narrator,,0,0,0,,Marineford Koyu'ndaki, Denizin Yedi Savaş Lordu tarafından...Dialogue: 0,0:03:59.63,0:04:06.55,Narrator,,0,0,0,,...desteklenen Denizci Karargâhı ile Beyazsakal Korsanları arasında gerçekleşen şiddetli savaş sırasında öldü.Dialogue: 0,0:04:13.80,0:04:15.72,Narrator,,0,0,0,,Lanet olası pislik.Dialogue: 0,0:04:15.72,0:04:19.64,Main,,0,0,0,,Marco. Hepimiz aynı şeyleri hissediyoruz,...Dialogue: 0,0:04:19.64,0:04:22.29,Main,,0,0,0,,...ama geri çekilmeliyiz!Dialogue: 0,0:04:22.29,0:04:24.59,Main,,0,0,0,,Biliyorum, Vista.Dialogue: 0,0:04:26.17,0:04:28.43,Main,,0,0,0,,Sallanmayın! Gemiye binin!Dialogue: 0,0:04:28.43,0:04:30.98,Main,,0,0,0,,Kaptanımızın son emrini unuttunuz mu?!Dialogue: 0,0:04:32.14,0:04:35.26,Main,,0,0,0,,Jinbe! Hemen Ace'in kardeşini güvenli bir yere götür!Dialogue: 0,0:04:35.26,0:04:36.44,Main,,0,0,0,,Tamam!Dialogue: 0,0:04:39.36,0:04:42.06,Main,,0,0,0,,Israrcı pisliğin tekiydi.Dialogue: 0,0:04:42.06,0:04:43.63,Main,,0,0,0,,Demek sonunda nalları dikti.Dialogue: 0,0:04:43.63,0:04:46.81,Main,,0,0,0,,Şu ana dek her şey plana göre gitti.Dialogue: 0,0:04:46.81,0:04:48.31,Main,,0,0,0,,Pekâlâ Kaptan.Dialogue: 0,0:04:49.27,0:04:53.70,Main,,0,0,0,,Şimdi başlama zamanı!Dialogue: 0,0:05:00.20,0:05:02.35,Main,,0,0,0,,Yine bir şey peşindeler!Dialogue: 0,0:05:02.35,0:05:03.45,Main,,0,0,0,,Lanet olası Teach!Dialogue: 0,0:05:03.45,0:05:05.28,Main,,0,0,0,,Babalık'la ne yapmayı planlıyor?!Dialogue: 0,0:05:08.75,0:05:10.72,Main,,0,0,0,,Şimdi size, tüm dünyayı...Dialogue: 0,0:05:11.72,0:05:16.49,Main,,0,0,0,,...hayrete düşürecek en müthiş gösteriyi sunmak üzereyim.Dialogue: 0,0:05:16.49,0:05:18.94,Main,,0,0,0,,O siyah perde de neyin nesi?!Dialogue: 0,0:05:18.94,0:05:21.77,Main,,0,0,0,,Karasakal ve ölen Beyazsakal içinde!Dialogue: 0,0:05:22.79,0:05:26.40,Main,,0,0,0,,Pekâlâ... Şimdilik giriş yasak.Dialogue: 0,0:05:26.40,0:05:28.87,Main,,0,0,0,,Ne yapmaya çalışıyorsunuz?!Dialogue: 0,0:05:28.87,0:05:32.21,Main,,0,0,0,,O adam, Denizin Yedi Savaş Lordu'na katılmış gibi davrandıktan sonra bize ihanet etti.Dialogue: 0,0:05:32.21,0:05:33.35,Main,,0,0,0,,Tedbiri elden bırakmayın!Dialogue: 0,0:05:35.51,0:05:37.12,Main,,0,0,0,,Bunu dört gözle bekliyorum.Dialogue: 0,0:05:37.12,0:05:40.52,Main,,0,0,0,,Başarısız olursa, sanırım dağılmak zorunda kalacağız.Dialogue: 0,0:05:56.57,0:05:58.87,Main,,0,0,0,,Kaptan Buggy, ne yapıyorsun?!Dialogue: 0,0:05:58.87,0:06:02.52,Main,,0,0,0,,Nesin sen, geri zekalı mı?! Tabii ki kaçıyorum!Dialogue: 0,0:06:02.52,0:06:05.24,Main,,0,0,0,,Artık Beyazsakal'ın başını alabilmem mümkün değil, değil mi?Dialogue: 0,0:06:05.25,0:06:07.38,Main,,0,0,0,,Kaptan Buggy...Dialogue: 0,0:06:07.38,0:06:09.00,Thoughts,,0,0,0,,Başaramadım!Dialogue: 0,0:06:09.00,0:06:11.72,Thoughts,,0,0,0,,Çok korkmuştum ve ona yaklaşamadım bile!Dialogue: 0,0:06:11.72,0:06:12.60,Thoughts,,0,0,0,,Korktum!Dialogue: 0,0:06:12.60,0:06:17.59,Thoughts,,0,0,0,,Beyazsakal. Hayatının baharındayken korkunçtu ve ölüyken hala çok korkunç!Dialogue: 0,0:06:19.06,0:06:21.39,Main,,0,0,0,,İsterseniz zavallı olduğumu düşünün!Dialogue: 0,0:06:21.39,0:06:25.33,Main,,0,0,0,,Burada yollarımız ayrılıyor, embesiller!Dialogue: 0,0:06:26.67,0:06:27.87,Main,,0,0,0,,Kaptan Buggy!Dialogue: 0,0:06:27.87,0:06:30.59,Main,,0,0,0,,Ağlıyor... Kaptan Buggy!Dialogue: 0,0:06:30.59,0:06:33.17,Main,,0,0,0,,Anladım. Dünün düşmanları, bugünün arkadaşları!Dialogue: 0,0:06:33.17,0:06:38.70,Main,,0,0,0,,Bir noktada, rakibin olan Beyazsakal için sempati duydun.Dialogue: 0,0:06:38.70,0:06:41.33,Main,,0,0,0,,Hem de onun başını alacak olmana rağmen!Dialogue: 0,0:06:41.41,0:06:44.82,Main,,0,0,0,,Yine de hiç mazeret uydurmaya çalışmadan gidiyorsun!Dialogue: 0,0:06:45.60,0:06:47.08,Main,,0,0,0,,Sen gerçekten...Dialogue: 0,0:06:47.08,0:06:52.04,Main,,0,0,0,,...hep düşündüğümüz gibi adam gibi adamsın!Dialogue: 0,0:06:52.04,0:06:54.36,Main,,0,0,0,,Çok müthişsin, Kaptan Buggy!Dialogue: 0,0:06:54.36,0:06:56.37,Main,,0,0,0,,Lütfen bekle, Kaptan Buggy!Dialogue: 0,0:06:56.37,0:06:57.60,Main,,0,0,0,,Bizi de yanında götür!Dialogue: 0,0:06:57.60,0:06:59.50,Main,,0,0,0,,Kaptan!Dialogue: 0,0:07:03.59,0:07:06.40,Main,,0,0,0,,Hemen denize!Dialogue: 0,0:07:07.49,0:07:09.31,Main,,0,0,0,,Luffy-kun...Dialogue: 0,0:07:09.31,0:07:12.42,Main,,0,0,0,,Dayan, hayatta kalmalısın.Dialogue: 0,0:07:12.42,0:07:15.48,Main,,0,0,0,,Ace-san'ın çoktan terkettiği bu dünyada...Dialogue: 0,0:07:15.48,0:07:17.98,Main,,0,0,0,,...yarına ve ondan sonrasına...Dialogue: 0,0:07:18.95,0:07:19.88,Main,,0,0,0,,Ateş!Dialogue: 0,0:07:21.05,0:07:25.36,Main,,0,0,0,,...kesinlikle hayatta kalmalısın!Dialogue: 0,0:07:25.94,0:07:29.79,Flashbacks,,0,0,0,,Jinbe, bu şekilde ölürsem...Dialogue: 0,0:07:31.84,0:07:36.23,Flashbacks,,0,0,0,,Bunu istemekten nefret ediyorum, ama kardeşimle ilgilen.Dialogue: 0,0:07:39.47,0:07:42.40,Flashbacks,,0,0,0,,Bu isteği reddetmek zorunda kalabilirim, Ace-san.Dialogue: 0,0:07:42.41,0:07:44.45,Flashbacks,,0,0,0,,Beni gözünde büyütmemelisin.Dialogue: 0,0:07:44.45,0:07:47.52,Flashbacks,,0,0,0,,O kadar iyi kalpli değilim.Dialogue: 0,0:07:47.52,0:07:51.91,Flashbacks,,0,0,0,,O senin kardeşin olabilir, ama korsanlar dünyasında...Dialogue: 0,0:07:51.91,0:07:57.35,Flashbacks,,0,0,0,,...takdir etmediğim hiç kimseye ne yardım ederim ne de onu korurum.Dialogue: 0,0:07:57.35,0:07:59.49,Main,,0,0,0,,Jinbe! Gemiye çık!Dialogue: 0,0:07:59.49,0:08:00.39,Main,,0,0,0,,Tamam!Dialogue: 0,0:08:01.79,0:08:02.49,Main,,0,0,0,,Bu...Dialogue: 0,0:08:06.63,0:08:09.15,Main,,0,0,0,,Kahretsin. Okyanus donmuş!Dialogue: 0,0:08:09.15,0:08:10.60,Main,,0,0,0,,Denize açılamayız!Dialogue: 0,0:08:10.60,0:08:12.64,Main,,0,0,0,,Hemen bir şey yapın!Dialogue: 0,0:08:12.64,0:08:14.47,Main,,0,0,0,,Bu Amiral Aokiji!Dialogue: 0,0:08:14.47,0:08:16.77,Main,,0,0,0,,Aokiji'yi tutun!Dialogue: 0,0:08:19.31,0:08:21.98,Main,,0,0,0,,Başka çaremiz yok. Başka bir gemi almalıyız!Dialogue: 0,0:08:31.82,0:08:34.53,Main,,0,0,0,,Onun kaçmasına izin vermeyeceğim demiştim.Dialogue: 0,0:08:34.53,0:08:38.23,Main,,0,0,0,,Niye hayattan vazgeçmiyorsun artık, embesil?!Dialogue: 0,0:08:46.71,0:08:50.71,Main,,0,0,0,,Dragon'un oğlunu bana ver!Dialogue: 0,0:08:50.71,0:08:53.80,Main,,0,0,0,,Akainu ölmemiş mi?!Dialogue: 0,0:08:53.80,0:08:55.86,Main,,0,0,0,,Babalık'ın onun işini bitirdiğini düşünmüştüm!Dialogue: 0,0:08:55.86,0:08:57.34,Main,,0,0,0,,Magmasıyla yol açarak...Dialogue: 0,0:08:57.34,0:08:59.24,Main,,0,0,0,,...yerin altından gelmiş!Dialogue: 0,0:08:59.24,0:09:01.02,Main,,0,0,0,,Jinbe!Dialogue: 0,0:09:01.02,0:09:03.69,Main,,0,0,0,,Bu emre itaat edemem!Dialogue: 0,0:09:03.69,0:09:09.46,Main,,0,0,0,,Hayatım pahasına bile olsa çoktan bu adamı korumaya karar verdim!Dialogue: 0,0:09:09.46,0:09:13.33,Main,,0,0,0,,O zaman bir daha istemeyeceğim.Dialogue: 0,0:09:19.24,0:09:21.79,Main,,0,0,0,,Ace'in kardeşini koruyun!Dialogue: 0,0:09:21.79,0:09:24.28,Main,,0,0,0,,Evet! Ace'in ailesi bizim ailemizdir!Dialogue: 0,0:09:24.28,0:09:27.68,Main,,0,0,0,,Çekilin yolumdan, korkaklar!Dialogue: 0,0:09:27.68,0:09:29.46,Main,,0,0,0,,Kenara çekil, Jinbe!Dialogue: 0,0:09:29.46,0:09:33.00,Main,,0,0,0,,Emporio Yüz Büyütme Hormonu!Dialogue: 0,0:09:33.95,0:09:38.29,Main,,0,0,0,,Iva-san. Ben de yardım edeyim.Dialogue: 0,0:09:40.53,0:09:42.77,Main,,0,0,0,,Büyük Makas!Dialogue: 0,0:09:44.26,0:09:47.20,Main,,0,0,0,,Hasır Şapkalı çocuğa el sürmene izin vermeyeceğim!Dialogue: 0,0:09:47.20,0:09:49.93,Main,,0,0,0,,Dragon'un oğlunu kesinlikle öldüreceğim!Dialogue: 0,0:09:49.93,0:09:54.31,Main,,0,0,0,,Cehennem Göz Kırpışı!Dialogue: 0,0:10:00.99,0:10:03.15,Main,,0,0,0,,Impel Down'dan beri...Dialogue: 0,0:10:03.15,0:10:07.78,Main,,0,0,0,,...Hasır Şapkalı çocuğun bedeninin fiziksel ve zihinsel olarak aldığı zarar,...Dialogue: 0,0:10:07.78,0:10:10.23,Main,,0,0,0,,...onun sınırını çoktan geçti!Dialogue: 0,0:10:11.88,0:10:17.19,Main,,0,0,0,,Ben varken Hasır Şapkalı çocuğa bir şey daha olursa,...Dialogue: 0,0:10:17.19,0:10:20.97,Main,,0,0,0,,...yoldaşım Dragon'un yüzüne bir daha asla bakamam!Dialogue: 0,0:10:20.97,0:10:22.17,Main,,0,0,0,,Ben de öyle hissediyorum.Dialogue: 0,0:10:24.04,0:10:26.00,Main,,0,0,0,,Gel bakalım!Dialogue: 0,0:10:26.00,0:10:32.04,Main,,0,0,0,,Şu anda senden çok daha sıcak biçimde yanıyorum!Dialogue: 0,0:10:46.50,0:10:48.96,Main,,0,0,0,,Pekâlâ beyler.Dialogue: 0,0:10:48.96,0:10:50.92,Main,,0,0,0,,Beklediğiniz için teşekkürler.Dialogue: 0,0:10:50.92,0:10:54.99,Main,,0,0,0,,Karasakal Korsanları'nın kaptanı Teach, dünyanın en büyük gösterisini...Dialogue: 0,0:10:54.99,0:10:56.97,Main,,0,0,0,,...sunmaktan gurur duyar.Dialogue: 0,0:10:56.97,0:11:00.30,Main,,0,0,0,,Lütfen iyi izleyin!Dialogue: 0,0:11:03.84,0:11:06.38,Main,,0,0,0,,K-Karasakal!Dialogue: 0,0:11:10.01,0:11:12.35,Main,,0,0,0,,Orada ne yapıyordu?!Dialogue: 0,0:11:12.77,0:11:14.90,Main,,0,0,0,,Beyazsakal hiç değişmemiş!Dialogue: 0,0:11:17.33,0:11:19.29,Main,,0,0,0,,Karasakal da değişmemiş!Dialogue: 0,0:11:20.76,0:11:23.86,Main,,0,0,0,,Denizciler!Dialogue: 0,0:11:24.71,0:11:28.70,Main,,0,0,0,,Size gücümü göstereyim!Dialogue: 0,0:11:30.07,0:11:32.97,Main,,0,0,0,,Şimdi bir kez daha düşmanız.Dialogue: 0,0:11:37.14,0:11:39.00,Main,,0,0,0,,Kara Delik!Dialogue: 0,0:11:41.28,0:11:42.88,Main,,0,0,0,,Bu da ne?!Dialogue: 0,0:11:48.58,0:11:53.00,Main,,0,0,0,,Bu Yami Yami Meyvesi'nin gücü...Dialogue: 0,0:11:53.00,0:11:54.23,Main,,0,0,0,,...ve...Dialogue: 0,0:11:57.43,0:11:59.23,Main,,0,0,0,,...bu...Dialogue: 0,0:12:02.79,0:12:04.07,Main,,0,0,0,,O duruş!Dialogue: 0,0:12:30.64,0:12:31.66,Main,,0,0,0,,O...Dialogue: 0,0:12:32.49,0:12:34.63,Main,,0,0,0,,...Gura Gura Meyvesi'nin gücü!Dialogue: 0,0:12:35.33,0:12:40.44,Main,,0,0,0,,Ö-Ölen Beyazsakal'ın güçlerini nasıl kullanıyor olabilir?!Dialogue: 0,0:12:45.45,0:12:47.35,Main,,0,0,0,,Başardın, Kaptan!Dialogue: 0,0:12:47.35,0:12:50.15,Main,,0,0,0,,Babalık'ın deprem güçleri...Dialogue: 0,0:12:50.15,0:12:53.05,Main,,0,0,0,,Neler oluyor?! Lanet olası Teach!Dialogue: 0,0:12:55.67,0:12:59.00,Main,,0,0,0,,Her şeyi hiçliğe çeviren karanlığın vehameti...Dialogue: 0,0:12:59.00,0:13:02.82,Main,,0,0,0,,...ve her şeyi yok eden depremlerin gücü.Dialogue: 0,0:13:02.82,0:13:08.00,Main,,0,0,0,,Nihayet onu elde ettim! Artık hiç kimse bana denk değil!Dialogue: 0,0:13:08.00,0:13:11.50,Main,,0,0,0,,En güçlüsü benim!Dialogue: 0,0:13:14.41,0:13:16.80,Main,,0,0,0,,Ne yaptığını bilmiyorum,...Dialogue: 0,0:13:16.80,0:13:19.55,Main,,0,0,0,,...ama Beyazsakal'ın gücünü çaldı!Dialogue: 0,0:13:19.55,0:13:21.31,Main,,0,0,0,,Bu nasıl mümkün olabilir?!Dialogue: 0,0:13:21.31,0:13:24.96,Main,,0,0,0,,O zaman Gura Gura Meyvesi'nin dehşeti...Dialogue: 0,0:13:24.96,0:13:26.71,Main,,0,0,0,,...hala bitmedi mi?!Dialogue: 0,0:13:26.71,0:13:32.32,Main,,0,0,0,,İki Şeytan Meyvesi'nin gücüne sahip olmanın imkânsız olduğunu sanıyordum!Dialogue: 0,0:13:32.32,0:13:35.45,Main,,0,0,0,,Sıradan insanlar için kesinlikle imkânsız,...Dialogue: 0,0:13:35.45,0:13:39.56,Main,,0,0,0,,...ama hepinizin bildiği gibi, Teach pek normal değil.Dialogue: 0,0:13:39.56,0:13:44.64,Main,,0,0,0,,Özünde, bedeni sıradan insanlarınkinden farklı!Dialogue: 0,0:13:44.64,0:13:47.27,Main,,0,0,0,,Buna yol açan o mu?!Dialogue: 0,0:13:47.27,0:13:50.07,Main,,0,0,0,,Hey, hepiniz gördünüz mü?!Dialogue: 0,0:13:52.21,0:13:54.76,Main,,0,0,0,,Bunu tüm dünyaya duyurun!Dialogue: 0,0:13:54.76,0:13:57.41,Main,,0,0,0,,Barışsever, sıkıcı insanlar!Dialogue: 0,0:13:57.41,0:14:01.02,Main,,0,0,0,,Denizciler! Dünya Hükümeti ve korsanlar!Dialogue: 0,0:14:01.44,0:14:03.79,Main,,0,0,0,,Bu bir kâbus mu?Dialogue: 0,0:14:03.79,0:14:07.16,Main,,0,0,0,,Dünyanın geleceği belirlendi!Dialogue: 0,0:14:09.46,0:14:12.03,Main,,0,0,0,,Evet, bundan sonra...Dialogue: 0,0:14:12.03,0:14:13.90,Main,,0,0,0,,...bu benim çağım!Dialogue: 0,0:14:19.73,0:14:22.14,Main,,0,0,0,,Denizci Karargâhı çöküyor!Dialogue: 0,0:14:27.48,0:14:29.69,Main,,0,0,0,,Çıkın buradan!Dialogue: 0,0:14:29.69,0:14:32.22,Main,,0,0,0,,Hiç umut yok!Dialogue: 0,0:14:35.45,0:14:38.55,Main,,0,0,0,,Bu gerçek mi?Dialogue: 0,0:14:40.55,0:14:44.28,Main,,0,0,0,,Lütfen biri bunun gerçek olmadığını söylesin!Dialogue: 0,0:14:44.28,0:14:48.29,Main,,0,0,0,,Dünya okyanuslarını yüzyıllardır koruyan...Dialogue: 0,0:14:48.29,0:14:52.83,Main,,0,0,0,,...adaletin kalesi, Denizci üssü,...Dialogue: 0,0:14:52.83,0:14:55.59,Main,,0,0,0,,...nasıl bu hâle gelebilir?!Dialogue: 0,0:15:02.86,0:15:07.36,Main,,0,0,0,,Ace'i yakalayıp bu savaşı başlatan Karasakal,...Dialogue: 0,0:15:07.36,0:15:10.21,Main,,0,0,0,,...Beyazsakal'ın güçlerini çaldı!Dialogue: 0,0:15:10.21,0:15:13.69,Main,,0,0,0,,Dünyadaki herkes seyretsin!Dialogue: 0,0:15:13.69,0:15:17.32,Main,,0,0,0,,Bana ve gücüme bakın!Dialogue: 0,0:15:21.73,0:15:24.93,Main,,0,0,0,,Dünyaya ne olacak?!Dialogue: 0,0:15:32.61,0:15:34.66,Main,,0,0,0,,Tüm bedenimi dolaşan...Dialogue: 0,0:15:34.66,0:15:38.73,Main,,0,0,0,,...gücü hissedebiliyorum!Dialogue: 0,0:15:39.36,0:15:40.38,Main,,0,0,0,,Kahretsin!Dialogue: 0,0:15:40.38,0:15:43.00,Main,,0,0,0,,Ne inanılmaz bir güç!Dialogue: 0,0:15:43.00,0:15:46.18,Main,,0,0,0,,Tüm dünyaya istediğimi yapabilirmişim gibi geliyor!Dialogue: 0,0:15:46.18,0:15:47.66,Main,,0,0,0,,Lanet olası!Dialogue: 0,0:15:52.66,0:15:54.88,Main,,0,0,0,,Hey! Sorun nedir?Dialogue: 0,0:15:55.49,0:15:59.80,Main,,0,0,0,,Ne? Kimse gelmiyor mu?Dialogue: 0,0:15:59.80,0:16:03.28,Main,,0,0,0,,Kaçınızla olursa olsun dövüşmek istiyorum.Dialogue: 0,0:16:03.28,0:16:05.91,Main,,0,0,0,,Çok yazık!Dialogue: 0,0:16:08.00,0:16:09.81,Main,,0,0,0,,Sanırım yapacak bir şey yok.Dialogue: 0,0:16:10.28,0:16:13.44,Main,,0,0,0,,O zaman, sanırım öncelikle...Dialogue: 0,0:16:13.46,0:16:17.39,Main,,0,0,0,,...Marineford'u okyanusun dibine göndereceğim!Dialogue: 0,0:16:18.65,0:16:20.12,Main,,0,0,0,,Ne?!Dialogue: 0,0:16:39.65,0:16:41.95,Main,,0,0,0,,Şok dalgası?!Dialogue: 0,0:16:53.76,0:16:58.17,Main,,0,0,0,,Kaleyi yeniden yapabiliriz!Dialogue: 0,0:17:01.85,0:17:03.62,Main,,0,0,0,,Ancak,...Dialogue: 0,0:17:03.62,0:17:08.43,Main,,0,0,0,,...burası dünyanın merkezindeki bir ada, Marineford!Dialogue: 0,0:17:09.72,0:17:11.41,Main,,0,0,0,,Filo Amirali.Dialogue: 0,0:17:11.41,0:17:17.27,Main,,0,0,0,,Denizlerdeki kötü adamlardan korkan vatandaşlar için,...Dialogue: 0,0:17:17.27,0:17:22.45,Main,,0,0,0,,...varlığımız büyük bir anlam ifade ediyor!Dialogue: 0,0:17:24.00,0:17:27.68,Main,,0,0,0,,İnsanlık ve adalet sistemimiz asla başarısız olmayacak.Dialogue: 0,0:17:27.70,0:17:32.50,Main,,0,0,0,,Adayı batırmak gibi şeylerden bu kadar ilgisizce bahsetme!Dialogue: 0,0:17:32.50,0:17:34.29,Main,,0,0,0,,Ahmak çırak!Dialogue: 0,0:17:43.39,0:17:45.92,Main,,0,0,0,,Takdire şayan bir inanç!Dialogue: 0,0:17:45.92,0:17:48.21,Main,,0,0,0,,Hey, Filo Amirali-san?Dialogue: 0,0:17:48.21,0:17:50.48,Main,,0,0,0,,O zaman dinle!Dialogue: 0,0:17:51.74,0:17:53.92,Main,,0,0,0,,Korumaya çalış bakalım!Dialogue: 0,0:18:07.36,0:18:08.23,Main,,0,0,0,,Kahretsin!Dialogue: 0,0:18:10.87,0:18:12.91,Main,,0,0,0,,Fırsatı değerlendirin! Çabuk!Dialogue: 0,0:18:13.70,0:18:15.47,Main,,0,0,0,,Hasır Şapkalı çocuğu selamete ulaştır!Dialogue: 0,0:18:16.76,0:18:18.38,Main,,0,0,0,,Beni affet!Dialogue: 0,0:18:21.57,0:18:22.97,Main,,0,0,0,,Inazuma!Dialogue: 0,0:18:36.63,0:18:38.60,Main,,0,0,0,,Iva-sama!Dialogue: 0,0:18:43.28,0:18:45.54,Main,,0,0,0,,Korsan pislikler!Dialogue: 0,0:18:45.54,0:18:47.57,Main,,0,0,0,,Akainu!Dialogue: 0,0:18:47.57,0:18:51.51,Main,,0,0,0,,Jinbe! Dragon'un oğlunu bana ver!Dialogue: 0,0:18:55.74,0:18:57.88,Main,,0,0,0,,Okyanustayken benim alanımda olacağız!Dialogue: 0,0:18:57.88,0:18:59.25,Main,,0,0,0,,Hala kaçabiliriz!Dialogue: 0,0:19:07.00,0:19:09.26,Main,,0,0,0,,Olamaz! Donmuş mu?!Dialogue: 0,0:19:10.72,0:19:12.43,Main,,0,0,0,,Aokiji!Dialogue: 0,0:19:14.97,0:19:16.71,Main,,0,0,0,,Demek geldin.Dialogue: 0,0:19:20.57,0:19:23.58,Main,,0,0,0,,Görünüşe göre kaçış yolunu kaybetmişsin!Dialogue: 0,0:19:29.11,0:19:30.81,Main,,0,0,0,,İşe yaramadı.Dialogue: 0,0:19:30.81,0:19:33.95,Main,,0,0,0,,Hasır Şapkalı Luffy!Dialogue: 0,0:19:34.89,0:19:37.56,Main,,0,0,0,,Benimsin!Dialogue: 0,0:19:48.10,0:19:49.07,Main,,0,0,0,,Jinbe!Dialogue: 0,0:19:55.35,0:19:58.60,Main,,0,0,0,,Jinbe'yi delip geçti ve Ace'in kardeşine vurdu!Dialogue: 0,0:19:58.60,0:20:00.11,Main,,0,0,0,,Hala hayatta mı?!Dialogue: 0,0:20:05.53,0:20:08.75,Main,,0,0,0,,Yoluma çıktın, Jinbe!Dialogue: 0,0:20:12.02,0:20:15.48,Main,,0,0,0,,Luffy-kun, beni affet.Dialogue: 0,0:20:15.48,0:20:18.90,Main,,0,0,0,,Bir kez daha yaralanmana izin verdim.Dialogue: 0,0:20:18.90,0:20:22.31,Main,,0,0,0,,Başkaları için endişelenecek zaman değil, pislik!Dialogue: 0,0:20:24.59,0:20:28.49,Main,,0,0,0,,Sen karıştığın için hedefim biraz kaydı.Dialogue: 0,0:20:28.49,0:20:32.11,Main,,0,0,0,,Kalbini delip geçseydim, onun için daha kolay olurdu.Dialogue: 0,0:20:32.50,0:20:34.31,Main,,0,0,0,,Öyle değil mi, Jinbe?Dialogue: 0,0:20:41.25,0:20:45.08,Main,,0,0,0,,Göğsündeki delikle hâlâ onu korumaya mı çalışıyorsun?!Dialogue: 0,0:20:51.14,0:20:53.05,Main,,0,0,0,,Birazdan ikiniz de öleceksiniz.Dialogue: 0,0:21:09.16,0:21:10.55,Main,,0,0,0,,Crocodile!Dialogue: 0,0:21:10.55,0:21:12.55,Main,,0,0,0,,Kum Fırtınası!Dialogue: 0,0:21:19.29,0:21:22.57,Main,,0,0,0,,Biri onu yakalayıp, geminin birine bıraksın artık!Dialogue: 0,0:21:22.57,0:21:23.65,Main,,0,0,0,,Tamam.Dialogue: 0,0:21:23.65,0:21:25.57,Main,,0,0,0,,Crocodile!Dialogue: 0,0:21:25.57,0:21:29.19,Main,,0,0,0,,Bir şeyi korumak istiyorsan, doğru düzgün korumalısın!Dialogue: 0,0:21:29.19,0:21:33.00,Main,,0,0,0,,Bu heriflerin her istediklerini yapmalarına izin verme!Dialogue: 0,0:21:34.26,0:21:35.58,Main,,0,0,0,,Yakalayın onu!Dialogue: 0,0:21:37.41,0:21:39.28,Main,,0,0,0,,Her şey bitti.Dialogue: 0,0:21:39.28,0:21:42.59,Main,,0,0,0,,Kendimi kaptırdığım için çok üzgünüm beyler.Dialogue: 0,0:21:42.59,0:21:45.55,Main,,0,0,0,,Kaptan Buggy efsanesi bitti.Dialogue: 0,0:21:45.55,0:21:48.52,Main,,0,0,0,,Bu noktaya kadar beni desteklediğiniz için teşekkür ederim.Dialogue: 0,0:21:48.52,0:21:49.96,Main,,0,0,0,,Jinbe!Dialogue: 0,0:21:57.35,0:21:59.02,Main,,0,0,0,,Geri düşmüyor.Dialogue: 0,0:22:00.29,0:22:01.91,Main,,0,0,0,,Bu da ne böyle?!Dialogue: 0,0:22:01.91,0:22:03.86,Main,,0,0,0,,Kaptan Buggy!Dialogue: 0,0:22:03.86,0:22:07.36,Main,,0,0,0,,Hasır Şapka'yı ve Jinbe'yi kurtardın!Dialogue: 0,0:22:07.36,0:22:09.41,Main,,0,0,0,,Biliyordum.Dialogue: 0,0:22:10.72,0:22:14.17,Main,,0,0,0,,Kaptan Buggy, kaçak arkadaşın Hasır Şapka'yı...Dialogue: 0,0:22:14.17,0:22:18.85,Main,,0,0,0,,...ihtiyaç duyduğu anda kurtarabilmek için, sanki kaçıyormuş izlenimi uyandırdın.Dialogue: 0,0:22:20.04,0:22:22.10,Main,,0,0,0,,Ne kadar asilce!Dialogue: 0,0:22:22.10,0:22:24.99,Main,,0,0,0,,Asaletin beni kör ediyor!Dialogue: 0,0:22:25.59,0:22:28.39,Main,,0,0,0,,Yine tuhaf davranıyorlar.Dialogue: 0,0:22:30.22,0:22:32.31,Main,,0,0,0,,Jinbe ve Hasır Şapka!Dialogue: 0,0:22:33.46,0:22:38.93,Main,,0,0,0,,Nasıl kana bulanmış biçimde gökyüzüne fırladınız?!Dialogue: 0,0:22:38.93,0:22:40.81,Main,,0,0,0,,Hey, burası epey sıcak oldu.Dialogue: 0,0:22:43.00,0:22:45.78,Main,,0,0,0,,M-Magma!Dialogue: 0,0:22:48.78,0:22:51.36,Main,,0,0,0,,Sağol, Kırmızı Burun.Dialogue: 0,0:22:51.36,0:22:52.58,Main,,0,0,0,,Bizi kurtardın.Dialogue: 0,0:22:52.58,0:22:57.81,Main,,0,0,0,,Yine de, Luffy-kun'un ölümcül bir yara almasına izin verdim.Dialogue: 0,0:22:57.81,0:22:59.93,Main,,0,0,0,,Hemen yaralarını tedavi etmeliyiz!Dialogue: 0,0:22:59.93,0:23:03.81,Main,,0,0,0,,Oh, kapa çeneni! Yardıma ihtiyacı olan benim, sersem!Dialogue: 0,0:23:03.81,0:23:06.20,Main,,0,0,0,,Burada onu tedavi edemeyiz.Dialogue: 0,0:23:06.81,0:23:08.87,Main,,0,0,0,,Hey! Sen kime Kırmızı Burun diyorsun?!Dialogue: 0,0:23:08.87,0:23:12.27,Main,,0,0,0,,Mümkü olan son bir anda, başka biri daha yoluma çıkıyor!Dialogue: 0,0:23:12.27,0:23:14.40,Main,,0,0,0,,*Pembe Rondo!Dialogue: 0,0:23:21.18,0:23:24.25,Main,,0,0,0,,Tüm hayvanlar toplandı.Dialogue: 0,0:23:24.25,0:23:28.15,Main,,0,0,0,,Hepiniz Hasır Şapka'nın uğruna ölmek mi istiyorsunuz?Dialogue: 0,0:23:28.71,0:23:35.63,Main,,0,0,0,,Hepimiz onun dipsiz kararlılığını ve gücünü gördük.Dialogue: 0,0:23:35.63,0:23:40.12,Main,,0,0,0,,O, Ace'in koruduğu ve Babalık'ın saygı duyduğu kişi!Dialogue: 0,0:23:40.12,0:23:44.16,Main,,0,0,0,,Onu yeni çağa göndermek bizim görevimiz.Dialogue: 0,0:23:44.16,0:23:48.79,Main,,0,0,0,,Her biriniz ahmaksınız!Dialogue: 0,0:23:56.52,0:23:58.59,Main,,0,0,0,,Beyazsakal Korsanları!Dialogue: 0,0:23:59.42,0:24:00.78,Main,,0,0,0,,Akainu.Dialogue: 0,0:24:00.78,0:24:05.32,Main,,0,0,0,,Şu anda öldürmeye çalıştığın çocukta gördüğün büyük tehlike...Dialogue: 0,0:24:05.32,0:24:10.15,Main,,0,0,0,,...ve kurtarmaya çalıştığımız kişide gördüğümüz potansiyel...Dialogue: 0,0:24:10.15,0:24:12.64,Main,,0,0,0,,...aynı şey değil mi?!Dialogue: 0,0:24:12.64,0:24:16.54,Main,,0,0,0,,Yine beni karıştırdığınıza inanamıyorum!Dialogue: 0,0:24:16.54,0:24:19.00,Main,,0,0,0,,Dinliyor musun?!Dialogue: 0,0:24:19.00,0:24:20.71,Main,,0,0,0,,Hey, J-Jinbe?Dialogue: 0,0:24:23.16,0:24:25.18,Main,,0,0,0,,Bayıldın mı?Dialogue: 0,0:24:25.18,0:24:28.05,Main,,0,0,0,,Hey, şimdi nereye gideceğim?!Dialogue: 0,0:24:28.05,0:24:29.56,Main,,0,0,0,,Hey!Dialogue: 0,0:24:30.68,0:24:34.61,Main,,0,0,0,,Ölü ya da diri olsa bile, zaten Cehennem'de gibi.Dialogue: 0,0:24:35.35,0:24:38.66,Main,,0,0,0,,Bu yüzden onu hayatta bırakalım ve acı çekmesini sağlayalım!Dialogue: 0,0:24:39.47,0:24:43.63,Main,,0,0,0,,Sanırım bu noktada söyleyeceğim hiçbir şey sizi durdurmayacak.Dialogue: 0,0:24:45.00,0:24:46.40,Main,,0,0,0,,Elinizden geleni yapın!Dialogue: 0,0:25:00.16,0:25:01.81,Main,,0,0,0,,U-Umut yok.Dialogue: 0,0:25:01.81,0:25:05.28,Main,,0,0,0,,Sengoku ve Karasakal orada.Dialogue: 0,0:25:12.37,0:25:15.12,Main,,0,0,0,,Akainu ve Kumandanlar ise burada.Dialogue: 0,0:25:22.17,0:25:25.14,Main,,0,0,0,,Savaş asla bitmeyecek!Dialogue: 0,0:25:25.14,0:25:28.27,Main,,0,0,0,,Kaptan Buggy! Bir şey yap!Dialogue: 0,0:25:28.27,0:25:30.01,Main,,0,0,0,,Nasıl yapayım, aptallar!Dialogue: 0,0:25:39.25,0:25:40.93,Main,,0,0,0,,Ne?Dialogue: 0,0:25:40.93,0:25:43.09,Main,,0,0,0,,Okyanustan bir gemi çıktı!Dialogue: 0,0:25:43.09,0:25:45.46,Main,,0,0,0,,O bir denizaltı!Dialogue: 0,0:25:45.46,0:25:47.46,Main,,0,0,0,,Kimin gemisi o?Dialogue: 0,0:25:49.19,0:25:51.40,Main,,0,0,0,,Hasır Şapkacı'yı buraya getir!Dialogue: 0,0:25:52.00,0:25:57.63,Main,,0,0,0,,"Hasır Şapkacı?" Birine hitap etmek için gerçekten tuhaf bir yöntem.Dialogue: 0,0:25:57.64,0:25:59.67,Main,,0,0,0,,Sen kimsin, çocuk?!Dialogue: 0,0:26:00.35,0:26:02.82,Main,,0,0,0,,Hasır Şapkacı ve ben muhtemelen ileride düşman olacağız,...Dialogue: 0,0:26:02.82,0:26:04.14,Main,,0,0,0,,...ama ona karşı bir şeyim yok.Dialogue: 0,0:26:04.80,0:26:07.60,Main,,0,0,0,,Burada ölmesi hiç eğlenceli olmazdı.Dialogue: 0,0:26:07.70,0:26:12.42,Captions,,0,0,250,,Kalp Korsanları'nın KaptanıDialogue: 0,0:26:07.70,0:26:12.42,Captions,,0,0,20,,Trafalgar LawDialogue: 0,0:26:08.19,0:26:12.42,Main,,0,0,0,,Bu yüzden onu buradan götüreceğim.  Şimdilik onunla ben ilgileneyim!Dialogue: 0,0:26:12.42,0:26:13.94,Main,,0,0,0,,Ne?!Dialogue: 0,0:26:20.20,0:26:23.04,Main,,0,0,0,,Ben doktorum!Dialogue: 0,0:00:25.37,0:00:30.41,OP13-Credits,,0,0,0,,Editing SewilDialogue: 0,0:00:30.41,0:00:36.22,OP13-Credits,,0,0,0,,Quality Control Grug PepperjackDialogue: 0,0:00:36.22,0:00:41.19,OP13-Credits,,0,0,0,,Timing Galaxy 9000Dialogue: 0,0:00:41.19,0:00:46.93,OP13-Credits,,0,0,0,,Translation YibisDialogue: 0,0:00:46.93,0:00:52.36,OP13-Credits,,0,0,0,,Visual Effects Datenshi KaitouYahikoDialogue: 0,0:00:52.36,0:00:57.44,OP13-Credits,,0,0,0,,Graphics DatenshiDialogue: 0,0:00:57.44,0:01:03.08,OP13-Credits,,0,0,0,,Karaoke KaitouYahikoDialogue: 0,0:01:03.08,0:01:06.56,OP13-Credits,,0,0,0,,Soundtracking HaleeDialogue: 0,0:01:06.56,0:01:08.68,OP13-Credits,,0,0,0,,Raws NetflixDialogue: 0,0:00:25.37,0:00:30.62,OP13-Translation,,0,0,0,karaoke,♪ Her seferinde yağmurdan sonra gökyüzüne bakıyorum. ♪Dialogue: 0,0:00:30.62,0:00:36.13,OP13-Translation,,0,0,0,karaoke,♪ Henüz sulugöz olduğum zamanları düşünüyorum. ♪Dialogue: 0,0:00:36.13,0:00:43.87,OP13-Translation,,0,0,0,karaoke,♪ Umutsuzca birinin arkasından koşuyorum,... ♪Dialogue: 0,0:00:43.94,0:00:46.85,OP13-Translation,,0,0,0,karaoke,♪ ..."Daha güçlü olmak istiyorum," diye düşünerek. ♪Dialogue: 0,0:00:46.85,0:00:52.03,OP13-Translation,,0,0,0,karaoke,♪ "Teşekkürüm" şimdi rüzgârda kayboldu,... ♪Dialogue: 0,0:00:52.20,0:00:57.21,OP13-Translation,,0,0,0,karaoke,♪ ...daha güçlü olabilir miyim? ♪Dialogue: 0,0:00:57.41,0:01:02.88,OP13-Translation,,0,0,0,karaoke,♪ Cevabımı bulamıyorum. ♪Dialogue: 0,0:01:03.01,0:01:08.40,OP13-Translation,,0,0,0,karaoke,♪ Bu yüzden ilerlemeye devam edeceğim. ♪Dialogue: 0,0:01:08.55,0:01:11.03,OP13-Translation,,0,0,0,karaoke,♪ Gel hadi, gidelim. ♪Dialogue: 0,0:01:11.03,0:01:14.24,OP13-Translation,,0,0,0,karaoke,♪ Asla pes etmeyeceğiz. ♪Dialogue: 0,0:01:14.24,0:01:19.48,OP13-Translation,,0,0,0,karaoke,♪ Zamanın dalgalarına yenik düşmeyeceğiz. ♪Dialogue: 0,0:01:19.48,0:01:25.09,OP13-Translation,,0,0,0,karaoke,♪ Tekrar tekrar ayağa kalkacağız. ♪Dialogue: 0,0:01:25.10,0:01:30.73,OP13-Translation,,0,0,0,karaoke,♪ Çünkü bizim için önemli olanı kaybetmek istemiyoruz. ♪Dialogue: 0,0:01:30.74,0:01:35.85,OP13-Translation,,0,0,0,karaoke,♪ Beni sürekli, sürekli ilerlemeye zorlayan... ♪Dialogue: 0,0:01:35.86,0:01:41.25,OP13-Translation,,0,0,0,karaoke,♪ ...kafamdaki sesi duyabiliyorum. ♪Dialogue: 0,0:01:41.25,0:01:46.38,OP13-Translation,,0,0,0,karaoke,♪ Haylaz yağmur bana engel olurken bile... ♪Dialogue: 0,0:01:46.39,0:01:51.32,OP13-Translation,,0,0,0,karaoke,♪ ...kaçmaya çalışmayacağım. ♪Dialogue: 0,0:01:54.42,0:01:56.78,OP13-Translation,,0,0,0,karaoke,♪ Gel hadi, gidelim. ♪Dialogue: 0,0:01:56.78,0:02:00.06,OP13-Translation,,0,0,0,karaoke,♪ Asla pes etmeyeceğiz. ♪Dialogue: 0,0:02:00.06,0:02:05.35,OP13-Translation,,0,0,0,karaoke,♪ Zamanın dalgalarına yenik düşmeyeceğiz. ♪Dialogue: 0,0:02:05.36,0:02:10.99,OP13-Translation,,0,0,0,karaoke,♪ Tekrar tekrar ayağa kalkacağız. ♪Dialogue: 0,0:02:10.99,0:02:16.35,OP13-Translation,,0,0,0,karaoke,♪ Çünkü bizim için önemli olanı kaybetmek istemiyoruz. ♪Dialogue: 0,0:02:16.36,0:02:22.05,OP13-Translation,,0,0,0,karaoke,♪ İnandığımız geleceğe doğru ilerleyelim. ♪