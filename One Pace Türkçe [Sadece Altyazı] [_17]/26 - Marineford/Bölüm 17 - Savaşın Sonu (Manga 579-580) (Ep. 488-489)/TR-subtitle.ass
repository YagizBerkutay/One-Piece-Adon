10,10,1Style: OP13-Kanji-furigana,Duality,30,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2,0,8,10,10,80,1Style: OP13-Karaoke,Duality,60,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,8,10,10,10,1Style: OP13-Translation,Duality,45.0,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,2,10,10,18,1Style: OP13-Kanji,Duality,60,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,8,10,10,110,1Style: OP13-Credits,FOT-Greco Std B,40,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,95,100,1,0,1,2.2,0,1,80,10,100,1Style: Author,Impress BT,25,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1,1,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:02:31.45,0:02:41.45,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazaskerDialogue: 0,0:13:15.00,0:13:25.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazaskerDialogue: 0,0:26:10.00,0:26:20.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazaskerDialogue: 0,0:02:31.45,0:02:40.03,Title,,0,0,240,,Savaşın SonuDialogue: 0,0:02:40.03,0:02:44.50,Main,,0,0,0,,Şaka yapıyor olmalısın! Ne tür bir doktor yanında kılıç taşır?!Dialogue: 0,0:02:44.50,0:02:47.95,Main,,0,0,0,,Denizcilere ev ziyareti falan yapan bir psikiyatr mısın?!Dialogue: 0,0:02:47.95,0:02:50.35,Main,,0,0,0,,Ne oldu? Kim geldi?Dialogue: 0,0:02:50.35,0:02:51.92,Main,,0,0,0,,Trafalgar Law...Dialogue: 0,0:02:51.92,0:02:53.73,Main,,0,0,0,,Kuzey Denizi'nden bir çaylak!Dialogue: 0,0:02:53.73,0:02:55.00,Main,,0,0,0,,Ne?!Dialogue: 0,0:02:55.00,0:03:00.53,Main,,0,0,0,,Yanlış hatırlamıyorsam, geçen gün Hasır Şapkalı Luffy ile Sabaody Takımadası'nda işbirliği yapıp,...Dialogue: 0,0:03:00.53,0:03:03.63,Main,,0,0,0,,...Kutsal Ejder olayından sonra kaçan bir korsan.Dialogue: 0,0:03:04.81,0:03:07.50,Main,,0,0,0,,Görünüşe bakılırsa, denizaltılarıyla onu kurtarmaya gelmişler!Dialogue: 0,0:03:07.50,0:03:09.85,Main,,0,0,0,,Daha fazla vakit kaybetme! Onu bana ver!Dialogue: 0,0:03:09.85,0:03:12.40,Main,,0,0,0,,Kimsin ve neden sana güveneyim diyorum?!Dialogue: 0,0:03:19.92,0:03:23.25,Main,,0,0,0,,Kaptan Law! Kıç tarafından savaş gemileri yaklaşıyor!Dialogue: 0,0:03:25.94,0:03:29.72,Main,,0,0,0,,Çabuk! İkisini de buraya getir!Dialogue: 0,0:03:31.78,0:03:33.99,Main,,0,0,0,,Tüm Denizcilere sesleniyorum!Dialogue: 0,0:03:33.99,0:03:36.12,Main,,0,0,0,,Güçlerinizi ikiye ayırın!Dialogue: 0,0:03:36.12,0:03:40.05,Main,,0,0,0,,Beyazsakal Korsanları'nın saldırısını geri püskürtün ve Karasakal Korsanları'nın pususunu bastırın!Dialogue: 0,0:03:46.72,0:03:49.42,Main,,0,0,0,,Denizciler yer altından geliyor!Dialogue: 0,0:03:49.42,0:03:50.68,Main,,0,0,0,,Orada geçitleri mi varmış?!Dialogue: 0,0:03:52.31,0:03:55.59,Main,,0,0,0,,Destek geldi! Tamamdır! Hemen işlerini bitirin!Dialogue: 0,0:04:04.67,0:04:06.79,Main,,0,0,0,,N-Ne?!Dialogue: 0,0:04:09.08,0:04:10.00,Main,,0,0,0,,Bu da ne?!Dialogue: 0,0:04:35.78,0:04:38.43,Main,,0,0,0,,Ne heyecan verici bir güç!Dialogue: 0,0:04:41.64,0:04:44.47,Main,,0,0,0,,Asla kaçmasına izin vermeyeceğim dedim!Dialogue: 0,0:04:46.60,0:04:47.94,Main,,0,0,0,,Geçmene izin vermiyoruz!Dialogue: 0,0:04:52.77,0:04:56.71,Main,,0,0,0,,Bir kez daha epey fantastik bir gösteri yapıyor.Dialogue: 0,0:04:56.71,0:05:00.68,Main,,0,0,0,,Ama henüz tam kontrol edemiyorum.Dialogue: 0,0:05:01.56,0:05:06.05,Main,,0,0,0,,Hey, Kaptan! Kendini aşırı kaptırırsan, bizim de duracak yerimiz kalmayacak!Dialogue: 0,0:05:06.94,0:05:10.67,Main,,0,0,0,,Ne düşünüyorsunuz, Buda Sengoku?! Kahraman Garp?!Dialogue: 0,0:05:10.67,0:05:12.96,Main,,0,0,0,,Beni durdurabilir misiniz?!Dialogue: 0,0:05:12.96,0:05:17.63,Main,,0,0,0,,Beyazsakal'la birlikte çağınız sona erdi!Dialogue: 0,0:05:30.46,0:05:33.55,Main,,0,0,0,,Karasakal şimdi ne yapıyor?!Dialogue: 0,0:05:33.55,0:05:34.14,Main,,0,0,0,,Korkuyorum!Dialogue: 0,0:05:34.14,0:05:35.92,Main,,0,0,0,,Bu konuda içimde kötü bir his var!Dialogue: 0,0:05:35.92,0:05:39.49,Main,,0,0,0,,Acil durum: Marineford'u vuran deprem sebebiyle...Dialogue: 0,0:05:39.49,0:05:44.37,Main,,0,0,0,,...Sabaody Takımadası'nın güney kıyısı için tsunami uyarısı yapıyoruz.Dialogue: 0,0:05:45.04,0:05:49.11,Main,,0,0,0,,Paniğe gerek olmadığı konusunda sizi temin ederiz, lütfen sakin olun.Dialogue: 0,0:05:51.86,0:05:57.97,Main,,0,0,0,,Lütfen takımadanın kuzeyindeki 40 - 50 arası korularda bulunan, yükseltilmiş bölgelerdeki sığınaklara gidin.Dialogue: 0,0:05:57.97,0:05:59.96,Main,,0,0,0,,Hemen koşun! Ne diye bekliyorsunuz?!Dialogue: 0,0:05:59.96,0:06:03.34,Main,,0,0,0,,Ben soyluyum! Size para veririm, önce benim gitmeme izin verin!Dialogue: 0,0:06:04.82,0:06:07.82,Main,,0,0,0,,Lütfen herkes sakin olsun.Dialogue: 0,0:06:16.19,0:06:19.91,Main,,0,0,0,,Pacifistalar meydandaki yarığı geçti!Dialogue: 0,0:06:22.89,0:06:27.30,Main,,0,0,0,,Pacifistaların peşinden gidin! Korsanların kaçmasına izin vermeyin!Dialogue: 0,0:06:30.14,0:06:31.77,Main,,0,0,0,,Hey!Dialogue: 0,0:06:36.72,0:06:39.47,Main,,0,0,0,,Neyin var senin?!Dialogue: 0,0:06:39.47,0:06:42.44,Main,,0,0,0,,Bilmiyorum! Ama çok üzgünüm!Dialogue: 0,0:06:42.44,0:06:43.68,Main,,0,0,0,,Üzgün mü?Dialogue: 0,0:06:54.12,0:06:56.93,Main,,0,0,0,,Kafamda birer birer kaybolan...Dialogue: 0,0:06:56.93,0:07:01.06,Main,,0,0,0,,...sesler duyuyorum.Dialogue: 0,0:07:06.34,0:07:08.14,Main,,0,0,0,,Ne? Sesler mi?Dialogue: 0,0:07:08.96,0:07:11.32,Thoughts,,0,0,0,,Size Denizcilerin adaletini göstereceğiz!Dialogue: 0,0:07:11.32,0:07:13.89,Thoughts,,0,0,0,,Sizin adalet düşünceniz bu mu?!Dialogue: 0,0:07:19.21,0:07:22.49,Thoughts,,0,0,0,,Bu, savaşta ölen arkadaşım için!Dialogue: 0,0:07:22.49,0:07:26.42,Thoughts,,0,0,0,,Lanet korsan! Cehennem'e git!Dialogue: 0,0:07:29.58,0:07:35.42,Thoughts,,0,0,0,,Şimdi anlamalarını sağlama zamanı! Denizin hâkimleri korsanlar değil, biziz!Dialogue: 0,0:07:35.42,0:07:36.25,Thoughts,,0,0,0,,Başardım!Dialogue: 0,0:07:36.25,0:07:38.80,Main,,0,0,0,,Neler saçmalıyorsun sen?!Dialogue: 0,0:07:38.80,0:07:41.10,Main,,0,0,0,,Delirdin mi? Kendine gel!Dialogue: 0,0:07:42.06,0:07:43.96,Thoughts,,0,0,0,,Y-Yardım edin.Dialogue: 0,0:07:43.96,0:07:45.17,Thoughts,,0,0,0,,Kaçın!Dialogue: 0,0:07:52.50,0:07:53.58,Main,,0,0,0,,Coby!Dialogue: 0,0:07:54.14,0:07:56.45,Main,,0,0,0,,Hey! Nereye gidiyorsun?!Dialogue: 0,0:07:58.38,0:08:01.16,Main,,0,0,0,,Olabildiğince çok kişi kaçmalı!Dialogue: 0,0:08:01.16,0:08:03.67,Main,,0,0,0,,Dayan! Hala kurtulabilirsin!Dialogue: 0,0:08:03.67,0:08:04.68,Main,,0,0,0,,Onu tedavi ettirmeliyiz!Dialogue: 0,0:08:04.68,0:08:06.61,Main,,0,0,0,,Ö-Ölmek istemiyorum.Dialogue: 0,0:08:06.61,0:08:09.57,Main,,0,0,0,,Boşverin onu! Savaştayız!Dialogue: 0,0:08:09.57,0:08:10.99,Main,,0,0,0,,A-Ama efendim.Dialogue: 0,0:08:10.99,0:08:15.46,Main,,0,0,0,,Şimdi Denizcilerin adalet gücünü gösterme vakti!Dialogue: 0,0:08:15.46,0:08:17.47,Main,,0,0,0,,Kurbanların yaralarını tımar edecek vaktimiz yok!Dialogue: 0,0:08:17.47,0:08:18.20,Main,,0,0,0,,Gidin!Dialogue: 0,0:08:18.20,0:08:19.38,Main,,0,0,0,,E-Emredersiniz!Dialogue: 0,0:08:21.21,0:08:23.39,Main,,0,0,0,,Korsanların peşinden gidin!Dialogue: 0,0:08:23.39,0:08:26.13,Main,,0,0,0,,Her birini ezin!Dialogue: 0,0:08:28.02,0:08:30.52,Main,,0,0,0,,Biri ona yardım etsin! Kimse yok mu?!Dialogue: 0,0:08:32.27,0:08:34.82,Main,,0,0,0,,Korsanları yok edin! Hiçbirini hayatta bırakmayın!Dialogue: 0,0:08:35.35,0:08:40.70,Thoughts,,0,0,0,,Öldürme sona ermeyecek. Denizciler amaçlarını gerçekleştirdiler, ama şimdi daha da acımasızlar!Dialogue: 0,0:08:45.58,0:08:47.39,Main,,0,0,0,,Mermilerimiz işe yaramıyor!Dialogue: 0,0:08:48.82,0:08:49.80,Main,,0,0,0,,Peşlerine düşün!Dialogue: 0,0:08:49.80,0:08:51.16,Main,,0,0,0,,Lanet olası kötü adamlar!Dialogue: 0,0:08:52.61,0:08:56.62,Thoughts,,0,0,0,,"Adalet" ve "kötülük" kavramlarımız konusunda bir yanlışlık var.Dialogue: 0,0:08:56.62,0:08:59.02,Thoughts,,0,0,0,,İki taraf da kendi çıkarları doğrultusunda hareket ediyor.Dialogue: 0,0:09:01.17,0:09:04.21,Main,,0,0,0,,Dinleyin beyler! Denizci olduğunuz sürece,...Dialogue: 0,0:09:04.21,0:09:06.69,Main,,0,0,0,,...korsanlar olarak bildiğimiz kötülüğü asla affetmemelisiniz!Dialogue: 0,0:09:13.06,0:09:15.62,Main,,0,0,0,,Kimse beni durduramaz!Dialogue: 0,0:09:15.62,0:09:18.77,Main,,0,0,0,,Her şeyi yok edip yutacağım!Dialogue: 0,0:09:28.88,0:09:33.78,Main,,0,0,0,,Hasır Şapkalı Luffy'yi geride bırak.Dialogue: 0,0:09:33.78,0:09:34.88,Main,,0,0,0,,O...Dialogue: 0,0:09:34.88,0:09:36.17,Main,,0,0,0,,Kizaru!Dialogue: 0,0:09:36.17,0:09:37.73,Main,,0,0,0,,Onları hemen buraya getir!Dialogue: 0,0:09:37.73,0:09:41.39,Main,,0,0,0,,Tamam, her kimsen onları sana bırakacağım!Dialogue: 0,0:09:41.39,0:09:44.39,Main,,0,0,0,,Ne istersen yap!Dialogue: 0,0:09:44.39,0:09:46.29,Main,,0,0,0,,Yakala onları, Jambarl!Dialogue: 0,0:09:47.63,0:09:48.95,Main,,0,0,0,,Tamam! Bu iyi!Dialogue: 0,0:09:48.95,0:09:50.60,Main,,0,0,0,,Dalalım!Dialogue: 0,0:09:50.60,0:09:55.94,Main,,0,0,0,,Sabaody'de benden kaçmakla iyi iş çıkardın, Trafalgar Law.Dialogue: 0,0:09:56.62,0:09:58.65,Main,,0,0,0,,Korkunç biçimde yaralanmış! Hala hayatta mı?Dialogue: 0,0:09:58.65,0:10:00.31,Main,,0,0,0,,Acele edelim!Dialogue: 0,0:10:03.41,0:10:04.76,Main,,0,0,0,,Kahretsin!Dialogue: 0,0:10:04.76,0:10:06.35,Main,,0,0,0,,Pes edin!Dialogue: 0,0:10:06.35,0:10:08.76,Main,,0,0,0,,Bu kadarı yeter!Dialogue: 0,0:10:15.02,0:10:16.03,Main,,0,0,0,,Bir Denizci?Dialogue: 0,0:10:27.34,0:10:28.82,Main,,0,0,0,,Coby!Dialogue: 0,0:10:28.82,0:10:36.21,Main,,0,0,0,,Durun artık! Bu savaşa son verin!Dialogue: 0,0:10:36.21,0:10:37.83,Main,,0,0,0,,Onun nesi var?Dialogue: 0,0:10:37.83,0:10:39.92,Main,,0,0,0,,B-Biri...Dialogue: 0,0:10:41.99,0:10:44.22,Main,,0,0,0,,...b-bize yardım etsin.Dialogue: 0,0:10:44.22,0:10:47.02,Main,,0,0,0,,İnsanların hayatlarını heba ediyoruz!Dialogue: 0,0:10:48.16,0:10:54.25,Main,,0,0,0,,Her bir askerin, dönüşünü bekleyen bir ailesi olmasına rağmen!Dialogue: 0,0:10:54.25,0:10:57.45,Main,,0,0,0,,Amacımızı çoktan gerçekleştirmiş olmamıza rağmen!Dialogue: 0,0:10:57.45,0:11:02.93,Main,,0,0,0,,Zaten bitmiş olan bir savaştan çekilen, dövüşmek istemeyen korsanları kovalıyoruz...Dialogue: 0,0:11:02.93,0:11:06.68,Main,,0,0,0,,...ve yaralarını tedavi ettiğimizde iyileşebilecek olan askerleri terk ediyoruz!Dialogue: 0,0:11:07.19,0:11:10.65,Main,,0,0,0,,Hala daha bir sürü insan feda ediyoruz!Dialogue: 0,0:11:10.65,0:11:14.12,Main,,0,0,0,,Bunun ardından düşen askerler ne olacak?!Dialogue: 0,0:11:14.12,0:11:16.22,Main,,0,0,0,,Coby?!Dialogue: 0,0:11:16.22,0:11:21.17,Main,,0,0,0,,Onların aptal gibi görünmesine neden oluyoruz!Dialogue: 0,0:11:21.17,0:11:24.00,Main,,0,0,0,,Ha? Sen de kimsin?!Dialogue: 0,0:11:28.40,0:11:33.87,Main,,0,0,0,,Zamanımdan birkaç saniye çaldın. Denizcilerin erdemli olmayan askerlere ihtiyacı yok!Dialogue: 0,0:11:35.23,0:11:36.80,Thoughts,,0,0,0,,Faydasız. Öleceğim!Dialogue: 0,0:11:36.80,0:11:40.41,Thoughts,,0,0,0,,Ama söyledim! Söylemek istediğimi söyledim!Dialogue: 0,0:11:41.98,0:11:44.19,Thoughts,,0,0,0,,Pişman değilim!Dialogue: 0,0:12:00.53,0:12:04.47,Main,,0,0,0,,İyi iş çıkardın, genç Denizci.Dialogue: 0,0:12:04.93,0:12:08.58,Main,,0,0,0,,Kısa bir cesaret ânı oluşturmak için, hayatını riske attın.Dialogue: 0,0:12:08.58,0:12:14.84,Main,,0,0,0,,Ne olursa olsun bu, dünyanın kaderini büyük ölçüde değiştirdi.Dialogue: 0,0:12:14.84,0:12:16.72,Main,,0,0,0,,Çabuk! Onu hemen içeri getirin!Dialogue: 0,0:12:16.72,0:12:17.58,Main,,0,0,0,,Tamam, Kaptan!Dialogue: 0,0:12:17.58,0:12:20.86,Main,,0,0,0,,Bu olmayacak.Dialogue: 0,0:12:22.95,0:12:25.87,Main,,0,0,0,,Bir şey yapma, Kizaru.Dialogue: 0,0:12:25.87,0:12:29.63,Main,,0,0,0,,Oh, Ben Beckman.Dialogue: 0,0:12:30.93,0:12:33.25,Main,,0,0,0,,O... O gemi...Dialogue: 0,0:12:33.25,0:12:34.68,Main,,0,0,0,,Gidiyoruz!Dialogue: 0,0:12:34.68,0:12:36.26,Main,,0,0,0,,Yeni Dünya'nın...Dialogue: 0,0:12:36.26,0:12:39.43,Main,,0,0,0,,...Dört İmparatoru'ndan birinin burada ne işi var?!Dialogue: 0,0:12:39.43,0:12:42.02,Main,,0,0,0,,Kızıl Saçlı Shanks!Dialogue: 0,0:12:54.93,0:12:56.83,Main,,0,0,0,,Bu savaşa...Dialogue: 0,0:13:01.67,0:13:03.73,Main,,0,0,0,,...son vermeye geldim!Dialogue: 0,0:13:21.69,0:13:23.37,Main,,0,0,0,,Kızıl Saç.Dialogue: 0,0:13:23.37,0:13:26.78,Main,,0,0,0,,Luffy'yi korsan olma yoluna sokan kişi!Dialogue: 0,0:13:42.93,0:13:46.35,Main,,0,0,0,,Kızıl Saç Korsanları!Dialogue: 0,0:13:50.33,0:13:51.41,Main,,0,0,0,,İmkânsız!Dialogue: 0,0:13:51.41,0:13:57.88,Main,,0,0,0,,Daha birkaç gün önce İmparator Kaidou ve Kızıl Saç, Yeni Dünya'da çatışıyordu!Dialogue: 0,0:13:57.88,0:14:01.35,Main,,0,0,0,,Buraya ne çabuk gelmiş?!Dialogue: 0,0:14:01.35,0:14:04.65,Main,,0,0,0,,Sh-Shanks?!Dialogue: 0,0:14:06.19,0:14:09.26,Main,,0,0,0,,B-Burada ne işin var?!Dialogue: 0,0:14:11.20,0:14:12.59,Main,,0,0,0,,Buggy!Dialogue: 0,0:14:12.59,0:14:14.49,Main,,0,0,0,,H-Hasır şapkan?Dialogue: 0,0:14:14.49,0:14:16.12,Main,,0,0,0,,Onu Luffy'ye ver.Dialogue: 0,0:14:16.89,0:14:18.37,Main,,0,0,0,,Niye bunu yapmak zorundayım?!Dialogue: 0,0:14:18.37,0:14:22.50,Main,,0,0,0,,Sana vermek istediğim bir hazine haritası da vardı.Dialogue: 0,0:14:23.00,0:14:24.41,Main,,0,0,0,,Öyle mi?!Dialogue: 0,0:14:24.41,0:14:26.55,Main,,0,0,0,,Evet. Büyük bir hazineye götürüyor!Dialogue: 0,0:14:26.55,0:14:28.02,Main,,0,0,0,,Ah, hadi ama!Dialogue: 0,0:14:28.02,0:14:32.65,Main,,0,0,0,,Doğru olamayacak kadar iyi! Böyle bir hikayeyle beni kandırabileceğini mi sanıyorsun?Dialogue: 0,0:14:33.07,0:14:36.04,Main,,0,0,0,,Tamam. O zaman başkasına veririm.Dialogue: 0,0:14:36.04,0:14:38.54,Main,,0,0,0,,Ne?! Ah, olamaz, dur! Ben yaparım!Dialogue: 0,0:14:38.54,0:14:40.38,Main,,0,0,0,,Hemen vereceğim!Dialogue: 0,0:14:42.32,0:14:44.39,Main,,0,0,0,,Şef!Dialogue: 0,0:14:45.12,0:14:47.61,Main,,0,0,0,,Luffy'yi on yıldır görmedin!Dialogue: 0,0:14:47.61,0:14:50.27,Main,,0,0,0,,Ona bir bakmak istemez misin?Dialogue: 0,0:14:56.20,0:14:58.34,Main,,0,0,0,,Evet.Dialogue: 0,0:14:58.34,0:15:00.38,Main,,0,0,0,,Kaptan! Bu tehlikeli!Dialogue: 0,0:15:00.38,0:15:03.68,Main,,0,0,0,,Dört İmparatordan birini görmenin nadir olduğunu biliyorum, ama acele edin ve kapıları kapatın!Dialogue: 0,0:15:04.18,0:15:05.10,Main,,0,0,0,,Tamam.Dialogue: 0,0:15:05.10,0:15:08.92,Main,,0,0,0,,Bunu unuttunuz! Yakalayın!Dialogue: 0,0:15:08.92,0:15:10.87,Main,,0,0,0,,Bize doğru bir şey uçuyor.Dialogue: 0,0:15:15.30,0:15:16.06,Main,,0,0,0,,Bu...Dialogue: 0,0:15:16.06,0:15:19.19,Main,,0,0,0,,Kaptan! Çabuk! Çabuk!Dialogue: 0,0:15:19.64,0:15:20.75,Main,,0,0,0,,Tamam!Dialogue: 0,0:15:36.56,0:15:38.95,Main,,0,0,0,,Onu görmek isterdim, ama...Dialogue: 0,0:15:42.16,0:15:44.19,Flashbacks,,0,0,0,,Bu şapkayı sana emanet ediyorum.Dialogue: 0,0:15:45.15,0:15:48.35,Flashbacks,,0,0,0,,Bir gün büyük bir korsan olduğunda...Dialogue: 0,0:15:48.35,0:15:51.45,Flashbacks,,0,0,0,,...onu bana vermelisin.Dialogue: 0,0:15:51.45,0:15:54.13,Flashbacks,,0,0,0,,Sözümüz olsun, Luffy.Dialogue: 0,0:16:11.15,0:16:12.95,Main,,0,0,0,,Şimdi karşılaşsaydık,...Dialogue: 0,0:16:15.14,0:16:17.52,Main,,0,0,0,,...sözümüz bozulurdu, değil mi?Dialogue: 0,0:16:18.68,0:16:20.12,Main,,0,0,0,,Luffy?Dialogue: 0,0:16:29.03,0:16:31.88,Main,,0,0,0,,Eğlenceli bir ameliyat olacak.Dialogue: 0,0:16:32.90,0:16:34.96,Main,,0,0,0,,Kızıl Saç, seni pislik!Dialogue: 0,0:16:34.96,0:16:36.97,Main,,0,0,0,,Dragon'un oğlunun kaçmasına izin verdin!Dialogue: 0,0:16:43.48,0:16:45.23,Main,,0,0,0,,Buz Devri!Dialogue: 0,0:16:50.72,0:16:52.79,Main,,0,0,0,,Denizaltının peşinde!Dialogue: 0,0:16:52.79,0:16:54.42,Main,,0,0,0,,Su donuyor!Dialogue: 0,0:17:01.03,0:17:02.90,Main,,0,0,0,,Nabzı dengelenmeye başladı.Dialogue: 0,0:17:07.20,0:17:08.10,Main,,0,0,0,,Ne oldu?Dialogue: 0,0:17:08.10,0:17:11.31,Main,,0,0,0,,Acil durum! Buz bizi hapsediyor!Dialogue: 0,0:17:12.77,0:17:14.84,Main,,0,0,0,,Hemen dalacağız!Dialogue: 0,0:17:26.08,0:17:27.72,Main,,0,0,0,,Görünüşe göre kaçtık.Dialogue: 0,0:17:31.49,0:17:34.03,Main,,0,0,0,,G-Güvendeyiz.Dialogue: 0,0:17:39.27,0:17:41.43,Main,,0,0,0,,Mücevherlerin Kutsal İpleri!Dialogue: 0,0:17:52.43,0:17:54.08,Main,,0,0,0,,Ş-Şimdi ne var?!Dialogue: 0,0:17:56.96,0:17:59.49,Main,,0,0,0,,Daha derine inmeliyiz! Okyanus tabanına!Dialogue: 0,0:18:01.22,0:18:04.59,Main,,0,0,0,,Vurulacağız! Kesinlikle vurulacağız!Dialogue: 0,0:18:04.59,0:18:07.60,Main,,0,0,0,,Çabuk! Tam yol ileri!Dialogue: 0,0:18:19.64,0:18:22.81,Main,,0,0,0,,Kahretsin. Bir türlü vazgeçmiyorlar!Dialogue: 0,0:18:22.81,0:18:24.93,Main,,0,0,0,,Onları vurmadı, değil mi?Dialogue: 0,0:18:24.93,0:18:27.85,Main,,0,0,0,,Ace'in kardeşi! Jinbe!Dialogue: 0,0:18:28.24,0:18:31.69,Main,,0,0,0,,Eğer hâlâ hayattalarsa,...Dialogue: 0,0:18:32.14,0:18:35.59,Main,,0,0,0,,...gerçekten şanslılar.Dialogue: 0,0:18:35.59,0:18:39.73,Main,,0,0,0,,Şimdilik onlardan vazgeçmek zorundayız.Dialogue: 0,0:18:47.93,0:18:52.45,Main,,0,0,0,,O savaş gemisi neden tek başına denize açılıyor?Dialogue: 0,0:18:52.45,0:18:53.58,Main,,0,0,0,,Acele etmelisiniz!Dialogue: 0,0:18:54.32,0:18:56.60,Main,,0,0,0,,Denizaltının peşinden gidin!Dialogue: 0,0:18:56.60,0:18:58.95,Main,,0,0,0,,Peşinden mi? Ama okyanusun dibinde!Dialogue: 0,0:18:58.95,0:19:03.25,Main,,0,0,0,,Amirallerin saldırısından sağ kurtulduklarından bile şüpheliyim.Dialogue: 0,0:19:03.25,0:19:06.29,Main,,0,0,0,,Hayır. Hiç şüphesiz hayattalar.Dialogue: 0,0:19:08.96,0:19:09.96,Main,,0,0,0,,İyi dinleyin!Dialogue: 0,0:19:11.80,0:19:13.60,Main,,0,0,0,,Denizin Yedi Savaş Lordu'ndan biri olarak...Dialogue: 0,0:19:13.60,0:19:16.74,Main,,0,0,0,,...kesinlikle Hasır Şapkalı Luffy'nin peşinden gideceğim ve işini bitireceğim!Dialogue: 0,0:19:16.74,0:19:18.81,Main,,0,0,0,,Bunu Karargâh'a bildirin!Dialogue: 0,0:19:18.81,0:19:20.17,Main,,0,0,0,,E-Evet hanımefendi!Dialogue: 0,0:19:20.17,0:19:23.19,Main,,0,0,0,,A-Ama nereye gideceğiz?Dialogue: 0,0:19:23.19,0:19:24.94,Main,,0,0,0,,İlerleyin!Dialogue: 0,0:19:26.14,0:19:29.11,Main,,0,0,0,,Deli, ama çok güzel!Dialogue: 0,0:19:33.31,0:19:35.85,Main,,0,0,0,,Ne dedin sen?!Dialogue: 0,0:19:35.85,0:19:38.79,Main,,0,0,0,,Hazine haritası konusunda yalan mı söyledin?!Dialogue: 0,0:19:38.79,0:19:41.22,Main,,0,0,0,,L-Lanet olası!Dialogue: 0,0:19:42.69,0:19:44.93,Main,,0,0,0,,O anlık bir şeydi, Buggy.Dialogue: 0,0:19:44.93,0:19:46.63,Main,,0,0,0,,Uzun zaman oldu, ha?Dialogue: 0,0:19:46.63,0:19:49.29,Main,,0,0,0,,N-Ne demek istiyorsun?Dialogue: 0,0:19:49.29,0:19:51.29,Main,,0,0,0,,"Uzun zaman oldu, ha" mı?Dialogue: 0,0:19:52.34,0:19:57.83,Main,,0,0,0,,Sana hâlâ kin tuttuğumu unutma, Shanks!Dialogue: 0,0:19:57.83,0:19:59.23,Main,,0,0,0,,Hangi konuda?Dialogue: 0,0:19:59.23,0:20:01.44,Main,,0,0,0,,Sakın unuttuğunu söyleme!Dialogue: 0,0:20:02.20,0:20:05.65,Main,,0,0,0,,O zaman bana bağırmamış olsaydın,...Dialogue: 0,0:20:05.65,0:20:13.52,Main,,0,0,0,,...hazine haritasını kaybetmezdim ve Şeytan Meyvesi güçlerim de olmazdı!Dialogue: 0,0:20:16.44,0:20:18.28,Main,,0,0,0,,Ah, şu mesele!Dialogue: 0,0:20:19.09,0:20:21.63,Main,,0,0,0,,İyi tepki için sağol.Dialogue: 0,0:20:21.63,0:20:26.10,Main,,0,0,0,,Hep bu yanından nefret ettim!Dialogue: 0,0:20:26.10,0:20:31.05,Main,,0,0,0,,Yeniden buluşur buluşmaz benden faydalandın!Dialogue: 0,0:20:31.05,0:20:34.24,Main,,0,0,0,,Bu savaşı durdurmaya gelmiş olman falan umrumda değil,...Dialogue: 0,0:20:34.24,0:20:38.65,Main,,0,0,0,,...şimdi seninle bire bir mücadeleye hazırım!Dialogue: 0,0:20:40.07,0:20:41.61,Main,,0,0,0,,Bunu gördünüz mü?Dialogue: 0,0:20:41.61,0:20:42.65,Main,,0,0,0,,Gördüm!Dialogue: 0,0:20:42.65,0:20:45.93,Main,,0,0,0,,Dört İmparator'dan biri olan Kızıl Saç Shanks'le konuşuyor.Dialogue: 0,0:20:45.93,0:20:47.56,Main,,0,0,0,,Hem de bu şekilde!Dialogue: 0,0:20:51.75,0:20:53.93,Main,,0,0,0,,Kaptan Buggy!Dialogue: 0,0:20:53.93,0:20:56.53,Main,,0,0,0,,Sonsuza dek peşinden...Dialogue: 0,0:20:56.53,0:20:58.23,Main,,0,0,0,,...geleceğiz!Dialogue: 0,0:20:58.99,0:21:01.27,Main,,0,0,0,,Tamam, anladım. Kızma.Dialogue: 0,0:21:02.38,0:21:04.52,Main,,0,0,0,,O da neydi?!Dialogue: 0,0:21:06.69,0:21:08.67,Thoughts,,0,0,0,,Ama dur biraz.Dialogue: 0,0:21:08.67,0:21:14.05,Thoughts,,0,0,0,,Bu heriflerle olduğum sürece, adadan güvenle kaçabilirim!Dialogue: 0,0:21:21.00,0:21:21.86,Main,,0,0,0,,Kızıl Saç...Dialogue: 0,0:21:24.18,0:21:25.33,Main,,0,0,0,,Marco.Dialogue: 0,0:21:25.97,0:21:28.61,Main,,0,0,0,,Artık bu savaşa devam etme.Dialogue: 0,0:21:28.61,0:21:30.57,Main,,0,0,0,,Sessizce geri çekilin.Dialogue: 0,0:21:35.27,0:21:36.29,Main,,0,0,0,,Şahin Göz!Dialogue: 0,0:21:36.29,0:21:37.55,Main,,0,0,0,,Nereye gidiyorsun?!Dialogue: 0,0:21:40.15,0:21:43.32,Main,,0,0,0,,Beyazsakal'la dövüşmeyi kabul ettim.Dialogue: 0,0:21:43.32,0:21:46.26,Main,,0,0,0,,Kızıl Saç'la dövüşmek anlaşmanın parçası değildi.Dialogue: 0,0:21:48.64,0:21:50.11,Main,,0,0,0,,Ben gidiyorum.Dialogue: 0,0:21:52.51,0:21:55.02,Main,,0,0,0,,Dövüşmeye devam ederseniz,...Dialogue: 0,0:21:56.45,0:22:01.86,Main,,0,0,0,,...iki taraf da gereksiz kayıplar verecek.Dialogue: 0,0:22:03.48,0:22:06.87,Main,,0,0,0,,Hâlâ dövüşmek isteyen varsa,...Dialogue: 0,0:22:13.48,0:22:16.99,Main,,0,0,0,,...gelin! Rakibiniz biz olacağız!Dialogue: 0,0:22:35.45,0:22:38.23,Main,,0,0,0,,Ne dersin, Teach?Dialogue: 0,0:22:38.23,0:22:40.73,Main,,0,0,0,,Hayır, Karasakal!Dialogue: 0,0:22:43.18,0:22:44.87,Main,,0,0,0,,Şimdilik bırakalım.Dialogue: 0,0:22:44.87,0:22:47.93,Main,,0,0,0,,İstediğimi aldım.Dialogue: 0,0:22:47.93,0:22:52.28,Main,,0,0,0,,Sizinle dövüşmem için henüz çok erken.Dialogue: 0,0:22:52.28,0:22:55.00,Main,,0,0,0,,Gidelim beyler!Dialogue: 0,0:23:35.51,0:23:37.19,Main,,0,0,0,,Lütfen...Dialogue: 0,0:23:40.35,0:23:41.90,Main,,0,0,0,,...şimdilik...Dialogue: 0,0:23:43.66,0:23:47.31,Main,,0,0,0,,...herkes söyleyeceğime saygı göstersin.Dialogue: 0,0:24:28.51,0:24:32.46,Main,,0,0,0,,İşte son haberler.Dialogue: 0,0:24:33.33,0:24:36.05,Main,,0,0,0,,Beyazsakal. Ace.Dialogue: 0,0:24:36.05,0:24:40.16,Main,,0,0,0,,Lütfen onların defin işini bize bırakın.Dialogue: 0,0:24:42.74,0:24:46.76,Main,,0,0,0,,Bu savaş dünyanın her yerinde canlı yayınlandı.Dialogue: 0,0:24:46.76,0:24:52.93,Main,,0,0,0,,Ölümlerini daha fazla istismar etmeyin!Dialogue: 0,0:24:52.93,0:24:54.51,Main,,0,0,0,,Neler saçmalıyorsun sen?!Dialogue: 0,0:24:54.51,0:24:59.35,Main,,0,0,0,,Kafalarını tüm dünyaya doğru sallandırmak, zaferimizin sembolü olacak!Dialogue: 0,0:24:59.35,0:25:01.44,Main,,0,0,0,,Koramiral'in dediği gibi!Dialogue: 0,0:25:01.44,0:25:03.65,Main,,0,0,0,,Zaferimizi lekelemek mi istiyorsun?!Dialogue: 0,0:25:03.65,0:25:05.91,Main,,0,0,0,,Bir korsanın emirlerine uymayacağız!Dialogue: 0,0:25:05.91,0:25:07.32,Main,,0,0,0,,Tamam.Dialogue: 0,0:25:08.93,0:25:10.62,Main,,0,0,0,,Filo Amirali!Dialogue: 0,0:25:14.44,0:25:18.19,Main,,0,0,0,,Onları sana verme konusunda sorunum yok, Kızıl Saç.Dialogue: 0,0:25:18.19,0:25:19.44,Main,,0,0,0,,Ama efendim!Dialogue: 0,0:25:20.03,0:25:22.55,Main,,0,0,0,,Başarısızlığı üstleneceğim.Dialogue: 0,0:25:25.61,0:25:26.84,Main,,0,0,0,,Üzgünüm.Dialogue: 0,0:25:27.26,0:25:29.67,Main,,0,0,0,,Yaralıları tedavi edin!Dialogue: 0,0:25:36.75,0:25:38.95,Main,,0,0,0,,Bu savaş...Dialogue: 0,0:25:38.95,0:25:42.29,Main,,0,0,0,,...bitti!Dialogue: 0,0:25:48.79,0:25:51.60,Main,,0,0,0,,Hareket edebilen herkes sağlık ekiplerine yardım etsin!Dialogue: 0,0:25:51.60,0:25:54.16,Main,,0,0,0,,Ağır yaralı olanlardan başlayın!Dialogue: 0,0:25:54.16,0:25:58.37,Main,,0,0,0,,Savaş alanında daha fazla kayıp veremeyiz!Dialogue: 0,0:25:59.93,0:26:01.17,Narrator,,0,0,0,,Böylece...Dialogue: 0,0:26:01.70,0:26:06.41,Narrator,,0,0,0,,...Büyük Korsan Çağı perdesinin ilk açılışından bu yana gerçekleşen en büyük savaş,...Dialogue: 0,0:26:06.65,0:26:11.38,Narrator,,0,0,0,,...büyük Marineford savaşı sona erdi.Dialogue: 0,0:26:11.38,0:26:14.60,Narrator,,0,0,0,,Tarihteki yerini alıyor.Dialogue: 0,0:00:25.37,0:00:30.41,OP13-Credits,,0,0,0,,Editing SewilDialogue: 0,0:00:30.41,0:00:36.22,OP13-Credits,,0,0,0,,Quality Control Grug PepperjackDialogue: 0,0:00:36.22,0:00:41.19,OP13-Credits,,0,0,0,,Timing Galaxy 9000Dialogue: 0,0:00:41.19,0:00:46.93,OP13-Credits,,0,0,0,,Translation YibisDialogue: 0,0:00:46.93,0:00:52.36,OP13-Credits,,0,0,0,,Visual Effects Datenshi KaitouYahikoDialogue: 0,0:00:52.36,0:00:57.44,OP13-Credits,,0,0,0,,Graphics DatenshiDialogue: 0,0:00:57.44,0:01:03.08,OP13-Credits,,0,0,0,,Karaoke KaitouYahikoDialogue: 0,0:01:03.08,0:01:06.56,OP13-Credits,,0,0,0,,Soundtracking HaleeDialogue: 0,0:01:06.56,0:01:08.68,OP13-Credits,,0,0,0,,Raws NetflixDialogue: 0,0:00:25.37,0:00:30.62,OP13-Translation,,0,0,0,karaoke,♪ Her seferinde yağmurdan sonra gökyüzüne bakıyorum. ♪Dialogue: 0,0:00:30.62,0:00:36.13,OP13-Translation,,0,0,0,karaoke,♪ Henüz sulugöz olduğum zamanları düşünüyorum. ♪Dialogue: 0,0:00:36.13,0:00:43.87,OP13-Translation,,0,0,0,karaoke,♪ Umutsuzca birinin arkasından koşuyorum,... ♪Dialogue: 0,0:00:43.94,0:00:46.85,OP13-Translation,,0,0,0,karaoke,♪ ..."Daha güçlü olmak istiyorum," diye düşünerek. ♪Dialogue: 0,0:00:46.85,0:00:52.03,OP13-Translation,,0,0,0,karaoke,♪ "Teşekkürüm" şimdi rüzgârda kayboldu,... ♪Dialogue: 0,0:00:52.20,0:00:57.21,OP13-Translation,,0,0,0,karaoke,♪ ...daha güçlü olabilir miyim? ♪Dialogue: 0,0:00:57.41,0:01:02.88,OP13-Translation,,0,0,0,karaoke,♪ Cevabımı bulamıyorum. ♪Dialogue: 0,0:01:03.01,0:01:08.40,OP13-Translation,,0,0,0,karaoke,♪ Bu yüzden ilerlemeye devam edeceğim. ♪Dialogue: 0,0:01:08.55,0:01:11.03,OP13-Translation,,0,0,0,karaoke,♪ Gel hadi, gidelim. ♪Dialogue: 0,0:01:11.03,0:01:14.24,OP13-Translation,,0,0,0,karaoke,♪ Asla pes etmeyeceğiz. ♪Dialogue: 0,0:01:14.24,0:01:19.48,OP13-Translation,,0,0,0,karaoke,♪ Zamanın dalgalarına yenik düşmeyeceğiz. ♪Dialogue: 0,0:01:19.48,0:01:25.09,OP13-Translation,,0,0,0,karaoke,♪ Tekrar tekrar ayağa kalkacağız. ♪Dialogue: 0,0:01:25.10,0:01:30.73,OP13-Translation,,0,0,0,karaoke,♪ Çünkü bizim için önemli olanı kaybetmek istemiyoruz. ♪Dialogue: 0,0:01:30.74,0:01:35.85,OP13-Translation,,0,0,0,karaoke,♪ Beni sürekli, sürekli ilerlemeye zorlayan... ♪Dialogue: 0,0:01:35.86,0:01:41.25,OP13-Translation,,0,0,0,karaoke,♪ ...kafamdaki sesi duyabiliyorum. ♪Dialogue: 0,0:01:41.25,0:01:46.38,OP13-Translation,,0,0,0,karaoke,♪ Haylaz yağmur bana engel olurken bile... ♪Dialogue: 0,0:01:46.39,0:01:51.32,OP13-Translation,,0,0,0,karaoke,♪ ...kaçmaya çalışmayacağım. ♪Dialogue: 0,0:01:54.42,0:01:56.78,OP13-Translation,,0,0,0,karaoke,♪ Gel hadi, gidelim. ♪Dialogue: 0,0:01:56.78,0:02:00.06,OP13-Translation,,0,0,0,karaoke,♪ Asla pes etmeyeceğiz. ♪Dialogue: 0,0:02:00.06,0:02:05.35,OP13-Translation,,0,0,0,karaoke,♪ Zamanın dalgalarına yenik düşmeyeceğiz. ♪Dialogue: 0,0:02:05.36,0:02:10.99,OP13-Translation,,0,0,0,karaoke,♪ Tekrar tekrar ayağa kalkacağız. ♪Dialogue: 0,0:02:10.99,0:02:16.35,OP13-Translation,,0,0,0,karaoke,♪ Çünkü bizim için önemli olanı kaybetmek istemiyoruz. ♪Dialogue: 0,0:02:16.36,0:02:22.05,OP13-Translation,,0,0,0,karaoke,♪ İnandığımız geleceğe doğru ilerleyelim. ♪