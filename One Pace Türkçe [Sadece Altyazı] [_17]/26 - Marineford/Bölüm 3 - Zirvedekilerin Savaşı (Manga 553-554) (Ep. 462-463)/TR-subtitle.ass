Dialogue: 0,0:07:51.76,0:07:53.73,Note,,0,0,0,,{\fad(300,0)}- Mücevherlerin Kutsal İpleri! -
Dialogue: 0,0:07:56.99,0:08:00.52,Main,,0,0,0,,Hey, hey. Bu cidden çok parlak.
Dialogue: 0,0:08:18.08,0:08:20.45,Main,,0,0,0,,Amiral'in saldırısını durdurdu!
Dialogue: 0,0:08:20.45,0:08:21.40,Main,,0,0,0,,O da ne?
Dialogue: 0,0:08:23.07,0:08:25.57,Main,,0,0,0,,Mavi alevlerle kaplanmış!
Dialogue: 0,0:08:27.44,0:08:29.28,Main,,0,0,0,,Mavi alevler mi?
Dialogue: 0,0:08:30.82,0:08:32.20,Main,,0,0,0,,Doğrudan...
Dialogue: 0,0:08:33.39,0:08:34.82,Main,,0,0,0,,...Krala...
Dialogue: 0,0:08:37.74,0:08:40.06,Main,,0,0,0,,...gidemezsin!
Dialogue: 0,0:08:42.16,0:08:45.94,Main,,0,0,0,,Siz Beyazsakal Korsanları cidden korkunçsunuz!
Dialogue: 0,0:08:45.94,0:08:48.52,Main,,0,0,0,,Beden ne biçim öyle?
Dialogue: 0,0:08:50.38,0:08:54.49,Main,,0,0,0,,Kizaru-san'ın saldırısına doğrudan\Nmaruz kalmasına rağmen hala hayatta!
Dialogue: 0,0:08:54.49,0:08:57.94,Main,,0,0,0,,Yeteneği söylentilerdeki kadar güçlü!
Dialogue: 0,0:08:58.84,0:09:01.72,Main,,0,0,0,,Logia Meyvelerinden bile daha nadir bir güç,...
Dialogue: 0,0:09:01.72,0:09:05.13,Main,,0,0,0,,...Efsanevi Zoan Türü.
Dialogue: 0,0:09:05.89,0:09:08.50,Main,,0,0,0,,Bak! Yaraları kayboluyor!
Dialogue: 0,0:09:08.91,0:09:12.05,Main,,0,0,0,,İnanamıyorum! O saldırı nasıl işe yaramaz?!
Dialogue: 0,0:09:14.14,0:09:15.52,Main,,0,0,0,,Oh, işe yaradı...
Dialogue: 0,0:09:21.67,0:09:24.26,Main,,0,0,0,,Yalancı.
Dialogue: 0,0:09:33.14,0:09:36.18,Main,,0,0,0,,O, Birinci Bölüm Kumandanı!
Dialogue: 0,0:09:36.18,0:09:40.06,Main,,0,0,0,,Ona ne vurursa vursun, alevlerle iyileşiyor...
Dialogue: 0,0:09:40.72,0:09:42.34,Main,,0,0,0,,Anka Kuşu Marco!
Dialogue: 0,0:09:44.52,0:09:49.11,Main,,0,0,0,,Daha önce hiç böyle bir kuş görmemiştim.
Dialogue: 0,0:09:59.26,0:10:03.55,Main,,0,0,0,,Evet, bu işe yarıyor.
Dialogue: 0,0:10:03.55,0:10:05.30,Main,,0,0,0,,Yalancı!
Dialogue: 0,0:10:14.14,0:10:15.48,Main,,0,0,0,,Kizaru-san!
Dialogue: 0,0:10:20.93,0:10:24.60,Main,,0,0,0,,Dev birimi! Gökyüzünden\Ngelen saldırılara da dikkat edin!
Dialogue: 0,0:10:24.98,0:10:26.77,Main,,0,0,0,,Tamam!
Dialogue: 0,0:10:28.91,0:10:30.83,Main,,0,0,0,,Devler geliyor!
Dialogue: 0,0:10:30.83,0:10:33.55,Main,,0,0,0,,Bacaklarına nişan alın! Onları dize getirin!
Dialogue: 0,0:10:33.55,0:10:36.68,Main,,0,0,0,,Siz geride durun!
Dialogue: 0,0:10:37.55,0:10:38.16,Main,,0,0,0,,Jozu!
Dialogue: 0,0:10:42.45,0:10:44.06,Main,,0,0,0,,Ne güç ama!
Dialogue: 0,0:11:05.98,0:11:07.16,Main,,0,0,0,,Ne yapmaya çalışıyor bu?
Dialogue: 0,0:11:07.16,0:11:10.80,Main,,0,0,0,,Durdurmaya çalışın bakalım!
Dialogue: 0,0:11:14.12,0:11:15.82,Main,,0,0,0,,Buz kalıbı!
Dialogue: 0,0:11:16.27,0:11:18.56,Main,,0,0,0,,Çok büyük!
Dialogue: 0,0:11:18.56,0:11:21.68,Main,,0,0,0,,Bu ikisi var ya...
Dialogue: 0,0:11:22.14,0:11:24.81,Main,,0,0,0,,...öylece yerlerini bırakıp gittiler!
Dialogue: 0,0:11:27.94,0:11:30.53,Main,,0,0,0,,Burada durmazsak...
Dialogue: 0,0:11:33.04,0:11:35.48,Main,,0,0,0,,...bu bölgeyi kim koruyacak?!
Dialogue: 0,0:11:58.23,0:12:02.88,Main,,0,0,0,,Devasa buz kalıbını...
Dialogue: 0,0:12:03.40,0:12:04.94,Main,,0,0,0,,...tamamen buharlaştırdı!
Dialogue: 0,0:12:08.18,0:12:09.09,Main,,0,0,0,,Durum kötü!
Dialogue: 0,0:12:11.85,0:12:13.37,Main,,0,0,0,,Volkanik kayalar!
Dialogue: 0,0:12:15.76,0:12:17.54,Main,,0,0,0,,Bize vurmaması lazım!
Dialogue: 0,0:12:17.91,0:12:19.97,Main,,0,0,0,,Lanet olası pislik!
Dialogue: 0,0:12:24.03,0:12:25.46,Main,,0,0,0,,Gemilerimizden biri vuruldu!
Dialogue: 0,0:12:25.95,0:12:27.56,Main,,0,0,0,,Gemilerden uzaklaşın!
Dialogue: 0,0:12:37.76,0:12:41.10,Main,,0,0,0,,Aynı dünyanın sonunu seyretmek gibi!
Dialogue: 0,0:12:50.26,0:12:52.72,Main,,0,0,0,,Bu alevler çok gösterişli.
