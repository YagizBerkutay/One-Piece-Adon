32.21,Kuzan,,0,0,0,fx,gDialogue: 0,0:03:31.05,0:03:32.21,Kuzan,,0,0,0,fx,eDialogue: 0,0:03:32.21,0:03:34.55,Kuzan,,0,0,0,fx,AgeDialogue: 0,0:03:31.02,0:03:34.55,Note,,0,0,0,,- Buz Devri -Dialogue: 0,0:03:34.84,0:03:36.96,Main,,0,0,0,,Aokiji...Dialogue: 0,0:03:37.79,0:03:39.30,Main,,0,0,0,,Genç ahmak!Dialogue: 0,0:03:39.99,0:03:41.93,Main,,0,0,0,,D-Durdurdu!Dialogue: 0,0:03:45.51,0:03:45.96,Kuzan,,0,0,0,fx,PDialogue: 0,0:03:45.51,0:03:45.96,Kuzan,,0,0,0,fx,aDialogue: 0,0:03:45.51,0:03:45.96,Kuzan,,0,0,0,fx,rDialogue: 0,0:03:45.96,0:03:46.51,Kuzan,,0,0,0,fx,ParDialogue: 0,0:03:45.54,0:03:46.31,Kuzan,,0,0,0,fx,tDialogue: 0,0:03:45.54,0:03:46.31,Kuzan,,0,0,0,fx,iDialogue: 0,0:03:46.31,0:03:46.75,Kuzan,,0,0,0,fx,tiDialogue: 0,0:03:45.57,0:03:46.55,Kuzan,,0,0,0,fx,sDialogue: 0,0:03:45.57,0:03:46.55,Kuzan,,0,0,0,fx,aDialogue: 0,0:03:45.57,0:03:46.55,Kuzan,,0,0,0,fx,nDialogue: 0,0:03:46.55,0:03:47.14,Kuzan,,0,0,0,fx,sanDialogue: 0,0:03:45.51,0:03:47.14,Note,,0,0,0,,- Ortaçağ Mızrağı -Dialogue: 0,0:03:53.52,0:03:55.01,Main,,0,0,0,,Ah...Dialogue: 0,0:04:13.33,0:04:15.40,Main,,0,0,0,,Bütün koyu dondurdu!Dialogue: 0,0:04:15.68,0:04:18.07,Main,,0,0,0,,Gemilerin hareket etmesi imkânsız!Dialogue: 0,0:04:18.10,0:04:19.57,Main,,0,0,0,,Ateş!Dialogue: 0,0:04:19.57,0:04:21.84,Main,,0,0,0,,Moby Dick'i yok edin!Dialogue: 0,0:04:26.65,0:04:28.18,Main,,0,0,0,,Gidelim!Dialogue: 0,0:04:28.18,0:04:29.85,Main,,0,0,0,,Üstünde durabileceğimiz katı bir yer var!Dialogue: 0,0:04:29.85,0:04:32.62,Main,,0,0,0,,Onlara ne yapabileceğimizi gösterin!Dialogue: 0,0:04:34.69,0:04:38.46,Main,,0,0,0,,Amiraller dövüşe katıldı! Saldırıyı durdurmayın!Dialogue: 0,0:04:41.62,0:04:44.36,Main,,0,0,0,,Okyanusu dondurmaları ne iyi oldu!Dialogue: 0,0:04:44.36,0:04:47.53,Main,,0,0,0,,O kadar gayrete geldim ki benim için aşırı sıcak olmaya başlamıştı!Dialogue: 0,0:04:51.80,0:04:54.27,Main,,0,0,0,,Sanırım o kadar kolay olmayacak.Dialogue: 0,0:04:56.77,0:04:59.97,Main,,0,0,0,,Denizci Karargâhının koramiralleri de burada!Dialogue: 0,0:05:01.97,0:05:05.83,Main,,0,0,0,,Bu kadar koramirali hiç bir arada görmemiştim!Dialogue: 0,0:05:07.46,0:05:09.99,Main,,0,0,0,,Aynı Buster Call gibi!Dialogue: 0,0:05:07.46,0:05:09.99,Note,,0,0,0,,- Buster Call: Yıkım Çağrısı -Dialogue: 0,0:05:09.99,0:05:15.39,Main,,0,0,0,,Ama babalığa ya da bize karşı olduklarında pek de özel sayılmazlar!Dialogue: 0,0:05:15.39,0:05:18.77,Main,,0,0,0,,Tsuru-san, geri dur!Dialogue: 0,0:05:18.77,0:05:22.20,Main,,0,0,0,,Saçmalamayın gençler!Dialogue: 0,0:05:22.72,0:05:28.51,Main,,0,0,0,,Denizin sonuna kadar çekilsem bile, artık güvenli yer diye bir şey yok.Dialogue: 0,0:05:30.71,0:05:33.24,Main,,0,0,0,,Gemiyi donmuş koyda karaya çıkarın!Dialogue: 0,0:05:33.71,0:05:35.81,Main,,0,0,0,,Hepsini haklayın!Dialogue: 0,0:05:35.81,0:05:39.15,Main,,0,0,0,,Hedefimiz koy! İleri!Dialogue: 0,0:05:39.15,0:05:42.35,Main,,0,0,0,,Babalık için seve seve canımı veririm!Dialogue: 0,0:05:42.35,0:05:45.57,Main,,0,0,0,,Gelin bakalım, Denizci Karargâhı!Dialogue: 0,0:05:45.57,0:05:48.29,Main,,0,0,0,,Gidelim, Squardo Korsanları!Dialogue: 0,0:05:48.29,0:05:50.70,Main,,0,0,0,,Evet!Dialogue: 0,0:05:52.42,0:05:55.13,Main,,0,0,0,,Sonunda başladı.Dialogue: 0,0:06:08.84,0:06:11.27,Main,,0,0,0,,Hıh, bu da ne? Dövüşecek misin?Dialogue: 0,0:06:12.04,0:06:14.42,Main,,0,0,0,,Sadece bizimle...Dialogue: 0,0:06:14.42,0:06:16.47,Main,,0,0,0,,...o adam arasındaki...Dialogue: 0,0:06:16.47,0:06:22.17,Main,,0,0,0,,...farkı kendi gözümle görmek istiyorum.Dialogue: 0,0:06:30.04,0:06:31.19,Main,,0,0,0,,Eyvah!Dialogue: 0,0:06:31.19,0:06:32.00,Main,,0,0,0,,Kaçın!Dialogue: 0,0:06:43.24,0:06:44.82,Main,,0,0,0,,Babalık!Dialogue: 0,0:07:10.88,0:07:14.19,Main,,0,0,0,,Durdurdu... Dünyadaki en güçlü kılıç darbesini!Dialogue: 0,0:07:15.70,0:07:17.63,Main,,0,0,0,,Üçüncü Bölüm Kumandanı...Dialogue: 0,0:07:17.63,0:07:19.18,Main,,0,0,0,,...Elmas Jozu!Dialogue: 0,0:07:47.59,0:07:50.49,Main,,0,0,0,,K-Kizaru geldi!Dialogue: 0,0:07:51.76,0:07:52.41,Borsalino,,0,0,0,fx,m 4 48 l 28 41 l 55 56 l 69 49 l 77 33 l 70 49 l 86 40 l 103 43 l 86 41 l 55 57 l 41 49 l 25 60 l 40 49 l 28 42YaDialogue: 0,0:07:51.76,0:07:52.41,Borsalino,,0,0,0,fx,m 4 48 l 28 41 l 55 56 l 69 49 l 77 33 l 70 49 l 86 40 l 103 43 l 86 41 l 55 57 l 41 49 l 25 60 l 40 49 l 28 42YaDialogue: 0,0:07:51.76,0:07:52.41,Borsalino,,0,0,0,fx,m 4 48 l 28 41 l 55 56 l 69 49 l 77 33 l 70 49 l 86 40 l 103 43 l 86 41 l 55 57 l 41 49 l 25 60 l 40 49 l 28 42YaDialogue: 0,0:07:51.76,0:07:52.41,Borsalino,,0,0,0,fx,m 4 48 l 28 41 l 55 56 l 69 49 l 77 33 l 70 49 l 86 40 l 103 43 l 86 41 l 55 57 l 41 49 l 25 60 l 40 49 l 28 42YaDialogue: 0,0:07:51.76,0:07:52.41,Borsalino,,0,0,0,fx,m 4 48 l 28 41 l 55 56 l 69 49 l 77 33 l 70 49 l 86 40 l 103 43 l 86 41 l 55 57 l 41 49 l 25 60 l 40 49 l 28 42YaDialogue: 0,0:07:51.76,0:07:52.41,Borsalino,,0,0,0,fx,m 4 48 l 28 41 l 55 56 l 69 49 l 77 33 l 70 49 l 86 40 l 103 43 l 86 41 l 55 57 l 41 49 l 25 60 l 40 49 l 28 42YaDialogue: 0,0:07:51.76,0:07:52.41,Borsalino,,0,0,0,fx,m 4 48 l 28 41 l 55 56 l 69 49 l 77 33 l 70 49 l 86 40 l 103 43 l 86 41 l 55 57 l 41 49 l 25 60 l 40 49 l 28 42YaDialogue: 0,0:07:51.76,0:07:52.41,Borsalino,,0,0,0,fx,m 4 48 l 28 41 l 55 56 l 69 49 l 77 33 l 70 49 l 86 40 l 103 43 l 86 41 l 55 57 l 41 49 l 25 60 l 40 49 l 28 42YaDialogue: 0,0:07:51.76,0:07:52.41,Borsalino,,0,0,0,fx,m 4 48 l 28 41 l 55 56 l 69 49 l 77 33 l 70 49 l 86 40 l 103 43 l 86 41 l 55 57 l 41 49 l 25 60 l 40 49 l 28 42YaDialogue: 0,0:07:51.76,0:07:52.41,Borsalino,,0,0,0,fx,m 4 48 l 28 41 l 55 56 l 69 49 l 77 33 l 70 49 l 86 40 l 103 43 l 86 41 l 55 57 l 41 49 l 25 60 l 40 49 l 28 42YaDialogue: 0,0:07:51.76,0:07:52.41,Borsalino,,0,0,0,fx,m 4 48 l 28 41 l 55 56 l 69 49 l 77 33 l 70 49 l 86 40 l 103 43 l 86 41 l 55 57 l 41 49 l 25 60 l 40 49 l 28 42YaDialogue: 0,0:07:51.76,0:07:52.41,Borsalino,,0,0,0,fx,m 4 48 l 28 41 l 55 56 l 69 49 l 77 33 l 70 49 l 86 40 l 103 43 l 86 41 l 55 57 l 41 49 l 25 60 l 40 49 l 28 42YaDialogue: 1,0:07:51.76,0:07:51.76,Borsalino,,0,0,0,fx,YDialogue: 3,0:07:51