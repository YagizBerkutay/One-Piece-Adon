43 l 86 41 l 55 57 l 41 49 l 25 60 l 40 49 l 28 42welDialogue: 0,0:07:53.25,0:07:53.93,Borsalino,,0,0,0,fx,m 4 48 l 28 41 l 55 56 l 69 49 l 77 33 l 70 49 l 86 40 l 103 43 l 86 41 l 55 57 l 41 49 l 25 60 l 40 49 l 28 42welDialogue: 0,0:07:53.25,0:07:53.93,Borsalino,,0,0,0,fx,m 4 48 l 28 41 l 55 56 l 69 49 l 77 33 l 70 49 l 86 40 l 103 43 l 86 41 l 55 57 l 41 49 l 25 60 l 40 49 l 28 42welDialogue: 0,0:07:53.25,0:07:53.93,Borsalino,,0,0,0,fx,m 4 48 l 28 41 l 55 56 l 69 49 l 77 33 l 70 49 l 86 40 l 103 43 l 86 41 l 55 57 l 41 49 l 25 60 l 40 49 l 28 42welDialogue: 0,0:07:53.25,0:07:53.93,Borsalino,,0,0,0,fx,m 4 48 l 28 41 l 55 56 l 69 49 l 77 33 l 70 49 l 86 40 l 103 43 l 86 41 l 55 57 l 41 49 l 25 60 l 40 49 l 28 42welDialogue: 0,0:07:53.25,0:07:53.93,Borsalino,,0,0,0,fx,m 4 48 l 28 41 l 55 56 l 69 49 l 77 33 l 70 49 l 86 40 l 103 43 l 86 41 l 55 57 l 41 49 l 25 60 l 40 49 l 28 42welDialogue: 1,0:07:52.51,0:07:53.25,Borsalino,,0,0,0,fx,wDialogue: 1,0:07:52.55,0:07:53.25,Borsalino,,0,0,0,fx,eDialogue: 1,0:07:52.60,0:07:53.25,Borsalino,,0,0,0,fx,lDialogue: 3,0:07:53.25,0:07:53.73,Borsalino,,0,0,0,fx,welDialogue: 3,0:07:53.25,0:07:53.73,Borsalino,,0,0,0,fx,welDialogue: 3,0:07:53.25,0:07:53.73,Borsalino,,0,0,0,fx,welDialogue: 3,0:07:53.25,0:07:53.73,Borsalino,,0,0,0,fx,welDialogue: 3,0:07:53.25,0:07:53.73,Borsalino,,0,0,0,fx,welDialogue: 0,0:07:51.76,0:07:53.73,Note,,0,0,0,,- Mücevherlerin Kutsal İpleri! -Dialogue: 0,0:07:56.99,0:08:00.52,Main,,0,0,0,,Hey, hey. Bu cidden çok parlak.Dialogue: 0,0:08:18.08,0:08:20.45,Main,,0,0,0,,Amiral'in saldırısını durdurdu!Dialogue: 0,0:08:20.45,0:08:21.40,Main,,0,0,0,,O da ne?Dialogue: 0,0:08:23.07,0:08:25.57,Main,,0,0,0,,Mavi alevlerle kaplanmış!Dialogue: 0,0:08:27.44,0:08:29.28,Main,,0,0,0,,Mavi alevler mi?Dialogue: 0,0:08:30.82,0:08:32.20,Main,,0,0,0,,Doğrudan...Dialogue: 0,0:08:33.39,0:08:34.82,Main,,0,0,0,,...Krala...Dialogue: 0,0:08:37.74,0:08:40.06,Main,,0,0,0,,...gidemezsin!Dialogue: 0,0:08:42.16,0:08:45.94,Main,,0,0,0,,Siz Beyazsakal Korsanları cidden korkunçsunuz!Dialogue: 0,0:08:45.94,0:08:48.52,Main,,0,0,0,,Beden ne biçim öyle?Dialogue: 0,0:08:50.38,0:08:54.49,Main,,0,0,0,,Kizaru-san'ın saldırısına doğrudan maruz kalmasına rağmen hala hayatta!Dialogue: 0,0:08:54.49,0:08:57.94,Main,,0,0,0,,Yeteneği söylentilerdeki kadar güçlü!Dialogue: 0,0:08:58.84,0:09:01.72,Main,,0,0,0,,Logia Meyvelerinden bile daha nadir bir güç,...Dialogue: 0,0:09:01.72,0:09:05.13,Main,,0,0,0,,...Efsanevi Zoan Türü.Dialogue: 0,0:09:05.89,0:09:08.50,Main,,0,0,0,,Bak! Yaraları kayboluyor!Dialogue: 0,0:09:08.91,0:09:12.05,Main,,0,0,0,,İnanamıyorum! O saldırı nasıl işe yaramaz?!Dialogue: 0,0:09:14.14,0:09:15.52,Main,,0,0,0,,Oh, işe yaradı...Dialogue: 0,0:09:21.67,0:09:24.26,Main,,0,0,0,,Yalancı.Dialogue: 0,0:09:33.14,0:09:36.18,Main,,0,0,0,,O, Birinci Bölüm Kumandanı!Dialogue: 0,0:09:36.18,0:09:40.06,Main,,0,0,0,,Ona ne vurursa vursun, alevlerle iyileşiyor...Dialogue: 0,0:09:40.72,0:09:42.34,Main,,0,0,0,,Anka Kuşu Marco!Dialogue: 0,0:09:44.52,0:09:49.11,Main,,0,0,0,,Daha önce hiç böyle bir kuş görmemiştim.Dialogue: 0,0:09:59.26,0:10:03.55,Main,,0,0,0,,Evet, bu işe yarıyor.Dialogue: 0,0:10:03.55,0:10:05.30,Main,,0,0,0,,Yalancı!Dialogue: 0,0:10:14.14,0:10:15.48,Main,,0,0,0,,Kizaru-san!Dialogue: 0,0:10:20.93,0:10:24.60,Main,,0,0,0,,Dev birimi! Gökyüzünden gelen saldırılara da dikkat edin!Dialogue: 0,0:10:24.98,0:10:26.77,Main,,0,0,0,,Tamam!Dialogue: 0,0:10:28.91,0:10:30.83,Main,,0,0,0,,Devler geliyor!Dialogue: 0,0:10:30.83,0:10:33.55,Main,,0,0,0,,Bacaklarına nişan alın! Onları dize getirin!Dialogue: 0,0:10:33.55,0:10:36.68,Main,,0,0,0,,Siz geride durun!Dialogue: 0,0:10:37.55,0:10:38.16,Main,,0,0,0,,Jozu!Dialogue: 0,0:10:42.45,0:10:44.06,Main,,0,0,0,,Ne güç ama!Dialogue: 0,0:11:05.98,0:11:07.16,Main,,0,0,0,,Ne yapmaya çalışıyor bu?Dialogue: 0,0:11:07.16,0:11:10.80,Main,,0,0,0,,Durdurmaya çalışın bakalım!Dialogue: 0,0:11:14.12,0:11:15.82,Main,,0,0,0,,Buz kalıbı!Dialogue: 0,0:11:16.27,0:11:18.56,Main,,0,0,0,,Çok büyük!Dialogue: 0,0:11:18.56,0:11:21.68,Main,,0,0,0,,Bu ikisi var ya...Dialogue: 0,0:11:22.14,0:11:24.81,Main,,0,0,0,,...öylece yerlerini bırakıp gittiler!Dialogue: 0,0:11:27.94,0:11:30.53,Main,,0,0,0,,Burada durmazsak...Dialogue: 0,0:11:33.04,0:11:35.48,Main,,0,0,0,,...bu bölgeyi kim koruyacak?!Dialogue: 0,0:11:58.23,0:12:02.88,Main,,0,0,0,,Devasa buz kalıbını...Dialogue: 0,0:12:03.40,0:12:04.94,Main,,0,0,0,,...tamamen buharlaştırdı!Dialogue: 0,0:12:08.18,0:12:09.09,Main,,0,0,0,,Durum kötü!Dialogue: 0,0:12:11.85,0:12:13.37,Main,,0,0,0,,Volkanik kayalar!Dialogue: 0,0:12:15.76,0:12:17.54,Main,,0,0,0,,Bize vurmaması lazım!Dialogue: 0,0:12:17.91,0:12:19.97,Main,,0,0,0,,Lanet olası pislik!Dialogue: 0,0:12:24.03,0:12:25.46,Main,,0,0,0,,Gemilerimizden biri vuruldu!Dialogue: 0,0:12:25.95,0:12:27.56,Main,,0,0,0,,Gemilerden uzaklaşın!Dialogue: 0,0:12:37.76,0:12:41.10,Main,,0,0,0,,Aynı dünyanın sonunu seyretmek gibi!Dialogue: 0,0:12:50.26,0:12:52.72,Main,,0,0,0,,Bu alevler çok gösterişli.Dialogue: 0,0:11:40.90,0:11:41.35,Sakazuki,,0,0,0,fx,GDialogue: 0,0:11:40.90,0:11:41.35,Sakazuki,,0,0,0,fx,rDialogue: 0,0:11:40.90,0:11:41.35,Sakazuki,,0,0,0,fx,eDialogue: 0,0:11:40.90,0:11:41.35,Sakazuki,,0,0,0,fx,aDialogue: 0,0:11:40.90,0:11:41.35,Sakazuki,,0,0,0,fx,tDialogue: 0,0:11:41.35,0:11:42.24,Sakazuki,,0,0,0,fx,GreatDialogue: 0,0:11:40.93,0:11:42.04,Sakazuki,,0,0,0,fx,EDialogue: 0,0:11:40.93,0:11:42.04,Sakazuki,,0,0,0,fx,rDialogue: 0,0:11:40.93,0:11:42.04,Sakazuki,,0,0,0,fx,uDialogue: 0,0:11:40.93,0:11:42.04,Sakazuki,,0,0,0,fx,pDialogue: 0,0:11:42.04,0:11:42.59,Sakazuki,,0,0,0,fx,ErupDialogue: 0,0:11:40.96,0:11:42.39,Sakazuki,,0,0,0,fx,tDialogue: 0,0:11:40.96,0:11:42.39,Sakazuki,,0,0,0,fx,iDialogue: 0,0:11:40.96,0:11:42.39,Sakazuki,,0,0,0,fx,oDialogue: 0,0:11:40.96,0:11:42.39,Sakazuki,,0,0,0,fx,nDialogue: 0,0:11:42.39,0:11:43.32,Sakazuki,,0,0,0,fx,tionDialogue: 0,0:11:40.90,0:11:43.32,Note,,0,0,0,,- Büyük Yanardağ Püskürmesi! -Dialogue: 0,0:13:08.57,0:13:13.09,Main,,0,0,0,,Niye bunun yerine gidip doğum günü pastasındaki mumları falan yakmıyorsun, magma veledi?Dialogue: 0,0:13:15.02,0:13:19.28,Main,,0,0,0,,Gösterişli cenaze törenlerinden hoşlanmıyor musun, Beyazsakal?Dialogue: 0,0:13:21.12,0:13:23.62,Main,,0,0,0,,Ateş! Durmayın!Dialogue: 0,0:13:48.90,0:13:50.80,Main,,0,0,0,,Tereddüt etmeyin!Dialogue: 0,0:13:51.62,0:13:53.49,Main,,0,0,0,,Meydana doğru ilerleyin!Dialogue: 0,0:14:08.86,0:14:11.16,Main,,0,0,0,,Kumandanları durdurun!Dialogue: 0,0:14:12.72,0:14:14.35,Main,,0,0,0,,Kıyıya ulaşmalarına izin vermeyin!Dialogue: 0,0:14:14.35,0:14:17.92,Main,,0,0,0,,Moby Dick'i batırın! Beyazsakal'ı öldürün!Dialogue: 0,0:14:37.76,0:14:39.20,Main,,0,0,0,,İşte geliyor!Dialogue: 0,0:14:41.86,0:14:44.51,Main,,0,0,0,,Ateş!Dialogue: 0,0:14:48.30,0:14:51.30,Main,,0,0,0,,Savaş gemisi engelini yarıp geç!Dialogue: 0,0:15:06.96,0:15:09.00,Main,,0,0,0,,Ace-kun!Dialogue: 0,0:15:11.85,0:15:13.68,Main,,0,0,0,,Hadi, git!Dialogue: 0,0:15:13.68,0:15:16.38,Main,,0,0,0,,Oz Jr.Dialogue: 0,0:15:25.87,0:15:28.54,Main,,0,0,0,,O, Kıta Çeken Oz'ların torunu!Dialogue: 0,0:15:28.54,0:15:33.18,Main,,0,0,0,,Devasa! Sıradan bir devden çok daha büyük!Dialogue: 0,0:15:33.18,0:15:37.77,Main,,0,0,0,,Koya girmesine izin vermeyin! Savunmamızı yarmaya çalışıyor!Dialogue: 0,0:15:40.07,0:15:45.74,Main,,0,0,0,,Yani Ozlar'ın torunu, Beyazsakal'ın adamlarından biri mi?Dialogue: 0,0:15:46.17,0:15:51.21,Main,,0,0,0,,Onu istiyorum! Cesedini istiyorum!Dialogue: 0,0:15:55.58,0:15:57.58,Main,,0,0,0,,Tüm bedenimi ürpertiyor!Dialogue: 0,0:16:01.17,0:16:02.78,Main,,0,0,0,,Oz!Dialogue: 0,0:16:03.40,0:16:07.40,Main,,0,0,0,,Ace-kun iyi biri!Dialogue: 0,0:16:07.96,0:16:12.34,Main,,0,0,0,,Onu öldürmenize izin vermeyeceğim!Dialogue: 0,0:00:25.37,0:00:30.62,Karaoke,,0,0,0,karaoke,♪ Her seferinde yağmurdan sonra gökyüzüne bakıyorum. ♪Dialogue: 0,0:00:30.62,0:00:36.13,Karaoke,,0,0,0,karaoke,♪ Henüz sulugöz olduğum zamanları düşünüyorum. ♪Dialogue: 0,0:00:36.13,0:00:43.87,Karaoke,,0,0,0,karaoke,♪ Umutsuzca birinin arkasından koşuyorum,... ♪Dialogue: 0,0:00:43.94,0:00:46.85,Karaoke,,0,0,0,karaoke,♪ ..."Daha güçlü olmak istiyorum," diye düşünerek. ♪Dialogue: 0,0:00:46.85,0:00:52.03,Karaoke,,0,0,0,karaoke,♪ "Teşekkürüm" şimdi rüzgârda kayboldu,... ♪Dialogue: 0,0:00:52.20,0:00:57.21,Karaoke,,0,0,0,karaoke,♪ ...daha güçlü olabilir miyim? ♪Dialogue: 0,0:00:57.41,0:01:02.88,Karaoke,,0,0,0,karaoke,♪ Cevabımı bulamıyorum. ♪Dialogue: 0,0:01:03.01,0:01:08.40,Karaoke,,0,0,0,karaoke,♪ Bu yüzden ilerlemeye devam edeceğim. ♪Dialogue: 0,0:01:08.55,0:01:11.03,Karaoke,,0,0,0,karaoke,♪ Gel hadi, gidelim. ♪Dialogue: 0,0:01:11.03,0:01:14.24,Karaoke,,0,0,0,karaoke,♪ Asla pes etmeyeceğiz. ♪Dialogue: 0,0:01:14.24,0:01:19.48,Karaoke,,0,0,0,karaoke,♪ Zamanın dalgalarına yenik düşmeyeceğiz. ♪Dialogue: 0,0:01:19.48,0:01:25.09,Karaoke,,0,0,0,karaoke,♪ Tekrar tekrar ayağa kalkacağız. ♪Dialogue: 0,0:01:25.10,0:01:30.73,Karaoke,,0,0,0,karaoke,♪ Çünkü bizim için önemli olanı kaybetmek istemiyoruz. ♪Dialogue: 0,0:01:30.74,0:01:35.85,Karaoke,,0,0,0,karaoke,♪ Beni sürekli, sürekli ilerlemeye zorlayan... ♪Dialogue: 0,0:01:35.86,0:01:41.25,Karaoke,,0,0,0,karaoke,♪ ...kafamdaki sesi duyabiliyorum. ♪Dialogue: 0,0:01:41.25,0:01:46.38,Karaoke,,0,0,0,karaoke,♪ Haylaz yağmur bana engel olurken bile... ♪Dialogue: 0,0:01:46.39,0:01:51.32,Karaoke,,0,0,0,karaoke,♪ ...kaçmaya çalışmayacağım. ♪Dialogue: 0,0:01:54.42,0:01:56.78,Karaoke,,0,0,0,karaoke,♪ Gel hadi, gidelim. ♪Dialogue: 0,0:01:56.78,0:02:00.06,Karaoke,,0,0,0,karaoke,♪ Asla pes etmeyeceğiz. ♪Dialogue: 0,0:02:00.06,0:02:05.35,Karaoke,,0,0,0,karaoke,♪ Zamanın dalgalarına yenik düşmeyeceğiz. ♪Dialogue: 0,0:02:05.36,0:02:10.99,Karaoke,,0,0,0,karaoke,♪ Tekrar tekrar ayağa kalkacağız. ♪Dialogue: 0,0:02:10.99,0:02:16.35,Karaoke,,0,0,0,karaoke,♪ Çünkü bizim için önemli olanı kaybetmek istemiyoruz. ♪Dialogue: 0,0:02:16.36,0:02:22.05,Karaoke,,0,0,0,karaoke,♪ İnandığımız geleceğe doğru ilerleyelim. ♪