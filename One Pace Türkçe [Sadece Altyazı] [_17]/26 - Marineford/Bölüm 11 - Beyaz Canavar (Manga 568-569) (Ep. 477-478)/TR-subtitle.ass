Dialogue: 0,0:02:36.54,0:02:38.60,Main,,0,0,0,,Kahraman Garp...
Dialogue: 0,0:02:38.60,0:02:40.64,Main,,0,0,0,,...platformu koruyor!
Dialogue: 0,0:02:42.96,0:02:46.55,Main,,0,0,0,,Gözünüz korkmasın. Bu sadece\Nbir isim, sizi ahmaklar!
Dialogue: 0,0:02:47.42,0:02:49.81,Main,,0,0,0,,O sadece yaşlı bir Denizci.
Dialogue: 0,0:02:52.55,0:02:55.72,Main,,0,0,0,,Sen de o neslin bir parçası olduğunu için...
Dialogue: 0,0:02:56.46,0:02:59.16,Main,,0,0,0,,...önündeki düşmana dikkat etsen iyi edersin!
Dialogue: 0,0:03:00.03,0:03:01.62,Main,,0,0,0,,{\fad(150,150)}Kızıl Köpek Isırığı!
Dialogue: 0,0:03:10.64,0:03:13.17,Main,,0,0,0,,Şehri yok edip duruyorsun.
Dialogue: 0,0:03:13.56,0:03:16.47,Main,,0,0,0,,Dediğim gibi, korumaya çalış!
Dialogue: 0,0:03:16.72,0:03:20.18,Title,,0,0,230,,{\fad(1000,200)}Beyaz Canavar
Dialogue: 0,0:03:17.93,0:03:20.18,Main,,0,0,0,,Yol açın!
Dialogue: 0,0:03:20.18,0:03:22.48,Main,,0,0,0,,Ace'i kurtaracak bir yol!
Dialogue: 0,0:03:29.52,0:03:31.82,Main,,0,0,0,,İşi zorlaştıran pislikler buraya kadar gelmiş.
Dialogue: 0,0:03:33.33,0:03:36.03,Main,,0,0,0,,Bu olmayacak canavar!
Dialogue: 0,0:03:37.23,0:03:40.87,Main,,0,0,0,,Size Yeni Dünya'nın gücünü göstereceğiz!
Dialogue: 0,0:03:48.86,0:03:50.35,Main,,0,0,0,,Acele edin!
Dialogue: 0,0:03:50.35,0:03:51.81,Main,,0,0,0,,İdam sehpasına!
Dialogue: 0,0:04:10.08,0:04:12.10,Main,,0,0,0,,Ne oldu, Ateş Yumruk?
Dialogue: 0,0:04:15.65,0:04:17.24,Thoughts,,0,0,0,,Ace...
Dialogue: 0,0:04:28.01,0:04:29.98,Flashbacks,,0,0,0,,Gol D. Roger?
Dialogue: 0,0:04:31.24,0:04:33.45,Flashbacks,,0,0,0,,Gold Roger'ı mı kastediyorsun?
Dialogue: 0,0:04:33.45,0:04:35.62,Flashbacks,,0,0,0,,Onu tanıyor muyum?
Dialogue: 0,0:04:35.62,0:04:41.29,Flashbacks,,0,0,0,,Hey, neden dünyada sorun çıkaran\Nbu kadar korsan olduğunu bilmiyor musun?
Dialogue: 0,0:04:41.64,0:04:44.34,Flashbacks,,0,0,0,,Hepsi Roger denen adamın hatası!
Dialogue: 0,0:04:44.34,0:04:45.46,Flashbacks,,0,0,0,,Roger'ın...
Dialogue: 0,0:04:45.46,0:04:47.58,Flashbacks,,0,0,0,,Ben böyle duydum,...
Dialogue: 0,0:04:47.58,0:04:54.07,Flashbacks,,0,0,0,,...ama görünüşe bakılırsa idamından önce\N"büyük hazine" saçmalığından bahsetmiş.
Dialogue: 0,0:04:54.07,0:04:58.37,Flashbacks,,0,0,0,,Böylece ona inanacak kadar aptal olan korsan\Njenerasyonu denizlere açılmaya başladı.
Dialogue: 0,0:04:58.70,0:05:02.48,Flashbacks,,0,0,0,,O herif doğmasaydı, daha iyi olurdu.
Dialogue: 0,0:05:02.48,0:05:04.61,Flashbacks,,0,0,0,,Rezil herif!
Dialogue: 0,0:05:04.61,0:05:10.44,Flashbacks,,0,0,0,,Ölmeden önce platformdan, her istediklerini\Nyapsınlar diye korsanları denize gönderdi!
Dialogue: 0,0:05:10.44,0:05:13.33,Flashbacks,,0,0,0,,Hayattayken baş belasıydı, öldüğü\Niçin şimdi daha da büyük bela!
Dialogue: 0,0:05:13.72,0:05:17.16,Flashbacks,,0,0,0,,Dünyadaki en pislik herif! Bunu unutma!
Dialogue: 0,0:05:25.30,0:05:27.41,Flashbacks,,0,0,0,,Ha? Ne oldu?
Dialogue: 0,0:05:27.41,0:05:29.22,Flashbacks,,0,0,0,,Niye bu kadar kızıyorsun?
Dialogue: 0,0:05:29.22,0:05:31.90,Flashbacks,,0,0,0,,Söylesene, kimsin sen, küçük fare?
Dialogue: 0,0:05:47.01,0:05:50.33,Flashbacks,,0,0,0,,Köyde ne yapıyordun, Ace?
Dialogue: 0,0:05:52.66,0:05:56.89,Flashbacks,,0,0,0,,Birkaç suçlu, çocuğun biri tarafından ölesiye\Ndövüldüğü için büyük bir curcuna var.
Dialogue: 0,0:05:58.42,0:06:01.14,Flashbacks,,0,0,0,,Ne? Öldüklerini sanmıştım.
Dialogue: 0,0:06:01.14,0:06:07.38,Flashbacks,,0,0,0,,Ne? Sen sorun çıkarınca suçlanan ben oluyorum!
Dialogue: 0,0:06:07.38,0:06:08.61,Flashbacks,,0,0,0,,Beni dinliyor musun, Ace?!
Dialogue: 0,0:06:10.40,0:06:15.45,Flashbacks,,0,0,0,,Üfff! Böyle baş belasının tekini\Nbenim başıma nasıl sarar?
Dialogue: 0,0:06:15.87,0:06:18.56,Flashbacks,,0,0,0,,Roger hakkında bir şeyler mi bilmek istiyorsun?
Dialogue: 0,0:06:24.49,0:06:25.70,Flashbacks,,0,0,0,,O sadece...
Dialogue: 0,0:06:26.27,0:06:28.57,Flashbacks,,0,0,0,,...bir yalancı ve katil!
Dialogue: 0,0:06:29.08,0:06:31.24,Flashbacks,,0,0,0,,"Korsanlar Kralı"? Beni güldürme!
Dialogue: 0,0:06:31.24,0:06:34.19,Flashbacks,,0,0,0,,Korsanlar Kralı falan değildi,\Ndaha çok Saçmalık Kralı'ydı!
Dialogue: 0,0:06:34.19,0:06:36.41,Flashbacks,,0,0,0,,Cidden öyle!
Dialogue: 0,0:06:40.45,0:06:42.15,Flashbacks,,0,0,0,,Roger?
Dialogue: 0,0:06:42.15,0:06:46.40,Flashbacks,,0,0,0,,Böyle iğrenç isimleri söyleme çocuk.\NBiramın tadını mahvediyorsun.
Dialogue: 0,0:06:46.40,0:06:47.99,Flashbacks,,0,0,0,,Kaybol.
Dialogue: 0,0:06:48.76,0:06:50.29,Flashbacks,,0,0,0,,Niye bana öyle bakıyorsun?!
Dialogue: 0,0:06:52.71,0:06:56.22,Flashbacks,,0,0,0,,Hey! Ne yapıyorsun, lanet olası velet?!
Dialogue: 0,0:07:02.97,0:07:05.84,Flashbacks,,0,0,0,,Niye pestilin çıkmış durumda?
Dialogue: 0,0:07:12.25,0:07:13.31,Flashbacks,,0,0,0,,Hey, Ace!
Dialogue: 0,0:07:14.36,0:07:17.25,Flashbacks,,0,0,0,,Görünüşe göre son zamanlarda\Nçok sorun çıkarıyormuşsun.
Dialogue: 0,0:07:21.29,0:07:22.82,Flashbacks,,0,0,0,,Dede...
Dialogue: 0,0:07:23.39,0:07:25.36,Flashbacks,,0,0,0,,Bir torunun var, değil mi?
Dialogue: 0,0:07:27.18,0:07:28.96,Flashbacks,,0,0,0,,Sana mutlu görünüyor mu?
Dialogue: 0,0:07:30.04,0:07:33.03,Flashbacks,,0,0,0,,Ah, Luffy'yi mi?
Dialogue: 0,0:07:33.03,0:07:35.43,Flashbacks,,0,0,0,,Onu iyi yetiştiriyorum.
Dialogue: 0,0:07:36.36,0:07:37.27,Flashbacks,,0,0,0,,Dede.
Dialogue: 0,0:07:41.49,0:07:43.51,Flashbacks,,0,0,0,,Benim...
Dialogue: 0,0:07:45.82,0:07:48.37,Flashbacks,,0,0,0,,...doğmam iyi miydi?
Dialogue: 0,0:07:54.35,0:07:56.73,Flashbacks,,0,0,0,,Bunu...
Dialogue: 0,0:07:58.24,0:08:01.49,Flashbacks,,0,0,0,,...hayatta olduğun sürece er geç öğreneceksin.
Dialogue: 0,0:08:06.83,0:08:09.63,Main,,0,0,0,,Hasır Şapkalı çocuğu hemen gemiye getirin!
Dialogue: 0,0:08:10.36,0:08:13.73,Thoughts,,0,0,0,,{\i1}İş bu noktaya geldiğine göre,\NAce çocuğu kendimiz kurtarmalıyız!{\i0}
Dialogue: 0,0:08:16.61,0:08:18.08,Main,,0,0,0,,Iva{\i1}-chan{\i0}...
Dialogue: 0,0:08:19.47,0:08:20.91,Main,,0,0,0,,Hala kendinde misin?
Dialogue: 0,0:08:24.08,0:08:26.42,Main,,0,0,0,,Senden son bir iyilik isteyeceğim.
Dialogue: 0,0:08:30.70,0:08:33.73,Main,,0,0,0,,Sadece biraz daha! Geliyoruz, Ace!
Dialogue: 0,0:08:33.73,0:08:36.53,Main,,0,0,0,,Yolu açın!
Dialogue: 0,0:08:38.88,0:08:40.19,Main,,0,0,0,,Ben...
Dialogue: 0,0:08:42.18,0:08:43.84,Main,,0,0,0,,Lanet olsun!
Dialogue: 0,0:08:50.50,0:08:56.05,Main,,0,0,0,,Ace-san, bekle beni! Hayatım\Npahasına da olsa seni kurtaracağım!
Dialogue: 0,0:08:56.05,0:08:57.81,Main,,0,0,0,,Neredeyse vardık!
Dialogue: 0,0:08:59.75,0:09:01.50,Main,,0,0,0,,Geliyoruz, Ace!
Dialogue: 0,0:09:03.88,0:09:06.55,Main,,0,0,0,,Ace! Seni kesinlikle kurtaracağız!
Dialogue: 0,0:09:06.55,0:09:08.31,Main,,0,0,0,,Bekle bizi, Ace!
Dialogue: 0,0:09:08.31,0:09:10.56,Main,,0,0,0,,Sakın pes etme!
Dialogue: 0,0:09:13.59,0:09:17.63,Main,,0,0,0,,Lanet olsun! Neyim var benim?!\NBunun sırası değil...
Dialogue: 0,0:09:18.41,0:09:22.30,Main,,0,0,0,,Babalık, kardeşim ve tayfam...
Dialogue: 0,0:09:22.30,0:09:25.04,Main,,0,0,0,,...düşüyor ve daha...
Dialogue: 0,0:09:25.60,0:09:29.36,Main,,0,0,0,,"Son bir iyilik mi?!" Böyle\Nuğursuz şeyler söyleme!
Dialogue: 0,0:09:31.90,0:09:33.31,Main,,0,0,0,,Lütfen bana...
Dialogue: 0,0:09:35.36,0:09:37.81,Main,,0,0,0,,Çok mutluyum.
Dialogue: 0,0:09:37.81,0:09:40.26,Main,,0,0,0,,Gözyaşlarım durmuyor.
Dialogue: 0,0:09:42.23,0:09:44.05,Main,,0,0,0,,İş bu noktaya gelmişken bile...
Dialogue: 0,0:09:44.05,0:09:46.76,Main,,0,0,0,,...yaşamak istiyorum.
Dialogue: 0,0:09:53.98,0:09:56.24,Main,,0,0,0,,Kaptan Buggy, kendine geldin!
Dialogue: 0,0:09:56.24,0:09:57.29,Main,,0,0,0,,Hayattasın!
Dialogue: 0,0:09:57.29,0:09:58.74,Main,,0,0,0,,Hele şükür!
Dialogue: 0,0:10:00.22,0:10:01.98,Main,,0,0,0,,Bana ne oldu?
Dialogue: 0,0:10:01.98,0:10:05.00,Main,,0,0,0,,{\fad(0,350)}Aokiji tarafından donduruldun.
Dialogue: 0,0:10:14.40,0:10:16.08,Main,,0,0,0,,Olamaz!
Dialogue: 0,0:10:21.04,0:10:24.79,Main,,0,0,0,,Duyun beni, Denizciler!\NHazırlansanız iyi edersiniz!
Dialogue: 0,0:10:24.79,0:10:27.57,Main,,0,0,0,,Böyle sona ermesine izin verecek\Ntürden biri olduğumu sanmayın sakın!
Dialogue: 0,0:10:27.57,0:10:32.31,Main,,0,0,0,,Evet! Çok geçmeden intikamımızı alacağız!\NSenden daha azını beklemezdim!
Dialogue: 0,0:10:32.31,0:10:34.28,Main,,0,0,0,,Kesinlikle arkadaşım!
Dialogue: 0,0:10:35.13,0:10:37.82,Thoughts,,0,0,0,,{\i1}Ama... ne yapacağım?!{\i0}
Dialogue: 0,0:10:37.82,0:10:41.16,Main,,0,0,0,,Çekil, magma velet!
Dialogue: 0,0:10:54.87,0:10:56.33,Main,,0,0,0,,Lanet olsun.
Dialogue: 0,0:10:56.71,0:10:57.50,Main,,0,0,0,,Babalık!
Dialogue: 0,0:11:00.61,0:11:03.89,Main,,0,0,0,,Sen bile yaşlıyken dövüşemiyorsun,...
Dialogue: 0,0:11:03.89,0:11:05.56,Main,,0,0,0,,...Beyazsakal?
Dialogue: 0,0:11:06.54,0:11:08.58,Main,,0,0,0,,En çok korktuğumuz tek şey...
Dialogue: 0,0:11:11.39,0:11:16.07,Flashbacks,,0,0,0,,Düşman benim için üzülsün falan\Ndiye mi bunları takmamı istiyorsunuz?!
Dialogue: 0,0:11:16.07,0:11:17.25,Thoughts,,0,0,0,,{\i1}Babalık...{\i0}
Dialogue: 0,0:11:18.26,0:11:22.82,Main,,0,0,0,,Bir anlığına bile tedbiri elden\Nbıraktığında dövüş biter.
Dialogue: 0,0:11:25.36,0:11:26.36,Main,,0,0,0,,Marco!
Dialogue: 0,0:11:28.44,0:11:30.47,Main,,0,0,0,,Dikkatin dağıldı, değil mi?
Dialogue: 0,0:11:34.06,0:11:35.34,Main,,0,0,0,,Jozu!
Dialogue: 0,0:11:40.43,0:11:46.20,Main,,0,0,0,,Şimdi, sanırım seni öbür dünyaya\Ngönderme vaktim geldi!
Dialogue: 0,0:11:56.33,0:11:57.66,Main,,0,0,0,,Babalık!
Dialogue: 0,0:11:59.83,0:12:01.07,Main,,0,0,0,,Hey, Babalık...
Dialogue: 0,0:12:01.07,0:12:02.47,Main,,0,0,0,,Ne?!
Dialogue: 0,0:12:03.87,0:12:07.43,Main,,0,0,0,,Gerilim Hormonları'ndan\Nbir kez daha mı istiyorsun?
Dialogue: 0,0:12:07.43,0:12:09.05,Main,,0,0,0,,Bu çok pervasızca!
Dialogue: 0,0:12:09.87,0:12:14.21,Main,,0,0,0,,Mümkün değil! Sen ve ben birlikte\NImpel Down'dan kaçtık, değil mi?!
Dialogue: 0,0:12:14.94,0:12:18.90,Main,,0,0,0,,Bedenin ölümcül biçimde zehirlendi\Nve ölümün eşiğinden geri getirildi.
Dialogue: 0,0:12:18.90,0:12:20.99,Main,,0,0,0,,Sınırını çoktan aştı!
Dialogue: 0,0:12:22.20,0:12:28.43,Main,,0,0,0,,Daha önce söylemedim mi? Gerilim Hormonları\Nacil durum tedavisinden başka bir şey değil!
Dialogue: 0,0:12:28.43,0:12:33.66,Main,,0,0,0,,Bedenini kandırmaya devam edersem,\Nher şey bittikten sonra kesinlikle öleceksin!
Dialogue: 0,0:12:41.19,0:12:42.70,Main,,0,0,0,,Elimden geleni yapabildiğim sürece,...
Dialogue: 0,0:12:46.81,0:12:49.18,Main,,0,0,0,,...ölmek umrumda değil!
Dialogue: 0,0:12:50.89,0:12:53.71,Main,,0,0,0,,Lütfen dövüşmeme izin ver, Iva-chan!
Dialogue: 0,0:12:58.90,0:13:00.59,Main,,0,0,0,,Babalık'ın işi bitti!
Dialogue: 0,0:13:00.59,0:13:02.09,Main,,0,0,0,,Marco! Jozu!
Dialogue: 0,0:13:04.32,0:13:06.93,Main,,0,0,0,,Şimdi dövüşmezsem...
Dialogue: 0,0:13:06.93,0:13:09.83,Main,,0,0,0,,Ace'i kurtaramazsam,...
Dialogue: 0,0:13:09.83,0:13:10.57,Main,,0,0,0,,Ben de...
Dialogue: 0,0:13:13.05,0:13:14.87,Main,,0,0,0,,...ölmeyi isteyeceğim!
Dialogue: 0,0:13:17.68,0:13:21.25,Main,,0,0,0,,Lütfen bana dövüşecek güç ver!
Dialogue: 0,0:13:27.19,0:13:28.19,Main,,0,0,0,,Dediğim gibi,...
Dialogue: 0,0:13:28.70,0:13:33.83,Main,,0,0,0,,...ölmene izin verirsem,\NDragon'un yüzüne bakamam!
Dialogue: 0,0:13:33.83,0:13:36.29,Main,,0,0,0,,Seni küstah ahmak!
Dialogue: 0,0:13:42.11,0:13:43.57,Main,,0,0,0,,Ace...
Dialogue: 0,0:13:48.31,0:13:49.40,Main,,0,0,0,,Tamam!
Dialogue: 0,0:13:51.70,0:13:52.97,Main,,0,0,0,,Her ne istersen...
Dialogue: 0,0:13:52.97,0:13:55.63,Main,,0,0,0,,...yap!
Dialogue: 0,0:13:59.54,0:14:01.94,Main,,0,0,0,,Hey, sen! Hasır Şapka'ya ne yapıyorsun?
Dialogue: 0,0:14:16.39,0:14:17.97,Main,,0,0,0,,H-Hasır Şapka...
Dialogue: 0,0:14:20.81,0:14:26.51,Main,,0,0,0,,İ-İmkânsız! Doğrudan Kizaru-san'ın saldırısına maruz kalınca ölümün eşiğinde olduğunu düşünmüştüm!
Dialogue: 0,0:14:29.91,0:14:31.18,Main,,0,0,0,,Luffy...
Dialogue: 0,0:14:31.18,0:14:34.99,Main,,0,0,0,,Ace!
Dialogue: 0,0:14:37.49,0:14:40.97,Main,,0,0,0,,Hasır Şapkalı çocuk, seni uyarmalıyım.
Dialogue: 0,0:14:40.97,0:14:45.80,Main,,0,0,0,,Bir dahaki düşüşünde ne kadar ısrar edersen et, seni geri getiremeyeceğim!
Dialogue: 0,0:14:47.83,0:14:48.83,Main,,0,0,0,,Onlar!
Dialogue: 0,0:14:56.65,0:14:57.78,Main,,0,0,0,,Dur!
Dialogue: 0,0:14:57.78,0:14:59.96,Main,,0,0,0,,Ace'i yine idam etmeye çalışıyorlar!
Dialogue: 0,0:15:00.59,0:15:05.35,Main,,0,0,0,,Elbette. Bu durumda Hasır Şapkalı çocuğu\Ndurdurmak için söyleyebileceğim bir şey yok.
Dialogue: 0,0:15:06.85,0:15:12.78,Main,,0,0,0,,Şu anda yapabileceğim tek şey,\Ndüşmediğinden emin olmak!
Dialogue: 0,0:15:12.78,0:15:13.79,Main,,0,0,0,,Hasır Şapka!
Dialogue: 0,0:15:13.79,0:15:15.86,Main,,0,0,0,,Hasır Şapka geldi!
Dialogue: 0,0:15:15.86,0:15:17.96,Main,,0,0,0,,Hasır Şapka'yı indirin!
Dialogue: 0,0:15:26.14,0:15:27.91,Main,,0,0,0,,Ben hallederim!
Dialogue: 0,0:15:41.56,0:15:44.56,Main,,0,0,0,,Daha bitmedi! Geçmesine izin veremeyiz!
Dialogue: 0,0:15:44.56,0:15:46.32,Main,,0,0,0,,Devam etmek istiyorsan,...
Dialogue: 0,0:15:46.32,0:15:49.07,Main,,0,0,0,,...hepimizle dövüşmelisin!
Dialogue: 0,0:15:49.07,0:15:51.93,Main,,0,0,0,,Sana Denizci ruhunu göstereceğiz!
Dialogue: 0,0:16:02.17,0:16:04.33,Main,,0,0,0,,Çekil yoldan!
Dialogue: 0,0:16:04.33,0:16:06.60,Main,,0,0,0,,{\fad(150,150)}Ölüm Göz Kırpışı!
Dialogue: 0,0:16:09.46,0:16:11.63,Main,,0,0,0,,Sana destek olacağım!
Dialogue: 0,0:16:11.63,0:16:13.26,Main,,0,0,0,,Sağol, Iva-chan!
Dialogue: 0,0:16:22.39,0:16:23.39,Main,,0,0,0,,Luffy{\i1}-san{\i0}...
Dialogue: 0,0:16:28.46,0:16:29.53,Main,,0,0,0,,Coby!
Dialogue: 0,0:16:35.86,0:16:40.37,Main,,0,0,0,,Evet, gerçek Denizci olmak için...
Dialogue: 0,0:16:41.70,0:16:44.64,Main,,0,0,0,,...dövüşmek zorundayım\N yoksa ilerleyemeyeceğim...
Dialogue: 0,0:16:44.64,0:16:46.51,Main,,0,0,0,,Burası savaş alanı!
Dialogue: 0,0:16:49.02,0:16:52.99,Main,,0,0,0,,Onu öldürmeye hazırlanmalıyım!
Dialogue: 0,0:16:56.19,0:16:57.77,Main,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 0,0:17:02.27,0:17:03.07,Main,,0,0,0,,{\fad(150,150)}Kazı!
Dialogue: 0,0:17:06.41,0:17:09.71,Main,,0,0,0,,{\fad(150,150)}Mermi
Dialogue: 0,0:17:16.57,0:17:19.22,Thoughts,,0,0,0,,{\i1}Gerçekten güçlü.{\i0}
Dialogue: 0,0:17:26.62,0:17:28.14,Main,,0,0,0,,Şimdi ne var?!
Dialogue: 0,0:17:28.14,0:17:29.39,Main,,0,0,0,,Siz...
Dialogue: 0,0:17:29.69,0:17:31.38,Main,,0,0,0,,...Kuma taklitleri!
Dialogue: 0,0:17:32.92,0:17:34.57,Main,,0,0,0,,Monkey D. Luffy...
Dialogue: 0,0:17:34.57,0:17:36.73,Main,,0,0,0,,Kahretsin... Bu herifler baş belası!
Dialogue: 0,0:17:50.54,0:17:52.26,Main,,0,0,0,,Bu çok tehlikeli!
Dialogue: 0,0:17:53.80,0:17:56.56,Main,,0,0,0,,Boa Hancock... Yedi Savaş Lordu'ndan biri.
Dialogue: 0,0:17:58.02,0:18:01.02,Main,,0,0,0,,Ateşkes. O müttefik.
Dialogue: 0,0:18:01.02,0:18:03.34,Main,,0,0,0,,Doğru... Siz müttefiksiniz!
Dialogue: 0,0:18:03.34,0:18:05.11,Main,,0,0,0,,Sağol, Hancock!
Dialogue: 0,0:18:07.19,0:18:11.14,Main,,0,0,0,,O İmparatoriçe, değil mi?\NOnu nereden tanıyorsun?
Dialogue: 0,0:18:11.47,0:18:14.91,Main,,0,0,0,,Luffy! Yine adımı söyledin....
Dialogue: 0,0:18:15.60,0:18:17.99,Main,,0,0,0,,Çekil. Boa Hancock.
Dialogue: 0,0:18:18.47,0:18:21.40,Main,,0,0,0,,Adımı söyleme iznini size ne zaman verdim?!
Dialogue: 0,0:18:30.95,0:18:33.10,Main,,0,0,0,,Babalık.
Dialogue: 0,0:18:34.10,0:18:36.97,Main,,0,0,0,,Hemen geliyorum.
Dialogue: 0,0:18:39.23,0:18:41.27,Main,,0,0,0,,Gardını düşürmüşsün.
Dialogue: 0,0:18:42.69,0:18:44.74,Main,,0,0,0,,Babalık!
Dialogue: 0,0:18:44.74,0:18:48.28,Main,,0,0,0,,Ah, sanırım o kadar kolay değil.
Dialogue: 0,0:18:48.28,0:18:51.73,Main,,0,0,0,,Yenilenebiliyorsun, değil mi, Ankakuşu Marco?
Dialogue: 0,0:18:52.32,0:18:55.16,Main,,0,0,0,,Hey, sıra sende.
Dialogue: 0,0:19:05.42,0:19:06.20,Main,,0,0,0,,Deniz taşı?!
Dialogue: 0,0:19:09.66,0:19:10.96,Main,,0,0,0,,Kumandan Marco!
Dialogue: 0,0:19:13.86,0:19:17.97,Main,,0,0,0,,Oh, bu acı verici görünüyor.
Dialogue: 0,0:19:19.21,0:19:20.73,Main,,0,0,0,,Kumandan Jozu da yenildi!
Dialogue: 0,0:19:26.02,0:19:29.71,Main,,0,0,0,,Kumandanlar birbiri ardına düşüyor!
Dialogue: 0,0:19:29.71,0:19:34.16,Main,,0,0,0,,Beyazsakal Korsanları düştü.
Dialogue: 0,0:19:41.00,0:19:41.89,Main,,0,0,0,,Babalık!
Dialogue: 0,0:19:42.79,0:19:44.23,Main,,0,0,0,,Seni canavar Balıkadam!
Dialogue: 0,0:19:45.34,0:19:46.87,Main,,0,0,0,,Bırakın beni!
Dialogue: 0,0:19:47.21,0:19:48.83,Main,,0,0,0,,Sallanmayın!
Dialogue: 0,0:19:49.79,0:19:53.00,Main,,0,0,0,,Hep birden saldırın ve\NBeyazsakal'ın başını alın!
Dialogue: 0,0:20:05.63,0:20:08.02,Main,,0,0,0,,Babalık!
Dialogue: 0,0:20:13.42,0:20:15.26,Main,,0,0,0,,Babalık!
Dialogue: 0,0:20:15.48,0:20:16.89,Main,,0,0,0,,Geri durun!
Dialogue: 0,0:20:21.03,0:20:26.37,Main,,0,0,0,,Bu adamlar gerçekten...
Dialogue: 0,0:20:29.04,0:20:32.54,Main,,0,0,0,,...beni o kadar kolay\Nöldürebileceklerini mi sanıyorlar?!
Dialogue: 0,0:20:34.89,0:20:39.38,Main,,0,0,0,,Yardıma ihtiyacım yok.
Dialogue: 0,0:20:42.00,0:20:43.25,Main,,0,0,0,,Ben...
Dialogue: 0,0:20:43.98,0:20:47.80,Main,,0,0,0,,Ben Beyazsakalım!
Dialogue: 0,0:21:40.43,0:21:42.30,Main,,0,0,0,,C-Canavar bu adam!
Dialogue: 0,0:21:53.10,0:21:56.61,Main,,0,0,0,,Ölümümün ne anlama geleceğini...
Dialogue: 0,0:21:59.40,0:22:04.00,Main,,0,0,0,,...gerçekten anlamıyor musunuz?
Dialogue: 0,0:22:04.52,0:22:06.77,Main,,0,0,0,,Biliyorum.
Dialogue: 0,0:22:11.29,0:22:14.14,Main,,0,0,0,,Bu olsaydı...
Dialogue: 0,0:22:14.92,0:22:19.88,Main,,0,0,0,,...gözlerim oğullarımın önündeki\Nparlak geleceği göremezdi.
Dialogue: 0,0:22:21.99,0:22:26.88,Main,,0,0,0,,Ölmeme izin veremem, değil mi?!
Dialogue: 0,0:22:34.30,0:22:36.76,Main,,0,0,0,,Değil mi, Ace?
Dialogue: 0,0:22:40.92,0:22:42.24,Main,,0,0,0,,Babalık...
Dialogue: 0,0:22:49.15,0:22:50.48,Main,,0,0,0,,Sadece ölmeyi reddediyorsun!
Dialogue: 0,0:22:53.52,0:22:54.69,Main,,0,0,0,,O da neydi?
Dialogue: 0,0:22:59.76,0:23:05.01,Main,,0,0,0,,B-Bu herifler de ne?!\NBeyazsakal'ın arkasını kolluyorlar.
Dialogue: 0,0:23:05.56,0:23:08.43,Main,,0,0,0,,Beyazsakal'la birlikte ölmeyi mi düşünüyorlar?!
Dialogue: 0,0:23:10.00,0:23:12.76,Main,,0,0,0,,Siz asla anlamazsınız!
Dialogue: 0,0:23:14.54,0:23:17.62,Main,,0,0,0,,Babalık'ın onurunu koruyacağız!
Dialogue: 0,0:23:20.41,0:23:25.18,Main,,0,0,0,,Fazla heyecan yapıyorsunuz, ahmaklar!
Dialogue: 0,0:23:25.93,0:23:31.09,Main,,0,0,0,,Geleceği görmek istiyorsun,\Nsana hemen göstereceğim, Beyazsakal!
Dialogue: 0,0:23:31.58,0:23:32.57,Main,,0,0,0,,Yapın!
Dialogue: 0,0:23:37.09,0:23:39.43,Main,,0,0,0,,Ace!
Dialogue: 0,0:23:41.58,0:23:43.00,Main,,0,0,0,,Ace!
Dialogue: 0,0:23:44.67,0:23:46.34,Main,,0,0,0,,İşe yaramayacak!
Dialogue: 0,0:23:46.88,0:23:50.17,Main,,0,0,0,,Bunun beni durduracağını mı...
Dialogue: 0,0:23:57.45,0:24:00.28,Main,,0,0,0,,Seyret, Beyazsakal!
Dialogue: 0,0:24:04.12,0:24:05.02,Main,,0,0,0,,Durun!
Dialogue: 0,0:24:21.97,0:24:22.91,Main,,0,0,0,,Durun!
Dialogue: 0,0:24:39.66,0:24:46.26,Main,,0,0,0,,Durun!
Dialogue: 0,0:25:20.54,0:25:23.78,Main,,0,0,0,,Şimdi geliyorum!
Dialogue: 0,0:25:23.78,0:25:25.77,Main,,0,0,0,,Ne yaptın sen?!
Dialogue: 0,0:25:25.77,0:25:28.61,Main,,0,0,0,,Galip Kralın Hakisi?!
Dialogue: 0,0:25:30.46,0:25:32.81,Main,,0,0,0,,Hey, hey! Cidden mi?!
Dialogue: 0,0:25:35.20,0:25:37.78,Main,,0,0,0,,Ne şaşırtıcı.
Dialogue: 0,0:25:48.49,0:25:50.59,Main,,0,0,0,,O çocuk...
Dialogue: 0,0:00:25.37,0:00:30.62,OP13-Translation,,0,0,0,karaoke,{\i1}♪ Her seferinde yağmurdan sonra gökyüzüne bakıyorum. ♪{\i0}
Dialogue: 0,0:00:30.62,0:00:36.13,OP13-Translation,,0,0,0,karaoke,{\i1}♪ Henüz sulugöz olduğum zamanları düşünüyorum. ♪{\i0}
Dialogue: 0,0:00:36.13,0:00:43.87,OP13-Translation,,0,0,0,karaoke,{\i1}♪ Umutsuzca birinin arkasından koşuyorum,... ♪{\i0}
Dialogue: 0,0:00:43.94,0:00:46.85,OP13-Translation,,0,0,0,karaoke,{\i1}♪ ..."Daha güçlü olmak istiyorum," diye düşünerek. ♪{\i0}
Dialogue: 0,0:00:46.85,0:00:52.03,OP13-Translation,,0,0,0,karaoke,{\i1}♪ "Teşekkürüm" şimdi rüzgârda kayboldu,... ♪{\i0}
Dialogue: 0,0:00:52.20,0:00:57.21,OP13-Translation,,0,0,0,karaoke,{\i1}♪ ...daha güçlü olabilir miyim? ♪{\i0}
Dialogue: 0,0:00:57.41,0:01:02.88,OP13-Translation,,0,0,0,karaoke,{\i1}♪ Cevabımı bulamıyorum. ♪{\i0}
Dialogue: 0,0:01:03.01,0:01:08.40,OP13-Translation,,0,0,0,karaoke,{\i1}♪ Bu yüzden ilerlemeye devam edeceğim. ♪{\i0}
Dialogue: 0,0:01:08.55,0:01:11.03,OP13-Translation,,0,0,0,karaoke,{\i1}♪ Gel hadi, gidelim. ♪{\i0}
Dialogue: 0,0:01:11.03,0:01:14.24,OP13-Translation,,0,0,0,karaoke,{\i1}♪ Asla pes etmeyeceğiz. ♪{\i0}
Dialogue: 0,0:01:14.24,0:01:19.48,OP13-Translation,,0,0,0,karaoke,{\i1}♪ Zamanın dalgalarına yenik düşmeyeceğiz. ♪{\i0}
Dialogue: 0,0:01:19.48,0:01:25.09,OP13-Translation,,0,0,0,karaoke,{\i1}♪ Tekrar tekrar ayağa kalkacağız. ♪{\i0}
Dialogue: 0,0:01:25.10,0:01:30.73,OP13-Translation,,0,0,0,karaoke,{\i1}♪ Çünkü bizim için önemli olanı kaybetmek istemiyoruz. ♪{\i0}
Dialogue: 0,0:01:30.74,0:01:35.85,OP13-Translation,,0,0,0,karaoke,{\i1}♪ Beni sürekli, sürekli ilerlemeye zorlayan... ♪{\i0}
Dialogue: 0,0:01:35.86,0:01:41.25,OP13-Translation,,0,0,0,karaoke,{\i1}♪ ...kafamdaki sesi duyabiliyorum. ♪{\i0}
Dialogue: 0,0:01:41.25,0:01:46.38,OP13-Translation,,0,0,0,karaoke,{\i1}♪ Haylaz yağmur bana engel olurken bile... ♪{\i0}
Dialogue: 0,0:01:46.39,0:01:51.32,OP13-Translation,,0,0,0,karaoke,{\i1}♪ ...kaçmaya çalışmayacağım. ♪{\i0}
Dialogue: 0,0:01:54.42,0:01:56.78,OP13-Translation,,0,0,0,karaoke,{\i1}♪ Gel hadi, gidelim. ♪{\i0}
Dialogue: 0,0:01:56.78,0:02:00.06,OP13-Translation,,0,0,0,karaoke,{\i1}♪ Asla pes etmeyeceğiz. ♪{\i0}
Dialogue: 0,0:02:00.06,0:02:05.35,OP13-Translation,,0,0,0,karaoke,{\i1}♪ Zamanın dalgalarına yenik düşmeyeceğiz. ♪{\i0}
Dialogue: 0,0:02:05.36,0:02:10.99,OP13-Translation,,0,0,0,karaoke,{\i1}♪ Tekrar tekrar ayağa kalkacağız. ♪{\i0}
Dialogue: 0,0:02:10.99,0:02:16.35,OP13-Translation,,0,0,0,karaoke,{\i1}♪ Çünkü bizim için önemli olanı kaybetmek istemiyoruz. ♪{\i0}
Dialogue: 0,0:02:16.36,0:02:22.05,OP13-Translation,,0,0,0,karaoke,{\i1}♪ İnandığımız geleceğe doğru ilerleyelim. ♪{\i0}
