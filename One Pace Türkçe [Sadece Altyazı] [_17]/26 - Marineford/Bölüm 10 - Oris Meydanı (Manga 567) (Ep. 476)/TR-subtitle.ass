Dialogue: 0,0:05:26.51,0:05:36.51,Author,,0,0,0,,{\fad(500,500)\fs18} Türkçeleştirme & Çevirmen  {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&} - {\c&H01BAFF&}{\b1}kazasker{\b0}{\c&HFFFFFF&}
Dialogue: 0,0:14:30.00,0:14:40.00,Author,,0,0,0,,{\fad(500,500)\fs18} Türkçeleştirme & Çevirmen  {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&} - {\c&H01BAFF&}{\b1}kazasker{\b0}{\c&HFFFFFF&}
Dialogue: 0,0:00:01.06,0:00:03.62,Main,,0,0,0,,Denizci Karargâhı'nı yok edin!
Dialogue: 0,0:00:11.02,0:00:13.86,Main,,0,0,0,,Atış menzilimden uzak durun.
Dialogue: 0,0:00:17.86,0:00:20.33,Main,,0,0,0,,İşte yine geliyor!
Dialogue: 0,0:00:25.64,0:00:27.21,Main,,0,0,0,,{\fad(150,150)}Buz Topu
Dialogue: 0,0:00:43.22,0:00:45.86,Main,,0,0,0,,– Beyazsakal'ı dondurdu!\N– Başardınız!
Dialogue: 0,0:00:57.14,0:00:58.50,Main,,0,0,0,,Ah...
Dialogue: 0,0:00:58.50,0:01:02.04,Main,,0,0,0,,Görünüşe göre deprem adamı donduramıyorum.
Dialogue: 0,0:01:03.17,0:01:04.21,Main,,0,0,0,,{\fad(150,150)}Buz...
Dialogue: 0,0:01:09.06,0:01:10.72,Main,,0,0,0,,Amiral Kuzan!
Dialogue: 0,0:01:10.72,0:01:14.19,Main,,0,0,0,,– Onu Haki'yle deldi!\N– Aokiji öldü mü?
Dialogue: 0,0:01:20.56,0:01:23.56,Main,,0,0,0,,Hayır! Saçmalamayın.
Dialogue: 0,0:01:28.73,0:01:31.10,Main,,0,0,0,,{\fad(150,150)}Buz Blok Ortaçağ Mızrağı!
Dialogue: 0,0:01:51.43,0:01:53.21,Main,,0,0,0,,Babalık, sen git!
Dialogue: 0,0:01:53.21,0:01:55.13,Main,,0,0,0,,Sana güveniyorum.
Dialogue: 0,0:02:00.53,0:02:03.06,Main,,0,0,0,,Elmas Jozu...
Dialogue: 0,0:02:11.63,0:02:13.85,Main,,0,0,0,,Neredeyse vardık!
Dialogue: 0,0:02:17.81,0:02:19.55,Main,,0,0,0,,İdam sehpasını görebiliyorum.
Dialogue: 0,0:02:19.55,0:02:22.32,Main,,0,0,0,,Bu karmaşada yarıp gitmeliyiz!
Dialogue: 0,0:02:22.32,0:02:24.10,Main,,0,0,0,,İzin vermeyeceğim!
Dialogue: 0,0:02:24.10,0:02:27.19,Main,,0,0,0,,Hepiniz burada öleceksiniz!
Dialogue: 0,0:02:38.20,0:02:39.71,Main,,0,0,0,,A-Ace...
Dialogue: 0,0:05:26.51,0:05:29.07,Title,,0,0,0,,{\fad(500,0)\pos(645,485)}Oris Meydanı
Dialogue: 0,0:05:30.61,0:05:32.64,Main,,0,0,0,,Hasır Şapkalı Luffy...
Dialogue: 0,0:05:32.64,0:05:38.45,Main,,0,0,0,,Ben, Momonga, Denizci koramirali olarak seni\Nburada durdurmak için, onurumu ortaya koyuyorum!
Dialogue: 0,0:05:38.45,0:05:41.85,Main,,0,0,0,,Koramiral... Demek dedemle aynısın, öyle mi?
Dialogue: 0,0:05:41.85,0:05:42.86,Main,,0,0,0,,{\fad(150,150)}Kazı!
Dialogue: 0,0:05:44.09,0:05:45.09,Main,,0,0,0,,{\fad(150,150)}Ay Adımı!
Dialogue: 0,0:05:54.87,0:05:56.13,Main,,0,0,0,,{\fad(150,150)}İkinc...!
Dialogue: 0,0:05:57.24,0:05:58.94,Main,,0,0,0,,Düze...
Dialogue: 0,0:06:00.04,0:06:01.67,Main,,0,0,0,,Görünüşe göre gücün tükenmiş!
Dialogue: 0,0:06:01.67,0:06:03.01,Main,,0,0,0,,{\fad(150,150)}Parmak Tabanca
Dialogue: 0,0:06:30.45,0:06:34.07,Main,,0,0,0,,Garp. Konumunu düşün!
Dialogue: 0,0:06:58.33,0:07:01.50,Main,,0,0,0,,Cesaretten fazlasına ihtiyacın var.
Dialogue: 0,0:07:01.50,0:07:03.88,Main,,0,0,0,,Hasır Şapkalı Luffy,...
Dialogue: 0,0:07:03.88,0:07:10.51,Main,,0,0,0,,...yeterli gücün olmadan, ne kadar\Nuğraşsan da kimseyi kurtaramazsın.
Dialogue: 0,0:07:14.90,0:07:17.32,Main,,0,0,0,,A-Ace...
Dialogue: 0,0:07:21.55,0:07:24.89,Main,,0,0,0,, – Beyazsakal'ı öldürün!\N – Buna izin vermeyeceğiz!
Dialogue: 0,0:07:26.99,0:07:29.63,Main,,0,0,0,,Şimdi lütfen yok olur musun?
Dialogue: 0,0:07:37.97,0:07:39.54,Main,,0,0,0,,Ace'in kardeşi!
Dialogue: 0,0:07:40.28,0:07:42.24,Main,,0,0,0,,Ace...
Dialogue: 0,0:07:48.00,0:07:54.09,Main,,0,0,0,,Oh, Beyazsakal'ın komutanlığı körelmiş.
Dialogue: 0,0:07:54.66,0:07:57.56,Main,,0,0,0,,Senin gibi bir adamın,...
Dialogue: 0,0:07:57.56,0:08:02.09,Main,,0,0,0,,...öyle pervasız birinin saldırına...
Dialogue: 0,0:08:02.09,0:08:05.80,Main,,0,0,0,,...liderlik etmesine izin verdiğini düşünsene.
Dialogue: 0,0:08:09.20,0:08:11.97,Main,,0,0,0,,Babalık'a dokunmana izin vermeyeceğiz!
Dialogue: 0,0:08:11.97,0:08:14.93,Main,,0,0,0,,Oh, ne kadar takdire şayan...
Dialogue: 0,0:08:14.93,0:08:17.74,Main,,0,0,0,,İşte orada! Hasır Şapkalı çocuk!
Dialogue: 0,0:08:17.74,0:08:19.95,Main,,0,0,0,,İşte orada, Jinbe!
Dialogue: 0,0:08:20.85,0:08:21.89,Main,,0,0,0,,O da kim?!
Dialogue: 0,0:08:21.89,0:08:23.55,Main,,0,0,0,,O ses nereden geliyor?
Dialogue: 0,0:08:26.61,0:08:28.40,Main,,0,0,0,,Beni görmüyor musunuz?!
Dialogue: 0,0:08:28.40,0:08:31.03,Main,,0,0,0,,Ben Ivankov'um, lanet olsun!
Dialogue: 0,0:08:32.12,0:08:33.15,Main,,0,0,0,,Yukarıda!
Dialogue: 0,0:08:33.15,0:08:35.52,Main,,0,0,0,,Yüzünün büyüklüğü de ne öyle?!
Dialogue: 0,0:08:35.52,0:08:37.36,Main,,0,0,0,,Bu, Devrim Ordusu'ndan Ivankov!
Dialogue: 0,0:08:37.36,0:08:38.30,Main,,0,0,0,,Luffy-{\i1}kun!{\i0}
Dialogue: 0,0:08:38.30,0:08:41.07,Main,,0,0,0,,Hala hayatta mısın, Hasır Şapkalı çocuk?!
Dialogue: 0,0:08:41.07,0:08:43.20,Main,,0,0,0,,Dü... Dü...
Dialogue: 0,0:08:43.20,0:08:45.74,Main,,0,0,0,,Düşmüyorum!
Dialogue: 0,0:08:47.13,0:08:49.14,Main,,0,0,0,,Düştü!
Dialogue: 0,0:08:50.94,0:08:52.86,Main,,0,0,0,,Ne yapıyorsun?!
Dialogue: 0,0:08:52.86,0:08:54.08,Main,,0,0,0,,Üzgünüm.
Dialogue: 0,0:08:55.39,0:08:58.28,Main,,0,0,0,,Ne gürültücü bir adam.
Dialogue: 0,0:09:00.00,0:09:02.65,Main,,0,0,0,,Iva-{\i1}chan{\i0}... Jinbe...
Dialogue: 0,0:09:02.65,0:09:06.19,Main,,0,0,0,,Bırak beni, Yaşlı Adam!
Dialogue: 0,0:09:06.19,0:09:09.40,Main,,0,0,0,,Ben... Ben... Bırak beni!
Dialogue: 0,0:09:09.40,0:09:12.84,Main,,0,0,0,,Yeterince fazlasını yaptı.\NYaralarını tedavi edin.
Dialogue: 0,0:09:12.84,0:09:13.77,Main,,0,0,0,,Tamam!
Dialogue: 0,0:09:13.77,0:09:15.95,Main,,0,0,0,,İhtiyacım yok! Zaman yok!
Dialogue: 0,0:09:15.95,0:09:19.10,Main,,0,0,0,,Gidip onu kurtarmalıyım!\NBana engel olmayın!
Dialogue: 0,0:09:19.10,0:09:22.01,Main,,0,0,0,,Ace... Ace...
Dialogue: 0,0:09:22.01,0:09:23.31,Main,,0,0,0,,Ace...!
Dialogue: 0,0:09:23.44,0:09:28.45,Main,,0,0,0,,Ace dünyadaki tek kardeşim!
Dialogue: 0,0:09:28.45,0:09:29.59,Main,,0,0,0,,Onu...
Dialogue: 0,0:09:29.59,0:09:31.48,Main,,0,0,0,,Onu kesinlikle...
Dialogue: 0,0:09:31.48,0:09:32.94,Main,,0,0,0,,...kesinlikle...
Dialogue: 0,0:09:34.29,0:09:36.12,Main,,0,0,0,,...kurtaracağım!
Dialogue: 0,0:09:43.36,0:09:45.10,Main,,0,0,0,,Luffy-kun! Hey!
Dialogue: 0,0:09:45.10,0:09:46.56,Main,,0,0,0,,Bu çok kötü.
Dialogue: 0,0:09:46.56,0:09:50.57,Main,,0,0,0,,Lütfen doktor! Onu hayatta\Ntutmak için ne gerekiyorsa yap!
Dialogue: 0,0:09:50.80,0:09:53.02,Main,,0,0,0,,Luffy-{\i1}kun!{\i0} Luffy-{\i1}kun!{\i0}
Dialogue: 0,0:09:53.02,0:09:54.84,Main,,0,0,0,,Dayan, Luffy-kun!
Dialogue: 0,0:09:56.26,0:09:59.71,Main,,0,0,0,,Sadece nasıl büyük konuşulacağını\Nbilen gayret yığını...
Dialogue: 0,0:09:59.71,0:10:02.23,Main,,0,0,0,,Genç ve sakar.
Dialogue: 0,0:10:06.08,0:10:09.75,Main,,0,0,0,,Böyle ahmakları seviyorum.
Dialogue: 0,0:10:15.27,0:10:19.00,Main,,0,0,0,,Canını dikkate almayanlar ilerlesin!
Dialogue: 0,0:10:22.33,0:10:24.04,Main,,0,0,0,,Beyazsakal geliyor!
Dialogue: 0,0:10:36.21,0:10:39.68,Main,,0,0,0,,İstediğin gibi kudurmana izin verirsek,...
Dialogue: 0,0:10:39.68,0:10:41.65,Main,,0,0,0,,...ada buna dayanamayacak!
Dialogue: 0,0:10:44.36,0:10:47.23,Main,,0,0,0,,O zaman korumaya çalış!
Dialogue: 0,0:10:47.23,0:10:49.67,Main,,0,0,0,,Benim için Luffy-kun'la ilgilenin.
Dialogue: 0,0:10:49.67,0:10:51.73,Main,,0,0,0,,Jinbe, ya sen?
Dialogue: 0,0:10:52.54,0:10:55.70,Main,,0,0,0,,Burayı öleceğim yer seçtim!
Dialogue: 0,0:11:21.25,0:11:24.73,Main,,0,0,0,,Babalık için yol açmalıyız!
Dialogue: 0,0:11:24.73,0:11:28.45,Main,,0,0,0,,Bunlar da kılıç ustası... Ancak...
Dialogue: 0,0:11:28.45,0:11:31.17,Main,,0,0,0,,...acınası güçsüzler!
Dialogue: 0,0:11:31.87,0:11:33.21,Main,,0,0,0,,Çekilin!
Dialogue: 0,0:11:38.96,0:11:40.84,Main,,0,0,0,,Yol açın!
Dialogue: 0,0:11:41.97,0:11:45.66,Main,,0,0,0,,Luffy'nin yanına gitmeliyim!
Dialogue: 0,0:11:45.66,0:11:47.12,Main,,0,0,0,,Karışmayın!
Dialogue: 0,0:11:47.12,0:11:48.55,Main,,0,0,0,,Bu çok kötü!
Dialogue: 0,0:11:48.55,0:11:52.02,Main,,0,0,0,,Boa Hancock yine gelişigüzel saldırmaya başladı!
Dialogue: 0,0:11:59.54,0:12:01.57,Main,,0,0,0,,{\fad(150,150)}Köle Oku!
Dialogue: 0,0:12:10.90,0:12:13.55,Main,,0,0,0,,Cesetler yığılmaya devam ediyor!
Dialogue: 0,0:12:30.76,0:12:32.66,Main,,0,0,0,,Babalık'ın yoluna çıkmana izin vermeyeceğim!
Dialogue: 0,0:12:34.78,0:12:38.04,Main,,0,0,0,,Pek tatlı olduğumu sanmıyorum, aslında...
Dialogue: 0,0:12:42.24,0:12:44.41,Main,,0,0,0,,D-Daha bitirmedim... Henüz değil...
Dialogue: 0,0:12:45.77,0:12:48.25,Main,,0,0,0,,Onları geri püskürtün!
Dialogue: 0,0:12:48.25,0:12:50.15,Main,,0,0,0,,O...
Dialogue: 0,0:12:50.15,0:12:53.22,Main,,0,0,0,,Kıyıdan gelen korsan müttefikler!
Dialogue: 0,0:12:53.22,0:12:54.53,Main,,0,0,0,,Beklettiğimiz için üzgünüz!
Dialogue: 0,0:12:55.25,0:12:57.09,Main,,0,0,0,,Evet, sizi bekliyorduk!
Dialogue: 0,0:12:57.09,0:13:00.96,Main,,0,0,0,,Lanet olsun! Çok fazlasının\Nmeydana girmesine izin verdim!
Dialogue: 0,0:13:00.96,0:13:03.23,Main,,0,0,0,,Amcam bana bağıracak!
Dialogue: 0,0:13:03.22,0:13:07.83,Main,,0,0,0,,Bu şartlar altında bazı kayıpların\Nverilmesi kaçınılmaz,...
Dialogue: 0,0:13:07.83,0:13:11.46,Main,,0,0,0,,...ama kendi adamlarımıza vurmamaya çalışın!
Dialogue: 0,0:13:11.46,0:13:13.24,Main,,0,0,0,,Pacifistalar!
Dialogue: 0,0:13:23.68,0:13:25.92,Main,,0,0,0,,Bekle beni, Ace!
Dialogue: 0,0:13:31.99,0:13:33.39,Main,,0,0,0,,Uçuyor!
Dialogue: 0,0:13:33.39,0:13:35.69,Main,,0,0,0,,Ne yapıyorsunuz?! Vurun onu!
Dialogue: 0,0:13:38.53,0:13:40.80,Main,,0,0,0,,Silahlarımız işlemiyor!
Dialogue: 0,0:13:40.80,0:13:43.67,Main,,0,0,0,,Umrumda değil! Ateşe devam edin!
Dialogue: 0,0:13:56.62,0:13:58.45,Main,,0,0,0,,Kumandan Marco!
Dialogue: 0,0:14:09.84,0:14:13.18,Main,,0,0,0,,Kimse kendi başına atlamanı söylemedi!
Dialogue: 0,0:14:13.93,0:14:17.30,Main,,0,0,0,,Kahraman, Monkey D. Garp!
Dialogue: 0,0:14:17.30,0:14:20.95,Main,,0,0,0,,Efsanevi denizci sonunda hamlesini yaptı!
Dialogue: 0,0:14:21.68,0:14:23.65,Main,,0,0,0,,Koramiral Garp!
Dialogue: 0,0:14:26.31,0:14:28.39,Main,,0,0,0,,Koramiral de harekete geçti!
Dialogue: 0,0:14:28.39,0:14:30.35,Main,,0,0,0,,Sahip olduğumuz en iyi muhafız!
Dialogue: 0,0:14:30.99,0:14:32.82,Main,,0,0,0,,Dede...
Dialogue: 0,0:14:33.74,0:14:35.59,Main,,0,0,0,,Garp...
Dialogue: 0,0:14:35.59,0:14:41.19,Main,,0,0,0,,Geçmek istiyorsanız, beni öldürmek zorundasınız!
Dialogue: 0,0:14:42.06,0:14:43.87,Main,,0,0,0,,Sersem çocuklar.
