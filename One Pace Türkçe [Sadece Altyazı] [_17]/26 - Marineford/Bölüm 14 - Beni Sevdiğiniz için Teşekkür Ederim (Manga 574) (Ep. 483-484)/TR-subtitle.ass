Dialogue: 0,0:02:31.41,0:02:43.39,Title,,0,0,150,,{\fad(1800,3000)}Beni Sevdiğiniz için Teşekkür Ederim
Dialogue: 0,0:02:51.89,0:02:54.60,Main,,0,0,0,,Ace...
Dialogue: 0,0:03:19.98,0:03:21.81,Main,,0,0,0,,Ace!
Dialogue: 0,0:03:21.81,0:03:23.86,Main,,0,0,0,,Ace!
Dialogue: 0,0:03:26.57,0:03:28.22,Main,,0,0,0,,Ace-{\i1}san!{\i0}
Dialogue: 0,0:03:34.19,0:03:36.66,Main,,0,0,0,,Ace!
Dialogue: 0,0:03:50.91,0:03:53.61,Main,,0,0,0,,Yaralandı. Lanet olsun!
Dialogue: 0,0:03:57.72,0:04:00.09,Main,,0,0,0,,Akainu'yu durdurun!
Dialogue: 0,0:04:05.16,0:04:07.03,Main,,0,0,0,,Ateş!
Dialogue: 0,0:04:26.62,0:04:29.98,Main,,0,0,0,,Ne olacak?
Dialogue: 0,0:04:56.61,0:05:00.28,Main,,0,0,0,,Olamaz... Canavar mı bu?!
Dialogue: 0,0:05:23.66,0:05:27.17,Main,,0,0,0,,Görünüşe göre hala içinde biraz hayat kalmış,...
Dialogue: 0,0:05:32.26,0:05:33.97,Main,,0,0,0,,Kes şunu...
Dialogue: 0,0:05:33.97,0:05:35.18,Main,,0,0,0,,Kes şunu!
Dialogue: 0,0:05:38.42,0:05:39.58,Main,,0,0,0,,Jinbe!
Dialogue: 0,0:05:41.12,0:05:44.96,Main,,0,0,0,,Onu daha fazla yaralamana izin vermeyeceğim!
Dialogue: 0,0:05:45.44,0:05:48.71,Main,,0,0,0,,Manasız engellemeyi bırak, Jinbe!
Dialogue: 0,0:05:48.71,0:05:51.26,Main,,0,0,0,,Sen eski Savaş Lordu'sun.
Dialogue: 0,0:05:51.26,0:05:54.12,Main,,0,0,0,,Ne kadar güçlü olduğumu bildiğine eminim!
Dialogue: 0,0:05:54.12,0:05:59.52,Main,,0,0,0,,Bedenimin yanmasına izin vermek bize biraz\Nzaman kazandıracaksa, umrumda değil!
Dialogue: 0,0:05:59.52,0:06:03.84,Main,,0,0,0,,Ölmeyi zaten kabullendim!
Dialogue: 0,0:06:05.42,0:06:06.61,Main,,0,0,0,,Jinbe!
Dialogue: 0,0:06:06.61,0:06:09.11,Main,,0,0,0,,Marco! Onu bulduk!
Dialogue: 0,0:06:09.11,0:06:13.91,Main,,0,0,0,,Oh... Beni kurtardınız... Tam da...
Dialogue: 0,0:06:13.91,0:06:16.12,Main,,0,0,0,,Her neyse, hemen şu kelepçeleri çıkar!
Dialogue: 0,0:06:24.50,0:06:27.48,Main,,0,0,0,,K-Koramiral Garp...
Dialogue: 0,0:06:29.09,0:06:30.93,Main,,0,0,0,,Ne...
Dialogue: 0,0:06:30.93,0:06:31.90,Main,,0,0,0,,Garp!
Dialogue: 0,0:06:36.08,0:06:40.56,Main,,0,0,0,,Ne yapmaya çalışıyorsun?! Delirdin mi?!
Dialogue: 0,0:06:40.56,0:06:45.22,Main,,0,0,0,,Beni bırakmasan iyi olur, Sengoku.
Dialogue: 0,0:06:47.61,0:06:53.32,Main,,0,0,0,,Yoksa lanet olası Sakazuki'yi öldüreceğim!
Dialogue: 0,0:06:54.96,0:06:56.63,Main,,0,0,0,,Ahmak!
Dialogue: 0,0:07:01.12,0:07:05.44,Main,,0,0,0,,Demek seni de cezalandırmam lazım, hain.
Dialogue: 0,0:07:10.55,0:07:12.18,Main,,0,0,0,,Jinbe, eğil!
Dialogue: 0,0:07:20.85,0:07:23.71,Main,,0,0,0,,Sinir bozucu!
Dialogue: 0,0:07:25.85,0:07:27.76,Main,,0,0,0,,Haki kullanıcıları mısınız?
Dialogue: 0,0:07:28.61,0:07:30.60,Main,,0,0,0,,Bu nasıl olabilir?!
Dialogue: 0,0:07:30.60,0:07:33.43,Main,,0,0,0,,Ne kadar utanç verici. Onu durdurmayı başaramadık!
Dialogue: 0,0:07:33.43,0:07:37.62,Main,,0,0,0,,Ateş Yumruk için çok geç\Nolduğunu göremiyor musunuz?
Dialogue: 0,0:07:37.62,0:07:39.32,Main,,0,0,0,,İyi bakın!
Dialogue: 0,0:07:53.60,0:07:56.09,Main,,0,0,0,,Ace...
Dialogue: 0,0:07:59.36,0:08:04.04,Main,,0,0,0,,Hey? Beni duyabiliyor musun?
Dialogue: 0,0:08:13.02,0:08:16.81,Main,,0,0,0,,Ace, hemen yaralarını tedavi etmeliyiz.!
Dialogue: 0,0:08:17.39,0:08:20.98,Main,,0,0,0,,Üzgünüm, Luffy.
Dialogue: 0,0:08:24.90,0:08:27.99,Main,,0,0,0,,Sırf benim için...
Dialogue: 0,0:08:28.57,0:08:32.78,Main,,0,0,0,,...bu kadar çılgınca şey yaptın.
Dialogue: 0,0:08:32.78,0:08:36.74,Main,,0,0,0,,Ama yine de kurtarılamadım.
Dialogue: 0,0:08:39.24,0:08:41.33,Main,,0,0,0,,Çok üzgünüm.
Dialogue: 0,0:08:43.25,0:08:45.71,Main,,0,0,0,,N-Ne diyorsun?
Dialogue: 0,0:08:45.71,0:08:47.61,Main,,0,0,0,,Saçmalama!
Dialogue: 0,0:08:47.61,0:08:49.97,Main,,0,0,0,,Biri ona yardım etsin!
Dialogue: 0,0:08:49.97,0:08:52.74,Main,,0,0,0,,Ace... Lütfen Ace'i kurtarın!
Dialogue: 0,0:08:52.74,0:08:57.09,Main,,0,0,0,,Hey? Ace'i kurtarabilecek kimse yok mu? Hadi ama!
Dialogue: 0,0:08:57.09,0:09:00.10,Main,,0,0,0,,Çabuk! Hemen buraya!\NOna acil müdahalede bulunun!
Dialogue: 0,0:09:00.10,0:09:00.95,Main,,0,0,0,,Tamam!
Dialogue: 0,0:09:02.77,0:09:04.66,Main,,0,0,0,,Hasır Şapkalı çocuk...
Dialogue: 0,0:09:04.66,0:09:07.26,Main,,0,0,0,,Ace, iyi misin?
Dialogue: 0,0:09:07.90,0:09:09.61,Main,,0,0,0,,Çabuk! Ace'e yardım et!
Dialogue: 0,0:09:09.61,0:09:11.84,Main,,0,0,0,,Tamam. Bana yarasını göster.
Dialogue: 0,0:09:11.84,0:09:12.83,Main,,0,0,0,,Lütfen!
Dialogue: 0,0:09:16.20,0:09:17.66,Main,,0,0,0,,Bu...
Dialogue: 0,0:09:21.70,0:09:22.75,Main,,0,0,0,,Hey.
Dialogue: 0,0:09:23.49,0:09:26.51,Main,,0,0,0,,Sorun nedir? Hemen kurtar onu!
Dialogue: 0,0:09:28.22,0:09:30.17,Main,,0,0,0,,Beni affet.
Dialogue: 0,0:09:32.76,0:09:35.21,Main,,0,0,0,,Ne demek istiyorsun?
Dialogue: 0,0:09:36.00,0:09:38.82,Main,,0,0,0,,Ne diyorsun?! Bir şey yap!
Dialogue: 0,0:09:38.82,0:09:42.93,Main,,0,0,0,,Hey, hey! Sen doktorsun, değil mi? Değil mi?!
Dialogue: 0,0:09:42.93,0:09:45.41,Main,,0,0,0,,Faydasız.
Dialogue: 0,0:09:45.41,0:09:47.95,Main,,0,0,0,,İç organlarımı yaktı.
Dialogue: 0,0:09:48.88,0:09:52.34,Main,,0,0,0,,Fazla dayanamam.
Dialogue: 0,0:09:53.23,0:09:55.20,Main,,0,0,0,,Hayatımın...
Dialogue: 0,0:09:55.20,0:09:58.51,Main,,0,0,0,,...sonra erdiğini anlayabiliyorum...
Dialogue: 0,0:09:58.51,0:09:59.98,Main,,0,0,0,,Ace...
Dialogue: 0,0:09:59.98,0:10:03.13,Main,,0,0,0,,Ne diyorsun?
Dialogue: 0,0:10:03.13,0:10:06.32,Main,,0,0,0,,Dayanamayacağım demek de ne oluyor?
Dialogue: 0,0:10:06.32,0:10:09.40,Main,,0,0,0,,Bana söz vermiştin!
Dialogue: 0,0:10:09.40,0:10:12.86,Main,,0,0,0,,Asla ölmeyeceğim demiştin,...
Dialogue: 0,0:10:12.86,0:10:18.13,Main,,0,0,0,,...değil mi?!, Ace!
Dialogue: 0,0:10:19.66,0:10:25.00,Main,,0,0,0,,Ben muhtemelen yaşamak bile istemezdim.
Dialogue: 0,0:10:25.82,0:10:33.28,Main,,0,0,0,,Sabo'yla ilgili mesele ve senin gibi ele avuca sığmaz kardeşim olmasaydı.
Dialogue: 0,0:10:36.35,0:10:39.75,Flashbacks,,0,0,0,,Ya Gold Roger'ın çocuğu mu olsaydı?
Dialogue: 0,0:10:39.75,0:10:41.96,Flashbacks,,0,0,0,,Belli değil mi?
Dialogue: 0,0:10:41.96,0:10:45.86,Flashbacks,,0,0,0,,Hiç şüphesiz kafası kesilirdi!
Dialogue: 0,0:10:47.19,0:10:52.65,Flashbacks,,0,0,0,,Hayır, sadece başını kesmek bana yetmezdi!
Dialogue: 0,0:10:52.65,0:10:58.34,Flashbacks,,0,0,0,,Dünyada Roger'dan nefret eden her bir kişi\Niçin vücuduna bir iğne batırmaya ne dersin?
Dialogue: 0,0:10:59.50,0:11:04.17,Flashbacks,,0,0,0,,Hayır, neden önce onu yarı ölü halde gömmüyoruz?
Dialogue: 0,0:11:04.17,0:11:10.33,Flashbacks,,0,0,0,,Sonra dünyadaki tüm suçluların, ölmeden hemen önce onun nasıl göründüğünü gördüklerinden emin olabiliriz.
Dialogue: 0,0:11:10.71,0:11:11.75,Flashbacks,,0,0,0,,İyi fikir!
Dialogue: 0,0:11:11.75,0:11:16.03,Flashbacks,,0,0,0,,Sonra herkes "hak ettiğini buldu" derdi!
Dialogue: 0,0:11:17.66,0:11:21.48,Flashbacks,,0,0,0,,Son sözleri şöyle olabilirdi:...
Dialogue: 0,0:11:21.48,0:11:25.93,Flashbacks,,0,0,0,,..."Doğduğum için çok üzgünüm!\NSüprüntünün tekiyim!"
Dialogue: 0,0:11:29.04,0:11:32.44,Flashbacks,,0,0,0,,Zaten çocuğu olabilecek değil ya!
Dialogue: 0,0:11:38.22,0:11:42.38,Main,,0,0,0,,Hiç kimse doğmuş olmamı istemedi.
Dialogue: 0,0:11:49.11,0:11:52.82,Main,,0,0,0,,Ace! Kasabada bir sorun daha çıkarmışsın!
Dialogue: 0,0:11:52.82,0:11:56.59,Main,,0,0,0,,Cidden ne kargaşa ama! Bana\Nsürekli sorun çıkarıp durma!
Dialogue: 0,0:11:56.59,0:11:58.15,Main,,0,0,0,,Kapa çeneni, Dadan!
Dialogue: 0,0:11:58.15,0:11:59.57,Main,,0,0,0,,Ne?!
Dialogue: 0,0:11:59.57,0:12:04.83,Main,,0,0,0,,Yeterince güçlü olsaydım, hepsini öldürürdüm!
Dialogue: 0,0:12:08.01,0:12:17.18,Main,,0,0,0,,Sahi... Dadan'ı görürsen,... selamımı söyle.
Dialogue: 0,0:12:18.54,0:12:24.46,Main,,0,0,0,,Öleceğimi bildiğim için, nedense onun adı bile içime işliyor.
Dialogue: 0,0:12:26.17,0:12:30.03,Main,,0,0,0,,Dediğim gibi ölme!
Dialogue: 0,0:12:30.03,0:12:34.43,Main,,0,0,0,,Sadece bir tek... pişmanlığım var...
Dialogue: 0,0:12:35.54,0:12:40.56,Main,,0,0,0,,Hayalini gerçekleştirdiğini göremeyeceğim.
Dialogue: 0,0:12:42.37,0:12:48.43,Main,,0,0,0,,Ama eminim... başarabilirsin.
Dialogue: 0,0:12:48.43,0:12:50.76,Main,,0,0,0,,Sen benim kardeşimsin.
Dialogue: 0,0:12:58.19,0:13:02.41,Main,,0,0,0,,O gün söz verdiğimiz gibi,...
Dialogue: 0,0:13:02.41,0:13:05.20,Main,,0,0,0,,...hayatımı yaşama şeklimden...
Dialogue: 0,0:13:06.99,0:13:09.73,Main,,0,0,0,,...hiç pişmanlık duymadım.
Dialogue: 0,0:13:09.73,0:13:12.94,Main,,0,0,0,,Bu doğru değil! Bana yalan söyleme!
Dialogue: 0,0:13:13.80,0:13:15.89,Main,,0,0,0,,Yalan söylemiyorum.
Dialogue: 0,0:13:16.64,0:13:24.52,Main,,0,0,0,,Gerçekten istediğim şey şöhret ya da benzeri şey değildi.
Dialogue: 0,0:13:24.52,0:13:29.50,Main,,0,0,0,,Doğmuş olmam iyi miydi?
Dialogue: 0,0:13:29.50,0:13:33.47,Main,,0,0,0,,İstediğim şey sadece bu sorunun cevabıydı.
Dialogue: 0,0:13:36.40,0:13:38.20,Flashbacks,,0,0,0,,Oğlum ol!
Dialogue: 0,0:13:39.24,0:13:44.24,Flashbacks,,0,0,0,,Sevgili oğlumun hala iyi olduğunu farzediyorum.
Dialogue: 0,0:13:44.51,0:13:47.24,Flashbacks,,0,0,0,,Ben senin kardeşinim!
Dialogue: 0,0:13:47.24,0:13:49.88,Flashbacks,,0,0,0,,Her ne istersen söyle!
Dialogue: 0,0:13:49.88,0:13:53.21,Flashbacks,,0,0,0,,Hayatım pahasına seni kurtarıyorum!
Dialogue: 0,0:13:53.21,0:13:55.36,Flashbacks,,0,0,0,,Beyler!
Dialogue: 0,0:13:55.36,0:14:02.85,Flashbacks,,0,0,0,,Ace'i kurtarın ve Denizcileri yok edin!
Dialogue: 0,0:14:17.53,0:14:22.54,Main,,0,0,0,,Diğerlerinin duyabileceği kadar yüksek sesle konuşamıyorum.
Dialogue: 0,0:14:25.05,0:14:29.49,Main,,0,0,0,,Lütfen söyleyeceğim şeyi...
Dialogue: 0,0:14:29.49,0:14:32.38,Main,,0,0,0,,...onlara ilet.
Dialogue: 0,0:14:38.22,0:14:40.63,Main,,0,0,0,,Babalık...
Dialogue: 0,0:14:41.65,0:14:44.10,Main,,0,0,0,,...arkadaşlar...
Dialogue: 0,0:14:44.64,0:14:47.52,Main,,0,0,0,,...ve sen, Luffy.
Dialogue: 0,0:14:49.29,0:14:56.09,Main,,0,0,0,,Bu kadar değersiz olmama rağmen,...
Dialogue: 0,0:14:58.09,0:15:02.91,Main,,0,0,0,,...bir şeytanın kanını taşıyor olmama rağmen,...
Dialogue: 0,0:15:12.17,0:15:14.99,Main,,0,0,0,,...beni sevdiğiniz için...
Dialogue: 0,0:15:21.89,0:15:23.82,Main,,0,0,0,,...teşekkür ederim!
Dialogue: 0,0:15:57.85,0:15:59.71,Flashbacks,,0,0,0,,Dede.
Dialogue: 0,0:16:04.33,0:16:06.13,Flashbacks,,0,0,0,,Benim doğmam...
Dialogue: 0,0:16:07.66,0:16:10.05,Flashbacks,,0,0,0,,...iyi bir şey miydi?
Dialogue: 0,0:16:14.59,0:16:17.02,Flashbacks,,0,0,0,,Bunu...
Dialogue: 0,0:16:18.75,0:16:22.48,Flashbacks,,0,0,0,,...yaşadığın sürece er geç öğreneceksin.
Dialogue: 0,0:16:39.57,0:16:41.86,Main,,0,0,0,,Ace...
Dialogue: 0,0:17:24.06,0:17:27.92,Flashbacks,,0,0,0,,Öldüğümü mü sandın?
Dialogue: 0,0:17:33.85,0:17:35.47,Flashbacks,,0,0,0,,Ama...
Dialogue: 0,0:17:35.47,0:17:39.44,Flashbacks,,0,0,0,,Ne diye ağlıyorsun?! Beni hemen ölecekmiş gibi düşünme, seni aptal!
Dialogue: 0,0:17:46.11,0:17:50.71,Flashbacks,,0,0,0,,Söz veriyorum, ölmeyeceğim.
Dialogue: 0,0:17:50.71,0:17:56.09,Flashbacks,,0,0,0,,Gerçekten ölüp, arkamda böyle güçsüz\Nbir kardeş bırakacağımı mı sanıyorsun?
Dialogue: 0,0:17:56.09,0:17:57.45,Flashbacks,,0,0,0,,Garp.
Dialogue: 0,0:17:58.08,0:17:59.99,Flashbacks,,0,0,0,,Çocuğumla ilgilen.
Dialogue: 0,0:18:01.89,0:18:05.40,Flashbacks,,0,0,0,,Bu çocuğun adı Gol D. Ace.
Dialogue: 0,0:18:16.97,0:18:22.65,Flashbacks,,0,0,0,,Biliyor musun? Sake fincanlarını değişince kardeş olursun.
Dialogue: 0,0:18:25.05,0:18:27.15,Flashbacks,,0,0,0,,Bugünden sonra...
Dialogue: 0,0:18:31.95,0:18:34.91,Flashbacks,,0,0,0,,...kardeşiz!
