00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,2,10,10,10,1Style: OP13-Kanji,Duality,60,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,8,10,10,110,1Style: OP13-Credits,FOT-Greco Std B,40,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,95,100,1,0,1,2.2,0,1,80,10,100,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextComment: 0,0:00:00.00,0:00:00.00,Main,,0,0,0,,OPENINGDialogue: 0,0:02:31.41,0:02:43.39,Title,,0,0,150,,Thank You For Loving MeDialogue: 0,0:02:51.89,0:02:54.60,Main,,0,0,0,,Ace...Dialogue: 0,0:03:19.98,0:03:21.81,Main,,0,0,0,,Ace!Dialogue: 0,0:03:21.81,0:03:23.86,Main,,0,0,0,,Ace!Dialogue: 0,0:03:26.57,0:03:28.22,Main,,0,0,0,,Ace-san!Dialogue: 0,0:03:34.19,0:03:36.66,Main,,0,0,0,,Ace!Dialogue: 0,0:03:50.91,0:03:53.61,Main,,0,0,0,,He's been beaten! Dammit!Dialogue: 0,0:03:57.72,0:04:00.09,Main,,0,0,0,,Stop Akainu!Dialogue: 0,0:04:05.16,0:04:07.03,Main,,0,0,0,,Fire!Dialogue: 0,0:04:26.62,0:04:29.98,Main,,0,0,0,,How will this war end?Dialogue: 0,0:04:56.61,0:05:00.28,Main,,0,0,0,,No way! Is he a monster?!Dialogue: 0,0:05:23.66,0:05:27.17,Main,,0,0,0,,So you're still alive, then?Dialogue: 0,0:05:32.26,0:05:33.97,Main,,0,0,0,,Stop...Dialogue: 0,0:05:33.97,0:05:35.18,Main,,0,0,0,,Stop!Dialogue: 0,0:05:38.42,0:05:39.58,Main,,0,0,0,,Jinbe!Dialogue: 0,0:05:41.12,0:05:44.96,Main,,0,0,0,,You can't touch him anymore!Dialogue: 0,0:05:45.44,0:05:48.71,Main,,0,0,0,,You're just delaying the inevitable, Jinbe!Dialogue: 0,0:05:48.71,0:05:51.26,Main,,0,0,0,,Since you used to be a Warlord...Dialogue: 0,0:05:51.26,0:05:54.12,Main,,0,0,0,,you should know exactly how strong I am.Dialogue: 0,0:05:54.12,0:05:59.52,Main,,0,0,0,,If I can buy us some time by risking my life, then I'll gladly do so!Dialogue: 0,0:05:59.52,0:06:03.84,Main,,0,0,0,,I've been prepared to die from the very beginning!Dialogue: 0,0:06:05.42,0:06:06.61,Main,,0,0,0,,Jinbe!Dialogue: 0,0:06:06.61,0:06:09.11,Main,,0,0,0,,Marco! That guy's here!Dialogue: 0,0:06:09.11,0:06:13.91,Main,,0,0,0,,Gee, thank you for helping me! I almost died...Dialogue: 0,0:06:13.91,0:06:16.12,Main,,0,0,0,,Just shut up and unlock this thing!Dialogue: 0,0:06:24.50,0:06:27.48,Main,,0,0,0,,V-Vice Admiral Garp!Dialogue: 0,0:06:29.09,0:06:30.93,Main,,0,0,0,,What are you...?Dialogue: 0,0:06:30.93,0:06:31.90,Main,,0,0,0,,Garp!Dialogue: 0,0:06:36.08,0:06:40.56,Main,,0,0,0,,What are you doing?! Have you lost your mind?!Dialogue: 0,0:06:40.56,0:06:45.22,Main,,0,0,0,,You better keep holding me down, Sengoku!Dialogue: 0,0:06:47.61,0:06:53.32,Main,,0,0,0,,Because if you don't, I will kill Sakazuki!Dialogue: 0,0:06:54.96,0:06:56.63,Main,,0,0,0,,You fool!Dialogue: 0,0:07:01.12,0:07:05.44,Main,,0,0,0,,I guess I need to execute a traitor, too.Dialogue: 0,0:07:10.55,0:07:12.18,Main,,0,0,0,,Jinbe, get down!Dialogue: 0,0:07:20.85,0:07:23.71,Main,,0,0,0,,How annoying!Dialogue: 0,0:07:25.85,0:07:27.76,Main,,0,0,0,,So you guys are Haki users!Dialogue: 0,0:07:28.61,0:07:30.60,Main,,0,0,0,,How could we let that happen?!Dialogue: 0,0:07:30.60,0:07:33.43,Main,,0,0,0,,I'll never forgive myself for this!Dialogue: 0,0:07:33.43,0:07:37.62,Main,,0,0,0,,Can't you see that Fire Fist can't be saved?Dialogue: 0,0:07:37.62,0:07:39.32,Main,,0,0,0,,Take a look!Dialogue: 0,0:07:53.60,0:07:56.09,Main,,0,0,0,,Ace...Dialogue: 0,0:07:59.36,0:08:04.04,Main,,0,0,0,,Hey, are you all right? Hey.Dialogue: 0,0:08:13.02,0:08:16.81,Main,,0,0,0,,Ace, you need to get treated right away!Dialogue: 0,0:08:17.39,0:08:20.98,Main,,0,0,0,,I'm sorry, Luffy...Dialogue: 0,0:08:20.98,0:08:22.51,Main,,0,0,0,,Huh?Dialogue: 0,0:08:24.90,0:08:27.99,Main,,0,0,0,,To save me...Dialogue: 0,0:08:28.57,0:08:32.78,Main,,0,0,0,,you pushed yourself so hard...Dialogue: 0,0:08:32.78,0:08:36.74,Main,,0,0,0,,but I won't be able to make it out of here...Dialogue: 0,0:08:39.24,0:08:41.33,Main,,0,0,0,,I'm sorry.Dialogue: 0,0:08:43.25,0:08:45.71,Main,,0,0,0,,Wh-What are you saying?Dialogue: 0,0:08:45.71,0:08:47.61,Main,,0,0,0,,Don't be ridiculous!Dialogue: 0,0:08:47.61,0:08:49.97,Main,,0,0,0,,Somebody, treat him!Dialogue: 0,0:08:49.97,0:08:52.74,Main,,0,0,0,,Please! Please help Ace!Dialogue: 0,0:08:52.74,0:08:57.09,Main,,0,0,0,,Hey, somebody! Help Ace! Please!Dialogue: 0,0:08:57.09,0:09:00.10,Main,,0,0,0,,Hurry! This way! Give him first aid now!Dialogue: 0,0:09:00.10,0:09:00.95,Main,,0,0,0,,Okay!Dialogue: 0,0:09:02.77,0:09:04.66,Main,,0,0,0,,Straw Hat-boy...Dialogue: 0,0:09:04.66,0:09:07.26,Main,,0,0,0,,Ace! Are you all right?!Dialogue: 0,0:09:07.90,0:09:09.61,Main,,0,0,0,,Hurry up and treat him!Dialogue: 0,0:09:09.61,0:09:11.84,Main,,0,0,0,,Okay, let me see the wound!Dialogue: 0,0:09:11.84,0:09:12.83,Main,,0,0,0,,Please!Dialogue: 0,0:09:16.20,0:09:17.66,Main,,0,0,0,,This is...!Dialogue: 0,0:09:19.60,0:09:20.90,Main,,0,0,0,,Huh?Dialogue: 0,0:09:21.70,0:09:22.75,Main,,0,0,0,,Hey.Dialogue: 0,0:09:23.49,0:09:26.51,Main,,0,0,0,,What's the matter? Hurry up and help him!Dialogue: 0,0:09:28.22,0:09:30.17,Main,,0,0,0,,I'm sorry.Dialogue: 0,0:09:32.76,0:09:35.21,Main,,0,0,0,,What do you mean by that?Dialogue: 0,0:09:36.00,0:09:38.82,Main,,0,0,0,,What's going on?! Just do something!Dialogue: 0,0:09:38.82,0:09:42.93,Main,,0,0,0,,Hey, aren't you a doctor?! Hey!Dialogue: 0,0:09:42.93,0:09:45.41,Main,,0,0,0,,It's no use.Dialogue: 0,0:09:45.41,0:09:47.95,Main,,0,0,0,,My organs have been burned.Dialogue: 0,0:09:48.88,0:09:52.34,Main,,0,0,0,,I'm not gonna last long.Dialogue: 0,0:09:53.23,0:09:55.20,Main,,0,0,0,,I can tell...Dialogue: 0,0:09:55.20,0:09:58.51,Main,,0,0,0,,that my life is ending...Dialogue: 0,0:09:58.51,0:09:59.98,Main,,0,0,0,,Ace...Dialogue: 0,0:09:59.98,0:10:03.13,Main,,0,0,0,,what are you saying?Dialogue: 0,0:10:03.13,0:10:06.32,Main,,0,0,0,,Are you gonna die?!Dialogue: 0,0:10:06.32,0:10:09.40,Main,,0,0,0,,You promised me...Dialogue: 0,0:10:09.40,0:10:12.86,Main,,0,0,0,,that you'd never die...Dialogue: 0,0:10:12.86,0:10:18.13,Main,,0,0,0,,no matter what, Ace!Dialogue: 0,0:10:19.66,0:10:25.00,Main,,0,0,0,,I would've given up a long time ago...Dialogue: 0,0:10:25.82,0:10:33.28,Main,,0,0,0,,if it weren't for Sabo and a high-maintenance brother like you.Dialogue: 0,0:10:36.35,0:10:39.75,Flashbacks,,0,0,0,,If Gold Roger had a kid?Dialogue: 0,0:10:39.75,0:10:41.96,Flashbacks,,0,0,0,,Of course I know what'd happen to him!Dialogue: 0,0:10:41.96,0:10:45.86,Flashbacks,,0,0,0,,They'd get their head cut off for sure!Dialogue: 0,0:10:47.19,0:10:52.65,Flashbacks,,0,0,0,,No way! I wouldn't be happy if the kid died that easily.Dialogue: 0,0:10:52.65,0:10:58.34,Flashbacks,,0,0,0,,How about shoving needles into that kid until the number equals the people that hated Roger!Dialogue: 0,0:10:59.50,0:11:04.17,Flashbacks,,0,0,0,,No way! We should burn him at the stake...Dialogue: 0,0:11:04.17,0:11:10.33,Flashbacks,,0,0,0,,and humiliate him in front of the whole world!Dialogue: 0,0:11:10.71,0:11:11.75,Flashbacks,,0,0,0,,That sounds nice!Dialogue: 0,0:11:11.75,0:11:16.03,Flashbacks,,0,0,0,,They'll all say: "It serves you right!"Dialogue: 0,0:11:17.66,0:11:21.48,Flashbacks,,0,0,0,,I'd want his last words to be...Dialogue: 0,0:11:21.48,0:11:25.93,Flashbacks,,0,0,0,,"I'm sorry I was born. I'm nothing but trash."Dialogue: 0,0:11:29.04,0:11:32.44,Flashbacks,,0,0,0,,Ah, well... I doubt that brat actually exists.Dialogue: 0,0:11:38.22,0:11:42.38,Main,,0,0,0,,No one wanted me to exist.Dialogue: 0,0:11:49.11,0:11:52.82,Main,,0,0,0,,Ace! Did you start trouble in town again?Dialogue: 0,0:11:52.82,0:11:56.59,Main,,0,0,0,,Everybody is talking about it!  Why can't you stay out of trouble for our sake?Dialogue: 0,0:11:56.59,0:11:58.15,Main,,0,0,0,,Shut up, Dadan!Dialogue: 0,0:11:58.15,0:11:59.57,Main,,0,0,0,,What?!Dialogue: 0,0:11:59.57,0:12:04.83,Main,,0,0,0,,If I was stronger, I would've killed them all.Dialogue: 0,0:12:08.01,0:12:17.18,Main,,0,0,0,,Oh yeah. If you ever see Dadan again... can you give her my regards?Dialogue: 0,0:12:18.54,0:12:24.46,Main,,0,0,0,,Facing my own death, I even miss a woman like her.Dialogue: 0,0:12:26.17,0:12:30.03,Main,,0,0,0,,Like I said, don't say that you're gonna die!Dialogue: 0,0:12:30.03,0:12:34.43,Main,,0,0,0,,There is one thing... that makes me want to stay...Dialogue: 0,0:12:35.54,0:12:40.56,Main,,0,0,0,,That's my desire to see you fulfill your dream.Dialogue: 0,0:12:42.37,0:12:48.43,Main,,0,0,0,,But... I know you can do it!Dialogue: 0,0:12:48.43,0:12:50.76,Main,,0,0,0,,Because you're my little brother!Dialogue: 0,0:12:58.19,0:13:02.41,Main,,0,0,0,,Just like how I swore on that day...Dialogue: 0,0:13:02.41,0:13:05.20,Main,,0,0,0,,I have no regrets...Dialogue: 0,0:13:06.99,0:13:09.73,Main,,0,0,0,,in my life.Dialogue: 0,0:13:09.73,0:13:12.94,Main,,0,0,0,,Liar! You're lying!Dialogue: 0,0:13:13.80,0:13:15.89,Main,,0,0,0,,I'm not lying.Dialogue: 0,0:13:16.64,0:13:24.52,Main,,0,0,0,,I've realized that what I really wanted... wasn't fame.Dialogue: 0,0:13:24.52,0:13:29.50,Main,,0,0,0,,Did I deserve to be born?Dialogue: 0,0:13:29.50,0:13:33.47,Main,,0,0,0,,I wanted to know the answer to that question.Dialogue: 0,0:13:36.40,0:13:38.20,Flashbacks,,0,0,0,,Become my son!Dialogue: 0,0:13:39.24,0:13:44.24,Flashbacks,,0,0,0,,I take it my beloved son is still doing well?Dialogue: 0,0:13:44.51,0:13:47.24,Flashbacks,,0,0,0,,I'm your brother!Dialogue: 0,0:13:47.24,0:13:49.88,Flashbacks,,0,0,0,,Say whatever the hell you want!Dialogue: 0,0:13:49.88,0:13:53.21,Flashbacks,,0,0,0,,I'm saving you, even if I die!Dialogue: 0,0:13:53.21,0:13:55.36,Flashbacks,,0,0,0,,Men!Dialogue: 0,0:13:55.36,0:14:02.85,Flashbacks,,0,0,0,,Rescue Ace, and destroy the Navy!Dialogue: 0,0:14:17.53,0:14:22.54,Main,,0,0,0,,I'm not able to shout loudly enough for everyone to hear me anymore...Dialogue: 0,0:14:25.05,0:14:29.49,Main,,0,0,0,,Could you tell them...Dialogue: 0,0:14:29.49,0:14:32.38,Main,,0,0,0,,the words I'm about to say?Dialogue: 0,0:14:38.22,0:14:40.63,Main,,0,0,0,,Pops...Dialogue: 0,0:14:41.65,0:14:44.10,Main,,0,0,0,,Everybody...Dialogue: 0,0:14:44.64,0:14:47.52,Main,,0,0,0,,And you, Luffy.Dialogue: 0,0:14:49.29,0:14:56.09,Main,,0,0,0,,I've always been such a hopeless person...Dialogue: 0,0:14:58.09,0:15:02.91,Main,,0,0,0,,I was demon spawn... the son of the devil...Dialogue: 0,0:15:12.17,0:15:14.99,Main,,0,0,0,,Thank you...Dialogue: 0,0:15:21.89,0:15:23.82,Main,,0,0,0,,for loving me!Dialogue: 0,0:15:57.85,0:15:59.71,Flashbacks,,0,0,0,,Gramps.Dialogue: 0,0:16:04.33,0:16:06.13,Flashbacks,,0,0,0,,Was it...Dialogue: 0,0:16:07.66,0:16:10.05,Flashbacks,,0,0,0,,good that I was born?Dialogue: 0,0:16:14.59,0:16:17.02,Flashbacks,,0,0,0,,Well, you...Dialogue: 0,0:16:18.75,0:16:22.48,Flashbacks,,0,0,0,,As long as you're alive, you'll figure it out eventually.Dialogue: 0,0:16:39.57,0:16:41.86,Main,,0,0,0,,Ace...Dialogue: 0,0:17:24.06,0:17:27.92,Flashbacks,,0,0,0,,Did you think I was dead?Dialogue: 0,0:17:33.85,0:17:35.47,Flashbacks,,0,0,0,,But...!Dialogue: 0,0:17:35.47,0:17:39.44,Flashbacks,,0,0,0,,What are you crying about?! I'm alive, you idiot!Dialogue: 0,0:17:46.11,0:17:50.71,Flashbacks,,0,0,0,,I promise you... I will never die!Dialogue: 0,0:17:50.71,0:17:56.09,Flashbacks,,0,0,0,,How could I leave a wimpy little brother like you behind?Dialogue: 0,0:17:56.09,0:17:57.45,Flashbacks,,0,0,0,,Garp.Dialogue: 0,0:17:58.08,0:17:59.99,Flashbacks,,0,0,0,,Take care of my child.Dialogue: 0,0:18:01.89,0:18:05.40,Flashbacks,,0,0,0,,Our child's name is Gol D. Ace.Dialogue: 0,0:18:16.97,0:18:22.65,Flashbacks,,0,0,0,,Didn't ya know? When you exchange sake cups, you become brothers.Dialogue: 0,0:18:25.05,0:18:27.15,Flashbacks,,0,0,0,,From today onward...Dialogue: 0,0:18:31.95,0:18:34.91,Flashbacks,,0,0,0,,we are brothers!Dialogue: 0,0:00:25.37,0:00:30.41,OP13-Credits,,0,0,0,,Editing SewilDialogue: 0,0:00:30.41,0:00:36.22,OP13-Credits,,0,0,0,,Quality Control Feeso Galaxy 9000 PepperjackDialogue: 0,0:00:36.22,0:00:41.19,OP13-Credits,,0,0,0,,Timing Galaxy 9000Dialogue: 0,0:00:41.19,0:00:46.93,OP13-Credits,,0,0,0,,Translation CrunchyrollDialogue: 0,0:00:46.93,0:00:52.36,OP13-Credits,,0,0,0,,Visual Effects Datenshi KaitouYahikoDialogue: 0,0:00:52.36,0:00:57.44,OP13-Credits,,0,0,0,,Graphics DatenshiDialogue: 0,0:00:57.44,0:01:03.08,OP13-Credits,,0,0,0,,Karaoke KaitouYahikoDialogue: 0,0:01:03.08,0:01:06.56,OP13-Credits,,0,0,0,,Soundtracking HaleeDialogue: 0,0:01:06.56,0:01:08.68,OP13-Credits,,0,0,0,,Raws OPFansDialogue: 0,0:00:25.35,0:00:26.75,OP13-Karaoke,,0,0,0,fx,Dialogue: 0,0:00:25.35,0:00:26.75,OP13-Karaoke,,0,0,0,fx,Dialogue: 1,0:00:24.63,0:00:25.45,OP13-Karaoke,,0,0,0,fx,ADialogue: 0,0:00:25.45,0:00:26.85,OP13-Karaoke,,0,0,0,fx,ADialogue: 1,0:00:24.71,0:00:25.57,OP13-Karaoke,,0,0,0,fx,mDialogue: 1,0:00:24.71,0:00:25.57,OP13-Karaoke,,0,0,0,fx,eDialogue: 1,0:00:24.71,0:00:25.57,OP13-Karaoke,,0,0,0,fx,Dialogue: 0,0:00:25.57,0:00:26.97,OP13-Karaoke,,0,0,0,fx,meDialogue: 1,0:00:24.79,0:00:25.76,OP13-Karaoke,,0,0,0,fx,aDialogue: 0,0:00:25.76,0:00:27.16,OP13-Karaoke,,0,0,0,fx,aDialogue: 1,0:00:24.87,0:00:26.13,OP13-Karaoke,,0,0,0,fx,gDialogue: 1,0:00:24.87,0:00:26.13,OP13-Karaoke,,0,0,0,fx,aDialogue: 0,0:00:26.13,0:00:27.53,OP13-Karaoke,,0,0,0,fx,gaDialogue: 1,0:00:24.95,0:00:26.39,OP13-Karaoke,,0,0,0,fx,rDialogue: 1,0:00:24.95,0:00:26.39,OP13-Karaoke,,0,0,0,fx,iDialogue: 1,0:00:24.95,0:00:26.39,OP13-Karaoke,,0,0,0,fx,Dialogue: 0,0:00:26.39,0:00:27.79,OP13-Karaoke,,0,0,0,fx,riDialogue: 1,0:00:25.03,0:00:26.74,OP13-Karaoke,,0,0,0,fx,nDialogue: 1,0:00:25.03,0:00:26.74,OP13-Karaoke,,0,0,0,fx,oDialogue: 1,0:00:25.03,0:00:26.74,OP13-Karaoke,,0,0,0,fx,Dialogue: 0,0:00:26.74,0:00:28.14,OP13-Karaoke,,0,0,0,fx,noDialogue: 1,0:00:25.11,0:00:26.89,OP13-Karaoke,,0,0,0,fx,sDialogue: 1,0:00:25.11,0:00:26.89,OP13-Karaoke,,0,0,0,fx,oDialogue: 0,0:00:26.89,0:00:28.29,OP13-Karaoke,,0,0,0,fx,soDialogue: 1,0:00:25.19,0:00:27.44,OP13-Karaoke,,0,0,0,fx,rDialogue: 1,0:00:25.19,0:00:27.44,OP13-Karaoke,,0,0,0,fx,aDialogue: 1,0:00:25.19,0:00:27.44,OP13-Karaoke,,0,0,0,fx,Dialogue: 0,0:00:27.44,0:00:28.84,OP13-Karaoke,,0