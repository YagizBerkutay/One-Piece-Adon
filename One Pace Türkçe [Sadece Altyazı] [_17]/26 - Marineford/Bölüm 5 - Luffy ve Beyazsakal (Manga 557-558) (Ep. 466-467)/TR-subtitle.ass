2,1,2,10,10,10,1Style: Kanji-furigana,Duality,30,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2,0,8,10,10,80,1Style: Translation-furigana,Duality,30,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,1.5,0,2,10,10,10,1Style: Karaoke-furigana,Duality,30,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,1.5,0,8,10,10,10,1Style: Default-furigana,Arial,10,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1,1,2,10,10,10,1Style: Karaoke,Duality,45.0,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,1.5,0,2,10,10,18,1Style: Translation,Duality,60,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,2,10,10,10,1Style: Kanji,Duality,60,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,8,10,10,110,1Style: Luffy,Cabold Comic,55,&H003126A0,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2,0,2,10,10,10,1Style: Luffy Gear Third,Babycakes,55,&H003126A0,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2,0,2,10,10,10,1Style: Author,Impress BT,25,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1,1,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:25.37,0:00:30.62,Karaoke,,0,0,0,karaoke,♪ Her seferinde yağmurdan sonra gökyüzüne bakıyorum. ♪Dialogue: 0,0:00:30.62,0:00:36.13,Karaoke,,0,0,0,karaoke,♪ Henüz sulugöz olduğum zamanları düşünüyorum. ♪Dialogue: 0,0:00:36.13,0:00:43.87,Karaoke,,0,0,0,karaoke,♪ Umutsuzca birinin arkasından koşuyorum,... ♪Dialogue: 0,0:00:43.94,0:00:46.85,Karaoke,,0,0,0,karaoke,♪ ..."Daha güçlü olmak istiyorum," diye düşünerek. ♪Dialogue: 0,0:00:46.85,0:00:52.03,Karaoke,,0,0,0,karaoke,♪ "Teşekkürüm" şimdi rüzgârda kayboldu,... ♪Dialogue: 0,0:00:52.20,0:00:57.21,Karaoke,,0,0,0,karaoke,♪ ...daha güçlü olabilir miyim? ♪Dialogue: 0,0:00:57.41,0:01:02.88,Karaoke,,0,0,0,karaoke,♪ Cevabımı bulamıyorum. ♪Dialogue: 0,0:01:03.01,0:01:08.40,Karaoke,,0,0,0,karaoke,♪ Bu yüzden ilerlemeye devam edeceğim. ♪Dialogue: 0,0:01:08.55,0:01:11.03,Karaoke,,0,0,0,karaoke,♪ Gel hadi, gidelim. ♪Dialogue: 0,0:01:11.03,0:01:14.24,Karaoke,,0,0,0,karaoke,♪ Asla pes etmeyeceğiz. ♪Dialogue: 0,0:01:14.24,0:01:19.48,Karaoke,,0,0,0,karaoke,♪ Zamanın dalgalarına yenik düşmeyeceğiz. ♪Dialogue: 0,0:01:19.48,0:01:25.09,Karaoke,,0,0,0,karaoke,♪ Tekrar tekrar ayağa kalkacağız. ♪Dialogue: 0,0:01:25.10,0:01:30.73,Karaoke,,0,0,0,karaoke,♪ Çünkü bizim için önemli olanı kaybetmek istemiyoruz. ♪Dialogue: 0,0:01:30.74,0:01:35.85,Karaoke,,0,0,0,karaoke,♪ Beni sürekli, sürekli ilerlemeye zorlayan... ♪Dialogue: 0,0:01:35.86,0:01:41.25,Karaoke,,0,0,0,karaoke,♪ ...kafamdaki sesi duyabiliyorum. ♪Dialogue: 0,0:01:41.25,0:01:46.38,Karaoke,,0,0,0,karaoke,♪ Haylaz yağmur bana engel olurken bile... ♪Dialogue: 0,0:01:46.39,0:01:51.32,Karaoke,,0,0,0,karaoke,♪ ...kaçmaya çalışmayacağım. ♪Dialogue: 0,0:01:54.42,0:01:56.78,Karaoke,,0,0,0,karaoke,♪ Gel hadi, gidelim. ♪Dialogue: 0,0:01:56.78,0:02:00.06,Karaoke,,0,0,0,karaoke,♪ Asla pes etmeyeceğiz. ♪Dialogue: 0,0:02:00.06,0:02:05.35,Karaoke,,0,0,0,karaoke,♪ Zamanın dalgalarına yenik düşmeyeceğiz. ♪Dialogue: 0,0:02:05.36,0:02:10.99,Karaoke,,0,0,0,karaoke,♪ Tekrar tekrar ayağa kalkacağız. ♪Dialogue: 0,0:02:10.99,0:02:16.35,Karaoke,,0,0,0,karaoke,♪ Çünkü bizim için önemli olanı kaybetmek istemiyoruz. ♪Dialogue: 0,0:02:16.36,0:02:22.05,Karaoke,,0,0,0,karaoke,♪ İnandığımız geleceğe doğru ilerleyelim. ♪Dialogue: 0,0:00:25.87,0:00:30.30,Credits,,0,0,0,,Editing SewilDialogue: 0,0:00:30.78,0:00:35.64,Credits,,0,0,0,,Quality Assurance Galaxy 9000 PepperjackDialogue: 0,0:00:36.26,0:00:42.21,Credits,,0,0,0,,Karaoke & Attack Effects KaitouYahikoDialogue: 0,0:00:42.30,0:00:46.10,Credits,,0,0,0,,Timing SewilDialogue: 0,0:00:46.91,0:00:49.53,Credits,,0,0,0,,Soundtracking HaleeDialogue: 0,0:00:57.48,0:01:00.40,Credits,,0,0,0,,Raw Provider CruchyrollDialogue: 0,0:02:30.38,0:02:40.38,Author,,0,0,0,, Türkçeleştirme  onepacetr.netDialogue: 0,0:13:08.00,0:13:18.00,Author,,0,0,0,, Türkçeleştirme  onepacetr.netDialogue: 0,0:26:55.00,0:27:05.00,Author,,0,0,0,, Türkçeleştirme  onepacetr.netDialogue: 0,0:02:30.38,0:02:34.32,Title,,0,0,240,,Luffy ve BeyazsakalDialogue: 0,0:02:31.88,0:02:34.32,Main,,0,0,0,,Kalbim patlayacakmış gibi!Dialogue: 0,0:02:34.32,0:02:37.60,Main,,0,0,0,,Hey, ortak! Bir şey yapamaz mısın?!Dialogue: 0,0:02:37.60,0:02:40.09,Main,,0,0,0,,Mum gücümün burada bize ne yararı olacak?!Dialogue: 0,0:02:41.46,0:02:44.54,Main,,0,0,0,,Niye Luffy-gil gökyüzünden düşüyor?Dialogue: 0,0:02:44.98,0:02:50.02,Main,,0,0,0,,Buna cevap vermek için, zamanı biraz geri almalıyız.Dialogue: 0,0:03:05.40,0:03:06.16,Main,,0,0,0,,Ne oldu?Dialogue: 0,0:03:06.52,0:03:08.30,Main,,0,0,0,,O da neydi?Dialogue: 0,0:03:08.30,0:03:10.54,Main,,0,0,0,,Ne oldu?!Dialogue: 0,0:03:11.31,0:03:12.57,Main,,0,0,0,,Bu da ne böyle?!Dialogue: 0,0:03:13.02,0:03:18.01,Main,,0,0,0,,Buza takılmışız! Şimdi hiçbir yere gidemeyiz!Dialogue: 0,0:03:19.08,0:03:21.48,Flashbacks,,0,0,0,,Bunu yapmış olabilecek tek kişi...Dialogue: 0,0:03:23.91,0:03:28.09,Main,,0,0,0,,Aşağıya bakın. Cevabınız orada.Dialogue: 0,0:03:29.92,0:03:30.95,Main,,0,0,0,,Yaşlı Beyazsakal...Dialogue: 0,0:03:30.95,0:03:33.02,Main,,0,0,0,,Savaş çoktan başlamış!Dialogue: 0,0:03:33.60,0:03:35.26,Main,,0,0,0,,Dinleyin beyler!Dialogue: 0,0:03:35.54,0:03:38.14,Main,,0,0,0,,Bundan nasıl kurtulacağımıza dair bir fikrim var!Dialogue: 0,0:03:38.14,0:03:40.34,Main,,0,0,0,,Buraya kadar geldiğimize göre acele etmeliyiz!Dialogue: 0,0:03:40.34,0:03:43.77,Main,,0,0,0,,Ace'i idam etmelerine üç saatten az kaldı!Dialogue: 0,0:03:43.77,0:03:45.22,Main,,0,0,0,,Evet, yani?Dialogue: 0,0:03:45.42,0:03:46.84,Main,,0,0,0,,Ne?!Dialogue: 0,0:03:47.30,0:03:50.78,Main,,0,0,0,,Gemiyi donmuş dalgadan aşağı kaydırmamızı mı istiyor?!Dialogue: 0,0:03:51.12,0:03:55.61,Main,,0,0,0,,Tek şansımız bu! Öncelikle buzu kırıp gemiyi çıkarmalıyız!Dialogue: 0,0:03:55.61,0:03:59.56,Main,,0,0,0,,Aptal mısın sen?! Bu bir savaş gemisi! O kadar kolay hareket etmeyecek!Dialogue: 0,0:03:59.56,0:04:01.02,Main,,0,0,0,,Doğru, seni sersem!Dialogue: 0,0:04:01.64,0:04:05.29,Main,,0,0,0,,Birlikte çalışırsak, yapabileceğimizi biliyorum!Dialogue: 0,0:04:05.88,0:04:08.36,Main,,0,0,0,,Gerçekten yapabilecekmişiz gibi gelmeye başladı.Dialogue: 0,0:04:08.36,0:04:13.56,Main,,0,0,0,,Doğru! Yanımızda dünyayı fethedecek olan adam, Kaptan Buggy var!Dialogue: 0,0:04:13.56,0:04:17.35,Main,,0,0,0,,Kaptan yapabiliriz diyorsa, yapabileceğimizi biliyorum!Dialogue: 0,0:04:21.35,0:04:23.22,Main,,0,0,0,,Tüm gemilere ve birliklere sesleniyorum.Dialogue: 0,0:04:23.22,0:04:25.74,Main,,0,0,0,,Hedefimiz TOTTZ yeri.Dialogue: 0,0:04:25.74,0:04:28.85,Main,,0,0,0,,Oluşumu değiştirin ve Üçüncü Operasyonu başlatın.Dialogue: 0,0:04:29.26,0:04:31.36,Main,,0,0,0,,Denizcilerin planlarını yayınlıyorlar.Dialogue: 0,0:04:31.36,0:04:32.88,Main,,0,0,0,,Hazırlıklar konusunda acele edin.Dialogue: 0,0:04:32.88,0:04:35.69,Main,,0,0,0,,TOT... O da ne?Dialogue: 0,0:04:35.69,0:04:38.16,Main,,0,0,0,,Bilmem... Muhtemelen bir tür kod.Dialogue: 0,0:04:38.54,0:04:43.37,Main,,0,0,0,,Hazırlıklar tamamlanınca, programı öne alıp Ace'i idam edeceğiz!Dialogue: 0,0:04:43.37,0:04:44.66,Main,,0,0,0,,Bu kadar!Dialogue: 0,0:04:48.12,0:04:49.28,Main,,0,0,0,,Luffy-kun...Dialogue: 0,0:04:49.28,0:04:50.50,Main,,0,0,0,,Acele edelim!Dialogue: 0,0:04:50.50,0:04:54.18,Main,,0,0,0,,Daha fazla bekleyemeyiz. Bunu tartışacak zamanımız yok!Dialogue: 0,0:04:54.18,0:04:57.18,Main,,0,0,0,,Millet! Hasır Şapkalı çocuğun fikrini uygulayacağız!Dialogue: 0,0:05:00.58,0:05:02.45,Main,,0,0,0,,Hadi!Dialogue: 0,0:05:08.48,0:05:09.52,Main,,0,0,0,,H-Hey!Dialogue: 0,0:05:10.71,0:05:13.62,Main,,0,0,0,,Yanlış taraf!Dialogue: 0,0:05:17.12,0:05:20.94,Main,,0,0,0,,Bu bizi, Luffy-gil'in düştüğü şimdiye getiriyor.Dialogue: 0,0:05:52.52,0:05:56.50,Main,,0,0,0,,Ne oldu?! Gökyüzünden düşen savaş gemisi miydi?!Dialogue: 0,0:05:58.34,0:06:00.04,Main,,0,0,0,,Su... Kurtulduk.Dialogue: 0,0:06:00.04,0:06:01.40,Main,,0,0,0,,Denize düştük.Dialogue: 0,0:06:01.40,0:06:04.64,Main,,0,0,0,,Buza çarpıp öleceğimizi sandım.Dialogue: 0,0:06:05.00,0:06:07.61,Main,,0,0,0,,Niye bu noktada buz yok?Dialogue: 0,0:06:07.61,0:06:09.80,Main,,0,0,0,,Tırmanın! Daha yükseğe!Dialogue: 0,0:06:09.80,0:06:13.45,Main,,0,0,0,,Cehennem'deki su işkencesiyle mukayese edildiğinde bunun lafı bile olmaz!Dialogue: 0,0:06:23.64,0:06:26.77,Thoughts,,0,0,0,,Bu Şeytan Meyvesi kullanıcıları var ya...Dialogue: 0,0:07:05.10,0:07:15.28,Main,,0,0,0,,Ace!!!Dialogue: 0,0:07:16.75,0:07:20.22,Main,,0,0,0,,Luffy!!!Dialogue: 0,0:07:21.53,0:07:23.22,Main,,0,0,0,,Sonunda seni buldum!Dialogue: 0,0:07:23.99,0:07:26.16,Main,,0,0,0,,Hey! O...Dialogue: 0,0:07:26.38,0:07:27.80,Main,,0,0,0,,Crocodile!Dialogue: 0,0:07:27.80,0:07:31.10,Main,,0,0,0,,Kastettiğim o değil! Şu koca suratlı herif kim?Dialogue: 0,0:07:31.50,0:07:35.36,Main,,0,0,0,,Denizciler'in tam gücünden daha azını beklemezdim. Hafife alınmamaları gerekir.Dialogue: 0,0:07:36.46,0:07:38.10,Main,,0,0,0,,Benim için hazırlan dünya!Dialogue: 0,0:07:40.35,0:07:43.01,Main,,0,0,0,,Ace! Seni kurtarmaya geldim!Dialogue: 0,0:07:43.01,0:07:46.18,Main,,0,0,0,,Hepimiz seni kurtarmaya geldik!Dialogue: 0,0:07:47.57,0:07:50.95,Main,,0,0,0,,Garp! Yine senin lanet ailen!Dialogue: 0,0:07:50.95,0:07:52.88,Main,,0,0,0,,Luffy!Dialogue: 0,0:07:52.88,0:07:55.55,Main,,0,0,0,,Bakın! Sadece Hasır Şapka değil!Dialogue: 0,0:07:55.55,0:07:58.42,Main,,0,0,0,,Jinbei ve hatta Devrim Ordusu'ndan Ivankov!Dialogue: 0,0:07:59.16,0:08:03.19,Main,,0,0,0,,Arkalarında ise tarihin en kötü korsanlarından kalabalık bir güruh var!Dialogue: 0,0:08:03.19,0:08:05.90,Main,,0,0,0,,Impel Down kaçakları!Dialogue: 0,0:08:06.08,0:08:10.10,Main,,0,0,0,,Herkesin bahsettiği adam. Hasır Şapka.Dialogue: 0,0:08:10.10,0:08:13.71,Main,,0,0,0,,Hasır... Şapka...Dialogue: 0,0:08:13.95,0:08:16.46,Main,,0,0,0,,O burada ne yapıyor?!Dialogue: 0,0:08:16.46,0:08:18.88,Main,,0,0,0,,Bu her zamanki tayfası değil, değil mi?Dialogue: 0,0:08:19.24,0:08:22.78,Main,,0,0,0,,Luffy! Güvende olmana çok sevindim!Dialogue: 0,0:08:22.78,0:08:24.78,Main,,0,0,0,,Bunu görmelisin, Helmeppo-san!Dialogue: 0,0:08:24.78,0:08:28.05,Main,,0,0,0,,Ne oldu? Artık hiçbir şey beni şaşırta-Dialogue: 0,0:08:28.05,0:08:29.46,Main,,0,0,0,,Hasır Şapka!Dialogue: 0,0:08:29.46,0:08:34.39,Main,,0,0,0,,Impel Down'da tutsak edildiğini duymuştum! Gerçekten müthiş biri!Dialogue: 0,0:08:34.69,0:08:37.33,Main,,0,0,0,,Yanında müthiş bir takım getirmiş.Dialogue: 0,0:08:39.52,0:08:43.77,Main,,0,0,0,,Onu bu kadar yakın zamanda yeniden göreceğimi sanmıyordum.Dialogue: 0,0:08:43.77,0:08:47.24,Main,,0,0,0,,Hey, bu Ace'in sürekli bahsettiği küçük kardeşi.Dialogue: 0,0:08:47.24,0:08:50.23,Main,,0,0,0,,Artık eski ve yeni tüm Savaş Lordları burada!Dialogue: 0,0:08:51.68,0:08:56.81,Main,,0,0,0,,Şu ise baş belası çaylak, Hasır Şapka mı?Dialogue: 0,0:08:57.18,0:08:58.95,Main,,0,0,0,,Smoker-san, bakın!Dialogue: 0,0:08:58.95,0:08:59.61,Main,,0,0,0,,Biliyorum.Dialogue: 0,0:08:59.61,0:09:00.48,Main,,0,0,0,,Benimsin!Dialogue: 0,0:09:03.72,0:09:05.86,Main,,0,0,0,,Hasır Şapka ve Crocodile...Dialogue: 0,0:09:06.12,0:09:07.99,Main,,0,0,0,,Niye birlikte çalışıyorlar?Dialogue: 0,0:09:08.66,0:09:10.96,Main,,0,0,0,,Demek bu o...Dialogue: 0,0:09:10.96,0:09:14.25,Main,,0,0,0,,Sadece Kahraman Garp'ın torunu değil,...Dialogue: 0,0:09:14.25,0:09:16.96,Main,,0,0,0,,...Devrimci Dragon'un da oğlu.Dialogue: 0,0:09:19.30,0:09:22.84,Main,,0,0,0,,Onu da yok etmeliyiz.Dialogue: 0,0:09:27.05,0:09:32.63,Main,,0,0,0,,Yaptığın onca şeyin yanında, bir de Hasır Şapkalı Luffy ile işbirliği yapmışsın.Dialogue: 0,0:09:32.63,0:09:35.39,Main,,0,0,0,,Cevabın bu mu, Jinbei?!Dialogue: 0,0:09:35.39,0:09:38.66,Main,,0,0,0,,Evet! Savaş Lordluğunu bıraktım!Dialogue: 0,0:09:39.55,0:09:43.70,Main,,0,0,0,,Nereden bakarsan bak, bu tuhaf bir takım.Dialogue: 0,0:09:43.84,0:09:47.88,Main,,0,0,0,,Hepsinin aynı amaca sahip olduğundan ciddi anlamda şüpheliyim.Dialogue: 0,0:09:47.88,0:09:50.34,Main,,0,0,0,,En azından bu savaş alanında değil.Dialogue: 0,0:10:04.38,0:10:05.74,Main,,0,0,0,,Croco çocuk nerede?Dialogue: 0,0:10:05.74,0:10:09.54,Main,,0,0,0,,Ha? Şey, durum göz önünde tutulursa...Dialogue: 0,0:10:10.30,0:10:11.51,Main,,0,0,0,,İşte orada!Dialogue: 0,0:10:15.29,0:10:17.03,Main,,0,0,0,,Beni alt etmeye çalışıyor!Dialogue: 0,0:10:19.19,0:10:21.33,Main,,0,0,0,,Crocodile, Beyazsakal'ın üstüne gidiyor!Dialogue: 0,0:10:21.33,0:10:22.10,Main,,0,0,0,,Babalık!Dialogue: 0,0:10:22.10,0:10:25.30,Main,,0,0,0,,Uzun zaman oldu, Beyazsakal!Dialogue: 0,0:10:25.30,0:10:27.71,Main,,0,0,0,,Hiç öğrenmiyorsun, değil mi?Dialogue: 0,0:10:50.66,0:10:55.63,Thoughts,,0,0,0,,Demek benimle dövüşmek için çoktan hazırlık yaptın, ha?Dialogue: 0,0:10:55.63,0:11:00.25,Flashbacks,,0,0,0,,Islanınca kuma dönüşemezsin!Dialogue: 0,0:11:05.42,0:11:11.20,Main,,0,0,0,,Anlaşmamıza sadık kalıp buraya gelmene yardım ettim.Dialogue: 0,0:11:11.20,0:11:13.92,Main,,0,0,0,,Niye Beyazsakal'ı savunuyorsun?Dialogue: 0,0:11:13.92,0:11:16.74,Main,,0,0,0,,Yani bu yaşlı adam gerçekten Beyazsakal mı?Dialogue: 0,0:11:16.74,0:11:18.56,Main,,0,0,0,,O zaman ona dokunma!Dialogue: 0,0:11:18.56,0:11:21.23,Main,,0,0,0,,Ace bu yaşlı adamı seviyor!Dialogue: 0,0:11:21.23,0:11:24.56,Main,,0,0,0,,Epey iyisin, Ace'in kardeşi.Dialogue: 0,0:11:25.95,0:11:28.00,Main,,0,0,0,,Babalığa yaklaşmasına izin vermeyin!Dialogue: 0,0:11:43.40,0:11:50.91,Flashbacks,,0,0,0,,Senin kadar büyük bir adam Doğu Denizi'nden bir kolu olmadan dönünce, herkes şaşırdı.Dialogue: 0,0:11:51.67,0:11:54.68,Flashbacks,,0,0,0,,Ne tür bir düşmana kaptırdın?Dialogue: 0,0:11:54.68,0:11:56.43,Flashbacks,,0,0,0,,Şu sol kolunu...Dialogue: 0,0:12:00.11,0:12:02.89,Flashbacks,,0,0,0,,Yeni bir çağa...Dialogue: 0,0:12:02.89,0:12:03.87,Flashbacks,,0,0,0,,...kolumla bahis oynadım.Dialogue: 0,0:12:04.36,0:12:07.91,Main,,0,0,0,,Çocuk... Şu hasır şapkan...Dialogue: 0,0:12:07.91,0:12:11.74,Main,,0,0,0,,...eskiden Kızıl Saç'ın kullandığı şapkaya çok benziyor.Dialogue: 0,0:12:12.43,0:12:15.12,Main,,0,0,0,,Yaşlı adam, Shanks'i tanıyor musun?Dialogue: 0,0:12:15.12,0:12:18.75,Main,,0,0,0,,Bunu Shanks için saklıyorum.Dialogue: 0,0:12:18.75,0:12:23.12,Flashbacks,,0,0,0,,Şuna bak, babalık! Bu benim kardeşim!Dialogue: 0,0:12:26.32,0:12:29.05,Main,,0,0,0,,Kardeşini kurtarmaya mı geldin?Dialogue: 0,0:12:29.05,0:12:30.06,Main,,0,0,0,,Evet!Dialogue: 0,0:12:30.06,0:12:33.73,Main,,0,0,0,,Neye karşı olduğunu anlamıyor musun?!Dialogue: 0,0:12:38.74,0:12:42.57,Main,,0,0,0,,Senin gibi birinin burada hiç şansı yok!Dialogue: 0,0:12:42.79,0:12:46.08,Main,,0,0,0,,Kapa çeneni! Buna sen karar veremezsin!Dialogue: 0,0:12:47.98,0:12:52.38,Main,,0,0,0,,Çok iyi biliyorum! Korsanlar Kralı olmak istiyorsun, değil mi?!Dialogue: 0,0:12:52.68,0:12:56.82,Main,,0,0,0,,Korsanlar Kralı olacak kişi benim!Dialogue: 0,0:13:15.74,0:13:18.04,Main,,0,0,0,,Epey arsızsın...Dialogue: 0,0:13:19.09,0:13:22.98,Main,,0,0,0,,Beni yavaşlatırsan acımayacağım, şımarık velet!Dialogue: 0,0:13:22.98,0:13:25.52,Main,,0,0,0,,Ben yapmak istediğim şeyi yapıyorum!Dialogue: 0,0:13:28.31,0:13:30.38,Main,,0,0,0,,Ace'i kendim kurtaracağım!Dialogue: 0,0:13:30.38,0:13:31.87,Main,,0,0,0,,O-O...Dialogue: 0,0:13:31.87,0:13:33.17,Main,,0,0,0,,...Beyazsakal'a karşı duruyor!Dialogue: 0,0:13:33.17,0:13:35.01,Main,,0,0,0,,İnanılmaz!Dialogue: 0,0:13:42.91,0:13:48.47,Main,,0,0,0,,Onların her birini öldürebilirim, değil mi, Sengoku-san?Dialogue: 0,0:13:49.07,0:13:50.17,Main,,0,0,0,,Elbette.Dialogue: 0,0:13:50.68,0:13:54.11,Main,,0,0,0,,Ace'in idam vaktini öne mi çekiyorlar?Dialogue: 0,0:13:54.11,0:13:56.38,Main,,0,0,0,,Söylediklerinin bu olduğuna emin misin?Dialogue: 0,0:13:56.38,0:13:59.54,Main,,0,0,0,,Bazı hazırlıkları bitirdikten sonra.Dialogue: 0,0:13:59.54,0:14:01.59,Main,,0,0,0,,Sonra da anlamadığım bir kod söylediler.Dialogue: 0,0:14:02.92,0:14:06.89,Main,,0,0,0,,Ace'i kurtarmayı istediğin için, sana söylemeyi düşündüm!Dialogue: 0,0:14:07.71,0:14:11.76,Main,,0,0,0,,Anlıyorum. Bu epey önemli bir haber.Dialogue: 0,0:14:11.76,0:14:13.30,Main,,0,0,0,,Demin için üzgünüm.Dialogue: 0,0:14:13.30,0:14:14.87,Main,,0,0,0,,Sorun değil.Dialogue: 0,0:14:15.52,0:14:19.34,Main,,0,0,0,,Niye böyle arkadaşça bir sohbet içindeler?!Dialogue: 0,0:14:19.34,0:14:21.11,Main,,0,0,0,,Tamam!Dialogue: 0,0:14:21.11,0:14:23.64,Main,,0,0,0,,Ace, hemen geliyorum!Dialogue: 0,0:14:25.98,0:14:27.48,Main,,0,0,0,,Nasıl kendine bu kadar güvenebilir?!Dialogue: 0,0:14:31.83,0:14:33.65,Luffy,,0,0,0,,Gomu Gomu no...Dialogue: 0,0:14:33.66,0:14:35.70,Luffy,,0,0,0,karaoke,BazukaDialogue: 0,0:14:36.39,0:14:39.06,Main,,0,0,0,,Çekilin!Dialogue: 0,0:14:39.06,0:14:41.51,Main,,0,0,0,,Ace'in kardeşi o mu?Dialogue: 0,0:14:42.06,0:14:43.98,Main,,0,0,0,,Çocuğun yoluna çıkmayın!Dialogue: 0,0:14:43.98,0:14:46.06,Main,,0,0,0,,Üçüncü Bölüm, saldırınıza başlayın!Dialogue: 0,0:14:47.53,0:14:49.52,Main,,0,0,0,,Biz de gidiyoruz.Dialogue: 0,0:14:53.04,0:14:54.84,Main,,0,0,0,,Cidden mi?!Dialogue: 0,0:14:56.71,0:14:59.82,Main,,0,0,0,,On Dördüncü Bölüm, onun yolunu temizleyin!Dialogue: 0,0:14:59.82,0:15:01.55,Main,,0,0,0,,Emredersin Kumandan Jill!Dialogue: 0,0:15:05.33,0:15:06.38,Main,,0,0,0,,Luffy...Dialogue: 0,0:15:07.07,0:15:11.36,Main,,0,0,0,,Sırf bir adamın pervasızlığı onları bu kadar kızdırdı mı?Dialogue: 0,0:15:12.26,0:15:14.63,Main,,0,0,0,,Yine de bu planlarımızı değiştirmeyecek.Dialogue: 0,0:15:15.38,0:15:16.92,Main,,0,0,0,,Dikkatiniz dağılmasın!Dialogue: 0,0:15:16.92,0:15:18.93,Main,,0,0,0,,Tarif edildiği gibi ilerleyin!Dialogue: 0,0:15:19.93,0:15:22.00,Main,,0,0,0,,Sengoku...Dialogue: 0,0:15:22.00,0:15:27.26,Main,,0,0,0,,Şimdi korsanlara karşı olduğuna göre, eski idam saatine uymaya gerek yok mu?Dialogue: 0,0:15:27.26,0:15:30.88,Main,,0,0,0,,Planladığı "hazırlıklar" işin anahtarı olmalı.Dialogue: 0,0:15:33.42,0:15:34.31,Main,,0,0,0,,Babalık!Dialogue: 0,0:15:34.31,0:15:38.22,Main,,0,0,0,,Denizci sinyallerine bakılırsa, Ace'in idamını hızlandıracaklar.Dialogue: 0,0:15:38.67,0:15:40.62,Main,,0,0,0,,Evet, duydum.Dialogue: 0,0:15:41.36,0:15:46.76,Main,,0,0,0,,Sızan bilgi yüzünden paniklemeye başlarsak, onların planları doğrultusunda oynamış oluruz.Dialogue: 0,0:15:47.98,0:15:51.56,Main,,0,0,0,,O dikkatsiz değildir. Kaza değil.Dialogue: 0,0:15:51.83,0:15:56.43,Main,,0,0,0,,O adamdan beklenmez.Dialogue: 0,0:15:56.43,0:15:58.14,Main,,0,0,0,,İlerleyin!Dialogue: 0,0:16:01.89,0:16:03.94,Main,,0,0,0,,Işık hızında tekmeler?!Dialogue: 0,0:16:06.32,0:16:11.91,Main,,0,0,0,,Kendinizi kaptırmayın. O kadar kolay geçmenize izin vermem.Dialogue: 0,0:16:12.42,0:16:14.22,Main,,0,0,0,,Bu Amiral Kizaru!Dialogue: 0,0:16:17.04,0:16:19.16,Main,,0,0,0,,Bu sensin, Sabaody'den!Dialogue: 0,0:16:19.16,0:16:24.66,Main,,0,0,0,,Yeniden kaçmana izin verirsem, Kutsal Ejderler tepeme binecek.Dialogue: 0,0:16:25.06,0:16:26.90,Main,,0,0,0,,Hasır Şapkalı Luffy.Dialogue: 0,0:16:28.93,0:16:31.97,Main,,0,0,0,,Hasır Şapkalı çocuk ölmek üzere!Dialogue: 0,0:16:32.15,0:16:34.90,Main,,0,0,0,,Ölüm Göz KırpışıDialogue: 0,0:16:43.86,0:16:46.75,Main,,0,0,0,,Geri dönüp eve gitmek istiyorum!Dialogue: 0,0:16:46.75,0:16:49.44,Main,,0,0,0,,Ne, Kaptan Buggy?!Dialogue: 0,0:16:49.44,0:16:51.42,Main,,0,0,0,,Söylediğin şeye inanamıyorum!Dialogue: 0,0:16:51.69,0:16:52.79,Main,,0,0,0,,Ha?Dialogue: 0,0:16:52.79,0:16:56.81,Main,,0,0,0,,Bu savaşın gidişatını mı değiştirmek istiyorsun? Ciddi misin?!Dialogue: 0,0:16:56.81,0:16:58.28,Main,,0,0,0,,Şey, ben...Dialogue: 0,0:16:58.28,0:17:00.17,Main,,0,0,0,,Efsanevi denizciden daha azı beklenmez!Dialogue: 0,0:17:00.17,0:17:02.68,Main,,0,0,0,,Amiral Kizaru ile yüzleşmekten bile çekinmiyor!Dialogue: 0,0:17:02.68,0:17:03.77,Main,,0,0,0,,Şey, hayır...Dialogue: 0,0:17:03.77,0:17:06.17,Main,,0,0,0,,Siz sadece duymak istediğinizi duyuyorsunuz!Dialogue: 0,0:17:06.17,0:17:08.34,Main,,0,0,0,,Hasır Şapkalı çocuk, iyi misin?Dialogue: 0,0:17:08.34,0:17:10.94,Main,,0,0,0,,Çok yakındı! Sağol, Iva-chan!Dialogue: 0,0:17:10.94,0:17:15.21,Main,,0,0,0,,Seni ölümden korumak benim görevim!Dialogue: 0,0:17:17.09,0:17:18.12,Main,,0,0,0,,Yine Kizaru!Dialogue: 0,0:17:19.18,0:17:21.79,Main,,0,0,0,,Hayır, dur. O...Dialogue: 0,0:17:21.79,0:17:22.62,Main,,0,0,0,,Kuma!Dialogue: 0,0:17:23.27,0:17:27.12,Main,,0,0,0,,Hepimizi havaya uçuran ayı adam!Dialogue: 0,0:17:29.36,0:17:31.36,Main,,0,0,0,,Yuvarlanan EstetikDialogue: 0,0:17:37.67,0:17:39.20,Main,,0,0,0,,Bartholomew Kuma!Dialogue: 0,0:17:39.20,0:17:40.82,Thoughts,,0,0,0,,Bu korkunç!Dialogue: 0,0:17:40.82,0:17:43.98,Thoughts,,0,0,0,,Diğer Savaş Lordları ile duruyor olsa bile,...Dialogue: 0,0:17:43.98,0:17:48.48,Thoughts,,0,0,0,,...atlattığımız onca badirenin ardından bana lazer mi fırlatıyor?Dialogue: 0,0:18:01.86,0:18:05.86,Main,,0,0,0,,Bize rastlaman ne büyük şanssızlık.Dialogue: 0,0:18:05.86,0:18:09.47,Main,,0,0,0,,Hasır Şapka. Senin için her şeyin bittiği yer burası.Dialogue: 0,0:18:09.72,0:18:12.34,Main,,0,0,0,,Ha... Sen kimsin?Dialogue: 0,0:18:13.32,0:18:14.34,Main,,0,0,0,,Ben Fullbody!Dialogue: 0,0:18:15.46,0:18:19.08,Main,,0,0,0,,Yüzen restoran Baratie'den sana hala borcum var!Dialogue: 0,0:18:19.35,0:18:21.58,Main,,0,0,0,,Ah... Sanji'nin canına okuduğu adam.Dialogue: 0,0:18:22.76,0:18:25.78,Main,,0,0,0,,Yoksa bu *chakramları unuttun mu?Dialogue: 0,0:18:26.30,0:18:28.99,Main,,0,0,0,,Sen Usopp'un köyündeki şu ipnotizmacı değil misin?Dialogue: 0,0:18:28.99,0:18:30.32,Main,,0,0,0,,Ne yapıyorsunuz burada?Dialogue: 0,0:18:31.48,0:18:33.65,Main,,0,0,0,,Denizciler'in yardımıyla Jango-sama'nın...Dialogue: 0,0:18:33.65,0:18:35.44,Main,,0,0,0,,...Hipnozu'nu mükemmelleştirdim.Dialogue: 0,0:18:36.28,0:18:39.25,Main,,0,0,0,,İki chakram. İki kat etkili.Dialogue: 0,0:18:39.25,0:18:42.27,Main,,0,0,0,,"Bir, İki, Jango" ile uykuya dalacaksın.Dialogue: 0,0:18:42.27,0:18:45.17,Main,,0,0,0,,Bir, İki...Dialogue: 0,0:18:45.17,0:18:46.49,Main,,0,0,0,,Jango!Dialogue: 0,0:18:54.64,0:18:56.64,Main,,0,0,0,,Neler oluyor?Dialogue: 0,0:18:59.85,0:19:01.32,Main,,0,0,0,,Hina hayal kırıklığına uğradı.Dialogue: 0,0:19:01.32,0:19:04.31,Main,,0,0,0,,Sen... Seninle Alabasta'da karşılaşmıştım!Dialogue: 0,0:19:04.31,0:19:06.49,Main,,0,0,0,,Sizinle daha fazla kaybedecek zamanım yok!Dialogue: 0,0:19:07.38,0:19:08.80,Main,,0,0,0,,Kaçmana izin vermeyeceğim.Dialogue: 0,0:19:08.80,0:19:10.20,Main,,0,0,0,,Kış Kimonosu Kanat KafesiDialogue: 0,0:19:14.54,0:19:19.04,Main,,0,0,0,,Bedenimden geçen her şey... sıkıca kilitlenir.Dialogue: 0,0:19:19.04,0:19:21.15,Main,,0,0,0,,İşte, onun meşhur tabiri!Dialogue: 0,0:19:21.15,0:19:23.34,Main,,0,0,0,,Şimdi Madam Hina tarafından büyüleneceksin!Dialogue: 0,0:19:23.34,0:19:25.74,Main,,0,0,0,,Yeterince hapisanede kaldım!Dialogue: 0,0:19:25.89,0:19:26.81,Main,,0,0,0,,İkinci DüzenDialogue: 0,0:19:33.58,0:19:34.56,Main,,0,0,0,,Çok hızlı!Dialogue: 0,0:19:34.56,0:19:35.72,Main,,0,0,0,,Onu göremedim!Dialogue: 0,0:19:36.44,0:19:38.06,Main,,0,0,0,,Hina ihmalkâr.Dialogue: 0,0:19:38.06,0:19:40.27,Main,,0,0,0,,Bizim de ihmalkârlığımız.Dialogue: 0,0:19:40.27,0:19:43.89,Main,,0,0,0,,Madam Hina bedenlerimizi ve kalplerimizi bağladı.Dialogue: 0,0:19:43.89,0:19:45.53,Main,,0,0,0,,Dur bakalım!Dialogue: 0,0:20:06.24,0:20:07.82,Main,,0,0,0,,Bu heriflerin her biri güçlü!Dialogue: 0,0:20:12.59,0:20:14.43,Main,,0,0,0,,Hasır Şapka!Dialogue: 0,0:20:14.43,0:20:17.23,Main,,0,0,0,,Yeteneği her zamanki gibi etkileyici.Dialogue: 0,0:20:17.23,0:20:18.77,Main,,0,0,0,,Tabii ya.Dialogue: 0,0:20:18.77,0:20:23.22,Main,,0,0,0,,Bir kez daha gölgesini alacağım ve onunla Oz'u hayata döndüreceğim.Dialogue: 0,0:20:26.19,0:20:28.87,Main,,0,0,0,,Çıkın ve oynayın, zombi savaşçılar!Dialogue: 0,0:20:37.38,0:20:43.72,Main,,0,0,0,,Şimdi, gidip Hasır Şapka'yı yakalayın!Dialogue: 0,0:20:44.25,0:20:45.49,Main,,0,0,0,,Moria!Dialogue: 0,0:20:45.49,0:20:47.22,Main,,0,0,0,,Sert biri daha.Dialogue: 0,0:21:03.40,0:21:05.84,Main,,0,0,0,,Onları geri al!Dialogue: 0,0:21:10.79,0:21:11.75,Main,,0,0,0,,Dahası var!Dialogue: 0,0:21:11.75,0:21:14.73,Main,,0,0,0,,Elbette! Burası savaş alanı!Dialogue: 0,0:21:14.73,0:21:18.36,Main,,0,0,0,,Ölen insanlar benim zombi orduma ekleniyor!Dialogue: 0,0:21:18.65,0:21:20.00,Main,,0,0,0,,Hasır Şapka'yı yakalayın!Dialogue: 0,0:21:20.00,0:21:22.26,Main,,0,0,0,,Hapisane kaçışının ardındaki suçlu o!Dialogue: 0,0:21:22.26,0:21:24.66,Main,,0,0,0,,Devam edin!Dialogue: 0,0:21:25.35,0:21:28.03,Main,,0,0,0,,Rakiplerinizin hepsi yetkili subaylar.Dialogue: 0,0:21:28.52,0:21:31.44,Main,,0,0,0,,Ne kadar ileri gidebileceğinizi sanıyorsunuz?Dialogue: 0,0:21:34.06,0:21:35.51,Main,,0,0,0,,Luffy...Dialogue: 0,0:21:55.48,0:21:57.46,Main,,0,0,0,,Uzak dur, Luffy!Dialogue: 0,0:22:13.59,0:22:15.91,Main,,0,0,0,,Zaten biliyor olmalısın!Dialogue: 0,0:22:15.91,0:22:18.52,Main,,0,0,0,,İkimiz de korsanız!Dialogue: 0,0:22:18.52,0:22:21.55,Main,,0,0,0,,İstediğin gibi denizlerde dolaşıyor olmalısın!Dialogue: 0,0:22:21.55,0:22:24.82,Main,,0,0,0,,Benim kendi maceralarım var!Dialogue: 0,0:22:25.42,0:22:28.66,Main,,0,0,0,,Kendi arkadaşlarım var!Dialogue: 0,0:22:29.80,0:22:30.83,Main,,0,0,0,,Ace...Dialogue: 0,0:22:30.83,0:22:35.27,Main,,0,0,0,,Buna karışmaya hakkın yok!Dialogue: 0,0:22:35.70,0:22:38.88,Main,,0,0,0,,Senin gibi güçsüzün biri beni kurtarmaya geliyor...Dialogue: 0,0:22:38.88,0:22:39.44,Main,,0,0,0,,Çekil!Dialogue: 0,0:22:39.78,0:22:43.27,Main,,0,0,0,,Bunun olmasına izin vereceğimi mi sanıyorsun?!Dialogue: 0,0:22:43.66,0:22:45.44,Main,,0,0,0,,Bu çok aşağılayıcı olurdu.Dialogue: 0,0:22:45.78,0:22:49.41,Main,,0,0,0,,Geri dön, Luffy! Niye geldin?!Dialogue: 0,0:22:51.67,0:22:53.98,Thoughts,,0,0,0,,Lütfen, Luffy...Dialogue: 0,0:22:53.98,0:22:57.55,Thoughts,,0,0,0,,Seni yanımda götürmek istemiyorum!Dialogue: 0,0:22:58.28,0:23:01.62,Thoughts,,0,0,0,,Bu benim başarısızlığım.Dialogue: 0,0:23:03.86,0:23:04.70,Main,,0,0,0,,Ben...Dialogue: 0,0:23:05.83,0:23:07.80,Main,,0,0,0,,...senin kardeşinim!Dialogue: 0,0:23:14.64,0:23:16.04,Flashbacks,,0,0,0,,Bilmiyor musun?Dialogue: 0,0:23:16.57,0:23:20.16,Flashbacks,,0,0,0,,Sake fincanlarını değişince kardeş olursun.Dialogue: 0,0:23:21.95,0:23:25.40,Flashbacks,,0,0,0,,Bugünden sonra kardeşiz!Dialogue: 0,0:23:33.56,0:23:36.06,Main,,0,0,0,,Demin kesinlikle "kardeşim" dedi.Dialogue: 0,0:23:36.06,0:23:37.83,Main,,0,0,0,,O zaman o da Roger'ın...Dialogue: 0,0:23:38.06,0:23:40.92,Main,,0,0,0,,Ace'in ailesi o doğduktan sonra öldü!Dialogue: 0,0:23:40.92,0:23:42.73,Main,,0,0,0,,Kardeşi olması mümkün değil!Dialogue: 0,0:23:43.95,0:23:45.72,Main,,0,0,0,,Şu aptal korsan "kurallarını"...Dialogue: 0,0:23:46.50,0:23:48.55,Main,,0,0,0,,...hiç duymadım!Dialogue: 0,0:23:48.55,0:23:49.78,Main,,0,0,0,,Anlamıyor musun?Dialogue: 0,0:23:53.19,0:23:56.41,Main,,0,0,0,,Gidin, zombi adamlarım!Dialogue: 0,0:24:04.69,0:24:06.36,Main,,0,0,0,,D-Deniz suyu?Dialogue: 0,0:24:09.32,0:24:10.36,Main,,0,0,0,,Jinbe!Dialogue: 0,0:24:10.36,0:24:12.56,Main,,0,0,0,,Moria, şu zombilerin...Dialogue: 0,0:24:12.56,0:24:15.10,Main,,0,0,0,,...tuza hiç dayanamıyor.Dialogue: 0,0:24:16.17,0:24:19.34,Main,,0,0,0,,Luffy-kun, zombileri bana bırak.Dialogue: 0,0:24:19.34,0:24:19.84,Main,,0,0,0,,Sana güveniyorum.Dialogue: 0,0:24:19.84,0:24:21.70,Main,,0,0,0,,Denizin Şövalyesi Jinbei!Dialogue: 0,0:24:21.70,0:24:23.07,Main,,0,0,0,,Yedi Savaş Lordu'nun eski üyesi...Dialogue: 0,0:24:23.07,0:24:24.44,Main,,0,0,0,,Ne yapıyorsunuz?Dialogue: 0,0:24:24.44,0:24:28.28,Main,,0,0,0,,Sadece bir çaylak... Tüm savaşı bu tarafa dikte etmesine izin vermeyin!Dialogue: 0,0:24:28.28,0:24:30.68,Main,,0,0,0,,Çekilin yolumdan!Dialogue: 0,0:24:30.68,0:24:33.00,Main,,0,0,0,,Onu ezeceğim!Dialogue: 0,0:24:38.89,0:24:42.29,Main,,0,0,0,,O adam ileride tehlike arz edecek.Dialogue: 0,0:24:42.29,0:24:46.06,Main,,0,0,0,,Yeminli kardeşi Ace'le birlikte büyütüldü.Dialogue: 0,0:24:46.06,0:24:51.74,Main,,0,0,0,,Ama asıl kan bağı onu Devrimci Dragon'un oğlu yapıyor!Dialogue: 0,0:24:51.74,0:24:53.84,Main,,0,0,0,,Devrimci Dragon mu?!Dialogue: 0,0:24:53.84,0:24:56.17,Main,,0,0,0,,Dünyanın en korkutucu suçlusunun oğlu mu?!Dialogue: 0,0:24:56.17,0:24:59.03,Main,,0,0,0,,Ve ben bu kişiyi tanıyorum!Dialogue: 0,0:24:59.03,0:25:01.01,Main,,0,0,0,,Babası ensesi kalın biri!Dialogue: 0,0:25:01.01,0:25:02.77,Main,,0,0,0,,Söyledi işte.Dialogue: 0,0:25:02.77,0:25:03.71,Main,,0,0,0,,Luffy-san...!Dialogue: 0,0:25:06.15,0:25:07.61,Main,,0,0,0,,Luffy...Dialogue: 0,0:25:07.61,0:25:10.75,Thoughts,,0,0,0,,Bir şeytanın çocuğu olduğunu bilmek beni...Dialogue: 0,0:25:14.38,0:25:15.86,Main,,0,0,0,,Demek öyle!Dialogue: 0,0:25:16.54,0:25:18.08,Main,,0,0,0,,Şimdi anlıyorum.Dialogue: 0,0:25:18.08,0:25:19.20,Flashbacks,,0,0,0,,Pislik!Dialogue: 0,0:25:32.62,0:25:35.43,Main,,0,0,0,,Böylece Loguetown'daki bilmece çözülmüş oldu.Dialogue: 0,0:25:36.32,0:25:39.04,Main,,0,0,0,,Bu yüzden Dragon onu kurtardı.Dialogue: 0,0:25:39.04,0:25:40.72,Main,,0,0,0,,Bunu duydunuz mu?Dialogue: 0,0:25:42.46,0:25:44.33,Main,,0,0,0,,Dragon... Dragon?!Dialogue: 0,0:25:44.33,0:25:46.02,Main,,0,0,0,,Merkez büro! Merkez büro!Dialogue: 0,0:25:46.02,0:25:47.70,Main,,0,0,0,,Burası Sabaody Takımadası.Dialogue: 0,0:25:47.70,0:25:48.77,Main,,0,0,0,,Büyük haber!Dialogue: 0,0:25:48.77,0:25:51.06,Main,,0,0,0,,D-Dünyaya anlatın!Dialogue: 0,0:25:52.10,0:25:54.23,Main,,0,0,0,,Onun yaşamasına izin vermemeliyiz!Dialogue: 0,0:25:55.30,0:25:57.03,Main,,0,0,0,,Her şeyimizle işini bitirin!Dialogue: 0,0:25:58.31,0:25:59.68,Main,,0,0,0,,Farketmez.Dialogue: 0,0:25:59.68,0:26:02.08,Main,,0,0,0,,Artık gizlemenin manası yok.Dialogue: 0,0:26:02.08,0:26:06.81,Main,,0,0,0,,Luffy'ye öyle bir yafta vurulmuşken, benim bile yardım edemeyeceğim bir kanun kaçağı haline geldi.Dialogue: 0,0:26:08.64,0:26:11.58,Main,,0,0,0,,Onları kardeş olarak büyütmek büyük bir hataydı!Dialogue: 0,0:26:12.31,0:26:13.43,Luffy,,0,0,0,,Üçüncü DüzenDialogue: 0,0:26:21.51,0:26:23.08,Luffy,,0,0,0,,Gomu Gomu no...Dialogue: 0,0:26:24.23,0:26:30.39,Luffy,,0,0,0,,Dev TüfekDialogue: 0,0:26:37.06,0:26:39.71,Main,,0,0,0,,Ace!Dialogue: 0,0:26:41.85,0:26:44.58,Main,,0,0,0,,Ne istersen söyle!Dialogue: 0,0:26:44.58,0:26:47.52,Main,,0,0,0,,Ölsem bile seni kurtaracağım!Dialogue: 0,0:26:48.99,0:26:50.48,Main,,0,0,0,,Çocuk.Dialogue: 0,0:26:50.48,0:26:52.76,Main,,0,0,0,,Bunu ona sadece Hasır Şapka söyleyebilirdi!Dialogue: 0,0:26:52.76,0:26:54.98,Main,,0,0,0,,Biz Ace'in ailesiyiz!Dialogue: 0,0:26:54.98,0:26:56.49,Main,,0,0,0,,Bize onu kurtarabileceğini göster!Dialogue: 0,0:26:58.38,0:27:01.63,Main,,0,0,0,,Marco, onun ölmesine izin verme.Dialogue: 0,0:27:02.39,0:27:03.27,Main,,0,0,0,,Anlaşıldı.Dialogue: 0,0:27:10.58,0:27:11.89,Main,,0,0,0,,Luffy...