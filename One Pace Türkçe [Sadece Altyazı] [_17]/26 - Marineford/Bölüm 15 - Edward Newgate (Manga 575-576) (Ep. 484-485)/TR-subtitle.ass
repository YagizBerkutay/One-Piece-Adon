Dialogue: 0,0:02:40.44,0:02:47.35,Title,,0,0,120,,{\fad(1250,1250)}Edward Newgate
Dialogue: 0,0:02:47.41,0:02:49.58,Main,,0,0,0,,Olamaz!
Dialogue: 0,0:03:01.68,0:03:04.36,Main,,0,0,0,,Ace...!
Dialogue: 0,0:03:10.06,0:03:11.37,Main,,0,0,0,,Ace!
Dialogue: 0,0:03:41.66,0:03:46.97,Main,,0,0,0,,Ace!
Dialogue: 0,0:03:55.90,0:03:58.25,Main,,0,0,0,,Ateş Yumruk Ace öldü!
Dialogue: 0,0:04:16.80,0:04:18.24,Main,,0,0,0,,Hasır Şapkalı Çocuk!
Dialogue: 0,0:04:18.82,0:04:20.87,Thoughts,,0,0,0,,{\i1}Kafayı oynattı.{\i0}
Dialogue: 0,0:04:21.51,0:04:23.68,Thoughts,,0,0,0,,{\i1}Hayatı tehlikede!{\i0}
Dialogue: 0,0:04:36.66,0:04:37.86,Main,,0,0,0,,Bu Akainu!
Dialogue: 0,0:04:38.32,0:04:42.19,Main,,0,0,0,,Şimdi sıradaki sensin!
Dialogue: 0,0:04:44.92,0:04:47.36,Main,,0,0,0,,Hasır Şapka!
Dialogue: 0,0:04:56.40,0:04:59.18,Main,,0,0,0,,Onu öldürmene izin vermeyeceğim!
Dialogue: 0,0:05:00.36,0:05:04.08,Main,,0,0,0,,Luffy-kun! Luffy-kun! Kendine gel!
Dialogue: 0,0:05:04.08,0:05:06.69,Main,,0,0,0,,Yolumdan çekil!
Dialogue: 0,0:05:12.48,0:05:15.96,Main,,0,0,0,,Dövüş daha bitmedi!
Dialogue: 0,0:05:17.80,0:05:21.27,Main,,0,0,0,,Ace'in kardeşini buradan çıkar, Jinbe!
Dialogue: 0,0:05:21.27,0:05:22.84,Main,,0,0,0,,Anlaşıldı!
Dialogue: 0,0:05:23.66,0:05:27.61,Main,,0,0,0,,Hasır Şapka'nın hayatta\Nkalması, Ace'in son isteğiydi!
Dialogue: 0,0:05:28.64,0:05:30.94,Main,,0,0,0,,Kumandan Marco...
Dialogue: 0,0:05:35.95,0:05:39.92,Main,,0,0,0,,Ace'in yerine onu muhakkak koruyacağız!
Dialogue: 0,0:05:40.72,0:05:42.95,Main,,0,0,0,,Ölmesine izin verirsek,...
Dialogue: 0,0:05:44.16,0:05:48.69,Main,,0,0,0,,...Beyazsakal Korsanları'nın\Nen büyük utancı bu olacak!
Dialogue: 0,0:05:55.00,0:05:57.84,Main,,0,0,0,,Luffy-kun! Dayan!
Dialogue: 0,0:05:59.64,0:06:04.14,Main,,0,0,0,,Sanırım hiçbirinin kaçmasına izin vermeyeceğimi söylemiştim!
Dialogue: 0,0:06:10.35,0:06:12.65,Main,,0,0,0,,Hasır Şapka!
Dialogue: 0,0:06:14.95,0:06:15.79,Main,,0,0,0,,Akainu{\i1}-san{\i0}!
Dialogue: 0,0:07:00.03,0:07:01.73,Main,,0,0,0,,Babalık kızdı!
Dialogue: 0,0:07:01.73,0:07:03.77,Main,,0,0,0,,Hepiniz buradan uzaklaşın!
Dialogue: 0,0:07:25.80,0:07:28.44,Main,,0,0,0,,Kara Köpek!{\fad(150,150)}
Dialogue: 0,0:07:32.50,0:07:33.70,Main,,0,0,0,,Babalık!
Dialogue: 0,0:09:09.96,0:09:12.90,Main,,0,0,0,,Denizci Karargâhı çöküyor!
Dialogue: 0,0:09:23.48,0:09:26.01,Main,,0,0,0,,Lanet olası...
Dialogue: 0,0:09:29.82,0:09:32.96,Main,,0,0,0,,...Beyazsakal!
Dialogue: 0,0:09:36.28,0:09:38.69,Main,,0,0,0,,Amiral Sakazuki!
Dialogue: 0,0:09:42.89,0:09:45.20,Main,,0,0,0,,– Düşmeyin!\N– Tutunun!
Dialogue: 0,0:10:09.22,0:10:10.79,Main,,0,0,0,,Bitti mi?
Dialogue: 0,0:10:13.14,0:10:14.72,Main,,0,0,0,,Babalık!
Dialogue: 0,0:10:19.06,0:10:23.97,Main,,0,0,0,,Meydanı boydan boya ikiye böldü!\NKorsanlar yarığın diğer tarafında!
Dialogue: 0,0:10:25.57,0:10:29.07,Main,,0,0,0,,Babalıktan tamamen koptuk!
Dialogue: 0,0:10:29.07,0:10:31.02,Main,,0,0,0,,Babalık!
Dialogue: 0,0:10:32.98,0:10:36.95,Main,,0,0,0,,İç organları kızarmışken bile bu kadar güçlü mü?!
Dialogue: 0,0:10:42.26,0:10:44.16,Main,,0,0,0,,Daha bitirmedim!
Dialogue: 0,0:10:50.93,0:10:54.53,Main,,0,0,0,,Herkes gemilere binsin!
Dialogue: 0,0:10:54.53,0:10:55.64,Main,,0,0,0,,Babalık!
Dialogue: 0,0:10:55.64,0:11:01.97,Main,,0,0,0,,Bize emanet ettiği hayallerin gerisinde kalmasının nedenini bir düşünün!
Dialogue: 0,0:11:01.97,0:11:04.44,Main,,0,0,0,,Onun için üzülecekseniz, gemide üzülün!
Dialogue: 0,0:11:04.44,0:11:08.28,Main,,0,0,0,,– Babalık! Ace!\N– Çabuk!
Dialogue: 0,0:11:11.44,0:11:15.95,Main,,0,0,0,,Denize dayanabilecek tüm\Ngemileri kıyıda toplayın!
Dialogue: 0,0:11:17.04,0:11:19.20,Main,,0,0,0,,Kaçmanıza izin vereceğimizi mi sanıyorsunuz?!
Dialogue: 0,0:11:20.09,0:11:22.29,Main,,0,0,0,,Herkes acele etsin!
Dialogue: 0,0:11:27.03,0:11:30.62,Main,,0,0,0,,Lütfen! Luffy'nin güvenliğinden endişe ediyorum!
Dialogue: 0,0:11:34.37,0:11:37.31,Main,,0,0,0,,Hey, bakın! O da ne?!
Dialogue: 0,0:11:39.02,0:11:42.08,Main,,0,0,0,,Karargâhın ardındaki\Ngölgelerde gizlenen biri var!
Dialogue: 0,0:11:42.08,0:11:44.78,Main,,0,0,0,,Ah. Beni gördüler.
Dialogue: 0,0:11:44.78,0:11:48.49,Main,,0,0,0,,Sadece o değil! İdam sehpasında\Nduran o insanlar da kim?!
Dialogue: 0,0:11:49.58,0:11:53.19,Main,,0,0,0,,Nihayet bizi farkettiler.
Dialogue: 0,0:11:53.19,0:11:56.60,Main,,0,0,0,,Siz... Buraya nasıl geldiniz?!
Dialogue: 0,0:11:58.28,0:12:00.93,Main,,0,0,0,,Onlar burada ne yapıyor?!
Dialogue: 0,0:12:02.42,0:12:05.64,Main,,0,0,0,,Küçük velet...
Dialogue: 0,0:12:07.08,0:12:13.61,Main,,0,0,0,,Hepsi varlıkları kayıtlardan silinen çok kötü suçlular!
Dialogue: 0,0:12:15.42,0:12:18.42,Main,,0,0,0,,O kadar büyük başka kimse yoktur!
Dialogue: 0,0:12:18.42,0:12:21.47,Main,,0,0,0,,Korsan... Dev Savaş Gemisi, Sanjuan Wolf!
Dialogue: 0,0:12:22.20,0:12:26.89,Main,,0,0,0,,Ah. Sadece görmekle kalmadılar,\Nkim olduğumu da öğrendiler.{\an8}
Dialogue: 0,0:12:27.32,0:12:30.58,Main,,0,0,0,,Soysuz Kral, Avalo Pizarro!{\an8}
Dialogue: 0,0:12:30.58,0:12:33.60,Main,,0,0,0,,Dışarıda olmak ne kadar rahatlatıcı!{\an8}
Dialogue: 0,0:12:34.00,0:12:36.66,Main,,0,0,0,,{\an8}Büyük İçici, Vasco Shot!
Dialogue: 0,0:12:43.80,0:12:46.08,Main,,0,0,0,,{\an8}Aşağıdakileri öldürebilir miyim?
Dialogue: 0,0:12:46.50,0:12:49.61,Main,,0,0,0,,{\an8}Hilal Avcı, Catarina Devon!
Dialogue: 0,0:12:51.52,0:12:54.55,Main,,0,0,0,,{\an8}Sizden de hoşlandım.
Dialogue: 0,0:12:55.06,0:12:58.70,Main,,0,0,0,,{\an8}Impel Down'ın Baş Gardiyanı,...
Dialogue: 0,0:12:58.70,0:13:00.56,Main,,0,0,0,,{\an8}...Yağmur Shiryu!
Dialogue: 0,0:12:21.47,0:12:26.89,Captions,,0,0,0,,{\fad(800,0)}"Dev Savaş Gemisi" Sanjuan Wolf
Dialogue: 0,0:12:29.03,0:12:33.60,Captions,,0,0,0,,{\fad(800,0)}"Soysuz Kral" Avalo Pizarro
Dialogue: 0,0:12:38.37,0:12:46.07,Captions,,0,0,0,,{\fad(800,0)}"Büyük İçici" Vasco Shot
Dialogue: 0,0:12:48.03,0:12:54.55,Captions,,0,0,0,,{\fad(940,0)}"Hilal Avcı" Catarina Devon
Dialogue: 0,0:12:55.65,0:13:00.56,Captions,,0,0,0,,{\fad(800,0)}Yağmur Shiryu
Dialogue: 0,0:13:01.14,0:13:03.26,Main,,0,0,0,,Karasakal Korsanları!
Dialogue: 0,0:13:08.84,0:13:14.18,Main,,0,0,0,,Görüşmeyeli uzun zaman oldu! \NÖlümünden önce seni gördüğüme sevindim,...
Dialogue: 0,0:13:14.18,0:13:15.94,Main,,0,0,0,,...Babalık!
Dialogue: 0,0:13:15.94,0:13:18.91,Main,,0,0,0,,Teach...!
Dialogue: 0,0:13:33.36,0:13:36.29,Main,,0,0,0,,Shiryu! Pislik...
Dialogue: 0,0:13:37.56,0:13:42.27,Main,,0,0,0,,Magellan'a ne oldu? Impel Down'a ne oldu?!
Dialogue: 0,0:13:43.36,0:13:46.54,Main,,0,0,0,,Hepiniz buraya nasıl geldiniz?!
Dialogue: 0,0:13:48.14,0:13:52.98,Main,,0,0,0,,Zaten burada olmamız\Nsorunu cevaplamıyor mu,...
Dialogue: 0,0:13:52.98,0:13:55.85,Main,,0,0,0,,...Filo Amirali Sengoku-san?
Dialogue: 0,0:13:59.64,0:14:01.74,Main,,0,0,0,,Detayları bilmek istiyorsan,...
Dialogue: 0,0:14:01.74,0:14:04.76,Main,,0,0,0,,...sonra gidip kendin öğrenebilirsin.
Dialogue: 0,0:14:04.76,0:14:08.20,Main,,0,0,0,,Yine de bu insanlarla birlik olmaya karar verdim.
Dialogue: 0,0:14:08.20,0:14:09.89,Main,,0,0,0,,Bunu aklında tut.
Dialogue: 0,0:14:13.64,0:14:15.37,Main,,0,0,0,,Filo Amirali Sengoku!
Dialogue: 0,0:14:16.28,0:14:19.12,Main,,0,0,0,,Bunu daha önce bildirme şansım olmadı,...
Dialogue: 0,0:14:21.92,0:14:25.10,Main,,0,0,0,,...ama Adalet Kapıları'nın bir kez\Ndaha açıldığı ve bilinmeyen...
Dialogue: 0,0:14:25.10,0:14:27.85,Main,,0,0,0,,...bir geminin geçtiği haberini aldık!
Dialogue: 0,0:14:28.52,0:14:31.14,Main,,0,0,0,,Gemide bu insanlar mı vardı?
Dialogue: 0,0:14:31.14,0:14:34.06,Main,,0,0,0,,Ama Kontrol Odası'nda Denizciler'den\Nbaşka kimsenin olmaması gerekirdi.
Dialogue: 0,0:14:34.06,0:14:37.02,Main,,0,0,0,,Üstelik sıradışı bir durum da bildirilmedi!
Dialogue: 0,0:14:37.02,0:14:40.02,Main,,0,0,0,,Buraya nasıl geldiler?
Dialogue: 0,0:14:41.80,0:14:43.36,Main,,0,0,0,,Özür dilerim.
Dialogue: 0,0:14:44.66,0:14:46.77,Main,,0,0,0,,Çok basit.
Dialogue: 0,0:14:47.12,0:14:52.14,Main,,0,0,0,,Karasakal Korsanları Impel Down'a\Ngitmek için yola çıkmadan önce...
Dialogue: 0,0:14:52.14,0:14:56.64,Main,,0,0,0,,...Kontrol Odası'ndaki\NDenizcileri hipnotize ettim.
Dialogue: 0,0:14:57.10,0:14:59.48,Main,,0,0,0,,Onlara, Adalet Kapısı'na\Nyaklaşan tüm savaş gemilerinin...
Dialogue: 0,0:14:59.48,0:15:01.25,Main,,0,0,0,,...geçmesine izin vermelerini emrettim.
Dialogue: 0,0:15:02.10,0:15:05.92,Main,,0,0,0,,Galiba bunun başkalarına da faydası olmuş.
Dialogue: 0,0:15:06.26,0:15:09.86,Main,,0,0,0,,Hükümet düşmanı bir korsanın...
Dialogue: 0,0:15:09.86,0:15:14.19,Main,,0,0,0,,...Adalet Kapıları açılmayacağı için\Niçeri girmesi imkânsız olurdu.
Dialogue: 0,0:15:14.68,0:15:18.94,Main,,0,0,0,,Bu yüzden itibarımı artırıp\NYedi Savaş Lordu'ndan biri oldum!
Dialogue: 0,0:15:18.94,0:15:21.53,Main,,0,0,0,,Ama artık bu rütbeye ihtiyacım yok!
Dialogue: 0,0:15:23.94,0:15:27.37,Main,,0,0,0,,Yani amacın onları serbest bırakmak mıydı?
Dialogue: 0,0:15:29.58,0:15:32.01,Main,,0,0,0,,Kesinlikle! Başından beri planım buydu!
Dialogue: 0,0:15:32.01,0:15:34.78,Main,,0,0,0,,Tüm istediğim buydu!
Dialogue: 0,0:15:34.78,0:15:37.75,Main,,0,0,0,,Şimdi anlıyor musun?
Dialogue: 0,0:15:50.03,0:15:53.15,Main,,0,0,0,,Hiçbirinin önemi yok!
Dialogue: 0,0:15:57.70,0:16:00.37,Main,,0,0,0,,Teach!
Dialogue: 0,0:16:06.18,0:16:08.05,Main,,0,0,0,,Dikkat et, Kaptan!
Dialogue: 0,0:16:28.58,0:16:30.60,Main,,0,0,0,,Gerçekten yakındı!
Dialogue: 0,0:16:30.60,0:16:33.17,Main,,0,0,0,,Ucu ucuna kurtulduk.
Dialogue: 0,0:16:45.46,0:16:47.86,Main,,0,0,0,,Hiç çekinmiyorsun!
Dialogue: 0,0:16:47.86,0:16:49.52,Main,,0,0,0,,Ama sanırım bu beklenen bir şey.
Dialogue: 0,0:16:51.32,0:16:57.45,Main,,0,0,0,,Asla oğlum demeyeceğim tek kişisin, Teach.
Dialogue: 0,0:16:59.78,0:17:06.02,Main,,0,0,0,,Gemimde demir kuralı bozdun.
Dialogue: 0,0:17:06.02,0:17:08.84,Main,,0,0,0,,Tayfadan birini öldürdün!
Dialogue: 0,0:17:09.26,0:17:12.61,Main,,0,0,0,,Dördüncü Bölüm Kumandanı Thatch'ın\Nhuzur içinde yatması için,...
Dialogue: 0,0:17:13.02,0:17:18.58,Main,,0,0,0,,...bu ahmağın canını alıp hesabı kapatacağım!
Dialogue: 0,0:17:20.66,0:17:21.84,Main,,0,0,0,,Babalık!
Dialogue: 0,0:17:23.40,0:17:26.40,Main,,0,0,0,,Marco!
Dialogue: 0,0:17:27.94,0:17:29.09,Main,,0,0,0,,Babalık!
Dialogue: 0,0:17:33.60,0:17:36.80,Main,,0,0,0,,Buna karışma!
Dialogue: 0,0:17:36.80,0:17:38.40,Main,,0,0,0,,Babalık!
Dialogue: 0,0:17:38.94,0:17:40.80,Main,,0,0,0,,Anlaşıldı mı?!
Dialogue: 0,0:17:45.12,0:17:48.68,Main,,0,0,0,,Bu işi bitirelim, Teach!
Dialogue: 0,0:17:50.98,0:17:53.32,Main,,0,0,0,,Bana uyar!
Dialogue: 0,0:18:03.63,0:18:06.97,Main,,0,0,0,,Bedeninden çıkan siyah şey de ne?
Dialogue: 0,0:18:08.10,0:18:09.03,Main,,0,0,0,,Duman mı?
Dialogue: 0,0:18:25.24,0:18:27.14,Main,,0,0,0,,{\fad(150,150)}Kara Delik!
Dialogue: 0,0:18:37.48,0:18:42.93,Main,,0,0,0,,Bu, Thatch'i öldürdükten sonra\Nçaldığım Şeytan Meyvesi'nin gücü!
Dialogue: 0,0:18:42.93,0:18:47.18,Main,,0,0,0,,En büyük güç, Yami Yami Meyvesi!
Dialogue: 0,0:18:42.93,0:18:47.18,Note,,0,0,0,,Yami: Karanlık
Dialogue: 0,0:18:47.18,0:18:50.94,Main,,0,0,0,,Tadına bak!
Dialogue: 0,0:18:53.01,0:18:58.65,Main,,0,0,0,,Hey, Babalık. Thatch öldü, Ace de öyle.
Dialogue: 0,0:18:59.44,0:19:04.00,Main,,0,0,0,,Kalbimin derinliklerinden sana hep\Nsaygı duydum ve hayran oldum.
Dialogue: 0,0:19:04.00,0:19:05.96,Main,,0,0,0,,Ama artık yaşlandın.
Dialogue: 0,0:19:05.96,0:19:10.19,Main,,0,0,0,,O kadar paslanmışsın ki, tek bir\Nadamını bile idamdan kurtaramadın.
Dialogue: 0,0:19:10.62,0:19:15.70,Main,,0,0,0,,Hem de Banaro Adası'ndaki dövüşün\Nardından yaşamasına izin vermeme rağmen.
Dialogue: 0,0:19:18.26,0:19:19.94,Main,,0,0,0,,Pislik!
Dialogue: 0,0:19:20.77,0:19:23.91,Main,,0,0,0,,Hey, hey. Bu işe yaramayacak.
Dialogue: 0,0:19:24.06,0:19:28.05,Main,,0,0,0,,Tüm Şeytan Meyvesi yetenekleri\Nkarşımda işe yaramaz hâle gelir!
Dialogue: 0,0:19:35.26,0:19:37.32,Main,,0,0,0,,Kara Girdap!{\fad(150,150)}
Dialogue: 0,0:19:43.04,0:19:46.20,Main,,0,0,0,,Evet, Babalık? Karanlığım\Nhakkında ne düşünüyorsun?
Dialogue: 0,0:19:46.20,0:19:51.54,Main,,0,0,0,,Kullanıcısını savunmasız hâle getirecek\Nşekilde Şeytan Meyvesi güçlerini bile emebilir!
Dialogue: 0,0:19:52.27,0:19:55.61,Main,,0,0,0,,Yani artık başka deprem yapamazsın!
Dialogue: 0,0:20:06.36,0:20:07.72,Main,,0,0,0,,Acıdı...
Dialogue: 0,0:20:07.72,0:20:09.49,Main,,0,0,0,,Acıyor, lanet olsun!
Dialogue: 0,0:20:12.99,0:20:15.62,Main,,0,0,0,,Kendine aşırı güven, dikkatsizlik.
Dialogue: 0,0:20:15.62,0:20:17.74,Main,,0,0,0,,Bunlar senin en büyük zayıflığın!
Dialogue: 0,0:20:22.04,0:20:23.77,Main,,0,0,0,,K-Kes şunu!
Dialogue: 0,0:20:24.34,0:20:28.11,Main,,0,0,0,,Babalık, kes şunu! Ben senin evladınım, değil mi?
Dialogue: 0,0:20:28.74,0:20:30.51,Main,,0,0,0,,Beni gerçekten öldürecek misin?!
Dialogue: 0,0:20:49.23,0:20:51.90,Main,,0,0,0,,Başardın, Babalık!
Dialogue: 0,0:20:54.70,0:20:56.80,Main,,0,0,0,,Hayır, şuna bakın!
Dialogue: 0,0:21:26.88,0:21:30.06,Main,,0,0,0,,C-Canavar!
Dialogue: 0,0:21:33.87,0:21:35.81,Main,,0,0,0,,Ölmüş olmalıydın!
Dialogue: 0,0:21:37.24,0:21:40.71,Main,,0,0,0,,Ölemez misin artık?!
Dialogue: 0,0:21:48.48,0:21:50.49,Main,,0,0,0,,Babalık!
Dialogue: 0,0:21:53.72,0:21:58.26,Main,,0,0,0,,Öldürün onu!
Dialogue: 0,0:22:22.60,0:22:25.59,Main,,0,0,0,,Hadi! Onu kevgire çevirin!
Dialogue: 0,0:22:32.00,0:22:36.70,Main,,0,0,0,,Babalık!
Dialogue: 0,0:22:43.50,0:22:47.04,Flashbacks,,0,0,0,,Ölüyorum mu diyorsun, Roger?
Dialogue: 0,0:22:47.04,0:22:50.75,Main,,0,0,0,,Evet. Fazla vaktim kalmadı.
Dialogue: 0,0:22:53.15,0:22:58.44,Main,,0,0,0,,Sana Raftel'e nasıl ulaşacağını\Nsöyleyeyim mi, Beyazsakal?
Dialogue: 0,0:22:58.44,0:23:02.19,Main,,0,0,0,,Söyleseydin bile gitmezdim. İlgilenmiyorum.
Dialogue: 0,0:23:05.88,0:23:11.20,Main,,0,0,0,,Hükümet'in bugünlerde bana\Nne dediğini biliyor musun?
Dialogue: 0,0:23:12.70,0:23:14.81,Main,,0,0,0,,"Gold Roger."
Dialogue: 0,0:23:15.92,0:23:19.81,Main,,0,0,0,,Ne? Gerçek ismin bu mu?
Dialogue: 0,0:23:19.81,0:23:22.30,Main,,0,0,0,,Hayır, değil.
Dialogue: 0,0:23:22.30,0:23:26.02,Main,,0,0,0,,Adım Gol D. Roger.
Dialogue: 0,0:23:26.02,0:23:29.92,Main,,0,0,0,,Ben de adında "D" olan\Nbazı insanlarla karşılaştım.
Dialogue: 0,0:23:34.98,0:23:37.96,Main,,0,0,0,,Tayfamda da bir tane var. Adı Teach.
Dialogue: 0,0:23:39.10,0:23:41.73,Main,,0,0,0,,Bu "D" neyin nesi ki?
Dialogue: 0,0:23:45.14,0:23:46.50,Main,,0,0,0,,Bilmek mi istiyorsun?
Dialogue: 0,0:23:50.38,0:23:52.88,Main,,0,0,0,,Tamam, sana anlatacağım.
Dialogue: 0,0:23:55.98,0:23:58.50,Main,,0,0,0,,Uzun zaman öncesinden bir hikaye.
Dialogue: 0,0:24:05.62,0:24:08.69,Main,,0,0,0,,Mermim bitti. Hey, bana başka bir silah verin!
Dialogue: 0,0:24:08.69,0:24:11.20,Main,,0,0,0,,Sen değilsin.
Dialogue: 0,0:24:11.20,0:24:13.93,Main,,0,0,0,,Hala hayatta mısın?!
Dialogue: 0,0:24:17.04,0:24:20.70,Main,,0,0,0,,Roger'ın beklediği adam...
Dialogue: 0,0:24:20.70,0:24:23.48,Main,,0,0,0,,...en azından kesinlikle...
Dialogue: 0,0:24:23.48,0:24:25.88,Main,,0,0,0,,...sen değilsin, Teach.
Dialogue: 0,0:24:27.36,0:24:31.45,Main,,0,0,0,,Aynı Roger'ın isteğini\Nsürdürenler olduğu gibi,...
Dialogue: 0,0:24:32.40,0:24:38.64,Main,,0,0,0,,...bir gün Ace'in isteğini de sürdürmek\Niçin birinin ortaya çıkacağından eminim.
Dialogue: 0,0:24:38.64,0:24:44.90,Main,,0,0,0,,Onun soyunu kurutsan bile,\Nalevlerinin sönmesi mümkün değil.
Dialogue: 0,0:24:44.90,0:24:51.33,Main,,0,0,0,,Eski zamanlardan beri nesilden nesile aktarıldı.
Dialogue: 0,0:24:53.14,0:24:57.38,Main,,0,0,0,,Gelecekte... bir gün,...
Dialogue: 0,0:24:57.38,0:25:02.52,Main,,0,0,0,,...onlarca yılın tarihini sırtında\Ntaşıyan biri ortaya çıkacak...
Dialogue: 0,0:25:02.52,0:25:08.00,Main,,0,0,0,,...ve dövüşmek için tüm dünyaya meydan okuyacak.
Dialogue: 0,0:25:09.06,0:25:11.24,Main,,0,0,0,,Sengoku...
Dialogue: 0,0:25:11.24,0:25:14.76,Main,,0,0,0,,Siz Dünya Hükümeti'ndekiler,...
Dialogue: 0,0:25:14.76,0:25:24.74,Main,,0,0,0,,...er ya da geç gelip tüm dünyayı yutacak olan o muazzam savaştan korkuyorsunuz.
Dialogue: 0,0:25:26.94,0:25:29.30,Main,,0,0,0,,Ben önemsemiyorum,...
Dialogue: 0,0:25:30.46,0:25:34.28,Main,,0,0,0,,...ama biri o büyük hazineyi bulur bulmaz...
Dialogue: 0,0:25:34.84,0:25:38.18,Main,,0,0,0,,...tüm dünya alaşağı olacak...
Dialogue: 0,0:25:38.88,0:25:41.52,Main,,0,0,0,,...ve biri onu bulacak.
Dialogue: 0,0:25:42.90,0:25:46.46,Main,,0,0,0,,O gün er ya da geç gelecek.
Dialogue: 0,0:25:54.77,0:25:57.47,Main,,0,0,0,,One Piece...
Dialogue: 0,0:25:58.74,0:26:01.47,Main,,0,0,0,,...gerçekten var!
Dialogue: 0,0:26:11.52,0:26:13.38,Main,,0,0,0,,Lanet olası!
Dialogue: 0,0:26:18.46,0:26:20.66,Main,,0,0,0,,Bunlar harikulâde son sözler!
Dialogue: 0,0:26:22.42,0:26:26.50,Thoughts,,0,0,0,,{\i1}Beni affedin evlatlarım.{\i0}
Dialogue: 0,0:26:27.26,0:26:32.94,Thoughts,,0,0,0,,{\i1}Bu berbat ahmaktan ben sorumluyum.{\i0}
Dialogue: 0,0:26:32.94,0:26:38.14,Thoughts,,0,0,0,,{\i1}Ama sayenizde istediğim her şeyi elde ettim.{\i0}
Dialogue: 0,0:26:40.92,0:26:44.58,Thoughts,,0,0,0,,{\i1}Sonum geldi.{\i0}
Dialogue: 0,0:26:50.50,0:26:55.13,Flashbacks,,0,0,0,,{\i1}Çok uzun zamandır yolculuk ediyorum.{\i0}
Dialogue: 0,0:26:55.13,0:26:58.08,Main,,0,0,0,,O zaman ne istiyorsun?
Dialogue: 0,0:26:59.86,0:27:01.70,Main,,0,0,0,,Hey, Newgate!
Dialogue: 0,0:27:03.40,0:27:08.17,Main,,0,0,0,,Çocukluğumdan beri istediğim tek bir şey var.
Dialogue: 0,0:27:08.17,0:27:10.69,Main,,0,0,0,,Oh, var mı?
Dialogue: 0,0:27:10.69,0:27:11.91,Main,,0,0,0,,Söyle o zaman!
Dialogue: 0,0:27:20.24,0:27:22.36,Main,,0,0,0,,Aile.
Dialogue: 0,0:27:23.69,0:27:27.36,Main,,0,0,0,,Aile mi? Bu ne demek oluyor?
Dialogue: 0,0:27:29.88,0:27:32.20,Thoughts,,0,0,0,,{\i1}Size minnettarım.{\i0}
Dialogue: 0,0:27:33.40,0:27:37.78,Thoughts,,0,0,0,,{\i1}Elveda evlatlarım.{\i0}
Dialogue: 0,0:27:56.82,0:28:00.97,Main,,0,0,0,,A-Ayaktayken...
Dialogue: 0,0:28:00.97,0:28:02.66,Main,,0,0,0,,...öldü!
Dialogue: 0,0:28:04.16,0:28:08.13,Narrator,,0,0,0,,{\i1}Beyazsakal öldü.{\i0}
Dialogue: 0,0:28:24.16,0:28:29.32,Narrator,,0,0,0,,{\i1}Ölünce bile bedeni yere düşmedi.{\i0}
Dialogue: 0,0:28:29.32,0:28:33.64,Narrator,,0,0,0,,{\i1}Yaralarla kaplıyken düşmanlarını deviren endamı...{\i0}
Dialogue: 0,0:28:33.64,0:28:35.96,Narrator,,0,0,0,,{\i1}...gerçekten korkutucuydu.{\i0}
Dialogue: 0,0:28:42.88,0:28:45.66,Narrator,,0,0,0,,{\i1}Bu savaşta toplam...{\i0}
Dialogue: 0,0:28:45.66,0:28:49.68,Narrator,,0,0,0,,{\i1}...267 kılıç yarası aldı.{\i0}
Dialogue: 0,0:28:49.68,0:28:54.04,Narrator,,0,0,0,,{\i1}Vücuduna 152 mermi isabet etti.{\i0}
Dialogue: 0,0:28:54.04,0:28:57.45,Narrator,,0,0,0,,{\i1}46 top mermisi tarafından vuruldu.{\i0}
Dialogue: 0,0:29:00.10,0:29:01.92,Narrator,,0,0,0,,{\i1}Tüm bunlara rağmen...{\i0}
Dialogue: 0,0:29:02.55,0:29:05.66,Narrator,,0,0,0,,{\i1}...gururlu sırtı,...{\i0}
Dialogue: 0,0:29:06.66,0:29:11.16,Narrator,,0,0,0,,{\i1}...korsan olarak sürdüğü tüm hayatı boyunca...{\i0}
Dialogue: 0,0:29:11.16,0:29:15.74,Narrator,,0,0,0,,{\i1}...kaçmaktan dolayı tek bir yara bile almadı!{\i0}
Dialogue: 0,0:29:27.29,0:29:38.94,Title,,0,0,220,,{\fad(1600,2800)}Kinryu Arimoto'nun anısına
Dialogue: 0,0:00:25.37,0:00:30.41,OP13-Credits,,0,0,0,,{\fad(600,200)}Editing\N{\fs34}Sewil
Dialogue: 0,0:00:30.41,0:00:36.22,OP13-Credits,,0,0,0,,{\fad(600,200)}Quality Control\N{\fs34}Pepperjack
Dialogue: 0,0:00:36.22,0:00:41.19,OP13-Credits,,0,0,0,,{\fad(600,200)}Timing\N{\fs34}Sewil\NHalee
Dialogue: 0,0:00:41.19,0:00:46.93,OP13-Credits,,0,0,0,,{\fad(600,200)}Translation\N{\fs34}Yibis\NGaijin
Dialogue: 0,0:00:46.93,0:00:52.36,OP13-Credits,,0,0,0,,{\fad(600,200)}Visual Effects\N{\fs34}Datenshi\NKaitouYahiko
Dialogue: 0,0:00:52.36,0:00:57.44,OP13-Credits,,0,0,0,,{\fad(600,200)}Graphics\N{\fs34}Datenshi
Dialogue: 0,0:00:57.44,0:01:03.08,OP13-Credits,,0,0,0,,{\fad(600,200)}Karaoke\N{\fs34}KaitouYahiko
