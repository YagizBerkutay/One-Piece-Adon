,0,8,10,10,80,1Style: Translation-furigana,Duality,30,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,1.5,0,2,10,10,10,1Style: Karaoke-furigana,Duality,30,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,1.5,0,8,10,10,10,1Style: Default-furigana,Arial,10,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1,1,2,10,10,10,1Style: Karaoke,Duality,45.0,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,2,10,10,18,1Style: Translation,Duality,60,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,2,10,10,10,1Style: Kanji,Duality,60,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,8,10,10,110,1Style: Author,Impress BT,25,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1,1,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:20.66,0:00:25.71,Main,,0,0,0,,Beyazsakal'ın İkinci Bölümüne bağlı biz korsanlar, Kumandan Ace'i kurtaracağız!Dialogue: 0,0:00:25.71,0:00:26.90,Main,,0,0,0,,Evet!Dialogue: 0,0:00:26.90,0:00:28.47,Main,,0,0,0,,Kesin şunu!Dialogue: 0,0:00:29.50,0:00:33.24,Main,,0,0,0,,Niye benim için bunu yapıyorsunuz?!Dialogue: 0,0:00:34.76,0:00:38.34,Flashbacks,,0,0,0,,Ben senin kardeşinim!Dialogue: 0,0:00:41.55,0:00:44.30,Main,,0,0,0,,Çok aptalsın, Luffy.Dialogue: 0,0:00:44.30,0:00:46.43,Main,,0,0,0,,Sen de Babalık!Dialogue: 0,0:00:47.43,0:00:49.59,Flashbacks,,0,0,0,,Oğlum ol!Dialogue: 0,0:01:04.94,0:01:06.33,Main,,0,0,0,,Ne oldu?Dialogue: 0,0:01:09.34,0:01:10.43,Main,,0,0,0,,Ben...Dialogue: 0,0:01:12.45,0:01:15.65,Main,,0,0,0,,...geleceğin getireceği şeyleri kabul etmeye hazırım.Dialogue: 0,0:01:16.50,0:01:19.06,Main,,0,0,0,,Beni kurtarmak için uzanan eli tutacağım.Dialogue: 0,0:01:22.22,0:01:24.40,Main,,0,0,0,,Ya da beni cezalandıran kılıca boyun eğeceğim.Dialogue: 0,0:01:29.95,0:01:31.39,Main,,0,0,0,,Artık...Dialogue: 0,0:01:31.39,0:01:33.74,Main,,0,0,0,,...mücadeleye son verdim.Dialogue: 0,0:01:38.46,0:01:40.21,Main,,0,0,0,,Üzgünüm arkadaşlar.Dialogue: 0,0:04:16.47,0:04:19.20,Main,,0,0,0,,Saldırıyı yeniden başlatın!Dialogue: 0,0:04:19.20,0:04:20.47,Main,,0,0,0,,Ateş!Dialogue: 0,0:04:32.25,0:04:34.86,Title,,0,0,530,,Impel Down MahkûmlarıDialogue: 0,0:04:35.11,0:04:39.37,Main,,0,0,0,,Nasılsa hep dikkatin merkezinde!Dialogue: 0,0:04:39.37,0:04:41.59,Main,,0,0,0,,Hasır Şapka!Dialogue: 0,0:04:41.59,0:04:45.97,Main,,0,0,0,,Kaptan Buggy! Bizi gölgede bırakmasına izin veremeyiz!Dialogue: 0,0:04:45.97,0:04:48.73,Main,,0,0,0,,Beyazsakal'ın kafasını koparalım artık!Dialogue: 0,0:04:48.73,0:04:51.48,Main,,0,0,0,,Tamam arkadaşlarım! Hadi yapalım!Dialogue: 0,0:04:54.81,0:04:58.23,Main,,0,0,0,,Ama çılgınlığın diz boyu olduğu bu savaş alanı da neyin nesi?Dialogue: 0,0:04:58.23,0:05:01.41,Main,,0,0,0,,Buradaki denizcilerin ve korsanların hepsi dünya çapında meşhur!Dialogue: 0,0:05:01.41,0:05:04.31,Main,,0,0,0,,Burada saklansaydım iyi olurdu.Dialogue: 0,0:05:04.31,0:05:06.87,Main,,0,0,0,,Hey, Kırmızı Burun!Dialogue: 0,0:05:06.87,0:05:09.26,Main,,0,0,0,,Sen kime Kırmızı Burun diyorsun, seni pislik?!Dialogue: 0,0:05:09.26,0:05:11.77,Main,,0,0,0,,Ölmek falan mı istiyorsun?!Dialogue: 0,0:05:16.06,0:05:18.53,Main,,0,0,0,,Beyazsakal?!Dialogue: 0,0:05:18.53,0:05:20.88,Main,,0,0,0,,Seni daha önce bir yerde gördüğümü düşünüyorum.Dialogue: 0,0:05:20.88,0:05:23.70,Main,,0,0,0,,Sen Roger'ın gemisindeki şu veletsin, değil mi?Dialogue: 0,0:05:23.97,0:05:27.57,Main,,0,0,0,,Anılarım canlandı... Demek hala hayattasın?Dialogue: 0,0:05:27.57,0:05:31.11,Main,,0,0,0,,Eyvah! Beni tespit etti. Öleceğim!Dialogue: 0,0:05:31.11,0:05:34.55,Main,,0,0,0,,İşimiz bitti! Kaçmaktan başka çaremiz yok!Dialogue: 0,0:05:34.55,0:05:38.18,Main,,0,0,0,,B-Beyazsakal! Büyük Beyazsakal...Dialogue: 0,0:05:38.18,0:05:40.54,Main,,0,0,0,,...kaptanla konuştu! Müthiş!Dialogue: 0,0:05:40.54,0:05:43.76,Main,,0,0,0,,Sen gerçekten efsanevi bir korsansın!Dialogue: 0,0:05:44.43,0:05:46.95,Main,,0,0,0,,O kadar etkilenmiş gibi davranmayın!Dialogue: 0,0:05:46.95,0:05:49.56,Main,,0,0,0,,Benimle aynı sona uğrayacaksınız!Dialogue: 0,0:05:49.56,0:05:52.75,Main,,0,0,0,,Getirdiğin onca mahkuma bakılırsa...Dialogue: 0,0:05:53.27,0:05:56.30,Main,,0,0,0,,...sanırım başımı almaya geldin.Dialogue: 0,0:05:56.30,0:06:00.23,Main,,0,0,0,,Tabii! Görüşmeyeli uzun zaman oldu, ha? Hazırla kendini!Dialogue: 0,0:06:02.67,0:06:06.54,Main,,0,0,0,,Bunu ileri götürmenin de bir sınırı var!Dialogue: 0,0:06:06.54,0:06:13.52,Main,,0,0,0,,Gerçekten mi? Başımı alman umrumda değil, ama sonrasında ne yapacaksın?Dialogue: 0,0:06:13.52,0:06:17.52,Main,,0,0,0,,Denizci güçleri senin baş edebileceğinden çok daha büyük.Dialogue: 0,0:06:17.52,0:06:21.70,Main,,0,0,0,,Aslında benim için de biraz fazlalar. Fazlasıyla meşgulüm.Dialogue: 0,0:06:21.70,0:06:27.00,Main,,0,0,0,,Peki bana katılıp, Denizciler'in işini müttefik korsanlar olarak bitirmek ister misin?Dialogue: 0,0:06:27.00,0:06:30.47,Main,,0,0,0,,Ondan sonra başımı alabilirsin.Dialogue: 0,0:06:30.47,0:06:36.51,Main,,0,0,0,,Dur biraz! Beyazsakal'ın sana ne kadar saygısı var?Dialogue: 0,0:06:36.51,0:06:38.08,Main,,0,0,0,,Sanki eşit gibiler!Dialogue: 0,0:06:38.08,0:06:41.35,Main,,0,0,0,,Kendisine denk birine velet diye hitap edeceğini sanmıyorum.Dialogue: 0,0:06:41.35,0:06:45.55,Main,,0,0,0,,Denizcilerle dövüşmen pervasızlık! Gerçekten kazanabileceğimizi düşünüyor musun?!Dialogue: 0,0:06:45.55,0:06:49.55,Main,,0,0,0,,Şey, ciddileşirsem, evet...Dialogue: 0,0:06:50.87,0:06:53.36,Main,,0,0,0,,Bunun sağduyusuna ne olmuş?Dialogue: 0,0:06:53.36,0:06:54.76,Main,,0,0,0,,Cidden mi?Dialogue: 0,0:06:54.76,0:06:56.33,Main,,0,0,0,,Ooh, tüylerim ürperiyor!Dialogue: 0,0:06:56.33,0:06:58.40,Main,,0,0,0,,Bunu yapabilirmişim gibi hissetmeye başlıyorum!Dialogue: 0,0:06:58.40,0:06:59.15,Main,,0,0,0,,Yapabilirim!Dialogue: 0,0:06:59.15,0:07:02.87,Main,,0,0,0,,Şimdi görebiliyorum! Buggy, dünyanın kralı!Dialogue: 0,0:07:04.62,0:07:08.54,Main,,0,0,0,,İkimiz güç birliği edersek, Denizcileri ezebiliriz.Dialogue: 0,0:07:10.29,0:07:13.13,Main,,0,0,0,,Lütfen kes şunu! Çok harikasın! Aşırı harika!Dialogue: 0,0:07:13.13,0:07:15.97,Main,,0,0,0,,Tamam, Beyazsakal! Sana destek olacağız!Dialogue: 0,0:07:15.97,0:07:18.27,Main,,0,0,0,,Ben sana destek olacağım!Dialogue: 0,0:07:18.27,0:07:20.71,Main,,0,0,0,,O kim?!Dialogue: 0,0:07:20.71,0:07:23.72,Main,,0,0,0,,Evet! Kaptanımız Buggy!Dialogue: 0,0:07:23.72,0:07:27.66,Main,,0,0,0,,Bu adamların ne kadar yarım akıllı olduklarına inanamıyorum.Dialogue: 0,0:07:27.66,0:07:33.25,Main,,0,0,0,,Kırmızı Burun'u saymazsak, ardındakiler epey güçlü.Dialogue: 0,0:07:33.25,0:07:35.60,Main,,0,0,0,,Onlarla dövüşmek zorunda kalmak can sıkıcı olurdu.Dialogue: 0,0:07:39.03,0:07:41.59,Main,,0,0,0,,Pekâlâ...Dialogue: 0,0:07:50.18,0:07:51.75,Main,,0,0,0,,Ben Beyazsakal.Dialogue: 0,0:07:52.08,0:07:53.72,Main,,0,0,0,,Squardo orada mı?Dialogue: 0,0:07:53.72,0:07:56.46,Main,,0,0,0,,Babalık! Kaptan Squardo...Dialogue: 0,0:07:56.46,0:08:00.75,Main,,0,0,0,,Ha? Biraz önce buradaydı.Dialogue: 0,0:08:00.75,0:08:01.93,Main,,0,0,0,,Galiba onu gözden kaybettik.Dialogue: 0,0:08:02.55,0:08:07.74,Main,,0,0,0,,Seni etkilemeye çalışırken kendini kaptırmıştır, Babalık.Dialogue: 0,0:08:07.74,0:08:12.26,Main,,0,0,0,,Çok yazık. O zaman, DeCalvan Kardeşler!Dialogue: 0,0:08:12.60,0:08:14.36,Main,,0,0,0,,Ne oldu, Babalık?Dialogue: 0,0:08:14.36,0:08:15.77,Main,,0,0,0,,Babalık, ne yapalım?Dialogue: 0,0:08:15.77,0:08:20.14,Main,,0,0,0,,Tüm korsan tayfalarının liderliğini üstlenin ve emirlerimi onlara iletin!Dialogue: 0,0:08:21.51,0:08:26.56,Main,,0,0,0,,Ne? Ama Babalık, tam koya girmeye hazırlanıyorduk.Dialogue: 0,0:08:26.95,0:08:29.33,Main,,0,0,0,,Vaz mı geçiyoruz?Dialogue: 0,0:08:29.33,0:08:31.04,Main,,0,0,0,,Tamam. Anlaşıldı.Dialogue: 0,0:08:31.55,0:08:34.18,Main,,0,0,0,,Biz sağa gideceğiz.Dialogue: 0,0:08:34.18,0:08:36.73,Main,,0,0,0,,Babalık böyle diyorsa...Dialogue: 0,0:08:37.06,0:08:40.20,Main,,0,0,0,,Gemim istediğin yere gidecek.Dialogue: 0,0:08:40.66,0:08:44.50,Main,,0,0,0,,Squardo? Onu hiçbir yerde görmüyorum... Bu doğru mu?Dialogue: 0,0:08:45.62,0:08:48.17,Main,,0,0,0,,Ben sola gideceğim.Dialogue: 0,0:08:50.02,0:08:54.52,Main,,0,0,0,,Filo Amirali Sengoku! Yeni Dünya korsanları saldırı şekillerini değiştiriyor!Dialogue: 0,0:08:54.52,0:08:57.35,Main,,0,0,0,,Evet, her yöne dağıldılar.Dialogue: 0,0:08:57.73,0:09:00.79,Main,,0,0,0,,Savaş gemilerine saldırmaya başladılar!Dialogue: 0,0:09:15.60,0:09:19.22,Main,,0,0,0,,İyi oynadın, Beyazsakal! Gelişini gördü.Dialogue: 0,0:09:20.00,0:09:22.74,Main,,0,0,0,,Belli ki bu kadar belirgin bir numaraya kanmıyor.Dialogue: 0,0:09:22.74,0:09:24.98,Main,,0,0,0,,Sanırım çok üstünkörü oldu.Dialogue: 0,0:09:25.42,0:09:29.95,Main,,0,0,0,,Ama keskin sezi kaderi durdurmaya yetmeyecek!Dialogue: 0,0:09:34.04,0:09:38.26,Main,,0,0,0,,Şaka olmalı. Moria, Denizin Şövalyesi Jinbei'ye karşı mı?!Dialogue: 0,0:09:38.52,0:09:41.43,Main,,0,0,0,,Denizin Yedi Savaş Lordu, savunmamızın can damarı!Dialogue: 0,0:09:41.43,0:09:43.64,Main,,0,0,0,,Birbirlerini öldürmelerinin ne yararı var?!Dialogue: 0,0:09:43.64,0:09:48.17,Main,,0,0,0,,Senin denginin çok üstündeyim, Moria!Dialogue: 0,0:09:48.17,0:09:51.33,Main,,0,0,0,,Benimle dövüşmek mi istiyorsun, Jinbei?Dialogue: 0,0:09:52.11,0:09:57.04,Main,,0,0,0,,Tamam! Sonuçta sen varken Zombi Savaşçılarımı kullanamam!Dialogue: 0,0:09:57.04,0:10:00.75,Main,,0,0,0,,Devam et, Luffy-kun! Daha fazla vakit kaybetme!Dialogue: 0,0:10:00.95,0:10:02.68,Main,,0,0,0,,Sağol, Jinbei!Dialogue: 0,0:10:03.18,0:10:04.65,Main,,0,0,0,,Gölgelerimiz tuhaf davranıyor.Dialogue: 0,0:10:08.18,0:10:13.42,Main,,0,0,0,,Denizci gölgeleri, bana gücünüzü verin!Dialogue: 0,0:10:28.47,0:10:32.31,Main,,0,0,0,,Şimdi gölgeni alacağım!Dialogue: 0,0:10:34.99,0:10:39.48,Main,,0,0,0,,Denizin dibindeki karanlıklar içinde sonsuzluğu yaşayacaksın, Jinbei!Dialogue: 0,0:10:41.49,0:10:44.56,Main,,0,0,0,,Gölgeni ver!Dialogue: 0,0:11:18.52,0:11:22.68,Main,,0,0,0,,O kadar uğraştın ama gölgelerin seni terketti.Dialogue: 0,0:11:22.68,0:11:24.73,Main,,0,0,0,,Yeterince yetenekli değilsin.Dialogue: 0,0:11:25.10,0:11:28.16,Main,,0,0,0,,Şimdi kenara çekil, Moria.Dialogue: 0,0:11:28.16,0:11:30.13,Main,,0,0,0,,Acelem var.Dialogue: 0,0:11:30.13,0:11:33.60,Main,,0,0,0,,Dur bakalım lanet olası! Dövüş bitmedi!Dialogue: 0,0:11:46.15,0:11:47.41,Main,,0,0,0,,Bu Hasır Şapka!Dialogue: 0,0:11:51.73,0:11:52.85,Main,,0,0,0,,Yoldan çekil, Tashigi!Dialogue: 0,0:11:59.47,0:12:01.67,Main,,0,0,0,,Acıdı! Sen...Dialogue: 0,0:12:01.67,0:12:02.94,Main,,0,0,0,,Dumanlı!Dialogue: 0,0:12:03.47,0:12:08.03,Main,,0,0,0,,Evet! Juttesinde Deniz Taşı var!Dialogue: 0,0:12:08.03,0:12:09.10,Main,,0,0,0,,Lanet olası...Dialogue: 0,0:12:12.44,0:12:15.51,Main,,0,0,0,,İşini bitireceğim!Dialogue: 0,0:12:25.62,0:12:27.66,Main,,0,0,0,,Öncekinden çok daha güçlü!Dialogue: 0,0:12:27.66,0:12:29.46,Main,,0,0,0,,Hasır Şapka!Dialogue: 0,0:12:31.01,0:12:32.16,Main,,0,0,0,,Yok oldu!Dialogue: 0,0:12:32.16,0:12:34.30,Main,,0,0,0,,Çok hızlı! Nereye gitti!Dialogue: 0,0:12:48.07,0:12:52.18,Main,,0,0,0,,Görünüşe göre son karşılaşmamızdan bu yana ikimiz de güçlenmişiz.Dialogue: 0,0:13:01.02,0:13:04.74,Main,,0,0,0,,Yeteneğinle beni yenemezsin.Dialogue: 0,0:13:04.74,0:13:07.87,Main,,0,0,0,,Kahretsin, şu... jutte...Dialogue: 0,0:13:07.87,0:13:10.85,Main,,0,0,0,,Loguetown'da Dragon'un...Dialogue: 0,0:13:12.41,0:13:14.50,Main,,0,0,0,,...neden seni kurtardığını...Dialogue: 0,0:13:14.50,0:13:17.44,Main,,0,0,0,,...nihayet anlıyorum, Hasır Şapka.Dialogue: 0,0:13:19.08,0:13:23.55,Main,,0,0,0,,O zaman Dragon bana engel olmuştu, ama bu kez hiçbir yere kaçamazsın!Dialogue: 0,0:13:23.55,0:13:25.65,Main,,0,0,0,,K-Kahretsin...Dialogue: 0,0:13:25.65,0:13:27.96,Main,,0,0,0,,Pis ellerini ondan çek!Dialogue: 0,0:13:30.32,0:13:32.19,Main,,0,0,0,,Duman olmama rağmen bana vurabildi.Dialogue: 0,0:13:33.21,0:13:35.39,Main,,0,0,0,,Ama tekmeler ona işlemez.Dialogue: 0,0:13:37.30,0:13:38.17,Main,,0,0,0,,O...Dialogue: 0,0:13:38.17,0:13:41.30,Main,,0,0,0,,Korsan İmparatoriçesi, Hasır Şapka'yı korudu!Dialogue: 0,0:13:41.30,0:13:44.29,Main,,0,0,0,,Hancock! Ne yapmaya çalışıyorsun sen?Dialogue: 0,0:13:44.29,0:13:46.24,Main,,0,0,0,,Savaş Lordluğunu da mı bırakmak niyetindesin?Dialogue: 0,0:13:46.24,0:13:47.21,Main,,0,0,0,,Sessizlik!Dialogue: 0,0:13:47.85,0:13:50.69,Main,,0,0,0,,Çok öfkelendim, ne dediğin umrumda değil!Dialogue: 0,0:13:50.69,0:13:55.48,Main,,0,0,0,,En sevdiğimi nasıl dövüp yere yatırırsın?!Dialogue: 0,0:13:56.39,0:13:59.51,Main,,0,0,0,,Yaşamana izin vermeyeceğim!Dialogue: 0,0:13:59.51,0:14:02.92,Main,,0,0,0,,Daha önce hiç bu kadar öfkelenmemiştim!Dialogue: 0,0:14:02.92,0:14:06.22,Main,,0,0,0,,Seni parçalarına ayırıp hayvanlara yedireceğim!Dialogue: 0,0:14:07.27,0:14:09.43,Main,,0,0,0,,Demek o, Kuja Klanı'nın hakisiydi.Dialogue: 0,0:14:07.27,0:14:09.43,Note,,0,0,0,,- Haki: İrade Gücü -Dialogue: 0,0:14:11.74,0:14:13.24,Main,,0,0,0,,Hancock!Dialogue: 0,0:14:14.37,0:14:15.83,Main,,0,0,0,,Evet!Dialogue: 0,0:14:15.83,0:14:18.67,Main,,0,0,0,,Bana yine "Hancock" dedin!Dialogue: 0,0:14:20.61,0:14:23.57,Main,,0,0,0,,Kuma! Kuma, aklını başına topla!Dialogue: 0,0:14:23.57,0:14:27.99,Main,,0,0,0,,Benim! Yüzümü unuttun mu?!Dialogue: 0,0:14:27.99,0:14:30.23,Main,,0,0,0,,Aklını başına topla yoksa karşılık vereceğim!Dialogue: 0,0:14:30.23,0:14:31.95,Main,,0,0,0,,Kaldırabileceğimin de bir sınırı var!Dialogue: 0,0:14:33.16,0:14:36.00,Main,,0,0,0,,İkinizin ne tür bir geçmişi olduğunu bilmiyorum,...Dialogue: 0,0:14:36.00,0:14:37.56,Main,,0,0,0,,...ama vazgeç.Dialogue: 0,0:14:37.76,0:14:42.83,Main,,0,0,0,,Onunla konuşmanın manası yok, Devrim Ordusu Kumandanı Emporio Ivankov.Dialogue: 0,0:14:42.83,0:14:44.13,Main,,0,0,0,,Sen...Dialogue: 0,0:14:44.13,0:14:46.76,Main,,0,0,0,,Ne diyorsun?! Neler oluyor?!Dialogue: 0,0:14:46.76,0:14:51.77,Main,,0,0,0,,Tanıdığın adam muhtemelen Bartholomew Kuma'ydı, değil mi?Dialogue: 0,0:14:51.77,0:14:56.71,Main,,0,0,0,,Bir zamanlar Zalim Kuma denen adamı düşünüyorsan,...Dialogue: 0,0:14:57.31,0:14:59.74,Main,,0,0,0,,...öleli uzun zaman oldu.Dialogue: 0,0:15:01.05,0:15:03.08,Main,,0,0,0,,Neden bahsediyorsun?!Dialogue: 0,0:15:08.95,0:15:10.72,Main,,0,0,0,,Kuma...Dialogue: 0,0:15:11.03,0:15:12.60,Main,,0,0,0,,...öldü mü?!Dialogue: 0,0:15:19.00,0:15:24.10,Main,,0,0,0,,N-Neler oluyor? Korsan İmparatoriçesi neden Hasır Şapka'yı korudu?Dialogue: 0,0:15:30.41,0:15:31.76,Main,,0,0,0,,Al bunu.Dialogue: 0,0:15:33.24,0:15:35.58,Main,,0,0,0,,Bu, kardeşini bağlayan kelepçenin anahtarı.Dialogue: 0,0:15:43.20,0:15:46.02,Main,,0,0,0,,Luffy'nin eli... Luffy'nin eli...Dialogue: 0,0:15:46.02,0:15:47.86,Main,,0,0,0,,...benimkine dokundu!Dialogue: 0,0:15:49.20,0:15:50.26,Main,,0,0,0,,Hancock!Dialogue: 0,0:15:51.93,0:15:55.73,Main,,0,0,0,,Sen... Sen...Dialogue: 0,0:15:58.74,0:16:01.97,Main,,0,0,0,,Çok sağol! Sana borçluyum!Dialogue: 0,0:16:01.97,0:16:05.06,Main,,0,0,0,,Ö-Önemli değil! Önemli değil!Dialogue: 0,0:16:05.06,0:16:06.78,Main,,0,0,0,,Dert etme, sadece...Dialogue: 0,0:16:06.78,0:16:08.98,Main,,0,0,0,,İlerlemeye devam et, Luffy!Dialogue: 0,0:16:08.98,0:16:10.40,Main,,0,0,0,,Ah, evet!Dialogue: 0,0:16:11.18,0:16:12.91,Main,,0,0,0,,Sağol!Dialogue: 0,0:16:20.56,0:16:23.52,Main,,0,0,0,,Olamaz! Korsan İmparatoriçesi yenildi!Dialogue: 0,0:16:23.52,0:16:27.77,Main,,0,0,0,,Onun saldırısını mahvetti! Sumo güreşiyle karşılamış olmalı!Dialogue: 0,0:16:28.70,0:16:31.95,Main,,0,0,0,,Demek bu bahsini çok duyduğum şey...Dialogue: 0,0:16:33.06,0:16:34.55,Main,,0,0,0,,Evlilik!Dialogue: 0,0:16:53.83,0:16:57.86,Main,,0,0,0,,Küstah herif! Beni geçmene izin vermeyeceğim!Dialogue: 0,0:16:57.86,0:17:01.05,Main,,0,0,0,,Şuna bakın! Aşırı Aşağılama Pozu!Dialogue: 0,0:17:01.05,0:17:03.93,Main,,0,0,0,,Burnunun o kadar tepesinden bakıyor ki, gözleri yukarıya dikilmiş!Dialogue: 0,0:17:03.93,0:17:09.44,Main,,0,0,0,,Denizcilerin yoluna çıkarsan ne olacağını bilmiyor musun?Dialogue: 0,0:17:09.44,0:17:13.28,Main,,0,0,0,,Ne yaparsam yapayım, affedileceğim.Dialogue: 0,0:17:14.37,0:17:17.25,Main,,0,0,0,,Çünkü güzelim!Dialogue: 0,0:17:17.25,0:17:20.57,Main,,0,0,0,,Bunun için gerçekten minnettarım! Ona yine borçluyum!Dialogue: 0,0:17:21.59,0:17:24.12,Main,,0,0,0,,Bu da neydi?! Kuma öldü mü?!Dialogue: 0,0:17:24.12,0:17:27.46,Main,,0,0,0,,O zaman karşımda duran adam kim?Dialogue: 0,0:17:27.46,0:17:30.71,Main,,0,0,0,,Belli ki hayatta! Saçmalama!Dialogue: 0,0:17:31.93,0:17:33.06,Main,,0,0,0,,Iva-chan!Dialogue: 0,0:17:35.23,0:17:36.77,Main,,0,0,0,,Şu ayıya benzeyen adam!Dialogue: 0,0:17:35.23,0:17:36.77,Note,,0,0,0,,- Kuma: Ayı -Dialogue: 0,0:17:45.60,0:17:48.39,Main,,0,0,0,,Iva-chan, bu adamı tanıyor musun?Dialogue: 0,0:17:48.39,0:17:51.88,Main,,0,0,0,,Evet... Ama biraz tuhaf davranıyor.Dialogue: 0,0:17:54.73,0:17:59.03,Main,,0,0,0,,Görünüşe göre ikinizin Kuma'yla ilgili anıları var.Dialogue: 0,0:17:59.03,0:18:01.29,Main,,0,0,0,,Ama tanıdığınız Kuma ve bu adam...Dialogue: 0,0:18:01.29,0:18:04.23,Main,,0,0,0,,...iki farklı kişi!Dialogue: 0,0:18:04.87,0:18:07.16,Main,,0,0,0,,Farklı mı? Neden bahsediyor bu?Dialogue: 0,0:18:07.16,0:18:12.96,Main,,0,0,0,,Mümkün değil! Bu hiç şüphesiz Nikyu Nikyu Meyvesi yemiş olan kişi.Dialogue: 0,0:18:07.16,0:18:12.96,Note,,0,0,0,,- Pati Pati Meyvesi -Dialogue: 0,0:18:12.96,0:18:15.91,Main,,0,0,0,,O, Kuma! Kuma, cevap ver bana!Dialogue: 0,0:18:17.58,0:18:22.97,Main,,0,0,0,,Ne kadar konuşsan da faydası olmayacağını söyleyip duruyorum.Dialogue: 0,0:18:22.97,0:18:25.32,Main,,0,0,0,,Birkaç gün önce...Dialogue: 0,0:18:26.57,0:18:31.81,Main,,0,0,0,,...Hükümet'in baş bilim adamı Doktor Vegapunk,...Dialogue: 0,0:18:31.81,0:18:36.63,Main,,0,0,0,,...onu mükemmel insan silah haline getirecek değişiklikleri tamamladı.Dialogue: 0,0:18:36.63,0:18:41.47,Main,,0,0,0,,Diğer bir deyişle, bu eski Bartholomew Kuma!Dialogue: 0,0:18:41.47,0:18:45.27,Main,,0,0,0,,Değişiklik? Silah? Sen neden bahsediyorsun?!Dialogue: 0,0:18:45.83,0:18:47.33,Main,,0,0,0,,Kısacası Hükümet'in...Dialogue: 0,0:18:47.33,0:18:54.05,Main,,0,0,0,,...insan silah projesi tarafından deney konusu olarak seçildi. Buna kendisi gönüllü oldu.Dialogue: 0,0:18:55.10,0:18:56.61,Main,,0,0,0,,Önce elleriyle,...Dialogue: 0,0:18:56.61,0:18:58.65,Main,,0,0,0,,..sonra bacakları...Dialogue: 0,0:18:58.65,0:19:01.02,Main,,0,0,0,,Bilincine dokunmadan...Dialogue: 0,0:19:01.02,0:19:06.27,Main,,0,0,0,,...bilim adamları, onun uzuvlarını uzun zaman boyunca birer birer değiştirdiler.Dialogue: 0,0:19:07.53,0:19:12.13,Main,,0,0,0,,Yalan söyleme! Kuma, Dünya Hükümeti'nden nefret eder!Dialogue: 0,0:19:12.13,0:19:15.17,Main,,0,0,0,,O asla...Dialogue: 0,0:19:15.17,0:19:18.44,Main,,0,0,0,,...hayatını Hükümet'e sunmazdı!Dialogue: 0,0:19:18.44,0:19:25.44,Main,,0,0,0,,Bu herifin Hükümet'le ne tür bir anlaşma yaptığını bilmiyorum.Dialogue: 0,0:19:25.44,0:19:32.88,Main,,0,0,0,,Birkaç gün önce, içinde kesinlikle biraz insan vardı.Dialogue: 0,0:19:34.99,0:19:42.04,Main,,0,0,0,,Ama şimdi, insan olarak doğduğuna dair tüm hafızasını yitirdi. Ölü sayılır.Dialogue: 0,0:19:42.04,0:19:45.83,Main,,0,0,0,,Sadece Hükümet'in emirleri doğrultusunda dövüşen bir canavar hâline geldi.Dialogue: 0,0:19:47.34,0:19:50.30,Main,,0,0,0,,Pacifista, PX-0!Dialogue: 0,0:19:50.30,0:19:53.20,Main,,0,0,0,,Geçmiş yok artık, unutmalısınız!Dialogue: 0,0:20:07.29,0:20:11.49,Main,,0,0,0,,Kuma! Bunca yıldır bedenine ne oldu?!Dialogue: 0,0:20:12.99,0:20:15.39,Main,,0,0,0,,Sahi, demişti ki...Dialogue: 0,0:20:15.79,0:20:19.05,Flashbacks,,0,0,0,,Bir daha asla karşılaşmayacağız.Dialogue: 0,0:20:20.28,0:20:21.40,Flashbacks,,0,0,0,,Elveda.Dialogue: 0,0:20:22.25,0:20:24.34,Main,,0,0,0,,Bana söylediği son şey bu oldu.Dialogue: 0,0:20:24.34,0:20:27.56,Main,,0,0,0,,Sorun nedir, Kuma? Benim! Ivankov!Dialogue: 0,0:20:28.48,0:20:31.08,Main,,0,0,0,,N-Nerede bu? Nereye gitti?Dialogue: 0,0:20:34.95,0:20:37.75,Main,,0,0,0,,O çok tehlikeli! Dikkatli olun!Dialogue: 0,0:20:54.03,0:20:56.93,Main,,0,0,0,,Lanet olsun, Kuma!Dialogue: 0,0:21:06.93,0:21:08.23,Main,,0,0,0,,Daha korkmadın mı?Dialogue: 0,0:21:35.39,0:21:40.68,Main,,0,0,0,,Sevimli Şekerciklerime saldırmaya nasıl cüret edersin?!Dialogue: 0,0:21:40.68,0:21:44.25,Main,,0,0,0,,Artık kendimi tutacağımı sanma!Dialogue: 0,0:21:44.25,0:21:46.22,Main,,0,0,0,,Al bakalım!Dialogue: 0,0:21:54.71,0:21:56.37,Main,,0,0,0,,Gerçekten güçlü!Dialogue: 0,0:21:57.28,0:21:59.71,Main,,0,0,0,,Tanıştığım kişilerden biri ilk kez...Dialogue: 0,0:22:00.43,0:22:04.80,Main,,0,0,0,,...yüzümü...Dialogue: 0,0:22:04.80,0:22:10.57,Main,,0,0,0,,...yüzümü unutmuş! Bu daha önce hiç olmamıştı!Dialogue: 0,0:22:11.22,0:22:13.37,Main,,0,0,0,,Ah... Evet...Dialogue: 0,0:22:13.37,0:22:14.65,Main,,0,0,0,,Ancak!Dialogue: 0,0:22:15.28,0:22:18.32,Main,,0,0,0,,Anıların silindiği için mi bilmiyorum,...Dialogue: 0,0:22:18.32,0:22:21.96,Main,,0,0,0,,...ama ne kadar korkutucu olabileceğimi de unuttuysan,...Dialogue: 0,0:22:21.96,0:22:24.62,Main,,0,0,0,,...korkuyu tüm bedenine kazıyacağım!Dialogue: 0,0:22:25.34,0:22:27.53,Main,,0,0,0,,Hazırlan!Dialogue: 0,0:22:29.30,0:22:31.56,Main,,0,0,0,,Gerçekten çabuk iyileşti.Dialogue: 0,0:22:31.56,0:22:33.31,Main,,0,0,0,,Onun icabına bakacağım.Dialogue: 0,0:22:33.31,0:22:37.58,Main,,0,0,0,,Siz gidip Hasır Şapkalı çocuğa yardım edin!Dialogue: 0,0:22:37.58,0:22:38.67,Main,,0,0,0,,Anlaşıldı!Dialogue: 0,0:22:39.84,0:22:41.77,Main,,0,0,0,,Hadi gidelim, Hasır Şapka!Dialogue: 0,0:22:42.55,0:22:44.68,Main,,0,0,0,,Yardım için sağol, Iva-chan!Dialogue: 0,0:22:44.68,0:22:47.18,Main,,0,0,0,,İdam sehpasına ilerleyin!Dialogue: 0,0:22:47.18,0:22:51.52,Main,,0,0,0,,Tamam!Dialogue: 0,0:22:52.99,0:22:55.79,Main,,0,0,0,,Lanet olası arsız Hasır Şapka!Dialogue: 0,0:22:55.79,0:22:57.24,Main,,0,0,0,,Fazla uzaklaşmasına izin vermeyin!Dialogue: 0,0:22:57.24,0:23:02.14,Main,,0,0,0,,Büyük, Kaptan Buggy'nin İtibarını Artırma Planını uygulamaya koyma vakti.Dialogue: 0,0:23:02.14,0:23:03.39,Main,,0,0,0,,Evet!Dialogue: 0,0:23:03.39,0:23:06.92,Main,,0,0,0,,Başarılı olursak, tüm dünya benim müthişliğimi tanımak zorunda kalacak!Dialogue: 0,0:23:06.92,0:23:10.73,Main,,0,0,0,,Geride kalmayın ve planımı uygulayın!Dialogue: 0,0:23:14.56,0:23:18.03,Main,,0,0,0,,Bu plan gerçekten işe yarayacak mı?Dialogue: 0,0:23:24.07,0:23:25.83,Main,,0,0,0,,Crocodile!Dialogue: 0,0:23:25.83,0:23:27.57,Main,,0,0,0,,Bunların sonu yok!Dialogue: 0,0:23:31.39,0:23:33.34,Main,,0,0,0,,Ondan epey uzağa fırlatıldım.Dialogue: 0,0:23:35.17,0:23:37.09,Main,,0,0,0,,Babalığın yanına bile yaklaşmana izin vermiyoruz!Dialogue: 0,0:23:37.09,0:23:38.84,Main,,0,0,0,,Amaçlarıma...Dialogue: 0,0:23:40.20,0:23:41.45,Main,,0,0,0,,...karışmayın!Dialogue: 0,0:23:44.19,0:23:48.17,Main,,0,0,0,,Ne can sıkıcı bir adam... Vazgeçmeyecek.Dialogue: 0,0:24:04.05,0:24:06.82,Main,,0,0,0,,Çok büyük, ama yine de hızlı.Dialogue: 0,0:24:06.82,0:24:08.43,Main,,0,0,0,,İşte yine geliyor.Dialogue: 0,0:24:08.43,0:24:11.50,Main,,0,0,0,,Üçüncü Bölüm Kumandanı, Elmas Jozu.Dialogue: 0,0:24:23.23,0:24:26.73,Main,,0,0,0,,Çıkışından etkilendim, Timsah adam.Dialogue: 0,0:24:26.73,0:24:29.65,Main,,0,0,0,,Kan havuzundaki banyon nasıldı?Dialogue: 0,0:24:29.65,0:24:35.79,Main,,0,0,0,,Doflamingo. Karışma. Ölmek mi istiyorsun?Dialogue: 0,0:24:35.79,0:24:38.29,Main,,0,0,0,,Ne kadar nahoş konuşuyorsun.Dialogue: 0,0:24:38.29,0:24:41.46,Main,,0,0,0,,Ne dersin? Benimle ekip olmak ister misin?Dialogue: 0,0:24:44.26,0:24:45.20,Main,,0,0,0,,Geçeceğinizi mi sanıyorsunuz?Dialogue: 0,0:24:45.20,0:24:47.20,Main,,0,0,0,,Bizi durdurabileceğinizi mi sanıyorsunuz?Dialogue: 0,0:24:47.20,0:24:48.40,Main,,0,0,0,,Hadi, Hasır Şapka!Dialogue: 0,0:24:50.60,0:24:51.20,Main,,0,0,0,,Sağolun!Dialogue: 0,0:25:05.30,0:25:07.18,Main,,0,0,0,,Affet beni, Kızıl Saç.Dialogue: 0,0:25:09.68,0:25:12.39,Main,,0,0,0,,Ona yumuşak davranmayacağım.Dialogue: 0,0:25:14.73,0:25:16.19,Main,,0,0,0,,O...Dialogue: 0,0:25:20.21,0:25:21.13,Main,,0,0,0,,...Şahin Göz!Dialogue: 0,0:25:27.60,0:25:29.77,Main,,0,0,0,,Şimdi, kader.Dialogue: 0,0:25:30.45,0:25:35.21,Main,,0,0,0,,Gelecek neslin vaad edilmiş çocuğunun hayatı... burada sona mı erecek?Dialogue: 0,0:25:35.51,0:25:40.43,Main,,0,0,0,,Ermeyecekse, Kara Kılıç'tan nasıl kaçacak?Dialogue: 0,0:04:24.58,0:04:27.08,Main,,0,0,0,,Gomu Gomu no...Dialogue: 0,0:04:27.08,0:04:28.88,Main,,0,0,0,,...Balon!Dialogue: 0,0:10:47.00,0:10:49.50,Main,,0,0,0,,Balıkadam Karate...Dialogue: 0,0:10:53.12,0:10:55.60,Main,,0,0,0,,Köpekbalığı Derisi Avuç Blokesi!Dialogue: 0,0:11:02.63,0:11:05.84,Main,,0,0,0,,Köpekbalığı Kiremiti Gerçek Yumruk!Dialogue: 0,0:12:09.30,0:12:11.10,Main,,0,0,0,,İkinci Düzen!Dialogue: 0,0:12:15.51,0:12:17.51,Main,,0,0,0,,Gomu Gomu no...Dialogue: 0,0:12:17.51,0:12:21.99,Main,,0,0,0,,...Jet Makineli!Dialogue: 0,0:12:21.99,0:12:23.92,Main,,0,0,0,,Beyaz Fırlatıcı!Dialogue: 0,0:16:37.00,0:16:38.56,Main,,0,0,0,,Uyluk Parfümü!Dialogue: 0,0:20:39.78,0:20:41.35,Main,,0,0,0,,Basınçlı Top!Dialogue: 0,0:20:59.14,0:21:00.40,Main,,0,0,0,,Yüz...Dialogue: 0,0:21:00.40,0:21:02.40,Main,,0,0,0,,...Spektrumu!Dialogue: 0,0:21:12.05,0:21:14.90,Main,,0,0,0,,Galaksi Göz KırpışıDialogue: 0,0:23:49.13,0:23:51.40,Main,,0,0,0,,Parlak Serseri!Dialogue: 0,0:04:32.25,0:04:42.25,Author,,0,0,0,, Türkçeleştirme  onepacetr.netDialogue: 0,0:15:14.00,0:15:24.00,Author,,0,0,0,, Türkçeleştirme  onepacetr.netDialogue: 0,0:25:30.00,0:25:40.00,Author,,0,0,0,, Türkçeleştirme  onepacetr.netDialogue: 0,0:02:11.44,0:02:15.88,Credits,,0,0,0,,Editing SewilDialogue: 0,0:02:21.82,0:02:27.79,Credits,,0,0,0,,Karaoke KaitouYahikoDialogue: 0,0:02:16.35,0:02:21.22,Credits,,0,0,0,,QC Galaxy 9000 PepperjackDialogue: 0,0:02:27.86,0:02:31.66,Credits,,0,0,0,,Timing Galaxy 9000Dialogue: 0,0:02:32.46,0:02:35.10,Credits,,0,0,0,,Soundtracking HaleeDialogue: 0,0:02:37.97,0:02:41.21,Credits,,0,0,0,,Translation YibisDialogue: 0,0:02:43.04,0:02:45.98,Credits,,0,0,0,,Raws CruchyrollDialogue: 0,0:02:11.00,0:02:16.25,Karaoke,,0,0,0,karaoke,♪ Her seferinde yağmurdan sonra gökyüzüne bakıyorum. ♪Dialogue: 0,0:02:16.25,0:02:21.76,Karaoke,,0,0,0,karaoke,♪ Henüz sulugöz olduğum zamanları düşünüyorum. ♪Dialogue: 0,0:02:21.76,0:02:29.50,Karaoke,,0,0,0,karaoke,♪ Umutsuzca birinin arkasından koşuyorum,... ♪Dialogue: 0,0:02:29.50,0:02:32.41,Karaoke,,0,0,0,karaoke,♪ ..."Daha güçlü olmak istiyorum," diye düşünerek. ♪Dialogue: 0,0:02:32.41,0:02:37.59,Karaoke,,0,0,0,karaoke,♪ "Teşekkürüm" şimdi rüzgârda kayboldu,... ♪Dialogue: 0,0:02:37.69,0:02:42.70,Karaoke,,0,0,0,karaoke,♪ ...daha güçlü olabilir miyim? ♪Dialogue: 0,0:02:43.00,0:02:48.47,Karaoke,,0,0,0,karaoke,♪ Cevabımı bulamıyorum. ♪Dialogue: 0,0:02:48.87,0:02:54.26,Karaoke,,0,0,0,karaoke,♪ Bu yüzden ilerlemeye devam edeceğim. ♪Dialogue: 0,0:02:54.46,0:02:56.94,Karaoke,,0,0,0,karaoke,♪ Gel hadi, gidelim. ♪Dialogue: 0,0:02:57.04,0:03:00.25,Karaoke,,0,0,0,karaoke,♪ Asla pes etmeyeceğiz. ♪Dialogue: 0,0:03:00.25,0:03:05.49,Karaoke,,0,0,0,karaoke,♪ Zamanın dalgalarına yenik düşmeyeceğiz. ♪Dialogue: 0,0:03:05.59,0:03:11.00,Karaoke,,0,0,0,karaoke,♪ Tekrar tekrar ayağa kalkacağız. ♪Dialogue: 0,0:03:11.20,0:03:16.53,Karaoke,,0,0,0,karaoke,♪ Çünkü bizim için önemli olanı kaybetmek istemiyoruz. ♪Dialogue: 0,0:03:16.63,0:03:21.74,Karaoke,,0,0,0,karaoke,♪ Beni sürekli, sürekli ilerlemeye zorlayan... ♪Dialogue: 0,0:03:21.90,0:03:27.29,Karaoke,,0,0,0,karaoke,♪ ...kafamdaki sesi duyabiliyorum. ♪Dialogue: 0,0:03:27.33,0:03:32.46,Karaoke,,0,0,0,karaoke,♪ Haylaz yağmur bana engel olurken bile... ♪Dialogue: 0,0:03:32.46,0:03:37.39,Karaoke,,0,0,0,karaoke,♪ ...kaçmaya çalışmayacağım. ♪Dialogue: 0,0:03:39.99,0:03:42.35,Karaoke,,0,0,0,karaoke,♪ Gel hadi, gidelim. ♪Dialogue: 0,0:03:42.37,0:03:45.65,Karaoke,,0,0,0,karaoke,♪ Asla pes etmeyeceğiz. ♪Dialogue: 0,0:03:45.75,0:03:51.04,Karaoke,,0,0,0,karaoke,♪ Zamanın dalgalarına yenik düşmeyeceğiz. ♪Dialogue: 0,0:03:51.10,0:03:56.73,Karaoke,,0,0,0,karaoke,♪ Tekrar tekrar ayağa kalkacağız. ♪Dialogue: 0,0:03:56.80,0:04:02.16,Karaoke,,0,0,0,karaoke,♪ Çünkü bizim için önemli olanı kaybetmek istemiyoruz. ♪Dialogue: 0,0:04:02.30,0:04:07.99,Karaoke,,0,0,0,karaoke,♪ İnandığımız geleceğe doğru ilerleyelim. ♪