000000,&H78000000,0,-1,0,0,100,100,0,0,1,1.5,1.5,8,120,120,18,1Style: OP13-Kanji-furigana,Duality,30,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2,0,8,10,10,80,1Style: OP13-Karaoke,Duality,60,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,8,10,10,10,1Style: OP13-Translation,Duality,45.0,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,2,10,10,18,1Style: OP13-Kanji,Duality,60,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,8,10,10,110,1Style: OP13-Credits,FOT-Greco Std B,40,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,95,100,1,0,1,2.2,0,1,80,10,100,1Style: Author,Impress BT,25,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1,1,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:02:31.93,0:02:41.93,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazaskerDialogue: 0,0:14:50.00,0:15:00.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazaskerDialogue: 0,0:24:00.00,0:24:10.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazaskerDialogue: 0,0:02:31.93,0:02:39.77,Title,,0,0,230,,İdam PlatformuDialogue: 0,0:02:47.18,0:02:49.88,Main,,0,0,0,,Bakın! Ace iyi!Dialogue: 0,0:02:49.88,0:02:52.24,Main,,0,0,0,,Hey! Dayan!Dialogue: 0,0:02:52.24,0:02:55.11,Main,,0,0,0,,Bunu yapan Ace'in kardeşi miydi?Dialogue: 0,0:02:55.11,0:02:56.47,Main,,0,0,0,,O da neydi?Dialogue: 0,0:02:56.47,0:02:58.48,Main,,0,0,0,,Neredeyse bayılıyordum.Dialogue: 0,0:03:03.73,0:03:08.07,Main,,0,0,0,,Aynı Babalık ve Kızıl Saç gibi Fatih'in Hakisi'ne sahip!Dialogue: 0,0:03:09.00,0:03:11.17,Main,,0,0,0,,D-Demek bunu yapan oydu.Dialogue: 0,0:03:12.10,0:03:15.57,Main,,0,0,0,,Görünüşe göre bilinçsizce yaptı.Dialogue: 0,0:03:15.57,0:03:19.54,Main,,0,0,0,,İçinde korkutucu güçler saklı.Dialogue: 0,0:03:27.66,0:03:30.06,Main,,0,0,0,,Demek gerçekten onu miras almış.Dialogue: 0,0:03:30.83,0:03:32.06,Main,,0,0,0,,Sen de mi?Dialogue: 0,0:03:32.66,0:03:35.23,Main,,0,0,0,,İradesi zayıf olanlar geri çekilsin!Dialogue: 0,0:03:35.23,0:03:37.93,Main,,0,0,0,,Onu sıradan bir çaylak olarak görmeyin!Dialogue: 0,0:03:37.93,0:03:40.08,Main,,0,0,0,,Galip Kralın Hakisi...Dialogue: 0,0:03:40.08,0:03:44.95,Main,,0,0,0,,O, Devrimci Dragon'un oğlu.  Sanırım onda olacağını bilmeliydik.Dialogue: 0,0:03:44.95,0:03:46.17,Main,,0,0,0,,Koramiral Doberman...Dialogue: 0,0:03:46.62,0:03:50.34,Main,,0,0,0,,Yaptığın şeyi... O gücü kullanmayı nerede öğrendin?Dialogue: 0,0:03:50.76,0:03:52.01,Main,,0,0,0,,Ha? Neyi kullanmayı?Dialogue: 0,0:03:52.01,0:03:54.07,Main,,0,0,0,,Boşver.Dialogue: 0,0:03:54.07,0:03:55.80,Thoughts,,0,0,0,,Yaptığı şeyi farketmiyor.Dialogue: 0,0:03:55.80,0:03:57.80,Thoughts,,0,0,0,,Henüz uyuyan bir güç.Dialogue: 0,0:03:57.80,0:04:00.32,Thoughts,,0,0,0,,Yine de bir şekilde açığa çıkarmayı başardı.Dialogue: 0,0:04:00.32,0:04:04.11,Thoughts,,0,0,0,,Soyun kendisini tanıtacak, Dragon.Dialogue: 0,0:04:07.33,0:04:12.76,Main,,0,0,0,,Bu savaştan canlı çıkmasına izin vermeyin!  Gitmesine izin verirsek, korkutucu bir düşman olacak!Dialogue: 0,0:04:12.76,0:04:14.77,Main,,0,0,0,,Hasır Şapka'yı muhakkak devirin!Dialogue: 0,0:04:21.28,0:04:22.37,Main,,0,0,0,,Kahretsin, Beyazsakal!Dialogue: 0,0:04:23.43,0:04:27.78,Main,,0,0,0,,İtibarını canavar olarak kazandı! Her pahasına onu öldürün!Dialogue: 0,0:04:28.81,0:04:32.48,Main,,0,0,0,,Beyler!Dialogue: 0,0:04:32.48,0:04:33.49,Main,,0,0,0,,Babalık...Dialogue: 0,0:04:35.18,0:04:39.29,Main,,0,0,0,,Şu an itibariyle Hasır Şapkalı Luffy'ye...Dialogue: 0,0:04:39.29,0:04:43.85,Main,,0,0,0,,...tüm gücünüzü verin!Dialogue: 0,0:04:52.30,0:04:53.87,Main,,0,0,0,,Ace'in kardeşine mi?Dialogue: 0,0:04:55.61,0:04:58.48,Main,,0,0,0,,Hasır Şapkalı çocuk! Dikkat et!Dialogue: 0,0:05:02.92,0:05:03.82,Main,,0,0,0,,Sen...Dialogue: 0,0:05:04.32,0:05:07.88,Main,,0,0,0,,Beyazsakal müttefiklerinden... Bohem Şövalye Douma!Dialogue: 0,0:05:07.88,0:05:10.88,Main,,0,0,0,,Tanıştığıma memnun oldum, Koramiral Momonga!Dialogue: 0,0:05:17.10,0:05:18.98,Main,,0,0,0,,DeCalvan Kardeşler...Dialogue: 0,0:05:18.98,0:05:20.39,Main,,0,0,0,,Rakiplerin...Dialogue: 0,0:05:20.39,0:05:21.90,Main,,0,0,0,,...biz olacağız!Dialogue: 0,0:05:23.30,0:05:25.08,Main,,0,0,0,,Yıldırım Kılıç McGuy!Dialogue: 0,0:05:25.08,0:05:28.77,Main,,0,0,0,,Savaşta seninle yüzleşmek istiyordum, Koramiral Doberman!Dialogue: 0,0:05:30.08,0:05:32.11,Main,,0,0,0,,B-Bu da ne?Dialogue: 0,0:05:32.11,0:05:35.78,Main,,0,0,0,,Yeni Dünya Korsanları olarak size yardım edeceğiz!Dialogue: 0,0:05:35.78,0:05:39.42,Main,,0,0,0,,Ace-chan hemen önümüzde! Gidelim, Hasır Şapka!Dialogue: 0,0:05:43.49,0:05:46.86,Main,,0,0,0,,Beyazsakal Korsanları, Hasır Şapka'yı korumaya çalışıyor!Dialogue: 0,0:05:51.81,0:05:53.47,Main,,0,0,0,,Bu adamların nesi var?!Dialogue: 0,0:05:53.47,0:05:55.50,Main,,0,0,0,,Acele et, Ace'in kardeşi!Dialogue: 0,0:05:55.50,0:05:58.81,Main,,0,0,0,,Denizciler şu anda Babalık'a odaklanmış durumda!Dialogue: 0,0:05:58.81,0:06:01.97,Main,,0,0,0,,Bu şansı kaçırırsan, asla amirallere ulaşamazsın!Dialogue: 0,0:06:02.75,0:06:05.34,Main,,0,0,0,,Doğrudan savunmalarına saldıracağız! Bizimle gel!Dialogue: 0,0:06:07.49,0:06:10.74,Main,,0,0,0,,Durum ciddi, Hasır Şapkalı çocuk!Dialogue: 0,0:06:10.74,0:06:13.67,Main,,0,0,0,,Dünyanın en güçlü korsanları seni sınamaya çalışıyor!Dialogue: 0,0:06:16.10,0:06:20.86,Main,,0,0,0,,Beyazsakal sana güvendi! Bu müthiş!Dialogue: 0,0:06:21.30,0:06:25.53,Main,,0,0,0,,Onun beklentilerini karşılayabilecek azmin var mı diye soruyorum!Dialogue: 0,0:06:26.60,0:06:29.97,Main,,0,0,0,,Beyazsakal umrumda değil.Dialogue: 0,0:06:30.38,0:06:32.30,Main,,0,0,0,,Başından beri buraya gelmek için...Dialogue: 0,0:06:34.04,0:06:37.01,Main,,0,0,0,,...bir tek nedenim vardı!Dialogue: 0,0:06:37.46,0:06:39.04,Main,,0,0,0,,Korsanlar hızlanıyor.Dialogue: 0,0:06:39.43,0:06:42.31,Main,,0,0,0,,Savunmamızı yarıyorlar! Destek kuvvetlerini gönderin!Dialogue: 0,0:06:42.31,0:06:45.04,Main,,0,0,0,,Koramiral! Hasır Şapka'nın peşinden gitmemiz gerekmez mi?Dialogue: 0,0:06:45.04,0:06:45.92,Main,,0,0,0,,Durun!Dialogue: 0,0:06:46.23,0:06:50.66,Main,,0,0,0,,Korsanlar Beyazsakal'ı terketti!  Beyazsakal'ı hedef alın!Dialogue: 0,0:06:50.98,0:06:54.35,Main,,0,0,0,,Onu yenersek, duracaklar!Dialogue: 0,0:06:56.05,0:07:01.23,Main,,0,0,0,,Demek hep birden saldırınca beni yenebileceğinizi düşünüyorsunuz.Dialogue: 0,0:07:15.68,0:07:18.25,Main,,0,0,0,,Beyazsakal... Ölümsüz falan mı bu?!Dialogue: 0,0:07:20.85,0:07:23.19,Thoughts,,0,0,0,,Dene bakalım, çocuk.Dialogue: 0,0:07:23.19,0:07:27.93,Thoughts,,0,0,0,,Demin benim yerime Ace'in idamını engellemeyi başardın.Dialogue: 0,0:07:27.93,0:07:31.31,Thoughts,,0,0,0,,Sen de D'nin İradesi'ne sahipsen,...Dialogue: 0,0:07:31.31,0:07:36.23,Thoughts,,0,0,0,,...bana bu devrin ötesinde yatan şeyi göster!Dialogue: 0,0:07:37.52,0:07:38.47,Main,,0,0,0,,O...Dialogue: 0,0:07:38.83,0:07:40.04,Main,,0,0,0,,Şahin Göz!Dialogue: 0,0:07:41.87,0:07:44.00,Main,,0,0,0,,Savuştur onu, Hasır Şapkalı çocuk!Dialogue: 0,0:07:46.31,0:07:47.45,Main,,0,0,0,,Sen...Dialogue: 0,0:07:47.97,0:07:52.28,Main,,0,0,0,,Patronun emri. Şimdilik Denizciler'in önünü keseceğiz. Şimdi git!Dialogue: 0,0:07:55.57,0:07:56.82,Main,,0,0,0,,Sen Daz Bones'sun, değil mi?Dialogue: 0,0:08:04.55,0:08:05.86,Main,,0,0,0,,Hasır Şapkalı çocuk!Dialogue: 0,0:08:15.76,0:08:17.11,Main,,0,0,0,,Crocodile...Dialogue: 0,0:08:18.69,0:08:21.08,Main,,0,0,0,,Daha ne kadar uyuyacaksın, Bay 1?Dialogue: 0,0:08:22.17,0:08:25.35,Main,,0,0,0,,Görünüşe göre hapisanedeki hayatım sırasında vücudum yumuşamış.Dialogue: 0,0:08:25.67,0:08:30.29,Main,,0,0,0,,Yoluma çıkıyorsun, Hasır Şapka. Kaybol artık.Dialogue: 0,0:08:34.78,0:08:38.33,Main,,0,0,0,,Niye bana engel oldun, Crocodile?Dialogue: 0,0:08:38.33,0:08:42.11,Main,,0,0,0,,Şu anda moralim epey bozuk.Dialogue: 0,0:08:42.11,0:08:44.87,Main,,0,0,0,,Kendine dikkat et, Şahin Göz!Dialogue: 0,0:08:48.05,0:08:49.11,Main,,0,0,0,,Luffy!Dialogue: 0,0:08:49.54,0:08:53.34,Main,,0,0,0,,Ben de sana yardım edeceğim!Dialogue: 0,0:08:55.32,0:08:57.85,Main,,0,0,0,,Monkey D. Luffy'ye saldırın.Dialogue: 0,0:09:07.64,0:09:11.30,Main,,0,0,0,,Boa Hancock. Müttefik. Ateşkes.Dialogue: 0,0:09:11.30,0:09:12.72,Main,,0,0,0,,Hey!Dialogue: 0,0:09:17.39,0:09:19.25,Main,,0,0,0,,Bu ne demek oluyor?!Dialogue: 0,0:09:19.25,0:09:22.67,Main,,0,0,0,,Sen Savaş Lordu değil misin, Boa Hancock?!Dialogue: 0,0:09:22.67,0:09:25.41,Main,,0,0,0,,Pacifistalar'ın birçoğunu durdurdun.Dialogue: 0,0:09:25.41,0:09:27.85,Main,,0,0,0,,Hükümet'ten yana değil misin?!Dialogue: 0,0:09:28.83,0:09:33.82,Main,,0,0,0,,Ne kaba bir adam. Görünüşe göre hiçbir şey anlamıyorsun.Dialogue: 0,0:09:34.23,0:09:35.22,Main,,0,0,0,,Ne?!Dialogue: 0,0:09:35.55,0:09:38.10,Main,,0,0,0,,Sana bir şey söyleyeyim.Dialogue: 0,0:09:38.73,0:09:41.66,Main,,0,0,0,,Aşk her zaman bir kasırgadır!Dialogue: 0,0:09:41.66,0:09:43.77,Main,,0,0,0,,Bu da ne demek oluyor?!Dialogue: 0,0:09:46.58,0:09:49.63,Main,,0,0,0,,İdam sehpası tam önümüzde, Hasır Şapkalı çocuk!Dialogue: 0,0:09:49.63,0:09:52.44,Main,,0,0,0,,Dümdüz koşmaya devam et!Dialogue: 0,0:09:52.44,0:09:53.59,Main,,0,0,0,,Tamam!Dialogue: 0,0:09:56.05,0:09:58.94,Main,,0,0,0,,Şimdi sıra sende.Dialogue: 0,0:10:00.05,0:10:03.43,Main,,0,0,0,,Yaraların iyileşmeden seni sıkıntıya soktuğum için üzgünüm,...Dialogue: 0,0:10:03.43,0:10:05.88,Main,,0,0,0,,...ama burada gücüne ihtiyaç var!Dialogue: 0,0:10:06.57,0:10:08.98,Main,,0,0,0,,Basit bir mesele, Iva-san.Dialogue: 0,0:10:10.04,0:10:11.66,Main,,0,0,0,,Endişelenmeyin.Dialogue: 0,0:10:20.03,0:10:21.17,Main,,0,0,0,,Yengeç-chan!Dialogue: 0,0:10:44.50,0:10:46.79,Main,,0,0,0,,O da ne öyle?!Dialogue: 0,0:10:46.79,0:10:49.97,Main,,0,0,0,,Devrim Ordusu'ndan Inazuma! Bu onun işi!Dialogue: 0,0:10:49.97,0:10:52.43,Main,,0,0,0,,Köprü yaptı! Tamamdır!Dialogue: 0,0:10:53.15,0:10:56.13,Main,,0,0,0,,Hasır Şapka doğruca idam sehpasına gidiyor!Dialogue: 0,0:10:56.13,0:10:58.45,Main,,0,0,0,,Bu durumda platforma ulaşacak!Dialogue: 0,0:10:58.45,0:11:00.47,Main,,0,0,0,,Hasır Şapka'nın gitmesine izin vermeyin!Dialogue: 0,0:11:00.47,0:11:04.34,Main,,0,0,0,,Faydasız! Bu korsanları geçemiyoruz!Dialogue: 0,0:11:04.34,0:11:08.01,Main,,0,0,0,,Toplarınızı kullanın! Hasır Şapka'ya nişan alın!Dialogue: 0,0:11:22.36,0:11:24.86,Main,,0,0,0,,Ne?! O...Dialogue: 0,0:11:26.17,0:11:29.49,Main,,0,0,0,,Beyazsakal Korsanları'nın Kumandanları!Dialogue: 0,0:11:33.17,0:11:37.00,Main,,0,0,0,,Ace'in kardeşi! Koşmaya devam et!Dialogue: 0,0:11:40.31,0:11:43.01,Main,,0,0,0,,Tüm birimler, tek bir noktaya odaklanın ve hamle yapın!Dialogue: 0,0:11:57.62,0:11:59.23,Main,,0,0,0,,Hasır Şapka'nın geçmesine izin vermeyin!Dialogue: 0,0:11:59.23,0:12:01.48,Main,,0,0,0,,Gomu Gomu no...Dialogue: 0,0:12:02.73,0:12:06.18,Main,,0,0,0,,...BaltaDialogue: 0,0:12:12.18,0:12:13.80,Main,,0,0,0,,Luffy-kun. Git.Dialogue: 0,0:12:13.80,0:12:15.68,Main,,0,0,0,,Tamam! Sağol!Dialogue: 0,0:12:16.93,0:12:19.29,Main,,0,0,0,,Hasır Şapka'nın geçmesine izin vermeyin!Dialogue: 0,0:12:19.29,0:12:21.99,Main,,0,0,0,,Ölümcül Göz Kırpışı!Dialogue: 0,0:12:24.86,0:12:27.67,Main,,0,0,0,,Kimsenin bu noktayı geçmesine izin vermeyeceğim!Dialogue: 0,0:12:30.43,0:12:32.80,Main,,0,0,0,,Git artık, Hasır Şapkalı çocuk!Dialogue: 0,0:12:33.24,0:12:35.19,Main,,0,0,0,,Hasır Şapka neredeyse vardı!Dialogue: 0,0:12:35.19,0:12:37.70,Main,,0,0,0,,Tamam! Devam et!Dialogue: 0,0:12:37.70,0:12:40.87,Main,,0,0,0,,Hasır Şapka'yı durdurun!Dialogue: 0,0:12:40.87,0:12:43.41,Main,,0,0,0,,Git, Hasır Şapka!Dialogue: 0,0:12:43.41,0:12:45.54,Main,,0,0,0,,Ace'i serbest bırak!Dialogue: 0,0:12:45.54,0:12:51.55,Main,,0,0,0,,Demek o çocuğu kozun olarak kullanıyorsun, öyle mi, Beyazsakal?Dialogue: 0,0:12:51.55,0:12:54.65,Main,,0,0,0,,Ama devam etmesine izin vermeyeceğim.Dialogue: 0,0:13:02.29,0:13:04.96,Main,,0,0,0,,Beyazsakal.Dialogue: 0,0:13:04.96,0:13:08.77,Main,,0,0,0,,Burada dur ve seyret!Dialogue: 0,0:13:21.81,0:13:23.12,Main,,0,0,0,,Luffy...Dialogue: 0,0:13:26.29,0:13:29.25,Main,,0,0,0,,Geliyorum, Ace!Dialogue: 0,0:13:45.42,0:13:47.95,Main,,0,0,0,,Bu, Kahraman Garp!Dialogue: 0,0:13:48.61,0:13:52.68,Main,,0,0,0,,Dede! Lütfen çekil!Dialogue: 0,0:13:52.68,0:13:55.40,Main,,0,0,0,,Çekilmem mümkün değil!Dialogue: 0,0:13:55.40,0:13:58.95,Main,,0,0,0,,Ben, Denizci Karargâhı'nın koramiraliyim!Dialogue: 0,0:13:59.44,0:14:05.39,Main,,0,0,0,,Sen doğmadan çok önce korsanlarla dövüşüyordum!Dialogue: 0,0:14:05.92,0:14:07.36,Main,,0,0,0,,Dede!Dialogue: 0,0:14:09.83,0:14:14.63,Main,,0,0,0,,Beni geçmek istiyorsan, cesedimi çiğnemelisin!Dialogue: 0,0:14:15.21,0:14:17.35,Main,,0,0,0,,Hasır Şapkalı Luffy!Dialogue: 0,0:14:19.35,0:14:22.84,Main,,0,0,0,,Bu sizin...Dialogue: 0,0:14:23.73,0:14:26.89,Main,,0,0,0,,...seçtiğiniz yol!Dialogue: 0,0:14:32.21,0:14:36.95,Main,,0,0,0,,Bir şey yap, Hasır Şapkalı çocuk! Hızlı davranmazsan, köprü çökecek!Dialogue: 0,0:14:36.95,0:14:38.66,Main,,0,0,0,,Hasır Şapka!Dialogue: 0,0:14:39.24,0:14:40.56,Main,,0,0,0,,Luffy-kun!Dialogue: 0,0:14:54.05,0:14:55.19,Flashbacks,,0,0,0,,Pislik!Dialogue: 0,0:15:02.47,0:15:03.64,Flashbacks,,0,0,0,,Dede!Dialogue: 0,0:15:03.64,0:15:08.42,Flashbacks,,0,0,0,,Niye bunlarla dövüşmek zorundayım?Dialogue: 0,0:15:13.84,0:15:15.23,Flashbacks,,0,0,0,,Eğitim.Dialogue: 0,0:15:15.23,0:15:16.87,Flashbacks,,0,0,0,,Eğitim?Dialogue: 0,0:15:17.50,0:15:21.16,Flashbacks,,0,0,0,,Ama acıktım ve vurulmaktan bıktım!Dialogue: 0,0:15:24.04,0:15:26.03,Flashbacks,,0,0,0,,Yumuşak olma!Dialogue: 0,0:15:26.03,0:15:29.28,Flashbacks,,0,0,0,,Bir gün dünyanın en güçlü Denizcisi olacaksın!Dialogue: 0,0:15:29.83,0:15:33.64,Flashbacks,,0,0,0,,Denizci olmayacağım. Korsan olacağım!Dialogue: 0,0:15:36.40,0:15:39.97,Flashbacks,,0,0,0,,Ne? Aptallaşma!Dialogue: 0,0:15:39.97,0:15:41.87,Flashbacks,,0,0,0,,Ah!Dialogue: 0,0:15:41.87,0:15:45.56,Flashbacks,,0,0,0,,En çok dedemin yumrukları acıtıyor!Dialogue: 0,0:15:50.72,0:15:54.29,Main,,0,0,0,,Bunu yapamam dede! Lütfen çekil!Dialogue: 0,0:15:54.29,0:15:57.50,Main,,0,0,0,,Beni öldürmezsen, Ace ölecek!Dialogue: 0,0:15:57.50,0:15:59.18,Main,,0,0,0,,Olmaz!Dialogue: 0,0:15:59.18,0:16:03.77,Main,,0,0,0,,Ne kadar nefret etsen de bu olacak! Kendimi tutmayacağım!Dialogue: 0,0:16:04.84,0:16:06.80,Main,,0,0,0,,Luffy, şimdi seni...Dialogue: 0,0:16:07.90,0:16:11.71,Main,,0,0,0,,...düşmanım olarak görüyorum!Dialogue: 0,0:16:51.32,0:16:52.04,Main,,0,0,0,,Garp!Dialogue: 0,0:17:24.98,0:17:28.78,Flashbacks,,0,0,0,,Kahretsin! Neyim var benim?! Böyle bir zamanda...Dialogue: 0,0:17:29.43,0:17:33.10,Flashbacks,,0,0,0,,Babalık, kardeşim ve tayfam...Dialogue: 0,0:17:33.10,0:17:35.86,Flashbacks,,0,0,0,,...düşüyor ve yine de...Dialogue: 0,0:17:36.42,0:17:41.47,Flashbacks,,0,0,0,,Çok mutluyum... gözyaşlarım durmuyor...Dialogue: 0,0:17:41.87,0:17:46.04,Flashbacks,,0,0,0,,İş bu noktaya gelmişken bile yaşamak istiyorum.Dialogue: 0,0:17:56.05,0:17:57.96,Main,,0,0,0,,Koramiral Garp!Dialogue: 0,0:18:05.02,0:18:08.73,Main,,0,0,0,,Demek sonuçta aileyi oynuyorsun, Garp.Dialogue: 0,0:18:11.33,0:18:14.46,Main,,0,0,0,,Görünüşe göre idam sehpasına varacak.Dialogue: 0,0:18:15.76,0:18:19.34,Main,,0,0,0,,Onun pervasız süprüntünün teki olduğunu söylememiş miydin?Dialogue: 0,0:18:19.34,0:18:21.94,Main,,0,0,0,,Hala pervasız olduğunu düşünüyorum.Dialogue: 0,0:18:21.94,0:18:25.68,Main,,0,0,0,,Ace'i nasıl serbest bırakmayı planlıyor?Dialogue: 0,0:18:25.68,0:18:28.75,Main,,0,0,0,,Kaybol velet!Dialogue: 0,0:18:35.78,0:18:37.80,Main,,0,0,0,,Gardın düşmüştü.Dialogue: 0,0:18:37.80,0:18:39.95,Main,,0,0,0,,Babalık!Dialogue: 0,0:18:58.47,0:18:59.11,Flashbacks,,0,0,0,,Al bunu.Dialogue: 0,0:19:00.79,0:19:03.00,Flashbacks,,0,0,0,,Kardeşinin kelepçelerinin anahtarı.Dialogue: 0,0:19:03.41,0:19:05.32,Main,,0,0,0,,İşte anahtar.Dialogue: 0,0:19:06.86,0:19:08.68,Main,,0,0,0,,Luffy, sen...Dialogue: 0,0:19:33.50,0:19:35.45,Main,,0,0,0,,O da ne öyle?Dialogue: 0,0:19:38.06,0:19:41.67,Main,,0,0,0,,Bakın. Filo Amirali sengoku yeteneğini kullanıyor!Dialogue: 0,0:19:41.67,0:19:42.95,Main,,0,0,0,,İlk kez görüyorum!Dialogue: 0,0:19:42.95,0:19:47.00,Main,,0,0,0,,Kaçmana gerçekten izin vereceğimi mi sandın?Dialogue: 0,0:19:54.61,0:19:56.63,Main,,0,0,0,,Sengoku!Dialogue: 0,0:19:56.63,0:19:57.74,Main,,0,0,0,,Dev Buda?!Dialogue: 0,0:20:02.64,0:20:07.18,Main,,0,0,0,,Çok değerli bir şeyin varmış, Hasır Şapkalı Luffy.Dialogue: 0,0:20:09.98,0:20:11.32,Main,,0,0,0,,Anahtar!Dialogue: 0,0:20:11.32,0:20:12.55,Main,,0,0,0,,Nişan al!Dialogue: 0,0:20:13.59,0:20:16.28,Main,,0,0,0,,Pozisyonunuzu muhafaza edin ve her an ateşe hazır olun!Dialogue: 0,0:20:17.48,0:20:19.40,Main,,0,0,0,,Eyvah! Anahtar!Dialogue: 0,0:20:20.52,0:20:23.00,Main,,0,0,0,,Hasır Şapkalı Luffy...Dialogue: 0,0:20:23.00,0:20:26.10,Main,,0,0,0,,Sen de ölüm cezasına çarptırılmaya değecek namlı bir suçlusun.Dialogue: 0,0:20:27.36,0:20:33.00,Main,,0,0,0,,Kardeşler olarak, sizi kendim idam edeceğim!Dialogue: 0,0:20:40.19,0:20:44.05,Main,,0,0,0,,Ne oldu? Aniden bayılmışım.Dialogue: 0,0:20:47.00,0:20:49.09,Main,,0,0,0,,Hasır Şapka?Dialogue: 0,0:20:50.46,0:20:52.70,Main,,0,0,0,,Üç! Burada ne yapıyorsun?Dialogue: 0,0:21:00.60,0:21:02.53,Main,,0,0,0,,O da ne?!Dialogue: 0,0:21:03.03,0:21:05.64,Main,,0,0,0,,Hey, Üç... Ace'i duvarla koru!Dialogue: 0,0:21:05.64,0:21:07.83,Main,,0,0,0,,Gomu Gomu no...Dialogue: 0,0:21:09.65,0:21:12.49,Main,,0,0,0,,Dev Balon!Dialogue: 0,0:21:16.29,0:21:18.15,Main,,0,0,0,,Mum Duvar!Dialogue: 0,0:21:22.06,0:21:23.59,Main,,0,0,0,,Devasa oldu.Dialogue: 0,0:21:34.40,0:21:36.58,Main,,0,0,0,,İdam sehpası çöküyor!Dialogue: 0,0:21:36.58,0:21:37.84,Main,,0,0,0,,Ne oldu öyle?!Dialogue: 0,0:21:38.23,0:21:40.64,Main,,0,0,0,,Ace daha ölmedi!Dialogue: 0,0:21:40.64,0:21:42.65,Main,,0,0,0,,Düşüyoruz!Dialogue: 0,0:21:43.73,0:21:48.08,Main,,0,0,0,,Anahtar yapacağım! O kelepçeler hemen çıkacak!Dialogue: 0,0:21:48.96,0:21:50.28,Main,,0,0,0,,Tamam!Dialogue: 0,0:21:50.28,0:21:53.51,Main,,0,0,0,,Kaptan Buggy! Bu Üç Kardeş!Dialogue: 0,0:21:53.51,0:21:58.05,Main,,0,0,0,,Ne?! O kostümle eğlenerek ne yaptığını sanıyor?!Dialogue: 0,0:21:58.59,0:22:01.37,Main,,0,0,0,,Uzun zaman önce kaçmadı mı?Dialogue: 0,0:22:05.99,0:22:09.66,Main,,0,0,0,,Diğeri daha gelmedi mi? Neden bu kadar uzun sürdü?!Dialogue: 0,0:22:09.66,0:22:13.57,Main,,0,0,0,,Ani emir değişikliği yüzünden hazırlanması biraz zaman alıyor.Dialogue: 0,0:22:13.57,0:22:15.82,Main,,0,0,0,,Hey, acele et!Dialogue: 0,0:22:15.82,0:22:17.49,Main,,0,0,0,,Tamam, gidelim!Dialogue: 0,0:22:25.08,0:22:31.57,Main,,0,0,0,,Son kardeşimin isteğini onurlandırmak için burada olduğumu söyleseydim,...Dialogue: 0,0:22:31.57,0:22:34.43,Main,,0,0,0,,...bana güler miydin?Dialogue: 0,0:22:35.29,0:22:37.48,Main,,0,0,0,,Asla gülmezdim!Dialogue: 0,0:22:37.48,0:22:41.19,Main,,0,0,0,,Ateş! İdam sehpasıyla birlikte her şeyi havaya uçurun!Dialogue: 0,0:22:43.52,0:22:45.62,Main,,0,0,0,,Abini kurtar, Hasır Şapka!Dialogue: 0,0:22:46.02,0:22:47.34,Main,,0,0,0,,Tamam!Dialogue: 0,0:22:48.90,0:22:50.25,Main,,0,0,0,,Olamaz!Dialogue: 0,0:23:01.54,0:23:03.24,Main,,0,0,0,,Hasır Şapkalı çocuk!Dialogue: 0,0:23:03.24,0:23:04.50,Main,,0,0,0,,Olamaz!Dialogue: 0,0:23:04.50,0:23:06.88,Main,,0,0,0,,Ace!Dialogue: 0,0:23:09.11,0:23:10.75,Main,,0,0,0,,Üç Kardeş!Dialogue: 0,0:23:10.75,0:23:12.98,Main,,0,0,0,,Üçü de vuruldu!Dialogue: 0,0:23:13.83,0:23:17.35,Main,,0,0,0,,Deniztaşı kelepçeler, Ateş Yumruk'un bedenini zarar görür hâle getiriyor!Dialogue: 0,0:23:17.35,0:23:18.70,Main,,0,0,0,,Ölmüş olmalı!Dialogue: 0,0:23:18.70,0:23:21.23,Main,,0,0,0,,Hiç şüphesiz Hasır Şapka da...Dialogue: 0,0:23:36.93,0:23:40.28,Main,,0,0,0,,Dumandan ateş tüneli çıkıyor!Dialogue: 0,0:23:41.05,0:23:43.54,Main,,0,0,0,,Hiç değişmiyorsun,...Dialogue: 0,0:23:43.88,0:23:45.40,Main,,0,0,0,,...Luffy!Dialogue: 0,0:23:48.66,0:23:51.35,Main,,0,0,0,,Söylediğim tek kelimeyi dinlemiyorsun.Dialogue: 0,0:23:56.37,0:23:59.97,Main,,0,0,0,,Her zaman en aptalca şeyleri yapıyorsun.Dialogue: 0,0:24:01.35,0:24:02.40,Main,,0,0,0,,İyi iş!Dialogue: 0,0:24:02.40,0:24:03.25,Main,,0,0,0,,Hele şükür!Dialogue: 0,0:24:03.25,0:24:05.58,Main,,0,0,0,,Ace!Dialogue: 0,0:24:05.58,0:24:08.28,Main,,0,0,0,,İ-İnanılmaz!Dialogue: 0,0:24:08.28,0:24:11.34,Main,,0,0,0,,Hasır Şapka ve Üç Kardeş...Dialogue: 0,0:24:21.89,0:24:25.38,Main,,0,0,0,,Ace!Dialogue: 0,0:00:25.37,0:00:30.41,OP13-Credits,,0,0,0,,Editing SewilDialogue: 0,0:00:30.41,0:00:36.22,OP13-Credits,,0,0,0,,Quality Control Galaxy 9000 PepperjackDialogue: 0,0:00:36.22,0:00:41.19,OP13-Credits,,0,0,0,,Timing KaitouYahikoDialogue: 0,0:00:41.19,0:00:46.93,OP13-Credits,,0,0,0,,Translation YibisDialogue: 0,0:00:46.93,0:00:52.36,OP13-Credits,,0,0,0,,Visual Effects Datenshi KaitouYahikoDialogue: 0,0:00:52.36,0:00:57.44,OP13-Credits,,0,0,0,,Graphics DatenshiDialogue: 0,0:00:57.44,0:01:03.08,OP13-Credits,,0,0,0,,Karaoke KaitouYahikoDialogue: 0,0:01:03.08,0:01:06.56,OP13-Credits,,0,0,0,,Soundtracking HaleeDialogue: 0,0:01:06.56,0:01:08.68,OP13-Credits,,0,0,0,,Raws cloaknsmokeDialogue: 0,0:00:25.37,0:00:30.62,OP13-Translation,,0,0,0,karaoke,♪ Her seferinde yağmurdan sonra gökyüzüne bakıyorum. ♪Dialogue: 0,0:00:30.62,0:00:36.13,OP13-Translation,,0,0,0,karaoke,♪ Henüz sulugöz olduğum zamanları düşünüyorum. ♪Dialogue: 0,0:00:36.13,0:00:43.87,OP13-Translation,,0,0,0,karaoke,♪ Umutsuzca birinin arkasından koşuyorum,... ♪Dialogue: 0,0:00:43.94,0:00:46.85,OP13-Translation,,0,0,0,karaoke,♪ ..."Daha güçlü olmak istiyorum," diye düşünerek. ♪Dialogue: 0,0:00:46.85,0:00:52.03,OP13-Translation,,0,0,0,karaoke,♪ "Teşekkürüm" şimdi rüzgârda kayboldu,... ♪Dialogue: 0,0:00:52.20,0:00:57.21,OP13-Translation,,0,0,0,karaoke,♪ ...daha güçlü olabilir miyim? ♪Dialogue: 0,0:00:57.41,0:01:02.88,OP13-Translation,,0,0,0,karaoke,♪ Cevabımı bulamıyorum. ♪Dialogue: 0,0:01:03.01,0:01:08.40,OP13-Translation,,0,0,0,karaoke,♪ Bu yüzden ilerlemeye devam edeceğim. ♪Dialogue: 0,0:01:08.55,0:01:11.03,OP13-Translation,,0,0,0,karaoke,♪ Gel hadi, gidelim. ♪Dialogue: 0,0:01:11.03,0:01:14.24,OP13-Translation,,0,0,0,karaoke,♪ Asla pes etmeyeceğiz. ♪Dialogue: 0,0:01:14.24,0:01:19.48,OP13-Translation,,0,0,0,karaoke,♪ Zamanın dalgalarına yenik düşmeyeceğiz. ♪Dialogue: 0,0:01:19.48,0:01:25.09,OP13-Translation,,0,0,0,karaoke,♪ Tekrar tekrar ayağa kalkacağız. ♪Dialogue: 0,0:01:25.10,0:01:30.73,OP13-Translation,,0,0,0,karaoke,♪ Çünkü bizim için önemli olanı kaybetmek istemiyoruz. ♪Dialogue: 0,0:01:30.74,0:01:35.85,OP13-Translation,,0,0,0,karaoke,♪ Beni sürekli, sürekli ilerlemeye zorlayan... ♪Dialogue: 0,0:01:35.86,0:01:41.25,OP13-Translation,,0,0,0,karaoke,♪ ...kafamdaki sesi duyabiliyorum. ♪Dialogue: 0,0:01:41.25,0:01:46.38,OP13-Translation,,0,0,0,karaoke,♪ Haylaz yağmur bana engel olurken bile... ♪Dialogue: 0,0:01:46.39,0:01:51.32,OP13-Translation,,0,0,0,karaoke,♪ ...kaçmaya çalışmayacağım. ♪Dialogue: 0,0:01:54.42,0:01:56.78,OP13-Translation,,0,0,0,karaoke,♪ Gel hadi, gidelim. ♪Dialogue: 0,0:01:56.78,0:02:00.06,OP13-Translation,,0,0,0,karaoke,♪ Asla pes etmeyeceğiz. ♪Dialogue: 0,0:02:00.06,0:02:05.35,OP13-Translation,,0,0,0,karaoke,♪ Zamanın dalgalarına yenik düşmeyeceğiz. ♪Dialogue: 0,0:02:05.36,0:02:10.99,OP13-Translation,,0,0,0,karaoke,♪ Tekrar tekrar ayağa kalkacağız. ♪Dialogue: 0,0:02:10.99,0:02:16.35,OP13-Translation,,0,0,0,karaoke,♪ Çünkü bizim için önemli olanı kaybetmek istemiyoruz. ♪Dialogue: 0,0:02:16.36,0:02:22.05,OP13-Translation,,0,0,0,karaoke,♪ İnandığımız geleceğe doğru ilerleyelim. ♪