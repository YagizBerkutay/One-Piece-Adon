Dialogue: 0,0:02:31.28,0:02:39.89,Title,,0,0,240,,{\fad(1200,1300)}Dünyayı Sarsan Adam
Dialogue: 0,0:03:19.09,0:03:20.91,Main,,0,0,0,,Beyazsakala...
Dialogue: 0,0:03:21.19,0:03:24.32,Main,,0,0,0,,Beyazsakala kılıç saplandı!
Dialogue: 0,0:03:34.51,0:03:35.33,Main,,0,0,0,,Yaşlı adam...
Dialogue: 0,0:03:36.64,0:03:38.65,Main,,0,0,0,,Kim yaptı?!
Dialogue: 0,0:03:38.65,0:03:40.23,Main,,0,0,0,,Sanırım o...
Dialogue: 0,0:03:41.32,0:03:44.88,Main,,0,0,0,,Ona saldıran, Beyazsakal\Nmüttefiklerinin kaptanlarından...
Dialogue: 0,0:03:44.88,0:03:47.21,Main,,0,0,0,,...Yeni Dünya Korsanları'ndan\Nbiri, Girdap Örümcek...
Dialogue: 0,0:03:47.21,0:03:48.91,Main,,0,0,0,,...Squardo!
Dialogue: 0,0:03:50.22,0:03:52.45,Main,,0,0,0,,Niye böyle bir şey yaptın?!
Dialogue: 0,0:03:52.45,0:03:53.81,Main,,0,0,0,,Cevap ver, Squardo!
Dialogue: 0,0:03:53.81,0:03:57.58,Main,,0,0,0,,K-Kapa çeneni! Elimi zorlayan sizdiniz!
Dialogue: 0,0:03:57.58,0:04:01.39,Main,,0,0,0,,Ne?! Ne yaptığın hakkında bir fikrin...
Dialogue: 0,0:04:04.63,0:04:07.76,Main,,0,0,0,,Babalık! Bedenini bu şekilde\Nzorlamaya devam edersen...
Dialogue: 0,0:04:07.76,0:04:09.04,Main,,0,0,0,,Babalık!
Dialogue: 0,0:04:13.44,0:04:17.13,Main,,0,0,0,,Maskaralığı bırak, Beyazsakal!
Dialogue: 0,0:04:18.10,0:04:21.09,Main,,0,0,0,,Denizcilerle bir anlaşma yaptın, değil mi?!
Dialogue: 0,0:04:21.09,0:04:27.24,Main,,0,0,0,,Beyazsakal Korsanları'nın ve Ace'in bu işten\Nsağ çıkacağını garantileyecek bir anlaşma!
Dialogue: 0,0:04:28.92,0:04:32.55,Main,,0,0,0,,Squardo neden bahsediyor?
Dialogue: 0,0:04:32.55,0:04:33.59,Main,,0,0,0,,Neler oluyor?!
Dialogue: 0,0:04:33.94,0:04:37.49,Main,,0,0,0,,Hepimizi tuzağa çekti!
Dialogue: 0,0:04:38.69,0:04:41.11,Main,,0,0,0,,Hiçbir fikrim yoktu.
Dialogue: 0,0:04:42.00,0:04:47.38,Main,,0,0,0,,Ama Ace, Gold Roger'ın oğlu!
Dialogue: 0,0:04:47.95,0:04:53.48,Main,,0,0,0,,Beni bulduğunda yapayalnızdım.
Dialogue: 0,0:04:58.52,0:05:00.91,Main,,0,0,0,,Squardo yine olay çıkarıyor!
Dialogue: 0,0:05:04.86,0:05:07.74,Flashbacks,,0,0,0,,Buradaki herkes güçsüz mü?
Dialogue: 0,0:05:07.74,0:05:09.95,Flashbacks,,0,0,0,,Bana gelin!
Dialogue: 0,0:05:10.44,0:05:12.96,Flashbacks,,0,0,0,,Bana Gold Roger'ı getirin!
Dialogue: 0,0:05:14.04,0:05:16.75,Flashbacks,,0,0,0,,Ne oldu? Cesaretiniz mi kayboldu?!
Dialogue: 0,0:05:17.85,0:05:19.67,Flashbacks,,0,0,0,,Ne oldu beyler?!
Dialogue: 0,0:05:24.71,0:05:27.81,Main,,0,0,0,,Niye yapayalnız olduğumu bildiğine eminim.
Dialogue: 0,0:05:33.85,0:05:37.54,Main,,0,0,0,,Çünkü uzun zamandır omuz omuza\Ndövüştüğüm, üstüne titrediğim yoldaşlarım...
Dialogue: 0,0:05:37.54,0:05:40.51,Main,,0,0,0,,...Roger tarafından öldürülmüştü!
Dialogue: 0,0:05:41.17,0:05:46.63,Main,,0,0,0,,Roger'a olan öfkemi bildiğine eminim!
Dialogue: 0,0:05:46.63,0:05:51.73,Main,,0,0,0,,En azından Ace'in, Roger'ın oğlu\Nolduğunu söylemeliydin.
Dialogue: 0,0:05:51.73,0:05:56.14,Main,,0,0,0,,Ace'i Korsanlar Kralı yapma\Nplanlarından bana bahsetmeliydin!
Dialogue: 0,0:05:56.14,0:05:58.60,Main,,0,0,0,,Beyazsakal Korsanları'nı boşverin!
Dialogue: 0,0:05:58.60,0:06:01.04,Main,,0,0,0,,İlerleyin, meydana geri çekilin!
Dialogue: 0,0:06:01.04,0:06:03.78,Main,,0,0,0,,Yaşlı adam, Ace'i Korsanlar\NKralı mı yapmak istiyor?
Dialogue: 0,0:06:04.25,0:06:08.02,Flashbacks,,0,0,0,,Beyazsakal tanıdığım en güçlü korsan.
Dialogue: 0,0:06:08.02,0:06:11.98,Flashbacks,,0,0,0,,Onu Korsanlar Kralı yapmak istiyorum.
Dialogue: 0,0:06:17.73,0:06:22.19,Main,,0,0,0,,O zaman bile bana zaten ihanet etmiştin!
Dialogue: 0,0:06:22.60,0:06:28.17,Main,,0,0,0,,Benimle nasıl alay ettiğini farkettirmeden,\Nonunla arkadaş olmama izin verdin!
Dialogue: 0,0:06:28.17,0:06:33.10,Main,,0,0,0,,Sonra altın çocuğun Ace yakalandı!
Dialogue: 0,0:06:33.10,0:06:37.16,Captions,,0,0,0,,{\fs30\pos(891.667,515)\fad(0,150)}Müttefik Gemiler
Dialogue: 0,0:06:33.10,0:06:37.16,Captions,,0,0,0,,{\fs30\pos(636.666,603.333)\fad(0,150)}İnsan Silahlar
Dialogue: 0,0:06:33.10,0:06:37.16,Captions,,0,0,0,,{\fs30\pos(368.333,513.333)\fad(0,150)}Müttefik Gemiler
Dialogue: 0,0:06:33.10,0:06:36.19,Main,,0,0,0,,Müttefik tayfalar kıyı boyundayken,...
Dialogue: 0,0:06:36.19,0:06:39.60,Main,,0,0,0,,...Beyazsakal Korsanları koyun içinde.
Dialogue: 0,0:06:39.60,0:06:44.68,Main,,0,0,0,,Ace'in canına karşılık, müttefik 43 kaptanının...
Dialogue: 0,0:06:44.68,0:06:47.22,Main,,0,0,0,,...canını verdin!
Dialogue: 0,0:06:47.74,0:06:52.62,Main,,0,0,0,,Ace ve Beyazsakal Korsanları bağışlanırken,\Nmüttefik tayfalar infaz edilecek!
Dialogue: 0,0:06:52.62,0:06:56.23,Main,,0,0,0,,Sen ve Sengoku çoktan\Nbu konuda anlaştınız, değil mi?!
Dialogue: 0,0:06:58.78,0:07:01.95,Main,,0,0,0,,Ciddi olamazsın! Ace, Roger'ın oğlu mu?!
Dialogue: 0,0:07:09.09,0:07:11.43,Main,,0,0,0,,Hala anlamıyor musun?
Dialogue: 0,0:07:11.43,0:07:14.18,Main,,0,0,0,,Çok yakında tükürdüğünü yalayacaksın.
Dialogue: 0,0:07:14.18,0:07:16.55,Main,,0,0,0,,Yalan söylediğimi düşünüyorsan, iyi izle!
Dialogue: 0,0:07:19.38,0:07:25.56,Main,,0,0,0,,Başlamak üzere olan saldırının tek\Nhedefi müttefik tayfalar olacak!
Dialogue: 0,0:07:26.35,0:07:31.13,Main,,0,0,0,,Denizciler, Beyazsakal Korsanları'na\Nsaldırmamayı kabul etti!
Dialogue: 0,0:07:32.07,0:07:38.45,Main,,0,0,0,,Peki biz ne biliyoruz?\NKandırmacanın farkında olmadan...
Dialogue: 0,0:07:38.45,0:07:41.04,Main,,0,0,0,,...Ace'in ve Beyazsakal'ın\Nuğruna canımızı vermeye geldik!
Dialogue: 0,0:07:41.04,0:07:42.14,Main,,0,0,0,,Kendin gör!
Dialogue: 0,0:07:44.81,0:07:49.05,Main,,0,0,0,,Onun dediği gibi, Denizciler sadece bize saldırıyor!
Dialogue: 0,0:07:51.12,0:07:58.29,Captions,,0,0,0,,{\fs30\pos(628.333,403.333)}Beyazsakal
Dialogue: 0,0:07:51.47,0:07:53.79,Main,,0,0,0,,Canavarlar arkadan geliyor,...
Dialogue: 0,0:07:53.79,0:07:58.31,Main,,0,0,0,,...sağ ve sol kanatlar buz duvarlarla\Nengellenmiş, yani kaçış yok!
Dialogue: 0,0:08:00.17,0:08:03.90,Main,,0,0,0,,Babalık! Bu doğru mu?!
Dialogue: 0,0:08:03.90,0:08:06.63,Main,,0,0,0,,Lütfen yalan de, Babalık!
Dialogue: 0,0:08:13.91,0:08:16.71,Main,,0,0,0,,Gerçekte sana bir kez bile vurmam bir mucize.
Dialogue: 0,0:08:17.92,0:08:20.16,Main,,0,0,0,,Hazırım.
Dialogue: 0,0:08:20.16,0:08:21.15,Main,,0,0,0,,Öldür beni!
Dialogue: 0,0:08:27.55,0:08:31.32,Main,,0,0,0,,Tek hedefleri bizmişiz gibi görünüyor!
Dialogue: 0,0:08:34.70,0:08:36.19,Main,,0,0,0,,Kaçın!
Dialogue: 0,0:08:39.96,0:08:43.80,Main,,0,0,0,,Babalık! Gerçekten Ace'in hayatına karşılık...
Dialogue: 0,0:08:43.80,0:08:46.44,Main,,0,0,0,,...bizi sattın mı?!
Dialogue: 0,0:08:46.92,0:08:49.65,Main,,0,0,0,,Bir şey söyle! Babalık!
Dialogue: 0,0:08:50.06,0:08:53.70,Main,,0,0,0,,Babalık! Babalık!
Dialogue: 0,0:09:09.63,0:09:12.11,Main,,0,0,0,,Olamaz! Bir tür hata olmalı!
Dialogue: 0,0:09:12.11,0:09:14.21,Main,,0,0,0,,Beyazsakal, Denizcilerle anlaşma mı yapıyor?
Dialogue: 0,0:09:14.21,0:09:15.66,Main,,0,0,0,,Tayfasına ihanet mi ediyor?
Dialogue: 0,0:09:15.66,0:09:18.00,Main,,0,0,0,,Bu anlaşılmaz bir şey!\NBahsettiğimiz kişi Beyazsakal!
Dialogue: 0,0:09:18.00,0:09:20.49,Main,,0,0,0,,Beyazsakal ve Denizciler anlaşma mı yapmış?!
Dialogue: 0,0:09:20.49,0:09:23.66,Main,,0,0,0,,Yani Beyazsakal'a güvenen ve\Nonun yanında çarpışan korsanlar...
Dialogue: 0,0:09:23.66,0:09:27.51,Main,,0,0,0,,...ihanete mi uğradılar? Denizciler\Ntarafından yok mu edilecekler?
Dialogue: 0,0:09:27.51,0:09:31.02,Main,,0,0,0,,İnanmak istemedim. Kendi gözlerimden şüphe ettim!
Dialogue: 0,0:09:31.02,0:09:33.45,Main,,0,0,0,,Bize nasıl ihanet edersin, Babalık?!
Dialogue: 0,0:09:33.45,0:09:35.14,Main,,0,0,0,,Aptal!
Dialogue: 0,0:09:35.77,0:09:37.64,Main,,0,0,0,,Seni himayesine alan oydu, Squardo!
Dialogue: 0,0:09:37.64,0:09:39.70,Main,,0,0,0,,Niye Babalık'a inanmadın?!
Dialogue: 0,0:09:39.70,0:09:43.15,Main,,0,0,0,,Bunu söyleme hakkın yok, Marco!
Dialogue: 0,0:09:43.15,0:09:45.77,Main,,0,0,0,,Sen Birinci Bölüm Kumandanısın!
Dialogue: 0,0:09:45.77,0:09:51.49,Main,,0,0,0,,Ace ya da Denizcilerle yapılan anlaşma hakkında\Nbir şey bilmediğini duymak istemiyorum!
Dialogue: 0,0:09:51.94,0:09:56.83,Main,,0,0,0,,Ace'in Roger'ın oğlu olduğu doğru.
Dialogue: 0,0:09:56.83,0:10:01.65,Main,,0,0,0,,Demek bunu duymaktan en fazla zarar görecek\Nolan kişiyi bulup, bize karşı döndürdüler.
Dialogue: 0,0:10:02.43,0:10:08.21,Main,,0,0,0,,Planları benimkinden bir adım öndeydi.
Dialogue: 0,0:10:08.55,0:10:10.70,Main,,0,0,0,,Bu kadarı yeter.
Dialogue: 0,0:10:10.70,0:10:11.39,Main,,0,0,0,,Aokiji!
Dialogue: 0,0:10:14.64,0:10:16.36,Main,,0,0,0,,{\i1}Niye buraya geliyor?!{\i}
Dialogue: 0,0:10:16.85,0:10:18.78,Main,,0,0,0,,Yani tüm savaş en başından ayarlanmış mıydı?!
Dialogue: 0,0:10:18.78,0:10:20.87,Main,,0,0,0,,O zaman şu ana kadar ki\Ndövüşün ne manası vardı?!
Dialogue: 0,0:10:20.87,0:10:23.16,Main,,0,0,0,,Bunun anlamı hiçbiri kazanamayacak mı?!
Dialogue: 0,0:10:25.19,0:10:26.02,Main,,0,0,0,,Yayın kesildi!
Dialogue: 0,0:10:26.02,0:10:27.06,Main,,0,0,0,,Neler oluyor?!
Dialogue: 0,0:10:27.06,0:10:28.21,Main,,0,0,0,,Kırıldı mı?
Dialogue: 0,0:10:34.38,0:10:36.68,Main,,0,0,0,,Duvarları harekete geçirin!
Dialogue: 0,0:10:46.18,0:10:52.56,Main,,0,0,0,,Pislik... Kendi müttefiklerinden\Nbiri tarafından kolayca vuruldu!
Dialogue: 0,0:10:53.06,0:10:56.17,Main,,0,0,0,,Tam bir yüz karasısın, Beyazsakal!
Dialogue: 0,0:10:56.17,0:11:01.01,Main,,0,0,0,,Bu kadar güçsüz bir adama yenildiğimi bilmiyordum!
Dialogue: 0,0:11:05.49,0:11:06.88,Main,,0,0,0,,Croco-çocuk...
Dialogue: 0,0:11:07.42,0:11:08.68,Main,,0,0,0,,Crocodile...
Dialogue: 0,0:11:13.96,0:11:20.05,Thoughts,,0,0,0,,{\i1}Evet, doğru... Geçmişte, bu gibi\Nsaldırıları hep atlatabilirdin.{\i0}
Dialogue: 0,0:11:20.05,0:11:25.36,Thoughts,,0,0,0,,{\i1}Yaralı ya da bitkin olsun, hatta\Nkendi adamlarından birinden olsun...{\i0}
Dialogue: 0,0:11:25.36,0:11:29.37,Thoughts,,0,0,0,,{\i1}...hiç böyle bir saldırıyla vurulmamıştın\Nve beni rahatsız eden bu!{\i0}
Dialogue: 0,0:11:31.34,0:11:36.06,Flashbacks,,0,0,0,,Düşman benim için üzülsün falan diye mi\Nbu şeyleri takmamı istiyorsunuz?
Dialogue: 0,0:11:36.06,0:11:36.94,Flashbacks,,0,0,0,,Babalık!
Dialogue: 0,0:11:36.94,0:11:39.61,Thoughts,,0,0,0,,Sağlığın kötüleşiyor.
Dialogue: 0,0:11:53.39,0:11:57.20,Main,,0,0,0,,Ne yaptığını farkediyorsun, değil mi,...
Dialogue: 0,0:11:57.20,0:11:58.91,Main,,0,0,0,,...Squardo?
Dialogue: 0,0:12:00.20,0:12:04.70,Main,,0,0,0,,Kılıcını kendi babana çevirdin.
Dialogue: 0,0:12:04.70,0:12:07.84,Main,,0,0,0,,Seni ahmak evlat!
Dialogue: 0,0:12:20.59,0:12:25.09,Main,,0,0,0,,Ahmak olsan da, seni hala seviyorum oğlum.
Dialogue: 0,0:12:28.06,0:12:32.63,Main,,0,0,0,,Beni... kandırmaya çalışma...
Dialogue: 0,0:12:32.63,0:12:36.15,Main,,0,0,0,,Sen... kendi yoldaşlarını...
Dialogue: 0,0:12:36.15,0:12:44.45,Main,,0,0,0,,Senin temiz, sadık kalbini kim\Nböyle bir karanlığa sürükledi?
Dialogue: 0,0:12:45.42,0:12:49.17,Main,,0,0,0,,Denizci asinin teki.
Dialogue: 0,0:12:50.90,0:12:54.79,Main,,0,0,0,,Bu plana karşıyım.
Dialogue: 0,0:12:54.79,0:12:57.83,Main,,0,0,0,,Bu savaşta vurman gereken kişi Beyazsakal.
Dialogue: 0,0:12:57.83,0:13:01.13,Main,,0,0,0,,Başkasını hedef almak ölümcül bir hata olurdu.
Dialogue: 0,0:13:01.13,0:13:06.03,Main,,0,0,0,,Benimle işbirliği yaparsan,\Nmüttefik korsanları kurtarırım.
Dialogue: 0,0:13:07.54,0:13:09.97,Main,,0,0,0,,Beyazsakal'ı öldür.
Dialogue: 0,0:13:14.99,0:13:19.28,Main,,0,0,0,,Seni öldürürsem, müttefik\Nkorsanları kurtaracağını söyledi.
Dialogue: 0,0:13:19.98,0:13:23.05,Main,,0,0,0,,Demek Akainu böyle dedi.
Dialogue: 0,0:13:23.05,0:13:30.17,Main,,0,0,0,,Roger'dan ne kadar nefret ettiğini\Nacı verici biçimde fark ediyorum.
Dialogue: 0,0:13:30.69,0:13:32.98,Main,,0,0,0,,Ama Squardo...
Dialogue: 0,0:13:32.98,0:13:37.08,Main,,0,0,0,,Babasının günahlarından ötürü\Nbir çocuğa kızmak yanlış.
Dialogue: 0,0:13:37.08,0:13:39.73,Main,,0,0,0,,Ace sana ne yaptı ki?
Dialogue: 0,0:13:40.30,0:13:46.34,Main,,0,0,0,,Ace'le birlikte bir sürü acı,\Nneşe ve zorluk yaşadınız.
Dialogue: 0,0:13:46.34,0:13:52.15,Main,,0,0,0,,Her seferinde yanınızda arkadaşlarınız vardı.
Dialogue: 0,0:13:52.15,0:13:55.58,Main,,0,0,0,,Ace'in ailesinin kim olduğu önemli değil.
Dialogue: 0,0:13:55.58,0:13:59.27,Main,,0,0,0,,Bu büyük, engin okyanusta\Nkarşılaşma şansımız var.
Dialogue: 0,0:13:59.27,0:14:05.37,Main,,0,0,0,,Sadece ikiniz değil. Hepiniz oğlumsunuz.
Dialogue: 0,0:14:05.37,0:14:09.62,Main,,0,0,0,,Squardo, geçinmeye çalış.
Dialogue: 0,0:14:09.62,0:14:13.54,Main,,0,0,0,,Ace'in özel bir durum olduğunu sanma.
Dialogue: 0,0:14:13.54,0:14:17.37,Main,,0,0,0,,Hepiniz ailemsiniz.
Dialogue: 0,0:14:27.08,0:14:30.02,Main,,0,0,0,,Yine de...
Dialogue: 0,0:14:32.43,0:14:34.67,Main,,0,0,0,,...gerçekten...
Dialogue: 0,0:14:37.33,0:14:40.42,Main,,0,0,0,,...değişmemişsin, Sengoku.
Dialogue: 0,0:14:40.42,0:14:45.26,Main,,0,0,0,,Onu cidden kandırdın.
Dialogue: 0,0:14:46.04,0:14:50.40,Main,,0,0,0,,Ben, oğullarımın hayatlarını mı satıyorum?!
Dialogue: 0,0:15:03.88,0:15:07.69,Main,,0,0,0,,Demek korsanlara kaçış yolu açtı.
Dialogue: 0,0:15:07.69,0:15:09.19,Main,,0,0,0,,Onu bu kadar hafife almamalıydım.
Dialogue: 0,0:15:14.98,0:15:17.32,Main,,0,0,0,,Buz duvarı gitti.
Dialogue: 0,0:15:17.32,0:15:19.27,Main,,0,0,0,,Savaş gemilerine el koyabiliriz!
Dialogue: 0,0:15:19.27,0:15:21.70,Main,,0,0,0,,Şimdi ne zaman istersek kaçabiliriz!
Dialogue: 0,0:15:24.40,0:15:30.34,Main,,0,0,0,,{\i1}Korsansanız, neye inanmak\Nistediğinize kendiniz karar verin!{\i}
Dialogue: 0,0:15:39.82,0:15:43.55,Main,,0,0,0,,Gerçekten yalanmış! \NTüm bunları Denizciler planlamış!
Dialogue: 0,0:15:43.55,0:15:45.39,Main,,0,0,0,,Lanet olsun! Hepimizi kandırdılar!
Dialogue: 0,0:15:45.39,0:15:48.90,Main,,0,0,0,,Babalık'ın bize ihanet etmesi mümkün değil!
Dialogue: 0,0:15:48.90,0:15:52.43,Main,,0,0,0,,Affet beni! Bir daha senden asla\Nşüphe etmeyeceğim, Babalık!
Dialogue: 0,0:15:52.43,0:15:55.02,Main,,0,0,0,,Ben de, Babalık! Lütfen beni affet!
Dialogue: 0,0:15:55.02,0:15:57.17,Main,,0,0,0,,Babalık! Sonuna dek seni izleyeceğim!
Dialogue: 0,0:15:57.17,0:15:58.15,Main,,0,0,0,,Babalık!
Dialogue: 0,0:15:58.54,0:16:03.60,Thoughts,,0,0,0,,Güçsüz bir adam mı diyorsun?\NBeni rahat bırak, timsah adam!
Dialogue: 0,0:16:03.60,0:16:09.31,Thoughts,,0,0,0,,Ben sadece tek kalbi olan tek bir adamım.
Dialogue: 0,0:16:09.31,0:16:12.48,Thoughts,,0,0,0,,Bana şeytan, canavar ya da\Nher ne isterlerse diyebilirler,...
Dialogue: 0,0:16:12.48,0:16:16.19,Thoughts,,0,0,0,,...ama sonsuza dek en güçlü olmayacağım.
Dialogue: 0,0:16:16.19,0:16:19.02,Thoughts,,0,0,0,,Bir tek genç hayatın geleceğe\Nyükselmesine yardım edebilirsem,...
Dialogue: 0,0:16:19.02,0:16:22.83,Thoughts,,0,0,0,,...benim için yeterli olacak.
Dialogue: 0,0:16:23.24,0:16:27.06,Main,,0,0,0,,Benimle birlikte gelmek isteyenler,\Ncanlarınız pahasına peşimden gelin!
Dialogue: 0,0:16:27.06,0:16:35.31,Main,,0,0,0,,Tamam!
Dialogue: 0,0:16:38.11,0:16:43.63,Main,,0,0,0,,Saldırın! Dünyadaki en güçlü adam harekete geçti!
Dialogue: 0,0:16:46.63,0:16:48.90,Main,,0,0,0,,Gidelim!
Dialogue: 0,0:16:48.90,0:16:50.96,Main,,0,0,0,,Tamam!
Dialogue: 0,0:16:50.96,0:16:52.86,Main,,0,0,0,,İlerlemelerine izin vermeyin!
Dialogue: 0,0:16:52.86,0:16:54.03,Main,,0,0,0,,Ateş!
Dialogue: 0,0:16:55.78,0:16:57.46,Main,,0,0,0,,Babalığın söylediği gibi yapın!
Dialogue: 0,0:16:57.46,0:16:59.30,Main,,0,0,0,,Babalık için yol açın!
Dialogue: 0,0:17:21.39,0:17:22.26,Main,,0,0,0,,Beyazsakal...
Dialogue: 0,0:17:35.23,0:17:37.40,Main,,0,0,0,,Squardo...
Dialogue: 0,0:17:37.40,0:17:41.06,Main,,0,0,0,,Denizciler onu Babalık'ın\Npeşinden gitmesi için kandırdı!
Dialogue: 0,0:17:41.06,0:17:43.51,Main,,0,0,0,,Ne kadar aptal olabilirsin?!
Dialogue: 0,0:17:43.77,0:17:47.68,Main,,0,0,0,,Şimdi kendisini ne kadar\Nkötü hissediyor olmalı?!
Dialogue: 0,0:17:48.73,0:17:51.00,Main,,0,0,0,,Ama o zaman...
Dialogue: 0,0:17:52.81,0:17:54.66,Main,,0,0,0,,...ben...
Dialogue: 0,0:17:55.76,0:17:57.60,Main,,0,0,0,,...ben...
Dialogue: 0,0:18:01.07,0:18:03.49,Main,,0,0,0,,...ne yaptım?!
Dialogue: 0,0:18:12.44,0:18:14.93,Main,,0,0,0,,Üzgünüm, Babalık!
Dialogue: 0,0:18:15.34,0:18:17.88,Main,,0,0,0,,Üzgünüm, Ace!
Dialogue: 0,0:18:26.21,0:18:27.51,Main,,0,0,0,,Squardo.
Dialogue: 0,0:18:31.79,0:18:35.35,Main,,0,0,0,,Ağlayacak mısın yoksa\Nonlara bunu ödetecek misin?
Dialogue: 0,0:18:41.26,0:18:44.24,Main,,0,0,0,,Yaşlı adam gerçekten müthiş. O yarayla bile...
Dialogue: 0,0:18:45.33,0:18:48.08,Main,,0,0,0,,Ama Ace'e odaklanmalıyım!
Dialogue: 0,0:18:48.08,0:18:49.44,Main,,0,0,0,,Luffy-kun!
Dialogue: 0,0:18:50.59,0:18:51.95,Main,,0,0,0,,Jinbei!
Dialogue: 0,0:18:52.55,0:18:54.81,Main,,0,0,0,,Şuna bak!
Dialogue: 0,0:19:15.20,0:19:19.48,Main,,0,0,0,,Biz farketmeden tüm\Ndüşmanlarımız meydana çekilmiş!
Dialogue: 0,0:19:20.39,0:19:22.47,Main,,0,0,0,,Bu konuda içimde kötü bir his var.
Dialogue: 0,0:19:23.01,0:19:27.28,Main,,0,0,0,,Ama Babalık harekete geçti!\Nİkinci kez düşünecek zaman değil!
Dialogue: 0,0:19:27.51,0:19:31.14,Main,,0,0,0,,Kesinlikle! Şimdi durmak için çok geç!
Dialogue: 0,0:19:33.16,0:19:34.60,Main,,0,0,0,,Hala hazır değil mi?!
Dialogue: 0,0:19:35.32,0:19:38.96,Main,,0,0,0,,Üzgünüm efendim! Buz\Ndüşündüğümüzden daha dayanıklıymış.
Dialogue: 0,0:19:51.46,0:19:53.44,Main,,0,0,0,,Saldırın!
Dialogue: 0,0:19:53.78,0:19:55.60,Main,,0,0,0,,Duvarlar şimdiye dek yükselmeliydi.
Dialogue: 0,0:19:55.60,0:19:56.98,Main,,0,0,0,,Durum kötü!
Dialogue: 0,0:19:56.98,0:19:59.58,Main,,0,0,0,,Bize biraz vakit kazandıracağım!
Dialogue: 0,0:20:02.27,0:20:03.31,Main,,0,0,0,,Koramiral!
Dialogue: 0,0:20:09.31,0:20:13.89,Main,,0,0,0,,Meydana ulaşmanıza izin\Nvermeyeceğim, Beyazsakal Korsanları!
Dialogue: 0,0:20:16.83,0:20:20.41,Main,,0,0,0,,Denizcilerin koramirallerinden Dev John!
Dialogue: 0,0:20:29.76,0:20:32.30,Main,,0,0,0,,Engel oluyorsun.
Dialogue: 0,0:20:56.23,0:20:57.70,Main,,0,0,0,,Dengem...
Dialogue: 0,0:20:59.68,0:21:00.58,Main,,0,0,0,,Koramiral!
Dialogue: 0,0:21:00.58,0:21:02.53,Main,,0,0,0,,Hey! Yer eğiliyor!
Dialogue: 0,0:21:08.63,0:21:10.58,Main,,0,0,0,,Babalık'tan uzak durun!
Dialogue: 0,0:21:11.43,0:21:13.18,Main,,0,0,0,,Bu sadece deprem değil!
Dialogue: 0,0:21:23.97,0:21:25.23,Main,,0,0,0,,Deniz...
Dialogue: 0,0:21:25.55,0:21:27.43,Main,,0,0,0,,İnanılmaz.
Dialogue: 0,0:21:27.43,0:21:29.46,Main,,0,0,0,,Tüm ada ve deniz...
Dialogue: 0,0:21:29.46,0:21:31.67,Main,,0,0,0,,...yan yatıyor!
Dialogue: 0,0:21:53.10,0:21:56.43,Main,,0,0,0,,Ne çılgın bir yaşlı adam!
Dialogue: 0,0:22:17.08,0:22:17.94,Main,,0,0,0,,Luffy-kun!
Dialogue: 0,0:22:20.79,0:22:22.25,Main,,0,0,0,,Jinbei!
Dialogue: 0,0:22:22.25,0:22:24.66,Main,,0,0,0,,Seni yakaladım!
Dialogue: 0,0:22:32.92,0:22:34.99,Main,,0,0,0,,Beni kurtardın... Sağol!
Dialogue: 0,0:22:36.03,0:22:37.76,Main,,0,0,0,,Bana teşekkür etmene gerek yok.
Dialogue: 0,0:22:39.28,0:22:42.46,Main,,0,0,0,,O adam müttefiklerini\Ndüşmanlarından ayıramıyor mu?
Dialogue: 0,0:22:42.46,0:22:45.41,Main,,0,0,0,,Tayfasındakiler yanlarda\Nsığınmaları gerektiğini biliyor.
Dialogue: 0,0:22:57.61,0:23:00.65,Main,,0,0,0,,Ne müthiş bir güç.
Dialogue: 0,0:23:00.65,0:23:05.43,Main,,0,0,0,,Ama Denizcilerin Mutlak Adalet'i tehlikede.
Dialogue: 0,0:23:05.43,0:23:09.43,Main,,0,0,0,,Geçmene izin veremem!
Dialogue: 0,0:23:29.92,0:23:31.65,Main,,0,0,0,,Durmuyor!
Dialogue: 0,0:23:34.38,0:23:36.58,Main,,0,0,0,,İdam sehpasına ulaşacak!
Dialogue: 0,0:23:36.58,0:23:38.02,Main,,0,0,0,,Hadi! Parçala onu!
Dialogue: 0,0:23:51.05,0:23:53.67,Main,,0,0,0,,Hey... İdam sehpası hala ayakta mı?
Dialogue: 0,0:23:54.77,0:23:56.14,Main,,0,0,0,,İşe yaradı mı?
Dialogue: 0,0:24:01.13,0:24:03.74,Main,,0,0,0,,İdam sehpasına vurmadı mı?!
Dialogue: 0,0:24:04.14,0:24:05.95,Main,,0,0,0,,Niye yönü değişti?
Dialogue: 0,0:24:06.87,0:24:08.55,Main,,0,0,0,,O...
Dialogue: 0,0:24:10.95,0:24:13.09,Main,,0,0,0,,Üç Amiral!
Dialogue: 0,0:24:16.82,0:24:19.37,Main,,0,0,0,,Duvarları zamanında\Nyükseltmedikleri için bu oldu.
Dialogue: 0,0:24:19.92,0:24:22.80,Main,,0,0,0,,Çünkü senin buzun engel oluyor!
Dialogue: 0,0:24:24.47,0:24:28.01,Main,,0,0,0,,Niye eritmiyorsun, Sakazuki?
Dialogue: 0,0:24:28.01,0:24:30.81,Main,,0,0,0,,Gidelim, Beyazsakal Korsanları!
Dialogue: 0,0:24:36.16,0:24:38.18,Main,,0,0,0,,Saldırın!
Dialogue: 0,0:24:42.16,0:24:45.55,Main,,0,0,0,,Epey gaza gelmiş görünüyorlar.
Dialogue: 0,0:24:45.55,0:24:48.09,Main,,0,0,0,,Korkunç!
Dialogue: 0,0:24:48.67,0:24:50.77,Main,,0,0,0,,Duvarlara ne oldu?
Dialogue: 0,0:24:50.77,0:24:52.76,Main,,0,0,0,,Efendim...
Dialogue: 0,0:24:52.76,0:24:55.69,Main,,0,0,0,,Tüm şehrin elektrik sistemini\Nkapatsak da umrumda değil.
Dialogue: 0,0:24:55.69,0:24:58.33,Main,,0,0,0,,Sahip olduğumuz tüm gücü duvarları\Nhareket ettirmek için kullanın!
Dialogue: 0,0:24:58.33,0:24:59.67,Main,,0,0,0,,Emredersiniz! Derhal!
Dialogue: 0,0:25:04.25,0:25:07.81,Main,,0,0,0,,Ace!
Dialogue: 0,0:25:14.27,0:25:15.36,Main,,0,0,0,,Luffy!
Dialogue: 0,0:25:15.36,0:25:16.19,Main,,0,0,0,,Şimdi geliyorum!
Dialogue: 0,0:25:18.62,0:25:21.59,Main,,0,0,0,,Ace!
Dialogue: 0,0:25:21.59,0:25:23.43,Main,,0,0,0,,Güç girişi, maksimum!
Dialogue: 0,0:25:34.67,0:25:36.08,Main,,0,0,0,,N-Ne?!
Dialogue: 0,0:25:37.54,0:25:39.28,Main,,0,0,0,,D-Duvarlar?!
Dialogue: 0,0:25:45.20,0:25:46.92,Main,,0,0,0,,Etrafımız sarıldı!
Dialogue: 0,0:25:46.92,0:25:48.65,Main,,0,0,0,,Bu da ne?!
Dialogue: 0,0:25:52.30,0:25:54.00,Main,,0,0,0,,Lanet olsun!
Dialogue: 0,0:25:58.45,0:25:59.64,Main,,0,0,0,,Oldu mu ki?
Dialogue: 0,0:26:03.87,0:26:06.09,Main,,0,0,0,,Faydasız! Hiç etkisi olmuyor!
Dialogue: 0,0:26:06.09,0:26:08.54,Main,,0,0,0,,Aşırı derecede kalın çelik olmalı!
Dialogue: 0,0:26:08.94,0:26:13.81,Main,,0,0,0,,Demek demin bahsettikleri duvarlar,\Nbu devasa savunma duvarlarıymış.
Dialogue: 0,0:26:13.81,0:26:16.55,Main,,0,0,0,,Kahretsin! O zaman bizimle\Ndövüşmüyor musunuz, Denizciler?!
Dialogue: 0,0:26:20.43,0:26:22.28,Main,,0,0,0,,Hey, şuna bakın!
Dialogue: 0,0:26:22.28,0:26:25.26,Main,,0,0,0,,Bütün toplar bize doğrultuldu!
Dialogue: 0,0:26:25.26,0:26:27.09,Main,,0,0,0,,Kaçın!
Dialogue: 0,0:26:27.09,0:26:30.04,Main,,0,0,0,,Etrafımız sarıldı! Nereye kaçmamız...
Dialogue: 0,0:26:33.68,0:26:34.91,Main,,0,0,0,,Bir açık var!
Dialogue: 0,0:26:34.91,0:26:37.00,Main,,0,0,0,,Hey! Neler oluyor?!
Dialogue: 0,0:26:37.00,0:26:38.58,Main,,0,0,0,,Tüm duvarları yükseltin!
Dialogue: 0,0:26:38.95,0:26:44.35,Main,,0,0,0,,Şey... Duvarlar Oz'un bedeninin\Nmuazzam ağırlığını kaldıramıyor!
Dialogue: 0,0:26:44.73,0:26:49.75,Main,,0,0,0,,Görünüşe göre kanı sisteme\Nsızmış ve zarar vermiş!
Dialogue: 0,0:26:51.83,0:26:53.33,Main,,0,0,0,,Cidden mi? Lanet şeytan!
Dialogue: 0,0:26:54.80,0:26:57.76,Main,,0,0,0,,Oz... Sen...
Dialogue: 0,0:27:01.60,0:27:03.99,Main,,0,0,0,,Ne inanılmaz bir adam!
Dialogue: 0,0:27:05.46,0:27:09.55,Main,,0,0,0,,Şimdi bile hala dövüşüyor.
Dialogue: 0,0:27:14.35,0:27:16.41,Main,,0,0,0,,Takdire şayan!
Dialogue: 0,0:27:17.69,0:27:19.22,Main,,0,0,0,,Etrafları sarılmamış olabilir,...
Dialogue: 0,0:27:19.81,0:27:21.85,Main,,0,0,0,,...ama operasyona başlayın, Akainu!
Dialogue: 0,0:27:44.13,0:27:46.02,Main,,0,0,0,,{\fad(150,150)}Meteor Volkanı
Dialogue: 0,0:28:00.57,0:28:01.99,Main,,0,0,0,,Neler oluyor?!
Dialogue: 0,0:28:05.14,0:28:06.89,Main,,0,0,0,,Kaçmanıza izin vermiyoruz!
Dialogue: 0,0:28:07.48,0:28:10.63,Main,,0,0,0,,Buzu eritin ve basacak yerleri kalmasın!
Dialogue: 0,0:00:25.92,0:00:30.36,Credits,,0,0,0,,{\fad(600,200)\pos(75,518.333)}Editing\N{\fs34}Sewil
Dialogue: 0,0:00:36.30,0:00:42.27,Credits,,0,0,0,,{\fad(600,200)\pos(75,518.333)}Karaoke\N{\fs34}KaitouYahiko
Dialogue: 0,0:00:30.83,0:00:35.70,Credits,,0,0,0,,{\fad(600,200)\pos(75,518.333)}QC\N{\fs34}Galaxy 9000\NPepperjack
Dialogue: 0,0:00:42.34,0:00:46.14,Credits,,0,0,0,,{\fad(600,200)\pos(75,518.333)}Timing\N{\fs34}Sewil
Dialogue: 0,0:00:46.94,0:00:49.58,Credits,,0,0,0,,{\fad(600,200)\pos(75,518.333)}Soundtracking\N{\fs34}Halee
Dialogue: 0,0:00:52.45,0:00:55.69,Credits,,0,0,0,,{\fad(600,200)\pos(75,518.333)}Translation\N{\fs34}Yibis
Dialogue: 0,0:00:57.52,0:01:00.46,Credits,,0,0,0,,{\fad(600,200)\pos(75,518.333)}Raws\N{\fs34}Cruchyroll
Dialogue: 0,0:00:25.37,0:00:30.62,Karaoke,,0,0,0,karaoke,{\i1}♪ Her seferinde yağmurdan sonra gökyüzüne bakıyorum. ♪{\i0}
Dialogue: 0,0:00:30.62,0:00:36.13,Karaoke,,0,0,0,karaoke,{\i1}♪ Henüz sulugöz olduğum zamanları düşünüyorum. ♪{\i0}
Dialogue: 0,0:00:36.13,0:00:43.87,Karaoke,,0,0,0,karaoke,{\i1}♪ Umutsuzca birinin arkasından koşuyorum,... ♪{\i0}
Dialogue: 0,0:00:43.94,0:00:46.85,Karaoke,,0,0,0,karaoke,{\i1}♪ ..."Daha güçlü olmak istiyorum," diye düşünerek. ♪{\i0}
Dialogue: 0,0:00:46.85,0:00:52.03,Karaoke,,0,0,0,karaoke,{\i1}♪ "Teşekkürüm" şimdi rüzgârda kayboldu,... ♪{\i0}
Dialogue: 0,0:00:52.20,0:00:57.21,Karaoke,,0,0,0,karaoke,{\i1}♪ ...daha güçlü olabilir miyim? ♪{\i0}
Dialogue: 0,0:00:57.41,0:01:02.88,Karaoke,,0,0,0,karaoke,{\i1}♪ Cevabımı bulamıyorum. ♪{\i0}
Dialogue: 0,0:01:03.01,0:01:08.40,Karaoke,,0,0,0,karaoke,{\i1}♪ Bu yüzden ilerlemeye devam edeceğim. ♪{\i0}
Dialogue: 0,0:01:08.55,0:01:11.03,Karaoke,,0,0,0,karaoke,{\i1}♪ Gel hadi, gidelim. ♪{\i0}
Dialogue: 0,0:01:11.03,0:01:14.24,Karaoke,,0,0,0,karaoke,{\i1}♪ Asla pes etmeyeceğiz. ♪{\i0}
Dialogue: 0,0:01:14.24,0:01:19.48,Karaoke,,0,0,0,karaoke,{\i1}♪ Zamanın dalgalarına yenik düşmeyeceğiz. ♪{\i0}
