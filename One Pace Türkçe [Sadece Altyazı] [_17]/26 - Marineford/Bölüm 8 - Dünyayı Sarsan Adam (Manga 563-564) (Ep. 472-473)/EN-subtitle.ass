F,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,1.5,0,2,10,10,10,1Style: Karaoke-furigana,Duality,30,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,1.5,0,8,10,10,10,1Style: Default-furigana,Arial,10,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1,1,2,10,10,10,1Style: Karaoke,Duality,60,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,8,10,10,10,1Style: Translation,Duality,60,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,2,10,10,10,1Style: Kanji,Duality,60,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,8,10,10,110,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextComment: 0,0:00:00.00,0:00:00.00,Credits,,0,0,0,,CreditsComment: 0,0:00:24.64,0:00:24.64,Main,,0,0,0,,OpeningDialogue: 0,0:02:31.28,0:02:39.89,Title,,0,0,240,,The Man Who Shook the WorldDialogue: 0,0:03:19.09,0:03:20.91,Main,,0,0,0,,Whitebeard's been...Dialogue: 0,0:03:21.19,0:03:24.32,Main,,0,0,0,,Whitebeard's been impaled!Dialogue: 0,0:03:34.51,0:03:35.33,Main,,0,0,0,,Oldtimer...Dialogue: 0,0:03:36.64,0:03:38.65,Main,,0,0,0,,Who's done it?!Dialogue: 0,0:03:38.65,0:03:40.23,Main,,0,0,0,,I think it's...Dialogue: 0,0:03:41.32,0:03:44.88,Main,,0,0,0,,Well, the one who attacked him was a captain from Whitebeard's alliance...Dialogue: 0,0:03:44.88,0:03:47.21,Main,,0,0,0,,One of the New World Pirates, Whirl Spider...Dialogue: 0,0:03:47.21,0:03:48.91,Main,,0,0,0,,Squardo!Dialogue: 0,0:03:50.22,0:03:52.45,Main,,0,0,0,,Why would you do such a thing?!Dialogue: 0,0:03:52.45,0:03:53.81,Main,,0,0,0,,Answer me, Squardo!Dialogue: 0,0:03:53.81,0:03:57.58,Main,,0,0,0,,S-Shut up! You're the ones who forced my hand!Dialogue: 0,0:03:57.58,0:04:01.39,Main,,0,0,0,,What?! Do you have any idea what you've-Dialogue: 0,0:04:04.63,0:04:07.76,Main,,0,0,0,,Old Man! If you keep pushing your body like this-Dialogue: 0,0:04:07.76,0:04:09.04,Main,,0,0,0,,Old Man!Dialogue: 0,0:04:13.44,0:04:17.13,Main,,0,0,0,,Drop the charade already, Whitebeard!Dialogue: 0,0:04:18.10,0:04:21.09,Main,,0,0,0,,You made a deal with the Navy, didn't you?!Dialogue: 0,0:04:21.09,0:04:27.24,Main,,0,0,0,,A deal to ensure that Ace and your Whitebeard Pirates would get out of this alive!Dialogue: 0,0:04:28.92,0:04:32.55,Main,,0,0,0,,What's Squardo talking about?Dialogue: 0,0:04:32.55,0:04:33.59,Main,,0,0,0,,What's going on?!Dialogue: 0,0:04:33.94,0:04:37.49,Main,,0,0,0,,He's lured us all into a trap!Dialogue: 0,0:04:38.69,0:04:41.11,Main,,0,0,0,,I had no idea...Dialogue: 0,0:04:42.00,0:04:47.38,Main,,0,0,0,,But Ace is the son of Gold Roger!Dialogue: 0,0:04:47.95,0:04:53.48,Main,,0,0,0,,I was all alone when you found me...Dialogue: 0,0:04:58.52,0:05:00.91,Main,,0,0,0,,Squardo is causing a scene again!Dialogue: 0,0:05:04.86,0:05:07.74,Main,,0,0,0,,Is everyone here a total weakling?!Dialogue: 0,0:05:07.74,0:05:09.95,Main,,0,0,0,,Come at me!Dialogue: 0,0:05:10.44,0:05:12.96,Main,,0,0,0,,Bring me Gold Roger!Dialogue: 0,0:05:14.04,0:05:16.75,Main,,0,0,0,,What's wrong? You lose your nerve?!Dialogue: 0,0:05:17.85,0:05:19.67,Main,,0,0,0,,What's wrong, you guys?!Dialogue: 0,0:05:24.71,0:05:27.81,Main,,0,0,0,,I'm sure you know why I was all alone...Dialogue: 0,0:05:33.85,0:05:37.54,Main,,0,0,0,,It was because my cherished comrades, who I'd fought beside for so long...Dialogue: 0,0:05:37.54,0:05:40.51,Main,,0,0,0,,were all killed by Roger!Dialogue: 0,0:05:41.17,0:05:46.63,Main,,0,0,0,,I'm sure you know my hatred for Roger!Dialogue: 0,0:05:46.63,0:05:51.73,Main,,0,0,0,,You could have at least told me that Ace is Roger's son...Dialogue: 0,0:05:51.73,0:05:56.14,Main,,0,0,0,,Told me of your plans to make Ace the next Pirate King!Dialogue: 0,0:05:56.14,0:05:58.60,Main,,0,0,0,,Ignore the Whitebeard Pirates!Dialogue: 0,0:05:58.60,0:06:01.04,Main,,0,0,0,,Keep moving, pull back to the plaza!Dialogue: 0,0:06:01.04,0:06:03.78,Main,,0,0,0,,The oldtimer wants to make Ace the Pirate King?Dialogue: 0,0:06:04.25,0:06:08.02,Flashbacks,,0,0,0,,Whitebeard is the strongest pirate I know of.Dialogue: 0,0:06:08.02,0:06:11.98,Flashbacks,,0,0,0,,I want to make him the Pirate King.Dialogue: 0,0:06:17.73,0:06:22.19,Main,,0,0,0,,Even then, you had already betrayed me!Dialogue: 0,0:06:22.60,0:06:28.17,Main,,0,0,0,,You let me become his friend, never knowing how you were mocking me!Dialogue: 0,0:06:28.17,0:06:33.10,Main,,0,0,0,,And then your golden child Ace was captured!Dialogue: 0,0:06:33.10,0:06:37.16,Captions,,0,0,0,,Allied ShipsDialogue: 0,0:06:33.10,0:06:37.16,Captions,,0,0,0,,Human WeaponsDialogue: 0,0:06:33.10,0:06:37.16,Captions,,0,0,0,,Allied ShipsDialogue: 0,0:06:33.10,0:06:36.19,Main,,0,0,0,,The Whitebeard Pirates are within the bay,Dialogue: 0,0:06:36.19,0:06:39.60,Main,,0,0,0,,while we allied crews are out here, along the shore...Dialogue: 0,0:06:39.60,0:06:44.68,Main,,0,0,0,,You traded away the lives of the forty-three captains of your alliance...Dialogue: 0,0:06:44.68,0:06:47.22,Main,,0,0,0,,in exchange for Ace's life!Dialogue: 0,0:06:47.74,0:06:52.62,Main,,0,0,0,,The allied crews will be executed, while Ace and the Whitebeard Pirates are spared!Dialogue: 0,0:06:52.62,0:06:56.23,Main,,0,0,0,,You and Sengoku have already agreed on that, right?!Dialogue: 0,0:06:58.78,0:07:01.95,Main,,0,0,0,,Silence! You really expect me to believe that nonsense?!Dialogue: 0,0:07:09.09,0:07:11.43,Main,,0,0,0,,You still don't get it?Dialogue: 0,0:07:11.43,0:07:14.18,Main,,0,0,0,,You'll be eating your words soon enough.Dialogue: 0,0:07:14.18,0:07:16.55,Main,,0,0,0,,If you think I'm lying, just watch closely!Dialogue: 0,0:07:19.38,0:07:25.56,Main,,0,0,0,,The crews of the alliance will be the only targets of the attack that's about to begin!Dialogue: 0,0:07:26.35,0:07:31.13,Main,,0,0,0,,The Navy has agreed not to attack the Whitebeard Pirates!Dialogue: 0,0:07:32.07,0:07:38.45,Main,,0,0,0,,And what do you know? We came here for Ace's sake, for Whitebeard's sake...Dialogue: 0,0:07:38.45,0:07:41.04,Main,,0,0,0,,to lay down our lives, unaware of the deception!Dialogue: 0,0:07:41.04,0:07:42.14,Main,,0,0,0,,Look for yourself!Dialogue: 0,0:07:44.81,0:07:49.05,Main,,0,0,0,,Just as he said, we're the only ones the Navy is attacking!Dialogue: 0,0:07:51.12,0:07:58.29,Captions,,0,0,0,,WhitebeardDialogue: 0,0:07:51.47,0:07:53.79,Main,,0,0,0,,Those monsters are coming in from behind,Dialogue: 0,0:07:53.79,0:07:58.31,Main,,0,0,0,,and the left and right flanks are blocked by ice walls, meaning there's no escape!Dialogue: 0,0:08:00.17,0:08:03.90,Main,,0,0,0,,Old Man! Is it true?!Dialogue: 0,0:08:03.90,0:08:06.63,Main,,0,0,0,,Please say it's a lie, Old Man!Dialogue: 0,0:08:13.91,0:08:16.71,Main,,0,0,0,,It's practically a miracle that I hit you even once.Dialogue: 0,0:08:17.92,0:08:20.16,Main,,0,0,0,,I'm ready.Dialogue: 0,0:08:20.16,0:08:21.15,Main,,0,0,0,,Kill me!Dialogue: 0,0:08:27.55,0:08:31.32,Main,,0,0,0,,You know, we do seem to be their only targets!Dialogue: 0,0:08:34.70,0:08:36.19,Main,,0,0,0,,Run!Dialogue: 0,0:08:39.96,0:08:43.80,Main,,0,0,0,,Old Man! Did you really sell us out...Dialogue: 0,0:08:43.80,0:08:46.44,Main,,0,0,0,,in exchange for Ace's life?!Dialogue: 0,0:08:46.92,0:08:49.65,Main,,0,0,0,,Say something! Old Man!Dialogue: 0,0:08:50.06,0:08:53.70,Main,,0,0,0,,Old Man! Old Man!Dialogue: 0,0:09:09.63,0:09:12.11,Main,,0,0,0,,No way! There's gotta be some sort of mistake!Dialogue: 0,0:09:12.11,0:09:14.21,Main,,0,0,0,,Whitebeard making a deal with the Navy?Dialogue: 0,0:09:14.21,0:09:15.66,Main,,0,0,0,,Betraying his crew?Dialogue: 0,0:09:15.66,0:09:18.00,Main,,0,0,0,,That's unthinkable! This is Whitebeard we're talking about!Dialogue: 0,0:09:18.00,0:09:20.49,Main,,0,0,0,,Whitebeard and the Navy made a deal?!Dialogue: 0,0:09:20.49,0:09:23.66,Main,,0,0,0,,Does this mean the pirates who trusted Whitebeard and fought alongside him...Dialogue: 0,0:09:23.66,0:09:27.51,Main,,0,0,0,,are betrayed and will be eliminated by the Navy?Dialogue: 0,0:09:27.51,0:09:31.02,Main,,0,0,0,,I didn't want to believe it... I doubted my own eyes!Dialogue: 0,0:09:31.02,0:09:33.45,Main,,0,0,0,,How could you betray us, Old Man?!Dialogue: 0,0:09:33.45,0:09:35.14,Main,,0,0,0,,You idiot!Dialogue: 0,0:09:35.77,0:09:37.64,Main,,0,0,0,,He was the one who took you in, Squardo!Dialogue: 0,0:09:37.64,0:09:39.70,Main,,0,0,0,,Why don't you have faith in the Old Man?!Dialogue: 0,0:09:39.70,0:09:43.15,Main,,0,0,0,,You've no right to say that, Marco!Dialogue: 0,0:09:43.15,0:09:45.77,Main,,0,0,0,,You're the Commander of the First Division!Dialogue: 0,0:09:45.77,0:09:51.49,Main,,0,0,0,,I refuse to hear you say that you didn't know... about Ace or about the deal with the Navy!Dialogue: 0,0:09:51.94,0:09:56.83,Main,,0,0,0,,It's true that Ace is Roger's son...Dialogue: 0,0:09:56.83,0:10:01.65,Main,,0,0,0,,So they found the man who'd be the most hurt to hear that, and turned him against us.Dialogue: 0,0:10:02.43,0:10:08.21,Main,,0,0,0,,Their plan was one step ahead of my own.Dialogue: 0,0:10:08.55,0:10:10.70,Main,,0,0,0,,Enough of this.Dialogue: 0,0:10:10.70,0:10:11.39,Main,,0,0,0,,Aokiji!Dialogue: 0,0:10:14.64,0:10:16.36,Main,,0,0,0,,Why is he coming here?!Dialogue: 0,0:10:16.85,0:10:18.78,Main,,0,0,0,,So this entire war was arranged from the beginning?!Dialogue: 0,0:10:18.78,0:10:20.87,Main,,0,0,0,,Then what was the point of all the fighting up to now?!Dialogue: 0,0:10:20.87,0:10:23.16,Main,,0,0,0,,Does this mean neither of them will win?!Dialogue: 0,0:10:25.19,0:10:26.02,Main,,0,0,0,,The broadcast died!Dialogue: 0,0:10:26.02,0:10:27.06,Main,,0,0,0,,What's going on?!Dialogue: 0,0:10:27.06,0:10:28.21,Main,,0,0,0,,Did it break?Dialogue: 0,0:10:34.38,0:10:36.68,Main,,0,0,0,,Mobilize the walls!Dialogue: 0,0:10:46.18,0:10:52.56,Main,,0,0,0,,That bastard... He was hit so easily, by one of his own allies!Dialogue: 0,0:10:53.06,0:10:56.17,Main,,0,0,0,,You're a disgrace, Whitebeard!Dialogue: 0,0:10:56.17,0:11:01.01,Main,,0,0,0,,I didn't know I'd lost to such a weak man!Dialogue: 0,0:11:05.49,0:11:06.88,Main,,0,0,0,,Croco-boy...Dialogue: 0,0:11:07.42,0:11:08.68,Main,,0,0,0,,Crocodile...Dialogue: 0,0:11:13.96,0:11:20.05,Thoughts,,0,0,0,,Yeah, it's true... In the past , you've always been able to dodge attacks like that...Dialogue: 0,0:11:20.05,0:11:25.36,Thoughts,,0,0,0,,Even injured or exhausted, or if the attack came from one of your own,Dialogue: 0,0:11:25.36,0:11:29.37,Thoughts,,0,0,0,,you've never been hit by an attack like this, and that's what's bothering me!Dialogue: 0,0:11:31.34,0:11:36.06,Flashbacks,,0,0,0,,You want me to wear this equipment so the enemy will feel sorry for me or something?!Dialogue: 0,0:11:36.06,0:11:36.94,Flashbacks,,0,0,0,,Old Man!Dialogue: 0,0:11:36.94,0:11:39.61,Thoughts,,0,0,0,,Your health is deteriorating.Dialogue: 0,0:11:53.39,0:11:57.20,Main,,0,0,0,,You realize what you've done, don't you...Dialogue: 0,0:11:57.20,0:11:58.91,Main,,0,0,0,,Squardo?Dialogue: 0,0:12:00.20,0:12:04.70,Main,,0,0,0,,You've turned your blade against your own father...Dialogue: 0,0:12:04.70,0:12:07.84,Main,,0,0,0,,You foolish son!Dialogue: 0,0:12:20.59,0:12:25.09,Main,,0,0,0,,Though you're a fool, I still love you, my son.Dialogue: 0,0:12:28.06,0:12:32.63,Main,,0,0,0,,Don't... try to trick me...Dialogue: 0,0:12:32.63,0:12:36.15,Main,,0,0,0,,You... sold out our...Dialogue: 0,0:12:36.15,0:12:44.45,Main,,0,0,0,,Who has dragged your pure, loyal heart into such darkness?Dialogue: 0,0:12:45.42,0:12:49.17,Main,,0,0,0,,A Navy insurgent.Dialogue: 0,0:12:50.90,0:12:54.79,Main,,0,0,0,,I'm against this plan.Dialogue: 0,0:12:54.79,0:12:57.83,Main,,0,0,0,,Whitebeard is the one you ought to strike down in this war.Dialogue: 0,0:12:57.83,0:13:01.13,Main,,0,0,0,,Going for anyone else would be a grave mistake.Dialogue: 0,0:13:01.13,0:13:06.03,Main,,0,0,0,,If you'll cooperate with me, I'll save the allied pirates.Dialogue: 0,0:13:07.54,0:13:09.97,Main,,0,0,0,,Kill Whitebeard.Dialogue: 0,0:13:14.99,0:13:19.28,Main,,0,0,0,,He said he'd save the allied pirates if I killed you...Dialogue: 0,0:13:19.98,0:13:23.05,Main,,0,0,0,,So that's what Akainu said...Dialogue: 0,0:13:23.05,0:13:30.17,Main,,0,0,0,,I'm painfully aware of how you hate Roger.Dialogue: 0,0:13:30.69,0:13:32.98,Main,,0,0,0,,But Squardo...Dialogue: 0,0:13:32.98,0:13:37.08,Main,,0,0,0,,It's wrong to resent a child for the sins of his father.Dialogue: 0,0:13:37.08,0:13:39.73,Main,,0,0,0,,What did Ace ever do to you?Dialogue: 0,0:13:40.30,0:13:46.34,Main,,0,0,0,,Together, you and Ace have been through pain, joy, and difficulty,Dialogue: 0,0:13:46.34,0:13:52.15,Main,,0,0,0,,rising above it every time, with your friends beside you.Dialogue: 0,0:13:52.15,0:13:55.58,Main,,0,0,0,,It doesn't matter who Ace's parents were.Dialogue: 0,0:13:55.58,0:13:59.27,Main,,0,0,0,,We got a chance to meet on this big, wide ocean.Dialogue: 0,0:13:59.27,0:14:05.37,Main,,0,0,0,,Not only you two. All of you are my sons.Dialogue: 0,0:14:05.37,0:14:09.62,Main,,0,0,0,,So Squardo, try to get along.Dialogue: 0,0:14:09.62,0:14:13.54,Main,,0,0,0,,Don't think that Ace is a special case.Dialogue: 0,0:14:13.54,0:14:17.37,Main,,0,0,0,,You are all my family.Dialogue: 0,0:14:27.08,0:14:30.02,Main,,0,0,0,,Still...Dialogue: 0,0:14:32.43,0:14:34.67,Main,,0,0,0,,you really...Dialogue: 0,0:14:37.33,0:14:40.42,Main,,0,0,0,,haven't changed, Sengoku.Dialogue: 0,0:14:40.42,0:14:45.26,Main,,0,0,0,,You sure duped him.Dialogue: 0,0:14:46.04,0:14:50.40,Main,,0,0,0,,Me, sell out my own sons' lives?!Dialogue: 0,0:15:03.88,0:15:07.69,Main,,0,0,0,,So he's given the pirates an escape route...Dialogue: 0,0:15:07.69,0:15:09.19,Main,,0,0,0,,I shouldn't have taken him so lightly.Dialogue: 0,0:15:14.98,0:15:17.32,Main,,0,0,0,,The wall of ice is gone...Dialogue: 0,0:15:17.32,0:15:19.27,Main,,0,0,0,,We can commandeer the warships!Dialogue: 0,0:15:19.27,0:15:21.70,Main,,0,0,0,,Now we can escape whenever we want!Dialogue: 0,0:15:24.40,0:15:30.34,Main,,0,0,0,,If you're pirates, then decide for yourselves what to believe!Dialogue: 0,0:15:39.82,0:15:43.55,Main,,0,0,0,,It was a lie after all! The Navy planned this whole thing!Dialogue: 0,0:15:43.55,0:15:45.39,Main,,0,0,0,,Dammit! They conned us all!Dialogue: 0,0:15:45.39,0:15:48.90,Main,,0,0,0,,There's no way the Old Man would betray us!Dialogue: 0,0:15:48.90,0:15:52.43,Main,,0,0,0,,Forgive me! I'll never doubt you again, Old Man!Dialogue: 0,0:15:52.43,0:15:55.02,Main,,0,0,0,,Me too, Old Man! Please forgive me!Dialogue: 0,0:15:55.02,0:15:57.17,Main,,0,0,0,,Old Man! I'll follow you till the end!Dialogue: 0,0:15:57.17,0:15:58.15,Main,,0,0,0,,Old Man!Dialogue: 0,0:15:58.54,0:16:03.60,Thoughts,,0,0,0,,A weak man, you say? Give me a break, Alligator-kid!Dialogue: 0,0:16:03.60,0:16:09.31,Thoughts,,0,0,0,,I'm only one man, with one heart.Dialogue: 0,0:16:09.31,0:16:12.48,Thoughts,,0,0,0,,They may call me a demon or a monster or whatever,Dialogue: 0,0:16:12.48,0:16:16.19,Thoughts,,0,0,0,,but I won't be the strongest forever.Dialogue: 0,0:16:16.19,0:16:19.02,Thoughts,,0,0,0,,If I can help just one young life rise to the future,Dialogue: 0,0:16:19.02,0:16:22.83,Thoughts,,0,0,0,,then it will be enough for me.Dialogue: 0,0:16:23.24,0:16:27.06,Main,,0,0,0,,Those willing to come with me, follow me even if it costs you your lives!Dialogue: 0,0:16:27.06,0:16:35.31,Main,,0,0,0,,Yeah!Dialogue: 0,0:16:38.11,0:16:43.63,Main,,0,0,0,,Attack! He's on the move! The strongest man in the world!Dialogue: 0,0:16:46.63,0:16:48.90,Main,,0,0,0,,Let's go!Dialogue: 0,0:16:48.90,0:16:50.96,Main,,0,0,0,,Yeah!Dialogue: 0,0:16:50.96,0:16:52.86,Main,,0,0,0,,Don't let them advance!Dialogue: 0,0:16:52.86,0:16:54.03,Main,,0,0,0,,Fire!Dialogue: 0,0:16:55.78,0:16:57.46,Main,,0,0,0,,Do as the Old Man says!Dialogue: 0,0:16:57.46,0:16:59.30,Main,,0,0,0,,Open a path for the Old Man!Dialogue: 0,0:17:21.39,0:17:22.26,Main,,0,0,0,,Whitebeard...Dialogue: 0,0:17:35.23,0:17:37.40,Main,,0,0,0,,Squardo...Dialogue: 0,0:17:37.40,0:17:41.06,Main,,0,0,0,,The Navy tricked him into going after the Old Man!Dialogue: 0,0:17:41.06,0:17:43.51,Main,,0,0,0,,How stupid can you get?!Dialogue: 0,0:17:43.77,0:17:47.68,Main,,0,0,0,,And how bad must he be feeling now?!Dialogue: 0,0:17:48.73,0:17:51.00,Main,,0,0,0,,But then...Dialogue: 0,0:17:52.81,0:17:54.66,Main,,0,0,0,,What...Dialogue: 0,0:17:55.76,0:17:57.60,Main,,0,0,0,,What...Dialogue: 0,0:18:01.07,0:18:03.49,Main,,0,0,0,,have I done?!Dialogue: 0,0:18:12.44,0:18:14.93,Main,,0,0,0,,I'm sorry, Old Man!Dialogue: 0,0:18:15.34,0:18:17.88,Main,,0,0,0,,I'm sorry, Ace!Dialogue: 0,0:18:26.21,0:18:27.51,Main,,0,0,0,,Squardo.Dialogue: 0,0:18:31.79,0:18:35.35,Main,,0,0,0,,Are you gonna cry, or are you gonna make them pay?Dialogue: 0,0:18:41.26,0:18:44.24,Main,,0,0,0,,That old guy sure is amazing... Even with that wound...Dialogue: 0,0:18:45.33,0:18:48.08,Main,,0,0,0,,But I've got to focus on Ace!Dialogue: 0,0:18:48.08,0:18:49.44,Main,,0,0,0,,Luffy-kun!Dialogue: 0,0:18:50.59,0:18:51.95,Main,,0,0,0,,Jinbei!Dialogue: 0,0:18:52.55,0:18:54.81,Main,,0,0,0,,Look at that!Dialogue: 0,0:19:15.20,0:19:19.48,Main,,0,0,0,,All our enemies have retreated to the plaza without us noticing!Dialogue: 0,0:19:20.39,0:19:22.47,Main,,0,0,0,,I have a bad feeling about this...Dialogue: 0,0:19:23.01,0:19:27.28,Main,,0,0,0,,But the Old Man has made his move! This is no time to be second-guessing!Dialogue: 0,0:19:27.51,0:19:31.14,Main,,0,0,0,,Indeed! It's too late to stop now!Dialogue: 0,0:19:33.16,0:19:34.60,Main,,0,0,0,,Still not ready?!Dialogue: 0,0:19:35.32,0:19:38.96,Main,,0,0,0,,Sorry, Sir! The ice is much stronger than we anticipated.Dialogue: 0,0:19:51.46,0:19:53.44,Main,,0,0,0,,Charge!Dialogue: 0,0:19:53.78,0:19:55.60,Main,,0,0,0,,The walls should be up by now...Dialogue: 0,0:19:55.60,0:19:56.98,Main,,0,0,0,,This is bad!Dialogue: 0,0:19:56.98,0:19:59.58,Main,,0,0,0,,I'll buy us some time!Dialogue: 0,0:20:02.27,0:20:03.31,Main,,0,0,0,,Vice Admiral!Dialogue: 0,0:20:09.31,0:20:13.89,Main,,0,0,0,,I won't let you reach the plaza, Whitebeard Pirates!Dialogue: 0,0:20:16.83,0:20:20.41,Main,,0,0,0,,I-It's one of the Navy's Vice Admirals, John Giant!Dialogue: 0,0:20:29.76,0:20:32.30,Main,,0,0,0,,You're in our way.Dialogue: 0,0:20:56.23,0:20:57.70,Main,,0,0,0,,My balance...Dialogue: 0,0:20:59.68,0:21:00.58,Main,,0,0,0,,Vice-Admiral!Dialogue: 0,0:21:00.58,0:21:02.53,Main,,0,0,0,,Hey! The ground is tilting!Dialogue: 0,0:21:08.63,0:21:10.58,Main,,0,0,0,,Stay away from the Old Man!Dialogue: 0,0:21:11.43,0:21:13.18,Main,,0,0,0,,This isn't just an earthquake!Dialogue: 0,0:21:23.97,0:21:25.23,Main,,0,0,0,,The sea...Dialogue: 0,0:21:25.55,0:21:27.43,Main,,0,0,0,,Unbelievable...Dialogue: 0,0:21:27.43,0:21:29.46,Main,,0,0,0,,The whole island and the sea...Dialogue: 0,0:21:29.46,0:21:31.67,Main,,0,0,0,,are being tilted!Dialogue: 0,0:21:53.10,0:21:56.43,Main,,0,0,0,,What a crazy old geezer!Dialogue: 0,0:22:17.08,0:22:17.94,Main,,0,0,0,,Luffy-kun!Dialogue: 0,0:22:20.79,0:22:22.25,Main,,0,0,0,,Jinbei!Dialogue: 0,0:22:22.25,0:22:24.66,Main,,0,0,0,,I've got you now!Dialogue: 0,0:22:32.92,0:22:34.99,Main,,0,0,0,,You saved me... Thanks!Dialogue: 0,0:22:36.03,0:22:37.76,Main,,0,0,0,,You needn't thank me.Dialogue: 0,0:22:39.28,0:22:42.46,Main,,0,0,0,,Can't that guy tell his allies from his enemies?Dialogue: 0,0:22:42.46,0:22:45.41,Main,,0,0,0,,His crewmates knew to take refuge by the flanks.Dialogue: 0,0:22:57.61,0:23:00.65,Main,,0,0,0,,What awesome power...Dialogue: 0,0:23:00.65,0:23:05.43,Main,,0,0,0,,But the Navy's Absolute Justice is at stake...Dialogue: 0,0:23:05.43,0:23:09.43,Main,,0,0,0,,I can't let you pass!Dialogue: 0,0:23:29.92,0:23:31.65,Main,,0,0,0,,It's not stopping!Dialogue: 0,0:23:34.38,0:23:36.58,Main,,0,0,0,,It's gonna reach the execution platform!Dialogue: 0,0:23:36.58,0:23:38.02,Main,,0,0,0,,Go! Tear it apart!Dialogue: 0,0:23:51.05,0:23:53.67,Main,,0,0,0,,Hey... Is the execution platform still standing?Dialogue: 0,0:23:54.77,0:23:56.14,Main,,0,0,0,,Did it work?Dialogue: 0,0:24:01.13,0:24:03.74,Main,,0,0,0,,It didn't hit the execution platform?!Dialogue: 0,0:24:04.14,0:24:05.95,Main,,0,0,0,,Why did it veer off?Dialogue: 0,0:24:06.87,0:24:08.55,Main,,0,0,0,,T-That's...Dialogue: 0,0:24:10.95,0:24:13.09,Main,,0,0,0,,The Three Admirals!Dialogue: 0,0:24:16.82,0:24:19.37,Main,,0,0,0,,This happened because they didn't raise the walls in time.Dialogue: 0,0:24:19.92,0:24:22.80,Main,,0,0,0,,Because your ice is in the way!Dialogue: 0,0:24:24.47,0:24:28.01,Main,,0,0,0,,Why don't you just melt it, Sakazuki?Dialogue: 0,0:24:28.01,0:24:30.81,Main,,0,0,0,,Let's go, Whitebeard Pirates!Dialogue: 0,0:24:36.16,0:24:38.18,Main,,0,0,0,,Charge!Dialogue: 0,0:24:42.16,0:24:45.55,Main,,0,0,0,,They all seem pretty fired up...Dialogue: 0,0:24:45.55,0:24:48.09,Main,,0,0,0,,Scary!Dialogue: 0,0:24:48.67,0:24:50.77,Main,,0,0,0,,What happened to the walls?Dialogue: 0,0:24:50.77,0:24:52.76,Main,,0,0,0,,Sir, it's...Dialogue: 0,0:24:52.76,0:24:55.69,Main,,0,0,0,,I don't care if we shut down the city's whole electric grid.Dialogue: 0,0:24:55.69,0:24:58.33,Main,,0,0,0,,Use all the power we have to mobilize those walls!Dialogue: 0,0:24:58.33,0:24:59.67,Main,,0,0,0,,Yes, Sir! Right away!Dialogue: 0,0:25:04.25,0:25:07.81,Main,,0,0,0,,Ace!Dialogue: 0,0:25:14.27,0:25:15.36,Main,,0,0,0,,Luffy!Dialogue: 0,0:25:15.36,0:25:16.19,Main,,0,0,0,,I'm coming now!Dialogue: 0,0:25:18.62,0:25:21.59,Main,,0,0,0,,Ace!Dialogue: 0,0:25:21.59,0:25:23.43,Main,,0,0,0,,Power input, maximum!Dialogue: 0,0:25:34.67,0:25:36.08,Main,,0,0,0,,W-What?!Dialogue: 0,0:25:37.54,0:25:39.28,Main,,0,0,0,,W-Walls?!Dialogue: 0,0:25:45.20,0:25:46.92,Main,,0,0,0,,We're surrounded!Dialogue: 0,0:25:46.92,0:25:48.65,Main,,0,0,0,,What is this?!Dialogue: 0,0:25:52.30,0:25:54.00,Main,,0,0,0,,Dammit!Dialogue: 0,0:25:58.45,0:25:59.64,Main,,0,0,0,,Did I get it?Dialogue: 0,0:26:03.87,0:26:06.09,Main,,0,0,0,,It's hopeless! It won't budge!Dialogue: 0,0:26:06.09,0:26:08.54,Main,,0,0,0,,It must be incredibly dense steel!Dialogue: 0,0:26:08.94,0:26:13.81,Main,,0,0,0,,So the walls they were talking about earlier were these enormous defensive walls?!Dialogue: 0,0:26:13.81,0:26:16.55,Main,,0,0,0,,Dammit! So you're not gonna fight us then, Navy?!Dialogue: 0,0:26:20.43,0:26:22.28,Main,,0,0,0,,Hey, look at that!Dialogue: 0,0:26:22.28,0:26:25.26,Main,,0,0,0,,All the cannons are pointed at us!Dialogue: 0,0:26:25.26,0:26:27.09,Main,,0,0,0,,Let's run away!Dialogue: 0,0:26:27.09,0:26:30.04,Main,,0,0,0,,We're surrounded! Where are we supposed to...Dialogue: 0,0:26:33.68,0:26:34.91,Main,,0,0,0,,There's an opening!Dialogue: 0,0:26:34.91,0:26:37.00,Main,,0,0,0,,Hey! What's going on?!Dialogue: 0,0:26:37.00,0:26:38.58,Main,,0,0,0,,Raise all of the walls!Dialogue: 0,0:26:38.95,0:26:44.35,Main,,0,0,0,,Well... The walls can't handle the massive weight of Oars' body!Dialogue: 0,0:26:44.73,0:26:49.75,Main,,0,0,0,,And it looks like his blood leaked into the system and damaged it!Dialogue: 0,0:26:51.83,0:26:53.33,Main,,0,0,0,,Seriously? Damn demon!Dialogue: 0,0:26:54.80,0:26:57.76,Main,,0,0,0,,Oars... You...Dialogue: 0,0:27:01.60,0:27:03.99,Main,,0,0,0,,What an incredible guy!Dialogue: 0,0:27:05.46,0:27:09.55,Main,,0,0,0,,He's still fighting... even now.Dialogue: 0,0:27:14.35,0:27:16.41,Main,,0,0,0,,Admirable!Dialogue: 0,0:27:17.69,0:27:19.22,Main,,0,0,0,,They may not be closed in...Dialogue: 0,0:27:19.81,0:27:21.85,Main,,0,0,0,,but proceed with the operation, Akainu!Dialogue: 0,0:27:44.13,0:27:46.02,Main,,0,0,0,,Meteor Volcano!Dialogue: 0,0:28:00.57,0:28:01.99,Main,,0,0,0,,What's going on?!Dialogue: 0,0:28:05.14,0:28:06.89,Main,,0,0,0,,We're not letting you escape!Dialogue: 0,0:28:07.48,0:28:10.63,Main,,0,0,0,,Melt the ice and take away their footing!Dialogue: 0,0:00:25.92,0:00:30.36,Credits,,0,0,0,,Editing SewilDialogue: 0,0:00:36.30,0:00:42.27,Credits,,0,0,0,,Karaoke KaitouYahikoDialogue: 0,0:00:30.83,0:00:35.70,Credits,,0,0,0,,QC Galaxy 9000 PepperjackDialogue: 0,0:00:42.34,0:00:46.14,Credits,,0,0,0,,Timing SewilDialogue: 0,0:00:46.94,0:00:49.58,Credits,,0,0,0,,Soundtracking HaleeDialogue: 0,0:00:52.45,0:00:55.69,Credits,,0,0,0,,Translation YibisDialogue: 0,0:00:57.52,0:01:00.46,Credits,,0,0,0,,Raws CruchyrollDialogue: 1,0:00:24.64,0:00:25.47,Karaoke,,0,0,0,fx,ADialogue: 1,0:00:24.64,0:00:25.47,Kanji,,0,0,0,fx,雨Dialogue: 1,0:00:24.64,0:00:25.47,Kanji-furigana,,0,0,0,fx,あDialogue: 1,0:00:24.64,0:00:25.57,Kanji-furigana,,0,0,0,fx,めDialogue: 1,0:00:24.71,0:00:25.57,Karaoke,,0,0,0,fx,mDialogue: 1,0:00:24.71,0:00:25.57,Karaoke,,0,0,0,fx,eDialogue: 1,0:00:24.71,0:00:25.57,Karaoke,,0,0,0,fx,Dialogue: 1,0:00:24.71,0:00:25.77,Kanji,,0,0,0,fx,上Dialogue: 1,0:00:24.71,0:00:25.77,Kanji-furigana,,0,0,0,fx,あDialogue: 1,0:00:24.77,0:00:29.91,Translation,,0,0,0,fx,EDialogue: 1,0:00:24.77,0:00:29.94,Translation,,0,0,0,fx,vDialogue: 1,0:00:24.81,0:00:25.77,Karaoke,,0,0,0,fx,aDialogue: 1,0:00:24.81,0:00:26.14,Kanji,,0,0,0,fx,がDialogue: 1,0:00:24.81,0:00:29.94,Translation,,0,0,0,fx,eDialogue: 1,0:00:24.81,0:00:29.94,Translation,,0,0,0,fx,rDialogue: 1,0:00:24.84,0:00:29.94,Translation,,0,0,0,fx,yDialogue: 1,0:00:24.84,0:00:29.98,Translation,,0,0,0,fx,Dialogue: 1,0:00:24.87,0:00:29.98,Translation,,0,0,0,fx,tDialogue: 1,0:00:24.87,0:00:26.14,Karaoke,,0,0,0,fx,gDialogue: 1,0:00:24.87,0:00:26.14,Karaoke,,0,0,0,fx,aDialogue: 1,0:00:24.87,0:00:26.41,Kanji,,0,0,0,fx,りDialogue: 1,0:00:24.87,0:00:29.98,Translation,,0,0,0,fx,iDialogue: 1,0:00:24.87,0:00:30.01,Translation,,0,0,0,fx,mDialogue: 1,0:00:24.91,0:00:30.01,Translation,,0,0,0,fx,eDialogue: 1,0:00:24.91,0:00:30.01,Translation,,0,0,0,fx,Dialogue: 1,0:00:24.94,0:00:30.01,Translation,,0,0,0,fx,IDialogue: 1,0:00:24.94,0:00:30.04,Translation,,0,0,0,fx,Dialogue: 1,0:00:24.97,0:00:26.41,Karaoke,,0,0,0,fx,rDialogue: 1,0:00:24.97,0:00:26.41,Karaoke,,0,0,0,fx,iDialogue: 1,0:00:24.97,0:00:26.41,Karaoke,,0,0,0,fx,Dialogue: 1,0:00:24.97,0:00:26.74,Kanji,,0,0,0,fx,のDialogue: 1,0:00:24.97,0:00:30.04,Translation,,0,0,0,fx,lDialogue: 1,0:00:24.97,0:00:30.04,Translation,,0,0,0,fx,oDialogue: 1,0:00:25.01,0:00