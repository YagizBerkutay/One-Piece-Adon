,0,1,2,1,2,10,10,10,1Style: VideoTransmissionCaptions,Roboto,55,&H00193209,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0,0,2,10,10,10,1Style: Kanji-furigana,Duality,30,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2,0,8,10,10,80,1Style: Translation-furigana,Duality,30,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,1.5,0,2,10,10,10,1Style: Karaoke-furigana,Duality,30,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,1.5,0,8,10,10,10,1Style: Default-furigana,Arial,10,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1,1,2,10,10,10,1Style: Karaoke,Duality,45.0,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,2,10,10,18,1Style: Translation,Duality,60,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,2,10,10,10,1Style: Kanji,Duality,60,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,8,10,10,110,1Style: Author,Impress BT,22.0,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1,1,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:02:30.98,0:02:40.98,Author,,0,0,0,, Türkçeleştirme - Çevirmen   onepacetr.net - KazaskerDialogue: 0,0:14:40.00,0:14:50.00,Author,,0,0,0,, Türkçeleştirme - Çevirmen   onepacetr.net - KazaskerDialogue: 0,0:28:30.00,0:28:40.00,Author,,0,0,0,, Türkçeleştirme - Çevirmen   onepacetr.net - KazaskerDialogue: 0,0:02:30.98,0:02:36.78,Title,,0,0,230,,Girdap ÖrümcekDialogue: 0,0:02:42.06,0:02:45.11,Main,,0,0,0,,Onun kadar güçlü biriyle dövüşecek zamanım yok!Dialogue: 0,0:02:45.11,0:02:47.35,Main,,0,0,0,,Buraya Ace'i kurtarmaya geldim!Dialogue: 0,0:02:53.82,0:02:55.00,Main,,0,0,0,,İkinci DüzenDialogue: 0,0:03:00.93,0:03:03.29,Main,,0,0,0,,Bu herifle biz yüzleşeceğiz!Dialogue: 0,0:03:05.76,0:03:09.10,Main,,0,0,0,,Şahin Göz, bizi hatırlıyor musun?!Dialogue: 0,0:03:09.10,0:03:12.27,Main,,0,0,0,,Daha önce ikimiz de sana meydan okumuştuk!Dialogue: 0,0:03:17.94,0:03:21.25,Main,,0,0,0,,Ama şimdi Yenikama'yız, güçlendik!Dialogue: 0,0:03:27.09,0:03:32.08,Main,,0,0,0,,Ezdiğim her böceğin yüzünü hatırlamam.Dialogue: 0,0:03:47.96,0:03:51.64,Main,,0,0,0,,Neredeyse vardım! Sadece biraz daha!Dialogue: 0,0:04:02.70,0:04:04.76,Main,,0,0,0,,Hala menzildesin.Dialogue: 0,0:04:18.38,0:04:20.76,Main,,0,0,0,,Acıdı.Dialogue: 0,0:04:20.76,0:04:22.41,Main,,0,0,0,,Beni kesti!Dialogue: 0,0:04:26.79,0:04:28.44,Main,,0,0,0,,Şahin Göz havaya mı zıpladı?!Dialogue: 0,0:04:41.56,0:04:42.69,Main,,0,0,0,,Lanet olası!Dialogue: 0,0:04:43.53,0:04:45.40,Main,,0,0,0,,Gomu Gomu no...Dialogue: 0,0:04:50.84,0:04:51.65,Thoughts,,0,0,0,,...Jet Bazu-Dialogue: 0,0:05:00.67,0:05:02.08,Main,,0,0,0,,Çok yakındı!Dialogue: 0,0:05:02.08,0:05:04.25,Main,,0,0,0,,Kollarımı uzatsaydım, onları keserdi!Dialogue: 0,0:05:04.25,0:05:06.76,Main,,0,0,0,,Beklediğim kadar dikkatsiz değilsin.Dialogue: 0,0:05:33.46,0:05:35.85,Main,,0,0,0,,Kılıcının bir darbesiyle...Dialogue: 0,0:05:36.32,0:05:39.62,Main,,0,0,0,,...dağ gibi buz duvarını kesti!Dialogue: 0,0:05:41.62,0:05:46.69,Main,,0,0,0,,Demek dünyanın en güçlü kılıç ustasının yapabileceği bu.Dialogue: 0,0:05:48.59,0:05:54.10,Main,,0,0,0,,Bu herif ne kadar güçlü böyle? Hasır Şapka'nın peşindeyse, her şey bitti!Dialogue: 0,0:06:00.41,0:06:02.94,Main,,0,0,0,,Buz bu tarafa düşüyor!Dialogue: 0,0:06:24.27,0:06:26.81,Main,,0,0,0,,Seninle ekip oluşturmamı mı istiyorsun?Dialogue: 0,0:06:27.05,0:06:31.59,Main,,0,0,0,,Denkmişiz gibi benimle konuşmayı bırak.Dialogue: 0,0:06:31.59,0:06:35.01,Main,,0,0,0,,Yani senin emrine girmemi mi istiyorsun?Dialogue: 0,0:06:36.01,0:06:43.55,Main,,0,0,0,,Tam da Impel Down'ın seni ıslah ettiğini düşünmüştüm.Dialogue: 0,0:06:43.55,0:06:46.18,Main,,0,0,0,,Öyle olsaydım, hiç dışarı çıkmazdım.Dialogue: 0,0:06:46.42,0:06:48.42,Main,,0,0,0,,KumlarDialogue: 0,0:06:48.78,0:06:51.72,Main,,0,0,0,,Defol, lanet olası Flamingo!Dialogue: 0,0:07:00.58,0:07:04.87,Main,,0,0,0,,Sebebini dinleyeceğini düşünmüştüm.Dialogue: 0,0:07:07.97,0:07:11.23,Main,,0,0,0,,Denizcilerle dövüşmekten kaçındığım sürece her şey istediğim gibi gidecek!Dialogue: 0,0:07:11.23,0:07:13.78,Main,,0,0,0,,Hiç sıkıntı yok!Dialogue: 0,0:07:20.26,0:07:22.54,Main,,0,0,0,,Sıkıntı yok! Sıkıntı yok!Dialogue: 0,0:07:22.54,0:07:24.78,Main,,0,0,0,,Kaptan Buggy!Dialogue: 0,0:07:24.78,0:07:28.07,Main,,0,0,0,,Nasıl bu şekilde başkalarının dövüşüne karışıp duruyorsun?!Dialogue: 0,0:07:30.16,0:07:31.95,Main,,0,0,0,,Şimdi ne yapacaksın?Dialogue: 0,0:07:40.43,0:07:42.74,Main,,0,0,0,,Gittikçe kardeşinden daha fazla uzaklaşmaya zorlanıyorsun!Dialogue: 0,0:07:45.27,0:07:46.39,Main,,0,0,0,,Kahretsin!Dialogue: 0,0:07:47.19,0:07:48.96,Main,,0,0,0,,Bu noktada mı sona eriyor?Dialogue: 0,0:07:51.81,0:07:54.21,Main,,0,0,0,,Sıkıntı yok!Dialogue: 0,0:07:54.69,0:07:57.62,Main,,0,0,0,,Görünüşe bakılırsa dövüş gücün hatırı sayılır biçimde artmış,...Dialogue: 0,0:07:57.62,0:07:59.84,Main,,0,0,0,,...ama zaten tüm numaralarını gördüm.Dialogue: 0,0:07:59.84,0:08:03.13,Main,,0,0,0,,Bu mesafeden on binde bir oranında bile kaçırma şansım yok!Dialogue: 0,0:08:05.03,0:08:07.63,Main,,0,0,0,,Sıkıntı yok!Dialogue: 0,0:08:07.63,0:08:09.63,Main,,0,0,0,,Gomu Gomu no...Dialogue: 0,0:08:10.49,0:08:12.80,Main,,0,0,0,,Kurtuldum!Dialogue: 0,0:08:13.76,0:08:15.51,Main,,0,0,0,,...Jet vekilDialogue: 0,0:08:15.83,0:08:20.32,Main,,0,0,0,,Hey! Ne yapıyorsun, Hasır Şapka?!Dialogue: 0,0:08:20.32,0:08:22.70,Main,,0,0,0,,Ne?! Seni kesen oydu!Dialogue: 0,0:08:22.70,0:08:26.32,Main,,0,0,0,,Üstelik bana yardıma geleceğini söylememiş miydin?Dialogue: 0,0:08:26.32,0:08:30.49,Main,,0,0,0,,Sersem! Sadece duymak istediğini duyuyorsun!Dialogue: 0,0:08:30.49,0:08:32.29,Main,,0,0,0,,Gomu Gomu no...Dialogue: 0,0:08:32.29,0:08:33.20,Main,,0,0,0,,...VekilDialogue: 0,0:08:33.20,0:08:34.20,Main,,0,0,0,,Kes şunu!Dialogue: 0,0:08:39.26,0:08:42.53,Main,,0,0,0,,Affedilemez! Sen Şahin Göz'sün, değil mi?!Dialogue: 0,0:08:43.70,0:08:46.00,Main,,0,0,0,,Özel Muggy TopuDialogue: 0,0:08:46.00,0:08:47.53,Main,,0,0,0,,Havaya uç bakalım!Dialogue: 0,0:08:50.21,0:08:51.67,Main,,0,0,0,,Ya da uçma.Dialogue: 0,0:08:51.67,0:08:56.41,Main,,0,0,0,,Muggy Topu'nun neden tesisatçılar arasında meşhur olduğunu biliyor musun?Dialogue: 0,0:08:56.41,0:08:57.80,Main,,0,0,0,,Niye?Dialogue: 0,0:08:57.80,0:09:00.39,Main,,0,0,0,,Şimdi hep birlikte... Çünkü...Dialogue: 0,0:09:00.39,0:09:02.65,Main,,0,0,0,,...BOM!Dialogue: 0,0:09:02.65,0:09:04.81,Main,,0,0,0,,Vay canına. Buggylade!Dialogue: 0,0:09:04.81,0:09:06.00,Main,,0,0,0,,Kaptan Buggy!Dialogue: 0,0:09:06.00,0:09:06.96,Main,,0,0,0,,İyi iş!Dialogue: 0,0:09:07.34,0:09:09.50,Main,,0,0,0,,Sağol, Buggy!Dialogue: 0,0:09:09.50,0:09:11.62,Main,,0,0,0,,Seni asla unutmayacağım!Dialogue: 0,0:09:11.62,0:09:13.50,Main,,0,0,0,,Henüz bitmedi!Dialogue: 0,0:09:18.97,0:09:23.07,Main,,0,0,0,,Vista! Babalık bize Ace'in kardeşini hayatta tutmamızı emretti!Dialogue: 0,0:09:23.07,0:09:24.61,Main,,0,0,0,,Ona destek ol!Dialogue: 0,0:09:24.61,0:09:26.80,Main,,0,0,0,,Anlaşıldı. Ben ilgilenirim!Dialogue: 0,0:09:34.97,0:09:39.17,Main,,0,0,0,,Beyazsakal Korsanları Beşinci Bölüm Kumandanı, Çiçek Kılıç Vista.Dialogue: 0,0:09:39.78,0:09:45.12,Main,,0,0,600,,Memnun oldum, Şahin Göz Mihawk. Demek beni duydun?Dialogue: 0,0:09:39.78,0:09:44.53,Captions,,0,0,2,,Beyazsakal Korsanları Beşinci Bölüm Kumandanı, Çiçek Kılıç Vista.Dialogue: 0,0:09:45.92,0:09:48.40,Main,,0,0,0,,Duymasaydım tuhaf olurdu.Dialogue: 0,0:09:51.17,0:09:52.70,Main,,0,0,0,,Kurtuldum!Dialogue: 0,0:09:53.21,0:09:55.01,Main,,0,0,0,,O yaşlı adam kim?Dialogue: 0,0:09:55.67,0:09:57.98,Main,,0,0,0,,Şeytan Meyvesi ya da ucuz bir numara değil.Dialogue: 0,0:09:57.98,0:10:00.28,Main,,0,0,0,,Her neyse. Minnettarım!Dialogue: 0,0:10:05.61,0:10:10.25,Main,,0,0,0,,Birer birer etrafındaki insanları müttefiki haline getiriyor.Dialogue: 0,0:10:13.27,0:10:16.29,Main,,0,0,0,,Devam et, Hasır Şapkalı çocuk!Dialogue: 0,0:10:19.69,0:10:22.97,Main,,0,0,0,,Luffy! Abini kurtarmalısın!Dialogue: 0,0:10:26.12,0:10:27.69,Main,,0,0,0,,Çekilin!Dialogue: 0,0:10:29.36,0:10:31.74,Main,,0,0,0,,Denizlerde dolaşan insanlar içinde...Dialogue: 0,0:10:35.92,0:10:38.84,Main,,0,0,0,,...en korkutucu güce sahip olan adam, bu.Dialogue: 0,0:10:40.84,0:10:43.10,Main,,0,0,0,,Ace!Dialogue: 0,0:10:46.94,0:10:49.63,Narrator,,0,0,0,,İdam saati gittikçe yaklaşırken...Dialogue: 0,0:10:49.63,0:10:53.40,Narrator,,0,0,0,,...birbiri ardına şok edici gerçekler ortaya çıktı.Dialogue: 0,0:10:59.04,0:11:05.16,Narrator,,0,0,0,,İki yüzden fazla kişi düşünülmezi yaptı ve aşılması imkânsız Impel Down'dan kaçtı.Dialogue: 0,0:11:05.16,0:11:09.81,Narrator,,0,0,0,,Sonra adı kötüye çıkmış bu güçlü korsanlar, savaş alanında ortaya çıktı.Dialogue: 0,0:11:13.90,0:11:18.20,Narrator,,0,0,0,,Ortaya çıkan manzara başka dünyadan gibi görünüyor.Dialogue: 0,0:11:18.76,0:11:23.39,Narrator,,0,0,0,,Bu kesinlikle tarihi yeniden yazacak müthiş bir mücadele!Dialogue: 0,0:11:24.00,0:11:27.50,Narrator,,0,0,0,,Dünyanın her yerindeki insanlar sadece nefeslerini tutabilir...Dialogue: 0,0:11:27.50,0:11:32.94,Narrator,,0,0,0,,...ve geleceklerinin belirlenmesini izleyebilirler.Dialogue: 0,0:11:43.54,0:11:46.11,Main,,0,0,0,,Filo Amirali. Hazırlıklar tamamlandı.Dialogue: 0,0:11:46.11,0:11:48.26,Main,,0,0,0,,Koyun kıyısındakiler de mi?Dialogue: 0,0:11:48.26,0:11:49.82,Main,,0,0,0,,Evet. Hepsi hazır.Dialogue: 0,0:11:54.11,0:11:55.18,Main,,0,0,0,,Ha?Dialogue: 0,0:11:56.03,0:11:58.30,Main,,0,0,0,,Onu idam etmeye hazırlanıyorlar.Dialogue: 0,0:11:59.07,0:12:00.45,Main,,0,0,0,,Onlar...Dialogue: 0,0:12:01.10,0:12:03.11,Main,,0,0,0,,Ace'e ne yapacaklar?Dialogue: 0,0:12:03.11,0:12:05.00,Main,,0,0,0,,Henüz zamanı gelmedi!Dialogue: 0,0:12:07.91,0:12:10.69,Main,,0,0,0,,İdam şimdi mi başlayacak?Dialogue: 0,0:12:10.69,0:12:15.11,Main,,0,0,0,,İmkânsız! Duyurulan zamana hala vakit var!Dialogue: 0,0:12:15.31,0:12:19.25,Main,,0,0,0,,Gözlemci Den Den Mushilerin yayınını hemen kesin!Dialogue: 0,0:12:20.07,0:12:28.59,Main,,0,0,0,,Mutlak Adalet uğruna, Denizciler ve Dünya Hükümeti bu savaşı her pahasına kazanmalı.Dialogue: 0,0:12:29.15,0:12:32.18,Main,,0,0,0,,Başvuracağımız yöntemler ne olursa olsun.Dialogue: 0,0:12:32.18,0:12:36.65,Main,,0,0,0,,Ama bu, zayıf iradeli sıradan insanların kaldıramayacağı kadar aşırı olabilir.Dialogue: 0,0:12:36.65,0:12:41.99,Main,,0,0,0,,Gerçekleşmek üzere olan trajediyi dünyaya göstermeye gerek yok.Dialogue: 0,0:12:43.41,0:12:44.54,Main,,0,0,0,,Babalık...Dialogue: 0,0:12:48.08,0:12:49.65,Main,,0,0,0,,Çabuk!Dialogue: 0,0:12:50.24,0:12:52.88,Main,,0,0,0,,Ace'i gerçekten erken idam edecekler!Dialogue: 0,0:12:54.29,0:12:56.79,Main,,0,0,0,,Ace!Dialogue: 0,0:12:57.83,0:13:01.03,Main,,0,0,0,,Birkaç saat içinde dünyaya şunu söyleyeceğiz:...Dialogue: 0,0:13:01.49,0:13:03.50,Main,,0,0,0,,...Zafer!Dialogue: 0,0:13:03.50,0:13:06.03,Main,,0,0,0,,Bu tek kelime yeter.Dialogue: 0,0:13:11.66,0:13:12.94,Main,,0,0,0,,Gemilerimiz...Dialogue: 0,0:13:19.06,0:13:21.73,Main,,0,0,0,,Kıyıya bakın! Orada bir şey var!Dialogue: 0,0:13:31.27,0:13:33.29,Main,,0,0,0,,Onlar bizim adamlarımız değil.Dialogue: 0,0:13:33.29,0:13:38.07,Main,,0,0,0,,Denizciler kıyıdan gelmek için donmuş dalgaların etrafından dolaşmış olmalı!Dialogue: 0,0:13:38.07,0:13:42.72,Main,,0,0,0,,Hala gemileri yok edebilecek kapasitede adamları mı var?Dialogue: 0,0:13:46.56,0:13:47.64,Main,,0,0,0,,Onlar...Dialogue: 0,0:13:49.57,0:13:51.91,Main,,0,0,0,,Bunlar da kim?!Dialogue: 0,0:13:53.41,0:13:58.52,Main,,0,0,0,,Demek bunlar bahsini duyduğum Hükümet'in insan silahları.Dialogue: 0,0:14:05.42,0:14:08.53,Main,,0,0,0,,Sabaody Takımadası'ndaki ayı benzeri adamlar.Dialogue: 0,0:14:08.53,0:14:10.19,Main,,0,0,0,,Onlardan bu kadar çok mu var?Dialogue: 0,0:14:17.06,0:14:17.87,Main,,0,0,0,,K-Kuma?Dialogue: 0,0:14:18.71,0:14:21.94,Narrator,,0,0,0,,Savaş başladıktan bir buçuk saat sonra....Dialogue: 0,0:14:22.59,0:14:24.76,Narrator,,0,0,0,,...Denizciler her şeyini bahse koydu.Dialogue: 0,0:14:25.49,0:14:28.01,Narrator,,0,0,0,,Savaşın akışını değiştirmek için...Dialogue: 0,0:14:28.01,0:14:32.07,Narrator,,0,0,0,,...son evreye girdiler.Dialogue: 0,0:14:34.93,0:14:37.12,Main,,0,0,0,,Pekâlâ beyler!Dialogue: 0,0:14:37.32,0:14:39.26,Main,,0,0,0,,Beklemekten yoruldum!Dialogue: 0,0:14:39.46,0:14:42.43,Main,,0,0,0,,Sonunda sıramız geldi!Dialogue: 0,0:14:55.37,0:14:57.93,Main,,0,0,0,,Denizin Yedi Savaş Lordundan biri, Bartholomew Kuma!Dialogue: 0,0:14:57.93,0:15:00.38,Main,,0,0,0,,Niye ondan bu kadar çok var?Dialogue: 0,0:15:01.23,0:15:03.05,Main,,0,0,0,,Neler oluyor?!Dialogue: 0,0:15:12.04,0:15:15.86,Main,,0,0,0,,Bir süre önce Sabaody Takımadası'nı kasıp kavuran şeyler!Dialogue: 0,0:15:15.86,0:15:18.93,Main,,0,0,0,,Bir sürü Bartholomew Kuma.Dialogue: 0,0:15:18.93,0:15:21.37,Main,,0,0,0,,Öncekinden bile daha fazlası var!Dialogue: 0,0:15:33.55,0:15:35.58,Main,,0,0,0,,Ana Ofis! Ana Ofis!Dialogue: 0,0:15:36.04,0:15:38.10,Main,,0,0,0,,Büyük haber!Dialogue: 0,0:15:38.10,0:15:40.10,Main,,0,0,0,,Alo? Alo?!Dialogue: 0,0:15:47.53,0:15:49.99,Main,,0,0,0,,Gerçek olan o mu?Dialogue: 0,0:15:50.56,0:15:52.94,Main,,0,0,0,,Bu konuda söylentiler duymuştum.Dialogue: 0,0:15:52.94,0:15:57.17,Main,,0,0,0,,Doctor Vegapunk insan silah geliştiriyordu.Dialogue: 0,0:15:57.17,0:16:01.06,Main,,0,0,0,,Prototipler çeşitli olayları çözmesi için gönderildi.Dialogue: 0,0:16:01.06,0:16:04.35,Main,,0,0,0,,Bunlar insan silahlar mı?Dialogue: 0,0:16:04.35,0:16:07.16,Main,,0,0,0,,Niye hepsi Kuma'ya benziyor?Dialogue: 0,0:16:07.16,0:16:11.42,Main,,0,0,0,,Hey, amca! Böyle planlamamıştık!Dialogue: 0,0:16:12.00,0:16:18.12,Main,,0,0,0,,Biz gelmeden koyda korsanların etrafını kuşatmış olmanız gerekiyordu,...Dialogue: 0,0:16:18.82,0:16:21.29,Main,,0,0,0,,...ama her yere dağılmışlar!Dialogue: 0,0:16:25.05,0:16:27.79,Main,,0,0,0,,Denizcilerin planını anladım.Dialogue: 0,0:16:27.79,0:16:33.98,Captions,,36,0,95,,Müttefik GemilerDialogue: 0,0:16:27.79,0:16:33.98,Captions,,30,0,380,,BeyazsakalDialogue: 0,0:16:27.79,0:16:33.98,Captions,,30,0,560,,DenizcilerDialogue: 0,0:16:28.92,0:16:36.59,Main,,0,0,0,,Önce, panikleyelim diye Ace'in erken idam edileceği haberini bilerek sızdırdılar.Dialogue: 0,0:16:36.59,0:16:40.01,Main,,0,0,0,,Sonra düşman, korsanları peşinden...Dialogue: 0,0:16:40.01,0:16:43.23,Main,,0,0,0,,...koya ççekerek yavaşça geri çekildi.Dialogue: 0,0:16:43.23,0:16:46.84,Main,,0,0,0,,Bu noktada, insan silahlar geri çekilmemizi engelleyecekti ve tuzağa düşecektik.Dialogue: 0,0:16:43.91,0:16:48.62,Captions,,0,0,0,,İnsan SilahlarDialogue: 0,0:16:46.84,0:16:48.35,Main,,0,0,0,,Şah-mat.Dialogue: 0,0:16:49.13,0:16:54.66,Main,,0,0,0,,Demek Babalık bunun gelişini gördüğü için...Dialogue: 0,0:16:54.66,0:16:56.13,Main,,0,0,0,,...bizi kuşatan gemilere saldırmamızı söyledi.Dialogue: 0,0:16:56.13,0:16:58.96,Main,,0,0,0,,Bu sayede tuzağa düşmedik.Dialogue: 0,0:17:04.25,0:17:06.01,Main,,0,0,0,,Sağ ve sol kanatları kaybetmiş olabiliriz,...Dialogue: 0,0:17:06.01,0:17:08.72,Main,,0,0,0,,...ama önden ve arkadan hala onları tuzağa düşürebiliriz.Dialogue: 0,0:17:08.72,0:17:11.88,Main,,0,0,0,,Planlandığı gibi önce destek veren korsan tayfalarını hedef alın.Dialogue: 0,0:17:11.88,0:17:16.18,Main,,0,0,0,,Savunmamızı geçen herkesi yok edin!Dialogue: 0,0:17:18.95,0:17:21.11,Main,,0,0,0,,Söylediği gibi...Dialogue: 0,0:17:21.11,0:17:24.60,Main,,0,0,0,,Amca, bizim savaş gemilerinden birazı da yok olsa sorun olur mu?Dialogue: 0,0:17:24.60,0:17:27.22,Main,,0,0,0,,En aza indirgemeye çalış.Dialogue: 0,0:17:27.79,0:17:29.41,Main,,0,0,0,,Anlaşıldı.Dialogue: 0,0:17:31.13,0:17:32.22,Main,,0,0,0,,Başlayalım!Dialogue: 0,0:17:33.90,0:17:36.06,Main,,0,0,0,,Neler olduğunu bilmiyorum,...Dialogue: 0,0:17:36.74,0:17:38.74,Main,,0,0,0,,...ama bizi o kadar kolay haklayamayacaksınız!Dialogue: 0,0:17:56.32,0:17:57.09,Main,,0,0,0,,Eyvah!Dialogue: 0,0:18:13.48,0:18:15.64,Main,,0,0,0,,Gidin, Pacifistalar!Dialogue: 0,0:18:32.50,0:18:33.46,Main,,0,0,0,,Bizi hakladılar!Dialogue: 0,0:18:58.50,0:19:02.18,Main,,0,0,0,,Demek kendi birliklerinizi feda etmek konusunda ikinci kez düşünmüyorsunuz.Dialogue: 0,0:19:10.00,0:19:12.46,Main,,0,0,0,,Tereddüt etmeyin, beylerDialogue: 0,0:19:12.46,0:19:16.33,Main,,0,0,0,,Meydana doğru ilerleyin!Dialogue: 0,0:19:24.22,0:19:27.80,Main,,0,0,0,,Tüm birlikler, buzun üstünden inin!Dialogue: 0,0:19:28.58,0:19:32.02,Main,,0,0,0,,Korsanların meydana ulaşmalarına izin vermeyin!Dialogue: 0,0:19:32.86,0:19:34.72,Main,,0,0,0,,Geri çekilin!Dialogue: 0,0:19:36.36,0:19:37.50,Main,,0,0,0,,Çabuk!Dialogue: 0,0:19:50.59,0:19:53.76,Main,,0,0,0,,Şimdi hangi çiçeği açtırsam?Dialogue: 0,0:19:53.76,0:19:56.27,Main,,0,0,0,,Onları içeri sürükleyin, Pacifistalar!Dialogue: 0,0:19:56.27,0:19:58.78,Main,,0,0,0,,Hiç sanmıyorum! Alın bakalım!Dialogue: 0,0:20:02.31,0:20:03.72,Main,,0,0,0,,Hak ettin!Dialogue: 0,0:20:16.57,0:20:19.40,Main,,0,0,0,,O şeyler de ne öyle?Dialogue: 0,0:20:19.40,0:20:21.29,Main,,0,0,0,,İnsan bile değil gibiler!Dialogue: 0,0:20:21.29,0:20:22.64,Main,,0,0,0,,Yenilmezler mi?Dialogue: 0,0:20:26.61,0:20:28.22,Main,,0,0,0,,Yayın...Dialogue: 0,0:20:39.52,0:20:41.76,Main,,0,0,0,,Ne yaparsan yap...Dialogue: 0,0:20:41.76,0:20:45.08,Main,,0,0,0,,...hala avantaj bizde, Beyazsakal.Dialogue: 0,0:20:47.36,0:20:51.93,Main,,0,0,0,,Tüm yayınlar kesilince, çevirme duvarlarını harekete geçirin!Dialogue: 0,0:20:52.46,0:20:58.50,Main,,0,0,0,,Sonra Ace'i idam edip tüm düşmanı birden yok edeceğiz!Dialogue: 0,0:20:59.10,0:20:59.74,Main,,0,0,0,,Anlaşıldı!Dialogue: 0,0:21:05.92,0:21:07.81,Main,,0,0,0,,Çekilin!Dialogue: 0,0:21:15.38,0:21:18.42,Main,,0,0,0,,Ace'in başı dertte! Acele etmeliyim!Dialogue: 0,0:21:21.42,0:21:23.99,Main,,0,0,0,,Başladığın yere geri dön!Dialogue: 0,0:21:25.33,0:21:26.40,Main,,0,0,0,,Luffy-kun!Dialogue: 0,0:21:36.28,0:21:37.34,Main,,0,0,0,,Jinbe.Dialogue: 0,0:21:42.89,0:21:44.75,Main,,0,0,0,,Amirallerden biri burada.Dialogue: 0,0:21:45.56,0:21:46.97,Main,,0,0,0,,Lanet olsun!Dialogue: 0,0:21:47.59,0:21:49.25,Main,,0,0,0,,Aşılması zor bir düşman, ama acele etmeliyiz!Dialogue: 0,0:21:50.07,0:21:53.06,Main,,0,0,0,,Güçlü düşmanların yoluna çıkacağını hep biliyordun,...Dialogue: 0,0:21:53.06,0:21:56.82,Main,,0,0,0,,...ama yine de buraya gelmeye karar verdin, değil mi?!Dialogue: 0,0:22:00.06,0:22:02.93,Main,,0,0,0,,Geber, Dragon'un oğlu!Dialogue: 0,0:22:10.23,0:22:13.86,Main,,0,0,0,,Ace'in kardeşi! Tâkatin mi tükendi?Dialogue: 0,0:22:17.48,0:22:21.26,Main,,0,0,0,,Oh, Kumandanlar!Dialogue: 0,0:22:21.26,0:22:24.19,Main,,0,0,0,,Bu bizim için işleri kolaylaştırır!Dialogue: 0,0:22:24.19,0:22:26.70,Main,,0,0,0,,Bir amiralin seni durdurmasına izin veremezsin!Dialogue: 0,0:22:26.70,0:22:27.73,Main,,0,0,0,,Bizimle gel!Dialogue: 0,0:22:27.73,0:22:30.76,Main,,0,0,0,,Tamam! Pislik!Dialogue: 0,0:22:30.76,0:22:33.35,Main,,0,0,0,,Denizciler geri çekilirken şansımız var!Dialogue: 0,0:22:33.35,0:22:35.93,Main,,0,0,0,,Savunmalarını yarıp geçelim!Dialogue: 0,0:22:35.93,0:22:40.64,Main,,0,0,0,,Oh, şimdi zorlu bir grup gibi görünüyor!Dialogue: 0,0:22:50.96,0:22:54.18,Main,,0,0,0,,Onuncu Bölüm Kumandanı Curiel!Dialogue: 0,0:22:54.69,0:22:59.16,Main,,0,0,0,,Bana saldırmaya çalışırsan, seni böcek gibi ezerim!Dialogue: 0,0:23:00.56,0:23:04.06,Main,,0,0,0,,Ama bu koyda durmak, sonunu kaçınılmaz kılıyor zaten.Dialogue: 0,0:23:04.06,0:23:09.03,Main,,0,0,0,,Ace ölecek ve kaçacak yeriniz olmadan hepiniz yok edileceksiniz!Dialogue: 0,0:23:09.20,0:23:17.14,Main,,0,0,0,,Kimin kazandığı umrumda değil, ama Beyazsakal'ın ölüşünü görmek isterdim!Dialogue: 0,0:23:17.14,0:23:20.93,Main,,0,0,0,,Babalığın ya da Ace'in ölmesine izin vermeyeceğim!Dialogue: 0,0:23:29.83,0:23:33.14,Main,,0,0,0,,Dövüşümüzü erteleyelim, Vista.Dialogue: 0,0:23:34.21,0:23:37.26,Main,,0,0,0,,Bu ikimiz için de avantajlı gibi.Dialogue: 0,0:23:44.34,0:23:47.04,Main,,0,0,0,,Geri çekilmemiz emredildi, Smoker-san.Dialogue: 0,0:23:47.61,0:23:49.14,Main,,0,0,0,,Burası...Dialogue: 0,0:23:51.26,0:23:52.77,Main,,0,0,0,,Evet...Dialogue: 0,0:23:53.39,0:23:54.98,Main,,0,0,0,,Biliyorum.Dialogue: 0,0:23:56.97,0:23:57.95,Main,,0,0,0,,Hasır Şapka!Dialogue: 0,0:24:05.01,0:24:08.23,Main,,0,0,0,,Luffy... Hemen abine git!Dialogue: 0,0:24:14.09,0:24:16.60,Main,,0,0,0,,Tüm yayınlar kesildi mi?!Dialogue: 0,0:24:16.60,0:24:18.66,Main,,0,0,0,,H-Hayır, biraz daha bekleyin.Dialogue: 0,0:24:18.66,0:24:20.87,VideoTransmissionCaptions,,0,0,100,,Lütfen Beklemede KalınDialogue: 0,0:24:21.03,0:24:22.17,Main,,0,0,0,,Biz hazırız!Dialogue: 0,0:24:22.28,0:24:23.72,Main,,0,0,0,,Hey, yana kay.Dialogue: 0,0:24:25.09,0:24:28.01,Main,,0,0,0,,Bir ekranın yayın yaptığını düşünmüştüm.Dialogue: 0,0:24:28.01,0:24:31.08,Main,,0,0,0,,Hey! Neler oluyor?!Dialogue: 0,0:24:31.74,0:24:34.18,Main,,0,0,0,,Hmm? Oradaki de kim?Dialogue: 0,0:24:34.97,0:24:38.86,Main,,0,0,0,,Oh! O... Yoksa...Dialogue: 0,0:24:38.86,0:24:41.58,Main,,0,0,0,,Bu adam şimdiye dek kimliğini gizledi,...Dialogue: 0,0:24:41.58,0:24:44.41,Main,,0,0,0,,...ama son zamanlarda kendisinin, Korsanlar Kralı Gold Roger'la yolculuk eden...Dialogue: 0,0:24:44.41,0:24:47.06,Main,,0,0,0,,...efsanevi tayfadan olduğunu söyledi!Dialogue: 0,0:24:48.37,0:24:49.10,Main,,0,0,0,,O da kim?Dialogue: 0,0:24:49.10,0:24:53.09,Main,,0,0,0,,Gerçekten o büyük korsan Palyaço Buggy mi?!Dialogue: 0,0:24:55.45,0:24:57.86,Main,,0,0,0,,Evet, o benim!Dialogue: 0,0:25:01.84,0:25:05.32,Main,,0,0,0,,Efsanevi bir korsan olmamla ilgili durumun...Dialogue: 0,0:25:05.32,0:25:07.85,Main,,0,0,0,,...sır olması gerekiyordu, ama...Dialogue: 0,0:25:07.86,0:25:13.01,Main,,0,0,0,,Dur, Kaptan Buggy! Burnun kanıyor!Dialogue: 0,0:25:17.51,0:25:19.45,Main,,0,0,0,,Kes! Kes!Dialogue: 0,0:25:19.45,0:25:20.53,Main,,0,0,0,,Yüzünü sil!Dialogue: 0,0:25:21.40,0:25:23.60,Main,,0,0,0,,Bu da ne böyle?!Dialogue: 0,0:25:24.16,0:25:28.04,Main,,0,0,0,,Size bu saçma yayını kesmenizi emrediyorum!Dialogue: 0,0:25:28.04,0:25:30.92,Main,,0,0,0,,Planı yürürlüğe koyamayız!Dialogue: 0,0:25:30.92,0:25:38.20,Main,,0,0,0,,Ş-Şey... Gözlemci Den Den Mushinin biri Impel Down kaçakları tarafından çalınmış!Dialogue: 0,0:25:39.22,0:25:41.23,Main,,0,0,0,,Ne?!Dialogue: 0,0:25:41.95,0:25:43.35,Main,,0,0,0,,Makyaj!Dialogue: 0,0:25:43.35,0:25:44.99,Main,,0,0,0,,Tamam!Dialogue: 0,0:25:44.99,0:25:46.96,Main,,0,0,0,,Tamam, ikinci çekim zamanı!Dialogue: 0,0:25:47.61,0:25:49.71,Main,,0,0,0,,Üç! İki! Bir!Dialogue: 0,0:25:49.71,0:25:51.08,Main,,0,0,0,,Motor!Dialogue: 0,0:25:51.08,0:25:53.53,Main,,0,0,0,,Oh! O...Dialogue: 0,0:25:54.37,0:25:59.30,Main,,0,0,0,,Efsanevi Roger'ın ve Dört İmparator'dan biri olan Kızıl Saç'ın tayfa arkadaşı.Dialogue: 0,0:25:59.98,0:26:03.47,Main,,0,0,0,,Büyük korsan, Kaptan Palyaço Buggy!Dialogue: 0,0:26:04.13,0:26:05.64,Main,,0,0,0,,Evet, o benim!Dialogue: 0,0:26:06.33,0:26:09.05,Main,,0,0,0,,Onları hemen durdurun!Dialogue: 0,0:26:11.61,0:26:13.18,Main,,0,0,0,,Çok yakındı!Dialogue: 0,0:26:13.18,0:26:15.15,Main,,0,0,0,,Bizi buldular! Kaçın!Dialogue: 0,0:26:17.81,0:26:21.19,Main,,0,0,0,,Şahin Göz Mihawk tarafından kesilmişsin,...Dialogue: 0,0:26:21.19,0:26:23.16,Main,,0,0,0,,...ama hala ayaktasın! Kim olabilirsin sen?Dialogue: 0,0:26:24.06,0:26:25.87,Main,,0,0,0,,Kim, ben mi?Dialogue: 0,0:26:26.85,0:26:28.30,Main,,0,0,0,,Ben Buggy!Dialogue: 0,0:26:29.60,0:26:31.25,Main,,0,0,0,,Efsanevi!Dialogue: 0,0:26:31.25,0:26:34.02,Main,,0,0,0,,Onları havaya uçurun!Dialogue: 0,0:26:35.03,0:26:36.71,Main,,0,0,0,,Savaş alanında neler oluyor?!Dialogue: 0,0:26:36.71,0:26:38.95,Main,,0,0,0,,Niye diğer yayınlar kesildi?!Dialogue: 0,0:26:38.95,0:26:41.90,Main,,0,0,0,,Bize Ace'i gösterin. İdam edilmek üzere!Dialogue: 0,0:26:41.90,0:26:44.88,Main,,0,0,0,,Bartholomew Kuma ordusunu gösterin!Dialogue: 0,0:26:49.99,0:26:51.49,Main,,0,0,0,,Pes etmeyin!Dialogue: 0,0:26:51.49,0:26:55.19,Main,,0,0,0,,Ace kurtarılmadan önce yenilmememiz gerekir!Dialogue: 0,0:26:55.19,0:26:56.82,Main,,0,0,0,,Gidelim!Dialogue: 0,0:26:56.82,0:26:57.93,Main,,0,0,0,,Tamam!Dialogue: 0,0:27:18.22,0:27:19.02,Main,,0,0,0,,Babalık...Dialogue: 0,0:27:23.13,0:27:26.15,Main,,0,0,0,,Squardo... İyi misin?Dialogue: 0,0:27:26.15,0:27:28.02,Main,,0,0,0,,Evet, bir şekilde hayatta kaldım.Dialogue: 0,0:27:28.02,0:27:31.72,Main,,0,0,0,,Anlıyorum. Demin seninle bağlantı kurmaya çalıştım...Dialogue: 0,0:27:31.72,0:27:33.93,Main,,0,0,0,,Kıyıda işler ne durumda?Dialogue: 0,0:27:33.93,0:27:37.50,Main,,0,0,0,,Müttefiklerimizin çoğu düşüyor.Dialogue: 0,0:27:37.50,0:27:41.70,Main,,0,0,0,,Düşman kuvvetlerinden sıyrılıp buraya gelmeyi başardım.Dialogue: 0,0:27:42.26,0:27:46.69,Main,,0,0,0,,Sengoku'ya merhamet etmeyeceğiz. Tüm kuvvetlerini ezeceğiz.Dialogue: 0,0:27:46.69,0:27:48.21,Main,,0,0,0,,Haklısın.Dialogue: 0,0:27:50.54,0:27:52.11,Main,,0,0,0,,Squardo?Dialogue: 0,0:27:52.11,0:27:53.18,Main,,0,0,0,,Orada ne yapıyor?Dialogue: 0,0:27:53.18,0:28:00.86,Main,,0,0,0,,Kırk üç gemi sana destek olmak için geldi, hepimizin sana büyük borcu var.Dialogue: 0,0:28:00.86,0:28:04.63,Main,,0,0,0,,Beyazsakal Korsanları için seve seve canımızı veririz!Dialogue: 0,0:00:25.92,0:00:30.36,Credits,,0,0,0,,Editing SewilDialogue: 0,0:00:36.30,0:00:42.27,Credits,,0,0,0,,Karaoke KaitouYahikoDialogue: 0,0:00:30.83,0:00:35.70,Credits,,0,0,0,,QC Galaxy 9000 PepperjackDialogue: 0,0:00:42.34,0:00:46.14,Credits,,0,0,0,,Timing Galaxy 9000Dialogue: 0,0:00:46.94,0:00:49.58,Credits,,0,0,0,,Soundtracking HaleeDialogue: 0,0:00:52.45,0:00:55.69,Credits,,0,0,0,,Translation YibisDialogue: 0,0:00:57.52,0:01:00.46,Credits,,0,0,0,,Raws CruchyrollDialogue: 0,0:00:25.37,0:00:30.62,Karaoke,,0,0,0,karaoke,♪ Her seferinde yağmurdan sonra gökyüzüne bakıyorum. ♪Dialogue: 0,0:00:30.62,0:00:36.13,Karaoke,,0,0,0,karaoke,♪ Henüz sulugöz olduğum zamanları düşünüyorum. ♪Dialogue: 0,0:00:36.13,0:00:43.87,Karaoke,,0,0,0,karaoke,♪ Umutsuzca birinin arkasından koşuyorum,... ♪Dialogue: 0,0:00:43.94,0:00:46.85,Karaoke,,0,0,0,karaoke,♪ ..."Daha güçlü olmak istiyorum," diye düşünerek. ♪Dialogue: 0,0:00:46.85,0:00:52.03,Karaoke,,0,0,0,karaoke,♪ "Teşekkürüm" şimdi rüzgârda kayboldu,... ♪Dialogue: 0,0:00:52.20,0:00:57.21,Karaoke,,0,0,0,karaoke,♪ ...daha güçlü olabilir miyim? ♪Dialogue: 0,0:00:57.41,0:01:02.88,Karaoke,,0,0,0,karaoke,♪ Cevabımı bulamıyorum. ♪Dialogue: 0,0:01:03.01,0:01:08.40,Karaoke,,0,0,0,karaoke,♪ Bu yüzden ilerlemeye devam edeceğim. ♪Dialogue: 0,0:01:08.55,0:01:11.03,Karaoke,,0,0,0,karaoke,♪ Gel hadi, gidelim. ♪Dialogue: 0,0:01:11.03,0:01:14.24,Karaoke,,0,0,0,karaoke,♪ Asla pes etmeyeceğiz. ♪Dialogue: 0,0:01:14.24,0:01:19.48,Karaoke,,0,0,0,karaoke,♪ Zamanın dalgalarına yenik düşmeyeceğiz. ♪Dialogue: 0,0:01:19.48,0:01:25.09,Karaoke,,0,0,0,karaoke,♪ Tekrar tekrar ayağa kalkacağız. ♪Dialogue: 0,0:01:25.10,0:01:30.73,Karaoke,,0,0,0,karaoke,♪ Çünkü bizim için önemli olanı kaybetmek istemiyoruz. ♪Dialogue: 0,0:01:30.74,0:01:35.85,Karaoke,,0,0,0,karaoke,♪ Beni sürekli, sürekli ilerlemeye zorlayan... ♪Dialogue: 0,0:01:35.86,0:01:41.25,Karaoke,,0,0,0,karaoke,♪ ...kafamdaki sesi duyabiliyorum. ♪Dialogue: 0,0:01:41.25,0:01:46.38,Karaoke,,0,0,0,karaoke,♪ Haylaz yağmur bana engel olurken bile... ♪Dialogue: 0,0:01:46.39,0:01:51.32,Karaoke,,0,0,0,karaoke,♪ ...kaçmaya çalışmayacağım. ♪Dialogue: 0,0:01:54.42,0:01:56.78,Karaoke,,0,0,0,karaoke,♪ Gel hadi, gidelim. ♪Dialogue: 0,0:01:56.78,0:02:00.06,Karaoke,,0,0,0,karaoke,♪ Asla pes etmeyeceğiz. ♪Dialogue: 0,0:02:00.06,0:02:05.35,Karaoke,,0,0,0,karaoke,♪ Zamanın dalgalarına yenik düşmeyeceğiz. ♪Dialogue: 0,0:02:05.36,0:02:10.99,Karaoke,,0,0,0,karaoke,♪ Tekrar tekrar ayağa kalkacağız. ♪Dialogue: 0,0:02:10.99,0:02:16.35,Karaoke,,0,0,0,karaoke,♪ Çünkü bizim için önemli olanı kaybetmek istemiyoruz. ♪Dialogue: 0,0:02:16.36,0:02:22.05,Karaoke,,0,0,0,karaoke,♪ İnandığımız geleceğe doğru ilerleyelim. ♪