urigana,Duality,30,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,2,0,8,10,10,80,1Style: Translation-furigana,Duality,30,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,1.5,0,2,10,10,10,1Style: Karaoke-furigana,Duality,30,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,1.5,0,8,10,10,10,1Style: Default-furigana,Arial,10,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1,1,2,10,10,10,1Style: Karaoke,Duality,55,&H00FFFFFF,&H000000FF,&H00E4BA0F,&H00000000,0,0,0,0,100,100,0,0,1,3,0,8,10,10,10,1Style: Translation,Duality,60,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,2,10,10,10,1Style: OP13-Translation,Duality,45.0,&H00E24B33,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,2,10,10,18,1Style: Author,Impress BT,25,&H00FFFFFF,&H0000FFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1,1,9,10,10,10,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:03:16.10,0:03:26.10,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazaskerDialogue: 0,0:14:14.80,0:14:24.80,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazaskerDialogue: 0,0:26:35.00,0:26:45.00,Author,,0,0,0,, Türkçeleştirme & Çevirmen   onepacetr.net - kazaskerDialogue: 0,0:02:33.98,0:02:38.00,Main,,0,0,0,,Dumandan ateş tüneli çıkıyor!Dialogue: 0,0:02:38.30,0:02:41.60,Main,,0,0,0,,Hiç değişmiyorsun,...Dialogue: 0,0:02:41.60,0:02:42.74,Main,,0,0,0,,...Luffy!Dialogue: 0,0:02:45.91,0:02:48.74,Main,,0,0,0,,Söylediğim tek kelimeyi dinlemiyorsun.Dialogue: 0,0:02:53.60,0:02:56.96,Main,,0,0,0,,Her zaman en aptalca şeyleri yapıyorsun.Dialogue: 0,0:03:02.70,0:03:07.13,Main,,0,0,0,,Ace!!Dialogue: 0,0:03:16.10,0:03:22.50,Main,,0,0,0,,Değişim Sürecindeki ÇağDialogue: 0,0:03:38.30,0:03:41.37,Main,,0,0,0,,A-Ateş Yumruk Ace...Dialogue: 0,0:03:42.50,0:03:45.54,Main,,0,0,0,,...özgür!Dialogue: 0,0:03:45.54,0:03:48.93,Main,,0,0,0,,Tamamdır! Başardın, Hasır Şapka!Dialogue: 0,0:03:48.93,0:03:51.28,Main,,0,0,0,,Ace'i geri aldın!Dialogue: 0,0:03:51.28,0:03:57.68,Main,,0,0,0,,O, Impel Down'a geldiğinden beri birbiri ardına çılgınca şeyler oldu. Gerçekten...Dialogue: 0,0:03:57.68,0:04:00.36,Main,,0,0,0,,...müthiş biri!Dialogue: 0,0:04:02.51,0:04:06.80,Main,,0,0,0,,Sakın çekilmeyin! Hemen ateşe dönün!Dialogue: 0,0:04:06.80,0:04:08.60,Main,,0,0,0,,Eğimli nişan alın!Dialogue: 0,0:04:08.60,0:04:09.16,Main,,0,0,0,,Emredersiniz!Dialogue: 0,0:04:11.26,0:04:14.70,Main,,0,0,0,,Dikkatli ol, Luffy! Hepsinin canına okuyalım!Dialogue: 0,0:04:14.70,0:04:15.50,Main,,0,0,0,,Tamam!Dialogue: 0,0:04:16.56,0:04:18.39,Main,,0,0,0,,D-Delirdin mi sen?!Dialogue: 0,0:04:21.31,0:04:23.81,Main,,0,0,0,,Alev Emri!Dialogue: 0,0:04:25.05,0:04:26.44,Main,,0,0,0,,Ateş Sütunu!Dialogue: 0,0:04:43.01,0:04:45.03,Main,,0,0,0,,Güçlüler! Dikkatli olun!Dialogue: 0,0:04:49.45,0:04:51.54,Main,,0,0,0,,Dövüşebilir misin, Luffy?Dialogue: 0,0:04:51.54,0:04:53.21,Main,,0,0,0,,Elbette dövüşebilirim!Dialogue: 0,0:04:54.60,0:04:57.08,Main,,0,0,0,,Ace-san! Luffy-kun!Dialogue: 0,0:04:58.78,0:05:02.58,Main,,0,0,0,,Anlaşıldı mı? Ateş Yumruk Ace, ateşten yapılmıştır! Logia Türü!Dialogue: 0,0:05:02.58,0:05:08.14,Main,,0,0,0,,Senin tarafından kurtarılacağım bir günün geleceğini hiçbir zaman hayal etmemiştim.Dialogue: 0,0:05:08.14,0:05:09.95,Main,,0,0,0,,Sağol, Luffy.Dialogue: 0,0:05:12.89,0:05:16.03,Main,,0,0,0,,Beyazsakal ve adamları bana yardım ettiği için.Dialogue: 0,0:05:17.43,0:05:19.79,Main,,0,0,0,,Henüz güvende olduğunuzu sanmayın!Dialogue: 0,0:05:21.44,0:05:24.54,Main,,0,0,0,,Burası idam yeriniz!Dialogue: 0,0:05:35.85,0:05:36.61,Main,,0,0,0,,Şimdi!Dialogue: 0,0:05:36.61,0:05:38.46,Main,,0,0,0,,İndirin onu!Dialogue: 0,0:05:43.01,0:05:46.66,Main,,0,0,0,,O benim kardeşim. Ondan uzak durmanızı istiyorum.Dialogue: 0,0:05:49.93,0:05:51.53,Main,,0,0,0,,Ateş YumrukDialogue: 0,0:05:57.14,0:05:59.44,Main,,0,0,0,,Çok gayretliler.Dialogue: 0,0:05:59.44,0:06:02.27,Main,,0,0,0,,Onlar için kaçış yolu açın!Dialogue: 0,0:06:06.40,0:06:08.86,Main,,0,0,0,,Kaçmalarına izin vermeyin!Dialogue: 0,0:06:11.48,0:06:12.45,Main,,0,0,0,,Ateşböceği Ateşi!Dialogue: 0,0:06:14.10,0:06:15.41,Main,,0,0,0,,Alevli Kukla!Dialogue: 0,0:06:19.02,0:06:21.83,Main,,0,0,0,,Ateş Yumruk ve Hasır Şapka'yı öldürün!Dialogue: 0,0:06:22.46,0:06:24.30,Main,,0,0,0,,Gomu Gomu no...Dialogue: 0,0:06:24.71,0:06:28.27,Main,,0,0,0,,Jet Makineli!Dialogue: 0,0:06:46.47,0:06:49.14,Main,,0,0,0,,Güçlenmişsin, Luffy.Dialogue: 0,0:06:59.23,0:07:01.60,Main,,0,0,0,,Bir gün seni bile geçeceğim!Dialogue: 0,0:07:08.20,0:07:11.04,Main,,0,0,0,,Pekâlâ, şimdilik hala seni korumam gerekiyormuş gibi gözüküyor.Dialogue: 0,0:07:11.58,0:07:12.28,Main,,0,0,0,,O...Dialogue: 0,0:07:14.76,0:07:16.64,Main,,0,0,0,,Buz Blok!Dialogue: 0,0:07:16.64,0:07:18.72,Main,,0,0,0,,Geri dur, Luffy.Dialogue: 0,0:07:20.39,0:07:22.38,Main,,0,0,0,,Sülün Gagası!Dialogue: 0,0:07:22.38,0:07:23.95,Main,,0,0,0,,Ayna Alevi!Dialogue: 0,0:07:45.44,0:07:46.81,Main,,0,0,0,,Filo Amirali!Dialogue: 0,0:07:47.61,0:07:51.52,Main,,0,0,0,,Bu ne rezalet. Ben nasıl...Dialogue: 0,0:07:54.21,0:07:58.66,Main,,0,0,0,,Bırak gitsinler. Böylesi daha eğlenceli olacak.Dialogue: 0,0:07:58.66,0:08:00.25,Main,,0,0,0,,Saçmalama!Dialogue: 0,0:08:01.16,0:08:05.80,Main,,0,0,0,,Amiral'in güçlerine direnebilen birini yenmemiz mümkün değil!Dialogue: 0,0:08:05.80,0:08:07.83,Main,,0,0,0,,Dikkatiniz dağılmasın!Dialogue: 0,0:08:09.42,0:08:11.24,Main,,0,0,0,,Amiral Sakazuki!Dialogue: 0,0:08:12.63,0:08:16.47,Main,,0,0,0,,Buradan kaçmalarına izin vermeyeceğim!Dialogue: 0,0:08:17.61,0:08:20.11,Thoughts,,0,0,0,,Bay İki...Dialogue: 0,0:08:20.11,0:08:24.93,Thoughts,,0,0,0,,Bir şekilde senin isteklerini yerine getirmeyi başardım.Dialogue: 0,0:08:26.13,0:08:28.80,Thoughts,,0,0,0,,Ben de bir an önce buradan kaçmalıyım.Dialogue: 0,0:08:28.80,0:08:31.16,Main,,0,0,0,,Bu hain kimin adamı?!Dialogue: 0,0:08:32.55,0:08:35.85,Main,,0,0,0,,Hayır! O mahkumlardan biri!Dialogue: 0,0:08:35.85,0:08:37.63,Main,,0,0,0,,Eyvah!Dialogue: 0,0:08:42.40,0:08:46.64,Main,,0,0,0,,Herkes yoldan çekilsin! Düşman gemisi harekete geçti!Dialogue: 0,0:08:46.64,0:08:49.84,Main,,0,0,0,,Daha fazla yaklaşmayın! Çok hızlı!Dialogue: 0,0:08:50.49,0:08:52.64,Main,,0,0,0,,Hey! Onu kim kullanıyor?!Dialogue: 0,0:08:55.45,0:08:56.70,Main,,0,0,0,,Squardo!Dialogue: 0,0:08:56.70,0:08:58.95,Main,,0,0,0,,Girdap Örümcek Korsanları!Dialogue: 0,0:09:00.84,0:09:05.12,Main,,0,0,0,,Babalık! Arkadaşlar! Kaçın!Dialogue: 0,0:09:05.12,0:09:08.93,Main,,0,0,0,,Savaş alanında kalıp sizi koruyacağız!Dialogue: 0,0:09:13.50,0:09:16.27,Main,,0,0,0,,Ahmaklar...Dialogue: 0,0:09:26.95,0:09:29.75,Main,,0,0,0,,Aptallaşma, Squardo!Dialogue: 0,0:09:29.75,0:09:32.42,Main,,0,0,0,,Ölmeyi mi planlıyorsun?!Dialogue: 0,0:09:36.47,0:09:38.84,Main,,0,0,0,,Elbette...Dialogue: 0,0:09:39.66,0:09:42.99,Main,,0,0,0,,Babalık'a korkunç bir şey yaptım.Dialogue: 0,0:09:49.02,0:09:52.15,Main,,0,0,0,,Bu bile günahlarıma kefaret olmaz.Dialogue: 0,0:09:52.15,0:09:55.56,Main,,0,0,0,,Bunu yapmasaydım, asla huzur bulamazdım!Dialogue: 0,0:09:58.28,0:10:02.75,Main,,0,0,0,,Üzgünüm beyler. Sizi de bu işe sürükledim.Dialogue: 0,0:10:02.75,0:10:05.70,Main,,0,0,0,,Sorun değil, Kaptan. Dert etme.Dialogue: 0,0:10:05.70,0:10:07.95,Main,,0,0,0,,İstediğimiz için peşinden geldik!Dialogue: 0,0:10:07.95,0:10:10.49,Main,,0,0,0,,Nerede öleceğimize kendimiz karar vereceğiz!Dialogue: 0,0:10:10.49,0:10:13.93,Main,,0,0,0,,Kaptan! Peşinden geleceğiz!Dialogue: 0,0:10:14.78,0:10:16.48,Main,,0,0,0,,Üzgünüm...Dialogue: 0,0:10:17.70,0:10:21.33,Main,,0,0,0,,Ace'i de alıp kaçın!Dialogue: 0,0:10:21.33,0:10:23.74,Main,,0,0,0,,Kutsal Ateş - Denizdeki Gizemli IşıkDialogue: 0,0:10:29.46,0:10:30.88,Main,,0,0,0,,Ne aptal ama.Dialogue: 0,0:10:32.25,0:10:37.38,Main,,0,0,0,,Lanet olası Squardo... İşleri ne kadar gösterişli bir yoldan yapıyor.Dialogue: 0,0:10:37.38,0:10:40.89,Main,,0,0,0,,Hey! Hemen şu kelepçeleri çıkar!Dialogue: 0,0:10:48.17,0:10:49.62,Main,,0,0,0,,O da neydi?Dialogue: 0,0:10:49.62,0:10:52.50,Main,,0,0,0,,Gemi durdu!Dialogue: 0,0:11:00.20,0:11:01.97,Main,,0,0,0,,Babalık!Dialogue: 0,0:11:09.29,0:11:15.85,Main,,0,0,0,,Bir baba için, kendi çocuğunun gözleri önünde öldüğünü görmenin ne kadar...Dialogue: 0,0:11:15.85,0:11:20.66,Main,,0,0,0,,...acı verici olduğunu farketmiyor musun, Squardo?!Dialogue: 0,0:11:22.10,0:11:23.93,Main,,0,0,0,,Haddini aşma!Dialogue: 0,0:11:24.69,0:11:30.67,Main,,0,0,0,,Senin kılıç saplamanla ölecek kadar güçsüz değilim!Dialogue: 0,0:11:30.67,0:11:34.19,Main,,0,0,0,,Ama herkes bir gün ölür!Dialogue: 0,0:11:43.41,0:11:46.55,Main,,0,0,0,,Buradaki görevimizi tamamladık.Dialogue: 0,0:11:46.55,0:11:51.00,Main,,0,0,0,,Artık başka işimiz kalmadı!Dialogue: 0,0:11:51.00,0:11:53.76,Main,,0,0,0,,Babalık!Dialogue: 0,0:11:57.96,0:12:02.81,Main,,0,0,0,,İyi dinleyin, Beyazsakal Korsanları!Dialogue: 0,0:12:05.70,0:12:10.78,Main,,0,0,0,,Şu anda vermek üzere olduğum emir, kaptan olarak son emrim olacak!Dialogue: 0,0:12:10.78,0:12:15.38,Main,,0,0,0,,Son mu?! Dur, Babalık! Bu kadar uğursuz bir şeyi duymak istemiyorum!Dialogue: 0,0:12:15.38,0:12:17.65,Main,,0,0,0,,Duymak istemiyorum!Dialogue: 0,0:12:17.65,0:12:20.32,Main,,0,0,0,,Birlikte Yeni Dünya'ya dönüyoruz, değil mi?!Dialogue: 0,0:12:22.20,0:12:24.52,Main,,0,0,0,,Çapraz AteşDialogue: 0,0:12:25.14,0:12:26.56,Main,,0,0,0,,Babalık!Dialogue: 0,0:12:26.56,0:12:30.04,Main,,0,0,0,,Sizinle burada ayrılıyoruz!Dialogue: 0,0:12:30.38,0:12:36.80,Main,,0,0,0,,Hepiniz mutlaka hayatta kalın ve Yeni Dünya'da tekrardan birleşin!Dialogue: 0,0:12:44.98,0:12:48.46,Main,,0,0,0,,B-Babalık! Burada ölmeyi mi planlıyorsun?!Dialogue: 0,0:12:48.46,0:12:52.78,Main,,0,0,0,,Ben, bu devrin zirvesindeki kişiyim!Dialogue: 0,0:12:52.78,0:12:58.16,Main,,0,0,0,,Beni yeni çağa taşıyacak bir gemi yok!Dialogue: 0,0:13:00.54,0:13:04.96,Main,,0,0,0,,Gidin beyler!Dialogue: 0,0:13:15.30,0:13:16.81,Main,,0,0,0,,Beyazsakal!Dialogue: 0,0:13:16.81,0:13:19.35,Main,,0,0,0,,Olmaz! Babalık!Dialogue: 0,0:13:19.35,0:13:21.68,Main,,0,0,0,,Kaptanın emri! Kıpırda!Dialogue: 0,0:13:21.68,0:13:22.97,Main,,0,0,0,,Yaşlı adam!Dialogue: 0,0:13:22.97,0:13:24.77,Main,,0,0,0,,Babalık!Dialogue: 0,0:13:38.53,0:13:40.83,Flashbacks,,0,0,0,,Müthiş!Dialogue: 0,0:13:41.28,0:13:44.59,Flashbacks,,0,0,0,,Hey! Niye orada kendi başına oturuyorsun?Dialogue: 0,0:13:44.59,0:13:47.72,Flashbacks,,0,0,0,,Gel buraya! Bir sürü hazinemiz var!Dialogue: 0,0:13:47.72,0:13:53.01,Flashbacks,,0,0,0,,Onu boşver. Hazineyle ilgilenmiyor.Dialogue: 0,0:13:53.01,0:13:57.45,Flashbacks,,0,0,0,,Çok tuhaf! Hazineyi önemsemeyen bir korsan mı?Dialogue: 0,0:13:57.45,0:14:00.66,Flashbacks,,0,0,0,,Ne istiyorsun o zaman?Dialogue: 0,0:14:00.66,0:14:03.14,Flashbacks,,0,0,0,,Hey, Newgate!Dialogue: 0,0:14:03.99,0:14:09.03,Main,,0,0,0,,Epey uzun bir yolculuk yaptım.Dialogue: 0,0:14:09.90,0:14:12.64,Main,,0,0,0,,Bu işi bitirelim artık...Dialogue: 0,0:14:12.64,0:14:14.60,Main,,0,0,0,,...Denizciler!Dialogue: 0,0:14:19.10,0:14:20.86,Main,,0,0,0,,Marineford tehlikede!Dialogue: 0,0:14:20.86,0:14:22.80,Main,,0,0,0,,Beyazsakal'ı durdurun!Dialogue: 0,0:14:22.80,0:14:24.04,Captions,,0,0,300,,Mutlak AdaletDialogue: 0,0:14:26.05,0:14:28.45,Main,,0,0,0,,Gerçekten tüm adayı yok etmeyi planlıyor!Dialogue: 0,0:14:29.01,0:14:31.00,Main,,0,0,0,,Babalık!Dialogue: 0,0:14:31.00,0:14:34.56,Main,,0,0,0,,Seni geride bırakmak istemiyorum! Birlikte dönelim!Dialogue: 0,0:14:34.56,0:14:37.15,Main,,0,0,0,,Babalık!Dialogue: 0,0:14:37.15,0:14:40.19,Main,,0,0,0,,Kaptanın emirlerine karşı mı geliyorsunuz?!Dialogue: 0,0:14:40.19,0:14:42.82,Main,,0,0,0,,Gidin, sizi embesiller!Dialogue: 0,0:14:42.82,0:14:47.20,Main,,0,0,0,,Şimdi! Beyazsakal'ı vurun! Neredeyse öldü!Dialogue: 0,0:14:53.14,0:14:55.37,Main,,0,0,0,,Babalık!Dialogue: 0,0:14:55.37,0:14:58.49,Main,,0,0,0,,Acele et! Dediğini yapmalıyız!Dialogue: 0,0:14:58.49,0:15:01.98,Main,,0,0,0,,Gerçekten Babalık'ı burada tek başına bırakabilir misin?!Dialogue: 0,0:15:01.98,0:15:03.59,Main,,0,0,0,,Evet, doğru!Dialogue: 0,0:15:03.59,0:15:07.39,Main,,0,0,0,,Aptal! Hiçbirimiz bundan hoşlanmıyoruz!Dialogue: 0,0:15:07.39,0:15:08.29,Main,,0,0,0,,O zaman...Dialogue: 0,0:15:08.29,0:15:10.77,Main,,0,0,0,,Burada kalır ve öldürülürsek...Dialogue: 0,0:15:10.77,0:15:14.52,Main,,0,0,0,,...ölmeye hazırlanarak buraya gelen Babalık'ın suratına tükürmüş oluruz!Dialogue: 0,0:15:14.52,0:15:17.33,Main,,0,0,0,,Bunu anlamıyor musunuz?!Dialogue: 0,0:15:20.36,0:15:21.93,Main,,0,0,0,,Babalık.Dialogue: 0,0:15:26.19,0:15:28.21,Main,,0,0,0,,Denize açılmaya hazırlanın! Çabuk!Dialogue: 0,0:15:29.67,0:15:30.91,Main,,0,0,0,,Ace!Dialogue: 0,0:15:44.69,0:15:48.06,Main,,0,0,0,,Yelken açıyoruz! Buraya! Çabuk!Dialogue: 0,0:15:55.48,0:15:57.97,Main,,0,0,0,,Kumandan Marco! Gidelim!Dialogue: 0,0:15:59.07,0:16:01.07,Main,,0,0,0,,Babalık...Dialogue: 0,0:16:02.71,0:16:04.28,Main,,0,0,0,,Filo Amirali Sengoku.Dialogue: 0,0:16:04.28,0:16:07.78,Main,,0,0,0,,Ateş Yumruk Ace'e zarar verme riski ortadan kalktığı için,...Dialogue: 0,0:16:08.19,0:16:12.92,Main,,0,0,0,,...Marineford'u denizin dibine gönderme konusunda niyeti ciddi.Dialogue: 0,0:16:12.92,0:16:15.79,Main,,0,0,0,,Kendi canıyla birlikte.Dialogue: 0,0:16:16.43,0:16:18.56,Main,,0,0,0,,Koramiral Garp! İyisiniz!Dialogue: 0,0:16:19.19,0:16:23.92,Main,,0,0,0,,Demek bu çağa son veriyor. Zamanı gelmişti.Dialogue: 0,0:16:24.90,0:16:27.15,Main,,0,0,0,,Beyazsakal'a kılıç saplandıktan sonra ne oldu?!Dialogue: 0,0:16:27.15,0:16:31.37,Main,,0,0,0,,Onun ihanetinden sonra Beyazsakal'ın müttefikleri perişan mı oldu?!Dialogue: 0,0:16:31.37,0:16:34.72,Main,,0,0,0,,Hala görüntü alamıyor musunuz?!Dialogue: 0,0:16:34.72,0:16:36.54,Main,,0,0,0,,Ne?!Dialogue: 0,0:16:36.54,0:16:39.68,Main,,0,0,0,,Gözlemci Den Den Mushi hala dışarı çıkmıyor mu?!Dialogue: 0,0:16:39.68,0:16:47.22,Main,,0,0,0,,Kahretsin. Tam da Kaptan Buggy, Beyazsakal'ın işini bitirmek üzereyken kaçtı!Dialogue: 0,0:16:47.22,0:16:49.74,Thoughts,,0,0,0,,Bu kadar küstah olma, seni aptal!Dialogue: 0,0:16:49.74,0:16:53.99,Thoughts,,0,0,0,,Yarı ölü haldeyken bile Beyazsakal'ın gücü sınırsız...Dialogue: 0,0:16:53.99,0:16:59.24,Thoughts,,0,0,0,,...ve ben onun başını alabileceğimi düşündüm... Ne biçim iş!Dialogue: 0,0:16:59.24,0:17:02.66,Thoughts,,0,0,0,,Bunu yapabilmem mümkün değil! İmkânı yok!Dialogue: 0,0:17:02.66,0:17:07.96,Main,,0,0,0,,Olamaz! Kaptan Buggy'nin zafer anını tüm dünyaya yayınlayacağız!Dialogue: 0,0:17:07.96,0:17:11.30,Main,,0,0,0,,Onu zorla çıkarmalıyız!Dialogue: 0,0:17:12.34,0:17:13.89,Main,,0,0,0,,Çık oradan!Dialogue: 0,0:17:13.89,0:17:15.72,Main,,0,0,0,,Seni ateşle çıkarmamızı mı istiyorsun?!Dialogue: 0,0:17:16.65,0:17:19.55,Main,,0,0,0,,Gözlemci Den Den Mushi kendi başına çıktı!Dialogue: 0,0:17:19.55,0:17:22.99,Main,,0,0,0,,Tamam, bırakın görsünler!Dialogue: 0,0:17:24.62,0:17:25.85,Main,,0,0,0,,Hey, bakın!Dialogue: 0,0:17:25.85,0:17:26.89,Main,,0,0,0,,Yayın başladı!Dialogue: 0,0:17:26.89,0:17:28.20,Main,,0,0,0,,Ah, şey...Dialogue: 0,0:17:28.20,0:17:30.73,Main,,0,0,0,,Gözlemci Den Den Mushi'yi biraz daha aşağı indir!Dialogue: 0,0:17:34.15,0:17:38.57,Main,,0,0,0,,Herkese merhaba. Ben Buggy. Efsanevi!Dialogue: 0,0:17:39.30,0:17:41.60,Main,,0,0,0,,Yine mi sen?!Dialogue: 0,0:17:41.60,0:17:43.78,Main,,0,0,0,,Hemen çıkın buradan!Dialogue: 0,0:17:44.33,0:17:49.24,Main,,0,0,0,,Herkesi alıp gitmeli ve Yeni Dünya'da tekrar birleşmeliyiz!Dialogue: 0,0:17:49.24,0:17:52.82,Main,,0,0,0,,Korsanların kaçmasına izin vermeyin! Vurabildiğiniz kadarını vurun!Dialogue: 0,0:17:52.82,0:17:57.50,Main,,0,0,0,,Rakibiniz sadece ve sadece benim!Dialogue: 0,0:18:01.09,0:18:02.59,Main,,0,0,0,,Kumandan Jozu!Dialogue: 0,0:18:02.59,0:18:06.34,Main,,0,0,0,,Kumandan böyle bir şeyden ölmemeli!Dialogue: 0,0:18:06.34,0:18:08.71,Main,,0,0,0,,Kaptanın emri! Birlikte gidelim!Dialogue: 0,0:18:09.97,0:18:13.64,Main,,0,0,0,,Blenheim! Jozu'yu taşımamıza yardım et!Dialogue: 0,0:18:15.61,0:18:18.78,Main,,0,0,0,,Hasır Şapkalı çocuk! Ne diye bekliyorsun?!Dialogue: 0,0:18:18.78,0:18:21.88,Main,,0,0,0,,Ace, gidelim! Yaşlı adam kararını vermiş!Dialogue: 0,0:18:28.37,0:18:31.32,Main,,0,0,0,,Biliyorum. Onun çabalarını boşa çıkarmayacağım.Dialogue: 0,0:18:33.32,0:18:36.04,Main,,0,0,0,,Hepiniz yoldan çekilin!Dialogue: 0,0:19:21.96,0:19:25.91,Main,,0,0,0,,Kelimelere ihtiyaç yok.Dialogue: 0,0:19:32.97,0:19:36.83,Main,,0,0,0,,Benim için bir tek soruya cevap ver, Ace.Dialogue: 0,0:19:40.22,0:19:44.82,Main,,0,0,0,,İyi bir baba mıydım?Dialogue: 0,0:19:50.45,0:19:53.12,Flashbacks,,0,0,0,,Hala ayağa mı kalkmaya çalışıyorsun?Dialogue: 0,0:19:53.12,0:19:56.77,Flashbacks,,0,0,0,,Burada ölüşünü görmek istemem, çocuk.Dialogue: 0,0:19:56.77,0:20:03.28,Flashbacks,,0,0,0,,Hala dövüşmek istiyorsan, adımı al ve denizlerde özgürce kükre!Dialogue: 0,0:20:04.11,0:20:06.38,Flashbacks,,0,0,0,,Oğlum ol!Dialogue: 0,0:20:15.64,0:20:17.93,Main,,0,0,0,,Elbette öyleydin!Dialogue: 0,0:20:32.41,0:20:35.08,Main,,0,0,0,,Koşun! Gemiye koşun!Dialogue: 0,0:20:37.28,0:20:40.40,Main,,0,0,0,,Ace-san! Luffy-kun! Koşun!Dialogue: 0,0:20:40.40,0:20:41.32,Main,,0,0,0,,Jinbe!Dialogue: 0,0:20:41.32,0:20:43.91,Main,,0,0,0,,İkinize nişan alıyorlar.Dialogue: 0,0:20:43.91,0:20:48.46,Main,,0,0,0,,Babalık, mümkün olduğunca fazla kişinin hayatta kalmasını istiyor!Dialogue: 0,0:20:48.46,0:20:49.78,Thoughts,,0,0,0,,Babalık...Dialogue: 0,0:20:51.86,0:20:54.93,Main,,0,0,0,,Savaş gemisi çaldık! Binin!Dialogue: 0,0:21:00.02,0:21:04.88,Main,,0,0,0,,Gerçekten kaçmanıza izin vereceğimi mi sanıyorsunuz? Bu ne iyimserlik.Dialogue: 0,0:21:04.88,0:21:06.98,Main,,0,0,0,,Amiral Sakazuki!Dialogue: 0,0:21:06.98,0:21:10.55,Main,,0,0,0,,Çekilin beyler.Dialogue: 0,0:21:19.72,0:21:23.29,Main,,0,0,0,,Doğruca gemiye koşmaya devam edin!Dialogue: 0,0:21:26.12,0:21:29.69,Main,,0,0,0,,Ateş Yumruk Ace'i serbest bırakıp, güvenli bir şekilde geri çekilebileceğinizi mi sanıyorsunuz?Dialogue: 0,0:21:29.69,0:21:33.57,Main,,0,0,0,,Siz Beyazsakal Korsanları ne kadar embesilsiniz!Dialogue: 0,0:21:33.57,0:21:34.71,Main,,0,0,0,,Ne?!Dialogue: 0,0:21:34.71,0:21:37.27,Main,,0,0,0,,Bizi kışkırtmaya çalışıyor!Dialogue: 0,0:21:37.27,0:21:40.58,Main,,0,0,0,,Durmamızı istediği aşikâr!Dialogue: 0,0:21:40.58,0:21:46.66,Main,,0,0,0,,Ama kaptanınıza bakınca şaşırmamalı.Dialogue: 0,0:21:46.66,0:21:50.52,Main,,0,0,0,,Sonuçta Beyazsakal, ölü çağdan kalma...Dialogue: 0,0:21:52.11,0:21:54.09,Main,,0,0,0,,...bir ezikten başka bir şey değil!Dialogue: 0,0:21:56.33,0:21:57.53,Main,,0,0,0,,Ace!Dialogue: 0,0:21:59.03,0:22:01.20,Main,,0,0,0,,Ezik?!Dialogue: 0,0:22:03.36,0:22:06.37,Main,,0,0,0,,Söylediğini geri al!Dialogue: 0,0:22:06.37,0:22:08.97,Main,,0,0,0,,Yapma, Ace! Sakın koşmayı bırakma!Dialogue: 0,0:22:08.97,0:22:11.38,Main,,0,0,0,,Bırak konuşsun dursun!Dialogue: 0,0:22:12.99,0:22:15.71,Main,,0,0,0,,Babalık hakkında kötü konuştu!Dialogue: 0,0:22:15.71,0:22:16.81,Main,,0,0,0,,Ace!Dialogue: 0,0:22:16.81,0:22:18.73,Main,,0,0,0,,Söylediğimi geri mi alayım?Dialogue: 0,0:22:19.29,0:22:23.79,Main,,0,0,0,,Kesinlikle bunu yapmaya niyetim yok. Niye yapayım ki?Dialogue: 0,0:22:24.58,0:22:28.76,Main,,0,0,0,,Baban Gold Roger, tüm Grand Line'ı fethetti.Dialogue: 0,0:22:28.76,0:22:35.20,Main,,0,0,0,,Yeni bir çağa, Büyük Korsanlar Çağı'na yol açmak için canını verdi.Dialogue: 0,0:22:36.15,0:22:38.72,Main,,0,0,0,,Benim gibi bir Denizci muhtemelen bunu söylememeli,...Dialogue: 0,0:22:38.72,0:22:42.51,Main,,0,0,0,,...ama o adam gerçekten "Korsanlar Kralı" unvanını hak etti.Dialogue: 0,0:22:42.51,0:22:46.91,Main,,0,0,0,,Bununla mukayese edildiğinde Beyazsakal nedir?Dialogue: 0,0:22:47.78,0:22:52.21,Main,,0,0,0,,Demek istediğim, hiç Roger'a karşı dövüşecek cesareti oldu mu?Dialogue: 0,0:22:52.21,0:22:59.79,Main,,0,0,0,,Tüm yaptığı dünyanın güvenli bir köşesinde saklanmak ve beladan uzak durmaktı, değil mi?Dialogue: 0,0:22:59.79,0:23:06.84,Main,,0,0,0,,Bazıları günümüzde, sadece Beyazsakal adının bile çeşitli adalarda barışı koruduğunu iddia ediyor.Dialogue: 0,0:23:06.84,0:23:15.04,Main,,0,0,0,,Bana göre sadece önemsiz kimselere gözdağı verip kahraman olduğuna inanıyor. Saçmalık!Dialogue: 0,0:23:15.04,0:23:19.39,Main,,0,0,0,,Roger yaşadığı sürece onurunu korudu...Dialogue: 0,0:23:19.39,0:23:23.28,Main,,0,0,0,,...ve ölüyken bile, korsan yandaşları ona kral olarak hitap etti.Dialogue: 0,0:23:23.28,0:23:28.36,Main,,0,0,0,,Yani Beyazsakal, Roger'ı asla geçemeyecek olan nihai bir ezik!Dialogue: 0,0:23:28.36,0:23:31.69,Main,,0,0,0,,O bu kadar işte. Söylediğim her şey doğru.Dialogue: 0,0:23:33.59,0:23:39.64,Main,,0,0,0,,Düşünüyorum da, gerçekten acınası bir adam.  Adamlarına "Babalık", "Baba" ya da her neyse söyletiyor...Dialogue: 0,0:23:39.64,0:23:42.67,Main,,0,0,0,,...ve aile rolü yaparak denizlerde dolaşıyor.Dialogue: 0,0:23:42.67,0:23:43.87,Main,,0,0,0,,Kes şunu.Dialogue: 0,0:23:43.87,0:23:46.71,Main,,0,0,0,,Yıllarca denizlerde hüküm sürdü,...Dialogue: 0,0:23:46.71,0:23:49.80,Main,,0,0,0,,...ama yine de kral olmadı ve bir şey kazanmadı.Dialogue: 0,0:23:49.80,0:23:55.81,Main,,0,0,0,,Söylediğim her şeye inanan şu ahmak "evlatlar" ından biri tarafından kılıçlandı...Dialogue: 0,0:23:55.81,0:23:58.18,Main,,0,0,0,,...ve şimdi aynı ahmağı korumak için ölecek.Dialogue: 0,0:23:58.74,0:24:02.21,Main,,0,0,0,,Gerçekten boş bir varlık.Dialogue: 0,0:24:03.09,0:24:04.15,Main,,0,0,0,,Kes şunu!Dialogue: 0,0:24:04.15,0:24:05.86,Main,,0,0,0,,Sakın kanma, Ace! Geri dön!Dialogue: 0,0:24:05.86,0:24:10.69,Main,,0,0,0,,Babalık bize ait olduğumuz bir yer verdi!Dialogue: 0,0:24:10.69,0:24:14.78,Main,,0,0,0,,Babalık'ın büyüklüğü hakkında ne biliyorsun?!Dialogue: 0,0:24:15.83,0:24:20.38,Main,,0,0,0,,Bir adam dürüstçe yaşamıyorsa, yaşamayı hiç hak etmez!Dialogue: 0,0:24:20.38,0:24:24.07,Main,,0,0,0,,Siz düzenbaz korsanlar, "ait olacak bir yer" hak etmiyorsunuz!Dialogue: 0,0:24:24.07,0:24:25.31,Main,,0,0,0,,Kes şunu!Dialogue: 0,0:24:25.47,0:24:31.15,Main,,0,0,0,,Beyazsakal ezik olarak ölecek! Büyük havuzdaki küçük balığa yaraşır bir son!Dialogue: 0,0:24:31.15,0:24:34.72,Main,,0,0,0,,Beyazsakal, bu devri oluşturan büyük bir korsan!Dialogue: 0,0:24:38.39,0:24:42.19,Main,,0,0,0,,Hayatımı kurtaran adamla alay etme!Dialogue: 0,0:24:42.19,0:24:44.16,Main,,0,0,0,,Kes şunu, Ace!Dialogue: 0,0:24:44.16,0:24:47.43,Main,,0,0,0,,Bu çağın adı, "Beyazsakal"!Dialogue: 0,0:24:58.68,0:25:04.18,Main,,0,0,0,,Beyazsakal ve ona babamız diyen siz ahmaklar, aynı eziklik kaderini paylaşıyorsunuz!Dialogue: 0,0:25:09.12,0:25:10.79,Main,,0,0,0,,Ace yandı!Dialogue: 0,0:25:15.99,0:25:22.18,Main,,0,0,0,,Tüm Şeytan Meyveleri'nin en güçlüsü olan Logia türünden yediğin için kendine aşırı güveniyordun, değil mi?Dialogue: 0,0:25:22.18,0:25:27.17,Main,,0,0,0,,Sen sadece ateşsin.  Ben, alevleri bile yakan magmayım!Dialogue: 0,0:25:27.48,0:25:31.74,Main,,0,0,0,,Senin gücünle benimki arasında devasa bir fark var!Dialogue: 0,0:25:31.74,0:25:33.78,Main,,0,0,0,,Ace!Dialogue: 0,0:25:36.08,0:25:39.65,Main,,0,0,0,,Hey, Luffy-kun! Sınırına ulaştın!Dialogue: 0,0:25:42.92,0:25:44.45,Main,,0,0,0,,Ace'in Yaşam Kartı.Dialogue: 0,0:25:47.12,0:25:51.56,Main,,0,0,0,,Korsanlar Kralı Gold Roger. Devrimci dragon.Dialogue: 0,0:25:51.56,0:25:55.85,Main,,0,0,0,,Bu iki adamın oğullarının üvey kardeş olması epey korkutucu bir düşünce.Dialogue: 0,0:25:56.59,0:25:59.71,Main,,0,0,0,,Kaderin belirlendi!Dialogue: 0,0:25:59.71,0:26:04.81,Main,,0,0,0,,Başka kim kaçarsa kaçsın, ikinizin kaçmasına asla izin vermeyeceğime yemin ederim!Dialogue: 0,0:26:05.10,0:26:06.78,Main,,0,0,0,,Şimdi iyi bak.Dialogue: 0,0:26:10.01,0:26:11.48,Main,,0,0,0,,Dur!Dialogue: 0,0:26:13.59,0:26:15.19,Main,,0,0,0,,Luffy!Dialogue: 0,0:00:25.37,0:00:30.62,OP13-Translation,,0,0,0,karaoke,♪ Her seferinde yağmurdan sonra gökyüzüne bakıyorum. ♪Dialogue: 0,0:00:30.62,0:00:36.13,OP13-Translation,,0,0,0,karaoke,♪ Henüz sulugöz olduğum zamanları düşünüyorum. ♪Dialogue: 0,0:00:36.13,0:00:43.87,OP13-Translation,,0,0,0,karaoke,♪ Umutsuzca birinin arkasından koşuyorum,... ♪Dialogue: 0,0:00:43.94,0:00:46.85,OP13-Translation,,0,0,0,karaoke,♪ ..."Daha güçlü olmak istiyorum," diye düşünerek. ♪Dialogue: 0,0:00:46.85,0:00:52.03,OP13-Translation,,0,0,0,karaoke,♪ "Teşekkürüm" şimdi rüzgârda kayboldu,... ♪Dialogue: 0,0:00:52.20,0:00:57.21,OP13-Translation,,0,0,0,karaoke,♪ ...daha güçlü olabilir miyim? ♪Dialogue: 0,0:00:57.41,0:01:02.88,OP13-Translation,,0,0,0,karaoke,♪ Cevabımı bulamıyorum. ♪Dialogue: 0,0:01:03.01,0:01:08.40,OP13-Translation,,0,0,0,karaoke,♪ Bu yüzden ilerlemeye devam edeceğim. ♪Dialogue: 0,0:01:08.55,0:01:11.03,OP13-Translation,,0,0,0,karaoke,♪ Gel hadi, gidelim. ♪Dialogue: 0,0:01:11.03,0:01:14.24,OP13-Translation,,0,0,0,karaoke,♪ Asla pes etmeyeceğiz. ♪Dialogue: 0,0:01:14.24,0:01:19.48,OP13-Translation,,0,0,0,karaoke,♪ Zamanın dalgalarına yenik düşmeyeceğiz. ♪Dialogue: 0,0:01:19.48,0:01:25.09,OP13-Translation,,0,0,0,karaoke,♪ Tekrar tekrar ayağa kalkacağız. ♪Dialogue: 0,0:01:25.10,0:01:30.73,OP13-Translation,,0,0,0,karaoke,♪ Çünkü bizim için önemli olanı kaybetmek istemiyoruz. ♪Dialogue: 0,0:01:30.74,0:01:35.85,OP13-Translation,,0,0,0,karaoke,♪ Beni sürekli, sürekli ilerlemeye zorlayan... ♪Dialogue: 0,0:01:35.86,0:01:41.25,OP13-Translation,,0,0,0,karaoke,♪ ...kafamdaki sesi duyabiliyorum. ♪Dialogue: 0,0:01:41.25,0:01:46.38,OP13-Translation,,0,0,0,karaoke,♪ Haylaz yağmur bana engel olurken bile... ♪Dialogue: 0,0:01:46.39,0:01:51.32,OP13-Translation,,0,0,0,karaoke,♪ ...kaçmaya çalışmayacağım. ♪Dialogue: 0,0:01:54.42,0:01:56.78,OP13-Translation,,0,0,0,karaoke,♪ Gel hadi, gidelim. ♪Dialogue: 0,0:01:56.78,0:02:00.06,OP13-Translation,,0,0,0,karaoke,♪ Asla pes etmeyeceğiz. ♪Dialogue: 0,0:02:00.06,0:02:05.35,OP13-Translation,,0,0,0,karaoke,♪ Zamanın dalgalarına yenik düşmeyeceğiz. ♪Dialogue: 0,0:02:05.36,0:02:10.99,OP13-Translation,,0,0,0,karaoke,♪ Tekrar tekrar ayağa kalkacağız. ♪Dialogue: 0,0:02:10.99,0:02:16.35,OP13-Translation,,0,0,0,karaoke,♪ Çünkü bizim için önemli olanı kaybetmek istemiyoruz. ♪Dialogue: 0,0:02:16.36,0:02:22.05,OP13-Translation,,0,0,0,karaoke,♪ İnandığımız geleceğe doğru ilerleyelim. ♪