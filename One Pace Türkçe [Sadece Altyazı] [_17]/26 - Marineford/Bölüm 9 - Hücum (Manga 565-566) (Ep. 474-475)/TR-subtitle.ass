Dialogue: 0,0:26:20.00,0:26:30.00,Author,,0,0,0,,{\fad(500,500)\fs18} Türkçeleştirme & Çevirmen  {\fs}\N{\c&HFFCB00&\b1}onepacetr.net{\b0\c&HFFFFFF&} - {\c&H01BAFF&}{\b1}kazasker{\b0}{\c&HFFFFFF&}
Dialogue: 0,0:02:35.70,0:02:37.34,Main,,0,0,0,,Yayın neden kesildi?!
Dialogue: 0,0:02:37.34,0:02:39.02,Main,,0,0,0,,Bize Marineford'u gösterin!
Dialogue: 0,0:02:39.02,0:02:40.54,Main,,0,0,0,,Gösterin artık
Dialogue: 0,0:02:40.54,0:02:45.58,Main,,0,0,0,,Gözlemci Den Den Mushilerine bir şey\Nolmuş olmalı, yapabileceğimiz bir şey yok!
Dialogue: 0,0:02:45.58,0:02:49.35,Main,,0,0,0,,Denizciler ve Beyazsakal anlaşma mı\Nyapmış? Bu doğru olabilir mi?!
Dialogue: 0,0:02:52.42,0:02:53.75,Main,,0,0,0,,Bize bir şey gösterin!
Dialogue: 0,0:02:54.10,0:02:56.69,Main,,0,0,0,,Beyazsakal müttefiklerini gerçekten satıyor mu?
Dialogue: 0,0:02:59.09,0:03:01.06,Main,,0,0,0,,Bu savaşta neler oluyor?!
Dialogue: 0,0:03:02.83,0:03:05.86,Main,,0,0,0,,Dünyaya ne olacak?!
Dialogue: 0,0:03:14.67,0:03:18.33,Main,,0,0,0,,Denizcilerden ne kadar\Nsinir bozucu bir hamle geldi.
Dialogue: 0,0:03:18.33,0:03:20.68,Main,,0,0,0,,Sanırım gösteri bitti, ha?
Dialogue: 0,0:03:20.68,0:03:24.38,Main,,0,0,0,,Sırf savaşı izleyebilmek için buraya geri döndük.
Dialogue: 0,0:03:24.38,0:03:26.16,Main,,0,0,0,,Ama Gözlemci Den Den Mushilerle\Nilgili sorun mu yaşıyorlar?
Dialogue: 0,0:03:26.16,0:03:28.19,Main,,0,0,0,,Bunun doğru olması mümkün değil.
Dialogue: 0,0:03:28.19,0:03:29.72,Main,,0,0,0,,Ha? Değil mi?
Dialogue: 0,0:03:29.72,0:03:34.69,Main,,0,0,0,,Gerçekten aptalsın. Bir şey gizledikleri besbelli.
Dialogue: 0,0:03:34.69,0:03:37.97,Main,,0,0,0,,Korsanların ya da başka kimsenin\Ngörmesini istemedikleri bir şey.
Dialogue: 0,0:03:47.64,0:03:49.79,Main,,0,0,0,,Kaptan Bonnie...
Dialogue: 0,0:03:49.79,0:03:51.91,Main,,0,0,0,,Kapa çeneni! Beni rahat bırak!
Dialogue: 0,0:03:51.91,0:03:54.60,Main,,0,0,0,,Beyazsakal müttefiklerini mi satmış?
Dialogue: 0,0:03:54.60,0:04:00.05,Main,,0,0,0,,Hiç de bile. Asla öyle bir şey\Nyapmadığı için efsane zaten.
Dialogue: 0,0:04:00.19,0:04:05.42,Title,,0,0,0,,{\fad(1000,0)}Hücum{\pos(643,485)}
Dialogue: 0,0:04:00.50,0:04:01.88,Main,,0,0,0,,Yola çıkma vakti, Bepo.
Dialogue: 0,0:04:01.88,0:04:03.52,Main,,0,0,0,,Hay hay, Kaptan!
Dialogue: 0,0:04:03.52,0:04:05.42,Main,,0,0,0,,Benimle gel, Jambarl!
Dialogue: 0,0:04:05.42,0:04:08.76,Main,,0,0,0,,Evet. Yakın zamanda da düzelecek gibi görünmüyor.
Dialogue: 0,0:04:08.76,0:04:12.56,Main,,0,0,0,,Şu anda Marineford'da neler\Nolduğunu söylemek mümkün değil.
Dialogue: 0,0:04:16.74,0:04:19.00,Main,,0,0,0,,Meteor Volkanı!{\fad(150,150)}
Dialogue: 0,0:04:31.45,0:04:33.82,Main,,0,0,0,,Kaçmanıza izin vermiyoruz!
Dialogue: 0,0:04:33.82,0:04:37.12,Main,,0,0,0,,Buzu eritin ve basacak yerleri kalmasın!
Dialogue: 0,0:04:46.91,0:04:49.01,Main,,0,0,0,,S-Su...
Dialogue: 0,0:04:49.54,0:04:51.34,Main,,0,0,0,,Sıcak!
Dialogue: 0,0:04:51.34,0:04:53.57,Main,,0,0,0,,Magma suyu kaynatıyor!
Dialogue: 0,0:04:56.11,0:04:57.68,Main,,0,0,0,,Hemen sudan çıkın!
Dialogue: 0,0:04:58.98,0:05:00.01,Main,,0,0,0,,Hey, bakın!
Dialogue: 0,0:05:11.31,0:05:13.13,Main,,0,0,0,,Bu taraf da kapatılmış!
Dialogue: 0,0:05:17.70,0:05:20.67,Main,,0,0,0,,Bu duvara karşı yapabileceğimiz bir şey yok mu?!
Dialogue: 0,0:05:40.70,0:05:42.32,Main,,0,0,0,,Beyazsakal...
Dialogue: 0,0:05:45.62,0:05:49.90,Main,,0,0,0,,B-Babalık'ın saldırıları işe yaramıyor.\NBu sıradan bir duvar değil!
Dialogue: 0,0:05:51.80,0:05:54.40,Main,,0,0,0,,Bu işi bitirme vakti geldi.
Dialogue: 0,0:06:02.31,0:06:05.13,Main,,0,0,0,,Moby Dick doğrudan magmaya maruz kaldı!
Dialogue: 0,0:06:05.13,0:06:06.85,Main,,0,0,0,,Ateşi söndürün!
Dialogue: 0,0:06:06.85,0:06:08.85,Main,,0,0,0,,Çabuk!
Dialogue: 0,0:06:09.25,0:06:11.02,Main,,0,0,0,,Dayanmalısınız!
Dialogue: 0,0:06:13.75,0:06:15.20,Main,,0,0,0,,Geminin batmasına izin vermeyin!
Dialogue: 0,0:06:15.20,0:06:19.49,Main,,0,0,0,,Arkadaşlarımızla ve Ace'le birlikte bir kez\Ndaha denizlerde yolculuk edeceğiz!
Dialogue: 0,0:06:19.49,0:06:23.26,Main,,0,0,0,,Beyazsakal. Senin dönemin sona erdi!
Dialogue: 0,0:06:39.51,0:06:41.75,Main,,0,0,0,,Moby Dick...
Dialogue: 0,0:06:42.23,0:06:46.47,Main,,0,0,0,,Lanet olsun! Lanet olası Denizciler!
Dialogue: 0,0:06:46.47,0:06:49.25,Main,,0,0,0,,O bizim gururumuz ve neşemizdi!
Dialogue: 0,0:06:50.59,0:06:56.30,Main,,0,0,0,,Kahretsin! Gemimizi yok ettiler!\NBeyazsakal Korsanları'nı yıllardır taşıyan gemi!
Dialogue: 0,0:07:12.71,0:07:15.33,Main,,0,0,0,,Beni affet.
Dialogue: 0,0:07:20.32,0:07:23.66,Main,,0,0,0,,Meydana giden tek yolumuzu yitiriyoruz!
Dialogue: 0,0:07:25.06,0:07:27.04,Main,,0,0,0,,Plan sorunsuzca ilerliyor.
Dialogue: 0,0:07:27.04,0:07:32.56,Main,,0,0,0,,Portgas D. Ace'in idamı başlayacak.
Dialogue: 0,0:07:32.56,0:07:35.10,Main,,0,0,0,,Hemen!
Dialogue: 0,0:07:49.95,0:07:51.75,Main,,0,0,0,,Neler olduğunu bile göremiyoruz!
Dialogue: 0,0:07:51.75,0:07:54.05,Main,,0,0,0,,Ace'i öldürmelerine izin vermemiz mümkün değil!
Dialogue: 0,0:07:54.05,0:07:55.54,Main,,0,0,0,,Evet.
Dialogue: 0,0:07:55.54,0:07:57.44,Main,,0,0,0,,Hala bir yol var.
Dialogue: 0,0:07:57.44,0:07:59.16,Main,,0,0,0,,Bir tek yol...
Dialogue: 0,0:07:59.86,0:08:02.20,Main,,0,0,0,,Oz'un bizim için açtığı yol!
Dialogue: 0,0:08:03.33,0:08:07.43,Main,,0,0,0,,O tarafa gidersek, öldürüleceğiz.\NDenizciler kesinlikle bizi bekliyor.
Dialogue: 0,0:08:09.33,0:08:11.68,Main,,0,0,0,,Durup konuşacak zaman değil!
Dialogue: 0,0:08:11.68,0:08:15.10,Main,,0,0,0,,Evet... Ace'i kurtaracaksak, tek yolu bu.
Dialogue: 0,0:08:34.12,0:08:37.10,Main,,0,0,0,,Ace!
Dialogue: 0,0:08:44.10,0:08:45.50,Main,,0,0,0,,Hasır Şapka...
Dialogue: 0,0:08:45.50,0:08:47.26,Main,,0,0,0,,Biz de gideceğiz!
Dialogue: 0,0:08:47.26,0:08:51.44,Main,,0,0,0,,Evet!
Dialogue: 0,0:08:58.20,0:09:00.39,Main,,0,0,0,,Yol fazlasıyla belli!
Dialogue: 0,0:09:00.39,0:09:04.20,Main,,0,0,0,,Daha bitmedi! Onları olabildiğince tutun!
Dialogue: 0,0:09:04.20,0:09:05.02,Main,,0,0,0,,Ateş!
Dialogue: 0,0:09:10.40,0:09:14.96,Main,,0,0,0,,Düşmanın tek açığı görmezden\Ngelmesi mümkün değil!
Dialogue: 0,0:09:14.96,0:09:16.23,Main,,0,0,0,,Kesinlikle bir tuzak!
Dialogue: 0,0:09:19.20,0:09:20.24,Main,,0,0,0,,Ateş!
Dialogue: 0,0:09:25.34,0:09:27.02,Main,,0,0,0,,Hasır Şapkalı çocuk!
Dialogue: 0,0:09:27.02,0:09:27.95,Main,,0,0,0,,Luffy{\i1}-kun{\i0}!
Dialogue: 0,0:09:54.40,0:09:58.41,Main,,0,0,0,,Oz Jr.! Hala hayatta mıydı?!
Dialogue: 0,0:09:59.14,0:10:01.41,Main,,0,0,0,,Ace... {\i1}kun{\i0}...
Dialogue: 0,0:10:01.41,0:10:03.82,Main,,0,0,0,,Oz...
Dialogue: 0,0:10:03.82,0:10:08.56,Main,,0,0,0,,Ace-kun'u... koruyacağım...
Dialogue: 0,0:10:08.56,0:10:10.82,Main,,0,0,0,,Oz!
Dialogue: 0,0:10:14.19,0:10:17.53,Main,,0,0,0,,Kaptan Squardo!
Dialogue: 0,0:10:17.53,0:10:20.11,Main,,0,0,0,,Siz...
Dialogue: 0,0:10:25.03,0:10:26.97,Main,,0,0,0,,Tamam!
Dialogue: 0,0:10:29.74,0:10:32.01,Main,,0,0,0,,İyi misin, Luffy-kun?
Dialogue: 0,0:10:32.01,0:10:34.24,Main,,0,0,0,,Cidden ne kadar pervasız olabilirsin?
Dialogue: 0,0:10:38.04,0:10:39.68,Main,,0,0,0,,Ateşe hazırlanın.
Dialogue: 0,0:10:44.22,0:10:46.00,Main,,0,0,0,,Ateş!
Dialogue: 0,0:10:48.83,0:10:50.46,Main,,0,0,0,,Oz!
Dialogue: 0,0:10:51.80,0:10:54.07,Main,,0,0,0,,Bir şey yapmalıyım.
Dialogue: 0,0:10:54.07,0:10:55.95,Main,,0,0,0,,Acele etmeliyim.
Dialogue: 0,0:10:55.95,0:10:59.37,Main,,0,0,0,,Ace'i idam edecekler!
Dialogue: 0,0:10:59.37,0:11:01.97,Main,,0,0,0,,Evet, hızlı hareket etmeliyiz!
Dialogue: 0,0:11:01.97,0:11:03.94,Main,,0,0,0,,Jinbe!
Dialogue: 0,0:11:06.30,0:11:08.56,Main,,0,0,0,,Senden...
Dialogue: 0,0:11:08.56,0:11:10.98,Main,,0,0,0,,...bir iyilik isteyeceğim!
Dialogue: 0,0:11:10.98,0:11:13.25,Main,,0,0,0,,Cidden ısrarcısın.
Dialogue: 0,0:11:13.25,0:11:15.52,Main,,0,0,0,,Zaten yarı ölü! İşini bitirin!
Dialogue: 0,0:11:15.75,0:11:19.78,Main,,0,0,0,,Oh, zahmet etmeyin. Ben yaparım.
Dialogue: 0,0:11:19.78,0:11:21.23,Main,,0,0,0,,Kizaru-san!
Dialogue: 0,0:11:21.23,0:11:26.23,Main,,0,0,0,,İdamı bir an önce bitirmeliyiz.
Dialogue: 0,0:11:27.03,0:11:33.77,Main,,0,0,0,,Böyle zamanlarda kafasını delmek en iyisidir.
Dialogue: 0,0:11:33.77,0:11:38.40,Main,,0,0,0,,Deniz Akıntısı Yükseltici!{\fad(150,150)}
Dialogue: 0,0:12:05.74,0:12:07.59,Main,,0,0,0,,Lu-
Dialogue: 0,0:12:09.32,0:12:10.89,Main,,0,0,0,,Luffy!
Dialogue: 0,0:12:18.52,0:12:21.22,Main,,0,0,0,,Ah. Sonunda buraya geldin.
Dialogue: 0,0:12:23.29,0:12:27.88,Main,,0,0,0,,Etkileyici bir giriş, Dragon'un oğlu.
Dialogue: 0,0:12:29.33,0:12:33.03,Main,,0,0,0,,Bu genç gerçekten korkunç.
Dialogue: 0,0:12:39.37,0:12:43.72,Main,,0,0,0,,Ace'in kardeşi duvarın üstünden geçti!
Dialogue: 0,0:12:43.72,0:12:44.91,Main,,0,0,0,,Bu çocuk...
Dialogue: 0,0:12:50.15,0:12:53.92,Main,,0,0,0,,Hiçbir şey olmasa, kararlılığını takdir ediyorum.
Dialogue: 0,0:12:53.92,0:12:58.82,Main,,0,0,0,,Ama henüz bu aşama için hazır değilsin.
Dialogue: 0,0:12:58.82,0:13:01.99,Main,,0,0,0,,Bizi yenmen mümkün değil, biliyor musun?
Dialogue: 0,0:13:10.13,0:13:12.64,Main,,0,0,0,,Ace'i...
Dialogue: 0,0:13:12.64,0:13:17.48,Main,,0,0,0,,...geri verin!
Dialogue: 0,0:13:17.71,0:13:22.01,Main,,0,0,0,,En az abisi kadar gözü kara.
Dialogue: 0,0:13:22.26,0:13:24.65,Main,,0,0,0,,Oz! Olduğun yerde kal.
Dialogue: 0,0:13:24.65,0:13:27.02,Main,,0,0,0,,Gücüne ihtiyacımız var.
Dialogue: 0,0:13:27.02,0:13:27.95,Main,,0,0,0,,Babalık...
Dialogue: 0,0:13:28.18,0:13:29.63,Main,,0,0,0,,Jozu! Kozumuzu kullanma vakti!
Dialogue: 0,0:13:29.63,0:13:30.39,Main,,0,0,0,,Tamam!
Dialogue: 0,0:13:30.39,0:13:32.59,Main,,0,0,0,,Herkes hazır olsun!
Dialogue: 0,0:13:32.59,0:13:35.03,Main,,0,0,0,,Meydana giriyoruz!
Dialogue: 0,0:13:39.90,0:13:42.00,Main,,0,0,0,,Gomu Gomu no...{\fad(150,150)}
Dialogue: 0,0:13:42.23,0:13:45.69,Main,,0,0,0,,...Makineli Damga!{\fad(150,150)}
Dialogue: 0,0:14:22.81,0:14:25.44,Main,,0,0,0,,İkinci Düzen!{\fad(150,150)}
Dialogue: 0,0:14:28.28,0:14:32.21,Main,,0,0,0,,Bu heriflerle dövüşecek zamanım yok!
Dialogue: 0,0:14:32.62,0:14:35.72,Main,,0,0,0,,Bu ne kurnazlık böyle.
Dialogue: 0,0:14:41.53,0:14:44.36,Main,,0,0,0,,Çok yavaş.
Dialogue: 0,0:14:56.71,0:14:58.27,Main,,0,0,0,,İşaretimle!
Dialogue: 0,0:14:58.27,0:14:59.67,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:15:05.15,0:15:06.31,Main,,0,0,0,,Yapın!
Dialogue: 0,0:15:24.07,0:15:28.88,Main,,0,0,0,,Ace!!
Dialogue: 0,0:15:45.78,0:15:47.36,Main,,0,0,0,,Kim yaptı bunu?!
Dialogue: 0,0:15:52.96,0:15:54.67,Main,,0,0,0,,Pislik!
Dialogue: 0,0:15:56.00,0:16:02.61,Main,,0,0,0,,Beyazsakal'a duyduğun eski kini göz önünde\Ntutarak şanslı olduğumuzu düşünmüştüm,...
Dialogue: 0,0:16:03.22,0:16:05.81,Main,,0,0,0,,...Crocodile!
Dialogue: 0,0:16:09.64,0:16:10.58,Main,,0,0,0,,O!
Dialogue: 0,0:16:12.86,0:16:16.02,Main,,0,0,0,,Ha... daha sıram gelmedi mi?
Dialogue: 0,0:16:16.58,0:16:23.19,Main,,0,0,0,,Babalık'ı öldürmeye çok kararlıydın.\NBu ani değişiklik de neyin nesi?
Dialogue: 0,0:16:27.16,0:16:30.07,Main,,0,0,0,,Şu ölen yaşlı adam mı?
Dialogue: 0,0:16:30.07,0:16:32.60,Main,,0,0,0,,Onu sonra yok ederim.
Dialogue: 0,0:16:33.68,0:16:35.64,Main,,0,0,0,,Ama şu anda...
Dialogue: 0,0:16:35.64,0:16:40.11,Main,,0,0,0,,...zaferin tadını çıkardığınızı\Ngörmek istemiyorum!
Dialogue: 0,0:16:52.82,0:16:55.62,Main,,0,0,0,,Hey, hey, timsah adam!
Dialogue: 0,0:16:55.62,0:16:57.47,Main,,0,0,0,,D-Doflamingo!
Dialogue: 0,0:16:57.47,0:17:01.17,Main,,0,0,0,,Beyazsakal'la ekip oluşturmak\Niçin beni atlatıyor musun?
Dialogue: 0,0:17:05.88,0:17:09.87,Main,,0,0,0,,Bir adamı kıskandırmaya yeter.
Dialogue: 0,0:17:13.00,0:17:15.91,Main,,0,0,0,,Kimseyle ekip oluşturmuyorum.
Dialogue: 0,0:17:16.44,0:17:21.55,Main,,0,0,0,,Bu beni başından savmakla aynı.
Dialogue: 0,0:17:21.55,0:17:23.49,Main,,0,0,0,,Sayılır.
Dialogue: 0,0:17:38.84,0:17:42.47,Main,,0,0,0,,Neler olduğunu anlamıyorum, ama kurtulduk.
Dialogue: 0,0:17:42.82,0:17:45.41,Main,,0,0,0,,Buraya kadar, Hasır Şapka!
Dialogue: 0,0:17:46.04,0:17:47.29,Main,,0,0,0,,Geber!
Dialogue: 0,0:17:58.12,0:17:59.99,Main,,0,0,0,,Yolumdan...
Dialogue: 0,0:18:00.82,0:18:03.39,Main,,0,0,0,,...çekilin!
Dialogue: 0,0:18:12.60,0:18:14.42,Main,,0,0,0,,Orada dur, Hasır Şapka!
Dialogue: 0,0:18:14.88,0:18:16.61,Main,,0,0,0,,Daha ileri gitmene izin vermeyeceğim!
Dialogue: 0,0:18:16.61,0:18:18.11,Main,,0,0,0,,Çekil!
Dialogue: 0,0:18:17.40,0:18:17.90,Secondary,,0,0,0,,Kazı!{\fad(150,150)}
Dialogue: 0,0:18:19.55,0:18:20.34,Main,,0,0,0,,Ay Adımı!{\fad(150,150)}
Dialogue: 0,0:18:22.38,0:18:23.28,Main,,0,0,0,,Demir Kütle...{\fad(150,150)}
Dialogue: 0,0:18:23.78,0:18:24.66,Main,,0,0,0,,...Darbesi!{\fad(150,150)}
Dialogue: 0,0:18:31.54,0:18:33.09,Main,,0,0,0,,Gomu Gomu no...{\fad(150,150)}
Dialogue: 0,0:18:33.09,0:18:33.86,Main,,0,0,0,,Demir Parça!{\fad(150,150)}
Dialogue: 0,0:18:34.58,0:18:35.98,Main,,0,0,0,,Mermi!{\fad(150,150)}
Dialogue: 0,0:18:43.48,0:18:45.67,Main,,0,0,0,,Dur, Hasır Şapka!
Dialogue: 0,0:18:45.67,0:18:47.54,Main,,0,0,0,,Daha fazla yaklaşmasına izin vermeyin!
Dialogue: 0,0:18:49.86,0:18:51.18,Main,,0,0,0,,Amiral Sakazuki!
Dialogue: 0,0:19:04.64,0:19:06.09,Main,,0,0,0,,Acıyor!
Dialogue: 0,0:19:06.09,0:19:07.85,Main,,0,0,0,,Lanet olsun!
Dialogue: 0,0:19:07.85,0:19:11.38,Main,,0,0,0,,Büyükbabana borçluyum, ama...
Dialogue: 0,0:19:11.38,0:19:13.43,Main,,0,0,0,,...başka çarem yok!
Dialogue: 0,0:19:13.43,0:19:16.97,Main,,0,0,0,,Kendi ölümünü seçtin!
Dialogue: 0,0:19:16.97,0:19:20.14,Main,,0,0,0,,Sen! Luffy'ye el sürme!
Dialogue: 0,0:19:30.40,0:19:31.47,Main,,0,0,0,,Amiral!
Dialogue: 0,0:19:32.26,0:19:33.92,Main,,0,0,0,,O...
Dialogue: 0,0:19:35.54,0:19:38.66,Main,,0,0,0,,Birinci Bölüm Kumandanı Marco!
Dialogue: 0,0:19:41.84,0:19:43.66,Main,,0,0,0,,Beni kurtardığın için sağol.
Dialogue: 0,0:19:44.54,0:19:46.26,Main,,0,0,0,,Lafı bile olmaz.
Dialogue: 0,0:19:50.18,0:19:53.01,Main,,0,0,0,,Üç kişi meydana girdi!
Dialogue: 0,0:19:53.01,0:19:56.11,Main,,0,0,0,,Şeytan Meyvesi kullanıcıları duvarı aşıyor!
Dialogue: 0,0:20:00.82,0:20:04.70,Main,,0,0,0,,Suyu geçip Oz'a gidin!
Dialogue: 0,0:20:05.32,0:20:09.75,Main,,0,0,0,,Her pahasına meydana ulaşın!
Dialogue: 0,0:20:10.46,0:20:13.26,Main,,0,0,0,,Korsanlar umutsuzluğa düşüyor.
Dialogue: 0,0:20:13.26,0:20:15.18,Main,,0,0,0,,Duvardaki boşluğu savunun!
Dialogue: 0,0:20:15.18,0:20:16.03,Main,,0,0,0,,Emredersiniz!
Dialogue: 0,0:20:20.10,0:20:23.44,Main,,0,0,0,,Gemilerini ve basacak yerlerini bile\Nyitirdikten sonra her zamanki gibi çılgınlar.
Dialogue: 0,0:20:23.44,0:20:25.58,Main,,0,0,0,,Ahmak korsanlar.
Dialogue: 0,0:20:25.58,0:20:28.07,Main,,0,0,0,,Kolay hedefler! Ateş!
Dialogue: 0,0:21:24.20,0:21:26.92,Main,,0,0,0,,Herkes binsin!
Dialogue: 0,0:21:26.92,0:21:28.93,Main,,0,0,0,,Tamam!
Dialogue: 0,0:21:29.60,0:21:31.57,Main,,0,0,0,,Sıkı tutunun!
Dialogue: 0,0:21:32.36,0:21:34.14,Main,,0,0,0,,Olamaz! Bir gemi...
Dialogue: 0,0:21:34.96,0:21:36.02,Main,,0,0,0,,Başımız dertte!
Dialogue: 0,0:21:36.02,0:21:39.96,Main,,0,0,0,,Koydan kaplanmış bir gemi daha çıktı!
Dialogue: 0,0:21:44.10,0:21:45.14,Main,,0,0,0,,Kahretsin!
Dialogue: 0,0:21:45.14,0:21:47.35,Main,,0,0,0,,Bunca zamandır su altında gizleniyormuş!
Dialogue: 0,0:22:08.11,0:22:12.38,Main,,0,0,0,,Tüm gemilerimizi kullandığımızı\Nsöylediğimi hatırlamıyorum!
Dialogue: 0,0:22:19.25,0:22:21.32,Main,,0,0,0,,Çarklı bir gemi!
Dialogue: 0,0:22:21.32,0:22:23.45,Main,,0,0,0,,Bize çarpacak!
Dialogue: 0,0:22:24.20,0:22:25.26,Main,,0,0,0,,Ne?!
Dialogue: 0,0:22:28.43,0:22:32.16,Main,,0,0,0,,Batırın! Aynı Moby Dick gibi!
Dialogue: 0,0:22:37.60,0:22:39.94,Main,,0,0,0,,Hayır, gemiyi değil!
Dialogue: 0,0:22:39.94,0:22:41.84,Main,,0,0,0,,Oz'u vurun!
Dialogue: 0,0:22:41.84,0:22:43.67,Main,,0,0,0,,Ha? Oz'u mı?
Dialogue: 0,0:22:44.46,0:22:46.18,Main,,0,0,0,,Çok geç!
Dialogue: 0,0:22:46.18,0:22:48.52,Main,,0,0,0,,Başlıyoruz beyler!
Dialogue: 0,0:23:02.42,0:23:05.64,Main,,0,0,0,,G-Gemiyi içeri çekti!
Dialogue: 0,0:23:05.64,0:23:09.20,Main,,0,0,0,,İstilacılar duvarlardan geçti!
Dialogue: 0,0:23:18.11,0:23:20.97,Main,,0,0,0,,Meydandayız!
Dialogue: 0,0:23:20.97,0:23:24.68,Main,,0,0,0,,Ace'i kurtaralım!
Dialogue: 0,0:23:24.68,0:23:27.75,Main,,0,0,0,,Denizci Karargâhı'nı yıkma zamanı!
Dialogue: 0,0:23:27.75,0:23:31.22,Main,,0,0,0,,Dayan, Ace!
Dialogue: 0,0:23:32.08,0:23:33.74,Main,,0,0,0,,Bizi gafil avladılar.
Dialogue: 0,0:23:33.74,0:23:39.23,Main,,0,0,0,,Duvarlarda bir tek fare deliği\Nvardı ve sürüyle içeri daldılar.
Dialogue: 0,0:23:40.02,0:23:44.65,Main,,0,0,0,,O duvarlar aleyhimize çalışmaya başlayabilir.
Dialogue: 0,0:23:44.65,0:23:47.70,Main,,0,0,0,,Babalık!
Dialogue: 0,0:23:47.70,0:23:50.18,Main,,0,0,0,,Beyazsakal...
Dialogue: 0,0:23:50.18,0:23:54.88,Main,,0,0,0,,Başın hala yerinde mi, Ace?
Dialogue: 0,0:23:57.70,0:24:00.38,Main,,0,0,0,,Başardık!
Dialogue: 0,0:24:00.38,0:24:05.64,Main,,0,0,0,,Artık Ace-kun kurtarıla-
Dialogue: 0,0:24:09.23,0:24:10.46,Main,,0,0,0,,Oz!
Dialogue: 0,0:24:16.62,0:24:20.90,Main,,0,0,0,,Ace-kun'u... kurtarın...
Dialogue: 0,0:24:34.04,0:24:36.25,Main,,0,0,0,,Oz...
Dialogue: 0,0:25:23.40,0:25:27.06,Main,,0,0,0,,Beyazsakal meydana girdi!
Dialogue: 0,0:25:33.08,0:25:37.08,Main,,0,0,0,,Geri durun evlatlarım.
Dialogue: 0,0:26:09.86,0:26:11.87,Main,,0,0,0,,Beyler!
Dialogue: 0,0:26:11.87,0:26:18.36,Main,,0,0,0,,Ace'i kurtarın ve Denizcileri yok edin!
Dialogue: 0,0:26:24.96,0:26:26.96,Main,,0,0,0,,Garp...
Dialogue: 0,0:26:26.96,0:26:28.50,Main,,0,0,0,,Evet.
Dialogue: 0,0:26:32.36,0:26:38.04,Main,,0,0,0,,Görünüşe göre bizim bile işe koyulmamız gerekiyor!
Dialogue: 0,0:00:25.92,0:00:30.36,Credits,,0,0,0,,{\fad(600,200)\pos(75,518.333)}Editing\N{\fs34}Sewil
