Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:06.87,0:00:10.32,Flashbacks,,0,0,0,,Yeni doğmuş bir çocuk günahsızdır.Dialogue: 0,0:00:10.90,0:00:12.15,Flashbacks,,0,0,0,,Garp.Dialogue: 0,0:00:13.49,0:00:15.69,Flashbacks,,0,0,0,,Çocuğuma iyi bak.Dialogue: 0,0:00:18.02,0:00:20.80,Main,,0,0,0,,Senin baban...Dialogue: 0,0:00:20.80,0:00:25.47,Main,,0,0,0,,...Korsanlar Kralı Gold Roger!Dialogue: 0,0:00:38.74,0:00:43.29,Main,,0,0,0,,Ateş Yumruk Ace... Gold Roger'ın oğlu mu?!Dialogue: 0,0:00:48.67,0:00:51.06,Main,,0,0,0,,Bu çok büyük bir haber!Dialogue: 0,0:00:51.06,0:00:53.92,Main,,0,0,0,,Hemen merkezi arayın!  Bunun için ekstra baskı çıkarıyoruz!Dialogue: 0,0:00:56.06,0:00:57.87,Main,,0,0,0,,Demek hala yaşıyor.Dialogue: 0,0:01:00.83,0:01:02.52,Main,,0,0,0,,Yaşıyor...Dialogue: 0,0:01:10.18,0:01:12.98,Main,,0,0,0,,Korsanlar Kralı'nın soyu yaşıyor!Dialogue: 0,0:01:45.87,0:01:50.30,Credits,,0,0,0,,Editing/Title Card SewilDialogue: 0,0:01:50.78,0:01:55.64,Credits,,0,0,0,,Quality Assurance Galaxy 9000 PepperjackDialogue: 0,0:01:56.26,0:02:02.21,Credits,,0,0,0,,Karaoke & Attack Effects KaitouYahikoDialogue: 0,0:02:02.30,0:02:06.10,Credits,,0,0,0,,Timing Galaxy 9000Dialogue: 0,0:02:06.91,0:02:09.53,Credits,,0,0,0,,Soundtracking HaleeDialogue: 0,0:02:12.41,0:02:15.63,Credits,,0,0,0,,Translation YibisDialogue: 0,0:02:17.48,0:02:20.40,Credits,,0,0,0,,Raw Provider CloaknsmokeDialogue: 0,0:03:51.50,0:04:01.50,Author,,0,0,0,, Türkçeleştirme  onepacetr.netDialogue: 0,0:16:40.00,0:16:50.00,Author,,0,0,0,, Türkçeleştirme  onepacetr.netDialogue: 0,0:33:50.00,0:34:00.00,Author,,0,0,0,, Türkçeleştirme  onepacetr.netDialogue: 0,0:03:51.50,0:03:56.30,Title,,0,0,230,,Ace ve BeyazsakalDialogue: 0,0:04:04.56,0:04:07.86,Main,,0,0,0,,Yani Luffy onun gerçek kardeşi değil mi?Dialogue: 0,0:04:14.09,0:04:16.20,Main,,0,0,0,,Roger'ın...Dialogue: 0,0:04:16.20,0:04:18.20,Main,,0,0,0,,...oğlu mu?Dialogue: 0,0:04:23.61,0:04:27.91,Main,,0,0,0,,Demek biyolojik oğlu yaşıyor. Ne mucize ama.Dialogue: 0,0:04:27.91,0:04:32.64,Main,,0,0,0,,Roger'la bağlantısı olanlar o zaman zaten mahkum edilmiş olmalıydı!Dialogue: 0,0:04:32.64,0:04:38.39,Main,,0,0,0,,Luffy-san'ın abisi olduğu için, Dragon'un onun da babası olduğunu düşünmüştüm.Dialogue: 0,0:04:38.39,0:04:41.49,Main,,0,0,0,,Ben de öyle düşünmüştüm! Neler oluyor?Dialogue: 0,0:04:41.49,0:04:44.13,Main,,0,0,0,,Yani onlar aslında kardeş değil mi?Dialogue: 0,0:04:47.69,0:04:50.37,Main,,0,0,0,,Buna inanabiliyor musun, Garp?Dialogue: 0,0:04:50.37,0:04:52.93,Main,,0,0,0,,Bir çocuk doğmak üzere.Dialogue: 0,0:04:52.93,0:04:54.07,Main,,0,0,0,,...Benim çocuğum.Dialogue: 0,0:04:56.98,0:05:01.16,Main,,0,0,0,,Ne yazık ki, bu olana kadar dünyadan ayrılmış olacağım.Dialogue: 0,0:05:03.89,0:05:07.09,Main,,0,0,0,,Peki bunu niye bana, bir Denizciye anlatıyorsun?Dialogue: 0,0:05:07.09,0:05:08.50,Main,,0,0,0,,Roger!Dialogue: 0,0:05:08.50,0:05:13.96,Main,,0,0,0,,O çocuğun annesi ve seninle bağlantısı olan her kadın, hiç şüphesiz idam edilecek!Dialogue: 0,0:05:17.06,0:05:19.23,Main,,0,0,0,,Bu yüzden sana anlattım.Dialogue: 0,0:05:23.20,0:05:28.31,Main,,0,0,0,,Hükümet geçen yıl nerede olduğumu kesinlikle öğrenecektir.Dialogue: 0,0:05:28.31,0:05:31.42,Main,,0,0,0,,Onu bulacaklar ve öldürecekler.Dialogue: 0,0:05:31.42,0:05:35.55,Main,,0,0,0,,Ama yeni doğmuş bir çocuk günahsızdır.Dialogue: 0,0:05:36.55,0:05:42.52,Main,,0,0,0,,Garp! Sen ve ben birbirimizi defalarca kez neredeyse öldürüyorduk.Dialogue: 0,0:05:43.01,0:05:48.20,Main,,0,0,0,,Sana tayfamdan birine güvendiğim kadar güveniyorum.Dialogue: 0,0:05:58.93,0:06:00.87,Main,,0,0,0,,Onu benim için koru.Dialogue: 0,0:06:02.28,0:06:04.94,Main,,0,0,0,,Bencilliklerini kendine sakla!Dialogue: 0,0:06:05.48,0:06:08.65,Main,,0,0,0,,Hayır, bunu yapacağını biliyorum!Dialogue: 0,0:06:15.84,0:06:20.50,Main,,0,0,0,,Çocuğumla ilgilen!Dialogue: 0,0:06:46.02,0:06:49.09,Main,,0,0,0,,Adanın bu olduğuna emin misin?Dialogue: 0,0:06:49.09,0:06:54.68,Main,,0,0,0,,Roger burada tespit edildi,  ama sıradışı biçimde davranıyordu.Dialogue: 0,0:06:54.68,0:06:57.10,Main,,0,0,0,,Neredeyse baba gibi davranıyordu.Dialogue: 0,0:06:57.10,0:06:59.59,Main,,0,0,0,,Roger'ın devri sona erdi.Dialogue: 0,0:06:59.59,0:07:02.04,Main,,0,0,0,,Soyunun tüm izlerini yok etmeliyiz.Dialogue: 0,0:07:02.67,0:07:08.44,Main,,0,0,0,,Onun mahkumiyetinden itibaren 10 ay içinde doğan tüm çocukları araştıracaksınız.Dialogue: 0,0:07:15.21,0:07:17.50,Main,,0,0,0,,Tüm hamile kadınları da araştırın.Dialogue: 0,0:07:20.72,0:07:23.46,Main,,0,0,0,,Şüpheli görünen tüm anneleri öldürün.Dialogue: 0,0:08:12.87,0:08:15.60,Main,,0,0,0,,Bu ay beş çocuk doğdu.Dialogue: 0,0:08:25.20,0:08:27.20,Main,,0,0,0,,Şunların önümüzdeki ay doğurması bekleniyor.Dialogue: 0,0:08:36.83,0:08:38.03,Thoughts,,0,0,0,,Henüz değil.Dialogue: 0,0:08:42.13,0:08:44.31,Thoughts,,0,0,0,,Henüz doğamazsın.Dialogue: 0,0:08:49.18,0:08:50.92,Thoughts,,0,0,0,,Üzgünüm.Dialogue: 0,0:08:53.01,0:08:54.34,Thoughts,,0,0,0,,Henüz değil.Dialogue: 0,0:08:57.85,0:08:59.42,Thoughts,,0,0,0,,Henüz değil.Dialogue: 0,0:09:02.79,0:09:05.86,Thoughts,,0,0,0,,Henüz değil... Henüz değil...Dialogue: 0,0:09:23.74,0:09:25.64,Main,,0,0,0,,Kız olursa adı Ann olacaktı.Dialogue: 0,0:09:27.58,0:09:30.93,Main,,0,0,0,,Erkek olursa, Ace.Dialogue: 0,0:09:31.98,0:09:34.72,Main,,0,0,0,,Böyle karar vermişti.Dialogue: 0,0:09:37.42,0:09:40.46,Main,,0,0,0,,Bu çocuğun adı, Gol D. Ace.Dialogue: 0,0:09:50.90,0:09:53.87,Main,,0,0,0,,Bizim... çocuğumuz.Dialogue: 0,0:09:59.06,0:09:59.96,Main,,0,0,0,,Rouge!Dialogue: 0,0:09:59.96,0:10:02.28,Main,,0,0,0,,Rouge! Dayan!Dialogue: 0,0:10:10.45,0:10:12.69,Main,,0,0,0,,Onunla ilgilen, Dadan!Dialogue: 0,0:10:14.22,0:10:15.63,Main,,0,0,0,,Olmaz!Dialogue: 0,0:10:17.73,0:10:19.37,Main,,0,0,0,,Kimin çocuğu bu?Dialogue: 0,0:10:23.37,0:10:24.52,Main,,0,0,0,,Dadan?Dialogue: 0,0:10:24.52,0:10:27.90,Main,,0,0,0,,Evet. Bundan sonra burada yaşayacaksın.Dialogue: 0,0:10:27.90,0:10:29.97,Main,,0,0,0,,Ha?Dialogue: 0,0:10:29.97,0:10:33.61,Main,,0,0,0,,Bu insanlarla yaşayacaksın. Anlaşmaya çalış.Dialogue: 0,0:10:39.61,0:10:41.32,Main,,0,0,0,,Yeterince sinir bozucu.Dialogue: 0,0:10:41.32,0:10:46.00,Main,,0,0,0,,Luffy ile ikimiz, dünyaca ünlü suçluların kanını taşıyoruz.Dialogue: 0,0:10:46.00,0:10:49.49,Main,,0,0,0,,Anneme minnet borcum olduğu için "Portgas" adını almış olsam da,...Dialogue: 0,0:10:49.49,0:10:53.46,Main,,0,0,0,,...hala değersiz babamın kanını taşıyor olduğum düşüncesine katlanamıyorum.Dialogue: 0,0:10:55.55,0:10:56.70,Main,,0,0,0,,Babalık...Dialogue: 0,0:10:57.10,0:10:59.37,Main,,0,0,0,,Benim babalık...Dialogue: 0,0:11:02.27,0:11:04.80,Main,,0,0,0,,...Beyazsakal. Başkası değil.Dialogue: 0,0:11:08.55,0:11:09.91,Main,,0,0,0,,Garp...Dialogue: 0,0:11:11.00,0:11:12.78,Main,,0,0,0,,İki yıl oldu, değil mi?Dialogue: 0,0:11:12.78,0:11:17.83,Main,,0,0,0,,Annenin adını aldığından,  Maça Korsanları'nı kurduğundan...Dialogue: 0,0:11:17.83,0:11:23.26,Main,,0,0,0,,...ve aşılması zor bir güç ve hız ile denize açıldığından beri.Dialogue: 0,0:11:23.26,0:11:26.43,Main,,0,0,0,,O noktada sonunda farkettik.Dialogue: 0,0:11:26.43,0:11:30.40,Main,,0,0,0,,Roger'ın soyunu durdurmamıştık!Dialogue: 0,0:11:36.59,0:11:42.02,Main,,0,0,0,,Ama bunu bizimle aynı anda farkeden Beyazsakal,...Dialogue: 0,0:11:42.02,0:11:45.64,Main,,0,0,0,,...bir sonraki Korsanlar Kralı olman için seni büyütmeye karar verdi...Dialogue: 0,0:11:45.64,0:11:49.70,Main,,0,0,0,,...ve eski rakibinin oğlunu kendi gemisine aldı!Dialogue: 0,0:11:51.32,0:11:53.12,Main,,0,0,0,,Doğru değil!Dialogue: 0,0:11:53.12,0:11:56.52,Main,,0,0,0,,Babalığı Korsanlar Kralı yapabilmek için o gemiye bindim!Dialogue: 0,0:11:56.52,0:11:58.94,Main,,0,0,0,,Böyle düşünen sadece sensin!Dialogue: 0,0:11:59.83,0:12:03.31,Main,,0,0,0,,Pervasız davranmamak için dikkatliydik.Dialogue: 0,0:12:03.31,0:12:06.40,Main,,0,0,0,,Beyazsakal'ın koruması altındaydın!Dialogue: 0,0:12:07.14,0:12:13.51,Main,,0,0,0,,Ama kontrolsüz kalınca, hiç şüphesiz yeni bir korsan nesline ilham olacaktın.Dialogue: 0,0:12:13.51,0:12:18.77,Main,,0,0,0,,Bu yüzden idamın büyük önem arz ediyor.Dialogue: 0,0:12:21.51,0:12:26.26,Main,,0,0,0,,Beyazsakal'la savaşa girmemiz gerekse bile!Dialogue: 0,0:12:34.97,0:12:36.47,Main,,0,0,0,,Filo Amirali Sengoku!Dialogue: 0,0:12:36.47,0:12:38.00,Main,,0,0,0,,Rapor veriyorum!Dialogue: 0,0:12:38.00,0:12:41.31,Main,,0,0,0,,Adelet Kapısı açılıyor, ama kimse açılmalarını emretmedi!Dialogue: 0,0:12:41.31,0:12:44.27,Main,,0,0,0,,Makine dairesi ile de bağlantı kuramıyoruz!Dialogue: 0,0:12:44.27,0:12:45.44,Main,,0,0,0,,Ne?!Dialogue: 0,0:12:58.62,0:13:00.80,Main,,0,0,0,,Açtılar!Dialogue: 0,0:13:00.80,0:13:02.56,Main,,0,0,0,,Neler oluyor?!Dialogue: 0,0:13:02.56,0:13:06.36,Main,,0,0,0,,Adelet Kapısı kendi başına açılıyor!Dialogue: 0,0:13:06.36,0:13:10.14,Main,,0,0,0,,Denizciler bizim için asla açılmayacağını söylemesine rağmen!Dialogue: 0,0:13:12.37,0:13:17.80,Main,,0,0,0,,Makine dairesi büyük olasılıkla Marineford'un içinde. Bunu kim yapmış olabilir?Dialogue: 0,0:13:20.28,0:13:24.14,Main,,0,0,0,,İşte geliyor! Zamanı geldi!Dialogue: 0,0:13:24.14,0:13:27.50,Main,,0,0,0,,Kaptan Buggy, yoksa...Dialogue: 0,0:13:28.60,0:13:29.95,Main,,0,0,0,,Zamanı geldi!Dialogue: 0,0:13:29.95,0:13:31.80,Main,,0,0,0,,Yoksa sen...Dialogue: 0,0:13:31.80,0:13:34.56,Main,,0,0,0,,Aslında Kami'nin habercisi olduğunu hiç farketmemiştim!Dialogue: 0,0:13:34.56,0:13:36.27,Main,,0,0,0,,Cidden mi?! Buggy!Dialogue: 0,0:13:36.27,0:13:39.66,Main,,0,0,0,,Tabii ki doğru değil!  Burada bir tür numara olmalı!Dialogue: 0,0:13:39.66,0:13:44.14,Thoughts,,0,0,0,,Haklı... Kapı'yı kim açtı?!Dialogue: 0,0:13:44.64,0:13:49.07,Thoughts,,0,0,0,,Hayır! İlahi güç beni Korsanlar Kralı yapmak istiyor olabilir mi?!Dialogue: 0,0:13:54.59,0:13:56.42,Main,,0,0,0,,Geldiler!Dialogue: 0,0:13:56.42,0:13:58.72,Main,,0,0,0,,Tüm birlikler savaşa hazırlansın!Dialogue: 0,0:14:06.69,0:14:10.50,Main,,0,0,0,,Aniden ortaya çıktılar! Ama nereden geldiler?!Dialogue: 0,0:14:20.79,0:14:23.48,Main,,0,0,0,,Çok büyük bir korsan filosu!Dialogue: 0,0:14:23.48,0:14:26.15,Main,,0,0,0,,Beyazsakal nerede? Bulun onu!Dialogue: 0,0:14:27.45,0:14:29.18,Main,,0,0,0,,Bohem Şövalye Douma!Dialogue: 0,0:14:29.18,0:14:30.45,Main,,0,0,0,,Yıldırım Efendisi McGuy!Dialogue: 0,0:14:31.22,0:14:32.78,Main,,0,0,0,,DeCalvan Kardeşler!Dialogue: 0,0:14:33.42,0:14:35.02,Main,,0,0,0,,Anafor Örümcek Squad!Dialogue: 0,0:14:35.59,0:14:41.01,Main,,0,0,0,,Bu kudretli karakterlerin her biri... Yeni Dünya'nın meşhur kaptanları!Dialogue: 0,0:14:41.48,0:14:43.60,Main,,0,0,0,,Hepsi 43 gemi!Dialogue: 0,0:14:43.60,0:14:46.47,Main,,0,0,0,,Beyazsakal'ı ya da Kumandanlarını hala göremiyorum.Dialogue: 0,0:14:46.47,0:14:50.37,Main,,0,0,0,,Ama bu korsanlar kesinlikle Beyazsakal'ın müttefikleri!Dialogue: 0,0:14:50.37,0:14:52.42,Main,,0,0,0,,Ace-chan'ı görebiliyor musunuz?Dialogue: 0,0:14:52.42,0:14:54.78,Main,,0,0,0,,İşte orada! Ace!Dialogue: 0,0:14:58.36,0:15:01.40,Main,,0,0,0,,Sakın vazgeçme! Hepiniz umutsuz vakasınız!Dialogue: 0,0:15:03.42,0:15:05.32,Main,,0,0,0,,Siz...Dialogue: 0,0:15:05.32,0:15:06.85,Main,,0,0,0,,Onlara saldıralım mı?Dialogue: 0,0:15:06.85,0:15:10.45,Main,,0,0,0,,Henüz değil. Beyazsakal buralarda bir yerde!Dialogue: 0,0:15:10.45,0:15:14.20,Main,,0,0,0,,Doğru zamanı bekliyor olmalı. Gözünüzü sudan ayırmayın!Dialogue: 0,0:15:15.93,0:15:19.03,Main,,0,0,0,,Şimdi ilginçleşiyor işte! Gerçekten heyecanlanıyorum!Dialogue: 0,0:15:19.03,0:15:21.10,Main,,0,0,0,,Hemen ortaya çık, Beyazsakal!Dialogue: 0,0:15:39.59,0:15:40.92,Main,,0,0,0,,Olamaz!Dialogue: 0,0:15:47.04,0:15:48.39,Main,,0,0,0,,Nereden geliyor?Dialogue: 0,0:15:49.79,0:15:53.73,Main,,0,0,0,,Gerçekten ortaya çıkmak için müthiş bir yer seçmiş!Dialogue: 0,0:15:53.73,0:15:56.30,Main,,0,0,0,,Bunu hiç düşünmedik!Dialogue: 0,0:16:06.25,0:16:08.49,Main,,0,0,0,,Su altında bir gölge var!Dialogue: 0,0:16:08.49,0:16:09.65,Main,,0,0,0,,Olamaz!Dialogue: 0,0:16:19.45,0:16:21.14,Main,,0,0,0,,Demek böyle yaptılar.Dialogue: 0,0:16:21.14,0:16:26.58,Main,,0,0,0,,Bütün filolarını kaplayıp denizin dibinden gelmişler!Dialogue: 0,0:16:42.62,0:16:45.25,Main,,0,0,0,,Moby Dick geldi!Dialogue: 0,0:17:01.07,0:17:04.60,Main,,0,0,0,,Beyazsakal'ın üç gemisi daha ortaya çıktı!Dialogue: 0,0:17:08.84,0:17:11.46,Main,,0,0,0,,Koya girdiler!Dialogue: 0,0:17:13.74,0:17:15.41,Main,,0,0,0,,O...Dialogue: 0,0:17:15.41,0:17:17.95,Main,,0,0,0,,Birinci Bölüm Kumandanı Marco!Dialogue: 0,0:17:19.56,0:17:23.76,Main,,0,0,0,,14 kumandanın hepsi burada!Dialogue: 0,0:17:51.08,0:17:54.22,Main,,0,0,0,,Son karşılaşmamızdan bu yana kaç yıl geçti, Sengoku?Dialogue: 0,0:17:54.72,0:17:56.75,Main,,0,0,0,,Beyazsakal!Dialogue: 0,0:17:56.75,0:17:59.16,Main,,0,0,0,,Canım oğlumun hala iyi olduğunu...Dialogue: 0,0:18:00.03,0:18:02.33,Main,,0,0,0,,...düşünebilir miyim?Dialogue: 0,0:18:14.00,0:18:16.78,Main,,0,0,0,,Buraya nasıl bu kadar kolay girebildin?!Dialogue: 0,0:18:23.48,0:18:24.87,Main,,0,0,0,,Kapılardan geçmeyi başardık!Dialogue: 0,0:18:24.87,0:18:31.33,Main,,0,0,0,,Şimdi, acaba Ace çocuğun ve senin baban ortaya çıkacak mı?Dialogue: 0,0:18:31.33,0:18:32.46,Main,,0,0,0,,Ace'in babası mı?Dialogue: 0,0:18:32.46,0:18:37.26,Main,,0,0,0,,Oğlu Ace idam edilmek üzere olduğu için, Dragon'un bir şeyler yapacağına eminim.Dialogue: 0,0:18:37.26,0:18:40.26,Main,,0,0,0,,Ah, Ace'le benim babam aynı değil.Dialogue: 0,0:18:41.73,0:18:44.45,Main,,0,0,0,,Benim babam Dragon,...Dialogue: 0,0:18:44.45,0:18:47.47,Main,,0,0,0,,...ama Ace'in babası Gold Roger.Dialogue: 0,0:18:47.47,0:18:48.34,Main,,0,0,0,,NE?!Dialogue: 0,0:18:49.24,0:18:52.30,Main,,0,0,0,,Epey müthiş, ama gerçekte hiç karşılaşmadıklarını duydum.Dialogue: 0,0:18:52.30,0:18:55.11,Main,,0,0,0,,Gerçi, bunu size anlattığım için Ace muhtemelen bana kızacak.Dialogue: 0,0:18:55.11,0:18:56.39,Main,,0,0,0,,NE?!Dialogue: 0,0:18:56.39,0:18:58.47,Main,,0,0,0,,Sahi. Bu arada, bu bir sır.Dialogue: 0,0:18:58.47,0:19:01.49,Main,,0,0,0,,NEEEEEE?!Dialogue: 0,0:19:13.23,0:19:16.33,Main,,0,0,0,,Biraz daha bekle, Ace.Dialogue: 0,0:19:22.31,0:19:24.40,Main,,0,0,0,,Babalık!Dialogue: 0,0:19:43.59,0:19:45.27,Main,,0,0,0,,N-Ne?Dialogue: 0,0:19:45.27,0:19:46.63,Main,,0,0,0,,Havada... çatlak mı oluştu?!Dialogue: 0,0:19:57.86,0:19:59.97,Main,,0,0,0,,O nasıl bir patlama?!Dialogue: 0,0:19:59.97,0:20:02.61,Main,,0,0,0,,Durum kötü! Dalganın boyuna bak!Dialogue: 0,0:20:02.61,0:20:06.52,Main,,0,0,0,,Deniz depremi?! Okyanusu bile sallayabiliyor mu?!Dialogue: 0,0:20:06.52,0:20:08.72,Main,,0,0,0,,Diğer tarafta da bir tane var!Dialogue: 0,0:20:08.72,0:20:10.75,Main,,0,0,0,,Beyazsakal'ın gücü bu mu?!Dialogue: 0,0:20:14.09,0:20:16.19,Flashbacks,,0,0,0,,Ben önden gidiyorum!Dialogue: 0,0:20:21.27,0:20:23.27,Main,,0,0,0,,Dikkatli ol, Ace!Dialogue: 0,0:20:23.27,0:20:25.97,Main,,0,0,0,,Tabii! Görüşürüz, Luffy!Dialogue: 0,0:20:25.97,0:20:31.71,Main,,0,0,0,,Tamam! Üç yıl içinde denize açılınca, daha da güçlenmiş olacağım.Dialogue: 0,0:20:31.71,0:20:32.82,Main,,0,0,0,,Evet!Dialogue: 0,0:20:34.35,0:20:36.85,Main,,0,0,0,,Ace!Dialogue: 0,0:20:45.64,0:20:47.76,Main,,0,0,0,,Şimdi gidip biraz sorun çıkaralım!Dialogue: 0,0:20:49.68,0:20:52.86,Main,,0,0,0,,Bu çocuk...! Gidip korsan mı olmuş?!Dialogue: 0,0:20:52.86,0:20:56.13,Main,,0,0,0,,Korsan gemisi! Daha önce hiç görmediğim bir bayrak taşıyor!Dialogue: 0,0:21:02.94,0:21:06.64,Main,,0,0,0,,Bu son zamanlarda güç kazanan bir korsan.Dialogue: 0,0:21:06.64,0:21:09.10,Main,,0,0,0,,D? Nereden gelmiş?Dialogue: 0,0:21:09.10,0:21:14.49,Main,,0,0,0,,Kökeni konusunda henüz emin değiliz, ama Logia Şeytan Meyvesi gücüne sahip bir çaylak!Dialogue: 0,0:21:16.51,0:21:20.47,Main,,0,0,0,,Grand Line'da epey güçlü bir çocuk ortaya çıktı!Dialogue: 0,0:21:20.47,0:21:23.29,Main,,0,0,0,,Görünüşe göre Yedi Savaş Lordu'na katılma teklifini geri çevirmiş.Dialogue: 0,0:21:23.29,0:21:28.22,Main,,0,0,0,,Bu çocuklar kaç yaşında?Dialogue: 0,0:21:28.22,0:21:30.94,Main,,0,0,0,,Niye gençler hep bu kadar aceleci olmak zorunda?Dialogue: 0,0:21:31.80,0:21:34.34,Main,,0,0,0,,Ciddi misin, Kaptan?!Dialogue: 0,0:21:34.34,0:21:36.01,Main,,0,0,0,,Ne olursa olsun, onunla tanışmak istiyorum!Dialogue: 0,0:21:36.34,0:21:38.18,Main,,0,0,0,,Kızıl Saçlı Shanks!Dialogue: 0,0:21:39.24,0:21:41.58,Main,,0,0,0,,Maça Korsanları?Dialogue: 0,0:21:42.08,0:21:47.19,Main,,0,0,0,,Meşhur Süper Çaylaklar... benim için mi gelmiş?Dialogue: 0,0:21:47.19,0:21:49.84,Main,,0,0,0,,Hayır, bu yüzden gelmedim!Dialogue: 0,0:21:49.84,0:21:53.69,Main,,0,0,0,,Kardeşim sana hayatını borçlu ve senden bahsetmeyi bir türlü bırakmıyor!Dialogue: 0,0:21:53.69,0:21:56.13,Main,,0,0,0,,Sadece seninle tanışıp teşekkür etmek istedim.Dialogue: 0,0:21:56.13,0:21:57.29,Main,,0,0,0,,Luffy'yi mi kastediyorsun?!Dialogue: 0,0:21:58.27,0:22:00.06,Main,,0,0,0,,Abisi olduğunu bilmiyordum!Dialogue: 0,0:22:00.06,0:22:03.07,Main,,0,0,0,,Anlıyorum. Gelmene sevindim!Dialogue: 0,0:22:03.07,0:22:05.20,Main,,0,0,0,,Lütfen biraz daha anlat!Dialogue: 0,0:22:05.70,0:22:07.60,Main,,0,0,0,,Parti verelim!Dialogue: 0,0:22:12.08,0:22:15.48,Main,,0,0,0,,Hey, koca adam! Şu Beyazsakal'la tanışmak istiyorum!Dialogue: 0,0:22:15.48,0:22:20.61,Main,,0,0,0,,Tehlikeli maksadı olan bir çocuğun babalığı görmesine izin vermeyeceğim!Dialogue: 0,0:22:20.61,0:22:22.75,Main,,0,0,0,,Kaptan! Bu Jinbei!Dialogue: 0,0:22:22.75,0:22:25.61,Main,,0,0,0,,Öyle mi? Yedi Savaş Lordu'ndan biri mi?Dialogue: 0,0:22:25.61,0:22:28.28,Main,,0,0,0,,Evet, bu sorun olacak.Dialogue: 0,0:22:28.28,0:22:32.17,Main,,0,0,0,,Beyazsakal Korsanları'nın üyesi olmayabilirim,...Dialogue: 0,0:22:32.17,0:22:35.27,Main,,0,0,0,,...ama seninle yüzleşmenin görevim olduğunu hissediyorum!Dialogue: 0,0:22:44.99,0:22:49.25,Main,,0,0,0,,Beş gün oldu ve hala dövüşüyorlar!Dialogue: 0,0:22:49.25,0:22:51.65,Main,,0,0,0,,Bu durumda ikisi de ölebilir!Dialogue: 0,0:23:03.29,0:23:06.01,Main,,0,0,0,,Ace!Dialogue: 0,0:23:13.74,0:23:15.64,Main,,0,0,0,,O da ne?!Dialogue: 0,0:23:16.14,0:23:20.51,Main,,0,0,0,,Başımı almak isteyen çocuk nerede?Dialogue: 0,0:23:23.11,0:23:27.42,Main,,0,0,0,,İstediğin gibi, seninle dövüşeceğim!Dialogue: 0,0:23:28.52,0:23:30.82,Main,,0,0,0,,Beyazsakal Korsanları!Dialogue: 0,0:23:31.69,0:23:34.79,Main,,0,0,0,,Bu işle kendim ilgileneceğim.Dialogue: 0,0:23:43.34,0:23:44.80,Main,,0,0,0,,Arkadaşlar!Dialogue: 0,0:23:46.30,0:23:48.49,Main,,0,0,0,,Enjoumou!Dialogue: 0,0:23:46.30,0:23:48.49,Note,,0,0,0,,- Alevli Ağ -Dialogue: 0,0:23:49.68,0:23:52.66,Main,,0,0,0,,Kaptan! Ace Kaptan, ne yapıyorsun?!Dialogue: 0,0:23:52.66,0:23:54.21,Main,,0,0,0,,Siz kaçın!Dialogue: 0,0:23:54.21,0:23:56.08,Main,,0,0,0,,Kaptan!Dialogue: 0,0:23:57.85,0:24:01.52,Main,,0,0,0,,Ne? Şimdi kaçacak mısın?Dialogue: 0,0:24:01.52,0:24:03.57,Main,,0,0,0,,Tayfamın kaçmasını sağlıyorum.Dialogue: 0,0:24:03.57,0:24:06.59,Main,,0,0,0,,Onların yerine buradayım... Kaçmayacağım!Dialogue: 0,0:24:07.49,0:24:10.93,Main,,0,0,0,,Ne kadar arsız bir veletsin sen!Dialogue: 0,0:24:22.38,0:24:23.78,Main,,0,0,0,,Ben...Dialogue: 0,0:24:26.28,0:24:28.05,Main,,0,0,0,,Hala kalkmaya mı çalışıyorsun?Dialogue: 0,0:24:30.48,0:24:34.61,Main,,0,0,0,,Burada öldüğünü görmek hoşuma gitmez, çocuk.Dialogue: 0,0:24:34.61,0:24:36.43,Main,,0,0,0,,Hala dövüşmek istiyorsan,...Dialogue: 0,0:24:36.43,0:24:41.26,Main,,0,0,0,,...adımı al ve denizlerde özgürce kükre!Dialogue: 0,0:24:45.90,0:24:47.87,Main,,0,0,0,,Oğlum ol!Dialogue: 0,0:24:48.70,0:24:50.92,Main,,0,0,0,,Şaka yapıyor olmalısın!Dialogue: 0,0:24:56.75,0:25:00.00,Main,,0,0,0,,Ben Dördüncü Bölüm Kumandanı... Thatch!Dialogue: 0,0:25:00.50,0:25:02.40,Main,,0,0,0,,Tayfamıza katıldığına göre,...Dialogue: 0,0:25:03.87,0:25:05.15,Main,,0,0,0,,...sanırım arkadaş olmalıyız.Dialogue: 0,0:25:05.15,0:25:06.77,Main,,0,0,0,,Kapa çeneni!Dialogue: 0,0:25:08.90,0:25:10.99,Main,,0,0,0,,Ters tarafından kalktığın kesin.Dialogue: 0,0:25:10.99,0:25:14.89,Main,,0,0,0,,Sahi. Sen bayıldıktan sonra olanları bilmek ister misin?Dialogue: 0,0:25:15.47,0:25:21.87,Main,,0,0,0,,Arkadaşların seni geri almaya geldi, biz de hepsini yendik.Dialogue: 0,0:25:21.87,0:25:26.30,Main,,0,0,0,,Ne? Öldükleri falan yok. Onları gemide tutuyoruz.Dialogue: 0,0:25:26.89,0:25:30.50,Main,,0,0,0,,Beni kelepçesiz, kilitsiz falan bırakmak istediğinden emin misin?Dialogue: 0,0:25:30.50,0:25:33.71,Main,,0,0,0,,Kelepçe mi? Buna ihtiyacımız yok!Dialogue: 0,0:25:55.79,0:25:58.45,Main,,0,0,0,,Hey, hey, ne yaptığını sanıyorsun sen?Dialogue: 0,0:25:58.45,0:26:01.20,Main,,0,0,0,,Gecenin bu vaktinde daha düşünceli olmalısın!Dialogue: 0,0:26:15.41,0:26:17.40,Main,,0,0,0,,Hey, denize düştü!Dialogue: 0,0:26:17.40,0:26:18.60,Main,,0,0,0,,Hem de yüzemiyor!Dialogue: 0,0:26:18.60,0:26:20.26,Main,,0,0,0,,Biri gidip onu kurtarsın!Dialogue: 0,0:26:22.73,0:26:27.68,Main,,0,0,0,,Her gün bunu yapıyor. Ciddi anlamda ısrarcı.Dialogue: 0,0:26:28.89,0:26:30.22,Main,,0,0,0,,Yüzden fazla oldu, değil mi?Dialogue: 0,0:26:30.22,0:26:31.50,Main,,0,0,0,,Evet, kesinlikle fazla.Dialogue: 0,0:26:48.39,0:26:49.65,Main,,0,0,0,,Siz...Dialogue: 0,0:26:50.84,0:26:53.86,Main,,0,0,0,,Ona niye baba diyorsunuz ki?Dialogue: 0,0:26:56.13,0:27:00.59,Main,,0,0,0,,Çünkü bize oğullarım diyor.Dialogue: 0,0:27:01.43,0:27:04.97,Main,,0,0,0,,Dünyanın gözünde toplum dışı insanlarız.Dialogue: 0,0:27:05.86,0:27:07.86,Main,,0,0,0,,Bu bizi mutlu ediyor.Dialogue: 0,0:27:07.86,0:27:12.21,Main,,0,0,0,,Sadece bir kelime, ama bizi mutlu ediyor!Dialogue: 0,0:27:20.41,0:27:24.72,Main,,0,0,0,,Hey, bu şekilde canını tehlikeye atmaya daha ne kadar devam edeceksin?Dialogue: 0,0:27:25.67,0:27:27.53,Main,,0,0,0,,Kararını ver artık!Dialogue: 0,0:27:28.13,0:27:31.40,Main,,0,0,0,,Şu anki halinle babalığın başını alman mümkün değil.Dialogue: 0,0:27:32.45,0:27:35.56,Main,,0,0,0,,Bu gemiden inip yeniden mi başlayacaksın...Dialogue: 0,0:27:36.82,0:27:38.56,Main,,0,0,0,,...yoksa burada kalıp...Dialogue: 0,0:27:40.86,0:27:43.66,Main,,0,0,0,,...Beyazsakal'ın işaretini mi kabul edeceksin?Dialogue: 0,0:27:50.98,0:27:52.84,Main,,0,0,0,,Sen Douma'sın, değil mi?Dialogue: 0,0:27:56.94,0:28:00.23,Main,,0,0,0,,Vay canına! Ace yine başardı!Dialogue: 0,0:28:00.23,0:28:03.26,Main,,0,0,0,,Kendi başına Douma'nın tayfasını dize getirdi!Dialogue: 0,0:28:03.26,0:28:05.73,Main,,0,0,0,,İkinci Bölüm Kumandanı olmak mı?Dialogue: 0,0:28:05.73,0:28:08.80,Main,,0,0,0,,Uzun zamandır eksiğimiz var.Dialogue: 0,0:28:08.80,0:28:10.70,Main,,0,0,0,,Diğerleri seni kesinlikle kabul edecektir!Dialogue: 0,0:28:12.97,0:28:17.53,Main,,0,0,0,,Benden daha uzun süredir buradasın, değil mi? Sorun olmayacağına emin misin?Dialogue: 0,0:28:18.64,0:28:20.83,Main,,0,0,0,,Sorun değil, endişelenme.Dialogue: 0,0:28:20.83,0:28:23.85,Main,,0,0,0,,Zaten benim öyle bir amacım yok.Dialogue: 0,0:28:25.12,0:28:28.19,Main,,0,0,0,,Devam et, Kumandan Ace!Dialogue: 0,0:28:32.92,0:28:35.35,Main,,0,0,0,,Öyle mi? Bu ne sürpriz!Dialogue: 0,0:28:35.35,0:28:36.93,Main,,0,0,0,,Demek öyle.Dialogue: 0,0:28:39.42,0:28:42.67,Main,,0,0,0,,Gerçi pek Roger gibi davranmıyorsun.Dialogue: 0,0:28:43.66,0:28:45.76,Main,,0,0,0,,İkiniz düşman değil miydiniz?Dialogue: 0,0:28:45.76,0:28:47.43,Main,,0,0,0,,Beni gemiden atmayacak mısın?Dialogue: 0,0:28:47.43,0:28:53.86,Main,,0,0,0,,Benimle önemli bir şey konuşacağını söylediğinde, bundan daha büyük bir şey olduğunu sanmıştım.Dialogue: 0,0:28:53.86,0:28:57.88,Main,,0,0,0,,Ailenin kim olduğu önemli değil. Herkes denizin çocuğudur.Dialogue: 0,0:29:07.95,0:29:11.19,Main,,0,0,0,,Görünüşe bakılırsa inanılmaz biri daha Beyazsakal'ın tayfasına katılmış.Dialogue: 0,0:29:11.19,0:29:13.50,Main,,0,0,0,,İnanılmaz güçlü olduğunu söylüyorlar!Dialogue: 0,0:29:31.31,0:29:34.22,Main,,0,0,0,,Dur, Ace! Sakin ol!Dialogue: 0,0:29:34.22,0:29:37.17,Main,,0,0,0,,Babalık bu kez bir istisna yapacağını söyledi!Dialogue: 0,0:29:37.17,0:29:38.89,Main,,0,0,0,,Teach'in peşinden gitmene gerek yok!Dialogue: 0,0:29:38.89,0:29:41.99,Main,,0,0,0,,Bırakın beni! Benim bölümümden biriydi!Dialogue: 0,0:29:41.99,0:29:46.45,Main,,0,0,0,,Bunu görmezden gelirsem, Thatch huzura kavuşamayacak!Dialogue: 0,0:29:47.02,0:29:48.17,Main,,0,0,0,,Ace.Dialogue: 0,0:29:50.16,0:29:53.80,Main,,0,0,0,,Sorun yok, sadece bu seferlik.Dialogue: 0,0:29:53.80,0:29:57.13,Main,,0,0,0,,Bu konuda içimde tuhaf bir his var.Dialogue: 0,0:29:57.13,0:30:00.34,Main,,0,0,0,,Tayfadan birini öldürüp kaçtı!Dialogue: 0,0:30:00.53,0:30:03.18,Main,,0,0,0,,Yıllardır senin koruman altında yaşadıktan sonra...Dialogue: 0,0:30:03.18,0:30:05.55,Main,,0,0,0,,...suratına tükürüp kaçtı!Dialogue: 0,0:30:07.65,0:30:10.50,Main,,0,0,0,,Her şeyden öte, babasının adını lekeledi.Dialogue: 0,0:30:10.50,0:30:12.79,Main,,0,0,0,,Bunu görmezden gelebileceğimi mi sanıyorsun?Dialogue: 0,0:30:12.98,0:30:15.53,Main,,0,0,0,,Bu işi halledeceğim!Dialogue: 0,0:30:20.93,0:30:23.90,Main,,0,0,0,,Hey, dur! Geri gel, Ace!Dialogue: 0,0:30:24.69,0:30:26.00,Main,,0,0,0,,Ace!Dialogue: 0,0:30:35.76,0:30:37.47,Main,,0,0,0,,Babalık...Dialogue: 0,0:30:38.94,0:30:40.14,Main,,0,0,0,,Arkadaşlar...Dialogue: 0,0:30:43.39,0:30:48.76,Main,,0,0,0,,Emirlerinizi dinlemeden çıkıp gittim! Niye beni kaderime terketmediniz?!Dialogue: 0,0:30:48.76,0:30:50.99,Main,,0,0,0,,İnatçı olduğum için bunlar başıma geldi!Dialogue: 0,0:30:53.75,0:30:54.73,Main,,0,0,0,,Hayır.Dialogue: 0,0:30:57.77,0:31:01.57,Main,,0,0,0,,Sana gitmeni söyleyen bendim...Dialogue: 0,0:31:02.77,0:31:04.36,Main,,0,0,0,,...oğlum.Dialogue: 0,0:31:08.66,0:31:11.41,Main,,0,0,0,,Yalan söylüyorsun! Saçmalama!Dialogue: 0,0:31:11.41,0:31:13.99,Main,,0,0,0,,Beni durdurmaya çalışmıştın, ama ben...Dialogue: 0,0:31:13.99,0:31:16.75,Main,,0,0,0,,Gitmeni söylemiştim!Dialogue: 0,0:31:22.26,0:31:27.43,Main,,0,0,0,,Ona gitmesini söylemiştim. Değil mi, Marco?Dialogue: 0,0:31:27.60,0:31:33.04,Main,,0,0,0,,Evet, ben de duydum. Seni belanın içine gönderdik, ha, Ace?Dialogue: 0,0:31:33.29,0:31:36.67,Main,,0,0,0,,Birisi tayfamızdan birine...Dialogue: 0,0:31:37.84,0:31:40.21,Main,,0,0,0,,...zarar verdiğinde,...Dialogue: 0,0:31:40.21,0:31:44.56,Main,,0,0,0,,...olacakları tüm okyanus bilmeli.Dialogue: 0,0:31:46.37,0:31:51.41,Main,,0,0,0,,Sana zarar verenlerin yaşamasına izin yok, Ace!Dialogue: 0,0:31:51.41,0:31:53.39,Main,,0,0,0,,Dayan! Hemen seni almaya geliyoruz!Dialogue: 0,0:31:59.66,0:32:02.73,Main,,0,0,0,,Hazır olun, Denizci Karargâhı!Dialogue: 0,0:32:09.01,0:32:11.91,Main,,0,0,0,,Epey etkileyici bir grup toplamış, ha?Dialogue: 0,0:32:11.91,0:32:15.00,Main,,0,0,0,,Neden bahsediyorlar?Dialogue: 0,0:32:16.10,0:32:18.25,Main,,0,0,0,,Bu konuda içimde kötü bir his var.Dialogue: 0,0:32:26.24,0:32:28.56,Main,,0,0,0,,Bu sarsıntılar da ne?!Dialogue: 0,0:32:28.56,0:32:33.26,Main,,0,0,0,,İşte geliyor. Demin oluşturduğu deniz depremi...Dialogue: 0,0:32:33.26,0:32:36.07,Main,,0,0,0,,...tsunami olarak geri geliyor!Dialogue: 0,0:32:42.37,0:32:44.94,Main,,0,0,0,,Gura Gura Meyvesi yiyen deprem adam...Dialogue: 0,0:32:42.37,0:32:44.94,Note,,0,0,0,,- Gura: Deprem  -Dialogue: 0,0:32:44.94,0:32:48.95,Main,,0,0,0,,..."Beyazsakal", Edward Newgate!Dialogue: 0,0:32:52.15,0:32:53.62,Main,,0,0,0,,O da ne?!Dialogue: 0,0:32:53.62,0:32:55.62,Main,,0,0,0,,Tsunami! Çok büyük!Dialogue: 0,0:32:55.62,0:33:00.41,Main,,0,0,0,,Sayıca ondan üstün olabiliriz, ama bunun zaferi garantilediğini sanmayın.Dialogue: 0,0:33:00.41,0:33:04.55,Main,,0,0,0,,Sonuyla karşılaşacak olanlar biz olabiliriz!Dialogue: 0,0:33:04.55,0:33:06.10,Main,,0,0,0,,O adam...Dialogue: 0,0:33:07.20,0:33:10.37,Main,,0,0,0,,...dünyayı yok edecek güce sahip!Dialogue: 0,0:33:19.54,0:33:21.31,Main,,0,0,0,,Savaş...Dialogue: 0,0:33:21.31,0:33:22.74,Main,,0,0,0,,...başlıyor!Dialogue: 0,0:33:25.85,0:33:27.72,Main,,0,0,0,,Gidelim!Dialogue: 0,0:33:37.29,0:33:43.30,Narrator,,0,0,0,,Beyazsakal ve onun Yeni Dünya'dan gelme 47 gemilik korsan filosu saldırıyor.Dialogue: 0,0:33:43.30,0:33:46.17,Narrator,,0,0,0,,Onlara karşı duranlar ise, Hükümet'in iki büyük gücü:...Dialogue: 0,0:33:46.17,0:33:49.11,Narrator,,0,0,0,,...Denizci Karargâhı ve Denizin Yedi Savaş Lordu.Dialogue: 0,0:33:50.04,0:33:53.35,Narrator,,0,0,0,,Kim kazanırsa kazansın...Dialogue: 0,0:33:53.35,0:33:54.88,Narrator,,0,0,0,,...çağ değişecek.Dialogue: 0,0:01:45.46,0:01:50.70,Karaoke,,0,0,0,karaoke,♪ Her seferinde yağmurdan sonra gökyüzüne bakıyorum. ♪Dialogue: 0,0:01:50.70,0:01:56.20,Karaoke,,0,0,0,karaoke,♪ Henüz sulugöz olduğum zamanları düşünüyorum. ♪Dialogue: 0,0:01:56.20,0:02:03.94,Karaoke,,0,0,0,karaoke,♪ Umutsuzca birinin arkasından koşuyorum,... ♪Dialogue: 0,0:02:04.01,0:02:06.91,Karaoke,,0,0,0,karaoke,♪ ..."Daha güçlü olmak istiyorum," diye düşünerek. ♪Dialogue: 0,0:02:06.91,0:02:12.12,Karaoke,,0,0,0,karaoke,♪ "Teşekkürüm" şimdi rüzgârda kayboldu,... ♪Dialogue: 0,0:02:12.28,0:02:17.29,Karaoke,,0,0,0,karaoke,♪ ...daha güçlü olabilir miyim? ♪Dialogue: 0,0:02:17.49,0:02:22.96,Karaoke,,0,0,0,karaoke,♪ Cevabımı bulamıyorum. ♪Dialogue: 0,0:02:23.09,0:02:28.47,Karaoke,,0,0,0,karaoke,♪ Bu yüzden ilerlemeye devam edeceğim. ♪Dialogue: 0,0:02:28.63,0:02:31.10,Karaoke,,0,0,0,karaoke,♪ Gel hadi, gidelim. ♪Dialogue: 0,0:02:31.10,0:02:34.31,Karaoke,,0,0,0,karaoke,♪ Asla pes etmeyeceğiz. ♪Dialogue: 0,0:02:34.31,0:02:39.54,Karaoke,,0,0,0,karaoke,♪ Zamanın dalgalarına yenik düşmeyeceğiz. ♪Dialogue: 0,0:02:39.54,0:02:45.18,Karaoke,,0,0,0,karaoke,♪ Tekrar tekrar ayağa kalkacağız. ♪Dialogue: 0,0:02:45.18,0:02:50.82,Karaoke,,0,0,0,karaoke,♪ Çünkü bizim için önemli olanı kaybetmek istemiyoruz. ♪Dialogue: 0,0:02:50.82,0:02:55.93,Karaoke,,0,0,0,karaoke,♪ Beni sürekli, sürekli ilerlemeye zorlayan... ♪Dialogue: 0,0:02:55.93,0:03:01.33,Karaoke,,0,0,0,karaoke,♪ ...kafamdaki sesi duyabiliyorum. ♪Dialogue: 0,0:03:01.33,0:03:06.47,Karaoke,,0,0,0,karaoke,♪ Haylaz yağmur bana engel olurken bile... ♪Dialogue: 0,0:03:06.47,0:03:11.41,Karaoke,,0,0,0,karaoke,♪ ...kaçmaya çalışmayacağım. ♪Dialogue: 0,0:03:14.51,0:03:16.85,Karaoke,,0,0,0,karaoke,♪ Gel hadi, gidelim. ♪Dialogue: 0,0:03:16.85,0:03:20.15,Karaoke,,0,0,0,karaoke,♪ Asla pes etmeyeceğiz. ♪Dialogue: 0,0:03:20.15,0:03:25.42,Karaoke,,0,0,0,karaoke,♪ Zamanın dalgalarına yenik düşmeyeceğiz. ♪Dialogue: 0,0:03:25.42,0:03:31.06,Karaoke,,0,0,0,karaoke,♪ Tekrar tekrar ayağa kalkacağız. ♪Dialogue: 0,0:03:31.06,0:03:36.43,Karaoke,,0,0,0,karaoke,♪ Çünkü bizim için önemli olanı kaybetmek istemiyoruz. ♪Dialogue: 0,0:03:36.43,0:03:42.14,Karaoke,,0,0,0,karaoke,♪ İnandığımız geleceğe doğru ilerleyelim. ♪