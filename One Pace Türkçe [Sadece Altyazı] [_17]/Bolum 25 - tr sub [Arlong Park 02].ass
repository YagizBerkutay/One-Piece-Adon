00,0,0,0,0,100,100,3,0,1,2.95,0,8,23,23,23,1Style: Lyrics-furigana,Duality,36,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,2.95,0,2,23,23,34,1Style: Lyrics,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,2,23,23,34,1Style: Karaoke,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,23,1Style: Kanji,Duality,72,&H00DC8F37,&H000019FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,3,0,1,5.9,0,8,23,23,146,1Style: Roger-Monologue,Impress BT Pace,82,&H00FFFFFF,&H00002EFF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,180,180,27,1Style: Romaji ED,Josefin Sans,80,&H00D0740C,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,8,10,10,20,1Style: Translation ED,Josefin Sans,82,&H00D0740C,&H000000FF,&H00FFFFFF,&H00000000,0,0,0,0,100,100,0,0,1,3,0,2,10,10,20,1[Events]Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, TextDialogue: 0,0:00:00.00,0:00:09.99,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:01:50.01,0:02:00.01,Warning,,0,0,0,,Medya oynatıcınız bu bölümde kullanılan altyazı formatını desteklemiyor. Altyazılar muhtemelen düzgün çalışmayacaktır. Lütfen önerilen video oynatıcılardan birini, tercihen mpv kullanın: https://mpv.ioDialogue: 0,0:02:21.37,0:02:22.83,Main-207-,,0,0,0,,Neredeyse hazır.Dialogue: 0,0:02:27.34,0:02:31.13,Main-207-,,0,0,0,,Momoo! Yemek zamanı! Momoo!Dialogue: 0,0:02:31.13,0:02:34.09,Main-207-,,0,0,0,,Çok garip.Dialogue: 0,0:02:34.09,0:02:37.72,Main-207-,,0,0,0,,Şimdiye açlıktan ölüyor olmalıydı.Dialogue: 0,0:02:37.72,0:02:39.06,Main-207-,,0,0,0,,Nereye gidebilir ki?Dialogue: 0,0:02:47.56,0:02:48.27,Main-207-,,0,0,0,,Gen-san !Dialogue: 0,0:02:50.78,0:02:53.40,Main-207-,,0,0,0,,Silah bulundurmak isyanın bir göstergesidir!Dialogue: 0,0:02:53.40,0:02:56.45,Main-207-,,0,0,0,,Senin gibi isyancıların çoğalmasını engellemek ve...Dialogue: 0,0:02:56.45,0:03:01.16,Main-207-,,0,0,0,,diğer insanlara örnek olsun diye seni şimdi öldüreceğim!Dialogue: 0,0:03:01.99,0:03:06.92,Main-207-,,0,0,0,,Olamaz! Birini sadece silahı var diye öldürecek mi?!Dialogue: 0,0:03:06.92,0:03:08.29,Main-207-,,0,0,0,,Buna hakkı yok!Dialogue: 0,0:03:08.29,0:03:10.13,Main-207-,,0,0,0,,H-H-Hey, sen! Hey! Hey!Dialogue: 0,0:03:11.34,0:03:13.84,Main-207-,,0,0,0,,Bunu yapmaya hakkın yok, Arlong!Dialogue: 0,0:03:16.30,0:03:21.43,Main-207-,,0,0,0,,Aralıksız sekiz yıl boyunca, haracımızı zamanında ödedik!Dialogue: 0,0:03:21.43,0:03:24.27,Main-207-,,0,0,0,,Şimdi isyan etmenin ne anlamı var?!Dialogue: 0,0:03:24.68,0:03:26.52,Main-207-,,0,0,0,,Ellerini Gen-san 'dan çek!Dialogue: 0,0:03:28.86,0:03:30.06,Main-207-,,0,0,0,,Aynen öyle!Dialogue: 0,0:03:30.06,0:03:32.78,Main-207-,,0,0,0,,Sanki silahını kullandı da...!Dialogue: 0,0:03:32.78,0:03:33.82,Main-207-,,0,0,0,,Kesin şunu!Dialogue: 0,0:03:33.82,0:03:35.65,Main-207-,,0,0,0,,Gen-san'ı bırakın!Dialogue: 0,0:03:36.15,0:03:40.12,Main-207-,,0,0,0,,Silah bulundurmanın isyan etmekle aynı olduğunu söylüyorum.Dialogue: 0,0:03:40.58,0:03:44.58,Main-207-,,0,0,0,,Ne istiyorsunuz? Bütün köyü mü yok edeyim?Dialogue: 0,0:03:45.16,0:03:50.75,Main-207-,,0,0,0,,Biriniz bile bize elini kaldırırsa, köyünüzü yerle bir ederim.Dialogue: 0,0:03:50.75,0:03:53.30,Main-207-,,0,0,0,,İkisi de bana uyar!Dialogue: 0,0:03:54.05,0:03:55.80,Main-207-,,0,0,0,,Millet, içeri girin!Dialogue: 0,0:03:56.80,0:04:00.39,Main-207-,,0,0,0,,Eğer şimdi sıkıntı çıkarırsak, son sekiz yıl boşa gider!Dialogue: 0,0:04:00.39,0:04:03.77,Main-207-,,0,0,0,,Onun yönetimine karşı ölümüne savaşmak istiyorsanız,Dialogue: 0,0:04:03.77,0:04:06.77,Main-207-,,0,0,0,,bunu sekiz yıl önce yapmalıydınız!Dialogue: 0,0:04:06.77,0:04:14.23,Main-207-,,0,0,0,,Ama hepimiz sabırla dayanmaya yemin ettik! Yaşamak için!Dialogue: 0,0:04:15.11,0:04:16.11,Main-207-,,0,0,0,,Gen-san !Dialogue: 0,0:04:16.11,0:04:17.20,Main-207-,,0,0,0,,Ama...Dialogue: 0,0:04:17.57,0:04:20.57,Main-207-,,0,0,0,,Ne kadar da bilgece sözler! Güzel konuştun!Dialogue: 0,0:04:20.57,0:04:23.58,Main-207-,,0,0,0,,Evet! Hayatta kalmak önemli!Dialogue: 0,0:04:23.58,0:04:26.75,Main-207-,,0,0,0,,Sizin gibi önemsiz böcekler için bile!Dialogue: 0,0:04:28.08,0:04:29.25,Main-207-,,0,0,0,,Gen-san !Dialogue: 0,0:04:30.63,0:04:34.63,Main-207-,,0,0,0,,Yaşayan her canlı eşit doğmaz!Dialogue: 0,0:04:36.42,0:04:37.30,Main-207-,,0,0,0,,Lanet olası...!Dialogue: 0,0:04:37.30,0:04:37.88,Main-207-,,0,0,0,,Dur!Dialogue: 0,0:04:38.76,0:04:41.34,Main-207-,,0,0,0,,Karışmayın!Dialogue: 0,0:04:41.76,0:04:42.80,Main-207-,,0,0,0,,Ama, Gen-san !Dialogue: 0,0:04:45.22,0:04:48.23,Main-207-,,0,0,0,,Eğer ölürseniz, her şey biter!Dialogue: 0,0:04:48.23,0:04:50.77,Main-207-,,0,0,0,,Sabırla dayanmaya devam edin!Dialogue: 0,0:04:51.27,0:04:52.81,Main-207-,,0,0,0,,Ölsem bile...Dialogue: 0,0:04:52.81,0:04:54.94,Main-207-,,0,0,0,,Güzel karar!Dialogue: 0,0:04:54.94,0:04:57.32,Main-207-,,0,0,0,,İnsanlar, iyi izleyin!Dialogue: 0,0:04:58.07,0:05:02.82,Main-207-,,0,0,0,,En ufak kötü düşünceye sahip olanların başına bu gelir!Dialogue: 0,0:05:02.82,0:05:04.62,Main-207-,,0,0,0,,Patlayan Yıldız!Dialogue: 0,0:05:07.79,0:05:09.41,Main-207-,,0,0,0,,B-Bu da neydi?!Dialogue: 0,0:05:10.54,0:05:12.21,Main-207-,,0,0,0,,Bakın! Yukarıda!Dialogue: 0,0:05:13.08,0:05:15.59,Main-207-,,0,0,0,,Çatıda biri var!Dialogue: 0,0:05:16.96,0:05:18.88,Main-207-,,0,0,0,,Sen de kimsin lan?!Dialogue: 0,0:05:18.88,0:05:24.72,Main-207-,,0,0,0,,Benim adım denizin cesur savaşçısı,  Kaptan Usopp!Dialogue: 0,0:05:26.06,0:05:27.43,Main-207-,,0,0,0,,Bu o...!Dialogue: 0,0:05:27.43,0:05:29.68,Main-207-,,0,0,0,,Dünya benden korkar...Dialogue: 0,0:05:29.68,0:05:32.81,Main-207-,,0,0,0,,ve bana cehenemin Şeytan Kralı Usopp derler.Dialogue: 0,0:05:32.81,0:05:34.90,Main-207-,,0,0,0,,Eğer şimdi kaçarsanız, sizi affederim!Dialogue: 0,0:05:34.90,0:05:36.40,Main-207-,,0,0,0,,Benim 8,000–Dialogue: 0,0:05:36.40,0:05:38.44,Main-207-,,0,0,0,,Arlong-san ! Bu o!Dialogue: 0,0:05:38.44,0:05:41.07,Main-207-,,0,0,0,,Elimden kaçırdığım adam!Dialogue: 0,0:05:41.07,0:05:44.37,Main-207-,,0,0,0,,On binlerce adam getirebilirsin.Dialogue: 0,0:05:44.37,0:05:47.87,Main-207-,,0,0,0,,Her birini parçalayacağım!Dialogue: 0,0:05:49.41,0:05:52.25,Thoughts-207-,,0,0,0,,Hiç korkmadı ve Patlayan Yıldız hasar bile vermedi!Dialogue: 0,0:05:52.25,0:05:54.75,Main-207-,,0,0,0,,Aşağılık, değersiz bir insan...Dialogue: 0,0:05:54.75,0:05:58.25,Main-207-,,0,0,0,,bana bunu yapmaya nasıl cüret eder?!Dialogue: 0,0:06:04.72,0:06:06.85,Main-207-,,0,0,0,,Arlong-san ! Bekle!Dialogue: 0,0:06:06.85,0:06:10.68,Main-207-,,0,0,0,,Gosa gibi bir gelir kaynağımızı daha kaybedeceğiz!Dialogue: 0,0:06:11.02,0:06:16.90,Main-207-,,0,0,0,,İnsan yerleşkelerini yok etmek kolay, ama bizim amacımız onları yönetmek!Dialogue: 0,0:06:16.90,0:06:19.36,Main-207-,,0,0,0,,Eğer birazını ezersek, daha fazlasını buluruz!Dialogue: 0,0:06:19.36,0:06:23.15,Main-207-,,0,0,0,,Biz en üstün türüz!Dialogue: 0,0:06:24.03,0:06:25.41,Main-207-,,0,0,0,,Köyü yıkmaya başladı!Dialogue: 0,0:06:29.12,0:06:30.29,Main-207-,,0,0,0,,Yoksa o...?!Dialogue: 0,0:06:31.83,0:06:33.41,Main-207-,,0,0,0,,Öleceğim! Öleceğim!Dialogue: 0,0:06:33.66,0:06:36.46,Main-207-,,0,0,0,,H-Hala hayatta! Peşinden gidin!Dialogue: 0,0:06:34.83,0:06:35.63,Secondary-207-,,0,0,0,,Sıçtım!Dialogue: 0,0:06:38.29,0:06:40.38,Main-207-,,0,0,0,,Yakalayın ve öldürün onu!Dialogue: 0,0:06:40.38,0:06:43.13,Main-207-,,0,0,0,,Hey! Onu Arlong Park'a geri götürelim!Dialogue: 0,0:06:43.13,0:06:45.51,Main-207-,,0,0,0,,Eğer dönmezsek köyü yok edecek!Dialogue: 0,0:06:45.51,0:06:46.34,Main-207-,,0,0,0,,Evet!Dialogue: 0,0:06:47.35,0:06:49.35,Main-207-,,0,0,0,,Kaçmasına izin vermeyin!Dialogue: 0,0:06:49.35,0:06:51.35,Main-207-,,0,0,0,,Bizim kim olduğumuzu sanıyor?!Dialogue: 0,0:06:51.35,0:06:52.98,Main-207-,,0,0,0,,Geri döneceğiz.Dialogue: 0,0:06:53.48,0:06:55.31,Main-207-,,0,0,0,,Şimdilik kurtuldunuz.Dialogue: 0,0:07:01.69,0:07:03.03,Main-207-,,0,0,0,,Özür dilerim...Dialogue: 0,0:07:03.03,0:07:05.11,Main-207-,,0,0,0,,Size sıkıntı çıkardım.Dialogue: 0,0:07:05.11,0:07:06.86,Main-207-,,0,0,0,,Neden bahsediyorsun?Dialogue: 0,0:07:06.86,0:07:08.45,Main-207-,,0,0,0,,Senin suçun yok!Dialogue: 0,0:07:08.45,0:07:09.41,Main-207-,,0,0,0,,Evet!Dialogue: 0,0:07:09.41,0:07:12.20,Main-207-,,0,0,0,,Ama o gençte kimdi?Dialogue: 0,0:07:12.95,0:07:14.46,Main-207-,,0,0,0,,Millet!Dialogue: 0,0:07:14.46,0:07:16.00,Main-207-,,0,0,0,,Sizi tekrar görmek güzel!Dialogue: 0,0:07:16.71,0:07:18.50,Main-207-,,0,0,0,,Nami!Dialogue: 0,0:07:17.46,0:07:18.50,Secondary-207-,,0,0,0,,Nacchan!Dialogue: 0,0:07:18.50,0:07:19.42,Main-207-,,0,0,0,,Bu o!Dialogue: 0,0:07:27.01,0:07:28.34,Main-207-,,0,0,0,,Neler oluyor?Dialogue: 0,0:07:28.34,0:07:30.89,Main-207-,,0,0,0,,Asla köyün ortasında yürümezdin...Dialogue: 0,0:07:31.26,0:07:33.43,Main-207-,,0,0,0,,Büyük bir gürültü duydum...Dialogue: 0,0:07:33.43,0:07:34.89,Main-207-,,0,0,0,,Arlong, ha...?Dialogue: 0,0:07:45.57,0:07:48.32,Main-207-,,0,0,0,,Sadece 7 milyon beli kaldı.Dialogue: 0,0:07:49.41,0:07:52.83,Main-207-,,0,0,0,,Her zamanki gibi berbat bir itibarın var.Dialogue: 0,0:07:52.83,0:07:55.66,Main-207-,,0,0,0,,Sorun değil. Ne de olsa korsanım!Dialogue: 0,0:07:55.66,0:07:58.08,Main-207-,,0,0,0,,Ama Arlong şaşırtıcı derecede makul.Dialogue: 0,0:07:58.08,0:08:00.38,Main-207-,,0,0,0,,Para her şeyi düzeltecek.Dialogue: 0,0:08:01.25,0:08:03.88,Main-207-,,0,0,0,,Arlong ile olan anlaşmamı neredeyse tamamladım.Dialogue: 0,0:08:07.26,0:08:09.76,Main-207-,,0,0,0,,Ne olursa olsun 100 milyon beli toplayacağım...Dialogue: 0,0:08:09.76,0:08:11.43,Main-207-,,0,0,0,,ve bu köyü satın alacağım!Dialogue: 0,0:08:14.89,0:08:19.65,Main-207-,,0,0,0,,Kaçmamı söylemişti, ama başka gidecek bir yerim yok.Dialogue: 0,0:08:20.02,0:08:23.86,Main-207-,,0,0,0,,Ayrıca, Luffy'ye onu geri getireceğime dair söz verdim.Dialogue: 0,0:08:23.86,0:08:26.74,Main-207-,,0,0,0,,Şimdi ne yapmalıyım?Dialogue: 0,0:08:26.74,0:08:28.61,Main-207-,,0,0,0,,İşler karışmaya başladı.Dialogue: 0,0:08:30.70,0:08:32.91,Main-207-,,0,0,0,,Sana söylemiştim, o benim!Dialogue: 0,0:08:40.92,0:08:43.25,Main-207-,,0,0,0,,Tamam, özür dilerim! Bunu alabilirsin!Dialogue: 0,0:08:43.25,0:08:45.13,Main-207-,,0,0,0,,Onu yiyemeyeceğimi biliyorsun!Dialogue: 0,0:08:45.13,0:08:47.42,Main-207-,,0,0,0,,Ben köpek değilim, lanet olsun!Dialogue: 0,0:08:48.63,0:08:49.63,Main-207-,,0,0,0,,Sessizlik!Dialogue: 0,0:08:57.89,0:08:58.89,Main-207-,,0,0,0,,Kocaman...Dialogue: 0,0:08:58.89,0:08:59.60,Main-207-,,0,0,0,,Ha?Dialogue: 0,0:09:05.40,0:09:06.82,Main-207-,,0,0,0,,O da ne?Dialogue: 0,0:09:09.53,0:09:13.62,Main-207-,,0,0,5,,Deniz canavarı!Dialogue: 0,0:09:14.74,0:09:16.99,Main-207-,,0,0,0,,Kocaman bir inek!Dialogue: 0,0:09:17.50,0:09:20.25,Main-207-,,0,0,0,,İnek mi? İnekler yüzemez.Dialogue: 0,0:09:20.25,0:09:21.33,Main-207-,,0,0,0,,Su aygırı olmalı.Dialogue: 0,0:09:21.33,0:09:24.17,Main-207-,,0,0,0,,Böyle bir şeyin Doğu Mavi'de ne işi var?!Dialogue: 0,0:09:24.17,0:09:27.13,Main-207-,,0,0,0,,Bu bir Grand Line yaratığı!Dialogue: 0,0:09:29.76,0:09:30.84,Main-207-,,0,0,0,,Ha?Dialogue: 0,0:09:30.84,0:09:32.55,Main-207-,,0,0,0,,Ne yapmaya çalışıyor?Dialogue: 0,0:09:36.22,0:09:37.68,Main-207-,,0,0,0,,Yemeğimizin peşinde!Dialogue: 0,0:09:37.68,0:09:38.43,Main-207-,,0,0,0,,Ne?!Dialogue: 0,0:09:38.43,0:09:39.77,Main-207-,,0,0,0,,Acele et ve yemeği ver!Dialogue: 0,0:09:39.77,0:09:41.14,Main-207-,,0,0,0,,Bizi batıracak!Dialogue: 0,0:09:41.14,0:09:43.94,Main-207-,,0,0,0,,Lastik-Lastik Tabanca!Dialogue: 0,0:09:48.32,0:09:50.57,Main-207-,,0,0,0,,Yemeğimden uzak dur!Dialogue: 0,0:09:50.57,0:09:52.91,Main-207-,,0,0,0,,Başardın! İnanılmazsın, Luffy abi!Dialogue: 0,0:09:56.37,0:09:57.87,Main-207-,,0,0,0,,Onu kızdırdın gibi!Dialogue: 0,0:09:57.87,0:09:59.25,Main-207-,,0,0,0,,Bir tane daha, ha?!Dialogue: 0,0:09:59.25,0:10:00.45,Main-207-,,0,0,0,,Seni gerzek!Dialogue: 0,0:10:00.45,0:10:03.29,Main-207-,,0,0,0,,Aç olan birini nedensizce dövme!Dialogue: 0,0:10:04.25,0:10:07.88,Main-207-,,0,0,0,,Büyük ihtimalle yaralanmış ve kendi yemeğini yakalayamıyor.Dialogue: 0,0:10:07.88,0:10:09.63,Main-207-,,0,0,0,,Öyle değil mi?Dialogue: 0,0:10:09.63,0:10:11.34,Main-207-,,0,0,0,,Ne kadar iyi..Dialogue: 0,0:10:11.84,0:10:13.26,Main-207-,,0,0,0,,Hadi, ye bakalım.Dialogue: 0,0:10:13.26,0:10:15.51,Main-207-,,0,0,0,,Utanmana gerek yok.Dialogue: 0,0:10:21.39,0:10:23.52,Main-207-,,0,0,0,,Öl, seni lanet olası!Dialogue: 0,0:10:26.23,0:10:30.48,Main-207-,,0,0,0,,Ne yaptığını sanıyorsun?! Deminki iyiliğine ne oldu?!Dialogue: 0,0:10:30.48,0:10:33.28,Main-207-,,0,0,0,,Lanet olası, beni yemekle birlikte gömecekti.Dialogue: 0,0:10:37.66,0:10:39.49,Main-207-,,0,0,0,,Dikkat edin! Tekneyi batıracak!Dialogue: 0,0:10:39.49,0:10:40.33,Main-207-,,0,0,0,,Pislik!Dialogue: 0,0:10:40.33,0:10:42.00,Main-207-,,0,0,0,,Geri çekil. Ben hallederim.Dialogue: 0,0:10:46.42,0:10:49.38,Main-207-,,0,0,0,,Boyun Vuruşu!Dialogue: 0,0:10:52.51,0:10:53.72,Main-207-,,0,0,0,,Lanet su aygırı...Dialogue: 0,0:10:58.14,0:11:00.76,Main-207-,,0,0,0,,Tamamdır! Yemeğe geri dönelim!Dialogue: 0,0:11:00.76,0:11:02.60,Main-207-,,0,0,0,,Güzel egzersiz oldu.Dialogue: 0,0:11:02.60,0:11:04.85,Main-207-,,0,0,0,,Bu adamlar çıldırmış...Dialogue: 0,0:11:07.44,0:11:08.94,Main-207-,,0,0,0,,Niye bu kadar uzun sürdü?!Dialogue: 0,0:11:13.19,0:11:15.78,Main-207-,,0,0,0,,Luffy ne zaman ortaya çıkacak?!Dialogue: 0,0:11:15.78,0:11:18.95,Main-207-,,0,0,0,,Beş dakika daha böyle giderse sıkıntıdan geberirim!Dialogue: 0,0:11:22.24,0:11:23.70,Main-207-,,0,0,0,,İnanılmaz!Dialogue: 0,0:11:23.70,0:11:28.29,Main-207-,,0,0,0,,Arlong Korsanları'nın büyük ahtapot yetkilisi Hatchan bile seni yukarı çekemez!Dialogue: 0,0:11:28.29,0:11:30.79,Main-207-,,0,0,0,,Üst kalite bir balıksın!Dialogue: 0,0:11:30.79,0:11:36.09,Main-207-,,0,0,0,,Kim olduğunu bilmiyorum ama Doğu Mavi'nin en cesur balığısın!Dialogue: 0,0:11:36.09,0:11:37.80,Main-207-,,0,0,0,,Oha! Ne...?!Dialogue: 0,0:11:37.80,0:11:39.18,Main-207-,,0,0,0,,Ne?!Dialogue: 0,0:11:39.18,0:11:41.06,Main-207-,,0,0,0,,Baştan beri ben miydim?Dialogue: 0,0:11:43.31,0:11:47.14,Main-207-,,0,0,0,,Ben gerçekten de Doğu Mavi'nin en cesur balığıyım.Dialogue: 0,0:11:47.14,0:11:49.65,Main-207-,,0,0,0,,Bekle bakalım, sence bu garip mi?Dialogue: 0,0:11:50.27,0:11:51.32,Main-207-,,0,0,0,,Öyle.Dialogue: 0,0:11:52.32,0:11:54.90,Main-207-,,0,0,0,,S-Sen de kimsin?!Dialogue: 0,0:11:56.57,0:11:57.49,Main-207-,,0,0,0,,Ben mi?Dialogue: 0,0:11:57.49,0:11:59.53,Main-207-,,0,0,0,,Ben Hatchan!Dialogue: 0,0:11:59.53,0:12:01.41,Main-207-,,0,0,0,,Bana Hachi de!Dialogue: 0,0:12:01.41,0:12:03.29,Main-207-,,0,0,0,,Sen de mi balıkadamsın?Dialogue: 0,0:12:03.29,0:12:07.54,Main-207-,,0,0,0,,Elbette! Ben büyüleyici bir ahtapot balıkadamım!Dialogue: 0,0:12:07.54,0:12:09.71,Main-207-,,0,0,0,,Görünüşe göre, sen bir insansın, değil mi?Dialogue: 0,0:12:09.71,0:12:10.58,Main-207-,,0,0,0,,E-Evet.Dialogue: 0,0:12:10.58,0:12:13.34,Main-207-,,0,0,0,,Denizci mi? Yoksa Misafir mi?Dialogue: 0,0:12:13.67,0:12:14.88,Main-207-,,0,0,0,,Misafir mi?Dialogue: 0,0:12:16.42,0:12:18.01,Main-207-,,0,0,0,,Misafirim, evet.Dialogue: 0,0:12:18.01,0:12:20.22,Main-207-,,0,0,0,,Arlong-san burada yok, değil mi?Dialogue: 0,0:12:20.22,0:12:21.93,Main-207-,,0,0,0,,Evet. Nereye gitti?Dialogue: 0,0:12:21.93,0:12:27.35,Main-207-,,0,0,0,,Anlaşılan, uzun burunlu bir yabancı dört bir yanda cirit atıyor.Dialogue: 0,0:12:27.35,0:12:29.98,Main-207-,,0,0,0,,Yoldaşını buraya tıktıktan sonra...Dialogue: 0,0:12:29.98,0:12:33.07,Main-207-,,0,0,0,,onu Cocoyashi Köyü'nde yakalamak için yola çıktı.Dialogue: 0,0:12:33.48,0:12:35.19,Main-207-,,0,0,0,,Usopp, ha...?Dialogue: 0,0:12:35.19,0:12:36.99,Thoughts-207-,,0,0,0,,Sanırım gidip onu kurtaracağım.Dialogue: 0,0:12:39.24,0:12:41.12,Main-207-,,0,0,0,,Şu Cocoyashi Köyüne...Dialogue: 0,0:12:42.16,0:12:42.99,Main-207-,,0,0,0,,nasıl giderim?Dialogue: 0,0:12:42.99,0:12:44.12,Main-207-,,0,0,0,,Bin.Dialogue: 0,0:12:46.54,0:12:48.29,Main-207-,,0,0,0,,Misafirimiz değil misin?Dialogue: 0,0:12:48.29,0:12:49.58,Main-207-,,0,0,0,,Seni götüreceğim,...Dialogue: 0,0:12:50.21,0:12:51.83,Main-207-,,0,0,0,,kılıç ustası!Dialogue: 0,0:13:04.26,0:13:06.93,Main-207-,,0,0,0,,Kahretsin! Onları atlatamıyorum!Dialogue: 0,0:13:10.73,0:13:12.52,Main-207-,,0,0,0,,N-Nereye kayboldu?Dialogue: 0,0:13:13.23,0:13:17.57,Main-207-,,0,0,0,,Kim Usopp-sama'nın henüz ölmeyecek kadar önemli olduğunu düşünüyor?!Dialogue: 0,0:13:17.57,0:13:18.69,Main-207-,,0,0,0,,Ben!Dialogue: 0,0:13:18.69,0:13:20.70,Main-207-,,0,0,0,,Ben! Ben! Ben! Ben!Dialogue: 0,0:13:21.07,0:13:23.49,Main-207-,,0,0,0,,Bu aptal neyin peşinde?!Dialogue: 0,0:13:23.87,0:13:25.95,Main-207-,,0,0,0,,Oh, siz de mi öyle düşünüyorsunuz?Dialogue: 0,0:13:25.95,0:13:27.12,Main-207-,,0,0,0,,Evet!Dialogue: 0,0:13:33.04,0:13:34.04,Main-207-,,0,0,0,,N-Ne?Dialogue: 0,0:13:36.46,0:13:38.71,Main-207-,,0,0,0,,Ölümcül Yumurta Yıldızı!Dialogue: 0,0:13:48.47,0:13:51.23,Main-207-,,0,0,0,,Nasıldı? Görünüşe göre balıkadamlar üstün falan değil!Dialogue: 0,0:13:51.23,0:13:53.90,Main-207-,,0,0,0,,Ne olursa olsun, Kaptan Usopp her zaman kaçar!Dialogue: 0,0:13:56.32,0:13:57.65,Main-207-,,0,0,0,,B-Bilmiyorum!Dialogue: 0,0:14:09.75,0:14:10.66,Main-207-,,0,0,0,,Ha?Dialogue: 0,0:14:10.66,0:14:11.41,Main-207-,,0,0,0,,Ne?Dialogue: 0,0:14:14.67,0:14:16.63,Main-207-,,0,0,0,,Tezahürat için sağol!Dialogue: 0,0:14:16.63,0:14:19.84,Main-207-,,0,0,0,,Görebildiğin gibi iyiyim.Dialogue: 0,0:14:24.72,0:14:26.43,Main-207-,,0,0,0,,İşte Cocoyashi Köyü.Dialogue: 0,0:14:26.43,0:14:29.01,Main-207-,,0,0,0,,Arlong-san burada olmalı.Dialogue: 0,0:14:29.01,0:14:30.52,Main-207-,,0,0,0,,Ha? Oh, harika. Teşekkürler.Dialogue: 0,0:14:30.52,0:14:33.10,Main-207-,,0,0,0,,Ne demek! Şimdilik hoşçakal!Dialogue: 0,0:14:35.73,0:14:39.27,Main-207-,,0,0,0,,Hay aksi! Şimdi hatırladım, adını sormayı unuttum!Dialogue: 0,0:14:39.27,0:14:42.78,Main-207-,,0,0,0,,Ha? Ben mi? Adımı niye soruyorsun?Dialogue: 0,0:14:42.78,0:14:44.32,Main-207-,,0,0,0,,Adım Hatchan!Dialogue: 0,0:14:44.32,0:14:46.16,Main-207-,,0,0,0,,Yine gel!Dialogue: 0,0:14:47.57,0:14:48.78,Main-207-,,0,0,0,,Ne garip biri.Dialogue: 0,0:15:01.63,0:15:03.92,Main-207-,,0,0,0,,B-Burada ne oldu?!Dialogue: 0,0:15:05.93,0:15:07.68,Main-207-,,0,0,0,,Burada neler oldu,...Dialogue: 0,0:15:10.26,0:15:12.72,Main-207-,,0,0,0,,kardeşlerim?!Dialogue: 0,0:15:14.85,0:15:16.31,Main-207-,,0,0,0,,Roronoa...Dialogue: 0,0:15:17.94,0:15:20.36,Main-207-,,0,0,0,,Ne? Ne demeye çalışıyorsun?!Dialogue: 0,0:15:21.11,0:15:23.57,Main-207-,,0,0,0,,Roronoa Zoro...!Dialogue: 0,0:15:23.57,0:15:24.57,Main-207-,,0,0,0,,Ne?!Dialogue: 0,0:15:24.57,0:15:26.53,Main-207-,,0,0,0,,Korsan Avcısı mı?!Dialogue: 0,0:15:26.53,0:15:28.82,Main-207-,,0,0,0,,Benim kellemi almaya mı geldi?!Dialogue: 0,0:15:31.33,0:15:34.79,Main-207-,,0,0,0,,H-hayır, gelmedi. O adam...Dialogue: 0,0:15:35.58,0:15:36.92,Main-207-,,0,0,0,,Zoro'ydu!Dialogue: 0,0:15:36.92,0:15:37.96,Main-207-,,0,0,0,,Ne?!Dialogue: 0,0:15:38.42,0:15:42.84,Main-207-,,0,0,0,,Yakaldığımız o karın kuşaklı adam Roronoa'ydı...Dialogue: 0,0:15:47.76,0:15:49.14,Main-207-,,0,0,0,,Onu yakaladım!Dialogue: 0,0:15:50.10,0:15:52.18,Main-207-,,0,0,0,,B-Burada ne oldu?!Dialogue: 0,0:15:53.18,0:15:55.10,Thoughts-207-,,0,0,0,,Y-Yoksa Zoro...Dialogue: 0,0:15:58.52,0:16:03.65,Main-207-,,0,0,0,,Bu şerefsizi yakalamak açlığımı gidermek için yeterli değil!Dialogue: 0,0:16:05.07,0:16:08.32,Main-207-,,0,0,0,,E-evet, öyle değil mi?!  Yani beni bırakabilirsiniz!Dialogue: 0,0:16:08.32,0:16:10.03,Main-207-,,0,0,0,,Öncesinde selam verdim!Dialogue: 0,0:16:10.03,0:16:12.83,Main-207-,,0,0,0,,B-Biz köyümüzde öyle selamlaşırız!Dialogue: 0,0:16:15.54,0:16:18.87,Main-207-,,0,0,0,,Ama sen Zoro'nun bir adamısın.Dialogue: 0,0:16:20.33,0:16:24.96,Main-207-,,0,0,0,,Aslında, ünlü ödül avcılarının peşime düşmesi gayet doğal bir şey.Dialogue: 0,0:16:27.67,0:16:29.76,Main-207-,,0,0,0,,Beni öldürmeyin!Dialogue: 0,0:16:29.76,0:16:34.10,Main-207-,,0,0,0,,Zoro denen herifle hiç bir bağım yok!Dialogue: 0,0:16:34.97,0:16:36.93,Main-207-,,0,0,0,,Bu kadar bariz yalanlar yeterli.Dialogue: 0,0:16:36.93,0:16:39.14,Main-207-,,0,0,0,,Sen de Arlong-san'a karşı çıktın.Dialogue: 0,0:16:39.14,0:16:41.56,Main-207-,,0,0,0,,İki türlü de yaşayacak gibi gözükmüyorsun.Dialogue: 0,0:16:42.94,0:16:47.57,Main-207-,,0,0,0,,H-Hey! Aslında, Zoro ve ben çok yakınız!Dialogue: 0,0:16:47.57,0:16:49.57,Main-207-,,0,0,0,,Bana elini sürmeyi dene bi'!Dialogue: 0,0:16:49.57,0:16:51.37,Main-207-,,0,0,0,,Zoro sessiz kalmayacaktır!Dialogue: 0,0:16:51.37,0:16:52.24,Main-207-,,0,0,0,,Oh?Dialogue: 0,0:16:52.24,0:16:56.20,Main-207-,,0,0,0,,Yani seni öldürürsem, Zoro geri gelir mi?Dialogue: 0,0:16:57.96,0:17:00.08,Main-207-,,0,0,0,,H-Hayır yanılıyorsun!Dialogue: 0,0:17:00.08,0:17:04.09,Main-207-,,0,0,0,,Beni öldürmek akıllıca olmaz! Beni sağ bırakırsan Zoro çıkagelir!Dialogue: 0,0:17:04.09,0:17:07.38,Main-207-,,0,0,0,,Ama öldürürsen, Zoro geri gelmez!Dialogue: 0,0:17:07.88,0:17:10.05,Main-207-,,0,0,0,,Peki ama Zoro,...Dialogue: 0,0:17:11.22,0:17:12.76,Main-207-,,0,0,0,,hapisten nasıl kaçtı?Dialogue: 0,0:17:12.76,0:17:14.26,Main-207-,,0,0,0,,Ne demek istiyorsun?Dialogue: 0,0:17:14.26,0:17:16.89,Main-207-,,0,0,0,,Demek istediğim, biri kaçmasına yardım etti.Dialogue: 0,0:17:18.18,0:17:19.81,Main-207-,,0,0,0,,Arlong-san.Dialogue: 0,0:17:19.81,0:17:22.06,Main-207-,,0,0,0,,Bu size mantıklı geliyor mu?Dialogue: 0,0:17:22.06,0:17:27.23,Main-207-,,0,0,0,,Belki de Nami, Zoro'nun seni alt etmesi için buraya sızmasına izin verdi?Dialogue: 0,0:17:27.90,0:17:31.20,Main-207-,,0,0,0,,Şimdi öyle deyince, Nami son zamanlarda garipti.Dialogue: 0,0:17:31.20,0:17:34.24,Main-207-,,0,0,0,,Evet. Zoro suya atlayınca da  yardım etmişti.Dialogue: 0,0:17:34.24,0:17:37.37,Main-207-,,0,0,0,,Sakın bana başından beri Zoro'yla çalıştığını söylemeyin.Dialogue: 0,0:17:37.37,0:17:38.87,Main-207-,,0,0,0,,Hepimizi kandırdı mı?!Dialogue: 0,0:17:40.08,0:17:43.17,Main-207-,,0,0,0,,İhanet onun uzmanlık alanıdır.Dialogue: 0,0:17:43.67,0:17:45.34,Main-207-,,0,0,0,,Bu kadarı yeter!Dialogue: 0,0:17:47.75,0:17:50.92,Main-207-,,0,0,0,,Varsayımlar sizi hiçbir yere götürmez!Dialogue: 0,0:17:52.26,0:17:53.09,Main-207-,,0,0,0,,Nami...Dialogue: 0,0:17:53.72,0:17:55.60,Main-207-,,0,0,0,,Dilinize sahip çıkın!Dialogue: 0,0:17:56.10,0:17:59.35,Main-207-,,0,0,0,,Sekiz yıl önce, tayfama yemin için...Dialogue: 0,0:18:00.60,0:18:02.94,Main-207-,,0,0,0,,bu dövmeyi yaptırdım!Dialogue: 0,0:18:04.56,0:18:06.61,Main-207-,,0,0,0,,Afedersin, afedersin.Dialogue: 0,0:18:06.61,0:18:07.44,Main-207-,,0,0,0,,Nami.Dialogue: 0,0:18:07.44,0:18:10.28,Main-207-,,0,0,0,,Belli ki seni üzdük.Dialogue: 0,0:18:10.28,0:18:15.87,Main-207-,,0,0,0,,Ama endişelenme. Senden azıcık bile şüphelenmiyorum.Dialogue: 0,0:18:15.87,0:18:18.95,Main-207-,,0,0,0,,Birbirimizi sekiz yıldır tanıyoruz!Dialogue: 0,0:18:19.41,0:18:22.41,Main-207-,,0,0,0,,Sadece biraz gerildik, hepsi bu.Dialogue: 0,0:18:22.41,0:18:24.83,Main-207-,,0,0,0,,Öyle değil mi, Nami?Dialogue: 0,0:18:24.83,0:18:29.21,Main-207-,,0,0,0,,Kurtulmamız gereken kişiler,  Roronoa Zoro ve grubu!Dialogue: 0,0:18:29.21,0:18:30.80,Main-207-,,0,0,0,,H-Hey, Nami!Dialogue: 0,0:18:30.80,0:18:33.30,Main-207-,,0,0,0,,L-Lütfen bir şey de!Dialogue: 0,0:18:33.30,0:18:34.84,Main-207-,,0,0,0,,N-Nami!Dialogue: 0,0:18:37.55,0:18:39.97,Thoughts-207-,,0,0,0,,Zoro illaki sorun çıkaracaktı...Dialogue: 0,0:18:42.93,0:18:44.27,Main-207-,,0,0,0,,Ne oldu, Nami?Dialogue: 0,0:18:47.11,0:18:49.44,Main-207-,,0,0,0,,Biraz solgun görünüyorsun.Dialogue: 0,0:18:50.86,0:18:53.11,Main-207-,,0,0,0,,Ama uzun burunluya gelince,...Dialogue: 0,0:18:54.28,0:18:57.87,Main-207-,,0,0,0,,şimdi onu sen bile kurtaramazsın.Dialogue: 0,0:18:58.20,0:19:01.04,Main-207-,,0,0,0,,Özellikle Arlong-san'a karşı çıktıktan sonra.Dialogue: 0,0:19:01.04,0:19:02.16,Main-207-,,0,0,0,,Ne kadar...Dialogue: 0,0:19:02.79,0:19:05.29,Main-207-,,0,0,0,,Ne kadar daha benden şüpheleneceksiniz?!Dialogue: 0,0:19:05.29,0:19:08.09,Main-207-,,0,0,0,,Gördüğün üzere çok zekisin.Dialogue: 0,0:19:08.09,0:19:11.80,Main-207-,,0,0,0,,Arlong'la anlaştığımız miktarı yakında toplamak üzereyim!Dialogue: 0,0:19:11.80,0:19:13.59,Main-207-,,0,0,0,,Neden şimdi ihanet edeyim?!Dialogue: 0,0:19:13.92,0:19:15.22,Main-207-,,0,0,0,,Biliyorum...Dialogue: 0,0:19:15.97,0:19:21.39,Main-207-,,0,0,0,,Sekiz yıl önce, Arlong’la Cocoyashi Köyü  için 100 milyon beli karşılığında anlaştın.Dialogue: 0,0:19:22.89,0:19:25.52,Main-207-,,0,0,0,,Yine de anlam veremiyorum.Dialogue: 0,0:19:25.89,0:19:31.07,Main-207-,,0,0,0,,Köylülere ve ailene ihanet ettin. Sadece paraya güveniyorsun.Dialogue: 0,0:19:31.07,0:19:33.53,Main-207-,,0,0,0,,Cocoyashi'yi neden bu kadar önemsiyorsun?Dialogue: 0,0:19:33.53,0:19:36.86,Main-207-,,0,0,0,,Böylesine küçücük bir köyü, neden?Dialogue: 0,0:19:37.36,0:19:40.49,Main-207-,,0,0,0,,Aslında, bunu odanda...Dialogue: 0,0:19:40.83,0:19:42.62,Main-207-,,0,0,0,,buldum.Dialogue: 0,0:19:46.04,0:19:47.29,Main-207-,,0,0,0,,O-O...Dialogue: 0,0:19:48.13,0:19:49.33,Main-207-,,0,0,0,,benim...Dialogue: 0,0:19:50.42,0:19:52.09,Main-207-,,0,0,0,,N-Ne dedin?!Dialogue: 0,0:19:52.55,0:19:54.09,Main-207-,,0,0,0,,Usopp yakalandı mı?!Dialogue: 0,0:19:54.09,0:19:57.59,Main-207-,,0,0,0,,Evet! Onu az önce Arlong Park'a götürdüler!Dialogue: 0,0:19:57.59,0:20:00.85,Main-207-,,0,0,0,,O cesur çocuk, Arlong'a karşı geldi!Dialogue: 0,0:20:00.85,0:20:02.60,Main-207-,,0,0,0,,Şimdiye kesin ölmüştür!Dialogue: 0,0:20:05.10,0:20:06.06,Main-207-,,0,0,0,,Kahretsin...Dialogue: 0,0:20:06.77,0:20:10.56,Main-207-,,0,0,0,,Yani diğer bir deyişle, ben vakit öldürürken yakalanmış.Dialogue: 0,0:20:12.69,0:20:14.94,Main-207-,,0,0,0,,Usopp! Benim yüzümden ölme!Dialogue: 0,0:20:29.58,0:20:33.63,Main-207-,,0,0,0,,Gidelim! Arlong Park'a!Dialogue: 0,0:20:46.48,0:20:49.27,Main-207-,,0,0,0,,Bekle beni, Nami!Dialogue: 0,0:01:50.05,0:01:58.31,Title-207-,,0,0,0,,Grand Line'ın CanavarlarıDialogue: 1,0:01:50.05,0:01:58.31,Title-207-,,0,0,0,,Grand Line'ın CanavarlarıDialogue: 0,0:02:12.20,0:02:17.83,Captions-207-,,0,0,0,,Ön Giriş Arlong ParkDialogue: 2,0:02:12.20,0:02:17.83,Captions-207-,,0,0,0,,Ön Giriş Arlong ParkDialogue: 0,0:09:09.57,0:09:14.37,Captions-207-,,0,0,0,,Deniz İneği Momoo Ağır Muharebe Canavarı Arlong KorsanlarıDialogue: 2,0:09:09.57,0:09:14.37,Captions-207-,,0,0,0,,Deniz İneği Momoo Ağır Muharebe Canavarı Arlong KorsanlarıDialogue: 0,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 1,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Video DüzenlemeDialogue: 0,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Gigglebot ZenefDialogue: 1,0:00:01.77,0:00:04.28,Credits-207-,,0,0,0,,Gigglebot ZenefDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,MüzikDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,MüzikDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,HaleeDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,HaleeDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,GrafikDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,GrafikDialogue: 0,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,DatenshiDialogue: 1,0:00:04.28,0:00:06.78,Credits-207-,,0,0,0,,DatenshiDialogue: 0,0:00:06.78,0:00:10.78,Credits-207-,,0,0,0,,Kalite KontrolDialogue: 1,0:00:06.78,0:00:10.78,Credits-207-,,0,0,0,,Kalite KontrolDialogue: 0,0:00:06.78,0:00:10.78,Credits-207-,,0,0,0,,DolphinWeabu danpmss Feeso Galaxy 9000 Honoka Pepperjack ScolinesDialogue: 1,0:00:06.78,0:00:10.78,Credits-207-,,0,0,0,,DolphinWeabu danpmss Feeso Galaxy 9000 Honoka Pepperjack ScolinesDialogue: 0,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,KaraokeDialogue: 1,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,KaraokeDialogue: 0,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,KaitouYahikoDialogue: 1,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,KaitouYahikoDialogue: 0,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,ZamanlamaDialogue: 1,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,ZamanlamaDialogue: 0,0:00:10.78,0:00:13.28,Credits-207-,,0,0,0,,Gab Galaxy 9000Dialogue: 1,0:00:10.78,0:00: